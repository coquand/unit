-- SSD Theorem 3.11 and Corollaries 3.12, 3.13, 3.14.
--
-- For S Stone and A a family of propositions on S, the following are
-- equivalent (merely):
--  (i)   A x <-> forall n. alpha x n = 0 for some alpha : S -> 2^N;
--  (iv)  A is the image of a map T -> S from a Stone space;
--  (v)   every A x is closed;
-- and (i) gives (iii): the subtype Sigma x. A x is Stone (Corollary 3.12),
-- with the projection as embedding.
--  (i) -> (iii): on S = Sp(2[N]/(r)), each alpha _ n is the evaluation at
--     some element d n (Axiom 1), with a representative d' n; then
--     Sigma x. A x is the spectrum of 2[N]/(r, d'): its points are the zeros
--     of r where every d' n vanishes.
--  (iv) -> (i): ImageClosed.
--  (i) -> (v): by definition.
--  (v) -> (iv): by local choice (Remark 1.11) there are a Stone T, a
--     surjection q : T -> S and beta : T -> 2^N with A (q t) <->
--     forall n. beta t n = 0; then A is the image of Sigma t. (forall n.
--     beta t n = 0), which is Stone by (i) -> (iii).
-- 3.13: Sigma x. A x is Stone, so its truncation is closed (3.8).
-- 3.14: for P closed and Q : P -> closed, P is Stone (3.9), so
--     Sigma p. Q p (a proposition) is closed by 3.13.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module Om = Omniscience[l,l] ;
module OC = OpenClosed[l,l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module IC = ImageClosed[l] ;
module SA = StoneAxioms[l,l] ;
module Eq = Equivalences[l] ;
module Bi = Bijection[l] ;
module DCh = DependentChoice[l] ;

-- (i): cut out by countably many decidable conditions
Cut (S : U l) (A : S -> U l) : U l = (a : S -> Nat -> Bool) * ((x : S) -> Iff (A x) (Om.AllZero (a x))) ;
allzero-prop (a : Nat -> Bool) : Pr.isProp (Om.AllZero a) = OC.allzero-prop a ;

module Over (ax : SA.Assumptions) {
 module SD = StoneDuality[l,l].Over[ax] ;
 module SCo = SC.Over[ax] ;
 module ICo = IC.Over[ax] ;

 ---------------------------------------------------------------------
 -- (i) -> (iii): the subtype cut out by a is Stone

 module Sub (S : U l) (r : Nat -> FN.Elem) (e : Pr.Equiv S (P.Sp (P.Presented r))) (a : S -> Nat -> Bool) {
  module G = P.Generated[FN.free, r] ;
  Bw : P.Booleω = TP.presented-booleω r ;
  d (n : Nat) : G.Q.Carrier = (ax.duality Bw).sec (\ s -> a (e.2.sec s) n) ;
  Rp (n : Nat) : U l = (x : FN.Elem) * Id G.Q.Carrier (G.Q.include x) (d n) ;
  bits (x : S) (m : Nat) : Bool = (e.1 x).1 (G.Q.include (FN.gen m)) ;
  bits-zeros (x : S) : P.Zeros r (bits x) = ((P.sp-presented r).1 (e.1 x)).2 ;
  point-of (x : S) : Id (P.Sp (P.Presented r)) (P.Point[r, bits x, bits-zeros x].point) (e.1 x) =
   P.hom-ext-gen r BR.two (P.Point[r, bits x, bits-zeros x].point) (e.1 x) (\ m -> P.Point[r, bits x, bits-zeros x].value (FN.gen m)) ;
  Sigma : U l = (x : S) * Om.AllZero (a x) ;
  module WithReps (c : (n : Nat) -> Rp n) {
   cval (n : Nat) (beta : Nat -> Bool) (z : P.Zeros r beta) :
     Id Bool ((c n).1.1 beta) (a (e.2.sec (P.Point[r, beta, z].point)) n) =
    trans (sym (P.Point[r, beta, z].value (c n).1))
     (trans (ap (P.Point[r, beta, z].point).1 (c n).2)
      (Pr.happly (P.Sp Bw.1) (\ s -> Bool) _ _ ((ax.duality Bw).sec-eq (\ s -> a (e.2.sec s) n)) (P.Point[r, beta, z].point))) ;
   cx (n : Nat) (x : S) : Id Bool ((c n).1.1 (bits x)) (a x n) =
    trans (cval n (bits x) (bits-zeros x))
     (trans (ap (\ s -> a (e.2.sec s) n) (point-of x)) (ap (\ y -> a y n) (Pr.sec-ret S (P.Sp (P.Presented r)) e.1 e.2 x))) ;
   t (m : Nat) : FN.Elem = NO.inter FN.Elem m r (\ n -> (c n).1) ;
   zeros-at (x : S) (z : Om.AllZero (a x)) (m : Nat) :
     Plus ((n : Nat) * Id Nat m (NO.dbl n)) ((n : Nat) * Id Nat m (suc (NO.dbl n))) -> Id Bool ((t m).1 (bits x)) false = split {
    inl u -> trans (ap (\ j -> (t j).1 (bits x)) u.2)
      (trans (ap (\ y -> y.1 (bits x)) (NO.inter-even FN.Elem u.1 r (\ n -> (c n).1))) (bits-zeros x u.1)) ;
    inr u -> trans (ap (\ j -> (t j).1 (bits x)) u.2)
      (trans (ap (\ y -> y.1 (bits x)) (NO.inter-odd FN.Elem u.1 r (\ n -> (c n).1))) (trans (cx u.1 x) (z u.1))) } ;
   even (beta : Nat -> Bool) (z : P.Zeros t beta) : P.Zeros r beta = \ n ->
    trans (sym (ap (\ y -> y.1 beta) (NO.inter-even FN.Elem n r (\ j -> (c j).1)))) (z (NO.dbl n)) ;
   odd (beta : Nat -> Bool) (z : P.Zeros t beta) (n : Nat) : Id Bool ((c n).1.1 beta) false =
    trans (sym (ap (\ y -> y.1 beta) (NO.inter-odd FN.Elem n r (\ j -> (c j).1)))) (z (suc (NO.dbl n))) ;
   to (u : Sigma) : P.Sp (P.Presented t) = P.Point[t, bits u.1, \ m -> zeros-at u.1 u.2 m (NO.parity m)].point ;
   from-point (beta : Nat -> Bool) (z : P.Zeros t beta) : S = e.2.sec (P.Point[r, beta, even beta z].point) ;
   from (s : P.Sp (P.Presented t)) : Sigma =
    (from-point ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2,
     \ n -> trans (sym (cval n ((P.sp-presented t).1 s).1 (even ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2)))
      (odd ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2 n)) ;
   sp-set : Pr.isSet (P.Sp (P.Presented t)) = H.Properties[(P.Presented t).ring, BR.two-ring, BR.bool-set].set ;
   injective : Bi.Injective to = \ u v q ->
    Pr.Sigma-eq S (\ x -> Om.AllZero (a x)) u.1 v.1 u.2 v.2
     (Eq.injective S (P.Sp (P.Presented r)) e.1 e.2 u.1 v.1
       (P.hom-ext-gen r BR.two (e.1 u.1) (e.1 v.1) (\ m ->
         trans (sym (P.Point[t, bits u.1, \ j -> zeros-at u.1 u.2 j (NO.parity j)].value (FN.gen m)))
          (trans (ap (\ p -> p.1 (P.Generated[FN.free, t].Q.include (FN.gen m))) q)
           (P.Point[t, bits v.1, \ j -> zeros-at v.1 v.2 j (NO.parity j)].value (FN.gen m))))))
     (allzero-prop (a v.1)) ;
   surjective (s : P.Sp (P.Presented t)) : T.Trunc[(u : Sigma) * Id (P.Sp (P.Presented t)) (to u) s].carrier =
    T.Trunc[(u : Sigma) * Id (P.Sp (P.Presented t)) (to u) s].inc (from s,
     P.hom-ext-gen t BR.two (to (from s)) s (\ m ->
      trans (P.Point[t, bits (from s).1, \ j -> zeros-at (from s).1 (from s).2 j (NO.parity j)].value (FN.gen m))
       (trans (ap (\ q -> q.1 (G.Q.include (FN.gen m)))
          ((e.2.sec-eq (P.Point[r, ((P.sp-presented t).1 s).1, even ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2].point))))
        (P.Point[r, ((P.sp-presented t).1 s).1, even ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2].value (FN.gen m))))) ;
   equiv : Pr.Equiv Sigma (P.Sp (P.Presented t)) = (to, Bi.Bij[Sigma, P.Sp (P.Presented t), sp-set, to, injective, surjective].equiv) ;
   stone : PF.StoneW Sigma = (TP.presented-booleω t, equiv) ;
  } ;
  stone : PF.isStone Sigma =
   TC.rec ((n : Nat) -> Rp n) @(l+) (PF.isStone Sigma) T1.Trunc[PF.StoneW Sigma].proposition
    (\ c -> T1.Trunc[PF.StoneW Sigma].inc WithReps[c].stone)
    (CountableChoice[l].cc (ax.dc @l) Rp (\ n -> G.Q.representative (d n))) ;
 } ;
 -- Corollary 3.12 for cut-out subtypes
 cut-stone (S : U l) (sS : PF.isStone S) (a : S -> Nat -> Bool) : PF.isStone ((x : S) * Om.AllZero (a x)) =
  SC.on-stone1 S (PF.isStone ((x : S) * Om.AllZero (a x))) T1.Trunc[PF.StoneW ((x : S) * Om.AllZero (a x))].proposition sS
   (\ r e -> Sub[S, r, e, a].stone) ;
 ---------------------------------------------------------------------
 -- (iv) -> (i)
 image-cut (X Y : U l) (sX : PF.isStone X) (sY : PF.isStone Y) (f : X -> Y) : T.Trunc[Cut Y (IC.Image X Y f)].carrier =
  SC.on-stone X (T.Trunc[Cut Y (IC.Image X Y f)].carrier) T.Trunc[Cut Y (IC.Image X Y f)].proposition sX (\ rX eX ->
   SC.on-stone Y (T.Trunc[Cut Y (IC.Image X Y f)].carrier) T.Trunc[Cut Y (IC.Image X Y f)].proposition sY (\ rY eY ->
    ICo.Presented2[X, Y, rX, rY, eX, eY, f].image-closed)) ;

 cut-iff (S : U l) (A B : S -> U l) (h : (x : S) -> Iff (A x) (B x)) (c : Cut S B) : Cut S A =
  (c.1, \ x -> ((\ p -> (c.2 x).1 ((h x).1 p)), (\ z -> (h x).2 ((c.2 x).2 z)))) ;
 stone-equiv (X Y : U l) (e : Pr.Equiv X Y) (s : PF.isStone Y) : PF.isStone X =
  T1.Trunc[PF.StoneW Y].induction @(l+) (\ q -> PF.isStone X) (\ q -> T1.Trunc[PF.StoneW X].proposition)
   (\ w -> T1.Trunc[PF.StoneW X].inc (w.1, Eq.compose X Y (P.Sp w.1.1) e w.2)) s ;

 ---------------------------------------------------------------------
 -- (v) -> (i), by local choice
 module ByLocal (S : U l) (A : S -> U l) (pA : (x : S) -> Pr.isProp (A x)) (c : (x : S) -> OC.isClosed (A x))
   (B : P.Booleω) (e : Pr.Equiv S (P.Sp B.1)) {
  Fm (s : P.Sp B.1) : U l = OC.ClosedW (A (e.2.sec s)) ;
  module Got (d : SA.LocalData B Fm) {
   Tp : U l = P.Sp d.1.1 ;
   q : Tp -> P.Sp B.1 = d.2.1 ;
   wt (t : Tp) : Fm (q t) = d.2.2.2 t ;
   a' (t : Tp) : Nat -> Bool = (wt t).1 ;
   Cover : U l = (t : Tp) * Om.AllZero (a' t) ;
   sub-stone : PF.isStone Cover = cut-stone Tp (T1.Trunc[PF.StoneW Tp].inc (d.1, Pr.idEquiv Tp)) a' ;
   g (u : Cover) : S = e.2.sec (q u.1) ;
   back (y : S) (t : Tp) (p : Id (P.Sp B.1) (q t) (e.1 y)) : Id S (e.2.sec (q t)) y =
    trans (ap e.2.sec p) (Pr.sec-ret S (P.Sp B.1) e.1 e.2 y) ;
   iff (y : S) : Iff (A y) (IC.Image Cover S g y) =
    (\ ay -> TC.map ((t : Tp) * Id (P.Sp B.1) (q t) (e.1 y)) ((u : Cover) * Id S (g u) y)
       (\ v -> ((v.1, (wt v.1).2.1 (subst A (sym (back y v.1 v.2)) ay)), back y v.1 v.2)) (d.2.2.1 (e.1 y)),
     \ im -> TC.rec ((u : Cover) * Id S (g u) y) @l (A y) (pA y) (\ v -> subst A v.2 ((wt v.1.1).2.2 v.1.2)) im) ;
   cut : T.Trunc[Cut S A].carrier =
    TC.map (Cut S (IC.Image Cover S g)) (Cut S A) (cut-iff S A (IC.Image Cover S g) iff)
     (image-cut Cover S sub-stone (T1.Trunc[PF.StoneW S].inc (B, e)) g) ;
  } ;
 } ;
 closed-cut (S : U l) (sS : PF.isStone S) (A : S -> U l) (pA : (x : S) -> Pr.isProp (A x)) (c : (x : S) -> OC.isClosed (A x)) :
   T.Trunc[Cut S A].carrier =
  T1.Trunc[PF.StoneW S].induction @l (\ q -> T.Trunc[Cut S A].carrier) (\ q -> T.Trunc[Cut S A].proposition) (\ w ->
   Truncation[l+ \/ l].Trunc[SA.LocalData w.1 ByLocal[S, A, pA, c, w.1, w.2].Fm].induction @l
    (\ q -> T.Trunc[Cut S A].carrier) (\ q -> T.Trunc[Cut S A].proposition)
    (\ d -> ByLocal[S, A, pA, c, w.1, w.2].Got[d].cut)
    (ax.local w.1 ByLocal[S, A, pA, c, w.1, w.2].Fm (\ s -> c (w.2.2.sec s)))) sS ;

 ---------------------------------------------------------------------
 -- Theorem 3.11
 i-v (S : U l) (A : S -> U l) (u : T.Trunc[Cut S A].carrier) (x : S) : OC.isClosed (A x) =
  TC.map (Cut S A) (OC.ClosedW (A x)) (\ c -> (c.1 x, c.2 x)) u ;
 v-i (S : U l) (sS : PF.isStone S) (A : S -> U l) (pA : (x : S) -> Pr.isProp (A x)) (c : (x : S) -> OC.isClosed (A x)) :
   T.Trunc[Cut S A].carrier = closed-cut S sS A pA c ;
 -- (i) -> (iii): the subtype is Stone, and it is the image of its projection
 sub-equiv (S : U l) (A : S -> U l) (pA : (x : S) -> Pr.isProp (A x)) (c : Cut S A) :
   Pr.Equiv ((x : S) * A x) ((x : S) * Om.AllZero (c.1 x)) =
  sigma-equiv S S (Pr.idEquiv S) A (\ x -> Om.AllZero (c.1 x)) pA (\ x -> allzero-prop (c.1 x))
   (\ x -> (c.2 x).1) (\ x -> (c.2 x).2) ;
 -- Corollary 3.12
 closed-stone (S : U l) (sS : PF.isStone S) (A : S -> U l) (pA : (x : S) -> Pr.isProp (A x)) (c : (x : S) -> OC.isClosed (A x)) :
   PF.isStone ((x : S) * A x) =
  TC.rec (Cut S A) @(l+) (PF.isStone ((x : S) * A x)) T1.Trunc[PF.StoneW ((x : S) * A x)].proposition
   (\ u -> stone-equiv ((x : S) * A x) ((x : S) * Om.AllZero (u.1 x)) (sub-equiv S A pA u) (cut-stone S sS u.1))
   (closed-cut S sS A pA c) ;
 image-fst (S : U l) (A : S -> U l) (pA : (x : S) -> Pr.isProp (A x)) (x : S) : Iff (A x) (IC.Image ((y : S) * A y) S (\ u -> u.1) x) =
  (\ a -> T.Trunc[((u : (y : S) * A y) * Id S u.1 x)].inc ((x, a), refl x),
   \ im -> TC.rec ((u : (y : S) * A y) * Id S u.1 x) @l (A x) (pA x) (\ v -> subst A v.2 v.1.2) im) ;
 -- (iv) -> (i)
 iv-i (S : U l) (sS : PF.isStone S) (A : S -> U l) (X : U l) (sX : PF.isStone X) (g : X -> S)
   (h : (x : S) -> Iff (A x) (IC.Image X S g x)) : T.Trunc[Cut S A].carrier =
  TC.map (Cut S (IC.Image X S g)) (Cut S A) (cut-iff S A (IC.Image X S g) h) (image-cut X S sX sS g) ;

 -- Corollary 3.13
 closed-exists (S : U l) (sS : PF.isStone S) (A : S -> U l) (pA : (x : S) -> Pr.isProp (A x)) (c : (x : S) -> OC.isClosed (A x)) :
   OC.isClosed (T.Trunc[(x : S) * A x].carrier) =
  SCo.cor38 ((x : S) * A x) (closed-stone S sS A pA c) ;
 -- Corollary 3.14
 closed-sigma (Q : U l) (pQ : Pr.isProp Q) (cQ : OC.isClosed Q) (R : Q -> U l) (pR : (q : Q) -> Pr.isProp (R q))
   (cR : (q : Q) -> OC.isClosed (R q)) : OC.isClosed ((q : Q) * R q) =
  OC.closed-iff ((q : Q) * R q) (T.Trunc[(q : Q) * R q].carrier)
   (T.Trunc[(q : Q) * R q].inc, TC.rec ((q : Q) * R q) @l ((q : Q) * R q) (Pr.isProp-Sigma Q R pQ pR) (\ u -> u))
   (closed-exists Q (SCo.closed-stone Q pQ cQ) R pR cR) ;
} ;
