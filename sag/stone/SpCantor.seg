-- Sp(2^N) = N, from Axiom 1 at 2[N] alone; so Stone duality holds for the
-- algebra 2^N of all binary sequences (pointwise operations, PowerSet),
-- which is not countably presented: its equality is closed (Lemma 3.10),
-- and it would also be open (Lemma 2.12, Cor. 2.14), hence decidable,
-- contradicting not WLPO.
--
-- Let h : 2^N -> 2 be a morphism and delta_i the sequence that is 1
-- exactly at i.
--  (1) If h(delta_i) = 1 then h is evaluation at i:  a delta_i =
--      c(a_i) delta_i  (c b the constant sequence), so
--      h(a) = h(a) h(delta_i) = h(c(a_i)) h(delta_i) = a_i.
--      Hence such an i is unique: h(delta_j) = delta_j(i).
--  (2) Such an i exists.  By continuity (Omniscience.Continuity) h has a
--      modulus k.  Let u_0 = 0, u_(m+1) = u_m + delta_m (1 exactly below m).
--      u_k agrees with 1 below k, so h(u_k) = 1, while h(u_0) = 0.  If m+1
--      is the least m' with h(u_m') = 1, then
--      h(delta_m) = h(u_(m+1)) + h(u_m) = 1.
--  So i |-> evaluation at i is an equivalence N = Sp(2^N), and the
-- evaluation  2^N -> 2^Sp(2^N)  is an equivalence: composed with it, it is
-- the identity of 2^N.
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module SA = StoneAxioms[l,k] ;
module Om = Omniscience[l,k] ;
module PW = PowerSet[l].Pow[Nat] ;

-- the algebra 2^N and its points
Cantor : BR.BA = PW.algebra ;
Point : U l = P.Sp Cantor ;
-- evaluation at i
ev (i : Nat) : Point = (\ a -> a i, refl true, \ a b -> refl (BR.xor (a i) (b i)), \ a b -> refl (BR.and (a i) (b i))) ;

-- 1 exactly below m
below : Nat -> PW.Carrier = split { zero -> PW.zero ; suc m | u -> PW.add u (NO.delta m) } ;
below-above : (m n : Nat) -> Not (NO.Lt n m) -> Id Bool (below m n) false = split {
 zero -> \ n h -> refl false ;
 suc m | r -> \ n h -> calc Bool { below (suc m) n
  =< ap (\ t -> BR.xor t (NO.delta m n)) (r n (\ lt -> h (NO.lt-step n m lt))) > NO.delta m n
  =< NO.delta-ne m n (\ p -> h (subst (\ j -> NO.Lt j (suc m)) (sym p) (NO.lt-suc m))) > false } } ;
below-step (m n : Nat) (r : NO.Lt n m -> Id Bool (below m n) true) :
  Plus (NO.Lt n m) (Id Nat n m) -> Id Bool (below (suc m) n) true = split {
 inl lt -> calc Bool { below (suc m) n
  =< ap (\ t -> BR.xor t (NO.delta m n)) (r lt) > BR.not (NO.delta m n)
  =< ap BR.not (NO.delta-ne m n (NO.lt-neq n m lt)) > true } ;
 inr p -> calc Bool { below (suc m) n
  =< ap (\ j -> below (suc m) j) p > BR.xor (below m m) (NO.delta m m)
  =< ap (\ t -> BR.xor t (NO.delta m m)) (below-above m m (NO.lt-irrefl m)) > NO.delta m m
  =< NO.delta-self m > true } } ;
below-below : (m n : Nat) -> NO.Lt n m -> Id Bool (below m n) true = split {
 zero -> \ n lt -> Pr.absurd (Id Bool false true) (NO.not-lt-zero n lt) ;
 suc m | r -> \ n lt -> below-step m n (r n) (NO.lt-pred n m lt) } ;

-- a delta_i = c(a_i) delta_i, pointwise
cut (a : PW.Carrier) (i n : Nat) : NO.Tri n i ->
  Id Bool (BR.and (a n) (NO.delta i n)) (BR.and (a i) (NO.delta i n)) = split {
 less h -> trans (ap (BR.and (a n)) (NO.delta-ne i n (NO.lt-neq n i h)))
  (trans (TP.and-false (a n)) (sym (trans (ap (BR.and (a i)) (NO.delta-ne i n (NO.lt-neq n i h))) (TP.and-false (a i))))) ;
 equal p -> ap (\ j -> BR.and (a j) (NO.delta i n)) p ;
 greater h -> trans (ap (BR.and (a n)) (NO.delta-ne i n (\ p -> NO.lt-neq i n h (sym p))))
  (trans (TP.and-false (a n)) (sym (trans (ap (BR.and (a i)) (NO.delta-ne i n (\ p -> NO.lt-neq i n h (sym p))))
   (TP.and-false (a i))))) } ;

module At (h : Point) {
 -- h on constant sequences
 constant : (b : Bool) -> Id Bool (h.1 (\ n -> b)) b = split {
  true -> h.2.1 ;
  false -> H.zero PW.ring BR.two-ring h } ;
 -- (1)
 Index : U l = (i : Nat) * Id Bool (h.1 (NO.delta i)) true ;
 is-ev (u : Index) (a : PW.Carrier) : Id Bool (h.1 a) (a u.1) = calc Bool { h.1 a
  =< sym (BR.and-true (h.1 a)) > BR.and (h.1 a) true
  =< ap (BR.and (h.1 a)) (sym u.2) > BR.and (h.1 a) (h.1 (NO.delta u.1))
  =< sym (h.2.2.2 a (NO.delta u.1)) > h.1 (PW.mul a (NO.delta u.1))
  =< ap h.1 (PW.pw (PW.mul a (NO.delta u.1)) (PW.mul (\ n -> a u.1) (NO.delta u.1)) (\ n -> cut a u.1 n (NO.tri n u.1)))
  > h.1 (PW.mul (\ n -> a u.1) (NO.delta u.1))
  =< h.2.2.2 (\ n -> a u.1) (NO.delta u.1) > BR.and (h.1 (\ n -> a u.1)) (h.1 (NO.delta u.1))
  =< ap (\ t -> BR.and t (h.1 (NO.delta u.1))) (constant (a u.1)) > BR.and (a u.1) (h.1 (NO.delta u.1))
  =< ap (BR.and (a u.1)) u.2 > BR.and (a u.1) true
  =< BR.and-true (a u.1) > a u.1 } ;
 index-prop : Pr.isProp Index = \ u v ->
  Pr.Sigma-eq Nat (\ i -> Id Bool (h.1 (NO.delta i)) true) u.1 v.1 u.2 v.2
   (NO.delta-eq v.1 u.1 (trans (sym (is-ev u (NO.delta v.1))) v.2)) (BR.bool-set (h.1 (NO.delta v.1)) true) ;

 -- (2), the least m with h(u_m) = 1
 step : (n : Nat) -> Om.Min (\ m -> h.1 (below m)) n -> Index = split {
  zero -> \ mn -> Pr.absurd Index (BR.true-false (trans (sym mn.1) (H.zero PW.ring BR.two-ring h))) ;
  suc m -> \ mn -> (m, calc Bool { h.1 (NO.delta m)
   =< ap (\ t -> BR.xor t (h.1 (NO.delta m))) (sym (mn.2 m (NO.lt-suc m))) > BR.xor (h.1 (below m)) (h.1 (NO.delta m))
   =< sym (h.2.2.1 (below m) (NO.delta m)) > h.1 (below (suc m))
   =< mn.1 > true }) } ;
} ;

module Over (duality : SA.Duality) {
 module Cn = Om.Continuity[duality] ;
 -- (2)
 module Exists (h : Point) (m : (k : Nat) * Cn.Modulus h.1 k) {
  beta (n : Nat) : Bool = h.1 (below n) ;
  top : Id Bool (beta m.1) true = trans (m.2 (below m.1) PW.one (below-below m.1)) h.2.1 ;
  least : (n : Nat) * Om.Min beta n = Om.least-from beta (suc m.1) m.1 (NO.lt-suc m.1) top (Om.search beta (suc m.1)) ;
  index : At[h].Index = At[h].step least.1 least.2 ;
 } ;
 index (h : Point) : At[h].Index =
  TC.rec ((k : Nat) * Cn.Modulus h.1 k) @l At[h].Index At[h].index-prop (\ m -> Exists[h, m].index) (Cn.continuity h.1) ;

 -- N = Sp(2^N)
 back (h : Point) : Nat = (index h).1 ;
 ev-back (h : Point) : Id Point (ev (back h)) h =
  H.Properties[PW.ring, BR.two-ring, BR.bool-set].ext (ev (back h)) h (\ a -> sym (At[h].is-ev (index h) a)) ;
 back-ev (i : Nat) : Id Nat (back (ev i)) i =
  ap (\ u -> u.1) (At[ev i].index-prop (index (ev i)) (i, NO.delta-self i)) ;
 points : Pr.Equiv Nat Point = (ev, Pr.qinv Nat Point ev back ev-back back-ev) ;

 -- Stone duality for 2^N
 duality-cantor : Pr.isEquiv PW.Carrier (Point -> Bool) (SA.evaluation Cantor) =
  Pr.qinv PW.Carrier (Point -> Bool) (SA.evaluation Cantor) (\ phi i -> phi (ev i))
   (\ phi -> Axioms[l].FunExtLemmas[fe @l].funext Point (\ h -> Bool) _ phi (\ h ->
     trans (At[h].is-ev (index h) (\ i -> phi (ev i))) (ap phi (ev-back h))))
   (\ a -> refl a) ;
} ;
