-- Booleω is closed under binary products (used without proof in SSD
-- Theorem 1.17 for B∞ x B∞).
--
-- For A = 2[N]/(r n) and B = 2[N]/(s n), let e = g 0 and present A x B by
--   2[N]/(t m),   t (2n) = e /\ shift (r n) ,   t (2n+1) = (not e) /\ shift (s n) ,
-- where shift renames g n to g (n+1).  The morphism psi : 2[N] -> A x B,
-- g 0 |-> (1, 0), g (n+1) |-> ([g n], [g n]), kills every t m (psi o shift
-- is the pair of the two projections), so it induces phi : 2[N]/(t) -> A x B.
-- phi is surjective: (a, b) = phi (e shift(a~) + (not e) shift(b~)) for
-- representatives a~, b~.  phi is injective: by Axiom 1 it suffices that
-- every point p of 2[N]/(t) kills the kernel, and p factors through phi:
-- with beta n = p [g n], if beta 0 = 1 then beta o suc kills every r n and
-- p is the point beta o suc of A composed with the first projection (they
-- agree on the generators); symmetrically if beta 0 = 0.
level l k ;
open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module FF = FreeFinite[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module Pd = Product[l] ;
module Lg = Logic[l] ;
open NatOrder[l] ;
module SA = StoneAxioms[l,k] ;
module LN = BR.Laws[FN.free.ring, FN.free.idem] ;

module Over (ax : SA.Assumptions) {

 module PP (r s : Nat -> FN.Elem) {
  module Gr = P.Generated[FN.free, r] ;
  module Gs = P.Generated[FN.free, s] ;
  module D = Pd.Prod[P.Presented r, P.Presented s] ;
  module LD = RL[D.ring] ;
  e : FN.Elem = FN.gen zero ;
  ne : FN.Elem = LN.compl e ;
  t (m : Nat) : FN.Elem = inter FN.Elem m (\ n -> FN.emul e (FN.shift (r n))) (\ n -> FN.emul ne (FN.shift (s n))) ;
  module Gt = P.Generated[FN.free, t] ;

  gpsi : Nat -> D.Carrier = split {
   zero -> D.e ;
   suc n -> (Gr.Q.include (FN.gen n), Gs.Q.include (FN.gen n)) } ;
  module UD = FN.UP[D.product] ;
  psi : BR.Hom FN.free D.product = UD.extend gpsi ;
  pis : BR.Hom FN.free D.product = D.pair FN.free Gr.Q.pi Gs.Q.pi ;
  psi-shift (x : FN.Elem) : Id D.Carrier (psi.1 (FN.shift x)) (Gr.Q.include x, Gs.Q.include x) =
   calc D.Carrier { psi.1 (FN.shift x)
    =< UD.unique (H.compose FN.ring FN.ring D.ring psi FN.shift-hom) x
    > UD.ext (UD.values (H.compose FN.ring FN.ring D.ring psi FN.shift-hom)) x
    =< ap (\ g -> UD.ext g x) (F.funext Nat (\ n -> D.Carrier)
         (UD.values (H.compose FN.ring FN.ring D.ring psi FN.shift-hom)) (UD.values pis)
         (\ n -> trans (ap psi.1 (FN.shift-gen n)) (UD.ext-gen gpsi (suc n))))
    > UD.ext (UD.values pis) x
    =< sym (UD.unique pis x) > (Gr.Q.include x, Gs.Q.include x) } ;
  psi-e : Id D.Carrier (psi.1 e) D.e = UD.ext-gen gpsi zero ;
  module LDB = BR.Laws[D.ring, D.product.idem] ;
  module LA = RL[(P.Presented r).ring] ;
  module LB = RL[(P.Presented s).ring] ;
  psi-ne : Id D.Carrier (psi.1 ne) D.e' =
   trans (psi.2.2.1 FN.eone e) (trans (LDB.add-cong psi.2.1 psi-e)
    (FF.pair-path (BR.Laws[(P.Presented r).ring, (P.Presented r).idem].char2 Gr.Q.oneQ) ((P.Presented s).ring.addZ Gs.Q.oneQ))) ;

  kill-r (n : Nat) : Id Gr.Q.Carrier (Gr.Q.include (r n)) Gr.Q.zeroQ =
   Gr.Q.kills (r n) (T.Trunc[Gr.Below (r n)].inc (Gr.r-below n)) ;
  kill-s (n : Nat) : Id Gs.Q.Carrier (Gs.Q.include (s n)) Gs.Q.zeroQ =
   Gs.Q.kills (s n) (T.Trunc[Gs.Below (s n)].inc (Gs.r-below n)) ;
  kills-even (n : Nat) : Id D.Carrier (psi.1 (t (dbl n))) D.ring.z =
   calc D.Carrier { psi.1 (t (dbl n))
    =< ap psi.1 (inter-even FN.Elem n (\ j -> FN.emul e (FN.shift (r j))) (\ j -> FN.emul ne (FN.shift (s j))))
    > psi.1 (FN.emul e (FN.shift (r n)))
    =< psi.2.2.2 e (FN.shift (r n)) > D.ring.mul (psi.1 e) (psi.1 (FN.shift (r n)))
    =< LDB.mul-cong psi-e (psi-shift (r n)) > D.ring.mul D.e (Gr.Q.include (r n), Gs.Q.include (r n))
    =< FF.pair-path (trans (LA.one-left (Gr.Q.include (r n))) (kill-r n)) (LB.zero-mul (Gs.Q.include (r n)))
    > D.ring.z } ;
  kills-odd (n : Nat) : Id D.Carrier (psi.1 (t (suc (dbl n)))) D.ring.z =
   calc D.Carrier { psi.1 (t (suc (dbl n)))
    =< ap psi.1 (inter-odd FN.Elem n (\ j -> FN.emul e (FN.shift (r j))) (\ j -> FN.emul ne (FN.shift (s j))))
    > psi.1 (FN.emul ne (FN.shift (s n)))
    =< psi.2.2.2 ne (FN.shift (s n)) > D.ring.mul (psi.1 ne) (psi.1 (FN.shift (s n)))
    =< LDB.mul-cong psi-ne (psi-shift (s n)) > D.ring.mul D.e' (Gr.Q.include (s n), Gs.Q.include (s n))
    =< FF.pair-path (LA.zero-mul (Gr.Q.include (s n))) (trans (LB.one-left (Gs.Q.include (s n))) (kill-s n))
    > D.ring.z } ;
  kills-at (m : Nat) : Plus ((n : Nat) * Id Nat m (dbl n)) ((n : Nat) * Id Nat m (suc (dbl n))) ->
    Id D.Carrier (psi.1 (t m)) D.ring.z = split {
   inl u -> trans (ap (\ j -> psi.1 (t j)) u.2) (kills-even u.1) ;
   inr u -> trans (ap (\ j -> psi.1 (t j)) u.2) (kills-odd u.1) } ;
  kills (m : Nat) : Id D.Carrier (psi.1 (t m)) D.ring.z = kills-at m (parity m) ;

  module PhiM = Gt.Q.To[D.product].Extend[(psi, Gt.To[D.product].backward psi kills)] ;
  phi : BR.Hom (P.Presented t) D.product = PhiM.hom ;
  phi-include (x : FN.Elem) : Id D.Carrier (phi.1 (Gt.Q.include x)) (psi.1 x) = PhiM.D.beta x ;

  -- phi is surjective
  preimage (a b : FN.Elem) : Id D.Carrier
    (phi.1 (Gt.Q.include (FN.eadd (FN.emul e (FN.shift a)) (FN.emul ne (FN.shift b)))))
    (Gr.Q.include a, Gs.Q.include b) =
   calc D.Carrier { phi.1 (Gt.Q.include (FN.eadd (FN.emul e (FN.shift a)) (FN.emul ne (FN.shift b))))
    =< phi-include (FN.eadd (FN.emul e (FN.shift a)) (FN.emul ne (FN.shift b)))
    > psi.1 (FN.eadd (FN.emul e (FN.shift a)) (FN.emul ne (FN.shift b)))
    =< psi.2.2.1 (FN.emul e (FN.shift a)) (FN.emul ne (FN.shift b))
    > D.ring.add (psi.1 (FN.emul e (FN.shift a))) (psi.1 (FN.emul ne (FN.shift b)))
    =< LDB.add-cong (psi.2.2.2 e (FN.shift a)) (psi.2.2.2 ne (FN.shift b))
    > D.ring.add (D.ring.mul (psi.1 e) (psi.1 (FN.shift a))) (D.ring.mul (psi.1 ne) (psi.1 (FN.shift b)))
    =< LDB.add-cong (LDB.mul-cong psi-e (psi-shift a)) (LDB.mul-cong psi-ne (psi-shift b))
    > D.ring.add (D.ring.mul D.e (Gr.Q.include a, Gs.Q.include a)) (D.ring.mul D.e' (Gr.Q.include b, Gs.Q.include b))
    =< FF.pair-path
        (trans (BR.Laws[(P.Presented r).ring, (P.Presented r).idem].add-cong (LA.one-left (Gr.Q.include a)) (LA.zero-mul (Gr.Q.include b)))
               ((P.Presented r).ring.addZ (Gr.Q.include a)))
        (trans (BR.Laws[(P.Presented s).ring, (P.Presented s).idem].add-cong (LB.zero-mul (Gs.Q.include a)) (LB.one-left (Gs.Q.include b)))
               (LB.zl (Gs.Q.include b)))
    > (Gr.Q.include a, Gs.Q.include b) } ;
  surjective (d : D.Carrier) : T.Trunc[(q : Gt.Q.Carrier) * Id D.Carrier (phi.1 q) d].carrier =
   TC.map2 ((a : FN.Elem) * Id Gr.Q.Carrier (Gr.Q.include a) d.1) ((b : FN.Elem) * Id Gs.Q.Carrier (Gs.Q.include b) d.2)
    ((q : Gt.Q.Carrier) * Id D.Carrier (phi.1 q) d)
    (\ u v -> (Gt.Q.include (FN.eadd (FN.emul e (FN.shift u.1)) (FN.emul ne (FN.shift v.1))),
               trans (preimage u.1 v.1) (FF.pair-path u.2 v.2)))
    (Gr.Q.representative d.1) (Gs.Q.representative d.2) ;

  -- every point of 2[N]/(t) factors through phi
  module Factor (p : P.Sp (P.Presented t)) {
   beta (n : Nat) : Bool = p.1 (Gt.Q.include (FN.gen n)) ;
   z : P.Zeros t beta = ((P.sp-presented t).1 p).2 ;
   zr (h0 : Id Bool (beta zero) true) (n : Nat) : Id Bool ((r n).1 (\ m -> beta (suc m))) false =
    trans (sym (ap (\ b -> BR.and b ((r n).1 (\ m -> beta (suc m)))) h0))
     (trans (sym (ap (\ y -> y.1 beta) (inter-even FN.Elem n (\ j -> FN.emul e (FN.shift (r j))) (\ j -> FN.emul ne (FN.shift (s j))))))
      (z (dbl n))) ;
   zs (h0 : Id Bool (beta zero) false) (n : Nat) : Id Bool ((s n).1 (\ m -> beta (suc m))) false =
    trans (sym (ap (\ b -> BR.and (BR.xor true b) ((s n).1 (\ m -> beta (suc m)))) h0))
     (trans (sym (ap (\ y -> y.1 beta) (inter-odd FN.Elem n (\ j -> FN.emul e (FN.shift (r j))) (\ j -> FN.emul ne (FN.shift (s j))))))
      (z (suc (dbl n)))) ;
   qA (h0 : Id Bool (beta zero) true) : P.Sp (P.Presented r) = P.Point[r, \ m -> beta (suc m), zr h0].point ;
   qB (h0 : Id Bool (beta zero) false) : P.Sp (P.Presented s) = P.Point[s, \ m -> beta (suc m), zs h0].point ;
   left (h0 : Id Bool (beta zero) true) : P.Sp D.product = H.compose D.ring (P.Presented r).ring BR.two-ring (qA h0) D.fst ;
   right (h0 : Id Bool (beta zero) false) : P.Sp D.product = H.compose D.ring (P.Presented s).ring BR.two-ring (qB h0) D.snd ;
   agree-left (h0 : Id Bool (beta zero) true) : (m : Nat) ->
     Id Bool (p.1 (Gt.Q.include (FN.gen m))) ((left h0).1 (phi.1 (Gt.Q.include (FN.gen m)))) = split {
    zero -> trans h0 (sym (trans (ap (left h0).1 (trans (phi-include (FN.gen zero)) psi-e)) (qA h0).2.1)) ;
    suc n -> sym (trans (ap (left h0).1 (trans (phi-include (FN.gen (suc n))) (UD.ext-gen gpsi (suc n))))
      (P.Point[r, \ m -> beta (suc m), zr h0].value (FN.gen n))) } ;
   agree-right (h0 : Id Bool (beta zero) false) : (m : Nat) ->
     Id Bool (p.1 (Gt.Q.include (FN.gen m))) ((right h0).1 (phi.1 (Gt.Q.include (FN.gen m)))) = split {
    zero -> trans h0 (sym (trans (ap (right h0).1 (trans (phi-include (FN.gen zero)) psi-e))
      (H.zero (P.Presented s).ring BR.two-ring (qB h0)))) ;
    suc n -> sym (trans (ap (right h0).1 (trans (phi-include (FN.gen (suc n))) (UD.ext-gen gpsi (suc n))))
      (P.Point[s, \ m -> beta (suc m), zs h0].value (FN.gen n))) } ;
   kills-kernel-at (x : Gt.Q.Carrier) (hx : Id D.Carrier (phi.1 x) D.ring.z) :
     Plus (Id Bool (beta zero) true) (Id Bool (beta zero) false) -> Id Bool (p.1 x) false = split {
    inl h0 -> trans (ap (\ h -> h.1 x)
       (P.hom-ext-gen t BR.two p (H.compose (P.Presented t).ring D.ring BR.two-ring (left h0) phi) (agree-left h0)))
      (trans (ap (left h0).1 hx) (H.zero D.ring BR.two-ring (left h0))) ;
    inr h0 -> trans (ap (\ h -> h.1 x)
       (P.hom-ext-gen t BR.two p (H.compose (P.Presented t).ring D.ring BR.two-ring (right h0) phi) (agree-right h0)))
      (trans (ap (right h0).1 hx) (H.zero D.ring BR.two-ring (right h0))) } ;
   kills-kernel (x : Gt.Q.Carrier) (hx : Id D.Carrier (phi.1 x) D.ring.z) : Id Bool (p.1 x) false =
    kills-kernel-at x hx (TP.bool-cases (beta zero)) ;
  } ;
  Ct : P.Booleω = TP.presented-booleω t ;
  kernel (x : Gt.Q.Carrier) (hx : Id D.Carrier (phi.1 x) D.ring.z) : Id Gt.Q.Carrier x Gt.Q.zeroQ =
   Equivalences[l].injective Gt.Q.Carrier (P.Sp Ct.1 -> Bool) (SA.evaluation Ct.1) (ax.duality Ct) x Gt.Q.zeroQ
    (F.funext (P.Sp Ct.1) (\ q -> Bool) (SA.evaluation Ct.1 x) (SA.evaluation Ct.1 Gt.Q.zeroQ) (\ q ->
      trans (Factor[q].kills-kernel x hx) (sym (H.zero (P.Presented t).ring BR.two-ring q)))) ;
  injective (x y : Gt.Q.Carrier) (h : Id D.Carrier (phi.1 x) (phi.1 y)) : Id Gt.Q.Carrier x y =
   BR.Laws[(P.Presented t).ring, (P.Presented t).idem].sum-zero x y
    (kernel (Gt.Q.addQ x y) (trans (phi.2.2.1 x y) (trans (ap (\ u -> D.ring.add u (phi.1 y)) h) (LDB.char2 (phi.1 y))))) ;
  iso : P.Iso (P.Presented t) D.product =
   (phi, Bijection[l].Bij[Gt.Q.Carrier, D.Carrier, D.product.set, phi.1, injective, surjective].equiv) ;
 } ;

 product-booleω (A B : P.Booleω) : P.Booleω =
  (Pd.Prod[A.1, B.1].product,
   TC.map2 (P.Presentation A.1) (P.Presentation B.1) (P.Presentation Pd.Prod[A.1, B.1].product)
    (\ u v -> (PP[u.1, v.1].t,
      P.iso-compose (P.Presented PP[u.1, v.1].t) Pd.Prod[P.Presented u.1, P.Presented v.1].product Pd.Prod[A.1, B.1].product
       PP[u.1, v.1].iso (Pd.prod-iso (P.Presented u.1) A.1 (P.Presented v.1) B.1 u.2 v.2)))
    A.2 B.2) ;
} ;
