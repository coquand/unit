-- SSD Lemma 3.16: disjoint closed subsets F, G of a Stone space S are
-- separated by a decidable subset D (F inside D, G inside its complement).
--
-- On S = Sp(2[N]/(r)), F and G are cut out by maps fa, ga : S -> 2^N
-- (Theorem 3.11), and each fa _ n, ga _ n is the evaluation at an element
-- f' n, g' n of 2[N] (Axiom 1, countable choice for representatives).  The
-- algebra 2[N]/(r, f', g') has no point (a point would be in F and G), so
-- J K = 1 in 2[N] for some K (Lemma 1.12).  At a point x of F, r and every
-- f' vanish, so some g' j with j < K is 1 at x: D x = g' 0 \/ .. \/ g' (K-1)
-- at x is 1.  At a point of G every g' vanishes, so D is 0.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module BS = BoolSeq[l] ;
module Om = Omniscience[l,l] ;
module OC = OpenClosed[l,l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module Th = Thm311[l] ;
module SA = StoneAxioms[l,l] ;

Separation (S : U l) (A B : S -> U l) : U l =
 (D : S -> Bool) * ((x : S) -> A x -> Id Bool (D x) true) * ((x : S) -> B x -> Id Bool (D x) false) ;

-- j <= n < i gives j < i
lt-of-le (j n i : Nat) (h : NO.Lt j (suc n)) (h' : NO.Lt n i) : NO.Lt j i = NO.le-lt-trans j n i h h' ;

module Over (ax : SA.Assumptions) {
 module SD = StoneDuality[l,l].Over[ax] ;
 module ThO = Th.Over[ax] ;

 module Presented1 (S : U l) (r : Nat -> FN.Elem) (e : Pr.Equiv S (P.Sp (P.Presented r)))
   (fa ga : S -> Nat -> Bool) (disj : (x : S) -> Om.AllZero (fa x) -> Om.AllZero (ga x) -> Empty) {
  module G = P.Generated[FN.free, r] ;
  Bw : P.Booleω = TP.presented-booleω r ;
  df (n : Nat) : G.Q.Carrier = (ax.duality Bw).sec (\ s -> fa (e.2.sec s) n) ;
  dg (n : Nat) : G.Q.Carrier = (ax.duality Bw).sec (\ s -> ga (e.2.sec s) n) ;
  Rp (d : G.Q.Carrier) : U l = (x : FN.Elem) * Id G.Q.Carrier (G.Q.include x) d ;
  bits (x : S) (m : Nat) : Bool = (e.1 x).1 (G.Q.include (FN.gen m)) ;
  bits-zeros (x : S) : P.Zeros r (bits x) = ((P.sp-presented r).1 (e.1 x)).2 ;
  point-of (x : S) : Id (P.Sp (P.Presented r)) (P.Point[r, bits x, bits-zeros x].point) (e.1 x) =
   P.hom-ext-gen r BR.two (P.Point[r, bits x, bits-zeros x].point) (e.1 x) (\ m -> P.Point[r, bits x, bits-zeros x].value (FN.gen m)) ;
  -- the value of a representative of an element at a point of S
  rep-at (h : S -> Bool) (c : Rp ((ax.duality Bw).sec (\ s -> h (e.2.sec s)))) (beta : Nat -> Bool) (z : P.Zeros r beta) :
    Id Bool (c.1.1 beta) (h (e.2.sec (P.Point[r, beta, z].point))) =
   trans (sym (P.Point[r, beta, z].value c.1))
    (trans (ap (P.Point[r, beta, z].point).1 c.2)
     (Pr.happly (P.Sp Bw.1) (\ s -> Bool) _ _ ((ax.duality Bw).sec-eq (\ s -> h (e.2.sec s))) (P.Point[r, beta, z].point))) ;
  rep-x (h : S -> Bool) (c : Rp ((ax.duality Bw).sec (\ s -> h (e.2.sec s)))) (x : S) : Id Bool (c.1.1 (bits x)) (h x) =
   trans (rep-at h c (bits x) (bits-zeros x))
    (trans (ap (\ s -> h (e.2.sec s)) (point-of x)) (ap h (Pr.sec-ret S (P.Sp (P.Presented r)) e.1 e.2 x))) ;

  module WithReps (cf : (n : Nat) -> Rp (df n)) (cg : (n : Nat) -> Rp (dg n)) {
   fg (n : Nat) : FN.Elem = NO.inter FN.Elem n (\ j -> (cf j).1) (\ j -> (cg j).1) ;
   t (i : Nat) : FN.Elem = NO.inter FN.Elem i r fg ;
   module Gt = P.Generated[FN.free, t] ;
   -- the relations at a zero
   zr (beta : Nat -> Bool) (z : P.Zeros t beta) : P.Zeros r beta = \ n ->
    trans (sym (ap (\ y -> y.1 beta) (NO.inter-even FN.Elem n r fg))) (z (NO.dbl n)) ;
   zfg (beta : Nat -> Bool) (z : P.Zeros t beta) (n : Nat) : Id Bool ((fg n).1 beta) false =
    trans (sym (ap (\ y -> y.1 beta) (NO.inter-odd FN.Elem n r fg))) (z (suc (NO.dbl n))) ;
   zf (beta : Nat -> Bool) (z : P.Zeros t beta) (j : Nat) : Id Bool ((cf j).1.1 beta) false =
    trans (sym (ap (\ y -> y.1 beta) (NO.inter-even FN.Elem j (\ i -> (cf i).1) (\ i -> (cg i).1)))) (zfg beta z (NO.dbl j)) ;
   zg (beta : Nat -> Bool) (z : P.Zeros t beta) (j : Nat) : Id Bool ((cg j).1.1 beta) false =
    trans (sym (ap (\ y -> y.1 beta) (NO.inter-odd FN.Elem j (\ i -> (cf i).1) (\ i -> (cg i).1)))) (zfg beta z (suc (NO.dbl j))) ;
   -- no point
   no-point-at (beta : Nat -> Bool) (z : P.Zeros t beta) : Empty =
    disj (e.2.sec (P.Point[r, beta, zr beta z].point))
     (\ n -> trans (sym (rep-at (\ x -> fa x n) (cf n) beta (zr beta z))) (zf beta z n))
     (\ n -> trans (sym (rep-at (\ x -> ga x n) (cg n) beta (zr beta z))) (zg beta z n)) ;
   no-point (s : P.Sp (P.Presented t)) : Empty = no-point-at ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2 ;
   trivial : T.Trunc[(K : Nat) * Id FN.Elem (Gt.J K) FN.eone].carrier =
    Gt.trivial (sym ((SD.lemma112 (TP.presented-booleω t)).2 no-point)) ;

   module Sep (K : Nat) (hK : Id FN.Elem (Gt.J K) FN.eone) {
    D (x : S) : Bool = BS.bor (\ j -> (cg j).1.1 (bits x)) K ;
    -- at a point of F, the generator of t below K which is 1 is some g' j
    hit (x : S) : (i : Nat) * NO.Lt i K * Id Bool ((t i).1 (bits x)) true =
     BS.bor-true-inv K (\ i -> (t i).1 (bits x)) (trans (sym (BS.J-bor t (bits x) K)) (ap (\ y -> y.1 (bits x)) hK)) ;
    inner (x : S) (fx : Om.AllZero (fa x)) (i n : Nat) (lt : NO.Lt i K) (pn : Id Nat i (suc (NO.dbl n)))
      (h : Id Bool ((fg n).1 (bits x)) true) :
      Plus ((j : Nat) * Id Nat n (NO.dbl j)) ((j : Nat) * Id Nat n (suc (NO.dbl j))) -> Id Bool (D x) true = split {
     inl u -> Pr.absurd (Id Bool (D x) true) (NO.false-true (trans (sym (trans (rep-x (\ y -> fa y u.1) (cf u.1) x) (fx u.1)))
        (trans (sym (ap (\ y -> y.1 (bits x)) (NO.inter-even FN.Elem u.1 (\ j -> (cf j).1) (\ j -> (cg j).1))))
         (trans (ap (\ m -> (fg m).1 (bits x)) (sym u.2)) h)))) ;
     inr u -> BS.bor-true K (\ j -> (cg j).1.1 (bits x)) u.1
       (NO.lt-trans u.1 i K (NO.lt-trans u.1 n i (subst (NO.Lt u.1) (sym u.2) (Cor37[l,l].lt-dbl u.1))
          (subst (NO.Lt n) (sym pn) (Cor37[l,l].lt-dbl n))) lt)
       (trans (sym (ap (\ y -> y.1 (bits x)) (NO.inter-odd FN.Elem u.1 (\ j -> (cf j).1) (\ j -> (cg j).1))))
        (trans (ap (\ m -> (fg m).1 (bits x)) (sym u.2)) h)) } ;
    outer (x : S) (fx : Om.AllZero (fa x)) (i : Nat) (lt : NO.Lt i K) (h : Id Bool ((t i).1 (bits x)) true) :
      Plus ((n : Nat) * Id Nat i (NO.dbl n)) ((n : Nat) * Id Nat i (suc (NO.dbl n))) -> Id Bool (D x) true = split {
     inl u -> Pr.absurd (Id Bool (D x) true) (NO.false-true (trans (sym (bits-zeros x u.1))
        (trans (sym (ap (\ y -> y.1 (bits x)) (NO.inter-even FN.Elem u.1 r fg))) (trans (ap (\ m -> (t m).1 (bits x)) (sym u.2)) h)))) ;
     inr u -> inner x fx i u.1 lt u.2
       (trans (sym (ap (\ y -> y.1 (bits x)) (NO.inter-odd FN.Elem u.1 r fg))) (trans (ap (\ m -> (t m).1 (bits x)) (sym u.2)) h))
       (NO.parity u.1) } ;
    in-F (x : S) (fx : Om.AllZero (fa x)) : Id Bool (D x) true =
     outer x fx (hit x).1 (hit x).2.1 (hit x).2.2 (NO.parity (hit x).1) ;
    in-G (x : S) (gx : Om.AllZero (ga x)) : Id Bool (D x) false =
     BS.bor-false K (\ j -> (cg j).1.1 (bits x)) (\ j lt -> trans (rep-x (\ y -> ga y j) (cg j) x) (gx j)) ;
    sep : Separation S (\ x -> Om.AllZero (fa x)) (\ x -> Om.AllZero (ga x)) = (D, in-F, in-G) ;
   } ;
   result : T.Trunc[Separation S (\ x -> Om.AllZero (fa x)) (\ x -> Om.AllZero (ga x))].carrier =
    TC.map ((K : Nat) * Id FN.Elem (Gt.J K) FN.eone) (Separation S (\ x -> Om.AllZero (fa x)) (\ x -> Om.AllZero (ga x)))
     (\ kh -> Sep[kh.1, kh.2].sep) trivial ;
  } ;
  result : T.Trunc[Separation S (\ x -> Om.AllZero (fa x)) (\ x -> Om.AllZero (ga x))].carrier =
   TC.bind ((n : Nat) -> Rp (df n)) (Separation S (\ x -> Om.AllZero (fa x)) (\ x -> Om.AllZero (ga x)))
    (\ cf -> TC.bind ((n : Nat) -> Rp (dg n)) (Separation S (\ x -> Om.AllZero (fa x)) (\ x -> Om.AllZero (ga x)))
      (\ cg -> WithReps[cf, cg].result)
      (CountableChoice[l].cc (ax.dc @l) (\ n -> Rp (dg n)) (\ n -> G.Q.representative (dg n))))
    (CountableChoice[l].cc (ax.dc @l) (\ n -> Rp (df n)) (\ n -> G.Q.representative (df n))) ;
 } ;
 -- Lemma 3.16
 lemma316 (S : U l) (sS : PF.isStone S) (A B : S -> U l) (pA : (x : S) -> Pr.isProp (A x)) (pB : (x : S) -> Pr.isProp (B x))
   (cA : (x : S) -> OC.isClosed (A x)) (cB : (x : S) -> OC.isClosed (B x)) (disj : (x : S) -> A x -> B x -> Empty) :
   T.Trunc[Separation S A B].carrier =
  TC.bind (Th.Cut S A) (Separation S A B) (\ ca ->
   TC.bind (Th.Cut S B) (Separation S A B) (\ cb ->
    SC.on-stone S (T.Trunc[Separation S A B].carrier) T.Trunc[Separation S A B].proposition sS (\ r e ->
     TC.map (Separation S (\ x -> Om.AllZero (ca.1 x)) (\ x -> Om.AllZero (cb.1 x))) (Separation S A B)
      (\ d -> (d.1, \ x a -> d.2.1 x ((ca.2 x).1 a), \ x b -> d.2.2 x ((cb.2 x).1 b)))
      (Presented1[S, r, e, ca.1, cb.1, \ x za zb -> disj x ((ca.2 x).2 za) ((cb.2 x).2 zb)].result)))
    (ThO.closed-cut S sS B pB cB))
   (ThO.closed-cut S sS A pA cA) ;
} ;
