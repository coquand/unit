-- SSD Remark 3.4 for surjections: a surjection f : X ->> Y of Stone spaces
-- is the sequential limit of surjections of finite sets.
--
-- Let X = Sp(2[N]/(rX)), Y = Sp(2[N]/(rY)), and c i in 2[N] the coordinates
-- of f (ImageClosed).  Code x : X by  code x = join (y-bits of f x) (bits x):
-- odd bits are those of x, even bits those of f x.  The codes are exactly
-- the zeros of the relations (with truth tables, countable choice)
--   rX on the odd bits,  "even bit i = c i on the odd bits",  rY on the
--   even bits
-- (the last family holds anyway; it is there so that the finite stages see
-- it).  Let E n be the n-th stage of these relations (CantorStages), so
-- X = lim E, and F n the image of E n under mask (zero the odd bits),
-- which is finite.  g n = mask : E n ->> F n is surjective and compatible.
-- lim F = Y: a point y gives the masks of the prefixes of a code of a
-- preimage of y (f is surjective); conversely the even bits of a point of
-- lim F satisfy every relation of rY, since a stage element whose mask is
-- the prefix satisfies the relations of rY of small size on its even bits,
-- and its odd bits are 0.  Under these, f is the limit of the g n.
-- (The paper derives this from Remark 2.16 and Axiom 2.)
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FF = FreeFinite[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module NA = NatArith[l] ;
module Tb = Tabulate[l] ;
module CS = CantorStages[l] ;
module Sp = Spread[l] ;
module BS = BoolSeq[l] ;
module FFa = FiniteFacts[l] ;
module Fi = Finite[l] ;
module FCl = FiniteClosure[l] ;
module DCh = DependentChoice[l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module IC = ImageClosed[l] ;
module SA = StoneAxioms[l,l] ;
module Eq = Equivalences[l] ;
module Bi = Bijection[l] ;

-- the bits of a mask
bit-mask-at (n : Nat) (v : CS.Bits (suc n)) (m : Nat) (r : Id Bool (CS.bit n (Sp.mask n v.1) m) (BR.and (Sp.evenB m) (CS.bit n v.1 m))) :
  (t : NO.Tri m n) -> Id Bool (CS.sel m n t (CS.bit n (Sp.mask n v.1) m) (BR.and (Sp.evenB n) v.2))
                              (BR.and (Sp.evenB m) (CS.sel m n t (CS.bit n v.1 m) v.2)) = split {
 less h -> r ;
 equal p -> ap (\ j -> BR.and (Sp.evenB j) v.2) (sym p) ;
 greater h -> sym (TP.and-false (Sp.evenB m)) } ;
bit-mask : (n : Nat) (v : CS.Bits n) (m : Nat) -> Id Bool (CS.bit n (Sp.mask n v) m) (BR.and (Sp.evenB m) (CS.bit n v m)) = split {
 zero -> \ v m -> sym (TP.and-false (Sp.evenB m)) ;
 suc n | r -> \ v m -> bit-mask-at n v m (r v.1 m) (NO.tri m n) } ;

-- a relation given by a local function, and its truth table
Rel : U l = (k : Nat) * (R : FN.Fun) * Tb.Local k R ;
rel-rep (w : Rel) : FN.Rep w.2.1 = Tb.local-rep w.1 w.2.1 w.2.2 ;
rel-table (w : Rel) : (k : Nat) * FF.Tab k = ((rel-rep w).1, (rel-rep w).2.1) ;
rel-value (w : Rel) (a : Nat -> Bool) : Id Bool (FN.ev (rel-table w).1 (rel-table w).2 a) (w.2.1 a) =
 Pr.happly (Nat -> Bool) (\ b -> Bool) _ w.2.1 (rel-rep w).2.2 a ;

-- a compatible family of maps between two sequences, and its limit
limit-map (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) (G : Nat -> U l) (q : (n : Nat) -> G (suc n) -> G n)
  (g : (n : Nat) -> E n -> G n) (comm : (n : Nat) (e : E (suc n)) -> Id (G n) (q n (g (suc n) e)) (g n (p n e)))
  (x : DCh.Lim E p) : DCh.Lim G q =
 (\ n -> g n (x.1 n), \ n -> trans (comm n (x.1 (suc n))) (ap (g n) (x.2 n))) ;
-- a map of Stone spaces as a limit of maps of finite sets, levelwise surjective
record SurjLim (X Y : U l) (f : X -> Y) {
 E : Nat -> U l ;
 p : (n : Nat) -> E (suc n) -> E n ;
 G : Nat -> U l ;
 q : (n : Nat) -> G (suc n) -> G n ;
 finE : (n : Nat) -> Fi.isFinite (E n) ;
 finG : (n : Nat) -> Fi.isFinite (G n) ;
 g : (n : Nat) -> E n -> G n ;
 comm : (n : Nat) (e : E (suc n)) -> Id (G n) (q n (g (suc n) e)) (g n (p n e)) ;
 surj : (n : Nat) -> DCh.Surjective (g n) ;
 eX : Pr.Equiv X (DCh.Lim E p) ;
 eY : Pr.Equiv Y (DCh.Lim G q) ;
 over : (x : X) -> Id (DCh.Lim G q) (eY.1 (f x)) (limit-map E p G q g comm (eX.1 x)) ;
} ;

module Over (ax : SA.Assumptions) {
 module SD = StoneDuality[l,l].Over[ax] ;

 module Presented2 (X Y : U l) (rX rY : Nat -> FN.Elem)
   (eX : Pr.Equiv X (P.Sp (P.Presented rX))) (eY : Pr.Equiv Y (P.Sp (P.Presented rY))) (f : X -> Y) (fs : DCh.Surjective f) {
  module I = IC.Over[ax].Presented2[X, Y, rX, rY, eX, eY, f] ;

  module WithChoice (c : (i : Nat) -> I.Rp i) (tX : (j : Nat) -> FN.Rep (rX j).1) (tY : (j : Nat) -> FN.Rep (rY j).1)
    (tc : (i : Nat) -> FN.Rep (c i).1.1) {
   module W = I.WithReps[c] ;
   famX (j : Nat) : Rel = (NO.dbl (tX j).1, \ a -> FN.ev (tX j).1 (tX j).2.1 (Sp.odds a), Sp.odds-local (tX j).1 (tX j).2.1) ;
   famY (j : Nat) : Rel = (NO.dbl (tY j).1, \ a -> FN.ev (tY j).1 (tY j).2.1 (Sp.evens a), Sp.evens-local (tY j).1 (tY j).2.1) ;
   famC (i : Nat) : Rel = (Sp.coord-bound i (tc i).1, \ a -> BR.xor (a (NO.dbl i)) (FN.ev (tc i).1 (tc i).2.1 (Sp.odds a)),
     Sp.coord-local i (tc i).1 (tc i).2.1) ;
   famXC (n : Nat) : Rel = NO.inter Rel n famX famC ;
   fam (m : Nat) : Rel = NO.inter Rel m famXC famY ;
   t : CS.TPres = \ m -> rel-table (fam m) ;
   module St = CS.Stages[t] ;
   value (m : Nat) (a : Nat -> Bool) : Id Bool (St.value m a) ((fam m).2.1 a) = rel-value (fam m) a ;

   -- the families at their indices
   at-X (j : Nat) (a : Nat -> Bool) : Id Bool ((fam (NO.dbl (NO.dbl j))).2.1 a) ((famX j).2.1 a) =
    ap (\ w -> w.2.1 a) (trans (NO.inter-even Rel (NO.dbl j) famXC famY) (NO.inter-even Rel j famX famC)) ;
   at-C (i : Nat) (a : Nat -> Bool) : Id Bool ((fam (NO.dbl (suc (NO.dbl i)))).2.1 a) ((famC i).2.1 a) =
    ap (\ w -> w.2.1 a) (trans (NO.inter-even Rel (suc (NO.dbl i)) famXC famY) (NO.inter-odd Rel i famX famC)) ;
   at-Y (j : Nat) (a : Nat -> Bool) : Id Bool ((fam (suc (NO.dbl j))).2.1 a) ((famY j).2.1 a) =
    ap (\ w -> w.2.1 a) (NO.inter-odd Rel j famXC famY) ;

   -- the code of a point
   code (x : X) : Nat -> Bool = Sp.join (I.yhat (f x)) (I.bits x) ;
   odds-code (x : X) : Id (Nat -> Bool) (Sp.odds (code x)) (I.bits x) =
    F.funext Nat (\ i -> Bool) (Sp.odds (code x)) (I.bits x) (Sp.odds-join (I.yhat (f x)) (I.bits x)) ;
   evens-code (x : X) : Id (Nat -> Bool) (Sp.evens (code x)) (I.yhat (f x)) =
    F.funext Nat (\ i -> Bool) (Sp.evens (code x)) (I.yhat (f x)) (Sp.evens-join (I.yhat (f x)) (I.bits x)) ;
   coord-x (x : X) (i : Nat) : Id Bool ((c i).1.1 (I.bits x)) (I.yhat (f x) i) =
    trans (W.cval i (I.bits x) (I.bits-zeros x))
     (trans (ap (\ s -> I.yhat (f (eX.2.sec s)) i) (I.point-of x))
      (ap (\ x' -> I.yhat (f x') i) (Pr.sec-ret X (P.Sp (P.Presented rX)) eX.1 eX.2 x))) ;
   zX (x : X) (j : Nat) : Id Bool ((famX j).2.1 (code x)) false =
    trans (ap (FN.ev (tX j).1 (tX j).2.1) (odds-code x))
     (trans (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (tX j).2.2 (I.bits x)) (I.bits-zeros x j)) ;
   zC (x : X) (i : Nat) : Id Bool ((famC i).2.1 (code x)) false =
    trans (FN.cong2 BR.xor (Sp.evens-join (I.yhat (f x)) (I.bits x) i)
            (trans (ap (FN.ev (tc i).1 (tc i).2.1) (odds-code x)) (trans (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (tc i).2.2 (I.bits x)) (coord-x x i))))
     (BR.xor-self (I.yhat (f x) i)) ;
   zY (x : X) (j : Nat) : Id Bool ((famY j).2.1 (code x)) false =
    trans (ap (FN.ev (tY j).1 (tY j).2.1) (evens-code x))
     (trans (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (tY j).2.2 (I.yhat (f x))) (((P.sp-presented rY).1 (eY.1 (f x))).2 j)) ;
   zeros-inner (x : X) (n : Nat) :
     Plus ((j : Nat) * Id Nat n (NO.dbl j)) ((j : Nat) * Id Nat n (suc (NO.dbl j))) -> Id Bool ((fam (NO.dbl n)).2.1 (code x)) false = split {
    inl u -> trans (ap (\ k -> (fam (NO.dbl k)).2.1 (code x)) u.2) (trans (at-X u.1 (code x)) (zX x u.1)) ;
    inr u -> trans (ap (\ k -> (fam (NO.dbl k)).2.1 (code x)) u.2) (trans (at-C u.1 (code x)) (zC x u.1)) } ;
   zeros-outer (x : X) (m : Nat) :
     Plus ((n : Nat) * Id Nat m (NO.dbl n)) ((n : Nat) * Id Nat m (suc (NO.dbl n))) -> Id Bool ((fam m).2.1 (code x)) false = split {
    inl u -> trans (ap (\ k -> (fam k).2.1 (code x)) u.2) (zeros-inner x u.1 (NO.parity u.1)) ;
    inr u -> trans (ap (\ k -> (fam k).2.1 (code x)) u.2) (trans (at-Y u.1 (code x)) (zY x u.1)) } ;
   code-zeros (x : X) : St.Zeros (code x) = \ m -> trans (value m (code x)) (zeros-outer x m (NO.parity m)) ;

   -- reading a point off a zero
   from-X (a : Nat -> Bool) (z : St.Zeros a) (j : Nat) : Id Bool ((famX j).2.1 a) false =
    trans (sym (at-X j a)) (trans (sym (value (NO.dbl (NO.dbl j)) a)) (z (NO.dbl (NO.dbl j)))) ;
   from-C (a : Nat -> Bool) (z : St.Zeros a) (i : Nat) : Id Bool ((famC i).2.1 a) false =
    trans (sym (at-C i a)) (trans (sym (value (NO.dbl (suc (NO.dbl i))) a)) (z (NO.dbl (suc (NO.dbl i))))) ;
   from-Y (a : Nat -> Bool) (z : St.Zeros a) (j : Nat) : Id Bool ((famY j).2.1 a) false =
    trans (sym (at-Y j a)) (trans (sym (value (suc (NO.dbl j)) a)) (z (suc (NO.dbl j)))) ;
   odds-zeros (a : Nat -> Bool) (z : St.Zeros a) : P.Zeros rX (Sp.odds a) = \ j ->
    trans (sym (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (tX j).2.2 (Sp.odds a))) (from-X a z j) ;
   from (a : Nat -> Bool) (z : St.Zeros a) : X = eX.2.sec (P.Point[rX, Sp.odds a, odds-zeros a z].point) ;
   bits-from (a : Nat -> Bool) (z : St.Zeros a) (i : Nat) : Id Bool (I.bits (from a z) i) (Sp.odds a i) =
    trans (ap (\ s -> s.1 (I.GX.Q.include (FN.gen i))) (eX.2.sec-eq (P.Point[rX, Sp.odds a, odds-zeros a z].point)))
     (P.Point[rX, Sp.odds a, odds-zeros a z].value (FN.gen i)) ;
   yhat-from (a : Nat -> Bool) (z : St.Zeros a) (i : Nat) : Id Bool (I.yhat (f (from a z)) i) (Sp.evens a i) =
    sym (trans (SC.xor-eq (a (NO.dbl i)) (FN.ev (tc i).1 (tc i).2.1 (Sp.odds a)) (from-C a z i))
     (trans (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (tc i).2.2 (Sp.odds a)) (W.cval i (Sp.odds a) (odds-zeros a z)))) ;
   code-from (a : Nat -> Bool) (z : St.Zeros a) : Id (Nat -> Bool) (code (from a z)) a =
    F.funext Nat (\ m -> Bool) (code (from a z)) a (\ m ->
     trans (FN.cong2 (\ y x' -> Sp.join y x' m)
        (F.funext Nat (\ i -> Bool) (I.yhat (f (from a z))) (Sp.evens a) (yhat-from a z))
        (F.funext Nat (\ i -> Bool) (I.bits (from a z)) (Sp.odds a) (bits-from a z)))
      (Sp.join-parts a m)) ;
   code-inj (x x' : X) (q : Id (Nat -> Bool) (code x) (code x')) : Id X x x' =
    Eq.injective X (P.Sp (P.Presented rX)) eX.1 eX.2 x x'
     (P.hom-ext-gen rX BR.two (eX.1 x) (eX.1 x') (\ i ->
       trans (sym (Pr.happly Nat (\ j -> Bool) _ _ (odds-code x) i))
        (trans (ap (\ a -> Sp.odds a i) q) (Pr.happly Nat (\ j -> Bool) _ _ (odds-code x') i)))) ;
   Zs : U l = (a : Nat -> Bool) * St.Zeros a ;
   zs-set : Pr.isSet Zs = Pr.isSet-Sigma (Nat -> Bool) St.Zeros (F.isSet-Pi Nat (\ i -> Bool) (\ i -> BR.bool-set)) (\ a -> Pr.prop-to-set (St.Zeros a) (St.zeros-prop a)) ;
   to-zs (x : X) : Zs = (code x, code-zeros x) ;
   coding : Pr.Equiv X Zs =
    (to-zs, Bi.Bij[X, Zs, zs-set, to-zs, \ x x' q -> code-inj x x' (ap (\ u -> u.1) q),
      \ u -> T.Trunc[(x : X) * Id Zs (to-zs x) u].inc (from u.1 u.2,
        Pr.Sigma-eq (Nat -> Bool) St.Zeros (code (from u.1 u.2)) u.1 (code-zeros (from u.1 u.2)) u.2 (code-from u.1 u.2) (St.zeros-prop u.1))].equiv) ;
   eXL : Pr.Equiv X St.Lim = Eq.compose X Zs St.Lim coding St.equivalence ;

   ---------------------------------------------------------------------
   -- the target stages: images of the stages under mask
   Fmem (n : Nat) (w : CS.Bits n) : U l = T.Trunc[(v : St.Stage n) * Id (CS.Bits n) (Sp.mask n v.1) w].carrier ;
   Fstage (n : Nat) : U l = (w : CS.Bits n) * Fmem n w ;
   F-finite (n : Nat) : Fi.isFinite (Fstage n) =
    FCl.sigma-finite (CS.Bits n) (CS.bits-finite n) (Fmem n) (\ w ->
     FCl.trunc-finite ((v : St.Stage n) * Id (CS.Bits n) (Sp.mask n v.1) w)
      (FCl.sigma-finite (St.Stage n) (St.stage-finite n) (\ v -> Id (CS.Bits n) (Sp.mask n v.1) w)
        (\ v -> FCl.id-finite (CS.Bits n) (CS.bits-finite n) (Sp.mask n v.1) w))) ;
   F-set (n : Nat) : Pr.isSet (Fstage n) =
    Pr.isSet-Sigma (CS.Bits n) (Fmem n) (CS.bits-set n) (\ w -> Pr.prop-to-set (Fmem n w) T.Trunc[(v : St.Stage n) * Id (CS.Bits n) (Sp.mask n v.1) w].proposition) ;
   F-eq (n : Nat) (u v : Fstage n) (h : Id (CS.Bits n) u.1 v.1) : Id (Fstage n) u v =
    Pr.Sigma-eq (CS.Bits n) (Fmem n) u.1 v.1 u.2 v.2 h T.Trunc[(v' : St.Stage n) * Id (CS.Bits n) (Sp.mask n v'.1) v.1].proposition ;
   Fq (n : Nat) (w : Fstage (suc n)) : Fstage n =
    (w.1.1, TC.map ((v : St.Stage (suc n)) * Id (CS.Bits (suc n)) (Sp.mask (suc n) v.1) w.1)
      ((v : St.Stage n) * Id (CS.Bits n) (Sp.mask n v.1) w.1.1) (\ u -> (St.restrict n u.1, ap (\ b -> b.1) u.2)) w.2) ;
   gm (n : Nat) (v : St.Stage n) : Fstage n =
    (Sp.mask n v.1, T.Trunc[(v' : St.Stage n) * Id (CS.Bits n) (Sp.mask n v'.1) (Sp.mask n v.1)].inc (v, refl (Sp.mask n v.1))) ;
   g-comm (n : Nat) (v : St.Stage (suc n)) : Id (Fstage n) (Fq n (gm (suc n) v)) (gm n (St.restrict n v)) =
    F-eq n (Fq n (gm (suc n) v)) (gm n (St.restrict n v)) (refl (Sp.mask n v.1.1)) ;
   g-surj (n : Nat) : DCh.Surjective (gm n) = \ w ->
    TC.map ((v : St.Stage n) * Id (CS.Bits n) (Sp.mask n v.1) w.1) ((v : St.Stage n) * Id (Fstage n) (gm n v) w)
     (\ u -> (u.1, F-eq n (gm n u.1) w u.2)) w.2 ;
   FLim : U l = DCh.Lim Fstage Fq ;
   flim-eq (u v : FLim) (h : (n : Nat) -> Id (CS.Bits n) (u.1 n).1 (v.1 n).1) : Id FLim u v =
    Pr.Sigma-eq ((n : Nat) -> Fstage n) (\ z -> (n : Nat) -> Id (Fstage n) (Fq n (z (suc n))) (z n)) u.1 v.1 u.2 v.2
     (F.funext Nat Fstage u.1 v.1 (\ n -> F-eq n (u.1 n) (v.1 n) (h n)))
     (F.isProp-Pi Nat (\ n -> Id (Fstage n) (Fq n (v.1 (suc n))) (v.1 n)) (\ n -> F-set n _ _)) ;
   seqbitF (d : FLim) (m : Nat) : Bool = (d.1 (suc m)).1.2 ;
   F-prefix (d : FLim) : (n : Nat) -> Id (CS.Bits n) (CS.prefix n (seqbitF d)) (d.1 n).1 = split {
    zero -> isTop tt (d.1 zero).1 ;
    suc n | r -> FF.pair-path (trans r (sym (ap (\ y -> y.1) (d.2 n)))) (refl (seqbitF d n)) } ;
   -- a bit of a point of lim F, read on a stage element whose mask is its prefix
   bit-of (d : FLim) (N : Nat) (v : St.Stage N) (u : Id (CS.Bits N) (Sp.mask N v.1) (d.1 N).1) (m : Nat) (lt : NO.Lt m N) :
     Id Bool (seqbitF d m) (BR.and (Sp.evenB m) (CS.bit N v.1 m)) =
    calc Bool { seqbitF d m
     =< sym (CS.bit-prefix N (seqbitF d) m lt) > CS.bit N (CS.prefix N (seqbitF d)) m
     =< ap (\ w -> CS.bit N w m) (trans (F-prefix d N) (sym u)) > CS.bit N (Sp.mask N v.1) m
     =< bit-mask N v.1 m > BR.and (Sp.evenB m) (CS.bit N v.1 m) } ;

   -- Y -> lim F
   spread (y : Y) : Nat -> Bool = Sp.join (I.yhat y) (\ i -> false) ;
   mask-code (x : X) (n : Nat) : Id (CS.Bits n) (Sp.mask n (CS.prefix n (code x))) (CS.prefix n (spread (f x))) =
    trans (Sp.mask-prefix n (code x))
     (ap (CS.prefix n) (F.funext Nat (\ m -> Bool) (Sp.masked (code x)) (spread (f x)) (\ m ->
       trans (Sp.masked-join (code x) m) (ap (\ y -> Sp.join y (\ i -> false) m) (evens-code x))))) ;
   mem (y : Y) (n : Nat) : Fmem n (CS.prefix n (spread y)) =
    TC.map ((x : X) * Id Y (f x) y) ((v : St.Stage n) * Id (CS.Bits n) (Sp.mask n v.1) (CS.prefix n (spread y)))
     (\ u -> ((St.to (to-zs u.1)).1 n, trans (mask-code u.1 n) (ap (\ y' -> CS.prefix n (spread y')) u.2))) (fs y) ;
   toF (y : Y) : FLim = (\ n -> (CS.prefix n (spread y), mem y n), \ n -> F-eq n _ _ (refl (CS.prefix n (spread y)))) ;

   -- lim F -> Y
   ye (d : FLim) (i : Nat) : Bool = seqbitF d (NO.dbl i) ;
   module ZY (d : FLim) (j : Nat) {
    m : Nat = suc (NO.dbl j) ;
    N : Nat = suc (NA.plus m (St.sz m)) ;
    size : Id Nat (St.sz m) (NO.dbl (tY j).1) = ap (\ w -> w.1) (NO.inter-odd Rel j famXC famY) ;
    at (u : (v : St.Stage N) * Id (CS.Bits N) (Sp.mask N v.1) (d.1 N).1) : Id Bool ((rY j).1 (ye d)) false =
     calc Bool { (rY j).1 (ye d)
      =< sym (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (tY j).2.2 (ye d)) > FN.ev (tY j).1 (tY j).2.1 (ye d)
      =< CS.table-agree (tY j).1 (tY j).2.1 (ye d) (Sp.evens (CS.bit N u.1.1)) (\ i lt ->
          trans (bit-of d N u.1 u.2 (NO.dbl i)
                  (NO.lt-trans (NO.dbl i) (St.sz m) N (subst (NO.Lt (NO.dbl i)) (sym size) (Sp.dbl-lt-even (tY j).1 i lt)) (BS.lt-right m (St.sz m))))
           (ap (\ b -> BR.and b (CS.bit N u.1.1 (NO.dbl i))) (Sp.evenB-dbl i)))
      > (famY j).2.1 (CS.bit N u.1.1)
      =< sym (at-Y j (CS.bit N u.1.1)) > (fam m).2.1 (CS.bit N u.1.1)
      =< sym (value m (CS.bit N u.1.1)) > St.value m (CS.bit N u.1.1)
      =< St.holds N u.1.1 u.1.2 m (BS.lt-left m (St.sz m)) (NO.lt-leb (St.sz m) N (NO.lt-step (St.sz m) N (BS.lt-right m (St.sz m)))) > false } ;
    zero : Id Bool ((rY j).1 (ye d)) false =
     TC.rec ((v : St.Stage N) * Id (CS.Bits N) (Sp.mask N v.1) (d.1 N).1) @l (Id Bool ((rY j).1 (ye d)) false) (BR.bool-set _ _) at (d.1 N).2 ;
   } ;
   fromF (d : FLim) : Y = eY.2.sec (P.Point[rY, ye d, \ j -> ZY[d, j].zero].point) ;

   -- the two are inverse
   ye-toF (y : Y) (i : Nat) : Id Bool (ye (toF y) i) (I.yhat y i) = Sp.evens-join (I.yhat y) (\ k -> false) i ;
   from-to-F (y : Y) : Id Y (fromF (toF y)) y =
    trans (ap eY.2.sec (P.hom-ext-gen rY BR.two (P.Point[rY, ye (toF y), \ j -> ZY[toF y, j].zero].point) (eY.1 y) (\ i ->
      trans (P.Point[rY, ye (toF y), \ j -> ZY[toF y, j].zero].value (FN.gen i)) (ye-toF y i))))
     (Pr.sec-ret Y (P.Sp (P.Presented rY)) eY.1 eY.2 y) ;
   odd-zero (d : FLim) (i : Nat) : Id Bool (seqbitF d (suc (NO.dbl i))) false =
    TC.rec ((v : St.Stage (suc (suc (NO.dbl i)))) * Id (CS.Bits (suc (suc (NO.dbl i)))) (Sp.mask (suc (suc (NO.dbl i))) v.1) (d.1 (suc (suc (NO.dbl i)))).1)
     @l (Id Bool (seqbitF d (suc (NO.dbl i))) false) (BR.bool-set _ _)
     (\ u -> trans (bit-of d (suc (suc (NO.dbl i))) u.1 u.2 (suc (NO.dbl i)) (NO.lt-suc (suc (NO.dbl i))))
       (ap (\ b -> BR.and b (CS.bit (suc (suc (NO.dbl i))) u.1.1 (suc (NO.dbl i)))) (Sp.evenB-odd i)))
     (d.1 (suc (suc (NO.dbl i)))).2 ;
   yhat-fromF (d : FLim) (i : Nat) : Id Bool (I.yhat (fromF d) i) (ye d i) =
    trans (ap (\ s -> s.1 (I.GY.Q.include (FN.gen i))) (eY.2.sec-eq (P.Point[rY, ye d, \ j -> ZY[d, j].zero].point)))
     (P.Point[rY, ye d, \ j -> ZY[d, j].zero].value (FN.gen i)) ;
   spread-fromF (d : FLim) (m : Nat) : Id Bool (spread (fromF d) m) (seqbitF d m) =
    trans (FN.cong2 (\ y x' -> Sp.join y x' m)
       (F.funext Nat (\ i -> Bool) (I.yhat (fromF d)) (Sp.evens (seqbitF d)) (yhat-fromF d))
       (F.funext Nat (\ i -> Bool) (\ i -> false) (Sp.odds (seqbitF d)) (\ i -> sym (odd-zero d i))))
     (Sp.join-parts (seqbitF d) m) ;
   to-from-F (d : FLim) : Id FLim (toF (fromF d)) d =
    flim-eq (toF (fromF d)) d (\ n -> trans (ap (CS.prefix n) (F.funext Nat (\ m -> Bool) (spread (fromF d)) (seqbitF d) (spread-fromF d)))
     (F-prefix d n)) ;
   eYF : Pr.Equiv Y FLim = (toF, Pr.qinv Y FLim toF fromF to-from-F from-to-F) ;
   over (x : X) : Id FLim (toF (f x)) (limit-map St.Stage St.restrict Fstage Fq gm g-comm (eXL.1 x)) =
    flim-eq (toF (f x)) (limit-map St.Stage St.restrict Fstage Fq gm g-comm (eXL.1 x)) (\ n -> sym (mask-code x n)) ;
   result : SurjLim[X, Y, f] = mkSurjLim X Y f St.Stage St.restrict Fstage Fq St.stage-finite F-finite gm g-comm g-surj eXL eYF over ;
  } ;
  result : T1.Trunc[SurjLim[X, Y, f]].carrier =
   TC.rec ((i : Nat) -> I.Rp i) @(l+) (T1.Trunc[SurjLim[X, Y, f]].carrier) T1.Trunc[SurjLim[X, Y, f]].proposition (\ c ->
    TC.rec ((j : Nat) -> FN.Rep (rX j).1) @(l+) (T1.Trunc[SurjLim[X, Y, f]].carrier) T1.Trunc[SurjLim[X, Y, f]].proposition (\ tX ->
     TC.rec ((j : Nat) -> FN.Rep (rY j).1) @(l+) (T1.Trunc[SurjLim[X, Y, f]].carrier) T1.Trunc[SurjLim[X, Y, f]].proposition (\ tY ->
      TC.rec ((i : Nat) -> FN.Rep (c i).1.1) @(l+) (T1.Trunc[SurjLim[X, Y, f]].carrier) T1.Trunc[SurjLim[X, Y, f]].proposition (\ tc ->
       T1.Trunc[SurjLim[X, Y, f]].inc WithChoice[c, tX, tY, tc].result)
       (CountableChoice[l].cc (ax.dc @l) (\ i -> FN.Rep (c i).1.1) (\ i -> (c i).1.2)))
      (CountableChoice[l].cc (ax.dc @l) (\ j -> FN.Rep (rY j).1) (\ j -> (rY j).2)))
     (CountableChoice[l].cc (ax.dc @l) (\ j -> FN.Rep (rX j).1) (\ j -> (rX j).2)))
    (CountableChoice[l].cc (ax.dc @l) I.Rp (\ i -> I.GX.Q.representative (I.b i))) ;
 } ;
 -- Remark 3.4 (surjections)
 remark34 (X Y : U l) (sX : PF.isStone X) (sY : PF.isStone Y) (f : X -> Y) (fs : DCh.Surjective f) : T1.Trunc[SurjLim[X, Y, f]].carrier =
  SC.on-stone1 X (T1.Trunc[SurjLim[X, Y, f]].carrier) T1.Trunc[SurjLim[X, Y, f]].proposition sX (\ rX eX ->
   SC.on-stone1 Y (T1.Trunc[SurjLim[X, Y, f]].carrier) T1.Trunc[SurjLim[X, Y, f]].proposition sY (\ rY eY ->
    Presented2[X, Y, rX, rY, eX, eY, f, fs].result)) ;
} ;
