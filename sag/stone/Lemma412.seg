-- SSD Lemma 4.12: for X compact Hausdorff, 2^X is countably presented.
--
-- Let q : S ->> X with S Stone, S = Sp(B), B = 2[N]/(r).  By Axiom 1, B is
-- 2^Sp(B), and 2^X is the subalgebra of the b in B respecting q:
-- q s = q t -> b s = b t.  This is an open condition (Lemma 1.24 and
-- Corollary 4.4 on S x S).  Enumerate B by the classes of elem m
-- (Pairing) and choose open witnesses alpha m for "elem m respects q"; the
-- generators  cgen (m, k) = [elem m] if alpha m k = 1, else 0  are exactly
-- the elements of the subalgebra.  Let psi : 2[N] -> B send g j to cgen j,
-- and psi' a lift to 2[N].  A map chi : 2[N] -> 2^X is psi followed by
-- "value at any point over x" (well defined since psi lands in the
-- subalgebra: psi x at s is x evaluated at the cgen j at s, Remark110).
-- Its kernel is { elem m | psi' (elem m) <= J K (r) for some K }, an
-- enumerable set (decidable in (m, K), DecFree); taking these as relations
-- rel, chi induces an isomorphism 2[N]/(rel) = 2^X: injective by
-- construction, surjective because an a : X -> 2 gives the element of B
-- with evaluation a o q, which is some [elem m] respecting q, hence some
-- cgen j.  (The paper: 2^X is an open subalgebra of 2^S, so overtly
-- discrete (Lemmas 2.8, 2.7), so countably presented (Corollary 2.14).)
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module DF = DecFree[l] ;
module Pg = Pairing[l] ;
module PS = PowerSet[l] ;
module Om = Omniscience[l,l] ;
module OC = OpenClosed[l,l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module CH = CHaus[l] ;
module SPr = StoneProduct[l] ;
module R110 = Remark110[l,l] ;
module L28 = Lemma28[l,l] ;
module SA = StoneAxioms[l,l] ;
module Eq = Equivalences[l] ;
module Bi = Bijection[l] ;
module DCh = DependentChoice[l] ;
module CM = ConstantMap[l] ;

module Over (ax : SA.Assumptions) {
 module OCo = OC.Over[ax] ;
 module CHO = CH.Over[ax] ;
 module SPO = SPr.Over[ax] ;

 module Setting (X : U l) (sX : Pr.isSet X) (idc : (x y : X) -> OC.isClosed (Id X x y))
   (S : U l) (r : Nat -> FN.Elem) (eS : Pr.Equiv S (P.Sp (P.Presented r))) (q : S -> X) (qs : DCh.Surjective q) {
  module G = P.Generated[FN.free, r] ;
  Bw : P.Booleω = TP.presented-booleω r ;
  Sp : U l = P.Sp Bw.1 ;
  module PX = PS.Pow[X] ;
  qq (s : Sp) : X = q (eS.2.sec s) ;
  ev (b : G.Q.Carrier) (s : Sp) : Bool = s.1 b ;
  Resp (g : Sp -> Bool) : U l = (s t : Sp) -> Id X (qq s) (qq t) -> Id Bool (g s) (g t) ;
  -- every x is merely some qq s
  fib (x : X) : T.Trunc[(s : Sp) * Id X (qq s) x].carrier =
   TC.map ((s : S) * Id X (q s) x) ((s : Sp) * Id X (qq s) x)
    (\ u -> (eS.1 u.1, trans (ap q (Pr.sec-ret S Sp eS.1 eS.2 u.1)) u.2)) (qs x) ;

  -- respecting q is open
  sp-stone : PF.isStone Sp = T1.Trunc[PF.StoneW Sp].inc (Bw, Pr.idEquiv Sp) ;
  sp-set : Pr.isSet Sp = H.Properties[Bw.1.ring, BR.two-ring, BR.bool-set].set ;
  Z : U l = Sp * Sp ;
  z-stone : PF.isStone Z = SPO.product-stone Sp Sp sp-stone sp-stone ;
  module CZ = CHO.Covered[Z, Pr.isSet-Sigma Sp (\ s -> Sp) sp-set (\ s -> sp-set), SC.lemma310 Z z-stone,
    (Z, z-stone, \ u -> u, \ u -> T.Trunc[(v : Z) * Id Z v u].inc (u, refl u))] ;
  resp-open (g : Sp -> Bool) : OC.isOpen (Resp g) =
   OC.open-iff (Resp g) ((u : Z) -> Id X (qq u.1) (qq u.2) -> Id Bool (g u.1) (g u.2))
    (\ h u -> h u.1 u.2, \ h s t -> h (s, t))
    (CZ.forall-open (\ u -> Id X (qq u.1) (qq u.2) -> Id Bool (g u.1) (g u.2))
      (\ u -> F.isProp-Pi (Id X (qq u.1) (qq u.2)) (\ p -> Id Bool (g u.1) (g u.2)) (\ p -> BR.bool-set _ _))
      (\ u -> OCo.closed-open-imp (Id X (qq u.1) (qq u.2)) (Id Bool (g u.1) (g u.2)) (BR.bool-set _ _) (idc (qq u.1) (qq u.2))
        (OC.dec-open (Id Bool (g u.1) (g u.2)) (DF.bool-dec (g u.1) (g u.2))))) ;
  resp-zero : Resp (ev G.Q.zeroQ) = \ s t p -> trans (H.zero G.Q.ring BR.two-ring s) (sym (H.zero G.Q.ring BR.two-ring t)) ;
  ok (m : Nat) : U l = Resp (ev (G.Q.include (Pg.elem m))) ;

  module WithWit (wit : (m : Nat) -> OC.OpenW (ok m)) {
   al (m : Nat) : Nat -> Bool = (wit m).1 ;
   cgen-at (m k : Nat) : G.Q.Carrier = BR.ite G.Q.Carrier (al m k) (G.Q.include (Pg.elem m)) G.Q.zeroQ ;
   cgen (j : Nat) : G.Q.Carrier = cgen-at (Pg.unpair j).1 (Pg.unpair j).2 ;
   cgen-resp-at (m k : Nat) : (b : Bool) -> Id Bool (al m k) b -> Resp (ev (BR.ite G.Q.Carrier b (G.Q.include (Pg.elem m)) G.Q.zeroQ)) = split {
    true -> \ h -> (wit m).2.2 (T.Trunc[(n : Nat) * Id Bool (al m n) true].inc (k, h)) ;
    false -> \ h -> resp-zero } ;
   cgen-resp (j : Nat) : Resp (ev (cgen j)) = cgen-resp-at (Pg.unpair j).1 (Pg.unpair j).2 (al (Pg.unpair j).1 (Pg.unpair j).2) (refl (al (Pg.unpair j).1 (Pg.unpair j).2)) ;
   module UB = FN.UP[Bw.1] ;
   psi : BR.Hom FN.free Bw.1 = UB.extend cgen ;
   ev-psi (x : FN.Elem) (s : Sp) : Id Bool (ev (psi.1 x) s) (x.1 (\ j -> ev (cgen j) s)) = R110.subst-point Bw.1 s cgen x ;
   resp-psi (x : FN.Elem) : Resp (ev (psi.1 x)) = \ s t p ->
    trans (ev-psi x s) (trans (ap x.1 (F.funext Nat (\ j -> Bool) (\ j -> ev (cgen j) s) (\ j -> ev (cgen j) t) (\ j -> cgen-resp j s t p)))
     (sym (ev-psi x t))) ;
   -- the value at x of a map respecting q
   module Lift (g : Sp -> Bool) (rg : Resp g) (x : X) {
    module C = CM.Constant[(s : Sp) * Id X (qq s) x, Bool, BR.bool-set, \ u -> g u.1, \ u v -> rg u.1 v.1 (trans u.2 (sym v.2))] ;
    value : Bool = C.value (fib x) ;
    at (s : Sp) (p : Id X (qq s) x) : Id Bool value (g s) = C.value-at (fib x) (s, p) ;
   } ;
   chi (x : FN.Elem) (x' : X) : Bool = Lift[ev (psi.1 x), resp-psi x, x'].value ;
   chi-at (x : FN.Elem) (x' : X) (s : Sp) (p : Id X (qq s) x') : Id Bool (chi x x') (ev (psi.1 x) s) = Lift[ev (psi.1 x), resp-psi x, x'].at s p ;
   -- a pointwise statement about chi, proved at a point over x'
   over-x (x' : X) (P' : U l) (pP : Pr.isProp P') (h : (s : Sp) -> Id X (qq s) x' -> P') : P' =
    TC.rec ((s : Sp) * Id X (qq s) x') @l P' pP (\ u -> h u.1 u.2) (fib x') ;
   chi-one : Id PX.Carrier (chi FN.eone) PX.one = PX.pw (chi FN.eone) PX.one (\ x' ->
    over-x x' (Id Bool (chi FN.eone x') true) (BR.bool-set _ _) (\ s p ->
     trans (chi-at FN.eone x' s p) (trans (ap (\ b -> ev b s) psi.2.1) s.2.1))) ;
   chi-add (x y : FN.Elem) : Id PX.Carrier (chi (FN.eadd x y)) (PX.add (chi x) (chi y)) = PX.pw _ _ (\ x' ->
    over-x x' (Id Bool (chi (FN.eadd x y) x') (BR.xor (chi x x') (chi y x'))) (BR.bool-set _ _) (\ s p ->
     trans (chi-at (FN.eadd x y) x' s p) (trans (ap (\ b -> ev b s) (psi.2.2.1 x y))
      (trans (s.2.2.1 (psi.1 x) (psi.1 y)) (FN.cong2 BR.xor (sym (chi-at x x' s p)) (sym (chi-at y x' s p))))))) ;
   chi-mul (x y : FN.Elem) : Id PX.Carrier (chi (FN.emul x y)) (PX.mul (chi x) (chi y)) = PX.pw _ _ (\ x' ->
    over-x x' (Id Bool (chi (FN.emul x y) x') (BR.and (chi x x') (chi y x'))) (BR.bool-set _ _) (\ s p ->
     trans (chi-at (FN.emul x y) x' s p) (trans (ap (\ b -> ev b s) (psi.2.2.2 x y))
      (trans (s.2.2.2 (psi.1 x) (psi.1 y)) (FN.cong2 BR.and (sym (chi-at x x' s p)) (sym (chi-at y x' s p))))))) ;
   chi-hom : BR.Hom FN.free PX.algebra = (chi, chi-one, chi-add, chi-mul) ;

   module WithLift (crep : (j : Nat) -> (x : FN.Elem) * Id G.Q.Carrier (G.Q.include x) (cgen j)) {
    module UF = FN.UP[FN.free] ;
    psi' : BR.Hom FN.free FN.free = UF.extend (\ j -> (crep j).1) ;
    lift-eq (x : FN.Elem) : Id G.Q.Carrier (G.Q.include (psi'.1 x)) (psi.1 x) =
     trans (UB.unique (H.compose FN.ring FN.ring G.Q.ring G.Q.pi psi') x)
      (ap (\ g -> UB.ext g x) (F.funext Nat (\ j -> G.Q.Carrier) (UB.values (H.compose FN.ring FN.ring G.Q.ring G.Q.pi psi')) cgen
        (\ j -> trans (ap G.Q.include (UF.ext-gen (\ i -> (crep i).1) j)) (crep j).2))) ;
    -- the relations: the enumerated elements whose image is below some J K
    Below (m K : Nat) : U l = Id FN.Elem (FN.emul (psi'.1 (Pg.elem m)) (G.J K)) (psi'.1 (Pg.elem m)) ;
    kz (m K : Nat) : Bool = Om.decide (Below m K) (DF.dec-eq (FN.emul (psi'.1 (Pg.elem m)) (G.J K)) (psi'.1 (Pg.elem m))) ;
    rel-at (m K : Nat) : FN.Elem = BR.ite FN.Elem (kz m K) (Pg.elem m) FN.ezero ;
    rel (j : Nat) : FN.Elem = rel-at (Pg.unpair j).1 (Pg.unpair j).2 ;
    module Gr = P.Generated[FN.free, rel] ;
    -- chi kills the relations
    chi-zero-of (z : FN.Elem) (h : Id G.Q.Carrier (G.Q.include (psi'.1 z)) G.Q.zeroQ) : Id PX.Carrier (chi z) PX.zero =
     PX.pw (chi z) PX.zero (\ x' -> over-x x' (Id Bool (chi z x') false) (BR.bool-set _ _) (\ s p ->
      trans (chi-at z x' s p) (trans (ap (\ b -> ev b s) (trans (sym (lift-eq z)) h)) (H.zero G.Q.ring BR.two-ring s)))) ;
    kill-at (m K : Nat) : (b : Bool) -> Id Bool (kz m K) b -> Id PX.Carrier (chi (BR.ite FN.Elem b (Pg.elem m) FN.ezero)) PX.zero = split {
     true -> \ h -> chi-zero-of (Pg.elem m) (G.Q.kills (psi'.1 (Pg.elem m))
       (T.Trunc[G.Below (psi'.1 (Pg.elem m))].inc (K, L28.decide-true (Below m K)
         (DF.dec-eq (FN.emul (psi'.1 (Pg.elem m)) (G.J K)) (psi'.1 (Pg.elem m))) h))) ;
     false -> \ h -> H.zero FN.ring PX.ring chi-hom } ;
    chi-kills (j : Nat) : Id PX.Carrier (chi (rel j)) PX.zero =
     kill-at (Pg.unpair j).1 (Pg.unpair j).2 (kz (Pg.unpair j).1 (Pg.unpair j).2) (refl (kz (Pg.unpair j).1 (Pg.unpair j).2)) ;
    module Ext = Gr.Q.To[PX.algebra].Extend[(chi-hom, Gr.To[PX.algebra].backward chi-hom chi-kills)] ;
    Psi : BR.Hom (P.Presented rel) PX.algebra = Ext.hom ;

    -- injective
    kernel-elem (z : FN.Elem) (h : Id PX.Carrier (chi z) PX.zero) : Id Gr.Q.Carrier (Gr.Q.include z) Gr.Q.zeroQ =
     TC.rec ((m : Nat) * Id FN.Elem (Pg.elem m) z) @l (Id Gr.Q.Carrier (Gr.Q.include z) Gr.Q.zeroQ) (Gr.Q.Q.set _ _) (\ u ->
      TC.rec (G.Below (psi'.1 z)) @l (Id Gr.Q.Carrier (Gr.Q.include z) Gr.Q.zeroQ) (Gr.Q.Q.set _ _) (\ b ->
       Gr.Q.kills z (subst Gr.Ideal
         (trans (ap (\ p -> rel-at p.1 p.2) (Pg.hit u.1 b.1).2)
          (trans (ap (\ c -> BR.ite FN.Elem c (Pg.elem u.1) FN.ezero)
                   (Om.decide-yes (Below u.1 b.1) (subst (\ w -> Id FN.Elem (FN.emul (psi'.1 w) (G.J b.1)) (psi'.1 w)) (sym u.2) b.2)
                     (DF.dec-eq (FN.emul (psi'.1 (Pg.elem u.1)) (G.J b.1)) (psi'.1 (Pg.elem u.1)))))
           u.2))
         (T.Trunc[Gr.Below (rel (Pg.hit u.1 b.1).1)].inc (Gr.r-below (Pg.hit u.1 b.1).1))))
       (subst G.Ideal (FN.ring.addZ (psi'.1 z)) (G.Q.Q.effective (psi'.1 z) FN.ezero
         (trans (lift-eq z) (Equivalences[l].injective G.Q.Carrier (Sp -> Bool) (StoneAxioms[l,l].evaluation Bw.1) (ax.duality Bw)
           (psi.1 z) G.Q.zeroQ (F.funext Sp (\ s -> Bool) (ev (psi.1 z)) (ev G.Q.zeroQ) (\ s ->
             trans (sym (chi-at z (qq s) s (refl (qq s)))) (trans (Pr.happly X (\ x -> Bool) _ _ h (qq s))
              (sym (H.zero G.Q.ring BR.two-ring s)))))))))) (Pg.elem-hit z) ;
    kernel (c : Gr.Q.Carrier) (h : Id PX.Carrier (Psi.1 c) PX.zero) : Id Gr.Q.Carrier c Gr.Q.zeroQ =
     Gr.Q.Q.induction @l (\ c -> Id PX.Carrier (Psi.1 c) PX.zero -> Id Gr.Q.Carrier c Gr.Q.zeroQ)
      (\ c -> F.isProp-Pi (Id PX.Carrier (Psi.1 c) PX.zero) (\ h -> Id Gr.Q.Carrier c Gr.Q.zeroQ) (\ h -> Gr.Q.Q.set _ _))
      (\ z h -> kernel-elem z (trans (sym (Ext.D.beta z)) h)) c h ;
    injective : Bi.Injective Psi.1 = \ c d h ->
     BR.Laws[(P.Presented rel).ring, (P.Presented rel).idem].sum-zero c d (kernel (Gr.Q.addQ c d)
      (trans (Psi.2.2.1 c d) (trans (ap (\ u -> PX.add u (Psi.1 d)) h) (PX.pw (PX.add (Psi.1 d) (Psi.1 d)) PX.zero (\ x -> BR.xor-self (Psi.1 d x)))))) ;

    -- surjective
    module Onto (a : PX.Carrier) {
     b : G.Q.Carrier = (ax.duality Bw).sec (\ s -> a (qq s)) ;
     evb (s : Sp) : Id Bool (ev b s) (a (qq s)) = Pr.happly Sp (\ s -> Bool) _ _ ((ax.duality Bw).sec-eq (\ s -> a (qq s))) s ;
     resp-b : Resp (ev b) = \ s t p -> trans (evb s) (trans (ap a p) (sym (evb t))) ;
     Pre : U l = (c : Gr.Q.Carrier) * Id PX.Carrier (Psi.1 c) a ;
     from-gen (m : Nat) (pm : Id G.Q.Carrier (G.Q.include (Pg.elem m)) b) (k : Nat) (h : Id Bool (al m k) true) : Pre =
      (Gr.Q.include (FN.gen (Pg.hit m k).1),
       trans (Ext.D.beta (FN.gen (Pg.hit m k).1)) (PX.pw (chi (FN.gen (Pg.hit m k).1)) a (\ x' ->
        over-x x' (Id Bool (chi (FN.gen (Pg.hit m k).1) x') (a x')) (BR.bool-set _ _) (\ s p ->
         trans (chi-at (FN.gen (Pg.hit m k).1) x' s p)
          (trans (ap (\ c -> ev c s) (UB.ext-gen cgen (Pg.hit m k).1))
           (trans (ap (\ c -> ev c s) (trans (ap (\ q' -> cgen-at q'.1 q'.2) (Pg.hit m k).2)
                     (trans (ap (\ c -> BR.ite G.Q.Carrier c (G.Q.include (Pg.elem m)) G.Q.zeroQ) h) pm)))
            (trans (evb s) (ap a p)))))))) ;
     pre : T.Trunc[Pre].carrier =
      TC.bind ((x : FN.Elem) * Id G.Q.Carrier (G.Q.include x) b) Pre (\ u ->
       TC.bind ((m : Nat) * Id FN.Elem (Pg.elem m) u.1) Pre (\ v ->
        TC.map ((k : Nat) * Id Bool (al v.1 k) true) Pre
         (\ w -> from-gen v.1 (trans (ap G.Q.include v.2) u.2) w.1 w.2)
         ((wit v.1).2.1 (subst (\ c -> Resp (ev c)) (sym (trans (ap G.Q.include v.2) u.2)) resp-b)))
        (Pg.elem-hit u.1))
       (G.Q.representative b) ;
    } ;
    iso : P.Iso (P.Presented rel) PX.algebra =
     (Psi, Bi.Bij[Gr.Q.Carrier, PX.Carrier, PX.algebra.set, Psi.1, injective, \ a -> Onto[a].pre].equiv) ;
    presentation : P.Presentation PX.algebra = (rel, iso) ;
   } ;
  } ;
  presented : P.CountablyPresented PX.algebra =
   TC.bind ((m : Nat) -> OC.OpenW (ok m)) (P.Presentation PX.algebra) (\ wit ->
    TC.map ((j : Nat) -> (x : FN.Elem) * Id G.Q.Carrier (G.Q.include x) (WithWit[wit].cgen j)) (P.Presentation PX.algebra)
     (\ crep -> WithWit[wit].WithLift[crep].presentation)
     (CountableChoice[l].cc (ax.dc @l) (\ j -> (x : FN.Elem) * Id G.Q.Carrier (G.Q.include x) (WithWit[wit].cgen j))
       (\ j -> G.Q.representative (WithWit[wit].cgen j))))
    (CountableChoice[l].cc (ax.dc @l) (\ m -> OC.OpenW (ok m)) (\ m -> resp-open (ev (G.Q.include (Pg.elem m))))) ;
 } ;
 -- Lemma 4.12
 lemma412 (X : U l) (cX : CH.isCHaus X) : P.CountablyPresented PS.Pow[X].algebra =
  T1.Trunc[CH.Cover X].induction @l (\ t -> P.CountablyPresented PS.Pow[X].algebra) (\ t -> T.Trunc[P.Presentation PS.Pow[X].algebra].proposition)
   (\ cv -> SC.on-stone cv.1 (P.CountablyPresented PS.Pow[X].algebra) T.Trunc[P.Presentation PS.Pow[X].algebra].proposition cv.2.1 (\ r eS ->
     Setting[X, cX.1, cX.2.1, cv.1, r, eS, cv.2.2.1, cv.2.2.2].presented)) cX.2.2 ;
 pow-booleω (X : U l) (cX : CH.isCHaus X) : P.Booleω = (PS.Pow[X].algebra, lemma412 X cX) ;
} ;
