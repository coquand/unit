-- Compactness of Stone spaces: a cover by countably many decidable subsets
-- e m has a finite subcover.
--
-- On S = Sp(2[N]/(r)), each e m is the evaluation at an element with a
-- representative d m (Axiom 1, countable choice).  The algebra
-- 2[N]/(r, d) has no point (a point s has some e m s = 1), so J K = 1 in
-- 2[N] for some K (Lemma 1.12); at a point s, some relation below K is 1,
-- and it is not one of r: so e m s = 1 for some m < K.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module BS = BoolSeq[l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module SA = StoneAxioms[l,l] ;

-- a finite part of the cover reaches every point
FiniteSub (S : U l) (e : Nat -> S -> Bool) (K : Nat) : U l =
 (s : S) -> T.Trunc[(m : Nat) * NO.Lt m K * Id Bool (e m s) true].carrier ;

module Over (ax : SA.Assumptions) {
 module SD = StoneDuality[l,l].Over[ax] ;
 module Presented1 (S : U l) (r : Nat -> FN.Elem) (eq : Pr.Equiv S (P.Sp (P.Presented r))) (e : Nat -> S -> Bool)
   (cov : (s : S) -> T.Trunc[(m : Nat) * Id Bool (e m s) true].carrier) {
  module G = P.Generated[FN.free, r] ;
  Bw : P.Booleω = TP.presented-booleω r ;
  de (m : Nat) : G.Q.Carrier = (ax.duality Bw).sec (\ s -> e m (eq.2.sec s)) ;
  Rp (m : Nat) : U l = (x : FN.Elem) * Id G.Q.Carrier (G.Q.include x) (de m) ;
  bits (s : S) (k : Nat) : Bool = (eq.1 s).1 (G.Q.include (FN.gen k)) ;
  bits-zeros (s : S) : P.Zeros r (bits s) = ((P.sp-presented r).1 (eq.1 s)).2 ;
  point-of (s : S) : Id (P.Sp (P.Presented r)) (P.Point[r, bits s, bits-zeros s].point) (eq.1 s) =
   P.hom-ext-gen r BR.two (P.Point[r, bits s, bits-zeros s].point) (eq.1 s) (\ k -> P.Point[r, bits s, bits-zeros s].value (FN.gen k)) ;
  module WithReps (c : (m : Nat) -> Rp m) {
   cval (m : Nat) (beta : Nat -> Bool) (z : P.Zeros r beta) : Id Bool ((c m).1.1 beta) (e m (eq.2.sec (P.Point[r, beta, z].point))) =
    trans (sym (P.Point[r, beta, z].value (c m).1))
     (trans (ap (P.Point[r, beta, z].point).1 (c m).2)
      (Pr.happly (P.Sp Bw.1) (\ s -> Bool) _ _ ((ax.duality Bw).sec-eq (\ s -> e m (eq.2.sec s))) (P.Point[r, beta, z].point))) ;
   cx (m : Nat) (s : S) : Id Bool ((c m).1.1 (bits s)) (e m s) =
    trans (cval m (bits s) (bits-zeros s))
     (trans (ap (\ p -> e m (eq.2.sec p)) (point-of s)) (ap (e m) (Pr.sec-ret S (P.Sp (P.Presented r)) eq.1 eq.2 s))) ;
   t (i : Nat) : FN.Elem = NO.inter FN.Elem i r (\ m -> (c m).1) ;
   module Gt = P.Generated[FN.free, t] ;
   even (beta : Nat -> Bool) (z : P.Zeros t beta) : P.Zeros r beta = \ n ->
    trans (sym (ap (\ y -> y.1 beta) (NO.inter-even FN.Elem n r (\ m -> (c m).1)))) (z (NO.dbl n)) ;
   odd (beta : Nat -> Bool) (z : P.Zeros t beta) (m : Nat) : Id Bool ((c m).1.1 beta) false =
    trans (sym (ap (\ y -> y.1 beta) (NO.inter-odd FN.Elem m r (\ j -> (c j).1)))) (z (suc (NO.dbl m))) ;
   no-point-at (beta : Nat -> Bool) (z : P.Zeros t beta) : Empty =
    TC.rec ((m : Nat) * Id Bool (e m (eq.2.sec (P.Point[r, beta, even beta z].point))) true) @l Empty Pr.isProp-Empty
     (\ u -> NO.false-true (trans (sym (odd beta z u.1)) (trans (cval u.1 beta (even beta z)) u.2)))
     (cov (eq.2.sec (P.Point[r, beta, even beta z].point))) ;
   no-point (s : P.Sp (P.Presented t)) : Empty = no-point-at ((P.sp-presented t).1 s).1 ((P.sp-presented t).1 s).2 ;
   trivial : T.Trunc[(K : Nat) * Id FN.Elem (Gt.J K) FN.eone].carrier =
    Gt.trivial (sym ((SD.lemma112 (TP.presented-booleω t)).2 no-point)) ;
   hit-case (s : S) (K i : Nat) (lt : NO.Lt i K) (h : Id Bool ((t i).1 (bits s)) true) :
     Plus ((n : Nat) * Id Nat i (NO.dbl n)) ((n : Nat) * Id Nat i (suc (NO.dbl n))) ->
     T.Trunc[(m : Nat) * NO.Lt m K * Id Bool (e m s) true].carrier = split {
    inl u -> Pr.absurd (T.Trunc[(m : Nat) * NO.Lt m K * Id Bool (e m s) true].carrier) (NO.false-true (trans (sym (bits-zeros s u.1))
       (trans (sym (ap (\ y -> y.1 (bits s)) (NO.inter-even FN.Elem u.1 r (\ m -> (c m).1)))) (trans (ap (\ j -> (t j).1 (bits s)) (sym u.2)) h)))) ;
    inr u -> T.Trunc[(m : Nat) * NO.Lt m K * Id Bool (e m s) true].inc (u.1,
       NO.lt-trans u.1 i K (subst (NO.Lt u.1) (sym u.2) (Cor37[l,l].lt-dbl u.1)) lt,
       trans (sym (cx u.1 s)) (trans (sym (ap (\ y -> y.1 (bits s)) (NO.inter-odd FN.Elem u.1 r (\ m -> (c m).1))))
        (trans (ap (\ j -> (t j).1 (bits s)) (sym u.2)) h))) } ;
   hitK (K : Nat) (hK : Id FN.Elem (Gt.J K) FN.eone) (s : S) : (i : Nat) * NO.Lt i K * Id Bool ((t i).1 (bits s)) true =
    BS.bor-true-inv K (\ i -> (t i).1 (bits s)) (trans (sym (BS.J-bor t (bits s) K)) (ap (\ y -> y.1 (bits s)) hK)) ;
   from-K (K : Nat) (hK : Id FN.Elem (Gt.J K) FN.eone) : FiniteSub S e K = \ s ->
    hit-case s K (hitK K hK s).1 (hitK K hK s).2.1 (hitK K hK s).2.2 (NO.parity (hitK K hK s).1) ;
   result : T.Trunc[(K : Nat) * FiniteSub S e K].carrier =
    TC.map ((K : Nat) * Id FN.Elem (Gt.J K) FN.eone) ((K : Nat) * FiniteSub S e K) (\ kh -> (kh.1, from-K kh.1 kh.2)) trivial ;
  } ;
  result : T.Trunc[(K : Nat) * FiniteSub S e K].carrier =
   TC.bind ((m : Nat) -> Rp m) ((K : Nat) * FiniteSub S e K) (\ c -> WithReps[c].result)
    (CountableChoice[l].cc (ax.dc @l) Rp (\ m -> G.Q.representative (de m))) ;
 } ;
 -- a countable decidable cover of a Stone space has a finite subcover
 finite-subcover (S : U l) (sS : PF.isStone S) (e : Nat -> S -> Bool)
   (cov : (s : S) -> T.Trunc[(m : Nat) * Id Bool (e m s) true].carrier) : T.Trunc[(K : Nat) * FiniteSub S e K].carrier =
  SC.on-stone S (T.Trunc[(K : Nat) * FiniteSub S e K].carrier) T.Trunc[(K : Nat) * FiniteSub S e K].proposition sS
   (\ r eq -> Presented1[S, r, eq, e, cov].result) ;
} ;
