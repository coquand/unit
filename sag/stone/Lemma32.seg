-- SSD Lemma 3.2: a sequential limit of finite sets is a Stone space.
--
-- By countable choice the finite sets E n get enumerations E n = Fin (c n);
-- then lim E is the set of zeros of the relations of LimCode, i.e. the
-- spectrum of the countably presented algebra 2[N]/(rel n)
-- (Presented.sp-presented).  (The paper argues with Remark 1.10 and
-- Lemma 2.6: Stone spaces are closed under sequential limits and finite
-- sets are Stone; the coding gives the presentation directly.)
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module Fi = Finite[l] ;
module FCl = FiniteClosure[l] ;
module DCh = DependentChoice[l] ;
module LC = LimCode[l] ;
module PF = Profinite[l,k] ;
module SA = StoneAxioms[l,k] ;
module Eq = Equivalences[l] ;

-- the limit, for chosen enumerations
module Enumerated (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) (fin : (n : Nat) -> Fi.isFinite (E n))
  (w : (n : Nat) -> Fi.FinEquiv (E n)) {
 module C = LC.Code[E, p, \ n -> (w n).1, \ n -> (w n).2, \ n -> FCl.finite-set (E n) (fin n)] ;
 zeros : Pr.Equiv ((a : Nat -> Bool) * C.Zeros a) ((a : Nat -> Bool) * P.Zeros C.rel a) =
  sigma-equiv (Nat -> Bool) (Nat -> Bool) (Pr.idEquiv (Nat -> Bool)) C.Zeros (P.Zeros C.rel) C.zeros-prop
   (\ a -> F.isProp-Pi Nat (\ n -> Id Bool ((C.rel n).1 a) false) (\ n -> BR.bool-set _ _))
   (\ a z -> z) (\ a z -> z) ;
 sp : Pr.Equiv (DCh.Lim E p) (P.Sp (P.Presented C.rel)) =
  Eq.compose (DCh.Lim E p) ((a : Nat -> Bool) * C.Zeros a) (P.Sp (P.Presented C.rel)) C.equivalence
   (Eq.compose ((a : Nat -> Bool) * C.Zeros a) ((a : Nat -> Bool) * P.Zeros C.rel a) (P.Sp (P.Presented C.rel)) zeros
    (Bijection[l].inverse (P.Sp (P.Presented C.rel)) ((a : Nat -> Bool) * P.Zeros C.rel a) (P.sp-presented C.rel))) ;
 stone : PF.StoneW (DCh.Lim E p) = (TP.presented-booleω C.rel, sp) ;
} ;

module Over (ax : SA.Assumptions) {
 lemma32 (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) (fin : (n : Nat) -> Fi.isFinite (E n)) :
   PF.isStone (DCh.Lim E p) =
  TC.rec ((n : Nat) -> Fi.FinEquiv (E n)) @(l+) (PF.isStone (DCh.Lim E p)) T1.Trunc[PF.StoneW (DCh.Lim E p)].proposition
   (\ w -> T1.Trunc[PF.StoneW (DCh.Lim E p)].inc Enumerated[E, p, fin, w].stone)
   (CountableChoice[l].cc (ax.dc @l) (\ n -> Fi.FinEquiv (E n)) fin) ;
} ;
