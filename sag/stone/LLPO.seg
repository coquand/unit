-- SSD Theorem 1.17 (LLPO) and Lemma 1.18.
--
-- 1.17.  f = (f1, f2) : B∞ -> B∞ x B∞ (BinfFacts) is injective: if
-- f1 [y] = f2 [y] = 0, then y vanishes at spread1 gamma and spread2 gamma for
-- every gamma in N∞, in particular at every standard point delta (2i) =
-- spread1 (delta i), delta (2i+1) = spread2 (delta i) and at 0, so [y] = 0
-- (BinfFacts.std-ideal).  B∞ x B∞ is in Booleω (ProductPresented), so by
-- Axiom 2, Sp(B∞ x B∞) = N∞ + N∞ -> N∞ is surjective.  If the point alpha is
-- hit by a point of the left copy, alpha (2k+1) = (f1 [g (2k+1)]) = 0 for
-- all k; if by the right copy, alpha (2k) = 0.
--
-- 1.18.  A retraction r of f gives u = r (0, 1), v = r (1, 0) with u v = 0,
-- [g (2k+1)] <= u and [g (2k)] <= v for all k.  With a truth table of
-- (a representative of) u on K generators, u is 1 at delta (2K+1), hence at
-- 0 (they agree on the first K bits); likewise v; so u v is 1 at the point 0.
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FF = FreeFinite[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module Ex = Examples[l] ;
module TP = TwoPresented[l] ;
module Pd = Product[l] ;
module NO = NatOrder[l] ;
module BF = BinfFacts[l] ;
module SA = StoneAxioms[l,k] ;
module DCh = DependentChoice[l] ;

Evens (alpha : Nat -> Bool) : U l = (j : Nat) -> Id Bool (alpha (NO.dbl j)) false ;
Odds (alpha : Nat -> Bool) : U l = (j : Nat) -> Id Bool (alpha (suc (NO.dbl j))) false ;

module Over (ax : SA.Assumptions) {
 module Gi = BF.Gi ;
 module D = BF.D ;
 module LB = RL[Ex.Binf.ring] ;
 module LBB = BR.Laws[Ex.Binf.ring, Ex.Binf.idem] ;
 binf : P.Booleω = TP.presented-booleω Ex.rinf ;
 dB : P.Booleω = ProductPresented[l,k].Over[ax].product-booleω binf binf ;

 -- the kernel of f
 ideal-of (h : BR.Hom FN.free FN.free) (y : FN.Elem) (p : Id Gi.Q.Carrier (Gi.Q.include (h.1 y)) Gi.Q.zeroQ) :
   Gi.Ideal (h.1 y) =
  subst Gi.Ideal (FN.ring.addZ (h.1 y)) (Gi.Q.Q.effective (h.1 y) FN.ezero p) ;
 vanish1 (y : FN.Elem) (h : Id Gi.Q.Carrier (BF.f1.1 (Gi.Q.include y)) Gi.Q.zeroQ) (gamma : Nat -> Bool) (z : BF.InNinf gamma) :
   Id Bool (y.1 (BF.spread1 gamma)) false =
  trans (sym (BF.ft1-at y gamma)) (BF.ideal-vanishes (BF.ft1.1 y) (ideal-of BF.ft1 y (trans (sym (BF.F1.D.beta y)) h)) gamma z) ;
 vanish2 (y : FN.Elem) (h : Id Gi.Q.Carrier (BF.f2.1 (Gi.Q.include y)) Gi.Q.zeroQ) (gamma : Nat -> Bool) (z : BF.InNinf gamma) :
   Id Bool (y.1 (BF.spread2 gamma)) false =
  trans (sym (BF.ft2-at y gamma)) (BF.ideal-vanishes (BF.ft2.1 y) (ideal-of BF.ft2 y (trans (sym (BF.F2.D.beta y)) h)) gamma z) ;
 std-at (y : FN.Elem) (h1 : Id Gi.Q.Carrier (BF.f1.1 (Gi.Q.include y)) Gi.Q.zeroQ)
   (h2 : Id Gi.Q.Carrier (BF.f2.1 (Gi.Q.include y)) Gi.Q.zeroQ) (i : Nat) :
   Plus ((n : Nat) * Id Nat i (NO.dbl n)) ((n : Nat) * Id Nat i (suc (NO.dbl n))) -> Id Bool (y.1 (NO.delta i)) false = split {
  inl u -> trans (ap (\ j -> y.1 (NO.delta j)) u.2)
    (trans (ap y.1 (sym (BF.spread1-delta u.1))) (vanish1 y h1 (NO.delta u.1) (BF.delta-ninf u.1))) ;
  inr u -> trans (ap (\ j -> y.1 (NO.delta j)) u.2)
    (trans (ap y.1 (sym (BF.spread2-delta u.1))) (vanish2 y h2 (NO.delta u.1) (BF.delta-ninf u.1))) } ;
 kernel (x : Gi.Q.Carrier) (h1 : Id Gi.Q.Carrier (BF.f1.1 x) Gi.Q.zeroQ) (h2 : Id Gi.Q.Carrier (BF.f2.1 x) Gi.Q.zeroQ) :
   Id Gi.Q.Carrier x Gi.Q.zeroQ =
  TC.rec ((y : FN.Elem) * Id Gi.Q.Carrier (Gi.Q.include y) x) @l (Id Gi.Q.Carrier x Gi.Q.zeroQ) (Gi.Q.Q.set _ _) (\ u ->
   trans (sym u.2) (Gi.Q.kills u.1 (BF.std-ideal u.1
    (trans (ap u.1.1 (sym BF.spread1-zeroes)) (vanish1 u.1 (trans (ap BF.f1.1 u.2) h1) TP.zeroes Ex.infinity.2))
    (\ i -> std-at u.1 (trans (ap BF.f1.1 u.2) h1) (trans (ap BF.f2.1 u.2) h2) i (NO.parity i)))))
   (Gi.Q.representative x) ;
 f-injective (x x' : Gi.Q.Carrier) (h : Id D.Carrier (BF.f.1 x) (BF.f.1 x')) : Id Gi.Q.Carrier x x' =
  LBB.sum-zero x x' (kernel (Gi.Q.addQ x x')
   (trans (BF.f1.2.2.1 x x') (trans (ap (\ t -> Gi.Q.addQ t (BF.f1.1 x')) (ap (\ w -> w.1) h)) (LBB.char2 (BF.f1.1 x'))))
   (trans (BF.f2.2.2.1 x x') (trans (ap (\ t -> Gi.Q.addQ t (BF.f2.1 x')) (ap (\ w -> w.2) h)) (LBB.char2 (BF.f2.1 x'))))) ;

 -- Axiom 2: N∞ + N∞ -> N∞ is surjective
 surjective : DCh.Surjective (SA.dual Ex.Binf D.product BF.f) = (ax.formal binf dB BF.f).1 f-injective ;

 point (alpha : Ex.Ninf) : P.Sp Ex.Binf = P.Point[Ex.rinf, alpha.1, alpha.2].point ;
 -- the value of alpha at m, through a point h of B∞ x B∞ over it
 through (alpha : Ex.Ninf) (h : P.Sp D.product) (e : Id (P.Sp Ex.Binf) (SA.dual Ex.Binf D.product BF.f h) (point alpha))
   (m : Nat) : Id Bool (alpha.1 m) (h.1 (BF.f.1 (Gi.Q.include (FN.gen m)))) =
  trans (sym (P.Point[Ex.rinf, alpha.1, alpha.2].value (FN.gen m))) (ap (\ p -> p.1 (Gi.Q.include (FN.gen m))) (sym e)) ;
 llpo-case (alpha : Ex.Ninf) (h : P.Sp D.product) (e : Id (P.Sp Ex.Binf) (SA.dual Ex.Binf D.product BF.f h) (point alpha)) :
   (x : Plus (P.Sp Ex.Binf) (P.Sp Ex.Binf)) -> Id (P.Sp D.product) (D.into x) h -> Plus (Evens alpha.1) (Odds alpha.1) = split {
  inl a -> \ q -> inr (\ j -> trans (through alpha h e (suc (NO.dbl j)))
    (trans (ap (\ h' -> h'.1 (BF.f.1 (Gi.Q.include (FN.gen (suc (NO.dbl j)))))) (sym q))
     (trans (ap a.1 (BF.odd-f1 j)) (H.zero Ex.Binf.ring BR.two-ring a)))) ;
  inr b -> \ q -> inl (\ j -> trans (through alpha h e (NO.dbl j))
    (trans (ap (\ h' -> h'.1 (BF.f.1 (Gi.Q.include (FN.gen (NO.dbl j))))) (sym q))
     (trans (ap b.1 (BF.even-f2 j)) (H.zero Ex.Binf.ring BR.two-ring b)))) } ;
 -- Theorem 1.17
 llpo (alpha : Ex.Ninf) : T.Trunc[Plus (Evens alpha.1) (Odds alpha.1)].carrier =
  TC.map ((h : P.Sp D.product) * Id (P.Sp Ex.Binf) (SA.dual Ex.Binf D.product BF.f h) (point alpha))
   (Plus (Evens alpha.1) (Odds alpha.1))
   (\ u -> llpo-case alpha u.1 u.2 (D.fibre u.1).1 (D.fibre u.1).2) (surjective (point alpha)) ;
} ;
