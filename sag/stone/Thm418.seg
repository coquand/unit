-- SSD Lemma 4.17 and Theorem 4.18.
--
-- 4.17 (->): in a Stone space Sp(B), points are separated by the
--   decidable subsets x |-> x(b) (Presented.hom-ext-gen), so Q x = {x}.
-- 4.17 (<-): let X be compact Hausdorff with Q x = {x}.  The evaluation
--   X -> Sp(2^X) is injective (if all D agree on x and y then y is in Q x)
--   and surjective: for q : S ->> X with S Stone, 2^X -> 2^S is injective,
--   so (Axiom 2, both in Booleω by Lemma 4.12) every point of 2^X extends to
--   a point of 2^S, which is evaluation at some s (Axiom 1 for S), so the
--   point is evaluation at q s.  So X = Sp(2^X) is Stone.
-- 4.18: Sigma s. T s is compact Hausdorff (Lemma 4.11).  If (s', t') is in
--   Q (s, t), then s' = s (compose the decidable subsets of S with the first
--   projection, and S is Stone), and every g : T s -> 2 gives a map on
--   Q (s, t), constant by Lemma 4.16, so t' is in Q t inside T s, and
--   t' = t since T s is Stone.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module Pg = Pairing[l] ;
module PS = PowerSet[l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module SPr = StoneProduct[l] ;
module CH = CHaus[l] ;
module S411 = Sigma411[l] ;
module L412 = Lemma412[l] ;
module Cm = Components[l] ;
module SA = StoneAxioms[l,l] ;
module Eq = Equivalences[l] ;
module Bi = Bijection[l] ;
module DCh = DependentChoice[l] ;

-- Q x y gives D x = D y for every D
q-bool-at (X : U l) (x y : X) (q : Cm.Q X x y) (D : X -> Bool) :
  Plus (Id Bool (D x) true) (Id Bool (D x) false) -> Id Bool (D x) (D y) = split {
 inl t -> trans t (sym (q D t)) ;
 inr f -> trans f (sym (CantorStages[l].not-true (D y) (q (\ z -> BR.not (D z)) (ap BR.not f)))) } ;
q-bool (X : U l) (x y : X) (q : Cm.Q X x y) (D : X -> Bool) : Id Bool (D x) (D y) = q-bool-at X x y q D (TP.bool-cases (D x)) ;

-- an enumeration of 2^X from a presentation
module Enum (X : U l) (pr : P.Presentation PS.Pow[X].algebra) {
 module Gr = P.Generated[FN.free, pr.1] ;
 D (m : Nat) : X -> Bool = pr.2.1.1 (Gr.Q.include (Pg.elem m)) ;
 onto (a : X -> Bool) : T.Trunc[(m : Nat) * Id (X -> Bool) (D m) a].carrier =
  TC.bind ((x : FN.Elem) * Id Gr.Q.Carrier (Gr.Q.include x) (pr.2.2.sec a)) ((m : Nat) * Id (X -> Bool) (D m) a) (\ u ->
   TC.map ((m : Nat) * Id FN.Elem (Pg.elem m) u.1) ((m : Nat) * Id (X -> Bool) (D m) a)
    (\ v -> (v.1, trans (ap (\ y -> pr.2.1.1 (Gr.Q.include y)) v.2) (trans (ap pr.2.1.1 u.2) (pr.2.2.sec-eq a))))
    (Pg.elem-hit u.1))
   (Gr.Q.representative (pr.2.2.sec a)) ;
} ;

-- the evaluation at z, a point of 2^Z
Ev (Z : U l) (z : Z) : P.Sp PS.Pow[Z].algebra =
 (\ a -> a z, refl true, \ a b -> refl (BR.xor (a z) (b z)), \ a b -> refl (BR.and (a z) (b z))) ;

module Over (ax : SA.Assumptions) {
 module CHO = CH.Over[ax] ;
 module S411O = S411.Over[ax] ;
 module L412O = L412.Over[ax] ;
 module CmO = Cm.Over[ax] ;

 -- Lemma 4.17 (->)
 stone-q (X : U l) (s : PF.isStone X) (x y : X) (q : Cm.Q X x y) : Id X x y =
  SC.on-stone X (Id X x y) (CHO.stone-set X s x y) s (\ r e -> SPr.Bits[X, r, e].bits-inj x y (\ m ->
   q-bool X x y q (\ z -> SPr.Bits[X, r, e].bits z m))) ;

 -- the points of 2^S, for S Stone, are evaluations (Axiom 1)
 module PowPoints (S : U l) (r : Nat -> FN.Elem) (e : Pr.Equiv S (P.Sp (P.Presented r))) (psi : P.Sp PS.Pow[S].algebra) {
  module G = P.Generated[FN.free, r] ;
  Bw : P.Booleω = TP.presented-booleω r ;
  module PSS = PS.Pow[S] ;
  evb : BR.Hom Bw.1 PSS.algebra =
   (\ b z -> (e.1 z).1 b, PSS.pw (\ z -> (e.1 z).1 G.Q.oneQ) PSS.one (\ z -> (e.1 z).2.1),
    \ b c -> PSS.pw (\ z -> (e.1 z).1 (G.Q.addQ b c)) (PSS.add (\ z -> (e.1 z).1 b) (\ z -> (e.1 z).1 c)) (\ z -> (e.1 z).2.2.1 b c),
    \ b c -> PSS.pw (\ z -> (e.1 z).1 (G.Q.mulQ b c)) (PSS.mul (\ z -> (e.1 z).1 b) (\ z -> (e.1 z).1 c)) (\ z -> (e.1 z).2.2.2 b c)) ;
  psi' : P.Sp Bw.1 = H.compose Bw.1.ring PSS.ring BR.two-ring psi evb ;
  s0 : S = e.2.sec psi' ;
  ba (a : S -> Bool) : G.Q.Carrier = (ax.duality Bw).sec (\ p -> a (e.2.sec p)) ;
  evb-ba (a : S -> Bool) : Id PSS.Carrier (evb.1 (ba a)) a = PSS.pw (evb.1 (ba a)) a (\ z ->
   trans (Pr.happly (P.Sp Bw.1) (\ p -> Bool) _ _ ((ax.duality Bw).sec-eq (\ p -> a (e.2.sec p))) (e.1 z))
    (ap a (Pr.sec-ret S (P.Sp Bw.1) e.1 e.2 z))) ;
  is-eval : Id (P.Sp PSS.algebra) (Ev S s0) psi =
   H.Properties[PSS.ring, BR.two-ring, BR.bool-set].ext (Ev S s0) psi (\ a ->
    trans (sym (Pr.happly S (\ z -> Bool) _ _ (evb-ba a) s0))
     (trans (ap (\ p -> p.1 (ba a)) (e.2.sec-eq psi')) (ap psi.1 (evb-ba a)))) ;
 } ;
 pow-point (S : U l) (sS : PF.isStone S) (psi : P.Sp PS.Pow[S].algebra) :
   T.Trunc[(s : S) * Id (P.Sp PS.Pow[S].algebra) (Ev S s) psi].carrier =
  SC.on-stone S (T.Trunc[(s : S) * Id (P.Sp PS.Pow[S].algebra) (Ev S s) psi].carrier)
   T.Trunc[(s : S) * Id (P.Sp PS.Pow[S].algebra) (Ev S s) psi].proposition sS (\ r e ->
    T.Trunc[(s : S) * Id (P.Sp PS.Pow[S].algebra) (Ev S s) psi].inc (PowPoints[S, r, e, psi].s0, PowPoints[S, r, e, psi].is-eval)) ;

 -- Lemma 4.17 (<-)
 module Singletons (X : U l) (cX : CH.isCHaus X) (sing : (x y : X) -> Cm.Q X x y -> Id X x y) {
  module PX = PS.Pow[X] ;
  BX : P.Booleω = L412O.pow-booleω X cX ;
  sp-set : Pr.isSet (P.Sp PX.algebra) = H.Properties[PX.ring, BR.two-ring, BR.bool-set].set ;
  ev-inj : Bi.Injective (Ev X) = \ x y e -> sing x y (\ D h -> trans (sym (ap (\ p -> p.1 D) e)) h) ;
  module FromCover (cv : CH.Cover X) {
   module PSS = PS.Pow[cv.1] ;
   BS : P.Booleω = L412O.pow-booleω cv.1 (CHO.stone-chaus cv.1 cv.2.1) ;
   g : BR.Hom PX.algebra PSS.algebra =
    (\ a s -> a (cv.2.2.1 s), refl PSS.one,
     \ a b -> refl (\ s -> BR.xor (a (cv.2.2.1 s)) (b (cv.2.2.1 s))), \ a b -> refl (\ s -> BR.and (a (cv.2.2.1 s)) (b (cv.2.2.1 s)))) ;
   g-inj : SA.Injective PX.Carrier PSS.Carrier g.1 = \ a a' e -> PX.pw a a' (\ x ->
    TC.rec ((s : cv.1) * Id X (cv.2.2.1 s) x) @l (Id Bool (a x) (a' x)) (BR.bool-set _ _)
     (\ u -> trans (ap a (sym u.2)) (trans (Pr.happly cv.1 (\ s -> Bool) _ _ e u.1) (ap a' u.2))) (cv.2.2.2 x)) ;
   surj (phi : P.Sp PX.algebra) : T.Trunc[(x : X) * Id (P.Sp PX.algebra) (Ev X x) phi].carrier =
    TC.bind ((p : P.Sp PSS.algebra) * Id (P.Sp PX.algebra) (SA.dual PX.algebra PSS.algebra g p) phi)
     ((x : X) * Id (P.Sp PX.algebra) (Ev X x) phi) (\ u ->
      TC.map ((s : cv.1) * Id (P.Sp PSS.algebra) (Ev cv.1 s) u.1) ((x : X) * Id (P.Sp PX.algebra) (Ev X x) phi)
       (\ v -> (cv.2.2.1 v.1, H.Properties[PX.ring, BR.two-ring, BR.bool-set].ext (Ev X (cv.2.2.1 v.1)) phi (\ a ->
         trans (ap (\ p -> p.1 (g.1 a)) v.2) (ap (\ p -> p.1 a) u.2))))
       (pow-point cv.1 cv.2.1 u.1))
     ((ax.formal BX BS g).1 g-inj phi) ;
  } ;
  surj (phi : P.Sp PX.algebra) : T.Trunc[(x : X) * Id (P.Sp PX.algebra) (Ev X x) phi].carrier =
   T1.Trunc[CH.Cover X].induction @l (\ t -> T.Trunc[(x : X) * Id (P.Sp PX.algebra) (Ev X x) phi].carrier)
    (\ t -> T.Trunc[(x : X) * Id (P.Sp PX.algebra) (Ev X x) phi].proposition) (\ cv -> FromCover[cv].surj phi) cX.2.2 ;
  equiv : Pr.Equiv X (P.Sp PX.algebra) = (Ev X, Bi.Bij[X, P.Sp PX.algebra, sp-set, Ev X, ev-inj, surj].equiv) ;
  stone : PF.isStone X = T1.Trunc[PF.StoneW X].inc (BX, equiv) ;
 } ;
 lemma417 (X : U l) (cX : CH.isCHaus X) (sing : (x y : X) -> Cm.Q X x y -> Id X x y) : PF.isStone X = Singletons[X, cX, sing].stone ;

 -- Theorem 4.18
 module Sigma (S : U l) (sS : PF.isStone S) (Tf : S -> U l) (sT : (s : S) -> PF.isStone (Tf s)) {
  Sg : U l = (s : S) * Tf s ;
  cSg : CH.isCHaus Sg = S411O.sigma-chaus S (CHO.stone-chaus S sS) Tf (\ s -> CHO.stone-chaus (Tf s) (sT s)) ;
  fst-eq (u v : Sg) (q : Cm.Q Sg u v) : Id S u.1 v.1 = stone-q S sS u.1 v.1 (\ D h -> q (\ w -> D w.1) h) ;
  module WithEnum (cv : CH.Cover Sg) (pr : P.Presentation PS.Pow[Sg].algebra) {
   module En = Enum[Sg, pr] ;
   module C = CmO.Enumerated[Sg, cSg.1, cSg.2.1, cv, En.D, En.onto] ;
   back (u : Sg) (w : C.Qx u) : Tf u.1 = subst Tf (sym (fst-eq u w.1 w.2)) w.1.2 ;
   at-u (u : Sg) : Id (Tf u.1) (back u (u, Cm.q-refl Sg u)) u.2 =
    ap (\ p -> subst Tf p u.2) (CHO.stone-set S sS u.1 u.1 (sym (fst-eq u u (Cm.q-refl Sg u))) (refl u.1)) ;
   snd-q (u : Sg) (w : C.Qx u) : Cm.Q (Tf u.1) u.2 (back u w) = \ D h ->
    trans (C.lemma416 u (\ w' -> D (back u w')) w) (trans (ap D (at-u u)) h) ;
   sing (u v : Sg) (q : Cm.Q Sg u v) : Id Sg u v =
    Pr.Sigma-path S Tf u.1 v.1 u.2 v.2 (fst-eq u v q)
     (trans (ap (subst Tf (fst-eq u v q)) (stone-q (Tf u.1) (sT u.1) u.2 (back u (v, q)) (snd-q u (v, q))))
      (S411.subst-sym S Tf u.1 v.1 (fst-eq u v q) v.2)) ;
  } ;
  sing (u v : Sg) (q : Cm.Q Sg u v) : Id Sg u v =
   T1.Trunc[CH.Cover Sg].induction @l (\ t -> Id Sg u v) (\ t -> cSg.1 u v) (\ cv ->
    TC.rec (P.Presentation PS.Pow[Sg].algebra) @l (Id Sg u v) (cSg.1 u v) (\ pr -> WithEnum[cv, pr].sing u v q)
     (L412O.lemma412 Sg cSg)) cSg.2.2 ;
  stone : PF.isStone Sg = lemma417 Sg cSg sing ;
 } ;
 thm418 (S : U l) (sS : PF.isStone S) (Tf : S -> U l) (sT : (s : S) -> PF.isStone (Tf s)) : PF.isStone ((s : S) * Tf s) =
  Sigma[S, sS, Tf, sT].stone ;
} ;
