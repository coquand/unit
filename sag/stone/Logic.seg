-- Small logical facts used throughout: decidability, logical equivalence,
-- Sigma types of propositions over an equivalence.
level l ;
open Base ; open Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

Not (A : U l) : U l = A -> Empty ;
data Dec (A : U l) : U l = yes (a : A) | no (n : Not A) ;
Iff (A B : U l) : U l = (A -> B) * (B -> A) ;

not-prop (A : U l) : isProp (Not A) = F.isProp-Pi A (\ a -> Empty) (\ a -> isProp-Empty) ;
-- deciding a proposition is a proposition
dec-prop (A : U l) (pA : isProp A) : isProp (Dec A) = split {
 yes a -> split { yes b -> ap A (Dec A) (\ x -> yes x) a b (pA a b) ;
                  no n -> absurd (Id (Dec A) (yes a) (no n)) (n a) } ;
 no n -> split { yes b -> absurd (Id (Dec A) (no n) (yes b)) (n b) ;
                 no m -> ap (Not A) (Dec A) (\ x -> no x) n m (not-prop A n m) } } ;

-- a Sigma type of propositions over an equivalence
sigma-equiv (A B : U l) (e : Equiv A B) (P : A -> U l) (Q : B -> U l)
 (pP : (a : A) -> isProp (P a)) (pQ : (b : B) -> isProp (Q b))
 (f : (a : A) -> P a -> Q (e.1 a)) (g : (a : A) -> Q (e.1 a) -> P a)
 : Equiv ((a : A) * P a) ((b : B) * Q b) =
 (\ u -> (e.1 u.1, f u.1 u.2),
  qinv ((a : A) * P a) ((b : B) * Q b) (\ u -> (e.1 u.1, f u.1 u.2))
   (\ v -> (e.2.sec v.1, g (e.2.sec v.1) (subst B Q v.1 (e.1 (e.2.sec v.1)) (sym B _ _ (e.2.sec-eq v.1)) v.2)))
   (\ v -> Sigma-eq B Q _ v.1 _ v.2 (e.2.sec-eq v.1) (pQ v.1))
   (\ u -> Sigma-eq A P _ u.1 _ u.2 (sec-ret A B e.1 e.2 u.1) (pP u.1))) ;

