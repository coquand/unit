-- Equality with 1 is decidable in 2[N]: an element with a truth table u on
-- k generators is 1 iff u is the table of 1 (FreeCountable.ev-inj), and
-- truth tables have decidable equality.  Being 1 is a proposition, so the
-- truth table may be chosen inside the truncation.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FF = FreeFinite[l] ;
module FN = FreeCountable[l] ;
module NO = NatOrder[l] ;

bool-dec : (a b : Bool) -> Dec (Id Bool a b) = split {
 true -> split { true -> yes (refl true) ; false -> no BR.true-false } ;
 false -> split { true -> no NO.false-true ; false -> yes (refl false) } } ;
dec-pair2 (A : U l) (u v : A * A) (p : Id A u.1 v.1) : Dec (Id A u.2 v.2) -> Dec (Id (A * A) u v) = split {
 yes q -> yes (FF.pair-path p q) ;
 no n -> no (\ e -> n (ap (\ w -> w.2) e)) } ;
dec-pair (A : U l) (u v : A * A) (d2 : Dec (Id A u.2 v.2)) : Dec (Id A u.1 v.1) -> Dec (Id (A * A) u v) = split {
 yes p -> dec-pair2 A u v p d2 ;
 no n -> no (\ e -> n (ap (\ w -> w.1) e)) } ;
tab-dec : (k : Nat) (u v : FF.Tab k) -> Dec (Id (FF.Tab k) u v) = split {
 zero -> bool-dec ;
 suc k | r -> \ u v -> dec-pair (FF.Tab k) u v (r u.2 v.2) (r u.1 v.1) } ;

One : FN.Fun = \ a -> true ;
-- with a truth table
ev-one (k : Nat) (a : Nat -> Bool) : Id Bool (FN.ev k (FF.tone k) a) true = FN.E.I.ext-one k (FN.res Bool k a) ;
dec-at (x : FN.Elem) (rp : FN.Rep x.1) : Dec (Id (FF.Tab rp.1) rp.2.1 (FF.tone rp.1)) -> Dec (Id FN.Fun x.1 One) = split {
 yes q -> yes (trans (sym rp.2.2) (F.funext (Nat -> Bool) (\ a -> Bool) (FN.ev rp.1 rp.2.1) One (\ a ->
   trans (ap (\ u -> FN.ev rp.1 u a) q) (ev-one rp.1 a)))) ;
 no n -> no (\ e -> n (FN.ev-inj rp.1 rp.2.1 (FF.tone rp.1) (\ a ->
   trans (Pr.happly (Nat -> Bool) (\ b -> Bool) _ _ (trans rp.2.2 e) a) (sym (ev-one rp.1 a))))) } ;
fun-set : Pr.isSet FN.Fun = F.isSet-Pi (Nat -> Bool) (\ a -> Bool) (\ a -> BR.bool-set) ;
dec-one (x : FN.Elem) : Dec (Id FN.Fun x.1 One) =
 TC.rec (FN.Rep x.1) @l (Dec (Id FN.Fun x.1 One)) (dec-prop (Id FN.Fun x.1 One) (fun-set x.1 One))
  (\ rp -> dec-at x rp (tab-dec rp.1 rp.2.1 (FF.tone rp.1))) x.2 ;
-- as an element
dec-eone-aux (x : FN.Elem) : Dec (Id FN.Fun x.1 One) -> Dec (Id FN.Elem x FN.eone) = split {
 yes e -> yes (FN.elem-eq x FN.eone (\ a -> Pr.happly (Nat -> Bool) (\ b -> Bool) x.1 One e a)) ;
 no n -> no (\ e -> n (ap (\ y -> y.1) e)) } ;
dec-eone (x : FN.Elem) : Dec (Id FN.Elem x FN.eone) = dec-eone-aux x (dec-one x) ;

-- equality in 2[N] is decidable: x = y iff 1 + (x + y) = 1
xnor-true : (a b : Bool) -> Id Bool (BR.xor true (BR.xor a b)) true -> Id Bool a b = split {
 true -> split { true -> \ h -> refl true ; false -> \ h -> Pr.absurd (Id Bool true false) (NO.false-true h) } ;
 false -> split { true -> \ h -> Pr.absurd (Id Bool false true) (NO.false-true h) ; false -> \ h -> refl false } } ;
xnor-self : (a : Bool) -> Id Bool (BR.xor true (BR.xor a a)) true = split { true -> refl true ; false -> refl true } ;
same (x y : FN.Elem) : FN.Elem = FN.eadd FN.eone (FN.eadd x y) ;
dec-same (x y : FN.Elem) : Dec (Id FN.Fun (same x y).1 One) -> Dec (Id FN.Elem x y) = split {
 yes e -> yes (FN.elem-eq x y (\ a -> xnor-true (x.1 a) (y.1 a) (Pr.happly (Nat -> Bool) (\ b -> Bool) _ One e a))) ;
 no n -> no (\ p -> n (F.funext (Nat -> Bool) (\ b -> Bool) (same x y).1 One (\ a ->
   trans (ap (\ z -> BR.xor true (BR.xor (x.1 a) (z.1 a))) (sym p)) (xnor-self (x.1 a))))) } ;
dec-eq (x y : FN.Elem) : Dec (Id FN.Elem x y) = dec-same x y (dec-one (same x y)) ;
