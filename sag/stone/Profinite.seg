-- Stone spaces (SSD Def. 1.7) and SSD Lemma 3.1: every Stone space is a
-- sequential limit of finite sets.
--
-- S = Sp(B) with B = 2[N]/(r); Sp(B) = { alpha | r n (alpha) = 0 for all n }.
-- By countable choice (from Axiom 4) every r n gets a truth table, and then
-- this set is the limit of the finite stages of CantorStages.
level l k ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module Fi = Finite[l] ;
module DCh = DependentChoice[l] ;
module CS = CantorStages[l] ;
module SA = StoneAxioms[l,k] ;
module Eq = Equivalences[l] ;

-- Stone spaces: merely the spectrum of some B : Booleω
StoneW (X : U l) : U l+ = (B : P.Booleω) * Pr.Equiv X (P.Sp B.1) ;
isStone (X : U l) : U l+ = T1.Trunc[StoneW X].carrier ;
Stone : U l+ = (X : U l) * isStone X ;
-- sequential limits of finite sets
record LimPres (X : U l) {
 E : Nat -> U l ;
 p : (n : Nat) -> E (suc n) -> E n ;
 finite : (n : Nat) -> Fi.isFinite (E n) ;
 equiv : Pr.Equiv X (DCh.Lim E p) ;
} ;
isProfinite (X : U l) : U l+ = T1.Trunc[LimPres[X]].carrier ;

-- Sp along an isomorphism
sp-iso (A C : BR.BA) (i : P.Iso A C) : Pr.Equiv (P.Sp C) (P.Sp A) =
 (\ s -> H.compose A.ring C.ring BR.two-ring s i.1,
  Pr.qinv (P.Sp C) (P.Sp A) (\ s -> H.compose A.ring C.ring BR.two-ring s i.1)
   (\ s -> H.compose C.ring A.ring BR.two-ring s (P.iso-inv A C i))
   (\ s -> H.Properties[A.ring, BR.two-ring, BR.bool-set].ext _ s (\ a -> ap s.1 (Pr.sec-ret A.ring.R C.ring.R i.1.1 i.2 a)))
   (\ s -> H.Properties[C.ring, BR.two-ring, BR.bool-set].ext _ s (\ c -> ap s.1 (i.2.sec-eq c)))) ;

-- the zeros of r, for truth tables of the r n
module Tables (r : Nat -> FN.Elem) (rho : (n : Nat) -> FN.Rep (r n).1) {
 t : CS.TPres = \ n -> ((rho n).1, (rho n).2.1) ;
 module St = CS.Stages[t] ;
 same (a : Nat -> Bool) (n : Nat) : Id Bool (St.value n a) ((r n).1 a) =
  Pr.happly (Nat -> Bool) (\ b -> Bool) _ (r n).1 (rho n).2.2 a ;
 zeros : Pr.Equiv ((a : Nat -> Bool) * P.Zeros r a) ((a : Nat -> Bool) * St.Zeros a) =
  sigma-equiv (Nat -> Bool) (Nat -> Bool) (Pr.idEquiv (Nat -> Bool)) (P.Zeros r) St.Zeros
   (\ a -> F.isProp-Pi Nat (\ n -> Id Bool ((r n).1 a) false) (\ n -> BR.bool-set _ _)) St.zeros-prop
   (\ a z n -> trans (same a n) (z n)) (\ a z n -> trans (sym (same a n)) (z n)) ;
 pres (X : U l) (B : BR.BA) (e : Pr.Equiv X (P.Sp B)) (i : P.Iso (P.Presented r) B) : LimPres[X] =
  mkLimPres X St.Stage St.restrict St.stage-finite
   (Eq.compose X (P.Sp B) St.Lim e
    (Eq.compose (P.Sp B) (P.Sp (P.Presented r)) St.Lim (sp-iso (P.Presented r) B i)
     (Eq.compose (P.Sp (P.Presented r)) ((a : Nat -> Bool) * P.Zeros r a) St.Lim (P.sp-presented r)
      (Eq.compose ((a : Nat -> Bool) * P.Zeros r a) ((a : Nat -> Bool) * St.Zeros a) St.Lim zeros St.equivalence)))) ;
} ;

module Over (ax : SA.Assumptions) {
 cc : CountableChoice[l].CC = CountableChoice[l].cc (ax.dc @l) ;
 -- Lemma 3.1
 lemma31 (X : U l) (s : isStone X) : isProfinite X =
  T1.Trunc[StoneW X].induction @(l+) (\ q -> isProfinite X) (\ q -> T1.Trunc[LimPres[X]].proposition) (\ w ->
   TC.rec (P.Presentation w.1.1) @(l+) (isProfinite X) T1.Trunc[LimPres[X]].proposition (\ pr ->
    TC.rec ((n : Nat) -> FN.Rep (pr.1 n).1) @(l+) (isProfinite X) T1.Trunc[LimPres[X]].proposition
     (\ rho -> T1.Trunc[LimPres[X]].inc (Tables[pr.1, rho].pres X w.1.1 w.2 pr.2))
     (cc (\ n -> FN.Rep (pr.1 n).1) (\ n -> (pr.1 n).2)))
    w.1.2) s ;
} ;
