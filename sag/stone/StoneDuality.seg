-- SSD §1.3: Lemma 1.12 and Corollary 1.13.
--
-- Lemma 1.12.  For B : Booleω, 0 = 1 in B iff Sp(B) is empty.  If 0 = 1, a
-- point would send 1 to 1 and to 0.  If Sp(B) is empty, the evaluations of
-- 0 and 1 are equal functions on the empty type, and evaluation is
-- injective by Axiom 1.  (This replaces the paper's use of the trivial
-- algebra and of Sp being an embedding.)
--
-- Corollary 1.13.  For B : Booleω, not not Sp(B) gives ||Sp(B)||: by 1.12,
-- 0 /= 1 in B, so the unit 2 -> B is injective, so by Axiom 2 the map
-- Sp(B) -> Sp(2) is surjective, and Sp(2) has a point.
level l k ;
open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module P = Presented[l] ;
module Ex = Examples[l] ;
module TP = TwoPresented[l] ;
module Lg = Logic[l] ;
module SA = StoneAxioms[l,k] ;

module Over (ax : SA.Assumptions) {
 lemma112 (B : P.Booleω) : Lg.Iff (Id B.1.ring.R B.1.ring.z B.1.ring.o) (Lg.Not (P.Sp B.1)) =
  (\ p x -> BR.true-false (trans (sym x.2.1) (trans (ap x.1 (sym p)) (H.zero B.1.ring BR.two-ring x))),
   \ n -> Equivalences[l].injective B.1.ring.R (P.Sp B.1 -> Bool) (SA.evaluation B.1) (ax.duality B)
     B.1.ring.z B.1.ring.o
     (F.funext (P.Sp B.1) (\ x -> Bool) (SA.evaluation B.1 B.1.ring.z) (SA.evaluation B.1 B.1.ring.o)
       (\ x -> Pr.absurd (Id Bool (x.1 B.1.ring.z) (x.1 B.1.ring.o)) (n x)))) ;

 -- the unit 2 -> B is injective when 0 /= 1
 unit-injective (B : BR.BA) (nz : Lg.Not (Id B.ring.R B.ring.z B.ring.o)) :
   SA.Injective Bool B.ring.R Ex.Initial[B].unit.1 = split {
  true -> split { true -> \ h -> refl true ; false -> \ h -> Pr.absurd (Id Bool true false) (nz (sym h)) } ;
  false -> split { true -> \ h -> Pr.absurd (Id Bool false true) (nz h) ; false -> \ h -> refl false } } ;

 cor113 (B : P.Booleω) (nn : Lg.Not (Lg.Not (P.Sp B.1))) : T.Trunc[P.Sp B.1].carrier =
  TC.map ((x : P.Sp B.1) * Id (P.Sp BR.two) (SA.dual BR.two B.1 Ex.Initial[B.1].unit x) Ex.sp-two-center)
   (P.Sp B.1) (\ w -> w.1)
   ((ax.formal TP.two-booleω B Ex.Initial[B.1].unit).1
     (unit-injective B.1 (\ p -> nn ((lemma112 B).1 p))) Ex.sp-two-center) ;
} ;
