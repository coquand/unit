-- The image of a map of Stone spaces is a countable intersection of
-- decidable subsets (SSD Theorem 3.11, (iv) -> (ii)), and closed subsets
-- of Stone spaces cut out by countably many decidable conditions are Stone
-- (Theorem 3.11 (ii) -> (iii), Corollary 3.12 for them).
--
-- Image.  Let X = Sp(2[N]/(rX)), Y = Sp(2[N]/(rY)), f : X -> Y.  The i-th
-- coordinate of f is a map X -> 2, so (Axiom 1) the evaluation at some
-- c i in 2[N]/(rX); choose representatives (countable choice).  For y in Y
-- with coordinates y i, let t y = rX together with the c i + y i.  A point of
-- 2[N]/(t y) is a point x of X with f x = y.  So y is in the image iff
-- 2[N]/(t y) has a point, iff (Lemma 1.12, Corollary 1.13) 0 /= 1 there,
-- iff J K /= 1 in 2[N] for every K: and "J K = 1" is decidable (DecFree).
-- (The paper uses that the kernel of 2^Y -> 2^X is enumerable, Remark 2.15.)
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module H = RingHom[l] ;
module T = Truncation[l] ;
module T1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module BR = BooleanRing[l] ;
module FN = FreeCountable[l] ;
module P = Presented[l] ;
module TP = TwoPresented[l] ;
module NO = NatOrder[l] ;
module DF = DecFree[l] ;
module Om = Omniscience[l,l] ;
module PF = Profinite[l,l] ;
module SC = StoneClosed[l,l] ;
module L28 = Lemma28[l,l] ;
module SA = StoneAxioms[l,l] ;
module Eq = Equivalences[l] ;

decide-false (A : U l) : (d : Dec A) -> Id Bool (Om.decide A d) false -> Not A = split {
 yes a -> \ h -> Pr.absurd (Not A) (BR.true-false h) ;
 no n -> \ h -> n } ;

-- the image of f, as a property of y
Image (X Y : U l) (f : X -> Y) (y : Y) : U l = T.Trunc[(x : X) * Id Y (f x) y].carrier ;

module Over (ax : SA.Assumptions) {
 module SD = StoneDuality[l,l].Over[ax] ;

 module Presented2 (X Y : U l) (rX rY : Nat -> FN.Elem)
   (eX : Pr.Equiv X (P.Sp (P.Presented rX))) (eY : Pr.Equiv Y (P.Sp (P.Presented rY))) (f : X -> Y) {
  module GX = P.Generated[FN.free, rX] ;
  module GY = P.Generated[FN.free, rY] ;
  BX : P.Booleω = TP.presented-booleω rX ;
  yhat (y : Y) (i : Nat) : Bool = (eY.1 y).1 (GY.Q.include (FN.gen i)) ;
  coord (i : Nat) (s : P.Sp (P.Presented rX)) : Bool = yhat (f (eX.2.sec s)) i ;
  b (i : Nat) : GX.Q.Carrier = (ax.duality BX).sec (coord i) ;
  Rp (i : Nat) : U l = (x : FN.Elem) * Id GX.Q.Carrier (GX.Q.include x) (b i) ;
  -- the bits of a point of X
  bits (x : X) (m : Nat) : Bool = (eX.1 x).1 (GX.Q.include (FN.gen m)) ;
  bits-zeros (x : X) : P.Zeros rX (bits x) = ((P.sp-presented rX).1 (eX.1 x)).2 ;
  point-of (x : X) : Id (P.Sp (P.Presented rX)) (P.Point[rX, bits x, bits-zeros x].point) (eX.1 x) =
   P.hom-ext-gen rX BR.two (P.Point[rX, bits x, bits-zeros x].point) (eX.1 x) (\ m -> P.Point[rX, bits x, bits-zeros x].value (FN.gen m)) ;

  module WithReps (c : (i : Nat) -> Rp i) {
   cval (i : Nat) (beta : Nat -> Bool) (z : P.Zeros rX beta) :
     Id Bool ((c i).1.1 beta) (coord i (P.Point[rX, beta, z].point)) =
    trans (sym (P.Point[rX, beta, z].value (c i).1))
     (trans (ap (P.Point[rX, beta, z].point).1 (c i).2)
      (Pr.happly (P.Sp BX.1) (\ s -> Bool) _ _ ((ax.duality BX).sec-eq (coord i)) (P.Point[rX, beta, z].point))) ;
   -- the relations of the fibre over y
   t (y : Y) (n : Nat) : FN.Elem = NO.inter FN.Elem n rX (\ i -> FN.eadd (c i).1 (TP.const (yhat y i))) ;
   alpha (y : Y) (K : Nat) : Bool =
    Om.decide (Id FN.Elem (P.Generated[FN.free, t y].J K) FN.eone) (DF.dec-eone (P.Generated[FN.free, t y].J K)) ;
   -- a zero of t y is a zero of rX
   even (y : Y) (beta : Nat -> Bool) (z : P.Zeros (t y) beta) : P.Zeros rX beta = \ n ->
    trans (sym (ap (\ e -> e.1 beta) (NO.inter-even FN.Elem n rX (\ i -> FN.eadd (c i).1 (TP.const (yhat y i)))))) (z (NO.dbl n)) ;
   odd (y : Y) (beta : Nat -> Bool) (z : P.Zeros (t y) beta) (i : Nat) :
     Id Bool (BR.xor ((c i).1.1 beta) ((TP.const (yhat y i)).1 beta)) false =
    trans (sym (ap (\ e -> e.1 beta) (NO.inter-odd FN.Elem i rX (\ j -> FN.eadd (c j).1 (TP.const (yhat y j)))))) (z (suc (NO.dbl i))) ;

   -- a point over y gives a zero of t y
   fibre-zeros-at (x : X) (y : Y) (q : Id Y (f x) y) (m : Nat) :
     Plus ((n : Nat) * Id Nat m (NO.dbl n)) ((n : Nat) * Id Nat m (suc (NO.dbl n))) -> Id Bool ((t y m).1 (bits x)) false = split {
    inl u -> trans (ap (\ j -> (t y j).1 (bits x)) u.2)
      (trans (ap (\ e -> e.1 (bits x)) (NO.inter-even FN.Elem u.1 rX (\ i -> FN.eadd (c i).1 (TP.const (yhat y i))))) (bits-zeros x u.1)) ;
    inr u -> trans (ap (\ j -> (t y j).1 (bits x)) u.2)
      (trans (ap (\ e -> e.1 (bits x)) (NO.inter-odd FN.Elem u.1 rX (\ i -> FN.eadd (c i).1 (TP.const (yhat y i)))))
       (trans (FN.cong2 BR.xor
          (trans (cval u.1 (bits x) (bits-zeros x))
           (trans (ap (\ s -> yhat (f (eX.2.sec s)) u.1) (point-of x))
            (ap (\ x' -> yhat (f x') u.1) (Pr.sec-ret X (P.Sp (P.Presented rX)) eX.1 eX.2 x))))
          (TP.const-value (yhat y u.1) (bits x)))
        (trans (ap (\ y' -> BR.xor (yhat y' u.1) (yhat y u.1)) q) (BR.xor-self (yhat y u.1))))) } ;
   fibre-point (x : X) (y : Y) (q : Id Y (f x) y) : P.Sp (P.Presented (t y)) =
    P.Point[t y, bits x, \ m -> fibre-zeros-at x y q m (NO.parity m)].point ;

   -- a zero of t y gives a point over y
   over (y : Y) (beta : Nat -> Bool) (z : P.Zeros (t y) beta) :
     Id Y (f (eX.2.sec (P.Point[rX, beta, even y beta z].point))) y =
    Eq.injective Y (P.Sp (P.Presented rY)) eY.1 eY.2 (f (eX.2.sec (P.Point[rX, beta, even y beta z].point))) y
     (P.hom-ext-gen rY BR.two (eY.1 (f (eX.2.sec (P.Point[rX, beta, even y beta z].point)))) (eY.1 y) (\ i ->
       trans (sym (cval i beta (even y beta z)))
        (SC.xor-eq ((c i).1.1 beta) (yhat y i)
         (trans (ap (BR.xor ((c i).1.1 beta)) (sym (TP.const-value (yhat y i) beta))) (odd y beta z i))))) ;

   -- y is in the image iff no J K is 1
   to (y : Y) (im : Image X Y f y) : Om.AllZero (alpha y) = \ K ->
    TC.rec ((x : X) * Id Y (f x) y) @l (Id Bool (alpha y K) false) (BR.bool-set _ _) (\ u ->
     Om.decide-no (Id FN.Elem (P.Generated[FN.free, t y].J K) FN.eone)
      (\ e -> (SD.lemma112 (TP.presented-booleω (t y))).1 (sym (P.Generated[FN.free, t y].trivial-back K e)) (fibre-point u.1 y u.2))
      (DF.dec-eone (P.Generated[FN.free, t y].J K))) im ;
   from (y : Y) (z : Om.AllZero (alpha y)) : Image X Y f y =
    TC.map (P.Sp (P.Presented (t y))) ((x : X) * Id Y (f x) y)
     (\ s -> (eX.2.sec (P.Point[rX, ((P.sp-presented (t y)).1 s).1, even y ((P.sp-presented (t y)).1 s).1 ((P.sp-presented (t y)).1 s).2].point),
              over y ((P.sp-presented (t y)).1 s).1 ((P.sp-presented (t y)).1 s).2))
     (SD.cor113 (TP.presented-booleω (t y)) (\ ns ->
      TC.rec ((K : Nat) * Id FN.Elem (P.Generated[FN.free, t y].J K) FN.eone) @l Empty Pr.isProp-Empty
       (\ u -> decide-false (Id FN.Elem (P.Generated[FN.free, t y].J u.1) FN.eone) (DF.dec-eone (P.Generated[FN.free, t y].J u.1)) (z u.1) u.2)
       (P.Generated[FN.free, t y].trivial (sym ((SD.lemma112 (TP.presented-booleω (t y))).2 ns))))) ;
  } ;
  -- Theorem 3.11, (iv) -> (i), for presented spectra
  image-closed : T.Trunc[(a : Y -> Nat -> Bool) * ((y : Y) -> Iff (Image X Y f y) (Om.AllZero (a y)))].carrier =
   TC.map ((i : Nat) -> Rp i) ((a : Y -> Nat -> Bool) * ((y : Y) -> Iff (Image X Y f y) (Om.AllZero (a y))))
    (\ c -> (WithReps[c].alpha, \ y -> (WithReps[c].to y, WithReps[c].from y)))
    (CountableChoice[l].cc (ax.dc @l) Rp (\ i -> GX.Q.representative (b i))) ;
 } ;
} ;
