-- Boolean computations over Fin k (FinChoice: Fin (k+1) = Opt (Fin k),
-- index none = 0, index (some i) = i + 1): bounded any / all with their
-- meaning, the search for a witness, equality of indices.
level l ;
open Base ; open Logic[l] ; open Ring[l] ;
module Pr = Prelude[l] ;
module BR = BooleanRing[l] ;
module FC = FinChoice[l] ;
module FN = FreeCountable[l] ;
module NO = NatOrder[l] ;
module TP = TwoPresented[l] ;
module BF = BinfFacts[l] ;

anyFin : (k : Nat) -> (FC.Fin k -> Bool) -> Bool = split {
 zero -> \ h -> false ;
 suc k | r -> \ h -> BF.bjoin (h none) (r (\ i -> h (some i))) } ;
allFin : (k : Nat) -> (FC.Fin k -> Bool) -> Bool = split {
 zero -> \ h -> true ;
 suc k | r -> \ h -> BR.and (h none) (r (\ i -> h (some i))) } ;

-- a witness of anyFin, found by search
any-witness-at (k : Nat) (h : FC.Fin (suc k) -> Bool)
  (r : Id Bool (anyFin k (\ i -> h (some i))) true -> (i : FC.Fin k) * Id Bool (h (some i)) true) :
  Plus (Id Bool (h none) true) (Id Bool (anyFin k (\ i -> h (some i))) true) -> (i : FC.Fin (suc k)) * Id Bool (h i) true = split {
 inl t -> (none, t) ;
 inr t -> (some (r t).1, (r t).2) } ;
any-witness : (k : Nat) (h : FC.Fin k -> Bool) -> Id Bool (anyFin k h) true -> (i : FC.Fin k) * Id Bool (h i) true = split {
 zero -> \ h e -> Pr.absurd ((i : FC.Fin zero) * Id Bool (h i) true) (NO.false-true e) ;
 suc k | r -> \ h e -> any-witness-at k h (r (\ i -> h (some i))) (TP.join-true (h none) (anyFin k (\ i -> h (some i))) e) } ;
any-intro : (k : Nat) (h : FC.Fin k -> Bool) (i : FC.Fin k) -> Id Bool (h i) true -> Id Bool (anyFin k h) true = split {
 zero -> \ h i -> Pr.absurd (Id Bool (h i) true -> Id Bool false true) i ;
 suc k | r -> \ h -> split {
  none -> \ t -> trans (ap (\ b -> BF.bjoin b (anyFin k (\ i -> h (some i)))) t) (BF.join-true-l (anyFin k (\ i -> h (some i)))) ;
  some i -> \ t -> trans (ap (BF.bjoin (h none)) (r (\ j -> h (some j)) i t)) (BF.join-true-r (h none)) } } ;
all-elim : (k : Nat) (h : FC.Fin k -> Bool) -> Id Bool (allFin k h) true -> (i : FC.Fin k) -> Id Bool (h i) true = split {
 zero -> \ h e i -> Pr.absurd (Id Bool (h i) true) i ;
 suc k | r -> \ h e -> split {
  none -> (TP.and-true-inv (h none) (allFin k (\ i -> h (some i))) e).1 ;
  some i -> r (\ j -> h (some j)) (TP.and-true-inv (h none) (allFin k (\ i -> h (some i))) e).2 i } } ;
all-intro : (k : Nat) (h : FC.Fin k -> Bool) -> ((i : FC.Fin k) -> Id Bool (h i) true) -> Id Bool (allFin k h) true = split {
 zero -> \ h e -> refl true ;
 suc k | r -> \ h e -> FN.cong2 BR.and (e none) (r (\ i -> h (some i)) (\ i -> e (some i))) } ;

-- indices
index-inj : (k : Nat) (i j : FC.Fin k) -> Id Nat (FN.index k i) (FN.index k j) -> Id (FC.Fin k) i j = split {
 zero -> \ i -> Pr.absurd ((j : FC.Fin zero) -> Id Nat (FN.index zero i) (FN.index zero j) -> Id (FC.Fin zero) i j) i ;
 suc k | r -> split {
  none -> split { none -> \ p -> refl none ;
                  some j -> \ p -> Pr.absurd (Id (FC.Fin (suc k)) none (some j)) (NO.zero-not-suc (FN.index k j) p) } ;
  some i -> split { none -> \ p -> Pr.absurd (Id (FC.Fin (suc k)) (some i) none) (NO.zero-not-suc (FN.index k i) (sym p)) ;
                    some j -> \ p -> ap (\ x -> some x) (r i j (NatArith[l].suc-inj p)) } } } ;
fin-of : (k o : Nat) -> NO.Lt o k -> (j : FC.Fin k) * Id Nat (FN.index k j) o = split {
 zero -> \ o h -> Pr.absurd ((j : FC.Fin zero) * Id Nat (FN.index zero j) o) (NO.not-lt-zero o h) ;
 suc k | r -> split {
  zero -> \ h -> (none, refl zero) ;
  suc o -> \ h -> (some (r o (NO.lt-pred-suc o k h)).1, ap (\ x -> suc x) (r o (NO.lt-pred-suc o k h)).2) } } ;
-- equality of elements of Fin k, as a Boolean
eqFin (k : Nat) (i j : FC.Fin k) : Bool = NO.delta (FN.index k j) (FN.index k i) ;
any-false : (k : Nat) (h : FC.Fin k -> Bool) -> ((i : FC.Fin k) -> Id Bool (h i) false) -> Id Bool (anyFin k h) false = split {
 zero -> \ h e -> refl false ;
 suc k | r -> \ h e -> FN.cong2 BF.bjoin (e none) (r (\ i -> h (some i)) (\ i -> e (some i))) } ;
