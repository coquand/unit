-- Residual finite-fibre data alone gives corrected sections, in every
-- affine dimension extra+2. The target is the NATIVE dimension suc m.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Tr=Truncation[l] ; module K=GenericDegree[l] ;
module L=GenericLaurent[l] ; module Faces=GenericSubsetFaces[l] ;
two : Nat=suc (suc zero) ; three : Nat=suc two ;
-- Both sums recurse on extra, so this is a named structural equality.
coordinate-count : (extra : Nat) -> Id Nat (suc (plus extra two)) (plus extra three)=split {
 zero -> refl three ; suc extra | rec -> ap (\n -> suc n) rec } ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A])
 (extra : Nat) (D0 : ResidualAlgebra[l].Residual[A,setA,plus extra two]) {
 m : Nat=plus extra two ; nvar : Nat=suc m ;
 module S=GenericFiniteFibreSections[l].Over[A,setA,m,D0] ; module ST=S.ST ;
 module T=GenericCorrectionTransport[l].Over[K0,A,setA,cfn,extra,D0.t,D0.b] ;
 module N=T.At[nvar,m,ST.P,ST.e,S.hpC] ; module J=N.J ; module J0=N.J0 ; module J1=N.J1 ;
 toB : (r : Nat) -> Id Base.Nat (PolynomialRing4Bridge[l].toB r) (CoefficientParts[l].toB r)=split {
  zero -> refl zero ; suc r | rec -> ap (\b -> suc b) rec } ;
 wit (r : Nat) : J1.FC.Wit (suc (CoefficientParts[l].toB r)) (S.w r)=
  subst (\b -> J1.FC.Wit (suc b) (S.w r)) (toB r) (S.wit r) ;
 Corrected : U l=N.Corrected (S.z zero) ;
 correction : Tr.Trunc[Corrected].carrier=
  T.transported nvar (coordinate-count extra) m ST.P ST.e S.hpC S.z S.w wit S.remainder S.compatibility ;
 -- Exact normalization of the original section on the newest Z chart.
 -- The corrected section is congruent to this section modulo I+J.
 hz0 (v : L.Exp nvar) : Id A.R (J.At[negsuc zero,K.topRank (suc zero)].Target.val (S.z zero) (Faces.singleton nvar (inr tt)) v)
  (S.C.C.ZPoint.P.C.N.R.delta0 (LaurentExponentBridge[l].At[nvar].addE v (NativeCoordinates[l].axis nvar (inr tt))))=S.hz0 v ;
} ;
