-- Transport the whole correction theorem once across a coordinate-count
-- equality. Its chart, polynomial, source-family and ideal witnesses move
-- together; no componentwise exponent or cochain transports are needed.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ;
module Tr=Truncation[l] ; module K=GenericDegree[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A])
 (extra t : Nat) (b : Ps.Fin t -> A.R) {
 standard : Nat=plus extra (suc (suc (suc zero))) ;
 module At (n : Nat) (s : Nat)
  (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term n)) (e : Ps.Fin s -> Base.Nat)
  (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,n].Hom (pos (e q)) (p q)) {
  module J=GenericReesChart[l].Over[A,setA,n,t,b,s,p,e,hp] ;
  module J0=J.At[negsuc zero,K.topRank (suc zero)].Q ;
  module J1=J.At[negsuc zero,K.topRank (suc (suc zero))].Q ;
  module D=GenericCechTheorems[l].Over[A,setA].Linear[n,negsuc zero,K.topRank (suc zero)] ;
  d (x : J0.Target.M) : J1.Target.M=D.d.f x ;
  Corrected (z0 : J0.Target.M) : U l=(zz : J0.Target.M)*
   (J1.InJ (d zz)*J0.IJ (suc zero) (J0.ML.msub zz z0)) ;
  Method : U l=(z : Nat -> J0.Target.M) (w : Nat -> J1.Target.M)
   (wit : (r : Nat) -> J1.FC.Wit (suc (CoefficientParts[l].toB r)) (w r))
   (remainder : (r : Nat) -> J1.JW (J1.ML.msub (d (z r)) (w r)))
   (compatibility : (r : Nat) -> J0.IJ (suc zero) (J0.ML.msub (z r) (z zero))) ->
   Tr.Trunc[Corrected (z zero)].carrier ;
 } ;
 Package (n : Nat) : U l=(s : Nat)
  (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term n)) (e : Ps.Fin s -> Base.Nat)
  (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,n].Hom (pos (e q)) (p q)) -> At[n,s,p,e,hp].Method ;
 base : Package standard=\s p e hp z w wit remainder compatibility ->
  GenericReesFromSections[l].Over[K0,A,setA,cfn,extra,t,b,s,p,e,hp].Sections[z,w,wit,remainder,compatibility].correction ;
 transported (n : Nat) (eq : Id Nat n standard) : Package n=subst Package (sym eq) base ;
} ;
