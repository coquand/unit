-- Universal certificates in affine dimensions extra+2 suffice for every
-- finite dimension: pad dimensions1 and0 with zeros, then use the structural
-- equality extra+2=suc(suc extra) for the remaining cases. This helper
-- takes the large-dimension proofs explicitly; final integration supplies
-- them from the constructed section/extraction theorem.
level l ; open Ring[l] ;
module CD=CFNDescent[l] ;
two : Nat=suc (suc zero) ; one : Nat=suc zero ;
plus-two : (n : Nat) -> Id Nat (plus n two) (suc (suc n))=split {
 zero -> refl two ; suc n | rec -> ap (\ k -> suc k) rec } ;
module FromLarge (large : (extra : Nat) -> CD.UniversalZMT (plus extra two)) {
 certificate1 : CD.UniversalZMT one=ResidualPadding[l].lower one (large zero) ;
 certificate0 : CD.UniversalZMT zero=ResidualPadding[l].lower zero certificate1 ;
 positive : (n : Nat) -> CD.UniversalZMT (suc n)=split {
   zero -> certificate1 ;
   suc n -> subst CD.UniversalZMT (plus-two n) (large n) } ;
 all : (n : Nat) -> CD.UniversalZMT n=split {
   zero -> certificate0 ; suc n -> positive n } ;
} ;
