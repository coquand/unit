-- Evaluate arbitrary finite-coordinate term lists with the NEWEST
-- coordinate Z set to1 and the old coordinates set to y_i. Products and
-- sums are proved directly on finite lists; no polynomial representatives
-- or choice is required. This is the first extraction/certificate bridge.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;
module N = FiniteExponents[l] ; module NA = NatArith[l] ;

module Monomials (E : CRing) {
  module P = SectionsPowerAlgebra[l].Over[E] ; module L = RL[E] ;
  value : (m : Nat) -> (Ps.Fin m -> E.R) -> N.Exp m -> E.R = split {
    zero -> \ y u -> E.o ;
    suc m | r -> \ y u -> E.mul (r (\ i -> y (inl i)) (N.old m u)) (P.power (y (inr tt)) (u (inr tt))) } ;
  add : (m : Nat) (y : Ps.Fin m -> E.R) (u v : N.Exp m) ->
    Id E.R (value m y (\ i -> NA.plus (u i) (v i))) (E.mul (value m y u) (value m y v)) = split {
    zero -> \ y u v -> sym (E.mulO E.o) ;
    suc m | r -> \ y u v ->
      trans (Ps.cong2 E.R E.mul _ _ _ _ (r (\ i -> y (inl i)) (N.old m u) (N.old m v))
        (P.power-add (y (inr tt)) (u (inr tt)) (v (inr tt))))
        (sym (L.mul-four (value m (\ i -> y (inl i)) (N.old m u)) (P.power (y (inr tt)) (u (inr tt)))
          (value m (\ i -> y (inl i)) (N.old m v)) (P.power (y (inr tt)) (v (inr tt))))) } ;
} ;

module Over (R E : CRing) (setR : Pr.isSet R.R) (iota : RH.Hom R E)
  (m : Nat) (y : Ps.Fin m -> E.R) {
  module M = Monomials[E] ; module L = RL[E] ;
  module PA = FiniteLaurentAction[l].Over[R,setR,suc m] ;
  Term : U l = R.R * N.Exp (suc m) ;
  Polys : U l = List Term ;
  mon (u : N.Exp (suc m)) : E.R = M.value m y (N.old m u) ;
  term (c : R.R) (u : N.Exp (suc m)) : E.R = E.mul (iota.1 c) (mon u) ;
  deh : Polys -> E.R = split {
    nil -> E.z ; cons t p | r -> E.add (term t.1 t.2) r } ;
  deh-app : (p q : Polys) -> Id E.R (deh (Bar[l].app p q)) (E.add (deh p) (deh q)) = split {
    nil -> \ q -> sym (L.zl (deh q)) ;
    cons t p | r -> \ q -> trans (ap (E.add (term t.1 t.2)) (r q)) (E.addA (term t.1 t.2) (deh p) (deh q)) } ;
  term-product (c d : R.R) (u v : N.Exp (suc m)) :
    Id E.R (E.mul (term c u) (term d v)) (term (R.mul c d) (PA.X.addN u v)) =
    trans (L.mul-four (iota.1 c) (mon u) (iota.1 d) (mon v))
      (trans (ap (\ a -> E.mul a (E.mul (mon u) (mon v))) (sym (iota.2.2.2 c d)))
        (ap (E.mul (iota.1 (R.mul c d))) (sym (M.add m y (N.old m u) (N.old m v))))) ;
  deh-scale (t : Term) : (q : Polys) ->
    Id E.R (deh (PA.scaleT t q)) (E.mul (term t.1 t.2) (deh q)) = split {
    nil -> sym (L.mul-zero (term t.1 t.2)) ;
    cons u q | r -> trans
      (Ps.cong2 E.R E.add _ _ _ _
        (trans (ap (\ a -> term a (PA.X.addN u.2 t.2)) (R.mulC t.1 u.1))
          (trans (sym (term-product u.1 t.1 u.2 t.2)) (E.mulC (term u.1 u.2) (term t.1 t.2)))) r)
      (sym (E.dist (term t.1 t.2) (term u.1 u.2) (deh q))) } ;
  deh-product : (p q : Polys) -> Id E.R (deh (PA.pmul p q)) (E.mul (deh p) (deh q)) = split {
    nil -> \ q -> sym (L.zero-mul (deh q)) ;
    cons t p | r -> \ q -> trans (deh-app (PA.scaleT t q) (PA.pmul p q))
      (trans (Ps.cong2 E.R E.add _ _ _ _ (deh-scale t q) (r q))
        (sym (L.dist-left (term t.1 t.2) (deh p) (deh q)))) } ;
} ;
