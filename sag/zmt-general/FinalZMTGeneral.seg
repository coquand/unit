-- Algebraic ZMT for every finite number of affine generators, over an
-- arbitrary commutative set-ring. Sections, Rees correction, extraction,
-- finite stable module and monic equations are all constructed here.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module Tr=Truncation[l] ;
module TC=TruncationCombinators[l] ; module CD=CFNDescent[l] ; module CB=CoefficientBase[l] ;
module RA=ResidualAlgebra[l] ; module ZC=ZMTCertificate[l] ; module L=GenericLaurent[l] ;

module Residual (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A])
 (extra : Nat) (D0 : RA.Residual[A,setA,plus extra UniversalArityGlue[l].two]) {
 module C=GenericCorrectedSections[l].Over[K0,A,setA,cfn,extra,D0] ;
 m : Nat=C.m ; nvar : Nat=C.nvar ; module S=C.S ; module ST=C.ST ;
 module EX=GenericSectionExtraction[l].Over[A,ST.E,setA,ST.setE,ST.iota,m,ST.FD.y,D0.t,D0.b,m,ST.P,ST.e,S.hpC,ST.deh-P] ;
 module CT=GenericDegreeLoweringCertificate[l].Over[A,setA,ST.E,ST.setE,ST.iota,m,ST.FD.y,D0.t,D0.b] ;
 module TA=TowerLaurentAction[l].Over[A,setA] ;
 hz0 (v : L.Exp nvar) : Id A.R (EX.B0.Target.val (S.z zero) EX.I.Z v)
  (EX.I.R.LC.coeff EX.I.R.R.o (EX.I.R.V.addE v (NativeCoordinates[l].axis nvar (inr tt))))=
   trans (C.hz0 v) (TA.psi-coeff nvar EX.I.R.R.o (EX.I.R.V.addE v (NativeCoordinates[l].axis nvar (inr tt)))) ;
 ZT : U l=ZC.ZMTCert[A,ST.E,ST.iota,m,ST.FD.y,D0.t,D0.b] ;
 module Corrected (c : C.Corrected) {
  extracted : Tr.Trunc[EX.Data.Data].carrier=EX.Sec[c.1,S.z zero,hz0].extract c.2.1 c.2.2 ;
  certificate : Tr.Trunc[ZT].carrier=TC.map EX.Data.Data ZT CT.certificate extracted ;
 } ;
 certificate : Tr.Trunc[ZT].carrier=TC.bind C.Corrected ZT (\c -> Corrected[c].certificate) C.correction ;
} ;

-- Prove the formerly explicit principle in every affine dimension.
large (extra : Nat) : CD.UniversalZMT (plus extra UniversalArityGlue[l].two)=\q D0 ->
 Residual[CB.Codes,CB.ring q,CB.set q,CB.cfn q,extra,D0].certificate ;
module Arity=UniversalArityGlue[l].FromLarge[large] ;
universal : (n : Nat) -> CD.UniversalZMT n=Arity.all ;

-- The usual quotient finite-fibre statement, with no CFN, field or
-- dimension restriction and no supplied UniversalZMT principle.
module Theorem (R : CRing) (setR : Pr.isSet R.R)
 (I : RegularIdeal[l].IdealPred[R]) (propI : (r : R.R) -> Pr.isProp (I.In r))
 (Ea : Algebras[l].Over[R,setR].Algebra) (n : Nat) (x : Ps.Fin n -> Ea.ring.R)
 (gen : (e : Ea.ring.R) -> Tr.Trunc[(H : Presentations[l].Over[R,setR].Expr (Ps.Fin n)) *
   Id Ea.ring.R (Presentations[l].Over[R,setR].eval (Ps.Fin n) Ea x H) e].carrier)
 (fo : Tr.Trunc[QuotientFibre[l].Over[R,setR,I,propI,Ea].Finite].carrier) {
 module F=FiniteFibreLocalisation[l].Over[R,setR,I,propI,Ea,n,x,gen,fo] ;
 -- Keep the canonical ring map in the statement: an unspecified carrier
 -- equivalence would erase which localisation map is an isomorphism.
 module ForS (s : Ea.ring.R) {
  module B=F.ForS[s].B ; module LI=F.ForS[s].LI ;
  Data : U l=QuotientFibre[l].ModuleFinite[R,B.ring,B.iotaB] *
   (B.InB s * Pr.isEquiv LI.Bs.R LI.Es.R LI.phi.1) ;
 } ;
 Conclusion : U l=(s : Ea.ring.R) *
  (F.QF.InIE (Ea.ring.add s (Ea.ring.neg Ea.ring.o)) * ForS[s].Data) ;
 module Of (c : FiniteFibreCertificates[l].Certified[R,I.In,Ea.ring,Ea.iota,n,x]) {
  module O=F.Of[c] ;
  conclusion : Conclusion=(O.s,(O.in-one-plus-IE,(O.CQ.finite,(O.CQ.FB.B.in-w (inr tt),O.CQ.iso.2)))) ;
 } ;
 certified : Tr.Trunc[FiniteFibreCertificates[l].Certified[R,I.In,Ea.ring,Ea.iota,n,x]].carrier=
  F.QF.Gen[n,x,gen,fo].Theorem[universal n].certified ;
 result : Tr.Trunc[Conclusion].carrier=TC.map
  (FiniteFibreCertificates[l].Certified[R,I.In,Ea.ring,Ea.iota,n,x]) Conclusion (\c -> Of[c].conclusion) certified ;
} ;
