-- Singletons and oriented pairs in the recursive finite-subset complex.
-- The newest vertex is FIRST. Consequently d(c)(pair)=c(second)-c(first).
-- Classification uses a natural cardinal count and decides no ring data.
level l ; open Ring[l] ; open GenericCube[l] ; open ZInt[l] ;
module Ps = Presentations[l] ; module Z = ZInt[l] ; module K = GenericDegree[l] ;
module Pr = Prelude[l] ; module FP = FinitePolynomial4[l] ;
one : Base.Nat = suc zero ; two : Base.Nat = suc one ;
step : Flag -> Base.Nat -> Base.Nat = split { absent -> \ n -> n ; present -> \ n -> suc n } ;
count : (n : Nat) -> Sub n -> Base.Nat = split {
 zero -> \ s -> zero ; suc n | r -> \ s -> step s.1 (r s.2) } ;
singleton : (n : Nat) -> Ps.Fin n -> Sub n = split {
 zero -> \ i -> absurd (Sub zero) i ;
 suc n | r -> split { inl i -> (absent,r i) ; inr u -> (present,empty n) } } ;
Pair : Nat -> U l = split { zero -> Empty ; suc n | r -> Plus r (Ps.Fin n) } ;
pairSet : (n : Nat) -> Pair n -> Sub n = split {
 zero -> \ e -> absurd (Sub zero) e ;
 suc n | r -> split { inl e -> (absent,r e) ; inr i -> (present,singleton n i) } } ;
first : (n : Nat) -> Pair n -> Ps.Fin n = split {
 zero -> \ e -> absurd (Ps.Fin zero) e ;
 suc n | r -> split { inl e -> inl (r e) ; inr i -> inr tt } } ;
second : (n : Nat) -> Pair n -> Ps.Fin n = split {
 zero -> \ e -> absurd (Ps.Fin zero) e ;
 suc n | r -> split { inl e -> inl (r e) ; inr i -> inl i } } ;
empty-count : (n : Nat) -> Id Base.Nat (count n (empty n)) zero = split {
 zero -> refl zero ; suc n | r -> r } ;
single-count : (n : Nat) (i : Ps.Fin n) -> Id Base.Nat (count n (singleton n i)) one = split {
 zero -> \ i -> absurd (Id Base.Nat (count zero (singleton zero i)) one) i ;
 suc n | r -> split { inl i -> r i ; inr u -> ap (\ x -> suc x) (empty-count n) } } ;
pair-count : (n : Nat) (e : Pair n) -> Id Base.Nat (count n (pairSet n e)) two = split {
 zero -> \ e -> absurd (Id Base.Nat (count zero (pairSet zero e)) two) e ;
 suc n | r -> split { inl e -> r e ; inr i -> ap (\ x -> suc x) (single-count n i) } } ;
card-count : (n : Nat) (s : Sub n) -> Id Z.Int (K.card n s) (pos (count n s)) = split {
 zero -> \ s -> refl Z.zeroZ ;
 suc n | r -> \ s -> inspect n r s.1 s.2 }
where { inspect (n : Nat) (r : (s : Sub n) -> Id Z.Int (K.card n s) (pos (count n s))) : (f : Flag) (s : Sub n) -> Id Z.Int (K.card (suc n) (f,s)) (pos (count (suc n) (f,s))) = split {
 absent -> r ; present -> \ s -> ap Z.sucZ (r s) } } ;
single-card (n : Nat) (i : Ps.Fin n) : Id Z.Int (K.card n (singleton n i)) (K.topRank (suc zero)) =
 trans (card-count n (singleton n i)) (ap (\ k -> pos k) (single-count n i)) ;
pair-card (n : Nat) (e : Pair n) : Id Z.Int (K.card n (pairSet n e)) (K.topRank (suc (suc zero))) =
 trans (card-count n (pairSet n e)) (ap (\ k -> pos k) (pair-count n e)) ;
predB : Base.Nat -> Base.Nat = split { zero -> zero ; suc n -> n } ;
ZeroTest : Base.Nat -> U l = split { zero -> Empty ; suc n -> Top } ;
no-suc-zero (n : Base.Nat) (e : Id Base.Nat (suc n) zero) : Empty = subst ZeroTest e tt ;
no-zero-suc (n : Base.Nat) (e : Id Base.Nat zero (suc n)) : Empty = no-suc-zero n (sym e) ;
empty-of-count : (n : Nat) (s : Sub n) -> Id Base.Nat (count n s) zero -> Id (Sub n) (empty n) s = split {
 zero -> split { tt -> \ h -> refl tt } ;
 suc n | r -> \ s -> inspect n r s.1 s.2 }
where { inspect (n : Nat) (r : (s : Sub n) -> Id Base.Nat (count n s) zero -> Id (Sub n) (empty n) s) : (f : Flag) (s : Sub n) -> Id Base.Nat (count (suc n) (f,s)) zero -> Id (Sub (suc n)) (empty (suc n)) (f,s) = split {
 absent -> \ s h -> ap (\ a -> (absent,a)) (r s h) ;
 present -> \ s h -> absurd (Id (Sub (suc n)) (empty (suc n)) (present,s)) (no-suc-zero (count n s) h) } } ;
single-of-count : (n : Nat) (s : Sub n) -> Id Base.Nat (count n s) one ->
 (i : Ps.Fin n) * Id (Sub n) (singleton n i) s = split {
 zero -> \ s h -> absurd ((i : Ps.Fin zero) * Id (Sub zero) (singleton zero i) s) (no-zero-suc zero h) ;
 suc n | r -> \ s -> inspect n r s.1 s.2 }
where { inspect (n : Nat) (r : (s : Sub n) -> Id Base.Nat (count n s) one -> (i : Ps.Fin n) * Id (Sub n) (singleton n i) s) : (f : Flag) (s : Sub n) -> Id Base.Nat (count (suc n) (f,s)) one ->
 (i : Ps.Fin (suc n)) * Id (Sub (suc n)) (singleton (suc n) i) (f,s) = split {
 absent -> \ s h -> (inl (r s h).1,ap (\ a -> (absent,a)) (r s h).2) ;
 present -> \ s h -> (inr tt,ap (\ a -> (present,a)) (empty-of-count n s (ap predB h))) } } ;
pair-of-count : (n : Nat) (s : Sub n) -> Id Base.Nat (count n s) two ->
 (e : Pair n) * Id (Sub n) (pairSet n e) s = split {
 zero -> \ s h -> absurd ((e : Pair zero) * Id (Sub zero) (pairSet zero e) s) (no-zero-suc one h) ;
 suc n | r -> \ s -> inspect n r s.1 s.2 }
where { inspect (n : Nat) (r : (s : Sub n) -> Id Base.Nat (count n s) two -> (e : Pair n) * Id (Sub n) (pairSet n e) s) : (f : Flag) (s : Sub n) -> Id Base.Nat (count (suc n) (f,s)) two ->
 (e : Pair (suc n)) * Id (Sub (suc n)) (pairSet (suc n) e) (f,s) = split {
 absent -> \ s h -> (inl (r s h).1,ap (\ a -> (absent,a)) (r s h).2) ;
 present -> \ s h -> (inr (single-of-count n s (ap predB h)).1,
   ap (\ a -> (present,a)) (single-of-count n s (ap predB h)).2) } } ;
classify-single (n : Nat) (s : Sub n) (h : Id Z.Int (K.card n s) (K.topRank (suc zero))) :
 (i : Ps.Fin n) * Id (Sub n) (singleton n i) s = single-of-count n s (ap FP.posN (trans (sym (card-count n s)) h)) ;
classify-pair (n : Nat) (s : Sub n) (h : Id Z.Int (K.card n s) (K.topRank (suc (suc zero)))) :
 (e : Pair n) * Id (Sub n) (pairSet n e) s = pair-of-count n s (ap FP.posN (trans (sym (card-count n s)) h)) ;

module Differential (D : CRing) (setD : Pr.isSet D.R) {
 module C = GenericCube[l].Over[D,setD] ; module L = RL[D] ;
 empty-value : (n : Nat) (c : C.Raw n) -> Id D.R (C.diff n c (empty n)) D.z = split {
 zero -> \ c -> refl D.z ; suc n | r -> \ c -> r (C.left n c) } ;
 single-value : (n : Nat) (c : C.Raw n) (i : Ps.Fin n) ->
 Id D.R (C.diff n c (singleton n i)) (c (empty n)) = split {
 zero -> \ c i -> absurd (Id D.R (C.diff zero c (singleton zero i)) (c (empty zero))) i ;
 suc n | r -> \ c -> split {
 inl i -> r (C.left n c) i ;
 inr u -> trans (ap (C.G.msub (C.left n c (empty n))) (empty-value n (C.right n c)))
   (trans (ap (D.add (C.left n c (empty n))) L.neg-zero) (D.addZ (C.left n c (empty n)))) } } ;
 pair-value : (n : Nat) (c : C.Raw n) (e : Pair n) ->
 Id D.R (C.diff n c (pairSet n e)) (C.G.msub (c (singleton n (second n e))) (c (singleton n (first n e)))) = split {
 zero -> \ c e -> absurd (Id D.R (C.diff zero c (pairSet zero e)) (C.G.msub (c (singleton zero (second zero e))) (c (singleton zero (first zero e))))) e ;
 suc n | r -> \ c -> split {
 inl e -> r (C.left n c) e ;
 inr i -> ap (C.G.msub (C.left n c (singleton n i))) (single-value n (C.right n c) i) } } ;
} ;
