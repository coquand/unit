-- Evaluation of the actual polynomial tower agrees with finite monomial
-- evaluation. At the last variable Z=1 this is dehomogenisation. Hence
-- coefficient extensionality implies dehomogenisation extensionality.
level l ; open Ring[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module RH=RingHom[l] ; module N=FiniteExponents[l] ;
module Evaluate (A E : CRing) (setA : Pr.isSet A.R) (setE : Pr.isSet E.R) (iota : RH.Hom A E) {
 module T=CoefficientPolynomial[l].CoefficientTower[A,setA] ;
 module P=PolynomialTowerBridge[l].Over[A,setA] ;
 module Uv=TowerUniversal[l].Over[A,E,setA,setE] ;
 module M=GenericDehomogenisation[l].Monomials[E] ; module L=RL[E] ;
 module Mono (n : Nat) (f : RH.Hom (T.D n) E) (b : E.R) {
   module UP=Universal[l].Property[T.D n,E,T.setD n,setE].Given[f,b] ;
   value (a : (T.D n).R) : (k : Base.Nat) ->
     Id E.R (UP.extend.1 (P.Level[n].mono a k)) (E.mul (f.1 a) (M.P.power b k))=split {
     zero -> trans (UP.on-constants a) (sym (E.mulO (f.1 a))) ;
     suc k | rec -> trans (UP.extend.2.2.2 P.Level[n].X.variable (P.Level[n].mono a k))
       (trans (Ps.cong2 E.R E.mul _ _ _ _ UP.on-variable rec)
         (L.mul-swap b (f.1 a) (M.P.power b k))) } ;
 } ;
 term : (n : Nat) (y : Ps.Fin n -> E.R) (c : A.R) (u : N.Exp n) ->
   Id E.R ((Uv.extend n iota y).1 (P.term n (c,u))) (E.mul (iota.1 c) (M.value n y u))=split {
   zero -> \ y c u -> sym (E.mulO (iota.1 c)) ;
   suc n | rec -> \ y c u ->
     trans (Mono[n,Uv.extend n iota (\ i -> y (inl i)),y (inr tt)].value (P.term n (c,N.old n u)) (u (inr tt)))
       (trans (ap (\ x -> E.mul x (M.P.power (y (inr tt)) (u (inr tt))))
         (rec (\ i -> y (inl i)) c (N.old n u)))
         (sym (E.mulA (iota.1 c) (M.value n (\ i -> y (inl i)) (N.old n u)) (M.P.power (y (inr tt)) (u (inr tt)))))) } ;
 one-power : (k : Base.Nat) -> Id E.R (M.P.power E.o k) E.o=split {
   zero -> refl E.o ; suc k | rec -> trans (L.one-left (M.P.power E.o k)) rec } ;
}
;
module Over (A E : CRing) (setA : Pr.isSet A.R) (setE : Pr.isSet E.R) (iota : RH.Hom A E)
 (m : Nat) (y : Ps.Fin m -> E.R) {
 module V=Evaluate[A,E,setA,setE,iota] ; module P=V.P ;
 module DH=GenericDehomogenisation[l].Over[A,E,setA,iota,m,y] ;
 point : Ps.Fin (suc m) -> E.R=Ps.snoc (Ps.Fin m) E.R y E.o ;
 hom : RH.Hom (P.T.D (suc m)) E=V.Uv.extend (suc m) iota point ;
 monomial (u : N.Exp (suc m)) : Id E.R (V.M.value (suc m) point u) (DH.mon u)=
   trans (ap (E.mul (DH.mon u)) (V.one-power (u (inr tt)))) (E.mulO (DH.mon u)) ;
 read-term (c : A.R) (u : N.Exp (suc m)) :
   Id E.R (hom.1 (P.term (suc m) (c,u))) (DH.term c u)=
   trans (V.term (suc m) point c u) (ap (E.mul (iota.1 c)) (monomial u)) ;
 read-phi : (p : DH.Polys) -> Id E.R (hom.1 (P.phi (suc m) p)) (DH.deh p)=split {
   nil -> RH.zero (P.T.D (suc m)) E hom ;
   cons t p | rec -> trans (hom.2.2.1 (P.term (suc m) t) (P.phi (suc m) p))
     (Ps.cong2 E.R E.add _ _ _ _ (read-term t.1 t.2) rec) } ;
 deh-equal (p q : DH.Polys) (e : Id (P.T.D (suc m)).R (P.phi (suc m) p) (P.phi (suc m) q)) :
   Id E.R (DH.deh p) (DH.deh q)=trans (sym (read-phi p)) (trans (ap hom.1 e) (read-phi q)) ;
 coefficient-ext (p q : DH.Polys)
   (h : (u : N.Exp (suc m)) -> Id A.R (P.Coeff (suc m) (P.phi (suc m) p) u) (P.Coeff (suc m) (P.phi (suc m) q) u)) :
   Id E.R (DH.deh p) (DH.deh q)=deh-equal p q (P.ext (suc m) _ _ h) ;
 term-coefficient-ext (p q : DH.Polys)
   (h : (u : N.Exp (suc m)) -> Id A.R (P.cf (suc m) p u) (P.cf (suc m) q u)) :
   Id E.R (DH.deh p) (DH.deh q)=deh-equal p q (P.phi-eq (suc m) p q h) ;
} ;
