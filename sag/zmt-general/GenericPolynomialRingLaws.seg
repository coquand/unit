-- Small scalar/term wrappers around the already checked generic tower
-- multiplication comparison. No coefficient multiplication is reproved.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module N = FiniteExponents[l] ; module RH = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module P = PolynomialTowerBridge[l].Over[A,setA] ; module T = P.T ;
 term-zero : (n : Nat) (c : A.R) ->
   Id (T.D n).R (P.term n (c,N.zeroE n)) ((T.grD n).iota.1 c) = split {
   zero -> \ c -> refl c ;
   suc n | r -> \ c -> ap P.Level[n].X.constant (r c) } ;
 module At (n : Nat) {
   module PP = PolynomialTowerProducts[l].Over[A,setA,n] ;
   module FA = PP.FA ; module X = PP.X ;
   R : CRing = T.D n ;
   phi-single (t : P.Term n) : Id R.R (P.phi n (cons t nil)) (P.term n t) = R.addZ (P.term n t) ;
   app-nil : (p : FA.Polys) -> Id FA.Polys (Bar[l].app p nil) p = split {
     nil -> refl nil ; cons t p | r -> ap (\ q -> cons t q) r } ;
   phi-scaleT (t : P.Term n) (q : FA.Polys) :
     Id R.R (P.phi n (FA.scaleT t q)) (R.mul (P.term n t) (P.phi n q)) =
     trans (sym (ap (P.phi n) (app-nil (FA.scaleT t q))))
       (trans (PP.product (cons t nil) q) (ap (\ x -> R.mul x (P.phi n q)) (phi-single t))) ;
   term-product (t u : P.Term n) :
     Id R.R (R.mul (P.term n t) (P.term n u)) (P.term n (A.mul t.1 u.1,X.addN u.2 t.2)) =
     trans (sym (trans (phi-scaleT t (cons u nil)) (ap (R.mul (P.term n t)) (phi-single u))))
       (phi-single (A.mul t.1 u.1,X.addN u.2 t.2)) ;
 } ;
} ;
