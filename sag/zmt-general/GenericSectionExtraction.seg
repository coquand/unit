-- The finite supports needed for clearing are already part of the
-- actual chart cochains. Combine them only under truncation, then extract
-- the degree-lowering data. No representative or support is chosen globally.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module L=GenericLaurent[l] ;
module Tr=Truncation[l] ; module TC=TruncationCombinators[l] ; module K=GenericDegree[l] ;
module Over (A E : CRing) (setA : Pr.isSet A.R) (setE : Pr.isSet E.R) (iota : RingHom[l].Hom A E)
 (m : Nat) (y : Ps.Fin m -> E.R) (t : Nat) (b : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> FiniteLaurentAction[l].Over[A,setA,suc m].Polys) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,suc m].Hom (pos (e q)) (p q))
 (dehP : (q : Ps.Fin s) -> Id E.R (GenericDehomogenisation[l].Over[A,E,setA,iota,m,y].deh (p q)) E.z) {
 module C=GenericClearedExtraction[l].Over[A,E,setA,setE,iota,m,y,t,b,s,p,e,hp,dehP] ;
 module I=C.I ; module B0=C.B0 ; module Q0=C.Q0 ; module Q1=C.Q1 ; module Data=C.Data ;
 n : Nat=suc m ; module SC=I.SC ;
 module Sec (z z0 : B0.Target.El)
  (hz0 : (v : L.Exp n) -> Id A.R (B0.Target.val z0 I.Z v)
    (I.R.LC.coeff I.R.R.o (I.R.V.addE v (NativeCoordinates[l].axis n (inr tt))))) {
  module Witness (closed : Q1.JW (I.DC.d.f z)) (reduction : Q0.IJW (suc zero) (Q0.ML.msub z z0)) {
   module CW=C.Sec[z,z0,hz0].Witness[closed,reduction] ; module W=CW.W ;
   zy : Sub n -> L.Exp n -> A.R=B0.Target.val z ;
   xx (j : Ps.Fin t) : Sub n -> L.Exp n -> A.R=B0.Target.val (W.xs j) ;
   yy : (Ps.Fin s * Sub n) -> L.Exp n -> A.R=\a -> W.Y a.1 a.2 ;
   ix : (Ps.Fin t * Sub n) -> L.Exp n -> A.R=\a -> xx a.1 a.2 ;
   yp : (Ps.Fin s * Sub n) -> L.Exp n -> A.R=\a -> W.Y' a.1 a.2 ;
   module CS=ExtractionCommonSupport[l].Over[A,L.Exp n,Sub n,Ps.Fin s * Sub n,Ps.Fin t * Sub n,Ps.Fin s * Sub n,zy,yy,ix,yp] ;
   SZ : U l=SC.Witness (Sub n) zy ;
   SY : U l=SC.Witness (Ps.Fin s * Sub n) yy ;
   SX : U l=SC.Witness (Ps.Fin t * Sub n) ix ;
   SP : U l=SC.Witness (Ps.Fin s * Sub n) yp ;
   module Chosen (sz : SZ) (sy : SY) (sx : SX) (sp : SP) {
    module S=CS.Chosen[sz,sy,sx,sp] ;
    extracted : Tr.Trunc[Data.Data].carrier=
      CW.Support[S.S,S.first,\q chart -> S.second (q,chart),\j chart -> S.third (j,chart),\q chart -> S.fourth (q,chart)].extracted ;
   } ;
   sy : Tr.Trunc[SY].carrier=SC.finite-fin (Sub n) s W.Y (\q -> CW.YC[q].C.M.supp (closed.1 q)) ;
   sx : Tr.Trunc[SX].carrier=SC.finite-fin (Sub n) t xx (\j -> B0.Target.M.supp (W.xs j)) ;
   sp : Tr.Trunc[SP].carrier=SC.finite-fin (Sub n) s W.Y' (\q -> CW.YPC[q].C.M.supp (reduction.2.2.1 q)) ;
   extracted : Tr.Trunc[Data.Data].carrier=TC.bind2 SZ SY Data.Data
     (\sz sy -> TC.bind2 SX SP Data.Data (\sx sp -> Chosen[sz,sy,sx,sp].extracted) sx sp)
     (B0.Target.M.supp z) sy ;
  } ;
  extract (closed : Q1.InJ (I.DC.d.f z)) (reduction : Q0.IJ (suc zero) (Q0.ML.msub z z0)) :
    Tr.Trunc[Data.Data].carrier=TC.bind2 (Q1.JW (I.DC.d.f z)) (Q0.IJW (suc zero) (Q0.ML.msub z z0)) Data.Data
      (\cl red -> Witness[cl,red].extracted) closed reduction ;
 } ;
} ;
