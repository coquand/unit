-- End-to-end regressions use the proved all-arity theorem, without a
-- supplied ZMT principle. The nonreduced ring has four and five nonzero
-- affine generators, beyond the old three-generator boundary.
level l ; open Ring[l] ;
module Ps=Presentations[l] ; module Tr=Truncation[l] ; module CD=CFNDescent[l] ;
module F=FinalZMTGeneral[l] ; module Q=QuotientExamples[l] ; module D=DescentExamples[l] ;
one : Nat=suc zero ; two : Nat=suc one ; three : Nat=suc two ;
four : Nat=suc three ; five : Nat=suc four ;
universal0 : CD.UniversalZMT zero=F.universal zero ;
universal1 : CD.UniversalZMT one=F.universal one ;
universal2 : CD.UniversalZMT two=F.universal two ;
universal3 : CD.UniversalZMT three=F.universal three ;
universal4 : CD.UniversalZMT four=F.universal four ;
universal5 : CD.UniversalZMT five=F.universal five ;
module Nonreduced (n : Nat) {
 x (i : Ps.Fin n) : Q.R4.R=q2 ;
 module T=F.Theorem[Q.R4,Q.set4,Q.two,Q.even-prop,D.E4,n,x,Q.gen n x,Q.Two.finite] ;
 result : Tr.Trunc[T.Conclusion].carrier=T.result ;
} ;
module N0=Nonreduced[zero] ; module N1=Nonreduced[one] ;
module N2=Nonreduced[two] ; module N3=Nonreduced[three] ;
module N4=Nonreduced[four] ; module N5=Nonreduced[five] ;
module ZeroFibre (n : Nat) {
 x (i : Ps.Fin n) : Q.R4.R=q2 ;
 module T=F.Theorem[Q.R4,Q.set4,Q.all,\r -> ZMod4[l].top-prop,D.E4,n,x,Q.gen n x,Q.Zero.finite] ;
 result : Tr.Trunc[T.Conclusion].carrier=T.result ;
} ;
module EmptyZeroFibre=ZeroFibre[zero] ; module FourZeroFibre=ZeroFibre[four] ;
