-- SyzygyRegression4.seg: regression instances of the constructed-syzygy
-- theorems (handoff §8).  Every instance goes through the NEW theorems
-- (HomogeneousSyzygies4.Gens.Of.homogeneous, CoherentDependence4), never
-- through the hand-written SyzGen proofs of CubicResolution4 and
-- PolynomialPairExample4 (only their data g, hg and Identity are reused).
--
-- Inputs, over any commutative set-ring D:
--   1. g = (X_0^3, X_1^3),          d = (3, 3)   (CubicResolution4.g)
--   2. g = (X_0^3 + X_1^3, X_1^3),  d = (3, 3)   (PolynomialPairExample4.g2)
--   3. g = (X_0, X_0),              d = (1, 1)   repeated generator
--   4. the empty list,              a = 0
--   5. g = (0), the empty term list, with degree 5
-- Dep[K0,cfn].dep_k: the dependence theorem of CoherentDependence4 for each
-- input (D CFN).  Exercise[..].lifted: for a given homogeneous syzygy y of
-- degree n, merely constructed data (b, e, H, ..) together with a z with
-- H z = y, by the constructed SyzGen; this applies the construction to a
-- concrete vector:
--   ex1 : y = (-X_1^3, X_0^3)        at n = 6   (Identity of CubicResolution4)
--   ex2 : y = (-X_1^3, X_0^3 + X_1^3) at n = 6  (Identity of PolynomialPairExample4)
--   ex3 : y = (-1, 1)                at n = 1   (weighted column with constant
--                                                entries; the elementary
--                                                syzygy of (X_0, X_0))
--   ex4 : y = (1) for g = (0)        at n = 5
--   ex5 : y = (0, 0) for input 1     at n = 1   (degrees 1 - 3 < 0)
--   ex6 : the empty vector           at n = 0   (a = 0)
-- OverZ: all of them over Z (ZCFN).  No canonical output of the coherence
-- algorithm is compared: only the certificate properties are used.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ; open ShiftedCech4[l] ;
open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Ps = Presentations[l] ; module TL4 = TopList4[l] ; module CRt = CubicResolution4[l] ;

eX : N4 = nx (suc zero) zero zero zero ;
one : Base.Nat = suc zero ;
five : Base.Nat = suc (suc (suc (suc (suc zero)))) ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module C = Cech4[l].Over[D,setD] ; module LO = C.LO ;
  module PA = PolynomialAction4[l].Over[D,setD] ;
  module SC = ShiftedCech4[l].Over[D,setD] ;
  module HM = HomogeneousMatrices4[l].Over[D,setD] ;
  module LS = LaurentSyzygyLift4[l].Over[D,setD] ;
  module FP = FinitePolynomial4[l].Over[D,setD] ;
  module BR = PolynomialRing4Bridge[l].Over[D,setD] ;
  module UGS = UngradedSyzygies4[l].Over[D,setD] ;
  module HS = HomogeneousSyzygies4[l].Over[D,setD] ;
  module CR = CRt.Over[D,setD] ;
  module PP = PolynomialPairExample4[l].Over[D,setD] ;

  ------------------------------------------------------------------------
  -- the inputs 3, 4, 5

  Xl : TPoly D.R = cons (D.o, eX) nil ;
  d3 (i : Ps.Fin CRt.rk2) : Base.Nat = one ;
  g3 : Ps.Fin CRt.rk2 -> TPoly D.R = CRt.pair (TPoly D.R) Xl Xl ;
  hg3 : (i : Ps.Fin CRt.rk2) -> HomDeg D.R (d3 i) (g3 i) =
    CRt.pair-ind (\ i -> HomDeg D.R (d3 i) (g3 i)) (refl one, tt) (refl one, tt) ;
  d4 (i : Ps.Fin zero) : Base.Nat = absurd Base.Nat i ;
  g4 (i : Ps.Fin zero) : TPoly D.R = absurd (TPoly D.R) i ;
  hg4 (i : Ps.Fin zero) : HomDeg D.R (d4 i) (g4 i) = absurd (HomDeg D.R (d4 i) (g4 i)) i ;
  d5 (i : Ps.Fin CRt.rk1) : Base.Nat = five ;
  g5 (i : Ps.Fin CRt.rk1) : TPoly D.R = nil ;
  hg5 (i : Ps.Fin CRt.rk1) : HomDeg D.R (d5 i) (g5 i) = tt ;

  ------------------------------------------------------------------------
  -- the dependence theorem for each input

  module Dep (K0 : U l) (cfn : CFN[l].CFN[K0,D]) {
    module CD = CoherentDependence4[l].Over[K0,D,setD,cfn] ;
    module I1 = CD.Input[CRt.rk2,CR.dsh,CR.g,CR.hg] ;
    module I2 = CD.Input[CRt.rk2,CR.dsh,PP.g2,PP.hg2] ;
    module I3 = CD.Input[CRt.rk2,d3,g3,hg3] ;
    module I4 = CD.Input[zero,d4,g4,hg4] ;
    module I5 = CD.Input[CRt.rk1,d5,g5,hg5] ;
    dep1 (c : Nat -> I1.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[I1.Lifted (c n)].carrier) : Tr.Trunc[I1.Seq[c,lift].Result].carrier =
      I1.Seq[c,lift].dependence ;
    dep2 (c : Nat -> I2.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[I2.Lifted (c n)].carrier) : Tr.Trunc[I2.Seq[c,lift].Result].carrier =
      I2.Seq[c,lift].dependence ;
    dep3 (c : Nat -> I3.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[I3.Lifted (c n)].carrier) : Tr.Trunc[I3.Seq[c,lift].Result].carrier =
      I3.Seq[c,lift].dependence ;
    dep4 (c : Nat -> I4.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[I4.Lifted (c n)].carrier) : Tr.Trunc[I4.Seq[c,lift].Result].carrier =
      I4.Seq[c,lift].dependence ;
    dep5 (c : Nat -> I5.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[I5.Lifted (c n)].carrier) : Tr.Trunc[I5.Seq[c,lift].Result].carrier =
      I5.Seq[c,lift].dependence ;
  } ;

  ------------------------------------------------------------------------
  -- the constructed SyzGen on concrete homogeneous syzygies

  -- y_i = cf of a term list of degree n - d_i, with sum_i g_i y_i = 0 by coefficients
  module Exercise (K0 : U l) (cfn : CFN[l].CFN[K0,D]) (a : Nat) (d : Ps.Fin a -> Base.Nat) (g : Ps.Fin a -> TPoly D.R)
    (hg : (i : Ps.Fin a) -> HomDeg D.R (d i) (g i)) (n : Int) (y : Ps.Fin a -> TPoly D.R)
    (hy : (i : Ps.Fin a) -> SC.Shifts zeroZ (minus n (d i)) (y i)) (sy : UGS.Gens[a,g].USyz y) {
    module GS = HS.Gens[a,d,g,hg] ;
    module V (x : GS.SyzData) {
      module F = LS.Pol[GS.SD[x].M,n].F ;
      yv : F.E1.El = \ i -> FP.polEl (F.k1 i) (y i) (hy i) ;
      syzv : LS.Pol[GS.SD[x].M,n].Syz yv = F.E0.eq (F.A.f yv) F.E0.mod.mz (\ s m ->
        trans (SC.ChartSums[Sq,BadI Sq setPol n].val-sum a (\ i -> (F.gi i).f (yv i)) s m)
              (trans (sym (UGS.Gens[a,g].cf-prod y m)) (FP.cf-of-cz (UGS.Gens[a,g].prod y) sy m))) ;
      lifted : LS.Pol[GS.SD[x].M,n].Lifts yv = GS.SD[x].syz n yv syzv ;
    } ;
    lifted : Tr.Trunc[(x : GS.SyzData) * LS.Pol[GS.SD[x].M,n].Lifts (V[x].yv)].carrier =
      TC.map GS.SyzData ((x : GS.SyzData) * LS.Pol[GS.SD[x].M,n].Lifts (V[x].yv)) (\ x -> (x, V[x].lifted)) GS.Of[K0,cfn].homogeneous ;
  } ;

  -- the vectors
  zl : TPoly D.R = nil ;
  cl (c : D.R) : TPoly D.R = cons (c, BR.zeroN) nil ;
  y1 (i : Ps.Fin CRt.rk2) : TPoly D.R = CR.H i (inr tt) ;
  hy1 : (i : Ps.Fin CRt.rk2) -> SC.Shifts zeroZ (minus (pos TL4.six) (CR.dsh i)) (y1 i) =
    CRt.pair-ind (\ i -> SC.Shifts zeroZ (minus (pos TL4.six) (CR.dsh i)) (y1 i)) (refl zeroZ, tt) (refl zeroZ, tt) ;
  y2 (i : Ps.Fin CRt.rk2) : TPoly D.R = PP.H2 i (inr tt) ;
  hy2 : (i : Ps.Fin CRt.rk2) -> SC.Shifts zeroZ (minus (pos TL4.six) (CR.dsh i)) (y2 i) =
    CRt.pair-ind (\ i -> SC.Shifts zeroZ (minus (pos TL4.six) (CR.dsh i)) (y2 i)) (refl zeroZ, tt) (refl zeroZ, (refl zeroZ, tt)) ;
  y3 : Ps.Fin CRt.rk2 -> TPoly D.R = CRt.pair (TPoly D.R) (cl (D.neg D.o)) (cl D.o) ;
  hy3 : (i : Ps.Fin CRt.rk2) -> SC.Shifts zeroZ (minus (pos one) (d3 i)) (y3 i) =
    CRt.pair-ind (\ i -> SC.Shifts zeroZ (minus (pos one) (d3 i)) (y3 i)) (refl zeroZ, tt) (refl zeroZ, tt) ;
  -- X_0 . 1 + X_0 . (-1) = 0
  sy3 : UGS.Gens[CRt.rk2,g3].USyz y3 = \ v -> CR.cancel (Id N4 (addN4 BR.zeroN eX) v) (dec-n4 (addN4 BR.zeroN eX) v) ;
  y4 (i : Ps.Fin zero) : TPoly D.R = absurd (TPoly D.R) i ;
  y5 (i : Ps.Fin CRt.rk1) : TPoly D.R = cl D.o ;
  y0 (i : Ps.Fin CRt.rk2) : TPoly D.R = zl ;

  module Ex (K0 : U l) (cfn : CFN[l].CFN[K0,D]) {
    module ex1 = Exercise[K0,cfn,CRt.rk2,CR.dsh,CR.g,CR.hg,pos TL4.six,y1,hy1,CR.id1 (inr tt)] ;
    module ex2 = Exercise[K0,cfn,CRt.rk2,CR.dsh,PP.g2,PP.hg2,pos TL4.six,y2,hy2,PP.id2 (inr tt)] ;
    module ex3 = Exercise[K0,cfn,CRt.rk2,d3,g3,hg3,pos one,y3,hy3,sy3] ;
    module ex4 = Exercise[K0,cfn,CRt.rk1,d5,g5,hg5,pos five,y5,\ i -> (refl zeroZ, tt),\ v -> refl D.z] ;
    module ex5 = Exercise[K0,cfn,CRt.rk2,CR.dsh,CR.g,CR.hg,pos one,y0,\ i -> tt,\ v -> refl D.z] ;
    module ex6 = Exercise[K0,cfn,zero,d4,g4,hg4,zeroZ,y4,\ i -> absurd (SC.Shifts zeroZ (minus zeroZ (d4 i)) (y4 i)) i,\ v -> refl D.z] ;
    lifted1 : Tr.Trunc[(x : ex1.GS.SyzData) * LS.Pol[ex1.GS.SD[x].M,pos TL4.six].Lifts (ex1.V[x].yv)].carrier = ex1.lifted ;
    lifted2 : Tr.Trunc[(x : ex2.GS.SyzData) * LS.Pol[ex2.GS.SD[x].M,pos TL4.six].Lifts (ex2.V[x].yv)].carrier = ex2.lifted ;
    lifted3 : Tr.Trunc[(x : ex3.GS.SyzData) * LS.Pol[ex3.GS.SD[x].M,pos one].Lifts (ex3.V[x].yv)].carrier = ex3.lifted ;
    lifted4 : Tr.Trunc[(x : ex4.GS.SyzData) * LS.Pol[ex4.GS.SD[x].M,pos five].Lifts (ex4.V[x].yv)].carrier = ex4.lifted ;
    lifted5 : Tr.Trunc[(x : ex5.GS.SyzData) * LS.Pol[ex5.GS.SD[x].M,pos one].Lifts (ex5.V[x].yv)].carrier = ex5.lifted ;
    lifted6 : Tr.Trunc[(x : ex6.GS.SyzData) * LS.Pol[ex6.GS.SD[x].M,zeroZ].Lifts (ex6.V[x].yv)].carrier = ex6.lifted ;
  } ;
} ;

-- over Z
module OverZ {
  module XZ = Over[ZRing[l].ring, int-set] ;
  module DZ = XZ.Dep[Nat * Nat, ZCFN[l].cfn] ;
  module EZ = XZ.Ex[Nat * Nat, ZCFN[l].cfn] ;
  dep1 : (c : Nat -> DZ.I1.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[DZ.I1.Lifted (c n)].carrier) -> Tr.Trunc[DZ.I1.Seq[c,lift].Result].carrier = DZ.dep1 ;
  dep3 : (c : Nat -> DZ.I3.F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[DZ.I3.Lifted (c n)].carrier) -> Tr.Trunc[DZ.I3.Seq[c,lift].Result].carrier = DZ.dep3 ;
  lifted3 : Tr.Trunc[(x : EZ.ex3.GS.SyzData) * XZ.LS.Pol[EZ.ex3.GS.SD[x].M,pos one].Lifts (EZ.ex3.V[x].yv)].carrier = EZ.lifted3 ;
} ;
