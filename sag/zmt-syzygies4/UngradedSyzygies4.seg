-- UngradedSyzygies4.seg: finitely many ungraded syzygies of term-list
-- polynomials g_0, .., g_(a-1), from the coherence of S = D[X_0,..,X_3]
-- (handoff §5, Gate B).
--
-- Statement (Gens[a,g]).  For term lists y_0, .., y_(a-1):
--   USyz y      : every coefficient of sum_i g_i y_i is 0;
--   UComb p h y : merely c_0, .., c_(p-1) with, for every i,
--                 y_i = sum_k h_k,i c_k  by coefficients;
--   UngradedW   : p, columns h_0, .., h_(p-1) (term-list vectors) with
--                 USyz h_k for every k, and UComb p h y for every y with
--                 USyz y.
-- Theorem (Of[K0,cfn].ungraded).  If D is a CFN set-ring, merely UngradedW.
-- Proof.
--   * S is CFN: HilbertCFN four times (S1 = D[X_0], .., S = S3[X_3]).
--   * Coherence of S as a module over itself, for the row
--     u_i = phi g_i (the S-images), gives merely q, gs_0, .., gs_(q-1) in
--     S^a with sum_i gs_k,i u_i = 0, and every syzygy of u merely a
--     combination of the gs_k (Coherent.Coh).  For a single row, ring
--     coherence is exactly this; no resolution is used.
--   * Each of the finitely many entries gs_k,i merely is phi h_k,i
--     (PolynomialRing4Bridge.rep; fin-choice over k and i, inside the
--     truncation).  Then phi (sum_i g_i h_k,i) = sum_i gs_k,i u_i = 0, so
--     every coefficient of sum_i g_i h_k,i is 0 (cz-of-phi).
--   * Syzygies transfer both ways: USyz y iff (phi y_i) is a syzygy of u
--     in S (syz-to-S, syz-from-S; phi-prod: phi (sum_i g_i y_i) = sum_i
--     phi y_i u_i, with cf-prod the same at the level of coefficients).
--   * If USyz y, then phi (sum_i g_i y_i) = 0, i.e. (phi y_i) is a
--     syzygy of u in S; merely phi y = sum_k c_k gs_k with c_k in S, and
--     each c_k merely is phi cc_k.  For every i,
--         phi y_i = sum_k c_k gs_k,i = phi (sum_k h_k,i cc_k)
--     (Free.comb-at, phi-psum, phi-pmul), so y_i = sum_k h_k,i cc_k by
--     coefficients (coef-eq-of-phi).
-- Only finitely many representatives are chosen, each time inside the
-- truncated goal; no function S -> term lists is assumed.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Ps = Presentations[l] ; module LSL = LaurentSyzygyLift4[l] ;

module Over (D : CRing) (setD : Pr.isSet D.R) {
  module PA = PolynomialAction4[l].Over[D,setD] ;
  module FP = FinitePolynomial4[l].Over[D,setD] ;
  module BR = PolynomialRing4Bridge[l].Over[D,setD] ;
  module RS = Comb[l].Sums[D,IP.regular D] ;

  module Gens (a : Nat) (g : Ps.Fin a -> TPoly D.R) {
    -- sum_i g_i y_i
    prod (y : Ps.Fin a -> TPoly D.R) : TPoly D.R = PA.psum a (\ i -> PA.pmul (g i) (y i)) ;
    -- y is an ungraded syzygy
    USyz (y : Ps.Fin a -> TPoly D.R) : U l = PA.CoefZero (prod y) ;
    -- equality by coefficients
    CoefEq (p q : TPoly D.R) : U l = (v : N4) -> Id D.R (PA.coef p v) (PA.coef q v) ;
    -- y = sum_k h_k c_k, by coefficients
    CombW (p : Nat) (h : Ps.Fin p -> Ps.Fin a -> TPoly D.R) (y : Ps.Fin a -> TPoly D.R) : U l =
      (c : Ps.Fin p -> TPoly D.R) * ((i : Ps.Fin a) -> CoefEq (y i) (PA.psum p (\ k -> PA.pmul (h k i) (c k)))) ;
    UComb (p : Nat) (h : Ps.Fin p -> Ps.Fin a -> TPoly D.R) (y : Ps.Fin a -> TPoly D.R) : U l = Tr.Trunc[CombW p h y].carrier ;
    -- finitely many syzygies generating all of them
    UngradedW : U l = (p : Nat) * ((h : Ps.Fin p -> Ps.Fin a -> TPoly D.R) *
      (((k : Ps.Fin p) -> USyz (h k)) * ((y : Ps.Fin a -> TPoly D.R) -> USyz y -> UComb p h y))) ;
    module UG (w : UngradedW) {
      p : Nat = w.1 ;
      h : Ps.Fin p -> Ps.Fin a -> TPoly D.R = w.2.1 ;
      syz : (k : Ps.Fin p) -> USyz (h k) = w.2.2.1 ;
      gen : (y : Ps.Fin a -> TPoly D.R) -> USyz y -> UComb p h y = w.2.2.2 ;
    } ;

    -- the coefficient function of sum_i g_i y_i
    cf-prod (y : Ps.Fin a -> TPoly D.R) (m : E4) : Id D.R (FP.cf (prod y) m) (RS.sum a (\ i -> PA.mulP (g i) (FP.cf (y i)) m)) =
      trans (FP.cf-psum a (\ i -> PA.pmul (g i) (y i)) m)
            (RS.sum-cong a (\ i -> FP.cf (PA.pmul (g i) (y i)) m) (\ i -> PA.mulP (g i) (FP.cf (y i)) m) (\ i -> FP.cf-pmul (g i) (y i) m)) ;

    -- in S: the row u_i = phi g_i
    module CO = Coherent[l].Over[BR.S,IP.regular BR.S] ;
    module FS = Comb[l].Free[BR.S,a] ;
    u (i : Ps.Fin a) : BR.S.R = BR.phi (g i) ;
    phi-prod (y : Ps.Fin a -> TPoly D.R) : Id BR.S.R (BR.phi (prod y)) (BR.SS.comb a (\ i -> BR.phi (y i)) u) =
      trans (BR.phi-psum a (\ i -> PA.pmul (g i) (y i)))
            (BR.SS.sum-cong a (\ i -> BR.phi (PA.pmul (g i) (y i))) (\ i -> BR.S.mul (BR.phi (y i)) (u i))
              (\ i -> trans (BR.phi-pmul (g i) (y i)) (BR.S.mulC (u i) (BR.phi (y i))))) ;
    -- syzygies transfer both ways
    syz-to-S (y : Ps.Fin a -> TPoly D.R) (sy : USyz y) : CO.Syz a u (\ i -> BR.phi (y i)) =
      trans (sym (phi-prod y)) (BR.phi-zero-of-cz (prod y) sy) ;
    syz-from-S (y : Ps.Fin a -> TPoly D.R) (h : CO.Syz a u (\ i -> BR.phi (y i))) : USyz y =
      BR.cz-of-phi (prod y) (trans (phi-prod y) h) ;
    -- phi (sum_k h_k cc_k) = sum_k phi h_k phi cc_k
    phi-col (p : Nat) (hh : Ps.Fin p -> TPoly D.R) (cc : Ps.Fin p -> TPoly D.R) :
      Id BR.S.R (BR.phi (PA.psum p (\ k -> PA.pmul (hh k) (cc k)))) (BR.SS.sum p (\ k -> BR.S.mul (BR.phi (hh k)) (BR.phi (cc k)))) =
      trans (BR.phi-psum p (\ k -> PA.pmul (hh k) (cc k)))
            (BR.SS.sum-cong p (\ k -> BR.phi (PA.pmul (hh k) (cc k))) (\ k -> BR.S.mul (BR.phi (hh k)) (BR.phi (cc k)))
              (\ k -> BR.phi-pmul (hh k) (cc k))) ;

    module Of (K0 : U l) (cfn : CFN[l].CFN[K0,D]) {
      -- S is CFN
      cfnS : CFN[l].CFN[K0,BR.S] =
        HilbertCFN[l].Over[K0,BR.L3.T,BR.L3.X.set].poly
          (HilbertCFN[l].Over[K0,BR.L2.T,BR.L2.X.set].poly
            (HilbertCFN[l].Over[K0,BR.L1.T,BR.L1.X.set].poly
              (HilbertCFN[l].Over[K0,D,setD].poly cfn))) ;

      -- the coherence data of S, with term-list representatives of its entries
      module Reps (q : Nat) (gs : Ps.Fin q -> FS.Vec) (sa : CO.SyzAll a u q gs) (un : CO.Univ a u q gs)
        (rp : (k : Ps.Fin q) (i : Ps.Fin a) -> BR.RepW (gs k i)) {
        h (k : Ps.Fin q) (i : Ps.Fin a) : TPoly D.R = (rp k i).1 ;
        -- each h_k is a syzygy
        syz (k : Ps.Fin q) : USyz (h k) = BR.cz-of-phi (prod (h k)) (calc BR.S.R {
          BR.phi (prod (h k)) =< phi-prod (h k) > BR.SS.comb a (\ i -> BR.phi (h k i)) u
            =< BR.SS.sum-cong a (\ i -> BR.S.mul (BR.phi (h k i)) (u i)) (\ i -> BR.S.mul (gs k i) (u i))
                 (\ i -> ap (\ x -> BR.S.mul x (u i)) (rp k i).2)
            > BR.SS.comb a (gs k) u
            =< sa k > BR.S.z }) ;
        -- every syzygy y is a combination of the h_k
        module Gen (y : Ps.Fin a -> TPoly D.R) (sy : USyz y) {
          syzS : CO.Syz a u (\ i -> BR.phi (y i)) = syz-to-S y sy ;
          module Coeffs (cS : Ps.Fin q -> BR.S.R) (ce : Id FS.Vec (FS.VS.comb q cS gs) (\ i -> BR.phi (y i)))
            (rc : (k : Ps.Fin q) -> BR.RepW (cS k)) {
            c (k : Ps.Fin q) : TPoly D.R = (rc k).1 ;
            at (i : Ps.Fin a) : Id BR.S.R (BR.phi (y i)) (BR.phi (PA.psum q (\ k -> PA.pmul (h k i) (c k)))) = calc BR.S.R {
              BR.phi (y i) =< sym (Pr.happly (Ps.Fin a) (\ i' -> BR.S.R) (FS.VS.comb q cS gs) (\ i' -> BR.phi (y i')) ce i)
                > FS.VS.comb q cS gs i
                =< FS.comb-at q cS gs i > BR.SS.comb q cS (\ k -> gs k i)
                =< BR.SS.sum-cong q (\ k -> BR.S.mul (cS k) (gs k i)) (\ k -> BR.S.mul (BR.phi (h k i)) (BR.phi (c k)))
                     (\ k -> trans (BR.S.mulC (cS k) (gs k i))
                                   (trans (ap (\ x -> BR.S.mul x (cS k)) (sym (rp k i).2)) (ap (BR.S.mul (BR.phi (h k i))) (sym (rc k).2))))
                > BR.SS.sum q (\ k -> BR.S.mul (BR.phi (h k i)) (BR.phi (c k)))
                =< sym (phi-col q (\ k -> h k i) c) > BR.phi (PA.psum q (\ k -> PA.pmul (h k i) (c k))) } ;
            w : CombW q h y = (c, \ i -> BR.coef-eq-of-phi (y i) (PA.psum q (\ k -> PA.pmul (h k i) (c k))) (at i)) ;
          } ;
          comb : UComb q h y =
            TC.bind (CO.InFV a q gs (\ i -> BR.phi (y i))) (CombW q h y)
              (\ x -> TC.map ((k : Ps.Fin q) -> BR.RepW (x.1 k)) (CombW q h y) (\ rc -> Coeffs[x.1,x.2,rc].w)
                        (LSL.fin-choice q (\ k -> BR.RepW (x.1 k)) (\ k -> BR.rep (x.1 k))))
              (un (\ i -> BR.phi (y i)) syzS) ;
        } ;
        ungraded : UngradedW = (q, (h, (syz, \ y sy -> Gen[y,sy].comb))) ;
      } ;

      module FromCoh (cw : CO.CohW a u) {
        reps : Tr.Trunc[(k : Ps.Fin cw.1) (i : Ps.Fin a) -> BR.RepW (cw.2.1 k i)].carrier =
          LSL.fin-choice cw.1 (\ k -> (i : Ps.Fin a) -> BR.RepW (cw.2.1 k i))
            (\ k -> LSL.fin-choice a (\ i -> BR.RepW (cw.2.1 k i)) (\ i -> BR.rep (cw.2.1 k i))) ;
        res : Tr.Trunc[UngradedW].carrier =
          TC.map ((k : Ps.Fin cw.1) (i : Ps.Fin a) -> BR.RepW (cw.2.1 k i)) UngradedW
            (\ rp -> Reps[cw.1,cw.2.1,cw.2.2.1,cw.2.2.2,rp].ungraded) reps ;
      } ;
      -- THEOREM (Gate B)
      ungraded : Tr.Trunc[UngradedW].carrier = TC.bind (CO.CohW a u) UngradedW (\ cw -> FromCoh[cw].res) (cfnS.coh a u) ;
    } ;
  } ;
} ;
