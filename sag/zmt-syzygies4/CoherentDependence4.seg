-- CoherentDependence4.seg: the four-coordinate dependence theorem with the
-- homogeneous syzygies CONSTRUCTED (handoff §7, Gate D).
--
-- Theorem (Over[K0,D,setD,cfn].Input[a,d,g,hg].Seq[c,lift].dependence).
-- Let D be a CFN commutative set-ring and g_0, .., g_(a-1) term-list
-- polynomials, every term of g_i of degree d_i.  Let c : Nat -> C^1(-1)
-- such that every c_n merely has u_n,i in C^2(-1-d_i) with
--     delta c_n = sum_i g_i u_n,i .
-- Then merely there are qs = [q_(N-1), .., q_0] (N = len qs, N = 0 allowed),
-- h in C^0(-1) and a_i in C^1(-1-d_i) with
--     c_N - sum_{i<N} q_i c_i = delta h + sum_i g_i a_i .
-- The hypotheses are D, setD, cfn, a, d, g, hg, c and the truncated lifts;
-- no syzygy matrix, Identity or SyzGen, and no sequence of representatives.
--
-- The statement is about the families of the base data M0 (the original a,
-- d, g, hg with no column: b = 0); E0^q = C^q(-1), E1^q = prod_i
-- C^q(-1-d_i), A y = sum_i g_i y_i, delta = Cech4.D0, D1.  These depend on
-- a, d, g, hg only, so they are those of any matrices with the same a, d,
-- g, hg (lift', back: named transports, checked once).
-- Proof.  HomogeneousSyzygies4.Gens.Of.homogeneous merely gives b, e, H,
-- hH with Identity M and SyzGen M for M = (a, b, d, e, g, H, hg, hH).  For
-- such data, the already checked ResolutionDependence4 (Dep[M,ah,syz].Seq)
-- gives merely qs with Bdry(c_N - sumL qs); its sum sumL is the sum below
-- (sumL-same, by induction on qs).  The truncation of the data is
-- eliminated into the truncated conclusion (bind).
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ; open ShiftedCech4[l] ;
open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Ps = Presentations[l] ; module TL4 = TopList4[l] ;

module Over (K0 : U l) (D : CRing) (setD : Pr.isSet D.R) (cfn : CFN[l].CFN[K0,D]) {
  module C = Cech4[l].Over[D,setD] ;
  module SC = ShiftedCech4[l].Over[D,setD] ;
  module HM = HomogeneousMatrices4[l].Over[D,setD] ;
  module HS = HomogeneousSyzygies4[l].Over[D,setD] ;

  module Input (a : Nat) (d : Ps.Fin a -> Base.Nat) (g : Ps.Fin a -> TPoly D.R) (hg : (i : Ps.Fin a) -> HomDeg D.R (d i) (g i)) {
    module GS = HS.Gens[a,d,g,hg] ;
    -- the base data, with no column
    M0 : Matrices[D] = mkMatrices D a zero d (\ j -> absurd Base.Nat j) g (\ i j -> absurd (TPoly D.R) j) hg
      (\ i j -> absurd (HomShift D.R (d i) (absurd Base.Nat j) (absurd (TPoly D.R) j)) j) ;
    -- C^q(-1), prod_i C^q(-1-d_i), A, delta
    module F0 = HM.Fam[M0,Pt,setPt,TL4.mOne] ;
    module F1 = HM.Fam[M0,Ed,setEd,TL4.mOne] ;
    module F2 = HM.Fam[M0,Tri,setTri,TL4.mOne] ;
    module D0 = HM.DiffFam[M0,Pt,setPt,Ed,setEd,C.D0,\ k k' p hp x -> SC.Comm[k,k',p,hp].d0 x,TL4.mOne] ;
    module D1 = HM.DiffFam[M0,Ed,setEd,Tri,setTri,C.D1,\ k k' p hp x -> SC.Comm[k,k',p,hp].d1 x,TL4.mOne] ;
    module MZ = IP.ModL[D,F1.E0.mod] ;
    -- delta c = sum_i g_i u_i
    Lifted (c : F1.E0.El) : U l = (u : F2.E1.El) * Id F2.E0.El (D1.d0.f c) (F2.A.f u) ;
    -- c = delta h + sum_i g_i a_i
    Bdry (c : F1.E0.El) : U l = (h : F0.E0.El) * ((a' : F1.E1.El) * Id F1.E0.El c (F1.E0.mod.madd (D0.d0.f h) (F1.A.f a'))) ;

    module Seq (c : Nat -> F1.E0.El) (lift : (n : Nat) -> Tr.Trunc[Lifted (c n)].carrier) {
      -- sum_{i<N} q_i c_i for qs = [q_(N-1), .., q_0]
      sumL : List D.R -> F1.E0.El = split {
        nil -> F1.E0.mod.mz ;
        cons x xs | r -> F1.E0.mod.madd (F1.E0.mod.sm x (c (len xs))) r } ;
      rest (qs : List D.R) : F1.E0.El = MZ.msub (c (len qs)) (sumL qs) ;
      Result : U l = (qs : List D.R) * Bdry (rest qs) ;

      -- for constructed data: the checked theorem ResolutionDependence4
      module FromData (x : GS.SyzData) {
        module SD = GS.SD[x] ;
        module RD = ResolutionDependence4[l].Over[K0,D,setD,cfn].Dep[SD.M,SD.ah,SD.syz] ;
        -- the lifts, for the families of SD.M (the same types)
        lift' (n : Nat) : Tr.Trunc[RD.R.Lifted (c n)].carrier = lift n ;
        module RS = RD.Seq[c,lift'] ;
        sumL-same : (qs : List D.R) -> Id F1.E0.El (RS.CD.RS.sumL qs) (sumL qs) = split {
          nil -> refl F1.E0.mod.mz ;
          cons x xs | r -> ap (F1.E0.mod.madd (F1.E0.mod.sm x (c (len xs)))) r } ;
        -- the conclusion, for the families of M0
        back (res : RS.Result) : Result =
          (res.1, subst (\ t -> Bdry (MZ.msub (c (len res.1)) t)) (sumL-same res.1) res.2) ;
        dependence : Tr.Trunc[Result].carrier = TC.map RS.Result Result back RS.dependence ;
      } ;
      -- THEOREM (Gate D)
      dependence : Tr.Trunc[Result].carrier =
        TC.bind GS.SyzData Result (\ x -> FromData[x].dependence) GS.Of[K0,cfn].homogeneous ;
    } ;
  } ;
} ;
