-- Polynomialize any finite Laurent coefficient function after a proved
-- clearing shift. The shift is prescribed, so compatible singleton/edge
-- denominators can be used by extraction.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module L=GenericLaurent[l] ;
module E=FiniteExponents[l] ; module CD=ChartDenominators[l] ; module X=LaurentExponentBridge[l] ;
module PA=PolynomialAction4[l] ; module CP=ChartPolynomialization[l] ; module LP=LaurentPolynomialCoefficients[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module P=PolynomialTowerBridge[l].Over[A,setA] ;
 module Clear (n : Nat) (support : List (L.Exp n)) (f : L.Exp n -> A.R)
  (supp : (m : L.Exp n) -> (L.Mem (L.Exp n) m support -> Empty) -> Id A.R (f m) A.z)
  (u : E.Exp n)
  (polynomial : (m : L.Exp n) (i : Ps.Fin n) -> Laurent4[l].Neg (m i) -> Id A.R (f (CD.down n m u)) A.z) {
  raw (m : L.Exp n) : A.R=f (CD.down n m u) ;
  natural (v : E.Exp n) : A.R = raw (X.At[n].emb v) ;
  shifted (m : L.Exp n) : E.Exp n = CP.asNat n (CD.up n m u) ;
  nsupport : List (E.Exp n) = CP.mapL (L.Exp n) (E.Exp n) shifted support ;
  module MM = CP.MapMem[L.Exp n,E.Exp n,shifted] ; module NS = PA.Lists[E.Exp n] ;
  support-natural (v : E.Exp n) (out : NS.Mem v nsupport -> Empty) : Id A.R (natural v) A.z =
   supp (CD.down n (X.At[n].emb v) u) (\ h -> out
    (NS.mem-tr nsupport (shifted (CD.down n (X.At[n].emb v) u)) v
      (trans (ap (CP.asNat n) (CD.up-down n (X.At[n].emb v) u)) (CP.nat-emb n v))
      (MM.member support (CD.down n (X.At[n].emb v) u) h))) ;
  module SR = P.Supported[n,natural] ;
  representation : (x : (P.T.D n).R) * ((v : E.Exp n) -> Id A.R (P.Coeff n x v) (natural v)) = SR.represent nsupport support-natural ;
  cleared : (P.T.D n).R = representation.1 ;
  coefficients (v : E.Exp n) : Id A.R (P.Coeff n cleared v) (f (CD.down n (X.At[n].emb v) u)) = representation.2 v ;
  module Degree (k : Int) (hom : (m : L.Exp n) -> Not (Id Int (L.total n m) k) -> Id A.R (f m) A.z) {
   degree : Int = addP k (E.degree n u) ;
   module AtDegree (v : E.Exp n) {
    q : L.Exp n = CD.down n (X.At[n].emb v) u ;
    q-degree : Id Int (L.total n q) (PA.minus (pos (E.degree n v)) (E.degree n u)) =
     trans (X.deg-sub n (X.At[n].emb v) u) (ap (\ z -> PA.minus z (E.degree n u)) (CP.deg-emb n v)) ;
    restore (eq : Id Int (L.total n q) k) : Id Int (pos (E.degree n v)) degree =
     trans (sym (PA.addP-minus-cancel (pos (E.degree n v)) (E.degree n u)))
      (ap (\ z -> addP z (E.degree n u)) (trans (sym q-degree) eq)) ;
    off (ne : Id Int (pos (E.degree n v)) degree -> Base.Empty) : Id A.R (P.Coeff n cleared v) A.z =
     trans (coefficients v) (hom q (\ eq -> Pr.absurd Empty (ne (restore eq)))) ;
   } ;
   module PC = PolynomialCoefficientParts[l].Over[A,setA].At[n,degree] ;
   homogeneous : PC.L.Hom degree cleared = PC.homogeneous cleared (\ v -> AtDegree[v].off) ;
  } ;

  module LC=LP.Over[A,setA].At[n] ;
  cases (m : L.Exp n) : (sg : LP.Sign n m) -> Id A.R (LC.coeff cleared m) (raw m)=split {
   inl p -> trans (LC.positive cleared p.1 m p.2 (LP.classify n m))
     (trans (coefficients p.1) (ap (\v -> f (CD.down n v u)) p.2)) ;
   inr p -> trans (LC.coeff-neg cleared m p.1 p.2) (sym (polynomial m p.1 p.2)) } ;
  equation (m : L.Exp n) : Id A.R (LC.coeff cleared m) (f (CD.down n m u))=cases m (LP.classify n m) ;
 } ;
} ;
