-- Extract finite degree-lowering data from explicit corrected witnesses.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ; module L=GenericLaurent[l] ; module N=FiniteExponents[l] ;
module Faces=GenericSubsetFaces[l] ; module K=GenericDegree[l] ; module Tr=Truncation[l] ; module TC=TruncationCombinators[l] ;
module Over (A E : CRing) (setA : Pr.isSet A.R) (setE : Pr.isSet E.R) (iota : RingHom[l].Hom A E)
 (m : Nat) (y : Ps.Fin m -> E.R) (t : Nat) (b : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> FiniteLaurentAction[l].Over[A,setA,suc m].Polys) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,suc m].Hom (pos (e q)) (p q))
 (dehP : (q : Ps.Fin s) -> Id E.R (GenericDehomogenisation[l].Over[A,E,setA,iota,m,y].deh (p q)) E.z) {
 n : Nat=suc m ; module I=GenericExtractionInput[l].Over[A,E,setA,setE,iota,m,y,t,b,s,p,e,hp,dehP] ;
 module R=I.R ; module J=I.J ; module B0=I.B0 ; module B1=I.B1 ; module Q0=I.Q0 ; module Q1=I.Q1 ; module Data=I.Data ;
 module HR=HomogeneousRepresentatives[l].Over[A,setA,n] ; module AL=IP.ModL[A,IP.regular A] ; module LE=RL[E] ;
 module ZeroJ=R.Ideal[s,p,dehP] ;
 recombine (a b : A.R) : Id A.R (A.add a (A.add b (A.neg a))) b=
   trans (RL[A].add-swap a b (A.neg a)) (trans (ap (A.add b) (A.addN a)) (A.addZ b)) ;
 solve3 (a b c r : A.R) (eq : Id A.R (A.add (A.add a (A.neg b)) (A.neg c)) r) :
   Id A.R a (A.add b (A.add c r))=
   trans (sym (recombine b a)) (ap (A.add b) (trans (sym (recombine c (A.add a (A.neg b)))) (ap (A.add c) eq))) ;
 negative-shift : (b : Base.Nat) -> Id Int (addP (negsuc zero) (suc b)) (pos b)=split {
   zero -> refl (pos zero) ; suc b | rec -> ap sucZ rec } ;
 module Sec (z z0 : B0.Target.El)
  (hz0 : (v : L.Exp n) -> Id A.R (B0.Target.val z0 I.Z v) (R.LC.coeff R.R.o (R.V.addE v (NativeCoordinates[l].axis n (inr tt))))) {
  module Witness (closed : Q1.JW (I.DC.d.f z)) (reduction : Q0.IJW (suc zero) (Q0.ML.msub z z0)) {
   module W=I.Sec[z,z0,hz0].Witness[closed,reduction] ;
   module YC (q : Ps.Fin s) { module C=J.CE.Cochains[n,B1.ki q,K.topRank (suc (suc zero))] ; } ;
   module YPC (q : Ps.Fin s) { module C=J.CE.Cochains[n,B0.ki q,K.topRank (suc zero)] ; } ;
   module Support (S : List (L.Exp n))
    (sz : (chart : Sub n) (v : L.Exp n) -> Not (L.Mem (L.Exp n) v S) -> Id A.R (B0.Target.val z chart v) A.z)
    (sy : (q : Ps.Fin s) (chart : Sub n) (v : L.Exp n) -> Not (L.Mem (L.Exp n) v S) -> Id A.R (W.Y q chart v) A.z)
    (sx : (j : Ps.Fin t) (chart : Sub n) (v : L.Exp n) -> Not (L.Mem (L.Exp n) v S) -> Id A.R (B0.Target.val (W.xs j) chart v) A.z)
    (sy' : (q : Ps.Fin s) (chart : Sub n) (v : L.Exp n) -> Not (L.Mem (L.Exp n) v S) -> Id A.R (W.Y' q chart v) A.z) {
    module B=ExtractionBounds[l].Over[m,S] ; module Mon=B.Monomials[E,y] ;
    module PC=PrescribedChartClearing[l].Over[A] ; module PP=PrescribedPolynomialization[l].Over[A,setA] ;
    module ZClear=PC.Clearing[n,I.Z,S,B.LZ,B.ZChart.off,B.ZChart.dom].Function[B0.Target.val z I.Z,sz I.Z,
      \v bad -> B0.Target.M.van z I.Z v (inr (inl bad))] ;
    module CZ=PP.Clear[n,S,B0.Target.val z I.Z,sz I.Z,B.LZ,ZClear.polynomial] ;
    module DZ=CZ.Degree[negsuc zero,\v ne -> B0.Target.M.van z I.Z v (inl ne)] ;
    homS : HR.L.Hom (pos B.BZ) CZ.cleared=subst (\k -> HR.L.Hom k CZ.cleared)
      (trans (ap (addP (negsuc zero)) B.degree-Z) (negative-shift B.BZ)) DZ.homogeneous ;
    repS : Tr.Trunc[HR.Rep (pos B.BZ) CZ.cleared].carrier=HR.representative (pos B.BZ) CZ.cleared homS ;
    sv : E.R=R.DH.hom.1 CZ.cleared ;
    module Affine (i : Ps.Fin m) {
     module Clear=PC.Clearing[n,I.X i,S,B.Li i,B.IChart[i].off,B.IChart[i].dom].Function[B0.Target.val z (I.X i),sz (I.X i),
       \v bad -> B0.Target.M.van z (I.X i) v (inr (inl bad))] ;
     module C=PP.Clear[n,S,B0.Target.val z (I.X i),sz (I.X i),B.Li i,Clear.polynomial] ;
     module D=C.Degree[negsuc zero,\v ne -> B0.Target.M.van z (I.X i) v (inl ne)] ;
     homQ : HR.L.Hom (pos (B.Bi i)) C.cleared=subst (\k -> HR.L.Hom k C.cleared)
       (trans (ap (addP (negsuc zero)) (B.degree-i i)) (negative-shift (B.Bi i))) D.homogeneous ;
     repQ : Tr.Trunc[HR.Rep (pos (B.Bi i)) C.cleared].carrier=HR.representative (pos (B.Bi i)) C.cleared homQ ;
     module YClear (q : Ps.Fin s) {
      module Proof=PC.Clearing[n,I.edge i,S,B.LE i,B.Edge[i].off,B.Edge[i].dom].Function[W.Y q (I.edge i),sy q (I.edge i),
        \v bad -> YC[q].C.M.van (closed.1 q) (I.edge i) v (inr (inl bad))] ;
      module CY=PP.Clear[n,S,W.Y q (I.edge i),sy q (I.edge i),B.LE i,Proof.polynomial] ;
     } ;
     jsum : R.R.R=R.S.sum s (\q -> R.R.mul (R.P.phi n (p q)) YClear[q].CY.cleared) ;
     cf-J (v : L.Exp n) : Id A.R (R.LC.coeff jsum v)
       (A.add (B0.Target.val z (I.X i) (R.V.subE v (B.LE i))) (A.neg (B0.Target.val z I.Z (R.V.subE v (B.LE i)))))=
       trans (R.sum s (\q -> R.R.mul (R.P.phi n (p q)) YClear[q].CY.cleared) v)
         (trans (R.SA.sum-cong s
           (\q -> R.LC.coeff (R.R.mul (R.P.phi n (p q)) YClear[q].CY.cleared) v)
           (\q -> R.FA.mulP (p q) (W.Y q (I.edge i)) (R.V.subE v (B.LE i)))
           (\q -> R.polynomial-shift (p q) YClear[q].CY.cleared (W.Y q (I.edge i)) (B.LE i) YClear[q].CY.equation v))
           (sym (trans (sym (I.d-value z i (R.V.subE v (B.LE i)))) (W.hJ (I.edge i) (R.V.subE v (B.LE i)))))) ;
     lhs : R.R.R=R.R.mul (R.P.term n (A.o,B.LZ)) C.cleared ;
     rhs : R.R.R=R.R.add (R.R.mul (R.P.term n (A.o,B.Li i)) CZ.cleared) jsum ;
     cf-id (v : L.Exp n) : Id A.R (R.LC.coeff lhs v) (R.LC.coeff rhs v)=
       trans (R.shift B.LZ C.cleared v)
         (trans (C.equation (R.V.subE v B.LZ))
           (trans (ap (B0.Target.val z (I.X i)) (B.shift-both-commuted v i))
             (trans (sym (recombine (B0.Target.val z I.Z (R.V.subE v (B.LE i))) (B0.Target.val z (I.X i) (R.V.subE v (B.LE i)))))
               (trans (Ps.cong2 A.R A.add _ _ _ _
                 (sym (trans (R.shift (B.Li i) CZ.cleared v) (trans (CZ.equation (R.V.subE v (B.Li i))) (ap (B0.Target.val z I.Z) (B.shift-both v i)))))
                 (sym (cf-J v)))
                 (sym (R.LC.coeff-add (R.R.mul (R.P.term n (A.o,B.Li i)) CZ.cleared) jsum v)))))) ;
     left-eval : Id E.R (R.DH.hom.1 lhs) (R.DH.hom.1 C.cleared)=
       trans (R.eval-shift B.LZ C.cleared) (trans (ap (\a -> E.mul a (R.DH.hom.1 C.cleared)) Mon.value-Z) (LE.one-left (R.DH.hom.1 C.cleared))) ;
     right-eval : Id E.R (R.DH.hom.1 rhs) (E.mul sv (R.CO.M.P.power (y i) (B.ki i)))=
       trans (R.DH.hom.2.2.1 (R.R.mul (R.P.term n (A.o,B.Li i)) CZ.cleared) jsum)
         (trans (Ps.cong2 E.R E.add _ _ _ _
           (trans (R.eval-shift (B.Li i) CZ.cleared) (ap (\a -> E.mul a sv) (Mon.value-i i)))
           (ZeroJ.zero-sum s (\q -> q) (\q -> YClear[q].CY.cleared)))
           (trans (E.addZ (E.mul (R.CO.M.P.power (y i) (B.ki i)) sv)) (E.mulC (R.CO.M.P.power (y i) (B.ki i)) sv))) ;
     lower : Id E.R (E.mul sv (R.CO.M.P.power (y i) (B.ki i))) (R.DH.hom.1 C.cleared)=
       sym (trans (sym left-eval) (trans (R.evaluate lhs rhs cf-id) right-eval)) ;
    } ;
    module XClear (j : Ps.Fin t) {
     module Proof=PC.Clearing[n,I.Z,S,B.LZ,B.ZChart.off,B.ZChart.dom].Function[B0.Target.val (W.xs j) I.Z,sx j I.Z,
       \v bad -> B0.Target.M.van (W.xs j) I.Z v (inr (inl bad))] ;
     module C=PP.Clear[n,S,B0.Target.val (W.xs j) I.Z,sx j I.Z,B.LZ,Proof.polynomial] ;
    } ;
    module YPClear (q : Ps.Fin s) {
     module Proof=PC.Clearing[n,I.Z,S,B.LZ,B.ZChart.off,B.ZChart.dom].Function[W.Y' q I.Z,sy' q I.Z,
       \v bad -> YPC[q].C.M.van (reduction.2.2.1 q) I.Z v (inr (inl bad))] ;
     module C=PP.Clear[n,S,W.Y' q I.Z,sy' q I.Z,B.LZ,Proof.polynomial] ;
    } ;
    isum : R.R.R=R.S.sum t (\j -> R.R.mul (R.scalar (b j)) XClear[j].C.cleared) ;
    ysum : R.R.R=R.S.sum s (\q -> R.R.mul (R.P.phi n (p q)) YPClear[q].C.cleared) ;
    cf-I (v : L.Exp n) : Id A.R (R.LC.coeff isum v) (B0.Target.val W.x' I.Z (R.V.subE v B.LZ))=
      trans (R.sum t (\j -> R.R.mul (R.scalar (b j)) XClear[j].C.cleared) v)
        (trans (R.SA.sum-cong t
          (\j -> R.LC.coeff (R.R.mul (R.scalar (b j)) XClear[j].C.cleared) v)
          (\j -> A.mul (b j) (B0.Target.val (W.xs j) I.Z (R.V.subE v B.LZ)))
          (\j -> trans (R.coeff-scalar (b j) XClear[j].C.cleared v) (ap (A.mul (b j)) (XClear[j].C.equation v))))
          (sym (W.hx (R.V.subE v B.LZ)))) ;
    cf-Y (v : L.Exp n) : Id A.R (R.LC.coeff ysum v)
      (A.add (A.add (B0.Target.val z I.Z (R.V.subE v B.LZ)) (A.neg (B0.Target.val z0 I.Z (R.V.subE v B.LZ))))
        (A.neg (B0.Target.val W.x' I.Z (R.V.subE v B.LZ))))=
      trans (R.sum s (\q -> R.R.mul (R.P.phi n (p q)) YPClear[q].C.cleared) v)
        (trans (R.SA.sum-cong s
          (\q -> R.LC.coeff (R.R.mul (R.P.phi n (p q)) YPClear[q].C.cleared) v)
          (\q -> R.FA.mulP (p q) (W.Y' q I.Z) (R.V.subE v B.LZ))
          (\q -> R.polynomial-shift (p q) YPClear[q].C.cleared (W.Y' q I.Z) B.LZ YPClear[q].C.equation v))
          (sym (W.hY (R.V.subE v B.LZ)))) ;
    origin : R.R.R=R.P.term n (A.o,B.LZ0) ;
    rhsZ : R.R.R=R.R.add origin (R.R.add isum ysum) ;
    cf-Z (v : L.Exp n) : Id A.R (R.LC.coeff CZ.cleared v) (R.LC.coeff rhsZ v)=
      trans (CZ.equation v)
        (trans (solve3 (B0.Target.val z I.Z (R.V.subE v B.LZ)) (B0.Target.val z0 I.Z (R.V.subE v B.LZ))
          (B0.Target.val W.x' I.Z (R.V.subE v B.LZ))
          (R.SA.sum s (\q -> R.FA.mulP (p q) (W.Y' q I.Z) (R.V.subE v B.LZ))) (W.hY (R.V.subE v B.LZ)))
          (trans (Ps.cong2 A.R A.add _ _ _ _
            (trans (hz0 (R.V.subE v B.LZ))
              (trans (ap (R.LC.coeff R.R.o) (B.shift-oneZ v)) (sym (R.basis B.LZ0 v))))
            (Ps.cong2 A.R A.add _ _ _ _ (sym (cf-I v))
              (sym (trans (cf-Y v) (W.hY (R.V.subE v B.LZ))))))
            (sym (trans (R.LC.coeff-add origin (R.R.add isum ysum) v)
              (ap (A.add (R.LC.coeff origin v)) (R.LC.coeff-add isum ysum v)))))) ;
    vj (j : Ps.Fin t) : E.R=R.DH.hom.1 XClear[j].C.cleared ;
    origin-eval : Id E.R (R.DH.hom.1 origin) E.o=
      trans (R.eval-term B.LZ0) (CoordinateExponents[l].Monomials[E].zero-value m y) ;
    isum-eval : Id E.R (R.DH.hom.1 isum) (R.SE.lin t (\j -> iota.1 (b j)) vj)=
      trans (R.eval-sum t (\j -> R.R.mul (R.scalar (b j)) XClear[j].C.cleared))
        (R.SE.sum-cong t
          (\j -> R.DH.hom.1 (R.R.mul (R.scalar (b j)) XClear[j].C.cleared))
          (\j -> E.mul (iota.1 (b j)) (vj j))
          (\j -> trans (R.DH.hom.2.2.2 (R.scalar (b j)) XClear[j].C.cleared) (ap (\a -> E.mul a (vj j)) (R.eval-scalar (b j))))) ;
    congruence : Data.Ideal.Certificate sv E.o=(vj,
      trans (R.evaluate CZ.cleared rhsZ cf-Z)
        (trans (R.DH.hom.2.2.1 origin (R.R.add isum ysum))
          (trans (Ps.cong2 E.R E.add _ _ _ _ origin-eval
            (trans (R.DH.hom.2.2.1 isum ysum) (Ps.cong2 E.R E.add _ _ _ _ isum-eval
              (ZeroJ.zero-sum s (\q -> q) (\q -> YPClear[q].C.cleared)))))
            (ap (E.add E.o) (E.addZ (R.SE.lin t (\j -> iota.1 (b j)) vj)))))) ;
    module EP=ExtractionPolynomials[l].Over[A,E,setA,setE,iota,m,y] ;
    module Chosen (rs : HR.Rep (pos B.BZ) CZ.cleared)
      (qs : (i : Ps.Fin m) -> HR.Rep (pos (B.Bi i)) Affine[i].C.cleared) {
     valueS : Id E.R (R.CO.deh rs.1) sv=trans (sym (R.DH.read-phi rs.1)) (ap R.DH.hom.1 rs.2.1) ;
     valueQ (i : Ps.Fin m) : Id E.R (R.DH.hom.1 Affine[i].C.cleared) (R.CO.deh (qs i).1)=
       trans (sym (ap R.DH.hom.1 (qs i).2.1)) (R.DH.read-phi (qs i).1) ;
     input : Data.Data=Data.mkData sv B.BZ rs.1 (EP.hom-convert (pos B.BZ) rs.1 rs.2.2) valueS B.Bi
       (\i -> (qs i).1) (\i -> EP.hom-convert (pos (B.Bi i)) (qs i).1 (qs i).2.2)
       (\i -> trans Affine[i].lower (valueQ i)) congruence ;
    } ;
    QReps : U l=(i : Ps.Fin m) -> HR.Rep (pos (B.Bi i)) Affine[i].C.cleared ;
    qReps : Tr.Trunc[QReps].carrier=FinCat[l].fchoice m (\i -> HR.Rep (pos (B.Bi i)) Affine[i].C.cleared) (\i -> Affine[i].repQ) ;
    extracted : Tr.Trunc[Data.Data].carrier=TC.map2 (HR.Rep (pos B.BZ) CZ.cleared) QReps Data.Data (\rs qs -> Chosen[rs,qs].input) repS qReps ;
   } ;
  } ;
 } ;
} ;
