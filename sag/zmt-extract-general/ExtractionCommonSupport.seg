-- A single support list for four finite families, with explicit inclusions.
level l ; open Ring[l] ;
module L=GenericLaurent[l] ;
module Over (A : CRing) (E I J K H : U l) (f : I -> E -> A.R) (g : J -> E -> A.R)
 (h : K -> E -> A.R) (k : H -> E -> A.R) {
 module SC=FiniteChartChoice[l].Over[A,E] ;
 module Chosen (sf : SC.Witness I f) (sg : SC.Witness J g) (sh : SC.Witness K h) (sk : SC.Witness H k) {
  gh : List E=L.append E sg.1 (L.append E sh.1 sk.1) ; S : List E=L.append E sf.1 gh ;
  first (i : I) (v : E) (nm : Not (L.Mem E v S)) : Id A.R (f i v) A.z=sf.2 i v (\a -> nm (L.mem-left E v sf.1 gh a)) ;
  second (j : J) (v : E) (nm : Not (L.Mem E v S)) : Id A.R (g j v) A.z=sg.2 j v
    (\a -> nm (L.mem-right E v sf.1 gh (L.mem-left E v sg.1 (L.append E sh.1 sk.1) a))) ;
  third (j : K) (v : E) (nm : Not (L.Mem E v S)) : Id A.R (h j v) A.z=sh.2 j v
    (\a -> nm (L.mem-right E v sf.1 gh (L.mem-right E v sg.1 (L.append E sh.1 sk.1) (L.mem-left E v sh.1 sk.1 a)))) ;
  fourth (j : H) (v : E) (nm : Not (L.Mem E v S)) : Id A.R (k j v) A.z=sk.2 j v
    (\a -> nm (L.mem-right E v sf.1 gh (L.mem-right E v sg.1 (L.append E sh.1 sk.1) (L.mem-right E v sh.1 sk.1 a)))) ;
 } ;
} ;
