-- Evaluate identities of cleared polynomials directly in the actual
-- tower. No term-list representatives for J/ideal multipliers are chosen.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ; module L=GenericLaurent[l] ; module N=FiniteExponents[l] ;
module Over (A E : CRing) (setA : Pr.isSet A.R) (setE : Pr.isSet E.R) (iota : RingHom[l].Hom A E)
 (m : Nat) (y : Ps.Fin m -> E.R) {
 n : Nat=suc m ; module DH=GenericDehomCoefficientExt[l].Over[A,E,setA,setE,iota,m,y] ; module CO=DH.DH ;
 module P=DH.P ; R : CRing=P.T.D n ; module LC=LaurentPolynomialCoefficients[l].Over[A,setA].At[n] ;
 module TA=TowerLaurentAction[l].Over[A,setA] ; module V=LaurentExponentBridge[l].At[n] ;
 module FA=FiniteLaurentAction[l].Over[A,setA,n] ; module S=Comb[l].Sums[R,IP.regular R] ;
 module SE=FiniteIdeal[l].Sums[E] ; module SA=Comb[l].Sums[A,IP.regular A] ; module LE=RL[E] ;
 ext (x x' : R.R) (h : (v : L.Exp n) -> Id A.R (LC.coeff x v) (LC.coeff x' v)) : Id R.R x x'=
   P.ext n x x' (\u -> trans (sym (LC.coeff-emb x u)) (trans (h (V.emb u)) (LC.coeff-emb x' u))) ;
 evaluate (x x' : R.R) (h : (v : L.Exp n) -> Id A.R (LC.coeff x v) (LC.coeff x' v)) : Id E.R (DH.hom.1 x) (DH.hom.1 x')=ap DH.hom.1 (ext x x' h) ;
 term (c : A.R) (u : N.Exp n) (x : R.R) (v : L.Exp n) :
   Id A.R (LC.coeff (R.mul (P.term n (c,u)) x) v) (A.mul c (LC.coeff x (V.subE v u)))=
   trans (sym (TA.psi-coeff n (R.mul (P.term n (c,u)) x) v))
     (trans (TA.term-mul n (c,u) x v) (ap (A.mul c) (TA.psi-coeff n x (V.subE v u)))) ;
 shift (u : N.Exp n) (x : R.R) (v : L.Exp n) : Id A.R (LC.coeff (R.mul (P.term n (A.o,u)) x) v) (LC.coeff x (V.subE v u))=
   trans (term A.o u x v) (RL[A].one-left (LC.coeff x (V.subE v u))) ;
 polynomial (p : FA.Polys) (x : R.R) (v : L.Exp n) : Id A.R (LC.coeff (R.mul (P.phi n p) x) v) (FA.mulP p (LC.coeff x) v)=sym (TA.At[n].action p x v) ;
 polynomial-shift (p : FA.Polys) (x : R.R) (f : L.Exp n -> A.R) (u : N.Exp n)
   (eq : (v : L.Exp n) -> Id A.R (LC.coeff x v) (f (V.subE v u))) (v : L.Exp n) :
   Id A.R (LC.coeff (R.mul (P.phi n p) x) v) (FA.mulP p f (V.subE v u))=
   trans (polynomial p x v) (trans (FA.mulP-cong p (LC.coeff x) (\v -> f (V.subE v u)) eq v)
     (FA.mulP-shift (\v -> V.subE v u) (\v a -> V.sub-comm v u a) p f v)) ;
 basis (u : N.Exp n) (v : L.Exp n) : Id A.R (LC.coeff (P.term n (A.o,u)) v) (LC.coeff R.o (V.subE v u))=
   trans (ap (\x -> LC.coeff x v) (sym (R.mulO (P.term n (A.o,u))))) (shift u R.o v) ;
 sum : (r : Nat) (xs : Ps.Fin r -> R.R) (v : L.Exp n) -> Id A.R (LC.coeff (S.sum r xs) v) (SA.sum r (\i -> LC.coeff (xs i) v))=split {
   zero -> \xs v -> LC.coeff-zero v ; suc r | rec -> \xs v -> trans (LC.coeff-add (xs (inr tt)) (S.sum r (\i -> xs (inl i))) v)
     (ap (A.add (LC.coeff (xs (inr tt)) v)) (rec (\i -> xs (inl i)) v)) } ;
 eval-sum : (r : Nat) (xs : Ps.Fin r -> R.R) -> Id E.R (DH.hom.1 (S.sum r xs)) (SE.sum r (\i -> DH.hom.1 (xs i)))=split {
   zero -> \xs -> RingHom[l].zero R E DH.hom ; suc r | rec -> \xs -> trans (DH.hom.2.2.1 (xs (inr tt)) (S.sum r (\i -> xs (inl i))))
     (ap (E.add (DH.hom.1 (xs (inr tt)))) (rec (\i -> xs (inl i)))) } ;
 eval-term (u : N.Exp n) : Id E.R (DH.hom.1 (P.term n (A.o,u))) (CO.mon u)=
   trans (DH.read-term A.o u) (trans (ap (\a -> E.mul a (CO.mon u)) iota.2.1) (LE.one-left (CO.mon u))) ;
 eval-shift (u : N.Exp n) (x : R.R) : Id E.R (DH.hom.1 (R.mul (P.term n (A.o,u)) x)) (E.mul (CO.mon u) (DH.hom.1 x))=
   trans (DH.hom.2.2.2 (P.term n (A.o,u)) x) (ap (\a -> E.mul a (DH.hom.1 x)) (eval-term u)) ;
 scalar (c : A.R) : R.R=(P.T.grD n).iota.1 c ;
 eval-scalar (c : A.R) : Id E.R (DH.hom.1 (scalar c)) (iota.1 c)=
   trans (ap DH.hom.1 (sym (GenericPolynomialRingLaws[l].Over[A,setA].term-zero n c)))
     (trans (DH.read-term c (N.zeroE n)) (trans (ap (E.mul (iota.1 c)) (CoordinateExponents[l].Monomials[E].zero-value m y)) (E.mulO (iota.1 c)))) ;
 coeff-scalar (c : A.R) (x : R.R) (v : L.Exp n) : Id A.R (LC.coeff (R.mul (scalar c) x) v) (A.mul c (LC.coeff x v))=
   trans (ap (\a -> LC.coeff (R.mul a x) v) (sym (GenericPolynomialRingLaws[l].Over[A,setA].term-zero n c)))
     (trans (term c (N.zeroE n) x v) (ap (A.mul c) (ap (LC.coeff x) (V.ext _ _ (\i -> refl (v i)))))) ;
 module Ideal (r : Nat) (p : Ps.Fin r -> FA.Polys) (van : (i : Ps.Fin r) -> Id E.R (CO.deh (p i)) E.z) {
   zero-product (i : Ps.Fin r) (x : R.R) : Id E.R (DH.hom.1 (R.mul (P.phi n (p i)) x)) E.z=
     trans (DH.hom.2.2.2 (P.phi n (p i)) x)
       (trans (ap (\a -> E.mul a (DH.hom.1 x)) (trans (DH.read-phi (p i)) (van i))) (LE.zero-mul (DH.hom.1 x))) ;
   zero-sum : (a : Nat) (ix : Ps.Fin a -> Ps.Fin r) (xs : Ps.Fin a -> R.R) ->
     Id E.R (DH.hom.1 (S.sum a (\i -> R.mul (P.phi n (p (ix i))) (xs i)))) E.z=split {
     zero -> \ix xs -> RingHom[l].zero R E DH.hom ;
     suc a | rec -> \ix xs -> trans (DH.hom.2.2.1 (R.mul (P.phi n (p (ix (inr tt)))) (xs (inr tt))) (S.sum a (\i -> R.mul (P.phi n (p (ix (inl i)))) (xs (inl i)))))
       (trans (Ps.cong2 E.R E.add _ _ _ _ (zero-product (ix (inr tt)) (xs (inr tt))) (rec (\i -> ix (inl i)) (\i -> xs (inl i)))) (E.addZ E.z)) } ;
 } ;
} ;
