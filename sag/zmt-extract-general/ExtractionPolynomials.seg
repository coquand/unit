-- Full coefficient equality implies dehomogenization equality. Prescribed
-- clearings have merely homogeneous term-list representatives.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module L=GenericLaurent[l] ; module N=FiniteExponents[l] ;
module Tr=Truncation[l] ; module TC=TruncationCombinators[l] ; module IP=IdealPowers[l] ;
module Over (A E : CRing) (setA : Pr.isSet A.R) (setE : Pr.isSet E.R) (iota : RingHom[l].Hom A E)
 (m : Nat) (y : Ps.Fin m -> E.R) {
 n : Nat=suc m ; module DH=GenericDehomCoefficientExt[l].Over[A,E,setA,setE,iota,m,y] ; module CO=DH.DH ;
 module CF=ExtractionCoefficientLaws[l].Over[A,setA,n] ; module FA=CF.FA ; module V=CF.V ; module LE=RL[E] ;
 module HR=HomogeneousRepresentatives[l].Over[A,setA,n] ; module C=CechPolynomialAction[l].Over[A,setA,n] ;
 module S=FiniteIdeal[l].Sums[E] ;
 deh-cf (p q : FA.Polys) (eq : (v : L.Exp n) -> Id A.R (CF.cf p v) (CF.cf q v)) : Id E.R (CO.deh p) (CO.deh q)=
   DH.coefficient-ext p q (\u -> trans (sym (CF.LC.coeff-emb (CF.P.phi n p) u))
     (trans (eq (V.emb u)) (CF.LC.coeff-emb (CF.P.phi n q) u))) ;
 deh-shift (u : N.Exp n) (p : FA.Polys) : Id E.R (CO.deh (FA.scaleT (A.o,u) p)) (E.mul (CO.mon u) (CO.deh p))=
   trans (CO.deh-scale (A.o,u) p) (ap (\x -> E.mul x (CO.deh p))
     (trans (ap (\a -> E.mul a (CO.mon u)) iota.2.1) (LE.one-left (CO.mon u)))) ;
 deh-sum : (r : Nat) (p : Ps.Fin r -> FA.Polys) -> Id E.R (CO.deh (FA.psum r p)) (S.sum r (\i -> CO.deh (p i)))=split {
   zero -> \p -> refl E.z ; suc r | rec -> \p -> trans (CO.deh-app (p (inr tt)) (FA.psum r (\i -> p (inl i))))
     (ap (E.add (CO.deh (p (inr tt)))) (rec (\i -> p (inl i)))) } ;
 hom-convert (k : Int) : (p : FA.Polys) -> HR.Hom k p -> C.Hom k p=split {
   nil -> \h -> tt ; cons t p | rec -> \h -> (h.1,rec h.2) } ;
 module HP (support : List (L.Exp n)) (f : L.Exp n -> A.R)
  (supp : (v : L.Exp n) -> Not (L.Mem (L.Exp n) v support) -> Id A.R (f v) A.z)
  (u : N.Exp n) (polynomial : (v : L.Exp n) (i : Ps.Fin n) -> Laurent4[l].Neg (v i) -> Id A.R (f (V.subE v u)) A.z)
  (k : Int) (hom : (v : L.Exp n) -> Not (Id Int (L.total n v) k) -> Id A.R (f v) A.z) {
   module CP=PrescribedPolynomialization[l].Over[A,setA].Clear[n,support,f,supp,u,polynomial] ;
   module Deg=CP.Degree[k,hom] ;
   module Degree (d : Base.Nat) (eq : Id Int Deg.degree (pos d)) {
     homogeneous : HR.L.Hom (pos d) CP.cleared=subst (\k -> HR.L.Hom k CP.cleared) eq Deg.homogeneous ;
     representatives : Tr.Trunc[HR.Rep (pos d) CP.cleared].carrier=HR.representative (pos d) CP.cleared homogeneous ;
     module Chosen (r : HR.Rep (pos d) CP.cleared) {
       T : FA.Polys=r.1 ; homT : C.Hom (pos d) T=hom-convert (pos d) T r.2.2 ;
       coefficients (v : L.Exp n) : Id A.R (CF.cf T v) (f (V.subE v u))=
         trans (ap (\x -> CF.LC.coeff x v) r.2.1) (CP.equation v) ;
     } ;
   } ;
 } ;
} ;
