-- Corrected-section input and its finite explicit witnesses, with the
-- newest Z coordinate and structural pair orientation affine-minus-Z.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ; module L=GenericLaurent[l] ; module N=FiniteExponents[l] ;
module Faces=GenericSubsetFaces[l] ; module K=GenericDegree[l] ; module Tr=Truncation[l] ; module TC=TruncationCombinators[l] ;
module Over (A E : CRing) (setA : Pr.isSet A.R) (setE : Pr.isSet E.R) (iota : RingHom[l].Hom A E)
 (m : Nat) (y : Ps.Fin m -> E.R) (t : Nat) (b : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> FiniteLaurentAction[l].Over[A,setA,suc m].Polys) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,suc m].Hom (pos (e q)) (p q))
 (dehP : (q : Ps.Fin s) -> Id E.R (GenericDehomogenisation[l].Over[A,E,setA,iota,m,y].deh (p q)) E.z) {
 n : Nat=suc m ; module R=ExtractionRingLaws[l].Over[A,E,setA,setE,iota,m,y] ; module CF=ExtractionCoefficientLaws[l].Over[A,setA,n] ;
 module J=GenericReesChart[l].Over[A,setA,n,t,b,s,p,e,hp] ; module B0=J.At[negsuc zero,K.topRank (suc zero)] ; module Q0=B0.Q ;
 module B1=J.At[negsuc zero,K.topRank (suc (suc zero))] ; module Q1=B1.Q ;
 module DC=GenericCechTheorems[l].Over[A,setA].Linear[n,negsuc zero,K.topRank (suc zero)] ;
 module SC=FiniteChartChoice[l].Over[A,L.Exp n] ;
 module CS0=GenericChartErrorAssembly[l].ChartSums[A,setA,L.Exp n,Sub n,GenericCech[l].Bad n (negsuc zero) (K.topRank (suc zero))] ;
 module CS1=GenericChartErrorAssembly[l].ChartSums[A,setA,L.Exp n,Sub n,GenericCech[l].Bad n (negsuc zero) (K.topRank (suc (suc zero)))] ;
 module Data=GenericDegreeLoweringData[l].Over[A,setA,E,setE,iota,m,y,t,b] ;
 Z : Sub n=Faces.singleton n (inr tt) ; X (i : Ps.Fin m) : Sub n=Faces.singleton n (inl i) ;
 edge (i : Ps.Fin m) : Sub n=Faces.pairSet n (inr i) ;
 d-value (z : B0.Target.El) (i : Ps.Fin m) (v : L.Exp n) :
   Id A.R (B1.Target.val (DC.d.f z) (edge i) v) (A.add (B0.Target.val z (X i) v) (A.neg (B0.Target.val z Z v)))=
   trans (GenericSectionAssembly[l].Differential[A,setA,n].raw z (edge i) v)
     (Faces.Differential[A,setA].pair-value n (\chart -> B0.Target.val z chart v) (inr i)) ;
 module Sec (z z0 : B0.Target.El)
  (hz0 : (v : L.Exp n) -> Id A.R (B0.Target.val z0 Z v) (R.LC.coeff R.R.o (R.V.addE v (NativeCoordinates[l].axis n (inr tt))))) {
  module Witness (closed : Q1.JW (DC.d.f z)) (reduction : Q0.IJW (suc zero) (Q0.ML.msub z z0)) {
   Y (q : Ps.Fin s) : Sub n -> L.Exp n -> A.R=J.CE.Cochains[n,B1.ki q,K.topRank (suc (suc zero))].val (closed.1 q) ;
   Y' (q : Ps.Fin s) : Sub n -> L.Exp n -> A.R=J.CE.Cochains[n,B0.ki q,K.topRank (suc zero)].val (reduction.2.2.1 q) ;
   xs (j : Ps.Fin t) : B0.Target.El=reduction.2.1.1 j ;
   hJ (chart : Sub n) (v : L.Exp n) : Id A.R (B1.Target.val (DC.d.f z) chart v)
     (R.SA.sum s (\q -> R.FA.mulP (p q) (Y q chart) v))=
     trans (ap (\x -> B1.Target.val x chart v) closed.2) (CS1.value s (\q -> (B1.entry q).f (closed.1 q)) chart v) ;
   x' : B0.Target.El=reduction.1 ;
   hx (v : L.Exp n) : Id A.R (B0.Target.val x' Z v) (R.SA.sum t (\j -> A.mul (b j) (B0.Target.val (xs j) Z v)))=
     trans (ap (\x -> B0.Target.val x Z v) reduction.2.1.2.2) (CS0.value t (\j -> B0.Target.mod.sm (b j) (xs j)) Z v) ;
   hY (v : L.Exp n) : Id A.R (A.add (A.add (B0.Target.val z Z v) (A.neg (B0.Target.val z0 Z v))) (A.neg (B0.Target.val x' Z v)))
     (R.SA.sum s (\q -> R.FA.mulP (p q) (Y' q Z) v))=
     trans (ap (\x -> B0.Target.val x Z v) reduction.2.2.2) (CS0.value s (\q -> (B0.entry q).f (reduction.2.2.1 q)) Z v) ;
  } ;
 } ;
} ;
