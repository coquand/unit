-- Coefficient identities for finite term lists in arbitrary coordinates.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module IP=IdealPowers[l] ; module L=GenericLaurent[l] ; module N=FiniteExponents[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module P=PolynomialTowerBridge[l].Over[A,setA] ; module Sums=Comb[l].Sums[A,IP.regular A] ;
 module V=LaurentExponentBridge[l].At[n] ; module FA=FiniteLaurentAction[l].Over[A,setA,n] ;
 module LC=LaurentPolynomialCoefficients[l].Over[A,setA].At[n] ; module TA=TowerLaurentAction[l].Over[A,setA] ;
 module PP=PolynomialTowerProducts[l].Over[A,setA,n] ; module G=GenericPolynomialRingLaws[l].Over[A,setA].At[n] ;
 cf (p : FA.Polys) (m : L.Exp n) : A.R=LC.coeff (P.phi n p) m ;
 append (p q : FA.Polys) (m : L.Exp n) : Id A.R (cf (Bar[l].app p q) m) (A.add (cf p m) (cf q m))=
   trans (ap (\x -> LC.coeff x m) (PP.append p q)) (LC.coeff-add (P.phi n p) (P.phi n q) m) ;
 product (p q : FA.Polys) (m : L.Exp n) : Id A.R (cf (FA.pmul p q) m) (FA.mulP p (cf q) m)=
   trans (ap (\x -> LC.coeff x m) (PP.product p q)) (sym (TA.At[n].action p (P.phi n q) m)) ;
 scale (c : A.R) (u : N.Exp n) (p : FA.Polys) (m : L.Exp n) :
   Id A.R (cf (FA.scaleT (c,u) p) m) (A.mul c (cf p (V.subE m u)))=
   trans (ap (\x -> LC.coeff x m) (G.phi-scaleT (c,u) p))
     (trans (sym (TA.psi-coeff n ((P.T.D n).mul (P.term n (c,u)) (P.phi n p)) m))
       (trans (TA.term-mul n (c,u) (P.phi n p) m) (ap (A.mul c) (TA.psi-coeff n (P.phi n p) (V.subE m u))))) ;
 shift (u : N.Exp n) (p : FA.Polys) (m : L.Exp n) : Id A.R (cf (FA.scaleT (A.o,u) p) m) (cf p (V.subE m u))=
   trans (scale A.o u p m) (RL[A].one-left (cf p (V.subE m u))) ;
 single (c : A.R) (u : N.Exp n) (m : L.Exp n) :
   Id A.R (cf (cons (c,u) nil) m) (A.mul c (LC.coeff (P.T.D n).o (V.subE m u)))=
   trans (ap (\x -> LC.coeff x m) (G.phi-single (c,u)))
     (trans (ap (\x -> LC.coeff x m) (sym ((P.T.D n).mulO (P.term n (c,u)))))
       (trans (sym (TA.psi-coeff n ((P.T.D n).mul (P.term n (c,u)) (P.T.D n).o) m))
         (trans (TA.term-mul n (c,u) (P.T.D n).o m) (ap (A.mul c) (TA.psi-coeff n (P.T.D n).o (V.subE m u)))))) ;
 sum : (r : Nat) (ps : Ps.Fin r -> FA.Polys) (m : L.Exp n) ->
   Id A.R (cf (FA.psum r ps) m) (Sums.sum r (\i -> cf (ps i) m))=split {
   zero -> \ps m -> LC.coeff-zero m ; suc r | rec -> \ps m -> trans (append (ps (inr tt)) (FA.psum r (\i -> ps (inl i))) m)
     (ap (A.add (cf (ps (inr tt)) m)) (rec (\i -> ps (inl i)) m)) } ;
} ;
