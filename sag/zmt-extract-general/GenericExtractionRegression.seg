-- Actual extraction regressions: no affine variables, and corrected
-- five-coordinate sections from arbitrary four-variable residual data.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr=Prelude[l] ; module Ps=Presentations[l] ; module Tr=Truncation[l] ; module TC=TruncationCombinators[l] ; module L=GenericLaurent[l] ;
module EmptyAffine (A : CRing) (setA : Pr.isSet A.R) {
 module D=GenericSectionRegressionData[l].Point[A,setA,zero] ; module S=GenericFiniteFibreSections[l].Over[A,setA,zero,D.D0] ;
 y (i : Ps.Fin zero) : A.R=absurd A.R i ;
 dehP (i : Ps.Fin zero) : Id A.R (GenericDehomogenisation[l].Over[A,A,setA,RingHom[l].identity A,zero,y].deh (S.ST.P i)) A.z=
   absurd (Id A.R (GenericDehomogenisation[l].Over[A,A,setA,RingHom[l].identity A,zero,y].deh (S.ST.P i)) A.z) i ;
 module X=GenericSectionExtraction[l].Over[A,A,setA,setA,RingHom[l].identity A,zero,y,zero,D.D0.b,zero,S.ST.P,S.ST.e,S.hpC,dehP] ;
 z : X.B0.Target.El=S.z zero ;
 no-pair : GenericSubsetFaces[l].Pair (suc zero) -> Empty=split { inl e -> e ; inr e -> e } ;
 closed-eq : Id S.CJ1.Target.M (S.d.f z) S.CJ1.Target.mz=S.C.CS1.ext _ _
   (\e v -> absurd (Id A.R (S.Edges.CJ.Target.val (S.d.f z) (GenericSubsetFaces[l].pairSet (suc zero) e) v) A.z) (no-pair e)) ;
 closed : X.Q1.InJ (X.I.DC.d.f z)=X.Q1.in-of _ (subst X.Q1.JW (sym closed-eq) X.Q1.jw-zero) ;
 hz (v : L.Exp (suc zero)) : Id A.R (X.B0.Target.val z X.I.Z v)
   (X.I.R.LC.coeff X.I.R.R.o (X.I.R.V.addE v (NativeCoordinates[l].axis (suc zero) (inr tt))))=
   trans (S.hz0 v) (TowerLaurentAction[l].Over[A,setA].psi-coeff (suc zero) X.I.R.R.o
     (X.I.R.V.addE v (NativeCoordinates[l].axis (suc zero) (inr tt)))) ;
 extracted : Tr.Trunc[X.Data.Data].carrier=X.Sec[z,z,hz].extract closed (S.compatibility zero) ;
} ;
four : Nat=suc (suc (suc (suc zero))) ; two : Nat=suc (suc zero) ;
module Five (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfn : CFN[l].CFN[K0,A])
 (D0 : ResidualAlgebra[l].Residual[A,setA,four]) {
 module C=GenericCorrectedSections[l].Over[K0,A,setA,cfn,two,D0] ; module S=C.S ; module ST=C.ST ;
 module X=GenericSectionExtraction[l].Over[A,ST.E,setA,ST.setE,ST.iota,four,ST.FD.y,D0.t,D0.b,four,ST.P,ST.e,S.hpC,ST.deh-P] ;
 hz (v : L.Exp (suc four)) : Id A.R (X.B0.Target.val (S.z zero) X.I.Z v)
   (X.I.R.LC.coeff X.I.R.R.o (X.I.R.V.addE v (NativeCoordinates[l].axis (suc four) (inr tt))))=
   trans (S.hz0 v) (TowerLaurentAction[l].Over[A,setA].psi-coeff (suc four) X.I.R.R.o
     (X.I.R.V.addE v (NativeCoordinates[l].axis (suc four) (inr tt)))) ;
 extracted : Tr.Trunc[X.Data.Data].carrier=TC.bind C.Corrected X.Data.Data
   (\h -> X.Sec[h.1,S.z zero,hz].extract h.2.1 h.2.2) C.correction ;
} ;
