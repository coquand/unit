-- Public endpoint, with finite presentation and integrality given only
-- under truncation. All choices are eliminated into the mere result.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (cs : List R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module FE = FormallyEtale[l].Over[R,setR] ; module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 module PF = PolynomialFractions[l].Over[R,setR] ; module Mon = HorrocksInterface[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ; G : B.Carrier = B.include cs ;
 module At (E : C.Algebra) (y : E.ring.R) (full : PF.At[E,y,G].Full) (unique : FE.Unique E) {
  module X = SE.At[E.ring,E.set,E.iota,y] ;
  Integral : U l = (lower : List R.R) * Id E.ring.R (X.value (Mon.monic lower)) E.ring.z ;
  Result : U l+ = (loc : I.LocalizationWitness E (X.value G)) * (lower : List R.R) *
   (denominator : B.Carrier) * SE.Points[Mon.monic lower,denominator].Standard loc.1 ;
  module Presented (p : P.Presentation) (pe : P.Presents p E) {
   module Given (w : Integral) {
    module Local = LocalMonogenicStandard[l].Over[R,setR,cs].At[E,p,pe,y,w.1,w.2,full,unique] ;
    theorem (smooth : FE.Lift E) : Tr1.Trunc[Result].carrier = Local.theorem smooth ;
   } ;
   theorem (integral : Tr.Trunc[Integral].carrier) (smooth : FE.Lift E) : Tr1.Trunc[Result].carrier =
    TC.rec Integral @l+ (Tr1.Trunc[Result].carrier) Tr1.Trunc[Result].proposition
     (\ w -> Given[w].theorem smooth) integral ;
  } ;
  theorem (fp : P.FP E) (integral : Tr.Trunc[Integral].carrier) (smooth : FE.Lift E) : Tr1.Trunc[Result].carrier =
   Tr1.Trunc[P.Witness E].induction @l+ (\ p -> Tr1.Trunc[Result].carrier) (\ p -> Tr1.Trunc[Result].proposition)
    (\ p -> Presented[p.1,p.2].theorem integral smooth) fp ;
  flat-theorem (fp : P.FP E) (integral : Tr.Trunc[Integral].carrier)
   (flat : FlatRelations[l].Over[R,E.ring,E.iota].Flat) : Tr1.Trunc[Result].carrier =
   theorem fp integral FlatUnramifiedEtale[l].Over[R,setR].At[E,fp,unique,flat].lift ;
 } ;
} ;
