-- A surjection between finitely presented algebras has a finitely
-- generated kernel. Only finite choices of preimages are made.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module PK = PresentationKernel[l].Over[R,setR] ; module GS = Generated[l].Over[R,setR] ;
 module At (S T : C.Algebra) (ps pt : P.Presentation)
  (sp : P.Presents ps S) (tp : P.Presents pt T) (u : C.Hom S T) {
  Preimage (t : T.ring.R) : U l = (s : S.ring.R) * Id T.ring.R (u.1.1 s) t ;
  record Certificate {
   number : Nat ; generator : Fin number -> S.ring.R ;
   killed : (i : Fin number) -> Id T.ring.R (u.1.1 (generator i)) T.ring.z ;
   generates : (s : S.ring.R) -> Id T.ring.R (u.1.1 s) T.ring.z ->
    Tr.Trunc[FiniteGeneratedIdeal[l].Over[S.ring,number,generator].Certificate s].carrier ;
  } ;
  module Chosen (pre : (i : Fin pt.1) -> Preimage (tp.1.1 i))
   (rep : (j : Fin ps.1) -> GS.Representation pt T tp (u.1.1 (sp.1.1 j))) {
   sigma (i : Fin pt.1) : S.ring.R = (pre i).1 ;
   sigma-map (i : Fin pt.1) : Id T.ring.R (u.1.1 (sigma i)) (tp.1.1 i) = (pre i).2 ;
   evaluation (e : P.Expr (Fin pt.1)) :
    Id T.ring.R (u.1.1 (P.eval (Fin pt.1) S sigma e)) (P.eval (Fin pt.1) T tp.1.1 e) =
    trans (P.natural (Fin pt.1) S T u sigma e)
     (GS.eval-ext (Fin pt.1) T (\ i -> u.1.1 (sigma i)) tp.1.1 sigma-map e) ;
   m : Nat = len {P.Expr (Fin pt.1)} pt.2 ;
   relation (i : Fin m) : P.Expr (Fin pt.1) = PK.at (Fin pt.1) pt.2 i ;
   Zero : U l = (a : S.ring.R) * Id T.ring.R (u.1.1 a) T.ring.z ;
   equations (i : Fin m) : Zero =
    (P.eval (Fin pt.1) S sigma (relation i),trans (evaluation (relation i))
     (PK.zeros-indexed (Fin pt.1) T tp.1.1 pt.2 tp.1.2 i)) ;
   recover (j : Fin ps.1) : Zero =
    (S.ring.add (sp.1.1 j) (S.ring.neg (P.eval (Fin pt.1) S sigma (rep j).1)),
     trans (u.1.2.2.1 (sp.1.1 j) (S.ring.neg (P.eval (Fin pt.1) S sigma (rep j).1)))
      (trans (ap (T.ring.add (u.1.1 (sp.1.1 j)))
       (trans (H.negation S.ring T.ring u.1 (P.eval (Fin pt.1) S sigma (rep j).1))
        (ap T.ring.neg (trans (evaluation (rep j).1) (rep j).2))))
       (T.ring.addN (u.1.1 (sp.1.1 j))))) ;
   number : Nat = plus ps.1 m ;
   zeros : Fin number -> Zero = FinSum[l].cases m Zero equations ps.1 recover ;
   generator (i : Fin number) : S.ring.R = (zeros i).1 ;
   killed (i : Fin number) : Id T.ring.R (u.1.1 (generator i)) T.ring.z = (zeros i).2 ;
   module Q = FiniteEquationQuotient[l].Over[S.ring,number,generator] ;
   A : C.Algebra = C.mkAlgebra Q.Q.ring Q.Q.set (H.compose R S.ring Q.Q.ring Q.Q.projection S.iota) ;
   pi : C.Hom S A = (Q.Q.projection,\ r -> refl (Q.Q.include (S.iota.1 r))) ;
   equation-in (i : Fin m) : Q.I.In (equations i).1 =
    subst Q.I.In (ap (\ w -> w.1) (FinSum[l].cases-left m Zero equations ps.1 recover i))
     (Q.I.generator (FinSum[l].left m ps.1 i)) ;
   recover-in (j : Fin ps.1) : Q.I.In (recover j).1 =
    subst Q.I.In (ap (\ w -> w.1) (FinSum[l].cases-right m Zero equations ps.1 recover j))
     (Q.I.generator (FinSum[l].right m ps.1 j)) ;
   variables (i : Fin pt.1) : A.ring.R = Q.Q.include (sigma i) ;
   equations-zero (i : Fin m) : Id A.ring.R (P.eval (Fin pt.1) A variables (relation i)) A.ring.z =
    trans (sym (P.natural (Fin pt.1) S A pi sigma (relation i)))
     (Q.Q.to-zero (equations i).1 (equation-in i)) ;
   solution : P.Solutions pt A =
    (variables,PK.indexed-zeros (Fin pt.1) A variables pt.2 equations-zero) ;
   psi : C.Hom T A = (tp.2 A).sec solution ;
   psi-gen (i : Fin pt.1) : Id A.ring.R (psi.1.1 (tp.1.1 i)) (variables i) =
    ap (\ s -> s.1 i) ((tp.2 A).sec-eq solution) ;
   psi-expression (e : P.Expr (Fin pt.1)) :
    Id A.ring.R (psi.1.1 (P.eval (Fin pt.1) T tp.1.1 e)) (Q.Q.include (P.eval (Fin pt.1) S sigma e)) =
    trans (P.natural (Fin pt.1) T A psi tp.1.1 e)
     (trans (GS.eval-ext (Fin pt.1) A (\ i -> psi.1.1 (tp.1.1 i)) variables psi-gen e)
      (sym (P.natural (Fin pt.1) S A pi sigma e))) ;
   recover-equal (j : Fin ps.1) : Id A.ring.R (Q.Q.include (sp.1.1 j))
    (Q.Q.include (P.eval (Fin pt.1) S sigma (rep j).1)) =
    Q.Q.Q.relates (sp.1.1 j) (P.eval (Fin pt.1) S sigma (rep j).1) (recover-in j) ;
   composite : Id (C.Hom S A) (C.compose S T A psi u) pi =
    Tensor[l].Over[R,setR].hom-eq ps S sp A _ _
     (\ j -> trans (ap psi.1.1 (sym (rep j).2))
      (trans (psi-expression (rep j).1) (sym (recover-equal j)))) ;
   generates (s : S.ring.R) (hs : Id T.ring.R (u.1.1 s) T.ring.z) : Tr.Trunc[Q.I.Certificate s].carrier =
    Q.Q.kernel s (trans (sym (ap (\ h -> h.1.1 s) composite))
     (trans (ap psi.1.1 hs) (H.zero T.ring A.ring psi.1))) ;
   certificate : Certificate = new Certificate[number,generator,killed,generates] ;
  } ;
  module Surjective (surj : (t : T.ring.R) -> Tr.Trunc[Preimage t].carrier) {
   Reps : U l = (j : Fin ps.1) -> GS.Representation pt T tp (u.1.1 (sp.1.1 j)) ;
   Pre : U l = (i : Fin pt.1) -> Preimage (tp.1.1 i) ;
   module GT = GS.Generated[pt,T,tp] ;
   theorem : Tr.Trunc[Certificate].carrier =
    TC.map2 Pre Reps Certificate (\ pre rep -> Chosen[pre,rep].certificate)
     (AffineFinite[l].choice pt.1 (\ i -> Preimage (tp.1.1 i)) (\ i -> surj (tp.1.1 i)))
     (GT.generated-family ps.1 (\ j -> u.1.1 (sp.1.1 j))) ;
  } ;
 } ;
} ;
