-- Unique square-zero lifting is preserved by a principal localisation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module FX = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (E : Algebras[l].Over[R,setR].Algebra)
 (p : Presentations[l].Over[R,setR].Presentation) (pe : Presentations[l].Over[R,setR].Presents p E)
 (g : E.ring.R) (expr : Presentations[l].Over[R,setR].Expr (Presentations[l].Fin p.1))
 (rep : Id E.ring.R (Presentations[l].Over[R,setR].eval (Presentations[l].Fin p.1) E pe.1.1 expr) g) {
 module C = Algebras[l].Over[R,setR] ; module FE = FormallyEtale[l].Over[R,setR] ;
 module L = Localization[l].Over[R,setR,E,p,pe,g,expr,rep] ;
 T : C.Algebra = L.algebra ; i : C.Hom E T = L.inclusion ;
 hom-ext (B : C.Algebra) (h k : C.Hom T B)
  (same : Id (C.Hom E B) (C.compose E T B h i) (C.compose E T B k i)) : Id (C.Hom T B) h k =
  Equivalences[l].injective (C.Hom T B) L.To[B].Data L.Canonical[B].map L.Canonical[B].universal h k
   (L.To[B].data-ext _ _ same) ;
 module Unramified (uniqueE : FE.Unique E) {
  theorem : FE.Unique T = \ B N h k same -> hom-ext B h k
   (uniqueE B N (C.compose E T B h i) (C.compose E T B k i)
    (C.ext E FE.Mod[B,N].algebra _ _ (\ e -> ap (\ f -> f.1.1 (i.1.1 e)) same))) ;
 } ;
 module Smooth (smoothE : FE.Lift E) {
  module Problem (B : C.Algebra) (N : FE.SquareZero[B]) (phi : C.Hom T FE.Mod[B,N].algebra) {
   module Q = FE.Mod[B,N] ;
   lifted : (h : C.Hom E B) * Id (C.Hom E Q.algebra) (FE.reduce E B N h) (C.compose E T Q.algebra phi i) =
    smoothE B N (C.compose E T Q.algebra phi i) ;
   psi : C.Hom E B = lifted.1 ; a : B.ring.R = psi.1.1 g ;
   class-unit : RL[Q.Q.ring].unit (Q.Q.include a) =
    subst (RL[Q.Q.ring].unit) (sym (ap (\ h -> h.1.1 g) lifted.2))
     (FormallyEtale[l].unit-map T.ring Q.Q.ring phi.1 (i.1.1 g) L.inverse) ;
   unit-of (w : Q.Q.Carrier) (h : Id Q.Q.Carrier (Q.Q.mulQ (Q.Q.include a) w) Q.Q.oneQ) : RL[B.ring].unit a =
    Q.Q.Q.induction @l (\ w -> Id Q.Q.Carrier (Q.Q.mulQ (Q.Q.include a) w) Q.Q.oneQ -> RL[B.ring].unit a)
     (\ w -> FX.isProp-Pi _ (\ h -> RL[B.ring].unit a) (\ h -> FormallyEtale[l].Units[B.ring,B.set].unit-prop a))
     (\ v h -> FE.unit-mod-nilpotent B N a v
      (Q.Q.Q.effective (B.ring.mul a v) B.ring.o (trans (sym (Q.Q.Multiply.beta a v)) h))) w h ;
   a-unit : RL[B.ring].unit a = unit-of class-unit.1 class-unit.2 ;
   extension : C.Hom T B = L.Canonical[B].universal.sec (psi,a-unit) ;
   on-input : Id (C.Hom E B) (C.compose E T B extension i) psi =
    ap (\ d -> d.1) (L.Canonical[B].universal.sec-eq (psi,a-unit)) ;
   reduces : Id (C.Hom T Q.algebra) (FE.reduce T B N extension) phi =
    hom-ext Q.algebra _ _ (C.ext E Q.algebra _ _
     (\ e -> trans (ap Q.Q.include (ap (\ h -> h.1.1 e) on-input)) (ap (\ h -> h.1.1 e) lifted.2))) ;
  } ;
  theorem : FE.Lift T = \ B N phi -> (Problem[B,N,phi].extension,Problem[B,N,phi].reduces) ;
 } ;
} ;
