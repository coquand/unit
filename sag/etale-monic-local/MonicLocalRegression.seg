-- End-to-end instances, including repeated input relations and
-- localisations at nilpotents. The derivative ideal is never supplied
-- to the final theorem as an extra hypothesis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Point (R : CRing) (setR : Pr.isSet R.R) (a t : R.R) {
 module P0 = DirectRegression[l].AtPoint[R,setR,a] ;
 module Empty = DirectRegression[l].Empty[R,setR] ;
 module Red = DirectRegression[l].Point[R,setR,a] ;
 module C = P0.C ; module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 module Mon = HorrocksInterface[l].Over[R,setR] ;
 module X = MonicRelation[l].Over[R,setR].At[C.base,a] ;
 lower : List R.R = cons (R.neg a) nil ;
 value-one : Id R.R (X.val (B.include (cons R.o nil))) R.o =
  X.X.UP.on-constants R.o ;
 root : Id R.R (X.val (Mon.monic lower)) R.z =
  trans (X.val-cons (R.neg a) (cons R.o nil))
   (trans (ap (R.add (R.neg a)) (trans (ap (R.mul a) value-one) (R.mulO a))) (RL[R].neg-cancel a)) ;
 module Sq = MonicPowers[l].Over[R,setR].Product[lower,lower] ;
 repeated-root : Id R.R (X.val (Mon.monic Sq.lower)) R.z =
  trans (ap X.val Sq.equation) (trans (X.X.ev.2.2.2 (Mon.monic lower) (Mon.monic lower))
   (trans (ap (\ z -> R.mul z (X.val (Mon.monic lower))) root) (RL[R].zero-mul (X.val (Mon.monic lower))))) ;
 cs : List R.R = cons t nil ;
 module Fr = PolynomialFractions[l].Over[R,setR].At[C.base,a,B.include cs] ;
 full (r : R.R) : Tr.Trunc[Fr.Fraction r].carrier = Tr.Trunc[Fr.Fraction r].inc
  (B.constant r,zero,trans (Fr.X.UP.on-constants r) (sym (RL[R].one-left r))) ;
 module Local = LocalMonogenicStandard[l].Over[R,setR,cs].At[C.base,P0.presentation,P0.presents,a,Sq.lower,repeated-root,full,Empty.unique] ;
 theorem : Tr1.Trunc[Local.Result].carrier = Local.theorem Empty.theorem.1.1 ;
 flat-theorem : Tr1.Trunc[Local.Result].carrier = Local.Flat[FlatRelations[l].Self[R].flat].result ;
 module Redundant = LocalMonogenicStandard[l].Over[R,setR,cs].At[C.base,Red.redundant,Red.presents,a,Sq.lower,repeated-root,full,Empty.unique] ;
 redundant-theorem : Tr1.Trunc[Redundant.Result].carrier = Redundant.theorem Red.redundant-theorem.1.1 ;
 -- The empty algebra presentation also works with a chosen integral y.
 module NoGenerators = LocalMonogenicStandard[l].Over[R,setR,cs].At[C.base,Empty.presentation.1,Empty.presentation.2,a,Sq.lower,repeated-root,full,Empty.unique] ;
 empty-presentation : Tr1.Trunc[NoGenerators.Result].carrier = NoGenerators.theorem Empty.theorem.1.1 ;
 -- Public endpoint: neither a presentation nor an integral equation
 -- needs to be chosen outside the truncation of the conclusion.
 module Public = ShortLocalEtale[l].Over[R,setR,cs].At[C.base,a,full,Empty.unique] ;
 module Pres = Presentations[l].Over[R,setR] ;
 fp : Pres.FP C.base = Tr1.Trunc[Pres.Witness C.base].inc (P0.presentation,P0.presents) ;
 integral : Tr.Trunc[Public.Integral].carrier = Tr.Trunc[Public.Integral].inc (Sq.lower,repeated-root) ;
 public-theorem : Tr1.Trunc[Public.Result].carrier = Public.theorem fp integral Empty.theorem.1.1 ;
 public-flat : Tr1.Trunc[Public.Result].carrier = Public.flat-theorem fp integral FlatRelations[l].Self[R].flat ;
} ;
module Z = ZMod4[l] ;
module AtUnit = Point[Z.ring,Z.set,q2,q1] ;
module AtNilpotent = Point[Z.ring,Z.set,q2,q2] ;
module AtZero = Point[Z.ring,Z.set,q2,q0] ;
unit-localisation : Tr1.Trunc[AtUnit.Local.Result].carrier = AtUnit.theorem ;
nilpotent-localisation : Tr1.Trunc[AtNilpotent.Local.Result].carrier = AtNilpotent.flat-theorem ;
zero-localisation : Tr1.Trunc[AtZero.NoGenerators.Result].carrier = AtZero.empty-presentation ;
nonreduced-redundant : Tr1.Trunc[AtUnit.Redundant.Result].carrier = AtUnit.redundant-theorem ;
 public-nilpotent : Tr1.Trunc[AtNilpotent.Public.Result].carrier = AtNilpotent.public-flat ;

-- Every already constructed monic standard algebra can be fed through
-- the new endpoint, starting with the square of its defining relation.
-- This exercises genuine algebra generators, beyond the base algebra.
module StandardInput (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 module Mon = HorrocksInterface[l].Over[R,setR] ;
 module Given (lower : List R.R) (aux : B.Carrier) (cs : List R.R)
  (rep : Id B.Carrier (B.include cs) SE.Points[Mon.monic lower,aux].g) {
  Q : B.Carrier = Mon.monic lower ;
  module SA = StandardAlgebra[l].Over[R,setR].Build[Q,aux,Mon.monic-list lower,cs,refl Q,rep] ;
  E : C.Algebra = SA.S ; y : E.ring.R = SA.point.1 ;
  module Fr = PolynomialFractions[l].Over[R,setR].At[E,y,B.include cs] ;
  module Etale = StandardEtaleLift[l].Over[R,setR].At[Q,aux,E,SA.standard] ;
  unit : RL[E.ring].unit Fr.g = subst (RL[E.ring].unit) (sym (ap Fr.X.value rep)) SA.point.2.2 ;
  convert (e : E.ring.R) (w : SA.Fr.Fraction e) : Fr.Fraction e =
   (w.1,w.2.1,trans (sym w.2.2)
    (trans (E.ring.mulC e (Fr.Pow.power SA.Fr.g w.2.1))
     (ap (\ a -> E.ring.mul (Fr.Pow.power a w.2.1) e) (sym (ap Fr.X.value rep))))) ;
  full (e : E.ring.R) : Tr.Trunc[Fr.Fraction e].carrier =
   TruncationCombinators[l].map (SA.Fr.Fraction e) (Fr.Fraction e) (convert e) (SA.full e) ;
  module Sq = MonicPowers[l].Over[R,setR].Product[lower,lower] ;
  root : Id E.ring.R (Fr.X.value (Mon.monic Sq.lower)) E.ring.z =
   trans (ap Fr.X.value Sq.equation) (trans (Fr.X.ev.2.2.2 Q Q)
    (trans (ap (\ a -> E.ring.mul a (Fr.X.value Q)) SA.point.2.1) (RL[E.ring].zero-mul (Fr.X.value Q)))) ;
  module New = MonogenicStandard[l].Over[R,setR,cs].At[E,SA.Loc.pres,SA.Loc.K.presentation,y,unit,full,Etale.unique,Sq.lower,root] ;
  theorem : Tr1.Trunc[New.Result].carrier = New.Smooth[Etale.lift].theorem ;
  simple-monic : Tr.Trunc[New.SimpleMonic].carrier = New.simple-monic ;
 } ;
} ;

-- A concrete denominator calculation over Z/4Z. The two relations are
-- T+2 and 2T at y=2; 3*(T+2)' + (2T)' = 1. Fractions for the
-- coefficients have denominator powers 1 and 2, so H' = 3^3 = 3.
module Denominators {
 module C = Algebras[l].Over[Z.ring,Z.set] ; module SE = StandardEtale[l].Over[Z.ring,Z.set] ; module B = SE.RX ;
 module X = MonicRelation[l].Over[Z.ring,Z.set].At[C.base,q2] ;
 two : Nat = suc (suc zero) ; first : Fin two = inl (inr tt) ; second : Fin two = inr tt ;
 f0 : B.Carrier = B.addQ B.variable (B.constant q2) ;
 f1 : B.Carrier = B.mulQ (B.constant q2) B.variable ;
 f : Fin two -> B.Carrier = split { inl i -> f0 ; inr t -> f1 } ;
 root0 : Id Z.ring.R (X.val f0) q0 = trans (X.X.ev.2.2.1 B.variable (B.constant q2))
  (cong2 Z.ring.R Z.ring.add _ _ _ _ X.X.UP.on-variable (X.X.UP.on-constants q2)) ;
 root1 : Id Z.ring.R (X.val f1) q0 = trans (X.X.ev.2.2.2 (B.constant q2) B.variable)
  (cong2 Z.ring.R Z.ring.mul _ _ _ _ (X.X.UP.on-constants q2) X.X.UP.on-variable) ;
 roots : (i : Fin two) -> Id Z.ring.R (X.val (f i)) q0 = split { inl i -> root0 ; inr t -> root1 } ;
 derivative0 : Id Z.ring.R (X.der f0) q1 = trans (X.der-add B.variable (B.constant q2))
  (cong2 Z.ring.R Z.ring.add _ _ _ _ X.der-variable (X.der-constant q2)) ;
 derivative1 : Id Z.ring.R (X.der f1) q2 = trans (X.der-mul (B.constant q2) B.variable)
  (cong2 Z.ring.R Z.ring.add _ _ _ _
   (cong2 Z.ring.R Z.ring.mul _ _ _ _ (X.X.UP.on-constants q2) X.der-variable)
   (cong2 Z.ring.R Z.ring.mul _ _ _ _ (X.der-constant q2) X.X.UP.on-variable)) ;
 b : Fin two -> Z.ring.R = split { inl i -> q3 ; inr t -> q1 } ;
 identity : Id Z.ring.R q1 (FiniteIdeal[l].Sums[Z.ring].lin two (\ i -> X.der (f i)) b) =
  sym (cong2 Z.ring.R Z.ring.add _ _ _ _ (ap (\ a -> Z.ring.mul a q1) derivative1)
   (ap (\ a -> Z.ring.add (Z.ring.mul a q3) q0) derivative0)) ;
 G : B.Carrier = B.constant q3 ;
 module SR = SimplePolynomialRelation[l].Over[Z.ring,Z.set].At[C.base,q2,G] ;
 module Given = SR.Given[two,f,roots,b,identity] ;
 fraction0 : SR.Fr.Fraction q3 = (B.oneQ,suc zero,
  trans X.X.ev.2.1 (sym (ap (\ g -> Z.ring.mul (SR.Pow.power g (suc zero)) q3) (X.X.UP.on-constants q3)))) ;
 fraction1 : SR.Fr.Fraction q1 = (B.oneQ,two,
  trans X.X.ev.2.1 (sym (ap (\ g -> Z.ring.mul (SR.Pow.power g two) q1) (X.X.UP.on-constants q3)))) ;
 fractions : (i : Fin two) -> SR.Fr.Fraction (b i) = split { inl i -> fraction0 ; inr t -> fraction1 } ;
 module Chosen = Given.Chosen[fractions] ;
 exponent : Id Nat Chosen.exponent (suc (suc (suc zero))) = refl (suc (suc (suc zero))) ;
 root : Id Z.ring.R (X.val Chosen.polynomial) q0 = Chosen.equation ;
 derivative : Id Z.ring.R (X.der Chosen.polynomial) q3 = trans Chosen.derivative
  (trans (ap (SR.Pow.power SR.Fr.g) exponent) (ap (\ g -> SR.Pow.power g (suc (suc (suc zero)))) (X.X.UP.on-constants q3))) ;
 simple : RL[Z.ring].unit (X.der Chosen.polynomial) =
  subst (RL[Z.ring].unit) (sym derivative) (q3,refl q1) ;
} ;
