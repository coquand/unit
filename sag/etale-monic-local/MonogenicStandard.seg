-- Short ending for the local proof. A finitely presented unramified
-- algebra generated by an integral y and 1/G(y) has a simple monic
-- relation. With formal smoothness it is monic standard etale.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (cs : List R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 module FE = FormallyEtale[l].Over[R,setR] ; module PF = PolynomialFractions[l].Over[R,setR] ;
 module Mon = HorrocksInterface[l].Over[R,setR] ;
 G : B.Carrier = B.include cs ;
 module At (E : C.Algebra) (p : P.Presentation) (pe : P.Presents p E)
  (y : E.ring.R) (unit : RL[E.ring].unit (SE.At[E.ring,E.set,E.iota,y].value G))
  (full : PF.At[E,y,G].Full) (unique : FE.Unique E)
  (lower : List R.R) (root : Id E.ring.R (SE.At[E.ring,E.set,E.iota,y].value (Mon.monic lower)) E.ring.z) {
  module X = SE.At[E.ring,E.set,E.iota,y] ;
  module DI = MonogenicDerivativeIdeal[l].Over[R,setR,cs].At[E,p,pe,y,unit,full,unique] ;
  module SR = SimplePolynomialRelation[l].Over[R,setR].At[E,y,G] ;
  record SimpleMonic {
   coefficients : List R.R ;
   equation : Id E.ring.R (X.value (Mon.monic coefficients)) E.ring.z ;
   derivative-unit : RL[E.ring].unit (X.derivative (Mon.monic coefficients)) ;
  } ;
  module Simple (h : SR.Relation) {
   module Q = MonicRelation[l].Over[R,setR].At[E,y].Build[lower,h.coefficients,root,h.root,SR.simple unit h] ;
   result : SimpleMonic = new SimpleMonic[Q.coefficients,Q.equation,Q.unit] ;
  } ;
  from-derivatives (w : DI.Certificate) : Tr.Trunc[SR.Relation].carrier =
   SR.Given[w.number,w.relation,w.root,w.coefficients,w.identity].theorem full ;
  simple-relation : Tr.Trunc[SR.Relation].carrier = TC.bind DI.Certificate SR.Relation from-derivatives DI.theorem ;
  simple-monic : Tr.Trunc[SimpleMonic].carrier = TC.map SR.Relation SimpleMonic (\ h -> Simple[h].result) simple-relation ;
  Result : U l+ = (lower : List R.R) * (denominator : B.Carrier) * SE.Points[Mon.monic lower,denominator].Standard E ;
  module Smooth (smooth : FE.Lift E) {
   Into (A : U l) (f : A -> Tr1.Trunc[Result].carrier) (a : Tr.Trunc[A].carrier) : Tr1.Trunc[Result].carrier =
    TC.rec A @l+ (Tr1.Trunc[Result].carrier) Tr1.Trunc[Result].proposition f a ;
   module Source (q : SimpleMonic) (lg : PF.Representation SE.Points[Mon.monic q.coefficients,G].g) {
    Q : B.Carrier = Mon.monic q.coefficients ; module Pt = SE.Points[Q,G] ;
    module SA = StandardAlgebra[l].Over[R,setR].Build[Q,G,Mon.monic-list q.coefficients,lg.1,refl Q,lg.2] ;
    S : C.Algebra = SA.S ;
    point : Pt.Point E = (y,q.equation,
     subst (RL[E.ring].unit) (sym (X.ev.2.2.2 G (SE.deriv Q)))
      (FormallyEtale[l].Units[E.ring,E.set].unit-mul (X.value G) (X.value (SE.deriv Q)) unit
       (subst (RL[E.ring].unit) (sym (SE.deriv-value E.ring E.set E.iota y Q)) q.derivative-unit))) ;
    u : C.Hom S E = (SA.standard.2 E).sec point ;
    on-variable : Id E.ring.R (u.1.1 SA.point.1) y = ap (\ p -> p.1) ((SA.standard.2 E).sec-eq point) ;
    module SX = SE.At[S.ring,S.set,S.iota,SA.point.1] ;
    source-unit : RL[S.ring].unit (SX.value G) =
     FormallyEtale[l].Units[S.ring,S.set].unit-left (SX.value G) (SX.value (SE.deriv Q))
      (subst (RL[S.ring].unit) (SX.ev.2.2.2 G (SE.deriv Q)) SA.point.2.2) ;
    module MP = PF.Map[S,E,SA.point.1,y,G,u,on-variable] ;
    module Surj = MP.Surjectivity[source-unit,unit,full] ;
    module Kernel = FiniteSurjectionKernel[l].Over[R,setR].At[S,E,SA.Loc.pres,p,SA.Loc.K.presentation,pe,u] ;
    module End (k : Kernel.Certificate) {
     module EC = EtaleCase[l].Over[R,setR].Section2[S,E,u,Surj.theorem,k.number,k.generator,k.killed,k.generates] ;
     module Last = EC.Theorem[Q,G,SA.standard,SA.full,smooth] ;
     result (w : Last.Result) : Result = (q.coefficients,B.mulQ G w.1,w.2) ;
     theorem : Tr1.Trunc[Result].carrier = Tr1.Trunc[Last.Result].induction @l+
      (\ w -> Tr1.Trunc[Result].carrier) (\ w -> Tr1.Trunc[Result].proposition)
      (\ w -> Tr1.Trunc[Result].inc (result w)) Last.local ;
    } ;
    theorem : Tr1.Trunc[Result].carrier = Into Kernel.Certificate (\ k -> End[k].theorem) Kernel.Surjective[Surj.theorem].theorem ;
   } ;
   from-simple (q : SimpleMonic) : Tr1.Trunc[Result].carrier =
    Into (PF.Representation SE.Points[Mon.monic q.coefficients,G].g)
     (\ lg -> Source[q,lg].theorem) (PF.represents SE.Points[Mon.monic q.coefficients,G].g) ;
   theorem : Tr1.Trunc[Result].carrier = Into SimpleMonic from-simple simple-monic ;
  } ;
  module Flat (flat : FlatRelations[l].Over[R,E.ring,E.iota].Flat) {
   module Direct = FlatUnramifiedEtale[l].Over[R,setR].Presented[E,(p,pe),unique,flat] ;
   theorem : Tr1.Trunc[Result].carrier = Smooth[Direct.theorem.1.1].theorem ;
  } ;
 } ;
} ;
