-- R[T,1/G], with its two-generator presentation and polynomial fractions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (cs : List R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 module SA = StandardAlgebra[l].Over[R,setR] ; module PF = PolynomialFractions[l].Over[R,setR] ;
 V : U l = Fin (suc (suc zero)) ;
 x : V = inl (inr tt) ; v : V = inr tt ;
 G : B.Carrier = B.include cs ;
 gx : P.Expr V = SA.hornerE V x cs ;
 equation : P.Expr V = sumE (mulE gx (var v)) (cst (R.neg R.o)) ;
 pres : P.Presentation = (suc (suc zero),cons equation nil) ;
 module K = PresentationExistence[l].Over[R,setR,pres] ;
 S : C.Algebra = K.A.algebra ; y : S.ring.R = K.A.solution.1 x ;
 inverse : S.ring.R = K.A.solution.1 v ;
 module Fr = PF.At[S,y,G] ;
 g : S.ring.R = Fr.g ;
 minus-one (E : C.Algebra) : Id E.ring.R (E.iota.1 (R.neg R.o)) (E.ring.neg E.ring.o) =
  trans (H.negation R E.ring E.iota R.o) (ap E.ring.neg E.iota.2.1) ;
 equation-value (E : C.Algebra) (a : V -> E.ring.R) : Id E.ring.R (P.eval V E a equation)
  (E.ring.add (E.ring.mul (SE.At[E.ring,E.set,E.iota,a x].value G) (a v)) (E.ring.neg E.ring.o)) =
  cong2 E.ring.R E.ring.add _ _ _ _
   (ap (\ z -> E.ring.mul z (a v)) (SA.eval-hornerE E V x a cs)) (minus-one E) ;
 unit : RL[S.ring].unit g =
  (inverse,FormallyEtale[l].Units[S.ring,S.set].sub-zero (S.ring.mul g inverse) S.ring.o
   (trans (sym (equation-value S K.A.solution.1)) K.A.solution.2.1)) ;
 module To (E : C.Algebra) (z : E.ring.R) (uz : RL[E.ring].unit (SE.At[E.ring,E.set,E.iota,z].value G)) {
  old-coords : Fin (suc zero) -> E.ring.R = split { inl e -> efq e ; inr t -> z } ;
  coords : V -> E.ring.R = split {
   inl i -> old-coords i ; inr t -> uz.1 } ;
  solution : P.Solutions pres E = (coords,
   trans (equation-value E coords) (trans (ap (\ a -> E.ring.add a (E.ring.neg E.ring.o)) uz.2) (E.ring.addN E.ring.o)),tt) ;
  map : C.Hom S E = K.To[E].extend solution ;
  on-gen (i : V) : Id E.ring.R (map.1.1 (K.A.solution.1 i)) (coords i) = ap (\ s -> s.1 i) (K.To[E].fb solution) ;
  on-variable : Id E.ring.R (map.1.1 y) z = on-gen x ;
  on-inverse : Id E.ring.R (map.1.1 inverse) uz.1 = on-gen v ;
 } ;
 module Ext (E : C.Algebra) (f h : C.Hom S E) (same : Id E.ring.R (f.1.1 y) (h.1.1 y)) {
  module NF = SE.Natural[S.ring,E.ring,S.set,E.set,S.iota,E.iota,f.1,f.2,y] ;
  module NH = SE.Natural[S.ring,E.ring,S.set,E.set,S.iota,E.iota,h.1,h.2,y] ;
  g-equal : Id E.ring.R (f.1.1 g) (h.1.1 g) = trans (NF.value G)
   (trans (ap (\ a -> SE.At[E.ring,E.set,E.iota,a].value G) same) (sym (NH.value G))) ;
  fu : RL[E.ring].unit (f.1.1 g) = FormallyEtale[l].unit-map S.ring E.ring f.1 g unit ;
  hu : RL[E.ring].unit (f.1.1 g) = (h.1.1 inverse,
   trans (ap (\ a -> E.ring.mul a (h.1.1 inverse)) g-equal) (FormallyEtale[l].unit-map S.ring E.ring h.1 g unit).2) ;
  inverse-equal : Id E.ring.R (f.1.1 inverse) (h.1.1 inverse) =
   ap (\ u -> u.1) (FormallyEtale[l].Units[E.ring,E.set].unit-prop (f.1.1 g) fu hu) ;
  old-generators : (i : Fin (suc zero)) -> Id E.ring.R (f.1.1 (K.A.solution.1 (inl i))) (h.1.1 (K.A.solution.1 (inl i))) = split {
   inl e -> efq e ; inr t ->
    subst (\ i -> Id E.ring.R (f.1.1 (K.A.solution.1 (inl (inr i)))) (h.1.1 (K.A.solution.1 (inl (inr i)))))
     (P.top-prop tt t) same } ;
  generators : (i : V) -> Id E.ring.R (f.1.1 (K.A.solution.1 i)) (h.1.1 (K.A.solution.1 i)) = split {
   inl i -> old-generators i ;
   inr t -> subst (\ i -> Id E.ring.R (f.1.1 (K.A.solution.1 (inr i))) (h.1.1 (K.A.solution.1 (inr i)))) (P.top-prop tt t) inverse-equal } ;
  theorem : Id (C.Hom S E) f h = Tensor[l].Over[R,setR].hom-eq pres S K.presentation E f h generators ;
 } ;
 frac-y : Fr.Fraction y = (B.variable,zero,trans Fr.X.UP.on-variable (sym (RL[S.ring].one-left y))) ;
 frac-inverse : Fr.Fraction inverse = (B.oneQ,suc zero,trans Fr.X.ev.2.1
  (trans (sym unit.2) (ap (\ z -> S.ring.mul z inverse) (sym (S.ring.mulO g))))) ;
 fraction-old : (i : Fin (suc zero)) -> Fr.Fraction (K.A.solution.1 (inl i)) = split {
  inl e -> efq e ; inr t -> subst (\ i -> Fr.Fraction (K.A.solution.1 (inl (inr i)))) (P.top-prop tt t) frac-y } ;
 fraction-gen : (i : V) -> Fr.Fraction (K.A.solution.1 i) = split {
  inl i -> fraction-old i ;
  inr t -> subst (\ i -> Fr.Fraction (K.A.solution.1 (inr i))) (P.top-prop tt t) frac-inverse } ;
 fraction-expression : (e : P.Expr V) -> Fr.Fraction (P.eval V S K.A.solution.1 e) = split {
  var i -> fraction-gen i ;
  cst r -> (B.constant r,zero,trans (Fr.X.UP.on-constants r) (sym (RL[S.ring].one-left (S.iota.1 r)))) ;
  sumE e f | pe pf -> Fr.Ar.add (P.eval V S K.A.solution.1 e) (P.eval V S K.A.solution.1 f) pe pf ;
  mulE e f | pe pf -> Fr.Ar.multiply (P.eval V S K.A.solution.1 e) (P.eval V S K.A.solution.1 f) pe pf } ;
 module Gens = Generated[l].Over[R,setR].Generated[pres,S,K.presentation] ;
 full (s : S.ring.R) : Tr.Trunc[Fr.Fraction s].carrier =
  TC.map (Generated[l].Over[R,setR].Representation pres S K.presentation s) (Fr.Fraction s)
   (\ rep -> subst Fr.Fraction rep.2 (fraction-expression rep.1)) (Gens.generated s) ;
 module Onto (E : C.Algebra) (z : E.ring.R) (uz : RL[E.ring].unit (SE.At[E.ring,E.set,E.iota,z].value G))
  (fullE : PF.At[E,z,G].Full) {
  module Into = To[E,z,uz] ; module M = PF.Map[S,E,y,z,G,Into.map,Into.on-variable] ;
  module Surj = M.Surjectivity[unit,uz,fullE] ;
  surjective : (e : E.ring.R) -> Tr.Trunc[Surj.Preimage e].carrier = Surj.theorem ;
 } ;
} ;
