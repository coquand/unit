-- Dual-number tests over an arbitrary algebra. Unramifiedness makes
-- every tangent map constant; the square-zero ideal is constructed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (B : Algebras[l].Over[R,setR].Algebra) {
 module C = Algebras[l].Over[R,setR] ; module FE = FormallyEtale[l].Over[R,setR] ;
 module D = QuadraticPairs[l].Over[B.ring,B.set,B.ring.z] ; module L = RL[B.ring] ;
 algebra : C.Algebra = C.mkAlgebra D.ring D.set (H.compose R B.ring D.ring D.inclusion B.iota) ;
 constant : C.Hom B algebra = (D.inclusion,\ r -> refl (D.constant (B.iota.1 r))) ;
 first-product (p q : D.Pair) : Id B.ring.R (D.timesQ p q).1 (B.ring.mul p.1 q.1) =
  trans (ap (B.ring.add (B.ring.mul p.1 q.1)) (L.zero-mul (B.ring.mul p.2 q.2))) (B.ring.addZ (B.ring.mul p.1 q.1)) ;
 projection : C.Hom algebra B = ((\ p -> p.1,refl B.ring.o,\ p q -> refl (B.ring.add p.1 q.1),first-product),\ r -> refl (B.iota.1 r)) ;
 In (p : D.Pair) : U l = Id B.ring.R p.1 B.ring.z ;
 plus (p q : D.Pair) (hp : In p) (hq : In q) : In (D.plusQ p q) =
  trans (cong2 B.ring.R B.ring.add _ _ _ _ hp hq) (B.ring.addZ B.ring.z) ;
 scale (p q : D.Pair) (hq : In q) : In (D.timesQ p q) =
  trans (first-product p q) (trans (ap (B.ring.mul p.1) hq) (L.mul-zero p.1)) ;
 ideal : RegularIdeal[l].IdealPred[D.ring] = RegularIdeal[l].mkIdealPred D.ring In (refl B.ring.z) plus scale ;
 square (p q : D.Pair) (hp : In p) (hq : In q) : Id D.Pair (D.timesQ p q) D.zeroQ =
  D.eq _ _ (scale p q hq)
   (trans (cong2 B.ring.R B.ring.add _ _ _ _
    (trans (ap (\ a -> B.ring.mul a q.2) hp) (L.zero-mul q.2))
    (trans (ap (B.ring.mul p.2) hq) (L.mul-zero p.2))) (B.ring.addZ B.ring.z)) ;
 nilpotent : FE.SquareZero[algebra] = FE.mkSquareZero algebra ideal (\ p -> B.set p.1 B.ring.z) square ;
 module Q = FE.Mod[algebra,nilpotent] ;
 unit (p : D.Pair) (u : L.unit p.1) : RL[D.ring].unit p =
  FE.unit-mod-nilpotent algebra nilpotent p (D.constant u.1)
   (trans (ap (\ a -> B.ring.add a (B.ring.neg B.ring.o)) (trans (first-product p (D.constant u.1)) u.2))
    (B.ring.addN B.ring.o)) ;
 vertical (a : B.ring.R) : D.Pair = (B.ring.z,a) ;
 times-vertical (p : D.Pair) (a : B.ring.R) : Id D.Pair (D.timesQ p (vertical a)) (vertical (B.ring.mul p.1 a)) =
  D.eq _ _ (trans (first-product p (vertical a)) (L.mul-zero p.1))
   (trans (ap (B.ring.add (B.ring.mul p.1 a)) (L.mul-zero p.2)) (B.ring.addZ (B.ring.mul p.1 a))) ;
 plus-vertical (a b : B.ring.R) : Id D.Pair (D.plusQ (vertical a) (vertical b)) (vertical (B.ring.add a b)) =
  D.eq _ _ (B.ring.addZ B.ring.z) (refl (B.ring.add a b)) ;
 module Test (E : C.Algebra) (unique : FE.Unique E) (rho : C.Hom E B) (jet : C.Hom E algebra)
  (first : (e : E.ring.R) -> Id B.ring.R (jet.1.1 e).1 (rho.1.1 e)) {
  ordinary : C.Hom E algebra = C.compose E B algebra constant rho ;
  reduces : Id (C.Hom E Q.algebra) (FE.reduce E algebra nilpotent jet) (FE.reduce E algebra nilpotent ordinary) =
   C.ext E Q.algebra _ _ (\ e -> Q.Q.Q.relates (jet.1.1 e) (ordinary.1.1 e)
    (trans (ap (\ a -> B.ring.add a (B.ring.neg (rho.1.1 e))) (first e)) (B.ring.addN (rho.1.1 e)))) ;
  equal : Id (C.Hom E algebra) jet ordinary = unique algebra nilpotent jet ordinary reduces ;
  derivative-zero (e : E.ring.R) : Id B.ring.R (jet.1.1 e).2 B.ring.z = ap (\ h -> (h.1.1 e).2) equal ;
 } ;
} ;
