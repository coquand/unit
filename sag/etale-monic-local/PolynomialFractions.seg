-- Fractions in one polynomial generator; no choice of representatives
-- is made outside propositional truncation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 Representation (p : B.Carrier) : U l = (cs : List R.R) * Id B.Carrier (B.include cs) p ;
 represents : (p : B.Carrier) -> Tr.Trunc[Representation p].carrier =
  B.Q.induction @l (\ p -> Tr.Trunc[Representation p].carrier) (\ p -> Tr.Trunc[Representation p].proposition)
   (\ cs -> Tr.Trunc[Representation (B.include cs)].inc (cs,refl (B.include cs))) ;
 module At (E : C.Algebra) (y : E.ring.R) (G : B.Carrier) {
  module X = SE.At[E.ring,E.set,E.iota,y] ; module L = RL[E.ring] ; module Pow = AffinePowers[l].Over[E.ring] ;
  module Ar = LocalizationFractions[l].Arithmetic[B.ring,E.ring,E.set,X.ev,G] ;
  g : E.ring.R = X.value G ;
  Fraction : E.ring.R -> U l = Ar.Form ;
  Full : U l = (x : E.ring.R) -> Tr.Trunc[Fraction x].carrier ;
  RawFraction (x : E.ring.R) : U l = (cs : List R.R) * (n : Nat) *
   Id E.ring.R (X.value (B.include cs)) (E.ring.mul (Pow.power g n) x) ;
  raw (x : E.ring.R) (w : Fraction x) : Tr.Trunc[RawFraction x].carrier =
   TC.map (Representation w.1) (RawFraction x)
    (\ p -> (p.1,w.2.1,trans (ap X.value p.2) w.2.2)) (represents w.1) ;
  raw-full (full : Full) (x : E.ring.R) : Tr.Trunc[RawFraction x].carrier = TC.bind (Fraction x) (RawFraction x) (raw x) (full x) ;
  power-one : (n : Nat) -> Id E.ring.R (Pow.power E.ring.o n) E.ring.o = split {
   zero -> refl E.ring.o ; suc n | rec -> trans (ap (E.ring.mul E.ring.o) rec) (E.ring.mulO E.ring.o) } ;
  module Unit (unit : L.unit g) {
   inverse-power (n : Nat) : Id E.ring.R (E.ring.mul (Pow.power g n) (Pow.power unit.1 n)) E.ring.o =
    trans (sym (Pow.power-mul g unit.1 n)) (trans (ap (\ a -> Pow.power a n) unit.2) (power-one n)) ;
   decode (p : B.Carrier) (n : Nat) : E.ring.R = E.ring.mul (X.value p) (Pow.power unit.1 n) ;
   clears (p : B.Carrier) (n : Nat) : Id E.ring.R (E.ring.mul (Pow.power g n) (decode p n)) (X.value p) =
    trans (L.mul-swap (Pow.power g n) (X.value p) (Pow.power unit.1 n))
     (trans (ap (E.ring.mul (X.value p)) (inverse-power n)) (E.ring.mulO (X.value p))) ;
   cancel (n : Nat) (a b : E.ring.R)
    (h : Id E.ring.R (E.ring.mul (Pow.power g n) a) (E.ring.mul (Pow.power g n) b)) : Id E.ring.R a b =
    calc E.ring.R { a =< sym (L.one-left a) > E.ring.mul E.ring.o a
     =< ap (\ z -> E.ring.mul z a) (sym (inverse-power n)) > E.ring.mul (E.ring.mul (Pow.power g n) (Pow.power unit.1 n)) a
     =< sym (E.ring.mulA (Pow.power g n) (Pow.power unit.1 n) a) > E.ring.mul (Pow.power g n) (E.ring.mul (Pow.power unit.1 n) a)
     =< L.mul-swap (Pow.power g n) (Pow.power unit.1 n) a > E.ring.mul (Pow.power unit.1 n) (E.ring.mul (Pow.power g n) a)
     =< ap (E.ring.mul (Pow.power unit.1 n)) h > E.ring.mul (Pow.power unit.1 n) (E.ring.mul (Pow.power g n) b)
     =< sym (L.mul-swap (Pow.power g n) (Pow.power unit.1 n) b) > E.ring.mul (Pow.power g n) (E.ring.mul (Pow.power unit.1 n) b)
     =< E.ring.mulA (Pow.power g n) (Pow.power unit.1 n) b > E.ring.mul (E.ring.mul (Pow.power g n) (Pow.power unit.1 n)) b
     =< ap (\ z -> E.ring.mul z b) (inverse-power n) > E.ring.mul E.ring.o b
     =< L.one-left b > b } ;
   realises (x : E.ring.R) (w : Fraction x) : Id E.ring.R (decode w.1 w.2.1) x =
    cancel w.2.1 (decode w.1 w.2.1) x (trans (clears w.1 w.2.1) w.2.2) ;
  } ;
 } ;
 module Map (S E : C.Algebra) (ys : S.ring.R) (y : E.ring.R) (G : B.Carrier)
  (u : C.Hom S E) (uy : Id E.ring.R (u.1.1 ys) y) {
  module A = At[S,ys,G] ; module Bp = At[E,y,G] ;
  module N = SE.Natural[S.ring,E.ring,S.set,E.set,S.iota,E.iota,u.1,u.2,ys] ;
  value (p : B.Carrier) : Id E.ring.R (u.1.1 (A.X.value p)) (Bp.X.value p) =
   trans (N.value p) (ap (\ a -> SE.At[E.ring,E.set,E.iota,a].value p) uy) ;
  power (n : Nat) : Id E.ring.R (u.1.1 (A.Pow.power A.g n)) (Bp.Pow.power Bp.g n) =
   trans (AffinePowers[l].power-map S.ring E.ring u.1 A.g n) (ap (\ z -> Bp.Pow.power z n) (value G)) ;
  fraction (s : S.ring.R) (w : A.Fraction s) : Bp.Fraction (u.1.1 s) =
   (w.1,w.2.1,trans (sym (value w.1))
    (trans (ap u.1.1 w.2.2) (trans (u.1.2.2.2 (A.Pow.power A.g w.2.1) s)
     (ap (\ z -> E.ring.mul z (u.1.1 s)) (power w.2.1))))) ;
  module Surjectivity (us : RL[S.ring].unit A.g) (ue : RL[E.ring].unit Bp.g) (full : Bp.Full) {
   module AS = A.Unit[us] ; module AE = Bp.Unit[ue] ;
   Preimage (x : E.ring.R) : U l = (s : S.ring.R) * Id E.ring.R (u.1.1 s) x ;
   lift (x : E.ring.R) (w : Bp.Fraction x) : Preimage x =
    (AS.decode w.1 w.2.1,AE.cancel w.2.1 (u.1.1 (AS.decode w.1 w.2.1)) x
     (trans (ap (\ z -> E.ring.mul z (u.1.1 (AS.decode w.1 w.2.1))) (sym (power w.2.1)))
      (trans (sym (u.1.2.2.2 (A.Pow.power A.g w.2.1) (AS.decode w.1 w.2.1)))
       (trans (ap u.1.1 (AS.clears w.1 w.2.1)) (trans (value w.1) w.2.2))))) ;
   theorem (x : E.ring.R) : Tr.Trunc[Preimage x].carrier = TC.map (Bp.Fraction x) (Preimage x) (lift x) (full x) ;
  } ;
 } ;
} ;
