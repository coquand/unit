-- Descent along an etale tree (ETALETREES) into a proposition Q that is a
-- sheaf for the sub-family J: by induction on the tree.
--  (leaf)     the given map A -> Q;
--  (root)     Root (e j) -> Q gives G (e j) -> Q (Q a proposition), and
--             Q is a J-sheaf;
--  (zariski)  ||(i : Fin n) * g_i invertible|| -> Q, Q a proposition.
level l k ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (J : U l) (e : J -> EtaleTopology[l].Over[R,setR].I) (A : U l) (Q : U k) (pQ : Prelude[k].isProp Q)
 (mQ : SheafTopology[l].Over[J,\ j -> EtaleTopology[l].Over[R,setR].G (e j)].isModal @k Q) (f : A -> Q) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module TT = EtaleTrees[l].Over[R,setR,J,e].Trees[A] ;
 fold : TT.Cov -> Q = split {
  leaf a -> f a ;
  root j t | ih -> (mQ j).sec (\ g -> Tr.Trunc[ET.Root (e j)].induction @k (\ s -> Q) (\ s -> pQ) ih g) ;
  zariski n g c t | ih -> Tr.Trunc[(i : Fin n) * RL[R].unit (g i)].induction @k (\ s -> Q) (\ s -> pQ) (\ w -> ih w.1 w.2) c } ;
} ;
