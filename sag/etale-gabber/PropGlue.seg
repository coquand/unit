-- Gluing along a cover by two propositions (CHEAP-DESIGN.md, section 4,
-- item 6: gluing over D(a) u D(b)).  Let T be a type (in the use: the
-- families (G x).1 -> Module at a point x), P, Q propositions,
-- V : P -> T, W : Q -> T and e p q : V p = W q.  A gluing is
--     M : T,   fV p : M = V p,   fW q : M = W q,   fW q = fV p . e p q,
-- grouped as (M, fV) in Anchor and, for each q, (fW q, coherence) in Fit.
-- Glue is contractible as soon as P or Q holds; isContr is a proposition,
-- so Glue is contractible when P + Q holds merely, and a gluing exists.
--  (pointed)  If p0 : P, a section f of C over P is its value at p0
--     moved: f p = (pP p0 p)_* (f p0), by J on the path (determined).  So
--     (a : A) * ((p : P) -> C a p) is a retract of (a : A) * C a p0
--     (restrict), and the cone (a : A) * ((p : P) -> a = k p) is
--     contractible, a retract of the singleton (a : A) * (a = k p0).
--  (from p0)  Anchor is the cone of V; for (M, fV) and each q, Fit is the
--     cone of p |-> fV p . e p q in M = W q.  Weak funext and Sigma.
--  (from q0)  Restrict over Q: it remains (M, fV, g, c), g : M = W q0,
--     c p : g = fV p . e p q0.  Regrouped as ((M, g), p |-> (fV p, c p))
--     (inverse maps, definitionally); (M, g) is a singleton, and for each
--     p the type (h : M = V p) * (g = h . e p q0) is contractible (post):
--     by J on e p q0, at refl it is the based singleton of g (h . refl = h).
-- Function extensionality and weak funext (from univ); no new axioms.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module CH = FunExtUA[l+] ;
module E1 = FunExtUA[l+].FE[univ @(l+)] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module SG = SipGeneric[l+] ;
-- the singleton based at its first point
based (A : U l+) (a : A) : CH.isContr ((y : A) * Id A a y) =
 ((a,refl a),\ w -> idJ A a (\ y1 q -> Id ((y2 : A) * Id A a y2) (a,refl a) (y1,q)) (refl (a,refl a)) w.1 w.2) ;
-- a Sigma of contractible types
ctr-sigma (A : U l+) (B : A -> U l+) (kA : CH.isContr A) (kB : (a : A) -> CH.isContr (B a)) :
 CH.isContr ((a : A) * B a) =
 ((kA.1,(kB kA.1).1),\ w -> Pr1.Sigma-path A B kA.1 w.1 (kB kA.1).1 w.2 (kA.2 w.1)
   (CH.pathC (B w.1) (kB w.1) (Pr1.subst A B kA.1 w.1 (kA.2 w.1) (kB kA.1).1) w.2)) ;
-- (post)  (h : M = z) * (g = h . E) is contractible
post (T : U l+) (M z y : T) (E : Id T z y) :
 (g : Id T M y) -> CH.isContr ((h : Id T M z) * Id (Id T M y) g (Pr1.trans T M z y h E)) =
 idJ T z (\ y1 E1' -> (g : Id T M y1) -> CH.isContr ((h : Id T M z) * Id (Id T M y1) g (Pr1.trans T M z y1 h E1')))
  (\ g -> based (Id T M z) g) y E ;
-- (pointed)
module Pointed (P : U l) (pP : Pr.isProp P) (p0 : P) {
 extend (C : P -> U l+) (c : C p0) (p : P) : C p = Pr1.subst P C p0 p (pP p0 p) c ;
 determined (C : P -> U l+) (f : (p : P) -> C p) (p : P) (r : Id P p0 p) :
  Id (C p) (Pr1.subst P C p0 p r (f p0)) (f p) =
  idJ P p0 (\ z r' -> Id (C z) (Pr1.subst P C p0 z r' (f p0)) (f z)) (refl (f p0)) p r ;
 restrict (A : U l+) (C : A -> P -> U l+) (k : CH.isContr ((a : A) * C a p0)) :
  CH.isContr ((a : A) * ((p : P) -> C a p)) =
  SG.ctr-retract ((a : A) * C a p0) ((a : A) * ((p : P) -> C a p)) k
   (\ w -> (w.1,w.2 p0)) (\ v -> (v.1,extend (C v.1) v.2))
   (\ w -> Pr1.ap ((p : P) -> C w.1 p) ((a : A) * ((p : P) -> C a p)) (\ f -> (w.1,f))
     (extend (C w.1) (w.2 p0)) w.2
     (F1.funext P (C w.1) (extend (C w.1) (w.2 p0)) w.2 (\ p -> determined (C w.1) w.2 p (pP p0 p)))) ;
 cone (A : U l+) (k : P -> A) : CH.isContr ((a : A) * ((p : P) -> Id A a (k p))) =
  restrict A (\ a p -> Id A a (k p)) (CH.sing A (k p0)) ;
} ;
module Over (T : U l+) (P Q : U l) (pP : Pr.isProp P) (pQ : Pr.isProp Q)
 (V : P -> T) (W : Q -> T) (e : (p : P) (q : Q) -> Id T (V p) (W q)) {
 Anchor : U l+ = (M : T) * ((p : P) -> Id T M (V p)) ;
 -- p |-> fV p . e p q
 through (x : Anchor) (q : Q) (p : P) : Id T x.1 (W q) = Pr1.trans T x.1 (V p) (W q) (x.2 p) (e p q) ;
 Fit (x : Anchor) (q : Q) : U l+ = (g : Id T x.1 (W q)) * ((p : P) -> Id (Id T x.1 (W q)) g (through x q p)) ;
 Glue : U l+ = (x : Anchor) * ((q : Q) -> Fit x q) ;
 carrier (g : Glue) : T = g.1.1 ;
 to-V (g : Glue) (p : P) : Id T (carrier g) (V p) = g.1.2 p ;
 to-W (g : Glue) (q : Q) : Id T (carrier g) (W q) = (g.2 q).1 ;
 coherence (g : Glue) (p : P) (q : Q) :
  Id (Id T (carrier g) (W q)) (to-W g q) (Pr1.trans T (carrier g) (V p) (W q) (to-V g p) (e p q)) = (g.2 q).2 p ;
 -- (from p0)
 module FromV (p0 : P) {
  module PP = Pointed[P,pP,p0] ;
  theorem : CH.isContr Glue =
   ctr-sigma Anchor (\ x -> (q : Q) -> Fit x q) (PP.cone T V)
    (\ x -> E1.wfe Q (Fit x) (\ q -> PP.cone (Id T x.1 (W q)) (through x q))) ;
 } ;
 -- (from q0)
 module FromW (q0 : Q) {
  module PQ = Pointed[Q,pQ,q0] ;
  Ends : U l+ = (M : T) * Id T M (W q0) ;
  Side (y : Ends) (p : P) : U l+ =
   (h : Id T y.1 (V p)) * Id (Id T y.1 (W q0)) y.2 (Pr1.trans T y.1 (V p) (W q0) h (e p q0)) ;
  Regrouped : U l+ = (y : Ends) * ((p : P) -> Side y p) ;
  regrouped : CH.isContr Regrouped =
   ctr-sigma Ends (\ y -> (p : P) -> Side y p) (CH.sing T (W q0))
    (\ y -> E1.wfe P (Side y) (\ p -> post T y.1 (V p) (W q0) (e p q0) y.2)) ;
  at-q0 : CH.isContr ((x : Anchor) * Fit x q0) =
   SG.ctr-retract Regrouped ((x : Anchor) * Fit x q0) regrouped
    (\ w -> ((w.1.1,w.2.1),\ p -> (w.1.2 p,w.2.2 p)))
    (\ v -> ((v.1.1,\ p -> (v.2 p).1),(v.1.2,\ p -> (v.2 p).2)))
    (\ w -> refl w) ;
  theorem : CH.isContr Glue = PQ.restrict Anchor Fit at-q0 ;
 } ;
 contr-of : Plus P Q -> CH.isContr Glue = split {
  inl p -> FromV[p].theorem ; inr q -> FromW[q].theorem } ;
 contractible (c : Tr.Trunc[Plus P Q].carrier) : CH.isContr Glue =
  Tr.Trunc[Plus P Q].induction @(l+) (\ t -> CH.isContr Glue) (\ t -> AffineHLevels[l+].contr-prop Glue) contr-of c ;
 -- the gluing
 glue (c : Tr.Trunc[Plus P Q].carrier) : Glue = (contractible c).1 ;
} ;
