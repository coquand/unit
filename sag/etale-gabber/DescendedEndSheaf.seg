-- The descended endomorphism algebra is a sheaf whenever its fibre
-- endomorphism carriers are sheaves. Invariant sections form a Sigma:
-- a product of those carriers, with a predicate consisting of products
-- of their identity types. Sheaves are closed under these operations.
-- In particular this uses neither a chosen gerbe object nor object descent.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (I : U l) (G : I -> U l) {
 module DE = DescendedEnd[l].Over[R,setR] ;
 module T = SheafTopology[l].Over[I,G] ;
 module S = SheafLemmas[l,l].Over[I,G] ;
 module At (B : DE.TM.Banded) (V : B.1 -> DE.TM.MD.Module)
  (chi : DE.TM.UG.Unit -> DE.TM.UG.Unit) (weight : DE.TM.At[DE.TM.charge B].Weight chi V)
  (fibres : (g : B.1) -> T.isModal @l (DE.EN.At[V g].algebra.A)) {
  module D = DE.At[B,V,chi,weight] ;
  predicate (s : D.IV.Total.M) : T.isModal @l (D.IV.Inv s) =
   S.modal-Pi B.1 (\ g -> (h : B.1) (p : Id B.1 g h) ->
     Id (D.T.Homs[V,V].H h).M (D.MV.move g h p (s g)) (s h)) (\ g ->
    S.modal-Pi B.1 (\ h -> (p : Id B.1 g h) ->
     Id (D.T.Homs[V,V].H h).M (D.MV.move g h p (s g)) (s h)) (\ h ->
     S.modal-Pi (Id B.1 g h) (\ p -> Id (D.T.Homs[V,V].H h).M (D.MV.move g h p (s g)) (s h)) (\ p ->
      S.modal-Id (D.T.Homs[V,V].H h).M (fibres h) (D.MV.move g h p (s g)) (s h)))) ;
  sheaf : T.isModal @l D.algebra.A =
   S.modal-Sigma D.IV.Total.M D.IV.Inv
    (S.modal-Pi B.1 (\ g -> (D.T.Homs[V,V].H g).M) fibres) predicate ;
 } ;
} ;
