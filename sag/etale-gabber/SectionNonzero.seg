-- Positive-rank fibres prevent the section module from being zero, when
-- the family has global frame data and its base is not-not inhabited.
-- If all sections vanish, the generating sections of the frame vanish.
-- Its reconstruction law then makes every fibre zero. A positive-rank
-- basis contradicts this: a coordinate of a basis vector is both 0 and 1.
-- No assertion that sections of an arbitrary family detect its fibres is
-- used. The affine corollary obtains global data from AffineFrameData,
-- retaining precisely the information AffineFrameProjector forgets.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module D = MnSums[l].Over[R] ;
 module Module (M : MD.Module) {
  Zero : U l = (m : M.M) -> Id M.M m M.mz ;
  zero-basis (b : LF.Basis[M,zero]) : Zero = \ m -> sym (b.frame.law m) ;
  module Positive (n : Nat) (b : LF.Basis[M,suc n]) {
   index : Fin (suc n) = inr tt ;
   contradiction (z : Zero) : Empty = axioms.loc.1 (calc R.R {
    R.o =< sym (D.delta-diag (suc n) index) > D.delta (suc n) index index
     =< sym (b.dual index index) > (b.frame.form index).1 (b.frame.vector index)
     =< ap (b.frame.form index).1 (z (b.frame.vector index)) > (b.frame.form index).1 M.mz
     =< FR.Form[M,b.frame.form index].zero > R.z }) ;
  } ;
  nonzero (n : Nat) (b : Tr.Trunc[LF.Basis[M,suc n]].carrier) : Not Zero = \ z ->
   Tr.Trunc[LF.Basis[M,suc n]].induction @l (\ b -> Empty) (\ b -> (\ a b -> efq a))
    (\ b -> Positive[n,b].contradiction z) b ;
 } ;
 module OnAffine (A : Algebras[l].Over[R,setR].Algebra) (fp : Presentations[l].Over[R,setR].FP A)
  (Mx : Algebras[l].Over[R,setR].Spec A -> MD.Module) {
  module FP = FrameProjector[l].Over[R,setR,axioms].At[A,fp,Mx] ;
  module Sections = Module[MD.pi FP.X Mx] ;
  module Given (w : FP.Data) {
   module At (x : FP.X) {
    module MA = Alg73[l].MA[MD.ring,Mx x] ;
    module Sums = ModuleSumLaws[l].Over[R,setR,Mx x] ;
    zero-fibre (z : Sections.Zero) : Module[Mx x].Zero = \ m ->
     trans (sym (w.law x m))
      (Sums.sum-zero w.size (\ k -> (Mx x).sm ((w.form k x).1 m) (w.section k x))
       (\ k -> trans (ap ((Mx x).sm ((w.form k x).1 m)) (Pr.happly FP.X (\ x -> (Mx x).M) _ _ (z (w.section k)) x))
        (MA.sm-zr ((w.form k x).1 m)))) ;
   } ;
   nonzero (inh : Not (Not FP.X)) (r : Nat)
    (bases : (x : FP.X) -> Tr.Trunc[LF.Basis[Mx x,suc r]].carrier) : Not Sections.Zero = \ z ->
    inh (\ x -> Module[Mx x].nonzero r (bases x) (At[x].zero-fibre z)) ;
  } ;
  module Positive (inh : Not (Not FP.X)) (r : Nat)
   (bases : (x : FP.X) -> Tr.Trunc[LF.Basis[Mx x,suc r]].carrier) {
   frames (x : FP.X) : Tr.Trunc[FR.Frame[Mx x,suc r]].carrier =
    Tr.Trunc[LF.Basis[Mx x,suc r]].induction @l (\ b -> Tr.Trunc[FR.Frame[Mx x,suc r]].carrier)
     (\ b -> Tr.Trunc[FR.Frame[Mx x,suc r]].proposition) (\ b -> Tr.Trunc[FR.Frame[Mx x,suc r]].inc b.frame) (bases x) ;
   frame-data : Tr.Trunc[FP.Data].carrier = AffineFrameData[l].Over[R,setR,axioms].At[A,fp,Mx,suc r,frames].theorem ;
   nonzero : Not Sections.Zero = \ z ->
    Tr.Trunc[FP.Data].induction @l (\ w -> Empty) (\ w -> (\ a b -> efq a)) (\ w -> Given[w].nonzero inh r bases z) frame-data ;
   no-zero-basis : Not (LF.Basis[MD.pi FP.X Mx,zero]) = \ b -> nonzero (Sections.zero-basis b) ;
  } ;
 } ;
} ;
