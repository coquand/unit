-- Paths.seg: the path lemmas of Prelude with HIDDEN type and endpoints
-- (examples/hidden.seg), for new files.  Each is the Prelude lemma, so the
-- two forms unfold to the same term.

level l ;
open Base ;


symH {A : U l} {x y : A} (p : Id A x y) : Id A y x = Prelude[l].sym A x y p ;

transH {A : U l} {x y z : A} (p : Id A x y) (q : Id A y z) : Id A x z = Prelude[l].trans A x y z p q ;

apH {A B : U l} (f : A -> B) {x y : A} (p : Id A x y) : Id B (f x) (f y) = Prelude[l].ap A B f x y p ;

substH {A : U l} (F : A -> U l) {x y : A} (p : Id A x y) (u : F x) : F y = Prelude[l].subst A F x y p u ;

happlyH {A : U l} {B : A -> U l} {f g : (x : A) -> B x} (p : Id ((x : A) -> B x) f g) (x : A)
  : Id (B x) (f x) (g x) = Prelude[l].happly A B f g p x ;

-- J with the RIGHT endpoint fixed (Agda's dot patterns  f .(suc k) (c k refl)):
-- computes on refl
idJR (A : U l) (b : A) (P : (a : A) -> Id A a b -> U l) (base : P b (refl b)) (a : A) (p : Id A a b) : P a p =
  idJ A a (\ x q -> (P' : (a' : A) -> Id A a' x -> U l) -> P' x (refl x) -> P' a q) (\ P' r -> r) b p P base ;
