-- Finite certificates shared by the affine geometry and Horrocks workers.
-- This file defines the interface; it does not assume Horrocks.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module Pow = AffinePowers[l].Over[A] ;
 module Size (n : Nat) {
  Vector : U l = Fin n -> R ;
  Matrix : U l = Fin n -> Vector ;
  dot (v w : Vector) : R = S.sum n (\ i -> mul (v i) (w i)) ;
  action (e : Matrix) (v : Vector) : Vector = \ i -> dot (e i) v ;
  record Projector {
   entry : Matrix ;
   idempotent : (i j : Fin n) ->
    Id R (S.sum n (\ k -> mul (entry i k) (entry k j))) (entry i j) ;
   coefficients : Matrix ;
   full : Id R
    (S.sum n (\ i -> S.sum n (\ j -> mul (coefficients i j) (entry i j)))) o ;
   minors : (i j k h : Fin n) ->
    Id R (mul (entry i j) (entry k h)) (mul (entry i h) (entry k j)) ;
  } ;
  -- No freeness assertion is hidden in Projector.
  ScalarFactor (e : Matrix) (a : R) : U l =
   (x y : Vector) *
   ((i j : Fin n) -> Id R (mul (x i) (y j)) (mul a (e i j))) *
   Id R (dot y x) a ;
  Factors (e : Matrix) : U l = ScalarFactor e o ;
  Free (e : Matrix) : U l = Tr.Trunc[Factors e].carrier ;
  LocalFactors (e : Matrix) (f : R) : U l =
   (k : Nat) * ScalarFactor e (Pow.power f k) ;
  FreeAfter (e : Matrix) (f : R) : U l =
   Tr.Trunc[LocalFactors e f].carrier ;
  -- Already free projectors give the exponent-zero certificate at any f.
  local-zero (e : Matrix) (f : R) (w : Factors e) : LocalFactors e f =
   (zero,w) ;
  free-local (e : Matrix) (f : R) : Free e -> FreeAfter e f =
   Tr.Trunc[Factors e].induction @l (\ w -> FreeAfter e f)
    (\ w -> Tr.Trunc[LocalFactors e f].proposition)
    (\ w -> Tr.Trunc[LocalFactors e f].inc (local-zero e f w)) ;
 } ;
} ;
