-- Gabber's theorem, the Azumaya algebra (Gabber, Ch. II, Theorem 1, the
-- existence part; GABBER-PROPER-DESIGN.md, section 3).
-- Theorem.  A f.p., G : Spec A -> TGerbe (etale R^x-gerbes), Lambda of weight
-- n0+1 on G whose fibres merely have bases of rank 1.  Then merely an N = n+2,
-- a twisted family V on G (weight 1) whose fibres merely have bases of rank N,
-- and at each x an Azumaya algebra E x (DESCENDEDAZUMAYA.Azumaya: a sheaf algebra,
-- locally isomorphic to M_N), namely the descended End(V x) (its evaluation at g : G x is an
-- algebra isomorphism E x = End(V x g), DESCENDEDEND.AtObject), and the map
-- from paths g = g' in G x to isomorphisms (V x g, ev_g) -> (V x g', ev_g') of
-- splittings of E x is an equivalence (loops go to their band scalars).
--  (push)       PUSHMAIN: V with a rank at each x.
--  (normalise)  RANKNORMAL: one rank N.
--  (end)        DESCENDEDAZUMAYA at each x.
--  (compare)    G x -> splitting groupoid of E x, g |-> (V x g, evaluation at g), is
--               fully faithful and carries a loop to its band scalar
--               (SPLITCOMPARISON): E x splits exactly as G x (c = delta(cl E)).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module PM = PushMain[l].Over[R,setR,axioms,loc,sh] ;
 module RN = RankNormal[l].Over[R,setR,axioms,sh] ;
 module DA = DescendedAzumaya[l].Over[R,setR,axioms,sh] ;
 module SC = SplitComparison[l].Over[R,setR,axioms] ;
 Azumaya (n : Nat) : U l+ = DA.Azumaya MnAlgebra[l].Over[R,setR,suc (suc n)].algebra ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TG.TGerbe) (n0 : Nat)
  (Lam : (x : C.Spec A) -> (G x).carrier -> MD.Module)
  (lw : (x : C.Spec A) -> TM.At[TM.charge (TG.At[G x].banded)].Weight (\ c -> TM.UG.power c (suc n0)) (Lam x))
  (bl : (x : C.Spec A) (g : (G x).carrier) -> Tr.Trunc[LF.Basis[Lam x g,suc zero]].carrier) {
  module PA = PM.At[A,fp,G,n0,Lam,lw,bl] ;
  module NA = RN.At[A,fp,G] ;
  X : U l = C.Spec A ;
  Result : U l+ = (n : Nat) * (V : (x : X) -> NA.PA.T x) * (wv : (x : X) -> NA.PA.Twisted x (V x))
   * (bv : (x : X) -> NA.PA.Bases (suc n) x (V x)) * ((x : X) -> Azumaya n)
   * ((x : X) (g g' : (G x).carrier) -> Pr.isEquiv (Id (G x).carrier g g') (SC.At[TG.At[G x].banded,V x,wv x,suc n,bv x].Arrow g g')
      (SC.At[TG.At[G x].banded,V x,wv x,suc n,bv x].phi g g')) ;
  -- (end)
  algebra (q : NA.Result) (x : X) : Azumaya q.1 =
   DA.At[q.1,TG.At[G x].banded,(G x).inh,q.2.1 x,\ a -> a,q.2.2.1 x,q.2.2.2 x].theorem ;
  -- (compare)
  comparison (q : NA.Result) (x : X) (g g' : (G x).carrier) :
   Pr.isEquiv (Id (G x).carrier g g') (SC.At[TG.At[G x].banded,q.2.1 x,q.2.2.1 x,suc q.1,q.2.2.2 x].Arrow g g')
    (SC.At[TG.At[G x].banded,q.2.1 x,q.2.2.1 x,suc q.1,q.2.2.2 x].phi g g') =
   SC.At[TG.At[G x].banded,q.2.1 x,q.2.2.1 x,suc q.1,q.2.2.2 x].full g g' ;
  azumaya (q : NA.Result) : Result = (q.1,q.2.1,q.2.2.1,q.2.2.2,algebra q,comparison q) ;
  -- (push), (normalise)
  normalised (p : PA.Result) : Tr1.Trunc[NA.Result].carrier = NA.normalised p.1 p.2.1 p.2.2 ;
  normalised-result : Tr1.Trunc[NA.Result].carrier = TC1.bind PA.Result NA.Result normalised PA.theorem ;
  theorem : Tr1.Trunc[Result].carrier = TC1.map NA.Result Result azumaya normalised-result ;
 } ;
} ;
