level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 module D = QuadraticIdentities[l].Laws[A] ;
 expand (a v f q r : R) :
  Id R (add a (mul v (add (mul f q) r)))
   (add (mul f (mul v q)) (add a (mul v r))) =
  trans (ap (add a) (dist v (mul f q) r))
   (trans (ap (\ b -> add a (add b (mul v r))) (mul-swap v f q))
    (trans (addA a (mul f (mul v q)) (mul v r))
     (trans (ap (\ b -> add b (mul v r)) (addC a (mul f (mul v q))))
      (sym (addA (mul f (mul v q)) a (mul v r)))))) ;
 insert (u s w : R) :
  Id R (add u s) (add (add w u) (add s (neg w))) =
  sym (trans (swap w u s (neg w))
   (trans (ap (\ v -> add v (add u (neg w))) (addC w s))
    (trans (sym (addA s w (add u (neg w))))
     (trans (ap (add s)
       (trans (ap (add w) (addC u (neg w)))
        (trans (addA w (neg w) u) (trans (ap (\ v -> add v u) (addN w)) (zl u)))))
      (addC s u))))) ;
 identity (a v f q r c : R) :
  Id R (add a (mul v (add (mul f q) r)))
   (add (mul f (add c (mul v q))) (add (add a (mul v r)) (neg (mul f c)))) =
  trans (expand a v f q r)
   (trans (insert (mul f (mul v q)) (add a (mul v r)) (mul f c))
    (ap (\ w -> add w (add (add a (mul v r)) (neg (mul f c))))
     (sym (dist f c (mul v q))))) ;
} ;
