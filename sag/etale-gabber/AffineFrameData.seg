-- On X = Spec Alg (Alg f.p.), a family Mx of modules whose fibres merely
-- have frames of rank r (FRAMES) merely has global frame data
-- (FRAMEPROJECTOR), hence a projector over Alg with image the global
-- sections (AFFINEFRAMEPROJECTOR).  The rank-one case is AFFINELINEDATA.
-- Proof.  The fibres and their duals Mx* are weakly quasi-coherent
-- (Frames.weakly-qc, dual-qc), so 7.1.8 holds for Mx and Mx*
-- (RESTRICTION718).  Z-choice gives g_1 .. g_n unimodular and frames
-- (e_ia, c_ia) of Mx x for x in D(g_i); write d for an inverse of g_i(x).
--  (1) Numerators.  By 7.1.8, for one exponent k_i (EXPONENTREPS,
--      EXPONENTBOUNDS), e_ia = d^k S_ia and c_ia = d^k C_ia on D(g_i), with
--      global sections S_ia of Mx and C_ia of Mx*.  With h_i = g_i^k:
--      S_ia = h_i e_ia and C_ia = h_i c_ia on D(g_i).
--  (2) Killing.  The endomorphism E_i(m) = sum_a C_ia(m) S_ia of Mx x is
--      h_i h_i m on D(g_i):  sum_a h c_ia(m) h e_ia = h h m.  So the
--      linear map delta_i = E_i - h_i h_i vanishes on D(g_i) at the global
--      sections S_jb, and by 7.1.8 one power q_i = g_i^J kills all the
--      delta_i(S_jb).  Then q_i delta_i(m) = 0 for every x and m: merely
--      x is in some D(g_j), where m = sum_b c_jb(m) d^k S_jb, and delta_i
--      is linear.  Hence q_i E_i(m) = G_i m with G_i = q_i h_i h_i.
--  (3) Normalising.  G_i is a unit on D(g_i), so the G_i cover X and are
--      unimodular (AFFINECOVERS): sum_i w_i G_i = 1.  With
--      D_ia = w_i q_i C_ia, indexed by the pairs (i,a) (PAIRING),
--         sum_(i,a) D_ia(m) S_ia = sum_i w_i q_i E_i(m) = sum_i w_i G_i m = m.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module NF = NatFin[l] ; module EB = ExponentBounds[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module RA = MD.RA ;
 module FR = Frames[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module Cov = AffineCovers[l].Over[R,setR,axioms.loc] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (Mx : C.Spec Alg -> MD.Module) (r : Nat)
  (frames : (x : C.Spec Alg) -> Tr.Trunc[FR.Frame[Mx x,r]].carrier) {
  X : U l = C.Spec Alg ;
  module FP = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Mx] ;
  DM (x : X) : MD.Module = FR.dual (Mx x) ;
  -- the operations at a point
  module Pt (x : X) {
   module MA = Alg73[l].MA[MD.ring,Mx x] ;
   module S = ModuleFiniteSums[l].Over[R,setR,Mx x] ;
   module L = ModuleSumLaws[l].Over[R,setR,Mx x] ;
   module H = FR.HM.At[Mx x,Mx x] ;
   module SH = ModuleFiniteSums[l].Over[R,setR,H.carrier] ;
   module PL = Affine[l].PtL[MD.ring,Mx x] ;
   module PD = Affine[l].PtL[MD.ring,DM x] ;
   -- evaluation of a sum of endomorphisms
   module Ev (m : (Mx x).M) {
    module V = ModuleSumLaws[l].Over[R,setR,H.carrier].Map[Mx x,\ f -> f.1 m,
     refl (Mx x).mz,\ u v -> refl ((Mx x).madd (u.1 m) (v.1 m))] ;
   } ;
  } ;
  regular-qc : MD.WeaklyQC MD.regular = RegularQC[l].Over[R,setR,axioms].theorem ;
  affine : FunctionAlgebra[l].Over[R,setR].Affine X =
   Tr1.Trunc[FunctionAlgebra[l].Over[R,setR].AffineWitness X].inc (Alg,fp,Pr.idEquiv X) ;
  scheme : Schemes[l].Over[R,setR].Scheme X = SchemeBasics[l].Over[R,setR].affine X affine ;
  restriction : MD.Restriction X Mx =
   Restriction718[l].Over[R,setR,axioms].At[X,scheme,Mx,
    \ x -> FR.weakly-qc (Mx x) r (frames x) regular-qc].theorem-7-1-8 ;
  dual-restriction : MD.Restriction X DM =
   Restriction718[l].Over[R,setR,axioms].At[X,scheme,DM,
    \ x -> FR.dual-qc (Mx x) r (frames x) regular-qc].theorem-7-1-8 ;
  module Cover (c : Ax.ChoiceData Alg (\ x -> FR.Frame[Mx x,r])) {
   n : Nat = c.1 ;
   fs : Fin n -> Alg.ring.R = c.2.1 ;
   g (i : Fin n) (x : X) : R.R = x.1.1 (fs i) ;
   frame (i : Fin n) (x : X) (u : RL[R].unit (g i x)) : FR.Frame[Mx x,r] = c.2.2.2 i x u ;
   module Ex (i : Fin n) {
    module L = ExponentReps[l].Over[R,setR].At[X,Mx,g i] ;
    module D = ExponentReps[l].Over[R,setR].At[X,DM,g i] ;
   } ;
   e (i : Fin n) (a : Fin r) : Ex[i].L.Local = \ x u -> (frame i x u).vector a ;
   cf (i : Fin n) (a : Fin r) : Ex[i].D.Local = \ x u -> (frame i x u).form a ;
   -- (1)
   Numerators (i : Fin n) : Nat -> U l =
    EB.Both (EB.All r (\ a -> Ex[i].L.Rep (e i a))) (EB.All r (\ a -> Ex[i].D.Rep (cf i a))) ;
   numerators (i : Fin n) : EB.Merely (Numerators i) =
    EB.both (EB.All r (\ a -> Ex[i].L.Rep (e i a))) (EB.All r (\ a -> Ex[i].D.Rep (cf i a)))
     (EB.all-monotone r (\ a -> Ex[i].L.Rep (e i a)) (\ a -> Ex[i].L.rep-monotone (e i a)))
     (EB.all-monotone r (\ a -> Ex[i].D.Rep (cf i a)) (\ a -> Ex[i].D.rep-monotone (cf i a)))
     (EB.merely-common r (\ a -> Ex[i].L.Rep (e i a)) (\ a -> Ex[i].L.rep-monotone (e i a))
      (\ a -> Ex[i].L.represent restriction (e i a)))
     (EB.merely-common r (\ a -> Ex[i].D.Rep (cf i a)) (\ a -> Ex[i].D.rep-monotone (cf i a))
      (\ a -> Ex[i].D.represent dual-restriction (cf i a))) ;
   module Raised (nb : (i : Fin n) -> EB.Bound (Numerators i)) {
    k (i : Fin n) : Base.Nat = NF.toN (nb i).1 ;
    S (i : Fin n) (a : Fin r) : FP.Sections = ((nb i).2.1 a).1 ;
    Cf (i : Fin n) (a : Fin r) : FP.Forms = ((nb i).2.2 a).1 ;
    S-eq (i : Fin n) (a : Fin r) (x : X) (u : RL[R].unit (g i x)) :
     Id (Mx x).M (e i a x u) ((Mx x).sm (RA.pw u.1 (k i)) (S i a x)) = ((nb i).2.1 a).2 x u ;
    C-eq (i : Fin n) (a : Fin r) (x : X) (u : RL[R].unit (g i x)) :
     Id (DM x).M (cf i a x u) ((DM x).sm (RA.pw u.1 (k i)) (Cf i a x)) = ((nb i).2.2 a).2 x u ;
    h (i : Fin n) (x : X) : R.R = RA.pw (g i x) (k i) ;
    inverse (i : Fin n) (x : X) (u : RL[R].unit (g i x)) : Id R.R (R.mul u.1 (g i x)) R.o =
     trans (R.mulC u.1 (g i x)) u.2 ;
    S-local (i : Fin n) (a : Fin r) (x : X) (u : RL[R].unit (g i x)) :
     Id (Mx x).M (S i a x) ((Mx x).sm (h i x) (e i a x u)) =
     trans (sym (Pt[x].PL.cancel-pw u.1 (g i x) (inverse i x u) (k i) (S i a x)))
      (ap ((Mx x).sm (h i x)) (sym (S-eq i a x u))) ;
    C-local (i : Fin n) (a : Fin r) (x : X) (u : RL[R].unit (g i x)) :
     Id (DM x).M (Cf i a x) ((DM x).sm (h i x) (cf i a x u)) =
     trans (sym (Pt[x].PD.cancel-pw u.1 (g i x) (inverse i x u) (k i) (Cf i a x)))
      (ap ((DM x).sm (h i x)) (sym (C-eq i a x u))) ;
    -- (2) the endomorphism E_i, as a linear map
    rank-one (i : Fin n) (a : Fin r) (x : X) : Pt[x].H.S.E =
     (\ m -> (Mx x).sm ((Cf i a x).1 m) (S i a x),
      \ m m' -> trans (ap (\ t -> (Mx x).sm t (S i a x)) ((Cf i a x).2.1 m m'))
       ((Mx x).smE ((Cf i a x).1 m) ((Cf i a x).1 m') (S i a x)),
      \ t m -> trans (ap (\ y -> (Mx x).sm y (S i a x)) ((Cf i a x).2.2 t m))
       (sym ((Mx x).smA t ((Cf i a x).1 m) (S i a x)))) ;
    E (i : Fin n) (x : X) (m : (Mx x).M) : (Mx x).M =
     Pt[x].S.sum r (\ a -> (Mx x).sm ((Cf i a x).1 m) (S i a x)) ;
    endomorphism (i : Fin n) (x : X) : Pt[x].H.S.E = Pt[x].SH.sum r (\ a -> rank-one i a x) ;
    endomorphism-at (i : Fin n) (x : X) (m : (Mx x).M) :
     Id (Mx x).M ((endomorphism i x).1 m) (E i x m) = Pt[x].Ev[m].V.sum r (\ a -> rank-one i a x) ;
    G0 (i : Fin n) (x : X) : R.R = R.mul (h i x) (h i x) ;
    -- sm (h c) (sm h e) = sm (h h) (sm c e)
    regroup (x : X) (h c : R.R) (v : (Mx x).M) :
     Id (Mx x).M ((Mx x).sm (R.mul h c) ((Mx x).sm h v)) ((Mx x).sm (R.mul h h) ((Mx x).sm c v)) =
     trans (sym ((Mx x).smA h c ((Mx x).sm h v)))
      (trans (ap ((Mx x).sm h) (Pt[x].MA.sm-swap c h v)) ((Mx x).smA h h ((Mx x).sm c v))) ;
    E-local (i : Fin n) (x : X) (u : RL[R].unit (g i x)) (m : (Mx x).M) :
     Id (Mx x).M (E i x m) ((Mx x).sm (G0 i x) m) =
     trans (Pt[x].S.congruent r (\ a -> (Mx x).sm ((Cf i a x).1 m) (S i a x))
      (\ a -> (Mx x).sm (G0 i x) ((Mx x).sm (((frame i x u).form a).1 m) ((frame i x u).vector a)))
      (\ a -> trans (ap (\ t -> (Mx x).sm t (S i a x)) (ap (\ phi -> phi.1 m) (C-local i a x u)))
       (trans (ap ((Mx x).sm (R.mul (h i x) (((frame i x u).form a).1 m))) (S-local i a x u))
        (regroup x (h i x) (((frame i x u).form a).1 m) ((frame i x u).vector a)))))
      (trans (sym (Pt[x].L.scale-sum (G0 i x) r
        (\ a -> (Mx x).sm (((frame i x u).form a).1 m) ((frame i x u).vector a))))
       (ap ((Mx x).sm (G0 i x)) ((frame i x u).law m))) ;
    -- delta_i = E_i - h_i h_i, a linear map
    identity (x : X) : Pt[x].H.S.E =
     (\ m -> m,\ m m' -> refl ((Mx x).madd m m'),\ t m -> refl ((Mx x).sm t m)) ;
    delta (i : Fin n) (x : X) : Pt[x].H.S.E =
     Pt[x].H.carrier.madd (endomorphism i x)
      (Pt[x].H.carrier.mneg (Pt[x].H.carrier.sm (G0 i x) (identity x))) ;
    delta-at (i : Fin n) (x : X) (m : (Mx x).M) :
     Id (Mx x).M ((delta i x).1 m) (Pt[x].MA.sub (E i x m) ((Mx x).sm (G0 i x) m)) =
     ap (\ v -> (Mx x).madd v ((Mx x).mneg ((Mx x).sm (G0 i x) m))) (endomorphism-at i x m) ;
    delta-zero (i : Fin n) (x : X) : Id (Mx x).M ((delta i x).1 (Mx x).mz) (Mx x).mz =
     DescentSubmodules[l].Over[MD.ring].Lin[Mx x,Mx x,delta i x].map-z ;
    delta-combination (i : Fin n) (x : X) (p : Nat) (b : Fin p -> R.R) (v : Fin p -> (Mx x).M) :
     Id (Mx x).M ((delta i x).1 (Pt[x].S.sum p (\ c -> (Mx x).sm (b c) (v c))))
      (Pt[x].S.sum p (\ c -> (Mx x).sm (b c) ((delta i x).1 (v c)))) =
     Pt[x].L.Map[Mx x,(delta i x).1,delta-zero i x,(delta i x).2.1].combination (delta i x).2.2 p b v ;
    -- the global sections delta_i(S_jb) vanish on D(g_i)
    killed (i j : Fin n) (b : Fin r) : Ex[i].L.Global = \ x -> (delta i x).1 (S j b x) ;
    vanish (i j : Fin n) (b : Fin r) (x : X) (u : RL[R].unit (g i x)) :
     Id (Mx x).M (killed i j b x) (Mx x).mz =
     trans (delta-at i x (S j b x))
      (trans (ap (\ v -> Pt[x].MA.sub v ((Mx x).sm (G0 i x) (S j b x))) (E-local i x u (S j b x)))
       (Pt[x].MA.sub-self ((Mx x).sm (G0 i x) (S j b x)))) ;
    Kills (i : Fin n) : Nat -> U l = EB.All n (\ j -> EB.All r (\ b -> Ex[i].L.Kill (killed i j b))) ;
    kills (i : Fin n) : EB.Merely (Kills i) =
     EB.merely-common n (\ j -> EB.All r (\ b -> Ex[i].L.Kill (killed i j b)))
      (\ j -> EB.all-monotone r (\ b -> Ex[i].L.Kill (killed i j b)) (\ b -> Ex[i].L.kill-monotone (killed i j b)))
      (\ j -> EB.merely-common r (\ b -> Ex[i].L.Kill (killed i j b)) (\ b -> Ex[i].L.kill-monotone (killed i j b))
       (\ b -> Ex[i].L.kill restriction (killed i j b) (vanish i j b))) ;
    -- on D(g_j), m = sum_b c_jb(m) d^k S_jb
    coefficient (j : Fin n) (x : X) (u : RL[R].unit (g j x)) (m : (Mx x).M) (b : Fin r) : R.R =
     R.mul (((frame j x u).form b).1 m) (RA.pw u.1 (k j)) ;
    expand (j : Fin n) (x : X) (u : RL[R].unit (g j x)) (m : (Mx x).M) :
     Id (Mx x).M m (Pt[x].S.sum r (\ b -> (Mx x).sm (coefficient j x u m b) (S j b x))) =
     trans (sym ((frame j x u).law m))
      (Pt[x].S.congruent r (\ b -> (Mx x).sm (((frame j x u).form b).1 m) ((frame j x u).vector b))
       (\ b -> (Mx x).sm (coefficient j x u m b) (S j b x))
       (\ b -> trans (ap ((Mx x).sm (((frame j x u).form b).1 m)) (S-eq j b x u))
        ((Mx x).smA (((frame j x u).form b).1 m) (RA.pw u.1 (k j)) (S j b x)))) ;
    module Killed (kb : (i : Fin n) -> EB.Bound (Kills i)) {
     q (i : Fin n) (x : X) : R.R = RA.pw (g i x) (NF.toN (kb i).1) ;
     on-frames (i j : Fin n) (b : Fin r) (x : X) :
      Id (Mx x).M ((Mx x).sm (q i x) (killed i j b x)) (Mx x).mz = (kb i).2 j b x ;
     at-open (i : Fin n) (x : X) (m : (Mx x).M) (j : Fin n) (u : RL[R].unit (g j x)) :
      Id (Mx x).M ((Mx x).sm (q i x) ((delta i x).1 m)) (Mx x).mz =
      trans (ap (\ v -> (Mx x).sm (q i x) ((delta i x).1 v)) (expand j x u m))
       (trans (ap ((Mx x).sm (q i x)) (delta-combination i x r (coefficient j x u m) (\ b -> S j b x)))
        (trans (Pt[x].L.scale-sum (q i x) r (\ b -> (Mx x).sm (coefficient j x u m b) ((delta i x).1 (S j b x))))
         (Pt[x].L.sum-zero r
          (\ b -> (Mx x).sm (q i x) ((Mx x).sm (coefficient j x u m b) ((delta i x).1 (S j b x))))
          (\ b -> trans (Pt[x].MA.sm-swap (q i x) (coefficient j x u m b) ((delta i x).1 (S j b x)))
           (trans (ap ((Mx x).sm (coefficient j x u m b)) (on-frames i j b x))
            (Pt[x].MA.sm-zr (coefficient j x u m b))))))) ;
     everywhere (i : Fin n) (x : X) (m : (Mx x).M) :
      Id (Mx x).M ((Mx x).sm (q i x) ((delta i x).1 m)) (Mx x).mz =
      Tr.Trunc[(j : Fin n) * RL[R].unit (g j x)].induction @l
       (\ z -> Id (Mx x).M ((Mx x).sm (q i x) ((delta i x).1 m)) (Mx x).mz)
       (\ z -> (Mx x).setM ((Mx x).sm (q i x) ((delta i x).1 m)) (Mx x).mz)
       (\ ju -> at-open i x m ju.1 ju.2)
       (Cov.At[Alg,n,fs].cover c.2.2.1 x) ;
     -- q_i E_i = G_i
     Gfun (i : Fin n) (x : X) : R.R = R.mul (q i x) (G0 i x) ;
     normalised (i : Fin n) (x : X) (m : (Mx x).M) :
      Id (Mx x).M ((Mx x).sm (q i x) (E i x m)) ((Mx x).sm (Gfun i x) m) =
      trans (Pt[x].MA.sub-zero ((Mx x).sm (q i x) (E i x m)) ((Mx x).sm (q i x) ((Mx x).sm (G0 i x) m))
        (trans (sym (Pt[x].MA.sm-sub (q i x) (E i x m) ((Mx x).sm (G0 i x) m)))
         (trans (ap ((Mx x).sm (q i x)) (sym (delta-at i x m))) (everywhere i x m))))
       ((Mx x).smA (q i x) (G0 i x) m) ;
     -- (3)
     gs (i : Fin n) : Alg.ring.R = FP.back (Gfun i) ;
     gs-beta (i : Fin n) (x : X) : Id R.R (x.1.1 (gs i)) (Gfun i x) = FP.back-beta (Gfun i) x ;
     power-unit (a : R.R) (u : RL[R].unit a) (p : Base.Nat) : RL[R].unit (RA.pw a p) =
      (RA.pw u.1 p,RA.unit-pw a u.1 u.2 p) ;
     G-unit (i : Fin n) (x : X) (u : RL[R].unit (g i x)) : RL[R].unit (Gfun i x) =
      AffineRing[l].Laws[R,setR].unit-product (q i x) (G0 i x) (power-unit (g i x) u (NF.toN (kb i).1))
       (AffineRing[l].Laws[R,setR].unit-product (h i x) (h i x) (power-unit (g i x) u (k i))
        (power-unit (g i x) u (k i))) ;
     covers (x : X) : StandardOpens[l].Over[R,setR].Union Alg n gs x =
      TC.map ((j : Fin n) * RL[R].unit (g j x)) ((j : Fin n) * RL[R].unit (x.1.1 (gs j)))
       (\ ju -> (ju.1,Pr.subst R.R RL[R].unit (Gfun ju.1 x) (x.1.1 (gs ju.1)) (sym (gs-beta ju.1 x))
        (G-unit ju.1 x ju.2)))
       (Cov.At[Alg,n,fs].cover c.2.2.1 x) ;
     module Normalise (wu : Ax.UnimodularWitness Alg n gs) {
      weight (i : Fin n) (x : X) : R.R = R.mul (x.1.1 (wu.1 i)) (q i x) ;
      unimodular-at (x : X) : Id R.R (RS.sum n (\ i -> R.mul (x.1.1 (wu.1 i)) (Gfun i x))) R.o =
       trans (RS.sum-cong n (\ i -> R.mul (x.1.1 (wu.1 i)) (Gfun i x)) (\ i -> R.mul (x.1.1 (gs i)) (x.1.1 (wu.1 i)))
         (\ i -> trans (R.mulC (x.1.1 (wu.1 i)) (Gfun i x))
          (ap (\ t -> R.mul t (x.1.1 (wu.1 i))) (sym (gs-beta i x)))))
        (trans (sym (StandardOpens[l].SumMap[Alg.ring,R,x.1].combination n gs wu.1))
         (trans (ap x.1.1 wu.2) x.1.2.1)) ;
      N : Nat = Pairing[l].times n r ;
      index (kk : Fin N) : Fin n * Fin r = Pairing[l].unpair r n kk ;
      section-at (p : Fin n * Fin r) : FP.Sections = S p.1 p.2 ;
      form-at (p : Fin n * Fin r) : FP.Forms = \ x -> (DM x).sm (weight p.1 x) (Cf p.1 p.2 x) ;
      term (x : X) (m : (Mx x).M) (p : Fin n * Fin r) : (Mx x).M =
       (Mx x).sm ((form-at p x).1 m) (section-at p x) ;
      -- the inner sum at i is w_i q_i E_i(m)
      inner (x : X) (m : (Mx x).M) (i : Fin n) :
       Id (Mx x).M (Pt[x].S.sum r (\ a -> term x m (index (Pairing[l].pair r n i a))))
        ((Mx x).sm (weight i x) (E i x m)) =
       trans (Pt[x].S.congruent r (\ a -> term x m (index (Pairing[l].pair r n i a)))
         (\ a -> (Mx x).sm (weight i x) ((Mx x).sm ((Cf i a x).1 m) (S i a x)))
         (\ a -> trans (ap (term x m) (Pairing[l].unpair-pair r n i a))
          (sym ((Mx x).smA (weight i x) ((Cf i a x).1 m) (S i a x)))))
        (sym (Pt[x].L.scale-sum (weight i x) r (\ a -> (Mx x).sm ((Cf i a x).1 m) (S i a x)))) ;
      outer (x : X) (m : (Mx x).M) (i : Fin n) :
       Id (Mx x).M ((Mx x).sm (weight i x) (E i x m)) ((Mx x).sm (R.mul (x.1.1 (wu.1 i)) (Gfun i x)) m) =
       trans (sym ((Mx x).smA (x.1.1 (wu.1 i)) (q i x) (E i x m)))
        (trans (ap ((Mx x).sm (x.1.1 (wu.1 i))) (normalised i x m))
         ((Mx x).smA (x.1.1 (wu.1 i)) (Gfun i x) m)) ;
      law (x : X) (m : (Mx x).M) :
       Id (Mx x).M (Pt[x].S.sum N (\ kk -> term x m (index kk))) m =
       trans (Pt[x].L.sum-pair r n (\ kk -> term x m (index kk)))
        (trans (Pt[x].S.congruent n (\ i -> Pt[x].S.sum r (\ a -> term x m (index (Pairing[l].pair r n i a))))
          (\ i -> (Mx x).sm (R.mul (x.1.1 (wu.1 i)) (Gfun i x)) m)
          (\ i -> trans (inner x m i) (outer x m i)))
         (trans (Pt[x].S.sum-scale m n (\ i -> R.mul (x.1.1 (wu.1 i)) (Gfun i x)))
          (trans (ap (\ t -> (Mx x).sm t m) (unimodular-at x)) ((Mx x).smO m)))) ;
      result : FP.Data = new FP.Data[N,\ kk -> section-at (index kk),\ kk -> form-at (index kk),law] ;
     } ;
     result : Tr.Trunc[FP.Data].carrier =
      TC.map (Ax.UnimodularWitness Alg n gs) FP.Data (\ wu -> Normalise[wu].result)
       (Cov.At[Alg,n,gs].unimodular axioms.sqc fp covers) ;
    } ;
    result : Tr.Trunc[FP.Data].carrier =
     TC.bind ((i : Fin n) -> EB.Bound (Kills i)) FP.Data (\ kb -> Killed[kb].result)
      (AffineFinite[l].choice n (\ i -> EB.Bound (Kills i)) kills) ;
   } ;
   result : Tr.Trunc[FP.Data].carrier =
    TC.bind ((i : Fin n) -> EB.Bound (Numerators i)) FP.Data (\ nb -> Raised[nb].result)
     (AffineFinite[l].choice n (\ i -> EB.Bound (Numerators i)) numerators) ;
  } ;
  theorem : Tr.Trunc[FP.Data].carrier =
   TC.bind (Ax.ChoiceData Alg (\ x -> FR.Frame[Mx x,r])) FP.Data (\ c -> Cover[c].result)
    (axioms.zchoice Alg fp (\ x -> FR.Frame[Mx x,r]) frames) ;
 } ;
} ;
