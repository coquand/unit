-- Horner expressions connect coefficient-list polynomials to presentations.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module Raw = Poly[l].PolyR[R] ;
 module RX = C.Polynomial[C.base] ;
 V : U l = Presentations[l].Fin (suc zero) ;
 variable : P.Expr V = var (inr tt) ;
 expression : Raw.P -> P.Expr V = split {
  nil -> cst R.z ; cons b p | ih -> sumE (cst b) (mulE variable ih) } ;
 eval-base (values : V -> R.R) : (p : Raw.P) ->
  Id R.R (P.eval V C.base values (expression p)) (Raw.ev p (values (inr tt))) = split {
   nil -> refl R.z ; cons b p | ih -> ap (\ c -> R.add b (R.mul (values (inr tt)) c)) ih } ;
 eval-polynomial : (p : Raw.P) ->
  Id RX.X.Carrier (P.eval V RX.algebra (\ v -> RX.X.variable) (expression p)) (RX.X.include p) = split {
   nil -> RingHom[l].zero R RX.X.ring RX.X.inclusion ;
   cons b p | ih -> trans (ap (\ c -> RX.X.addQ (RX.X.constant b) (RX.X.mulQ RX.X.variable c)) ih) (sym (RX.X.horner b p)) } ;
 presentation (p : Raw.P) : P.Presentation = (suc zero,cons (expression p) nil) ;
 module For (f : Raw.P) {
  module K = PresentationExistence[l].Over[R,setR,presentation f] ;
  module D = ExpressionCongruence[l].Over[R,setR,presentation f] ;
  Root : U l = (x : R.R) * Id R.R (Raw.ev f x) R.z ;
  solution (x : C.Spec K.A.algebra) : P.Solutions (presentation f) C.base = K.To[C.base].forward x ;
  root (x : C.Spec K.A.algebra) : Root =
   ((solution x).1 (inr tt),trans (sym (eval-base (solution x).1 f)) (solution x).2.1) ;
  no-points (no-root : Root -> Empty) : C.Spec K.A.algebra -> Empty = \ x -> no-root (root x) ;
 } ;
} ;
