-- Gabber's theorem for a coarser topology, for instance the etale one
-- (azumaya1, Section 1: Zariski covers, which are ambient here, and
-- R -> R[X]/(P) for P monic and unramifiable).  Let J -> I pick out some of
-- the generators of ETALETOPOLOGY (the root topology), and let shJ be a
-- closure for the topology they generate.  A J-gerbe is a TGerbe with shJ in
-- place of the root closure and J-sheaves in place of root sheaves.
-- Theorem.  GABBERAZUMAYA holds for J-gerbes.
-- Proof.  A J-gerbe is a TGerbe (with the same carrier and band):
--  (restrict)  a root sheaf is a J-sheaf (fewer generators to test);
--  (weaken)    so shJ A gives close A, by shJ.elim into the root sheaf
--              proposition close A: inh and conn carry over;
--  (H90)       Hilbert 90 for J: a pre-torsor T under R^x that is a J-sheaf
--              and shJ-inhabited is merely inhabited.  As in HILBERT90 (its
--              Line part needs no sheaf condition on T), with (weaken) for
--              the root frame of the associated line, and shJ.elim for the
--              point with f(t) = 1, which is a J-sheaf (T is one, and R is a
--              root sheaf, so a J-sheaf);
--  (paths)     a merely inhabited pre-torsor is a root sheaf: being a sheaf
--              is a proposition, and at a point t0 the torsor is a retract
--              of R^x (a |-> a t0, t |-> t - t0), a root sheaf.
-- So the paths of a J-gerbe, which are pre-torsors under the band, are root
-- sheaves, and GABBERAZUMAYA applies to the TGerbe.
-- ETALE instantiates J with the unramifiable polynomials (UNRAMIFIABLE) and
-- shJ with the closure by etale trees (ETALETREECLOSURE): the etale form of
-- the theorem assumes no closure, only the SAG axioms.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops)
 (J : U l) (e : J -> EtaleTopology[l].Over[R,setR].I)
 (shJ : SheafClosure[l,l].Over[J,\ j -> EtaleTopology[l].Over[R,setR].G (e j)].Ops) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module TJ = SheafTopology[l].Over[J,\ j -> ET.G (e j)] ;
 module SJ = SheafLemmas[l,l].Over[J,\ j -> ET.G (e j)] ;
 module S0 = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module EC = EtaleClosure[l].Over[R,setR,axioms] ;
 module SS = StackSheaf[l].Over[R,setR,axioms,sh] ;
 module LA = LineAssociated[l].Over[R,setR] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module H = Hilbert90[l].Over[R,setR,axioms,sh] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module GA = GabberAzumaya[l].Over[R,setR,axioms,loc,sh] ;
 module GB = TG.GB ;
 -- (restrict)
 restrict (Y : U l) (m : ET.T.isModal @l Y) : TJ.isModal @l Y = \ j -> m (e j) ;
 -- (weaken)
 weaken (A : U l) (c : shJ.close A) : sh.close A =
  shJ.elim @l A (sh.close A) (sh.proposition A) (restrict (sh.close A) (sh.modal A)) (sh.inc A) c ;
 module H90 (T : LA.PreTor) (sheaf : TJ.isModal @l T.1) (local : shJ.close T.1) {
  module LN = H.Line[T] ;
  point-sheaf (w : DL.On[LN.L].Frame (suc zero)) : TJ.isModal @l LN.Fixed[w].Point =
   SJ.modal-Sigma T.1 (\ s -> Id R.R (LN.Fixed[w].f.1 s) R.o) sheaf
    (\ s -> SJ.modal-Id R.R (restrict R.R ER.R-local) (LN.Fixed[w].f.1 s) R.o) ;
  fixed (w : DL.On[LN.L].Frame (suc zero)) : LN.Fixed[w].Point =
   shJ.elim @l T.1 LN.Fixed[w].Point LN.Fixed[w].prop (point-sheaf w) (\ t -> LN.Fixed[w].Near[t].point) local ;
  -- (H90)
  theorem : Tr.Trunc[T.1].carrier =
   Tr.Trunc[DL.On[LN.L].Frame (suc zero)].induction @l (\ z -> Tr.Trunc[T.1].carrier) (\ z -> Tr.Trunc[T.1].proposition)
    (\ w -> Tr.Trunc[T.1].inc (fixed w).1) (LN.frames (weaken T.1 local)) ;
  -- (paths)
  module Pointed (t0 : T.1) {
   module D = LN.LT.Based[t0].D ;
   sheaf-at : ET.T.isModal @l T.1 =
    S0.modal-retract LA.G.Unit T.1 (D.diff t0) (\ a -> T.2.1 a t0) (D.dact t0) SS.unit-sheaf ;
  } ;
  root-sheaf : ET.T.isModal @l T.1 =
   Tr.Trunc[T.1].induction @l (\ z -> ET.T.isModal @l T.1) (\ z -> EC.CL.modal-prop T.1) (\ t0 -> Pointed[t0].sheaf-at) theorem ;
 } ;
 record JGerbe {
  carrier : U l ;
  gpd : (a b : carrier) -> Pr.isSet (Id carrier a b) ;
  inh : shJ.close carrier ;
  conn : (a b : carrier) -> shJ.close (Id carrier a b) ;
  paths : (a b : carrier) -> TJ.isModal @l (Id carrier a b) ;
  band : (x : carrier) -> GB.Band carrier x ;
 } ;
 module Root (Gb : JGerbe) {
  module PT = TG.PathTorsors[Gb.carrier,Gb.gpd,Gb.band] ;
  paths (a b : Gb.carrier) : ET.T.isModal @l (Id Gb.carrier a b) =
   H90[PT.pretorsor a b,Gb.paths a b,Gb.conn a b].root-sheaf ;
  gerbe : TG.TGerbe =
   new TG.TGerbe[Gb.carrier,Gb.gpd,weaken Gb.carrier Gb.inh,\ a b -> weaken (Id Gb.carrier a b) (Gb.conn a b),paths,Gb.band] ;
 } ;
 -- the theorem: GABBERAZUMAYA for a family of J-gerbes over Spec A
 module At (A : GA.C.Algebra) (fp : GA.P.FP A) (G : GA.C.Spec A -> JGerbe) (n0 : Nat)
  (Lam : (x : GA.C.Spec A) -> (G x).carrier -> GA.MD.Module)
  (lw : (x : GA.C.Spec A) -> GA.TM.At[GA.TM.charge (TG.At[Root[G x].gerbe].banded)].Weight (\ c -> GA.TM.UG.power c (suc n0)) (Lam x))
  (bl : (x : GA.C.Spec A) (g : (G x).carrier) -> Tr.Trunc[GA.LF.Basis[Lam x g,suc zero]].carrier) {
  module GAt = GA.At[A,fp,\ x -> Root[G x].gerbe,n0,Lam,lw,bl] ;
  theorem : Tr1.Trunc[GAt.Result].carrier = GAt.theorem ;
 } ;
} ;
-- with the constructed root closure (ETALECLOSURE): the only closure assumed is shJ
module Closed (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (J : U l) (e : J -> EtaleTopology[l].Over[R,setR].I)
 (shJ : SheafClosure[l,l].Over[J,\ j -> EtaleTopology[l].Over[R,setR].G (e j)].Ops) {
 module EG = Over[R,setR,axioms,loc,EtaleClosure[l].Over[R,setR,axioms].ops,J,e,shJ] ;
 module At (A : EG.GA.C.Algebra) (fp : EG.GA.P.FP A) (G : EG.GA.C.Spec A -> EG.JGerbe) (n0 : Nat)
  (Lam : (x : EG.GA.C.Spec A) -> (G x).carrier -> EG.GA.MD.Module)
  (lw : (x : EG.GA.C.Spec A) -> EG.GA.TM.At[EG.GA.TM.charge (EG.TG.At[EG.Root[G x].gerbe].banded)].Weight (\ c -> EG.GA.TM.UG.power c (suc n0)) (Lam x))
  (bl : (x : EG.GA.C.Spec A) (g : (G x).carrier) -> Tr.Trunc[EG.GA.LF.Basis[Lam x g,suc zero]].carrier) {
  theorem : Tr1.Trunc[EG.At[A,fp,G,n0,Lam,lw,bl].GAt.Result].carrier = EG.At[A,fp,G,n0,Lam,lw,bl].theorem ;
 } ;
} ;
-- the etale topology itself: J = unramifiable monic polynomials (UNRAMIFIABLE),
-- shJ = etale trees (ETALETREECLOSURE), root closure ETALECLOSURE.  The
-- theorem then assumes only the SAG axioms (with univalence and replacement
-- in the ambient theory): no closure is a parameter.
module Etale (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module UR = Unramifiable[l].Over[R,setR] ;
 module EG = Over[R,setR,axioms,axioms.loc,EtaleClosure[l].Over[R,setR,axioms].ops,UR.J,UR.e,
  EtaleTreeClosure[l].Over[R,setR,axioms,UR.J,UR.e].ops] ;
 module At (A : EG.GA.C.Algebra) (fp : EG.GA.P.FP A) (G : EG.GA.C.Spec A -> EG.JGerbe) (n0 : Nat)
  (Lam : (x : EG.GA.C.Spec A) -> (G x).carrier -> EG.GA.MD.Module)
  (lw : (x : EG.GA.C.Spec A) -> EG.GA.TM.At[EG.GA.TM.charge (EG.TG.At[EG.Root[G x].gerbe].banded)].Weight (\ c -> EG.GA.TM.UG.power c (suc n0)) (Lam x))
  (bl : (x : EG.GA.C.Spec A) (g : (G x).carrier) -> Tr.Trunc[EG.GA.LF.Basis[Lam x g,suc zero]].carrier) {
  theorem : Tr1.Trunc[EG.At[A,fp,G,n0,Lam,lw,bl].GAt.Result].carrier = EG.At[A,fp,G,n0,Lam,lw,bl].theorem ;
 } ;
} ;
#fails {
 -- a J-sheaf need not be a root sheaf: restrict has no converse
 widen (R : CRing) (setR : Pr.isSet R.R) (J : U l) (e : J -> EtaleTopology[l].Over[R,setR].I) (Y : U l)
  (m : SheafTopology[l].Over[J,\ j -> EtaleTopology[l].Over[R,setR].G (e j)].isModal @l Y) :
  EtaleTopology[l].Over[R,setR].T.isModal @l Y = \ i -> m i ;
} ;
