-- The points of a tower over an affine type form an affine type
-- (GABBER-PROPER-DESIGN.md, section 1; needed for section 3: over Spec A
-- the points of the flattening tower are Spec D with D f.p.).
--  (stage)  Root (d, c) is the solutions of the one-variable presentation
--           of the monic polynomial (ETALEROOTS: root-solutions); so
--           Next d X c = (x : X) * Root (c x) has fibres with uniform
--           presentations in one variable, and is affine (AFFINESIGMA.bounded,
--           bound 1).
--  (tower)  By induction on the shape.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module W = PolynomialPresentation[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module TW = Towers[l].Over[R,setR] ;
 -- (stage)
 root-witness (i : ET.I) : SA.Witness (ET.Root i) =
  (W.presentation EtaleRoots[l].Over[R,setR].At[ET.lower i].B.f,
   (EtaleRoots[l].Over[R,setR].At[ET.lower i].root-solutions,
    Pr.qinv (ET.Root i) (SA.Sol (W.presentation EtaleRoots[l].Over[R,setR].At[ET.lower i].B.f))
     EtaleRoots[l].Over[R,setR].At[ET.lower i].root-solutions EtaleRoots[l].Over[R,setR].At[ET.lower i].solutions-root
     EtaleRoots[l].Over[R,setR].At[ET.lower i].root-solutions-root EtaleRoots[l].Over[R,setR].At[ET.lower i].solutions-root-solutions)) ;
 next (d : Nat) (X : U l) (affine : FA.Affine X) (c : X -> Fin (suc d) -> R.R) : FA.Affine (TW.Next d X c) =
  AffineSigma[l].Over[R,setR,axioms].bounded X affine (\ x -> TW.Root d (c x)) (\ x -> root-witness (d,c x)) (suc zero) (\ x -> tt) ;
 -- (tower)
 points : (s : Towers[l].Shape) (X : U l) (affine : FA.Affine X) (t : TW.Tower s X) -> FA.Affine (TW.Points s X t) = split {
  nil -> \ X affine t -> affine ;
  cons d s | r -> \ X affine t -> r (TW.Next d X t.1) (next d X affine t.1) t.2 } ;
 spec (A : C.Algebra) (fp : P.FP A) : FA.Affine (C.Spec A) =
  Tr1.Trunc[FA.AffineWitness (C.Spec A)].inc (A,fp,Pr.idEquiv (C.Spec A)) ;
 -- over Spec A: merely D f.p. with Points t = Spec D
 over-spec (A : C.Algebra) (fp : P.FP A) (s : Towers[l].Shape) (t : TW.Tower s (C.Spec A)) : FA.Affine (TW.Points s (C.Spec A) t) =
  points s (C.Spec A) (spec A fp) t ;
} ;
