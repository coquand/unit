-- Good modules on standard opens (gabber-recollement, Theorem main: the set
-- Gamma).  A f.p., gerbes G x on Spec A, Lambda of weight n = n0 + 1 whose
-- fibres merely have bases of rank 1.  For s in A, D(s) = (x : Spec A) *
-- x(s) unit (AFFINEINTERFACE.D); a localisation L_s has points
-- p_s : Spec L_s ~ D(s) (AFFINEINTERFACE.spectrum).  dual x F is P(F)^v
-- descended at x: the invariants of g |-> n-linear maps F g^n -> Lambda x g
-- (MULTILINEAR.Family.Dual.descended, which is pointwise).
-- A good module on D(s) (record On.Good): a localisation L_s, a twisted
-- family V on D(s) whose fibres merely have bases of rank r = r0 + 1, with
-- r^n = N = N0 + 1 and rho = 1 at N for every frame data of
-- y |-> dual (p_s y) V(p_s y) on Spec L_s (as GOODMODULES).
-- Gamma s = merely a good module on D(s).
--  (restrict)  Let B be f.p., pi : Spec B -> D(s) and phi : L_s -> B with
--     p_s(y . phi) = pi y.  Then y |-> dual (pi y) V(pi y) is good on Spec B:
--     GOODRESTRICT along phi gives goodness of y |-> dual (p_s (y . phi)) ..,
--     which is this family by (same); the family on Spec L_s merely has frame
--     data (AFFINEFRAMEDATA, from the bases of V and of Lambda).
--  (into)  A map h : A -> B with h(s) a unit factors through L_s
--     (universal property), and y(phi(s/1)) = y(h(s)).
--  (multiple)  s in Gamma gives s c in Gamma: D(s c) is in D(s) (a product is
--     a unit only if its factors are), so V restricts; L_s -> L_(s c)
--     (LOCALIZATIONRINGS.Shrink), the points agree (ALGEBRAS.ext; units are
--     propositions), and (restrict) applies.  L_(s c) exists merely.
--  (transfer)  A good module M on Spec L_s (GOODMODULES, over G . p_s) gives
--     one on D(s): with back = p_s^-1, V z = M (back z) (with its weight and
--     bases) moved along p_s (back z) = z.  Moving along a path does not
--     change dual (idJ), and back (p_s y) = y, so y |-> dual (p_s y) V(p_s y)
--     is y |-> dual (p_s y) M(y), good by hypothesis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ; module TC1 = TruncationCombinators[l+] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module FP = FrameProjector[l].Over[R,setR,axioms] ;
 -- goodness of a family of modules on Spec B, at N = N0 + 1
 module Goodness (B : C.Algebra) (fp : P.FP B) {
  module T = Transposes[l].Over[B.ring,B.set] ;
  module K = K0[l].Over[B.ring,B.set] ;
  Good (N0 : Nat) (M : C.Spec B -> MD.Module) : U l =
   (w : FP.At[B,fp,M].Data) -> Id T.RQ.K.R (T.Rho[N0].rho (K.class FP.At[B,fp,M].From[w].projector)) T.RQ.K.o ;
 } ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TM.GB.AGerbe)
  (n0 : Nat) (Lambda : TM.Family[C.Spec A,G].Weighted (\ c -> TM.UG.power c (suc n0)))
  (bl : (x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier) {
  dual (x : C.Spec A) (F : (G x).1 -> MD.Module) : MD.Module =
   TM.At[TM.charge (TM.banded (G x))].Invariant[\ g -> ML.power (F g) (Lambda.1 x g) (suc n0)].carrier ;
  -- (into)
  module Into (s : A.ring.R) (ls : AI.LocalizationWitness A s) (B : C.Algebra) (h : C.Hom A B)
   (u : AI.Unit B (h.1.1 s)) {
   map : C.Hom ls.1 B = (ls.2.2.2.2 B).sec (h,u) ;
   beta (r : A.ring.R) : Id B.ring.R (map.1.1 (ls.2.2.1.1.1 r)) (h.1.1 r) =
    Pr.ap (AI.LocalData A B s) B.ring.R (\ d -> d.1.1.1 r) _ _ ((ls.2.2.2.2 B).sec-eq (h,u)) ;
  } ;
  module On (s : A.ring.R) {
   module TF = TM.Family[AI.D A s,\ z -> G z.1] ;
   point (ls : AI.LocalizationWitness A s) (y : C.Spec ls.1) : AI.D A s = (AI.spectrum A s ls).1 y ;
   -- the family on Spec L_s whose goodness is asked
   on (ls : AI.LocalizationWitness A s) (V : TF.Twisted) (y : C.Spec ls.1) : MD.Module =
    dual (point ls y).1 (V.1 (point ls y)) ;
   record Good {
    witness : AI.LocalizationWitness A s ;
    rank0 : Nat ;
    family : TF.Twisted ;
    bases : (z : AI.D A s) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[family.1 z g,suc rank0]].carrier ;
    power0 : Nat ;
    power-eq : Id Nat (ML.rank (suc rank0) (suc zero) (suc n0)) (suc power0) ;
    good : Goodness[witness.1,witness.2.1].Good power0 (on witness family) ;
   } ;
   Gamma : U l+ = Tr1.Trunc[Good].carrier ;
   -- G and Lambda on Spec L_s
   gerbe (ls : AI.LocalizationWitness A s) (y : C.Spec ls.1) : TM.GB.AGerbe = G (point ls y).1 ;
   lam (ls : AI.LocalizationWitness A s) : TM.Family[C.Spec ls.1,gerbe ls].Weighted (\ c -> TM.UG.power c (suc n0)) =
    (\ y g -> Lambda.1 (point ls y).1 g,\ y -> Lambda.2 (point ls y).1) ;
   -- (restrict)
   module Restrict (M : Good) (B : C.Algebra) (fpB : P.FP B) (pi : C.Spec B -> AI.D A s)
    (phi : C.Hom M.witness.1 B)
    (same : (y : C.Spec B) -> Id (AI.D A s) (point M.witness (C.compose M.witness.1 B C.base y phi)) (pi y)) {
    module MF = ML.Family[C.Spec M.witness.1,gerbe M.witness] ;
    Vs : MF.TF.Twisted = (\ y g -> M.family.1 (point M.witness y) g,\ y -> M.family.2 (point M.witness y)) ;
    fv : MF.TFr.Framed Vs.1 (suc M.rank0) = \ y g ->
     TC.map (LF.Basis[Vs.1 y g,suc M.rank0]) (FR.Frame[Vs.1 y g,suc M.rank0]) (\ t -> t.frame) (M.bases (point M.witness y) g) ;
    fl : MF.TFr.Framed (lam M.witness).1 (suc zero) = \ y g ->
     TC.map (LF.Basis[(lam M.witness).1 y g,suc zero]) (FR.Frame[(lam M.witness).1 y g,suc zero]) (\ t -> t.frame)
      (bl (point M.witness y).1 g) ;
    Mx : C.Spec M.witness.1 -> MD.Module = on M.witness M.family ;
    mere : Tr.Trunc[FP.At[M.witness.1,M.witness.2.1,Mx].Data].carrier =
     AffineFrameData[l].Over[R,setR,axioms].At[M.witness.1,M.witness.2.1,Mx,ML.rank (suc M.rank0) (suc zero) (suc n0),
      MF.Dual[suc n0,Vs,lam M.witness].descended-frames (suc M.rank0) (suc zero) fv fl].theorem ;
    module GR = GoodRestrict[l].Over[R,setR,axioms].At[M.witness.1,M.witness.2.1,B,fpB,phi,Mx] ;
    target (y : C.Spec B) : MD.Module = dual (pi y).1 (M.family.1 (pi y)) ;
    moved : Id (C.Spec B -> MD.Module) GR.My target =
     F1.funext (C.Spec B) (\ y -> MD.Module) GR.My target
      (\ y -> Pr1.ap (AI.D A s) MD.Module (\ z -> dual z.1 (M.family.1 z)) _ _ (same y)) ;
    theorem : Goodness[B,fpB].Good M.power0 target =
     idJ (C.Spec B -> MD.Module) GR.My (\ T q -> Goodness[B,fpB].Good M.power0 T) (GR.restrict M.power0 M.good mere) target moved ;
   } ;
   -- (transfer)
   module Transfer (ls : AI.LocalizationWitness A s)
    (M : GoodModules[l].Over[R,setR,axioms].At[ls.1,ls.2.1,gerbe ls,n0,lam ls].GoodModule) {
    e : Pr.Equiv (C.Spec ls.1) (AI.D A s) = AI.spectrum A s ls ;
    back (z : AI.D A s) : C.Spec ls.1 = e.2.sec z ;
    Fibre (x : C.Spec A) : U l+ =
     (F : (G x).1 -> MD.Module) * TM.At[TM.charge (TM.banded (G x))].Weight (\ c -> c) F * ((g : (G x).1) -> Tr.Trunc[LF.Basis[F g,suc M.rank0]].carrier) ;
    given (y : C.Spec ls.1) : Fibre (point ls y).1 = (M.family.1 y,M.family.2 y,M.bases y) ;
    move (x0 : C.Spec A) (u : Fibre x0) (x1 : C.Spec A) (q : Id (C.Spec A) x0 x1) : Fibre x1 =
     idJ (C.Spec A) x0 (\ x q' -> Fibre x) u x1 q ;
    moved (z : AI.D A s) : Fibre z.1 = move (point ls (back z)).1 (given (back z)) z.1 (ap (\ t -> t.1) (e.2.sec-eq z)) ;
    family : TF.Twisted = (\ z -> (moved z).1,\ z -> (moved z).2.1) ;
    bases (z : AI.D A s) (g : (G z.1).1) : Tr.Trunc[LF.Basis[family.1 z g,suc M.rank0]].carrier = (moved z).2.2 g ;
    -- moving does not change dual
    keep (x0 : C.Spec A) (u : Fibre x0) (x1 : C.Spec A) (q : Id (C.Spec A) x0 x1) :
     Id MD.Module (dual x1 (move x0 u x1 q).1) (dual x0 u.1) =
     idJ (C.Spec A) x0 (\ x q' -> Id MD.Module (dual x (move x0 u x q').1) (dual x0 u.1)) (refl (dual x0 u.1)) x1 q ;
    given-dual (y : C.Spec ls.1) : MD.Module = dual (point ls y).1 (M.family.1 y) ;
    at (y : C.Spec ls.1) : Id MD.Module (on ls family y) (given-dual y) =
     Pr1.trans MD.Module (on ls family y) (given-dual (back (point ls y))) (given-dual y)
      (keep (point ls (back (point ls y))).1 (given (back (point ls y))) (point ls y).1
       (ap (\ t -> t.1) (e.2.sec-eq (point ls y))))
      (Pr1.ap (C.Spec ls.1) MD.Module given-dual _ _ (Pr.sec-ret (C.Spec ls.1) (AI.D A s) e.1 e.2 y)) ;
    good : Goodness[ls.1,ls.2.1].Good M.power0 (on ls family) =
     idJ (C.Spec ls.1 -> MD.Module) given-dual (\ T q -> Goodness[ls.1,ls.2.1].Good M.power0 T) M.good (on ls family)
      (Pr1.sym (C.Spec ls.1 -> MD.Module) (on ls family) given-dual
       (F1.funext (C.Spec ls.1) (\ y -> MD.Module) (on ls family) given-dual at)) ;
    result : Good = new Good[ls,M.rank0,family,bases,M.power0,M.power-eq,good] ;
   } ;
  } ;
  -- (multiple)
  module Multiple (s c : A.ring.R) (M : On[s].Good) (lc : AI.LocalizationWitness A (A.ring.mul s c)) {
   down (z : AI.D A (A.ring.mul s c)) : AI.D A s =
    (z.1,RR.unit-left (z.1.1.1 s) (z.1.1.1 c) (Pr.subst R.R RL[R].unit _ _ (z.1.1.2.2.2 s c) z.2)) ;
   family : On[A.ring.mul s c].TF.Twisted = (\ z g -> M.family.1 (down z) g,\ z -> M.family.2 (down z)) ;
   bases (z : AI.D A (A.ring.mul s c)) (g : (G z.1).1) : Tr.Trunc[LF.Basis[family.1 z g,suc M.rank0]].carrier =
    M.bases (down z) g ;
   module SH = LocalizationRings[l].Over[R,setR].Shrink[A,s,c,A.ring.mul s c,refl (A.ring.mul s c),M.witness,lc] ;
   pi (y : C.Spec lc.1) : AI.D A s = down (On[A.ring.mul s c].point lc y) ;
   same (y : C.Spec lc.1) : Id (AI.D A s) (On[s].point M.witness (C.compose M.witness.1 lc.1 C.base y SH.map)) (pi y) =
    Pr.Sigma-eq (C.Spec A) (\ x -> RL[R].unit (x.1.1 s)) _ (pi y).1 _ (pi y).2
     (C.ext A C.base _ (pi y).1 (\ r -> ap y.1.1 (SH.beta r))) (RR.unit-prop ((pi y).1.1.1 s)) ;
   good : Goodness[lc.1,lc.2.1].Good M.power0 (On[A.ring.mul s c].on lc family) =
    On[s].Restrict[M,lc.1,lc.2.1,pi,SH.map,same].theorem ;
   result : On[A.ring.mul s c].Good = new On[A.ring.mul s c].Good[lc,M.rank0,family,bases,M.power0,M.power-eq,good] ;
  } ;
  multiple (s c : A.ring.R) (gs : On[s].Gamma) : On[A.ring.mul s c].Gamma =
   TC1.bind On[s].Good On[A.ring.mul s c].Good
    (\ M -> TC1.map (AI.LocalizationWitness A (A.ring.mul s c)) On[A.ring.mul s c].Good
      (\ lc -> Multiple[s,c,M,lc].result) (AI.localize A fp (A.ring.mul s c))) gs ;
  -- Gamma respects equality
  respect (s s' : A.ring.R) (e : Id A.ring.R s s') (gs : On[s].Gamma) : On[s'].Gamma =
   idJ A.ring.R s (\ t q -> On[t].Gamma) gs s' e ;
 } ;
} ;
