-- Hom(P, Q) is presented by the Kronecker product p^T (x) q (CHEAP-DESIGN.md,
-- 2, (i)).  X = Spec Alg (Alg f.p.), P, Q families of modules over X with
-- global frame data (e_a, c_a) of rank r and (f_b, d_b) of rank s
-- (FRAMEPROJECTOR), with projectors p_aa' = back(c_a(e_a')),
-- q_bb' = back(d_b(f_b')).
--  (transpose)  p^T is a projector: (p^T p^T)_ij = sum_k p_ki p_jk
--     = sum_k p_jk p_ki = (p p)_ji = p_ji.
--  (frame)  At each x, Hom(P x, Q x) has the frame of HOMFRAMES indexed by
--     the pairs (a, b) (PAIRING): vectors m |-> c_a(m) f_b, forms
--     phi |-> d_b(phi(e_a)); these are global frame data of Hom(P, Q).
--  (values)  At the pairs k = (a, b), k' = (a', b'):
--         d_b(c_a'(e_a) f_b') = c_a'(e_a) d_b(f_b')         (d_b linear)
--                             = p_a'a(x) q_bb'(x)            (back-beta)
--                             = (p_a'a q_bb')(x)             (x a ring map)
--     and p_a'a q_bb' is the entry of p^T (x) q (KRONECKER) at (k, k'):
--     HOMFRAMES and KRONECKER index pairs by the same Pairing.unpair s r.
-- So by PRESENTEDCLASS.Presented every projector representing the global
-- sections of Hom(P, Q) has the class [p^T (x) q] = [p^T][q] (K0).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (PF QF : C.Spec Alg -> MD.Module)
  (wP : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PF].Data)
  (wQ : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,QF].Data) {
  module PCP = PresentedClass[l].Over[R,setR,axioms].At[Alg,fp,PF] ;
  module PCQ = PresentedClass[l].Over[R,setR,axioms].At[Alg,fp,QF] ;
  module DP = PCP.FP.From[wP] ;
  module DQ = PCQ.FP.From[wQ] ;
  -- the family Hom(P, Q) and its frames at x
  H (x : C.Spec Alg) : MD.Module = HomFrames[l].Over[R,setR].hom (PF x) (QF x) ;
  module PCH = PresentedClass[l].Over[R,setR,axioms].At[Alg,fp,H] ;
  module HF (x : C.Spec Alg) { module F = HomFrames[l].Over[R,setR].Of[PF x,QF x,wP.size,wQ.size,PCP.fibre wP x,PCQ.fibre wQ x] ; } ;
  module KR = Kronecker[l].Over[Alg.ring,Alg.set,wP.size,wQ.size] ;
  N : Nat = Pairing[l].times wP.size wQ.size ;
  -- p^T and the Kronecker product p^T (x) q
  transpose : PCH.K.Projector = Transposes[l].Over[Alg.ring,Alg.set].transpose DP.projector ;
  product : PCH.K.Projector = PCH.K.product transpose DQ.projector ;
  -- by definition, the entries of p^T (x) q
  product-entry (k k' : Fin N) :
   Id Alg.ring.R (product.matrix k k') (Alg.ring.mul (DP.entry (KR.first k') (KR.first k)) (DQ.entry (KR.second k) (KR.second k'))) =
   refl (Alg.ring.mul (DP.entry (KR.first k') (KR.first k)) (DQ.entry (KR.second k) (KR.second k'))) ;
  -- (frame)
  section (k : Fin N) : PCH.FP.Sections = \ x -> HF[x].F.elementary (HF[x].F.index k) ;
  form (k : Fin N) : PCH.FP.Forms = \ x -> HF[x].F.coordinate (HF[x].F.index k) ;
  -- (values), at the components
  value-at (x : C.Spec Alg) (a a' : Fin wP.size) (b b' : Fin wQ.size) :
   Id R.R ((wQ.form b x).1 ((QF x).sm ((wP.form a' x).1 (wP.section a x)) (wQ.section b' x)))
    (x.1.1 (Alg.ring.mul (DP.entry a' a) (DQ.entry b b'))) =
   calc R.R { (wQ.form b x).1 ((QF x).sm ((wP.form a' x).1 (wP.section a x)) (wQ.section b' x))
     =< (wQ.form b x).2.2 ((wP.form a' x).1 (wP.section a x)) (wQ.section b' x) >
        R.mul ((wP.form a' x).1 (wP.section a x)) ((wQ.form b x).1 (wQ.section b' x))
     =< cong2 R.R R.mul _ _ _ _ (sym (DP.beta a' a x)) (sym (DQ.beta b b' x)) >
        R.mul (x.1.1 (DP.entry a' a)) (x.1.1 (DQ.entry b b'))
     =< sym (x.1.2.2.2 (DP.entry a' a) (DQ.entry b b')) > x.1.1 (Alg.ring.mul (DP.entry a' a) (DQ.entry b b')) } ;
  -- by definition, the value of the form k at the section k'
  form-section (k k' : Fin N) (x : C.Spec Alg) :
   Id R.R ((form k x).1 (section k' x))
    ((wQ.form (KR.second k) x).1 ((QF x).sm ((wP.form (KR.first k') x).1 (wP.section (KR.first k) x)) (wQ.section (KR.second k') x))) =
   refl ((form k x).1 (section k' x)) ;
  values (k k' : Fin N) (x : C.Spec Alg) : Id R.R ((form k x).1 (section k' x)) (x.1.1 (product.matrix k k')) =
   trans (form-section k k' x)
    (trans (value-at x (KR.first k) (KR.first k') (KR.second k) (KR.second k'))
     (ap x.1.1 (sym (product-entry k k')))) ;
  module PR = PCH.Presented[product,section,form,\ x -> HF[x].F.law,values] ;
  -- every representing projector of the sections of Hom(P, Q) has class [p^T][q]
  theorem (p : PCH.FP.PJ.Projector) (rp : PCH.FP.Representation p) :
   Id PCH.K.K0.R (PCH.K.class p) (PCH.K.K0.mul (PCH.K.class transpose) (PCH.K.class DQ.projector)) =
   trans (PR.theorem p rp) (sym (PCH.K.class-product transpose DQ.projector)) ;
 } ;
} ;
