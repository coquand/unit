-- A constant-rank twisted family produces chatelet's Azumaya algebra.
-- Input: a banded groupoid B, close-inhabited, and a family V of a fixed
-- weight whose fibres merely have bases of the fixed rank N >= 2.
-- DescendedEnd constructs E and algebra isomorphisms E = End(V g).
-- A basis identifies End(V g) with M_N by BasisEnd. Matrix carriers are
-- sheaves (products of R), so the endomorphism fibres are merely sheaves,
-- hence sheaves by EtaleModal.Mere. DescendedEndSheaf makes E a sheaf.
-- At g, a mere basis gives close(E ~ M_N) (an algebra isomorphism, so the
-- closure is taken at level l). This target is a sheaf proposition, so
-- sh.elim removes close-inhabitation of B. The resulting triple inhabits
-- Azumaya M_N = (A : Alg) * A a sheaf * close (AlgIso A M_N), for a closure
-- sh at level l; for any closure at all levels (chatelet) it gives
-- AzumayaProbe's AZ, close (A = M_N) (Chatelet: AlgSIPUA).
-- There is no choice of object or basis in the resulting algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module S = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module EM = EtaleModal[l,l].Over[ET.I,ET.G] ;
 module DE = DescendedEnd[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module BE = BasisEnd[l].Over[R,setR] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 -- Azumaya algebras locally isomorphic to M
 Azumaya (M : DE.EN.NA.Algebra) : U l+ = (A : DE.EN.NA.Algebra) * ET.T.isModal @l A.A * sh.close (DE.AS.AlgIso A M) ;
 -- for a closure at every level, the Azumaya algebras of AZUMAYAPROBE
 module Chatelet (shp : [j] SheafClosure[l,j].Over[ET.I,ET.G].Ops) (n0 : Nat) {
  module AP = AzumayaProbe[l].Over[R,setR,n0,ET.I,ET.G,shp] ;
  to-probe (M : DE.EN.NA.Algebra) (az : Azumaya M) : AP.Azumaya M =
   (az.1,az.2.1,sh.elim @(l+) (DE.AS.AlgIso az.1 M) ((shp @(l+)).close (Id DE.EN.NA.Algebra az.1 M))
     ((shp @(l+)).proposition (Id DE.EN.NA.Algebra az.1 M)) ((shp @(l+)).modal (Id DE.EN.NA.Algebra az.1 M))
     (\ e -> (shp @(l+)).inc (Id DE.EN.NA.Algebra az.1 M) (DE.AU.sip az.1 M e)) az.2.2) ;
 } ;
 module At (n0 : Nat) (B : DE.TM.Banded) (inh : sh.close B.1)
  (V : B.1 -> DE.TM.MD.Module) (chi : DE.TM.UG.Unit -> DE.TM.UG.Unit)
  (weight : DE.TM.At[DE.TM.charge B].Weight chi V)
  (bases : (g : B.1) -> Tr.Trunc[LF.Basis[V g,suc (suc n0)]].carrier) {
  N : Nat = suc (suc n0) ;
  module D = DE.At[B,V,chi,weight] ;
  module MT = MnAlgebra[l].Over[R,setR,N] ;
  matrix-sheaf : ET.T.isModal @l MT.Mat =
   S.modal-Pi (Fin N) (\ i -> Fin N -> R.R) (\ i ->
    S.modal-Pi (Fin N) (\ j -> R.R) (\ j -> ER.R-local)) ;
  module Based (g : B.1) (b : LF.Basis[V g,N]) {
   module E = BE.At[V g,N,b.frame,b.dual] ;
   sheaf : ET.T.isModal @l (DE.EN.At[V g].algebra.A) =
    S.modal-retract MT.Mat (DE.EN.At[V g].algebra.A) E.iso.1.1 E.iso.1.2.sec
     (Pr.sec-ret (DE.EN.At[V g].algebra.A) MT.Mat E.iso.1.1 E.iso.1.2) matrix-sheaf ;
   equality : Id DE.EN.NA.Algebra D.algebra MT.algebra =
    P1.trans DE.EN.NA.Algebra D.algebra (DE.EN.At[V g].algebra) MT.algebra
     D.AtObject[g].equality (DE.AU.sip (DE.EN.At[V g].algebra) MT.algebra E.iso) ;
  } ;
  fibre-sheaf (g : B.1) : ET.T.isModal @l (DE.EN.At[V g].algebra.A) =
   EM.Mere[(DE.EN.At[V g].algebra.A),(DE.EN.At[V g].algebra.set),
    Tr.Trunc[LF.Basis[V g,N]].induction @l
     (\ b -> Tr.Trunc[ET.T.isModal @l (DE.EN.At[V g].algebra.A)].carrier)
     (\ b -> Tr.Trunc[ET.T.isModal @l (DE.EN.At[V g].algebra.A)].proposition)
     (\ b -> Tr.Trunc[ET.T.isModal @l (DE.EN.At[V g].algebra.A)].inc Based[g,b].sheaf) (bases g)].modal ;
  sheaf : ET.T.isModal @l D.algebra.A =
   DescendedEndSheaf[l].Over[R,setR,ET.I,ET.G].At[B,V,chi,weight,fibre-sheaf].sheaf ;
  Local : U l = sh.close (DE.AS.AlgIso D.algebra MT.algebra) ;
  near (g : B.1) : Local =
   Tr.Trunc[LF.Basis[V g,N]].induction @l (\ b -> Local)
    (\ b -> sh.proposition (DE.AS.AlgIso D.algebra MT.algebra))
    (\ b -> sh.inc (DE.AS.AlgIso D.algebra MT.algebra) (DE.AU.idToIso D.algebra MT.algebra Based[g,b].equality)) (bases g) ;
  local : Local = sh.elim @l B.1 Local
   (sh.proposition (DE.AS.AlgIso D.algebra MT.algebra))
   (sh.modal (DE.AS.AlgIso D.algebra MT.algebra)) near inh ;
  theorem : Azumaya MT.algebra = (D.algebra,sheaf,local) ;
 } ;
} ;
