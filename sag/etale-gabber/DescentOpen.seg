-- Openness of a sheaf proposition can itself be proved sheaf-locally.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OT = EtaleOpenType[l].Over[R,setR,axioms] ;
 module EO = EtaleOpen[l].Over[R,setR,axioms] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module At (Q : U l) (prop : Pr.isProp Q) (modal : ET.T.isModal @l Q) {
  module Generator (idx : ET.I) (h : ET.G idx -> OP.Open Q) {
   value : OT.Opn = (OT.opens-local idx).sec (\ g -> (Q,h g)) ;
   path (g : ET.G idx) : Id OT.Opn value (Q,h g) =
    P1.happly (ET.G idx) (\ g -> OT.Opn) _ _ ((OT.opens-local idx).sec-eq (\ g -> (Q,h g))) g ;
   to (q : Q) : value.1 = (EO.open-local value.1 value.2 idx).sec
    (\ g -> (OT.encode value (Q,h g) (path g)).2 q) ;
   from (v : value.1) : Q = (modal idx).sec (\ g -> (OT.encode value (Q,h g) (path g)).1 v) ;
   result : OP.Open Q = OP.along Q value.1
    (to,Pr.qinv Q value.1 to from (\ v -> OP.open-prop value.1 value.2 _ v) (\ q -> prop _ q)) value.2 ;
  } ;
  theorem : ET.T.isModal @l (OP.Open Q) =
   SL.modal-of-sec (OP.Open Q) Truncation[l].Trunc[OP.Witness Q].proposition
    (\ idx h -> Generator[idx,h].result) ;
  opaque theorem ;
 } ;
} ;
