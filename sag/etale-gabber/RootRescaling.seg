-- Rescaling the roots of a monic polynomial (the one-stage identity behind
-- TOWERCLEARING; GABBER-PROPER-DESIGN.md, section 2, step 3).
-- f(X) = X^q + c_(q-1) X^(q-1) + .. + c_0 with q = d+1 (ETALETOPOLOGY: the
-- constant coefficient is c (inr tt)).  For numerators b_j = t c_j put
--     g = scaled t b,   with coefficient t^(q-1-j) b_j = t^(q-j) c_j,
-- i.e. g(Y) = t^q f(Y/t) written without division.  Then
--     g(t x) = t^q f(x)                                   (rescale)
-- by induction on q: g = t^q c_0 + Y g_1 with g_1 the rescaling of
-- f_1 = (f - c_0)/X, and t^q c_0 + t x t^(q-1) f_1(x) = t^q f(x).
-- If t is a unit, x |-> x/t sends roots of g to roots of f  (root-map).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module H = HorrocksInterface[l].Over[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 module L = RL[R] ;
 power-unit (a : R.R) (v : L.unit a) : (n : Nat) -> L.unit (Pow.power a n) = split {
  zero -> (R.o,R.mulO R.o) ;
  suc n | r -> AffineRing[l].Laws[R,setR].unit-product a (Pow.power a n) v r } ;
 -- the coefficients of g from the numerators b
 scaled : (n : Nat) -> R.R -> (Fin n -> R.R) -> Fin n -> R.R = split {
  zero -> \ t b -> b ;
  suc n | r -> \ t b -> split {
   inl j -> r t (\ i -> b (inl i)) j ;
   inr u -> R.mul (Pow.power t n) (b (inr tt)) } } ;
 -- the value at x of the monic polynomial with lower coefficients a
 value (n : Nat) (a : Fin n -> R.R) (x : R.R) : R.R = H.Raw.ev (H.monic-list (ET.coefficients n a)) x ;
 one-value (x : R.R) : Id R.R (H.Raw.ev (cons R.o nil) x) R.o =
  trans (ap (R.add R.o) (L.mul-zero x)) (R.addZ R.o) ;
 -- (rescale)
 rescale : (n : Nat) (t x : R.R) (b c : Fin n -> R.R) (hb : (j : Fin n) -> Id R.R (b j) (R.mul t (c j))) ->
  Id R.R (value n (scaled n t b) (R.mul t x)) (R.mul (Pow.power t n) (value n c x)) = split {
  zero -> \ t x b c hb ->
   trans (one-value (R.mul t x))
    (sym (trans (R.mulC R.o (value zero c x)) (trans (R.mulO (value zero c x)) (one-value x)))) ;
  suc n | r -> \ t x b c hb ->
   trans (cong2 R.R R.add _ _ _ _
     (trans (ap (R.mul (Pow.power t n)) (hb (inr tt)))
      (trans (L.mul-swap (Pow.power t n) t (c (inr tt))) (R.mulA t (Pow.power t n) (c (inr tt)))))
     (trans (ap (R.mul (R.mul t x)) (r t x (\ i -> b (inl i)) (\ i -> c (inl i)) (\ i -> hb (inl i))))
      (L.mul-four t x (Pow.power t n) (value n (\ i -> c (inl i)) x))))
    (sym (R.dist (Pow.power t (suc n)) (c (inr tt)) (R.mul x (value n (\ i -> c (inl i)) x)))) } ;
 -- (root-map)
 module Map (d : Nat) (t : R.R) (unit : L.unit t) (b c : Fin (suc d) -> R.R)
  (hb : (j : Fin (suc d)) -> Id R.R (b j) (R.mul t (c j))) {
  divide (y : R.R) : R.R = R.mul y unit.1 ;
  multiply-divide (y : R.R) : Id R.R (R.mul t (divide y)) y =
   trans (L.mul-swap t y unit.1) (trans (ap (R.mul y) unit.2) (R.mulO y)) ;
  root-map (r : ET.Root (d,scaled (suc d) t b)) : ET.Root (d,c) =
   (divide r.1,L.unit-reg (Pow.power t (suc d)) (value (suc d) c (divide r.1)) (power-unit t unit (suc d))
     (trans (sym (rescale (suc d) t (divide r.1) b c hb))
      (trans (ap (value (suc d) (scaled (suc d) t b)) (multiply-divide r.1)) r.2))) ;
 } ;
} ;
