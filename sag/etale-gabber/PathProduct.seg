-- Products of the lines of path torsors in an R^x-gerbe (towards mu_ijk;
-- ../HANDOFF-GABBER-HOMOTOPY.md).  In a gerbe (GERBE) a unit a acts on
-- h : x = y by  a.h = l_x(a) h  with l_x(a) = binv_x a.
--  (equivariance)  (a.h) k = a.(h k) by associativity, and h (a.k) = a.(h k)
--   because h l_y(a) = l_x(a) h: the loop h^-1 l_x(a) h at y has band a
--   (band-conj), so it is l_y(a).
--  (product)  For f in the line of (x = y) and g in that of (y = z)
--   (LINEASSOCIATED: f(a.h) = a^-1 f(h)), the function F (h, k) = f(h) g(k)
--   is constant on the factorisations h k = r of r : x = z: if h' = a.h and
--   h' k' = h k then a.k' = k, so f(h') g(k') = a^-1 f(h) g(k') = f(h) g(k).
--   Factorisations merely exist (the gerbe is connected), so F descends to
--   a function (f g)(r) by unique choice, and (f g)(a.r) = a^-1 (f g)(r)
--   since (a.h) k factors a.r.  The product is bilinear, works for any
--   weight (Weighted, for lines and duals), and the pairing (LINEPAIRING) is
--   multiplicative: <d e, f g> = <d, f> <e, g> (evaluate at r = h k).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Gp = Groupoid[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module UG = PicardUnits[l].Over[R,setR] ;
 module GB = Gerbe[l].Gerbes[UG.group] ;
 module LA = LineAssociated[l].Over[R,setR] ;
 module RR = RL[R] ;
 module At (Gb : GB.AGerbe) {
  module GL = GB.GL[Gb] ;
  X : U l = GL.X ;
  -- (equivariance)
  left (x y z : X) (a : UG.Unit) (h : Id X x y) (k : Id X y z) :
   Id (Id X x z) (Pr.trans X x y z (GL.pact x y a h) k) (GL.pact x z a (Pr.trans X x y z h k)) =
   Gp.tassoc X x x y (GL.binv x a) h z k ;
  -- h h^-1 b = b
  unwind (x y : X) (h : Id X x y) (b : Id X x x) :
   Id (Id X x x) (Pr.trans X x y x h (Pr.trans X y x x (Pr.sym X x y h) b)) b =
   Paths[l].transH (Paths[l].symH (Gp.tassoc X x y x h (Pr.sym X x y h) x b))
    (Paths[l].transH (Pr.ap (Id X x x) (Id X x x) (\ p -> Pr.trans X x x x p b) _ _ (Gp.trans-sym-r X x y h))
     (Pr.trans-refl-l X x x b)) ;
  -- the conjugate h^-1 l_x(a) h is l_y(a)
  conj-loop (x y : X) (h : Id X x y) (a : UG.Unit) : Id X y y =
   Pr.trans X y x y (Pr.trans X y x x (Pr.sym X x y h) (GL.binv x a)) h ;
  conj-band (x y : X) (h : Id X x y) (a : UG.Unit) : Id UG.Unit (GL.bnd y (conj-loop x y h a)) a =
   trans (GL.band-conj x (GL.binv x a) y h) (GL.bsec x a) ;
  conj (x y : X) (h : Id X x y) (a : UG.Unit) : Id (Id X y y) (GL.binv y a) (conj-loop x y h a) =
   Paths[l].transH (Pr.ap UG.Unit (Id X y y) (GL.binv y) _ _ (sym (conj-band x y h a))) (GL.bret y (conj-loop x y h a)) ;
  -- h l_y(a) = l_x(a) h
  commute (x y : X) (h : Id X x y) (a : UG.Unit) :
   Id (Id X x y) (Pr.trans X x y y h (GL.binv y a)) (Pr.trans X x x y (GL.binv x a) h) =
   Paths[l].transH (Pr.ap (Id X y y) (Id X x y) (Pr.trans X x y y h) _ _ (conj x y h a))
    (Paths[l].transH (Paths[l].symH (Gp.tassoc X x y x h (Pr.trans X y x x (Pr.sym X x y h) (GL.binv x a)) y h))
     (Pr.ap (Id X x x) (Id X x y) (\ p -> Pr.trans X x x y p h) _ _ (unwind x y h (GL.binv x a)))) ;
  right (x y z : X) (a : UG.Unit) (h : Id X x y) (k : Id X y z) :
   Id (Id X x z) (Pr.trans X x y z h (GL.pact y z a k)) (GL.pact x z a (Pr.trans X x y z h k)) =
   Paths[l].transH (Paths[l].symH (Gp.tassoc X x y y h (GL.binv y a) z k))
    (Paths[l].transH (Pr.ap (Id X x y) (Id X x z) (\ p -> Pr.trans X x y z p k) _ _ (commute x y h a))
     (Gp.tassoc X x x y (GL.binv x a) h z k)) ;
  -- left cancellation: h k = h k' gives k = k'
  cancel (x y z : X) (h : Id X x y) (k k' : Id X y z) (e : Id (Id X x z) (Pr.trans X x y z h k) (Pr.trans X x y z h k')) :
   Id (Id X y z) k k' =
   Paths[l].transH (Paths[l].symH (Pr.trans-cancel X x y z h k))
    (Paths[l].transH (Pr.ap (Id X x z) (Id X y z) (Pr.trans X y x z (Pr.sym X x y h)) _ _ e) (Pr.trans-cancel X x y z h k')) ;

  -- (product)
  module Weighted (chi : UG.Unit -> UG.Unit) (chi-one : Id UG.Unit (chi UG.one) UG.one)
   (chi-times : (a b : UG.Unit) -> Id UG.Unit (chi (UG.times a b)) (UG.times (chi a) (chi b))) (x y z : X) {
   module W = LA.Weight[chi,chi-one,chi-times] ;
   module LP = W.At[LA.pre (GL.PTor x y)] ;
   module LQ = W.At[LA.pre (GL.PTor y z)] ;
   module LR = W.At[LA.pre (GL.PTor x z)] ;
   module DP = Torsor[l].TorBase[UG.group].D[Id X x y,GL.PT x y] ;
   Factor (r : Id X x z) : U l = (h : Id X x y) * (k : Id X y z) * Id (Id X x z) (Pr.trans X x y z h k) r ;
   factor (r : Id X x z) (h : Id X x y) : Factor r =
    (h,(Pr.trans X y x z (Pr.sym X x y h) r,
     Paths[l].transH (Paths[l].symH (Gp.tassoc X x y x h (Pr.sym X x y h) z r))
      (Paths[l].transH (Pr.ap (Id X x x) (Id X x z) (\ p -> Pr.trans X x x z p r) _ _ (Gp.trans-sym-r X x y h))
       (Pr.trans-refl-l X x z r)))) ;
   factors (r : Id X x z) : Tr.Trunc[Factor r].carrier =
    Tr.Trunc[Id X x y].induction @l (\ t -> Tr.Trunc[Factor r].carrier) (\ t -> Tr.Trunc[Factor r].proposition)
     (\ h -> Tr.Trunc[Factor r].inc (factor r h)) (GL.conn x y) ;
   -- two factorisations differ by a on the left and a^-1 on the right
   module Compare (r : Id X x z) (w w' : Factor r) {
    a : UG.Unit = DP.diff w.1 w'.1 ;
    first : Id (Id X x y) (GL.pact x y a w.1) w'.1 = DP.dact w.1 w'.1 ;
    second : Id (Id X y z) (GL.pact y z a w'.2.1) w.2.1 =
     cancel x y z w.1 (GL.pact y z a w'.2.1) w.2.1
      (Paths[l].transH (right x y z a w.1 w'.2.1)
       (Paths[l].transH (Paths[l].symH (left x y z a w.1 w'.2.1))
        (Paths[l].transH (Pr.ap (Id X x y) (Id X x z) (\ p -> Pr.trans X x y z p w'.2.1) _ _ first)
         (Paths[l].transH w'.2.2 (Paths[l].symH w.2.2))))) ;
   } ;
   module Product (f : LP.Carrier) (g : LQ.Carrier) {
    value-at (r : Id X x z) (w : Factor r) : R.R = R.mul (f.1 w.1) (g.1 w.2.1) ;
    same (r : Id X x z) (w w' : Factor r) : Id R.R (value-at r w) (value-at r w') =
     calc R.R { R.mul (f.1 w.1) (g.1 w.2.1)
       =< ap (\ t -> R.mul (f.1 w.1) (g.1 t)) (sym (Compare[r,w,w'].second)) >
          R.mul (f.1 w.1) (g.1 (GL.pact y z Compare[r,w,w'].a w'.2.1))
       =< ap (R.mul (f.1 w.1)) (g.2 Compare[r,w,w'].a w'.2.1) >
          R.mul (f.1 w.1) (R.mul (chi Compare[r,w,w'].a).1 (g.1 w'.2.1))
       =< RR.mul-swap (f.1 w.1) (chi Compare[r,w,w'].a).1 (g.1 w'.2.1) >
          R.mul (chi Compare[r,w,w'].a).1 (R.mul (f.1 w.1) (g.1 w'.2.1))
       =< R.mulA (chi Compare[r,w,w'].a).1 (f.1 w.1) (g.1 w'.2.1) >
          R.mul (R.mul (chi Compare[r,w,w'].a).1 (f.1 w.1)) (g.1 w'.2.1)
       =< ap (\ t -> R.mul t (g.1 w'.2.1)) (sym (f.2 Compare[r,w,w'].a w.1)) >
          R.mul (f.1 (GL.pact x y Compare[r,w,w'].a w.1)) (g.1 w'.2.1)
       =< ap (\ t -> R.mul (f.1 t) (g.1 w'.2.1)) Compare[r,w,w'].first > R.mul (f.1 w'.1) (g.1 w'.2.1) } ;
    Value (r : Id X x z) : U l = (c : R.R) * ((w : Factor r) -> Id R.R (value-at r w) c) ;
    value-prop (r : Id X x z) : Pr.isProp (Value r) = \ v v' ->
     Pr.Sigma-eq R.R (\ c -> (w : Factor r) -> Id R.R (value-at r w) c) v.1 v'.1 v.2 v'.2
      (Tr.Trunc[Factor r].induction @l (\ t -> Id R.R v.1 v'.1) (\ t -> setR _ _)
       (\ w -> trans (sym (v.2 w)) (v'.2 w)) (factors r))
      (F.isProp-Pi (Factor r) (\ w -> Id R.R (value-at r w) v'.1) (\ w -> setR _ _)) ;
    witness (r : Id X x z) : Value r =
     Tr.Trunc[Factor r].induction @l (\ t -> Value r) (\ t -> value-prop r)
      (\ w -> (value-at r w,\ w' -> same r w' w)) (factors r) ;
    fn (r : Id X x z) : R.R = (witness r).1 ;
    beta (r : Id X x z) (w : Factor r) : Id R.R (fn r) (value-at r w) = sym ((witness r).2 w) ;
    -- (a.h) k factors a.r
    shifted (r : Id X x z) (a : UG.Unit) (w : Factor r) : Factor (GL.pact x z a r) =
     (GL.pact x y a w.1,(w.2.1,Paths[l].transH (left x y z a w.1 w.2.1) (Pr.ap (Id X x z) (Id X x z) (GL.pact x z a) _ _ w.2.2))) ;
    weight (a : UG.Unit) (r : Id X x z) : Id R.R (fn (GL.pact x z a r)) (R.mul (chi a).1 (fn r)) =
     Tr.Trunc[Factor r].induction @l (\ t -> Id R.R (fn (GL.pact x z a r)) (R.mul (chi a).1 (fn r))) (\ t -> setR _ _)
      (\ w -> calc R.R { fn (GL.pact x z a r)
        =< beta (GL.pact x z a r) (shifted r a w) > R.mul (f.1 (GL.pact x y a w.1)) (g.1 w.2.1)
        =< ap (\ t -> R.mul t (g.1 w.2.1)) (f.2 a w.1) > R.mul (R.mul (chi a).1 (f.1 w.1)) (g.1 w.2.1)
        =< sym (R.mulA (chi a).1 (f.1 w.1) (g.1 w.2.1)) > R.mul (chi a).1 (value-at r w)
        =< ap (R.mul (chi a).1) (sym (beta r w)) > R.mul (chi a).1 (fn r) })
      (factors r) ;
    product : LR.Carrier = (fn,weight) ;
   } ;
   product (f : LP.Carrier) (g : LQ.Carrier) : LR.Carrier = Product[f,g].product ;
   -- the product at a factorisation
   product-at (f : LP.Carrier) (g : LQ.Carrier) (r : Id X x z) (w : Factor r) :
    Id R.R ((product f g).1 r) (R.mul (f.1 w.1) (g.1 w.2.1)) = Product[f,g].beta r w ;
   -- bilinearity
   prove (r : Id X x z) (c d : R.R) (h : Factor r -> Id R.R c d) : Id R.R c d =
    Tr.Trunc[Factor r].induction @l (\ t -> Id R.R c d) (\ t -> setR c d) h (factors r) ;
   add-left (f f' : LP.Carrier) (g : LQ.Carrier) :
    Id LR.Carrier (product (LP.addM f f') g) (LR.addM (product f g) (product f' g)) =
    LR.equal _ _ (\ r -> prove r _ _ (\ w ->
     trans (product-at (LP.addM f f') g r w)
      (trans (RR.dist-left (f.1 w.1) (f'.1 w.1) (g.1 w.2.1))
       (sym (cong2 R.R R.add _ _ _ _ (product-at f g r w) (product-at f' g r w)))))) ;
   add-right (f : LP.Carrier) (g g' : LQ.Carrier) :
    Id LR.Carrier (product f (LQ.addM g g')) (LR.addM (product f g) (product f g')) =
    LR.equal _ _ (\ r -> prove r _ _ (\ w ->
     trans (product-at f (LQ.addM g g') r w)
      (trans (R.dist (f.1 w.1) (g.1 w.2.1) (g'.1 w.2.1))
       (sym (cong2 R.R R.add _ _ _ _ (product-at f g r w) (product-at f g' r w)))))) ;
   scale-left (c : R.R) (f : LP.Carrier) (g : LQ.Carrier) :
    Id LR.Carrier (product (LP.scale c f) g) (LR.scale c (product f g)) =
    LR.equal _ _ (\ r -> prove r _ _ (\ w ->
     trans (product-at (LP.scale c f) g r w)
      (trans (sym (R.mulA c (f.1 w.1) (g.1 w.2.1))) (ap (R.mul c) (sym (product-at f g r w)))))) ;
   scale-right (c : R.R) (f : LP.Carrier) (g : LQ.Carrier) :
    Id LR.Carrier (product f (LQ.scale c g)) (LR.scale c (product f g)) =
    LR.equal _ _ (\ r -> prove r _ _ (\ w ->
     trans (product-at f (LQ.scale c g) r w)
      (trans (RR.mul-swap (f.1 w.1) c (g.1 w.2.1)) (ap (R.mul c) (sym (product-at f g r w)))))) ;
  } ;
  -- the pairing is multiplicative: <d e, f g> = <d, f> <e, g>
  module Multiplicative (x y z : X) {
   module LX = Weighted[UG.inverse,LA.inverse-one,LA.inverse-times,x,y,z] ;
   module DX = Weighted[\ a -> a,refl UG.one,\ a b -> refl (UG.times a b),x,y,z] ;
   module PP = LinePairing[l].Over[R,setR].At[GL.PTor x y] ;
   module PQ = LinePairing[l].Over[R,setR].At[GL.PTor y z] ;
   module PR = LinePairing[l].Over[R,setR].At[GL.PTor x z] ;
   Goal (d : DX.LP.Carrier) (e : DX.LQ.Carrier) (f : LX.LP.Carrier) (g : LX.LQ.Carrier) : U l =
    Id R.R (PR.pair (DX.product d e) (LX.product f g)) (R.mul (PP.pair d f) (PQ.pair e g)) ;
   at (d : DX.LP.Carrier) (e : DX.LQ.Carrier) (f : LX.LP.Carrier) (g : LX.LQ.Carrier) (h : Id X x y) (k : Id X y z) :
    Goal d e f g =
    calc R.R { PR.pair (DX.product d e) (LX.product f g)
      =< PR.beta (DX.product d e) (LX.product f g) (Pr.trans X x y z h k) >
         R.mul ((DX.product d e).1 (Pr.trans X x y z h k)) ((LX.product f g).1 (Pr.trans X x y z h k))
      =< cong2 R.R R.mul _ _ _ _ (DX.product-at d e (Pr.trans X x y z h k) (h,(k,refl (Pr.trans X x y z h k))))
          (LX.product-at f g (Pr.trans X x y z h k) (h,(k,refl (Pr.trans X x y z h k)))) >
         R.mul (R.mul (d.1 h) (e.1 k)) (R.mul (f.1 h) (g.1 k))
      =< RR.mul-four (d.1 h) (e.1 k) (f.1 h) (g.1 k) > R.mul (R.mul (d.1 h) (f.1 h)) (R.mul (e.1 k) (g.1 k))
      =< sym (cong2 R.R R.mul _ _ _ _ (PP.beta d f h) (PQ.beta e g k)) > R.mul (PP.pair d f) (PQ.pair e g) } ;
   multiplicative (d : DX.LP.Carrier) (e : DX.LQ.Carrier) (f : LX.LP.Carrier) (g : LX.LQ.Carrier) : Goal d e f g =
    Tr.Trunc[Id X x y].induction @l (\ t -> Goal d e f g) (\ t -> setR _ _)
     (\ h -> Tr.Trunc[Id X y z].induction @l (\ t -> Goal d e f g) (\ t -> setR _ _) (\ k -> at d e f g h k) (GL.conn y z))
     (GL.conn x y) ;
  } ;
 } ;
} ;