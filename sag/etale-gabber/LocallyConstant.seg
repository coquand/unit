-- A Nat-valued (or shape-valued) function on a principal open is constant
-- on the pieces of a finite cover by principal opens
-- (GABBER-PROPER-DESIGN.md, section 2, Globalise step 2; review of night 14).
-- A f.p., u in A, h : D(u) -> Nat.  Then merely b_0 .. b_N in A and values
-- such that on D(u), the D(b_j) cover, and h = value j on D(u) n D(b_j).
-- Proof (no idempotents, no choice outside the truncation):
--  (bound)  h is bounded by some N (3.3.3 on Spec A[1/u] = D(u)).
--  (chi)    chi_j(x) = delta (h x) j for j <= N, with delta n k = 1 if
--           n = k and 0 otherwise (by recursion); since h x <= N,
--           sum_j chi_j(x) = 1 (delta-sum), and chi_j(x) a unit forces
--           h x = j (delta-unit; 0 is not a unit by Loc).
--  (fractions) chi_j(x) = b_j(x) / x(u)^n_j for b_j in A (OPENFRACTIONS),
--           chosen for the finitely many j (finite choice).  On D(u), x(b_j)
--           is a unit iff chi_j(x) is; the chi_j(x) sum to 1, so merely one
--           of them is a unit (Units23, 2.2.3(b)).
-- For shapes s : D(u) -> Shape, apply this to code . s (SHAPECODES):
-- s x = decode (code (s x)) = decode (value j) on D(u) n D(b_j).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module CB = CoefficientBound[l] ;
module SC = ShapeCodes[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module OF = OpenFractions[l].Over[R,setR,axioms] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 module V = EtaleVectors[l].Over[R,setR] ;
 module U3 = Units23[l].Over[R,setR,axioms.sqc,axioms.loc] ;
 module Lc = StandardOpens[l].Over[R,setR].Local[axioms.loc] ;
 module Bound = UniformBounded[l].Theorem[R,setR,axioms.loc.1,axioms.sqc] ;
 -- (chi)
 delta : Nat -> Nat -> R.R = split {
  zero -> split { zero -> R.o ; suc k -> R.z } ;
  suc n | r -> split { zero -> R.z ; suc k -> r k } } ;
 delta-unit : (n k : Nat) -> RL[R].unit (delta n k) -> Id Nat n k = split {
  zero -> split {
   zero -> \ v -> refl zero ;
   suc k -> \ v -> efq (Lc.zero-unit R.z (refl R.z) v) } ;
  suc n | r -> split {
   zero -> \ v -> efq (Lc.zero-unit R.z (refl R.z) v) ;
   suc k -> \ v -> ap (\ t -> suc t) (r k v) } } ;
 delta-sum : (N n : Nat) -> CB.le n N -> Id R.R (RS.sum (suc N) (\ j -> delta n (V.index (suc N) j))) R.o = split {
  zero -> split {
   zero -> \ b -> R.addZ R.o ;
   suc n -> \ b -> efq b } ;
  suc N | r -> split {
   zero -> \ b -> trans (ap (R.add R.o) (RS.sum-zero (suc N))) (R.addZ R.o) ;
   suc n -> \ b -> trans (RL[R].zl (RS.sum (suc N) (\ j -> delta n (V.index (suc N) j)))) (r n b) } } ;
 module At (A : C.Algebra) (fp : P.FP A) (u : A.ring.R) (h : I.D A u -> Nat) {
  record Pieces {
   m : Nat ;
   b : Fin m -> A.ring.R ;
   value : Fin m -> Nat ;
   constant : (j : Fin m) (x : I.D A u) -> RL[R].unit (x.1.1.1 (b j)) -> Id Nat (h x) (value j) ;
   cover : (x : I.D A u) -> Tr.Trunc[(j : Fin m) * RL[R].unit (x.1.1.1 (b j))].carrier ;
  } ;
  module Bounded (N : Nat) (bound : (x : I.D A u) -> CB.le (h x) N) {
   chi (j : Fin (suc N)) (x : I.D A u) : R.R = delta (h x) (V.index (suc N) j) ;
   sum (x : I.D A u) : Id R.R (RS.sum (suc N) (\ j -> chi j x)) R.o = delta-sum N (h x) (bound x) ;
   module Fractions (fr : (j : Fin (suc N)) -> OF.At[A,fp,u,chi j].Rep) {
    -- x(b_j) = x(u)^n_j chi_j(x)
    equation (j : Fin (suc N)) (x : I.D A u) :
     Id R.R (x.1.1.1 (fr j).1) (R.mul (Pow.power (x.1.1.1 u) (fr j).2.1) (chi j x)) = (fr j).2.2 x ;
    constant (j : Fin (suc N)) (x : I.D A u) (v : RL[R].unit (x.1.1.1 (fr j).1)) :
     Id Nat (h x) (V.index (suc N) j) =
     delta-unit (h x) (V.index (suc N) j)
      (RR.unit-right (Pow.power (x.1.1.1 u) (fr j).2.1) (chi j x) (Pr.subst R.R RL[R].unit _ _ (equation j x) v)) ;
    nonzero (x : I.D A u) (zs : (j : Fin (suc N)) -> Id R.R (chi j x) R.z) : Empty =
     Lc.zero-unit R.o (trans (sym (sum x)) (trans (RS.sum-cong (suc N) (\ j -> chi j x) (\ j -> R.z) zs) (RS.sum-zero (suc N))))
      (R.o,R.mulO R.o) ;
    unit-at (x : I.D A u) (w : (j : Fin (suc N)) * RL[R].unit (chi j x)) : (j : Fin (suc N)) * RL[R].unit (x.1.1.1 (fr j).1) =
     (w.1,Pr.subst R.R RL[R].unit _ _ (sym (equation w.1 x))
      (RR.unit-product (Pow.power (x.1.1.1 u) (fr w.1).2.1) (chi w.1 x) (RootRescaling[l].Over[R,setR].power-unit (x.1.1.1 u) x.2 (fr w.1).2.1) w.2)) ;
    cover (x : I.D A u) : Tr.Trunc[(j : Fin (suc N)) * RL[R].unit (x.1.1.1 (fr j).1)].carrier =
     Tr.Trunc[(j : Fin (suc N)) * RL[R].unit (chi j x)].induction @l
      (\ t -> Tr.Trunc[(j : Fin (suc N)) * RL[R].unit (x.1.1.1 (fr j).1)].carrier)
      (\ t -> Tr.Trunc[(j : Fin (suc N)) * RL[R].unit (x.1.1.1 (fr j).1)].proposition)
      (\ w -> Tr.Trunc[(j : Fin (suc N)) * RL[R].unit (x.1.1.1 (fr j).1)].inc (unit-at x w))
      (U3.nonzero-unit (suc N) (\ j -> chi j x) (nonzero x)) ;
    pieces : Pieces = new Pieces[m := suc N,b := \ j -> (fr j).1,value := V.index (suc N),
     constant := constant,cover := cover] ;
   } ;
   theorem : Tr.Trunc[Pieces].carrier =
    Tr.Trunc[(j : Fin (suc N)) -> OF.At[A,fp,u,chi j].Rep].induction @l
     (\ t -> Tr.Trunc[Pieces].carrier) (\ t -> Tr.Trunc[Pieces].proposition)
     (\ fr -> Tr.Trunc[Pieces].inc Fractions[fr].pieces)
     (AffineFinite[l].choice (suc N) (\ j -> OF.At[A,fp,u,chi j].Rep) (\ j -> OF.At[A,fp,u,chi j].theorem)) ;
  } ;
  -- (bound), on Spec A[1/u] = D(u)
  module With (loc : I.LocalizationWitness A u) {
   spectrum : Pr.Equiv (C.Spec loc.1) (I.D A u) = I.spectrum A u loc ;
   module B = Bound.ForAlgebra[loc.1,loc.2.1] ;
   transfer (g : B.Goal (\ y -> h (spectrum.1 y))) : Tr.Trunc[Pieces].carrier =
    Bounded[g.1,\ x -> Pr.subst (I.D A u) (\ z -> CB.le (h z) g.1) _ _ (spectrum.2.sec-eq x) (g.2 (spectrum.2.sec x))].theorem ;
   theorem : Tr.Trunc[Pieces].carrier =
    Tr.Trunc[B.Goal (\ y -> h (spectrum.1 y))].induction @l
     (\ t -> Tr.Trunc[Pieces].carrier) (\ t -> Tr.Trunc[Pieces].proposition) transfer
     (B.theorem (\ y -> h (spectrum.1 y))) ;
  } ;
  theorem : Tr.Trunc[Pieces].carrier =
   Tr1.Trunc[I.LocalizationWitness A u].induction @l (\ z -> Tr.Trunc[Pieces].carrier)
    (\ z -> Tr.Trunc[Pieces].proposition) (\ loc -> With[loc].theorem) (I.localize A fp u) ;
 } ;
 -- shapes: on D(u) n D(b_j), s = decode (value j)
 module Shapes (A : C.Algebra) (fp : P.FP A) (u : A.ring.R) (s : I.D A u -> SC.Shape) {
  module H = At[A,fp,u,\ x -> SC.code (s x)] ;
  constant (p : H.Pieces) (j : Fin p.m) (x : I.D A u) (v : RL[R].unit (x.1.1.1 (p.b j))) :
   Id SC.Shape (s x) (SC.decode (p.value j)) =
   trans (sym (SC.decode-code (s x))) (ap SC.decode (p.constant j x v)) ;
 } ;
} ;
