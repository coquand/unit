-- Goodness of powers (gabber-recollement, proof of Proposition `cheap`, last
-- sentence: P(V^e) = P(V) (x) O^(e^n)).  On X = Spec Alg with gerbes G x,
-- let V be twisted, Lambda of weight n = n0 + 1, P(V)^v = power V Lambda n
-- (MULTILINEAR.Family.Dual), and wP frame data of the descended P(V)^v with
-- projector p.  V is good of rank N_V if rho(p) = 1 for N = N_V (ROOTS,
-- HOMROOTS.Good.Hypotheses).  Let V^(e+1) be the pointwise sum of e + 1
-- copies (MODULESUMS.Families, EFFACE power e) and c = count e n
-- (POWERSUMS), so that c + 1 = (e+1)^n.
--  (weight)  V^(e+1) is twisted (FAMILYMOVES.Powers).
--  (images)  For projectors a, b over Alg and x in X, evaluation at x
--     commutes with block sums (PROJECTORMAP.Sum), so
--         I (a + b)(x) = I a(x) + I b(x)          (MATRIXTENSOR.Block),
--     I 0(x) has one element, so I 0(x) + M = M, and for the copies
--     p^(c+1) = 0 + p + .. + p (TRANSPOSES.copies), by induction on c,
--         I p^(c+1)(x) = (I p(x))^(c+1)            (commutativity of +).
--  (fibre)  At (x, g):
--         P(V^(e+1))^v(x) = power (V x g)^(e+1) (Lambda x g) n    (descend-fibre)
--           = (power (V x g) (Lambda x g) n)^(c+1)                (POWERSUMS.powers)
--           = (P(V)^v(x))^(c+1) = (I p(x))^(c+1)  (descend-fibre, FRAMEIMAGE on wP)
--           = I p^(c+1)(x).                                        (images)
--     The right side does not depend on g, so the descended P(V^(e+1))^v is
--     I p^(c+1)(x) at every x (CONSTANTIDENTITY).
--  (class)  By (KEY) (PRESENTEDCLASS) every projector representing the
--     global sections of the descended P(V^(e+1))^v has the class
--     [p^(c+1)] = (c+1) [p] (TRANSPOSES.class-copies, nat-mul).
--  (rho)  Let M + 1 = (c+1)(N_V+1) (RATIONAL.times-suc), so that
--     nat (M+1) = nat (c+1) nat (N_V+1).  From rho(p) = 1, iota [p] =
--     iota N_V (HOMROOTS.iota-eq), so iota [p'] = iota (c+1) iota [p] =
--     iota (c+1) iota N_V = iota (M+1), and rho(p') = iota (M+1) / (M+1) = 1:
--     V^(e+1) is good of rank (e+1)^n N_V (Counts: nat (c+1) = nat (e+1)^n).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module PS = PowerSums[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 -- (weight)
 -- c + 1 = (e+1)^k for c = count e k, as integers of a ring A:
 --   nat (exponent c j + 1) = nat (j+1) nat (c+1), by induction on j:
 --   exponent c (j+1) + 1 = (c+1) + (exponent c j + 1), and
 --   (c+1) + (j+1)(c+1) = ((j+1) + 1)(c+1).
 module Counts (A : CRing) {
  module IA = Rational[l].Integers[A] ;
  module LA = RL[A] ;
  module PA = AffinePowers[l].Over[A] ;
  exponent (c : Nat) : (j : Nat) -> Id A.R (IA.nat (suc (PS.SU.exponent c j))) (A.mul (IA.nat (suc j)) (IA.nat (suc c))) = split {
   zero -> sym (trans (ap (\ t -> A.mul t (IA.nat (suc c))) IA.nat-one) (LA.one-left (IA.nat (suc c)))) ;
   suc j | h -> calc A.R { IA.nat (suc (suc (plus c (PS.SU.exponent c j))))
     =< ap (\ m -> IA.nat (suc m)) (sym (plus-suc c (PS.SU.exponent c j))) > IA.nat (plus (suc c) (suc (PS.SU.exponent c j)))
     =< IA.nat-plus (suc c) (suc (PS.SU.exponent c j)) > A.add (IA.nat (suc c)) (IA.nat (suc (PS.SU.exponent c j)))
     =< ap (A.add (IA.nat (suc c))) h > A.add (IA.nat (suc c)) (A.mul (IA.nat (suc j)) (IA.nat (suc c)))
     =< A.addC (IA.nat (suc c)) (A.mul (IA.nat (suc j)) (IA.nat (suc c))) > A.add (A.mul (IA.nat (suc j)) (IA.nat (suc c))) (IA.nat (suc c))
     =< ap (A.add (A.mul (IA.nat (suc j)) (IA.nat (suc c)))) (sym (LA.one-left (IA.nat (suc c)))) >
        A.add (A.mul (IA.nat (suc j)) (IA.nat (suc c))) (A.mul A.o (IA.nat (suc c)))
     =< sym (LA.dist-left (IA.nat (suc j)) A.o (IA.nat (suc c))) > A.mul (IA.nat (suc (suc j))) (IA.nat (suc c)) } } ;
  count : (e k : Nat) -> Id A.R (IA.nat (suc (PS.count e k))) (PA.power (IA.nat (suc e)) k) = \ e -> split {
   zero -> IA.nat-one ;
   suc k | h -> trans (exponent (PS.count e k) e) (ap (A.mul (IA.nat (suc e))) h) } ;
 } ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe)
  (n0 : Nat) (Lambda : TM.Family[C.Spec Alg,G].Weighted (\ a -> TM.UG.power a (suc n0))) {
  module DA = Datum[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  module FS = MS.Families[DA.X,\ x -> (G x).1] ;
  module TS = Summands[l].Tensors[R,setR,DA.X,\ x -> (G x).1] ;
  module PA = Projectors[l].Over[Alg.ring,Alg.set] ;
  module TT = Transposes[l].Over[Alg.ring,Alg.set] ;
  module HR = HomRoots[l].Over[R,setR,axioms].At[Alg,fp,G,n0,Lambda] ;
  -- V^(e+1) is twisted
  power-weight (V : DA.Fam.TF.Twisted) (e : Nat) (x : DA.X) : TM.At[TM.charge (TM.banded (G x))].Weight TM.At[TM.charge (TM.banded (G x))].identity (FS.E.power e V.1 x) =
   FamilyMoves[l].Over[R,setR,axioms].Powers[DA.X,G].weight V e x ;
  power (V : DA.Fam.TF.Twisted) (e : Nat) : DA.Fam.TF.Twisted = (FS.E.power e V.1,power-weight V e) ;
  -- (images)
  module Images (x : DA.X) {
   module PM = ProjectorMap[l].Over[Alg.ring,R,Alg.set,setR,x.1] ;
   at (p : PA.Projector) : Vectors[l].Over[R,setR,p.size].MR.Mat = \ i j -> x.1.1 (p.matrix i j) ;
   image (p : PA.Projector) : MD.Module = MT.I p.size (at p) ;
   sum-image (p q : PA.Projector) : Id MD.Module (image (TT.K.sum p q)) (MS.plus (image p) (image q)) =
    Pr1.trans MD.Module (image (TT.K.sum p q)) (MT.I (plus p.size q.size) (DirectSums[l].Over[R,setR,p.size,q.size].dsum (at p) (at q)))
     (MS.plus (image p) (image q))
     (Pr1.ap PM.Sum[p,q].M2.MY.Mat MD.Module (MT.I (plus p.size q.size)) (at (TT.K.sum p q))
      (DirectSums[l].Over[R,setR,p.size,q.size].dsum (at p) (at q)) PM.Sum[p,q].matrix)
     MT.Block[p.size,q.size,at p,at q].image ;
   -- I 0(x) + M = M
   module ZeroLeft (M : MD.Module) {
    module IZ = MT.Image[zero,at PA.zeroP] ;
    module P2 = MS.Pair[IZ.carrier,M] ;
    single (w : IZ.S.E) : Id IZ.S.E IZ.carrier.mz w = IZ.ext IZ.carrier.mz w (IZ.V.vec-eq _ _ (\ i -> efq i)) ;
    to (u : P2.Carrier) : M.M = u.2 ;
    from (m : M.M) : P2.Carrier = (IZ.carrier.mz,m) ;
    from-to (u : P2.Carrier) : Id P2.Carrier (from (to u)) u = P2.pair-eq _ _ _ _ (single u.1) (refl u.2) ;
    theorem : Id MD.Module (MS.plus IZ.carrier M) M =
     SIP.sip (MS.plus IZ.carrier M) M
      ((to,Pr.qinv P2.Carrier M.M to from (\ m -> refl m) from-to),
       \ u v -> refl (M.madd u.2 v.2),
       \ c u -> refl (M.sm c u.2)) ;
   } ;
   copies-image (p : PA.Projector) : (c : Nat) -> Id MD.Module (image (TT.copies p (suc c))) (MS.EM.power c (image p)) = split {
    zero -> Pr1.trans MD.Module (image (TT.copies p (suc zero))) (MS.plus (image PA.zeroP) (image p)) (image p)
      (sum-image PA.zeroP p) ZeroLeft[image p].theorem ;
    suc c | r -> Pr1.trans MD.Module (image (TT.copies p (suc (suc c)))) (MS.plus (image (TT.copies p (suc c))) (image p))
      (MS.EM.power (suc c) (image p))
      (sum-image (TT.copies p (suc c)) p)
      (Pr1.trans MD.Module (MS.plus (image (TT.copies p (suc c))) (image p)) (MS.plus (MS.EM.power c (image p)) (image p))
       (MS.EM.power (suc c) (image p))
       (Pr1.ap MD.Module MD.Module (\ M -> MS.plus M (image p)) (image (TT.copies p (suc c))) (MS.EM.power c (image p)) r)
       (Pr1.trans MD.Module (MS.plus (MS.EM.power c (image p)) (image p)) (MS.plus (image p) (MS.EM.power c (image p)))
        (MS.EM.power (suc c) (image p))
        MS.Comm[MS.EM.power c (image p),image p].theorem
        (Pr1.sym MD.Module (MS.EM.power (suc c) (image p)) (MS.plus (image p) (MS.EM.power c (image p))) (PS.power-suc (image p) c)))) } ;
  } ;
  module Power (V : DA.Fam.TF.Twisted) (e : Nat)
   (wP : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,ML.Family[DA.X,G].Dual[suc n0,V,Lambda].descended].Data) {
   module PV = ML.Family[DA.X,G].Dual[suc n0,V,Lambda] ;
   module PE = ML.Family[DA.X,G].Dual[suc n0,power V e,Lambda] ;
   module FD = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PV.descended].From[wP] ;
   -- p^(c+1), c + 1 = (e+1)^n
   q : PA.Projector = TT.copies FD.projector (suc (PS.count e (suc n0))) ;
   module Pt (x : DA.X) {
    module IM = Images[x] ;
    module FB = DA.Fibre[PV.descended,wP,x] ;
    -- P(V)^v(x) = I p(x)  (FRAMEIMAGE)
    image : Id MD.Module (PV.descended x) (IM.image FD.projector) =
     Pr1.trans MD.Module (PV.descended x) (MT.I wP.size FB.FI.matrix) (IM.image FD.projector)
      FB.FI.theorem (Pr1.ap FB.MN.MR.Mat MD.Module (MT.I wP.size) FB.FI.matrix (FB.MN.at x FD.entry) FB.matrix) ;
    -- (P(V)^v(x))^(c+1) = I p^(c+1)(x)
    target : Id MD.Module (MS.EM.power (PS.count e (suc n0)) (PV.descended x)) (IM.image q) =
     Pr1.trans MD.Module (MS.EM.power (PS.count e (suc n0)) (PV.descended x)) (MS.EM.power (PS.count e (suc n0)) (IM.image FD.projector))
      (IM.image q)
      (Pr1.ap MD.Module MD.Module (MS.EM.power (PS.count e (suc n0))) (PV.descended x) (IM.image FD.projector) image)
      (Pr1.sym MD.Module (IM.image q) (MS.EM.power (PS.count e (suc n0)) (IM.image FD.projector))
       (IM.copies-image FD.projector (PS.count e (suc n0)))) ;
    module Fb (g : (G x).1) {
     -- by definition, the fibre of P(V^(e+1))^v at g is power (V^(e+1) x g) (Lambda x g) n
     fibre-power : Id MD.Module (PE.H x g) (ML.power (FS.E.power e V.1 x g) (Lambda.1 x g) (suc n0)) =
      refl (ML.power (FS.E.power e V.1 x g) (Lambda.1 x g) (suc n0)) ;
     -- the multilinear maps out of (V x g)^(e+1)
     powers : Id MD.Module (ML.power (FS.E.power e V.1 x g) (Lambda.1 x g) (suc n0)) (MS.EM.power (PS.count e (suc n0)) (PV.H x g)) =
      Pr1.trans MD.Module (ML.power (FS.E.power e V.1 x g) (Lambda.1 x g) (suc n0))
       (ML.power (MS.EM.power e (V.1 x g)) (Lambda.1 x g) (suc n0)) (MS.EM.power (PS.count e (suc n0)) (PV.H x g))
       (Pr1.ap MD.Module MD.Module (\ M -> ML.power M (Lambda.1 x g) (suc n0)) (FS.E.power e V.1 x g) (MS.EM.power e (V.1 x g))
        (TS.at-point V.1 x g e))
       (PS.powers (V.1 x g) (Lambda.1 x g) e (suc n0)) ;
     fibre : Id MD.Module (PE.descended x) (IM.image q) =
      Pr1.trans MD.Module (PE.descended x) (PE.H x g) (IM.image q)
       (DA.Fam.TF.descend-fibre PE.weight-zero x g)
      (Pr1.trans MD.Module (PE.H x g) (ML.power (FS.E.power e V.1 x g) (Lambda.1 x g) (suc n0)) (IM.image q)
       fibre-power
      (Pr1.trans MD.Module (ML.power (FS.E.power e V.1 x g) (Lambda.1 x g) (suc n0)) (MS.EM.power (PS.count e (suc n0)) (PV.H x g))
       (IM.image q)
       powers
      (Pr1.trans MD.Module (MS.EM.power (PS.count e (suc n0)) (PV.H x g)) (MS.EM.power (PS.count e (suc n0)) (PV.descended x))
       (IM.image q)
       (Pr1.ap MD.Module MD.Module (MS.EM.power (PS.count e (suc n0))) (PV.H x g) (PV.descended x)
        (Pr1.sym MD.Module (PV.descended x) (PV.H x g) (DA.Fam.TF.descend-fibre PV.weight-zero x g)))
       target))) ;
    } ;
    -- (fibre), independently of g
    identity : Id MD.Module (PE.descended x) (IM.image q) =
     ConstantIdentity[l].Over[R,setR].At[(G x).1,TwistedFrames[l].Over[R,setR].Family[DA.X,G].point x,
      TM.GB.GL[G x].conn,PE.descended x,IM.image q,\ g -> Fb[g].fibre].theorem ;
   } ;
   -- (class)
   module PCE = PresentedClass[l].Over[R,setR,axioms].At[Alg,fp,PE.descended] ;
   module KEY = PCE.Key[q,\ x -> Pt[x].identity] ;
   class (p : PCE.FP.PJ.Projector) (rp : PCE.FP.Representation p) :
    Id TT.K.K0.R (TT.K.class p) (TT.K.K0.mul (TT.IK.nat (suc (PS.count e (suc n0)))) (TT.K.class FD.projector)) =
    trans (KEY.theorem p rp)
     (trans (TT.class-copies FD.projector (suc (PS.count e (suc n0))))
      (sym (TT.nat-mul (suc (PS.count e (suc n0))) (TT.K.class FD.projector)))) ;
   -- (rho)
   module Good (NV0 : Nat)
    (gv : Id HR.RQ.K.R (HR.RQ.rho (HR.K.class FD.projector) (HR.RT.IK.nat (suc NV0)) (HR.RQ.positive NV0)) HR.RQ.K.o) {
    -- M + 1 = (c+1)(N_V+1)
    rank : Nat = (Rational[l].times-suc (PS.count e (suc n0)) NV0).1 ;
    nat-rank : Id HR.K.K0.R (HR.RT.IK.nat (suc rank))
     (HR.K.K0.mul (HR.RT.IK.nat (suc (PS.count e (suc n0)))) (HR.RT.IK.nat (suc NV0))) =
     trans (ap HR.RT.IK.nat (sym (Rational[l].times-suc (PS.count e (suc n0)) NV0).2))
      (HR.RT.IK.nat-times (suc (PS.count e (suc n0))) (suc NV0)) ;
    -- M + 1 = (e+1)^n (N_V+1)
    rank-power : Id HR.K.K0.R (HR.RT.IK.nat (suc rank))
     (HR.K.K0.mul (HR.RT.PK.power (HR.RT.IK.nat (suc e)) (suc n0)) (HR.RT.IK.nat (suc NV0))) =
     trans nat-rank (ap (\ t -> HR.K.K0.mul t (HR.RT.IK.nat (suc NV0))) (Counts[HR.K.K0].count e (suc n0))) ;
    iota-mul (a b : HR.K.K0.R) : Id HR.RQ.K.R (HR.RT.iota (HR.K.K0.mul a b)) (HR.RQ.K.mul (HR.RT.iota a) (HR.RT.iota b)) =
     HR.RQ.iota.2.2.2 a b ;
    module Of (p : PCE.FP.PJ.Projector) (rp : PCE.FP.Representation p) {
     iota-class : Id HR.RQ.K.R (HR.RT.iota (HR.K.class p)) (HR.RT.iota (HR.RT.IK.nat (suc rank))) =
      calc HR.RQ.K.R { HR.RT.iota (HR.K.class p)
        =< ap HR.RT.iota (class p rp) > HR.RT.iota (HR.K.K0.mul (HR.RT.IK.nat (suc (PS.count e (suc n0)))) (HR.K.class FD.projector))
        =< iota-mul (HR.RT.IK.nat (suc (PS.count e (suc n0)))) (HR.K.class FD.projector) >
           HR.RQ.K.mul (HR.RT.iota (HR.RT.IK.nat (suc (PS.count e (suc n0))))) (HR.RT.iota (HR.K.class FD.projector))
        =< ap (HR.RQ.K.mul (HR.RT.iota (HR.RT.IK.nat (suc (PS.count e (suc n0))))))
            (HR.iota-eq (HR.K.class FD.projector) (HR.RT.IK.nat (suc NV0)) (HR.RQ.positive NV0) gv) >
           HR.RQ.K.mul (HR.RT.iota (HR.RT.IK.nat (suc (PS.count e (suc n0))))) (HR.RT.iota (HR.RT.IK.nat (suc NV0)))
        =< sym (iota-mul (HR.RT.IK.nat (suc (PS.count e (suc n0)))) (HR.RT.IK.nat (suc NV0))) >
           HR.RT.iota (HR.K.K0.mul (HR.RT.IK.nat (suc (PS.count e (suc n0)))) (HR.RT.IK.nat (suc NV0)))
        =< ap HR.RT.iota (sym nat-rank) > HR.RT.iota (HR.RT.IK.nat (suc rank)) } ;
     theorem : Id HR.RQ.K.R (HR.RQ.rho (HR.K.class p) (HR.RT.IK.nat (suc rank)) (HR.RQ.positive rank)) HR.RQ.K.o =
      trans (ap (\ t -> HR.RQ.K.mul t (HR.RQ.inverse (HR.RT.IK.nat (suc rank)) (HR.RQ.positive rank))) iota-class)
       (HR.RQ.inverse-law (HR.RT.IK.nat (suc rank)) (HR.RQ.positive rank)) ;
    } ;
    -- in the form of HOMROOTS' hypotheses: frame data of the descended P(V^(e+1))^v
    theorem (wE : PCE.FP.Data) :
     Id HR.RQ.K.R (HR.RQ.rho (HR.K.class PCE.FP.From[wE].projector) (HR.RT.IK.nat (suc rank)) (HR.RQ.positive rank)) HR.RQ.K.o =
     Of[PCE.FP.From[wE].projector,PCE.FP.From[wE].representation].theorem ;
   } ;
  } ;
 } ;
} ;
