-- H^2 is an abelian group (C3, steps C4-C5).  For a type X (X = Spec A),
-- H^2 = (X -> StackGerbe) modulo mere equality (STACKGERBES.H2).
--  (ops)   A pointwise operation on maps X -> StackGerbe respects mere
--          equality (ap), so it descends to the quotient (QUOTIENT.Descend);
--          for two arguments, descend in the second for each first argument,
--          then in the first (the maps H^2 -> H^2 form a set).
--              cl G + cl H = cl (x |-> G x + H x),  - cl G = cl (D . G),
--              0 = cl (x |-> T).
--  (laws)  The laws are propositions (H^2 is a set), so by induction on the
--          quotient it suffices to check them on classes; there they hold
--          pointwise (GERBELAWS), and pointwise equal maps have equal classes.
--  (T1)    n . cl G = cl (x |-> n . G x) (induction) = cl (x |-> D (n_* (G x)))
--          (GERBELAWS.times-push).
--  (T2)    cl K = 0 iff ||(x : X) -> K x||: the quotient is effective, so
--          cl K = 0 gives merely a path K = (x |-> T) of maps, along which the
--          base point of T moves to a global section; conversely a section k
--          makes each K x trivial (GERBEOPS.Pointed).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr1 = Truncation[l+] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module GL = GerbeLaws[l].Over[R,setR,axioms,loc,sh] ;
 module GO = GL.GO ;
 module SG = GL.SG ;
 SGb : U l+ = SG.StackGerbe ;
 module At (X : U l) {
  module H = SG.H2[X] ;
  module Q = H.Q ;
  C : U l+ = H.Classes ;
  H2 : U l+ = H.H2 ;
  set : Hi.isSet H2 = Q.set ;
  cl (G : C) : H2 = H.cl G ;
  -- (ops)
  module Unary (op : X -> SGb -> SGb) {
   f (G : C) : H2 = cl (\ x -> op x (G x)) ;
   respect (G G' : C) (r : H.Same G G') : Id H2 (f G) (f G') =
    Q.relates (\ x -> op x (G x)) (\ x -> op x (G' x))
     (TruncationCombinators[l+].map (Id C G G') (Id C (\ x -> op x (G x)) (\ x -> op x (G' x)))
      (Hi.ap C C (\ K x -> op x (K x)) G G') r) ;
   module D = Q.Descend[H2,set,f,respect] ;
   map (q : H2) : H2 = D.map q ;
   beta (G : C) : Id H2 (map (cl G)) (f G) = D.beta G ;
  } ;
  module Binary (op : SGb -> SGb -> SGb) {
   inner (G : C) (q : H2) : H2 = Unary[\ x K -> op (G x) K].map q ;
   fun-set : Hi.isSet (H2 -> H2) = F1.isSet-Pi H2 (\ q -> H2) (\ q -> set) ;
   respect (G G' : C) (r : H.Same G G') : Id (H2 -> H2) (inner G) (inner G') =
    Tr1.Trunc[Id C G G'].induction @(l+) (\ t -> Id (H2 -> H2) (inner G) (inner G')) (\ t -> fun-set (inner G) (inner G'))
     (\ p -> Hi.ap C (H2 -> H2) inner G G' p) r ;
   module D = Q.Descend[H2 -> H2,fun-set,inner,respect] ;
   map (q r : H2) : H2 = D.map q r ;
   beta (G G' : C) : Id H2 (map (cl G) (cl G')) (cl (\ x -> op (G x) (G' x))) =
    Hi.trans H2 (map (cl G) (cl G')) (inner G (cl G')) (cl (\ x -> op (G x) (G' x)))
     (Hi.happly H2 (\ q -> H2) (D.map (cl G)) (inner G) (D.beta G) (cl G'))
     (Unary[\ x K -> op (G x) K].beta G') ;
  } ;
  module Plus = Binary[GL.sum] ;
  module Neg = Unary[\ x K -> GL.dual K] ;
  plus (q r : H2) : H2 = Plus.map q r ;
  neg (q : H2) : H2 = Neg.map q ;
  zero : H2 = cl (\ x -> GO.trivial) ;
  -- (laws)
  pointwise (G G' : C) (h : (x : X) -> Id SGb (G x) (G' x)) : Id H2 (cl G) (cl G') = H.cl-eq G G' (Tr1.Trunc[(x : X) -> Id SGb (G x) (G' x)].inc h) ;
  ind1 (P : H2 -> U l+) (p : (q : H2) -> Hi.isProp (P q)) (b : (G : C) -> P (cl G)) (q : H2) : P q = Q.induction @(l+) P p b q ;
  comm (q r : H2) : Id H2 (plus q r) (plus r q) =
   ind1 (\ q1 -> (r1 : H2) -> Id H2 (plus q1 r1) (plus r1 q1))
    (\ q1 -> F1.isProp-Pi H2 (\ r1 -> Id H2 (plus q1 r1) (plus r1 q1)) (\ r1 -> set (plus q1 r1) (plus r1 q1)))
    (\ G -> ind1 (\ r1 -> Id H2 (plus (cl G) r1) (plus r1 (cl G))) (\ r1 -> set (plus (cl G) r1) (plus r1 (cl G)))
      (\ G' -> Hi.trans H2 _ (cl (\ x -> GL.sum (G x) (G' x))) _ (Plus.beta G G')
        (Hi.trans H2 _ (cl (\ x -> GL.sum (G' x) (G x))) _ (pointwise _ _ (\ x -> GL.Comm[G x,G' x].theorem))
         (Hi.sym H2 (plus (cl G') (cl G)) _ (Plus.beta G' G))))) q r ;
  unit (q : H2) : Id H2 (plus q zero) q =
   ind1 (\ q1 -> Id H2 (plus q1 zero) q1) (\ q1 -> set (plus q1 zero) q1)
    (\ G -> Hi.trans H2 _ (cl (\ x -> GL.sum (G x) GO.trivial)) _ (Plus.beta G (\ x -> GO.trivial))
      (pointwise _ _ (\ x -> GL.Neutral[G x].theorem))) q ;
  inverse (q : H2) : Id H2 (plus q (neg q)) zero =
   ind1 (\ q1 -> Id H2 (plus q1 (neg q1)) zero) (\ q1 -> set (plus q1 (neg q1)) zero)
    (\ G -> Hi.trans H2 _ (plus (cl G) (cl (\ x -> GL.dual (G x)))) _
      (Hi.ap H2 H2 (plus (cl G)) _ _ (Neg.beta G))
      (Hi.trans H2 _ (cl (\ x -> GL.sum (G x) (GL.dual (G x)))) _ (Plus.beta G (\ x -> GL.dual (G x)))
       (pointwise (\ x -> GL.sum (G x) (GL.dual (G x))) (\ x -> GO.trivial) (\ x -> GL.Inverse[G x].theorem)))) q ;
  assoc (q r s : H2) : Id H2 (plus (plus q r) s) (plus q (plus r s)) =
   ind1 (\ q1 -> (r1 s1 : H2) -> Id H2 (plus (plus q1 r1) s1) (plus q1 (plus r1 s1)))
    (\ q1 -> F1.isProp-Pi H2 (\ r1 -> (s1 : H2) -> Id H2 (plus (plus q1 r1) s1) (plus q1 (plus r1 s1)))
      (\ r1 -> F1.isProp-Pi H2 (\ s1 -> Id H2 (plus (plus q1 r1) s1) (plus q1 (plus r1 s1))) (\ s1 -> set _ _)))
    (\ G -> ind1 (\ r1 -> (s1 : H2) -> Id H2 (plus (plus (cl G) r1) s1) (plus (cl G) (plus r1 s1)))
      (\ r1 -> F1.isProp-Pi H2 (\ s1 -> Id H2 (plus (plus (cl G) r1) s1) (plus (cl G) (plus r1 s1))) (\ s1 -> set _ _))
      (\ G' -> ind1 (\ s1 -> Id H2 (plus (plus (cl G) (cl G')) s1) (plus (cl G) (plus (cl G') s1))) (\ s1 -> set _ _)
        (\ G'' ->
         calc H2 { plus (plus (cl G) (cl G')) (cl G'')
          =< Hi.ap H2 H2 (\ t -> plus t (cl G'')) _ _ (Plus.beta G G') > plus (cl (\ x -> GL.sum (G x) (G' x))) (cl G'')
          =< Plus.beta (\ x -> GL.sum (G x) (G' x)) G'' > cl (\ x -> GL.sum (GL.sum (G x) (G' x)) (G'' x))
          =< pointwise _ _ (\ x -> GL.Assoc[G x,G' x,G'' x].theorem) > cl (\ x -> GL.sum (G x) (GL.sum (G' x) (G'' x)))
          =< Hi.sym H2 (plus (cl G) (cl (\ x -> GL.sum (G' x) (G'' x)))) _ (Plus.beta G (\ x -> GL.sum (G' x) (G'' x))) >
             plus (cl G) (cl (\ x -> GL.sum (G' x) (G'' x)))
          =< Hi.ap H2 H2 (plus (cl G)) _ _ (Hi.sym H2 (plus (cl G') (cl G'')) _ (Plus.beta G' G'')) > plus (cl G) (plus (cl G') (cl G'')) }))) q r s ;
  -- (T1)
  times (q : H2) : Nat -> H2 = split { zero -> zero ; suc n | t -> plus q t } ;
  times-cl (G : C) : (n : Nat) -> Id H2 (times (cl G) n) (cl (\ x -> GL.times (G x) n)) = split {
   zero -> refl zero ;
   suc n | h -> Hi.trans H2 (plus (cl G) (times (cl G) n)) (plus (cl G) (cl (\ x -> GL.times (G x) n))) _
    (Hi.ap H2 H2 (plus (cl G)) _ _ h) (Plus.beta G (\ x -> GL.times (G x) n)) } ;
  T1 (G : C) (n : Nat) : Id H2 (times (cl G) n) (cl (\ x -> GL.dual (GL.push (G x) n))) =
   Hi.trans H2 _ (cl (\ x -> GL.times (G x) n)) _ (times-cl G n) (pointwise _ _ (\ x -> GL.times-push (G x) n)) ;
  -- (T2)
  section (K : C) (p : Id C K (\ x -> GO.trivial)) (x : X) : (K x).1 =
   Hi.subst SGb (\ G -> G.1) GO.trivial (K x)
    (Hi.sym SGb (K x) GO.trivial (Hi.happly X (\ y -> SGb) K (\ y -> GO.trivial) p x)) GO.base ;
  trivial-class (K : C) (h : Id H2 (cl K) zero) : Tr1.Trunc[(x : X) -> (K x).1].carrier =
   Tr1.Trunc[Id C K (\ x -> GO.trivial)].induction @(l+) (\ t -> Tr1.Trunc[(x : X) -> (K x).1].carrier)
    (\ t -> Tr1.Trunc[(x : X) -> (K x).1].proposition)
    (\ p -> Tr1.Trunc[(x : X) -> (K x).1].inc (section K p)) (Q.effective K (\ x -> GO.trivial) h) ;
  trivial-class-back (K : C) (k : (x : X) -> (K x).1) : Id H2 (cl K) zero = pointwise K (\ x -> GO.trivial) (\ x -> GO.Pointed[K x,k x].theorem) ;
 } ;
} ;
