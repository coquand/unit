-- Every valid derivation evaluates to an equality in every solution.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (pres : Presentations[l].Over[R,setR].Presentation) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module D = ExpressionCongruence[l].Over[R,setR,pres] ; open D ;
 module At (B : C.Algebra) (s : P.Solutions pres B) {
  ev : Term -> B.ring.R = P.eval V B s.1 ;
  zero-value : Id B.ring.R (ev zeroE) B.ring.z = RingHom[l].zero R B.ring B.iota ;
  neg-value (p : Term) : Id B.ring.R (ev (negative p)) (B.ring.neg (ev p)) = calc B.ring.R {
   B.ring.mul (B.iota.1 (R.neg R.o)) (ev p)
    =< ap (\ b -> B.ring.mul b (ev p)) (RingHom[l].negation R B.ring B.iota R.o)
      > B.ring.mul (B.ring.neg (B.iota.1 R.o)) (ev p)
    =< ap (\ b -> B.ring.mul (B.ring.neg b) (ev p)) B.iota.2.1
      > B.ring.mul (B.ring.neg B.ring.o) (ev p)
    =< B.ring.mulC (B.ring.neg B.ring.o) (ev p) > B.ring.mul (ev p) (B.ring.neg B.ring.o)
    =< RL[B.ring].mul-neg (ev p) B.ring.o > B.ring.neg (B.ring.mul (ev p) B.ring.o)
    =< ap B.ring.neg (B.ring.mulO (ev p)) > B.ring.neg (ev p) } ;
  member-step (p : Term) (ps : List Term) (z : P.Zeros V B s.1 (cons p ps))
   (ih : (e : Term) -> Member e ps -> Id B.ring.R (ev e) B.ring.z) (e : Term) :
   Member e (cons p ps) -> Id B.ring.R (ev e) B.ring.z = split {
    inl h -> trans (ap ev h) z.1 ; inr m -> ih e m } ;
  member-zero : (es : List Term) -> P.Zeros V B s.1 es ->
   (e : Term) -> Member e es -> Id B.ring.R (ev e) B.ring.z = split {
    nil -> \ z e m -> efq m ; cons p ps | ih -> \ z -> member-step p ps z (ih z.2) } ;
  sound : (d : Tree) -> Valid d -> Id B.ring.R (ev (ends d).1) (ev (ends d).2) = split {
   reflD p -> \ v -> refl (ev p) ; symD d | ih -> \ v -> sym (ih v) ;
   transD d e | rd re -> \ v -> trans (rd v.1) (trans (ap ev v.2.2) (re v.2.1)) ;
   sumD d e | rd re -> \ v -> Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (rd v.1) (re v.2) ;
   mulD d e | rd re -> \ v -> Presentations[l].cong2 B.ring.R B.ring.mul _ _ _ _ (rd v.1) (re v.2) ;
   addAssoc p q r -> \ v -> B.ring.addA (ev p) (ev q) (ev r) ;
   addComm p q -> \ v -> B.ring.addC (ev p) (ev q) ;
   addZero p -> \ v -> trans (ap (B.ring.add (ev p)) zero-value) (B.ring.addZ (ev p)) ;
   addNeg p -> \ v -> trans (ap (B.ring.add (ev p)) (neg-value p)) (trans (B.ring.addN (ev p)) (sym zero-value)) ;
   mulAssoc p q r -> \ v -> B.ring.mulA (ev p) (ev q) (ev r) ;
   mulComm p q -> \ v -> B.ring.mulC (ev p) (ev q) ;
   mulOne p -> \ v -> trans (ap (B.ring.mul (ev p)) B.iota.2.1) (B.ring.mulO (ev p)) ;
   distrib p q r -> \ v -> B.ring.dist (ev p) (ev q) (ev r) ;
   coeffAdd a b -> \ v -> sym (B.iota.2.2.1 a b) ;
   coeffMul a b -> \ v -> sym (B.iota.2.2.2 a b) ;
   equation p member -> \ v -> trans (member-zero pres.2 s.2 p member) (sym zero-value) } ;
  proof-sound (p q : Term) (w : Proof p q) : Id B.ring.R (ev p) (ev q) =
   trans (sym (ap ev w.2.2.1)) (trans (sound w.1 w.2.1) (ap ev w.2.2.2)) ;
  respects (p q : Term) : Relation p q -> Id B.ring.R (ev p) (ev q) =
   Truncation[l].Trunc[Proof p q].induction @l (\ t -> Id B.ring.R (ev p) (ev q))
    (\ t -> B.set _ _) (proof-sound p q) ;
 } ;
} ;
