-- Quotients by finite families of arbitrary algebra elements.
-- The public result is mere existence with the full canonical UP.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Finite = AffineFinite[l].Over[R,setR] ;
 Kills (A B : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (h : C.Hom A B) : U l =
  (i : Fin n) -> Id B.ring.R (h.1.1 (fs i)) B.ring.z ;
 kills-prop (A B : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (h : C.Hom A B) :
  Pr.isProp (Kills A B n fs h) =
  F.isProp-Pi (Fin n) (\ i -> Id B.ring.R (h.1.1 (fs i)) B.ring.z) (\ i -> B.set _ _) ;
 Data (A B : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) : U l =
  (h : C.Hom A B) * Kills A B n fs h ;
 map (A Q B : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (inc : C.Hom A Q)
  (kills : Kills A Q n fs inc) (h : C.Hom Q B) : Data A B n fs =
  (C.compose A Q B h inc,\ i -> trans (ap h.1.1 (kills i)) (RingHom[l].zero Q.ring B.ring h.1)) ;
 Quotients (A Q : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (inc : C.Hom A Q) : U l+ =
  (kills : Kills A Q n fs inc) *
  ((B : C.Algebra) -> Pr.isEquiv (C.Hom Q B) (Data A B n fs) (map A Q B n fs inc kills)) ;
 Witness (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) : U l+ =
  (Q : C.Algebra) * P.FP Q * ((inc : C.Hom A Q) * Quotients A Q n fs inc) ;
 module Presented (A : C.Algebra) (p : P.Presentation) (pa : P.Presents p A)
  (n : Nat) (fs : Fin n -> A.ring.R) (es : Fin n -> P.Expr (Fin p.1))
  (rep : (i : Fin n) -> Id A.ring.R (P.eval (Fin p.1) A pa.1.1 (es i)) (fs i)) {
  V : U l = Fin p.1 ;
  module Q = EquationExtension[l].Over[R,setR].Extend[p,A,pa,Finite.listed V n es] ;
  module To (B : C.Algebra) {
   module E = Q.To[B] ;
   ev (h : C.Hom A B) (i : Fin n) :
    Id B.ring.R (P.eval V B (\ v -> h.1.1 (pa.1.1 v)) (es i)) (h.1.1 (fs i)) =
    trans (sym (P.natural V A B h pa.1.1 (es i))) (ap h.1.1 (rep i)) ;
   forward (d : E.Data) : Data A B n fs =
    (d.1,\ i -> trans (sym (ev d.1 i))
      (Finite.zeros-out V B (\ v -> d.1.1.1 (pa.1.1 v)) n es d.2 i)) ;
   backward (d : Data A B n fs) : E.Data =
    (d.1,Finite.zeros-in V B (\ v -> d.1.1.1 (pa.1.1 v)) n es
     (\ i -> trans (ev d.1 i) (d.2 i))) ;
   fb (d : Data A B n fs) : Id (Data A B n fs) (forward (backward d)) d =
    Pr.Sigma-eq _ (Kills A B n fs) _ _ _ _ (refl d.1) (kills-prop A B n fs d.1) ;
   bf (d : E.Data) : Id E.Data (backward (forward d)) d =
    Pr.Sigma-eq _ E.Conditions _ _ _ _ (refl d.1) (E.condition-prop d.1) ;
   equivalence : Pr.Equiv (C.Hom Q.algebra B) (Data A B n fs) =
    Equivalences[l].compose _ _ _ E.equivalence (forward,Pr.qinv _ _ forward backward fb bf) ;
  } ;
  kills : Kills A Q.algebra n fs Q.inclusion = (To[Q.algebra].forward (Q.inclusion,Q.equations)).2 ;
  universal (B : C.Algebra) : Pr.isEquiv (C.Hom Q.algebra B) (Data A B n fs)
   (map A Q.algebra B n fs Q.inclusion kills) =
   Equivalences[l].homotopy _ _ To[B].equivalence (map A Q.algebra B n fs Q.inclusion kills)
    (\ h -> Pr.Sigma-eq _ (Kills A B n fs) _ _ _ _
      (refl (C.compose A Q.algebra B h Q.inclusion)) (kills-prop A B n fs _)) ;
  result : Witness A n fs = (Q.algebra,Q.fp,Q.inclusion,kills,universal) ;
 } ;
 quotient (A : C.Algebra) (fp : P.FP A) (n : Nat) (fs : Fin n -> A.ring.R) : Tr1.Trunc[Witness A n fs].carrier =
  Tr1.Trunc[P.Witness A].induction @(l+) (\ t -> Tr1.Trunc[Witness A n fs].carrier)
   (\ t -> Tr1.Trunc[Witness A n fs].proposition)
   (\ w -> Tr.Trunc[(i : Fin n) -> AffineGenerated[l].Over[R,setR,A,w.1,w.2].Rep (fs i)].induction @(l+)
    (\ t -> Tr1.Trunc[Witness A n fs].carrier) (\ t -> Tr1.Trunc[Witness A n fs].proposition)
    (\ es -> Tr1.Trunc[Witness A n fs].inc (Presented[A,w.1,w.2,n,fs,\ i -> (es i).1,\ i -> (es i).2].result))
    (AffineFinite[l].choice n (\ i -> AffineGenerated[l].Over[R,setR,A,w.1,w.2].Rep (fs i))
      (\ i -> AffineGenerated[l].Over[R,setR,A,w.1,w.2].generated (fs i)))) fp ;
 spectrum (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (q : Witness A n fs) :
  Pr.Equiv (C.Spec q.1) ((x : C.Spec A) * ((i : Fin n) -> Id R.R (x.1.1 (fs i)) R.z)) =
  (map A q.1 C.base n fs q.2.2.1 q.2.2.2.1,q.2.2.2.2 C.base) ;
} ;
