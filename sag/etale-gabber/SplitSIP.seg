-- Paths of splittings are arrows (H^2 bridges, A1): for splittings o, o'
-- of an algebra E (SPLITOBJECTS),
--     Id Obj o o'  ~  Arrow o o',
-- by the map sending refl to the identity arrow.  So Split(E) is a 1-type
-- whose paths are the arrows.
-- Proof (Rijke 11.2.2, SIPGENERIC.Fundamental): the total space
-- (o' : Obj) * Arrow o o' is contractible, with centre (o, identity).  An
-- element is a module M' with a linear equivalence e : o.1 ~ M', a mere
-- basis b' and a splitting sigma' of M', e intertwining the two splittings.
-- By iso-induction on (M', e) (module SIP, MODULESIP2) we may take
-- e = id.  Then intertwining says sigma s x = sigma' s x, so sigma = sigma'
-- (an algebra isomorphism is determined by its function), b = b' (a
-- proposition), and the arrow is the identity (an arrow is determined by
-- its function).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module MS = ModuleSIP2[l].Over[MD.ring] ;
 module EN = ModuleEnd[l].Over[R,setR] ;
 module AS = AlgSIP[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module At (N : Nat) (E : EN.NA.Algebra) {
  module SO = SplitObjects[l].Over[R,setR,axioms].At[N,E] ;
  -- a splitting is determined by its action
  splits-eq (M : MD.Module) (sg sg' : SO.Splits M)
   (h : (s : E.A) (x : M.M) -> Id M.M ((sg.1.1 s).1 x) ((sg'.1.1 s).1 x)) : Id (SO.Splits M) sg sg' =
   Pr.Sigma-eq (Pr.Equiv E.A EN.At[M].H.S.E) (\ e -> AS.Hom E EN.At[M].algebra e.1) sg.1 sg'.1 sg.2 sg'.2
    (Pr.Sigma-eq (E.A -> EN.At[M].H.S.E) (\ f -> Pr.isEquiv E.A EN.At[M].H.S.E f) sg.1.1 sg'.1.1 sg.1.2 sg'.1.2
      (F.funext E.A (\ s -> EN.At[M].H.S.E) sg.1.1 sg'.1.1 (\ s -> EN.At[M].H.ext (sg.1.1 s) (sg'.1.1 s) (h s)))
      (Prop331Paths[l].isEquiv-prop E.A EN.At[M].H.S.E sg'.1.1))
    (AS.hom-prop E EN.At[M].algebra sg'.1.1) ;
  -- the total space of arrows out of o
  Total (o : SO.Obj) : U l+ = (o' : SO.Obj) * SO.Arrow o o' ;
  Inter (o o' : SO.Obj) (f : (SO.carrier o).M -> (SO.carrier o').M) : U l =
   (s : E.A) (x : (SO.carrier o).M) -> Id (SO.carrier o').M (f (SO.act o s x)) (SO.act o' s (f x)) ;
  -- the arrow of an intertwining linear equivalence
  arrow-of (o o' : SO.Obj) (e : MS.LinEquiv (SO.carrier o) (SO.carrier o')) (i : Inter o o' e.1.1) : SO.Arrow o o' =
   ((e.1.1,e.2),e.1.2,i) ;
  Mot (o : SO.Obj) (M' : MD.Module) (e : MS.LinEquiv (SO.carrier o) M') : U l+ =
   (b' : Tr.Trunc[LF.Basis[M',N]].carrier) (sg' : SO.Splits M') (i : Inter o (M',b',sg') e.1.1) ->
    Id (Total o) (o,SO.identity o) ((M',b',sg'),arrow-of o (M',b',sg') e i) ;
  -- e = id: first the splitting, then the basis
  at-splitting (o : SO.Obj) (sg' : SO.Splits (SO.carrier o)) (ps : Id (SO.Splits (SO.carrier o)) o.2.2 sg') :
   (i : Inter o (o.1,o.2.1,sg') (\ x -> x)) ->
    Id (Total o) (o,SO.identity o) ((o.1,o.2.1,sg'),arrow-of o (o.1,o.2.1,sg') (MS.idLin o.1) i) =
   idJ (SO.Splits (SO.carrier o)) o.2.2 (\ s2 q2 -> (i : Inter o (o.1,o.2.1,s2) (\ x -> x)) ->
     Id (Total o) (o,SO.identity o) ((o.1,o.2.1,s2),arrow-of o (o.1,o.2.1,s2) (MS.idLin o.1) i))
    (\ i -> Hi.ap (SO.Arrow o o) (Total o) (\ a -> (o,a)) (SO.identity o) (arrow-of o o (MS.idLin o.1) i)
      (SO.arrow-eq o o (SO.identity o) (arrow-of o o (MS.idLin o.1) i) (\ x -> refl x))) sg' ps ;
  base (o : SO.Obj) : Mot o (SO.carrier o) (MS.idLin (SO.carrier o)) = \ b' sg' i ->
   idJ (Tr.Trunc[LF.Basis[o.1,N]].carrier) o.2.1 (\ b2 q2 -> (i2 : Inter o (o.1,b2,sg') (\ x -> x)) ->
     Id (Total o) (o,SO.identity o) ((o.1,b2,sg'),arrow-of o (o.1,b2,sg') (MS.idLin o.1) i2))
    (at-splitting o sg' (splits-eq o.1 o.2.2 sg' i)) b' (Tr.Trunc[LF.Basis[o.1,N]].proposition o.2.1 b') i ;
  contr (o : SO.Obj) : FunExtUA[l+].isContr (Total o) =
   ((o,SO.identity o),\ w -> MS.Fd.iso-ind (SO.carrier o) (Mot o) (base o) w.1.1 ((w.2.1.1,w.2.2.1),w.2.1.2)
     w.1.2.1 w.1.2.2 w.2.2.2) ;
  module Fd = SipGeneric[l].Fundamental[SO.Obj,SO.Arrow,SO.identity,contr] ;
  -- the theorem
  to-arrow (o o' : SO.Obj) (p : Id SO.Obj o o') : SO.Arrow o o' = Fd.idToIso o o' p ;
  to-path (o o' : SO.Obj) (a : SO.Arrow o o') : Id SO.Obj o o' = Fd.sip o o' a ;
  to-arrow-refl (o : SO.Obj) : Id (SO.Arrow o o) (to-arrow o o (refl o)) (SO.identity o) = refl (SO.identity o) ;
  equiv (o o' : SO.Obj) : Hi.isEquiv (Id SO.Obj o o') (SO.Arrow o o') (to-arrow o o') =
   Hi.qinv (Id SO.Obj o o') (SO.Arrow o o') (to-arrow o o') (to-path o o') (Fd.idToIso-sip o o') (Fd.sip-idToIso o o') ;
  paths-set (o o' : SO.Obj) : Hi.isSet (Id SO.Obj o o') =
   AffineHLevels[l+].set-from-equiv (Id SO.Obj o o') (SO.Arrow o o') (SO.arrow-set o o') (to-arrow o o') (equiv o o') ;
 } ;
} ;
