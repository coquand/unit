-- TrivialGerbe.seg: the trivial A-gerbe.  The A-torsors form a 1-type
-- whose loops are A (tb: the a with  transl a = idtohom l), and whose
-- path types are small (tor-small).  Its small version K is the image of
-- the point A under replacement; K is an A-gerbe (KG), and the inclusion
-- iota : K -> Tor has contractible fibres (iota-fib).

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open FunExtUA[l] ;
open Torsor[l] ;
open TorsorId[l] ;
open Groupoid[l] ;
open Gerbe[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;
module E1 = FunExtUA[l+] ;
module G1 = Groupoid[l+] ;
module R = Replacement[l,l+] ;

module TrivG (Gr : Ab) {
  open Gr ;
  open AbL[Gr] ;
  open TorBase[Gr] ;
  open TorId[Gr] ;
  open Gerbes[Gr] ;

  ----------------------------------------------------------------------
  -- the trivial torsor A

  shiftc (t t' : A) : Id A (add (add t' (inv t)) t) t' =
    transH (assoc t' (inv t) t) (transH (ap A A (add t') (add (inv t) t) o (invl t)) (unitr t')) ;

  aft : FT A add = \ t t' ->
    ((add t' (inv t), shiftc t t'),
     \ z -> Sigma-eq A (\ a -> Id A (add a t) t') (add t' (inv t)) z.1 (shiftc t t') z.2
              (symH (solve z.1 t t' z.2)) (setA (add z.1 t) t')) ;

  Atriv : Tor = (A, (add, setA, \ a b t -> assoc a b t, \ t -> unitl t, aft, Tr.Trunc[A].inc o)) ;

  ----------------------------------------------------------------------
  -- Tor is a 1-type with small path types

  tor-gpd (X Y : Tor) : P1.isSet (Id Tor X Y) =
    G1.set-retract (Id Tor X Y) (Hom X Y) (idtohom X Y) (decode X Y) (dec-enc X Y) (hom-set X Y) ;

  idtohom-decode (X Y : Tor) (f : Hom X Y) : Id (Hom X Y) (idtohom X Y (decode X Y f)) f =
    enc-dec X (Y, f) (E1.pathC (TH X) (contr X) (X, idhom X) (Y, f)) ;

  tor-small : R.LocallySmall Tor = \ X Y ->
    (Hom X Y, (decode X Y, P1.qinv (Hom X Y) (Id Tor X Y) (decode X Y) (idtohom X Y)
                             (dec-enc X Y) (idtohom-decode X Y))) ;

  -- idtohom sends composition to composition
  idtohom-trans (X Y : Tor) (p : Id Tor X Y) : (Z : Tor) (q : Id Tor Y Z) (t : X.1)
    -> Id Z.1 ((idtohom X Z (P1.trans Tor X Y Z p q)).1 t) ((idtohom Y Z q).1 ((idtohom X Y p).1 t)) =
    \ Z q -> idJ Tor Y (\ Z' q' -> (t : X.1)
                -> Id Z'.1 ((idtohom X Z' (P1.trans Tor X Y Z' p q')).1 t) ((idtohom Y Z' q').1 ((idtohom X Y p).1 t)))
               (\ t -> refl ((idtohom X Y p).1 t)) Z q ;

  ----------------------------------------------------------------------
  -- the band of Tor at X: tb l is the a with  transl a = idtohom l

  tb (X : Tor) (lp : Id Tor X X) : A = (AutM[X].fa (idtohom X X lp)).1.1 ;
  tb-tr (X : Tor) (lp : Id Tor X X) : Id (Hom X X) (transl X (tb X lp)) (idtohom X X lp) =
    (AutM[X].fa (idtohom X X lp)).1.2 ;
  tb-char (X : Tor) (lp : Id Tor X X) (a : A) (q : Id (Hom X X) (transl X a) (idtohom X X lp))
    : Id A (tb X lp) a =
    ap (AutM[X].Fa (idtohom X X lp)) A (\ z -> z.1) (AutM[X].fa (idtohom X X lp)).1 (a, q)
       ((AutM[X].fa (idtohom X X lp)).2 (a, q)) ;

  tloop (X : Tor) (a : A) : Id Tor X X = decode X X (transl X a) ;

  tb-be (X : Tor) (a : A) : E1.isContr ((lp : Id Tor X X) * Id A (tb X lp) a) =
    ((tloop X a, tb-char X (tloop X a) a (symH (idtohom-decode X X (transl X a)))),
     \ z -> P1.Sigma-eq (Id Tor X X) (\ lp -> Id A (tb X lp) a) (tloop X a) z.1
              (tb-char X (tloop X a) a (symH (idtohom-decode X X (transl X a)))) z.2
              (P1.trans (Id Tor X X) (tloop X a) (decode X X (idtohom X X z.1)) z.1
                 (P1.ap (Hom X X) (Id Tor X X) (decode X X) (transl X a) (idtohom X X z.1)
                    (transH (ap A (Hom X X) (transl X) a (tb X z.1) (symH z.2)) (tb-tr X z.1)))
                 (dec-enc X X z.1))
              (setA (tb X z.1) a)) ;

  tb-hom (X : Tor) (p q : Id Tor X X)
    : Id A (tb X (P1.trans Tor X X X p q)) (add (tb X p) (tb X q)) =
    tb-char X (P1.trans Tor X X X p q) (add (tb X p) (tb X q))
      (hom-eq X X (transl X (add (tb X p) (tb X q))) (idtohom X X (P1.trans Tor X X X p q)) (\ t ->
        calc X.1 {
          X.2.1 (add (tb X p) (tb X q)) t
            =< ap A X.1 (\ c -> X.2.1 c t) (add (tb X p) (tb X q)) (add (tb X q) (tb X p)) (comm (tb X p) (tb X q))
            > X.2.1 (add (tb X q) (tb X p)) t
            =< X.2.2.2.1 (tb X q) (tb X p) t > X.2.1 (tb X q) (X.2.1 (tb X p) t)
            =< ap X.1 X.1 (X.2.1 (tb X q)) (X.2.1 (tb X p) t) ((idtohom X X p).1 t)
                  (ap (Hom X X) X.1 (\ f -> f.1 t) (transl X (tb X p)) (idtohom X X p) (tb-tr X p))
            > X.2.1 (tb X q) ((idtohom X X p).1 t)
            =< ap (Hom X X) X.1 (\ f -> f.1 ((idtohom X X p).1 t)) (transl X (tb X q)) (idtohom X X q) (tb-tr X q)
            > (idtohom X X q).1 ((idtohom X X p).1 t)
            =< symH (idtohom-trans X X p X q t) > (idtohom X X (P1.trans Tor X X X p q)).1 t })) ;

  ----------------------------------------------------------------------
  -- the small trivial gerbe K: the image of the point A in Tor

  pt (x : Top) : Tor = Atriv ;
  img : R.Image[Top, Tor, pt] = images @l @(l+) Top Tor tor-small pt ;
  K : U l = img.carrier ;
  k0 : K = img.quotient tt ;
  iota (k : K) : Tor = img.inclusion k ;

  top-elim (F : K -> U l) (b : F k0) : (x : Top) -> F (img.quotient x) = split { tt -> b } ;
  kind (F : K -> U l) (pF : (k : K) -> isProp (F k)) (b : F k0) (k : K) : F k =
    (surjections @l @(l+) @l Top Tor tor-small pt F pF).sec (top-elim F b) k ;

  emb (a b : K) : P1.isEquiv (Id K a b) (Id Tor (iota a) (iota b)) (P1.ap K Tor iota a b) =
    img.embedding a b ;

  k-gpd (a b : K) : isSet (Id K a b) =
    G1.set-retract (Id K a b) (Id Tor (iota a) (iota b)) (P1.ap K Tor iota a b) (emb a b).ret
      (emb a b).ret-eq (tor-gpd (iota a) (iota b)) ;

  k-conn (a b : K) : Tr.Trunc[Id K a b].carrier =
    kind (\ a' -> Tr.Trunc[Id K a' b].carrier) (\ a' -> Tr.Trunc[Id K a' b].proposition)
      (kind (\ b' -> Tr.Trunc[Id K k0 b'].carrier) (\ b' -> Tr.Trunc[Id K k0 b'].proposition)
         (Tr.Trunc[Id K k0 k0].inc (refl k0)) b) a ;

  -- the band of K is that of Tor through iota
  kb (a : K) (lp : Id K a a) : A = tb (iota a) (P1.ap K Tor iota a a lp) ;

  kb-be (a : K) (c : A) : isContr ((lp : Id K a a) * Id A (kb a lp) c) =
    (((emb a a).sec (tb-be (iota a) c).1.1,
      transH (P1.ap (Id Tor (iota a) (iota a)) A (tb (iota a))
                 (P1.ap K Tor iota a a ((emb a a).sec (tb-be (iota a) c).1.1)) (tb-be (iota a) c).1.1
                 ((emb a a).sec-eq (tb-be (iota a) c).1.1))
             (tb-be (iota a) c).1.2),
     \ z -> Sigma-eq (Id K a a) (\ lp -> Id A (kb a lp) c) ((emb a a).sec (tb-be (iota a) c).1.1) z.1
              (transH (P1.ap (Id Tor (iota a) (iota a)) A (tb (iota a))
                         (P1.ap K Tor iota a a ((emb a a).sec (tb-be (iota a) c).1.1)) (tb-be (iota a) c).1.1
                         ((emb a a).sec-eq (tb-be (iota a) c).1.1))
                      (tb-be (iota a) c).1.2)
              z.2
              (transH (P1.ap (Id Tor (iota a) (iota a)) (Id K a a) (emb a a).sec
                         (tb-be (iota a) c).1.1 (P1.ap K Tor iota a a z.1)
                         (P1.ap ((lp : Id Tor (iota a) (iota a)) * Id A (tb (iota a) lp) c) (Id Tor (iota a) (iota a))
                            (\ w -> w.1) (tb-be (iota a) c).1 (P1.ap K Tor iota a a z.1, z.2)
                            ((tb-be (iota a) c).2 (P1.ap K Tor iota a a z.1, z.2))))
                      (P1.sec-ret (Id K a a) (Id Tor (iota a) (iota a)) (P1.ap K Tor iota a a) (emb a a) z.1))
              (setA (kb a z.1) c)) ;

  kb-hom (a : K) (p q : Id K a a) : Id A (kb a (trans K a a a p q)) (add (kb a p) (kb a q)) =
    transH (P1.ap (Id Tor (iota a) (iota a)) A (tb (iota a))
               (P1.ap K Tor iota a a (trans K a a a p q))
               (P1.trans Tor (iota a) (iota a) (iota a) (P1.ap K Tor iota a a p) (P1.ap K Tor iota a a q))
               (G1.ap-trans K Tor iota a a a p q))
           (tb-hom (iota a) (P1.ap K Tor iota a a p) (P1.ap K Tor iota a a q)) ;

  KG : AGerbe = (K, k-gpd, Tr.Trunc[K].inc k0, k-conn, \ a -> (kb a, kb-be a, kb-hom a)) ;

  ----------------------------------------------------------------------
  -- iota : K -> Tor has contractible fibres

  KFib (Y : Tor) : U l+ = (k : K) * Id Tor (iota k) Y ;

  -- a point y0 of Y gives  Atriv -> Y,  a |-> a . y0
  pthom (Y : Tor) (y0 : Y.1) : Hom Atriv Y = (\ a -> Y.2.1 a y0, \ b a -> Y.2.2.2.1 b a y0) ;

  iota-fib (Y : Tor) : E1.isContr (KFib Y) =
    Tr.Trunc[Y.1].induction @(l+) (\ v -> E1.isContr (KFib Y)) (\ v -> Torsor[l+].isProp-isContr (KFib Y))
      (\ y0 -> ((k0, P1.trans Tor (iota k0) Atriv Y (img.triangle tt) (decode Atriv Y (pthom Y y0))),
                \ z -> G1.emb-fib-prop K Tor iota emb Y
                         (k0, P1.trans Tor (iota k0) Atriv Y (img.triangle tt) (decode Atriv Y (pthom Y y0))) z))
      Y.2.2.2.2.2.2 ;
} ;
