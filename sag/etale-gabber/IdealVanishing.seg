-- A finite ideal certificate vanishes under any map killing its generators.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A B : CRing) (setB : Pr.isSet B.R) (h : RingHom[l].Hom A B)
 (n : Nat) (fs : Fin n -> A.R) (kills : (i : Fin n) -> Id B.R (h.1 (fs i)) B.z) {
 module I = GeneratedIdeal[l].Over[A,n,fs] ;
 module SA = FiniteIdeal[l].Sums[A] ; module SB = FiniteIdeal[l].Sums[B] ;
 combination (cs : Fin n -> A.R) : Id B.R (h.1 (SA.lin n fs cs)) B.z =
  trans (StandardOpens[l].SumMap[A,B,h].combination n fs cs)
   (trans (SB.sum-cong n (\ i -> B.mul (h.1 (fs i)) (h.1 (cs i))) (\ i -> B.z)
    (\ i -> trans (ap (\ b -> B.mul b (h.1 (cs i))) (kills i)) (RL[B].zero-mul (h.1 (cs i)))))
    (SB.sum-zero n)) ;
 certificate (a : A.R) (w : I.Witness a) : Id B.R (h.1 a) B.z =
  trans (ap h.1 w.2)
   (trans (h.2.2.1 A.z (SA.lin n fs w.1))
    (trans (cong2 B.R B.add _ _ _ _ (RingHom[l].zero A B h) (combination w.1)) (B.addZ B.z))) ;
 vanish (a : A.R) : I.Member a -> Id B.R (h.1 a) B.z =
  Tr.Trunc[I.Witness a].induction @l (\ t -> Id B.R (h.1 a) B.z) (\ t -> setB _ _) (certificate a) ;
} ;
