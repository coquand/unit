-- Line families of a given weight, and the band change n_* G of an etale
-- gerbe (../HANDOFF-TORSION-C.md, C1; generalised for C3).  C = (X, conn, w)
-- a charged type (TWISTEDMODULES.Charged: X merely connected, w a function of
-- loops to R^x), close-inhabited.  The objects are the line families of weight w:
--     Obj = (L : X -> Module) * WeightBy w L * ((g : X) -> ||Basis(L g, 1)||).
-- For a TGerbe Gb and w = beta^n this is n_* G (Power).
-- Its band is R^x:
--  (paths)   Id Obj L L' = Iso L L', the families of linear bijections
--            L g -> L' g (Fundamental, SIPGENERIC): (L' : Obj) * Iso L L' is
--            contractible, a retract of Pi_g of the contractible total spaces of
--            modules (MODULESIP2), with the propositions Weight and Bases added
--            (ctr-sub).  So Id Obj L L' is a set.
--  (scalar)  On a line M with a mere basis (e, c) every endomorphism f is a
--            scalar: f m = a m for a unique a (a = c(f e), SCALARLINE.Inverse;
--            a e = a' e gives a = a').
--  (global)  For i : Iso L L the scalars mu_g of i at g are equal along paths
--            of X (ap), and X is connected, so for the proposition
--                Glob i = (a : R) * ((g : X) -> a = mu_g),
--            which is a sheaf (R is, ETALERING.R-local), a point of X gives a
--            point; X is close-inhabited, so Glob i holds: the scalar of i.
--  (band)    b p = scalar of idToIso p.  Composition of paths is composition
--            of the transports (J), so b (p q) = b p b q; b p is a unit with
--            inverse b p^-1, since b refl = 1.  b is an equivalence: the inverse
--            sends a to the path of the scaling family (m |-> a m); b of it is a
--            (idToIso-sip), and a path p is the path of the scaling family by b p,
--            since idToIso p is that family (the scalar at every g).
-- Obj is large (U l+), so the band is stated in GERBE.Band's shape for it.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module SG1 = SipGeneric[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module S0 = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module UG = TM.UG ;
 module HM = HomModule[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module SL = ScalarLine[l].Over[R,setR,axioms] ;
 -- linear bijections, as linear maps that are equivalences
 Bij (A B : MD.Module) : U l = (f : HM.At[A,B].S.E) * Pr.isEquiv A.M B.M f.1 ;
 bij-eq (A B : MD.Module) (i j : Bij A B) (h : (m : A.M) -> Id B.M (i.1.1 m) (j.1.1 m)) : Id (Bij A B) i j =
  Pr.Sigma-eq HM.At[A,B].S.E (\ f -> Pr.isEquiv A.M B.M f.1) i.1 j.1 i.2 j.2 (HM.At[A,B].ext i.1 j.1 h)
   (Prop331Paths[l].isEquiv-prop A.M B.M j.1.1) ;
 bij-set (A B : MD.Module) : Pr.isSet (Bij A B) =
  Torsor[l].isSet-sub HM.At[A,B].S.E (\ f -> Pr.isEquiv A.M B.M f.1) HM.At[A,B].carrier.setM
   (\ f -> Prop331Paths[l].isEquiv-prop A.M B.M f.1) ;
 identity (A : MD.Module) : Bij A A =
  ((\ x -> x,\ x y -> refl (A.madd x y),\ t x -> refl (A.sm t x)),(Pr.idEquiv A.M).2) ;
 -- (M : Module) * Bij A M is contractible: a retract of MODULESIP2's total space
 to-lin (A : MD.Module) (c : (M : MD.Module) * Bij A M) : SIP.Total A = (c.1,((c.2.1.1,c.2.2),(c.2.1.2.1,c.2.1.2.2))) ;
 from-lin (A : MD.Module) (c : SIP.Total A) : (M : MD.Module) * Bij A M = (c.1,((c.2.1.1,c.2.2.1,c.2.2.2),c.2.1.2)) ;
 bij-contr (A : MD.Module) : FunExtUA[l+].isContr ((M : MD.Module) * Bij A M) =
  SG1.ctr-retract (SIP.Total A) ((M : MD.Module) * Bij A M) (SIP.total-contr A) (to-lin A) (from-lin A) (\ c -> refl c) ;
 -- (scalar)
 module Line (M : MD.Module) (bl : Tr.Trunc[LF.Basis[M,suc zero]].carrier) {
  Fit (f : M.M -> M.M) : U l = (a : R.R) * ((m : M.M) -> Id M.M (f m) (M.sm a m)) ;
  unique (a a' : R.R) (h : (m : M.M) -> Id M.M (M.sm a m) (M.sm a' m)) : Id R.R a a' =
   Tr.Trunc[LF.Basis[M,suc zero]].induction @l (\ t -> Id R.R a a') (\ t -> setR a a')
    (\ b -> trans (sym (SL.At[M].Inverse[b].recover a))
     (trans (ap (SL.At[M].Inverse[b].c.1) (h SL.At[M].Inverse[b].e)) (SL.At[M].Inverse[b].recover a'))) bl ;
  fit-prop (f : M.M -> M.M) : Pr.isProp (Fit f) = \ u v ->
   Pr.Sigma-eq R.R (\ a -> (m : M.M) -> Id M.M (f m) (M.sm a m)) u.1 v.1 u.2 v.2
    (unique u.1 v.1 (\ m -> trans (sym (u.2 m)) (v.2 m)))
    (F.isProp-Pi M.M (\ m -> Id M.M (f m) (M.sm v.1 m)) (\ m -> M.setM _ _)) ;
  fit (f : HM.At[M,M].S.E) : Fit f.1 =
   Tr.Trunc[LF.Basis[M,suc zero]].induction @l (\ t -> Fit f.1) (\ t -> fit-prop f.1)
    (\ b -> (SL.At[M].Inverse[b].c.1 (f.1 SL.At[M].Inverse[b].e),
     \ m -> sym (ap (\ h -> h.1 m) (SL.At[M].Inverse[b].scal-back f)))) bl ;
 } ;
 -- a charged type, close-inhabited
 Char : U l+ = (C : TM.Charged) * sh.close C.1 ;
 module At (C : Char) {
  X : U l = C.1.1 ;
  module T = TM.At[C.1] ;
  -- the objects
  Props (V : X -> MD.Module) : U l = T.WeightBy T.bnd V * ((g : X) -> Tr.Trunc[LF.Basis[V g,suc zero]].carrier) ;
  props-prop (V : X -> MD.Module) : Pr.isProp (Props V) =
   Pr.isProp-Sigma (T.WeightBy T.bnd V) (\ w -> (g : X) -> Tr.Trunc[LF.Basis[V g,suc zero]].carrier)
    (F.isProp-Pi X (\ y -> (p : Id X y y) (m : (V y).M) -> Id (V y).M (T.Move[V].move y y p m) ((V y).sm (T.bnd y p).1 m)) (\ y ->
      F.isProp-Pi (Id X y y) (\ p -> (m : (V y).M) -> Id (V y).M (T.Move[V].move y y p m) ((V y).sm (T.bnd y p).1 m)) (\ p ->
       F.isProp-Pi (V y).M (\ m -> Id (V y).M (T.Move[V].move y y p m) ((V y).sm (T.bnd y p).1 m)) (\ m -> (V y).setM _ _))))
    (\ w -> F.isProp-Pi X (\ g -> Tr.Trunc[LF.Basis[V g,suc zero]].carrier) (\ g -> Tr.Trunc[LF.Basis[V g,suc zero]].proposition)) ;
  Obj : U l+ = (V : X -> MD.Module) * Props V ;
  fibre (L : Obj) (g : X) : MD.Module = L.1 g ;
  basis (L : Obj) (g : X) : Tr.Trunc[LF.Basis[L.1 g,suc zero]].carrier = L.2.2 g ;
  -- (paths)
  Iso (L L' : Obj) : U l = (g : X) -> Bij (L.1 g) (L'.1 g) ;
  idIso (L : Obj) : Iso L L = \ g -> identity (L.1 g) ;
  Families (L : Obj) : U l+ = (V : X -> MD.Module) * ((g : X) -> Bij (L.1 g) (V g)) ;
  families-contr (L : Obj) : FunExtUA[l+].isContr (Families L) =
   SG1.ctr-retract ((g : X) -> (M : MD.Module) * Bij (L.1 g) M) (Families L)
    (FunExtUA[l+].FE[univ @(l+)].wfe X (\ g -> (M : MD.Module) * Bij (L.1 g) M) (\ g -> bij-contr (L.1 g)))
    (\ w g -> (w.1 g,w.2 g)) (\ v -> (\ g -> (v g).1,\ g -> (v g).2)) (\ w -> refl w) ;
  total-contr (L : Obj) : FunExtUA[l+].isContr ((L' : Obj) * Iso L L') =
   SG1.ctr-retract ((w : Families L) * Props w.1) ((L' : Obj) * Iso L L')
    (SG1.ctr-sub (Families L) (\ w -> Props w.1) (families-contr L) (\ w -> props-prop w.1) (L.1,idIso L) L.2)
    (\ c -> ((c.1.1,c.2),c.1.2)) (\ d -> ((d.1.1,d.2),d.1.2)) (\ c -> refl c) ;
  module Fd = SipGeneric[l].Fundamental[Obj,Iso,idIso,total-contr] ;
  -- the transport of a path, at g
  move (L L' : Obj) (p : Id Obj L L') (g : X) (m : (L.1 g).M) : (L'.1 g).M = (Fd.idToIso L L' p g).1.1 m ;
  move-trans (L L' : Obj) (p : Id Obj L L') (K : Obj) (q : Id Obj L' K) (g : X) (m : (L.1 g).M) :
   Id (K.1 g).M (move L K (Pr1.trans Obj L L' K p q) g m) (move L' K q g (move L L' p g m)) =
   idJ Obj L' (\ K' q' -> Id (K'.1 g).M (move L K' (Pr1.trans Obj L L' K' p q') g m) (move L' K' q' g (move L L' p g m)))
    (refl (move L L' p g m)) K q ;
  idToIso-equiv (L L' : Obj) : Pr1.isEquiv (Id Obj L L') (Iso L L') (Fd.idToIso L L') =
   Pr1.qinv (Id Obj L L') (Iso L L') (Fd.idToIso L L') (Fd.sip L L') (Fd.idToIso-sip L L') (Fd.sip-idToIso L L') ;
  iso-set (L L' : Obj) : Pr.isSet (Iso L L') = F.isSet-Pi X (\ g -> Bij (L.1 g) (L'.1 g)) (\ g -> bij-set (L.1 g) (L'.1 g)) ;
  gpd (L L' : Obj) : Pr1.isSet (Id Obj L L') =
   AffineHLevels[l+].set-from-equiv (Id Obj L L') (Iso L L') (iso-set L L') (Fd.idToIso L L') (idToIso-equiv L L') ;
  -- (global)
  module Loops (L : Obj) {
   mu (i : Iso L L) (g : X) : R.R = (Line[L.1 g,basis L g].fit (i g).1).1 ;
   mu-law (i : Iso L L) (g : X) (m : (L.1 g).M) : Id (L.1 g).M ((i g).1.1 m) ((L.1 g).sm (mu i g) m) = (Line[L.1 g,basis L g].fit (i g).1).2 m ;
   -- an equation in R holds if it holds at the points of X
   by-point (a b : R.R) (h : X -> Id R.R a b) : Id R.R a b =
    sh.elim @l X (Id R.R a b) (setR a b) (S0.modal-Id R.R ER.R-local a b) h C.2 ;
   constant (i : Iso L L) (g g' : X) : Id R.R (mu i g) (mu i g') =
    Tr.Trunc[Id X g g'].induction @l (\ t -> Id R.R (mu i g) (mu i g')) (\ t -> setR _ _)
     (\ q -> ap (mu i) q) (T.conn g g') ;
   Glob (i : Iso L L) : U l = (a : R.R) * ((g : X) -> Id R.R a (mu i g)) ;
   glob-prop (i : Iso L L) : Pr.isProp (Glob i) = \ u v ->
    Pr.Sigma-eq R.R (\ a -> (g : X) -> Id R.R a (mu i g)) u.1 v.1 u.2 v.2
     (by-point u.1 v.1 (\ g -> trans (u.2 g) (sym (v.2 g))))
     (F.isProp-Pi X (\ g -> Id R.R v.1 (mu i g)) (\ g -> setR _ _)) ;
   glob-modal (i : Iso L L) : ET.T.isModal @l (Glob i) =
    S0.modal-Sigma R.R (\ a -> (g : X) -> Id R.R a (mu i g)) ER.R-local (\ a ->
     S0.modal-Pi X (\ g -> Id R.R a (mu i g)) (\ g -> S0.modal-Id R.R ER.R-local a (mu i g))) ;
   glob (i : Iso L L) : Glob i =
    sh.elim @l X (Glob i) (glob-prop i) (glob-modal i) (\ g -> (mu i g,\ g' -> constant i g g')) C.2 ;
   scalar (i : Iso L L) : R.R = (glob i).1 ;
   scalar-at (i : Iso L L) (g : X) : Id R.R (scalar i) (mu i g) = (glob i).2 g ;
   -- the scalar is determined by any law m |-> a m at every point
   scalar-of (i : Iso L L) (a : R.R) (h : (g : X) (m : (L.1 g).M) -> Id (L.1 g).M ((i g).1.1 m) ((L.1 g).sm a m)) :
    Id R.R (scalar i) a =
    by-point (scalar i) a (\ g -> trans (scalar-at i g) (Line[L.1 g,basis L g].unique (mu i g) a (\ m -> trans (sym (mu-law i g m)) (h g m)))) ;
   -- (band)
   b0 (p : Id Obj L L) : R.R = scalar (Fd.idToIso L L p) ;
   law (p : Id Obj L L) (g : X) (m : (L.1 g).M) : Id (L.1 g).M (move L L p g m) ((L.1 g).sm (b0 p) m) =
    trans (mu-law (Fd.idToIso L L p) g m) (ap (\ t -> (L.1 g).sm t m) (sym (scalar-at (Fd.idToIso L L p) g))) ;
   b0-trans (p q : Id Obj L L) : Id R.R (b0 (Pr1.trans Obj L L L p q)) (R.mul (b0 p) (b0 q)) =
    scalar-of (Fd.idToIso L L (Pr1.trans Obj L L L p q)) (R.mul (b0 p) (b0 q)) (\ g m ->
     calc (L.1 g).M { move L L (Pr1.trans Obj L L L p q) g m
      =< move-trans L L p L q g m > move L L q g (move L L p g m)
      =< law q g (move L L p g m) > (L.1 g).sm (b0 q) (move L L p g m)
      =< ap ((L.1 g).sm (b0 q)) (law p g m) > (L.1 g).sm (b0 q) ((L.1 g).sm (b0 p) m)
      =< (L.1 g).smA (b0 q) (b0 p) m > (L.1 g).sm (R.mul (b0 q) (b0 p)) m
      =< ap (\ t -> (L.1 g).sm t m) (R.mulC (b0 q) (b0 p)) > (L.1 g).sm (R.mul (b0 p) (b0 q)) m }) ;
   b0-refl : Id R.R (b0 (refl L)) R.o = scalar-of (idIso L) R.o (\ g m -> sym ((L.1 g).smO m)) ;
   inverse (p : Id Obj L L) : Id R.R (R.mul (b0 p) (b0 (Pr1.sym Obj L L p))) R.o =
    trans (R.mulC (b0 p) (b0 (Pr1.sym Obj L L p)))
     (trans (sym (b0-trans (Pr1.sym Obj L L p) p))
      (trans (Pr1.ap (Id Obj L L) R.R b0 _ _ (Pr1.trans-sym-l Obj L L p)) b0-refl)) ;
   #fails {
    -- the scalar is glued from the points (close X), not the value at one of them
    pointwise (i : Iso L L) (g : X) : Id R.R (scalar i) (mu i g) = refl (mu i g) ;
   } ;
   #fails {
    -- a path acts by its own scalar, not by that of its inverse
    wrong-way (p : Id Obj L L) (g : X) (m : (L.1 g).M) :
     Id (L.1 g).M (move L L p g m) ((L.1 g).sm (b0 (Pr1.sym Obj L L p)) m) = law p g m ;
   } ;
   b (p : Id Obj L L) : UG.Unit = (b0 p,b0 (Pr1.sym Obj L L p),inverse p) ;
   hom (p q : Id Obj L L) : Id UG.Unit (b (Pr1.trans Obj L L L p q)) (UG.times (b p) (b q)) =
    UG.eq (b (Pr1.trans Obj L L L p q)) (UG.times (b p) (b q)) (b0-trans p q) ;
   -- the scaling family
   scaling (a : UG.Unit) : Iso L L = \ g ->
    (SL.At[L.1 g].scale a.1,
     Pr.qinv (L.1 g).M (L.1 g).M (\ x -> (L.1 g).sm a.1 x) (\ x -> (L.1 g).sm a.2.1 x)
      (\ x -> trans ((L.1 g).smA a.1 a.2.1 x) (trans (ap (\ c -> (L.1 g).sm c x) a.2.2) ((L.1 g).smO x)))
      (\ x -> trans ((L.1 g).smA a.2.1 a.1 x) (trans (ap (\ c -> (L.1 g).sm c x) (trans (R.mulC a.2.1 a.1) a.2.2)) ((L.1 g).smO x)))) ;
   loop (a : UG.Unit) : Id Obj L L = Fd.sip L L (scaling a) ;
   b-loop (a : UG.Unit) : Id UG.Unit (b (loop a)) a =
    UG.eq (b (loop a)) a (trans (ap scalar (Fd.idToIso-sip L L (scaling a))) (scalar-of (scaling a) a.1 (\ g m -> refl ((L.1 g).sm a.1 m)))) ;
   iso-scaling (p : Id Obj L L) : Id (Iso L L) (scaling (b p)) (Fd.idToIso L L p) =
    F.funext X (\ g -> Bij (L.1 g) (L.1 g)) (scaling (b p)) (Fd.idToIso L L p) (\ g ->
     bij-eq (L.1 g) (L.1 g) (scaling (b p) g) (Fd.idToIso L L p g) (\ m -> sym (law p g m))) ;
   loop-b (p : Id Obj L L) : Id (Id Obj L L) (loop (b p)) p =
    Pr1.trans (Id Obj L L) _ _ _ (Pr1.ap (Iso L L) (Id Obj L L) (Fd.sip L L) _ _ (iso-scaling p)) (Fd.sip-idToIso L L p) ;
   b-equiv : Pr1.isEquiv (Id Obj L L) UG.Unit b = Pr1.qinv (Id Obj L L) UG.Unit b loop b-loop loop-b ;
   band : (a : UG.Unit) -> FunExtUA[l+].isContr ((lp : Id Obj L L) * Id UG.Unit (b lp) a) =
    AffineHLevels[l+].Fibres[Id Obj L L,UG.Unit,UG.setU,b].from-equiv b-equiv ;
  } ;
  -- the band at L, in GERBE.Band's shape
  Band (L : Obj) : U l+ = (bd : Id Obj L L -> UG.Unit) * ((a : UG.Unit) -> FunExtUA[l+].isContr ((lp : Id Obj L L) * Id UG.Unit (bd lp) a))
   * ((p q : Id Obj L L) -> Id UG.Unit (bd (Pr1.trans Obj L L L p q)) (UG.times (bd p) (bd q))) ;
  band (L : Obj) : Band L = (Loops[L].b,Loops[L].band,Loops[L].hom) ;
 } ;
 -- n_* G: the weight beta^n
 module Power (Gb : TG.TGerbe) (n : Nat) {
  chi (a : UG.Unit) : UG.Unit = UG.power a n ;
  char : Char = ((Gb.carrier,TG.At[Gb].connected,\ y p -> chi ((Gb.band y).1 p)),Gb.inh) ;
 } ;
} ;
