-- SAG 7.1.8: fibrewise weak quasi-coherence gives restriction/localization.
-- Both clauses are exactly the existing torsor interface, not extra hypotheses.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module NF = NatFin[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module MF = ModuleFractions[l].Over[R,setR] ;
 module S = Schemes[l].Over[R,setR] ;
 module UB = SchemeUniform[l].Over[R,setR,axioms] ;
 module At (X : U l) (scheme : S.Scheme X) (Mx : X -> MD.Module)
  (w : MD.WqcBundle X Mx) {
  module Af = Affine[l].Aff[MD.ring,X,Mx] ;
  module ForFunction (g : X -> R.R) {
   module Point (x : X) { module A = MF.At[Mx x,g x] ; } ;
   module Fractions = FractionSections[l].Over[R,setR,axioms].At[X,scheme,
    \ x -> (Mx x).M,\ x -> (Mx x).setM,\ x -> (Mx x).sm (g x),
    \ x -> Point[x].A.Target,\ x -> Point[x].A.target-set,\ x -> Point[x].A.fraction]
    .Laws[\ x -> Point[x].A.raise,\ x -> Point[x].A.QC[w x].detect] ;
   represent (s : (x : X) -> Af.Dg g x -> (Mx x).M) : Tr.Trunc[Af.Rep g s].carrier =
    Tr.Trunc[Fractions.Section[s].Goal].induction @l
     (\ z -> Tr.Trunc[Af.Rep g s].carrier) (\ z -> Tr.Trunc[Af.Rep g s].proposition)
     (\ a -> Tr.Trunc[Af.Rep g s].inc (a.2.1,NF.toN a.1,\ x d -> sym (ap (\ h -> h d) (a.2.2 x))))
     (Fractions.Section[s].theorem (\ x -> Point[x].A.QC[w x].represented (s x))) ;
   module Killed (m : (x : X) -> (Mx x).M)
    (vanish : (x : X) -> Af.Dg g x -> Id (Mx x).M (m x) (Mx x).mz) {
    module Uniform = UB.At[X,scheme,
     \ x k -> MD.Fractions[Mx x].Kills (g x) (m x) k,
     \ x -> MD.Fractions[Mx x].kills-prop (g x) (m x),
     \ x -> MD.Fractions[Mx x].kills-up (g x) (m x)] ;
    theorem : Tr.Trunc[Af.Kill g m].carrier =
     Tr.Trunc[Uniform.Goal].induction @l
      (\ z -> Tr.Trunc[Af.Kill g m].carrier) (\ z -> Tr.Trunc[Af.Kill g m].proposition)
      (\ a -> Tr.Trunc[Af.Kill g m].inc (NF.toN a.1,a.2))
      (Uniform.theorem (\ x -> MF.Single[Mx x,w x].kill (g x) (m x) (vanish x))) ;
   } ;
  } ;
  theorem-7-1-8 : MD.Restriction X Mx =
   \ g -> (ForFunction[g].represent,\ m v -> ForFunction[g].Killed[m,v].theorem) ;
 } ;
 -- The full open-subtype form: U need not be affine.
 module Open (X : U l) (scheme : S.Scheme X) (Mx : X -> MD.Module)
  (w : MD.WqcBundle X Mx) (sub : X -> U l)
  (op : OpenProp[l].Over[R,setR].OpenSubtype X sub) {
  Y : U l = (x : X) * sub x ;
  scheme-Y : S.Scheme Y = SchemeSubtypes[l].Over[R,setR,axioms].open-subtype X scheme sub op ;
  theorem : MD.Restriction Y (\ y -> Mx y.1) =
   At[Y,scheme-Y,\ y -> Mx y.1,\ y -> w y.1].theorem-7-1-8 ;
 } ;
} ;
