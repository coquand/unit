-- The splitting groupoid is essentially small (S1 of the handoff "remove the
-- parameter sh").  E an algebra, N = n+1, Obj = SPLITOBJECTS.Obj : U l+.
--  (cover)   D = Splits(R^N) = AlgIso E End(R^N) : U l, and
--                f : D -> Obj,  s |-> (R^N, |standard basis|, s).
--  (small)   Obj is locally small: (o = o') ~ Arrow o o' : U l (SPLITSIP).
--            Replacement: the image Small of f is in U l is in U l, with an embedding
--            j : Small -> Obj and j (quotient s) = f s.
--  (onto)    Every o = (M, t, sg) is merely f s: a basis of M gives
--            q : M = R^N (DESCENTLINEAR.frame-equality); transporting sg
--            along q gives s, and (R^N, |std|, q_* sg) = (M, t, sg) by J on q.
--            So the fibres of j are inhabited propositions: j is an
--            equivalence, Small ~ Obj.
--  (band)    beta_a(p) = SPLITBAND.bnd (j a) (ap j p) is a band of Small at
--            level l: ap j is an equivalence and preserves composition.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module EN = ModuleEnd[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module BF = BasisFrames[l].Over[R,setR,axioms] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module RP = Replacement[l,l+] ;
 -- the standard basis of R^N, and End(R^N) = M_N
 module Standard (N : Nat) {
  V : MD.Module = DL.Free N ;
  basis : LF.Basis[V,N] = BF.At[V,N].OfFrame[DescentFrames[l].Over[R,setR,axioms.loc].Rank[N].standard].basis ;
  module BE = BasisEnd[l].Over[R,setR].At[V,N,basis.frame,basis.dual] ;
 } ;
 module At (n : Nat) (E : EN.NA.Algebra) {
  N : Nat = suc n ;
  module SO = SplitObjects[l].Over[R,setR,axioms].At[N,E] ;
  module SS = SplitSIP[l].Over[R,setR,axioms].At[N,E] ;
  module SB = SplitBand[l].Over[R,setR,axioms].At[n,E] ;
  module ST = Standard[N] ;
  -- (cover)
  D : U l = SO.Splits ST.V ;
  f (s : D) : SO.Obj = (ST.V,Tr.Trunc[LF.Basis[ST.V,N]].inc ST.basis,s) ;
  -- (small)
  path-equiv (o o' : SO.Obj) : Hi.isEquiv (SO.Arrow o o') (Id SO.Obj o o') (SS.to-path o o') =
   Hi.qinv (SO.Arrow o o') (Id SO.Obj o o') (SS.to-path o o') (SS.to-arrow o o') (SS.Fd.sip-idToIso o o') (SS.Fd.idToIso-sip o o') ;
  locally-small : RP.LocallySmall SO.Obj = \ o o' -> (SO.Arrow o o',SS.to-path o o',path-equiv o o') ;
  image : RP.Image[D,SO.Obj,f] = images @l @(l+) D SO.Obj locally-small f ;
  Small : U l = image.carrier ;
  j (a : Small) : SO.Obj = image.inclusion a ;
  emb (a b : Small) : Hi.isEquiv (Id Small a b) (Id SO.Obj (j a) (j b)) (Hi.ap Small SO.Obj j a b) = image.embedding a b ;
  -- (onto)
  moved (M : MD.Module) (t : Tr.Trunc[LF.Basis[M,N]].carrier) (sg : SO.Splits M) (V2 : MD.Module) (q : Id MD.Module M V2)
   (t2 : Tr.Trunc[LF.Basis[V2,N]].carrier) : Id SO.Obj (V2,t2,Hi.subst MD.Module (\ M4 -> SO.Splits M4) M V2 q sg) (M,t,sg) =
   idJ MD.Module M (\ V3 q3 -> (t3 : Tr.Trunc[LF.Basis[V3,N]].carrier) -> Id SO.Obj (V3,t3,Hi.subst MD.Module (\ M4 -> SO.Splits M4) M V3 q3 sg) (M,t,sg))
    (\ t3 -> Hi.ap (Tr.Trunc[LF.Basis[M,N]].carrier) SO.Obj (\ u -> (M,u,sg)) t3 t (Tr.Trunc[LF.Basis[M,N]].proposition t3 t)) V2 q t2 ;
  Fib (o : SO.Obj) : U l+ = (a : Small) * Id SO.Obj (j a) o ;
  fib-prop (o : SO.Obj) : Hi.isProp (Fib o) = Groupoid[l+].emb-fib-prop Small SO.Obj j emb o ;
  module Based (o : SO.Obj) (b : LF.Basis[SO.carrier o,N]) {
   q : Id MD.Module (SO.carrier o) ST.V = DL.On[SO.carrier o].frame-equality N BF.At[SO.carrier o,N].Of[b].frame ;
   s : D = Hi.subst MD.Module (\ M4 -> SO.Splits M4) (SO.carrier o) ST.V q o.2.2 ;
   fib : Fib o =
    (image.quotient s,Hi.trans SO.Obj (j (image.quotient s)) (f s) o (image.triangle s)
      (moved (SO.carrier o) o.2.1 o.2.2 ST.V q (Tr.Trunc[LF.Basis[ST.V,N]].inc ST.basis))) ;
  } ;
  fib (o : SO.Obj) : Fib o =
   Tr.Trunc[LF.Basis[SO.carrier o,N]].induction @(l+) (\ t -> Fib o) (\ t -> fib-prop o) (\ b -> Based[o,b].fib) o.2.1 ;
  inv (o : SO.Obj) : Small = (fib o).1 ;
  inv-j (a : Small) : Id Small (inv (j a)) a =
   Hi.ap (Fib (j a)) Small (\ w -> w.1) (fib (j a)) (a,refl (j a)) (fib-prop (j a) (fib (j a)) (a,refl (j a))) ;
  j-equiv : Hi.isEquiv Small SO.Obj j = Hi.qinv Small SO.Obj j inv (\ o -> (fib o).2) inv-j ;
  -- (band)
  ap-trans (a : Small) (p : Id Small a a) : (c : Small) (r : Id Small a c) ->
   Id (Id SO.Obj (j a) (j c)) (Hi.ap Small SO.Obj j a c (Pr.trans Small a a c p r))
    (Hi.trans SO.Obj (j a) (j a) (j c) (Hi.ap Small SO.Obj j a a p) (Hi.ap Small SO.Obj j a c r)) = \ c r ->
   idJ Small a (\ c2 r2 -> Id (Id SO.Obj (j a) (j c2)) (Hi.ap Small SO.Obj j a c2 (Pr.trans Small a a c2 p r2))
    (Hi.trans SO.Obj (j a) (j a) (j c2) (Hi.ap Small SO.Obj j a a p) (Hi.ap Small SO.Obj j a c2 r2)))
    (refl (Hi.ap Small SO.Obj j a a p)) c r ;
  bnd (a : Small) (p : Id Small a a) : TM.UG.Unit = SB.bnd (j a) (Hi.ap Small SO.Obj j a a p) ;
  bnd-equiv (a : Small) : Hi.isEquiv (Id Small a a) TM.UG.Unit (bnd a) =
   (Equivalences[l+].compose (Id Small a a) (Id SO.Obj (j a) (j a)) TM.UG.Unit (Hi.ap Small SO.Obj j a a,emb a a)
     (SB.bnd (j a),SB.bnd-equiv (j a))).2 ;
  bnd-hom (a : Small) (p r : Id Small a a) :
   Id TM.UG.Unit (bnd a (Pr.trans Small a a a p r)) (TM.UG.times (bnd a p) (bnd a r)) =
   Hi.trans TM.UG.Unit _ (SB.bnd (j a) (Hi.trans SO.Obj (j a) (j a) (j a) (Hi.ap Small SO.Obj j a a p) (Hi.ap Small SO.Obj j a a r))) _
    (Hi.ap (Id SO.Obj (j a) (j a)) TM.UG.Unit (SB.bnd (j a)) _ _ (ap-trans a p a r))
    (SB.bnd-hom (j a) (Hi.ap Small SO.Obj j a a p) (Hi.ap Small SO.Obj j a a r)) ;
  band (a : Small) : TM.GB.Band Small a =
   (bnd a,AffineHLevels[l].Fibres[Id Small a a,TM.UG.Unit,TM.UG.setU,bnd a].from-equiv
     (new Pr.IsEquiv[Id Small a a,TM.UG.Unit,bnd a,sec := (bnd-equiv a).sec,sec-eq := (bnd-equiv a).sec-eq,
       ret := (bnd-equiv a).ret,ret-eq := (bnd-equiv a).ret-eq]),bnd-hom a) ;
 } ;
} ;
