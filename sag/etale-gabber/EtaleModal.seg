-- Pure type theory for a topology generated by propositions.
level l j ;
module Pr = Prelude[l \/ j] ;
module FL = Axioms[l \/ j].FunExtLemmas[fe @(l \/ j)] ;
module EQ = Equivalences[l \/ j] ;
module Over (I : U l) (G : I -> U l) {
 module T = SheafTopology[l].Over[I,G] ;
 module S = SheafLemmas[l,j].Over[I,G] ;
 prop-local (Q : U j) (pQ : Pr.isProp Q) :
  (T.isModal @j Q -> (i : I) -> (G i -> Q) -> Q) *
  (((i : I) -> (G i -> Q) -> Q) -> T.isModal @j Q) =
  (\ m i -> (m i).sec, S.modal-of-sec Q pQ) ;
 modal-along (X Y : U j) (e : Pr.Equiv X Y) (mX : T.isModal @j X) :
  T.isModal @j Y =
  S.modal-retract X Y e.2.sec e.1 e.2.sec-eq mX ;
 module Separated (X : U j) (setX : Pr.isSet X)
  (sep : (x y : X) -> T.isModal @j (Id X x y)) {
  module At (i : I) (h : G i -> X) {
   Constant : U (l \/ j) = (x : X) * ((g : G i) -> Id X x (h g)) ;
   constant-prop : Pr.isProp Constant = \ u v ->
    Pr.Sigma-eq X (\ x -> (g : G i) -> Id X x (h g)) u.1 v.1 u.2 v.2
     ((sep u.1 v.1 i).sec (\ g ->
       Pr.trans X u.1 (h g) v.1 (u.2 g) (Pr.sym X v.1 (h g) (v.2 g))))
     (FL.isProp-Pi (G i) (\ g -> Id X v.1 (h g)) (\ g -> setX v.1 (h g))) ;
   choose : Truncation[l \/ j].Trunc[Constant].carrier -> Constant =
    Truncation[l \/ j].Trunc[Constant].induction @(l \/ j)
     (\ t -> Constant) (\ t -> constant-prop) (\ c -> c) ;
  } ;
  separated-factor
   (factor : (i : I) (h : G i -> X) -> Truncation[l \/ j].Trunc[At[i,h].Constant].carrier)
   : T.isModal @j X = \ i ->
   Pr.qinv X (G i -> X) (\ x g -> x)
    (\ h -> (At[i,h].choose (factor i h)).1)
    (\ h -> FL.funext (G i) (\ g -> X) _ h (At[i,h].choose (factor i h)).2)
    (\ x -> Pr.ap (At[i,\ g -> x].Constant) X (\ c -> c.1) _ _
      (At[i,\ g -> x].constant-prop
       (At[i,\ g -> x].choose (factor i (\ g -> x))) (x,\ g -> refl x))) ;
 } ;
 -- Descent of the equivalence data for a set does not require record eta.
 module Mere (X : U j) (setX : Pr.isSet X)
  (w : Truncation[l \/ j].Trunc[T.isModal @j X].carrier) {
  equality (i : I) (x y : X) (p : G i -> Id X x y) : Id X x y =
   Truncation[l \/ j].Trunc[T.isModal @j X].induction @(l \/ j)
    (\ t -> Id X x y) (\ t -> setX x y)
    (\ m -> EQ.injective X (G i -> X) (\ z g -> z) (m i) x y
      (FL.funext (G i) (\ g -> X) _ _ p)) w ;
  separated (x y : X) : T.isModal @j (Id X x y) =
   S.modal-of-sec (Id X x y) (setX x y) (\ i -> equality i x y) ;
  module Sep = Separated[X,setX,separated] ;
  factor (i : I) (h : G i -> X) : Truncation[l \/ j].Trunc[Sep.At[i,h].Constant].carrier =
   Truncation[l \/ j].Trunc[T.isModal @j X].induction @(l \/ j)
    (\ t -> Truncation[l \/ j].Trunc[Sep.At[i,h].Constant].carrier)
    (\ t -> Truncation[l \/ j].Trunc[Sep.At[i,h].Constant].proposition)
    (\ m -> Truncation[l \/ j].Trunc[Sep.At[i,h].Constant].inc
      ((m i).sec h,\ g -> Pr.happly (G i) (\ g -> X) _ h ((m i).sec-eq h) g)) w ;
  modal : T.isModal @j X = Sep.separated-factor factor ;
 } ;
} ;
