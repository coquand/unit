-- mu_ijk on the triple overlaps of a gerbe datum (../HANDOFF-GABBER-HOMOTOPY.md).
-- Let d be a gerbe datum (GERBEDATUM): a cover u_1, .., u_n with points s_i
-- over D(u_i), localisations L_ij = Alg[1/u_i u_j] with frame data w_ij of
-- the lines of the path torsors, projectors H_ij (LINEMODULES), and
-- localisations L_ijk = Alg[1/(u_i u_j) u_k].  Then over L_ijk
--     Image (H_ij|L_ijk (x) H_jk|L_ijk) ~ Image H_ik|L_ijk,
-- where H|L_ijk is the base change along L_ab -> L_ijk (PROJECTORMAP).
-- Proof.  u_a u_b divides (u_i u_j) u_k for ab = ij, jk, ik, which gives
-- L_ab -> L_ijk over Alg (LOCALIZATIONRINGS.Shrink).  A point y of
-- Spec L_ijk is a point q(y) of Spec Alg where u_i, u_j, u_k are units,
-- so the points s_a(q y) of G(q y) are three point families over
-- Spec L_ijk (GERBEMU).  The frame data w_ab restrict along L_ab -> L_ijk
-- (LINERESTRICT), with projector the base change of H_ab, to frame data of
-- the paths between s_a and s_b at the point of Spec Alg below y in L_ab;
-- that point is q(y), since L_ab -> L_ijk is over Alg, so the two torsor
-- families agree pointwise and the data move to the path torsors of the
-- three point families (DATATRANSPORT), with isomorphic images.  GERBEMU
-- then gives the isomorphism, and the base changes are replaced by the
-- moved data on each side (K0: left-iso, right-iso).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module GB = Gerbe[l].Gerbes[UG.group] ;
 module GLO = GerbeLines[l].Over[R,setR,axioms] ;
 module LR = LocalizationRings[l].Over[R,setR] ;
 module RR = RL[R] ;
 module RU = AffineRing[l].Laws[R,setR] ;
 Tor : U l+ = TorsorId[l].TorId[UG.group].Tor ;
 -- x(a b) = x(a) x(b) at a point x of Spec Alg
 apart (Alg : C.Algebra) (x : C.Spec Alg) (a b : Alg.ring.R) (h : RR.unit (x.1.1 (Alg.ring.mul a b))) :
  RR.unit (R.mul (x.1.1 a) (x.1.1 b)) =
  (h.1,trans (ap (\ t -> R.mul t h.1) (sym (x.1.2.2.2 a b))) h.2) ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> GB.AGerbe)
  (d : GerbeDatum[l].Over[R,setR,axioms].At[Alg,fp,G].Datum) {
  module CV = GerbeDatum[l].Over[R,setR,axioms].At[Alg,fp,G].Cover[d.cover] ;
  module Triple (i j k : Fin CV.n) {
   loc : AI.LocalizationWitness Alg (CV.uuu i j k) = d.triples i j k ;
   L : C.Algebra = loc.1 ;
   fpL : P.FP L = loc.2.1 ;
   Y : U l = C.Spec L ;
   module PJ = Projectors[l].Over[L.ring,L.set] ;
   module MI = PJ.MI ;
   module K = K0[l].Over[L.ring,L.set] ;
   module DT = DataTransport[l].Over[R,setR,axioms].At[L,fpL] ;
   -- the point of Spec Alg below y, where u_i, u_j, u_k are units
   q (y : Y) : C.Spec Alg = ((AI.spectrum Alg (CV.uuu i j k) loc).1 y).1 ;
   unit-ijk (y : Y) : RR.unit ((q y).1.1 (CV.uuu i j k)) = ((AI.spectrum Alg (CV.uuu i j k) loc).1 y).2 ;
   unit-ij (y : Y) : RR.unit ((q y).1.1 (CV.uu i j)) =
    GLO.unit-left ((q y).1.1 (CV.uu i j)) ((q y).1.1 (CV.u k)) (apart Alg (q y) (CV.uu i j) (CV.u k) (unit-ijk y)) ;
   unit-i (y : Y) : RR.unit ((q y).1.1 (CV.u i)) =
    GLO.unit-left ((q y).1.1 (CV.u i)) ((q y).1.1 (CV.u j)) (apart Alg (q y) (CV.u i) (CV.u j) (unit-ij y)) ;
   unit-j (y : Y) : RR.unit ((q y).1.1 (CV.u j)) =
    GLO.unit-right ((q y).1.1 (CV.u i)) ((q y).1.1 (CV.u j)) (apart Alg (q y) (CV.u i) (CV.u j) (unit-ij y)) ;
   unit-k (y : Y) : RR.unit ((q y).1.1 (CV.u k)) =
    GLO.unit-right ((q y).1.1 (CV.uu i j)) ((q y).1.1 (CV.u k)) (apart Alg (q y) (CV.uu i j) (CV.u k) (unit-ijk y)) ;
   -- the three point families
   gerbe (y : Y) : GB.AGerbe = G (q y) ;
   pa (y : Y) : (gerbe y).1 = CV.s i (q y,unit-i y) ;
   pb (y : Y) : (gerbe y).1 = CV.s j (q y,unit-j y) ;
   pc (y : Y) : (gerbe y).1 = CV.s k (q y,unit-k y) ;
   module MU = GerbeMu[l].Over[R,setR,axioms].At[L,fpL,gerbe,pa,pb,pc] ;
   -- u_a u_b divides (u_i u_j) u_k
   divides-ij : Id Alg.ring.R (Alg.ring.mul (CV.uu i j) (CV.u k)) (CV.uuu i j k) = refl (CV.uuu i j k) ;
   divides-jk : Id Alg.ring.R (Alg.ring.mul (CV.uu j k) (CV.u i)) (CV.uuu i j k) =
    calc Alg.ring.R { Alg.ring.mul (Alg.ring.mul (CV.u j) (CV.u k)) (CV.u i)
      =< Alg.ring.mulC (Alg.ring.mul (CV.u j) (CV.u k)) (CV.u i) > Alg.ring.mul (CV.u i) (Alg.ring.mul (CV.u j) (CV.u k))
      =< Alg.ring.mulA (CV.u i) (CV.u j) (CV.u k) > CV.uuu i j k } ;
   divides-ik : Id Alg.ring.R (Alg.ring.mul (CV.uu i k) (CV.u j)) (CV.uuu i j k) =
    calc Alg.ring.R { Alg.ring.mul (Alg.ring.mul (CV.u i) (CV.u k)) (CV.u j)
      =< sym (Alg.ring.mulA (CV.u i) (CV.u k) (CV.u j)) > Alg.ring.mul (CV.u i) (Alg.ring.mul (CV.u k) (CV.u j))
      =< ap (Alg.ring.mul (CV.u i)) (Alg.ring.mulC (CV.u k) (CV.u j)) > Alg.ring.mul (CV.u i) (Alg.ring.mul (CV.u j) (CV.u k))
      =< Alg.ring.mulA (CV.u i) (CV.u j) (CV.u k) > CV.uuu i j k } ;
   -- the line of the pair (a, b), restricted to L_ijk and moved to the
   -- path torsor of the point families sa, sb
   module Restrict (a b c : Fin CV.n) (e : Id Alg.ring.R (Alg.ring.mul (CV.uu a b) (CV.u c)) (CV.uuu i j k))
    (ha : (y : Y) -> RR.unit ((q y).1.1 (CV.u a))) (hb : (y : Y) -> RR.unit ((q y).1.1 (CV.u b))) {
    module SH = LR.Shrink[Alg,CV.uu a b,CV.u c,CV.uuu i j k,e,d.pairs a b,loc] ;
    module GA = GLO.At[Alg,fp,G,CV.u a,CV.u b,CV.s a,CV.s b] ;
    module LN = GA.Line[d.pairs a b] ;
    module RS = LineRestrict[l].Over[R,setR,axioms].At[LN.L,L,(d.pairs a b).2.1,fpL,SH.map,LN.T] ;
    module PM = ProjectorMap[l].Over[LN.L.ring,L.ring,LN.L.set,L.set,SH.map.1] ;
    -- H_ab and its base change
    projector : PM.PA.Projector =
     LineModules[l].Over[R,setR,axioms].At[LN.L,(d.pairs a b).2.1,LN.T].Of[d.frames a b].projector ;
    restricted : RS.DL.Data = RS.restrict (d.frames a b) ;
    -- the two torsor families agree pointwise
    Two : U l = (x : C.Spec Alg) * (RR.unit (x.1.1 (CV.u a)) * RR.unit (x.1.1 (CV.u b))) ;
    torsor (z : Two) : Tor = GB.GL[G z.1].PTor (CV.s a (z.1,z.2.1)) (CV.s b (z.1,z.2.2)) ;
    target (y : Y) : Tor = torsor (q y,(ha y,hb y)) ;
    below (y : Y) : AI.D Alg (CV.uu a b) = LN.point (RS.pull y) ;
    same-point (y : Y) : Id (C.Spec Alg) (below y).1 (q y) =
     C.ext Alg C.base (below y).1 (q y) (\ r -> ap y.1.1 (SH.beta r)) ;
    same (y : Y) : Id Tor (RS.T' y) (target y) =
     Hi.ap Two Tor torsor ((below y).1,((GA.left (below y)).2,(GA.right (below y)).2)) (q y,(ha y,hb y))
      (Pr.Sigma-eq (C.Spec Alg) (\ x -> RR.unit (x.1.1 (CV.u a)) * RR.unit (x.1.1 (CV.u b))) _ _ _ _ (same-point y)
       (Pr.isProp-Sigma (RR.unit ((q y).1.1 (CV.u a))) (\ h -> RR.unit ((q y).1.1 (CV.u b)))
        (RU.unit-prop ((q y).1.1 (CV.u a))) (\ h -> RU.unit-prop ((q y).1.1 (CV.u b))))) ;
    path : Id DT.Family RS.T' target = F1.funext Y (\ y -> Tor) RS.T' target same ;
    moved : DT.Data target = DT.move RS.T' target path restricted ;
    -- Image (base change of H_ab) ~ Image (projector of the moved data)
    module RE = RS.Entries[d.frames a b] ;
    module MM = PM.At[(d.frames a b).1].MM ;
    entries : Id MM.MY.Mat (MM.map projector.matrix) (LineModules[l].Over[R,setR,axioms].At[L,fpL,RS.T'].Of[restricted].E.entry) =
     MM.MY.mat-eq _ _ (\ r s -> sym (RE.entry r s)) ;
    iso : K.Iso (PM.map projector) (LineModules[l].Over[R,setR,axioms].At[L,fpL,target].Of[moved].projector) =
     MI.compose (K.image (PM.map projector)) (DT.image RS.T' restricted) (DT.image target moved)
      PJ.Equal[(d.frames a b).1,MM.map projector.matrix,
       LineModules[l].Over[R,setR,axioms].At[L,fpL,RS.T'].Of[restricted].E.entry,
       (PM.map projector).idempotent,
       (LineModules[l].Over[R,setR,axioms].At[L,fpL,RS.T'].Of[restricted].projector).idempotent,entries].iso
      (MI.inverse (DT.image target moved) (DT.image RS.T' restricted) (DT.iso RS.T' target path restricted)) ;
   } ;
   module IJ = Restrict[i,j,k,divides-ij,unit-i,unit-j] ;
   module JK = Restrict[j,k,i,divides-jk,unit-j,unit-k] ;
   module IK = Restrict[i,k,j,divides-ik,unit-i,unit-k] ;
   module M = MU.Mu[IJ.moved,JK.moved,IK.moved] ;
   -- mu_ijk : Image (H_ij|L_ijk (x) H_jk|L_ijk) ~ Image H_ik|L_ijk
   mu : K.Iso (K.product (IJ.PM.map IJ.projector) (JK.PM.map JK.projector)) (IK.PM.map IK.projector) =
    MI.compose (K.image (K.product (IJ.PM.map IJ.projector) (JK.PM.map JK.projector)))
     (K.image (K.product M.hab (JK.PM.map JK.projector))) (K.image (IK.PM.map IK.projector))
     (K.left-iso (IJ.PM.map IJ.projector) M.hab (JK.PM.map JK.projector) IJ.iso)
     (MI.compose (K.image (K.product M.hab (JK.PM.map JK.projector))) (K.image M.tensor) (K.image (IK.PM.map IK.projector))
      (K.right-iso M.hab (JK.PM.map JK.projector) M.hbc JK.iso)
      (MI.compose (K.image M.tensor) (K.image M.hac) (K.image (IK.PM.map IK.projector)) M.mu
       (MI.inverse (K.image (IK.PM.map IK.projector)) (K.image M.hac) IK.iso))) ;
  } ;
 } ;
} ;
