-- The scalars of a line (gabber-recollement, the base case of P(V)^v).  For
-- a module L the map
--     scal : I 1_1 -> Hom(L, L),   scal(w) = (v |-> w_0 v)
-- needs no choice.  If L merely has a basis e, c of rank 1 (c(e) = 1,
-- c(m) e = m), it is an isomorphism:
--  (inverse)   back(f) = c(f(e)), and scal(back f) = f:
--                f(v) = f(c(v) e) = c(v) f(e) = c(v) c(f(e)) e = c(f(e)) v;
--  (injective) scal(w) = scal(w') gives w_0 = c(w_0 e) = c(w'_0 e) = w'_0.
-- Injectivity is a proposition, so a mere basis gives it; the fibres of
-- scal are then propositions, merely inhabited by back, hence inhabited.
-- Hom(L, L) = I 1_1 is so canonical: it does not depend on a basis, so it
-- applies to a weight-n family whose fibres only merely have bases.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module M1 = MnAlgebra[l].Over[R,setR,suc zero] ;
 module At (L : MD.Module) {
  module H = HM.At[L,L] ;
  module IM = MT.Image[suc zero,M1.mone] ;
  coefficient (w : IM.S.E) : R.R = w.1 (inr tt) ;
  -- scal
  scale (a : R.R) : H.S.E = (\ v -> L.sm a v,\ x y -> L.smD a x y,
   \ b x -> trans (L.smA a b x) (trans (ap (\ t -> L.sm t x) (R.mulC a b)) (sym (L.smA b a x)))) ;
  scal (w : IM.S.E) : H.S.E = scale (coefficient w) ;
  scal-add (w w' : IM.S.E) : Id H.S.E (scal (IM.carrier.madd w w')) (H.carrier.madd (scal w) (scal w')) =
   H.ext _ _ (\ v -> L.smE (coefficient w) (coefficient w') v) ;
  scal-scale (a : R.R) (w : IM.S.E) : Id H.S.E (scal (IM.carrier.sm a w)) (H.carrier.sm a (scal w)) =
   H.ext _ _ (\ v -> sym (L.smA a (coefficient w) v)) ;
  -- vectors of length 1
  top-eq (u u' : IM.S.E) (h : Id R.R (coefficient u) (coefficient u')) : (t : Top) -> Id R.R (u.1 (inr t)) (u'.1 (inr t)) =
   split { tt -> h } ;
  entries (u u' : IM.S.E) (h : Id R.R (coefficient u) (coefficient u')) : (i : Fin (suc zero)) -> Id R.R (u.1 i) (u'.1 i) =
   split { inl i -> efq i ; inr t -> top-eq u u' h t } ;
  -- (inverse), from a basis
  module Inverse (b : LF.Basis[L,suc zero]) {
   e : L.M = b.frame.vector (inr tt) ;
   c : HM.At[L,MD.regular].S.E = b.frame.form (inr tt) ;
   unit : Id R.R (c.1 e) R.o = trans (b.dual (inr tt) (inr tt)) (MnSums[l].Over[R].delta-diag (suc zero) (inr tt)) ;
   one (m : L.M) : Id L.M (L.sm (c.1 m) e) m = trans (sym (L.maddZ (L.sm (c.1 m) e))) (b.frame.law m) ;
   back (f : H.S.E) : IM.S.E = (\ i -> c.1 (f.1 e),IM.V.act-one (\ i -> c.1 (f.1 e))) ;
   scal-back (f : H.S.E) : Id H.S.E (scal (back f)) f =
    H.ext _ f (\ v -> calc L.M {
     L.sm (c.1 (f.1 e)) v
      =< ap (L.sm (c.1 (f.1 e))) (sym (one v)) > L.sm (c.1 (f.1 e)) (L.sm (c.1 v) e)
      =< L.smA (c.1 (f.1 e)) (c.1 v) e > L.sm (R.mul (c.1 (f.1 e)) (c.1 v)) e
      =< ap (\ t -> L.sm t e) (R.mulC (c.1 (f.1 e)) (c.1 v)) > L.sm (R.mul (c.1 v) (c.1 (f.1 e))) e
      =< sym (L.smA (c.1 v) (c.1 (f.1 e)) e) > L.sm (c.1 v) (L.sm (c.1 (f.1 e)) e)
      =< ap (L.sm (c.1 v)) (one (f.1 e)) > L.sm (c.1 v) (f.1 e)
      =< sym (f.2.2 (c.1 v) e) > f.1 (L.sm (c.1 v) e)
      =< ap f.1 (one v) > f.1 v }) ;
   -- c(a e) = a
   recover (a : R.R) : Id R.R (c.1 (L.sm a e)) a =
    trans (c.2.2 a e) (trans (ap (R.mul a) unit) (R.mulO a)) ;
   injective (w w' : IM.S.E) (h : Id H.S.E (scal w) (scal w')) : Id IM.S.E w w' =
    IM.ext w w' (IM.V.vec-eq w.1 w'.1 (entries w w'
     (trans (sym (recover (coefficient w))) (trans (ap (\ f -> c.1 (f.1 e)) h) (recover (coefficient w')))))) ;
  } ;
  -- from a mere basis
  module Merely (bl : Tr.Trunc[LF.Basis[L,suc zero]].carrier) {
   injective (w w' : IM.S.E) (h : Id H.S.E (scal w) (scal w')) : Id IM.S.E w w' =
    Tr.Trunc[LF.Basis[L,suc zero]].induction @l (\ z -> Id IM.S.E w w') (\ z -> IM.carrier.setM w w')
     (\ b -> Inverse[b].injective w w' h) bl ;
   Fib (f : H.S.E) : U l = (w : IM.S.E) * Id H.S.E (scal w) f ;
   fib-prop (f : H.S.E) : Pr.isProp (Fib f) = \ u v ->
    Pr.Sigma-eq IM.S.E (\ w -> Id H.S.E (scal w) f) u.1 v.1 u.2 v.2
     (injective u.1 v.1 (trans u.2 (sym v.2))) (H.carrier.setM (scal v.1) f) ;
   fib (f : H.S.E) : Fib f =
    Tr.Trunc[LF.Basis[L,suc zero]].induction @l (\ z -> Fib f) (\ z -> fib-prop f)
     (\ b -> (Inverse[b].back f,Inverse[b].scal-back f)) bl ;
   inverse (f : H.S.E) : IM.S.E = (fib f).1 ;
   scalars : Id MD.Module (MT.I (suc zero) M1.mone) H.carrier =
    SIP.sip IM.carrier H.carrier ((scal,Pr.qinv IM.S.E H.S.E scal inverse (\ f -> (fib f).2)
      (\ w -> injective (inverse (scal w)) w (fib (scal w)).2)),
     scal-add,\ a w -> scal-scale a w) ;
   theorem : Id MD.Module H.carrier (MT.I (suc zero) M1.mone) =
    Pr1.sym MD.Module (MT.I (suc zero) M1.mone) H.carrier scalars ;
  } ;
 } ;
} ;
