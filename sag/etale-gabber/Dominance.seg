-- Each of V, W is a summand of a power of the other (CHEAP-DESIGN.md,
-- section 3).  For V, W twisted and framed on X = Spec Alg, each with a
-- unimodular element in every fibre: LOCALLIFT.Summand.power gives merely
-- V [x] 1_N = W + K', and SUMMANDS.Tensors.summand turns this into
-- W | V^(n+1) (EFFACE.power); symmetrically V | W^(n'+1).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module LL = LocalLift[l].Over[R,setR,axioms] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe) {
  module LA = LL.At[Alg,fp,G] ;
  module ST = Summands[l].Tensors[R,setR,LA.DA.X,\ x -> (G x).1] ;
  module Both (V W : LA.Fam.TF.Twisted) (r s : Nat) (fv : LA.Fam.Framed V.1 r) (fw : LA.Fam.Framed W.1 s)
   (uv : (x : LA.DA.X) (g : (G x).1) -> Tr.Trunc[LL.Unimodular[V.1 x g]].carrier)
   (uw : (x : LA.DA.X) (g : (G x).1) -> Tr.Trunc[LL.Unimodular[W.1 x g]].carrier) {
   module SV = LA.Summand[V,W,r,s,fv,fw,uv] ;
   module SW = LA.Summand[W,V,s,r,fw,fv,uw] ;
   -- W | power n V
   in-v : Tr1.Trunc[ST.Power V.1 W.1].carrier =
    TC1.map SV.PowerStatement (ST.Power V.1 W.1) (\ t -> ST.summand V.1 W.1 t.1 t.2.1 t.2.2) SV.power ;
   -- V | power n W
   in-w : Tr1.Trunc[ST.Power W.1 V.1].carrier =
    TC1.map SW.PowerStatement (ST.Power W.1 V.1) (\ t -> ST.summand W.1 V.1 t.1 t.2.1 t.2.2) SW.power ;
  } ;
 } ;
} ;
