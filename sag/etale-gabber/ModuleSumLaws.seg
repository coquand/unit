-- Laws of the finite sums of MODULEFINITESUMS in a module M, each by
-- induction on the number of terms:
--   a sum of zeros is 0;  c (sum v) = sum c v (smD);
--   an additive map f : M -> N with f 0 = 0 commutes with sums, and with
--   linear combinations if it also commutes with scalars;
--   a sum over Fin (m + n) is the sum over Fin m plus the sum over Fin n
--   (BLOCKS: injl, injr), so a sum over Fin (m n) is the double sum over
--   the pairs (PAIRING), as Pairing.Sums.sum-pair for the ring;
--   sum (v + w) = sum v + sum w (swap4), hence double sums may be
--   exchanged: sum_b sum_j x_bj = sum_j sum_b x_bj.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (M : Modules[l].Over[R,setR].Module) {
 module MD = Modules[l].Over[R,setR] ;
 module MA = Alg73[l].MA[MD.ring,M] ;
 module Sum = ModuleFiniteSums[l].Over[R,setR,M] ;
 sum-zero : (n : Nat) (v : Fin n -> M.M) -> ((i : Fin n) -> Id M.M (v i) M.mz) ->
  Id M.M (Sum.sum n v) M.mz = split {
  zero -> \ v h -> refl M.mz ;
  suc n | ih -> \ v h ->
   trans (cong2 M.M M.madd _ _ _ _ (h (inr tt)) (ih (\ i -> v (inl i)) (\ i -> h (inl i))))
    (M.maddZ M.mz) } ;
 scale-sum (c : R.R) : (n : Nat) (v : Fin n -> M.M) ->
  Id M.M (M.sm c (Sum.sum n v)) (Sum.sum n (\ i -> M.sm c (v i))) = split {
  zero -> \ v -> MA.sm-zr c ;
  suc n | ih -> \ v ->
   trans (M.smD c (v (inr tt)) (Sum.sum n (\ i -> v (inl i))))
    (ap (M.madd (M.sm c (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
 module Map (N : MD.Module) (f : M.M -> N.M) (fz : Id N.M (f M.mz) N.mz)
  (fa : (u v : M.M) -> Id N.M (f (M.madd u v)) (N.madd (f u) (f v))) {
  module SumN = ModuleFiniteSums[l].Over[R,setR,N] ;
  sum : (n : Nat) (v : Fin n -> M.M) -> Id N.M (f (Sum.sum n v)) (SumN.sum n (\ i -> f (v i))) = split {
   zero -> \ v -> fz ;
   suc n | ih -> \ v ->
    trans (fa (v (inr tt)) (Sum.sum n (\ i -> v (inl i))))
     (ap (N.madd (f (v (inr tt)))) (ih (\ i -> v (inl i)))) } ;
  -- if f also commutes with scalars, it commutes with linear combinations
  combination (fs : (t : R.R) (u : M.M) -> Id N.M (f (M.sm t u)) (N.sm t (f u)))
   (n : Nat) (b : Fin n -> R.R) (v : Fin n -> M.M) :
   Id N.M (f (Sum.sum n (\ i -> M.sm (b i) (v i)))) (SumN.sum n (\ i -> N.sm (b i) (f (v i)))) =
   trans (sum n (\ i -> M.sm (b i) (v i)))
    (SumN.congruent n (\ i -> f (M.sm (b i) (v i))) (\ i -> N.sm (b i) (f (v i))) (\ i -> fs (b i) (v i))) ;
 } ;
 sum-plus (n : Nat) : (m : Nat) (v : Fin (plus m n) -> M.M) ->
  Id M.M (Sum.sum (plus m n) v)
   (M.madd (Sum.sum m (\ i -> v (Blocks[l].injl n m i))) (Sum.sum n (\ k -> v (Blocks[l].injr n m k)))) = split {
  zero -> \ v -> sym (MA.mzl (Sum.sum n v)) ;
  suc m | r -> \ v -> trans (ap (M.madd (v (inr tt))) (r (\ x -> v (inl x))))
   (M.maddA (v (inr tt)) (Sum.sum m (\ i -> v (inl (Blocks[l].injl n m i))))
    (Sum.sum n (\ k -> v (inl (Blocks[l].injr n m k))))) } ;
 sum-pair (n : Nat) : (m : Nat) (f : Fin (Pairing[l].times m n) -> M.M) ->
  Id M.M (Sum.sum (Pairing[l].times m n) f)
   (Sum.sum m (\ j -> Sum.sum n (\ i -> f (Pairing[l].pair n m j i)))) = split {
  zero -> \ f -> refl M.mz ;
  suc m | r -> \ f -> trans (sum-plus n (Pairing[l].times m n) f)
   (trans (ap (\ t -> M.madd t (Sum.sum n (\ i -> f (Blocks[l].injr n (Pairing[l].times m n) i))))
     (r (\ y -> f (Blocks[l].injl n (Pairing[l].times m n) y))))
    (M.maddC (Sum.sum m (\ j -> Sum.sum n (\ i -> f (Blocks[l].injl n (Pairing[l].times m n) (Pairing[l].pair n m j i)))))
     (Sum.sum n (\ i -> f (Blocks[l].injr n (Pairing[l].times m n) i))))) } ;
 -- sum (v + w) = sum v + sum w
 sum-add : (n : Nat) (v w : Fin n -> M.M) ->
  Id M.M (Sum.sum n (\ i -> M.madd (v i) (w i))) (M.madd (Sum.sum n v) (Sum.sum n w)) = split {
  zero -> \ v w -> sym (M.maddZ M.mz) ;
  suc n | ih -> \ v w ->
   trans (ap (M.madd (M.madd (v (inr tt)) (w (inr tt)))) (ih (\ i -> v (inl i)) (\ i -> w (inl i))))
    (MA.swap4 (v (inr tt)) (w (inr tt)) (Sum.sum n (\ i -> v (inl i))) (Sum.sum n (\ i -> w (inl i)))) } ;
 -- exchange of a double sum
 exchange (m : Nat) : (n : Nat) (x : Fin n -> Fin m -> M.M) ->
  Id M.M (Sum.sum n (\ b -> Sum.sum m (x b))) (Sum.sum m (\ j -> Sum.sum n (\ b -> x b j))) = split {
  zero -> \ x -> sym (sum-zero m (\ j -> M.mz) (\ j -> refl M.mz)) ;
  suc n | ih -> \ x ->
   trans (ap (M.madd (Sum.sum m (x (inr tt)))) (ih (\ b -> x (inl b))))
    (sym (sum-add m (x (inr tt)) (\ j -> Sum.sum n (\ b -> x (inl b) j)))) } ;
} ;
