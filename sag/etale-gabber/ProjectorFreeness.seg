-- A global factorisation certificate really trivialises the fixed vectors.
-- The formulas also preserve addition and scalar multiplication.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 open A ; open RL[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module M = RankOneProjector[l].Over[A].Size[n] ;
 Fixed (e : M.Matrix) : U l =
  (v : M.Vector) * ((i : Fin n) -> Id R (M.action e v i) (v i)) ;
 fixed-prop (e : M.Matrix) (v : M.Vector) :
  Pr.isProp ((i : Fin n) -> Id R (M.action e v i) (v i)) =
  F.isProp-Pi (Fin n) (\ i -> Id R (M.action e v i) (v i))
   (\ i -> setA _ _) ;
 module Factor (e : M.Matrix) (w : M.Factors e) {
  x : M.Vector = w.1 ;
  y : M.Vector = w.2.1 ;
  factor (i j : Fin n) : Id R (mul (x i) (y j)) (e i j) =
   trans (w.2.2.1 i j) (trans (mulC o (e i j)) (mulO (e i j))) ;
  contraction : Id R (M.dot y x) o = w.2.2.2 ;
  column (r : R) : M.Vector = \ i -> mul (x i) r ;
  coordinate (v : M.Vector) : R = M.dot y v ;
  factor-action (v : M.Vector) (i : Fin n) :
   Id R (M.action e v i) (mul (x i) (coordinate v)) =
   trans
    (S.sum-cong n (\ j -> mul (e i j) (v j))
     (\ j -> mul (x i) (mul (y j) (v j)))
     (\ j -> trans (ap (\ a -> mul a (v j)) (sym (factor i j)))
      (sym (mulA (x i) (y j) (v j)))))
    (S.sum-scale (x i) n (\ j -> mul (y j) (v j))) ;
  coordinate-column (r : R) : Id R (coordinate (column r)) r =
   trans
    (S.sum-cong n (\ i -> mul (y i) (mul (x i) r))
     (\ i -> mul r (mul (y i) (x i)))
     (\ i -> trans (mulA (y i) (x i) r) (mulC (mul (y i) (x i)) r)))
    (trans (S.sum-scale r n (\ i -> mul (y i) (x i)))
     (trans (ap (mul r) contraction) (mulO r))) ;
  column-fixed (r : R) : Fixed e =
   (column r,\ i -> trans (factor-action (column r) i)
    (ap (mul (x i)) (coordinate-column r))) ;
  reconstruct (v : Fixed e) :
   Id (Fixed e) (column-fixed (coordinate v.1)) v =
   Pr.Sigma-eq M.Vector
    (\ a -> (i : Fin n) -> Id R (M.action e a i) (a i))
    (column (coordinate v.1)) v.1 (column-fixed (coordinate v.1)).2 v.2
    (F.funext (Fin n) (\ i -> R) _ _
     (\ i -> trans (sym (factor-action v.1 i)) (v.2 i)))
    (fixed-prop e v.1) ;
  equivalence : Pr.Equiv R (Fixed e) =
   (column-fixed,Pr.qinv R (Fixed e) column-fixed (\ v -> coordinate v.1)
    reconstruct coordinate-column) ;
  column-add (r s : R) (i : Fin n) :
   Id R (column (add r s) i) (add (column r i) (column s i)) = dist (x i) r s ;
  column-scale (a r : R) (i : Fin n) :
   Id R (column (mul a r) i) (mul a (column r i)) = mul-swap (x i) a r ;
  coordinate-add (v z1 : M.Vector) :
   Id R (coordinate (\ i -> add (v i) (z1 i))) (add (coordinate v) (coordinate z1)) =
   S.lin-add n y v z1 ;
  coordinate-scale (a : R) (v : M.Vector) :
   Id R (coordinate (\ i -> mul a (v i))) (mul a (coordinate v)) =
   S.lin-scale n y v a ;
 } ;
} ;
