-- SAG 4.2.7 (Loc, SQC, Z-choice): an open subtype of Spec A is
-- affine-open, i.e. merely S = D(h_1,..,h_n) for h_i in A.
-- As in the paper: Z-choice gives open witnesses on a cover D(f_i); on
-- D(f_i) = Spec A_{f_i} their lengths are bounded (3.3.3); padding with
-- zeros and SQC for A_{f_i} give functions g_ij in A_{f_i}; 3.1.7 moves
-- S n D(f_i) = D(g_i) down to Spec A; the lists are concatenated.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module CB = CoefficientBound[l] ;
-- concatenation of finitely many lists
total : (k : Nat) -> (Fin k -> Nat) -> Nat = split {
 zero -> \ ns -> zero ;
 suc k | r -> \ ns -> plus (ns (inr tt)) (r (\ i -> ns (inl i))) } ;
concat (X : U l) : (k : Nat) -> (ns : Fin k -> Nat) -> ((i : Fin k) -> Fin (ns i) -> X) ->
 Fin (total k ns) -> X = split {
 zero -> \ ns hs w -> efq w ;
 suc k | r -> \ ns hs -> FinSum[l].cases (total k (\ i -> ns (inl i))) X
  (r (\ i -> ns (inl i)) (\ i -> hs (inl i))) (ns (inr tt)) (hs (inr tt)) } ;
-- cases commutes with a map
cases-map (n : Nat) (X Y : U l) (f : X -> Y) (a : Fin n -> X) : (m : Nat) -> (b : Fin m -> X) ->
 (w : Fin (plus m n)) -> Id Y (f (FinSum[l].cases n X a m b w))
  (FinSum[l].cases n Y (\ i -> f (a i)) m (\ j -> f (b j)) w) = split {
 zero -> \ b w -> refl (f (a w)) ;
 suc m | r -> \ b -> split {
  inl w -> r (\ j -> b (inl j)) w ;
  inr t -> refl (f (b (inr tt))) } } ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module O = StandardOpens[l].Over[R,setR] ;
 module OT = OpenTransitivity[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 module Pd = Pad[l].Over[R,setR,axioms.loc.1] ;
 module Bnd = UniformBounded[l].Theorem[R,setR,axioms.loc.1,axioms.sqc] ;
 Unit (a : R.R) : U l = RL[R].unit a ;
 units-congr (n : Nat) (v w : Fin n -> R.R) (h : (i : Fin n) -> Id R.R (v i) (w i))
  (u : OP.Units n v) : OP.Units n w =
  Tr.Trunc[(i : Fin n) * Unit (v i)].induction @l (\ t -> OP.Units n w) (\ t -> OP.units-prop n w)
   (\ p -> Tr.Trunc[(i : Fin n) * Unit (w i)].inc (p.1,OO.unit-along _ _ (h p.1) p.2)) u ;
 -- Units of a concatenation: merely, Units of one of the lists
 Some (k : Nat) (ns : Fin k -> Nat) (vs : (i : Fin k) -> Fin (ns i) -> R.R) : U l =
  Tr.Trunc[(i : Fin k) * OP.Units (ns i) (vs i)].carrier ;
 module ConcatStep (k : Nat) (ns : Fin (suc k) -> Nat) (vs : (i : Fin (suc k)) -> Fin (ns i) -> R.R)
  (ih : OpenProp[l].Iff (OP.Units (total k (\ i -> ns (inl i))) (concat R.R k (\ i -> ns (inl i)) (\ i -> vs (inl i))))
                        (Some k (\ i -> ns (inl i)) (\ i -> vs (inl i)))) {
  module Ap = OO.Append[total k (\ i -> ns (inl i)),concat R.R k (\ i -> ns (inl i)) (\ i -> vs (inl i)),ns (inr tt),vs (inr tt)] ;
  Goal : U l = Some (suc k) ns vs ;
  goal-prop : Pr.isProp Goal = Tr.Trunc[(i : Fin (suc k)) * OP.Units (ns i) (vs i)].proposition ;
  from-plus : Plus (OP.Units (total k (\ i -> ns (inl i))) (concat R.R k (\ i -> ns (inl i)) (\ i -> vs (inl i))))
                   (OP.Units (ns (inr tt)) (vs (inr tt))) -> Goal = split {
   inl u -> Tr.Trunc[(i : Fin k) * OP.Units (ns (inl i)) (vs (inl i))].induction @l (\ t -> Goal) (\ t -> goal-prop)
    (\ p -> Tr.Trunc[(i : Fin (suc k)) * OP.Units (ns i) (vs i)].inc (inl p.1,p.2)) (ih.1 u) ;
   inr u -> Tr.Trunc[(i : Fin (suc k)) * OP.Units (ns i) (vs i)].inc (inr tt,u) } ;
  to (u : OP.Units (total (suc k) ns) (concat R.R (suc k) ns vs)) : Goal =
   Tr.Trunc[Plus (OP.Units (total k (\ i -> ns (inl i))) (concat R.R k (\ i -> ns (inl i)) (\ i -> vs (inl i))))
                 (OP.Units (ns (inr tt)) (vs (inr tt)))].induction @l (\ t -> Goal) (\ t -> goal-prop) from-plus (Ap.to u) ;
  pick : (i : Fin (suc k)) -> OP.Units (ns i) (vs i) -> OP.Units (total (suc k) ns) (concat R.R (suc k) ns vs) = split {
   inl i -> \ u -> Ap.from-left (ih.2 (Tr.Trunc[(j : Fin k) * OP.Units (ns (inl j)) (vs (inl j))].inc (i,u))) ;
   inr t -> Generated[l].top-case (\ t -> OP.Units (ns (inr t)) (vs (inr t)) -> OP.Units (total (suc k) ns) (concat R.R (suc k) ns vs))
    (\ u -> Ap.from-right u) t } ;
  from (s : Goal) : OP.Units (total (suc k) ns) (concat R.R (suc k) ns vs) =
   Tr.Trunc[(i : Fin (suc k)) * OP.Units (ns i) (vs i)].induction @l
    (\ t -> OP.Units (total (suc k) ns) (concat R.R (suc k) ns vs))
    (\ t -> OP.units-prop (total (suc k) ns) (concat R.R (suc k) ns vs)) (\ p -> pick p.1 p.2) s ;
 } ;
 units-concat : (k : Nat) -> (ns : Fin k -> Nat) -> (vs : (i : Fin k) -> Fin (ns i) -> R.R) ->
  OpenProp[l].Iff (OP.Units (total k ns) (concat R.R k ns vs)) (Some k ns vs) = split {
  zero -> \ ns vs -> (\ u -> Tr.Trunc[(w : Fin zero) * Unit (concat R.R zero ns vs w)].induction @l
     (\ t -> Some zero ns vs) (\ t -> Tr.Trunc[(i : Fin zero) * OP.Units (ns i) (vs i)].proposition) (\ p -> efq p.1) u,
   \ s -> Tr.Trunc[(i : Fin zero) * OP.Units (ns i) (vs i)].induction @l
     (\ t -> OP.Units zero (concat R.R zero ns vs)) (\ t -> OP.units-prop zero (concat R.R zero ns vs)) (\ p -> efq p.1) s) ;
  suc k | r -> \ ns vs ->
   (ConcatStep[k,ns,vs,r (\ i -> ns (inl i)) (\ i -> vs (inl i))].to,
    ConcatStep[k,ns,vs,r (\ i -> ns (inl i)) (\ i -> vs (inl i))].from) } ;
 -- evaluation at a point commutes with concatenation
 concat-map (X Y : U l) (f : X -> Y) : (k : Nat) -> (ns : Fin k -> Nat) -> (hs : (i : Fin k) -> Fin (ns i) -> X) ->
  (w : Fin (total k ns)) -> Id Y (f (concat X k ns hs w)) (concat Y k ns (\ i j -> f (hs i j)) w) = split {
  zero -> \ ns hs w -> efq w ;
  suc k | r -> \ ns hs w ->
   trans (cases-map (total k (\ i -> ns (inl i))) X Y f (concat X k (\ i -> ns (inl i)) (\ i -> hs (inl i)))
     (ns (inr tt)) (hs (inr tt)) w)
    (Pr.ap (Fin (total k (\ i -> ns (inl i))) -> Y) Y (\ c -> FinSum[l].cases (total k (\ i -> ns (inl i))) Y c (ns (inr tt)) (\ j -> f (hs (inr tt) j)) w)
     (\ v -> f (concat X k (\ i -> ns (inl i)) (\ i -> hs (inl i)) v))
     (concat Y k (\ i -> ns (inl i)) (\ i j -> f (hs (inl i) j)))
     (Axioms[l].FunExtLemmas[fe @l].funext (Fin (total k (\ i -> ns (inl i)))) (\ v -> Y) _ _
      (r (\ i -> ns (inl i)) (\ i -> hs (inl i))))) } ;
 ------------------------------------------------------------------
 ------------------------------------------------------------------
 -- Gluing: if V is covered by D(f_1),..,D(f_k) and is affine-open on each
 -- Spec A_{f_i}, then V is affine-open (3.1.7 and concatenation).
 module Glue (A : C.Algebra) (fp : P.FP A) (V : C.Spec A -> U l) (propV : (a : C.Spec A) -> Pr.isProp (V a))
  (k : Nat) (fs : Fin k -> A.ring.R) (cov : (a : C.Spec A) -> V a -> O.Union A k fs a)
  (aff : (i : Fin k) (loc : I.LocalizationWitness A (fs i)) ->
    OT.AffineOpen loc.1 (\ x -> V (OT.Localized[A,fp,fs i,loc].restrict x))) {
  -- on D(f): V is merely D(h_1,..,h_n), with D(h_j) inside D(f)
  Good (f : A.ring.R) : U l =
   (n : Nat) * (hs : Fin n -> A.ring.R) *
   ((a : C.Spec A) -> O.Union A n hs a -> Unit (a.1.1 f)) *
   ((a : C.Spec A) -> Unit (a.1.1 f) -> OpenProp[l].Iff (V a) (O.Union A n hs a)) ;
  module Local (i : Fin k) (loc : I.LocalizationWitness A (fs i)) {
   e : Pr.Equiv (C.Spec loc.1) (I.D A (fs i)) = I.spectrum A (fs i) loc ;
   module T = OT.Localized[A,fp,fs i,loc] ;
   sub (x : C.Spec loc.1) : U l = V (T.restrict x) ;
   module FromExtended (w : T.Extended sub) {
    point (a : C.Spec A) (u : Unit (a.1.1 (fs i))) : C.Spec loc.1 = e.2.sec (a,u) ;
    back (a : C.Spec A) (u : Unit (a.1.1 (fs i))) : Id (C.Spec A) (T.restrict (point a u)) a =
     Pr.ap (I.D A (fs i)) (C.Spec A) (\ d -> d.1) _ _ (e.2.sec-eq (a,u)) ;
    good : Good (fs i) = (w.1,w.2.1,w.2.2.1,\ a u ->
     (\ s -> subst (O.Union A w.1 w.2.1) (back a u)
        ((w.2.2.2 (point a u)).1 (subst V (sym (back a u)) s)),
      \ v -> subst V (back a u)
        ((w.2.2.2 (point a u)).2 (subst (O.Union A w.1 w.2.1) (sym (back a u)) v)))) ;
   } ;
   good : Tr.Trunc[Good (fs i)].carrier =
    Tr.Trunc[T.Extended sub].induction @l (\ t -> Tr.Trunc[Good (fs i)].carrier)
     (\ t -> Tr.Trunc[Good (fs i)].proposition)
     (\ w -> Tr.Trunc[Good (fs i)].inc FromExtended[w].good) (T.transitivity sub (aff i loc)) ;
  } ;
  local-good (i : Fin k) : Tr.Trunc[Good (fs i)].carrier =
   Tr1.Trunc[I.LocalizationWitness A (fs i)].induction @l (\ t -> Tr.Trunc[Good (fs i)].carrier)
    (\ t -> Tr.Trunc[Good (fs i)].proposition) (\ loc -> Local[i,loc].good) (I.localize A fp (fs i)) ;
  module Combine (ws : (i : Fin k) -> Good (fs i)) {
   ns (i : Fin k) : Nat = (ws i).1 ;
   hs : Fin (total k ns) -> A.ring.R = concat A.ring.R k ns (\ i -> (ws i).2.1) ;
   vs (a : C.Spec A) (i : Fin k) (j : Fin (ns i)) : R.R = a.1.1 ((ws i).2.1 j) ;
   union-some (a : C.Spec A) : OpenProp[l].Iff (O.Union A (total k ns) hs a) (Some k ns (vs a)) =
    (\ u -> (units-concat k ns (vs a)).1
      (units-congr (total k ns) (\ w -> a.1.1 (hs w)) (concat R.R k ns (vs a))
       (concat-map A.ring.R R.R a.1.1 k ns (\ i -> (ws i).2.1)) u),
     \ s -> units-congr (total k ns) (concat R.R k ns (vs a)) (\ w -> a.1.1 (hs w))
       (\ w -> sym (concat-map A.ring.R R.R a.1.1 k ns (\ i -> (ws i).2.1) w))
       ((units-concat k ns (vs a)).2 s)) ;
   forward (a : C.Spec A) (s : V a) : Some k ns (vs a) =
    Tr.Trunc[(i : Fin k) * Unit (a.1.1 (fs i))].induction @l (\ t -> Some k ns (vs a))
     (\ t -> Tr.Trunc[(i : Fin k) * OP.Units (ns i) (vs a i)].proposition)
     (\ p -> Tr.Trunc[(i : Fin k) * OP.Units (ns i) (vs a i)].inc (p.1,((ws p.1).2.2.2 a p.2).1 s))
     (cov a s) ;
   backward (a : C.Spec A) (t : Some k ns (vs a)) : V a =
    Tr.Trunc[(i : Fin k) * OP.Units (ns i) (vs a i)].induction @l (\ t -> V a) (\ t -> propV a)
     (\ p -> ((ws p.1).2.2.2 a ((ws p.1).2.2.1 a p.2)).2 p.2) t ;
   result : OT.OpenWitness A V = (total k ns,hs,\ a ->
    (\ s -> (union-some a).2 (forward a s),\ u -> backward a ((union-some a).1 u))) ;
  } ;
  result : OT.AffineOpen A V =
   Tr.Trunc[(i : Fin k) -> Good (fs i)].induction @l (\ t -> OT.AffineOpen A V)
    (\ t -> Tr.Trunc[OT.OpenWitness A V].proposition)
    (\ ws -> Tr.Trunc[OT.OpenWitness A V].inc Combine[ws].result)
    (AffineFinite[l].choice k (\ i -> Good (fs i)) local-good) ;
 } ;
 ------------------------------------------------------------------
 module At (A : C.Algebra) (fp : P.FP A) (S : C.Spec A -> U l) (o : OP.OpenSubtype (C.Spec A) S) {
  B (a : C.Spec A) : U l = OP.Witness (S a) ;
  propS (a : C.Spec A) : Pr.isProp (S a) = OP.open-prop (S a) (o a) ;
  module Choices (c : Ax.ChoiceData A B) {
   k : Nat = c.1 ;
   fs : Fin k -> A.ring.R = c.2.1 ;
   module Local (i : Fin k) (loc : I.LocalizationWitness A (fs i)) {
    L : C.Algebra = loc.1 ;
    e : Pr.Equiv (C.Spec L) (I.D A (fs i)) = I.spectrum A (fs i) loc ;
    module T = OT.Localized[A,fp,fs i,loc] ;
    sub (x : C.Spec L) : U l = S (T.restrict x) ;
    wit (x : C.Spec L) : OP.Witness (sub x) = c.2.2.2 i (e.1 x).1 (e.1 x).2 ;
    len (x : C.Spec L) : Nat = (wit x).1 ;
    module Bounded (bd : (N : Nat) * ((x : C.Spec L) -> CB.le (len x) N)) {
     b : Nat = bd.1 ;
     vals (x : C.Spec L) : Fin b -> R.R = Pd.pad b (len x) (wit x).2.1 ;
     ev : Pr.isEquiv L.ring.R (C.Spec L -> R.R) (C.evaluation L) = axioms.sqc L loc.2.1 ;
     g (j : Fin b) : L.ring.R = ev.sec (\ x -> vals x j) ;
     g-at (x : C.Spec L) (j : Fin b) : Id R.R (x.1.1 (g j)) (vals x j) =
      Pr.happly (C.Spec L) (\ x -> R.R) _ _ (ev.sec-eq (\ x -> vals x j)) x ;
     iff (x : C.Spec L) : OT.Iff (sub x) (O.Union L b g x) =
      (\ s -> units-congr b (vals x) (\ j -> x.1.1 (g j)) (\ j -> sym (g-at x j))
        (Pd.to-padded b (len x) (bd.2 x) (wit x).2.1 ((wit x).2.2.1 s)),
       \ u -> (wit x).2.2.2.sec (Pd.from-padded b (len x) (wit x).2.1
        (units-congr b (\ j -> x.1.1 (g j)) (vals x) (g-at x) u))) ;
     open-L : OT.AffineOpen L sub = Tr.Trunc[OT.OpenWitness L sub].inc (b,g,iff) ;
    } ;
    affine-open : OT.AffineOpen L sub =
     Tr.Trunc[(N : Nat) * ((x : C.Spec L) -> CB.le (len x) N)].induction @l (\ t -> OT.AffineOpen L sub)
      (\ t -> Tr.Trunc[OT.OpenWitness L sub].proposition) (\ bd -> Bounded[bd].open-L)
      (Bnd.ForAlgebra[L,loc.2.1].theorem len) ;
   } ;
   cover (a : C.Spec A) (s : S a) : O.Union A k fs a =
    AffineCovers[l].Over[R,setR,axioms.loc].At[A,k,fs].cover c.2.2.1 a ;
   result : OT.AffineOpen A S =
    Glue[A,fp,S,propS,k,fs,cover,\ i loc -> Local[i,loc].affine-open].result ;
  } ;
  -- 4.2.7
  theorem : OT.AffineOpen A S =
   Tr.Trunc[Ax.ChoiceData A B].induction @l (\ t -> OT.AffineOpen A S)
    (\ t -> Tr.Trunc[OT.OpenWitness A S].proposition) (\ c -> Choices[c].result)
    (axioms.zchoice A fp B o) ;
 } ;
 -- affine-open subtypes are open
 affine-open-open (A : C.Algebra) (V : C.Spec A -> U l) (propV : (a : C.Spec A) -> Pr.isProp (V a))
  (aff : OT.AffineOpen A V) : OP.OpenSubtype (C.Spec A) V = \ a ->
  Tr.Trunc[OT.OpenWitness A V].induction @l (\ t -> OP.Open (V a)) (\ t -> Tr.Trunc[OP.Witness (V a)].proposition)
   (\ w -> Tr.Trunc[OP.Witness (V a)].inc (OP.from-iff (V a) (propV a) w.1 (\ j -> a.1.1 (w.2.1 j))
    (w.2.2 a).1 (w.2.2 a).2)) aff ;
} ;
