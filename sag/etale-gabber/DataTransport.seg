-- Frame data along a path of torsor families (../HANDOFF-GABBER-HOMOTOPY.md).
-- Over Spec L, a path e : T = T' of families of torsors moves frame data
-- for T (AFFINELINEDATA) to frame data for T', and the images of their
-- projectors (LINEMODULES) are isomorphic: by path induction on e, at refl
-- the data are the same.  Used where two families agree only pointwise,
-- such as the restriction of a line to a triple overlap and the line of
-- the paths between the points there (GERBETRIPLE).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 Tor : U l+ = TorsorId[l].TorId[UG.group].Tor ;
 module At (L : C.Algebra) (fp : P.FP L) {
  Family : U l+ = C.Spec L -> Tor ;
  module PJ = Projectors[l].Over[L.ring,L.set] ;
  module MI = PJ.MI ;
  Data (T : Family) : U l = AffineLineData[l].Over[R,setR,axioms].At[L,fp,T].Data ;
  image (T : Family) (w : Data T) : PJ.SA.Module =
   PJ.Image[LineModules[l].Over[R,setR,axioms].At[L,fp,T].Of[w].projector].image ;
  move (T T' : Family) (e : Id Family T T') (w : Data T) : Data T' = idJ Family T (\ S q -> Data S) w T' e ;
  iso (T T' : Family) (e : Id Family T T') (w : Data T) : MI.Iso[image T' (move T T' e w),image T w] =
   idJ Family T (\ S q -> MI.Iso[image S (move T S q w),image T w]) (MI.identity (image T w)) T' e ;
 } ;
} ;
