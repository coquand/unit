-- Bases of powers of a family (gabber-recollement, Theorem main).  If every
-- fibre of F merely has a basis of rank a + 1, every fibre of
-- F^(k+1) = F + F^k (EFFACE, pointwise sums MODULESUMS.Families) merely has
-- one of rank copies a k + 1 (RANKARITHMETIC): the sum of bases
-- (STANDARDBASES.SumBasis) has rank (a + 1) + (copies a k + 1), which is
-- copies a (k+1) + 1 by definition.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MS = ModuleSums[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module SB = StandardBases[l].Over[R,setR,axioms] ;
 module At (X : U l) (Y : X -> U l) {
  module FS = MS.Families[X,Y] ;
  bases (F : FS.Fam) (a : Nat) (b : (x : X) (y : Y x) -> Tr.Trunc[LF.Basis[F x y,suc a]].carrier) :
   (k : Nat) (x : X) (y : Y x) -> Tr.Trunc[LF.Basis[FS.E.power k F x y,suc (RankArithmetic[l].copies a k)]].carrier = split {
   zero -> b ;
   suc k | h -> \ x y -> TC.map2 (LF.Basis[F x y,suc a]) (LF.Basis[FS.E.power k F x y,suc (RankArithmetic[l].copies a k)])
     (LF.Basis[FS.E.power (suc k) F x y,suc (RankArithmetic[l].copies a (suc k))])
     (\ p q -> SB.SumBasis[F x y,FS.E.power k F x y,suc a,suc (RankArithmetic[l].copies a k),p,q].basis) (b x y) (h x y) } ;
 } ;
} ;
