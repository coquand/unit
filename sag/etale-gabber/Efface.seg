-- Weak cancellation (gabber-recollement, Lemma `efface`), as algebra on
-- identities.  Let T be a type with an associative and commutative
-- operation +, and write X^(k+1) = X + X^k (power k X, k + 1 copies).
-- Let X + S = Y + S, and let S be a summand of a power of X and of the same
-- power of Y:  X^M = S + S',  Y^M = S + S''  (M = power m).  Then
--     X^M + X^M = Y^M + Y^M.
-- Proof.
--  (step)   X + X^M = Y + X^M:  X + (S + S') = (X + S) + S'
--           = (Y + S) + S' = Y + (S + S').
--  (shift)  X^k + X^M = Y^k + X^M for every k, by induction:
--           (X + X^k) + X^M = X + (X^k + X^M) = X + (Y^k + X^M)
--           = Y^k + (X + X^M) = Y^k + (Y + X^M) = (Y + Y^k) + X^M.
--  So X^M + X^M = Y^M + X^M, and symmetrically Y^M + Y^M = X^M + Y^M;
--  the theorem follows by commutativity.
--  (powers) X^j + X^k = X^(j+k+1), so X^M + X^M is a power of X.
-- In the use (CHEAP-DESIGN.md) T is the type of families of modules over the
-- gerbes and + is the pointwise direct sum; identities are isomorphisms.
level l ; open Ring[l] ;
module P1 = Ring[l+] ;
module Over (T : U l+) (add : T -> T -> T)
 (assoc : (a b c : T) -> Id T (add a (add b c)) (add (add a b) c))
 (comm : (a b : T) -> Id T (add a b) (add b a)) {
 power : Nat -> T -> T = split {
  zero -> \ a -> a ;
  suc k | r -> \ a -> add a (r a) } ;
 -- (powers)
 powers (a : T) : (j k : Nat) -> Id T (add (power j a) (power k a)) (power (suc (plus j k)) a) = split {
  zero -> \ k -> refl (add a (power k a)) ;
  suc j | r -> \ k -> P1.trans (P1.sym (assoc a (power j a) (power k a))) (P1.ap (add a) (r k)) } ;
 -- a + (b + c) = b + (a + c)
 exchange (a b c : T) : Id T (add a (add b c)) (add b (add a c)) =
  P1.trans (assoc a b c) (P1.trans (P1.ap (\ t -> add t c) (comm a b)) (P1.sym (assoc b a c))) ;
 module Lemma (X Y S S' S'' : T) (m : Nat)
  (cancel : Id T (add X S) (add Y S))
  (sx : Id T (power m X) (add S S'))
  (sy : Id T (power m Y) (add S S'')) {
  M (a : T) : T = power m a ;
  -- (step), for X and Y and for Y and X
  module Step (A B C D : T) (c : Id T (add A C) (add B C)) (s : Id T (power m A) (add C D)) {
   -- A + (C + D) = (A + C) + D = (B + C) + D = B + (C + D)
   step : Id T (add A (power m A)) (add B (power m A)) =
    P1.trans (P1.ap (add A) s) (P1.trans (assoc A C D) (P1.trans (P1.ap (\ t -> add t D) c)
     (P1.trans (P1.sym (assoc B C D)) (P1.ap (add B) (P1.sym s))))) ;
   -- (shift)
   shift : (k : Nat) -> Id T (add (power k A) (power m A)) (add (power k B) (power m A)) = split {
    zero -> step ;
    suc k | r -> P1.trans (P1.sym (assoc A (power k A) (power m A)))
     (P1.trans (P1.ap (add A) r)
      (P1.trans (exchange A (power k B) (power m A))
       (P1.trans (P1.ap (add (power k B)) step)
        (P1.trans (exchange (power k B) B (power m A)) (assoc B (power k B) (power m A)))))) } ;
   doubled : Id T (add (power m A) (power m A)) (add (power m B) (power m A)) = shift m ;
  } ;
  module SX = Step[X,Y,S,S',cancel,sx] ;
  module SY = Step[Y,X,S,S'',P1.sym cancel,sy] ;
  theorem : Id T (add (M X) (M X)) (add (M Y) (M Y)) =
   P1.trans SX.doubled (P1.trans (comm (M Y) (M X)) (P1.sym SY.doubled)) ;
  -- the same as an identity of powers
  powers-theorem : Id T (power (suc (plus m m)) X) (power (suc (plus m m)) Y) =
   P1.trans (P1.sym (powers X m m)) (P1.trans theorem (powers Y m m)) ;
 } ;
} ;
