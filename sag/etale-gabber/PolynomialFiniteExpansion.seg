-- Expand a polynomial with a supplied degree bound in the finite power basis.
-- The last Fin coordinate is the constant coefficient; preceding coordinates
-- recursively represent the tail. No coefficient equality is decided.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R)
 (hom : RingHom[l].Hom PolynomialRing[l].Extension[A,setA].ring C) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module P = Poly[l].PolyR[A] ;
 module S = FiniteIdeal[l].Sums[C] ;
 module CR = RL[C] ;
 phi : RingHom[l].Hom A C = RingHom[l].compose A B.ring C hom B.inclusion ;
 variable : C.R = hom.1 B.variable ;
 coefficients : (n : Nat) -> P.P -> Fin n -> A.R = split {
  zero -> \ p i -> efq i ;
  suc n | ih -> \ p -> snoc (Fin n) A.R (ih (Bounds.tail p)) (P.coef p zero) } ;
 basis : (n : Nat) -> Fin n -> C.R = split {
  zero -> \ i -> efq i ;
  suc n | ih -> snoc (Fin n) C.R (\ i -> C.mul variable (ih i)) C.o } ;
 expansion (n : Nat) (p : P.P) : C.R =
  S.sum n (\ i -> C.mul (phi.1 (coefficients n p i)) (basis n i)) ;
 cut-equation : (n : Nat) (p : P.P) ->
  Id C.R (hom.1 (B.include (Bounds.cut n p))) (expansion n p) = split {
  zero -> \ p -> RingHom[l].zero B.ring C hom ;
  suc n | ih -> \ p ->
   trans (ap hom.1 (B.horner (P.coef p zero) (Bounds.cut n (Bounds.tail p))))
    (trans (hom.2.2.1 (B.constant (P.coef p zero)) (B.mulQ B.variable (B.include (Bounds.cut n (Bounds.tail p)))))
     (trans (ap (C.add (phi.1 (P.coef p zero)))
       (trans (hom.2.2.2 B.variable (B.include (Bounds.cut n (Bounds.tail p))))
        (ap (C.mul variable) (ih (Bounds.tail p)))))
      (cong2 C.R C.add _ _ _ _ (sym (C.mulO (phi.1 (P.coef p zero))))
       (trans (sym (S.sum-scale variable n
         (\ i -> C.mul (phi.1 (coefficients n (Bounds.tail p) i)) (basis n i))))
        (S.sum-cong n
         (\ i -> C.mul variable (C.mul (phi.1 (coefficients n (Bounds.tail p) i)) (basis n i)))
         (\ i -> C.mul (phi.1 (coefficients n (Bounds.tail p) i)) (C.mul variable (basis n i)))
         (\ i -> CR.mul-swap variable (phi.1 (coefficients n (Bounds.tail p) i)) (basis n i))))))) } ;
 equation (n : Nat) (p : P.P) (bound : Bounds.Bound n p) :
  Id C.R (hom.1 (B.include p)) (expansion n p) =
  trans (ap hom.1 (B.Q.relates p (Bounds.cut n p) (Bounds.cut-equal n p bound))) (cut-equation n p) ;
 module CoefficientProperty (K : A.R -> U l) {
  all : (n : Nat) (p : P.P) ->
   ((k : Nat) -> K (P.coef p k)) -> (i : Fin n) -> K (coefficients n p i) = split {
   zero -> \ p h i -> efq i ;
   suc n | ih -> \ p h ->
    AffineFinite[l].section n (\ i -> K (coefficients (suc n) p i))
     (ih (Bounds.tail p) (\ k -> subst K (sym (Bounds.tail-coef p k)) (h (suc k)))) (h zero) } ;
 } ;
} ;
