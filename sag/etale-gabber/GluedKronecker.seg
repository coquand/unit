-- gabber-recollement.tex, Lemma 3.6(2), at the level of modules.  In the
-- situation of STABLESUM, let g, g' be inverse n x n and h, h' inverse
-- m x m matrices over C, and g (x) h = h (x) g in the index order of
-- KRONECKER (size N = times m n).  Then
--     P_g^m + P_h^n ~ P_{g (x) h} + A^N        (merely),
-- with P^k the product of k copies (SERREMODULEPRODUCTS).  In K_0 this
-- reads m[P_g] + n[P_h] = [P_{g (x) h}] + mn, so that, once
-- [P_g][P_h] = [P_{g (x) h}], ([P_g] - n)([P_h] - m) = 0.
--
-- Proof.  ((1 (x) X) w)_(j,i) = (X w_j)_i, where w_j = (w_(j,i))_i, so
-- (u, v) is in P_{1 (x) X} iff each block (u_j, v_j) is in P_X (Rows:
-- P_{1 (x) X} ~ P_X^m), and likewise P_{Y (x) 1} ~ P_Y^n by columns
-- (Columns).  By the mixed product, (1 (x) g)(h (x) 1) = h (x) g, and
-- STABLESUM for 1 (x) g and h (x) 1 gives
--     P_{1 (x) g} + P_{h (x) 1} ~ P_{h (x) g} + A^N.
-- No permutation matrix is needed: pairs index both layers.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (m n : Nat) {
 module Gn = GluedModule[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,n] ;
 module Gm = GluedModule[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,m] ;
 module GN = GluedModule[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,Pairing[l].times m n] ;
 module SS = StableSum[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,Pairing[l].times m n] ;
 module KC = Kronecker[l].Over[C,setC,m,n] ;
 module SC = FiniteIdeal[l].Sums[C] ;
 module DC = MnSums[l].Over[C] ;
 module MI = GN.MI ;

 -- (rows)  P_{1 (x) X} ~ P_X^m
 module Rows (X : KC.Mn.Mat) {
  module PN = GN.Glue[KC.kron KC.Mm.mone X] ;
  module PX = Gn.Glue[X] ;
  module Pi = SP.Over[A,Fin m,\ j -> PX.glued] ;
  block-member (Z : PN.Carrier) (j : Fin m) :
   Id Gn.VC.Vec (Gn.JB.map (\ i -> PN.right Z (KC.pair j i))) (Gn.VC.act X (Gn.JA.map (\ i -> PN.left Z (KC.pair j i)))) =
   Gn.VC.vec-eq _ _ (\ i -> trans (GN.VC.entry _ _ (PN.member Z) (KC.pair j i)) (KC.act-one-left X (GN.JA.map (PN.left Z)) j i)) ;
  blocks (Z : PN.Carrier) : Pi.Carrier = \ j ->
   PX.point (\ i -> PN.left Z (KC.pair j i)) (\ i -> PN.right Z (KC.pair j i)) (block-member Z j) ;
  module Join (y : Pi.Carrier) {
   u : GN.VAa.Vec = \ x -> PX.left (y (KC.first x)) (KC.second x) ;
   v : GN.VAb.Vec = \ x -> PX.right (y (KC.first x)) (KC.second x) ;
   u-block (j : Fin m) : Id Gn.VAa.Vec (\ i -> u (KC.pair j i)) (PX.left (y j)) =
    Gn.VAa.vec-eq _ _ (\ i -> ap (\ p -> PX.left (y p.1) p.2) (Pairing[l].unpair-pair n m j i)) ;
   v-block (j : Fin m) : Id Gn.VAb.Vec (\ i -> v (KC.pair j i)) (PX.right (y j)) =
    Gn.VAb.vec-eq _ _ (\ i -> ap (\ p -> PX.right (y p.1) p.2) (Pairing[l].unpair-pair n m j i)) ;
   member : Id GN.VC.Vec (GN.JB.map v) (GN.VC.act (KC.kron KC.Mm.mone X) (GN.JA.map u)) =
    KC.vec-pairs _ _ (\ j i -> calc C.R { jb.1 (v (KC.pair j i))
      =< Gn.VC.entry _ _ (ap Gn.JB.map (v-block j)) i > jb.1 (PX.right (y j) i)
      =< Gn.VC.entry _ _ (PX.member (y j)) i > Gn.VC.act X (Gn.JA.map (PX.left (y j))) i
      =< ap (\ t -> Gn.VC.act X (Gn.JA.map t) i) (sym (u-block j)) > Gn.VC.act X (Gn.JA.map (\ i' -> u (KC.pair j i'))) i
      =< sym (KC.act-one-left X (GN.JA.map u) j i) > GN.VC.act (KC.kron KC.Mm.mone X) (GN.JA.map u) (KC.pair j i) }) ;
   point : PN.Carrier = PN.point u v member ;
  } ;
  iso : MI.Iso[PN.glued,Pi.product] = MI.make PN.glued Pi.product blocks (\ y -> Join[y].point)
   (\ Z Z' -> Pi.ext _ _ (\ j -> PX.ext _ _
     (refl (\ i -> Aa.add (PN.left Z (KC.pair j i)) (PN.left Z' (KC.pair j i))))
     (refl (\ i -> Ab.add (PN.right Z (KC.pair j i)) (PN.right Z' (KC.pair j i))))))
   (\ r Z -> Pi.ext _ _ (\ j -> PX.ext _ _
     (refl (\ i -> Aa.mul (ia.1 r) (PN.left Z (KC.pair j i))))
     (refl (\ i -> Ab.mul (ib.1 r) (PN.right Z (KC.pair j i))))))
   (\ y -> Pi.ext _ _ (\ j -> PX.ext _ _ (Join[y].u-block j) (Join[y].v-block j)))
   (\ Z -> PN.ext _ _ (GN.VAa.vec-eq _ _ (\ x -> ap (PN.left Z) (KC.pu x))) (GN.VAb.vec-eq _ _ (\ x -> ap (PN.right Z) (KC.pu x)))) ;
 } ;

 -- (columns)  P_{Y (x) 1} ~ P_Y^n
 module Columns (Y : KC.Mm.Mat) {
  module PN = GN.Glue[KC.kron Y KC.Mn.mone] ;
  module PY = Gm.Glue[Y] ;
  module Pi = SP.Over[A,Fin n,\ i -> PY.glued] ;
  column-member (Z : PN.Carrier) (i : Fin n) :
   Id Gm.VC.Vec (Gm.JB.map (\ j -> PN.right Z (KC.pair j i))) (Gm.VC.act Y (Gm.JA.map (\ j -> PN.left Z (KC.pair j i)))) =
   Gm.VC.vec-eq _ _ (\ j -> trans (GN.VC.entry _ _ (PN.member Z) (KC.pair j i)) (KC.act-one-right Y (GN.JA.map (PN.left Z)) j i)) ;
  columns (Z : PN.Carrier) : Pi.Carrier = \ i ->
   PY.point (\ j -> PN.left Z (KC.pair j i)) (\ j -> PN.right Z (KC.pair j i)) (column-member Z i) ;
  module Join (y : Pi.Carrier) {
   u : GN.VAa.Vec = \ x -> PY.left (y (KC.second x)) (KC.first x) ;
   v : GN.VAb.Vec = \ x -> PY.right (y (KC.second x)) (KC.first x) ;
   u-column (i : Fin n) : Id Gm.VAa.Vec (\ j -> u (KC.pair j i)) (PY.left (y i)) =
    Gm.VAa.vec-eq _ _ (\ j -> ap (\ p -> PY.left (y p.2) p.1) (Pairing[l].unpair-pair n m j i)) ;
   v-column (i : Fin n) : Id Gm.VAb.Vec (\ j -> v (KC.pair j i)) (PY.right (y i)) =
    Gm.VAb.vec-eq _ _ (\ j -> ap (\ p -> PY.right (y p.2) p.1) (Pairing[l].unpair-pair n m j i)) ;
   member : Id GN.VC.Vec (GN.JB.map v) (GN.VC.act (KC.kron Y KC.Mn.mone) (GN.JA.map u)) =
    KC.vec-pairs _ _ (\ j i -> calc C.R { jb.1 (v (KC.pair j i))
      =< Gm.VC.entry _ _ (ap Gm.JB.map (v-column i)) j > jb.1 (PY.right (y i) j)
      =< Gm.VC.entry _ _ (PY.member (y i)) j > Gm.VC.act Y (Gm.JA.map (PY.left (y i))) j
      =< ap (\ t -> Gm.VC.act Y (Gm.JA.map t) j) (sym (u-column i)) > Gm.VC.act Y (Gm.JA.map (\ j' -> u (KC.pair j' i))) j
      =< sym (KC.act-one-right Y (GN.JA.map u) j i) > GN.VC.act (KC.kron Y KC.Mn.mone) (GN.JA.map u) (KC.pair j i) }) ;
   point : PN.Carrier = PN.point u v member ;
  } ;
  iso : MI.Iso[PN.glued,Pi.product] = MI.make PN.glued Pi.product columns (\ y -> Join[y].point)
   (\ Z Z' -> Pi.ext _ _ (\ i -> PY.ext _ _
     (refl (\ j -> Aa.add (PN.left Z (KC.pair j i)) (PN.left Z' (KC.pair j i))))
     (refl (\ j -> Ab.add (PN.right Z (KC.pair j i)) (PN.right Z' (KC.pair j i))))))
   (\ r Z -> Pi.ext _ _ (\ i -> PY.ext _ _
     (refl (\ j -> Aa.mul (ia.1 r) (PN.left Z (KC.pair j i))))
     (refl (\ j -> Ab.mul (ib.1 r) (PN.right Z (KC.pair j i))))))
   (\ y -> Pi.ext _ _ (\ i -> PY.ext _ _ (Join[y].u-column i) (Join[y].v-column i)))
   (\ Z -> PN.ext _ _ (GN.VAa.vec-eq _ _ (\ x -> ap (PN.left Z) (KC.pu x))) (GN.VAb.vec-eq _ _ (\ x -> ap (PN.right Z) (KC.pu x)))) ;
 } ;

 -- the assembly
 one-m : KC.Im.Inverse[KC.Mm.mone,KC.Mm.mone] =
  new KC.Im.Inverse[KC.Mm.mone,KC.Mm.mone,KC.Mm.m-one-left KC.Mm.mone,KC.Mm.m-one-left KC.Mm.mone] ;
 one-n : KC.In.Inverse[KC.Mn.mone,KC.Mn.mone] =
  new KC.In.Inverse[KC.Mn.mone,KC.Mn.mone,KC.Mn.m-one-left KC.Mn.mone,KC.Mn.m-one-left KC.Mn.mone] ;
 module Lemma (g g' : KC.Mn.Mat) (gi : KC.In.Inverse[g,g']) (h h' : KC.Mm.Mat) (hi : KC.Im.Inverse[h,h']) {
  module R = Rows[g] ;
  module K = Columns[h] ;
  G : KC.MN.Mat = KC.kron KC.Mm.mone g ;
  F : KC.MN.Mat = KC.kron h KC.Mn.mone ;
  module L = SS.Lemma[G,KC.kron KC.Mm.mone g',KC.kron-inverse KC.Mm.mone KC.Mm.mone one-m g g' gi,
   F,KC.kron h' KC.Mn.mone,KC.kron-inverse h h' hi KC.Mn.mone KC.Mn.mone one-n] ;
  -- (1 (x) g)(h (x) 1) = h (x) g
  product : Id KC.MN.Mat (KC.MN.mmul G F) (KC.kron h g) =
   trans (KC.mixed KC.Mm.mone h g KC.Mn.mone)
    (trans (ap (\ Z -> KC.kron Z (KC.Mn.mmul g KC.Mn.mone)) (KC.Mm.m-one-left h)) (ap (KC.kron h) (KC.Mn.m-one-right g))) ;
  module PK = GN.Glue[KC.kron h g] ;
  -- P_g^m + P_h^n  and  P_{h (x) g} + A^N
  Copies : MI.SA.Module = SP.Pair[A,R.Pi.product,K.Pi.product].product ;
  Target : MI.SA.Module = SP.Pair[A,PK.glued,SS.GF.free].product ;
  to-source : MI.Iso[Copies,L.Source] =
   MI.Sum[R.Pi.product,R.PN.glued,K.Pi.product,K.PN.glued,
    MI.inverse R.PN.glued R.Pi.product R.iso,MI.inverse K.PN.glued K.Pi.product K.iso].sum ;
  from-target : MI.Iso[L.Target,Target] =
   MI.Sum[L.Pgh.glued,PK.glued,SS.GF.free,SS.GF.free,GN.Equal[KC.kron h g,KC.MN.mmul G F,product].iso,
    MI.identity SS.GF.free].sum ;
  chain (s : MI.Iso[L.Source,L.Target]) : MI.Iso[Copies,Target] =
   MI.compose Copies L.Source Target to-source (MI.compose L.Source L.Target Target s from-target) ;
  theorem : Tr.Trunc[MI.Iso[Copies,Target]].carrier =
   TC.map (MI.Iso[L.Source,L.Target]) (MI.Iso[Copies,Target]) chain L.theorem ;
 } ;
} ;
