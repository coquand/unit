-- gabber-recollement.tex, Proposition `correct`, its K-theoretic core
-- for ordinary modules.  In the situation of CLASSKERNEL, let f be a
-- projector over A, N, kappa, n positive integers, and suppose that
--     x = kappa ([f] - N)
-- restricts to 0 in K_0(A_a) and in K_0(A_b) (K0RESTRICTION).  Then merely
-- there are e and R = (n kappa N) e and a projector S with
--     [S] + e x = R               in K_0(A)    (so S has rank R),
--     rho(f) rho(S)^n = 1         in K = K_0(A) (x) Q (RATIONAL),
-- where rho(F) = [F]/rank.  (For f = P(V'), this is the computation
-- rho(P(V' (x) S)) = rho(P(V')) rho(S)^n = 1 of the paper.)
--
-- Proof.  By Lemma 3.6(3) (CLASSKERNEL.Kernel), merely x = z with
-- z = [r] - L, r presenting P_g; z z = 0 by Lemma 3.6(2) (CLASSPRODUCT,
-- for g and g).  Take e = L + 1 and r' presenting P_(g'^e)
-- (GLUEDPROJECTOR): [r'] + e [r] = (e + 1) L by Lemma 3.6(1)
-- (CLASSSUM.Powers).  R = (n kappa N) e = L + D for some D, and
-- S = r' + 1_D has [S] = (e + 1) L - e [r] + D = R - e z.
-- In K put tau = rho(f) - 1.  Then iota z = iota x = kappa N tau, so
-- (kappa N)^2 tau tau = 0 and tau tau = 0 (kappa N is a unit).
-- rho(S) = (R - e kappa N tau)/R = 1 - tau/n, as R = n (e kappa N).  With
-- a = -tau/n, a a = 0, so rho(S)^n = 1 + n a = 1 - tau (RATIONAL.Binomial),
-- and rho(f) rho(S)^n = (1 + tau)(1 - tau) = 1 - tau tau = 1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier) {
 module CK = ClassKernel[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal] ;
 module K = CK.K ;
 module PJ = K.PJ ;
 module MI = K.MI ;
 module RK = RL[K.K0] ;
 module IK = Rational[l].Integers[K.K0] ;
 module RQ = Rational[l].Over[K.K0] ;
 module IQ = Rational[l].Integers[RQ.K] ;
 module LQ = RL[RQ.K] ;
 module AQ = AffineRing[l].Laws[RQ.K,RQ.Q.set] ;
 module PQ = AffinePowers[l].Over[RQ.K] ;
 module NM = Rational[l].NatMap[K.K0,RQ.K,RQ.iota] ;
 iota (u : K.K0.R) : RQ.K.R = RQ.iota.1 u ;
 -- in K_0: j w = nat j w, and [A^j] = nat j
 multiple-nat : (j : Nat) (w : K.K0.R) -> Id K.K0.R (K.multiple j w) (K.K0.mul (IK.nat j) w) = split {
  zero -> \ w -> sym (RK.zero-mul w) ;
  suc j | r -> \ w -> trans (ap (\ t -> K.K0.add t w) (r w))
   (trans (ap (K.K0.add (K.K0.mul (IK.nat j) w)) (sym (RK.one-left w))) (sym (RK.dist-left (IK.nat j) K.K0.o w))) } ;
 free-nat (j : Nat) : Id K.K0.R (K.free j) (IK.nat j) =
  trans (K.free-count j) (trans (multiple-nat j K.K0.o) (K.K0.mulO (IK.nat j))) ;
 -- (a + d) + (b + c) = ((a + b) + d) + c
 regroup (u d v c : K.K0.R) : Id K.K0.R (K.K0.add (K.K0.add u d) (K.K0.add v c)) (K.K0.add (K.K0.add (K.K0.add u v) d) c) =
  trans (K.K0.addA (K.K0.add u d) v c)
   (ap (\ t -> K.K0.add t c) (trans (sym (K.K0.addA u d v)) (trans (ap (K.K0.add u) (K.K0.addC d v)) (K.K0.addA u v d)))) ;
 -- ((u + l) + d) - u = l + d
 drop (u w : K.K0.R) : Id K.K0.R (K.K0.add (K.K0.add u w) (K.K0.neg u)) w =
  trans (ap (\ t -> K.K0.add t (K.K0.neg u)) (K.K0.addC u w)) (RK.add-neg-cancel w u) ;
 -- in K: a + (x - a) = x, (1 + t)(1 - t) = 1 - t t
 inner (s t : RQ.K.R) : Id RQ.K.R (RQ.K.add s (RQ.K.add t (RQ.K.neg s))) t =
  trans (LQ.add-swap s t (RQ.K.neg s)) (trans (ap (RQ.K.add t) (RQ.K.addN s)) (RQ.K.addZ t)) ;
 neg-square (u : RQ.K.R) : Id RQ.K.R (RQ.K.mul (RQ.K.neg u) (RQ.K.neg u)) (RQ.K.mul u u) =
  trans (LQ.neg-mul-left u (RQ.K.neg u)) (trans (ap RQ.K.neg (LQ.mul-neg u u)) (LQ.neg-neg (RQ.K.mul u u))) ;

 -- the corrector with its presenter written out: S = E + 1_Dd (Lemma.Result)
 standard (L Dd : Nat) (E : Vectors[l].Over[A,setA,plus L L].MR.Mat)
  (h : Id Vectors[l].Over[A,setA,plus L L].MR.Mat (Vectors[l].Over[A,setA,plus L L].MR.mmul E E) E) : PJ.Projector =
  K.sum (new PJ.Projector[plus L L,E,h]) PJ.Free[Dd].projector ;
 module Lemma (f : PJ.Projector) (N0 kappa0 n0 : Nat)
  (ha : Id CK.RA.KB.K0.R (CK.RA.restrict.1 (K.K0.mul (IK.nat (suc kappa0)) (K.K0.add (K.class f) (K.K0.neg (IK.nat (suc N0))))))
    CK.RA.KB.K0.z)
  (hb : Id CK.RB.KB.K0.R (CK.RB.restrict.1 (K.K0.mul (IK.nat (suc kappa0)) (K.K0.add (K.class f) (K.K0.neg (IK.nat (suc N0))))))
    CK.RB.KB.K0.z) {
  N : Nat = suc N0 ;
  kappa : Nat = suc kappa0 ;
  n : Nat = suc n0 ;
  y : K.K0.R = K.K0.add (K.class f) (K.K0.neg (IK.nat N)) ;
  x : K.K0.R = K.K0.mul (IK.nat kappa) y ;
  c : Nat = Pairing[l].times n (Pairing[l].times kappa N) ;
  -- rho(f) = [f]/N
  rho-f : RQ.K.R = RQ.rho (K.class f) (IK.nat N) (RQ.positive N0) ;
  -- what is asserted
  Witness : U l = (e : Nat) * (R0 : Nat) * (S : PJ.Projector) *
   Id Nat (Pairing[l].times c e) (suc R0) *
   Id K.K0.R (K.K0.add (K.class S) (K.K0.mul (IK.nat e) x)) (IK.nat (suc R0)) *
   Id RQ.K.R (RQ.K.mul rho-f (PQ.power (RQ.rho (K.class S) (IK.nat (suc R0)) (RQ.positive R0)) n)) RQ.K.o ;
  -- the corrector with its presenter: S = standard L Dd E, E of size L + L
  -- with E = alpha D alpha^-1 over A_a and E = beta'^-1 D beta' over A_b
  -- (GLUEDPROJECTOR.Explicit.Data, E-a, E-b)
  record Result {
   exponent : Nat ;
   rank0 : Nat ;
   half : Nat ;
   pad : Nat ;
   presenter : Vectors[l].Over[A,setA,plus half half].MR.Mat ;
   presenter-idem : Id Vectors[l].Over[A,setA,plus half half].MR.Mat
    (Vectors[l].Over[A,setA,plus half half].MR.mmul presenter presenter) presenter ;
   alpha : Vectors[l].Over[Aa,setAa,plus half half].MR.Mat ;
   alpha' : Vectors[l].Over[Aa,setAa,plus half half].MR.Mat ;
   alpha-inverse : MatrixMap[l].Invertible[Aa,setAa,plus half half].Inverse[alpha,alpha'] ;
   on-a : Id Vectors[l].Over[Aa,setAa,plus half half].MR.Mat (MatrixMap[l].Over[A,Aa,setA,setAa,ia,plus half half].map presenter)
    (Vectors[l].Over[Aa,setAa,plus half half].MR.mmul
     (Vectors[l].Over[Aa,setAa,plus half half].MR.mmul alpha VectorBlocks[l].Over[Aa,setAa,half].D) alpha') ;
   beta : Vectors[l].Over[Ab,setAb,plus half half].MR.Mat ;
   beta' : Vectors[l].Over[Ab,setAb,plus half half].MR.Mat ;
   beta-inverse : MatrixMap[l].Invertible[Ab,setAb,plus half half].Inverse[beta,beta'] ;
   on-b : Id Vectors[l].Over[Ab,setAb,plus half half].MR.Mat (MatrixMap[l].Over[A,Ab,setA,setAb,ib,plus half half].map presenter)
    (Vectors[l].Over[Ab,setAb,plus half half].MR.mmul
     (Vectors[l].Over[Ab,setAb,plus half half].MR.mmul beta' VectorBlocks[l].Over[Ab,setAb,half].D) beta) ;
   rank-eq : Id Nat (Pairing[l].times c exponent) (suc rank0) ;
   size-eq : Id Nat (plus half pad) (suc rank0) ;
   class-eq : Id K.K0.R (K.K0.add (K.class (standard half pad presenter presenter-idem)) (K.K0.mul (IK.nat exponent) x))
    (IK.nat (suc rank0)) ;
   final : Id RQ.K.R (RQ.K.mul rho-f (PQ.power (RQ.rho (K.class (standard half pad presenter presenter-idem))
    (IK.nat (suc rank0)) (RQ.positive rank0)) n)) RQ.K.o ;
  } ;
  -- c is positive
  k1 : Nat = (Rational[l].times-suc kappa0 N0).1 ;
  k2 : Nat = (Rational[l].times-suc n0 k1).1 ;
  hc : Id Nat c (suc k2) =
   trans (ap (Pairing[l].times n) (Rational[l].times-suc kappa0 N0).2) (Rational[l].times-suc n0 k1).2 ;

  module Given (L : Nat) (d : CK.Kernel[x,ha,hb].Datum L) {
   g : MnAlgebra[l].Over[C,setC,L].Mat = d.1 ;
   g' : MnAlgebra[l].Over[C,setC,L].Mat = d.2.1 ;
   gi : MatrixMap[l].Invertible[C,setC,L].Inverse[g,g'] = d.2.2.1 ;
   r : PJ.Projector = d.2.2.2.1 ;
   er : MI.Iso[K.image r,GluedModule[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,L].Glue[g].glued] = d.2.2.2.2.1 ;
   z : K.K0.R = K.K0.add (K.class r) (K.K0.neg (K.free L)) ;
   ex : Id K.K0.R x z = d.2.2.2.2.2 ;
   module CS = ClassSum[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,L] ;
   module CP = ClassProduct[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,L,L] ;
   -- z z = 0 (Lemma 3.6(2))
   square-zero : Id K.K0.R (K.K0.mul z z) K.K0.z = CP.Lemma[g,g',gi,g,g',gi,r,r,er,er].theorem ;
   e : Nat = suc L ;
   module PW = CS.Powers[g,g',gi,r,er] ;
   module EX = CS.GPM.Explicit[CS.power g' e,CS.copower g e,CS.power-inverse g' g PW.gi' e] ;
   -- R = c e = L + D
   R0 : Nat = (Rational[l].times-suc k2 L).1 ;
   D : Nat = suc (Pairing[l].times k2 (suc L)) ;
   hR : Id Nat (Pairing[l].times c e) (suc R0) =
    trans (ap (\ t -> Pairing[l].times t e) hc) (Rational[l].times-suc k2 L).2 ;
   hD : Id Nat (Pairing[l].times c e) (plus L D) =
    trans (ap (\ t -> Pairing[l].times t e) hc) (Rational[l].times-split k2 L) ;
   module With (t : EX.Presented) {
    r' : PJ.Projector = t.1 ;
    S : PJ.Projector = K.sum r' PJ.Free[D].projector ;
    l' : K.K0.R = IK.nat L ;
    q : K.K0.R = K.class r ;
    -- [r'] + e [r] = e L + L  (Lemma 3.6(1))
    power-eq : Id K.K0.R (K.K0.add (K.class r') (K.K0.mul (IK.nat e) q)) (K.K0.add (K.K0.mul (IK.nat e) l') l') =
     calc K.K0.R { K.K0.add (K.class r') (K.K0.mul (IK.nat e) q)
       =< ap (K.K0.add (K.class r')) (sym (multiple-nat e q)) > K.K0.add (K.class r') (K.multiple e q)
       =< PW.negative e r' t.2 > K.multiple (suc e) (K.free L)
       =< multiple-nat (suc e) (K.free L) > K.K0.mul (IK.nat (suc e)) (K.free L)
       =< ap (K.K0.mul (IK.nat (suc e))) (free-nat L) > K.K0.mul (IK.nat (suc e)) l'
       =< RK.dist-left (IK.nat e) K.K0.o l' > K.K0.add (K.K0.mul (IK.nat e) l') (K.K0.mul K.K0.o l')
       =< ap (K.K0.add (K.K0.mul (IK.nat e) l')) (RK.one-left l') > K.K0.add (K.K0.mul (IK.nat e) l') l' } ;
    -- [S] + e x = R
    class-S : Id K.K0.R (K.K0.add (K.class S) (K.K0.mul (IK.nat e) x)) (IK.nat (suc R0)) =
     calc K.K0.R { K.K0.add (K.class S) (K.K0.mul (IK.nat e) x)
       =< cong2 K.K0.R K.K0.add _ _ _ _ (trans (sym (K.class-sum r' PJ.Free[D].projector)) (ap (K.K0.add (K.class r')) (free-nat D)))
           (ap (K.K0.mul (IK.nat e)) (trans ex (ap (\ w -> K.K0.add q (K.K0.neg w)) (free-nat L)))) >
          K.K0.add (K.K0.add (K.class r') (IK.nat D)) (K.K0.mul (IK.nat e) (K.K0.add q (K.K0.neg l')))
       =< ap (K.K0.add (K.K0.add (K.class r') (IK.nat D)))
           (trans (K.K0.dist (IK.nat e) q (K.K0.neg l')) (ap (K.K0.add (K.K0.mul (IK.nat e) q)) (RK.mul-neg (IK.nat e) l'))) >
          K.K0.add (K.K0.add (K.class r') (IK.nat D)) (K.K0.add (K.K0.mul (IK.nat e) q) (K.K0.neg (K.K0.mul (IK.nat e) l')))
       =< regroup (K.class r') (IK.nat D) (K.K0.mul (IK.nat e) q) (K.K0.neg (K.K0.mul (IK.nat e) l')) >
          K.K0.add (K.K0.add (K.K0.add (K.class r') (K.K0.mul (IK.nat e) q)) (IK.nat D)) (K.K0.neg (K.K0.mul (IK.nat e) l'))
       =< ap (\ w -> K.K0.add (K.K0.add w (IK.nat D)) (K.K0.neg (K.K0.mul (IK.nat e) l'))) power-eq >
          K.K0.add (K.K0.add (K.K0.add (K.K0.mul (IK.nat e) l') l') (IK.nat D)) (K.K0.neg (K.K0.mul (IK.nat e) l'))
       =< ap (\ w -> K.K0.add w (K.K0.neg (K.K0.mul (IK.nat e) l'))) (sym (K.K0.addA (K.K0.mul (IK.nat e) l') l' (IK.nat D))) >
          K.K0.add (K.K0.add (K.K0.mul (IK.nat e) l') (K.K0.add l' (IK.nat D))) (K.K0.neg (K.K0.mul (IK.nat e) l'))
       =< drop (K.K0.mul (IK.nat e) l') (K.K0.add l' (IK.nat D)) > K.K0.add l' (IK.nat D)
       =< sym (IK.nat-plus L D) > IK.nat (plus L D)
       =< ap IK.nat (trans (sym hD) hR) > IK.nat (suc R0) } ;

    -- in K
    Nq : RQ.K.R = iota (IK.nat N) ;
    invN : RQ.K.R = RQ.inverse (IK.nat N) (RQ.positive N0) ;
    tau : RQ.K.R = RQ.K.add rho-f (RQ.K.neg RQ.K.o) ;
    w : RQ.K.R = RQ.K.mul (iota (IK.nat kappa)) Nq ;
    T : RQ.K.R = iota z ;
    -- N tau = [f] - N
    n-tau : Id RQ.K.R (RQ.K.mul Nq tau) (iota y) =
     calc RQ.K.R { RQ.K.mul Nq tau
       =< RQ.K.dist Nq rho-f (RQ.K.neg RQ.K.o) > RQ.K.add (RQ.K.mul Nq rho-f) (RQ.K.mul Nq (RQ.K.neg RQ.K.o))
       =< cong2 RQ.K.R RQ.K.add _ _ _ _
           (trans (LQ.mul-swap Nq (iota (K.class f)) invN)
            (trans (ap (RQ.K.mul (iota (K.class f))) (RQ.inverse-law (IK.nat N) (RQ.positive N0))) (RQ.K.mulO (iota (K.class f)))))
           (trans (LQ.mul-neg Nq RQ.K.o) (ap RQ.K.neg (RQ.K.mulO Nq))) >
          RQ.K.add (iota (K.class f)) (RQ.K.neg Nq)
       =< sym (trans (RQ.iota.2.2.1 (K.class f) (K.K0.neg (IK.nat N)))
           (ap (RQ.K.add (iota (K.class f))) (H.negation K.K0 RQ.K RQ.iota (IK.nat N)))) > iota y } ;
    -- iota z = kappa N tau
    T-tau : Id RQ.K.R T (RQ.K.mul w tau) =
     calc RQ.K.R { T
       =< ap iota (sym ex) > iota x
       =< RQ.iota.2.2.2 (IK.nat kappa) y > RQ.K.mul (iota (IK.nat kappa)) (iota y)
       =< ap (RQ.K.mul (iota (IK.nat kappa))) (sym n-tau) > RQ.K.mul (iota (IK.nat kappa)) (RQ.K.mul Nq tau)
       =< RQ.K.mulA (iota (IK.nat kappa)) Nq tau > RQ.K.mul w tau } ;
    -- tau tau = 0
    T-square : Id RQ.K.R (RQ.K.mul T T) RQ.K.z =
     trans (sym (RQ.iota.2.2.2 z z)) (trans (ap iota square-zero) (H.zero K.K0 RQ.K RQ.iota)) ;
    unit-w : LQ.unit w = AQ.unit-product (iota (IK.nat kappa)) Nq (RQ.unit (IK.nat kappa) (RQ.positive kappa0))
     (RQ.unit (IK.nat N) (RQ.positive N0)) ;
    tau-square : Id RQ.K.R (RQ.K.mul tau tau) RQ.K.z =
     LQ.unit-reg w (RQ.K.mul tau tau) unit-w
      (LQ.unit-reg w (RQ.K.mul w (RQ.K.mul tau tau)) unit-w
       (calc RQ.K.R { RQ.K.mul w (RQ.K.mul w (RQ.K.mul tau tau))
         =< RQ.K.mulA w w (RQ.K.mul tau tau) > RQ.K.mul (RQ.K.mul w w) (RQ.K.mul tau tau)
         =< LQ.mul-four w w tau tau > RQ.K.mul (RQ.K.mul w tau) (RQ.K.mul w tau)
         =< cong2 RQ.K.R RQ.K.mul _ _ _ _ (sym T-tau) (sym T-tau) > RQ.K.mul T T
         =< T-square > RQ.K.z })) ;
    -- rho(S) = 1 - tau/n
    Rn : K.K0.R = IK.nat (suc R0) ;
    invR : RQ.K.R = RQ.inverse Rn (RQ.positive R0) ;
    nq : RQ.K.R = iota (IK.nat n) ;
    invn : RQ.K.R = RQ.inverse (IK.nat n) (RQ.positive n0) ;
    eq : RQ.K.R = iota (IK.nat e) ;
    -- R = n (e (kappa N))
    R-split : Id RQ.K.R (iota Rn) (RQ.K.mul nq (RQ.K.mul eq w)) =
     calc RQ.K.R { iota Rn
       =< ap (\ k -> iota (IK.nat k)) (sym hR) > iota (IK.nat (Pairing[l].times c e))
       =< ap iota (trans (IK.nat-times c e) (ap (\ t -> K.K0.mul t (IK.nat e))
           (trans (IK.nat-times n (Pairing[l].times kappa N)) (ap (K.K0.mul (IK.nat n)) (IK.nat-times kappa N))))) >
          iota (K.K0.mul (K.K0.mul (IK.nat n) (K.K0.mul (IK.nat kappa) (IK.nat N))) (IK.nat e))
       =< trans (RQ.iota.2.2.2 (K.K0.mul (IK.nat n) (K.K0.mul (IK.nat kappa) (IK.nat N))) (IK.nat e))
           (ap (\ t -> RQ.K.mul t eq) (trans (RQ.iota.2.2.2 (IK.nat n) (K.K0.mul (IK.nat kappa) (IK.nat N)))
             (ap (RQ.K.mul nq) (RQ.iota.2.2.2 (IK.nat kappa) (IK.nat N))))) >
          RQ.K.mul (RQ.K.mul nq w) eq
       =< sym (RQ.K.mulA nq w eq) > RQ.K.mul nq (RQ.K.mul w eq)
       =< ap (RQ.K.mul nq) (RQ.K.mulC w eq) > RQ.K.mul nq (RQ.K.mul eq w) } ;
    -- (e T)/R = tau/n
    share : Id RQ.K.R (RQ.K.mul (RQ.K.mul eq T) invR) (RQ.K.mul tau invn) =
     calc RQ.K.R { RQ.K.mul (RQ.K.mul eq T) invR
       =< sym (LQ.one-left (RQ.K.mul (RQ.K.mul eq T) invR)) > RQ.K.mul RQ.K.o (RQ.K.mul (RQ.K.mul eq T) invR)
       =< ap (\ s -> RQ.K.mul s (RQ.K.mul (RQ.K.mul eq T) invR))
           (trans (sym (RQ.inverse-law (IK.nat n) (RQ.positive n0))) (RQ.K.mulC nq invn)) >
          RQ.K.mul (RQ.K.mul invn nq) (RQ.K.mul (RQ.K.mul eq T) invR)
       =< sym (RQ.K.mulA invn nq (RQ.K.mul (RQ.K.mul eq T) invR)) > RQ.K.mul invn (RQ.K.mul nq (RQ.K.mul (RQ.K.mul eq T) invR))
       =< ap (RQ.K.mul invn) (RQ.K.mulA nq (RQ.K.mul eq T) invR) > RQ.K.mul invn (RQ.K.mul (RQ.K.mul nq (RQ.K.mul eq T)) invR)
       =< ap (\ s -> RQ.K.mul invn (RQ.K.mul (RQ.K.mul nq s) invR))
           (trans (ap (RQ.K.mul eq) T-tau) (RQ.K.mulA eq w tau)) >
          RQ.K.mul invn (RQ.K.mul (RQ.K.mul nq (RQ.K.mul (RQ.K.mul eq w) tau)) invR)
       =< ap (\ s -> RQ.K.mul invn (RQ.K.mul s invR))
           (trans (RQ.K.mulA nq (RQ.K.mul eq w) tau) (ap (\ s -> RQ.K.mul s tau) (sym R-split))) >
          RQ.K.mul invn (RQ.K.mul (RQ.K.mul (iota Rn) tau) invR)
       =< ap (RQ.K.mul invn) (trans (trans (sym (RQ.K.mulA (iota Rn) tau invR)) (LQ.mul-swap (iota Rn) tau invR)) (trans (ap (RQ.K.mul tau) (RQ.inverse-law Rn (RQ.positive R0)))
           (RQ.K.mulO tau))) > RQ.K.mul invn tau
       =< RQ.K.mulC invn tau > RQ.K.mul tau invn } ;
    a' : RQ.K.R = RQ.K.neg (RQ.K.mul tau invn) ;
    rho-S : RQ.K.R = RQ.rho (K.class S) Rn (RQ.positive R0) ;
    -- [S] = R - e z
    S-eq : Id K.K0.R (K.class S) (K.K0.add Rn (K.K0.neg (K.K0.mul (IK.nat e) z))) =
     calc K.K0.R { K.class S
       =< sym (RK.add-neg-cancel (K.class S) (K.K0.mul (IK.nat e) z)) >
          K.K0.add (K.K0.add (K.class S) (K.K0.mul (IK.nat e) z)) (K.K0.neg (K.K0.mul (IK.nat e) z))
       =< ap (\ s -> K.K0.add (K.K0.add (K.class S) (K.K0.mul (IK.nat e) s)) (K.K0.neg (K.K0.mul (IK.nat e) z))) (sym ex) >
          K.K0.add (K.K0.add (K.class S) (K.K0.mul (IK.nat e) x)) (K.K0.neg (K.K0.mul (IK.nat e) z))
       =< ap (\ s -> K.K0.add s (K.K0.neg (K.K0.mul (IK.nat e) z))) class-S > K.K0.add Rn (K.K0.neg (K.K0.mul (IK.nat e) z)) } ;
    rho-S-eq : Id RQ.K.R rho-S (RQ.K.add RQ.K.o a') =
     calc RQ.K.R { RQ.K.mul (iota (K.class S)) invR
       =< ap (\ s -> RQ.K.mul (iota s) invR) S-eq > RQ.K.mul (iota (K.K0.add Rn (K.K0.neg (K.K0.mul (IK.nat e) z)))) invR
       =< ap (\ s -> RQ.K.mul s invR) (trans (RQ.iota.2.2.1 Rn (K.K0.neg (K.K0.mul (IK.nat e) z)))
           (ap (RQ.K.add (iota Rn)) (trans (H.negation K.K0 RQ.K RQ.iota (K.K0.mul (IK.nat e) z))
            (ap RQ.K.neg (RQ.iota.2.2.2 (IK.nat e) z))))) >
          RQ.K.mul (RQ.K.add (iota Rn) (RQ.K.neg (RQ.K.mul eq T))) invR
       =< LQ.dist-left (iota Rn) (RQ.K.neg (RQ.K.mul eq T)) invR >
          RQ.K.add (RQ.K.mul (iota Rn) invR) (RQ.K.mul (RQ.K.neg (RQ.K.mul eq T)) invR)
       =< cong2 RQ.K.R RQ.K.add _ _ _ _ (RQ.inverse-law Rn (RQ.positive R0))
           (trans (LQ.neg-mul-left (RQ.K.mul eq T) invR) (ap RQ.K.neg share)) > RQ.K.add RQ.K.o a' } ;
    a-square : Id RQ.K.R (RQ.K.mul a' a') RQ.K.z =
     calc RQ.K.R { RQ.K.mul a' a'
       =< neg-square (RQ.K.mul tau invn) > RQ.K.mul (RQ.K.mul tau invn) (RQ.K.mul tau invn)
       =< LQ.mul-four tau invn tau invn > RQ.K.mul (RQ.K.mul tau tau) (RQ.K.mul invn invn)
       =< ap (\ s -> RQ.K.mul s (RQ.K.mul invn invn)) tau-square > RQ.K.mul RQ.K.z (RQ.K.mul invn invn)
       =< LQ.zero-mul (RQ.K.mul invn invn) > RQ.K.z } ;
    -- rho(S)^n = 1 - tau
    power-S : Id RQ.K.R (PQ.power rho-S n) (RQ.K.add RQ.K.o (RQ.K.neg tau)) =
     calc RQ.K.R { PQ.power rho-S n
       =< ap (\ s -> PQ.power s n) rho-S-eq > PQ.power (RQ.K.add RQ.K.o a') n
       =< IQ.Binomial[a',a-square].power n > RQ.K.add RQ.K.o (RQ.K.mul (IQ.nat n) a')
       =< ap (\ s -> RQ.K.add RQ.K.o (RQ.K.mul s a')) (sym (NM.nat-map n)) > RQ.K.add RQ.K.o (RQ.K.mul nq a')
       =< ap (RQ.K.add RQ.K.o) (trans (LQ.mul-neg nq (RQ.K.mul tau invn))
           (ap RQ.K.neg (trans (LQ.mul-swap nq tau invn)
            (trans (ap (RQ.K.mul tau) (RQ.inverse-law (IK.nat n) (RQ.positive n0))) (RQ.K.mulO tau))))) >
          RQ.K.add RQ.K.o (RQ.K.neg tau) } ;
    -- rho(f) = 1 + tau
    rho-f-eq : Id RQ.K.R rho-f (RQ.K.add RQ.K.o tau) = sym (inner RQ.K.o rho-f) ;
    -- (1 + tau)(1 - tau) = 1
    final : Id RQ.K.R (RQ.K.mul rho-f (PQ.power rho-S n)) RQ.K.o =
     calc RQ.K.R { RQ.K.mul rho-f (PQ.power rho-S n)
       =< cong2 RQ.K.R RQ.K.mul _ _ _ _ rho-f-eq power-S > RQ.K.mul (RQ.K.add RQ.K.o tau) (RQ.K.add RQ.K.o (RQ.K.neg tau))
       =< LQ.dist-left RQ.K.o tau (RQ.K.add RQ.K.o (RQ.K.neg tau)) >
          RQ.K.add (RQ.K.mul RQ.K.o (RQ.K.add RQ.K.o (RQ.K.neg tau))) (RQ.K.mul tau (RQ.K.add RQ.K.o (RQ.K.neg tau)))
       =< cong2 RQ.K.R RQ.K.add _ _ _ _ (LQ.one-left (RQ.K.add RQ.K.o (RQ.K.neg tau)))
           (trans (RQ.K.dist tau RQ.K.o (RQ.K.neg tau))
            (cong2 RQ.K.R RQ.K.add _ _ _ _ (RQ.K.mulO tau)
             (trans (LQ.mul-neg tau tau) (trans (ap RQ.K.neg tau-square) LQ.neg-zero)))) >
          RQ.K.add (RQ.K.add RQ.K.o (RQ.K.neg tau)) (RQ.K.add tau RQ.K.z)
       =< ap (RQ.K.add (RQ.K.add RQ.K.o (RQ.K.neg tau))) (RQ.K.addZ tau) > RQ.K.add (RQ.K.add RQ.K.o (RQ.K.neg tau)) tau
       =< sym (RQ.K.addA RQ.K.o (RQ.K.neg tau) tau) > RQ.K.add RQ.K.o (RQ.K.add (RQ.K.neg tau) tau)
       =< ap (RQ.K.add RQ.K.o) (LQ.neg-cancel tau) > RQ.K.add RQ.K.o RQ.K.z
       =< RQ.K.addZ RQ.K.o > RQ.K.o } ;
    witness : Witness = (e,(R0,(S,(hR,(class-S,final))))) ;
   } ;
   witness : Tr.Trunc[Witness].carrier = TC.map EX.Presented Witness (\ t -> With[t].witness) EX.theorem ;
   -- the same, keeping the presenter
   module Local (dl : EX.DL.Result) {
    module DD = EX.Data[dl] ;
    module WT = With[(DD.projector,DD.iso)] ;
    result : Result = new Result[e,R0,L,D,DD.E,DD.E-idem,DD.alpha,DD.alpha',DD.ai,DD.E-a,DD.beta,DD.beta',DD.bi,DD.E-b,
     hR,trans (sym hD) hR,WT.class-S,WT.final] ;
   } ;
   explicit : Tr.Trunc[Result].carrier = TC.map EX.DL.Result Result (\ dl -> Local[dl].result) EX.DL.theorem ;
  } ;
  theorem : Tr.Trunc[Witness].carrier =
   TC.bind CK.Kernel[x,ha,hb].Witness Witness (\ v -> Given[v.1,v.2].witness) CK.Kernel[x,ha,hb].theorem ;
  explicit : Tr.Trunc[Result].carrier =
   TC.bind CK.Kernel[x,ha,hb].Witness Result (\ v -> Given[v.1,v.2].explicit) CK.Kernel[x,ha,hb].theorem ;
 } ;
} ;
