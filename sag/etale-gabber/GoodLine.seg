-- The base case of Theorem main (gabber-recollement).  On X = Spec Alg let G
-- be a family of R^x-gerbes with a point s x of each G x (on D(u_m) from the
-- gerbe datum), and Lambda a family of weight n.  The twisted line
-- L = Line(s = -) (TWISTEDLINE) gives P(L)^v = n-linear maps L^n -> Lambda,
-- of weight 0, descended (MULTILINEAR.Family.Dual).  The hypothesis
-- L^(x)n ~ Lambda says that the descended P(L)^v has a generator: a global
-- section sigma and a global form c with c_x(m) sigma(x) = m and
-- c_x(sigma(x)) = 1.  Then (REPRESENTATIONS.Trivial) P(L)^v is represented
-- by a projector of class 1 in K_0(Alg), and so is it by every representing
-- projector: L is good.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe) (s : (x : C.Spec Alg) -> (G x).1)
  (n : Nat) (Lambda : TM.Family[C.Spec Alg,G].Weighted (\ a -> TM.UG.power a n)) {
  module TL = TwistedLine[l].Over[R,setR].Family[C.Spec Alg,G,s] ;
  module PV = Multilinear[l].Over[R,setR].Family[C.Spec Alg,G].Dual[n,TL.twisted,Lambda] ;
  module RE = Representations[l].Over[R,setR,axioms].At[Alg,fp,PV.descended] ;
  module Good (sigma : RE.FP.Sections) (c : RE.FP.Forms)
   (law : (x : C.Spec Alg) (m : (PV.descended x).M) ->
     Id (PV.descended x).M
      (ModuleFiniteSums[l].Over[R,setR,PV.descended x].sum (suc zero) (\ k -> (PV.descended x).sm ((c x).1 m) (sigma x))) m)
   (unit : (x : C.Spec Alg) -> Id R.R ((c x).1 (sigma x)) R.o) {
   module T = RE.Trivial[sigma,c,law,unit] ;
   projector : RE.FP.PJ.Projector = T.FD.projector ;
   representation : RE.FP.Representation projector = T.FD.representation ;
   class-one : Id RE.K.K0.R (RE.K.class projector) RE.K.K0.o = T.class-one ;
   theorem (p : RE.FP.PJ.Projector) (rp : RE.FP.Representation p) : Id RE.K.K0.R (RE.K.class p) RE.K.K0.o = T.theorem p rp ;
  } ;
 } ;
} ;
