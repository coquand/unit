-- Moving families of modules along maps of the base (for the gluing in
-- Proposition `cheap`).  Families over Y with fibres Fib y: F y g a module.
--  (pull)   For phi : Y' -> Y, the power of the pulled-back family is the
--           pullback of the power: at (z, g) both are F (phi z) g + ... +
--           F (phi z) g (EFFACE.power), by induction on m.
--  (weight) Over banded groupoids (gerbes G x), a power of a twisted family is twisted: a sum of
--           two families of weight chi has weight chi: transport in V + W
--           is transport in each summand (J), the operations componentwise.
--  (move)   For propositions Da x, Db x and families F on (x : X) * Da x, F'
--           on (x : X) * Db x, with values in Fib x: one identity
--           F (x0, u0) = F' (x0, v0) gives F (x0, u) = F' (x0, v) for all u, v
--           (u = u0 and v = v0, as Da x0, Db x0 are propositions), and this
--           statement moves along a path x0 = x (J).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 -- (pull)
 module Pull (Y Y' : U l) (Fib : Y -> U l) (phi : Y' -> Y) {
  module FY = MS.Families[Y,Fib] ;
  module FZ = MS.Families[Y',\ z -> Fib (phi z)] ;
  pull (F : FY.Fam) : FZ.Fam = \ z g -> F (phi z) g ;
  power-at (F : FY.Fam) (z : Y') (g : Fib (phi z)) : (m : Nat) ->
   Id MD.Module (FZ.E.power m (pull F) z g) (FY.E.power m F (phi z) g) = split {
   zero -> refl (F (phi z) g) ;
   suc m | r -> Pr1.ap MD.Module MD.Module (MS.plus (F (phi z) g)) (FZ.E.power m (pull F) z g) (FY.E.power m F (phi z) g) r } ;
  power (F : FY.Fam) (m : Nat) : Id FZ.Fam (FZ.E.power m (pull F)) (pull (FY.E.power m F)) =
   FZ.pointwise (FZ.E.power m (pull F)) (pull (FY.E.power m F)) (\ z g -> power-at F z g m) ;
 } ;
 -- (weight)  transport in V + W is transport in each summand (J), and the
 -- operations of the sum are componentwise
 module Sum (B : TM.Banded) (chi : TM.UG.Unit -> TM.UG.Unit) (V W : B.1 -> MD.Module)
  (wv : TM.At[TM.charge (B)].Weight chi V) (ww : TM.At[TM.charge (B)].Weight chi W) {
  S (y : B.1) : MD.Module = MS.plus (V y) (W y) ;
  module MV = TM.At[TM.charge (B)].Move[V] ;
  module MW = TM.At[TM.charge (B)].Move[W] ;
  module MZ = TM.At[TM.charge (B)].Move[S] ;
  move-pair (y y' : B.1) (p : Id B.1 y y') (u : (S y).M) :
   Id (S y').M (MZ.move y y' p u) (MV.move y y' p u.1,MW.move y y' p u.2) =
   idJ B.1 y (\ z q -> Id (S z).M (MZ.move y z q u) (MV.move y z q u.1,MW.move y z q u.2)) (refl u) y' p ;
  weight : TM.At[TM.charge (B)].Weight chi S = \ y p u ->
   trans (move-pair y y p u) (MS.Pair[V y,W y].pair-eq _ _ _ _ (wv y p u.1) (ww y p u.2)) ;
 } ;
 module Powers (X : U l) (G : X -> TM.GB.AGerbe) {
  module TF = TM.Family[X,G] ;
  module FS = MS.Families[X,\ x -> (G x).1] ;
  weight (V : TF.Twisted) : (e : Nat) (x : X) -> TM.At[TM.charge (TM.banded (G x))].Weight TM.At[TM.charge (TM.banded (G x))].identity (FS.E.power e V.1 x) = split {
   zero -> V.2 ;
   suc e | w -> \ x -> Sum[TM.banded (G x),TM.At[TM.charge (TM.banded (G x))].identity,V.1 x,FS.E.power e V.1 x,V.2 x,w x].weight } ;
  power (V : TF.Twisted) (e : Nat) : TF.Twisted = (FS.E.power e V.1,weight V e) ;
 } ;
 -- (move)
 module Move (X : U l) (Fib : X -> U l+) (Da Db : X -> U l)
  (pa : (x : X) -> Pr.isProp (Da x)) (pb : (x : X) -> Pr.isProp (Db x))
  (F : (z : (x : X) * Da x) -> Fib z.1) (F' : (z : (x : X) * Db x) -> Fib z.1) {
  Statement (x : X) : U l+ = (u : Da x) (v : Db x) -> Id (Fib x) (F (x,u)) (F' (x,v)) ;
  at (x0 : X) (u0 : Da x0) (v0 : Db x0) (h : Id (Fib x0) (F (x0,u0)) (F' (x0,v0))) : Statement x0 =
   \ u v -> Pr1.trans (Fib x0) (F (x0,u)) (F (x0,u0)) (F' (x0,v))
    (Pr1.ap (Da x0) (Fib x0) (\ t -> F (x0,t)) u u0 (pa x0 u u0))
    (Pr1.trans (Fib x0) (F (x0,u0)) (F' (x0,v0)) (F' (x0,v)) h
     (Pr1.ap (Db x0) (Fib x0) (\ t -> F' (x0,t)) v0 v (pb x0 v0 v))) ;
  move (x0 x : X) (p : Id X x0 x) (s : Statement x0) : Statement x = idJ X x0 (\ x' q -> Statement x') s x p ;
 } ;
} ;
