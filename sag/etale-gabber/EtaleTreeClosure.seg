-- The closure for the topology generated by a sub-family e : J -> I of the
-- root generators (for instance UNRAMIFIABLE.J, the etale topology),
-- constructed at level l from the SAG axioms (no closure is assumed):
--     close P = || an etale tree over P || (ETALETREES).
--  (proposition)  a truncation.
--  (inc)          a leaf.
--  (elim)         into a J-sheaf proposition at any level: ETALETREEDESCENT.
--  (modal)        close P is a J-sheaf.  It is a proposition, so it suffices
--                 that G (e j) -> close P gives close P.  Write
--                 Root (e j) = Spec A, A = R[X]/(f) finitely presented
--                 (ETALEROOTS).  Every point x has merely a tree; by Z-choice
--                 there are merely g_1, .., g_n in A generating 1 and trees
--                 t_i x for the points x with g_i(x) invertible.  The tree
--                 root j (\ x -> zariski n (g(x)) _ (t x)) proves close P; the
--                 g_i(x) generate 1 at each x (AFFINECOVERS).  This is where a
--                 single tower would not do (the root topology's FLATTENING):
--                 the Zariski branching stays inside the tree.
--  (lex)          CLOSURELEX.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (J : U l) (e : J -> EtaleTopology[l].Over[R,setR].I) {
 module C = Algebras[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module TJ = SheafTopology[l].Over[J,\ j -> ET.G (e j)] ;
 module SJ = SheafLemmas[l,l].Over[J,\ j -> ET.G (e j)] ;
 module ETr = EtaleTrees[l].Over[R,setR,J,e] ;
 module CL = ClosureLex[l].Over[J,\ j -> ET.G (e j),\ j -> ET.G-prop (e j)] ;
 close (P : U l) : U l = Tr.Trunc[ETr.Trees[P].Cov].carrier ;
 proposition (P : U l) : Pr.isProp (close P) = Tr.Trunc[ETr.Trees[P].Cov].proposition ;
 -- (inc)
 module Leaf (P : U l) { open ETr.Trees[P] ; tree (p : P) : Cov = leaf p ; } ;
 inc (P : U l) (p : P) : close P = Tr.Trunc[ETr.Trees[P].Cov].inc (Leaf[P].tree p) ;
 -- (elim)
 elim : [k] (A : U l) (Q : U k) -> Prelude[k].isProp Q -> TJ.isModal @k Q -> (A -> Q) -> close A -> Q = <k> \ A Q pQ mQ f c ->
  Tr.Trunc[ETr.Trees[A].Cov].induction @k (\ t -> Q) (\ t -> pQ) (EtaleTreeDescent[l,k].Over[R,setR,J,e,A,Q,pQ,mQ,f].fold) c ;
 -- (modal)
 module Modal (P : U l) (j : J) (h : ET.G (e j) -> close P) {
  open ETr.Trees[P] ;
  module RS = EtaleRoots[l].Over[R,setR].Generator[e j].RootSpectrum ;
  Tree : U l = ETr.Trees[P].Cov ;
  local (x : C.Spec RS.B.A) : Tr.Trunc[Tree].carrier = h (ET.root-inc (e j) (RS.spec-root.1 x)) ;
  module Chosen (c : Ax.ChoiceData RS.B.A (\ x -> Tree)) {
   module Cover = AffineCovers[l].Over[R,setR,axioms.loc].At[RS.B.A,c.1,c.2.1] ;
   tree : Tree = root j (\ r ->
    zariski c.1 (\ i -> (RS.spec-root.2.sec r).1.1 (c.2.1 i)) (Cover.cover c.2.2.1 (RS.spec-root.2.sec r))
     (\ i u -> c.2.2.2 i (RS.spec-root.2.sec r) u)) ;
  } ;
  result : close P =
   Tr.Trunc[Ax.ChoiceData RS.B.A (\ x -> Tree)].induction @l (\ s -> close P) (\ s -> proposition P)
    (\ c -> Tr.Trunc[Tree].inc Chosen[c].tree) (axioms.zchoice RS.B.A RS.B.fp (\ x -> Tree) local) ;
 } ;
 modal (P : U l) : TJ.isModal @l (close P) =
  SJ.modal-of-sec (close P) (proposition P) (\ j h -> Modal[P,j,h].result) ;
 ops : SheafClosure[l,l].Over[J,\ j -> ET.G (e j)].Ops =
  new SheafClosure[l,l].Over[J,\ j -> ET.G (e j)].Ops[close,proposition,modal,inc,elim,CL.lex] ;
} ;
