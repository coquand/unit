-- rho along ring maps of K_0 (gabber-recollement, Propositions `cheap` and
-- `correct`).  Let h : K_0(A) -> K_0(B) be a ring map and N = N0 + 1.
--  (nat)  h(N) = N (RATIONAL.NatMap), so h(u - N) = h u - N and
--         h(c (u - N)) = c (h u - N).
--  (rho)  rho(u) = 1 at N gives merely (k + 1)(u - N) = 0
--         (TRANSPOSES.Rho.multiplier), so (k + 1)(h u - N) = 0, and
--         rho(h u) = 1 at N (TRANSPOSES.Rho.positive, equal, rho-one).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module TC = TruncationCombinators[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R)
 (h : H.Hom K0[l].Over[A,setA].K0 K0[l].Over[B,setB].K0) (N0 : Nat) {
 module KX = K0[l].Over[A,setA] ;
 module KY = K0[l].Over[B,setB] ;
 module TX = Transposes[l].Over[A,setA] ;
 module TY = Transposes[l].Over[B,setB] ;
 module RX = TX.Rho[N0] ;
 module RY = TY.Rho[N0] ;
 -- (nat)
 nat (k : Nat) : Id KY.K0.R (h.1 (TX.IK.nat k)) (TY.IK.nat k) = Rational[l].NatMap[KX.K0,KY.K0,h].nat-map k ;
 diff (u : KX.K0.R) : Id KY.K0.R (h.1 (RX.diff u)) (RY.diff (h.1 u)) =
  trans (h.2.2.1 u (KX.K0.neg RX.s))
   (ap (KY.K0.add (h.1 u)) (trans (H.negation KX.K0 KY.K0 h RX.s) (ap KY.K0.neg (nat (suc N0))))) ;
 multiple (c : Nat) (u : KX.K0.R) :
  Id KY.K0.R (h.1 (KX.K0.mul (TX.IK.nat c) (RX.diff u))) (KY.K0.mul (TY.IK.nat c) (RY.diff (h.1 u))) =
  trans (h.2.2.2 (TX.IK.nat c) (RX.diff u)) (cong2 KY.K0.R KY.K0.mul _ _ _ _ (nat c) (diff u)) ;
 -- (rho)
 scaled (u : KX.K0.R) (m : RX.Multiplier u) : Id KY.K0.R (KY.K0.mul (TY.IK.nat (suc m.1)) (RY.diff (h.1 u))) KY.K0.z =
  trans (sym (multiple (suc m.1) u)) (trans (ap h.1 m.2) (H.zero KX.K0 KY.K0 h)) ;
 theorem (u : KX.K0.R) (g : Id TX.RQ.K.R (RX.rho u) TX.RQ.K.o) : Id TY.RQ.K.R (RY.rho (h.1 u)) TY.RQ.K.o =
  TC.rec (RX.Multiplier u) @l (Id TY.RQ.K.R (RY.rho (h.1 u)) TY.RQ.K.o) (TY.RQ.Q.set _ _)
   (\ m -> RY.rho-one (h.1 u) (RY.equal (h.1 u) (RY.positive m.1 (h.1 u) (scaled u m))))
   (RX.multiplier u g) ;
} ;
