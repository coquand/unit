-- Etale trees over a proposition P, for a sub-family e : J -> I of the
-- generators of ETALETOPOLOGY (azumaya1, Theorem 3.1; dynalg, slide 38):
-- a leaf proves P; a root node adjoins a root of the polynomial e j; a
-- Zariski node branches over g_1, .., g_n, one of which is invertible.  All
-- data are small (Fin n, R, Root), so a tree over P : U l lies in U l.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (J : U l) (e : J -> EtaleTopology[l].Over[R,setR].I) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module Trees (P : U l) {
  data Cov : U l =
    leaf (p : P)
  | root (j : J) (t : ET.Root (e j) -> Cov)
  | zariski (n : Nat) (g : Fin n -> R.R) (c : Tr.Trunc[(i : Fin n) * RL[R].unit (g i)].carrier)
     (t : (i : Fin n) -> RL[R].unit (g i) -> Cov) ;
 } ;
} ;
