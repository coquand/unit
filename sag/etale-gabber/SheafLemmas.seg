-- Closure of sheaves (SheafTopology) under Pi, Sigma and identity types,
-- for types at level j.  Pi is pointwise.  Sigma factors the constant map
-- through Sigma (a) (G i -> B a) and the base change along the constant
-- map of A; identity types factor it through ap of the constant map of X
-- and happly.  The two facts about an equivalence e (ap e and base change
-- along e are equivalences) are by induction on e.
level l j ;
module Pk = Prelude[l \/ j] ;
module EQ = Equivalences[l \/ j] ;
module FLk = Axioms[l \/ j].FunExtLemmas[fe @(l \/ j)] ;
eqindk : (T : U (l \/ j)) (Mo : (T' : U (l \/ j)) -> Pk.Equiv T T' -> U (l \/ j)+) ->
 Mo T (Pk.idEquiv T) -> (T' : U (l \/ j)) (e : Pk.Equiv T T') -> Mo T' e = AlgebraPointsIdentity[l \/ j].eqind ;

-- ap of an equivalence is an equivalence
ap-id (X : U (l \/ j)) (x y : X) (p : Id X x y) : Id (Id X x y) (Pk.ap X X (\ a -> a) x y p) p =
 idJ X x (\ z q -> Id (Id X x z) (Pk.ap X X (\ a -> a) x z q) q) (refl (refl x)) y p ;
ap-equiv (X : U (l \/ j)) (Y : U (l \/ j)) (e : Pk.Equiv X Y) (x y : X)
 : Pk.isEquiv (Id X x y) (Id Y (e.1 x) (e.1 y)) (Pk.ap X Y e.1 x y) =
 eqindk X (\ Z d -> (x0 y0 : X) -> Pk.isEquiv (Id X x0 y0) (Id Z (d.1 x0) (d.1 y0)) (Pk.ap X Z d.1 x0 y0))
  (\ x0 y0 -> EQ.homotopy (Id X x0 y0) (Id X x0 y0) (Pk.idEquiv (Id X x0 y0))
    (Pk.ap X X (\ a -> a) x0 y0) (ap-id X x0 y0))
  Y e x y ;

-- base change of a family along an equivalence is an equivalence of totals
base (X : U (l \/ j)) (Y : U (l \/ j)) (e : Pk.Equiv X Y) (F : Y -> U (l \/ j))
 : Pk.isEquiv ((a : X) * F (e.1 a)) ((y : Y) * F y) (\ w -> (e.1 w.1,w.2)) =
 eqindk X (\ Z d -> (F0 : Z -> U (l \/ j)) ->
   Pk.isEquiv ((a : X) * F0 (d.1 a)) ((z : Z) * F0 z) (\ w -> (d.1 w.1,w.2)))
  (\ F0 -> Pk.qinv ((a : X) * F0 a) ((a : X) * F0 a) (\ w -> (w.1,w.2)) (\ w -> w)
    (\ w -> refl w) (\ w -> refl w))
  Y e F ;

module Over (I : U l) (G : I -> U l) {
 module T = SheafTopology[l].Over[I,G] ;

 modal-Pi (A : U j) (B : A -> U j) (hB : (a : A) -> T.isModal @j (B a))
  : T.isModal @j ((a : A) -> B a) = \ i ->
  Pk.qinv ((a : A) -> B a) (G i -> (a : A) -> B a) (\ f g -> f)
   (\ phi a -> (hB a i).sec (\ g -> phi g a))
   (\ phi -> FLk.funext (G i) (\ g -> (a : A) -> B a) _ phi (\ g ->
     FLk.funext A (\ a -> B a) _ (phi g) (\ a ->
      Pk.happly (G i) (\ g0 -> B a) _ (\ g0 -> phi g0 a) ((hB a i).sec-eq (\ g0 -> phi g0 a)) g)))
   (\ f -> FLk.funext A (\ a -> B a) _ f (\ a -> Pk.sec-ret (B a) (G i -> B a) (\ x g -> x) (hB a i) (f a))) ;

 modal-Sigma (A : U j) (B : A -> U j) (hA : T.isModal @j A) (hB : (a : A) -> T.isModal @j (B a))
  : T.isModal @j ((a : A) * B a) = \ i ->
  EQ.homotopy ((a : A) * B a) (G i -> (a : A) * B a)
   (EQ.compose ((a : A) * B a) ((a : A) * (G i -> B a)) (G i -> (a : A) * B a)
    (\ w -> (w.1,\ g -> w.2),
     Pk.qinv ((a : A) * B a) ((a : A) * (G i -> B a)) (\ w -> (w.1,\ g -> w.2))
      (\ w -> (w.1,(hB w.1 i).sec w.2))
      (\ w -> Pk.ap (G i -> B w.1) ((a : A) * (G i -> B a)) (\ v -> (w.1,v)) _ _ ((hB w.1 i).sec-eq w.2))
      (\ w -> Pk.ap (B w.1) ((a : A) * B a) (\ v -> (w.1,v)) _ _
        (Pk.sec-ret (B w.1) (G i -> B w.1) (\ x g -> x) (hB w.1 i) w.2)))
    (EQ.compose ((a : A) * (G i -> B a)) ((al : G i -> A) * ((g : G i) -> B (al g))) (G i -> (a : A) * B a)
     (\ w -> (\ g -> w.1,w.2),
      base A (G i -> A) (\ x g -> x,hA i) (\ al -> (g : G i) -> B (al g)))
     (\ w g -> (w.1 g,w.2 g),
      Pk.qinv ((al : G i -> A) * ((g : G i) -> B (al g))) (G i -> (a : A) * B a) (\ w g -> (w.1 g,w.2 g))
       (\ phi -> (\ g -> (phi g).1,\ g -> (phi g).2)) (\ phi -> refl phi) (\ w -> refl w))))
   (\ w g -> w) (\ w -> refl (\ g -> w)) ;

 modal-Id (X : U j) (hX : T.isModal @j X) (x y : X) : T.isModal @j (Id X x y) = \ i ->
  EQ.homotopy (Id X x y) (G i -> Id X x y)
   (EQ.compose (Id X x y) (Id (G i -> X) (\ g -> x) (\ g -> y)) (G i -> Id X x y)
    (Pk.ap X (G i -> X) (\ x0 g -> x0) x y, ap-equiv X (G i -> X) (\ x0 g -> x0,hX i) x y)
    (Pk.happly (G i) (\ g -> X) (\ g -> x) (\ g -> y), fe @(l \/ j) (G i) (\ g -> X) (\ g -> x) (\ g -> y)))
   (\ p g -> p)
   (\ p -> idJ X x (\ z q -> Id (G i -> Id X x z) (\ g -> q)
      (Pk.happly (G i) (\ g -> X) (\ g -> x) (\ g -> z) (Pk.ap X (G i -> X) (\ x0 g -> x0) x z q)))
     (refl (\ g -> refl x)) y p) ;

 -- a retract of a sheaf is a sheaf
 modal-retract (A Bt : U j) (s : Bt -> A) (r : A -> Bt) (rs : (b : Bt) -> Id Bt (r (s b)) b)
  (hA : T.isModal @j A) : T.isModal @j Bt = \ i ->
  Pk.qinv Bt (G i -> Bt) (\ b g -> b) (\ phi -> r ((hA i).sec (\ g -> s (phi g))))
   (\ phi -> Pk.trans (G i -> Bt) _ (\ g -> r (s (phi g))) phi
     (Pk.ap (G i -> A) (G i -> Bt) (\ psi g -> r (psi g)) _ _ ((hA i).sec-eq (\ g -> s (phi g))))
     (FLk.funext (G i) (\ g -> Bt) _ phi (\ g -> rs (phi g))))
   (\ b -> Pk.trans Bt _ (r (s b)) b
     (Pk.ap A Bt r _ _ (Pk.sec-ret A (G i -> A) (\ x g -> x) (hA i) (s b))) (rs b)) ;
 -- a proposition with a section of every constant map is a sheaf
 modal-of-sec (P : U j) (h : (x y : P) -> Id P x y) (sigma : (i : I) -> (G i -> P) -> P) : T.isModal @j P = \ i ->
  Pk.qinv P (G i -> P) (\ x g -> x) (sigma i)
   (\ phi -> FLk.funext (G i) (\ g -> P) _ phi (\ g -> h (sigma i phi) (phi g)))
   (\ x -> h (sigma i (\ g -> x)) x) ;

 -- being a proposition is a sheaf condition on a sheaf
 modal-isProp (P : U j) (hP : T.isModal @j P) : T.isModal @j ((x y : P) -> Id P x y) =
  modal-Pi P (\ x -> (y : P) -> Id P x y) (\ x -> modal-Pi P (\ y -> Id P x y) (\ y -> modal-Id P hP x y)) ;
} ;
