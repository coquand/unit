-- Column vectors Fin N -> R and the action of N x N matrices on them,
--     (X u)_i = sum_k X_ik u_k        (the combination lin of FINITEIDEAL).
-- The action is additive and commutes with scalars, 1 u = u, and
-- X (Y u) = (X Y) u by exchange of a double sum, as for the associativity
-- of MNALGEBRA.  A ring map f acts entrywise, with f (X u) = f(X) f(u).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (N : Nat) {
 module S = FiniteIdeal[l].Sums[R] ;
 module D = MnSums[l].Over[R] ;
 module MR = MnAlgebra[l].Over[R,setR,N] ;
 Vec : U l = Fin N -> R.R ;
 set-vec : Pr.isSet Vec = F.isSet-Pi (Fin N) (\ i -> R.R) (\ i -> setR) ;
 vec-eq (u v : Vec) (h : (i : Fin N) -> Id R.R (u i) (v i)) : Id Vec u v =
  F.funext (Fin N) (\ i -> R.R) u v h ;
 entry (u v : Vec) (p : Id Vec u v) (i : Fin N) : Id R.R (u i) (v i) = Pr.happly (Fin N) (\ i -> R.R) u v p i ;
 vzero : Vec = \ i -> R.z ;
 vadd (u v : Vec) : Vec = \ i -> R.add (u i) (v i) ;
 vneg (u : Vec) : Vec = \ i -> R.neg (u i) ;
 vscale (c : R.R) (u : Vec) : Vec = \ i -> R.mul c (u i) ;
 act (X : MR.Mat) (u : Vec) : Vec = \ i -> S.lin N (X i) u ;
 act-at (X : MR.Mat) (u : Vec) (i : Fin N) : Id R.R (act X u i) (S.lin N (X i) u) = refl (act X u i) ;
 act-add (X : MR.Mat) (u v : Vec) : Id Vec (act X (vadd u v)) (vadd (act X u) (act X v)) =
  vec-eq (act X (vadd u v)) (vadd (act X u) (act X v)) (\ i -> S.lin-add N (X i) u v) ;
 act-scale (X : MR.Mat) (c : R.R) (u : Vec) : Id Vec (act X (vscale c u)) (vscale c (act X u)) =
  vec-eq (act X (vscale c u)) (vscale c (act X u)) (\ i -> S.lin-scale N (X i) u c) ;
 act-zero (X : MR.Mat) : Id Vec (act X vzero) vzero = vec-eq (act X vzero) vzero (\ i -> S.lin-zero N (X i)) ;
 act-neg (X : MR.Mat) (u : Vec) : Id Vec (act X (vneg u)) (vneg (act X u)) =
  vec-eq (act X (vneg u)) (vneg (act X u)) (\ i -> S.lin-neg N (X i) u) ;
 act-one (u : Vec) : Id Vec (act MR.mone u) u = vec-eq (act MR.mone u) u (\ i -> D.sum-delta N i u) ;
 -- (X (Y u))_i = ((X Y) u)_i
 act-mul-at (X Y : MR.Mat) (u : Vec) (i : Fin N) : Id R.R (act X (act Y u) i) (act (MR.mmul X Y) u i) =
  calc R.R {
   S.sum N (\ k -> R.mul (X i k) (S.sum N (\ m -> R.mul (Y k m) (u m))))
    =< S.sum-cong N _ (\ k -> S.sum N (\ m -> R.mul (X i k) (R.mul (Y k m) (u m))))
        (\ k -> sym (S.sum-scale (X i k) N (\ m -> R.mul (Y k m) (u m)))) >
   S.sum N (\ k -> S.sum N (\ m -> R.mul (X i k) (R.mul (Y k m) (u m))))
    =< D.exchange N N (\ k m -> R.mul (X i k) (R.mul (Y k m) (u m))) >
   S.sum N (\ m -> S.sum N (\ k -> R.mul (X i k) (R.mul (Y k m) (u m))))
    =< S.sum-cong N _ (\ m -> S.sum N (\ k -> R.mul (R.mul (X i k) (Y k m)) (u m)))
        (\ m -> S.sum-cong N _ _ (\ k -> R.mulA (X i k) (Y k m) (u m))) >
   S.sum N (\ m -> S.sum N (\ k -> R.mul (R.mul (X i k) (Y k m)) (u m)))
    =< S.sum-cong N _ _ (\ m -> D.sum-scale-right (u m) N (\ k -> R.mul (X i k) (Y k m))) >
   S.sum N (\ m -> R.mul (MR.mmul X Y i m) (u m)) } ;
 act-mul (X Y : MR.Mat) (u : Vec) : Id Vec (act X (act Y u)) (act (MR.mmul X Y) u) =
  vec-eq (act X (act Y u)) (act (MR.mmul X Y) u) (act-mul-at X Y u) ;
 -- matrices acting alike are equal: act X on the j-th unit vector is the column j
 mat-act (X Y : MR.Mat) (h : (w : Vec) -> Id Vec (act X w) (act Y w)) : Id MR.Mat X Y =
  MR.mat-eq X Y (\ i j -> trans (sym (D.sum-delta-right N j (X i)))
   (trans (entry _ _ (h (\ k -> D.delta N k j)) i) (D.sum-delta-right N j (Y i)))) ;
 -- X' (X u) = u when X' X = 1
 act-cancel (X X' : MR.Mat) (h : Id MR.Mat (MR.mmul X' X) MR.mone) (u : Vec) : Id Vec (act X' (act X u)) u =
  trans (act-mul X' X u) (trans (ap (\ Z -> act Z u) h) (act-one u)) ;
 -- sums, negatives and the zero matrix act termwise
 act-madd (X Y : MR.Mat) (u : Vec) : Id Vec (act (MR.madd X Y) u) (vadd (act X u) (act Y u)) =
  vec-eq (act (MR.madd X Y) u) (vadd (act X u) (act Y u)) (\ i ->
   trans (S.sum-cong N (\ k -> R.mul (MR.madd X Y i k) (u k)) (\ k -> R.add (R.mul (X i k) (u k)) (R.mul (Y i k) (u k)))
     (\ k -> RL[R].dist-left (X i k) (Y i k) (u k)))
    (S.sum-add N (\ k -> R.mul (X i k) (u k)) (\ k -> R.mul (Y i k) (u k)))) ;
 act-mneg (X : MR.Mat) (u : Vec) : Id Vec (act (MR.mneg X) u) (vneg (act X u)) =
  vec-eq (act (MR.mneg X) u) (vneg (act X u)) (\ i ->
   trans (S.sum-cong N (\ k -> R.mul (MR.mneg X i k) (u k)) (\ k -> R.mul (X i k) (R.neg (u k)))
     (\ k -> trans (RL[R].neg-mul-left (X i k) (u k)) (sym (RL[R].mul-neg (X i k) (u k)))))
    (S.lin-neg N (X i) u)) ;
 act-mzero (u : Vec) : Id Vec (act MR.mzero u) vzero =
  vec-eq (act MR.mzero u) vzero (\ i ->
   trans (S.sum-cong N (\ k -> R.mul R.z (u k)) (\ k -> R.z) (\ k -> RL[R].zero-mul (u k))) (S.sum-zero N)) ;
} ;
module Map (X Y : CRing) (setX : Pr.isSet X.R) (setY : Pr.isSet Y.R) (f : H.Hom X Y) (N : Nat) {
 module VX = Over[X,setX,N] ;
 module VY = Over[Y,setY,N] ;
 module MM = MatrixMap[l].Over[X,Y,setX,setY,f,N] ;
 map (u : VX.Vec) : VY.Vec = \ i -> f.1 (u i) ;
 map-at (u : VX.Vec) (i : Fin N) : Id Y.R (map u i) (f.1 (u i)) = refl (f.1 (u i)) ;
 map-add (u v : VX.Vec) : Id VY.Vec (map (VX.vadd u v)) (VY.vadd (map u) (map v)) =
  VY.vec-eq (map (VX.vadd u v)) (VY.vadd (map u) (map v)) (\ i -> f.2.2.1 (u i) (v i)) ;
 map-scale (c : X.R) (u : VX.Vec) : Id VY.Vec (map (VX.vscale c u)) (VY.vscale (f.1 c) (map u)) =
  VY.vec-eq (map (VX.vscale c u)) (VY.vscale (f.1 c) (map u)) (\ i -> f.2.2.2 c (u i)) ;
 map-zero : Id VY.Vec (map VX.vzero) VY.vzero = VY.vec-eq (map VX.vzero) VY.vzero (\ i -> H.zero X Y f) ;
 map-neg (u : VX.Vec) : Id VY.Vec (map (VX.vneg u)) (VY.vneg (map u)) =
  VY.vec-eq (map (VX.vneg u)) (VY.vneg (map u)) (\ i -> H.negation X Y f (u i)) ;
 map-act (A : MM.MX.Mat) (u : VX.Vec) : Id VY.Vec (map (VX.act A u)) (VY.act (MM.map A) (map u)) =
  VY.vec-eq (map (VX.act A u)) (VY.act (MM.map A) (map u)) (\ i ->
   trans (MatrixMap[l].hom-sum X Y f N (\ k -> X.mul (A i k) (u k)))
    (FiniteIdeal[l].Sums[Y].sum-cong N (\ k -> f.1 (X.mul (A i k) (u k)))
     (\ k -> Y.mul (f.1 (A i k)) (f.1 (u k))) (\ k -> f.2.2.2 (A i k) (u k)))) ;
} ;
