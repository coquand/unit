-- Hilbert 90 for the root topology (GABBER-PROPER-DESIGN.md, section 1): an
-- R^x-pre-torsor T (free transitive action, no inhabitation; LINEASSOCIATED)
-- whose carrier is a sheaf and which is inhabited locally (close T) is merely
-- inhabited.
--  (line)    L = equivariant f : T -> R with f(a t) = a^-1 f(t) (the
--            associated line).  It is a sheaf: a Sigma of a Pi into the sheaf
--            R (ETALERING.R-local) and of identities in R.
--  (local)   At a point t0, v |-> extend(v_0) is a linear equivalence
--            R^1 -> L (evaluation at t0 is its inverse, LINEASSOCIATED.Based),
--            hence a frame of rank 1 (DESCENTFRAMES).  So close T gives
--            close (frame of rank 1), and DESCENTTHEOREMD merely gives a
--            frame w of rank 1.
--  (fixed)   For f = w_0, Fixed = (t : T) * (f t = 1) is a proposition: if
--            f t = f t' = 1 and a t = t', then 1 = a^-1 . 1, so a = 1 and
--            t' = t.  It is a sheaf (T and R are).  At a point t, expanding
--            extend(1) (Based at t) in the frame gives c with c f(t) = 1, so
--            u = f(t) is a unit and f(u t) = u^-1 u = 1.  Hence close T gives
--            close Fixed, so Fixed (a sheaf proposition), so ||T||.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module S0 = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module LA = LineAssociated[l].Over[R,setR] ;
 module G = LA.G ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module DF = DescentFrames[l].Over[R,setR,axioms.loc] ;
 module One = HomSums[l].Over[R,setR].One ;
 -- (line), (local) and the fixed points: everything but the two sheaf
 -- conditions on T, so that a coarser topology can supply them (ETALEGABBER)
 module Line (T : LA.PreTor) {
  module LT = LA.Line.At[T] ;
  L : MD.Module = LT.associated ;
  act (a : G.Unit) (t : T.1) : T.1 = T.2.1 a t ;
  -- (line)
  line-sheaf : ET.T.isModal @l L.M =
   S0.modal-Sigma (T.1 -> R.R) LT.Cond (S0.modal-Pi T.1 (\ t -> R.R) (\ t -> ER.R-local)) (\ f ->
    S0.modal-Pi G.Unit (\ a -> (t : T.1) -> Id R.R (f (act a t)) (R.mul (G.inverse a).1 (f t))) (\ a ->
     S0.modal-Pi T.1 (\ t -> Id R.R (f (act a t)) (R.mul (G.inverse a).1 (f t))) (\ t ->
      S0.modal-Id R.R ER.R-local (f (act a t)) (R.mul (G.inverse a).1 (f t))))) ;
  -- (local)
  module Local (t0 : T.1) {
   module B = LT.Based[t0] ;
   map (v : (DL.Free (suc zero)).M) : L.M = B.extend (One.at v) ;
   map-add (v v' : (DL.Free (suc zero)).M) :
    Id L.M (map ((DL.Free (suc zero)).madd v v')) (L.madd (map v) (map v')) =
    LT.equal _ _ (\ t -> R.dist (B.ratio t).1 (One.at v) (One.at v')) ;
   map-scale (c : R.R) (v : (DL.Free (suc zero)).M) :
    Id L.M (map ((DL.Free (suc zero)).sm c v)) (L.sm c (map v)) =
    LT.equal _ _ (\ t -> RL[R].mul-swap (B.ratio t).1 c (One.at v)) ;
   equivalence : Pr.isEquiv (DL.Free (suc zero)).M L.M map =
    Pr.qinv (DL.Free (suc zero)).M L.M map (\ f -> One.constant (f.1 t0)) B.eta
     (\ v -> F.funext (Fin (suc zero)) (\ i -> R.R) _ v (\ i -> trans (B.beta (One.at v)) (One.points v i))) ;
   frame : DL.On[L].Frame (suc zero) = DF.Rank[suc zero].Map[L,map,map-add,map-scale].from-equiv equivalence ;
  } ;
  local-frame (local : sh.close T.1) : sh.close (DL.On[L].Frame (suc zero)) =
   sh.elim @l T.1 (sh.close (DL.On[L].Frame (suc zero)))
    (sh.proposition (DL.On[L].Frame (suc zero))) (sh.modal (DL.On[L].Frame (suc zero)))
    (\ t -> sh.inc (DL.On[L].Frame (suc zero)) Local[t].frame) local ;
  frames (local : sh.close T.1) : Tr.Trunc[DL.On[L].Frame (suc zero)].carrier =
   DescentTheoremD[l].Over[R,setR,axioms,sh].At[L,line-sheaf,suc zero,local-frame local].theorem ;
  -- (fixed)
  module Fixed (w : DL.On[L].Frame (suc zero)) {
   f : L.M = w.1 (inr tt) ;
   Point : U l = (t : T.1) * Id R.R (f.1 t) R.o ;
   -- a t = t' and f t = f t' = 1 give a = 1
   module Two (t t' : Point) {
    a : G.Unit = (T.2.2.2.2.2 t.1 t'.1).1.1 ;
    moved : Id T.1 (act a t.1) t'.1 = (T.2.2.2.2.2 t.1 t'.1).1.2 ;
    inverse-one : Id R.R a.2.1 R.o =
     calc R.R { a.2.1 =< sym (R.mulO a.2.1) > R.mul a.2.1 R.o
       =< ap (R.mul a.2.1) (sym t.2) > R.mul a.2.1 (f.1 t.1)
       =< sym (f.2 a t.1) > f.1 (act a t.1)
       =< ap f.1 moved > f.1 t'.1
       =< t'.2 > R.o } ;
    one : Id G.Unit a G.one =
     G.eq a G.one (trans (sym (R.mulO a.1)) (trans (ap (R.mul a.1) (sym inverse-one)) a.2.2)) ;
    equal : Id T.1 t.1 t'.1 =
     trans (sym (T.2.2.2.2.1 t.1)) (trans (ap (\ b -> act b t.1) (sym one)) moved) ;
   } ;
   prop : Pr.isProp Point = \ t t' ->
    Pr.Sigma-eq T.1 (\ s -> Id R.R (f.1 s) R.o) t.1 t'.1 t.2 t'.2 Two[t,t'].equal (setR _ _) ;
   -- at a point t: c f(t) = 1, and f(f(t) t) = 1
   module Near (t : T.1) {
    module B = LT.Based[t] ;
    c : (DL.Free (suc zero)).M = w.2.sec (B.extend R.o) ;
    expansion : Id L.M (DL.On[L].lin (suc zero) w.1 c) (B.extend R.o) = w.2.sec-eq (B.extend R.o) ;
    inverse : Id R.R (R.mul (f.1 t) (One.at c)) R.o =
     calc R.R { R.mul (f.1 t) (One.at c) =< R.mulC (f.1 t) (One.at c) > R.mul (One.at c) (f.1 t)
       =< sym (R.addZ (R.mul (One.at c) (f.1 t))) > R.add (R.mul (One.at c) (f.1 t)) R.z
       =< ap (\ g -> g.1 t) (trans (sym (DL.On[L].lin-value (suc zero) w.1 c)) expansion) > (B.extend R.o).1 t
       =< B.beta R.o > R.o } ;
    u : G.Unit = (f.1 t,One.at c,inverse) ;
    point : Point = (act u t,trans (f.2 u t) (trans (R.mulC (One.at c) (f.1 t)) inverse)) ;
   } ;
  } ;
 } ;
 module At (T : LA.PreTor) (sheaf : ET.T.isModal @l T.1) (local : sh.close T.1) {
  module LN = Line[T] ;
  point-sheaf (w : DL.On[LN.L].Frame (suc zero)) : ET.T.isModal @l LN.Fixed[w].Point =
   S0.modal-Sigma T.1 (\ s -> Id R.R (LN.Fixed[w].f.1 s) R.o) sheaf (\ s -> S0.modal-Id R.R ER.R-local (LN.Fixed[w].f.1 s) R.o) ;
  fixed (w : DL.On[LN.L].Frame (suc zero)) : LN.Fixed[w].Point =
   sh.elim @l T.1 LN.Fixed[w].Point LN.Fixed[w].prop (point-sheaf w) (\ t -> LN.Fixed[w].Near[t].point) local ;
  theorem : Tr.Trunc[T.1].carrier =
   Tr.Trunc[DL.On[LN.L].Frame (suc zero)].induction @l (\ z -> Tr.Trunc[T.1].carrier) (\ z -> Tr.Trunc[T.1].proposition)
    (\ w -> Tr.Trunc[T.1].inc (fixed w).1) (LN.frames local) ;
 } ;
} ;
