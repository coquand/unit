-- Pointwise solutions of a linear equation between families of modules on
-- an affine X have a merely global solution, when the families are weakly
-- QC: the family version of chatelet/DESCENTLIFT, with the same proof.
-- For f_x : P x -> Q x linear and s x in Q x, the solutions
--     T x = { v in P x | f_x v = s x }
-- form a torsor under the kernel K x = ker f_x (v |-> k + v; two solutions
-- differ by an element of K x, uniquely), merely inhabited by hypothesis;
-- K x is weakly QC (DESCENTKERNEL), so 7.1.8 holds for K (RESTRICTION718)
-- and the torsor has a section (SAG 7.3.6, DESCENTTHEOREM736).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module A7 = Alg73[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module PQ = DescentPointQC[l].Over[MD.ring] ;
 module At (X : U l) (aff : FunctionAlgebra[l].Over[R,setR].Affine X)
  (P Q : X -> MD.Module) (f : (x : X) -> SM.Linear (P x) (Q x))
  (wP : (x : X) -> MD.WeaklyQC (P x)) (wQ : (x : X) -> MD.WeaklyQC (Q x))
  (s : (x : X) -> (Q x).M) (inh : (x : X) -> Tr.Trunc[(v : (P x).M) * Id (Q x).M ((f x).1 v) (s x)].carrier) {
  module Pt (x : X) {
   module L = SM.Lin[P x,Q x,f x] ;
   module MP = A7.MA[MD.ring,P x] ; module MQ = A7.MA[MD.ring,Q x] ;
   module Ker = SM.Kernel[P x,Q x,f x] ; module KS = SM.Sub[P x,Ker.sub] ;
   wK : MD.WeaklyQC KS.carrier = PQ.At[KS.carrier].to-aff
    DescentKernel[l].Over[MD.ring].At[P x,Q x,f x,PQ.At[P x].from-aff (wP x),PQ.At[Q x].from-aff (wQ x)].theorem ;
   sub-add (v w : (P x).M) : Id (P x).M ((P x).madd (MP.sub v w) w) v =
    trans (sym ((P x).maddA v ((P x).mneg w) w))
     (trans (ap ((P x).madd v) (trans ((P x).maddC ((P x).mneg w) w) ((P x).maddN w))) ((P x).maddZ v)) ;
   add-sub (k v w : (P x).M) (h : Id (P x).M ((P x).madd k w) v) : Id (P x).M k (MP.sub v w) =
    trans (sym ((P x).maddZ k))
     (trans (ap ((P x).madd k) (sym ((P x).maddN w)))
      (trans ((P x).maddA k w ((P x).mneg w)) (ap (\ t -> (P x).madd t ((P x).mneg w)) h))) ;
  } ;
  Mx (x : X) : MD.Module = Pt[x].KS.carrier ;
  module Af = Affine[l].Aff[MD.ring,X,Mx] ;
  T (x : X) : U l = (v : (P x).M) * Id (Q x).M ((f x).1 v) (s x) ;
  equal (x : X) (t t' : T x) (h : Id (P x).M t.1 t'.1) : Id (T x) t t' =
   Pr.Sigma-eq (P x).M (\ v -> Id (Q x).M ((f x).1 v) (s x)) t.1 t'.1 t.2 t'.2 h ((Q x).setM _ _) ;
  set (x : X) : Pr.isSet (T x) =
   Pr.isSet-Sigma (P x).M (\ v -> Id (Q x).M ((f x).1 v) (s x)) (P x).setM (\ v -> Pr.prop-to-set _ ((Q x).setM _ _)) ;
  act (x : X) (k : Pt[x].KS.E) (t : T x) : T x =
   ((P x).madd k.1 t.1,trans ((f x).2.1 k.1 t.1)
    (trans (ap (\ y -> (Q x).madd y ((f x).1 t.1)) k.2) (trans (Pt[x].MQ.mzl ((f x).1 t.1)) t.2))) ;
  diff (x : X) (t t' : T x) : Pt[x].KS.E =
   (Pt[x].MP.sub t'.1 t.1,trans (Pt[x].L.map-sub t'.1 t.1)
    (trans (ap (\ y -> Pt[x].MQ.sub y ((f x).1 t.1)) (trans t'.2 (sym t.2))) (Pt[x].MQ.sub-self ((f x).1 t.1)))) ;
  Moves (x : X) (t t' : T x) : U l = (k : Pt[x].KS.E) * Id (T x) (act x k t) t' ;
  centre (x : X) (t t' : T x) : Moves x t t' = (diff x t t',equal x _ _ (Pt[x].sub-add t'.1 t.1)) ;
  contract (x : X) (t t' : T x) (z : Moves x t t') : Id (Moves x t t') (centre x t t') z =
   Pr.Sigma-eq Pt[x].KS.E (\ k -> Id (T x) (act x k t) t') _ _ _ _
    (Pt[x].KS.eq _ _ (sym (Pt[x].add-sub z.1.1 t'.1 t.1 (ap (\ v -> v.1) z.2)))) (set x _ _) ;
  structure (x : X) : Torsor[l].TorBase[Af.ab x].TorStr (T x) =
   (act x,set x,
    \ a b t -> equal x _ _ (sym ((P x).maddA a.1 b.1 t.1)),
    \ t -> equal x _ _ (Pt[x].MP.mzl t.1),
    \ t t' -> (centre x t t',contract x t t'),inh x) ;
  restriction : MD.Restriction X Mx =
   Restriction718[l].Over[R,setR,axioms].At[X,
    SchemeBasics[l].Over[R,setR].affine X aff,Mx,\ x -> Pt[x].wK].theorem-7-1-8 ;
  theorem : Tr.Trunc[(x : X) -> T x].carrier =
   DescentTheorem736[l].Over[R,setR,axioms].Torsors[X,Mx,restriction,T,structure].affine aff ;
  opaque theorem ;
 } ;
} ;
