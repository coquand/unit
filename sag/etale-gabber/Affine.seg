-- Affine.seg: SAG Theorem 7.3.6, H^1(X, M) = 0 for X = Spec A affine and
-- M weakly quasi-coherent: every M-torsor T on X merely has a section.
--
-- Setting.  R a commutative ring, X a type, M x an R-module for x : X;
-- functions X -> R play the role of A (SQC), and D(g) x is "g x is a
-- unit".  The hypotheses are
--   Loc       1 /= 0, and a + b a unit gives merely a or b a unit;
--   Z-choice  a family of inhabited types merely has sections over the
--             D(f k) of unimodular f 1 .. f n : X -> R;
--   WQC       M(X)_g = M(D(g)) for g : X -> R (Lemma 7.1.8 with U = X),
--             in elements: every section over D(g) is merely m / g^N
--             with m : M(X), and a global m vanishing on D(g) is merely
--             killed by a power of g.
-- Proof (SAG).  Z-choice gives local sections s i over D(f i).  The
-- differences t i j = s i - s j over D(f i f j) are merely m i j / (f i f j)^N
-- (finite choice and a common bound N).  The cocycle identity holds on
-- D(f i f j f k); by WQC its numerator is killed by a power of f i f j f k.
-- At each point x, Lemma 7.3.5 (Alg73) gives u i = V i / (f i)^p with
-- u i - u j = t i j, so the sections (-u i) . s i agree on overlaps and
-- glue (Lemma 1.2.2), the D(f i) covering X by Loc.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Torsor[l] ;
open FinChoice[l] ;
open Alg73[l] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

data Or (A B : U l) : U l = inl (a : A) | inr (b : B) ;

module ModAb (Rg : CRing) (Md : Mod[Rg]) {
  open Md ;
  ab : Ab = mkAb M setM mz madd mneg (\ x y w -> symH (maddA x y w)) maddC maddZ maddN ;
} ;

------------------------------------------------------------------------
-- computations at one point

module RU (Rg : CRing) {
  open Rg ;
  open RA[Rg] ;
  unit-prop (a : R) : isProp (unit a) = \ u v ->
    Sigma-eq R (\ y -> Id R (mul a y) o) u.1 v.1 u.2 v.2 (inv-uniq a u.1 v.1 u.2 v.2) (setR (mul a v.1) o) ;
  zero-mul (y : R) : Id R (mul z y) z = transH (mulC z y) (mul-zero y) ;
  inv-part (P a G w : R) (q : Id R (mul P a) G) (h : Id R (mul G w) o) : Id R (mul P (mul a w)) o =
    transH (mulA P a w) (transH (apH (\ t -> mul t w) q) h) ;

} ;

module PtL (Rg : CRing) (Md : Mod[Rg]) {
  open Rg ;
  open RA[Rg] ;
  open Md ;
  open MA[Rg,Md] ;
  open RU[Rg] ;

  -- y^q (g^q v) = v  when  g y = 1
  cancel-pw (g y : R) (h : Id R (mul g y) o) (q : Nat) (v : M) : Id M (sm (pw y q) (sm (pw g q) v)) v =
    transH (smA (pw y q) (pw g q) v)
      (transH (apH (\ t -> sm t v) (transH (mulC (pw y q) (pw g q)) (unit-pw g y h q))) (smO v)) ;
  -- y^(d+n) (g^d v) = y^n v
  raise (g y : R) (h : Id R (mul g y) o) (d n : Nat) (v : M)
    : Id M (sm (pw y (plusN d n)) (sm (pw g d) v)) (sm (pw y n) v) = calc M {
    sm (pw y (plusN d n)) (sm (pw g d) v)
      =< apH (\ t -> sm t (sm (pw g d) v)) (pw-add y d n) > sm (mul (pw y d) (pw y n)) (sm (pw g d) v)
      =< symH (smA (pw y d) (pw y n) (sm (pw g d) v)) > sm (pw y d) (sm (pw y n) (sm (pw g d) v))
      =< apH (sm (pw y d)) (sm-swap (pw y n) (pw g d) v) > sm (pw y d) (sm (pw g d) (sm (pw y n) v))
      =< cancel-pw g y h d (sm (pw y n) v) > sm (pw y n) v } ;
  -- G^N ((a w)^N v) = a^N v  when  G w = 1
  lift (G a w : R) (h : Id R (mul G w) o) (N : Nat) (v : M)
    : Id M (sm (pw G N) (sm (pw (mul a w) N) v)) (sm (pw a N) v) =
    transH (smA (pw G N) (pw (mul a w) N) v)
      (apH (\ t -> sm t v) (transH (symH (pw-mul G (mul a w) N))
         (apH (\ t -> pw t N) (transH (mul-swap G a w) (transH (apH (mul a) h) (mulO a)))))) ;

  -- X - (Z + X) + Z = 0
  coc-alg (X Z : M) : Id M (madd (sub X (madd Z X)) Z) mz = calc M {
    madd (madd X (mneg (madd Z X))) Z
      =< apH (\ t -> madd (madd X t) Z) (neg-add Z X) > madd (madd X (madd (mneg Z) (mneg X))) Z
      =< apH (\ t -> madd (madd X t) Z) (maddC (mneg Z) (mneg X)) > madd (madd X (madd (mneg X) (mneg Z))) Z
      =< apH (\ t -> madd t Z) (maddA X (mneg X) (mneg Z)) > madd (madd (madd X (mneg X)) (mneg Z)) Z
      =< apH (\ t -> madd (madd t (mneg Z)) Z) (maddN X) > madd (madd mz (mneg Z)) Z
      =< apH (\ t -> madd t Z) (mzl (mneg Z)) > madd (mneg Z) Z
      =< maddC (mneg Z) Z > madd Z (mneg Z)
      =< maddN Z > mz } ;
  -- (-a) + (a - b) = -b
  negsub-alg (a b : M) : Id M (madd (mneg a) (sub a b)) (mneg b) = calc M {
    madd (mneg a) (madd a (mneg b)) =< maddA (mneg a) a (mneg b) > madd (madd (mneg a) a) (mneg b)
      =< apH (\ t -> madd t (mneg b)) (transH (maddC (mneg a) a) (maddN a)) > madd mz (mneg b)
      =< mzl (mneg b) > mneg b } ;

  cancel2 (ya yb b : R) (hb : Id R (mul b yb) o) (p : Nat) (v : M)
    : Id M (sm (pw (mul ya yb) p) (sm (pw b p) v)) (sm (pw ya p) v) = calc M {
    sm (pw (mul ya yb) p) (sm (pw b p) v)
      =< apH (\ t -> sm t (sm (pw b p) v)) (pw-mul ya yb p) > sm (mul (pw ya p) (pw yb p)) (sm (pw b p) v)
      =< symH (smA (pw ya p) (pw yb p) (sm (pw b p) v)) > sm (pw ya p) (sm (pw yb p) (sm (pw b p) v))
      =< apH (sm (pw ya p)) (cancel-pw b yb hb p v) > sm (pw ya p) v } ;
  cancel2' (ya yb a : R) (ha : Id R (mul a ya) o) (p : Nat) (v : M)
    : Id M (sm (pw (mul ya yb) p) (sm (pw a p) v)) (sm (pw yb p) v) =
    transH (apH (\ t -> sm (pw t p) (sm (pw a p) v)) (mulC ya yb)) (cancel2 yb ya a ha p v) ;

  -- from the conclusion of Lemma 7.3.5 at invertible a, b:
  --   V i / a^p - V j / b^p = m / (a b)^N
  module Compat (a b ya yb : R) (ha : Id R (mul a ya) o) (hb : Id R (mul b yb) o) (p N : Nat)
    (Vi Vj m : M) (e : FEq (mul a b) (sub (sm (pw b p) Vi) (sm (pw a p) Vj)) p m N) {
    G : R = mul a b ;
    yG : R = mul ya yb ;
    hG : Id R (mul G yG) o = unit-mul a b ya yb ha hb ;
    num : M = sub (sm (pw b p) Vi) (sm (pw a p) Vj) ;
    E : Id M (sm (pw G N) num) (sm (pw G p) m) =
      sub-zero (sm (pw G N) num) (sm (pw G p) m)
        (unit-kill (pw G e.1) (pw yG e.1) (unit-pw G yG hG e.1) (sub (sm (pw G N) num) (sm (pw G p) m)) e.2) ;
    eq : Id M (sub (sm (pw ya p) Vi) (sm (pw yb p) Vj)) (sm (pw yG N) m) = calc M {
      sub (sm (pw ya p) Vi) (sm (pw yb p) Vj)
        =< apH (\ t -> sub t (sm (pw yb p) Vj)) (symH (cancel2 ya yb b hb p Vi))
        > sub (sm (pw yG p) (sm (pw b p) Vi)) (sm (pw yb p) Vj)
        =< apH (sub (sm (pw yG p) (sm (pw b p) Vi))) (symH (cancel2' ya yb a ha p Vj))
        > sub (sm (pw yG p) (sm (pw b p) Vi)) (sm (pw yG p) (sm (pw a p) Vj))
        =< symH (sm-sub (pw yG p) (sm (pw b p) Vi) (sm (pw a p) Vj)) > sm (pw yG p) num
        =< apH (sm (pw yG p)) (symH (cancel-pw G yG hG N num)) > sm (pw yG p) (sm (pw yG N) (sm (pw G N) num))
        =< apH (\ t -> sm (pw yG p) (sm (pw yG N) t)) E > sm (pw yG p) (sm (pw yG N) (sm (pw G p) m))
        =< sm-swap (pw yG p) (pw yG N) (sm (pw G p) m) > sm (pw yG N) (sm (pw yG p) (sm (pw G p) m))
        =< apH (sm (pw yG N)) (cancel-pw G yG hG p m) > sm (pw yG N) m } ;
  } ;
} ;

------------------------------------------------------------------------
-- the theorem

module Aff (Rg : CRing) (X : U l) (Mx : X -> Mod[Rg]) {
  open Rg ;
  open RA[Rg] ;
  M (x : X) : U l = (Mx x).M ;
  ab (x : X) : Ab = ModAb[Rg, Mx x].ab ;
  sumR (n : Nat) (h : Fin n -> R) : R = Reg[Rg].sumR n h ;
  Dg (g : X -> R) (x : X) : U l = unit (g x) ;

  LocR : U l = (one-nz : Id R o z -> Empty) *
    ((a b : R) -> unit (add a b) -> Tr.Trunc[Or (unit a) (unit b)].carrier) ;
  ZC (B : X -> U l) : U l = (n : Nat) * (f : Fin n -> X -> R) * (r : Fin n -> X -> R)
    * (unim : (x : X) -> Id R (sumR n (\ k -> mul (r k x) (f k x))) o)
    * ((k : Fin n) (x : X) -> Dg (f k) x -> B x) ;
  ZChoice : U l+ = (B : X -> U l) -> ((x : X) -> Tr.Trunc[B x].carrier) -> Tr.Trunc[ZC B].carrier ;
  Rep (g : X -> R) (s : (x : X) -> Dg g x -> M x) : U l =
    (m : (x : X) -> M x) * (N : Nat) *
    ((x : X) (d : Dg g x) -> Id (M x) (s x d) ((Mx x).sm (pw d.1 N) (m x))) ;
  Kill (g : X -> R) (m : (x : X) -> M x) : U l =
    (K : Nat) * ((x : X) -> Id (M x) ((Mx x).sm (pw (g x) K) (m x)) (Mx x).mz) ;
  WQC : U l = (g : X -> R) ->
    ((s : (x : X) -> Dg g x -> M x) -> Tr.Trunc[Rep g s].carrier) *
    ((m : (x : X) -> M x) -> ((x : X) -> Dg g x -> Id (M x) (m x) (Mx x).mz) -> Tr.Trunc[Kill g m].carrier) ;

  module Thm (lc : LocR) (zc : ZChoice) (wq : WQC)
    (T : X -> U l) (ts : (x : X) -> TorBase[ab x].TorStr (T x)) {

    -- Loc for finite sums
    or-case (n : Nat) (h : Fin (suc n) -> R)
      (rec : unit (sumR n (\ k -> h (some k))) -> Tr.Trunc[(k : Fin n) * unit (h (some k))].carrier)
      : Or (unit (h none)) (unit (sumR n (\ k -> h (some k)))) -> Tr.Trunc[(k : Fin (suc n)) * unit (h k)].carrier = split {
      inl a -> Tr.Trunc[(k : Fin (suc n)) * unit (h k)].inc (none, a) ;
      inr b -> Tr.Trunc[(k : Fin n) * unit (h (some k))].induction @l
        (\ v -> Tr.Trunc[(k : Fin (suc n)) * unit (h k)].carrier)
        (\ v -> Tr.Trunc[(k : Fin (suc n)) * unit (h k)].proposition)
        (\ ka -> Tr.Trunc[(k : Fin (suc n)) * unit (h k)].inc (some ka.1, ka.2))
        (rec b) } ;
    loc-fin : (n : Nat) (h : Fin n -> R) -> unit (sumR n h) -> Tr.Trunc[(k : Fin n) * unit (h k)].carrier = split {
      zero -> \ h u -> absurd (Tr.Trunc[(k : Fin zero) * unit (h k)].carrier)
                        (lc.1 (transH (symH u.2) (RU[Rg].zero-mul u.1))) ;
      suc n | rec -> \ h u ->
        Tr.Trunc[Or (unit (h none)) (unit (sumR n (\ k -> h (some k))))].induction @l
          (\ v -> Tr.Trunc[(k : Fin (suc n)) * unit (h k)].carrier)
          (\ v -> Tr.Trunc[(k : Fin (suc n)) * unit (h k)].proposition)
          (or-case n h (rec (\ k -> h (some k))))
          (lc.2 (h none) (sumR n (\ k -> h (some k))) u) } ;

    -- the D(f k) cover X
    cover (n : Nat) (f r : Fin n -> X -> R) (unim : (x : X) -> Id R (sumR n (\ k -> mul (r k x) (f k x))) o)
      (x : X) : Tr.Trunc[(k : Fin n) * Dg (f k) x].carrier =
      Tr.Trunc[(k : Fin n) * unit (mul (r k x) (f k x))].induction @l
        (\ v -> Tr.Trunc[(k : Fin n) * Dg (f k) x].carrier)
        (\ v -> Tr.Trunc[(k : Fin n) * Dg (f k) x].proposition)
        (\ ku -> Tr.Trunc[(k : Fin n) * Dg (f k) x].inc
           (ku.1, (mul (r ku.1 x) ku.2.1, unit-r (r ku.1 x) (f ku.1 x) ku.2.1 ku.2.2)))
        (loc-fin n (\ k -> mul (r k x) (f k x))
           (o, transH (mulO (sumR n (\ k -> mul (r k x) (f k x)))) (unim x))) ;

    -- the torsor at x
    act (x : X) : M x -> T x -> T x = (ts x).1 ;
    sT (x : X) : isSet (T x) = (ts x).2.1 ;
    ad (x : X) (a b : M x) (t : T x) : Id (T x) (act x ((Mx x).madd a b) t) (act x a (act x b t)) = (ts x).2.2.1 a b t ;
    diff (x : X) (t t' : T x) : M x = TorBase[ab x].D[T x, ts x].diff t t' ;
    dact (x : X) (t t' : T x) : Id (T x) (act x (diff x t t') t) t' = TorBase[ab x].D[T x, ts x].dact t t' ;
    -- c - a = (b - a) + (c - b)
    diff-comp (x : X) (a b c : T x) : Id (M x) (diff x c a) ((Mx x).madd (diff x b a) (diff x c b)) =
      TorBase[ab x].D[T x, ts x].uniq c a ((Mx x).madd (diff x b a) (diff x c b))
        (transH (ad x (diff x b a) (diff x c b) c)
           (transH (apH (act x (diff x b a)) (dact x c b)) (dact x b a))) ;
    -- (b - c) - (a - c) + (a - b) = 0
    tor-coc (x : X) (a b c : T x)
      : Id (M x) ((Mx x).madd (MA[Rg, Mx x].sub (diff x c b) (diff x c a)) (diff x b a)) (Mx x).mz =
      transH (apH (\ e -> (Mx x).madd (MA[Rg, Mx x].sub (diff x c b) e) (diff x b a)) (diff-comp x a b c))
        (PtL[Rg, Mx x].coc-alg (diff x c b) (diff x b a)) ;

    module Data (n : Nat) (f r : Fin n -> X -> R)
      (unim : (x : X) -> Id R (sumR n (\ k -> mul (r k x) (f k x))) o)
      (s : (k : Fin n) (x : X) -> Dg (f k) x -> T x) {
      fij (i j : Fin n) (x : X) : R = mul (f i x) (f j x) ;
      h3 (i j k : Fin n) (x : X) : R = mul (mul (f i x) (f j x)) (f k x) ;
      dL (i j : Fin n) (x : X) (d : Dg (fij i j) x) : Dg (f i) x = (mul (f j x) d.1, unit-l (f i x) (f j x) d.1 d.2) ;
      dR (i j : Fin n) (x : X) (d : Dg (fij i j) x) : Dg (f j) x = (mul (f i x) d.1, unit-r (f i x) (f j x) d.1 d.2) ;
      -- t i j = s i - s j  on D(f i f j)
      t' (i j : Fin n) (x : X) (di : Dg (f i) x) (dj : Dg (f j) x) : M x = diff x (s j x dj) (s i x di) ;
      t (i j : Fin n) (x : X) (d : Dg (fij i j) x) : M x = t' i j x (dL i j x d) (dR i j x d) ;
      tirr (i j : Fin n) (x : X) (di di' : Dg (f i) x) (dj dj' : Dg (f j) x)
        : Id (M x) (t' i j x di dj) (t' i j x di' dj') =
        transH (apH (\ d -> t' i j x d dj) (RU[Rg].unit-prop (f i x) di di'))
               (apH (\ d -> t' i j x di' d) (RU[Rg].unit-prop (f j x) dj dj')) ;

      rep-tr : Tr.Trunc[(i j : Fin n) -> Rep (fij i j) (t i j)].carrier =
        fc n (\ i -> (j : Fin n) -> Rep (fij i j) (t i j))
          (\ i -> fc n (\ j -> Rep (fij i j) (t i j)) (\ j -> (wq (fij i j)).1 (t i j))) ;

      module Data2 (rp : (i j : Fin n) -> Rep (fij i j) (t i j)) {
        B2 : Bnd2 n (\ i j -> (rp i j).2.1) = bound2 n (\ i j -> (rp i j).2.1) ;
        N : Nat = B2.1 ;
        m' (i j : Fin n) (x : X) : M x = (Mx x).sm (pw (fij i j x) (B2.2 i j).1) ((rp i j).1 x) ;
        rep' (i j : Fin n) (x : X) (d : Dg (fij i j) x) : Id (M x) (t i j x d) ((Mx x).sm (pw d.1 N) (m' i j x)) =
          transH ((rp i j).2.2 x d)
            (symH (substH (\ q -> Id (M x) ((Mx x).sm (pw d.1 q) (m' i j x)) ((Mx x).sm (pw d.1 (rp i j).2.1) ((rp i j).1 x)))
                     (B2.2 i j).2
                     (PtL[Rg, Mx x].raise (fij i j x) d.1 d.2 (B2.2 i j).1 (rp i j).2.1 ((rp i j).1 x)))) ;

        -- the cocycle numerator  (s j k - s i k + s i j) (f i f j f k)^N
        cn (i j k : Fin n) (x : X) : M x = L735[Rg, Mx x].cnum n (\ k' -> f k' x) N (\ i' j' -> m' i' j' x) i j k ;
        module Van (i j k : Fin n) (x : X) (w : Dg (h3 i j k) x) {
          a : R = f i x ;
          b : R = f j x ;
          c : R = f k x ;
          G : R = h3 i j k x ;
          djk : Dg (fij j k) x = (mul a w.1, RU[Rg].inv-part (mul b c) a G w.1 (transH (mulC (mul b c) a) (mulA a b c)) w.2) ;
          dik : Dg (fij i k) x = (mul b w.1, RU[Rg].inv-part (mul a c) b G w.1
             (transH (symH (mulA a c b)) (transH (apH (mul a) (mulC c b)) (mulA a b c))) w.2) ;
          dij : Dg (fij i j) x = (mul c w.1, RU[Rg].inv-part (mul a b) c G w.1 (refl G) w.2) ;
          e (i' j' : Fin n) (a' : R) (d : Dg (fij i' j') x) (q : Id R d.1 (mul a' w.1))
            : Id (M x) ((Mx x).sm (pw G N) (t i' j' x d)) ((Mx x).sm (pw a' N) (m' i' j' x)) =
            transH (apH ((Mx x).sm (pw G N)) (rep' i' j' x d))
              (transH (apH (\ y -> (Mx x).sm (pw G N) ((Mx x).sm (pw y N) (m' i' j' x))) q)
                 (PtL[Rg, Mx x].lift G a' w.1 w.2 N (m' i' j' x))) ;
          -- canonical points
          di : Dg (f i) x = dL i j x dij ;
          dj : Dg (f j) x = dR i j x dij ;
          dk : Dg (f k) x = dR j k x djk ;
          tc : Id (M x) ((Mx x).madd (MA[Rg, Mx x].sub (t j k x djk) (t i k x dik)) (t i j x dij)) (Mx x).mz =
            transH (apH (\ v -> (Mx x).madd (MA[Rg, Mx x].sub v (t i k x dik)) (t i j x dij))
                      (tirr j k x (dL j k x djk) dj (dR j k x djk) dk))
              (transH (apH (\ v -> (Mx x).madd (MA[Rg, Mx x].sub (t' j k x dj dk) v) (t i j x dij))
                         (tirr i k x (dL i k x dik) di (dR i k x dik) dk))
                 (tor-coc x (s i x di) (s j x dj) (s k x dk))) ;
          vanish : Id (M x) (cn i j k x) (Mx x).mz = calc (M x) {
            cn i j k x
              =< apH (\ v -> (Mx x).madd (MA[Rg, Mx x].sub v ((Mx x).sm (pw b N) (m' i k x))) ((Mx x).sm (pw c N) (m' i j x)))
                   (symH (e j k a djk (refl (mul a w.1))))
              > (Mx x).madd (MA[Rg, Mx x].sub ((Mx x).sm (pw G N) (t j k x djk)) ((Mx x).sm (pw b N) (m' i k x)))
                            ((Mx x).sm (pw c N) (m' i j x))
              =< apH (\ v -> (Mx x).madd (MA[Rg, Mx x].sub ((Mx x).sm (pw G N) (t j k x djk)) v) ((Mx x).sm (pw c N) (m' i j x)))
                   (symH (e i k b dik (refl (mul b w.1))))
              > (Mx x).madd (MA[Rg, Mx x].sub ((Mx x).sm (pw G N) (t j k x djk)) ((Mx x).sm (pw G N) (t i k x dik)))
                            ((Mx x).sm (pw c N) (m' i j x))
              =< apH ((Mx x).madd (MA[Rg, Mx x].sub ((Mx x).sm (pw G N) (t j k x djk)) ((Mx x).sm (pw G N) (t i k x dik))))
                   (symH (e i j c dij (refl (mul c w.1))))
              > (Mx x).madd (MA[Rg, Mx x].sub ((Mx x).sm (pw G N) (t j k x djk)) ((Mx x).sm (pw G N) (t i k x dik)))
                            ((Mx x).sm (pw G N) (t i j x dij))
              =< apH (\ v -> (Mx x).madd v ((Mx x).sm (pw G N) (t i j x dij)))
                   (symH (MA[Rg, Mx x].sm-sub (pw G N) (t j k x djk) (t i k x dik)))
              > (Mx x).madd ((Mx x).sm (pw G N) (MA[Rg, Mx x].sub (t j k x djk) (t i k x dik)))
                            ((Mx x).sm (pw G N) (t i j x dij))
              =< symH ((Mx x).smD (pw G N) (MA[Rg, Mx x].sub (t j k x djk) (t i k x dik)) (t i j x dij))
              > (Mx x).sm (pw G N) ((Mx x).madd (MA[Rg, Mx x].sub (t j k x djk) (t i k x dik)) (t i j x dij))
              =< apH ((Mx x).sm (pw G N)) tc > (Mx x).sm (pw G N) (Mx x).mz
              =< MA[Rg, Mx x].sm-zr (pw G N) > (Mx x).mz } ;
        } ;

        kill-tr : Tr.Trunc[(i j k : Fin n) -> Kill (h3 i j k) (cn i j k)].carrier =
          fc n (\ i -> (j k : Fin n) -> Kill (h3 i j k) (cn i j k))
            (\ i -> fc n (\ j -> (k : Fin n) -> Kill (h3 i j k) (cn i j k))
              (\ j -> fc n (\ k -> Kill (h3 i j k) (cn i j k))
                (\ k -> (wq (h3 i j k)).2 (cn i j k) (\ x w -> Van[i,j,k,x,w].vanish)))) ;

        module Data3 (kl : (i j k : Fin n) -> Kill (h3 i j k) (cn i j k)) {
          -- Lemma 7.3.5 at each point
          lem (x : X) : (p : Nat) * (V : Fin n -> M x) * ((i j : Fin n) ->
              MA[Rg, Mx x].FEq (mul (f i x) (f j x))
                (MA[Rg, Mx x].sub ((Mx x).sm (pw (f j x) p) (V i)) ((Mx x).sm (pw (f i x) p) (V j))) p (m' i j x) N) =
            L735[Rg, Mx x].lemma-7-3-5 n (\ k -> f k x) (\ k -> r k x) (unim x) N (\ i j -> m' i j x)
              (\ i j k -> ((kl i j k).1, (kl i j k).2 x)) ;
          u (i : Fin n) (x : X) (d : Dg (f i) x) : M x = (Mx x).sm (pw d.1 (lem x).1) ((lem x).2.1 i) ;
          diffu (i j : Fin n) (x : X) (di : Dg (f i) x) (dj : Dg (f j) x)
            : Id (M x) (MA[Rg, Mx x].sub (u i x di) (u j x dj)) (t' i j x di dj) =
            transH (PtL[Rg, Mx x].Compat[f i x, f j x, di.1, dj.1, di.2, dj.2, (lem x).1, N,
                      (lem x).2.1 i, (lem x).2.1 j, m' i j x, (lem x).2.2 i j].eq)
              (transH (symH (rep' i j x (mul di.1 dj.1, unit-mul (f i x) (f j x) di.1 dj.1 di.2 dj.2)))
                 (tirr i j x (dL i j x (mul di.1 dj.1, unit-mul (f i x) (f j x) di.1 dj.1 di.2 dj.2)) di
                             (dR i j x (mul di.1 dj.1, unit-mul (f i x) (f j x) di.1 dj.1 di.2 dj.2)) dj)) ;
          -- the corrected local sections agree on overlaps
          st (i : Fin n) (x : X) (d : Dg (f i) x) : T x = act x ((Mx x).mneg (u i x d)) (s i x d) ;
          compat (i j : Fin n) (x : X) (di : Dg (f i) x) (dj : Dg (f j) x) : Id (T x) (st i x di) (st j x dj) =
            calc (T x) {
              act x ((Mx x).mneg (u i x di)) (s i x di)
                =< apH (act x ((Mx x).mneg (u i x di))) (symH (dact x (s j x dj) (s i x di)))
                > act x ((Mx x).mneg (u i x di)) (act x (t' i j x di dj) (s j x dj))
                =< symH (ad x ((Mx x).mneg (u i x di)) (t' i j x di dj) (s j x dj))
                > act x ((Mx x).madd ((Mx x).mneg (u i x di)) (t' i j x di dj)) (s j x dj)
                =< apH (\ v -> act x ((Mx x).madd ((Mx x).mneg (u i x di)) v) (s j x dj)) (symH (diffu i j x di dj))
                > act x ((Mx x).madd ((Mx x).mneg (u i x di)) (MA[Rg, Mx x].sub (u i x di) (u j x dj))) (s j x dj)
                =< apH (\ v -> act x v (s j x dj)) (PtL[Rg, Mx x].negsub-alg (u i x di) (u j x dj))
                > act x ((Mx x).mneg (u j x dj)) (s j x dj) } ;

          -- gluing (Lemma 1.2.2)
          Q (x : X) (v : T x) : U l = (i : Fin n) (d : Dg (f i) x) -> Id (T x) v (st i x d) ;
          Q-prop (x : X) (v : T x) : isProp (Q x v) =
            FL.isProp-Pi (Fin n) (\ i -> (d : Dg (f i) x) -> Id (T x) v (st i x d)) (\ i ->
              FL.isProp-Pi (Dg (f i) x) (\ d -> Id (T x) v (st i x d)) (\ d -> sT x v (st i x d))) ;
          S (x : X) : U l = (v : T x) * Q x v ;
          S-prop (x : X) : isProp (S x) = \ a b ->
            Sigma-eq (T x) (Q x) a.1 b.1 a.2 b.2
              (Tr.Trunc[(k : Fin n) * Dg (f k) x].induction @l (\ v -> Id (T x) a.1 b.1) (\ v -> sT x a.1 b.1)
                 (\ kd -> transH (a.2 kd.1 kd.2) (symH (b.2 kd.1 kd.2))) (cover n f r unim x))
              (Q-prop x b.1) ;
          section (x : X) : T x =
            (Tr.Trunc[(k : Fin n) * Dg (f k) x].induction @l (\ v -> S x) (\ v -> S-prop x)
               (\ kd -> (st kd.1 x kd.2, \ j d -> compat kd.1 j x kd.2 d)) (cover n f r unim x)).1 ;
        } ;
      } ;
    } ;

    Goal : U l = Tr.Trunc[(x : X) -> T x].carrier ;
    goal-prop : isProp Goal = Tr.Trunc[(x : X) -> T x].proposition ;
    from-zc (w : ZC T) : Goal =
      Tr.Trunc[(i j : Fin w.1) -> Rep (Data[w.1, w.2.1, w.2.2.1, w.2.2.2.1, w.2.2.2.2].fij i j) (Data[w.1, w.2.1, w.2.2.1, w.2.2.2.1, w.2.2.2.2].t i j)].induction @l
        (\ v -> Goal) (\ v -> goal-prop)
        (\ rp -> Tr.Trunc[(i j k : Fin w.1) -> Kill (Data[w.1, w.2.1, w.2.2.1, w.2.2.2.1, w.2.2.2.2].h3 i j k)
                    (Data[w.1, w.2.1, w.2.2.1, w.2.2.2.1, w.2.2.2.2].Data2[rp].cn i j k)].induction @l
           (\ v -> Goal) (\ v -> goal-prop)
           (\ kl -> Tr.Trunc[(x : X) -> T x].inc (Data[w.1, w.2.1, w.2.2.1, w.2.2.2.1, w.2.2.2.2].Data2[rp].Data3[kl].section))
           (Data[w.1, w.2.1, w.2.2.1, w.2.2.2.1, w.2.2.2.2].Data2[rp].kill-tr))
        (Data[w.1, w.2.1, w.2.2.1, w.2.2.2.1, w.2.2.2.2].rep-tr) ;
    theorem-7-3-6 : Goal =
      Tr.Trunc[ZC T].induction @l (\ v -> Goal) (\ v -> goal-prop) from-zc (zc T (\ x -> (ts x).2.2.2.2.2)) ;
  } ;
} ;
