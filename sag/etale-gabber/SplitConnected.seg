-- Two splittings are merely isomorphic (bridge 3b; SPLITOBJECTS).
-- Let o = (M, sigma) and o' = (M', sigma') be splittings E = End M,
-- E = End M', with M, M' merely free of rank N = n0+1, R local.  The goal
-- is a proposition, so take bases (e_i, c_i) of M and (e'_i, c'_i) of M'.
--  (transfer)  theta x = sum_i c_i(x) e'_i is linear, and
--         c'_k(theta x) = sum_i c_i(x) c'_k(e'_i) = c_k(x).
--     Vectors with the same coordinates are equal (frame law).  With
--     theta' y = sum_i c'_i(y) e_i (the same construction, bases swapped):
--     c_k(theta' (theta x)) = c'_k(theta x) = c_k(x), so theta' theta = 1,
--     likewise theta theta' = 1, and theta' e'_j = e_j (c_k(theta' e'_j) =
--     c'_k(e'_j) = delta_kj = c_k(e_j)).
--  (conjugation)  For u in End M let u^theta = theta u theta' in End M'.
--     With kappa : End M = M_N, kappa' : End M' = M_N (BASISEND, entries
--     c_i(u(e_j))):  kappa'(u^theta) = kappa(u), as its (i,j) entry is
--         c'_i(theta(u(theta' e'_j))) = c_i(u(theta' e'_j)) = c_i(u(e_j)).
--  (Skolem-Noether)  phi = kappa' sigma' sigma^-1 kappa^-1 is an algebra
--     endomorphism of M_N, so merely phi X = W X L with L W = 1 = W L
--     (SKOLEMNOETHER, R local).
--  (arrow)  g = kappa^-1 W and h = kappa^-1 L are inverse in End M, as
--     kappa(g h) = W L = 1 = kappa(1).  For s in E and f = sigma(s):
--         kappa'(sigma' s) = phi(kappa f) = W kappa(f) L = kappa(g f h)
--                          = kappa'((g f h)^theta),
--     so sigma'(s) = theta g f h theta'.  The arrow is a = theta g, with
--     inverse h theta'; it carries sigma to sigma':
--         sigma'(s)(a x) = theta g f h theta' theta g x = theta g f x = a(f x).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module EN = ModuleEnd[l].Over[R,setR] ;
 module NA = EN.NA ;
 module AS = AlgSIP[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module BE = BasisEnd[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module D = MnSums[l].Over[R] ;
 -- the inverse of an algebra isomorphism is a homomorphism
 module Inverse (A B : NA.Algebra) (e : AS.AlgIso A B) {
  f (x : A.A) : B.A = e.1.1 x ;
  s (y : B.A) : A.A = e.1.2.sec y ;
  back (x : A.A) (y : B.A) (h : Id B.A (f x) y) : Id A.A (s y) x =
   trans (ap s (sym h)) (Pr.sec-ret A.A B.A e.1.1 e.1.2 x) ;
  hom : AS.Hom B A s =
   (\ x y -> back (A.add (s x) (s y)) (B.add x y)
     (trans (e.2.1 (s x) (s y)) (trans (ap (\ z -> B.add z (f (s y))) (e.1.2.sec-eq x)) (ap (B.add x) (e.1.2.sec-eq y)))),
    \ a x -> back (A.scale a (s x)) (B.scale a x) (trans (e.2.2.1 a (s x)) (ap (B.scale a) (e.1.2.sec-eq x))),
    \ x y -> back (A.mul (s x) (s y)) (B.mul x y)
     (trans (e.2.2.2.1 (s x) (s y)) (trans (ap (\ z -> B.mul z (f (s y))) (e.1.2.sec-eq x)) (ap (B.mul x) (e.1.2.sec-eq y)))),
    back A.one B.one e.2.2.2.2) ;
 } ;
 -- homomorphisms compose
 compose-hom (A B C : NA.Algebra) (f : A.A -> B.A) (g : B.A -> C.A) (hf : AS.Hom A B f) (hg : AS.Hom B C g) :
  AS.Hom A C (\ x -> g (f x)) =
  (\ x y -> trans (ap g (hf.1 x y)) (hg.1 (f x) (f y)),
   \ a x -> trans (ap g (hf.2.1 a x)) (hg.2.1 a (f x)),
   \ x y -> trans (ap g (hf.2.2.1 x y)) (hg.2.2.1 (f x) (f y)),
   trans (ap g hf.2.2.2) hg.2.2.2) ;
 module At (n0 : Nat) (E : NA.Algebra) {
  N : Nat = suc n0 ;
  module SO = SplitObjects[l].Over[R,setR,axioms].At[N,E] ;
  module MN = MnAlgebra[l].Over[R,setR,N] ;
  -- a vector is determined by its coordinates in a basis
  coordinates-eq (M : MD.Module) (b : LF.Basis[M,N]) (x y : M.M)
   (h : (k : Fin N) -> Id R.R ((b.frame.form k).1 x) ((b.frame.form k).1 y)) : Id M.M x y =
   trans (sym (b.frame.law x))
    (trans (ModuleFiniteSums[l].Over[R,setR,M].congruent N _ _
      (\ k -> ap (\ t -> M.sm t (b.frame.vector k)) (h k))) (b.frame.law y)) ;
  -- (transfer) theta x = sum_i c_i(x) e'_i
  module Transfer (M M' : MD.Module) (b : LF.Basis[M,N]) (b' : LF.Basis[M',N]) {
   module MS = ModuleFiniteSums[l].Over[R,setR,M'] ;
   module ML = ModuleSumLaws[l].Over[R,setR,M'] ;
   c (i : Fin N) (x : M.M) : R.R = (b.frame.form i).1 x ;
   e' (i : Fin N) : M'.M = b'.frame.vector i ;
   map (x : M.M) : M'.M = MS.sum N (\ i -> M'.sm (c i x) (e' i)) ;
   map-add (x y : M.M) : Id M'.M (map (M.madd x y)) (M'.madd (map x) (map y)) =
    trans (MS.congruent N (\ i -> M'.sm (c i (M.madd x y)) (e' i))
     (\ i -> M'.madd (M'.sm (c i x) (e' i)) (M'.sm (c i y) (e' i)))
     (\ i -> trans (ap (\ t -> M'.sm t (e' i)) ((b.frame.form i).2.1 x y)) (M'.smE (c i x) (c i y) (e' i))))
     (ML.sum-add N (\ i -> M'.sm (c i x) (e' i)) (\ i -> M'.sm (c i y) (e' i))) ;
   map-scale (a : R.R) (x : M.M) : Id M'.M (map (M.sm a x)) (M'.sm a (map x)) =
    trans (MS.congruent N (\ i -> M'.sm (c i (M.sm a x)) (e' i)) (\ i -> M'.sm a (M'.sm (c i x) (e' i)))
     (\ i -> trans (ap (\ t -> M'.sm t (e' i)) ((b.frame.form i).2.2 a x)) (sym (M'.smA a (c i x) (e' i)))))
     (sym (ML.scale-sum a N (\ i -> M'.sm (c i x) (e' i)))) ;
   coordinate (k : Fin N) (x : M.M) : Id R.R ((b'.frame.form k).1 (map x)) (c k x) =
    trans (FR.Form[M',b'.frame.form k].sum N (\ i -> M'.sm (c i x) (e' i)))
     (trans (RS.sum-cong N _ (\ i -> R.mul (D.delta N k i) (c i x))
       (\ i -> trans ((b'.frame.form k).2.2 (c i x) (e' i))
        (trans (ap (R.mul (c i x)) (b'.dual k i)) (R.mulC (c i x) (D.delta N k i)))))
      (D.sum-delta N k (\ i -> c i x))) ;
  } ;
  module Two (o o' : SO.Obj) (b : LF.Basis[SO.carrier o,N]) (b' : LF.Basis[SO.carrier o',N]) {
   M : MD.Module = SO.carrier o ;
   M' : MD.Module = SO.carrier o' ;
   module T = Transfer[M,M',b,b'] ;
   module T' = Transfer[M',M,b',b] ;
   back-forth (x : M.M) : Id M.M (T'.map (T.map x)) x =
    coordinates-eq M b _ _ (\ k -> trans (T'.coordinate k (T.map x)) (T.coordinate k x)) ;
   forth-back (y : M'.M) : Id M'.M (T.map (T'.map y)) y =
    coordinates-eq M' b' _ _ (\ k -> trans (T.coordinate k (T'.map y)) (T'.coordinate k y)) ;
   basis-back (j : Fin N) : Id M.M (T'.map (b'.frame.vector j)) (b.frame.vector j) =
    coordinates-eq M b _ _ (\ k -> trans (T'.coordinate k (b'.frame.vector j)) (trans (b'.dual k j) (sym (b.dual k j)))) ;
   -- (conjugation)
   module End = EN.At[M] ;
   module End' = EN.At[M'] ;
   conj (u : End.H.S.E) : End'.H.S.E =
    (\ y -> T.map (u.1 (T'.map y)),
     \ y z -> trans (ap (\ w -> T.map (u.1 w)) (T'.map-add y z))
      (trans (ap T.map (u.2.1 (T'.map y) (T'.map z))) (T.map-add (u.1 (T'.map y)) (u.1 (T'.map z)))),
     \ a y -> trans (ap (\ w -> T.map (u.1 w)) (T'.map-scale a y))
      (trans (ap T.map (u.2.2 a (T'.map y))) (T.map-scale a (u.1 (T'.map y))))) ;
   module K = BE.At[M,N,b.frame,b.dual] ;
   module K' = BE.At[M',N,b'.frame,b'.dual] ;
   transfer (u : End.H.S.E) : Id MN.Mat (K'.coordinate (conj u)) (K.coordinate u) =
    MN.mat-eq _ _ (\ i j -> trans (T.coordinate i (u.1 (T'.map (b'.frame.vector j))))
     (ap (\ z -> (b.frame.form i).1 (u.1 z)) (basis-back j))) ;
   -- kappa and kappa' are injective
   injective (u v : End.H.S.E) (e : Id MN.Mat (K.coordinate u) (K.coordinate v)) : Id End.H.S.E u v =
    trans (sym (K.action-end u)) (trans (ap K.matrix-action e) (K.action-end v)) ;
   injective' (u v : End'.H.S.E) (e : Id MN.Mat (K'.coordinate u) (K'.coordinate v)) : Id End'.H.S.E u v =
    trans (sym (K'.action-end u)) (trans (ap K'.matrix-action e) (K'.action-end v)) ;
   -- (Skolem-Noether)
   sigma : SO.Splits M = o.2.2 ;
   sigma' : SO.Splits M' = o'.2.2 ;
   module SI = Inverse[E,End.algebra,sigma] ;
   module KI = Inverse[End.algebra,MN.algebra,K.iso] ;
   phi (X : MN.Mat) : MN.Mat = K'.coordinate (sigma'.1.1 (SI.s (K.matrix-action X))) ;
   phi-hom : AS.Hom MN.algebra MN.algebra phi =
    compose-hom MN.algebra End'.algebra MN.algebra (\ X -> sigma'.1.1 (SI.s (K.matrix-action X))) K'.coordinate
     (compose-hom MN.algebra E End'.algebra (\ X -> SI.s (K.matrix-action X)) sigma'.1.1
      (compose-hom MN.algebra End.algebra E K.matrix-action SI.s KI.hom SI.hom) sigma'.2)
     K'.iso.2 ;
   module SN = SkolemNoether[l].Over[R,setR,axioms.loc,n0] ;
   module EP = SN.Endo[phi,phi-hom] ;
   -- (arrow)
   module From (cj : EP.Conjugator) {
    W : MN.Mat = cj.1 ;
    L : MN.Mat = cj.2.1 ;
    conjugates (X : MN.Mat) : Id MN.Mat (phi X) (MN.mmul (MN.mmul W X) L) = cj.2.2.2.2 X ;
    g : End.H.S.E = K.matrix-action W ;
    h : End.H.S.E = K.matrix-action L ;
    inverse-gh : Id End.H.S.E (End.mul g h) End.one =
     injective _ _ (calc MN.Mat {
      K.coordinate (End.mul g h) =< K.product g h > MN.mmul (K.coordinate g) (K.coordinate h)
       =< ap (\ Y -> MN.mmul Y (K.coordinate h)) (K.coordinate-action W) > MN.mmul W (K.coordinate h)
       =< ap (MN.mmul W) (K.coordinate-action L) > MN.mmul W L
       =< cj.2.2.2.1 > MN.mone =< sym K.unit > K.coordinate End.one }) ;
    inverse-hg : Id End.H.S.E (End.mul h g) End.one =
     injective _ _ (calc MN.Mat {
      K.coordinate (End.mul h g) =< K.product h g > MN.mmul (K.coordinate h) (K.coordinate g)
       =< ap (\ Y -> MN.mmul Y (K.coordinate g)) (K.coordinate-action L) > MN.mmul L (K.coordinate g)
       =< ap (MN.mmul L) (K.coordinate-action W) > MN.mmul L W
       =< cj.2.2.1 > MN.mone =< sym K.unit > K.coordinate End.one }) ;
    gh (x : M.M) : Id M.M (g.1 (h.1 x)) x = ap (\ u -> u.1 x) inverse-gh ;
    hg (x : M.M) : Id M.M (h.1 (g.1 x)) x = ap (\ u -> u.1 x) inverse-hg ;
    -- kappa'(sigma' s) = kappa(g f h), f = sigma(s)
    step (s : E.A) : Id MN.Mat (K'.coordinate (sigma'.1.1 s)) (K.coordinate (End.mul g (End.mul (sigma.1.1 s) h))) =
     calc MN.Mat {
      K'.coordinate (sigma'.1.1 s)
       =< ap (\ t -> K'.coordinate (sigma'.1.1 t)) (sym (Pr.sec-ret E.A End.algebra.A sigma.1.1 sigma.1.2 s)) >
         K'.coordinate (sigma'.1.1 (SI.s (sigma.1.1 s)))
       =< ap (\ u -> K'.coordinate (sigma'.1.1 (SI.s u))) (sym (K.action-end (sigma.1.1 s))) >
         phi (K.coordinate (sigma.1.1 s))
       =< conjugates (K.coordinate (sigma.1.1 s)) > MN.mmul (MN.mmul W (K.coordinate (sigma.1.1 s))) L
       =< sym (MN.m-mulA W (K.coordinate (sigma.1.1 s)) L) > MN.mmul W (MN.mmul (K.coordinate (sigma.1.1 s)) L)
       =< ap (\ Y -> MN.mmul W (MN.mmul (K.coordinate (sigma.1.1 s)) Y)) (sym (K.coordinate-action L)) >
         MN.mmul W (MN.mmul (K.coordinate (sigma.1.1 s)) (K.coordinate h))
       =< ap (MN.mmul W) (sym (K.product (sigma.1.1 s) h)) > MN.mmul W (K.coordinate (End.mul (sigma.1.1 s) h))
       =< ap (\ Y -> MN.mmul Y (K.coordinate (End.mul (sigma.1.1 s) h))) (sym (K.coordinate-action W)) >
         MN.mmul (K.coordinate g) (K.coordinate (End.mul (sigma.1.1 s) h))
       =< sym (K.product g (End.mul (sigma.1.1 s) h)) > K.coordinate (End.mul g (End.mul (sigma.1.1 s) h)) } ;
    -- sigma'(s) = theta g f h theta'
    split-conj (s : E.A) : Id End'.H.S.E (sigma'.1.1 s) (conj (End.mul g (End.mul (sigma.1.1 s) h))) =
     injective' _ _ (trans (step s) (sym (transfer (End.mul g (End.mul (sigma.1.1 s) h))))) ;
    -- a = theta g
    map (x : M.M) : M'.M = T.map (g.1 x) ;
    linear : SO.Lin o o' =
     (map,
      \ x y -> trans (ap T.map (g.2.1 x y)) (T.map-add (g.1 x) (g.1 y)),
      \ a x -> trans (ap T.map (g.2.2 a x)) (T.map-scale a (g.1 x))) ;
    bijective : Pr.isEquiv M.M M'.M map =
     Pr.qinv M.M M'.M map (\ y -> h.1 (T'.map y))
      (\ y -> trans (ap T.map (gh (T'.map y))) (forth-back y))
      (\ x -> trans (ap h.1 (back-forth (g.1 x))) (hg x)) ;
    intertwines (s : E.A) (x : M.M) : Id M'.M (map (SO.act o s x)) (SO.act o' s (map x)) =
     sym (calc M'.M {
      SO.act o' s (map x)
       =< ap (\ u -> u.1 (map x)) (split-conj s) > T.map (g.1 ((sigma.1.1 s).1 (h.1 (T'.map (T.map (g.1 x))))))
       =< ap (\ z -> T.map (g.1 ((sigma.1.1 s).1 (h.1 z)))) (back-forth (g.1 x)) > T.map (g.1 ((sigma.1.1 s).1 (h.1 (g.1 x))))
       =< ap (\ z -> T.map (g.1 ((sigma.1.1 s).1 z))) (hg x) > map (SO.act o s x) }) ;
    arrow : SO.Arrow o o' = (linear,bijective,intertwines) ;
    #fails {
     -- the conjugation runs kappa'(sigma' s) = W kappa(f) L, not L kappa(f) W
     opposite (s : E.A) : Id MN.Mat (K'.coordinate (sigma'.1.1 s)) (K.coordinate (End.mul h (End.mul (sigma.1.1 s) g))) =
      step s ;
    } ;
   } ;
   arrow : Tr.Trunc[SO.Arrow o o'].carrier =
    Tr.Trunc[EP.Conjugator].induction @l (\ c -> Tr.Trunc[SO.Arrow o o'].carrier) (\ c -> Tr.Trunc[SO.Arrow o o'].proposition)
     (\ c -> Tr.Trunc[SO.Arrow o o'].inc From[c].arrow) EP.theorem ;
  } ;
  -- two splittings are merely isomorphic
  connected (o o' : SO.Obj) : Tr.Trunc[SO.Arrow o o'].carrier =
   Tr.Trunc[LF.Basis[SO.carrier o,N]].induction @l (\ t -> Tr.Trunc[SO.Arrow o o'].carrier)
    (\ t -> Tr.Trunc[SO.Arrow o o'].proposition)
    (\ b -> Tr.Trunc[LF.Basis[SO.carrier o',N]].induction @l (\ t -> Tr.Trunc[SO.Arrow o o'].carrier)
     (\ t -> Tr.Trunc[SO.Arrow o o'].proposition) (\ b' -> Two[o,o',b,b'].arrow) o'.2.1) o.2.1 ;
 } ;
} ;
