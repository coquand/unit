-- Two algebras with the same presentation are canonically isomorphic.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (pres : Presentations[l].Over[R,setR].Presentation)
 (A B : Algebras[l].Over[R,setR].Algebra)
 (pa : Presentations[l].Over[R,setR].Presents pres A)
 (pb : Presentations[l].Over[R,setR].Presents pres B) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 V : U l = Presentations[l].Fin pres.1 ;
 forward : C.Hom A B = (pa.2 B).sec pb.1 ;
 backward : C.Hom B A = (pb.2 A).sec pa.1 ;
 forward-generators (v : V) : Id B.ring.R (forward.1.1 (pa.1.1 v)) (pb.1.1 v) =
  Pr.ap (P.Solutions pres B) B.ring.R (\ s -> s.1 v) _ _ ((pa.2 B).sec-eq pb.1) ;
 backward-generators (v : V) : Id A.ring.R (backward.1.1 (pb.1.1 v)) (pa.1.1 v) =
  Pr.ap (P.Solutions pres A) A.ring.R (\ s -> s.1 v) _ _ ((pb.2 A).sec-eq pa.1) ;
 inverse-left : Id (C.Hom A A) (C.compose A B A backward forward) (C.identity A) =
  Equivalences[l].injective (C.Hom A A) (P.Solutions pres A) (P.canonical pres A pa.1 A) (pa.2 A) _ _
   (P.solutions-ext pres A _ _ (\ v -> trans (ap backward.1.1 (forward-generators v)) (backward-generators v))) ;
 inverse-right : Id (C.Hom B B) (C.compose B A B forward backward) (C.identity B) =
  Equivalences[l].injective (C.Hom B B) (P.Solutions pres B) (P.canonical pres B pb.1 B) (pb.2 B) _ _
   (P.solutions-ext pres B _ _ (\ v -> trans (ap forward.1.1 (backward-generators v)) (forward-generators v))) ;
 bf (a : A.ring.R) : Id A.ring.R (backward.1.1 (forward.1.1 a)) a =
  Pr.ap (C.Hom A A) A.ring.R (\ h -> h.1.1 a) _ _ inverse-left ;
 fb (b : B.ring.R) : Id B.ring.R (forward.1.1 (backward.1.1 b)) b =
  Pr.ap (C.Hom B B) B.ring.R (\ h -> h.1.1 b) _ _ inverse-right ;
 equivalence : Pr.Equiv A.ring.R B.ring.R = (forward.1.1,Pr.qinv _ _ forward.1.1 backward.1.1 fb bf) ;
} ;
