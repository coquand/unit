-- Membership is a proposition, with explicit finite certificates underneath.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (n : Nat) (fs : Fin n -> A.R) {
 open A ; open RL[A] ;
 module I = FiniteIdeal[l].Over[A,n,fs] ;
 module S = FiniteIdeal[l].Sums[A] ;
 Witness (a : R) : U l = I.Certificate a z ;
 Member (a : R) : U l = Tr.Trunc[Witness a].carrier ;
 proposition (a : R) : Pr.isProp (Member a) = Tr.Trunc[Witness a].proposition ;
 equal (a b : R) (p : Id R a b) : Member a -> Member b = Pr.subst R Member a b p ;
 zero-member : Member z = Tr.Trunc[Witness z].inc (I.reflexive z) ;
 generator (i : Fin n) : Member (fs i) = Tr.Trunc[Witness (fs i)].inc (I.generator i) ;
 addition (a b : R) (ha : Member a) (hb : Member b) : Member (add a b) =
  Tr.Trunc[Witness a].induction @l (\ t -> Member (add a b)) (\ t -> proposition (add a b))
   (\ ca -> Tr.Trunc[Witness b].induction @l (\ t -> Member (add a b)) (\ t -> proposition (add a b))
    (\ cb -> Tr.Trunc[Witness (add a b)].inc
     (I.transitive _ _ _ (I.addition a z b z ca cb) (I.equal _ _ (addZ z)))) hb) ha ;
 scale (a b : R) (hb : Member b) : Member (mul a b) =
  Tr.Trunc[Witness b].induction @l (\ t -> Member (mul a b)) (\ t -> proposition (mul a b))
   (\ cb -> Tr.Trunc[Witness (mul a b)].inc
    (I.transitive _ _ _ (I.multiplication a a b z (I.reflexive a) cb) (I.equal _ _ (mul-zero a)))) hb ;
 finite-sum : (m : Nat) (xs : Fin m -> R) -> ((i : Fin m) -> Member (xs i)) -> Member (S.sum m xs) = split {
  zero -> \ xs hs -> zero-member ;
  suc m | ih -> \ xs hs -> addition (xs (inr tt)) (S.sum m (\ i -> xs (inl i)))
   (hs (inr tt)) (ih (\ i -> xs (inl i)) (\ i -> hs (inl i))) } ;
 linear-combination (m : Nat) (gs cs : Fin m -> R) (hs : (i : Fin m) -> Member (gs i)) :
  Member (S.lin m gs cs) =
  finite-sum m (\ i -> mul (gs i) (cs i))
   (\ i -> equal _ _ (mulC (cs i) (gs i)) (scale (cs i) (gs i) (hs i))) ;
 from-certificate (m : Nat) (gs : Fin m -> R) (hs : (i : Fin m) -> Member (gs i))
  (a : R) (w : FiniteIdeal[l].Over[A,m,gs].Certificate a z) : Member a =
  equal _ _ (sym (trans w.2 (zl (S.lin m gs w.1)))) (linear-combination m gs w.1 hs) ;
 includes (m : Nat) (gs : Fin m -> R) (hs : (i : Fin m) -> Member (gs i))
  (a : R) : Tr.Trunc[FiniteIdeal[l].Over[A,m,gs].Certificate a z].carrier -> Member a =
  Tr.Trunc[FiniteIdeal[l].Over[A,m,gs].Certificate a z].induction @l
   (\ t -> Member a) (\ t -> proposition a) (from-certificate m gs hs a) ;
} ;
