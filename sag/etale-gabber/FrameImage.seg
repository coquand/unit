-- A frame is a presentation by its projector (FRAMES, MATRIXTENSOR).
-- Let P have a frame of size K: vectors s_k, forms d_k, sum_k d_k(m) s_k = m,
-- and let p be its matrix, p_ij = d_i(s_j).  Then P = I p:
--  (expand)  d_i(sum_k w_k s_k) = sum_k w_k d_i(s_k) = (p w)_i;
--  encode m = (d_i(m))_i is fixed by p: (p (d(m)))_i = d_i(sum_k d_k(m) s_k)
--            = d_i(m), by (expand) and the frame law;
--  decode w = sum_k w_k s_k;  decode (encode m) = m is the frame law, and
--            encode (decode w) = p w = w by (expand);
--  encode is linear since each d_i is.
-- Hence Hom(P, U) = U [x] p (comparison C1 of CHEAP-DESIGN.md).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module At (P : MD.Module) (K : Nat) (fr : FR.Frame[P,K]) {
  module V = Vectors[l].Over[R,setR,K] ;
  module SP = ModuleFiniteSums[l].Over[R,setR,P] ;
  s (k : Fin K) : P.M = fr.vector k ;
  d (k : Fin K) : HM.At[P,MD.regular].S.E = fr.form k ;
  matrix : V.MR.Mat = \ i j -> (d i).1 (s j) ;
  module IM = MT.Image[K,matrix] ;
  combine (w : V.Vec) : P.M = SP.sum K (\ k -> P.sm (w k) (s k)) ;
  coordinates (m : P.M) : V.Vec = \ i -> (d i).1 m ;
  -- (expand)
  expand (w : V.Vec) (i : Fin K) : Id R.R ((d i).1 (combine w)) (V.act matrix w i) =
   trans (FR.Form[P,d i].sum K (\ k -> P.sm (w k) (s k)))
    (RS.sum-cong K _ (\ k -> R.mul (matrix i k) (w k)) (\ k -> trans ((d i).2.2 (w k) (s k)) (R.mulC (w k) ((d i).1 (s k))))) ;
  fixed (m : P.M) : IM.Fixed (coordinates m) =
   V.vec-eq _ _ (\ i -> trans (sym (expand (coordinates m) i)) (ap (d i).1 (fr.law m))) ;
  encode (m : P.M) : IM.S.E = (coordinates m,fixed m) ;
  decode (w : IM.S.E) : P.M = combine w.1 ;
  decode-encode (m : P.M) : Id P.M (decode (encode m)) m = fr.law m ;
  encode-decode (w : IM.S.E) : Id IM.S.E (encode (decode w)) w =
   IM.ext _ _ (V.vec-eq _ _ (\ i -> trans (expand w.1 i) (V.entry _ _ w.2 i))) ;
  theorem : Id MD.Module P (MT.I K matrix) =
   SIP.sip P (MT.I K matrix) ((encode,Pr.qinv P.M IM.S.E encode decode encode-decode decode-encode),
    \ m m' -> IM.ext _ _ (V.vec-eq _ _ (\ i -> (d i).2.1 m m')),
    \ c m -> IM.ext _ _ (V.vec-eq _ _ (\ i -> (d i).2.2 c m))) ;
  -- (C1)
  hom (U1 : MD.Module) : Id MD.Module HM.At[P,U1].carrier (MT.tensor U1 K matrix) =
   Pr1.ap MD.Module MD.Module (\ M -> HM.At[M,U1].carrier) P (MT.I K matrix) theorem ;
 } ;
} ;
