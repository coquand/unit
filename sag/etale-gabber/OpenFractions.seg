-- A function on a principal open is merely a fraction (SQC on the
-- localisation).  A f.p., w in A, g : D(w) -> R with D(w) = (x : Spec A) *
-- (x(w) a unit) (AFFINEINTERFACE.D).  Then merely b in A and n with
--     x(b) = x(w)^n g(x)          for all x in D(w).
-- Proof: L = A[1/w] (merely, AFFINEINTERFACE.localize), Spec L = D(w)
-- (spectrum); by SQC for L, g is evaluation at a in L; a is merely b/w^n
-- (LOCALIZATIONFRACTIONS); evaluate b = w^n a at the point of Spec L over x.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module RF = LocalizationFractions[l].Over[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 module At (A : C.Algebra) (fp : P.FP A) (w : A.ring.R) (g : I.D A w -> R.R) {
  -- x(b) = x(w)^n g(x) on D(w)
  Rep : U l = (b : A.ring.R) * (n : Nat) *
   ((x : I.D A w) -> Id R.R (x.1.1.1 b) (R.mul (Pow.power (x.1.1.1 w) n) (g x))) ;
  module With (loc : I.LocalizationWitness A w) {
   L : C.Algebra = loc.1 ;
   inc : C.Hom A L = loc.2.2.1 ;
   spectrum : Pr.Equiv (C.Spec L) (I.D A w) = I.spectrum A w loc ;
   a : L.ring.R = (axioms.sqc L loc.2.1).sec (\ y -> g (spectrum.1 y)) ;
   value (y : C.Spec L) : Id R.R (y.1.1 a) (g (spectrum.1 y)) =
    Pr.happly (C.Spec L) (\ y -> R.R) _ _ ((axioms.sqc L loc.2.1).sec-eq (\ y -> g (spectrum.1 y))) y ;
   module Fraction (fm : RF.Form A w loc a) {
    -- at the point y of Spec L, then at any x of D(w) = spectrum y
    at-point (y : C.Spec L) :
     Id R.R ((spectrum.1 y).1.1.1 fm.1) (R.mul (Pow.power ((spectrum.1 y).1.1.1 w) fm.2.1) (g (spectrum.1 y))) =
     trans (ap y.1.1 fm.2.2)
      (trans (y.1.2.2.2 (AffinePowers[l].Over[L.ring].power (inc.1.1 w) fm.2.1) a)
       (cong2 R.R R.mul _ _ _ _ (AffinePowers[l].power-map L.ring R y.1 (inc.1.1 w) fm.2.1) (value y))) ;
    result : Rep = (fm.1,fm.2.1,\ x ->
     Pr.subst (I.D A w) (\ z -> Id R.R (z.1.1.1 fm.1) (R.mul (Pow.power (z.1.1.1 w) fm.2.1) (g z)))
      _ _ (spectrum.2.sec-eq x) (at-point (spectrum.2.sec x))) ;
   } ;
   theorem : Tr.Trunc[Rep].carrier =
    Tr.Trunc[RF.Form A w loc a].induction @l (\ z -> Tr.Trunc[Rep].carrier) (\ z -> Tr.Trunc[Rep].proposition)
     (\ fm -> Tr.Trunc[Rep].inc Fraction[fm].result) (RF.fractions A fp w loc a) ;
  } ;
  theorem : Tr.Trunc[Rep].carrier =
   Tr1.Trunc[I.LocalizationWitness A w].induction @l (\ z -> Tr.Trunc[Rep].carrier)
    (\ z -> Tr.Trunc[Rep].proposition) (\ loc -> With[loc].theorem) (I.localize A fp w) ;
 } ;
} ;
