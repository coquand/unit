-- Finite disjunctions of open propositions, without a choice of witnesses.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 Some (n : Nat) (Q : Fin n -> U l) : U l = Tr.Trunc[(j : Fin n) * Q j].carrier ;
 module Step (n : Nat) (Q : Fin (suc n) -> U l) {
  Old : U l = Some n (\ j -> Q (inl j)) ;
  Either : U l = OO.Or (Q (inr tt)) Old ;
  pick : (j : Fin (suc n)) -> Q j -> Either = split {
   inl j -> \ q -> Tr.Trunc[Plus (Q (inr tt)) Old].inc (inr (Tr.Trunc[(a : Fin n) * Q (inl a)].inc (j,q))) ;
   inr t -> \ q -> Tr.Trunc[Plus (Q (inr tt)) Old].inc
    (inl (Pr.subst Top (\ u -> Q (inr u)) t tt (FinSum[l].top-prop t tt) q)) } ;
  to (s : Some (suc n) Q) : Either =
   TC.rec ((j : Fin (suc n)) * Q j) @l Either (Tr.Trunc[Plus (Q (inr tt)) Old].proposition)
    (\ p -> pick p.1 p.2) s ;
  from-plus : Plus (Q (inr tt)) Old -> Some (suc n) Q = split {
   inl q -> Tr.Trunc[(j : Fin (suc n)) * Q j].inc (inr tt,q) ;
   inr s -> TC.map ((j : Fin n) * Q (inl j)) ((j : Fin (suc n)) * Q j)
    (\ p -> (inl p.1,p.2)) s } ;
  from (s : Either) : Some (suc n) Q =
   TC.rec (Plus (Q (inr tt)) Old) @l (Some (suc n) Q)
    (Tr.Trunc[(j : Fin (suc n)) * Q j].proposition) from-plus s ;
  equivalence : Pr.Equiv (Some (suc n) Q) Either =
   (to,Pr.qinv _ _ to from (\ e -> Tr.Trunc[Plus (Q (inr tt)) Old].proposition _ e)
     (\ s -> Tr.Trunc[(j : Fin (suc n)) * Q j].proposition _ s)) ;
 } ;
 finite-open : (n : Nat) (Q : Fin n -> U l) -> ((j : Fin n) -> OP.Open (Q j)) -> OP.Open (Some n Q) = split {
  zero -> \ Q oq -> OP.along (Some zero Q) Empty
   ((\ s -> TC.rec ((j : Fin zero) * Q j) @l Empty (\ e e1 -> efq e) (\ p -> p.1) s),
    Pr.qinv (Some zero Q) Empty (\ s -> TC.rec ((j : Fin zero) * Q j) @l Empty (\ e e1 -> efq e) (\ p -> p.1) s)
     (\ e -> efq e) (\ e -> efq e) (\ s -> Tr.Trunc[(j : Fin zero) * Q j].proposition _ s)) OO.open-empty ;
  suc n | ih -> \ Q oq -> OP.along (Some (suc n) Q) (Step[n,Q].Either) Step[n,Q].equivalence
   (OO.open-or (Q (inr tt)) (Some n (\ j -> Q (inl j))) (oq (inr tt))
     (ih (\ j -> Q (inl j)) (\ j -> oq (inl j)))) } ;
 unit-open (r : R.R) : OP.Open (RL[R].unit r) =
  Tr.Trunc[OP.Witness (RL[R].unit r)].inc
   (OP.from-iff (RL[R].unit r) (AffineRing[l].Laws[R,setR].unit-prop r) (suc zero) (\ j -> r)
    (\ u -> Tr.Trunc[(j : Fin (suc zero)) * RL[R].unit r].inc (inr tt,u))
    (TC.rec ((j : Fin (suc zero)) * RL[R].unit r) @l (RL[R].unit r)
      (AffineRing[l].Laws[R,setR].unit-prop r) (\ p -> p.2))) ;
} ;
