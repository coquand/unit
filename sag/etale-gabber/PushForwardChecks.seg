-- A frame can have more generators than the rank of its module. The
-- zero module has a frame with one generator, yet no positive-rank basis.
-- This exercises the rank-zero branch of ProjectiveFree and explains why
-- the not-not inhabited base is necessary in AffineSectionFrame.Positive.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module PF = ProjectiveFree[l].Over[R,setR,axioms] ;
 module MD = PF.MD ; module FR = PF.FR ; module LF = PF.LF ;
 module NZ = SectionNonzero[l].Over[R,setR,axioms] ;
 empty-sections : MD.Module = MD.pi Empty (\ e -> MD.regular) ;
 empty-zero : NZ.Module[empty-sections].Zero = \ s -> F.funext Empty (\ e -> R.R) s empty-sections.mz (\ e -> efq e) ;
 empty-frame : FR.Frame[empty-sections,suc zero] = new FR.Frame[empty-sections,suc zero,
  \ i -> empty-sections.mz,
  \ i -> (\ s -> R.z,FR.HM.At[empty-sections,MD.regular].zero),
  \ s -> F.funext Empty (\ e -> R.R) _ s (\ e -> efq e)] ;
 empty-free : PF.At[empty-sections].Free = PF.At[empty-sections].theorem (suc zero) empty-frame ;
 no-positive-empty (n : Nat) : Not (LF.Basis[empty-sections,suc n]) = \ b -> NZ.Module[empty-sections].Positive[n,b].contradiction empty-zero ;
 regular-free : PF.At[MD.regular].Free = PF.At[MD.regular].theorem (suc zero) FR.regular ;
 #fails {
  -- Reconstruction alone cannot make a frame into a basis of the same size.
  unjustified-rank : LF.Basis[empty-sections,suc zero] = new LF.Basis[empty-sections,suc zero,empty-frame,
   \ i j -> refl R.z] ;
 } ;
} ;
