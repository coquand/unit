-- Twisted modules over one gerbe, internally (gabber-recollement, Setting;
-- ../HANDOFF-GABBER-HOMOTOPY.md).  Let Gb be an R^x-gerbe (GERBE) with
-- carrier Y, band beta_y : (y = y) ~ R^x, and chi : R^x -> R^x.  A family V
-- of R-modules over Y has weight chi if every loop p at y acts on V y, by
-- transport, as multiplication by chi(beta_y p).  Weight 1 (chi = id) is a
-- twisted module; weight 0 (chi = 1) is an ordinary one, by descent:
-- Descent.  For any family V, the invariant sections
--     Inv V = { s : (y : Y) -> V y  |  p_* (s y) = s y' for all p : y = y' }
-- form a submodule of the product (transport is additive and linear, by J).
-- If V has weight 0 and y0 : Y, evaluation Inv V -> V y0 is a linear
-- equivalence, so Inv V = V y0 as modules (MODULESIP2):
--  - injective: if s y0 = t y0 then s y = p_* (s y0) = p_* (t y0) = t y for
--    a path p : y0 = y, which exists merely (connectedness); the goal is a
--    proposition;
--  - surjective: for m in V y0 the type  Fit y = (v : V y) * ((p : y0 = y) ->
--    p_* m = v)  is a proposition (merely a path), and is inhabited by p_* m
--    for any p: a second path q gives q_* m = p_* m, by J on p from q_* m = m
--    (weight 0).  So s y = (Fit y).1 is a section; it is invariant since
--    p'_* (p_* m) = (p . p')_* m; and s y0 = m.
-- Hom.  If V has weight chi and W weight psi, Hom(V, W) has weight psi/chi;
-- in particular weight 0 if chi = psi, so then it descends.  Proof: p_* f
-- sends p_* m to p_* (f m) (J).  For a loop q with c = chi(beta q) and
-- d = psi(beta q), linearity gives c (q_* f)(m) = (q_* f)(c m) =
-- (q_* f)(q_* m) = q_* (f m) = d f(m) = c ((d/c) f(m)), and c is a unit.
-- Families.  Over a type X with a gerbe G x at each x (X = Spec Alg), a
-- module of weight chi is a weight-chi family at each G x; a weight-0 one
-- descends to the family x |-> Inv (V x) of modules over X.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module GB = Gerbe[l].Gerbes[UG.group] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 -- what twisted modules use of a gerbe: the band and connectedness, not
 -- inhabitation (so etale gerbes, inhabited only locally, are Banded too)
 Banded : U l+ = (Y : U l) * ((a b : Y) -> Pr.isSet (Id Y a b)) * ((a b : Y) -> Tr.Trunc[Id Y a b].carrier)
  * ((y : Y) -> GB.Band Y y) ;
 banded (Gb : GB.AGerbe) : Banded = (Gb.1,Gb.2.1,Gb.2.2.2.1,Gb.2.2.2.2) ;
 -- what the rest uses of a banded type: connectedness and the character
 -- beta_y : (y = y) -> R^x, which need not be a band (a product of gerbes
 -- carries (p, q) |-> beta p beta q, LINEFAMILIES)
 Charged : U l+ = (Y : U l) * ((a b : Y) -> Tr.Trunc[Id Y a b].carrier) * ((y : Y) -> Id Y y y -> UG.Unit) ;
 charge (B : Banded) : Charged = (B.1,B.2.2.1,\ y p -> (B.2.2.2 y).1 p) ;
 module At (B : Charged) {
  Y : U l = B.1 ;
  conn (a b : Y) : Tr.Trunc[Id Y a b].carrier = B.2.1 a b ;
  bnd (y : Y) (p : Id Y y y) : UG.Unit = B.2.2 y p ;
  -- transport in a family of modules
  module Move (V : Y -> MD.Module) {
   move (y y' : Y) (p : Id Y y y') (m : (V y).M) : (V y').M = Pr.subst Y (\ z -> (V z).M) y y' p m ;
   move-refl (y : Y) (m : (V y).M) : Id (V y).M (move y y (refl y) m) m = refl m ;
   move-zero (y y' : Y) (p : Id Y y y') : Id (V y').M (move y y' p (V y).mz) (V y').mz =
    idJ Y y (\ z q -> Id (V z).M (move y z q (V y).mz) (V z).mz) (refl (V y).mz) y' p ;
   move-add (y y' : Y) (p : Id Y y y') (a b : (V y).M) :
    Id (V y').M (move y y' p ((V y).madd a b)) ((V y').madd (move y y' p a) (move y y' p b)) =
    idJ Y y (\ z q -> Id (V z).M (move y z q ((V y).madd a b)) ((V z).madd (move y z q a) (move y z q b)))
     (refl ((V y).madd a b)) y' p ;
   move-neg (y y' : Y) (p : Id Y y y') (a : (V y).M) :
    Id (V y').M (move y y' p ((V y).mneg a)) ((V y').mneg (move y y' p a)) =
    idJ Y y (\ z q -> Id (V z).M (move y z q ((V y).mneg a)) ((V z).mneg (move y z q a))) (refl ((V y).mneg a)) y' p ;
   move-scale (y y' : Y) (p : Id Y y y') (c : R.R) (a : (V y).M) :
    Id (V y').M (move y y' p ((V y).sm c a)) ((V y').sm c (move y y' p a)) =
    idJ Y y (\ z q -> Id (V z).M (move y z q ((V y).sm c a)) ((V z).sm c (move y z q a))) (refl ((V y).sm c a)) y' p ;
   move-trans (y y' : Y) (p : Id Y y y') (y'' : Y) (q : Id Y y' y'') (m : (V y).M) :
    Id (V y'').M (move y y'' (Pr.trans Y y y' y'' p q) m) (move y' y'' q (move y y' p m)) =
    idJ Y y' (\ z r -> Id (V z).M (move y z (Pr.trans Y y y' z p r) m) (move y' z r (move y y' p m)))
     (refl (move y y' p m)) y'' q ;
  } ;
  -- weight om: a loop p at y acts as om_y(p); weight chi: as chi(beta_y p)
  WeightBy (om : (y : Y) -> Id Y y y -> UG.Unit) (V : Y -> MD.Module) : U l =
   (y : Y) (p : Id Y y y) (m : (V y).M) -> Id (V y).M (Move[V].move y y p m) ((V y).sm (om y p).1 m) ;
  Weight (chi : UG.Unit -> UG.Unit) (V : Y -> MD.Module) : U l = WeightBy (\ y p -> chi (bnd y p)) V ;
  trivial (a : UG.Unit) : UG.Unit = UG.one ;
  identity (a : UG.Unit) : UG.Unit = a ;
  -- the weight depends only on the values of chi
  retag (chi chi' : UG.Unit -> UG.Unit) (h : (a : UG.Unit) -> Id UG.Unit (chi a) (chi' a))
   (V : Y -> MD.Module) (w : Weight chi V) : Weight chi' V = \ y p m ->
   trans (w y p m) (ap (\ u -> (V y).sm u.1 m) (h (bnd y p))) ;
  -- the invariant sections
  module Invariant (V : Y -> MD.Module) {
   module MV = Move[V] ;
   Total : MD.Module = MD.pi Y V ;
   Inv (s : Total.M) : U l = (y y' : Y) (p : Id Y y y') -> Id (V y').M (MV.move y y' p (s y)) (s y') ;
   inv-prop (s : Total.M) : Pr.isProp (Inv s) =
    F.isProp-Pi Y (\ y -> (y' : Y) (p : Id Y y y') -> Id (V y').M (MV.move y y' p (s y)) (s y')) (\ y ->
     F.isProp-Pi Y (\ y' -> (p : Id Y y y') -> Id (V y').M (MV.move y y' p (s y)) (s y')) (\ y' ->
      F.isProp-Pi (Id Y y y') (\ p -> Id (V y').M (MV.move y y' p (s y)) (s y')) (\ p -> (V y').setM _ _))) ;
   sub : DescentSubmodules[l].Submodule[MD.ring,Total] = new DescentSubmodules[l].Submodule[MD.ring,Total,Inv,inv-prop,
    \ y y' p -> MV.move-zero y y' p,
    \ s t hs ht y y' p -> trans (MV.move-add y y' p (s y) (t y)) (cong2 (V y').M (V y').madd _ _ _ _ (hs y y' p) (ht y y' p)),
    \ s hs y y' p -> trans (MV.move-neg y y' p (s y)) (ap (V y').mneg (hs y y' p)),
    \ c s hs y y' p -> trans (MV.move-scale y y' p c (s y)) (ap ((V y').sm c) (hs y y' p))] ;
   module S = SM.Sub[Total,sub] ;
   carrier : MD.Module = S.carrier ;
   -- evaluation at a point
   at (y0 : Y) (s : S.E) : (V y0).M = s.1 y0 ;
  } ;
  -- descent of a weight-0 family: Inv V = V y0
  module Descent (V : Y -> MD.Module) (w : Weight trivial V) (y0 : Y) {
   module IV = Invariant[V] ;
   module MV = IV.MV ;
   -- loops act trivially
   loop (q : Id Y y0 y0) (m : (V y0).M) : Id (V y0).M (MV.move y0 y0 q m) m =
    trans (w y0 q m) ((V y0).smO m) ;
   -- two paths y0 = y move m to the same element
   paths (m : (V y0).M) (y : Y) (p : Id Y y0 y) : (q : Id Y y0 y) -> Id (V y).M (MV.move y0 y q m) (MV.move y0 y p m) =
    idJ Y y0 (\ z p' -> (q : Id Y y0 z) -> Id (V z).M (MV.move y0 z q m) (MV.move y0 z p' m)) (\ q -> loop q m) y p ;
   -- injective
   injective (s t : IV.S.E) (h : Id (V y0).M (s.1 y0) (t.1 y0)) : Id IV.S.E s t =
    IV.S.eq s t (F.funext Y (\ y -> (V y).M) s.1 t.1 (\ y ->
     Tr.Trunc[Id Y y0 y].induction @l (\ c -> Id (V y).M (s.1 y) (t.1 y)) (\ c -> (V y).setM _ _)
      (\ p -> trans (sym (s.2 y0 y p)) (trans (ap (MV.move y0 y p) h) (t.2 y0 y p))) (conn y0 y))) ;
   -- surjective
   module Lift (m : (V y0).M) {
    Fit (y : Y) : U l = (v : (V y).M) * ((p : Id Y y0 y) -> Id (V y).M (MV.move y0 y p m) v) ;
    fit-prop (y : Y) : Pr.isProp (Fit y) = \ a b ->
     Pr.Sigma-eq (V y).M (\ v -> (p : Id Y y0 y) -> Id (V y).M (MV.move y0 y p m) v) a.1 b.1 a.2 b.2
      (Tr.Trunc[Id Y y0 y].induction @l (\ c -> Id (V y).M a.1 b.1) (\ c -> (V y).setM _ _)
       (\ p -> trans (sym (a.2 p)) (b.2 p)) (conn y0 y))
      (F.isProp-Pi (Id Y y0 y) (\ p -> Id (V y).M (MV.move y0 y p m) b.1) (\ p -> (V y).setM _ _)) ;
    fit (y : Y) : Fit y =
     Tr.Trunc[Id Y y0 y].induction @l (\ c -> Fit y) (\ c -> fit-prop y)
      (\ p -> (MV.move y0 y p m,paths m y p)) (conn y0 y) ;
    section (y : Y) : (V y).M = (fit y).1 ;
    invariant : IV.Inv section = \ y y' p' ->
     Tr.Trunc[Id Y y0 y].induction @l (\ c -> Id (V y').M (MV.move y y' p' (section y)) (section y'))
      (\ c -> (V y').setM _ _)
      (\ p -> trans (ap (MV.move y y' p') (sym ((fit y).2 p)))
       (trans (sym (MV.move-trans y0 y p y' p' m)) ((fit y').2 (Pr.trans Y y0 y y' p p')))) (conn y0 y) ;
    lift : IV.S.E = (section,invariant) ;
    at-lift : Id (V y0).M (section y0) m = sym ((fit y0).2 (refl y0)) ;
   } ;
   equivalence : Pr.isEquiv IV.S.E (V y0).M (IV.at y0) =
    Pr.qinv IV.S.E (V y0).M (IV.at y0) (\ m -> Lift[m].lift) (\ m -> Lift[m].at-lift)
     (\ s -> injective Lift[s.1 y0].lift s Lift[s.1 y0].at-lift) ;
   theorem : Id MD.Module IV.carrier (V y0) =
    ModuleSIP2[l].Over[MD.ring].sip IV.carrier (V y0)
     ((IV.at y0,equivalence),\ s t -> refl ((V y0).madd (s.1 y0) (t.1 y0)),\ c s -> refl ((V y0).sm c (s.1 y0))) ;
  } ;
  -- Hom(V, W) of two families of the same weight has weight 0
  module Homs (V W : Y -> MD.Module) {
   module MV = Move[V] ;
   module MW = Move[W] ;
   H (y : Y) : MD.Module = HomModule[l].Over[R,setR].At[V y,W y].carrier ;
   module MH = Move[H] ;
   -- p_* f sends p_* m to p_* (f m)
   move-apply (y y' : Y) (p : Id Y y y') (f : (H y).M) (m : (V y).M) :
    Id (W y').M ((MH.move y y' p f).1 (MV.move y y' p m)) (MW.move y y' p (f.1 m)) =
    idJ Y y (\ z q -> Id (W z).M ((MH.move y z q f).1 (MV.move y z q m)) (MW.move y z q (f.1 m))) (refl (f.1 m)) y' p ;
   -- c a = c b with c a unit gives a = b
   cancel (y : Y) (c : UG.Unit) (a b : (W y).M) (h : Id (W y).M ((W y).sm c.1 a) ((W y).sm c.1 b)) : Id (W y).M a b =
    Alg73[l].MA[MD.ring,W y].sub-zero a b
     (Alg73[l].MA[MD.ring,W y].unit-kill c.1 c.2.1 c.2.2 (Alg73[l].MA[MD.ring,W y].sub a b)
      (trans (Alg73[l].MA[MD.ring,W y].sm-sub c.1 a b)
       (trans (ap (\ t -> Alg73[l].MA[MD.ring,W y].sub t ((W y).sm c.1 b)) h)
        (Alg73[l].MA[MD.ring,W y].sub-self ((W y).sm c.1 b))))) ;
   -- V of weight a, W of weight d (functions of loops): Hom(V, W) has weight d/a
   module WeightsBy (a d : (y : Y) -> Id Y y y -> UG.Unit) (wv : WeightBy a V) (ww : WeightBy d W) {
    ratio (y : Y) (q : Id Y y y) : UG.Unit = UG.times (d y q) (UG.inverse (a y q)) ;
    -- c ((e/c) x) = e x
    unscale (y : Y) (c e : UG.Unit) (x : (W y).M) :
     Id (W y).M ((W y).sm c.1 ((W y).sm (UG.times e (UG.inverse c)).1 x)) ((W y).sm e.1 x) =
     trans ((W y).smA c.1 (R.mul e.1 c.2.1) x)
      (ap (\ t -> (W y).sm t x)
       (trans (RL[R].mul-swap c.1 e.1 c.2.1) (trans (ap (R.mul e.1) c.2.2) (R.mulO e.1)))) ;
    loop (y : Y) (q : Id Y y y) (f : (H y).M) (m : (V y).M) :
     Id (W y).M ((MH.move y y q f).1 m) ((W y).sm (ratio y q).1 (f.1 m)) =
     cancel y (a y q) ((MH.move y y q f).1 m) ((W y).sm (ratio y q).1 (f.1 m))
      (calc (W y).M { (W y).sm (a y q).1 ((MH.move y y q f).1 m)
        =< sym ((MH.move y y q f).2.2 (a y q).1 m) > (MH.move y y q f).1 ((V y).sm (a y q).1 m)
        =< ap (MH.move y y q f).1 (sym (wv y q m)) > (MH.move y y q f).1 (MV.move y y q m)
        =< move-apply y y q f m > MW.move y y q (f.1 m)
        =< ww y q (f.1 m) > (W y).sm (d y q).1 (f.1 m)
        =< sym (unscale y (a y q) (d y q) (f.1 m)) >
           (W y).sm (a y q).1 ((W y).sm (ratio y q).1 (f.1 m)) }) ;
    weight : WeightBy ratio H = \ y q f ->
     HomModule[l].Over[R,setR].At[V y,W y].ext (MH.move y y q f) ((H y).sm (ratio y q).1 f) (loop y q f) ;
   } ;
   -- V of weight chi, W of weight psi: Hom(V, W) has weight psi/chi
   module Weights (chi psi : UG.Unit -> UG.Unit) (wv : Weight chi V) (ww : Weight psi W) {
    ratio (a : UG.Unit) : UG.Unit = UG.times (psi a) (UG.inverse (chi a)) ;
    weight : Weight ratio H = WeightsBy[\ y q -> chi (bnd y q),\ y q -> psi (bnd y q),wv,ww].weight ;
   } ;
   -- the same weight: Hom(V, W) has weight 0
   module Same (om : (y : Y) -> Id Y y y -> UG.Unit) (wv : WeightBy om V) (ww : WeightBy om W) {
    module WS = WeightsBy[om,om,wv,ww] ;
    weight : Weight trivial H = \ y q f -> trans (WS.weight y q f) (ap (\ u -> (H y).sm u.1 f) (UG.invr (om y q))) ;
    -- Inv Hom(V, W) = Hom(V y0, W y0)
    descent (y0 : Y) : Id MD.Module Invariant[H].carrier (H y0) = Descent[H,weight,y0].theorem ;
   } ;
  } ;
 } ;
-- weight chi modules over a family of gerbes
 module Family (X : U l) (G : X -> GB.AGerbe) {
  Weighted (chi : UG.Unit -> UG.Unit) : U l+ =
   (V : (x : X) -> (G x).1 -> MD.Module) * ((x : X) -> At[charge (banded (G x))].Weight chi (V x)) ;
  Twisted : U l+ = Weighted (\ a -> a) ;
  -- a weight-0 family descends
  descend (V : Weighted (\ a -> UG.one)) (x : X) : MD.Module = At[charge (banded (G x))].Invariant[V.1 x].carrier ;
  descend-fibre (V : Weighted (\ a -> UG.one)) (x : X) (g : (G x).1) : Id MD.Module (descend V x) (V.1 x g) =
   At[charge (banded (G x))].Descent[V.1 x,V.2 x,g].theorem ;
 } ;
} ;
