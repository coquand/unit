level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
top-eq : Pr.isProp Top = split { tt -> split { tt -> refl tt } } ;
empty-section (B : Fin zero -> U l) : (i : Fin zero) -> B i = split { } ;
section (n : Nat) (B : Fin (suc n) -> U l)
 (old : (i : Fin n) -> B (inl i)) (last : B (inr tt)) : (i : Fin (suc n)) -> B i = split {
 inl i -> old i ;
 inr t -> idJ Top tt (\ u h -> B (inr u)) last t
  (top-eq tt t) } ;
choice : (n : Nat) (B : Fin n -> U l) ->
 ((i : Fin n) -> Tr.Trunc[B i].carrier) -> Tr.Trunc[(i : Fin n) -> B i].carrier = split {
 zero -> \ B h -> Tr.Trunc[(i : Fin zero) -> B i].inc (empty-section B) ;
 suc n | ih -> \ B h ->
  Tr.Trunc[(i : Fin n) -> B (inl i)].induction @l
   (\ t -> Tr.Trunc[(i : Fin (suc n)) -> B i].carrier)
   (\ t -> Tr.Trunc[(i : Fin (suc n)) -> B i].proposition)
   (\ old -> Tr.Trunc[B (inr tt)].induction @l
    (\ t -> Tr.Trunc[(i : Fin (suc n)) -> B i].carrier)
    (\ t -> Tr.Trunc[(i : Fin (suc n)) -> B i].proposition)
    (\ last -> Tr.Trunc[(i : Fin (suc n)) -> B i].inc (section n B old last)) (h (inr tt)))
   (ih (\ i -> B (inl i)) (\ i -> h (inl i))) } ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 listed (V : U l) : (n : Nat) -> (Fin n -> P.Expr V) -> P.Equations V = split {
  zero -> \ es -> nil ; suc n | ih -> \ es -> cons (es (inr tt)) (ih (\ i -> es (inl i))) } ;
 zeros-out (V : U l) (B : C.Algebra) (a : V -> B.ring.R) : (n : Nat) (es : Fin n -> P.Expr V) ->
  P.Zeros V B a (listed V n es) -> (i : Fin n) -> Id B.ring.R (P.eval V B a (es i)) B.ring.z = split {
  zero -> \ es h -> empty-section (\ i -> Id B.ring.R (P.eval V B a (es i)) B.ring.z) ;
  suc n | ih -> \ es h -> section n (\ i -> Id B.ring.R (P.eval V B a (es i)) B.ring.z)
   (ih (\ i -> es (inl i)) h.2) h.1 } ;
 zeros-in (V : U l) (B : C.Algebra) (a : V -> B.ring.R) : (n : Nat) (es : Fin n -> P.Expr V) ->
  ((i : Fin n) -> Id B.ring.R (P.eval V B a (es i)) B.ring.z) -> P.Zeros V B a (listed V n es) = split {
  zero -> \ es h -> tt ; suc n | ih -> \ es h -> (h (inr tt),ih (\ i -> es (inl i)) (\ i -> h (inl i))) } ;
} ;
