-- W is a summand of Z = Hom(Hom(W, V), V) (CHEAP-DESIGN.md, section 3),
-- for V, W twisted and framed on X = Spec Alg, V with a unimodular element
-- in every fibre ("positive rank": v and a form c with c(v) = 1).
--  (fibre)  For modules V, W, iota w = (phi |-> phi w) is linear W -> Z.
--     If V has v, c with c(v) = 1 and W a frame f_b, delta_b, then
--         rho(beta) = sum_b c(beta(tau_b)) f_b,   tau_b(w) = delta_b(w) v,
--     is linear in beta and rho(iota w) = sum_b c(delta_b(w) v) f_b
--     = sum_b delta_b(w) f_b = w.
--  (twisted)  Z has weight 1 (Hom(W, V) has weight 0, V weight 1:
--     TWISTEDMODULES.Weights, a . 1^-1 = a), so Hom(Z, W) has weight 0 and
--     descends (TWISTEDFRAMES.Hom), as does End W.
--  (equation)  rho |-> rho o iota maps the descended Hom(Z, W) to the
--     descended End W: transport commutes with composition with iota (J on
--     the path, iota being a family of maps), so rho_g o iota_g is again
--     invariant; the map is linear (pointwise), and id is invariant (J).
--  (pointwise)  At x, merely g : G x, a unimodular element of V x g and a
--     frame of W x g; the rho of (fibre) lifts to an invariant section
--     (Descent.Lift) whose composite with iota is id, as both agree at g
--     (Descent.injective).
--  (global)  Both descended families are framed, hence weakly QC (FRAMES),
--     so FAMILYLIFT gives merely a global rho with rho o iota = id at every
--     (x, g); RETRACTS then gives Z x g = W x g + ker rho_(x,g), i.e.
--     Z = W + K as families.
--  (power)  With frame data of the descended Hom(W, V) (AFFINEFRAMEDATA),
--     V [x] 1_N = V [x] p_H' + V [x] (1 - p_H') = Z + V [x] (1 - p_H')
--     (TENSORCOMPLEMENTS, DATUM.Left), so merely W + K' = V [x] 1_N.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module HM = HomModule[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module HF = HomFrames[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 module TFr = TwistedFrames[l].Over[R,setR] ;
 module HS = HomSums[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module TP = TensorPowers[l].Over[R,setR] ;
 -- a unimodular element
 record Unimodular (M : MD.Module) {
  vector : M.M ;
  form : HM.At[M,MD.regular].S.E ;
  unit : Id R.R (form.1 vector) R.o ;
 } ;
 identity (M : MD.Module) : HM.At[M,M].S.E = (\ m -> m,\ m m' -> refl (M.madd m m'),\ c m -> refl (M.sm c m)) ;
 -- (fibre)
 module Fibre (V W : MD.Module) {
  module HWV = HM.At[W,V] ;
  module HZ = HM.At[HWV.carrier,V] ;
  module HZW = HM.At[HZ.carrier,W] ;
  module HW = HM.At[W,W] ;
  eval (w : W.M) : HZ.S.E = (\ phi -> phi.1 w,\ phi psi -> refl (V.madd (phi.1 w) (psi.1 w)),\ c phi -> refl (V.sm c (phi.1 w))) ;
  iota : SM.Linear W HZ.carrier = (eval,\ w w' -> HZ.ext _ _ (\ phi -> phi.2.1 w w'),\ c w -> HZ.ext _ _ (\ phi -> phi.2.2 c w)) ;
  restrict (rho : HZW.S.E) : HW.S.E = HS.compose W HZ.carrier W iota rho ;
  module Solve (u : Unimodular[V]) (s : Nat) (fw : FR.Frame[W,s]) {
   module SW = ModuleFiniteSums[l].Over[R,setR,W] ;
   module LW = ModuleSumLaws[l].Over[R,setR,W] ;
   v : V.M = u.vector ;
   c : HM.At[V,MD.regular].S.E = u.form ;
   f (b : Fin s) : W.M = fw.vector b ;
   delta (b : Fin s) : HM.At[W,MD.regular].S.E = fw.form b ;
   tau (b : Fin s) : HWV.S.E = (\ w -> V.sm ((delta b).1 w) v,
    \ w w' -> trans (ap (\ e -> V.sm e v) ((delta b).2.1 w w')) (V.smE ((delta b).1 w) ((delta b).1 w') v),
    \ k w -> trans (ap (\ e -> V.sm e v) ((delta b).2.2 k w)) (sym (V.smA k ((delta b).1 w) v))) ;
   coeff (beta : HZ.S.E) (b : Fin s) : R.R = c.1 (beta.1 (tau b)) ;
   term (beta : HZ.S.E) (b : Fin s) : W.M = W.sm (coeff beta b) (f b) ;
   value (beta : HZ.S.E) : W.M = SW.sum s (term beta) ;
   value-add (beta beta' : HZ.S.E) : Id W.M (value (HZ.carrier.madd beta beta')) (W.madd (value beta) (value beta')) =
    trans (SW.congruent s (term (HZ.carrier.madd beta beta')) (\ b -> W.madd (term beta b) (term beta' b))
      (\ b -> trans (ap (\ e -> W.sm e (f b)) (c.2.1 (beta.1 (tau b)) (beta'.1 (tau b))))
       (W.smE (coeff beta b) (coeff beta' b) (f b))))
     (LW.sum-add s (term beta) (term beta')) ;
   value-scale (k : R.R) (beta : HZ.S.E) : Id W.M (value (HZ.carrier.sm k beta)) (W.sm k (value beta)) =
    trans (SW.congruent s (term (HZ.carrier.sm k beta)) (\ b -> W.sm k (term beta b))
      (\ b -> trans (ap (\ e -> W.sm e (f b)) (c.2.2 k (beta.1 (tau b)))) (sym (W.smA k (coeff beta b) (f b)))))
     (sym (LW.scale-sum k s (term beta))) ;
   rho : HZW.S.E = (value,value-add,value-scale) ;
   -- c(delta_b(w) v) = delta_b(w)
   unit-at (a : R.R) : Id R.R (c.1 (V.sm a v)) a = trans (c.2.2 a v) (trans (ap (R.mul a) u.unit) (R.mulO a)) ;
   law (w : W.M) : Id W.M (value (eval w)) w =
    trans (SW.congruent s (term (eval w)) (\ b -> W.sm ((delta b).1 w) (f b))
      (\ b -> ap (\ e -> W.sm e (f b)) (unit-at ((delta b).1 w))))
     (fw.law w) ;
   solution : Id HW.S.E (restrict rho) (identity W) = HW.ext _ _ law ;
  } ;
 } ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe) {
  module DA = Datum[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  module Fam = DA.Fam ;
  module FS = DA.FS ;
  affine : FunctionAlgebra[l].Over[R,setR].Affine DA.X =
   Tr1.Trunc[FunctionAlgebra[l].Over[R,setR].AffineWitness DA.X].inc (Alg,fp,Pr.idEquiv DA.X) ;
  regular-qc : MD.WeaklyQC MD.regular = RegularQC[l].Over[R,setR,axioms].theorem ;
  module Summand (V W : Fam.TF.Twisted) (r s : Nat) (fv : Fam.Framed V.1 r) (fw : Fam.Framed W.1 s)
   (uv : (x : DA.X) (g : (G x).1) -> Tr.Trunc[Unimodular[V.1 x g]].carrier) {
   module H' = Fam.Hom[W,V] ;
   -- (twisted)
   module ZW (x : DA.X) {
    module T = TM.At[TM.charge (TM.banded (G x))] ;
    module HZ = T.Homs[H'.H x,V.1 x] ;
    module WS = HZ.Weights[T.trivial,T.identity,H'.weight-zero.2 x,V.2 x] ;
    weight : T.Weight T.identity HZ.H = T.retag WS.ratio T.identity (\ a -> UG.eq _ _ (R.mulO a.1)) HZ.H WS.weight ;
   } ;
   twisted : Fam.TF.Twisted = (DA.Z V W,\ x -> ZW[x].weight) ;
   module D = Fam.Hom[twisted,W] ;
   module E = Fam.Hom[W,W] ;
   -- (equation)
   module Pt (x : DA.X) {
    module T = TM.At[TM.charge (TM.banded (G x))] ;
    module ID = T.Invariant[D.H x] ;
    module IE = T.Invariant[E.H x] ;
    move-restrict (g g' : (G x).1) (p : Id (G x).1 g g') (rho : (D.H x g).M) :
     Id (E.H x g').M (IE.MV.move g g' p (Fibre[V.1 x g,W.1 x g].restrict rho))
      (Fibre[V.1 x g',W.1 x g'].restrict (ID.MV.move g g' p rho)) =
     idJ (G x).1 g (\ h q -> Id (E.H x h).M (IE.MV.move g h q (Fibre[V.1 x g,W.1 x g].restrict rho))
       (Fibre[V.1 x h,W.1 x h].restrict (ID.MV.move g h q rho)))
      (refl (Fibre[V.1 x g,W.1 x g].restrict rho)) g' p ;
    section (rho : ID.S.E) : IE.S.E = (\ g -> Fibre[V.1 x g,W.1 x g].restrict (rho.1 g),
     \ g g' p -> trans (move-restrict g g' p (rho.1 g)) (ap (Fibre[V.1 x g',W.1 x g'].restrict) (rho.2 g g' p))) ;
    -- at g, composing with iota is linear
    add-at (rho rho' : ID.S.E) (g : (G x).1) :
     Id (E.H x g).M ((section (ID.carrier.madd rho rho')).1 g) ((IE.carrier.madd (section rho) (section rho')).1 g) =
     HM.At[W.1 x g,W.1 x g].ext ((section (ID.carrier.madd rho rho')).1 g) ((IE.carrier.madd (section rho) (section rho')).1 g)
      (\ w -> refl ((W.1 x g).madd ((rho.1 g).1 (Fibre[V.1 x g,W.1 x g].eval w)) ((rho'.1 g).1 (Fibre[V.1 x g,W.1 x g].eval w)))) ;
    scale-at (k : R.R) (rho : ID.S.E) (g : (G x).1) :
     Id (E.H x g).M ((section (ID.carrier.sm k rho)).1 g) ((IE.carrier.sm k (section rho)).1 g) =
     HM.At[W.1 x g,W.1 x g].ext ((section (ID.carrier.sm k rho)).1 g) ((IE.carrier.sm k (section rho)).1 g)
      (\ w -> refl ((W.1 x g).sm k ((rho.1 g).1 (Fibre[V.1 x g,W.1 x g].eval w)))) ;
    section-add (rho rho' : ID.S.E) : Id IE.S.E (section (ID.carrier.madd rho rho')) (IE.carrier.madd (section rho) (section rho')) =
     IE.S.eq (section (ID.carrier.madd rho rho')) (IE.carrier.madd (section rho) (section rho'))
      (F.funext (G x).1 (\ g -> (E.H x g).M) (section (ID.carrier.madd rho rho')).1 (IE.carrier.madd (section rho) (section rho')).1
       (add-at rho rho')) ;
    section-scale (k : R.R) (rho : ID.S.E) : Id IE.S.E (section (ID.carrier.sm k rho)) (IE.carrier.sm k (section rho)) =
     IE.S.eq (section (ID.carrier.sm k rho)) (IE.carrier.sm k (section rho))
      (F.funext (G x).1 (\ g -> (E.H x g).M) (section (ID.carrier.sm k rho)).1 (IE.carrier.sm k (section rho)).1
       (scale-at k rho)) ;
    map : SM.Linear ID.carrier IE.carrier = (section,section-add,section-scale) ;
    unit : IE.S.E = (\ g -> identity (W.1 x g),
     \ g g' p -> idJ (G x).1 g (\ h q -> Id (E.H x h).M (IE.MV.move g h q (identity (W.1 x g))) (identity (W.1 x h)))
      (refl (identity (W.1 x g))) g' p) ;
    Solution : U l = (rho : ID.S.E) * Id IE.S.E (section rho) unit ;
    -- (pointwise)
    module Solve (g : (G x).1) (u : Unimodular[V.1 x g]) (fr : FR.Frame[W.1 x g,s]) {
     module FS1 = Fibre[V.1 x g,W.1 x g].Solve[u,s,fr] ;
     module DL = T.Descent[D.H x,D.weight-zero.2 x,g].Lift[FS1.rho] ;
     lift : ID.S.E = DL.lift ;
     equation : Id IE.S.E (section lift) unit =
      T.Descent[E.H x,E.weight-zero.2 x,g].injective (section lift) unit
       (trans (ap (Fibre[V.1 x g,W.1 x g].restrict) DL.at-lift) FS1.solution) ;
     solution : Solution = (lift,equation) ;
    } ;
    solvable : Tr.Trunc[Solution].carrier =
     TC.bind (G x).1 Solution (\ g -> TC.map2 (Unimodular[V.1 x g]) (FR.Frame[W.1 x g,s]) Solution
       (\ u fr -> Solve[g,u,fr].solution) (uv x g) (fw x g))
      (TFr.Family[DA.X,G].point x) ;
   } ;
   -- (global)
   rank-z : Nat = Pairing[l].times (Pairing[l].times s r) r ;
   framed : Fam.Framed (DA.Z V W) rank-z = \ x g ->
    HF.hom-frames HM.At[W.1 x g,V.1 x g].carrier (V.1 x g) (Pairing[l].times s r) r
     (HF.hom-frames (W.1 x g) (V.1 x g) s r (fw x g) (fv x g)) (fv x g) ;
   -- by definition, the descended modules are the invariant sections
   d-carrier (x : DA.X) : Id MD.Module (D.descended x) Pt[x].ID.carrier =
    Pr1.trans MD.Module (D.descended x) (Pt[x].T.Invariant[D.weight-zero.1 x].carrier) Pt[x].ID.carrier
     (refl (Pt[x].T.Invariant[D.weight-zero.1 x].carrier)) (refl Pt[x].ID.carrier) ;
   e-carrier (x : DA.X) : Id MD.Module (E.descended x) Pt[x].IE.carrier =
    Pr1.trans MD.Module (E.descended x) (Pt[x].T.Invariant[E.weight-zero.1 x].carrier) Pt[x].IE.carrier
     (refl (Pt[x].T.Invariant[E.weight-zero.1 x].carrier)) (refl Pt[x].IE.carrier) ;
   qc-d (x : DA.X) : MD.WeaklyQC Pt[x].ID.carrier =
    FR.weakly-qc Pt[x].ID.carrier (Pairing[l].times rank-z s)
     (HF.transport (D.descended x) Pt[x].ID.carrier (d-carrier x) (Pairing[l].times rank-z s) (D.frames rank-z s framed fw x))
     regular-qc ;
   qc-e (x : DA.X) : MD.WeaklyQC Pt[x].IE.carrier =
    FR.weakly-qc Pt[x].IE.carrier (Pairing[l].times s s)
     (HF.transport (E.descended x) Pt[x].IE.carrier (e-carrier x) (Pairing[l].times s s) (E.frames s s fw fw x))
     regular-qc ;
   module FL = FamilyLift[l].Over[R,setR,axioms].At[DA.X,affine,\ x -> Pt[x].ID.carrier,\ x -> Pt[x].IE.carrier,\ x -> Pt[x].map,qc-d,qc-e,
    \ x -> Pt[x].unit,\ x -> Pt[x].solvable] ;
   -- Z = W + K from a global rho
   module Split (rs : (x : DA.X) -> FL.T x) {
    rho (x : DA.X) (g : (G x).1) : Fibre[V.1 x g,W.1 x g].HZW.S.E = (rs x).1.1 g ;
    retract (x : DA.X) (g : (G x).1) (w : (W.1 x g).M) : Id (W.1 x g).M ((rho x g).1 (Fibre[V.1 x g,W.1 x g].eval w)) w =
     ap (\ e -> (e.1 g).1 w) (rs x).2 ;
    module RT (x : DA.X) (g : (G x).1) {
     module O = Retracts[l].Over[R,setR].Of[W.1 x g,DA.Z V W x g,Fibre[V.1 x g,W.1 x g].iota,rho x g,retract x g] ;
    } ;
    kernel : FS.Fam = \ x g -> RT[x,g].O.kernel ;
    theorem : Id FS.Fam (DA.Z V W) (FS.add W.1 kernel) =
     FS.pointwise (DA.Z V W) (FS.add W.1 kernel) (\ x g -> RT[x,g].O.theorem) ;
   } ;
   Statement : U l+ = (K : FS.Fam) * Id FS.Fam (DA.Z V W) (FS.add W.1 K) ;
   theorem : Tr1.Trunc[Statement].carrier =
    TC.rec ((x : DA.X) -> FL.T x) @(l+) Tr1.Trunc[Statement].carrier Tr1.Trunc[Statement].proposition
     (\ rs -> Tr1.Trunc[Statement].inc (Split[rs].kernel,Split[rs].theorem)) FL.theorem ;
   -- (power)  W is a summand of V [x] 1_N: with frame data of the descended
   -- Hom(W, V), V [x] 1_N = V [x] p_H' + V [x] (1 - p_H')    (TENSORCOMPLEMENTS)
   --                      = Z + V [x] (1 - p_H')              (DATUM.Left)
   --                      = W + (K + V [x] (1 - p_H')).
   module FH = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,H'.descended] ;
   module Power (dH : FH.Data) (st : Statement) {
    module L = DA.Left[V,W,dH] ;
    module CF = TensorComplements[l].Over[R,setR,axioms].At[Alg,fp,G].Family[L.PH.projector] ;
    complement : FS.Fam = DA.tensor V.1 dH.size CF.CQ.matrix ;
    rest : FS.Fam = FS.add st.1 complement ;
    free : FS.Fam = \ x g -> MT.tensor (V.1 x g) dH.size (TP.one dH.size) ;
    decomposition : Id FS.Fam free (FS.add W.1 rest) =
     Pr1.trans FS.Fam free (FS.add (DA.tensor V.1 dH.size L.PH.entry) complement) (FS.add W.1 rest)
      (Pr1.sym FS.Fam (FS.add (DA.tensor V.1 dH.size L.PH.entry) complement) free (CF.theorem V.1))
      (Pr1.trans FS.Fam (FS.add (DA.tensor V.1 dH.size L.PH.entry) complement) (FS.add (DA.Z V W) complement) (FS.add W.1 rest)
       (Pr1.ap FS.Fam FS.Fam (\ A -> FS.add A complement) (DA.tensor V.1 dH.size L.PH.entry) (DA.Z V W) L.theorem)
       (Pr1.trans FS.Fam (FS.add (DA.Z V W) complement) (FS.add (FS.add W.1 st.1) complement) (FS.add W.1 rest)
        (Pr1.ap FS.Fam FS.Fam (\ A -> FS.add A complement) (DA.Z V W) (FS.add W.1 st.1) st.2)
        (Pr1.sym FS.Fam (FS.add W.1 rest) (FS.add (FS.add W.1 st.1) complement) (FS.assoc W.1 st.1 complement)))) ;
   } ;
   PowerStatement : U l+ = (N : Nat) * (K : FS.Fam) *
    Id FS.Fam (\ x g -> MT.tensor (V.1 x g) N (TP.one N)) (FS.add W.1 K) ;
   frame-data : Tr.Trunc[FH.Data].carrier =
    AffineFrameData[l].Over[R,setR,axioms].At[Alg,fp,H'.descended,Pairing[l].times s r,H'.frames s r fw fv].theorem ;
   power : Tr1.Trunc[PowerStatement].carrier =
    TC.rec FH.Data @(l+) Tr1.Trunc[PowerStatement].carrier Tr1.Trunc[PowerStatement].proposition
     (\ dH -> TruncationCombinators[l+].map Statement PowerStatement
       (\ st -> (dH.size,Power[dH,st].rest,Power[dH,st].decomposition)) theorem)
     frame-data ;
  } ;
 } ;
} ;
