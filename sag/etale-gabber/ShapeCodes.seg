-- Shapes coded by natural numbers: code : Shape -> Nat with a left inverse
-- decode, so that a shape-valued function is determined by a Nat-valued
-- one (bounded by 3.3.3; LOCALLYCONSTANT).
--  (pairs)  unpair : Nat -> Nat * Nat enumerates the diagonals (as in
--           sag/stone/Pairing): unpair 0 = (0,0), unpair (m+1) = step
--           (unpair m), step (a+1,b) = (a,b+1), step (0,b) = (b+1,0).  Every
--           (a,b) is hit, by induction on s = a + b and then on b.
--  (lists)  list-code nil = 0, list-code (d :: s) = 1 + m with unpair m =
--           (d, list-code s); decoding with fuel f >= len s inverts it, by
--           structural recursion on the fuel.
--  (code)   code s = the m with unpair m = (len s, list-code s);
--           decode n = decode-at (unpair n).1 (unpair n).2.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
Shape : U l = Towers[l].Shape ;
-- (pairs)
Pair : U l = Nat * Nat ;
step-at : Nat -> Nat -> Pair = split { zero -> \ b -> (suc b,zero) ; suc a -> \ b -> (a,suc b) } ;
step (u : Pair) : Pair = step-at u.1 u.2 ;
unpair : Nat -> Pair = split { zero -> (zero,zero) ; suc m | r -> step r } ;
Hit (a b : Nat) : U l = (m : Nat) * Id Pair (unpair m) (a,b) ;
hit-step (a b : Nat) (h : Hit a b) : (m : Nat) * Id Pair (unpair m) (step-at a b) = (suc h.1,ap step h.2) ;
diag-zero (b : Nat) : (a : Nat) -> Id Nat (plus a b) zero -> Hit a b = split {
 zero -> \ h -> subst (\ c -> Hit zero c) (sym h) (zero,refl (zero,zero)) ;
 suc a -> \ h -> efq (suc-zero (plus a b) h) } ;
diag-suc (s : Nat) (rs : (b a : Nat) -> Id Nat (plus a b) s -> Hit a b) :
 (b a : Nat) -> Id Nat (plus a b) (suc s) -> Hit a b = split {
 zero -> \ a h -> subst (\ c -> Hit c zero) (sym (trans (sym (plus-zero a)) h)) (hit-step zero s (rs s zero (refl s))) ;
 suc b | rb -> \ a h -> hit-step (suc a) b (rb (suc a) (trans (sym (plus-suc a b)) h)) } ;
diag : (s b a : Nat) -> Id Nat (plus a b) s -> Hit a b = split {
 zero -> diag-zero ;
 suc s | r -> diag-suc s r } ;
hit (a b : Nat) : Hit a b = diag (plus a b) b a (refl (plus a b)) ;
-- (lists)
list-code : Shape -> Nat = split {
 nil -> zero ;
 cons d s | r -> suc (hit d r).1 } ;
decode-at : Nat -> Nat -> Shape = split {
 zero -> \ c -> nil ;
 suc f | r -> split {
  zero -> nil ;
  suc m -> cons (unpair m).1 (r (unpair m).2) } } ;
decode-list : (s : Shape) -> Id Shape (decode-at (len {Nat} s) (list-code s)) s = split {
 nil -> refl nil ;
 cons d s | r ->
  Pr.trans Shape _ (cons d (decode-at (len {Nat} s) (list-code s))) _
   (ap (\ p -> cons p.1 (decode-at (len {Nat} s) p.2)) (hit d (list-code s)).2) (ap (\ t -> cons d t) r) } ;
-- (code)
code (s : Shape) : Nat = (hit (len {Nat} s) (list-code s)).1 ;
decode (n : Nat) : Shape = decode-at (unpair n).1 (unpair n).2 ;
decode-code (s : Shape) : Id Shape (decode (code s)) s =
 trans (ap (\ p -> decode-at p.1 p.2) (hit (len {Nat} s) (list-code s)).2) (decode-list s) ;
