-- Theorem main (gabber-recollement).  A f.p., gerbes G x on Spec A, Lambda
-- of weight n = n0 + 1 whose fibres merely have bases of rank 1.  Let
-- u_0 .. u_k in A with sum_i u_i c_i = 1, and on each D(u_i) merely a line
-- datum: a localisation L_(u_i), a section of the gerbes G . p over
-- Spec L_(u_i) and a generator of the descended P(L)^v of the twisted line L
-- of the section (GOODLINE: L^n ~ Lambda).  Then merely there is a twisted
-- family on Spec A whose fibres merely have bases of one rank r0 + 1.
--  (line bases)  R has the basis (1, id) of rank 1; the twisted line at g is
--     merely R (TWISTEDLINE.frames, at a path s = g), so its fibres merely
--     have bases of rank 1 (HOMBASES.transport).
--  (base)  A line datum gives a good module on D(u): L has rank 1,
--     1^n = 1, and every representing projector p of P(L)^v has [p] = 1
--     (GOODLINE), so rho([p]) = rho(1) = 1 at N = 1 (TRANSPOSES.Rho.rho-one,
--     [1] = 1); GOODOPENS.Transfer moves it from Spec L_u to D(u).
--  (gamma)  u_i in Gamma (base), so u_i c_i in Gamma (GOODOPENS.multiple),
--     so sum_i u_i c_i in Gamma by induction on k (GOODSUMS.sum; for one
--     term, x + 0 = x), so 1 in Gamma (GOODOPENS.respect).
--  (global)  Every point x of Spec A is in D(1), as x(1) = 1; the good
--     module on D(1) is a family on Spec A.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module HB = HomBases[l].Over[R,setR,axioms] ;
 -- (line bases)
 top-dual : (t t' : Top) -> Id R.R R.o (MnAlgebra[l].Over[R,setR,suc zero].mone (inr t) (inr t')) = split {
  tt -> split { tt -> sym (MnSums[l].Over[R].delta-diag (suc zero) (inr tt)) } } ;
 regular-dual : (a b : Fin (suc zero)) -> Id R.R R.o (MnAlgebra[l].Over[R,setR,suc zero].mone a b) = split {
  inl v -> \ b -> absurd (Id R.R R.o (MnAlgebra[l].Over[R,setR,suc zero].mone (inl v) b)) v ;
  inr t -> split {
   inl v -> absurd (Id R.R R.o (MnAlgebra[l].Over[R,setR,suc zero].mone (inr t) (inl v))) v ;
   inr t' -> top-dual t t' } } ;
 regular-basis : LF.Basis[MD.regular,suc zero] = new LF.Basis[MD.regular,suc zero,FR.regular,regular-dual] ;
 module LineBasis (Gb : TM.GB.AGerbe) (s : Gb.1) {
  module TL = TwistedLine[l].Over[R,setR].At[Gb,s] ;
  basis (g : Gb.1) : Tr.Trunc[LF.Basis[TL.line g,suc zero]].carrier =
   Tr.Trunc[Id Gb.1 s g].induction @l (\ p -> Tr.Trunc[LF.Basis[TL.line g,suc zero]].carrier)
    (\ p -> Tr.Trunc[LF.Basis[TL.line g,suc zero]].proposition)
    (\ p -> HB.transport MD.regular (TL.line g)
     (Pr1.sym MD.Module (TL.line g) MD.regular TwistedLine[l].Over[R,setR].LA.Line.At[TwistedLine[l].Over[R,setR].LA.pre (TL.GL.PTor s g)].Based[p].module-equality)
     (suc zero) (Tr.Trunc[LF.Basis[MD.regular,suc zero]].inc regular-basis))
    (TL.GL.conn s g) ;
 } ;
 rank-one : (k : Nat) -> Id Nat (ML.rank (suc zero) (suc zero) k) (suc zero) = split {
  zero -> refl (suc zero) ;
  suc k | h -> h } ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TM.GB.AGerbe)
  (n0 : Nat) (Lambda : TM.Family[C.Spec A,G].Weighted (\ c -> TM.UG.power c (suc n0)))
  (bl : (x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier) {
  module GO = GoodOpens[l].Over[R,setR,axioms].At[A,fp,G,n0,Lambda,bl] ;
  module GS = GoodSums[l].Over[R,setR,axioms,loc].At[A,fp,G,n0,Lambda,bl] ;
  module S = FiniteIdeal[l].Sums[A.ring] ;
  -- the line data on D(u)
  module Lines (u : A.ring.R) {
   module OU = GO.On[u] ;
   record LineDatum {
    witness : AI.LocalizationWitness A u ;
    section : (y : C.Spec witness.1) -> (OU.gerbe witness y).1 ;
    sigma : GoodLine[l].Over[R,setR,axioms].At[witness.1,witness.2.1,OU.gerbe witness,section,suc n0,OU.lam witness].RE.FP.Sections ;
    c : GoodLine[l].Over[R,setR,axioms].At[witness.1,witness.2.1,OU.gerbe witness,section,suc n0,OU.lam witness].RE.FP.Forms ;
    law : (x : C.Spec witness.1)
     (m : (GoodLine[l].Over[R,setR,axioms].At[witness.1,witness.2.1,OU.gerbe witness,section,suc n0,OU.lam witness].PV.descended x).M) ->
     Id (GoodLine[l].Over[R,setR,axioms].At[witness.1,witness.2.1,OU.gerbe witness,section,suc n0,OU.lam witness].PV.descended x).M
      (ModuleFiniteSums[l].Over[R,setR,GoodLine[l].Over[R,setR,axioms].At[witness.1,witness.2.1,OU.gerbe witness,section,suc n0,OU.lam witness].PV.descended x].sum
        (suc zero) (\ k -> (GoodLine[l].Over[R,setR,axioms].At[witness.1,witness.2.1,OU.gerbe witness,section,suc n0,OU.lam witness].PV.descended x).sm
         ((c x).1 m) (sigma x))) m ;
    unit : (x : C.Spec witness.1) -> Id R.R ((c x).1 (sigma x)) R.o ;
   } ;
   -- (base)
   module FromLine (d : LineDatum) {
    module GL = GoodLine[l].Over[R,setR,axioms].At[d.witness.1,d.witness.2.1,OU.gerbe d.witness,d.section,suc n0,OU.lam d.witness] ;
    module GG = GL.Good[d.sigma,d.c,d.law,d.unit] ;
    module GM = GoodModules[l].Over[R,setR,axioms].At[d.witness.1,d.witness.2.1,OU.gerbe d.witness,n0,OU.lam d.witness] ;
    module T = Transposes[l].Over[d.witness.1.ring,d.witness.1.set] ;
    bases (y : C.Spec d.witness.1) (g : (OU.gerbe d.witness y).1) : Tr.Trunc[LF.Basis[GL.TL.twisted.1 y g,suc zero]].carrier =
     LineBasis[OU.gerbe d.witness y,d.section y].basis g ;
    good : GM.CO.Good GL.TL.twisted zero = \ w ->
     trans (ap T.Rho[zero].rho (GG.theorem GL.RE.FP.From[w].projector GL.RE.FP.From[w].representation))
      (T.Rho[zero].rho-one T.K.K0.o (ap T.Rho[zero].iota (sym T.IK.nat-one))) ;
    line-module : GM.GoodModule = new GM.GoodModule[GL.TL.twisted,zero,bases,zero,rank-one (suc n0),good] ;
    result : OU.Good = OU.Transfer[d.witness,line-module].result ;
   } ;
   base (d : Tr1.Trunc[LineDatum].carrier) : OU.Gamma = TC1.map LineDatum OU.Good (\ e -> FromLine[e].result) d ;
  } ;
  -- (gamma)
  sums : (k : Nat) (v : Fin (suc k) -> A.ring.R) -> ((i : Fin (suc k)) -> GO.On[v i].Gamma) ->
   GO.On[S.sum (suc k) v].Gamma = split {
   zero -> \ v h -> GO.respect (v (inr tt)) (S.sum (suc zero) v) (sym (A.ring.addZ (v (inr tt)))) (h (inr tt)) ;
   suc k | ih -> \ v h -> GS.sum (v (inr tt)) (S.sum (suc k) (\ i -> v (inl i))) (h (inr tt))
     (ih (\ i -> v (inl i)) (\ i -> h (inl i))) } ;
  Result : U l+ = (r0 : Nat) * (V : TM.Family[C.Spec A,G].Twisted) *
   ((x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[V.1 x g,suc r0]].carrier) ;
  -- (global)
  one-unit (x : C.Spec A) : RL[R].unit (x.1.1 A.ring.o) =
   Pr.subst R.R RL[R].unit R.o (x.1.1 A.ring.o) (sym x.1.2.1) (R.o,R.mulO R.o) ;
  global (M : GO.On[A.ring.o].Good) : Result =
   (M.rank0,(\ x g -> M.family.1 (x,one-unit x) g,\ x -> M.family.2 (x,one-unit x)),\ x g -> M.bases (x,one-unit x) g) ;
  module Main (k : Nat) (u c : Fin (suc k) -> A.ring.R)
   (one : Id A.ring.R (S.sum (suc k) (\ i -> A.ring.mul (u i) (c i))) A.ring.o)
   (lines : (i : Fin (suc k)) -> Tr1.Trunc[Lines[u i].LineDatum].carrier) {
   gamma : GO.On[A.ring.o].Gamma =
    GO.respect (S.sum (suc k) (\ i -> A.ring.mul (u i) (c i))) A.ring.o one
     (sums k (\ i -> A.ring.mul (u i) (c i)) (\ i -> GO.multiple (u i) (c i) (Lines[u i].base (lines i)))) ;
   theorem : Tr1.Trunc[Result].carrier = TC1.map GO.On[A.ring.o].Good Result global gamma ;
  } ;
 } ;
} ;
