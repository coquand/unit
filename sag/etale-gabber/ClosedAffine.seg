-- SAG 4.1.4 in its quotient and affineness forms. The equivalence to
-- the quotient spectrum lies over the original affine spectrum.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module Cl = ClosedProp[l].Over[R,setR] ; module Q = FiniteQuotient[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module At (A : C.Algebra) (fp : P.FP A) (sub : C.Spec A -> U l)
  (closed : Cl.ClosedSubtype (C.Spec A) sub) {
  module Global = ClosedGlobal[l].Over[R,setR,axioms].At[A,fp,sub,closed] ;
  Total : U l = (x : C.Spec A) * sub x ;
  Witness : U l+ = (n : Nat) * (gs : Fin n -> A.ring.R) * (q : Q.Witness A n gs) *
   (e : Pr.Equiv Total (C.Spec q.1)) *
   ((u : Total) -> Id (C.Spec A) (C.compose A q.1 C.base (e.1 u) q.2.2.1) u.1) ;
  module Equations (w : Global.Equations) {
   ZeroLocus : U l = (x : C.Spec A) * Cl.Zeros w.1 (\ i -> x.1.1 (w.2.1 i)) ;
   to (u : Total) : ZeroLocus = (u.1,(w.2.2 u.1).1 u.2) ;
   from (z : ZeroLocus) : Total = (z.1,(w.2.2 z.1).2.sec z.2) ;
   fb (z : ZeroLocus) : Id ZeroLocus (to (from z)) z =
    Pr.Sigma-eq (C.Spec A) (\ x -> Cl.Zeros w.1 (\ i -> x.1.1 (w.2.1 i))) _ _ _ _
     (refl z.1) (Cl.zeros-prop w.1 (\ i -> z.1.1.1 (w.2.1 i))) ;
   bf (u : Total) : Id Total (from (to u)) u =
    Pr.Sigma-eq (C.Spec A) sub _ _ _ _ (refl u.1) (Global.prop u.1) ;
   equivalence : Pr.Equiv Total ZeroLocus = (to,Pr.qinv _ _ to from fb bf) ;
   module QuotientData (q : Q.Witness A w.1 w.2.1) {
    spectrum : Pr.Equiv (C.Spec q.1) ZeroLocus = Q.spectrum A w.1 w.2.1 q ;
    e : Pr.Equiv Total (C.Spec q.1) =
     Equivalences[l].compose Total ZeroLocus (C.Spec q.1) equivalence
      (Functions[l].inverse (C.Spec q.1) ZeroLocus spectrum) ;
    over (u : Total) : Id (C.Spec A) (C.compose A q.1 C.base (e.1 u) q.2.2.1) u.1 =
     ap (\ z -> z.1) (spectrum.2.sec-eq (to u)) ;
    result : Witness = (w.1,w.2.1,q,e,over) ;
   } ;
   result : Tr1.Trunc[Witness].carrier =
    Tr1.Trunc[Q.Witness A w.1 w.2.1].induction @l+ (\ t -> Tr1.Trunc[Witness].carrier)
     (\ t -> Tr1.Trunc[Witness].proposition)
     (\ q -> Tr1.Trunc[Witness].inc QuotientData[q].result) (Q.quotient A fp w.1 w.2.1) ;
  } ;
  theorem : Tr1.Trunc[Witness].carrier =
   Tr.Trunc[Global.Equations].induction @l+ (\ t -> Tr1.Trunc[Witness].carrier)
    (\ t -> Tr1.Trunc[Witness].proposition) (\ w -> Equations[w].result) Global.theorem ;
  affine : FA.Affine Total =
   Tr1.Trunc[Witness].induction @l+ (\ t -> FA.Affine Total)
    (\ t -> Tr1.Trunc[FA.AffineWitness Total].proposition)
    (\ w -> Tr1.Trunc[FA.AffineWitness Total].inc (w.2.2.1.1,w.2.2.1.2.1,w.2.2.2.1)) theorem ;
 } ;
} ;
