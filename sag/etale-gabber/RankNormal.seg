-- One rank for the push-forward (GABBER-PROPER-DESIGN.md, section 3,
-- normalise; Gabber, Ch. II, Remark: on a quasi-compact X one may restrict
-- to constant rank).  V twisted on G : Spec A -> TGerbe with, at each x, a
-- rank k x: every V x g merely has a basis of rank k x + 1.
--  (bound)    k x <= L for one L (SAG 3.3.3, SCHEMEBOUNDED; Spec A affine).
--  (divide)   Put D 0 = 1, D (L+1) = (L+2) D L, so D L = (L+1)!.  Every m + 1
--             with m <= L divides D L: if m = L, D L = (L+1) D (L-1);
--             otherwise (m+1) | D (L-1) | D L.  Here N = D (L+1) = (q x + 1)(k x + 1)
--             with k x <= L <= L + 1, and N = n0 + 2 since D L > 0.
--  (power)    V' x g = V x g + ... + V x g, q x + 1 copies (EFFACE.power on the
--             families over the single point Top with fibres G x): weight 1,
--             as sums of weight-1 families have weight 1 (FAMILYMOVES.Sum), and
--             bases of rank (q x + 1)(k x + 1) = N (POWERBASES, RANKARITHMETIC).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ;
module RA = RankArithmetic[l] ;
times (m n : Nat) : Nat = Pairing[l].times m n ;
-- (divide)
times-plus : (a b c : Nat) -> Id Nat (times (plus a b) c) (plus (times a c) (times b c)) = split {
 zero -> \ b c -> refl (times b c) ;
 suc a | r -> \ b c -> trans (ap (\ t -> plus t c) (r b c)) (RA.swap-last (times a c) (times b c) c) } ;
times-assoc : (a b c : Nat) -> Id Nat (times (times a b) c) (times a (times b c)) = split {
 zero -> \ b c -> refl zero ;
 suc a | r -> \ b c -> trans (times-plus (times a b) b c) (ap (\ t -> plus t (times b c)) (r b c)) } ;
-- (a + 1)(b + 1) is a successor
pos (a b : Nat) : Id Nat (times (suc a) (suc b)) (suc (plus (times a (suc b)) b)) = plus-suc (times a (suc b)) b ;
two (a b : Nat) : Id Nat (times (suc (suc a)) (suc b)) (suc (suc (plus (plus (times a (suc b)) b) b))) =
 trans (pos (suc a) b) (ap (\ t -> suc (plus t b)) (pos a b)) ;
D : Nat -> Nat = split { zero -> suc zero ; suc L | d -> times (suc (suc L)) d } ;
D-pos : (L : Nat) -> (d : Nat) * Id Nat (D L) (suc d) = split {
 zero -> (zero,refl (suc zero)) ;
 suc L | r -> (plus (times (suc L) (suc r.1)) r.1,trans (ap (times (suc (suc L))) r.2) (pos (suc L) r.1)) } ;
le-zero : (m : Nat) -> CB.le m zero -> Id Nat m zero = split {
 zero -> \ h -> refl zero ;
 suc m -> \ h -> efq h } ;
le-suc : (m L : Nat) -> CB.le m L -> CB.le m (suc L) = split {
 zero -> \ L h -> tt ;
 suc m | r -> split {
  zero -> \ h -> efq h ;
  suc L -> \ h -> r L h } } ;
bump (m L : Nat) : Plus (Id Nat m (suc L)) (CB.le m L) -> Plus (Id Nat (suc m) (suc (suc L))) (CB.le (suc m) (suc L)) = split {
 inl e -> inl (ap (\ t -> suc t) e) ;
 inr h -> inr h } ;
le-cases : (m L : Nat) -> CB.le m (suc L) -> Plus (Id Nat m (suc L)) (CB.le m L) = split {
 zero -> \ L h -> inr tt ;
 suc m | r -> split {
  zero -> \ h -> inl (ap (\ t -> suc t) (le-zero m h)) ;
  suc L -> \ h -> bump m L (r L h) } } ;
Divides (m L : Nat) : U l = (q : Nat) * Id Nat (times (suc q) (suc m)) (D L) ;
module Step (L m : Nat) (r : CB.le m L -> Divides m L) {
 top (e : Id Nat m (suc L)) : Divides m (suc L) =
  ((D-pos L).1,Pr.subst Nat (\ k -> Id Nat (times (suc (D-pos L).1) (suc k)) (D (suc L))) (suc L) m (sym e)
   (trans (RA.times-comm (suc (D-pos L).1) (suc (suc L))) (ap (times (suc (suc L))) (sym (D-pos L).2)))) ;
 below (h : CB.le m L) : Divides m (suc L) =
  ((plus (times (suc L) (suc (r h).1)) (r h).1),
   calc Nat { times (suc (plus (times (suc L) (suc (r h).1)) (r h).1)) (suc m)
    =< ap (\ t -> times t (suc m)) (sym (pos (suc L) (r h).1)) > times (times (suc (suc L)) (suc (r h).1)) (suc m)
    =< times-assoc (suc (suc L)) (suc (r h).1) (suc m) > times (suc (suc L)) (times (suc (r h).1) (suc m))
    =< ap (times (suc (suc L))) (r h).2 > D (suc L) }) ;
 cases : Plus (Id Nat m (suc L)) (CB.le m L) -> Divides m (suc L) = split {
  inl e -> top e ;
  inr h -> below h } ;
} ;
divides : (L m : Nat) -> CB.le m L -> Divides m L = split {
 zero -> split {
  zero -> \ h -> (zero,refl (suc zero)) ;
  suc m -> \ h -> efq h } ;
 suc L | r -> \ m h -> Step[L,m,r m].cases (le-cases m L h) } ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module FM = FamilyMoves[l].Over[R,setR,axioms] ;
 module TP = TwistedPush[l].Over[R,setR,axioms,sh] ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TG.TGerbe) {
  module PA = TP.At[A,fp,G] ;
  X : U l = C.Spec A ;
  -- (power) at one point x
  module Power (x : X) (V : PA.T x) (wv : PA.Twisted x V) {
   module FS = MS.Families[Top,\ v -> (G x).carrier] ;
   F : FS.Fam = \ v g -> V g ;
   power (e : Nat) : PA.T x = \ g -> FS.E.power e F tt g ;
   weight : (e : Nat) -> PA.Twisted x (power e) = split {
    zero -> wv ;
    suc e | w -> FM.Sum[TG.At[G x].banded,\ a -> a,V,power e,wv,w].weight } ;
   bases (k : Nat) (b : PA.Bases k x V) (e : Nat) : (g : (G x).carrier) ->
    Tr.Trunc[LF.Basis[power e g,suc (RA.copies k e)]].carrier = \ g ->
    PowerBases[l].Over[R,setR,axioms].At[Top,\ v -> (G x).carrier].bases F k (\ v -> b) e tt g ;
  } ;
  Result : U l+ = (n0 : Nat) * (V : (x : X) -> PA.T x) * ((x : X) -> PA.Twisted x (V x))
   * ((x : X) -> PA.Bases (suc n0) x (V x)) ;
  module Normal (V : (x : X) -> PA.T x) (wv : (x : X) -> PA.Twisted x (V x))
   (rk : (x : X) -> (k : Nat) * PA.Bases k x (V x)) (L : Nat) (bd : (x : X) -> CB.le (rk x).1 L) {
   k (x : X) : Nat = (rk x).1 ;
   dv (x : X) : Divides (k x) (suc L) = divides (suc L) (k x) (le-suc (k x) L (bd x)) ;
   q (x : X) : Nat = (dv x).1 ;
   n0 : Nat = plus (plus (times L (suc (D-pos L).1)) (D-pos L).1) (D-pos L).1 ;
   N-eq : Id Nat (D (suc L)) (suc (suc n0)) =
    trans (ap (times (suc (suc L))) (D-pos L).2) (two L (D-pos L).1) ;
   rank-eq (x : X) : Id Nat (suc (RA.copies (k x) (q x))) (suc (suc n0)) =
    trans (RA.copies-times (k x) (q x)) (trans (dv x).2 N-eq) ;
   V' (x : X) : PA.T x = Power[x,V x,wv x].power (q x) ;
   weight (x : X) : PA.Twisted x (V' x) = Power[x,V x,wv x].weight (q x) ;
   bases (x : X) : PA.Bases (suc n0) x (V' x) = \ g ->
    Pr.subst Nat (\ r -> Tr.Trunc[LF.Basis[V' x g,r]].carrier) _ _ (rank-eq x)
     (Power[x,V x,wv x].bases (k x) (rk x).2 (q x) g) ;
   result : Result = (n0,V',weight,bases) ;
  } ;
  -- (bound)
  theorem (V : (x : X) -> PA.T x) (wv : (x : X) -> PA.Twisted x (V x))
   (rk : (x : X) -> (k : Nat) * PA.Bases k x (V x)) : Tr.Trunc[SchemeBounded[l].Over[R,setR,axioms].Goal X (\ x -> (rk x).1)].carrier
   -> Truncation[l+].Trunc[Result].carrier =
   Tr.Trunc[SchemeBounded[l].Over[R,setR,axioms].Goal X (\ x -> (rk x).1)].induction @(l+)
    (\ t -> Truncation[l+].Trunc[Result].carrier) (\ t -> Truncation[l+].Trunc[Result].proposition)
    (\ b -> Truncation[l+].Trunc[Result].inc Normal[V,wv,rk,b.1,b.2].result) ;
  normalised (V : (x : X) -> PA.T x) (wv : (x : X) -> PA.Twisted x (V x))
   (rk : (x : X) -> (k : Nat) * PA.Bases k x (V x)) : Truncation[l+].Trunc[Result].carrier =
   theorem V wv rk (SchemeBounded[l].Over[R,setR,axioms].theorem X (TowerAffine[l].Over[R,setR,axioms].spec A fp) (\ x -> (rk x).1)) ;
 } ;
} ;
