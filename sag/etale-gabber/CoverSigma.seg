-- A cover of the base lifts to any dependent sum.
-- Local total spaces need only be schemes; no dependent-sum theorem is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module M = SchemeMaps[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module SC = SchemeCover[l].Over[R,setR,axioms] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module At (X : U l) (c : S.Cover[X]) (Y : X -> U l) {
  Total : U l = (x : X) * Y x ;
  Local (i : Fin c.size) : U l = (a : S.Domain X (c.charts i)) * Y ((c.charts i).map a) ;
  us (i : Fin c.size) (z : Total) : U l = S.Image X (c.charts i) z.1 ;
  opens (i : Fin c.size) (z : Total) : OP.Open (us i z) = (c.charts i).open-image z.1 ;
  module Part (i : Fin c.size) {
   chart : S.Chart[X] = c.charts i ;
   module E = M.Embedded[S.Domain X chart,X,chart.map,chart.embedding] ;
   Middle : U l = (u : E.Total) * Y u.1 ;
   reindex : Pr.Equiv (Local i) Middle =
    SigmaTools[l].base (S.Domain X chart) E.Total E.equivalence (\ u -> Y u.1) ;
   exchange : Pr.Equiv Middle ((z : Total) * us i z) =
    (\ v -> ((v.1.1,v.2),v.1.2),
     Pr.qinv Middle ((z : Total) * us i z) (\ v -> ((v.1.1,v.2),v.1.2))
      (\ v -> ((v.1.1,v.2),v.1.2)) (\ v -> refl v) (\ v -> refl v)) ;
   equivalence : Pr.Equiv (Local i) ((z : Total) * us i z) =
    Equivalences[l].compose _ _ _ reindex exchange ;
  } ;
  covers (z : Total) : Tr.Trunc[(i : Fin c.size) * us i z].carrier = c.covers z.1 ;
  theorem (locals : (i : Fin c.size) -> S.Scheme (Local i)) : S.Scheme Total =
   SC.At[Total,c.size,us,opens,\ i -> SB.along _ _ Part[i].equivalence (locals i),covers].theorem ;
 } ;
} ;
