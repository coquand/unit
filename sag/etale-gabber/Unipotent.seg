-- Matrices 1 + x A, for a scalar x.  In any matrix algebra
--   (1 + x A)(1 + x B) = 1 + x (A + (B + x A B))        (product)
-- and 1 + x A = 1 gives x A = 0 (cancel).  A ring map f sends 1 + x A to
-- 1 + f(x) f(A) (map-uni).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (N : Nat) {
 module M = MnAlgebra[l].Over[R,setR,N] ;
 uni (x : R.R) (A : M.Mat) : M.Mat = M.madd M.mone (M.mscale x A) ;
 product-term (x : R.R) (A B : M.Mat) : M.Mat = M.madd A (M.madd B (M.mscale x (M.mmul A B))) ;
 -- (1 + x A) B = B + x A B
 right-factor (x : R.R) (A B : M.Mat) :
  Id M.Mat (M.mmul (uni x A) B) (M.madd B (M.mscale x (M.mmul A B))) =
  trans (M.m-dist-right M.mone (M.mscale x A) B)
   (cong2 M.Mat M.madd _ _ _ _ (M.m-one-left B) (M.m-scale-mul-left x A B)) ;
 product (x : R.R) (A B : M.Mat) :
  Id M.Mat (M.mmul (uni x A) (uni x B)) (uni x (product-term x A B)) =
  calc M.Mat { M.mmul (uni x A) (uni x B)
    =< M.m-dist-left (uni x A) M.mone (M.mscale x B) >
       M.madd (M.mmul (uni x A) M.mone) (M.mmul (uni x A) (M.mscale x B))
    =< cong2 M.Mat M.madd _ _ _ _ (M.m-one-right (uni x A))
        (trans (M.m-scale-mul-right x (uni x A) B) (ap (M.mscale x) (right-factor x A B))) >
       M.madd (uni x A) (M.mscale x (M.madd B (M.mscale x (M.mmul A B))))
    =< sym (M.m-addA M.mone (M.mscale x A) (M.mscale x (M.madd B (M.mscale x (M.mmul A B))))) >
       M.madd M.mone (M.madd (M.mscale x A) (M.mscale x (M.madd B (M.mscale x (M.mmul A B)))))
    =< ap (M.madd M.mone) (sym (M.m-scale-add x A (M.madd B (M.mscale x (M.mmul A B))))) >
       uni x (product-term x A B) } ;
 cancel (x : R.R) (A : M.Mat) (h : Id M.Mat (uni x A) M.mone) : Id M.Mat (M.mscale x A) M.mzero =
  M.mat-eq (M.mscale x A) M.mzero (\ i j ->
   RL[R].add-cancel (M.mone i j) (R.mul x (A i j)) (ap (\ m -> m i j) h)) ;
 -- 1 + x 0 = 1
 uni-zero (x : R.R) : Id M.Mat (uni x M.mzero) M.mone =
  trans (ap (M.madd M.mone) (M.mat-eq (M.mscale x M.mzero) M.mzero (\ i j -> RL[R].mul-zero x)))
   (M.m-addZ M.mone) ;
} ;
module Map (X Y : CRing) (setX : Pr.isSet X.R) (setY : Pr.isSet Y.R) (f : H.Hom X Y) (N : Nat) {
 module UX = Over[X,setX,N] ;
 module UY = Over[Y,setY,N] ;
 module MM = MatrixMap[l].Over[X,Y,setX,setY,f,N] ;
 map-uni (x : X.R) (A : UX.M.Mat) : Id UY.M.Mat (MM.map (UX.uni x A)) (UY.uni (f.1 x) (MM.map A)) =
  trans (MM.map-add UX.M.mone (UX.M.mscale x A))
   (cong2 UY.M.Mat UY.M.madd _ _ _ _ MM.map-one (MM.map-scale x A)) ;
} ;
