-- The module glued along the identity is free: A^M ~ P_1 (GLUEDMODULE), by
--     r |-> (ia r, ib r),
-- whose inverse sends (u, v) in P_1 (so jb(v) = 1 ja(u) = ja(u)) to the
-- unique r with ia r = u and ib r = v, entrywise (EQUALISER).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module SM = SerreModule[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R) (setAb : Pr.isSet Ab.R)
 (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (M : Nat) {
 module G = GluedModule[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,M] ;
 module Eq = Equaliser[l].Over[A,Aa,Ab,C,setA,setAa,setAb,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal] ;
 module P1 = G.Glue[G.MC.mone] ;
 -- A^M
 module F = SP.Over[A,Fin M,\ i -> SM.Over[A].regular setA] ;
 free : SM.Over[A].Module = F.product ;
 include-member (r : F.Carrier) :
  Id G.VC.Vec (G.JB.map (\ i -> ib.1 (r i))) (G.VC.act G.MC.mone (G.JA.map (\ i -> ia.1 (r i)))) =
  trans (G.VC.vec-eq _ _ (\ i -> sym (square (r i)))) (sym (G.VC.act-one (G.JA.map (\ i -> ia.1 (r i))))) ;
 include (r : F.Carrier) : P1.Carrier = P1.point (\ i -> ia.1 (r i)) (\ i -> ib.1 (r i)) (include-member r) ;
 -- the entries of a point of P_1 agree in C
 agree (x : P1.Carrier) (i : Fin M) : Id C.R (ja.1 (P1.left x i)) (jb.1 (P1.right x i)) =
  sym (G.VC.entry _ _ (trans (P1.member x) (G.VC.act-one (G.JA.map (P1.left x)))) i) ;
 entry (x : P1.Carrier) (i : Fin M) : Eq.Preimage (P1.left x i) (P1.right x i) =
  Eq.preimage (P1.left x i) (P1.right x i) (agree x i) ;
 restore (x : P1.Carrier) : F.Carrier = \ i -> (entry x i).1 ;
 iso : G.MI.Iso[free,P1.glued] = G.MI.make free P1.glued include restore
  (\ r s -> P1.ext _ _ (G.VAa.vec-eq _ _ (\ i -> ia.2.2.1 (r i) (s i))) (G.VAb.vec-eq _ _ (\ i -> ib.2.2.1 (r i) (s i))))
  (\ c r -> P1.ext _ _ (G.VAa.vec-eq _ _ (\ i -> ia.2.2.2 c (r i))) (G.VAb.vec-eq _ _ (\ i -> ib.2.2.2 c (r i))))
  (\ x -> P1.ext _ _ (G.VAa.vec-eq _ _ (\ i -> (entry x i).2.1)) (G.VAb.vec-eq _ _ (\ i -> (entry x i).2.2)))
  (\ r -> F.ext _ _ (\ i -> Eq.Unique[(entry (include r) i).1,r i,(entry (include r) i).2.1,(entry (include r) i).2.2].equal)) ;
} ;
