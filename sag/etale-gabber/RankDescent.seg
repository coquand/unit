-- Descent of a natural number along close (GABBER-PROPER-DESIGN.md, section 3:
-- the rank of the pushed-forward module).  Y is inhabited locally (close Y)
-- and merely connected; k : Y -> Nat.  Then
--     Rank = (k0 : Nat) * ((y : Y) -> k y = k0)
-- is a proposition (two values agree at a local point of Y, and equality of
-- naturals is a sheaf, NATSHEAF), a sheaf (Sigma, Pi and identities of the
-- sheaf Nat), and close-inhabited (at y take k0 = k y; any y' is merely
-- equal to y).  So sh.elim gives Rank: k is constant, with a value that
-- does not depend on a chosen point.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module S0 = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module NS = NatSheaf[l].Over[R,setR,axioms] ;
 module At (Y : U l) (inh : sh.close Y) (conn : (a b : Y) -> Tr.Trunc[Id Y a b].carrier) (k : Y -> Nat) {
  Rank : U l = (k0 : Nat) * ((y : Y) -> Id Nat (k y) k0) ;
  agree (p q : Rank) : Id Nat p.1 q.1 =
   sh.elim @l Y (Id Nat p.1 q.1) (NatSheaf[l].nat-set p.1 q.1) (S0.modal-Id Nat NS.sheaf p.1 q.1)
    (\ y -> trans (sym (p.2 y)) (q.2 y)) inh ;
  rank-prop : Pr.isProp Rank = \ p q ->
   Pr.Sigma-eq Nat (\ k0 -> (y : Y) -> Id Nat (k y) k0) p.1 q.1 p.2 q.2 (agree p q)
    (F.isProp-Pi Y (\ y -> Id Nat (k y) q.1) (\ y -> NatSheaf[l].nat-set (k y) q.1)) ;
  rank-sheaf : ET.T.isModal @l Rank =
   S0.modal-Sigma Nat (\ k0 -> (y : Y) -> Id Nat (k y) k0) NS.sheaf (\ k0 ->
    S0.modal-Pi Y (\ y -> Id Nat (k y) k0) (\ y -> S0.modal-Id Nat NS.sheaf (k y) k0)) ;
  at (y : Y) : Rank =
   (k y,\ y' -> Tr.Trunc[Id Y y' y].induction @l (\ c -> Id Nat (k y') (k y)) (\ c -> NatSheaf[l].nat-set (k y') (k y))
     (\ e -> ap k e) (conn y' y)) ;
  rank : Rank = sh.elim @l Y Rank rank-prop rank-sheaf at inh ;
 } ;
} ;
