-- The push-forward of a twisted module along a tower (GABBER-PROPER-DESIGN.md,
-- section 3).  A f.p., G : Spec A -> TGerbe, t a tower over Spec A, W a
-- twisted family on the points z of t (over G (base z)) whose fibres merely
-- have bases of rank r0+1.  For x : Spec A let Y_x be the points of t pulled
-- back to the point x (TOWERS.pull along Top -> Spec A); a point z of Y_x
-- lies over x (pull-base), which moves W (up z) to a family over G x.  Put
--     V x g = (z : Y_x) -> W_x z g.
--  (move)    Moving a family over G x' along a path x' = x keeps its
--            weight and its bases (J).
--  (weight)  Transport in a product family is pointwise transport (J), so
--            V x has weight 1 when each W_x z has.
--  (bases)   Y_x is affine (TOWERAFFINE, over Top), its functions have a
--            frame of rank (rank s) (TOWERSCALARS.Tower), it is not-not
--            inhabited (TOWERSCALARS.top-inhabited): PUSHSECTIONS.affine
--            gives each V x g merely a basis of positive rank.
--  (rank)    k g = the rank of V x g (PUSHSECTIONS.Rank, a proposition) is
--            constant on G x (RANKDESCENT: G x is close-inhabited, connected).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module TW = Towers[l].Over[R,setR] ;
 module TF = TowerFunctions[l].Over[R,setR,axioms] ;
 module TS = TowerScalars[l].Over[R,setR,axioms] ;
 module PS = PushSections[l].Over[R,setR,axioms] ;
 -- (weight) for a product of families over one banded groupoid
 module Product (B : TM.Banded) (Z : U l) (W : Z -> B.1 -> MD.Module) {
  module TB = TM.At[TM.charge (B)] ;
  V (g : B.1) : MD.Module = MD.pi Z (\ z -> W z g) ;
  move-pi (g g' : B.1) (p : Id B.1 g g') (s : (V g).M) :
   Id (V g').M (TB.Move[V].move g g' p s) (\ z -> TB.Move[W z].move g g' p (s z)) =
   idJ B.1 g (\ g2 p2 -> Id (V g2).M (TB.Move[V].move g g2 p2 s) (\ z -> TB.Move[W z].move g g2 p2 (s z))) (refl s) g' p ;
  weight (chi : TM.UG.Unit -> TM.UG.Unit) (w : (z : Z) -> TB.Weight chi (W z)) : TB.Weight chi V = \ g p s ->
   trans (move-pi g g p s) (F.funext Z (\ z -> (W z g).M) _ _ (\ z -> w z g p (s z))) ;
 } ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TG.TGerbe) {
  X : U l = C.Spec A ;
  T (x : X) : U l+ = (G x).carrier -> MD.Module ;
  Twisted (x : X) (V : T x) : U l = TM.At[TM.charge (TG.At[G x].banded)].Weight (\ a -> a) V ;
  Bases (r : Nat) (x : X) (V : T x) : U l = (g : (G x).carrier) -> Tr.Trunc[LF.Basis[V g,suc r]].carrier ;
  -- (move)
  move (x x' : X) (e : Id X x x') (V : T x) : T x' = idJ X x (\ x2 e2 -> T x2) V x' e ;
  keep (Q : (x : X) -> T x -> U l) (x x' : X) (e : Id X x x') (V : T x) (q : Q x V) : Q x' (move x x' e V) =
   idJ X x (\ x2 e2 -> Q x2 (move x x2 e2 V)) q x' e ;
  module Tower (s : Towers[l].Shape) (t : TW.Tower s X) (r0 : Nat)
   (W : (z : TW.Points s X t) -> T (TW.base s X t z))
   (wt : (z : TW.Points s X t) -> Twisted (TW.base s X t z) (W z))
   (wb : (z : TW.Points s X t) -> Bases r0 (TW.base s X t z) (W z)) {
   -- the fibre over x
   pt (x : X) (v : Top) : X = x ;
   fibre (x : X) : TW.Tower s Top = TW.pull s X Top (pt x) t ;
   Fib (x : X) : U l = TW.Points s Top (fibre x) ;
   up (x : X) (z : Fib x) : TW.Points s X t = TW.pull-points s X Top (pt x) t z ;
   over (x : X) (z : Fib x) : Id X (TW.base s X t (up x z)) x = TW.pull-base s X Top (pt x) t z ;
   Wx (x : X) (z : Fib x) : T x = move (TW.base s X t (up x z)) x (over x z) (W (up x z)) ;
   wt-x (x : X) (z : Fib x) : Twisted x (Wx x z) = keep Twisted (TW.base s X t (up x z)) x (over x z) (W (up x z)) (wt (up x z)) ;
   wb-x (x : X) (z : Fib x) : Bases r0 x (Wx x z) = keep (Bases r0) (TW.base s X t (up x z)) x (over x z) (W (up x z)) (wb (up x z)) ;
   -- the push-forward
   V (x : X) (g : (G x).carrier) : MD.Module = MD.pi (Fib x) (\ z -> Wx x z g) ;
   weight (x : X) : Twisted x (V x) = Product[TG.At[G x].banded,Fib x,Wx x].weight (\ a -> a) (wt-x x) ;
   -- (bases)
   positive (x : X) (g : (G x).carrier) : PS.Result (Fib x) (\ z -> Wx x z g) =
    PS.affine (Fib x) (TowerAffine[l].Over[R,setR,axioms].points s Top SchemeBasics[l].Over[R,setR].top-affine (fibre x))
     (\ z -> Wx x z g) (TF.rank s) TS.Tower[s,fibre x].frame (TS.top-inhabited s (fibre x)) r0 (\ z -> wb-x x z g) ;
   rank-at (x : X) (g : (G x).carrier) : PS.Rank (V x g) = PS.extract (V x g) (positive x g) ;
   -- (rank)
   module RD (x : X) {
    module D = RankDescent[l].Over[R,setR,axioms,sh].At[(G x).carrier,(G x).inh,TG.At[G x].connected,\ g -> (rank-at x g).1] ;
   } ;
   rank (x : X) : Nat = RD[x].D.rank.1 ;
   bases (x : X) : Bases (rank x) x (V x) = \ g ->
    Pr.subst Nat (\ k -> Tr.Trunc[LF.Basis[V x g,suc k]].carrier) (rank-at x g).1 (rank x) (RD[x].D.rank.2 g) (rank-at x g).2 ;
  } ;
 } ;
} ;
