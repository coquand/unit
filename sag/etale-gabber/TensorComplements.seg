-- Complements under U [x] - (MATRIXTENSOR, COMPLEMENTS).
--  (pointwise)  For a projector p of size K over R, the vector maps of
--     COMPLEMENTS.Complement, (y, z) |-> y + z and w |-> (p w, (1 - p) w),
--     are inverse linear maps I p + I (1 - p) ~ R^K: p (y + z) = y and
--     (1 - p)(y + z) = z (left-join, right-join), p w + (1 - p) w = w
--     (join-parts).  So, with Hom(A + B, U) = Hom(A, U) + Hom(B, U) and
--     R^K = I 1_K (HOMSUMS, TENSORPOWERS),
--         U [x] p + U [x] (1 - p) = U [x] 1_K.
--  (family)  For a projector q over Alg and a family U over the G x
--     (DATUM.tensor): at x, q(x) is the base change of q along x
--     (PROJECTORMAP) and (1 - q)(x) = 1 - q(x), as x is a ring map
--     (entrywise: x(delta - q_ij) = delta - x(q_ij)).  So, pointwise,
--         U [x] q + U [x] (1 - q) = U [x] 1_K.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module HS = HomSums[l].Over[R,setR] ;
 module TP = TensorPowers[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module CR = Complements[l].Over[R,setR] ;
 module L = RL[R] ;
 -- (pointwise)
 module Of (p : CR.PJ.Projector) {
  module CP = CR.Complement[p] ;
  module V = CP.V ;
  module IP = MT.Image[p.size,p.matrix] ;
  module IC = MT.Image[p.size,CP.matrix] ;
  module P2 = MS.Pair[MT.I p.size p.matrix,MT.I p.size CP.matrix] ;
  join (y : P2.Carrier) : V.Vec = CP.join y ;
  parts (w : V.Vec) : P2.Carrier = CP.parts w ;
  parts-join (y : P2.Carrier) : Id P2.Carrier (parts (join y)) y =
   P2.pair-eq _ _ _ _ (IP.ext _ _ (CP.left-join y)) (IC.ext _ _ (CP.right-join y)) ;
  image : Id MD.Module (MS.plus (MT.I p.size p.matrix) (MT.I p.size CP.matrix)) (MT.free p.size) =
   SIP.sip (MS.plus (MT.I p.size p.matrix) (MT.I p.size CP.matrix)) (MT.free p.size)
    ((join,Pr.qinv P2.Carrier V.Vec join parts CP.join-parts parts-join),
     \ y y' -> V.vec-eq _ _ (\ i -> L.swap (y.1.1 i) (y'.1.1 i) (y.2.1 i) (y'.2.1 i)),
     \ c y -> V.vec-eq _ _ (\ i -> sym (R.dist c (y.1.1 i) (y.2.1 i)))) ;
  theorem (U1 : MD.Module) :
   Id MD.Module (MS.plus (MT.tensor U1 p.size p.matrix) (MT.tensor U1 p.size CP.matrix)) (MT.tensor U1 p.size (TP.one p.size)) =
   Pr1.trans MD.Module (MS.plus (MT.tensor U1 p.size p.matrix) (MT.tensor U1 p.size CP.matrix))
    (TP.hom U1 (MS.plus (MT.I p.size p.matrix) (MT.I p.size CP.matrix))) (MT.tensor U1 p.size (TP.one p.size))
    (Pr1.sym MD.Module (TP.hom U1 (MS.plus (MT.I p.size p.matrix) (MT.I p.size CP.matrix)))
     (MS.plus (MT.tensor U1 p.size p.matrix) (MT.tensor U1 p.size CP.matrix))
     HS.Sum[MT.I p.size p.matrix,MT.I p.size CP.matrix,U1].theorem)
    (Pr1.trans MD.Module (TP.hom U1 (MS.plus (MT.I p.size p.matrix) (MT.I p.size CP.matrix))) (TP.hom U1 (MT.free p.size))
     (MT.tensor U1 p.size (TP.one p.size))
     (TP.on U1 _ _ image)
     (TP.on U1 (MT.free p.size) (MT.I p.size (TP.one p.size))
      (Pr1.sym MD.Module (MT.I p.size (TP.one p.size)) (MT.free p.size) (TP.identity p.size)))) ;
 } ;
 -- (family)
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TwistedFrames[l].Over[R,setR].TM.GB.AGerbe) {
  module DA = Datum[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  module CA = Complements[l].Over[Alg.ring,Alg.set] ;
  module Family (q : CA.PJ.Projector) {
   module CQ = CA.Complement[q] ;
   module MN = DA.Mats[q.size] ;
   module Pt (x : DA.X) {
    module PM = ProjectorMap[l].Over[Alg.ring,R,Alg.set,setR,x.1] ;
    module MM = PM.At[q.size].MM ;
    module OX = Of[PM.map q] ;
    -- (1 - q)(x) = 1 - q(x)
    entry (i j : Fin q.size) : Id R.R (MN.at x CQ.matrix i j) (OX.CP.matrix i j) =
     trans (x.1.2.2.1 (MN.MA.mone i j) (MN.MA.mneg q.matrix i j))
      (cong2 R.R R.add _ _ _ _ (MM.delta-map q.size i j) (H.negation Alg.ring R x.1 (q.matrix i j))) ;
    matrix : Id MN.MR.Mat (MN.at x CQ.matrix) OX.CP.matrix = MN.MR.mat-eq _ _ entry ;
    theorem (U1 : MD.Module) :
     Id MD.Module (MS.plus (MT.tensor U1 q.size (MN.at x q.matrix)) (MT.tensor U1 q.size (MN.at x CQ.matrix)))
      (MT.tensor U1 q.size (TP.one q.size)) =
     Pr1.trans MD.Module (MS.plus (MT.tensor U1 q.size (MN.at x q.matrix)) (MT.tensor U1 q.size (MN.at x CQ.matrix)))
      (MS.plus (MT.tensor U1 q.size (MN.at x q.matrix)) (MT.tensor U1 q.size OX.CP.matrix)) (MT.tensor U1 q.size (TP.one q.size))
      (Pr1.ap MN.MR.Mat MD.Module (\ e -> MS.plus (MT.tensor U1 q.size (MN.at x q.matrix)) (MT.tensor U1 q.size e))
       (MN.at x CQ.matrix) OX.CP.matrix matrix)
      (OX.theorem U1) ;
   } ;
   at (U1 : DA.FS.Fam) (x : DA.X) (g : (G x).1) :
    Id MD.Module (DA.FS.add (DA.tensor U1 q.size q.matrix) (DA.tensor U1 q.size CQ.matrix) x g)
     (MT.tensor (U1 x g) q.size (TP.one q.size)) =
    Pr1.trans MD.Module (DA.FS.add (DA.tensor U1 q.size q.matrix) (DA.tensor U1 q.size CQ.matrix) x g)
     (MS.plus (DA.tensor U1 q.size q.matrix x g) (DA.tensor U1 q.size CQ.matrix x g)) (MT.tensor (U1 x g) q.size (TP.one q.size))
     (refl (MS.plus (DA.tensor U1 q.size q.matrix x g) (DA.tensor U1 q.size CQ.matrix x g)))
     (Pt[x].theorem (U1 x g)) ;
   theorem (U1 : DA.FS.Fam) :
    Id DA.FS.Fam (DA.FS.add (DA.tensor U1 q.size q.matrix) (DA.tensor U1 q.size CQ.matrix))
     (\ x g -> MT.tensor (U1 x g) q.size (TP.one q.size)) =
    DA.FS.pointwise (DA.FS.add (DA.tensor U1 q.size q.matrix) (DA.tensor U1 q.size CQ.matrix))
     (\ x g -> MT.tensor (U1 x g) q.size (TP.one q.size)) (at U1) ;
  } ;
 } ;
} ;
