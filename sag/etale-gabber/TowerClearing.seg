-- Clearing the denominators of a tower (GABBER-PROPER-DESIGN.md, section 2,
-- Globalise step 3).  A f.p., w in A, t a tower of shape s over
-- D(w) = (x : Spec A) * (x(w) a unit).  Then merely a tower t' of the same
-- shape over Spec A and a map E from the points of t' over D(w) to the
-- points of t, over the identity of D(w)  (Clearing.theorem, restrict).
-- A map, not an equivalence, is all the cover argument uses: a point of t'
-- over y with w(y) a unit gives a point of t over y.
--  (frame)  The induction carries a Frame: a type Y (points of the cleared
--           prefix), its part YD over D(w) with incl : YD -> Y, a function
--           w on Y which is a unit on YD, and the fraction property: a
--           vector g of functions on YD is merely b / w^k with b on Y.
--           Base: Y = Spec A, YD = D(w) (OPENFRACTIONS, one exponent for
--           the vector: k_0 + K for both parts).
--  (next)   Adding a stage with coefficients a on Y keeps the property:
--           g on YD' = (y : YD) * Root (a y) is, at each y, the power-basis
--           expansion of coefficients in (R^n)^(d+1) (TOWERFUNCTIONS.Stage),
--           flattened to R^((d+1) n) (PAIRING); the fractions b / w^K of
--           these on Y, expanded again over Y' = (y : Y) * Root (a y), give
--           b' with b' = w^K g on YD' (the expansion is R-linear).
--  (clear)  By induction on the shape, for any frame and any map e : YD -> X
--           to the base of the old tower.  A stage with coefficients c on X:
--           c . e is merely b / w^k (frame); the new coefficients are
--           scaled (w^k) b on Y (ROOTRESCALING), and x |-> x / w^k maps
--           their roots over YD to roots of c (root-map); the rest of the
--           old tower is cleared over the next frame along this map.
-- The coefficients of later stages are thus taken along the map of the
-- prefixes, which accounts for the earlier rescalings.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PA = Pairing[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module OF = OpenFractions[l].Over[R,setR,axioms] ;
 module TW = Towers[l].Over[R,setR] ;
 module TF = TowerFunctions[l].Over[R,setR,axioms] ;
 module RS = RootRescaling[l].Over[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 module L = RL[R] ;
 -- (frame)
 Fraction (Y YD : U l) (incl : YD -> Y) (w : Y -> R.R) (n : Nat) (g : YD -> TF.Vec n) : U l =
  (b : Y -> TF.Vec n) * (k : Nat) *
   ((y : YD) (j : Fin n) -> Id R.R (b (incl y) j) (R.mul (Pow.power (w (incl y)) k) (g y j))) ;
 record Frame {
  Y : U l ; YD : U l ;
  incl : YD -> Y ;
  w : Y -> R.R ;
  unit-w : (y : YD) -> L.unit (w (incl y)) ;
  fractions : (n : Nat) (g : YD -> TF.Vec n) -> Tr.Trunc[Fraction Y YD incl w n g].carrier ;
 } ;
 -- x^a (x^b g) = x^(a+b) g
 two-powers (x : R.R) (a b : Nat) (g : R.R) :
  Id R.R (R.mul (Pow.power x a) (R.mul (Pow.power x b) g)) (R.mul (Pow.power x (plus a b)) g) =
  trans (R.mulA (Pow.power x a) (Pow.power x b) g) (ap (\ t -> R.mul t g) (sym (Pow.power-add x a b))) ;
 -- base frame: Spec A and D(w)
 module Principal (A : C.Algebra) (fp : P.FP A) (w : A.ring.R) {
  Y : U l = C.Spec A ;
  YD : U l = I.D A w ;
  incl (x : YD) : Y = x.1 ;
  value (y : Y) : R.R = y.1.1 w ;
  module Combine (n : Nat) (g : YD -> TF.Vec (suc n)) (f0 : OF.At[A,fp,w,\ x -> g x (inr tt)].Rep)
   (fr : Fraction Y YD incl value n (\ x j -> g x (inl j))) {
   b (y : Y) : TF.Vec (suc n) = split {
    inl j -> R.mul (Pow.power (value y) f0.2.1) (fr.1 y j) ;
    inr u -> R.mul (Pow.power (value y) fr.2.1) (y.1.1 f0.1) } ;
   top (x : YD) : (u : Top) ->
    Id R.R (b (incl x) (inr u)) (R.mul (Pow.power (value (incl x)) (plus f0.2.1 fr.2.1)) (g x (inr u))) = split {
    tt -> trans (ap (R.mul (Pow.power (value (incl x)) fr.2.1)) (f0.2.2 x))
     (trans (L.mul-swap (Pow.power (value (incl x)) fr.2.1) (Pow.power (value (incl x)) f0.2.1) (g x (inr tt)))
      (two-powers (value (incl x)) f0.2.1 fr.2.1 (g x (inr tt)))) } ;
   equation (x : YD) : (j : Fin (suc n)) ->
    Id R.R (b (incl x) j) (R.mul (Pow.power (value (incl x)) (plus f0.2.1 fr.2.1)) (g x j)) = split {
    inl j -> trans (ap (R.mul (Pow.power (value (incl x)) f0.2.1)) (fr.2.2 x j))
     (two-powers (value (incl x)) f0.2.1 fr.2.1 (g x (inl j))) ;
    inr u -> top x u } ;
   result : Fraction Y YD incl value (suc n) g = (b,plus f0.2.1 fr.2.1,equation) ;
  } ;
  fractions : (n : Nat) (g : YD -> TF.Vec n) -> Tr.Trunc[Fraction Y YD incl value n g].carrier = split {
   zero -> \ g -> Tr.Trunc[Fraction Y YD incl value zero g].inc (\ y j -> efq j,zero,\ y j -> efq j) ;
   suc n | r -> \ g -> TC.map2 (OF.At[A,fp,w,\ x -> g x (inr tt)].Rep) (Fraction Y YD incl value n (\ x j -> g x (inl j)))
    (Fraction Y YD incl value (suc n) g) (\ f0 fr -> Combine[n,g,f0,fr].result)
    (OF.At[A,fp,w,\ x -> g x (inr tt)].theorem) (r (\ x j -> g x (inl j))) } ;
  frame : Frame = new Frame[Y := Y,YD := YD,incl := incl,w := value,unit-w := \ x -> x.2,fractions := fractions] ;
 } ;
 -- (next)
 module Next (Fr : Frame) (d : Nat) (a : Fr.Y -> Fin (suc d) -> R.R) {
  Y : U l = TW.Next d Fr.Y a ;
  YD : U l = TW.Next d Fr.YD (\ y -> a (Fr.incl y)) ;
  incl (p : YD) : Y = (Fr.incl p.1,p.2) ;
  w (p : Y) : R.R = Fr.w p.1 ;
  module Vector (n : Nat) (g : YD -> TF.Vec n) {
   stage (y : Fr.Y) : TF.StageLinear[TW.Root d (a y),suc d,n] = TF.Stage[(d,a y),n].linear ;
   pairing : Pr.Equiv (TF.Vec (PA.times (suc d) n)) (Fin (suc d) -> TF.Vec n) = TF.pairing (suc d) n ;
   -- the coefficients of g over y, flattened
   coefficients (y : Fr.YD) : Fin (suc d) -> TF.Vec n = (stage (Fr.incl y)).equiv.sec (\ r -> g (y,r)) ;
   flat (y : Fr.YD) : TF.Vec (PA.times (suc d) n) = pairing.2.sec (coefficients y) ;
   module From (fr : Fraction Fr.Y Fr.YD Fr.incl Fr.w (PA.times (suc d) n) flat) {
    W (y : Fr.YD) : R.R = Pow.power (Fr.w (Fr.incl y)) fr.2.1 ;
    b (p : Y) : TF.Vec n = (stage p.1).map (pairing.1 (fr.1 p.1)) p.2 ;
    unflat (y : Fr.YD) :
     Id (Fin (suc d) -> TF.Vec n) (pairing.1 (fr.1 (Fr.incl y))) (\ i j -> R.mul (W y) (coefficients y i j)) =
     F.funext (Fin (suc d)) (\ i -> TF.Vec n) _ _ (\ i -> F.funext (Fin n) (\ j -> R.R) _ _ (\ j ->
      trans (fr.2.2 y (PA.pair n (suc d) i j))
       (ap (R.mul (W y)) (Pr.happly (Fin n) (\ j -> R.R) _ _
        (Pr.happly (Fin (suc d)) (\ i -> TF.Vec n) _ _ (pairing.2.sec-eq (coefficients y)) i) j)))) ;
    equation (p : YD) (j : Fin n) : Id R.R (b (incl p) j) (R.mul (W p.1) (g p j)) =
     trans (ap (\ v -> (stage (Fr.incl p.1)).map v p.2 j) (unflat p.1))
      (trans (Pr.happly (Fin n) (\ j -> R.R) _ _
        (Pr.happly (TW.Root d (a (Fr.incl p.1))) (\ r -> TF.Vec n) _ _
         ((stage (Fr.incl p.1)).scale (W p.1) (coefficients p.1)) p.2) j)
       (ap (R.mul (W p.1)) (Pr.happly (Fin n) (\ j -> R.R) _ _
        (Pr.happly (TW.Root d (a (Fr.incl p.1))) (\ r -> TF.Vec n) _ _
         ((stage (Fr.incl p.1)).equiv.sec-eq (\ r -> g (p.1,r))) p.2) j))) ;
    result : Fraction Y YD incl w n g = (b,fr.2.1,equation) ;
   } ;
   theorem : Tr.Trunc[Fraction Y YD incl w n g].carrier =
    TC.map (Fraction Fr.Y Fr.YD Fr.incl Fr.w (PA.times (suc d) n) flat) (Fraction Y YD incl w n g)
     (\ fr -> From[fr].result) (Fr.fractions (PA.times (suc d) n) flat) ;
  } ;
  frame : Frame = new Frame[Y := Y,YD := YD,incl := incl,w := w,unit-w := \ p -> Fr.unit-w p.1,
   fractions := \ n g -> Vector[n,g].theorem] ;
 } ;
 -- (clear)
 Result (s : Towers[l].Shape) (Fr : Frame) (X : U l) (e : Fr.YD -> X) (t : TW.Tower s X) : U l =
  (t' : TW.Tower s Fr.Y) * (E : TW.Points s Fr.YD (TW.pull s Fr.Y Fr.YD Fr.incl t') -> TW.Points s X t) *
   ((z : TW.Points s Fr.YD (TW.pull s Fr.Y Fr.YD Fr.incl t')) ->
    Id X (TW.base s X t (E z)) (e (TW.base s Fr.YD (TW.pull s Fr.Y Fr.YD Fr.incl t') z))) ;
 module Stage (d : Nat) (s : Towers[l].Shape) (Fr : Frame) (X : U l) (e : Fr.YD -> X)
  (c : X -> Fin (suc d) -> R.R) (fr : Fraction Fr.Y Fr.YD Fr.incl Fr.w (suc d) (\ y -> c (e y))) {
  scale (y : Fr.Y) : R.R = Pow.power (Fr.w y) fr.2.1 ;
  a (y : Fr.Y) : Fin (suc d) -> R.R = RS.scaled (suc d) (scale y) (fr.1 y) ;
  module N = Next[Fr,d,a] ;
  -- x |-> x / w^k on the roots over YD
  e' (p : N.YD) : TW.Next d X c =
   (e p.1,RS.Map[d,scale (Fr.incl p.1),RS.power-unit (Fr.w (Fr.incl p.1)) (Fr.unit-w p.1) fr.2.1,
     fr.1 (Fr.incl p.1),c (e p.1),fr.2.2 p.1].root-map p.2) ;
  assemble (t : TW.Tower s (TW.Next d X c)) (r : Result s N.frame (TW.Next d X c) e' t) :
   Result (cons d s) Fr X e (c,t) = ((a,r.1),r.2.1,\ z -> ap (\ q -> q.1) (r.2.2 z)) ;
 } ;
 clear : (s : Towers[l].Shape) (Fr : Frame) (X : U l) (e : Fr.YD -> X) (t : TW.Tower s X) ->
  Tr.Trunc[Result s Fr X e t].carrier = split {
  nil -> \ Fr X e t -> Tr.Trunc[Result nil Fr X e t].inc (tt,e,\ z -> refl (e z)) ;
  cons d s | r -> \ Fr X e t ->
   Tr.Trunc[Fraction Fr.Y Fr.YD Fr.incl Fr.w (suc d) (\ y -> t.1 (e y))].induction @l
    (\ q -> Tr.Trunc[Result (cons d s) Fr X e t].carrier) (\ q -> Tr.Trunc[Result (cons d s) Fr X e t].proposition)
    (\ fr -> TC.map (Result s Stage[d,s,Fr,X,e,t.1,fr].N.frame (TW.Next d X t.1) Stage[d,s,Fr,X,e,t.1,fr].e' t.2)
      (Result (cons d s) Fr X e t) (Stage[d,s,Fr,X,e,t.1,fr].assemble t.2)
      (r Stage[d,s,Fr,X,e,t.1,fr].N.frame (TW.Next d X t.1) Stage[d,s,Fr,X,e,t.1,fr].e' t.2))
    (Fr.fractions (suc d) (\ y -> t.1 (e y))) } ;
 -- over Spec A: a point of t' over y with w(y) a unit gives a point of t over (y, unit)
 module Clearing (A : C.Algebra) (fp : P.FP A) (w : A.ring.R) {
  module B = Principal[A,fp,w] ;
  theorem (s : Towers[l].Shape) (t : TW.Tower s B.YD) : Tr.Trunc[Result s B.frame B.YD (\ x -> x) t].carrier =
   clear s B.frame B.YD (\ x -> x) t ;
  module Restrict (s : Towers[l].Shape) (t : TW.Tower s B.YD) (q : Result s B.frame B.YD (\ x -> x) t)
   (z : TW.Points s B.Y q.1) (u : L.unit (B.value (TW.base s B.Y q.1 z))) {
   over : B.YD = (TW.base s B.Y q.1 z,u) ;
   pulled : TW.Points s B.YD (TW.pull s B.Y B.YD B.incl q.1) = (TW.pullback s B.Y B.YD B.incl q.1).sec (over,z,refl (TW.base s B.Y q.1 z)) ;
   point : TW.Points s B.YD t = q.2.1 pulled ;
   lies-over : Id B.YD (TW.base s B.YD t point) over =
    trans (q.2.2 pulled)
     (ap (\ p -> p.1) ((TW.pullback s B.Y B.YD B.incl q.1).sec-eq (over,z,refl (TW.base s B.Y q.1 z)))) ;
  } ;
 } ;
} ;
