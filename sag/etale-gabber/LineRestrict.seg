-- Base change of frame data (../HANDOFF-GABBER-HOMOTOPY.md).  Let
-- phi : Alg -> L be a map of finitely presented algebras, so that a point y
-- of Spec L gives the point phi* y = y . phi of Spec Alg.  Frame data for a
-- family of torsors T over Spec Alg (AFFINELINEDATA) restrict to frame data
-- for T . phi* over Spec L (the fibres are the same lines), and the
-- projector of the restricted data (AFFINELINEPROJECTOR) is the image of the
-- projector under phi: both entries are <d_i, s_j> at y . phi (SQC).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 Tor : U l+ = TorsorId[l].TorId[UG.group].Tor ;
 module At (Alg L : C.Algebra) (fpA : P.FP Alg) (fpL : P.FP L) (phi : C.Hom Alg L) (T : C.Spec Alg -> Tor) {
  pull (y : C.Spec L) : C.Spec Alg = C.compose Alg L C.base y phi ;
  T' (y : C.Spec L) : Tor = T (pull y) ;
  module DA = AffineLineData[l].Over[R,setR,axioms].At[Alg,fpA,T] ;
  module DL = AffineLineData[l].Over[R,setR,axioms].At[L,fpL,T'] ;
  restrict (w : DA.Data) : DL.Data =
   (w.1,(\ i y -> w.2.1 i (pull y),(\ i y -> w.2.2.1 i (pull y),\ y -> w.2.2.2 (pull y)))) ;
  module Entries (w : DA.Data) {
   module PA = AffineLineProjector[l].Over[R,setR,axioms].At[Alg,fpA,T].From[w] ;
   module PL = AffineLineProjector[l].Over[R,setR,axioms].At[L,fpL,T'].From[restrict w] ;
   entry (i j : Fin w.1) : Id L.ring.R (PL.entry i j) (phi.1.1 (PA.entry i j)) =
    AffineLineProjector[l].Over[R,setR,axioms].At[L,fpL,T'].ext (PL.entry i j) (phi.1.1 (PA.entry i j)) (\ y ->
     trans (PL.beta i j y) (sym (PA.beta i j (pull y)))) ;
  } ;
 } ;
} ;
