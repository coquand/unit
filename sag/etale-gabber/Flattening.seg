-- Flattening of the root topology (GABBER-PROPER-DESIGN.md, section 2).
-- Theorem.  A f.p., P : Spec A -> U l, close (P x) at every x (close for the
-- topology of ETALETOPOLOGY, given by a closure sh at level l).  Then merely a tower
-- over Spec A all of whose points z give ||P (base z)|| (Cover (Spec A) P).
--  (sheaf)   For a type P, Q = Cover Top P is a proposition and a sheaf: from
--            h : ||Root f|| -> Q, TOWERGLOBALISE on Spec B = Root f (B the
--            monic quotient, f.p.; ETALEROOTS.spec-root) gives one tower over
--            Root f giving ||P||; prefixed by the stage f it is a tower over
--            Top giving ||P||.
--  (bridge)  close P -> Q by sh.elim, for any closure sh at level l (the
--            only use of sh), since P -> Q by the empty tower.  For the
--            closure ETALECLOSURE constructs, close P is Q itself.
--  (theorem) The bridge at each x, then TOWERGLOBALISE on Spec A.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Sheaf (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module S = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module TW = Towers[l].Over[R,setR] ;
 module TG = TowerGlobalise[l].Over[R,setR,axioms] ;
 module At (Pp : U l) {
  Q : U l = TW.Cover Top (\ v -> Pp) ;
  prop : Pr.isProp Q = Tr.Trunc[TW.Witness Top (\ v -> Pp)].proposition ;
  -- (sheaf)
  module Stage (i : ET.I) (h : ET.G i -> Q) {
   module RS = EtaleRoots[l].Over[R,setR].Generator[i].RootSpectrum ;
   to-spec (r : ET.Root i) : C.Spec RS.B.A = RS.spec-root.2.sec r ;
   local (y : C.Spec RS.B.A) : Q = h (ET.root-inc i (RS.spec-root.1 y)) ;
   global : TW.Cover (C.Spec RS.B.A) (\ y -> Pp) = TG.At[RS.B.A,RS.B.fp,\ y -> Pp,local].theorem ;
   module Prefix (wt : TW.Witness (C.Spec RS.B.A) (\ y -> Pp)) {
    N : U l = TW.Next i.1 Top (\ v -> i.2) ;
    u (p : N) : C.Spec RS.B.A = to-spec p.2 ;
    tower : TW.Tower (cons i.1 wt.1) Top = (\ v -> i.2,TW.pull wt.1 (C.Spec RS.B.A) N u wt.2.1) ;
    witness : TW.Witness Top (\ v -> Pp) =
     (cons i.1 wt.1,tower,\ z -> wt.2.2 (TW.pull-points wt.1 (C.Spec RS.B.A) N u wt.2.1 z)) ;
   } ;
   result : Q =
    Tr.Trunc[TW.Witness (C.Spec RS.B.A) (\ y -> Pp)].induction @l (\ t -> Q) (\ t -> prop)
     (\ wt -> Tr.Trunc[TW.Witness Top (\ v -> Pp)].inc Prefix[wt].witness) global ;
  } ;
  sheaf : ET.T.isModal @l Q = S.modal-of-sec Q prop (\ i h -> Stage[i,h].result) ;
  empty (p : Pp) : Q = Tr.Trunc[TW.Witness Top (\ v -> Pp)].inc (nil,tt,\ z -> Tr.Trunc[Pp].inc p) ;
 } ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module TW = Towers[l].Over[R,setR] ;
 module TG = TowerGlobalise[l].Over[R,setR,axioms] ;
 module FS = Sheaf[R,setR,axioms] ;
 -- (bridge)
 bridge (Pp : U l) (c : sh.close Pp) : FS.At[Pp].Q = sh.elim @l Pp FS.At[Pp].Q FS.At[Pp].prop FS.At[Pp].sheaf FS.At[Pp].empty c ;
 -- (theorem)
 theorem (A : C.Algebra) (fp : P.FP A) (Pp : C.Spec A -> U l) (local : (x : C.Spec A) -> sh.close (Pp x)) :
  TW.Cover (C.Spec A) Pp = TG.At[A,fp,Pp,\ x -> bridge (Pp x) (local x)].theorem ;
} ;
