-- A multiple of a monic of degree d cannot have degree less than d
-- unless it is zero. Works constructively, also for the zero ring.
level l ; open Ring[l] ;
module Raw (A : CRing) {
 open A ; open RL[A] ;
 open Poly[l].PolyR[A] ; open Mul[l].MulR[A] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module At (f : P) (d : Nat) (length : Id Nat (plen f) (suc d))
  (leading : Id R (lastD f) o) {
  module Top = MonicRegular[l].Raw[A].At[f,d,length] ;
  Statement (m : Nat) : U l =
   (q : P) -> Id Nat (plen q) m -> Bounds.Bound d (pmul f q) -> peq q nil ;
  small : (m : Nat) -> Statement m = split {
   zero -> \ q length-q bound -> len0 q length-q ;
   suc m | ih -> \ q length-q bound ->
    let {
     last-zero : Id R (lastD q) z =
      trans (sym (trans (mulC o (lastD q)) (mulO (lastD q))))
       (trans (ap (\ a -> mul a (lastD q)) (sym leading))
        (trans (sym (Top.top q m length-q))
         (trans (ap (coef (pmul f q)) (plus-comm m d)) (bound m)))) ;
     smaller : Bounds.Bound d (pmul f (initL q)) =
      \ k -> trans (sym (pmul-init f q last-zero (plus d k))) (bound k) ;
    } in peq-trans q (initL q) nil (init-peq q last-zero)
     (ih (initL q) (trans (init-len q) (ap pred length-q)) smaller) } ;
  zero-multiple (q : P) : Bounds.Bound d (pmul f q) -> peq q nil =
   small (plen q) q (refl (plen q)) ;
 } ;
} ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module P = Poly[l].PolyR[A] ;
 module M = Mul[l].MulR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Monic = MonicRegular[l].Over[A,setA] ;
 module F = Axioms[l].FunExtLemmas[fe @l] ;
 module At (lower : List A.R) {
  f : P.P = H.monic-list lower ;
  d : Nat = len lower ;
  module Calculation = Raw[A].At[f,d,Monic.monic-length lower,Monic.leading lower] ;
  module Bounded (r : P.P) (bound : Bounds.Bound d r) {
   Witness (q : B.Carrier) : U l =
    Id B.Carrier (B.mulQ (H.monic lower) q) (B.include r) -> Id B.Carrier q B.zeroQ ;
   on-list (q : P.P) (equation : Id B.Carrier (B.mulQ (H.monic lower) (B.include q)) (B.include r)) :
    Id B.Carrier (B.include q) B.zeroQ =
    B.Q.relates q nil (Calculation.zero-multiple q
     (Bounds.equal-bound d r (M.pmul f q)
      (\ k -> sym (B.Q.effective (M.pmul f q) r
       (trans (sym (B.Multiply.beta f q)) equation) k)) bound)) ;
   quotient-zero : (q : B.Carrier) -> Witness q =
    B.Q.induction @l Witness
     (\ q -> F.isProp-Pi (Id B.Carrier (B.mulQ (H.monic lower) q) (B.include r))
      (\ e -> Id B.Carrier q B.zeroQ) (\ e -> B.set q B.zeroQ)) on-list ;
   remainder-zero (q : B.Carrier)
    (equation : Id B.Carrier (B.mulQ (H.monic lower) q) (B.include r)) :
    Id B.Carrier (B.include r) B.zeroQ =
    trans (sym equation)
     (trans (ap (B.mulQ (H.monic lower)) (quotient-zero q equation))
      (RL[B.ring].mul-zero (H.monic lower))) ;
  } ;
 } ;
} ;
