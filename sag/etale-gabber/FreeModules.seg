-- Finite free A-modules A^K (SERREMODULEPRODUCTS of the regular module)
-- and finite projective modules, as retracts of some A^K (the notion of
-- chatelet/DescentProjective, for SERREMODULE).
--  (halves)  A^(M+M) ~ A^M + A^M by the two halves (VECTORBLOCKS); the
--            map is linear by definition.
--  (summand) If P + Q ~ A^K, then P is a retract of A^K: x |-> (x, 0) and
--            back by the first component of the inverse.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module SM = SerreModule[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module SA = SM.Over[A] ;
 module MI = ModuleIso[l].Over[A] ;
 free (K : Nat) : SA.Module = SP.Over[A,Fin K,\ i -> SA.regular setA].product ;

 module Halving (M : Nat) {
  module VB = VectorBlocks[l].Over[A,setA,M] ;
  module S = SP.Pair[A,free M,free M] ;
  halves (w : VB.V2.Vec) : S.Carrier = (VB.lhalf w,VB.rhalf w) ;
  join (y : S.Carrier) : VB.V2.Vec = VB.cat y.1 y.2 ;
  iso : MI.Iso[free (plus M M),S.product] = MI.make (free (plus M M)) S.product halves join
   (\ w w' -> refl (halves (VB.V2.vadd w w')))
   (\ c w -> refl (halves (VB.V2.vscale c w)))
   (\ y -> S.ext _ _ (VB.lhalf-cat y.1 y.2) (VB.rhalf-cat y.1 y.2))
   (\ w -> VB.cat-halves w) ;
 } ;

 record Retract (P : SA.Module) {
  dimension : Nat ;
  projection : MI.Lin[free dimension,P].B.Hom ;
  section : MI.Lin[P,free dimension].B.Hom ;
  law (x : P.M) : Id P.M (projection.fn (section.fn x)) x ;
 } ;
 FiniteProjective (P : SA.Module) : U l = Tr.Trunc[Retract[P]].carrier ;

 module Summand (P Q : SA.Module) (K : Nat) (e : MI.Iso[SP.Pair[A,P,Q].product,free K]) {
  module S = SP.Pair[A,P,Q] ;
  module E = MI.Inverse[S.product,free K,e] ;
  inject (x : P.M) : S.Carrier = (x,Q.mz) ;
  inject-add (x y : P.M) : Id S.Carrier (inject (P.madd x y)) (S.product.madd (inject x) (inject y)) =
   S.ext _ _ (refl (P.madd x y)) (sym (Q.maddZ Q.mz)) ;
  inject-scale (a : A.R) (x : P.M) : Id S.Carrier (inject (P.sm a x)) (S.product.sm a (inject x)) =
   S.ext _ _ (refl (P.sm a x)) (sym (SA.Laws[Q].sm-zero a)) ;
  section : MI.Lin[P,free K].B.Hom = new MI.Lin[P,free K].B.Hom[\ x -> MI.to e (inject x),
   \ x y -> trans (ap (MI.to e) (inject-add x y)) (MI.to-add e (inject x) (inject y)),
   \ a x -> trans (ap (MI.to e) (inject-scale a x)) (MI.to-scale e a (inject x))] ;
  projection : MI.Lin[free K,P].B.Hom = new MI.Lin[free K,P].B.Hom[\ y -> (e.inv y).1,
   \ y y' -> ap (\ z -> z.1) (E.inv-add y y'),
   \ a y -> ap (\ z -> z.1) (E.inv-scale a y)] ;
  law (x : P.M) : Id P.M (e.inv (MI.to e (inject x))).1 x = ap (\ z -> z.1) (e.inv-to (inject x)) ;
  retract : Retract[P] = new Retract[P,K,projection,section,law] ;
 } ;
} ;
