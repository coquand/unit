-- The concrete presented quotient and its unique polynomial remainder.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module W = PolynomialPresentation[l].Over[R,setR] ;
 module H = HorrocksInterface[l].Over[R,setR] ;
 module B = PolynomialRing[l].Extension[R,setR] ;
 module Red = MonicReduction[l].Over[R,setR] ;
 module BR = RL[B.ring] ;
 module At (lower : List R.R) {
  f : W.Raw.P = H.monic-list lower ;
  d : Nat = len lower ;
  module PC = PolynomialCertificate[l].Over[R,setR,f] ;
  module K = W.For[f].K ;
  module D = W.For[f].D ;
  module Div = Red.At[lower] ;
  A : C.Algebra = K.A.algebra ;
  fp : P.FP A = K.finitely-presented ;
  module Certificate (p q : D.Term) (c : PC.T.Ideal.Certificate (PC.T.ev p) (PC.T.ev q)) {
   equality : Id B.Carrier (Div.remainder (PC.T.ev p)) (Div.remainder (PC.T.ev q)) =
    trans (ap Div.remainder c.2)
     (trans (Div.remainder-add (PC.T.ev q) (B.mulQ (H.monic lower) c.1))
      (trans (ap (B.addQ (Div.remainder (PC.T.ev q))) (Div.remainder-multiple c.1))
       (B.add-zero (Div.remainder (PC.T.ev q))))) ;
  } ;
  respects (p q : D.Term) (e : D.Relation p q) :
   Id B.Carrier (Div.remainder (PC.T.ev p)) (Div.remainder (PC.T.ev q)) =
   Tr.Trunc[PC.T.Ideal.Certificate (PC.T.ev p) (PC.T.ev q)].induction @l
    (\ t -> Id B.Carrier (Div.remainder (PC.T.ev p)) (Div.remainder (PC.T.ev q)))
    (\ t -> B.set _ _) (\ c -> Certificate[p,q,c].equality)
    (PC.Interpretation.certificate p q e) ;
  module NF = K.A.Q.Descend[B.Carrier,B.set,\ p -> Div.remainder (PC.T.ev p),respects] ;
  normal-form (a : A.ring.R) : B.Carrier = NF.map a ;
  normal-form-include (p : D.Term) :
   Id B.Carrier (normal-form (K.A.include p)) (Div.remainder (PC.T.ev p)) = NF.beta p ;
  opaque normal-form ;
  normal-form-bounded : (a : A.ring.R) -> Red.Bounded d (normal-form a) =
   K.A.Q.induction @l (\ a -> Red.Bounded d (normal-form a)) (\ a -> Red.bounded-prop d (normal-form a))
    (\ p -> Pr.subst B.Carrier (Red.Bounded d) _ _ (sym (normal-form-include p)) (Div.bounded (PC.T.ev p))) ;
  one-index : (v : W.V) -> Id W.V (inr tt) v = split {
   inl e -> efq e ; inr t -> ap (\ u -> inr u) (P.top-prop tt t) } ;
  module Eval = Universal[l].Property[R,A.ring,setR,A.set].Given[A.iota,K.A.generators (inr tt)] ;
  quotient-map : C.Hom W.RX.algebra A = (Eval.extend,Eval.on-constants) ;
  value-equation : (p : D.Term) ->
   Id A.ring.R (quotient-map.1.1 (PC.T.ev p)) (K.A.include p) = split {
   var v -> trans Eval.on-variable (ap K.A.generators (one-index v)) ;
   cst r -> Eval.on-constants r ;
   sumE p q | ip iq ->
    trans (quotient-map.1.2.2.1 (PC.T.ev p) (PC.T.ev q))
     (trans (cong2 A.ring.R A.ring.add _ _ _ _ ip iq) (K.A.Addition.beta p q)) ;
   mulE p q | ip iq ->
    trans (quotient-map.1.2.2.2 (PC.T.ev p) (PC.T.ev q))
     (trans (cong2 A.ring.R A.ring.mul _ _ _ _ ip iq) (K.A.Multiplication.beta p q)) } ;
  quotient-list (p : W.Raw.P) :
   Id A.ring.R (quotient-map.1.1 (B.include p)) (K.A.include (W.expression p)) =
   trans (ap quotient-map.1.1 (sym (W.eval-polynomial p))) (value-equation (W.expression p)) ;
  opaque quotient-map ;
  kills : Id A.ring.R (quotient-map.1.1 (H.monic lower)) A.ring.z =
   trans (quotient-list f) (trans (sym (K.A.reify (W.expression f))) K.A.solution.2.1) ;
  quotient-remainder (b : B.Carrier) :
   Id A.ring.R (quotient-map.1.1 (Div.remainder b)) (quotient-map.1.1 b) =
   sym (trans (ap quotient-map.1.1 (Div.equation b))
    (trans (quotient-map.1.2.2.1 (B.mulQ (H.monic lower) (Div.quotient b)) (Div.remainder b))
     (trans (ap (\ a -> A.ring.add a (quotient-map.1.1 (Div.remainder b)))
       (trans (quotient-map.1.2.2.2 (H.monic lower) (Div.quotient b))
        (trans (ap (\ a -> A.ring.mul a (quotient-map.1.1 (Div.quotient b))) kills)
         (RL[A.ring].zero-mul (quotient-map.1.1 (Div.quotient b))))))
      (RL[A.ring].zl (quotient-map.1.1 (Div.remainder b)))))) ;
  quotient-normal : (a : A.ring.R) -> Id A.ring.R (quotient-map.1.1 (normal-form a)) a =
   K.A.Q.induction @l (\ a -> Id A.ring.R (quotient-map.1.1 (normal-form a)) a)
    (\ a -> A.set _ _)
    (\ p -> trans (ap quotient-map.1.1 (normal-form-include p))
     (trans (quotient-remainder (PC.T.ev p)) (value-equation p))) ;
  normal-quotient : (b : B.Carrier) ->
   Id B.Carrier (normal-form (quotient-map.1.1 b)) (Div.remainder b) =
   B.Q.induction @l
    (\ b -> Id B.Carrier (normal-form (quotient-map.1.1 b)) (Div.remainder b)) (\ b -> B.set _ _)
    (\ p -> trans (ap normal-form (quotient-list p))
     (trans (normal-form-include (W.expression p)) (ap Div.remainder (W.eval-polynomial p)))) ;
  Bounded : U l = (b : B.Carrier) * Red.Bounded d b ;
  to-bounded (a : A.ring.R) : Bounded = (normal-form a,normal-form-bounded a) ;
  bounded-equivalence : Pr.Equiv A.ring.R Bounded =
   (to-bounded,Pr.qinv A.ring.R Bounded to-bounded (\ b -> quotient-map.1.1 b.1)
    (\ b -> Pr.Sigma-eq B.Carrier (Red.Bounded d) _ _ _ _
      (trans (normal-quotient b.1) (Div.remainder-small b.1 b.2)) (Red.bounded-prop d b.1))
    quotient-normal) ;
  opaque to-bounded ;
  module V = EtaleVectors[l].Over[R,setR] ;
  coords (a : A.ring.R) : Fin d -> R.R = V.coordinates d (normal-form a) ;
  expansion (v : Fin d -> R.R) : A.ring.R = quotient-map.1.1 (V.expansion d v) ;
  expansion-coords (a : A.ring.R) : Id A.ring.R (expansion (coords a)) a =
   trans (ap quotient-map.1.1 (V.expansion-coordinates d (normal-form a) (normal-form-bounded a)))
    (quotient-normal a) ;
  coords-expansion (v : Fin d -> R.R) : Id (Fin d -> R.R) (coords (expansion v)) v =
   trans (ap (V.coordinates d)
     (trans (normal-quotient (V.expansion d v)) (Div.remainder-small (V.expansion d v) (V.expansion-bound d v))))
    (V.coordinates-expansion d v) ;
  basis : Pr.Equiv A.ring.R (Fin d -> R.R) =
   (coords,Pr.qinv A.ring.R (Fin d -> R.R) coords expansion coords-expansion expansion-coords) ;
  normal-form-add : (a b : A.ring.R) ->
   Id B.Carrier (normal-form (A.ring.add a b)) (B.addQ (normal-form a) (normal-form b)) =
   K.A.forall2
    (\ a b -> Id B.Carrier (normal-form (A.ring.add a b)) (B.addQ (normal-form a) (normal-form b)))
    (\ a b -> B.set _ _)
    (\ p q -> trans (ap normal-form (K.A.Addition.beta p q))
     (trans (normal-form-include (sumE p q))
      (trans (Div.remainder-add (PC.T.ev p) (PC.T.ev q))
       (cong2 B.Carrier B.addQ _ _ _ _ (sym (normal-form-include p)) (sym (normal-form-include q)))))) ;
  normal-form-scale (r : R.R) : (a : A.ring.R) ->
   Id B.Carrier (normal-form (A.ring.mul (A.iota.1 r) a)) (B.mulQ (B.constant r) (normal-form a)) =
   K.A.Q.induction @l
    (\ a -> Id B.Carrier (normal-form (A.ring.mul (A.iota.1 r) a)) (B.mulQ (B.constant r) (normal-form a)))
    (\ a -> B.set _ _)
    (\ p -> trans (ap normal-form (K.A.Multiplication.beta (cst r) p))
     (trans (normal-form-include (mulE (cst r) p))
      (trans (Div.remainder-scale r (PC.T.ev p))
       (ap (B.mulQ (B.constant r)) (sym (normal-form-include p)))))) ;
  coords-add (a b : A.ring.R) (t : Fin d) :
   Id R.R (coords (A.ring.add a b) t) (R.add (coords a t) (coords b t)) =
   trans (ap (\ w -> V.coordinates d w t) (normal-form-add a b))
    (V.coordinates-add d (normal-form a) (normal-form b) t) ;
  coords-scale (r : R.R) (a : A.ring.R) (t : Fin d) :
   Id R.R (coords (A.ring.mul (A.iota.1 r) a) t) (R.mul r (coords a t)) =
   trans (ap (\ w -> V.coordinates d w t) (normal-form-scale r a))
    (V.coordinates-scale d r (normal-form a) t) ;
  expansion-add (v w : Fin d -> R.R) :
   Id A.ring.R (expansion (\ t -> R.add (v t) (w t))) (A.ring.add (expansion v) (expansion w)) =
   Equivalences[l].injective A.ring.R (Fin d -> R.R) coords basis.2 _ _
    (trans (coords-expansion (\ t -> R.add (v t) (w t)))
     (sym (FL.funext (Fin d) (\ t -> R.R) _ _ (\ t ->
       trans (coords-add (expansion v) (expansion w) t)
        (cong2 R.R R.add _ _ _ _
         (Pr.happly (Fin d) (\ t -> R.R) _ _ (coords-expansion v) t)
         (Pr.happly (Fin d) (\ t -> R.R) _ _ (coords-expansion w) t)))))) ;
  expansion-scale (r : R.R) (v : Fin d -> R.R) :
   Id A.ring.R (expansion (\ t -> R.mul r (v t))) (A.ring.mul (A.iota.1 r) (expansion v)) =
   Equivalences[l].injective A.ring.R (Fin d -> R.R) coords basis.2 _ _
    (trans (coords-expansion (\ t -> R.mul r (v t)))
     (sym (FL.funext (Fin d) (\ t -> R.R) _ _ (\ t ->
       trans (coords-scale r (expansion v) t)
        (ap (R.mul r) (Pr.happly (Fin d) (\ t -> R.R) _ _ (coords-expansion v) t)))))) ;
  module Positive (e : Nat) (positive : Id Nat d (suc e)) {
   constant-bound (r : R.R) : Red.Bounded d (B.constant r) =
    \ k -> trans (Red.coef-include (cons r nil) (plus d k))
     (ap (\ m -> W.Raw.coef (cons r nil) (plus m k)) positive) ;
   normal-form-constant (r : R.R) : Id B.Carrier (normal-form (A.iota.1 r)) (B.constant r) =
    trans (normal-form-include (cst r)) (Div.remainder-small (B.constant r) (constant-bound r)) ;
   constant-term (a : A.ring.R) : R.R = Red.coef (normal-form a) zero ;
   constant-term-iota (r : R.R) : Id R.R (constant-term (A.iota.1 r)) r =
    trans (ap (\ b -> Red.coef b zero) (normal-form-constant r)) (Red.coef-include (cons r nil) zero) ;
   opaque constant-term ;
   iota-injective (r s : R.R) (eq : Id A.ring.R (A.iota.1 r) (A.iota.1 s)) : Id R.R r s =
    trans (sym (constant-term-iota r)) (trans (ap constant-term eq) (constant-term-iota s)) ;
   coords-constant (r : R.R) (t : Fin d) :
    Id R.R (coords (A.iota.1 r) t) (W.Raw.coef (cons r nil) (V.index d t)) =
    trans (V.coordinates-index d (normal-form (A.iota.1 r)) t)
     (trans (ap (\ b -> Red.coef b (V.index d t)) (normal-form-constant r))
      (Red.coef-include (cons r nil) (V.index d t))) ;
  } ;
  opaque coords ; opaque expansion ;
 } ;
} ;
