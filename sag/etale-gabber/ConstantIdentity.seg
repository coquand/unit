-- An identity of modules given at every point of a connected type.  Let Y
-- be merely inhabited, with merely a path between any two points (a gerbe),
-- and let A, B be modules with e y : A = B for every y : Y.  Then A = B.
-- (Identities of modules are not known here to form a set, so e itself is
-- not descended; its two linear maps are.)
--  (maps)  An identity p : A = B gives the linear map forward p : A -> B
--     (J, from the identity map), and forward (p^-1) . forward p = id,
--     forward p . forward (p^-1) = id (J).
--  (descent)  A weakly constant map h from Y to a set S has a value: the
--     type Fit = (s : S) * ((y : Y) -> h y = s) is a proposition (merely
--     y, and s = h y = s'), inhabited from a point (h y = h y' along a
--     mere path, by ap).  Hom(A, B) is a set (HOMMODULE), so the maps
--     forward (e y) and forward ((e y)^-1) descend to phi, psi.
--  (inverse)  psi . phi = id and phi . psi = id are propositions, true at a
--     point by (maps); so phi is a linear equivalence and A = B (MODULESIP2).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 identity (M : MD.Module) : HM.At[M,M].S.E = (\ m -> m,\ m m' -> refl (M.madd m m'),\ c m -> refl (M.sm c m)) ;
 -- (maps)
 forward (A B : MD.Module) (p : Id MD.Module A B) : HM.At[A,B].S.E =
  idJ MD.Module A (\ N q -> HM.At[A,N].S.E) (identity A) B p ;
 compose (A B C : MD.Module) (f : HM.At[A,B].S.E) (g : HM.At[B,C].S.E) : HM.At[A,C].S.E =
  HomSums[l].Over[R,setR].compose A B C f g ;
 back-forth (A B : MD.Module) (p : Id MD.Module A B) :
  Id HM.At[A,A].S.E (compose A B A (forward A B p) (forward B A (Pr1.sym MD.Module A B p))) (identity A) =
  idJ MD.Module A (\ N q -> Id HM.At[A,A].S.E (compose A N A (forward A N q) (forward N A (Pr1.sym MD.Module A N q))) (identity A))
   (HM.At[A,A].ext _ _ (\ m -> refl m)) B p ;
 forth-back (A B : MD.Module) (p : Id MD.Module A B) :
  Id HM.At[B,B].S.E (compose B A B (forward B A (Pr1.sym MD.Module A B p)) (forward A B p)) (identity B) =
  idJ MD.Module A (\ N q -> Id HM.At[N,N].S.E (compose N A N (forward N A (Pr1.sym MD.Module A N q)) (forward A N q)) (identity N))
   (HM.At[A,A].ext _ _ (\ m -> refl m)) B p ;
 module At (Y : U l) (inh : Tr.Trunc[Y].carrier) (conn : (y y' : Y) -> Tr.Trunc[Id Y y y'].carrier)
  (A B : MD.Module) (e : (y : Y) -> Id MD.Module A B) {
  -- (descent), for a map into Hom(P, Q)
  module Descend (P Q : MD.Module) (h : Y -> HM.At[P,Q].S.E) {
   module H = HM.At[P,Q] ;
   Fit : U l = (s : H.S.E) * ((y : Y) -> Id H.S.E (h y) s) ;
   fit-prop : Pr.isProp Fit = \ a b ->
    Pr.Sigma-eq H.S.E (\ s -> (y : Y) -> Id H.S.E (h y) s) a.1 b.1 a.2 b.2
     (Tr.Trunc[Y].induction @l (\ t -> Id H.S.E a.1 b.1) (\ t -> H.carrier.setM _ _)
      (\ y -> trans (sym (a.2 y)) (b.2 y)) inh)
     (F.isProp-Pi Y (\ y -> Id H.S.E (h y) b.1) (\ y -> H.carrier.setM _ _)) ;
   at (y : Y) : Fit = (h y,\ y' -> Tr.Trunc[Id Y y' y].induction @l (\ t -> Id H.S.E (h y') (h y)) (\ t -> H.carrier.setM _ _)
    (\ p -> ap h p) (conn y' y)) ;
   fit : Fit = Tr.Trunc[Y].induction @l (\ t -> Fit) (\ t -> fit-prop) at inh ;
   value : H.S.E = fit.1 ;
   value-at (y : Y) : Id H.S.E (h y) value = fit.2 y ;
  } ;
  module Phi = Descend[A,B,\ y -> forward A B (e y)] ;
  module Psi = Descend[B,A,\ y -> forward B A (Pr1.sym MD.Module A B (e y))] ;
  -- (inverse)
  psi-phi (a : A.M) : Id A.M (Psi.value.1 (Phi.value.1 a)) a =
   Tr.Trunc[Y].induction @l (\ t -> Id A.M (Psi.value.1 (Phi.value.1 a)) a) (\ t -> A.setM _ _)
    (\ y -> trans (ap (\ g -> g.1 (Phi.value.1 a)) (sym (Psi.value-at y)))
     (trans (ap (\ f -> (forward B A (Pr1.sym MD.Module A B (e y))).1 (f.1 a)) (sym (Phi.value-at y)))
      (ap (\ k -> k.1 a) (back-forth A B (e y))))) inh ;
  phi-psi (b : B.M) : Id B.M (Phi.value.1 (Psi.value.1 b)) b =
   Tr.Trunc[Y].induction @l (\ t -> Id B.M (Phi.value.1 (Psi.value.1 b)) b) (\ t -> B.setM _ _)
    (\ y -> trans (ap (\ g -> g.1 (Psi.value.1 b)) (sym (Phi.value-at y)))
     (trans (ap (\ f -> (forward A B (e y)).1 (f.1 b)) (sym (Psi.value-at y)))
      (ap (\ k -> k.1 b) (forth-back A B (e y))))) inh ;
  theorem : Id MD.Module A B =
   SIP.sip A B ((Phi.value.1,Pr.qinv A.M B.M Phi.value.1 Psi.value.1 phi-psi psi-phi),Phi.value.2.1,Phi.value.2.2) ;
 } ;
} ;
