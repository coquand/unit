-- SAG Theorem 7.3.6 from Loc, SQC and Z-choice: on an affine X, every
-- torsor under a module family M merely has a section, provided M(X)_g =
-- M(D(g)) (Modules.Restriction, Lemma 7.1.8 for U = X).  torsor/Affine
-- proves it from its own LocR, ZChoice and WQC; RingBridge and ZBridge
-- supply the first two.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module RB = RingBridge[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module ZB = ZBridge[l].Over[R,setR,axioms] ;
 module Torsors (X : U l) (Mx : X -> MD.Module) (wq : MD.Restriction X Mx)
  (T : X -> U l) (ts : (x : X) -> Torsor[l].TorBase[Affine[l].Aff[RB.ring,X,Mx].ab x].TorStr (T x)) {
  module Af = Affine[l].Aff[RB.ring,X,Mx] ;
  Goal : U l = Tr.Trunc[(x : X) -> T x].carrier ;
  -- X = Spec A for a finitely presented A
  presented (A : C.Algebra) (fp : P.FP A) (e : Pr.Equiv X (C.Spec A)) : Goal =
   Af.Thm[RB.loc X Mx axioms.loc,ZB.At[X,Mx,A,fp,e].zchoice,wq,T,ts].theorem-7-3-6 ;
  -- X affine in the sense of Section 3
  affine (aff : FA.Affine X) : Goal =
   Tr1.Trunc[FA.AffineWitness X].induction @l (\ t -> Goal) (\ t -> Tr.Trunc[(x : X) -> T x].proposition)
    (\ w -> presented w.1 w.2.1 w.2.2) aff ;
  -- X affine in the small sense of Section 5
  small-affine (aff : SA.Affine X) : Goal = affine (SA.to-affine X aff) ;
 } ;
} ;
