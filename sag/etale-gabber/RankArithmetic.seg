-- Ranks of powers (gabber-recollement, Theorem main: the ranks of the glued
-- and corrected modules).  A module with a basis of rank a + 1 has
-- A^(k+1) = A + .. + A (EFFACE, k + 1 copies) with a basis of rank
-- copies a k + 1, copies a 0 = a, copies a (k+1) = a + (copies a k + 1),
-- by STANDARDBASES.SumBasis and the definition of plus.
--  (times)  copies a k + 1 = (k+1)(a+1), by plus-comm; and times is
--     commutative (times m (n+1) = times m n + m, by associativity and
--     commutativity of plus), so copies a b = copies b a.
--  (exponent)  exponent c j + 1 = (j+1)(c+1) (SUMMANDS.exponent).
--  (in a ring)  Writing [k] for the image of k (RATIONAL.Integers):
--     [copies a k + 1] = [k+1][a+1],  [count e k + 1] = [e+1]^k
--     (POWERSUMS.count, count e (k+1) = exponent (count e k) e).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
plus-assoc : (a b c : Nat) -> Id Nat (plus a (plus b c)) (plus (plus a b) c) = split {
 zero -> \ b c -> refl (plus b c) ;
 suc a | r -> \ b c -> ap (\ k -> suc k) (r b c) } ;
copies (a : Nat) : Nat -> Nat = split { zero -> a ; suc k | c -> plus a (suc c) } ;
-- (times)
copies-times (a : Nat) : (k : Nat) -> Id Nat (suc (copies a k)) (Pairing[l].times (suc k) (suc a)) = split {
 zero -> refl (suc a) ;
 suc k | h -> trans (plus-comm (suc a) (suc (copies a k))) (ap (\ t -> plus t (suc a)) h) } ;
times-zero : (m : Nat) -> Id Nat (Pairing[l].times m zero) zero = split {
 zero -> refl zero ;
 suc m | r -> trans (plus-zero (Pairing[l].times m zero)) r } ;
-- (t + m) + n = (t + n) + m
swap-last (t m n : Nat) : Id Nat (plus (plus t m) n) (plus (plus t n) m) =
 trans (sym (plus-assoc t m n)) (trans (ap (plus t) (plus-comm m n)) (plus-assoc t n m)) ;
times-suc : (m n : Nat) -> Id Nat (Pairing[l].times m (suc n)) (plus (Pairing[l].times m n) m) = split {
 zero -> \ n -> refl zero ;
 suc m | r -> \ n -> calc Nat { plus (Pairing[l].times m (suc n)) (suc n)
   =< ap (\ t -> plus t (suc n)) (r n) > plus (plus (Pairing[l].times m n) m) (suc n)
   =< plus-suc (plus (Pairing[l].times m n) m) n > suc (plus (plus (Pairing[l].times m n) m) n)
   =< ap (\ t -> suc t) (swap-last (Pairing[l].times m n) m n) > suc (plus (plus (Pairing[l].times m n) n) m)
   =< sym (plus-suc (plus (Pairing[l].times m n) n) m) > plus (plus (Pairing[l].times m n) n) (suc m) } } ;
times-comm : (m n : Nat) -> Id Nat (Pairing[l].times m n) (Pairing[l].times n m) = split {
 zero -> \ n -> sym (times-zero n) ;
 suc m | r -> \ n -> trans (ap (\ t -> plus t n) (r n)) (sym (times-suc n m)) } ;
copies-comm (a b : Nat) : Id Nat (copies a b) (copies b a) =
 suc-inj (trans (copies-times a b) (trans (times-comm (suc b) (suc a)) (sym (copies-times b a)))) ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module PS = PowerSums[l].Over[R,setR] ;
 -- (exponent)
 exponent-times (c : Nat) : (j : Nat) -> Id Nat (suc (PS.SU.exponent c j)) (Pairing[l].times (suc j) (suc c)) = split {
  zero -> refl (suc c) ;
  suc j | h -> calc Nat { suc (suc (plus c (PS.SU.exponent c j)))
    =< ap (\ t -> suc (suc t)) (plus-comm c (PS.SU.exponent c j)) > suc (suc (plus (PS.SU.exponent c j) c))
    =< ap (\ t -> suc t) (sym (plus-suc (PS.SU.exponent c j) c)) > plus (suc (PS.SU.exponent c j)) (suc c)
    =< ap (\ t -> plus t (suc c)) h > plus (Pairing[l].times (suc j) (suc c)) (suc c) } } ;
 -- (in a ring)
 module Nats (T : CRing) {
  module IT = Rational[l].Integers[T] ;
  module PT = AffinePowers[l].Over[T] ;
  nat-copies (a k : Nat) : Id T.R (IT.nat (suc (copies a k))) (T.mul (IT.nat (suc k)) (IT.nat (suc a))) =
   trans (ap IT.nat (copies-times a k)) (IT.nat-times (suc k) (suc a)) ;
  nat-exponent (c j : Nat) : Id T.R (IT.nat (suc (PS.SU.exponent c j))) (T.mul (IT.nat (suc j)) (IT.nat (suc c))) =
   trans (ap IT.nat (exponent-times c j)) (IT.nat-times (suc j) (suc c)) ;
  nat-count (e : Nat) : (k : Nat) -> Id T.R (IT.nat (suc (PS.count e k))) (PT.power (IT.nat (suc e)) k) = split {
   zero -> IT.nat-one ;
   suc k | h -> trans (nat-exponent (PS.count e k) e) (ap (T.mul (IT.nat (suc e))) h) } ;
 } ;
 -- the ranks of goodness: [N0 + 1] = [a + 1]^n when (a + 1)^n = N0 + 1, and
 -- the rank of P(V^(b+1))^v (CHEAPGLUE.Side.rank) is [(copies a b) + 1]^n
 module Ranks (T : CRing) (n0 : Nat) {
  module N = Nats[T] ;
  module ML = Multilinear[l].Over[R,setR] ;
  nat-rank (r : Nat) : (k : Nat) -> Id T.R (N.IT.nat (ML.rank r (suc zero) k)) (N.PT.power (N.IT.nat r) k) = split {
   zero -> N.IT.nat-one ;
   suc k | h -> trans (N.IT.nat-times r (ML.rank r (suc zero) k)) (ap (T.mul (N.IT.nat r)) h) } ;
  at-rank (a N0 : Nat) (h : Id Nat (ML.rank (suc a) (suc zero) (suc n0)) (suc N0)) :
   Id T.R (N.IT.nat (suc N0)) (N.PT.power (N.IT.nat (suc a)) (suc n0)) =
   trans (ap N.IT.nat (sym h)) (nat-rank (suc a) (suc n0)) ;
  rank (N0 m : Nat) : Nat = (Rational[l].times-suc (PS.count m (suc n0)) N0).1 ;
  powered (a b N0 : Nat) (h : Id Nat (ML.rank (suc a) (suc zero) (suc n0)) (suc N0)) :
   Id T.R (N.IT.nat (suc (rank N0 b))) (N.PT.power (N.IT.nat (suc (copies a b))) (suc n0)) =
   calc T.R { N.IT.nat (suc (rank N0 b))
     =< ap N.IT.nat (sym (Rational[l].times-suc (PS.count b (suc n0)) N0).2) >
        N.IT.nat (Pairing[l].times (suc (PS.count b (suc n0))) (suc N0))
     =< N.IT.nat-times (suc (PS.count b (suc n0))) (suc N0) > T.mul (N.IT.nat (suc (PS.count b (suc n0)))) (N.IT.nat (suc N0))
     =< cong2 T.R T.mul _ _ _ _ (N.nat-count b (suc n0)) (at-rank a N0 h) >
        T.mul (N.PT.power (N.IT.nat (suc b)) (suc n0)) (N.PT.power (N.IT.nat (suc a)) (suc n0))
     =< sym (N.PT.power-mul (N.IT.nat (suc b)) (N.IT.nat (suc a)) (suc n0)) >
        N.PT.power (T.mul (N.IT.nat (suc b)) (N.IT.nat (suc a))) (suc n0)
     =< ap (\ t -> N.PT.power t (suc n0)) (sym (N.nat-copies a b)) > N.PT.power (N.IT.nat (suc (copies a b))) (suc n0) } ;
 } ;
} ;
