-- Transposes of projectors and their classes in K_0 (K0); CHEAP-DESIGN.md
-- section 2 (iii).
--  (matrices)  a^T_ij = a_ji.  (a b)^T_ij = sum_k a_jk b_ki = (b^T a^T)_ij;
--   1^T = 1 (the delta is symmetric); + , - and 0 commute with ^T and
--   a^T^T = a by definition.  So P Q = Z gives Q^T P^T = Z^T (reverse), and
--   p^T is a projector with p.
--  (blocks)  (dsum a b)^T = dsum a^T b^T: at a pair of sides both are the
--   same entry of a, of b, or 0.  (a (x) b)^T = a^T (x) b^T by definition.
--  (equivalence)  If u, v is an equivalence of X and Y (EQUIVALENCE:
--   v u = X, u v = Y, Y u = u, v Y = v, X v = v), then v^T, u^T is one of
--   X^T and Y^T: u^T v^T = X^T, v^T u^T = Y^T, Y^T v^T = (v Y)^T = v^T,
--   u^T Y^T = (Y u)^T = u^T, and X^T u^T = (u X)^T = u^T, since
--   u X = u v u = Y u = u.
--  (images)  Let Image p ~ Image q, of sizes m and n.  Pad to one size:
--   Image (p + 0_n) ~ Image p ~ Image q ~ Image (0_m + q) (COMPLEMENTS), so
--   p + 0_n and 0_m + q are equivalent (EQUIVALENCE.FromIso), hence so are
--   their transposes, which are p^T + 0_n and 0_m + q^T (blocks); so
--   Image p^T ~ Image (p^T + 0_n) ~ Image (0_m + q^T) ~ Image q^T.
--  (classes)  If [p] = [q], then merely Image (p + 1_j) ~ Image (q + 1_j)
--   (STABILISE), so by (images) and (blocks), with 1_j^T = 1_j,
--     [p^T] + j = [(p + 1_j)^T] = [(q + 1_j)^T] = [q^T] + j,
--   and [p^T] = [q^T].  In particular [p] = N gives [p^T] = [1_N^T] = N.
--  (multiples)  For c copies p^c = 0 + p + .. + p, [p^c] = c [p] and
--   (p^c)^T ~ (p^T)^c.  If c [p] = c N then [p^c] = [(1_N)^c], so
--     c [p^T] = [(p^T)^c] = [(p^c)^T] = [((1_N)^c)^T] = [(1_N^T)^c] = c N
--   (the dual of a stably free module is stably free).
--  (rho)  In K = K_0 (x) Q (RATIONAL) let rho(p) = [p]/N (N = N0 + 1), as in
--   ROOTS.  If rho(p) = 1 then iota [p] = iota N, so iota ([p] - N) = 0 and,
--   merely, t ([p] - N) = 0 in K_0 for a positive integer t = c
--   (MONOIDLOCALIZATION.kernel); c x = x + .. + x, so c [p] = c N, and by
--   (multiples) c [p^T] = c N, i.e. c ([p^T] - N) = 0.  c is a unit in K, so
--   iota ([p^T] - N) = 0 and rho(p^T) = 1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module TC = TruncationCombinators[l] ;

-- transposes of n x n matrices over R
module Mats (R : CRing) (setR : Pr.isSet R.R) (n : Nat) {
 module Mt = MnAlgebra[l].Over[R,setR,n] ;
 module S = FiniteIdeal[l].Sums[R] ;
 module D = MnSums[l].Over[R] ;
 module E = Equivalence[l].Over[R,setR,n] ;
 module PJ = E.PJ ;
 transpose (a : Mt.Mat) : Mt.Mat = \ i j -> a j i ;
 transpose-at (a : Mt.Mat) (i j : Fin n) : Id R.R (transpose a i j) (a j i) = refl (a j i) ;
 transpose-transpose (a : Mt.Mat) : Id Mt.Mat (transpose (transpose a)) a = refl a ;
 transpose-madd (a b : Mt.Mat) : Id Mt.Mat (transpose (Mt.madd a b)) (Mt.madd (transpose a) (transpose b)) =
  refl (Mt.madd (transpose a) (transpose b)) ;
 transpose-mneg (a : Mt.Mat) : Id Mt.Mat (transpose (Mt.mneg a)) (Mt.mneg (transpose a)) = refl (Mt.mneg (transpose a)) ;
 transpose-mzero : Id Mt.Mat (transpose Mt.mzero) Mt.mzero = refl Mt.mzero ;
 -- (a b)^T_ij = sum_k a_jk b_ki = sum_k b^T_ik a^T_kj
 transpose-mmul-at (a b : Mt.Mat) (i j : Fin n) :
  Id R.R (transpose (Mt.mmul a b) i j) (Mt.mmul (transpose b) (transpose a) i j) =
  calc R.R { transpose (Mt.mmul a b) i j
    =< refl (S.sum n (\ k -> R.mul (a j k) (b k i))) > S.sum n (\ k -> R.mul (a j k) (b k i))
    =< S.sum-cong n (\ k -> R.mul (a j k) (b k i)) (\ k -> R.mul (b k i) (a j k)) (\ k -> R.mulC (a j k) (b k i)) >
       S.sum n (\ k -> R.mul (b k i) (a j k))
    =< refl (S.sum n (\ k -> R.mul (b k i) (a j k))) > Mt.mmul (transpose b) (transpose a) i j } ;
 transpose-mmul (a b : Mt.Mat) : Id Mt.Mat (transpose (Mt.mmul a b)) (Mt.mmul (transpose b) (transpose a)) =
  Mt.mat-eq (transpose (Mt.mmul a b)) (Mt.mmul (transpose b) (transpose a)) (transpose-mmul-at a b) ;
 transpose-mone : Id Mt.Mat (transpose Mt.mone) Mt.mone =
  Mt.mat-eq (transpose Mt.mone) Mt.mone (\ i j -> D.delta-sym n j i) ;
 -- P Q = Z gives Q^T P^T = Z^T
 reverse (P Q Z : Mt.Mat) (e : Id Mt.Mat (Mt.mmul P Q) Z) : Id Mt.Mat (Mt.mmul (transpose Q) (transpose P)) (transpose Z) =
  trans (sym (transpose-mmul P Q)) (ap transpose e) ;
 -- an equivalence u, v of X and Y gives the equivalence v^T, u^T of X^T and Y^T
 module Equivalent (X Y : Mt.Mat) (q : E.Equivalent[X,Y]) {
  -- u X = u v u = Y u = u
  ux : Id Mt.Mat (Mt.mmul q.u X) q.u =
   calc Mt.Mat { Mt.mmul q.u X
     =< ap (Mt.mmul q.u) (sym q.vu) > Mt.mmul q.u (Mt.mmul q.v q.u)
     =< Mt.m-mulA q.u q.v q.u > Mt.mmul (Mt.mmul q.u q.v) q.u
     =< ap (\ Z -> Mt.mmul Z q.u) q.uv > Mt.mmul Y q.u
     =< q.yu > q.u } ;
  transposed : E.Equivalent[transpose X,transpose Y] =
   new E.Equivalent[transpose X,transpose Y,transpose q.v,transpose q.u,
    reverse q.v q.u X q.vu,reverse q.u q.v Y q.uv,reverse q.v Y q.v q.vy,reverse Y q.u q.u q.yu,reverse q.u X q.u ux] ;
 } ;
 -- projectors X, Y of size n with isomorphic images: so are X^T and Y^T
 -- (hXT, hYT: the idempotence of X^T and Y^T, as given with the transposed projectors)
 module Images (X Y : Mt.Mat) (hX : Id Mt.Mat (Mt.mmul X X) X) (hY : Id Mt.Mat (Mt.mmul Y Y) Y)
  (hXT : Id Mt.Mat (Mt.mmul (transpose X) (transpose X)) (transpose X))
  (hYT : Id Mt.Mat (Mt.mmul (transpose Y) (transpose Y)) (transpose Y))
  (h : PJ.MI.Iso[PJ.Image[new PJ.Projector[n,X,hX]].image,PJ.Image[new PJ.Projector[n,Y,hY]].image]) {
  module FI = E.FromIso[X,Y,hX,hY,h] ;
  iso : PJ.MI.Iso[PJ.Image[new PJ.Projector[n,transpose X,hXT]].image,PJ.Image[new PJ.Projector[n,transpose Y,hYT]].image] =
   E.ToIso[transpose X,transpose Y,hXT,hYT,Equivalent[X,Y,FI.equivalent].transposed].iso ;
 } ;
} ;

-- block sums: (dsum a b)^T = dsum a^T b^T
module BlockSums (R : CRing) (setR : Pr.isSet R.R) (m n : Nat) {
 module DS = DirectSums[l].Over[R,setR,m,n] ;
 module Tm = Mats[R,setR,m] ;
 module Tn = Mats[R,setR,n] ;
 module T2 = Mats[R,setR,plus m n] ;
 pick (a : Tm.Mt.Mat) (b : Tn.Mt.Mat) : (e e' : DS.Side) -> Id R.R (DS.pick a b e' e) (DS.pick (Tm.transpose a) (Tn.transpose b) e e') = split {
  inl i -> split { inl j -> refl (a j i) ; inr j -> refl R.z } ;
  inr i -> split { inl j -> refl R.z ; inr j -> refl (b j i) } } ;
 transpose-dsum (a : Tm.Mt.Mat) (b : Tn.Mt.Mat) : Id T2.Mt.Mat (T2.transpose (DS.dsum a b)) (DS.dsum (Tm.transpose a) (Tn.transpose b)) =
  T2.Mt.mat-eq (T2.transpose (DS.dsum a b)) (DS.dsum (Tm.transpose a) (Tn.transpose b)) (\ x y -> pick a b (DS.side x) (DS.side y)) ;
} ;

-- Kronecker products: (a (x) b)^T = a^T (x) b^T
module Kroneckers (R : CRing) (setR : Pr.isSet R.R) (m n : Nat) {
 module KR = Kronecker[l].Over[R,setR,m,n] ;
 module Tm = Mats[R,setR,m] ;
 module Tn = Mats[R,setR,n] ;
 module TN = Mats[R,setR,Pairing[l].times m n] ;
 transpose-kron (a : Tm.Mt.Mat) (b : Tn.Mt.Mat) : Id TN.Mt.Mat (TN.transpose (KR.kron a b)) (KR.kron (Tm.transpose a) (Tn.transpose b)) =
  refl (KR.kron (Tm.transpose a) (Tn.transpose b)) ;
} ;

module Over (A : CRing) (setA : Pr.isSet A.R) {
 module K = K0[l].Over[A,setA] ;
 module PJ = K.PJ ;
 module MI = K.MI ;
 module CA = Complements[l].Over[A,setA] ;
 module ST = Stabilise[l].Over[A,setA] ;
 module LK = RL[K.K0] ;
 -- the transpose of a projector
 module Transpose (p : PJ.Projector) {
  module T = Mats[A,setA,p.size] ;
  idempotent : Id T.Mt.Mat (T.Mt.mmul (T.transpose p.matrix) (T.transpose p.matrix)) (T.transpose p.matrix) =
   T.reverse p.matrix p.matrix p.matrix p.idempotent ;
  projector : PJ.Projector = new PJ.Projector[p.size,T.transpose p.matrix,idempotent] ;
 } ;
 transpose (p : PJ.Projector) : PJ.Projector = Transpose[p].projector ;
 -- (p + q)^T has the image of Zp + Zq, for Zp = p^T and Zq = q^T
 module Block (p q : PJ.Projector)
  (Zp : Mats[A,setA,p.size].Mt.Mat) (hp : Id Mats[A,setA,p.size].Mt.Mat (Mats[A,setA,p.size].Mt.mmul Zp Zp) Zp)
  (ep : Id Mats[A,setA,p.size].Mt.Mat (Mats[A,setA,p.size].transpose p.matrix) Zp)
  (Zq : Mats[A,setA,q.size].Mt.Mat) (hq : Id Mats[A,setA,q.size].Mt.Mat (Mats[A,setA,q.size].Mt.mmul Zq Zq) Zq)
  (eq : Id Mats[A,setA,q.size].Mt.Mat (Mats[A,setA,q.size].transpose q.matrix) Zq) {
  module B = BlockSums[A,setA,p.size,q.size] ;
  target : PJ.Projector = K.sum (new PJ.Projector[p.size,Zp,hp]) (new PJ.Projector[q.size,Zq,hq]) ;
  matrix : Id B.T2.Mt.Mat (B.T2.transpose (B.DS.dsum p.matrix q.matrix)) (B.DS.dsum Zp Zq) =
   calc B.T2.Mt.Mat { B.T2.transpose (B.DS.dsum p.matrix q.matrix)
     =< B.transpose-dsum p.matrix q.matrix > B.DS.dsum (B.Tm.transpose p.matrix) (B.Tn.transpose q.matrix)
     =< ap (\ Z -> B.DS.dsum Z (B.Tn.transpose q.matrix)) ep > B.DS.dsum Zp (B.Tn.transpose q.matrix)
     =< ap (B.DS.dsum Zp) eq > B.DS.dsum Zp Zq } ;
  iso : K.Iso (transpose (K.sum p q)) target =
   PJ.Equal[plus p.size q.size,B.T2.transpose (B.DS.dsum p.matrix q.matrix),B.DS.dsum Zp Zq,
    (transpose (K.sum p q)).idempotent,target.idempotent,matrix].iso ;
 } ;
 -- (p + q)^T ~ p^T + q^T
 sum (p q : PJ.Projector) : K.Iso (transpose (K.sum p q)) (K.sum (transpose p) (transpose q)) =
  Block[p,q,Mats[A,setA,p.size].transpose p.matrix,(transpose p).idempotent,refl (Mats[A,setA,p.size].transpose p.matrix),
   Mats[A,setA,q.size].transpose q.matrix,(transpose q).idempotent,refl (Mats[A,setA,q.size].transpose q.matrix)].iso ;
 -- 1_j^T ~ 1_j
 one (j : Nat) : K.Iso (transpose (ST.one j)) (ST.one j) =
  PJ.Equal[j,Mats[A,setA,j].transpose Mats[A,setA,j].Mt.mone,Mats[A,setA,j].Mt.mone,
   (transpose (ST.one j)).idempotent,(ST.one j).idempotent,Mats[A,setA,j].transpose-mone].iso ;

 -- Image p ~ Image q gives Image p^T ~ Image q^T
 module Iso (p q : PJ.Projector) (e : K.Iso p q) {
  -- p + 0_n and 0_m + q, written with their components (Images takes the components)
  module ML = Mats[A,setA,plus p.size q.size] ;
  left-matrix : ML.Mt.Mat = (K.sum p CA.Null[q.size].projector).matrix ;
  left-idempotent : Id ML.Mt.Mat (ML.Mt.mmul left-matrix left-matrix) left-matrix = (K.sum p CA.Null[q.size].projector).idempotent ;
  right-matrix : ML.Mt.Mat = (K.sum CA.Null[p.size].projector q).matrix ;
  right-idempotent : Id ML.Mt.Mat (ML.Mt.mmul right-matrix right-matrix) right-matrix = (K.sum CA.Null[p.size].projector q).idempotent ;
  left : PJ.Projector = new PJ.Projector[plus p.size q.size,left-matrix,left-idempotent] ;
  right : PJ.Projector = new PJ.Projector[plus p.size q.size,right-matrix,right-idempotent] ;
  -- Image (p + 0_n) ~ Image p ~ Image q ~ Image (0_m + q)
  padded : K.Iso left right =
   MI.compose (K.image left) (K.image p) (K.image right) CA.PadRight[p,q.size].iso
    (MI.compose (K.image p) (K.image q) (K.image right) e (MI.inverse (K.image right) (K.image q) CA.PadLeft[p.size,q].iso)) ;
  module IM = ML.Images[left-matrix,right-matrix,left-idempotent,right-idempotent,
   (transpose left).idempotent,(transpose right).idempotent,padded] ;
  transposed : K.Iso (transpose left) (transpose right) = IM.iso ;
  -- (p + 0_n)^T ~ p^T + 0_n,  (0_m + q)^T ~ 0_m + q^T
  left-block : K.Iso (transpose left) (K.sum (transpose p) CA.Null[q.size].projector) =
   Block[p,CA.Null[q.size].projector,Mats[A,setA,p.size].transpose p.matrix,(transpose p).idempotent,
    refl (Mats[A,setA,p.size].transpose p.matrix),
    CA.Null[q.size].V.MR.mzero,CA.Null[q.size].idempotent,refl CA.Null[q.size].V.MR.mzero].iso ;
  right-block : K.Iso (transpose right) (K.sum CA.Null[p.size].projector (transpose q)) =
   Block[CA.Null[p.size].projector,q,CA.Null[p.size].V.MR.mzero,CA.Null[p.size].idempotent,refl CA.Null[p.size].V.MR.mzero,
    Mats[A,setA,q.size].transpose q.matrix,(transpose q).idempotent,refl (Mats[A,setA,q.size].transpose q.matrix)].iso ;
  -- Image p^T ~ Image (p^T + 0_n) ~ Image (p + 0_n)^T
  start : K.Iso (transpose p) (transpose left) =
   MI.compose (K.image (transpose p)) (K.image (K.sum (transpose p) CA.Null[q.size].projector)) (K.image (transpose left))
    (MI.inverse (K.image (K.sum (transpose p) CA.Null[q.size].projector)) (K.image (transpose p)) CA.PadRight[transpose p,q.size].iso)
    (MI.inverse (K.image (transpose left)) (K.image (K.sum (transpose p) CA.Null[q.size].projector)) left-block) ;
  -- Image (0_m + q)^T ~ Image (0_m + q^T) ~ Image q^T
  finish : K.Iso (transpose right) (transpose q) =
   MI.compose (K.image (transpose right)) (K.image (K.sum CA.Null[p.size].projector (transpose q))) (K.image (transpose q))
    right-block CA.PadLeft[p.size,transpose q].iso ;
  theorem : K.Iso (transpose p) (transpose q) =
   MI.compose (K.image (transpose p)) (K.image (transpose left)) (K.image (transpose q)) start
    (MI.compose (K.image (transpose left)) (K.image (transpose right)) (K.image (transpose q)) transposed finish) ;
 } ;

 -- x + f = y + f gives x = y
 cancel (x y f : K.K0.R) (e : Id K.K0.R (K.K0.add x f) (K.K0.add y f)) : Id K.K0.R x y =
  calc K.K0.R { x
    =< sym (LK.add-neg-cancel x f) > K.K0.add (K.K0.add x f) (K.K0.neg f)
    =< ap (\ w -> K.K0.add w (K.K0.neg f)) e > K.K0.add (K.K0.add y f) (K.K0.neg f)
    =< LK.add-neg-cancel y f > y } ;
 -- [p] = [q] gives [p^T] = [q^T]
 module Classes (p q : PJ.Projector) (h : Id K.K0.R (K.class p) (K.class q)) {
  Goal : U l = Id K.K0.R (K.class (transpose p)) (K.class (transpose q)) ;
  -- [r^T] + j = [r^T + 1_j] = [(r + 1_j)^T]
  shift (j : Nat) (r : PJ.Projector) :
   Id K.K0.R (K.K0.add (K.class (transpose r)) (K.free j)) (K.class (transpose (K.sum r (ST.one j)))) =
   trans (K.class-sum (transpose r) (ST.one j))
    (sym (K.class-iso (transpose (K.sum r (ST.one j))) (K.sum (transpose r) (ST.one j))
     (Block[r,ST.one j,Mats[A,setA,r.size].transpose r.matrix,(transpose r).idempotent,refl (Mats[A,setA,r.size].transpose r.matrix),
       Mats[A,setA,j].Mt.mone,(ST.one j).idempotent,Mats[A,setA,j].transpose-mone].iso))) ;
  module At (j : Nat) (e : K.Iso (K.sum p (ST.one j)) (K.sum q (ST.one j))) {
   stable : Id K.K0.R (K.K0.add (K.class (transpose p)) (K.free j)) (K.K0.add (K.class (transpose q)) (K.free j)) =
    calc K.K0.R { K.K0.add (K.class (transpose p)) (K.free j)
      =< shift j p > K.class (transpose (K.sum p (ST.one j)))
      =< K.class-iso (transpose (K.sum p (ST.one j))) (transpose (K.sum q (ST.one j))) Iso[K.sum p (ST.one j),K.sum q (ST.one j),e].theorem >
         K.class (transpose (K.sum q (ST.one j)))
      =< sym (shift j q) > K.K0.add (K.class (transpose q)) (K.free j) } ;
   equation : Goal = cancel (K.class (transpose p)) (K.class (transpose q)) (K.free j) stable ;
  } ;
  theorem : Goal =
   TC.rec ((j : Nat) * ST.Stably p q j) @l Goal (K.G.set _ _)
    (\ w -> TC.rec (K.Iso (K.sum p (ST.one w.1)) (K.sum q (ST.one w.1))) @l Goal (K.G.set _ _) (\ e -> At[w.1,e].equation) w.2)
    ST.Stabilise[p,q,h].theorem ;
 } ;
 -- [p] = N gives [p^T] = N
 free (p : PJ.Projector) (N : Nat) (h : Id K.K0.R (K.class p) (K.free N)) : Id K.K0.R (K.class (transpose p)) (K.free N) =
  trans (Classes[p,ST.one N,h].theorem) (K.class-iso (transpose (ST.one N)) (ST.one N) (one N)) ;

 -- c copies 0 + p + .. + p
 copies (p : PJ.Projector) : (c : Nat) -> PJ.Projector = split {
  zero -> PJ.zeroP ;
  suc c | r -> K.sum r p } ;
 -- [p^c] = c [p]
 class-copies (p : PJ.Projector) : (c : Nat) -> Id K.K0.R (K.class (copies p c)) (K.multiple c (K.class p)) = split {
  zero -> sym K.class-zero ;
  suc c | r -> trans (sym (K.class-sum (copies p c) p)) (ap (\ w -> K.K0.add w (K.class p)) r) } ;
 -- 0^T ~ 0
 zero-iso : K.Iso (transpose PJ.zeroP) PJ.zeroP =
  PJ.Equal[zero,PJ.MZ.mzero,PJ.MZ.mzero,(transpose PJ.zeroP).idempotent,PJ.zeroP.idempotent,refl PJ.MZ.mzero].iso ;
 -- (p^c)^T ~ (p^T)^c
 transpose-copies (p : PJ.Projector) : (c : Nat) -> K.Iso (transpose (copies p c)) (copies (transpose p) c) = split {
  zero -> zero-iso ;
  suc c | r -> MI.compose (K.image (transpose (K.sum (copies p c) p))) (K.image (K.sum (transpose (copies p c)) (transpose p)))
    (K.image (K.sum (copies (transpose p) c) (transpose p))) (sum (copies p c) p)
    (K.sum-iso (transpose (copies p c)) (copies (transpose p) c) (transpose p) (transpose p) r (MI.identity (K.image (transpose p)))) } ;
 -- c [p] = c N gives c [p^T] = c N
 module Multiple (p : PJ.Projector) (c N : Nat) (h : Id K.K0.R (K.multiple c (K.class p)) (K.multiple c (K.free N))) {
  -- [p^c] = [(1_N)^c]
  copies-class : Id K.K0.R (K.class (copies p c)) (K.class (copies (ST.one N) c)) =
   trans (class-copies p c) (trans h (sym (class-copies (ST.one N) c))) ;
  theorem : Id K.K0.R (K.multiple c (K.class (transpose p))) (K.multiple c (K.free N)) =
   calc K.K0.R { K.multiple c (K.class (transpose p))
     =< sym (class-copies (transpose p) c) > K.class (copies (transpose p) c)
     =< sym (K.class-iso (transpose (copies p c)) (copies (transpose p) c) (transpose-copies p c)) > K.class (transpose (copies p c))
     =< Classes[copies p c,copies (ST.one N) c,copies-class].theorem > K.class (transpose (copies (ST.one N) c))
     =< K.class-iso (transpose (copies (ST.one N) c)) (copies (transpose (ST.one N)) c) (transpose-copies (ST.one N) c) >
        K.class (copies (transpose (ST.one N)) c)
     =< class-copies (transpose (ST.one N)) c > K.multiple c (K.class (transpose (ST.one N)))
     =< ap (K.multiple c) (K.class-iso (transpose (ST.one N)) (ST.one N) (one N)) > K.multiple c (K.free N) } ;
 } ;
 -- rho(p^T) = 1 when rho(p) = 1, in K_0 (x) Q (RATIONAL), with rho(p) = [p]/N as in ROOTS
 module IK = Rational[l].Integers[K.K0] ;
 module RQ = Rational[l].Over[K.K0] ;
 module LQ = RL[RQ.K] ;
 -- c x = x + .. + x
 nat-mul : (c : Nat) (x : K.K0.R) -> Id K.K0.R (K.K0.mul (IK.nat c) x) (K.multiple c x) = split {
  zero -> \ x -> LK.zero-mul x ;
  suc c | r -> \ x -> trans (LK.dist-left (IK.nat c) K.K0.o x)
   (cong2 K.K0.R K.K0.add (K.K0.mul (IK.nat c) x) (K.multiple c x) (K.K0.mul K.K0.o x) x (r x) (LK.one-left x)) } ;
 -- the integer N is [A^N]
 nat-multiple : (N : Nat) -> Id K.K0.R (IK.nat N) (K.multiple N K.K0.o) = split {
  zero -> refl K.K0.z ;
  suc N | r -> ap (\ w -> K.K0.add w K.K0.o) r } ;
 nat-free (N : Nat) : Id K.K0.R (IK.nat N) (K.free N) = trans (nat-multiple N) (sym (K.free-count N)) ;
 module Rho (N0 : Nat) {
  s : K.K0.R = IK.nat (suc N0) ;
  inv : RQ.K.R = RQ.inverse s (RQ.positive N0) ;
  iota (u : K.K0.R) : RQ.K.R = RQ.iota.1 u ;
  rho (u : K.K0.R) : RQ.K.R = RQ.rho u s (RQ.positive N0) ;
  diff (u : K.K0.R) : K.K0.R = K.K0.add u (K.K0.neg s) ;
  -- rho u = 1 gives iota u = iota u (iota s inv) = iota s (rho u) = iota s
  numerator (u : K.K0.R) (h : Id RQ.K.R (rho u) RQ.K.o) : Id RQ.K.R (iota u) (iota s) =
   calc RQ.K.R { iota u
     =< sym (RQ.K.mulO (iota u)) > RQ.K.mul (iota u) RQ.K.o
     =< ap (RQ.K.mul (iota u)) (sym (RQ.inverse-law s (RQ.positive N0))) > RQ.K.mul (iota u) (RQ.K.mul (iota s) inv)
     =< LQ.mul-swap (iota u) (iota s) inv > RQ.K.mul (iota s) (RQ.K.mul (iota u) inv)
     =< ap (RQ.K.mul (iota s)) h > RQ.K.mul (iota s) RQ.K.o
     =< RQ.K.mulO (iota s) > iota s } ;
  -- iota u = iota s gives rho u = iota s inv = 1
  rho-one (u : K.K0.R) (h : Id RQ.K.R (iota u) (iota s)) : Id RQ.K.R (rho u) RQ.K.o =
   trans (ap (\ w -> RQ.K.mul w inv) h) (RQ.inverse-law s (RQ.positive N0)) ;
  -- (u - s) + s = u
  restore (u : K.K0.R) : Id K.K0.R (K.K0.add (diff u) s) u =
   calc K.K0.R { K.K0.add (diff u) s
     =< sym (K.K0.addA u (K.K0.neg s) s) > K.K0.add u (K.K0.add (K.K0.neg s) s)
     =< ap (K.K0.add u) (LK.neg-cancel s) > K.K0.add u K.K0.z
     =< K.K0.addZ u > u } ;
  -- iota (u - s) = iota u - iota s
  vanishes (u : K.K0.R) (h : Id RQ.K.R (iota u) (iota s)) : Id RQ.K.R (iota (diff u)) RQ.K.z =
   calc RQ.K.R { iota (diff u)
     =< RQ.iota.2.2.1 u (K.K0.neg s) > RQ.K.add (iota u) (iota (K.K0.neg s))
     =< cong2 RQ.K.R RQ.K.add (iota u) (iota s) (iota (K.K0.neg s)) (RQ.K.neg (iota s)) h (RingHom[l].negation K.K0 RQ.K RQ.iota s) >
        RQ.K.add (iota s) (RQ.K.neg (iota s))
     =< RQ.K.addN (iota s) > RQ.K.z } ;
  -- iota u = iota ((u - s) + s) = iota (u - s) + iota s
  equal (u : K.K0.R) (h : Id RQ.K.R (iota (diff u)) RQ.K.z) : Id RQ.K.R (iota u) (iota s) =
   calc RQ.K.R { iota u
     =< ap iota (sym (restore u)) > iota (K.K0.add (diff u) s)
     =< RQ.iota.2.2.1 (diff u) s > RQ.K.add (iota (diff u)) (iota s)
     =< ap (\ w -> RQ.K.add w (iota s)) h > RQ.K.add RQ.K.z (iota s)
     =< LQ.zl (iota s) > iota s } ;
  -- c (u - s) = 0 gives c u = c (u - s) + c s = c N
  multiples (c : Nat) (u : K.K0.R) (h : Id K.K0.R (K.K0.mul (IK.nat c) (diff u)) K.K0.z) :
   Id K.K0.R (K.multiple c u) (K.multiple c (K.free (suc N0))) =
   calc K.K0.R { K.multiple c u
     =< sym (nat-mul c u) > K.K0.mul (IK.nat c) u
     =< ap (K.K0.mul (IK.nat c)) (sym (restore u)) > K.K0.mul (IK.nat c) (K.K0.add (diff u) s)
     =< K.K0.dist (IK.nat c) (diff u) s > K.K0.add (K.K0.mul (IK.nat c) (diff u)) (K.K0.mul (IK.nat c) s)
     =< ap (\ w -> K.K0.add w (K.K0.mul (IK.nat c) s)) h > K.K0.add K.K0.z (K.K0.mul (IK.nat c) s)
     =< LK.zl (K.K0.mul (IK.nat c) s) > K.K0.mul (IK.nat c) s
     =< nat-mul c s > K.multiple c s
     =< ap (K.multiple c) (nat-free (suc N0)) > K.multiple c (K.free (suc N0)) } ;
  -- and back: c (u - s) = c u - c s = c s - c s = 0
  differences (c : Nat) (u : K.K0.R) (h : Id K.K0.R (K.multiple c u) (K.multiple c (K.free (suc N0)))) :
   Id K.K0.R (K.K0.mul (IK.nat c) (diff u)) K.K0.z =
   calc K.K0.R { K.K0.mul (IK.nat c) (diff u)
     =< K.K0.dist (IK.nat c) u (K.K0.neg s) > K.K0.add (K.K0.mul (IK.nat c) u) (K.K0.mul (IK.nat c) (K.K0.neg s))
     =< ap (K.K0.add (K.K0.mul (IK.nat c) u)) (LK.mul-neg (IK.nat c) s) >
        K.K0.add (K.K0.mul (IK.nat c) u) (K.K0.neg (K.K0.mul (IK.nat c) s))
     =< ap (\ w -> K.K0.add w (K.K0.neg (K.K0.mul (IK.nat c) s)))
         (trans (nat-mul c u) (trans h (trans (ap (K.multiple c) (sym (nat-free (suc N0)))) (sym (nat-mul c s))))) >
        K.K0.add (K.K0.mul (IK.nat c) s) (K.K0.neg (K.K0.mul (IK.nat c) s))
     =< K.K0.addN (K.K0.mul (IK.nat c) s) > K.K0.z } ;
  -- k + 1 is a unit in K: (k + 1)(u - s) = 0 gives iota (u - s) = 0
  positive (k : Nat) (u : K.K0.R) (h : Id K.K0.R (K.K0.mul (IK.nat (suc k)) (diff u)) K.K0.z) : Id RQ.K.R (iota (diff u)) RQ.K.z =
   LQ.unit-reg (iota (IK.nat (suc k))) (iota (diff u)) (RQ.unit (IK.nat (suc k)) (RQ.positive k))
    (trans (sym (RQ.iota.2.2.2 (IK.nat (suc k)) (diff u))) (trans (ap iota h) (RingHom[l].zero K.K0 RQ.K RQ.iota))) ;
  -- rho u = 1 gives, merely, k with (k + 1)(u - s) = 0 (MONOIDLOCALIZATION.kernel)
  Multiplier (u : K.K0.R) : U l = (k : Nat) * Id K.K0.R (K.K0.mul (IK.nat (suc k)) (diff u)) K.K0.z ;
  multiplier (u : K.K0.R) (h : Id RQ.K.R (rho u) RQ.K.o) : Truncation[l].Trunc[Multiplier u].carrier =
   TC.map (RQ.Q.Kernel (diff u)) (Multiplier u)
    (\ w -> (w.2.1.1,trans (ap (\ t -> K.K0.mul t (diff u)) w.2.1.2) w.2.2))
    (RQ.Q.kernel (diff u) (vanishes u (numerator u h))) ;
  module Of (p : PJ.Projector) (h : Id RQ.K.R (rho (K.class p)) RQ.K.o) {
   Goal : U l = Id RQ.K.R (rho (K.class (transpose p))) RQ.K.o ;
   -- t (u - s) = 0 with t = k + 1
   module At (w : RQ.Q.Kernel (diff (K.class p))) {
    scaled : Id K.K0.R (K.K0.mul (IK.nat (suc w.2.1.1)) (diff (K.class p))) K.K0.z =
     trans (ap (\ t -> K.K0.mul t (diff (K.class p))) w.2.1.2) w.2.2 ;
    transposed : Id K.K0.R (K.multiple (suc w.2.1.1) (K.class (transpose p))) (K.multiple (suc w.2.1.1) (K.free (suc N0))) =
     Multiple[p,suc w.2.1.1,suc N0,multiples (suc w.2.1.1) (K.class p) scaled].theorem ;
    equation : Goal = rho-one (K.class (transpose p)) (equal (K.class (transpose p))
     (positive w.2.1.1 (K.class (transpose p)) (differences (suc w.2.1.1) (K.class (transpose p)) transposed))) ;
   } ;
   theorem : Goal =
    TC.rec (RQ.Q.Kernel (diff (K.class p))) @l Goal (RQ.Q.set _ _) (\ w -> At[w].equation)
     (RQ.Q.kernel (diff (K.class p)) (vanishes (K.class p) (numerator (K.class p) h))) ;
  } ;
 } ;
} ;
