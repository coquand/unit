-- A linear equivalence induces an isomorphism of endomorphism algebras.
-- Use module SIP to turn the equivalence e into a path, apply End to that
-- path, and use algebra SIP's idToIso. By path induction this map sends
-- f to e f e^-1. ModuleSIP2.idToIso-sip identifies its linear equivalence
-- with the original e. AlgebraSIP.sip-idToIso gives the compatibility of
-- this conjugation with the path obtained by applying End to module SIP.
-- Thus conjugation and transport have one construction and one comparison.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module EN = ModuleEnd[l].Over[R,setR] ;
 module MD = EN.MD ;
 module MS = ModuleSIP2[l].Over[MD.ring] ;
 module AS = AlgSIP[l].Over[R,setR] ;
 module AU = AlgSIPUA[l].Over[R,setR] ;
 path (M N : MD.Module) (p : Id MD.Module M N) : Id AS.Alg EN.At[M].algebra EN.At[N].algebra =
  Hi.ap MD.Module AS.Alg (\ Q -> EN.At[Q].algebra) M N p ;
 by-path (M N : MD.Module) (p : Id MD.Module M N) : AS.AlgIso EN.At[M].algebra EN.At[N].algebra =
  AU.idToIso EN.At[M].algebra EN.At[N].algebra (path M N p) ;
 module AlongPath (M N : MD.Module) (p : Id MD.Module M N) {
  module H = EN.At[M].H ;
  e : MS.LinEquiv M N = MS.idToIso M N p ;
  Action : U l = (f : H.S.E) (x : N.M) ->
   Id N.M (((by-path M N p).1.1 f).1 x) (e.1.1 (f.1 (e.1.2.sec x))) ;
 } ;
 path-action (M N : MD.Module) (p : Id MD.Module M N) : AlongPath[M,N,p].Action =
  idJ MD.Module M (\ Q q -> AlongPath[M,Q,q].Action) (\ f x -> refl (f.1 x)) N p ;
 module At (M N : MD.Module) (e : MS.LinEquiv M N) {
  module Src = EN.At[M] ; module Dst = EN.At[N] ;
  iso : AS.AlgIso Src.algebra Dst.algebra = by-path M N (MS.sip M N e) ;
  action (f : Src.H.S.E) (x : N.M) :
   Id N.M ((iso.1.1 f).1 x) (e.1.1 (f.1 (e.1.2.sec x))) =
   trans (path-action M N (MS.sip M N e) f x)
    (ap (\ q -> q.1.1 (f.1 (q.1.2.sec x))) (MS.idToIso-sip M N e)) ;
  sip : Id (Id AS.Alg Src.algebra Dst.algebra)
   (AU.sip Src.algebra Dst.algebra iso) (path M N (MS.sip M N e)) =
   AU.sip-idToIso Src.algebra Dst.algebra (path M N (MS.sip M N e)) ;
  opaque iso ;
 } ;
} ;
