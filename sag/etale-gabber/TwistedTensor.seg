-- V (x) S for a twisted family V and an ordinary module S given by a
-- projector over Alg (gabber-recollement, Proposition `correct`: one needs
-- P(V' (x) S) = P(V') (x) S^(x)n).  X = Spec Alg, gerbes G x, Lambda of
-- weight n, P(V)^v = power V Lambda n (MULTILINEAR); S(x) is the matrix of
-- values of S at x and, as in MATRIXTENSOR,
--     (V (x) S)(x, g) = Hom(I S(x), V(x, g))          (DATUM.tensor).
--  (twisted)  g |-> I S(x) is constant, so a loop acts trivially (transport
--     in a constant family, by J); Hom(I S(x), V) then has weight a/1 = a
--     (TWISTEDMODULES.Homs.Weights).
--  (bases)  If I S(x) merely has a basis of rank R and V(x, g) one of rank
--     r, then (V (x) S)(x, g) merely has one of rank R r (HOMBASES).
--  (stack)  stack S f 0 = f, stack S f (k+1) = S (x) stack S f k over Alg;
--     its class is [S]^k [f] (K0.class-product, class-one).
--  (images)  At x, iterate (I S(x)^T) (I f(x)) k = I (stack S f k)(x), by
--     HOMIMAGE.hom-image (Hom(I S(x)^T, I p(x)) = I (S(x) (x) p(x))) and
--     (S (x) p)(x) = S(x) (x) p(x) (PROJECTORMAP.Product).
--  (fibre)  Let f be the projector of frame data of the descended P(V)^v, so
--     P(V)^v(x) = I f(x) (DATUM.Fibre).  For g : G x,
--         P(V (x) S)^v(x) = power (Hom(I S(x), V(x, g))) Lambda n     (descend-fibre)
--         = iterate (I S(x))* (power V(x, g) Lambda n) n           (POWERTENSOR.Powers)
--         = iterate (I S(x)^T) (I f(x)) n = I (stack S f n)(x)     (Idem.dual, images)
--     and the right side does not depend on g (CONSTANTIDENTITY).
--  (class)  By (KEY) (PRESENTEDCLASS) every projector representing the
--     sections of the descended P(V (x) S)^v has the class [S]^n [f].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module HI = HomImage[l].Over[R,setR,axioms] ;
 module HB = HomBases[l].Over[R,setR,axioms] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module PT = PowerTensor[l].Over[R,setR,axioms] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe)
  (n : Nat) (Lambda : TM.Family[C.Spec Alg,G].Weighted (\ a -> TM.UG.power a n)) {
  module DA = Datum[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  module PA = Projectors[l].Over[Alg.ring,Alg.set] ;
  module KA = K0[l].Over[Alg.ring,Alg.set] ;
  module PK = AffinePowers[l].Over[KA.K0] ;
  -- the image of the values at x of a projector over Alg
  image-at (x : DA.X) (p : PA.Projector) : MD.Module = MT.I p.size (DA.Mats[p.size].at x p.matrix) ;
  -- (stack)
  stack (e q : PA.Projector) : Nat -> PA.Projector = split {
   zero -> q ;
   suc k | p -> PA.Product[e,p].projector } ;
  class-stack (e q : PA.Projector) : (k : Nat) ->
   Id KA.K0.R (KA.class (stack e q k)) (KA.K0.mul (PK.power (KA.class e) k) (KA.class q)) = split {
   zero -> sym (PK.one-left (KA.class q)) ;
   suc k | h -> trans (sym (KA.class-product e (stack e q k)))
    (trans (ap (KA.K0.mul (KA.class e)) h) (KA.K0.mulA (KA.class e) (PK.power (KA.class e) k) (KA.class q))) } ;
  module Tensor (V : DA.Fam.TF.Twisted) (S : PA.Projector) {
   family : DA.FS.Fam = DA.tensor V.1 S.size S.matrix ;
   -- (twisted)
   module W (x : DA.X) {
    module T = TM.At[TM.charge (TM.banded (G x))] ;
    module MI = T.Move[\ g -> image-at x S] ;
    still (g g' : (G x).1) (q : Id (G x).1 g g') (m : (image-at x S).M) : Id (image-at x S).M (MI.move g g' q m) m =
     idJ (G x).1 g (\ h q' -> Id (image-at x S).M (MI.move g h q' m) m) (refl m) g' q ;
    constant : T.Weight T.trivial (\ g -> image-at x S) = \ g q m -> trans (still g g q m) (sym ((image-at x S).smO m)) ;
    module HT = T.Homs[\ g -> image-at x S,V.1 x] ;
    module WS = HT.Weights[T.trivial,T.identity,constant,V.2 x] ;
    weight : T.Weight T.identity HT.H = T.retag WS.ratio T.identity (\ a -> TM.UG.eq _ _ (R.mulO a.1)) HT.H WS.weight ;
   } ;
   twisted : DA.Fam.TF.Twisted = (family,\ x -> W[x].weight) ;
   -- (bases)
   bases (R0 r : Nat) (bs : (x : DA.X) -> Tr.Trunc[LF.Basis[image-at x S,R0]].carrier)
    (bv : HB.Family[DA.X,G].Based V.1 r) : HB.Family[DA.X,G].Based family (Pairing[l].times R0 r) =
    \ x g -> HB.hom-bases (image-at x S) (V.1 x g) R0 r (bs x) (bv x g) ;
   module PV = ML.Family[DA.X,G].Dual[n,V,Lambda] ;
   module PS = ML.Family[DA.X,G].Dual[n,twisted,Lambda] ;
   module Class (wP : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PV.descended].Data) {
    module FD = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PV.descended].From[wP] ;
    f : PA.Projector = FD.projector ;
    target (x : DA.X) : MD.Module = image-at x (stack S f n) ;
    -- by definition, the image of f at x
    f-image (x : DA.X) : Id MD.Module (MT.I wP.size (DA.Mats[wP.size].at x FD.entry)) (image-at x f) =
     refl (MT.I wP.size (DA.Mats[wP.size].at x FD.entry)) ;
    module Pt (x : DA.X) {
     module PM = ProjectorMap[l].Over[Alg.ring,R,Alg.set,setR,x.1] ;
     module FB = DA.Fibre[PV.descended,wP,x] ;
     module IE = HI.Idem[S.size,DA.Mats[S.size].at x S.matrix,(PM.map S).idempotent] ;
     -- I S(x)^T
     dual : MD.Module = MT.I S.size IE.transpose ;
     -- (images)
     module St (k : Nat) {
      p : PA.Projector = stack S f k ;
      module PP = PM.Product[S,p] ;
      split-matrix : Id PP.MN.MY.Mat (DA.Mats[(stack S f (suc k)).size].at x (stack S f (suc k)).matrix)
       (Kronecker[l].Over[R,setR,S.size,p.size].kron (DA.Mats[S.size].at x S.matrix) (DA.Mats[p.size].at x p.matrix)) = PP.matrix ;
      theorem : Id MD.Module (HI.hom dual (image-at x p)) (image-at x (stack S f (suc k))) =
       Pr1.trans MD.Module (HI.hom dual (image-at x p))
        (MT.I (stack S f (suc k)).size (Kronecker[l].Over[R,setR,S.size,p.size].kron (DA.Mats[S.size].at x S.matrix) (DA.Mats[p.size].at x p.matrix)))
        (image-at x (stack S f (suc k)))
        (HI.hom-image S.size p.size IE.transpose (DA.Mats[p.size].at x p.matrix) IE.transposed (PM.map p).idempotent)
        (Pr1.ap PP.MN.MY.Mat MD.Module (MT.I (stack S f (suc k)).size)
         (Kronecker[l].Over[R,setR,S.size,p.size].kron (DA.Mats[S.size].at x S.matrix) (DA.Mats[p.size].at x p.matrix))
         (DA.Mats[(stack S f (suc k)).size].at x (stack S f (suc k)).matrix) (sym split-matrix)) ;
     } ;
     iterated : (k : Nat) -> Id MD.Module (PT.iterate dual (image-at x f) k) (image-at x (stack S f k)) = split {
      zero -> refl (image-at x f) ;
      suc k | h -> Pr1.trans MD.Module (HI.hom dual (PT.iterate dual (image-at x f) k)) (HI.hom dual (image-at x (stack S f k)))
        (image-at x (stack S f (suc k)))
        (Pr1.ap MD.Module MD.Module (HI.hom dual) (PT.iterate dual (image-at x f) k) (image-at x (stack S f k)) h)
        St[k].theorem } ;
     module Fb (g : (G x).1) {
      -- P(V)^v(x) = I f(x)
      hq : Id MD.Module (ML.power (V.1 x g) (Lambda.1 x g) n) (image-at x f) =
       Pr1.trans MD.Module (ML.power (V.1 x g) (Lambda.1 x g) n) (PV.descended x) (image-at x f)
        (Pr1.sym MD.Module (PV.descended x) (PV.H x g) (DA.Fam.TF.descend-fibre PV.weight-zero x g))
        (Pr1.trans MD.Module (PV.descended x) (MT.I wP.size FB.FI.matrix) (image-at x f) FB.FI.theorem
         (Pr1.trans MD.Module (MT.I wP.size FB.FI.matrix) (MT.I wP.size (FB.MN.at x FB.FD.entry)) (image-at x f)
          (Pr1.ap FB.MN.MR.Mat MD.Module (MT.I wP.size) FB.FI.matrix (FB.MN.at x FB.FD.entry) FB.matrix) (f-image x))) ;
      v : MD.Module = V.1 x g ;
      lam : MD.Module = Lambda.1 x g ;
      m1 : MD.Module = ML.power (HI.hom (image-at x S) v) lam n ;
      m2 : MD.Module = PT.iterate (FR.dual (image-at x S)) (ML.power v lam n) n ;
      m3 : MD.Module = PT.iterate dual (ML.power v lam n) n ;
      m4 : MD.Module = PT.iterate dual (image-at x f) n ;
      s1 : Id MD.Module m1 m2 = PT.Powers[image-at x S,v,lam,S.size,IE.columns].theorem n ;
      s2 : Id MD.Module m2 m3 =
       Pr1.ap MD.Module MD.Module (\ Y -> PT.iterate Y (ML.power v lam n) n) (FR.dual (image-at x S)) dual IE.dual ;
      s3 : Id MD.Module m3 m4 = Pr1.ap MD.Module MD.Module (\ Z -> PT.iterate dual Z n) (ML.power v lam n) (image-at x f) hq ;
      fibre : Id MD.Module (PS.descended x) (target x) =
       Pr1.trans MD.Module (PS.descended x) m1 (target x) (DA.Fam.TF.descend-fibre PS.weight-zero x g)
        (Pr1.trans MD.Module m1 m2 (target x) s1
         (Pr1.trans MD.Module m2 m3 (target x) s2
          (Pr1.trans MD.Module m3 m4 (target x) s3 (iterated n)))) ;
     } ;
     identity : Id MD.Module (PS.descended x) (target x) =
      ConstantIdentity[l].Over[R,setR].At[(G x).1,TwistedFrames[l].Over[R,setR].Family[DA.X,G].point x,
       TM.GB.GL[G x].conn,PS.descended x,target x,\ g -> Fb[g].fibre].theorem ;
    } ;
    -- (class)
    module PCM = PresentedClass[l].Over[R,setR,axioms].At[Alg,fp,PS.descended] ;
    module KEY = PCM.Key[stack S f n,\ x -> Pt[x].identity] ;
    theorem (p : PCM.FP.PJ.Projector) (rp : PCM.FP.Representation p) :
     Id KA.K0.R (KA.class p) (KA.K0.mul (PK.power (KA.class S) n) (KA.class f)) =
     trans (KEY.theorem p rp) (class-stack S f n) ;
   } ;
  } ;
 } ;
} ;
