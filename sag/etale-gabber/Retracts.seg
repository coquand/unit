-- A retract is a summand (MODULES, MODULESUMS).  Let i : A -> B and
-- r : B -> A be linear with r (i a) = a, and let K = ker r (DESCENTSUBMODULES).
--  (parts)  b |-> (r b, b - i (r b)); the second part is in K:
--           r (b - i (r b)) = r b - r (i (r b)) = r b - r b = 0.
--  (join)   (a, k) |-> i a + k.
--  join (parts b) = i (r b) + (b - i (r b)) = b;
--  parts (join (a, k)): r (i a + k) = a + 0 = a, and
--           (i a + k) - i a = k.
--  parts is linear since r and i are.  Hence B = A + K (MODULESIP2).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module A7 = Alg73[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module Of (A B : MD.Module) (i : SM.Linear A B) (r : SM.Linear B A) (ri : (a : A.M) -> Id A.M (r.1 (i.1 a)) a) {
  module MA = A7.MA[MD.ring,A] ;
  module MB = A7.MA[MD.ring,B] ;
  module LI = SM.Lin[A,B,i] ;
  module LR = SM.Lin[B,A,r] ;
  module Ker = SM.Kernel[B,A,r] ;
  module KS = SM.Sub[B,Ker.sub] ;
  kernel : MD.Module = KS.carrier ;
  module P2 = MS.Pair[A,kernel] ;
  -- the projection b |-> b - i (r b)
  rest (b : B.M) : B.M = MB.sub b (i.1 (r.1 b)) ;
  rest-kernel (b : B.M) : Ker.S (rest b) =
   trans (LR.map-sub b (i.1 (r.1 b))) (trans (ap (MA.sub (r.1 b)) (ri (r.1 b))) (MA.sub-self (r.1 b))) ;
  parts (b : B.M) : P2.Carrier = (r.1 b,(rest b,rest-kernel b)) ;
  join (z : P2.Carrier) : B.M = B.madd (i.1 z.1) z.2.1 ;
  -- x + (y - x) = y
  add-sub (x y : B.M) : Id B.M (B.madd x (MB.sub y x)) y =
   trans (ap (B.madd x) (B.maddC y (B.mneg x)))
    (trans (B.maddA x (B.mneg x) y) (trans (ap (\ t -> B.madd t y) (B.maddN x)) (MB.mzl y))) ;
  -- (x + k) - x = k
  sub-add (x k : B.M) : Id B.M (MB.sub (B.madd x k) x) k =
   trans (ap (\ t -> MB.sub t x) (B.maddC x k))
    (trans (sym (B.maddA k x (B.mneg x))) (trans (ap (B.madd k) (B.maddN x)) (B.maddZ k))) ;
  join-parts (b : B.M) : Id B.M (join (parts b)) b = add-sub (i.1 (r.1 b)) b ;
  -- r (i a + k) = a
  retract-join (z : P2.Carrier) : Id A.M (r.1 (join z)) z.1 =
   trans (r.2.1 (i.1 z.1) z.2.1) (trans (cong2 A.M A.madd _ _ _ _ (ri z.1) z.2.2) (A.maddZ z.1)) ;
  parts-join (z : P2.Carrier) : Id P2.Carrier (parts (join z)) z =
   P2.pair-eq _ _ _ _ (retract-join z)
    (KS.eq _ _ (trans (ap (\ a -> MB.sub (join z) (i.1 a)) (retract-join z)) (sub-add (i.1 z.1) z.2.1))) ;
  -- (b + b') - (x + x') = (b - x) + (b' - x')
  sub-sum (b b' x x' : B.M) : Id B.M (MB.sub (B.madd b b') (B.madd x x')) (B.madd (MB.sub b x) (MB.sub b' x')) =
   trans (ap (B.madd (B.madd b b')) (MB.neg-add x x')) (MB.swap4 b b' (B.mneg x) (B.mneg x')) ;
  -- parts is linear
  rest-add (b b' : B.M) : Id B.M (rest (B.madd b b')) (B.madd (rest b) (rest b')) =
   trans (ap (\ t -> MB.sub (B.madd b b') t) (trans (ap i.1 (r.2.1 b b')) (i.2.1 (r.1 b) (r.1 b'))))
    (sub-sum b b' (i.1 (r.1 b)) (i.1 (r.1 b'))) ;
  rest-scale (c : R.R) (b : B.M) : Id B.M (rest (B.sm c b)) (B.sm c (rest b)) =
   trans (ap (\ t -> MB.sub (B.sm c b) t) (trans (ap i.1 (r.2.2 c b)) (i.2.2 c (r.1 b))))
    (sym (MB.sm-sub c b (i.1 (r.1 b)))) ;
  theorem : Id MD.Module B (MS.plus A kernel) =
   SIP.sip B (MS.plus A kernel) ((parts,Pr.qinv B.M P2.Carrier parts join parts-join join-parts),
    \ b b' -> P2.pair-eq _ _ _ _ (r.2.1 b b') (KS.eq _ _ (rest-add b b')),
    \ c b -> P2.pair-eq _ _ _ _ (r.2.2 c b) (KS.eq _ _ (rest-scale c b))) ;
 } ;
} ;
