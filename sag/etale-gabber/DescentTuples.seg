-- A finite enumeration of maps Fin n -> Fin m, with finite open union.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module TC = TruncationCombinators[l] ; module Tr = Truncation[l] ;
module FP = FiniteProduct[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
size : Nat -> Nat -> Nat = split { zero -> \ m -> suc zero ; suc n | ih -> \ m -> FP.size m (ih m) } ;
decode : (n m : Nat) -> Fin (size n m) -> Fin n -> Fin m = split {
 zero -> \ m a e -> efq e ;
 suc n | ih -> \ m a -> snoc (Fin n) (Fin m)
  (ih m (FP.decode m (size n m) a).2) (FP.decode m (size n m) a).1 } ;
encode : (n m : Nat) -> (Fin n -> Fin m) -> Fin (size n m) = split {
 zero -> \ m f -> inr tt ;
 suc n | ih -> \ m f -> FP.encode m (size n m) (f (inr tt)) (ih m (\ j -> f (inl j))) } ;
decode-encode : (n m : Nat) (f : Fin n -> Fin m) -> Id (Fin n -> Fin m) (decode n m (encode n m f)) f = split {
 zero -> \ m f -> F.funext (Fin zero) (\ e -> Fin m) _ f (\ e -> efq e) ;
 suc n | ih -> \ m f -> F.funext (Fin (suc n)) (\ j -> Fin m) _ f
  (AffineFinite[l].section n
   (\ j -> Id (Fin m) (decode (suc n) m (encode (suc n) m f) j) (f j))
   (\ j -> trans (ap (\ p -> decode n m p.2 j)
     (FP.decode-encode m (size n m) (f (inr tt)) (encode n m (\ k -> f (inl k)))))
    (ap (\ g -> g j) (ih m (\ k -> f (inl k)))))
   (ap (\ p -> p.1) (FP.decode-encode m (size n m) (f (inr tt)) (encode n m (\ k -> f (inl k)))))) } ;
opaque decode ; opaque encode ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module OP = OpenProp[l].Over[R,setR] ; module FO = EtaleFiniteOpen[l].Over[R,setR] ;
 module At (n m : Nat) (Q : (Fin n -> Fin m) -> U l) (opens : (s : Fin n -> Fin m) -> OP.Open (Q s)) {
  Some : U l = Tr.Trunc[(s : Fin n -> Fin m) * Q s].carrier ;
  Finite : U l = FO.Some (size n m) (\ a -> Q (decode n m a)) ;
  to (h : Some) : Finite = TC.map ((s : Fin n -> Fin m) * Q s)
   ((a : Fin (size n m)) * Q (decode n m a))
   (\ z -> (encode n m z.1,Pr.subst (Fin n -> Fin m) Q _ _ (sym (decode-encode n m z.1)) z.2)) h ;
  from (h : Finite) : Some = TC.map ((a : Fin (size n m)) * Q (decode n m a))
   ((s : Fin n -> Fin m) * Q s) (\ z -> (decode n m z.1,z.2)) h ;
  theorem : OP.Open Some = OP.along Some Finite
   (to,Pr.qinv Some Finite to from (\ h -> Tr.Trunc[(a : Fin (size n m)) * Q (decode n m a)].proposition _ h)
    (\ h -> Tr.Trunc[(s : Fin n -> Fin m) * Q s].proposition _ h))
   (FO.finite-open (size n m) (\ a -> Q (decode n m a)) (\ a -> opens (decode n m a))) ;
  opaque theorem ;
 } ;
} ;
