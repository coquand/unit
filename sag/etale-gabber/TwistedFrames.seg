-- Frames of descended modules, and the projector of Hom(V, W).
-- Over X with a gerbe G x at each x (TWISTEDMODULES.Family), a family V of
-- modules over the G x is framed of rank r if every fibre V x g merely has a
-- frame of rank r (FRAMES).
--  (descent)  If V has weight 0, its descended module at x is V x g for any
--             g : G x (descend-fibre); G x is merely inhabited and a mere
--             frame is a proposition, so the descended family is framed.
--  (Hom)      For twisted V, W framed of ranks r, s, the family
--             Hom(V x g, W x g) has weight 0 (Homs.Same) and is framed of
--             rank r s (HOMFRAMES), so its descended family is framed.
--  (affine)   On X = Spec Alg, AFFINEFRAMEPROJECTOR then gives merely a
--             projector over Alg whose image is the global sections of the
--             descended Hom(V, W).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module HF = HomFrames[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module Family (X : U l) (G : X -> TM.GB.AGerbe) {
  module TF = TM.Family[X,G] ;
  point (x : X) : Tr.Trunc[(G x).1].carrier = (G x).2.2.1 ;
  Framed (V : (x : X) -> (G x).1 -> MD.Module) (r : Nat) : U l =
   (x : X) (g : (G x).1) -> Tr.Trunc[FR.Frame[V x g,r]].carrier ;
  -- (descent)
  descend-frames (V : TF.Weighted (\ a -> TM.UG.one)) (r : Nat) (fv : Framed V.1 r) (x : X) :
   Tr.Trunc[FR.Frame[TF.descend V x,r]].carrier =
   Tr.Trunc[(G x).1].induction @l (\ g -> Tr.Trunc[FR.Frame[TF.descend V x,r]].carrier)
    (\ g -> Tr.Trunc[FR.Frame[TF.descend V x,r]].proposition)
    (\ g -> HF.transport (V.1 x g) (TF.descend V x)
     (Pr1.sym MD.Module (TF.descend V x) (V.1 x g) (TF.descend-fibre V x g)) r (fv x g))
    (point x) ;
  -- (Hom)
  module Hom (V W : TF.Twisted) {
   H (x : X) (g : (G x).1) : MD.Module = TM.At[TM.charge (TM.banded (G x))].Homs[V.1 x,W.1 x].H g ;
   weight-zero : TF.Weighted (\ a -> TM.UG.one) =
    (H,\ x -> TM.At[TM.charge (TM.banded (G x))].Homs[V.1 x,W.1 x].Same[TM.At[TM.charge (TM.banded (G x))].bnd,V.2 x,W.2 x].weight) ;
   descended (x : X) : MD.Module = TF.descend weight-zero x ;
   frames (r s : Nat) (fv : Framed V.1 r) (fw : Framed W.1 s) (x : X) :
    Tr.Trunc[FR.Frame[descended x,Pairing[l].times r s]].carrier =
    descend-frames weight-zero (Pairing[l].times r s)
     (\ x g -> HF.hom-frames (V.1 x g) (W.1 x g) r s (fv x g) (fw x g)) x ;
  } ;
 } ;
 -- (affine)
 module OnAffine (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
  (Alg : Algebras[l].Over[R,setR].Algebra) (fp : Presentations[l].Over[R,setR].FP Alg)
  (G : Algebras[l].Over[R,setR].Spec Alg -> TM.GB.AGerbe) {
  module Fam = Family[Algebras[l].Over[R,setR].Spec Alg,G] ;
  module Hom (V W : Fam.TF.Twisted) (r s : Nat) (fv : Fam.Framed V.1 r) (fw : Fam.Framed W.1 s) {
   module AP = AffineFrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Fam.Hom[V,W].descended,
    Pairing[l].times r s,Fam.Hom[V,W].frames r s fv fw] ;
   theorem : Tr.Trunc[AP.Witness].carrier = AP.theorem ;
  } ;
 } ;
} ;
