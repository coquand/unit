-- The endomorphism algebra of a module, using the existing Hom module.
-- Multiplication is composition: (f g)(x) = f(g(x)); the unit is identity.
-- Associativity and unit laws follow by extensionality, distributivity
-- and compatibility with scalars by linearity of the maps.
-- This is the shared construction for descended End and splitting gerbes;
-- ch-univalence/EndAlgebra wraps it for its existing clients.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module NA = NCAlgebra[l].Over[R,setR] ;
 module At (M : MD.Module) {
  module H = HM.At[M,M] ;
  V : MD.Module = H.carrier ;
  one : H.S.E = (\ x -> x,\ x y -> refl (M.madd x y),\ a x -> refl (M.sm a x)) ;
  mul (f g : H.S.E) : H.S.E = (\ x -> f.1 (g.1 x),
   \ x y -> trans (ap f.1 (g.2.1 x y)) (f.2.1 (g.1 x) (g.1 y)),
   \ a x -> trans (ap f.1 (g.2.2 a x)) (f.2.2 a (g.1 x))) ;
  one-at (x : M.M) : Id M.M (one.1 x) x = refl x ;
  mul-at (f g : H.S.E) (x : M.M) : Id M.M ((mul f g).1 x) (f.1 (g.1 x)) = refl (f.1 (g.1 x)) ;
  algebra : NA.Algebra = new NA.Algebra[H.S.E,V.setM,V.mz,V.madd,V.mneg,V.sm,one,mul,
   V.maddA,V.maddC,V.maddZ,V.maddN,V.smO,V.smA,V.smD,V.smE,
   \ f g h -> H.ext _ _ (\ x -> refl (f.1 (g.1 (h.1 x)))),
   \ f -> H.ext _ _ (\ x -> refl (f.1 x)),
   \ f -> H.ext _ _ (\ x -> refl (f.1 x)),
   \ f g h -> H.ext _ _ (\ x -> f.2.1 (g.1 x) (h.1 x)),
   \ f g h -> H.ext _ _ (\ x -> refl (M.madd (f.1 (h.1 x)) (g.1 (h.1 x)))),
   \ a f g -> H.ext _ _ (\ x -> refl (M.sm a (f.1 (g.1 x)))),
   \ a f g -> H.ext _ _ (\ x -> f.2.2 a (g.1 x))] ;
 } ;
} ;
