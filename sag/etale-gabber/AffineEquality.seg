-- SAG 5.5.1. Equality in an affine type is closed and affine.
-- More generally every closed proposition is affine, via a presentation
-- with no variables and its finite list of constant equations.
-- No Loc, SQC, or Z-choice hypothesis is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ; module E = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ; module FA = FunctionAlgebra[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ; module Finite = AffineFinite[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ; module S = Schemes[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module Equations (n : Nat) (xs : Fin n -> R.R) {
  V : U l = Fin zero ;
  values : V -> R.R = split { } ;
  es : Fin n -> P.Expr V = \ i -> cst (xs i) ;
  presentation : P.Presentation = (zero,Finite.listed V n es) ;
  sol-prop : Pr.isProp (SA.Sol presentation) = \ a b ->
   P.solutions-ext presentation C.base a b (AffineFinite[l].empty-section (\ i -> Id R.R (a.1 i) (b.1 i))) ;
  to (z : CP.Zeros n xs) : SA.Sol presentation =
   (values,Finite.zeros-in V C.base values n es z) ;
  from (s : SA.Sol presentation) : CP.Zeros n xs = Finite.zeros-out V C.base s.1 n es s.2 ;
  equivalence : Pr.Equiv (CP.Zeros n xs) (SA.Sol presentation) =
   (to,Pr.qinv _ _ to from (\ s -> sol-prop _ s) (\ z -> CP.zeros-prop n xs _ z)) ;
 } ;
 closed-small-affine (Q : U l) (closed : CP.Closed Q) : SA.Affine Q =
  Tr.Trunc[CP.Witness Q].induction @l (\ t -> SA.Affine Q) (\ t -> SA.proposition Q)
   (\ w -> Tr.Trunc[SA.Witness Q].inc
    (Equations[w.1,w.2.1].presentation,E.compose _ _ _ w.2.2 Equations[w.1,w.2.1].equivalence)) closed ;
 closed-affine (Q : U l) (closed : CP.Closed Q) : FA.Affine Q = SA.to-affine Q (closed-small-affine Q closed) ;
 module Coordinates (X : U l) (w : SA.Witness X) (x y : X) {
  n : Nat = w.1.1 ;
  ds (i : Fin n) : R.R = R.add ((w.2.1 x).1 i) (R.neg ((w.2.1 y).1 i)) ;
  to-zeros (h : Id X x y) : CP.Zeros n ds = \ i ->
   trans (ap (\ z -> R.add ((w.2.1 x).1 i) (R.neg ((w.2.1 z).1 i))) (sym h)) (R.addN ((w.2.1 x).1 i)) ;
  from-zeros (z : CP.Zeros n ds) : Id X x y =
   E.injective X (SA.Sol w.1) w.2.1 w.2.2 x y
    (P.solutions-ext w.1 C.base (w.2.1 x) (w.2.1 y) (\ i -> RR.difference-zero _ _ (z i))) ;
  setX : Pr.isSet X = AffineHLevels[l].set-from-equiv X (SA.Sol w.1) (SA.sol-set w.1) w.2.1 w.2.2 ;
  witness : CP.Witness (Id X x y) = CP.from-iff (Id X x y) (setX x y) n ds to-zeros from-zeros ;
 } ;
 small-closed (X : U l) (aff : SA.Affine X) (x y : X) : CP.Closed (Id X x y) =
  Tr.Trunc[SA.Witness X].induction @l (\ t -> CP.Closed (Id X x y))
   (\ t -> Tr.Trunc[CP.Witness (Id X x y)].proposition)
   (\ w -> Tr.Trunc[CP.Witness (Id X x y)].inc Coordinates[X,w,x,y].witness) aff ;
 small-affine (X : U l) (aff : SA.Affine X) (x y : X) : SA.Affine (Id X x y) =
  closed-small-affine (Id X x y) (small-closed X aff x y) ;
 closed (X : U l) (aff : FA.Affine X) (x y : X) : CP.Closed (Id X x y) =
  small-closed X (SA.from-affine X aff) x y ;
 affine (X : U l) (aff : FA.Affine X) (x y : X) : FA.Affine (Id X x y) =
  closed-affine (Id X x y) (closed X aff x y) ;
 scheme (X : U l) (aff : FA.Affine X) (x y : X) : S.Scheme (Id X x y) = SB.affine (Id X x y) (affine X aff x y) ;
 diagonal (X : U l) (aff : FA.Affine X) : CP.ClosedSubtype (X * X) (\ p -> Id X p.1 p.2) =
  \ p -> closed X aff p.1 p.2 ;
} ;
