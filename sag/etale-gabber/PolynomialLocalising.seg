-- If psi : R -> C is localising at s, so is psi[X] : R[X] -> C[X] at the
-- constant s (LQ XVI.3.1 and 3.2 without the variable rescaling, which is
-- done once, for matrices, in PATCHLIFT).  Write e_k = psi[X](s^k).
--   Clearing, by induction on the list c :: P of coefficients: from
--   psi r = psi (s^k) c and psi[X] q = e_k' P,
--     psi[X] (s^k' r + s^k X q) = e_k' e_k c + e_k X e_k' P = e_(k+k') (c + X P).
--   Killing: psi[X] p = 0 gives psi (p_j) = 0 for every coefficient; one
--   power s^k kills them all (induction on the list), and then
--   s^k p = (s^k p_j)_j = 0.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module B = ExponentBounds[l] ;
module Over (R C : CRing) (setR : Pr.isSet R.R) (setC : Pr.isSet C.R) (psi : H.Hom R C) (s : R.R)
 (loc : Localising[l].Over[R,C,psi,s].Localising) {
 module LB = Localising[l].Over[R,C,psi,s] ;
 module Ch = Rescaling[l].Change[R,C,setR,setC,psi] ;
 module RX = Ch.RX ;
 module CX = Ch.CX ;
 module RP = Poly[l].PolyR[R] ;
 module RM = RawMultiplication[l].Laws[R] ;
 module MR = Mul[l].MulR[R] ;
 module CR = RL[CX.ring] ;
 module LX = Localising[l].Over[RX.ring,CX.ring,Ch.hom,RX.constant s] ;
 pow-constant (k : Nat) : Id RX.Carrier (LX.pow k) (RX.constant (LB.pow k)) =
  sym (AffinePowers[l].power-map R RX.ring RX.inclusion s k) ;
 -- e_k = psi (s^k) as a constant
 image-pow (k : Nat) : Id CX.Carrier (Ch.hom.1 (LX.pow k)) (CX.constant (psi.1 (LB.pow k))) =
  trans (ap Ch.hom.1 (pow-constant k)) (Ch.hom-constant (LB.pow k)) ;

 -- Clearing.
 module Step (c : C.R) (P : List C.R) (x : B.Bound (LB.Clears c))
  (y : B.Bound (LX.Clears (CX.include P))) {
  k : Nat = x.1 ;
  k' : Nat = y.1 ;
  r : R.R = x.2.1 ;
  q : RX.Carrier = y.2.1 ;
  e : CX.Carrier = Ch.hom.1 (LX.pow k) ;
  e' : CX.Carrier = Ch.hom.1 (LX.pow k') ;
  p : RX.Carrier = RX.addQ (RX.mulQ (LX.pow k') (RX.constant r)) (RX.mulQ (LX.pow k) (RX.mulQ RX.variable q)) ;
  -- psi[X] r = e c
  numerator : Id CX.Carrier (Ch.hom.1 (RX.constant r)) (CX.mulQ e (CX.constant c)) =
   calc CX.Carrier { Ch.hom.1 (RX.constant r)
     =< Ch.hom-constant r > CX.constant (psi.1 r)
     =< ap CX.constant x.2.2 > CX.constant (C.mul (psi.1 (LB.pow k)) c)
     =< CX.constant-mul (psi.1 (LB.pow k)) c > CX.mulQ (CX.constant (psi.1 (LB.pow k))) (CX.constant c)
     =< ap (\ t -> CX.mulQ t (CX.constant c)) (sym (image-pow k)) > CX.mulQ e (CX.constant c) } ;
  image : Id CX.Carrier (Ch.hom.1 p)
   (CX.addQ (CX.mulQ e' (CX.mulQ e (CX.constant c))) (CX.mulQ e (CX.mulQ CX.variable (CX.mulQ e' (CX.include P))))) =
   trans (Ch.hom.2.2.1 (RX.mulQ (LX.pow k') (RX.constant r)) (RX.mulQ (LX.pow k) (RX.mulQ RX.variable q)))
    (cong2 CX.Carrier CX.addQ _ _ _ _
     (trans (Ch.hom.2.2.2 (LX.pow k') (RX.constant r)) (ap (CX.mulQ e') numerator))
     (trans (Ch.hom.2.2.2 (LX.pow k) (RX.mulQ RX.variable q))
      (ap (CX.mulQ e) (trans (Ch.hom.2.2.2 RX.variable q)
       (cong2 CX.Carrier CX.mulQ _ _ _ _ Ch.hom-variable y.2.2))))) ;
  -- e_(k+k') = e e'
  total : Id CX.Carrier (Ch.hom.1 (LX.pow (plus k k'))) (CX.mulQ e e') =
   trans (ap Ch.hom.1 (LX.PR.power-add (RX.constant s) k k')) (Ch.hom.2.2.2 (LX.pow k) (LX.pow k')) ;
  -- e' (e c) + e (X (e' P)) = (e e') (c + X P)
  regroup : Id CX.Carrier
   (CX.addQ (CX.mulQ e' (CX.mulQ e (CX.constant c))) (CX.mulQ e (CX.mulQ CX.variable (CX.mulQ e' (CX.include P)))))
   (CX.mulQ (CX.mulQ e e') (CX.addQ (CX.constant c) (CX.mulQ CX.variable (CX.include P)))) =
   trans (cong2 CX.Carrier CX.addQ _ _ _ _
     (trans (CR.mul-swap e' e (CX.constant c)) (CX.mul-assoc e e' (CX.constant c)))
     (trans (ap (CX.mulQ e) (CR.mul-swap CX.variable e' (CX.include P)))
      (CX.mul-assoc e e' (CX.mulQ CX.variable (CX.include P)))))
    (sym (CX.distributive (CX.mulQ e e') (CX.constant c) (CX.mulQ CX.variable (CX.include P)))) ;
  equation : Id CX.Carrier (Ch.hom.1 p) (CX.mulQ (Ch.hom.1 (LX.pow (plus k k'))) (CX.include (cons c P))) =
   trans image (trans regroup
    (sym (cong2 CX.Carrier CX.mulQ _ _ _ _ total (CX.horner c P)))) ;
  result : B.Bound (LX.Clears (CX.include (cons c P))) = (plus k k',(p,equation)) ;
 } ;
 clear-list : (P : List C.R) -> B.Merely (LX.Clears (CX.include P)) = split {
  nil -> Tr.Trunc[B.Bound (LX.Clears CX.zeroQ)].inc
   (zero,(RX.zeroQ,trans (H.zero RX.ring CX.ring Ch.hom) (sym (CR.mul-zero (Ch.hom.1 (LX.pow zero)))))) ;
  cons c P | ih ->
   TC.map2 (B.Bound (LB.Clears c)) (B.Bound (LX.Clears (CX.include P))) (B.Bound (LX.Clears (CX.include (cons c P))))
    (\ x y -> Step[c,P,x,y].result) (loc.clear c) ih } ;
 clear (P : CX.Carrier) : B.Merely (LX.Clears P) =
  CX.Q.induction @l (\ Q -> B.Merely (LX.Clears Q)) (\ Q -> Tr.Trunc[B.Bound (LX.Clears Q)].proposition)
   clear-list P ;

 -- Killing.
 RawKills (p : List R.R) (k : Nat) : U l = (j : Nat) -> LB.Kills (RP.coef p j) k ;
 raw-combine (a : R.R) (p : List R.R) (k k' : Nat) (ha : LB.Kills a k) (hp : RawKills p k') :
  RawKills (cons a p) (plus k k') = split {
  zero -> B.raise-right (LB.Kills a) (LB.kills-monotone a) k k' ha ;
  suc j -> LB.kills-monotone (RP.coef p j) k k' (hp j) } ;
 raw-kill : (p : List R.R) -> ((j : Nat) -> Id C.R (psi.1 (RP.coef p j)) C.z) -> B.Merely (RawKills p) = split {
  nil -> \ h -> Tr.Trunc[B.Bound (RawKills nil)].inc (zero,\ j -> RL[R].mul-zero (LB.pow zero)) ;
  cons a p | ih -> \ h ->
   TC.map2 (B.Bound (LB.Kills a)) (B.Bound (RawKills p)) (B.Bound (RawKills (cons a p)))
    (\ x y -> (plus x.1 y.1,raw-combine a p x.1 y.1 x.2 y.2)) (loc.kill a (h zero)) (ih (\ j -> h (suc j))) } ;
 -- s^k p = (s^k p_j)_j
 scale-include (k : Nat) (p : List R.R) :
  Id RX.Carrier (RX.mulQ (LX.pow k) (RX.include p)) (RX.include (MR.scal (LB.pow k) p)) =
  trans (ap (\ t -> RX.mulQ t (RX.include p)) (pow-constant k))
   (trans (RX.Multiply.beta (cons (LB.pow k) nil) p) (RX.Q.relates _ _ (RM.mul-single-left (LB.pow k) p))) ;
 killed (p : List R.R) (w : B.Bound (RawKills p)) : B.Bound (LX.Kills (RX.include p)) =
  (w.1,trans (scale-include w.1 p)
   (RX.Q.relates (MR.scal (LB.pow w.1) p) nil (\ j -> trans (MR.coef-scal (LB.pow w.1) p j) (w.2 j)))) ;
 kill-list (p : List R.R) (h : Id CX.Carrier (Ch.hom.1 (RX.include p)) CX.zeroQ) : B.Merely (LX.Kills (RX.include p)) =
  TC.map (B.Bound (RawKills p)) (B.Bound (LX.Kills (RX.include p))) (killed p)
   (raw-kill p (Ch.raw-kernel p h)) ;
 kill (p : RX.Carrier) : Id CX.Carrier (Ch.hom.1 p) CX.zeroQ -> B.Merely (LX.Kills p) =
  RX.Q.induction @l (\ q -> Id CX.Carrier (Ch.hom.1 q) CX.zeroQ -> B.Merely (LX.Kills q))
   (\ q -> F.isProp-Pi (Id CX.Carrier (Ch.hom.1 q) CX.zeroQ) (\ h -> B.Merely (LX.Kills q))
     (\ h -> Tr.Trunc[B.Bound (LX.Kills q)].proposition))
   kill-list p ;
 localising : LX.Localising = new LX.Localising[clear,kill] ;
} ;
