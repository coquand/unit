-- Inverse pairs of matrices, and matrices along a ring map.  GL_N(R) is
-- represented by pairs (a, b) with a b = 1 = b a.  A ring map f : X -> Y
-- acts entrywise on N x N matrices; it preserves sums, scalar multiples,
-- products (a ring map preserves finite sums) and the unit (the Kronecker
-- delta is built from 0 and 1), hence inverse pairs.  Maps of matrices
-- along pointwise equal ring maps agree.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Invertible (R : CRing) (setR : Pr.isSet R.R) (N : Nat) {
 module M = MnAlgebra[l].Over[R,setR,N] ;
 record Inverse (a b : M.Mat) {
  right : Id M.Mat (M.mmul a b) M.mone ;
  left : Id M.Mat (M.mmul b a) M.mone ;
 } ;
} ;
-- a ring map preserves finite sums
hom-sum (X Y : CRing) (f : H.Hom X Y) : (n : Nat) (v : Fin n -> X.R) ->
 Id Y.R (f.1 (FiniteIdeal[l].Sums[X].sum n v)) (FiniteIdeal[l].Sums[Y].sum n (\ i -> f.1 (v i))) = split {
 zero -> \ v -> H.zero X Y f ;
 suc n | r -> \ v -> trans (f.2.2.1 (v (inr tt)) (FiniteIdeal[l].Sums[X].sum n (\ i -> v (inl i))))
  (ap (Y.add (f.1 (v (inr tt)))) (r (\ i -> v (inl i)))) } ;
module Over (X Y : CRing) (setX : Pr.isSet X.R) (setY : Pr.isSet Y.R) (f : H.Hom X Y) (N : Nat) {
 module MX = MnAlgebra[l].Over[X,setX,N] ;
 module MY = MnAlgebra[l].Over[Y,setY,N] ;
 module IX = Invertible[X,setX,N] ;
 module IY = Invertible[Y,setY,N] ;
 map (a : MX.Mat) : MY.Mat = \ i j -> f.1 (a i j) ;
 map-add (a b : MX.Mat) : Id MY.Mat (map (MX.madd a b)) (MY.madd (map a) (map b)) =
  MY.mat-eq (map (MX.madd a b)) (MY.madd (map a) (map b)) (\ i j -> f.2.2.1 (a i j) (b i j)) ;
 map-scale (c : X.R) (a : MX.Mat) : Id MY.Mat (map (MX.mscale c a)) (MY.mscale (f.1 c) (map a)) =
  MY.mat-eq (map (MX.mscale c a)) (MY.mscale (f.1 c) (map a)) (\ i j -> f.2.2.2 c (a i j)) ;
 map-zero : Id MY.Mat (map MX.mzero) MY.mzero =
  MY.mat-eq (map MX.mzero) MY.mzero (\ i j -> H.zero X Y f) ;
 map-mul (a b : MX.Mat) : Id MY.Mat (map (MX.mmul a b)) (MY.mmul (map a) (map b)) =
  MY.mat-eq (map (MX.mmul a b)) (MY.mmul (map a) (map b)) (\ i j ->
   trans (hom-sum X Y f N (\ k -> X.mul (a i k) (b k j)))
    (FiniteIdeal[l].Sums[Y].sum-cong N (\ k -> f.1 (X.mul (a i k) (b k j)))
     (\ k -> Y.mul (f.1 (a i k)) (f.1 (b k j))) (\ k -> f.2.2.2 (a i k) (b k j)))) ;
 delta-map : (n : Nat) (i j : Fin n) ->
  Id Y.R (f.1 (MnSums[l].Over[X].delta n i j)) (MnSums[l].Over[Y].delta n i j) = split {
  zero -> \ i j -> H.zero X Y f ;
  suc n | r -> split {
   inl a -> split { inl b -> r a b ; inr t -> H.zero X Y f } ;
   inr s -> split { inl b -> H.zero X Y f ; inr t -> f.2.1 } } } ;
 map-one : Id MY.Mat (map MX.mone) MY.mone = MY.mat-eq (map MX.mone) MY.mone (delta-map N) ;
 map-inverse (a b : MX.Mat) (h : IX.Inverse[a,b]) : IY.Inverse[map a,map b] =
  new IY.Inverse[map a,map b,
   trans (sym (map-mul a b)) (trans (ap map h.right) map-one),
   trans (sym (map-mul b a)) (trans (ap map h.left) map-one)] ;
 -- maps along pointwise equal ring maps agree
 map-ext (g : H.Hom X Y) (e : (x : X.R) -> Id Y.R (f.1 x) (g.1 x)) (a : MX.Mat) :
  Id MY.Mat (map a) (\ i j -> g.1 (a i j)) =
  MY.mat-eq (map a) (\ i j -> g.1 (a i j)) (\ i j -> e (a i j)) ;
} ;
