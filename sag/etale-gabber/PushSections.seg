-- Sections over an affine type with a scalar frame, and the positive rank
-- of a finite free module (GABBER-PROPER-DESIGN.md, section 5, rules (1), (2)).
--  (affine)  Y affine, an R-frame of the functions Y -> R, Y not-not
--            inhabited, W : Y -> Module with fibres merely of bases of rank
--            r+1.  Then the sections (y : Y) -> W y merely have a basis of
--            a positive rank.  For Y = Spec A this is
--            AFFINESECTIONFRAME.Positive; a witness Y = Spec A gives a path
--            Y = Spec A in U l (ua), along which the whole claim, quantified
--            over W, the frame, inhabitation and the bases, is transported
--            once.
--  (rank)    Rank M = (n : Nat) * ||Basis(M, n+1)|| is a proposition: two
--            bases have the same rank (RANKUNIQUE), and Nat is a set.  So a
--            mere basis of positive rank gives an element of Rank M.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module TS = TowerScalars[l].Over[R,setR,axioms] ;
 -- (affine)
 Result (Y : U l) (W : Y -> MD.Module) : U l = Tr.Trunc[(n : Nat) * LF.Basis[MD.pi Y W,suc n]].carrier ;
 Claim (Y : U l) : U l+ = (W : Y -> MD.Module) (m : Nat) (fr : FR.Frame[TS.Fn Y,m]) (inh : Not (Not Y)) (r : Nat)
  (bases : (y : Y) -> Tr.Trunc[LF.Basis[W y,suc r]].carrier) -> Result Y W ;
 spec (A : C.Algebra) (fp : P.FP A) : Claim (C.Spec A) = \ W m fr inh r bases ->
  AffineSectionFrame[l].Over[R,setR,axioms].At[A,fp,W].Positive[m,fr,inh,r,bases].theorem ;
 along (Y : U l) (w : FA.AffineWitness Y) : Claim Y =
  Hi.subst (U l) Claim (C.Spec w.1) Y
   (Hi.sym (U l) Y (C.Spec w.1) (Axioms[l].UnivalenceLemmas[univ @l].ua Y (C.Spec w.1) w.2.2)) (spec w.1 w.2.1) ;
 affine (Y : U l) (aff : FA.Affine Y) : Claim Y = \ W m fr inh r bases ->
  Tr1.Trunc[FA.AffineWitness Y].induction @l (\ t -> Result Y W)
   (\ t -> Tr.Trunc[(n : Nat) * LF.Basis[MD.pi Y W,suc n]].proposition)
   (\ w -> along Y w W m fr inh r bases) aff ;
 -- (rank)
 pred : Nat -> Nat = split { zero -> zero ; suc n -> n } ;
 Rank (M : MD.Module) : U l = (n : Nat) * Tr.Trunc[LF.Basis[M,suc n]].carrier ;
 same (M : MD.Module) (p q : Rank M) : Id Nat p.1 q.1 =
  Tr.Trunc[LF.Basis[M,suc p.1]].induction @l (\ b -> Id Nat p.1 q.1) (\ b -> NatSheaf[l].nat-set p.1 q.1)
   (\ b -> Tr.Trunc[LF.Basis[M,suc q.1]].induction @l (\ b' -> Id Nat p.1 q.1) (\ b' -> NatSheaf[l].nat-set p.1 q.1)
    (\ b' -> ap pred (RankUnique[l].Over[R,setR,axioms].rank M (suc p.1) (suc q.1) b b')) q.2) p.2 ;
 rank-prop (M : MD.Module) : Pr.isProp (Rank M) = \ p q ->
  Pr.Sigma-eq Nat (\ n -> Tr.Trunc[LF.Basis[M,suc n]].carrier) p.1 q.1 p.2 q.2 (same M p q)
   (Tr.Trunc[LF.Basis[M,suc q.1]].proposition) ;
 extract (M : MD.Module) (h : Tr.Trunc[(n : Nat) * LF.Basis[M,suc n]].carrier) : Rank M =
  Tr.Trunc[(n : Nat) * LF.Basis[M,suc n]].induction @l (\ b -> Rank M) (\ b -> rank-prop M)
   (\ b -> (b.1,Tr.Trunc[LF.Basis[M,suc b.1]].inc b.2)) h ;
} ;
