-- Base change of projectors along a ring map f : A -> B.  f(p) is a
-- projector, since f(p) f(p) = f(p p) = f(p).  Base change commutes with
-- block sums (entrywise, as f 0 = 0) and Kronecker products (f (y x) =
-- f(y) f(x)), and sends 1_K to 1_K and 0_K to 0_K
-- (COMPLEMENTS.Null); so the images agree (PROJECTORS.Equal), and in K_0(B)
-- (K0)
--     [f(p + q)] = [f p] + [f q],   [f 1_K] = [B^K],   [f 0_K] = 0.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (f : H.Hom A B) {
 module KA = K0[l].Over[A,setA] ;
 module KB = K0[l].Over[B,setB] ;
 module PA = KA.PJ ;
 module PB = KB.PJ ;
 module CA = Complements[l].Over[A,setA] ;
 module CB = Complements[l].Over[B,setB] ;
 module At (K : Nat) {
  module MM = MatrixMap[l].Over[A,B,setA,setB,f,K] ;
  idempotent (X : MM.MX.Mat) (h : Id MM.MX.Mat (MM.MX.mmul X X) X) : Id MM.MY.Mat (MM.MY.mmul (MM.map X) (MM.map X)) (MM.map X) =
   trans (sym (MM.map-mul X X)) (ap MM.map h) ;
 } ;
 map (p : PA.Projector) : PB.Projector =
  new PB.Projector[p.size,At[p.size].MM.map p.matrix,At[p.size].idempotent p.matrix p.idempotent] ;

 module Sum (p q : PA.Projector) {
  module DA = DirectSums[l].Over[A,setA,p.size,q.size] ;
  module DB = DirectSums[l].Over[B,setB,p.size,q.size] ;
  module MP = At[p.size].MM ;
  module MQ = At[q.size].MM ;
  module M2 = At[plus p.size q.size].MM ;
  pick-map : (e e' : DA.Side) -> Id B.R (f.1 (DA.pick p.matrix q.matrix e e')) (DB.pick (MP.map p.matrix) (MQ.map q.matrix) e e') = split {
   inl i -> split { inl j -> refl (f.1 (p.matrix i j)) ; inr j -> H.zero A B f } ;
   inr i -> split { inl j -> H.zero A B f ; inr j -> refl (f.1 (q.matrix i j)) } } ;
  matrix : Id M2.MY.Mat (M2.map (DA.dsum p.matrix q.matrix)) (DB.dsum (MP.map p.matrix) (MQ.map q.matrix)) =
   M2.MY.mat-eq (M2.map (DA.dsum p.matrix q.matrix)) (DB.dsum (MP.map p.matrix) (MQ.map q.matrix))
    (\ x y -> pick-map (DA.side x) (DA.side y)) ;
  iso : KB.Iso (map PA.Sum[p,q].projector) PB.Sum[map p,map q].projector =
   PB.Equal[plus p.size q.size,M2.map (DA.dsum p.matrix q.matrix),DB.dsum (MP.map p.matrix) (MQ.map q.matrix),
    (map PA.Sum[p,q].projector).idempotent,PB.Sum[map p,map q].projector.idempotent,matrix].iso ;
  class : Id KB.K0.R (KB.class (map PA.Sum[p,q].projector)) (KB.K0.add (KB.class (map p)) (KB.class (map q))) =
   trans (KB.class-iso (map PA.Sum[p,q].projector) PB.Sum[map p,map q].projector iso) (sym (KB.class-sum (map p) (map q))) ;
 } ;
 module Free (K : Nat) {
  iso : KB.Iso (map PA.Free[K].projector) PB.Free[K].projector =
   PB.Equal[K,At[K].MM.map At[K].MM.MX.mone,At[K].MM.MY.mone,(map PA.Free[K].projector).idempotent,
    PB.Free[K].projector.idempotent,At[K].MM.map-one].iso ;
  class : Id KB.K0.R (KB.class (map PA.Free[K].projector)) (KB.free K) =
   KB.class-iso (map PA.Free[K].projector) PB.Free[K].projector iso ;
 } ;
 module Null (n : Nat) {
  iso : KB.Iso (map CA.Null[n].projector) CB.Null[n].projector =
   PB.Equal[n,At[n].MM.map At[n].MM.MX.mzero,At[n].MM.MY.mzero,(map CA.Null[n].projector).idempotent,
    CB.Null[n].projector.idempotent,At[n].MM.map-zero].iso ;
  class : Id KB.K0.R (KB.class (map CA.Null[n].projector)) KB.K0.z =
   trans (KB.class-iso (map CA.Null[n].projector) CB.Null[n].projector iso) CB.Null[n].class ;
 } ;
 module Product (p q : PA.Projector) {
  module KA2 = Kronecker[l].Over[A,setA,p.size,q.size] ;
  module KB2 = Kronecker[l].Over[B,setB,p.size,q.size] ;
  module MN = At[Pairing[l].times p.size q.size].MM ;
  -- f (Y_jj' X_ii') = f(Y_jj') f(X_ii')
  matrix : Id MN.MY.Mat (MN.map (KA2.kron p.matrix q.matrix)) (KB2.kron (At[p.size].MM.map p.matrix) (At[q.size].MM.map q.matrix)) =
   MN.MY.mat-eq (MN.map (KA2.kron p.matrix q.matrix)) (KB2.kron (At[p.size].MM.map p.matrix) (At[q.size].MM.map q.matrix))
    (\ x y -> f.2.2.2 (p.matrix (KA2.first x) (KA2.first y)) (q.matrix (KA2.second x) (KA2.second y))) ;
  iso : KB.Iso (map PA.Product[p,q].projector) PB.Product[map p,map q].projector =
   PB.Equal[Pairing[l].times p.size q.size,MN.map (KA2.kron p.matrix q.matrix),
    KB2.kron (At[p.size].MM.map p.matrix) (At[q.size].MM.map q.matrix),
    (map PA.Product[p,q].projector).idempotent,PB.Product[map p,map q].projector.idempotent,matrix].iso ;
 } ;
 zero-iso : KB.Iso (map PA.zeroP) PB.zeroP =
  PB.Equal[zero,At[zero].MM.map PA.MZ.mzero,PB.MZ.mzero,(map PA.zeroP).idempotent,PB.zeroP.idempotent,
   At[zero].MM.MY.mat-eq (At[zero].MM.map PA.MZ.mzero) PB.MZ.mzero (\ i j -> efq i)].iso ;
 one-iso : KB.Iso (map PA.oneP) PB.oneP =
  PB.Equal[suc zero,At[suc zero].MM.map PA.M1.mone,PB.M1.mone,(map PA.oneP).idempotent,PB.oneP.idempotent,
   At[suc zero].MM.map-one].iso ;
} ;
