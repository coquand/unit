-- Iterated principal localizations are localizations at the product.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module I = AffineInterface[l].Over[R,setR] ;
 unique (A L : C.Algebra) (f : A.ring.R) (inc : C.Hom A L) (loc : I.Localizes A L f inc)
  (B : C.Algebra) (h k : C.Hom L B)
  (agree : (a : A.ring.R) -> Id B.ring.R (h.1.1 (inc.1.1 a)) (k.1.1 (inc.1.1 a))) :
  Id (C.Hom L B) h k =
  Equivalences[l].injective _ _ (I.local-map A L B f inc loc.1) (loc.2 B) h k
   (Pr.Sigma-eq _ (\ g -> I.Unit B (g.1.1 f)) _ _ _ _
    (C.ext A B _ _ agree) (AffineRing[l].Laws[B.ring,B.set].unit-prop (k.1.1 (inc.1.1 f)))) ;
 module At (A : C.Algebra) (fi fj : A.ring.R)
  (li : I.LocalizationWitness A fi) (lj : I.LocalizationWitness A fj)
  (ov : I.LocalizationWitness lj.1 (lj.2.2.1.1.1 fi)) {
  O : C.Algebra = ov.1 ;
  fromJ : C.Hom lj.1 O = ov.2.2.1 ;
  fromA : C.Hom A O = C.compose A lj.1 O fromJ lj.2.2.1 ;
  fromI : C.Hom li.1 O = (li.2.2.2.2 O).sec (fromA,ov.2.2.2.1) ;
  beta (a : A.ring.R) : Id O.ring.R (fromI.1.1 (li.2.2.1.1.1 a)) (fromA.1.1 a) =
   ap (\ d -> d.1.1.1 a) ((li.2.2.2.2 O).sec-eq (fromA,ov.2.2.2.1)) ;
  pointI (x : C.Spec O) : C.Spec li.1 = C.compose li.1 O C.base x fromI ;
  pointJ (x : C.Spec O) : C.Spec lj.1 = C.compose lj.1 O C.base x fromJ ;
  same-point (x : C.Spec O) :
   Id (C.Spec A) (C.compose A li.1 C.base (pointI x) li.2.2.1)
    (C.compose A lj.1 C.base (pointJ x) lj.2.2.1) =
   C.ext A C.base _ _ (\ a -> ap x.1.1 (beta a)) ;
  unitJ : I.Unit O (fromA.1.1 fj) =
   AffineRing[l].unit-map lj.1.ring O.ring fromJ.1 (lj.2.2.1.1.1 fj) lj.2.2.2.1 ;
  product : A.ring.R = A.ring.mul fi fj ;
  unit-product : I.Unit O (fromA.1.1 product) =
   Pr.subst O.ring.R (I.Unit O) _ _ (sym (fromA.1.2.2.2 fi fj))
    (AffineRing[l].Laws[O.ring,O.set].unit-product _ _ ov.2.2.2.1 unitJ) ;
  module To (B : C.Algebra) {
   module BR = AffineRing[l].Laws[B.ring,B.set] ;
   module Given (d : I.LocalData A B product) {
    mul-unit : I.Unit B (B.ring.mul (d.1.1.1 fi) (d.1.1.1 fj)) =
     Pr.subst B.ring.R (I.Unit B) _ _ (d.1.1.2.2.2 fi fj) d.2 ;
    ui : I.Unit B (d.1.1.1 fi) = BR.unit-left (d.1.1.1 fi) (d.1.1.1 fj) mul-unit ;
    uj : I.Unit B (d.1.1.1 fj) = BR.unit-right (d.1.1.1 fi) (d.1.1.1 fj) mul-unit ;
    j : C.Hom lj.1 B = (lj.2.2.2.2 B).sec (d.1,uj) ;
    betaJ (a : A.ring.R) : Id B.ring.R (j.1.1 (lj.2.2.1.1.1 a)) (d.1.1.1 a) =
     ap (\ datum -> datum.1.1.1 a) ((lj.2.2.2.2 B).sec-eq (d.1,uj)) ;
    uij : I.Unit B (j.1.1 (lj.2.2.1.1.1 fi)) =
     Pr.subst B.ring.R (I.Unit B) _ _ (sym (betaJ fi)) ui ;
    arrow : C.Hom O B = (ov.2.2.2.2 B).sec (j,uij) ;
    betaO (b : lj.1.ring.R) : Id B.ring.R (arrow.1.1 (fromJ.1.1 b)) (j.1.1 b) =
     ap (\ datum -> datum.1.1.1 b) ((ov.2.2.2.2 B).sec-eq (j,uij)) ;
   } ;
   forward : C.Hom O B -> I.LocalData A B product = I.local-map A O B product fromA unit-product ;
   backward (d : I.LocalData A B product) : C.Hom O B = Given[d].arrow ;
   fb (d : I.LocalData A B product) : Id (I.LocalData A B product) (forward (backward d)) d =
    Pr.Sigma-eq _ (\ h -> I.Unit B (h.1.1 product)) _ _ _ _
     (C.ext A B _ d.1 (\ a -> trans (Given[d].betaO (lj.2.2.1.1.1 a)) (Given[d].betaJ a)))
     (BR.unit-prop (d.1.1.1 product)) ;
   module Back (h : C.Hom O B) {
    module G = Given[forward h] ;
    sameJ : Id (C.Hom lj.1 B) G.j (C.compose lj.1 O B h fromJ) =
     unique A lj.1 fj lj.2.2.1 lj.2.2.2 B G.j _ G.betaJ ;
    result : Id (C.Hom O B) (backward (forward h)) h =
     unique lj.1 O (lj.2.2.1.1.1 fi) fromJ ov.2.2.2 B _ h
      (\ b -> trans (G.betaO b) (ap (\ j -> j.1.1 b) sameJ)) ;
   } ;
   universal : Pr.isEquiv (C.Hom O B) (I.LocalData A B product) forward =
    Pr.qinv _ _ forward backward fb (\ h -> Back[h].result) ;
  } ;
  product-localization : I.LocalizationWitness A product =
   (O,ov.2.1,fromA,unit-product,\ B -> To[B].universal) ;
 } ;
} ;
