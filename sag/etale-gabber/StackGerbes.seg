-- Stacks of R^x-gerbes (H^2 bridges, A4).  A StackGerbe is a TGerbe
-- (TGERBES, carrier in U l) that is moreover a sheaf (descent for objects:
-- the carrier is T-modal; for a 1-type whose paths are sheaves this is the
-- stack condition).  The splitting gerbe of an algebra is one, through its
-- small model (SPLITSMALL, by replacement).  Units: R^x read one level up,
-- for the band of the large splitting groupoid (SPLITBAND).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
-- R^x as a group one level up, and its bands
module Units (R : CRing) (setR : Pr.isSet R.R) {
 module UG = PicardUnits[l].Over[R,setR] ;
 group : Torsor[l+].Ab = new Torsor[l+].Ab[UG.Unit,UG.setU,UG.one,UG.times,UG.inverse,UG.assoc,UG.comm,UG.unitr,UG.invr] ;
 module GB = Gerbe[l+].Gerbes[group] ;
} ;
-- StackGerbe = (X : U l) * band * Laws, Laws the propositions: X a
-- 1-type, close-inhabited, close-connected, paths sheaves, X a sheaf.
--  (eq)   A band-preserving equivalence e : X ~ X' gives G = G'.  By
--         equivalence induction e = id; then the bands agree (ap id = id) and
--         the rest is a proposition.
--  (H2)   For a type X (X = Spec A), H^2 = (X -> StackGerbe) modulo mere
--         equality (QUOTIENT: the set truncation); cl G its class.
--  (lift) A TGerbe whose carrier is a sheaf is a StackGerbe.
--  (homotopic) Bands along homotopic maps into a large Y agree (J on the
--         path of maps): used to compare bands through SPLITSMALL.j.
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module Hi = Prelude[l+] ;
 module F = Axioms[l].FunExtLemmas[fe @l] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module EC = EtaleClosure[l].Over[R,setR,axioms] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module UG = TG.TM.UG ;
 module GB = TG.GB ;
 -- a sheaf at level l is one at level l+
 up (X : U l) (h : ET.T.isModal @l X) : ET.T.isModal @(l+) X = \ i ->
  new Hi.IsEquiv[X, ET.G i -> X, (\ x g -> x), sec := (h i).sec, sec-eq := (h i).sec-eq, ret := (h i).ret, ret-eq := (h i).ret-eq] ;
 -- the structure
 Laws (X : U l) : U l =
  ((a b : X) -> Pr.isSet (Id X a b)) * sh.close X * ((a b : X) -> sh.close (Id X a b))
  * ((a b : X) -> ET.T.isModal @l (Id X a b)) * ET.T.isModal @l X ;
 Structure (X : U l) : U l = ((x : X) -> GB.Band X x) * Laws X ;
 StackGerbe : U l+ = (X : U l) * Structure X ;
 -- accessors
 carrier (G : StackGerbe) : U l = G.1 ;
 band (G : StackGerbe) (x : G.1) : GB.Band G.1 x = G.2.1 x ;
 bnd (G : StackGerbe) (x : G.1) (lp : Id G.1 x x) : UG.Unit = (G.2.1 x).1 lp ;
 gpd (G : StackGerbe) : (a b : G.1) -> Pr.isSet (Id G.1 a b) = G.2.2.1 ;
 inh (G : StackGerbe) : sh.close G.1 = G.2.2.2.1 ;
 conn (G : StackGerbe) : (a b : G.1) -> sh.close (Id G.1 a b) = G.2.2.2.2.1 ;
 paths (G : StackGerbe) : (a b : G.1) -> ET.T.isModal @l (Id G.1 a b) = G.2.2.2.2.2.1 ;
 stack (G : StackGerbe) : ET.T.isModal @l G.1 = G.2.2.2.2.2.2 ;
 -- the propositions
 laws-prop (X : U l) : Pr.isProp (Laws X) =
  Pr.isProp-Sigma ((a b : X) -> Pr.isSet (Id X a b)) (\ h -> sh.close X * ((a b : X) -> sh.close (Id X a b))
    * ((a b : X) -> ET.T.isModal @l (Id X a b)) * ET.T.isModal @l X)
   (F.isProp-Pi X (\ a -> (b : X) -> Pr.isSet (Id X a b)) (\ a -> F.isProp-Pi X (\ b -> Pr.isSet (Id X a b)) (\ b ->
     AffineHLevels[l].set-prop (Id X a b)))) (\ h ->
  Pr.isProp-Sigma (sh.close X) (\ h1 -> ((a b : X) -> sh.close (Id X a b))
    * ((a b : X) -> ET.T.isModal @l (Id X a b)) * ET.T.isModal @l X) (sh.proposition X) (\ h1 ->
  Pr.isProp-Sigma ((a b : X) -> sh.close (Id X a b)) (\ h2 -> ((a b : X) -> ET.T.isModal @l (Id X a b)) * ET.T.isModal @l X)
   (F.isProp-Pi X (\ a -> (b : X) -> sh.close (Id X a b)) (\ a ->
     F.isProp-Pi X (\ b -> sh.close (Id X a b)) (\ b -> sh.proposition (Id X a b)))) (\ h2 ->
  Pr.isProp-Sigma ((a b : X) -> ET.T.isModal @l (Id X a b)) (\ h3 -> ET.T.isModal @l X)
   (F.isProp-Pi X (\ a -> (b : X) -> ET.T.isModal @l (Id X a b)) (\ a ->
     F.isProp-Pi X (\ b -> ET.T.isModal @l (Id X a b)) (\ b -> EC.CL.modal-prop (Id X a b)))) (\ h3 -> EC.CL.modal-prop X)))) ;
 Rest (X : U l) (x : X) (b : Id X x x -> UG.Unit) : U l =
  ((a : UG.Unit) -> FunExtUA[l].isContr ((lp : Id X x x) * Id UG.Unit (b lp) a))
  * ((p q : Id X x x) -> Id UG.Unit (b (Pr.trans X x x x p q)) (UG.times (b p) (b q))) ;
 rest-prop (X : U l) (x : X) (b : Id X x x -> UG.Unit) : Pr.isProp (Rest X x b) =
  Pr.isProp-Sigma ((a : UG.Unit) -> FunExtUA[l].isContr ((lp : Id X x x) * Id UG.Unit (b lp) a))
   (\ h -> (p q : Id X x x) -> Id UG.Unit (b (Pr.trans X x x x p q)) (UG.times (b p) (b q)))
   (F.isProp-Pi UG.Unit (\ a -> FunExtUA[l].isContr ((lp : Id X x x) * Id UG.Unit (b lp) a))
     (\ a -> AffineHLevels[l].contr-prop ((lp : Id X x x) * Id UG.Unit (b lp) a)))
   (\ h -> F.isProp-Pi (Id X x x) (\ p -> (q : Id X x x) -> Id UG.Unit (b (Pr.trans X x x x p q)) (UG.times (b p) (b q)))
     (\ p -> F.isProp-Pi (Id X x x) (\ q -> Id UG.Unit (b (Pr.trans X x x x p q)) (UG.times (b p) (b q)))
      (\ q -> UG.setU _ _))) ;
 -- (eq)
 Preserves (X Y : U l) (s : Structure X) (s' : Structure Y) (e : X -> Y) : U l =
  (x : X) (lp : Id X x x) -> Id UG.Unit ((s'.1 (e x)).1 (Pr.ap X Y e x x lp)) ((s.1 x).1 lp) ;
 ap-id (X : U l) (x y : X) (p : Id X x y) : Id (Id X x y) (Pr.ap X X (\ a -> a) x y p) p =
  idJ X x (\ z q -> Id (Id X x z) (Pr.ap X X (\ a -> a) x z q) q) (refl (refl x)) y p ;
 module Eq (G : StackGerbe) {
  X : U l = G.1 ;
  Mot (Y : U l) (e : Pr.Equiv X Y) : U l+ =
   (s' : Structure Y) (pres : Preserves X Y G.2 s' e.1) -> Id StackGerbe G (Y,s') ;
  same-band (s' : Structure X) (pres : Preserves X X G.2 s' (\ a -> a)) (x : X) (lp : Id X x x) :
   Id UG.Unit ((G.2.1 x).1 lp) ((s'.1 x).1 lp) =
   Pr.trans UG.Unit _ _ _ (Pr.sym UG.Unit _ _ (pres x lp))
    (Pr.ap (Id X x x) UG.Unit (s'.1 x).1 _ _ (ap-id X x x lp)) ;
  base : Mot X (Pr.idEquiv X) = \ s' pres ->
   Hi.ap (Structure X) StackGerbe (\ t -> (X,t)) G.2 s'
    (Pr.Sigma-eq ((x : X) -> GB.Band X x) (\ b -> Laws X) G.2.1 s'.1 G.2.2 s'.2
      (F.funext X (\ x -> GB.Band X x) G.2.1 s'.1 (\ x ->
        Pr.Sigma-eq (Id X x x -> UG.Unit) (\ b -> Rest X x b) (G.2.1 x).1 (s'.1 x).1 (G.2.1 x).2 (s'.1 x).2
         (F.funext (Id X x x) (\ lp -> UG.Unit) _ _ (same-band s' pres x)) (rest-prop X x (s'.1 x).1)))
      (laws-prop X)) ;
  theorem (G' : StackGerbe) (e : Pr.Equiv X G'.1) (pres : Preserves X G'.1 G.2 G'.2 e.1) : Id StackGerbe G G' =
   Axioms[l].UnivalenceLemmas[univ @l].eqind X Mot base G'.1 e G'.2 pres ;
 } ;
 -- (H2)
 module H2 (X : U l) {
  Classes : U l+ = X -> StackGerbe ;
  module T2 = Truncation[l+] ;
  Same (G G' : Classes) : U l+ = T2.Trunc[Id Classes G G'].carrier ;
  module Q = Quotient[l+].Quot[Classes,Same,\ G G' -> T2.Trunc[Id Classes G G'].proposition,
   \ G -> T2.Trunc[Id Classes G G].inc (refl G),
   \ G G' -> TruncationCombinators[l+].map (Id Classes G G') (Id Classes G' G) (Hi.sym Classes G G'),
   \ G G' G'' -> TruncationCombinators[l+].map2 (Id Classes G G') (Id Classes G' G'') (Id Classes G G'') (Hi.trans Classes G G' G'')] ;
  H2 : U l+ = Q.Q ;
  cl (G : Classes) : H2 = Q.inc G ;
  -- classes of gerbes isomorphic at each point are equal
  cl-eq (G G' : Classes) (h : T2.Trunc[(x : X) -> Id StackGerbe (G x) (G' x)].carrier) : Id H2 (cl G) (cl G') =
   Q.relates G G' (TruncationCombinators[l+].map ((x : X) -> Id StackGerbe (G x) (G' x)) (Id Classes G G')
    (Axioms[l+].FunExtLemmas[fe @(l+)].funext X (\ x -> StackGerbe) G G') h) ;
 } ;
 -- (lift)
 lift (G : TG.TGerbe) (stk : ET.T.isModal @l G.carrier) : StackGerbe =
  (G.carrier,G.band,G.gpd,G.inh,G.conn,G.paths,stk) ;
 -- (homotopic)
 homotopic (Z : U l) (Y : U l+) (b : (y : Y) -> Id Y y y -> UG.Unit) (f g : Z -> Y) (h : Id (Z -> Y) f g) (z : Z) (lp : Id Z z z) :
  Id UG.Unit (b (f z) (Hi.ap Z Y f z z lp)) (b (g z) (Hi.ap Z Y g z z lp)) =
  idJ (Z -> Y) f (\ g2 h2 -> Id UG.Unit (b (f z) (Hi.ap Z Y f z z lp)) (b (g2 z) (Hi.ap Z Y g2 z z lp))) (refl (b (f z) (Hi.ap Z Y f z z lp))) g h ;
} ;
