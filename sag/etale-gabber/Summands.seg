-- Summands and powers in a type T with an associative and commutative +
-- (EFFACE: power k A = A^(k+1), k + 1 copies), for the assembly of
-- Proposition `cheap` (CHEAP-DESIGN.md, sections 3 and 4.6).
-- A is a summand of B, A | B, if B = A + C for some C.
--  (order)    A | A + B, B | A + B; A | B and B | D give A | D (complement
--             C + C'); A | B gives A | B + D, D + A | D + B, A + D | B + D;
--             A | B and A' | B' give A + A' | B + B', by the interchange
--             (a + b) + (c + d) = (a + c) + (b + d).
--  (extend)   A' | B' gives A + A' | A^(c+1) + B' (for c = 0 this is
--             D + A | D + B; else A^(c+1) + B' = (A + A^c) + (A' + C)
--             = (A + A') + (A^c + C)); and A | A^(c+1) + D.
--  (powers)   A^(j+1) + A^(e+1) = A^(j+e+2) (EFFACE.powers), so
--             A^(j+1) | A^(j+e+2):  j < k gives A^(j+1) | A^(k+1).
--             A | B gives A^(j+1) | B^(j+1) (by (order), induction on j).
--             (A^(k+1))^(j+1) = A^(n+1), n = exponent k j, where
--             exponent k 0 = k, exponent k (j+1) = k + exponent k j + 1
--             (so n + 1 = (j+1)(k+1)), by induction and EFFACE.powers.
--  (dominate) A^(p+1) | (A^(c+1))^(p+e+2) for all p, e, c: by induction on
--             p, from A | A^(c+1) + D and (extend).
--  (common)   Let W | V^(a+1), V | W^(b+1), and S = V^(K+1) + W^(K'+1).
--             Then S | V^(K+1) + (V^(a+1))^(K'+1) = V^(p+1),
--             p = K + exponent a K' + 1, by (extend) and (powers); likewise
--             S | W^(q+1), q = exponent b K + K' + 1.  With m = p + q + 1,
--             S | (V^(c+1))^(m+1) and S | (W^(d+1))^(m+1) by (dominate)
--             (and p + q = q + p); these are the hypotheses of EFFACE for
--             X = V^(c+1), Y = W^(d+1), which then gives, from X + S = Y + S,
--             X^(2m+2) = Y^(2m+2), i.e. V^(n+1) = W^(n'+1) with
--             n = exponent c (2m+1), n' = exponent d (2m+1).
--  (absorb)   If V + Z = V and Z = W + K', then V = V + (W + K')
--             = W + (V + K'), so W | V.
-- For families of modules (+ the pointwise direct sum, MODULESUMS):
--  (tensor)   U [x] 1_(k+1) = U^(k+1) (TENSORPOWERS.powers, pointwise), and
--             U [x] 1_0 = Hom(R^0 fixed by 1_0, U) is zero: R^0 has the one
--             vector w = 0 w, so a linear f has f w = f (0 w) = 0 (f w) = 0;
--             hence U + U [x] 1_0 = U by (u, 0) |-> u.
--  So W + K' = V [x] 1_N (LOCALLIFT.power) gives W | V^(n+1) for some n:
--  n = k when N = k + 1, and n = 0 by (absorb) when N = 0.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module P1 = Ring[l+] ; module Pr1 = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (T : U l+) (add : T -> T -> T)
 (assoc : (a b c : T) -> Id T (add a (add b c)) (add (add a b) c))
 (comm : (a b : T) -> Id T (add a b) (add b a)) {
 module E = Efface[l].Over[T,add,assoc,comm] ;
 Summand (A B : T) : U l+ = (C : T) * Id T B (add A C) ;
 -- the complement, and the decomposition
 complement (A B : T) (s : Summand A B) : T = s.1 ;
 decomposition (A B : T) (s : Summand A B) : Id T B (add A (complement A B s)) = s.2 ;
 along (A B B' : T) (s : Summand A B) (p : Id T B B') : Summand A B' =
  (complement A B s,P1.trans (P1.sym p) (decomposition A B s)) ;
 -- (order)
 left (A B : T) : Summand A (add A B) = (B,refl (add A B)) ;
 right (A B : T) : Summand B (add A B) = (A,comm A B) ;
 -- D = B + C' = (A + C) + C' = A + (C + C')
 chain (A B D : T) (s : Summand A B) (t : Summand B D) : Summand A D =
  (add (complement A B s) (complement B D t),
   P1.trans (decomposition B D t)
    (P1.trans (P1.ap (\ b -> add b (complement B D t)) (decomposition A B s))
     (P1.sym (assoc A (complement A B s) (complement B D t))))) ;
 widen (A B D : T) (s : Summand A B) : Summand A (add B D) = chain A B (add B D) s (left B D) ;
 -- D + B = D + (A + C) = (D + A) + C
 shift-left (D A B : T) (s : Summand A B) : Summand (add D A) (add D B) =
  (complement A B s,P1.trans (P1.ap (add D) (decomposition A B s)) (assoc D A (complement A B s))) ;
 -- B + D = (A + C) + D = A + (C + D) = A + (D + C) = (A + D) + C
 shift-right (A B D : T) (s : Summand A B) : Summand (add A D) (add B D) =
  (complement A B s,
   P1.trans (P1.ap (\ b -> add b D) (decomposition A B s))
    (P1.trans (P1.sym (assoc A (complement A B s) D))
     (P1.trans (P1.ap (add A) (comm (complement A B s) D)) (assoc A D (complement A B s))))) ;
 -- (a + b) + (c + d) = a + (b + (c + d)) = a + (c + (b + d)) = (a + c) + (b + d)
 interchange (a b c d : T) : Id T (add (add a b) (add c d)) (add (add a c) (add b d)) =
  P1.trans (P1.sym (assoc a b (add c d))) (P1.trans (P1.ap (add a) (E.exchange b c d)) (assoc a c (add b d))) ;
 -- B + B' = (A + C) + (A' + C') = (A + A') + (C + C')
 sums (A B A' B' : T) (s : Summand A B) (s' : Summand A' B') : Summand (add A A') (add B B') =
  (add (complement A B s) (complement A' B' s'),
   P1.trans (P1.ap (\ b -> add b B') (decomposition A B s))
    (P1.trans (P1.ap (add (add A (complement A B s))) (decomposition A' B' s'))
     (interchange A (complement A B s) A' (complement A' B' s')))) ;
 -- (extend)
 extend (A A' B' : T) (s : Summand A' B') : (c : Nat) -> Summand (add A A') (add (E.power c A) B') = split {
  zero -> shift-left A A' B' s ;
  suc c -> (add (E.power c A) (complement A' B' s),
   P1.trans (P1.ap (add (add A (E.power c A))) (decomposition A' B' s))
    (interchange A (E.power c A) A' (complement A' B' s))) } ;
 head (A D : T) : (c : Nat) -> Summand A (add (E.power c A) D) = split {
  zero -> left A D ;
  suc c -> (add (E.power c A) D,P1.sym (assoc A (E.power c A) D)) } ;
 -- (powers)
 raise (A : T) (j e : Nat) : Summand (E.power j A) (E.power (suc (plus j e)) A) =
  (E.power e A,P1.sym (E.powers A j e)) ;
 power-mono (A B : T) (s : Summand A B) : (j : Nat) -> Summand (E.power j A) (E.power j B) = split {
  zero -> s ;
  suc j | r -> sums A B (E.power j A) (E.power j B) s r } ;
 exponent (k : Nat) : Nat -> Nat = split {
  zero -> k ;
  suc j | r -> suc (plus k r) } ;
 iterate (A : T) (k : Nat) : (j : Nat) -> Id T (E.power j (E.power k A)) (E.power (exponent k j) A) = split {
  zero -> refl (E.power k A) ;
  suc j | r -> P1.trans (P1.ap (add (E.power k A)) r) (E.powers A k (exponent k j)) } ;
 -- (dominate)
 dominate (A : T) (c : Nat) : (p e : Nat) -> Summand (E.power p A) (E.power (suc (plus p e)) (E.power c A)) = split {
  zero -> \ e -> head A (E.power e (E.power c A)) c ;
  suc p | r -> \ e -> extend A (E.power p A) (E.power (suc (plus p e)) (E.power c A)) (r e) c } ;
 -- (common)
 module Common (V W : T) (a b : Nat) (wv : Summand W (E.power a V)) (vw : Summand V (E.power b W))
  (K K' c d : Nat) {
  S : T = add (E.power K V) (E.power K' W) ;
  p : Nat = suc (plus K (exponent a K')) ;
  q : Nat = suc (plus (exponent b K) K') ;
  m : Nat = suc (plus p q) ;
  -- S | V^(K+1) + (V^(a+1))^(K'+1) = V^(K+1) + V^(exponent a K' + 1) = V^(p+1)
  in-v : Summand S (E.power p V) =
   along S (add (E.power K V) (E.power K' (E.power a V))) (E.power p V)
    (shift-left (E.power K V) (E.power K' W) (E.power K' (E.power a V)) (power-mono W (E.power a V) wv K'))
    (P1.trans (P1.ap (add (E.power K V)) (iterate V a K')) (E.powers V K (exponent a K'))) ;
  -- S | (W^(b+1))^(K+1) + W^(K'+1) = W^(exponent b K + 1) + W^(K'+1) = W^(q+1)
  in-w : Summand S (E.power q W) =
   along S (add (E.power K (E.power b W)) (E.power K' W)) (E.power q W)
    (shift-right (E.power K V) (E.power K (E.power b W)) (E.power K' W) (power-mono V (E.power b W) vw K))
    (P1.trans (P1.ap (\ t -> add t (E.power K' W)) (iterate W b K)) (E.powers W (exponent b K) K')) ;
  -- p + q = q + p
  reorder : Id T (E.power (suc (plus q p)) (E.power d W)) (E.power m (E.power d W)) =
   P1.ap (\ n -> E.power (suc n) (E.power d W)) (plus-comm q p) ;
  sx : Summand S (E.power m (E.power c V)) =
   chain S (E.power p V) (E.power m (E.power c V)) in-v (dominate V c p q) ;
  sy : Summand S (E.power m (E.power d W)) =
   chain S (E.power q W) (E.power m (E.power d W)) in-w
    (along (E.power q W) (E.power (suc (plus q p)) (E.power d W)) (E.power m (E.power d W)) (dominate W d q p) reorder) ;
  -- EFFACE, for X = V^(c+1) and Y = W^(d+1)
  module Cancel (cancel : Id T (add (E.power c V) S) (add (E.power d W) S)) {
   module EL = E.Lemma[E.power c V,E.power d W,S,complement S (E.power m (E.power c V)) sx,
    complement S (E.power m (E.power d W)) sy,m,cancel,
    decomposition S (E.power m (E.power c V)) sx,decomposition S (E.power m (E.power d W)) sy] ;
   n : Nat = suc (plus m m) ;
   theorem : Id T (E.power (exponent c n) V) (E.power (exponent d n) W) =
    P1.trans (P1.sym (iterate V c n)) (P1.trans EL.powers-theorem (iterate W d n)) ;
  } ;
 } ;
 -- (absorb)
 absorb (V Z W K' : T) (z : Id T (add V Z) V) (h : Id T Z (add W K')) : Summand W V =
  (add V K',
   P1.trans (P1.sym z) (P1.trans (P1.ap (add V) h) (E.exchange V W K'))) ;
} ;
-- (tensor), for families of modules over X with fibres Y x
module Tensors (R : CRing) (setR : Pr.isSet R.R) (X : U l) (Y : X -> U l) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module TP = TensorPowers[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module FS = MS.Families[X,Y] ;
 module SF = Over[FS.Fam,FS.add,FS.assoc,FS.comm] ;
 -- U [x] 1_N, as a family
 free (V : FS.Fam) (N : Nat) : FS.Fam = \ x g -> MT.tensor (V x g) N (TP.one N) ;
 -- the power of a family, at a point, is the power of the module there
 at-point (V : FS.Fam) (x : X) (g : Y x) : (k : Nat) -> Id MD.Module (FS.E.power k V x g) (MS.EM.power k (V x g)) = split {
  zero -> refl (V x g) ;
  suc k | r -> Pr1.ap MD.Module MD.Module (MS.plus (V x g)) (FS.E.power k V x g) (MS.EM.power k (V x g)) r } ;
 powers (V : FS.Fam) (k : Nat) : Id FS.Fam (free V (suc k)) (FS.E.power k V) =
  FS.pointwise (free V (suc k)) (FS.E.power k V)
   (\ x g -> Pr1.trans MD.Module (MT.tensor (V x g) (suc k) (TP.one (suc k))) (MS.EM.power k (V x g)) (FS.E.power k V x g)
     (TP.powers (V x g) k) (Pr1.sym MD.Module (FS.E.power k V x g) (MS.EM.power k (V x g)) (at-point V x g k))) ;
 -- U [x] 1_0 is zero
 module Null (M : MD.Module) {
  module IZ = MT.Image[zero,TP.one zero] ;
  module H = HM.At[MT.I zero (TP.one zero),M] ;
  module MN = Alg73[l].MA[MD.ring,M] ;
  module P2 = MS.Pair[M,H.carrier] ;
  -- the one vector of R^0 is 0 w
  vanish (w : IZ.S.E) : Id IZ.S.E w (IZ.carrier.sm R.z w) =
   IZ.ext w (IZ.carrier.sm R.z w)
    (F.funext (Fin zero) (\ i -> R.R) w.1 (IZ.carrier.sm R.z w).1 (\ i -> absurd (Id R.R (w.1 i) ((IZ.carrier.sm R.z w).1 i)) i)) ;
  -- f w = f (0 w) = 0 (f w) = 0
  vanish-map (f : H.S.E) : Id H.S.E f H.carrier.mz =
   H.ext f H.carrier.mz (\ w -> trans (ap f.1 (vanish w)) (trans (f.2.2 R.z w) (MN.sm-zl (f.1 w)))) ;
  to (u : P2.Carrier) : M.M = u.1 ;
  from (m : M.M) : P2.Carrier = (m,H.carrier.mz) ;
  from-to (u : P2.Carrier) : Id P2.Carrier (from (to u)) u =
   P2.pair-eq u.1 u.1 H.carrier.mz u.2 (refl u.1) (sym (vanish-map u.2)) ;
  theorem : Id MD.Module (MS.plus M H.carrier) M =
   SIP.sip (MS.plus M H.carrier) M
    ((to,Pr.qinv P2.Carrier M.M to from (\ m -> refl m) from-to),
     \ u v -> refl (M.madd u.1 v.1),
     \ c u -> refl (M.sm c u.1)) ;
 } ;
 null (V : FS.Fam) : Id FS.Fam (FS.add V (free V zero)) V =
  FS.pointwise (FS.add V (free V zero)) V (\ x g -> Null[V x g].theorem) ;
 -- W + K' = V [x] 1_N gives W | V^(n+1)
 Power (V W : FS.Fam) : U l+ = (n : Nat) * SF.Summand W (FS.E.power n V) ;
 summand (V W : FS.Fam) : (N : Nat) (K' : FS.Fam) (h : Id FS.Fam (free V N) (FS.add W K')) -> Power V W = split {
  zero -> \ K' h -> (zero,SF.absorb V (free V zero) W K' (null V) h) ;
  suc k -> \ K' h -> (k,(K',Pr1.trans FS.Fam (FS.E.power k V) (free V (suc k)) (FS.add W K')
    (Pr1.sym FS.Fam (free V (suc k)) (FS.E.power k V) (powers V k)) h)) } ;
} ;
