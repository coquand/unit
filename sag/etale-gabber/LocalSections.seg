-- Uniformly scale compatible local numerators and glue them.
-- The action is any endomorphism, so this geometry is independent of module records.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ; module FB = FiniteBounds[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 module SS = SchemeSubtypes[l].Over[R,setR,axioms] ;
 module UB = SchemeUniform[l].Over[R,setR,axioms] ;
 module At (X : U l) (scheme : S.Scheme X) (M : X -> U l)
  (setM : (x : X) -> Pr.isSet (M x)) (step : (x : X) -> M x -> M x)
  (n : Nat) (us : Fin n -> X -> U l)
  (opens : (i : Fin n) (x : X) -> OP.Open (us i x))
  (cover : (x : X) -> Tr.Trunc[(i : Fin n) * us i x].carrier)
  (local : (i : Fin n) (x : X) -> us i x -> M x) {
  module Act (x : X) { module A = Iterates[l].On[M x,step x] ; } ;
  Equal (i j : Fin n) (x : X) (u : us i x) (v : us j x) (k : Nat) : U l =
   Id (M x) (Act[x].A.power k (local i x u)) (Act[x].A.power k (local j x v)) ;
  Bound (i j : Fin n) : U l =
   (k : Nat) * ((x : X) (u : us i x) (v : us j x) -> Equal i j x u v k) ;
  Compatible : U l = (i j : Fin n) (x : X) (u : us i x) (v : us j x) ->
   Tr.Trunc[(k : Nat) * Equal i j x u v k].carrier ;
  Goal : U l = (k : Nat) * (m : (x : X) -> M x) *
   ((i : Fin n) (x : X) (u : us i x) -> Id (M x) (m x) (Act[x].A.power k (local i x u))) ;
  module Pair (i j : Fin n) {
   Overlap : U l = (x : X) * us i x * us j x ;
   overlap-scheme : S.Scheme Overlap =
    SS.open-subtype X scheme (\ x -> us i x * us j x)
     (\ x -> OO.open-and (us i x) (us j x) (opens i x) (opens j x)) ;
   module Uniform = UB.At[Overlap,overlap-scheme,
    \ a k -> Equal i j a.1 a.2.1 a.2.2 k,
    \ a k -> setM a.1 _ _,
    \ a k K h p -> Act[a.1].A.raise-equality (local i a.1 a.2.1) (local j a.1 a.2.2) k K h p] ;
   bound (compat : Compatible) : Tr.Trunc[Bound i j].carrier =
    Tr.Trunc[Uniform.Goal].induction @l
     (\ t -> Tr.Trunc[Bound i j].carrier) (\ t -> Tr.Trunc[Bound i j].proposition)
     (\ b -> Tr.Trunc[Bound i j].inc (b.1,\ x u v -> b.2 (x,u,v)))
     (Uniform.theorem (\ a -> compat i j a.1 a.2.1 a.2.2)) ;
  } ;
  Bounds : U l = (i j : Fin n) -> Bound i j ;
  bounds (compat : Compatible) : Tr.Trunc[Bounds].carrier =
   AffineFinite[l].choice n (\ i -> (j : Fin n) -> Bound i j)
    (\ i -> AffineFinite[l].choice n (Bound i) (\ j -> Pair[i,j].bound compat)) ;
  module Chosen (bs : Bounds) {
   row (i : Fin n) : Nat = FB.bound n (\ j -> (bs i j).1) ;
   N : Nat = FB.bound n row ;
   bounded (i j : Fin n) : CB.le (bs i j).1 N =
    FB.le-trans (bs i j).1 (row i) N
     (FB.bounded n (\ j -> (bs i j).1) j) (FB.bounded n row i) ;
   agree (x : X) (a b : (i : Fin n) * us i x) :
    Id (M x) (Act[x].A.power N (local a.1 x a.2)) (Act[x].A.power N (local b.1 x b.2)) =
    Act[x].A.raise-equality _ _ (bs a.1 b.1).1 N (bounded a.1 b.1) ((bs a.1 b.1).2 x a.2 b.2) ;
   module AtPoint (x : X) {
    module G = SectionDescent[l].At[(i : Fin n) * us i x,M x,setM x,
     \ a -> Act[x].A.power N (local a.1 x a.2),agree x].Inhabited[cover x] ;
   } ;
   result : Goal = (N,\ x -> AtPoint[x].G.result.1,\ i x u -> AtPoint[x].G.result.2 (i,u)) ;
  } ;
  theorem (compat : Compatible) : Tr.Trunc[Goal].carrier =
   Tr.Trunc[Bounds].induction @l (\ t -> Tr.Trunc[Goal].carrier)
    (\ t -> Tr.Trunc[Goal].proposition) (\ bs -> Tr.Trunc[Goal].inc Chosen[bs].result) (bounds compat) ;
 } ;
} ;
