-- Degree bounds are natural numbers, never decisions about leading zeroes.
level l ; open Ring[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 open Poly[l].PolyR[A] ; open Mul[l].MulR[A] ;
 module L = RawLaws[l].Laws[A] ;
 Bound (n : Nat) (p : P) : U l = (k : Nat) -> Id R (coef p (plus n k)) z ;
 tail : P -> P = split { nil -> nil ; cons a p -> p } ;
 tail-coef : (p : P) (k : Nat) -> Id R (coef (tail p) k) (coef p (suc k)) = split {
  nil -> \ k -> refl z ; cons a p -> \ k -> refl (coef p k) } ;
 tail-bound (n : Nat) (p : P) (h : Bound (suc n) p) : Bound n (tail p) =
  \ k -> trans (tail-coef p (plus n k)) (h k) ;
 cut : Nat -> P -> P = split {
  zero -> \ p -> nil ;
  suc n | ih -> \ p -> cons (coef p zero) (ih (tail p)) } ;
 cut-length : (n : Nat) (p : P) -> Id Nat (plen (cut n p)) n = split {
  zero -> \ p -> refl zero ;
  suc n | ih -> \ p -> ap (\ m -> suc m) (ih (tail p)) } ;
 cut-bound (n : Nat) (p : P) : Bound n (cut n p) =
  \ k -> trans (ap (coef (cut n p)) (ap (\ m -> plus m k) (sym (cut-length n p))))
   (coef-beyond (cut n p) k) ;
 cut-equal : (n : Nat) (p : P) -> Bound n p -> peq p (cut n p) = split {
  zero -> \ p h -> h ;
  suc n | ih -> \ p h -> split {
   zero -> refl (coef p zero) ;
   suc k -> trans (sym (tail-coef p k)) (ih (tail p) (tail-bound n p h) k) } } ;
 equal-bound (n : Nat) (p q : P) (eq : peq p q) (h : Bound n p) : Bound n q =
  \ k -> trans (sym (eq (plus n k))) (h k) ;
 add-bound (n : Nat) (p q : P) (hp : Bound n p) (hq : Bound n q) : Bound n (addP p q) =
  \ k -> trans (coef-addP p q (plus n k))
   (trans (ap (\ a -> add a (coef q (plus n k))) (hp k))
    (trans (ap (add z) (hq k)) (addZ z))) ;
 scale-bound (n : Nat) (a : R) (p : P) (h : Bound n p) : Bound n (scal a p) =
  \ k -> trans (coef-scal a p (plus n k)) (trans (ap (mul a) (h k)) (mul-zero a)) ;
 neg-bound (n : Nat) (p : P) (h : Bound n p) : Bound n (L.negP p) =
  scale-bound n (neg o) p h ;
 lower-bound (n : Nat) (p : P) (h : Bound (suc n) p)
  (top-zero : Id R (coef p n) z) : Bound n p = split {
  zero -> trans (ap (coef p) (plus-zero n)) top-zero ;
  suc k -> trans (ap (coef p) (plus-suc n k)) (h k) } ;
 module SubtractTop (f : P) (n : Nat) (monic : Id R (coef f n) o)
  (f-bound : Bound (suc n) f) (p : P) (p-bound : Bound (suc n) p) {
  c : R = coef p n ;
  raw : P = addP p (L.negP (scal c f)) ;
  at-top : Id R (coef raw n) z =
   trans (coef-addP p (L.negP (scal c f)) n)
    (trans (ap (add c) (L.neg-coef (scal c f) n))
     (trans (ap (\ a -> add c (neg a))
       (trans (coef-scal c f n) (trans (ap (mul c) monic) (mulO c))))
      (addN c))) ;
  bound : Bound n raw =
   lower-bound n raw
    (add-bound (suc n) p (L.negP (scal c f)) p-bound
     (neg-bound (suc n) (scal c f) (scale-bound (suc n) c f f-bound))) at-top ;
  result : P = cut n raw ;
  equality : peq raw result = cut-equal n raw bound ;
 } ;
} ;
