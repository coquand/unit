-- Connect the record-independent fraction argument to worker B's module interface.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module NF = NatFin[l] ; module A7 = Alg73[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
to-plus : (d k : Nat) -> Id Base.Nat (NF.toN (plus d k)) (A7.plusN (NF.toN d) (NF.toN k)) = split {
 zero -> \ k -> refl (NF.toN k) ;
 suc d | ih -> \ k -> ap (\ n -> suc n) (ih k) } ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module B = Modules[l].Over[R,setR] ;
 module RA = A7.RA[B.ring] ;
 module Single (Md : B.Module) (w : B.WeaklyQC Md) {
  module Fr = B.Fractions[Md] ;
  module Point = Affine[l].Aff[B.ring,Top,\ t -> Md] ;
  Represent (g : R.R) (s : RA.unit g -> Md.M) : U l =
   (n : Nat) * (m : Md.M) * ((d : RA.unit g) -> Id Md.M (Fr.value g d m n) (s d)) ;
  represent (g : R.R) (s : RA.unit g -> Md.M) : Tr.Trunc[Represent g s].carrier =
   Tr.Trunc[Point.Rep (\ t -> g) (\ t d -> s d)].induction @l
    (\ z -> Tr.Trunc[Represent g s].carrier) (\ z -> Tr.Trunc[Represent g s].proposition)
    (\ a -> Tr.Trunc[Represent g s].inc
     (NF.fromN a.2.1,a.1 tt,\ d ->
      trans (ap (\ k -> Md.sm (RA.pw d.1 k) (a.1 tt)) (NF.to-from a.2.1)) (sym (a.2.2 tt d))))
    ((w (\ t -> g)).1 (\ t d -> s d)) ;
  Kill (g : R.R) (m : Md.M) : U l = (n : Nat) * Fr.Kills g m n ;
  kill (g : R.R) (m : Md.M) (vanish : RA.unit g -> Id Md.M m Md.mz) : Tr.Trunc[Kill g m].carrier =
   Tr.Trunc[Point.Kill (\ t -> g) (\ t -> m)].induction @l
    (\ z -> Tr.Trunc[Kill g m].carrier) (\ z -> Tr.Trunc[Kill g m].proposition)
    (\ a -> Tr.Trunc[Kill g m].inc
     (NF.fromN a.1,trans (ap (\ k -> Md.sm (RA.pw g k) m) (NF.to-from a.1)) (a.2 tt)))
    ((w (\ t -> g)).2 (\ t -> m) (\ t d -> vanish d)) ;
 } ;
 module At (Md : B.Module) (g : R.R) {
  module MA = A7.MA[B.ring,Md] ;
  module Pt = Affine[l].PtL[B.ring,Md] ;
  module Fr = B.Fractions[Md] ;
  module Act = Iterates[l].On[Md.M,Md.sm g] ;
  power : (n : Nat) (m : Md.M) -> Id Md.M (Act.power n m) (Md.sm (RA.pw g (NF.toN n)) m) = split {
   zero -> \ m -> sym (Md.smO m) ;
   suc n | ih -> \ m -> trans (ap (Md.sm g) (ih m)) (Md.smA g (RA.pw g (NF.toN n)) m) } ;
  twice (e k : Nat) (m : Md.M) :
   Id Md.M (Act.power (plus e k) m)
    (Md.sm (RA.pw g (NF.toN e)) (Md.sm (RA.pw g (NF.toN k)) m)) =
   trans (Act.power-add e k m)
    (trans (power e (Act.power k m)) (ap (Md.sm (RA.pw g (NF.toN e))) (power k m))) ;
  same-detect (k : Nat) (u v : Md.M)
   (same : Tr.Trunc[(e : Nat) * Fr.Same g u k v k e].carrier) :
   Tr.Trunc[(e : Nat) * Id Md.M (Act.power e u) (Act.power e v)].carrier =
   Tr.Trunc[(e : Nat) * Fr.Same g u k v k e].induction @l
    (\ z -> Tr.Trunc[(e : Nat) * Id Md.M (Act.power e u) (Act.power e v)].carrier)
    (\ z -> Tr.Trunc[(e : Nat) * Id Md.M (Act.power e u) (Act.power e v)].proposition)
    (\ a -> Tr.Trunc[(e : Nat) * Id Md.M (Act.power e u) (Act.power e v)].inc
     (plus a.1 k,trans (twice a.1 k u)
      (trans (MA.sub-zero _ _ (trans
       (sym (MA.sm-sub (RA.pw g (NF.toN a.1))
        (Md.sm (RA.pw g (NF.toN k)) u) (Md.sm (RA.pw g (NF.toN k)) v))) a.2))
       (sym (twice a.1 k v))))) same ;
  Target : U l = RA.unit g -> Md.M ;
  target-set : Pr.isSet Target = F.isSet-Pi (RA.unit g) (\ d -> Md.M) (\ d -> Md.setM) ;
  fraction (m : Md.M) (n : Nat) : Target = \ d -> Fr.value g d m n ;
  raise (d k : Nat) (m : Md.M) :
   Id Target (fraction (Act.power d m) (plus d k)) (fraction m k) =
   F.funext (RA.unit g) (\ u -> Md.M) _ _ (\ u ->
    trans (ap (Md.sm (RA.pw u.1 (NF.toN (plus d k)))) (power d m))
     (trans (ap (\ n -> Md.sm (RA.pw u.1 n) (Md.sm (RA.pw g (NF.toN d)) m)) (to-plus d k))
      (Pt.raise g u.1 u.2 (NF.toN d) (NF.toN k) m))) ;
  cancel (d : RA.unit g) (k : Nat) (m : Md.M) :
   Id Md.M (Md.sm (RA.pw g (NF.toN k)) (fraction m k d)) m =
   Pt.cancel-pw d.1 g (trans (R.mulC d.1 g) d.2) (NF.toN k) m ;
  on-unit (k : Nat) (u v : Md.M) (p : Id Target (fraction u k) (fraction v k)) (d : RA.unit g) :
   Id Md.M u v =
   trans (sym (cancel d k u))
    (trans (ap (Md.sm (RA.pw g (NF.toN k))) (ap (\ h -> h d) p)) (cancel d k v)) ;
  module QC (w : B.WeaklyQC Md) {
   module W = Single[Md,w] ;
   detect (k : Nat) (u v : Md.M) (p : Id Target (fraction u k) (fraction v k)) :
    Tr.Trunc[(e : Nat) * Id Md.M (Act.power e u) (Act.power e v)].carrier =
    Tr.Trunc[W.Kill g (MA.sub u v)].induction @l
     (\ z -> Tr.Trunc[(e : Nat) * Id Md.M (Act.power e u) (Act.power e v)].carrier)
     (\ z -> Tr.Trunc[(e : Nat) * Id Md.M (Act.power e u) (Act.power e v)].proposition)
     (\ a -> Tr.Trunc[(e : Nat) * Id Md.M (Act.power e u) (Act.power e v)].inc
      (a.1,trans (power a.1 u)
       (trans (MA.sub-zero _ _ (trans (sym (MA.sm-sub (RA.pw g (NF.toN a.1)) u v)) a.2))
        (sym (power a.1 v)))))
     (W.kill g (MA.sub u v) (\ d -> trans (ap (\ m -> MA.sub u m) (sym (on-unit k u v p d))) (MA.sub-self u))) ;
   represented (s : Target) :
    Tr.Trunc[(k : Nat) * (m : Md.M) * Id Target (fraction m k) s].carrier =
    Tr.Trunc[W.Represent g s].induction @l
     (\ z -> Tr.Trunc[(k : Nat) * (m : Md.M) * Id Target (fraction m k) s].carrier)
     (\ z -> Tr.Trunc[(k : Nat) * (m : Md.M) * Id Target (fraction m k) s].proposition)
     (\ a -> Tr.Trunc[(k : Nat) * (m : Md.M) * Id Target (fraction m k) s].inc
      (a.1,a.2.1,F.funext (RA.unit g) (\ d -> Md.M) _ s a.2.2))
     (W.represent g s) ;
  } ;
 } ;
} ;
