-- [p_H']^n = [p_P(V)^T][p_P(W)] (CHEAP-DESIGN.md, section 2, (ii)).  On
-- X = Spec Alg with gerbes G x, let V, W be twisted, V framed, Lambda of
-- weight n with a basis of rank 1 in every fibre, P(V)^v = power V Lambda n
-- (MULTILINEAR.Family.Dual), and q = p_H' the projector of frame data of the
-- descended H' = Hom(W, V) (DATUM.Left).  Write q^(x)k for the Kronecker
-- powers over Alg (q^(x)0 = 1_1, q^(x)(k+1) = q^(x)k (x) q).
--  (fibre)  At (x, g): Hom(W, V) = H'(x) = I q(x) (descend-fibre, FRAMEIMAGE
--     on the frame of the data at x), and by induction (HOMIMAGE.Step, base
--     HOMIMAGE.Powers.base)
--         Hom(power V Lambda k, power W Lambda k) = I (q^(x)k)(x),
--     using that evaluation at x is a ring map: (a (x) b)(x) = a(x) (x) b(x)
--     (PROJECTORMAP.Product) and 1_1(x) = 1_1.  So the module
--         M(x) = Hom(P(V)^v(x), P(W)^v(x))     (descended P(V)^v, P(W)^v)
--     is I (q^(x)n)(x) at every g : G x (descend-fibre twice).
--  (descent)  The right side does not depend on g, so M(x) = I (q^(x)n)(x)
--     (CONSTANTIDENTITY); by (KEY) (PRESENTEDCLASS) every projector
--     representing the sections of M has the class [q^(x)n] = [q]^n
--     (K0.class-product).
--  (product)  By (i) (HOMCLASS) the same sections are represented with class
--     [p_P(V)^T][p_P(W)].  Hence [q]^n = [p_P(V)^T][p_P(W)].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module HI = HomImage[l].Over[R,setR,axioms] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe)
  (n : Nat) (Lambda : TM.Family[C.Spec Alg,G].Weighted (\ a -> TM.UG.power a n)) {
  module DA = Datum[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  module PA = Projectors[l].Over[Alg.ring,Alg.set] ;
  module KA = K0[l].Over[Alg.ring,Alg.set] ;
  module PK = AffinePowers[l].Over[KA.K0] ;
  -- Kronecker powers over Alg, and their classes
  kronecker (q : PA.Projector) : Nat -> PA.Projector = split {
   zero -> PA.oneP ;
   suc k | p -> PA.Product[p,q].projector } ;
  class-power (q : PA.Projector) : (k : Nat) -> Id KA.K0.R (KA.class (kronecker q k)) (PK.power (KA.class q) k) = split {
   zero -> sym KA.class-one ;
   suc k | h -> trans (sym (KA.class-product (kronecker q k) q))
    (trans (ap (\ t -> KA.K0.mul t (KA.class q)) h) (KA.K0.mulC (PK.power (KA.class q) k) (KA.class q))) } ;
  -- values at x of a matrix over Alg
  at (x : DA.X) (k : Nat) (a : MnAlgebra[l].Over[Alg.ring,Alg.set,k].Mat) : Vectors[l].Over[R,setR,k].MR.Mat =
   \ i j -> x.1.1 (a i j) ;
  module Pair (V W : DA.Fam.TF.Twisted) (r : Nat) (fv : DA.Fam.Framed V.1 r)
   (bl : (x : DA.X) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier)
   (dH : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,DA.Fam.Hom[W,V].descended].Data) {
   module PV = ML.Family[DA.X,G].Dual[n,V,Lambda] ;
   module PW = ML.Family[DA.X,G].Dual[n,W,Lambda] ;
   module L = DA.Left[V,W,dH] ;
   Mx (x : DA.X) : MD.Module = HM.At[PV.descended x,PW.descended x].carrier ;
   target (x : DA.X) : MD.Module = MT.I (kronecker L.PH.projector n).size (at x (kronecker L.PH.projector n).size (kronecker L.PH.projector n).matrix) ;
   module Pt (x : DA.X) {
    module PM = ProjectorMap[l].Over[Alg.ring,R,Alg.set,setR,x.1] ;
    module FB = DA.Fibre[L.H'.descended,dH,x] ;
    module Fb (g : (G x).1) {
     -- (fibre)  Hom(W, V) = I q(x)
     hq : Id MD.Module HM.At[W.1 x g,V.1 x g].carrier (HI.image (PM.map L.PH.projector)) =
      Pr1.trans MD.Module HM.At[W.1 x g,V.1 x g].carrier (L.H'.descended x) (HI.image (PM.map L.PH.projector))
       (Pr1.sym MD.Module (L.H'.descended x) HM.At[W.1 x g,V.1 x g].carrier
        (Pr1.trans MD.Module (L.H'.descended x) (L.H'.H x g) HM.At[W.1 x g,V.1 x g].carrier
         (DA.Fam.TF.descend-fibre L.H'.weight-zero x g) (L.hom-fibre x g)))
       (Pr1.trans MD.Module (L.H'.descended x) (MT.I dH.size FB.FI.matrix) (HI.image (PM.map L.PH.projector))
        FB.FI.theorem
        (Pr1.ap FB.MN.MR.Mat MD.Module (MT.I dH.size) FB.FI.matrix (FB.MN.at x FB.FD.entry) FB.matrix)) ;
     power (P : MD.Module) (k : Nat) : MD.Module = ML.power P (Lambda.1 x g) k ;
     module M1 = MnAlgebra[l].Over[R,setR,suc zero] ;
     base-matrix : Id M1.Mat M1.mone (at x (suc zero) PA.oneP.matrix) =
      M1.mat-eq M1.mone (at x (suc zero) PA.oneP.matrix)
       (\ i j -> sym (MatrixMap[l].Over[Alg.ring,R,Alg.set,setR,x.1,suc zero].delta-map (suc zero) i j)) ;
     -- by definition, the image of the base change of a projector p
     image-map (p : PA.Projector) : Id MD.Module (MT.I p.size (at x p.size p.matrix)) (HI.image (PM.map p)) =
      refl (MT.I p.size (at x p.size p.matrix)) ;
     module St (k : Nat) (ih : Id MD.Module (HI.hom (power (V.1 x g) k) (power (W.1 x g) k))
       (MT.I (kronecker L.PH.projector k).size (at x (kronecker L.PH.projector k).size (kronecker L.PH.projector k).matrix))) {
      pk : PA.Projector = kronecker L.PH.projector k ;
      module KP = Kronecker[l].Over[R,setR,pk.size,L.PH.projector.size] ;
      module PP = PM.Product[pk,L.PH.projector] ;
      module S = HI.Step[V.1 x g,W.1 x g,power (V.1 x g) k,power (W.1 x g) k,r,fv x g,PM.map L.PH.projector,PM.map pk,hq,
       Pr1.trans MD.Module (HI.hom (power (V.1 x g) k) (power (W.1 x g) k)) (MT.I pk.size (at x pk.size pk.matrix)) (HI.image (PM.map pk))
        ih (image-map pk)] ;
      split-matrix : Id PP.MN.MY.Mat (at x (Pairing[l].times pk.size L.PH.projector.size) PA.Product[pk,L.PH.projector].projector.matrix)
       (KP.kron (at x pk.size pk.matrix) (at x L.PH.projector.size L.PH.projector.matrix)) = PP.matrix ;
      theorem : Id MD.Module (HI.hom (power (V.1 x g) (suc k)) (power (W.1 x g) (suc k)))
       (MT.I (Pairing[l].times pk.size L.PH.projector.size) (at x (Pairing[l].times pk.size L.PH.projector.size) PA.Product[pk,L.PH.projector].projector.matrix)) =
       Pr1.trans MD.Module (HI.hom (power (V.1 x g) (suc k)) (power (W.1 x g) (suc k)))
        (MT.I (Pairing[l].times pk.size L.PH.projector.size) (KP.kron (at x pk.size pk.matrix) (at x L.PH.projector.size L.PH.projector.matrix)))
        (MT.I (Pairing[l].times pk.size L.PH.projector.size) (at x (Pairing[l].times pk.size L.PH.projector.size) PA.Product[pk,L.PH.projector].projector.matrix))
        S.theorem
        (Pr1.ap PP.MN.MY.Mat MD.Module (MT.I (Pairing[l].times pk.size L.PH.projector.size))
         (KP.kron (at x pk.size pk.matrix) (at x L.PH.projector.size L.PH.projector.matrix))
         (at x (Pairing[l].times pk.size L.PH.projector.size) PA.Product[pk,L.PH.projector].projector.matrix)
         (sym split-matrix)) ;
     } ;
     power-at : (k : Nat) -> Id MD.Module (HI.hom (power (V.1 x g) k) (power (W.1 x g) k))
      (MT.I (kronecker L.PH.projector k).size (at x (kronecker L.PH.projector k).size (kronecker L.PH.projector k).matrix)) = split {
      zero -> Pr1.trans MD.Module (HI.hom (Lambda.1 x g) (Lambda.1 x g)) (HI.image HI.PJ.oneP) (MT.I (suc zero) (at x (suc zero) PA.oneP.matrix))
        HI.Powers[V.1 x g,W.1 x g,Lambda.1 x g,r,fv x g,PM.map L.PH.projector,hq,bl x g].base
        (Pr1.ap M1.Mat MD.Module (MT.I (suc zero)) M1.mone (at x (suc zero) PA.oneP.matrix) base-matrix) ;
      suc k | ih -> St[k,ih].theorem } ;
     -- M(x) = I (q^(x)n)(x), through g
     fibre : Id MD.Module (Mx x) (target x) =
      Pr1.trans MD.Module (Mx x) HM.At[PV.H x g,PW.descended x].carrier (target x)
       (Pr1.ap MD.Module MD.Module (\ M -> HM.At[M,PW.descended x].carrier) (PV.descended x) (PV.H x g)
        (DA.Fam.TF.descend-fibre PV.weight-zero x g))
       (Pr1.trans MD.Module HM.At[PV.H x g,PW.descended x].carrier HM.At[PV.H x g,PW.H x g].carrier (target x)
        (Pr1.ap MD.Module MD.Module (\ M -> HM.At[PV.H x g,M].carrier) (PW.descended x) (PW.H x g)
         (DA.Fam.TF.descend-fibre PW.weight-zero x g))
        (power-at n)) ;
    } ;
    -- (descent)
    identity : Id MD.Module (Mx x) (target x) =
     ConstantIdentity[l].Over[R,setR].At[(G x).1,TwistedFrames[l].Over[R,setR].Family[DA.X,G].point x,
      TM.GB.GL[G x].conn,Mx x,target x,\ g -> Fb[g].fibre].theorem ;
   } ;
   module PCM = PresentedClass[l].Over[R,setR,axioms].At[Alg,fp,Mx] ;
   module KEY = PCM.Key[kronecker L.PH.projector n,\ x -> Pt[x].identity] ;
   -- every representing projector of the sections of M has the class [q]^n
   theorem (p : PCM.FP.PJ.Projector) (rp : PCM.FP.Representation p) :
    Id KA.K0.R (KA.class p) (PK.power (KA.class L.PH.projector) n) =
    trans (KEY.theorem p rp) (class-power L.PH.projector n) ;
   -- (product)
   module Product (wP : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PV.descended].Data)
    (wQ : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PW.descended].Data) {
    module HC = HomClass[l].Over[R,setR,axioms].At[Alg,fp,PV.descended,PW.descended,wP,wQ] ;
    equation : Id KA.K0.R (PK.power (KA.class L.PH.projector) n) (KA.K0.mul (KA.class HC.transpose) (KA.class HC.DQ.projector)) =
     trans (sym (theorem HC.PR.FD.projector HC.PR.FD.representation)) (HC.theorem HC.PR.FD.projector HC.PR.FD.representation) ;
   } ;
  } ;
 } ;
} ;
