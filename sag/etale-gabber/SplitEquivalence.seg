-- The comparison G x -> Split(E x) is an equivalence (H^2 bridges, A5).
-- B a banded groupoid with V of weight 1, fibres merely free of rank n+1,
-- E the descended End (SPLITCOMPARISON).  Phi g = (V g, evaluation at g) is
-- a splitting of E.
--  (ap)     SPLITSIP.to-arrow (ap Phi p) = SPLITCOMPARISON.phi p (J; both are the
--           identity at refl).  So ap Phi = to-path . phi is an equivalence
--           (SPLITCOMPARISON.full, SPLITSIP): Phi is an embedding and its
--           fibres are propositions.
--  (onto)   If B is a sheaf (descent for objects) and close-inhabited, and the
--           splittings are close-connected with sheaf paths (SPLITGERBE), the
--           fibre of Phi over o is a sheaf (Sigma of sheaves) and locally
--           inhabited (g : B, then Phi g = o locally), hence inhabited.  So
--           Phi is an equivalence.
--  (band)   Phi preserves the bands: beta(ap Phi l) = sc^-1(phi l) = beta_g(l)
--           (SPLITCOMPARISON.loop, SPLITBAND).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SH = SheafLemmas[l,l+].Over[ET.I,ET.G] ;
 module SG = StackGerbes[l].Over[R,setR,axioms,sh] ;
 module At (B : TM.Banded) (V : B.1 -> MD.Module) (wv : TM.At[TM.charge (B)].Weight (\ a -> a) V) (n : Nat)
  (bases : (g : B.1) -> Tr.Trunc[LF.Basis[V g,suc n]].carrier) {
  module SC = SplitComparison[l].Over[R,setR,axioms].At[B,V,wv,n,bases] ;
  module SO = SplitObjects[l].Over[R,setR,axioms].At[suc n,SC.E.algebra] ;
  module SS = SplitSIP[l].Over[R,setR,axioms].At[suc n,SC.E.algebra] ;
  module SB = SplitBand[l].Over[R,setR,axioms].At[n,SC.E.algebra] ;
  Phi (g : B.1) : SO.Obj = (V g,bases g,SC.E.AtObject[g].evaluation) ;
  -- (ap)
  ap-phi (g g' : B.1) (p : Id B.1 g g') :
   Id (SC.Arrow g g') (SS.to-arrow (Phi g) (Phi g') (Hi.ap B.1 SO.Obj Phi g g' p)) (SC.phi g g' p) =
   idJ B.1 g (\ h q -> Id (SC.Arrow g h) (SS.to-arrow (Phi g) (Phi h) (Hi.ap B.1 SO.Obj Phi g h q)) (SC.phi g h q))
    (refl (SC.identity g)) g' p ;
  ap-to-path (g g' : B.1) (p : Id B.1 g g') :
   Id (Id SO.Obj (Phi g) (Phi g')) (Hi.ap B.1 SO.Obj Phi g g' p) (SS.to-path (Phi g) (Phi g') (SC.phi g g' p)) =
   Hi.trans (Id SO.Obj (Phi g) (Phi g')) _ (SS.to-path (Phi g) (Phi g') (SS.to-arrow (Phi g) (Phi g') (Hi.ap B.1 SO.Obj Phi g g' p))) _
    (Hi.sym (Id SO.Obj (Phi g) (Phi g')) _ _ (SS.Fd.sip-idToIso (Phi g) (Phi g') (Hi.ap B.1 SO.Obj Phi g g' p)))
    (Hi.ap (SO.Arrow (Phi g) (Phi g')) (Id SO.Obj (Phi g) (Phi g')) (SS.to-path (Phi g) (Phi g')) _ _ (ap-phi g g' p)) ;
  full (g g' : B.1) : Pr.isEquiv (Id B.1 g g') (SC.Arrow g g') (SC.phi g g') = SC.full g g' ;
  ap-equiv (g g' : B.1) : Hi.isEquiv (Id B.1 g g') (Id SO.Obj (Phi g) (Phi g')) (Hi.ap B.1 SO.Obj Phi g g') =
   Equivalences[l+].homotopy (Id B.1 g g') (Id SO.Obj (Phi g) (Phi g'))
    (Equivalences[l+].compose (Id B.1 g g') (SC.Arrow g g') (Id SO.Obj (Phi g) (Phi g'))
      (SC.phi g g',new Hi.IsEquiv[Id B.1 g g',SC.Arrow g g',SC.phi g g',sec := (full g g').sec,sec-eq := (full g g').sec-eq,
        ret := (full g g').ret,ret-eq := (full g g').ret-eq])
      (SS.to-path (Phi g) (Phi g'),Hi.qinv (SO.Arrow (Phi g) (Phi g')) (Id SO.Obj (Phi g) (Phi g')) (SS.to-path (Phi g) (Phi g'))
        (SS.to-arrow (Phi g) (Phi g')) (SS.Fd.sip-idToIso (Phi g) (Phi g')) (SS.Fd.idToIso-sip (Phi g) (Phi g'))))
    (Hi.ap B.1 SO.Obj Phi g g') (ap-to-path g g') ;
  Fib (o : SO.Obj) : U l+ = (g : B.1) * Id SO.Obj (Phi g) o ;
  fib-prop (o : SO.Obj) : Hi.isProp (Fib o) = Groupoid[l+].emb-fib-prop B.1 SO.Obj Phi ap-equiv o ;
  -- (band)
  band (g : B.1) (lp : Id B.1 g g) :
   Id TM.UG.Unit (SB.bnd (Phi g) (Hi.ap B.1 SO.Obj Phi g g lp)) (TM.At[TM.charge (B)].bnd g lp) =
   Hi.trans TM.UG.Unit _ ((SB.scalar-equiv (Phi g)).sec (SO.scalar (Phi g) (TM.At[TM.charge (B)].bnd g lp))) _
    (Hi.ap (SO.Arrow (Phi g) (Phi g)) TM.UG.Unit (SB.scalar-equiv (Phi g)).sec _ _
      (Hi.trans (SO.Arrow (Phi g) (Phi g)) _ (SC.phi g g lp) _ (ap-phi g g lp) (SC.loop g lp)))
    (Pr.sec-ret TM.UG.Unit (SO.Arrow (Phi g) (Phi g)) (SO.scalar (Phi g)) (SB.scalar-equiv (Phi g)) (TM.At[TM.charge (B)].bnd g lp)) ;
  #fails {
   -- Phi carries a loop to its band, not to the inverse of its band
   band-inverse (g : B.1) (lp : Id B.1 g g) :
    Id TM.UG.Unit (SB.bnd (Phi g) (Hi.ap B.1 SO.Obj Phi g g lp)) (TM.UG.inverse (TM.At[TM.charge (B)].bnd g lp)) = band g lp ;
  } ;
  -- (onto)
  module Onto (stk : ET.T.isModal @l B.1) (inh : sh.close B.1)
   (paths : (o o' : SO.Obj) -> ET.T.isModal @(l+) (Id SO.Obj o o')) {
   fib-sheaf (o : SO.Obj) : ET.T.isModal @(l+) (Fib o) =
    SH.modal-Sigma B.1 (\ g -> Id SO.Obj (Phi g) o) (SG.up B.1 stk) (\ g -> paths (Phi g) o) ;
   near (o : SO.Obj) (g : B.1) : Fib o =
    Tr.Trunc[SO.Arrow (Phi g) o].induction @(l+) (\ t -> Fib o) (\ t -> fib-prop o)
     (\ a -> (g,SS.to-path (Phi g) o a)) (SplitConnected[l].Over[R,setR,axioms].At[n,SC.E.algebra].connected (Phi g) o) ;
   fib (o : SO.Obj) : Fib o = sh.elim @(l+) B.1 (Fib o) (fib-prop o) (fib-sheaf o) (near o) inh ;
   equiv : Hi.isEquiv B.1 SO.Obj Phi =
    Hi.qinv B.1 SO.Obj Phi (\ o -> (fib o).1) (\ o -> (fib o).2)
     (\ g -> Hi.ap (Fib (Phi g)) B.1 (\ w -> w.1) (fib (Phi g)) (g,refl (Phi g)) (fib-prop (Phi g) (fib (Phi g)) (g,refl (Phi g)))) ;
   -- (small) the comparison into the small model, e = j^-1 . Phi
   module SM = SplitSmall[l].Over[R,setR,axioms].At[n,SC.E.algebra] ;
   e (g : B.1) : SM.Small = SM.inv (Phi g) ;
   inv-equiv : Hi.isEquiv SO.Obj SM.Small SM.inv = Hi.qinv SO.Obj SM.Small SM.inv SM.j SM.inv-j (\ o -> (SM.fib o).2) ;
   e-equiv : Hi.isEquiv B.1 SM.Small e = (Equivalences[l+].compose B.1 SO.Obj SM.Small (Phi,equiv) (SM.inv,inv-equiv)).2 ;
   equivalence : Pr.Equiv B.1 SM.Small =
    (e,new Pr.IsEquiv[B.1,SM.Small,e,sec := e-equiv.sec,sec-eq := e-equiv.sec-eq,ret := e-equiv.ret,ret-eq := e-equiv.ret-eq]) ;
   ap-comp (g g' : B.1) (p : Id B.1 g g') :
    Id (Id SO.Obj (SM.j (e g)) (SM.j (e g'))) (Hi.ap SM.Small SO.Obj SM.j (e g) (e g') (Pr.ap B.1 SM.Small e g g' p))
     (Hi.ap B.1 SO.Obj (\ h -> SM.j (e h)) g g' p) =
    idJ B.1 g (\ h q -> Id (Id SO.Obj (SM.j (e g)) (SM.j (e h))) (Hi.ap SM.Small SO.Obj SM.j (e g) (e h) (Pr.ap B.1 SM.Small e g h q))
      (Hi.ap B.1 SO.Obj (\ h2 -> SM.j (e h2)) g h q)) (refl (refl (SM.j (e g)))) g' p ;
   back : Id (B.1 -> SO.Obj) (\ h -> SM.j (e h)) Phi =
    Axioms[l+].FunExtLemmas[fe @(l+)].funext B.1 (\ h -> SO.Obj) (\ h -> SM.j (e h)) Phi (\ h -> (SM.fib (Phi h)).2) ;
   -- e preserves the bands: ap j (ap e l) = ap (j . e) l, j . e = Phi, then (band)
   preserves (g : B.1) (lp : Id B.1 g g) : Id TM.UG.Unit (SM.bnd (e g) (Pr.ap B.1 SM.Small e g g lp)) (TM.At[TM.charge (B)].bnd g lp) =
    Hi.trans TM.UG.Unit _ (SB.bnd (SM.j (e g)) (Hi.ap B.1 SO.Obj (\ h -> SM.j (e h)) g g lp)) _
     (Hi.ap (Id SO.Obj (SM.j (e g)) (SM.j (e g))) TM.UG.Unit (SB.bnd (SM.j (e g))) _ _ (ap-comp g g lp))
     (Hi.trans TM.UG.Unit _ (SB.bnd (Phi g) (Hi.ap B.1 SO.Obj Phi g g lp)) _
      (SG.homotopic B.1 SO.Obj SB.bnd (\ h -> SM.j (e h)) Phi back g lp) (band g lp)) ;
  } ;
 } ;
} ;
