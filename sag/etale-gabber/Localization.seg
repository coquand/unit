-- The finite presentation obtained by adjoining y with f*y=1.
-- The input includes an expression for f. The public wrapper below this
-- layer eliminates mere presentations/representatives only into propositions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (A : Algebras[l].Over[R,setR].Algebra)
 (p : Presentations[l].Over[R,setR].Presentation)
 (pa : Presentations[l].Over[R,setR].Presents p A)
 (f : A.ring.R) (e : Presentations[l].Over[R,setR].Expr (Fin p.1))
 (rep : Id A.ring.R (Presentations[l].Over[R,setR].eval (Fin p.1) A pa.1.1 e) f) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ; open P ;
 module X = AddVariable[l].Over[R,setR] ;
 module Eq = EquationExtension[l].Over[R,setR] ;
 V : U l = Fin p.1 ;
 W : U l = Fin (suc p.1) ;
 lift : Expr W = rename V W (\ v -> inl v) e ;
 relation : Expr W = sumE (mulE lift (var (inr tt))) (cst (R.neg R.o)) ;
 pres : Presentation = (suc p.1,cons relation (X.lift-equations V p.2)) ;
 module K = PresentationExistence[l].Over[R,setR,pres] ;
 algebra : C.Algebra = K.A.algebra ;
 fp : FP algebra = K.finitely-presented ;
 module To (B : C.Algebra) {
  module BR = AffineRing[l].Laws[B.ring,B.set] ;
  Data : U l = (h : C.Hom A B) * RL[B.ring].unit (h.1.1 f) ;
  data-ext (d d' : Data) (h : Id (C.Hom A B) d.1 d'.1) : Id Data d d' =
   Pr.Sigma-eq (C.Hom A B) (\ h -> RL[B.ring].unit (h.1.1 f)) d.1 d'.1 d.2 d'.2 h
    (BR.unit-prop (d'.1.1.1 f)) ;
  old (s : Solutions pres B) : Solutions p B =
   (\ v -> s.1 (inl v),X.zeros-down V B s.1 p.2 s.2.2) ;
  hom (s : Solutions pres B) : C.Hom A B = (pa.2 B).sec (old s) ;
  generators (s : Solutions pres B) : Id (V -> B.ring.R)
   (\ v -> (hom s).1.1 (pa.1.1 v)) (old s).1 =
   Pr.ap (Solutions p B) (V -> B.ring.R) (\ t -> t.1) _ _ ((pa.2 B).sec-eq (old s)) ;
  element (s : Solutions pres B) : Id B.ring.R ((hom s).1.1 f) (eval W B s.1 lift) =
   trans (ap (hom s).1.1 (sym rep))
    (trans (natural V A B (hom s) pa.1.1 e)
     (trans (Pr.ap (V -> B.ring.R) B.ring.R (\ a -> eval V B a e) _ _ (generators s))
      (sym (eval-rename V W (\ v -> inl v) B s.1 e)))) ;
  minus-one : Id B.ring.R (B.iota.1 (R.neg R.o)) (B.ring.neg B.ring.o) =
   trans (RingHom[l].negation R B.ring B.iota R.o) (ap B.ring.neg B.iota.2.1) ;
  forward (s : Solutions pres B) : Data =
   (hom s,(s.1 (inr tt),BR.difference-zero _ _
    (trans (cong2 B.ring.R B.ring.add _ _ _ _
      (ap (\ t -> B.ring.mul t (s.1 (inr tt))) (element s)) (sym minus-one)) s.2.1))) ;
  vals (d : Data) : W -> B.ring.R =
   snoc V B.ring.R (\ v -> d.1.1.1 (pa.1.1 v)) d.2.1 ;
  element-back (d : Data) : Id B.ring.R (eval W B (vals d) lift) (d.1.1.1 f) =
   trans (eval-rename V W (\ v -> inl v) B (vals d) e)
    (trans (sym (natural V A B d.1 pa.1.1 e)) (ap d.1.1.1 rep)) ;
  backward (d : Data) : Solutions pres B =
   (vals d,
    trans (cong2 B.ring.R B.ring.add _ _ _ _
     (trans (ap (\ t -> B.ring.mul t d.2.1) (element-back d)) d.2.2) minus-one) (B.ring.addN B.ring.o),
    X.zeros-up V B (vals d) p.2 (zeros-natural V A B d.1 pa.1.1 p.2 pa.1.2)) ;
  fb (d : Data) : Id Data (forward (backward d)) d =
   data-ext _ d
    (Equivalences[l].injective _ _ (canonical p A pa.1 B) (pa.2 B) _ _
     (solutions-ext p B _ _ (\ v ->
      Pr.ap (V -> B.ring.R) B.ring.R (\ a -> a v) _ _ (generators (backward d))))) ;
  eta (s : Solutions pres B) : (v : W) -> Id B.ring.R ((backward (forward s)).1 v) (s.1 v) = split {
   inl v -> Pr.ap (V -> B.ring.R) B.ring.R (\ a -> a v) _ _ (generators s) ;
   inr t -> ap (\ u -> s.1 (inr u)) (top-prop tt t) } ;
  bf (s : Solutions pres B) : Id (Solutions pres B) (backward (forward s)) s =
   solutions-ext pres B _ _ (eta s) ;
  solutions : Pr.Equiv (Solutions pres B) Data = (forward,Pr.qinv _ _ forward backward fb bf) ;
  equivalence : Pr.Equiv (C.Hom algebra B) Data =
   Equivalences[l].compose _ _ _ (K.To[B].forward,K.To[B].universal) solutions ;
 } ;
 inclusion : C.Hom A algebra = (To[algebra].forward K.A.solution).1 ;
 inverse : RL[algebra.ring].unit (inclusion.1.1 f) = (To[algebra].forward K.A.solution).2 ;
 module Canonical (B : C.Algebra) {
  module T = To[B] ;
  inclusion-gen (v : V) : Id algebra.ring.R (inclusion.1.1 (pa.1.1 v)) (K.A.generators (inl v)) =
   Pr.ap (V -> algebra.ring.R) algebra.ring.R (\ a -> a v) _ _ (To[algebra].generators K.A.solution) ;
  restriction (h : C.Hom algebra B) : Id (C.Hom A B) (T.equivalence.1 h).1 (C.compose A algebra B h inclusion) =
   Equivalences[l].injective _ _ (canonical p A pa.1 B) (pa.2 B) _ _
    (solutions-ext p B _ _ (\ v ->
     trans (Pr.ap (V -> B.ring.R) B.ring.R (\ a -> a v) _ _ (T.generators (K.To[B].forward h)))
      (sym (ap h.1.1 (inclusion-gen v))))) ;
  map (h : C.Hom algebra B) : T.Data =
   (C.compose A algebra B h inclusion,
    Pr.subst (C.Hom A B) (\ g -> RL[B.ring].unit (g.1.1 f)) _ _ (restriction h) (T.equivalence.1 h).2) ;
  universal : Pr.isEquiv (C.Hom algebra B) T.Data map =
   Equivalences[l].homotopy _ _ T.equivalence map (\ h -> T.data-ext _ _ (Pr.sym _ _ _ (restriction h))) ;
  equivalence : Pr.Equiv (C.Hom algebra B) T.Data = (map,universal) ;
 } ;
 spectrum : Pr.Equiv (C.Spec algebra) ((x : C.Spec A) * RL[R].unit (x.1.1 f)) =
  Canonical[C.base].equivalence ;
} ;
