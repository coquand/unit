-- SAG 2.2.3(a), derived from uniform SQC, and Example 3.1.4.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (sqc : Presentations[l].Over[R,setR].SQC) (one-nz : Not (Id R.R R.o R.z)) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Q = FiniteQuotient[l].Over[R,setR] ;
 module W = WeakNullstellensatz[l].Over[R,setR,sqc] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 one : Nat = suc zero ;
 module At (a : R.R) (nz : Not (Id R.R a R.z)) (q : Q.Witness C.base one (\ i -> a)) {
  inc : C.Hom C.base q.1 = q.2.2.1 ;
  empty (x : C.Spec q.1) : Empty =
   nz (trans (sym ((C.compose C.base q.1 C.base x inc).2 a))
    (trans (ap x.1.1 (q.2.2.2.1 (inr tt))) (RingHom[l].zero q.1.ring R x.1))) ;
  collapsed : Id q.1.ring.R q.1.ring.o q.1.ring.z = W.empty-collapse q.1 q.2.1 empty ;
  from-certificate (w : FiniteIdeal[l].Over[R,one,\ i -> a].Certificate R.o R.z) : RL[R].unit a =
   (w.1 (inr tt),sym (trans w.2
    (trans (RL[R].zl (RS.lin one (\ i -> a) w.1)) (R.addZ (R.mul a (w.1 (inr tt))))))) ;
  result : RL[R].unit a =
   Tr.Trunc[FiniteIdeal[l].Over[R,one,\ i -> a].Certificate R.o R.z].induction @l
    (\ t -> RL[R].unit a) (\ t -> RR.unit-prop a) from-certificate
    (QuotientCertificate[l].Over[R,setR].At[C.base,one,\ i -> a,q].kernel R.o
     (trans inc.1.2.1 collapsed)) ;
 } ;
 nonzero-unit (a : R.R) (nz : Not (Id R.R a R.z)) : RL[R].unit a =
  Tr1.Trunc[Q.Witness C.base one (\ i -> a)].induction @l
   (\ t -> RL[R].unit a) (\ t -> RR.unit-prop a) (\ q -> At[a,nz,q].result)
   (Q.quotient C.base BasePresentation[l].Over[R,setR].finitely-presented one (\ i -> a)) ;
 unit-nonzero (a : R.R) (u : RL[R].unit a) (h : Id R.R a R.z) : Empty =
  one-nz (trans (sym u.2) (trans (ap (\ t -> R.mul t u.1) h) (RL[R].zero-mul u.1))) ;
 difference (x a : R.R) : R.R = R.add x (R.neg a) ;
 difference-unit (x a : R.R) (neq : Not (Id R.R x a)) : RL[R].unit (difference x a) =
  nonzero-unit (difference x a) (\ h -> neq (RR.difference-zero x a h)) ;
 difference-distinct (x a : R.R) (u : RL[R].unit (difference x a)) (h : Id R.R x a) : Empty =
  unit-nonzero (difference x a) u (trans (ap (\ t -> R.add t (R.neg a)) h) (R.addN a)) ;
 product : (n : Nat) -> (Fin n -> R.R) -> R.R = split {
  zero -> \ v -> R.o ;
  suc n | ih -> \ v -> R.mul (v (inr tt)) (ih (\ i -> v (inl i))) } ;
 product-in : (n : Nat) (v : Fin n -> R.R) -> ((i : Fin n) -> RL[R].unit (v i)) -> RL[R].unit (product n v) = split {
  zero -> \ v u -> (R.o,R.mulO R.o) ;
  suc n | ih -> \ v u -> RR.unit-product (v (inr tt)) (product n (\ i -> v (inl i)))
   (u (inr tt)) (ih (\ i -> v (inl i)) (\ i -> u (inl i))) } ;
 product-out : (n : Nat) (v : Fin n -> R.R) -> RL[R].unit (product n v) -> (i : Fin n) -> RL[R].unit (v i) = split {
  zero -> \ v u -> AffineFinite[l].empty-section (\ i -> RL[R].unit (v i)) ;
  suc n | ih -> \ v u -> AffineFinite[l].section n (\ i -> RL[R].unit (v i))
   (ih (\ i -> v (inl i)) (RR.unit-right (v (inr tt)) (product n (\ i -> v (inl i))) u))
   (RR.unit-left (v (inr tt)) (product n (\ i -> v (inl i))) u) } ;
 example-3-1-4-forward (n : Nat) (as : Fin n -> R.R) (x : R.R)
  (u : RL[R].unit (product n (\ i -> difference x (as i)))) : (i : Fin n) -> Not (Id R.R x (as i)) =
  \ i -> difference-distinct x (as i) (product-out n (\ i -> difference x (as i)) u i) ;
 example-3-1-4-backward (n : Nat) (as : Fin n -> R.R) (x : R.R)
  (neq : (i : Fin n) -> Not (Id R.R x (as i))) : RL[R].unit (product n (\ i -> difference x (as i))) =
  product-in n (\ i -> difference x (as i)) (\ i -> difference-unit x (as i) (neq i)) ;
} ;
