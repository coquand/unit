-- Division by a monic polynomial, read on the ring A[X] itself.
-- Coefficients and degree bounds descend to A[X]; the decomposition
-- x = F*q + r with r of degree < deg F is unique, so q and r are A-linear.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
-- Rearrangements of decompositions f*s + b in any commutative ring.
module Decompose (C : CRing) {
 open C ; open RL[C] ;
 sum (f s s' b b' : R) :
  Id R (add (add (mul f s) b) (add (mul f s') b')) (add (mul f (add s s')) (add b b')) =
  trans (swap (mul f s) b (mul f s') b') (ap (\ x -> add x (add b b')) (sym (dist f s s'))) ;
 scale (a f s b : R) : Id R (mul a (add (mul f s) b)) (add (mul f (mul a s)) (mul a b)) =
  trans (dist a (mul f s) b) (ap (\ x -> add x (mul a b)) (mul-swap a f s)) ;
 multiple (f s : R) : Id R (mul f s) (add (mul f s) z) = sym (addZ (mul f s)) ;
 small (f b : R) : Id R b (add (mul f z) b) =
  sym (trans (ap (\ x -> add x b) (mul-zero f)) (zl b)) ;
 cancel (x b b' : R) (h : Id R (add x b) (add x b')) : Id R b b' = calc R {
  b
   =< sym (add-neg-cancel b x) > add (add b x) (neg x)
   =< ap (\ w -> add w (neg x)) (addC b x) > add (add x b) (neg x)
   =< ap (\ w -> add w (neg x)) h > add (add x b') (neg x)
   =< ap (\ w -> add w (neg x)) (addC x b') > add (add b' x) (neg x)
   =< add-neg-cancel b' x > b' } ;
 difference (f s s' b b' : R) (h : Id R (add (mul f s) b) (add (mul f s') b')) :
  Id R (mul f (add s (neg s'))) (add b' (neg b)) = calc R {
  mul f (add s (neg s'))
   =< dist f s (neg s') > add (mul f s) (mul f (neg s'))
   =< ap (add (mul f s)) (mul-neg f s') > add (mul f s) (neg (mul f s'))
   =< ap (\ x -> add x (neg (mul f s'))) (sym (add-neg-cancel (mul f s) b))
    > add (add (add (mul f s) b) (neg b)) (neg (mul f s'))
   =< ap (\ x -> add (add x (neg b)) (neg (mul f s'))) h
    > add (add (add (mul f s') b') (neg b)) (neg (mul f s'))
   =< ap (\ x -> add x (neg (mul f s'))) (sym (addA (mul f s') b' (neg b)))
    > add (add (mul f s') (add b' (neg b))) (neg (mul f s'))
   =< ap (\ x -> add x (neg (mul f s'))) (addC (mul f s') (add b' (neg b)))
    > add (add (add b' (neg b)) (mul f s')) (neg (mul f s'))
   =< add-neg-cancel (add b' (neg b)) (mul f s') > add b' (neg b) } ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 open A ;
 module P = Poly[l].PolyR[A] ;
 module M = Mul[l].MulR[A] ;
 module L = RawLaws[l].Laws[A] ;
 module RM = RawMultiplication[l].Laws[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module Dec = Decompose[B.ring] ;
 module Reg = Regularity[l].Over[B.ring] ;
 Coefficients : U l = Nat -> R ;
 module Coef = B.Q.Descend[Coefficients,FE.isSet-Pi Nat (\ k -> R) (\ k -> setA),P.coef,
  \ p q h -> FE.funext Nat (\ k -> R) (P.coef p) (P.coef q) h] ;
 coef (x : B.Carrier) (k : Nat) : R = Coef.map x k ;
 coef-include (p : P.P) (k : Nat) : Id R (coef (B.include p) k) (P.coef p k) =
  Pr.happly Nat (\ k -> R) (Coef.map (B.include p)) (P.coef p) (Coef.beta p) k ;
 CoefLaw (lhs rhs : B.Carrier -> Nat -> R) (x : B.Carrier) : U l =
  (k : Nat) -> Id R (lhs x k) (rhs x k) ;
 law-prop (lhs rhs : B.Carrier -> Nat -> R) (x : B.Carrier) : Pr.isProp (CoefLaw lhs rhs x) =
  FE.isProp-Pi Nat (\ k -> Id R (lhs x k) (rhs x k)) (\ k -> setA (lhs x k) (rhs x k)) ;
 law (lhs rhs : B.Carrier -> Nat -> R)
  (raw : (p : P.P) -> CoefLaw lhs rhs (B.include p)) : (x : B.Carrier) -> CoefLaw lhs rhs x =
  B.Q.induction @l (CoefLaw lhs rhs) (law-prop lhs rhs) raw ;
 coef-add : (x y : B.Carrier) (k : Nat) ->
  Id R (coef (B.addQ x y) k) (add (coef x k) (coef y k)) =
  B.forall2 (\ x y -> (k : Nat) -> Id R (coef (B.addQ x y) k) (add (coef x k) (coef y k)))
   (\ x y -> FE.isProp-Pi Nat (\ k -> Id R (coef (B.addQ x y) k) (add (coef x k) (coef y k)))
    (\ k -> setA _ _))
   (\ p q k -> trans (ap (\ w -> coef w k) (B.Add.beta p q))
    (trans (coef-include (M.addP p q) k)
     (trans (M.coef-addP p q k)
      (sym (cong2 R add _ _ _ _ (coef-include p k) (coef-include q k)))))) ;
 coef-scale (a : R) : (x : B.Carrier) (k : Nat) ->
  Id R (coef (B.mulQ (B.constant a) x) k) (mul a (coef x k)) =
  law (\ x k -> coef (B.mulQ (B.constant a) x) k) (\ x k -> mul a (coef x k))
   (\ p k -> trans (ap (\ w -> coef w k) (B.Multiply.beta (L.constantP a) p))
    (trans (coef-include (M.pmul (L.constantP a) p) k)
     (trans (RM.mul-single-left a p k)
      (trans (M.coef-scal a p k) (ap (mul a) (sym (coef-include p k))))))) ;
 coef-neg : (x : B.Carrier) (k : Nat) -> Id R (coef (B.negQ x) k) (neg (coef x k)) =
  law (\ x k -> coef (B.negQ x) k) (\ x k -> neg (coef x k))
   (\ p k -> trans (ap (\ w -> coef w k) (B.Negate.beta p))
    (trans (coef-include (L.negP p) k)
     (trans (L.neg-coef p k) (ap neg (sym (coef-include p k)))))) ;
 shifted (x : B.Carrier) : Nat -> R = split { zero -> z ; suc k -> coef x k } ;
 shift-coef (p : P.P) : (k : Nat) -> Id R (P.coef (L.shift p) k) (shifted (B.include p) k) = split {
  zero -> refl z ;
  suc k -> sym (coef-include p k) } ;
 coef-variable : (x : B.Carrier) (k : Nat) ->
  Id R (coef (B.mulQ B.variable x) k) (shifted x k) =
  law (\ x k -> coef (B.mulQ B.variable x) k) shifted
   (\ p k -> trans (ap (\ w -> coef w k) (B.Multiply.beta B.T p))
    (trans (coef-include (M.pmul B.T p) k)
     (trans (B.T-mul p k) (shift-coef p k)))) ;
 coef-zero (k : Nat) : Id R (coef B.zeroQ k) z = coef-include nil k ;
 -- Degree bounds on A[X]: all coefficients from d on vanish.
 Bounded (d : Nat) (x : B.Carrier) : U l = (k : Nat) -> Id R (coef x (plus d k)) z ;
 bounded-prop (d : Nat) (x : B.Carrier) : Pr.isProp (Bounded d x) =
  FE.isProp-Pi Nat (\ k -> Id R (coef x (plus d k)) z) (\ k -> setA _ _) ;
 bounded-zero (d : Nat) : Bounded d B.zeroQ = \ k -> coef-zero (plus d k) ;
 bounded-add (d : Nat) (x y : B.Carrier) (hx : Bounded d x) (hy : Bounded d y) :
  Bounded d (B.addQ x y) =
  \ k -> trans (coef-add x y (plus d k))
   (trans (cong2 R add _ _ _ _ (hx k) (hy k)) (addZ z)) ;
 bounded-scale (d : Nat) (a : R) (x : B.Carrier) (hx : Bounded d x) :
  Bounded d (B.mulQ (B.constant a) x) =
  \ k -> trans (coef-scale a x (plus d k)) (trans (ap (mul a) (hx k)) (RL[A].mul-zero a)) ;
 bounded-neg (d : Nat) (x : B.Carrier) (hx : Bounded d x) : Bounded d (B.negQ x) =
  \ k -> trans (coef-neg x (plus d k)) (trans (ap neg (hx k)) (RL[A].neg-zero)) ;
 module At (lower : List R) {
  F : B.Carrier = H.monic lower ;
  d : Nat = len lower ;
  module Div = MonicDivision[l].Over[A,setA].At[lower] ;
  module Small = MonicSmallMultiple[l].Over[A,setA].At[lower] ;
  leading : Id R (coef F d) o = trans (coef-include (H.monic-list lower) d) (H.leading lower) ;
  above (k : Nat) : Id R (coef F (plus (suc d) k)) z =
   trans (coef-include (H.monic-list lower) (plus (suc d) k)) (H.above lower k) ;
  SmallMultiple (w : B.Carrier) : U l =
   (s : B.Carrier) -> Bounded d w -> Id B.Carrier (B.mulQ F s) w -> Id B.Carrier s B.zeroQ ;
  small-multiple-at : (w : B.Carrier) -> SmallMultiple w =
   B.Q.induction @l SmallMultiple
    (\ w -> FE.isProp-Pi B.Carrier
     (\ s -> Bounded d w -> Id B.Carrier (B.mulQ F s) w -> Id B.Carrier s B.zeroQ)
     (\ s -> FE.isProp-Pi (Bounded d w) (\ h -> Id B.Carrier (B.mulQ F s) w -> Id B.Carrier s B.zeroQ)
      (\ h -> FE.isProp-Pi (Id B.Carrier (B.mulQ F s) w) (\ e -> Id B.Carrier s B.zeroQ)
       (\ e -> B.set s B.zeroQ))))
    (\ r s bound e ->
     Small.Bounded[r,\ k -> trans (sym (coef-include r (plus d k))) (bound k)].quotient-zero s e) ;
  -- Uniqueness of the decomposition x = F*s + b with b bounded.
  module Unique (s s' b b' : B.Carrier) (hb : Bounded d b) (hb' : Bounded d b')
   (e : Id B.Carrier (B.addQ (B.mulQ F s) b) (B.addQ (B.mulQ F s') b')) {
   quotient : Id B.Carrier s s' =
    Reg.difference s s'
     (small-multiple-at (B.addQ b' (B.negQ b)) (B.addQ s (B.negQ s'))
      (bounded-add d b' (B.negQ b) hb' (bounded-neg d b hb)) (Dec.difference F s s' b b' e)) ;
   remainder : Id B.Carrier b b' =
    Dec.cancel (B.mulQ F s) b b' (trans e (ap (\ t -> B.addQ (B.mulQ F t) b') (sym quotient))) ;
  } ;
  raw-quotient (p : P.P) : B.Carrier = B.include (Div.divide p).1 ;
  raw-remainder (p : P.P) : B.Carrier = B.include (Div.divide p).2.1 ;
  raw-bounded (p : P.P) : Bounded d (raw-remainder p) =
   \ k -> trans (coef-include (Div.divide p).2.1 (plus d k)) ((Div.divide p).2.2.1 k) ;
  raw-equation (p : P.P) :
   Id B.Carrier (B.include p) (B.addQ (B.mulQ F (raw-quotient p)) (raw-remainder p)) =
   (Div.divide p).2.2.2 ;
  module Same (p q : P.P) (h : P.peq p q) {
   e : Id B.Carrier (B.addQ (B.mulQ F (raw-quotient p)) (raw-remainder p))
    (B.addQ (B.mulQ F (raw-quotient q)) (raw-remainder q)) =
    trans (sym (raw-equation p)) (trans (B.Q.relates p q h) (raw-equation q)) ;
   module Un = Unique[raw-quotient p,raw-quotient q,raw-remainder p,raw-remainder q,
    raw-bounded p,raw-bounded q,e] ;
  } ;
  module Quo = B.Q.Descend[B.Carrier,B.set,raw-quotient,\ p q h -> Same[p,q,h].Un.quotient] ;
  module Rem = B.Q.Descend[B.Carrier,B.set,raw-remainder,\ p q h -> Same[p,q,h].Un.remainder] ;
  quotient (x : B.Carrier) : B.Carrier = Quo.map x ;
  remainder (x : B.Carrier) : B.Carrier = Rem.map x ;
  Decomposes (x : B.Carrier) : U l =
   Id B.Carrier x (B.addQ (B.mulQ F (quotient x)) (remainder x)) ;
  equation : (x : B.Carrier) -> Decomposes x =
   B.Q.induction @l Decomposes (\ x -> B.set _ _)
    (\ p -> trans (raw-equation p)
     (sym (cong2 B.Carrier B.addQ _ _ _ _ (ap (B.mulQ F) (Quo.beta p)) (Rem.beta p)))) ;
  bounded : (x : B.Carrier) -> Bounded d (remainder x) =
   B.Q.induction @l (\ x -> Bounded d (remainder x)) (\ x -> bounded-prop d (remainder x))
    (\ p -> Pr.subst B.Carrier (Bounded d) (raw-remainder p) (remainder (B.include p))
     (sym (Rem.beta p)) (raw-bounded p)) ;
  -- Any decomposition with a bounded remainder is the division.
  module Characterise (x s b : B.Carrier) (hb : Bounded d b)
   (e : Id B.Carrier x (B.addQ (B.mulQ F s) b)) {
   module Un = Unique[quotient x,s,remainder x,b,bounded x,hb,trans (sym (equation x)) e] ;
   quotient-is : Id B.Carrier (quotient x) s = Un.quotient ;
   remainder-is : Id B.Carrier (remainder x) b = Un.remainder ;
  } ;
  module Sum (x y : B.Carrier) {
   module C = Characterise[B.addQ x y,B.addQ (quotient x) (quotient y),
    B.addQ (remainder x) (remainder y),
    bounded-add d (remainder x) (remainder y) (bounded x) (bounded y),
    trans (cong2 B.Carrier B.addQ _ _ _ _ (equation x) (equation y))
     (Dec.sum F (quotient x) (quotient y) (remainder x) (remainder y))] ;
  } ;
  quotient-add (x y : B.Carrier) :
   Id B.Carrier (quotient (B.addQ x y)) (B.addQ (quotient x) (quotient y)) = Sum[x,y].C.quotient-is ;
  remainder-add (x y : B.Carrier) :
   Id B.Carrier (remainder (B.addQ x y)) (B.addQ (remainder x) (remainder y)) = Sum[x,y].C.remainder-is ;
  module Scale (a : R) (x : B.Carrier) {
   module C = Characterise[B.mulQ (B.constant a) x,B.mulQ (B.constant a) (quotient x),
    B.mulQ (B.constant a) (remainder x),bounded-scale d a (remainder x) (bounded x),
    trans (ap (B.mulQ (B.constant a)) (equation x))
     (Dec.scale (B.constant a) F (quotient x) (remainder x))] ;
  } ;
  quotient-scale (a : R) (x : B.Carrier) :
   Id B.Carrier (quotient (B.mulQ (B.constant a) x)) (B.mulQ (B.constant a) (quotient x)) =
   Scale[a,x].C.quotient-is ;
  remainder-scale (a : R) (x : B.Carrier) :
   Id B.Carrier (remainder (B.mulQ (B.constant a) x)) (B.mulQ (B.constant a) (remainder x)) =
   Scale[a,x].C.remainder-is ;
  module Multiple (s : B.Carrier) {
   module C = Characterise[B.mulQ F s,s,B.zeroQ,bounded-zero d,Dec.multiple F s] ;
  } ;
  quotient-multiple (s : B.Carrier) : Id B.Carrier (quotient (B.mulQ F s)) s =
   Multiple[s].C.quotient-is ;
  remainder-multiple (s : B.Carrier) : Id B.Carrier (remainder (B.mulQ F s)) B.zeroQ =
   Multiple[s].C.remainder-is ;
  remainder-small (b : B.Carrier) (hb : Bounded d b) : Id B.Carrier (remainder b) b =
   Characterise[b,B.zeroQ,b,hb,Dec.small F b].remainder-is ;
 } ;
} ;
