-- Finite polynomial-equation syntax, solutions, and canonical universal properties.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
Fin : Nat -> U l = split { zero -> Empty ; suc n | r -> Plus r Top } ;
snoc (V B : U l) (a : V -> B) (b : B) : Plus V Top -> B = split {
 inl v -> a v ; inr t -> b } ;
cong2 (B : U l) (op : B -> B -> B) (a a1 b b1 : B)
 (h : Id B a a1) (k : Id B b b1) : Id B (op a b) (op a1 b1) =
 Pr.trans B (op a b) (op a1 b) (op a1 b1)
  (Pr.ap B B (\ x -> op x b) a a1 h) (Pr.ap B B (op a1) b b1 k) ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 data Expr (V : U l) : U l =
  var (v : V) | cst (r : R.R) | sumE (p q : Expr V) | mulE (p q : Expr V) ;
 rename (V W : U l) (u : V -> W) : Expr V -> Expr W = split {
  var v -> var (u v) ; cst r -> cst r ;
  sumE p q | rp rq -> sumE rp rq ; mulE p q | rp rq -> mulE rp rq } ;
 eval (V : U l) (B : C.Algebra) (a : V -> B.ring.R) : Expr V -> B.ring.R = split {
  var v -> a v ; cst r -> B.iota.1 r ;
  sumE p q | rp rq -> B.ring.add rp rq ; mulE p q | rp rq -> B.ring.mul rp rq } ;
 natural (V : U l) (A B : C.Algebra) (h : C.Hom A B) (a : V -> A.ring.R) :
  (e : Expr V) -> Id B.ring.R (h.1.1 (eval V A a e)) (eval V B (\ v -> h.1.1 (a v)) e) = split {
  var v -> refl (h.1.1 (a v)) ; cst r -> h.2 r ;
  sumE p q | rp rq -> trans (h.1.2.2.1 (eval V A a p) (eval V A a q))
   (cong2 B.ring.R B.ring.add _ _ _ _ rp rq) ;
  mulE p q | rp rq -> trans (h.1.2.2.2 (eval V A a p) (eval V A a q))
   (cong2 B.ring.R B.ring.mul _ _ _ _ rp rq) } ;
 eval-rename (V W : U l) (u : V -> W) (B : C.Algebra) (b : W -> B.ring.R) :
  (e : Expr V) -> Id B.ring.R (eval W B b (rename V W u e)) (eval V B (\ v -> b (u v)) e) = split {
  var v -> refl (b (u v)) ; cst r -> refl (B.iota.1 r) ;
  sumE p q | rp rq -> cong2 B.ring.R B.ring.add _ _ _ _ rp rq ;
  mulE p q | rp rq -> cong2 B.ring.R B.ring.mul _ _ _ _ rp rq } ;
 Equations (V : U l) : U l = List (Expr V) ;
 Zeros (V : U l) (B : C.Algebra) (a : V -> B.ring.R) : Equations V -> U l = split {
  nil -> Top ; cons e es | r -> Id B.ring.R (eval V B a e) B.ring.z * r } ;
 top-prop : Pr.isProp Top = split { tt -> split { tt -> refl tt } } ;
 zeros-prop (V : U l) (B : C.Algebra) (a : V -> B.ring.R) :
  (es : Equations V) -> Pr.isProp (Zeros V B a es) = split {
  nil -> top-prop ; cons e es | r -> Pr.isProp-Sigma _ (\ h -> Zeros V B a es) (B.set _ _) (\ h -> r) } ;
 zeros-natural (V : U l) (A B : C.Algebra) (h : C.Hom A B) (a : V -> A.ring.R) :
  (es : Equations V) -> Zeros V A a es -> Zeros V B (\ v -> h.1.1 (a v)) es = split {
  nil -> \ z -> tt ; cons e es | r -> \ z ->
   (trans (sym (natural V A B h a e)) (trans (ap h.1.1 z.1) (RingHom[l].zero A.ring B.ring h.1)),r z.2) } ;
 Presentation : U l = (n : Nat) * Equations (Fin n) ;
 Solutions (P : Presentation) (B : C.Algebra) : U l =
  (a : Fin P.1 -> B.ring.R) * Zeros (Fin P.1) B a P.2 ;
 solutions-ext (P : Presentation) (B : C.Algebra) (a b : Solutions P B)
  (h : (v : Fin P.1) -> Id B.ring.R (a.1 v) (b.1 v)) : Id (Solutions P B) a b =
  Pr.Sigma-eq _ (\ a -> Zeros (Fin P.1) B a P.2) a.1 b.1 a.2 b.2
   (F.funext (Fin P.1) (\ v -> B.ring.R) a.1 b.1 h) (zeros-prop (Fin P.1) B b.1 P.2) ;
 canonical (P : Presentation) (A : C.Algebra) (a : Solutions P A) (B : C.Algebra)
  (h : C.Hom A B) : Solutions P B =
  (\ v -> h.1.1 (a.1 v),zeros-natural (Fin P.1) A B h a.1 P.2 a.2) ;
 Presents (P : Presentation) (A : C.Algebra) : U l+ =
  (a : Solutions P A) * ((B : C.Algebra) -> Pr.isEquiv (C.Hom A B) (Solutions P B) (canonical P A a B)) ;
 Witness (A : C.Algebra) : U l+ = (P : Presentation) * Presents P A ;
 FP (A : C.Algebra) : U l+ = Truncation[l+].Trunc[Witness A].carrier ;
 SQC : U l+ = (A : C.Algebra) -> FP A ->
  Pr.isEquiv A.ring.R (C.Spec A -> R.R) (C.evaluation A) ;
} ;
