-- (K1) and (K2) of SEVB-INFORMAL.md, Section 2, over a local ring.
--
-- (K1) If sum_i lam_i v_i = 1 then merely some v_i is a unit (Loc).
-- (K2) A square matrix with a left inverse is invertible: L M = 1 gives
--      M L = 1.  By induction on the size n+1.  The column c of M at the
--      last index t satisfies sum_k L_tk c_k = 1, so by Loc c_t is a unit
--      or some c_k is; in the second case adding a multiple of row k to
--      row t (E) makes the corner a unit.  Then F (scale row t, clear the
--      column) gives P M with last column e_t, for a P with P' P = 1.
--      Replacing L, M by L P', P M does not change the claim (transfer).
--      When the last column of M is e_t, the blocks of L M = 1 give
--      B A = 1 for the upper-left blocks, so A B = 1 by induction, and the
--      blocks of M L are then 1.
-- No determinants and no permutations.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module L = RL[R] ;
 module S = FiniteIdeal[l].Sums[R] ;
 module D = MnSums[l].Over[R] ;
 module LocL = StandardOpens[l].Over[R,setR].Local[loc] ;
 top-case (Z : Top -> U l) (x : Z tt) : (u : Top) -> Z u = split { tt -> x } ;
 cong2-R {a a1 b b1 : R.R} (p : Id R.R a a1) (q : Id R.R b b1) : Id R.R (R.add a b) (R.add a1 b1) =
  cong2 R.R R.add a a1 b b1 p q ;
 zeros (n : Nat) (v : Fin n -> R.R) (h : (i : Fin n) -> Id R.R (v i) R.z) : Id R.R (S.sum n v) R.z =
  trans (S.sum-cong n v (\ i -> R.z) h) (S.sum-zero n) ;
 unit-right (x y : R.R) (u : L.unit (R.mul x y)) : L.unit y =
  (R.mul x u.1,trans (L.mul-swap y x u.1) (trans (R.mulA x y u.1) u.2)) ;
 unit-one (x : R.R) (p : Id R.R x R.o) : L.unit x = (R.o,trans (ap (\ y -> R.mul y R.o) p) (R.mulO R.o)) ;
 -- q p = 1 from p q = 1
 inv-l (p : R.R) (u : L.unit p) : Id R.R (R.mul u.1 p) R.o = trans (R.mulC u.1 p) u.2 ;
 tmap (X Y : U l) (f : X -> Y) : Tr.Trunc[X].carrier -> Tr.Trunc[Y].carrier =
  Tr.Trunc[X].induction @l (\ w -> Tr.Trunc[Y].carrier) (\ w -> Tr.Trunc[Y].proposition) (\ x -> Tr.Trunc[Y].inc (f x)) ;

 -- (K1)
 pivot (n : Nat) (lam v : Fin n -> R.R) (h : Id R.R (S.sum n (\ i -> R.mul (lam i) (v i))) R.o) :
  Tr.Trunc[(i : Fin n) * L.unit (v i)].carrier =
  tmap ((i : Fin n) * L.unit (R.mul (lam i) (v i))) ((i : Fin n) * L.unit (v i))
   (\ w -> (w.1,unit-right (lam w.1) (v w.1) w.2))
   (LocL.finite-unit n (\ i -> R.mul (lam i) (v i)) (unit-one (S.sum n (\ i -> R.mul (lam i) (v i))) h)) ;

 -- (K2)
 Claim (n : Nat) : U l =
  (Lm Mm : MnAlgebra[l].Over[R,setR,n].Mat) ->
  Id (MnAlgebra[l].Over[R,setR,n].Mat) (MnAlgebra[l].Over[R,setR,n].mmul Lm Mm) (MnAlgebra[l].Over[R,setR,n].mone) ->
  Id (MnAlgebra[l].Over[R,setR,n].Mat) (MnAlgebra[l].Over[R,setR,n].mmul Mm Lm) (MnAlgebra[l].Over[R,setR,n].mone) ;

 -- the claim is invariant under L, M |-> L P', P M when P' P = 1
 module Transfer (n : Nat) {
  module Ms = MnAlgebra[l].Over[R,setR,n] ;
  forward (Lm Mm P P' : Ms.Mat) (h : Id Ms.Mat (Ms.mmul Lm Mm) Ms.mone) (pp : Id Ms.Mat (Ms.mmul P' P) Ms.mone) :
   Id Ms.Mat (Ms.mmul (Ms.mmul Lm P') (Ms.mmul P Mm)) Ms.mone =
   calc Ms.Mat {
    Ms.mmul (Ms.mmul Lm P') (Ms.mmul P Mm)
     =< sym (Ms.m-mulA Lm P' (Ms.mmul P Mm)) > Ms.mmul Lm (Ms.mmul P' (Ms.mmul P Mm))
     =< ap (Ms.mmul Lm) (Ms.m-mulA P' P Mm) > Ms.mmul Lm (Ms.mmul (Ms.mmul P' P) Mm)
     =< ap (\ X -> Ms.mmul Lm (Ms.mmul X Mm)) pp > Ms.mmul Lm (Ms.mmul Ms.mone Mm)
     =< ap (Ms.mmul Lm) (Ms.m-one-left Mm) > Ms.mmul Lm Mm
     =< h > Ms.mone } ;
  back (Lm Mm P P' : Ms.Mat) (pp : Id Ms.Mat (Ms.mmul P' P) Ms.mone)
   (c : Id Ms.Mat (Ms.mmul (Ms.mmul P Mm) (Ms.mmul Lm P')) Ms.mone) :
   Id Ms.Mat (Ms.mmul Mm Lm) Ms.mone =
   calc Ms.Mat {
    Ms.mmul Mm Lm
     =< ap (\ X -> Ms.mmul X Lm) (sym (Ms.m-one-left Mm)) > Ms.mmul (Ms.mmul Ms.mone Mm) Lm
     =< ap (\ X -> Ms.mmul (Ms.mmul X Mm) Lm) (sym pp) > Ms.mmul (Ms.mmul (Ms.mmul P' P) Mm) Lm
     =< ap (\ X -> Ms.mmul X Lm) (sym (Ms.m-mulA P' P Mm)) > Ms.mmul (Ms.mmul P' (Ms.mmul P Mm)) Lm
     =< sym (Ms.m-mulA P' (Ms.mmul P Mm) Lm) > Ms.mmul P' (Ms.mmul (Ms.mmul P Mm) Lm)
     =< ap (Ms.mmul P') (sym (Ms.m-one-right (Ms.mmul (Ms.mmul P Mm) Lm))) >
        Ms.mmul P' (Ms.mmul (Ms.mmul (Ms.mmul P Mm) Lm) Ms.mone)
     =< ap (\ X -> Ms.mmul P' (Ms.mmul (Ms.mmul (Ms.mmul P Mm) Lm) X)) (sym pp) >
        Ms.mmul P' (Ms.mmul (Ms.mmul (Ms.mmul P Mm) Lm) (Ms.mmul P' P))
     =< ap (Ms.mmul P') (Ms.m-mulA (Ms.mmul (Ms.mmul P Mm) Lm) P' P) >
        Ms.mmul P' (Ms.mmul (Ms.mmul (Ms.mmul (Ms.mmul P Mm) Lm) P') P)
     =< ap (\ X -> Ms.mmul P' (Ms.mmul X P)) (sym (Ms.m-mulA (Ms.mmul P Mm) Lm P')) >
        Ms.mmul P' (Ms.mmul (Ms.mmul (Ms.mmul P Mm) (Ms.mmul Lm P')) P)
     =< ap (\ X -> Ms.mmul P' (Ms.mmul X P)) c > Ms.mmul P' (Ms.mmul Ms.mone P)
     =< ap (Ms.mmul P') (Ms.m-one-left P) > Ms.mmul P' P
     =< pp > Ms.mone } ;
 } ;

 module Step (n : Nat) (ih : Claim n) {
  module Mn = MnAlgebra[l].Over[R,setR,n] ;
  module Ms = MnAlgebra[l].Over[R,setR,suc n] ;
  module T = Transfer[suc n] ;
  top : Fin (suc n) = inr tt ;

  -- the last column of M is e_t
  module Normal (Lm Mm : Ms.Mat)
   (col : (i : Fin (suc n)) -> Id R.R (Mm i top) (D.delta (suc n) i top))
   (h : Id Ms.Mat (Ms.mmul Lm Mm) Ms.mone) {
   hij (i j : Fin (suc n)) : Id R.R (Ms.mmul Lm Mm i j) (D.delta (suc n) i j) = ap (\ X -> X i j) h ;
   A : Mn.Mat = \ a b -> Mm (inl a) (inl b) ;
   B : Mn.Mat = \ a b -> Lm (inl a) (inl b) ;
   r (b : Fin n) : R.R = Mm top (inl b) ;
   s (a : Fin n) : R.R = Lm (inl a) top ;
   t (b : Fin n) : R.R = Lm top (inl b) ;
   d : R.R = Lm top top ;
   c1 : Id R.R (Mm top top) R.o = col top ;
   rowtop (i : Fin (suc n)) : Id R.R (Ms.mmul Lm Mm i top) (Lm i top) =
    trans (cong2-R (trans (ap (R.mul (Lm i top)) c1) (R.mulO (Lm i top)))
      (zeros n (\ k -> R.mul (Lm i (inl k)) (Mm (inl k) top))
       (\ k -> trans (ap (R.mul (Lm i (inl k))) (col (inl k))) (L.mul-zero (Lm i (inl k))))))
     (R.addZ (Lm i top)) ;
   s0 (a : Fin n) : Id R.R (s a) R.z = trans (sym (rowtop (inl a))) (hij (inl a) top) ;
   d1 : Id R.R d R.o = trans (sym (rowtop top)) (hij top top) ;
   BA : Id Mn.Mat (Mn.mmul B A) Mn.mone = Mn.mat-eq (Mn.mmul B A) Mn.mone (\ a b ->
    trans (sym (L.zl (Mn.mmul B A a b)))
     (trans (ap (\ y -> R.add y (Mn.mmul B A a b)) (sym (trans (ap (\ x -> R.mul x (r b)) (s0 a)) (L.zero-mul (r b)))))
      (hij (inl a) (inl b)))) ;
   AB : Id Mn.Mat (Mn.mmul A B) Mn.mone = ih B A BA ;
   -- t A = - r
   Tm : Mn.Mat = \ i m -> t m ;
   tA (k : Fin n) : R.R = S.sum n (\ m -> R.mul (t m) (A m k)) ;
   rneg (k : Fin n) : Id R.R (r k) (R.neg (tA k)) =
    L.neg-uniq (tA k) (r k) (trans (R.addC (tA k) (r k))
     (trans (ap (\ y -> R.add y (tA k)) (sym (trans (ap (\ x -> R.mul x (r k)) d1) (L.one-left (r k)))))
      (hij top (inl k)))) ;
   rB (b : Fin n) : Id R.R (S.sum n (\ k -> R.mul (r k) (B k b))) (R.neg (t b)) =
    calc R.R {
     S.sum n (\ k -> R.mul (r k) (B k b))
      =< S.sum-cong n _ (\ k -> R.mul (B k b) (R.neg (tA k)))
          (\ k -> trans (ap (\ x -> R.mul x (B k b)) (rneg k)) (R.mulC (R.neg (tA k)) (B k b))) >
     S.sum n (\ k -> R.mul (B k b) (R.neg (tA k)))
      =< S.lin-neg n (\ k -> B k b) tA >
     R.neg (S.sum n (\ k -> R.mul (B k b) (tA k)))
      =< ap R.neg (S.sum-cong n _ (\ k -> R.mul (tA k) (B k b)) (\ k -> R.mulC (B k b) (tA k))) >
     R.neg (Mn.mmul (Mn.mmul Tm A) B b b)
      =< ap R.neg (sym (Mn.mmulA-at Tm A B b b)) >
     R.neg (Mn.mmul Tm (Mn.mmul A B) b b)
      =< ap (\ X -> R.neg (Mn.mmul Tm X b b)) AB >
     R.neg (S.sum n (\ m -> R.mul (t m) (D.delta n m b)))
      =< ap R.neg (D.sum-delta-right n b t) >
     R.neg (t b) } ;
   -- the four blocks of M L
   e-ll (a b : Fin n) : Id R.R (Ms.mmul Mm Lm (inl a) (inl b)) (D.delta n a b) =
    trans (cong2-R (trans (ap (\ x -> R.mul x (t b)) (col (inl a))) (L.zero-mul (t b))) (ap (\ X -> X a b) AB))
     (L.zl (D.delta n a b)) ;
   e-lt (a : Fin n) : Id R.R (Ms.mmul Mm Lm (inl a) top) R.z =
    trans (cong2-R (trans (ap (\ x -> R.mul x d) (col (inl a))) (L.zero-mul d))
      (zeros n (\ k -> R.mul (A a k) (s k)) (\ k -> trans (ap (R.mul (A a k)) (s0 k)) (L.mul-zero (A a k)))))
     (R.addZ R.z) ;
   e-tt : Id R.R (Ms.mmul Mm Lm top top) R.o =
    trans (cong2-R (trans (ap (\ x -> R.mul x d) c1) (trans (L.one-left d) d1))
      (zeros n (\ k -> R.mul (r k) (s k)) (\ k -> trans (ap (R.mul (r k)) (s0 k)) (L.mul-zero (r k)))))
     (R.addZ R.o) ;
   e-tl (b : Fin n) : Id R.R (Ms.mmul Mm Lm top (inl b)) R.z =
    trans (cong2-R (trans (ap (\ x -> R.mul x (t b)) c1) (L.one-left (t b))) (rB b)) (R.addN (t b)) ;
   entries : (i j : Fin (suc n)) -> Id R.R (Ms.mmul Mm Lm i j) (D.delta (suc n) i j) = split {
    inl a -> split {
     inl b -> e-ll a b ;
     inr u -> top-case (\ u1 -> Id R.R (Ms.mmul Mm Lm (inl a) (inr u1)) R.z) (e-lt a) u } ;
    inr u -> split {
     inl b -> top-case (\ u1 -> Id R.R (Ms.mmul Mm Lm (inr u1) (inl b)) R.z) (e-tl b) u ;
     inr u' -> top-case (\ u1 -> (u2 : Top) -> Id R.R (Ms.mmul Mm Lm (inr u1) (inr u2)) R.o)
       (top-case (\ u2 -> Id R.R (Ms.mmul Mm Lm top (inr u2)) R.o) e-tt) u u' } } ;
   ML : Id Ms.Mat (Ms.mmul Mm Lm) Ms.mone = Ms.mat-eq (Ms.mmul Mm Lm) Ms.mone entries ;
  } ;

  -- the corner of M is a unit p: F clears the last column
  module Clear (Lm Mm : Ms.Mat) (h : Id Ms.Mat (Ms.mmul Lm Mm) Ms.mone) (u : L.unit (Mm top top)) {
   p : R.R = Mm top top ;
   q : R.R = u.1 ;
   c (a : Fin n) : R.R = Mm (inl a) top ;
   F : Ms.Mat = split {
    inl a -> split { inl b -> D.delta n a b ; inr w -> R.neg (R.mul (c a) q) } ;
    inr w -> split { inl b -> R.z ; inr w' -> q } } ;
   F' : Ms.Mat = split {
    inl a -> split { inl b -> D.delta n a b ; inr w -> c a } ;
    inr w -> split { inl b -> R.z ; inr w' -> p } } ;
   qp : Id R.R (R.mul q p) R.o = inv-l p u ;
   cqp (a : Fin n) : Id R.R (R.mul (R.mul (c a) q) p) (c a) =
    trans (sym (R.mulA (c a) q p)) (trans (ap (R.mul (c a)) qp) (R.mulO (c a))) ;
   col-l (a : Fin n) : Id R.R (Ms.mmul F Mm (inl a) top) R.z =
    trans (cong2-R (trans (L.neg-mul-left (R.mul (c a) q) p) (ap R.neg (cqp a))) (D.sum-delta n a c))
     (L.neg-cancel (c a)) ;
   col-t : Id R.R (Ms.mmul F Mm top top) R.o =
    trans (cong2-R qp (zeros n (\ k -> R.mul R.z (c k)) (\ k -> L.zero-mul (c k)))) (R.addZ R.o) ;
   col : (i : Fin (suc n)) -> Id R.R (Ms.mmul F Mm i top) (D.delta (suc n) i top) = split {
    inl a -> col-l a ;
    inr w -> top-case (\ w1 -> Id R.R (Ms.mmul F Mm (inr w1) top) R.o) col-t w } ;
   pp-ll (a b : Fin n) : Id R.R (Ms.mmul F' F (inl a) (inl b)) (D.delta n a b) =
    trans (cong2-R (L.mul-zero (c a)) (D.sum-delta n a (\ k -> D.delta n k b))) (L.zl (D.delta n a b)) ;
   pp-lt (a : Fin n) : Id R.R (Ms.mmul F' F (inl a) top) R.z =
    trans (ap (R.add (R.mul (c a) q)) (D.sum-delta n a (\ k -> R.neg (R.mul (c k) q)))) (R.addN (R.mul (c a) q)) ;
   pp-tl (b : Fin n) : Id R.R (Ms.mmul F' F top (inl b)) R.z =
    trans (cong2-R (L.mul-zero p) (zeros n (\ k -> R.mul R.z (D.delta n k b)) (\ k -> L.zero-mul (D.delta n k b))))
     (R.addZ R.z) ;
   pp-tt : Id R.R (Ms.mmul F' F top top) R.o =
    trans (cong2-R u.2 (zeros n (\ k -> R.mul R.z (R.neg (R.mul (c k) q))) (\ k -> L.zero-mul (R.neg (R.mul (c k) q)))))
     (R.addZ R.o) ;
   pp-entries : (i j : Fin (suc n)) -> Id R.R (Ms.mmul F' F i j) (D.delta (suc n) i j) = split {
    inl a -> split {
     inl b -> pp-ll a b ;
     inr w -> top-case (\ w1 -> Id R.R (Ms.mmul F' F (inl a) (inr w1)) R.z) (pp-lt a) w } ;
    inr w -> split {
     inl b -> top-case (\ w1 -> Id R.R (Ms.mmul F' F (inr w1) (inl b)) R.z) (pp-tl b) w ;
     inr w' -> top-case (\ w1 -> (w2 : Top) -> Id R.R (Ms.mmul F' F (inr w1) (inr w2)) R.o)
       (top-case (\ w2 -> Id R.R (Ms.mmul F' F top (inr w2)) R.o) pp-tt) w w' } } ;
   pp : Id Ms.Mat (Ms.mmul F' F) Ms.mone = Ms.mat-eq (Ms.mmul F' F) Ms.mone pp-entries ;
   ML : Id Ms.Mat (Ms.mmul Mm Lm) Ms.mone =
    T.back Lm Mm F F' pp
     (Normal[Ms.mmul Lm F',Ms.mmul F Mm,col,T.forward Lm Mm F F' h pp].ML) ;
  } ;

  -- some entry c_k (k < t) of the last column is a unit: E adds a c_k^-1 (1 - c_t) times row k to row t
  module Raise (Lm Mm : Ms.Mat) (h : Id Ms.Mat (Ms.mmul Lm Mm) Ms.mone) (k : Fin n) (u : L.unit (Mm (inl k) top)) {
   ct : R.R = Mm top top ;
   ck : R.R = Mm (inl k) top ;
   a : R.R = R.mul (R.add R.o (R.neg ct)) u.1 ;
   El (x : R.R) : Ms.Mat = split {
    inl i -> split { inl j -> D.delta n i j ; inr w -> R.z } ;
    inr w -> split { inl j -> R.mul x (D.delta n k j) ; inr w' -> R.o } } ;
   E : Ms.Mat = El a ;
   E' : Ms.Mat = El (R.neg a) ;
   -- sum_m (x delta_km) v_m = x v_k
   pick (x : R.R) (v : Fin n -> R.R) : Id R.R (S.sum n (\ m -> R.mul (R.mul x (D.delta n k m)) (v m))) (R.mul x (v k)) =
    trans (S.sum-cong n _ (\ m -> R.mul x (R.mul (D.delta n k m) (v m))) (\ m -> sym (R.mulA x (D.delta n k m) (v m))))
     (trans (S.sum-scale x n (\ m -> R.mul (D.delta n k m) (v m))) (ap (R.mul x) (D.sum-delta n k v))) ;
   corner : Id R.R (Ms.mmul E Mm top top) R.o =
    calc R.R {
     R.add (R.mul R.o ct) (S.sum n (\ m -> R.mul (R.mul a (D.delta n k m)) (Mm (inl m) top)))
      =< cong2-R (L.one-left ct) (pick a (\ m -> Mm (inl m) top)) >
     R.add ct (R.mul a ck)
      =< ap (R.add ct) (trans (sym (R.mulA (R.add R.o (R.neg ct)) u.1 ck))
          (trans (ap (R.mul (R.add R.o (R.neg ct))) (inv-l ck u)) (R.mulO (R.add R.o (R.neg ct))))) >
     R.add ct (R.add R.o (R.neg ct))
      =< L.add-swap ct R.o (R.neg ct) >
     R.add R.o (R.add ct (R.neg ct))
      =< ap (R.add R.o) (R.addN ct) >
     R.add R.o R.z
      =< R.addZ R.o >
     R.o } ;
   pp-ll (i j : Fin n) : Id R.R (Ms.mmul E' E (inl i) (inl j)) (D.delta n i j) =
    trans (cong2-R (L.zero-mul (R.mul a (D.delta n k j))) (D.sum-delta n i (\ m -> D.delta n m j))) (L.zl (D.delta n i j)) ;
   pp-lt (i : Fin n) : Id R.R (Ms.mmul E' E (inl i) top) R.z =
    trans (cong2-R (L.zero-mul R.o) (zeros n (\ m -> R.mul (D.delta n i m) R.z) (\ m -> L.mul-zero (D.delta n i m))))
     (R.addZ R.z) ;
   pp-tl (j : Fin n) : Id R.R (Ms.mmul E' E top (inl j)) R.z =
    calc R.R {
     R.add (R.mul R.o (R.mul a (D.delta n k j))) (S.sum n (\ m -> R.mul (R.mul (R.neg a) (D.delta n k m)) (D.delta n m j)))
      =< cong2-R (L.one-left (R.mul a (D.delta n k j))) (pick (R.neg a) (\ m -> D.delta n m j)) >
     R.add (R.mul a (D.delta n k j)) (R.mul (R.neg a) (D.delta n k j))
      =< sym (L.dist-left a (R.neg a) (D.delta n k j)) >
     R.mul (R.add a (R.neg a)) (D.delta n k j)
      =< ap (\ x -> R.mul x (D.delta n k j)) (R.addN a) >
     R.mul R.z (D.delta n k j)
      =< L.zero-mul (D.delta n k j) >
     R.z } ;
   pp-tt : Id R.R (Ms.mmul E' E top top) R.o =
    trans (cong2-R (R.mulO R.o) (zeros n (\ m -> R.mul (R.mul (R.neg a) (D.delta n k m)) R.z)
      (\ m -> L.mul-zero (R.mul (R.neg a) (D.delta n k m)))))
     (R.addZ R.o) ;
   pp-entries : (i j : Fin (suc n)) -> Id R.R (Ms.mmul E' E i j) (D.delta (suc n) i j) = split {
    inl i -> split {
     inl j -> pp-ll i j ;
     inr w -> top-case (\ w1 -> Id R.R (Ms.mmul E' E (inl i) (inr w1)) R.z) (pp-lt i) w } ;
    inr w -> split {
     inl j -> top-case (\ w1 -> Id R.R (Ms.mmul E' E (inr w1) (inl j)) R.z) (pp-tl j) w ;
     inr w' -> top-case (\ w1 -> (w2 : Top) -> Id R.R (Ms.mmul E' E (inr w1) (inr w2)) R.o)
       (top-case (\ w2 -> Id R.R (Ms.mmul E' E top (inr w2)) R.o) pp-tt) w w' } } ;
   pp : Id Ms.Mat (Ms.mmul E' E) Ms.mone = Ms.mat-eq (Ms.mmul E' E) Ms.mone pp-entries ;
   ML : Id Ms.Mat (Ms.mmul Mm Lm) Ms.mone =
    T.back Lm Mm E E' pp
     (Clear[Ms.mmul Lm E',Ms.mmul E Mm,T.forward Lm Mm E E' h pp,unit-one (Ms.mmul E Mm top top) corner].ML) ;
  } ;

  -- by Loc, the corner or some other entry of the last column is a unit
  module General (Lm Mm : Ms.Mat) (h : Id Ms.Mat (Ms.mmul Lm Mm) Ms.mone) {
   Goal : U l = Id Ms.Mat (Ms.mmul Mm Lm) Ms.mone ;
   goal-prop : Pr.isProp Goal = Ms.set-mat (Ms.mmul Mm Lm) Ms.mone ;
   x : R.R = R.mul (Lm top top) (Mm top top) ;
   y : R.R = S.sum n (\ k -> R.mul (Lm top (inl k)) (Mm (inl k) top)) ;
   rest (w : L.unit y) : Goal =
    Tr.Trunc[(k : Fin n) * L.unit (R.mul (Lm top (inl k)) (Mm (inl k) top))].induction @l (\ v -> Goal) (\ v -> goal-prop)
     (\ v -> Raise[Lm,Mm,h,v.1,unit-right (Lm top (inl v.1)) (Mm (inl v.1) top) v.2].ML)
     (LocL.finite-unit n (\ k -> R.mul (Lm top (inl k)) (Mm (inl k) top)) w) ;
   cases : Plus (L.unit x) (L.unit y) -> Goal = split {
    inl w -> Clear[Lm,Mm,h,unit-right (Lm top top) (Mm top top) w].ML ;
    inr w -> rest w } ;
   ML : Goal =
    Tr.Trunc[Plus (L.unit x) (L.unit y)].induction @l (\ v -> Goal) (\ v -> goal-prop) cases
     (loc.2 x y (unit-one (R.add x y) (ap (\ X -> X top top) h))) ;
  } ;
  claim : Claim (suc n) = \ Lm Mm h -> General[Lm,Mm,h].ML ;
 } ;

 k2 : (n : Nat) -> Claim n = split {
  zero -> \ Lm Mm h -> MnAlgebra[l].Over[R,setR,zero].mat-eq
   (MnAlgebra[l].Over[R,setR,zero].mmul Mm Lm) (MnAlgebra[l].Over[R,setR,zero].mone) (\ i j -> efq i) ;
  suc n | ih -> Step[n,ih].claim } ;
} ;
