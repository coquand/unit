-- Small proof trees for the congruence generated by ring laws and equations.
-- The validity predicate checks composition endpoints; no indexed data,
-- decision procedure for coefficient equality, or large semantic relation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (pres : Presentations[l].Over[R,setR].Presentation) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 V : U l = Presentations[l].Fin pres.1 ;
 Term : U l = P.Expr V ;
 zeroE : Term = cst R.z ;
 oneE : Term = cst R.o ;
 negative (p : Term) : Term = mulE (cst (R.neg R.o)) p ;
 Member (e : Term) : List Term -> U l = split {
  nil -> Empty ; cons p ps | r -> Plus (Id Term e p) r } ;
 data Tree : U l =
  reflD (p : Term) | symD (d : Tree) | transD (d e : Tree)
  | sumD (d e : Tree) | mulD (d e : Tree)
  | addAssoc (p q r : Term) | addComm (p q : Term) | addZero (p : Term) | addNeg (p : Term)
  | mulAssoc (p q r : Term) | mulComm (p q : Term) | mulOne (p : Term) | distrib (p q r : Term)
  | coeffAdd (a b : R.R) | coeffMul (a b : R.R)
  | equation (p : Term) (member : Member p pres.2) ;
 ends : Tree -> Term * Term = split {
  reflD p -> (p,p) ; symD d | r -> (r.2,r.1) ; transD d e | rd re -> (rd.1,re.2) ;
  sumD d e | rd re -> (sumE rd.1 re.1,sumE rd.2 re.2) ;
  mulD d e | rd re -> (mulE rd.1 re.1,mulE rd.2 re.2) ;
  addAssoc p q r -> (sumE p (sumE q r),sumE (sumE p q) r) ;
  addComm p q -> (sumE p q,sumE q p) ; addZero p -> (sumE p zeroE,p) ;
  addNeg p -> (sumE p (negative p),zeroE) ;
  mulAssoc p q r -> (mulE p (mulE q r),mulE (mulE p q) r) ;
  mulComm p q -> (mulE p q,mulE q p) ; mulOne p -> (mulE p oneE,p) ;
  distrib p q r -> (mulE p (sumE q r),sumE (mulE p q) (mulE p r)) ;
  coeffAdd a b -> (sumE (cst a) (cst b),cst (R.add a b)) ;
  coeffMul a b -> (mulE (cst a) (cst b),cst (R.mul a b)) ;
  equation p member -> (p,zeroE) } ;
 Valid : Tree -> U l = split {
  reflD p -> Top ; symD d | r -> r ;
  transD d e | rd re -> rd * re * Id Term (ends d).2 (ends e).1 ;
  sumD d e | rd re -> rd * re ; mulD d e | rd re -> rd * re ;
  addAssoc p q r -> Top ; addComm p q -> Top ; addZero p -> Top ; addNeg p -> Top ;
  mulAssoc p q r -> Top ; mulComm p q -> Top ; mulOne p -> Top ; distrib p q r -> Top ;
  coeffAdd a b -> Top ; coeffMul a b -> Top ; equation p member -> Top } ;
 Proof (p q : Term) : U l = (d : Tree) * Valid d * Id Term (ends d).1 p * Id Term (ends d).2 q ;
 Relation (p q : Term) : U l = Tr.Trunc[Proof p q].carrier ;
 proposition (p q : Term) : Pr.isProp (Relation p q) = Tr.Trunc[Proof p q].proposition ;
 witness (d : Tree) (v : Valid d) : Relation (ends d).1 (ends d).2 =
  Tr.Trunc[Proof (ends d).1 (ends d).2].inc (d,v,refl (ends d).1,refl (ends d).2) ;
 reflexive (p : Term) : Relation p p = witness (reflD p) tt ;
 reverse (p q : Term) (w : Proof p q) : Proof q p = (symD w.1,w.2.1,w.2.2.2,w.2.2.1) ;
 symmetric (p q : Term) : Relation p q -> Relation q p =
  Tr.Trunc[Proof p q].induction @l (\ t -> Relation q p) (\ t -> proposition q p)
   (\ w -> Tr.Trunc[Proof q p].inc (reverse p q w)) ;
 join (p q r : Term) (w : Proof p q) (v : Proof q r) : Proof p r =
  (transD w.1 v.1,(w.2.1,v.2.1,trans w.2.2.2 (sym v.2.2.1)),w.2.2.1,v.2.2.2) ;
 transitive (p q r : Term) (h : Relation p q) (k : Relation q r) : Relation p r =
  Tr.Trunc[Proof p q].induction @l (\ t -> Relation p r) (\ t -> proposition p r)
   (\ w -> Tr.Trunc[Proof q r].induction @l (\ t -> Relation p r) (\ t -> proposition p r)
    (\ v -> Tr.Trunc[Proof p r].inc (join p q r w v)) k) h ;
 module Congruence (op : Term -> Term -> Term) (node : Tree -> Tree -> Tree)
  (valid : (d e : Tree) -> Valid d -> Valid e -> Valid (node d e))
  (left : (d e : Tree) -> Id Term (ends (node d e)).1 (op (ends d).1 (ends e).1))
  (right : (d e : Tree) -> Id Term (ends (node d e)).2 (op (ends d).2 (ends e).2)) {
  combine (p p1 q q1 : Term) (w : Proof p p1) (v : Proof q q1) : Proof (op p q) (op p1 q1) =
   (node w.1 v.1,valid w.1 v.1 w.2.1 v.2.1,
    trans (left w.1 v.1) (Presentations[l].cong2 Term op _ _ _ _ w.2.2.1 v.2.2.1),
    trans (right w.1 v.1) (Presentations[l].cong2 Term op _ _ _ _ w.2.2.2 v.2.2.2)) ;
  respects (p p1 q q1 : Term) (h : Relation p p1) (k : Relation q q1) : Relation (op p q) (op p1 q1) =
   Tr.Trunc[Proof p p1].induction @l (\ t -> Relation (op p q) (op p1 q1)) (\ t -> proposition _ _)
    (\ w -> Tr.Trunc[Proof q q1].induction @l (\ t -> Relation (op p q) (op p1 q1)) (\ t -> proposition _ _)
     (\ v -> Tr.Trunc[Proof (op p q) (op p1 q1)].inc (combine p p1 q q1 w v)) k) h ;
 } ;
 module Add = Congruence[\ p q -> sumE p q,\ d e -> sumD d e,\ d e v w -> (v,w),
  \ d e -> refl (sumE (ends d).1 (ends e).1),\ d e -> refl (sumE (ends d).2 (ends e).2)] ;
 module Multiply = Congruence[\ p q -> mulE p q,\ d e -> mulD d e,\ d e v w -> (v,w),
  \ d e -> refl (mulE (ends d).1 (ends e).1),\ d e -> refl (mulE (ends d).2 (ends e).2)] ;
} ;
