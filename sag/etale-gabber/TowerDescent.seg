-- Descent along towers into a sheaf proposition (ETALECLOSURE, elim).
-- Q a proposition (at any level k) and a sheaf.  For a tower t over Y,
--     ((z : Points t) -> Q) -> Y -> Q.
-- Proof by induction on the shape.  nil: the points are Y.  A stage
-- (c, t'): by induction a map Next Y c -> Q, i.e. at each y a map
-- Root (d, c y) -> Q; it factors through G (d, c y) = ||Root (d, c y)||
-- (Q a proposition), and Q is a sheaf for the generator G (d, c y).
level l k ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module TW = Towers[l].Over[R,setR] ;
 module At (Q : U k) (pQ : Prelude[k].isProp Q) (mQ : ET.T.isModal @k Q) {
  -- one stage
  stage (i : ET.I) (h : ET.Root i -> Q) : Q = (mQ i).sec (Tr.Trunc[ET.Root i].induction @k (\ t -> Q) (\ t -> pQ) h) ;
  descend : (s : Towers[l].Shape) (Y : U l) (t : TW.Tower s Y) -> ((z : TW.Points s Y t) -> Q) -> Y -> Q = split {
   nil -> \ Y t h -> h ;
   cons d s | r -> \ Y t h y -> stage (d,t.1 y) (\ x -> r (TW.Next d Y t.1) t.2 h (y,x)) } ;
 } ;
} ;
