-- Pointwise solutions of a linear equation on an affine scheme have a
-- merely global solution, when source and target are weakly QC.
-- The fibres are torsors under the weakly QC kernel (SAG 7.3.6).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module A7 = Alg73[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module PQ = DescentPointQC[l].Over[MD.ring] ;
 module At (P Q : MD.Module) (f : SM.Linear P Q) (wP : MD.WeaklyQC P) (wQ : MD.WeaklyQC Q) {
  module L = SM.Lin[P,Q,f] ;
  module MP = A7.MA[MD.ring,P] ; module MQ = A7.MA[MD.ring,Q] ;
  module Ker = SM.Kernel[P,Q,f] ; module KS = SM.Sub[P,Ker.sub] ;
  wK : MD.WeaklyQC KS.carrier = PQ.At[KS.carrier].to-aff
   DescentKernel[l].Over[MD.ring].At[P,Q,f,PQ.At[P].from-aff wP,PQ.At[Q].from-aff wQ].theorem ;
  sub-add (x y : P.M) : Id P.M (P.madd (MP.sub x y) y) x =
   trans (sym (P.maddA x (P.mneg y) y))
    (trans (ap (P.madd x) (trans (P.maddC (P.mneg y) y) (P.maddN y))) (P.maddZ x)) ;
  add-sub (k x y : P.M) (h : Id P.M (P.madd k y) x) : Id P.M k (MP.sub x y) =
   trans (sym (P.maddZ k))
    (trans (ap (P.madd k) (sym (P.maddN y)))
     (trans (P.maddA k y (P.mneg y)) (ap (\ t -> P.madd t (P.mneg y)) h))) ;
  module Solutions (X : U l) (aff : FunctionAlgebra[l].Over[R,setR].Affine X)
   (s : X -> Q.M) (inh : (x : X) -> Tr.Trunc[(v : P.M) * Id Q.M (f.1 v) (s x)].carrier) {
   Mx (x : X) : MD.Module = KS.carrier ;
   module Af = Affine[l].Aff[MD.ring,X,Mx] ;
   T (x : X) : U l = (v : P.M) * Id Q.M (f.1 v) (s x) ;
   equal (x : X) (t t' : T x) (h : Id P.M t.1 t'.1) : Id (T x) t t' =
    Pr.Sigma-eq P.M (\ v -> Id Q.M (f.1 v) (s x)) t.1 t'.1 t.2 t'.2 h (Q.setM _ _) ;
   set (x : X) : Pr.isSet (T x) =
    Pr.isSet-Sigma P.M (\ v -> Id Q.M (f.1 v) (s x)) P.setM (\ v -> Pr.prop-to-set _ (Q.setM _ _)) ;
   act (x : X) (k : KS.E) (t : T x) : T x =
    (P.madd k.1 t.1,trans (f.2.1 k.1 t.1)
     (trans (ap (\ y -> Q.madd y (f.1 t.1)) k.2) (trans (MQ.mzl (f.1 t.1)) t.2))) ;
   diff (x : X) (t t' : T x) : KS.E =
    (MP.sub t'.1 t.1,trans (L.map-sub t'.1 t.1)
     (trans (ap (\ y -> MQ.sub y (f.1 t.1)) (trans t'.2 (sym t.2))) (MQ.sub-self (f.1 t.1)))) ;
   Moves (x : X) (t t' : T x) : U l = (k : KS.E) * Id (T x) (act x k t) t' ;
   centre (x : X) (t t' : T x) : Moves x t t' = (diff x t t',equal x _ _ (sub-add t'.1 t.1)) ;
   contract (x : X) (t t' : T x) (z : Moves x t t') : Id (Moves x t t') (centre x t t') z =
    Pr.Sigma-eq KS.E (\ k -> Id (T x) (act x k t) t') _ _ _ _
     (KS.eq _ _ (sym (add-sub z.1.1 t'.1 t.1 (ap (\ v -> v.1) z.2)))) (set x _ _) ;
   structure (x : X) : Torsor[l].TorBase[Af.ab x].TorStr (T x) =
    (act x,set x,
     \ a b t -> equal x _ _ (sym (P.maddA a.1 b.1 t.1)),
     \ t -> equal x _ _ (MP.mzl t.1),
     \ t t' -> (centre x t t',contract x t t'),inh x) ;
   restriction : MD.Restriction X Mx =
    Restriction718[l].Over[R,setR,axioms].At[X,
     SchemeBasics[l].Over[R,setR].affine X aff,Mx,\ x -> wK].theorem-7-1-8 ;
   theorem : Tr.Trunc[(x : X) -> T x].carrier =
    DescentTheorem736[l].Over[R,setR,axioms].Torsors[X,Mx,restriction,T,structure].affine aff ;
   opaque theorem ;
  } ;
 } ;
} ;
