-- gabber-recollement.tex, Lemma 3.6(1), at the level of modules.  In the
-- situation of DIAGONALPRODUCT, with moreover A -> A_a localising at a and
-- A -> A_b localising at b, let g, g' and h, h' be inverse M x M matrices
-- over C.  Then, for the glued modules (GLUEDMODULE),
--     P_g + P_h ~ P_gh + A^M        (merely, as A-modules).
--
-- Proof.  diag(g, h) = beta diag(gh, 1) alpha for some inverse pairs beta
-- over A_b and alpha over A_a (DIAGONALPRODUCT).  Then
--     P_g + P_h ~ P_{diag(g,h)}          (GLUEDSUMS)
--               ~ P_{diag(gh,1)}         (GLUEDMODULE, invariance)
--               ~ P_gh + P_1             (GLUEDSUMS)
--               ~ P_gh + A^M             (GLUEDFREE).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module SM = SerreModule[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (M : Nat) {
 module D = DiagonalProduct[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,la,lb,comaximal,M] ;
 module GS = GluedSums[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,M] ;
 module GF = GluedFree[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,M] ;
 module G1 = GS.G1 ;
 module G2 = GS.G2 ;
 module MI = G1.MI ;
 module Lemma (g g' : D.MC.Mat) (gi : D.IM.Inverse[g,g']) (h h' : D.MC.Mat) (hi : D.IM.Inverse[h,h']) {
  module DL = D.Lemma[g,g',gi,h,h',hi] ;
  module Sgh = GS.Diagonal[g,h] ;
  module S1 = GS.Diagonal[D.MC.mmul g h,G1.MC.mone] ;
  module Pgh = G1.Glue[D.MC.mmul g h] ;
  Source : SM.Over[A].Module = Sgh.S.product ;
  Target : SM.Over[A].Module = SP.Pair[A,Pgh.glued,GF.free].product ;
  -- P_gh + P_1 ~ P_gh + A^M
  free-part : MI.Iso[S1.S.product,Target] =
   MI.Sum[Pgh.glued,Pgh.glued,GF.P1.glued,GF.free,MI.identity Pgh.glued,MI.inverse GF.free GF.P1.glued GF.iso].sum ;
  chain (r : DL.Result) : MI.Iso[Source,Target] =
   MI.compose Source Sgh.PD.glued Target (MI.inverse Sgh.PD.glued Source Sgh.iso)
    (MI.compose Sgh.PD.glued S1.PD.glued Target
     (G2.Invariance[DL.G,D.W.diag g h,r.1,r.2.1,r.2.2.1,r.2.2.2.1,r.2.2.2.2.1,r.2.2.2.2.2.1,r.2.2.2.2.2.2].iso)
     (MI.compose S1.PD.glued S1.S.product Target S1.iso free-part)) ;
  theorem : Tr.Trunc[MI.Iso[Source,Target]].carrier = TC.map DL.Result (MI.Iso[Source,Target]) chain DL.theorem ;
 } ;
} ;
