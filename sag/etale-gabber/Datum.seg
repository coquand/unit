-- The datum of CHEAP-DESIGN.md (section 1) as an identity of families.
-- X = Spec Alg (Alg f.p.), G x an R^x-gerbe at each x, V, W twisted
-- families (TWISTEDMODULES), W framed of rank s (TWISTEDFRAMES).  Put
--     H' = Hom(W, V),   E = End V        (weight 0, descended to X),
--     Z  = Hom(Hom(W, V), V)             (a family over the G x),
-- and take global frame data of the descended H' and E (FRAMEPROJECTOR,
-- given merely by AFFINEFRAMEDATA), with projectors p_H', p_E over Alg.
-- For a matrix e over Alg and a family U, U [x] e is the family
-- (x, g) |-> U x g [x] e(x) (MATRIXTENSOR), e(x) the matrix of values at x.
--  (fibre)  Frame data (s_k, d_k) restrict at x to a frame of Mx x, whose
--     matrix d_i(s_j x) is p(x) (back-beta); so Hom(Mx x, U) = U [x] p(x)
--     (FRAMEIMAGE, C1).  The dual frame (d_k, evaluation at s_k) has matrix
--     d_j(s_i x) = p(x)^T, so Hom((Mx x)*, U) = U [x] p(x)^T.
--  (left)   Z x g = Hom(H' x g, V x g) = Hom(H'(x), V x g)   (descend-fibre)
--                 = V x g [x] p_H'(x)                         (fibre).
--  (right)  Z x g = Hom(End(V x g)*, W x g)   (COMPARISON, C2: W x g merely
--                 has a frame; End(V x g) has the frame of E(x), carried
--                 along descend-fibre)
--                 = Hom(E(x)*, W x g) = W x g [x] p_E(x)^T     (fibre).
-- The identities at each (x, g) give identities of families (pointwise):
--     V [x] p_H'  =  Z  =  W [x] p_E^T.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module TFr = TwistedFrames[l].Over[R,setR] ;
 -- frames move along identities of modules
 carry (M N : MD.Module) (h : Id MD.Module M N) (r : Nat) (fr : FR.Frame[M,r]) : FR.Frame[N,r] =
  idJ MD.Module M (\ N' q -> FR.Frame[N',r]) fr N h ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TFr.TM.GB.AGerbe) {
  X : U l = C.Spec Alg ;
  module Fam = TFr.Family[X,G] ;
  module FS = MS.Families[X,\ x -> (G x).1] ;
  -- a matrix over Alg, its values at x, its transpose
  module Mats (n : Nat) {
   module MA = MnAlgebra[l].Over[Alg.ring,Alg.set,n] ;
   module MR = Vectors[l].Over[R,setR,n].MR ;
   at (x : X) (e : MA.Mat) : MR.Mat = \ i j -> x.1.1 (e i j) ;
   transpose (e : MA.Mat) : MA.Mat = \ i j -> e j i ;
  } ;
  -- U [x] e as a family
  tensor (U1 : FS.Fam) (n : Nat) (e : Mats[n].MA.Mat) : FS.Fam = \ x g -> MT.tensor (U1 x g) n (Mats[n].at x e) ;
  -- (fibre)
  module Fibre (Mx : X -> MD.Module) (w : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Mx].Data) (x : X) {
   module FD = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Mx].From[w] ;
   module MN = Mats[w.size] ;
   frame : FR.Frame[Mx x,w.size] = new FR.Frame[Mx x,w.size,\ k -> w.section k x,\ k -> w.form k x,w.law x] ;
   module FI = FrameImage[l].Over[R,setR].At[Mx x,w.size,frame] ;
   module FJ = FrameImage[l].Over[R,setR].At[FR.dual (Mx x),w.size,FR.Of[Mx x,w.size,frame].dual-frame] ;
   matrix : Id MN.MR.Mat FI.matrix (MN.at x FD.entry) =
    MN.MR.mat-eq _ _ (\ i j -> sym (FD.beta i j x)) ;
   dual-matrix : Id MN.MR.Mat FJ.matrix (MN.at x (MN.transpose FD.entry)) =
    MN.MR.mat-eq _ _ (\ i j -> sym (FD.beta j i x)) ;
   on-matrix (U1 : MD.Module) (a b : MN.MR.Mat) (h : Id MN.MR.Mat a b) :
    Id MD.Module (MT.tensor U1 w.size a) (MT.tensor U1 w.size b) =
    Pr1.ap MN.MR.Mat MD.Module (MT.tensor U1 w.size) a b h ;
   hom (U1 : MD.Module) : Id MD.Module HM.At[Mx x,U1].carrier (MT.tensor U1 w.size (MN.at x FD.entry)) =
    Pr1.trans MD.Module HM.At[Mx x,U1].carrier (MT.tensor U1 w.size FI.matrix) (MT.tensor U1 w.size (MN.at x FD.entry))
     (FI.hom U1) (on-matrix U1 FI.matrix (MN.at x FD.entry) matrix) ;
   dual-hom (U1 : MD.Module) :
    Id MD.Module HM.At[FR.dual (Mx x),U1].carrier (MT.tensor U1 w.size (MN.at x (MN.transpose FD.entry))) =
    Pr1.trans MD.Module HM.At[FR.dual (Mx x),U1].carrier (MT.tensor U1 w.size FJ.matrix)
     (MT.tensor U1 w.size (MN.at x (MN.transpose FD.entry)))
     (FJ.hom U1) (on-matrix U1 FJ.matrix (MN.at x (MN.transpose FD.entry)) dual-matrix) ;
  } ;
  -- Z = Hom(Hom(W, V), V)
  Z (V W : Fam.TF.Twisted) : FS.Fam = \ x g -> HM.At[HM.At[W.1 x g,V.1 x g].carrier,V.1 x g].carrier ;
  -- (left)
  module Left (V W : Fam.TF.Twisted)
   (dH : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Fam.Hom[W,V].descended].Data) {
   module H' = Fam.Hom[W,V] ;
   module PH = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,H'.descended].From[dH] ;
   -- by definition, the fibres of Hom(W, V)
   hom-fibre (x : X) (g : (G x).1) : Id MD.Module (H'.H x g) HM.At[W.1 x g,V.1 x g].carrier =
    refl HM.At[W.1 x g,V.1 x g].carrier ;
   at (x : X) (g : (G x).1) : Id MD.Module (tensor V.1 dH.size PH.entry x g) (Z V W x g) =
    Pr1.trans MD.Module (tensor V.1 dH.size PH.entry x g) HM.At[H'.descended x,V.1 x g].carrier (Z V W x g)
     (Pr1.sym MD.Module HM.At[H'.descended x,V.1 x g].carrier (tensor V.1 dH.size PH.entry x g)
      (Fibre[H'.descended,dH,x].hom (V.1 x g)))
     (Pr1.ap MD.Module MD.Module (\ M -> HM.At[M,V.1 x g].carrier) (H'.descended x) HM.At[W.1 x g,V.1 x g].carrier
      (Pr1.trans MD.Module (H'.descended x) (H'.H x g) HM.At[W.1 x g,V.1 x g].carrier
       (Fam.TF.descend-fibre H'.weight-zero x g) (hom-fibre x g))) ;
   theorem : Id FS.Fam (tensor V.1 dH.size PH.entry) (Z V W) = FS.pointwise _ _ at ;
  } ;
  -- (right)
  module Right (V W : Fam.TF.Twisted) (s : Nat) (fw : Fam.Framed W.1 s)
   (dE : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Fam.Hom[V,V].descended].Data) {
   module E = Fam.Hom[V,V] ;
   module PE = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,E.descended].From[dE] ;
   -- by definition, the fibres of End V
   end-fibre (x : X) (g : (G x).1) : Id MD.Module (E.H x g) HM.At[V.1 x g,V.1 x g].carrier =
    refl HM.At[V.1 x g,V.1 x g].carrier ;
   module At (x : X) (g : (G x).1) {
    module FE = Fibre[E.descended,dE,x] ;
    fibre : Id MD.Module (E.descended x) HM.At[V.1 x g,V.1 x g].carrier =
     Pr1.trans MD.Module (E.descended x) (E.H x g) HM.At[V.1 x g,V.1 x g].carrier (Fam.TF.descend-fibre E.weight-zero x g) (end-fibre x g) ;
    module CM = Comparison[l].Over[R,setR].At[W.1 x g,V.1 x g,V.1 x g,dE.size,
     carry (E.descended x) HM.At[V.1 x g,V.1 x g].carrier fibre dE.size FE.frame] ;
    dual-hom (M : MD.Module) : MD.Module = HM.At[FR.dual M,W.1 x g].carrier ;
    theorem : Id MD.Module (Z V W x g) (tensor W.1 dE.size (FE.MN.transpose PE.entry) x g) =
     Pr1.trans MD.Module (Z V W x g) (dual-hom HM.At[V.1 x g,V.1 x g].carrier) (tensor W.1 dE.size (FE.MN.transpose PE.entry) x g)
      (Pr1.sym MD.Module (dual-hom HM.At[V.1 x g,V.1 x g].carrier) (Z V W x g) CM.Merely[s,fw x g].theorem)
      (Pr1.trans MD.Module (dual-hom HM.At[V.1 x g,V.1 x g].carrier) (dual-hom (E.descended x)) (tensor W.1 dE.size (FE.MN.transpose PE.entry) x g)
       (Pr1.ap MD.Module MD.Module dual-hom HM.At[V.1 x g,V.1 x g].carrier (E.descended x) (Pr1.sym MD.Module (E.descended x) HM.At[V.1 x g,V.1 x g].carrier fibre))
       (FE.dual-hom (W.1 x g))) ;
   } ;
   theorem : Id FS.Fam (Z V W) (tensor W.1 dE.size (Mats[dE.size].transpose PE.entry)) =
    FS.pointwise _ _ (\ x g -> At[x,g].theorem) ;
  } ;
  -- (datum)  V [x] p_H' = Z = W [x] p_E^T
  module Datum (V W : Fam.TF.Twisted) (s : Nat) (fw : Fam.Framed W.1 s)
   (dH : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Fam.Hom[W,V].descended].Data)
   (dE : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Fam.Hom[V,V].descended].Data) {
   module L = Left[V,W,dH] ;
   module RE = Right[V,W,s,fw,dE] ;
   theorem : Id FS.Fam (tensor V.1 dH.size L.PH.entry) (tensor W.1 dE.size (Mats[dE.size].transpose RE.PE.entry)) =
    Pr1.trans FS.Fam (tensor V.1 dH.size L.PH.entry) (Z V W) (tensor W.1 dE.size (Mats[dE.size].transpose RE.PE.entry))
     L.theorem RE.theorem ;
  } ;
 } ;
} ;
