-- A surjective square matrix is invertible (K2); its invertibility is open.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (loc : StandardOpens[l].Over[R,setR].Locality) {
 module LR = EtaleLinear[l].Over[R,setR] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module K = MatrixLeftInverse[l].Over[R,setR,loc] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module Rank (n : Nat) {
  module MN = MnAlgebra[l].Over[R,setR,n] ;
  V : U l = LR.Vector n ;
  action (a : MN.Mat) (v : V) : V = \ i -> RS.sum n (\ j -> R.mul (a i j) (v j)) ;
  action-mul (a b : MN.Mat) (v : V) : Id V (action a (action b v)) (action (MN.mmul a b) v) =
   F.funext (Fin n) (\ i -> R.R) _ _ (\ i ->
    ap (\ c -> c i i) (MN.m-mulA a b (\ k j -> v k))) ;
  action-one (v : V) : Id V (action MN.mone v) v =
   F.funext (Fin n) (\ i -> R.R) _ v (\ i -> MN.D.sum-delta n i v) ;
  module Matrix (w : LR.Matrix n n) (onto : LR.Surj n n w) {
   Choices : U l = (j : Fin n) -> LR.Witness n n w (\ i -> MN.D.delta n i j) ;
   module Chosen (c : Choices) {
    a : MN.Mat = \ i j -> w j i ;
    b : MN.Mat = \ i j -> (c j).1 i ;
    ab : Id MN.Mat (MN.mmul a b) MN.mone =
     MN.mat-eq (MN.mmul a b) MN.mone (\ i j -> (c j).2 i) ;
    ba : Id MN.Mat (MN.mmul b a) MN.mone = K.k2 n a b ab ;
    section (v : V) : Id V (action a (action b v)) v =
     trans (action-mul a b v) (trans (ap (\ z -> action z v) ab) (action-one v)) ;
    retraction (v : V) : Id V (action b (action a v)) v =
     trans (action-mul b a v) (trans (ap (\ z -> action z v) ba) (action-one v)) ;
    result : Pr.isEquiv V V (LR.apply n n w) =
     Pr.qinv V V (LR.apply n n w) (action b) section retraction ;
   } ;
   theorem : Pr.isEquiv V V (LR.apply n n w) =
    TC.rec Choices @l (Pr.isEquiv V V (LR.apply n n w))
     (Prop331Paths[l].isEquiv-prop V V (LR.apply n n w)) (\ c -> Chosen[c].result)
     (AffineFinite[l].choice n (\ j -> LR.Witness n n w (\ i -> MN.D.delta n i j))
      (\ j -> onto (\ i -> MN.D.delta n i j))) ;
   opaque theorem ;
  } ;
  module Point (k : Fin n) {
   module H = DL.Hom[DL.Free n,MD.regular,\ v -> v k,
    \ u v -> refl (R.add (u k) (v k)),\ r v -> refl (R.mul r (v k))] ;
  } ;
  coordinates (m : Nat) (w : Fin m -> V) (c : LR.Vector m) :
   Id V (DL.On[DL.Free n].lin m w c) (LR.apply m n w c) =
   F.funext (Fin n) (\ k -> R.R) _ _ (\ k ->
    trans (Point[k].H.lin m w c)
     (trans (DL.On[MD.regular].lin-value m (\ j -> w j k) c)
      (trans (DL.On[MD.regular].S.map (\ r -> r) (refl R.z) (\ r s -> refl (R.add r s))
        m (\ j -> R.mul (c j) (w j k)))
       (RS.sum-cong m (\ j -> R.mul (c j) (w j k)) (\ j -> R.mul (w j k) (c j))
        (\ j -> R.mulC (c j) (w j k)))))) ;
  module Basis (w : Fin n -> V) {
   Q : U l = DL.On[DL.Free n].Basis n w ;
   S : U l = LR.Surj n n w ;
   forward (b : Q) : S = \ v -> Tr.Trunc[LR.Witness n n w v].inc
    (b.sec v,\ k -> ap (\ u -> u k) (trans (sym (coordinates n w (b.sec v))) (b.sec-eq v))) ;
   backward (s : S) : Q = Equivalences[l].homotopy V V
    (LR.apply n n w,Matrix[w,s].theorem) (DL.On[DL.Free n].lin n w) (coordinates n w) ;
   equivalence : Pr.Equiv Q S =
    (forward,Pr.qinv Q S forward backward (\ s -> LR.surj-prop n n w _ s)
     (\ q -> Prop331Paths[l].isEquiv-prop V V (DL.On[DL.Free n].lin n w) _ q)) ;
   basis-open : OpenProp[l].Over[R,setR].Open Q =
    OpenProp[l].Over[R,setR].along Q S equivalence (EtaleSurj[l].Over[R,setR,loc].surj-open n n w) ;
  } ;
 } ;
} ;
