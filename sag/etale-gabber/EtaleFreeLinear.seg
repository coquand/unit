-- Multiplication in the monic quotient, in finite free coordinates.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (lower : List R.R) {
 module B = EtaleBasis[l].Over[R,setR].At[lower] ;
 A : Algebras[l].Over[R,setR].Algebra = B.A ;
 module AR = RL[A.ring] ;
 module AS = FiniteIdeal[l].Sums[A.ring] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module DS = MnSums[l].Over[R] ;
 d : Nat = B.d ;
 V : U l = Fin d -> R.R ;
 coords-zero (k : Fin d) : Id R.R (B.coords A.ring.z k) R.z =
  RL[R].add-cancel (B.coords A.ring.z k) (B.coords A.ring.z k)
   (trans (sym (B.coords-add A.ring.z A.ring.z k))
    (ap (\ a -> B.coords a k) (A.ring.addZ A.ring.z))) ;
 coords-sum : (m : Nat) (v : Fin m -> A.ring.R) (k : Fin d) ->
  Id R.R (B.coords (AS.sum m v) k) (RS.sum m (\ j -> B.coords (v j) k)) = split {
  zero -> \ v k -> coords-zero k ;
  suc m | ih -> \ v k -> trans (B.coords-add (v (inr tt)) (AS.sum m (\ j -> v (inl j))) k)
   (ap (R.add (B.coords (v (inr tt)) k)) (ih (\ j -> v (inl j)) k)) } ;
 basis-vector (t : Fin d) : A.ring.R = B.expansion (\ k -> DS.delta d k t) ;
 basis-coordinate (t k : Fin d) : Id R.R (B.coords (basis-vector t) k) (DS.delta d k t) =
  Pr.happly (Fin d) (\ k -> R.R) _ _ (B.coords-expansion (\ k -> DS.delta d k t)) k ;
 basis-expansion (v : V) :
  Id A.ring.R (AS.sum d (\ t -> A.ring.mul (A.iota.1 (v t)) (basis-vector t))) (B.expansion v) =
  Equivalences[l].injective A.ring.R V B.coords B.basis.2 _ _
   (FL.funext (Fin d) (\ k -> R.R) _ _ (\ k ->
     trans (coords-sum d (\ t -> A.ring.mul (A.iota.1 (v t)) (basis-vector t)) k)
      (trans (RS.sum-cong d _ (\ t -> R.mul (v t) (DS.delta d k t))
        (\ t -> trans (B.coords-scale (v t) (basis-vector t) k) (ap (R.mul (v t)) (basis-coordinate t k))))
       (trans (RS.sum-cong d (\ t -> R.mul (v t) (DS.delta d k t))
         (\ t -> R.mul (DS.delta d k t) (v t)) (\ t -> R.mulC (v t) (DS.delta d k t)))
        (trans (DS.sum-delta d k v)
         (sym (Pr.happly (Fin d) (\ k -> R.R) _ _ (B.coords-expansion v) k))))))) ;
 opaque basis-vector ;
 multiply-expansion (h : A.ring.R) (v : V) :
  Id A.ring.R (A.ring.mul h (B.expansion v))
   (AS.sum d (\ t -> A.ring.mul (A.iota.1 (v t)) (A.ring.mul h (basis-vector t)))) =
  trans (ap (A.ring.mul h) (sym (basis-expansion v)))
   (trans (sym (AS.sum-scale h d (\ t -> A.ring.mul (A.iota.1 (v t)) (basis-vector t))))
    (AS.sum-cong d _ _ (\ t -> AR.mul-swap h (A.iota.1 (v t)) (basis-vector t)))) ;
 coords-product (h a : A.ring.R) (k : Fin d) :
  Id R.R (B.coords (A.ring.mul h a) k)
   (RS.sum d (\ t -> R.mul (B.coords (A.ring.mul h (basis-vector t)) k) (B.coords a t))) =
  trans (ap (\ b -> B.coords (A.ring.mul h b) k) (sym (B.expansion-coords a)))
   (trans (ap (\ b -> B.coords b k) (multiply-expansion h (B.coords a)))
    (trans (coords-sum d (\ t -> A.ring.mul (A.iota.1 (B.coords a t)) (A.ring.mul h (basis-vector t))) k)
     (RS.sum-cong d _ _ (\ t -> trans (B.coords-scale (B.coords a t) (A.ring.mul h (basis-vector t)) k)
       (R.mulC (B.coords a t) (B.coords (A.ring.mul h (basis-vector t)) k)))))) ;
 coords-combination (m : Nat) (hs as : Fin m -> A.ring.R) (k : Fin d) :
  Id R.R (B.coords (AS.lin m hs as) k)
   (RS.sum m (\ s -> RS.sum d (\ t -> R.mul (B.coords (A.ring.mul (hs s) (basis-vector t)) k) (B.coords (as s) t)))) =
  trans (coords-sum m (\ s -> A.ring.mul (hs s) (as s)) k)
   (RS.sum-cong m _ _ (\ s -> coords-product (hs s) (as s) k)) ;
} ;
