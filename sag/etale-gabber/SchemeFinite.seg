-- Every entry of a finite family of finite lists occurs in its concatenation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module O = OpenAffine[l] ;
Choice (A : U l) (n : Nat) (ns : Fin n -> Nat)
 (hs : (i : Fin n) -> Fin (ns i) -> A) (i : Fin n) (j : Fin (ns i)) : U l =
 (k : Fin (O.total n ns)) * Id A (O.concat A n ns hs k) (hs i j) ;
module Step (A : U l) (n : Nat) (ns : Fin (suc n) -> Nat)
 (hs : (i : Fin (suc n)) -> Fin (ns i) -> A)
 (ih : (i : Fin n) (j : Fin (ns (inl i))) ->
  Choice A n (\ i -> ns (inl i)) (\ i -> hs (inl i)) i j) {
 old : Nat = O.total n (\ i -> ns (inl i)) ;
 list : Fin old -> A = O.concat A n (\ i -> ns (inl i)) (\ i -> hs (inl i)) ;
 at : (i : Fin (suc n)) (j : Fin (ns i)) -> Choice A (suc n) ns hs i j = split {
  inl i -> \ j ->
   (FinSum[l].left old (ns (inr tt)) (ih i j).1,
    trans (FinSum[l].cases-left old A list (ns (inr tt)) (hs (inr tt)) (ih i j).1) (ih i j).2) ;
  inr t -> Generated[l].top-case
   (\ u -> (j : Fin (ns (inr u))) -> Choice A (suc n) ns hs (inr u) j)
   (\ j -> (FinSum[l].right old (ns (inr tt)) j,
    FinSum[l].cases-right old A list (ns (inr tt)) (hs (inr tt)) j)) t } ;
} ;
choose (A : U l) : (n : Nat) (ns : Fin n -> Nat)
 (hs : (i : Fin n) -> Fin (ns i) -> A) (i : Fin n) (j : Fin (ns i)) -> Choice A n ns hs i j = split {
 zero -> \ ns hs i -> efq i ;
 suc n | ih -> \ ns hs -> Step[A,n,ns,hs,ih (\ i -> ns (inl i)) (\ i -> hs (inl i))].at } ;
