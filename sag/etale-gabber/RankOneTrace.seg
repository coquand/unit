-- Trace one and vanishing two-by-two minors supply the whole projector.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (n : Nat) {
 open A ; open RL[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module M = RankOneProjector[l].Over[A].Size[n] ;
 module From (e : M.Matrix)
  (trace : Id R (S.sum n (\ i -> e i i)) o)
  (minors : (i j k h : Fin n) -> Id R (mul (e i j) (e k h)) (mul (e i h) (e k j))) {
  idempotent (i j : Fin n) : Id R (S.sum n (\ k -> mul (e i k) (e k j))) (e i j) =
   trans (S.sum-cong n (\ k -> mul (e i k) (e k j)) (\ k -> mul (e i j) (e k k))
    (\ k -> minors i k k j))
    (trans (S.sum-scale (e i j) n (\ k -> e k k))
     (trans (ap (mul (e i j)) trace) (mulO (e i j)))) ;
  coefficients (i j : Fin n) : R = (S.coordinates n (e i) i).1 j ;
  row (i : Fin n) : Id R (S.sum n (\ j -> mul (coefficients i j) (e i j))) (e i i) =
   trans (S.sum-cong n (\ j -> mul (coefficients i j) (e i j))
    (\ j -> mul (e i j) (coefficients i j)) (\ j -> mulC (coefficients i j) (e i j)))
    (S.coordinates n (e i) i).2 ;
  full : Id R (S.sum n (\ i -> S.sum n (\ j -> mul (coefficients i j) (e i j)))) o =
   trans (S.sum-cong n (\ i -> S.sum n (\ j -> mul (coefficients i j) (e i j)))
    (\ i -> e i i) row) trace ;
  projector : M.Projector = new M.Projector[e,idempotent,coefficients,full,minors] ;
 } ;
} ;
