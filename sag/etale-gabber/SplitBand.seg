-- The band of the splitting gerbe (H^2 bridges, A2).  For E an algebra and
-- o a splitting of E (rank n+1, SPLITOBJECTS), the scalar arrows
--     sc : R^x -> Arrow o o
-- form an equivalence, and with SPLITSIP the composite
--     beta_o : (o = o) ~ Arrow o o ~ R^x
-- is a band (GERBE.Band, one level up): composition of paths goes to the
-- product of units.
--  (centre)  An arrow a of o commutes with every endomorphism f of o.1:
--            f = sigma(s) for s = sigma^-1(f), and a(sigma(s) x) = sigma(s)(a x).
--            So a is a unique unit scalar (ENDCENTRE).
--  (hom)     to-arrow (p . q) = (to-arrow q) o (to-arrow p) (by J on q), and
--            sc(v) o sc(u) = sc(u v).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module EN = ModuleEnd[l].Over[R,setR] ;
 module GL = StackGerbes[l].Units[R,setR].GB ;
 module At (n : Nat) (E : EN.NA.Algebra) {
  module SO = SplitObjects[l].Over[R,setR,axioms].At[suc n,E] ;
  module SS = SplitSIP[l].Over[R,setR,axioms].At[suc n,E] ;
  -- (centre)
  module Centre (o : SO.Obj) (b : LF.Basis[SO.carrier o,suc n]) {
   module EC = EndCentre[l].Over[R,setR,axioms].At[SO.carrier o,n,b] ;
   commute (a : SO.Arrow o o) : EC.Commutes a.1.1 = \ f x ->
    trans (ap (\ h -> a.1.1 (h.1 x)) (sym (o.2.2.1.2.sec-eq f)))
     (trans (a.2.2 (o.2.2.1.2.sec f) x) (ap (\ h -> h.1 (a.1.1 x)) (o.2.2.1.2.sec-eq f))) ;
   unit (a : SO.Arrow o o) : UG.Unit = EC.Of[a.1,a.2.1,commute a].unit ;
   is-scalar (a : SO.Arrow o o) : Id (SO.Arrow o o) (SO.scalar o (unit a)) a =
    SO.arrow-eq o o (SO.scalar o (unit a)) a (\ x -> sym (EC.Of[a.1,a.2.1,commute a].scalar-law x)) ;
   injective (u v : UG.Unit) (h : Id (SO.Arrow o o) (SO.scalar o u) (SO.scalar o v)) : Id UG.Unit u v =
    EC.injective u v (ap (\ a -> a.1.1 (EC.e EC.o)) h) ;
   module Fib = AffineHLevels[l].Fibres[UG.Unit,SO.Arrow o o,SO.arrow-set o o,SO.scalar o] ;
   fib-prop (a : SO.Arrow o o) : Pr.isProp (Fib.Fib a) = \ w w' ->
    Pr.Sigma-eq UG.Unit (\ u -> Id (SO.Arrow o o) (SO.scalar o u) a) w.1 w'.1 w.2 w'.2
     (injective w.1 w'.1 (trans w.2 (sym w'.2))) (SO.arrow-set o o _ _) ;
   contr (a : SO.Arrow o o) : FunExtUA[l].isContr (Fib.Fib a) =
    ((unit a,is-scalar a),\ w -> fib-prop a (unit a,is-scalar a) w) ;
  } ;
  scalar-equiv (o : SO.Obj) : Pr.isEquiv UG.Unit (SO.Arrow o o) (SO.scalar o) =
   AffineHLevels[l].Fibres[UG.Unit,SO.Arrow o o,SO.arrow-set o o,SO.scalar o].to-equiv (\ a ->
    Tr.Trunc[LF.Basis[SO.carrier o,suc n]].induction @l
     (\ t -> FunExtUA[l].isContr ((u : UG.Unit) * Id (SO.Arrow o o) (SO.scalar o u) a))
     (\ t -> AffineHLevels[l].contr-prop _) (\ b -> Centre[o,b].contr a) o.2.1) ;
  -- composition of arrows: first a, then b
  comp (o1 o2 o3 : SO.Obj) (a : SO.Arrow o1 o2) (b : SO.Arrow o2 o3) : SO.Arrow o1 o3 =
   ((\ x -> b.1.1 (a.1.1 x),
     \ x y -> trans (ap b.1.1 (a.1.2.1 x y)) (b.1.2.1 (a.1.1 x) (a.1.1 y)),
     \ t x -> trans (ap b.1.1 (a.1.2.2 t x)) (b.1.2.2 t (a.1.1 x))),
    (Equivalences[l].compose (SO.carrier o1).M (SO.carrier o2).M (SO.carrier o3).M (a.1.1,a.2.1) (b.1.1,b.2.1)).2,
    \ s x -> trans (ap b.1.1 (a.2.2 s x)) (b.2.2 s (a.1.1 x))) ;
  to-arrow-trans (o1 o2 o3 : SO.Obj) (p : Id SO.Obj o1 o2) (q : Id SO.Obj o2 o3) :
   Id (SO.Arrow o1 o3) (SS.to-arrow o1 o3 (Hi.trans SO.Obj o1 o2 o3 p q)) (comp o1 o2 o3 (SS.to-arrow o1 o2 p) (SS.to-arrow o2 o3 q)) =
   idJ SO.Obj o2 (\ o4 q4 -> Id (SO.Arrow o1 o4) (SS.to-arrow o1 o4 (Hi.trans SO.Obj o1 o2 o4 p q4))
     (comp o1 o2 o4 (SS.to-arrow o1 o2 p) (SS.to-arrow o2 o4 q4)))
    (SO.arrow-eq o1 o2 (SS.to-arrow o1 o2 p) (comp o1 o2 o2 (SS.to-arrow o1 o2 p) (SO.identity o2)) (\ x -> refl ((SS.to-arrow o1 o2 p).1.1 x))) o3 q ;
  -- the band
  bnd (o : SO.Obj) (p : Id SO.Obj o o) : UG.Unit = (scalar-equiv o).sec (SS.to-arrow o o p) ;
  bnd-equiv (o : SO.Obj) : Hi.isEquiv (Id SO.Obj o o) UG.Unit (bnd o) =
   Hi.qinv (Id SO.Obj o o) UG.Unit (bnd o) (\ u -> SS.to-path o o (SO.scalar o u))
    (\ u -> trans (ap (scalar-equiv o).sec (SS.Fd.idToIso-sip o o (SO.scalar o u)))
      (Pr.sec-ret UG.Unit (SO.Arrow o o) (SO.scalar o) (scalar-equiv o) u))
    (\ p -> Hi.trans (Id SO.Obj o o) _ (SS.to-path o o (SS.to-arrow o o p)) p
      (Hi.ap (SO.Arrow o o) (Id SO.Obj o o) (SS.to-path o o) _ _ ((scalar-equiv o).sec-eq (SS.to-arrow o o p)))
      (SS.Fd.sip-idToIso o o p)) ;
  scalar-comp (o : SO.Obj) (u v : UG.Unit) :
   Id (SO.Arrow o o) (comp o o o (SO.scalar o u) (SO.scalar o v)) (SO.scalar o (UG.times u v)) =
   SO.arrow-eq o o _ _ (\ x -> trans ((SO.carrier o).smA v.1 u.1 x) (ap (\ t -> (SO.carrier o).sm t x) (R.mulC v.1 u.1))) ;
  #fails {
   -- composition is first a then b: sc(v) o sc(u) is v(u x), not u(v x)
   scalar-comp-reversed (o : SO.Obj) (u v : UG.Unit) :
    Id (SO.Arrow o o) (comp o o o (SO.scalar o u) (SO.scalar o v)) (SO.scalar o (UG.times u v)) =
    SO.arrow-eq o o _ _ (\ x -> (SO.carrier o).smA u.1 v.1 x) ;
  } ;
  bnd-hom (o : SO.Obj) (p q : Id SO.Obj o o) :
   Id UG.Unit (bnd o (Hi.trans SO.Obj o o o p q)) (UG.times (bnd o p) (bnd o q)) =
   calc UG.Unit { bnd o (Hi.trans SO.Obj o o o p q)
    =< ap (scalar-equiv o).sec (to-arrow-trans o o o p q) >
       (scalar-equiv o).sec (comp o o o (SS.to-arrow o o p) (SS.to-arrow o o q))
    =< ap (\ a -> (scalar-equiv o).sec (comp o o o a (SS.to-arrow o o q))) (sym ((scalar-equiv o).sec-eq (SS.to-arrow o o p))) >
       (scalar-equiv o).sec (comp o o o (SO.scalar o (bnd o p)) (SS.to-arrow o o q))
    =< ap (\ a -> (scalar-equiv o).sec (comp o o o (SO.scalar o (bnd o p)) a)) (sym ((scalar-equiv o).sec-eq (SS.to-arrow o o q))) >
       (scalar-equiv o).sec (comp o o o (SO.scalar o (bnd o p)) (SO.scalar o (bnd o q)))
    =< ap (scalar-equiv o).sec (scalar-comp o (bnd o p) (bnd o q)) >
       (scalar-equiv o).sec (SO.scalar o (UG.times (bnd o p) (bnd o q)))
    =< Pr.sec-ret UG.Unit (SO.Arrow o o) (SO.scalar o) (scalar-equiv o) (UG.times (bnd o p) (bnd o q)) >
       UG.times (bnd o p) (bnd o q) } ;
  band (o : SO.Obj) : GL.Band SO.Obj o =
   (bnd o,AffineHLevels[l+].Fibres[Id SO.Obj o o,UG.Unit,UG.setU,bnd o].from-equiv (bnd-equiv o),bnd-hom o) ;
 } ;
} ;
