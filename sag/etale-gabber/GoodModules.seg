-- Good twisted modules (gabber-recollement, Theorem main).  On X = Spec Alg,
-- with gerbes G x and Lambda of weight n = n0 + 1, a good module is a
-- twisted family V whose fibres merely have bases of rank r = r0 + 1, with
-- r^n = N = N0 + 1 (MULTILINEAR.rank) and V good of rank N
-- (CHEAPOVERLAP.Good: rho = 1 at N for every frame data of P(V)^v).
--  (regood)  Goodness depends on N only through [N] in K_0(Alg): if
--     [N0 + 1] = [N1 + 1], then rho(u) at N0 + 1 is rho(u) at N1 + 1
--     (RHOPRODUCTS.respect).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module FP = FrameProjector[l].Over[R,setR,axioms] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe)
  (n0 : Nat) (Lambda : TM.Family[C.Spec Alg,G].Weighted (\ a -> TM.UG.power a (suc n0))) {
  module CO = CheapOverlap[l].Over[R,setR,axioms].At[Alg,fp,G,n0,Lambda] ;
  module RP = RhoProducts[l].Over[CO.K.K0] ;
  -- (regood)
  regood (V : CO.DA.Fam.TF.Twisted) (N0 N1 : Nat) (e : Id CO.K.K0.R (CO.IK.nat (suc N0)) (CO.IK.nat (suc N1)))
   (g : CO.Good V N0) : CO.Good V N1 = \ w ->
   trans (RP.respect (CO.K.class FP.At[Alg,fp,CO.MF.Dual[suc n0,V,Lambda].descended].From[w].projector)
     (CO.IK.nat (suc N1)) (CO.IK.nat (suc N0)) (CO.RQ.positive N1) (CO.RQ.positive N0) (sym e))
    (g w) ;
  record GoodModule {
   family : CO.DA.Fam.TF.Twisted ;
   rank0 : Nat ;
   bases : (x : C.Spec Alg) (g : (G x).1) -> Tr.Trunc[LF.Basis[family.1 x g,suc rank0]].carrier ;
   power0 : Nat ;
   power-eq : Id Nat (ML.rank (suc rank0) (suc zero) (suc n0)) (suc power0) ;
   good : CO.Good family power0 ;
  } ;
 } ;
} ;
