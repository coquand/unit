-- Small codes for affine types. Flatten both truncations in Affine.
-- No geometric axiom: existence of presented algebras supplies the converse.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 Sol (p : P.Presentation) : U l = P.Solutions p C.base ;
 sol-set (p : P.Presentation) : Pr.isSet (Sol p) =
  Pr.isSet-Sigma (Fin p.1 -> R.R) (\ a -> P.Zeros (Fin p.1) C.base a p.2)
   (F.isSet-Pi (Fin p.1) (\ i -> R.R) (\ i -> setR))
   (\ a -> Pr.prop-to-set _ (P.zeros-prop (Fin p.1) C.base a p.2)) ;
 Witness (X : U l) : U l = (p : P.Presentation) * Pr.Equiv X (Sol p) ;
 Affine (X : U l) : U l = Tr.Trunc[Witness X].carrier ;
 proposition (X : U l) : Pr.isProp (Affine X) = Tr.Trunc[Witness X].proposition ;
 from-presented (X : U l) (A : C.Algebra) (e : Pr.Equiv X (C.Spec A))
  (w : P.Witness A) : Witness X =
  (w.1,Equivalences[l].compose X (C.Spec A) (Sol w.1) e
   (P.canonical w.1 A w.2.1 C.base,w.2.2 C.base)) ;
 from-affine (X : U l) (a : FA.Affine X) : Affine X =
  Tr1.Trunc[FA.AffineWitness X].induction @l (\ t -> Affine X) (\ t -> proposition X)
   (\ w -> Tr1.Trunc[P.Witness w.1].induction @l (\ t -> Affine X) (\ t -> proposition X)
    (\ p -> Tr.Trunc[Witness X].inc (from-presented X w.1 w.2.2 p)) w.2.1) a ;
 module Presented (p : P.Presentation) {
  module Ex = PresentationExistence[l].Over[R,setR,p] ;
  spectrum : Pr.Equiv (C.Spec Ex.A.algebra) (Sol p) =
   (P.canonical p Ex.A.algebra Ex.presentation.1 C.base,Ex.presentation.2 C.base) ;
  affine : FA.Affine (Sol p) =
   Tr1.Trunc[FA.AffineWitness (Sol p)].inc
    (Ex.A.algebra,Ex.finitely-presented,Functions[l].inverse _ _ spectrum) ;
 } ;
 to-witness (X : U l) (w : Witness X) : FA.AffineWitness X =
  (Presented[w.1].Ex.A.algebra,Presented[w.1].Ex.finitely-presented,
   Equivalences[l].compose X (Sol w.1) (C.Spec Presented[w.1].Ex.A.algebra)
    w.2 (Functions[l].inverse _ _ Presented[w.1].spectrum)) ;
 to-affine (X : U l) (a : Affine X) : FA.Affine X =
  Tr.Trunc[Witness X].induction @(l+) (\ t -> FA.Affine X)
   (\ t -> Tr1.Trunc[FA.AffineWitness X].proposition)
   (\ w -> Tr1.Trunc[FA.AffineWitness X].inc (to-witness X w)) a ;
 set (X : U l) (a : Affine X) : Pr.isSet X =
  Tr.Trunc[Witness X].induction @l (\ t -> Pr.isSet X) (\ t -> AffineHLevels[l].set-prop X)
   (\ w -> AffineHLevels[l].set-from-equiv X (Sol w.1) (sol-set w.1) w.2.1 w.2.2) a ;
 along (X Y : U l) (e : Pr.Equiv X Y) (a : Affine Y) : Affine X =
  Tr.Trunc[Witness Y].induction @l (\ t -> Affine X) (\ t -> proposition X)
   (\ w -> Tr.Trunc[Witness X].inc (w.1,Equivalences[l].compose X Y (Sol w.1) e w.2)) a ;
} ;
