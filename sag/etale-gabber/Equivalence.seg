-- Murray-von Neumann equivalence of n x n projectors X, Y over R: matrices
-- u, v with
--     v u = X,   u v = Y,   Y u = u,   v Y = v,   X v = v.
-- (u maps Image X onto Image Y, v back.)  A ring map sends an equivalence
-- to one of the images (Map), and an equivalence may be moved along
-- equations of X and Y (retarget).
--
-- From an isomorphism.  A linear map f : Image X -> Image Y (PROJECTORS) is
-- the action of the matrix u with columns u_k = f (X d_k) (d_k the unit
-- vectors):  for w in R^n, X w = sum_k w_k X d_k in Image X, so
--     f (X w) = sum_k w_k f (X d_k) = u w           (Columns.act).
-- If f is an isomorphism with inverse g, and v is the matrix of g, then
--     v u w = g (Y (f (X w))) = g (f (X w)) = X w,  u v w = Y w,
--     Y u w = u w,  v Y w = g (Y Y w) = v w,  X v w = v w,
-- since f and g land in the images and Y fixes Image Y (FromIso).
-- Conversely u, v give inverse maps of the images (ToIso).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat) {
 module V = Vectors[l].Over[R,setR,n] ;
 module Mt = V.MR ;
 record Equivalent (X Y : Mt.Mat) {
  u : Mt.Mat ;
  v : Mt.Mat ;
  vu : Id Mt.Mat (Mt.mmul v u) X ;
  uv : Id Mt.Mat (Mt.mmul u v) Y ;
  yu : Id Mt.Mat (Mt.mmul Y u) u ;
  vy : Id Mt.Mat (Mt.mmul v Y) v ;
  xv : Id Mt.Mat (Mt.mmul X v) v ;
 } ;
 retarget (X Y X' Y' : Mt.Mat) (eX : Id Mt.Mat X X') (eY : Id Mt.Mat Y Y') (q : Equivalent[X,Y]) : Equivalent[X',Y'] =
  new Equivalent[X',Y',q.u,q.v,trans q.vu eX,trans q.uv eY,
   trans (ap (\ Z -> Mt.mmul Z q.u) (sym eY)) q.yu,
   trans (ap (Mt.mmul q.v) (sym eY)) q.vy,
   trans (ap (\ Z -> Mt.mmul Z q.v) (sym eX)) q.xv] ;
 -- the five laws on vectors
 module Act (X Y : Mt.Mat) (q : Equivalent[X,Y]) {
  law (P Q : Mt.Mat) (h : Id Mt.Mat (Mt.mmul P Q) Q) (w : V.Vec) : Id V.Vec (V.act P (V.act Q w)) (V.act Q w) =
   trans (V.act-mul P Q w) (ap (\ Z -> V.act Z w) h) ;
  vu (w : V.Vec) : Id V.Vec (V.act q.v (V.act q.u w)) (V.act X w) =
   trans (V.act-mul q.v q.u w) (ap (\ Z -> V.act Z w) q.vu) ;
  uv (w : V.Vec) : Id V.Vec (V.act q.u (V.act q.v w)) (V.act Y w) =
   trans (V.act-mul q.u q.v w) (ap (\ Z -> V.act Z w) q.uv) ;
  yu (w : V.Vec) : Id V.Vec (V.act Y (V.act q.u w)) (V.act q.u w) = law Y q.u q.yu w ;
  vy (w : V.Vec) : Id V.Vec (V.act q.v (V.act Y w)) (V.act q.v w) =
   trans (V.act-mul q.v Y w) (ap (\ Z -> V.act Z w) q.vy) ;
  xv (w : V.Vec) : Id V.Vec (V.act X (V.act q.v w)) (V.act q.v w) = law X q.v q.xv w ;
 } ;

 -- (a + y) - a = y,  a + (x - a) = x
 cancel-left (a y : R.R) : Id R.R (R.add (R.add a y) (R.neg a)) y =
  trans (ap (\ t -> R.add t (R.neg a)) (R.addC a y)) (RL[R].add-neg-cancel y a) ;
 cancel-inner (a x : R.R) : Id R.R (R.add a (R.add x (R.neg a))) x =
  trans (RL[R].add-swap a x (R.neg a)) (trans (ap (R.add x) (R.addN a)) (R.addZ x)) ;
 add-zero (x : V.Vec) : Id V.Vec (V.vadd x V.vzero) x = V.vec-eq _ _ (\ i -> R.addZ (x i)) ;

 -- An equivalence q of E and F, on vectors; comp w = w - F w.
 module Split (E F : Mt.Mat) (hF : Id Mt.Mat (Mt.mmul F F) F) (q : Equivalent[E,F]) {
  module Q = Act[E,F,q] ;
  comp (w : V.Vec) : V.Vec = V.vadd w (V.vneg (V.act F w)) ;
  -- v (w - F w) = v w - v w = 0
  v-comp (w : V.Vec) : Id V.Vec (V.act q.v (comp w)) V.vzero =
   calc V.Vec { V.act q.v (comp w)
     =< V.act-add q.v w (V.vneg (V.act F w)) > V.vadd (V.act q.v w) (V.act q.v (V.vneg (V.act F w)))
     =< ap (V.vadd (V.act q.v w)) (trans (V.act-neg q.v (V.act F w)) (ap V.vneg (Q.vy w))) >
        V.vadd (V.act q.v w) (V.vneg (V.act q.v w))
     =< V.vec-eq _ _ (\ i -> R.addN (V.act q.v w i)) > V.vzero } ;
  -- F (w - F w) = F w - F F w = 0
  f-comp (w : V.Vec) : Id V.Vec (V.act F (comp w)) V.vzero =
   calc V.Vec { V.act F (comp w)
     =< V.act-add F w (V.vneg (V.act F w)) > V.vadd (V.act F w) (V.act F (V.vneg (V.act F w)))
     =< ap (V.vadd (V.act F w)) (trans (V.act-neg F (V.act F w)) (ap V.vneg (Q.law F F hF w))) >
        V.vadd (V.act F w) (V.vneg (V.act F w))
     =< V.vec-eq _ _ (\ i -> R.addN (V.act F w i)) > V.vzero } ;
  -- u v w + (w - F w) = F w + (w - F w) = w
  u-v-comp (w : V.Vec) : Id V.Vec (V.vadd (V.act q.u (V.act q.v w)) (comp w)) w =
   trans (ap (\ t -> V.vadd t (comp w)) (Q.uv w)) (V.vec-eq _ _ (\ i -> cancel-inner (V.act F w i) (w i))) ;
  -- for E x = x and F y = 0:  v (u x + y) = E x + v F y = x
  v-sum (x y : V.Vec) (hx : Id V.Vec (V.act E x) x) (hy : Id V.Vec (V.act F y) V.vzero) :
   Id V.Vec (V.act q.v (V.vadd (V.act q.u x) y)) x =
   calc V.Vec { V.act q.v (V.vadd (V.act q.u x) y)
     =< V.act-add q.v (V.act q.u x) y > V.vadd (V.act q.v (V.act q.u x)) (V.act q.v y)
     =< cong2 V.Vec V.vadd _ _ _ _ (trans (Q.vu x) hx)
         (trans (sym (Q.vy y)) (trans (ap (V.act q.v) hy) (V.act-zero q.v))) > V.vadd x V.vzero
     =< add-zero x > x } ;
  -- F (u x + y) = u x  when F y = 0
  f-sum (x y : V.Vec) (hy : Id V.Vec (V.act F y) V.vzero) : Id V.Vec (V.act F (V.vadd (V.act q.u x) y)) (V.act q.u x) =
   trans (V.act-add F (V.act q.u x) y)
    (trans (cong2 V.Vec V.vadd _ _ _ _ (Q.yu x) hy) (add-zero (V.act q.u x))) ;
  -- (u x + y) - F (u x + y) = y  when F y = 0
  comp-sum (x y : V.Vec) (hy : Id V.Vec (V.act F y) V.vzero) : Id V.Vec (comp (V.vadd (V.act q.u x) y)) y =
   trans (ap (\ t -> V.vadd (V.vadd (V.act q.u x) y) (V.vneg t)) (f-sum x y hy))
    (V.vec-eq _ _ (\ i -> cancel-left (V.act q.u x i) (y i))) ;
 } ;

 -- Two equivalences q, r of E and F give the matrix
 --     G = q.u r.v + (1 - F),
 -- with G (r.u x + y) = q.u x + y for E x = x, F y = 0 (transport),
 -- q.v G = r.v (v-matrix), G w - F G w = w - F w (comp-matrix), and
 -- G_qr G_rq = 1 (cancel): G_rq w = r.u (q.v w) + (w - F w), with
 -- E (q.v w) = q.v w and F (w - F w) = 0, so G_qr G_rq w = q.u q.v w + (w - F w) = w.
 module Pair (E F : Mt.Mat) (hF : Id Mt.Mat (Mt.mmul F F) F) (q r : Equivalent[E,F]) {
  module SQ = Split[E,F,hF,q] ;
  module SR = Split[E,F,hF,r] ;
  complement : Mt.Mat = Mt.madd Mt.mone (Mt.mneg F) ;
  matrix : Mt.Mat = Mt.madd (Mt.mmul q.u r.v) complement ;
  act (w : V.Vec) : Id V.Vec (V.act matrix w) (V.vadd (V.act q.u (V.act r.v w)) (SQ.comp w)) =
   trans (V.act-madd (Mt.mmul q.u r.v) complement w)
    (cong2 V.Vec V.vadd _ _ _ _ (sym (V.act-mul q.u r.v w))
     (trans (V.act-madd Mt.mone (Mt.mneg F) w) (cong2 V.Vec V.vadd _ _ _ _ (V.act-one w) (V.act-mneg F w)))) ;
  transport (x y : V.Vec) (hx : Id V.Vec (V.act E x) x) (hy : Id V.Vec (V.act F y) V.vzero) :
   Id V.Vec (V.act matrix (V.vadd (V.act r.u x) y)) (V.vadd (V.act q.u x) y) =
   trans (act (V.vadd (V.act r.u x) y))
    (cong2 V.Vec V.vadd _ _ _ _ (ap (V.act q.u) (SR.v-sum x y hx hy)) (SR.comp-sum x y hy)) ;
  v-matrix (w : V.Vec) : Id V.Vec (V.act q.v (V.act matrix w)) (V.act r.v w) =
   calc V.Vec { V.act q.v (V.act matrix w)
     =< ap (V.act q.v) (act w) > V.act q.v (V.vadd (V.act q.u (V.act r.v w)) (SQ.comp w))
     =< V.act-add q.v (V.act q.u (V.act r.v w)) (SQ.comp w) >
        V.vadd (V.act q.v (V.act q.u (V.act r.v w))) (V.act q.v (SQ.comp w))
     =< cong2 V.Vec V.vadd _ _ _ _ (trans (SQ.Q.vu (V.act r.v w)) (SR.Q.xv w)) (SQ.v-comp w) > V.vadd (V.act r.v w) V.vzero
     =< add-zero (V.act r.v w) > V.act r.v w } ;
  comp-matrix (w : V.Vec) : Id V.Vec (SQ.comp (V.act matrix w)) (SQ.comp w) =
   trans (ap SQ.comp (act w)) (SQ.comp-sum (V.act r.v w) (SQ.comp w) (SQ.f-comp w)) ;
 } ;

 module Cancel (E F : Mt.Mat) (hF : Id Mt.Mat (Mt.mmul F F) F) (q r : Equivalent[E,F]) {
  module P = Pair[E,F,hF,q,r] ;
  module P' = Pair[E,F,hF,r,q] ;
  cancel : Id Mt.Mat (Mt.mmul P.matrix P'.matrix) Mt.mone = V.mat-act _ _ (\ w ->
   calc V.Vec { V.act (Mt.mmul P.matrix P'.matrix) w
     =< sym (V.act-mul P.matrix P'.matrix w) > V.act P.matrix (V.act P'.matrix w)
     =< ap (V.act P.matrix) (P'.act w) > V.act P.matrix (V.vadd (V.act r.u (V.act q.v w)) (P.SQ.comp w))
     =< P.transport (V.act q.v w) (P.SQ.comp w) (P.SQ.Q.xv w) (P.SQ.f-comp w) > V.vadd (V.act q.u (V.act q.v w)) (P.SQ.comp w)
     =< P.SQ.u-v-comp w > w
     =< sym (V.act-one w) > V.act Mt.mone w }) ;
 } ;

 module PJ = Projectors[l].Over[R,setR] ;
 module MI = PJ.MI ;
 module S = FiniteIdeal[l].Sums[R] ;
 module D = MnSums[l].Over[R] ;
 -- the unit vector d_k
 unit (k : Fin n) : V.Vec = \ j -> Mt.mone j k ;
 -- the matrix of a linear map between images
 module Columns (X Y : Mt.Mat) (hX : Id Mt.Mat (Mt.mmul X X) X) (hY : Id Mt.Mat (Mt.mmul Y Y) Y)
  (f : MI.Lin[PJ.Image[new PJ.Projector[n,X,hX]].image,PJ.Image[new PJ.Projector[n,Y,hY]].image].B.Hom) {
  module IX = PJ.Image[new PJ.Projector[n,X,hX]] ;
  module IY = PJ.Image[new PJ.Projector[n,Y,hY]] ;
  module FS = SerreModuleSums[l].Map[R,R,H.identity R,IX.image,IY.image,f] ;
  matrix : Mt.Mat = \ i k -> IY.value (f.fn (IX.fix (unit k))) i ;
  terms (w : V.Vec) (k : Fin n) : IX.Carrier = IX.scale (w k) (IX.fix (unit k)) ;
  -- X w = sum_k w_k X d_k
  expand (w : V.Vec) : Id IX.Carrier (IX.fix w) (IX.PS.sum n (terms w)) =
   IX.ext (IX.fix w) (IX.PS.sum n (terms w)) (V.vec-eq _ _ (\ i ->
    calc R.R { V.act X w i
      =< S.sum-cong n (\ k -> R.mul (X i k) (w k)) (\ k -> R.mul (w k) (V.act X (unit k) i))
          (\ k -> trans (R.mulC (X i k) (w k)) (ap (R.mul (w k)) (sym (D.sum-delta-right n k (X i))))) >
         S.sum n (\ k -> IX.value (terms w k) i)
      =< sym (IX.sum-at n (terms w) i) > IX.value (IX.PS.sum n (terms w)) i })) ;
  -- f (X w) = sum_k w_k f (X d_k)
  image-sum (w : V.Vec) : Id IY.Carrier (f.fn (IX.fix w)) (IY.PS.sum n (\ k -> IY.scale (w k) (f.fn (IX.fix (unit k))))) =
   calc IY.Carrier { f.fn (IX.fix w)
     =< ap f.fn (expand w) > f.fn (IX.PS.sum n (terms w))
     =< FS.sum-map n (terms w) > IY.PS.sum n (\ k -> f.fn (terms w k))
     =< IY.PS.sum-cong n _ _ (\ k -> f.scalar (w k) (IX.fix (unit k))) >
        IY.PS.sum n (\ k -> IY.scale (w k) (f.fn (IX.fix (unit k)))) } ;
  act (w : V.Vec) : Id V.Vec (V.act matrix w) (IY.value (f.fn (IX.fix w))) =
   V.vec-eq _ _ (\ i ->
    calc R.R { V.act matrix w i
      =< S.sum-cong n (\ k -> R.mul (matrix i k) (w k)) (\ k -> IY.value (IY.scale (w k) (f.fn (IX.fix (unit k)))) i)
          (\ k -> R.mulC (matrix i k) (w k)) >
         S.sum n (\ k -> IY.value (IY.scale (w k) (f.fn (IX.fix (unit k)))) i)
      =< sym (IY.sum-at n (\ k -> IY.scale (w k) (f.fn (IX.fix (unit k)))) i) >
         IY.value (IY.PS.sum n (\ k -> IY.scale (w k) (f.fn (IX.fix (unit k))))) i
      =< ap (\ t -> IY.value t i) (sym (image-sum w)) > IY.value (f.fn (IX.fix w)) i }) ;
 } ;

 module FromIso (X Y : Mt.Mat) (hX : Id Mt.Mat (Mt.mmul X X) X) (hY : Id Mt.Mat (Mt.mmul Y Y) Y)
  (h : MI.Iso[PJ.Image[new PJ.Projector[n,X,hX]].image,PJ.Image[new PJ.Projector[n,Y,hY]].image]) {
  module IX = PJ.Image[new PJ.Projector[n,X,hX]] ;
  module IY = PJ.Image[new PJ.Projector[n,Y,hY]] ;
  module CU = Columns[X,Y,hX,hY,h.hom] ;
  module CV = Columns[Y,X,hY,hX,(MI.inverse IX.image IY.image h).hom] ;
  -- a projector fixes its image
  fix-x (x : IX.Carrier) : Id IX.Carrier (IX.fix (IX.value x)) x = IX.ext _ _ (IX.member x) ;
  fix-y (y : IY.Carrier) : Id IY.Carrier (IY.fix (IY.value y)) y = IY.ext _ _ (IY.member y) ;
  -- X X w = X w
  twice (Z : Mt.Mat) (hZ : Id Mt.Mat (Mt.mmul Z Z) Z) (w : V.Vec) : Id V.Vec (V.act Z (V.act Z w)) (V.act Z w) =
   trans (V.act-mul Z Z w) (ap (\ T -> V.act T w) hZ) ;
  vu : Id Mt.Mat (Mt.mmul CV.matrix CU.matrix) X = V.mat-act _ _ (\ w ->
   calc V.Vec { V.act (Mt.mmul CV.matrix CU.matrix) w
     =< sym (V.act-mul CV.matrix CU.matrix w) > V.act CV.matrix (V.act CU.matrix w)
     =< CV.act (V.act CU.matrix w) > IX.value (h.inv (IY.fix (V.act CU.matrix w)))
     =< ap (\ t -> IX.value (h.inv (IY.fix t))) (CU.act w) > IX.value (h.inv (IY.fix (IY.value (h.hom.fn (IX.fix w)))))
     =< ap (\ t -> IX.value (h.inv t)) (fix-y (h.hom.fn (IX.fix w))) > IX.value (h.inv (h.hom.fn (IX.fix w)))
     =< ap IX.value (h.inv-to (IX.fix w)) > V.act X w }) ;
  uv : Id Mt.Mat (Mt.mmul CU.matrix CV.matrix) Y = V.mat-act _ _ (\ w ->
   calc V.Vec { V.act (Mt.mmul CU.matrix CV.matrix) w
     =< sym (V.act-mul CU.matrix CV.matrix w) > V.act CU.matrix (V.act CV.matrix w)
     =< CU.act (V.act CV.matrix w) > IY.value (h.hom.fn (IX.fix (V.act CV.matrix w)))
     =< ap (\ t -> IY.value (h.hom.fn (IX.fix t))) (CV.act w) > IY.value (h.hom.fn (IX.fix (IX.value (h.inv (IY.fix w)))))
     =< ap (\ t -> IY.value (h.hom.fn t)) (fix-x (h.inv (IY.fix w))) > IY.value (h.hom.fn (h.inv (IY.fix w)))
     =< ap IY.value (h.to-inv (IY.fix w)) > V.act Y w }) ;
  yu : Id Mt.Mat (Mt.mmul Y CU.matrix) CU.matrix = V.mat-act _ _ (\ w ->
   calc V.Vec { V.act (Mt.mmul Y CU.matrix) w
     =< sym (V.act-mul Y CU.matrix w) > V.act Y (V.act CU.matrix w)
     =< ap (V.act Y) (CU.act w) > V.act Y (IY.value (h.hom.fn (IX.fix w)))
     =< IY.member (h.hom.fn (IX.fix w)) > IY.value (h.hom.fn (IX.fix w))
     =< sym (CU.act w) > V.act CU.matrix w }) ;
  vy : Id Mt.Mat (Mt.mmul CV.matrix Y) CV.matrix = V.mat-act _ _ (\ w ->
   calc V.Vec { V.act (Mt.mmul CV.matrix Y) w
     =< sym (V.act-mul CV.matrix Y w) > V.act CV.matrix (V.act Y w)
     =< CV.act (V.act Y w) > IX.value (h.inv (IY.fix (V.act Y w)))
     =< ap (\ t -> IX.value (h.inv t)) (IY.ext (IY.fix (V.act Y w)) (IY.fix w) (twice Y hY w)) > IX.value (h.inv (IY.fix w))
     =< sym (CV.act w) > V.act CV.matrix w }) ;
  xv : Id Mt.Mat (Mt.mmul X CV.matrix) CV.matrix = V.mat-act _ _ (\ w ->
   calc V.Vec { V.act (Mt.mmul X CV.matrix) w
     =< sym (V.act-mul X CV.matrix w) > V.act X (V.act CV.matrix w)
     =< ap (V.act X) (CV.act w) > V.act X (IX.value (h.inv (IY.fix w)))
     =< IX.member (h.inv (IY.fix w)) > IX.value (h.inv (IY.fix w))
     =< sym (CV.act w) > V.act CV.matrix w }) ;
  equivalent : Equivalent[X,Y] = new Equivalent[X,Y,CU.matrix,CV.matrix,vu,uv,yu,vy,xv] ;
 } ;

 -- back: an equivalence gives the isomorphism x |-> u x, y |-> v y of the images
 module ToIso (X Y : Mt.Mat) (hX : Id Mt.Mat (Mt.mmul X X) X) (hY : Id Mt.Mat (Mt.mmul Y Y) Y) (q : Equivalent[X,Y]) {
  module IX = PJ.Image[new PJ.Projector[n,X,hX]] ;
  module IY = PJ.Image[new PJ.Projector[n,Y,hY]] ;
  module Q = Act[X,Y,q] ;
  to (x : IX.Carrier) : IY.Carrier = (V.act q.u (IX.value x),Q.yu (IX.value x)) ;
  from (y : IY.Carrier) : IX.Carrier = (V.act q.v (IY.value y),Q.xv (IY.value y)) ;
  iso : MI.Iso[IX.image,IY.image] = MI.make IX.image IY.image to from
   (\ x x' -> IY.ext (to (IX.add x x')) (IY.add (to x) (to x')) (V.act-add q.u (IX.value x) (IX.value x')))
   (\ c x -> IY.ext (to (IX.scale c x)) (IY.scale c (to x)) (V.act-scale q.u c (IX.value x)))
   (\ y -> IY.ext (to (from y)) y (trans (Q.uv (IY.value y)) (IY.member y)))
   (\ x -> IX.ext (from (to x)) x (trans (Q.vu (IX.value x)) (IX.member x))) ;
 } ;
} ;

-- a ring map sends an equivalence to an equivalence of the images
module Map (R T : CRing) (setR : Pr.isSet R.R) (setT : Pr.isSet T.R) (f : H.Hom R T) (n : Nat) {
 module ER = Over[R,setR,n] ;
 module ET = Over[T,setT,n] ;
 module MM = MatrixMap[l].Over[R,T,setR,setT,f,n] ;
 law (P Q Z : ER.Mt.Mat) (e : Id ER.Mt.Mat (ER.Mt.mmul P Q) Z) : Id ET.Mt.Mat (ET.Mt.mmul (MM.map P) (MM.map Q)) (MM.map Z) =
  trans (sym (MM.map-mul P Q)) (ap MM.map e) ;
 map (X Y : ER.Mt.Mat) (q : ER.Equivalent[X,Y]) : ET.Equivalent[MM.map X,MM.map Y] =
  new ET.Equivalent[MM.map X,MM.map Y,MM.map q.u,MM.map q.v,
   law q.v q.u X q.vu,law q.u q.v Y q.uv,law Y q.u q.u q.yu,law q.v Y q.v q.vy,law X q.v q.v q.xv] ;
} ;
