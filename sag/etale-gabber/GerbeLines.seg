-- The 1-cells of an R^x-gerbe with local points, made external (first step
-- of the twisted layer; ../HANDOFF-GABBER-HOMOTOPY.md).  Let G be a family of
-- R^x-gerbes over Spec Alg (GERBE, banded by the units of R, PICARDUNITS),
-- Alg finitely presented, with points s_u over D(u) and s_v over D(v).
-- Over D(uv) the paths s_u x = s_v x form an R^x-torsor (Gerbe.PTor); a
-- point of D(uv) is one of D(u) and of D(v), since x(uv) = x(u) x(v).
-- D(uv) is Spec Alg[1/uv] (AFFINEINTERFACE: localize, spectrum), and
-- AFFINELINEPROJECTOR gives merely a rank-one projector H over Alg[1/uv]
-- whose fixed vectors are the global sections of the associated line,
-- additively and Alg[1/uv]-linearly.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module GB = Gerbe[l].Gerbes[UG.group] ;
 module LP = AffineLineProjector[l].Over[R,setR,axioms] ;
 module RR = RL[R] ;
 Tor : U l+ = TorsorId[l].TorId[UG.group].Tor ;
 -- the factors of a unit product are units
 unit-left (a b : R.R) (h : RR.unit (R.mul a b)) : RR.unit a = (R.mul b h.1,trans (R.mulA a b h.1) h.2) ;
 unit-right (a b : R.R) (h : RR.unit (R.mul a b)) : RR.unit b =
  (R.mul a h.1,trans (R.mulA b a h.1) (trans (ap (\ t -> R.mul t h.1) (R.mulC b a)) h.2)) ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> GB.AGerbe) (u v : Alg.ring.R)
  (su : (x : AI.D Alg u) -> (G x.1).1) (sv : (x : AI.D Alg v) -> (G x.1).1) {
  w : Alg.ring.R = Alg.ring.mul u v ;
  -- x(uv) = x(u) x(v)
  product-unit (x : C.Spec Alg) (h : RR.unit (x.1.1 w)) : RR.unit (R.mul (x.1.1 u) (x.1.1 v)) =
   (h.1,trans (ap (\ t -> R.mul t h.1) (sym (x.1.2.2.2 u v))) h.2) ;
  left (x : AI.D Alg w) : AI.D Alg u = (x.1,unit-left (x.1.1.1 u) (x.1.1.1 v) (product-unit x.1 x.2)) ;
  right (x : AI.D Alg w) : AI.D Alg v = (x.1,unit-right (x.1.1.1 u) (x.1.1.1 v) (product-unit x.1 x.2)) ;
  -- the torsor of paths over D(uv)
  paths (x : AI.D Alg w) : Tor = GB.GL[G x.1].PTor (su (left x)) (sv (right x)) ;
  module Line (loc : AI.LocalizationWitness Alg w) {
   L : C.Algebra = loc.1 ;
   point (y : C.Spec L) : AI.D Alg w = (AI.spectrum Alg w loc).1 y ;
   T (y : C.Spec L) : Tor = paths (point y) ;
   module LA = LP.At[L,loc.2.1,T] ;
   theorem : Tr.Trunc[LA.Witness].carrier = LA.theorem ;
  } ;
  Result : U l+ = (loc : AI.LocalizationWitness Alg w) * Tr.Trunc[Line[loc].LA.Witness].carrier ;
  theorem : Tr1.Trunc[Result].carrier =
   TC1.map (AI.LocalizationWitness Alg w) Result (\ loc -> (loc,Line[loc].theorem)) (AI.localize Alg fp w) ;
 } ;
} ;
