-- mu_ijk externally (../HANDOFF-GABBER-HOMOTOPY.md).  In the situation of
-- GERBETENSOR (a gerbe over Spec L with point families a, b, c), let w_ab,
-- w_bc, w_ac be frame data of the lines of the path torsors, and H_ab, H_bc,
-- H_ac their projectors over L (LINEMODULES).  Then
--     Image (H_ab (x) H_bc) ~ Image H_ac        as L-modules.
-- Proof: H_ab (x) H_bc is the projector of the product data (GERBETENSOR,
-- kronecker), so the two images are equal (PROJECTORS.Equal), and the
-- product data and w_ac are frame data of the same line (LINEMODULES.Compare).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module GB = Gerbe[l].Gerbes[UG.group] ;
 module At (L : C.Algebra) (fp : P.FP L) (G : C.Spec L -> GB.AGerbe) (pa pb pc : (y : C.Spec L) -> (G y).1) {
  module GT = GerbeTensor[l].Over[R,setR,axioms].At[L,fp,G,pa,pb,pc] ;
  module MAB = LineModules[l].Over[R,setR,axioms].At[L,fp,GT.Tab] ;
  module MBC = LineModules[l].Over[R,setR,axioms].At[L,fp,GT.Tbc] ;
  module MAC = LineModules[l].Over[R,setR,axioms].At[L,fp,GT.Tac] ;
  module PJ = Projectors[l].Over[L.ring,L.set] ;
  module MI = PJ.MI ;
  module Mu (wab : GT.DAB.Data) (wbc : GT.DBC.Data) (wac : GT.DAC.Data) {
   module PR = GT.Product[wab,wbc] ;
   hab : PJ.Projector = MAB.Of[wab].projector ;
   hbc : PJ.Projector = MBC.Of[wbc].projector ;
   hac : PJ.Projector = MAC.Of[wac].projector ;
   tensor : PJ.Projector = PJ.Product[hab,hbc].projector ;
   module KR = Kronecker[l].Over[L.ring,L.set,wab.1,wbc.1] ;
   -- the Kronecker product is the projector of the product data
   same : Id KR.MN.Mat (KR.kron MAB.Of[wab].E.entry MBC.Of[wbc].E.entry) MAC.Of[PR.product-data].E.entry =
    KR.MN.mat-eq _ _ (\ x x' -> sym (PR.kronecker x x')) ;
   mu : MI.Iso[PJ.Image[tensor].image,PJ.Image[hac].image] =
    MI.compose PJ.Image[tensor].image MAC.Of[PR.product-data].I.image PJ.Image[hac].image
     PJ.Equal[PR.N,KR.kron MAB.Of[wab].E.entry MBC.Of[wbc].E.entry,MAC.Of[PR.product-data].E.entry,
      tensor.idempotent,MAC.Of[PR.product-data].projector.idempotent,same].iso
     MAC.Compare[PR.product-data,wac].iso ;
  } ;
 } ;
} ;
