-- The closure for the root topology of ETALETOPOLOGY, constructed at level l
-- (no closure is assumed): for P : U l,
--     close P = Cover Top P = || a tower over Top all of whose points give ||P|| ||
-- (TOWERS).
--  (proposition)  a truncation.
--  (inc)          the empty tower.
--  (modal)        FLATTENING.Sheaf: Cover Top P is a sheaf (Z-choice and the
--                 flattening of a tower over Root f, TOWERGLOBALISE).
--  (elim)         into a sheaf proposition Q at any level: TOWERDESCENT.
--  (lex)          the sheaves of U l form a sheaf (CLOSURELEX).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module TW = Towers[l].Over[R,setR] ;
 module FS = Flattening[l].Sheaf[R,setR,axioms] ;
 close (A : U l) : U l = TW.Cover Top (\ v -> A) ;
 proposition (A : U l) : Pr.isProp (close A) = FS.At[A].prop ;
 modal (A : U l) : ET.T.isModal @l (close A) = FS.At[A].sheaf ;
 inc (A : U l) (a : A) : close A = FS.At[A].empty a ;
 -- (elim)
 elim : [k] (A : U l) (Q : U k) -> Prelude[k].isProp Q -> ET.T.isModal @k Q -> (A -> Q) -> close A -> Q = <k> \ A Q pQ mQ f c ->
  Tr.Trunc[TW.Witness Top (\ v -> A)].induction @k (\ t -> Q) (\ t -> pQ)
   (\ w -> TowerDescent[l,k].Over[R,setR].At[Q,pQ,mQ].descend w.1 Top w.2.1
     (\ z -> Tr.Trunc[A].induction @k (\ t -> Q) (\ t -> pQ) f (w.2.2 z)) tt) c ;
 module CL = ClosureLex[l].Over[ET.I,ET.G,ET.G-prop] ;
 ops : SheafClosure[l,l].Over[ET.I,ET.G].Ops = new SheafClosure[l,l].Over[ET.I,ET.G].Ops[close,proposition,modal,inc,elim,CL.lex] ;
} ;
#fails {
 -- elim needs a sheaf: ||A|| is a proposition but not a sheaf, so close A
 -- does not give ||A||
 truncation (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (A : U l)
  (c : Over[R,setR,axioms].close A) : Tr.Trunc[A].carrier =
  Over[R,setR,axioms].elim @l A Tr.Trunc[A].carrier Tr.Trunc[A].proposition (\ i -> Tr.Trunc[A].proposition) Tr.Trunc[A].inc c ;
} ;
