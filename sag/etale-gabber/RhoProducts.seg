-- rho is multiplicative (gabber-recollement, Proposition `correct`:
-- rho(P(V' (x) S)) = rho(P(V')) rho(S)^n).  Over a ring T with K = T (x) Q
-- (RATIONAL), rho a s = a/s for s a positive integer.
--  (law)     s (a/s) = a, since s s^-1 = 1.
--  (unique)  s c = a gives c = c (s s^-1) = (s c) s^-1 = a/s.  In particular
--            a/s depends on s only, not on the proof that s is positive.
--  (product) (s t)((u/s)(v/t)) = (s (u/s))(t (v/t)) = u v, so
--            (u v)/(s t) = (u/s)(v/t).
--  (power)   u^k/s^k = (u/s)^k, by (product) k times.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (T : CRing) {
 module RQ = Rational[l].Over[T] ;
 module LQ = RL[RQ.K] ;
 module PT = AffinePowers[l].Over[T] ;
 module PQ = AffinePowers[l].Over[RQ.K] ;
 iota (a : T.R) : RQ.K.R = RQ.iota.1 a ;
 -- (law)
 law (a s : T.R) (hs : RQ.Positive s) : Id RQ.K.R (RQ.K.mul (iota s) (RQ.rho a s hs)) (iota a) =
  calc RQ.K.R { RQ.K.mul (iota s) (RQ.K.mul (iota a) (RQ.inverse s hs))
    =< LQ.mul-swap (iota s) (iota a) (RQ.inverse s hs) > RQ.K.mul (iota a) (RQ.K.mul (iota s) (RQ.inverse s hs))
    =< ap (RQ.K.mul (iota a)) (RQ.inverse-law s hs) > RQ.K.mul (iota a) RQ.K.o
    =< RQ.K.mulO (iota a) > iota a } ;
 -- (unique)
 unique (a s : T.R) (hs : RQ.Positive s) (c : RQ.K.R) (h : Id RQ.K.R (RQ.K.mul (iota s) c) (iota a)) :
  Id RQ.K.R c (RQ.rho a s hs) =
  calc RQ.K.R { c
    =< sym (RQ.K.mulO c) > RQ.K.mul c RQ.K.o
    =< ap (RQ.K.mul c) (sym (RQ.inverse-law s hs)) > RQ.K.mul c (RQ.K.mul (iota s) (RQ.inverse s hs))
    =< RQ.K.mulA c (iota s) (RQ.inverse s hs) > RQ.K.mul (RQ.K.mul c (iota s)) (RQ.inverse s hs)
    =< ap (\ t -> RQ.K.mul t (RQ.inverse s hs)) (trans (RQ.K.mulC c (iota s)) h) > RQ.rho a s hs } ;
 respect (a s s' : T.R) (hs : RQ.Positive s) (hs' : RQ.Positive s') (e : Id T.R s s') :
  Id RQ.K.R (RQ.rho a s hs) (RQ.rho a s' hs') =
  unique a s' hs' (RQ.rho a s hs) (trans (ap (\ t -> RQ.K.mul (iota t) (RQ.rho a s hs)) (sym e)) (law a s hs)) ;
 -- (product)
 product (u v s t : T.R) (hs : RQ.Positive s) (ht : RQ.Positive t) :
  Id RQ.K.R (RQ.rho (T.mul u v) (T.mul s t) (RQ.positive-product s t hs ht)) (RQ.K.mul (RQ.rho u s hs) (RQ.rho v t ht)) =
  sym (unique (T.mul u v) (T.mul s t) (RQ.positive-product s t hs ht) (RQ.K.mul (RQ.rho u s hs) (RQ.rho v t ht))
   (calc RQ.K.R { RQ.K.mul (iota (T.mul s t)) (RQ.K.mul (RQ.rho u s hs) (RQ.rho v t ht))
     =< ap (\ w -> RQ.K.mul w (RQ.K.mul (RQ.rho u s hs) (RQ.rho v t ht))) (RQ.iota.2.2.2 s t) >
        RQ.K.mul (RQ.K.mul (iota s) (iota t)) (RQ.K.mul (RQ.rho u s hs) (RQ.rho v t ht))
     =< LQ.mul-four (iota s) (iota t) (RQ.rho u s hs) (RQ.rho v t ht) >
        RQ.K.mul (RQ.K.mul (iota s) (RQ.rho u s hs)) (RQ.K.mul (iota t) (RQ.rho v t ht))
     =< cong2 RQ.K.R RQ.K.mul _ _ _ _ (law u s hs) (law v t ht) > RQ.K.mul (iota u) (iota v)
     =< sym (RQ.iota.2.2.2 u v) > iota (T.mul u v) })) ;
 -- (power)
 positive-power (s : T.R) (hs : RQ.Positive s) : (k : Nat) -> RQ.Positive (PT.power s k) = split {
  zero -> RQ.positive-one ;
  suc k | h -> RQ.positive-product s (PT.power s k) hs h } ;
 one : Id RQ.K.R (RQ.rho T.o T.o RQ.positive-one) RQ.K.o =
  sym (unique T.o T.o RQ.positive-one RQ.K.o (trans (RQ.K.mulO (iota T.o)) (refl (iota T.o)))) ;
 power (u s : T.R) (hs : RQ.Positive s) : (k : Nat) ->
  Id RQ.K.R (RQ.rho (PT.power u k) (PT.power s k) (positive-power s hs k)) (PQ.power (RQ.rho u s hs) k) = split {
  zero -> one ;
  suc k | h -> trans (product u (PT.power u k) s (PT.power s k) hs (positive-power s hs k))
   (ap (RQ.K.mul (RQ.rho u s hs)) h) } ;
} ;
