-- Finite sums for the module gluing arguments (Serre note, Section 3).
-- Sum the last coordinate and the remaining coordinates recursively.
-- Addition and scalar multiplication commute with sums by distributivity.
-- In particular a scalar partition of one acts as the identity, including
-- the empty partition over the zero ring.  Semilinear maps preserve sums.
level l ; open Ring[l] ; open Presentations[l] ;
module SM = SerreModule[l] ;
module Over (A : CRing) (Md : SM.Over[A].Module) {
 open Md ; module ML = SM.Over[A].Laws[Md] ;
 module RS = FiniteIdeal[l].Sums[A] ;
 sum : (n : Nat) -> (Fin n -> M) -> M = split {
  zero -> \ xs -> mz ;
  suc n | ih -> \ xs -> madd (xs (inr tt)) (ih (\ i -> xs (inl i))) } ;
 sum-empty (xs : Fin zero -> M) : Id M (sum zero xs) mz = refl mz ;
 sum-step (n : Nat) (xs : Fin (suc n) -> M) :
  Id M (sum (suc n) xs) (madd (xs (inr tt)) (sum n (\ i -> xs (inl i)))) =
  refl (madd (xs (inr tt)) (sum n (\ i -> xs (inl i)))) ;
 sum-cong : (n : Nat) (xs ys : Fin n -> M) -> ((i : Fin n) -> Id M (xs i) (ys i)) ->
  Id M (sum n xs) (sum n ys) = split {
  zero -> \ xs ys h -> refl mz ;
  suc n | ih -> \ xs ys h -> cong2 M madd _ _ _ _ (h (inr tt))
   (ih (\ i -> xs (inl i)) (\ i -> ys (inl i)) (\ i -> h (inl i))) } ;
 sum-zero : (n : Nat) -> Id M (sum n (\ i -> mz)) mz = split {
  zero -> refl mz ;
  suc n | ih -> trans (ap (madd mz) ih) (maddZ mz) } ;
 interchange (a b c d : M) : Id M (madd (madd a b) (madd c d)) (madd (madd a c) (madd b d)) =
  calc M {
   madd (madd a b) (madd c d)
    =< sym (maddA a b (madd c d)) > madd a (madd b (madd c d))
    =< ap (madd a) (maddA b c d) > madd a (madd (madd b c) d)
    =< ap (\ t -> madd a (madd t d)) (maddC b c) > madd a (madd (madd c b) d)
    =< ap (madd a) (sym (maddA c b d)) > madd a (madd c (madd b d))
    =< maddA a c (madd b d) > madd (madd a c) (madd b d) } ;
 sum-add : (n : Nat) (xs ys : Fin n -> M) ->
  Id M (sum n (\ i -> madd (xs i) (ys i))) (madd (sum n xs) (sum n ys)) = split {
  zero -> \ xs ys -> sym (maddZ mz) ;
  suc n | ih -> \ xs ys ->
   trans (ap (madd (madd (xs (inr tt)) (ys (inr tt))))
    (ih (\ i -> xs (inl i)) (\ i -> ys (inl i))))
    (interchange (xs (inr tt)) (ys (inr tt)) (sum n (\ i -> xs (inl i))) (sum n (\ i -> ys (inl i)))) } ;
 sum-scale (a : A.R) : (n : Nat) (xs : Fin n -> M) ->
  Id M (sum n (\ i -> sm a (xs i))) (sm a (sum n xs)) = split {
  zero -> \ xs -> sym (ML.sm-zero a) ;
  suc n | ih -> \ xs -> trans (ap (madd (sm a (xs (inr tt)))) (ih (\ i -> xs (inl i))))
   (sym (smD a (xs (inr tt)) (sum n (\ i -> xs (inl i))))) } ;
 sum-scalars : (n : Nat) (as : Fin n -> A.R) (x : M) ->
  Id M (sum n (\ i -> sm (as i) x)) (sm (RS.sum n as) x) = split {
  zero -> \ as x -> sym (ML.zero-sm x) ;
  suc n | ih -> \ as x -> trans (ap (madd (sm (as (inr tt)) x)) (ih (\ i -> as (inl i)) x))
   (sym (smE (as (inr tt)) (RS.sum n (\ i -> as (inl i))) x)) } ;
 partition (n : Nat) (as : Fin n -> A.R) (one : Id A.R (RS.sum n as) A.o) (x : M) :
  Id M (sum n (\ i -> sm (as i) x)) x =
  trans (sum-scalars n as x) (trans (ap (\ a -> sm a x) one) (smO x)) ;
 partition-zero (n : Nat) (as : Fin n -> A.R) (one : Id A.R (RS.sum n as) A.o)
  (x : M) (kills : (i : Fin n) -> Id M (sm (as i) x) mz) : Id M x mz =
  trans (sym (partition n as one x))
   (trans (sum-cong n (\ i -> sm (as i) x) (\ i -> mz) kills) (sum-zero n)) ;
 opaque sum ;
} ;
module Map (A B : CRing) (h : RingHom[l].Hom A B)
 (Md : SM.Over[A].Module) (Nd : SM.Over[B].Module)
 (f : SerreModuleMaps[l].Between[A,B,h,Md,Nd].Hom) {
 module H = SerreModuleMaps[l].Between[A,B,h,Md,Nd] ;
 module S = Over[A,Md] ; module T = Over[B,Nd] ;
 sum-map : (n : Nat) (xs : Fin n -> Md.M) ->
  Id Nd.M (H.map f (S.sum n xs)) (T.sum n (\ i -> H.map f (xs i))) = split {
  zero -> \ xs -> trans (ap (H.map f) (S.sum-empty xs))
   (trans (H.map-zero f) (sym (T.sum-empty (\ i -> H.map f (xs i))))) ;
  suc n | ih -> \ xs ->
   trans (ap (H.map f) (S.sum-step n xs))
    (trans (H.map-add f (xs (inr tt)) (S.sum n (\ i -> xs (inl i))))
     (trans (ap (Nd.madd (H.map f (xs (inr tt)))) (ih (\ i -> xs (inl i))))
      (sym (T.sum-step n (\ i -> H.map f (xs i)))))) } ;
} ;
