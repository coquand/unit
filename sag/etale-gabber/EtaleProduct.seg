-- The rectangular sum formula with arbitrary coefficients on the enumeration.
level l ; open Ring[l] ; open Presentations[l] ;
module FP = FiniteProduct[l] ;
module FS = FinSum[l] ;
module Over (R : CRing) {
 module S = FiniteIdeal[l].Sums[R] ;
 module PS = FP.Sums[R] ;
 rectangular : (n m : Nat) (f : FP.Pair n m -> R.R) (c : Fin (FP.size n m) -> R.R) ->
  Id R.R (S.sum (FP.size n m) (\ u -> R.mul (f (FP.decode n m u)) (c u)))
   (S.sum n (\ a -> S.sum m (\ b -> R.mul (f (a,b)) (c (FP.encode n m a b))))) = split {
  zero -> \ m f c -> refl R.z ;
  suc n | ih -> \ m f c ->
   trans (PS.split-sum (FP.size n m) m (\ u -> R.mul (f (FP.decode (suc n) m u)) (c u)))
    (cong2 R.R R.add _ _ _ _
     (S.sum-cong m
      (\ b -> R.mul (f (FP.decode (suc n) m (FS.right (FP.size n m) m b))) (c (FS.right (FP.size n m) m b)))
      (\ b -> R.mul (f (inr tt,b)) (c (FS.right (FP.size n m) m b))) (\ b -> ap (\ p -> R.mul (f p) (c (FS.right (FP.size n m) m b)))
       (FS.cases-right (FP.size n m) (FP.Pair (suc n) m)
        (\ u -> (inl (FP.decode n m u).1,(FP.decode n m u).2)) m (\ b -> (inr tt,b)) b)))
     (trans (S.sum-cong (FP.size n m)
       (\ u -> R.mul (f (FP.decode (suc n) m (FS.left (FP.size n m) m u))) (c (FS.left (FP.size n m) m u)))
       (\ u -> R.mul (f (inl (FP.decode n m u).1,(FP.decode n m u).2)) (c (FS.left (FP.size n m) m u)))
       (\ u -> ap (\ p -> R.mul (f p) (c (FS.left (FP.size n m) m u)))
        (FS.cases-left (FP.size n m) (FP.Pair (suc n) m)
         (\ u -> (inl (FP.decode n m u).1,(FP.decode n m u).2)) m (\ b -> (inr tt,b)) u)))
      (ih m (\ p -> f (inl p.1,p.2)) (\ u -> c (FS.left (FP.size n m) m u))))) } ;
} ;
