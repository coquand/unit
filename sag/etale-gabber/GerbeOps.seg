-- Operations on stack gerbes (C3): the dual, pull-back of line families,
-- evaluation, the trivial gerbe.  A stack gerbe G is a charged type with its
-- band as character (merely connected by HILBERT90): char G.
--  (dual)    D G = the line families of weight beta on G (LINEGERBE); at s,
--            the twisted line Line(s = -) (TWISTEDLINE) is one.
--  (pull)    phi : X -> Y with w_Y(ap phi p) = w_X(p) gives L |-> L . phi on line
--            families; transport along p in L . phi is transport along ap phi p
--            in L (J), so the weight is kept, and idToIso of ap (pull . j) at x
--            is idToIso of ap j at phi x (J): the scalar of a loop is kept
--            (LINEGERBE.Into).  So the two stack gerbes are equal (GERBEMAPS.Map).
--  (ev)      For a charged type C and K its stack gerbe, x |-> (a |-> (j a) x) is a
--            line family on K of weight beta_K (transport along a loop of K is
--            idToIso of ap j, the scalar beta_K), so a point ev x of D K; along a
--            loop p of X it acts by transport in the family x |-> (j a) x, i.e.
--            by w(p): ev carries w to the band of D K.
--  (trivial) T = the line families on the point (weight 1, i.e. lines), with
--            the object R.  A stack gerbe K with a point k is T: x |-> Line(k = x)
--            is a line, and transport along a loop q of K acts by beta(q)
--            (TWISTEDLINE.weight), so the map K -> T keeps the bands.  D T has the
--            point ev tt, so D T = T.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module BC = BandChange[l].Over[R,setR,axioms,sh] ;
 module GM = GerbeMaps[l].Over[R,setR,axioms,sh] ;
 module LG = LineGerbe[l].Over[R,setR,axioms,loc,sh] ;
 module SG = GM.SG ;
 module TN = TwistedMain[l].Over[R,setR,axioms,loc] ;
 -- a stack gerbe as a TGerbe, and its character
 tg (G : SG.StackGerbe) : TG.TGerbe = new TG.TGerbe[G.1,SG.gpd G,SG.inh G,SG.conn G,SG.paths G,SG.band G] ;
 connected (G : SG.StackGerbe) (a b : G.1) : Tr.Trunc[Id G.1 a b].carrier = TG.At[tg G].connected a b ;
 char (G : SG.StackGerbe) : BC.Char = ((G.1,connected G,SG.bnd G),SG.inh G) ;
 -- (dual)
 module Line (G : SG.StackGerbe) (s : G.1) {
  AG : TM.GB.AGerbe = (G.1,SG.gpd G,Tr.Trunc[G.1].inc s,connected G,SG.band G) ;
  module TL = TwistedLine[l].Over[R,setR].At[AG,s] ;
  object : BC.At[char G].Obj = (TL.line,TL.weight,\ g -> TN.LineBasis[AG,s].basis g) ;
 } ;
 dual (G : SG.StackGerbe) : SG.StackGerbe = LG.At[char G,\ s -> Line[G,s].object].gerbe ;
 -- (pull)
 module Pull (C D : BC.Char) (phi : C.1.1 -> D.1.1)
  (compat : (x : C.1.1) (p : Id C.1.1 x x) -> Id UG.Unit (D.1.2.2 (phi x) (Pr.ap C.1.1 D.1.1 phi x x p)) (C.1.2.2 x p)) {
  module BCC = BC.At[C] ;
  module BCD = BC.At[D] ;
  X : U l = C.1.1 ;
  move-ap (V : D.1.1 -> MD.Module) (y y' : X) (p : Id X y y') (m : (V (phi y)).M) :
   Id (V (phi y')).M (BCC.T.Move[\ x -> V (phi x)].move y y' p m) (BCD.T.Move[V].move (phi y) (phi y') (Pr.ap X D.1.1 phi y y' p) m) =
   idJ X y (\ z q -> Id (V (phi z)).M (BCC.T.Move[\ x -> V (phi x)].move y z q m) (BCD.T.Move[V].move (phi y) (phi z) (Pr.ap X D.1.1 phi y z q) m))
    (refl m) y' p ;
  pull (L : BCD.Obj) : BCC.Obj =
   (\ x -> L.1 (phi x),
    \ y p m -> trans (move-ap L.1 y y p m) (trans (L.2.1 (phi y) (Pr.ap X D.1.1 phi y y p) m) (ap (\ u -> (L.1 (phi y)).sm u.1 m) (compat y p))),
    \ x -> L.2.2 (phi x)) ;
  module With (ptC : X -> BCC.Obj) (ptD : D.1.1 -> BCD.Obj) {
   module LC = LG.At[C,ptC] ;
   module LD = LG.At[D,ptD] ;
   iso-pull (a a' : LD.S.Small) (p : Id LD.S.Small a a') (x : X) (m : ((LD.S.j a).1 (phi x)).M) :
    Id ((LD.S.j a').1 (phi x)).M
     ((BCC.Fd.idToIso (pull (LD.S.j a)) (pull (LD.S.j a')) (Hi.ap LD.S.Small BCC.Obj (\ b -> pull (LD.S.j b)) a a' p) x).1.1 m)
     ((BCD.Fd.idToIso (LD.S.j a) (LD.S.j a') (Hi.ap LD.S.Small BCD.Obj LD.S.j a a' p) (phi x)).1.1 m) =
    idJ LD.S.Small a (\ b q -> Id ((LD.S.j b).1 (phi x)).M
      ((BCC.Fd.idToIso (pull (LD.S.j a)) (pull (LD.S.j b)) (Hi.ap LD.S.Small BCC.Obj (\ c -> pull (LD.S.j c)) a b q) x).1.1 m)
      ((BCD.Fd.idToIso (LD.S.j a) (LD.S.j b) (Hi.ap LD.S.Small BCD.Obj LD.S.j a b q) (phi x)).1.1 m)) (refl m) a' p ;
   module I = LC.Into[LD.S.Small,\ a -> pull (LD.S.j a),LD.S.bnd,
    \ a p x m -> trans (iso-pull a a p x m) (BCD.Loops[LD.S.j a].law (Hi.ap LD.S.Small BCD.Obj LD.S.j a a p) (phi x) m)] ;
   theorem : Id SG.StackGerbe LD.gerbe LC.gerbe = GM.Map[LD.gerbe,LC.gerbe,I.map,I.preserves].theorem ;
  } ;
 } ;
 -- (ev)
 module Eval (C : BC.Char) (pt : C.1.1 -> BC.At[C].Obj) {
  module K = LG.At[C,pt] ;
  X : U l = C.1.1 ;
  module DK = LG.At[char K.gerbe,\ s -> Line[K.gerbe,s].object] ;
  move-j (x : X) (a a' : K.S.Small) (q : Id K.S.Small a a') (m : ((K.S.j a).1 x).M) :
   Id ((K.S.j a').1 x).M (DK.T.Move[\ b -> (K.S.j b).1 x].move a a' q m)
    ((K.B.Fd.idToIso (K.S.j a) (K.S.j a') (Hi.ap K.S.Small K.B.Obj K.S.j a a' q) x).1.1 m) =
   idJ K.S.Small a (\ b q2 -> Id ((K.S.j b).1 x).M (DK.T.Move[\ c -> (K.S.j c).1 x].move a b q2 m)
     ((K.B.Fd.idToIso (K.S.j a) (K.S.j b) (Hi.ap K.S.Small K.B.Obj K.S.j a b q2) x).1.1 m)) (refl m) a' q ;
  EV (x : X) : DK.B.Obj =
   (\ a -> (K.S.j a).1 x,
    \ a q m -> trans (move-j x a a q m) (K.B.Loops[K.S.j a].law (Hi.ap K.S.Small K.B.Obj K.S.j a a q) x m),
    \ a -> (K.S.j a).2.2 x) ;
  iso-ev (x x' : X) (p : Id X x x') (a : K.S.Small) (m : ((K.S.j a).1 x).M) :
   Id ((K.S.j a).1 x').M ((DK.B.Fd.idToIso (EV x) (EV x') (Hi.ap X DK.B.Obj EV x x' p) a).1.1 m) (K.T.Move[(K.S.j a).1].move x x' p m) =
   idJ X x (\ z q -> Id ((K.S.j a).1 z).M ((DK.B.Fd.idToIso (EV x) (EV z) (Hi.ap X DK.B.Obj EV x z q) a).1.1 m) (K.T.Move[(K.S.j a).1].move x z q m))
    (refl m) x' p ;
  module I = DK.Into[X,EV,C.1.2.2,\ x p a m -> trans (iso-ev x x p a m) ((K.S.j a).2.1 x p m)] ;
  ev (x : X) : DK.S.Small = I.map x ;
  ev-bnd (x : X) (p : Id X x x) : Id UG.Unit (SG.bnd DK.gerbe (ev x) (Pr.ap X DK.S.Small ev x x p)) (C.1.2.2 x p) = I.preserves x p ;
  #fails {
   -- ev carries w to the band, not to its inverse
   ev-inverse (x : X) (p : Id X x x) : Id UG.Unit (SG.bnd DK.gerbe (ev x) (Pr.ap X DK.S.Small ev x x p)) (UG.inverse (C.1.2.2 x p)) = I.preserves x p ;
  } ;
 } ;
 -- D (D G) = G
 module DoubleDual (G : SG.StackGerbe) {
  module E = Eval[char G,\ s -> Line[G,s].object] ;
  theorem : Id SG.StackGerbe G (dual (dual G)) = GM.Map[G,dual (dual G),E.ev,E.ev-bnd].theorem ;
 } ;
 -- (trivial)
 top-char : BC.Char = ((Top,\ a b -> Tr.Trunc[Id Top a b].inc (FinSum[l].top-prop a b),\ a p -> UG.one),sh.inc Top tt) ;
 const-move (M : MD.Module) (a a' : Top) (p : Id Top a a') (m : M.M) : Id M.M (Pr.subst Top (\ t -> M.M) a a' p m) m =
  idJ Top a (\ b q -> Id M.M (Pr.subst Top (\ t -> M.M) a b q m) m) (refl m) a' p ;
 constant (M : MD.Module) (b : LG.Basis1 M) : BC.At[top-char].Obj =
  (\ t -> M,\ a p m -> trans (const-move M a a p m) (sym (M.smO m)),\ t -> b) ;
 reg : BC.At[top-char].Obj = constant MD.regular (Tr.Trunc[LF.Basis[MD.regular,suc zero]].inc TN.regular-basis) ;
 module LT = LG.At[top-char,\ t -> reg] ;
 trivial : SG.StackGerbe = LT.gerbe ;
 base : trivial.1 = LT.S.inv reg ;
 -- a stack gerbe with a point is trivial
 module Pointed (K : SG.StackGerbe) (k : K.1) {
  module L = Line[K,k] ;
  EV (x : K.1) : LT.B.Obj = constant (L.TL.line x) (TN.LineBasis[L.AG,k].basis x) ;
  iso (x x' : K.1) (p : Id K.1 x x') (t : Top) (m : (L.TL.line x).M) :
   Id (L.TL.line x').M ((LT.B.Fd.idToIso (EV x) (EV x') (Hi.ap K.1 LT.B.Obj EV x x' p) t).1.1 m) (L.TL.MV.move x x' p m) =
   idJ K.1 x (\ z q -> Id (L.TL.line z).M ((LT.B.Fd.idToIso (EV x) (EV z) (Hi.ap K.1 LT.B.Obj EV x z q) t).1.1 m) (L.TL.MV.move x z q m))
    (refl m) x' p ;
  module I = LT.Into[K.1,EV,SG.bnd K,\ x p t m -> trans (iso x x p t m) (L.TL.weight x p m)] ;
  theorem : Id SG.StackGerbe K trivial = GM.Map[K,trivial,I.map,I.preserves].theorem ;
 } ;
 dual-trivial : Id SG.StackGerbe (dual trivial) trivial = Pointed[dual trivial,Eval[top-char,\ t -> reg].ev tt].theorem ;
} ;
