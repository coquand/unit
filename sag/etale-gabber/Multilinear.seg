-- Multilinear maps, and P(V)^v without tensor products (gabber-recollement:
-- P(V) = V^(x)n (x) Lambda^-1, so P(V)^v = Hom(V^(x)n, Lambda) is the module
-- of n-linear maps V^n -> Lambda).  A (k+1)-linear map is a linear map from
-- V to k-linear maps, so
--     power P L 0 = L,     power P L (k+1) = Hom(P, power P L k)   (HOMMODULE).
--  (frames) If P has a frame of rank r and L one of rank s (FRAMES), then
--           power P L k has one of rank r^k s:  rank 0 = s,
--           rank (k+1) = r (rank k), by HOMFRAMES k times.
--  (weight) Over a gerbe, let V have weight chi and L weight psi
--           (TWISTEDMODULES).  Then power V L k has weight psi/chi^k:
--           weight-of 0 = psi, weight-of (k+1) = (weight-of k)/chi, by
--           Homs.Weights k times.  For V twisted (chi a = a) and L of
--           weight n (psi a = a^n): (weight-of k) a . a^k = a^n by induction
--           on k, so weight-of n a = 1 and P(V)^v = power V L n has weight 0.
--  (descent) P(V)^v then descends, and its descended family is framed of
--           rank r^n s (TWISTEDFRAMES.descend-frames).
--  (affine) On X = Spec Alg, AFFINEFRAMEPROJECTOR gives merely a projector
--           over Alg whose image is the global sections of the descended
--           P(V)^v.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module HF = HomFrames[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 power (P L : MD.Module) : Nat -> MD.Module = split {
  zero -> L ;
  suc k | q -> HomModule[l].Over[R,setR].At[P,q].carrier } ;
 -- (frames)
 rank (r s : Nat) : Nat -> Nat = split { zero -> s ; suc k | q -> Pairing[l].times r q } ;
 frames (P L : MD.Module) (r s : Nat) (fp : Tr.Trunc[FR.Frame[P,r]].carrier) (fl : Tr.Trunc[FR.Frame[L,s]].carrier) :
  (k : Nat) -> Tr.Trunc[FR.Frame[power P L k,rank r s k]].carrier = split {
  zero -> fl ;
  suc k | f -> HF.hom-frames P (power P L k) r (rank r s k) fp f } ;
 -- (weight)
 module At (Gb : TM.GB.AGerbe) {
  module T = TM.At[TM.charge (TM.banded (Gb))] ;
  module Power (V L : T.Y -> MD.Module) (chi psi : UG.Unit -> UG.Unit) (wv : T.Weight chi V) (wl : T.Weight psi L) {
   mult (k : Nat) (y : T.Y) : MD.Module = power (V y) (L y) k ;
   weight-of : Nat -> UG.Unit -> UG.Unit = split {
    zero -> psi ;
    suc k | q -> \ a -> UG.times (q a) (UG.inverse (chi a)) } ;
   weight : (k : Nat) -> T.Weight (weight-of k) (mult k) = split {
    zero -> wl ;
    suc k | w -> T.Homs[V,mult k].Weights[chi,weight-of k,wv,w].weight } ;
  } ;
  -- V twisted, L of weight n
  module Dual (n : Nat) (V L : T.Y -> MD.Module) (wv : T.Weight T.identity V)
   (wl : T.Weight (\ a -> UG.power a n) L) {
   module PW = Power[V,L,T.identity,\ a -> UG.power a n,wv,wl] ;
   -- (a^n / a^(k+1)) . a^(k+1) = (a^n / a^k) . a^k
   step (k : Nat) (a : UG.Unit) :
    Id UG.Unit (UG.times (PW.weight-of (suc k) a) (UG.power a (suc k))) (UG.times (PW.weight-of k a) (UG.power a k)) =
    UG.eq _ _ (calc R.R { R.mul (R.mul (PW.weight-of k a).1 a.2.1) (R.mul a.1 (UG.power a k).1)
      =< ap (\ t -> R.mul t (R.mul a.1 (UG.power a k).1)) (R.mulC (PW.weight-of k a).1 a.2.1) >
         R.mul (R.mul a.2.1 (PW.weight-of k a).1) (R.mul a.1 (UG.power a k).1)
      =< UG.four a.2.1 (PW.weight-of k a).1 a.1 (UG.power a k).1 >
         R.mul (R.mul a.2.1 a.1) (R.mul (PW.weight-of k a).1 (UG.power a k).1)
      =< ap (\ t -> R.mul t (R.mul (PW.weight-of k a).1 (UG.power a k).1)) (trans (R.mulC a.2.1 a.1) a.2.2) >
         R.mul R.o (R.mul (PW.weight-of k a).1 (UG.power a k).1)
      =< RL[R].one-left (R.mul (PW.weight-of k a).1 (UG.power a k).1) >
         R.mul (PW.weight-of k a).1 (UG.power a k).1 }) ;
   balance (a : UG.Unit) : (k : Nat) -> Id UG.Unit (UG.times (PW.weight-of k a) (UG.power a k)) (UG.power a n) = split {
    zero -> UG.unitr (UG.power a n) ;
    suc k | h -> trans (step k a) h } ;
   -- w . p = p gives w = 1
   balanced (a : UG.Unit) : Id UG.Unit (PW.weight-of n a) UG.one =
    calc UG.Unit { PW.weight-of n a
      =< sym (UG.unitr (PW.weight-of n a)) > UG.times (PW.weight-of n a) UG.one
      =< ap (UG.times (PW.weight-of n a)) (sym (UG.invr (UG.power a n))) >
         UG.times (PW.weight-of n a) (UG.times (UG.power a n) (UG.inverse (UG.power a n)))
      =< sym (UG.assoc (PW.weight-of n a) (UG.power a n) (UG.inverse (UG.power a n))) >
         UG.times (UG.times (PW.weight-of n a) (UG.power a n)) (UG.inverse (UG.power a n))
      =< ap (\ u -> UG.times u (UG.inverse (UG.power a n))) (balance a n) >
         UG.times (UG.power a n) (UG.inverse (UG.power a n))
      =< UG.invr (UG.power a n) > UG.one } ;
   -- P(V)^v has weight 0
   weight : T.Weight T.trivial (PW.mult n) = T.retag (PW.weight-of n) T.trivial balanced (PW.mult n) (PW.weight n) ;
  } ;
 } ;
 -- (descent) over a family of gerbes
 module Family (X : U l) (G : X -> TM.GB.AGerbe) {
  module TF = TM.Family[X,G] ;
  module TFr = TwistedFrames[l].Over[R,setR].Family[X,G] ;
  module Dual (n : Nat) (V : TF.Twisted) (L : TF.Weighted (\ a -> UG.power a n)) {
   H (x : X) (g : (G x).1) : MD.Module = power (V.1 x g) (L.1 x g) n ;
   weight-zero : TF.Weighted (\ a -> UG.one) = (H,\ x -> At[G x].Dual[n,V.1 x,L.1 x,V.2 x,L.2 x].weight) ;
   descended (x : X) : MD.Module = TF.descend weight-zero x ;
   descended-frames (r s : Nat) (fv : TFr.Framed V.1 r) (fl : TFr.Framed L.1 s) (x : X) :
    Tr.Trunc[FR.Frame[descended x,rank r s n]].carrier =
    TFr.descend-frames weight-zero (rank r s n) (\ x g -> frames (V.1 x g) (L.1 x g) r s (fv x g) (fl x g) n) x ;
  } ;
 } ;
 -- (affine)
 module OnAffine (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
  (Alg : Algebras[l].Over[R,setR].Algebra) (fp : Presentations[l].Over[R,setR].FP Alg)
  (G : Algebras[l].Over[R,setR].Spec Alg -> TM.GB.AGerbe) {
  module Fam = Family[Algebras[l].Over[R,setR].Spec Alg,G] ;
  module Dual (n : Nat) (V : Fam.TF.Twisted) (L : Fam.TF.Weighted (\ a -> UG.power a n)) (r s : Nat)
   (fv : Fam.TFr.Framed V.1 r) (fl : Fam.TFr.Framed L.1 s) {
   module AP = AffineFrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Fam.Dual[n,V,L].descended,
    rank r s n,Fam.Dual[n,V,L].descended-frames r s fv fl] ;
   theorem : Tr.Trunc[AP.Witness].carrier = AP.theorem ;
  } ;
 } ;
} ;
