-- The two localisations at f agree (../HANDOFF-GABBER-HOMOTOPY.md).  Let
-- Alg[1/f] be a localisation of the R-algebra A at f (AFFINEINTERFACE: a
-- LocalizationWitness, used by GERBELINES), and A_f the quotient ring at the
-- powers of f (MONOIDLOCALIZATION, used by K0RESTRICTION, NILPOTENCE, ROOTS).
--  (algebra)  A_f is an R-algebra by R -> A -> A_f, and f is a unit of A_f.
--  (to)       The universal property of Alg[1/f] gives to : Alg[1/f] -> A_f
--             over A: to (a/1) = a/1.
--  (from)     f is a unit in Alg[1/f], hence so is every power of f, and
--             MONOIDLOCALIZATIONMAP gives from : A_f -> Alg[1/f] over A; it
--             is an R-algebra map since iota factors through A.
--  (unique)   Ring maps h, k out of A_f agreeing on A agree: for x = n/s,
--             h(s) h(x) = h(n) = k(n) = k(s) k(x) = h(s) k(x), and h(s) is a
--             unit.
--  (inverse)  from (to x) = x: both sides are maps out of Alg[1/f] agreeing
--             on A (LOCALIZATIONCOMPARISON.unique); to (from x) = x by (unique).
--  (K_0)      Restriction along a retraction (g f = id) is a retraction of
--             K_0 (K0RESTRICTION.Compose, Pointwise, and restriction along the
--             identity is the identity), so K_0(Alg[1/f]) ~ K_0(A_f) by
--             restriction along to and from (At.KF, At.KT).
--  (shrink)   If t c = s, then A[1/t] -> A[1/s] over A (Shrink).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;

-- (unique)
module Unique (A : CRing) (S : A.R -> U l) (one : S A.o)
 (product : (s t : A.R) -> S s -> S t -> S (A.mul s t))
 (B : CRing) (setB : Pr.isSet B.R) {
 module LX = MonoidLocalization[l].Over[A,S,one,product] ;
 module Reg = Regularity[l].Over[B] ;
 module Agree (h k : H.Hom LX.ring B)
  (agree : (a : A.R) -> Id B.R (h.1 (LX.constant a)) (k.1 (LX.constant a))) {
  -- h(s) is a unit, hence regular
  regular (q : LX.Raw.Fraction) : Reg.Regular (h.1 (LX.constant q.2.1)) =
   Reg.from-kernel (h.1 (LX.constant q.2.1)) (\ a e ->
    RL[B].unit-reg (h.1 (LX.constant q.2.1)) a
     (AffineRing[l].unit-map LX.ring B h (LX.constant q.2.1) (LX.inverse q.2.1 q.2.2)) e) ;
  -- h(s) h(x) = h(n) for x = n/s
  equation (g : H.Hom LX.ring B) (q : LX.Raw.Fraction) :
   Id B.R (B.mul (g.1 (LX.constant q.2.1)) (g.1 (LX.include q))) (g.1 (LX.constant q.1)) =
   trans (sym (g.2.2.2 (LX.constant q.2.1) (LX.include q))) (ap g.1 (LX.fraction-equation q)) ;
  at-fraction (q : LX.Raw.Fraction) : Id B.R (h.1 (LX.include q)) (k.1 (LX.include q)) =
   regular q (h.1 (LX.include q)) (k.1 (LX.include q))
    (calc B.R { B.mul (h.1 (LX.constant q.2.1)) (h.1 (LX.include q))
      =< equation h q > h.1 (LX.constant q.1)
      =< agree q.1 > k.1 (LX.constant q.1)
      =< sym (equation k q) > B.mul (k.1 (LX.constant q.2.1)) (k.1 (LX.include q))
      =< ap (\ t -> B.mul t (k.1 (LX.include q))) (sym (agree q.2.1)) >
         B.mul (h.1 (LX.constant q.2.1)) (k.1 (LX.include q)) }) ;
  at (x : LX.Carrier) : Id B.R (h.1 x) (k.1 x) =
   LX.Q.induction @l (\ y -> Id B.R (h.1 y) (k.1 y)) (\ y -> setB _ _) at-fraction x ;
 } ;
} ;

-- Restriction along the identity is the identity: id(p) has the matrix of
-- p, and a projector rebuilt from its fields has the image of p (Renew:
-- records have no eta, so this is the one step comparing p with new p).
module RestrictIdentity (A : CRing) (setA : Pr.isSet A.R) {
 module RI = K0Restriction[l].Over[A,A,setA,setA,H.identity A] ;
 module PJ = RI.PA ;
 module MI = RI.MA ;
 module Renew (p : PJ.Projector) {
  module IP = PJ.Image[p] ;
  module IN = PJ.Image[new PJ.Projector[p.size,p.matrix,p.idempotent]] ;
  to (x : IN.Carrier) : IP.Carrier = (IN.value x,IN.member x) ;
  from (y : IP.Carrier) : IN.Carrier = (IP.value y,IP.member y) ;
  iso : MI.Iso[IN.image,IP.image] = MI.make IN.image IP.image to from
   (\ x y -> IP.ext (to (IN.add x y)) (IP.add (to x) (to y)) (refl (IN.V.vadd (IN.value x) (IN.value y))))
   (\ a x -> IP.ext (to (IN.scale a x)) (IP.scale a (to x)) (refl (IN.V.vscale a (IN.value x))))
   (\ y -> IP.ext (to (from y)) y (refl (IP.value y)))
   (\ x -> IN.ext (from (to x)) x (refl (IN.value x))) ;
 } ;
 at-class (p : PJ.Projector) : Id RI.KA.K0.R (RI.restrict.1 (RI.KA.class p)) (RI.KA.class p) =
  calc RI.KA.K0.R { RI.restrict.1 (RI.KA.class p)
    =< RI.restrict-class p > RI.KA.class (RI.M.map p)
    =< RI.KA.class-iso (RI.M.map p) (new PJ.Projector[p.size,p.matrix,p.idempotent])
        PJ.Equal[p.size,RI.M.At[p.size].MM.map p.matrix,p.matrix,(RI.M.map p).idempotent,p.idempotent,
         refl p.matrix].iso > RI.KA.class (new PJ.Projector[p.size,p.matrix,p.idempotent])
    =< RI.KA.class-iso (new PJ.Projector[p.size,p.matrix,p.idempotent]) p Renew[p].iso > RI.KA.class p } ;
 theorem (x : RI.KA.K0.R) : Id RI.KA.K0.R (RI.restrict.1 x) x =
  K0Restriction[l].Agree[A,RI.KA.K0,setA,RI.KA.G.set,RI.restrict,H.identity RI.KA.K0,at-class].at x ;
} ;

-- Restriction along maps f : A -> B, g : B -> A with g (f a) = a is a
-- retraction: restrict_g (restrict_f x) = restrict_(g f) x = restrict_id x = x.
module Retraction (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R)
 (f : H.Hom A B) (g : H.Hom B A) (gf : (a : A.R) -> Id A.R (g.1 (f.1 a)) a) {
 module RF = K0Restriction[l].Over[A,B,setA,setB,f] ;
 module RG = K0Restriction[l].Over[B,A,setB,setA,g] ;
 module CO = K0Restriction[l].Compose[A,B,A,setA,setB,setA,f,g] ;
 module PO = K0Restriction[l].Pointwise[A,A,setA,setA,H.compose A B A g f,H.identity A,gf] ;
 module ID = RestrictIdentity[A,setA] ;
 theorem (x : RF.KA.K0.R) : Id RF.KA.K0.R (RG.restrict.1 (RF.restrict.1 x)) x =
  calc RF.KA.K0.R { RG.restrict.1 (RF.restrict.1 x)
    =< CO.theorem x > CO.RH.restrict.1 x
    =< PO.theorem x > ID.RI.restrict.1 x
    =< ID.theorem x > x } ;
} ;

module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 -- (shrink)  If t c = s, then t is a unit in A[1/s], with inverse c/s, so
 -- the universal property of A[1/t] gives A[1/t] -> A[1/s] over A.
 module Shrink (A : C.Algebra) (t c s : A.ring.R) (e : Id A.ring.R (A.ring.mul t c) s)
  (lt : I.LocalizationWitness A t) (ls : I.LocalizationWitness A s) {
  inc : C.Hom A ls.1 = ls.2.2.1 ;
  t-unit : I.Unit ls.1 (inc.1.1 t) =
   (ls.1.ring.mul (inc.1.1 c) ls.2.2.2.1.1,
    calc ls.1.ring.R { ls.1.ring.mul (inc.1.1 t) (ls.1.ring.mul (inc.1.1 c) ls.2.2.2.1.1)
      =< ls.1.ring.mulA (inc.1.1 t) (inc.1.1 c) ls.2.2.2.1.1 >
         ls.1.ring.mul (ls.1.ring.mul (inc.1.1 t) (inc.1.1 c)) ls.2.2.2.1.1
      =< ap (\ x -> ls.1.ring.mul x ls.2.2.2.1.1) (trans (sym (inc.1.2.2.2 t c)) (ap inc.1.1 e)) >
         ls.1.ring.mul (inc.1.1 s) ls.2.2.2.1.1
      =< ls.2.2.2.1.2 > ls.1.ring.o }) ;
  map : C.Hom lt.1 ls.1 = (lt.2.2.2.2 ls.1).sec (inc,t-unit) ;
  beta (a : A.ring.R) : Id ls.1.ring.R (map.1.1 (lt.2.2.1.1.1 a)) (inc.1.1 a) =
   Pr.ap (I.LocalData A ls.1 t) ls.1.ring.R (\ d -> d.1.1.1 a) _ _
    ((lt.2.2.2.2 ls.1).sec-eq (inc,t-unit)) ;
 } ;
 module At (A : C.Algebra) (f : A.ring.R) (loc : I.LocalizationWitness A f) {
  L : C.Algebra = loc.1 ;
  inc : C.Hom A L = loc.2.2.1 ;
  module PW = Localisations[l].Over[A.ring] ;
  module LX = MonoidLocalization[l].Over[A.ring,PW.Powers f,PW.powers-one f,PW.powers-product f] ;
  -- (algebra)
  algebra : C.Algebra = C.mkAlgebra LX.ring LX.set (H.compose R A.ring LX.ring LX.inclusion A.iota) ;
  incl : C.Hom A algebra = (LX.inclusion,\ r -> refl (LX.constant (A.iota.1 r))) ;
  f-unit : I.Unit algebra (incl.1.1 f) = LX.inverse f (suc zero,A.ring.mulO f) ;
  -- (to)
  to : C.Hom L algebra = (loc.2.2.2.2 algebra).sec (incl,f-unit) ;
  to-beta (a : A.ring.R) : Id LX.Carrier (to.1.1 (inc.1.1 a)) (LX.constant a) =
   Pr.ap (I.LocalData A algebra f) LX.Carrier (\ d -> d.1.1.1 a) _ _
    ((loc.2.2.2.2 algebra).sec-eq (incl,f-unit)) ;
  -- (from)
  power-unit (k : Nat) : RL[L.ring].unit (inc.1.1 (PW.PA.power f k)) =
   subst (\ t -> RL[L.ring].unit t) (sym (AffinePowers[l].power-map A.ring L.ring inc.1 f k))
    (AffinePowers[l].Over[L.ring].Units[L.set].power-unit (inc.1.1 f) loc.2.2.2.1 k) ;
  units (s : A.ring.R) (hs : PW.Powers f s) : RL[L.ring].unit (inc.1.1 s) =
   subst (\ t -> RL[L.ring].unit (inc.1.1 t)) hs.2 (power-unit hs.1) ;
  module J = MonoidLocalizationMap[l].Over[A.ring,PW.Powers f,PW.powers-one f,PW.powers-product f,
   L.ring,L.set,inc.1,units] ;
  from : C.Hom algebra L = (J.hom,\ r -> trans (J.constants (A.iota.1 r)) (inc.2 r)) ;
  from-beta (a : A.ring.R) : Id L.ring.R (from.1.1 (LX.constant a)) (inc.1.1 a) = J.constants a ;
  -- (inverse)
  from-to : Id (C.Hom L L) (C.compose L algebra L from to) (C.identity L) =
   LocalizationComparison[l].Over[R,setR,A,f,loc,loc].unique loc L _ _ (\ a ->
    trans (ap from.1.1 (to-beta a)) (from-beta a)) ;
  module UQ = Unique[A.ring,PW.Powers f,PW.powers-one f,PW.powers-product f,LX.ring,LX.set] ;
  to-from (x : LX.Carrier) : Id LX.Carrier (to.1.1 (from.1.1 x)) x =
   UQ.Agree[H.compose LX.ring L.ring LX.ring to.1 from.1,H.identity LX.ring,\ a ->
    trans (ap to.1.1 (from-beta a)) (to-beta a)].at x ;
  from-to-at (y : L.ring.R) : Id L.ring.R (from.1.1 (to.1.1 y)) y =
   ap (\ g -> g.1.1 y) from-to ;
  -- K_0(Alg[1/f]) ~ K_0(A_f) by restriction along to and from
  module KF = Retraction[L.ring,LX.ring,L.set,LX.set,to.1,from.1,from-to-at] ;
  module KT = Retraction[LX.ring,L.ring,LX.set,L.set,from.1,to.1,to-from] ;
 } ;
} ;
