-- Structure identity for NCAlgebra: an algebra isomorphism A ~ B gives
-- A = B.  As in ModuleSIP, an algebra is its carrier, the data (zero, +,
-- -, scaling, one, product) and propositions (set, laws).  The type
-- (B : Alg) * AlgIso A B is contractible: by induction on equivalences
-- (univalence) the bijection may be taken to be the identity; then +,
-- scaling, product and one agree by the hypotheses, zero and negation are
-- determined by +, and the laws and the hypotheses are propositions.
-- sip is the first projection of the contraction.  Characterisation:
-- sip (idIso A) = refl, and sip is inverse to idToIso (so Id Alg A B is
-- AlgIso A B).  pth and sip are locked after these lemmas.
level l ; open Base ; open Prelude[l] ;
module Hi = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module CT = FunExtUA[l+] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R) {
 open AlgSIP[l].Over[R,setR] ;
 -- the contraction, for A = mk M t
 module Core (M : U l) (t : At[M].Str) {
  A0 : Alg = At[M].mk t ;
  -- the identity is a homomorphism to mk M t': the data agree
  module Same (t' : At[M].Str) (h : Hom A0 (At[M].mk t') (\ x -> x)) {
   B1 : Alg = At[M].mk t' ;
   zero-eq : Id M A0.zero B1.zero = calc M {
    A0.zero =< sym M _ _ (B1.addZ A0.zero) > B1.add A0.zero B1.zero
     =< sym M _ _ (h.1 A0.zero B1.zero) > A0.add A0.zero B1.zero
     =< A0.addC A0.zero B1.zero > A0.add B1.zero A0.zero
     =< A0.addZ B1.zero > B1.zero } ;
   inv0 (x : M) : Id M (B1.add x (A0.neg x)) B1.zero = calc M {
    B1.add x (A0.neg x) =< sym M _ _ (h.1 x (A0.neg x)) > A0.add x (A0.neg x)
     =< A0.addN x > A0.zero =< zero-eq > B1.zero } ;
   neg-eq (x : M) : Id M (A0.neg x) (B1.neg x) = calc M {
    A0.neg x =< sym M _ _ (B1.addZ (A0.neg x)) > B1.add (A0.neg x) B1.zero
     =< ap M M (B1.add (A0.neg x)) B1.zero (B1.add x (B1.neg x)) (sym M _ _ (B1.addN x)) >
     B1.add (A0.neg x) (B1.add x (B1.neg x))
     =< B1.addA (A0.neg x) x (B1.neg x) > B1.add (B1.add (A0.neg x) x) (B1.neg x)
     =< ap M M (\ u -> B1.add u (B1.neg x)) (B1.add (A0.neg x) x) (B1.add x (A0.neg x)) (B1.addC (A0.neg x) x) >
     B1.add (B1.add x (A0.neg x)) (B1.neg x)
     =< ap M M (\ u -> B1.add u (B1.neg x)) (B1.add x (A0.neg x)) B1.zero (inv0 x) > B1.add B1.zero (B1.neg x)
     =< B1.addC B1.zero (B1.neg x) > B1.add (B1.neg x) B1.zero
     =< B1.addZ (B1.neg x) > B1.neg x } ;
   str-eq : Id At[M].Str t t' =
    Sigma-eq At[M].Data (\ d -> At[M].D[d].Laws) t.1 t'.1 t.2 t'.2
     (At[M].data-eq _ _ _ _ _ _ _ _ _ _ _ _ zero-eq
      (F.funext M (\ x -> M -> M) A0.add B1.add (\ x -> F.funext M (\ y -> M) (A0.add x) (B1.add x) (\ y -> h.1 x y)))
      (F.funext M (\ x -> M) A0.neg B1.neg neg-eq)
      (F.funext R.R (\ a -> M -> M) A0.scale B1.scale (\ a -> F.funext M (\ x -> M) (A0.scale a) (B1.scale a) (\ x -> h.2.1 a x)))
      h.2.2.2
      (F.funext M (\ x -> M -> M) A0.mul B1.mul (\ x -> F.funext M (\ y -> M) (A0.mul x) (B1.mul x) (\ y -> h.2.2.1 x y))))
     (At[M].D[t'.1].laws-prop) ;
  } ;
  Mot (N : U l) (e : Equiv M N) : U l+ = (t' : At[N].Str) (h : Hom A0 (At[N].mk t') e.1) ->
   Id (Total A0) (A0, idIso A0) (At[N].mk t', (e, h)) ;
  Pairs : U l = (t' : At[M].Str) * Hom A0 (At[M].mk t') (\ x -> x) ;
  base : Mot M (idEquiv M) = \ t' h ->
   Hi.ap Pairs (Total A0) (\ s -> (At[M].mk s.1, (idEquiv M, s.2))) (t, idHom A0) (t', h)
    (Sigma-eq At[M].Str (\ u -> Hom A0 (At[M].mk u) (\ x -> x)) t t' (idHom A0) h
     Same[t',h].str-eq (hom-prop A0 (At[M].mk t') (\ x -> x))) ;
  contr (N : U l) (e : Equiv M N) : Mot N e = Axioms[l].UnivalenceLemmas[univ @l].eqind M Mot base N e ;
 } ;
 contrB (M : U l) (t : At[M].Str) : (B : Alg) (phi : AlgIso (At[M].mk t) B) ->
  Id (Total (At[M].mk t)) (At[M].mk t, idIso (At[M].mk t)) (B, phi) = split {
  Algebra bA bset bz bad bng bsc bon bmu b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 -> \ phi ->
   Core[M,t].contr bA phi.1 ((bz,bad,bng,bsc,bon,bmu),(bset,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15)) phi.2 } ;
 contr : (A : Alg) (B : Alg) (phi : AlgIso A B) -> Id (Total A) (A, idIso A) (B, phi) = split {
  Algebra aA aset az aad ang asc aon amu a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 ->
   contrB aA ((az,aad,ang,asc,aon,amu),(aset,a1,a2,a3,a4,a5,a6,a7,a8,a9,a10,a11,a12,a13,a14,a15)) } ;
 total-contr (A : Alg) : CT.isContr (Total A) = ((A, idIso A), \ c -> contr A c.1 c.2) ;
 opaque contrB ; opaque contr ;

 -- the path to the centre, refl at the centre
 pth (A : Alg) (c : Total A) : Id (Total A) (A, idIso A) c = CT.pathC (Total A) (total-contr A) (A, idIso A) c ;
 pth-id (A : Alg) : Id (Id (Total A) (A, idIso A) (A, idIso A)) (pth A (A, idIso A)) (refl (A, idIso A)) =
  CT.pathC-refl (Total A) (total-contr A) (A, idIso A) ;
 opaque pth ;

 -- the structure identity principle
 sip (A B : Alg) (phi : AlgIso A B) : Id Alg A B =
  Hi.ap (Total A) Alg (\ c -> c.1) (A, idIso A) (B, phi) (pth A (B, phi)) ;
 idToIso (A B : Alg) (p : Id Alg A B) : AlgIso A B = Hi.subst Alg (\ X -> AlgIso A X) A B p (idIso A) ;
 sip-id (A : Alg) : Id (Id Alg A A) (sip A A (idIso A)) (refl A) =
  Prelude[l++].ap (Id (Total A) (A, idIso A) (A, idIso A)) (Id Alg A A)
   (\ q -> Hi.ap (Total A) Alg (\ c -> c.1) (A, idIso A) (A, idIso A) q)
   (pth A (A, idIso A)) (refl (A, idIso A)) (pth-id A) ;
 -- along any path from the centre, idToIso of the first projection is the second
 idToIso-fst (A : Alg) (c : Total A) (q : Id (Total A) (A, idIso A) c) :
  Id (AlgIso A c.1) (idToIso A c.1 (Hi.ap (Total A) Alg (\ c1 -> c1.1) (A, idIso A) c q)) c.2 =
  idJ (Total A) (A, idIso A)
   (\ c2 q2 -> Id (AlgIso A c2.1) (idToIso A c2.1 (Hi.ap (Total A) Alg (\ c1 -> c1.1) (A, idIso A) c2 q2)) c2.2)
   (refl (idIso A)) c q ;
 idToIso-sip (A B : Alg) (phi : AlgIso A B) : Id (AlgIso A B) (idToIso A B (sip A B phi)) phi =
  idToIso-fst A (B, phi) (pth A (B, phi)) ;
 sip-idToIso (A B : Alg) (p : Id Alg A B) : Id (Id Alg A B) (sip A B (idToIso A B p)) p =
  idJ Alg A (\ X q -> Id (Id Alg A X) (sip A X (idToIso A X q)) q) (sip-id A) B p ;
 opaque sip ;
} ;
