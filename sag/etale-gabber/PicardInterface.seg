-- Checked A/B interface. No algebraic theorem is postulated here.
-- Degree nonneg n denotes n; negative n denotes -(n+1), using Ring.Nat.
-- Units are represented as units of function algebras; B derives their
-- polynomial/Laurent interpretation from uniform SQC.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
data Degree = nonneg (n : Nat) | negative (n : Nat) ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module G = PicardUnits[l].Over[R,setR] ;
 LaurentUnit : U l = G.Unit -> G.Unit ;
 PolynomialUnit : U l = R.R -> G.Unit ;
 monomial : Degree -> G.Unit -> G.Unit = split {
  nonneg n -> \ x -> G.power x n ;
  negative n -> \ x -> G.power (G.inverse x) (suc n) } ;
 Factors (t : LaurentUnit) : U l =
  (d : Degree) * (u : G.Unit) * (a b : PolynomialUnit) *
   ((x : G.Unit) -> Id G.Unit (t x)
    (G.times u (G.times (monomial d x) (G.times (a x.1) (b x.2.1))))) ;
 Factorisation : U l = (t : LaurentUnit) -> Tr.Trunc[Factors t].carrier ;
 -- Gauge transformations on the two charts cannot change the degree.
 DegreeUnique : U l = (d e : Degree) (a b : PolynomialUnit) ->
  ((x : G.Unit) -> Id G.Unit (G.times (monomial d x) (a x.1))
    (G.times (monomial e x) (b x.2.1))) -> Id Degree d e ;
 -- B proves this from polynomial/Laurent coefficient comparison and SQC.
 -- It is the interface consumed by A's proof of constancy on P1.
 ChartIntersection : U l = (f g : R.R -> R.R) ->
  ((x : G.Unit) -> Id R.R (f x.1) (g x.2.1)) ->
  ((x : R.R) -> Id R.R (f x) (f R.z)) *
  ((y : R.R) -> Id R.R (g y) (f R.z)) ;
 -- Evaluation at zero of a function-algebra unit is already a unit.
 at-zero (a : PolynomialUnit) : RL[R].unit (a R.z).1 = (a R.z).2 ;
 record AlgebraResults {
  factorisation : Factorisation ;
  degree-unique : DegreeUnique ;
  intersection : ChartIntersection ;
 } ;
} ;
