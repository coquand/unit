-- The rank-r version of AFFINELINEPROJECTOR.  Let Mx be a family of modules
-- over X = Spec Alg (Alg f.p.) whose fibres merely have frames of rank r
-- (FRAMES; e.g. merely free of rank r).  Then merely there is a projector p
-- over Alg (PROJECTORS) with the global sections of Mx equivalent to
-- Image p, additively and Alg-linearly: AFFINEFRAMEDATA gives global frame
-- data, FRAMEPROJECTOR the projector and the representation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (Mx : C.Spec Alg -> MD.Module) (r : Nat)
  (frames : (x : C.Spec Alg) -> Tr.Trunc[FR.Frame[Mx x,r]].carrier) {
  module FP = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Mx] ;
  Witness : U l = (p : FP.PJ.Projector) * FP.Representation p ;
  theorem : Tr.Trunc[Witness].carrier =
   TC.map FP.Data Witness (\ w -> (FP.From[w].projector,FP.From[w].representation))
    (AffineFrameData[l].Over[R,setR,axioms].At[Alg,fp,Mx,r,frames].theorem) ;
 } ;
} ;
