level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (A : Algebras[l].Over[R,setR].Algebra) (f : A.ring.R)
 (left right : AffineInterface[l].Over[R,setR].LocalizationWitness A f) {
 module C = Algebras[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module To (src dst : I.LocalizationWitness A f) {
  arrow : C.Hom src.1 dst.1 = (src.2.2.2.2 dst.1).sec (dst.2.2.1,dst.2.2.2.1) ;
  beta (a : A.ring.R) : Id dst.1.ring.R (arrow.1.1 (src.2.2.1.1.1 a)) (dst.2.2.1.1.1 a) =
   Pr.ap (I.LocalData A dst.1 f) dst.1.ring.R (\ d -> d.1.1.1 a) _ _
    ((src.2.2.2.2 dst.1).sec-eq (dst.2.2.1,dst.2.2.2.1)) ;
 } ;
 forward : C.Hom left.1 right.1 = To[left,right].arrow ;
 backward : C.Hom right.1 left.1 = To[right,left].arrow ;
 unique (loc : I.LocalizationWitness A f) (B : C.Algebra) (h k : C.Hom loc.1 B)
  (agree : (a : A.ring.R) -> Id B.ring.R (h.1.1 (loc.2.2.1.1.1 a)) (k.1.1 (loc.2.2.1.1.1 a))) :
  Id (C.Hom loc.1 B) h k =
  Equivalences[l].injective _ _ (I.local-map A loc.1 B f loc.2.2.1 loc.2.2.2.1) (loc.2.2.2.2 B) h k
   (Pr.Sigma-eq _ (\ g -> I.Unit B (g.1.1 f)) _ _ _ _
    (C.ext A B _ _ agree) (AffineRing[l].Laws[B.ring,B.set].unit-prop (k.1.1 (loc.2.2.1.1.1 f)))) ;
 inverse-left : Id (C.Hom left.1 left.1) (C.compose left.1 right.1 left.1 backward forward) (C.identity left.1) =
  unique left left.1 _ _ (\ a -> trans (ap backward.1.1 (To[left,right].beta a)) (To[right,left].beta a)) ;
 inverse-right : Id (C.Hom right.1 right.1) (C.compose right.1 left.1 right.1 forward backward) (C.identity right.1) =
  unique right right.1 _ _ (\ a -> trans (ap forward.1.1 (To[right,left].beta a)) (To[left,right].beta a)) ;
 bf (a : left.1.ring.R) : Id left.1.ring.R (backward.1.1 (forward.1.1 a)) a =
  Pr.ap (C.Hom left.1 left.1) left.1.ring.R (\ h -> h.1.1 a) _ _ inverse-left ;
 fb (b : right.1.ring.R) : Id right.1.ring.R (forward.1.1 (backward.1.1 b)) b =
  Pr.ap (C.Hom right.1 right.1) right.1.ring.R (\ h -> h.1.1 b) _ _ inverse-right ;
 equivalence : Pr.Equiv left.1.ring.R right.1.ring.R = (forward.1.1,Pr.qinv _ _ forward.1.1 backward.1.1 fb bf) ;
} ;
