-- Worker A's public interface. All maps are actual R-algebra maps.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 Unit (A : C.Algebra) : A.ring.R -> U l = RL[A.ring].unit ;
 D (A : C.Algebra) (f : A.ring.R) : U l =
  (x : C.Spec A) * Unit C.base (x.1.1 f) ;
 LocalData (A B : C.Algebra) (f : A.ring.R) : U l =
  (h : C.Hom A B) * Unit B (h.1.1 f) ;
 local-map (A L B : C.Algebra) (f : A.ring.R) (inc : C.Hom A L)
  (u : Unit L (inc.1.1 f)) (h : C.Hom L B) : LocalData A B f =
  (C.compose A L B h inc,AffineRing[l].unit-map L.ring B.ring h.1 (inc.1.1 f) u) ;
 Localizes (A L : C.Algebra) (f : A.ring.R) (inc : C.Hom A L) : U l+ =
  (u : Unit L (inc.1.1 f)) *
  ((B : C.Algebra) -> Pr.isEquiv (C.Hom L B) (LocalData A B f) (local-map A L B f inc u)) ;
 LocalizationWitness (A : C.Algebra) (f : A.ring.R) : U l+ =
  (L : C.Algebra) * P.FP L * ((inc : C.Hom A L) * Localizes A L f inc) ;
 spectrum (A : C.Algebra) (f : A.ring.R) (loc : LocalizationWitness A f) :
  Pr.Equiv (C.Spec loc.1) (D A f) =
  (local-map A loc.1 C.base f loc.2.2.1 loc.2.2.2.1,loc.2.2.2.2 C.base) ;

 module Presented (A : C.Algebra) (p : P.Presentation) (pa : P.Presents p A)
  (f : A.ring.R) (e : P.Expr (Fin p.1)) (rep : Id A.ring.R (P.eval (Fin p.1) A pa.1.1 e) f) {
  module L = Localization[l].Over[R,setR,A,p,pa,f,e,rep] ;
  module To (B : C.Algebra) {
   universal : Pr.isEquiv (C.Hom L.algebra B) (LocalData A B f)
    (local-map A L.algebra B f L.inclusion L.inverse) =
    Equivalences[l].homotopy _ _ L.Canonical[B].equivalence
     (local-map A L.algebra B f L.inclusion L.inverse)
     (\ h -> L.To[B].data-ext _ _ (refl (C.compose A L.algebra B h L.inclusion))) ;
  } ;
  result : LocalizationWitness A f = (L.algebra,L.fp,L.inclusion,L.inverse,\ B -> To[B].universal) ;
 } ;
 -- No presentation or expression is chosen from a truncation.
 localize (A : C.Algebra) (fp : P.FP A) (f : A.ring.R) : Tr1.Trunc[LocalizationWitness A f].carrier =
  Tr1.Trunc[P.Witness A].induction @(l+) (\ t -> Tr1.Trunc[LocalizationWitness A f].carrier)
   (\ t -> Tr1.Trunc[LocalizationWitness A f].proposition)
   (\ w -> Tr.Trunc[AffineGenerated[l].Over[R,setR,A,w.1,w.2].Rep f].induction @(l+)
    (\ t -> Tr1.Trunc[LocalizationWitness A f].carrier) (\ t -> Tr1.Trunc[LocalizationWitness A f].proposition)
    (\ e -> Tr1.Trunc[LocalizationWitness A f].inc (Presented[A,w.1,w.2,f,e.1,e.2].result))
    (AffineGenerated[l].Over[R,setR,A,w.1,w.2].generated f)) fp ;
} ;
