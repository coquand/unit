-- Block sums and identities under U [x] - (MATRIXTENSOR, HOMSUMS).
--  (block)  U [x] (p + q) = Hom(I p + I q, U) = U [x] p + U [x] q.
--  (unit)   U [x] 1_1 = Hom(R^1, U) = Hom(R, U) = U.
--  (powers) The identity of size k + 2 and the block sum of the identities
--           of sizes 1 and k + 1 both fix every vector (VECTORS.act-one;
--           DIRECTSUMS.act-l, act-r), so their images are both R^(k+2) and
--           U [x] 1_(k+2) = U [x] (1_1 + 1_(k+1)) = U + U [x] 1_(k+1).
--           By induction U [x] 1_(k+1) = power k U (k + 1 copies).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module HS = HomSums[l].Over[R,setR] ;
 hom (U1 M : MD.Module) : MD.Module = HM.At[M,U1].carrier ;
 -- U [x] - applied to an identity of modules
 on (U1 M M' : MD.Module) (h : Id MD.Module M M') : Id MD.Module (hom U1 M) (hom U1 M') =
  Pr1.ap MD.Module MD.Module (hom U1) M M' h ;
 -- (block)
 block (U1 : MD.Module) (m n : Nat) (p : Vectors[l].Over[R,setR,m].MR.Mat) (q : Vectors[l].Over[R,setR,n].MR.Mat) :
  Id MD.Module (MT.tensor U1 (plus m n) (DirectSums[l].Over[R,setR,m,n].dsum p q))
   (MS.plus (MT.tensor U1 m p) (MT.tensor U1 n q)) =
  Pr1.trans MD.Module (MT.tensor U1 (plus m n) (DirectSums[l].Over[R,setR,m,n].dsum p q))
   (hom U1 (MS.plus (MT.I m p) (MT.I n q))) (MS.plus (MT.tensor U1 m p) (MT.tensor U1 n q))
   (on U1 _ _ MT.Block[m,n,p,q].image) HS.Sum[MT.I m p,MT.I n q,U1].theorem ;
 -- the identity matrices
 one (N : Nat) : Vectors[l].Over[R,setR,N].MR.Mat = Vectors[l].Over[R,setR,N].MR.mone ;
 identity (N : Nat) : Id MD.Module (MT.I N (one N)) (MT.free N) =
  MT.All[N,one N,Vectors[l].Over[R,setR,N].act-one].theorem ;
 module Ones (k : Nat) {
  module DS = DirectSums[l].Over[R,setR,suc zero,suc k] ;
  e : DS.M2.Mat = DS.dsum (one (suc zero)) (one (suc k)) ;
  fixed (w : DS.V2.Vec) : MT.Image[suc (suc k),e].Fixed w =
   DS.Parts[DS.V2.act e w,w,
    \ i -> trans (DS.act-l (one (suc zero)) (one (suc k)) w i) (DS.Vm.entry _ _ (DS.Vm.act-one (DS.lpart w)) i),
    \ i -> trans (DS.act-r (one (suc zero)) (one (suc k)) w i) (DS.Vn.entry _ _ (DS.Vn.act-one (DS.rpart w)) i)].equal ;
  same : Id MD.Module (MT.I (suc (suc k)) (one (suc (suc k)))) (MT.I (suc (suc k)) e) =
   Pr1.trans MD.Module (MT.I (suc (suc k)) (one (suc (suc k)))) (MT.free (suc (suc k))) (MT.I (suc (suc k)) e)
    (identity (suc (suc k))) (Pr1.sym MD.Module (MT.I (suc (suc k)) e) (MT.free (suc (suc k))) MT.All[suc (suc k),e,fixed].theorem) ;
 } ;
 -- (unit)
 unit (U1 : MD.Module) : Id MD.Module (MT.tensor U1 (suc zero) (one (suc zero))) U1 =
  Pr1.trans MD.Module (MT.tensor U1 (suc zero) (one (suc zero))) (hom U1 MD.regular) U1
   (on U1 _ _ (Pr1.trans MD.Module (MT.I (suc zero) (one (suc zero))) (MT.free (suc zero)) MD.regular
     (identity (suc zero)) HS.One.theorem))
   HS.Regular[U1].theorem ;
 -- (powers)
 powers (U1 : MD.Module) : (k : Nat) -> Id MD.Module (MT.tensor U1 (suc k) (one (suc k))) (MS.EM.power k U1) = split {
  zero -> unit U1 ;
  suc k | r -> Pr1.trans MD.Module (MT.tensor U1 (suc (suc k)) (one (suc (suc k))))
    (MT.tensor U1 (suc (suc k)) Ones[k].e) (MS.EM.power (suc k) U1)
    (on U1 _ _ Ones[k].same)
    (Pr1.trans MD.Module (MT.tensor U1 (suc (suc k)) Ones[k].e)
     (MS.plus (MT.tensor U1 (suc zero) (one (suc zero))) (MT.tensor U1 (suc k) (one (suc k)))) (MS.EM.power (suc k) U1)
     (block U1 (suc zero) (suc k) (one (suc zero)) (one (suc k)))
     (Pr1.trans MD.Module (MS.plus (MT.tensor U1 (suc zero) (one (suc zero))) (MT.tensor U1 (suc k) (one (suc k))))
      (MS.plus U1 (MT.tensor U1 (suc k) (one (suc k)))) (MS.EM.power (suc k) U1)
      (Pr1.ap MD.Module MD.Module (\ M -> MS.plus M (MT.tensor U1 (suc k) (one (suc k)))) _ _ (unit U1))
      (Pr1.ap MD.Module MD.Module (MS.plus U1) _ _ r))) } ;
} ;
