-- SAG 4.1.1. Mere finite systems of equations over the base ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 Zeros (n : Nat) (xs : Fin n -> R.R) : U l = (i : Fin n) -> Id R.R (xs i) R.z ;
 zeros-prop (n : Nat) (xs : Fin n -> R.R) : Pr.isProp (Zeros n xs) =
  F.isProp-Pi (Fin n) (\ i -> Id R.R (xs i) R.z) (\ i -> setR _ _) ;
 Witness (Q : U l) : U l = (n : Nat) * (xs : Fin n -> R.R) * Pr.Equiv Q (Zeros n xs) ;
 Closed (Q : U l) : U l = Tr.Trunc[Witness Q].carrier ;
 closed-prop (Q : U l) (c : Closed Q) : Pr.isProp Q =
  Tr.Trunc[Witness Q].induction @l (\ t -> Pr.isProp Q) (\ t -> F.isProp-isProp Q)
   (\ w a b -> Equivalences[l].injective Q (Zeros w.1 w.2.1) w.2.2.1 w.2.2.2 a b
    (zeros-prop w.1 w.2.1 (w.2.2.1 a) (w.2.2.1 b))) c ;
 ClosedSubtype (X : U l) (sub : X -> U l) : U l = (x : X) -> Closed (sub x) ;
 equations (n : Nat) (xs : Fin n -> R.R) : Closed (Zeros n xs) =
  Tr.Trunc[Witness (Zeros n xs)].inc (n,xs,Pr.idEquiv (Zeros n xs)) ;
 from-iff (Q : U l) (propQ : Pr.isProp Q) (n : Nat) (xs : Fin n -> R.R)
  (to : Q -> Zeros n xs) (from : Zeros n xs -> Q) : Witness Q =
  (n,xs,to,Pr.qinv Q (Zeros n xs) to from
   (\ z -> zeros-prop n xs (to (from z)) z) (\ q -> propQ (from (to q)) q)) ;
 along (Q S : U l) (e : Pr.Equiv Q S) : Closed S -> Closed Q =
  Tr.Trunc[Witness S].induction @l (\ t -> Closed Q) (\ t -> Tr.Trunc[Witness Q].proposition)
   (\ w -> Tr.Trunc[Witness Q].inc
    (w.1,w.2.1,Equivalences[l].compose Q S (Zeros w.1 w.2.1) e w.2.2)) ;
 module Affine (A : Algebras[l].Over[R,setR].Algebra) (n : Nat) (fs : Fin n -> A.ring.R) {
  module C = Algebras[l].Over[R,setR] ;
  vanishing (x : C.Spec A) : U l = Zeros n (\ i -> x.1.1 (fs i)) ;
  closed : ClosedSubtype (C.Spec A) vanishing = \ x -> equations n (\ i -> x.1.1 (fs i)) ;
 } ;
} ;
