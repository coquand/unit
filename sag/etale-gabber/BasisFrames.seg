-- Bases (LOCALFREE.Basis: vectors e_i and dual forms c_i) and frames
-- (DESCENTLINEAR.On.Frame: vectors w whose combination map lin_w : R^n -> M
-- is an equivalence) are interchangeable, and a module with a basis is a
-- sheaf (H^2 bridges, A3).
--  (frame)  The inverse of lin_e is c = (c_i): lin_e (c m) = sum c_i(m) e_i = m
--           (frame law), c_i (lin_e a) = sum a_j c_i(e_j) = a_i (BASISEND.column-coordinate).
--  (basis)  c_i(m) = (lin_w^-1 m)_i, linear as the inverse of a linear map
--           (DESCENTFRAMES.Inverse); law: lin_w (lin_w^-1 m) = m; dual: w_j =
--           lin_w (delta_j) (DESCENTLINEAR.lin-unit), so c(w_j) = delta_j.
--  (sheaf)  M is a retract of R^n (m |-> c m, a |-> lin_e a), and R is a sheaf.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module At (M : MD.Module) (n : Nat) {
  module LM = DL.On[M] ;
  free-sheaf : ET.T.isModal @l (DL.Free n).M = SL.modal-Pi (Fin n) (\ j -> R.R) (\ j -> ER.R-local) ;
  -- (frame)
  module Of (b : LF.Basis[M,n]) {
   module BE = BasisEnd[l].Over[R,setR].At[M,n,b.frame,b.dual] ;
   coords (m : M.M) : (DL.Free n).M = \ i -> (b.frame.form i).1 m ;
   law (m : M.M) : Id M.M (LM.lin n b.frame.vector (coords m)) m =
    trans (LM.lin-value n b.frame.vector (coords m)) (b.frame.law m) ;
   coords-lin (a : (DL.Free n).M) : Id (DL.Free n).M (coords (LM.lin n b.frame.vector a)) a =
    F.funext (Fin n) (\ i -> R.R) _ a (\ i ->
     trans (ap (b.frame.form i).1 (LM.lin-value n b.frame.vector a)) (BE.column-coordinate (\ k j -> a k) i i)) ;
   frame : LM.Frame n =
    (b.frame.vector,Pr.qinv (DL.Free n).M M.M (LM.lin n b.frame.vector) coords law coords-lin) ;
   -- (sheaf)
   sheaf : ET.T.isModal @l M.M = SL.modal-retract (DL.Free n).M M.M coords (LM.lin n b.frame.vector) law free-sheaf ;
  } ;
  -- (basis)
  module OfFrame (w : LM.Frame n) {
   module I = DescentFrames[l].Over[R,setR,axioms.loc].Inverse[DL.Free n,M,LM.lin n w.1,LM.lin-add n w.1,LM.lin-scale n w.1,w.2] ;
   form (i : Fin n) : HM.At[M,MD.regular].S.E =
    (\ m -> I.inverse m i,\ x y -> ap (\ v -> v i) (I.inverse-add x y),\ a x -> ap (\ v -> v i) (I.inverse-scale a x)) ;
   law (m : M.M) : Id M.M (ModuleFiniteSums[l].Over[R,setR,M].sum n (\ a -> M.sm ((form a).1 m) (w.1 a))) m =
    trans (sym (LM.lin-value n w.1 (I.inverse m))) (w.2.sec-eq m) ;
   dual (a b : Fin n) : Id R.R ((form a).1 (w.1 b)) (MnAlgebra[l].Over[R,setR,n].mone a b) =
    trans (ap (\ m -> I.inverse m a) (sym (LM.lin-unit n w.1 b)))
     (ap (\ v -> v a) (Pr.sec-ret (DL.Free n).M M.M (LM.lin n w.1) w.2 (\ k -> DL.D.delta n k b))) ;
   basis : LF.Basis[M,n] = new LF.Basis[M,n,new FR.Frame[M,n,w.1,form,law],dual] ;
  } ;
 } ;
} ;
