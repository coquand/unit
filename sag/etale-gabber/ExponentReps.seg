-- The two clauses of weak quasi-coherence (AFFINE.Rep, AFFINE.Kill) for a
-- family Mx over X and g : X -> R, with the exponent in Ring's Nat, as
-- monotone properties of it (EXPONENTBOUNDS), so finitely many of them hold
-- for one exponent:
--   Rep s k:  the local section s on D(g) is d^k m for a global m (d the
--             inverse of g); then also d^(j+k) (g^j m)  (Affine.PtL.raise);
--   Kill m k: g^k m = 0; then also g^(j+k) m = 0  (Alg73.zero-raise).
-- 7.1.8 (MODULES.Restriction) gives them merely for some exponent.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module NF = NatFin[l] ;
module EB = ExponentBounds[l] ; module TC = TruncationCombinators[l] ;
toN-plus : (m k : Nat) -> Id Base.Nat (NF.toN (plus m k)) (Alg73[l].plusN (NF.toN m) (NF.toN k)) = split {
 zero -> \ k -> refl (NF.toN k) ;
 suc m | r -> \ k -> ap (\ n -> suc n) (r k) } ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module RA = MD.RA ;
 module At (X : U l) (Mx : X -> MD.Module) (g : X -> R.R) {
  module Af = Affine[l].Aff[MD.ring,X,Mx] ;
  Local : U l = (x : X) -> Af.Dg g x -> (Mx x).M ;
  Global : U l = (x : X) -> (Mx x).M ;
  Rep (s : Local) (k : Nat) : U l =
   (m : Global) * ((x : X) (d : Af.Dg g x) -> Id (Mx x).M (s x d) ((Mx x).sm (RA.pw d.1 (NF.toN k)) (m x))) ;
  rep-monotone (s : Local) : EB.Monotone (Rep s) = \ j k h ->
   (\ x -> (Mx x).sm (RA.pw (g x) (NF.toN j)) (h.1 x),
    \ x d -> trans (h.2 x d)
     (trans (sym (Affine[l].PtL[MD.ring,Mx x].raise (g x) d.1 d.2 (NF.toN j) (NF.toN k) (h.1 x)))
      (ap (\ e -> (Mx x).sm (RA.pw d.1 e) ((Mx x).sm (RA.pw (g x) (NF.toN j)) (h.1 x)))
       (sym (toN-plus j k))))) ;
  from-rep (s : Local) (a : Af.Rep g s) : EB.Bound (Rep s) =
   (NF.fromN a.2.1,(a.1,\ x d -> trans (a.2.2 x d)
    (ap (\ e -> (Mx x).sm (RA.pw d.1 e) (a.1 x)) (sym (NF.to-from a.2.1))))) ;
  represent (w : MD.Restriction X Mx) (s : Local) : EB.Merely (Rep s) =
   TC.map (Af.Rep g s) (EB.Bound (Rep s)) (from-rep s) ((w g).1 s) ;
  Kill (m : Global) (k : Nat) : U l =
   (x : X) -> Id (Mx x).M ((Mx x).sm (RA.pw (g x) (NF.toN k)) (m x)) (Mx x).mz ;
  kill-monotone (m : Global) : EB.Monotone (Kill m) = \ j k h x ->
   Alg73[l].MA[MD.ring,Mx x].zero-raise (g x) (m x) (NF.toN k) (NF.toN j) (NF.toN (plus j k)) (h x)
    (sym (toN-plus j k)) ;
  from-kill (m : Global) (a : Af.Kill g m) : EB.Bound (Kill m) =
   (NF.fromN a.1,\ x -> trans (ap (\ e -> (Mx x).sm (RA.pw (g x) e) (m x)) (NF.to-from a.1)) (a.2 x)) ;
  kill (w : MD.Restriction X Mx) (m : Global)
   (v : (x : X) -> Af.Dg g x -> Id (Mx x).M (m x) (Mx x).mz) : EB.Merely (Kill m) =
   TC.map (Af.Kill g m) (EB.Bound (Kill m)) (from-kill m) ((w g).2 m v) ;
 } ;
} ;
