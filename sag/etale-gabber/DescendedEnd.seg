-- Endomorphisms of a twisted family descend as an algebra.
-- Hom(V,V) has weight zero by TwistedModules.Homs.Same. Its invariant
-- sections already form a module. Identity and composition preserve
-- invariance: transport preserves both operations, by path induction.
-- The algebra laws are the pointwise laws of ModuleEnd, lifted through
-- the propositional invariance condition. Evaluation at any object is
-- multiplicative and unital, and TwistedModules.Descent proves it is a
-- linear equivalence. Thus evaluation is an algebra isomorphism, and
-- AlgSIPUA gives the corresponding equality of algebras.
-- No chosen object, basis, or inhabitation is used to define the algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module TM = TwistedModules[l].Over[R,setR] ;
 module EN = ModuleEnd[l].Over[R,setR] ;
 module AS = AlgSIP[l].Over[R,setR] ;
 module AU = AlgSIPUA[l].Over[R,setR] ;
 module At (B : TM.Banded) (V : B.1 -> TM.MD.Module)
  (chi : TM.UG.Unit -> TM.UG.Unit) (weight : TM.At[TM.charge (B)].Weight chi V) {
  module T = TM.At[TM.charge (B)] ;
  module HS = T.Homs[V,V].Same[\ y q -> chi (T.bnd y q),weight,weight] ;
  module IV = T.Invariant[T.Homs[V,V].H] ;
  module MV = T.Move[T.Homs[V,V].H] ;
  module Fibre (g : B.1) { module E = EN.At[V g] ; } ;
  move-one (g h : B.1) (p : Id B.1 g h) :
   Id (T.Homs[V,V].H h).M (MV.move g h p Fibre[g].E.one) Fibre[h].E.one =
   idJ B.1 g (\ h p -> Id (T.Homs[V,V].H h).M (MV.move g h p Fibre[g].E.one) Fibre[h].E.one)
    (refl Fibre[g].E.one) h p ;
  move-mul (g h : B.1) (p : Id B.1 g h) (f k : (T.Homs[V,V].H g).M) :
   Id (T.Homs[V,V].H h).M (MV.move g h p (Fibre[g].E.mul f k))
    (Fibre[h].E.mul (MV.move g h p f) (MV.move g h p k)) =
   idJ B.1 g (\ h p -> Id (T.Homs[V,V].H h).M (MV.move g h p (Fibre[g].E.mul f k))
    (Fibre[h].E.mul (MV.move g h p f) (MV.move g h p k))) (refl (Fibre[g].E.mul f k)) h p ;
  one : IV.S.E = (\ g -> Fibre[g].E.one,move-one) ;
  mul (f k : IV.S.E) : IV.S.E = (\ g -> Fibre[g].E.mul (f.1 g) (k.1 g),
   \ g h p -> trans (move-mul g h p (f.1 g) (k.1 g))
    (cong2 (T.Homs[V,V].H h).M Fibre[h].E.mul _ _ _ _ (f.2 g h p) (k.2 g h p))) ;
  ext (f k : IV.S.E) (e : (g : B.1) -> Id (T.Homs[V,V].H g).M (f.1 g) (k.1 g)) : Id IV.S.E f k =
   IV.S.eq f k (F.funext B.1 (\ g -> (T.Homs[V,V].H g).M) f.1 k.1 e) ;
  algebra : EN.NA.Algebra = new EN.NA.Algebra[IV.S.E,IV.carrier.setM,
   IV.carrier.mz,IV.carrier.madd,IV.carrier.mneg,IV.carrier.sm,one,mul,
   IV.carrier.maddA,IV.carrier.maddC,IV.carrier.maddZ,IV.carrier.maddN,
   IV.carrier.smO,IV.carrier.smA,IV.carrier.smD,IV.carrier.smE,
   \ f k h -> ext _ _ (\ g -> Fibre[g].E.algebra.mulA (f.1 g) (k.1 g) (h.1 g)),
   \ f -> ext _ _ (\ g -> Fibre[g].E.algebra.one-left (f.1 g)),
   \ f -> ext _ _ (\ g -> Fibre[g].E.algebra.one-right (f.1 g)),
   \ f k h -> ext _ _ (\ g -> Fibre[g].E.algebra.dist-left (f.1 g) (k.1 g) (h.1 g)),
   \ f k h -> ext _ _ (\ g -> Fibre[g].E.algebra.dist-right (f.1 g) (k.1 g) (h.1 g)),
   \ a f k -> ext _ _ (\ g -> Fibre[g].E.algebra.scale-mul-left a (f.1 g) (k.1 g)),
   \ a f k -> ext _ _ (\ g -> Fibre[g].E.algebra.scale-mul-right a (f.1 g) (k.1 g))] ;
  module AtObject (g : B.1) {
   module D = T.Descent[T.Homs[V,V].H,HS.weight,g] ;
   evaluation : AS.AlgIso algebra Fibre[g].E.algebra =
    ((IV.at g,D.equivalence),
     \ f k -> refl ((T.Homs[V,V].H g).madd (f.1 g) (k.1 g)),
     \ a f -> refl ((T.Homs[V,V].H g).sm a (f.1 g)),
     \ f k -> refl (Fibre[g].E.mul (f.1 g) (k.1 g)),refl Fibre[g].E.one) ;
   equality : Id EN.NA.Algebra algebra Fibre[g].E.algebra = AU.sip algebra Fibre[g].E.algebra evaluation ;
  } ;
 } ;
} ;
