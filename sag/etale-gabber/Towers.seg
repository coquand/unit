-- Towers: the flattened covers of the root topology (GABBER-PROPER-DESIGN.md,
-- section 1).  A shape is a list of stage degrees; an entry d stands for a
-- monic polynomial of degree d+1 (ETALETOPOLOGY.I).  Over a type Y,
--     Tower nil Y      = Top
--     Tower (d :: s) Y = (c : Y -> Fin (d+1) -> R) * Tower s ((y : Y) * Root (d, c y)),
-- the coefficients of each stage depending on the point and the roots
-- adjoined so far.  Points t is the last type, base : Points t -> Y.
--  (append)  a tower over Points t1 continues t1: Tower (s1 ++ s2) Y, whose
--            points are the points of the second tower (lower, onto t1).
--  (pull)    along u : Y' -> Y a tower over Y gives one over Y' (the
--            coefficients composed with u), with points mapping over u.
--  (pullback) Points (pull u t) is the pullback of base along u: the map
--            z' |-> (base z', pull-points z', pull-base z') to
--                Pullback = (y' : Y') * (z : Points t) * (base z = u y')
--            is an equivalence.  By induction on the shape: at nil it is
--            the contraction of the singleton (z, z = u y'); at a stage the
--            pulled points over N' = (y' : Y') * Root (c (u y')) are, by
--            induction, (n' : N') * (z : Points) * (base z = (u n'.1, n'.2)),
--            and a root x of c (u y') with a path w = (u y', x) in the Sigma
--            type N is the same as a path w.1 = u y' (PathsTo).
--  (append-base) base (append t1 t2) = base t1 . lower.
-- Cover Y P: merely a tower over Y every point of which lies over a y with
-- ||P y||.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
Shape : U l = List Nat ;
cat : Shape -> Shape -> Shape = split {
 nil -> \ s2 -> s2 ;
 cons d s | r -> \ s2 -> cons d (r s2) } ;
-- paths out of a point w of a Sigma type: a point over a together with a
-- path w = (a, x) is a path w.1 = a.  (first, lift) are inverse, by J.
module PathsTo (A : U l) (B : A -> U l) (w : (a : A) * B a) {
 Over-point (a : A) : U l = (x : B a) * Id ((a : A) * B a) w (a,x) ;
 first (a : A) (q : Over-point a) : Id A w.1 a = ap (\ v -> v.1) q.2 ;
 lift (a : A) (p : Id A w.1 a) : Over-point a = idJ A w.1 (\ a2 q -> Over-point a2) (w.2,refl w) a p ;
 first-lift (a : A) (p : Id A w.1 a) : Id (Id A w.1 a) (first a (lift a p)) p =
  idJ A w.1 (\ a2 q -> Id (Id A w.1 a2) (first a2 (lift a2 q)) q) (refl (refl w.1)) a p ;
 lift-first (a : A) (q : Over-point a) : Id (Over-point a) (lift a (first a q)) q =
  idJ ((a : A) * B a) w (\ v e -> Id (Over-point v.1) (lift v.1 (first v.1 (v.2,e))) (v.2,e))
   (refl (w.2,refl w)) (a,q.1) q.2 ;
} ;
-- the singleton of paths into a point is contractible
singleton-to (A : U l) (a z : A) (e : Id A z a) : Id ((z : A) * Id A z a) (a,refl a) (z,e) =
 idJ A z (\ a2 e2 -> Id ((z' : A) * Id A z' a2) (a2,refl a2) (z,e2)) (refl (z,refl z)) a e ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 -- the roots of the stage polynomial of degree d+1 with coefficients a
 Root (d : Nat) (a : Fin (suc d) -> R.R) : U l = ET.Root (d,a) ;
 Next (d : Nat) (Y : U l) (c : Y -> Fin (suc d) -> R.R) : U l = (y : Y) * Root d (c y) ;
 Tower : Shape -> U l -> U l = split {
  nil -> \ Y -> Top ;
  cons d s | r -> \ Y -> (c : Y -> Fin (suc d) -> R.R) * r (Next d Y c) } ;
 Points : (s : Shape) (Y : U l) -> Tower s Y -> U l = split {
  nil -> \ Y t -> Y ;
  cons d s | r -> \ Y t -> r (Next d Y t.1) t.2 } ;
 base : (s : Shape) (Y : U l) (t : Tower s Y) -> Points s Y t -> Y = split {
  nil -> \ Y t z -> z ;
  cons d s | r -> \ Y t z -> (r (Next d Y t.1) t.2 z).1 } ;
 -- (append)
 append : (s1 s2 : Shape) (Y : U l) (t1 : Tower s1 Y) -> Tower s2 (Points s1 Y t1) -> Tower (cat s1 s2) Y = split {
  nil -> \ s2 Y t1 t2 -> t2 ;
  cons d s | r -> \ s2 Y t1 t2 -> (t1.1,r s2 (Next d Y t1.1) t1.2 t2) } ;
 -- the points of an appended tower are those of its second part
 upper : (s1 s2 : Shape) (Y : U l) (t1 : Tower s1 Y) (t2 : Tower s2 (Points s1 Y t1)) ->
  Points (cat s1 s2) Y (append s1 s2 Y t1 t2) -> Points s2 (Points s1 Y t1) t2 = split {
  nil -> \ s2 Y t1 t2 z -> z ;
  cons d s | r -> \ s2 Y t1 t2 z -> r s2 (Next d Y t1.1) t1.2 t2 z } ;
 lower (s1 s2 : Shape) (Y : U l) (t1 : Tower s1 Y) (t2 : Tower s2 (Points s1 Y t1))
  (z : Points (cat s1 s2) Y (append s1 s2 Y t1 t2)) : Points s1 Y t1 =
  base s2 (Points s1 Y t1) t2 (upper s1 s2 Y t1 t2 z) ;
 -- (pull)
 pull : (s : Shape) (Y Y' : U l) (u : Y' -> Y) -> Tower s Y -> Tower s Y' = split {
  nil -> \ Y Y' u t -> tt ;
  cons d s | r -> \ Y Y' u t ->
   (\ y' -> t.1 (u y'),r (Next d Y t.1) (Next d Y' (\ y' -> t.1 (u y'))) (\ p -> (u p.1,p.2)) t.2) } ;
 pull-points : (s : Shape) (Y Y' : U l) (u : Y' -> Y) (t : Tower s Y) ->
  Points s Y' (pull s Y Y' u t) -> Points s Y t = split {
  nil -> \ Y Y' u t z -> u z ;
  cons d s | r -> \ Y Y' u t z ->
   r (Next d Y t.1) (Next d Y' (\ y' -> t.1 (u y'))) (\ p -> (u p.1,p.2)) t.2 z } ;
 -- pulled points lie over u of the base
 pull-base : (s : Shape) (Y Y' : U l) (u : Y' -> Y) (t : Tower s Y) (z : Points s Y' (pull s Y Y' u t)) ->
  Id Y (base s Y t (pull-points s Y Y' u t z)) (u (base s Y' (pull s Y Y' u t) z)) = split {
  nil -> \ Y Y' u t z -> refl (u z) ;
  cons d s | r -> \ Y Y' u t z ->
   ap (\ p -> p.1) (r (Next d Y t.1) (Next d Y' (\ y' -> t.1 (u y'))) (\ p -> (u p.1,p.2)) t.2 z) } ;
 -- (pullback)
 Pullback (s : Shape) (Y Y' : U l) (u : Y' -> Y) (t : Tower s Y) : U l =
  (y' : Y') * (z : Points s Y t) * Id Y (base s Y t z) (u y') ;
 to-pullback (s : Shape) (Y Y' : U l) (u : Y' -> Y) (t : Tower s Y) (z : Points s Y' (pull s Y Y' u t)) :
  Pullback s Y Y' u t = (base s Y' (pull s Y Y' u t) z,pull-points s Y Y' u t z,pull-base s Y Y' u t z) ;
 -- one stage: N = (y : Y) * Root (c y), N' its pullback along u, u' = u * id
 module Stage (d : Nat) (s : Shape) (Y Y' : U l) (u : Y' -> Y) (c : Y -> Fin (suc d) -> R.R)
  (t : Tower s (Next d Y c)) {
  N : U l = Next d Y c ;
  N' : U l = Next d Y' (\ y' -> c (u y')) ;
  u' (n : N') : N = (u n.1,n.2) ;
  forward (q : Pullback s N N' u' t) : Pullback (cons d s) Y Y' u (c,t) =
   (q.1.1,q.2.1,ap (\ p -> p.1) q.2.2) ;
  backward (q : Pullback (cons d s) Y Y' u (c,t)) : Pullback s N N' u' t =
   ((q.1,(PathsTo[Y,\ y -> Root d (c y),base s N t q.2.1].lift (u q.1) q.2.2).1),q.2.1,(PathsTo[Y,\ y -> Root d (c y),base s N t q.2.1].lift (u q.1) q.2.2).2) ;
  equivalence : Pr.isEquiv (Pullback s N N' u' t) (Pullback (cons d s) Y Y' u (c,t)) forward =
   Pr.qinv (Pullback s N N' u' t) (Pullback (cons d s) Y Y' u (c,t)) forward backward
    (\ q -> ap (\ p -> (q.1,q.2.1,p)) (PathsTo[Y,\ y -> Root d (c y),base s N t q.2.1].first-lift (u q.1) q.2.2))
    (\ q -> ap (\ o -> ((q.1.1,o.1),q.2.1,o.2)) (PathsTo[Y,\ y -> Root d (c y),base s N t q.2.1].lift-first (u q.1.1) (q.1.2,q.2.2))) ;
 } ;
 pullback : (s : Shape) (Y Y' : U l) (u : Y' -> Y) (t : Tower s Y) ->
  Pr.isEquiv (Points s Y' (pull s Y Y' u t)) (Pullback s Y Y' u t) (to-pullback s Y Y' u t) = split {
  nil -> \ Y Y' u t -> Pr.qinv Y' (Pullback nil Y Y' u t) (to-pullback nil Y Y' u t) (\ q -> q.1)
   (\ q -> ap (\ o -> (q.1,o)) (singleton-to Y (u q.1) q.2.1 q.2.2)) (\ y' -> refl y') ;
  cons d s | r -> \ Y Y' u t ->
   (Equivalences[l].compose (Points s (Stage[d,s,Y,Y',u,t.1,t.2].N') (pull s (Next d Y t.1) (Stage[d,s,Y,Y',u,t.1,t.2].N') (Stage[d,s,Y,Y',u,t.1,t.2].u') t.2))
     (Pullback s (Next d Y t.1) (Stage[d,s,Y,Y',u,t.1,t.2].N') (Stage[d,s,Y,Y',u,t.1,t.2].u') t.2)
     (Pullback (cons d s) Y Y' u t)
     (to-pullback s (Next d Y t.1) (Stage[d,s,Y,Y',u,t.1,t.2].N') (Stage[d,s,Y,Y',u,t.1,t.2].u') t.2,
      r (Next d Y t.1) (Stage[d,s,Y,Y',u,t.1,t.2].N') (Stage[d,s,Y,Y',u,t.1,t.2].u') t.2)
     (Stage[d,s,Y,Y',u,t.1,t.2].forward,Stage[d,s,Y,Y',u,t.1,t.2].equivalence)).2 } ;
 -- (append-base)
 append-base : (s1 s2 : Shape) (Y : U l) (t1 : Tower s1 Y) (t2 : Tower s2 (Points s1 Y t1))
  (z : Points (cat s1 s2) Y (append s1 s2 Y t1 t2)) ->
  Id Y (base (cat s1 s2) Y (append s1 s2 Y t1 t2) z) (base s1 Y t1 (lower s1 s2 Y t1 t2 z)) = split {
  nil -> \ s2 Y t1 t2 z -> refl (base s2 Y t2 z) ;
  cons d s | r -> \ s2 Y t1 t2 z -> ap (\ p -> p.1) (r s2 (Next d Y t1.1) t1.2 t2 z) } ;
 -- covers
 Witness (Y : U l) (P : Y -> U l) : U l =
  (s : Shape) * (t : Tower s Y) * ((z : Points s Y t) -> Tr.Trunc[P (base s Y t z)].carrier) ;
 Cover (Y : U l) (P : Y -> U l) : U l = Tr.Trunc[Witness Y P].carrier ;
} ;
