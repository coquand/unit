-- The sheaves of U l form a sheaf (lex), for any topology generated by
-- propositions G i (SHEAFTOPOLOGY); no closure is involved.  For f : G i ->
-- sheaves, glue f to Pi (g : G i) (f g).1, a sheaf (SHEAFLEMMAS); since G i
-- is a proposition, evaluation at g is an equivalence
-- Pi (g : G i) (f g).1 ~ (f g).1, so the glued sheaf restricts to f
-- (univalence; being a sheaf is a proposition, modal-prop).  Gluing a
-- constant family X gives G i -> X, equal to X since X is a sheaf.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
-- at a point g of a proposition P, evaluation (Pi (h : P) B h) -> B g is an equivalence
module PropEvaluation (P : U l) (prop : Pr.isProp P) (B : P -> U l) (g : P) {
 along (h : P) (p : Id P g h) (y : B g) : B h = Pr.subst P B g h p y ;
 along-self (y : B g) : Id (B g) (along g (prop g g) y) y =
  ap (\ q -> along g q y) (Pr.prop-to-set P prop g g (prop g g) (refl g)) ;
 along-section (m : (h : P) -> B h) (h : P) (p : Id P g h) : Id (B h) (along h p (m g)) (m h) =
  idJ P g (\ h2 q -> Id (B h2) (along h2 q (m g)) (m h2)) (refl (m g)) h p ;
 ev (m : (h : P) -> B h) : B g = m g ;
 spread (y : B g) (h : P) : B h = along h (prop g h) y ;
 equiv : Pr.isEquiv ((h : P) -> B h) (B g) ev =
  Pr.qinv ((h : P) -> B h) (B g) ev spread along-self
   (\ m -> F.funext P B (spread (m g)) m (\ h -> along-section m h (prop g h))) ;
} ;
module Over (I : U l) (G : I -> U l) (G-prop : (i : I) -> Pr.isProp (G i)) {
 module T = SheafTopology[l].Over[I,G] ;
 module SL = SheafLemmas[l,l].Over[I,G] ;
 modal-prop (Y : U l) : Pr.isProp (T.isModal @l Y) =
  F.isProp-Pi I (\ i -> Pr.isEquiv Y (G i -> Y) (\ y g -> y)) (\ i -> Prop331Paths[l].isEquiv-prop Y (G i -> Y) (\ y g -> y)) ;
 Sheaves : U l+ = (X : U l) * T.isModal @l X ;
 module Lex (i : I) {
  P : U l = G i ;
  glue (f : P -> Sheaves) : Sheaves =
   ((g : P) -> (f g).1,SL.modal-Pi P (\ g -> (f g).1) (\ g -> (f g).2)) ;
  restricts (f : P -> Sheaves) (g : P) : Id Sheaves (glue f) (f g) =
   Hi.Sigma-eq (U l) (\ X -> T.isModal @l X) (glue f).1 (f g).1 (glue f).2 (f g).2
    (UA.ua (glue f).1 (f g).1 (PropEvaluation[P,G-prop i,\ h -> (f h).1,g].ev,PropEvaluation[P,G-prop i,\ h -> (f h).1,g].equiv))
    (modal-prop (f g).1) ;
  constant (X : Sheaves) : Id Sheaves (glue (\ g -> X)) X =
   Hi.Sigma-eq (U l) (\ Y -> T.isModal @l Y) (glue (\ g -> X)).1 X.1 (glue (\ g -> X)).2 X.2
    (Hi.sym (U l) X.1 (P -> X.1) (UA.ua X.1 (P -> X.1) (\ x g -> x,X.2 i))) (modal-prop X.1) ;
  equiv : Hi.isEquiv Sheaves (P -> Sheaves) (\ X g -> X) =
   Hi.qinv Sheaves (P -> Sheaves) (\ X g -> X) glue
    (\ f -> Axioms[l+].FunExtLemmas[fe @(l+)].funext P (\ g -> Sheaves) (\ g -> glue f) f (restricts f)) constant ;
 } ;
 lex : T.isModal @(l+) Sheaves = \ i -> Lex[i].equiv ;
} ;
