-- The centre of End(M), M with a basis (e_i, c_i) of rank n+1: a linear
-- bijection gam of M commuting with every endomorphism is multiplication by
-- a unit mu, and mu is determined by gam (H^2 bridges, A2; the centre lemma
-- of SPLITCOMPARISON, for any module).
-- Proof.  With f_i = c_o(-) e_i (rank one), gam(e_i) = gam(f_i e_o) =
-- f_i(gam e_o) = mu e_i for mu = c_o(gam e_o); so gam = mu by linearity and
-- the frame law.  mu is a unit: for y with gam y = e_o,
-- 1 = c_o(e_o) = c_o(mu y) = mu c_o(y).  Uniqueness: compare at e_o.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module D = MnSums[l].Over[R] ;
 module At (M : MD.Module) (n : Nat) (b : LF.Basis[M,suc n]) {
  module MS = ModuleFiniteSums[l].Over[R,setR,M] ;
  module ML = ModuleSumLaws[l].Over[R,setR,M] ;
  module MA = Alg73[l].MA[MD.ring,M] ;
  o : Fin (suc n) = inr tt ;
  e (i : Fin (suc n)) : M.M = b.frame.vector i ;
  c (i : Fin (suc n)) (x : M.M) : R.R = (b.frame.form i).1 x ;
  c-scale (i : Fin (suc n)) (t : R.R) (x : M.M) : Id R.R (c i (M.sm t x)) (R.mul t (c i x)) = (b.frame.form i).2.2 t x ;
  dual-o : Id R.R (c o (e o)) R.o = trans (b.dual o o) (D.delta-diag (suc n) o) ;
  -- f_i = c_o(-) e_i
  rank-one (i : Fin (suc n)) : HM.At[M,M].S.E =
   (\ x -> M.sm (c o x) (e i),
    \ x y -> trans (ap (\ t -> M.sm t (e i)) ((b.frame.form o).2.1 x y)) (M.smE (c o x) (c o y) (e i)),
    \ t x -> trans (ap (\ r -> M.sm r (e i)) (c-scale o t x)) (sym (M.smA t (c o x) (e i)))) ;
  Commutes (gam : M.M -> M.M) : U l = (f : HM.At[M,M].S.E) (x : M.M) -> Id M.M (gam (f.1 x)) (f.1 (gam x)) ;
  module Of (a : HM.At[M,M].S.E) (bij : Pr.isEquiv M.M M.M a.1) (commute : Commutes a.1) {
   gam (x : M.M) : M.M = a.1 x ;
   mu : R.R = c o (gam (e o)) ;
   basis-vector (i : Fin (suc n)) : Id M.M (gam (e i)) (M.sm mu (e i)) =
    calc M.M { gam (e i)
     =< ap gam (sym (trans (ap (\ t -> M.sm t (e i)) dual-o) (M.smO (e i)))) > gam ((rank-one i).1 (e o))
     =< commute (rank-one i) (e o) > M.sm mu (e i) } ;
   zero : Id M.M (gam M.mz) M.mz =
    trans (ap gam (sym (MA.sm-zl M.mz))) (trans (a.2.2 R.z M.mz) (MA.sm-zl (gam M.mz))) ;
   term (x : M.M) (i : Fin (suc n)) :
    Id M.M (M.sm (c i x) (gam (e i))) (M.sm mu (M.sm (c i x) (e i))) =
    trans (ap (M.sm (c i x)) (basis-vector i))
     (trans (M.smA (c i x) mu (e i)) (trans (ap (\ t -> M.sm t (e i)) (R.mulC (c i x) mu)) (sym (M.smA mu (c i x) (e i))))) ;
   scalar-law (x : M.M) : Id M.M (gam x) (M.sm mu x) =
    calc M.M { gam x
     =< ap gam (sym (b.frame.law x)) > gam (MS.sum (suc n) (\ i -> M.sm (c i x) (e i)))
     =< ML.Map[M,gam,zero,a.2.1].combination a.2.2 (suc n) (\ i -> c i x) e >
        MS.sum (suc n) (\ i -> M.sm (c i x) (gam (e i)))
     =< MS.congruent (suc n) _ _ (term x) > MS.sum (suc n) (\ i -> M.sm mu (M.sm (c i x) (e i)))
     =< sym (ML.scale-sum mu (suc n) (\ i -> M.sm (c i x) (e i))) > M.sm mu (MS.sum (suc n) (\ i -> M.sm (c i x) (e i)))
     =< ap (M.sm mu) (b.frame.law x) > M.sm mu x } ;
   -- mu is a unit: e_o = gam y for y = gam^-1 e_o, so 1 = c_o (mu y) = mu c_o y
   y : M.M = bij.sec (e o) ;
   inverse : Id R.R (R.mul mu (c o y)) R.o =
    calc R.R { R.mul mu (c o y) =< sym (c-scale o mu y) > c o (M.sm mu y)
     =< ap (c o) (sym (scalar-law y)) > c o (gam y)
     =< ap (c o) (bij.sec-eq (e o)) > c o (e o) =< dual-o > R.o } ;
   unit : UG.Unit = (mu,c o y,inverse) ;
  } ;
  -- a unit is determined by its action on e_o
  injective (u v : UG.Unit) (h : Id M.M (M.sm u.1 (e o)) (M.sm v.1 (e o))) : Id UG.Unit u v =
   UG.eq u v (calc R.R { u.1 =< sym (R.mulO u.1) > R.mul u.1 R.o
    =< ap (R.mul u.1) (sym dual-o) > R.mul u.1 (c o (e o)) =< sym (c-scale o u.1 (e o)) > c o (M.sm u.1 (e o))
    =< ap (c o) h > c o (M.sm v.1 (e o)) =< c-scale o v.1 (e o) > R.mul v.1 (c o (e o))
    =< ap (R.mul v.1) dual-o > R.mul v.1 R.o =< R.mulO v.1 > v.1 }) ;
 } ;
} ;
