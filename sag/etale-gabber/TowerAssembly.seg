-- Assembling towers (GABBER-PROPER-DESIGN.md, section 2, Globalise steps 3-4).
--  (gather)   A family of towers of one shape s, t x over F x, is a tower
--             of shape s over (x : X) * F x: the coefficients at (x, f)
--             are those of t x at f; the next base (p : Total) * Root (c p)
--             is mapped to (x : X) * Next (F x) by reassociation, and the
--             rest is pulled back along it.  A point z of the gathered
--             tower gives a point of t x for x = (base z).1.
--  (product)  Two towers a, b over Y give append a (pull b along base a);
--             a point of it gives points of a and of b over its base.
--             Finitely many towers: iterate.  A point of the product gives
--             a point of each factor, over the same point of Y.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module TW = Towers[l].Over[R,setR] ;
 Shape : U l = Towers[l].Shape ;
 -- (gather)
 module Gather (d : Nat) (X : U l) (F : X -> U l) (c : (x : X) -> F x -> Fin (suc d) -> R.R) {
  Total : U l = (x : X) * F x ;
  coefficients (p : Total) : Fin (suc d) -> R.R = c p.1 p.2 ;
  Fibres : U l = (x : X) * TW.Next d (F x) (c x) ;
  rho (q : TW.Next d Total coefficients) : Fibres = (q.1.1,(q.1.2,q.2)) ;
 } ;
 gather : (s : Shape) (X : U l) (F : X -> U l) (t : (x : X) -> TW.Tower s (F x)) -> TW.Tower s ((x : X) * F x) = split {
  nil -> \ X F t -> tt ;
  cons d s | r -> \ X F t ->
   (Gather[d,X,F,\ x -> (t x).1].coefficients,
    TW.pull s Gather[d,X,F,\ x -> (t x).1].Fibres
     (TW.Next d ((x : X) * F x) Gather[d,X,F,\ x -> (t x).1].coefficients) Gather[d,X,F,\ x -> (t x).1].rho
     (r X (\ x -> TW.Next d (F x) (t x).1) (\ x -> (t x).2))) } ;
 gather-points : (s : Shape) (X : U l) (F : X -> U l) (t : (x : X) -> TW.Tower s (F x)) ->
  TW.Points s ((x : X) * F x) (gather s X F t) -> (x : X) * TW.Points s (F x) (t x) = split {
  nil -> \ X F t z -> z ;
  cons d s | r -> \ X F t z ->
   r X (\ x -> TW.Next d (F x) (t x).1) (\ x -> (t x).2)
    (TW.pull-points s Gather[d,X,F,\ x -> (t x).1].Fibres
     (TW.Next d ((x : X) * F x) Gather[d,X,F,\ x -> (t x).1].coefficients) Gather[d,X,F,\ x -> (t x).1].rho
     (gather s X (\ x -> TW.Next d (F x) (t x).1) (\ x -> (t x).2)) z) } ;
 gather-base : (s : Shape) (X : U l) (F : X -> U l) (t : (x : X) -> TW.Tower s (F x))
  (z : TW.Points s ((x : X) * F x) (gather s X F t)) ->
  Id X (gather-points s X F t z).1 (TW.base s ((x : X) * F x) (gather s X F t) z).1 = split {
  nil -> \ X F t z -> refl z.1 ;
  cons d s | r -> \ X F t z ->
   trans (r X (\ x -> TW.Next d (F x) (t x).1) (\ x -> (t x).2)
     (TW.pull-points s Gather[d,X,F,\ x -> (t x).1].Fibres
      (TW.Next d ((x : X) * F x) Gather[d,X,F,\ x -> (t x).1].coefficients) Gather[d,X,F,\ x -> (t x).1].rho
      (gather s X (\ x -> TW.Next d (F x) (t x).1) (\ x -> (t x).2)) z))
    (ap (\ q -> q.1) (TW.pull-base s Gather[d,X,F,\ x -> (t x).1].Fibres
      (TW.Next d ((x : X) * F x) Gather[d,X,F,\ x -> (t x).1].coefficients) Gather[d,X,F,\ x -> (t x).1].rho
      (gather s X (\ x -> TW.Next d (F x) (t x).1) (\ x -> (t x).2)) z)) } ;
 -- (product)
 Some (Y : U l) : U l = (s : Shape) * TW.Tower s Y ;
 Pts (Y : U l) (a : Some Y) : U l = TW.Points a.1 Y a.2 ;
 bs (Y : U l) (a : Some Y) (z : Pts Y a) : Y = TW.base a.1 Y a.2 z ;
 -- a point of a over the point y
 Over-point (Y : U l) (a : Some Y) (y : Y) : U l = (o : Pts Y a) * Id Y (bs Y a o) y ;
 module Two (Y : U l) (a b : Some Y) {
  b' : TW.Tower b.1 (Pts Y a) = TW.pull b.1 Y (Pts Y a) (bs Y a) b.2 ;
  both : Some Y = (Towers[l].cat a.1 b.1,TW.append a.1 b.1 Y a.2 b') ;
  left (z : Pts Y both) : Over-point Y a (bs Y both z) =
   (TW.lower a.1 b.1 Y a.2 b' z,sym (TW.append-base a.1 b.1 Y a.2 b' z)) ;
  right (z : Pts Y both) : Over-point Y b (bs Y both z) =
   (TW.pull-points b.1 Y (Pts Y a) (bs Y a) b.2 (TW.upper a.1 b.1 Y a.2 b' z),
    trans (TW.pull-base b.1 Y (Pts Y a) (bs Y a) b.2 (TW.upper a.1 b.1 Y a.2 b' z))
     (sym (TW.append-base a.1 b.1 Y a.2 b' z))) ;
 } ;
 product (Y : U l) : (m : Nat) -> (Fin m -> Some Y) -> Some Y = split {
  zero -> \ T -> (nil,tt) ;
  suc m | r -> \ T -> Two[Y,T (inr tt),r (\ i -> T (inl i))].both } ;
 project (Y : U l) : (m : Nat) (T : Fin m -> Some Y) (i : Fin m) (z : Pts Y (product Y m T)) ->
  Over-point Y (T i) (bs Y (product Y m T) z) = split {
  zero -> \ T i z -> efq i ;
  suc m | r -> \ T -> split {
   inl i -> \ z ->
    ((r (\ i -> T (inl i)) i (Two[Y,T (inr tt),product Y m (\ i -> T (inl i))].right z).1).1,
     trans (r (\ i -> T (inl i)) i (Two[Y,T (inr tt),product Y m (\ i -> T (inl i))].right z).1).2
      (Two[Y,T (inr tt),product Y m (\ i -> T (inl i))].right z).2) ;
   inr u -> \ z -> Pr.subst Top (\ v -> Over-point Y (T (inr v)) (bs Y (product Y (suc m) T) z)) tt u
    (MnSums[l].top-eq tt u) (Two[Y,T (inr tt),product Y m (\ i -> T (inl i))].left z) } } ;
} ;
