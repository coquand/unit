-- Multilinear maps out of a power (gabber-recollement, proof of Proposition
-- `cheap`: P(V^e) = P(V) (x) O^(e^n)), pointwise, without tensor products.
-- Write A^(e+1) = A + .. + A (EFFACE: power e A, e + 1 copies) and
-- Hom(A, U) for the module of linear maps (HOMMODULE).
--  (into)  Hom(A, B + C) = Hom(A, B) + Hom(A, C): f |-> (pr_1 o f, pr_2 o f),
--     with inverse (g, h) |-> (a |-> (g a, h a)); both composites are the
--     identity by definition of the pairs, and the operations of the sum
--     are componentwise.
--  (out)   Hom(A^(e+1), U) = Hom(A, U)^(e+1), by induction on e from
--     Hom(A + B, U) = Hom(A, U) + Hom(B, U) (HOMSUMS.Sum).
--  (in)    Hom(A, U^(j+1)) = Hom(A, U)^(j+1), by induction on j from (into).
--  (powers) With power P L 0 = L, power P L (k+1) = Hom(P, power P L k)
--     (MULTILINEAR), and count e 0 = 0, count e (k+1) = exponent (count e k) e
--     (SUMMANDS: (A^(c+1))^(e+1) = A^(exponent c e + 1)), so that
--     count e k + 1 = (e+1)^k:
--         power (P^(e+1)) L k = (power P L k)^(count e k + 1).
--     Induction on k: with Q = power P L k and c = count e k,
--         Hom(P^(e+1), power (P^(e+1)) L k) = Hom(P^(e+1), Q^(c+1))   (induction)
--           = Hom(P, Q^(c+1))^(e+1)                                (out)
--           = (Hom(P, Q)^(c+1))^(e+1)                              (in)
--           = Hom(P, Q)^(exponent c e + 1).                        (SUMMANDS.iterate)
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module HS = HomSums[l].Over[R,setR] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module SU = Summands[l].Over[MD.Module,MS.plus,\ a b c -> MS.Assoc[a,b,c].theorem,\ a b -> MS.Comm[a,b].theorem] ;
 hom (A U1 : MD.Module) : MD.Module = HM.At[A,U1].carrier ;
 -- (into)
 module Into (A B C : MD.Module) {
  module P2 = MS.Pair[B,C] ;
  module HS2 = HM.At[A,MS.plus B C] ;
  module HB = HM.At[A,B] ;
  module HC = HM.At[A,C] ;
  module Q = MS.Pair[HB.carrier,HC.carrier] ;
  parts (f : HS2.S.E) : Q.Carrier =
   ((\ a -> (f.1 a).1,\ x y -> ap (\ u -> u.1) (f.2.1 x y),\ c x -> ap (\ u -> u.1) (f.2.2 c x)),
    (\ a -> (f.1 a).2,\ x y -> ap (\ u -> u.2) (f.2.1 x y),\ c x -> ap (\ u -> u.2) (f.2.2 c x))) ;
  join (z : Q.Carrier) : HS2.S.E =
   (\ a -> (z.1.1 a,z.2.1 a),
    \ x y -> P2.pair-eq _ _ _ _ (z.1.2.1 x y) (z.2.2.1 x y),
    \ c x -> P2.pair-eq _ _ _ _ (z.1.2.2 c x) (z.2.2.2 c x)) ;
  join-parts (f : HS2.S.E) : Id HS2.S.E (join (parts f)) f = HS2.ext _ f (\ a -> refl (f.1 a)) ;
  parts-join (z : Q.Carrier) : Id Q.Carrier (parts (join z)) z =
   Q.pair-eq _ _ _ _ (HB.ext _ z.1 (\ a -> refl (z.1.1 a))) (HC.ext _ z.2 (\ a -> refl (z.2.1 a))) ;
  theorem : Id MD.Module HS2.carrier (MS.plus HB.carrier HC.carrier) =
   SIP.sip HS2.carrier (MS.plus HB.carrier HC.carrier)
    ((parts,Pr.qinv HS2.S.E Q.Carrier parts join parts-join join-parts),
     \ f f' -> Q.pair-eq _ _ _ _ (HB.ext _ _ (\ a -> refl (B.madd (f.1 a).1 (f'.1 a).1)))
      (HC.ext _ _ (\ a -> refl (C.madd (f.1 a).2 (f'.1 a).2))),
     \ c f -> Q.pair-eq _ _ _ _ (HB.ext _ _ (\ a -> refl (B.sm c (f.1 a).1)))
      (HC.ext _ _ (\ a -> refl (C.sm c (f.1 a).2)))) ;
 } ;
 -- by definition, A^(e+2) = A + A^(e+1) and power P L (k+1) = Hom(P, power P L k)
 power-suc (A : MD.Module) (e : Nat) : Id MD.Module (MS.EM.power (suc e) A) (MS.plus A (MS.EM.power e A)) =
  refl (MS.plus A (MS.EM.power e A)) ;
 multilinear-suc (P L1 : MD.Module) (k : Nat) : Id MD.Module (ML.power P L1 (suc k)) (hom P (ML.power P L1 k)) =
  refl (hom P (ML.power P L1 k)) ;
 -- (out)
 module Out (A U1 : MD.Module) (e : Nat) (r : Id MD.Module (hom (MS.EM.power e A) U1) (MS.EM.power e (hom A U1))) {
  theorem : Id MD.Module (hom (MS.EM.power (suc e) A) U1) (MS.EM.power (suc e) (hom A U1)) =
   Pr1.trans MD.Module (hom (MS.EM.power (suc e) A) U1) (hom (MS.plus A (MS.EM.power e A)) U1) (MS.EM.power (suc e) (hom A U1))
    (Pr1.ap MD.Module MD.Module (\ M -> hom M U1) (MS.EM.power (suc e) A) (MS.plus A (MS.EM.power e A)) (power-suc A e))
    (Pr1.trans MD.Module (hom (MS.plus A (MS.EM.power e A)) U1)
     (MS.plus (hom A U1) (hom (MS.EM.power e A) U1)) (MS.EM.power (suc e) (hom A U1))
     HS.Sum[A,MS.EM.power e A,U1].theorem
     (Pr1.trans MD.Module (MS.plus (hom A U1) (hom (MS.EM.power e A) U1)) (MS.plus (hom A U1) (MS.EM.power e (hom A U1)))
      (MS.EM.power (suc e) (hom A U1))
      (Pr1.ap MD.Module MD.Module (MS.plus (hom A U1)) (hom (MS.EM.power e A) U1) (MS.EM.power e (hom A U1)) r)
      (Pr1.sym MD.Module (MS.EM.power (suc e) (hom A U1)) (MS.plus (hom A U1) (MS.EM.power e (hom A U1))) (power-suc (hom A U1) e)))) ;
 } ;
 out (A U1 : MD.Module) : (e : Nat) -> Id MD.Module (hom (MS.EM.power e A) U1) (MS.EM.power e (hom A U1)) = split {
  zero -> refl (hom A U1) ;
  suc e | r -> Out[A,U1,e,r].theorem } ;
 -- (in)
 module In (A U1 : MD.Module) (j : Nat) (r : Id MD.Module (hom A (MS.EM.power j U1)) (MS.EM.power j (hom A U1))) {
  theorem : Id MD.Module (hom A (MS.EM.power (suc j) U1)) (MS.EM.power (suc j) (hom A U1)) =
   Pr1.trans MD.Module (hom A (MS.EM.power (suc j) U1)) (hom A (MS.plus U1 (MS.EM.power j U1))) (MS.EM.power (suc j) (hom A U1))
    (Pr1.ap MD.Module MD.Module (hom A) (MS.EM.power (suc j) U1) (MS.plus U1 (MS.EM.power j U1)) (power-suc U1 j))
    (Pr1.trans MD.Module (hom A (MS.plus U1 (MS.EM.power j U1)))
     (MS.plus (hom A U1) (hom A (MS.EM.power j U1))) (MS.EM.power (suc j) (hom A U1))
     Into[A,U1,MS.EM.power j U1].theorem
     (Pr1.trans MD.Module (MS.plus (hom A U1) (hom A (MS.EM.power j U1))) (MS.plus (hom A U1) (MS.EM.power j (hom A U1)))
      (MS.EM.power (suc j) (hom A U1))
      (Pr1.ap MD.Module MD.Module (MS.plus (hom A U1)) (hom A (MS.EM.power j U1)) (MS.EM.power j (hom A U1)) r)
      (Pr1.sym MD.Module (MS.EM.power (suc j) (hom A U1)) (MS.plus (hom A U1) (MS.EM.power j (hom A U1))) (power-suc (hom A U1) j)))) ;
 } ;
 into (A U1 : MD.Module) : (j : Nat) -> Id MD.Module (hom A (MS.EM.power j U1)) (MS.EM.power j (hom A U1)) = split {
  zero -> refl (hom A U1) ;
  suc j | r -> In[A,U1,j,r].theorem } ;
 -- (powers)
 count (e : Nat) : Nat -> Nat = split {
  zero -> zero ;
  suc k | c -> SU.exponent c e } ;
 -- by definition, count e (k+1) = exponent (count e k) e
 count-suc (e k : Nat) : Id Nat (count e (suc k)) (SU.exponent (count e k) e) = refl (SU.exponent (count e k) e) ;
 module Step (P L1 : MD.Module) (e k : Nat)
  (ih : Id MD.Module (ML.power (MS.EM.power e P) L1 k) (MS.EM.power (count e k) (ML.power P L1 k))) {
  theorem : Id MD.Module (ML.power (MS.EM.power e P) L1 (suc k)) (MS.EM.power (count e (suc k)) (ML.power P L1 (suc k))) =
   Pr1.trans MD.Module (ML.power (MS.EM.power e P) L1 (suc k)) (hom (MS.EM.power e P) (ML.power (MS.EM.power e P) L1 k))
    (MS.EM.power (count e (suc k)) (ML.power P L1 (suc k)))
    (multilinear-suc (MS.EM.power e P) L1 k)
   (Pr1.trans MD.Module (hom (MS.EM.power e P) (ML.power (MS.EM.power e P) L1 k))
    (hom (MS.EM.power e P) (MS.EM.power (count e k) (ML.power P L1 k)))
    (MS.EM.power (count e (suc k)) (ML.power P L1 (suc k)))
    (Pr1.ap MD.Module MD.Module (hom (MS.EM.power e P)) (ML.power (MS.EM.power e P) L1 k) (MS.EM.power (count e k) (ML.power P L1 k)) ih)
   (Pr1.trans MD.Module (hom (MS.EM.power e P) (MS.EM.power (count e k) (ML.power P L1 k)))
    (MS.EM.power e (hom P (MS.EM.power (count e k) (ML.power P L1 k))))
    (MS.EM.power (count e (suc k)) (ML.power P L1 (suc k)))
    (out P (MS.EM.power (count e k) (ML.power P L1 k)) e)
   (Pr1.trans MD.Module (MS.EM.power e (hom P (MS.EM.power (count e k) (ML.power P L1 k))))
    (MS.EM.power e (MS.EM.power (count e k) (hom P (ML.power P L1 k))))
    (MS.EM.power (count e (suc k)) (ML.power P L1 (suc k)))
    (Pr1.ap MD.Module MD.Module (MS.EM.power e) (hom P (MS.EM.power (count e k) (ML.power P L1 k)))
     (MS.EM.power (count e k) (hom P (ML.power P L1 k))) (into P (ML.power P L1 k) (count e k)))
   (Pr1.trans MD.Module (MS.EM.power e (MS.EM.power (count e k) (hom P (ML.power P L1 k))))
    (MS.EM.power (SU.exponent (count e k) e) (hom P (ML.power P L1 k)))
    (MS.EM.power (count e (suc k)) (ML.power P L1 (suc k)))
    (SU.iterate (hom P (ML.power P L1 k)) (count e k) e)
   (Pr1.trans MD.Module (MS.EM.power (SU.exponent (count e k) e) (hom P (ML.power P L1 k)))
    (MS.EM.power (count e (suc k)) (hom P (ML.power P L1 k)))
    (MS.EM.power (count e (suc k)) (ML.power P L1 (suc k)))
    (Pr1.ap Nat MD.Module (\ m -> MS.EM.power m (hom P (ML.power P L1 k))) (SU.exponent (count e k) e) (count e (suc k))
     (sym (count-suc e k)))
    (Pr1.ap MD.Module MD.Module (MS.EM.power (count e (suc k))) (hom P (ML.power P L1 k)) (ML.power P L1 (suc k))
     (Pr1.sym MD.Module (ML.power P L1 (suc k)) (hom P (ML.power P L1 k)) (multilinear-suc P L1 k)))))))) ;
 } ;
 powers (P L1 : MD.Module) (e : Nat) : (k : Nat) ->
  Id MD.Module (ML.power (MS.EM.power e P) L1 k) (MS.EM.power (count e k) (ML.power P L1 k)) = split {
  zero -> refl L1 ;
  suc k | ih -> Step[P,L1,e,k,ih].theorem } ;
} ;
