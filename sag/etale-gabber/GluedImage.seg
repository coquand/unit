-- The key step of gabber-recollement Lemma 3.6(3): a module that is free
-- after inverting a and after inverting b is glued along a matrix.
-- In the situation of GLUEDFREE, let E, F be L x L projectors over A whose
-- images in A_a are equivalent by q_a = (U_a, V_a), and in A_b by
-- q_b = (U_b, V_b) (EQUIVALENCE).  In C both give equivalences of the images
-- E, F of E and F (by the square), and
--     G = U_b V_a + (1 - F),   G' = U_a V_b + (1 - F)     (EQUIVALENCE.Pair)
-- are inverse (Cancel).  Then
--     Image E + Image (1 - F) ~ P_G                       (GLUEDMODULE, COMPLEMENTS)
--     (x, y) |-> (U_a x + y, U_b x + y).
-- (in) For E x = x and F y = 0, G (U_a x + y) = U_b x + y (transport).
-- (back) For (u, v) in P_G, V_b v = V_b G u = V_a u and
--   v - F v = G u - F G u = u - F u in C, so there are unique x, y in A^L
--   with images V_a u, V_b v and u - F u, v - F v (EQUALISER).  E x = x and
--   F y = 0 hold in A_a and A_b (E V = V, F (w - F w) = 0), hence in A.
-- (inverse) U_a V_a u + (u - F u) = u; and for E x = x, F y = 0,
--   V_a (U_a x + y) = x and (U_a x + y) - F (U_a x + y) = y.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R) (setAb : Pr.isSet Ab.R)
 (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (L : Nat) (E F : MnAlgebra[l].Over[A,setA,L].Mat)
 (hE : Id MnAlgebra[l].Over[A,setA,L].Mat (MnAlgebra[l].Over[A,setA,L].mmul E E) E)
 (hF : Id MnAlgebra[l].Over[A,setA,L].Mat (MnAlgebra[l].Over[A,setA,L].mmul F F) F)
 (qa : Equivalence[l].Over[Aa,setAa,L].Equivalent[MatrixMap[l].Over[A,Aa,setA,setAa,ia,L].map E,
   MatrixMap[l].Over[A,Aa,setA,setAa,ia,L].map F])
 (qb : Equivalence[l].Over[Ab,setAb,L].Equivalent[MatrixMap[l].Over[A,Ab,setA,setAb,ib,L].map E,
   MatrixMap[l].Over[A,Ab,setA,setAb,ib,L].map F]) {
 module G = GluedModule[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,L] ;
 module Eq = Equaliser[l].Over[A,Aa,Ab,C,setA,setAa,setAb,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal] ;
 module VA = Vectors[l].Over[A,setA,L] ;
 module MA = VA.MR ;
 module IA = Vectors[l].Map[A,Aa,setA,setAa,ia,L] ;
 module IB = Vectors[l].Map[A,Ab,setA,setAb,ib,L] ;
 module EqA = Equivalence[l].Over[Aa,setAa,L] ;
 module EqB = Equivalence[l].Over[Ab,setAb,L] ;
 module EqC = Equivalence[l].Over[C,setC,L] ;
 module PJ = Projectors[l].Over[A,setA] ;
 module MI = PJ.MI ;
 module IM = MatrixMap[l].Invertible[C,setC,L] ;
 -- E and F over A_a, A_b and C
 Ea : G.VAa.MR.Mat = IA.MM.map E ;
 Fa : G.VAa.MR.Mat = IA.MM.map F ;
 Eb : G.VAb.MR.Mat = IB.MM.map E ;
 Fb : G.VAb.MR.Mat = IB.MM.map F ;
 Ec : G.MC.Mat = G.JA.MM.map Ea ;
 Fc : G.MC.Mat = G.JA.MM.map Fa ;
 square-mat (X : MA.Mat) : Id G.MC.Mat (G.JB.MM.map (IB.MM.map X)) (G.JA.MM.map (IA.MM.map X)) =
  G.MC.mat-eq (G.JB.MM.map (IB.MM.map X)) (G.JA.MM.map (IA.MM.map X)) (\ i j -> sym (square (X i j))) ;
 idem-a : Id G.VAa.MR.Mat (G.VAa.MR.mmul Fa Fa) Fa = trans (sym (IA.MM.map-mul F F)) (ap IA.MM.map hF) ;
 idem-b : Id G.VAb.MR.Mat (G.VAb.MR.mmul Fb Fb) Fb = trans (sym (IB.MM.map-mul F F)) (ap IB.MM.map hF) ;
 idem-c : Id G.MC.Mat (G.MC.mmul Fc Fc) Fc = trans (sym (G.JA.MM.map-mul Fa Fa)) (ap G.JA.MM.map idem-a) ;
 -- the two equivalences in C
 qc-a : EqC.Equivalent[Ec,Fc] = Equivalence[l].Map[Aa,C,setAa,setC,ja,L].map Ea Fa qa ;
 qc-b : EqC.Equivalent[Ec,Fc] = EqC.retarget (G.JB.MM.map Eb) (G.JB.MM.map Fb) Ec Fc (square-mat E) (square-mat F)
  (Equivalence[l].Map[Ab,C,setAb,setC,jb,L].map Eb Fb qb) ;
 module SA = EqA.Split[Ea,Fa,idem-a,qa] ;
 module SB = EqB.Split[Eb,Fb,idem-b,qb] ;
 module P = EqC.Pair[Ec,Fc,idem-c,qc-b,qc-a] ;
 -- the gluing matrix and its inverse
 g : G.MC.Mat = P.matrix ;
 g' : G.MC.Mat = EqC.Pair[Ec,Fc,idem-c,qc-a,qc-b].matrix ;
 inverse : IM.Inverse[g,g'] =
  new IM.Inverse[g,g',EqC.Cancel[Ec,Fc,idem-c,qc-b,qc-a].cancel,EqC.Cancel[Ec,Fc,idem-c,qc-a,qc-b].cancel] ;

 -- the source: Image E + Image (1 - F)
 PE : PJ.Projector = new PJ.Projector[L,E,hE] ;
 PF : PJ.Projector = new PJ.Projector[L,F,hF] ;
 module IE = PJ.Image[PE] ;
 module CF = Complements[l].Over[A,setA].Complement[PF] ;
 module IK = CF.IC ;
 module T = SP.Pair[A,IE.image,IK.image] ;
 module PG = G.Glue[g] ;
 -- the image in C of a vector of A^L, either way round the square
 lift (w : VA.Vec) : G.VC.Vec = G.JA.map (IA.map w) ;
 lift-b (w : VA.Vec) : Id G.VC.Vec (G.JB.map (IB.map w)) (lift w) = G.VC.vec-eq _ _ (\ i -> sym (square (w i))) ;
 -- E x = x and F y = 0 in A_a, A_b and C
 fix-a (x : IE.Carrier) : Id G.VAa.Vec (G.VAa.act Ea (IA.map (IE.value x))) (IA.map (IE.value x)) =
  trans (sym (IA.map-act E (IE.value x))) (ap IA.map (IE.member x)) ;
 fix-b (x : IE.Carrier) : Id G.VAb.Vec (G.VAb.act Eb (IB.map (IE.value x))) (IB.map (IE.value x)) =
  trans (sym (IB.map-act E (IE.value x))) (ap IB.map (IE.member x)) ;
 fix-c (x : IE.Carrier) : Id G.VC.Vec (G.VC.act Ec (lift (IE.value x))) (lift (IE.value x)) =
  trans (sym (G.JA.map-act Ea (IA.map (IE.value x)))) (ap G.JA.map (fix-a x)) ;
 kill-a (y : IK.Carrier) : Id G.VAa.Vec (G.VAa.act Fa (IA.map (IK.value y))) G.VAa.vzero =
  trans (sym (IA.map-act F (IK.value y))) (trans (ap IA.map (CF.kills-image y)) IA.map-zero) ;
 kill-b (y : IK.Carrier) : Id G.VAb.Vec (G.VAb.act Fb (IB.map (IK.value y))) G.VAb.vzero =
  trans (sym (IB.map-act F (IK.value y))) (trans (ap IB.map (CF.kills-image y)) IB.map-zero) ;
 kill-c (y : IK.Carrier) : Id G.VC.Vec (G.VC.act Fc (lift (IK.value y))) G.VC.vzero =
  trans (sym (G.JA.map-act Fa (IA.map (IK.value y)))) (trans (ap G.JA.map (kill-a y)) G.JA.map-zero) ;

 -- (in)
 left (z : T.Carrier) : G.VAa.Vec = G.VAa.vadd (G.VAa.act qa.u (IA.map (IE.value z.1))) (IA.map (IK.value z.2)) ;
 right (z : T.Carrier) : G.VAb.Vec = G.VAb.vadd (G.VAb.act qb.u (IB.map (IE.value z.1))) (IB.map (IK.value z.2)) ;
 -- the images in C of the two sides
 left-c (z : T.Carrier) : Id G.VC.Vec (G.JA.map (left z))
  (G.VC.vadd (G.VC.act qc-a.u (lift (IE.value z.1))) (lift (IK.value z.2))) =
  trans (G.JA.map-add (G.VAa.act qa.u (IA.map (IE.value z.1))) (IA.map (IK.value z.2)))
   (ap (\ t -> G.VC.vadd t (lift (IK.value z.2))) (G.JA.map-act qa.u (IA.map (IE.value z.1)))) ;
 right-c (z : T.Carrier) : Id G.VC.Vec (G.JB.map (right z))
  (G.VC.vadd (G.VC.act qc-b.u (lift (IE.value z.1))) (lift (IK.value z.2))) =
  trans (G.JB.map-add (G.VAb.act qb.u (IB.map (IE.value z.1))) (IB.map (IK.value z.2)))
   (cong2 G.VC.Vec G.VC.vadd _ _ _ _
    (trans (G.JB.map-act qb.u (IB.map (IE.value z.1))) (ap (G.VC.act qc-b.u) (lift-b (IE.value z.1))))
    (lift-b (IK.value z.2))) ;
 member (z : T.Carrier) : Id G.VC.Vec (G.JB.map (right z)) (G.VC.act g (G.JA.map (left z))) =
  calc G.VC.Vec { G.JB.map (right z)
    =< right-c z > G.VC.vadd (G.VC.act qc-b.u (lift (IE.value z.1))) (lift (IK.value z.2))
    =< sym (P.transport (lift (IE.value z.1)) (lift (IK.value z.2)) (fix-c z.1) (kill-c z.2)) >
       G.VC.act g (G.VC.vadd (G.VC.act qc-a.u (lift (IE.value z.1))) (lift (IK.value z.2)))
    =< ap (G.VC.act g) (sym (left-c z)) > G.VC.act g (G.JA.map (left z)) } ;
 forward (z : T.Carrier) : PG.Carrier = PG.point (left z) (right z) (member z) ;

 -- (back)  vectors of A^L from compatible images, and their uniqueness
 module Glue (u : G.VAa.Vec) (v : G.VAb.Vec) (h : Id G.VC.Vec (G.JA.map u) (G.JB.map v)) {
  vector : VA.Vec = \ i -> (Eq.preimage (u i) (v i) (G.VC.entry _ _ h i)).1 ;
  image-a : Id G.VAa.Vec (IA.map vector) u = G.VAa.vec-eq _ _ (\ i -> (Eq.preimage (u i) (v i) (G.VC.entry _ _ h i)).2.1) ;
  image-b : Id G.VAb.Vec (IB.map vector) v = G.VAb.vec-eq _ _ (\ i -> (Eq.preimage (u i) (v i) (G.VC.entry _ _ h i)).2.2) ;
 } ;
 unique (r r' : VA.Vec) (ha : Id G.VAa.Vec (IA.map r) (IA.map r')) (hb : Id G.VAb.Vec (IB.map r) (IB.map r')) :
  Id VA.Vec r r' = VA.vec-eq r r' (\ i -> Eq.Unique[r i,r' i,G.VAa.entry _ _ ha i,G.VAb.entry _ _ hb i].equal) ;
 -- the image in C of w - F w
 comp-a (u : G.VAa.Vec) : Id G.VC.Vec (G.JA.map (SA.comp u)) (P.SQ.comp (G.JA.map u)) =
  trans (G.JA.map-add u (G.VAa.vneg (G.VAa.act Fa u)))
   (ap (G.VC.vadd (G.JA.map u)) (trans (G.JA.map-neg (G.VAa.act Fa u)) (ap G.VC.vneg (G.JA.map-act Fa u)))) ;
 comp-b (v : G.VAb.Vec) : Id G.VC.Vec (G.JB.map (SB.comp v)) (P.SQ.comp (G.JB.map v)) =
  trans (G.JB.map-add v (G.VAb.vneg (G.VAb.act Fb v)))
   (ap (G.VC.vadd (G.JB.map v)) (trans (G.JB.map-neg (G.VAb.act Fb v))
    (ap G.VC.vneg (trans (G.JB.map-act Fb v) (ap (\ Z -> G.VC.act Z (G.JB.map v)) (square-mat F)))))) ;
 module Back (w : PG.Carrier) {
  u : G.VAa.Vec = PG.left w ;
  v : G.VAb.Vec = PG.right w ;
  -- V_a u and V_b v agree in C
  agree-x : Id G.VC.Vec (G.JA.map (G.VAa.act qa.v u)) (G.JB.map (G.VAb.act qb.v v)) =
   calc G.VC.Vec { G.JA.map (G.VAa.act qa.v u)
     =< G.JA.map-act qa.v u > G.VC.act qc-a.v (G.JA.map u)
     =< sym (P.v-matrix (G.JA.map u)) > G.VC.act qc-b.v (G.VC.act g (G.JA.map u))
     =< ap (G.VC.act qc-b.v) (sym (PG.member w)) > G.VC.act qc-b.v (G.JB.map v)
     =< sym (G.JB.map-act qb.v v) > G.JB.map (G.VAb.act qb.v v) } ;
  -- u - F u and v - F v agree in C
  agree-y : Id G.VC.Vec (G.JA.map (SA.comp u)) (G.JB.map (SB.comp v)) =
   calc G.VC.Vec { G.JA.map (SA.comp u)
     =< comp-a u > P.SQ.comp (G.JA.map u)
     =< sym (P.comp-matrix (G.JA.map u)) > P.SQ.comp (G.VC.act g (G.JA.map u))
     =< ap P.SQ.comp (sym (PG.member w)) > P.SQ.comp (G.JB.map v)
     =< sym (comp-b v) > G.JB.map (SB.comp v) } ;
  module X = Glue[G.VAa.act qa.v u,G.VAb.act qb.v v,agree-x] ;
  module Y = Glue[SA.comp u,SB.comp v,agree-y] ;
  -- E x = x
  x-member : IE.Member X.vector = unique (VA.act E X.vector) X.vector
   (calc G.VAa.Vec { IA.map (VA.act E X.vector)
     =< IA.map-act E X.vector > G.VAa.act Ea (IA.map X.vector)
     =< ap (G.VAa.act Ea) X.image-a > G.VAa.act Ea (G.VAa.act qa.v u)
     =< SA.Q.xv u > G.VAa.act qa.v u
     =< sym X.image-a > IA.map X.vector })
   (calc G.VAb.Vec { IB.map (VA.act E X.vector)
     =< IB.map-act E X.vector > G.VAb.act Eb (IB.map X.vector)
     =< ap (G.VAb.act Eb) X.image-b > G.VAb.act Eb (G.VAb.act qb.v v)
     =< SB.Q.xv v > G.VAb.act qb.v v
     =< sym X.image-b > IB.map X.vector }) ;
  -- F y = 0
  y-kill : Id VA.Vec (VA.act F Y.vector) VA.vzero = unique (VA.act F Y.vector) VA.vzero
   (calc G.VAa.Vec { IA.map (VA.act F Y.vector)
     =< IA.map-act F Y.vector > G.VAa.act Fa (IA.map Y.vector)
     =< ap (G.VAa.act Fa) Y.image-a > G.VAa.act Fa (SA.comp u)
     =< SA.f-comp u > G.VAa.vzero
     =< sym IA.map-zero > IA.map VA.vzero })
   (calc G.VAb.Vec { IB.map (VA.act F Y.vector)
     =< IB.map-act F Y.vector > G.VAb.act Fb (IB.map Y.vector)
     =< ap (G.VAb.act Fb) Y.image-b > G.VAb.act Fb (SB.comp v)
     =< SB.f-comp v > G.VAb.vzero
     =< sym IB.map-zero > IB.map VA.vzero }) ;
  y-member : IK.Member Y.vector =
   trans (CF.act Y.vector)
    (trans (ap (\ t -> VA.vadd Y.vector (VA.vneg t)) y-kill)
     (VA.vec-eq _ _ (\ i -> trans (ap (A.add (Y.vector i)) RL[A].neg-zero) (A.addZ (Y.vector i))))) ;
  point : T.Carrier = ((X.vector,x-member),(Y.vector,y-member)) ;
 } ;

 -- (inverse)
 forward-back (w : PG.Carrier) : Id PG.Carrier (forward Back[w].point) w =
  PG.ext (forward Back[w].point) w
   (trans (cong2 G.VAa.Vec G.VAa.vadd _ _ _ _ (ap (G.VAa.act qa.u) Back[w].X.image-a) Back[w].Y.image-a)
    (SA.u-v-comp (PG.left w)))
   (trans (cong2 G.VAb.Vec G.VAb.vadd _ _ _ _ (ap (G.VAb.act qb.u) Back[w].X.image-b) Back[w].Y.image-b)
    (SB.u-v-comp (PG.right w))) ;
 back-forward (z : T.Carrier) : Id T.Carrier Back[forward z].point z =
  T.ext Back[forward z].point z
   (IE.ext Back[forward z].point.1 z.1 (unique Back[forward z].X.vector (IE.value z.1)
     (trans Back[forward z].X.image-a (SA.v-sum (IA.map (IE.value z.1)) (IA.map (IK.value z.2)) (fix-a z.1) (kill-a z.2)))
     (trans Back[forward z].X.image-b (SB.v-sum (IB.map (IE.value z.1)) (IB.map (IK.value z.2)) (fix-b z.1) (kill-b z.2)))))
   (IK.ext Back[forward z].point.2 z.2 (unique Back[forward z].Y.vector (IK.value z.2)
     (trans Back[forward z].Y.image-a (SA.comp-sum (IA.map (IE.value z.1)) (IA.map (IK.value z.2)) (kill-a z.2)))
     (trans Back[forward z].Y.image-b (SB.comp-sum (IB.map (IE.value z.1)) (IB.map (IK.value z.2)) (kill-b z.2))))) ;
 -- linearity
 left-add (z z' : T.Carrier) : Id G.VAa.Vec (left (T.product.madd z z')) (G.VAa.vadd (left z) (left z')) =
  calc G.VAa.Vec { left (T.product.madd z z')
    =< cong2 G.VAa.Vec G.VAa.vadd _ _ _ _
        (trans (ap (G.VAa.act qa.u) (IA.map-add (IE.value z.1) (IE.value z'.1)))
         (G.VAa.act-add qa.u (IA.map (IE.value z.1)) (IA.map (IE.value z'.1))))
        (IA.map-add (IK.value z.2) (IK.value z'.2)) >
       G.VAa.vadd (G.VAa.vadd (G.VAa.act qa.u (IA.map (IE.value z.1))) (G.VAa.act qa.u (IA.map (IE.value z'.1))))
        (G.VAa.vadd (IA.map (IK.value z.2)) (IA.map (IK.value z'.2)))
    =< G.VAa.vec-eq _ _ (\ i -> RL[Aa].swap (G.VAa.act qa.u (IA.map (IE.value z.1)) i) (G.VAa.act qa.u (IA.map (IE.value z'.1)) i)
        (IA.map (IK.value z.2) i) (IA.map (IK.value z'.2) i)) > G.VAa.vadd (left z) (left z') } ;
 right-add (z z' : T.Carrier) : Id G.VAb.Vec (right (T.product.madd z z')) (G.VAb.vadd (right z) (right z')) =
  calc G.VAb.Vec { right (T.product.madd z z')
    =< cong2 G.VAb.Vec G.VAb.vadd _ _ _ _
        (trans (ap (G.VAb.act qb.u) (IB.map-add (IE.value z.1) (IE.value z'.1)))
         (G.VAb.act-add qb.u (IB.map (IE.value z.1)) (IB.map (IE.value z'.1))))
        (IB.map-add (IK.value z.2) (IK.value z'.2)) >
       G.VAb.vadd (G.VAb.vadd (G.VAb.act qb.u (IB.map (IE.value z.1))) (G.VAb.act qb.u (IB.map (IE.value z'.1))))
        (G.VAb.vadd (IB.map (IK.value z.2)) (IB.map (IK.value z'.2)))
    =< G.VAb.vec-eq _ _ (\ i -> RL[Ab].swap (G.VAb.act qb.u (IB.map (IE.value z.1)) i) (G.VAb.act qb.u (IB.map (IE.value z'.1)) i)
        (IB.map (IK.value z.2) i) (IB.map (IK.value z'.2) i)) > G.VAb.vadd (right z) (right z') } ;
 left-scale (c : A.R) (z : T.Carrier) : Id G.VAa.Vec (left (T.product.sm c z)) (G.VAa.vscale (ia.1 c) (left z)) =
  calc G.VAa.Vec { left (T.product.sm c z)
    =< cong2 G.VAa.Vec G.VAa.vadd _ _ _ _
        (trans (ap (G.VAa.act qa.u) (IA.map-scale c (IE.value z.1))) (G.VAa.act-scale qa.u (ia.1 c) (IA.map (IE.value z.1))))
        (IA.map-scale c (IK.value z.2)) >
       G.VAa.vadd (G.VAa.vscale (ia.1 c) (G.VAa.act qa.u (IA.map (IE.value z.1)))) (G.VAa.vscale (ia.1 c) (IA.map (IK.value z.2)))
    =< G.VAa.vec-eq _ _ (\ i -> sym (Aa.dist (ia.1 c) (G.VAa.act qa.u (IA.map (IE.value z.1)) i) (IA.map (IK.value z.2) i))) >
       G.VAa.vscale (ia.1 c) (left z) } ;
 right-scale (c : A.R) (z : T.Carrier) : Id G.VAb.Vec (right (T.product.sm c z)) (G.VAb.vscale (ib.1 c) (right z)) =
  calc G.VAb.Vec { right (T.product.sm c z)
    =< cong2 G.VAb.Vec G.VAb.vadd _ _ _ _
        (trans (ap (G.VAb.act qb.u) (IB.map-scale c (IE.value z.1))) (G.VAb.act-scale qb.u (ib.1 c) (IB.map (IE.value z.1))))
        (IB.map-scale c (IK.value z.2)) >
       G.VAb.vadd (G.VAb.vscale (ib.1 c) (G.VAb.act qb.u (IB.map (IE.value z.1)))) (G.VAb.vscale (ib.1 c) (IB.map (IK.value z.2)))
    =< G.VAb.vec-eq _ _ (\ i -> sym (Ab.dist (ib.1 c) (G.VAb.act qb.u (IB.map (IE.value z.1)) i) (IB.map (IK.value z.2) i))) >
       G.VAb.vscale (ib.1 c) (right z) } ;
 iso : MI.Iso[T.product,PG.glued] = MI.make T.product PG.glued forward (\ w -> Back[w].point)
  (\ z z' -> PG.ext (forward (T.product.madd z z')) (PG.add (forward z) (forward z')) (left-add z z') (right-add z z'))
  (\ c z -> PG.ext (forward (T.product.sm c z)) (PG.scale c (forward z)) (left-scale c z) (right-scale c z))
  forward-back back-forward ;
 -- the projector E + (1 - F) presents P_G
 presenter : PJ.Projector = PJ.Sum[PE,CF.projector].projector ;
 presents : MI.Iso[PJ.Image[presenter].image,PG.glued] =
  MI.compose (PJ.Image[presenter].image) T.product PG.glued
   ProjectorSums[l].Over[A,setA].SumImage[PE,CF.projector].iso iso ;
