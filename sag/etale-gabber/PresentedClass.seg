-- The class of a presented family (CHEAP-DESIGN.md, 2, (KEY)).  X = Spec Alg
-- (Alg f.p.), Mx a family of modules over X, q(x) the matrix of values at x
-- of a matrix q over Alg.
--  (presented)  If frame data (s_k, d_k) of Mx (FRAMEPROJECTOR), of the size
--     of a projector q, have values d_i(s_j x) = q_ij(x) at every x, the
--     entries of their projector are back(x |-> d_i(s_j x)) = q_ij (SQC: ext
--     and back-beta), so its image has the vectors of the image of q, and
--     every projector representing the global sections has the class [q]
--     (REPRESENTATIONS.Compare).
--  (columns)  Over R, for an idempotent matrix e, I e (MATRIXTENSOR) has the
--     frame of the columns e_j = (e_ij)_i (fixed, since (e e)_ij = e_ij) with
--     the coordinate forms w |-> w_i: for w in I e,
--         (sum_k w_k e_k)_i = sum_k w_k e_ik = (e w)_i = w_i;
--     its matrix is (e_j)_i = e_ij.
--  (key)  If Mx x = I q(x) at every x (q a projector over Alg), the columns
--     frame of I q(x), carried to Mx x, gives frame data with values
--     q_ij(x) (a carried frame has the same values, by J); so by
--     (presented) every representing projector has the class [q].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 -- a carried frame has the same values d_i(s_j)
 value (M : MD.Module) (r : Nat) (fr : FR.Frame[M,r]) (i j : Fin r) : R.R = (fr.form i).1 (fr.vector j) ;
 carry-value (M N : MD.Module) (h : Id MD.Module M N) (r : Nat) (fr : FR.Frame[M,r]) (i j : Fin r) :
  Id R.R (value N r (Datum[l].Over[R,setR,axioms].carry M N h r fr) i j) (value M r fr i j) =
  idJ MD.Module M (\ N' h' -> Id R.R (value N' r (Datum[l].Over[R,setR,axioms].carry M N' h' r fr) i j) (value M r fr i j))
   (refl (value M r fr i j)) N h ;
 -- (columns)
 module Columns (N : Nat) (e : Vectors[l].Over[R,setR,N].MR.Mat)
  (idem : Id Vectors[l].Over[R,setR,N].MR.Mat (Vectors[l].Over[R,setR,N].MR.mmul e e) e) {
  module IE = MT.Image[N,e] ;
  module SE = ModuleFiniteSums[l].Over[R,setR,IE.carrier] ;
  column (j : Fin N) : IE.S.E = (\ i -> e i j,ap (\ Z -> \ i -> Z i j) idem) ;
  coordinate (i : Fin N) : FR.HM.At[IE.carrier,MD.regular].S.E =
   (\ w -> IE.value w i,\ w w' -> refl (R.add (IE.value w i) (IE.value w' i)),\ c w -> refl (R.mul c (IE.value w i))) ;
  -- the i-th coordinate of a sum is the sum of the i-th coordinates
  sum-at (i : Fin N) (n : Nat) (ws : Fin n -> IE.S.E) :
   Id R.R (IE.value (SE.sum n ws) i) (RS.sum n (\ k -> IE.value (ws k) i)) =
   SE.map (\ w -> IE.value w i) (refl R.z) (\ w w' -> refl (R.add (IE.value w i) (IE.value w' i))) n ws ;
  law-at (w : IE.S.E) (i : Fin N) :
   Id R.R (IE.value (SE.sum N (\ k -> IE.carrier.sm (IE.value w k) (column k))) i) (IE.value w i) =
   calc R.R { IE.value (SE.sum N (\ k -> IE.carrier.sm (IE.value w k) (column k))) i
     =< sum-at i N (\ k -> IE.carrier.sm (IE.value w k) (column k)) >
        RS.sum N (\ k -> R.mul (IE.value w k) (e i k))
     =< RS.sum-cong N (\ k -> R.mul (IE.value w k) (e i k)) (\ k -> R.mul (e i k) (IE.value w k)) (\ k -> R.mulC (IE.value w k) (e i k)) >
        IE.V.act e (IE.value w) i
     =< IE.V.entry _ _ w.2 i > IE.value w i } ;
  frame : FR.Frame[IE.carrier,N] = new FR.Frame[IE.carrier,N,column,coordinate,
   \ w -> IE.ext _ w (IE.V.vec-eq _ _ (law-at w))] ;
  -- by definition, the values of the frame are the entries of e
  column-value (i j : Fin N) : Id R.R (value IE.carrier N frame i j) (e i j) = refl (e i j) ;
 } ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (Mx : C.Spec Alg -> MD.Module) {
  module FP = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Mx] ;
  module RE = Representations[l].Over[R,setR,axioms].At[Alg,fp,Mx] ;
  module K = K0[l].Over[Alg.ring,Alg.set] ;
  -- frame data restrict at x to a frame of Mx x
  fibre (w : FP.Data) (x : C.Spec Alg) : FR.Frame[Mx x,w.size] =
   new FR.Frame[Mx x,w.size,\ k -> w.section k x,\ k -> w.form k x,w.law x] ;
  -- (presented)  frame data of the size of q with the values of q
  module Presented (q : FP.PJ.Projector) (section : Fin q.size -> FP.Sections) (form : Fin q.size -> FP.Forms)
   (law : (x : C.Spec Alg) (m : (Mx x).M) ->
     Id (Mx x).M (ModuleFiniteSums[l].Over[R,setR,Mx x].sum q.size (\ k -> (Mx x).sm ((form k x).1 m) (section k x))) m)
   (values : (i j : Fin q.size) (x : C.Spec Alg) -> Id R.R ((form i x).1 (section j x)) (x.1.1 (q.matrix i j))) {
   frame-data : FP.Data = new FP.Data[q.size,section,form,law] ;
   module FD = FP.From[frame-data] ;
   entries (i j : Fin q.size) : Id Alg.ring.R (FD.entry i j) (q.matrix i j) =
    FP.ext (FD.entry i j) (q.matrix i j) (\ x -> trans (FD.beta i j x) (values i j x)) ;
   matrix : Id FD.MN.Mat FD.entry q.matrix = FD.MN.mat-eq FD.entry q.matrix entries ;
   -- the images of FD.projector and q have the same vectors
   module IF = FP.PJ.Image[FD.projector] ;
   module IQ = FP.PJ.Image[q] ;
   to (v : IF.Carrier) : IQ.Carrier = (IF.value v,trans (ap (\ Z -> IQ.V.act Z (IF.value v)) (sym matrix)) (IF.member v)) ;
   from (v : IQ.Carrier) : IF.Carrier = (IQ.value v,trans (ap (\ Z -> IQ.V.act Z (IQ.value v)) matrix) (IQ.member v)) ;
   iso : K.Iso FD.projector q = K.MI.make IF.image IQ.image to from
    (\ v v' -> IQ.ext (to (IF.add v v')) (IQ.add (to v) (to v')) (refl (IQ.V.vadd (IF.value v) (IF.value v'))))
    (\ a v -> IQ.ext (to (IF.scale a v)) (IQ.scale a (to v)) (refl (IQ.V.vscale a (IF.value v))))
    (\ v -> IQ.ext (to (from v)) v (refl (IQ.value v)))
    (\ v -> IF.ext (from (to v)) v (refl (IF.value v))) ;
   theorem (p : FP.PJ.Projector) (rp : FP.Representation p) : Id K.K0.R (K.class p) (K.class q) =
    trans (RE.Compare[p,FD.projector,rp,FD.representation].same) (K.class-iso FD.projector q iso) ;
  } ;
  -- (key)
  module Key (q : FP.PJ.Projector)
   (h : (x : C.Spec Alg) -> Id MD.Module (Mx x) (MT.I q.size (\ i j -> x.1.1 (q.matrix i j)))) {
   module MQ = MnAlgebra[l].Over[Alg.ring,Alg.set,q.size] ;
   module VR = Vectors[l].Over[R,setR,q.size] ;
   at (x : C.Spec Alg) : VR.MR.Mat = \ i j -> x.1.1 (q.matrix i j) ;
   idempotent-at (x : C.Spec Alg) (i j : Fin q.size) : Id R.R (VR.MR.mmul (at x) (at x) i j) (at x i j) =
    trans (sym (StandardOpens[l].SumMap[Alg.ring,R,x.1].combination q.size (q.matrix i) (\ k -> q.matrix k j)))
     (ap (\ Z -> x.1.1 (Z i j)) q.idempotent) ;
   module CO (x : C.Spec Alg) { module F = Columns[q.size,at x,VR.MR.mat-eq _ _ (idempotent-at x)] ; } ;
   frame (x : C.Spec Alg) : FR.Frame[Mx x,q.size] =
    Datum[l].Over[R,setR,axioms].carry (MT.I q.size (at x)) (Mx x) (Pr1.sym MD.Module (Mx x) (MT.I q.size (at x)) (h x)) q.size CO[x].F.frame ;
   values (i j : Fin q.size) (x : C.Spec Alg) : Id R.R (((frame x).form i).1 ((frame x).vector j)) (x.1.1 (q.matrix i j)) =
    carry-value (MT.I q.size (at x)) (Mx x) (Pr1.sym MD.Module (Mx x) (MT.I q.size (at x)) (h x)) q.size CO[x].F.frame i j ;
   module PR = Presented[q,\ k x -> (frame x).vector k,\ k x -> (frame x).form k,\ x -> (frame x).law,values] ;
   theorem (p : FP.PJ.Projector) (rp : FP.Representation p) : Id K.K0.R (K.class p) (K.class q) = PR.theorem p rp ;
  } ;
 } ;
} ;
