-- Denominator clearing for any algebra satisfying the canonical localization
-- universal property. Neither finite presentation nor geometric axioms are used.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Relative (A : CRing) (setA : Pr.isSet A.R) (f : A.R) {
 module Rel = LocalizationNilpotence[l].Relative[A,setA,f] ;
 module PC = Rel.PC ;
 module K = PC.K ;
 module D = PC.D ;
 module X = PC.X ;
 module Lin = Rel.Lin ;
 module Pow = Rel.Pow ;
 module T = PC.T ;
 Witness (a : A.R) : U l = (n : Nat) * Id A.R (A.mul (Pow.power f n) a) A.z ;
 Vanishes (a : A.R) : U l = Tr.Trunc[Witness a].carrier ;
 RawWitness (a : A.R) : U l =
  (q : PC.Raw.P) * PC.Raw.peq (PC.M.pmul (Lin.linear f) q) (cons a nil) ;
 PolynomialWitness (a : A.R) : U l =
  (q : X.Carrier) * Id X.Carrier (X.mulQ (X.include (Lin.linear f)) q) (X.constant a) ;
 polynomial (a : A.R) (w : T.Ideal.Certificate (T.ev (cst a)) (T.ev D.zeroE)) :
  PolynomialWitness a =
  (w.1,sym (trans w.2
   (trans (ap (\ z -> X.addQ z (X.mulQ (X.include (Lin.linear f)) w.1)) T.zero-value)
    (RL[X.ring].zl (X.mulQ (X.include (Lin.linear f)) w.1))))) ;
 raw (a : A.R) (w : PolynomialWitness a) (p : PC.Representatives w.1) : RawWitness a =
  (p.1,X.Q.effective (PC.M.pmul (Lin.linear f) p.1) (cons a nil)
   (trans (sym (X.Multiply.beta (Lin.linear f) p.1))
    (trans (ap (X.mulQ (X.include (Lin.linear f))) p.2) w.2))) ;
 annihilated (a : A.R) (w : PolynomialWitness a) : Vanishes a =
  Tr.Trunc[PC.Representatives w.1].induction @l (\ t -> Vanishes a)
   (\ t -> Tr.Trunc[Witness a].proposition)
   (\ p -> Tr.Trunc[Witness a].inc
    (len {A.R} p.1,Lin.annihilate f p.1 a (raw a w p).2)) (PC.representatives w.1) ;
 kernel (a : A.R) (h : Id K.A.Carrier (K.A.constant a) K.A.zeroQ) : Vanishes a =
  Tr.Trunc[T.Ideal.Certificate (T.ev (cst a)) (T.ev D.zeroE)].induction @l
   (\ t -> Vanishes a) (\ t -> Tr.Trunc[Witness a].proposition)
   (\ w -> annihilated a (polynomial a w))
   (PC.Interpretation.certificate (cst a) D.zeroE (K.A.Q.effective (cst a) D.zeroE h)) ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module At (A L : C.Algebra) (f : A.ring.R) (inc : C.Hom A L)
  (loc : I.Localizes A L f inc) {
  module Rel = Relative[A.ring,A.set,f] ;
  module Model = LocalizationNilpotence[l].Over[R,setR].Model[A,f] ;
  module Pow = AffinePowers[l].Over[A.ring] ;
  module LPow = AffinePowers[l].Over[L.ring] ;
  module LL = RL[L.ring] ;
  Witness : A.ring.R -> U l = Rel.Witness ;
  Vanishes : A.ring.R -> U l = Rel.Vanishes ;
  comparison : C.Hom L Model.target = (loc.2 Model.target).sec (Model.inclusion,Model.inverse) ;
  comparison-beta (a : A.ring.R) :
   Id Model.target.ring.R (comparison.1.1 (inc.1.1 a)) (Model.inclusion.1.1 a) =
   Pr.ap (I.LocalData A Model.target f) Model.target.ring.R (\ d -> d.1.1.1 a) _ _
    ((loc.2 Model.target).sec-eq (Model.inclusion,Model.inverse)) ;
  clear (a : A.ring.R) (h : Id L.ring.R (inc.1.1 a) L.ring.z) : Vanishes a =
   Rel.kernel a (trans (sym (comparison-beta a))
    (trans (ap comparison.1.1 h) (RingHom[l].zero L.ring Model.target.ring comparison.1))) ;
  witness-zero (a : A.ring.R) (w : Witness a) : Id L.ring.R (inc.1.1 a) L.ring.z =
   LL.unit-reg (LPow.power (inc.1.1 f) w.1) (inc.1.1 a)
    (LPow.Units[L.set].power-unit (inc.1.1 f) loc.1 w.1)
    (trans (ap (\ t -> L.ring.mul t (inc.1.1 a))
      (sym (AffinePowers[l].power-map A.ring L.ring inc.1 f w.1)))
     (trans (sym (inc.1.2.2.2 (Pow.power f w.1) a))
      (trans (ap inc.1.1 w.2) (RingHom[l].zero A.ring L.ring inc.1)))) ;
  vanish (a : A.ring.R) (w : Vanishes a) : Id L.ring.R (inc.1.1 a) L.ring.z =
   Tr.Trunc[Witness a].induction @l (\ t -> Id L.ring.R (inc.1.1 a) L.ring.z)
    (\ t -> L.set _ _) (witness-zero a) w ;
  difference (a b : A.ring.R) : A.ring.R = A.ring.add a (A.ring.neg b) ;
  difference-map (a b : A.ring.R) :
   Id L.ring.R (inc.1.1 (difference a b)) (L.ring.add (inc.1.1 a) (L.ring.neg (inc.1.1 b))) =
   trans (inc.1.2.2.1 a (A.ring.neg b))
    (ap (L.ring.add (inc.1.1 a)) (RingHom[l].negation A.ring L.ring inc.1 b)) ;
  difference-mul (p a b : A.ring.R) :
   Id A.ring.R (A.ring.mul p (difference a b)) (difference (A.ring.mul p a) (A.ring.mul p b)) =
   trans (A.ring.dist p a (A.ring.neg b))
    (ap (A.ring.add (A.ring.mul p a)) (RL[A.ring].mul-neg p b)) ;
  EqualityWitness (a b : A.ring.R) : U l =
   (n : Nat) * Id A.ring.R (A.ring.mul (Pow.power f n) a) (A.ring.mul (Pow.power f n) b) ;
  EventuallyEqual (a b : A.ring.R) : U l = Tr.Trunc[EqualityWitness a b].carrier ;
  clear-equal (a b : A.ring.R) (h : Id L.ring.R (inc.1.1 a) (inc.1.1 b)) : EventuallyEqual a b =
   Tr.Trunc[Witness (difference a b)].induction @l (\ t -> EventuallyEqual a b)
    (\ t -> Tr.Trunc[EqualityWitness a b].proposition)
    (\ w -> Tr.Trunc[EqualityWitness a b].inc
     (w.1,AffineRing[l].Laws[A.ring,A.set].difference-zero _ _
      (trans (sym (difference-mul (Pow.power f w.1) a b)) w.2)))
    (clear (difference a b) (trans (difference-map a b)
     (trans (ap (\ t -> L.ring.add t (L.ring.neg (inc.1.1 b))) h) (L.ring.addN (inc.1.1 b))))) ;
  equal-witness (a b : A.ring.R) (w : EqualityWitness a b) : Id L.ring.R (inc.1.1 a) (inc.1.1 b) =
   AffineRing[l].Laws[L.ring,L.set].difference-zero _ _
    (trans (sym (difference-map a b))
     (witness-zero (difference a b)
      (w.1,trans (difference-mul (Pow.power f w.1) a b)
       (trans (ap (\ t -> A.ring.add t (A.ring.neg (A.ring.mul (Pow.power f w.1) b))) w.2)
        (A.ring.addN (A.ring.mul (Pow.power f w.1) b)))))) ;
  equal (a b : A.ring.R) (w : EventuallyEqual a b) : Id L.ring.R (inc.1.1 a) (inc.1.1 b) =
   Tr.Trunc[EqualityWitness a b].induction @l (\ t -> Id L.ring.R (inc.1.1 a) (inc.1.1 b))
    (\ t -> L.set _ _) (equal-witness a b) w ;
 } ;
} ;
