-- Nat is a sheaf for the root topology (GABBER-PROPER-DESIGN.md, section 3,
-- rank descent).  Let G = ||Root f|| be a generator and h : G -> Nat.
--  (bound)   Root f = Spec(R[X]/f) (ETALEROOTS), so h is bounded by some N
--            (SAG 3.3.3, SCHEMEBOUNDED).
--  (vector)  chi n k = 1 if n = k, 0 otherwise.  For k < N+1 the functions
--            g |-> chi (h g) k are constant (ETALERING.R-local), with values
--            c_k.  Pointwise sum_(k<N+1) chi (h g) k = 1 since h g <= N, and R
--            is separated, so sum_k c_k = 1.  By locality merely some c_k is a
--            unit; then chi (h g) k is a unit for every g, so h g = k.
--  (unique)  n with h g = n for all g is unique: G is not-not inhabited
--            (EtaleRoots.not-not-root) and equality of naturals is decidable.
-- Hence h is constant with a unique value, and Nat is a sheaf.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module CB = CoefficientBound[l] ;
-- the equality code of the naturals: m <= n and n <= m (CB.le)
le-refl : (n : Nat) -> CB.le n n = split { zero -> tt ; suc n | r -> r } ;
EqN (n k : Nat) : U l = CB.le n k * CB.le k n ;
eqn-prop (n k : Nat) : Pr.isProp (EqN n k) =
 Pr.isProp-Sigma (CB.le n k) (\ a -> CB.le k n) (SchemeUniform[l].le-prop n k) (\ a -> SchemeUniform[l].le-prop k n) ;
eqn-refl (n : Nat) : EqN n n = (le-refl n,le-refl n) ;
decode : (n k : Nat) -> EqN n k -> Id Nat n k = split {
 zero -> split { zero -> \ e -> refl zero ; suc k -> \ e -> efq e.2 } ;
 suc n | r -> split { zero -> \ e -> efq e.1 ; suc k -> \ e -> ap (\ t -> suc t) (r k e) } } ;
encode (n k : Nat) (p : Id Nat n k) : EqN n k = Pr.subst Nat (EqN n) n k p (eqn-refl n) ;
le-decide : (m n : Nat) -> Plus (CB.le m n) (Not (CB.le m n)) = split {
 zero -> \ n -> inl tt ;
 suc m | r -> split { zero -> inr (\ e -> e) ; suc n -> r n } } ;
both (n k : Nat) : Plus (CB.le n k) (Not (CB.le n k)) -> Plus (CB.le k n) (Not (CB.le k n)) ->
 Plus (EqN n k) (Not (EqN n k)) = split {
 inl a -> split { inl b -> inl (a,b) ; inr nb -> inr (\ e -> nb e.2) } ;
 inr na -> \ d -> inr (\ e -> na e.1) } ;
eqn-dec (n k : Nat) : Plus (EqN n k) (Not (EqN n k)) = both n k (le-decide n k) (le-decide k n) ;
nat-set : Pr.isSet Nat = \ n -> Pr.Hedberg[Nat,n,EqN n,eqn-prop n,eqn-refl n,decode n].hedberg ;
-- order facts (CB.le m n : m <= n)
le-step : (m n : Nat) -> CB.le (suc m) n -> CB.le m n = split {
 zero -> \ n p -> tt ;
 suc m | r -> split { zero -> \ p -> efq p ; suc n -> r n } } ;
bump (n m : Nat) : Plus (Id Nat n m) (CB.le (suc n) m) -> Plus (Id Nat (suc n) (suc m)) (CB.le (suc (suc n)) (suc m)) =
 split { inl e -> inl (ap (\ t -> suc t) e) ; inr q -> inr q } ;
le-split : (n m : Nat) -> CB.le n m -> Plus (Id Nat n m) (CB.le (suc n) m) = split {
 zero -> split { zero -> \ p -> inl (refl zero) ; suc m -> \ p -> inr tt } ;
 suc n | r -> split { zero -> \ p -> efq p ; suc m -> \ p -> bump n m (r m p) } } ;
-- the k-th index of Fin m, counted from the top: index (suc m) (inr tt) = m
index : (m : Nat) -> Fin m -> Nat = split {
 zero -> \ i -> efq i ;
 suc m | r -> split { inl i -> r i ; inr t -> m } } ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module S0 = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module SO = StandardOpens[l].Over[R,setR].Local[axioms.loc] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module SB = SchemeBounded[l].Over[R,setR,axioms] ;
 -- (vector)
 chi : Nat -> Nat -> R.R = split {
  zero -> split { zero -> R.o ; suc k -> R.z } ;
  suc n | r -> split { zero -> R.z ; suc k -> r k } } ;
 chi-self : (n : Nat) -> Id R.R (chi n n) R.o = split { zero -> refl R.o ; suc n | r -> r } ;
 chi-above : (n k : Nat) -> CB.le (suc k) n -> Id R.R (chi n k) R.z = split {
  zero -> \ k p -> efq p ;
  suc n | r -> split { zero -> \ p -> refl R.z ; suc k -> r k } } ;
 chi-below : (n k : Nat) -> CB.le (suc n) k -> Id R.R (chi n k) R.z = split {
  zero -> split { zero -> \ p -> efq p ; suc k -> \ p -> refl R.z } ;
  suc n | r -> split { zero -> \ p -> efq p ; suc k -> r k } } ;
 chi-unit : (n k : Nat) -> RL[R].unit (chi n k) -> Id Nat n k = split {
  zero -> split { zero -> \ u -> refl zero ; suc k -> \ u -> efq (SO.zero-unit R.z (refl R.z) u) } ;
  suc n | r -> split { zero -> \ u -> efq (SO.zero-unit R.z (refl R.z) u) ; suc k -> \ u -> ap (\ t -> suc t) (r k u) } } ;
 column (n m : Nat) (j : Fin m) : R.R = chi n (index m j) ;
 sum-above : (m n : Nat) -> CB.le m n -> Id R.R (RS.sum m (column n m)) R.z = split {
  zero -> \ n p -> refl R.z ;
  suc m | r -> \ n p -> trans (cong2 R.R R.add _ _ _ _ (chi-above n m p) (r n (le-step m n p))) (R.addZ R.z) } ;
 split-one (m n : Nat) (rest : CB.le (suc n) m -> Id R.R (RS.sum m (column n m)) R.o) :
  Plus (Id Nat n m) (CB.le (suc n) m) -> Id R.R (R.add (chi n m) (RS.sum m (column n m))) R.o = split {
  inl e -> trans (cong2 R.R R.add _ _ _ _ (Pr.subst Nat (\ k -> Id R.R (chi n k) R.o) n m e (chi-self n))
     (sum-above m n (Pr.subst Nat (\ k -> CB.le k n) n m e (le-refl n)))) (R.addZ R.o) ;
  inr q -> trans (cong2 R.R R.add _ _ _ _ (chi-below n m q) (rest q)) (RL[R].zl R.o) } ;
 sum-one : (m n : Nat) -> CB.le (suc n) m -> Id R.R (RS.sum m (column n m)) R.o = split {
  zero -> \ n p -> efq p ;
  suc m | r -> \ n p -> split-one m n (r n) (le-split n m p) } ;
 one-unit : RL[R].unit R.o = (R.o,R.mulO R.o) ;
 module At (i : ET.I) (h : ET.G i -> Nat) {
  module Gen = EtaleRoots[l].Over[R,setR].Generator[i] ;
  Points : U l = C.Spec Gen.B.A ;
  at (a : Points) : ET.G i = ET.root-inc i (Gen.RootSpectrum.spec-root.1 a) ;
  -- (bound)
  affine : FA.Affine Points = Tr1.Trunc[FA.AffineWitness Points].inc (Gen.B.A,Gen.B.fp,Pr.idEquiv Points) ;
  bounds : Tr.Trunc[SB.Goal Points (\ a -> h (at a))].carrier = SB.theorem Points affine (\ a -> h (at a)) ;
  Value : U l = (n : Nat) * ((g : ET.G i) -> Id Nat (h g) n) ;
  -- (unique)
  decide (p q : Value) : Plus (EqN p.1 q.1) (Not (EqN p.1 q.1)) -> Id Nat p.1 q.1 = split {
   inl e -> decode p.1 q.1 e ;
   inr ne -> efq (Gen.not-not-root axioms (\ r ->
     ne (encode p.1 q.1 (trans (sym (p.2 (ET.root-inc i r))) (q.2 (ET.root-inc i r)))))) } ;
  same (p q : Value) : Id Nat p.1 q.1 = decide p q (eqn-dec p.1 q.1) ;
  value-prop : Pr.isProp Value = \ p q ->
   Pr.Sigma-eq Nat (\ n -> (g : ET.G i) -> Id Nat (h g) n) p.1 q.1 p.2 q.2 (same p q)
    (F.isProp-Pi (ET.G i) (\ g -> Id Nat (h g) q.1) (\ g -> nat-set (h g) q.1)) ;
  module Bounded (b : SB.Goal Points (\ a -> h (at a))) {
   N : Nat = b.1 ;
   below (g : ET.G i) : CB.le (h g) N =
    Tr.Trunc[ET.Root i].induction @l (\ t -> CB.le (h t) N) (\ t -> SchemeUniform[l].le-prop (h t) N)
     (\ r -> Pr.subst (ET.G i) (\ t -> CB.le (h t) N) (at (Gen.RootSpectrum.spec-root.2.sec r)) (ET.root-inc i r)
       (ET.G-prop i _ _) (b.2 (Gen.RootSpectrum.spec-root.2.sec r))) g ;
   c (k : Nat) : R.R = ((ER.R-local i).sec (\ g -> chi (h g) k)) ;
   value (k : Nat) (g : ET.G i) : Id R.R (c k) (chi (h g) k) =
    Pr.happly (ET.G i) (\ t -> R.R) _ _ ((ER.R-local i).sec-eq (\ t -> chi (h t) k)) g ;
   total : Id R.R (RS.sum (suc N) (\ j -> c (index (suc N) j))) R.o =
    ((S0.modal-Id R.R ER.R-local (RS.sum (suc N) (\ j -> c (index (suc N) j))) R.o) i).sec (\ g ->
     trans (RS.sum-cong (suc N) _ (column (h g) (suc N)) (\ j -> value (index (suc N) j) g))
      (sum-one (suc N) (h g) (below g))) ;
   hit : Tr.Trunc[(j : Fin (suc N)) * RL[R].unit (c (index (suc N) j))].carrier =
    SO.finite-unit (suc N) (\ j -> c (index (suc N) j))
     (Pr.subst R.R (\ t -> RL[R].unit t) R.o _ (sym total) one-unit) ;
   from-hit (w : (j : Fin (suc N)) * RL[R].unit (c (index (suc N) j))) : Value =
    (index (suc N) w.1,\ g -> chi-unit (h g) (index (suc N) w.1)
      (Pr.subst R.R (\ t -> RL[R].unit t) _ _ (value (index (suc N) w.1) g) w.2)) ;
  } ;
  witness : Value =
   Tr.Trunc[SB.Goal Points (\ a -> h (at a))].induction @l (\ t -> Value) (\ t -> value-prop)
    (\ b -> Tr.Trunc[(j : Fin (suc Bounded[b].N)) * RL[R].unit (Bounded[b].c (index (suc Bounded[b].N) j))].induction @l
      (\ t -> Value) (\ t -> value-prop) Bounded[b].from-hit Bounded[b].hit) bounds ;
 } ;
 sheaf : ET.T.isModal @l Nat = \ i ->
  Pr.qinv Nat (ET.G i -> Nat) (\ n g -> n) (\ h -> At[i,h].witness.1)
   (\ h -> F.funext (ET.G i) (\ g -> Nat) _ h (\ g -> sym (At[i,h].witness.2 g)))
   (\ n -> ap (\ v -> v.1) (At[i,\ g -> n].value-prop At[i,\ g -> n].witness (n,\ g -> refl n))) ;
 opaque sheaf ;
} ;
