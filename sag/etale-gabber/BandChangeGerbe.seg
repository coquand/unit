-- Line families form a gerbe (../HANDOFF-TORSION-C.md, C2, generalised for
-- C3).  C a charged type, Obj its line families (BANDCHANGE.At).
--  (sheaves)  A module with a mere basis of rank 1 is a sheaf: it is a retract
--             of R (m |-> c(m), a |-> a e).  So linear maps and linear
--             bijections between two such are sheaves (a bijection is a linear
--             map with the Sigma-type data of an equivalence, a retract).
--  (torsor)   For L, L' : Obj the isomorphisms i : Iso L L' (BANDCHANGE.paths)
--             form an R^x-pre-torsor: a . i = (m |-> a i(m)).  For i, j the
--             family k = j i^-1 is an automorphism of L', a path of Obj, so
--             k = b(k) (BANDCHANGE.band): j = b(k) . i; if a . i = a' . i then
--             a m = a' m on each fibre (i is onto), so a = a' at every point,
--             so a = a' (close X).  Iso L L' is a sheaf (a Pi of sheaves).
--  (local)    At a point y0 : the bases of L y0, L' y0 give a bijection
--             beta : L y0 -> L' y0.  Hom(L, L') has weight 0 (TWISTEDMODULES.Homs),
--             so beta is the value at y0 of an invariant section s
--             (TWISTEDMODULES.Descent.Lift).  s g is the transport of beta along a
--             path y0 = g, which exists merely, so s g is a bijection: s is an
--             isomorphism.  X is close-inhabited, so close (Iso L L').
--  (H90)      HILBERT90: Iso L L' is merely inhabited, so ||L = L'||.
--  (point)    At a point s : X, the twisted line Line(s = -) (TWISTEDLINE) has
--             weight 1, its dual Hom(Line, R) weight u^-1, and the n-th power
--             Hom(dual, .. Hom(dual, R)) weight u^n (MULTILINEAR.Power;
--             (u^-1)^-1 u^k = u^(k+1)); its fibres have bases of rank 1^n = 1
--             (ZARISKIMAIN.power-bases): an object of n_* G at each point.
-- Hence Obj has the fields of a TGerbe at level l+ (BANDCHANGE gives the
-- 1-type and the band; its paths are sheaves, being the isomorphisms), with
-- connectedness merely, not only locally; LINEGERBE adds descent for objects
-- and the small model.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module S0 = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module UG = TM.UG ;
 module HM = HomModule[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module SL = ScalarLine[l].Over[R,setR,axioms] ;
 module BC = BandChange[l].Over[R,setR,axioms,sh] ;
 module LA = LineAssociated[l].Over[R,setR] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module TN = TwistedMain[l].Over[R,setR,axioms,loc] ;
 module ZM = ZariskiMain[l].Over[R,setR,axioms,loc] ;
 -- (sheaves)
 modal-prop (Y : U l) : Pr.isProp (ET.T.isModal @l Y) =
  F.isProp-Pi ET.I (\ i -> Pr.isEquiv Y (ET.G i -> Y) (\ y g -> y)) (\ i -> Prop331Paths[l].isEquiv-prop Y (ET.G i -> Y) (\ y g -> y)) ;
 line-modal (M : MD.Module) (bl : Tr.Trunc[LF.Basis[M,suc zero]].carrier) : ET.T.isModal @l M.M =
  Tr.Trunc[LF.Basis[M,suc zero]].induction @l (\ t -> ET.T.isModal @l M.M) (\ t -> modal-prop M.M)
   (\ b -> S0.modal-retract R.R M.M SL.At[M].Inverse[b].c.1 (\ a -> M.sm a SL.At[M].Inverse[b].e)
     SL.At[M].Inverse[b].one ER.R-local) bl ;
 module Sheaves (A B : MD.Module) (hA : ET.T.isModal @l A.M) (hB : ET.T.isModal @l B.M) {
  module H = HM.At[A,B] ;
  maps : ET.T.isModal @l (A.M -> B.M) = S0.modal-Pi A.M (\ m -> B.M) (\ m -> hB) ;
  back : ET.T.isModal @l (B.M -> A.M) = S0.modal-Pi B.M (\ m -> A.M) (\ m -> hA) ;
  linear (f : A.M -> B.M) : ET.T.isModal @l (H.Linear f) =
   S0.modal-Sigma (H.Additive f) (\ h -> H.Scalar f)
    (S0.modal-Pi A.M (\ x -> (y : A.M) -> Id B.M (f (A.madd x y)) (B.madd (f x) (f y))) (\ x ->
      S0.modal-Pi A.M (\ y -> Id B.M (f (A.madd x y)) (B.madd (f x) (f y))) (\ y -> S0.modal-Id B.M hB _ _)))
    (\ h -> S0.modal-Pi R.R (\ a -> (x : A.M) -> Id B.M (f (A.sm a x)) (B.sm a (f x))) (\ a ->
      S0.modal-Pi A.M (\ x -> Id B.M (f (A.sm a x)) (B.sm a (f x))) (\ x -> S0.modal-Id B.M hB _ _))) ;
  hom : ET.T.isModal @l H.S.E = S0.modal-Sigma (A.M -> B.M) H.Linear maps linear ;
  eq-data (f : A.M -> B.M) : ET.T.isModal @l AffineHLevels[l].EquivalenceProofs[A.M,B.M,B.setM,f].Data =
   S0.modal-Sigma AffineHLevels[l].EquivalenceProofs[A.M,B.M,B.setM,f].Pair AffineHLevels[l].EquivalenceProofs[A.M,B.M,B.setM,f].Laws
    (S0.modal-Sigma (B.M -> A.M) (\ u -> B.M -> A.M) back (\ u -> back))
    (\ p -> S0.modal-Sigma ((b : B.M) -> Id B.M (f (p.1 b)) b) (\ h -> (a : A.M) -> Id A.M (p.2 (f a)) a)
      (S0.modal-Pi B.M (\ b -> Id B.M (f (p.1 b)) b) (\ b -> S0.modal-Id B.M hB _ _))
      (\ h -> S0.modal-Pi A.M (\ a -> Id A.M (p.2 (f a)) a) (\ a -> S0.modal-Id A.M hA _ _))) ;
  equiv (f : A.M -> B.M) : ET.T.isModal @l (Pr.isEquiv A.M B.M f) =
   S0.modal-retract AffineHLevels[l].EquivalenceProofs[A.M,B.M,B.setM,f].Data (Pr.isEquiv A.M B.M f)
    AffineHLevels[l].EquivalenceProofs[A.M,B.M,B.setM,f].encode AffineHLevels[l].EquivalenceProofs[A.M,B.M,B.setM,f].decode
    (\ e -> sym (AffineHLevels[l].EquivalenceProofs[A.M,B.M,B.setM,f].eta e)) (eq-data f) ;
  bij : ET.T.isModal @l (BC.Bij A B) = S0.modal-Sigma H.S.E (\ f -> Pr.isEquiv A.M B.M f.1) hom (\ f -> equiv f.1) ;
 } ;
 -- a sheaf of level l is one of level l+
 raise (Y : U l) (h : ET.T.isModal @l Y) : ET.T.isModal @(l+) Y = \ i ->
  Pr1.qinv Y (ET.G i -> Y) (\ y g -> y) (h i).sec (h i).sec-eq (Pr.sec-ret Y (ET.G i -> Y) (\ y g -> y) (h i)) ;
 -- composition and inverses of linear bijections
 compose (A B C : MD.Module) (i : BC.Bij A B) (j : BC.Bij B C) : BC.Bij A C =
  ((\ m -> j.1.1 (i.1.1 m),
    \ x y -> trans (ap j.1.1 (i.1.2.1 x y)) (j.1.2.1 (i.1.1 x) (i.1.1 y)),
    \ t x -> trans (ap j.1.1 (i.1.2.2 t x)) (j.1.2.2 t (i.1.1 x))),
   (Equivalences[l].compose A.M B.M C.M (i.1.1,i.2) (j.1.1,j.2)).2) ;
 module Inverse (A B : MD.Module) (i : BC.Bij A B) {
  f (m : A.M) : B.M = i.1.1 m ;
  g (m : B.M) : A.M = i.2.sec m ;
  fg (m : B.M) : Id B.M (f (g m)) m = i.2.sec-eq m ;
  gf (m : A.M) : Id A.M (g (f m)) m = Pr.sec-ret A.M B.M f i.2 m ;
  injective (x y : A.M) (h : Id B.M (f x) (f y)) : Id A.M x y = Equivalences[l].injective A.M B.M f i.2 x y h ;
  inverse : BC.Bij B A =
   ((g,
     \ x y -> injective _ _ (trans (fg (B.madd x y)) (sym (trans (i.1.2.1 (g x) (g y)) (cong2 B.M B.madd _ _ _ _ (fg x) (fg y))))),
     \ t x -> injective _ _ (trans (fg (B.sm t x)) (sym (trans (i.1.2.2 t (g x)) (ap (B.sm t) (fg x)))))),
    Pr.qinv B.M A.M g f gf fg) ;
 } ;
 -- the bijection given by two bases of rank 1: m |-> c(m) e'
 module Bases (A C : MD.Module) (b : LF.Basis[A,suc zero]) (b' : LF.Basis[C,suc zero]) {
  module IA = SL.At[A].Inverse[b] ;
  module IC = SL.At[C].Inverse[b'] ;
  f (m : A.M) : C.M = C.sm (IA.c.1 m) IC.e ;
  g (m : C.M) : A.M = A.sm (IC.c.1 m) IA.e ;
  bij : BC.Bij A C =
   ((f,\ x y -> trans (ap (\ t -> C.sm t IC.e) (IA.c.2.1 x y)) (C.smE (IA.c.1 x) (IA.c.1 y) IC.e),
     \ t x -> trans (ap (\ r -> C.sm r IC.e) (IA.c.2.2 t x)) (sym (C.smA t (IA.c.1 x) IC.e))),
    Pr.qinv A.M C.M f g
     (\ m -> trans (ap (\ t -> C.sm t IC.e) (IA.recover (IC.c.1 m))) (IC.one m))
     (\ m -> trans (ap (\ t -> A.sm t IA.e) (IC.recover (IA.c.1 m))) (IA.one m))) ;
 } ;
 module At (C : BC.Char) {
  module B = BC.At[C] ;
  X : U l = B.X ;
  module T = B.T ;
  -- (torsor)
  module Isos (L L' : B.Obj) {
   P : U l = B.Iso L L' ;
   module LL = B.Loops[L'] ;
   act (a : UG.Unit) (i : P) : P = \ g -> compose (L.1 g) (L'.1 g) (L'.1 g) (i g) (LL.scaling a g) ;
   iso-eq (i j : P) (h : (g : X) (m : (L.1 g).M) -> Id (L'.1 g).M ((i g).1.1 m) ((j g).1.1 m)) : Id P i j =
    F.funext X (\ g -> BC.Bij (L.1 g) (L'.1 g)) i j (\ g -> BC.bij-eq (L.1 g) (L'.1 g) (i g) (j g) (h g)) ;
   ad (a c : UG.Unit) (i : P) : Id P (act (UG.times a c) i) (act a (act c i)) =
    iso-eq _ _ (\ g m -> sym ((L'.1 g).smA a.1 c.1 ((i g).1.1 m))) ;
   ze (i : P) : Id P (act UG.one i) i = iso-eq _ _ (\ g m -> (L'.1 g).smO ((i g).1.1 m)) ;
   module Two (i j : P) {
    inv (g : X) : BC.Bij (L'.1 g) (L.1 g) = Inverse[L.1 g,L'.1 g,i g].inverse ;
    k : B.Iso L' L' = \ g -> compose (L'.1 g) (L.1 g) (L'.1 g) (inv g) (j g) ;
    p : Id B.Obj L' L' = B.Fd.sip L' L' k ;
    a : UG.Unit = LL.b p ;
    k-law (g : X) (m : (L'.1 g).M) : Id (L'.1 g).M ((k g).1.1 m) ((L'.1 g).sm a.1 m) =
     trans (sym (ap (\ q -> (q g).1.1 m) (B.Fd.idToIso-sip L' L' k))) (LL.law p g m) ;
    #fails {
     -- j i^-1 is a scalar by the band (a path of Obj), not by computation
     k-scalar (g : X) (m : (L'.1 g).M) : Id (L'.1 g).M ((k g).1.1 m) ((L'.1 g).sm a.1 m) = refl ((k g).1.1 m) ;
    } ;
    moves : Id P (act a i) j = iso-eq _ _ (\ g m ->
     trans (sym (k-law g ((i g).1.1 m))) (ap (j g).1.1 (Inverse[L.1 g,L'.1 g,i g].gf m))) ;
    -- free
    free (c c' : UG.Unit) (h : Id P (act c i) j) (h' : Id P (act c' i) j) : Id UG.Unit c c' =
     UG.eq c c' (LL.by-point c.1 c'.1 (\ g -> BC.Line[L'.1 g,B.basis L' g].unique c.1 c'.1 (\ m ->
      calc (L'.1 g).M { (L'.1 g).sm c.1 m
       =< ap ((L'.1 g).sm c.1) (sym (Inverse[L.1 g,L'.1 g,i g].fg m)) > (act c i g).1.1 (Inverse[L.1 g,L'.1 g,i g].g m)
       =< ap (\ q -> (q g).1.1 (Inverse[L.1 g,L'.1 g,i g].g m)) (trans h (sym h')) > (act c' i g).1.1 (Inverse[L.1 g,L'.1 g,i g].g m)
       =< ap ((L'.1 g).sm c'.1) (Inverse[L.1 g,L'.1 g,i g].fg m) > (L'.1 g).sm c'.1 m }))) ;
    contr : FunExtUA[l].isContr ((c : UG.Unit) * Id P (act c i) j) =
     ((a,moves),\ w -> Pr.Sigma-eq UG.Unit (\ c -> Id P (act c i) j) a w.1 moves w.2 (free a w.1 moves w.2) (B.iso-set L L' _ _)) ;
   } ;
   pretor : LA.PreTor = (P,act,B.iso-set L L',ad,ze,\ i j -> Two[i,j].contr) ;
   sheaf : ET.T.isModal @l P =
    S0.modal-Pi X (\ g -> BC.Bij (L.1 g) (L'.1 g)) (\ g ->
     Sheaves[L.1 g,L'.1 g,line-modal (L.1 g) (B.basis L g),line-modal (L'.1 g) (B.basis L' g)].bij) ;
   -- (local)
   module AtPoint (y0 : X) {
    module HL = T.Homs[L.1,L'.1] ;
    module D = T.Descent[HL.H,HL.Same[T.bnd,L.2.1,L'.2.1].weight,y0] ;
    module MH = T.Move[HL.H] ;
    module Extend (beta : BC.Bij (L.1 y0) (L'.1 y0)) {
     s : D.IV.S.E = D.Lift[beta.1].lift ;
     moved (g : X) (q : Id X y0 g) : Pr.isEquiv (L.1 g).M (L'.1 g).M (MH.move y0 g q beta.1).1 =
      idJ X y0 (\ z r -> Pr.isEquiv (L.1 z).M (L'.1 z).M (MH.move y0 z r beta.1).1) beta.2 g q ;
     value (g : X) (q : Id X y0 g) : Id (HL.H g).M (MH.move y0 g q beta.1) (s.1 g) =
      trans (ap (MH.move y0 g q) (sym D.Lift[beta.1].at-lift)) (s.2 y0 g q) ;
     equiv (g : X) : Pr.isEquiv (L.1 g).M (L'.1 g).M (s.1 g).1 =
      Tr.Trunc[Id X y0 g].induction @l (\ t -> Pr.isEquiv (L.1 g).M (L'.1 g).M (s.1 g).1)
       (\ t -> Prop331Paths[l].isEquiv-prop (L.1 g).M (L'.1 g).M (s.1 g).1)
       (\ q -> Pr.subst (HL.H g).M (\ h -> Pr.isEquiv (L.1 g).M (L'.1 g).M h.1) _ _ (value g q) (moved g q))
       (T.conn y0 g) ;
     iso : P = \ g -> (s.1 g,equiv g) ;
    } ;
    point : sh.close P =
     Tr.Trunc[LF.Basis[L.1 y0,suc zero]].induction @l (\ t -> sh.close P) (\ t -> sh.proposition P) (\ b ->
      Tr.Trunc[LF.Basis[L'.1 y0,suc zero]].induction @l (\ t -> sh.close P) (\ t -> sh.proposition P) (\ b' ->
       sh.inc P Extend[Bases[L.1 y0,L'.1 y0,b,b'].bij].iso) (B.basis L' y0)) (B.basis L y0) ;
   } ;
   local : sh.close P =
    sh.elim @l X (sh.close P) (sh.proposition P) (sh.modal P) (\ y0 -> AtPoint[y0].point) C.2 ;
   -- (H90)
   isos : Tr.Trunc[P].carrier = Hilbert90[l].Over[R,setR,axioms,sh].At[pretor,sheaf,local].theorem ;
   connected : Tr1.Trunc[Id B.Obj L L'].carrier =
    Tr.Trunc[P].induction @(l+) (\ t -> Tr1.Trunc[Id B.Obj L L'].carrier) (\ t -> Tr1.Trunc[Id B.Obj L L'].proposition)
     (\ i -> Tr1.Trunc[Id B.Obj L L'].inc (B.Fd.sip L L' i)) isos ;
  } ;
  -- the paths are sheaves (they are the isomorphisms)
  paths (L L' : B.Obj) : ET.T.isModal @(l+) (Id B.Obj L L') =
   SheafLemmas[l,l+].Over[ET.I,ET.G].modal-retract (B.Iso L L') (Id B.Obj L L') (B.Fd.idToIso L L') (B.Fd.sip L L')
    (B.Fd.sip-idToIso L L') (raise (B.Iso L L') Isos[L,L'].sheaf) ;
 } ;
 -- n_* G: weight beta^n, inhabited locally by the n-th power of the dual of the twisted line
 module Power (Gb : TG.TGerbe) (n : Nat) {
  module PW = BC.Power[Gb,n] ;
  module A = At[PW.char] ;
  module B = A.B ;
  X : U l = Gb.carrier ;
  -- (point)
  module Point (s : X) {
   AG : TM.GB.AGerbe = (X,Gb.gpd,Tr.Trunc[X].inc s,TG.At[Gb].connected,Gb.band) ;
   module TA = TM.At[TM.charge (TM.banded AG)] ;
   module TL = TwistedLine[l].Over[R,setR].At[AG,s] ;
   R0 (g : X) : MD.Module = MD.regular ;
   r-move (y y' : X) (p : Id X y y') (m : R.R) : Id R.R (TA.Move[R0].move y y' p m) m =
    idJ X y (\ z q -> Id R.R (TA.Move[R0].move y z q m) m) (refl m) y' p ;
   r-weight : TA.Weight TA.trivial R0 = \ y p m -> trans (r-move y y p m) (sym (MD.regular.smO m)) ;
   module DP = ML.At[AG].Power[TL.line,R0,TA.identity,TA.trivial,TL.weight,r-weight] ;
   dual (g : X) : MD.Module = DP.mult (suc zero) g ;
   module OP = ML.At[AG].Power[dual,R0,DP.weight-of (suc zero),TA.trivial,DP.weight (suc zero),r-weight] ;
   powers (a : UG.Unit) : (k : Nat) -> Id UG.Unit (OP.weight-of k a) (UG.power a k) = split {
    zero -> refl UG.one ;
    suc k | h -> UG.eq _ _ (calc R.R { R.mul (OP.weight-of k a).1 (R.mul R.o a.1)
      =< ap (R.mul (OP.weight-of k a).1) (RL[R].one-left a.1) > R.mul (OP.weight-of k a).1 a.1
      =< ap (\ u -> R.mul u.1 a.1) h > R.mul (UG.power a k).1 a.1
      =< R.mulC (UG.power a k).1 a.1 > R.mul a.1 (UG.power a k).1 }) } ;
   weight : TA.Weight PW.chi (OP.mult n) = TA.retag (OP.weight-of n) PW.chi (\ a -> powers a n) (OP.mult n) (OP.weight n) ;
   reg : Tr.Trunc[LF.Basis[MD.regular,suc zero]].carrier = Tr.Trunc[LF.Basis[MD.regular,suc zero]].inc TN.regular-basis ;
   dual-basis (g : X) : Tr.Trunc[LF.Basis[dual g,suc zero]].carrier =
    subst (\ r -> Tr.Trunc[LF.Basis[dual g,r]].carrier) (TN.rank-one (suc zero))
     (ZM.power-bases (TL.line g) MD.regular (TN.LineBasis[AG,s].basis g) reg (suc zero)) ;
   basis (g : X) : Tr.Trunc[LF.Basis[OP.mult n g,suc zero]].carrier =
    subst (\ r -> Tr.Trunc[LF.Basis[OP.mult n g,r]].carrier) (TN.rank-one n)
     (ZM.power-bases (dual g) MD.regular (dual-basis g) reg n) ;
   object : B.Obj = (OP.mult n,weight,basis) ;
   #fails {
    -- the twisted line has weight 1, not n: the n-th power of the dual is needed
    line-weight : TA.Weight PW.chi TL.line = TL.weight ;
   } ;
  } ;
 } ;
} ;
