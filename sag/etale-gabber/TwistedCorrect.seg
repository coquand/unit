-- Proposition `correct` (gabber-recollement), internal form.  Situation of
-- CHEAPGLUE: A f.p., gerbes G x on Spec A, a, b merely comaximal, Lambda of
-- weight n = n0 + 1 with rank-1 bases.  Let V' be twisted on Spec A, with
-- fibres merely having bases of rank r = r0 + 1, r^n = N = NV0 + 1, whose
-- restrictions to D(a), D(b) are good of rank N (on Spec L_a, Spec L_b).
-- Then merely there is a projector S over A, of rank R = R0 + 1, whose
-- values I S(x) merely have bases of rank R, such that V' (x) S
-- (TWISTEDTENSOR) is good of rank (R r)^n on Spec A.
--  (frames)  The descended P(V')^v merely has frame data, with projector f
--     (AFFINEFRAMEDATA); the goal is a proposition.
--  (transfer)  Restricting f to Spec L_a (GOODRESTRICT.Data) gives the class
--     h_a [f]; goodness on Spec L_a gives rho(h_a [f]) = 1, so rho = 1 for
--     its restriction along L_a -> A_a (LOCALIZATIONRINGS.At.to; RHOMAPS),
--     which is the restriction of [f] along A -> A_a (K0RESTRICTION.Compose,
--     Pointwise, to-beta).  Hence merely (k_a + 1)([f] - N) = 0 in K_0(A_a);
--     likewise k_b, and kappa = (k_a + 1)(k_b + 1) kills both.
--  (correction)  CORRECTION.Lemma.explicit: merely S = E + 1_Dd with
--     E = alpha D alpha^-1 over A_a, E = beta'^-1 D beta' over A_b,
--     L + Dd = R, and rho(f) rho(S)^n = 1.
--  (bases)  At a point x with x(s) a unit (s = a or b), x factors through
--     A_s (MONOIDLOCALIZATIONMAP, J), so x(S) = J(P) D J(P)^-1 + 1_Dd
--     (PROJECTORMAP.Sum, MATRIXMAP, VECTORBLOCKS.Map.map-D), which has a
--     basis of rank L + Dd (STANDARDBASES.Standard).  D(a), D(b) cover
--     Spec A (TWISTEDGLUE.Opens.cover).
--  (good)  Every representing projector of the descended P(V' (x) S)^v has
--     class [S]^n [f] (TWISTEDTENSOR.Class), and with (R r)^n = R^n N
--     (CHEAPOVERLAP.nat-rank), rho([S]^n [f]) = rho(S)^n rho(f) = 1
--     (RHOPRODUCTS).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module H = RingHom[l] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module SB = StandardBases[l].Over[R,setR,axioms] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module FP = FrameProjector[l].Over[R,setR,axioms] ;
 module FR = Frames[l].Over[R,setR] ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TM.GB.AGerbe) (a b : A.ring.R)
  (cm : Tr.Trunc[Comaximal[l].Over[A.ring].Comaximal a b].carrier)
  (la : AI.LocalizationWitness A a) (lb : AI.LocalizationWitness A b) (lab : AI.LocalizationWitness A (A.ring.mul a b))
  (n0 : Nat) (Lambda : TM.Family[C.Spec A,G].Weighted (\ c -> TM.UG.power c (suc n0)))
  (bl : (x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier) {
  module PW = Localisations[l].Over[A.ring] ;
  module CI = PW.Instance[A.set,a,b,cm] ;
  module CP = CI.CorrectionAt.P ;
  module DA = Datum[l].Over[R,setR,axioms].At[A,fp,G] ;
  -- (bases), at a point x with x(s) a unit
  module Fibre (s : A.ring.R) (L Dd : Nat) (E : Vectors[l].Over[A.ring,A.set,plus L L].MR.Mat)
   (hE : Id Vectors[l].Over[A.ring,A.set,plus L L].MR.Mat (Vectors[l].Over[A.ring,A.set,plus L L].MR.mmul E E) E)
   (Pm Pm' : Vectors[l].Over[PW.Inclusion[s].LX.ring,PW.Inclusion[s].LX.set,plus L L].MR.Mat)
   (left : Id Vectors[l].Over[PW.Inclusion[s].LX.ring,PW.Inclusion[s].LX.set,plus L L].MR.Mat
     (Vectors[l].Over[PW.Inclusion[s].LX.ring,PW.Inclusion[s].LX.set,plus L L].MR.mmul Pm' Pm)
     Vectors[l].Over[PW.Inclusion[s].LX.ring,PW.Inclusion[s].LX.set,plus L L].MR.mone)
   (form : Id Vectors[l].Over[PW.Inclusion[s].LX.ring,PW.Inclusion[s].LX.set,plus L L].MR.Mat
     (MatrixMap[l].Over[A.ring,PW.Inclusion[s].LX.ring,A.set,PW.Inclusion[s].LX.set,PW.Inclusion[s].LX.inclusion,plus L L].map E)
     (Vectors[l].Over[PW.Inclusion[s].LX.ring,PW.Inclusion[s].LX.set,plus L L].MR.mmul
      (Vectors[l].Over[PW.Inclusion[s].LX.ring,PW.Inclusion[s].LX.set,plus L L].MR.mmul Pm
       VectorBlocks[l].Over[PW.Inclusion[s].LX.ring,PW.Inclusion[s].LX.set,L].D) Pm'))
   (x : C.Spec A) (u : RL[R].unit (x.1.1 s)) {
   module LS = PW.Inclusion[s].LX ;
   S : CP.PJ.Projector = CP.standard L Dd E hE ;
   -- the powers of s are units at x
   units (t : A.ring.R) (ht : PW.Powers s t) : RL[R].unit (x.1.1 t) =
    Pr.subst A.ring.R (\ v -> RL[R].unit (x.1.1 v)) (PW.PA.power s ht.1) t ht.2
     (Pr.subst R.R RL[R].unit (AffinePowers[l].Over[R].power (x.1.1 s) ht.1) (x.1.1 (PW.PA.power s ht.1))
      (sym (AffinePowers[l].power-map A.ring R x.1 s ht.1))
      (AffinePowers[l].Over[R].Units[setR].power-unit (x.1.1 s) u ht.1)) ;
   module J = MonoidLocalizationMap[l].Over[A.ring,PW.Powers s,PW.powers-one s,PW.powers-product s,R,setR,x.1,units] ;
   module MA = MatrixMap[l].Over[A.ring,LS.ring,A.set,LS.set,LS.inclusion,plus L L] ;
   module MJ = MatrixMap[l].Over[LS.ring,R,LS.set,setR,J.hom,plus L L] ;
   module VB = VectorBlocks[l].Map[LS.ring,R,LS.set,setR,J.hom,L] ;
   module VR = Vectors[l].Over[R,setR,plus L L] ;
   module ST = SB.Standard[L,Dd,MJ.map Pm,MJ.map Pm',
    trans (sym (MJ.map-mul Pm' Pm)) (trans (ap MJ.map left) MJ.map-one)] ;
   -- x(E) = J(P D P') = J(P) D J(P')
   entries : Id VR.MR.Mat (DA.Mats[plus L L].at x E) (MJ.map (MA.map E)) =
    VR.MR.mat-eq _ _ (\ i j -> sym (J.constants (E i j))) ;
   conjugate : Id VR.MR.Mat (MJ.map (MA.map E)) (VR.MR.mmul (VR.MR.mmul (MJ.map Pm) VB.BY.D) (MJ.map Pm')) =
    trans (ap MJ.map form)
     (trans (MJ.map-mul (Vectors[l].Over[LS.ring,LS.set,plus L L].MR.mmul Pm VB.BX.D) Pm')
      (ap (\ X -> VR.MR.mmul X (MJ.map Pm'))
       (trans (MJ.map-mul Pm VB.BX.D) (ap (VR.MR.mmul (MJ.map Pm)) VB.map-D)))) ;
   module PM = ProjectorMap[l].Over[A.ring,R,A.set,setR,x.1] ;
   module SM = PM.Sum[new CP.PJ.Projector[plus L L,E,hE],CP.PJ.Free[Dd].projector] ;
   -- x(S) = x(E) + 1_Dd
   matrix : Id SM.M2.MY.Mat (DA.Mats[plus (plus L L) Dd].at x S.matrix)
    (SM.DB.dsum (VR.MR.mmul (VR.MR.mmul (MJ.map Pm) VB.BY.D) (MJ.map Pm')) SM.MQ.MY.mone) =
    trans SM.matrix
     (trans (ap (\ X -> SM.DB.dsum X (SM.MQ.map CP.PJ.Free[Dd].projector.matrix)) (trans entries conjugate))
      (ap (SM.DB.dsum (VR.MR.mmul (VR.MR.mmul (MJ.map Pm) VB.BY.D) (MJ.map Pm'))) SM.MQ.map-one)) ;
   basis : LF.Basis[MT.I S.size (DA.Mats[S.size].at x S.matrix),plus L Dd] =
    SB.move (MT.I (plus (plus L L) Dd) (SM.DB.dsum (VR.MR.mmul (VR.MR.mmul (MJ.map Pm) VB.BY.D) (MJ.map Pm')) SM.MQ.MY.mone))
     (MT.I S.size (DA.Mats[S.size].at x S.matrix))
     (Pr1.ap SM.M2.MY.Mat MD.Module (MT.I (plus (plus L L) Dd))
      (SM.DB.dsum (VR.MR.mmul (VR.MR.mmul (MJ.map Pm) VB.BY.D) (MJ.map Pm')) SM.MQ.MY.mone)
      (DA.Mats[plus (plus L L) Dd].at x S.matrix) (sym matrix))
     (plus L Dd) ST.basis ;
  } ;
  module CG = CheapGlue[l].Over[R,setR,axioms,loc].At[A,fp,G,a,b,cm,la,lb,lab,n0,Lambda,bl] ;
  module CO = CheapOverlap[l].Over[R,setR,axioms].At[A,fp,G,n0,Lambda] ;
  module TT = TwistedTensor[l].Over[R,setR,axioms].At[A,fp,G,suc n0,Lambda] ;
  module RP = RhoProducts[l].Over[CO.K.K0] ;
  -- (transfer), on the side f, for a family M on Spec A with frame data w
  module Transfer (f : A.ring.R) (lf : AI.LocalizationWitness A f) (M : C.Spec A -> MD.Module) (w : FP.At[A,fp,M].Data)
   (NV0 : Nat) (Mf : C.Spec lf.1 -> MD.Module)
   (at : (y : C.Spec lf.1) -> Id MD.Module (Mf y) (M (C.compose A lf.1 C.base y lf.2.2.1)))
   (good : (v : FP.At[lf.1,lf.2.1,Mf].Data) -> Id Transposes[l].Over[lf.1.ring,lf.1.set].RQ.K.R
     (Transposes[l].Over[lf.1.ring,lf.1.set].Rho[NV0].rho (K0[l].Over[lf.1.ring,lf.1.set].class FP.At[lf.1,lf.2.1,Mf].From[v].projector))
     Transposes[l].Over[lf.1.ring,lf.1.set].RQ.K.o) {
   module GR = GoodRestrict[l].Over[R,setR,axioms].At[A,fp,lf.1,lf.2.1,lf.2.2.1,M] ;
   module GW = GR.Data[w] ;
   module LR = LocalizationRings[l].Over[R,setR].At[A,f,lf] ;
   GoodOn (N : C.Spec lf.1 -> MD.Module) : U l = (v : FP.At[lf.1,lf.2.1,N].Data) -> Id GR.TY.RQ.K.R
    (GR.TY.Rho[NV0].rho (GR.KY.class FP.At[lf.1,lf.2.1,N].From[v].projector)) GR.TY.RQ.K.o ;
   moved : Id (C.Spec lf.1 -> MD.Module) Mf GR.My = F1.funext (C.Spec lf.1) (\ y -> MD.Module) Mf GR.My at ;
   good' : GR.Good' NV0 = idJ (C.Spec lf.1 -> MD.Module) Mf (\ N q -> GoodOn N) good GR.My moved ;
   class-f : GR.KX.K0.R = GR.KX.class GW.FA.projector ;
   -- rho(h [f]) = 1 on Spec L_f
   on-l : Id GR.TY.RQ.K.R (GR.TY.Rho[NV0].rho (GR.h.1 class-f)) GR.TY.RQ.K.o =
    subst (\ t -> Id GR.TY.RQ.K.R (GR.TY.Rho[NV0].rho t) GR.TY.RQ.K.o) (sym GW.class) (good' GW.restricted) ;
   module RT = RhoMaps[l].Over[lf.1.ring,LR.LX.ring,lf.1.set,LR.LX.set,
    K0Restriction[l].Over[lf.1.ring,LR.LX.ring,lf.1.set,LR.LX.set,LR.to.1].restrict,NV0] ;
   module CM = K0Restriction[l].Compose[A.ring,lf.1.ring,LR.LX.ring,A.set,lf.1.set,LR.LX.set,lf.2.2.1.1,LR.to.1] ;
   module PO = K0Restriction[l].Pointwise[A.ring,LR.LX.ring,A.set,LR.LX.set,H.compose A.ring lf.1.ring LR.LX.ring LR.to.1 lf.2.2.1.1,LR.LX.inclusion,LR.to-beta] ;
   -- the restriction along A -> L_f -> A_f is the one along A -> A_f
   composite : Id PO.RF'.KB.K0.R (RT.h.1 (GR.h.1 class-f)) (PO.RF'.restrict.1 class-f) =
    trans (CM.theorem class-f) (PO.theorem class-f) ;
   restricted : Id RT.TY.RQ.K.R (RT.RY.rho (PO.RF'.restrict.1 class-f)) RT.TY.RQ.K.o =
    subst (\ t -> Id RT.TY.RQ.K.R (RT.RY.rho t) RT.TY.RQ.K.o) composite (RT.theorem (GR.h.1 class-f) on-l) ;
   multiplier : Tr.Trunc[RT.RY.Multiplier (PO.RF'.restrict.1 class-f)].carrier = RT.RY.multiplier (PO.RF'.restrict.1 class-f) restricted ;
  } ;
  -- the image of S at x, and the result
  image-at (x : C.Spec A) (S : CP.PJ.Projector) : MD.Module = MT.I S.size (DA.Mats[S.size].at x S.matrix) ;
  record Corrected (V' : DA.Fam.TF.Twisted) (r0 : Nat) {
   rank0 : Nat ;
   corrector : CP.PJ.Projector ;
   corrector-bases : (x : C.Spec A) -> Tr.Trunc[LF.Basis[image-at x corrector,suc rank0]].carrier ;
   power0 : Nat ;
   power-eq : Id Nat (ML.rank (Pairing[l].times (suc rank0) (suc r0)) (suc zero) (suc n0)) (suc power0) ;
   corrected-good : CO.Good TT.Tensor[V',corrector].twisted power0 ;
  } ;
  -- ranks are positive
  rank-positive (r : Nat) : (k : Nat) -> (c : Nat) * Id Nat (ML.rank (suc r) (suc zero) k) (suc c) = split {
   zero -> (zero,refl (suc zero)) ;
   suc k | h -> ((Rational[l].times-suc r h.1).1,
    trans (ap (Pairing[l].times (suc r)) h.2) (Rational[l].times-suc r h.1).2) } ;
  -- (kappa)  j u = 0 gives (j k) u = 0 and (k j) u = 0
  module Kill (T : CRing) (j k : Nat) (u : T.R) (h : Id T.R (T.mul (Rational[l].Integers[T].nat j) u) T.z) {
   module IT = Rational[l].Integers[T] ;
   left : Id T.R (T.mul (IT.nat (Pairing[l].times j k)) u) T.z =
    calc T.R { T.mul (IT.nat (Pairing[l].times j k)) u
      =< ap (\ t -> T.mul t u) (trans (IT.nat-times j k) (T.mulC (IT.nat j) (IT.nat k))) > T.mul (T.mul (IT.nat k) (IT.nat j)) u
      =< sym (T.mulA (IT.nat k) (IT.nat j) u) > T.mul (IT.nat k) (T.mul (IT.nat j) u)
      =< ap (T.mul (IT.nat k)) h > T.mul (IT.nat k) T.z
      =< RL[T].mul-zero (IT.nat k) > T.z } ;
   right : Id T.R (T.mul (IT.nat (Pairing[l].times k j)) u) T.z =
    calc T.R { T.mul (IT.nat (Pairing[l].times k j)) u
      =< ap (\ t -> T.mul t u) (IT.nat-times k j) > T.mul (T.mul (IT.nat k) (IT.nat j)) u
      =< sym (T.mulA (IT.nat k) (IT.nat j) u) > T.mul (IT.nat k) (T.mul (IT.nat j) u)
      =< ap (T.mul (IT.nat k)) h > T.mul (IT.nat k) T.z
      =< RL[T].mul-zero (IT.nat k) > T.z } ;
  } ;
  module Correct (V' : DA.Fam.TF.Twisted) (r0 NV0 : Nat)
   (bv : (x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[V'.1 x g,suc r0]].carrier)
   (hV : Id Nat (ML.rank (suc r0) (suc zero) (suc n0)) (suc NV0))
   (gA : CG.SA.CF.Good (CG.SA.on-lf (CG.restrict-a V')) NV0) (gB : CG.SB.CF.Good (CG.SB.on-lf (CG.restrict-b V')) NV0) {
   module PV = ML.Family[DA.X,G].Dual[suc n0,V',Lambda] ;
   -- (frames)
   fv : DA.Fam.Framed V'.1 (suc r0) =
    \ x g -> TC.map (LF.Basis[V'.1 x g,suc r0]) (FR.Frame[V'.1 x g,suc r0]) (\ t -> t.frame) (bv x g) ;
   fl : DA.Fam.Framed Lambda.1 (suc zero) = \ x g ->
    TC.map (LF.Basis[Lambda.1 x g,suc zero]) (FR.Frame[Lambda.1 x g,suc zero]) (\ t -> t.frame) (bl x g) ;
   mere : Tr.Trunc[FP.At[A,fp,PV.descended].Data].carrier =
    AffineFrameData[l].Over[R,setR,axioms].At[A,fp,PV.descended,ML.rank (suc r0) (suc zero) (suc n0),
     PV.descended-frames (suc r0) (suc zero) fv fl].theorem ;
   module WithFrames (wP : FP.At[A,fp,PV.descended].Data) {
    module FD = FP.At[A,fp,PV.descended].From[wP] ;
    fclass : CO.K.K0.R = CO.K.class FD.projector ;
    -- (transfer)
    module TA = Transfer[a,la,PV.descended,wP,NV0,CG.SA.CF.MF.Dual[suc n0,CG.SA.on-lf (CG.restrict-a V'),CG.SA.lam-f].descended,
     \ y -> refl (CG.SA.CF.MF.Dual[suc n0,CG.SA.on-lf (CG.restrict-a V'),CG.SA.lam-f].descended y),gA] ;
    module TB = Transfer[b,lb,PV.descended,wP,NV0,CG.SB.CF.MF.Dual[suc n0,CG.SB.on-lf (CG.restrict-b V'),CG.SB.lam-f].descended,
     \ y -> refl (CG.SB.CF.MF.Dual[suc n0,CG.SB.on-lf (CG.restrict-b V'),CG.SB.lam-f].descended y),gB] ;
    module Both (ma : TA.RT.RY.Multiplier (TA.PO.RF'.restrict.1 TA.class-f)) (mb : TB.RT.RY.Multiplier (TB.PO.RF'.restrict.1 TB.class-f)) {
     kappa0 : Nat = (Rational[l].times-suc ma.1 mb.1).1 ;
     module MA = RhoMaps[l].Over[A.ring,CI.Aa.ring,A.set,CI.Aa.set,CP.CK.RA.restrict,NV0] ;
     module MB = RhoMaps[l].Over[A.ring,CI.Ab.ring,A.set,CI.Ab.set,CP.CK.RB.restrict,NV0] ;
     module KA = Kill[MA.KY.K0,suc ma.1,suc mb.1,MA.RY.diff (CP.CK.RA.restrict.1 fclass),ma.2] ;
     module KB = Kill[MB.KY.K0,suc mb.1,suc ma.1,MB.RY.diff (CP.CK.RB.restrict.1 fclass),mb.2] ;
     -- kappa = (k_a + 1)(k_b + 1)
     kappa : Id Nat (Pairing[l].times (suc ma.1) (suc mb.1)) (suc kappa0) = (Rational[l].times-suc ma.1 mb.1).2 ;
     ha : Id CP.CK.RA.KB.K0.R (CP.CK.RA.restrict.1 (CP.K.K0.mul (CP.IK.nat (suc kappa0)) (MA.RX.diff fclass))) CP.CK.RA.KB.K0.z =
      trans (MA.multiple (suc kappa0) fclass)
       (trans (ap (\ k -> MA.KY.K0.mul (MA.TY.IK.nat k) (MA.RY.diff (CP.CK.RA.restrict.1 fclass))) (sym kappa)) KA.left) ;
     hb : Id CP.CK.RB.KB.K0.R (CP.CK.RB.restrict.1 (CP.K.K0.mul (CP.IK.nat (suc kappa0)) (MB.RX.diff fclass))) CP.CK.RB.KB.K0.z =
      trans (MB.multiple (suc kappa0) fclass)
       (trans (ap (\ k -> MB.KY.K0.mul (MB.TY.IK.nat k) (MB.RY.diff (CP.CK.RB.restrict.1 fclass))) (sym kappa)) KB.right) ;
     -- (correction)
     module CL = CP.Lemma[FD.projector,NV0,kappa0,n0,ha,hb] ;
     module Given (res : CL.Result) {
      S : CP.PJ.Projector = CP.standard res.half res.pad res.presenter res.presenter-idem ;
      -- (bases)
      side-basis (x : C.Spec A) : Plus (CG.GL.Da x) (CG.GL.Db x) -> LF.Basis[image-at x S,plus res.half res.pad] = split {
       inl u -> Fibre[a,res.half,res.pad,res.presenter,res.presenter-idem,res.alpha,res.alpha',res.alpha-inverse.left,res.on-a,x,u].basis ;
       inr v -> Fibre[b,res.half,res.pad,res.presenter,res.presenter-idem,res.beta',res.beta,res.beta-inverse.right,res.on-b,x,v].basis } ;
      bases (x : C.Spec A) : Tr.Trunc[LF.Basis[image-at x S,suc res.rank0]].carrier =
       TC.map (Plus (CG.GL.Da x) (CG.GL.Db x)) (LF.Basis[image-at x S,suc res.rank0])
        (\ e -> subst (\ k -> LF.Basis[image-at x S,k]) res.size-eq (side-basis x e)) (CG.GL.cover x) ;
      -- the rank of P(V' (x) S)
      tc : (c : Nat) * Id Nat (Pairing[l].times (suc res.rank0) (suc r0)) (suc c) = Rational[l].times-suc res.rank0 r0 ;
      rp : (c : Nat) * Id Nat (ML.rank (suc tc.1) (suc zero) (suc n0)) (suc c) = rank-positive tc.1 (suc n0) ;
      power-eq : Id Nat (ML.rank (Pairing[l].times (suc res.rank0) (suc r0)) (suc zero) (suc n0)) (suc rp.1) =
       trans (ap (\ k -> ML.rank k (suc zero) (suc n0)) tc.2) rp.2 ;
      nR : CO.K.K0.R = CO.IK.nat (suc res.rank0) ;
      nN : CO.K.K0.R = CO.IK.nat (suc NV0) ;
      -- (R r)^n = R^n N
      e-rank : Id CO.K.K0.R (CO.IK.nat (suc rp.1)) (CO.K.K0.mul (CO.PK.power nR (suc n0)) nN) =
       calc CO.K.K0.R { CO.IK.nat (suc rp.1)
         =< ap CO.IK.nat (sym power-eq) > CO.IK.nat (ML.rank (Pairing[l].times (suc res.rank0) (suc r0)) (suc zero) (suc n0))
         =< CO.nat-rank (Pairing[l].times (suc res.rank0) (suc r0)) (suc n0) >
            CO.PK.power (CO.IK.nat (Pairing[l].times (suc res.rank0) (suc r0))) (suc n0)
         =< ap (\ t -> CO.PK.power t (suc n0)) (CO.IK.nat-times (suc res.rank0) (suc r0)) >
            CO.PK.power (CO.K.K0.mul nR (CO.IK.nat (suc r0))) (suc n0)
         =< CO.PK.power-mul nR (CO.IK.nat (suc r0)) (suc n0) >
            CO.K.K0.mul (CO.PK.power nR (suc n0)) (CO.PK.power (CO.IK.nat (suc r0)) (suc n0))
         =< ap (CO.K.K0.mul (CO.PK.power nR (suc n0))) (trans (sym (CO.nat-rank (suc r0) (suc n0))) (ap CO.IK.nat hV)) >
            CO.K.K0.mul (CO.PK.power nR (suc n0)) nN } ;
      -- (good)
      module Pt (w : FP.At[A,fp,TT.Tensor[V',S].PS.descended].Data) {
       p : CP.PJ.Projector = FP.At[A,fp,TT.Tensor[V',S].PS.descended].From[w].projector ;
       cls : Id CO.K.K0.R (CO.K.class p) (CO.K.K0.mul (CO.PK.power (CO.K.class S) (suc n0)) fclass) =
        TT.Tensor[V',S].Class[wP].theorem p FP.At[A,fp,TT.Tensor[V',S].PS.descended].From[w].representation ;
       pos-S : CO.RQ.Positive (CO.PK.power nR (suc n0)) = RP.positive-power nR (CO.RQ.positive res.rank0) (suc n0) ;
       u : CO.K.K0.R = CO.K.K0.mul (CO.PK.power (CO.K.class S) (suc n0)) fclass ;
       theorem : Id CO.RQ.K.R (CO.RQ.rho (CO.K.class p) (CO.IK.nat (suc rp.1)) (CO.RQ.positive rp.1)) CO.RQ.K.o =
        calc CO.RQ.K.R { CO.RQ.rho (CO.K.class p) (CO.IK.nat (suc rp.1)) (CO.RQ.positive rp.1)
          =< ap (\ t -> CO.RQ.rho t (CO.IK.nat (suc rp.1)) (CO.RQ.positive rp.1)) cls >
             CO.RQ.rho u (CO.IK.nat (suc rp.1)) (CO.RQ.positive rp.1)
          =< RP.respect u (CO.IK.nat (suc rp.1)) (CO.K.K0.mul (CO.PK.power nR (suc n0)) nN) (CO.RQ.positive rp.1)
              (CO.RQ.positive-product (CO.PK.power nR (suc n0)) nN pos-S (CO.RQ.positive NV0)) e-rank >
             CO.RQ.rho u (CO.K.K0.mul (CO.PK.power nR (suc n0)) nN) (CO.RQ.positive-product (CO.PK.power nR (suc n0)) nN pos-S (CO.RQ.positive NV0))
          =< RP.product (CO.PK.power (CO.K.class S) (suc n0)) fclass (CO.PK.power nR (suc n0)) nN pos-S (CO.RQ.positive NV0) >
             CO.RQ.K.mul (CO.RQ.rho (CO.PK.power (CO.K.class S) (suc n0)) (CO.PK.power nR (suc n0)) pos-S) CL.rho-f
          =< ap (\ t -> CO.RQ.K.mul t CL.rho-f) (RP.power (CO.K.class S) nR (CO.RQ.positive res.rank0) (suc n0)) >
             CO.RQ.K.mul (RP.PQ.power (CO.RQ.rho (CO.K.class S) nR (CO.RQ.positive res.rank0)) (suc n0)) CL.rho-f
          =< CO.RQ.K.mulC (RP.PQ.power (CO.RQ.rho (CO.K.class S) nR (CO.RQ.positive res.rank0)) (suc n0)) CL.rho-f >
             CO.RQ.K.mul CL.rho-f (RP.PQ.power (CO.RQ.rho (CO.K.class S) nR (CO.RQ.positive res.rank0)) (suc n0))
          =< res.final > CO.RQ.K.o } ;
      } ;
      result : Corrected[V',r0] = new Corrected[V',r0,res.rank0,S,bases,rp.1,power-eq,\ w -> Pt[w].theorem] ;
     } ;
     result : Tr.Trunc[Corrected[V',r0]].carrier = TC.map CL.Result Corrected[V',r0] (\ res -> Given[res].result) CL.explicit ;
    } ;
    result : Tr.Trunc[Corrected[V',r0]].carrier =
     TC.bind (TA.RT.RY.Multiplier (TA.PO.RF'.restrict.1 TA.class-f)) Corrected[V',r0]
      (\ ma -> TC.bind (TB.RT.RY.Multiplier (TB.PO.RF'.restrict.1 TB.class-f)) Corrected[V',r0]
        (\ mb -> Both[ma,mb].result) TB.multiplier) TA.multiplier ;
   } ;
   theorem : Tr.Trunc[Corrected[V',r0]].carrier =
    TC.bind (FP.At[A,fp,PV.descended].Data) Corrected[V',r0] (\ wP -> WithFrames[wP].result) mere ;
  } ;
 } ;
} ;
