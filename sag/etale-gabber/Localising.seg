-- Localising maps.  A ring map psi : R -> C is localising at s in R when
--   (clear) every c in C becomes an image after multiplication by a power
--           of psi s:  psi r = psi (s^k) c  for some k and r;
--   (kill)  every r in R with psi r = 0 is killed by a power of s.
-- Both are bounds that can be raised (EXPONENTBOUNDS): if psi r = psi (s^k) c then
-- psi (s^m r) = psi (s^(m+k)) c, and if s^k r = 0 then s^(m+k) r = 0.
-- The map R -> R_s is localising at s; so is A_b -> A_ab at a, which is
-- why the lemma is stated with localising maps rather than localisations.
level l ; open Ring[l] ;
module B = ExponentBounds[l] ;
module Over (R C : CRing) (psi : RingHom[l].Hom R C) (s : R.R) {
 module PR = AffinePowers[l].Over[R] ;
 pow (k : Nat) : R.R = PR.power s k ;
 Clears (c : C.R) (k : Nat) : U l = (r : R.R) * Id C.R (psi.1 r) (C.mul (psi.1 (pow k)) c) ;
 Kills (r : R.R) (k : Nat) : U l = Id R.R (R.mul (pow k) r) R.z ;
 -- psi (s^(m+k)) c = psi (s^m) (psi (s^k) c)
 image-split (m k : Nat) (c : C.R) :
  Id C.R (C.mul (psi.1 (pow (plus m k))) c) (C.mul (psi.1 (pow m)) (C.mul (psi.1 (pow k)) c)) =
  calc C.R { C.mul (psi.1 (pow (plus m k))) c
    =< ap (\ t -> C.mul (psi.1 t) c) (PR.power-add s m k) > C.mul (psi.1 (R.mul (pow m) (pow k))) c
    =< ap (\ t -> C.mul t c) (psi.2.2.2 (pow m) (pow k)) > C.mul (C.mul (psi.1 (pow m)) (psi.1 (pow k))) c
    =< sym (C.mulA (psi.1 (pow m)) (psi.1 (pow k)) c) > C.mul (psi.1 (pow m)) (C.mul (psi.1 (pow k)) c) } ;
 clears-monotone (c : C.R) : B.Monotone (Clears c) = \ m k h ->
  (R.mul (pow m) h.1,
   calc C.R { psi.1 (R.mul (pow m) h.1)
     =< psi.2.2.2 (pow m) h.1 > C.mul (psi.1 (pow m)) (psi.1 h.1)
     =< ap (C.mul (psi.1 (pow m))) h.2 > C.mul (psi.1 (pow m)) (C.mul (psi.1 (pow k)) c)
     =< sym (image-split m k c) > C.mul (psi.1 (pow (plus m k))) c }) ;
 kills-monotone (r : R.R) : B.Monotone (Kills r) = \ m k h ->
  calc R.R { R.mul (pow (plus m k)) r
    =< ap (\ t -> R.mul t r) (PR.power-add s m k) > R.mul (R.mul (pow m) (pow k)) r
    =< sym (R.mulA (pow m) (pow k) r) > R.mul (pow m) (R.mul (pow k) r)
    =< ap (R.mul (pow m)) h > R.mul (pow m) R.z
    =< RL[R].mul-zero (pow m) > R.z } ;
 record Localising {
  clear (c : C.R) : B.Merely (Clears c) ;
  kill (r : R.R) (h : Id C.R (psi.1 r) C.z) : B.Merely (Kills r) ;
 } ;
} ;
