-- Lemma 1.3.8, normalized generators: local ideals generated by images of
-- elements of A, compatible on iterated localization overlaps.
-- No assumption that the principal opens cover is made.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module AF = AffineFinite[l] ; module FB = FiniteBounds[l] ;
module Finite = IdealGluingFinite[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module At (A : C.Algebra) (m : Nat) (fs : Fin m -> A.ring.R)
  (ls : (i : Fin m) -> I.LocalizationWitness A (fs i))
  (ns : Fin m -> Nat) (gs : (i : Fin m) -> Fin (ns i) -> A.ring.R)
  (os : (i j : Fin m) -> I.LocalizationWitness (ls j).1 ((ls j).2.2.1.1.1 (fs i))) {
  module AP = AffinePowers[l].Over[A.ring] ;
  module Local (j : Fin m) {
   L : C.Algebra = (ls j).1 ;
   inc : C.Hom A L = (ls j).2.2.1 ;
   module G = GeneratedIdeal[l].Over[L.ring,ns j,\ k -> inc.1.1 (gs j k)] ;
   module Pow = AffinePowers[l].Over[L.ring] ;
   image-power (i : Fin m) (a : A.ring.R) (n : Nat) :
    Id L.ring.R (inc.1.1 (A.ring.mul (AP.power (fs i) n) a))
     (L.ring.mul (Pow.power (inc.1.1 (fs i)) n) (inc.1.1 a)) =
    trans (inc.1.2.2.2 (AP.power (fs i) n) a)
     (ap (\ t -> L.ring.mul t (inc.1.1 a)) (AffinePowers[l].power-map A.ring L.ring inc.1 (fs i) n)) ;
  } ;
  module Overlap (i j : Fin m) {
   O : C.Algebra = (os i j).1 ;
   right : C.Hom (Local[j].L) O = (os i j).2.2.1 ;
   base : C.Hom A O = C.compose A Local[j].L O right Local[j].inc ;
   left : C.Hom Local[i].L O = ((ls i).2.2.2.2 O).sec (base,(os i j).2.2.2.1) ;
   beta (a : A.ring.R) : Id O.ring.R (left.1.1 (Local[i].inc.1.1 a)) (base.1.1 a) =
    Pr.ap (I.LocalData A O (fs i)) O.ring.R (\ d -> d.1.1.1 a) _ _
     (((ls i).2.2.2.2 O).sec-eq (base,(os i j).2.2.2.1)) ;
   module G = GeneratedIdeal[l].Over[O.ring,ns j,\ k -> right.1.1 (Local[j].inc.1.1 (gs j k))] ;
   module Clear = LocalizationIdeal[l].Over[R,setR].At[Local[j].L,O,Local[j].inc.1.1 (fs i),
    right,(os i j).2.2.2,ns j,\ k -> Local[j].inc.1.1 (gs j k)] ;
   clear (a : A.ring.R) (h : G.Member (left.1.1 (Local[i].inc.1.1 a))) :
    Clear.Saturated (Local[j].inc.1.1 a) =
    Clear.clear (Local[j].inc.1.1 a) (G.equal _ _ (beta a) h) ;
  } ;
  Compatible : U l = (i j : Fin m) (k : Fin (ns i)) ->
   Overlap[i,j].G.Member (Overlap[i,j].left.1.1 (Local[i].inc.1.1 (gs i k))) ;
  Lifted (i : Fin m) (a : A.ring.R) : U l =
   (N : Nat) * ((j : Fin m) -> Local[j].G.Member (Local[j].inc.1.1 (A.ring.mul (AP.power (fs i) N) a))) ;
  lift-bounds (i : Fin m) (a : A.ring.R)
   (w : (j : Fin m) -> Overlap[i,j].Clear.Witness (Local[j].inc.1.1 a)) : Lifted i a =
   (FB.bound m (\ j -> (w j).1),\ j ->
    Local[j].G.equal _ _ (sym (Local[j].image-power i a (FB.bound m (\ j -> (w j).1))))
     (Finite.PowerMember[Local[j].L.ring,ns j,\ k -> Local[j].inc.1.1 (gs j k)].grow
      (Local[j].inc.1.1 (fs i)) (Local[j].inc.1.1 a) (w j).1 (FB.bound m (\ j -> (w j).1))
      (FB.bounded m (\ j -> (w j).1) j) (w j).2)) ;
  lift-generator (agree : Compatible) (i : Fin m) (k : Fin (ns i)) : Tr.Trunc[Lifted i (gs i k)].carrier =
   Tr.Trunc[(j : Fin m) -> Overlap[i,j].Clear.Witness (Local[j].inc.1.1 (gs i k))].induction @l
    (\ t -> Tr.Trunc[Lifted i (gs i k)].carrier) (\ t -> Tr.Trunc[Lifted i (gs i k)].proposition)
    (\ w -> Tr.Trunc[Lifted i (gs i k)].inc (lift-bounds i (gs i k) w))
    (AF.choice m (\ j -> Overlap[i,j].Clear.Witness (Local[j].inc.1.1 (gs i k)))
     (\ j -> Overlap[i,j].clear (gs i k) (agree i j k))) ;
  Data : U l = (i : Fin m) (k : Fin (ns i)) -> Lifted i (gs i k) ;
  choose (agree : Compatible) : Tr.Trunc[Data].carrier =
   AF.choice m (\ i -> (k : Fin (ns i)) -> Lifted i (gs i k))
    (\ i -> AF.choice (ns i) (\ k -> Lifted i (gs i k)) (lift-generator agree i)) ;
  module Build (w : Data) {
   total : Nat = Finite.count m ns ;
   powered (i : Fin m) (k : Fin (ns i)) : A.ring.R = A.ring.mul (AP.power (fs i) (w i k).1) (gs i k) ;
   generators : Fin total -> A.ring.R = Finite.collect A.ring.R m ns powered ;
   module AtLocal (j : Fin m) {
    module Old = Local[j].G ;
    module New = GeneratedIdeal[l].Over[Local[j].L.ring,total,\ k -> Local[j].inc.1.1 (generators k)] ;
    module Cancel = LocalizationIdeal[l].Over[R,setR].At[A,Local[j].L,fs j,Local[j].inc,
     (ls j).2.2.2,total,generators] ;
    new-in-old (k : Fin total) : Old.Member (Local[j].inc.1.1 (generators k)) =
     Finite.collect-all A.ring.R (\ a -> Old.Member (Local[j].inc.1.1 a)) m ns powered
      (\ i t -> (w i t).2 j) k ;
    old-in-new (k : Fin (ns j)) : New.Member (Local[j].inc.1.1 (gs j k)) =
     Cancel.cancel (Local[j].Pow.power (Local[j].inc.1.1 (fs j)) (w j k).1) (Local[j].inc.1.1 (gs j k))
      (Local[j].Pow.Units[Local[j].L.set].power-unit (Local[j].inc.1.1 (fs j)) (ls j).2.2.2.1 (w j k).1)
      (New.equal _ _
       (trans (ap Local[j].inc.1.1 (Finite.collect-index A.ring.R m ns powered j k))
        (Local[j].image-power j (gs j k) (w j k).1))
       (New.generator (Finite.index m ns j k))) ;
    forward (a : Local[j].L.ring.R) : New.Member a -> Old.Member a =
     Old.includes total (\ k -> Local[j].inc.1.1 (generators k)) new-in-old a ;
    backward (a : Local[j].L.ring.R) : Old.Member a -> New.Member a =
     New.includes (ns j) (\ k -> Local[j].inc.1.1 (gs j k)) old-in-new a ;
   } ;
  } ;
  Result : U l = (N : Nat) * (hs : Fin N -> A.ring.R) *
   ((j : Fin m) (a : Local[j].L.ring.R) ->
    (GeneratedIdeal[l].Over[Local[j].L.ring,N,\ k -> Local[j].inc.1.1 (hs k)].Member a -> Local[j].G.Member a) *
    (Local[j].G.Member a -> GeneratedIdeal[l].Over[Local[j].L.ring,N,\ k -> Local[j].inc.1.1 (hs k)].Member a)) ;
  glue (agree : Compatible) : Tr.Trunc[Result].carrier =
   Tr.Trunc[Data].induction @l (\ t -> Tr.Trunc[Result].carrier) (\ t -> Tr.Trunc[Result].proposition)
    (\ w -> Tr.Trunc[Result].inc (Build[w].total,Build[w].generators,
     \ j a -> (Build[w].AtLocal[j].forward a,Build[w].AtLocal[j].backward a))) (choose agree) ;
 } ;
} ;
