-- The splitting groupoid of an algebra E (Giraud's gerbe of splittings;
-- interface shared by the workers of the H^2 bridges, see
-- ../HANDOFF-GABBER-HOMOTOPY.md, "H^2 bridges").
-- An object is a module U, merely free of rank N, with an algebra
-- isomorphism sigma : E = End U (a splitting).  A morphism (U, sigma) ->
-- (U', sigma') is a linear bijection a : U -> U' with
--     a (sigma(s) x) = sigma'(s) (a x)        for all s in E,
-- i.e. a carries one splitting to the other (as SPLITCOMPARISON.Arrow, where
-- sigma is the evaluation of the descended End at g).  Morphisms are
-- determined by their function (Good is a proposition).
-- The scalar morphisms u . id (u a unit) are morphisms at every object
-- (sigma(s) is linear).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module EN = ModuleEnd[l].Over[R,setR] ;
 module AS = AlgSIP[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module At (N : Nat) (E : EN.NA.Algebra) {
  Splits (M : MD.Module) : U l = AS.AlgIso E EN.At[M].algebra ;
  Obj : U l+ = (M : MD.Module) * Tr.Trunc[LF.Basis[M,N]].carrier * Splits M ;
  -- accessors
  carrier (o : Obj) : MD.Module = o.1 ;
  act (o : Obj) (s : E.A) (x : (carrier o).M) : (carrier o).M = ((o.2.2.1.1 s).1) x ;
  Lin (o o' : Obj) : U l = HM.At[carrier o,carrier o'].S.E ;
  Good (o o' : Obj) (a : Lin o o') : U l = Pr.isEquiv (carrier o).M (carrier o').M a.1
   * ((s : E.A) (x : (carrier o).M) -> Id (carrier o').M (a.1 (act o s x)) (act o' s (a.1 x))) ;
  Arrow (o o' : Obj) : U l = (a : Lin o o') * Good o o' a ;
  good-prop (o o' : Obj) (a : Lin o o') : Pr.isProp (Good o o' a) =
   Pr.isProp-Sigma (Pr.isEquiv (carrier o).M (carrier o').M a.1)
    (\ b -> (s : E.A) (x : (carrier o).M) -> Id (carrier o').M (a.1 (act o s x)) (act o' s (a.1 x)))
    (Prop331Paths[l].isEquiv-prop (carrier o).M (carrier o').M a.1)
    (\ b -> F.isProp-Pi E.A (\ s -> (x : (carrier o).M) -> Id (carrier o').M (a.1 (act o s x)) (act o' s (a.1 x))) (\ s ->
     F.isProp-Pi (carrier o).M (\ x -> Id (carrier o').M (a.1 (act o s x)) (act o' s (a.1 x))) (\ x -> (carrier o').setM _ _))) ;
  arrow-set (o o' : Obj) : Pr.isSet (Arrow o o') =
   Torsor[l].isSet-sub (Lin o o') (Good o o') HM.At[carrier o,carrier o'].carrier.setM (good-prop o o') ;
  arrow-eq (o o' : Obj) (a b : Arrow o o') (h : (x : (carrier o).M) -> Id (carrier o').M (a.1.1 x) (b.1.1 x)) : Id (Arrow o o') a b =
   Pr.Sigma-eq (Lin o o') (Good o o') a.1 b.1 a.2 b.2 (HM.At[carrier o,carrier o'].ext a.1 b.1 h) (good-prop o o' b.1) ;
  identity (o : Obj) : Arrow o o = (EN.At[carrier o].one,(Pr.idEquiv (carrier o).M).2,\ s x -> refl (act o s x)) ;
  scalar (o : Obj) (u : UG.Unit) : Arrow o o =
   (EN.At[carrier o].V.sm u.1 EN.At[carrier o].one,
    (Pr.qinv (carrier o).M (carrier o).M (\ x -> (carrier o).sm u.1 x) (\ x -> (carrier o).sm u.2.1 x)
      (\ x -> trans ((carrier o).smA u.1 u.2.1 x) (trans (ap (\ c -> (carrier o).sm c x) u.2.2) ((carrier o).smO x)))
      (\ x -> trans ((carrier o).smA u.2.1 u.1 x)
       (trans (ap (\ c -> (carrier o).sm c x) (trans (R.mulC u.2.1 u.1) u.2.2)) ((carrier o).smO x)))),
    \ s x -> sym (((o.2.2.1.1 s).2.2) u.1 x)) ;
 } ;
} ;
