-- Theorem main without line data (gabber-recollement, the remark after
-- Theorem main).  A f.p., G x R^x-gerbes on Spec A (merely inhabited, by
-- definition), Lambda of weight n = n0 + 1 whose fibres merely have bases of
-- rank 1.  Then merely there is a twisted family on Spec A whose fibres
-- merely have bases of one rank r0 + 1.
-- For x in Spec A and g in G x let desc x g be P(L)^v descended at x, for
-- the twisted line L = Line(g = -) (TWISTEDLINE).
--  (local)  desc x g merely has a basis of rank 1: it is the fibre at g
--     (TWISTEDMODULES.Descent; weight 0 by MULTILINEAR), the iterated Hom
--     power L(g) Lambda(g) n, and L(g) (TWISTEDMAIN.LineBasis), Lambda(g)
--     have bases of rank 1, so the iterated Hom has one of rank 1^n = 1
--     (HOMBASES).  G x is merely inhabited, so merely there are g and a basis.
--  (choice)  Z-choice for x |-> (g : G x) * Basis(desc x g, 1): merely
--     u_1 .. u_k with sum u_i c_i = 1 and on each D(u_i) a point g and a basis
--     (sigma, c) depending on x.  On Spec L_(u_i), composed with p_(u_i), this
--     is a LineDatum (TWISTEDMAIN): sigma, c have c(sigma) = 1 (the basis is
--     dual) and m = c(m) sigma (the frame law); L_(u_i) exists merely.
--  (empty)  If k = 0 then 1 = 0 in A, so 1 = x(1) = x(0) = 0 in R for any
--     point x, which locality excludes: Spec A is empty.
--  Otherwise TWISTEDMAIN.Main applies.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ; module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module HB = HomBases[l].Over[R,setR,axioms] ;
 module TN = TwistedMain[l].Over[R,setR,axioms,loc] ;
 -- bases of iterated Homs of rank-1 modules
 power-bases (Q L : MD.Module) (bq : Tr.Trunc[LF.Basis[Q,suc zero]].carrier) (bl : Tr.Trunc[LF.Basis[L,suc zero]].carrier) :
  (k : Nat) -> Tr.Trunc[LF.Basis[ML.power Q L k,ML.rank (suc zero) (suc zero) k]].carrier = split {
  zero -> bl ;
  suc k | b -> HB.hom-bases Q (ML.power Q L k) (suc zero) (ML.rank (suc zero) (suc zero) k) bq b } ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TM.GB.AGerbe)
  (n0 : Nat) (Lambda : TM.Family[C.Spec A,G].Weighted (\ c -> TM.UG.power c (suc n0)))
  (bl : (x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier) {
  module TA = TN.At[A,fp,G,n0,Lambda,bl] ;
  -- the iterated Homs at x for the line of g, and their descent
  H (x : C.Spec A) (g g' : (G x).1) : MD.Module =
   ML.power (TwistedLine[l].Over[R,setR].At[G x,g].line g') (Lambda.1 x g') (suc n0) ;
  desc (x : C.Spec A) (g : (G x).1) : MD.Module = TM.At[TM.charge (TM.banded (G x))].Invariant[H x g].carrier ;
  Local (x : C.Spec A) : U l = (g : (G x).1) * LF.Basis[desc x g,suc zero] ;
  -- (local)
  module Pt (x : C.Spec A) (g : (G x).1) {
   module TL = TwistedLine[l].Over[R,setR].At[G x,g] ;
   fibre : Id MD.Module (desc x g) (H x g g) =
    TM.At[TM.charge (TM.banded (G x))].Descent[H x g,ML.At[G x].Dual[suc n0,TL.line,Lambda.1 x,TL.weight,Lambda.2 x].weight,g].theorem ;
   at-g : Tr.Trunc[LF.Basis[H x g g,suc zero]].carrier =
    subst (\ r -> Tr.Trunc[LF.Basis[H x g g,r]].carrier) (TN.rank-one (suc n0))
     (power-bases (TL.line g) (Lambda.1 x g) (TN.LineBasis[G x,g].basis g) (bl x g) (suc n0)) ;
   basis : Tr.Trunc[LF.Basis[desc x g,suc zero]].carrier =
    HB.transport (H x g g) (desc x g) (Pr1.sym MD.Module (desc x g) (H x g g) fibre) (suc zero) at-g ;
  } ;
  local (x : C.Spec A) : Tr.Trunc[Local x].carrier =
   Tr.Trunc[(G x).1].induction @l (\ t -> Tr.Trunc[Local x].carrier) (\ t -> Tr.Trunc[Local x].proposition)
    (\ g -> TC.map (LF.Basis[desc x g,suc zero]) (Local x) (\ b -> (g,b)) Pt[x,g].basis) (G x).2.2.1 ;
  -- (choice)
  module LineOf (u : A.ring.R) (sec : (x : C.Spec A) -> RL[R].unit (x.1.1 u) -> Local x)
   (lw : AI.LocalizationWitness A u) {
   module OU = TA.GO.On[u] ;
   at (y : C.Spec lw.1) : Local (OU.point lw y).1 = sec (OU.point lw y).1 (OU.point lw y).2 ;
   datum : TA.Lines[u].LineDatum = new TA.Lines[u].LineDatum[lw,\ y -> (at y).1,
    \ y -> (at y).2.frame.vector (inr tt),\ y -> (at y).2.frame.form (inr tt),
    \ y m -> (at y).2.frame.law m,
    \ y -> trans ((at y).2.dual (inr tt) (inr tt)) (MnSums[l].Over[R].delta-diag (suc zero) (inr tt))] ;
  } ;
  lines (u : A.ring.R) (sec : (x : C.Spec A) -> RL[R].unit (x.1.1 u) -> Local x) : Tr1.Trunc[TA.Lines[u].LineDatum].carrier =
   TC1.map (AI.LocalizationWitness A u) TA.Lines[u].LineDatum (\ lw -> LineOf[u,sec,lw].datum) (AI.localize A fp u) ;
  -- (empty)
  module NoPoint (one : Id A.ring.R A.ring.z A.ring.o) (x : C.Spec A) {
   collapse : Id R.R R.o R.z =
    trans (sym x.1.2.1) (trans (ap x.1.1 (sym one)) (RingHom[l].zero A.ring R x.1)) ;
   empty : Empty = loc.1 collapse ;
  } ;
  empty-result (one : Id A.ring.R A.ring.z A.ring.o) : TA.Result =
   (zero,(\ x g -> MD.regular,\ x -> absurd (TM.At[TM.charge (TM.banded (G x))].Weight (\ c -> c) (\ g -> MD.regular)) NoPoint[one,x].empty),
    \ x g -> Tr.Trunc[LF.Basis[MD.regular,suc zero]].inc TN.regular-basis) ;
  from : (n : Nat) (u c : Fin n -> A.ring.R) -> Id A.ring.R (TA.S.sum n (\ i -> A.ring.mul (u i) (c i))) A.ring.o ->
   ((i : Fin n) (x : C.Spec A) -> RL[R].unit (x.1.1 (u i)) -> Local x) -> Tr1.Trunc[TA.Result].carrier = split {
   zero -> \ u c one sec -> Tr1.Trunc[TA.Result].inc (empty-result one) ;
   suc k | r -> \ u c one sec -> TA.Main[k,u,c,one,\ i -> lines (u i) (sec i)].theorem } ;
  module Cover (d : Ax.ChoiceData A Local) {
   theorem : Tr1.Trunc[TA.Result].carrier =
    Tr.Trunc[Ax.UnimodularWitness A d.1 d.2.1].induction @(l+) (\ t -> Tr1.Trunc[TA.Result].carrier)
     (\ t -> Tr1.Trunc[TA.Result].proposition) (\ w -> from d.1 d.2.1 w.1 w.2 d.2.2.2) d.2.2.1 ;
  } ;
  theorem : Tr1.Trunc[TA.Result].carrier =
   Tr.Trunc[Ax.ChoiceData A Local].induction @(l+) (\ t -> Tr1.Trunc[TA.Result].carrier)
    (\ t -> Tr1.Trunc[TA.Result].proposition) (\ d -> Cover[d].theorem) (axioms.zchoice A fp Local local) ;
 } ;
} ;
