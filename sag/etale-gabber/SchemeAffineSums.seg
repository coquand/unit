-- The first stage of 5.6.1: scheme base and affine fibres give a scheme.
-- Local choice gives presentation codes on charts, boundedness fixes the
-- variable count there, and AffineSigma proves each local total affine.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module Choice = SchemeChoice[l].Over[R,setR,axioms] ;
 module Bound = SchemeBounded[l].Over[R,setR,axioms] ;
 module AS = AffineSigma[l].Over[R,setR,axioms] ;
 module CS = CoverSigma[l].Over[R,setR,axioms] ;
 module Chosen (X : U l) (affX : FA.Affine X) (Y : X -> U l)
  (ws : (x : X) -> SA.Witness (Y x)) {
  Total : U l = (x : X) * Y x ;
  count (x : X) : Nat = (ws x).1.1 ;
  theorem : S.Scheme Total =
   Tr.Trunc[Bound.Goal X count].induction @l (\ t -> S.Scheme Total) (\ t -> S.proposition Total)
    (\ b -> SB.affine Total (AS.bounded X affX Y ws b.1 b.2)) (Bound.theorem X affX count) ;
 } ;
 module Local (X : U l) (Y : X -> U l) (w : Choice.Witness X (\ x -> SA.Witness (Y x))) {
  c : S.Cover[X] = w.1 ;
  module Part (i : Fin c.size) {
   D : U l = S.Domain X (c.charts i) ;
   affine : FA.Affine D = SA.Presented[(c.charts i).presentation].affine ;
   family (a : D) : U l = Y ((c.charts i).map a) ;
   theorem : S.Scheme ((a : D) * family a) =
    Chosen[D,affine,family,w.2 i].theorem ;
  } ;
  theorem : S.Scheme ((x : X) * Y x) = CS.At[X,c,Y].theorem (\ i -> Part[i].theorem) ;
 } ;
 theorem (X : U l) (scheme : S.Scheme X) (Y : X -> U l)
  (affines : (x : X) -> FA.Affine (Y x)) : S.Scheme ((x : X) * Y x) =
  Tr.Trunc[Choice.Witness X (\ x -> SA.Witness (Y x))].induction @l
   (\ t -> S.Scheme ((x : X) * Y x)) (\ t -> S.proposition ((x : X) * Y x))
   (\ w -> Local[X,Y,w].theorem)
   (Choice.theorem X scheme (\ x -> SA.Witness (Y x)) (\ x -> SA.from-affine (Y x) (affines x))) ;
} ;
