-- SAG 5.5.2: every equality type of a scheme is a scheme.
-- Choose an affine chart around x only inside the proposition Scheme(x=y).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module M = SchemeMaps[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module ST = SchemeSubtype[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module SS = SchemeSubtypes[l].Over[R,setR,axioms] ;
 module AE = AffineEquality[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 module InChart (X : U l) (sX : Pr.isSet X) (c : S.Chart[X]) (x y : X) (ux : S.Image X c x) {
  image : X -> U l = S.Image X c ;
  prop (z : X) : Pr.isProp (image z) = M.image-prop (S.Domain X c) X c.map z ;
  T : U l = (z : X) * image z ;
  xx : T = (x,ux) ;
  Equal (u : image y) : U l = Id T xx (y,u) ;
  closed (u : image y) : CP.Closed (Equal u) = AE.closed T (ST.chart-affine X c) xx (y,u) ;
  E : U l = (u : image y) * Equal u ;
  local-scheme : S.Scheme E =
   SS.closed-subtype (image y) (SS.open-proposition (image y) (c.open-image y)) Equal closed ;
  eq-prop (u : image y) : Pr.isProp (Equal u) =
   Pr.isSet-Sigma X image sX (\ z -> Pr.prop-to-set (image z) (prop z)) xx (y,u) ;
  e-prop : Pr.isProp E = Pr.isProp-Sigma (image y) Equal (prop y) eq-prop ;
  to (u : E) : Id X x y = Pr.ap T X (\ a -> a.1) xx (y,u.1) u.2 ;
  from (p : Id X x y) : E =
   (Pr.subst X image x y p ux,
    Pr.Sigma-eq X image x y ux (Pr.subst X image x y p ux) p (prop y)) ;
  equivalence : Pr.Equiv E (Id X x y) =
   (to,Pr.qinv E (Id X x y) to from (\ p -> sX x y _ p) (\ u -> e-prop _ u)) ;
  theorem : S.Scheme (Id X x y) = SB.along E (Id X x y) equivalence local-scheme ;
 } ;
 module OnCover (X : U l) (c : S.Cover[X]) (x y : X) {
  theorem : S.Scheme (Id X x y) =
   Tr.Trunc[(i : Fin c.size) * S.Image X (c.charts i) x].induction @l
    (\ t -> S.Scheme (Id X x y)) (\ t -> S.proposition (Id X x y))
    (\ u -> InChart[X,S.cover-set X c,c.charts u.1,x,y,u.2].theorem) (c.covers x) ;
 } ;
 theorem (X : U l) (s : S.Scheme X) (x y : X) : S.Scheme (Id X x y) =
  Tr.Trunc[S.Cover[X]].induction @l (\ t -> S.Scheme (Id X x y)) (\ t -> S.proposition (Id X x y))
   (\ c -> OnCover[X,c,x,y].theorem) s ;
} ;
