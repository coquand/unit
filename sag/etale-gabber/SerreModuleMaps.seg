-- Linear maps with explicit scalar change.  Restriction along A -> B
-- equips a B-module with its A-action.  A semilinear map is additive
-- and carries a*x to h(a)*f(x); zero and negatives follow by cancellation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ;
module RM = RingMaps[l] ; module SM = SerreModule[l] ;
module Between (A B : CRing) (h : RH.Hom A B)
 (Md : SM.Over[A].Module) (Nd : SM.Over[B].Module) {
 record Hom {
  fn : Md.M -> Nd.M ;
  additive (x y : Md.M) : Id Nd.M (fn (Md.madd x y)) (Nd.madd (fn x) (fn y)) ;
  scalar (a : A.R) (x : Md.M) : Id Nd.M (fn (Md.sm a x)) (Nd.sm (RM.map h a) (fn x)) ;
 } ;
 map (f : Hom) : Md.M -> Nd.M = f.fn ;
 map-add (f : Hom) (x y : Md.M) : Id Nd.M (map f (Md.madd x y)) (Nd.madd (map f x) (map f y)) = f.additive x y ;
 map-scale (f : Hom) (a : A.R) (x : Md.M) : Id Nd.M (map f (Md.sm a x)) (Nd.sm (RM.map h a) (map f x)) = f.scalar a x ;
 map-zero (f : Hom) : Id Nd.M (map f Md.mz) Nd.mz =
  SM.Over[B].Laws[Nd].cancel (map f Md.mz) (map f Md.mz)
   (trans (sym (map-add f Md.mz Md.mz)) (ap (map f) (Md.maddZ Md.mz))) ;
 map-neg (f : Hom) (x : Md.M) : Id Nd.M (map f (Md.mneg x)) (Nd.mneg (map f x)) =
  SM.Over[B].Laws[Nd].neg-unique (map f x) (map f (Md.mneg x))
   (trans (sym (map-add f x (Md.mneg x))) (trans (ap (map f) (Md.maddN x)) (map-zero f))) ;
} ;
module RestrictScalars (A B : CRing) (h : RH.Hom A B) {
 module Of (Nd : SM.Over[B].Module) {
  restricted : SM.Over[A].Module = new SM.Over[A].Module[
   Nd.M,Nd.setM,Nd.mz,Nd.madd,Nd.mneg,Nd.maddA,Nd.maddC,Nd.maddZ,Nd.maddN,
   \ a x -> Nd.sm (RM.map h a) x,
   \ a b x -> trans (Nd.smA (RM.map h a) (RM.map h b) x)
    (ap (\ c -> Nd.sm c x) (sym (RM.map-mul h a b))),
   \ x -> trans (ap (\ c -> Nd.sm c x) (RM.map-one h)) (Nd.smO x),
   \ a x y -> Nd.smD (RM.map h a) x y,
   \ a b x -> trans (ap (\ c -> Nd.sm c x) (RM.map-add h a b))
    (Nd.smE (RM.map h a) (RM.map h b) x)] ;
  scalar-at (a : A.R) (x : Nd.M) : Id Nd.M (restricted.sm a x) (Nd.sm (RM.map h a) x) = refl (Nd.sm (RM.map h a) x) ;
 } ;
} ;
