-- Fibres, embeddings, and their small images. No set assumption on the target.
level l ; open Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
Fiber (A X : U l) (f : A -> X) (x : X) : U l = (a : A) * Id X (f a) x ;
Embedding (A X : U l) (f : A -> X) : U l = (x : X) -> isProp (Fiber A X f x) ;
Image (A X : U l) (f : A -> X) (x : X) : U l = Tr.Trunc[Fiber A X f x].carrier ;
image-prop (A X : U l) (f : A -> X) (x : X) : isProp (Image A X f x) =
 Tr.Trunc[Fiber A X f x].proposition ;
injective-embedding (A X : U l) (sX : isSet X) (f : A -> X)
 (inj : (a b : A) -> Id X (f a) (f b) -> Id A a b) : Embedding A X f = \ x u v ->
 Sigma-eq A (\ a -> Id X (f a) x) u.1 v.1 u.2 v.2
  (inj u.1 v.1 (trans X _ _ _ u.2 (sym X _ _ v.2))) (sX (f v.1) x) ;
module Embedded (A X : U l) (f : A -> X) (emb : Embedding A X f) {
 injective (a b : A) (p : Id X (f a) (f b)) : Id A a b =
  ap (Fiber A X f (f b)) A (\ w -> w.1) _ _ (emb (f b) (a,p) (b,refl (f b))) ;
 choose (x : X) (u : Image A X f x) : Fiber A X f x =
  Tr.Trunc[Fiber A X f x].induction @l (\ t -> Fiber A X f x) (\ t -> emb x) (\ w -> w) u ;
 fiber-image (x : X) : Equiv (Fiber A X f x) (Image A X f x) =
  (Tr.Trunc[Fiber A X f x].inc,qinv _ _ Tr.Trunc[Fiber A X f x].inc (choose x)
   (\ u -> image-prop A X f x _ u) (\ w -> emb x _ w)) ;
 Total : U l = (x : X) * Image A X f x ;
 include (a : A) : Total = (f a,Tr.Trunc[Fiber A X f (f a)].inc (a,refl (f a))) ;
 back (u : Total) : A = (choose u.1 u.2).1 ;
 bf (a : A) : Id A (back (include a)) a =
  ap (Fiber A X f (f a)) A (\ w -> w.1) _ _ (emb (f a) (choose (f a) (include a).2) (a,refl (f a))) ;
 fb (u : Total) : Id Total (include (back u)) u =
  Sigma-eq X (Image A X f) _ _ _ _ (choose u.1 u.2).2 (image-prop A X f u.1) ;
 equivalence : Equiv A Total = (include,qinv A Total include back fb bf) ;
 -- A chart makes every equality starting at one of its points a proposition.
 module LocalSet (sA : isSet A) (a : A) {
  Rel (x : X) : U l = (w : Fiber A X f x) * Id A a w.1 ;
  rel-prop (x : X) : isProp (Rel x) =
   isProp-Sigma (Fiber A X f x) (\ w -> Id A a w.1) (emb x) (\ w -> sA a w.1) ;
  decode (x : X) (r : Rel x) : Id X (f a) x =
   trans X (f a) (f r.1.1) x (ap A X f a r.1.1 r.2) r.1.2 ;
  at : (x : X) -> isProp (Id X (f a) x) =
   Hedberg[X,f a,Rel,rel-prop,((a,refl (f a)),refl a),decode].hedberg ;
 } ;
} ;
-- Projection of a proposition-valued subtype is an embedding, without
-- assuming that X is a set.
module Subtype (X : U l) (S : X -> U l) (prop : (x : X) -> isProp (S x)) {
 Total : U l = (x : X) * S x ;
 map (u : Total) : X = u.1 ;
 value (x : X) (w : Fiber Total X map x) : S x = subst X S w.1.1 x w.2 w.1.2 ;
 point (x : X) (s : S x) : Fiber Total X map x = ((x,s),refl x) ;
 eta (u : Total) (x : X) (p : Id X u.1 x) :
  Id (Fiber Total X map x) (point x (subst X S u.1 x p u.2)) (u,p) =
  idJ X u.1 (\ x p -> Id (Fiber Total X map x) (point x (subst X S u.1 x p u.2)) (u,p))
   (refl (u,refl u.1)) x p ;
 embedding (x : X) : isProp (Fiber Total X map x) = \ u v ->
  trans _ _ _ _ (sym _ _ _ (eta u.1 x u.2))
   (trans _ _ _ _ (ap (S x) (Fiber Total X map x) (point x) _ _ (prop x (value x u) (value x v)))
    (eta v.1 x v.2)) ;
 image-to (x : X) (u : Image Total X map x) : S x =
  Tr.Trunc[Fiber Total X map x].induction @l (\ t -> S x) (\ t -> prop x) (value x) u ;
 image-from (x : X) (s : S x) : Image Total X map x = Tr.Trunc[Fiber Total X map x].inc (point x s) ;
 image-equiv (x : X) : Equiv (Image Total X map x) (S x) =
  (image-to x,qinv _ _ (image-to x) (image-from x)
   (\ s -> prop x _ s) (\ u -> image-prop Total X map x _ u)) ;
} ;
