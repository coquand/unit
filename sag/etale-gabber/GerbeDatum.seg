-- The gerbe datum by Z-choice (../HANDOFF-GABBER-HOMOTOPY.md).  Let G be a
-- family of R^x-gerbes over Spec Alg, Alg finitely presented.  Merely:
--  (points)   each G x is merely inhabited, so Z-choice (SAGAXIOMS) gives a
--             unimodular u_1, .., u_n and points s_i of G over D(u_i);
--  (localisations)  fix a presentation of Alg; every u_i, u_i u_j and
--             (u_i u_j) u_k is merely an expression in its generators
--             (AFFINEGENERATED), by finite choice all of them at once, and
--             then Alg[1/u_i], Alg[1/u_i u_j] and Alg[1/(u_i u_j) u_k] are
--             given (AFFINEINTERFACE.Presented);
--  (frames)   over D(u_i u_j) the paths s_i x = s_j x form a torsor
--             (GERBELINES); the frame data of its line exist merely
--             (AFFINELINEDATA), by finite choice for all i, j at once.
-- Every truncation eliminated is at level l (the presentation is fixed
-- first), so finite choice is only used at level l.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module UG = PicardUnits[l].Over[R,setR] ;
 module GB = Gerbe[l].Gerbes[UG.group] ;
 module GLO = GerbeLines[l].Over[R,setR,axioms] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> GB.AGerbe) {
  -- (points)
  Points : U l = Ax.ChoiceData Alg (\ x -> (G x).1) ;
  points : Tr.Trunc[Points].carrier = axioms.zchoice Alg fp (\ x -> (G x).1) (\ x -> (G x).2.2.1) ;
  module Cover (c : Points) {
   n : Nat = c.1 ;
   u : Fin n -> Alg.ring.R = c.2.1 ;
   unimodular : Ax.Unimodular Alg n u = c.2.2.1 ;
   s (i : Fin n) (x : AI.D Alg (u i)) : (G x.1).1 = c.2.2.2 i x.1 x.2 ;
   uu (i j : Fin n) : Alg.ring.R = Alg.ring.mul (u i) (u j) ;
   uuu (i j k : Fin n) : Alg.ring.R = Alg.ring.mul (uu i j) (u k) ;
   Frames (i j : Fin n) (loc : AI.LocalizationWitness Alg (uu i j)) : U l =
    GLO.At[Alg,fp,G,u i,u j,s i,s j].Line[loc].LA.D.Data ;
  } ;
  record Datum {
   cover : Points ;
   singles : (i : Fin cover.1) -> AI.LocalizationWitness Alg (Cover[cover].u i) ;
   pairs : (i j : Fin cover.1) -> AI.LocalizationWitness Alg (Cover[cover].uu i j) ;
   frames : (i j : Fin cover.1) -> Cover[cover].Frames i j (pairs i j) ;
   triples : (i j k : Fin cover.1) -> AI.LocalizationWitness Alg (Cover[cover].uuu i j k) ;
  } ;
  -- (localisations) and (frames), for a presentation w and the points c
  module Choose (w : P.Witness Alg) (c : Points) {
   module AG = AffineGenerated[l].Over[R,setR,Alg,w.1,w.2] ;
   module CV = Cover[c] ;
   at (f : Alg.ring.R) (e : AG.Rep f) : AI.LocalizationWitness Alg f = AI.Presented[Alg,w.1,w.2,f,e.1,e.2].result ;
   SingleReps : U l = (i : Fin CV.n) -> AG.Rep (CV.u i) ;
   PairReps : U l = (i j : Fin CV.n) -> AG.Rep (CV.uu i j) ;
   TripleReps : U l = (i j k : Fin CV.n) -> AG.Rep (CV.uuu i j k) ;
   single-reps : Tr.Trunc[SingleReps].carrier =
    AffineFinite[l].choice CV.n (\ i -> AG.Rep (CV.u i)) (\ i -> AG.generated (CV.u i)) ;
   pair-reps : Tr.Trunc[PairReps].carrier =
    AffineFinite[l].choice CV.n (\ i -> (j : Fin CV.n) -> AG.Rep (CV.uu i j)) (\ i ->
     AffineFinite[l].choice CV.n (\ j -> AG.Rep (CV.uu i j)) (\ j -> AG.generated (CV.uu i j))) ;
   triple-reps : Tr.Trunc[TripleReps].carrier =
    AffineFinite[l].choice CV.n (\ i -> (j k : Fin CV.n) -> AG.Rep (CV.uuu i j k)) (\ i ->
     AffineFinite[l].choice CV.n (\ j -> (k : Fin CV.n) -> AG.Rep (CV.uuu i j k)) (\ j ->
      AffineFinite[l].choice CV.n (\ k -> AG.Rep (CV.uuu i j k)) (\ k -> AG.generated (CV.uuu i j k)))) ;
   module Framed (sr : SingleReps) (pr : PairReps) (tr : TripleReps) {
    singles (i : Fin CV.n) : AI.LocalizationWitness Alg (CV.u i) = at (CV.u i) (sr i) ;
    pairs (i j : Fin CV.n) : AI.LocalizationWitness Alg (CV.uu i j) = at (CV.uu i j) (pr i j) ;
    triples (i j k : Fin CV.n) : AI.LocalizationWitness Alg (CV.uuu i j k) = at (CV.uuu i j k) (tr i j k) ;
    AllFrames : U l = (i j : Fin CV.n) -> CV.Frames i j (pairs i j) ;
    frames : Tr.Trunc[AllFrames].carrier =
     AffineFinite[l].choice CV.n (\ i -> (j : Fin CV.n) -> CV.Frames i j (pairs i j)) (\ i ->
      AffineFinite[l].choice CV.n (\ j -> CV.Frames i j (pairs i j)) (\ j ->
       GLO.At[Alg,fp,G,CV.u i,CV.u j,CV.s i,CV.s j].Line[pairs i j].LA.D.theorem)) ;
    result : Tr1.Trunc[Datum].carrier =
     Tr.Trunc[AllFrames].induction @(l+) (\ t -> Tr1.Trunc[Datum].carrier) (\ t -> Tr1.Trunc[Datum].proposition)
      (\ fr -> Tr1.Trunc[Datum].inc (new Datum[c,singles,pairs,fr,triples])) frames ;
   } ;
   result : Tr1.Trunc[Datum].carrier =
    Tr.Trunc[SingleReps].induction @(l+) (\ t -> Tr1.Trunc[Datum].carrier) (\ t -> Tr1.Trunc[Datum].proposition)
     (\ sr -> Tr.Trunc[PairReps].induction @(l+) (\ t -> Tr1.Trunc[Datum].carrier) (\ t -> Tr1.Trunc[Datum].proposition)
      (\ pr -> Tr.Trunc[TripleReps].induction @(l+) (\ t -> Tr1.Trunc[Datum].carrier) (\ t -> Tr1.Trunc[Datum].proposition)
       (\ tr -> Framed[sr,pr,tr].result) triple-reps) pair-reps) single-reps ;
  } ;
  theorem : Tr1.Trunc[Datum].carrier =
   Tr1.Trunc[P.Witness Alg].induction @(l+) (\ t -> Tr1.Trunc[Datum].carrier) (\ t -> Tr1.Trunc[Datum].proposition)
    (\ w -> Tr.Trunc[Points].induction @(l+) (\ t -> Tr1.Trunc[Datum].carrier) (\ t -> Tr1.Trunc[Datum].proposition)
     (\ c -> Choose[w,c].result) points) fp ;
 } ;
} ;
