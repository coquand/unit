-- The twisted push-forward theorem (GABBER-PROPER-DESIGN.md, section 3).
-- Theorem.  A f.p., G : Spec A -> TGerbe, Lambda of weight n0+1 on G whose
-- fibres merely have bases of rank 1.  Then merely a twisted family V on G
-- (weight 1) and, at each x, a rank k x such that every V x g merely has a
-- basis of rank k x + 1.
--  (flatten)  G x is close-inhabited, so merely a tower t over Spec A with
--             ||G (base z)|| at each point z (FLATTENING).
--  (zariski)  On an affine Z with b : Z -> Spec A and ||G (b z)|| at each z,
--             the gerbes G (b z) are Zariski gerbes (connected by HILBERT90,
--             TGERBES.connected), so ZARISKIMAIN gives merely a twisted family
--             on them with fibre bases of one rank r0+1.  Proved for Z = Spec D,
--             then for any affine Z along the path Z = Spec D (ua), once.
--             The points of t are affine (TOWERAFFINE.over-spec).
--  (push)     TWISTEDPUSH along t.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module TW = Towers[l].Over[R,setR] ;
 module TP = TwistedPush[l].Over[R,setR,axioms,sh] ;
 module ZM = ZariskiMain[l].Over[R,setR,axioms,loc] ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TG.TGerbe) (n0 : Nat)
  (Lam : (x : C.Spec A) -> (G x).carrier -> MD.Module)
  (lw : (x : C.Spec A) -> TM.At[TM.charge (TG.At[G x].banded)].Weight (\ c -> TM.UG.power c (suc n0)) (Lam x))
  (bl : (x : C.Spec A) (g : (G x).carrier) -> Tr.Trunc[LF.Basis[Lam x g,suc zero]].carrier) {
  module PA = TP.At[A,fp,G] ;
  X : U l = C.Spec A ;
  -- (zariski)
  agerbe (x : X) (inh : Tr.Trunc[(G x).carrier].carrier) : TM.GB.AGerbe =
   ((G x).carrier,(G x).gpd,inh,TG.At[G x].connected,(G x).band) ;
  Local (Z : U l) (b : Z -> X) : U l+ = (r0 : Nat) * (W : (z : Z) -> PA.T (b z))
   * ((z : Z) -> PA.Twisted (b z) (W z)) * ((z : Z) -> PA.Bases r0 (b z) (W z)) ;
  Claim (Z : U l) : U l+ = (b : Z -> X) (inh : (z : Z) -> Tr.Trunc[(G (b z)).carrier].carrier) -> Tr1.Trunc[Local Z b].carrier ;
  module Spec (D : C.Algebra) (fpD : P.FP D) (b : C.Spec D -> X) (inh : (z : C.Spec D) -> Tr.Trunc[(G (b z)).carrier].carrier) {
   module Z = ZM.At[D,fpD,\ z -> agerbe (b z) (inh z),n0,(\ z -> Lam (b z),\ z -> lw (b z)),\ z -> bl (b z)] ;
   local (q : Z.TA.Result) : Local (C.Spec D) b = (q.1,q.2.1.1,q.2.1.2,q.2.2) ;
   theorem : Tr1.Trunc[Local (C.Spec D) b].carrier = TC1.map Z.TA.Result (Local (C.Spec D) b) local Z.theorem ;
  } ;
  spec (D : C.Algebra) (fpD : P.FP D) : Claim (C.Spec D) = \ b inh -> Spec[D,fpD,b,inh].theorem ;
  along (Z : U l) (w : FA.AffineWitness Z) : Claim Z =
   Hi.subst (U l) Claim (C.Spec w.1) Z
    (Hi.sym (U l) Z (C.Spec w.1) (Axioms[l].UnivalenceLemmas[univ @l].ua Z (C.Spec w.1) w.2.2)) (spec w.1 w.2.1) ;
  affine (Z : U l) (aff : FA.Affine Z) : Claim Z = \ b inh ->
   Tr1.Trunc[FA.AffineWitness Z].induction @(l+) (\ t -> Tr1.Trunc[Local Z b].carrier)
    (\ t -> Tr1.Trunc[Local Z b].proposition) (\ w -> along Z w b inh) aff ;
  -- (push)
  Result : U l+ = (V : (x : X) -> PA.T x) * ((x : X) -> PA.Twisted x (V x))
   * ((x : X) -> (k : Nat) * PA.Bases k x (V x)) ;
  module Push (wt : TW.Witness X (\ x -> (G x).carrier)) (L : Local (TW.Points wt.1 X wt.2.1) (TW.base wt.1 X wt.2.1)) {
   module PT = PA.Tower[wt.1,wt.2.1,L.1,L.2.1,L.2.2.1,L.2.2.2] ;
   result : Result = (PT.V,PT.weight,\ x -> (PT.rank x,PT.bases x)) ;
  } ;
  from-witness (wt : TW.Witness X (\ x -> (G x).carrier)) : Tr1.Trunc[Result].carrier =
   TC1.map (Local (TW.Points wt.1 X wt.2.1) (TW.base wt.1 X wt.2.1)) Result (\ L -> Push[wt,L].result)
    (affine (TW.Points wt.1 X wt.2.1) (TowerAffine[l].Over[R,setR,axioms].over-spec A fp wt.1 wt.2.1)
     (TW.base wt.1 X wt.2.1) wt.2.2) ;
  -- (flatten)
  theorem : Tr1.Trunc[Result].carrier =
   Tr.Trunc[TW.Witness X (\ x -> (G x).carrier)].induction @(l+) (\ c -> Tr1.Trunc[Result].carrier)
    (\ c -> Tr1.Trunc[Result].proposition) from-witness
    (Flattening[l].Over[R,setR,axioms,sh].theorem A fp (\ x -> (G x).carrier) (\ x -> (G x).inh)) ;
 } ;
} ;
