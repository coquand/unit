-- Propositions `cheap` and `correct` composed (gabber-recollement, the step
-- of Theorem main).  Situation of CHEAPGLUE: A f.p., gerbes G x on Spec A,
-- a, b merely comaximal, Lambda of weight n = n0 + 1 whose fibres merely have
-- bases of rank 1.  Let V on D(a), W on D(b) be twisted, with fibres merely
-- having bases of ranks r = r0 + 1, s = s0 + 1, good of ranks r^n, s^n on
-- Spec L_a, Spec L_b.  Then merely there is a good module on Spec A
-- (GOODMODULES.GoodModule).
--  (normalise)  V1 = V^s and W1 = W^r have fibre bases of the one rank
--     r1 + 1 = copies r0 s0 + 1 = copies s0 r0 + 1 = r s (POWERBASES,
--     RANKARITHMETIC.copies-comm).  They are good (CHEAPGLUE.Side.Powers) of
--     the ranks given there, which are [r1 + 1]^n in K_0 (RANKARITHMETIC.Ranks
--     .powered), so good of rank N1 with (r1 + 1)^n = N1 + 1
--     (GOODMODULES.regood).
--  (glue)  CHEAPGLUE.Same: merely m and V' on Spec A with restrictions
--     V1^(m+1), W1^(m+1), both good.
--  (bases)  On D(a) the fibres of V' are those of V1^(m+1), with bases of
--     rank r2 + 1 = copies r1 m + 1 (POWERBASES); likewise on D(b); D(a), D(b)
--     cover Spec A (TWISTEDGLUE.Opens.cover).
--  (correct)  The goodness of the restrictions is moved to the rank
--     N2 + 1 = (r2 + 1)^n as in (normalise), and TWISTEDCORRECT.Correct gives
--     merely S with V' (x) S good; its fibres have bases of rank
--     (R0 + 1)(r2 + 1) (TWISTEDTENSOR.Tensor.bases).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ; module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module RK = RankArithmetic[l] ;
 module RA = RK.Over[R,setR] ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TM.GB.AGerbe) (a b : A.ring.R)
  (cm : Tr.Trunc[Comaximal[l].Over[A.ring].Comaximal a b].carrier)
  (la : AI.LocalizationWitness A a) (lb : AI.LocalizationWitness A b) (lab : AI.LocalizationWitness A (A.ring.mul a b))
  (n0 : Nat) (Lambda : TM.Family[C.Spec A,G].Weighted (\ c -> TM.UG.power c (suc n0)))
  (bl : (x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier) {
  module CG = CheapGlue[l].Over[R,setR,axioms,loc].At[A,fp,G,a,b,cm,la,lb,lab,n0,Lambda,bl] ;
  module TW = TwistedCorrect[l].Over[R,setR,axioms,loc].At[A,fp,G,a,b,cm,la,lb,lab,n0,Lambda,bl] ;
  module GM = GoodModules[l].Over[R,setR,axioms].At[A,fp,G,n0,Lambda] ;
  module GA = GoodModules[l].Over[R,setR,axioms].At[la.1,la.2.1,CG.SA.Gf,n0,CG.SA.lam-f] ;
  module GB = GoodModules[l].Over[R,setR,axioms].At[lb.1,lb.2.1,CG.SB.Gf,n0,CG.SB.lam-f] ;
  module KA = RA.Ranks[CG.SA.CF.K.K0,n0] ;
  module KB = RA.Ranks[CG.SB.CF.K.K0,n0] ;
  module PA = PowerBases[l].Over[R,setR,axioms].At[CG.GD.Sa,\ z -> (G z.1).1] ;
  module PB = PowerBases[l].Over[R,setR,axioms].At[CG.GD.Sb,\ z -> (G z.1).1] ;
  module Step (V : CG.GD.FA.Twisted) (W : CG.GD.FB.Twisted) (r0 s0 : Nat)
   (bv : (z : CG.GD.Sa) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[V.1 z g,suc r0]].carrier)
   (bw : (z : CG.GD.Sb) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[W.1 z g,suc s0]].carrier)
   (NV0 NW0 : Nat) (hV : Id Nat (ML.rank (suc r0) (suc zero) (suc n0)) (suc NV0))
   (hW : Id Nat (ML.rank (suc s0) (suc zero) (suc n0)) (suc NW0))
   (gV : CG.SA.CF.Good (CG.SA.on-lf V) NV0) (gW : CG.SB.CF.Good (CG.SB.on-lf W) NW0) {
   -- (normalise)
   r1 : Nat = RK.copies r0 s0 ;
   V1 : CG.GD.FA.Twisted = CG.SA.PF.power V s0 ;
   W1 : CG.GD.FB.Twisted = CG.SB.PF.power W r0 ;
   bv1 (z : CG.GD.Sa) (g : (G z.1).1) : Tr.Trunc[LF.Basis[V1.1 z g,suc r1]].carrier = PA.bases V.1 r0 bv s0 z g ;
   bw1 (z : CG.GD.Sb) (g : (G z.1).1) : Tr.Trunc[LF.Basis[W1.1 z g,suc r1]].carrier =
    subst (\ k -> Tr.Trunc[LF.Basis[W1.1 z g,suc k]].carrier) (RK.copies-comm s0 r0) (PB.bases W.1 s0 bw r0 z g) ;
   rp1 : (c : Nat) * Id Nat (ML.rank (suc r1) (suc zero) (suc n0)) (suc c) = TW.rank-positive r1 (suc n0) ;
   NV1 : Nat = rp1.1 ;
   ea : Id CG.SA.CF.K.K0.R (CG.SA.CF.IK.nat (suc (CG.SA.rank NV0 s0))) (CG.SA.CF.IK.nat (suc NV1)) =
    trans (KA.powered r0 s0 NV0 hV) (sym (KA.at-rank r1 NV1 rp1.2)) ;
   eb : Id CG.SB.CF.K.K0.R (CG.SB.CF.IK.nat (suc (CG.SB.rank NW0 r0))) (CG.SB.CF.IK.nat (suc NV1)) =
    trans (KB.powered s0 r0 NW0 hW)
     (trans (ap (\ k -> KB.N.PT.power (KB.N.IT.nat (suc k)) (suc n0)) (RK.copies-comm s0 r0)) (sym (KB.at-rank r1 NV1 rp1.2))) ;
   gv1 : Tr.Trunc[CG.SA.CF.Good (CG.SA.on-lf V1) NV1].carrier =
    TC.map (CG.SA.CF.Good (CG.SA.on-lf V1) (CG.SA.rank NV0 s0)) (CG.SA.CF.Good (CG.SA.on-lf V1) NV1)
     (GA.regood (CG.SA.on-lf V1) (CG.SA.rank NV0 s0) NV1 ea) CG.SA.Powers[V,r0,NV0,bv,gV,s0].theorem ;
   gw1 : Tr.Trunc[CG.SB.CF.Good (CG.SB.on-lf W1) NV1].carrier =
    TC.map (CG.SB.CF.Good (CG.SB.on-lf W1) (CG.SB.rank NW0 r0)) (CG.SB.CF.Good (CG.SB.on-lf W1) NV1)
     (GB.regood (CG.SB.on-lf W1) (CG.SB.rank NW0 r0) NV1 eb) CG.SB.Powers[W,s0,NW0,bw,gW,r0].theorem ;
   -- (glue)
   module Glue (ga1 : CG.SA.CF.Good (CG.SA.on-lf V1) NV1) (gb1 : CG.SB.CF.Good (CG.SB.on-lf W1) NV1) {
    module SM = CG.Same[V1,W1,r1,bv1,bw1,NV1,rp1.2,ga1,gb1] ;
    module From (t : SM.Result) {
     m : Nat = t.1 ;
     V' : CG.GD.FX.Twisted = t.2.1 ;
     -- (bases)
     r2 : Nat = RK.copies r1 m ;
     base-a (x : C.Spec A) (u : CG.GL.Da x) (g : (G x).1) : Tr.Trunc[LF.Basis[V'.1 x g,suc r2]].carrier =
      idJ CG.GD.FA.Twisted (CG.SA.PF.power V1 m) (\ T q -> Tr.Trunc[LF.Basis[T.1 (x,u) g,suc r2]].carrier)
       (PA.bases V1.1 r1 bv1 m (x,u) g) (CG.restrict-a V') (Pr1.sym CG.GD.FA.Twisted (CG.restrict-a V') (CG.SA.PF.power V1 m) t.2.2.1) ;
     base-b (x : C.Spec A) (v : CG.GL.Db x) (g : (G x).1) : Tr.Trunc[LF.Basis[V'.1 x g,suc r2]].carrier =
      idJ CG.GD.FB.Twisted (CG.SB.PF.power W1 m) (\ T q -> Tr.Trunc[LF.Basis[T.1 (x,v) g,suc r2]].carrier)
       (PB.bases W1.1 r1 bw1 m (x,v) g) (CG.restrict-b V') (Pr1.sym CG.GD.FB.Twisted (CG.restrict-b V') (CG.SB.PF.power W1 m) t.2.2.2.1) ;
     side (x : C.Spec A) (g : (G x).1) : Plus (CG.GL.Da x) (CG.GL.Db x) -> Tr.Trunc[LF.Basis[V'.1 x g,suc r2]].carrier = split {
      inl u -> base-a x u g ;
      inr v -> base-b x v g } ;
     bv' (x : C.Spec A) (g : (G x).1) : Tr.Trunc[LF.Basis[V'.1 x g,suc r2]].carrier =
      TC.bind (Plus (CG.GL.Da x) (CG.GL.Db x)) (LF.Basis[V'.1 x g,suc r2]) (side x g) (CG.GL.cover x) ;
     -- (correct)
     rp2 : (c : Nat) * Id Nat (ML.rank (suc r2) (suc zero) (suc n0)) (suc c) = TW.rank-positive r2 (suc n0) ;
     ga : CG.SA.CF.Good (CG.SA.on-lf (CG.restrict-a V')) rp2.1 =
      GA.regood (CG.SA.on-lf (CG.restrict-a V')) (CG.SA.rank NV1 m) rp2.1
       (trans (KA.powered r1 m NV1 rp1.2) (sym (KA.at-rank r2 rp2.1 rp2.2)))
       (idJ CG.GD.FA.Twisted (CG.SA.PF.power V1 m) (\ T q -> CG.SA.CF.Good (CG.SA.on-lf T) (CG.SA.rank NV1 m))
        t.2.2.2.2.1 (CG.restrict-a V') (Pr1.sym CG.GD.FA.Twisted (CG.restrict-a V') (CG.SA.PF.power V1 m) t.2.2.1)) ;
     gb : CG.SB.CF.Good (CG.SB.on-lf (CG.restrict-b V')) rp2.1 =
      GB.regood (CG.SB.on-lf (CG.restrict-b V')) (CG.SB.rank NV1 m) rp2.1
       (trans (KB.powered r1 m NV1 rp1.2) (sym (KB.at-rank r2 rp2.1 rp2.2)))
       (idJ CG.GD.FB.Twisted (CG.SB.PF.power W1 m) (\ T q -> CG.SB.CF.Good (CG.SB.on-lf T) (CG.SB.rank NV1 m))
        t.2.2.2.2.2 (CG.restrict-b V') (Pr1.sym CG.GD.FB.Twisted (CG.restrict-b V') (CG.SB.PF.power W1 m) t.2.2.2.1)) ;
     module CR = TW.Correct[V',r2,rp2.1,bv',rp2.2,ga,gb] ;
     module Of (c : TW.Corrected[V',r2]) {
      tc : (k : Nat) * Id Nat (Pairing[l].times (suc c.rank0) (suc r2)) (suc k) = Rational[l].times-suc c.rank0 r2 ;
      module TV = TW.TT.Tensor[V',c.corrector] ;
      bases (x : C.Spec A) (g : (G x).1) : Tr.Trunc[LF.Basis[TV.twisted.1 x g,suc tc.1]].carrier =
       subst (\ k -> Tr.Trunc[LF.Basis[TV.twisted.1 x g,k]].carrier) tc.2 (TV.bases (suc c.rank0) (suc r2) c.corrector-bases bv' x g) ;
      power-eq : Id Nat (ML.rank (suc tc.1) (suc zero) (suc n0)) (suc c.power0) =
       trans (ap (\ k -> ML.rank k (suc zero) (suc n0)) (sym tc.2)) c.power-eq ;
      result : GM.GoodModule = new GM.GoodModule[TV.twisted,tc.1,bases,c.power0,power-eq,c.corrected-good] ;
     } ;
     result : Tr1.Trunc[GM.GoodModule].carrier =
      TC.rec TW.Corrected[V',r2] @(l+) Tr1.Trunc[GM.GoodModule].carrier Tr1.Trunc[GM.GoodModule].proposition
       (\ c -> Tr1.Trunc[GM.GoodModule].inc Of[c].result) CR.theorem ;
    } ;
    result : Tr1.Trunc[GM.GoodModule].carrier = TC1.bind SM.Result GM.GoodModule (\ t -> From[t].result) SM.theorem ;
   } ;
   theorem : Tr1.Trunc[GM.GoodModule].carrier =
    TC.rec (CG.SA.CF.Good (CG.SA.on-lf V1) NV1) @(l+) Tr1.Trunc[GM.GoodModule].carrier Tr1.Trunc[GM.GoodModule].proposition
     (\ ga1 -> TC.rec (CG.SB.CF.Good (CG.SB.on-lf W1) NV1) @(l+) Tr1.Trunc[GM.GoodModule].carrier Tr1.Trunc[GM.GoodModule].proposition
      (\ gb1 -> Glue[ga1,gb1].result) gw1) gv1 ;
  } ;
 } ;
} ;
