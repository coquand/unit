-- The comparison C2 of CHEAP-DESIGN.md: "W (x) Hom(A,B) = Hom(Hom(W,A), B)".
-- Let F = Hom(A, B) have a frame t_j, d_j (j < K; FRAMES) and let W be a
-- module.  The map
--     Phi : Hom(F*, W) -> Hom(Hom(W, A), B),
--     Phi(alpha)(phi) = sum_j t_j(phi(alpha(d_j)))
-- is linear (in phi and in alpha, termwise).  If W has a frame f_b, delta_b
-- (b < r), it has the inverse
--     Psi(beta)(lam) = sum_b lam(eps_b) f_b,
--     eps_b(a) = beta(rank_b a),   rank_b a = (u |-> delta_b(u) a) in Hom(W, A).
--  (Phi Psi)  Phi(Psi beta)(phi) = sum_j t_j(phi(sum_b d_j(eps_b) f_b))
--     = sum_j sum_b d_j(eps_b) t_j(phi f_b) = sum_b sum_j d_j(eps_b) t_j(phi f_b)
--     = sum_b eps_b(phi f_b)                       (frame law of F at eps_b)
--     = beta(sum_b rank_b (phi f_b)) = beta(phi)   (frame law of W).
--  (Psi Phi)  For beta = Phi(alpha), eps_b = sum_j delta_b(alpha d_j) t_j, so
--     Psi(beta)(lam) = sum_b sum_j delta_b(alpha d_j) lam(t_j) f_b
--     = sum_j lam(t_j) sum_b delta_b(alpha d_j) f_b = sum_j lam(t_j) alpha(d_j)
--     = alpha(sum_j lam(t_j) d_j) = alpha(lam)      (frame laws of W, of F*).
-- Without a frame of W: Phi is injective (a proposition, so a mere frame of
-- W gives it by Psi Phi = id), hence its fibres are propositions; each is
-- merely inhabited (by Psi beta), so inhabited.  This gives the inverse,
-- and Hom(F*, W) = Hom(Hom(W, A), B) when W merely has a frame.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module A7 = Alg73[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module HM = HomModule[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 -- a linear map commutes with linear combinations
 combination (P Q : MD.Module) (g : HM.At[P,Q].S.E) (n : Nat) (c : Fin n -> R.R) (v : Fin n -> P.M) :
  Id Q.M (g.1 (ModuleFiniteSums[l].Over[R,setR,P].sum n (\ i -> P.sm (c i) (v i))))
   (ModuleFiniteSums[l].Over[R,setR,Q].sum n (\ i -> Q.sm (c i) (g.1 (v i)))) =
  ModuleSumLaws[l].Over[R,setR,P].Map[Q,g.1,SM.Lin[P,Q,g].map-z,g.2.1].combination g.2.2 n c v ;
 -- a sum of linear maps, applied
 apply-sum (P Q : MD.Module) (x : P.M) (n : Nat) (h : Fin n -> HM.At[P,Q].S.E) :
  Id Q.M ((ModuleFiniteSums[l].Over[R,setR,HM.At[P,Q].carrier].sum n h).1 x)
   (ModuleFiniteSums[l].Over[R,setR,Q].sum n (\ i -> (h i).1 x)) =
  ModuleSumLaws[l].Over[R,setR,HM.At[P,Q].carrier].Map[Q,\ g -> g.1 x,refl Q.mz,\ u v -> refl (Q.madd (u.1 x) (v.1 x))].sum n h ;
 module At (W A B : MD.Module) (K : Nat) (fr : FR.Frame[HM.At[A,B].carrier,K]) {
  module HF = HM.At[A,B] ;
  module HW = HM.At[W,A] ;
  module HD = HM.At[FR.dual HF.carrier,W] ;
  module HZ = HM.At[HW.carrier,B] ;
  module SB = ModuleFiniteSums[l].Over[R,setR,B] ;
  module LB = ModuleSumLaws[l].Over[R,setR,B] ;
  t (j : Fin K) : HF.S.E = fr.vector j ;
  d (j : Fin K) : HM.At[HF.carrier,MD.regular].S.E = fr.form j ;
  -- Phi
  term (a : HD.S.E) (phi : HW.S.E) (j : Fin K) : B.M = (t j).1 (phi.1 (a.1 (d j))) ;
  value (a : HD.S.E) (phi : HW.S.E) : B.M = SB.sum K (term a phi) ;
  value-add (a : HD.S.E) (phi psi : HW.S.E) :
   Id B.M (value a (HW.carrier.madd phi psi)) (B.madd (value a phi) (value a psi)) =
   trans (SB.congruent K (term a (HW.carrier.madd phi psi)) (\ j -> B.madd (term a phi j) (term a psi j))
     (\ j -> (t j).2.1 (phi.1 (a.1 (d j))) (psi.1 (a.1 (d j)))))
    (LB.sum-add K (term a phi) (term a psi)) ;
  value-scale (a : HD.S.E) (c : R.R) (phi : HW.S.E) :
   Id B.M (value a (HW.carrier.sm c phi)) (B.sm c (value a phi)) =
   trans (SB.congruent K (term a (HW.carrier.sm c phi)) (\ j -> B.sm c (term a phi j)) (\ j -> (t j).2.2 c (phi.1 (a.1 (d j)))))
    (sym (LB.scale-sum c K (term a phi))) ;
  map (a : HD.S.E) : HZ.S.E = (value a,value-add a,value-scale a) ;
  map-add (a b : HD.S.E) : Id HZ.S.E (map (HD.carrier.madd a b)) (HZ.carrier.madd (map a) (map b)) =
   HZ.ext _ _ (\ phi -> trans (SB.congruent K (term (HD.carrier.madd a b) phi) (\ j -> B.madd (term a phi j) (term b phi j))
     (\ j -> trans (ap (t j).1 (phi.2.1 (a.1 (d j)) (b.1 (d j)))) ((t j).2.1 (phi.1 (a.1 (d j))) (phi.1 (b.1 (d j))))))
    (LB.sum-add K (term a phi) (term b phi))) ;
  map-scale (c : R.R) (a : HD.S.E) : Id HZ.S.E (map (HD.carrier.sm c a)) (HZ.carrier.sm c (map a)) =
   HZ.ext _ _ (\ phi -> trans (SB.congruent K (term (HD.carrier.sm c a) phi) (\ j -> B.sm c (term a phi j))
     (\ j -> trans (ap (t j).1 (phi.2.2 c (a.1 (d j)))) ((t j).2.2 c (phi.1 (a.1 (d j))))))
    (sym (LB.scale-sum c K (term a phi)))) ;
  -- Psi, from a frame of W
  module Inverse (r : Nat) (fw : FR.Frame[W,r]) {
   module SW = ModuleFiniteSums[l].Over[R,setR,W] ;
   module LW = ModuleSumLaws[l].Over[R,setR,W] ;
   module SF = ModuleFiniteSums[l].Over[R,setR,HF.carrier] ;
   module SHW = ModuleFiniteSums[l].Over[R,setR,HW.carrier] ;
   f (b : Fin r) : W.M = fw.vector b ;
   delta (b : Fin r) : HM.At[W,MD.regular].S.E = fw.form b ;
   rank (b : Fin r) (x : A.M) : HW.S.E = (\ u -> A.sm ((delta b).1 u) x,
    \ u v -> trans (ap (\ c -> A.sm c x) ((delta b).2.1 u v)) (A.smE ((delta b).1 u) ((delta b).1 v) x),
    \ c u -> trans (ap (\ e -> A.sm e x) ((delta b).2.2 c u)) (sym (A.smA c ((delta b).1 u) x))) ;
   rank-add (b : Fin r) (x y : A.M) : Id HW.S.E (rank b (A.madd x y)) (HW.carrier.madd (rank b x) (rank b y)) =
    HW.ext _ _ (\ u -> A.smD ((delta b).1 u) x y) ;
   rank-scale (b : Fin r) (c : R.R) (x : A.M) : Id HW.S.E (rank b (A.sm c x)) (HW.carrier.sm c (rank b x)) =
    HW.ext _ _ (\ u -> trans (A.smA ((delta b).1 u) c x)
     (trans (ap (\ e -> A.sm e x) (R.mulC ((delta b).1 u) c)) (sym (A.smA c ((delta b).1 u) x)))) ;
   eps (beta : HZ.S.E) (b : Fin r) : HF.S.E = (\ x -> beta.1 (rank b x),
    \ x y -> trans (ap beta.1 (rank-add b x y)) (beta.2.1 (rank b x) (rank b y)),
    \ c x -> trans (ap beta.1 (rank-scale b c x)) (beta.2.2 c (rank b x))) ;
   coeff (beta : HZ.S.E) (lam : (FR.dual HF.carrier).M) (b : Fin r) : R.R = lam.1 (eps beta b) ;
   back-value (beta : HZ.S.E) (lam : (FR.dual HF.carrier).M) : W.M = SW.sum r (\ b -> W.sm (coeff beta lam b) (f b)) ;
   back (beta : HZ.S.E) : HD.S.E = (back-value beta,
    \ lam mu -> trans (SW.congruent r (\ b -> W.sm (coeff beta ((FR.dual HF.carrier).madd lam mu) b) (f b)) (\ b -> W.madd (W.sm (coeff beta lam b) (f b)) (W.sm (coeff beta mu b) (f b)))
      (\ b -> W.smE (coeff beta lam b) (coeff beta mu b) (f b)))
     (LW.sum-add r (\ b -> W.sm (coeff beta lam b) (f b)) (\ b -> W.sm (coeff beta mu b) (f b))),
    \ c lam -> trans (SW.congruent r (\ b -> W.sm (coeff beta ((FR.dual HF.carrier).sm c lam) b) (f b)) (\ b -> W.sm c (W.sm (coeff beta lam b) (f b)))
      (\ b -> sym (W.smA c (coeff beta lam b) (f b))))
     (sym (LW.scale-sum c r (\ b -> W.sm (coeff beta lam b) (f b))))) ;
   -- (Phi Psi): sum_b rank_b (phi f_b) = phi
   ranks (phi : HW.S.E) : Id HW.S.E (SHW.sum r (\ b -> rank b (phi.1 (f b)))) phi =
    HW.ext _ phi (\ u -> trans (apply-sum W A u r (\ b -> rank b (phi.1 (f b))))
     (trans (sym (combination W A phi r (\ b -> (delta b).1 u) f)) (ap phi.1 (fw.law u)))) ;
   -- sum_j d_j(eps) t_j(x) = eps(x)
   law-at (e : HF.S.E) (x : A.M) : Id B.M (SB.sum K (\ j -> B.sm ((d j).1 e) ((t j).1 x))) (e.1 x) =
    trans (sym (apply-sum A B x K (\ j -> HF.carrier.sm ((d j).1 e) (t j)))) (ap (\ h -> h.1 x) (fr.law e)) ;
   phi-psi (beta : HZ.S.E) (phi : HW.S.E) : Id B.M (value (back beta) phi) (beta.1 phi) =
    calc B.M {
     SB.sum K (term (back beta) phi)
      =< SB.congruent K (term (back beta) phi) (\ j -> SB.sum r (\ b -> B.sm ((d j).1 (eps beta b)) ((t j).1 (phi.1 (f b)))))
          (\ j -> combination W B (HomSums[l].Over[R,setR].compose W A B phi (t j)) r (\ b -> (d j).1 (eps beta b)) f) >
     SB.sum K (\ j -> SB.sum r (\ b -> B.sm ((d j).1 (eps beta b)) ((t j).1 (phi.1 (f b)))))
      =< LB.exchange r K (\ j b -> B.sm ((d j).1 (eps beta b)) ((t j).1 (phi.1 (f b)))) >
     SB.sum r (\ b -> SB.sum K (\ j -> B.sm ((d j).1 (eps beta b)) ((t j).1 (phi.1 (f b)))))
      =< SB.congruent r (\ b -> SB.sum K (\ j -> B.sm ((d j).1 (eps beta b)) ((t j).1 (phi.1 (f b))))) (\ b -> beta.1 (rank b (phi.1 (f b)))) (\ b -> law-at (eps beta b) (phi.1 (f b))) >
     SB.sum r (\ b -> beta.1 (rank b (phi.1 (f b))))
      =< sym (ModuleSumLaws[l].Over[R,setR,HW.carrier].Map[B,beta.1,SM.Lin[HW.carrier,B,beta].map-z,beta.2.1].sum r
          (\ b -> rank b (phi.1 (f b)))) >
     beta.1 (SHW.sum r (\ b -> rank b (phi.1 (f b))))
      =< ap beta.1 (ranks phi) >
     beta.1 phi } ;
   -- (Psi Phi): eps_b of Phi(alpha) is sum_j delta_b(alpha d_j) t_j
   module Back (a : HD.S.E) {
    c (b : Fin r) (j : Fin K) : R.R = (delta b).1 (a.1 (d j)) ;
    eps-map (b : Fin r) : Id HF.S.E (eps (map a) b) (SF.sum K (\ j -> HF.carrier.sm (c b j) (t j))) =
     HF.ext _ _ (\ x -> trans (SB.congruent K (term a (rank b x)) (\ j -> B.sm (c b j) ((t j).1 x)) (\ j -> (t j).2.2 (c b j) x))
      (sym (apply-sum A B x K (\ j -> HF.carrier.sm (c b j) (t j))))) ;
    coeff-map (lam : (FR.dual HF.carrier).M) (b : Fin r) :
     Id R.R (coeff (map a) lam b) (RS.sum K (\ j -> R.mul (c b j) (lam.1 (t j)))) =
     trans (ap lam.1 (eps-map b))
      (trans (FR.Form[HF.carrier,lam].sum K (\ j -> HF.carrier.sm (c b j) (t j)))
       (RS.sum-cong K (\ j -> lam.1 (HF.carrier.sm (c b j) (t j))) (\ j -> R.mul (c b j) (lam.1 (t j))) (\ j -> lam.2.2 (c b j) (t j)))) ;
    -- one j: sum_b (delta_b(alpha d_j) lam(t_j)) f_b = lam(t_j) alpha(d_j)
    column (lam : (FR.dual HF.carrier).M) (j : Fin K) :
     Id W.M (SW.sum r (\ b -> W.sm (R.mul (c b j) (lam.1 (t j))) (f b))) (W.sm (lam.1 (t j)) (a.1 (d j))) =
     trans (SW.congruent r (\ b -> W.sm (R.mul (c b j) (lam.1 (t j))) (f b)) (\ b -> W.sm (lam.1 (t j)) (W.sm (c b j) (f b)))
       (\ b -> trans (ap (\ e -> W.sm e (f b)) (R.mulC (c b j) (lam.1 (t j)))) (sym (W.smA (lam.1 (t j)) (c b j) (f b)))))
      (trans (sym (LW.scale-sum (lam.1 (t j)) r (\ b -> W.sm (c b j) (f b))))
       (ap (W.sm (lam.1 (t j))) (fw.law (a.1 (d j))))) ;
    psi-phi (lam : (FR.dual HF.carrier).M) : Id W.M (back-value (map a) lam) (a.1 lam) =
     calc W.M {
      SW.sum r (\ b -> W.sm (coeff (map a) lam b) (f b))
       =< SW.congruent r (\ b -> W.sm (coeff (map a) lam b) (f b)) (\ b -> SW.sum K (\ j -> W.sm (R.mul (c b j) (lam.1 (t j))) (f b)))
           (\ b -> trans (ap (\ e -> W.sm e (f b)) (coeff-map lam b))
            (sym (SW.sum-scale (f b) K (\ j -> R.mul (c b j) (lam.1 (t j)))))) >
      SW.sum r (\ b -> SW.sum K (\ j -> W.sm (R.mul (c b j) (lam.1 (t j))) (f b)))
       =< LW.exchange K r (\ b j -> W.sm (R.mul (c b j) (lam.1 (t j))) (f b)) >
      SW.sum K (\ j -> SW.sum r (\ b -> W.sm (R.mul (c b j) (lam.1 (t j))) (f b)))
       =< SW.congruent K (\ j -> SW.sum r (\ b -> W.sm (R.mul (c b j) (lam.1 (t j))) (f b))) (\ j -> W.sm (lam.1 (t j)) (a.1 (d j))) (column lam) >
      SW.sum K (\ j -> W.sm (lam.1 (t j)) (a.1 (d j)))
       =< sym (combination (FR.dual HF.carrier) W a K (\ j -> lam.1 (t j)) d) >
      a.1 (ModuleFiniteSums[l].Over[R,setR,FR.dual HF.carrier].sum K (\ j -> (FR.dual HF.carrier).sm (lam.1 (t j)) (d j)))
       =< ap a.1 (FR.Of[HF.carrier,K,fr].dual-law lam) >
      a.1 lam } ;
    theorem : Id HD.S.E (back (map a)) a = HD.ext _ a psi-phi ;
   } ;
  } ;
  -- without a frame of W
  module Merely (r : Nat) (fw : Tr.Trunc[FR.Frame[W,r]].carrier) {
   injective (a a' : HD.S.E) (h : Id HZ.S.E (map a) (map a')) : Id HD.S.E a a' =
    Tr.Trunc[FR.Frame[W,r]].induction @l (\ z -> Id HD.S.E a a') (\ z -> HD.carrier.setM a a')
     (\ w -> trans (sym (Inverse[r,w].Back[a].theorem))
      (trans (ap (Inverse[r,w].back) h) (Inverse[r,w].Back[a'].theorem))) fw ;
   Fib (beta : HZ.S.E) : U l = (a : HD.S.E) * Id HZ.S.E (map a) beta ;
   fib-prop (beta : HZ.S.E) : Pr.isProp (Fib beta) = \ u v ->
    Pr.Sigma-eq HD.S.E (\ a -> Id HZ.S.E (map a) beta) u.1 v.1 u.2 v.2
     (injective u.1 v.1 (trans u.2 (sym v.2))) (HZ.carrier.setM (map v.1) beta) ;
   fib (beta : HZ.S.E) : Fib beta =
    Tr.Trunc[FR.Frame[W,r]].induction @l (\ z -> Fib beta) (\ z -> fib-prop beta)
     (\ w -> (Inverse[r,w].back beta,HZ.ext _ beta (Inverse[r,w].phi-psi beta))) fw ;
   inverse (beta : HZ.S.E) : HD.S.E = (fib beta).1 ;
   theorem : Id MD.Module HD.carrier HZ.carrier =
    SIP.sip HD.carrier HZ.carrier ((map,Pr.qinv HD.S.E HZ.S.E map inverse (\ beta -> (fib beta).2)
      (\ a -> injective (inverse (map a)) a (fib (map a)).2)),
     map-add,\ c a -> map-scale c a) ;
  } ;
 } ;
} ;
