-- The topology T of sevb.pdf, Section 2, as data: it is generated by
-- propositions G i (i : I).  X is a sheaf (T-modal) when every map G i -> X
-- is constant: x |-> (\ _ -> x) : X -> (G i -> X) is an equivalence.  The
-- definition is the same expression at every level.
level l ;
module Over (I : U l) (G : I -> U l) {
 isModal : [j] (X : U j) -> U (l \/ j) = <j> \ X ->
  (i : I) -> Prelude[l \/ j].isEquiv X (G i -> X) (\ x g -> x) ;
} ;
