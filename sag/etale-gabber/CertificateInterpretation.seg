-- Interpret a presentation derivation as a principal-ideal certificate.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (pres : Presentations[l].Over[R,setR].Presentation) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module D = ExpressionCongruence[l].Over[R,setR,pres] ; open D ;
 module In (B : C.Algebra) (values : V -> B.ring.R) (f : B.ring.R) {
  module Ideal = PrincipalCertificates[l].Over[B.ring,f] ;
  ev : Term -> B.ring.R = P.eval V B values ;
  zero-value : Id B.ring.R (ev zeroE) B.ring.z = RingHom[l].zero R B.ring B.iota ;
  neg-value (p : Term) : Id B.ring.R (ev (negative p)) (B.ring.neg (ev p)) = calc B.ring.R {
   B.ring.mul (B.iota.1 (R.neg R.o)) (ev p)
    =< ap (\ b -> B.ring.mul b (ev p)) (RingHom[l].negation R B.ring B.iota R.o)
     > B.ring.mul (B.ring.neg (B.iota.1 R.o)) (ev p)
    =< ap (\ b -> B.ring.mul (B.ring.neg b) (ev p)) B.iota.2.1 > B.ring.mul (B.ring.neg B.ring.o) (ev p)
    =< B.ring.mulC (B.ring.neg B.ring.o) (ev p) > B.ring.mul (ev p) (B.ring.neg B.ring.o)
    =< RL[B.ring].mul-neg (ev p) B.ring.o > B.ring.neg (B.ring.mul (ev p) B.ring.o)
    =< ap B.ring.neg (B.ring.mulO (ev p)) > B.ring.neg (ev p) } ;
  module Equations (eqcert : (p : Term) -> Member p pres.2 -> Ideal.Certificate (ev p) (ev zeroE)) {
   sound : (d : Tree) -> Valid d -> Ideal.Certificate (ev (ends d).1) (ev (ends d).2) = split {
    reflD p -> \ v -> Ideal.reflexive (ev p) ;
    symD d | ih -> \ v -> Ideal.symmetric _ _ (ih v) ;
    transD d e | rd re -> \ v -> Ideal.transitive _ _ _ (rd v.1)
     (Ideal.transitive _ _ _ (Ideal.equal _ _ (ap ev v.2.2)) (re v.2.1)) ;
    sumD d e | rd re -> \ v -> Ideal.addition _ _ _ _ (rd v.1) (re v.2) ;
    mulD d e | rd re -> \ v -> Ideal.multiplication _ _ _ _ (rd v.1) (re v.2) ;
    addAssoc p q r -> \ v -> Ideal.equal _ _ (B.ring.addA (ev p) (ev q) (ev r)) ;
    addComm p q -> \ v -> Ideal.equal _ _ (B.ring.addC (ev p) (ev q)) ;
    addZero p -> \ v -> Ideal.equal _ _ (trans (ap (B.ring.add (ev p)) zero-value) (B.ring.addZ (ev p))) ;
    addNeg p -> \ v -> Ideal.equal _ _
     (trans (ap (B.ring.add (ev p)) (neg-value p)) (trans (B.ring.addN (ev p)) (sym zero-value))) ;
    mulAssoc p q r -> \ v -> Ideal.equal _ _ (B.ring.mulA (ev p) (ev q) (ev r)) ;
    mulComm p q -> \ v -> Ideal.equal _ _ (B.ring.mulC (ev p) (ev q)) ;
    mulOne p -> \ v -> Ideal.equal _ _ (trans (ap (B.ring.mul (ev p)) B.iota.2.1) (B.ring.mulO (ev p))) ;
    distrib p q r -> \ v -> Ideal.equal _ _ (B.ring.dist (ev p) (ev q) (ev r)) ;
    coeffAdd a b -> \ v -> Ideal.equal _ _ (sym (B.iota.2.2.1 a b)) ;
    coeffMul a b -> \ v -> Ideal.equal _ _ (sym (B.iota.2.2.2 a b)) ;
    equation p member -> \ v -> eqcert p member } ;
   proof-sound (p q : Term) (w : Proof p q) : Ideal.Certificate (ev p) (ev q) =
    Ideal.transitive _ _ _ (Ideal.equal _ _ (sym (ap ev w.2.2.1)))
     (Ideal.transitive _ _ _ (sound w.1 w.2.1) (Ideal.equal _ _ (ap ev w.2.2.2))) ;
   certificate (p q : Term) (h : Relation p q) : Truncation[l].Trunc[Ideal.Certificate (ev p) (ev q)].carrier =
    Truncation[l].Trunc[Proof p q].induction @l
     (\ t -> Truncation[l].Trunc[Ideal.Certificate (ev p) (ev q)].carrier)
     (\ t -> Truncation[l].Trunc[Ideal.Certificate (ev p) (ev q)].proposition)
     (\ w -> Truncation[l].Trunc[Ideal.Certificate (ev p) (ev q)].inc (proof-sound p q w)) h ;
  } ;
 } ;
} ;
