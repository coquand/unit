-- Unital associative R-algebras, not necessarily commutative, with a set
-- carrier (R commutative).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 record Algebra {
  A : U l ;
  set : Pr.isSet A ;
  zero : A ;
  add : A -> A -> A ;
  neg : A -> A ;
  scale : R.R -> A -> A ;
  one : A ;
  mul : A -> A -> A ;
  addA (x y w : A) : Id A (add x (add y w)) (add (add x y) w) ;
  addC (x y : A) : Id A (add x y) (add y x) ;
  addZ (x : A) : Id A (add x zero) x ;
  addN (x : A) : Id A (add x (neg x)) zero ;
  scale-one (x : A) : Id A (scale R.o x) x ;
  scale-scale (a b : R.R) (x : A) : Id A (scale a (scale b x)) (scale (R.mul a b) x) ;
  scale-add (a : R.R) (x y : A) : Id A (scale a (add x y)) (add (scale a x) (scale a y)) ;
  add-scale (a b : R.R) (x : A) : Id A (scale (R.add a b) x) (add (scale a x) (scale b x)) ;
  mulA (x y w : A) : Id A (mul x (mul y w)) (mul (mul x y) w) ;
  one-left (x : A) : Id A (mul one x) x ;
  one-right (x : A) : Id A (mul x one) x ;
  dist-left (x y w : A) : Id A (mul x (add y w)) (add (mul x y) (mul x w)) ;
  dist-right (x y w : A) : Id A (mul (add x y) w) (add (mul x w) (mul y w)) ;
  scale-mul-left (a : R.R) (x y : A) : Id A (mul (scale a x) y) (scale a (mul x y)) ;
  scale-mul-right (a : R.R) (x y : A) : Id A (mul x (scale a y)) (scale a (mul x y)) ;
 } ;
} ;
