-- SAG 4.2.1. Open propositions: merely, one of finitely many elements of
-- R is invertible.  The same shape as ClosedProp (worker A), with
-- Units in place of Zeros.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
Iff (P Q : U l) : U l = (P -> Q) * (Q -> P) ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 Units (n : Nat) (xs : Fin n -> R.R) : U l = Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].carrier ;
 units-prop (n : Nat) (xs : Fin n -> R.R) : Pr.isProp (Units n xs) =
  Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].proposition ;
 Witness (Q : U l) : U l = (n : Nat) * (xs : Fin n -> R.R) * Pr.Equiv Q (Units n xs) ;
 Open (Q : U l) : U l = Tr.Trunc[Witness Q].carrier ;
 open-prop (Q : U l) (o : Open Q) : Pr.isProp Q =
  Tr.Trunc[Witness Q].induction @l (\ t -> Pr.isProp Q) (\ t -> F.isProp-isProp Q)
   (\ w a b -> Equivalences[l].injective Q (Units w.1 w.2.1) w.2.2.1 w.2.2.2 a b
    (units-prop w.1 w.2.1 (w.2.2.1 a) (w.2.2.1 b))) o ;
 OpenSubtype (X : U l) (sub : X -> U l) : U l = (x : X) -> Open (sub x) ;
 units (n : Nat) (xs : Fin n -> R.R) : Open (Units n xs) =
  Tr.Trunc[Witness (Units n xs)].inc (n,xs,Pr.idEquiv (Units n xs)) ;
 from-iff (Q : U l) (propQ : Pr.isProp Q) (n : Nat) (xs : Fin n -> R.R)
  (to : Q -> Units n xs) (from : Units n xs -> Q) : Witness Q =
  (n,xs,to,Pr.qinv Q (Units n xs) to from
   (\ u -> units-prop n xs (to (from u)) u) (\ q -> propQ (from (to q)) q)) ;
 along (Q S : U l) (e : Pr.Equiv Q S) : Open S -> Open Q =
  Tr.Trunc[Witness S].induction @l (\ t -> Open Q) (\ t -> Tr.Trunc[Witness Q].proposition)
   (\ w -> Tr.Trunc[Witness Q].inc
    (w.1,w.2.1,Equivalences[l].compose Q S (Units w.1 w.2.1) e w.2.2)) ;
} ;
