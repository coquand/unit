level l ; open Ring[l] ;
module Pr = Prelude[l] ;
unit-map (A B : CRing) (h : RingHom[l].Hom A B) (a : A.R) (u : RL[A].unit a) : RL[B].unit (h.1 a) =
 (h.1 u.1,trans (sym (h.2.2.2 a u.1)) (trans (ap h.1 u.2) h.2.1)) ;
module Laws (A : CRing) (setA : Pr.isSet A.R) {
 open A ; open RL[A] ;
 difference-zero (x y : R) (h : Id R (add x (neg y)) z) : Id R x y = calc R {
  x =< sym (addZ x) > add x z
    =< ap (add x) (sym (trans (addC (neg y) y) (addN y))) > add x (add (neg y) y)
    =< addA x (neg y) y > add (add x (neg y)) y
    =< ap (\ t -> add t y) h > add z y
    =< zl y > y } ;
 inverse-unique (x y w : R) (h : Id R (mul x y) o) (k : Id R (mul x w) o) : Id R y w = calc R {
  y =< sym (mulO y) > mul y o
    =< ap (mul y) (sym k) > mul y (mul x w)
    =< mulA y x w > mul (mul y x) w
    =< ap (\ t -> mul t w) (mulC y x) > mul (mul x y) w
    =< ap (\ t -> mul t w) h > mul o w
    =< mulC o w > mul w o
    =< mulO w > w } ;
 unit-prop (x : R) : Pr.isProp (unit x) = \ h k ->
  Pr.Sigma-eq R (\ y -> Id R (mul x y) o) h.1 k.1 h.2 k.2
   (inverse-unique x h.1 k.1 h.2 k.2) (setA _ _) ;
 mul-four (a b c d : R) : Id R (mul (mul a b) (mul c d)) (mul (mul a c) (mul b d)) =
  RL[A].mul-four a b c d ;
 unit-product (a b : R) (u : unit a) (v : unit b) : unit (mul a b) =
  (mul u.1 v.1,trans (mul-four a b u.1 v.1)
   (trans (Presentations[l].cong2 R mul _ _ _ _ u.2 v.2) (mulO o))) ;
 unit-left (a b : R) (u : unit (mul a b)) : unit a =
  (mul b u.1,trans (mulA a b u.1) u.2) ;
 unit-right (a b : R) (u : unit (mul a b)) : unit b =
  unit-left b a (Pr.subst R unit _ _ (mulC a b) u) ;
}
;
