-- Etale R^x-gerbes (GABBER-PROPER-DESIGN.md, section 1).  A TGerbe is a
-- 1-type with a band at each object, inhabited and connected only locally
-- (close, for the root topology of ETALETOPOLOGY), whose paths are sheaves
-- (descent for morphisms; descent for objects is not assumed).
--  (paths)  The paths a = b form a pre-torsor under R^x (GERBE.Core: the action
--     a . h = beta_a^-1(a) h, free and transitive, uses only the band).
--  (H90)    That pre-torsor is a sheaf and close-inhabited, so it is merely
--     inhabited (HILBERT90): ||a = b||.
-- Hence a TGerbe is Banded (TWISTEDMODULES), and twisted modules, invariant
-- sections and descent apply to it unchanged.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module GB = TM.GB ;
 module LA = LineAssociated[l].Over[R,setR] ;
 record TGerbe {
  carrier : U l ;
  gpd : (a b : carrier) -> Pr.isSet (Id carrier a b) ;
  inh : sh.close carrier ;
  conn : (a b : carrier) -> sh.close (Id carrier a b) ;
  paths : (a b : carrier) -> ET.T.isModal @l (Id carrier a b) ;
  band : (x : carrier) -> GB.Band carrier x ;
 } ;
 -- (paths), for any banded 1-type (no closure involved)
 module PathTorsors (X : U l) (gpd : (a b : X) -> Pr.isSet (Id X a b)) (band : (x : X) -> GB.Band X x) {
  module C = GB.Core[X,gpd,band] ;
  pretorsor (a b : X) : LA.PreTor = (Id X a b,C.pact a b,gpd a b,C.pad a b,C.pze a b,C.pft a b) ;
 } ;
 module At (Gb : TGerbe) {
  X : U l = Gb.carrier ;
  module PT = PathTorsors[X,Gb.gpd,Gb.band] ;
  -- (H90)
  connected (a b : X) : Tr.Trunc[Id X a b].carrier =
   Hilbert90[l].Over[R,setR,axioms,sh].At[PT.pretorsor a b,Gb.paths a b,Gb.conn a b].theorem ;
  banded : TM.Banded = (X,Gb.gpd,connected,Gb.band) ;
 } ;
} ;
