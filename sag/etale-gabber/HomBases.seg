-- Bases of Hom(P, Q), and of descended Hom families (LOCALFREE.Basis).
-- If (e_a, c_a) is a basis of P of rank r and (f_b, d_b) one of Q of rank
-- s, the frame of Hom(P, Q) of HOMFRAMES (elementary maps m |-> c_a(m) f_b,
-- coordinates phi |-> d_b(phi(e_a)), indexed by pairs) is a basis:
--     d_b(c_a'(e_a) f_b') = c_a'(e_a) d_b(f_b') = delta_aa' delta_bb',
-- which is the delta of the pairs (PAIRING.delta-pair, pair-unpair).
-- Bases move along identities of modules; for twisted V, W whose fibres
-- merely have bases, the descended Hom(W, V) merely has bases at every x
-- (as TWISTEDFRAMES.descend-frames: a point of G x, and descend-fibre).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module HF = HomFrames[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module TFr = TwistedFrames[l].Over[R,setR] ;
 module D = MnSums[l].Over[R] ;
 module PS = Pairing[l].Sums[R] ;
 module Of (P Q : MD.Module) (r s : Nat) (bp : LF.Basis[P,r]) (bq : LF.Basis[Q,s]) {
  module HO = HF.Of[P,Q,r,s,bp.frame,bq.frame] ;
  -- coordinate p of elementary p'
  pairs (p p' : Fin r * Fin s) :
   Id R.R ((HO.coordinate p).1 (HO.elementary p')) (R.mul (D.delta r p.1 p'.1) (D.delta s p.2 p'.2)) =
   calc R.R { (HO.d p.2).1 (Q.sm ((HO.c p'.1).1 (HO.e p.1)) (HO.f p'.2))
     =< (HO.d p.2).2.2 ((HO.c p'.1).1 (HO.e p.1)) (HO.f p'.2) > R.mul ((HO.c p'.1).1 (HO.e p.1)) ((HO.d p.2).1 (HO.f p'.2))
     =< cong2 R.R R.mul _ _ _ _ (trans (bp.dual p'.1 p.1) (D.delta-sym r p'.1 p.1)) (bq.dual p.2 p'.2) >
        R.mul (D.delta r p.1 p'.1) (D.delta s p.2 p'.2) } ;
  dual (k k' : Fin HO.N) : Id R.R ((HO.coordinate (HO.index k)).1 (HO.elementary (HO.index k'))) (D.delta HO.N k k') =
   calc R.R { (HO.coordinate (HO.index k)).1 (HO.elementary (HO.index k'))
     =< pairs (HO.index k) (HO.index k') > R.mul (D.delta r (HO.index k).1 (HO.index k').1) (D.delta s (HO.index k).2 (HO.index k').2)
     =< sym (PS.delta-pair s r (HO.index k).1 (HO.index k').1 (HO.index k).2 (HO.index k').2) >
        D.delta HO.N (Pairing[l].pair s r (HO.index k).1 (HO.index k).2) (Pairing[l].pair s r (HO.index k').1 (HO.index k').2)
     =< trans (ap (\ t -> D.delta HO.N t (Pairing[l].pair s r (HO.index k').1 (HO.index k').2)) (Pairing[l].pair-unpair s r k))
         (ap (D.delta HO.N k) (Pairing[l].pair-unpair s r k')) >
        D.delta HO.N k k' } ;
  basis : LF.Basis[HF.hom P Q,HO.N] = new LF.Basis[HF.hom P Q,HO.N,HO.frame,dual] ;
 } ;
 -- bases move along identities of modules
 transport (P Q : MD.Module) (eq : Id MD.Module P Q) (r : Nat) (b : Tr.Trunc[LF.Basis[P,r]].carrier) :
  Tr.Trunc[LF.Basis[Q,r]].carrier =
  idJ MD.Module P (\ M p -> Tr.Trunc[LF.Basis[M,r]].carrier) b Q eq ;
 hom-bases (P Q : MD.Module) (r s : Nat) (bp : Tr.Trunc[LF.Basis[P,r]].carrier) (bq : Tr.Trunc[LF.Basis[Q,s]].carrier) :
  Tr.Trunc[LF.Basis[HF.hom P Q,Pairing[l].times r s]].carrier =
  TC.map2 (LF.Basis[P,r]) (LF.Basis[Q,s]) (LF.Basis[HF.hom P Q,Pairing[l].times r s]) (\ a b -> Of[P,Q,r,s,a,b].basis) bp bq ;
 -- descended Hom(V, W)
 module Family (X : U l) (G : X -> TM.GB.AGerbe) {
  module Fam = TFr.Family[X,G] ;
  Based (V : (x : X) -> (G x).1 -> MD.Module) (r : Nat) : U l =
   (x : X) (g : (G x).1) -> Tr.Trunc[LF.Basis[V x g,r]].carrier ;
  module Hom (V W : Fam.TF.Twisted) (r s : Nat) (bv : Based V.1 r) (bw : Based W.1 s) {
   module HV = Fam.Hom[V,W] ;
   bases (x : X) : Tr.Trunc[LF.Basis[HV.descended x,Pairing[l].times r s]].carrier =
    Tr.Trunc[(G x).1].induction @l (\ g -> Tr.Trunc[LF.Basis[HV.descended x,Pairing[l].times r s]].carrier)
     (\ g -> Tr.Trunc[LF.Basis[HV.descended x,Pairing[l].times r s]].proposition)
     (\ g -> transport (HV.H x g) (HV.descended x)
      (Pr1.sym MD.Module (HV.descended x) (HV.H x g) (Fam.TF.descend-fibre HV.weight-zero x g)) (Pairing[l].times r s)
      (hom-bases (V.1 x g) (W.1 x g) r s (bv x g) (bw x g)))
     (Fam.point x) ;
  } ;
 } ;
} ;
