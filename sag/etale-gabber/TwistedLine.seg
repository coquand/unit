-- The twisted line of a point (base case of Theorem main, gabber-recollement:
-- on D(u_i) a point of the gerbe gives a rank-one twisted module).  Let Gb be
-- an R^x-gerbe (GERBE) with a point s.  The family
--     line g = Line(s = g),
-- the line associated to the torsor of paths s = g (GERBE.PTor, a . p =
-- beta_s^-1(a) p; LINEASSOCIATED.Line: f : (s = g) -> R with
-- f(a . p) = a^-1 f(p)), is twisted (weight 1, TWISTEDMODULES):
--  (move)   transport along r : g = g' is (r_* f)(p) = f(p r^-1)  (J on r);
--  (weight) for a loop q at g and p : s = g, p q^-1 = a . p with
--               a = beta_s((p q^-1) p^-1)      (GERBE.pft)
--                 = beta_g(q^-1)               (GERBE.band-conj, sym-sym)
--                 = beta_g(q)^-1               (GERBE.bnd-sym),
--           so (q_* f)(p) = f(a . p) = a^-1 f(p) = beta_g(q) f(p).
--  (frames) each line g is merely R (LineAssociated.Based at a path s = g,
--           which exists merely), so it merely has a frame of rank 1
--           (FRAMES.regular, HOMFRAMES.transport).
-- Over a family of gerbes G x with a section s x, this gives a twisted
-- family framed of rank 1 (TWISTEDFRAMES.Framed).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module HF = HomFrames[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 module LA = LineAssociated[l].Over[R,setR] ;
 module At (Gb : TM.GB.AGerbe) (s : Gb.1) {
  module T = TM.At[TM.charge (TM.banded (Gb))] ;
  module GL = TM.GB.GL[Gb] ;
  line (g : T.Y) : MD.Module = LA.Line.At[LA.pre (GL.PTor s g)].associated ;
  module MV = T.Move[line] ;
  -- (move)
  move-apply (g g' : T.Y) (r : Id T.Y g g') (f : (line g).M) (p : Id T.Y s g') :
   Id R.R ((MV.move g g' r f).1 p) (f.1 (Pr.trans T.Y s g' g p (Pr.sym T.Y g g' r))) =
   idJ T.Y g (\ z r' -> (p' : Id T.Y s z) ->
     Id R.R ((MV.move g z r' f).1 p') (f.1 (Pr.trans T.Y s z g p' (Pr.sym T.Y g z r'))))
    (\ p' -> refl (f.1 p')) g' r p ;
  -- (weight)
  conj (g : T.Y) (q : Id T.Y g g) (p : Id T.Y s g) : UG.Unit =
   GL.bnd s (Pr.trans T.Y s g s (Pr.trans T.Y s g g p (Pr.sym T.Y g g q)) (Pr.sym T.Y s g p)) ;
  translate (g : T.Y) (q : Id T.Y g g) (p : Id T.Y s g) :
   Id (Id T.Y s g) (GL.pact s g (conj g q p) p) (Pr.trans T.Y s g g p (Pr.sym T.Y g g q)) =
   (GL.pft s g p (Pr.trans T.Y s g g p (Pr.sym T.Y g g q))).1.2 ;
  conj-band (g : T.Y) (q : Id T.Y g g) (p : Id T.Y s g) : Id UG.Unit (conj g q p) (UG.inverse (GL.bnd g q)) =
   trans (ap (\ k -> GL.bnd s (Pr.trans T.Y s g s (Pr.trans T.Y s g g k (Pr.sym T.Y g g q)) (Pr.sym T.Y s g p)))
     (sym (Groupoid[l].sym-sym T.Y s g p)))
    (trans (GL.band-conj g (Pr.sym T.Y g g q) s (Pr.sym T.Y s g p)) (GL.bnd-sym g q)) ;
  loop (g : T.Y) (q : Id T.Y g g) (f : (line g).M) (p : Id T.Y s g) :
   Id R.R ((MV.move g g q f).1 p) (R.mul (GL.bnd g q).1 (f.1 p)) =
   calc R.R { (MV.move g g q f).1 p
     =< move-apply g g q f p > f.1 (Pr.trans T.Y s g g p (Pr.sym T.Y g g q))
     =< ap f.1 (sym (translate g q p)) > f.1 (GL.pact s g (conj g q p) p)
     =< f.2 (conj g q p) p > R.mul (UG.inverse (conj g q p)).1 (f.1 p)
     =< ap (\ u -> R.mul (UG.inverse u).1 (f.1 p)) (conj-band g q p) > R.mul (GL.bnd g q).1 (f.1 p) } ;
  weight : T.Weight T.identity line = \ g q f ->
   LA.Line.At[LA.pre (GL.PTor s g)].equal (MV.move g g q f) ((line g).sm (GL.bnd g q).1 f) (loop g q f) ;
  -- (frames)
  frames (g : T.Y) : Tr.Trunc[FR.Frame[line g,suc zero]].carrier =
   Tr.Trunc[Id T.Y s g].induction @l (\ p -> Tr.Trunc[FR.Frame[line g,suc zero]].carrier)
    (\ p -> Tr.Trunc[FR.Frame[line g,suc zero]].proposition)
    (\ p -> HF.transport MD.regular (line g)
     (Pr1.sym MD.Module (line g) MD.regular LA.Line.At[LA.pre (GL.PTor s g)].Based[p].module-equality) (suc zero)
     (Tr.Trunc[FR.Frame[MD.regular,suc zero]].inc FR.regular))
    (GL.conn s g) ;
 } ;
 -- over a family of gerbes with a section
 module Family (X : U l) (G : X -> TM.GB.AGerbe) (s : (x : X) -> (G x).1) {
  module TF = TM.Family[X,G] ;
  module TFr = TwistedFrames[l].Over[R,setR].Family[X,G] ;
  twisted : TF.Twisted = (\ x -> At[G x,s x].line,\ x -> At[G x,s x].weight) ;
  framed : TFr.Framed twisted.1 (suc zero) = \ x -> At[G x,s x].frames ;
 } ;
} ;
