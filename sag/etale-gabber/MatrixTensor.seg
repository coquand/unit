-- Tensoring with an ordinary module given by a matrix, without tensor
-- products (CHEAP-DESIGN.md, 1).  Over R, for an N x N matrix e put
--     I e = { w in R^N | e w = w }                 (a submodule of R^N)
--     U [x] e = Hom(I e, U)                         (U any module)
-- so U [x] e is "U (x) (I e)^v"; for frame data of F with projector p, F = I p
-- (FRAMEIMAGE), hence Hom(F, U) = U [x] p.
--  (equivalence)  For an equivalence u, v of X and Y (EQUIVALENCE), w |-> u w
--     and w |-> v w are inverse linear maps I X ~ I Y: Y u w = u w, X v w = v w,
--     v u w = X w = w, u v w = Y w = w.  So I X = I Y and U [x] X = U [x] Y.
--  (all)  If e fixes every vector, I e = R^N.
--  (block sum)  I (p + q) = I p + I q by parts: (p + q) w has parts p w_l and
--     q w_r (DIRECTSUMS.act-l, act-r), so w |-> (w_l, w_r) and
--     (u, v) |-> catv u v are inverse.
--  (Hom)  Hom(A + B, U) = Hom(A, U) + Hom(B, U): f |-> (f(-,0), f(0,-)) with
--     inverse (g, h) |-> ((a,b) |-> g a + h b); f(a,0) + f(0,b) = f(a,b).
--     Hom(R, U) = U: f |-> f 1, with inverse u |-> (c |-> c u).
--  (powers)  R^1 = R, and the identity of size k + 2 acts as the block sum of
--     the identities of sizes 1 and k + 1, so U [x] 1_(k+1) = U + ... + U
--     (k + 1 copies, EFFACE.power).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 free (N : Nat) : MD.Module = MD.pi (Fin N) (\ i -> MD.regular) ;
 module Image (N : Nat) (e : Vectors[l].Over[R,setR,N].MR.Mat) {
  module V = Vectors[l].Over[R,setR,N] ;
  Fixed (w : V.Vec) : U l = Id V.Vec (V.act e w) w ;
  sub : DescentSubmodules[l].Submodule[MD.ring,free N] = new DescentSubmodules[l].Submodule[MD.ring,free N,Fixed,
   \ w -> V.set-vec _ _,
   V.act-zero e,
   \ u v hu hv -> trans (V.act-add e u v) (cong2 V.Vec V.vadd _ _ _ _ hu hv),
   \ u hu -> trans (V.act-neg e u) (ap V.vneg hu),
   \ c u hu -> trans (V.act-scale e c u) (ap (V.vscale c) hu)] ;
  module S = SM.Sub[free N,sub] ;
  carrier : MD.Module = S.carrier ;
  -- the vector of an element, and equality of elements
  value (w : S.E) : V.Vec = w.1 ;
  ext (w w' : S.E) (h : Id V.Vec w.1 w'.1) : Id S.E w w' = S.eq w w' h ;
 } ;
 I (N : Nat) (e : Vectors[l].Over[R,setR,N].MR.Mat) : MD.Module = Image[N,e].carrier ;
 tensor (U1 : MD.Module) (N : Nat) (e : Vectors[l].Over[R,setR,N].MR.Mat) : MD.Module = HM.At[I N e,U1].carrier ;
 -- (equivalence)
 module Equivalent (N : Nat) (X Y : Vectors[l].Over[R,setR,N].MR.Mat)
  (q : Equivalence[l].Over[R,setR,N].Equivalent[X,Y]) {
  module Q = Equivalence[l].Over[R,setR,N].Act[X,Y,q] ;
  module IX = Image[N,X] ;
  module IY = Image[N,Y] ;
  module V = IX.V ;
  to (w : IX.S.E) : IY.S.E = (V.act q.u w.1,Q.yu w.1) ;
  from (w : IY.S.E) : IX.S.E = (V.act q.v w.1,Q.xv w.1) ;
  to-from (w : IY.S.E) : Id IY.S.E (to (from w)) w = IY.ext (to (from w)) w (trans (Q.uv w.1) w.2) ;
  from-to (w : IX.S.E) : Id IX.S.E (from (to w)) w = IX.ext (from (to w)) w (trans (Q.vu w.1) w.2) ;
  image : Id MD.Module (I N X) (I N Y) =
   SIP.sip (I N X) (I N Y) ((to,Pr.qinv IX.S.E IY.S.E to from to-from from-to),
    \ w w' -> IY.ext _ _ (V.act-add q.u w.1 w'.1),
    \ c w -> IY.ext _ _ (V.act-scale q.u c w.1)) ;
  theorem (U1 : MD.Module) : Id MD.Module (tensor U1 N X) (tensor U1 N Y) =
   Pr1.ap MD.Module MD.Module (\ M -> HM.At[M,U1].carrier) (I N X) (I N Y) image ;
 } ;
 -- (all)
 module All (N : Nat) (e : Vectors[l].Over[R,setR,N].MR.Mat) (h : (w : Vectors[l].Over[R,setR,N].Vec) -> Image[N,e].Fixed w) {
  module IE = Image[N,e] ;
  theorem : Id MD.Module (I N e) (free N) =
   SIP.sip (I N e) (free N) ((IE.value,Pr.qinv IE.S.E (free N).M IE.value (\ w -> (w,h w)) (\ w -> refl w)
     (\ w -> IE.ext (w.1,h w.1) w (refl w.1))),
    \ w w' -> refl (IE.V.vadd w.1 w'.1),
    \ c w -> refl (IE.V.vscale c w.1)) ;
 } ;
 -- (block sum)
 module Block (m n : Nat) (p : Vectors[l].Over[R,setR,m].MR.Mat) (q : Vectors[l].Over[R,setR,n].MR.Mat) {
  module DS = DirectSums[l].Over[R,setR,m,n] ;
  module IP = Image[m,p] ;
  module IQ = Image[n,q] ;
  module IS = Image[plus m n,DS.dsum p q] ;
  module P2 = MS.Pair[I m p,I n q] ;
  to (w : IS.S.E) : P2.Carrier =
   ((DS.lpart w.1,DS.Vm.vec-eq _ _ (\ i -> trans (sym (DS.act-l p q w.1 i)) (DS.V2.entry _ _ w.2 (DS.il i)))),
    (DS.rpart w.1,DS.Vn.vec-eq _ _ (\ i -> trans (sym (DS.act-r p q w.1 i)) (DS.V2.entry _ _ w.2 (DS.ir i))))) ;
  fixed (u : IP.S.E) (v : IQ.S.E) : IS.Fixed (DS.catv u.1 v.1) =
   DS.Parts[DS.V2.act (DS.dsum p q) (DS.catv u.1 v.1),DS.catv u.1 v.1,
    \ i -> trans (DS.act-l p q (DS.catv u.1 v.1) i)
     (trans (ap (\ t -> DS.Vm.act p t i) (DS.lpart-catv u.1 v.1)) (trans (DS.Vm.entry _ _ u.2 i) (sym (DS.catv-l u.1 v.1 i)))),
    \ i -> trans (DS.act-r p q (DS.catv u.1 v.1) i)
     (trans (ap (\ t -> DS.Vn.act q t i) (DS.rpart-catv u.1 v.1)) (trans (DS.Vn.entry _ _ v.2 i) (sym (DS.catv-r u.1 v.1 i))))].equal ;
  from (z : P2.Carrier) : IS.S.E = (DS.catv z.1.1 z.2.1,fixed z.1 z.2) ;
  to-from (z : P2.Carrier) : Id P2.Carrier (to (from z)) z =
   P2.pair-eq _ _ _ _ (IP.ext _ _ (DS.lpart-catv z.1.1 z.2.1)) (IQ.ext _ _ (DS.rpart-catv z.1.1 z.2.1)) ;
  from-to (w : IS.S.E) : Id IS.S.E (from (to w)) w = IS.ext _ _ (DS.catv-parts w.1) ;
  pair-ext (z z' : P2.Carrier) (h1 : Id DS.Vm.Vec z.1.1 z'.1.1) (h2 : Id DS.Vn.Vec z.2.1 z'.2.1) : Id P2.Carrier z z' =
   P2.pair-eq _ _ _ _ (IP.ext _ _ h1) (IQ.ext _ _ h2) ;
  image : Id MD.Module (I (plus m n) (DS.dsum p q)) (MS.plus (I m p) (I n q)) =
   SIP.sip (I (plus m n) (DS.dsum p q)) (MS.plus (I m p) (I n q)) ((to,Pr.qinv IS.S.E P2.Carrier to from to-from from-to),
    \ w w' -> pair-ext _ _ (refl (DS.lpart (DS.V2.vadd w.1 w'.1))) (refl (DS.rpart (DS.V2.vadd w.1 w'.1))),
    \ c w -> pair-ext _ _ (refl (DS.lpart (DS.V2.vscale c w.1))) (refl (DS.rpart (DS.V2.vscale c w.1)))) ;
 } ;
} ;
