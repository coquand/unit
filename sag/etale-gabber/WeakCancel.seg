-- Weak cancellation for Proposition `cheap` (CHEAP-DESIGN.md, section 3):
-- from rho(H') = 1 and rho(E) = 1, a power of V and a power of W become
-- equal.  Setting of DATUM: V, W twisted, W framed of rank s, frame data dH
-- of the descended H' = Hom(W, V) and dE of E = End V, with projectors
-- q = p_H' and e = p_E over Alg, Z = Hom(Hom(W, V), V).  Assume rho(q) = 1
-- at rank N = N0 + 1 and rho(e) = 1 at rank M = M0 + 1 (HOMROOTS; the second
-- is its instance W = V).
--  (multiplier) rho(u) = 1 at N gives, merely, k with (k + 1)(u - N) = 0 in
--      K_0 (TRANSPOSES.Rho.multiplier), and rho(e^T) = 1 (TRANSPOSES.Rho.Of).
--      Multipliers k + 1 of q and k' + 1 of e^T give the common multiplier
--      c = (k + 1)(k' + 1) = c0 + 1: c x = (k' + 1)((k + 1) x) = 0, and
--      likewise for the other (Integers.nat-times, RATIONAL.times-suc).
--  (stable) c (u - N) = 0 gives c [u] = c N (TRANSPOSES.Rho.multiples), so
--      [u^c] = [(1_N)^c] (TRANSPOSES.Multiple.copies-class) and merely
--      Image (u^c + 1_j) ~ Image ((1_N)^c + 1_j) for some j (STABILISE).
--  (tensor) For T_U (TENSORCLASSES), T_U(u) = Z' and such an isomorphism:
--        Z'^c + T_U(1_j) = T_U(u^c) + T_U(1_j) = T_U(u^c + 1_j)      (copies, sum)
--                        = T_U((1_N)^c + 1_j)                        (iso)
--                        = (U^N)^c + T_U(1_j)                        (copies, ones).
--      With U = V, u = q and U = W, u = e^T, Z' = Z in both cases (DATUM):
--        Z^c + A = (V^N)^c + A,   Z^c + B = (W^M)^c + B,
--      A = V [x] 1_j, B = W [x] 1_j'.
--  (combine) In a commutative monoid, Zc + A = X + A and Zc + B = Y + B give
--      X + S = Y + S for S = (V + A) + (W + B):
--        X + S = (X + A) + (V + (W + B)) = (Zc + A) + (V + (W + B)) = Zc + S,
--        Y + S = Y + ((W + B) + (V + A)) = (Y + B) + (W + (V + A))
--              = (Zc + B) + (W + (V + A)) = Zc + ((W + B) + (V + A)) = Zc + S,
--      by (regroup) X + ((V + A) + D) = X + (V + (A + D)) = X + (A + (V + D))
--      = (X + A) + (V + D).
--  (equation) V + A = V^(j+1), W + B = W^(j'+1) (TENSORCLASSES.free), and
--      (V^N)^c = V^(n+1) with n = exponent N0 c0 (SUMMANDS.iterate), so
--        V^(n+1) + (V^(j+1) + W^(j'+1)) = W^(n'+1) + (V^(j+1) + W^(j'+1)),
--      the hypothesis `cancel` of SUMMANDS.Common.Cancel.
--  (powers) With V framed and unimodular elements in the fibres of V and W,
--      DOMINANCE gives merely W | V^(a+1) and V | W^(b+1); then
--      SUMMANDS.Common.Cancel gives V^(m+1) = W^(m'+1) for some m, m'.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module P1 = Ring[l+] ; module Pn1 = Presentations[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ; module TC1 = TruncationCombinators[l+] ;
-- (combine)
module Combine (T : U l+) (add : T -> T -> T)
 (assoc : (a b c : T) -> Id T (add a (add b c)) (add (add a b) c))
 (comm : (a b : T) -> Id T (add a b) (add b a)) {
 module E = Efface[l].Over[T,add,assoc,comm] ;
 -- (regroup)
 regroup (X V A D : T) : Id T (add X (add (add V A) D)) (add (add X A) (add V D)) =
  P1.trans (P1.ap (add X) (P1.sym (assoc V A D)))
   (P1.trans (P1.ap (add X) (E.exchange V A D)) (assoc X A (add V D))) ;
 theorem (X Y Zc A B V W : T) (eA : Id T (add Zc A) (add X A)) (eB : Id T (add Zc B) (add Y B)) :
  Id T (add X (add (add V A) (add W B))) (add Y (add (add V A) (add W B))) =
  P1.trans
   (P1.trans (regroup X V A (add W B))
    (P1.trans (P1.ap (\ t -> add t (add V (add W B))) (P1.sym eA)) (P1.sym (regroup Zc V A (add W B)))))
   (P1.sym
    (P1.trans (P1.ap (add Y) (comm (add V A) (add W B)))
     (P1.trans (regroup Y W B (add V A))
      (P1.trans (P1.ap (\ t -> add t (add W (add V A))) (P1.sym eB))
       (P1.trans (P1.sym (regroup Zc W B (add V A))) (P1.ap (add Zc) (comm (add W B) (add V A)))))))) ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TwistedFrames[l].Over[R,setR].TM.GB.AGerbe) {
  module TS = TensorClasses[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  module DA = TS.DA ;
  module K = TS.K ;
  module PJ = TS.PJ ;
  module TT = TS.TT ;
  module ST = TS.ST ;
  module IK = TT.IK ;
  module RQ = TT.RQ ;
  module LK = TT.LK ;
  module FS = DA.FS ;
  module SF = Summands[l].Over[FS.Fam,FS.add,FS.assoc,FS.comm] ;
  module CB = Combine[FS.Fam,FS.add,FS.assoc,FS.comm] ;
  module Common (k k' : Nat) {
   -- (k + 1)(k' + 1) = c0 + 1
   c0 : Nat = (Rational[l].times-suc k k').1 ;
   count : Id Nat (Pairing[l].times (suc k) (suc k')) (suc c0) = (Rational[l].times-suc k k').2 ;
   nat-count : Id K.K0.R (IK.nat (suc c0)) (K.K0.mul (IK.nat (suc k)) (IK.nat (suc k'))) =
    trans (ap IK.nat (sym count)) (IK.nat-times (suc k) (suc k')) ;
   -- c d = (k' + 1)((k + 1) d) = 0
   left (d : K.K0.R) (h : Id K.K0.R (K.K0.mul (IK.nat (suc k)) d) K.K0.z) : Id K.K0.R (K.K0.mul (IK.nat (suc c0)) d) K.K0.z =
    calc K.K0.R { K.K0.mul (IK.nat (suc c0)) d
      =< ap (\ t -> K.K0.mul t d) nat-count > K.K0.mul (K.K0.mul (IK.nat (suc k)) (IK.nat (suc k'))) d
      =< ap (\ t -> K.K0.mul t d) (K.K0.mulC (IK.nat (suc k)) (IK.nat (suc k'))) > K.K0.mul (K.K0.mul (IK.nat (suc k')) (IK.nat (suc k))) d
      =< sym (K.K0.mulA (IK.nat (suc k')) (IK.nat (suc k)) d) > K.K0.mul (IK.nat (suc k')) (K.K0.mul (IK.nat (suc k)) d)
      =< ap (K.K0.mul (IK.nat (suc k'))) h > K.K0.mul (IK.nat (suc k')) K.K0.z
      =< LK.mul-zero (IK.nat (suc k')) > K.K0.z } ;
   -- c d = (k + 1)((k' + 1) d) = 0
   right (d : K.K0.R) (h : Id K.K0.R (K.K0.mul (IK.nat (suc k')) d) K.K0.z) : Id K.K0.R (K.K0.mul (IK.nat (suc c0)) d) K.K0.z =
    calc K.K0.R { K.K0.mul (IK.nat (suc c0)) d
      =< ap (\ t -> K.K0.mul t d) nat-count > K.K0.mul (K.K0.mul (IK.nat (suc k)) (IK.nat (suc k'))) d
      =< sym (K.K0.mulA (IK.nat (suc k)) (IK.nat (suc k')) d) > K.K0.mul (IK.nat (suc k)) (K.K0.mul (IK.nat (suc k')) d)
      =< ap (K.K0.mul (IK.nat (suc k))) h > K.K0.mul (IK.nat (suc k)) K.K0.z
      =< LK.mul-zero (IK.nat (suc k)) > K.K0.z } ;
  } ;
  -- (stable)
  module Stable (u : PJ.Projector) (N0 c0 : Nat) (h : Id K.K0.R (K.K0.mul (IK.nat (suc c0)) (TT.Rho[N0].diff (K.class u))) K.K0.z) {
   multiple : Id K.K0.R (K.multiple (suc c0) (K.class u)) (K.multiple (suc c0) (K.free (suc N0))) =
    TT.Rho[N0].multiples (suc c0) (K.class u) h ;
   classes : Id K.K0.R (K.class (TT.copies u (suc c0))) (K.class (TT.copies (ST.one (suc N0)) (suc c0))) =
    TT.Multiple[u,suc c0,suc N0,multiple].copies-class ;
   Stably : U l = (j : Nat) * ST.Stably (TT.copies u (suc c0)) (TT.copies (ST.one (suc N0)) (suc c0)) j ;
   theorem : Tr.Trunc[Stably].carrier = ST.Stabilise[TT.copies u (suc c0),TT.copies (ST.one (suc N0)) (suc c0),classes].theorem ;
  } ;
  -- (tensor)
  module Tensor (U1 Z' : FS.Fam) (u : PJ.Projector) (hz : Id FS.Fam (TS.tensor U1 u) Z') (N0 c0 j : Nat)
   (e : K.Iso (K.sum (TT.copies u (suc c0)) (ST.one j)) (K.sum (TT.copies (ST.one (suc N0)) (suc c0)) (ST.one j))) {
   A : FS.Fam = TS.tensor U1 (ST.one j) ;
   left : Id FS.Fam (TS.tensor U1 (K.sum (TT.copies u (suc c0)) (ST.one j))) (FS.add (FS.E.power c0 Z') A) =
    P1.trans (TS.sum U1 (TT.copies u (suc c0)) (ST.one j))
     (P1.ap (\ F -> FS.add F A) (P1.trans (TS.copies U1 u c0) (P1.ap (FS.E.power c0) hz))) ;
   right : Id FS.Fam (TS.tensor U1 (K.sum (TT.copies (ST.one (suc N0)) (suc c0)) (ST.one j))) (FS.add (FS.E.power c0 (FS.E.power N0 U1)) A) =
    P1.trans (TS.sum U1 (TT.copies (ST.one (suc N0)) (suc c0)) (ST.one j))
     (P1.ap (\ F -> FS.add F A) (P1.trans (TS.copies U1 (ST.one (suc N0)) c0) (P1.ap (FS.E.power c0) (TS.ones U1 N0)))) ;
   theorem : Id FS.Fam (FS.add (FS.E.power c0 Z') A) (FS.add (FS.E.power c0 (FS.E.power N0 U1)) A) =
    P1.trans (P1.sym left) (P1.trans (TS.iso U1 _ _ e) right) ;
  } ;
  -- the hypothesis `cancel` of SUMMANDS.Common.Cancel
  Equation (V W : FS.Fam) : U l+ = (c d K K' : Nat) *
   Id FS.Fam (FS.add (FS.E.power c V) (FS.add (FS.E.power K V) (FS.E.power K' W)))
    (FS.add (FS.E.power d W) (FS.add (FS.E.power K V) (FS.E.power K' W))) ;
  -- the same, keeping the common multiplier c = c0 + 1 of N = N0 + 1 and M = M0 + 1
  Balanced (V W : FS.Fam) (N0 M0 : Nat) : U l+ = (c0 K K' : Nat) *
   Id FS.Fam (FS.add (FS.E.power (SF.exponent N0 c0) V) (FS.add (FS.E.power K V) (FS.E.power K' W)))
    (FS.add (FS.E.power (SF.exponent M0 c0) W) (FS.add (FS.E.power K V) (FS.E.power K' W))) ;
  equation (V W : FS.Fam) (N0 M0 : Nat) (h : Balanced V W N0 M0) : Equation V W =
   (SF.exponent N0 h.1,SF.exponent M0 h.1,h.2.1,h.2.2.1,h.2.2.2) ;
  module Pair (V W : DA.Fam.TF.Twisted) (s : Nat) (fw : DA.Fam.Framed W.1 s)
   (dH : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,DA.Fam.Hom[W,V].descended].Data)
   (dE : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,DA.Fam.Hom[V,V].descended].Data)
   (N0 M0 : Nat)
   (hH : Id RQ.K.R (TT.Rho[N0].rho (K.class DA.Left[V,W,dH].PH.projector)) RQ.K.o)
   (hE : Id RQ.K.R (TT.Rho[M0].rho (K.class DA.Right[V,W,s,fw,dE].PE.projector)) RQ.K.o) {
   module DT = DA.Datum[V,W,s,fw,dH,dE] ;
   q : PJ.Projector = DT.L.PH.projector ;
   e : PJ.Projector = TT.transpose DT.RE.PE.projector ;
   -- V [x] q = Z = W [x] e^T  (DATUM)
   zv : Id FS.Fam (TS.tensor V.1 q) (DA.Z V W) = DT.L.theorem ;
   zw : Id FS.Fam (TS.tensor W.1 e) (DA.Z V W) = P1.sym DT.RE.theorem ;
   -- rho(e^T) = 1
   he : Id RQ.K.R (TT.Rho[M0].rho (K.class e)) RQ.K.o = TT.Rho[M0].Of[DT.RE.PE.projector,hE].theorem ;
   module From (k k' : Nat)
    (mq : Id K.K0.R (K.K0.mul (IK.nat (suc k)) (TT.Rho[N0].diff (K.class q))) K.K0.z)
    (me : Id K.K0.R (K.K0.mul (IK.nat (suc k')) (TT.Rho[M0].diff (K.class e))) K.K0.z) {
    module CM = Common[k,k'] ;
    module SQ = Stable[q,N0,CM.c0,CM.left (TT.Rho[N0].diff (K.class q)) mq] ;
    module SE = Stable[e,M0,CM.c0,CM.right (TT.Rho[M0].diff (K.class e)) me] ;
    module Isos (j j' : Nat)
     (iq : K.Iso (K.sum (TT.copies q (suc CM.c0)) (ST.one j)) (K.sum (TT.copies (ST.one (suc N0)) (suc CM.c0)) (ST.one j)))
     (ie : K.Iso (K.sum (TT.copies e (suc CM.c0)) (ST.one j')) (K.sum (TT.copies (ST.one (suc M0)) (suc CM.c0)) (ST.one j'))) {
     module TV = Tensor[V.1,DA.Z V W,q,zv,N0,CM.c0,j,iq] ;
     module TW = Tensor[W.1,DA.Z V W,e,zw,M0,CM.c0,j',ie] ;
     X : FS.Fam = FS.E.power CM.c0 (FS.E.power N0 V.1) ;
     Y : FS.Fam = FS.E.power CM.c0 (FS.E.power M0 W.1) ;
     S : FS.Fam = FS.add (FS.add V.1 TV.A) (FS.add W.1 TW.A) ;
     -- (combine)
     combined : Id FS.Fam (FS.add X S) (FS.add Y S) =
      CB.theorem X Y (FS.E.power CM.c0 (DA.Z V W)) TV.A TW.A V.1 W.1 TV.theorem TW.theorem ;
     -- (equation)
     summand : Id FS.Fam S (FS.add (FS.E.power j V.1) (FS.E.power j' W.1)) =
      Pn1.cong2 FS.Fam FS.add _ _ _ _ (TS.free V.1 j) (TS.free W.1 j') ;
     theorem : Balanced V.1 W.1 N0 M0 =
      (CM.c0,j,j',
       P1.trans (Pn1.cong2 FS.Fam FS.add _ _ _ _ (P1.sym (SF.iterate V.1 N0 CM.c0)) (P1.sym summand))
        (P1.trans combined (Pn1.cong2 FS.Fam FS.add _ _ _ _ (SF.iterate W.1 M0 CM.c0) summand))) ;
    } ;
    theorem : Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier =
     TC.rec SQ.Stably @(l+) Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier Tr1.Trunc[Balanced V.1 W.1 N0 M0].proposition
      (\ a -> TC.rec SE.Stably @(l+) Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier Tr1.Trunc[Balanced V.1 W.1 N0 M0].proposition
       (\ b -> TC.rec (K.Iso (K.sum (TT.copies q (suc CM.c0)) (ST.one a.1)) (K.sum (TT.copies (ST.one (suc N0)) (suc CM.c0)) (ST.one a.1)))
         @(l+) Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier Tr1.Trunc[Balanced V.1 W.1 N0 M0].proposition
         (\ iq -> TC.rec (K.Iso (K.sum (TT.copies e (suc CM.c0)) (ST.one b.1)) (K.sum (TT.copies (ST.one (suc M0)) (suc CM.c0)) (ST.one b.1)))
           @(l+) Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier Tr1.Trunc[Balanced V.1 W.1 N0 M0].proposition
           (\ ie -> Tr1.Trunc[Balanced V.1 W.1 N0 M0].inc Isos[a.1,b.1,iq,ie].theorem) b.2) a.2) SE.theorem) SQ.theorem ;
   } ;
   balanced : Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier =
    TC.rec (TT.Rho[N0].Multiplier (K.class q)) @(l+) Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier Tr1.Trunc[Balanced V.1 W.1 N0 M0].proposition
     (\ a -> TC.rec (TT.Rho[M0].Multiplier (K.class e)) @(l+) Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier Tr1.Trunc[Balanced V.1 W.1 N0 M0].proposition
      (\ b -> From[a.1,b.1,a.2,b.2].theorem) (TT.Rho[M0].multiplier (K.class e) he)) (TT.Rho[N0].multiplier (K.class q) hH) ;
   theorem : Tr1.Trunc[Equation V.1 W.1].carrier =
    TC1.map (Balanced V.1 W.1 N0 M0) (Equation V.1 W.1) (equation V.1 W.1 N0 M0) balanced ;
  } ;
  -- (powers)
  module DM = Dominance[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  Powers (V W : FS.Fam) : U l+ = (m m' : Nat) * Id FS.Fam (FS.E.power m V) (FS.E.power m' W) ;
  module Equalise (V W : DA.Fam.TF.Twisted) (r s : Nat) (fv : DA.Fam.Framed V.1 r) (fw : DA.Fam.Framed W.1 s)
   (uv : (x : DA.X) (g : (G x).1) -> Tr.Trunc[LocalLift[l].Over[R,setR,axioms].Unimodular[V.1 x g]].carrier)
   (uw : (x : DA.X) (g : (G x).1) -> Tr.Trunc[LocalLift[l].Over[R,setR,axioms].Unimodular[W.1 x g]].carrier)
   (cancel : Tr1.Trunc[Equation V.1 W.1].carrier) {
   module DB = DM.Both[V,W,r,s,fv,fw,uv,uw] ;
   module From (wv : DM.ST.Power V.1 W.1) (vw : DM.ST.Power W.1 V.1) (h : Equation V.1 W.1) {
    module CC = SF.Common[V.1,W.1,wv.1,vw.1,wv.2,vw.2,h.2.2.1,h.2.2.2.1,h.1,h.2.1] ;
    module CL = CC.Cancel[h.2.2.2.2] ;
    theorem : Powers V.1 W.1 = (SF.exponent h.1 CL.n,SF.exponent h.2.1 CL.n,CL.theorem) ;
   } ;
   theorem : Tr1.Trunc[Powers V.1 W.1].carrier =
    TC1.bind2 (DM.ST.Power V.1 W.1) (DM.ST.Power W.1 V.1) (Powers V.1 W.1)
     (\ wv vw -> TC1.map (Equation V.1 W.1) (Powers V.1 W.1) (\ h -> From[wv,vw,h].theorem) cancel)
     DB.in-v DB.in-w ;
  } ;
  -- with the common multiplier: V^(m+1) = W^(m'+1), m = exponent (exponent N0 c0) n, m' = exponent (exponent M0 c0) n
  PowersB (V W : FS.Fam) (N0 M0 : Nat) : U l+ = (c0 n : Nat) *
   Id FS.Fam (FS.E.power (SF.exponent (SF.exponent N0 c0) n) V) (FS.E.power (SF.exponent (SF.exponent M0 c0) n) W) ;
  module EqualiseB (V W : DA.Fam.TF.Twisted) (r s : Nat) (fv : DA.Fam.Framed V.1 r) (fw : DA.Fam.Framed W.1 s)
   (uv : (x : DA.X) (g : (G x).1) -> Tr.Trunc[LocalLift[l].Over[R,setR,axioms].Unimodular[V.1 x g]].carrier)
   (uw : (x : DA.X) (g : (G x).1) -> Tr.Trunc[LocalLift[l].Over[R,setR,axioms].Unimodular[W.1 x g]].carrier)
   (N0 M0 : Nat) (cancel : Tr1.Trunc[Balanced V.1 W.1 N0 M0].carrier) {
   module DB = DM.Both[V,W,r,s,fv,fw,uv,uw] ;
   module From (wv : DM.ST.Power V.1 W.1) (vw : DM.ST.Power W.1 V.1) (h : Balanced V.1 W.1 N0 M0) {
    module CC = SF.Common[V.1,W.1,wv.1,vw.1,wv.2,vw.2,h.2.1,h.2.2.1,SF.exponent N0 h.1,SF.exponent M0 h.1] ;
    module CL = CC.Cancel[h.2.2.2] ;
    theorem : PowersB V.1 W.1 N0 M0 = (h.1,CL.n,CL.theorem) ;
   } ;
   theorem : Tr1.Trunc[PowersB V.1 W.1 N0 M0].carrier =
    TC1.bind2 (DM.ST.Power V.1 W.1) (DM.ST.Power W.1 V.1) (PowersB V.1 W.1 N0 M0)
     (\ wv vw -> TC1.map (Balanced V.1 W.1 N0 M0) (PowersB V.1 W.1 N0 M0) (\ h -> From[wv,vw,h].theorem) cancel)
     DB.in-v DB.in-w ;
  } ;
 } ;
} ;
