-- Inverting an algebra map whose underlying function is an equivalence.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module At (A B : C.Algebra) (h : C.Hom A B) (e : Pr.isEquiv A.ring.R B.ring.R h.1.1) {
  inject (a b : A.ring.R) : Id B.ring.R (h.1.1 a) (h.1.1 b) -> Id A.ring.R a b =
   Equivalences[l].injective A.ring.R B.ring.R h.1.1 e a b ;
  one : Id A.ring.R (e.sec B.ring.o) A.ring.o =
   inject _ _ (trans (e.sec-eq B.ring.o) (sym h.1.2.1)) ;
  add (a b : B.ring.R) : Id A.ring.R (e.sec (B.ring.add a b)) (A.ring.add (e.sec a) (e.sec b)) =
   inject _ _ (trans (e.sec-eq (B.ring.add a b))
    (trans (Presentations[l].cong2 B.ring.R B.ring.add _ _ _ _ (sym (e.sec-eq a)) (sym (e.sec-eq b)))
     (sym (h.1.2.2.1 (e.sec a) (e.sec b))))) ;
  mul (a b : B.ring.R) : Id A.ring.R (e.sec (B.ring.mul a b)) (A.ring.mul (e.sec a) (e.sec b)) =
   inject _ _ (trans (e.sec-eq (B.ring.mul a b))
    (trans (Presentations[l].cong2 B.ring.R B.ring.mul _ _ _ _ (sym (e.sec-eq a)) (sym (e.sec-eq b)))
     (sym (h.1.2.2.2 (e.sec a) (e.sec b))))) ;
  constants (r : R.R) : Id A.ring.R (e.sec (B.iota.1 r)) (A.iota.1 r) =
   inject _ _ (trans (e.sec-eq (B.iota.1 r)) (sym (h.2 r))) ;
  inverse : C.Hom B A = ((e.sec,one,add,mul),constants) ;
 } ;
 -- The structure identity lemma with an empty family of points.
 equality (A B : C.Algebra) (h : C.Hom A B) (e : Pr.isEquiv A.ring.R B.ring.R h.1.1) :
  Id C.Algebra A B =
  Hi.ap (AlgebraPointsIdentity[l].Over[R,setR,Empty].Decorated) C.Algebra (\ d -> d.1) _ _
   (AlgebraPointsIdentity[l].Over[R,setR,Empty].sip A B (absurd (C.Spec A)) (absurd (C.Spec B))
    h e (\ x -> absurd ((a : A.ring.R) -> Id R.R ((absurd (C.Spec A) x).1.1 a)
      ((absurd (C.Spec B) x).1.1 (h.1.1 a))) x)) ;
 transfer-fp (A B : C.Algebra) (h : C.Hom A B) (e : Pr.isEquiv A.ring.R B.ring.R h.1.1) :
  P.FP A -> P.FP B = Hi.subst C.Algebra P.FP A B (equality A B h e) ;
} ;
