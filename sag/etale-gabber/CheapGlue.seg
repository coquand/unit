-- Proposition `cheap` (gabber-recollement), assembled.  Let a, b in A be
-- merely comaximal (A f.p., gerbes G x on Spec A, Lambda of weight n = n0 + 1
-- with rank-1 bases), V a twisted family on D(a) and W one on D(b), whose
-- fibres merely have bases of ranks r = r0 + 1, s = s0 + 1, good of ranks
-- N_V = r^n, N_W = s^n on Spec A_a, Spec A_b (CHEAPOVERLAP.Good).  Then
-- merely there are m, m' and a twisted family V' on Spec A whose
-- restrictions to D(a), D(b) are V^(m+1), W^(m'+1), and these are good, of
-- ranks (m+1)^n N_V, (m'+1)^n N_W.
-- L_f is the localisation of A at f (f = a, b, ab), with points
-- p_f : Spec L_f ~ D(f) (AFFINEINTERFACE.spectrum); a family on D(f) gives
-- one on Spec L_f by composing with p_f, over the gerbes G (p_f y).
--  (units)  x(ab) = x(a) x(b) (x a ring map), and a product is a unit iff
--     both factors are (AFFINERING); so a point y of Spec L_ab gives points
--     d_a y, d_b y of D(a), D(b) over p_ab y.
--  (maps)  a b = ab (b a = ab) gives L_a -> L_ab over A
--     (LOCALIZATIONRINGS.Shrink), so the point of D(a) below y . (L_a -> L_ab)
--     is d_a y (same: ALGEBRAS.ext, y(map(inc_a r)) = y(inc_ab r); the unit
--     is a proposition).
--  (good)  Let P be the descended P(V)^v on D(a).  On Spec L_a it is P . p_a,
--     good by hypothesis; GOODRESTRICT moves goodness to y |-> P(p_a(y . map))
--     on Spec L_ab, which is y |-> P(d_a y) by (maps), the descended P(V_ab)^v
--     of V_ab = V . d_a.  P . p_a merely has frame data (AFFINEFRAMEDATA).
--  (iso)  CHEAPOVERLAP on Spec L_ab (bases and Lambda restrict pointwise)
--     gives merely V_ab^(m+1) = W_ab^(m'+1).  For x in D(a) n D(b) let
--     y = p_ab^-1 (x, x(a)^-1 x(b)^-1); then V^(m+1)(d_a y) = W^(m'+1)(d_b y)
--     (FAMILYMOVES.Pull), and p_ab y = (x, ..) moves this to x
--     (FAMILYMOVES.Move).
--  (glue)  TWISTEDGLUE glues V^(m+1) and W^(m'+1) (twisted by
--     FAMILYMOVES.Powers) along these identities; the restrictions of the
--     glued family are V^(m+1) and W^(m'+1).
--  (same)  If r = s, the exponents agree (CHEAPOVERLAP `balanced`): V' has
--     the single rank (m+1) r, as Proposition `correct` needs.
--  (restrictions)  V^(m+1) . p_a = (V . p_a)^(m+1) (FAMILYMOVES.Pull; weights
--     are propositions, TWISTEDGLUE.WeightProp), good of rank (m+1)^n N_V
--     given frame data of P(V . p_a)^v (GOODPOWERS); likewise for W.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 module FM = FamilyMoves[l].Over[R,setR,axioms] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module TG = TwistedGlue[l].Over[R,setR] ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TM.GB.AGerbe) (a b : A.ring.R)
  (cm : Tr.Trunc[Comaximal[l].Over[A.ring].Comaximal a b].carrier)
  (la : AI.LocalizationWitness A a) (lb : AI.LocalizationWitness A b) (lab : AI.LocalizationWitness A (A.ring.mul a b))
  (n0 : Nat) (Lambda : TM.Family[C.Spec A,G].Weighted (\ c -> TM.UG.power c (suc n0)))
  (bl : (x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier) {
  module GL = TG.Opens[loc,A,a,b,cm] ;
  module GD = GL.On[G].GD ;
  -- the overlap
  pab (y : C.Spec lab.1) : AI.D A (A.ring.mul a b) = (AI.spectrum A (A.ring.mul a b) lab).1 y ;
  Gab (y : C.Spec lab.1) : TM.GB.AGerbe = G (pab y).1 ;
  lam-ab : TM.Family[C.Spec lab.1,Gab].Weighted (\ c -> TM.UG.power c (suc n0)) =
   (\ y g -> Lambda.1 (pab y).1 g,\ y -> Lambda.2 (pab y).1) ;
  bl-ab (y : C.Spec lab.1) (g : (Gab y).1) : Tr.Trunc[LF.Basis[lam-ab.1 y g,suc zero]].carrier = bl (pab y).1 g ;
  -- (units)
  product (x : C.Spec A) (h : RL[R].unit (x.1.1 (A.ring.mul a b))) : RL[R].unit (R.mul (x.1.1 a) (x.1.1 b)) =
   Pr.subst R.R RL[R].unit (x.1.1 (A.ring.mul a b)) (R.mul (x.1.1 a) (x.1.1 b)) (x.1.2.2.2 a b) h ;
  unit-a (x : C.Spec A) (h : RL[R].unit (x.1.1 (A.ring.mul a b))) : GL.Da x = RR.unit-left (x.1.1 a) (x.1.1 b) (product x h) ;
  unit-b (x : C.Spec A) (h : RL[R].unit (x.1.1 (A.ring.mul a b))) : GL.Db x = RR.unit-right (x.1.1 a) (x.1.1 b) (product x h) ;
  unit-ab (x : C.Spec A) (u : GL.Da x) (v : GL.Db x) : RL[R].unit (x.1.1 (A.ring.mul a b)) =
   Pr.subst R.R RL[R].unit (R.mul (x.1.1 a) (x.1.1 b)) (x.1.1 (A.ring.mul a b)) (sym (x.1.2.2.2 a b))
    (RR.unit-product (x.1.1 a) (x.1.1 b) u v) ;
  -- the inverse of p_ab
  back (z : AI.D A (A.ring.mul a b)) : C.Spec lab.1 = (lab.2.2.2.2 C.base).sec z ;
  back-eq (z : AI.D A (A.ring.mul a b)) : Id (AI.D A (A.ring.mul a b)) (pab (back z)) z = (lab.2.2.2.2 C.base).sec-eq z ;
  -- one side: f = a (c = b) or f = b (c = a), with f c = ab
  module Side (f c : A.ring.R) (e : Id A.ring.R (A.ring.mul f c) (A.ring.mul a b)) (lf : AI.LocalizationWitness A f)
   (du : (x : C.Spec A) -> RL[R].unit (x.1.1 (A.ring.mul a b)) -> RL[R].unit (x.1.1 f)) {
   Df (x : C.Spec A) : U l = RL[R].unit (x.1.1 f) ;
   Sf : U l = (x : C.Spec A) * Df x ;
   module TF = TM.Family[Sf,\ z -> G z.1] ;
   module PF = FM.Powers[Sf,\ z -> G z.1] ;
   pf (y : C.Spec lf.1) : Sf = (AI.spectrum A f lf).1 y ;
   Gf (y : C.Spec lf.1) : TM.GB.AGerbe = G (pf y).1 ;
   lam-f : TM.Family[C.Spec lf.1,Gf].Weighted (\ c' -> TM.UG.power c' (suc n0)) =
    (\ y g -> Lambda.1 (pf y).1 g,\ y -> Lambda.2 (pf y).1) ;
   lam-s : TM.Family[Sf,\ z -> G z.1].Weighted (\ c' -> TM.UG.power c' (suc n0)) =
    (\ z g -> Lambda.1 z.1 g,\ z -> Lambda.2 z.1) ;
   module CF = CheapOverlap[l].Over[R,setR,axioms].At[lf.1,lf.2.1,Gf,n0,lam-f] ;
   module CA = CheapOverlap[l].Over[R,setR,axioms].At[lab.1,lab.2.1,Gab,n0,lam-ab] ;
   -- families on D(f), on Spec L_f and on Spec L_ab
   on-lf (V : TF.Twisted) : CF.DA.Fam.TF.Twisted = (\ y g -> V.1 (pf y) g,\ y -> V.2 (pf y)) ;
   d (y : C.Spec lab.1) : Sf = ((pab y).1,du (pab y).1 (pab y).2) ;
   on-ab (V : TF.Twisted) : CA.DA.Fam.TF.Twisted = (\ y g -> V.1 (d y) g,\ y -> V.2 (d y)) ;
   -- (maps)
   module SH = LocalizationRings[l].Over[R,setR].Shrink[A,f,c,A.ring.mul a b,e,lf,lab] ;
   below (y : C.Spec lab.1) : C.Spec lf.1 = C.compose lf.1 lab.1 C.base y SH.map ;
   same (y : C.Spec lab.1) : Id Sf (pf (below y)) (d y) =
    Pr.Sigma-eq (C.Spec A) Df (pf (below y)).1 (d y).1 (pf (below y)).2 (d y).2
     (C.ext A C.base (pf (below y)).1 (d y).1 (\ r -> ap y.1.1 (SH.beta r))) (RR.unit-prop ((d y).1.1.1 f)) ;
   -- goodness on Spec L_ab, for the frame data of a family M
   GoodOn (N0 : Nat) (M : C.Spec lab.1 -> MD.Module) : U l =
    (w : FrameProjector[l].Over[R,setR,axioms].At[lab.1,lab.2.1,M].Data) ->
     Id CA.RQ.K.R (CA.WC.TT.Rho[N0].rho (CA.K.class FrameProjector[l].Over[R,setR,axioms].At[lab.1,lab.2.1,M].From[w].projector)) CA.RQ.K.o ;
   module Good (V : TF.Twisted) (r0 NV0 : Nat) (bv : (z : Sf) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[V.1 z g,suc r0]].carrier)
    (gV : CF.Good (on-lf V) NV0) {
    -- (good)
    dual : Sf -> MD.Module = ML.Family[Sf,\ z -> G z.1].Dual[suc n0,V,lam-s].descended ;
    fv : CF.DA.Fam.Framed (on-lf V).1 (suc r0) =
     \ y g -> TC.map (LF.Basis[V.1 (pf y) g,suc r0]) (FR.Frame[V.1 (pf y) g,suc r0]) (\ t -> t.frame) (bv (pf y) g) ;
    fl : CF.DA.Fam.Framed lam-f.1 (suc zero) = \ y g ->
     TC.map (LF.Basis[lam-f.1 y g,suc zero]) (FR.Frame[lam-f.1 y g,suc zero]) (\ t -> t.frame) (bl (pf y).1 g) ;
    module PV = CF.MF.Dual[suc n0,on-lf V,lam-f] ;
    module PA = CA.MF.Dual[suc n0,on-ab V,lam-ab] ;
    mere : Tr.Trunc[FrameProjector[l].Over[R,setR,axioms].At[lf.1,lf.2.1,PV.descended].Data].carrier =
     AffineFrameData[l].Over[R,setR,axioms].At[lf.1,lf.2.1,PV.descended,ML.rank (suc r0) (suc zero) (suc n0),
      PV.descended-frames (suc r0) (suc zero) fv fl].theorem ;
    module GR = GoodRestrict[l].Over[R,setR,axioms].At[lf.1,lf.2.1,lab.1,lab.2.1,SH.map,PV.descended] ;
    -- by definition, the descended P(V . p_f)^v is dual . p_f and that of V . d is dual . d
    at-lf (y : C.Spec lf.1) : Id MD.Module (PV.descended y) (dual (pf y)) = refl (PV.descended y) ;
    at-ab (y : C.Spec lab.1) : Id MD.Module (PA.descended y) (dual (d y)) = refl (PA.descended y) ;
    moved : Id (C.Spec lab.1 -> MD.Module) GR.My PA.descended =
     F1.funext (C.Spec lab.1) (\ y -> MD.Module) GR.My PA.descended
      (\ y -> Pr1.trans MD.Module (GR.My y) (dual (d y)) (PA.descended y)
        (Pr1.trans MD.Module (GR.My y) (dual (pf (below y))) (dual (d y)) (at-lf (below y))
         (Pr1.ap Sf MD.Module dual (pf (below y)) (d y) (same y)))
        (Pr1.sym MD.Module (PA.descended y) (dual (d y)) (at-ab y))) ;
    theorem : CA.Good (on-ab V) NV0 =
     idJ (C.Spec lab.1 -> MD.Module) GR.My (\ M q -> GoodOn NV0 M) (GR.restrict NV0 gV mere) PA.descended moved ;
   } ;
   -- (restrictions)
   rank (NV0 m : Nat) : Nat = (Rational[l].times-suc (PowerSums[l].Over[R,setR].count m (suc n0)) NV0).1 ;
   module Powers (V : TF.Twisted) (r0 NV0 : Nat) (bv : (z : Sf) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[V.1 z g,suc r0]].carrier)
    (gV : CF.Good (on-lf V) NV0) (m : Nat) {
    module GV = Good[V,r0,NV0,bv,gV] ;
    module GP = GoodPowers[l].Over[R,setR,axioms].At[lf.1,lf.2.1,Gf,n0,lam-f] ;
    module PL = FM.Pull[Sf,C.Spec lf.1,\ z -> (G z.1).1,pf] ;
    -- (V^(m+1)) . p_f = (V . p_f)^(m+1), as twisted families
    family : Id CF.DA.Fam.TF.Twisted (GP.power (on-lf V) m) (on-lf (PF.power V m)) =
     Pr1.Sigma-eq PL.FZ.Fam (\ M -> (y : C.Spec lf.1) -> TM.At[TM.charge (TM.banded (Gf y))].Weight (\ c' -> c') (M y))
      (GP.power (on-lf V) m).1 (on-lf (PF.power V m)).1 (GP.power (on-lf V) m).2 (on-lf (PF.power V m)).2
      (PL.power V.1 m)
      (F.isProp-Pi (C.Spec lf.1) (\ y -> TM.At[TM.charge (TM.banded (Gf y))].Weight (\ c' -> c') ((on-lf (PF.power V m)).1 y))
       (\ y -> TG.WeightProp[Gf y,\ c' -> c',(on-lf (PF.power V m)).1 y].theorem)) ;
    module From (wP : FrameProjector[l].Over[R,setR,axioms].At[lf.1,lf.2.1,CF.MF.Dual[suc n0,on-lf V,lam-f].descended].Data) {
     module GG = GP.Power[on-lf V,m,wP].Good[NV0,gV wP] ;
     theorem : CF.Good (on-lf (PF.power V m)) (rank NV0 m) =
      idJ CF.DA.Fam.TF.Twisted (GP.power (on-lf V) m) (\ T q -> CF.Good T (rank NV0 m)) GG.theorem (on-lf (PF.power V m)) family ;
    } ;
    theorem : Tr.Trunc[CF.Good (on-lf (PF.power V m)) (rank NV0 m)].carrier =
     TC.map (FrameProjector[l].Over[R,setR,axioms].At[lf.1,lf.2.1,CF.MF.Dual[suc n0,on-lf V,lam-f].descended].Data)
      (CF.Good (on-lf (PF.power V m)) (rank NV0 m)) (\ wP -> From[wP].theorem) GV.mere ;
   } ;
  } ;
  module SA = Side[a,b,refl (A.ring.mul a b),la,unit-a] ;
  module SB = Side[b,a,A.ring.mulC b a,lb,unit-b] ;
  -- the restrictions of a family on Spec A
  restrict-a (V' : GD.FX.Twisted) : GD.FA.Twisted = (\ z -> V'.1 z.1,\ z -> V'.2 z.1) ;
  restrict-b (V' : GD.FX.Twisted) : GD.FB.Twisted = (\ z -> V'.1 z.1,\ z -> V'.2 z.1) ;
  module Pair (V : GD.FA.Twisted) (W : GD.FB.Twisted) (r0 s0 : Nat)
   (bv : (z : GD.Sa) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[V.1 z g,suc r0]].carrier)
   (bw : (z : GD.Sb) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[W.1 z g,suc s0]].carrier)
   (NV0 NW0 : Nat) (hV : Id Nat (ML.rank (suc r0) (suc zero) (suc n0)) (suc NV0))
   (hW : Id Nat (ML.rank (suc s0) (suc zero) (suc n0)) (suc NW0))
   (gV : SA.CF.Good (SA.on-lf V) NV0) (gW : SB.CF.Good (SB.on-lf W) NW0) {
   Result : U l+ = (m m' : Nat) * (V' : GD.FX.Twisted) *
    Id GD.FA.Twisted (restrict-a V') (SA.PF.power V m) * Id GD.FB.Twisted (restrict-b V') (SB.PF.power W m') *
    SA.CF.Good (SA.on-lf (SA.PF.power V m)) (SA.rank NV0 m) * SB.CF.Good (SB.on-lf (SB.PF.power W m')) (SB.rank NW0 m') ;
   module CO = CheapOverlap[l].Over[R,setR,axioms].At[lab.1,lab.2.1,Gab,n0,lam-ab] ;
   -- (iso)
   overlap : Tr1.Trunc[CO.WC.Powers (SA.on-ab V).1 (SB.on-ab W).1].carrier =
    CO.Pair[SA.on-ab V,SB.on-ab W,r0,s0,\ y g -> bv (SA.d y) g,\ y g -> bw (SB.d y) g,bl-ab,NV0,NW0,hV,hW,
     SA.Good[V,r0,NV0,bv,gV].theorem,SB.Good[W,s0,NW0,bw,gW].theorem].theorem ;
   module Glued (m m' : Nat) (h : Id CO.WC.FS.Fam (CO.WC.FS.E.power m (SA.on-ab V).1) (CO.WC.FS.E.power m' (SB.on-ab W).1)) {
    module PLa = FM.Pull[GD.Sa,C.Spec lab.1,\ z -> (G z.1).1,SA.d] ;
    module PLb = FM.Pull[GD.Sb,C.Spec lab.1,\ z -> (G z.1).1,SB.d] ;
    Fa : GD.OnA = (SA.PF.power V m).1 ;
    Fb : GD.OnB = (SB.PF.power W m').1 ;
    -- at a point y of Spec L_ab
    at (y : C.Spec lab.1) : Id (GD.Fibre (pab y).1) (Fa (SA.d y)) (Fb (SB.d y)) =
     Pr1.trans (GD.Fibre (pab y).1) (Fa (SA.d y)) (CO.WC.FS.E.power m (SA.on-ab V).1 y) (Fb (SB.d y))
      (Pr1.sym (GD.Fibre (pab y).1) (CO.WC.FS.E.power m (SA.on-ab V).1 y) (Fa (SA.d y))
       (Pr1.ap PLa.FZ.Fam (GD.Fibre (pab y).1) (\ t -> t y) _ _ (PLa.power V.1 m)))
      (Pr1.trans (GD.Fibre (pab y).1) (CO.WC.FS.E.power m (SA.on-ab V).1 y) (CO.WC.FS.E.power m' (SB.on-ab W).1 y) (Fb (SB.d y))
       (Pr1.ap CO.WC.FS.Fam (GD.Fibre (pab y).1) (\ t -> t y) _ _ h)
       (Pr1.ap PLb.FZ.Fam (GD.Fibre (pab y).1) (\ t -> t y) _ _ (PLb.power W.1 m'))) ;
    module MV = FM.Move[C.Spec A,GD.Fibre,GL.Da,GL.Db,\ x -> RR.unit-prop (x.1.1 a),\ x -> RR.unit-prop (x.1.1 b),Fa,Fb] ;
    module Pt (x : C.Spec A) (u : GL.Da x) (v : GL.Db x) {
     z : AI.D A (A.ring.mul a b) = (x,unit-ab x u v) ;
     y : C.Spec lab.1 = back z ;
     theorem : Id (GD.Fibre x) (Fa (x,u)) (Fb (x,v)) =
      MV.move (pab y).1 x (ap (\ t -> t.1) (back-eq z)) (MV.at (pab y).1 (SA.d y).2 (SB.d y).2 (at y)) u v ;
    } ;
    -- (glue)
    module GG = GD.Data[Fa,Fb,\ x u v -> Pt[x,u,v].theorem] ;
    module GW = GG.Weights[\ c' -> c',\ z -> SA.PF.weight V m z,\ z -> SB.PF.weight W m' z] ;
    module RA = SA.Powers[V,r0,NV0,bv,gV,m] ;
    module RB = SB.Powers[W,s0,NW0,bw,gW,m'] ;
    -- (restrictions)
    result : Tr1.Trunc[Result].carrier =
     TC.rec (SA.CF.Good (SA.on-lf (SA.PF.power V m)) (SA.rank NV0 m)) @(l+) Tr1.Trunc[Result].carrier Tr1.Trunc[Result].proposition
      (\ ga -> TC.rec (SB.CF.Good (SB.on-lf (SB.PF.power W m')) (SB.rank NW0 m')) @(l+) Tr1.Trunc[Result].carrier Tr1.Trunc[Result].proposition
       (\ gb -> Tr1.Trunc[Result].inc (m,m',GW.family,GW.to-given-V,GW.to-given-W,ga,gb)) RB.theorem) RA.theorem ;
   } ;
   theorem : Tr1.Trunc[Result].carrier =
    TC1.bind (CO.WC.Powers (SA.on-ab V).1 (SB.on-ab W).1) Result (\ t -> Glued[t.1,t.2.1,t.2.2].result) overlap ;
  } ;
  -- V and W of the same rank r: one exponent m on both sides (CHEAPOVERLAP `balanced`), so V' has rank (m+1) r
  module Same (V : GD.FA.Twisted) (W : GD.FB.Twisted) (r0 : Nat)
   (bv : (z : GD.Sa) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[V.1 z g,suc r0]].carrier)
   (bw : (z : GD.Sb) (g : (G z.1).1) -> Tr.Trunc[LF.Basis[W.1 z g,suc r0]].carrier)
   (NV0 : Nat) (hV : Id Nat (ML.rank (suc r0) (suc zero) (suc n0)) (suc NV0))
   (gV : SA.CF.Good (SA.on-lf V) NV0) (gW : SB.CF.Good (SB.on-lf W) NV0) {
   Result : U l+ = (m : Nat) * (V' : GD.FX.Twisted) *
    Id GD.FA.Twisted (restrict-a V') (SA.PF.power V m) * Id GD.FB.Twisted (restrict-b V') (SB.PF.power W m) *
    SA.CF.Good (SA.on-lf (SA.PF.power V m)) (SA.rank NV0 m) * SB.CF.Good (SB.on-lf (SB.PF.power W m)) (SB.rank NV0 m) ;
   module PP = Pair[V,W,r0,r0,bv,bw,NV0,NV0,hV,hV,gV,gW] ;
   module OV = PP.CO.Pair[SA.on-ab V,SB.on-ab W,r0,r0,\ y g -> bv (SA.d y) g,\ y g -> bw (SB.d y) g,bl-ab,NV0,NV0,hV,hV,
    SA.Good[V,r0,NV0,bv,gV].theorem,SB.Good[W,r0,NV0,bw,gW].theorem] ;
   module GluedS (m : Nat) (h : Id PP.CO.WC.FS.Fam (PP.CO.WC.FS.E.power m (SA.on-ab V).1) (PP.CO.WC.FS.E.power m (SB.on-ab W).1)) {
    module GG = PP.Glued[m,m,h] ;
    result : Tr1.Trunc[Result].carrier =
     TC.rec (SA.CF.Good (SA.on-lf (SA.PF.power V m)) (SA.rank NV0 m)) @(l+) Tr1.Trunc[Result].carrier Tr1.Trunc[Result].proposition
      (\ ga -> TC.rec (SB.CF.Good (SB.on-lf (SB.PF.power W m)) (SB.rank NV0 m)) @(l+) Tr1.Trunc[Result].carrier Tr1.Trunc[Result].proposition
       (\ gb -> Tr1.Trunc[Result].inc (m,GG.GW.family,GG.GW.to-given-V,GG.GW.to-given-W,ga,gb)) GG.RB.theorem) GG.RA.theorem ;
   } ;
   theorem : Tr1.Trunc[Result].carrier =
    TC1.bind (PP.CO.WC.PowersB (SA.on-ab V).1 (SB.on-ab W).1 OV.CH.c0 OV.CE.c0) Result
     (\ t -> GluedS[PP.CO.WC.SF.exponent (PP.CO.WC.SF.exponent OV.CH.c0 t.1) t.2.1,t.2.2].result) OV.balanced ;
  } ;
 } ;
} ;
