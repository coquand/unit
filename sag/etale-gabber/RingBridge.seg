-- A ring of Sections 2-5 as a ring of torsor/Alg73.  Units are the same
-- type; powers and finite sums agree along toN and toF (NatFin).  Loc in
-- the form of StandardOpens gives the hypothesis LocR of torsor/Affine.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CF = FinChoice[l] ; module A7 = Alg73[l] ; module NF = NatFin[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 ring : A7.CRing = new A7.CRing[R.R,setR,R.z,R.o,R.add,R.mul,R.neg,
  R.addA,R.addC,R.addZ,R.addN,R.mulA,R.mulC,R.mulO,R.dist] ;
 module RA = A7.RA[ring] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 unit-to (x : R.R) (u : RL[R].unit x) : RA.unit x = u ;
 unit-from (x : R.R) (u : RA.unit x) : RL[R].unit x = u ;
 power (x : R.R) : (n : Nat) -> Id R.R (RA.pw x (NF.toN n)) (AffinePowers[l].Over[R].power x n) = split {
  zero -> refl R.o ; suc n | r -> ap (R.mul x) r } ;
 sum : (n : Nat) (h : CF.Fin (NF.toN n) -> R.R) ->
  Id R.R (A7.Reg[ring].sumR (NF.toN n) h) (RS.sum n (\ i -> h (NF.toF n i))) = split {
  zero -> \ h -> refl R.z ;
  suc n | r -> \ h -> ap (R.add (h none)) (r (\ i -> h (some i))) } ;
 plus-or (a b : R.R) : Plus (RL[R].unit a) (RL[R].unit b) -> Affine[l].Or (RA.unit a) (RA.unit b) = split {
  inl u -> inl u ; inr v -> inr v } ;
 -- Loc gives LocR, for any base type and module family
 loc (X : U l) (Mx : X -> A7.Mod[ring]) (lc : StandardOpens[l].Over[R,setR].Locality) :
  Affine[l].Aff[ring,X,Mx].LocR =
  (\ p -> efq (lc.1 p),
   \ a b u -> Tr.Trunc[Plus (RL[R].unit a) (RL[R].unit b)].induction @l
    (\ t -> Tr.Trunc[Affine[l].Or (RA.unit a) (RA.unit b)].carrier)
    (\ t -> Tr.Trunc[Affine[l].Or (RA.unit a) (RA.unit b)].proposition)
    (\ w -> Tr.Trunc[Affine[l].Or (RA.unit a) (RA.unit b)].inc (plus-or a b w)) (lc.2 a b u)) ;
} ;
