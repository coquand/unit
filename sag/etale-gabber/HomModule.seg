-- The module Hom(M, N) of linear maps between two R-modules: the
-- submodule of the product N^M (MODULES.pi) of the additive maps commuting
-- with scalars.  Closure: 0 is linear; f + g by swap4 and smD; -f by
-- neg-add and sm-neg; c f by smD and sm-swap (R is commutative).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module At (M N : MD.Module) {
  module MN = Alg73[l].MA[MD.ring,N] ;
  Maps : MD.Module = MD.pi M.M (\ m -> N) ;
  Additive (f : Maps.M) : U l = (x y : M.M) -> Id N.M (f (M.madd x y)) (N.madd (f x) (f y)) ;
  Scalar (f : Maps.M) : U l = (a : R.R) (x : M.M) -> Id N.M (f (M.sm a x)) (N.sm a (f x)) ;
  Linear (f : Maps.M) : U l = Additive f * Scalar f ;
  linear-prop (f : Maps.M) : Pr.isProp (Linear f) =
   Pr.isProp-Sigma (Additive f) (\ h -> Scalar f)
    (F.isProp-Pi M.M (\ x -> (y : M.M) -> Id N.M (f (M.madd x y)) (N.madd (f x) (f y)))
     (\ x -> F.isProp-Pi M.M (\ y -> Id N.M (f (M.madd x y)) (N.madd (f x) (f y))) (\ y -> N.setM _ _)))
    (\ h -> F.isProp-Pi R.R (\ a -> (x : M.M) -> Id N.M (f (M.sm a x)) (N.sm a (f x)))
     (\ a -> F.isProp-Pi M.M (\ x -> Id N.M (f (M.sm a x)) (N.sm a (f x))) (\ x -> N.setM _ _))) ;
  zero : Linear (\ m -> N.mz) = (\ x y -> sym (N.maddZ N.mz),\ a x -> sym (MN.sm-zr a)) ;
  add (f g : Maps.M) (hf : Linear f) (hg : Linear g) : Linear (\ m -> N.madd (f m) (g m)) =
   (\ x y -> trans (cong2 N.M N.madd _ _ _ _ (hf.1 x y) (hg.1 x y)) (MN.swap4 (f x) (f y) (g x) (g y)),
    \ a x -> trans (cong2 N.M N.madd _ _ _ _ (hf.2 a x) (hg.2 a x)) (sym (N.smD a (f x) (g x)))) ;
  neg (f : Maps.M) (hf : Linear f) : Linear (\ m -> N.mneg (f m)) =
   (\ x y -> trans (ap N.mneg (hf.1 x y)) (MN.neg-add (f x) (f y)),
    \ a x -> trans (ap N.mneg (hf.2 a x)) (sym (MN.sm-neg a (f x)))) ;
  scale (c : R.R) (f : Maps.M) (hf : Linear f) : Linear (\ m -> N.sm c (f m)) =
   (\ x y -> trans (ap (N.sm c) (hf.1 x y)) (N.smD c (f x) (f y)),
    \ a x -> trans (ap (N.sm c) (hf.2 a x)) (MN.sm-swap c a (f x))) ;
  sub : DescentSubmodules[l].Submodule[MD.ring,Maps] = new DescentSubmodules[l].Submodule[MD.ring,Maps,Linear,linear-prop,
   zero,\ f g hf hg -> add f g hf hg,\ f hf -> neg f hf,\ c f hf -> scale c f hf] ;
  module S = SM.Sub[Maps,sub] ;
  carrier : MD.Module = S.carrier ;
  -- a linear map, applied
  apply (f : S.E) (m : M.M) : N.M = f.1 m ;
  -- two linear maps agreeing everywhere are equal
  ext (f g : S.E) (h : (m : M.M) -> Id N.M (f.1 m) (g.1 m)) : Id S.E f g =
   S.eq f g (F.funext M.M (\ m -> N.M) f.1 g.1 h) ;
 } ;
} ;
