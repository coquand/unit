level l ; open Ring[l] ; open Presentations[l] ;
module CB = CoefficientBound[l] ;
le-refl : (n : Nat) -> CB.le n n = split { zero -> tt ; suc n | ih -> ih } ;
le-step : (m n : Nat) -> CB.le m n -> CB.le m (suc n) = split {
 zero -> \ n h -> tt ;
 suc m | ih -> split { zero -> \ h -> efq h ; suc n -> \ h -> ih n h } } ;
le-trans : (m n p : Nat) -> CB.le m n -> CB.le n p -> CB.le m p = split {
 zero -> \ n p h k -> tt ;
 suc m | ih -> split {
  zero -> \ p h k -> efq h ;
  suc n -> split { zero -> \ h k -> efq k ; suc p -> \ h k -> ih n p h k } } } ;
le-left : (m n : Nat) -> CB.le m (plus m n) = split {
 zero -> \ n -> tt ; suc m | ih -> \ n -> ih n } ;
le-right : (m n : Nat) -> CB.le n (plus m n) = split {
 zero -> \ n -> le-refl n ; suc m | ih -> \ n -> le-step n (plus m n) (ih n) } ;
bound : (n : Nat) -> (Fin n -> Nat) -> Nat = split {
 zero -> \ ns -> zero ; suc n | ih -> \ ns -> plus (ns (inr tt)) (ih (\ i -> ns (inl i))) } ;
bounded : (n : Nat) (ns : Fin n -> Nat) -> (i : Fin n) -> CB.le (ns i) (bound n ns) = split {
 zero -> \ ns -> AffineFinite[l].empty-section (\ i -> CB.le (ns i) (bound zero ns)) ;
 suc n | ih -> \ ns -> AffineFinite[l].section n (\ i -> CB.le (ns i) (bound (suc n) ns))
  (\ i -> le-trans (ns (inl i)) (bound n (\ i -> ns (inl i))) (bound (suc n) ns)
   (ih (\ i -> ns (inl i)) i) (le-right (ns (inr tt)) (bound n (\ i -> ns (inl i)))))
  (le-left (ns (inr tt)) (bound n (\ i -> ns (inl i)))) } ;
