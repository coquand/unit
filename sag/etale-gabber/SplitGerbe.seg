-- The splitting gerbe of an Azumaya algebra (H^2 bridges, A3).  E an
-- algebra whose carrier is a sheaf, locally M_N (N = n+1); Split(E) =
-- SPLITOBJECTS.Obj (modules merely free of rank N with E = End M).
--  (paths)    Arrows between splittings form a sheaf: the carrier of a module
--             merely free is a sheaf (BASISFRAMES, ETALEMODAL.Mere), and arrows
--             are linear maps with propositions built from identities in it;
--             being an equivalence is a retract of its data (sec, ret and
--             their laws).  Paths are arrows (SPLITSIP), so paths are sheaves.
--  (inh)      R^N with its standard basis is a splitting of End(R^N) = M_N
--             (BASISEND), hence of E wherever E ~ M_N.
--  (conn)     Any two splittings are merely isomorphic (SPLITCONNECTED, Skolem-Noether).
--  (band)     SPLITBAND, read on the small model (SPLITSMALL).
--  (stack)    Descent for objects.  A family f : G_i -> Split(E) over a
--             generator G_i (a proposition) glues to the product
--                 M = Pi (g : G_i) (f g).1,   sigma(s)(m)(g) = sigma_g(s)(m g).
--             Evaluation at g : G_i is a linear bijection M ~ (f g).1 carrying
--             sigma to sigma_g (G_i is a proposition), so M has a basis
--             locally, hence merely (DESCENTTHEOREMD, M being a sheaf), sigma is
--             an equivalence locally, hence globally (a sheaf proposition),
--             and the glued object restricts to f.  For a constant family the
--             constant map o.1 -> Pi (g : G_i) o.1 is an equivalence (o.1 is a
--             sheaf) carrying sigma to the glued splitting: gluing f = const o
--             gives o back.
-- The StackGerbe is carried by the small model Small ~ Obj of SPLITSMALL
-- (replacement): gpd, paths (a retract of the arrows), inh, conn as above,
-- and the stack condition through the equivalence j.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module MS = ModuleSIP2[l].Over[MD.ring] ;
 module HM = HomModule[l].Over[R,setR] ;
 module EN = ModuleEnd[l].Over[R,setR] ;
 module AS = AlgSIP[l].Over[R,setR] ;
 module AU = AlgSIPUA[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module SH = SheafLemmas[l,l+].Over[ET.I,ET.G] ;
 module EM = EtaleModal[l,l].Over[ET.I,ET.G] ;
 module BF = BasisFrames[l].Over[R,setR,axioms] ;
 module SO0 = SplitObjects[l].Over[R,setR,axioms] ;
 -- being an equivalence between sheaves is a sheaf
 module EquivSheaf (A B : U l) (setB : Pr.isSet B) (f : A -> B) {
 module EP = AffineHLevels[l].EquivalenceProofs[A,B,setB,f] ;
 theorem (hA : ET.T.isModal @l A) (hB : ET.T.isModal @l B) : ET.T.isModal @l (Pr.isEquiv A B f) =
  SL.modal-retract EP.Data (Pr.isEquiv A B f) EP.encode EP.decode (\ e -> sym (EP.eta e))
   (SL.modal-Sigma EP.Pair EP.Laws
     (SL.modal-Sigma (B -> A) (\ s -> B -> A) (SL.modal-Pi B (\ b -> A) (\ b -> hA)) (\ s -> SL.modal-Pi B (\ b -> A) (\ b -> hA)))
     (\ p -> SL.modal-Sigma ((b : B) -> Id B (f (p.1 b)) b) (\ h -> (a : A) -> Id A (p.2 (f a)) a)
       (SL.modal-Pi B (\ b -> Id B (f (p.1 b)) b) (\ b -> SL.modal-Id B hB _ _))
       (\ h -> SL.modal-Pi A (\ a -> Id A (p.2 (f a)) a) (\ a -> SL.modal-Id A hA _ _)))) ;
 } ;
 -- linear maps between sheaf modules form a sheaf
 lin-sheaf (M M' : MD.Module) (hM' : ET.T.isModal @l M'.M) : ET.T.isModal @l HM.At[M,M'].S.E =
  SL.modal-Sigma ((m : M.M) -> M'.M) HM.At[M,M'].Linear (SL.modal-Pi M.M (\ m -> M'.M) (\ m -> hM')) (\ f ->
   SL.modal-Sigma (HM.At[M,M'].Additive f) (\ h -> HM.At[M,M'].Scalar f)
    (SL.modal-Pi M.M (\ x -> (y : M.M) -> Id M'.M (f (M.madd x y)) (M'.madd (f x) (f y))) (\ x ->
      SL.modal-Pi M.M (\ y -> Id M'.M (f (M.madd x y)) (M'.madd (f x) (f y))) (\ y -> SL.modal-Id M'.M hM' _ _)))
    (\ h -> SL.modal-Pi R.R (\ a -> (x : M.M) -> Id M'.M (f (M.sm a x)) (M'.sm a (f x))) (\ a ->
      SL.modal-Pi M.M (\ x -> Id M'.M (f (M.sm a x)) (M'.sm a (f x))) (\ x -> SL.modal-Id M'.M hM' _ _)))) ;
 module SG = StackGerbes[l].Over[R,setR,axioms,sh] ;
 module At (n : Nat) (E : EN.NA.Algebra) {
  N : Nat = suc n ;
  module SO = SO0.At[N,E] ;
  module SS = SplitSIP[l].Over[R,setR,axioms].At[N,E] ;
  -- (paths)
  carrier-sheaf (o : SO.Obj) : ET.T.isModal @l (SO.carrier o).M =
   EM.Mere[(SO.carrier o).M,(SO.carrier o).setM,
    Tr.Trunc[LF.Basis[SO.carrier o,N]].induction @l (\ b -> Tr.Trunc[ET.T.isModal @l (SO.carrier o).M].carrier)
     (\ b -> Tr.Trunc[ET.T.isModal @l (SO.carrier o).M].proposition)
     (\ b -> Tr.Trunc[ET.T.isModal @l (SO.carrier o).M].inc BF.At[SO.carrier o,N].Of[b].sheaf) o.2.1].modal ;
  arrow-sheaf (o o' : SO.Obj) : ET.T.isModal @l (SO.Arrow o o') =
   SL.modal-Sigma (SO.Lin o o') (SO.Good o o') (lin-sheaf (SO.carrier o) (SO.carrier o') (carrier-sheaf o')) (\ a ->
    SL.modal-Sigma (Pr.isEquiv (SO.carrier o).M (SO.carrier o').M a.1)
     (\ b -> (s : E.A) (x : (SO.carrier o).M) -> Id (SO.carrier o').M (a.1 (SO.act o s x)) (SO.act o' s (a.1 x)))
     (EquivSheaf[(SO.carrier o).M,(SO.carrier o').M,(SO.carrier o').setM,a.1].theorem (carrier-sheaf o) (carrier-sheaf o'))
     (\ b -> SL.modal-Pi E.A (\ s -> (x : (SO.carrier o).M) -> Id (SO.carrier o').M (a.1 (SO.act o s x)) (SO.act o' s (a.1 x)))
       (\ s -> SL.modal-Pi (SO.carrier o).M (\ x -> Id (SO.carrier o').M (a.1 (SO.act o s x)) (SO.act o' s (a.1 x)))
        (\ x -> SL.modal-Id (SO.carrier o').M (carrier-sheaf o') _ _)))) ;
  paths (o o' : SO.Obj) : ET.T.isModal @(l+) (Id SO.Obj o o') =
   SH.modal-retract (SO.Arrow o o') (Id SO.Obj o o') (SS.to-arrow o o') (SS.to-path o o') (SS.Fd.sip-idToIso o o')
    (SG.up (SO.Arrow o o') (arrow-sheaf o o')) ;
  -- (stack)
  module Stack (sheafE : ET.T.isModal @l E.A) {
   module Glue (i : ET.I) (f : ET.G i -> SO.Obj) {
    P : U l = ET.G i ;
    prop : Pr.isProp P = ET.G-prop i ;
    fib (g : P) : MD.Module = SO.carrier (f g) ;
    M : MD.Module = MD.pi P fib ;
    M-sheaf : ET.T.isModal @l M.M = SL.modal-Pi P (\ g -> (fib g).M) (\ g -> carrier-sheaf (f g)) ;
    -- evaluation at g is a linear bijection
    along (g g' : P) (p : Id P g g') (y : (fib g).M) : (fib g').M = Pr.subst P (\ h -> (fib h).M) g g' p y ;
    along-add (g g' : P) (p : Id P g g') (y y' : (fib g).M) :
     Id (fib g').M (along g g' p ((fib g).madd y y')) ((fib g').madd (along g g' p y) (along g g' p y')) =
     idJ P g (\ h q -> Id (fib h).M (along g h q ((fib g).madd y y')) ((fib h).madd (along g h q y) (along g h q y')))
      (refl ((fib g).madd y y')) g' p ;
    along-scale (g g' : P) (p : Id P g g') (a : R.R) (y : (fib g).M) :
     Id (fib g').M (along g g' p ((fib g).sm a y)) ((fib g').sm a (along g g' p y)) =
     idJ P g (\ h q -> Id (fib h).M (along g h q ((fib g).sm a y)) ((fib h).sm a (along g h q y))) (refl ((fib g).sm a y)) g' p ;
    along-section (m : M.M) (g g' : P) (p : Id P g g') : Id (fib g').M (along g g' p (m g)) (m g') =
     idJ P g (\ h q -> Id (fib h).M (along g h q (m g)) (m h)) (refl (m g)) g' p ;
    along-self (g : P) (y : (fib g).M) : Id (fib g).M (along g g (prop g g) y) y =
     ap (\ q -> along g g q y) (Pr.prop-to-set P prop g g (prop g g) (refl g)) ;
    ev (g : P) (m : M.M) : (fib g).M = m g ;
    spread (g : P) (y : (fib g).M) : M.M = \ h -> along g h (prop g h) y ;
    ev-equiv (g : P) : Pr.isEquiv M.M (fib g).M (ev g) =
     Pr.qinv M.M (fib g).M (ev g) (spread g) (along-self g)
      (\ m -> F.funext P (\ h -> (fib h).M) _ m (\ h -> along-section m g h (prop g h))) ;
    -- the glued splitting
    sg (g : P) (s : E.A) : HM.At[fib g,fib g].S.E = (f g).2.2.1.1 s ;
    pointwise (h h' : HM.At[M,M].S.E) (e : (x : M.M) (g : P) -> Id (fib g).M (h.1 x g) (h'.1 x g)) :
     Id HM.At[M,M].S.E h h' = HM.At[M,M].ext h h' (\ x -> F.funext P (\ g -> (fib g).M) _ _ (e x)) ;
    sigma (s : E.A) : HM.At[M,M].S.E =
     (\ m g -> (sg g s).1 (m g),
      \ x y -> F.funext P (\ g -> (fib g).M) _ _ (\ g -> (sg g s).2.1 (x g) (y g)),
      \ a x -> F.funext P (\ g -> (fib g).M) _ _ (\ g -> (sg g s).2.2 a (x g))) ;
    hom : AS.Hom E EN.At[M].algebra sigma =
     (\ s t -> pointwise _ _ (\ x g -> ap (\ k -> k.1 (x g)) ((f g).2.2.2.1 s t)),
      \ a s -> pointwise _ _ (\ x g -> ap (\ k -> k.1 (x g)) ((f g).2.2.2.2.1 a s)),
      \ s t -> pointwise _ _ (\ x g -> ap (\ k -> k.1 (x g)) ((f g).2.2.2.2.2.1 s t)),
      pointwise _ _ (\ x g -> ap (\ k -> k.1 (x g)) ((f g).2.2.2.2.2.2))) ;
    -- at g0 the glued splitting is the one of f g0, so an equivalence
    module Near (g0 : P) {
     s0 : AS.AlgIso E EN.At[fib g0].algebra = (f g0).2.2 ;
     conj (h : HM.At[M,M].S.E) : HM.At[fib g0,fib g0].S.E =
      (\ y -> h.1 (spread g0 y) g0,
       \ y y' -> trans (Pr.ap M.M (fib g0).M (\ m -> h.1 m g0) (spread g0 ((fib g0).madd y y')) (M.madd (spread g0 y) (spread g0 y')) (F.funext P (\ k -> (fib k).M) _ _ (\ k -> along-add g0 k (prop g0 k) y y')))
        (ap (\ m -> m g0) (h.2.1 (spread g0 y) (spread g0 y'))),
       \ a y -> trans (Pr.ap M.M (fib g0).M (\ m -> h.1 m g0) (spread g0 ((fib g0).sm a y)) (M.sm a (spread g0 y)) (F.funext P (\ k -> (fib k).M) _ _ (\ k -> along-scale g0 k (prop g0 k) a y)))
        (ap (\ m -> m g0) (h.2.2 a (spread g0 y)))) ;
     back (h : HM.At[M,M].S.E) : E.A = s0.1.2.sec (conj h) ;
     at-g0 (h : HM.At[M,M].S.E) (x : M.M) : Id (fib g0).M ((sigma (back h)).1 x g0) (h.1 x g0) =
      trans (ap (\ k -> k.1 (x g0)) (s0.1.2.sec-eq (conj h))) (ap (\ m -> h.1 m g0) ((ev-equiv g0).ret-eq x)) ;
     sec-eq (h : HM.At[M,M].S.E) : Id HM.At[M,M].S.E (sigma (back h)) h =
      pointwise _ _ (\ x g -> idJ P g0 (\ k q -> Id (fib k).M ((sigma (back h)).1 x k) (h.1 x k)) (at-g0 h x) g (prop g0 g)) ;
     conj-sigma (s : E.A) : Id HM.At[fib g0,fib g0].S.E (conj (sigma s)) (s0.1.1 s) =
      HM.At[fib g0,fib g0].ext _ _ (\ y -> ap ((sg g0 s).1) (along-self g0 y)) ;
     ret-eq (s : E.A) : Id E.A (back (sigma s)) s =
      trans (ap s0.1.2.sec (conj-sigma s)) (Pr.sec-ret E.A HM.At[fib g0,fib g0].S.E s0.1.1 s0.1.2 s) ;
     equiv : Pr.isEquiv E.A HM.At[M,M].S.E sigma = Pr.qinv E.A HM.At[M,M].S.E sigma back sec-eq ret-eq ;
    } ;
    sigma-equiv : Pr.isEquiv E.A HM.At[M,M].S.E sigma =
     ((EquivSheaf[E.A,HM.At[M,M].S.E,HM.At[M,M].carrier.setM,sigma].theorem sheafE (lin-sheaf M M M-sheaf)) i).sec
      (\ g0 -> Near[g0].equiv) ;
    -- the basis: locally that of f g0, hence merely (Theorem D)
    lin-ev (g : P) : MS.LinEquiv M (fib g) = ((ev g,ev-equiv g),\ x y -> refl ((fib g).madd (x g) (y g)),\ a x -> refl ((fib g).sm a (x g))) ;
    near-basis (g : P) : Tr.Trunc[LF.Basis[M,N]].carrier =
     Tr.Trunc[LF.Basis[fib g,N]].induction @l (\ t -> Tr.Trunc[LF.Basis[M,N]].carrier) (\ t -> Tr.Trunc[LF.Basis[M,N]].proposition)
      (\ b -> Tr.Trunc[LF.Basis[M,N]].inc
        (StandardBases[l].Over[R,setR,axioms].move (fib g) M (Hi.sym MD.Module M (fib g) (MS.sip M (fib g) (lin-ev g))) N b))
      (f g).2.1 ;
    local-frame : sh.close (DL.On[M].Frame N) =
     ((sh.modal (DL.On[M].Frame N)) i).sec (\ g ->
      Tr.Trunc[LF.Basis[M,N]].induction @l (\ t -> sh.close (DL.On[M].Frame N)) (\ t -> sh.proposition (DL.On[M].Frame N))
       (\ b -> sh.inc (DL.On[M].Frame N) BF.At[M,N].Of[b].frame) (near-basis g)) ;
    basis : Tr.Trunc[LF.Basis[M,N]].carrier =
     Tr.Trunc[DL.On[M].Frame N].induction @l (\ t -> Tr.Trunc[LF.Basis[M,N]].carrier) (\ t -> Tr.Trunc[LF.Basis[M,N]].proposition)
      (\ w -> Tr.Trunc[LF.Basis[M,N]].inc BF.At[M,N].OfFrame[w].basis)
      DescentTheoremD[l].Over[R,setR,axioms,sh].At[M,M-sheaf,N,local-frame].theorem ;
    glued : SO.Obj = (M,basis,(sigma,sigma-equiv),hom) ;
    restrict (g : P) : SO.Arrow glued (f g) =
     (((ev g),\ x y -> refl ((fib g).madd (x g) (y g)),\ a x -> refl ((fib g).sm a (x g))),ev-equiv g,
      \ s x -> refl (SO.act (f g) s (x g))) ;
    restricts : Id (P -> SO.Obj) (\ g -> glued) f =
     Axioms[l+].FunExtLemmas[fe @(l+)].funext P (\ g -> SO.Obj) (\ g -> glued) f (\ g -> SS.to-path glued (f g) (restrict g)) ;
   } ;
   -- gluing a constant family gives the object back
   module Constant (i : ET.I) (o : SO.Obj) {
    module Gl = Glue[i,\ g -> o] ;
    const-arrow : SO.Arrow o Gl.glued =
     ((\ x g -> x,\ x y -> refl (\ g -> (SO.carrier o).madd x y),\ a x -> refl (\ g -> (SO.carrier o).sm a x)),
      carrier-sheaf o i,\ s x -> refl (\ g -> SO.act o s x)) ;
    back : Id SO.Obj Gl.glued o = Hi.sym SO.Obj o Gl.glued (SS.to-path o Gl.glued const-arrow) ;
   } ;
   stack : ET.T.isModal @(l+) SO.Obj = \ i ->
    Hi.qinv SO.Obj (ET.G i -> SO.Obj) (\ x g -> x) (\ f -> Glue[i,f].glued) (\ f -> Glue[i,f].restricts) (\ o -> Constant[i,o].back) ;
  } ;
 } ;
 -- the splitting gerbe of an Azumaya algebra, on the small model (SPLITSMALL)
 module DA = DescendedAzumaya[l].Over[R,setR,axioms,sh] ;
 module OfAzumaya (n : Nat) (Az : DA.Azumaya MnAlgebra[l].Over[R,setR,suc n].algebra) {
  E : EN.NA.Algebra = Az.1 ;
  module A = At[n,E] ;
  module SM = SplitSmall[l].Over[R,setR,axioms].At[n,E] ;
  module MT = MnAlgebra[l].Over[R,setR,suc n] ;
  X : U l = SM.Small ;
  Obj : U l+ = A.SO.Obj ;
  -- (gpd)
  gpd (a b : X) : Pr.isSet (Id X a b) =
   AffineHLevels[l+].set-from-equiv (Id X a b) (Id Obj (SM.j a) (SM.j b)) (A.SS.paths-set (SM.j a) (SM.j b))
    (Hi.ap X Obj SM.j a b) (SM.emb a b) ;
  -- (inh) E ~ M_N = End(R^N) gives a splitting of E on R^N
  standard (e : AS.AlgIso E MT.algebra) : SM.D =
   AU.idToIso E EN.At[SM.ST.V].algebra (Hi.trans EN.NA.Algebra E MT.algebra EN.At[SM.ST.V].algebra (AU.sip E MT.algebra e)
     (Hi.sym EN.NA.Algebra EN.At[SM.ST.V].algebra MT.algebra (AU.sip EN.At[SM.ST.V].algebra MT.algebra SM.ST.BE.iso))) ;
  inh : sh.close X =
   sh.elim @l (AS.AlgIso E MT.algebra) (sh.close X) (sh.proposition X) (sh.modal X)
    (\ e -> sh.inc X (SM.image.quotient (standard e))) Az.2.2 ;
  -- (conn)
  to-path (a b : X) (r : A.SO.Arrow (SM.j a) (SM.j b)) : Id X a b = (SM.emb a b).sec (A.SS.to-path (SM.j a) (SM.j b) r) ;
  conn (a b : X) : sh.close (Id X a b) =
   Tr.Trunc[A.SO.Arrow (SM.j a) (SM.j b)].induction @l (\ t -> sh.close (Id X a b)) (\ t -> sh.proposition (Id X a b))
    (\ r -> sh.inc (Id X a b) (to-path a b r)) (SplitConnected[l].Over[R,setR,axioms].At[n,E].connected (SM.j a) (SM.j b)) ;
  -- (paths) a retract of the arrows
  to-arrow (a b : X) (p : Id X a b) : A.SO.Arrow (SM.j a) (SM.j b) = A.SS.to-arrow (SM.j a) (SM.j b) (Hi.ap X Obj SM.j a b p) ;
  retract (a b : X) (p : Id X a b) : Id (Id X a b) (to-path a b (to-arrow a b p)) p =
   Hi.trans (Id X a b) (to-path a b (to-arrow a b p)) ((SM.emb a b).sec (Hi.ap X Obj SM.j a b p)) p
    (Hi.ap (Id Obj (SM.j a) (SM.j b)) (Id X a b) (SM.emb a b).sec _ _ (A.SS.Fd.sip-idToIso (SM.j a) (SM.j b) (Hi.ap X Obj SM.j a b p)))
    (Hi.sec-ret (Id X a b) (Id Obj (SM.j a) (SM.j b)) (Hi.ap X Obj SM.j a b) (SM.emb a b) p) ;
  paths (a b : X) : ET.T.isModal @l (Id X a b) =
   SL.modal-retract (A.SO.Arrow (SM.j a) (SM.j b)) (Id X a b) (to-arrow a b) (to-path a b) (retract a b) (A.arrow-sheaf (SM.j a) (SM.j b)) ;
  -- (stack) through the equivalence j
  module Stack (i : ET.I) {
   P : U l = ET.G i ;
   obj : Hi.isEquiv Obj (P -> Obj) (\ o g -> o) = A.Stack[Az.2.1].stack i ;
   back (f : P -> X) : X = SM.inv (obj.sec (\ g -> SM.j (f g))) ;
   at (f : P -> X) (g : P) : Id X (back f) (f g) =
    Hi.trans X (back f) (SM.inv (SM.j (f g))) (f g)
     (Hi.ap Obj X SM.inv _ _ (Hi.ap (P -> Obj) Obj (\ h -> h g) _ _ (obj.sec-eq (\ g2 -> SM.j (f g2)))))
     (SM.inv-j (f g)) ;
   constant (a : X) : Id X (back (\ g -> a)) a =
    Hi.trans X (back (\ g -> a)) (SM.inv (SM.j a)) a
     (Hi.ap Obj X SM.inv _ _ (Hi.sec-ret Obj (P -> Obj) (\ o g -> o) obj (SM.j a))) (SM.inv-j a) ;
   equiv : Pr.isEquiv X (P -> X) (\ a g -> a) =
    Pr.qinv X (P -> X) (\ a g -> a) back (\ f -> F.funext P (\ g -> X) (\ g -> back f) f (at f)) constant ;
  } ;
  gerbe : SG.StackGerbe = (X,SM.band,gpd,inh,conn,paths,\ i -> Stack[i].equiv) ;
 } ;
} ;
