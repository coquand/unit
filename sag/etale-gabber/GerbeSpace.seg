-- The R^x-gerbes form K(R^x, 2) (HANDOFF-K2-COMPARISON, K0).
-- K = GERBE.AGerbe, the R^x-banded gerbes (1-types, merely inhabited, merely
-- connected, with a band); T = TRIVIALGERBE.KG, the trivial gerbe (the small
-- model of the R^x-torsors), with its point k0.
--  (eq)        A band-preserving equivalence e : G.1 ~ G'.1 gives G = G'.  By
--              equivalence induction e = id; then the bands agree (ap id = id)
--              and the rest is a proposition (as STACKGERBES.Eq).
--  (pointed)   If moreover e g = g', then (G, g) = (G', g') as pointed gerbes:
--              in the case e = id the structures and the points are equal.
--  (connected) Any G is merely equal to T: being merely equal is a
--              proposition, so take a point g of G; then y |-> (g = y) is a
--              band-preserving equivalence G ~ T (TRIVIALISE, with L = 1),
--              which is all that (eq) asks.
--  (centre)    The pointed gerbes (G : K) * G.1 form a contractible type with
--              centre (T, k0): the same equivalence sends g to k0
--              (TRIVIALISE.qpt), so (G, g) = (T, k0) by (pointed).
--  (loops)     By the fundamental theorem of identity types (Based, for any
--              family P over A with (b : A) * P b contractible at (a, p0),
--              transport of p0 is an equivalence (a = b) ~ P b), the paths
--              T = G are the points of G.  At G = T: (T = T) ~ T.1, and
--              T.1 ~ Tor (the inclusion of the small model has contractible
--              fibres, TRIVIALGERBE.iota-fib).  So the loop space of K at T is
--              the type of R^x-torsors.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module E1 = FunExtUA[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
-- the fundamental theorem of identity types, at one point
module Based (A : U l+) (P : A -> U l+) (a : A) (p0 : P a) (c : E1.isContr ((b : A) * P b)) {
 tr (b : A) (q : Id A a b) : P b = Hi.subst A P a b q p0 ;
 back (b : A) (x : P b) : Id A a b = Hi.ap ((b2 : A) * P b2) A (\ w -> w.1) (a,p0) (b,x) (E1.pathC ((b2 : A) * P b2) c (a,p0) (b,x)) ;
 tr-ap (w : (b : A) * P b) (pi : Id ((b : A) * P b) (a,p0) w) : Id (P w.1) (tr w.1 (Hi.ap ((b : A) * P b) A (\ v -> v.1) (a,p0) w pi)) w.2 =
  idJ ((b : A) * P b) (a,p0) (\ v pv -> Id (P v.1) (tr v.1 (Hi.ap ((b : A) * P b) A (\ u -> u.1) (a,p0) v pv)) v.2) (refl p0) w pi ;
 tr-back (b : A) (x : P b) : Id (P b) (tr b (back b x)) x = tr-ap (b,x) (E1.pathC ((b2 : A) * P b2) c (a,p0) (b,x)) ;
 back-tr (b : A) (q : Id A a b) : Id (Id A a b) (back b (tr b q)) q =
  idJ A a (\ b2 q2 -> Id (Id A a b2) (back b2 (tr b2 q2)) q2)
   (Hi.ap (Id ((b2 : A) * P b2) (a,p0) (a,p0)) (Id A a a) (\ pi -> Hi.ap ((b2 : A) * P b2) A (\ w -> w.1) (a,p0) (a,p0) pi)
     (E1.pathC ((b2 : A) * P b2) c (a,p0) (a,p0)) (refl (a,p0)) (E1.pathC-refl ((b2 : A) * P b2) c (a,p0))) b q ;
 equiv (b : A) : Hi.Equiv (Id A a b) (P b) = (tr b,Hi.qinv (Id A a b) (P b) (tr b) (back b) (tr-back b) (back-tr b)) ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module SG = StackGerbes[l].Over[R,setR,axioms,sh] ;
 module UG = SG.UG ;
 module GB = SG.GB ;
 module TV = TrivialGerbe[l].TrivG[UG.group] ;
 module TI = TorsorId[l].TorId[UG.group] ;
 -- accessors
 gpd (G : GB.AGerbe) : (a b : G.1) -> Pr.isSet (Id G.1 a b) = G.2.1 ;
 inh (G : GB.AGerbe) : Tr.Trunc[G.1].carrier = G.2.2.1 ;
 conn (G : GB.AGerbe) : (a b : G.1) -> Tr.Trunc[Id G.1 a b].carrier = G.2.2.2.1 ;
 band (G : GB.AGerbe) (x : G.1) : GB.Band G.1 x = G.2.2.2.2 x ;
 bnd (G : GB.AGerbe) (x : G.1) (lp : Id G.1 x x) : UG.Unit = GB.GL[G].bnd x lp ;
 -- the structure on a carrier: the bands, and the propositions
 Str (X : U l) : U l =
  ((a b : X) -> Pr.isSet (Id X a b)) * Tr.Trunc[X].carrier * ((a b : X) -> Tr.Trunc[Id X a b].carrier) * ((x : X) -> GB.Band X x) ;
 Bands (X : U l) : U l = (x : X) -> GB.Band X x ;
 Props (X : U l) : U l = ((a b : X) -> Pr.isSet (Id X a b)) * Tr.Trunc[X].carrier * ((a b : X) -> Tr.Trunc[Id X a b].carrier) ;
 bands (X : U l) (s : Str X) : Bands X = s.2.2.2 ;
 props (X : U l) (s : Str X) : Props X = (s.1,s.2.1,s.2.2.1) ;
 assemble (X : U l) (w : Bands X * Props X) : Str X = (w.2.1,w.2.2.1,w.2.2.2,w.1) ;
 -- by definition, a structure is assembled from its bands and propositions
 assemble-parts (X : U l) (s : Str X) : Id (Str X) (assemble X (bands X s,props X s)) s = refl s ;
 props-prop (X : U l) : Pr.isProp (Props X) =
  Pr.isProp-Sigma ((a b : X) -> Pr.isSet (Id X a b)) (\ h -> Tr.Trunc[X].carrier * ((a b : X) -> Tr.Trunc[Id X a b].carrier))
   (F.isProp-Pi X (\ a -> (b : X) -> Pr.isSet (Id X a b)) (\ a -> F.isProp-Pi X (\ b -> Pr.isSet (Id X a b)) (\ b ->
     AffineHLevels[l].set-prop (Id X a b)))) (\ h ->
  Pr.isProp-Sigma Tr.Trunc[X].carrier (\ h1 -> (a b : X) -> Tr.Trunc[Id X a b].carrier) Tr.Trunc[X].proposition (\ h1 ->
   F.isProp-Pi X (\ a -> (b : X) -> Tr.Trunc[Id X a b].carrier) (\ a ->
    F.isProp-Pi X (\ b -> Tr.Trunc[Id X a b].carrier) (\ b -> Tr.Trunc[Id X a b].proposition)))) ;
 -- band-preserving maps
 Preserves (G G' : GB.AGerbe) (e : G.1 -> G'.1) : U l =
  (x : G.1) (lp : Id G.1 x x) -> Id UG.Unit (bnd G' (e x) (Pr.ap G.1 G'.1 e x x lp)) (bnd G x lp) ;
 -- (eq)
 module Eq (G : GB.AGerbe) {
  -- the bands of G and of s' agree at each x, given that the identity preserves them
  band-eq (s' : Str G.1) (pres : Preserves G (G.1,s') (\ a -> a)) (x : G.1) : Id (GB.Band G.1 x) (band G x) (bands G.1 s' x) =
   Pr.Sigma-eq (Id G.1 x x -> UG.Unit) (\ b -> SG.Rest G.1 x b) (band G x).1 (bands G.1 s' x).1 (band G x).2 (bands G.1 s' x).2
    (F.funext (Id G.1 x x) (\ lp -> UG.Unit) (band G x).1 (bands G.1 s' x).1 (\ lp ->
      Pr.trans UG.Unit (bnd G x lp) (bnd (G.1,s') x (Pr.ap G.1 G.1 (\ a -> a) x x lp)) ((bands G.1 s' x).1 lp)
       (Pr.sym UG.Unit (bnd (G.1,s') x (Pr.ap G.1 G.1 (\ a -> a) x x lp)) (bnd G x lp) (pres x lp))
       (Pr.ap (Id G.1 x x) UG.Unit (bands G.1 s' x).1 (Pr.ap G.1 G.1 (\ a -> a) x x lp) lp (SG.ap-id G.1 x x lp))))
    (SG.rest-prop G.1 x (bands G.1 s' x).1) ;
  same-structure (s' : Str G.1) (pres : Preserves G (G.1,s') (\ a -> a)) : Id (Str G.1) G.2 s' =
   Pr.ap (Bands G.1 * Props G.1) (Str G.1) (assemble G.1) (bands G.1 G.2,props G.1 G.2) (bands G.1 s',props G.1 s')
    (Pr.Sigma-eq (Bands G.1) (\ b -> Props G.1) (bands G.1 G.2) (bands G.1 s') (props G.1 G.2) (props G.1 s')
      (F.funext G.1 (\ x -> GB.Band G.1 x) (bands G.1 G.2) (bands G.1 s') (band-eq s' pres))
      (props-prop G.1)) ;
  Mot (Y : U l) (e : Pr.Equiv G.1 Y) : U l+ = (s' : Str Y) (pres : Preserves G (Y,s') e.1) -> Id GB.AGerbe G (Y,s') ;
  base : Mot G.1 (Pr.idEquiv G.1) = \ s' pres -> Hi.ap (Str G.1) GB.AGerbe (\ t -> (G.1,t)) G.2 s' (same-structure s' pres) ;
  theorem (G' : GB.AGerbe) (e : Pr.Equiv G.1 G'.1) (pres : Preserves G G' e.1) : Id GB.AGerbe G G' =
   Axioms[l].UnivalenceLemmas[univ @l].eqind G.1 Mot base G'.1 e G'.2 pres ;
  -- the same, for a map with a proof that it is an equivalence
  by-map (G' : GB.AGerbe) (f : G.1 -> G'.1) (fe : Pr.isEquiv G.1 G'.1 f) (pres : Preserves G G' f) : Id GB.AGerbe G G' =
   theorem G' (f,fe) pres ;
 } ;
 -- (pointed)
 Pt : U l+ = (G : GB.AGerbe) * G.1 ;
 pair (A B : U l+) (a a' : A) (b b' : B) (p : Id A a a') (q : Id B b b') : Id (A * B) (a,b) (a',b') =
  idJ A a (\ a2 p2 -> Id (A * B) (a,b) (a2,b')) (idJ B b (\ b2 q2 -> Id (A * B) (a,b) (a,b2)) (refl (a,b)) b' q) a' p ;
 module PointedEq (G : GB.AGerbe) (g : G.1) {
  Mot (Y : U l) (e : Pr.Equiv G.1 Y) : U l+ =
   (s' : Str Y) (pres : Preserves G (Y,s') e.1) (g' : Y) (eg : Id Y (e.1 g) g') -> Id Pt (G,g) ((Y,s'),g') ;
  base : Mot G.1 (Pr.idEquiv G.1) = \ s' pres g' eg ->
   Hi.ap (Str G.1 * G.1) Pt (\ w -> ((G.1,w.1),w.2)) (G.2,g) (s',g') (pair (Str G.1) G.1 G.2 s' g g' (Eq[G].same-structure s' pres) eg) ;
  theorem (G' : GB.AGerbe) (e : Pr.Equiv G.1 G'.1) (pres : Preserves G G' e.1) (g' : G'.1) (eg : Id G'.1 (e.1 g) g') : Id Pt (G,g) (G',g') =
   Axioms[l].UnivalenceLemmas[univ @l].eqind G.1 Mot base G'.1 e G'.2 pres g' eg ;
  by-map (G' : GB.AGerbe) (f : G.1 -> G'.1) (fe : Pr.isEquiv G.1 G'.1 f) (pres : Preserves G G' f) (g' : G'.1) (eg : Id G'.1 (f g) g') :
   Id Pt (G,g) (G',g') = theorem G' (f,fe) pres g' eg ;
 } ;
 -- (connected), (centre): a pointed gerbe is the trivial one
 module Trivial (G : GB.AGerbe) (g : G.1) {
  module TR = Trivialise[l].Triv[UG.group,Top,(G,\ i -> g,\ i j -> refl g),tt] ;
  -- the map y |-> (g = y) of TRIVIALISE, an equivalence by GERBE.GE
  module E = GB.GE[G,TV.KG,TR.F,TR.Fbp] ;
  -- by definition, the band of T at k is kb k
  pres : Preserves G TV.KG TR.F = TR.Fbp ;
  to-T : Id GB.AGerbe G TV.KG = Eq[G].by-map TV.KG TR.F E.equiv.2 pres ;
  -- the map sends g to k0 (TRIVIALISE.qpt at the one index tt, where u tt = g)
  at-g : Id TV.K (TR.F g) TV.k0 = TR.qpt tt ;
  pointed : Id Pt (G,g) (TV.KG,TV.k0) = PointedEq[G,g].by-map TV.KG TR.F E.equiv.2 pres TV.k0 at-g ;
 } ;
 connected (G : GB.AGerbe) : Tr1.Trunc[Id GB.AGerbe TV.KG G].carrier =
  Tr.Trunc[G.1].induction @(l+) (\ t -> Tr1.Trunc[Id GB.AGerbe TV.KG G].carrier) (\ t -> Tr1.Trunc[Id GB.AGerbe TV.KG G].proposition)
   (\ g -> Tr1.Trunc[Id GB.AGerbe TV.KG G].inc (Hi.sym GB.AGerbe G TV.KG Trivial[G,g].to-T)) (inh G) ;
 centre : E1.isContr Pt = ((TV.KG,TV.k0),\ w -> Hi.sym Pt w (TV.KG,TV.k0) Trivial[w.1,w.2].pointed) ;
 -- (loops)
 module B = Based[GB.AGerbe,\ G -> G.1,TV.KG,TV.k0,centre] ;
 paths (G : GB.AGerbe) : Hi.Equiv (Id GB.AGerbe TV.KG G) G.1 = B.equiv G ;
 small-torsors : Hi.Equiv TV.K TI.Tor =
  (TV.iota,Hi.qinv TV.K TI.Tor TV.iota (\ Y -> (TV.iota-fib Y).1.1) (\ Y -> (TV.iota-fib Y).1.2)
   (\ k -> Hi.ap (TV.KFib (TV.iota k)) TV.K (\ w -> w.1) (TV.iota-fib (TV.iota k)).1 (k,refl (TV.iota k))
     ((TV.iota-fib (TV.iota k)).2 (k,refl (TV.iota k))))) ;
 loops : Hi.Equiv (Id GB.AGerbe TV.KG TV.KG) TI.Tor = Equivalences[l+].compose (Id GB.AGerbe TV.KG TV.KG) TV.K TI.Tor (paths TV.KG) small-torsors ;
 #fails {
  -- a loop at T moves the base point: loops are torsors, not all trivial
  loop-trivial (p : Id GB.AGerbe TV.KG TV.KG) : Id TV.K (B.tr TV.KG p) TV.k0 = refl TV.k0 ;
 } ;
} ;
