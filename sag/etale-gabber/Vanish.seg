-- Vanish.seg: sections versus vanishing classes.  For a single torsor or
-- gerbe (then pointwise for families, in Cech.seg):
--   a torsor Y has an element  iff  Y = A (the trivial torsor);
--   a gerbe G has an object    iff  G = K (the trivial gerbe).
-- The gerbe case is the trivialisation of Trivialise.seg with one point,
-- and the structure identity of Sip2.seg with no points.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Torsor[l] ;
open TorsorId[l] ;
open Gerbe[l] ;
open Cocycle2[l] ;
open TrivialGerbe[l] ;
open Trivialise[l] ;
open Sip2[l] ;
module P1 = Prelude[l+] ;

empty-pi (P : Empty -> U l) : (i : Empty) -> P i = split { } ;

module VanPt (Gr : Ab) {
  open Gr ;
  open TorBase[Gr] ;
  open TorId[Gr] ;
  open Gerbes[Gr] ;
  open TrivG[Gr] ;

  tors-triv (Y : Tor) (y0 : Y.1) : Id Tor Atriv Y = decode Atriv Y (pthom Y y0) ;
  tors-sec (Y : Tor) (P : Id Tor Atriv Y) : Y.1 = (idtohom Atriv Y P).1 o ;

  gerbe-sec (Gb : AGerbe) (P : Id AGerbe KG Gb) : Gb.1 = P1.subst AGerbe (\ g -> g.1) KG Gb P k0 ;

  -- a gerbe with an object is trivial
  module GT (Gb : AGerbe) (s : Gb.1) {
    w1 : Coc2[Gr, Top].Left2 = (Gb, \ t -> s, \ t t' -> refl s) ;
    module TV = Triv[Gr, Top, w1, tt] ;
    module S0 = SipG[Gr, Empty] ;
    eu (X : U l) : Empty -> X = empty-pi (\ i -> X) ;
    ep (X : U l) : S0.PP X (eu X) = empty-pi (\ i -> (j : Empty) -> Id X (eu X i) (eu X j)) ;
    path : Id (Coc2[Gr, Empty].Left2) ((Gb.1, Gb.2), eu Gb.1, ep Gb.1) ((K, KG.2), eu K, ep K) =
      S0.sip2 Gb.1 Gb.2 (eu Gb.1) (ep Gb.1) K TV.Feq KG.2 (eu K) (ep K) TV.Fbp
        (empty-pi (\ i -> Id K (TV.Feq.1 (eu Gb.1 i)) (eu K i)))
        (empty-pi (\ i -> (j : Empty) -> Id (Id K (TV.Feq.1 (eu Gb.1 i)) (eu K j))
                   (trans K (TV.Feq.1 (eu Gb.1 i)) (TV.Feq.1 (eu Gb.1 j)) (eu K j)
                      (ap Gb.1 K TV.Feq.1 (eu Gb.1 i) (eu Gb.1 j) (ep Gb.1 i j)) (empty-pi (\ i' -> Id K (TV.Feq.1 (eu Gb.1 i')) (eu K i')) j))
                   (trans K (TV.Feq.1 (eu Gb.1 i)) (eu K i) (eu K j) (empty-pi (\ i' -> Id K (TV.Feq.1 (eu Gb.1 i')) (eu K i')) i) (ep K i j)))) ;
    triv : Id AGerbe KG Gb =
      P1.sym AGerbe Gb KG
        (P1.ap (Coc2[Gr, Empty].Left2) AGerbe (\ v -> v.1) ((Gb.1, Gb.2), eu Gb.1, ep Gb.1) ((K, KG.2), eu K, ep K) path) ;
  } ;

  gerbe-triv (Gb : AGerbe) (s : Gb.1) : Id AGerbe KG Gb = GT[Gb, s].triv ;
} ;
