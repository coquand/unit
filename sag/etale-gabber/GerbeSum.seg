-- The sum of two stack gerbes (C3).  For charged types C, D the product
-- C x D carries w(P) = w_C(P.1) w_D(P.2) (P.1, P.2 the projections of a
-- loop P); it is merely connected (pairs of paths) and close-inhabited.
-- For stack gerbes G, H let K(G, H) be the line families of weight
-- beta x beta on G x H, and
--     G + H = D (K(G, H))         (GERBEOPS.dual).
--  (point)  At (s, t), Hom(Line(s = g)^v, Line(t = h)) is such a family:
--           the dual of the twisted line has weight beta^-1, the line weight
--           beta, transport in a family pulled back along a projection is
--           transport along the projected path (J), and Hom(V, W) has weight
--           w_W / w_V (TWISTEDMODULES.WeightsBy) = beta_G(P.1) beta_H(P.2); its
--           fibres have rank 1 x 1 (HOMBASES).
-- (D reverses the class: D G is lines of weight beta on G, and G |-> Line(s=-)
-- inverts the band (TWISTEDLINE); with the dual, + is the sum of classes.)
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 module BC = BandChange[l].Over[R,setR,axioms,sh] ;
 module BCG = BandChangeGerbe[l].Over[R,setR,axioms,loc,sh] ;
 module LG = LineGerbe[l].Over[R,setR,axioms,loc,sh] ;
 module GO = GerbeOps[l].Over[R,setR,axioms,loc,sh] ;
 module SG = GO.SG ;
 module TN = TwistedMain[l].Over[R,setR,axioms,loc] ;
 module HB = HomBases[l].Over[R,setR,axioms] ;
 -- the product of two charged types
 module Prod (C D : BC.Char) {
  A : U l = C.1.1 ;
  B : U l = D.1.1 ;
  X : U l = A * B ;
  pr1 (x x' : X) (P : Id X x x') : Id A x.1 x'.1 = Pr.ap X A (\ z -> z.1) x x' P ;
  pr2 (x x' : X) (P : Id X x x') : Id B x.2 x'.2 = Pr.ap X B (\ z -> z.2) x x' P ;
  w (x : X) (P : Id X x x) : UG.Unit = UG.times (C.1.2.2 x.1 (pr1 x x P)) (D.1.2.2 x.2 (pr2 x x P)) ;
  conn (x x' : X) : Tr.Trunc[Id X x x'].carrier =
   TruncationCombinators[l].map2 (Id A x.1 x'.1) (Id B x.2 x'.2) (Id X x x')
    (\ p q -> AffineHLevels[l].pair-path A B x.1 x'.1 x.2 x'.2 p q) (C.1.2.1 x.1 x'.1) (D.1.2.1 x.2 x'.2) ;
  inh : sh.close X =
   sh.elim @l A (sh.close X) (sh.proposition X) (sh.modal X)
    (\ a -> sh.elim @l B (sh.close X) (sh.proposition X) (sh.modal X) (\ b -> sh.inc X (a,b)) D.2) C.2 ;
  char : BC.Char = ((X,conn,w),inh) ;
  module T = TM.At[char.1] ;
  -- transport in a family pulled back along a projection
  move1 (V : A -> MD.Module) (x x' : X) (P : Id X x x') (m : (V x.1).M) :
   Id (V x'.1).M (T.Move[\ z -> V z.1].move x x' P m) (TM.At[C.1].Move[V].move x.1 x'.1 (pr1 x x' P) m) =
   idJ X x (\ z Q -> Id (V z.1).M (T.Move[\ y -> V y.1].move x z Q m) (TM.At[C.1].Move[V].move x.1 z.1 (pr1 x z Q) m)) (refl m) x' P ;
  move2 (V : B -> MD.Module) (x x' : X) (P : Id X x x') (m : (V x.2).M) :
   Id (V x'.2).M (T.Move[\ z -> V z.2].move x x' P m) (TM.At[D.1].Move[V].move x.2 x'.2 (pr2 x x' P) m) =
   idJ X x (\ z Q -> Id (V z.2).M (T.Move[\ y -> V y.2].move x z Q m) (TM.At[D.1].Move[V].move x.2 z.2 (pr2 x z Q) m)) (refl m) x' P ;
 } ;
 -- (point) for two stack gerbes
 module Pair (G H : SG.StackGerbe) {
  module PC = Prod[GO.char G,GO.char H] ;
  module At (x0 : PC.X) {
   module PG = BCG.Power[GO.tg G,zero].Point[x0.1] ;
   module LH = GO.Line[H,x0.2] ;
   V (x : PC.X) : MD.Module = PG.dual x.1 ;
   W (x : PC.X) : MD.Module = LH.TL.line x.2 ;
   om1 (x : PC.X) (P : Id PC.X x x) : UG.Unit = UG.times UG.one (UG.inverse (SG.bnd G x.1 (PC.pr1 x x P))) ;
   om2 (x : PC.X) (P : Id PC.X x x) : UG.Unit = SG.bnd H x.2 (PC.pr2 x x P) ;
   wv : PC.T.WeightBy om1 V = \ x P m -> trans (PC.move1 PG.dual x x P m) (PG.DP.weight (suc zero) x.1 (PC.pr1 x x P) m) ;
   ww : PC.T.WeightBy om2 W = \ x P m -> trans (PC.move2 LH.TL.line x x P m) (LH.TL.weight x.2 (PC.pr2 x x P) m) ;
   module HW = PC.T.Homs[V,W] ;
   module WS = HW.WeightsBy[om1,om2,wv,ww] ;
   ratio (x : PC.X) (P : Id PC.X x x) : Id UG.Unit (WS.ratio x P) (PC.w x P) =
    UG.eq _ _ (trans (ap (R.mul (om2 x P).1) (RL[R].one-left (SG.bnd G x.1 (PC.pr1 x x P)).1))
     (R.mulC (om2 x P).1 (SG.bnd G x.1 (PC.pr1 x x P)).1)) ;
   weight : PC.T.WeightBy PC.w HW.H = \ x P f -> trans (WS.weight x P f) (ap (\ u -> (HW.H x).sm u.1 f) (ratio x P)) ;
   bases (x : PC.X) : LG.Basis1 (HW.H x) =
    subst (\ r -> Tr.Trunc[LF.Basis[HW.H x,r]].carrier) (TN.rank-one (suc zero))
     (HB.hom-bases (V x) (W x) (suc zero) (suc zero) (PG.dual-basis x.1) (TN.LineBasis[LH.AG,x0.2].basis x.2)) ;
   object : BC.At[PC.char].Obj = (HW.H,weight,bases) ;
   #fails {
    -- Hom(V, W) has weight w_W / w_V, which is beta x beta only up to a computation
    ratio-refl (x : PC.X) (P : Id PC.X x x) : Id UG.Unit (WS.ratio x P) (PC.w x P) = refl (PC.w x P) ;
   } ;
  } ;
  module K = LG.At[PC.char,\ x0 -> At[x0].object] ;
 } ;
 sum (G H : SG.StackGerbe) : SG.StackGerbe = GO.dual Pair[G,H].K.gerbe ;
} ;
