-- Proposition `cheap`, the isomorphism on the overlap (gabber-recollement):
-- on X = Spec Alg (Alg = A_ab), V and W good of ranks r and s give,
-- merely, V^(m+1) = W^(m'+1).  Setting of POWERCLASS with n = n0 + 1 and
-- Lambda with rank-1 bases bl.  V, W are twisted, their fibres merely have
-- bases of ranks r = r0 + 1 and s = s0 + 1 (LOCALFREE.Basis).
-- V is good of rank N_V = NV0 + 1 if N_V = r^n, the rank of P(V)^v
-- (MULTILINEAR.rank), and rho(p) = 1 at N_V for the projector p of every
-- frame data of the descended P(V)^v (GOODLINE, HOMROOTS.Good.Hypotheses).
--  (unimodular)  The first vector of a basis of positive rank and its
--     coordinate form have c(v) = delta_00 = 1 (LOCALLIFT.Unimodular).
--  (ranks)  nat (r^k) = nat(r)^k (Integers.nat-times), so with s r = N,
--     r^n = N_V and s^n = N_W:  N^n = (s r)^n = s^n r^n = N_V N_W in K_0.
--  (frame data)  The descended P(V)^v, P(W)^v, H' = Hom(W, V), E = End V
--     merely have frame data (AFFINEFRAMEDATA, with the frames of MULTILINEAR
--     and TWISTEDFRAMES), and H', E have bases of ranks s r = N and
--     r r = N_E at every x (HOMBASES; WEAKCANCEL.Common.count: positive).
--  (proof)  HOMROOTS gives rho(H') = 1 at N and, for W = V, rho(E) = 1 at
--     N_E; WEAKCANCEL.Pair then gives the hypothesis `cancel`, and
--     WEAKCANCEL.EqualiseB gives V^(m+1) = W^(m'+1), with
--     m + 1 = (n + 1)(c0 + 1) N and m' + 1 = (n + 1)(c0 + 1) N_E for one c0
--     and n (`balanced`), so m = m' when r = s.  The goal is a
--     proposition, so the mere frame data suffice.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ; module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module LL = LocalLift[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 -- (unimodular)
 unimodular (M : MD.Module) (r0 : Nat) (b : LF.Basis[M,suc r0]) : LL.Unimodular[M] =
  new LL.Unimodular[M,b.frame.vector (inr tt),b.frame.form (inr tt),
   trans (b.dual (inr tt) (inr tt)) (MnSums[l].Over[R].delta-diag (suc r0) (inr tt))] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe)
  (n0 : Nat) (Lambda : TM.Family[C.Spec Alg,G].Weighted (\ a -> TM.UG.power a (suc n0))) {
  module HR = HomRoots[l].Over[R,setR,axioms].At[Alg,fp,G,n0,Lambda] ;
  module WC = WeakCancel[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  module DA = WC.DA ;
  module K = WC.K ;
  module IK = WC.IK ;
  module RQ = WC.RQ ;
  module PK = AffinePowers[l].Over[K.K0] ;
  module HB = HomBases[l].Over[R,setR,axioms].Family[DA.X,G] ;
  module MF = ML.Family[DA.X,G] ;
  -- goodness
  Good (V : DA.Fam.TF.Twisted) (NV0 : Nat) : U l =
   (w : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,MF.Dual[suc n0,V,Lambda].descended].Data) ->
    Id RQ.K.R (RQ.rho (K.class FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,MF.Dual[suc n0,V,Lambda].descended].From[w].projector)
     (IK.nat (suc NV0)) (RQ.positive NV0)) RQ.K.o ;
  -- (ranks)
  nat-rank (r : Nat) : (k : Nat) -> Id K.K0.R (IK.nat (ML.rank r (suc zero) k)) (PK.power (IK.nat r) k) = split {
   zero -> IK.nat-one ;
   suc k | h -> trans (IK.nat-times r (ML.rank r (suc zero) k)) (ap (K.K0.mul (IK.nat r)) h) } ;
  ranks (r s N0 NV0 NW0 : Nat) (hN : Id Nat (Pairing[l].times s r) (suc N0))
   (hV : Id Nat (ML.rank r (suc zero) (suc n0)) (suc NV0)) (hW : Id Nat (ML.rank s (suc zero) (suc n0)) (suc NW0)) :
   Id K.K0.R (PK.power (IK.nat (suc N0)) (suc n0)) (K.K0.mul (IK.nat (suc NV0)) (IK.nat (suc NW0))) =
   calc K.K0.R { PK.power (IK.nat (suc N0)) (suc n0)
     =< ap (\ t -> PK.power (IK.nat t) (suc n0)) (sym hN) > PK.power (IK.nat (Pairing[l].times s r)) (suc n0)
     =< ap (\ t -> PK.power t (suc n0)) (IK.nat-times s r) > PK.power (K.K0.mul (IK.nat s) (IK.nat r)) (suc n0)
     =< PK.power-mul (IK.nat s) (IK.nat r) (suc n0) > K.K0.mul (PK.power (IK.nat s) (suc n0)) (PK.power (IK.nat r) (suc n0))
     =< K.K0.mulC (PK.power (IK.nat s) (suc n0)) (PK.power (IK.nat r) (suc n0)) >
        K.K0.mul (PK.power (IK.nat r) (suc n0)) (PK.power (IK.nat s) (suc n0))
     =< cong2 K.K0.R K.K0.mul _ _ _ _ (sym (nat-rank r (suc n0))) (sym (nat-rank s (suc n0))) >
        K.K0.mul (IK.nat (ML.rank r (suc zero) (suc n0))) (IK.nat (ML.rank s (suc zero) (suc n0)))
     =< cong2 K.K0.R K.K0.mul _ _ _ _ (ap IK.nat hV) (ap IK.nat hW) > K.K0.mul (IK.nat (suc NV0)) (IK.nat (suc NW0)) } ;
  module Pair (V W : DA.Fam.TF.Twisted) (r0 s0 : Nat) (bv : HB.Based V.1 (suc r0)) (bw : HB.Based W.1 (suc s0))
   (bl : (x : DA.X) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier)
   (NV0 NW0 : Nat) (hV : Id Nat (ML.rank (suc r0) (suc zero) (suc n0)) (suc NV0))
   (hW : Id Nat (ML.rank (suc s0) (suc zero) (suc n0)) (suc NW0))
   (gV : Good V NV0) (gW : Good W NW0) {
   -- frames and unimodular elements from the bases
   fv : DA.Fam.Framed V.1 (suc r0) =
    \ x g -> TC.map (LF.Basis[V.1 x g,suc r0]) (FR.Frame[V.1 x g,suc r0]) (\ b -> b.frame) (bv x g) ;
   fw : DA.Fam.Framed W.1 (suc s0) =
    \ x g -> TC.map (LF.Basis[W.1 x g,suc s0]) (FR.Frame[W.1 x g,suc s0]) (\ b -> b.frame) (bw x g) ;
   fl : DA.Fam.Framed Lambda.1 (suc zero) = \ x g ->
    TC.map (LF.Basis[Lambda.1 x g,suc zero]) (FR.Frame[Lambda.1 x g,suc zero]) (\ t -> t.frame) (bl x g) ;
   uv (x : DA.X) (g : (G x).1) : Tr.Trunc[LL.Unimodular[V.1 x g]].carrier =
    TC.map (LF.Basis[V.1 x g,suc r0]) (LL.Unimodular[V.1 x g]) (unimodular (V.1 x g) r0) (bv x g) ;
   uw (x : DA.X) (g : (G x).1) : Tr.Trunc[LL.Unimodular[W.1 x g]].carrier =
    TC.map (LF.Basis[W.1 x g,suc s0]) (LL.Unimodular[W.1 x g]) (unimodular (W.1 x g) s0) (bw x g) ;
   -- the ranks s r and r r of H' and E
   module CH = WC.Common[s0,r0] ;
   module CE = WC.Common[r0,r0] ;
   bases-h (x : DA.X) : Tr.Trunc[LF.Basis[DA.Fam.Hom[W,V].descended x,suc CH.c0]].carrier =
    subst (\ t -> Tr.Trunc[LF.Basis[DA.Fam.Hom[W,V].descended x,t]].carrier) CH.count
     (HB.Hom[W,V,suc s0,suc r0,bw,bv].bases x) ;
   bases-e (x : DA.X) : Tr.Trunc[LF.Basis[DA.Fam.Hom[V,V].descended x,suc CE.c0]].carrier =
    subst (\ t -> Tr.Trunc[LF.Basis[DA.Fam.Hom[V,V].descended x,t]].carrier) CE.count
     (HB.Hom[V,V,suc r0,suc r0,bv,bv].bases x) ;
   -- (frame data)
   module FV = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,MF.Dual[suc n0,V,Lambda].descended] ;
   module FW = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,MF.Dual[suc n0,W,Lambda].descended] ;
   module FH = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,DA.Fam.Hom[W,V].descended] ;
   module FE = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,DA.Fam.Hom[V,V].descended] ;
   data-v : Tr.Trunc[FV.Data].carrier =
    AffineFrameData[l].Over[R,setR,axioms].At[Alg,fp,MF.Dual[suc n0,V,Lambda].descended,ML.rank (suc r0) (suc zero) (suc n0),
     MF.Dual[suc n0,V,Lambda].descended-frames (suc r0) (suc zero) fv fl].theorem ;
   data-w : Tr.Trunc[FW.Data].carrier =
    AffineFrameData[l].Over[R,setR,axioms].At[Alg,fp,MF.Dual[suc n0,W,Lambda].descended,ML.rank (suc s0) (suc zero) (suc n0),
     MF.Dual[suc n0,W,Lambda].descended-frames (suc s0) (suc zero) fw fl].theorem ;
   data-h : Tr.Trunc[FH.Data].carrier =
    AffineFrameData[l].Over[R,setR,axioms].At[Alg,fp,DA.Fam.Hom[W,V].descended,Pairing[l].times (suc s0) (suc r0),
     DA.Fam.Hom[W,V].frames (suc s0) (suc r0) fw fv].theorem ;
   data-e : Tr.Trunc[FE.Data].carrier =
    AffineFrameData[l].Over[R,setR,axioms].At[Alg,fp,DA.Fam.Hom[V,V].descended,Pairing[l].times (suc r0) (suc r0),
     DA.Fam.Hom[V,V].frames (suc r0) (suc r0) fv fv].theorem ;
   -- (proof)
   module From (wP : FV.Data) (wQ : FW.Data) (dH : FH.Data) (dE : FE.Data) {
    rho-h : Id RQ.K.R (WC.TT.Rho[CH.c0].rho (K.class DA.Left[V,W,dH].PH.projector)) RQ.K.o =
     HR.Pair[V,W,suc r0,fv,bl,dH].Good[wP,wQ,CH.c0,NV0,NW0,bases-h,
      ranks (suc r0) (suc s0) CH.c0 NV0 NW0 CH.count hV hW].Hypotheses[gV wP,gW wQ].theorem ;
    rho-e : Id RQ.K.R (WC.TT.Rho[CE.c0].rho (K.class DA.Right[V,W,suc s0,fw,dE].PE.projector)) RQ.K.o =
     HR.Pair[V,V,suc r0,fv,bl,dE].Good[wP,wP,CE.c0,NV0,NV0,bases-e,
      ranks (suc r0) (suc r0) CE.c0 NV0 NV0 CE.count hV hV].Hypotheses[gV wP,gV wP].theorem ;
    balanced : Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].carrier =
     WC.EqualiseB[V,W,suc r0,suc s0,fv,fw,uv,uw,CH.c0,CE.c0,WC.Pair[V,W,suc s0,fw,dH,dE,CH.c0,CE.c0,rho-h,rho-e].balanced].theorem ;
   } ;
   balanced : Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].carrier =
    TC.rec FV.Data @(l+) Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].carrier Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].proposition
     (\ wP -> TC.rec FW.Data @(l+) Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].carrier Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].proposition
      (\ wQ -> TC.rec FH.Data @(l+) Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].carrier Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].proposition
       (\ dH -> TC.rec FE.Data @(l+) Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].carrier Tr1.Trunc[WC.PowersB V.1 W.1 CH.c0 CE.c0].proposition
        (\ dE -> From[wP,wQ,dH,dE].balanced) data-e) data-h) data-w) data-v ;
   -- V^(m+1) = W^(m'+1)
   theorem : Tr1.Trunc[WC.Powers V.1 W.1].carrier =
    TC1.map (WC.PowersB V.1 W.1 CH.c0 CE.c0) (WC.Powers V.1 W.1)
     (\ h -> (WC.SF.exponent (WC.SF.exponent CH.c0 h.1) h.2.1,WC.SF.exponent (WC.SF.exponent CE.c0 h.1) h.2.1,h.2.2)) balanced ;
  } ;
 } ;
} ;
