level l ; open Ring[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 module Pow = AffinePowers[l].Over[A] ;
 Regular (t : R) : U l =
  (a b : R) -> Id R (mul t a) (mul t b) -> Id R a b ;
 KernelZero (t : R) : U l = (a : R) -> Id R (mul t a) z -> Id R a z ;
 difference (a b : R) (h : Id R (add a (neg b)) z) : Id R a b =
  trans (sym (addZ a))
   (trans (ap (add a) (sym (trans (addC (neg b) b) (addN b))))
    (trans (addA a (neg b) b)
     (trans (ap (\ c -> add c b) h) (zl b)))) ;
 from-kernel (t : R) (kernel : KernelZero t) : Regular t =
  \ a b h -> difference a b
   (kernel (add a (neg b))
    (trans (dist t a (neg b))
     (trans (ap (add (mul t a)) (mul-neg t b))
      (trans (ap (\ c -> add c (neg (mul t b))) h) (addN (mul t b)))))) ;
 product (s t : R) (hs : Regular s) (ht : Regular t) : Regular (mul s t) =
  \ a b h -> ht a b
   (hs (mul t a) (mul t b)
    (trans (mulA s t a) (trans h (sym (mulA s t b))))) ;
 powers (t : R) (h : Regular t) : (n : Nat) -> Regular (Pow.power t n) = split {
  zero -> \ a b p -> trans (sym (Pow.one-left a)) (trans p (Pow.one-left b)) ;
  suc n | ih -> product t (Pow.power t n) h ih } ;
} ;
