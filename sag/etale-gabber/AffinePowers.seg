level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 power (x : R) : Nat -> R = split { zero -> o ; suc n | ih -> mul x ih } ;
 one-left (x : R) : Id R (mul o x) x = RL[A].one-left x ;
 power-add (x : R) : (n m : Nat) -> Id R (power x (plus n m)) (mul (power x n) (power x m)) = split {
  zero -> \ m -> sym (one-left (power x m)) ;
  suc n | ih -> \ m -> trans (ap (mul x) (ih m)) (mulA x (power x n) (power x m)) } ;
 power-commute (x : R) (n : Nat) (y : R) :
  Id R (mul (power x (suc n)) y) (mul (power x n) (mul x y)) =
  trans (sym (mulA x (power x n) y)) (mul-swap x (power x n) y) ;
 power-mul (x y : R) : (n : Nat) -> Id R (power (mul x y) n) (mul (power x n) (power y n)) = split {
  zero -> sym (mulO o) ;
  suc n | ih -> trans (ap (mul (mul x y)) ih) (mul-four x y (power x n) (power y n)) } ;
 Nilpotent (x : R) : U l = Truncation[l].Trunc[(n : Nat) * Id R (power x n) z].carrier ;
 module Units (setA : Pr.isSet R) {
  module AR = AffineRing[l].Laws[A,setA] ;
  power-unit (x : R) (u : unit x) : (n : Nat) -> unit (power x n) = split {
   zero -> (o,mulO o) ; suc n | ih -> AR.unit-product x (power x n) u ih } ;
  nilpotent-unit (x : R) (u : unit x) (w : (n : Nat) * Id R (power x n) z) : Id R o z =
   trans (sym (power-unit x u w.1).2)
    (trans (ap (\ t -> mul t (power-unit x u w.1).1) w.2) (zero-mul (power-unit x u w.1).1)) ;
 } ;
 module To (B : CRing) (h : RingHom[l].Hom A B) {
  -- Target power is defined locally to keep the module sequential.
  bp (x : B.R) : Nat -> B.R = split { zero -> B.o ; suc n | ih -> B.mul x ih } ;
  natural (x : R) : (n : Nat) -> Id B.R (h.1 (power x n)) (bp (h.1 x) n) = split {
   zero -> h.2.1 ; suc n | ih -> trans (h.2.2.2 x (power x n)) (ap (B.mul (h.1 x)) ih) } ;
 } ;
} ;
power-map (A B : CRing) (h : RingHom[l].Hom A B) (x : A.R) :
 (n : Nat) -> Id B.R (h.1 (Over[A].power x n)) (Over[B].power (h.1 x) n) = split {
 zero -> h.2.1 ;
 suc n | ih -> trans (h.2.2.2 x (Over[A].power x n)) (ap (B.mul (h.1 x)) ih) } ;
