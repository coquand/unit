-- Frames for arbitrary linear equivalences, and linearity of their inverses.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (loc : StandardOpens[l].Over[R,setR].Locality) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module SQ = DescentSquare[l].Over[R,setR,loc] ;
 module Rank (n : Nat) {
  V : MD.Module = DL.Free n ;
  unit (j : Fin n) (k : Fin n) : R.R = DL.D.delta n k j ;
  expansion (v : V.M) : Id V.M (DL.On[V].lin n unit v) v =
   trans (SQ.Rank[n].coordinates n unit v)
    (F.funext (Fin n) (\ k -> R.R) _ v (\ k -> DL.D.sum-delta n k v)) ;
  module Map (M : MD.Module) (f : V.M -> M.M)
   (add : (u v : V.M) -> Id M.M (f (V.madd u v)) (M.madd (f u) (f v)))
   (scale : (a : R.R) (v : V.M) -> Id M.M (f (V.sm a v)) (M.sm a (f v))) {
   module H = DL.Hom[V,M,f,add,scale] ;
   columns (j : Fin n) : M.M = f (unit j) ;
   equation (v : V.M) : Id M.M (DL.On[M].lin n columns v) (f v) =
    trans (sym (H.lin n unit v)) (ap f (expansion v)) ;
   from-equiv (e : Pr.isEquiv V.M M.M f) : DL.On[M].Frame n =
    (columns,Equivalences[l].homotopy V.M M.M (f,e) (DL.On[M].lin n columns) equation) ;
  } ;
  standard : DL.On[V].Frame n =
   Map[V,\ v -> v,\ u v -> refl (V.madd u v),\ a v -> refl (V.sm a v)].from-equiv (Pr.idEquiv V.M).2 ;
 } ;
 module Inverse (M N : MD.Module) (f : M.M -> N.M)
  (add : (u v : M.M) -> Id N.M (f (M.madd u v)) (N.madd (f u) (f v)))
  (scale : (a : R.R) (v : M.M) -> Id N.M (f (M.sm a v)) (N.sm a (f v)))
  (e : Pr.isEquiv M.M N.M f) {
  inverse : N.M -> M.M = e.sec ;
  inverse-add (u v : N.M) : Id M.M (inverse (N.madd u v)) (M.madd (inverse u) (inverse v)) =
   Equivalences[l].injective M.M N.M f e _ _
    (trans (e.sec-eq (N.madd u v))
     (sym (trans (add (inverse u) (inverse v))
      (cong2 N.M N.madd _ _ _ _ (e.sec-eq u) (e.sec-eq v))))) ;
  inverse-scale (a : R.R) (u : N.M) : Id M.M (inverse (N.sm a u)) (M.sm a (inverse u)) =
   Equivalences[l].injective M.M N.M f e _ _
    (trans (e.sec-eq (N.sm a u)) (sym (trans (scale a (inverse u)) (ap (N.sm a) (e.sec-eq u))))) ;
  module H = DL.Hom[N,M,inverse,inverse-add,inverse-scale] ;
 } ;
} ;
