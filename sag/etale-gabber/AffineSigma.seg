-- Bounded affine families: a common bound on the numbers of variables
-- realizes the dependent sum as a closed subtype of X times affine N-space.
-- The equation lists may have arbitrary, varying lengths.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module E = Equivalences[l] ;
module CB = CoefficientBound[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ; module FA = FunctionAlgebra[l].Over[R,setR] ;
 module PP = PresentationPadding[l].Over[R,setR] ; module FS = FinSum[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 module CA = ClosedAffineGeneral[l].Over[R,setR,axioms] ;
 module Product (X Y : U l) (wx : SA.Witness X) (wy : SA.Witness Y) {
  Data : U l = SA.Sol wx.1 * SA.Sol wy.1 ;
  forward (t : X * Y) : Data = (wx.2.1 t.1,wy.2.1 t.2) ;
  backward (d : Data) : X * Y = (wx.2.2.sec d.1,wy.2.2.sec d.2) ;
  fb (d : Data) : Id Data (forward (backward d)) d =
   AffineHLevels[l].pair-path (SA.Sol wx.1) (SA.Sol wy.1) _ _ _ _ (wx.2.2.sec-eq d.1) (wy.2.2.sec-eq d.2) ;
  bf (t : X * Y) : Id (X * Y) (backward (forward t)) t =
   AffineHLevels[l].pair-path X Y _ _ _ _
    (Pr.sec-ret X (SA.Sol wx.1) wx.2.1 wx.2.2 t.1) (Pr.sec-ret Y (SA.Sol wy.1) wy.2.1 wy.2.2 t.2) ;
  equivalence : Pr.Equiv (X * Y) Data = (forward,Pr.qinv _ _ forward backward fb bf) ;
  witness : SA.Witness (X * Y) =
   (FS.tensor wx.1 wy.1,E.compose _ _ _ equivalence (Functions[l].inverse _ _ FS.Split[wx.1,wy.1,C.base].equivalence)) ;
 } ;
 product-small (X Y : U l) (ax : SA.Affine X) (ay : SA.Affine Y) : SA.Affine (X * Y) =
  Tr.Trunc[SA.Witness X].induction @l (\ t -> SA.Affine (X * Y)) (\ t -> SA.proposition (X * Y))
   (\ wx -> Tr.Trunc[SA.Witness Y].induction @l (\ t -> SA.Affine (X * Y)) (\ t -> SA.proposition (X * Y))
    (\ wy -> Tr.Trunc[SA.Witness (X * Y)].inc Product[X,Y,wx,wy].witness) ay) ax ;
 product (X Y : U l) (ax : FA.Affine X) (ay : FA.Affine Y) : FA.Affine (X * Y) =
  SA.to-affine (X * Y) (product-small X Y (SA.from-affine X ax) (SA.from-affine Y ay)) ;
 module Space (N : Nat) {
  presentation : P.Presentation = (N,nil) ;
  forward (v : PP.Vector N) : SA.Sol presentation = (v,tt) ;
  backward (s : SA.Sol presentation) : PP.Vector N = s.1 ;
  fb (s : SA.Sol presentation) : Id (SA.Sol presentation) (forward (backward s)) s =
   P.solutions-ext presentation C.base _ s (\ i -> refl (s.1 i)) ;
  equivalence : Pr.Equiv (PP.Vector N) (SA.Sol presentation) =
   (forward,Pr.qinv _ _ forward backward fb (\ v -> refl v)) ;
  witness : SA.Witness (PP.Vector N) = (presentation,equivalence) ;
  small-affine : SA.Affine (PP.Vector N) = Tr.Trunc[SA.Witness (PP.Vector N)].inc witness ;
  affine : FA.Affine (PP.Vector N) = SA.to-affine (PP.Vector N) small-affine ;
 } ;
 module Bounded (X : U l) (affX : FA.Affine X) (Y : X -> U l)
  (w : (x : X) -> SA.Witness (Y x)) (N : Nat) (bound : (x : X) -> CB.le (w x).1.1 N) {
  Ambient : U l = X * PP.Vector N ;
  Condition (a : Ambient) : U l = PP.Padded[(w a.1).1,N,bound a.1].Condition a.2 ;
  closed (a : Ambient) : CP.Closed (Condition a) = PP.Padded[(w a.1).1,N,bound a.1].closed a.2 ;
  Geometric : U l = (a : Ambient) * Condition a ;
  geometric-affine : FA.Affine Geometric =
   CA.theorem Ambient (product X (PP.Vector N) affX Space[N].affine) Condition closed ;
  Fiber (x : X) : U l = (v : PP.Vector N) * Condition (x,v) ;
  fiber-equivalence (x : X) : Pr.Equiv (Y x) (Fiber x) =
   E.compose _ _ _ (w x).2 PP.Padded[(w x).1,N,bound x].equivalence ;
  Sum : U l = (x : X) * Y x ;
  Intermediate : U l = (x : X) * Fiber x ;
  forward (u : Sum) : Intermediate = (u.1,(fiber-equivalence u.1).1 u.2) ;
  backward (v : Intermediate) : Sum = (v.1,(fiber-equivalence v.1).2.sec v.2) ;
  fb (v : Intermediate) : Id Intermediate (forward (backward v)) v =
   Pr.ap (Fiber v.1) Intermediate (\ z -> (v.1,z)) _ _ ((fiber-equivalence v.1).2.sec-eq v.2) ;
  bf (u : Sum) : Id Sum (backward (forward u)) u =
   Pr.ap (Y u.1) Sum (\ z -> (u.1,z)) _ _
    (Pr.sec-ret (Y u.1) (Fiber u.1) (fiber-equivalence u.1).1 (fiber-equivalence u.1).2 u.2) ;
  fiberwise : Pr.Equiv Sum Intermediate = (forward,Pr.qinv _ _ forward backward fb bf) ;
  rearrange : Pr.Equiv Intermediate Geometric =
   (\ v -> ((v.1,v.2.1),v.2.2),Pr.qinv Intermediate Geometric (\ v -> ((v.1,v.2.1),v.2.2))
    (\ a -> (a.1.1,a.1.2,a.2)) (\ a -> refl a) (\ v -> refl v)) ;
  equivalence : Pr.Equiv Sum Geometric = E.compose _ _ _ fiberwise rearrange ;
  theorem : FA.Affine Sum =
   SA.to-affine Sum (SA.along Sum Geometric equivalence (SA.from-affine Geometric geometric-affine)) ;
 } ;
 bounded (X : U l) (affX : FA.Affine X) (Y : X -> U l)
  (w : (x : X) -> SA.Witness (Y x)) (N : Nat) (bound : (x : X) -> CB.le (w x).1.1 N) :
  FA.Affine ((x : X) * Y x) = Bounded[X,affX,Y,w,N,bound].theorem ;
} ;
