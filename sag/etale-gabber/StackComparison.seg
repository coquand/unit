-- StackGerbe is the sheafification of K(R^x, 2) for the root topology
-- (HANDOFF-K2-COMPARISON, S2 and S3).  K = the R^x-gerbes (GERBESPACE).
-- Definition (connected).  The closure works on small propositions only, so
-- "locally F" for a large F is given by a small witness:
--     Locally F = (A : U l) * close A * (A -> F)
-- (for F small, equivalent to close F: inc one way, elim the other).  A map
-- f : K -> S between 2-types is ◯-connected when each fibre F satisfies
--     Locally F,  Locally (x = y),  Locally (p = q),  Locally (al = be)
-- for all x y : F, p q : x = y, al be : p = q.  This is ◯-connectedness of
-- the fibres (Rijke-Shulman-Spitters, Modalities in HoTT, 2020) unfolded: the
-- root topology is generated by propositions, so its modality ◯ is
-- topological, hence lex, hence preserves identity types,
-- (◯-unit x = ◯-unit y) ~ ◯(x = y) (ibid., lex modalities); so ◯F is
-- contractible iff it is inhabited and all ◯(x = y) are contractible, and
-- ◯F is inhabited iff ◇F once ◯F is a proposition.  The fibres are 2-types,
-- so at depth 3 the path types are propositions, for which ◯-connected is ◇,
-- and the iteration stops.  Since paths in fibres of f are fibres of ap f,
-- this is "ap^k f is locally surjective for k = 0..3".
--  (lines)    A gerbe G with a point g maps to the trivial stack gerbe T
--             (the lines, GERBEOPS.trivial) by x |-> Line(g = x), keeping the
--             bands (as GERBEOPS.Pointed; TWISTEDLINE.weight).  T is a gerbe
--             (a point, merely connected by HILBERT90), so this map is an
--             equivalence (GERBE.GE).
--  (stack)    Hence the carrier of every G : K is a sheaf (being a sheaf is a
--             proposition, so we may take a point; a retract of the sheaf T),
--             and so are its paths (SHEAFLEMMAS.modal-Id).
--  (eta)      eta G = G as a stack gerbe: the same carrier and band, with
--             ||-|| weakened to close.
--  (subtype)  K ~ (S : StackGerbe) * ||S.1||: G |-> (eta G, inh G), and back
--             (S, t) |-> (S.1, gpd, t, merely connected (HILBERT90), band).
--             Both round trips change only propositions.
--  (fibres)   So the fibre of eta at S is that of the first projection
--             (base change along an equivalence, SHEAFLEMMAS.base), which is
--             ||S.1||, a proposition.  It is locally inhabited: S.1 is
--             close-inhabited and a point s gives the fibre point
--             (back (S, |s|), ...).  A proposition that is locally inhabited
--             is connected (deeper paths exist).
--  (S2)       eta is ◯-connected.
--  (S3)       StackGerbe is a sheaf (STACKSHEAF) with a ◯-connected map from
--             K: it is the localisation of K, StackGerbe = ◯K(R^x, 2).  For any
--             X, post-composition with eta induces ||X -> K||_0 -> H^2(X)
--             (descent to the quotients, QUOTIENT.Descend).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module EC = EtaleClosure[l].Over[R,setR,axioms] ;
 module GO = GerbeOps[l].Over[R,setR,axioms,loc,sh] ;
 module SG = GO.SG ;
 module GS = GerbeSpace[l].Over[R,setR,axioms,sh] ;
 module SS = StackSheaf[l].Over[R,setR,axioms,sh] ;
 module TN = GO.TN ;
 module UG = SG.UG ;
 module GB = SG.GB ;
 -- Definition (connected)
 Locally (P : U l+) : U l+ = (A : U l) * sh.close A * (A -> P) ;
 Connected (P : U l+) : U l+ =
  Locally P * ((x y : P) -> Locally (Id P x y) * ((p q : Id P x y) -> Locally (Id (Id P x y) p q)
   * ((al be : Id (Id P x y) p q) -> Locally (Id (Id (Id P x y) p q) al be)))) ;
 ConnectedMap (A B : U l+) (f : A -> B) : U l+ = (b : B) -> Connected ((a : A) * Id B (f a) b) ;
 everywhere (P : U l+) (p : P) : Locally P = (Top,sh.inc Top tt,\ t -> p) ;
 prop-connected (P : U l+) (pP : Hi.isProp P) (h : Locally P) : Connected P =
  (h,\ x y -> (everywhere (Id P x y) (pP x y),\ p q -> (everywhere (Id (Id P x y) p q) (Hi.prop-to-set P pP x y p q),
   \ al be -> everywhere (Id (Id (Id P x y) p q) al be) (Hi.prop-to-set (Id P x y) (Hi.prop-to-set P pP x y) p q al be)))) ;
 -- (lines)
 trivial : GB.AGerbe = (GO.trivial.1,SG.gpd GO.trivial,Tr.Trunc[GO.trivial.1].inc GO.base,GO.connected GO.trivial,SG.band GO.trivial) ;
 module Lines (G : GB.AGerbe) (g : G.1) {
  module TL = TwistedLine[l].Over[R,setR].At[G,g] ;
  EV (x : G.1) : GO.LT.B.Obj = GO.constant (TL.line x) (TN.LineBasis[G,g].basis x) ;
  -- idToIso along ap EV is transport (J; at refl both are the identity)
  iso (x x' : G.1) (p : Id G.1 x x') (t : Top) (m : (TL.line x).M) :
   Id (TL.line x').M ((GO.LT.B.Fd.idToIso (EV x) (EV x') (Hi.ap G.1 GO.LT.B.Obj EV x x' p) t).1.1 m) (TL.MV.move x x' p m) =
   idJ G.1 x (\ z q -> Id (TL.line z).M ((GO.LT.B.Fd.idToIso (EV x) (EV z) (Hi.ap G.1 GO.LT.B.Obj EV x z q) t).1.1 m) (TL.MV.move x z q m))
    (refl m) x' p ;
  -- the weight of the lines (TWISTEDLINE.weight), the band of the charged type being that of G
  weight (x : G.1) (p : Id G.1 x x) (m : (TL.line x).M) :
   Id (TL.line x).M (TL.MV.move x x p m) ((TL.line x).sm (GS.bnd G x p).1 m) = TL.weight x p m ;
  module I = GO.LT.Into[G.1,EV,GS.bnd G,\ x p t m -> trans (iso x x p t m) (weight x p m)] ;
  equiv : Pr.Equiv G.1 GO.trivial.1 = GB.GE[G,trivial,I.map,I.preserves].equiv ;
 } ;
 -- (stack)
 stack (G : GB.AGerbe) : ET.T.isModal @l G.1 =
  Tr.Trunc[G.1].induction @l (\ t -> ET.T.isModal @l G.1) (\ t -> EC.CL.modal-prop G.1)
   (\ g -> SL.modal-retract GO.trivial.1 G.1 Lines[G,g].equiv.1 Lines[G,g].equiv.2.ret Lines[G,g].equiv.2.ret-eq (SG.stack GO.trivial))
   (GS.inh G) ;
 -- (eta)
 local (A : U l) (t : Tr.Trunc[A].carrier) : sh.close A =
  Tr.Trunc[A].induction @l (\ u -> sh.close A) (\ u -> sh.proposition A) (sh.inc A) t ;
 eta (G : GB.AGerbe) : SG.StackGerbe =
  (G.1,GS.band G,GS.gpd G,local G.1 (GS.inh G),\ a b -> local (Id G.1 a b) (GS.conn G a b),\ a b -> SL.modal-Id G.1 (stack G) a b,stack G) ;
 -- (subtype)
 Merely : U l+ = (S : SG.StackGerbe) * Tr.Trunc[S.1].carrier ;
 to (G : GB.AGerbe) : Merely = (eta G,GS.inh G) ;
 under (S : SG.StackGerbe) (t : Tr.Trunc[S.1].carrier) : GB.AGerbe = (S.1,SG.gpd S,t,GO.connected S,SG.band S) ;
 back (y : Merely) : GB.AGerbe = under y.1 y.2 ;
 conn-prop (X : U l) : Pr.isProp ((a b : X) -> Tr.Trunc[Id X a b].carrier) =
  F.isProp-Pi X (\ a -> (b : X) -> Tr.Trunc[Id X a b].carrier) (\ a ->
   F.isProp-Pi X (\ b -> Tr.Trunc[Id X a b].carrier) (\ b -> Tr.Trunc[Id X a b].proposition)) ;
 back-to (G : GB.AGerbe) : Id GB.AGerbe (back (to G)) G =
  Hi.ap ((a b : G.1) -> Tr.Trunc[Id G.1 a b].carrier) GB.AGerbe (\ c -> (G.1,GS.gpd G,GS.inh G,c,GS.band G))
   (GO.connected (eta G)) (GS.conn G) (conn-prop G.1 (GO.connected (eta G)) (GS.conn G)) ;
 eta-under (S : SG.StackGerbe) (t : Tr.Trunc[S.1].carrier) : Id SG.StackGerbe (eta (under S t)) S =
  Hi.ap (SG.Laws S.1) SG.StackGerbe (\ L -> (S.1,S.2.1,L)) (eta (under S t)).2.2 S.2.2 (SG.laws-prop S.1 (eta (under S t)).2.2 S.2.2) ;
 to-back (y : Merely) : Id Merely (to (back y)) y =
  Hi.Sigma-eq SG.StackGerbe (\ S -> Tr.Trunc[S.1].carrier) (eta (under y.1 y.2)) y.1 y.2 y.2 (eta-under y.1 y.2) (\ u v -> Tr.Trunc[y.1.1].proposition u v) ;
 to-equiv : Hi.Equiv GB.AGerbe Merely = (to,Hi.qinv GB.AGerbe Merely to back to-back back-to) ;
 -- (fibres)
 Fib (S : SG.StackGerbe) : U l+ = (G : GB.AGerbe) * Id SG.StackGerbe (eta G) S ;
 module Projection (A : U l+) (P : A -> U l+) (pP : (a : A) -> Hi.isProp (P a)) (a : A) {
  Fb : U l+ = (y : (b : A) * P b) * Id A y.1 a ;
  c (x : P a) : Fb = ((a,x),refl a) ;
  to-c (a' : A) (x' : P a') (q : Id A a' a) : Id Fb ((a',x'),q) (c (Hi.subst A P a' a q x')) =
   idJ A a' (\ a2 q2 -> Id ((y : (b : A) * P b) * Id A y.1 a2) ((a',x'),q2) ((a2,Hi.subst A P a' a2 q2 x'),refl a2))
    (refl ((a',x'),refl a')) a q ;
  prop : Hi.isProp Fb = \ w w' ->
   Hi.trans Fb w (c (Hi.subst A P w.1.1 a w.2 w.1.2)) w' (to-c w.1.1 w.1.2 w.2)
    (Hi.trans Fb (c (Hi.subst A P w.1.1 a w.2 w.1.2)) (c (Hi.subst A P w'.1.1 a w'.2 w'.1.2)) w'
     (Hi.ap (P a) Fb c _ _ (pP a _ _))
     (Hi.sym Fb w' (c (Hi.subst A P w'.1.1 a w'.2 w'.1.2)) (to-c w'.1.1 w'.1.2 w'.2))) ;
 } ;
 module Fibre (S : SG.StackGerbe) {
  module PM = Projection[SG.StackGerbe,\ S' -> Tr.Trunc[S'.1].carrier,\ S' -> Tr.Trunc[S'.1].proposition,S] ;
  change : Hi.isEquiv (Fib S) PM.Fb (\ w -> (to w.1,w.2)) =
   SheafLemmas[l,l+].base GB.AGerbe Merely to-equiv (\ y -> Id SG.StackGerbe y.1 S) ;
  prop : Hi.isProp (Fib S) = Hi.retract-prop (Fib S) PM.Fb (\ w -> (to w.1,w.2)) change.ret change.ret-eq PM.prop ;
  point (s : S.1) : Fib S = (under S (Tr.Trunc[S.1].inc s),eta-under S (Tr.Trunc[S.1].inc s)) ;
  locally : Locally (Fib S) = (S.1,SG.inh S,point) ;
  connected : Connected (Fib S) = prop-connected (Fib S) prop locally ;
 } ;
 -- (S2)
 eta-connected : ConnectedMap GB.AGerbe SG.StackGerbe eta = \ S -> Fibre[S].connected ;
 -- (S3)
 Localisation (S : U l+) (f : GB.AGerbe -> S) : U l+ = ET.T.isModal @(l+) S * ConnectedMap GB.AGerbe S f ;
 localisation : Localisation SG.StackGerbe eta = (SS.theorem,eta-connected) ;
 #fails {
  -- the fibre of eta at S is ||S.1||, not close S.1: a stack gerbe is a
  -- GB.AGerbe-gerbe only where it has a point
  naive (S : SG.StackGerbe) : GB.AGerbe = (S.1,SG.gpd S,SG.inh S,GO.connected S,SG.band S) ;
 } ;
 module Classes (X : U l) {
  module H = SG.H2[X] ;
  C : U l+ = X -> GB.AGerbe ;
  Same (G G' : C) : U l+ = Tr1.Trunc[Id C G G'].carrier ;
  module Q = Quotient[l+].Quot[C,Same,\ G G' -> Tr1.Trunc[Id C G G'].proposition,
   \ G -> Tr1.Trunc[Id C G G].inc (refl G),
   \ G G' -> TruncationCombinators[l+].map (Id C G G') (Id C G' G) (Hi.sym C G G'),
   \ G G' G'' -> TruncationCombinators[l+].map2 (Id C G G') (Id C G' G'') (Id C G G'') (Hi.trans C G G' G'')] ;
  f (G : C) : H.H2 = H.cl (\ x -> eta (G x)) ;
  respect (G G' : C) (r : Same G G') : Id H.H2 (f G) (f G') =
   H.Q.relates (\ x -> eta (G x)) (\ x -> eta (G' x))
    (TruncationCombinators[l+].map (Id C G G') (Id H.Classes (\ x -> eta (G x)) (\ x -> eta (G' x)))
     (Hi.ap C H.Classes (\ G2 x -> eta (G2 x)) G G') r) ;
  module D = Q.Descend[H.H2,H.Q.set,f,respect] ;
  map (q : Q.Q) : H.H2 = D.map q ;
  beta (G : C) : Id H.H2 (map (Q.inc G)) (H.cl (\ x -> eta (G x))) = D.beta G ;
 } ;
} ;
