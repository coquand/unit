-- Restriction K_0(A) -> K_0(B) along a ring map f : A -> B (K0,
-- PROJECTORMAP).
--  (isos)  If Image p ~ Image q over A, then Image f(p) ~ Image f(q).  Pad
--   to one size, p + 0_n and 0_m + q (COMPLEMENTS), whose images are still
--   isomorphic.  An isomorphism of images of projectors of one size is an
--   equivalence u, v (EQUIVALENCE.FromIso); f(u), f(v) is an equivalence of
--   f(p + 0) and f(0 + q) (Map), hence an isomorphism of their images
--   (ToIso); and f(p + 0) = f p + 0 has the image of f p.
--  (semiring)  So p |-> [f p] descends to the semiring of classes, and it
--   is a map of semirings: f commutes with sums, Kronecker products, 0, 1.
--  (ring)  By functoriality of the Grothendieck ring (GROTHENDIECK.Functor)
--   this gives the ring map restrict : K_0(A) -> K_0(B), [p] |-> [f p].
--  (functoriality)  Ring maps out of K_0(A) agreeing on classes agree
--   (Agree); restricting along g f is restricting along f then g (Compose),
--   and pointwise equal maps restrict alike (Pointwise): the matrices agree.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module TC = TruncationCombinators[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (f : H.Hom A B) {
 module M = ProjectorMap[l].Over[A,B,setA,setB,f] ;
 module KA = M.KA ;
 module KB = M.KB ;
 module CA = M.CA ;
 module CB = M.CB ;
 module PA = KA.PJ ;
 module PB = KB.PJ ;
 module MA = KA.MI ;
 module MB = KB.MI ;

 -- (isos)
 module MapIso (p q : PA.Projector) (e : KA.Iso p q) {
  n : Nat = plus p.size q.size ;
  p' : PA.Projector = KA.sum p CA.Null[q.size].projector ;
  q' : PA.Projector = KA.sum CA.Null[p.size].projector q ;
  padded : KA.Iso p' q' =
   MA.compose (KA.image p') (KA.image p) (KA.image q') CA.PadRight[p,q.size].iso
    (MA.compose (KA.image p) (KA.image q) (KA.image q') e (MA.inverse (KA.image q') (KA.image q) CA.PadLeft[p.size,q].iso)) ;
  module EA = Equivalence[l].Over[A,setA,n] ;
  module EB = Equivalence[l].Over[B,setB,n] ;
  equivalent : EA.Equivalent[p'.matrix,q'.matrix] = EA.FromIso[p'.matrix,q'.matrix,p'.idempotent,q'.idempotent,padded].equivalent ;
  mapped : EB.Equivalent[M.At[n].MM.map p'.matrix,M.At[n].MM.map q'.matrix] =
   Equivalence[l].Map[A,B,setA,setB,f,n].map p'.matrix q'.matrix equivalent ;
  middle : KB.Iso (M.map p') (M.map q') =
   EB.ToIso[M.At[n].MM.map p'.matrix,M.At[n].MM.map q'.matrix,(M.map p').idempotent,(M.map q').idempotent,mapped].iso ;
  -- Image f(p) ~ Image (f p + 0) ~ Image (f p + f 0) ~ Image f(p + 0)
  left : KB.Iso (M.map p) (M.map p') =
   MB.compose (KB.image (M.map p)) (KB.image (KB.sum (M.map p) CB.Null[q.size].projector)) (KB.image (M.map p'))
    (MB.inverse (KB.image (KB.sum (M.map p) CB.Null[q.size].projector)) (KB.image (M.map p)) CB.PadRight[M.map p,q.size].iso)
    (MB.compose (KB.image (KB.sum (M.map p) CB.Null[q.size].projector)) (KB.image (KB.sum (M.map p) (M.map CA.Null[q.size].projector)))
      (KB.image (M.map p'))
     (KB.sum-iso (M.map p) (M.map p) CB.Null[q.size].projector (M.map CA.Null[q.size].projector)
      (MB.identity (KB.image (M.map p)))
      (MB.inverse (KB.image (M.map CA.Null[q.size].projector)) (KB.image CB.Null[q.size].projector) M.Null[q.size].iso))
     (MB.inverse (KB.image (M.map p')) (KB.image (KB.sum (M.map p) (M.map CA.Null[q.size].projector))) M.Sum[p,CA.Null[q.size].projector].iso)) ;
  -- Image f(0 + q) ~ Image (f 0 + f q) ~ Image (0 + f q) ~ Image f(q)
  right : KB.Iso (M.map q') (M.map q) =
   MB.compose (KB.image (M.map q')) (KB.image (KB.sum (M.map CA.Null[p.size].projector) (M.map q))) (KB.image (M.map q))
    M.Sum[CA.Null[p.size].projector,q].iso
    (MB.compose (KB.image (KB.sum (M.map CA.Null[p.size].projector) (M.map q))) (KB.image (KB.sum CB.Null[p.size].projector (M.map q)))
      (KB.image (M.map q))
     (KB.sum-iso (M.map CA.Null[p.size].projector) CB.Null[p.size].projector (M.map q) (M.map q) M.Null[p.size].iso
      (MB.identity (KB.image (M.map q))))
     CB.PadLeft[p.size,M.map q].iso) ;
  iso : KB.Iso (M.map p) (M.map q) =
   MB.compose (KB.image (M.map p)) (KB.image (M.map p')) (KB.image (M.map q)) left
    (MB.compose (KB.image (M.map p')) (KB.image (M.map q')) (KB.image (M.map q)) middle right) ;
 } ;
 map-rel (p q : PA.Projector) (h : KA.Rel p q) : KB.Rel (M.map p) (M.map q) =
  TC.map (KA.Iso p q) (KB.Iso (M.map p) (M.map q)) (\ e -> MapIso[p,q,e].iso) h ;

 -- (semiring)
 module SA = KA.SR ;
 module SB = KB.SR ;
 module D = SA.Q.Descend[SB.Carrier,SB.set,\ p -> SB.class (M.map p),
  \ p q h -> SB.Q.relates (M.map p) (M.map q) (map-rel p q h)] ;
 smap : SA.Carrier -> SB.Carrier = D.map ;
 smap-class (p : PA.Projector) : Id SB.Carrier (smap (SA.class p)) (SB.class (M.map p)) = D.beta p ;
 iso-class (p q : PB.Projector) (e : KB.Iso p q) : Id SB.Carrier (SB.class p) (SB.class q) = SB.Q.relates p q (KB.related p q e) ;
 smap-zero : Id SB.Carrier (smap (SA.class PA.zeroP)) (SB.class PB.zeroP) =
  trans (smap-class PA.zeroP) (iso-class (M.map PA.zeroP) PB.zeroP M.zero-iso) ;
 smap-one : Id SB.Carrier (smap (SA.class PA.oneP)) (SB.class PB.oneP) =
  trans (smap-class PA.oneP) (iso-class (M.map PA.oneP) PB.oneP M.one-iso) ;
 smap-add : (x y : SA.Carrier) -> Id SB.Carrier (smap (SA.addQ x y)) (SB.addQ (smap x) (smap y)) =
  SA.forall2 (\ x y -> Id SB.Carrier (smap (SA.addQ x y)) (SB.addQ (smap x) (smap y))) (\ x y -> SB.set _ _)
   (\ p q -> calc SB.Carrier { smap (SA.addQ (SA.class p) (SA.class q))
     =< ap smap (SA.add2 p q) > smap (SA.class (KA.sum p q))
     =< smap-class (KA.sum p q) > SB.class (M.map (KA.sum p q))
     =< iso-class (M.map (KA.sum p q)) (KB.sum (M.map p) (M.map q)) M.Sum[p,q].iso > SB.class (KB.sum (M.map p) (M.map q))
     =< sym (SB.add2 (M.map p) (M.map q)) > SB.addQ (SB.class (M.map p)) (SB.class (M.map q))
     =< cong2 SB.Carrier SB.addQ _ _ _ _ (sym (smap-class p)) (sym (smap-class q)) > SB.addQ (smap (SA.class p)) (smap (SA.class q)) }) ;
 smap-mul : (x y : SA.Carrier) -> Id SB.Carrier (smap (SA.mulQ x y)) (SB.mulQ (smap x) (smap y)) =
  SA.forall2 (\ x y -> Id SB.Carrier (smap (SA.mulQ x y)) (SB.mulQ (smap x) (smap y))) (\ x y -> SB.set _ _)
   (\ p q -> calc SB.Carrier { smap (SA.mulQ (SA.class p) (SA.class q))
     =< ap smap (SA.mul2 p q) > smap (SA.class (KA.product p q))
     =< smap-class (KA.product p q) > SB.class (M.map (KA.product p q))
     =< iso-class (M.map (KA.product p q)) (KB.product (M.map p) (M.map q)) M.Product[p,q].iso >
        SB.class (KB.product (M.map p) (M.map q))
     =< sym (SB.mul2 (M.map p) (M.map q)) > SB.mulQ (SB.class (M.map p)) (SB.class (M.map q))
     =< cong2 SB.Carrier SB.mulQ _ _ _ _ (sym (smap-class p)) (sym (smap-class q)) > SB.mulQ (smap (SA.class p)) (smap (SA.class q)) }) ;
 shom : Semiring[l].Hom[SA.semiring,SB.semiring] =
  new Semiring[l].Hom[SA.semiring,SB.semiring,smap,smap-zero,smap-one,smap-add,smap-mul] ;

 -- (ring)
 module GF = Grothendieck[l].Functor[SA.semiring,SB.semiring,shom] ;
 restrict : H.Hom KA.K0 KB.K0 = GF.hom ;
 restrict-class (p : PA.Projector) : Id KB.K0.R (restrict.1 (KA.class p)) (KB.class (M.map p)) =
  trans (GF.class-map (SA.class p)) (ap KB.G.class (smap-class p)) ;
} ;

-- Two ring maps out of K_0(A) agreeing on classes agree: every x is merely
-- [p] - [q] (K0.difference).
module Agree (A T : CRing) (setA : Pr.isSet A.R) (setT : Pr.isSet T.R)
 (h h' : H.Hom K0[l].Over[A,setA].K0 T)
 (hc : (p : K0[l].Over[A,setA].PJ.Projector) -> Id T.R (h.1 (K0[l].Over[A,setA].class p)) (h'.1 (K0[l].Over[A,setA].class p))) {
 module K = K0[l].Over[A,setA] ;
 -- h ([p] - [q]) = h [p] - h [q]
 split-at (g : H.Hom K.K0 T) (p q : K.PJ.Projector) :
  Id T.R (g.1 (K.K0.add (K.class p) (K.K0.neg (K.class q)))) (T.add (g.1 (K.class p)) (T.neg (g.1 (K.class q)))) =
  trans (g.2.2.1 (K.class p) (K.K0.neg (K.class q))) (ap (T.add (g.1 (K.class p))) (H.negation K.K0 T g (K.class q))) ;
 at (x : K.K0.R) : Id T.R (h.1 x) (h'.1 x) =
  TC.rec ((p : K.PJ.Projector) * (q : K.PJ.Projector) * Id K.K0.R x (K.K0.add (K.class p) (K.K0.neg (K.class q))))
   @l (Id T.R (h.1 x) (h'.1 x)) (setT _ _)
   (\ v -> calc T.R { h.1 x
     =< ap h.1 v.2.2 > h.1 (K.K0.add (K.class v.1) (K.K0.neg (K.class v.2.1)))
     =< split-at h v.1 v.2.1 > T.add (h.1 (K.class v.1)) (T.neg (h.1 (K.class v.2.1)))
     =< cong2 T.R T.add _ _ _ _ (hc v.1) (ap T.neg (hc v.2.1)) > T.add (h'.1 (K.class v.1)) (T.neg (h'.1 (K.class v.2.1)))
     =< sym (split-at h' v.1 v.2.1) > h'.1 (K.K0.add (K.class v.1) (K.K0.neg (K.class v.2.1)))
     =< ap h'.1 (sym v.2.2) > h'.1 x })
   (K.difference x) ;
} ;

-- restriction along g f is restriction along f, then along g
module Compose (A B C : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (setC : Pr.isSet C.R)
 (f : H.Hom A B) (g : H.Hom B C) {
 module RF = Over[A,B,setA,setB,f] ;
 module RG = Over[B,C,setB,setC,g] ;
 module RH = Over[A,C,setA,setC,H.compose A B C g f] ;
 -- g(f p) and (g f) p have the same matrix
 at-class (p : RF.PA.Projector) : Id RH.KB.K0.R (RG.restrict.1 (RF.restrict.1 (RF.KA.class p))) (RH.restrict.1 (RF.KA.class p)) =
  calc RH.KB.K0.R { RG.restrict.1 (RF.restrict.1 (RF.KA.class p))
    =< ap RG.restrict.1 (RF.restrict-class p) > RG.restrict.1 (RF.KB.class (RF.M.map p))
    =< RG.restrict-class (RF.M.map p) > RG.KB.class (RG.M.map (RF.M.map p))
    =< RH.KB.class-iso (RG.M.map (RF.M.map p)) (RH.M.map p)
        RH.PB.Equal[p.size,RH.M.At[p.size].MM.map p.matrix,RH.M.At[p.size].MM.map p.matrix,
         (RG.M.map (RF.M.map p)).idempotent,(RH.M.map p).idempotent,refl (RH.M.At[p.size].MM.map p.matrix)].iso >
       RH.KB.class (RH.M.map p)
    =< sym (RH.restrict-class p) > RH.restrict.1 (RF.KA.class p) } ;
 theorem (x : RF.KA.K0.R) : Id RH.KB.K0.R (RG.restrict.1 (RF.restrict.1 x)) (RH.restrict.1 x) =
  Agree[A,RH.KB.K0,setA,RH.KB.G.set,H.compose RF.KA.K0 RF.KB.K0 RH.KB.K0 RG.restrict RF.restrict,RH.restrict,at-class].at x ;
} ;

-- restriction along pointwise equal maps
module Pointwise (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (f f' : H.Hom A B)
 (e : (r : A.R) -> Id B.R (f.1 r) (f'.1 r)) {
 module RF = Over[A,B,setA,setB,f] ;
 module RF' = Over[A,B,setA,setB,f'] ;
 at-class (p : RF.PA.Projector) : Id RF.KB.K0.R (RF.restrict.1 (RF.KA.class p)) (RF'.restrict.1 (RF.KA.class p)) =
  calc RF.KB.K0.R { RF.restrict.1 (RF.KA.class p)
    =< RF.restrict-class p > RF.KB.class (RF.M.map p)
    =< RF.KB.class-iso (RF.M.map p) (RF'.M.map p)
        RF.PB.Equal[p.size,RF.M.At[p.size].MM.map p.matrix,RF'.M.At[p.size].MM.map p.matrix,
         (RF.M.map p).idempotent,(RF'.M.map p).idempotent,
         RF.M.At[p.size].MM.MY.mat-eq (RF.M.At[p.size].MM.map p.matrix) (RF'.M.At[p.size].MM.map p.matrix)
          (\ i j -> e (p.matrix i j))].iso >
       RF.KB.class (RF'.M.map p)
    =< sym (RF'.restrict-class p) > RF'.restrict.1 (RF.KA.class p) } ;
 theorem (x : RF.KA.K0.R) : Id RF.KB.K0.R (RF.restrict.1 x) (RF'.restrict.1 x) =
  Agree[A,RF.KB.K0,setA,RF.KB.G.set,RF.restrict,RF'.restrict,at-class].at x ;
} ;
