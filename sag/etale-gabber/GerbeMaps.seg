-- Maps of stack gerbes, and small models (C3).
--  (Map)    A band-preserving map e : G -> G' of stack gerbes is an
--           equivalence, so G = G' (STACKGERBES.Eq).  On loops at x,
--           beta' . ap e = beta with beta, beta' equivalences, so ap e is one.
--           For x, x' being an equivalence ap e : (x = x') -> (e x = e x') is a
--           proposition and a sheaf (EQUIVSHEAF: both path types are sheaves),
--           so it suffices to have a path x = x' (close, conn), and then J
--           reduces to loops.  The fibres of e are propositions (e is an
--           embedding), sheaves (X a stack, paths sheaves) and close-inhabited
--           (close x, close (e x = y)), so inhabited: e is an equivalence.
--  (Shrink) A large type O (U l+) with a band, sheaf paths that are a retract
--           of a small sheaf type P o o', merely connected, a stack, and a
--           split-surjective f : D -> O from a small D, is a stack gerbe on a
--           small model: Replacement gives Small = image of f in U l, with an
--           embedding j, which is an equivalence since f is onto; the band of
--           Small at a is beta_(j a) . ap j (as SPLITSMALL), the paths are a
--           retract of P, the stack condition is that of O through j.
--  (bands)  For o : O and a loop p, the band of Small at inv o along ap inv p is
--           beta_o p (j . inv is homotopic to the identity, J on the homotopy).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module SG = StackGerbes[l].Over[R,setR,axioms,sh] ;
 module SGe = SplitGerbe[l].Over[R,setR,axioms,sh] ;
 module UG = SG.UG ;
 module RP = Replacement[l,l+] ;
 -- ap of a composite through a large middle
 ap-comp (Z : U l) (O : U l+) (W : U l) (h : Z -> O) (k : O -> W) (z z' : Z) (p : Id Z z z') :
  Id (Id W (k (h z)) (k (h z'))) (Pr.ap Z W (\ x -> k (h x)) z z' p) (Hi.ap O W k (h z) (h z') (Hi.ap Z O h z z' p)) =
  idJ Z z (\ z2 p2 -> Id (Id W (k (h z)) (k (h z2))) (Pr.ap Z W (\ x -> k (h x)) z z2 p2) (Hi.ap O W k (h z) (h z2) (Hi.ap Z O h z z2 p2)))
   (refl (refl (k (h z)))) z' p ;
 -- (Map)
 module Map (G G' : SG.StackGerbe) (e : G.1 -> G'.1) (pres : SG.Preserves G.1 G'.1 G.2 G'.2 e) {
  X : U l = G.1 ;
  Y : U l = G'.1 ;
  band-equiv (x : X) : Pr.isEquiv (Id X x x) UG.Unit (SG.bnd G x) =
   AffineHLevels[l].Fibres[Id X x x,UG.Unit,UG.setU,SG.bnd G x].to-equiv (SG.band G x).2.1 ;
  band-equiv' (y : Y) : Pr.isEquiv (Id Y y y) UG.Unit (SG.bnd G' y) =
   AffineHLevels[l].Fibres[Id Y y y,UG.Unit,UG.setU,SG.bnd G' y].to-equiv (SG.band G' y).2.1 ;
  -- on loops
  back (x : X) : Pr.Equiv UG.Unit (Id Y (e x) (e x)) =
   ((band-equiv' (e x)).sec,Pr.qinv UG.Unit (Id Y (e x) (e x)) (band-equiv' (e x)).sec (SG.bnd G' (e x))
     (Pr.sec-ret (Id Y (e x) (e x)) UG.Unit (SG.bnd G' (e x)) (band-equiv' (e x))) (band-equiv' (e x)).sec-eq) ;
  loop-equiv (x : X) : Pr.isEquiv (Id X x x) (Id Y (e x) (e x)) (Pr.ap X Y e x x) =
   Equivalences[l].homotopy (Id X x x) (Id Y (e x) (e x))
    (Equivalences[l].compose (Id X x x) UG.Unit (Id Y (e x) (e x)) (SG.bnd G x,band-equiv x) (back x)) (Pr.ap X Y e x x)
    (\ lp -> trans (sym (Pr.sec-ret (Id Y (e x) (e x)) UG.Unit (SG.bnd G' (e x)) (band-equiv' (e x)) (Pr.ap X Y e x x lp)))
      (ap (band-equiv' (e x)).sec (pres x lp))) ;
  -- on paths
  path-equiv (x x' : X) : Pr.isEquiv (Id X x x') (Id Y (e x) (e x')) (Pr.ap X Y e x x') =
   sh.elim @l (Id X x x') (Pr.isEquiv (Id X x x') (Id Y (e x) (e x')) (Pr.ap X Y e x x'))
    (Prop331Paths[l].isEquiv-prop (Id X x x') (Id Y (e x) (e x')) (Pr.ap X Y e x x'))
    (SGe.EquivSheaf[Id X x x',Id Y (e x) (e x'),SG.gpd G' (e x) (e x'),Pr.ap X Y e x x'].theorem (SG.paths G x x') (SG.paths G' (e x) (e x')))
    (\ q -> idJ X x (\ z q2 -> Pr.isEquiv (Id X x z) (Id Y (e x) (e z)) (Pr.ap X Y e x z)) (loop-equiv x) x' q)
    (SG.conn G x x') ;
  -- the fibres
  Fib (y : Y) : U l = (x : X) * Id Y (e x) y ;
  fib-prop (y : Y) : Pr.isProp (Fib y) = Groupoid[l].emb-fib-prop X Y e path-equiv y ;
  fib-sheaf (y : Y) : ET.T.isModal @l (Fib y) =
   SL.modal-Sigma X (\ x -> Id Y (e x) y) (SG.stack G) (\ x -> SG.paths G' (e x) y) ;
  fib (y : Y) : Fib y =
   sh.elim @l X (Fib y) (fib-prop y) (fib-sheaf y)
    (\ x -> sh.elim @l (Id Y (e x) y) (Fib y) (fib-prop y) (fib-sheaf y) (\ q -> (x,q)) (SG.conn G' (e x) y)) (SG.inh G) ;
  equiv : Pr.isEquiv X Y e =
   Pr.qinv X Y e (\ y -> (fib y).1) (\ y -> (fib y).2)
    (\ x -> ap (\ w -> w.1) (fib-prop (e x) (fib (e x)) (x,refl (e x)))) ;
  theorem : Id SG.StackGerbe G G' = SG.Eq[G].theorem G' (e,equiv) pres ;
 } ;
 -- (Shrink)
 module Shrink (O : U l+) (P : O -> O -> U l)
  (toP : (o o' : O) -> Id O o o' -> P o o') (fromP : (o o' : O) -> P o o' -> Id O o o')
  (from-to : (o o' : O) (p : Id O o o') -> Id (Id O o o') (fromP o o' (toP o o' p)) p)
  (to-from : (o o' : O) (a : P o o') -> Id (P o o') (toP o o' (fromP o o' a)) a)
  (setP : (o o' : O) -> Pr.isSet (P o o')) (sheafP : (o o' : O) -> ET.T.isModal @l (P o o'))
  (conn : (o o' : O) -> Tr.Trunc[P o o'].carrier)
  (bnd0 : (o : O) -> Id O o o -> UG.Unit) (bnd0-equiv : (o : O) -> Hi.isEquiv (Id O o o) UG.Unit (bnd0 o))
  (bnd0-hom : (o : O) (p q : Id O o o) -> Id UG.Unit (bnd0 o (Hi.trans O o o o p q)) (UG.times (bnd0 o p) (bnd0 o q)))
  (stack : ET.T.isModal @(l+) O)
  (D : U l) (f : D -> O) (onto : (o : O) -> (d : D) * Id O (f d) o) (inh : sh.close D) {
  path-equiv (o o' : O) : Hi.isEquiv (P o o') (Id O o o') (fromP o o') =
   Hi.qinv (P o o') (Id O o o') (fromP o o') (toP o o') (from-to o o') (to-from o o') ;
  locally-small : RP.LocallySmall O = \ o o' -> (P o o',fromP o o',path-equiv o o') ;
  image : RP.Image[D,O,f] = images @l @(l+) D O locally-small f ;
  Small : U l = image.carrier ;
  j (a : Small) : O = image.inclusion a ;
  emb (a b : Small) : Hi.isEquiv (Id Small a b) (Id O (j a) (j b)) (Hi.ap Small O j a b) = image.embedding a b ;
  Fib (o : O) : U l+ = (a : Small) * Id O (j a) o ;
  fib-prop (o : O) : Hi.isProp (Fib o) = Groupoid[l+].emb-fib-prop Small O j emb o ;
  fib (o : O) : Fib o =
   (image.quotient (onto o).1,Hi.trans O (j (image.quotient (onto o).1)) (f (onto o).1) o (image.triangle (onto o).1) (onto o).2) ;
  inv (o : O) : Small = (fib o).1 ;
  j-inv (o : O) : Id O (j (inv o)) o = (fib o).2 ;
  inv-j (a : Small) : Id Small (inv (j a)) a =
   Hi.ap (Fib (j a)) Small (\ w -> w.1) (fib (j a)) (a,refl (j a)) (fib-prop (j a) (fib (j a)) (a,refl (j a))) ;
  -- the band, read through j
  ap-trans (a : Small) (p : Id Small a a) : (c : Small) (r : Id Small a c) ->
   Id (Id O (j a) (j c)) (Hi.ap Small O j a c (Pr.trans Small a a c p r))
    (Hi.trans O (j a) (j a) (j c) (Hi.ap Small O j a a p) (Hi.ap Small O j a c r)) = \ c r ->
   idJ Small a (\ c2 r2 -> Id (Id O (j a) (j c2)) (Hi.ap Small O j a c2 (Pr.trans Small a a c2 p r2))
    (Hi.trans O (j a) (j a) (j c2) (Hi.ap Small O j a a p) (Hi.ap Small O j a c2 r2)))
    (refl (Hi.ap Small O j a a p)) c r ;
  bnd (a : Small) (p : Id Small a a) : UG.Unit = bnd0 (j a) (Hi.ap Small O j a a p) ;
  bnd-equiv (a : Small) : Hi.isEquiv (Id Small a a) UG.Unit (bnd a) =
   (Equivalences[l+].compose (Id Small a a) (Id O (j a) (j a)) UG.Unit (Hi.ap Small O j a a,emb a a)
     (bnd0 (j a),bnd0-equiv (j a))).2 ;
  bnd-hom (a : Small) (p r : Id Small a a) : Id UG.Unit (bnd a (Pr.trans Small a a a p r)) (UG.times (bnd a p) (bnd a r)) =
   Hi.trans UG.Unit _ (bnd0 (j a) (Hi.trans O (j a) (j a) (j a) (Hi.ap Small O j a a p) (Hi.ap Small O j a a r))) _
    (Hi.ap (Id O (j a) (j a)) UG.Unit (bnd0 (j a)) _ _ (ap-trans a p a r))
    (bnd0-hom (j a) (Hi.ap Small O j a a p) (Hi.ap Small O j a a r)) ;
  band (a : Small) : SG.GB.Band Small a =
   (bnd a,AffineHLevels[l].Fibres[Id Small a a,UG.Unit,UG.setU,bnd a].from-equiv
     (new Pr.IsEquiv[Id Small a a,UG.Unit,bnd a,sec := (bnd-equiv a).sec,sec-eq := (bnd-equiv a).sec-eq,
       ret := (bnd-equiv a).ret,ret-eq := (bnd-equiv a).ret-eq]),bnd-hom a) ;
  -- (paths) a retract of P
  to-path (a b : Small) (r : P (j a) (j b)) : Id Small a b = (emb a b).sec (fromP (j a) (j b) r) ;
  to-P (a b : Small) (p : Id Small a b) : P (j a) (j b) = toP (j a) (j b) (Hi.ap Small O j a b p) ;
  retract (a b : Small) (p : Id Small a b) : Id (Id Small a b) (to-path a b (to-P a b p)) p =
   Hi.trans (Id Small a b) (to-path a b (to-P a b p)) ((emb a b).sec (Hi.ap Small O j a b p)) p
    (Hi.ap (Id O (j a) (j b)) (Id Small a b) (emb a b).sec _ _ (from-to (j a) (j b) (Hi.ap Small O j a b p)))
    (Hi.sec-ret (Id Small a b) (Id O (j a) (j b)) (Hi.ap Small O j a b) (emb a b) p) ;
  P-to-path (a b : Small) (r : P (j a) (j b)) : Id (P (j a) (j b)) (to-P a b (to-path a b r)) r =
   Hi.trans (P (j a) (j b)) (to-P a b (to-path a b r)) (toP (j a) (j b) (fromP (j a) (j b) r)) r
    (Hi.ap (Id O (j a) (j b)) (P (j a) (j b)) (toP (j a) (j b)) _ _ ((emb a b).sec-eq (fromP (j a) (j b) r)))
    (to-from (j a) (j b) r) ;
  gpd (a b : Small) : Pr.isSet (Id Small a b) =
   AffineHLevels[l+].set-from-equiv (Id Small a b) (P (j a) (j b)) (setP (j a) (j b)) (to-P a b)
    (Hi.qinv (Id Small a b) (P (j a) (j b)) (to-P a b) (to-path a b) (P-to-path a b) (retract a b)) ;
  paths (a b : Small) : ET.T.isModal @l (Id Small a b) =
   SL.modal-retract (P (j a) (j b)) (Id Small a b) (to-P a b) (to-path a b) (retract a b) (sheafP (j a) (j b)) ;
  -- (inh), (conn)
  inh-small : sh.close Small = sh.elim @l D (sh.close Small) (sh.proposition Small) (sh.modal Small)
   (\ d -> sh.inc Small (image.quotient d)) inh ;
  conn-small (a b : Small) : sh.close (Id Small a b) =
   Tr.Trunc[P (j a) (j b)].induction @l (\ t -> sh.close (Id Small a b)) (\ t -> sh.proposition (Id Small a b))
    (\ r -> sh.inc (Id Small a b) (to-path a b r)) (conn (j a) (j b)) ;
  -- (stack) through j
  module Stack (i : ET.I) {
   Q : U l = ET.G i ;
   obj : Hi.isEquiv O (Q -> O) (\ o g -> o) = stack i ;
   back (h : Q -> Small) : Small = inv (obj.sec (\ g -> j (h g))) ;
   at (h : Q -> Small) (g : Q) : Id Small (back h) (h g) =
    Hi.trans Small (back h) (inv (j (h g))) (h g)
     (Hi.ap O Small inv _ _ (Hi.ap (Q -> O) O (\ k -> k g) _ _ (obj.sec-eq (\ g2 -> j (h g2)))))
     (inv-j (h g)) ;
   constant (a : Small) : Id Small (back (\ g -> a)) a =
    Hi.trans Small (back (\ g -> a)) (inv (j a)) a
     (Hi.ap O Small inv _ _ (Hi.sec-ret O (Q -> O) (\ o g -> o) obj (j a))) (inv-j a) ;
   equiv : Pr.isEquiv Small (Q -> Small) (\ a g -> a) =
    Pr.qinv Small (Q -> Small) (\ a g -> a) back (\ h -> F.funext Q (\ g -> Small) (\ g -> back h) h (at h)) constant ;
  } ;
  gerbe : SG.StackGerbe = (Small,band,gpd,inh-small,conn-small,paths,\ i -> Stack[i].equiv) ;
  -- (bands) the band at inv o along ap inv p is beta_o p
  ap-inv-j (o o' : O) (p : Id O o o') :
   Id (Id O (j (inv o)) (j (inv o'))) (Hi.ap Small O j (inv o) (inv o') (Hi.ap O Small inv o o' p)) (Hi.ap O O (\ x -> j (inv x)) o o' p) =
   idJ O o (\ o2 p2 -> Id (Id O (j (inv o)) (j (inv o2))) (Hi.ap Small O j (inv o) (inv o2) (Hi.ap O Small inv o o2 p2))
     (Hi.ap O O (\ x -> j (inv x)) o o2 p2)) (refl (refl (j (inv o)))) o' p ;
  ap-id (o o' : O) (p : Id O o o') : Id (Id O o o') (Hi.ap O O (\ x -> x) o o' p) p =
   idJ O o (\ o2 p2 -> Id (Id O o o2) (Hi.ap O O (\ x -> x) o o2 p2) p2) (refl (refl o)) o' p ;
  homotopy : Id (O -> O) (\ x -> j (inv x)) (\ x -> x) =
   Axioms[l+].FunExtLemmas[fe @(l+)].funext O (\ x -> O) (\ x -> j (inv x)) (\ x -> x) j-inv ;
  inv-bnd (o : O) (p : Id O o o) : Id UG.Unit (bnd (inv o) (Hi.ap O Small inv o o p)) (bnd0 o p) =
   Hi.trans UG.Unit _ (bnd0 (j (inv o)) (Hi.ap O O (\ x -> j (inv x)) o o p)) _
    (Hi.ap (Id O (j (inv o)) (j (inv o))) UG.Unit (bnd0 (j (inv o))) _ _ (ap-inv-j o o p))
    (Hi.trans UG.Unit _ (bnd0 o (Hi.ap O O (\ x -> x) o o p)) _
     (idJ (O -> O) (\ x -> j (inv x)) (\ k h -> Id UG.Unit (bnd0 (j (inv o)) (Hi.ap O O (\ x -> j (inv x)) o o p)) (bnd0 (k o) (Hi.ap O O k o o p)))
       (refl (bnd0 (j (inv o)) (Hi.ap O O (\ x -> j (inv x)) o o p))) (\ x -> x) homotopy)
     (Hi.ap (Id O o o) UG.Unit (bnd0 o) _ _ (ap-id o o p))) ;
 } ;
} ;
