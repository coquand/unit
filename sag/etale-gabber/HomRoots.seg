-- rho(H') = 1 (gabber-recollement, proof of Proposition `cheap`; CHEAP-DESIGN.md,
-- section 2).  Setting of POWERCLASS with n = n0 + 1, and frame data wP, wQ
-- of the descended P(V)^v, P(W)^v with projectors p_V, p_W.  Assume:
--  (good)   rho(p_V) = 1 and rho(p_W) = 1 in K = K_0(Alg) (x) Q (RATIONAL),
--           with ranks N_V, N_W;
--  (rank)   the descended H' merely has bases of rank N at every x (HOMBASES),
--           and N^n = N_V N_W in K_0.
-- Then rho(q) = 1 for q = p_H'.
--  (iota)   rho(a, s) = 1 gives iota a = iota s: iota a = iota a (iota s s^-1)
--           = iota s (iota a s^-1) = iota s.
--  (power)  iota([q])^n = iota([q]^n) = iota([p_V^T][p_W])     (POWERCLASS)
--           = iota(N_V) iota(N_W)       (iota, with rho(p_V^T) = 1 by TRANSPOSES)
--           = iota(N^n) = iota(N)^n, so rho(q)^n = (iota(N) N^-1)^n = 1.
--  (roots)  [q] - N vanishes on a cover (LOCALFREE.Cover; K_0's N is the class
--           of 1_N, TRANSPOSES.nat-free), so ROOTS gives rho(q) = 1; the goal
--           is a proposition, so the mere cover suffices.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TM.GB.AGerbe)
  (n0 : Nat) (Lambda : TM.Family[C.Spec Alg,G].Weighted (\ a -> TM.UG.power a (suc n0))) {
  module PC = PowerClass[l].Over[R,setR,axioms].At[Alg,fp,G,suc n0,Lambda] ;
  module RT = Roots[l].Over[Alg.ring,Alg.set] ;
  module K = RT.K ;
  module RQ = RT.RQ ;
  module LQ = RT.LQ ;
  module PQ = RT.PQ ;
  module TT = Transposes[l].Over[Alg.ring,Alg.set] ;
  -- (iota)
  iota-eq (a s : K.K0.R) (hs : RQ.Positive s) (h : Id RQ.K.R (RQ.rho a s hs) RQ.K.o) : Id RQ.K.R (RT.iota a) (RT.iota s) =
   calc RQ.K.R { RT.iota a
     =< sym (RQ.K.mulO (RT.iota a)) > RQ.K.mul (RT.iota a) RQ.K.o
     =< ap (RQ.K.mul (RT.iota a)) (sym (RQ.inverse-law s hs)) > RQ.K.mul (RT.iota a) (RQ.K.mul (RT.iota s) (RQ.inverse s hs))
     =< LQ.mul-swap (RT.iota a) (RT.iota s) (RQ.inverse s hs) > RQ.K.mul (RT.iota s) (RQ.rho a s hs)
     =< ap (RQ.K.mul (RT.iota s)) h > RQ.K.mul (RT.iota s) RQ.K.o
     =< RQ.K.mulO (RT.iota s) > RT.iota s } ;
  one-power : (m : Nat) -> Id RQ.K.R (PQ.power RQ.K.o m) RQ.K.o = split {
   zero -> refl RQ.K.o ;
   suc m | h -> trans (ap (RQ.K.mul RQ.K.o) h) (RQ.K.mulO RQ.K.o) } ;
  module Pair (V W : PC.DA.Fam.TF.Twisted) (r : Nat) (fv : PC.DA.Fam.Framed V.1 r)
   (bl : (x : PC.DA.X) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier)
   (dH : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PC.DA.Fam.Hom[W,V].descended].Data) {
   module PP = PC.Pair[V,W,r,fv,bl,dH] ;
   module Good (wP : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PP.PV.descended].Data)
    (wQ : FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,PP.PW.descended].Data)
    (N0 NV0 NW0 : Nat)
    (bases : (x : PC.DA.X) -> Tr.Trunc[LF.Basis[PP.L.H'.descended x,suc N0]].carrier)
    (ranks : Id K.K0.R (RT.PK.power (RT.IK.nat (suc N0)) (suc n0)) (K.K0.mul (RT.IK.nat (suc NV0)) (RT.IK.nat (suc NW0)))) {
    module PR = PP.Product[wP,wQ] ;
    q : K.PJ.Projector = PP.L.PH.projector ;
    -- (good)
    module Hypotheses
     (gv : Id RQ.K.R (RQ.rho (K.class PR.HC.DP.projector) (RT.IK.nat (suc NV0)) (RQ.positive NV0)) RQ.K.o)
     (gw : Id RQ.K.R (RQ.rho (K.class PR.HC.DQ.projector) (RT.IK.nat (suc NW0)) (RQ.positive NW0)) RQ.K.o) {
     gvt : Id RQ.K.R (RQ.rho (K.class PR.HC.transpose) (RT.IK.nat (suc NV0)) (RQ.positive NV0)) RQ.K.o =
      TT.Rho[NV0].Of[PR.HC.DP.projector,gv].theorem ;
     iota-mul (a b : K.K0.R) : Id RQ.K.R (RT.iota (K.K0.mul a b)) (RQ.K.mul (RT.iota a) (RT.iota b)) = RQ.iota.2.2.2 a b ;
     -- (power)
     key : Id RQ.K.R (PQ.power (RT.iota (K.class q)) (suc n0)) (PQ.power (RT.iota (RT.IK.nat (suc N0))) (suc n0)) =
      calc RQ.K.R { PQ.power (RT.iota (K.class q)) (suc n0)
        =< sym (AffinePowers[l].power-map K.K0 RQ.K RQ.iota (K.class q) (suc n0)) > RT.iota (RT.PK.power (K.class q) (suc n0))
        =< ap RT.iota PR.equation > RT.iota (K.K0.mul (K.class PR.HC.transpose) (K.class PR.HC.DQ.projector))
        =< iota-mul (K.class PR.HC.transpose) (K.class PR.HC.DQ.projector) >
           RQ.K.mul (RT.iota (K.class PR.HC.transpose)) (RT.iota (K.class PR.HC.DQ.projector))
        =< cong2 RQ.K.R RQ.K.mul _ _ _ _
            (iota-eq (K.class PR.HC.transpose) (RT.IK.nat (suc NV0)) (RQ.positive NV0) gvt)
            (iota-eq (K.class PR.HC.DQ.projector) (RT.IK.nat (suc NW0)) (RQ.positive NW0) gw) >
           RQ.K.mul (RT.iota (RT.IK.nat (suc NV0))) (RT.iota (RT.IK.nat (suc NW0)))
        =< sym (iota-mul (RT.IK.nat (suc NV0)) (RT.IK.nat (suc NW0))) > RT.iota (K.K0.mul (RT.IK.nat (suc NV0)) (RT.IK.nat (suc NW0)))
        =< ap RT.iota (sym ranks) > RT.iota (RT.PK.power (RT.IK.nat (suc N0)) (suc n0))
        =< AffinePowers[l].power-map K.K0 RQ.K RQ.iota (RT.IK.nat (suc N0)) (suc n0) > PQ.power (RT.iota (RT.IK.nat (suc N0))) (suc n0) } ;
     inverse : RQ.K.R = RQ.inverse (RT.IK.nat (suc N0)) (RQ.positive N0) ;
     power : Id RQ.K.R (PQ.power (RQ.rho (K.class q) (RT.IK.nat (suc N0)) (RQ.positive N0)) (suc n0)) RQ.K.o =
      calc RQ.K.R { PQ.power (RQ.K.mul (RT.iota (K.class q)) inverse) (suc n0)
        =< PQ.power-mul (RT.iota (K.class q)) inverse (suc n0) > RQ.K.mul (PQ.power (RT.iota (K.class q)) (suc n0)) (PQ.power inverse (suc n0))
        =< ap (\ t -> RQ.K.mul t (PQ.power inverse (suc n0))) key >
           RQ.K.mul (PQ.power (RT.iota (RT.IK.nat (suc N0))) (suc n0)) (PQ.power inverse (suc n0))
        =< sym (PQ.power-mul (RT.iota (RT.IK.nat (suc N0))) inverse (suc n0)) > PQ.power (RQ.K.mul (RT.iota (RT.IK.nat (suc N0))) inverse) (suc n0)
        =< ap (\ t -> PQ.power t (suc n0)) (RQ.inverse-law (RT.IK.nat (suc N0)) (RQ.positive N0)) > PQ.power RQ.K.o (suc n0)
        =< one-power (suc n0) > RQ.K.o } ;
     -- (roots)
     module CV = LF.At[Alg,fp,PP.L.H'.descended].Cover[dH,suc N0,bases] ;
     module FromCover (cv : CV.Goal) {
      vanishes (i : Fin cv.1) :
       Nilpotence[l].Vanishes Alg.ring Alg.set (cv.2.1.1 i) (K.K0.add (K.class q) (K.K0.neg (RT.IK.nat (suc N0)))) =
       subst (\ t -> Nilpotence[l].Vanishes Alg.ring Alg.set (cv.2.1.1 i) (K.K0.add (K.class q) (K.K0.neg t)))
        (sym (TT.nat-free (suc N0))) (cv.2.2 i) ;
      theorem : Id RQ.K.R (RQ.rho (K.class q) (RT.IK.nat (suc N0)) (RQ.positive N0)) RQ.K.o =
       RT.Lemma[q,N0,n0,cv.1,cv.2.1,vanishes,power].theorem ;
     } ;
     theorem : Id RQ.K.R (RQ.rho (K.class q) (RT.IK.nat (suc N0)) (RQ.positive N0)) RQ.K.o =
      Tr.Trunc[CV.Goal].induction @l (\ t -> Id RQ.K.R (RQ.rho (K.class q) (RT.IK.nat (suc N0)) (RQ.positive N0)) RQ.K.o)
       (\ t -> RQ.Q.set _ _) (\ cv -> FromCover[cv].theorem) CV.theorem ;
    } ;
   } ;
  } ;
 } ;
} ;
