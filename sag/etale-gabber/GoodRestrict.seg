-- Goodness is stable under base change (gabber-recollement, Proposition
-- `cheap`: the restrictions of good modules are good).  Let phi : Alg -> Alg'
-- be a map of f.p. R-algebras, pi y = y . phi : Spec Alg' -> Spec Alg, Mx a
-- family of modules on Spec Alg and My = Mx . pi.
--  (data)  Frame data (s_k, d_k) of Mx give frame data (s_k . pi, d_k . pi)
--     of My (FRAMEPROJECTOR.Data); the projector p' has the entries
--     back(y |-> d_i(s_j(pi y))) = phi(p_ij), both having the value
--     d_i(s_j) at pi y (SQC), so [p'] = [phi p] = h [p], h : K_0(Alg) ->
--     K_0(Alg') the restriction (K0RESTRICTION; as in LOCALFREE.Local).
--  (rho)  rho(u) = 1 at N gives rho(h u) = 1 at N (RHOMAPS).
--  (good)  Let rho([p_w]) = 1 at N for all frame data w of Mx, and let Mx
--     merely have frame data.  Then for frame data w' of My,
--     [p_w'] = [p'_w] (REPRESENTATIONS.Compare) = h [p_w], so rho([p_w']) = 1;
--     the goal is a proposition, so the mere w suffices.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (Alg' : C.Algebra) (fp' : P.FP Alg') (phi : C.Hom Alg Alg')
  (Mx : C.Spec Alg -> MD.Module) {
  point (y : C.Spec Alg') : C.Spec Alg = C.compose Alg Alg' C.base y phi ;
  My (y : C.Spec Alg') : MD.Module = Mx (point y) ;
  module FX = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Mx] ;
  module FY = FrameProjector[l].Over[R,setR,axioms].At[Alg',fp',My] ;
  module KX = K0[l].Over[Alg.ring,Alg.set] ;
  module KY = K0[l].Over[Alg'.ring,Alg'.set] ;
  module RI = K0Restriction[l].Over[Alg.ring,Alg'.ring,Alg.set,Alg'.set,phi.1] ;
  module TX = Transposes[l].Over[Alg.ring,Alg.set] ;
  module TY = Transposes[l].Over[Alg'.ring,Alg'.set] ;
  h : H.Hom KX.K0 KY.K0 = RI.restrict ;
  -- (data)
  module Data (w : FX.Data) {
   module FA = FX.From[w] ;
   restricted : FY.Data = new FY.Data[w.size,\ k y -> w.section k (point y),\ k y -> w.form k (point y),\ y -> w.law (point y)] ;
   module FW = FY.From[restricted] ;
   restricted-entry (i j : Fin w.size) : Id Alg'.ring.R (FW.entry i j) (phi.1.1 (FA.entry i j)) =
    FY.ext (FW.entry i j) (phi.1.1 (FA.entry i j)) (\ y -> trans (FW.beta i j y) (sym (FA.beta i j (point y)))) ;
   module MW = RI.M.At[w.size].MM ;
   class : Id KY.K0.R (h.1 (KX.class FA.projector)) (KY.class FW.projector) =
    trans (RI.restrict-class FA.projector)
     (KY.class-iso (RI.M.map FA.projector) FW.projector
      KY.PJ.Equal[w.size,MW.map FA.entry,FW.entry,(RI.M.map FA.projector).idempotent,
       FW.MN.mat-eq (FW.MN.mmul FW.entry FW.entry) FW.entry FW.idempotent-at,
       MW.MY.mat-eq (MW.map FA.entry) FW.entry (\ i j -> sym (restricted-entry i j))].iso) ;
  } ;
  -- (good)
  Good (N0 : Nat) : U l = (w : FX.Data) -> Id TX.RQ.K.R (TX.Rho[N0].rho (KX.class FX.From[w].projector)) TX.RQ.K.o ;
  Good' (N0 : Nat) : U l = (w : FY.Data) -> Id TY.RQ.K.R (TY.Rho[N0].rho (KY.class FY.From[w].projector)) TY.RQ.K.o ;
  module Restrict (N0 : Nat) (good : Good N0) (mere : Tr.Trunc[FX.Data].carrier) (w' : FY.Data) {
   Goal : U l = Id TY.RQ.K.R (TY.Rho[N0].rho (KY.class FY.From[w'].projector)) TY.RQ.K.o ;
   module From (w : FX.Data) {
    module D = Data[w] ;
    -- [p_w'] = [p'_w] = h [p_w]
    class : Id KY.K0.R (KY.class FY.From[w'].projector) (h.1 (KX.class D.FA.projector)) =
     trans (Representations[l].Over[R,setR,axioms].At[Alg',fp',My].Compare[FY.From[w'].projector,D.FW.projector,
       FY.From[w'].representation,D.FW.representation].same) (sym D.class) ;
    theorem : Goal = subst (\ t -> Id TY.RQ.K.R (TY.Rho[N0].rho t) TY.RQ.K.o) (sym class) (RhoMaps[l].Over[Alg.ring,Alg'.ring,Alg.set,Alg'.set,h,N0].theorem (KX.class D.FA.projector) (good w)) ;
   } ;
   theorem : Goal = TC.rec FX.Data @l Goal (TY.RQ.Q.set _ _) (\ w -> From[w].theorem) mere ;
  } ;
  restrict (N0 : Nat) (good : Good N0) (mere : Tr.Trunc[FX.Data].carrier) : Good' N0 = \ w' -> Restrict[N0,good,mere,w'].theorem ;
 } ;
} ;
