-- Bases of standard images (LOCALFREE.Basis, MATRIXTENSOR.I).  Over R,
-- I e = { w in R^N | e w = w } for an N x N matrix e.
--  (sum)  If (e_i, c_i) is a basis of P of rank r and (f_j, d_j) one of Q
--     of rank s, P + Q has the basis indexed by Fin (r + s) (BLOCKS: injl,
--     injr, side): the vectors (e_i, 0) and (0, f_j), the forms
--     (p, q) |-> c_i(p) and (p, q) |-> d_j(q).  The values are c_i(e_i'),
--     c_i(0) = 0, d_j(0) = 0, d_j(f_j'), i.e. the delta of r + s on its four
--     blocks (Blocks.Sums.delta-ll ..); the law holds by components: the
--     first component of sum_x c_x(p,q) v_x is
--         sum_i c_i(p) e_i + sum_j d_j(q) 0 = p + 0 = p,
--     and the second one is q likewise.
--  (unit)  I 1_m has the columns frame of PRESENTEDCLASS.Columns (1 1 = 1),
--     whose values are the entries of 1_m: a basis of rank m.
--  (head)  For D = blk 1 0 0 0 of size L + L (VECTORBLOCKS), w |-> w_l and
--     u |-> cat u 0 are inverse linear maps I D ~ I 1_L: cat w_l 0 = D w = w
--     (head), and D (cat u 0) = cat u 0 (head-cat).  So I D = I 1_L has a
--     basis of rank L.
--  (conjugate)  For X X = X and P' P = 1, u = X P' and v = P X are an
--     equivalence (EQUIVALENCE) of P X P' = (P X) P' and X:
--         v u = (P X)(X P') = (P (X X)) P' = (P X) P',
--         u v = X (P' (P X)) = X X = X,          since P' (P Y) = (P' P) Y = Y,
--         X u = (X X) P' = X P',   v X = P (X X) = P X,
--         ((P X) P') (P X) = (P X) (P' (P X)) = (P X) X = P X,
--     so I ((P X) P') = I X (MATRIXTENSOR.Equivalent).
--  (block)  I (dsum X 1_m) = I X + I 1_m (MATRIXTENSOR.Block), so a basis of
--     I X of rank k gives one of I (dsum X 1_m) of rank k + m, by (sum) and
--     (unit).
--  (standard)  For L, m and P, P' of size L + L with P' P = 1, the module
--         I (dsum ((P D) P') 1_m),
--     i.e. MT.I (plus (plus L L) m) (DS.dsum (MR.mmul (MR.mmul P D) P') MR.mone)
--     with DS = DirectSums[l].Over[R,setR,plus L L,m], MR the matrices of size
--     L + L and of size m, has a basis of rank L + m: I ((P D) P') = I D
--     (conjugate; D D = D by head-head) has one of rank L (head), then (block).
-- Bases move along identities of modules (by J).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module D = MnSums[l].Over[R] ;
 module BS = Blocks[l].Sums[R] ;
 -- bases move along identities of modules
 move (P Q : MD.Module) (h : Id MD.Module P Q) (r : Nat) (b : LF.Basis[P,r]) : LF.Basis[Q,r] =
  idJ MD.Module P (\ M p -> LF.Basis[M,r]) b Q h ;
 -- (sum)
 module SumBasis (P Q : MD.Module) (r s : Nat) (bp : LF.Basis[P,r]) (bq : LF.Basis[Q,s]) {
  module PQ = MS.Pair[P,Q] ;
  module MA = Alg73[l].MA[MD.ring,P] ;
  module MB = Alg73[l].MA[MD.ring,Q] ;
  module LP = ModuleSumLaws[l].Over[R,setR,P] ;
  module LQ = ModuleSumLaws[l].Over[R,setR,Q] ;
  module LS = ModuleSumLaws[l].Over[R,setR,MS.plus P Q] ;
  module SP = ModuleFiniteSums[l].Over[R,setR,P] ;
  module SQ = ModuleFiniteSums[l].Over[R,setR,Q] ;
  Side : U l = Plus (Fin r) (Fin s) ;
  side (x : Fin (plus r s)) : Side = Blocks[l].side s r x ;
  il (i : Fin r) : Fin (plus r s) = Blocks[l].injl s r i ;
  ir (j : Fin s) : Fin (plus r s) = Blocks[l].injr s r j ;
  join (e : Side) : Fin (plus r s) = Blocks[l].join r s e ;
  c (i : Fin r) : FR.HM.At[P,MD.regular].S.E = bp.frame.form i ;
  d (j : Fin s) : FR.HM.At[Q,MD.regular].S.E = bq.frame.form j ;
  vector-at : Side -> PQ.Carrier = split {
   inl i -> (bp.frame.vector i,Q.mz) ;
   inr j -> (P.mz,bq.frame.vector j) } ;
  form-at : Side -> FR.HM.At[MS.plus P Q,MD.regular].S.E = split {
   inl i -> (\ z -> (c i).1 z.1,\ z z' -> (c i).2.1 z.1 z'.1,\ t z -> (c i).2.2 t z.1) ;
   inr j -> (\ z -> (d j).1 z.2,\ z z' -> (d j).2.1 z.2 z'.2,\ t z -> (d j).2.2 t z.2) } ;
  vector (x : Fin (plus r s)) : PQ.Carrier = vector-at (side x) ;
  form (x : Fin (plus r s)) : FR.HM.At[MS.plus P Q,MD.regular].S.E = form-at (side x) ;
  -- the values on the four blocks
  value-at : (e e' : Side) -> Id R.R ((form-at e).1 (vector-at e')) (D.delta (plus r s) (join e) (join e')) = split {
   inl i -> split {
    inl j -> trans (bp.dual i j) (sym (BS.delta-ll s r i j)) ;
    inr j -> trans (FR.Form[P,c i].zero) (sym (BS.delta-lr s r i j)) } ;
   inr i -> split {
    inl j -> trans (FR.Form[Q,d i].zero) (sym (BS.delta-rl s r i j)) ;
    inr j -> trans (bq.dual i j) (sym (BS.delta-rr s r i j)) } } ;
  dual (x y : Fin (plus r s)) : Id R.R ((form x).1 (vector y)) (D.delta (plus r s) x y) =
   calc R.R { (form x).1 (vector y)
     =< value-at (side x) (side y) > D.delta (plus r s) (join (side x)) (join (side y))
     =< trans (ap (\ t -> D.delta (plus r s) t (join (side y))) (Blocks[l].join-side s r x))
         (ap (D.delta (plus r s) x) (Blocks[l].join-side s r y)) > D.delta (plus r s) x y } ;
  -- the law, by components
  term-at (z : PQ.Carrier) (e : Side) : PQ.Carrier = (MS.plus P Q).sm ((form-at e).1 z) (vector-at e) ;
  term (z : PQ.Carrier) (x : Fin (plus r s)) : PQ.Carrier = term-at z (side x) ;
  first-l (z : PQ.Carrier) (i : Fin r) : Id P.M (term z (il i)).1 (P.sm ((c i).1 z.1) (bp.frame.vector i)) =
   ap (\ e -> (term-at z e).1) (Blocks[l].side-injl s r i) ;
  first-r (z : PQ.Carrier) (j : Fin s) : Id P.M (term z (ir j)).1 P.mz =
   trans (ap (\ e -> (term-at z e).1) (Blocks[l].side-injr s r j)) (MA.sm-zr ((d j).1 z.2)) ;
  second-l (z : PQ.Carrier) (i : Fin r) : Id Q.M (term z (il i)).2 Q.mz =
   trans (ap (\ e -> (term-at z e).2) (Blocks[l].side-injl s r i)) (MB.sm-zr ((c i).1 z.1)) ;
  second-r (z : PQ.Carrier) (j : Fin s) : Id Q.M (term z (ir j)).2 (Q.sm ((d j).1 z.2) (bq.frame.vector j)) =
   ap (\ e -> (term-at z e).2) (Blocks[l].side-injr s r j) ;
  module First = LS.Map[P,\ z -> z.1,refl P.mz,\ u v -> refl (P.madd u.1 v.1)] ;
  module Second = LS.Map[Q,\ z -> z.2,refl Q.mz,\ u v -> refl (Q.madd u.2 v.2)] ;
  first (z : PQ.Carrier) : Id P.M (LS.Sum.sum (plus r s) (term z)).1 z.1 =
   calc P.M { (LS.Sum.sum (plus r s) (term z)).1
     =< First.sum (plus r s) (term z) > SP.sum (plus r s) (\ x -> (term z x).1)
     =< LP.sum-plus s r (\ x -> (term z x).1) >
        P.madd (SP.sum r (\ i -> (term z (il i)).1)) (SP.sum s (\ j -> (term z (ir j)).1))
     =< cong2 P.M P.madd _ _ _ _ (SP.congruent r _ _ (first-l z)) (LP.sum-zero s _ (first-r z)) >
        P.madd (SP.sum r (\ i -> P.sm ((c i).1 z.1) (bp.frame.vector i))) P.mz
     =< P.maddZ (SP.sum r (\ i -> P.sm ((c i).1 z.1) (bp.frame.vector i))) >
        SP.sum r (\ i -> P.sm ((c i).1 z.1) (bp.frame.vector i))
     =< bp.frame.law z.1 > z.1 } ;
  second (z : PQ.Carrier) : Id Q.M (LS.Sum.sum (plus r s) (term z)).2 z.2 =
   calc Q.M { (LS.Sum.sum (plus r s) (term z)).2
     =< Second.sum (plus r s) (term z) > SQ.sum (plus r s) (\ x -> (term z x).2)
     =< LQ.sum-plus s r (\ x -> (term z x).2) >
        Q.madd (SQ.sum r (\ i -> (term z (il i)).2)) (SQ.sum s (\ j -> (term z (ir j)).2))
     =< cong2 Q.M Q.madd _ _ _ _ (LQ.sum-zero r _ (second-l z)) (SQ.congruent s _ _ (second-r z)) >
        Q.madd Q.mz (SQ.sum s (\ j -> Q.sm ((d j).1 z.2) (bq.frame.vector j)))
     =< MB.mzl (SQ.sum s (\ j -> Q.sm ((d j).1 z.2) (bq.frame.vector j))) >
        SQ.sum s (\ j -> Q.sm ((d j).1 z.2) (bq.frame.vector j))
     =< bq.frame.law z.2 > z.2 } ;
  frame : FR.Frame[MS.plus P Q,plus r s] = new FR.Frame[MS.plus P Q,plus r s,vector,form,
   \ z -> PQ.pair-eq _ _ _ _ (first z) (second z)] ;
  basis : LF.Basis[MS.plus P Q,plus r s] = new LF.Basis[MS.plus P Q,plus r s,frame,dual] ;
 } ;
 -- (unit)
 module UnitBasis (m : Nat) {
  module MR = MnAlgebra[l].Over[R,setR,m] ;
  module CO = PresentedClass[l].Over[R,setR,axioms].Columns[m,MR.mone,MR.m-one-left MR.mone] ;
  basis : LF.Basis[MT.I m MR.mone,m] = new LF.Basis[MT.I m MR.mone,m,CO.frame,CO.column-value] ;
 } ;
 -- (head)
 module HeadBasis (L : Nat) {
  module VB = VectorBlocks[l].Over[R,setR,L] ;
  module ID = MT.Image[plus L L,VB.D] ;
  module IO = MT.Image[L,VB.V.MR.mone] ;
  to (w : ID.S.E) : IO.S.E = (VB.lhalf w.1,VB.V.act-one (VB.lhalf w.1)) ;
  from (u : IO.S.E) : ID.S.E = (VB.cat u.1 VB.V.vzero,VB.head-cat u.1) ;
  to-from (u : IO.S.E) : Id IO.S.E (to (from u)) u = IO.ext (to (from u)) u (VB.lhalf-cat u.1 VB.V.vzero) ;
  from-to (w : ID.S.E) : Id ID.S.E (from (to w)) w = ID.ext (from (to w)) w (trans (sym (VB.head w.1)) w.2) ;
  image : Id MD.Module (MT.I (plus L L) VB.D) (MT.I L VB.V.MR.mone) =
   SIP.sip (MT.I (plus L L) VB.D) (MT.I L VB.V.MR.mone) ((to,Pr.qinv ID.S.E IO.S.E to from to-from from-to),
    \ w w' -> IO.ext _ _ (refl (VB.lhalf (VB.V2.vadd w.1 w'.1))),
    \ t w -> IO.ext _ _ (refl (VB.lhalf (VB.V2.vscale t w.1)))) ;
  basis : LF.Basis[MT.I (plus L L) VB.D,L] =
   move (MT.I L VB.V.MR.mone) (MT.I (plus L L) VB.D) (Pr1.sym MD.Module (MT.I (plus L L) VB.D) (MT.I L VB.V.MR.mone) image) L
    UnitBasis[L].basis ;
  -- D D = D
  idempotent : Id VB.V2.MR.Mat (VB.V2.MR.mmul VB.D VB.D) VB.D =
   VB.V2.mat-act (VB.V2.MR.mmul VB.D VB.D) VB.D (\ w -> trans (sym (VB.V2.act-mul VB.D VB.D w)) (VB.head-head w)) ;
 } ;
 -- (conjugate)
 module Conjugate (N : Nat) (X P P' : Vectors[l].Over[R,setR,N].MR.Mat)
  (idem : Id Vectors[l].Over[R,setR,N].MR.Mat (Vectors[l].Over[R,setR,N].MR.mmul X X) X)
  (left : Id Vectors[l].Over[R,setR,N].MR.Mat (Vectors[l].Over[R,setR,N].MR.mmul P' P) Vectors[l].Over[R,setR,N].MR.mone) {
  module MR = Vectors[l].Over[R,setR,N].MR ;
  module EQ = Equivalence[l].Over[R,setR,N] ;
  PX : MR.Mat = MR.mmul P X ;
  conjugate : MR.Mat = MR.mmul PX P' ;
  u : MR.Mat = MR.mmul X P' ;
  -- P' (P Y) = Y
  cancel (Y : MR.Mat) : Id MR.Mat (MR.mmul P' (MR.mmul P Y)) Y =
   calc MR.Mat { MR.mmul P' (MR.mmul P Y)
     =< MR.m-mulA P' P Y > MR.mmul (MR.mmul P' P) Y
     =< ap (\ Z -> MR.mmul Z Y) left > MR.mmul MR.mone Y
     =< MR.m-one-left Y > Y } ;
  vu : Id MR.Mat (MR.mmul PX u) conjugate =
   calc MR.Mat { MR.mmul PX u
     =< MR.m-mulA PX X P' > MR.mmul (MR.mmul PX X) P'
     =< ap (\ Z -> MR.mmul Z P') (sym (MR.m-mulA P X X)) > MR.mmul (MR.mmul P (MR.mmul X X)) P'
     =< ap (\ Z -> MR.mmul (MR.mmul P Z) P') idem > conjugate } ;
  uv : Id MR.Mat (MR.mmul u PX) X =
   calc MR.Mat { MR.mmul u PX
     =< sym (MR.m-mulA X P' PX) > MR.mmul X (MR.mmul P' PX)
     =< ap (MR.mmul X) (cancel X) > MR.mmul X X
     =< idem > X } ;
  yu : Id MR.Mat (MR.mmul X u) u =
   calc MR.Mat { MR.mmul X u
     =< MR.m-mulA X X P' > MR.mmul (MR.mmul X X) P'
     =< ap (\ Z -> MR.mmul Z P') idem > u } ;
  vy : Id MR.Mat (MR.mmul PX X) PX =
   calc MR.Mat { MR.mmul PX X
     =< sym (MR.m-mulA P X X) > MR.mmul P (MR.mmul X X)
     =< ap (MR.mmul P) idem > PX } ;
  xv : Id MR.Mat (MR.mmul conjugate PX) PX =
   calc MR.Mat { MR.mmul conjugate PX
     =< sym (MR.m-mulA PX P' PX) > MR.mmul PX (MR.mmul P' PX)
     =< ap (MR.mmul PX) (cancel X) > MR.mmul PX X
     =< vy > PX } ;
  equivalent : EQ.Equivalent[conjugate,X] = new EQ.Equivalent[conjugate,X,u,PX,vu,uv,yu,vy,xv] ;
  image : Id MD.Module (MT.I N conjugate) (MT.I N X) = MT.Equivalent[N,conjugate,X,equivalent].image ;
 } ;
 -- (block)
 module BlockBasis (N m k : Nat) (X : Vectors[l].Over[R,setR,N].MR.Mat) (bx : LF.Basis[MT.I N X,k]) {
  module DS = DirectSums[l].Over[R,setR,N,m] ;
  module UB = UnitBasis[m] ;
  module BL = MT.Block[N,m,X,UB.MR.mone] ;
  basis : LF.Basis[MT.I (plus N m) (DS.dsum X UB.MR.mone),plus k m] =
   move (MS.plus (MT.I N X) (MT.I m UB.MR.mone)) (MT.I (plus N m) (DS.dsum X UB.MR.mone))
    (Pr1.sym MD.Module (MT.I (plus N m) (DS.dsum X UB.MR.mone)) (MS.plus (MT.I N X) (MT.I m UB.MR.mone)) BL.image)
    (plus k m) (SumBasis[MT.I N X,MT.I m UB.MR.mone,k,m,bx,UB.basis].basis) ;
 } ;
 -- (standard)
 module Standard (L m : Nat) (P P' : Vectors[l].Over[R,setR,plus L L].MR.Mat)
  (left : Id Vectors[l].Over[R,setR,plus L L].MR.Mat (Vectors[l].Over[R,setR,plus L L].MR.mmul P' P)
    Vectors[l].Over[R,setR,plus L L].MR.mone) {
  module HB = HeadBasis[L] ;
  module CJ = Conjugate[plus L L,HB.VB.D,P,P',HB.idempotent,left] ;
  module DS = DirectSums[l].Over[R,setR,plus L L,m] ;
  conjugate-basis : LF.Basis[MT.I (plus L L) CJ.conjugate,L] =
   move (MT.I (plus L L) HB.VB.D) (MT.I (plus L L) CJ.conjugate)
    (Pr1.sym MD.Module (MT.I (plus L L) CJ.conjugate) (MT.I (plus L L) HB.VB.D) CJ.image) L HB.basis ;
  basis : LF.Basis[MT.I (plus (plus L L) m) (DS.dsum (CJ.MR.mmul (CJ.MR.mmul P HB.VB.D) P') DS.Mn.mone),plus L m] =
   BlockBasis[plus L L,m,L,CJ.conjugate,conjugate-basis].basis ;
 } ;
} ;
