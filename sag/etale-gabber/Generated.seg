-- Every element of a presented algebra is merely the value of an
-- expression in the generators, and finitely many such choices can be
-- made at once.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
open Presentations[l] ;
top-case (Z : Top -> U l) (z : Z tt) : (t : Top) -> Z t = split { tt -> z } ;
snocD (V : U l) (Y : Plus V Top -> U l) (u : (v : V) -> Y (inl v)) (t : (x : Top) -> Y (inr x)) :
 (w : Plus V Top) -> Y w = split { inl v -> u v ; inr x -> t x } ;
-- finite choice for propositional truncation
choice : (c : Nat) -> (Y : Fin c -> U l) -> ((v : Fin c) -> Tr.Trunc[Y v].carrier) ->
 Tr.Trunc[(v : Fin c) -> Y v].carrier = split {
 zero -> \ Y h -> Tr.Trunc[(v : Fin zero) -> Y v].inc (\ v -> absurd (Y v) v) ;
 suc c | r -> \ Y h ->
  Tr.Trunc[(v : Fin c) -> Y (inl v)].induction @l (\ t -> Tr.Trunc[(v : Fin (suc c)) -> Y v].carrier)
   (\ t -> Tr.Trunc[(v : Fin (suc c)) -> Y v].proposition)
   (\ u -> Tr.Trunc[Y (inr tt)].induction @l (\ t -> Tr.Trunc[(v : Fin (suc c)) -> Y v].carrier)
    (\ t -> Tr.Trunc[(v : Fin (suc c)) -> Y v].proposition)
    (\ y -> Tr.Trunc[(v : Fin (suc c)) -> Y v].inc (snocD (Fin c) Y u (top-case (\ t -> Y (inr t)) y)))
    (h (inr tt)))
   (r (\ v -> Y (inl v)) (\ v -> h (inl v))) } ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Presentations[l].Over[R,setR] ; open P ;
 module C = Algebras[l].Over[R,setR] ;
 eval-ext (V : U l) (B : C.Algebra) (a a1 : V -> B.ring.R)
  (h : (v : V) -> Id B.ring.R (a v) (a1 v)) (e : Expr V) : Id B.ring.R (eval V B a e) (eval V B a1 e) =
  ap (\ x -> eval V B x e) (F.funext V (\ v -> B.ring.R) a a1 h) ;
 Representation (p : Presentation) (A : C.Algebra) (pa : Presents p A) (x : A.ring.R) : U l =
  (e : Expr (Fin p.1)) * Id A.ring.R (eval (Fin p.1) A pa.1.1 e) x ;
 module Generated (p : Presentation) (A : C.Algebra) (pa : Presents p A) {
  module X = PresentationExistence[l].Over[R,setR,p] ;
  module K = PresentationComparison[l].Over[R,setR,p,X.A.algebra,A,X.presentation,pa] ;
  V : U l = Fin p.1 ;
  -- in the constructed algebra, an expression class is its own value
  include-eval (e : Expr V) : Id X.A.Carrier (eval V X.A.algebra X.A.solution.1 e) (X.A.include e) =
   X.To[X.A.algebra].Recover[C.identity X.A.algebra].raw-unique e ;
  value (x : A.ring.R) (w : X.Representatives (K.backward.1.1 x)) : Representation p A pa x =
   (w.1,calc A.ring.R {
    eval V A pa.1.1 w.1
     =< eval-ext V A pa.1.1 (\ v -> K.forward.1.1 (X.A.solution.1 v)) (\ v -> sym (K.forward-generators v)) w.1
      > eval V A (\ v -> K.forward.1.1 (X.A.solution.1 v)) w.1
     =< sym (natural V X.A.algebra A K.forward X.A.solution.1 w.1)
      > K.forward.1.1 (eval V X.A.algebra X.A.solution.1 w.1)
     =< ap K.forward.1.1 (trans (include-eval w.1) w.2) > K.forward.1.1 (K.backward.1.1 x)
     =< K.fb x > x }) ;
  generated (x : A.ring.R) : Tr.Trunc[Representation p A pa x].carrier =
   Tr.Trunc[X.Representatives (K.backward.1.1 x)].induction @l (\ t -> Tr.Trunc[Representation p A pa x].carrier)
    (\ t -> Tr.Trunc[Representation p A pa x].proposition)
    (\ w -> Tr.Trunc[Representation p A pa x].inc (value x w)) (X.generated (K.backward.1.1 x)) ;
  -- finitely many elements at once
  generated-family (c : Nat) (xs : Fin c -> A.ring.R) :
   Tr.Trunc[(v : Fin c) -> Representation p A pa (xs v)].carrier =
   choice c (\ v -> Representation p A pa (xs v)) (\ v -> generated (xs v)) ;
 } ;
} ;
