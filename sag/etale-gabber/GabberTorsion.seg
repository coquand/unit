-- Gabber's theorem for torsion classes (C3, step C6): for A f.p. and an
-- etale R^x-gerbe G over Spec A which is a stack, if
--     (n0+1) . cl(G) = 0          in the group H^2 (H2GROUP),
-- then merely an Azumaya algebra E : Spec A -> AZ_N with delta(E) = cl(G).
-- Proof.  By T1, (n0+1) . cl G = cl (x |-> D M_x), M_x = (n0+1)_* (G x); by
-- T2 (cl = 0), merely a point of D M_x at every x.  A point of D M_x makes
-- D M_x trivial (GERBEOPS.Pointed), so M_x = D D M_x = D T = T, and M_x has a
-- point; its image under j is a weight-(n0+1) line family on G x with fibres
-- of rank one, the hypothesis of GABBERH2.  Under the truncation of the
-- global section the conclusion (a proposition) follows from GABBERH2.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module GH = GabberH2[l].Over[R,setR,axioms,loc,sh] ;
 module HG = H2Group[l].Over[R,setR,axioms,loc,sh] ;
 module GL = HG.GL ;
 module GO = HG.GO ;
 module SG = HG.SG ;
 module BC = BandChange[l].Over[R,setR,axioms,sh] ;
 SGb : U l+ = SG.StackGerbe ;
 -- a stack gerbe whose dual has a point has a point
 module Undual (M : SGb) (d : (GO.dual M).1) {
  trivial : Id SGb M GO.trivial =
   Hi.trans SGb M (GO.dual (GO.dual M)) GO.trivial GO.DoubleDual[M].theorem
    (Hi.trans SGb (GO.dual (GO.dual M)) (GO.dual GO.trivial) GO.trivial
     (Hi.ap SGb SGb GO.dual (GO.dual M) GO.trivial GO.Pointed[GO.dual M,d].theorem) GO.dual-trivial) ;
  point : M.1 = Hi.subst SGb (\ K -> K.1) GO.trivial M (Hi.sym SGb M GO.trivial trivial) GO.base ;
 } ;
 module At (A : GH.C.Algebra) (fp : GH.P.FP A) (G : GH.C.Spec A -> GH.TG.TGerbe)
  (stk : (x : GH.C.Spec A) -> GH.ET.T.isModal @l (G x).carrier) (n0 : Nat) {
  X : U l = GH.C.Spec A ;
  module HA = HG.At[X] ;
  K (x : X) : SGb = SG.lift (G x) (stk x) ;
  cl-G : HA.H2 = HA.cl K ;
  delta (n : Nat) (E : X -> GH.GA.Azumaya n) : HA.H2 = HA.cl (\ x -> GH.SGe.OfAzumaya[suc n,E x].gerbe) ;
  Result : U l+ = (n : Nat) * (E : X -> GH.GA.Azumaya n) * Id HA.H2 (delta n E) cl-G ;
  M (x : X) : SGb = GL.push (K x) (suc n0) ;
  module Killed (torsion : Id HA.H2 (HA.times cl-G (suc n0)) HA.zero) {
   sections : Tr1.Trunc[(x : X) -> (GO.dual (M x)).1].carrier =
    HA.trivial-class (\ x -> GO.dual (M x))
     (Hi.trans HA.H2 (HA.cl (\ x -> GO.dual (M x))) (HA.times cl-G (suc n0)) HA.zero
      (Hi.sym HA.H2 (HA.times cl-G (suc n0)) _ (HA.T1 K (suc n0))) torsion) ;
   object (x : X) (d : (GO.dual (M x)).1) : BC.At[BC.Power[G x,suc n0].char].Obj =
    GL.Push[K x,suc n0].L.S.j (Undual[M x,d].point) ;
   theorem : Tr1.Trunc[Result].carrier =
    Tr1.Trunc[(x : X) -> (GO.dual (M x)).1].induction @(l+) (\ t -> Tr1.Trunc[Result].carrier) (\ t -> Tr1.Trunc[Result].proposition)
     (\ s -> GH.At[A,fp,G,stk,n0,\ x -> object x (s x)].theorem) sections ;
  } ;
 } ;
} ;
-- with the closure constructed (ETALECLOSURE): parameters R, the SAG axioms
-- at level l and Zariski locality
module Closed (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module EC = EtaleClosure[l].Over[R,setR,axioms] ;
 module H = Over[R,setR,axioms,loc,EC.ops] ;
 module At (A : H.GH.C.Algebra) (fp : H.GH.P.FP A) (G : H.GH.C.Spec A -> H.GH.TG.TGerbe)
  (stk : (x : H.GH.C.Spec A) -> H.GH.ET.T.isModal @l (G x).carrier) (n0 : Nat)
  (torsion : Id H.At[A,fp,G,stk,n0].HA.H2 (H.At[A,fp,G,stk,n0].HA.times H.At[A,fp,G,stk,n0].cl-G (suc n0)) H.At[A,fp,G,stk,n0].HA.zero) {
  theorem : Tr1.Trunc[H.At[A,fp,G,stk,n0].Result].carrier = H.At[A,fp,G,stk,n0].Killed[torsion].theorem ;
 } ;
} ;
