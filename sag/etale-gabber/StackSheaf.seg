-- StackGerbe is a sheaf (HANDOFF-K2-COMPARISON, S1).
-- Let Sheaves = (X : U l) * X a sheaf; it is a sheaf (SHEAFCLOSURE.lex).
--  (units)   R^x = (x : R) * (y : R) * xy = 1 is a sheaf: R is
--            (ETALERING.R-local), and sheaves are closed under Sigma and Id
--            (SHEAFLEMMAS).
--  (data)    Over a sheaf X, the data of a stack gerbe other than the two
--            sheaf conditions,
--                Data X = band * (paths are sets) * close X * close (a = b),
--            form a sheaf.  A band at x is (b, contractible fibres, hom):
--            b : (x = x) -> R^x lies in a sheaf (Pi; x = x is a sheaf by Id,
--            R^x by (units)); isContr Z = Z * Pi (z' : Z) (z = z') is a
--            sheaf for Z = (lp : x = x) * (b lp = a) a sheaf (Sigma, Id); the
--            hom condition is Pi of Id in R^x.  isSet (a = b) is Pi of Id over
--            the sheaf a = b; close is a sheaf (SHEAFCLOSURE.modal).
--  (retract) StackGerbe is a retract of (Y : Sheaves) * Data Y.1: send G to
--            ((G.1, stack G), band, gpd, inh, conn); back, the paths of a
--            sheaf are sheaves (SHEAFLEMMAS.modal-Id).  The round trip is
--            the identity on carrier and band, and the Laws are a proposition
--            (STACKGERBES.laws-prop).
--  (theorem) A retract of a sheaf is a sheaf, and (Y : Sheaves) * Data Y.1
--            is one by Sigma at level l+ (each Data Y.1 is a sheaf at level
--            l, hence at l+, STACKGERBES.up).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module SL1 = SheafLemmas[l,l+].Over[ET.I,ET.G] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module SG = StackGerbes[l].Over[R,setR,axioms,sh] ;
 module UG = SG.UG ;
 module GB = SG.GB ;
 Sheaves : U l+ = (X : U l) * ET.T.isModal @l X ;
 -- (units)
 unit-sheaf : ET.T.isModal @l UG.Unit =
  SL.modal-Sigma R.R (\ x -> (y : R.R) * Id R.R (R.mul x y) R.o) ER.R-local (\ x ->
   SL.modal-Sigma R.R (\ y -> Id R.R (R.mul x y) R.o) ER.R-local (\ y -> SL.modal-Id R.R ER.R-local (R.mul x y) R.o)) ;
 -- (data)
 Data (X : U l) : U l =
  ((x : X) -> GB.Band X x) * ((a b : X) -> Pr.isSet (Id X a b)) * sh.close X * ((a b : X) -> sh.close (Id X a b)) ;
 data-band (X : U l) (d : Data X) : (x : X) -> GB.Band X x = d.1 ;
 data-gpd (X : U l) (d : Data X) : (a b : X) -> Pr.isSet (Id X a b) = d.2.1 ;
 data-inh (X : U l) (d : Data X) : sh.close X = d.2.2.1 ;
 data-conn (X : U l) (d : Data X) : (a b : X) -> sh.close (Id X a b) = d.2.2.2 ;
 module Sheafy (X : U l) (hX : ET.T.isModal @l X) {
  loops (x : X) : ET.T.isModal @l (Id X x x) = SL.modal-Id X hX x x ;
  contr (Z : U l) (hZ : ET.T.isModal @l Z) : ET.T.isModal @l (FunExtUA[l].isContr Z) =
   SL.modal-Sigma Z (\ c -> (z : Z) -> Id Z c z) hZ (\ c -> SL.modal-Pi Z (\ z -> Id Z c z) (\ z -> SL.modal-Id Z hZ c z)) ;
  fibre (x : X) (b : Id X x x -> UG.Unit) (a : UG.Unit) : ET.T.isModal @l ((lp : Id X x x) * Id UG.Unit (b lp) a) =
   SL.modal-Sigma (Id X x x) (\ lp -> Id UG.Unit (b lp) a) (loops x) (\ lp -> SL.modal-Id UG.Unit unit-sheaf (b lp) a) ;
  Rest (x : X) (b : Id X x x -> UG.Unit) : U l =
   ((a : UG.Unit) -> FunExtUA[l].isContr ((lp : Id X x x) * Id UG.Unit (b lp) a))
   * ((p q : Id X x x) -> Id UG.Unit (b (Pr.trans X x x x p q)) (UG.times (b p) (b q))) ;
  rest (x : X) (b : Id X x x -> UG.Unit) : ET.T.isModal @l (Rest x b) =
   SL.modal-Sigma ((a : UG.Unit) -> FunExtUA[l].isContr ((lp : Id X x x) * Id UG.Unit (b lp) a))
    (\ be -> (p q : Id X x x) -> Id UG.Unit (b (Pr.trans X x x x p q)) (UG.times (b p) (b q)))
    (SL.modal-Pi UG.Unit (\ a -> FunExtUA[l].isContr ((lp : Id X x x) * Id UG.Unit (b lp) a))
      (\ a -> contr ((lp : Id X x x) * Id UG.Unit (b lp) a) (fibre x b a)))
    (\ be -> SL.modal-Pi (Id X x x) (\ p -> (q : Id X x x) -> Id UG.Unit (b (Pr.trans X x x x p q)) (UG.times (b p) (b q)))
      (\ p -> SL.modal-Pi (Id X x x) (\ q -> Id UG.Unit (b (Pr.trans X x x x p q)) (UG.times (b p) (b q)))
       (\ q -> SL.modal-Id UG.Unit unit-sheaf (b (Pr.trans X x x x p q)) (UG.times (b p) (b q))))) ;
  band (x : X) : ET.T.isModal @l (GB.Band X x) =
   SL.modal-Sigma (Id X x x -> UG.Unit) (\ b -> Rest x b)
    (SL.modal-Pi (Id X x x) (\ lp -> UG.Unit) (\ lp -> unit-sheaf)) (\ b -> rest x b) ;
  gpd : ET.T.isModal @l ((a b : X) -> Pr.isSet (Id X a b)) =
   SL.modal-Pi X (\ a -> (b : X) -> Pr.isSet (Id X a b)) (\ a -> SL.modal-Pi X (\ b -> Pr.isSet (Id X a b)) (\ b ->
    SL.modal-Pi (Id X a b) (\ p -> (q : Id X a b) -> Pr.isProp (Id (Id X a b) p q)) (\ p ->
     SL.modal-Pi (Id X a b) (\ q -> Pr.isProp (Id (Id X a b) p q)) (\ q ->
      SL.modal-isProp (Id (Id X a b) p q) (SL.modal-Id (Id X a b) (SL.modal-Id X hX a b) p q))))) ;
  conn : ET.T.isModal @l ((a b : X) -> sh.close (Id X a b)) =
   SL.modal-Pi X (\ a -> (b : X) -> sh.close (Id X a b)) (\ a ->
    SL.modal-Pi X (\ b -> sh.close (Id X a b)) (\ b -> sh.modal (Id X a b))) ;
  data-sheaf : ET.T.isModal @l (Data X) =
   SL.modal-Sigma ((x : X) -> GB.Band X x)
    (\ bd -> ((a b : X) -> Pr.isSet (Id X a b)) * sh.close X * ((a b : X) -> sh.close (Id X a b)))
    (SL.modal-Pi X (\ x -> GB.Band X x) band) (\ bd ->
   SL.modal-Sigma ((a b : X) -> Pr.isSet (Id X a b)) (\ g -> sh.close X * ((a b : X) -> sh.close (Id X a b))) gpd (\ g ->
   SL.modal-Sigma (sh.close X) (\ i -> (a b : X) -> sh.close (Id X a b)) (sh.modal X) (\ i -> conn))) ;
 } ;
 -- (retract)
 Total : U l+ = (Y : Sheaves) * Data Y.1 ;
 to (G : SG.StackGerbe) : Total = ((G.1,SG.stack G),SG.band G,SG.gpd G,SG.inh G,SG.conn G) ;
 from (D : Total) : SG.StackGerbe =
  (D.1.1,data-band D.1.1 D.2,data-gpd D.1.1 D.2,data-inh D.1.1 D.2,data-conn D.1.1 D.2,\ a b -> SL.modal-Id D.1.1 D.1.2 a b,D.1.2) ;
 from-to (G : SG.StackGerbe) : Id SG.StackGerbe (from (to G)) G =
  Hi.ap (SG.Laws G.1) SG.StackGerbe (\ t -> (G.1,G.2.1,t)) (from (to G)).2.2 G.2.2 (SG.laws-prop G.1 (from (to G)).2.2 G.2.2) ;
 -- (theorem)
 total : ET.T.isModal @(l+) Total =
  SL1.modal-Sigma Sheaves (\ Y -> Data Y.1) sh.lex (\ Y -> SG.up (Data Y.1) (Sheafy[Y.1,Y.2].data-sheaf)) ;
 theorem : ET.T.isModal @(l+) SG.StackGerbe = SL1.modal-retract Total SG.StackGerbe to from from-to total ;
} ;
