-- U [x] p for projectors p over Alg, as a function of p (CHEAP-DESIGN.md,
-- section 3).  X = Spec Alg, U a family over the G x, and
--     T_U(p) = U [x] p      (DATUM.tensor: at (x, g), U x g [x] p(x)).
--  (zero)  If every vector fixed by e is 0, then N + M [x] e = N: the
--          fixed vector w is 0 w, so a linear f has f w = f (0 w)
--          = 0 (f w) = 0 (as SUMMANDS.Tensors.Null).  This applies to e of
--          size 0 and to e = 0_n(x) (fixed w = 0_n(x) w = 0, as 0_n(x) = 0).
--  (sum)   T_U(p + q) = T_U(p) + T_U(q): (p + q)(x) = p(x) + q(x)
--          (PROJECTORMAP.Sum) and U [x] (a + b) = U [x] a + U [x] b
--          (TENSORPOWERS.block).
--  (iso)   Image p ~ Image q over Alg gives T_U(p) = T_U(q).  Pad to
--          p' = p + 0_n and q' = 0_m + q; an equivalence of p', q' over Alg
--          maps along x to one of p'(x), q'(x) (K0RESTRICTION.MapIso), so
--          U [x] p'(x) = U [x] q'(x) (MATRIXTENSOR.Equivalent); and
--          U [x] p(x) = U [x] p(x) + U [x] 0_n(x) = U [x] p'(x),
--          U [x] q'(x) = U [x] 0_m(x) + U [x] q(x) = U [x] q(x)  by (sum), (zero).
--  (copies) T_U(p^(c+1)) = T_U(p)^(c+1) (TRANSPOSES.copies, EFFACE.power):
--          T_U(0 + p) = T_U(0) + T_U(p) = T_U(p) + T_U(0) = T_U(p), and
--          T_U(p^(c+2)) = T_U(p^(c+1)) + T_U(p) = T_U(p) + T_U(p)^(c+1).
--  (free)  1_j(x) = 1_j (MATRIXMAP.map-one), so T_U(1_(k+1)) = U^(k+1)
--          (TENSORPOWERS.powers), and U + T_U(1_j) = U^(j+1): for j = 0 by
--          (zero), for j = k + 1 by the previous identity.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module TP = TensorPowers[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 -- (zero)
 module Zero (M N : MD.Module) (n : Nat) (e : Vectors[l].Over[R,setR,n].MR.Mat)
  (h : (w : MT.Image[n,e].S.E) -> Id Vectors[l].Over[R,setR,n].Vec w.1 Vectors[l].Over[R,setR,n].vzero) {
  module IE = MT.Image[n,e] ;
  module H = HM.At[MT.I n e,M] ;
  module MN = Alg73[l].MA[MD.ring,M] ;
  module P2 = MS.Pair[N,H.carrier] ;
  -- w = 0 w, both having the vector 0
  vanish (w : IE.S.E) : Id IE.S.E w (IE.carrier.sm R.z w) =
   IE.ext w (IE.carrier.sm R.z w) (trans (h w) (sym (h (IE.carrier.sm R.z w)))) ;
  -- f w = f (0 w) = 0 (f w) = 0
  vanish-map (f : H.S.E) : Id H.S.E f H.carrier.mz =
   H.ext f H.carrier.mz (\ w -> trans (ap f.1 (vanish w)) (trans (f.2.2 R.z w) (MN.sm-zl (f.1 w)))) ;
  to (u : P2.Carrier) : N.M = u.1 ;
  from (m : N.M) : P2.Carrier = (m,H.carrier.mz) ;
  from-to (u : P2.Carrier) : Id P2.Carrier (from (to u)) u =
   P2.pair-eq u.1 u.1 H.carrier.mz u.2 (refl u.1) (sym (vanish-map u.2)) ;
  theorem : Id MD.Module (MS.plus N (MT.tensor M n e)) N =
   SIP.sip (MS.plus N H.carrier) N
    ((to,Pr.qinv P2.Carrier N.M to from (\ m -> refl m) from-to),
     \ u v -> refl (N.madd u.1 v.1),
     \ c u -> refl (N.sm c u.1)) ;
 } ;
 -- the one vector of R^0
 empty-vector (w : Vectors[l].Over[R,setR,zero].Vec) : Id Vectors[l].Over[R,setR,zero].Vec w Vectors[l].Over[R,setR,zero].vzero =
  Vectors[l].Over[R,setR,zero].vec-eq w Vectors[l].Over[R,setR,zero].vzero (\ i -> absurd (Id R.R (w i) R.z) i) ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (G : C.Spec Alg -> TwistedFrames[l].Over[R,setR].TM.GB.AGerbe) {
  module DA = Datum[l].Over[R,setR,axioms].At[Alg,fp,G] ;
  module K = K0[l].Over[Alg.ring,Alg.set] ;
  module PJ = K.PJ ;
  module CA = Complements[l].Over[Alg.ring,Alg.set] ;
  module TT = Transposes[l].Over[Alg.ring,Alg.set] ;
  module ST = Stabilise[l].Over[Alg.ring,Alg.set] ;
  module SF = Summands[l].Tensors[R,setR,DA.X,\ x -> (G x).1] ;
  -- T_U(p)
  tensor (U1 : DA.FS.Fam) (p : PJ.Projector) : DA.FS.Fam = DA.tensor U1 p.size p.matrix ;
  module Pt (x : DA.X) {
   module PM = ProjectorMap[l].Over[Alg.ring,R,Alg.set,setR,x.1] ;
   module RM = K0Restriction[l].Over[Alg.ring,R,Alg.set,setR,x.1] ;
   on-matrix (M : MD.Module) (n : Nat) (a b : Vectors[l].Over[R,setR,n].MR.Mat) (h : Id Vectors[l].Over[R,setR,n].MR.Mat a b) :
    Id MD.Module (MT.tensor M n a) (MT.tensor M n b) =
    Pr1.ap Vectors[l].Over[R,setR,n].MR.Mat MD.Module (MT.tensor M n) a b h ;
   -- (sum)
   sum (M : MD.Module) (p q : PJ.Projector) :
    Id MD.Module (MT.tensor M (K.sum p q).size (DA.Mats[plus p.size q.size].at x (K.sum p q).matrix)) (MS.plus (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix))) =
    Pr1.trans MD.Module (MT.tensor M (K.sum p q).size (DA.Mats[plus p.size q.size].at x (K.sum p q).matrix))
     (MT.tensor M (plus p.size q.size) (DirectSums[l].Over[R,setR,p.size,q.size].dsum (DA.Mats[p.size].at x p.matrix) (DA.Mats[q.size].at x q.matrix)))
     (MS.plus (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)))
     (on-matrix M (plus p.size q.size) (DA.Mats[plus p.size q.size].at x (K.sum p q).matrix) (DirectSums[l].Over[R,setR,p.size,q.size].dsum (DA.Mats[p.size].at x p.matrix) (DA.Mats[q.size].at x q.matrix)) PM.Sum[p,q].matrix)
     (TP.block M p.size q.size (DA.Mats[p.size].at x p.matrix) (DA.Mats[q.size].at x q.matrix)) ;
   -- (zero), for 0_n(x)
   module Null (n : Nat) {
    module V = Vectors[l].Over[R,setR,n] ;
    -- a vector fixed by 0_n(x) is 0
    fixed (w : MT.Image[n,DA.Mats[n].at x CA.Null[n].projector.matrix].S.E) : Id V.Vec w.1 V.vzero =
     calc V.Vec { w.1
       =< sym w.2 > V.act (DA.Mats[n].at x CA.Null[n].projector.matrix) w.1
       =< ap (\ Z -> V.act Z w.1) PM.At[n].MM.map-zero > V.act V.MR.mzero w.1
       =< V.act-mzero w.1 > V.vzero } ;
    theorem (M N : MD.Module) : Id MD.Module (MS.plus N (MT.tensor M n (DA.Mats[n].at x CA.Null[n].projector.matrix))) N =
     Zero[M,N,n,DA.Mats[n].at x CA.Null[n].projector.matrix,fixed].theorem ;
   } ;
   -- (iso)
   module Iso (M : MD.Module) (p q : PJ.Projector) (e : K.Iso p q) {
    module MI = RM.MapIso[p,q,e] ;
    middle : Id MD.Module (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.p'.matrix)) (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.q'.matrix)) =
     MT.Equivalent[MI.n,DA.Mats[MI.n].at x MI.p'.matrix,DA.Mats[MI.n].at x MI.q'.matrix,MI.mapped].theorem M ;
    -- U [x] p(x) = U [x] p(x) + U [x] 0_n(x) = U [x] p'(x)
    left : Id MD.Module (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix)) (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.p'.matrix)) =
     Pr1.sym MD.Module (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.p'.matrix)) (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix))
      (Pr1.trans MD.Module (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.p'.matrix))
       (MS.plus (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x CA.Null[q.size].projector.matrix))) (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix))
       (sum M p CA.Null[q.size].projector) (Null[q.size].theorem M (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix)))) ;
    -- U [x] q'(x) = U [x] 0_m(x) + U [x] q(x) = U [x] q(x) + U [x] 0_m(x) = U [x] q(x)
    right : Id MD.Module (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.q'.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)) =
     Pr1.trans MD.Module (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.q'.matrix))
      (MS.plus (MT.tensor M p.size (DA.Mats[p.size].at x CA.Null[p.size].projector.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix))) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix))
      (sum M CA.Null[p.size].projector q)
      (Pr1.trans MD.Module (MS.plus (MT.tensor M p.size (DA.Mats[p.size].at x CA.Null[p.size].projector.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)))
       (MS.plus (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)) (MT.tensor M p.size (DA.Mats[p.size].at x CA.Null[p.size].projector.matrix))) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix))
       MS.Comm[MT.tensor M p.size (DA.Mats[p.size].at x CA.Null[p.size].projector.matrix),MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)].theorem
       (Null[p.size].theorem M (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)))) ;
    theorem : Id MD.Module (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)) =
     Pr1.trans MD.Module (MT.tensor M p.size (DA.Mats[p.size].at x p.matrix)) (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.p'.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)) left
      (Pr1.trans MD.Module (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.p'.matrix)) (MT.tensor M MI.n (DA.Mats[MI.n].at x MI.q'.matrix)) (MT.tensor M q.size (DA.Mats[q.size].at x q.matrix)) middle right) ;
   } ;
   -- (zero), for the projector of size 0
   empty (M N : MD.Module) : Id MD.Module (MS.plus N (MT.tensor M PJ.zeroP.size (DA.Mats[PJ.zeroP.size].at x PJ.zeroP.matrix))) N =
    Zero[M,N,PJ.zeroP.size,DA.Mats[PJ.zeroP.size].at x PJ.zeroP.matrix,\ w -> empty-vector w.1].theorem ;
   -- (free)
   one-matrix (j : Nat) : Id Vectors[l].Over[R,setR,j].MR.Mat (DA.Mats[j].at x (ST.one j).matrix) (TP.one j) = PM.At[j].MM.map-one ;
   ones (M : MD.Module) (k : Nat) : Id MD.Module (MT.tensor M (ST.one (suc k)).size (DA.Mats[(ST.one (suc k)).size].at x (ST.one (suc k)).matrix)) (MS.EM.power k M) =
    Pr1.trans MD.Module (MT.tensor M (ST.one (suc k)).size (DA.Mats[(ST.one (suc k)).size].at x (ST.one (suc k)).matrix)) (MT.tensor M (suc k) (TP.one (suc k))) (MS.EM.power k M)
     (on-matrix M (suc k) (DA.Mats[(ST.one (suc k)).size].at x (ST.one (suc k)).matrix) (TP.one (suc k)) (one-matrix (suc k))) (TP.powers M k) ;
   free (M : MD.Module) : (j : Nat) -> Id MD.Module (MS.plus M (MT.tensor M (ST.one j).size (DA.Mats[(ST.one j).size].at x (ST.one j).matrix))) (MS.EM.power j M) = split {
    zero -> Zero[M,M,(ST.one zero).size,DA.Mats[(ST.one zero).size].at x (ST.one zero).matrix,\ w -> empty-vector w.1].theorem ;
    suc k -> Pr1.ap MD.Module MD.Module (MS.plus M) (MT.tensor M (ST.one (suc k)).size (DA.Mats[(ST.one (suc k)).size].at x (ST.one (suc k)).matrix)) (MS.EM.power k M) (ones M k) } ;
  } ;
  -- by definition, T_U(p) at (x, g)
  tensor-at (U1 : DA.FS.Fam) (p : PJ.Projector) (x : DA.X) (g : (G x).1) :
   Id MD.Module (tensor U1 p x g) (MT.tensor (U1 x g) p.size (DA.Mats[p.size].at x p.matrix)) = refl (tensor U1 p x g) ;
  -- the identities as families
  sum-at (U1 : DA.FS.Fam) (p q : PJ.Projector) (x : DA.X) (g : (G x).1) :
   Id MD.Module (tensor U1 (K.sum p q) x g) (DA.FS.add (tensor U1 p) (tensor U1 q) x g) =
   Pr1.trans MD.Module (tensor U1 (K.sum p q) x g) (MT.tensor (U1 x g) (K.sum p q).size (DA.Mats[plus p.size q.size].at x (K.sum p q).matrix))
    (DA.FS.add (tensor U1 p) (tensor U1 q) x g) (tensor-at U1 (K.sum p q) x g) (Pt[x].sum (U1 x g) p q) ;
  sum (U1 : DA.FS.Fam) (p q : PJ.Projector) : Id DA.FS.Fam (tensor U1 (K.sum p q)) (DA.FS.add (tensor U1 p) (tensor U1 q)) =
   DA.FS.pointwise (tensor U1 (K.sum p q)) (DA.FS.add (tensor U1 p) (tensor U1 q)) (sum-at U1 p q) ;
  iso (U1 : DA.FS.Fam) (p q : PJ.Projector) (e : K.Iso p q) : Id DA.FS.Fam (tensor U1 p) (tensor U1 q) =
   DA.FS.pointwise (tensor U1 p) (tensor U1 q) (\ x g -> Pt[x].Iso[U1 x g,p,q,e].theorem) ;
  empty (U1 F : DA.FS.Fam) : Id DA.FS.Fam (DA.FS.add F (tensor U1 PJ.zeroP)) F =
   DA.FS.pointwise (DA.FS.add F (tensor U1 PJ.zeroP)) F (\ x g -> Pt[x].empty (U1 x g) (F x g)) ;
  -- (copies)
  copies (U1 : DA.FS.Fam) (p : PJ.Projector) : (c : Nat) -> Id DA.FS.Fam (tensor U1 (TT.copies p (suc c))) (DA.FS.E.power c (tensor U1 p)) = split {
   zero -> Pr1.trans DA.FS.Fam (tensor U1 (K.sum PJ.zeroP p)) (DA.FS.add (tensor U1 PJ.zeroP) (tensor U1 p)) (tensor U1 p)
     (sum U1 PJ.zeroP p)
     (Pr1.trans DA.FS.Fam (DA.FS.add (tensor U1 PJ.zeroP) (tensor U1 p)) (DA.FS.add (tensor U1 p) (tensor U1 PJ.zeroP)) (tensor U1 p)
      (DA.FS.comm (tensor U1 PJ.zeroP) (tensor U1 p)) (empty U1 (tensor U1 p))) ;
   suc c | r -> Pr1.trans DA.FS.Fam (tensor U1 (K.sum (TT.copies p (suc c)) p))
     (DA.FS.add (tensor U1 (TT.copies p (suc c))) (tensor U1 p)) (DA.FS.E.power (suc c) (tensor U1 p))
     (sum U1 (TT.copies p (suc c)) p)
     (Pr1.trans DA.FS.Fam (DA.FS.add (tensor U1 (TT.copies p (suc c))) (tensor U1 p))
      (DA.FS.add (DA.FS.E.power c (tensor U1 p)) (tensor U1 p)) (DA.FS.E.power (suc c) (tensor U1 p))
      (Pr1.ap DA.FS.Fam DA.FS.Fam (\ F -> DA.FS.add F (tensor U1 p)) (tensor U1 (TT.copies p (suc c))) (DA.FS.E.power c (tensor U1 p)) r)
      (DA.FS.comm (DA.FS.E.power c (tensor U1 p)) (tensor U1 p))) } ;
  -- (free)
  ones (U1 : DA.FS.Fam) (k : Nat) : Id DA.FS.Fam (tensor U1 (ST.one (suc k))) (DA.FS.E.power k U1) =
   DA.FS.pointwise (tensor U1 (ST.one (suc k))) (DA.FS.E.power k U1)
    (\ x g -> Pr1.trans MD.Module (tensor U1 (ST.one (suc k)) x g) (MS.EM.power k (U1 x g)) (DA.FS.E.power k U1 x g)
      (Pt[x].ones (U1 x g) k) (Pr1.sym MD.Module (DA.FS.E.power k U1 x g) (MS.EM.power k (U1 x g)) (SF.at-point U1 x g k))) ;
  free (U1 : DA.FS.Fam) (j : Nat) : Id DA.FS.Fam (DA.FS.add U1 (tensor U1 (ST.one j))) (DA.FS.E.power j U1) =
   DA.FS.pointwise (DA.FS.add U1 (tensor U1 (ST.one j))) (DA.FS.E.power j U1)
    (\ x g -> Pr1.trans MD.Module (DA.FS.add U1 (tensor U1 (ST.one j)) x g) (MS.EM.power j (U1 x g)) (DA.FS.E.power j U1 x g)
      (Pt[x].free (U1 x g) j) (Pr1.sym MD.Module (DA.FS.E.power j U1 x g) (MS.EM.power j (U1 x g)) (SF.at-point U1 x g j))) ;
 } ;
} ;
