-- Unramifiable monic polynomials (azumaya1, Section 1): f of degree d is
-- unramifiable when 1 = Delta(f) = D(delta_1, .., delta_d), the delta_k being
-- the elementary symmetric functions of f'(x_1), .., f'(x_d) in the
-- decomposition algebra, i.e. the coefficients of the characteristic
-- polynomial of u = f'(x) acting on A = R[X]/(f).  We state it without the
-- decomposition algebra:
--     f is unramifiable when the coordinates of u^d in the power basis of A
--     generate the unit ideal of R.
-- The two radicals agree: at a prime p, all delta_k lie in p iff u is
-- nilpotent in A (x) k(p), a k(p)-algebra of dimension d, iff u^d = 0 there,
-- iff all coordinates of u^d lie in p.  (Over a residually discrete local
-- ring: f has a simple root in some extension of the residue field.)
--  (slope)  f'(y) by Horner's scheme on dual numbers: for f = b + X q,
--           f(y) = b + y q(y) and f'(y) = q(y) + y q'(y).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module W = PolynomialPresentation[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 -- (slope): the pair (f(y), f'(y))
 module Slope (S : CRing) (iota : R.R -> S.R) (y : S.R) {
  horner : List R.R -> (v : S.R) * S.R = split {
   nil -> (S.z,S.z) ;
   cons b q | ih -> (S.add (iota b) (S.mul y ih.1),S.add ih.1 (S.mul y ih.2)) } ;
 } ;
 module At (i : ET.I) {
  module B = EtaleBasis[l].Over[R,setR].At[ET.lower i] ;
  x : B.A.ring.R = B.quotient-map.1.1 W.RX.X.variable ;
  derivative : B.A.ring.R = (Slope[B.A.ring,B.A.iota.1,x].horner B.f).2 ;
  coordinates : Fin B.d -> R.R = B.coords (AffinePowers[l].Over[B.A.ring].power derivative B.d) ;
  Unramifiable : U l = Tr.Trunc[(r : Fin B.d -> R.R) * Id R.R (RS.lin B.d coordinates r) R.o].carrier ;
 } ;
 -- the generators of the etale topology: monic polynomials that are unramifiable
 J : U l = (i : ET.I) * At[i].Unramifiable ;
 e (j : J) : ET.I = j.1 ;
} ;
