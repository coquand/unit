-- Finite free modules are weakly quasi-coherent.  Combined with DescentQC,
-- this supplies denominator clearing for an etale-locally free sheaf module.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ;
module Tr = Truncation[l] ; module A7 = Alg73[l] ;
module NF = NatFin[l] ; module FB = FiniteBounds[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module BO = BundleOperations[l].Over[R,setR,axioms] ;
 module MF = ModuleFractions[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module Finite (n : Nat) (Mx : Fin n -> MD.Module) (w : MD.WqcBundle (Fin n) Mx) {
  P : MD.Module = MD.pi (Fin n) Mx ;
  module SC = BO.Scalar[P] ;
  module At (j : Fin n) (r : R.R) { module A = MF.At[Mx j,r] ; } ;
  module Rep (r : R.R) (s : MD.RA.unit r -> P.M) {
   Local (j : Fin n) : U l = (k : Nat) * (m : (Mx j).M) *
    Id (At[j,r].A.Target) (At[j,r].A.fraction m k) (\ d -> s d j) ;
   module Chosen (a : (j : Fin n) -> Local j) {
    N : Nat = FB.bound n (\ j -> (a j).1) ;
    bound (j : Fin n) : CoefficientBound[l].le (a j).1 N = FB.bounded n (\ j -> (a j).1) j ;
    gap (j : Fin n) : Nat = Iterates[l].excess (a j).1 N (bound j) ;
    numerator (j : Fin n) : (Mx j).M = At[j,r].A.Act.power (gap j) (a j).2.1 ;
    point (j : Fin n) : Id (At[j,r].A.Target) (At[j,r].A.fraction (numerator j) N) (\ d -> s d j) =
     trans (ap (At[j,r].A.fraction (numerator j)) (sym (Iterates[l].excess-law (a j).1 N (bound j))))
      (trans (At[j,r].A.raise (gap j) (a j).1 (a j).2.1) (a j).2.2) ;
    result : SC.Rep r s = (numerator,NF.toN N,\ d ->
     F.funext (Fin n) (\ j -> (Mx j).M) (s d) _ (\ j -> sym (ap (\ h -> h d) (point j)))) ;
   } ;
   theorem : Tr.Trunc[SC.Rep r s].carrier =
    Tr.Trunc[(j : Fin n) -> Local j].induction @l
     (\ z -> Tr.Trunc[SC.Rep r s].carrier) (\ z -> Tr.Trunc[SC.Rep r s].proposition)
     (\ a -> Tr.Trunc[SC.Rep r s].inc Chosen[a].result)
     (AffineFinite[l].choice n Local (\ j -> At[j,r].A.QC[w j].represented (\ d -> s d j))) ;
  } ;
  module Kill (r : R.R) (m : P.M) (v : MD.RA.unit r -> Id P.M m P.mz) {
   Local (j : Fin n) : U l = (k : Nat) * MD.Fractions[Mx j].Kills r (m j) k ;
   module Chosen (a : (j : Fin n) -> Local j) {
    N : Nat = FB.bound n (\ j -> (a j).1) ;
    result : SC.Kill r m = (NF.toN N,F.funext (Fin n) (\ j -> (Mx j).M) _ _
     (\ j -> MD.Fractions[Mx j].kills-up r (m j) (a j).1 N
      (FB.bounded n (\ j -> (a j).1) j) (a j).2)) ;
   } ;
   theorem : Tr.Trunc[SC.Kill r m].carrier =
    Tr.Trunc[(j : Fin n) -> Local j].induction @l
     (\ z -> Tr.Trunc[SC.Kill r m].carrier) (\ z -> Tr.Trunc[SC.Kill r m].proposition)
     (\ a -> Tr.Trunc[SC.Kill r m].inc Chosen[a].result)
     (AffineFinite[l].choice n Local (\ j -> MF.Single[Mx j,w j].kill r (m j)
      (\ d -> ap (\ h -> h j) (v d)))) ;
  } ;
  theorem : MD.WeaklyQC P = SC.Clauses[\ r s -> Rep[r,s].theorem,\ r m v -> Kill[r,m,v].theorem].theorem ;
  opaque theorem ;
 } ;
 Free (n : Nat) : MD.Module = MD.pi (Fin n) (\ j -> MD.regular) ;
 free-qc (n : Nat) : MD.WeaklyQC (Free n) =
  Finite[n,\ j -> MD.regular,\ j -> RegularQC[l].Over[R,setR,axioms].theorem].theorem ;
 module At (M : MD.Module) (modal : ET.T.isModal @l M.M)
  (sh : [j] SheafClosure[l,j].Over[ET.I,ET.G].Ops) {
  module D = DescentQC[l].Over[R,setR,axioms].At[M,modal] ;
  -- Equality of modules includes the linearity data, by ModuleSIP.
  locally-free-qc (n : Nat) (local : (sh @(l+)).close (Id MD.Module M (Free n))) : MD.WeaklyQC M =
   (sh @(l+)).elim @l (Id MD.Module M (Free n)) (MD.WeaklyQC M) D.qc-prop D.qc-modal
    (\ p -> P1.subst MD.Module (\ N -> MD.WeaklyQC N) (Free n) M (P1.sym MD.Module M (Free n) p) (free-qc n)) local ;
  opaque locally-free-qc ;
  module Fractions (n : Nat) (local : (sh @(l+)).close (Id MD.Module M (Free n))) {
   w : MD.WeaklyQC M = locally-free-qc n local ;
   module On (X : U l) (scheme : Schemes[l].Over[R,setR].Scheme X) {
    -- Exactly the M-valued denominator-clearing statement needed in step 4.
    restriction : MD.Restriction X (\ x -> M) =
     Restriction718[l].Over[R,setR,axioms].At[X,scheme,\ x -> M,\ x -> w].theorem-7-1-8 ;
    opaque restriction ;
   } ;
  } ;
 } ;
} ;
