-- Binary direct sums of modules (MODULES), and of families of modules, with
-- their laws as identities.  A + B has carrier A x B with componentwise
-- operations; every module law holds componentwise.  The maps
--     (a,(b,c)) |-> ((a,b),c),      (a,b) |-> (b,a)
-- are linear bijections, by definition of the operations, so by the
-- structure identity principle (MODULESIP2) A + (B + C) = (A + B) + C and
-- A + B = B + A.  For families V, W over a type X with fibres Y x (in the
-- use: X = Spec Alg, Y x = G x), V + W is the pointwise sum, and the laws
-- hold pointwise, hence as identities of families (funext).  These are the
-- hypotheses of EFFACE for families.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module A7 = Alg73[l] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module Pair (A B : MD.Module) {
  Carrier : U l = (a : A.M) * B.M ;
  pair-eq (a a' : A.M) (b b' : B.M) (p : Id A.M a a') (q : Id B.M b b') : Id Carrier (a,b) (a',b') =
   Pr.trans Carrier (a,b) (a',b) (a',b') (ap (\ t -> (t,b)) p) (ap (\ t -> (a',t)) q) ;
  sum : MD.Module = new A7.Mod[MD.ring,Carrier,Pr.isSet-Sigma A.M (\ a -> B.M) A.setM (\ a -> B.setM),
   (A.mz,B.mz),
   \ u v -> (A.madd u.1 v.1,B.madd u.2 v.2),
   \ u -> (A.mneg u.1,B.mneg u.2),
   \ u v w -> pair-eq _ _ _ _ (A.maddA u.1 v.1 w.1) (B.maddA u.2 v.2 w.2),
   \ u v -> pair-eq _ _ _ _ (A.maddC u.1 v.1) (B.maddC u.2 v.2),
   \ u -> pair-eq _ _ _ _ (A.maddZ u.1) (B.maddZ u.2),
   \ u -> pair-eq _ _ _ _ (A.maddN u.1) (B.maddN u.2),
   \ c u -> (A.sm c u.1,B.sm c u.2),
   \ c d u -> pair-eq _ _ _ _ (A.smA c d u.1) (B.smA c d u.2),
   \ u -> pair-eq _ _ _ _ (A.smO u.1) (B.smO u.2),
   \ c u v -> pair-eq _ _ _ _ (A.smD c u.1 v.1) (B.smD c u.2 v.2),
   \ c d u -> pair-eq _ _ _ _ (A.smE c d u.1) (B.smE c d u.2)] ;
 } ;
 plus (A B : MD.Module) : MD.Module = Pair[A,B].sum ;
 -- A + (B + C) = (A + B) + C
 module Assoc (A B C : MD.Module) {
  right (u : (plus A (plus B C)).M) : (plus (plus A B) C).M = ((u.1,u.2.1),u.2.2) ;
  left (v : (plus (plus A B) C).M) : (plus A (plus B C)).M = (v.1.1,(v.1.2,v.2)) ;
  theorem : Id MD.Module (plus A (plus B C)) (plus (plus A B) C) =
   SIP.sip (plus A (plus B C)) (plus (plus A B) C)
    ((right,Pr.qinv (plus A (plus B C)).M (plus (plus A B) C).M right left (\ v -> refl v) (\ u -> refl u)),
     \ u v -> refl (right ((plus A (plus B C)).madd u v)),
     \ c u -> refl (right ((plus A (plus B C)).sm c u))) ;
 } ;
 -- A + B = B + A
 module Comm (A B : MD.Module) {
  swap (u : (plus A B).M) : (plus B A).M = (u.2,u.1) ;
  back (v : (plus B A).M) : (plus A B).M = (v.2,v.1) ;
  theorem : Id MD.Module (plus A B) (plus B A) =
   SIP.sip (plus A B) (plus B A)
    ((swap,Pr.qinv (plus A B).M (plus B A).M swap back (\ v -> refl v) (\ u -> refl u)),
     \ u v -> refl (swap ((plus A B).madd u v)),
     \ c u -> refl (swap ((plus A B).sm c u))) ;
 } ;
 -- powers of a module (EFFACE): power k A = A + ... + A, k + 1 copies
 module EM = Efface[l].Over[MD.Module,plus,\ a b c -> Assoc[a,b,c].theorem,\ a b -> Comm[a,b].theorem] ;
 -- families over X with fibres Y x
 module Families (X : U l) (Y : X -> U l) {
  Fam : U l+ = (x : X) -> Y x -> MD.Module ;
  add (V W : Fam) : Fam = \ x y -> plus (V x y) (W x y) ;
  -- two families equal at every point are equal
  pointwise (V W : Fam) (h : (x : X) (y : Y x) -> Id MD.Module (V x y) (W x y)) : Id Fam V W =
   F1.funext X (\ x -> Y x -> MD.Module) V W (\ x -> F1.funext (Y x) (\ y -> MD.Module) (V x) (W x) (h x)) ;
  assoc (U1 V W : Fam) : Id Fam (add U1 (add V W)) (add (add U1 V) W) =
   pointwise (add U1 (add V W)) (add (add U1 V) W) (\ x y -> Assoc[U1 x y,V x y,W x y].theorem) ;
  comm (V W : Fam) : Id Fam (add V W) (add W V) =
   pointwise (add V W) (add W V) (\ x y -> Comm[V x y,W x y].theorem) ;
  module E = Efface[l].Over[Fam,add,assoc,comm] ;
 } ;
} ;
