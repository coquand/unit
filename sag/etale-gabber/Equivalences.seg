level l ; open Prelude[l] ;
compose (A B C : U l) (e : Equiv A B) (d : Equiv B C) : Equiv A C =
 (\ a -> d.1 (e.1 a),qinv A C (\ a -> d.1 (e.1 a)) (\ c -> e.2.sec (d.2.sec c))
  (\ c -> trans C _ _ _ (ap B C d.1 _ _ (e.2.sec-eq (d.2.sec c))) (d.2.sec-eq c))
  (\ a -> trans A _ _ _ (ap B A e.2.sec _ _ (sec-ret B C d.1 d.2 (e.1 a))) (sec-ret A B e.1 e.2 a))) ;
product (A B C : U l) (e : Equiv A B) : Equiv (A * C) (B * C) =
 (\ p -> (e.1 p.1,p.2),qinv (A * C) (B * C) (\ p -> (e.1 p.1,p.2)) (\ p -> (e.2.sec p.1,p.2))
  (\ p -> ap B (B * C) (\ b -> (b,p.2)) _ _ (e.2.sec-eq p.1))
  (\ p -> ap A (A * C) (\ a -> (a,p.2)) _ _ (sec-ret A B e.1 e.2 p.1))) ;
homotopy (A B : U l) (e : Equiv A B) (f : A -> B)
 (h : (a : A) -> Id B (f a) (e.1 a)) : isEquiv A B f =
 qinv A B f e.2.sec
  (\ b -> trans B _ _ _ (h (e.2.sec b)) (e.2.sec-eq b))
  (\ a -> trans A _ _ _ (ap B A e.2.sec _ _ (h a)) (sec-ret A B e.1 e.2 a)) ;
injective (A B : U l) (f : A -> B) (e : isEquiv A B f)
 (a b : A) (h : Id B (f a) (f b)) : Id A a b =
 trans A _ _ _ (sym A _ _ (sec-ret A B f e a))
  (trans A _ _ _ (ap B A e.sec _ _ h) (sec-ret A B f e b)) ;
