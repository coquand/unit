-- SAG 3.3.4 extended to schemes: uniform bounds for merely existing witnesses.
-- No pointwise choice of natural numbers is made.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ; module FB = FiniteBounds[l] ;
le-prop : (m n : Nat) -> Pr.isProp (CB.le m n) = split {
 zero -> \ n -> FinSum[l].top-prop ;
 suc m | ih -> split { zero -> \ a b -> efq a ; suc n -> ih n } } ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module Choice = SchemeChoice[l].Over[R,setR,axioms] ;
 module Bnd = SchemeBounded[l].Over[R,setR,axioms] ;
 module At (X : U l) (scheme : S.Scheme X) (P : X -> Nat -> U l)
  (prop : (x : X) (n : Nat) -> Pr.isProp (P x n))
  (up : (x : X) (m n : Nat) -> CB.le m n -> P x m -> P x n) {
  Inhabitant (x : X) : U l = (n : Nat) * P x n ;
  Goal : U l = (N : Nat) * ((x : X) -> P x N) ;
  module Chosen (w : Choice.Witness X Inhabitant) {
   c : S.Cover[X] = w.1 ;
   Local (i : Fin c.size) : U l =
    Bnd.Goal (S.Domain X (c.charts i)) (\ a -> (w.2 i a).1) ;
   local-bound (i : Fin c.size) : Tr.Trunc[Local i].carrier =
    Bnd.small (S.Domain X (c.charts i))
     (Tr.Trunc[SA.Witness (S.Domain X (c.charts i))].inc
      ((c.charts i).presentation,Pr.idEquiv (S.Domain X (c.charts i))))
     (\ a -> (w.2 i a).1) ;
   module Combine (bs : (i : Fin c.size) -> Local i) {
    N : Nat = FB.bound c.size (\ i -> (bs i).1) ;
    at-chart (i : Fin c.size) (a : S.Domain X (c.charts i)) :
     P ((c.charts i).map a) N =
     up ((c.charts i).map a) (w.2 i a).1 N
      (FB.le-trans _ (bs i).1 N ((bs i).2 a) (FB.bounded c.size (\ i -> (bs i).1) i))
      (w.2 i a).2 ;
    at-image (x : X) (i : Fin c.size) (u : S.Image X (c.charts i) x) : P x N =
     Tr.Trunc[SchemeMaps[l].Fiber (S.Domain X (c.charts i)) X (c.charts i).map x].induction @l
      (\ t -> P x N) (\ t -> prop x N)
      (\ v -> Pr.subst X (\ y -> P y N) _ x v.2 (at-chart i v.1)) u ;
    result : Goal = (N,\ x ->
     Tr.Trunc[(i : Fin c.size) * S.Image X (c.charts i) x].induction @l
      (\ t -> P x N) (\ t -> prop x N) (\ u -> at-image x u.1 u.2) (c.covers x)) ;
   } ;
   theorem : Tr.Trunc[Goal].carrier =
    Tr.Trunc[(i : Fin c.size) -> Local i].induction @l
     (\ t -> Tr.Trunc[Goal].carrier) (\ t -> Tr.Trunc[Goal].proposition)
     (\ bs -> Tr.Trunc[Goal].inc Combine[bs].result)
     (AffineFinite[l].choice c.size Local local-bound) ;
  } ;
  theorem (inhabited : (x : X) -> Tr.Trunc[Inhabitant x].carrier) : Tr.Trunc[Goal].carrier =
   Tr.Trunc[Choice.Witness X Inhabitant].induction @l
    (\ t -> Tr.Trunc[Goal].carrier) (\ t -> Tr.Trunc[Goal].proposition)
    (\ w -> Chosen[w].theorem) (Choice.theorem X scheme Inhabitant inhabited) ;
 } ;
 functions (X : U l) (scheme : S.Scheme X) (f : X -> Nat) : Tr.Trunc[Bnd.Goal X f].carrier =
  At[X,scheme,\ x n -> CB.le (f x) n,\ x n -> le-prop (f x) n,
   \ x m n h k -> FB.le-trans (f x) m n k h].theorem
   (\ x -> Tr.Trunc[(n : Nat) * CB.le (f x) n].inc (f x,FB.le-refl (f x))) ;
} ;
