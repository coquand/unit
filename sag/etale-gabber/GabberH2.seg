-- Gabber's theorem in H^2 form (H^2 bridges, A6): for A f.p. and an etale
-- R^x-gerbe G over Spec A which is a stack, whose class is killed by n0+1
-- in the sense that the band change (n0+1)_* G (BANDCHANGE: weight-u^(n0+1)
-- families of rank-one modules on G) has an object at every point, merely
-- an Azumaya algebra E : Spec A -> AZ_N with
--     delta(E) = cl(G)      in H^2 (STACKGERBES.H2),
-- delta(E) the class of its splitting gerbe (SPLITGERBE).
-- Proof.  An object of (n0+1)_* G at x is GABBERAZUMAYA's Lambda, which
-- gives merely n, V of weight 1 with fibres of rank n+2 and E x = descended
-- End(V x), Azumaya.  At each x, Phi : G x -> Split(E x)
-- is an equivalence (SPLITEQUIVALENCE), and so is G x ~ Small, the small
-- model of Split(E x) (SPLITSMALL), which preserves the bands; so G x =
-- Split(E x) as stack gerbes (STACKGERBES.Eq), and the classes agree
-- (STACKGERBES.H2.cl-eq).  sh is any closure at level l, for instance the
-- one ETALECLOSURE constructs (GABBERH2CLOSED).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module TG = TGerbes[l].Over[R,setR,axioms,sh] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module SG = StackGerbes[l].Over[R,setR,axioms,sh] ;
 module GA = GabberAzumaya[l].Over[R,setR,axioms,loc,sh] ;
 module SGe = SplitGerbe[l].Over[R,setR,axioms,sh] ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TG.TGerbe) (stk : (x : C.Spec A) -> ET.T.isModal @l (G x).carrier)
  (n0 : Nat) (torsion : (x : C.Spec A) -> BandChange[l].Over[R,setR,axioms,sh].At[BandChange[l].Over[R,setR,axioms,sh].Power[G x,suc n0].char].Obj) {
  X : U l = C.Spec A ;
  module GX = GA.At[A,fp,G,n0,\ x -> (torsion x).1,\ x -> (torsion x).2.1,\ x -> (torsion x).2.2] ;
  module H = SG.H2[X] ;
  -- the class of G, and that of an Azumaya algebra
  cl-G : H.H2 = H.cl (\ x -> SG.lift (G x) (stk x)) ;
  Splitting (n : Nat) (Az : GA.Azumaya n) : SG.StackGerbe = SGe.OfAzumaya[suc n,Az].gerbe ;
  delta (n : Nat) (E : X -> GA.Azumaya n) : H.H2 = H.cl (\ x -> Splitting n (E x)) ;
  Result : U l+ = (n : Nat) * (E : X -> GA.Azumaya n) * Id H.H2 (delta n E) cl-G ;
  module Point (q : GX.NA.Result) (x : X) {
   n : Nat = q.1 ;
   module SE = SplitEquivalence[l].Over[R,setR,axioms,sh].At[TG.At[G x].banded,q.2.1 x,q.2.2.1 x,suc n,q.2.2.2 x] ;
   module OA = SGe.OfAzumaya[suc n,GX.algebra q x] ;
   module ON = SE.Onto[stk x,(G x).inh,OA.A.paths] ;
   same : Id SG.StackGerbe (Splitting n (GX.algebra q x)) (SG.lift (G x) (stk x)) =
    Prelude[l+].sym SG.StackGerbe (SG.lift (G x) (stk x)) (Splitting n (GX.algebra q x))
     (SG.Eq[SG.lift (G x) (stk x)].theorem (Splitting n (GX.algebra q x)) ON.equivalence ON.preserves) ;
  } ;
  result (q : GX.NA.Result) : Result =
   (q.1,GX.algebra q,H.cl-eq (\ x -> Splitting q.1 (GX.algebra q x)) (\ x -> SG.lift (G x) (stk x))
     (Tr1.Trunc[(x : X) -> Id SG.StackGerbe (Splitting q.1 (GX.algebra q x)) (SG.lift (G x) (stk x))].inc (\ x -> Point[q,x].same))) ;
  theorem : Tr1.Trunc[Result].carrier =
   Tr1.Trunc[GX.NA.Result].induction @(l+) (\ t -> Tr1.Trunc[Result].carrier) (\ t -> Tr1.Trunc[Result].proposition)
    (\ q -> Tr1.Trunc[Result].inc (result q)) GX.normalised-result ;
 } ;
} ;
-- The theorem with the closure constructed at level l (ETALECLOSURE): its
-- parameters are R, the SAG axioms at level l and Zariski locality; no
-- closure is assumed.
module Closed (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module EC = EtaleClosure[l].Over[R,setR,axioms] ;
 module H = Over[R,setR,axioms,loc,EC.ops] ;
 module At (A : H.C.Algebra) (fp : H.P.FP A) (G : H.C.Spec A -> H.TG.TGerbe) (stk : (x : H.C.Spec A) -> H.ET.T.isModal @l (G x).carrier)
  (n0 : Nat) (torsion : (x : H.C.Spec A) -> BandChange[l].Over[R,setR,axioms,EC.ops].At[BandChange[l].Over[R,setR,axioms,EC.ops].Power[G x,suc n0].char].Obj) {
  theorem : Tr1.Trunc[H.At[A,fp,G,stk,n0,torsion].Result].carrier = H.At[A,fp,G,stk,n0,torsion].theorem ;
 } ;
} ;
