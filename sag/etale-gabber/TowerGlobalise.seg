-- Lemma Globalise (GABBER-PROPER-DESIGN.md, section 2).  A f.p.,
-- P : Spec A -> U l, and at each point y merely a tower over Top all of
-- whose points give ||P y|| (Cover Top).  Then merely one tower over Spec A
-- all of whose points z give ||P (base z)|| (Cover (Spec A) P).
--  1. Z-choice: u_0 .. u_(n-1) generating the unit ideal, and on each D(u_i)
--     a section x |-> (s_i x, t_i x, h_i x) of the pointwise witnesses.
--  2. LOCALLYCONSTANT on each D(u_i): b_ij covering D(u_i), and
--     s_i = sigma_ij on D(u_i) n D(b_ij) = D(w_ij), w_ij = u_i b_ij.
--  3. On D(w_ij) the towers t_i x have the one shape sigma_ij (transport
--     along s_i x = sigma_ij); gathered (TOWERASSEMBLY) and pulled back to
--     D(w_ij) they form one tower, each point of which gives ||P|| at its
--     base; TOWERCLEARING gives a tower over Spec A mapping to it over D(w_ij).
--  4. The product of all cleared towers.  A point z over y gives a point of
--     every factor over y; merely y(u_i) is a unit (the u_i generate the
--     unit ideal), then merely y(b_ij) is a unit (the pieces cover D(u_i)),
--     so y(w_ij) is a unit, and the cleared tower ij gives ||P y||.
-- All choices (Z-choice, pieces, fractions) stay inside the truncation of
-- the final witness; finitely many by finite choice.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module TW = Towers[l].Over[R,setR] ;
 module TA = TowerAssembly[l].Over[R,setR] ;
 module TCl = TowerClearing[l].Over[R,setR,axioms] ;
 module LC = LocallyConstant[l].Over[R,setR,axioms] ;
 module SC = ShapeCodes[l] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module AC = AffineCovers[l].Over[R,setR,axioms.loc] ;
 module FC = AffineFinite[l] ;
 module L = RL[R] ;
 module At (A : C.Algebra) (fp : P.FP A) (Pp : C.Spec A -> U l) (local : (y : C.Spec A) -> TW.Cover Top (\ v -> Pp y)) {
  Wit (y : C.Spec A) : U l = TW.Witness Top (\ v -> Pp y) ;
  Q (y : C.Spec A) (s : SC.Shape) : U l = (t : TW.Tower s Top) * ((z : TW.Points s Top t) -> Tr.Trunc[Pp y].carrier) ;
  Goal : U l = TW.Cover (C.Spec A) Pp ;
  -- units of a product, at a point
  unit-left (y : C.Spec A) (a b : A.ring.R) (v : L.unit (y.1.1 (A.ring.mul a b))) : L.unit (y.1.1 a) =
   RR.unit-left (y.1.1 a) (y.1.1 b) (Pr.subst R.R L.unit _ _ (y.1.2.2.2 a b) v) ;
  unit-right (y : C.Spec A) (a b : A.ring.R) (v : L.unit (y.1.1 (A.ring.mul a b))) : L.unit (y.1.1 b) =
   RR.unit-right (y.1.1 a) (y.1.1 b) (Pr.subst R.R L.unit _ _ (y.1.2.2.2 a b) v) ;
  unit-both (y : C.Spec A) (a b : A.ring.R) (va : L.unit (y.1.1 a)) (vb : L.unit (y.1.1 b)) : L.unit (y.1.1 (A.ring.mul a b)) =
   Pr.subst R.R L.unit _ _ (sym (y.1.2.2.2 a b)) (RR.unit-product (y.1.1 a) (y.1.1 b) va vb) ;
  -- 1.
  module Choice (n : Nat) (u : Fin n -> A.ring.R) (uni : Ax.Unimodular A n u)
   (sec : (i : Fin n) (y : C.Spec A) -> L.unit (y.1.1 (u i)) -> Wit y) {
   shape (i : Fin n) (x : I.D A (u i)) : SC.Shape = (sec i x.1 x.2).1 ;
   -- 2.
   module Pieces (pc : (i : Fin n) -> LC.Shapes[A,fp,u i,shape i].H.Pieces) {
    -- 3.
    module Piece (i : Fin n) (j : Fin (pc i).m) {
     w : A.ring.R = A.ring.mul (u i) ((pc i).b j) ;
     sigma : SC.Shape = SC.decode ((pc i).value j) ;
     D : U l = I.D A w ;
     at (x : D) : I.D A (u i) = (x.1,unit-left x.1 (u i) ((pc i).b j) x.2) ;
     same (x : D) : Id SC.Shape (shape i (at x)) sigma =
      LC.Shapes[A,fp,u i,shape i].constant (pc i) j (at x) (unit-right x.1 (u i) ((pc i).b j) x.2) ;
     q (x : D) : Q x.1 sigma = subst (Q x.1) (same x) (sec i x.1 (at x).2).2 ;
     gathered : TW.Tower sigma ((x : D) * Top) = TA.gather sigma D (\ x -> Top) (\ x -> (q x).1) ;
     old : TW.Tower sigma D = TW.pull sigma ((x : D) * Top) D (\ x -> (x,tt)) gathered ;
     -- a point of old gives P at its base
     module Old (o : TW.Points sigma D old) {
      g : TW.Points sigma ((x : D) * Top) gathered = TW.pull-points sigma ((x : D) * Top) D (\ x -> (x,tt)) gathered o ;
      gp : (x : D) * TW.Points sigma Top (q x).1 = TA.gather-points sigma D (\ x -> Top) (\ x -> (q x).1) g ;
      base : Id D gp.1 (TW.base sigma D old o) =
       trans (TA.gather-base sigma D (\ x -> Top) (\ x -> (q x).1) g)
        (ap (\ p -> p.1) (TW.pull-base sigma ((x : D) * Top) D (\ x -> (x,tt)) gathered o)) ;
      covered : Tr.Trunc[Pp (TW.base sigma D old o).1].carrier =
       subst (\ x -> Tr.Trunc[Pp x.1].carrier) base ((q gp.1).2 gp.2) ;
     } ;
     module CL = TCl.Clearing[A,fp,w] ;
     Cleared : U l = TCl.Result sigma CL.B.frame D (\ x -> x) old ;
     cleared : Tr.Trunc[Cleared].carrier = CL.theorem sigma old ;
     -- a point of the cleared tower over y with y(w) a unit gives P y
     module From (cl : Cleared) (z : TW.Points sigma (C.Spec A) cl.1)
      (v : L.unit (CL.B.value (TW.base sigma (C.Spec A) cl.1 z))) {
      module Rs = CL.Restrict[sigma,old,cl,z,v] ;
      result : Tr.Trunc[Pp (TW.base sigma (C.Spec A) cl.1 z)].carrier =
       subst (\ x -> Tr.Trunc[Pp x.1].carrier) Rs.lies-over Old[Rs.point].covered ;
     } ;
    } ;
    -- 4.
    module Cleared (cl : (i : Fin n) (j : Fin (pc i).m) -> Piece[i,j].Cleared) {
     tower (i : Fin n) (j : Fin (pc i).m) : TA.Some (C.Spec A) = (Piece[i,j].sigma,(cl i j).1) ;
     row (i : Fin n) : TA.Some (C.Spec A) = TA.product (C.Spec A) (pc i).m (tower i) ;
     total : TA.Some (C.Spec A) = TA.product (C.Spec A) n row ;
     module Point (z : TA.Pts (C.Spec A) total) {
      y : C.Spec A = TA.bs (C.Spec A) total z ;
      module At (i : Fin n) (vu : L.unit (y.1.1 (u i))) (j : Fin (pc i).m) (vb : L.unit (y.1.1 ((pc i).b j))) {
       o1 : TA.Over-point (C.Spec A) (row i) y = TA.project (C.Spec A) n row i z ;
       o2 : TA.Over-point (C.Spec A) (tower i j) (TA.bs (C.Spec A) (row i) o1.1) =
        TA.project (C.Spec A) (pc i).m (tower i) j o1.1 ;
       over : Id (C.Spec A) (TA.bs (C.Spec A) (tower i j) o2.1) y = trans o2.2 o1.2 ;
       unit : L.unit (Piece[i,j].CL.B.value (TA.bs (C.Spec A) (tower i j) o2.1)) =
        Pr.subst (C.Spec A) (\ y' -> L.unit (y'.1.1 Piece[i,j].w)) _ _ (sym over) (unit-both y (u i) ((pc i).b j) vu vb) ;
       result : Tr.Trunc[Pp y].carrier =
        subst (\ y' -> Tr.Trunc[Pp y'].carrier) over Piece[i,j].From[cl i j,o2.1,unit].result ;
      } ;
      at-i (iu : (i : Fin n) * L.unit (y.1.1 (u i))) : Tr.Trunc[Pp y].carrier =
       Tr.Trunc[(j : Fin (pc iu.1).m) * L.unit (y.1.1 ((pc iu.1).b j))].induction @l
        (\ t -> Tr.Trunc[Pp y].carrier) (\ t -> Tr.Trunc[Pp y].proposition)
        (\ jv -> At[iu.1,iu.2,jv.1,jv.2].result) ((pc iu.1).cover (y,iu.2)) ;
      result : Tr.Trunc[Pp y].carrier =
       Tr.Trunc[(i : Fin n) * L.unit (y.1.1 (u i))].induction @l
        (\ t -> Tr.Trunc[Pp y].carrier) (\ t -> Tr.Trunc[Pp y].proposition) at-i (AC.At[A,n,u].cover uni y) ;
     } ;
     witness : TW.Witness (C.Spec A) Pp = (total.1,total.2,\ z -> Point[z].result) ;
    } ;
    All : U l = (i : Fin n) (j : Fin (pc i).m) -> Piece[i,j].Cleared ;
    theorem : Goal =
     Tr.Trunc[All].induction @l (\ t -> Goal) (\ t -> Tr.Trunc[TW.Witness (C.Spec A) Pp].proposition)
      (\ cl -> Tr.Trunc[TW.Witness (C.Spec A) Pp].inc Cleared[cl].witness)
      (FC.choice n (\ i -> (j : Fin (pc i).m) -> Piece[i,j].Cleared)
       (\ i -> FC.choice (pc i).m (\ j -> Piece[i,j].Cleared) (\ j -> Piece[i,j].cleared))) ;
   } ;
   theorem : Goal =
    Tr.Trunc[(i : Fin n) -> LC.Shapes[A,fp,u i,shape i].H.Pieces].induction @l (\ t -> Goal)
     (\ t -> Tr.Trunc[TW.Witness (C.Spec A) Pp].proposition) (\ pc -> Pieces[pc].theorem)
     (FC.choice n (\ i -> LC.Shapes[A,fp,u i,shape i].H.Pieces) (\ i -> LC.Shapes[A,fp,u i,shape i].H.theorem)) ;
  } ;
  theorem : Goal =
   Tr.Trunc[Ax.ChoiceData A Wit].induction @l (\ t -> Goal) (\ t -> Tr.Trunc[TW.Witness (C.Spec A) Pp].proposition)
    (\ d -> Choice[d.1,d.2.1,d.2.2.1,d.2.2.2].theorem) (axioms.zchoice A fp Wit local) ;
 } ;
} ;
