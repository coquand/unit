-- Hom out of a direct sum and out of R (HOMMODULE, MODULESUMS).
--  (compose)  For a linear g : M -> N and f in Hom(N, U), f o g is in
--     Hom(M, U).
--  (sum)  Hom(A + B, U) = Hom(A, U) + Hom(B, U).  Restriction
--     f |-> (f o inl, f o inr), with inl a = (a, 0), inr b = (0, b), is
--     linear (pointwise), and has the inverse (g, h) |-> ((a,b) |-> g a + h b):
--     f(a,0) + f(0,b) = f(a + 0, 0 + b) = f(a,b), and g a + h 0 = g a since
--     h 0 = 0 (and likewise on the right).
--  (regular)  Hom(R, U) = U: f |-> f 1, with inverse u |-> (c |-> c u):
--     f c = f (c 1) = c f(1), and 1 u = u.
--  (one)  R^1 = R: w |-> w(1), with inverse c |-> (the constant c).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module A7 = Alg73[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module HM = HomModule[l].Over[R,setR] ;
 module MS = ModuleSums[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 -- (compose)
 compose (M N U1 : MD.Module) (g : SM.Linear M N) (f : HM.At[N,U1].S.E) : HM.At[M,U1].S.E =
  (\ m -> f.1 (g.1 m),
   \ x y -> trans (ap f.1 (g.2.1 x y)) (f.2.1 (g.1 x) (g.1 y)),
   \ a x -> trans (ap f.1 (g.2.2 a x)) (f.2.2 a (g.1 x))) ;
 -- (sum)
 module Sum (A B U1 : MD.Module) {
  module P2 = MS.Pair[A,B] ;
  module MA = A7.MA[MD.ring,A] ;
  module MB = A7.MA[MD.ring,B] ;
  module MU = A7.MA[MD.ring,U1] ;
  module HS = HM.At[MS.plus A B,U1] ;
  module HA = HM.At[A,U1] ;
  module HB = HM.At[B,U1] ;
  module Q = MS.Pair[HA.carrier,HB.carrier] ;
  inl : SM.Linear A (MS.plus A B) = (\ a -> (a,B.mz),
   \ x y -> P2.pair-eq _ _ _ _ (refl (A.madd x y)) (sym (B.maddZ B.mz)),
   \ c x -> P2.pair-eq _ _ _ _ (refl (A.sm c x)) (sym (MB.sm-zr c))) ;
  inr : SM.Linear B (MS.plus A B) = (\ b -> (A.mz,b),
   \ x y -> P2.pair-eq _ _ _ _ (sym (A.maddZ A.mz)) (refl (B.madd x y)),
   \ c x -> P2.pair-eq _ _ _ _ (sym (MA.sm-zr c)) (refl (B.sm c x))) ;
  restrict (f : HS.S.E) : Q.Carrier = (compose A (MS.plus A B) U1 inl f,compose B (MS.plus A B) U1 inr f) ;
  combine (z : Q.Carrier) : HS.S.E = (\ u -> U1.madd (z.1.1 u.1) (z.2.1 u.2),
   \ u v -> trans (cong2 U1.M U1.madd _ _ _ _ (z.1.2.1 u.1 v.1) (z.2.2.1 u.2 v.2))
    (MU.swap4 (z.1.1 u.1) (z.1.1 v.1) (z.2.1 u.2) (z.2.1 v.2)),
   \ c u -> trans (cong2 U1.M U1.madd _ _ _ _ (z.1.2.2 c u.1) (z.2.2.2 c u.2))
    (sym (U1.smD c (z.1.1 u.1) (z.2.1 u.2)))) ;
  -- f(a,0) + f(0,b) = f(a,b)
  split-at (f : HS.S.E) (u : P2.Carrier) : Id U1.M (U1.madd (f.1 (u.1,B.mz)) (f.1 (A.mz,u.2))) (f.1 u) =
   trans (sym (f.2.1 (u.1,B.mz) (A.mz,u.2))) (ap f.1 (P2.pair-eq _ _ _ _ (A.maddZ u.1) (MB.mzl u.2))) ;
  combine-restrict (f : HS.S.E) : Id HS.S.E (combine (restrict f)) f = HS.ext _ f (split-at f) ;
  restrict-combine (z : Q.Carrier) : Id Q.Carrier (restrict (combine z)) z =
   Q.pair-eq _ _ _ _
    (HA.ext _ z.1 (\ a -> trans (ap (U1.madd (z.1.1 a)) (SM.Lin[B,U1,z.2].map-z)) (U1.maddZ (z.1.1 a))))
    (HB.ext _ z.2 (\ b -> trans (ap (\ t -> U1.madd t (z.2.1 b)) (SM.Lin[A,U1,z.1].map-z)) (MU.mzl (z.2.1 b)))) ;
  theorem : Id MD.Module HS.carrier (MS.plus HA.carrier HB.carrier) =
   SIP.sip HS.carrier (MS.plus HA.carrier HB.carrier)
    ((restrict,Pr.qinv HS.S.E Q.Carrier restrict combine restrict-combine combine-restrict),
     \ f f' -> Q.pair-eq _ _ _ _ (HA.ext _ _ (\ a -> refl (U1.madd (f.1 (a,B.mz)) (f'.1 (a,B.mz)))))
      (HB.ext _ _ (\ b -> refl (U1.madd (f.1 (A.mz,b)) (f'.1 (A.mz,b))))),
     \ c f -> Q.pair-eq _ _ _ _ (HA.ext _ _ (\ a -> refl (U1.sm c (f.1 (a,B.mz)))))
      (HB.ext _ _ (\ b -> refl (U1.sm c (f.1 (A.mz,b)))))) ;
 } ;
 -- (regular)
 module Regular (U1 : MD.Module) {
  module HR = HM.At[MD.regular,U1] ;
  evaluate (f : HR.S.E) : U1.M = f.1 R.o ;
  line (u : U1.M) : HR.S.E = (\ c -> U1.sm c u,\ x y -> U1.smE x y u,\ a x -> sym (U1.smA a x u)) ;
  line-evaluate (f : HR.S.E) : Id HR.S.E (line (evaluate f)) f =
   HR.ext _ f (\ c -> trans (sym (f.2.2 c R.o)) (ap f.1 (R.mulO c))) ;
  theorem : Id MD.Module HR.carrier U1 =
   SIP.sip HR.carrier U1 ((evaluate,Pr.qinv HR.S.E U1.M evaluate line (\ u -> U1.smO u) line-evaluate),
    \ f f' -> refl (U1.madd (f.1 R.o) (f'.1 R.o)),
    \ c f -> refl (U1.sm c (f.1 R.o))) ;
 } ;
 -- (one)
 module One {
  at (w : (Fin (suc zero)) -> R.R) : R.R = w (inr tt) ;
  constant (c : R.R) : (Fin (suc zero)) -> R.R = \ i -> c ;
  top (w : (Fin (suc zero)) -> R.R) : (t : Top) -> Id R.R (w (inr tt)) (w (inr t)) = split { tt -> refl (w (inr tt)) } ;
  points (w : (Fin (suc zero)) -> R.R) : (i : Fin (suc zero)) -> Id R.R (w (inr tt)) (w i) = split {
   inl i -> efq i ;
   inr t -> top w t } ;
  theorem : Id MD.Module (MD.pi (Fin (suc zero)) (\ i -> MD.regular)) MD.regular =
   SIP.sip (MD.pi (Fin (suc zero)) (\ i -> MD.regular)) MD.regular
    ((at,Pr.qinv ((Fin (suc zero)) -> R.R) R.R at constant (\ c -> refl c)
      (\ w -> F.funext (Fin (suc zero)) (\ i -> R.R) (constant (at w)) w (points w))),
     \ w w' -> refl (R.add (w (inr tt)) (w' (inr tt))),
     \ c w -> refl (R.mul c (w (inr tt)))) ;
 } ;
} ;
