-- P(V (x) F)^v = P(V)^v (x) F^(x)n at one fibre, without tensor products
-- (gabber-recollement, Proposition `correct`).  Over R, with the tensor
-- convention of MATRIXTENSOR (V (x) (I e)* = Hom(I e, V)) and
-- P(V)^v = power V L n (MULTILINEAR).
--  (contract)  For X with a frame e_j, c_j (FRAMES) and any V, M:
--       Hom(Hom(X, V), M) = Hom(X*, Hom(V, M)),
--     Phi(alpha)(xi)(v) = alpha(rank xi v),  rank xi v = (x |-> xi(x) v),
--     Psi(beta)(phi) = sum_j beta(c_j)(phi(e_j)).
--     Psi Phi = id:  sum_j rank c_j (phi e_j) = phi  (frame law of X);
--     Phi Psi = id:  sum_j beta(c_j)(xi(e_j) v) = beta(sum_j xi(e_j) c_j)(v)
--                    = beta(xi)(v)                  (dual law of X).
--  (iterate)  iterate Y Z 0 = Z, iterate Y Z (k+1) = Hom(Y, iterate Y Z k);
--     Hom(V, iterate Y Z k) = iterate Y (Hom(V, Z)) k  (HOMIMAGE.Swap k times).
--  (powers)  power (Hom(X, V)) L k = iterate X* (power V L k) k, by induction:
--       Hom(Hom(X, V), iterate X* P_k k) = Hom(X*, Hom(V, iterate X* P_k k))  (contract)
--       = Hom(X*, iterate X* (Hom(V, P_k)) k)                               (iterate)
--     and Hom(V, P_k) = P_(k+1) by definition.
-- For X = I e (columns frame, X* = I e^T by HOMIMAGE.Idem.dual) the iterated
-- Homs out of I e^T are computed by HOMIMAGE.hom-image (TWISTEDTENSOR).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module CP = Comparison[l].Over[R,setR] ;
 module HI = HomImage[l].Over[R,setR,axioms] ;
 module ML = Multilinear[l].Over[R,setR] ;
 -- (contract)
 module Contract (X V M : MD.Module) (r : Nat) (fx : FR.Frame[X,r]) {
  module HX = HM.At[X,V] ;
  module HA = HM.At[HX.carrier,M] ;
  module HV = HM.At[V,M] ;
  module HB = HM.At[FR.dual X,HV.carrier] ;
  module SX = ModuleFiniteSums[l].Over[R,setR,HX.carrier] ;
  module SMM = ModuleFiniteSums[l].Over[R,setR,M] ;
  module LM = ModuleSumLaws[l].Over[R,setR,M] ;
  module SV = ModuleFiniteSums[l].Over[R,setR,HV.carrier] ;
  module SD = ModuleFiniteSums[l].Over[R,setR,FR.dual X] ;
  e (j : Fin r) : X.M = fx.vector j ;
  c (j : Fin r) : (FR.dual X).M = fx.form j ;
  -- x |-> xi(x) v
  rank (xi : (FR.dual X).M) (v : V.M) : HX.S.E = (\ u -> V.sm (xi.1 u) v,
   \ u u' -> trans (ap (\ t -> V.sm t v) (xi.2.1 u u')) (V.smE (xi.1 u) (xi.1 u') v),
   \ t u -> trans (ap (\ s -> V.sm s v) (xi.2.2 t u)) (sym (V.smA t (xi.1 u) v))) ;
  rank-add (xi : (FR.dual X).M) (v v' : V.M) : Id HX.S.E (rank xi (V.madd v v')) (HX.carrier.madd (rank xi v) (rank xi v')) =
   HX.ext _ _ (\ u -> V.smD (xi.1 u) v v') ;
  rank-scale (xi : (FR.dual X).M) (t : R.R) (v : V.M) : Id HX.S.E (rank xi (V.sm t v)) (HX.carrier.sm t (rank xi v)) =
   HX.ext _ _ (\ u -> trans (V.smA (xi.1 u) t v)
    (trans (ap (\ s -> V.sm s v) (R.mulC (xi.1 u) t)) (sym (V.smA t (xi.1 u) v)))) ;
  rank-form-add (xi xi' : (FR.dual X).M) (v : V.M) :
   Id HX.S.E (rank ((FR.dual X).madd xi xi') v) (HX.carrier.madd (rank xi v) (rank xi' v)) =
   HX.ext _ _ (\ u -> V.smE (xi.1 u) (xi'.1 u) v) ;
  rank-form-scale (t : R.R) (xi : (FR.dual X).M) (v : V.M) :
   Id HX.S.E (rank ((FR.dual X).sm t xi) v) (HX.carrier.sm t (rank xi v)) =
   HX.ext _ _ (\ u -> sym (V.smA t (xi.1 u) v)) ;
  -- Phi
  value (a : HA.S.E) (xi : (FR.dual X).M) : HV.S.E = (\ v -> a.1 (rank xi v),
   \ v v' -> trans (ap a.1 (rank-add xi v v')) (a.2.1 (rank xi v) (rank xi v')),
   \ t v -> trans (ap a.1 (rank-scale xi t v)) (a.2.2 t (rank xi v))) ;
  map (a : HA.S.E) : HB.S.E = (value a,
   \ xi xi' -> HV.ext _ _ (\ v -> trans (ap a.1 (rank-form-add xi xi' v)) (a.2.1 (rank xi v) (rank xi' v))),
   \ t xi -> HV.ext _ _ (\ v -> trans (ap a.1 (rank-form-scale t xi v)) (a.2.2 t (rank xi v)))) ;
  map-add (a a' : HA.S.E) : Id HB.S.E (map (HA.carrier.madd a a')) (HB.carrier.madd (map a) (map a')) =
   HB.ext _ _ (\ xi -> HV.ext _ _ (\ v -> refl (M.madd (a.1 (rank xi v)) (a'.1 (rank xi v))))) ;
  map-scale (t : R.R) (a : HA.S.E) : Id HB.S.E (map (HA.carrier.sm t a)) (HB.carrier.sm t (map a)) =
   HB.ext _ _ (\ xi -> HV.ext _ _ (\ v -> refl (M.sm t (a.1 (rank xi v))))) ;
  -- Psi
  term (b : HB.S.E) (phi : HX.S.E) (j : Fin r) : M.M = (b.1 (c j)).1 (phi.1 (e j)) ;
  back-value (b : HB.S.E) (phi : HX.S.E) : M.M = SMM.sum r (term b phi) ;
  back (b : HB.S.E) : HA.S.E = (back-value b,
   \ phi psi -> trans (SMM.congruent r (term b (HX.carrier.madd phi psi)) (\ j -> M.madd (term b phi j) (term b psi j))
     (\ j -> (b.1 (c j)).2.1 (phi.1 (e j)) (psi.1 (e j))))
    (LM.sum-add r (term b phi) (term b psi)),
   \ t phi -> trans (SMM.congruent r (term b (HX.carrier.sm t phi)) (\ j -> M.sm t (term b phi j))
     (\ j -> (b.1 (c j)).2.2 t (phi.1 (e j))))
    (sym (LM.scale-sum t r (term b phi)))) ;
  -- (Psi Phi): sum_j rank c_j (phi e_j) = phi
  ranks (phi : HX.S.E) : Id HX.S.E (SX.sum r (\ j -> rank (c j) (phi.1 (e j)))) phi =
   HX.ext _ phi (\ u -> trans (CP.apply-sum X V u r (\ j -> rank (c j) (phi.1 (e j))))
    (trans (sym (CP.combination X V phi r (\ j -> (c j).1 u) e)) (ap phi.1 (fx.law u)))) ;
  back-map (a : HA.S.E) : Id HA.S.E (back (map a)) a =
   HA.ext _ a (\ phi -> trans (sym (ModuleSumLaws[l].Over[R,setR,HX.carrier].Map[M,a.1,SM.Lin[HX.carrier,M,a].map-z,a.2.1].sum r
     (\ j -> rank (c j) (phi.1 (e j))))) (ap a.1 (ranks phi))) ;
  -- (Phi Psi)
  map-back-at (b : HB.S.E) (xi : (FR.dual X).M) (v : V.M) : Id M.M (back-value b (rank xi v)) ((b.1 xi).1 v) =
   calc M.M { SMM.sum r (term b (rank xi v))
     =< SMM.congruent r (term b (rank xi v)) (\ j -> M.sm (xi.1 (e j)) ((b.1 (c j)).1 v)) (\ j -> (b.1 (c j)).2.2 (xi.1 (e j)) v) >
        SMM.sum r (\ j -> M.sm (xi.1 (e j)) ((b.1 (c j)).1 v))
     =< sym (CP.apply-sum V M v r (\ j -> HV.carrier.sm (xi.1 (e j)) (b.1 (c j)))) >
        (SV.sum r (\ j -> HV.carrier.sm (xi.1 (e j)) (b.1 (c j)))).1 v
     =< ap (\ h -> h.1 v) (sym (CP.combination (FR.dual X) HV.carrier b r (\ j -> xi.1 (e j)) c)) >
        (b.1 (SD.sum r (\ j -> (FR.dual X).sm (xi.1 (e j)) (c j)))).1 v
     =< ap (\ z -> (b.1 z).1 v) (FR.Of[X,r,fx].dual-law xi) > (b.1 xi).1 v } ;
  map-back (b : HB.S.E) : Id HB.S.E (map (back b)) b =
   HB.ext _ b (\ xi -> HV.ext _ _ (\ v -> map-back-at b xi v)) ;
  theorem : Id MD.Module HA.carrier HB.carrier =
   SIP.sip HA.carrier HB.carrier ((map,Pr.qinv HA.S.E HB.S.E map back map-back back-map),map-add,\ t a -> map-scale t a) ;
 } ;
 -- (iterate)
 iterate (Y Z : MD.Module) : Nat -> MD.Module = split {
  zero -> Z ;
  suc k | q -> HI.hom Y q } ;
 inside (V Y Z : MD.Module) : (k : Nat) -> Id MD.Module (HI.hom V (iterate Y Z k)) (iterate Y (HI.hom V Z) k) = split {
  zero -> refl (HI.hom V Z) ;
  suc k | h -> Pr1.trans MD.Module (HI.hom V (HI.hom Y (iterate Y Z k))) (HI.hom Y (HI.hom V (iterate Y Z k)))
    (HI.hom Y (iterate Y (HI.hom V Z) k))
    HI.Swap[V,Y,iterate Y Z k].theorem
    (Pr1.ap MD.Module MD.Module (HI.hom Y) (HI.hom V (iterate Y Z k)) (iterate Y (HI.hom V Z) k) h) } ;
 -- (powers)
 module Powers (X V L : MD.Module) (r : Nat) (fx : FR.Frame[X,r]) {
  theorem : (k : Nat) -> Id MD.Module (ML.power (HI.hom X V) L k) (iterate (FR.dual X) (ML.power V L k) k) = split {
   zero -> refl L ;
   suc k | h -> Pr1.trans MD.Module (HI.hom (HI.hom X V) (ML.power (HI.hom X V) L k))
     (HI.hom (HI.hom X V) (iterate (FR.dual X) (ML.power V L k) k))
     (HI.hom (FR.dual X) (iterate (FR.dual X) (ML.power V L (suc k)) k))
     (Pr1.ap MD.Module MD.Module (HI.hom (HI.hom X V)) (ML.power (HI.hom X V) L k) (iterate (FR.dual X) (ML.power V L k) k) h)
     (Pr1.trans MD.Module (HI.hom (HI.hom X V) (iterate (FR.dual X) (ML.power V L k) k))
      (HI.hom (FR.dual X) (HI.hom V (iterate (FR.dual X) (ML.power V L k) k)))
      (HI.hom (FR.dual X) (iterate (FR.dual X) (ML.power V L (suc k)) k))
      Contract[X,V,iterate (FR.dual X) (ML.power V L k) k,r,fx].theorem
      (Pr1.ap MD.Module MD.Module (HI.hom (FR.dual X)) (HI.hom V (iterate (FR.dual X) (ML.power V L k) k))
       (iterate (FR.dual X) (ML.power V L (suc k)) k) (inside V (FR.dual X) (ML.power V L k) k))) } ;
 } ;
} ;
