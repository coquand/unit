-- The class of the global sections.  X = Spec Alg (Alg f.p.), Mx a family of
-- modules over X, and Representation p (FRAMEPROJECTOR): the global sections
-- are Image p, additively and Alg-linearly.
--  (compare) Two representations e_p, e_q give isomorphic images, so
--            [p] = [q] in K_0(Alg) (K0.class-iso).  The map is
--            f = e_q e_p^-1: with s = e_p^-1 x, t = e_p^-1 y,
--            x + y = e_p s + e_p t = e_p (s + t), so
--            f (x + y) = e_q (s + t) = e_q s + e_q t; likewise for scalars;
--            its inverse is e_p e_q^-1 (MODULEISO.make).
--  (trivial) If sigma is a global section and c a global form with
--            c_x(m) sigma(x) = m and c_x(sigma(x)) = 1, then (sigma, c) are
--            frame data of size 1 (FRAMEPROJECTOR.Data), the projector has the
--            single entry back(x |-> c_x(sigma(x))) = 1 (SQC), so its image is
--            that of the unit projector and its class is 1.  By (compare),
--            every projector representing the sections has class 1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (Mx : C.Spec Alg -> MD.Module) {
  module FP = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Mx] ;
  module K = K0[l].Over[Alg.ring,Alg.set] ;
  -- one representation, inverted
  module Rep (p : FP.PJ.Projector) (rp : FP.Representation p) {
   module I = FP.PJ.Image[p] ;
   e (s : FP.Sections) : I.Carrier = rp.1.1 s ;
   sections (v : I.Carrier) : FP.Sections = rp.1.2.sec v ;
   e-sections (v : I.Carrier) : Id I.Carrier (e (sections v)) v = rp.1.2.sec-eq v ;
   sections-e (s : FP.Sections) : Id FP.Sections (sections (e s)) s = Pr.sec-ret FP.Sections I.Carrier rp.1.1 rp.1.2 s ;
   plus (s t : FP.Sections) : FP.Sections = \ x -> (Mx x).madd (s x) (t x) ;
   times (a : Alg.ring.R) (s : FP.Sections) : FP.Sections = \ x -> (Mx x).sm (x.1.1 a) (s x) ;
   e-add (s t : FP.Sections) : Id I.Carrier (e (plus s t)) (I.add (e s) (e t)) =
    I.ext _ _ (I.V.vec-eq _ _ (\ i -> rp.2.1 s t i)) ;
   e-scale (a : Alg.ring.R) (s : FP.Sections) : Id I.Carrier (e (times a s)) (I.scale a (e s)) =
    I.ext _ _ (I.V.vec-eq _ _ (\ i -> rp.2.2 a s i)) ;
   sections-add (x y : I.Carrier) : Id FP.Sections (sections (I.add x y)) (plus (sections x) (sections y)) =
    trans (ap sections (trans (cong2 I.Carrier I.add _ _ _ _ (sym (e-sections x)) (sym (e-sections y)))
      (sym (e-add (sections x) (sections y)))))
     (sections-e (plus (sections x) (sections y))) ;
   sections-scale (a : Alg.ring.R) (x : I.Carrier) : Id FP.Sections (sections (I.scale a x)) (times a (sections x)) =
    trans (ap sections (trans (ap (I.scale a) (sym (e-sections x))) (sym (e-scale a (sections x)))))
     (sections-e (times a (sections x))) ;
  } ;
  -- (compare)
  module Compare (p q : FP.PJ.Projector) (rp : FP.Representation p) (rq : FP.Representation q) {
   module RP = Rep[p,rp] ;
   module RQ = Rep[q,rq] ;
   to (v : RP.I.Carrier) : RQ.I.Carrier = RQ.e (RP.sections v) ;
   from (w : RQ.I.Carrier) : RP.I.Carrier = RP.e (RQ.sections w) ;
   iso : K.Iso p q = K.MI.make RP.I.image RQ.I.image to from
    (\ x y -> trans (ap RQ.e (RP.sections-add x y)) (RQ.e-add (RP.sections x) (RP.sections y)))
    (\ a x -> trans (ap RQ.e (RP.sections-scale a x)) (RQ.e-scale a (RP.sections x)))
    (\ w -> trans (ap RQ.e (RP.sections-e (RQ.sections w))) (RQ.e-sections w))
    (\ v -> trans (ap RP.e (RQ.sections-e (RP.sections v))) (RP.e-sections v)) ;
   same : Id K.K0.R (K.class p) (K.class q) = K.class-iso p q iso ;
  } ;
  -- (trivial)
  module Trivial (sigma : FP.Sections) (c : FP.Forms)
   (law : (x : C.Spec Alg) (m : (Mx x).M) ->
     Id (Mx x).M (ModuleFiniteSums[l].Over[R,setR,Mx x].sum (suc zero) (\ k -> (Mx x).sm ((c x).1 m) (sigma x))) m)
   (unit : (x : C.Spec Alg) -> Id R.R ((c x).1 (sigma x)) R.o) {
   frame-data : FP.Data = new FP.Data[suc zero,\ k -> sigma,\ k -> c,law] ;
   module FD = FP.From[frame-data] ;
   module M1 = MnAlgebra[l].Over[Alg.ring,Alg.set,suc zero] ;
   entry-one : Id Alg.ring.R (FD.entry (inr tt) (inr tt)) Alg.ring.o =
    FP.ext _ _ (\ x -> trans (FD.beta (inr tt) (inr tt) x) (trans (unit x) (sym x.1.2.1))) ;
   diagonal : (t t' : Top) -> Id Alg.ring.R (FD.entry (inr t) (inr t')) (M1.mone (inr t) (inr t')) =
    split { tt -> split { tt -> entry-one } } ;
   entries : (i j : Fin (suc zero)) -> Id Alg.ring.R (FD.entry i j) (M1.mone i j) = split {
    inl i -> \ j -> efq i ;
    inr t -> split { inl j -> efq j ; inr t' -> diagonal t t' } } ;
   module EQ = FP.PJ.Equal[suc zero,FD.entry,M1.mone,FD.MN.mat-eq (FD.MN.mmul FD.entry FD.entry) FD.entry FD.idempotent-at,M1.m-one-left M1.mone,
    M1.mat-eq FD.entry M1.mone entries] ;
   -- FD.projector is new Projector[1, entry, ..]: its image is that of 1
   iso : K.Iso FD.projector FP.PJ.oneP = EQ.iso ;
   class-one : Id K.K0.R (K.class FD.projector) K.K0.o = trans (K.class-iso FD.projector FP.PJ.oneP iso) (sym K.class-one) ;
   -- every representing projector has class 1
   theorem (p : FP.PJ.Projector) (rp : FP.Representation p) : Id K.K0.R (K.class p) K.K0.o =
    trans (Compare[p,FD.projector,rp,FD.representation].same) class-one ;
  } ;
 } ;
} ;
