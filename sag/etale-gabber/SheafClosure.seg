-- Sheafification of the propositional truncation at level j: ||A||_T is a
-- proposition and a sheaf, receives A, and maps into every proposition that
-- is a sheaf (at any level k).  lex: the sheaves of level j form a sheaf
-- (RSS20 Thm 3.11).
level l j ;
module Over (I : U l) (G : I -> U l) {
 module T = SheafTopology[l].Over[I,G] ;
 record Ops {
  close : (A : U j) -> U (l \/ j) ;
  proposition : (A : U j) -> Prelude[l \/ j].isProp (close A) ;
  modal : (A : U j) -> T.isModal @(l \/ j) (close A) ;
  inc : (A : U j) -> A -> close A ;
  elim : [k] (A : U j) (Q : U k) -> Prelude[k].isProp Q -> T.isModal @k Q -> (A -> Q) -> close A -> Q ;
  lex : T.isModal @(l \/ j+) ((X : U j) * T.isModal @j X) ;
 } ;
} ;
