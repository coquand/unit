-- Locally free families have constant rank on a cover (the cover step of
-- ROOTS; CHEAP-DESIGN.md, section 2).  X = Spec Alg (Alg f.p.), Mx a family
-- of modules, w global frame data (FRAMEPROJECTOR) with projector p.  A
-- basis of rank N of a module is a frame (e_a, c_a) with c_a(e_b) = delta_ab.
--  (local)  Let L = Alg[1/f] (AFFINEINTERFACE), a point y of Spec L giving
--     the point y . inc of D(f), and let Mx have a basis on D(f).  Over
--     Spec L, the basis is frame data whose projector has the entries
--     back(y |-> c_i(e_j)) = delta_ij, i.e. it is 1_N; and w restricts to
--     frame data whose projector is inc(p): both entries are d_i(s_j) at
--     y . inc (SQC, as in LINERESTRICT).  Both represent the sections over
--     Spec L, so [inc p] = [1_N] = N in K_0(L) (REPRESENTATIONS.Compare).
--  (monoid)  The localisation A_f at the powers of f (LOCALISATIONS, used by
--     NILPOTENCE) receives to : L -> A_f with to . inc = incl
--     (LOCALIZATIONRINGS), so restricting [p] - N along incl is restricting
--     inc([p] - N) = [inc p] - N = 0 along to (K0RESTRICTION.Compose,
--     Pointwise): [p] - N vanishes on D(f).
--  (cover)  If every fibre merely has a basis of rank N, Z-choice gives f_i
--     with sum_i r_i f_i = 1 and bases on each D(f_i); for each i the
--     localisation exists merely, and vanishing is a proposition, so
--     [p] - N vanishes on the cover f_1 .. f_n (NILPOTENCE.Cover).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 record Basis (M : MD.Module) (N : Nat) {
  frame : FR.Frame[M,N] ;
  dual (a b : Fin N) : Id R.R ((frame.form a).1 (frame.vector b)) (MnAlgebra[l].Over[R,setR,N].mone a b) ;
 } ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (Mx : C.Spec Alg -> MD.Module) {
  module FP = FrameProjector[l].Over[R,setR,axioms].At[Alg,fp,Mx] ;
  module K = K0[l].Over[Alg.ring,Alg.set] ;
  -- [p] - N
  defect (w : FP.Data) (N : Nat) : K.K0.R = K.K0.add (K.class FP.From[w].projector) (K.K0.neg (K.free N)) ;
  -- (local)
  module Local (f : Alg.ring.R) (loc : AI.LocalizationWitness Alg f) (N : Nat)
   (bs : (x : AI.D Alg f) -> Basis[Mx x.1,N]) (w : FP.Data) {
   inc : C.Hom Alg loc.1 = loc.2.2.1 ;
   point (y : C.Spec loc.1) : AI.D Alg f = (AI.spectrum Alg f loc).1 y ;
   My (y : C.Spec loc.1) : MD.Module = Mx (point y).1 ;
   module FL = FrameProjector[l].Over[R,setR,axioms].At[loc.1,loc.2.1,My] ;
   module KL = K0[l].Over[loc.1.ring,loc.1.set] ;
   module ML = MnAlgebra[l].Over[loc.1.ring,loc.1.set,N] ;
   module RI = K0Restriction[l].Over[Alg.ring,loc.1.ring,Alg.set,loc.1.set,inc.1] ;
   module FA = FP.From[w] ;
   basis-data : FL.Data = new FL.Data[N,\ k y -> (bs (point y)).frame.vector k,\ k y -> (bs (point y)).frame.form k,
    \ y -> (bs (point y)).frame.law] ;
   restricted : FL.Data = new FL.Data[w.size,\ k y -> w.section k (point y).1,\ k y -> w.form k (point y).1,
    \ y -> w.law (point y).1] ;
   module FB = FL.From[basis-data] ;
   module FW = FL.From[restricted] ;
   -- the basis projector is 1_N
   basis-entry (i j : Fin N) : Id loc.1.ring.R (FB.entry i j) (ML.mone i j) =
    FL.ext (FB.entry i j) (ML.mone i j) (\ y ->
     trans (FB.beta i j y) (trans ((bs (point y)).dual i j)
      (sym (MatrixMap[l].Over[loc.1.ring,R,loc.1.set,setR,y.1,N].delta-map N i j)))) ;
   basis-class : Id KL.K0.R (KL.class FB.projector) (KL.free N) =
    KL.class-iso FB.projector KL.PJ.Free[N].projector
     KL.PJ.Equal[N,FB.entry,ML.mone,FB.MN.mat-eq (FB.MN.mmul FB.entry FB.entry) FB.entry FB.idempotent-at,
      ML.m-one-left ML.mone,ML.mat-eq FB.entry ML.mone basis-entry].iso ;
   -- the restricted projector is inc(p)
   restricted-entry (i j : Fin w.size) : Id loc.1.ring.R (FW.entry i j) (inc.1.1 (FA.entry i j)) =
    FL.ext (FW.entry i j) (inc.1.1 (FA.entry i j)) (\ y -> trans (FW.beta i j y) (sym (FA.beta i j (point y).1))) ;
   module MW = RI.M.At[w.size].MM ;
   restricted-class : Id KL.K0.R (KL.class (RI.M.map FA.projector)) (KL.class FW.projector) =
    KL.class-iso (RI.M.map FA.projector) FW.projector
     KL.PJ.Equal[w.size,MW.map FA.entry,FW.entry,(RI.M.map FA.projector).idempotent,
      FW.MN.mat-eq (FW.MN.mmul FW.entry FW.entry) FW.entry FW.idempotent-at,
      MW.MY.mat-eq (MW.map FA.entry) FW.entry (\ i j -> sym (restricted-entry i j))].iso ;
   -- [inc p] = N
   class : Id KL.K0.R (RI.restrict.1 (K.class FA.projector)) (KL.free N) =
    calc KL.K0.R { RI.restrict.1 (K.class FA.projector)
      =< RI.restrict-class FA.projector > KL.class (RI.M.map FA.projector)
      =< restricted-class > KL.class FW.projector
      =< Representations[l].Over[R,setR,axioms].At[loc.1,loc.2.1,My].Compare[FW.projector,FB.projector,FW.representation,FB.representation].same > KL.class FB.projector
      =< basis-class > KL.free N } ;
   free-class : Id KL.K0.R (RI.restrict.1 (K.free N)) (KL.free N) =
    trans (RI.restrict-class K.PJ.Free[N].projector)
     (KL.class-iso (RI.M.map K.PJ.Free[N].projector) KL.PJ.Free[N].projector RI.M.Free[N].iso) ;
   restricted-defect : Id KL.K0.R (RI.restrict.1 (defect w N)) KL.K0.z =
    calc KL.K0.R { RI.restrict.1 (defect w N)
      =< RI.restrict.2.2.1 (K.class FA.projector) (K.K0.neg (K.free N)) >
         KL.K0.add (RI.restrict.1 (K.class FA.projector)) (RI.restrict.1 (K.K0.neg (K.free N)))
      =< cong2 KL.K0.R KL.K0.add _ _ _ _ class (trans (H.negation K.K0 KL.K0 RI.restrict (K.free N)) (ap KL.K0.neg free-class)) >
         KL.K0.add (KL.free N) (KL.K0.neg (KL.free N))
      =< KL.K0.addN (KL.free N) > KL.K0.z } ;
   -- (monoid)
   module LR = LocalizationRings[l].Over[R,setR].At[Alg,f,loc] ;
   module RL = K0Restriction[l].Over[Alg.ring,LR.LX.ring,Alg.set,LR.LX.set,LR.LX.inclusion] ;
   module RT = K0Restriction[l].Over[loc.1.ring,LR.LX.ring,loc.1.set,LR.LX.set,LR.to.1] ;
   module CO = K0Restriction[l].Compose[Alg.ring,loc.1.ring,LR.LX.ring,Alg.set,loc.1.set,LR.LX.set,inc.1,LR.to.1] ;
   module PW = K0Restriction[l].Pointwise[Alg.ring,LR.LX.ring,Alg.set,LR.LX.set,LR.LX.inclusion,
    H.compose Alg.ring loc.1.ring LR.LX.ring LR.to.1 inc.1,\ a -> sym (LR.to-beta a)] ;
   vanishes : Nilpotence[l].Vanishes Alg.ring Alg.set f (defect w N) =
    calc RL.KB.K0.R { RL.restrict.1 (defect w N)
      =< PW.theorem (defect w N) > CO.RH.restrict.1 (defect w N)
      =< sym (CO.theorem (defect w N)) > RT.restrict.1 (RI.restrict.1 (defect w N))
      =< ap RT.restrict.1 restricted-defect > RT.restrict.1 KL.K0.z
      =< H.zero KL.K0 RT.KB.K0 RT.restrict > RL.KB.K0.z } ;
  } ;
  -- (cover)
  module Cover (w : FP.Data) (N : Nat) (bases : (x : C.Spec Alg) -> Tr.Trunc[Basis[Mx x,N]].carrier) {
   module SA = FiniteIdeal[l].Sums[Alg.ring] ;
   Goal : U l = (k : Nat) * (cv : Nilpotence[l].Cover Alg.ring k) *
    ((i : Fin k) -> Nilpotence[l].Vanishes Alg.ring Alg.set (cv.1 i) (defect w N)) ;
   module From (c : Ax.ChoiceData Alg (\ x -> Basis[Mx x,N])) (u : Ax.UnimodularWitness Alg c.1 c.2.1) {
    n : Nat = c.1 ;
    fs (i : Fin n) : Alg.ring.R = c.2.1 i ;
    bs (i : Fin n) (x : AI.D Alg (fs i)) : Basis[Mx x.1,N] = c.2.2.2 i x.1 x.2 ;
    cover : Nilpotence[l].Cover Alg.ring n =
     (fs,u.1,trans (SA.sum-cong n (\ i -> Alg.ring.mul (u.1 i) (fs i)) (\ i -> Alg.ring.mul (fs i) (u.1 i))
       (\ i -> Alg.ring.mulC (u.1 i) (fs i))) u.2) ;
    vanishes (i : Fin n) : Nilpotence[l].Vanishes Alg.ring Alg.set (fs i) (defect w N) =
     Tr1.Trunc[AI.LocalizationWitness Alg (fs i)].induction @l
      (\ t -> Nilpotence[l].Vanishes Alg.ring Alg.set (fs i) (defect w N))
      (\ t -> K0[l].Over[Localisations[l].Over[Alg.ring].Inclusion[fs i].LX.ring,
        Localisations[l].Over[Alg.ring].Inclusion[fs i].LX.set].G.set _ _)
      (\ loc -> Local[fs i,loc,N,bs i,w].vanishes) (AI.localize Alg fp (fs i)) ;
    goal : Goal = (n,cover,vanishes) ;
   } ;
   theorem : Tr.Trunc[Goal].carrier =
    TruncationCombinators[l].bind (Ax.ChoiceData Alg (\ x -> Basis[Mx x,N])) Goal
     (\ c -> TruncationCombinators[l].map (Ax.UnimodularWitness Alg c.1 c.2.1) Goal (\ u -> From[c,u].goal) c.2.2.1)
     (axioms.zchoice Alg fp (\ x -> Basis[Mx x,N]) bases) ;
  } ;
 } ;
} ;
