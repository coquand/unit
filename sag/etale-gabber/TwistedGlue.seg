-- Gluing families of modules over gerbes along two opens (CHEAP-DESIGN.md,
-- section 4, item 6).  Over a type X with a gerbe G x at each x, let Da x,
-- Db x be propositions with Da x + Db x merely at every x (in the use:
-- x(a) or x(b) a unit, a and b comaximal), Sa = (x : X) * Da x and
-- Sb = (x : X) * Db x.  A family on Sa is V : (z : Sa) -> (G z.1).1 ->
-- Module (TWISTEDMODULES.Family over Sa), likewise W on Sb, and
-- e x u v : V (x,u) = W (x,v) identifies them on the overlap.
--  (glue)  At each x apply PROPGLUE with T the fibre families
--     (G x).1 -> Module, P = Da x, Q = Db x: the glued family V' has
--     V' x = V (x,u) for u : Da x and V' x = W (x,v) for v : Db x,
--     compatible with e; restricting V' to Sa (resp. Sb) gives V (resp. W),
--     by funext.
--  (weight)  A weight is a proposition (a Pi of identities in the sets
--     (V y).M).  If V and W have weight chi, so has V' x: the goal is a
--     proposition, so by the cover we may assume u : Da x (or v : Db x),
--     and then move the weight of V (x,u) along V (x,u) = V' x.
--  (restriction)  As weighted families, the restrictions of V' are V and
--     W: the underlying families are equal, and weights are propositions.
--  (cover)  On X = Spec A with a, b merely comaximal, Da x = x(a) unit and
--     Db x = x(b) unit (propositions, inverses being unique) form a cover:
--     a s + b t = 1 gives x(a) x(s) + x(b) x(t) = 1 (x a ring map), so by
--     locality of R one of the two products is a unit, hence x(a) or x(b).
--     Then Sa, Sb are D(a), D(b) (AFFINEINTERFACE.D) by definition.
-- Theory parameters fe, univ (weak funext in PROPGLUE); locality of R.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 module GB = TM.GB ;
 module C = Algebras[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 -- (weight)  a weight is a proposition
 module WeightProp (Gb : GB.AGerbe) (chi : UG.Unit -> UG.Unit) (V : Gb.1 -> MD.Module) {
  module AG = TM.At[TM.charge (TM.banded (Gb))] ;
  Acts (y : Gb.1) (p : Id Gb.1 y y) (m : (V y).M) : U l =
   Id (V y).M (AG.Move[V].move y y p m) ((V y).sm (chi (AG.bnd y p)).1 m) ;
  theorem : Pr.isProp (AG.Weight chi V) =
   F.isProp-Pi Gb.1 (\ y -> (p : Id Gb.1 y y) (m : (V y).M) -> Acts y p m) (\ y ->
    F.isProp-Pi (Id Gb.1 y y) (\ p -> (m : (V y).M) -> Acts y p m) (\ p ->
     F.isProp-Pi (V y).M (\ m -> Acts y p m) (\ m -> (V y).setM _ _))) ;
 } ;
 module Glue (X : U l) (G : X -> GB.AGerbe) (Da Db : X -> U l)
  (pa : (x : X) -> Pr.isProp (Da x)) (pb : (x : X) -> Pr.isProp (Db x))
  (cover : (x : X) -> Tr.Trunc[Plus (Da x) (Db x)].carrier) {
  Sa : U l = (x : X) * Da x ;
  Sb : U l = (x : X) * Db x ;
  -- the fibre families at x
  Fibre (x : X) : U l+ = (G x).1 -> MD.Module ;
  OnA : U l+ = (z : Sa) -> Fibre z.1 ;
  OnB : U l+ = (z : Sb) -> Fibre z.1 ;
  OnX : U l+ = (x : X) -> Fibre x ;
  module FX = TM.Family[X,G] ;
  module FA = TM.Family[Sa,\ z -> G z.1] ;
  module FB = TM.Family[Sb,\ z -> G z.1] ;
  module Data (V : OnA) (W : OnB) (e : (x : X) (u : Da x) (v : Db x) -> Id (Fibre x) (V (x,u)) (W (x,v))) {
   -- (glue)
   module Pt (x : X) {
    module PG = PropGlue[l].Over[Fibre x,Da x,Db x,pa x,pb x,\ u -> V (x,u),\ v -> W (x,v),e x] ;
    point : PG.Glue = PG.glue (cover x) ;
    fibre : Fibre x = PG.carrier point ;
    to-V (u : Da x) : Id (Fibre x) fibre (V (x,u)) = PG.to-V point u ;
    to-W (v : Db x) : Id (Fibre x) fibre (W (x,v)) = PG.to-W point v ;
    coherence (u : Da x) (v : Db x) :
     Id (Id (Fibre x) fibre (W (x,v))) (to-W v) (Pr1.trans (Fibre x) fibre (V (x,u)) (W (x,v)) (to-V u) (e x u v)) =
     PG.coherence point u v ;
   } ;
   glued : OnX = \ x -> Pt[x].fibre ;
   on-A : OnA = \ z -> glued z.1 ;
   on-B : OnB = \ z -> glued z.1 ;
   restrict-V : Id OnA on-A V = F1.funext Sa (\ z -> Fibre z.1) on-A V (\ z -> Pt[z.1].to-V z.2) ;
   restrict-W : Id OnB on-B W = F1.funext Sb (\ z -> Fibre z.1) on-B W (\ z -> Pt[z.1].to-W z.2) ;
   -- (weight) and (restriction)
   module Weights (chi : UG.Unit -> UG.Unit)
    (wV : (z : Sa) -> TM.At[TM.charge (TM.banded (G z.1))].Weight chi (V z)) (wW : (z : Sb) -> TM.At[TM.charge (TM.banded (G z.1))].Weight chi (W z)) {
    Wt (x : X) (M : Fibre x) : U l = TM.At[TM.charge (TM.banded (G x))].Weight chi M ;
    from-cover (x : X) : Plus (Da x) (Db x) -> Wt x (glued x) = split {
     inl u -> Pr1.subst (Fibre x) (\ M -> Wt x M) (V (x,u)) (glued x) (Pr1.sym (Fibre x) (glued x) (V (x,u)) (Pt[x].to-V u)) (wV (x,u)) ;
     inr v -> Pr1.subst (Fibre x) (\ M -> Wt x M) (W (x,v)) (glued x) (Pr1.sym (Fibre x) (glued x) (W (x,v)) (Pt[x].to-W v)) (wW (x,v)) } ;
    weight (x : X) : Wt x (glued x) =
     Tr.Trunc[Plus (Da x) (Db x)].induction @l (\ t -> Wt x (glued x)) (\ t -> WeightProp[G x,chi,glued x].theorem)
      (from-cover x) (cover x) ;
    family : FX.Weighted chi = (glued,weight) ;
    -- the restrictions, as weighted families
    given-V : FA.Weighted chi = (V,wV) ;
    given-W : FB.Weighted chi = (W,wW) ;
    restricted-V : FA.Weighted chi = (on-A,\ z -> weight z.1) ;
    restricted-W : FB.Weighted chi = (on-B,\ z -> weight z.1) ;
    to-given-V : Id (FA.Weighted chi) restricted-V given-V =
     Pr1.Sigma-eq OnA (\ M -> (z : Sa) -> Wt z.1 (M z)) on-A V (\ z -> weight z.1) wV restrict-V
      (F.isProp-Pi Sa (\ z -> Wt z.1 (V z)) (\ z -> WeightProp[G z.1,chi,V z].theorem)) ;
    to-given-W : Id (FB.Weighted chi) restricted-W given-W =
     Pr1.Sigma-eq OnB (\ M -> (z : Sb) -> Wt z.1 (M z)) on-B W (\ z -> weight z.1) wW restrict-W
      (F.isProp-Pi Sb (\ z -> Wt z.1 (W z)) (\ z -> WeightProp[G z.1,chi,W z].theorem)) ;
   } ;
  } ;
 } ;
 -- (cover)  D(a), D(b) on Spec A for a, b merely comaximal: if a s + b t = 1
 -- then x(a) x(s) + x(b) x(t) = x(1) = 1 is a unit, so (locality of R)
 -- x(a) x(s) or x(b) x(t) is a unit, hence x(a) or x(b).
 module Opens (loc : StandardOpens[l].Over[R,setR].Locality) (A : C.Algebra) (a b : A.ring.R)
  (cm : Tr.Trunc[Comaximal[l].Over[A.ring].Comaximal a b].carrier) {
  module RR = AffineRing[l].Laws[R,setR] ;
  module CM = Comaximal[l].Over[A.ring] ;
  Da (x : C.Spec A) : U l = RL[R].unit (x.1.1 a) ;
  Db (x : C.Spec A) : U l = RL[R].unit (x.1.1 b) ;
  module Pt (x : C.Spec A) (w : CM.Comaximal a b) {
   -- the point as a ring map, and its laws
   ev (r : A.ring.R) : R.R = x.1.1 r ;
   at-one : Id R.R (ev A.ring.o) R.o = x.1.2.1 ;
   at-add (r r' : A.ring.R) : Id R.R (ev (A.ring.add r r')) (R.add (ev r) (ev r')) = x.1.2.2.1 r r' ;
   at-mul (r r' : A.ring.R) : Id R.R (ev (A.ring.mul r r')) (R.mul (ev r) (ev r')) = x.1.2.2.2 r r' ;
   s : A.ring.R = w.1 ;
   t : A.ring.R = w.2.1 ;
   left : R.R = R.mul (ev a) (ev s) ;
   right : R.R = R.mul (ev b) (ev t) ;
   image : Id R.R (R.add left right) R.o = calc R.R {
    R.add left right
     =< sym (cong2 R.R R.add _ _ _ _ (at-mul a s) (at-mul b t)) > R.add (ev (A.ring.mul a s)) (ev (A.ring.mul b t))
     =< sym (at-add (A.ring.mul a s) (A.ring.mul b t)) > ev (A.ring.add (A.ring.mul a s) (A.ring.mul b t))
     =< ap ev w.2.2 > ev A.ring.o
     =< at-one > R.o } ;
   sum-unit : RL[R].unit (R.add left right) = Pr.subst R.R RL[R].unit R.o (R.add left right) (sym image) (R.o,R.mulO R.o) ;
   sides : Plus (RL[R].unit left) (RL[R].unit right) -> Plus (Da x) (Db x) = split {
    inl u -> inl (RR.unit-left (ev a) (ev s) u) ;
    inr v -> inr (RR.unit-left (ev b) (ev t) v) } ;
   cover : Tr.Trunc[Plus (Da x) (Db x)].carrier =
    TC.map (Plus (RL[R].unit left) (RL[R].unit right)) (Plus (Da x) (Db x)) sides (loc.2 left right sum-unit) ;
  } ;
  cover (x : C.Spec A) : Tr.Trunc[Plus (Da x) (Db x)].carrier =
   Tr.Trunc[CM.Comaximal a b].induction @l (\ c -> Tr.Trunc[Plus (Da x) (Db x)].carrier)
    (\ c -> Tr.Trunc[Plus (Da x) (Db x)].proposition) (\ w -> Pt[x,w].cover) cm ;
  -- over gerbes G x on Spec A
  module On (G : C.Spec A -> GB.AGerbe) {
   module GD = Glue[C.Spec A,G,Da,Db,\ x -> RR.unit-prop (x.1.1 a),\ x -> RR.unit-prop (x.1.1 b),cover] ;
   -- the two opens are D(a), D(b), by definition
   on-a : Id (U l) GD.Sa (AI.D A a) = refl GD.Sa ;
   on-b : Id (U l) GD.Sb (AI.D A b) = refl GD.Sb ;
  } ;
 } ;
} ;
