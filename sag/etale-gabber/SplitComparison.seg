-- The gerbe compared with the splitting gerbe of the descended End
-- (GABBER-PROPER-DESIGN.md, section 3, comparison; Gabber, Ch. II: c = delta(cl A)
-- means that G maps to the gerbe of splittings of A, preserving the bands).
-- B a banded groupoid, V of weight 1 whose fibres merely have bases of rank
-- n+1, E = Inv Hom(V, V) the descended End (DESCENDEDEND), E -> End(V g)
-- evaluation at g.  The splitting groupoid of E has the objects (U, E = End U);
-- Phi g = (V g, evaluation at g).  Its morphisms from Phi g to Phi g' are
--     Arrow g g' = linear bijections a : V g -> V g' with a (s g x) = s g' (a x)
-- for all s in E (they carry one evaluation to the other).
--  (functor)  phi : (g = g') -> Arrow g g' by J (refl |-> identity); its
--             function is transport (by J).
--  (band)     A loop l at g acts on V g by its band scalar (weight 1): phi l is
--             the scalar arrow sc(beta_g l).  So Phi preserves the bands.
--  (centre)   sc : R^x -> Arrow g g is an equivalence: an arrow a commutes with
--             every endomorphism f of V g (f is the value at g of a section of
--             E, DESCENT.Lift), so it is a unit scalar, a unique one (ENDCENTRE).
--  (full)     phi at g g = sc . beta_g, a composite of equivalences (beta_g has
--             contractible fibres, by definition of a band).  For g' : the goal
--             is a proposition; g = g' merely, and J reduces to g' = g.
-- So Phi is a fully faithful functor to the splitting groupoid, preserving
-- the bands.  (Being an equivalence of groupoids needs descent for objects.)
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module EN = ModuleEnd[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module DE = DescendedEnd[l].Over[R,setR] ;
 module L = RL[R] ;
 module At (B : TM.Banded) (V : B.1 -> MD.Module) (wv : TM.At[TM.charge (B)].Weight (\ a -> a) V) (n : Nat)
  (bases : (g : B.1) -> Tr.Trunc[LF.Basis[V g,suc n]].carrier) {
  module T = TM.At[TM.charge (B)] ;
  module MV = T.Move[V] ;
  module E = DE.At[B,V,\ a -> a,wv] ;
  Sec : U l = E.IV.S.E ;
  -- the endomorphism of V g given by a section
  ev (s : Sec) (g : B.1) (x : (V g).M) : (V g).M = (s.1 g).1 x ;
  Lin (g g' : B.1) : U l = HM.At[V g,V g'].S.E ;
  Bij (g g' : B.1) (a : Lin g g') : U l = Pr.isEquiv (V g).M (V g').M a.1 ;
  Intertwines (g g' : B.1) (a : Lin g g') : U l = (s : Sec) (x : (V g).M) -> Id (V g').M (a.1 (ev s g x)) (ev s g' (a.1 x)) ;
  Good (g g' : B.1) (a : Lin g g') : U l = Bij g g' a * Intertwines g g' a ;
  Arrow (g g' : B.1) : U l = (a : Lin g g') * Good g g' a ;
  good-prop (g g' : B.1) (a : Lin g g') : Pr.isProp (Good g g' a) =
   Pr.isProp-Sigma (Bij g g' a) (\ b -> Intertwines g g' a) (Prop331Paths[l].isEquiv-prop (V g).M (V g').M a.1)
    (\ b -> F.isProp-Pi Sec (\ s -> (x : (V g).M) -> Id (V g').M (a.1 (ev s g x)) (ev s g' (a.1 x))) (\ s ->
     F.isProp-Pi (V g).M (\ x -> Id (V g').M (a.1 (ev s g x)) (ev s g' (a.1 x))) (\ x -> (V g').setM _ _))) ;
  arrow-set (g g' : B.1) : Pr.isSet (Arrow g g') =
   Torsor[l].isSet-sub (Lin g g') (Good g g') HM.At[V g,V g'].carrier.setM (good-prop g g') ;
  arrow-eq (g g' : B.1) (a b : Arrow g g') (h : (x : (V g).M) -> Id (V g').M (a.1.1 x) (b.1.1 x)) : Id (Arrow g g') a b =
   Pr.Sigma-eq (Lin g g') (Good g g') a.1 b.1 a.2 b.2 (HM.At[V g,V g'].ext a.1 b.1 h) (good-prop g g' b.1) ;
  -- (functor)
  identity (g : B.1) : Arrow g g = (EN.At[V g].one,(Pr.idEquiv (V g).M).2,\ s x -> refl (ev s g x)) ;
  phi (g g' : B.1) (p : Id B.1 g g') : Arrow g g' = idJ B.1 g (\ h q -> Arrow g h) (identity g) g' p ;
  phi-move (g g' : B.1) (p : Id B.1 g g') (x : (V g).M) : Id (V g').M ((phi g g' p).1.1 x) (MV.move g g' p x) =
   idJ B.1 g (\ h q -> Id (V h).M ((phi g h q).1.1 x) (MV.move g h q x)) (refl x) g' p ;
  -- (band)
  scalar (g : B.1) (u : UG.Unit) : Arrow g g =
   (EN.At[V g].V.sm u.1 EN.At[V g].one,
    (Pr.qinv (V g).M (V g).M (\ x -> (V g).sm u.1 x) (\ x -> (V g).sm u.2.1 x)
      (\ x -> trans ((V g).smA u.1 u.2.1 x) (trans (ap (\ c -> (V g).sm c x) u.2.2) ((V g).smO x)))
      (\ x -> trans ((V g).smA u.2.1 u.1 x) (trans (ap (\ c -> (V g).sm c x) (trans (R.mulC u.2.1 u.1) u.2.2)) ((V g).smO x)))),
    \ s x -> sym ((s.1 g).2.2 u.1 x)) ;
  loop (g : B.1) (lp : Id B.1 g g) : Id (Arrow g g) (phi g g lp) (scalar g (T.bnd g lp)) =
   arrow-eq g g (phi g g lp) (scalar g (T.bnd g lp)) (\ x -> trans (phi-move g g lp x) (wv g lp x)) ;
  -- (centre)
  module Centre (g : B.1) (b : LF.Basis[V g,suc n]) {
   module EC = EndCentre[l].Over[R,setR,axioms].At[V g,n,b] ;
   -- an arrow commutes with every endomorphism
   commute (a : Arrow g g) : EC.Commutes a.1.1 = \ f x ->
    trans (ap (\ h -> a.1.1 (h.1 x)) (sym E.AtObject[g].D.Lift[f].at-lift))
     (trans (a.2.2 E.AtObject[g].D.Lift[f].lift x) (ap (\ h -> h.1 (a.1.1 x)) E.AtObject[g].D.Lift[f].at-lift)) ;
   unit (a : Arrow g g) : UG.Unit = EC.Of[a.1,a.2.1,commute a].unit ;
   is-scalar (a : Arrow g g) : Id (Arrow g g) (scalar g (unit a)) a =
    arrow-eq g g (scalar g (unit a)) a (\ x -> sym (EC.Of[a.1,a.2.1,commute a].scalar-law x)) ;
   injective (u v : UG.Unit) (h : Id (Arrow g g) (scalar g u) (scalar g v)) : Id UG.Unit u v =
    EC.injective u v (ap (\ a -> a.1.1 (EC.e EC.o)) h) ;
   module Fib = AffineHLevels[l].Fibres[UG.Unit,Arrow g g,arrow-set g g,scalar g] ;
   fib-prop (a : Arrow g g) : Pr.isProp (Fib.Fib a) = \ w w' ->
    Pr.Sigma-eq UG.Unit (\ u -> Id (Arrow g g) (scalar g u) a) w.1 w'.1 w.2 w'.2
     (injective w.1 w'.1 (trans w.2 (sym w'.2))) (arrow-set g g _ _) ;
   contr (a : Arrow g g) : FunExtUA[l].isContr (Fib.Fib a) =
    ((unit a,is-scalar a),\ w -> fib-prop a (unit a,is-scalar a) w) ;
  } ;
  scalar-equiv (g : B.1) : Pr.isEquiv UG.Unit (Arrow g g) (scalar g) =
   AffineHLevels[l].Fibres[UG.Unit,Arrow g g,arrow-set g g,scalar g].to-equiv (\ a ->
    Tr.Trunc[LF.Basis[V g,suc n]].induction @l (\ t -> FunExtUA[l].isContr ((u : UG.Unit) * Id (Arrow g g) (scalar g u) a))
     (\ t -> AffineHLevels[l].contr-prop _) (\ b -> Centre[g,b].contr a) (bases g)) ;
  -- (full)
  band-equiv (g : B.1) : Pr.isEquiv (Id B.1 g g) UG.Unit (T.bnd g) =
   AffineHLevels[l].Fibres[Id B.1 g g,UG.Unit,UG.setU,T.bnd g].to-equiv ((B.2.2.2 g).2.1) ;
  composite (g : B.1) : Pr.Equiv (Id B.1 g g) (Arrow g g) =
   Equivalences[l].compose (Id B.1 g g) UG.Unit (Arrow g g) (T.bnd g,band-equiv g) (scalar g,scalar-equiv g) ;
  loops (g : B.1) : Pr.isEquiv (Id B.1 g g) (Arrow g g) (phi g g) =
   Pr.subst (Id B.1 g g -> Arrow g g) (\ h -> Pr.isEquiv (Id B.1 g g) (Arrow g g) h) (composite g).1 (phi g g)
    (F.funext (Id B.1 g g) (\ lp -> Arrow g g) _ _ (\ lp -> sym (loop g lp))) (composite g).2 ;
  full (g g' : B.1) : Pr.isEquiv (Id B.1 g g') (Arrow g g') (phi g g') =
   Tr.Trunc[Id B.1 g g'].induction @l (\ t -> Pr.isEquiv (Id B.1 g g') (Arrow g g') (phi g g'))
    (\ t -> Prop331Paths[l].isEquiv-prop (Id B.1 g g') (Arrow g g') (phi g g'))
    (\ p0 -> idJ B.1 g (\ h q -> Pr.isEquiv (Id B.1 g h) (Arrow g h) (phi g h)) (loops g) g' p0) (T.conn g g') ;
 } ;
} ;
