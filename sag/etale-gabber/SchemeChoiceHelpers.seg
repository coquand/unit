-- Open embeddings and small charts used in the scheme choice theorem.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module M = SchemeMaps[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OT = Transitivity[l].Over[R,setR,axioms] ;
 OpenImage (A X : U l) (f : A -> X) : U l = (x : X) -> OP.Open (M.Image A X f x) ;
 unit-open (a : R.R) : OP.Open (RL[R].unit a) =
  Tr.Trunc[OP.Witness (RL[R].unit a)].inc
   (OP.from-iff (RL[R].unit a) (AffineRing[l].Laws[R,setR].unit-prop a) (suc zero) (\ i -> a)
    (\ u -> Tr.Trunc[(i : Fin (suc zero)) * RL[R].unit a].inc (inr tt,u))
    (Tr.Trunc[(i : Fin (suc zero)) * RL[R].unit a].induction @l
     (\ t -> RL[R].unit a) (\ t -> AffineRing[l].Laws[R,setR].unit-prop a) (\ w -> w.2))) ;
 module Reparametrize (A T X : U l) (setX : Pr.isSet X) (e : Pr.Equiv A T)
  (f : T -> X) (emb : M.Embedding T X f) (op : OpenImage T X f) {
  map (a : A) : X = f (e.1 a) ;
  embedding : M.Embedding A X map = M.injective-embedding A X setX map
   (\ a b h -> Equivalences[l].injective A T e.1 e.2 a b
    (M.Embedded[T,X,f,emb].injective (e.1 a) (e.1 b) h)) ;
  to (x : X) : M.Image A X map x -> M.Image T X f x =
   Tr.Trunc[M.Fiber A X map x].induction @l (\ t -> M.Image T X f x)
    (\ t -> M.image-prop T X f x)
    (\ w -> Tr.Trunc[M.Fiber T X f x].inc (e.1 w.1,w.2)) ;
  from (x : X) : M.Image T X f x -> M.Image A X map x =
   Tr.Trunc[M.Fiber T X f x].induction @l (\ t -> M.Image A X map x)
    (\ t -> M.image-prop A X map x)
    (\ w -> Tr.Trunc[M.Fiber A X map x].inc (e.2.sec w.1,trans (ap f (e.2.sec-eq w.1)) w.2)) ;
  equivalent (x : X) : Pr.Equiv (M.Image A X map x) (M.Image T X f x) =
   (to x,Pr.qinv _ _ (to x) (from x) (\ w -> M.image-prop T X f x _ w) (\ w -> M.image-prop A X map x _ w)) ;
  open-image : OpenImage A X map = \ x -> OP.along _ _ (equivalent x) (op x) ;
 } ;
 module Compose (A B X : U l) (setX : Pr.isSet X)
  (e : A -> B) (ee : M.Embedding A B e) (oe : OpenImage A B e)
  (h : B -> X) (eh : M.Embedding B X h) (oh : OpenImage B X h) {
  map (a : A) : X = h (e a) ;
  embedding : M.Embedding A X map = M.injective-embedding A X setX map
   (\ a b p -> M.Embedded[A,B,e,ee].injective a b (M.Embedded[B,X,h,eh].injective (e a) (e b) p)) ;
  module H = M.Embedded[B,X,h,eh] ;
  Above (x : X) (s : M.Image B X h x) : U l = M.Image A B e (H.choose x s).1 ;
  Two (x : X) : U l = (s : M.Image B X h x) * Above x s ;
  two-prop (x : X) : Pr.isProp (Two x) =
   Pr.isProp-Sigma (M.Image B X h x) (Above x) (M.image-prop B X h x)
    (\ s -> M.image-prop A B e (H.choose x s).1) ;
  to-fiber (x : X) (w : M.Fiber A X map x) : Two x =
   (Tr.Trunc[M.Fiber B X h x].inc (e w.1,w.2),
    Pr.subst B (M.Image A B e) _ _
     (ap (\ v -> v.1) (eh x (e w.1,w.2) (H.choose x (Tr.Trunc[M.Fiber B X h x].inc (e w.1,w.2)))))
     (Tr.Trunc[M.Fiber A B e (e w.1)].inc (w.1,refl (e w.1)))) ;
  to (x : X) : M.Image A X map x -> Two x =
   Tr.Trunc[M.Fiber A X map x].induction @l (\ t -> Two x) (\ t -> two-prop x) (to-fiber x) ;
  from (x : X) (w : Two x) : M.Image A X map x =
   Tr.Trunc[M.Fiber A B e (H.choose x w.1).1].induction @l
    (\ t -> M.Image A X map x) (\ t -> M.image-prop A X map x)
    (\ v -> Tr.Trunc[M.Fiber A X map x].inc (v.1,trans (ap h v.2) (H.choose x w.1).2)) w.2 ;
  equivalent (x : X) : Pr.Equiv (M.Image A X map x) (Two x) =
   (to x,Pr.qinv _ _ (to x) (from x) (\ w -> two-prop x _ w) (\ w -> M.image-prop A X map x _ w)) ;
  open-image : OpenImage A X map = \ x ->
   OP.along _ _ (equivalent x) (OT.sigma (M.Image B X h x) (oh x) (Above x) (\ s -> oe (H.choose x s).1)) ;
 } ;
 record Patch (X : U l) (B : X -> U l) {
  chart : S.Chart[X] ;
  section : (a : S.Domain X chart) -> B (chart.map a) ;
 } ;
 module FromAffine (X : U l) (setX : Pr.isSet X) (B : X -> U l)
  (T : U l) (affine : SA.Affine T) (f : T -> X)
  (emb : M.Embedding T X f) (op : OpenImage T X f) (s : (a : T) -> B (f a)) {
  module Chosen (w : SA.Witness T) {
   module Map = Reparametrize[SA.Sol w.1,T,X,setX,Functions[l].inverse T (SA.Sol w.1) w.2,f,emb,op] ;
   chart : S.Chart[X] = new S.Chart[X,w.1,Map.map,Map.embedding,Map.open-image] ;
   patch : Patch[X,B] = new Patch[X,B,chart,\ a -> s (w.2.2.sec a)] ;
  } ;
  -- The patch carries a proof that its image is the desired open image.
  Witness : U l = (p : Patch[X,B]) * ((x : X) -> Pr.Equiv (S.Image X p.chart x) (M.Image T X f x)) ;
  result : Tr.Trunc[Witness].carrier =
   Tr.Trunc[SA.Witness T].induction @l (\ t -> Tr.Trunc[Witness].carrier) (\ t -> Tr.Trunc[Witness].proposition)
    (\ w -> Tr.Trunc[Witness].inc (Chosen[w].patch,Chosen[w].Map.equivalent)) affine ;
 } ;
} ;
