-- A finite frame over the local SAG ring merely admits a basis, in the
-- Basis type used by twisted/LocalFree. The actual local-ring theorem is
-- horrocks/LocalFree, linked here as ProjectiveFreeWorker (no copied proof).
-- Apply its presentation theorem to M modulo the zero submodule. A frame
-- supplies generators and linear coordinates; its reconstruction law is
-- the spanning equation modulo zero, and linear forms vanish at zero.
-- Conversely, a worker basis modulo zero is a frame with the same
-- Kronecker pairing. The two libraries' finite sums agree by induction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module At (M : MD.Module) {
  module MA = Alg73[l].MA[MD.ring,M] ;
  module MS = ModuleFiniteSums[l].Over[R,setR,M] ;
  module W = ProjectiveFreeWorker[l].Over[R,M.M,M.mz,M.madd,M.mneg,M.maddA,M.maddC,M.maddZ,M.maddN,
   M.sm,M.smD,M.smE,\ a b m -> sym (M.smA a b m),M.smO] ;
  Zero (m : M.M) : U l = Id M.M m M.mz ;
  zero-add (m m' : M.M) (h : Zero m) (h' : Zero m') : Zero (M.madd m m') =
   trans (cong2 M.M M.madd _ _ _ _ h h') (M.maddZ M.mz) ;
  zero-scale (a : R.R) (m : M.M) (h : Zero m) : Zero (M.sm a m) =
   trans (ap (M.sm a) h) (MA.sm-zr a) ;
  module Z = W.Sub[Zero,refl M.mz,zero-add,zero-scale] ;
  -- The sum conventions agree, including their order of summation.
  sum : (n : Nat) (v : Fin n -> M.M) -> Id M.M (W.VS.vsum n v) (MS.sum n v) = split {
   zero -> \ v -> refl M.mz ;
   suc n | ih -> \ v -> ap (M.madd (v (inr tt))) (ih (\ i -> v (inl i))) } ;
  module Presented (n : Nat) (frame : FR.Frame[M,n]) {
   coordinate (m : M.M) (i : Fin n) : R.R = (frame.form i).1 m ;
   spans (m : M.M) : Z.Cong m (W.comb n (coordinate m) frame.vector) =
    trans (ap (W.sub m) (trans (sum n (\ i -> M.sm (coordinate m i) (frame.vector i))) (frame.law m))) (W.sub-self m) ;
   kills (m : M.M) (h : Zero m) (i : Fin n) : Id R.R (coordinate m i) R.z =
    trans (ap (frame.form i).1 h) (FR.Form[M,frame.form i].zero) ;
   presentation : Z.Size[n].Pres = new Z.Size[n].Pres[frame.vector,coordinate,\ i -> (frame.form i).2,spans,kills] ;
   worker-free : Z.Free = W.Local[axioms.loc.2].free n Zero (refl M.mz) zero-add zero-scale presentation ;
  } ;
  module Basis (n : Nat) (b : Z.Size[n].Basis) {
   form (i : Fin n) : FR.HM.At[M,MD.regular].S.E = (\ m -> b.1.co m i,b.1.co-lin i) ;
   law (m : M.M) : Id M.M (MS.sum n (\ i -> M.sm ((form i).1 m) (b.1.gen i))) m =
    sym (trans (MA.sub-zero m (W.comb n (b.1.co m) b.1.gen) (b.1.spans m))
     (sum n (\ i -> M.sm (b.1.co m i) (b.1.gen i)))) ;
   frame : FR.Frame[M,n] = new FR.Frame[M,n,b.1.gen,form,law] ;
   basis : LF.Basis[M,n] = new LF.Basis[M,n,frame,b.2] ;
  } ;
  Free : U l = Tr.Trunc[(n : Nat) * LF.Basis[M,n]].carrier ;
  theorem (n : Nat) (frame : FR.Frame[M,n]) : Free =
   Tr.Trunc[(n : Nat) * Z.Size[n].Basis].induction @l (\ b -> Free)
    (\ b -> Tr.Trunc[(n : Nat) * LF.Basis[M,n]].proposition)
    (\ b -> Tr.Trunc[(n : Nat) * LF.Basis[M,n]].inc (b.1,Basis[b.1,b.2].basis)) Presented[n,frame].worker-free ;
  merely (n : Nat) (frame : Tr.Trunc[FR.Frame[M,n]].carrier) : Free =
   Tr.Trunc[FR.Frame[M,n]].induction @l (\ f -> Free) (\ f -> Tr.Trunc[(n : Nat) * LF.Basis[M,n]].proposition)
    (theorem n) frame ;
  opaque theorem ;
 } ;
} ;
