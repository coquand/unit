-- gabber-recollement.tex, Lemma 3.6(2), in K_0(A) (K0).  In the situation
-- of STABLESUM, let g, g' be inverse n x n and h, h' inverse m x m matrices
-- over C, and p, q projectors presenting P_h and P_g.  Then
--     ([p] - [A^m]) ([q] - [A^n]) = 0.
--
-- Proof.  Write 1 for unit matrices and N = mn.  The bridge (GLUEDTENSOR),
-- with the unit projectors presenting A^k ~ P_1 (GLUEDFREE), gives
--     [p][q] = [P_{h (x) g}],        [A^m][q] = [P_{1 (x) g}],
--     [p][A^n] = [P_{h (x) 1}],      [A^m][A^n] = [P_{1 (x) 1}] = [A^N],
-- and Lemma 3.6(1) in K_0 (CLASSSUM), for (1 (x) g)(h (x) 1) = h (x) g
-- (GLUEDKRONECKER), gives
--     [P_{1 (x) g}] + [P_{h (x) 1}] = [P_{h (x) g}] + [A^N].
-- The glued modules are presented by projectors merely (GLUEDPROJECTOR),
-- which suffices for an equation.  Expanding the product (Vanish),
--     ([p] - [A^m]) ([q] - [A^n]) = ([P_{h (x) g}] + [A^N])
--                                   - ([P_{1 (x) g}] + [P_{h (x) 1}]) = 0.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
-- (x - a)(y - b) = 0 when xy = s, ay = s1, xb = s2, ab = f and s1 + s2 = s + f
module Vanish (R : CRing) {
 module L = RL[R] ;
 neg-neg-mul (a b : R.R) : Id R.R (R.mul (R.neg a) (R.neg b)) (R.mul a b) =
  trans (L.neg-mul-left a (R.neg b)) (trans (ap R.neg (L.mul-neg a b)) (L.neg-neg (R.mul a b))) ;
 vanish (x y a b s s1 s2 f : R.R) (e1 : Id R.R (R.mul x y) s) (e2 : Id R.R (R.mul a y) s1)
  (e3 : Id R.R (R.mul x b) s2) (e4 : Id R.R (R.mul a b) f) (e5 : Id R.R (R.add s1 s2) (R.add s f)) :
  Id R.R (R.mul (R.add x (R.neg a)) (R.add y (R.neg b))) R.z =
  calc R.R { R.mul (R.add x (R.neg a)) (R.add y (R.neg b))
    =< L.dist-left x (R.neg a) (R.add y (R.neg b)) >
       R.add (R.mul x (R.add y (R.neg b))) (R.mul (R.neg a) (R.add y (R.neg b)))
    =< cong2 R.R R.add _ _ _ _ (R.dist x y (R.neg b)) (R.dist (R.neg a) y (R.neg b)) >
       R.add (R.add (R.mul x y) (R.mul x (R.neg b))) (R.add (R.mul (R.neg a) y) (R.mul (R.neg a) (R.neg b)))
    =< cong2 R.R R.add _ _ _ _ (cong2 R.R R.add _ _ _ _ e1 (trans (L.mul-neg x b) (ap R.neg e3)))
        (cong2 R.R R.add _ _ _ _ (trans (L.neg-mul-left a y) (ap R.neg e2)) (trans (neg-neg-mul a b) e4)) >
       R.add (R.add s (R.neg s2)) (R.add (R.neg s1) f)
    =< ap (R.add (R.add s (R.neg s2))) (R.addC (R.neg s1) f) > R.add (R.add s (R.neg s2)) (R.add f (R.neg s1))
    =< L.swap s (R.neg s2) f (R.neg s1) > R.add (R.add s f) (R.add (R.neg s2) (R.neg s1))
    =< ap (R.add (R.add s f)) (sym (L.neg-add s2 s1)) > R.add (R.add s f) (R.neg (R.add s2 s1))
    =< ap (\ t -> R.add (R.add s f) (R.neg t)) (trans (R.addC s2 s1) e5) > R.add (R.add s f) (R.neg (R.add s f))
    =< R.addN (R.add s f) > R.z } ;
} ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (m n : Nat) {
 module T = GluedTensor[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,m,n] ;
 module GK = GluedKronecker[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,m,n] ;
 module CS = ClassSum[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,Pairing[l].times m n] ;
 module GPN = GluedProjector[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,Pairing[l].times m n] ;
 module Fm = GluedFree[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,m] ;
 module Fn = GluedFree[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,n] ;
 module K = T.K ;
 module KC = T.KC ;
 module MI = T.MI ;
 module PJ = K.PJ ;
 module V = Vanish[K.K0] ;
 -- the unit projectors present the modules glued along 1
 one-m : MI.Iso[K.image PJ.Free[m].projector,T.Gm.Glue[KC.Mm.mone].glued] =
  MI.compose (K.image PJ.Free[m].projector) (PJ.FM.free m) T.Gm.Glue[KC.Mm.mone].glued PJ.Free[m].iso Fm.iso ;
 one-n : MI.Iso[K.image PJ.Free[n].projector,T.G1.Glue[KC.Mn.mone].glued] =
  MI.compose (K.image PJ.Free[n].projector) (PJ.FM.free n) T.G1.Glue[KC.Mn.mone].glued PJ.Free[n].iso Fn.iso ;
 one-N : MI.Iso[K.image PJ.Free[Pairing[l].times m n].projector,T.GN.Glue[KC.kron KC.Mm.mone KC.Mn.mone].glued] =
  MI.compose (K.image PJ.Free[Pairing[l].times m n].projector) (PJ.FM.free (Pairing[l].times m n))
   T.GN.Glue[KC.kron KC.Mm.mone KC.Mn.mone].glued PJ.Free[Pairing[l].times m n].iso
   (MI.compose (PJ.FM.free (Pairing[l].times m n)) T.GN.Glue[KC.MN.mone].glued T.GN.Glue[KC.kron KC.Mm.mone KC.Mn.mone].glued
    CS.SS.GF.iso T.GN.Equal[KC.kron KC.Mm.mone KC.Mn.mone,KC.MN.mone,sym KC.kron-one].iso) ;
 -- [A^m][A^n] = [A^N]
 free-product : Id K.K0.R (K.K0.mul (K.free m) (K.free n)) (K.free (Pairing[l].times m n)) =
  T.Bridge[KC.Mn.mone,KC.Mn.mone,GK.one-n,KC.Mm.mone,PJ.Free[m].projector,PJ.Free[n].projector,
   PJ.Free[Pairing[l].times m n].projector,one-m,one-n,one-N].theorem ;
 module Lemma (g g' : KC.Mn.Mat) (gi : KC.In.Inverse[g,g']) (h h' : KC.Mm.Mat) (hi : KC.Im.Inverse[h,h'])
  (p q : K.Projector) (ep : MI.Iso[K.image p,T.Gm.Glue[h].glued]) (eq : MI.Iso[K.image q,T.G1.Glue[g].glued]) {
  module GL = GK.Lemma[g,g',gi,h,h',hi] ;
  -- presenters of P_{h (x) g}, P_{1 (x) g} and P_{h (x) 1}
  module Ps = GPN.Explicit[KC.kron h g,KC.kron h' g',KC.kron-inverse h h' hi g g' gi] ;
  module P1 = GPN.Explicit[GL.G,KC.kron KC.Mm.mone g',KC.kron-inverse KC.Mm.mone KC.Mm.mone GK.one-m g g' gi] ;
  module P2 = GPN.Explicit[GL.F,KC.kron h' KC.Mn.mone,KC.kron-inverse h h' hi KC.Mn.mone KC.Mn.mone GK.one-n] ;
  Statement : U l = Id K.K0.R (K.K0.mul (K.K0.add (K.class p) (K.K0.neg (K.free m))) (K.K0.add (K.class q) (K.K0.neg (K.free n)))) K.K0.z ;
  module At (s : Ps.Presented) (s1 : P1.Presented) (s2 : P2.Presented) {
   -- [p][q] = [P_{h (x) g}]
   tensor : Id K.K0.R (K.K0.mul (K.class p) (K.class q)) (K.class s.1) = T.Bridge[g,g',gi,h,p,q,s.1,ep,eq,s.2].theorem ;
   -- [A^m][q] = [P_{1 (x) g}]
   left : Id K.K0.R (K.K0.mul (K.free m) (K.class q)) (K.class s1.1) =
    T.Bridge[g,g',gi,KC.Mm.mone,PJ.Free[m].projector,q,s1.1,one-m,eq,s1.2].theorem ;
   -- [p][A^n] = [P_{h (x) 1}]
   right : Id K.K0.R (K.K0.mul (K.class p) (K.free n)) (K.class s2.1) =
    T.Bridge[KC.Mn.mone,KC.Mn.mone,GK.one-n,h,p,PJ.Free[n].projector,s2.1,ep,one-n,s2.2].theorem ;
   -- [P_{1 (x) g}] + [P_{h (x) 1}] = [P_{h (x) g}] + [A^N]
   sum : Id K.K0.R (K.K0.add (K.class s1.1) (K.class s2.1)) (K.K0.add (K.class s.1) (K.free (Pairing[l].times m n))) =
    CS.Lemma[GL.G,KC.kron KC.Mm.mone g',KC.kron-inverse KC.Mm.mone KC.Mm.mone GK.one-m g g' gi,
     GL.F,KC.kron h' KC.Mn.mone,KC.kron-inverse h h' hi KC.Mn.mone KC.Mn.mone GK.one-n,s1.1,s2.1,s.1,s1.2,s2.2,
     MI.compose (K.image s.1) Ps.Pg.glued GL.L.Pgh.glued s.2 T.GN.Equal[KC.MN.mmul GL.G GL.F,KC.kron h g,sym GL.product].iso].theorem ;
   equation : Statement =
    V.vanish (K.class p) (K.class q) (K.free m) (K.free n) (K.class s.1) (K.class s1.1) (K.class s2.1)
     (K.free (Pairing[l].times m n)) tensor left right free-product sum ;
  } ;
  theorem : Statement =
   TC.rec Ps.Presented @l Statement (K.G.set _ _) (\ s ->
    TC.rec P1.Presented @l Statement (K.G.set _ _) (\ s1 ->
     TC.rec P2.Presented @l Statement (K.G.set _ _) (\ s2 -> At[s,s1,s2].equation) P2.theorem) P1.theorem) Ps.theorem ;
 } ;
} ;
