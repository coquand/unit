-- The group laws of stack gerbes, up to equality (C3, step C4), and
-- n . G = D (n_* G) (step C5, T1).  Each law is a pull-back of line families
-- along a map of charged types keeping the characters (GERBEOPS.Pull), the
-- evaluation map (GERBEOPS.Eval) or a point (GERBEOPS.Pointed).
--  (comm)    swap : H x G -> G x H keeps beta x beta (R^x is commutative), so
--            K(G, H) = K(H, G).
--  (unit)    g |-> (g, base) : G -> G x T carries p to (p, refl) and
--            beta_G(p) beta_T(refl) = beta_G(p), so K(G, T) = D G and
--            G + T = D D G = G.
--  (inverse) (g, a) |-> (j a) g is a line family on G x D G of weight
--            beta x beta (transport along P is transport along P.1 in the line
--            family j a, by beta_G(P.1), followed by the isomorphism of P.2, by
--            beta_(D G)(P.2)): K(G, D G) has a point, so K(G, D G) = T and
--            G + D G = D T = T.
--  (assoc)   On X3 = G x (H x K), with weight beta beta beta:
--            (g,(h,k)) |-> (ev (g,h), k) : X3 -> (G + H) x K and
--            (g,(h,k)) |-> (g, ev (h,k)) : X3 -> G x (H + K) keep the
--            characters (ev carries w to the band, GERBEOPS.Eval; R^x is
--            associative), so K(G + H, K) = K3 = K(G, H + K).
--  (T1)      n . G (n-fold sum, 0 . G = T) is D (n_* G), n_* G the line families
--            of weight beta^n (BANDCHANGE.Power).  n = 0: the constant family R
--            is a point of 0_* G, so D (0_* G) = D T = T.  n + 1: g |-> (g, ev g)
--            : G -> G x D (n_* G) carries p to beta(p) beta(p)^n = beta(p)^(n+1),
--            so K(G, D (n_* G)) = (n+1)_* G, and
--            (n+1) . G = G + n . G = G + D (n_* G) = D ((n+1)_* G).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 module BC = BandChange[l].Over[R,setR,axioms,sh] ;
 module BCG = BandChangeGerbe[l].Over[R,setR,axioms,loc,sh] ;
 module LG = LineGerbe[l].Over[R,setR,axioms,loc,sh] ;
 module GO = GerbeOps[l].Over[R,setR,axioms,loc,sh] ;
 module GS = GerbeSum[l].Over[R,setR,axioms,loc,sh] ;
 module SG = GO.SG ;
 module TN = TwistedMain[l].Over[R,setR,axioms,loc] ;
 SGb : U l+ = SG.StackGerbe ;
 dual (G : SGb) : SGb = GO.dual G ;
 sum (G H : SGb) : SGb = GS.sum G H ;
 ap-dual (G H : SGb) (p : Id SGb G H) : Id SGb (dual G) (dual H) = Hi.ap SGb SGb dual G H p ;
 -- (comm)
 module Comm (G H : SGb) {
  module GH = GS.Pair[G,H] ;
  module HG = GS.Pair[H,G] ;
  swap (x : HG.PC.X) : GH.PC.X = (x.2,x.1) ;
  pr1-swap (x x' : HG.PC.X) (P : Id HG.PC.X x x') :
   Id (Id G.1 x.2 x'.2) (GH.PC.pr1 (swap x) (swap x') (Pr.ap HG.PC.X GH.PC.X swap x x' P)) (HG.PC.pr2 x x' P) =
   idJ HG.PC.X x (\ z Q -> Id (Id G.1 x.2 z.2) (GH.PC.pr1 (swap x) (swap z) (Pr.ap HG.PC.X GH.PC.X swap x z Q)) (HG.PC.pr2 x z Q))
    (refl (refl x.2)) x' P ;
  pr2-swap (x x' : HG.PC.X) (P : Id HG.PC.X x x') :
   Id (Id H.1 x.1 x'.1) (GH.PC.pr2 (swap x) (swap x') (Pr.ap HG.PC.X GH.PC.X swap x x' P)) (HG.PC.pr1 x x' P) =
   idJ HG.PC.X x (\ z Q -> Id (Id H.1 x.1 z.1) (GH.PC.pr2 (swap x) (swap z) (Pr.ap HG.PC.X GH.PC.X swap x z Q)) (HG.PC.pr1 x z Q))
    (refl (refl x.1)) x' P ;
  compat (x : HG.PC.X) (P : Id HG.PC.X x x) : Id UG.Unit (GH.PC.w (swap x) (Pr.ap HG.PC.X GH.PC.X swap x x P)) (HG.PC.w x P) =
   trans (cong2 UG.Unit UG.times _ _ _ _ (ap (SG.bnd G x.2) (pr1-swap x x P)) (ap (SG.bnd H x.1) (pr2-swap x x P)))
    (UG.comm (SG.bnd G x.2 (HG.PC.pr2 x x P)) (SG.bnd H x.1 (HG.PC.pr1 x x P))) ;
  module W = GO.Pull[HG.PC.char,GH.PC.char,swap,compat].With[\ x0 -> HG.At[x0].object,\ x0 -> GH.At[x0].object] ;
  theorem : Id SGb (sum G H) (sum H G) = ap-dual GH.K.gerbe HG.K.gerbe W.theorem ;
 } ;
 -- (unit)
 module Neutral (G : SGb) {
  T : SGb = GO.trivial ;
  module GT = GS.Pair[G,T] ;
  phi (g : G.1) : GT.PC.X = (g,GO.base) ;
  pr1-phi (g g' : G.1) (p : Id G.1 g g') : Id (Id G.1 g g') (GT.PC.pr1 (phi g) (phi g') (Pr.ap G.1 GT.PC.X phi g g' p)) p =
   idJ G.1 g (\ z q -> Id (Id G.1 g z) (GT.PC.pr1 (phi g) (phi z) (Pr.ap G.1 GT.PC.X phi g z q)) q) (refl (refl g)) g' p ;
  pr2-phi (g g' : G.1) (p : Id G.1 g g') : Id (Id T.1 GO.base GO.base) (GT.PC.pr2 (phi g) (phi g') (Pr.ap G.1 GT.PC.X phi g g' p)) (refl GO.base) =
   idJ G.1 g (\ z q -> Id (Id T.1 GO.base GO.base) (GT.PC.pr2 (phi g) (phi z) (Pr.ap G.1 GT.PC.X phi g z q)) (refl GO.base)) (refl (refl GO.base)) g' p ;
  bnd-refl : Id UG.Unit (SG.bnd T GO.base (refl GO.base)) UG.one = TM.GB.Core[T.1,SG.gpd T,SG.band T].bnd-refl GO.base ;
  compat (g : G.1) (p : Id G.1 g g) : Id UG.Unit (GT.PC.w (phi g) (Pr.ap G.1 GT.PC.X phi g g p)) (SG.bnd G g p) =
   trans (cong2 UG.Unit UG.times _ _ _ _ (ap (SG.bnd G g) (pr1-phi g g p)) (trans (ap (SG.bnd T GO.base) (pr2-phi g g p)) bnd-refl))
    (UG.unitr (SG.bnd G g p)) ;
  module W = GO.Pull[GO.char G,GT.PC.char,phi,compat].With[\ s -> GO.Line[G,s].object,\ x0 -> GT.At[x0].object] ;
  #fails {
   -- the second component of the image of a loop is refl, not the loop
   pr2-wrong (g : G.1) (p : Id G.1 g g) : Id (Id T.1 GO.base GO.base) (GT.PC.pr2 (phi g) (phi g) (Pr.ap G.1 GT.PC.X phi g g p)) (refl GO.base) = refl (refl GO.base) ;
  } ;
  theorem : Id SGb (sum G T) G =
   Hi.trans SGb (sum G T) (dual (dual G)) G (ap-dual GT.K.gerbe (dual G) W.theorem) (Hi.sym SGb G (dual (dual G)) GO.DoubleDual[G].theorem) ;
 } ;
 -- (inverse)
 module Inverse (G : SGb) {
  module GD = GS.Pair[G,dual G] ;
  module DG = LG.At[GO.char G,\ s -> GO.Line[G,s].object] ;
  F (x : GD.PC.X) : MD.Module = (DG.S.j x.2).1 x.1 ;
  Q (x x' : GD.PC.X) (P : Id GD.PC.X x x') : Id DG.B.Obj (DG.S.j x.2) (DG.S.j x'.2) =
   Hi.ap DG.S.Small DG.B.Obj DG.S.j x.2 x'.2 (GD.PC.pr2 x x' P) ;
  move-F (x x' : GD.PC.X) (P : Id GD.PC.X x x') (m : (F x).M) :
   Id (F x').M (GD.PC.T.Move[F].move x x' P m)
    ((DG.B.Fd.idToIso (DG.S.j x.2) (DG.S.j x'.2) (Q x x' P) x'.1).1.1 (DG.T.Move[(DG.S.j x.2).1].move x.1 x'.1 (GD.PC.pr1 x x' P) m)) =
   idJ GD.PC.X x (\ z P2 -> Id (F z).M (GD.PC.T.Move[F].move x z P2 m)
     ((DG.B.Fd.idToIso (DG.S.j x.2) (DG.S.j z.2) (Q x z P2) z.1).1.1 (DG.T.Move[(DG.S.j x.2).1].move x.1 z.1 (GD.PC.pr1 x z P2) m)))
    (refl m) x' P ;
  weight : GD.PC.T.WeightBy GD.PC.w F = \ x P m ->
   calc (F x).M { GD.PC.T.Move[F].move x x P m
    =< move-F x x P m > (DG.B.Fd.idToIso (DG.S.j x.2) (DG.S.j x.2) (Q x x P) x.1).1.1 (DG.T.Move[(DG.S.j x.2).1].move x.1 x.1 (GD.PC.pr1 x x P) m)
    =< ap (DG.B.Fd.idToIso (DG.S.j x.2) (DG.S.j x.2) (Q x x P) x.1).1.1 ((DG.S.j x.2).2.1 x.1 (GD.PC.pr1 x x P) m) >
       (DG.B.Fd.idToIso (DG.S.j x.2) (DG.S.j x.2) (Q x x P) x.1).1.1 ((F x).sm (SG.bnd G x.1 (GD.PC.pr1 x x P)).1 m)
    =< (DG.B.Fd.idToIso (DG.S.j x.2) (DG.S.j x.2) (Q x x P) x.1).1.2.2 (SG.bnd G x.1 (GD.PC.pr1 x x P)).1 m >
       (F x).sm (SG.bnd G x.1 (GD.PC.pr1 x x P)).1 ((DG.B.Fd.idToIso (DG.S.j x.2) (DG.S.j x.2) (Q x x P) x.1).1.1 m)
    =< ap ((F x).sm (SG.bnd G x.1 (GD.PC.pr1 x x P)).1) (DG.B.Loops[DG.S.j x.2].law (Q x x P) x.1 m) >
       (F x).sm (SG.bnd G x.1 (GD.PC.pr1 x x P)).1 ((F x).sm (DG.B.Loops[DG.S.j x.2].b0 (Q x x P)) m)
    =< (F x).smA (SG.bnd G x.1 (GD.PC.pr1 x x P)).1 (DG.B.Loops[DG.S.j x.2].b0 (Q x x P)) m >
       (F x).sm (R.mul (SG.bnd G x.1 (GD.PC.pr1 x x P)).1 (DG.B.Loops[DG.S.j x.2].b0 (Q x x P))) m } ;
  object : BC.At[GD.PC.char].Obj = (F,weight,\ x -> (DG.S.j x.2).2.2 x.1) ;
  point : GD.K.S.Small = GD.K.S.inv object ;
  theorem : Id SGb (sum G (dual G)) GO.trivial =
   Hi.trans SGb (sum G (dual G)) (dual GO.trivial) GO.trivial
    (ap-dual GD.K.gerbe GO.trivial GO.Pointed[GD.K.gerbe,point].theorem) GO.dual-trivial ;
 } ;
 -- (assoc)
 module Assoc (G H K : SGb) {
  module GH = GS.Pair[G,H] ;
  module HK = GS.Pair[H,K] ;
  module EGH = GO.Eval[GH.PC.char,\ x0 -> GH.At[x0].object] ;
  module EHK = GO.Eval[HK.PC.char,\ x0 -> HK.At[x0].object] ;
  module L = GS.Pair[sum G H,K] ;
  module Rt = GS.Pair[G,sum H K] ;
  module P3 = GS.Prod[GO.char G,HK.PC.char] ;
  X3 : U l = P3.X ;
  q (x : X3) : GH.PC.X = (x.1,x.2.1) ;
  phi1 (x : X3) : L.PC.X = (EGH.ev (q x),x.2.2) ;
  phi2 (x : X3) : Rt.PC.X = (x.1,EHK.ev x.2) ;
  -- the projections of the images of a path
  a1 (x x' : X3) (P : Id X3 x x') : Id (Id (sum G H).1 (EGH.ev (q x)) (EGH.ev (q x')))
   (L.PC.pr1 (phi1 x) (phi1 x') (Pr.ap X3 L.PC.X phi1 x x' P)) (Pr.ap GH.PC.X (sum G H).1 EGH.ev (q x) (q x') (Pr.ap X3 GH.PC.X q x x' P)) =
   idJ X3 x (\ z P2 -> Id (Id (sum G H).1 (EGH.ev (q x)) (EGH.ev (q z)))
     (L.PC.pr1 (phi1 x) (phi1 z) (Pr.ap X3 L.PC.X phi1 x z P2)) (Pr.ap GH.PC.X (sum G H).1 EGH.ev (q x) (q z) (Pr.ap X3 GH.PC.X q x z P2)))
    (refl (refl (EGH.ev (q x)))) x' P ;
  a2 (x x' : X3) (P : Id X3 x x') : Id (Id K.1 x.2.2 x'.2.2) (L.PC.pr2 (phi1 x) (phi1 x') (Pr.ap X3 L.PC.X phi1 x x' P)) (HK.PC.pr2 x.2 x'.2 (P3.pr2 x x' P)) =
   idJ X3 x (\ z P2 -> Id (Id K.1 x.2.2 z.2.2) (L.PC.pr2 (phi1 x) (phi1 z) (Pr.ap X3 L.PC.X phi1 x z P2)) (HK.PC.pr2 x.2 z.2 (P3.pr2 x z P2)))
    (refl (refl x.2.2)) x' P ;
  b1 (x x' : X3) (P : Id X3 x x') : Id (Id G.1 x.1 x'.1) (GH.PC.pr1 (q x) (q x') (Pr.ap X3 GH.PC.X q x x' P)) (P3.pr1 x x' P) =
   idJ X3 x (\ z P2 -> Id (Id G.1 x.1 z.1) (GH.PC.pr1 (q x) (q z) (Pr.ap X3 GH.PC.X q x z P2)) (P3.pr1 x z P2)) (refl (refl x.1)) x' P ;
  b2 (x x' : X3) (P : Id X3 x x') : Id (Id H.1 x.2.1 x'.2.1) (GH.PC.pr2 (q x) (q x') (Pr.ap X3 GH.PC.X q x x' P)) (HK.PC.pr1 x.2 x'.2 (P3.pr2 x x' P)) =
   idJ X3 x (\ z P2 -> Id (Id H.1 x.2.1 z.2.1) (GH.PC.pr2 (q x) (q z) (Pr.ap X3 GH.PC.X q x z P2)) (HK.PC.pr1 x.2 z.2 (P3.pr2 x z P2)))
    (refl (refl x.2.1)) x' P ;
  c1 (x x' : X3) (P : Id X3 x x') : Id (Id G.1 x.1 x'.1) (Rt.PC.pr1 (phi2 x) (phi2 x') (Pr.ap X3 Rt.PC.X phi2 x x' P)) (P3.pr1 x x' P) =
   idJ X3 x (\ z P2 -> Id (Id G.1 x.1 z.1) (Rt.PC.pr1 (phi2 x) (phi2 z) (Pr.ap X3 Rt.PC.X phi2 x z P2)) (P3.pr1 x z P2)) (refl (refl x.1)) x' P ;
  c2 (x x' : X3) (P : Id X3 x x') : Id (Id (sum H K).1 (EHK.ev x.2) (EHK.ev x'.2))
   (Rt.PC.pr2 (phi2 x) (phi2 x') (Pr.ap X3 Rt.PC.X phi2 x x' P)) (Pr.ap HK.PC.X (sum H K).1 EHK.ev x.2 x'.2 (P3.pr2 x x' P)) =
   idJ X3 x (\ z P2 -> Id (Id (sum H K).1 (EHK.ev x.2) (EHK.ev z.2))
     (Rt.PC.pr2 (phi2 x) (phi2 z) (Pr.ap X3 Rt.PC.X phi2 x z P2)) (Pr.ap HK.PC.X (sum H K).1 EHK.ev x.2 z.2 (P3.pr2 x z P2)))
    (refl (refl (EHK.ev x.2))) x' P ;
  -- the characters
  bG (x : X3) (P : Id X3 x x) : UG.Unit = SG.bnd G x.1 (P3.pr1 x x P) ;
  bH (x : X3) (P : Id X3 x x) : UG.Unit = SG.bnd H x.2.1 (HK.PC.pr1 x.2 x.2 (P3.pr2 x x P)) ;
  bK (x : X3) (P : Id X3 x x) : UG.Unit = SG.bnd K x.2.2 (HK.PC.pr2 x.2 x.2 (P3.pr2 x x P)) ;
  first (x : X3) (P : Id X3 x x) :
   Id UG.Unit (SG.bnd (sum G H) (EGH.ev (q x)) (L.PC.pr1 (phi1 x) (phi1 x) (Pr.ap X3 L.PC.X phi1 x x P))) (UG.times (bG x P) (bH x P)) =
   trans (ap (SG.bnd (sum G H) (EGH.ev (q x))) (a1 x x P))
    (trans (EGH.ev-bnd (q x) (Pr.ap X3 GH.PC.X q x x P))
     (cong2 UG.Unit UG.times _ _ _ _ (ap (SG.bnd G x.1) (b1 x x P)) (ap (SG.bnd H x.2.1) (b2 x x P)))) ;
  compat1 (x : X3) (P : Id X3 x x) : Id UG.Unit (L.PC.w (phi1 x) (Pr.ap X3 L.PC.X phi1 x x P)) (P3.w x P) =
   trans (cong2 UG.Unit UG.times _ _ _ _ (first x P) (ap (SG.bnd K x.2.2) (a2 x x P)))
    (UG.assoc (bG x P) (bH x P) (bK x P)) ;
  compat2 (x : X3) (P : Id X3 x x) : Id UG.Unit (Rt.PC.w (phi2 x) (Pr.ap X3 Rt.PC.X phi2 x x P)) (P3.w x P) =
   cong2 UG.Unit UG.times _ _ _ _ (ap (SG.bnd G x.1) (c1 x x P))
    (trans (ap (SG.bnd (sum H K) (EHK.ev x.2)) (c2 x x P)) (EHK.ev-bnd x.2 (P3.pr2 x x P))) ;
  module Pl1 = GO.Pull[P3.char,L.PC.char,phi1,compat1] ;
  module Pl2 = GO.Pull[P3.char,Rt.PC.char,phi2,compat2] ;
  pt3 (x : X3) : BC.At[P3.char].Obj = Pl1.pull (L.At[phi1 x].object) ;
  module W1 = Pl1.With[pt3,\ y -> L.At[y].object] ;
  module W2 = Pl2.With[pt3,\ y -> Rt.At[y].object] ;
  theorem : Id SGb (sum (sum G H) K) (sum G (sum H K)) =
   ap-dual L.K.gerbe Rt.K.gerbe (Hi.trans SGb L.K.gerbe W1.LC.gerbe Rt.K.gerbe W1.theorem (Hi.sym SGb Rt.K.gerbe W2.LC.gerbe W2.theorem)) ;
 } ;
 -- (T1)
 module Push (G : SGb) (n : Nat) {
  module PW = BCG.Power[GO.tg G,n] ;
  module L = LG.At[PW.PW.char,\ s -> PW.Point[s].object] ;
 } ;
 push (G : SGb) (n : Nat) : SGb = Push[G,n].L.gerbe ;
 times (G : SGb) : Nat -> SGb = split { zero -> GO.trivial ; suc n | t -> sum G t } ;
 module Zero (G : SGb) {
  module L = Push[G,zero].L ;
  const-move (y y' : G.1) (p : Id G.1 y y') (m : R.R) : Id R.R (L.T.Move[\ g -> MD.regular].move y y' p m) m =
   idJ G.1 y (\ z q -> Id R.R (L.T.Move[\ g -> MD.regular].move y z q m) m) (refl m) y' p ;
  object : L.B.Obj =
   (\ g -> MD.regular,\ y p m -> trans (const-move y y p m) (sym (MD.regular.smO m)),
    \ g -> Tr.Trunc[LF.Basis[MD.regular,suc zero]].inc TN.regular-basis) ;
  theorem : Id SGb (times G zero) (dual (push G zero)) =
   Hi.sym SGb (dual (push G zero)) GO.trivial
    (Hi.trans SGb (dual (push G zero)) (dual GO.trivial) GO.trivial
     (ap-dual (push G zero) GO.trivial GO.Pointed[push G zero,L.S.inv object].theorem) GO.dual-trivial) ;
 } ;
 module Step (G : SGb) (n : Nat) {
  module E = GO.Eval[Push[G,n].PW.PW.char,\ s -> Push[G,n].PW.Point[s].object] ;
  module GP = GS.Pair[G,dual (push G n)] ;
  phi (g : G.1) : GP.PC.X = (g,E.ev g) ;
  pr1-phi (g g' : G.1) (p : Id G.1 g g') : Id (Id G.1 g g') (GP.PC.pr1 (phi g) (phi g') (Pr.ap G.1 GP.PC.X phi g g' p)) p =
   idJ G.1 g (\ z r -> Id (Id G.1 g z) (GP.PC.pr1 (phi g) (phi z) (Pr.ap G.1 GP.PC.X phi g z r)) r) (refl (refl g)) g' p ;
  pr2-phi (g g' : G.1) (p : Id G.1 g g') : Id (Id (dual (push G n)).1 (E.ev g) (E.ev g'))
   (GP.PC.pr2 (phi g) (phi g') (Pr.ap G.1 GP.PC.X phi g g' p)) (Pr.ap G.1 (dual (push G n)).1 E.ev g g' p) =
   idJ G.1 g (\ z r -> Id (Id (dual (push G n)).1 (E.ev g) (E.ev z))
     (GP.PC.pr2 (phi g) (phi z) (Pr.ap G.1 GP.PC.X phi g z r)) (Pr.ap G.1 (dual (push G n)).1 E.ev g z r)) (refl (refl (E.ev g))) g' p ;
  compat (g : G.1) (p : Id G.1 g g) :
   Id UG.Unit (GP.PC.w (phi g) (Pr.ap G.1 GP.PC.X phi g g p)) (Push[G,suc n].PW.PW.char.1.2.2 g p) =
   cong2 UG.Unit UG.times _ _ _ _ (ap (SG.bnd G g) (pr1-phi g g p))
    (trans (ap (SG.bnd (dual (push G n)) (E.ev g)) (pr2-phi g g p)) (E.ev-bnd g p)) ;
  module W = GO.Pull[Push[G,suc n].PW.PW.char,GP.PC.char,phi,compat].With[\ s -> Push[G,suc n].PW.Point[s].object,\ y -> GP.At[y].object] ;
  theorem : Id SGb (sum G (dual (push G n))) (dual (push G (suc n))) = ap-dual GP.K.gerbe (push G (suc n)) W.theorem ;
 } ;
 times-push (G : SGb) : (n : Nat) -> Id SGb (times G n) (dual (push G n)) = split {
  zero -> Zero[G].theorem ;
  suc n | h -> Hi.trans SGb (sum G (times G n)) (sum G (dual (push G n))) (dual (push G (suc n)))
   (Hi.ap SGb SGb (sum G) (times G n) (dual (push G n)) h) Step[G,n].theorem } ;
} ;
