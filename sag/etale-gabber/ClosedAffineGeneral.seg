-- The intrinsic form: a closed subtype of any affine type is affine.
level l ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Over (R : Ring[l].CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module Cl = ClosedProp[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module Unique = AffineUniqueness[l].Over[R,setR,axioms.sqc] ;
 Property (X : U l) : U l+ =
  (sub : X -> U l) -> Cl.ClosedSubtype X sub -> FA.Affine ((x : X) * sub x) ;
 spectrum (A : C.Algebra) (fp : P.FP A) : Property (C.Spec A) =
  \ sub closed -> ClosedAffine[l].Over[R,setR,axioms].At[A,fp,sub,closed].affine ;
 from-witness (X : U l) (w : FA.AffineWitness X) : Property X =
  Hi.subst (U l) Property (C.Spec w.1) X
   (Hi.sym (U l) X (C.Spec w.1) (Axioms[l].UnivalenceLemmas[univ @l].ua X (C.Spec w.1) w.2.2))
   (spectrum w.1 w.2.1) ;
 theorem (X : U l) (affine : FA.Affine X) : Property X =
  from-witness X (Unique.At[X].representation affine) ;
} ;
