-- Every algebra equipped with a presentation is merely generated by its
-- named generators, not only the expression-quotient model.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (A : Algebras[l].Over[R,setR].Algebra)
 (p : Presentations[l].Over[R,setR].Presentation)
 (pa : Presentations[l].Over[R,setR].Presents p A) {
 module P = Presentations[l].Over[R,setR] ;
 module K = PresentationExistence[l].Over[R,setR,p] ;
 module I = PresentationComparison[l].Over[R,setR,p,A,K.A.algebra,pa,K.presentation] ;
 V : U l = Presentations[l].Fin p.1 ;
 ev : P.Expr V -> A.ring.R = P.eval V A pa.1.1 ;
 generator-path : Id (V -> A.ring.R) (\ v -> I.backward.1.1 (K.A.generators v)) pa.1.1 =
  F.funext V (\ v -> A.ring.R) _ _ I.backward-generators ;
 eval-back (e : P.Expr V) : Id A.ring.R (I.backward.1.1 (K.A.include e)) (ev e) =
  trans (ap I.backward.1.1 (sym (K.A.reify e)))
   (trans (P.natural V K.A.algebra A I.backward K.A.generators e)
    (Pr.ap (V -> A.ring.R) A.ring.R (\ a -> P.eval V A a e) _ _ generator-path)) ;
 Rep (a : A.ring.R) : U l = (e : P.Expr V) * Id A.ring.R (ev e) a ;
 generated (a : A.ring.R) : Tr.Trunc[Rep a].carrier =
  Tr.Trunc[K.Representatives (I.forward.1.1 a)].induction @l
   (\ t -> Tr.Trunc[Rep a].carrier) (\ t -> Tr.Trunc[Rep a].proposition)
   (\ w -> Tr.Trunc[Rep a].inc
    (w.1,trans (sym (eval-back w.1)) (trans (ap I.backward.1.1 w.2) (I.bf a))))
   (K.generated (I.forward.1.1 a)) ;
} ;
