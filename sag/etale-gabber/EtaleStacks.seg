-- Etale stack gerbes are root stack gerbes, so Gabber's theorem in H^2 form
-- (GABBERH2, GABBERTORSION) holds for them.  J -> I picks out some of the
-- generators of the root topology (ETALETOPOLOGY), shJ is a closure for
-- them, and J-gerbes are as in ETALEGABBER; for the etale topology itself
-- (J the unramifiable polynomials, shJ the etale trees) see Etale below.
-- Lemma (stack).  If G is a J-gerbe whose carrier X is a J-sheaf, then X is
-- a root sheaf.
-- Proof.  Fix a generator i of the root topology, P = G i (a proposition)
-- and c : X -> (P -> X) the constant map; c must be an equivalence.  It
-- suffices that each fibre Fib phi = (x : X) * (c x = phi) is contractible.
--  (paths)   The paths of X are root sheaves (ETALEGABBER.Root.paths).  So
--            from q : c x = c y we get x = y, the preimage of happly q under
--            the constant map of x = y; ap c of it is q again (happly of
--            ap c r is the constant family r, by J on r).
--  (const)   Fib (c x0) is a retract of the singleton (y : X) * (y = x0),
--            through (paths); hence contractible.
--  (sheaf)   Fib phi is a J-sheaf (X is, so are P -> X and its paths), hence
--            so is isContr (Fib phi), a proposition.  As X is J-locally
--            inhabited, we may assume a point x0.
--  (H90)     The product T = (g : P) -> (x0 = phi g) is a pre-torsor under
--            R^x (PiTorsor: the action is pointwise, and a family of scalars
--            P -> R^x is constant since R^x is a root sheaf).  It is a root
--            sheaf (paths are), and close T holds: close T is a root sheaf,
--            so it suffices to have it given g : P, where T is x0 = phi g,
--            locally inhabited (conn, weakened to the root closure).  By
--            Hilbert 90 (HILBERT90) T is merely inhabited; a point of T is a
--            path c x0 = phi (funext), and (const) applies.
-- Theorem (H2).  GABBERH2 for an etale stack gerbe: its class in H^2 is the
-- class delta(E) of an Azumaya algebra.  (Torsion) GABBERTORSION: the same
-- when (n0+1) . cl(G) = 0 in the group H^2.  Both: apply the root theorems
-- to the TGerbe of ETALEGABBER.Root, a stack by (stack).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module CU = FunExtUA[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
-- a retract of a contractible type is contractible
contr-retract (A B : U l) (to : A -> B) (from : B -> A) (from-to : (a : A) -> Id A (from (to a)) a)
 (k : CU.isContr B) : CU.isContr A =
 (from k.1, \ a -> Pr.trans A (from k.1) (from (to a)) a (Pr.ap B A from k.1 (to a) (k.2 (to a))) (from-to a)) ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops)
 (J : U l) (e : J -> EtaleTopology[l].Over[R,setR].I)
 (shJ : SheafClosure[l,l].Over[J,\ j -> EtaleTopology[l].Over[R,setR].G (e j)].Ops) {
 module EG = EtaleGabber[l].Over[R,setR,axioms,loc,sh,J,e,shJ] ;
 module ET = EG.ET ;
 module TJ = EG.TJ ;
 module SJ = EG.SJ ;
 module S0 = EG.S0 ;
 module LA = EG.LA ;
 module UG = LA.G ;
 -- (H90): a product of pre-torsors over a root generator
 module PiTorsor (i : ET.I) (T : ET.G i -> LA.PreTor) {
  Carrier : U l = (g : ET.G i) -> (T g).1 ;
  act-at (g : ET.G i) (a : UG.Unit) (t : (T g).1) : (T g).1 = (T g).2.1 a t ;
  act (a : UG.Unit) (s : Carrier) : Carrier = \ g -> act-at g a (s g) ;
  set : Pr.isSet Carrier = F.isSet-Pi (ET.G i) (\ g -> (T g).1) (\ g -> (T g).2.2.1) ;
  ad : LA.TB.AD Carrier act = \ a b s ->
   F.funext (ET.G i) (\ g -> (T g).1) (act (UG.times a b) s) (act a (act b s)) (\ g -> (T g).2.2.2.1 a b (s g)) ;
  ze : LA.TB.ZE Carrier act = \ s -> F.funext (ET.G i) (\ g -> (T g).1) (act UG.one s) s (\ g -> (T g).2.2.2.2.1 (s g)) ;
  units : Pr.isEquiv UG.Unit (ET.G i -> UG.Unit) (\ a g -> a) = EG.SS.unit-sheaf i ;
  module Two (s s' : Carrier) {
   Fibre (g : ET.G i) : U l = (a : UG.Unit) * Id (T g).1 (act-at g a (s g)) (s' g) ;
   k (g : ET.G i) : CU.isContr (Fibre g) = (T g).2.2.2.2.2 (s g) (s' g) ;
   alpha (g : ET.G i) : UG.Unit = (k g).1.1 ;
   a0 : UG.Unit = units.sec alpha ;
   at (g : ET.G i) : Id UG.Unit a0 (alpha g) =
    Pr.happly (ET.G i) (\ h -> UG.Unit) (\ h -> a0) alpha (units.sec-eq alpha) g ;
   moved (g : ET.G i) : Id (T g).1 (act-at g a0 (s g)) (s' g) =
    Pr.trans (T g).1 (act-at g a0 (s g)) (act-at g (alpha g) (s g)) (s' g)
     (Pr.ap UG.Unit (T g).1 (\ a -> act-at g a (s g)) a0 (alpha g) (at g)) (k g).1.2 ;
   Total : U l = (a : UG.Unit) * Id Carrier (act a s) s' ;
   centre : Total = (a0, F.funext (ET.G i) (\ g -> (T g).1) (act a0 s) s' moved) ;
   module Other (w : Total) {
    pointwise (g : ET.G i) : Id (T g).1 (act-at g w.1 (s g)) (s' g) =
     Pr.happly (ET.G i) (\ h -> (T h).1) (act w.1 s) s' w.2 g ;
    value (g : ET.G i) : Id UG.Unit (alpha g) w.1 =
     Pr.ap (Fibre g) UG.Unit (\ u -> u.1) (k g).1 (w.1,pointwise g) ((k g).2 (w.1,pointwise g)) ;
    constant : Id (ET.G i -> UG.Unit) alpha (\ g -> w.1) = F.funext (ET.G i) (\ g -> UG.Unit) alpha (\ g -> w.1) value ;
    first : Id UG.Unit a0 w.1 =
     Pr.trans UG.Unit a0 (units.sec (\ g -> w.1)) w.1
      (Pr.ap (ET.G i -> UG.Unit) UG.Unit units.sec alpha (\ g -> w.1) constant)
      (Pr.sec-ret UG.Unit (ET.G i -> UG.Unit) (\ a g -> a) units w.1) ;
    path : Id Total centre w =
     Pr.Sigma-path UG.Unit (\ a -> Id Carrier (act a s) s') a0 w.1 centre.2 w.2 first
      (set (act w.1 s) s' (Pr.subst UG.Unit (\ a -> Id Carrier (act a s) s') a0 w.1 first centre.2) w.2) ;
   } ;
   contr : CU.isContr Total = (centre, \ w -> Other[w].path) ;
  } ;
  ft : LA.TB.FT Carrier act = \ s s' -> Two[s,s'].contr ;
  pretorsor : LA.PreTor = (Carrier,act,set,ad,ze,ft) ;
 } ;
 -- Lemma (stack)
 module Stack (Gb : EG.JGerbe) (stk : TJ.isModal @l Gb.carrier) {
  X : U l = Gb.carrier ;
  module RG = EG.Root[Gb] ;
  module Gen (i : ET.I) {
   P : U l = ET.G i ;
   c (x : X) : P -> X = \ g -> x ;
   Fib (phi : P -> X) : U l = (x : X) * Id (P -> X) (c x) phi ;
   -- (paths)
   hap (x y : X) (r : Id X x y) :
    Id (P -> Id X x y) (Pr.happly P (\ g -> X) (c x) (c y) (Pr.ap X (P -> X) c x y r)) (\ g -> r) =
    idJ X x (\ y1 r1 -> Id (P -> Id X x y1) (Pr.happly P (\ g -> X) (c x) (c y1) (Pr.ap X (P -> X) c x y1 r1)) (\ g -> r1))
     (refl (\ g -> refl x)) y r ;
   unc (x y : X) (q : Id (P -> X) (c x) (c y)) : Id X x y = (RG.paths x y i).sec (Pr.happly P (\ g -> X) (c x) (c y) q) ;
   unc-eq (x y : X) (q : Id (P -> X) (c x) (c y)) : Id (Id (P -> X) (c x) (c y)) (Pr.ap X (P -> X) c x y (unc x y q)) q =
    Pr.trans (Id (P -> X) (c x) (c y)) (Pr.ap X (P -> X) c x y (unc x y q))
     (F.funext P (\ g -> X) (c x) (c y) (\ g -> unc x y q)) q
     (Pr.trans (Id (P -> X) (c x) (c y)) (Pr.ap X (P -> X) c x y (unc x y q))
       (F.funext P (\ g -> X) (c x) (c y) (Pr.happly P (\ g -> X) (c x) (c y) (Pr.ap X (P -> X) c x y (unc x y q))))
       (F.funext P (\ g -> X) (c x) (c y) (\ g -> unc x y q))
       (Pr.sym (Id (P -> X) (c x) (c y))
         (F.funext P (\ g -> X) (c x) (c y) (Pr.happly P (\ g -> X) (c x) (c y) (Pr.ap X (P -> X) c x y (unc x y q))))
         (Pr.ap X (P -> X) c x y (unc x y q))
         (F.funext-happly P (\ g -> X) (c x) (c y) (Pr.ap X (P -> X) c x y (unc x y q))))
       (Pr.ap (P -> Id X x y) (Id (P -> X) (c x) (c y)) (F.funext P (\ g -> X) (c x) (c y)) _ (\ g -> unc x y q)
         (hap x y (unc x y q))))
     (Pr.trans (Id (P -> X) (c x) (c y)) (F.funext P (\ g -> X) (c x) (c y) (\ g -> unc x y q))
       (F.funext P (\ g -> X) (c x) (c y) (Pr.happly P (\ g -> X) (c x) (c y) q)) q
       (Pr.ap (P -> Id X x y) (Id (P -> X) (c x) (c y)) (F.funext P (\ g -> X) (c x) (c y)) (\ g -> unc x y q)
         (Pr.happly P (\ g -> X) (c x) (c y) q) ((RG.paths x y i).sec-eq (Pr.happly P (\ g -> X) (c x) (c y) q)))
       (F.funext-happly P (\ g -> X) (c x) (c y) q)) ;
   -- (const)
   module AtConst (x0 : X) {
    Sing : U l = (y : X) * Id X y x0 ;
    to (w : Fib (c x0)) : Sing = (w.1, unc w.1 x0 w.2) ;
    from (w : Sing) : Fib (c x0) = (w.1, Pr.ap X (P -> X) c w.1 x0 w.2) ;
    from-to (w : Fib (c x0)) : Id (Fib (c x0)) (from (to w)) w =
     Pr.ap (Id (P -> X) (c w.1) (c x0)) (Fib (c x0)) (\ q -> (w.1,q)) (Pr.ap X (P -> X) c w.1 x0 (unc w.1 x0 w.2)) w.2
      (unc-eq w.1 x0 w.2) ;
    contr : CU.isContr (Fib (c x0)) = contr-retract (Fib (c x0)) Sing to from from-to (CU.sing X x0) ;
   } ;
   -- (sheaf)
   fib-sheaf (phi : P -> X) : TJ.isModal @l (Fib phi) =
    SJ.modal-Sigma X (\ x -> Id (P -> X) (c x) phi) stk
     (\ x -> SJ.modal-Id (P -> X) (SJ.modal-Pi P (\ g -> X) (\ g -> stk)) (c x) phi) ;
   contr-sheaf (phi : P -> X) : TJ.isModal @l (CU.isContr (Fib phi)) =
    SJ.modal-Sigma (Fib phi) (\ w -> (z : Fib phi) -> Id (Fib phi) w z) (fib-sheaf phi)
     (\ w -> SJ.modal-Pi (Fib phi) (\ z -> Id (Fib phi) w z) (\ z -> SJ.modal-Id (Fib phi) (fib-sheaf phi) w z)) ;
   -- (H90)
   module Based (phi : P -> X) (x0 : X) {
    T (g : P) : LA.PreTor = RG.PT.pretorsor x0 (phi g) ;
    module PiT = PiTorsor[i,T] ;
    sheaf : ET.T.isModal @l PiT.Carrier = S0.modal-Pi P (\ g -> Id X x0 (phi g)) (\ g -> RG.paths x0 (phi g)) ;
    spread (g : P) (p : Id X x0 (phi g)) : PiT.Carrier =
     \ g' -> Pr.subst P (\ h -> Id X x0 (phi h)) g g' (ET.G-prop i g g') p ;
    near (g : P) : sh.close PiT.Carrier =
     sh.elim @l (Id X x0 (phi g)) (sh.close PiT.Carrier) (sh.proposition PiT.Carrier) (sh.modal PiT.Carrier)
      (\ p -> sh.inc PiT.Carrier (spread g p)) (EG.weaken (Id X x0 (phi g)) (Gb.conn x0 (phi g))) ;
    local : sh.close PiT.Carrier = (sh.modal PiT.Carrier i).sec near ;
    sections : Tr.Trunc[PiT.Carrier].carrier = EG.H.At[PiT.pretorsor,sheaf,local].theorem ;
    equal (s : PiT.Carrier) : Id (P -> X) (c x0) phi = F.funext P (\ g -> X) (c x0) phi s ;
    contr : CU.isContr (Fib phi) =
     Tr.Trunc[PiT.Carrier].induction @l (\ z -> CU.isContr (Fib phi)) (\ z -> AffineHLevels[l].contr-prop (Fib phi))
      (\ s -> Pr.subst (P -> X) (\ psi -> CU.isContr (Fib psi)) (c x0) phi (equal s) AtConst[x0].contr) sections ;
   } ;
   contr (phi : P -> X) : CU.isContr (Fib phi) =
    shJ.elim @l X (CU.isContr (Fib phi)) (AffineHLevels[l].contr-prop (Fib phi)) (contr-sheaf phi)
     (\ x0 -> Based[phi,x0].contr) Gb.inh ;
   equivalence : Pr.isEquiv X (P -> X) c =
    Pr.qinv X (P -> X) c (\ phi -> (contr phi).1.1) (\ phi -> (contr phi).1.2)
     (\ x -> Pr.ap (Fib (c x)) X (\ w -> w.1) (contr (c x)).1 (x, refl (c x))
       (CU.pathC (Fib (c x)) (contr (c x)) (contr (c x)).1 (x, refl (c x)))) ;
  } ;
  root-stack : ET.T.isModal @l X = \ i -> Gen[i].equivalence ;
 } ;
 module BC = BandChange[l].Over[R,setR,axioms,sh] ;
 -- Theorem (H2)
 module H2 (A : EG.GA.C.Algebra) (fp : EG.GA.P.FP A) (G : EG.GA.C.Spec A -> EG.JGerbe)
  (stk : (x : EG.GA.C.Spec A) -> TJ.isModal @l (G x).carrier) (n0 : Nat)
  (torsion : (x : EG.GA.C.Spec A) -> BC.At[BC.Power[EG.Root[G x].gerbe,suc n0].char].Obj) {
  module GH = GabberH2[l].Over[R,setR,axioms,loc,sh].At[A,fp,\ x -> EG.Root[G x].gerbe,\ x -> Stack[G x,stk x].root-stack,n0,torsion] ;
  theorem : Tr1.Trunc[GH.Result].carrier = GH.theorem ;
 } ;
 -- Theorem (Torsion)
 module Torsion (A : EG.GA.C.Algebra) (fp : EG.GA.P.FP A) (G : EG.GA.C.Spec A -> EG.JGerbe)
  (stk : (x : EG.GA.C.Spec A) -> TJ.isModal @l (G x).carrier) (n0 : Nat) {
  module GT = GabberTorsion[l].Over[R,setR,axioms,loc,sh].At[A,fp,\ x -> EG.Root[G x].gerbe,\ x -> Stack[G x,stk x].root-stack,n0] ;
  module Killed (torsion : Id GT.HA.H2 (GT.HA.times GT.cl-G (suc n0)) GT.HA.zero) {
   theorem : Tr1.Trunc[GT.Result].carrier = GT.Killed[torsion].theorem ;
  } ;
 } ;
} ;
-- the etale topology itself: J = unramifiable monic polynomials, shJ = etale
-- trees (ETALETREECLOSURE), root closure ETALECLOSURE.  No closure is a
-- parameter: only R and the SAG axioms (univalence and replacement ambient).
module Etale (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module UR = Unramifiable[l].Over[R,setR] ;
 module ES = Over[R,setR,axioms,axioms.loc,EtaleClosure[l].Over[R,setR,axioms].ops,UR.J,UR.e,
  EtaleTreeClosure[l].Over[R,setR,axioms,UR.J,UR.e].ops] ;
 module H2 (A : ES.EG.GA.C.Algebra) (fp : ES.EG.GA.P.FP A) (G : ES.EG.GA.C.Spec A -> ES.EG.JGerbe)
  (stk : (x : ES.EG.GA.C.Spec A) -> ES.TJ.isModal @l (G x).carrier) (n0 : Nat)
  (torsion : (x : ES.EG.GA.C.Spec A) -> ES.BC.At[ES.BC.Power[ES.EG.Root[G x].gerbe,suc n0].char].Obj) {
  theorem : Tr1.Trunc[ES.H2[A,fp,G,stk,n0,torsion].GH.Result].carrier = ES.H2[A,fp,G,stk,n0,torsion].theorem ;
 } ;
 module Torsion (A : ES.EG.GA.C.Algebra) (fp : ES.EG.GA.P.FP A) (G : ES.EG.GA.C.Spec A -> ES.EG.JGerbe)
  (stk : (x : ES.EG.GA.C.Spec A) -> ES.TJ.isModal @l (G x).carrier) (n0 : Nat)
  (torsion : Id ES.Torsion[A,fp,G,stk,n0].GT.HA.H2
    (ES.Torsion[A,fp,G,stk,n0].GT.HA.times ES.Torsion[A,fp,G,stk,n0].GT.cl-G (suc n0)) ES.Torsion[A,fp,G,stk,n0].GT.HA.zero) {
  theorem : Tr1.Trunc[ES.Torsion[A,fp,G,stk,n0].GT.Result].carrier = ES.Torsion[A,fp,G,stk,n0].Killed[torsion].theorem ;
 } ;
} ;
