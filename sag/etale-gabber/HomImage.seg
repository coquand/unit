-- Hom between images of projectors, and Hom(P(V)^v, P(W)^v) at one fibre
-- (CHEAP-DESIGN.md, section 2, (ii)).  Over R, for a projector p let
-- I p = { w | p w = w } (MATRIXTENSOR), with the frame of its columns
-- (PRESENTEDCLASS.Columns, values p_ij).
--  (dual)   (I p)* = I p^T: the dual frame (coordinates, evaluation at the
--           columns) has the values p_ji (FRAMEIMAGE on FRAMES.dual-frame).
--  (image)  Hom(I p, I q) = I (p^T (x) q): the frame of HOMFRAMES built from
--           the two column frames has the values
--           d_b(c_a'(e_a) f_b') = p_a'a q_bb' = (p^T (x) q)_((a,b),(a',b'))
--           (KRONECKER, indices by PAIRING), by definition; FRAMEIMAGE.
--  (swap)   Hom(X, Hom(Y, Z)) = Hom(Y, Hom(X, Z)), f |-> (y |-> (x |-> f x y)).
--  (step)   If Hom(W, V) = I q, Hom(A, B) = I e and V merely has a frame:
--             Hom(Hom(V, A), Hom(W, B)) = Hom(W, Hom(Hom(V, A), B))       (swap)
--             = Hom(W, Hom(Hom(A, B)*, V))       (COMPARISON, C2; the frame of
--                                                  Hom(A, B) is the columns of e)
--             = Hom(W, Hom(I e^T, V))            (dual)
--             = Hom(I e^T, Hom(W, V)) = Hom(I e^T, I q)                  (swap)
--             = I (e (x) q)                       (image; (e^T)^T = e).
--  (powers) With P(V)^v = power V L k (MULTILINEAR) and L merely with a
--           basis of rank 1, Hom(power V L k, power W L k) = I q^(x)k, where
--           q^(x)0 = 1_1 (Hom(L, L) = I 1_1 by the scalars, SCALARLINE)
--           and q^(x)(k+1) = q^(x)k (x) q, by (step).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Pr1 = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module HM = HomModule[l].Over[R,setR] ;
 module FR = Frames[l].Over[R,setR] ;
 module HF = HomFrames[l].Over[R,setR] ;
 module MT = MatrixTensor[l].Over[R,setR] ;
 module SIP = ModuleSIP2[l].Over[MD.ring] ;
 module PJ = Projectors[l].Over[R,setR] ;
 module PC = PresentedClass[l].Over[R,setR,axioms] ;
 hom (P Q : MD.Module) : MD.Module = HM.At[P,Q].carrier ;
 image (p : PJ.Projector) : MD.Module = MT.I p.size p.matrix ;
 -- an idempotent matrix, its transpose, and the Kronecker product
 module Idem (n : Nat) (f : Vectors[l].Over[R,setR,n].MR.Mat)
  (hf : Id Vectors[l].Over[R,setR,n].MR.Mat (Vectors[l].Over[R,setR,n].MR.mmul f f) f) {
  module T = Transposes[l].Mats[R,setR,n] ;
  columns : FR.Frame[MT.I n f,n] = PC.Columns[n,f,hf].frame ;
  transpose : T.Mt.Mat = T.transpose f ;
  transposed : Id T.Mt.Mat (T.Mt.mmul transpose transpose) transpose = T.reverse f f f hf ;
  -- (dual)
  dual : Id MD.Module (FR.dual (MT.I n f)) (MT.I n transpose) =
   FrameImage[l].Over[R,setR].At[FR.dual (MT.I n f),n,FR.Of[MT.I n f,n,columns].dual-frame].theorem ;
 } ;
 -- (image)
 hom-image (m n : Nat) (f : Vectors[l].Over[R,setR,m].MR.Mat) (g : Vectors[l].Over[R,setR,n].MR.Mat)
  (hf : Id Vectors[l].Over[R,setR,m].MR.Mat (Vectors[l].Over[R,setR,m].MR.mmul f f) f)
  (hg : Id Vectors[l].Over[R,setR,n].MR.Mat (Vectors[l].Over[R,setR,n].MR.mmul g g) g) :
  Id MD.Module (hom (MT.I m f) (MT.I n g)) (MT.I (Pairing[l].times m n) (Kronecker[l].Over[R,setR,m,n].kron Idem[m,f,hf].transpose g)) =
  FrameImage[l].Over[R,setR].At[hom (MT.I m f) (MT.I n g),Pairing[l].times m n,
   HF.Of[MT.I m f,MT.I n g,m,n,Idem[m,f,hf].columns,Idem[n,g,hg].columns].frame].theorem ;
 -- (swap)
 swap-map (X Y Z : MD.Module) (f : HM.At[X,hom Y Z].S.E) : HM.At[Y,hom X Z].S.E =
  (\ y -> (\ x -> (f.1 x).1 y,\ x x' -> ap (\ h -> h.1 y) (f.2.1 x x'),\ c x -> ap (\ h -> h.1 y) (f.2.2 c x)),
   \ y y' -> HM.At[X,Z].ext _ _ (\ x -> (f.1 x).2.1 y y'),
   \ c y -> HM.At[X,Z].ext _ _ (\ x -> (f.1 x).2.2 c y)) ;
 module Swap (X Y Z : MD.Module) {
  module HX = HM.At[X,hom Y Z] ;
  module HY = HM.At[Y,hom X Z] ;
  back-to (f : HX.S.E) : Id HX.S.E (swap-map Y X Z (swap-map X Y Z f)) f =
   HX.ext _ f (\ x -> HM.At[Y,Z].ext _ _ (\ y -> refl ((f.1 x).1 y))) ;
  to-back (g : HY.S.E) : Id HY.S.E (swap-map X Y Z (swap-map Y X Z g)) g =
   HY.ext _ g (\ y -> HM.At[X,Z].ext _ _ (\ x -> refl ((g.1 y).1 x))) ;
  theorem : Id MD.Module (hom X (hom Y Z)) (hom Y (hom X Z)) =
   SIP.sip (hom X (hom Y Z)) (hom Y (hom X Z))
    ((swap-map X Y Z,Pr.qinv HX.S.E HY.S.E (swap-map X Y Z) (swap-map Y X Z) to-back back-to),
     \ f f' -> HY.ext _ _ (\ y -> HM.At[X,Z].ext _ _ (\ x -> refl (Z.madd ((f.1 x).1 y) ((f'.1 x).1 y)))),
     \ c f -> HY.ext _ _ (\ y -> HM.At[X,Z].ext _ _ (\ x -> refl (Z.sm c ((f.1 x).1 y))))) ;
 } ;
 -- (step)
 module Step (V W A B : MD.Module) (r : Nat) (fv : Tr.Trunc[FR.Frame[V,r]].carrier) (q e : PJ.Projector)
  (hq : Id MD.Module (hom W V) (image q)) (he : Id MD.Module (hom A B) (image e)) {
  module IE = Idem[e.size,e.matrix,e.idempotent] ;
  frame : FR.Frame[hom A B,e.size] =
   Datum[l].Over[R,setR,axioms].carry (image e) (hom A B) (Pr1.sym MD.Module (hom A B) (image e) he) e.size IE.columns ;
  module CM = Comparison[l].Over[R,setR].At[V,A,B,e.size,frame] ;
  -- e^T, and the product
  et : MD.Module = MT.I e.size IE.transpose ;
  product : MD.Module = MT.I (Pairing[l].times e.size q.size) (Kronecker[l].Over[R,setR,e.size,q.size].kron e.matrix q.matrix) ;
  -- the points of the chain
  m1 : MD.Module = hom W (hom (hom V A) B) ;
  m2 : MD.Module = hom W (hom (FR.dual (hom A B)) V) ;
  m3 : MD.Module = hom W (hom (FR.dual (image e)) V) ;
  m4 : MD.Module = hom W (hom et V) ;
  m5 : MD.Module = hom et (hom W V) ;
  m6 : MD.Module = hom et (image q) ;
  s1 : Id MD.Module (hom (hom V A) (hom W B)) m1 = Swap[hom V A,W,B].theorem ;
  s2 : Id MD.Module m1 m2 =
   Pr1.ap MD.Module MD.Module (hom W) (hom (hom V A) B) (hom (FR.dual (hom A B)) V)
    (Pr1.sym MD.Module (hom (FR.dual (hom A B)) V) (hom (hom V A) B) CM.Merely[r,fv].theorem) ;
  s3 : Id MD.Module m2 m3 = Pr1.ap MD.Module MD.Module (\ M -> hom W (hom (FR.dual M) V)) (hom A B) (image e) he ;
  s4 : Id MD.Module m3 m4 = Pr1.ap MD.Module MD.Module (\ M -> hom W (hom M V)) (FR.dual (image e)) et IE.dual ;
  s5 : Id MD.Module m4 m5 = Swap[W,et,V].theorem ;
  s6 : Id MD.Module m5 m6 = Pr1.ap MD.Module MD.Module (hom et) (hom W V) (image q) hq ;
  -- (e^T)^T = e by definition
  s7 : Id MD.Module m6 product = hom-image e.size q.size IE.transpose q.matrix IE.transposed q.idempotent ;
  theorem : Id MD.Module (hom (hom V A) (hom W B)) product =
   Pr1.trans MD.Module (hom (hom V A) (hom W B)) m1 product s1
    (Pr1.trans MD.Module m1 m2 product s2
     (Pr1.trans MD.Module m2 m3 product s3
      (Pr1.trans MD.Module m3 m4 product s4
       (Pr1.trans MD.Module m4 m5 product s5
        (Pr1.trans MD.Module m5 m6 product s6 s7))))) ;
 } ;
 -- (powers)
 kronecker (q : PJ.Projector) : Nat -> PJ.Projector = split {
  zero -> PJ.oneP ;
  suc k | p -> PJ.Product[p,q].projector } ;
 module Powers (V W L : MD.Module) (r : Nat) (fv : Tr.Trunc[FR.Frame[V,r]].carrier) (q : PJ.Projector)
  (hq : Id MD.Module (hom W V) (image q)) (bl : Tr.Trunc[LocalFree[l].Over[R,setR,axioms].Basis[L,suc zero]].carrier) {
  base : Id MD.Module (hom L L) (image PJ.oneP) = ScalarLine[l].Over[R,setR,axioms].At[L].Merely[bl].theorem ;
  power (P : MD.Module) (k : Nat) : MD.Module = Multilinear[l].Over[R,setR].power P L k ;
  theorem : (k : Nat) -> Id MD.Module (hom (power V k) (power W k)) (image (kronecker q k)) = split {
   zero -> base ;
   suc k | ih -> Step[V,W,power V k,power W k,r,fv,q,kronecker q k,hq,ih].theorem } ;
 } ;
} ;
