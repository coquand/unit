-- SAG 4.1.3: inclusion of finite zero loci detects genuine ideal
-- membership, not merely membership in the radical.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ; module Q = FiniteQuotient[l].Over[R,setR] ;
 module At (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (m : Nat) (gs : Fin m -> A.ring.R) {
  module I = GeneratedIdeal[l].Over[A.ring,n,fs] ;
  V (x : C.Spec A) : U l = CP.Zeros n (\ i -> x.1.1 (fs i)) ;
  W (x : C.Spec A) : U l = CP.Zeros m (\ i -> x.1.1 (gs i)) ;
  Inclusion : U l = (x : C.Spec A) -> V x -> W x ;
  IdealInclusion : U l = (i : Fin m) -> I.Member (gs i) ;
  from-ideal (h : IdealInclusion) : Inclusion = \ x v j ->
   IdealVanishing[l].Over[A.ring,R,setR,x.1,n,fs,v].vanish (gs j) (h j) ;
  module SAG (sqc : P.SQC) (fp : P.FP A) {
   module AtQuotient (q : Q.Witness A n fs) (h : Inclusion) {
    inc : C.Hom A q.1 = q.2.2.1 ;
    zero-at-points (j : Fin m) (y : C.Spec q.1) : Id R.R (y.1.1 (inc.1.1 (gs j))) R.z =
     h (C.compose A q.1 C.base y inc)
      (\ i -> trans (ap y.1.1 (q.2.2.2.1 i)) (RingHom[l].zero q.1.ring R y.1)) j ;
    zero-in-quotient (j : Fin m) : Id q.1.ring.R (inc.1.1 (gs j)) q.1.ring.z =
     Equivalences[l].injective q.1.ring.R (C.Spec q.1 -> R.R) (C.evaluation q.1) (sqc q.1 q.2.1) _ _
      (F.funext (C.Spec q.1) (\ y -> R.R) _ _
       (\ y -> trans (zero-at-points j y) (sym (RingHom[l].zero q.1.ring R y.1)))) ;
    result (j : Fin m) : I.Member (gs j) =
     QuotientCertificate[l].Over[R,setR].At[A,n,fs,q].kernel (gs j) (zero-in-quotient j) ;
   } ;
   to-ideal (h : Inclusion) : IdealInclusion = \ j ->
    Tr1.Trunc[Q.Witness A n fs].induction @l (\ t -> I.Member (gs j))
     (\ t -> I.proposition (gs j)) (\ q -> AtQuotient[q,h].result j) (Q.quotient A fp n fs) ;
   equivalence : Pr.Equiv Inclusion IdealInclusion =
    (to-ideal,Pr.qinv Inclusion IdealInclusion to-ideal from-ideal
     (\ h -> F.isProp-Pi (Fin m) (\ j -> I.Member (gs j)) (\ j -> I.proposition (gs j)) _ h)
     (\ h -> F.isProp-Pi (C.Spec A) (\ x -> V x -> W x)
      (\ x -> F.isProp-Pi (V x) (\ v -> W x) (\ v -> CP.zeros-prop m (\ i -> x.1.1 (gs i)))) _ h)) ;
  } ;
 } ;
} ;
