-- Gamma is closed under sums (gabber-recollement, Theorem main).  Setting of
-- GOODOPENS.  Let s, s' be in Gamma, with good modules M on D(s), M' on
-- D(s'), and t = s + s'.  Work over A' = L_t, with p = p_t : Spec A' ~ D(t),
-- the gerbes G (p x) and Lambda (p x).
--  (comaximal)  a = s/1 and b = s'/1 are comaximal in A': with v the
--     inverse of t/1, a v + b v = v (a + b) = v (t/1) = 1.
--  (opens)  A point x of D(a) in Spec A' gives the point (p x, x(a)) of
--     D(s) (x(a) = (p x)(s) by definition); V z = M (p z.1, z.2) on D(a),
--     with the bases of M.  Likewise W on D(b) from M'.
--  (good)  On Spec L_a (L_a a localisation of A' at a) the family
--     y |-> P(V)^v at p_a y is y |-> dual (pi y) M(pi y) with
--     pi y = (p (p_a y), ..); A -> A' -> L_a sends s to a unit, so
--     L_s -> L_a (GOODOPENS.Into), and the points agree (ALGEBRAS.ext), so
--     GOODOPENS.Restrict gives goodness.  Likewise for W.
--  (step)  CHEAPCORRECT.Step gives merely a good module on Spec A'
--     (GOODMODULES), and GOODOPENS.Transfer one on D(t).  The localisations
--     L_t, L_a, L_b, L_ab exist merely, and the goal is a proposition.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC1 = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module AI = AffineInterface[l].Over[R,setR] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module At (A : C.Algebra) (fp : P.FP A) (G : C.Spec A -> TM.GB.AGerbe)
  (n0 : Nat) (Lambda : TM.Family[C.Spec A,G].Weighted (\ c -> TM.UG.power c (suc n0)))
  (bl : (x : C.Spec A) (g : (G x).1) -> Tr.Trunc[LF.Basis[Lambda.1 x g,suc zero]].carrier) {
  module GO = GoodOpens[l].Over[R,setR,axioms].At[A,fp,G,n0,Lambda,bl] ;
  module Sum (s s' : A.ring.R) (M : GO.On[s].Good) (M' : GO.On[s'].Good)
   (lt : AI.LocalizationWitness A (A.ring.add s s')) {
   module OT = GO.On[A.ring.add s s'] ;
   A' : C.Algebra = lt.1 ;
   inc : C.Hom A A' = lt.2.2.1 ;
   p (x : C.Spec A') : AI.D A (A.ring.add s s') = OT.point lt x ;
   bl' (x : C.Spec A') (g : (OT.gerbe lt x).1) : Tr.Trunc[LF.Basis[(OT.lam lt).1 x g,suc zero]].carrier = bl (p x).1 g ;
   a : A'.ring.R = inc.1.1 s ;
   b : A'.ring.R = inc.1.1 s' ;
   -- (comaximal)
   v : A'.ring.R = lt.2.2.2.1.1 ;
   comaximal : Comaximal[l].Over[A'.ring].Comaximal a b = (v,v,calc A'.ring.R {
    A'.ring.add (A'.ring.mul a v) (A'.ring.mul b v)
     =< cong2 A'.ring.R A'.ring.add _ _ _ _ (A'.ring.mulC a v) (A'.ring.mulC b v) >
        A'.ring.add (A'.ring.mul v a) (A'.ring.mul v b)
     =< sym (A'.ring.dist v a b) > A'.ring.mul v (A'.ring.add a b)
     =< ap (A'.ring.mul v) (sym (inc.1.2.2.1 s s')) > A'.ring.mul v (inc.1.1 (A.ring.add s s'))
     =< A'.ring.mulC v (inc.1.1 (A.ring.add s s')) > A'.ring.mul (inc.1.1 (A.ring.add s s')) v
     =< lt.2.2.2.1.2 > A'.ring.o }) ;
   module Wit (la : AI.LocalizationWitness A' a) (lb : AI.LocalizationWitness A' b)
    (lab : AI.LocalizationWitness A' (A'.ring.mul a b)) {
    module CC = CheapCorrect[l].Over[R,setR,axioms,loc].At[A',lt.2.1,OT.gerbe lt,a,b,
     Tr.Trunc[Comaximal[l].Over[A'.ring].Comaximal a b].inc comaximal,la,lb,lab,n0,OT.lam lt,bl'] ;
    -- (opens)
    lift-a (z : CC.CG.GD.Sa) : AI.D A s = ((p z.1).1,z.2) ;
    lift-b (z : CC.CG.GD.Sb) : AI.D A s' = ((p z.1).1,z.2) ;
    V : CC.CG.GD.FA.Twisted = (\ z g -> M.family.1 (lift-a z) g,\ z -> M.family.2 (lift-a z)) ;
    W : CC.CG.GD.FB.Twisted = (\ z g -> M'.family.1 (lift-b z) g,\ z -> M'.family.2 (lift-b z)) ;
    -- (good)
    pa (y : C.Spec la.1) : AI.D A s = lift-a (CC.CG.SA.pf y) ;
    pb (y : C.Spec lb.1) : AI.D A s' = lift-b (CC.CG.SB.pf y) ;
    module IA = GO.Into[s,M.witness,la.1,C.compose A A' la.1 la.2.2.1 inc,la.2.2.2.1] ;
    module IB = GO.Into[s',M'.witness,lb.1,C.compose A A' lb.1 lb.2.2.1 inc,lb.2.2.2.1] ;
    same-a (y : C.Spec la.1) : Id (AI.D A s) (GO.On[s].point M.witness (C.compose M.witness.1 la.1 C.base y IA.map)) (pa y) =
     Pr.Sigma-eq (C.Spec A) (\ x -> RL[R].unit (x.1.1 s)) _ (pa y).1 _ (pa y).2
      (C.ext A C.base _ (pa y).1 (\ r -> ap y.1.1 (IA.beta r))) (RR.unit-prop ((pa y).1.1.1 s)) ;
    same-b (y : C.Spec lb.1) : Id (AI.D A s') (GO.On[s'].point M'.witness (C.compose M'.witness.1 lb.1 C.base y IB.map)) (pb y) =
     Pr.Sigma-eq (C.Spec A) (\ x -> RL[R].unit (x.1.1 s')) _ (pb y).1 _ (pb y).2
      (C.ext A C.base _ (pb y).1 (\ r -> ap y.1.1 (IB.beta r))) (RR.unit-prop ((pb y).1.1.1 s')) ;
    gV : CC.CG.SA.CF.Good (CC.CG.SA.on-lf V) M.power0 = GO.On[s].Restrict[M,la.1,la.2.1,pa,IA.map,same-a].theorem ;
    gW : CC.CG.SB.CF.Good (CC.CG.SB.on-lf W) M'.power0 = GO.On[s'].Restrict[M',lb.1,lb.2.1,pb,IB.map,same-b].theorem ;
    -- (step)
    module GM = GoodModules[l].Over[R,setR,axioms].At[A',lt.2.1,OT.gerbe lt,n0,OT.lam lt] ;
    result : OT.Gamma =
     TC1.map GM.GoodModule OT.Good (\ N -> OT.Transfer[lt,N].result)
      CC.Step[V,W,M.rank0,M'.rank0,\ z g -> M.bases (lift-a z) g,\ z g -> M'.bases (lift-b z) g,
       M.power0,M'.power0,M.power-eq,M'.power-eq,gV,gW].theorem ;
   } ;
   result : OT.Gamma =
    TC1.bind (AI.LocalizationWitness A' a) OT.Good (\ la ->
     TC1.bind (AI.LocalizationWitness A' b) OT.Good (\ lb ->
      TC1.bind (AI.LocalizationWitness A' (A'.ring.mul a b)) OT.Good (\ lab -> Wit[la,lb,lab].result)
       (AI.localize A' lt.2.1 (A'.ring.mul a b)))
      (AI.localize A' lt.2.1 b))
     (AI.localize A' lt.2.1 a) ;
  } ;
  sum (s s' : A.ring.R) (gs : GO.On[s].Gamma) (gs' : GO.On[s'].Gamma) : GO.On[A.ring.add s s'].Gamma =
   TC1.bind GO.On[s].Good GO.On[A.ring.add s s'].Good (\ M ->
    TC1.bind GO.On[s'].Good GO.On[A.ring.add s s'].Good (\ M' ->
     TC1.bind (AI.LocalizationWitness A (A.ring.add s s')) GO.On[A.ring.add s s'].Good (\ lt -> Sum[s,s',M,M',lt].result)
      (AI.localize A fp (A.ring.add s s'))) gs') gs ;
 } ;
} ;
