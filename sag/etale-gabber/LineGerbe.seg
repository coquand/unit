-- The stack gerbe of line families (C3, step C1 of the handoff: size and
-- descent).  C a charged type (BANDCHANGE.Char), Obj its line families of
-- weight w (BANDCHANGE.At), pt : X -> Obj an object at each point.
--  (lines)   Line = modules with a mere basis of rank 1 (U l+).  Its paths
--            are the linear bijections (SIPGENERIC.Fundamental: the total space
--            is that of MODULESIP2 with a proposition added), so Line is
--            locally small, and every line is merely R^1 (a basis gives
--            M = R^1, DESCENTLINEAR.frame-equality).  Replacement: the image
--            LineS : U l of 1 -> Line, j : LineS ~ Line.
--  (cover)   ObjS = (V : X -> LineS) * WeightBy w (j . V) is small, and
--            e : ObjS -> Obj, (V, w) |-> (j . V, w, bases), is split onto:
--            V' g = j^-1 (V g) and the weight moved along j j^-1 = id.
--  (stack)   Descent for objects.  f : G_i -> Obj over a generator (a
--            proposition) glues to V x = Pi (g : G_i) (f g) x.  Transport in a
--            Pi family is pointwise (J), so V has weight w; V x has a basis
--            locally (evaluation at g is a linear bijection onto (f g) x, G_i
--            being a proposition), hence merely (DESCENTTHEOREMD, V x a sheaf as
--            a product of lines); evaluation is an isomorphism glued -> f g.  A
--            constant family glues to o: m |-> (g |-> m) is an equivalence,
--            o x being a sheaf (BANDCHANGEGERBE.line-modal).
-- With BANDCHANGE (paths = isomorphisms, band R^x) and BANDCHANGEGERBE
-- (isomorphisms: a sheaf, merely inhabited) this gives the data of
-- GERBEMAPS.Shrink: the StackGerbe gerbe on the small model of Obj.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module SG1 = SipGeneric[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) (loc : StandardOpens[l].Over[R,setR].Locality)
 (sh : SheafClosure[l,l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ;
 module MS = ModuleSIP2[l].Over[MD.ring] ;
 module LF = LocalFree[l].Over[R,setR,axioms] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module BF = BasisFrames[l].Over[R,setR,axioms] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module TM = TwistedModules[l].Over[R,setR] ;
 module UG = TM.UG ;
 module BC = BandChange[l].Over[R,setR,axioms,sh] ;
 module BCG = BandChangeGerbe[l].Over[R,setR,axioms,loc,sh] ;
 module GM = GerbeMaps[l].Over[R,setR,axioms,sh] ;
 module SG = GM.SG ;
 module RP = Replacement[l,l+] ;
 Basis1 (M : MD.Module) : U l = Tr.Trunc[LF.Basis[M,suc zero]].carrier ;
 -- (lines)
 module Lines {
  Line : U l+ = (M : MD.Module) * Basis1 M ;
  LIso (a b : Line) : U l = BC.Bij a.1 b.1 ;
  total-contr (a : Line) : FunExtUA[l+].isContr ((b : Line) * LIso a b) =
   SG1.ctr-retract ((w : (M : MD.Module) * BC.Bij a.1 M) * Basis1 w.1) ((b : Line) * LIso a b)
    (SG1.ctr-sub ((M : MD.Module) * BC.Bij a.1 M) (\ w -> Basis1 w.1) (BC.bij-contr a.1)
      (\ w -> Tr.Trunc[LF.Basis[w.1,suc zero]].proposition) (a.1,BC.identity a.1) a.2)
    (\ c -> ((c.1.1,c.2),c.1.2)) (\ d -> ((d.1.1,d.2),d.1.2)) (\ c -> refl c) ;
  module Fd = SipGeneric[l].Fundamental[Line,LIso,\ a -> BC.identity a.1,total-contr] ;
  locally-small : RP.LocallySmall Line = \ a b ->
   (LIso a b,Fd.sip a b,Hi.qinv (LIso a b) (Id Line a b) (Fd.sip a b) (Fd.idToIso a b) (Fd.sip-idToIso a b) (Fd.idToIso-sip a b)) ;
  module ST = SplitSmall[l].Over[R,setR,axioms].Standard[suc zero] ;
  standard : Line = (ST.V,Tr.Trunc[LF.Basis[ST.V,suc zero]].inc ST.basis) ;
  image : RP.Image[Top,Line,\ t -> standard] = images @l @(l+) Top Line locally-small (\ t -> standard) ;
  LineS : U l = image.carrier ;
  j (a : LineS) : Line = image.inclusion a ;
  emb (a b : LineS) : Hi.isEquiv (Id LineS a b) (Id Line (j a) (j b)) (Hi.ap LineS Line j a b) = image.embedding a b ;
  Fib (a : Line) : U l+ = (s : LineS) * Id Line (j s) a ;
  fib-prop (a : Line) : Hi.isProp (Fib a) = Groupoid[l+].emb-fib-prop LineS Line j emb a ;
  based (a : Line) (b : LF.Basis[a.1,suc zero]) : Id Line standard a =
   Hi.Sigma-eq MD.Module (\ M -> Basis1 M) ST.V a.1 _ a.2
    (Hi.sym MD.Module a.1 ST.V (DL.On[a.1].frame-equality (suc zero) BF.At[a.1,suc zero].Of[b].frame))
    (Tr.Trunc[LF.Basis[a.1,suc zero]].proposition) ;
  fib (a : Line) : Fib a =
   Tr.Trunc[LF.Basis[a.1,suc zero]].induction @(l+) (\ t -> Fib a) (\ t -> fib-prop a)
    (\ b -> (image.quotient tt,Hi.trans Line (j (image.quotient tt)) standard a (image.triangle tt) (based a b))) a.2 ;
  inv (a : Line) : LineS = (fib a).1 ;
  j-inv (a : Line) : Id Line (j (inv a)) a = (fib a).2 ;
  module' (s : LineS) : MD.Module = (j s).1 ;
 } ;
 open Lines ;
 -- a product of modules over a generator: evaluation is a linear bijection
 module PiGlue (i : ET.I) (fib : ET.G i -> MD.Module) {
  P : U l = ET.G i ;
  prop : Pr.isProp P = ET.G-prop i ;
  M : MD.Module = MD.pi P fib ;
  along (g g' : P) (p : Id P g g') (y : (fib g).M) : (fib g').M = Pr.subst P (\ h -> (fib h).M) g g' p y ;
  along-section (m : M.M) (g g' : P) (p : Id P g g') : Id (fib g').M (along g g' p (m g)) (m g') =
   idJ P g (\ h q -> Id (fib h).M (along g h q (m g)) (m h)) (refl (m g)) g' p ;
  along-self (g : P) (y : (fib g).M) : Id (fib g).M (along g g (prop g g) y) y =
   ap (\ q -> along g g q y) (Pr.prop-to-set P prop g g (prop g g) (refl g)) ;
  ev (g : P) (m : M.M) : (fib g).M = m g ;
  spread (g : P) (y : (fib g).M) : M.M = \ h -> along g h (prop g h) y ;
  ev-equiv (g : P) : Pr.isEquiv M.M (fib g).M (ev g) =
   Pr.qinv M.M (fib g).M (ev g) (spread g) (along-self g)
    (\ m -> F.funext P (\ h -> (fib h).M) _ m (\ h -> along-section m g h (prop g h))) ;
  ev-bij (g : P) : BC.Bij M (fib g) =
   ((ev g,\ x y -> refl ((fib g).madd (x g) (y g)),\ a x -> refl ((fib g).sm a (x g))),ev-equiv g) ;
  -- rank one: locally that of fib g, hence merely (Theorem D)
  module Rank (sheaf : (g : P) -> ET.T.isModal @l (fib g).M) (bases : (g : P) -> Basis1 (fib g)) {
   M-sheaf : ET.T.isModal @l M.M = SL.modal-Pi P (\ g -> (fib g).M) sheaf ;
   near-basis (g : P) : Basis1 M =
    Tr.Trunc[LF.Basis[fib g,suc zero]].induction @l (\ t -> Basis1 M) (\ t -> Tr.Trunc[LF.Basis[M,suc zero]].proposition)
     (\ b -> Tr.Trunc[LF.Basis[M,suc zero]].inc
       (StandardBases[l].Over[R,setR,axioms].move (fib g) M (Hi.sym MD.Module M (fib g) (MS.sip M (fib g) ((ev g,ev-equiv g),\ x y -> refl ((fib g).madd (x g) (y g)),\ a x -> refl ((fib g).sm a (x g))))) (suc zero) b))
     (bases g) ;
   local-frame : sh.close (DL.On[M].Frame (suc zero)) =
    ((sh.modal (DL.On[M].Frame (suc zero))) i).sec (\ g0 ->
     Tr.Trunc[LF.Basis[M,suc zero]].induction @l (\ t -> sh.close (DL.On[M].Frame (suc zero))) (\ t -> sh.proposition (DL.On[M].Frame (suc zero)))
      (\ b -> sh.inc (DL.On[M].Frame (suc zero)) BF.At[M,suc zero].Of[b].frame) (near-basis g0)) ;
   basis : Basis1 M =
    Tr.Trunc[DL.On[M].Frame (suc zero)].induction @l (\ t -> Basis1 M) (\ t -> Tr.Trunc[LF.Basis[M,suc zero]].proposition)
     (\ w -> Tr.Trunc[LF.Basis[M,suc zero]].inc BF.At[M,suc zero].OfFrame[w].basis)
     DescentTheoremD[l].Over[R,setR,axioms,sh].At[M,M-sheaf,suc zero,local-frame].theorem ;
  } ;
 } ;
 module At (C : BC.Char) (pt : C.1.1 -> BC.At[C].Obj) {
  module B = BC.At[C] ;
  module BG = BCG.At[C] ;
  X : U l = B.X ;
  module T = B.T ;
  -- (stack)
  module Glue (i : ET.I) (f : ET.G i -> B.Obj) {
   P : U l = ET.G i ;
   V (x : X) : MD.Module = PiGlue[i,\ g -> (f g).1 x].M ;
   -- transport in V is pointwise
   move-pi (y y' : X) (p : Id X y y') (m : (V y).M) (g : P) :
    Id ((f g).1 y').M (T.Move[V].move y y' p m g) (T.Move[(f g).1].move y y' p (m g)) =
    idJ X y (\ z q -> Id ((f g).1 z).M (T.Move[V].move y z q m g) (T.Move[(f g).1].move y z q (m g))) (refl (m g)) y' p ;
   weight : T.WeightBy T.bnd V = \ y p m ->
    F.funext P (\ g -> ((f g).1 y).M) _ _ (\ g -> trans (move-pi y y p m g) ((f g).2.1 y p (m g))) ;
   bases (x : X) : Basis1 (V x) =
    PiGlue[i,\ g -> (f g).1 x].Rank[\ g -> BCG.line-modal ((f g).1 x) ((f g).2.2 x),\ g -> (f g).2.2 x].basis ;
   glued : B.Obj = (V,weight,bases) ;
   restrict (g : P) : B.Iso glued (f g) = \ x -> PiGlue[i,\ g2 -> (f g2).1 x].ev-bij g ;
   restricts : Id (P -> B.Obj) (\ g -> glued) f =
    F1.funext P (\ g -> B.Obj) (\ g -> glued) f (\ g -> B.Fd.sip glued (f g) (restrict g)) ;
  } ;
  module Constant (i : ET.I) (o : B.Obj) {
   module Gl = Glue[i,\ g -> o] ;
   const-iso : B.Iso o Gl.glued = \ x ->
    ((\ m g -> m,\ m m' -> refl (\ g -> (o.1 x).madd m m'),\ a m -> refl (\ g -> (o.1 x).sm a m)),
     BCG.line-modal (o.1 x) (o.2.2 x) i) ;
   back : Id B.Obj Gl.glued o = Hi.sym B.Obj o Gl.glued (B.Fd.sip o Gl.glued const-iso) ;
  } ;
  stack : ET.T.isModal @(l+) B.Obj = \ i ->
   Hi.qinv B.Obj (ET.G i -> B.Obj) (\ o g -> o) (\ f -> Glue[i,f].glued) (\ f -> Glue[i,f].restricts) (\ o -> Constant[i,o].back) ;
  -- (cover)
  ObjS : U l = (V : X -> LineS) * T.WeightBy T.bnd (\ g -> module' (V g)) ;
  e (c : ObjS) : B.Obj = (\ g -> module' (c.1 g),c.2,\ g -> (j (c.1 g)).2) ;
  module Onto (o : B.Obj) {
   V' (g : X) : LineS = inv (o.1 g,o.2.2 g) ;
   path : Id (X -> MD.Module) (\ g -> module' (V' g)) o.1 =
    F1.funext X (\ g -> MD.Module) (\ g -> module' (V' g)) o.1 (\ g -> Hi.ap Line MD.Module (\ a -> a.1) _ _ (j-inv (o.1 g,o.2.2 g))) ;
   w' : T.WeightBy T.bnd (\ g -> module' (V' g)) =
    Hi.subst (X -> MD.Module) (\ W -> T.WeightBy T.bnd W) o.1 (\ g -> module' (V' g)) (Hi.sym (X -> MD.Module) (\ g -> module' (V' g)) o.1 path) o.2.1 ;
   onto : (c : ObjS) * Id B.Obj (e c) o =
    ((V',w'),Hi.Sigma-eq (X -> MD.Module) (\ W -> B.Props W) (\ g -> module' (V' g)) o.1 (e (V',w')).2 o.2 path (B.props-prop o.1)) ;
  } ;
  inh : sh.close ObjS =
   sh.elim @l X (sh.close ObjS) (sh.proposition ObjS) (sh.modal ObjS) (\ s -> sh.inc ObjS (Onto[pt s].onto).1) C.2 ;
  module S = GM.Shrink[B.Obj,B.Iso,B.Fd.idToIso,B.Fd.sip,B.Fd.sip-idToIso,B.Fd.idToIso-sip,B.iso-set,
   \ L L' -> BG.Isos[L,L'].sheaf,\ L L' -> BG.Isos[L,L'].isos,
   \ L -> B.Loops[L].b,\ L -> B.Loops[L].b-equiv,\ L -> B.Loops[L].hom,stack,ObjS,e,\ o -> Onto[o].onto,inh] ;
  gerbe : SG.StackGerbe = S.gerbe ;
  -- (into) a map h : Z -> Obj whose transports act as scalars wz gives a map
  -- into the small model carrying the loops of Z to wz
  module Into (Z : U l) (h : Z -> B.Obj) (wz : (z : Z) -> Id Z z z -> UG.Unit)
   (law : (z : Z) (p : Id Z z z) (g : X) (m : ((h z).1 g).M) ->
     Id ((h z).1 g).M ((B.Fd.idToIso (h z) (h z) (Hi.ap Z B.Obj h z z p) g).1.1 m) (((h z).1 g).sm (wz z p).1 m)) {
   map (z : Z) : S.Small = S.inv (h z) ;
   large (z : Z) (p : Id Z z z) : Id UG.Unit (B.Loops[h z].b (Hi.ap Z B.Obj h z z p)) (wz z p) =
    UG.eq _ _ (B.Loops[h z].scalar-of (B.Fd.idToIso (h z) (h z) (Hi.ap Z B.Obj h z z p)) (wz z p).1 (law z p)) ;
   preserves (z : Z) (p : Id Z z z) : Id UG.Unit (S.bnd (map z) (Pr.ap Z S.Small map z z p)) (wz z p) =
    trans (ap (S.bnd (map z)) (GM.ap-comp Z B.Obj S.Small h S.inv z z p))
     (trans (S.inv-bnd (h z) (Hi.ap Z B.Obj h z z p)) (large z p)) ;
  } ;
 } ;
} ;
