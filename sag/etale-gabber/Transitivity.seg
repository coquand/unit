-- SAG 4.2.8 (affine case), 4.2.9 and 4.2.11.
-- 4.2.8: on Spec A, an open subtype of an open subtype is open.  By 4.2.7,
-- S = D(f_1,..,f_n); on each D(f_j) = Spec A_{f_j} the inner subtype is
-- open, hence affine-open (4.2.7 again); gluing (3.1.7) gives the result.
-- 4.2.9(a) is the case A = R; 4.2.9(b) follows pointwise for any type X,
-- and in particular gives 4.2.8 for schemes.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module O = StandardOpens[l].Over[R,setR] ;
 module OT = OpenTransitivity[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 module OA = OpenAffine[l].Over[R,setR,axioms] ;
 module U3 = Units23[l].Over[R,setR,axioms.sqc,axioms.loc] ;
 Sum (X : U l) (S : X -> U l) (T : (x : X) -> S x -> U l) (x : X) : U l = (s : S x) * T x s ;
 -- 4.2.8 for X = Spec A
 module Affine (A : C.Algebra) (fp : P.FP A) (S : C.Spec A -> U l) (oS : OP.OpenSubtype (C.Spec A) S)
  (T : (a : C.Spec A) -> S a -> U l) (oT : (a : C.Spec A) (s : S a) -> OP.Open (T a s)) {
  V : C.Spec A -> U l = Sum (C.Spec A) S T ;
  propS (a : C.Spec A) : Pr.isProp (S a) = OP.open-prop (S a) (oS a) ;
  propV (a : C.Spec A) : Pr.isProp (V a) =
   Pr.isProp-Sigma (S a) (T a) (propS a) (\ s -> OP.open-prop (T a s) (oT a s)) ;
  module With (w : OT.OpenWitness A S) {
   n : Nat = w.1 ;
   fs : Fin n -> A.ring.R = w.2.1 ;
   cov (a : C.Spec A) (v : V a) : O.Union A n fs a = (w.2.2 a).1 v.1 ;
   module Local (j : Fin n) (loc : I.LocalizationWitness A (fs j)) {
    module Tl = OT.Localized[A,fp,fs j,loc] ;
    inside (x : C.Spec loc.1) : S (Tl.restrict x) =
     (w.2.2 (Tl.restrict x)).2 (Tr.Trunc[(i : Fin n) * RL[R].unit ((Tl.restrict x).1.1 (fs i))].inc
      (j,AffineRing[l].unit-map loc.1.ring R x.1 (loc.2.2.1.1.1 (fs j)) loc.2.2.2.1)) ;
    reduce (x : C.Spec loc.1) : Pr.Equiv (V (Tl.restrict x)) (T (Tl.restrict x) (inside x)) =
     (\ v -> subst (T (Tl.restrict x)) (propS (Tl.restrict x) v.1 (inside x)) v.2,
      Pr.qinv (V (Tl.restrict x)) (T (Tl.restrict x) (inside x))
       (\ v -> subst (T (Tl.restrict x)) (propS (Tl.restrict x) v.1 (inside x)) v.2)
       (\ t -> (inside x,t))
       (\ t -> OP.open-prop (T (Tl.restrict x) (inside x)) (oT (Tl.restrict x) (inside x)) _ t)
       (\ v -> propV (Tl.restrict x) _ v)) ;
    open-L : OP.OpenSubtype (C.Spec loc.1) (\ x -> V (Tl.restrict x)) = \ x ->
     OP.along (V (Tl.restrict x)) (T (Tl.restrict x) (inside x)) (reduce x) (oT (Tl.restrict x) (inside x)) ;
    affine : OT.AffineOpen loc.1 (\ x -> V (Tl.restrict x)) =
     OA.At[loc.1,loc.2.1,\ x -> V (Tl.restrict x),open-L].theorem ;
   } ;
   result : OT.AffineOpen A V = OA.Glue[A,fp,V,propV,n,fs,cov,\ j loc -> Local[j,loc].affine].result ;
  } ;
  affine-open : OT.AffineOpen A V =
   Tr.Trunc[OT.OpenWitness A S].induction @l (\ t -> OT.AffineOpen A V)
    (\ t -> Tr.Trunc[OT.OpenWitness A V].proposition) (\ w -> With[w].result)
    (OA.At[A,fp,S,oS].theorem) ;
  theorem : OP.OpenSubtype (C.Spec A) V = OA.affine-open-open A V propV affine-open ;
 } ;
 -- 4.2.9(a): open propositions are closed under dependent sums
 sigma (Pp : U l) (op : OP.Open Pp) (Q : Pp -> U l) (oq : (p : Pp) -> OP.Open (Q p)) : OP.Open ((p : Pp) * Q p) =
  Affine[C.base,BasePresentation[l].Over[R,setR].finitely-presented,\ a -> Pp,\ a -> op,
   \ a p -> Q p,\ a p -> oq p].theorem (C.identity C.base) ;
 -- 4.2.9(b): an open subtype of an open subtype of any type X is open in X
 transitivity (X : U l) (S : X -> U l) (oS : OP.OpenSubtype X S)
  (T : (x : X) -> S x -> U l) (oT : (x : X) (s : S x) -> OP.Open (T x s)) : OP.OpenSubtype X (Sum X S T) =
  \ x -> sigma (S x) (oS x) (T x) (oT x) ;
 ------------------------------------------------------------------
 -- 4.2.11: for P closed and Q open, (P -> Q) iff (not P or Q)
 module Implication (Pp Q : U l) (cp : CP.Closed Pp) (oq : OP.Open Q) {
  Goal : U l = OO.Or (Pp -> Empty) Q ;
  goal-prop : Pr.isProp Goal = Tr.Trunc[Plus (Pp -> Empty) Q].proposition ;
  module W (wp : CP.Witness Pp) (wq : OP.Witness Q) {
   n : Nat = wp.1 ; xs : Fin n -> R.R = wp.2.1 ;
   m : Nat = wq.1 ; ys : Fin m -> R.R = wq.2.1 ;
   module Ap = OO.Append[n,xs,m,ys] ;
   both (z : CP.Zeros (plus m n) Ap.zs) : CP.Zeros n xs * CP.Zeros m ys =
    (\ i -> trans (sym (FinSum[l].cases-left n R.R xs m ys i)) (z (FinSum[l].left n m i)),
     \ j -> trans (sym (FinSum[l].cases-right n R.R xs m ys j)) (z (FinSum[l].right n m j))) ;
   to-goal : Plus (OP.Units n xs) (OP.Units m ys) -> Goal = split {
    inl u -> Tr.Trunc[Plus (Pp -> Empty) Q].inc (inl (\ p -> (U3.nonzero-iff-some-unit n xs).2 u (wp.2.2.1 p))) ;
    inr u -> Tr.Trunc[Plus (Pp -> Empty) Q].inc (inr (wq.2.2.2.sec u)) } ;
   forward (h : Pp -> Q) : Goal =
    Tr.Trunc[Plus (OP.Units n xs) (OP.Units m ys)].induction @l (\ t -> Goal) (\ t -> goal-prop) to-goal
     (Ap.to ((U3.nonzero-iff-some-unit (plus m n) Ap.zs).1 (\ z ->
      (U3.nonzero-iff-some-unit m ys).2 (wq.2.2.1 (h (wp.2.2.2.sec (both z).1))) (both z).2))) ;
  } ;
  from-plus (p : Pp) : Plus (Pp -> Empty) Q -> Q = split { inl np -> efq (np p) ; inr q -> q } ;
  backward (g : Goal) (p : Pp) : Q =
   Tr.Trunc[Plus (Pp -> Empty) Q].induction @l (\ t -> Q) (\ t -> OP.open-prop Q oq) (from-plus p) g ;
  forward (h : Pp -> Q) : Goal =
   Tr.Trunc[CP.Witness Pp].induction @l (\ t -> Goal) (\ t -> goal-prop) (\ wp ->
    Tr.Trunc[OP.Witness Q].induction @l (\ t -> Goal) (\ t -> goal-prop) (\ wq -> W[wp,wq].forward h) oq) cp ;
  theorem : OpenProp[l].Iff (Pp -> Q) Goal = (forward,backward) ;
 } ;
} ;
