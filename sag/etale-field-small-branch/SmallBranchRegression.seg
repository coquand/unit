-- Run the actual coefficient-field, finite-image, selected-field and
-- primitive-element constructions in F2 x F2. A separate corner test
-- has a polynomial root only after multiplying by e, so dropping that
-- factor is detected concretely.
level l ; open Ring[l] ; open Presentations[l] ;
module P = PrimitiveRegression[l] ; module Previous = FiniteSubalgebraRegression[l] ;
module H = RingHom[l] ;
module Branch = SmallFieldBranch[l].Over[P.k,P.B.bool-set].At[P.S,P.input].Coefficients[
 zero,\ i -> efq i,Previous.K0].Given[P.reduced,Previous.lower,Previous.root] ;
constructed : P.Statement.Result P.input = Branch.result ;
module At (r : Branch.Choice.F.PF.Result) {
 module C = Branch.Chosen[r] ;
 selected : P.Statement.Selected[P.two,P.basis,P.q] = C.result ;
 outside : Not (P.q.ideal.In selected.idempotent) = selected.outside ;
 root : Id P.Pair (P.A.mul selected.idempotent (P.Statement.value selected.generator
  (SelectedFactorStatement[l].Over[P.k,P.B.bool-set].monic selected.lower))) P.z = selected.root ;
 basis0 : Id P.Pair (P.A.mul selected.idempotent (P.A.add (P.vector P.i0)
  (P.A.neg (P.Statement.value selected.generator (selected.representation P.i0))))) P.z = selected.generates P.i0 ;
 basis1 : Id P.Pair (P.A.mul selected.idempotent (P.A.add (P.vector P.i1)
  (P.A.neg (P.Statement.value selected.generator (selected.representation P.i1))))) P.z = selected.generates P.i1 ;
} ;
e : P.Pair = (true,false) ;
j (a : P.k.R) : P.Pair = (a,false) ;
add-image (a b : P.k.R) : Id P.Pair (j (P.k.add a b)) (P.A.add (j a) (j b)) = refl (P.k.add a b,false) ;
mul-image (a b : P.k.R) : Id P.Pair (j (P.k.mul a b)) (P.A.mul (j a) (j b)) = refl (P.k.mul a b,false) ;
constants (a : P.k.R) : Id P.Pair (j a) (P.A.mul e (P.iota.1 a)) = refl (a,false) ;
module Corner = CornerHorner[l].Over[P.k,P.k,P.k,P.A,P.B.bool-set,P.setA,
 H.identity P.k,H.identity P.k,P.iota,j,e,refl P.z,add-image,mul-image,refl e,constants] ;
module V = Corner.At[true] ; module Monic = V.Monic[cons true nil] ;
unit-image-is-corner : Id P.Pair (j true) e = refl e ;
not-unital : Not (Id P.Pair (j true) P.o) = \ h -> P.nonzero (sym (ap (\ a -> a.2) h)) ;
ambient-value : Id P.Pair (P.Statement.value e (cons true (cons true nil))) (false,true) = refl (false,true) ;
not-global-root : Not (Id P.Pair (P.Statement.value e (cons true (cons true nil))) P.z) =
 \ h -> P.nonzero (ap (\ a -> a.2) h) ;
corner-root : Id P.Pair (P.A.mul e (P.Statement.value e (cons true (cons true nil)))) P.z = Monic.root (refl false) ;
corner-separable : Id P.Pair (P.A.mul e (P.A.add
 (P.A.mul (P.Statement.slope e (cons true (cons true nil))) e) (P.A.neg P.o))) P.z = Monic.separable true (refl true) ;
