-- The complete finite-coefficient-field branch of the selected-factor
-- statement. The required monic equations over the actual finite K0
-- remain explicit inputs. The selected finite field and its primitive
-- element are constructed, then their identities are transported through
-- the nonunital inclusion into the ambient algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ; module St = SelectedFactorStatement[l].Over[k,setk] ;
 module RawMonic = FrobeniusPolynomial[l].Coefficients[k] ;
 monic-agrees : (p : List k.R) -> Id (List k.R) (St.monic p) (RawMonic.monic p) = split {
  nil -> refl (cons k.o nil) ; cons a p | rec -> ap (\ q -> cons a q) rec } ;
 module At (S : C.Algebra) (input : St.At[S].Input) {
  module Target = St.At[S] ;
  module Coefficients (t : Nat) (coefficients : Fin t -> k.R)
   (K0 : FiniteCoefficientField[l].Over[k,setk,input.field.decide,input.field.nonzero,t,coefficients].Subfield) {
   module ImageInput = CoefficientSubalgebra[l].Over[k,setk,input.field,t,coefficients,K0].At[S,input.rank,input.basis] ;
   module Given
    (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
    (lower : Fin input.rank -> List K0.ring.R)
    (roots : IteratedMonicBasis[l].Over[K0.ring,K0.set].Roots input.rank lower ImageInput.restricted input.basis.vector) {
    module Image = ImageInput.Generators[input.rank,input.basis.vector,lower,roots] ;
    module Choice = Image.Selected[reduced,input.prime] ;
    module Chosen (r : Choice.F.PF.Result) {
     module F = Choice.F.Chosen[r] ;
     module Primitive = FiniteFieldPrimitive[l].Over[K0.ring,F.field,F.set,F.coefficient-map,F.field-decide,F.field-nonzero] ;
     onto (a : F.field.R) : Tr.Trunc[(i : Fin F.size) * Id F.field.R (F.enumeration i) a].carrier =
      Tr.Trunc[(i : Fin F.size) * Id F.field.R (F.enumeration i) a].inc (F.covers a) ;
     primitive : Primitive.Data = Primitive.theorem F.size F.enumeration F.enumeration-injective onto ;
     zero-image : Id S.ring.R (F.to-ambient F.field.z) S.ring.z = refl S.ring.z ;
     coefficient-image (a : K0.ring.R) :
      Id S.ring.R (F.to-ambient (F.coefficient-map.1 a)) (S.ring.mul F.idempotent (S.iota.1 (K0.inclusion.1 a))) =
       refl (S.ring.mul F.idempotent (S.iota.1 (K0.inclusion.1 a))) ;
     module Corner = CornerHorner[l].Over[K0.ring,k,F.field,S.ring,F.set,S.set,K0.inclusion,F.coefficient-map,S.iota,
      F.to-ambient,F.idempotent,zero-image,F.add-image,F.mul-image,F.unit-image,coefficient-image] ;
     module Value = Corner.At[primitive.gamma] ; module Monic = Value.Monic[primitive.lower] ;
     generator : S.ring.R = F.to-ambient primitive.gamma ;
     representation (i : Fin input.rank) : List k.R = Corner.map (primitive.representation (F.generator i)).1 ;
     generates (i : Fin input.rank) : Id S.ring.R
      (S.ring.mul F.idempotent (S.ring.add (input.basis.vector i) (S.ring.neg (Target.value generator (representation i))))) S.ring.z =
       Value.represents (input.basis.vector i) (F.generator i) (F.generator-image i)
        (primitive.representation (F.generator i)).1 (primitive.representation (F.generator i)).2 ;
     inverse : S.ring.R = F.to-ambient (F.field.neg F.field.o) ;
     root : Id S.ring.R (S.ring.mul F.idempotent (Target.value generator (St.monic Monic.lower))) S.ring.z =
      trans (ap (\ p -> S.ring.mul F.idempotent (Target.value generator p)) (monic-agrees Monic.lower)) (Monic.root primitive.root) ;
     separable : Id S.ring.R
      (S.ring.mul F.idempotent (S.ring.add (S.ring.mul (Target.slope generator (St.monic Monic.lower)) inverse) (S.ring.neg S.ring.o))) S.ring.z =
       trans (ap (\ p -> S.ring.mul F.idempotent (S.ring.add (S.ring.mul (Target.slope generator p) inverse) (S.ring.neg S.ring.o)))
        (monic-agrees Monic.lower)) (Monic.separable (F.field.neg F.field.o) primitive.slope-unit) ;
     result : Target.Selected[input.rank,input.basis,input.prime] =
      new Target.Selected[input.rank,input.basis,input.prime,F.idempotent,F.square,F.outside,generator,Monic.lower,
       root,inverse,separable,representation,generates] ;
    } ;
    result : Target.Result input = TC.rec Choice.F.PF.Result @l (Target.Result input)
     Tr.Trunc[Target.Selected[input.rank,input.basis,input.prime]].proposition
     (\ r -> Tr.Trunc[Target.Selected[input.rank,input.basis,input.prime]].inc Chosen[r].result) Choice.theorem ;
   } ;
  } ;
 } ;
} ;
