-- Homogeneous pieces and the top line (cffru, step 2, E5).
-- The exterior algebra is a module (alg-mod); its elements of degree k
-- (ExteriorDegreeM.Deg) form a submodule, the module ∧^k M (Piece), and
-- wedge f restricts to ∧^k M -> ∧^k N (Piece.map).
-- Coordinates (Inverse): with a basis e, to_e : Lam M -> Lam n has the
-- inverse from_e, the extension of v |-> gen (e^-1 v) (both composites are
-- the identity on generators).
-- Top line: if M merely has a basis of n elements, ∧^n M is a line, merely
-- linearly equivalent to R (Top.line; TopBasis for a basis, at a degree k with k = n): x |-> top(to_e x) and
-- c |-> from_e(c omega) are inverse on ∧^n M, by deg-top (x of degree n is
-- top(x) omega) and top(omega) = 1.  That from_e(c omega) has degree n for
-- every basis e' is the preservation argument: to_e' . from_e = Lambda(A),
-- A the matrix of e' . e^-1.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 open ExteriorModel[l].Over[Rg] ;
 module ED = ExteriorDegreeM[l].Over[Rg,setR] ;
 module EF = ED.EF ; module FM = ED.FM ; module FF = ED.FF ; module SM = ED.SM ; module MS = ED.MS ;
 module AL = ED.AL ; module EC = ED.EC ; module DG = ED.DG ; module HO = ED.HO ; module MM = ED.MM ; module MI = ED.MI ;
 module UP = ExteriorUniversal[l].Over[Rg,setR] ;
 module A7 = Alg73[l] ;
 -- an algebra as a module
 alg-mod (A : EF.S.Alg) : FM.Module = new A7.Mod[FM.MO.ring,A.A,A.set,A.zero,A.add,A.neg,A.addA,A.addC,A.addZ,A.addN,
  A.scale,A.scale-scale,A.scale-one,A.scale-add,A.add-scale] ;
 hom-lin (E A : EF.S.Alg) (f : AL.AlgHom E A) : SM.Linear (alg-mod E) (alg-mod A) = (f.1,f.2.1,f.2.2.1) ;
 omega-degree : (n : Nat) -> DG.Deg n n (DG.omega n) = split {
  zero -> tt ; suc n | r -> (DG.deg-zero n (suc n),r) } ;
 -- ∧^k M
 module Piece (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) (k : Nat) {
  module LM = EF.Lam[M,b] ;
  module H (n : Nat) (e : MS.LinEquiv M (FM.Free n)) { module HH = AL.In[EC.Lam n].H[LM.alg,ED.Coord[M,b,n,e].to] ; } ;
  sub : Submodules[l].Submodule[FM.MO.ring,alg-mod LM.alg] =
   new Submodules[l].Submodule[FM.MO.ring,alg-mod LM.alg,ED.Deg M b k,ED.deg-prop M b k,
    \ n e -> subst (DG.Deg n k) (sym H[n,e].HH.zero) (DG.deg-zero n k),
    \ x y hx hy n e -> subst (DG.Deg n k) (sym (ED.Coord[M,b,n,e].to.2.1 x y))
     (DG.deg-add n k (ED.Coord[M,b,n,e].to.1 x) (ED.Coord[M,b,n,e].to.1 y) (hx n e) (hy n e)),
    \ x hx n e -> subst (DG.Deg n k) (sym (H[n,e].HH.neg x)) (DG.deg-neg n k (ED.Coord[M,b,n,e].to.1 x) (hx n e)),
    \ a x hx n e -> subst (DG.Deg n k) (sym (ED.Coord[M,b,n,e].to.2.2.1 a x))
     (HO.deg-scale n k a (ED.Coord[M,b,n,e].to.1 x) (hx n e))] ;
  module SB = SM.Sub[alg-mod LM.alg,sub] ;
  carrier : FM.Module = SB.carrier ;
 } ;
 -- wedge f on ∧^k
 module PieceMap (M N : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) (bN : Tr.Trunc[FF.Based N].carrier)
  (f : SM.Linear M N) (k : Nat) {
  module W = EF.Wedge[M,N,bM,bN,f] ;
  module PM = Piece[M,bM,k] ; module PN = Piece[N,bN,k] ;
  map : SM.Linear PM.carrier PN.carrier =
   (\ u -> (W.wedge.1 u.1,ED.Preserve[M,N,bM,bN,f,k,u.1,u.2].result),
    \ u v -> PN.SB.eq _ _ (W.wedge.2.1 u.1 v.1),
    \ a u -> PN.SB.eq _ _ (W.wedge.2.2.1 a u.1)) ;
 } ;
 -- coordinates by a basis e : M ~ R^n are an isomorphism Lam M ~ Lam n
 module Inverse (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) (n : Nat) (e : MS.LinEquiv M (FM.Free n)) {
  module LM = EF.Lam[M,b] ;
  module CE = ED.Coord[M,b,n,e] ;
  einv : SM.Linear (FM.Free n) M = ED.inv-lin M (FM.Free n) e ;
  alt : EF.AltM (FM.Free n) LM.alg = ED.alt-lin (FM.Free n) M LM.alg LM.gen einv ;
  from : AL.AlgHom (EC.Lam n) LM.alg = UP.In[LM.alg].ext n alt ;
  from-gen (a : MM.Vec n) : Id LM.alg.A (from.1 (gen n a)) (LM.gen.1 (einv.1 a)) = (UP.In[LM.alg].extend n alt).2.1 a ;
  to-from (y : Ext n) : Id (Ext n) (CE.to.1 (from.1 y)) y =
   UP.In[EC.Lam n].unique n (AL.comp (EC.Lam n) LM.alg (EC.Lam n) CE.to from) (EC.idHom (EC.Lam n))
    (\ a -> trans (ap CE.to.1 (from-gen a)) (trans (CE.to-gen (einv.1 a)) (ap (gen n) (e.1.2.sec-eq a)))) y ;
  from-to (x : LM.alg.A) : Id LM.alg.A (from.1 (CE.to.1 x)) x =
   ap (\ h -> h.1 x) (LM.hom-eq LM.alg (AL.comp LM.alg (EC.Lam n) LM.alg from CE.to) (EC.idHom LM.alg)
    (\ v -> trans (ap from.1 (CE.to-gen v)) (trans (from-gen (e.1.1 v))
      (ap LM.gen.1 (Pr.sec-ret M.M (MM.Vec n) e.1.1 e.1.2 v))))) ;
  to-inj (x y : LM.alg.A) (h : Id (Ext n) (CE.to.1 x) (CE.to.1 y)) : Id LM.alg.A x y =
   trans (sym (from-to x)) (trans (ap from.1 h) (from-to y)) ;
  -- from_e y has degree k for every basis, when y has
  module Other (m : Nat) (e' : MS.LinEquiv M (FM.Free m)) {
   module CE' = ED.Coord[M,b,m,e'] ;
   g : SM.Linear (FM.Free n) (FM.Free m) = (\ y -> e'.1.1 (einv.1 y),
    \ x y -> trans (ap e'.1.1 (einv.2.1 x y)) (e'.2.1 (einv.1 x) (einv.1 y)),
    \ c y -> trans (ap e'.1.1 (einv.2.2 c y)) (e'.2.2 c (einv.1 y))) ;
   A : MM.Mat n m = FM.mat n m g ;
   module LA = MI.Map[n,m,A] ;
   same (y : Ext n) : Id (Ext m) (CE'.to.1 (from.1 y)) (LA.value y) =
    UP.In[EC.Lam m].unique n (AL.comp (EC.Lam n) LM.alg (EC.Lam m) CE'.to from) LA.phi
     (\ a -> trans (ap CE'.to.1 (from-gen a)) (trans (CE'.to-gen (einv.1 a))
       (trans (ap (gen m) (F.funext (Ps.Fin m) (\ j -> R) (e'.1.1 (einv.1 a)) (MM.apply n m A a)
         (\ j -> FM.apply-mat n m g a j))) (sym (LA.phi-gen a))))) y ;
   degree (k : Nat) (y : Ext n) (dy : DG.Deg n k y) : DG.Deg m k (CE'.to.1 (from.1 y)) =
    subst (DG.Deg m k) (sym (same y)) (ED.phi-degree n m k A y dy) ;
  } ;
  from-degree (k : Nat) (y : Ext n) (dy : DG.Deg n k y) : ED.Deg M b k (from.1 y) = \ m e' -> Other[m,e'].degree k y dy ;
 } ;
 -- the top line: ∧^k M with k = n, for a basis of n elements
 module TopBasis (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) (k n : Nat) (hk : Id Nat k n) (e : MS.LinEquiv M (FM.Free n)) {
  module P = Piece[M,b,k] ;
  module LM = P.LM ;
  L : FM.Module = P.carrier ;
  module IV = Inverse[M,b,n,e] ;
  module CE = IV.CE ;
  phi (u : L.M) : R = top n (CE.to.1 u.1) ;
  psi (c : R) : L.M = (IV.from.1 (escale n c (DG.omega n)),
   subst (\ j -> ED.Deg M b j (IV.from.1 (escale n c (DG.omega n)))) (sym hk)
    (IV.from-degree n (escale n c (DG.omega n)) (HO.deg-scale n n c (DG.omega n) (omega-degree n)))) ;
  phi-psi (c : R) : Id R (phi (psi c)) c =
   trans (ap (top n) (IV.to-from (escale n c (DG.omega n))))
    (trans (DG.top-scale n c (DG.omega n)) (trans (ap (mul c) (DG.top-omega n)) (mulO c))) ;
  psi-phi (u : L.M) : Id L.M (psi (phi u)) u =
   P.SB.eq (psi (phi u)) u
    (trans (ap IV.from.1 (sym (DG.deg-top n (CE.to.1 u.1) (subst (\ j -> DG.Deg n j (CE.to.1 u.1)) hk (u.2 n e))))) (IV.from-to u.1)) ;
  line : MS.LinEquiv L FM.regular =
   ((phi,Pr.qinv L.M R phi psi phi-psi psi-phi),
    \ u v -> trans (ap (top n) (CE.to.2.1 u.1 v.1)) (ExteriorDuality[l].Over[Rg,setR].top-add n (CE.to.1 u.1) (CE.to.1 v.1)),
    \ a u -> trans (ap (top n) (CE.to.2.2.1 a u.1)) (DG.top-scale n a (CE.to.1 u.1))) ;
 } ;
 -- ∧^k M is a line when M merely has a basis of k elements
 module Top (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) (k n : Nat) (hk : Id Nat k n) (bn : Tr.Trunc[MS.LinEquiv M (FM.Free n)].carrier) {
  L : FM.Module = Piece[M,b,k].carrier ;
  line : Tr.Trunc[MS.LinEquiv L FM.regular].carrier =
   TC.map (MS.LinEquiv M (FM.Free n)) (MS.LinEquiv L FM.regular) (\ e -> TopBasis[M,b,k,n,hk,e].line) bn ;
 } ;
} ;
