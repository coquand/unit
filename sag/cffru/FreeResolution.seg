-- Finite free resolutions without bases (cffru, step 1).
-- A complex P -u-> G 0 -T 0-> G 1 -> ... of modules, in the layout of
-- cffr/Resolution (top first): u injective, composites 0 and exact
-- (Pairs, as Resolution.Pairs for linear maps).  A finite free resolution
-- of the ideal (a_j) (cffr §8, Thm 8.9): such a complex with k = m + 1
-- maps after u, whose last term G (m+1) is R (a linear equivalence iota)
-- and in which the image of the last map is the ideal (a): every
-- iota (T m y) is in (a), and every a_j is merely an iota (T m y)
-- (ResOf).  The terms are finite free: merely a basis of each (Bases).
-- The transport lemma (free-transport): a property Q P G of the terms
-- holds for R^p, R^(s i) when it holds for P, G and P ~ R^p, G i ~ R^(s i):
-- by the structure identity principle (ModuleSIP.sip) P = R^p and, with
-- function extensionality, G = (i |-> R^(s i)), so Q transports.  For a
-- resolution with terms R^p, R^(s i) the matrices of the maps
-- (FreeModules.mat) form a resolution in cffr's sense (Matrix.res).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @l+] ;
module TG = TrueGrade[l] ; module RS = Resolution[l] ; module T68 = Thm68[l] ;
module Over (D : TG.RD) {
 module FM = FreeModules[l].Over[D.1,D.2] ;
 module SM = FM.SM ; module MS = FM.MS ;
 Module : U l+ = FM.Module ;
 Lin (P Q : Module) : U l = SM.Linear P Q ;
 In (N : Nat) (a : Ps.Fin N -> D.1.R) (x : D.1.R) : U l = RegularIdeal[l].Generated[D.1,N,a].In x ;
 Pairs (k : Nat) (P : Module) (G : Nat -> Module) (u : Lin P (G zero)) (T : (i : Nat) -> Lin (G i) (G (suc i))) : U l =
  ((d : Nat) -> Id Nat k (suc d) ->
   FM.ComposeZeroL P (G zero) (G (suc zero)) u (T zero) * FM.ExactL P (G zero) (G (suc zero)) u (T zero)) *
  ((i d : Nat) -> Id Nat k (plus (suc (suc i)) d) ->
   FM.ComposeZeroL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i)) *
   FM.ExactL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i))) ;
 -- the image of Q -A-> E ~ R is the ideal (a)
 ImageL (N : Nat) (a : Ps.Fin N -> D.1.R) (Q E : Module) (A : Lin Q E) (iota : MS.LinEquiv E FM.regular) : U l =
  ((y : Q.M) -> In N a (iota.1.1 (A.1 y))) *
  ((j : Ps.Fin N) -> Tr.Trunc[(y : Q.M) * Id D.1.R (iota.1.1 (A.1 y)) (a j)].carrier) ;
 ResOf (m N : Nat) (a : Ps.Fin N -> D.1.R) (P : Module) (G : Nat -> Module) : U l =
  (u : Lin P (G zero)) * (T : (i : Nat) -> Lin (G i) (G (suc i))) *
  (FM.InjectiveL P (G zero) u * Pairs (suc m) P G u T) *
  ((iota : MS.LinEquiv (G (suc m)) FM.regular) * ImageL N a (G m) (G (suc m)) (T m) iota) ;
 -- accessors
 module RO (m N : Nat) (a : Ps.Fin N -> D.1.R) (P : Module) (G : Nat -> Module) (h : ResOf m N a P G) {
  u : Lin P (G zero) = h.1 ;
  T (i : Nat) : Lin (G i) (G (suc i)) = h.2.1 i ;
  injective : FM.InjectiveL P (G zero) u = h.2.2.1.1 ;
  pairs : Pairs (suc m) P G u T = h.2.2.1.2 ;
  iota : MS.LinEquiv (G (suc m)) FM.regular = h.2.2.2.1 ;
  image : ImageL N a (G m) (G (suc m)) (T m) iota = h.2.2.2.2 ;
 } ;
 Bases (P : Module) (G : Nat -> Module) : U l =
  (p : Nat) * (s : Nat -> Nat) * MS.LinEquiv P (FM.Free p) * ((i : Nat) -> MS.LinEquiv (G i) (FM.Free (s i))) ;
 -- a finite free resolution of the ideal (a)
 FFRes (N : Nat) (a : Ps.Fin N -> D.1.R) : U l+ =
  (m : Nat) * (P : Module) * (G : Nat -> Module) * Tr.Trunc[Bases P G].carrier * ResOf m N a P G ;

 -- the transport lemma
 module Transport (P : Module) (G : Nat -> Module) (b : Bases P G) {
  p : Nat = b.1 ;
  s : Nat -> Nat = b.2.1 ;
  frees : Nat -> Module = \ i -> FM.Free (s i) ;
  path-P : Id Module P (FM.Free p) = MS.sip P (FM.Free p) b.2.2.1 ;
  path-G : Id (Nat -> Module) G frees =
   FL1.funext Nat (\ i -> Module) G frees (\ i -> MS.sip (G i) (FM.Free (s i)) (b.2.2.2 i)) ;
  free-transport (Q : Module -> (Nat -> Module) -> U l) (h : Q P G) : Q (FM.Free p) frees =
   P1.subst (Nat -> Module) (\ H -> Q (FM.Free p) H) G frees path-G
    (P1.subst Module (\ X -> Q X G) P (FM.Free p) path-P h) ;
 } ;

 -- the matrices of a resolution by R^p, R^(s i)
 module Matrix (m N : Nat) (a : Ps.Fin N -> D.1.R) (p : Nat) (s : Nat -> Nat)
  (h : ResOf m N a (FM.Free p) (\ i -> FM.Free (s i))) {
  module H = RO[m,N,a,FM.Free p,\ i -> FM.Free (s i),h] ;
  u : RS.Mat D p (s zero) = FM.mat p (s zero) H.u ;
  T (i : Nat) : RS.Mat D (s i) (s (suc i)) = FM.mat (s i) (s (suc i)) (H.T i) ;
  res : T68.Res D (suc m) p s u T =
   (FM.injective p (s zero) H.u H.injective,
    (\ d e -> (FM.compose-zero p (s zero) (s (suc zero)) H.u (H.T zero) (H.pairs.1 d e).1,
               FM.exact p (s zero) (s (suc zero)) H.u (H.T zero) (H.pairs.1 d e).2),
     \ i d e -> (FM.compose-zero (s i) (s (suc i)) (s (suc (suc i))) (H.T i) (H.T (suc i)) (H.pairs.2 i d e).1,
                 FM.exact (s i) (s (suc i)) (s (suc (suc i))) (H.T i) (H.T (suc i)) (H.pairs.2 i d e).2))) ;
 } ;
} ;
