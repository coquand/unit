-- Structure identity for commutative rings with a set carrier, from the
-- generic SIP (sag/sip/SipGeneric), as ModuleSIP2 does for modules.
-- A ring structure on X is +, * and 1 (data: binop, binop, point) with
-- axioms: X a set, + an abelian group (AbAxioms: zero and negation are
-- axioms, unique), and * associative, commutative, unital, distributive.
-- The axioms are a proposition; SipGeneric does the rest.  The ring
-- records TrueGrade.RD are these structures field by field (fields, mk,
-- back), so (S' : RD) * RIso S S' is contractible (total-contr), where an
-- isomorphism is an equivalence of carriers preserving +, * and 1; this
-- gives sip and iso-induction (Fd).  A TrueGradeBase.Iso (ring maps h, g
-- inverse to each other) is such an isomorphism, with the same map h
-- (of-iso).
-- Instance (GradeIso): the true grade is invariant under ring isomorphisms,
-- koszul/TrueGradeIso.tgr-iso, as one iso-induction.
level l ; open Base ; open Prelude[l] ;
module G = SipGeneric[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module TG = TrueGrade[l] ; module TB = TrueGradeBase[l] ;

RD : U l+ = TG.RD ;
-- the laws of *
module MulAx (X : U l) (ad mu : X -> X -> X) (o : X) {
 MA : U l = (x y w : X) -> Id X (mu x (mu y w)) (mu (mu x y) w) ;
 MC : U l = (x y : X) -> Id X (mu x y) (mu y x) ;
 MO : U l = (x : X) -> Id X (mu x o) x ;
 MD : U l = (x y w : X) -> Id X (mu x (ad y w)) (ad (mu x y) (mu x w)) ;
 Ax : U l = MA * MC * MO * MD ;
 module P (sX : isSet X) {
  pi (B : X -> U l) (pB : (x : X) -> isProp (B x)) : isProp ((x : X) -> B x) = FL.isProp-Pi X B pB ;
  ma : isProp MA = pi (\ x -> (y w : X) -> Id X (mu x (mu y w)) (mu (mu x y) w)) (\ x ->
   pi (\ y -> (w : X) -> Id X (mu x (mu y w)) (mu (mu x y) w)) (\ y ->
    pi (\ w -> Id X (mu x (mu y w)) (mu (mu x y) w)) (\ w -> sX (mu x (mu y w)) (mu (mu x y) w)))) ;
  mc : isProp MC = pi (\ x -> (y : X) -> Id X (mu x y) (mu y x)) (\ x -> pi (\ y -> Id X (mu x y) (mu y x)) (\ y -> sX (mu x y) (mu y x))) ;
  mo : isProp MO = pi (\ x -> Id X (mu x o) x) (\ x -> sX (mu x o) x) ;
  md : isProp MD = pi (\ x -> (y w : X) -> Id X (mu x (ad y w)) (ad (mu x y) (mu x w))) (\ x ->
   pi (\ y -> (w : X) -> Id X (mu x (ad y w)) (ad (mu x y) (mu x w))) (\ y ->
    pi (\ w -> Id X (mu x (ad y w)) (ad (mu x y) (mu x w))) (\ w -> sX (mu x (ad y w)) (ad (mu x y) (mu x w))))) ;
  ax-prop : isProp Ax =
   isProp-Sigma MA (\ h -> MC * MO * MD) ma (\ h -> isProp-Sigma MC (\ h1 -> MO * MD) mc (\ h1 ->
    isProp-Sigma MO (\ h2 -> MD) mo (\ h2 -> md))) ;
 } ;
} ;
-- the notion of ring structure
Data : G.Notion = G.join G.binop (G.join G.binop G.point) ;
Ax (X : U l) (d : Data.S X) : U l = (sX : isSet X) * AbAxioms[l].Ab[X,d.1].Ax * MulAx[X,d.1,d.2.1,d.2.2].Ax ;
ax-prop (X : U l) (d : Data.S X) : isProp (Ax X d) =
 isProp-Sigma (isSet X) (\ sX -> AbAxioms[l].Ab[X,d.1].Ax * MulAx[X,d.1,d.2.1,d.2.2].Ax) (Torsor[l].isProp-isSet X) (\ sX ->
  isProp-Sigma AbAxioms[l].Ab[X,d.1].Ax (\ h -> MulAx[X,d.1,d.2.1,d.2.2].Ax) AbAxioms[l].Ab[X,d.1].P[sX].ax-prop
   (\ h -> MulAx[X,d.1,d.2.1,d.2.2].P[sX].ax-prop)) ;
N : G.Notion = G.axioms Data Ax ax-prop ;
module S = G.Over[N] ;

-- the ring records are S.Str
fields (A : RD) : S.Str = (A.1.R,((A.1.add,(A.1.mul,A.1.o)),(A.2,((A.1.addA,(A.1.addC,(A.1.z,(A.1.addZ,(A.1.neg,A.1.addN))))),
 (A.1.mulA,(A.1.mulC,(A.1.mulO,A.1.dist))))))) ;
mk (B : S.Str) : RD = (new Ring[l].CRing[B.1,B.2.2.2.1.2.2.1,B.2.1.2.2,B.2.1.1,B.2.1.2.1,B.2.2.2.1.2.2.2.2.1,
 B.2.2.2.1.1,B.2.2.2.1.2.1,B.2.2.2.1.2.2.2.1,B.2.2.2.1.2.2.2.2.2,
 B.2.2.2.2.1,B.2.2.2.2.2.1,B.2.2.2.2.2.2.1,B.2.2.2.2.2.2.2],B.2.2.1) ;
-- isomorphisms: equivalences preserving +, * and 1
RIso (A B : RD) : U l = S.Iso (fields A) (fields B) ;
idR (A : RD) : RIso A A = S.idIso (fields A) ;
Total (A : RD) : U l+ = (B : RD) * RIso A B ;
back-r (A : RD) : (B : Ring[l].CRing) (sB : isSet B.R) (phi : RIso A (B,sB)) -> Id (Total A) (mk (fields (B,sB)),phi) ((B,sB),phi) = split {
 CRing R z o add mul neg a1 a2 a3 a4 a5 a6 a7 a8 -> \ sB phi ->
  refl ((new Ring[l].CRing[R,z,o,add,mul,neg,a1,a2,a3,a4,a5,a6,a7,a8],sB),phi) } ;
back (A B : RD) (phi : RIso A B) : Id (Total A) (mk (fields B),phi) (B,phi) = back-r A B.1 B.2 phi ;
total-contr (A : RD) : FunExtUA[l+].isContr (Total A) =
 SipGeneric[l+].ctr-retract (S.Total (fields A)) (Total A) (S.total-contr (fields A))
  (\ c -> (fields c.1,c.2)) (\ c -> (mk c.1,c.2)) (\ c -> back A c.1 c.2) ;
opaque total-contr ;
module Fd = G.Fundamental[RD,RIso,idR,total-contr] ;
-- a TrueGradeBase isomorphism is one, with the same map
of-iso (A B : RD) (i : TB.Iso A B) : RIso A B =
 ((i.1.1,qinv A.1.R B.1.R i.1.1 i.2.1.1 i.2.2.2 i.2.2.1),(i.1.2.2.1,(i.1.2.2.2,i.1.2.1))) ;

-- instance: the true grade is invariant under isomorphisms (koszul/TrueGradeIso.tgr-iso)
module GradeIso (A B : RD) (i : TB.Iso A B) (k m : Ring[l].Nat) (J : Presentations[l].Fin m -> A.1.R) (n : Ring[l].Nat) (I : Presentations[l].Fin n -> A.1.R) {
 GradeAt (C : RD) (phi : RIso A C) : U l+ = TG.TGr k C m (\ t -> phi.1.1 (J t)) n (\ t -> phi.1.1 (I t)) ;
 tgr-iso (g : TG.TGr k A m J n I) : TG.TGr k B m (\ t -> i.1.1 (J t)) n (\ t -> i.1.1 (I t)) =
  Fd.iso-ind A GradeAt g B (of-iso A B i) ;
} ;
