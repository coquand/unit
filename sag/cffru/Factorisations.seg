-- Contractibility of the factorisations (cffru, step 4).
-- Uniqueness (Unique): if x in Lambda(R^n) is regular of degree p and
-- x_I y = x_I y' for all |I| = p, then y = y'.  (For |I| /= p, x_I = 0 by
-- degree; so (y_J - y'_J) is killed by every x_I, and x is regular.)
-- Lemma 8.4 (Contr84): for beta fixed, the gamma with ∧^q(B) = gamma
-- bhat^T form a contractible type: bhat = unstar(beta) is regular of
-- degree q, so gamma is unique, and Lemma84 gives one.
-- Corollary 8.5 (Chain): along the complex (*), a normalised chain is a
-- family beta_t (t <= T) with ∧^(rk t)(M t) = beta_t alpha_t^T, where
-- alpha_0 = 1 and alpha_(t+1) = unstar(beta_t), each alpha_t regular of
-- degree rk t.  The normalised chains form a proposition (induction on t:
-- beta_t = beta'_t gives alpha_(t+1) = alpha'_(t+1), then Unique), and
-- cffr's construction (Cor85.Chain.Res.stage) is one (center; the step of
-- Cor85 transports along q + p = N, step-alpha computes its alpha by
-- induction on that path): the type of normalised chains is contractible.
-- Theorem 8.7 (Det): the last factor gamma, with ∧^(rk (T+1))(M (T+1)) =
-- gamma unstar(beta_T)^T, is unique for any normalised chain, so the
-- Cayley determinant [gamma] is a function of the complex: it equals
-- Thm87's det for every chain and every such gamma (det-unique).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ; module H = ExteriorHomogeneous[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module RI = MI.RI ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module CB = ColumnBlocks[l].Over[Rg,setR] ;
 module L84 = Lemma84[l].Over[Rg,setR] ;
 module C85 = Cor85[l].Over[Rg,setR] ;
 module T87 = Thm87[l].Over[Rg,setR] ;
 reg-prop (X : U l) (a : X -> R) : Pr.isProp (RI.Regular X a) =
  F.isProp-Pi R (\ x -> Top -> RI.ZeroOn X a x -> Id R x z) (\ x ->
   F.isProp-Pi Top (\ t -> RI.ZeroOn X a x -> Id R x z) (\ t ->
    F.isProp-Pi (RI.ZeroOn X a x) (\ k -> Id R x z) (\ k -> setR x z))) ;

 ---------------------------------------------------------------------
 -- uniqueness of the second factor
 module Unique (n p m : Nat) (x : Ext n) (dx : DG.Deg n p x) (rx : RI.Regular (C.Index n) (CO.coeff n x)) (y y' : Ext m)
  (h : (I : C.Index n) -> Id Nat (BA.count n I) p -> Id (Ext m) (escale m (CO.coeff n x I) y) (escale m (CO.coeff n x I) y')) {
  module At (J : C.Index m) {
   d : R = add (CO.coeff m y J) (neg (CO.coeff m y' J)) ;
   kill (I : C.Index n) : Plus (Id Nat (BA.count n I) p) (Not (Id Nat (BA.count n I) p)) -> Id R (mul (CO.coeff n x I) d) z = split {
    inl e -> calc R {
     mul (CO.coeff n x I) d
      =< dist (CO.coeff n x I) (CO.coeff m y J) (neg (CO.coeff m y' J))
       > add (mul (CO.coeff n x I) (CO.coeff m y J)) (mul (CO.coeff n x I) (neg (CO.coeff m y' J)))
      =< ap (add (mul (CO.coeff n x I) (CO.coeff m y J))) (L.mul-neg (CO.coeff n x I) (CO.coeff m y' J))
       > add (mul (CO.coeff n x I) (CO.coeff m y J)) (neg (mul (CO.coeff n x I) (CO.coeff m y' J)))
      =< ap (\ s -> add s (neg (mul (CO.coeff n x I) (CO.coeff m y' J))))
          (trans (sym (CO.coeff-scale m (CO.coeff n x I) y J))
           (trans (ap (\ w -> CO.coeff m w J) (h I e)) (CO.coeff-scale m (CO.coeff n x I) y' J)))
       > add (mul (CO.coeff n x I) (CO.coeff m y' J)) (neg (mul (CO.coeff n x I) (CO.coeff m y' J)))
      =< addN (mul (CO.coeff n x I) (CO.coeff m y' J)) > z } ;
    inr ne -> trans (ap (\ c -> mul c d) (HO.coeff-support n p x dx I ne)) (L.zero-mul d) } ;
   result : Id R (CO.coeff m y J) (CO.coeff m y' J) =
    L84.eq-from-sub (CO.coeff m y J) (CO.coeff m y' J)
     (rx d tt (\ I -> kill I (H.DecNat.dec (BA.count n I) p))) ;
  } ;
  result : Id (Ext m) y y' = CO.ext m y y' (\ J -> At[J].result) ;
 } ;
 -- unstar of a regular element is regular (as Lemma84.At.bhat-regular)
 unstar-regular (n : Nat) (b : Ext n) (rb : RI.Regular (C.Index n) (CO.coeff n b)) :
  RI.Regular (C.Index n) (CO.coeff n (DU.unstar n b)) = \ x t h ->
  rb x tt (\ K -> trans (mulC (CO.coeff n b K) x)
   (trans (sym (CO.coeff-scale n x b K))
    (trans (ap (\ u -> CO.coeff n u K)
      (trans (ap (escale n x) (sym (DU.star-unstar n b)))
       (trans (sym (DU.star-scale n x (DU.unstar n b)))
        (trans (ap (DU.star n)
          (CO.ext n (escale n x (DU.unstar n b)) (ezero n)
           (\ K1 -> trans (CO.coeff-scale n x (DU.unstar n b) K1)
            (trans (mulC x (CO.coeff n (DU.unstar n b) K1)) (trans (h K1) (sym (CO.coeff-zero n K1)))))))
         (HO.star-zero n)))))
     (CO.coeff-zero n K)))) ;

 ---------------------------------------------------------------------
 -- Lemma 8.4: for beta fixed, gamma is unique
 module Contr84 (e q p g : Nat) (A : MM.Mat e (plus q p)) (B : MM.Mat (plus q p) g)
  (cz : MM.ComposeZero e (plus q p) g A B)
  (a0 : Ext e) (da : DG.Deg e p a0) (ra : RI.Regular (C.Index e) (CO.coeff e a0))
  (b0 : Ext (plus q p)) (db : DG.Deg (plus q p) p b0) (gb : L84.GrTwo (C.Index (plus q p)) (CO.coeff (plus q p) b0))
  (hA : (I : C.Index e) -> Id Nat (BA.count e I) p ->
   Id (Ext (plus q p)) (CB.Selected[plus q p].selected-product e I A) (escale (plus q p) (CO.coeff e a0 I) b0)) {
  module LA = L84.At[e,q,p,g,A,B,cz,a0,da,ra,b0,db,gb,hA] ;
  Eq (gamma : Ext g) : U l = (K : C.Index (plus q p)) -> Id Nat (BA.count (plus q p) K) q ->
   Id (Ext g) (CB.Selected[g].selected-product (plus q p) K B) (escale g (CO.coeff (plus q p) LA.bhat K) gamma) ;
  Factor : U l = (gamma : Ext g) * Eq gamma ;
  eq-prop (gamma : Ext g) : Pr.isProp (Eq gamma) =
   F.isProp-Pi (C.Index (plus q p)) (\ K -> Id Nat (BA.count (plus q p) K) q ->
     Id (Ext g) (CB.Selected[g].selected-product (plus q p) K B) (escale g (CO.coeff (plus q p) LA.bhat K) gamma)) (\ K ->
    F.isProp-Pi (Id Nat (BA.count (plus q p) K) q) (\ eK ->
      Id (Ext g) (CB.Selected[g].selected-product (plus q p) K B) (escale g (CO.coeff (plus q p) LA.bhat K) gamma)) (\ eK ->
     EA.set g (CB.Selected[g].selected-product (plus q p) K B) (escale g (CO.coeff (plus q p) LA.bhat K) gamma))) ;
  factor-prop : Pr.isProp Factor = \ u v ->
   Pr.Sigma-eq (Ext g) Eq u.1 v.1 u.2 v.2
    (Unique[plus q p,q,g,LA.bhat,LA.bhat-degree,LA.bhat-regular,u.1,v.1,\ K eK -> trans (sym (u.2 K eK)) (v.2 K eK)].result)
    (eq-prop v.1) ;
  contractible : FunExtUA[l].isContr Factor = ((LA.gamma,LA.lemma84),\ v -> factor-prop (LA.gamma,LA.lemma84) v) ;
 } ;

 ---------------------------------------------------------------------
 -- what Cor85's transported step and last compute
 StepAlpha (e p q g N : Nat) (hN : Id Nat (plus q p) N) : U l =
  (A : MM.Mat e N) (B : MM.Mat N g) (cz : MM.ComposeZero e N g A B) (s : C85.Stage e p N A)
  (gm : L84.GrTwo (MI.Index q N g) (MI.minors q N g B)) ->
  Id (Ext N) (C85.St[N,q,g,B,C85.step e p q g N hN A B cz s gm].alpha0) (DU.unstar N C85.St[e,p,N,A,s].beta0) ;
 step-alpha (e p q g N : Nat) (hN : Id Nat (plus q p) N) : StepAlpha e p q g N hN =
  idJ Nat (plus q p) (\ N1 h1 -> StepAlpha e p q g N1 h1)
   (\ A B cz s gm -> refl (DU.unstar (plus q p) C85.St[e,p,plus q p,A,s].beta0)) N hN ;
 LastEq (p q g N : Nat) (B : MM.Mat N g) (b : Ext N) (gamma : Ext g) : U l =
  (K : C.Index N) -> Id Nat (BA.count N K) q ->
  Id (Ext g) (CB.Selected[g].selected-product N K B) (escale g (CO.coeff N (DU.unstar N b) K) gamma) ;
 LastType (e p q g N : Nat) (hN : Id Nat (plus q p) N) : U l =
  (A : MM.Mat e N) (B : MM.Mat N g) (cz : MM.ComposeZero e N g A B) (s : C85.Stage e p N A)
  (rg : MI.RegularD q N g B) ->
  LastEq p q g N B C85.St[e,p,N,A,s].beta0 C85.Fi[q,N,g,B,C85.last e p q g N hN A B cz s rg].gamma ;
 last-eq (e p q g N : Nat) (hN : Id Nat (plus q p) N) : LastType e p q g N hN =
  idJ Nat (plus q p) (\ N1 h1 -> LastType e p q g N1 h1)
   (\ A B cz s rg -> C85.Step[e,q,p,g,A,B,cz,s].LA.lemma84) N hN ;

 ---------------------------------------------------------------------
 -- Corollary 8.5: normalised chains along (*)
 module Chain (s : Nat -> Nat) {
  module CH = C85.Chain[s] ;
  module Res (T : Nat) (d : Nat -> Nat) (M : (t : Nat) -> MM.Mat (d t) (d (suc t)))
   (hd : (t : Nat) -> C85.lt t (suc T) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)))
   (cz : (t : Nat) -> C85.lt t (suc T) -> MM.ComposeZero (d t) (d (suc t)) (d (suc (suc t))) (M t) (M (suc t)))
   (gm : (t : Nat) -> C85.lt (suc t) (suc T) ->
    L84.GrTwo (MI.Index (CH.rk (suc t)) (d (suc t)) (d (suc (suc t)))) (MI.minors (CH.rk (suc t)) (d (suc t)) (d (suc (suc t))) (M (suc t)))) {
   module RS = CH.Res[T,d,M,hd,cz,gm] ;
   Betas : U l = (t : Nat) -> C85.lt t (suc T) -> Ext (d (suc t)) ;
   alpha (beta : Betas) : (t : Nat) -> C85.lt t (suc T) -> Ext (d t) = split {
    zero -> \ h -> eone (d zero) ;
    suc t -> \ h -> DU.unstar (d (suc t)) (beta t (C85.lt-pred t (suc T) h)) } ;
   Factored (t : Nat) (a : Ext (d t)) (b : Ext (d (suc t))) : U l =
    (I : C.Index (d t)) -> Id Nat (BA.count (d t) I) (CH.rk t) ->
    Id (Ext (d (suc t))) (CB.Selected[d (suc t)].selected-product (d t) I (M t)) (escale (d (suc t)) (CO.coeff (d t) a I) b) ;
   Good (t : Nat) (a : Ext (d t)) : U l = DG.Deg (d t) (CH.rk t) a * RI.Regular (C.Index (d t)) (CO.coeff (d t) a) ;
   Laws (beta : Betas) : U l =
    ((t : Nat) (h : C85.lt t (suc T)) -> Factored t (alpha beta t h) (beta t h)) *
    ((t : Nat) (h : C85.lt t (suc T)) -> Good t (alpha beta t h)) ;
   NormChain : U l = (beta : Betas) * Laws beta ;
   factored-prop (t : Nat) (a : Ext (d t)) (b : Ext (d (suc t))) : Pr.isProp (Factored t a b) =
    F.isProp-Pi (C.Index (d t)) (\ I -> Id Nat (BA.count (d t) I) (CH.rk t) ->
      Id (Ext (d (suc t))) (CB.Selected[d (suc t)].selected-product (d t) I (M t)) (escale (d (suc t)) (CO.coeff (d t) a I) b)) (\ I ->
     F.isProp-Pi (Id Nat (BA.count (d t) I) (CH.rk t)) (\ e ->
      Id (Ext (d (suc t))) (CB.Selected[d (suc t)].selected-product (d t) I (M t)) (escale (d (suc t)) (CO.coeff (d t) a I) b)) (\ e ->
      EA.set (d (suc t)) (CB.Selected[d (suc t)].selected-product (d t) I (M t)) (escale (d (suc t)) (CO.coeff (d t) a I) b))) ;
   good-prop (t : Nat) (a : Ext (d t)) : Pr.isProp (Good t a) =
    HO.prod-prop (DG.Deg (d t) (CH.rk t) a) (RI.Regular (C.Index (d t)) (CO.coeff (d t) a))
     (HO.deg-prop (d t) (CH.rk t) a) (reg-prop (C.Index (d t)) (CO.coeff (d t) a)) ;
   laws-prop (beta : Betas) : Pr.isProp (Laws beta) =
    HO.prod-prop ((t : Nat) (h : C85.lt t (suc T)) -> Factored t (alpha beta t h) (beta t h))
     ((t : Nat) (h : C85.lt t (suc T)) -> Good t (alpha beta t h))
     (F.isProp-Pi Nat (\ t -> (h : C85.lt t (suc T)) -> Factored t (alpha beta t h) (beta t h)) (\ t ->
      F.isProp-Pi (C85.lt t (suc T)) (\ h -> Factored t (alpha beta t h) (beta t h)) (\ h -> factored-prop t (alpha beta t h) (beta t h))))
     (F.isProp-Pi Nat (\ t -> (h : C85.lt t (suc T)) -> Good t (alpha beta t h)) (\ t ->
      F.isProp-Pi (C85.lt t (suc T)) (\ h -> Good t (alpha beta t h)) (\ h -> good-prop t (alpha beta t h)))) ;
   -- two normalised chains agree
   module Agree (c c' : NormChain) {
    step (t : Nat) (h : C85.lt t (suc T)) (a a' : Ext (d t)) (ea : Id (Ext (d t)) a a') (ga : Good t a)
     (f : Factored t a (c.1 t h)) (f' : Factored t a' (c'.1 t h)) : Id (Ext (d (suc t))) (c.1 t h) (c'.1 t h) =
     Unique[d t,CH.rk t,d (suc t),a,ga.1,ga.2,c.1 t h,c'.1 t h,
      \ I e -> trans (sym (f I e)) (trans (f' I e) (ap (\ b -> escale (d (suc t)) (CO.coeff (d t) b I) (c'.1 t h)) (sym ea)))].result ;
    agree : (t : Nat) (h : C85.lt t (suc T)) -> Id (Ext (d (suc t))) (c.1 t h) (c'.1 t h) = split {
     zero -> \ h -> step zero h (eone (d zero)) (eone (d zero)) (refl (eone (d zero))) (c.2.2 zero h) (c.2.1 zero h) (c'.2.1 zero h) ;
     suc t | r -> \ h -> step (suc t) h (alpha c.1 (suc t) h) (alpha c'.1 (suc t) h)
      (ap (DU.unstar (d (suc t))) (r (C85.lt-pred t (suc T) h))) (c.2.2 (suc t) h) (c.2.1 (suc t) h) (c'.2.1 (suc t) h) } ;
    betas : Id Betas c.1 c'.1 =
     F.funext Nat (\ t -> (h : C85.lt t (suc T)) -> Ext (d (suc t))) c.1 c'.1 (\ t ->
      F.funext (C85.lt t (suc T)) (\ h -> Ext (d (suc t))) (c.1 t) (c'.1 t) (\ h -> agree t h)) ;
    result : Id NormChain c c' = Pr.Sigma-eq Betas Laws c.1 c'.1 c.2 c'.2 betas (laws-prop c'.1) ;
   } ;
   chain-prop : Pr.isProp NormChain = \ c c' -> Agree[c,c'].result ;
   -- cffr's construction is a normalised chain
   beta (t : Nat) (h : C85.lt t (suc T)) : Ext (d (suc t)) = C85.St[d t,CH.rk t,d (suc t),M t,RS.stage t h].beta0 ;
   alpha-stage : (t : Nat) (h : C85.lt t (suc T)) ->
    Id (Ext (d t)) (C85.St[d t,CH.rk t,d (suc t),M t,RS.stage t h].alpha0) (alpha beta t h) = split {
    zero -> \ h -> refl (eone (d zero)) ;
    suc t -> \ h -> step-alpha (d t) (CH.rk t) (CH.rk (suc t)) (d (suc (suc t))) (d (suc t)) (hd t (C85.lt-pred t (suc T) h))
     (M t) (M (suc t)) (cz t (C85.lt-pred t (suc T) h)) (RS.stage t (C85.lt-pred t (suc T) h)) (gm t h) } ;
   center : NormChain = (beta,
    (\ t h -> subst (\ a -> Factored t a (beta t h)) (alpha-stage t h) C85.St[d t,CH.rk t,d (suc t),M t,RS.stage t h].columns,
     \ t h -> subst (Good t) (alpha-stage t h)
      (C85.St[d t,CH.rk t,d (suc t),M t,RS.stage t h].alpha-degree,C85.St[d t,CH.rk t,d (suc t),M t,RS.stage t h].alpha-regular))) ;
   -- Corollary 8.5: the normalised chains form a contractible type
   contractible : FunExtUA[l].isContr NormChain = (center,\ c -> chain-prop center c) ;

   -- Theorem 8.7: the last factor, hence the Cayley determinant, is unique
   module Det (rg : MI.RegularD (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T)))
    (ed : Id Nat (CH.rk (suc T)) (d (suc (suc T)))) {
    module TH = T87.Thm87[s].Res[T,d,M,hd,cz,gm,rg,ed] ;
    module ST = C85.St[d T,CH.rk T,d (suc T),M T,RS.stage T (C85.lt-self T)] ;
    -- the last factor along a chain c
    Last (c : NormChain) (gamma : Ext (d (suc (suc T)))) : U l =
     LastEq (CH.rk T) (CH.rk (suc T)) (d (suc (suc T))) (d (suc T)) (M (suc T)) (c.1 T (C85.lt-self T)) gamma ;
    last : Last center TH.FI.gamma =
     last-eq (d T) (CH.rk T) (CH.rk (suc T)) (d (suc (suc T))) (d (suc T)) (hd T (C85.lt-self T)) (M T) (M (suc T))
      (cz T (C85.lt-self T)) (RS.stage T (C85.lt-self T)) rg ;
    bhat : Ext (d (suc T)) = DU.unstar (d (suc T)) ST.beta0 ;
    bhat-degree : DG.Deg (d (suc T)) (CH.rk (suc T)) bhat =
     HO.unstar-degree (d (suc T)) (CH.rk (suc T)) (CH.rk T) ST.beta0 ST.beta-degree (hd T (C85.lt-self T)) ;
    bhat-regular : RI.Regular (C.Index (d (suc T))) (CO.coeff (d (suc T)) bhat) = unstar-regular (d (suc T)) ST.beta0 ST.beta-grade.1 ;
    gamma-unique (c : NormChain) (gamma : Ext (d (suc (suc T)))) (hg : Last c gamma) : Id (Ext (d (suc (suc T)))) gamma TH.FI.gamma =
     Unique[d (suc T),CH.rk (suc T),d (suc (suc T)),bhat,bhat-degree,bhat-regular,gamma,TH.FI.gamma,
      \ K e -> trans (sym (subst (\ c1 -> Last c1 gamma) (chain-prop c center) hg K e)) (last K e)].result ;
    -- the Cayley determinant is the same for every chain and last factor
    det-unique (c : NormChain) (gamma : Ext (d (suc (suc T)))) (hg : Last c gamma) : Id R (top (d (suc (suc T))) gamma) TH.det =
     ap (top (d (suc (suc T)))) (gamma-unique c gamma hg) ;
   } ;
  } ;
 } ;
} ;
