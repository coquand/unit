-- The determinant of an endomorphism, without bases (cffru, for WiebeFree).
-- F merely ~ R^n, V : F -> F linear.  ∧^n V acts on the top line ∧^n F
-- (TopLine.PieceMap); Δ is the scalar by which it acts: IsDet d when
-- ∧^n V (u) = d u for all u.  Being such a scalar is unique, and there is
-- one, so Δ (Delta) is an element, defined with no basis.
-- Uniqueness (Basis.unique): with a basis, u0 = psi(1) generates the line
-- (phi(u0) = 1), and d = phi(d u0) = phi(∧V u0) = phi(d' u0) = d'.
-- Existence (Basis.is-det): with a basis e and A the matrix of e V e^-1,
-- to_e(∧V u) = Λ(A)(to_e u) (ExteriorDegreeM.Square), to_e u = top(to_e u) ω
-- (u has degree n), and Λ(A) ω = det A ω (lam-omega: ω = i(e_1)..i(e_n),
-- Λ(A) i(e_k) = i(A_k), Determinant.free).  So ∧V u = det A u.
-- Hence (delta-coords) for every basis, Δ = det of the matrix of V.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 open ExteriorModel[l].Over[Rg] ;
 module TL = TopLine[l].Over[Rg,setR] ;
 module ED = TL.ED ; module FM = TL.FM ; module FF = TL.FF ; module SM = TL.SM ; module MS = TL.MS ;
 module DG = TL.DG ; module MM = TL.MM ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DM = MnSums[l].Over[Rg] ;
 module At (M : FM.Module) (n : Nat) (bM : Tr.Trunc[MS.LinEquiv M (FM.Free n)].carrier) (V : SM.Linear M M) {
  b : Tr.Trunc[FF.Based M].carrier = TC.map (MS.LinEquiv M (FM.Free n)) (FF.Based M) (\ e -> (n,e)) bM ;
  module PM = TL.PieceMap[M,M,b,b,V,n] ;
  IsDet (d : R) : U l = (u : PM.PM.carrier.M) -> Id PM.PM.carrier.M (PM.map.1 u) (PM.PM.carrier.sm d u) ;
  isdet-prop (d : R) : Pr.isProp (IsDet d) = F.isProp-Pi PM.PM.carrier.M (\ u -> Id PM.PM.carrier.M (PM.map.1 u) (PM.PM.carrier.sm d u)) (\ u -> PM.PM.carrier.setM (PM.map.1 u) (PM.PM.carrier.sm d u)) ;
  module Basis (e : MS.LinEquiv M (FM.Free n)) {
   module TB = TL.TopBasis[M,b,n,n,refl n,e] ;
   module SQ = ED.Square[M,M,b,b,V,n,e,n,e] ;
   A : MM.Mat n n = SQ.A ;
   -- Λ(A) ω = det A ω
   lam-omega : Id (Ext n) (SQ.LA.value (DG.omega n)) (escale n (det n A) (DG.omega n)) = calc (Ext n) {
    SQ.LA.value (DG.omega n) =< ap SQ.LA.value (sym (DT.std-omega n)) > SQ.LA.value (DT.std n)
     =< DT.hom-eprod n n SQ.LA.phi n (\ k -> gen n (DM.delta n k)) > eprod n n (\ k -> SQ.LA.value (gen n (DM.delta n k)))
     =< DT.eprod-cong n n (\ k -> SQ.LA.value (gen n (DM.delta n k))) (\ k -> gen n (A k))
         (\ k -> trans (SQ.LA.phi-gen (DM.delta n k)) (ap (gen n) (SQ.LA.apply-delta k))) > eprod n n (\ k -> gen n (A k))
     =< DT.free n A > escale n (det n A) (DG.omega n) } ;
   -- ∧V acts on the top line by det A
   is-det : IsDet (det n A) = \ u -> TB.P.SB.eq (PM.map.1 u) (PM.PM.carrier.sm (det n A) u) (TB.IV.to-inj (PM.map.1 u).1 (PM.PM.carrier.sm (det n A) u).1 (calc (Ext n) {
    TB.CE.to.1 (PM.map.1 u).1 =< SQ.value u.1 > SQ.LA.value (TB.CE.to.1 u.1)
     =< ap SQ.LA.value (DG.deg-top n (TB.CE.to.1 u.1) (u.2 n e)) > SQ.LA.value (escale n (top n (TB.CE.to.1 u.1)) (DG.omega n))
     =< SQ.LA.value-scale (top n (TB.CE.to.1 u.1)) (DG.omega n) > escale n (top n (TB.CE.to.1 u.1)) (SQ.LA.value (DG.omega n))
     =< ap (escale n (top n (TB.CE.to.1 u.1))) lam-omega > escale n (top n (TB.CE.to.1 u.1)) (escale n (det n A) (DG.omega n))
     =< EA.escale-scale n (top n (TB.CE.to.1 u.1)) (det n A) (DG.omega n) > escale n (mul (top n (TB.CE.to.1 u.1)) (det n A)) (DG.omega n)
     =< ap (\ c -> escale n c (DG.omega n)) (mulC (top n (TB.CE.to.1 u.1)) (det n A)) > escale n (mul (det n A) (top n (TB.CE.to.1 u.1))) (DG.omega n)
     =< sym (EA.escale-scale n (det n A) (top n (TB.CE.to.1 u.1)) (DG.omega n)) > escale n (det n A) (escale n (top n (TB.CE.to.1 u.1)) (DG.omega n))
     =< ap (escale n (det n A)) (sym (DG.deg-top n (TB.CE.to.1 u.1) (u.2 n e))) > escale n (det n A) (TB.CE.to.1 u.1)
     =< sym (TB.CE.to.2.2.1 (det n A) u.1) > TB.CE.to.1 (PM.PM.carrier.sm (det n A) u).1 })) ;
   -- the scalar is unique
   u0 : PM.PM.carrier.M = TB.psi o ;
   unique (d d' : R) (h : IsDet d) (h' : IsDet d') : Id R d d' = calc R {
    d =< sym (mulO d) > mul d o
     =< ap (mul d) (sym (TB.phi-psi o)) > mul d (TB.phi u0)
     =< sym (TB.line.2.2 d u0) > TB.phi (PM.PM.carrier.sm d u0)
     =< ap TB.phi (sym (h u0)) > TB.phi (PM.map.1 u0)
     =< ap TB.phi (h' u0) > TB.phi (PM.PM.carrier.sm d' u0)
     =< TB.line.2.2 d' u0 > mul d' (TB.phi u0)
     =< ap (mul d') (TB.phi-psi o) > mul d' o
     =< mulO d' > d' } ;
  } ;
  det-prop : Pr.isProp ((d : R) * IsDet d) = \ u v ->
   Pr.Sigma-eq R IsDet u.1 v.1 u.2 v.2
    (Tr.Trunc[MS.LinEquiv M (FM.Free n)].induction @l (\ w -> Id R u.1 v.1) (\ w -> setR u.1 v.1) (\ e -> Basis[e].unique u.1 v.1 u.2 v.2) bM)
    (isdet-prop v.1) ;
  det-data : (d : R) * IsDet d =
   Tr.Trunc[MS.LinEquiv M (FM.Free n)].induction @l (\ w -> (d : R) * IsDet d) (\ w -> det-prop) (\ e -> (det n Basis[e].A,Basis[e].is-det)) bM ;
  -- Δ, without bases
  Delta : R = det-data.1 ;
  delta-is-det : IsDet Delta = det-data.2 ;
  -- for every basis, Δ is the determinant of the matrix
  delta-coords (e : MS.LinEquiv M (FM.Free n)) : Id R Delta (det n Basis[e].A) = Basis[e].unique Delta (det n Basis[e].A) delta-is-det Basis[e].is-det ;
 } ;
} ;
