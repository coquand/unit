-- cffr Theorem 8.9 through the determinant line (cffru, step 2 + step 1).
-- A finite free resolution of the ideal (a_j) (FreeResolution.FFRes,
-- 0 -> P -u-> G 0 -T 0-> ... -T m-> G (m+1) ~ R) carries, when the last
-- rank is 1, the Buchsbaum-Eisenbud structure (Structure.Chain.Res) on its
-- own modules, and the gcd of the a_j is the value of a_Det : Det(F) ->
-- ∧^1 G (m+1) at the basis element of Det(F) given by the bases (DetLine).
-- Proof.  The goal (merely a gcd) is a proposition, so take bases eP of P
-- and eG i of G i.  Conjugation (Conj, Conj3): the maps g = e' f e^-1
-- between the R^n are injective, compose to 0 and are exact when the f are
-- (pull a vector back along e, push the preimage forward), so their
-- matrices (ExteriorDegreeM.Square.A) are a resolution in cffr's sense and
-- Theorem 6.8 applies (through cffr's Thm89: ranks r, stable, true grades).
-- The terms in cffr's layout (Cor85): G' 0 = R^0 (a dummy, f' 0 = 0),
-- G' 1 = P, G' (i+2) = G i; ranks s' = p, r 0, r 1, ... (Thm89.Main).
-- The hypotheses of Structure are for every choice of bases: Thm89 gives
-- them (GrTwo for the minors through GradeBridge, D(T m) regular) for the
-- chosen bases es', and DkFree.change / reg-change move them to any other
-- choice (D_k does not depend on the bases).  So, for r m = s (m+1)
-- (Case), DetLine applies to the resolution itself: a_Det is canonical,
-- and its value det at the basis element is a regular gcd of the 1 x 1
-- minors of the last matrix (DetLine.Coordinates.gcd).  The other cases
-- are cffr's: r m = 0 gives D_1(T m) = 0, r m >= 2 gives 1 = 0.  Finally
-- the last map followed by iota' = iota eG(m+1)^-1 : R^(s (m+1)) ~ R has
-- image (a) (image'), so Thm89U.claim turns a gcd of the minors into a gcd
-- of the a_j.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module TG = TrueGrade[l] ; module T68 = Thm68[l] ; module RS = Resolution[l] ;
module Over (D : TG.RD) {
 module L = RL[D.1] ;
 module FR = FreeResolution[l].Over[D] ;
 module DL = DetLine[l].Over[D.1,D.2] ;
 module SC = DL.SC ; module ED = SC.ED ; module FM = SC.FM ; module FF = SC.FF ; module SM = SC.SM ; module MS = SC.MS ;
 module MI = SC.MI ; module C85 = SC.C85 ; module L86 = DL.L86 ; module L84 = SC.L84 ;
 module DK = DkFree[l].Over[D.1,D.2] ;
 module T89 = Thm89[l].Over[D] ;
 module T89U = Thm89U[l].Over[D] ;
 R : U l = D.1.R ;
 based (P : FM.Module) (p : Nat) (e : MS.LinEquiv P (FM.Free p)) : Tr.Trunc[FF.Based P].carrier = Tr.Trunc[FF.Based P].inc (p,e) ;

 -- g = eQ f eP^-1
 module Conj (P Q : FM.Module) (p q : Nat) (eP : MS.LinEquiv P (FM.Free p)) (eQ : MS.LinEquiv Q (FM.Free q)) (f : SM.Linear P Q) {
  module SQ = ED.Square[P,Q,based P p eP,based Q q eQ,f,q,eQ,p,eP] ;
  module IP = ED.Inv[P,FM.Free p,eP] ; module IQ = ED.Inv[Q,FM.Free q,eQ] ;
  g : SM.Linear (FM.Free p) (FM.Free q) = SQ.g ;
  -- g y = 0 gives f (eP^-1 y) = 0
  kernel (y : (FM.Free p).M) (h : Id (FM.Free q).M (g.1 y) (FM.Free q).mz) : Id Q.M (f.1 (IP.inv y)) Q.mz = calc Q.M {
   f.1 (IP.inv y) =< sym (IQ.ret-eq (f.1 (IP.inv y))) > IQ.inv (eQ.1.1 (f.1 (IP.inv y)))
    =< ap IQ.inv h > IQ.inv (FM.Free q).mz
    =< SM.Lin[FM.Free q,Q,IQ.linear].map-z > Q.mz } ;
  injective (h : FM.InjectiveL P Q f) : FM.InjectiveL (FM.Free p) (FM.Free q) g = \ y hy -> calc (FM.Free p).M {
   y =< sym (IP.inv-eq y) > eP.1.1 (IP.inv y)
    =< ap eP.1.1 (h (IP.inv y) (kernel y hy)) > eP.1.1 P.mz
    =< SM.Lin[P,FM.Free p,FM.lin P (FM.Free p) eP].map-z > (FM.Free p).mz } ;
 } ;
 module Conj3 (P Q E : FM.Module) (p q r : Nat) (eP : MS.LinEquiv P (FM.Free p)) (eQ : MS.LinEquiv Q (FM.Free q))
  (eE : MS.LinEquiv E (FM.Free r)) (f : SM.Linear P Q) (f' : SM.Linear Q E) {
  module C1 = Conj[P,Q,p,q,eP,eQ,f] ; module C2 = Conj[Q,E,q,r,eQ,eE,f'] ;
  zero (h : FM.ComposeZeroL P Q E f f') : FM.ComposeZeroL (FM.Free p) (FM.Free q) (FM.Free r) C1.g C2.g = \ x -> calc (FM.Free r).M {
   C2.g.1 (C1.g.1 x) =< ap (\ y -> eE.1.1 (f'.1 y)) (C1.IQ.ret-eq (f.1 (C1.IP.inv x))) > eE.1.1 (f'.1 (f.1 (C1.IP.inv x)))
    =< ap eE.1.1 (h (C1.IP.inv x)) > eE.1.1 E.mz
    =< SM.Lin[E,FM.Free r,FM.lin E (FM.Free r) eE].map-z > (FM.Free r).mz } ;
  exact (h : FM.ExactL P Q E f f') : FM.ExactL (FM.Free p) (FM.Free q) (FM.Free r) C1.g C2.g = \ y hy ->
   TC.map ((x : P.M) * Id Q.M (f.1 x) (C2.IP.inv y)) ((x : (FM.Free p).M) * Id (FM.Free q).M (C1.g.1 x) y)
    (\ w -> (eP.1.1 w.1,calc (FM.Free q).M {
     C1.g.1 (eP.1.1 w.1) =< ap (\ t -> eQ.1.1 (f.1 t)) (C1.IP.ret-eq w.1) > eQ.1.1 (f.1 w.1)
      =< ap eQ.1.1 w.2 > eQ.1.1 (C2.IP.inv y)
      =< C2.IP.inv-eq y > y }))
    (h (C2.IP.inv y) (C2.kernel y hy)) ;
 } ;

 module FromBases (N : Nat) (a : Ps.Fin N -> R) (m : Nat) (P : FM.Module) (G : Nat -> FM.Module) (b : FR.Bases P G)
  (h : FR.ResOf m N a P G) {
  module H = FR.RO[m,N,a,P,G,h] ;
  p : Nat = b.1 ;
  s : Nat -> Nat = b.2.1 ;
  eP : MS.LinEquiv P (FM.Free p) = b.2.2.1 ;
  eG (i : Nat) : MS.LinEquiv (G i) (FM.Free (s i)) = b.2.2.2 i ;
  -- the matrices are a resolution in cffr's sense
  module CU = Conj[P,G zero,p,s zero,eP,eG zero,H.u] ;
  module CT (i : Nat) { module C = Conj[G i,G (suc i),s i,s (suc i),eG i,eG (suc i),H.T i] ; } ;
  u : RS.Mat D p (s zero) = CU.SQ.A ;
  T (i : Nat) : RS.Mat D (s i) (s (suc i)) = CT[i].C.SQ.A ;
  module K0 = Conj3[P,G zero,G (suc zero),p,s zero,s (suc zero),eP,eG zero,eG (suc zero),H.u,H.T zero] ;
  module K (i : Nat) {
   module C = Conj3[G i,G (suc i),G (suc (suc i)),s i,s (suc i),s (suc (suc i)),eG i,eG (suc i),eG (suc (suc i)),H.T i,H.T (suc i)] ;
  } ;
  res : T68.Res D (suc m) p s u T =
   (FM.injective p (s zero) CU.g (CU.injective H.injective),
    (\ dd e -> (FM.compose-zero p (s zero) (s (suc zero)) CU.g CT[zero].C.g (K0.zero (H.pairs.1 dd e).1),
                FM.exact p (s zero) (s (suc zero)) CU.g CT[zero].C.g (K0.exact (H.pairs.1 dd e).2)),
     \ i dd e -> (FM.compose-zero (s i) (s (suc i)) (s (suc (suc i))) CT[i].C.g CT[suc i].C.g (K[i].C.zero (H.pairs.2 i dd e).1),
                  FM.exact (s i) (s (suc i)) (s (suc (suc i))) CT[i].C.g CT[suc i].C.g (K[i].C.exact (H.pairs.2 i dd e).2)))) ;
  -- the last term in coordinates: iota' = iota eG(m+1)^-1 : R^(s (m+1)) ~ R
  module IL = ED.Inv[G (suc m),FM.Free (s (suc m)),eG (suc m)] ;
  module IO = ED.Inv[G (suc m),FM.regular,H.iota] ;
  iota' : MS.LinEquiv (FM.Free (s (suc m))) FM.regular =
   ((\ y -> IO.fun (IL.inv y),
     Pr.qinv (FM.Free (s (suc m))).M R (\ y -> IO.fun (IL.inv y)) (\ c -> IL.fun (IO.inv c))
      (\ c -> trans (ap IO.fun (IL.ret-eq (IO.inv c))) (IO.inv-eq c))
      (\ y -> trans (ap IL.fun (IO.ret-eq (IL.inv y))) (IL.inv-eq y))),
    \ x y -> trans (ap IO.fun (IL.inv-add x y)) (IO.fun-add (IL.inv x) (IL.inv y)),
    \ c x -> trans (ap IO.fun (IL.inv-scale c x)) (IO.fun-scale c (IL.inv x))) ;
  last (y : (FM.Free (s m)).M) : Id R (iota'.1.1 (CT[m].C.g.1 y)) (IO.fun ((H.T m).1 (CT[m].C.IP.inv y))) =
   ap IO.fun (IL.ret-eq ((H.T m).1 (CT[m].C.IP.inv y))) ;
  image' : FR.ImageL N a (FM.Free (s m)) (FM.Free (s (suc m))) CT[m].C.g iota' =
   (\ y -> subst (FR.In N a) (sym (last y)) (H.image.1 (CT[m].C.IP.inv y)),
    \ j -> TC.map ((y : (G m).M) * Id R (IO.fun ((H.T m).1 y)) (a j))
     ((y : (FM.Free (s m)).M) * Id R (iota'.1.1 (CT[m].C.g.1 y)) (a j))
     (\ w -> ((eG m).1.1 w.1,trans (last ((eG m).1.1 w.1))
       (trans (ap (\ t -> IO.fun ((H.T m).1 t)) (CT[m].C.IP.ret-eq w.1)) w.2)))
     (H.image.2 j)) ;

  module TH (es : Id Nat (s (suc m)) (suc zero)) {
   module T9 = T89.Thm89[m,p,s,u,T,res,es] ;
   module Main (r : Nat -> Nat) (ranks : RS.Ranks (suc m) p s r) (st : RS.Stables D (suc m) s r T) (gr : T68.Grades D (suc m) s r T) {
    module MN = T9.Main[r,ranks,st,gr] ;
    module CH = MN.CH ;
    -- cffr's layout: G' 0 = R^0, G' 1 = P, G' (i+2) = G i
    G1 : Nat -> FM.Module = split { zero -> P ; suc i -> G i } ;
    G' : Nat -> FM.Module = split { zero -> FM.Free zero ; suc t -> G1 t } ;
    module IP = ED.Inv[P,FM.Free p,eP] ;
    zero-map : SM.Linear (FM.Free zero) P = (\ x -> IP.inv (FM.Free p).mz,
     \ x y -> trans (ap IP.inv (F.funext (Ps.Fin p) (\ j -> R) _ _ (\ j -> sym (D.1.addZ D.1.z)))) (IP.inv-add (FM.Free p).mz (FM.Free p).mz),
     \ c x -> trans (ap IP.inv (F.funext (Ps.Fin p) (\ j -> R) _ _ (\ j -> sym (L.mul-zero c)))) (IP.inv-scale c (FM.Free p).mz)) ;
    f1 : (t : Nat) -> SM.Linear (G1 t) (G1 (suc t)) = split { zero -> H.u ; suc i -> H.T i } ;
    f' : (t : Nat) -> SM.Linear (G' t) (G' (suc t)) = split { zero -> zero-map ; suc t -> f1 t } ;
    es1 : (t : Nat) -> MS.LinEquiv (G1 t) (FM.Free (MN.d1 t)) = split { zero -> eP ; suc i -> eG i } ;
    id0 : MS.LinEquiv (FM.Free zero) (FM.Free zero) =
     (Pr.idEquiv (FM.Free zero).M,\ x y -> refl ((FM.Free zero).madd x y),\ c x -> refl ((FM.Free zero).sm c x)) ;
    es' : (t : Nat) -> MS.LinEquiv (G' t) (FM.Free (MN.d t)) = split { zero -> id0 ; suc t -> es1 t } ;
    bs : Tr.Trunc[(t : Nat) -> MS.LinEquiv (G' t) (FM.Free (MN.d t))].carrier =
     Tr.Trunc[(t : Nat) -> MS.LinEquiv (G' t) (FM.Free (MN.d t))].inc es' ;
    cz1 : (t : Nat) -> C85.lt (suc t) (suc (suc m)) -> FM.ComposeZeroL (G1 t) (G1 (suc t)) (G1 (suc (suc t))) (f1 t) (f1 (suc t)) = split {
     zero -> \ hh -> (H.pairs.1 m (refl (suc m))).1 ;
     suc i -> \ hh -> (H.pairs.2 i (T89.lt-split (suc i) (suc m) hh).1 (T89.lt-split (suc i) (suc m) hh).2).1 } ;
    cz : (t : Nat) -> C85.lt t (suc (suc m)) -> FM.ComposeZeroL (G' t) (G' (suc t)) (G' (suc (suc t))) (f' t) (f' (suc t)) = split {
     zero -> \ hh x -> trans (ap H.u.1 (SM.Lin[FM.Free p,P,IP.linear].map-z)) (SM.Lin[P,G zero,H.u].map-z) ;
     suc t -> cz1 t } ;
    module SR = SC.Chain[MN.s'].Res[suc m,MN.d,G',f',bs,MN.hd,cz] ;
    -- the hypotheses at the chosen bases (Thm 6.8, as in Thm89) ..
    gm0 : (t : Nat) (hh : C85.lt (suc t) (suc (suc m))) ->
     L84.GrTwo (MI.Index (CH.rk (suc t)) (MN.d (suc t)) (MN.d (suc (suc t)))) (MI.minors (CH.rk (suc t)) (MN.d (suc t)) (MN.d (suc (suc t))) (SR.M es' (suc t))) = split {
     zero -> MN.gm zero ; suc i -> MN.gm (suc i) } ;
    -- .. and for every choice of bases (DkFree)
    module DS (t : Nat) { module DF = DK.Dk[G' (suc t),G' (suc (suc t)),SR.bb (suc t),SR.bb (suc (suc t)),f' (suc t),CH.rk (suc t)] ; } ;
    gm : SR.GradeHyp = \ es t hh -> DS[t].DF.change (MN.d (suc t)) (es' (suc t)) (MN.d (suc (suc t))) (es' (suc (suc t)))
     (MN.d (suc t)) (es (suc t)) (MN.d (suc (suc t))) (es (suc (suc t))) (gm0 t hh) ;
    rg : SR.RegHyp = \ es -> DS[suc m].DF.reg-change (MN.d (suc (suc m))) (es' (suc (suc m))) (MN.d (suc (suc (suc m)))) (es' (suc (suc (suc m))))
     (MN.d (suc (suc m))) (es (suc (suc m))) (MN.d (suc (suc (suc m)))) (es (suc (suc (suc m)))) MN.rg ;
    -- r m = s (m+1): the determinant line of the resolution
    module Case (e : Id Nat (r m) (s (suc m))) {
     module DT = DL.Chain[MN.s'].Res[suc m,MN.d,G',f',bs,MN.hd,cz,gm,rg,e] ;
     module CO = DT.Coordinates[es'] ;
     gcd-one : L86.Gcd (MI.Index (suc zero) (s m) (s (suc m))) (MI.minors (suc zero) (s m) (s (suc m)) (T m)) CO.det =
      subst (\ k -> L86.Gcd (MI.Index k (s m) (s (suc m))) (MI.minors k (s m) (s (suc m)) (T m)) CO.det) (trans e es) CO.gcd ;
     result : T9.Conclusion = inr (CO.det,(gcd-one,CO.regular)) ;
    } ;
    cases1 : (k : Nat) -> Id Nat (r m) (suc k) -> T9.Conclusion = split {
     zero -> \ e -> Case[trans e (sym es)].result ;
     suc k -> \ e -> inl (T9.trivial (MN.big-case k e)) } ;
    cases : (k : Nat) -> Id Nat (r m) k -> T9.Conclusion = split {
     zero -> \ e -> inl (MN.zero-case e) ;
     suc k -> cases1 k } ;
    conclusion : T9.Conclusion = cases (r m) (refl (r m)) ;
   } ;
   conclude : Plus (Id R D.1.o D.1.z) ((r : Nat -> Nat) * RS.Ranks (suc m) p s r * RS.Stables D (suc m) s r T * T68.Grades D (suc m) s r T) ->
    T9.Conclusion = split {
    inl e -> inl (T9.trivial e) ;
    inr w -> Main[w.1,w.2.1,w.2.2.1,w.2.2.2].conclusion } ;
   result : T89U.GcdOfN N a = T89U.Theorem[N,a].claim (s m) (s (suc m)) es CT[m].C.g iota' image' (conclude T9.th.1) ;
  } ;
  cases : Plus (Id R D.1.o D.1.z) (Id Nat (s (suc m)) (suc zero)) -> T89U.GcdOfN N a = split {
   inl e -> T89U.zero-gcd N a (\ j -> T89.all-zero e (a j)) ;
   inr es -> TH[es].result } ;
  result : T89U.GcdOfN N a = cases (FM.rank-one (s (suc m)) iota') ;
 } ;
 -- Theorem 8.9, through Det(F)
 theorem89 (N : Nat) (a : Ps.Fin N -> R) (f : FR.FFRes N a) : Tr.Trunc[T89U.GcdOfN N a].carrier =
  TC.map (FR.Bases f.2.1 f.2.2.1) (T89U.GcdOfN N a) (\ b -> FromBases[N,a,f.1,f.2.1,f.2.2.1,b,f.2.2.2.2].result) f.2.2.2.1 ;
} ;
