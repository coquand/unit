-- The small type of finite free modules, by replacement (cavrep).
-- Modules form a large type (U l+), but it is locally small: its identity
-- types are the small types LinEquiv A B (ModuleSIP2.local-small, sag/sip).  So the
-- image of n |-> R^n (FreeModules.Free : Nat -> Module) is a small type
-- FF : U l, embedded in the modules by module-of, with free n : FF over R^n
-- (free-eq).  Its eliminator into propositions (ff-ind) reduces a property of
-- every finite free module to the R^n.  Every element of FF is merely
-- linearly equivalent to some R^n (ff-finite), and every module with merely a
-- basis is merely in FF (finite-ff).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Rp = Replacement[l,l+] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 module FM = FreeModules[l].Over[Rg,setR] ;
 module MS = FM.MS ;
 Module : U l+ = FM.Module ;
 image : Rp.Image[Nat,Module,FM.Free] = images @l @l+ Nat Module MS.local-small FM.Free ;
 FF : U l = image.carrier ;
 module-of (x : FF) : Module = image.inclusion x ;
 free (n : Nat) : FF = image.quotient n ;
 free-eq (n : Nat) : Id Module (module-of (free n)) (FM.Free n) = image.triangle n ;
 -- induction into propositions
 ff-ind : [j] (P : FF -> U j) -> ((x : FF) -> Prelude[j].isProp (P x)) -> ((n : Nat) -> P (free n)) -> (x : FF) -> P x =
  <j> \ P p b -> (surjections @l @l+ @j Nat Module MS.local-small FM.Free P p).sec b ;
 -- finite free in the sense of FreeModules
 Based (M : Module) : U l = (n : Nat) * MS.LinEquiv M (FM.Free n) ;
 ff-finite (x : FF) : Tr.Trunc[Based (module-of x)].carrier =
  ff-ind @l (\ y -> Tr.Trunc[Based (module-of y)].carrier) (\ y -> Tr.Trunc[Based (module-of y)].proposition)
   (\ n -> Tr.Trunc[Based (module-of (free n))].inc (n,MS.idToIso (module-of (free n)) (FM.Free n) (free-eq n))) x ;
 Fibre (M : Module) : U l+ = (x : FF) * Id Module (module-of x) M ;
 finite-ff (M : Module) (b : Tr.Trunc[Based M].carrier) : Truncation[l+].Trunc[Fibre M].carrier =
  Tr.Trunc[Based M].induction @l+ (\ w -> Truncation[l+].Trunc[Fibre M].carrier) (\ w -> Truncation[l+].Trunc[Fibre M].proposition)
   (\ w -> Truncation[l+].Trunc[Fibre M].inc (free w.1,
     P1.trans Module (module-of (free w.1)) (FM.Free w.1) M (free-eq w.1)
      (P1.sym Module M (FM.Free w.1) (MS.sip M (FM.Free w.1) w.2)))) b ;
} ;
