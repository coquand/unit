-- cffr Theorem 8.9 and Corollary 8.10 in the paper's form.
-- Theorem 8.9.  If the ideal (a_j)_(j<N) has a finite free resolution
-- (FreeResolution.FFRes: finite free modules, linear maps, no bases),
-- then merely the a_j have a gcd, which is regular unless every a_j is 0.
-- Proof.  The goal is a proposition, so take bases of the terms; by the
-- transport lemma (structure identity) the terms are R^p, R^(s i), and the
-- matrices of the maps are a resolution in cffr's sense.  The last term is
-- R^(s (m+1)) ~ R, so s (m+1) = 1 or 1 = 0 (FreeModules.rank-one).  If
-- 1 = 0 every a_j is 0.  Otherwise cffr's Theorem 8.9 (Thm89.theorem89)
-- gives: the 1 x 1 minors of the last matrix vanish, or they have a
-- regular gcd.  For s (m+1) = 1 (path induction on s (m+1) = 1, claim)
-- the minors are the entries c_k and 0 (Cor88.OneRow), the last map
-- followed by iota is y |-> (sum_k y_k c_k) w with w a unit
-- (FreeModules.UnitLine), so (c) = (a) as ideals, and a gcd of the c_k
-- is a gcd of the a_j (GcdIdeal.Same).
-- Corollary 8.10.  If every ideal (a, b) has a finite free resolution then
-- every a, b merely have a gcd, regular unless a = b = 0.  This removes the
-- encoding FFR of cffr/Thm89 (a resolution whose last map has exactly a, b
-- as nonzero entries): the conclusion is cffr's Thm89.GcdOf.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ; module TC = TruncationCombinators[l] ;
module TG = TrueGrade[l] ;
module Over (D : TG.RD) {
 module L = RL[D.1] ;
 module FR = FreeResolution[l].Over[D] ;
 module FM = FR.FM ; module MS = FM.MS ;
 module MI = Minors[l].Over[D.1,D.2] ;
 module L86 = Lemma86[l].Over[D.1,D.2] ;
 module C88 = Cor88[l].Over[D.1,D.2] ;
 module T89 = Thm89[l].Over[D] ;
 module GI = GcdIdeal[l].Over[D.1,D.2] ;
 module DL = MnSums[l].Over[D.1] ;
 R : U l = D.1.R ;
 -- a gcd, regular unless every a_j is 0
 GcdOfN (N : Nat) (a : Ps.Fin N -> R) : U l =
  (g : R) * (L86.Gcd (Ps.Fin N) a g * Plus (L86.RegularElement g) ((j : Ps.Fin N) -> Id R (a j) D.1.z)) ;
 zero-gcd (N : Nat) (a : Ps.Fin N -> R) (h : (j : Ps.Fin N) -> Id R (a j) D.1.z) : GcdOfN N a =
  (D.1.z,((\ j -> D.1.z,\ j -> trans (h j) (sym (L.zero-mul D.1.z))),
   \ s d -> Tr.Trunc[(t : R) * Id R D.1.z (D.1.mul s t)].inc (D.1.z,sym (L.mul-zero s))),inr h) ;
 module Theorem (N : Nat) (a : Ps.Fin N -> R) {
  -- the last map, into R^n ~ R, with the conclusion of cffr's Theorem 8.9
  Claim (r n : Nat) : U l =
   (A : FR.Lin (FM.Free r) (FM.Free n)) (iota : MS.LinEquiv (FM.Free n) FM.regular) ->
   FR.ImageL N a (FM.Free r) (FM.Free n) A iota ->
   Plus (MI.Vanish (suc zero) r n (FM.mat r n A))
    ((g : R) * (L86.Gcd (MI.Index (suc zero) r n) (MI.minors (suc zero) r n (FM.mat r n A)) g * L86.RegularElement g)) ->
   GcdOfN N a ;
  -- n = 1
  module One (r : Nat) (A : FR.Lin (FM.Free r) (FM.Free (suc zero))) (iota : MS.LinEquiv (FM.Free (suc zero)) FM.regular)
   (im : FR.ImageL N a (FM.Free r) (FM.Free (suc zero)) A iota) {
   module UL = FM.UnitLine[iota] ;
   module OR = C88.OneRow[r,FM.mat r (suc zero) A] ;
   c (k : Ps.Fin r) : R = OR.entry k ;
   winv : R = UL.w-unit.1 ;
   -- iota (A y) = (sum_k y_k c_k) w
   last (y : FM.MX.Vec r) : Id R (iota.1.1 (A.1 y)) (D.1.mul (FM.MX.apply r (suc zero) (FM.mat r (suc zero) A) y (inr tt)) UL.w) =
    trans (UL.value (A.1 y)) (ap (\ t -> D.1.mul t UL.w) (FM.apply-mat r (suc zero) A y (inr tt))) ;
   ca (k : Ps.Fin r) : GI.In N a (c k) =
    subst (GI.In N a) (calc R {
     D.1.mul winv (D.1.mul (c k) UL.w)
      =< L.mul-swap winv (c k) UL.w > D.1.mul (c k) (D.1.mul winv UL.w)
      =< ap (D.1.mul (c k)) (trans (D.1.mulC winv UL.w) UL.w-unit.2) > D.1.mul (c k) D.1.o
      =< D.1.mulO (c k) > c k })
     (RegularIdeal[l].Generated[D.1,N,a].ideal.in-mul winv (D.1.mul (c k) UL.w)
      (subst (GI.In N a) (UL.value (A.1 (FM.basis r k))) (im.1 (FM.basis r k)))) ;
   ac (j : Ps.Fin N) : GI.In r c (a j) =
    TC.map ((y : FM.MX.Vec r) * Id R (iota.1.1 (A.1 y)) (a j)) (GI.S.Coordinates r c (a j))
     (\ w -> (\ k -> D.1.mul (w.1 k) UL.w,calc R {
       GI.S.lin r c (\ k -> D.1.mul (w.1 k) UL.w)
        =< GI.S.sum-cong r (\ k -> D.1.mul (c k) (D.1.mul (w.1 k) UL.w)) (\ k -> D.1.mul (D.1.mul (w.1 k) (c k)) UL.w)
            (\ k -> trans (L.mul-swap (c k) (w.1 k) UL.w) (D.1.mulA (w.1 k) (c k) UL.w))
         > GI.S.sum r (\ k -> D.1.mul (D.1.mul (w.1 k) (c k)) UL.w)
        =< DL.sum-scale-right UL.w r (\ k -> D.1.mul (w.1 k) (c k))
         > D.1.mul (FM.MX.apply r (suc zero) (FM.mat r (suc zero) A) w.1 (inr tt)) UL.w
        =< sym (last w.1) > iota.1.1 (A.1 w.1)
        =< w.2 > a j }))
     (im.2 j) ;
   module SA = GI.Same[N,r,a,c,ca,ac] ;
   -- the entries of A vanish: all a_j are 0
   zero-a (v : MI.Vanish (suc zero) r (suc zero) (FM.mat r (suc zero) A)) : (j : Ps.Fin N) -> Id R (a j) D.1.z =
    SA.vanish (\ k -> trans (sym (OR.entry-minor k).2) (v (OR.entry-minor k).1)) ;
   conclude : Plus (MI.Vanish (suc zero) r (suc zero) (FM.mat r (suc zero) A))
    ((g : R) * (L86.Gcd (MI.Index (suc zero) r (suc zero)) (MI.minors (suc zero) r (suc zero) (FM.mat r (suc zero) A)) g * L86.RegularElement g)) ->
    GcdOfN N a = split {
    inl v -> zero-gcd N a (zero-a v) ;
    inr w -> (w.1,(SA.Gcd[w.1,OR.gcd w.1 w.2.1,w.2.2].result,inl w.2.2)) } ;
  } ;
  claim-one (r : Nat) : Claim r (suc zero) = \ A iota im -> One[r,A,iota,im].conclude ;
  claim (r n : Nat) (es : Id Nat n (suc zero)) : Claim r n = subst (Claim r) (sym es) (claim-one r) ;
  -- the resolution with bases
  module FromBases (m : Nat) (P : FR.Module) (G : Nat -> FR.Module) (b : FR.Bases P G) (h : FR.ResOf m N a P G) {
   module TR = FR.Transport[P,G,b] ;
   hf : FR.ResOf m N a (FM.Free TR.p) TR.frees = TR.free-transport (FR.ResOf m N a) h ;
   module MA = FR.Matrix[m,N,a,TR.p,TR.s,hf] ;
   module H = MA.H ;
   cases : Plus (Id R D.1.o D.1.z) (Id Nat (TR.s (suc m)) (suc zero)) -> GcdOfN N a = split {
    inl e -> zero-gcd N a (\ j -> T89.all-zero e (a j)) ;
    inr es -> claim (TR.s m) (TR.s (suc m)) es (H.T m) H.iota H.image
     (T89.Thm89[m,TR.p,TR.s,MA.u,MA.T,MA.res,es].theorem89) } ;
   result : GcdOfN N a = cases (FM.rank-one (TR.s (suc m)) H.iota) ;
  } ;
  -- Theorem 8.9
  theorem89 (f : FR.FFRes N a) : Tr.Trunc[GcdOfN N a].carrier =
   TC.map (FR.Bases f.2.1 f.2.2.1) (GcdOfN N a) (\ b -> FromBases[f.1,f.2.1,f.2.2.1,b,f.2.2.2.2].result) f.2.2.2.1 ;
 } ;

 -- Corollary 8.10
 module Cor810 (h : (a b : R) -> Tr1.Trunc[FR.FFRes (suc (suc zero)) (T89.pair a b)].carrier) (a b : R) {
  module TG2 = Tr.Trunc[T89.GcdOf a b] ;
  pair-zero (g : R) : Plus (L86.RegularElement g) ((j : Ps.Fin (suc (suc zero))) -> Id R (T89.pair a b j) D.1.z) ->
   Plus (L86.RegularElement g) (Id R a D.1.z * Id R b D.1.z) = split {
   inl r -> inl r ; inr v -> inr (v (inl (inr tt)),v (inr tt)) } ;
  pair-form (w : GcdOfN (suc (suc zero)) (T89.pair a b)) : T89.GcdOf a b = (w.1,(w.2.1,pair-zero w.1 w.2.2)) ;
  cor810 : TG2.carrier =
   Tr1.Trunc[FR.FFRes (suc (suc zero)) (T89.pair a b)].induction @l (\ w -> TG2.carrier) (\ w -> TG2.proposition)
    (\ f -> TC.map (GcdOfN (suc (suc zero)) (T89.pair a b)) (T89.GcdOf a b) pair-form
     (Theorem[suc (suc zero),T89.pair a b].theorem89 f)) (h a b) ;
 } ;
} ;
