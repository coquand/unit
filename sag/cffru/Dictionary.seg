-- The coordinate dictionary (cffru, step 2, D of STEP2-DESIGN.md §3).
-- With bases, the structure relation (*) of Buchsbaum-Eisenbud at one stage
--   ∧^q f (x) = a(ρ ↦ x ∧ β(ρ))       (x of degree q)
-- reads, for a matrix B : R^N -> R^g, β = b in Lambda^p(R^N) and
-- γ = c = a(1) in Lambda(R^g):
--   Lambda(B)(x) = top(x ∧ b) c   for x of degree q            (Wedge)
-- and cffr's factored form of Lemma 8.4 is
--   B_K = bhat_K c  for |K| = q,  bhat = unstar(b)             (Factored).
-- They are equivalent (to-wedge, from-wedge), with no sign:
-- top(x ∧ b) = dot(star x, b) = dot(star x, star(unstar b)) = dot(x, bhat)
-- (top-pair: ExteriorDuality.star-pair, ExteriorTranspose.star-isometry).
-- Factored => Wedge: expand x in the basis (map-expansion); Lambda(B)(e_K)
-- = B_K (column-image); x_K = 0 for |K| /= q (x has degree q), and
-- B_K = bhat_K c otherwise; so Lambda(B)(x) = (sum_K x_K bhat_K) c =
-- dot(x, bhat) c.  Wedge => Factored: take x = e_K, of degree |K|.
-- So Lemma 8.4 is (*) (At84.wedge), and so is every stage of a normalised
-- chain of Cor 8.5 (Chain.stage-wedge) and its last factor (Chain.Last.last-wedge):
-- with Thm 8.7, Lambda(M_last)(x) = top(x ∧ beta_T) det omega.  The sign of
-- the Gaps entry (unstar beta = ±beta*) never enters.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ; module H = ExteriorHomogeneous[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module TP = ExteriorTranspose[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module CB = ColumnBlocks[l].Over[Rg,setR] ;
 module MT = MinorTranspose[l].Over[Rg,setR] ;
 module L84 = Lemma84[l].Over[Rg,setR] ;
 module C85 = Cor85[l].Over[Rg,setR] ;
 module FA = Factorisations[l].Over[Rg,setR] ;

 -- top(x ∧ y) = dot(x, unstar y)
 top-pair (n : Nat) (x y : Ext n) : Id R (top n (emul n x y)) (DU.dot n x (DU.unstar n y)) = calc R {
  top n (emul n x y) =< sym (DU.star-pair n x y) > DU.dot n (DU.star n x) y
   =< ap (DU.dot n (DU.star n x)) (sym (DU.star-unstar n y)) > DU.dot n (DU.star n x) (DU.star n (DU.unstar n y))
   =< TP.star-isometry n x (DU.unstar n y) > DU.dot n x (DU.unstar n y) } ;

 -- one stage: B : R^N -> R^g, b = a_(k+1)(1), c = a_k(1)
 module Stage (N g q : Nat) (B : MM.Mat N g) (b : Ext N) (c : Ext g) {
  module MB = MI.Map[N,g,B] ;
  module LB = MT.Laws[N,g,B] ;
  module SR = C.SumMap[R,Ext g,add,eadd g,\ a -> escale g a c,\ a1 a2 -> EA.eadd-scale g a1 a2 c] ;
  bhat : Ext N = DU.unstar N b ;
  Factored : U l = (K : C.Index N) -> Id Nat (BA.count N K) q ->
   Id (Ext g) (CB.Selected[g].selected-product N K B) (escale g (CO.coeff N bhat K) c) ;
  Wedge : U l = (x : Ext N) -> DG.Deg N q x -> Id (Ext g) (MB.value x) (escale g (top N (emul N x b)) c) ;
  module ToWedge (hB : Factored) (x : Ext N) (dx : DG.Deg N q x) {
   term (K : C.Index N) : L84.Dec (BA.count N K) q ->
    Id (Ext g) (escale g (CO.coeff N x K) (CB.Selected[g].selected-product N K B))
     (escale g (mul (CO.coeff N x K) (CO.coeff N bhat K)) c) = split {
    inl e -> trans (ap (escale g (CO.coeff N x K)) (hB K e)) (EA.escale-scale g (CO.coeff N x K) (CO.coeff N bhat K) c) ;
    inr ne -> trans (ap (\ a -> escale g a (CB.Selected[g].selected-product N K B)) (HO.coeff-support N q x dx K ne))
     (trans (EA.zero-scale g (CB.Selected[g].selected-product N K B))
      (sym (trans (ap (\ a -> escale g a c)
        (trans (ap (\ a -> mul a (CO.coeff N bhat K)) (HO.coeff-support N q x dx K ne)) (L.zero-mul (CO.coeff N bhat K))))
       (EA.zero-scale g c)))) } ;
   result : Id (Ext g) (MB.value x) (escale g (top N (emul N x b)) c) = calc (Ext g) {
    MB.value x
     =< CO.map-expansion N g MB.value LB.linear x
     > CO.ES[g].SumE.sum N (\ K -> escale g (CO.coeff N x K) (MB.value (CO.basis N K)))
     =< CO.ES[g].SumE.cong N _ (\ K -> escale g (CO.coeff N x K) (CB.Selected[g].selected-product N K B))
         (\ K -> ap (escale g (CO.coeff N x K)) (LB.column-image K))
     > CO.ES[g].SumE.sum N (\ K -> escale g (CO.coeff N x K) (CB.Selected[g].selected-product N K B))
     =< CO.ES[g].SumE.cong N _ (\ K -> escale g (mul (CO.coeff N x K) (CO.coeff N bhat K)) c)
         (\ K -> term K (H.DecNat.dec (BA.count N K) q))
     > CO.ES[g].SumE.sum N (\ K -> escale g (mul (CO.coeff N x K) (CO.coeff N bhat K)) c)
     =< sym (SR.map N (\ K -> mul (CO.coeff N x K) (CO.coeff N bhat K)))
     > escale g (CO.S.sum N (\ K -> mul (CO.coeff N x K) (CO.coeff N bhat K))) c
     =< ap (\ a -> escale g a c) (sym (CO.dot-sum N x bhat)) > escale g (DU.dot N x bhat) c
     =< ap (\ a -> escale g a c) (sym (top-pair N x b)) > escale g (top N (emul N x b)) c } ;
  } ;
  to-wedge (hB : Factored) : Wedge = \ x dx -> ToWedge[hB,x,dx].result ;
  -- top(e_K ∧ b) = bhat_K
  top-basis (K : C.Index N) : Id R (top N (emul N (CO.basis N K) b)) (CO.coeff N bhat K) =
   trans (top-pair N (CO.basis N K) b) (trans (DU.dot-sym N (CO.basis N K) bhat) (CO.dot-basis N bhat K)) ;
  from-wedge (hW : Wedge) : Factored = \ K e -> calc (Ext g) {
   CB.Selected[g].selected-product N K B =< sym (LB.column-image K) > MB.value (CO.basis N K)
    =< hW (CO.basis N K) (subst (\ k -> DG.Deg N k (CO.basis N K)) e (BA.basis-degree N K))
    > escale g (top N (emul N (CO.basis N K) b)) c
    =< ap (\ a -> escale g a c) (top-basis K) > escale g (CO.coeff N bhat K) c } ;
 } ;

 -- Lemma 8.4 is (*)
 module At84 (e q p g : Nat) (A : MM.Mat e (plus q p)) (B : MM.Mat (plus q p) g)
  (cz : MM.ComposeZero e (plus q p) g A B)
  (a0 : Ext e) (da : DG.Deg e p a0) (ra : MI.RI.Regular (C.Index e) (CO.coeff e a0))
  (b0 : Ext (plus q p)) (db : DG.Deg (plus q p) p b0) (gb : L84.GrTwo (C.Index (plus q p)) (CO.coeff (plus q p) b0))
  (hA : (I : C.Index e) -> Id Nat (BA.count e I) p ->
   Id (Ext (plus q p)) (CB.Selected[plus q p].selected-product e I A) (escale (plus q p) (CO.coeff e a0 I) b0)) {
  module LA = L84.At[e,q,p,g,A,B,cz,a0,da,ra,b0,db,gb,hA] ;
  module SB = Stage[plus q p,g,q,B,b0,LA.gamma] ;
  wedge : SB.Wedge = SB.to-wedge LA.lemma84 ;
 } ;

 -- every stage of a normalised chain is (*), and so is its last factor
 module Chain (s : Nat -> Nat) {
  module FC = FA.Chain[s] ;
  module CH = FC.CH ;
  module Res (T : Nat) (d : Nat -> Nat) (M : (t : Nat) -> MM.Mat (d t) (d (suc t)))
   (hd : (t : Nat) -> C85.lt t (suc T) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)))
   (cz : (t : Nat) -> C85.lt t (suc T) -> MM.ComposeZero (d t) (d (suc t)) (d (suc (suc t))) (M t) (M (suc t)))
   (gm : (t : Nat) -> C85.lt (suc t) (suc T) ->
    L84.GrTwo (MI.Index (CH.rk (suc t)) (d (suc t)) (d (suc (suc t)))) (MI.minors (CH.rk (suc t)) (d (suc t)) (d (suc (suc t))) (M (suc t)))) {
   module FR = FC.Res[T,d,M,hd,cz,gm] ;
   -- the stage at M (t+1): b = beta_t, c = beta_(t+1)
   module At (c : FR.NormChain) (t : Nat) (h : C85.lt (suc t) (suc T)) {
    module SB = Stage[d (suc t),d (suc (suc t)),CH.rk (suc t),M (suc t),c.1 t (C85.lt-pred t (suc T) h),c.1 (suc t) h] ;
    factored : SB.Factored = c.2.1 (suc t) h ;
    wedge : SB.Wedge = SB.to-wedge factored ;
   } ;
   stage-wedge (c : FR.NormChain) (t : Nat) (h : C85.lt (suc t) (suc T)) : At[c,t,h].SB.Wedge = At[c,t,h].wedge ;
   -- the last factor: b = beta_T, c = gamma (only D(M (T+1)) regular)
   module Last (rg : MI.RegularD (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T))) {
    module FI = C85.Fi[CH.rk (suc T),d (suc T),d (suc (suc T)),M (suc T),FR.RS.final rg] ;
    module SB = Stage[d (suc T),d (suc (suc T)),CH.rk (suc T),M (suc T),FR.center.1 T (C85.lt-self T),FI.gamma] ;
    last-wedge : SB.Wedge = SB.to-wedge
     (FA.last-eq (d T) (CH.rk T) (CH.rk (suc T)) (d (suc (suc T))) (d (suc T)) (hd T (C85.lt-self T)) (M T) (M (suc T))
      (cz T (C85.lt-self T)) (FR.RS.stage T (C85.lt-self T)) rg) ;
    -- with Thm 8.7 (F_0 = R^(r_1)): Lambda(M_last)(x) = top(x ∧ beta_T) det omega
    module Det (ed : Id Nat (CH.rk (suc T)) (d (suc (suc T)))) {
     module DT = FR.Det[rg,ed] ;
     det-wedge (x : Ext (d (suc T))) (dx : DG.Deg (d (suc T)) (CH.rk (suc T)) x) :
      Id (Ext (d (suc (suc T)))) (SB.MB.value x)
       (escale (d (suc (suc T))) (mul (top (d (suc T)) (emul (d (suc T)) x (FR.center.1 T (C85.lt-self T)))) DT.TH.det)
        (DG.omega (d (suc (suc T))))) =
      trans (last-wedge x dx)
       (trans (ap (escale (d (suc (suc T))) (top (d (suc T)) (emul (d (suc T)) x (FR.center.1 T (C85.lt-self T))))) DT.TH.gamma-value)
        (EA.escale-scale (d (suc (suc T))) (top (d (suc T)) (emul (d (suc T)) x (FR.center.1 T (C85.lt-self T)))) DT.TH.det
         (DG.omega (d (suc (suc T)))))) ;
    } ;
   } ;
  } ;
 } ;
} ;
