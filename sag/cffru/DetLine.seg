-- The determinant line of a complex (cffru, step 2, T3; cffr Thm 8.7).
-- In the setting of Structure.Chain.Res, with F_0 = ∧^(r_1) of the last
-- module a line (ed: rk (T+1) = d (T+2)):
--   Det(F) := R_(T+1) (a line, det-line), and
--   a_Det : Det(F) -> ∧^(r_1) G (T+2), the last map of the unique
--   structure (the centre of Structure.contractible).
-- Nothing here depends on a basis.  Bases es give the basis element ρ of
-- Det(F) (iota-last^-1(1)) and the matrices; then (Coordinates)
--   to(a_Det(ρ)) = det ω       (value; det = Thm87's Cayley determinant),
-- because a_Det is the last map of Structure.Center (structure-prop), whose
-- coordinate at ρ is the last factor gamma = det ω.  So cffr's Cayley
-- determinant is a_Det at ρ, with no sign.
-- The image of a_Det (InImage: the values λ(a_Det φ), λ a linear form) is
-- the gcd ideal of the r_1-minors of the last matrix (GcdTorsor.InGcd),
-- for every choice of bases: a_Det(φ) = ev(φ) a_Det(ρ) = ev(φ) det w with
-- w = from(ω) (image-to), and x = det t is the top coordinate of
-- a_Det(t ρ) (image-from); Thm 8.7 says det is a (regular) gcd.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module SC = Structure[l].Over[Rg,setR] ;
 module SS = SC.SS ; module TL = SC.TL ; module SM = SC.SM ; module ED = SC.ED ; module FM = SC.FM ; module MS = SC.MS ;
 module DG = SC.DG ; module MI = SC.MI ; module LN = SC.LN ; module C85 = SC.C85 ;
 module GT = GcdTorsor[l].Over[Rg,setR] ;
 module L86 = GT.L86 ;

 module Chain (s : Nat -> Nat) {
  module CH = C85.Chain[s] ;
  module Res (T : Nat) (d : Nat -> Nat) (G : Nat -> FM.Module) (f : (t : Nat) -> SM.Linear (G t) (G (suc t)))
   (bs : Tr.Trunc[(t : Nat) -> MS.LinEquiv (G t) (FM.Free (d t))].carrier)
   (hd : (t : Nat) -> C85.lt t (suc T) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)))
   (cz : (t : Nat) -> C85.lt t (suc T) -> FM.ComposeZeroL (G t) (G (suc t)) (G (suc (suc t))) (f t) (f (suc t)))
   (gm : SC.Chain[s].Res[T,d,G,f,bs,hd,cz].GradeHyp) (rg : SC.Chain[s].Res[T,d,G,f,bs,hd,cz].RegHyp)
   (ed : Id Nat (CH.rk (suc T)) (d (suc (suc T)))) {
   module SR = SC.Chain[s].Res[T,d,G,f,bs,hd,cz] ;
   -- Det(F) and a_Det
   Det : FM.Module = SS.RkOf (G (suc T)) (SR.bb (suc T)) (CH.rk (suc T)) (CH.rk T) (SR.Lns T) ;
   det-line : LN.Line Det =
    LN.hom-line (SR.Lns T) SR.TopP[T].P.carrier (SR.lines T (C85.lt-self T))
     TL.Top[G (suc T),SR.bb (suc T),plus (CH.rk (suc T)) (CH.rk T),d (suc T),hd T (C85.lt-self T),SR.bG (suc T)].line ;
   F0 : FM.Module = SR.TargetP[suc T].P.carrier ;
   F0-line : LN.Line F0 = TL.Top[G (suc (suc T)),SR.bb (suc (suc T)),CH.rk (suc T),d (suc (suc T)),ed,SR.bG (suc (suc T))].line ;
   canonical : SR.Structure = (SR.contractible gm rg).1 ;
   aDet : SM.Linear Det F0 = canonical.1.2 ;
   -- the image of a_Det
   InImage (x : R) : U l = Tr.Trunc[(phi : Det.M) * (lam : SM.Linear F0 FM.regular) * Id R (lam.1 (aDet.1 phi)) x].carrier ;

   module Coordinates (es : SR.Bs) {
    module CE = SR.Center[es,gm,rg] ;
    module CS = CE.Co[T,C85.lt-self T].CS ;
    module TH = CE.LS.Det[ed].DT.TH ;
    module IQ = TL.Inverse[G (suc (suc T)),SR.bb (suc (suc T)),d (suc (suc T)),es (suc (suc T))] ;
    module PQ = TL.Piece[G (suc (suc T)),SR.bb (suc (suc T)),CH.rk (suc T)] ;
    n : Nat = d (suc (suc T)) ;
    -- the basis element of Det(F) given by the bases
    rho : Det.M = CE.iota-last.1.2.sec o ;
    det : R = TH.det ;
    -- the two names of ρ (the stage's HomLine.mk 1 and the centre's iota-last^-1 1)
    rho-eq : Id Det.M CS.rho rho = refl rho ;
    a-eq : Id (SM.Linear Det F0) CE.last aDet = ap (\ u -> u.1.2) (SR.structure-prop CE.center canonical) ;
    -- to(a_Det(ρ)) = det ω
    value : Id (Ext n) (IQ.CE.to.1 (aDet.1 rho).1) (escale n det (DG.omega n)) =
     trans (ap (\ a -> IQ.CE.to.1 (a.1 rho).1) (sym a-eq)) (trans CE.FL.at-unit TH.gamma-value) ;
    -- Thm 8.7: det is a regular gcd of the r_1-minors of the last matrix
    gcd : L86.Gcd (MI.Index (CH.rk (suc T)) (d (suc T)) n) (MI.minors (CH.rk (suc T)) (d (suc T)) n (SR.M es (suc T))) det = TH.theorem87 ;
    regular : L86.RegularElement det = TH.det-regular ;
    -- a_Det(ρ) = det w, w = from(ω)
    w : F0.M = (IQ.from.1 (DG.omega n),IQ.from-degree (CH.rk (suc T)) (DG.omega n)
     (subst (\ k -> DG.Deg n k (DG.omega n)) (sym ed) (TL.omega-degree n))) ;
    a-rho : Id F0.M (aDet.1 rho) (F0.sm det w) = PQ.SB.eq _ _ (IQ.to-inj _ _
     (trans value (sym (trans (IQ.CE.to.2.2.1 det (IQ.from.1 (DG.omega n))) (ap (escale n det) (IQ.to-from (DG.omega n))))))) ;
    -- the image of a_Det is the gcd ideal
    module GA = GT.At[MI.Index (CH.rk (suc T)) (d (suc T)) n,MI.minors (CH.rk (suc T)) (d (suc T)) n (SR.M es (suc T))] ;
    module PG (x : R) { module P = GA.Principal[det,gcd,x] ; } ;
    multiple (phi : Det.M) (lam : SM.Linear F0 FM.regular) : Id R (lam.1 (aDet.1 phi)) (mul det (mul (CS.HL.ev phi) (lam.1 w))) = calc R {
     lam.1 (aDet.1 phi) =< ap lam.1 (CS.At[aDet].value phi) > lam.1 (F0.sm (CS.HL.ev phi) (aDet.1 CS.rho))
      =< ap (\ x -> lam.1 (F0.sm (CS.HL.ev phi) (aDet.1 x))) rho-eq > lam.1 (F0.sm (CS.HL.ev phi) (aDet.1 rho))
      =< lam.2.2 (CS.HL.ev phi) (aDet.1 rho) > mul (CS.HL.ev phi) (lam.1 (aDet.1 rho))
      =< ap (\ y -> mul (CS.HL.ev phi) (lam.1 y)) a-rho > mul (CS.HL.ev phi) (lam.1 (F0.sm det w))
      =< ap (mul (CS.HL.ev phi)) (lam.2.2 det w) > mul (CS.HL.ev phi) (mul det (lam.1 w))
      =< L.mul-swap (CS.HL.ev phi) det (lam.1 w) > mul det (mul (CS.HL.ev phi) (lam.1 w)) } ;
    image-to (x : R) (h : InImage x) : GA.InGcd x = PG[x].P.from
     (TC.map ((phi : Det.M) * (lam : SM.Linear F0 FM.regular) * Id R (lam.1 (aDet.1 phi)) x) ((t : R) * Id R x (mul det t))
      (\ u -> (mul (CS.HL.ev u.1) (u.2.1.1 w),trans (sym u.2.2) (multiple u.1 u.2.1))) h) ;
    -- the top coordinate is a linear form on F0
    module TB = TL.TopBasis[G (suc (suc T)),SR.bb (suc (suc T)),CH.rk (suc T),n,ed,es (suc (suc T))] ;
    topform : SM.Linear F0 FM.regular = FM.lin F0 FM.regular TB.line ;
    top-rho : Id R (topform.1 (aDet.1 rho)) det =
     trans (ap (top n) value) (trans (DG.top-scale n det (DG.omega n)) (trans (ap (mul det) (DG.top-omega n)) (mulO det))) ;
    image-from (x : R) (h : GA.InGcd x) : InImage x =
     TC.map ((t : R) * Id R x (mul det t)) ((phi : Det.M) * (lam : SM.Linear F0 FM.regular) * Id R (lam.1 (aDet.1 phi)) x)
      (\ u -> (Det.sm u.1 rho,(topform,calc R {
       topform.1 (aDet.1 (Det.sm u.1 rho)) =< ap topform.1 (aDet.2.2 u.1 rho) > topform.1 (F0.sm u.1 (aDet.1 rho))
        =< topform.2.2 u.1 (aDet.1 rho) > mul u.1 (topform.1 (aDet.1 rho))
        =< ap (mul u.1) top-rho > mul u.1 det
        =< mulC u.1 det > mul det u.1 =< sym u.2 > x })))
      (PG[x].P.to h) ;
    -- a_Det is injective: top(a_Det(φ)) = det ev(φ), det is regular, and φ = ev(φ) ρ
    top-value (phi : Det.M) : Id R (topform.1 (aDet.1 phi)) (mul det (CS.HL.ev phi)) = calc R {
     topform.1 (aDet.1 phi) =< ap topform.1 (CS.At[aDet].value phi) > topform.1 (F0.sm (CS.HL.ev phi) (aDet.1 rho))
      =< topform.2.2 (CS.HL.ev phi) (aDet.1 rho) > mul (CS.HL.ev phi) (topform.1 (aDet.1 rho))
      =< ap (mul (CS.HL.ev phi)) top-rho > mul (CS.HL.ev phi) det
      =< mulC (CS.HL.ev phi) det > mul det (CS.HL.ev phi) } ;
    injective (phi phi' : Det.M) (h : Id F0.M (aDet.1 phi) (aDet.1 phi')) : Id Det.M phi phi' =
     trans (CS.line-value phi) (trans (ap (\ c -> Det.sm c CS.rho)
      (ap (\ u -> u.1) (GT.GI.cofactor-prop det regular (topform.1 (aDet.1 phi))
        (CS.HL.ev phi,top-value phi) (CS.HL.ev phi',trans (ap topform.1 h) (top-value phi')))))
      (sym (CS.line-value phi'))) ;
   } ;
   -- without bases
   injective (phi phi' : Det.M) (h : Id F0.M (aDet.1 phi) (aDet.1 phi')) : Id Det.M phi phi' =
    Tr.Trunc[SR.Bs].induction @l (\ w -> Id Det.M phi phi') (\ w -> Det.setM phi phi') (\ es -> Coordinates[es].injective phi phi' h) bs ;
  } ;
 } ;
} ;
