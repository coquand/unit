-- D_k of a linear map between finite free modules, without bases (cffru,
-- step 1 leftover).
-- f : M -> N linear, M, N finite free.  D_k(f) is given by its generators,
-- the coefficients of ∧^k f against linear forms: for v_1, .., v_k in M
-- and λ : ∧N -> R linear,
--   value (v, λ) = λ(f v_1 ∧ ... ∧ f v_k)       (= λ(∧f(v_1 ∧ ... ∧ v_k))),
-- the image form of D_k (cffr's MinorForms) with no basis.  The hypotheses
-- of cffr §8 are stated for this family: Gr >= 2 (GrTwo) and regularity
-- (Regular).
-- Ideals seen by Gr >= 2 (Within).  For a family b on B, x is within b when
-- (Kill) every r with b r = 0 has x r = 0, and (Quot) for every y with
-- b_K y_L = b_L y_K there is merely w with b_L w = x y_L for all L.  These x
-- form an ideal containing every b_m (w = y_m), so it contains the ideal
-- generated by b.
-- Transfer: if Gr(a) >= 2 and every a_i is within b, then Gr(b) >= 2.
-- Proof.  b is regular: r b = 0 gives r a = 0 (Kill), so r = 0.  Let y be
-- proportional for b.  For each i the w of (Quot) is unique (b regular), so
-- by unique choice z_i with b_L z_i = a_i y_L.  z is proportional for a
-- (multiply a_i z_j and a_j z_i by b_L: both are a_i a_j y_L), so
-- z = t a.  Then a_i (y_m - t b_m) = b_m z_i - t a_i b_m = 0 for all i, and
-- y_m = t b_m since a is regular.  (Enlarge in cffr's Lemma 8.4 is the case
-- where every a_i is some b_m or 0.)  RegTransfer: the regular part alone.
-- Coordinates (Coords).  Bases eM : M ~ R^p, eN : N ~ R^q, A the matrix of
-- eN f eM^-1 (ExteriorDegreeM.Square).  (1) The k-minor of A at (c, I) is
-- the value at v_t = eM^-1(e_(c t)), λ = coeff_I . to_eN (minor-value):
-- to_eN(f v_1 ∧ ... ∧ f v_k) = wedge of the A eM(v_t) (to-value; to_eN is
-- an algebra map with to_eN(i w) = gen(eN w), and eN f = A eM on vectors).
-- (2) Every value is within the k-minors of A: the coefficients of the
-- wedge of A eM(v_t) are (MinorKill.Image, for the ideal Within the minors),
-- and λ(x) = λ(from(to x)) is a linear form in to x, so a sum of products
-- with its coefficients (ExteriorDuality.representation, dot-sum).
-- Hence Gr(D_k(f)) >= 2 iff Gr(D_k(A)) >= 2, and D_k(f) regular iff D_k(A)
-- regular, for every choice of bases (to-free, from-free, reg-to-free,
-- reg-from-free); so cffr's hypotheses for one choice of bases give them
-- for every choice (change, reg-change).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module C = ExteriorCoordinates[l] ;
module IP = RegularIdeal[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module TL = TopLine[l].Over[Rg,setR] ;
 module ED = TL.ED ; module EF = TL.EF ; module FM = TL.FM ; module FF = TL.FF ; module SM = TL.SM ; module MS = TL.MS ;
 module MM = TL.MM ; module MI = TL.MI ; module RI = MI.RI ;
 module CO = C.Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module L84 = Lemma84[l].Over[Rg,setR] ;
 module MK = MinorKill[l].Over[Rg,setR] ;
 module DM = MnSums[l].Over[Rg] ;

 -- regularity of b: b_L u = b_L v for all L gives u = v
 cancel (B : U l) (b : B -> R) (rb : RI.Regular B b) (u v : R) (h : (L' : B) -> Id R (mul (b L') u) (mul (b L') v)) : Id R u v =
  L84.eq-from-sub u v (rb (add u (neg v)) tt (\ L' -> calc R {
   mul (b L') (add u (neg v)) =< dist (b L') u (neg v) > add (mul (b L') u) (mul (b L') (neg v))
    =< ap (add (mul (b L') u)) (L.mul-neg (b L') v) > add (mul (b L') u) (neg (mul (b L') v))
    =< ap (\ c -> add c (neg (mul (b L') v))) (h L') > add (mul (b L') v) (neg (mul (b L') v))
    =< addN (mul (b L') v) > z })) ;

 -- the elements within a family b
 module Within (B : U l) (b : B -> R) {
  Propor (y : B -> R) : U l = (K L' : B) -> Id R (mul (b K) (y L')) (mul (b L') (y K)) ;
  Kill (x : R) : U l = (r : R) -> RI.ZeroOn B b r -> Id R (mul x r) z ;
  Quot (x : R) : U l = (y : B -> R) -> Propor y -> Tr.Trunc[(w : R) * ((L' : B) -> Id R (mul (b L') w) (mul x (y L')))].carrier ;
  In (x : R) : U l = Kill x * Quot x ;
  module QT (x : R) (y : B -> R) { module T = Tr.Trunc[(w : R) * ((L' : B) -> Id R (mul (b L') w) (mul x (y L')))] ; } ;
  in-zero : In z = (\ r h -> L.zero-mul r,
   \ y hy -> QT[z,y].T.inc (z,\ L' -> trans (L.mul-zero (b L')) (sym (L.zero-mul (y L'))))) ;
  in-add (x x' : R) (h : In x) (h' : In x') : In (add x x') =
   (\ r k -> trans (L.dist-left x x' r) (trans (Ps.cong2 R add _ _ _ _ (h.1 r k) (h'.1 r k)) (addZ z)),
    \ y hy -> TruncationCombinators[l].map2
     ((w : R) * ((L' : B) -> Id R (mul (b L') w) (mul x (y L')))) ((w : R) * ((L' : B) -> Id R (mul (b L') w) (mul x' (y L'))))
     ((w : R) * ((L' : B) -> Id R (mul (b L') w) (mul (add x x') (y L'))))
     (\ u u' -> (add u.1 u'.1,\ L' -> trans (dist (b L') u.1 u'.1)
       (trans (Ps.cong2 R add _ _ _ _ (u.2 L') (u'.2 L')) (sym (L.dist-left x x' (y L'))))))
     (h.2 y hy) (h'.2 y hy)) ;
  in-mul (c x : R) (h : In x) : In (mul c x) =
   (\ r k -> trans (sym (mulA c x r)) (trans (ap (mul c) (h.1 r k)) (L.mul-zero c)),
    \ y hy -> TruncationCombinators[l].map
     ((w : R) * ((L' : B) -> Id R (mul (b L') w) (mul x (y L')))) ((w : R) * ((L' : B) -> Id R (mul (b L') w) (mul (mul c x) (y L'))))
     (\ u -> (mul c u.1,\ L' -> trans (L.mul-swap (b L') c u.1) (trans (ap (mul c) (u.2 L')) (mulA c x (y L')))))
     (h.2 y hy)) ;
  ideal : IP.IdealPred[Rg] = IP.mkIdealPred Rg In in-zero in-add in-mul ;
  generator (m : B) : In (b m) = (\ r k -> k m, \ y hy -> QT[b m,y].T.inc (y m,\ L' -> hy L' m)) ;
  in-eq (x x' : R) (e : Id R x x') (h : In x) : In x' = subst In e h ;
  -- sums over the subsets of n generators
  in-sum : (n : Nat) (g : C.Index n -> R) -> ((i : C.Index n) -> In (g i)) -> In (CO.S.sum n g) = split {
   zero -> \ g h -> h tt ;
   suc n | r -> \ g h -> in-add _ _ (r (\ i -> g (inl i)) (\ i -> h (inl i))) (r (\ i -> g (inr i)) (\ i -> h (inr i))) } ;
 } ;

 -- the regular part
 reg-transfer (A B : U l) (a : A -> R) (b : B -> R) (ra : RI.Regular A a) (ha : (i : A) -> Within[B,b].Kill (a i)) : RI.Regular B b =
  \ x t h -> ra x tt (\ i -> ha i x h) ;

 -- Gr(a) >= 2 and a within b give Gr(b) >= 2
 module Transfer (A B : U l) (a : A -> R) (b : B -> R) (ga : L84.GrTwo A a) (ha : (i : A) -> Within[B,b].In (a i)) {
  module WB = Within[B,b] ;
  regular : RI.Regular B b = reg-transfer A B a b ga.1 (\ i -> (ha i).1) ;
  module Fam (y : B -> R) (hy : WB.Propor y) {
   Q (i : A) : U l = (w : R) * ((L' : B) -> Id R (mul (b L') w) (mul (a i) (y L'))) ;
   q-prop (i : A) : Pr.isProp (Q i) = \ u v ->
    Pr.Sigma-eq R (\ w -> (L' : B) -> Id R (mul (b L') w) (mul (a i) (y L'))) u.1 v.1 u.2 v.2
     (cancel B b regular u.1 v.1 (\ L' -> trans (u.2 L') (sym (v.2 L'))))
     (F.isProp-Pi B (\ L' -> Id R (mul (b L') v.1) (mul (a i) (y L'))) (\ L' -> setR (mul (b L') v.1) (mul (a i) (y L')))) ;
   -- unique choice
   zq (i : A) : Q i = Tr.Trunc[Q i].induction @l (\ w -> Q i) (\ w -> q-prop i) (\ u -> u) ((ha i).2 y hy) ;
   zz (i : A) : R = (zq i).1 ;
   zz-eq (i : A) (L' : B) : Id R (mul (b L') (zz i)) (mul (a i) (y L')) = (zq i).2 L' ;
   prop (i j : A) : Id R (mul (a i) (zz j)) (mul (a j) (zz i)) = cancel B b regular _ _ (\ L' -> calc R {
    mul (b L') (mul (a i) (zz j)) =< L.mul-swap (b L') (a i) (zz j) > mul (a i) (mul (b L') (zz j))
     =< ap (mul (a i)) (zz-eq j L') > mul (a i) (mul (a j) (y L'))
     =< L.mul-swap (a i) (a j) (y L') > mul (a j) (mul (a i) (y L'))
     =< ap (mul (a j)) (sym (zz-eq i L')) > mul (a j) (mul (b L') (zz i))
     =< L.mul-swap (a j) (b L') (zz i) > mul (b L') (mul (a j) (zz i)) }) ;
   m0 : L84.Multiple A a zz = L84.multiple A a ga zz prop ;
   t : R = m0.1 ;
   module At (m : B) {
    x : R = add (y m) (neg (mul t (b m))) ;
    -- a_i y_m and a_i (t b_m) are both b_m (t a_i)
    via-z (i : A) : Id R (mul (a i) (y m)) (mul (b m) (mul t (a i))) =
     trans (sym (zz-eq i m)) (ap (mul (b m)) (m0.2 i)) ;
    via-t (i : A) : Id R (mul (a i) (mul t (b m))) (mul (b m) (mul t (a i))) =
     trans (L.mul-swap (a i) t (b m)) (trans (ap (mul t) (mulC (a i) (b m))) (L.mul-swap t (b m) (a i))) ;
    kill (i : A) : Id R (mul (a i) x) z = calc R {
     mul (a i) x =< dist (a i) (y m) (neg (mul t (b m))) > add (mul (a i) (y m)) (mul (a i) (neg (mul t (b m))))
      =< ap (add (mul (a i) (y m))) (L.mul-neg (a i) (mul t (b m))) > add (mul (a i) (y m)) (neg (mul (a i) (mul t (b m))))
      =< Ps.cong2 R (\ s s' -> add s (neg s')) _ _ _ _ (via-z i) (via-t i)
      > add (mul (b m) (mul t (a i))) (neg (mul (b m) (mul t (a i))))
      =< addN (mul (b m) (mul t (a i))) > z } ;
    result : Id R (y m) (mul t (b m)) = L84.eq-from-sub (y m) (mul t (b m)) (ga.1 x tt kill) ;
   } ;
  } ;
  result : L84.GrTwo B b = (regular,\ y hy ->
   Tr.Trunc[L84.Multiple B b y].inc (Fam[y,hy].t,\ m -> Fam[y,hy].At[m].result)) ;
 } ;

 -- the product of k generators of ∧M, and its coordinates
 module Prod (M : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) {
  module LM = EF.Lam[M,bM] ;
  prod : (k : Nat) -> (Ps.Fin k -> M.M) -> LM.alg.A = split {
   zero -> \ v -> LM.alg.one ;
   suc k | r -> \ v -> LM.alg.mul (r (\ t -> v (inl t))) (LM.gen.1 (v (inr tt))) } ;
  module At (n : Nat) (e : MS.LinEquiv M (FM.Free n)) {
   module CE = ED.Coord[M,bM,n,e] ;
   to-prod : (k : Nat) (v : Ps.Fin k -> M.M) -> Id (Ext n) (CE.to.1 (prod k v)) (MM.wedge k n (\ t -> e.1.1 (v t))) = split {
    zero -> \ v -> CE.to.2.2.2.2 ;
    suc k | r -> \ v -> trans (CE.to.2.2.2.1 (prod k (\ t -> v (inl t))) (LM.gen.1 (v (inr tt))))
     (Ps.cong2 (Ext n) (emul n) _ _ _ _ (r (\ t -> v (inl t))) (CE.to-gen (v (inr tt)))) } ;
  } ;
 } ;

 -- D_k(f), by its generators
 module Dk (M N : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) (bN : Tr.Trunc[FF.Based N].carrier)
  (f : SM.Linear M N) (k : Nat) {
  module PN = Prod[N,bN] ;
  Form : U l = SM.Linear (TL.alg-mod PN.LM.alg) FM.regular ;
  Gen : U l = (Ps.Fin k -> M.M) * Form ;
  image (v : Ps.Fin k -> M.M) : PN.LM.alg.A = PN.prod k (\ t -> f.1 (v t)) ;
  value (g : Gen) : R = g.2.1 (image g.1) ;
  GrTwo : U l = L84.GrTwo Gen value ;
  Regular : U l = RI.Regular Gen value ;
  module WD = Within[Gen,value] ;

  module Coords (p : Nat) (eM : MS.LinEquiv M (FM.Free p)) (q : Nat) (eN : MS.LinEquiv N (FM.Free q)) {
   module SQ = ED.Square[M,N,bM,bN,f,q,eN,p,eM] ;
   A : MM.Mat p q = SQ.A ;
   module IN = TL.Inverse[N,bN,q,eN] ;
   module CN = IN.CE ;
   module PA = PN.At[q,eN] ;
   module WM = Within[MI.Index k p q,MI.minors k p q A] ;
   module IE = IdealExt[l].Over[Rg,setR,WM.ideal] ;
   coords (v : Ps.Fin k -> M.M) : MM.Mat k p = \ t -> eM.1.1 (v t) ;
   -- to_eN(f v_1 ∧ ... ∧ f v_k) = the wedge of the A eM(v_t)
   to-value (v : Ps.Fin k -> M.M) : Id (Ext q) (CN.to.1 (image v)) (MM.wedge k q (MK.compose k p q A (coords v))) =
    trans (PA.to-prod k (\ t -> f.1 (v t)))
     (ap (MM.wedge k q) (F.funext (Ps.Fin k) (\ t -> MM.Vec q) (\ t -> eN.1.1 (f.1 (v t))) (MK.compose k p q A (coords v))
      (\ t -> sym (SQ.on-gen (v t))))) ;
   -- (1) every k-minor of A is a value
   form (I : C.Index q) : Form = (\ x -> CO.coeff q (CN.to.1 x) I,
    \ x y -> trans (ap (\ w -> CO.coeff q w I) (CN.to.2.1 x y)) (CO.coeff-add q (CN.to.1 x) (CN.to.1 y) I),
    \ a x -> trans (ap (\ w -> CO.coeff q w I) (CN.to.2.2.1 a x)) (CO.coeff-scale q a (CN.to.1 x) I)) ;
   colvec (c : Ps.Fin k -> Ps.Fin p) : Ps.Fin k -> M.M = \ t -> eM.1.2.sec (DM.delta p (c t)) ;
   minor-gen (ci : MI.Index k p q) : Gen = (colvec ci.1,form ci.2) ;
   minor-value (ci : MI.Index k p q) : Id R (value (minor-gen ci)) (MI.minors k p q A ci) =
    ap (\ w -> CO.coeff q w ci.2) (trans (to-value (colvec ci.1))
     (ap (MM.wedge k q) (F.funext (Ps.Fin k) (\ t -> MM.Vec q) (MK.compose k p q A (coords (colvec ci.1))) (MK.cols k p q A ci.1)
      (\ t -> trans (ap (MM.apply p q A) (eM.1.2.sec-eq (DM.delta p (ci.1 t)))) (MI.Map[p,q,A].apply-delta (ci.1 t)))))) ;
   minor-in (ci : MI.Index k p q) : WD.In (MI.minors k p q A ci) =
    WD.in-eq (value (minor-gen ci)) (MI.minors k p q A ci) (minor-value ci) (WD.generator (minor-gen ci)) ;
   -- (2) every value is within the k-minors of A
   coeff-in (v : Ps.Fin k -> M.M) : IE.InCoeff q (CN.to.1 (image v)) =
    IE.in-eq q (MM.wedge k q (MK.compose k p q A (coords v))) (CN.to.1 (image v)) (sym (to-value v))
     (MK.Image[p,q,A,WM.ideal].result k (\ c I -> WM.generator (c,I)) (coords v)) ;
   module FormIn (lam : Form) {
    g (w : Ext q) : R = lam.1 (IN.from.1 w) ;
    g-lin : DU.Linear q g = (\ x y -> trans (ap lam.1 (IN.from.2.1 x y)) (lam.2.1 (IN.from.1 x) (IN.from.1 y)),
     \ a x -> trans (ap lam.1 (IN.from.2.2.1 a x)) (lam.2.2 a (IN.from.1 x))) ;
    -- λ(x) = sum_I (dual g)_I (to x)_I
    result (x : PN.LM.alg.A) (h : IE.InCoeff q (CN.to.1 x)) : WM.In (lam.1 x) =
     WM.in-eq (CO.S.sum q (\ i -> mul (CO.coeff q (DU.dual q g) i) (CO.coeff q (CN.to.1 x) i))) (lam.1 x)
      (sym (trans (ap lam.1 (sym (IN.from-to x))) (trans (DU.representation q g g-lin (CN.to.1 x)) (CO.dot-sum q (DU.dual q g) (CN.to.1 x)))))
      (WM.in-sum q (\ i -> mul (CO.coeff q (DU.dual q g) i) (CO.coeff q (CN.to.1 x) i))
       (\ i -> WM.in-mul (CO.coeff q (DU.dual q g) i) (CO.coeff q (CN.to.1 x) i) (h i))) ;
   } ;
   value-in (u : Gen) : WM.In (value u) = FormIn[u.2].result (image u.1) (coeff-in u.1) ;
   -- the hypotheses, basis-free and in coordinates
   to-free (gm : L84.GrTwo (MI.Index k p q) (MI.minors k p q A)) : GrTwo =
    Transfer[MI.Index k p q,Gen,MI.minors k p q A,value,gm,minor-in].result ;
   from-free (gm : GrTwo) : L84.GrTwo (MI.Index k p q) (MI.minors k p q A) =
    Transfer[Gen,MI.Index k p q,value,MI.minors k p q A,gm,value-in].result ;
   reg-to-free (rg : MI.RegularD k p q A) : Regular =
    reg-transfer (MI.Index k p q) Gen (MI.minors k p q A) value rg (\ ci -> (minor-in ci).1) ;
   reg-from-free (rg : Regular) : MI.RegularD k p q A =
    reg-transfer Gen (MI.Index k p q) value (MI.minors k p q A) rg (\ u -> (value-in u).1) ;
  } ;
  -- cffr's hypotheses do not depend on the bases
  change (p : Nat) (eM : MS.LinEquiv M (FM.Free p)) (q : Nat) (eN : MS.LinEquiv N (FM.Free q))
   (p' : Nat) (eM' : MS.LinEquiv M (FM.Free p')) (q' : Nat) (eN' : MS.LinEquiv N (FM.Free q'))
   (gm : L84.GrTwo (MI.Index k p q) (MI.minors k p q Coords[p,eM,q,eN].A)) :
   L84.GrTwo (MI.Index k p' q') (MI.minors k p' q' Coords[p',eM',q',eN'].A) =
   Coords[p',eM',q',eN'].from-free (Coords[p,eM,q,eN].to-free gm) ;
  reg-change (p : Nat) (eM : MS.LinEquiv M (FM.Free p)) (q : Nat) (eN : MS.LinEquiv N (FM.Free q))
   (p' : Nat) (eM' : MS.LinEquiv M (FM.Free p')) (q' : Nat) (eN' : MS.LinEquiv N (FM.Free q'))
   (rg : MI.RegularD k p q Coords[p,eM,q,eN].A) : MI.RegularD k p' q' Coords[p',eM',q',eN'].A =
   Coords[p',eM',q',eN'].reg-from-free (Coords[p,eM,q,eN].reg-to-free rg) ;
 } ;
} ;
