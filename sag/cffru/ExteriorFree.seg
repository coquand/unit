-- The exterior algebra of a finite free module (cffru, step 2, E1-E3).
-- For a module M, an alternating map j : M -> A into an algebra is linear
-- with j(v)^2 = 0 (AltM); (E, i) is an exterior algebra of M when every
-- alternating j : M -> A extends uniquely to an algebra map E -> A
-- (IsExteriorM: precomposition with i is an equivalence).  On R^n these are
-- exterior/'s notions (Alt n, IsExterior n: same definitions, since the
-- operations of R^n are pointwise), so the type ExteriorM (R^n) is
-- contractible (ExteriorContr.contractible).  Contractibility is a
-- proposition, and a finite free M is merely R^n (structure identity), so
-- ExteriorM M is contractible for every finite free M (contractible).  Its
-- centre is "the" exterior algebra: Lam M with generators gen M, no basis
-- chosen.  A linear map f : M -> N gives the algebra map wedge f, the
-- extension of gen N . f (functoriality: wedge-gen).
level l ; open Ring[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module FM = FreeModules[l].Over[Rg,setR] ;
 module FF = FiniteFree[l].Over[Rg,setR] ;
 module MS = FM.MS ;
 module SM = FM.SM ;
 module S = AlgSIP[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module EC = ExteriorContr[l].Over[Rg,setR] ; module ECU = ExteriorContrUA[l].Over[Rg,setR] ;
 -- alternating maps out of a module
 AltM (M : FM.Module) (A : S.Alg) : U l =
  (j : M.M -> A.A) *
  ((((x y : M.M) -> Id A.A (j (M.madd x y)) (A.add (j x) (j y))) *
    ((c : R) (x : M.M) -> Id A.A (j (M.sm c x)) (A.scale c (j x)))) *
   ((x : M.M) -> Id A.A (A.mul (j x) (j x)) A.zero)) ;
 -- on R^n they are exterior/'s alternating maps
 alt-free (n : Nat) (A : S.Alg) (j : AltM (FM.Free n) A) : EC.Alt n A = j ;
 precompM (M : FM.Module) (E : S.Alg) (i : AltM M E) (A : S.Alg) (f : AL.AlgHom E A) : AltM M A =
  (\ a -> f.1 (i.1 a),
   ((\ a b -> trans (ap f.1 (i.2.1.1 a b)) (f.2.1 (i.1 a) (i.1 b)),
     \ c a -> trans (ap f.1 (i.2.1.2 c a)) (f.2.2.1 c (i.1 a))),
    \ a -> trans (sym (f.2.2.2.1 (i.1 a) (i.1 a))) (trans (ap f.1 (i.2.2 a)) AL.In[A].H[E,f].zero))) ;
 IsExteriorM (M : FM.Module) (E : S.Alg) (i : AltM M E) : U l+ =
  (A : S.Alg) -> Pr.isEquiv (AL.AlgHom E A) (AltM M A) (precompM M E i A) ;
 PairsM (M : FM.Module) : U l+ = (E : S.Alg) * AltM M E ;
 ExteriorM (M : FM.Module) : U l+ = (p : PairsM M) * IsExteriorM M p.1 p.2 ;
 -- on R^n, ExteriorM is exterior/'s Exterior
 exterior-free (n : Nat) (c : ExteriorM (FM.Free n)) : EC.Exterior n = c ;
 contractible-free (n : Nat) : FunExtUA[l+].isContr (ExteriorM (FM.Free n)) = ECU.contractible n ;
 -- every finite free module has a contractible type of exterior algebras
 contr-prop (M : FM.Module) : P1.isProp (FunExtUA[l+].isContr (ExteriorM M)) = Torsor[l+].isProp-isContr (ExteriorM M) ;
 contractible (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) : FunExtUA[l+].isContr (ExteriorM M) =
  Tr.Trunc[FF.Based M].induction @l+ (\ w -> FunExtUA[l+].isContr (ExteriorM M)) (\ w -> contr-prop M)
   (\ w -> P1.subst FM.Module (\ X -> FunExtUA[l+].isContr (ExteriorM X)) (FM.Free w.1) M
     (P1.sym FM.Module M (FM.Free w.1) (MS.sip M (FM.Free w.1) w.2)) (contractible-free w.1)) b ;
 -- alternating maps are determined by their underlying function
 alt-prop (M : FM.Module) (A : S.Alg) (j : M.M -> A.A) :
  Pr.isProp ((((x y : M.M) -> Id A.A (j (M.madd x y)) (A.add (j x) (j y))) *
    ((c : R) (x : M.M) -> Id A.A (j (M.sm c x)) (A.scale c (j x)))) *
   ((x : M.M) -> Id A.A (A.mul (j x) (j x)) A.zero)) =
  S.prod _ _ (S.prod _ _ (S.PH[A.A,A.set,M.M].p2 (\ x y -> j (M.madd x y)) (\ x y -> A.add (j x) (j y)))
    (S.PH[A.A,A.set,M.M].r1 (\ c x -> j (M.sm c x)) (\ c x -> A.scale c (j x))))
   (S.PH[A.A,A.set,M.M].p1 (\ x -> A.mul (j x) (j x)) (\ x -> A.zero)) ;
 alt-eq (M : FM.Module) (A : S.Alg) (j k : AltM M A) (h : (v : M.M) -> Id A.A (j.1 v) (k.1 v)) : Id (AltM M A) j k =
  Pr.Sigma-eq (M.M -> A.A) (\ g -> (((x y : M.M) -> Id A.A (g (M.madd x y)) (A.add (g x) (g y))) *
    ((c : R) (x : M.M) -> Id A.A (g (M.sm c x)) (A.scale c (g x)))) *
   ((x : M.M) -> Id A.A (A.mul (g x) (g x)) A.zero)) j.1 k.1 j.2 k.2
   (F.funext M.M (\ v -> A.A) j.1 k.1 h) (alt-prop M A k.1) ;
 -- "the" exterior algebra of a finite free module
 module Lam (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) {
  centre : ExteriorM M = (contractible M b).1 ;
  alg : S.Alg = centre.1.1 ;
  gen : AltM M alg = centre.1.2 ;
  universal : IsExteriorM M alg gen = centre.2 ;
  -- the extension of an alternating map, and its value on generators
  ext (A : S.Alg) (j : AltM M A) : AL.AlgHom alg A = (universal A).sec j ;
  ext-gen (A : S.Alg) (j : AltM M A) (v : M.M) : Id A.A ((ext A j).1 (gen.1 v)) (j.1 v) =
   ap (\ k -> k.1 v) ((universal A).sec-eq j) ;
  -- algebra maps out of Lam M agreeing on generators are equal
  hom-eq (A : S.Alg) (f g : AL.AlgHom alg A) (h : (v : M.M) -> Id A.A (f.1 (gen.1 v)) (g.1 (gen.1 v))) : Id (AL.AlgHom alg A) f g =
   Equivalences[l].injective (AL.AlgHom alg A) (AltM M A) (precompM M alg gen A) (universal A) f g
    (alt-eq M A (precompM M alg gen A f) (precompM M alg gen A g) h) ;
 } ;
 -- a linear map is alternating into the exterior algebra of the target
 module Wedge (M N : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) (bN : Tr.Trunc[FF.Based N].carrier) (f : SM.Linear M N) {
  module LM = Lam[M,bM] ; module LN = Lam[N,bN] ;
  alt : AltM M LN.alg =
   (\ v -> LN.gen.1 (f.1 v),
    ((\ x y -> trans (ap LN.gen.1 (f.2.1 x y)) (LN.gen.2.1.1 (f.1 x) (f.1 y)),
      \ c x -> trans (ap LN.gen.1 (f.2.2 c x)) (LN.gen.2.1.2 c (f.1 x))),
     \ x -> LN.gen.2.2 (f.1 x))) ;
  -- wedge f : Lam M -> Lam N, with wedge f (gen v) = gen (f v)
  wedge : AL.AlgHom LM.alg LN.alg = LM.ext LN.alg alt ;
  wedge-gen (v : M.M) : Id LN.alg.A (wedge.1 (LM.gen.1 v)) (LN.gen.1 (f.1 v)) = LM.ext-gen LN.alg alt v ;
 } ;
 -- functoriality
 lin-id (M : FM.Module) : SM.Linear M M = (\ v -> v,\ x y -> refl (M.madd x y),\ c x -> refl (M.sm c x)) ;
 module Functor (M : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) {
  module LM = Lam[M,bM] ;
  wedge-id : Id (AL.AlgHom LM.alg LM.alg) Wedge[M,M,bM,bM,lin-id M].wedge (EC.idHom LM.alg) =
   LM.hom-eq LM.alg Wedge[M,M,bM,bM,lin-id M].wedge (EC.idHom LM.alg) (\ v -> Wedge[M,M,bM,bM,lin-id M].wedge-gen v) ;
 } ;
 module Compose (M N Q : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) (bN : Tr.Trunc[FF.Based N].carrier)
  (bQ : Tr.Trunc[FF.Based Q].carrier) (f : SM.Linear M N) (g : SM.Linear N Q) {
  module WF = Wedge[M,N,bM,bN,f] ; module WG = Wedge[N,Q,bN,bQ,g] ;
  gf : SM.Linear M Q = (\ v -> g.1 (f.1 v),
   \ x y -> trans (ap g.1 (f.2.1 x y)) (g.2.1 (f.1 x) (f.1 y)),
   \ c x -> trans (ap g.1 (f.2.2 c x)) (g.2.2 c (f.1 x))) ;
  module WGF = Wedge[M,Q,bM,bQ,gf] ;
  wedge-comp : Id (AL.AlgHom WF.LM.alg WG.LN.alg) WGF.wedge (AL.comp WF.LM.alg WF.LN.alg WG.LN.alg WG.wedge WF.wedge) =
   WF.LM.hom-eq WG.LN.alg WGF.wedge (AL.comp WF.LM.alg WF.LN.alg WG.LN.alg WG.wedge WF.wedge)
    (\ v -> trans (WGF.wedge-gen v) (sym (trans (ap WG.wedge.1 (WF.wedge-gen v)) (WG.wedge-gen (f.1 v))))) ;
 } ;
} ;
