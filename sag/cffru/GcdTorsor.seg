-- The gcd as a torsor (cffru, step 3).
-- Let a : X -> R.  A regular gcd of the a_K is unique up to a unique unit:
-- the type RegGcd of regular gcds is a set (being a regular gcd is a
-- proposition: the cofactors of a regular element are unique, the rest are
-- propositions), the units act by g |-> g w, and when it is merely
-- inhabited it is an R^x-torsor (torsor).
-- Proof of transitivity: for regular gcds g, g', merely g = g' u and
-- g' = g v (each divides the a_K, hence the other); then g (v u) = g, so
-- v u = 1 (g regular), and g' = g v with v a unit.  Freeness: g w = g w'
-- gives w = w' (g regular).  So each fibre of w |-> g w is a proposition
-- that is merely inhabited, hence contractible.
-- The gcd ideal (InGcd): x is in it when merely some gcd divides x.
-- It is defined without choosing a gcd, and for every gcd g it is (g)
-- (Principal), regular or not: two gcds divide each other.  Conversely
-- (FromGen), when merely there is a gcd, a regular generator of the gcd
-- ideal is a regular gcd, so the regular gcds are exactly the regular
-- generators of the gcd ideal.
-- Corollary 8.10 sharpened (Cor810): under its hypothesis, if a, b are not
-- both 0 the regular gcds of a, b form an R^x-torsor; for all a, b the gcd
-- ideal is merely principal.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module TG = TrueGrade[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module L = RL[Rg] ;
 module L86 = Lemma86[l].Over[Rg,setR] ;
 module GI = GcdIdeal[l].Over[Rg,setR] ;
 module PU = PicardUnits[l].Over[Rg,setR] ;
 module TB = Torsor[l].TorBase[PU.group] ;
 regular-prop (g : R) : Pr.isProp (L86.RegularElement g) =
  F.isProp-Pi R (\ x -> Id R (mul g x) z -> Id R x z) (\ x ->
   F.isProp-Pi (Id R (mul g x) z) (\ h -> Id R x z) (\ h -> setR x z)) ;
 -- the cofactors of a regular element are unique
 divides-prop (X : U l) (a : X -> R) (g : R) (rg : L86.RegularElement g) : Pr.isProp (L86.Divides X g a) = \ c c' ->
  Pr.Sigma-eq (X -> R) (\ d -> (K : X) -> Id R (a K) (mul g (d K))) c.1 c'.1 c.2 c'.2
   (F.funext X (\ K -> R) c.1 c'.1 (\ K -> ap (\ w -> w.1) (GI.cofactor-prop g rg (a K) (c.1 K,c.2 K) (c'.1 K,c'.2 K))))
   (F.isProp-Pi X (\ K -> Id R (a K) (mul g (c'.1 K))) (\ K -> setR (a K) (mul g (c'.1 K)))) ;
 -- g generates the ideal Q (a predicate on R): Q = (g)
 Generates (Q : R -> U l) (g : R) : U l =
  (x : R) -> (Q x -> Tr.Trunc[(t : R) * Id R x (mul g t)].carrier) * (Tr.Trunc[(t : R) * Id R x (mul g t)].carrier -> Q x) ;
 generates-prop (Q : R -> U l) (qp : (x : R) -> Pr.isProp (Q x)) (g : R) : Pr.isProp (Generates Q g) =
  F.isProp-Pi R (\ x -> (Q x -> Tr.Trunc[(t : R) * Id R x (mul g t)].carrier) * (Tr.Trunc[(t : R) * Id R x (mul g t)].carrier -> Q x)) (\ x ->
   GI.L84.HO.prod-prop (Q x -> Tr.Trunc[(t : R) * Id R x (mul g t)].carrier) (Tr.Trunc[(t : R) * Id R x (mul g t)].carrier -> Q x)
    (F.isProp-Pi (Q x) (\ h -> Tr.Trunc[(t : R) * Id R x (mul g t)].carrier) (\ h -> Tr.Trunc[(t : R) * Id R x (mul g t)].proposition))
    (F.isProp-Pi (Tr.Trunc[(t : R) * Id R x (mul g t)].carrier) (\ h -> Q x) (\ h -> qp x))) ;
 module At (X : U l) (a : X -> R) {
  IsRegGcd (g : R) : U l = L86.Gcd X a g * L86.RegularElement g ;
  greatest-prop (g : R) : Pr.isProp ((s : R) -> L86.Divides X s a -> Tr.Trunc[(t : R) * Id R g (mul s t)].carrier) =
   F.isProp-Pi R (\ s -> L86.Divides X s a -> Tr.Trunc[(t : R) * Id R g (mul s t)].carrier) (\ s ->
    F.isProp-Pi (L86.Divides X s a) (\ d -> Tr.Trunc[(t : R) * Id R g (mul s t)].carrier) (\ d ->
     Tr.Trunc[(t : R) * Id R g (mul s t)].proposition)) ;
  is-prop (g : R) : Pr.isProp (IsRegGcd g) = \ u v ->
   Pr.Sigma-eq (L86.Gcd X a g) (\ w -> L86.RegularElement g) u.1 v.1 u.2 v.2
    (Pr.Sigma-eq (L86.Divides X g a) (\ d -> (s : R) -> L86.Divides X s a -> Tr.Trunc[(t : R) * Id R g (mul s t)].carrier)
      u.1.1 v.1.1 u.1.2 v.1.2 (divides-prop X a g u.2 u.1.1 v.1.1) (greatest-prop g))
    (regular-prop g) ;
  RegGcd : U l = (g : R) * IsRegGcd g ;
  gcd (t : RegGcd) : R = t.1 ;
  eq (t t' : RegGcd) (h : Id R t.1 t'.1) : Id RegGcd t t' = Pr.Sigma-eq R IsRegGcd t.1 t'.1 t.2 t'.2 h (is-prop t'.1) ;
  set : Pr.isSet RegGcd = Torsor[l].isSet-sub R IsRegGcd setR is-prop ;
  -- the action of the units
  module Act (w : PU.Unit) (t : RegGcd) {
   g : R = t.1 ;
   gw : R = mul g w.1 ;
   cancel (c : R) : Id R (mul gw (mul w.2.1 c)) (mul g c) = calc R {
    mul gw (mul w.2.1 c) =< sym (mulA g w.1 (mul w.2.1 c)) > mul g (mul w.1 (mul w.2.1 c))
     =< ap (mul g) (trans (mulA w.1 w.2.1 c) (trans (ap (\ s -> mul s c) w.2.2) (L.one-left c))) > mul g c } ;
   divides : L86.Divides X gw a =
    (\ K -> mul w.2.1 (t.2.1.1.1 K),\ K -> trans (t.2.1.1.2 K) (sym (cancel (t.2.1.1.1 K)))) ;
   greatest (s : R) (d : L86.Divides X s a) : Tr.Trunc[(u : R) * Id R gw (mul s u)].carrier =
    TC.map ((u : R) * Id R g (mul s u)) ((u : R) * Id R gw (mul s u))
     (\ m -> (mul m.1 w.1,trans (ap (\ y -> mul y w.1) m.2) (sym (mulA s m.1 w.1))))
     (t.2.1.2 s d) ;
   regular : L86.RegularElement gw = \ x h ->
    L.unit-reg w.1 x w.2 (t.2.2 (mul w.1 x) (trans (mulA g w.1 x) h)) ;
   result : RegGcd = (gw,((divides,greatest),regular)) ;
  } ;
  act (w : PU.Unit) (t : RegGcd) : RegGcd = Act[w,t].result ;
  ad : TB.AD RegGcd act = \ u v t -> eq _ _ (calc R {
   mul t.1 (mul u.1 v.1) =< ap (mul t.1) (mulC u.1 v.1) > mul t.1 (mul v.1 u.1)
    =< mulA t.1 v.1 u.1 > mul (mul t.1 v.1) u.1 }) ;
  ze : TB.ZE RegGcd act = \ t -> eq _ _ (mulO t.1) ;
  -- freeness: the fibres are propositions
  free (t t' : RegGcd) : Pr.isProp ((w : PU.Unit) * Id RegGcd (act w t) t') = \ u v ->
   Pr.Sigma-eq PU.Unit (\ w -> Id RegGcd (act w t) t') u.1 v.1 u.2 v.2
    (PU.eq u.1 v.1 (ap (\ m -> m.1) (GI.cofactor-prop t.1 t.2.2 t'.1
      (u.1.1,sym (ap gcd u.2)) (v.1.1,sym (ap gcd v.2)))))
    (set (act v.1 t) t') ;
  -- transitivity: merely a unit
  module Trans (t t' : RegGcd) {
   module DV (u v : R) (hu : Id R t.1 (mul t'.1 u)) (hv : Id R t'.1 (mul t.1 v)) {
    vu : Id R (mul v u) o = GI.L84.eq-from-sub (mul v u) o (t.2.2 (add (mul v u) (neg o)) (calc R {
     mul t.1 (add (mul v u) (neg o)) =< dist t.1 (mul v u) (neg o) > add (mul t.1 (mul v u)) (mul t.1 (neg o))
      =< Ps.cong2 R add _ _ _ _ (trans (mulA t.1 v u) (trans (ap (\ s -> mul s u) (sym hv)) (sym hu))) (L.mul-neg t.1 o)
       > add t.1 (neg (mul t.1 o))
      =< ap (\ s -> add t.1 (neg s)) (mulO t.1) > add t.1 (neg t.1)
      =< addN t.1 > z })) ;
    unit : PU.Unit = (v,u,vu) ;
    hit : (w : PU.Unit) * Id RegGcd (act w t) t' = (unit,eq _ _ (sym hv)) ;
   } ;
   fiber : Tr.Trunc[(w : PU.Unit) * Id RegGcd (act w t) t'].carrier =
    TC.bind2 ((u : R) * Id R t.1 (mul t'.1 u)) ((v : R) * Id R t'.1 (mul t.1 v)) ((w : PU.Unit) * Id RegGcd (act w t) t')
     (\ u v -> Tr.Trunc[(w : PU.Unit) * Id RegGcd (act w t) t'].inc (DV[u.1,v.1,u.2,v.2].hit))
     (t.2.1.2 t'.1 t'.2.1.1) (t'.2.1.2 t.1 t.2.1.1) ;
  } ;
  ft : TB.FT RegGcd act = \ t t' ->
   (Tr.Trunc[(w : PU.Unit) * Id RegGcd (act w t) t'].induction @l (\ m -> (w : PU.Unit) * Id RegGcd (act w t) t')
     (\ m -> free t t') (\ x -> x) Trans[t,t'].fiber,
    \ y -> free t t' _ y) ;
  -- the regular gcds, when merely there is one, form an R^x-torsor
  torsor (h : Tr.Trunc[RegGcd].carrier) : TB.TorStr RegGcd = (act,(set,(ad,(ze,(ft,h))))) ;

  -- the gcd ideal, without a choice of gcd
  InGcd (x : R) : U l = Tr.Trunc[(g : R) * L86.Gcd X a g * ((t : R) * Id R x (mul g t))].carrier ;
  -- for every gcd g it is the ideal (g)
  module Principal (g : R) (gc : L86.Gcd X a g) (x : R) {
   to (h : InGcd x) : Tr.Trunc[(t : R) * Id R x (mul g t)].carrier =
    TC.bind ((g' : R) * L86.Gcd X a g' * ((t : R) * Id R x (mul g' t))) ((t : R) * Id R x (mul g t))
     (\ m -> TC.map ((u : R) * Id R m.1 (mul g u)) ((t : R) * Id R x (mul g t))
       (\ k -> (mul k.1 m.2.2.1,trans m.2.2.2 (trans (ap (\ y -> mul y m.2.2.1) k.2) (sym (mulA g k.1 m.2.2.1)))))
       (m.2.1.2 g gc.1)) h ;
   from (h : Tr.Trunc[(t : R) * Id R x (mul g t)].carrier) : InGcd x =
    TC.map ((t : R) * Id R x (mul g t)) ((g' : R) * L86.Gcd X a g' * ((t : R) * Id R x (mul g' t))) (\ m -> (g,(gc,m))) h ;
  } ;
  in-gcd-prop (x : R) : Pr.isProp (InGcd x) = Tr.Trunc[(g : R) * L86.Gcd X a g * ((t : R) * Id R x (mul g t))].proposition ;
  -- a gcd generates the gcd ideal
  generates (g : R) (gc : L86.Gcd X a g) : Generates InGcd g = \ x -> (Principal[g,gc,x].to,Principal[g,gc,x].from) ;
  -- conversely, if merely there is a gcd, a regular generator of the gcd ideal is a regular gcd.
  -- Proof: g0 a gcd, g a generator; g0 and g are in the ideal (g0) = (g), so g0 = g t and
  -- g = g0 u; then g divides the a_K (a_K = g0 d_K = g (t d_K)) and every common divisor s
  -- of the a_K divides g0, hence g (g = g0 u).
  module FromGen (g : R) (rg : L86.RegularElement g) (ig : Generates InGcd g) {
   module Both (g0 : R) (gc : L86.Gcd X a g0) (t u : R) (ht : Id R g0 (mul g t)) (hu : Id R g (mul g0 u)) {
    divides : L86.Divides X g a = (\ K -> mul t (gc.1.1 K),
     \ K -> trans (gc.1.2 K) (trans (ap (\ y -> mul y (gc.1.1 K)) ht) (sym (mulA g t (gc.1.1 K))))) ;
    greatest (s : R) (d : L86.Divides X s a) : Tr.Trunc[(v : R) * Id R g (mul s v)].carrier =
     TC.map ((v : R) * Id R g0 (mul s v)) ((v : R) * Id R g (mul s v))
      (\ k -> (mul k.1 u,trans hu (trans (ap (\ y -> mul y u) k.2) (sym (mulA s k.1 u))))) (gc.2 s d) ;
    result : IsRegGcd g = ((divides,greatest),rg) ;
   } ;
   module From (g0 : R) (gc : L86.Gcd X a g0) {
    g0-in : Tr.Trunc[(t : R) * Id R g0 (mul g t)].carrier =
     (ig g0).1 (Principal[g0,gc,g0].from (Tr.Trunc[(t : R) * Id R g0 (mul g0 t)].inc (o,sym (mulO g0)))) ;
    g-in : Tr.Trunc[(u : R) * Id R g (mul g0 u)].carrier =
     Principal[g0,gc,g].to ((ig g).2 (Tr.Trunc[(t : R) * Id R g (mul g t)].inc (o,sym (mulO g)))) ;
    result : IsRegGcd g =
     Tr.Trunc[(t : R) * Id R g0 (mul g t)].induction @l (\ w -> IsRegGcd g) (\ w -> is-prop g) (\ tt' ->
      Tr.Trunc[(u : R) * Id R g (mul g0 u)].induction @l (\ w -> IsRegGcd g) (\ w -> is-prop g) (\ uu ->
       Both[g0,gc,tt'.1,uu.1,tt'.2,uu.2].result) g-in) g0-in ;
   } ;
   result (h : Tr.Trunc[(g0 : R) * L86.Gcd X a g0].carrier) : IsRegGcd g =
    Tr.Trunc[(g0 : R) * L86.Gcd X a g0].induction @l (\ w -> IsRegGcd g) (\ w -> is-prop g) (\ w -> From[w.1,w.2].result) h ;
  } ;
 } ;
} ;

-- Corollary 8.10, sharpened
module Cor (D : TG.RD) (h : (a b : D.1.R) -> Truncation[l+].Trunc[FreeResolution[l].Over[D].FFRes (suc (suc zero)) (Thm89[l].Over[D].pair a b)].carrier) (a b : D.1.R) {
 module GT = Over[D.1,D.2] ;
 module T89 = Thm89[l].Over[D] ;
 module A2 = GT.At[Ps.Fin (suc (suc zero)),T89.pair a b] ;
 module C = Thm89U[l].Over[D].Cor810[h,a,b] ;
 -- a, b not both 0: the regular gcds form an R^x-torsor
 pick (nz : Not (Id D.1.R a D.1.z * Id D.1.R b D.1.z)) (g : D.1.R) :
  Plus (GT.L86.RegularElement g) (Id D.1.R a D.1.z * Id D.1.R b D.1.z) -> GT.L86.RegularElement g = split {
  inl r -> r ; inr e -> efq (nz e) } ;
 regular (nz : Not (Id D.1.R a D.1.z * Id D.1.R b D.1.z)) (w : T89.GcdOf a b) : A2.RegGcd = (w.1,(w.2.1,pick nz w.1 w.2.2)) ;
 torsor (nz : Not (Id D.1.R a D.1.z * Id D.1.R b D.1.z)) : GT.TB.TorStr A2.RegGcd =
  A2.torsor (TC.map (T89.GcdOf a b) A2.RegGcd (regular nz) C.cor810) ;
 -- for all a, b: the gcd ideal is merely principal
 Generator (g : D.1.R) : U l = GT.Generates A2.InGcd g ;
 principal : Tr.Trunc[(g : D.1.R) * Generator g].carrier =
  TC.map (T89.GcdOf a b) ((g : D.1.R) * Generator g) (\ w -> (w.1,A2.generates w.1 w.2.1)) C.cor810 ;
} ;
