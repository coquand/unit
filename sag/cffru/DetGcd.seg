-- The regular gcds are the bases of Det(F) (cffru, step 3 through step 2).
-- Generic part (Free).  Let a : K -> R be linear and injective.  A basis of
-- K is an element φ generating K freely (c φ = c' φ gives c = c', and every
-- ψ is merely some c φ; a proposition).  The image of a (Image) is the
-- ideal of the values a(ψ).  Then φ |-> a(φ) is an equivalence from the
-- bases of K to the regular generators g of the image (equiv):
--  - a(φ) is regular: a(φ) x = 0 gives a(x φ) = a(0 φ), so x = 0; it
--    generates the image, since ψ = c φ gives a(ψ) = a(φ) c (FromBasis).
--  - conversely g = g 1 is in the image, so g = a(φ) for a unique φ (a is
--    injective); φ is a basis: c φ = c' φ gives g c = g c', so c = c' (g
--    regular), and a(ψ) = g t = a(t φ) gives ψ = t φ (FromGen).
-- The resolution (At).  For an FFRes of (a_j) with last rank 1
-- (DetFFR.Canonical), the last term G (m+1) ~ R by the resolution's iota,
-- so iota followed by R ~ R^1 is a basis e1 of G (m+1), given with the data,
-- and the top coordinate for e1 is a linear equivalence J : ∧^1 G (m+1) ~ R
-- (TopLine.TopBasis).  So a_1 = J a_Det : Det(F) -> R, with no choice; it is
-- injective (DetLine.injective), and its image is the image of a_Det (every
-- linear form on ∧^1 G (m+1) is J times a scalar).  With DetFFR.Canonical
-- (regular gcds = regular generators of the image of a_Det) the regular
-- gcds of the a_j are the a_1(φ), φ a basis of Det(F): bases-eq, an
-- identity of types by univalence, and the bases of Det(F) form an
-- R^x-torsor (bases-torsor).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
module TG = TrueGrade[l] ;

module Free (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module GT = GcdTorsor[l].Over[Rg,setR] ;
 module L86 = GT.L86 ; module HO = GT.GI.L84.HO ;
 module FM = FreeModules[l].Over[Rg,setR] ;
 module SM = FM.SM ;
 module Gen (K : FM.Module) (a : SM.Linear K FM.regular) (inj : (x y : K.M) -> Id R (a.1 x) (a.1 y) -> Id K.M x y) {
  Basis (phi : K.M) : U l = ((c c' : R) -> Id K.M (K.sm c phi) (K.sm c' phi) -> Id R c c') *
   ((psi : K.M) -> Tr.Trunc[(c : R) * Id K.M psi (K.sm c phi)].carrier) ;
  basis-prop (phi : K.M) : Pr.isProp (Basis phi) =
   HO.prod-prop ((c c' : R) -> Id K.M (K.sm c phi) (K.sm c' phi) -> Id R c c') ((psi : K.M) -> Tr.Trunc[(c : R) * Id K.M psi (K.sm c phi)].carrier)
    (F.isProp-Pi R (\ c -> (c' : R) -> Id K.M (K.sm c phi) (K.sm c' phi) -> Id R c c') (\ c ->
     F.isProp-Pi R (\ c' -> Id K.M (K.sm c phi) (K.sm c' phi) -> Id R c c') (\ c' ->
      F.isProp-Pi (Id K.M (K.sm c phi) (K.sm c' phi)) (\ h -> Id R c c') (\ h -> setR c c'))))
    (F.isProp-Pi K.M (\ psi -> Tr.Trunc[(c : R) * Id K.M psi (K.sm c phi)].carrier) (\ psi ->
     Tr.Trunc[(c : R) * Id K.M psi (K.sm c phi)].proposition)) ;
  Bases : U l = (phi : K.M) * Basis phi ;
  -- the image of a
  Image (y : R) : U l = Tr.Trunc[(phi : K.M) * Id R (a.1 phi) y].carrier ;
  image-prop (y : R) : Pr.isProp (Image y) = Tr.Trunc[(phi : K.M) * Id R (a.1 phi) y].proposition ;
  RegGen (g : R) : U l = L86.RegularElement g * GT.Generates Image g ;
  reggen-prop (g : R) : Pr.isProp (RegGen g) =
   HO.prod-prop (L86.RegularElement g) (GT.Generates Image g) (GT.regular-prop g) (GT.generates-prop Image image-prop g) ;
  Gens : U l = (g : R) * RegGen g ;
  -- a basis gives a regular generator
  module FromBasis (phi : K.M) (b : Basis phi) {
   g : R = a.1 phi ;
   av (c : R) : Id R (a.1 (K.sm c phi)) (mul g c) = trans (a.2.2 c phi) (mulC c g) ;
   regular : L86.RegularElement g = \ x h -> b.1 x z (inj (K.sm x phi) (K.sm z phi)
    (trans (av x) (trans h (trans (sym (L.mul-zero g)) (sym (av z)))))) ;
   to (y : R) (hy : Image y) : Tr.Trunc[(t : R) * Id R y (mul g t)].carrier =
    TC.bind ((psi : K.M) * Id R (a.1 psi) y) ((t : R) * Id R y (mul g t))
     (\ u -> TC.map ((c : R) * Id K.M u.1 (K.sm c phi)) ((t : R) * Id R y (mul g t))
       (\ v -> (v.1,trans (sym u.2) (trans (ap a.1 v.2) (av v.1)))) (b.2 u.1)) hy ;
   from (y : R) (ht : Tr.Trunc[(t : R) * Id R y (mul g t)].carrier) : Image y =
    TC.map ((t : R) * Id R y (mul g t)) ((psi : K.M) * Id R (a.1 psi) y) (\ v -> (K.sm v.1 phi,trans (av v.1) (sym v.2))) ht ;
   result : RegGen g = (regular,\ y -> (to y,from y)) ;
  } ;
  to-gens (w : Bases) : Gens = (a.1 w.1,FromBasis[w.1,w.2].result) ;
  -- a regular generator comes from a unique basis
  fib-prop (g : R) : Pr.isProp ((phi : K.M) * Id R (a.1 phi) g) = \ u v ->
   Pr.Sigma-eq K.M (\ phi -> Id R (a.1 phi) g) u.1 v.1 u.2 v.2 (inj u.1 v.1 (trans u.2 (sym v.2))) (setR (a.1 v.1) g) ;
  module FromGen (g : R) (t : RegGen g) {
   fib : (phi : K.M) * Id R (a.1 phi) g =
    Tr.Trunc[(phi : K.M) * Id R (a.1 phi) g].induction @l (\ w -> (phi : K.M) * Id R (a.1 phi) g) (\ w -> fib-prop g) (\ u -> u)
     ((t.2 g).2 (Tr.Trunc[(s : R) * Id R g (mul g s)].inc (o,sym (mulO g)))) ;
   phi : K.M = fib.1 ;
   av (c : R) : Id R (a.1 (K.sm c phi)) (mul g c) = trans (a.2.2 c phi) (trans (ap (mul c) fib.2) (mulC c g)) ;
   free (c c' : R) (h : Id K.M (K.sm c phi) (K.sm c' phi)) : Id R c c' =
    ap (\ u -> u.1) (GT.GI.cofactor-prop g t.1 (a.1 (K.sm c phi)) (c,av c) (c',trans (ap a.1 h) (av c'))) ;
   gen (psi : K.M) : Tr.Trunc[(c : R) * Id K.M psi (K.sm c phi)].carrier =
    TC.map ((s : R) * Id R (a.1 psi) (mul g s)) ((c : R) * Id K.M psi (K.sm c phi))
     (\ v -> (v.1,inj psi (K.sm v.1 phi) (trans v.2 (sym (av v.1)))))
     ((t.2 (a.1 psi)).1 (Tr.Trunc[(chi : K.M) * Id R (a.1 chi) (a.1 psi)].inc (psi,refl (a.1 psi)))) ;
   result : Basis phi = (free,gen) ;
  } ;
  from-gens (w : Gens) : Bases = (FromGen[w.1,w.2].phi,FromGen[w.1,w.2].result) ;
  equiv : Pr.Equiv Bases Gens = (to-gens,
   Pr.qinv Bases Gens to-gens from-gens
    (\ w -> Pr.Sigma-eq R RegGen (a.1 FromGen[w.1,w.2].phi) w.1 (FromBasis[FromGen[w.1,w.2].phi,FromGen[w.1,w.2].result].result) w.2
      FromGen[w.1,w.2].fib.2 (reggen-prop w.1))
    (\ w -> Pr.Sigma-eq K.M Basis FromGen[a.1 w.1,FromBasis[w.1,w.2].result].phi w.1 FromGen[a.1 w.1,FromBasis[w.1,w.2].result].result w.2
      (inj FromGen[a.1 w.1,FromBasis[w.1,w.2].result].phi w.1 FromGen[a.1 w.1,FromBasis[w.1,w.2].result].fib.2) (basis-prop w.1))) ;
 } ;
} ;

module Over (D : TG.RD) {
 module DF = DetFFR[l].Over[D] ;
 module DL = DF.DL ; module FM = DF.FM ; module SM = DF.SM ; module MS = DF.MS ; module ED = DF.ED ;
 module GT = DL.GT ;
 module FG = Free[D.1,D.2] ;
 R : U l = D.1.R ;
 -- R ~ R^1 after a line: the basis of a module with an iota : M ~ R
 module One (M : FM.Module) (iota : MS.LinEquiv M FM.regular) {
  module IO = ED.Inv[M,FM.regular,iota] ;
  fun (x : M.M) : (FM.Free (suc zero)).M = \ j -> IO.fun x ;
  inv (v : (FM.Free (suc zero)).M) : M.M = IO.inv (v (inr tt)) ;
  at-tt (v : (FM.Free (suc zero)).M) : (t : Top) -> Id R (IO.fun (inv v)) (v (inr t)) = split { tt -> IO.inv-eq (v (inr tt)) } ;
  at (v : (FM.Free (suc zero)).M) : (j : Ps.Fin (suc zero)) -> Id R (IO.fun (inv v)) (v j) = split {
   inl k -> efq k ; inr t -> at-tt v t } ;
  basis : MS.LinEquiv M (FM.Free (suc zero)) =
   ((fun,Pr.qinv M.M (FM.Free (suc zero)).M fun inv
      (\ v -> F.funext (Ps.Fin (suc zero)) (\ j -> R) (fun (inv v)) v (at v)) IO.ret-eq),
    \ x y -> ap (\ c j -> c) (IO.fun-add x y),
    \ c x -> ap (\ c' j -> c') (IO.fun-scale c x)) ;
 } ;

 module At (N : Nat) (a : Ps.Fin N -> R) (m : Nat) (P : FM.Module) (G : Nat -> FM.Module)
  (B : Tr.Trunc[DF.FR.Bases P G].carrier) (h : DF.FR.ResOf m N a P G) (nt : Id R D.1.o D.1.z -> Empty)
  (e : Id Nat (DF.At[N,a,m,P,G,B,h,nt].r m) (suc zero)) {
  module AT = DF.At[N,a,m,P,G,B,h,nt] ;
  module CA = AT.Canonical[e] ;
  module DT = CA.DT ;
  module GA = CA.GA ;
  -- ∧^1 G (m+1) ~ R, by the top coordinate for the basis iota
  -- the last term in DetLine's names: G' (m+3) = G (m+1), rk (m+2) = r m
  module E1 = One[AT.G' (suc (suc (suc m))),AT.H.iota] ;
  module TB1 = DL.TL.TopBasis[AT.G' (suc (suc (suc m))),AT.SR.bb (suc (suc (suc m))),AT.CH.rk (suc (suc m)),suc zero,e,E1.basis] ;
  J : MS.LinEquiv DT.F0 FM.regular = TB1.line ;
  -- by definition, J is the top coordinate in the basis iota (TopBasis.phi)
  J-value (u : DT.F0.M) : Id R (J.1.1 u) (TB1.phi u) = refl (J.1.1 u) ;
  module IJ = ED.Inv[DT.F0,FM.regular,J] ;
  -- a_1 = J a_Det : Det(F) -> R
  a1 : SM.Linear CA.Det FM.regular = (\ phi -> IJ.fun (CA.aDet.1 phi),
   \ x y -> trans (ap IJ.fun (CA.aDet.2.1 x y)) (IJ.fun-add (CA.aDet.1 x) (CA.aDet.1 y)),
   \ c x -> trans (ap IJ.fun (CA.aDet.2.2 c x)) (IJ.fun-scale c (CA.aDet.1 x))) ;
  a1-inj (phi phi' : CA.Det.M) (hh : Id R (a1.1 phi) (a1.1 phi')) : Id CA.Det.M phi phi' =
   DT.injective phi phi' (trans (sym (IJ.ret-eq (CA.aDet.1 phi))) (trans (ap IJ.inv hh) (IJ.ret-eq (CA.aDet.1 phi')))) ;
  module G1 = FG.Gen[CA.Det,a1,a1-inj] ;
  -- the image of a_1 is the image of a_Det
  module Form (lam : SM.Linear DT.F0 FM.regular) {
   c : R = lam.1 (IJ.inv D.1.o) ;
   value (x : DT.F0.M) : Id R (lam.1 x) (D.1.mul (IJ.fun x) c) = calc R {
    lam.1 x =< ap lam.1 (sym (IJ.ret-eq x)) > lam.1 (IJ.inv (IJ.fun x))
     =< ap (\ t -> lam.1 (IJ.inv t)) (sym (D.1.mulO (IJ.fun x))) > lam.1 (IJ.inv (D.1.mul (IJ.fun x) D.1.o))
     =< ap lam.1 (IJ.inv-scale (IJ.fun x) D.1.o) > lam.1 (DT.F0.sm (IJ.fun x) (IJ.inv D.1.o))
     =< lam.2.2 (IJ.fun x) (IJ.inv D.1.o) > D.1.mul (IJ.fun x) c } ;
  } ;
  image-to (y : R) (hy : G1.Image y) : DT.InImage y =
   TC.map ((phi : CA.Det.M) * Id R (a1.1 phi) y) ((phi : CA.Det.M) * (lam : SM.Linear DT.F0 FM.regular) * Id R (lam.1 (CA.aDet.1 phi)) y)
    (\ u -> (u.1,(FM.lin DT.F0 FM.regular J,u.2))) hy ;
  image-from (y : R) (hy : DT.InImage y) : G1.Image y =
   TC.map ((phi : CA.Det.M) * (lam : SM.Linear DT.F0 FM.regular) * Id R (lam.1 (CA.aDet.1 phi)) y) ((phi : CA.Det.M) * Id R (a1.1 phi) y)
    (\ u -> (CA.Det.sm (Form[u.2.1].c) u.1,calc R {
     a1.1 (CA.Det.sm (Form[u.2.1].c) u.1) =< a1.2.2 (Form[u.2.1].c) u.1 > D.1.mul (Form[u.2.1].c) (a1.1 u.1)
      =< D.1.mulC (Form[u.2.1].c) (a1.1 u.1) > D.1.mul (a1.1 u.1) (Form[u.2.1].c)
      =< sym (Form[u.2.1].value (CA.aDet.1 u.1)) > u.2.1.1 (CA.aDet.1 u.1)
      =< u.2.2 > y })) hy ;
  -- regular gcd iff regular generator of the image of a_1
  gen-to (g : R) (t : GA.IsRegGcd g) : G1.RegGen g =
   (t.2,\ y -> (\ hy -> ((CA.to-gen g t).2 y).1 (image-to y hy),\ ht -> image-from y (((CA.to-gen g t).2 y).2 ht))) ;
  gen-from (g : R) (t : G1.RegGen g) : GA.IsRegGcd g =
   CA.from-gen g (t.1,\ y -> (\ hy -> (t.2 y).1 (image-from y hy),\ ht -> image-to y ((t.2 y).2 ht))) ;
  gcd-equiv : Pr.Equiv GA.RegGcd G1.Gens = (\ t -> (t.1,gen-to t.1 t.2),
   Pr.qinv GA.RegGcd G1.Gens (\ t -> (t.1,gen-to t.1 t.2)) (\ w -> (w.1,gen-from w.1 w.2))
    (\ w -> Pr.Sigma-eq R G1.RegGen w.1 w.1 (gen-to w.1 (gen-from w.1 w.2)) w.2 (refl w.1) (G1.reggen-prop w.1))
    (\ t -> GA.eq (t.1,gen-from t.1 (gen-to t.1 t.2)) t (refl t.1))) ;
  -- the regular gcds of the a_j are the a_1(φ), φ a basis of Det(F)
  gcd-of (w : G1.Bases) : GA.RegGcd = (a1.1 w.1,gen-from (a1.1 w.1) (G1.FromBasis[w.1,w.2].result)) ;
  bases-eq : Id (U l) G1.Bases GA.RegGcd =
   Prelude[l+].trans (U l) G1.Bases G1.Gens GA.RegGcd (UA.ua G1.Bases G1.Gens G1.equiv)
    (Prelude[l+].sym (U l) GA.RegGcd G1.Gens (UA.ua GA.RegGcd G1.Gens gcd-equiv)) ;
  -- the bases of Det(F) form an R^x-torsor
  bases-torsor : GT.TB.TorStr G1.Bases =
   Prelude[l+].subst (U l) (\ T -> GT.TB.TorStr T) GA.RegGcd G1.Bases (Prelude[l+].sym (U l) G1.Bases GA.RegGcd bases-eq) (GA.torsor CA.some-reg) ;
 } ;
 -- for every FFRes of a nonzero ideal
 module OfRes (N : Nat) (a : Ps.Fin N -> R) (f : DF.FR.FFRes N a) (nt : Id R D.1.o D.1.z -> Empty)
  (nz : DF.OfRes[N,a,f,nt].A.AllZero -> Empty) {
  module A = At[N,a,f.1,f.2.1,f.2.2.1,f.2.2.2.1,f.2.2.2.2,nt,DF.OfRes[N,a,f,nt].A.rank-one nz] ;
 } ;
} ;
