-- The determinant line of a finite free resolution, without choices
-- (cffru, step 2 over step 1).
-- R nontrivial (nt : 1 = 0 is empty).  For an FFRes 0 -> P -u-> G 0 -> ...
-- -T m-> G (m+1) ~ R of (a_j) (FreeResolution.ResOf, terms merely free):
-- the rank data (Data): the free ranks p of P and s i of G i (Dims: merely
-- bases of these sizes), ranks r i of the T i (i <= m; r i = 0 beyond,
-- Normal), with BE's rank equations (Resolution.Ranks) and T i stable of rank
-- r i without bases (Ranks.Stable).  Data is a proposition (data-prop): the
-- free ranks are unique (Ranks.FreeRank) and so are the ranks of stable maps
-- (Ranks.Rk.unique), since 1 /= 0.  It is merely inhabited (FromBases:
-- choose bases, Theorem 6.8 on the matrices, Ranks.Coords.from-matrix), so
-- by unique choice it is an element, data, with no basis chosen.
-- With data, cffr's layout (G', f', d, s', hd as in Thm89.Main) gives the
-- structure SR = Structure.Chain.Res on the resolution's own modules.  Its
-- hypotheses (GradeHyp, RegHyp: for every choice of bases) are propositions:
-- with bases b chosen (GmAt), Thm89.Main gives them for the matrices of b,
-- DkFree turns them into the basis-free statements (to-free), which move to
-- data's ranks (kpath: data-prop identifies b's data with data) and to the
-- truncated bases of SR (Move), and DkFree.from-free gives them for any es.
-- Canonical: when r m = 1 (the case of Thm 8.9 with a regular gcd), s (m+1)
-- = 1 (sOne, FreeModules.rank-one) and DetLine gives Det(F), a line, and
-- the canonical a_Det : Det(F) -> ∧^1 G (m+1), defined without choices.
-- The last rank (last-rank): r m = 1 unless all a_j = 0.  r m is a number
-- (rdata), so this is a case split on it.  r m = 0 (LastZero): T m is
-- stable of rank 0, so ∧^1 T m = 0; for any bases (the goal a_j = 0 is a
-- proposition) every 1 x 1 minor of the matrix is a value of D_1, hence 0
-- (Ranks.Coords.vanish-minors), and the a_j are 0 (Thm89U.One.zero-a).
-- r m >= 2 (LastBig): D_(r m)(T m) is regular, but G (m+1) has rank 1, so
-- 1 = 0 (Resolution.too-big), excluded.  So for a nonzero ideal (NonZero)
-- r m = 1 and Canonical applies: every FFRes of a nonzero ideal has Det(F).
-- Step 3 through the line (Canonical.gens-eq): the regular gcds of the a_j
-- are the regular generators of the image of a_Det.  For g regular,
-- (g) = image of a_Det iff (g) = gcd ideal (image-to, image-from), and a
-- regular generator of the gcd ideal is a regular gcd (GcdTorsor.FromGen;
-- merely a gcd exists, DetLine's det).  Both are propositions in g, so the
-- two subtypes of R are equivalent, equal by univalence, and the regular
-- generators of the image of a_Det form an R^x-torsor (gens-torsor).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
module TG = TrueGrade[l] ; module T68 = Thm68[l] ; module RS = Resolution[l] ;
-- Ring's Nat is a set (Hedberg, as NatArith for Base's Nat)
top-prop : (u v : Top) -> Id Top u v = split { tt -> split { tt -> refl tt } } ;
empty-prop : Pr.isProp Empty = \ e y -> efq e ;
ncode : Nat -> Nat -> U l = split {
 zero -> split { zero -> Top ; suc n -> Empty } ;
 suc m | r -> split { zero -> Empty ; suc n -> r n } } ;
ncode-prop : (m n : Nat) -> Pr.isProp (ncode m n) = split {
 zero -> split { zero -> top-prop ; suc n -> empty-prop } ;
 suc m | r -> split { zero -> empty-prop ; suc n -> r n } } ;
ncode-refl : (m : Nat) -> ncode m m = split { zero -> tt ; suc m | r -> r } ;
ncode-eq : (m n : Nat) -> ncode m n -> Id Nat m n = split {
 zero -> split { zero -> \ h -> refl zero ; suc n -> \ h -> efq h } ;
 suc m | r -> split { zero -> \ h -> efq h ;
                      suc n -> \ h -> ap (\ k -> suc k) (r n h) } } ;
nat-set : Pr.isSet Nat = \ m -> Pr.Hedberg[Nat,m,ncode m,ncode-prop m,ncode-refl m,ncode-eq m].hedberg ;
module Over (D : TG.RD) {
 module L = RL[D.1] ;
 module T9D = Thm89D[l].Over[D] ;
 module FR = T9D.FR ; module DL = T9D.DL ; module SC = T9D.SC ; module ED = T9D.ED ; module FM = T9D.FM ; module FF = T9D.FF ;
 module SM = T9D.SM ; module MS = T9D.MS ; module MI = T9D.MI ; module C85 = T9D.C85 ; module L84 = T9D.L84 ;
 module DK = T9D.DK ; module T89 = T9D.T89 ; module T89U = T9D.T89U ; module L86 = T9D.L86 ;
 module RK = Ranks[l].Over[D.1,D.2] ;
 module HO = RK.HO ;
 R : U l = D.1.R ;
 -- t < T is decidable
 ltd : (t T : Nat) -> Plus (C85.lt t T) (C85.lt t T -> Empty) = split {
  zero -> split { zero -> inr (\ h -> h) ; suc T -> inl tt } ;
  suc t | r -> split { zero -> inr (\ h -> h) ; suc T -> r T } } ;
 lt-plus : (t d : Nat) -> C85.lt t (plus (suc t) d) = split {
  zero -> \ d -> tt ;
  suc t | r -> \ d -> r d } ;
 -- r, set to 0 from k on
 module Norm (k : Nat) (r : Nat -> Nat) {
  pick (i : Nat) : Plus (C85.lt i k) (C85.lt i k -> Empty) -> Nat = split { inl h -> r i ; inr h -> zero } ;
  rN (i : Nat) : Nat = pick i (ltd i k) ;
  pick-eq (i : Nat) (h : C85.lt i k) : (w : Plus (C85.lt i k) (C85.lt i k -> Empty)) -> Id Nat (pick i w) (r i) = split {
   inl h' -> refl (r i) ; inr n -> efq (n h) } ;
  eq (i : Nat) (h : C85.lt i k) : Id Nat (rN i) (r i) = pick-eq i h (ltd i k) ;
  pick-zero (i : Nat) (n : C85.lt i k -> Empty) : (w : Plus (C85.lt i k) (C85.lt i k -> Empty)) -> Id Nat (pick i w) zero = split {
   inl h -> efq (n h) ; inr n' -> refl zero } ;
  zero-eq (i : Nat) (n : C85.lt i k -> Empty) : Id Nat (rN i) zero = pick-zero i n (ltd i k) ;
 } ;
 sure (X : U l) (nt : Id R D.1.o D.1.z -> Empty) : Plus (Id R D.1.o D.1.z) X -> X = split {
  inl e -> efq (nt e) ; inr x -> x } ;
 grtwo-prop (X : U l) (b : X -> R) : Pr.isProp (L84.GrTwo X b) =
  HO.prod-prop (MI.RI.Regular X b)
   ((y : X -> R) -> ((K K' : X) -> Id R (D.1.mul (b K) (y K')) (D.1.mul (b K') (y K))) -> Tr.Trunc[L84.Multiple X b y].carrier)
   (RK.regular-prop X b)
   (F.isProp-Pi (X -> R) (\ y -> ((K K' : X) -> Id R (D.1.mul (b K) (y K')) (D.1.mul (b K') (y K))) -> Tr.Trunc[L84.Multiple X b y].carrier) (\ y ->
    F.isProp-Pi ((K K' : X) -> Id R (D.1.mul (b K) (y K')) (D.1.mul (b K') (y K))) (\ hy -> Tr.Trunc[L84.Multiple X b y].carrier) (\ hy ->
     Tr.Trunc[L84.Multiple X b y].proposition))) ;
 -- the hypotheses of DkFree move along k = k' and the truncated bases
 module Move (M N : FM.Module) (f : SM.Linear M N) (k k' : Nat) (ek : Id Nat k k')
  (bM bM' : Tr.Trunc[FF.Based M].carrier) (bN bN' : Tr.Trunc[FF.Based N].carrier) {
  gr (h : DK.Dk[M,N,bM,bN,f,k].GrTwo) : DK.Dk[M,N,bM',bN',f,k'].GrTwo =
   subst (\ c -> DK.Dk[M,N,bM',bN',f,c].GrTwo) ek
    (subst (\ x -> DK.Dk[M,N,bM',x,f,k].GrTwo) (Tr.Trunc[FF.Based N].proposition bN bN')
     (subst (\ x -> DK.Dk[M,N,x,bN,f,k].GrTwo) (Tr.Trunc[FF.Based M].proposition bM bM') h)) ;
  rg (h : DK.Dk[M,N,bM,bN,f,k].Regular) : DK.Dk[M,N,bM',bN',f,k'].Regular =
   subst (\ c -> DK.Dk[M,N,bM',bN',f,c].Regular) ek
    (subst (\ x -> DK.Dk[M,N,bM',x,f,k].Regular) (Tr.Trunc[FF.Based N].proposition bN bN')
     (subst (\ x -> DK.Dk[M,N,x,bN,f,k].Regular) (Tr.Trunc[FF.Based M].proposition bM bM') h)) ;
 } ;

 module At (N : Nat) (a : Ps.Fin N -> R) (m : Nat) (P : FM.Module) (G : Nat -> FM.Module)
  (B : Tr.Trunc[FR.Bases P G].carrier) (h : FR.ResOf m N a P G) (nt : Id R D.1.o D.1.z -> Empty) {
  module H = FR.RO[m,N,a,P,G,h] ;
  bP : Tr.Trunc[FF.Based P].carrier = TC.map (FR.Bases P G) (FF.Based P) (\ b -> (b.1,b.2.2.1)) B ;
  bG (i : Nat) : Tr.Trunc[FF.Based (G i)].carrier = TC.map (FR.Bases P G) (FF.Based (G i)) (\ b -> (b.2.1 i,b.2.2.2 i)) B ;
  module RT (i : Nat) { module K = RK.Rk[G i,G (suc i),bG i,bG (suc i),H.T i] ; } ;

  -- the rank data
  Bases0 (p : Nat) (s : Nat -> Nat) : U l = MS.LinEquiv P (FM.Free p) * ((i : Nat) -> MS.LinEquiv (G i) (FM.Free (s i))) ;
  Dims (p : Nat) (s : Nat -> Nat) : U l = Tr.Trunc[Bases0 p s].carrier ;
  Stab (r : Nat -> Nat) : U l = (i : Nat) -> C85.lt i (suc m) -> RT[i].K.Stable (r i) ;
  Normal (r : Nat -> Nat) : U l = (i : Nat) -> (C85.lt i (suc m) -> Empty) -> Id Nat (r i) zero ;
  Triple : U l = Nat * ((Nat -> Nat) * (Nat -> Nat)) ;
  Props (k : Triple) : U l = Dims k.1 k.2.1 * (RS.Ranks (suc m) k.1 k.2.1 k.2.2 * (Stab k.2.2 * Normal k.2.2)) ;
  Data : U l = (k : Triple) * Props k ;
  ranks-prop (p : Nat) (s r : Nat -> Nat) : Pr.isProp (RS.Ranks (suc m) p s r) =
   HO.prod-prop ((d : Nat) -> Id Nat (suc m) (suc d) -> Id Nat (s zero) (plus (r zero) p))
    ((i d : Nat) -> Id Nat (suc m) (plus (suc (suc i)) d) -> Id Nat (s (suc i)) (plus (r (suc i)) (r i)))
    (F.isProp-Pi Nat (\ d -> Id Nat (suc m) (suc d) -> Id Nat (s zero) (plus (r zero) p)) (\ d ->
     F.isProp-Pi (Id Nat (suc m) (suc d)) (\ e -> Id Nat (s zero) (plus (r zero) p)) (\ e -> nat-set (s zero) (plus (r zero) p))))
    (F.isProp-Pi Nat (\ i -> (d : Nat) -> Id Nat (suc m) (plus (suc (suc i)) d) -> Id Nat (s (suc i)) (plus (r (suc i)) (r i))) (\ i ->
     F.isProp-Pi Nat (\ d -> Id Nat (suc m) (plus (suc (suc i)) d) -> Id Nat (s (suc i)) (plus (r (suc i)) (r i))) (\ d ->
      F.isProp-Pi (Id Nat (suc m) (plus (suc (suc i)) d)) (\ e -> Id Nat (s (suc i)) (plus (r (suc i)) (r i))) (\ e ->
       nat-set (s (suc i)) (plus (r (suc i)) (r i)))))) ;
  stab-prop (r : Nat -> Nat) : Pr.isProp (Stab r) =
   F.isProp-Pi Nat (\ i -> C85.lt i (suc m) -> RT[i].K.Stable (r i)) (\ i ->
    F.isProp-Pi (C85.lt i (suc m)) (\ lt -> RT[i].K.Stable (r i)) (\ lt -> RT[i].K.stable-prop (r i))) ;
  normal-prop (r : Nat -> Nat) : Pr.isProp (Normal r) =
   F.isProp-Pi Nat (\ i -> (C85.lt i (suc m) -> Empty) -> Id Nat (r i) zero) (\ i ->
    F.isProp-Pi (C85.lt i (suc m) -> Empty) (\ n -> Id Nat (r i) zero) (\ n -> nat-set (r i) zero)) ;
  props-prop (k : Triple) : Pr.isProp (Props k) =
   HO.prod-prop (Dims k.1 k.2.1) (RS.Ranks (suc m) k.1 k.2.1 k.2.2 * (Stab k.2.2 * Normal k.2.2))
    Tr.Trunc[Bases0 k.1 k.2.1].proposition
    (HO.prod-prop (RS.Ranks (suc m) k.1 k.2.1 k.2.2) (Stab k.2.2 * Normal k.2.2) (ranks-prop k.1 k.2.1 k.2.2)
     (HO.prod-prop (Stab k.2.2) (Normal k.2.2) (stab-prop k.2.2) (normal-prop k.2.2))) ;
  -- two rank data agree
  module Same (u v : Data) {
   p-eq : Id Nat u.1.1 v.1.1 =
    Tr.Trunc[Bases0 u.1.1 u.1.2.1].induction @l (\ w -> Id Nat u.1.1 v.1.1) (\ w -> nat-set u.1.1 v.1.1) (\ x ->
     Tr.Trunc[Bases0 v.1.1 v.1.2.1].induction @l (\ w -> Id Nat u.1.1 v.1.1) (\ w -> nat-set u.1.1 v.1.1) (\ y ->
      sure (Id Nat u.1.1 v.1.1) nt (RK.FreeRank[P,bP].unique u.1.1 v.1.1 x.1 y.1)) v.2.1) u.2.1 ;
   s-at (i : Nat) : Id Nat (u.1.2.1 i) (v.1.2.1 i) =
    Tr.Trunc[Bases0 u.1.1 u.1.2.1].induction @l (\ w -> Id Nat (u.1.2.1 i) (v.1.2.1 i)) (\ w -> nat-set (u.1.2.1 i) (v.1.2.1 i)) (\ x ->
     Tr.Trunc[Bases0 v.1.1 v.1.2.1].induction @l (\ w -> Id Nat (u.1.2.1 i) (v.1.2.1 i)) (\ w -> nat-set (u.1.2.1 i) (v.1.2.1 i)) (\ y ->
      sure (Id Nat (u.1.2.1 i) (v.1.2.1 i)) nt (RK.FreeRank[G i,bG i].unique (u.1.2.1 i) (v.1.2.1 i) (x.2 i) (y.2 i))) v.2.1) u.2.1 ;
   r-cases (i : Nat) : Plus (C85.lt i (suc m)) (C85.lt i (suc m) -> Empty) -> Id Nat (u.1.2.2 i) (v.1.2.2 i) = split {
    inl lt -> sure (Id Nat (u.1.2.2 i) (v.1.2.2 i)) nt (RT[i].K.unique (u.1.2.2 i) (v.1.2.2 i) (u.2.2.2.1 i lt) (v.2.2.2.1 i lt)) ;
    inr n -> trans (u.2.2.2.2 i n) (sym (v.2.2.2.2 i n)) } ;
   triple-eq : Id Triple u.1 v.1 =
    ExteriorAlgebra[l].pair-eq p-eq (ExteriorAlgebra[l].pair-eq (F.funext Nat (\ i -> Nat) u.1.2.1 v.1.2.1 s-at)
     (F.funext Nat (\ i -> Nat) u.1.2.2 v.1.2.2 (\ i -> r-cases i (ltd i (suc m))))) ;
   result : Id Data u v = Pr.Sigma-eq Triple Props u.1 v.1 u.2 v.2 triple-eq (props-prop v.1) ;
  } ;
  data-prop : Pr.isProp Data = \ u v -> Same[u,v].result ;
  -- with bases: Theorem 6.8 on the matrices
  module FromBases (b : FR.Bases P G) {
   module FB = T9D.FromBases[N,a,m,P,G,b,h] ;
   th : Plus (Id R D.1.o D.1.z) ((r : Nat -> Nat) * RS.Ranks (suc m) FB.p FB.s r * RS.Stables D (suc m) FB.s r FB.T * T68.Grades D (suc m) FB.s r FB.T) *
    TG.TGr (suc (suc m)) D zero (GradeTools[l].J0 D) (T68.NL FB.p FB.p (FB.s zero)) (T68.minors D FB.p FB.p (FB.s zero) FB.u) =
    T68.theorem68 (suc m) D FB.p FB.s FB.u FB.T FB.res ;
   w : (r : Nat -> Nat) * RS.Ranks (suc m) FB.p FB.s r * RS.Stables D (suc m) FB.s r FB.T * T68.Grades D (suc m) FB.s r FB.T =
    sure ((r : Nat -> Nat) * RS.Ranks (suc m) FB.p FB.s r * RS.Stables D (suc m) FB.s r FB.T * T68.Grades D (suc m) FB.s r FB.T) nt th.1 ;
   module NR = Norm[suc m,w.1] ;
   r : Nat -> Nat = NR.rN ;
   lt1 (i d : Nat) (e : Id Nat (suc m) (plus (suc (suc i)) d)) : C85.lt (suc i) (suc m) = subst (C85.lt (suc i)) (sym e) (lt-plus (suc i) d) ;
   ranks : RS.Ranks (suc m) FB.p FB.s r =
    (\ dd e -> trans (w.2.1.1 dd e) (ap (\ k -> plus k FB.p) (sym (NR.eq zero tt))),
     \ i dd e -> trans (w.2.1.2 i dd e) (Ps.cong2 Nat plus _ _ _ _ (sym (NR.eq (suc i) (lt1 i dd e)))
      (sym (NR.eq i (C85.lt-pred i (suc m) (lt1 i dd e)))))) ;
   stab : Stab r = \ i lt -> subst RT[i].K.Stable (sym (NR.eq i lt))
    (RT[i].K.Coords[FB.s i,FB.eG i,FB.s (suc i),FB.eG (suc i)].from-matrix (w.1 i)
     (w.2.2.1 i (T89.lt-split i (suc m) lt).1 (T89.lt-split i (suc m) lt).2)) ;
   rdata : Data = ((FB.p,(FB.s,r)),(Tr.Trunc[Bases0 FB.p FB.s].inc (FB.eP,FB.eG),(ranks,(stab,NR.zero-eq)))) ;
  } ;
  -- unique choice: the rank data, without bases
  rdata : Data = Tr.Trunc[FR.Bases P G].induction @l (\ w -> Data) (\ w -> data-prop) (\ b -> FromBases[b].rdata) B ;
  p : Nat = rdata.1.1 ;
  s : Nat -> Nat = rdata.1.2.1 ;
  r : Nat -> Nat = rdata.1.2.2 ;
  ranks : RS.Ranks (suc m) p s r = rdata.2.2.1 ;

  -- cffr's layout (Thm89.Main): G' 0 = R^0, G' 1 = P, G' (i+2) = G i
  s' : Nat -> Nat = split { zero -> p ; suc t -> r t } ;
  module CH = C85.Chain[s'] ;
  d1 : Nat -> Nat = split { zero -> p ; suc t -> s t } ;
  d : Nat -> Nat = split { zero -> zero ; suc t -> d1 t } ;
  hd1 : (t : Nat) -> C85.lt (suc t) (suc (suc m)) -> Id Nat (plus (CH.rk (suc (suc t))) (CH.rk (suc t))) (d (suc (suc t))) = split {
   zero -> \ hh -> sym (ranks.1 m (refl (suc m))) ;
   suc i -> \ hh -> sym (ranks.2 i (T89.lt-split (suc i) (suc m) hh).1 (T89.lt-split (suc i) (suc m) hh).2) } ;
  hd : (t : Nat) -> C85.lt t (suc (suc m)) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)) = split {
   zero -> \ hh -> plus-zero p ;
   suc t -> hd1 t } ;
  G1 : Nat -> FM.Module = split { zero -> P ; suc i -> G i } ;
  G' : Nat -> FM.Module = split { zero -> FM.Free zero ; suc t -> G1 t } ;
  sm-z (c : R) : Id P.M (P.sm c P.mz) P.mz =
   Alg73[l].MA[FM.MO.ring,P].madd-cancel (P.sm c P.mz) (P.sm c P.mz) (trans (sym (P.smD c P.mz P.mz)) (ap (P.sm c) (P.maddZ P.mz))) ;
  zero-map : SM.Linear (FM.Free zero) P = (\ x -> P.mz,\ x y -> sym (P.maddZ P.mz),\ c x -> sym (sm-z c)) ;
  f1 : (t : Nat) -> SM.Linear (G1 t) (G1 (suc t)) = split { zero -> H.u ; suc i -> H.T i } ;
  f' : (t : Nat) -> SM.Linear (G' t) (G' (suc t)) = split { zero -> zero-map ; suc t -> f1 t } ;
  id0 : MS.LinEquiv (FM.Free zero) (FM.Free zero) =
   (Pr.idEquiv (FM.Free zero).M,\ x y -> refl ((FM.Free zero).madd x y),\ c x -> refl ((FM.Free zero).sm c x)) ;
  es1 (x : Bases0 p s) : (t : Nat) -> MS.LinEquiv (G1 t) (FM.Free (d1 t)) = split { zero -> x.1 ; suc i -> x.2 i } ;
  es' (x : Bases0 p s) : (t : Nat) -> MS.LinEquiv (G' t) (FM.Free (d t)) = split { zero -> id0 ; suc t -> es1 x t } ;
  bs : Tr.Trunc[(t : Nat) -> MS.LinEquiv (G' t) (FM.Free (d t))].carrier =
   TC.map (Bases0 p s) ((t : Nat) -> MS.LinEquiv (G' t) (FM.Free (d t))) es' rdata.2.1 ;
  bG1 : (t : Nat) -> Tr.Trunc[FF.Based (G1 t)].carrier = split { zero -> bP ; suc i -> bG i } ;
  bG' : (t : Nat) -> Tr.Trunc[FF.Based (G' t)].carrier = split {
   zero -> Tr.Trunc[FF.Based (FM.Free zero)].inc (zero,id0) ; suc t -> bG1 t } ;
  cz1 : (t : Nat) -> C85.lt (suc t) (suc (suc m)) -> FM.ComposeZeroL (G1 t) (G1 (suc t)) (G1 (suc (suc t))) (f1 t) (f1 (suc t)) = split {
   zero -> \ hh -> (H.pairs.1 m (refl (suc m))).1 ;
   suc i -> \ hh -> (H.pairs.2 i (T89.lt-split (suc i) (suc m) hh).1 (T89.lt-split (suc i) (suc m) hh).2).1 } ;
  cz : (t : Nat) -> C85.lt t (suc (suc m)) -> FM.ComposeZeroL (G' t) (G' (suc t)) (G' (suc (suc t))) (f' t) (f' (suc t)) = split {
   zero -> \ hh x -> SM.Lin[P,G zero,H.u].map-z ;
   suc t -> cz1 t } ;
  module SR = SC.Chain[s'].Res[suc m,d,G',f',bs,hd,cz] ;

  -- the hypotheses, basis-free, at data's ranks and SR's bases
  module DS (t : Nat) { module K = DK.Dk[G' (suc t),G' (suc (suc t)),SR.bb (suc t),SR.bb (suc (suc t)),f' (suc t),CH.rk (suc t)] ; } ;
  module GmAt (b : FR.Bases P G) {
   module FBD = FromBases[b] ;
   module FB = FBD.FB ;
   esb : Id Nat (FB.s (suc m)) (suc zero) = sure (Id Nat (FB.s (suc m)) (suc zero)) nt (FM.rank-one (FB.s (suc m)) FB.iota') ;
   module T9 = T89.Thm89[m,FB.p,FB.s,FB.u,FB.T,FB.res,esb] ;
   module MN = T9.Main[FBD.w.1,FBD.w.2.1,FBD.w.2.2.1,FBD.w.2.2.2] ;
   esb1 : (t : Nat) -> MS.LinEquiv (G1 t) (FM.Free (MN.d1 t)) = split { zero -> FB.eP ; suc i -> FB.eG i } ;
   esb' : (t : Nat) -> MS.LinEquiv (G' t) (FM.Free (MN.d t)) = split { zero -> id0 ; suc t -> esb1 t } ;
   module DB (t : Nat) {
    module K = DK.Dk[G' (suc t),G' (suc (suc t)),bG' (suc t),bG' (suc (suc t)),f' (suc t),MN.CH.rk (suc t)] ;
    module C = K.Coords[MN.d (suc t),esb' (suc t),MN.d (suc (suc t)),esb' (suc (suc t))] ;
   } ;
   -- the matrices of b (Thm89.Main)
   gm0 : (t : Nat) (hh : C85.lt (suc t) (suc (suc m))) ->
    L84.GrTwo (MI.Index (MN.CH.rk (suc t)) (MN.d (suc t)) (MN.d (suc (suc t)))) (MI.minors (MN.CH.rk (suc t)) (MN.d (suc t)) (MN.d (suc (suc t))) DB[t].C.A) = split {
    zero -> MN.gm zero ; suc i -> MN.gm (suc i) } ;
   -- b's ranks are data's
   dpath : Id Data FBD.rdata rdata = data-prop FBD.rdata rdata ;
   rpath (i : Nat) (lt : C85.lt i (suc m)) : Id Nat (FBD.w.1 i) (r i) =
    trans (sym (FBD.NR.eq i lt)) (ap (\ x -> x.1.2.2 i) dpath) ;
   kpath : (t : Nat) -> C85.lt (suc t) (suc (suc m)) -> Id Nat (MN.CH.rk (suc t)) (CH.rk (suc t)) = split {
    zero -> \ hh -> ap (\ x -> x.1.1) dpath ;
    suc i -> \ hh -> rpath i (C85.lt-pred i (suc m) hh) } ;
   free (t : Nat) (hh : C85.lt (suc t) (suc (suc m))) : DS[t].K.GrTwo =
    Move[G' (suc t),G' (suc (suc t)),f' (suc t),MN.CH.rk (suc t),CH.rk (suc t),kpath t hh,
     bG' (suc t),SR.bb (suc t),bG' (suc (suc t)),SR.bb (suc (suc t))].gr (DB[t].C.to-free (gm0 t hh)) ;
   rfree : DS[suc m].K.Regular =
    Move[G' (suc (suc m)),G' (suc (suc (suc m))),f' (suc (suc m)),MN.CH.rk (suc (suc m)),CH.rk (suc (suc m)),rpath m (C85.lt-self m),
     bG' (suc (suc m)),SR.bb (suc (suc m)),bG' (suc (suc (suc m))),SR.bb (suc (suc (suc m)))].rg (DB[suc m].C.reg-to-free MN.rg) ;
  } ;
  gfree (t : Nat) (hh : C85.lt (suc t) (suc (suc m))) : DS[t].K.GrTwo =
   Tr.Trunc[FR.Bases P G].induction @l (\ w -> DS[t].K.GrTwo) (\ w -> grtwo-prop DS[t].K.Gen DS[t].K.value) (\ b -> GmAt[b].free t hh) B ;
  rfree : DS[suc m].K.Regular =
   Tr.Trunc[FR.Bases P G].induction @l (\ w -> DS[suc m].K.Regular) (\ w -> RK.regular-prop DS[suc m].K.Gen DS[suc m].K.value) (\ b -> GmAt[b].rfree) B ;
  -- for every choice of bases
  gm : SR.GradeHyp = \ es t hh -> DS[t].K.Coords[d (suc t),es (suc t),d (suc (suc t)),es (suc (suc t))].from-free (gfree t hh) ;
  rg : SR.RegHyp = \ es -> DS[suc m].K.Coords[d (suc (suc m)),es (suc (suc m)),d (suc (suc (suc m))),es (suc (suc (suc m)))].reg-from-free rfree ;
  -- the last term is R^1
  sOne : Id Nat (s (suc m)) (suc zero) =
   Tr.Trunc[Bases0 p s].induction @l (\ w -> Id Nat (s (suc m)) (suc zero)) (\ w -> nat-set (s (suc m)) (suc zero)) (\ x ->
    sure (Id Nat (s (suc m)) (suc zero)) nt (FM.rank-one (s (suc m)) T9D.FromBases[N,a,m,P,G,(p,(s,(x.1,x.2))),h].iota')) rdata.2.1 ;

  -- a regular gcd of the 1 x 1 minors of a last map with image (a) is a gcd of the a_j (Thm89U.One, for R^n with n = 1)
  module TU = T89U.Theorem[N,a] ;
  GcdClaim (r n : Nat) : U l = (A : FR.Lin (FM.Free r) (FM.Free n)) (iota : MS.LinEquiv (FM.Free n) FM.regular) ->
   FR.ImageL N a (FM.Free r) (FM.Free n) A iota -> (g : R) ->
   L86.Gcd (MI.Index (suc zero) r n) (MI.minors (suc zero) r n (FM.mat r n A)) g -> L86.RegularElement g -> L86.Gcd (Ps.Fin N) a g ;
  claim-one (r : Nat) : GcdClaim r (suc zero) = \ A iota im g gc rg ->
   TU.One[r,A,iota,im].SA.Gcd[g,TU.One[r,A,iota,im].OR.gcd g gc,rg].result ;
  gcd-claim (r n : Nat) (es : Id Nat n (suc zero)) : GcdClaim r n = subst (GcdClaim r) (sym es) (claim-one r) ;
  -- the same for D_1 = 0: all a_j are 0
  ZeroClaim (r n : Nat) : U l = (A : FR.Lin (FM.Free r) (FM.Free n)) (iota : MS.LinEquiv (FM.Free n) FM.regular) ->
   FR.ImageL N a (FM.Free r) (FM.Free n) A iota -> MI.Vanish (suc zero) r n (FM.mat r n A) -> (j : Ps.Fin N) -> Id R (a j) D.1.z ;
  zero-one (r : Nat) : ZeroClaim r (suc zero) = \ A iota im -> TU.One[r,A,iota,im].zero-a ;
  zero-claim (r n : Nat) (es : Id Nat n (suc zero)) : ZeroClaim r n = subst (ZeroClaim r) (sym es) (zero-one r) ;

  -- the last rank, without bases: r m = 1 unless all a_j are 0
  last-stable : RT[m].K.Stable (r m) = rdata.2.2.2.1 m (C85.lt-self m) ;
  -- r m = 0: ∧^1 T m = 0, so D_1 of its matrix is 0 for any bases, and all a_j = 0
  module LastZero (e : Id Nat (r m) zero) {
   vanish : RT[m].K.VanishP (suc zero) = subst (\ k -> RT[m].K.VanishP (suc k)) e last-stable.1 ;
   module WZ (x : Bases0 p s) {
    module FB = T9D.FromBases[N,a,m,P,G,(p,(s,(x.1,x.2))),h] ;
    module CK = RT[m].K.Coords[s m,x.2 m,s (suc m),x.2 (suc m)] ;
    minors : MI.Vanish (suc zero) (s m) (s (suc m)) (FM.mat (s m) (s (suc m)) FB.CT[m].C.g) = CK.vanish-minors (suc zero) vanish ;
    zero (j : Ps.Fin N) : Id R (a j) D.1.z = zero-claim (s m) (s (suc m)) sOne FB.CT[m].C.g FB.iota' FB.image' minors j ;
   } ;
   zero (j : Ps.Fin N) : Id R (a j) D.1.z =
    Tr.Trunc[Bases0 p s].induction @l (\ w -> Id R (a j) D.1.z) (\ w -> D.2 (a j) D.1.z) (\ x -> WZ[x].zero j) rdata.2.1 ;
  } ;
  -- r m >= 2: D_(r m)(T m) regular, but G (m+1) has rank 1, so 1 = 0 (Resolution.too-big)
  module LastBig (k : Nat) (e : Id Nat (r m) (suc (suc k))) {
   module WB2 (x : Bases0 p s) {
    module CK = RT[m].K.Coords[s m,x.2 m,s (suc m),x.2 (suc m)] ;
    trivial : Id R D.1.o D.1.z = RS.too-big D (r m) (s m) (s (suc m)) k (trans e (ap (\ y -> plus y (suc k)) (sym sOne))) CK.A
     (CK.regular-image (r m) last-stable.2) ;
   } ;
   trivial : Id R D.1.o D.1.z =
    Tr.Trunc[Bases0 p s].induction @l (\ w -> Id R D.1.o D.1.z) (\ w -> D.2 D.1.o D.1.z) (\ x -> WB2[x].trivial) rdata.2.1 ;
  } ;
  AllZero : U l = (j : Ps.Fin N) -> Id R (a j) D.1.z ;
  last-cases1 : (k : Nat) -> Id Nat (r m) (suc k) -> Plus AllZero (Id Nat (r m) (suc zero)) = split {
   zero -> \ e -> inr e ;
   suc k -> \ e -> efq (nt LastBig[k,e].trivial) } ;
  last-cases : (k : Nat) -> Id Nat (r m) k -> Plus AllZero (Id Nat (r m) (suc zero)) = split {
   zero -> \ e -> inl LastZero[e].zero ;
   suc k -> last-cases1 k } ;
  last-rank : Plus AllZero (Id Nat (r m) (suc zero)) = last-cases (r m) (refl (r m)) ;
  -- a nonzero ideal: the last rank is 1
  pick-one (nz : AllZero -> Empty) : Plus AllZero (Id Nat (r m) (suc zero)) -> Id Nat (r m) (suc zero) = split {
   inl z0 -> efq (nz z0) ; inr e -> e } ;
  rank-one (nz : AllZero -> Empty) : Id Nat (r m) (suc zero) = pick-one nz last-rank ;

  -- Det(F) and a_Det, without choices, when the last rank is 1
  module Canonical (e : Id Nat (r m) (suc zero)) {
   module DT = DL.Chain[s'].Res[suc m,d,G',f',bs,hd,cz,gm,rg,trans e (sym sOne)] ;
   Det : FM.Module = DT.Det ;
   det-line : SC.LN.Line Det = DT.det-line ;
   aDet : SM.Linear Det DT.F0 = DT.aDet ;
   -- Thm 8.7/8.9: the image of a_Det is the gcd ideal of the a_j
   module GA = DL.GT.At[Ps.Fin N,a] ;
   module WB (x : Bases0 p s) {
    module CO = DT.Coordinates[es' x] ;
    module FB = T9D.FromBases[N,a,m,P,G,(p,(s,(x.1,x.2))),h] ;
    gcd-a : L86.Gcd (Ps.Fin N) a CO.det =
     gcd-claim (s m) (s (suc m)) sOne FB.CT[m].C.g FB.iota' FB.image' CO.det
      (subst (\ k -> L86.Gcd (MI.Index k (s m) (s (suc m))) (MI.minors k (s m) (s (suc m)) (FM.mat (s m) (s (suc m)) FB.CT[m].C.g)) CO.det) e CO.gcd)
      CO.regular ;
    to (y : R) (hy : DT.InImage y) : GA.InGcd y =
     GA.Principal[CO.det,gcd-a,y].from (CO.GA.Principal[CO.det,CO.gcd,y].to (CO.image-to y hy)) ;
    from (y : R) (hy : GA.InGcd y) : DT.InImage y =
     CO.image-from y (CO.GA.Principal[CO.det,CO.gcd,y].from (GA.Principal[CO.det,gcd-a,y].to hy)) ;
   } ;
   image-to (y : R) (hy : DT.InImage y) : GA.InGcd y =
    Tr.Trunc[Bases0 p s].induction @l (\ w -> GA.InGcd y)
     (\ w -> Tr.Trunc[(g : R) * L86.Gcd (Ps.Fin N) a g * ((t : R) * Id R y (D.1.mul g t))].proposition)
     (\ x -> WB[x].to y hy) rdata.2.1 ;
   image-from (y : R) (hy : GA.InGcd y) : DT.InImage y =
    Tr.Trunc[Bases0 p s].induction @l (\ w -> DT.InImage y)
     (\ w -> Tr.Trunc[(phi : Det.M) * (lam : SM.Linear DT.F0 FM.regular) * Id R (lam.1 (aDet.1 phi)) y].proposition)
     (\ x -> WB[x].from y hy) rdata.2.1 ;
   -- step 3 through the line: the regular gcds of the a_j are the regular generators of the image of a_Det
   RegGen (g : R) : U l = L86.RegularElement g * DL.GT.Generates DT.InImage g ;
   image-prop (y : R) : Pr.isProp (DT.InImage y) =
    Tr.Trunc[(phi : Det.M) * (lam : SM.Linear DT.F0 FM.regular) * Id R (lam.1 (aDet.1 phi)) y].proposition ;
   reggen-prop (g : R) : Pr.isProp (RegGen g) =
    HO.prod-prop (L86.RegularElement g) (DL.GT.Generates DT.InImage g) (DL.GT.regular-prop g) (DL.GT.generates-prop DT.InImage image-prop g) ;
   -- (g) = the image of a_Det iff (g) = the gcd ideal
   gen-to (g : R) (ig : DL.GT.Generates GA.InGcd g) : DL.GT.Generates DT.InImage g =
    \ y -> (\ hy -> (ig y).1 (image-to y hy),\ ht -> image-from y ((ig y).2 ht)) ;
   gen-from (g : R) (ig : DL.GT.Generates DT.InImage g) : DL.GT.Generates GA.InGcd g =
    \ y -> (\ hy -> (ig y).1 (image-from y hy),\ ht -> image-to y ((ig y).2 ht)) ;
   -- merely a gcd (DetLine's det, for any bases)
   some-gcd : Tr.Trunc[(g0 : R) * L86.Gcd (Ps.Fin N) a g0].carrier =
    TC.map (Bases0 p s) ((g0 : R) * L86.Gcd (Ps.Fin N) a g0) (\ x -> (WB[x].CO.det,WB[x].gcd-a)) rdata.2.1 ;
   some-reg : Tr.Trunc[GA.RegGcd].carrier =
    TC.map (Bases0 p s) GA.RegGcd (\ x -> (WB[x].CO.det,(WB[x].gcd-a,WB[x].CO.regular))) rdata.2.1 ;
   to-gen (g : R) (t : GA.IsRegGcd g) : RegGen g = (t.2,gen-to g (GA.generates g t.1)) ;
   from-gen (g : R) (t : RegGen g) : GA.IsRegGcd g = GA.FromGen[g,t.1,gen-from g t.2].result some-gcd ;
   Gens : U l = (g : R) * RegGen g ;
   gens-equiv : Pr.Equiv GA.RegGcd Gens = (\ t -> (t.1,to-gen t.1 t.2),
    Pr.qinv GA.RegGcd Gens (\ t -> (t.1,to-gen t.1 t.2)) (\ w -> (w.1,from-gen w.1 w.2))
     (\ w -> Pr.Sigma-eq R RegGen w.1 w.1 (to-gen w.1 (from-gen w.1 w.2)) w.2 (refl w.1) (reggen-prop w.1))
     (\ t -> GA.eq (t.1,from-gen t.1 (to-gen t.1 t.2)) t (refl t.1))) ;
   gens-eq : Id (U l) GA.RegGcd Gens = UA.ua GA.RegGcd Gens gens-equiv ;
   -- the regular generators of the image of a_Det form an R^x-torsor
   gens-torsor : DL.GT.TB.TorStr Gens = Prelude[l+].subst (U l) (\ T -> DL.GT.TB.TorStr T) GA.RegGcd Gens gens-eq (GA.torsor some-reg) ;
  } ;
  -- the canonical Det(F), for a nonzero ideal
  module NonZero (nz : AllZero -> Empty) { module C = Canonical[rank-one nz] ; } ;
 } ;
 -- for an FFRes
 module OfRes (N : Nat) (a : Ps.Fin N -> R) (f : FR.FFRes N a) (nt : Id R D.1.o D.1.z -> Empty) {
  module A = At[N,a,f.1,f.2.1,f.2.2.1,f.2.2.2.1,f.2.2.2.2,nt] ;
 } ;
} ;
