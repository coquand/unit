-- The determinant line depends only on the ideal (cffru).
-- Generic part (Compare).  Let a : K -> R and a' : K' -> R be linear and
-- injective with the same image.  Then there is a unique linear
-- isomorphism e : K ~ K' with a' e = a.  Proof: for x in K, a(x) is in the
-- image of a', so merely a(x) = a'(y); y is unique (a' injective), so it is
-- an element by unique choice: e(x) = y.  e is linear and has the inverse
-- built the same way, since a' e (x + x') = a x + a x' = a' (e x + e x'),
-- and similarly for scalars and composites (injectivity each time).
-- Uniqueness: a' e' = a = a' e gives e' = e pointwise.
-- Resolutions (Pair).  For two finite free resolutions F, F' of the same
-- nonzero ideal (a_j) (possibly of different lengths), a_1 and a_1' are
-- injective with the same image, the gcd ideal (DetGcd).  So there is a
-- unique e_(F,F') : Det(F) ~ Det(F') with a_1' e = a_1.  By uniqueness,
-- e_(F,F) = id (comp-id) and e_(F',F'') e_(F,F') = e_(F,F'') (comp), and
-- the isomorphism given by an isomorphism of resolutions (NaturalFFR) is
-- e_(F,F') (natural-eq).
-- The zero ideal (Decide).  Given a resolution, the last rank r_1 is a
-- number, 0 or 1 (DetFFR.last-rank): this decides whether all a_j are 0,
-- and otherwise the regular gcds form an R^x-torsor.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TG = TrueGrade[l] ;
module Free (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module FG = DetGcd[l].Free[Rg,setR] ;
 module FM = FG.FM ; module SM = FG.SM ;
 module NT = Natural[l].Over[Rg,setR] ;
 module MS = FM.MS ;
 module Compare (K K' : FM.Module) (a : SM.Linear K FM.regular) (inj : (x y : K.M) -> Id R (a.1 x) (a.1 y) -> Id K.M x y)
  (a' : SM.Linear K' FM.regular) (inj' : (x y : K'.M) -> Id R (a'.1 x) (a'.1 y) -> Id K'.M x y)
  (to : (y : R) -> FG.Gen[K,a,inj].Image y -> FG.Gen[K',a',inj'].Image y)
  (from : (y : R) -> FG.Gen[K',a',inj'].Image y -> FG.Gen[K,a,inj].Image y) {
  module GK = FG.Gen[K,a,inj] ; module GK' = FG.Gen[K',a',inj'] ;
  -- the unique preimage
  fib (x : K.M) : (y : K'.M) * Id R (a'.1 y) (a.1 x) =
   Tr.Trunc[(y : K'.M) * Id R (a'.1 y) (a.1 x)].induction @l (\ w -> (y : K'.M) * Id R (a'.1 y) (a.1 x)) (\ w -> GK'.fib-prop (a.1 x)) (\ u -> u)
    (to (a.1 x) (Tr.Trunc[(y : K.M) * Id R (a.1 y) (a.1 x)].inc (x,refl (a.1 x)))) ;
  bfib (y : K'.M) : (x : K.M) * Id R (a.1 x) (a'.1 y) =
   Tr.Trunc[(x : K.M) * Id R (a.1 x) (a'.1 y)].induction @l (\ w -> (x : K.M) * Id R (a.1 x) (a'.1 y)) (\ w -> GK.fib-prop (a'.1 y)) (\ u -> u)
    (from (a'.1 y) (Tr.Trunc[(x : K'.M) * Id R (a'.1 x) (a'.1 y)].inc (y,refl (a'.1 y)))) ;
  map (x : K.M) : K'.M = (fib x).1 ;
  map-eq (x : K.M) : Id R (a'.1 (map x)) (a.1 x) = (fib x).2 ;
  bmap (y : K'.M) : K.M = (bfib y).1 ;
  bmap-eq (y : K'.M) : Id R (a.1 (bmap y)) (a'.1 y) = (bfib y).2 ;
  lin : SM.Linear K K' = (map,
   \ x x' -> inj' (map (K.madd x x')) (K'.madd (map x) (map x')) (calc R {
    a'.1 (map (K.madd x x')) =< map-eq (K.madd x x') > a.1 (K.madd x x')
     =< a.2.1 x x' > add (a.1 x) (a.1 x')
     =< Ps.cong2 R add _ _ _ _ (sym (map-eq x)) (sym (map-eq x')) > add (a'.1 (map x)) (a'.1 (map x'))
     =< sym (a'.2.1 (map x) (map x')) > a'.1 (K'.madd (map x) (map x')) }),
   \ c x -> inj' (map (K.sm c x)) (K'.sm c (map x)) (calc R {
    a'.1 (map (K.sm c x)) =< map-eq (K.sm c x) > a.1 (K.sm c x)
     =< a.2.2 c x > mul c (a.1 x)
     =< ap (mul c) (sym (map-eq x)) > mul c (a'.1 (map x))
     =< sym (a'.2.2 c (map x)) > a'.1 (K'.sm c (map x)) })) ;
  blin : SM.Linear K' K = (bmap,
   \ y y' -> inj (bmap (K'.madd y y')) (K.madd (bmap y) (bmap y')) (calc R {
    a.1 (bmap (K'.madd y y')) =< bmap-eq (K'.madd y y') > a'.1 (K'.madd y y')
     =< a'.2.1 y y' > add (a'.1 y) (a'.1 y')
     =< Ps.cong2 R add _ _ _ _ (sym (bmap-eq y)) (sym (bmap-eq y')) > add (a.1 (bmap y)) (a.1 (bmap y'))
     =< sym (a.2.1 (bmap y) (bmap y')) > a.1 (K.madd (bmap y) (bmap y')) }),
   \ c y -> inj (bmap (K'.sm c y)) (K.sm c (bmap y)) (calc R {
    a.1 (bmap (K'.sm c y)) =< bmap-eq (K'.sm c y) > a'.1 (K'.sm c y)
     =< a'.2.2 c y > mul c (a'.1 y)
     =< ap (mul c) (sym (bmap-eq y)) > mul c (a.1 (bmap y))
     =< sym (a.2.2 c (bmap y)) > a.1 (K.sm c (bmap y)) })) ;
  -- e : K ~ K' with a' e = a
  equiv : MS.LinEquiv K K' = NT.mk-equiv K K' lin blin
   (\ y -> inj' (map (bmap y)) y (trans (map-eq (bmap y)) (bmap-eq y)))
   (\ x -> inj (bmap (map x)) x (trans (bmap-eq (map x)) (map-eq x))) ;
  commutes (x : K.M) : Id R (a'.1 (equiv.1.1 x)) (a.1 x) = map-eq x ;
  -- and it is the only one
  unique (e : MS.LinEquiv K K') (h : (x : K.M) -> Id R (a'.1 (e.1.1 x)) (a.1 x)) (x : K.M) : Id K'.M (e.1.1 x) (equiv.1.1 x) =
   inj' (e.1.1 x) (map x) (trans (h x) (sym (map-eq x))) ;
 } ;
} ;

module Over (D : TG.RD) {
 module DG = DetGcd[l].Over[D] ;
 module DF = DG.DF ; module FM = DF.FM ; module MS = DF.MS ;
 module FC = Free[D.1,D.2] ;
 R : U l = D.1.R ;
 AllZero (N : Nat) (a : Ps.Fin N -> R) : U l = (j : Ps.Fin N) -> Id R (a j) D.1.z ;
 -- the comparison for two resolutions of the same nonzero ideal
 module Pair (N : Nat) (a : Ps.Fin N -> R) (nt : Id R D.1.o D.1.z -> Empty) (nz : AllZero N a -> Empty) (f f' : DF.FR.FFRes N a) {
  module O = DG.OfRes[N,a,f,nt,nz].A ; module O' = DG.OfRes[N,a,f',nt,nz].A ;
  -- a_1 and a_1' have the same image, the gcd ideal
  to (y : R) (h : O.G1.Image y) : O'.G1.Image y = O'.image-from y (O'.CA.image-from y (O.CA.image-to y (O.image-to y h))) ;
  from (y : R) (h : O'.G1.Image y) : O.G1.Image y = O.image-from y (O.CA.image-from y (O'.CA.image-to y (O'.image-to y h))) ;
  module C = FC.Compare[O.CA.Det,O'.CA.Det,O.a1,O.a1-inj,O'.a1,O'.a1-inj,to,from] ;
  -- e_(F,F') : Det(F) ~ Det(F') with a_1' e = a_1, unique
  e : MS.LinEquiv O.CA.Det O'.CA.Det = C.equiv ;
  commutes (x : O.CA.Det.M) : Id R (O'.a1.1 (e.1.1 x)) (O.a1.1 x) = C.commutes x ;
  unique (e' : MS.LinEquiv O.CA.Det O'.CA.Det) (h : (x : O.CA.Det.M) -> Id R (O'.a1.1 (e'.1.1 x)) (O.a1.1 x)) (x : O.CA.Det.M) :
   Id O'.CA.Det.M (e'.1.1 x) (e.1.1 x) = C.unique e' h x ;
 } ;
 -- the laws: e_(F,F) = id and e_(F',F'') e_(F,F') = e_(F,F'')
 module Laws (N : Nat) (a : Ps.Fin N -> R) (nt : Id R D.1.o D.1.z -> Empty) (nz : AllZero N a -> Empty) (f f' f'' : DF.FR.FFRes N a) {
  module P0 = Pair[N,a,nt,nz,f,f] ; module P1 = Pair[N,a,nt,nz,f,f'] ; module P2 = Pair[N,a,nt,nz,f',f''] ; module P3 = Pair[N,a,nt,nz,f,f''] ;
  comp-id (x : P0.O.CA.Det.M) : Id P0.O.CA.Det.M x (P0.e.1.1 x) = P0.unique (MS.idLin P0.O.CA.Det) (\ y -> refl (P0.O.a1.1 y)) x ;
  comp (x : P1.O.CA.Det.M) : Id P3.O'.CA.Det.M (P2.e.1.1 (P1.e.1.1 x)) (P3.e.1.1 x) =
   P3.O'.a1-inj (P2.e.1.1 (P1.e.1.1 x)) (P3.e.1.1 x) (trans (P2.commutes (P1.e.1.1 x)) (trans (P1.commutes x) (sym (P3.commutes x)))) ;
 } ;
 -- an isomorphism of resolutions gives e_(F,F') (NaturalFFR)
 module FromIso (N : Nat) (a : Ps.Fin N -> R) (m : Nat) (nt : Id R D.1.o D.1.z -> Empty) (nz : AllZero N a -> Empty)
  (d d' : NaturalFFR[l].Over[D].At[N,a,m].Data) (p : Id NaturalFFR[l].Over[D].At[N,a,m].Data d d') {
  module NF = NaturalFFR[l].Over[D].At[N,a,m].DetNatural[nt,nz] ;
  module P = Pair[N,a,nt,nz,(m,d),(m,d')] ;
  natural-eq (x : P.O.CA.Det.M) : Id P.O'.CA.Det.M ((NF.natural d d' p).1.1.1 x) (P.e.1.1 x) =
   P.unique (NF.natural d d' p).1 (NF.natural d d' p).2 x ;
 } ;
 -- the zero ideal is decided by the last rank: all a_j are 0, or the regular gcds form an R^x-torsor
 module Decide (N : Nat) (a : Ps.Fin N -> R) (f : DF.FR.FFRes N a) (nt : Id R D.1.o D.1.z -> Empty) {
  module AT = DF.OfRes[N,a,f,nt].A ;
  module GA = DF.DL.GT.At[Ps.Fin N,a] ;
  pick : Plus AT.AllZero (Id Nat (AT.r f.1) (suc zero)) -> Plus (AllZero N a) (DF.DL.GT.TB.TorStr GA.RegGcd) = split {
   inl z0 -> inl z0 ;
   inr e -> inr (AT.Canonical[e].GA.torsor AT.Canonical[e].some-reg) } ;
  result : Plus (AllZero N a) (DF.DL.GT.TB.TorStr GA.RegGcd) = pick AT.last-rank ;
 } ;
} ;
