-- Wiebe's theorem without bases (ctete Theorem 11; cffru, step 1).
-- F merely ~ R^n; α, β : F -> R linear forms; V : F -> F linear with
-- β ≡ α ∘ V mod J (Hyp); Δ = det V, the scalar of ∧^n V on the top line
-- (DetEnd, no basis).  The ideals are those of the forms: x ∈ (J, β) when
-- merely x ≡ β(v) mod J (InB), x ∈ (J, β, α) when x ≡ β(v) + α(w)
-- (InBA), x ∈ (J, β, Δ) when x ≡ β(v) + t Δ (InBD).  If Gr(β) ≥ n mod J
-- (GradeHyp: for every basis, the coefficients of β; one basis suffices,
-- grade-from) then, mod (J, β):
--   (Perp)  x Δ ∈ (J, β) gives x ∈ (J, β, α);
--   (Ann)   x α(w) ∈ (J, β) for all w gives x ∈ (J, β, Δ)   (theorem).
-- No basis, no matrix, no elementary operation occurs in the statement.
-- Proof.  The conclusions are propositions: choose a basis e (Coords).
-- A linear form λ is v |-> Σ_k c_k (e v)_k with c_k = λ(e^-1 δ_k)
-- (Form.at, by FreeModules.apply-mat), so (c) is the image of λ (in-c,
-- from-c).  With a = c(α), b = c(β), A the matrix of e V e^-1 and Wiebe's
-- V_ij = A_ji (transpose): b ≡ V a mod J is Hyp at e^-1 δ_j (hyp), and
-- Δ = det A = det A^T (DetEnd.delta-coords, det-transpose).  Wiebe's
-- theorem11 gives the conclusions for the lists (J, b), (J, b, a),
-- (J, b, Δ); they are InB, InBA, InBD by the expansion and cat-split
-- (to-b, from-ba, from-bd).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module TG = TrueGrade[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 open ExteriorModel[l].Over[Rg] ;
 D : TG.RD = (Rg,setR) ;
 module DE = DetEnd[l].Over[Rg,setR] ;
 module FM = DE.FM ; module SM = DE.SM ; module MS = DE.MS ; module ED = DE.ED ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module ET = ExteriorTranspose[l].Over[Rg,setR] ;
 module WL = WiebeLists[l].Over[Rg,setR] ;
 module WM = WiebeMatrices[l].Over[Rg,setR] ;
 module WK = WiebeCore[l].Over[Rg,setR] ;
 module WS = WiebeSequences[l] ;
 module At (M : FM.Module) (n : Nat) (bM : Tr.Trunc[MS.LinEquiv M (FM.Free n)].carrier) (m : Nat) (J : Ps.Fin m -> R)
  (alpha beta : SM.Linear M FM.regular) (V : SM.Linear M M) {
  module DV = DE.At[M,n,bM,V] ;
  Delta : R = DV.Delta ;
  -- the ideals of the forms, mod J
  InB (x : R) : U l = Tr.Trunc[(v : M.M) * WL.Cong m J x (beta.1 v)].carrier ;
  InBA (x : R) : U l = Tr.Trunc[(v : M.M) * (w : M.M) * WL.Cong m J x (add (beta.1 v) (alpha.1 w))].carrier ;
  InBD (d x : R) : U l = Tr.Trunc[(v : M.M) * (t : R) * WL.Cong m J x (add (beta.1 v) (mul t d))].carrier ;
  -- β = α V mod J
  Hyp : U l = (v : M.M) -> WL.Cong m J (beta.1 v) (alpha.1 (V.1 v)) ;
  Perp : U l = (x : R) -> InB (mul x Delta) -> InBA x ;
  Ann : U l = (x : R) -> ((w : M.M) -> InB (mul x (alpha.1 w))) -> InBD Delta x ;
  -- coefficients of a form in a basis
  coef (e : MS.LinEquiv M (FM.Free n)) (lam : SM.Linear M FM.regular) (k : Ps.Fin n) : R = lam.1 (ED.Inv[M,FM.Free n,e].inv (FM.basis n k)) ;
  -- Gr(β) >= n mod J
  GradeHyp : U l = (e : MS.LinEquiv M (FM.Free n)) -> TG.TGr n D m J n (coef e beta) ;

  module Coords (e : MS.LinEquiv M (FM.Free n)) {
   module IE = ED.Inv[M,FM.Free n,e] ;
   -- a form in coordinates
   module Form (lam : SM.Linear M FM.regular) {
    c : Ps.Fin n -> R = coef e lam ;
    g1 : SM.Linear (FM.Free n) (FM.Free (suc zero)) = (\ x j -> lam.1 (IE.inv x),
     \ x y -> ap (\ t j -> t) (trans (ap lam.1 (IE.inv-add x y)) (lam.2.1 (IE.inv x) (IE.inv y))),
     \ a x -> ap (\ t j -> t) (trans (ap lam.1 (IE.inv-scale a x)) (lam.2.2 a (IE.inv x)))) ;
    lin-value (x : (FM.Free n).M) : Id R (lam.1 (IE.inv x)) (S.lin n c x) =
     trans (FM.apply-mat n (suc zero) g1 x (inr tt)) (S.sum-cong n (\ k -> mul (x k) (c k)) (\ k -> mul (c k) (x k)) (\ k -> mulC (x k) (c k))) ;
    at (v : M.M) : Id R (lam.1 v) (S.lin n c (e.1.1 v)) = trans (ap lam.1 (sym (IE.ret-eq v))) (lin-value (e.1.1 v)) ;
    -- (c) is the image of λ
    in-c (v : M.M) : WL.In n c (lam.1 v) = Tr.Trunc[S.Coordinates n c (lam.1 v)].inc (e.1.1 v,sym (at v)) ;
    from-c (t : R) (h : WL.In n c t) : Tr.Trunc[(v : M.M) * Id R (lam.1 v) t].carrier =
     TC.map (S.Coordinates n c t) ((v : M.M) * Id R (lam.1 v) t) (\ u -> (IE.inv u.1,trans (lin-value u.1) u.2)) h ;
   } ;
   module FA = Form[alpha] ; module FB = Form[beta] ;
   a : Ps.Fin n -> R = FA.c ; b : Ps.Fin n -> R = FB.c ;
   -- Wiebe's matrix is the transpose of the matrix of e V e^-1
   A : DT.Mat n = DV.Basis[e].A ;
   Vw : DT.Mat n = ET.transpose n A ;
   delta-eq : Id R Delta (det n Vw) = trans (DV.delta-coords e) (ET.det-transpose n A) ;
   -- (V a)_j = Σ_i a_i A_ji = α(V(e^-1 δ_j)) (transpose-value, then Form.at)
   act-eq (j : Ps.Fin n) : Id R (alpha.1 (V.1 (IE.inv (FM.basis n j)))) (DT.act n Vw a j) =
    trans (FA.at (V.1 (IE.inv (FM.basis n j))))
     (S.sum-cong n (\ i -> mul (a i) (A j i)) (\ i -> mul (a i) (Vw i j)) (\ i -> ap (mul (a i)) (sym (ET.transpose-value n A i j)))) ;
   hyp (h : Hyp) : WM.Hyp m J n a b Vw = \ j ->
    WL.Mod[m,J].cong-eq (b j) (alpha.1 (V.1 (IE.inv (FM.basis n j)))) (DT.act n Vw a j) (h (IE.inv (FM.basis n j))) (act-eq j) ;
   -- the ideals of the lists are those of the forms
   K : Ps.Fin (plus n m) -> R = WL.cat n b m J ;
   to-b (x : R) (h : InB x) : WL.In (plus n m) K x =
    Tr.Trunc[(v : M.M) * WL.Cong m J x (beta.1 v)].induction @l (\ w -> WL.In (plus n m) K x) (\ w -> WL.in-prop (plus n m) K x)
     (\ u -> WL.Mod[plus n m,K].in-cong x (beta.1 u.1) (WL.cong-cat n b m J x (beta.1 u.1) u.2) (WL.cat-in-gen n b m J (beta.1 u.1) (FB.in-c u.1))) h ;
   module BA (x t t' : R) (hJ : WL.In m J (WL.sub (WL.sub x t) t')) (w v : M.M) (hw : Id R (alpha.1 w) t) (hv : Id R (beta.1 v) t') {
    result : InBA x = Tr.Trunc[(v' : M.M) * (w' : M.M) * WL.Cong m J x (add (beta.1 v') (alpha.1 w'))].inc
     (v,(w,subst (WL.In m J) (trans (WL.split-sub x t t') (ap (WL.sub x) (sym (Ps.cong2 R add _ _ _ _ hv hw)))) hJ)) ;
   } ;
   from-ba (x : R) (h : WL.In (plus n (plus n m)) (WL.cat n a (plus n m) K) x) : InBA x =
    Tr.Trunc[WL.Split n a (plus n m) K x].induction @l (\ q -> InBA x)
     (\ q -> Tr.Trunc[(v : M.M) * (w : M.M) * WL.Cong m J x (add (beta.1 v) (alpha.1 w))].proposition)
     (\ u -> Tr.Trunc[WL.Split n b m J (WL.sub x u.1)].induction @l (\ q -> InBA x)
       (\ q -> Tr.Trunc[(v : M.M) * (w : M.M) * WL.Cong m J x (add (beta.1 v) (alpha.1 w))].proposition)
       (\ u' -> Tr.Trunc[(w : M.M) * Id R (alpha.1 w) u.1].induction @l (\ q -> InBA x)
         (\ q -> Tr.Trunc[(v : M.M) * (w : M.M) * WL.Cong m J x (add (beta.1 v) (alpha.1 w))].proposition)
         (\ ww -> Tr.Trunc[(v : M.M) * Id R (beta.1 v) u'.1].induction @l (\ q -> InBA x)
           (\ q -> Tr.Trunc[(v : M.M) * (w : M.M) * WL.Cong m J x (add (beta.1 v) (alpha.1 w))].proposition)
           (\ vv -> BA[x,u.1,u'.1,u'.2.2,ww.1,vv.1,ww.2,vv.2].result) (FB.from-c u'.1 u'.2.1))
         (FA.from-c u.1 u.2.1))
       (WL.cat-split n b m J (WL.sub x u.1) u.2.2))
     (WL.cat-split n a (plus n m) K x h) ;
   module BD (d x y s : R) (hx : Id R (add (mul d s) y) x) (t' : R) (hJ : WL.In m J (WL.sub y t')) (v : M.M) (hv : Id R (beta.1 v) t') {
    cong : WL.Cong m J x (add (beta.1 v) (mul s d)) =
     WL.Mod[m,J].eq-cong x (add y (mul s d)) (add (beta.1 v) (mul s d))
      (trans (sym hx) (trans (addC (mul d s) y) (ap (add y) (mulC d s))))
      (WL.Mod[m,J].cong-add y (beta.1 v) (mul s d) (mul s d) (subst (\ q -> WL.Cong m J y q) (sym hv) hJ) (WL.Mod[m,J].cong-refl (mul s d))) ;
    result : InBD d x = Tr.Trunc[(v' : M.M) * (t : R) * WL.Cong m J x (add (beta.1 v') (mul t d))].inc (v,(s,cong)) ;
   } ;
   from-bd (d x : R) (h : WL.In (suc (plus n m)) (TG.extend D (plus n m) K d) x) : InBD d x =
    Tr.Trunc[S.Coordinates (suc (plus n m)) (TG.extend D (plus n m) K d) x].induction @l (\ q -> InBD d x)
     (\ q -> Tr.Trunc[(v : M.M) * (t : R) * WL.Cong m J x (add (beta.1 v) (mul t d))].proposition)
     (\ u -> Tr.Trunc[WL.Split n b m J (S.lin (plus n m) K (\ i -> u.1 (inl i)))].induction @l (\ q -> InBD d x)
       (\ q -> Tr.Trunc[(v : M.M) * (t : R) * WL.Cong m J x (add (beta.1 v) (mul t d))].proposition)
       (\ u' -> Tr.Trunc[(v : M.M) * Id R (beta.1 v) u'.1].induction @l (\ q -> InBD d x)
         (\ q -> Tr.Trunc[(v : M.M) * (t : R) * WL.Cong m J x (add (beta.1 v) (mul t d))].proposition)
         (\ vv -> BD[d,x,S.lin (plus n m) K (\ i -> u.1 (inl i)),u.1 (inr tt),u.2,u'.1,u'.2.2,vv.1,vv.2].result) (FB.from-c u'.1 u'.2.1))
       (WL.cat-split n b m J (S.lin (plus n m) K (\ i -> u.1 (inl i)))
        (Tr.Trunc[S.Coordinates (plus n m) K (S.lin (plus n m) K (\ i -> u.1 (inl i)))].inc (\ i -> u.1 (inl i),refl (S.lin (plus n m) K (\ i -> u.1 (inl i)))))))
     h ;
   -- Wiebe's theorem in these coordinates
   module Thm (h : Hyp) (g : GradeHyp) {
    concl : WK.Concl m J n a b (det n Vw) = Wiebe[l].theorem11 n D m J a b Vw (hyp h) (g e) ;
    perp : Perp = \ x hx -> from-ba x (concl.1 x (to-b (mul x (det n Vw)) (subst (\ q -> InB (mul x q)) delta-eq hx))) ;
    ann : Ann = \ x hx -> subst (\ q -> InBD q x) (sym delta-eq)
     (from-bd (det n Vw) x (concl.2 x (\ i -> to-b (mul x (a i)) (hx (IE.inv (FM.basis n i)))))) ;
   } ;
  } ;
  -- the theorem, without bases
  theorem (h : Hyp) (g : GradeHyp) : Perp * Ann =
   (\ x hx -> Tr.Trunc[MS.LinEquiv M (FM.Free n)].induction @l (\ q -> InBA x)
     (\ q -> Tr.Trunc[(v : M.M) * (w : M.M) * WL.Cong m J x (add (beta.1 v) (alpha.1 w))].proposition)
     (\ e -> Coords[e].Thm[h,g].perp x hx) bM,
    \ x hx -> Tr.Trunc[MS.LinEquiv M (FM.Free n)].induction @l (\ q -> InBD Delta x)
     (\ q -> Tr.Trunc[(v : M.M) * (t : R) * WL.Cong m J x (add (beta.1 v) (mul t Delta))].proposition)
     (\ e -> Coords[e].Thm[h,g].ann x hx) bM) ;
  -- the grade hypothesis for one basis gives it for all (WiebeSequences.TgrSub)
  grade-from (e0 : MS.LinEquiv M (FM.Free n)) (g0 : TG.TGr n D m J n (coef e0 beta)) : GradeHyp = \ e ->
   WS.TgrSub[D,n,m,J,n,coef e0 beta,n,coef e beta,
    \ i -> Coords[e].to-b (coef e0 beta i)
     (Tr.Trunc[(v : M.M) * WL.Cong m J (coef e0 beta i) (beta.1 v)].inc
      (ED.Inv[M,FM.Free n,e0].inv (FM.basis n i),WL.Mod[m,J].cong-refl (coef e0 beta i)))].result g0 ;
 } ;
} ;
