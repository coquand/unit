-- Naturality of the structure and of Det(F) (cffru, step 2, T4).
-- An isomorphism of complexes φ_t : G t ~ G' t, φ_(t+1) f_t = f'_t φ_t,
-- gives isomorphisms of the lines e_t : R_t ~ R'_t (eL):
--   e_0 = id,  e_(t+1)(ψ) = ∧φ_(t+1) ∘ ψ ∘ e_t^-1     (HomIso over LamIso)
-- and the unique structures correspond: a'_t ∘ e_t = ∧φ ∘ a_t; for the
-- last map, a'_Det ∘ e = ∧φ ∘ a_Det (Res.Natural.natural).
-- Proof.  Conjugate the structure (a_t) of F: a'_t = ∧φ ∘ a_t ∘ e_t^-1
-- (ConjMap; Frame holds what does not depend on the maps, so the chain
-- and Transfer name e and the conjugate alike).  One stage (Transfer): ∧f' ∧φ = ∧φ ∧f (square, on
-- generators), e(y ∧ a_t) = ∧φ(y) ∧ a'_t (wedge-eq: ∧φ is
-- multiplicative), so (*) for a gives (*) for a' (ST.star); regularity
-- passes since ∧φ is injective (regular).  So the conjugate is a
-- structure of F' (Tp.structure), hence F''s unique one.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module SC = Structure[l].Over[Rg,setR] ;
 module SS = SC.SS ; module TL = SC.TL ; module ED = SC.ED ; module EF = SC.EF ; module FM = SC.FM ;
 module FF = SC.FF ; module SM = SC.SM ; module MS = SC.MS ; module AL = SC.AL ; module EC = SC.EC ;
 module LN = SC.LN ; module C85 = SC.C85 ;
 comp (M N Q : FM.Module) (g : SM.Linear N Q) (f : SM.Linear M N) : SM.Linear M Q = (\ v -> g.1 (f.1 v),
  \ x y -> trans (ap g.1 (f.2.1 x y)) (g.2.1 (f.1 x) (f.1 y)),
  \ c x -> trans (ap g.1 (f.2.2 c x)) (g.2.2 c (f.1 x))) ;
 -- mutually inverse linear maps
 mk-equiv (M N : FM.Module) (f : SM.Linear M N) (g : SM.Linear N M) (fg : (y : N.M) -> Id N.M (f.1 (g.1 y)) y)
  (gf : (x : M.M) -> Id M.M (g.1 (f.1 x)) x) : MS.LinEquiv M N =
  ((f.1,Pr.qinv M.M N.M f.1 g.1 fg gf),f.2.1,f.2.2) ;

 -- ∧ of a linear equivalence
 module LamIso (M N : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) (bN : Tr.Trunc[FF.Based N].carrier) (e : MS.LinEquiv M N) {
  module IE = ED.Inv[M,N,e] ;
  module WF = EF.Wedge[M,N,bM,bN,FM.lin M N e] ; module WB = EF.Wedge[N,M,bN,bM,IE.linear] ;
  back (x : WF.LM.alg.A) : Id WF.LM.alg.A (WB.wedge.1 (WF.wedge.1 x)) x =
   ap (\ h -> h.1 x) (WF.LM.hom-eq WF.LM.alg (AL.comp WF.LM.alg WF.LN.alg WF.LM.alg WB.wedge WF.wedge) (EC.idHom WF.LM.alg)
    (\ v -> trans (ap WB.wedge.1 (WF.wedge-gen v)) (trans (WB.wedge-gen (e.1.1 v)) (ap WF.LM.gen.1 (IE.ret-eq v))))) ;
  forth (y : WF.LN.alg.A) : Id WF.LN.alg.A (WF.wedge.1 (WB.wedge.1 y)) y =
   ap (\ h -> h.1 y) (WF.LN.hom-eq WF.LN.alg (AL.comp WF.LN.alg WF.LM.alg WF.LN.alg WF.wedge WB.wedge) (EC.idHom WF.LN.alg)
    (\ v -> trans (ap WF.wedge.1 (WB.wedge-gen v)) (trans (WF.wedge-gen (IE.inv v)) (ap WF.LN.gen.1 (IE.inv-eq v))))) ;
  -- on ∧^k
  module Pc (k : Nat) {
   module PF = TL.PieceMap[M,N,bM,bN,FM.lin M N e,k] ; module PB = TL.PieceMap[N,M,bN,bM,IE.linear,k] ;
   forth-p (y : PF.PN.carrier.M) : Id PF.PN.carrier.M (PF.map.1 (PB.map.1 y)) y = PF.PN.SB.eq _ _ (forth y.1) ;
   back-p (x : PF.PM.carrier.M) : Id PF.PM.carrier.M (PB.map.1 (PF.map.1 x)) x = PF.PM.SB.eq _ _ (back x.1) ;
   equiv : MS.LinEquiv PF.PM.carrier PF.PN.carrier = mk-equiv PF.PM.carrier PF.PN.carrier PF.map PB.map forth-p back-p ;
  } ;
 } ;
 -- Hom(K, V) ~ Hom(K', V') for K ~ K', V ~ V'
 module HomIso (K K' V V' : FM.Module) (eK : MS.LinEquiv K K') (eV : MS.LinEquiv V V') {
  module H = LN.Hom[K,V] ; module H' = LN.Hom[K',V'] ;
  module IK = ED.Inv[K,K',eK] ; module IV = ED.Inv[V,V',eV] ;
  fun (psi : H.T) : H'.T = comp K' V V' (FM.lin V V' eV) (comp K' K V psi IK.linear) ;
  inv (psi : H'.T) : H.T = comp K V' V IV.linear (comp K K' V' psi (FM.lin K K' eK)) ;
  map : SM.Linear H.hmod H'.hmod = (fun,
   \ u v -> H'.eq _ _ (\ x -> eV.2.1 (u.1 (IK.inv x)) (v.1 (IK.inv x))),
   \ c u -> H'.eq _ _ (\ x -> eV.2.2 c (u.1 (IK.inv x)))) ;
  imap : SM.Linear H'.hmod H.hmod = (inv,
   \ u v -> H.eq _ _ (\ x -> IV.inv-add (u.1 (eK.1.1 x)) (v.1 (eK.1.1 x))),
   \ c u -> H.eq _ _ (\ x -> IV.inv-scale c (u.1 (eK.1.1 x)))) ;
  equiv : MS.LinEquiv H.hmod H'.hmod = mk-equiv H.hmod H'.hmod map imap
   (\ u -> H'.eq _ _ (\ x -> trans (IV.inv-eq (u.1 (eK.1.1 (IK.inv x)))) (ap u.1 (IK.inv-eq x))))
   (\ u -> H.eq _ _ (\ x -> trans (IV.ret-eq (u.1 (IK.inv (eK.1.1 x)))) (ap u.1 (IK.ret-eq x)))) ;
 } ;
 -- a' = eV ∘ a ∘ eR^-1
 module ConjMap (R1 R1' V V' : FM.Module) (eR : MS.LinEquiv R1 R1') (eV : SM.Linear V V') (a : SM.Linear R1 V) {
  module IR = ED.Inv[R1,R1',eR] ;
  a' : SM.Linear R1' V' = comp R1' V V' eV (comp R1' R1 V a IR.linear) ;
  relation (psi : R1.M) : Id V'.M (a'.1 (eR.1.1 psi)) (eV.1 (a.1 psi)) = ap (\ u -> eV.1 (a.1 u)) (IR.ret-eq psi) ;
 } ;

 -- one stage: the parts that do not depend on the maps
 module Frame (P Q P' Q' : FM.Module) (bP : Tr.Trunc[FF.Based P].carrier) (bQ : Tr.Trunc[FF.Based Q].carrier)
  (bP' : Tr.Trunc[FF.Based P'].carrier) (bQ' : Tr.Trunc[FF.Based Q'].carrier)
  (eP : MS.LinEquiv P P') (eQ : MS.LinEquiv Q Q') (q p : Nat) (K K' : FM.Module) (eK : MS.LinEquiv K K') {
  module LP = LamIso[P,P',bP,bP',eP] ; module LQ = LamIso[Q,Q',bQ,bQ',eQ] ;
  module PS = TL.Piece[P,bP,plus q p] ; module PS' = TL.Piece[P',bP',plus q p] ;
  module PQ = TL.Piece[Q,bQ,q] ; module PQ' = TL.Piece[Q',bQ',q] ;
  module HI = HomIso[K,K',PS.carrier,PS'.carrier,eK,LP.Pc[plus q p].equiv] ;
  eR : MS.LinEquiv HI.H.hmod HI.H'.hmod = HI.equiv ;
  module CJ (a : SM.Linear HI.H.hmod PQ.carrier) { module C = ConjMap[HI.H.hmod,HI.H'.hmod,PQ.carrier,PQ'.carrier,eR,LQ.Pc[q].PF.map,a] ; } ;
 } ;
 module Transfer (P Q P' Q' : FM.Module) (bP : Tr.Trunc[FF.Based P].carrier) (bQ : Tr.Trunc[FF.Based Q].carrier)
  (bP' : Tr.Trunc[FF.Based P'].carrier) (bQ' : Tr.Trunc[FF.Based Q'].carrier) (f : SM.Linear P Q) (f' : SM.Linear P' Q')
  (eP : MS.LinEquiv P P') (eQ : MS.LinEquiv Q Q') (comm : (x : P.M) -> Id Q'.M (eQ.1.1 (f.1 x)) (f'.1 (eP.1.1 x)))
  (q p : Nat) (K K' : FM.Module) (eK : MS.LinEquiv K K')
  (a1 : SM.Linear K TL.Piece[P,bP,p].carrier) (a1' : SM.Linear K' TL.Piece[P',bP',p].carrier) {
  module S = SS.Stage[P,Q,bP,bQ,f,q,p,K,a1] ; module S' = SS.Stage[P',Q',bP',bQ',f',q,p,K',a1'] ;
  module FR = Frame[P,Q,P',Q',bP,bQ,bP',bQ',eP,eQ,q,p,K,K',eK] ;
  module LP = FR.LP ; module LQ = FR.LQ ; module HI = FR.HI ;
  eR : MS.LinEquiv S.Rk S'.Rk = FR.eR ;
  -- ∧f' ∧eP = ∧eQ ∧f
  square (x : LP.WF.LM.alg.A) : Id LQ.WF.LN.alg.A (S'.W.W.wedge.1 (LP.WF.wedge.1 x)) (LQ.WF.wedge.1 (S.W.W.wedge.1 x)) =
   ap (\ h -> h.1 x) (LP.WF.LM.hom-eq LQ.WF.LN.alg
    (AL.comp LP.WF.LM.alg LP.WF.LN.alg LQ.WF.LN.alg S'.W.W.wedge LP.WF.wedge)
    (AL.comp LP.WF.LM.alg LQ.WF.LM.alg LQ.WF.LN.alg LQ.WF.wedge S.W.W.wedge)
    (\ v -> calc LQ.WF.LN.alg.A {
     S'.W.W.wedge.1 (LP.WF.wedge.1 (LP.WF.LM.gen.1 v)) =< ap S'.W.W.wedge.1 (LP.WF.wedge-gen v)
      > S'.W.W.wedge.1 (LP.WF.LN.gen.1 (eP.1.1 v)) =< S'.W.W.wedge-gen (eP.1.1 v) > LQ.WF.LN.gen.1 (f'.1 (eP.1.1 v))
      =< ap LQ.WF.LN.gen.1 (sym (comm v)) > LQ.WF.LN.gen.1 (eQ.1.1 (f.1 v))
      =< sym (LQ.WF.wedge-gen (f.1 v)) > LQ.WF.wedge.1 (LQ.WF.LM.gen.1 (f.1 v))
      =< ap LQ.WF.wedge.1 (sym (S.W.W.wedge-gen v)) > LQ.WF.wedge.1 (S.W.W.wedge.1 (LP.WF.LM.gen.1 v)) })) ;
  -- the relation between a1 and a1'
  Rel : U l = (k : K.M) -> Id S'.PB.carrier.M (a1'.1 (eK.1.1 k)) (LP.Pc[p].PF.map.1 (a1.1 k)) ;
  module ST (ha : Rel) (a : SM.Linear S.Rk S.PQ.carrier) (h : S.Star a) {
   module C = FR.CJ[a].C ;
   module PQ = LP.Pc[q] ;
   -- e(y ∧ a1) = ∧eP(y) ∧ a1'
   wedge-eq (y : S.PP.carrier.M) : Id S'.Rk.M (eR.1.1 (S.wedge-with y)) (S'.wedge-with (PQ.PF.map.1 y)) =
    S'.HK.eq _ _ (\ k' -> S'.PS.SB.eq _ _ (calc LP.WF.LN.alg.A {
     LP.WF.wedge.1 (S.LP.alg.mul y.1 (a1.1 (HI.IK.inv k')).1)
      =< LP.WF.wedge.2.2.2.1 y.1 (a1.1 (HI.IK.inv k')).1
      > S'.LP.alg.mul (LP.WF.wedge.1 y.1) (LP.WF.wedge.1 (a1.1 (HI.IK.inv k')).1)
      =< ap (\ u -> S'.LP.alg.mul (LP.WF.wedge.1 y.1) u.1) (sym (ha (HI.IK.inv k')))
      > S'.LP.alg.mul (LP.WF.wedge.1 y.1) (a1'.1 (eK.1.1 (HI.IK.inv k'))).1
      =< ap (\ t -> S'.LP.alg.mul (LP.WF.wedge.1 y.1) (a1'.1 t).1) (HI.IK.inv-eq k')
      > S'.LP.alg.mul (LP.WF.wedge.1 y.1) (a1'.1 k').1 })) ;
   star : S'.Star C.a' = \ x' -> calc S'.PQ.carrier.M {
    S'.W.map.1 x' =< ap S'.W.map.1 (sym (PQ.forth-p x')) > S'.W.map.1 (PQ.PF.map.1 (PQ.PB.map.1 x'))
     =< S'.PQ.SB.eq _ _ (square (PQ.PB.map.1 x').1) > LQ.Pc[q].PF.map.1 (S.W.map.1 (PQ.PB.map.1 x'))
     =< ap LQ.Pc[q].PF.map.1 (h (PQ.PB.map.1 x')) > LQ.Pc[q].PF.map.1 (a.1 (S.wedge-with (PQ.PB.map.1 x')))
     =< sym (C.relation (S.wedge-with (PQ.PB.map.1 x'))) > C.a'.1 (eR.1.1 (S.wedge-with (PQ.PB.map.1 x')))
     =< ap C.a'.1 (wedge-eq (PQ.PB.map.1 x')) > C.a'.1 (S'.wedge-with (PQ.PF.map.1 (PQ.PB.map.1 x')))
     =< ap (\ t -> C.a'.1 (S'.wedge-with t)) (PQ.forth-p x') > C.a'.1 (S'.wedge-with x') } ;
  } ;
  -- regularity passes
  regular (ha : Rel) (ra : S.Regular) : S'.Regular = \ r hk -> ra r (\ k -> calc S.PB.carrier.M {
   S.PB.carrier.sm r (a1.1 k) =< sym (LP.Pc[p].back-p (S.PB.carrier.sm r (a1.1 k)))
    > LP.Pc[p].PB.map.1 (LP.Pc[p].PF.map.1 (S.PB.carrier.sm r (a1.1 k)))
    =< ap LP.Pc[p].PB.map.1 (LP.Pc[p].PF.map.2.2 r (a1.1 k)) > LP.Pc[p].PB.map.1 (S'.PB.carrier.sm r (LP.Pc[p].PF.map.1 (a1.1 k)))
    =< ap (\ u -> LP.Pc[p].PB.map.1 (S'.PB.carrier.sm r u)) (sym (ha k)) > LP.Pc[p].PB.map.1 (S'.PB.carrier.sm r (a1'.1 (eK.1.1 k)))
    =< ap LP.Pc[p].PB.map.1 (hk (eK.1.1 k)) > LP.Pc[p].PB.map.1 S'.PB.carrier.mz
    =< SM.Lin[S'.PB.carrier,S.PB.carrier,LP.Pc[p].PB.map].map-z > S.PB.carrier.mz }) ;
 } ;

 module Chain (s : Nat -> Nat) {
  module CH = C85.Chain[s] ;
  module Res (T : Nat) (d : Nat -> Nat) (G G' : Nat -> FM.Module)
   (f : (t : Nat) -> SM.Linear (G t) (G (suc t))) (f' : (t : Nat) -> SM.Linear (G' t) (G' (suc t)))
   (bs : Tr.Trunc[(t : Nat) -> MS.LinEquiv (G t) (FM.Free (d t))].carrier)
   (bs' : Tr.Trunc[(t : Nat) -> MS.LinEquiv (G' t) (FM.Free (d t))].carrier)
   (hd : (t : Nat) -> C85.lt t (suc T) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)))
   (cz : (t : Nat) -> C85.lt t (suc T) -> FM.ComposeZeroL (G t) (G (suc t)) (G (suc (suc t))) (f t) (f (suc t)))
   (cz' : (t : Nat) -> C85.lt t (suc T) -> FM.ComposeZeroL (G' t) (G' (suc t)) (G' (suc (suc t))) (f' t) (f' (suc t)))
   (phi : (t : Nat) -> MS.LinEquiv (G t) (G' t))
   (comm : (t : Nat) (x : (G t).M) -> Id (G' (suc t)).M ((phi (suc t)).1.1 ((f t).1 x)) ((f' t).1 ((phi t).1.1 x))) {
   module A = SC.Chain[s].Res[T,d,G,f,bs,hd,cz] ;
   module B = SC.Chain[s].Res[T,d,G',f',bs',hd,cz'] ;
   module LI (t : Nat) { module LM = LamIso[G t,G' t,A.bb t,B.bb t,phi t] ; } ;
   -- the lines correspond
   eL : (t : Nat) -> MS.LinEquiv (A.Lns t) (B.Lns t) = split {
    zero -> SC.id-line ;
    suc t | r -> Frame[G (suc t),G (suc (suc t)),G' (suc t),G' (suc (suc t)),A.bb (suc t),A.bb (suc (suc t)),B.bb (suc t),B.bb (suc (suc t)),
     phi (suc t),phi (suc (suc t)),CH.rk (suc t),CH.rk t,A.Lns t,B.Lns t,r].eR } ;
   module Fr (t : Nat) {
    module X = Frame[G (suc t),G (suc (suc t)),G' (suc t),G' (suc (suc t)),A.bb (suc t),A.bb (suc (suc t)),B.bb (suc t),B.bb (suc (suc t)),
     phi (suc t),phi (suc (suc t)),CH.rk (suc t),CH.rk t,A.Lns t,B.Lns t,eL t] ;
   } ;
   -- ∧φ (1) = 1
   unit-rel (k : R) : Id (B.TargetP[zero].P.carrier).M (B.U0.map.1 k) (LI[suc zero].LM.Pc[zero].PF.map.1 (A.U0.map.1 k)) =
    B.U0.P0.SB.eq _ _ (sym (trans (LI[suc zero].LM.WF.wedge.2.2.1 k A.U0.LM.alg.one)
     (ap (B.U0.LM.alg.scale k) LI[suc zero].LM.WF.wedge.2.2.2.2))) ;
   -- the conjugate of a structure of F
   module Tp (u : A.Structure) {
    module TS (t : Nat) (h : C85.lt t (suc T)) (a1' : SM.Linear (B.Lns t) (B.TargetP[t].P.carrier)) {
     module X = Transfer[G (suc t),G (suc (suc t)),G' (suc t),G' (suc (suc t)),A.bb (suc t),A.bb (suc (suc t)),B.bb (suc t),B.bb (suc (suc t)),
      f (suc t),f' (suc t),phi (suc t),phi (suc (suc t)),comm (suc t),CH.rk (suc t),CH.rk t,A.Lns t,B.Lns t,eL t,A.prev u.1.1 t h,a1'] ;
    } ;
    module CM (t : Nat) (a : SM.Linear (SS.RkOf (G (suc t)) (A.bb (suc t)) (CH.rk (suc t)) (CH.rk t) (A.Lns t)) (A.TargetP[suc t].P.carrier)) { module C = Fr[t].X.CJ[a].C ; } ;
    mids : B.Mid = \ t h -> CM[t,u.1.1 t h].C.a' ;
    last : B.LastMap = CM[T,u.1.2].C.a' ;
    prev-rel : (t : Nat) (h : C85.lt t (suc T)) -> (k : (A.Lns t).M) ->
     Id (B.TargetP[t].P.carrier).M ((B.prev mids t h).1 ((eL t).1.1 k)) (LI[suc t].LM.Pc[CH.rk t].PF.map.1 ((A.prev u.1.1 t h).1 k)) = split {
     zero -> \ h k -> unit-rel k ;
     suc t -> \ h k -> CM[t,u.1.1 t h].C.relation k } ;
    mid-star (t : Nat) (h : C85.lt t T) : B.St[mids,t,C85.lt-pred t (suc T) h].S.Star (mids t h) =
     TS[t,C85.lt-pred t (suc T) h,B.prev mids t (C85.lt-pred t (suc T) h)].X.ST[prev-rel t (C85.lt-pred t (suc T) h),u.1.1 t h,u.2.1 t h].star ;
    last-star : B.St[mids,T,C85.lt-self T].S.Star last =
     TS[T,C85.lt-self T,B.prev mids T (C85.lt-self T)].X.ST[prev-rel T (C85.lt-self T),u.1.2,u.2.2.1].star ;
    regular (t : Nat) (h : C85.lt t (suc T)) : B.St[mids,t,h].S.Regular =
     TS[t,h,B.prev mids t h].X.regular (prev-rel t h) (u.2.2.2 t h) ;
    structure : B.Structure = ((mids,last),(mid-star,(last-star,regular))) ;
   } ;
   -- T4: the unique structures correspond; a'_Det ∘ e = ∧φ ∘ a_Det
   module Natural (gm : A.GradeHyp) (rg : A.RegHyp) (gm' : B.GradeHyp) (rg' : B.RegHyp) {
    canonical : A.Structure = (A.contractible gm rg).1 ;
    canonical' : B.Structure = (B.contractible gm' rg').1 ;
    module TC = Tp[canonical] ;
    same : Id B.Structure TC.structure canonical' = B.structure-prop TC.structure canonical' ;
    e : MS.LinEquiv (SS.RkOf (G (suc T)) (A.bb (suc T)) (CH.rk (suc T)) (CH.rk T) (A.Lns T)) (SS.RkOf (G' (suc T)) (B.bb (suc T)) (CH.rk (suc T)) (CH.rk T) (B.Lns T)) = eL (suc T) ;
    natural (psi : (SS.RkOf (G (suc T)) (A.bb (suc T)) (CH.rk (suc T)) (CH.rk T) (A.Lns T)).M) :
     Id (B.TargetP[suc T].P.carrier).M (canonical'.1.2.1 (e.1.1 psi)) (LI[suc (suc T)].LM.Pc[CH.rk (suc T)].PF.map.1 (canonical.1.2.1 psi)) =
     trans (ap (\ v -> v.1.2.1 (e.1.1 psi)) (sym same)) (TC.CM[T,canonical.1.2].C.relation psi) ;
   } ;
  } ;
 } ;
} ;
