-- Naturality of Det(F) and a_1 for isomorphisms of resolutions (cffru).
-- The data of a resolution of (a_j) of length m: Data m = (P : Mod) *
-- (G : Nat -> Mod) * merely bases * ResOf m N a P G (so FFRes N a =
-- (m : Nat) * Data m).  An isomorphism (Iso) of d, d' : Data m: linear
-- equivalences φ_P : P ~ P', φ_i : G i ~ G' i with u' φ_P = φ_0 u,
-- T'_i φ_i = φ_(i+1) T_i and iota' φ_(m+1) = iota.
-- Theorem (iso-path): an isomorphism gives d = d'.  Proof by induction on
-- isomorphisms: (P' : Mod) * (P ~ P') is contractible (ModuleSIP2.pth, from the generic SIP of sag/sip),
-- and so is (G' : Nat -> Mod) * ((i : Nat) -> G i ~ G' i) (pthF: it is the
-- product over i of the contractible (G'_i : Mod) * (G i ~ G'_i), by
-- function extensionality).  So it suffices to take P' = P, G' = G and the
-- identities; then u' = u, T' = T, iota' = iota pointwise, hence as linear
-- maps, and the rest of ResOf (injectivity, exactness, the image) and the
-- bases are propositions (ResEq).
-- Corollary (DetNatural): every construction on Data m is natural.  For a
-- nonzero ideal, Det(F) and a_1 (DetGcd) give: an isomorphism d ~ d' yields
-- e : Det(d) ~ Det(d') with a_1' ∘ e = a_1 (at d' = d: e = id), so e maps
-- the bases of Det(d) to those of Det(d') and the regular gcds a_1(φ) agree.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @l+] ;
module TG = TrueGrade[l] ;
module Over (D : TG.RD) {
 module DG = DetGcd[l].Over[D] ;
 module DF = DG.DF ;
 module FR = DF.FR ; module FM = DF.FM ; module SM = DF.SM ; module MS = DF.MS ; module HO = DF.HO ;
 module LN = Lines[l].Over[D.1,D.2] ;
 R : U l = D.1.R ;
 Mod : U l+ = FM.Module ;

 -- iso-induction for a family of modules
 TotalF (G : Nat -> Mod) : U l+ = (G' : Nat -> Mod) * ((i : Nat) -> MS.LinEquiv (G i) (G' i)) ;
 idF (G : Nat -> Mod) : TotalF G = (G,\ i -> MS.idLin (G i)) ;
 forth (G : Nat -> Mod) (c : TotalF G) : (i : Nat) -> MS.Total (G i) = \ i -> (c.1 i,c.2 i) ;
 back (G : Nat -> Mod) (w : (i : Nat) -> MS.Total (G i)) : TotalF G = (\ i -> (w i).1,\ i -> (w i).2) ;
 pthF (G : Nat -> Mod) (c : TotalF G) : Id (TotalF G) (idF G) c =
  Hi.ap ((i : Nat) -> MS.Total (G i)) (TotalF G) (back G) (forth G (idF G)) (forth G c)
   (FL1.funext Nat (\ i -> MS.Total (G i)) (forth G (idF G)) (forth G c) (\ i -> MS.pth (G i) (c.1 i,c.2 i))) ;

 module At (N : Nat) (a : Ps.Fin N -> R) (m : Nat) {
  Data : U l+ = (P : Mod) * (G : Nat -> Mod) * Tr.Trunc[FR.Bases P G].carrier * FR.ResOf m N a P G ;
  -- a resolution is determined by its maps
  module ResEq (P : Mod) (G : Nat -> Mod) (h : FR.ResOf m N a P G) {
   module H = FR.RO[m,N,a,P,G,h] ;
   U0 : U l = FR.Lin P (G zero) ;
   Ts : U l = (i : Nat) -> FR.Lin (G i) (G (suc i)) ;
   Io : U l = MS.LinEquiv (G (suc m)) FM.regular ;
   Rest (u : U0) (T : Ts) (iota : Io) : U l =
    (FM.InjectiveL P (G zero) u * FR.Pairs (suc m) P G u T) * FR.ImageL N a (G m) (G (suc m)) (T m) iota ;
   mk (u : U0) (T : Ts) (iota : Io) (r : Rest u T iota) : FR.ResOf m N a P G = (u,(T,(r.1,(iota,r.2)))) ;
   -- the rest is a proposition
   zero-prop (A B C : Mod) (f : FR.Lin A B) (g : FR.Lin B C) : Pr.isProp (FM.ComposeZeroL A B C f g) =
    F.isProp-Pi A.M (\ x -> Id C.M (g.1 (f.1 x)) C.mz) (\ x -> C.setM (g.1 (f.1 x)) C.mz) ;
   exact-prop (A B C : Mod) (f : FR.Lin A B) (g : FR.Lin B C) : Pr.isProp (FM.ExactL A B C f g) =
    F.isProp-Pi B.M (\ y -> Id C.M (g.1 y) C.mz -> Tr.Trunc[(x : A.M) * Id B.M (f.1 x) y].carrier) (\ y ->
     F.isProp-Pi (Id C.M (g.1 y) C.mz) (\ hy -> Tr.Trunc[(x : A.M) * Id B.M (f.1 x) y].carrier) (\ hy ->
      Tr.Trunc[(x : A.M) * Id B.M (f.1 x) y].proposition)) ;
   ze-prop (A B C : Mod) (f : FR.Lin A B) (g : FR.Lin B C) : Pr.isProp (FM.ComposeZeroL A B C f g * FM.ExactL A B C f g) =
    HO.prod-prop (FM.ComposeZeroL A B C f g) (FM.ExactL A B C f g) (zero-prop A B C f g) (exact-prop A B C f g) ;
   pairs-prop (u : U0) (T : Ts) : Pr.isProp (FR.Pairs (suc m) P G u T) =
    HO.prod-prop
     ((d : Nat) -> Id Nat (suc m) (suc d) ->
      FM.ComposeZeroL P (G zero) (G (suc zero)) u (T zero) * FM.ExactL P (G zero) (G (suc zero)) u (T zero))
     ((i d : Nat) -> Id Nat (suc m) (plus (suc (suc i)) d) ->
      FM.ComposeZeroL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i)) * FM.ExactL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i)))
     (F.isProp-Pi Nat (\ d -> Id Nat (suc m) (suc d) ->
       FM.ComposeZeroL P (G zero) (G (suc zero)) u (T zero) * FM.ExactL P (G zero) (G (suc zero)) u (T zero)) (\ d ->
      F.isProp-Pi (Id Nat (suc m) (suc d)) (\ e ->
       FM.ComposeZeroL P (G zero) (G (suc zero)) u (T zero) * FM.ExactL P (G zero) (G (suc zero)) u (T zero)) (\ e ->
       ze-prop P (G zero) (G (suc zero)) u (T zero))))
     (F.isProp-Pi Nat (\ i -> (d : Nat) -> Id Nat (suc m) (plus (suc (suc i)) d) ->
       FM.ComposeZeroL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i)) * FM.ExactL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i))) (\ i ->
      F.isProp-Pi Nat (\ d -> Id Nat (suc m) (plus (suc (suc i)) d) ->
       FM.ComposeZeroL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i)) * FM.ExactL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i))) (\ d ->
       F.isProp-Pi (Id Nat (suc m) (plus (suc (suc i)) d)) (\ e ->
        FM.ComposeZeroL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i)) * FM.ExactL (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i))) (\ e ->
        ze-prop (G i) (G (suc i)) (G (suc (suc i))) (T i) (T (suc i)))))) ;
   image-prop (T : Ts) (iota : Io) : Pr.isProp (FR.ImageL N a (G m) (G (suc m)) (T m) iota) =
    HO.prod-prop ((y : (G m).M) -> FR.In N a (iota.1.1 ((T m).1 y)))
     ((j : Ps.Fin N) -> Tr.Trunc[(y : (G m).M) * Id R (iota.1.1 ((T m).1 y)) (a j)].carrier)
     (F.isProp-Pi (G m).M (\ y -> FR.In N a (iota.1.1 ((T m).1 y))) (\ y ->
      Tr.Trunc[RegularIdeal[l].Generated[D.1,N,a].S.Coordinates N a (iota.1.1 ((T m).1 y))].proposition))
     (F.isProp-Pi (Ps.Fin N) (\ j -> Tr.Trunc[(y : (G m).M) * Id R (iota.1.1 ((T m).1 y)) (a j)].carrier) (\ j ->
      Tr.Trunc[(y : (G m).M) * Id R (iota.1.1 ((T m).1 y)) (a j)].proposition)) ;
   rest-prop (u : U0) (T : Ts) (iota : Io) : Pr.isProp (Rest u T iota) =
    HO.prod-prop (FM.InjectiveL P (G zero) u * FR.Pairs (suc m) P G u T) (FR.ImageL N a (G m) (G (suc m)) (T m) iota)
     (HO.prod-prop (FM.InjectiveL P (G zero) u) (FR.Pairs (suc m) P G u T)
      (F.isProp-Pi P.M (\ x -> Id (G zero).M (u.1 x) (G zero).mz -> Id P.M x P.mz) (\ x ->
       F.isProp-Pi (Id (G zero).M (u.1 x) (G zero).mz) (\ hx -> Id P.M x P.mz) (\ hx -> P.setM x P.mz)))
      (pairs-prop u T))
     (image-prop T iota) ;
   -- equal maps give equal resolutions
   at-iota (iota' : Io) (pi : Id Io H.iota iota') : (r : Rest H.u H.T iota') -> Id (FR.ResOf m N a P G) h (mk H.u H.T iota' r) =
    idJ Io H.iota (\ z q -> (r : Rest H.u H.T z) -> Id (FR.ResOf m N a P G) h (mk H.u H.T z r))
     (\ r -> ap (mk H.u H.T H.iota) (rest-prop H.u H.T H.iota (h.2.2.1,h.2.2.2.2) r)) iota' pi ;
   at-T (T' : Ts) (pT : Id Ts H.T T') : (iota' : Io) -> Id Io H.iota iota' -> (r : Rest H.u T' iota') ->
    Id (FR.ResOf m N a P G) h (mk H.u T' iota' r) =
    idJ Ts H.T (\ z q -> (iota' : Io) -> Id Io H.iota iota' -> (r : Rest H.u z iota') -> Id (FR.ResOf m N a P G) h (mk H.u z iota' r))
     at-iota T' pT ;
   at-u (u' : U0) (pu : Id U0 H.u u') : (T' : Ts) -> Id Ts H.T T' -> (iota' : Io) -> Id Io H.iota iota' -> (r : Rest u' T' iota') ->
    Id (FR.ResOf m N a P G) h (mk u' T' iota' r) =
    idJ U0 H.u (\ z q -> (T' : Ts) -> Id Ts H.T T' -> (iota' : Io) -> Id Io H.iota iota' -> (r : Rest z T' iota') ->
      Id (FR.ResOf m N a P G) h (mk z T' iota' r))
     at-T u' pu ;
   -- linear equivalences with the same values are equal
   io-eq (e e' : Io) (hh : (x : (G (suc m)).M) -> Id R (e.1.1 x) (e'.1.1 x)) : Id Io e e' =
    Pr.Sigma-eq (Pr.Equiv (G (suc m)).M R) (\ w -> MS.Lin (G (suc m)) FM.regular w.1) e.1 e'.1 e.2 e'.2
     (Pr.Sigma-eq ((G (suc m)).M -> R) (\ f -> Pr.isEquiv (G (suc m)).M R f) e.1.1 e'.1.1 e.1.2 e'.1.2
       (F.funext (G (suc m)).M (\ x -> R) e.1.1 e'.1.1 hh) (EquivProp[l].isEquiv-prop (G (suc m)).M R e'.1.1))
     (MS.lin-prop (G (suc m)) FM.regular e'.1.1) ;
   -- h' with the same maps (pointwise) is h
   result (h' : FR.ResOf m N a P G)
    (eu : (x : P.M) -> Id (G zero).M (h.1.1 x) (h'.1.1 x))
    (eT : (i : Nat) (x : (G i).M) -> Id (G (suc i)).M ((h.2.1 i).1 x) ((h'.2.1 i).1 x))
    (ei : (x : (G (suc m)).M) -> Id R (h.2.2.2.1.1.1 x) (h'.2.2.2.1.1.1 x)) : Id (FR.ResOf m N a P G) h h' =
    at-u h'.1 (LN.lin-eq P (G zero) h.1 h'.1 eu)
     h'.2.1 (F.funext Nat (\ i -> FR.Lin (G i) (G (suc i))) h.2.1 h'.2.1 (\ i -> LN.lin-eq (G i) (G (suc i)) (h.2.1 i) (h'.2.1 i) (eT i)))
     h'.2.2.2.1 (io-eq h.2.2.2.1 h'.2.2.2.1 ei)
     (h'.2.2.1,h'.2.2.2.2) ;
  } ;

  -- isomorphisms of resolutions
  Compat (P : Mod) (G : Nat -> Mod) (h : FR.ResOf m N a P G) (P' : Mod) (G' : Nat -> Mod) (h' : FR.ResOf m N a P' G')
   (phiP : MS.LinEquiv P P') (phi : (i : Nat) -> MS.LinEquiv (G i) (G' i)) : U l =
   ((x : P.M) -> Id (G' zero).M ((phi zero).1.1 (h.1.1 x)) (h'.1.1 (phiP.1.1 x))) *
   (((i : Nat) (x : (G i).M) -> Id (G' (suc i)).M ((phi (suc i)).1.1 ((h.2.1 i).1 x)) ((h'.2.1 i).1 ((phi i).1.1 x))) *
    ((x : (G (suc m)).M) -> Id R (h.2.2.2.1.1.1 x) (h'.2.2.2.1.1.1 ((phi (suc m)).1.1 x)))) ;
  module IsoPath (P : Mod) (G : Nat -> Mod) (B : Tr.Trunc[FR.Bases P G].carrier) (h : FR.ResOf m N a P G) {
   Q (c : MS.Total P) (cf : TotalF G) : U l+ = (B' : Tr.Trunc[FR.Bases c.1 cf.1].carrier) (h' : FR.ResOf m N a c.1 cf.1) ->
    Compat P G h c.1 cf.1 h' c.2 cf.2 -> Id Data (P,(G,(B,h))) (c.1,(cf.1,(B',h'))) ;
   base : Q (P,MS.idLin P) (idF G) = \ B' h' cp ->
    Hi.ap (Tr.Trunc[FR.Bases P G].carrier * FR.ResOf m N a P G) Data (\ w -> (P,(G,w))) (B,h) (B',h')
     (ExteriorAlgebra[l].pair-eq (Tr.Trunc[FR.Bases P G].proposition B B') (ResEq[P,G,h].result h' cp.1 cp.2.1 cp.2.2)) ;
   result (c : MS.Total P) (cf : TotalF G) : Q c cf =
    Hi.subst (TotalF G) (\ k -> Q c k) (idF G) cf (pthF G cf)
     (Hi.subst (MS.Total P) (\ k -> Q k (idF G)) (P,MS.idLin P) c (MS.pth P c) base) ;
  } ;
  iso-path (d d' : Data) (phiP : MS.LinEquiv d.1 d'.1) (phi : (i : Nat) -> MS.LinEquiv (d.2.1 i) (d'.2.1 i))
   (cp : Compat d.1 d.2.1 d.2.2.2 d'.1 d'.2.1 d'.2.2.2 phiP phi) : Id Data d d' =
   IsoPath[d.1,d.2.1,d.2.2.1,d.2.2.2].result (d'.1,phiP) (d'.2.1,phi) d'.2.2.1 d'.2.2.2 cp ;

  -- naturality of Det(F) and a_1, for a nonzero ideal
  module DetNatural (nt : Id R D.1.o D.1.z -> Empty) (nz : ((j : Ps.Fin N) -> Id R (a j) D.1.z) -> Empty) {
   module A (d : Data) { module O = DG.OfRes[N,a,(m,d),nt,nz].A ; } ;
   NatDet (d d' : Data) : U l = (e : MS.LinEquiv A[d].O.CA.Det A[d'].O.CA.Det) *
    ((phi : A[d].O.CA.Det.M) -> Id R (A[d'].O.a1.1 (e.1.1 phi)) (A[d].O.a1.1 phi)) ;
   nat-refl (d : Data) : NatDet d d = (MS.idLin A[d].O.CA.Det,\ phi -> refl (A[d].O.a1.1 phi)) ;
   natural (d d' : Data) (p : Id Data d d') : NatDet d d' = Hi.subst Data (\ d'' -> NatDet d d'') d d' p (nat-refl d) ;
   -- an isomorphism of resolutions gives e : Det(F) ~ Det(F') with a_1' ∘ e = a_1
   natural-iso (d d' : Data) (phiP : MS.LinEquiv d.1 d'.1) (phi : (i : Nat) -> MS.LinEquiv (d.2.1 i) (d'.2.1 i))
    (cp : Compat d.1 d.2.1 d.2.2.2 d'.1 d'.2.1 d'.2.2.2 phiP phi) : NatDet d d' = natural d d' (iso-path d d' phiP phi cp) ;
  } ;
 } ;
} ;
