-- Degrees in the exterior algebra of a finite free module (cffru, step 2, E4).
-- A basis e : M ~ R^n gives the algebra map to_e : Lam M -> Lam n (the
-- model, exterior/), the extension of v |-> gen (e v) (Coord).  x has degree
-- k when to_e x has degree k (ExteriorDegree.Deg) for every basis e (Deg):
-- a proposition, defined without choosing a basis.
-- Preservation (Square, Preserve): for f : M -> N linear, wedge f maps degree k to
-- degree k.  Given bases eM of M and eN of N, to_eN . wedge f = Lambda(A) .
-- to_eM (square, by uniqueness on generators), where A is the matrix of
-- eN . f . eM^-1 (FreeModules.mat) and Lambda(A) = Minors.Map; Lambda(A)
-- sends the basis vector e_K to the product of |K| columns (column-image),
-- of degree |K|, so it preserves degrees (ExteriorHomogeneous.map-degree).
-- Since eM merely exists and the goal is a proposition, this holds for
-- every eN.  With f the identity: the degree does not depend on the basis.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module C = ExteriorCoordinates[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 open ExteriorModel[l].Over[Rg] ;
 module EF = ExteriorFree[l].Over[Rg,setR] ;
 module FM = EF.FM ; module FF = EF.FF ; module SM = FM.SM ; module MS = FM.MS ;
 module AL = EF.AL ; module EC = EF.EC ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module MT = MinorTranspose[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module HO = ExteriorHomogeneous[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module CB = ColumnBlocks[l].Over[Rg,setR] ;
 module RP = ExteriorReplacement[l].Over[Rg,setR] ;
 -- an alternating map after a linear map
 alt-lin (M N : FM.Module) (A : EF.S.Alg) (j : EF.AltM N A) (f : SM.Linear M N) : EF.AltM M A =
  (\ v -> j.1 (f.1 v),
   ((\ x y -> trans (ap j.1 (f.2.1 x y)) (j.2.1.1 (f.1 x) (f.1 y)),
     \ c x -> trans (ap j.1 (f.2.2 c x)) (j.2.1.2 c (f.1 x))),
    \ x -> j.2.2 (f.1 x))) ;
 -- the inverse of a linear equivalence is linear
 module Inv (M N : FM.Module) (e : MS.LinEquiv M N) {
  fun : M.M -> N.M = e.1.1 ;
  inv : N.M -> M.M = e.1.2.sec ;
  inv-eq (y : N.M) : Id N.M (fun (inv y)) y = e.1.2.sec-eq y ;
  ret-eq (x : M.M) : Id M.M (inv (fun x)) x = Pr.sec-ret M.M N.M e.1.1 e.1.2 x ;
  fun-add (x y : M.M) : Id N.M (fun (M.madd x y)) (N.madd (fun x) (fun y)) = e.2.1 x y ;
  fun-scale (c : R) (x : M.M) : Id N.M (fun (M.sm c x)) (N.sm c (fun x)) = e.2.2 c x ;
  inv-add (x y : N.M) : Id M.M (inv (N.madd x y)) (M.madd (inv x) (inv y)) = calc M.M {
   inv (N.madd x y) =< ap inv (Ps.cong2 N.M N.madd _ _ _ _ (sym (inv-eq x)) (sym (inv-eq y))) > inv (N.madd (fun (inv x)) (fun (inv y)))
    =< ap inv (sym (fun-add (inv x) (inv y))) > inv (fun (M.madd (inv x) (inv y)))
    =< ret-eq (M.madd (inv x) (inv y)) > M.madd (inv x) (inv y) } ;
  inv-scale (c : R) (x : N.M) : Id M.M (inv (N.sm c x)) (M.sm c (inv x)) = calc M.M {
   inv (N.sm c x) =< ap (\ t -> inv (N.sm c t)) (sym (inv-eq x)) > inv (N.sm c (fun (inv x)))
    =< ap inv (sym (fun-scale c (inv x))) > inv (fun (M.sm c (inv x)))
    =< ret-eq (M.sm c (inv x)) > M.sm c (inv x) } ;
  linear : SM.Linear N M = (inv,inv-add,inv-scale) ;
 } ;
 inv-lin (M N : FM.Module) (e : MS.LinEquiv M N) : SM.Linear N M = Inv[M,N,e].linear ;
 -- the coordinates given by a basis
 module Coord (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) (n : Nat) (e : MS.LinEquiv M (FM.Free n)) {
  module LM = EF.Lam[M,b] ;
  to : AL.AlgHom LM.alg (EC.Lam n) = LM.ext (EC.Lam n) (alt-lin M (FM.Free n) (EC.Lam n) (EC.i n) (FM.lin M (FM.Free n) e)) ;
  to-gen (v : M.M) : Id (Ext n) (to.1 (LM.gen.1 v)) (gen n (e.1.1 v)) =
   LM.ext-gen (EC.Lam n) (alt-lin M (FM.Free n) (EC.Lam n) (EC.i n) (FM.lin M (FM.Free n) e)) v ;
 } ;
 -- degree k, for every basis
 Deg (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) (k : Nat) (x : EF.Lam[M,b].alg.A) : U l =
  (n : Nat) (e : MS.LinEquiv M (FM.Free n)) -> DG.Deg n k (Coord[M,b,n,e].to.1 x) ;
 deg-prop (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) (k : Nat) (x : EF.Lam[M,b].alg.A) : Pr.isProp (Deg M b k x) =
  F.isProp-Pi Nat (\ n -> (e : MS.LinEquiv M (FM.Free n)) -> DG.Deg n k (Coord[M,b,n,e].to.1 x)) (\ n ->
   F.isProp-Pi (MS.LinEquiv M (FM.Free n)) (\ e -> DG.Deg n k (Coord[M,b,n,e].to.1 x)) (\ e ->
    HO.deg-prop n k (Coord[M,b,n,e].to.1 x))) ;
 -- Lambda of a matrix preserves degrees
 phi-degree (p q k : Nat) (u : MM.Mat p q) (x : Ext p) (dx : DG.Deg p k x) : DG.Deg q k (MI.Map[p,q,u].value x) =
  HO.map-degree p q k k MI.Map[p,q,u].value MT.Laws[p,q,u].linear
   (\ K eK -> subst (\ c -> DG.Deg q c (MI.Map[p,q,u].value (CO.basis p K))) eK
     (subst (DG.Deg q (BA.count p K)) (sym (MT.Laws[p,q,u].column-image K))
      (DG.deg-eprod q (BA.count p K) (\ t -> gen q (RP.Columns[AL.Vec q].selected p K u t))
       (\ t -> DG.deg-gen q (RP.Columns[AL.Vec q].selected p K u t))))) x dx ;
 -- to_eN . wedge f = Lambda(A) . to_eM, A the matrix of eN . f . eM^-1
 module Square (M N : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) (bN : Tr.Trunc[FF.Based N].carrier)
  (f : SM.Linear M N) (m : Nat) (eN : MS.LinEquiv N (FM.Free m)) (n : Nat) (eM : MS.LinEquiv M (FM.Free n)) {
  module W = EF.Wedge[M,N,bM,bN,f] ;
  module CM = Coord[M,bM,n,eM] ; module CN = Coord[N,bN,m,eN] ;
  g : SM.Linear (FM.Free n) (FM.Free m) =
   (\ y -> eN.1.1 (f.1 ((inv-lin M (FM.Free n) eM).1 y)),
    \ x1 y1 -> trans (ap (\ t -> eN.1.1 (f.1 t)) ((inv-lin M (FM.Free n) eM).2.1 x1 y1))
     (trans (ap eN.1.1 (f.2.1 ((inv-lin M (FM.Free n) eM).1 x1) ((inv-lin M (FM.Free n) eM).1 y1)))
      (eN.2.1 (f.1 ((inv-lin M (FM.Free n) eM).1 x1)) (f.1 ((inv-lin M (FM.Free n) eM).1 y1)))),
    \ c y -> trans (ap (\ t -> eN.1.1 (f.1 t)) ((inv-lin M (FM.Free n) eM).2.2 c y))
     (trans (ap eN.1.1 (f.2.2 c ((inv-lin M (FM.Free n) eM).1 y))) (eN.2.2 c (f.1 ((inv-lin M (FM.Free n) eM).1 y))))) ;
  A : MM.Mat n m = FM.mat n m g ;
  module LA = MI.Map[n,m,A] ;
  on-gen (v : M.M) : Id (MM.Vec m) (MM.apply n m A (eM.1.1 v)) (eN.1.1 (f.1 v)) =
   F.funext (Ps.Fin m) (\ j -> R) (MM.apply n m A (eM.1.1 v)) (eN.1.1 (f.1 v))
    (\ j -> trans (sym (FM.apply-mat n m g (eM.1.1 v) j))
     (ap (\ t -> eN.1.1 (f.1 t) j) (Pr.sec-ret M.M (MM.Vec n) eM.1.1 eM.1.2 v))) ;
  square : Id (AL.AlgHom W.LM.alg (EC.Lam m))
   (AL.comp W.LM.alg W.LN.alg (EC.Lam m) CN.to W.wedge) (AL.comp W.LM.alg (EC.Lam n) (EC.Lam m) LA.phi CM.to) =
   W.LM.hom-eq (EC.Lam m) (AL.comp W.LM.alg W.LN.alg (EC.Lam m) CN.to W.wedge) (AL.comp W.LM.alg (EC.Lam n) (EC.Lam m) LA.phi CM.to)
    (\ v -> calc (Ext m) {
     CN.to.1 (W.wedge.1 (W.LM.gen.1 v)) =< ap CN.to.1 (W.wedge-gen v) > CN.to.1 (W.LN.gen.1 (f.1 v))
      =< CN.to-gen (f.1 v) > gen m (eN.1.1 (f.1 v))
      =< ap (gen m) (sym (on-gen v)) > gen m (MM.apply n m A (eM.1.1 v))
      =< sym (LA.phi-gen (eM.1.1 v)) > LA.phi.1 (gen n (eM.1.1 v))
      =< ap LA.phi.1 (sym (CM.to-gen v)) > LA.phi.1 (CM.to.1 (W.LM.gen.1 v)) }) ;
  value (x : W.LM.alg.A) : Id (Ext m) (CN.to.1 (W.wedge.1 x)) (LA.value (CM.to.1 x)) = ap (\ h -> h.1 x) square ;
 } ;
 -- wedge f preserves degrees
 module Preserve (M N : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) (bN : Tr.Trunc[FF.Based N].carrier)
  (f : SM.Linear M N) (k : Nat) (x : EF.Lam[M,bM].alg.A) (dx : Deg M bM k x) {
  module W = EF.Wedge[M,N,bM,bN,f] ;
  at (m : Nat) (eN : MS.LinEquiv N (FM.Free m)) (n : Nat) (eM : MS.LinEquiv M (FM.Free n)) : DG.Deg m k (Coord[N,bN,m,eN].to.1 (W.wedge.1 x)) =
   subst (DG.Deg m k) (sym (Square[M,N,bM,bN,f,m,eN,n,eM].value x))
    (phi-degree n m k Square[M,N,bM,bN,f,m,eN,n,eM].A (Coord[M,bM,n,eM].to.1 x) (dx n eM)) ;
  result : Deg N bN k (W.wedge.1 x) = \ m eN ->
   Tr.Trunc[FF.Based M].induction @l (\ w -> DG.Deg m k (Coord[N,bN,m,eN].to.1 (W.wedge.1 x)))
    (\ w -> HO.deg-prop m k (Coord[N,bN,m,eN].to.1 (W.wedge.1 x)))
    (\ w -> at m eN w.1 w.2) bM ;
 } ;
} ;
