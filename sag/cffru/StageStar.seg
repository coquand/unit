-- One stage of the structure theorem without bases (cffru, step 2, T1).
-- Buchsbaum-Eisenbud (BE1, Thm 3.1 and the remark after it), one stage:
-- f : P -> Q linear, P, Q finite free, K a line and a' : K -> ∧^p P.  Put
-- R_k = Hom(K, ∧^(q+p) P) (Lines.Hom) and, for x in ∧^q P, the element
-- x ∧ a' : ρ ↦ x ∧ a'(ρ) of R_k (wedge-with; products add degrees,
-- deg-mul).  A linear a : R_k -> ∧^q Q satisfies (*) when
--   ∧^q f (x) = a (x ∧ a')     for every x in ∧^q P            (Star).
-- a' is regular (RegularMap) when no nonzero scalar kills its image: this
-- is BE's "I(a') has zero annihilator", without coordinates.
-- Coordinates (Coords): with bases eP : P ~ R^N (q + p = N), eQ : Q ~ R^g and
-- iK : K ~ R, let A be the matrix of eQ f eP^-1, κ = iK^-1(1),
-- b = to_eP(a'(κ)), ρ = the element of R_k with ev ρ = 1 (Lines.HomLine),
-- c = to_eQ(a(ρ)).  Every φ in R_k is ev(φ) ρ (line-value) and
-- ev(x ∧ a') = top(to x ∧ b) (ev-wedge), so to_eQ(a(x ∧ a')) =
-- top(to x ∧ b) c (to-a); to_eQ(∧^q f x) = Lambda(A)(to x)
-- (ExteriorDegreeM.Square).  Since to_eP is bijective and preserves
-- degrees, (*) for a is Dictionary's Wedge for (A, b, c) (to-coords,
-- from-coords); a' is regular iff the coefficients of b are (reg-to,
-- reg-from).
-- T1 (unique): if a' is regular, (*) determines a.  The claim is a
-- proposition, so choose bases: c and c' satisfy Wedge, hence the factored
-- form B_K = bhat_K c (Dictionary.from-wedge) with bhat = unstar b regular
-- of degree q; Factorisations.Unique gives c = c', so a(ρ) = a'(ρ), and a
-- linear map out of a line is determined by its value at ρ.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module C = ExteriorCoordinates[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module TL = TopLine[l].Over[Rg,setR] ;
 module ED = TL.ED ; module EF = TL.EF ; module FM = TL.FM ; module FF = TL.FF ; module SM = TL.SM ; module MS = TL.MS ;
 module AL = TL.AL ; module EC = TL.EC ; module DG = TL.DG ; module HO = TL.HO ; module MM = TL.MM ; module MI = TL.MI ;
 module LN = Lines[l].Over[Rg,setR] ;
 module DI = Dictionary[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module EA = DI.EA ; module FA = DI.FA ;

 -- products add degrees
 deg-mul (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) (p q : Nat) (x y : EF.Lam[M,b].alg.A)
  (dx : ED.Deg M b p x) (dy : ED.Deg M b q y) : ED.Deg M b (plus p q) (EF.Lam[M,b].alg.mul x y) = \ n e ->
  subst (DG.Deg n (plus p q)) (sym (ED.Coord[M,b,n,e].to.2.2.2.1 x y))
   (HO.deg-mul n p q (ED.Coord[M,b,n,e].to.1 x) (ED.Coord[M,b,n,e].to.1 y) (dx n e) (dy n e)) ;

 -- no nonzero scalar kills the image of u
 RegularMap (K V : FM.Module) (u : SM.Linear K V) : U l = (r : R) -> ((k : K.M) -> Id V.M (V.sm r (u.1 k)) V.mz) -> Id R r z ;
 regular-prop (K V : FM.Module) (u : SM.Linear K V) : Pr.isProp (RegularMap K V u) =
  F.isProp-Pi R (\ r -> ((k : K.M) -> Id V.M (V.sm r (u.1 k)) V.mz) -> Id R r z) (\ r ->
   F.isProp-Pi ((k : K.M) -> Id V.M (V.sm r (u.1 k)) V.mz) (\ h -> Id R r z) (\ h -> setR r z)) ;

 -- escale r b = 0 iff r kills every coefficient of b
 scale-kill (n : Nat) (r : R) (b : Ext n) (h : MI.RI.ZeroOn (C.Index n) (CO.coeff n b) r) : Id (Ext n) (escale n r b) (ezero n) =
  CO.ext n (escale n r b) (ezero n) (\ I -> trans (CO.coeff-scale n r b I)
   (trans (mulC r (CO.coeff n b I)) (trans (h I) (sym (CO.coeff-zero n I))))) ;
 kill-scale (n : Nat) (r : R) (b : Ext n) (h : Id (Ext n) (escale n r b) (ezero n)) : MI.RI.ZeroOn (C.Index n) (CO.coeff n b) r = \ I ->
  trans (mulC (CO.coeff n b I) r) (trans (sym (CO.coeff-scale n r b I)) (trans (ap (\ w -> CO.coeff n w I) h) (CO.coeff-zero n I))) ;

 -- R_k = Hom(K, ∧^(q+p) P)
 RkOf (P : FM.Module) (bP : Tr.Trunc[FF.Based P].carrier) (q p : Nat) (K : FM.Module) : FM.Module =
  LN.Hom[K,TL.Piece[P,bP,plus q p].carrier].hmod ;
 module Stage (P Q : FM.Module) (bP : Tr.Trunc[FF.Based P].carrier) (bQ : Tr.Trunc[FF.Based Q].carrier)
  (f : SM.Linear P Q) (q p : Nat) (K : FM.Module) (a' : SM.Linear K TL.Piece[P,bP,p].carrier) {
  module LP = EF.Lam[P,bP] ;
  module PP = TL.Piece[P,bP,q] ; module PB = TL.Piece[P,bP,p] ; module PS = TL.Piece[P,bP,plus q p] ;
  module PQ = TL.Piece[Q,bQ,q] ;
  module W = TL.PieceMap[P,Q,bP,bQ,f,q] ;
  module HK = LN.Hom[K,PS.carrier] ;
  Rk : FM.Module = RkOf P bP q p K ;
  -- x ∧ a' : ρ ↦ x ∧ a'(ρ)
  module WW (x : PP.carrier.M) {
   fun (k : K.M) : PS.carrier.M = (LP.alg.mul x.1 (a'.1 k).1,deg-mul P bP q p x.1 (a'.1 k).1 x.2 (a'.1 k).2) ;
   lin : HK.T = (fun,
    \ k k' -> PS.SB.eq _ _ (trans (ap (\ u -> LP.alg.mul x.1 u.1) (a'.2.1 k k')) (LP.alg.dist-left x.1 (a'.1 k).1 (a'.1 k').1)),
    \ c k -> PS.SB.eq _ _ (trans (ap (\ u -> LP.alg.mul x.1 u.1) (a'.2.2 c k)) (LP.alg.scale-mul-right c x.1 (a'.1 k).1))) ;
  } ;
  wedge-with (x : PP.carrier.M) : HK.T = WW[x].lin ;
  -- the relation (*)
  Star (a : SM.Linear Rk PQ.carrier) : U l = (x : PP.carrier.M) -> Id PQ.carrier.M (W.map.1 x) (a.1 (wedge-with x)) ;
  star-prop (a : SM.Linear Rk PQ.carrier) : Pr.isProp (Star a) =
   F.isProp-Pi PP.carrier.M (\ x -> Id PQ.carrier.M (W.map.1 x) (a.1 (wedge-with x))) (\ x ->
    PQ.carrier.setM (W.map.1 x) (a.1 (wedge-with x))) ;
  Regular : U l = RegularMap K PB.carrier a' ;

  -- coordinates
  module Coords (N : Nat) (hN : Id Nat (plus q p) N) (eP : MS.LinEquiv P (FM.Free N)) (g : Nat) (eQ : MS.LinEquiv Q (FM.Free g))
   (iK : MS.LinEquiv K FM.regular) {
   module IP = TL.Inverse[P,bP,N,eP] ;
   module IQ = TL.Inverse[Q,bQ,g,eQ] ;
   module TW = TL.TopBasis[P,bP,plus q p,N,hN,eP] ;
   module HL = LN.HomLine[K,PS.carrier,iK,TW.line] ;
   module IK = HL.IK ;
   module IR = ED.Inv[Rk,FM.regular,HL.line] ;
   module SQ = ED.Square[P,Q,bP,bQ,f,g,eQ,N,eP] ;
   A : MM.Mat N g = SQ.A ;
   kappa : K.M = HL.kappa ;
   b : Ext N = IP.CE.to.1 (a'.1 kappa).1 ;
   b-degree : DG.Deg N p b = (a'.1 kappa).2 N eP ;
   rho : Rk.M = HL.mk o ;
   -- every element of K is iK(k) κ, every element of R_k is ev(φ) ρ
   k-value (k : K.M) : Id K.M k (K.sm (IK.fun k) kappa) =
    sym (trans (sym (IK.inv-scale (IK.fun k) o)) (trans (ap IK.inv (mulO (IK.fun k))) (IK.ret-eq k))) ;
   line-value (phi : Rk.M) : Id Rk.M phi (Rk.sm (HL.ev phi) rho) =
    sym (trans (sym (IR.inv-scale (HL.ev phi) o)) (trans (ap HL.mk (mulO (HL.ev phi))) (HL.mk-ev phi))) ;
   -- ev(x ∧ a') = top(to x ∧ b)
   ev-wedge (x : PP.carrier.M) : Id R (HL.ev (wedge-with x)) (top N (emul N (IP.CE.to.1 x.1) b)) =
    ap (top N) (IP.CE.to.2.2.2.1 x.1 (a'.1 kappa).1) ;
   -- to(∧^q f x) = Lambda(A)(to x)
   to-wedge-f (x : PP.carrier.M) : Id (Ext g) (IQ.CE.to.1 (W.map.1 x).1) (SQ.LA.value (IP.CE.to.1 x.1)) = SQ.value x.1 ;
   -- to(a'(k)) = iK(k) b
   to-a' (k : K.M) : Id (Ext N) (IP.CE.to.1 (a'.1 k).1) (escale N (IK.fun k) b) = calc (Ext N) {
    IP.CE.to.1 (a'.1 k).1 =< ap (\ t -> IP.CE.to.1 (a'.1 t).1) (k-value k) > IP.CE.to.1 (a'.1 (K.sm (IK.fun k) kappa)).1
     =< ap (\ u -> IP.CE.to.1 u.1) (a'.2.2 (IK.fun k) kappa) > IP.CE.to.1 (LP.alg.scale (IK.fun k) (a'.1 kappa).1)
     =< IP.CE.to.2.2.1 (IK.fun k) (a'.1 kappa).1 > escale N (IK.fun k) b } ;
   module H0 = AL.In[EC.Lam N].H[LP.alg,IP.CE.to] ;
   -- regularity of a' is regularity of the coefficients of b
   reg-from (rb : MI.RI.Regular (C.Index N) (CO.coeff N b)) : Regular = \ r h ->
    rb r tt (kill-scale N r b (calc (Ext N) {
     escale N r b =< sym (IP.CE.to.2.2.1 r (a'.1 kappa).1) > IP.CE.to.1 (LP.alg.scale r (a'.1 kappa).1)
      =< ap (\ u -> IP.CE.to.1 u.1) (h kappa) > IP.CE.to.1 LP.alg.zero
      =< H0.zero > ezero N })) ;
   reg-to (ra : Regular) : MI.RI.Regular (C.Index N) (CO.coeff N b) = \ r t hz ->
    ra r (\ k -> PB.SB.eq _ _ (IP.to-inj _ _ (calc (Ext N) {
     IP.CE.to.1 (LP.alg.scale r (a'.1 k).1) =< IP.CE.to.2.2.1 r (a'.1 k).1 > escale N r (IP.CE.to.1 (a'.1 k).1)
      =< ap (escale N r) (to-a' k) > escale N r (escale N (IK.fun k) b)
      =< EA.escale-scale N r (IK.fun k) b > escale N (mul r (IK.fun k)) b
      =< ap (\ c -> escale N c b) (mulC r (IK.fun k)) > escale N (mul (IK.fun k) r) b
      =< sym (EA.escale-scale N (IK.fun k) r b) > escale N (IK.fun k) (escale N r b)
      =< ap (escale N (IK.fun k)) (scale-kill N r b hz) > escale N (IK.fun k) (ezero N)
      =< EA.escale-zero N (IK.fun k) > ezero N
      =< sym H0.zero > IP.CE.to.1 LP.alg.zero }))) ;
   -- a linear map out of R_k, in coordinates
   module At (a : SM.Linear Rk PQ.carrier) {
    c : Ext g = IQ.CE.to.1 (a.1 rho).1 ;
    module DS = DI.Stage[N,g,q,A,b,c] ;
    to-a (x : PP.carrier.M) :
     Id (Ext g) (IQ.CE.to.1 (a.1 (wedge-with x)).1) (escale g (top N (emul N (IP.CE.to.1 x.1) b)) c) = calc (Ext g) {
     IQ.CE.to.1 (a.1 (wedge-with x)).1
      =< ap (\ phi -> IQ.CE.to.1 (a.1 phi).1) (line-value (wedge-with x))
      > IQ.CE.to.1 (a.1 (Rk.sm (HL.ev (wedge-with x)) rho)).1
      =< ap (\ u -> IQ.CE.to.1 u.1) (a.2.2 (HL.ev (wedge-with x)) rho)
      > IQ.CE.to.1 (IQ.LM.alg.scale (HL.ev (wedge-with x)) (a.1 rho).1)
      =< IQ.CE.to.2.2.1 (HL.ev (wedge-with x)) (a.1 rho).1 > escale g (HL.ev (wedge-with x)) c
      =< ap (\ t -> escale g t c) (ev-wedge x) > escale g (top N (emul N (IP.CE.to.1 x.1) b)) c } ;
    -- (*) is Dictionary's Wedge
    deg-q (x : PP.carrier.M) : DG.Deg N q (IP.CE.to.1 x.1) = x.2 N eP ;
    to-coords (h : Star a) : DS.Wedge = \ y dy -> calc (Ext g) {
     SQ.LA.value y =< ap SQ.LA.value (sym (IP.to-from y)) > SQ.LA.value (IP.CE.to.1 (IP.from.1 y))
      =< sym (to-wedge-f (IP.from.1 y,IP.from-degree q y dy)) > IQ.CE.to.1 (W.map.1 (IP.from.1 y,IP.from-degree q y dy)).1
      =< ap (\ u -> IQ.CE.to.1 u.1) (h (IP.from.1 y,IP.from-degree q y dy))
      > IQ.CE.to.1 (a.1 (wedge-with (IP.from.1 y,IP.from-degree q y dy))).1
      =< to-a (IP.from.1 y,IP.from-degree q y dy) > escale g (top N (emul N (IP.CE.to.1 (IP.from.1 y)) b)) c
      =< ap (\ t -> escale g (top N (emul N t b)) c) (IP.to-from y) > escale g (top N (emul N y b)) c } ;
    from-coords (h : DS.Wedge) : Star a = \ x -> PQ.SB.eq _ _ (IQ.to-inj _ _
     (trans (to-wedge-f x) (trans (h (IP.CE.to.1 x.1) (deg-q x)) (sym (to-a x))))) ;
    -- a is determined by a(ρ)
    value (phi : Rk.M) : Id PQ.carrier.M (a.1 phi) (PQ.carrier.sm (HL.ev phi) (a.1 rho)) =
     trans (ap a.1 (line-value phi)) (a.2.2 (HL.ev phi) rho) ;
   } ;
   -- T1 with bases
   module Unique (ra : Regular) (a1 a2 : SM.Linear Rk PQ.carrier) (h1 : Star a1) (h2 : Star a2) {
    module A1 = At[a1] ; module A2 = At[a2] ;
    bhat-degree : DG.Deg N q A1.DS.bhat = HO.unstar-degree N q p b b-degree hN ;
    bhat-regular : MI.RI.Regular (C.Index N) (CO.coeff N A1.DS.bhat) = FA.unstar-regular N b (reg-to ra) ;
    c-eq : Id (Ext g) A1.c A2.c =
     FA.Unique[N,q,g,A1.DS.bhat,bhat-degree,bhat-regular,A1.c,A2.c,
      \ K e -> trans (sym (A1.DS.from-wedge (A1.to-coords h1) K e)) (A2.DS.from-wedge (A2.to-coords h2) K e)].result ;
    rho-eq : Id PQ.carrier.M (a1.1 rho) (a2.1 rho) = PQ.SB.eq _ _ (IQ.to-inj _ _ c-eq) ;
    result : Id (SM.Linear Rk PQ.carrier) a1 a2 = LN.lin-eq Rk PQ.carrier a1 a2 (\ phi ->
     trans (A1.value phi) (trans (ap (PQ.carrier.sm (HL.ev phi)) rho-eq) (sym (A2.value phi)))) ;
   } ;
  } ;

  -- T1: (*) determines a when a' is regular
  module Bases (N : Nat) (hN : Id Nat (plus q p) N) (bn : Tr.Trunc[MS.LinEquiv P (FM.Free N)].carrier) (lK : LN.Line K) {
   unique (ra : Regular) (a1 a2 : SM.Linear Rk PQ.carrier) (h1 : Star a1) (h2 : Star a2) : Id (SM.Linear Rk PQ.carrier) a1 a2 =
    Tr.Trunc[MS.LinEquiv P (FM.Free N)].induction @l (\ w -> Id (SM.Linear Rk PQ.carrier) a1 a2) (\ w -> LN.Hom[Rk,PQ.carrier].set a1 a2)
     (\ eP -> Tr.Trunc[FF.Based Q].induction @l (\ w -> Id (SM.Linear Rk PQ.carrier) a1 a2) (\ w -> LN.Hom[Rk,PQ.carrier].set a1 a2)
      (\ eQ -> Tr.Trunc[MS.LinEquiv K FM.regular].induction @l (\ w -> Id (SM.Linear Rk PQ.carrier) a1 a2) (\ w -> LN.Hom[Rk,PQ.carrier].set a1 a2)
       (\ iK -> Coords[N,hN,eP,eQ.1,eQ.2,iK].Unique[ra,a1,a2,h1,h2].result) lK) bQ) bn ;
   -- so the a satisfying (*) form a proposition
   Solution : U l = (a : SM.Linear Rk PQ.carrier) * Star a ;
   solution-prop (ra : Regular) : Pr.isProp Solution = \ u v ->
    Pr.Sigma-eq (SM.Linear Rk PQ.carrier) Star u.1 v.1 u.2 v.2 (unique ra u.1 v.1 u.2 v.2) (star-prop v.1) ;
  } ;
 } ;
} ;
