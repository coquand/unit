-- Lines (cffru, step 2, L1).  The linear maps K -> M form a module
-- (Hom.hmod, pointwise operations; linear maps with the same values are
-- equal, lin-eq).  A line is a module merely linearly equivalent to R
-- (Line).  If K and L are lines, so is Hom(K, L) (hom-line): with
-- iK : K ~ R and iL : L ~ R, f |-> iL (f (iK^-1 1)) has the inverse
-- c |-> (x |-> iL^-1 (c iK(x))), since x = iK(x) iK^-1(1) and f is linear.
-- This replaces the tensor L ⊗ K* of Buchsbaum-Eisenbud (STEP2-DESIGN §1).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module ED = ExteriorDegreeM[l].Over[Rg,setR] ;
 module FM = ED.FM ; module SM = ED.SM ; module MS = ED.MS ;
 module A7 = Alg73[l] ;
 lin-eq (K M : FM.Module) (f g : SM.Linear K M) (h : (x : K.M) -> Id M.M (f.1 x) (g.1 x)) : Id (SM.Linear K M) f g =
  Pr.Sigma-eq (K.M -> M.M) (\ u -> MS.Additive K M u * MS.Scalar K M u) f.1 g.1 f.2 g.2
   (F.funext K.M (\ x -> M.M) f.1 g.1 h) (MS.lin-prop K M g.1) ;
 module Hom (K M : FM.Module) {
  module MA = A7.MA[FM.MO.ring,M] ;
  T : U l = SM.Linear K M ;
  set : Pr.isSet T = Torsor[l].isSet-sub (K.M -> M.M) (\ u -> MS.Additive K M u * MS.Scalar K M u)
   (F.isSet-Pi K.M (\ x -> M.M) (\ x -> M.setM)) (MS.lin-prop K M) ;
  eq (f g : T) (h : (x : K.M) -> Id M.M (f.1 x) (g.1 x)) : Id T f g = lin-eq K M f g h ;
  hz : T = (\ x -> M.mz,\ x y -> sym (M.maddZ M.mz),\ a x -> sym (MA.sm-zr a)) ;
  hadd (f g : T) : T = (\ x -> M.madd (f.1 x) (g.1 x),
   \ x y -> trans (Ps.cong2 M.M M.madd _ _ _ _ (f.2.1 x y) (g.2.1 x y)) (MA.swap4 (f.1 x) (f.1 y) (g.1 x) (g.1 y)),
   \ a x -> trans (Ps.cong2 M.M M.madd _ _ _ _ (f.2.2 a x) (g.2.2 a x)) (sym (M.smD a (f.1 x) (g.1 x)))) ;
  hneg (f : T) : T = (\ x -> M.mneg (f.1 x),
   \ x y -> trans (ap M.mneg (f.2.1 x y)) (MA.neg-add (f.1 x) (f.1 y)),
   \ a x -> trans (ap M.mneg (f.2.2 a x)) (sym (MA.sm-neg a (f.1 x)))) ;
  hsc (c : R) (f : T) : T = (\ x -> M.sm c (f.1 x),
   \ x y -> trans (ap (M.sm c) (f.2.1 x y)) (M.smD c (f.1 x) (f.1 y)),
   \ a x -> trans (ap (M.sm c) (f.2.2 a x)) (MA.sm-swap c a (f.1 x))) ;
  hmod : FM.Module = new A7.Mod[FM.MO.ring,T,set,hz,hadd,hneg,
   \ f g h -> eq _ _ (\ x -> M.maddA (f.1 x) (g.1 x) (h.1 x)),
   \ f g -> eq _ _ (\ x -> M.maddC (f.1 x) (g.1 x)),
   \ f -> eq _ _ (\ x -> M.maddZ (f.1 x)),
   \ f -> eq _ _ (\ x -> M.maddN (f.1 x)),
   hsc,
   \ a b f -> eq _ _ (\ x -> M.smA a b (f.1 x)),
   \ f -> eq _ _ (\ x -> M.smO (f.1 x)),
   \ a f g -> eq _ _ (\ x -> M.smD a (f.1 x) (g.1 x)),
   \ a b f -> eq _ _ (\ x -> M.smE a b (f.1 x))] ;
 } ;
 Line (K : FM.Module) : U l = Tr.Trunc[MS.LinEquiv K FM.regular].carrier ;
 -- Hom of two lines is a line
 module HomLine (K M : FM.Module) (eK : MS.LinEquiv K FM.regular) (eM : MS.LinEquiv M FM.regular) {
  module H = Hom[K,M] ;
  module IK = ED.Inv[K,FM.regular,eK] ; module IM = ED.Inv[M,FM.regular,eM] ;
  kappa : K.M = IK.inv o ;
  ev (f : H.T) : R = IM.fun (f.1 kappa) ;
  mk (c : R) : H.T = (\ x -> IM.inv (mul c (IK.fun x)),
   \ x y -> trans (ap (\ t -> IM.inv (mul c t)) (IK.fun-add x y))
    (trans (ap IM.inv (dist c (IK.fun x) (IK.fun y))) (IM.inv-add (mul c (IK.fun x)) (mul c (IK.fun y)))),
   \ a x -> trans (ap (\ t -> IM.inv (mul c t)) (IK.fun-scale a x))
    (trans (ap IM.inv (L.mul-swap c a (IK.fun x))) (IM.inv-scale a (mul c (IK.fun x))))) ;
  ev-mk (c : R) : Id R (ev (mk c)) c =
   trans (IM.inv-eq (mul c (IK.fun kappa))) (trans (ap (mul c) (IK.inv-eq o)) (mulO c)) ;
  mk-ev (f : H.T) : Id H.T (mk (ev f)) f = H.eq (mk (ev f)) f (\ x -> calc M.M {
   IM.inv (mul (ev f) (IK.fun x))
    =< ap IM.inv (mulC (ev f) (IK.fun x)) > IM.inv (mul (IK.fun x) (IM.fun (f.1 kappa)))
    =< ap IM.inv (sym (IM.fun-scale (IK.fun x) (f.1 kappa))) > IM.inv (IM.fun (M.sm (IK.fun x) (f.1 kappa)))
    =< IM.ret-eq (M.sm (IK.fun x) (f.1 kappa)) > M.sm (IK.fun x) (f.1 kappa)
    =< sym (f.2.2 (IK.fun x) kappa) > f.1 (K.sm (IK.fun x) kappa)
    =< ap f.1 (sym (trans (ap IK.inv (sym (mulO (IK.fun x)))) (IK.inv-scale (IK.fun x) o))) > f.1 (IK.inv (IK.fun x))
    =< ap f.1 (IK.ret-eq x) > f.1 x }) ;
  line : MS.LinEquiv H.hmod FM.regular =
   ((ev,Pr.qinv H.T R ev mk ev-mk mk-ev),
    \ f g -> IM.fun-add (f.1 kappa) (g.1 kappa),
    \ c f -> IM.fun-scale c (f.1 kappa)) ;
 } ;
 hom-line (K M : FM.Module) (lK : Line K) (lM : Line M) : Line Hom[K,M].hmod =
  TC.map2 (MS.LinEquiv K FM.regular) (MS.LinEquiv M FM.regular) (MS.LinEquiv Hom[K,M].hmod FM.regular)
   (\ eK eM -> HomLine[K,M,eK,eM].line) lK lM ;
} ;
