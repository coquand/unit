-- Ranks without bases (cffru).
-- f : M -> N linear, M, N finite free.  ∧^k f vanishes (VanishP k) when every
-- product f v_1 ∧ ... ∧ f v_k is 0 in ∧N; f is stable of rank r (Stable r)
-- when ∧^(r+1) f vanishes and D_r(f) is regular (DkFree), cffr §2 without
-- bases.  Both are propositions.
-- Uniqueness (unique): if f is stable of ranks r and r' then 1 = 0 or
-- r = r'.  Proof: say r' = r + 1 + j.  ∧^k f = 0 gives ∧^(k+1) f = 0
-- (step: the product of k+1 vectors is the product of the first k times
-- the last), so ∧^(r') f = 0 (up); then every generator of D_(r')(f) is
-- λ(0) = 0 and D_(r')(f) regular forces 1 = 0 (trivial).
-- Coordinates (Coords): with bases, cffr's stability of the matrix (image
-- form, Resolution.Stable) gives Stable: to_eN of a product is the wedge of
-- the image vectors (DkFree.to-value), killed by 1, and to_eN is injective;
-- regularity by DkFree.reg-to-free.  Conversely (vanish-minors,
-- regular-image): ∧^k f = 0 gives D_k(A) = 0, since every k-minor of A is
-- the value of a generator (DkFree.minor-value), and D_r(f) regular gives
-- D_r(A) regular (DkFree.reg-from-free).
-- Free rank (FreeRank.unique): M ~ R^n and M ~ R^n' give 1 = 0 or n = n'.
-- Proof: say n' = n + 1 + j; e e'^-1 : R^n' -> R^n is injective, so 1 = 0
-- (Minors.trivial, McCoy).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module DK = DkFree[l].Over[Rg,setR] ;
 module TL = DK.TL ; module ED = DK.ED ; module FM = DK.FM ; module FF = DK.FF ; module SM = DK.SM ; module MS = DK.MS ;
 module MM = DK.MM ; module MI = DK.MI ; module RI = DK.RI ;
 module AL = TL.AL ; module EC = TL.EC ; module HO = TL.HO ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module MF = MinorForms[l].Over[Rg,setR] ;

 -- r = r', r' = r + 1 + j, or r = r' + 1 + j
 Compare (r r' : Nat) : U l =
  Plus (Id Nat r r') (Plus ((j : Nat) * Id Nat r' (plus r (suc j))) ((j : Nat) * Id Nat r (plus r' (suc j)))) ;
 compare-gt (r r' : Nat) : Plus ((j : Nat) * Id Nat r' (plus r (suc j))) ((j : Nat) * Id Nat r (plus r' (suc j))) ->
  Plus ((j : Nat) * Id Nat (suc r') (plus (suc r) (suc j))) ((j : Nat) * Id Nat (suc r) (plus (suc r') (suc j))) = split {
  inl w -> inl (w.1,ap (\ k -> suc k) w.2) ;
  inr w -> inr (w.1,ap (\ k -> suc k) w.2) } ;
 compare-suc (r r' : Nat) : Compare r r' -> Compare (suc r) (suc r') = split {
  inl e -> inl (ap (\ k -> suc k) e) ;
  inr w -> inr (compare-gt r r' w) } ;
 compare : (r r' : Nat) -> Compare r r' = split {
  zero -> split { zero -> inl (refl zero) ; suc r' -> inr (inl (r',refl (suc r'))) } ;
  suc r | ih -> split { zero -> inr (inr (r,refl (suc r))) ; suc r' -> compare-suc r r' (ih r') } } ;
 -- j + (r + 1) = r + (j + 1)
 plus-swap (j r : Nat) : Id Nat (plus j (suc r)) (plus r (suc j)) =
  trans (plus-suc j r) (trans (ap (\ k -> suc k) (plus-comm j r)) (sym (plus-suc r j))) ;
 regular-prop (X : U l) (a : X -> R) : Pr.isProp (RI.Regular X a) =
  F.isProp-Pi R (\ x -> Top -> RI.ZeroOn X a x -> Id R x z) (\ x ->
   F.isProp-Pi Top (\ t -> RI.ZeroOn X a x -> Id R x z) (\ t ->
    F.isProp-Pi (RI.ZeroOn X a x) (\ h -> Id R x z) (\ h -> setR x z))) ;

 module Rk (M N : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) (bN : Tr.Trunc[FF.Based N].carrier) (f : SM.Linear M N) {
  module PN = DK.Prod[N,bN] ;
  module DF (k : Nat) { module K = DK.Dk[M,N,bM,bN,f,k] ; } ;
  -- ∧^k f = 0
  VanishP (k : Nat) : U l = (v : Ps.Fin k -> M.M) -> Id PN.LM.alg.A (DF[k].K.image v) PN.LM.alg.zero ;
  vanish-prop (k : Nat) : Pr.isProp (VanishP k) =
   F.isProp-Pi (Ps.Fin k -> M.M) (\ v -> Id PN.LM.alg.A (DF[k].K.image v) PN.LM.alg.zero) (\ v ->
    PN.LM.alg.set (DF[k].K.image v) PN.LM.alg.zero) ;
  mul-right (y : PN.LM.alg.A) : SM.Linear (TL.alg-mod PN.LM.alg) (TL.alg-mod PN.LM.alg) =
   (\ x -> PN.LM.alg.mul x y,\ x x' -> PN.LM.alg.dist-right x x' y,\ c x -> PN.LM.alg.scale-mul-left c x y) ;
  step (k : Nat) (h : VanishP k) : VanishP (suc k) = \ v ->
   trans (ap (\ x -> PN.LM.alg.mul x (PN.LM.gen.1 (f.1 (v (inr tt))))) (h (\ t -> v (inl t))))
    (SM.Lin[TL.alg-mod PN.LM.alg,TL.alg-mod PN.LM.alg,mul-right (PN.LM.gen.1 (f.1 (v (inr tt))))].map-z) ;
  up : (j k : Nat) -> VanishP k -> VanishP (plus j k) = split {
   zero -> \ k h -> h ;
   suc j | r -> \ k h -> step (plus j k) (r k h) } ;
  -- D_k regular and ∧^k f = 0 give 1 = 0
  value-zero (k : Nat) (h : VanishP k) (g : DF[k].K.Gen) : Id R (DF[k].K.value g) z =
   trans (ap g.2.1 (h g.1)) (SM.Lin[TL.alg-mod PN.LM.alg,FM.regular,g.2].map-z) ;
  trivial (k : Nat) (h : VanishP k) (rg : DF[k].K.Regular) : Id R o z =
   rg o tt (\ g -> trans (ap (\ c -> mul c o) (value-zero k h g)) (L.zero-mul o)) ;
  -- stable of rank r
  Stable (r : Nat) : U l = VanishP (suc r) * DF[r].K.Regular ;
  stable-prop (r : Nat) : Pr.isProp (Stable r) =
   HO.prod-prop (VanishP (suc r)) DF[r].K.Regular (vanish-prop (suc r)) (regular-prop DF[r].K.Gen DF[r].K.value) ;
  bigger (r j : Nat) (h : Stable r) (h' : Stable (plus r (suc j))) : Id R o z =
   trivial (plus r (suc j)) (subst VanishP (plus-swap j r) (up j (suc r) h.1)) h'.2 ;
  bigger-cases (r r' : Nat) (h : Stable r) (h' : Stable r') :
   Plus ((j : Nat) * Id Nat r' (plus r (suc j))) ((j : Nat) * Id Nat r (plus r' (suc j))) -> Id R o z = split {
   inl w -> bigger r w.1 h (subst Stable w.2 h') ;
   inr w -> bigger r' w.1 h' (subst Stable w.2 h) } ;
  unique-cases (r r' : Nat) (h : Stable r) (h' : Stable r') : Compare r r' -> Plus (Id R o z) (Id Nat r r') = split {
   inl e -> inr e ;
   inr w -> inl (bigger-cases r r' h h' w) } ;
  unique (r r' : Nat) (h : Stable r) (h' : Stable r') : Plus (Id R o z) (Id Nat r r') =
   unique-cases r r' h h' (compare r r') ;

  -- cffr's stability of the matrix gives Stable
  module Coords (p : Nat) (eM : MS.LinEquiv M (FM.Free p)) (q : Nat) (eN : MS.LinEquiv N (FM.Free q)) {
   module SQ = ED.Square[M,N,bM,bN,f,q,eN,p,eM] ;
   A : MM.Mat p q = SQ.A ;
   module CK (k : Nat) { module C = DF[k].K.Coords[p,eM,q,eN] ; } ;
   module H0 = AL.In[EC.Lam q].H[PN.LM.alg,CK[zero].C.CN.to] ;
   vanish-from (k : Nat) (h : MF.ImageVanish k p q A) : VanishP k = \ v ->
    CK[k].C.IN.to-inj (DF[k].K.image v) PN.LM.alg.zero (calc (Ext q) {
     CK[k].C.CN.to.1 (DF[k].K.image v) =< CK[k].C.to-value v > MM.wedge k q (DK.MK.compose k p q A (CK[k].C.coords v))
      =< sym (EA.escale-one q (MM.wedge k q (DK.MK.compose k p q A (CK[k].C.coords v)))) >
      escale q o (MM.wedge k q (DK.MK.compose k p q A (CK[k].C.coords v)))
      =< h (CK[k].C.coords v) > ezero q
      =< sym H0.zero > CK[k].C.CN.to.1 PN.LM.alg.zero }) ;
   from-matrix (n : Nat) (st : MF.ImageVanish (suc n) p q A * MF.ImageRegular n p q A) : Stable n =
    (vanish-from (suc n) st.1,CK[n].C.reg-to-free (MF.image-to-regular n p q A st.2)) ;
   -- conversely: ∧^k f = 0 gives D_k(A) = 0 (each minor is a value, DkFree.minor-value);
   -- D_r(f) regular gives the image form of D_r(A) regular
   vanish-minors (k : Nat) (h : VanishP k) : MI.Vanish k p q A =
    \ ci -> trans (sym (CK[k].C.minor-value ci)) (value-zero k h (CK[k].C.minor-gen ci)) ;
   regular-image (n : Nat) (rg : DF[n].K.Regular) : MF.ImageRegular n p q A =
    MF.regular-to-image n p q A (CK[n].C.reg-from-free rg) ;
  } ;
 } ;

 -- the rank of a finite free module is unique (unless 1 = 0)
 module FreeRank (M : FM.Module) (bM : Tr.Trunc[FF.Based M].carrier) {
  idlin : SM.Linear M M = (\ x -> x,\ x y -> refl (M.madd x y),\ c x -> refl (M.sm c x)) ;
  module Big (n j : Nat) (e : MS.LinEquiv M (FM.Free n)) (e' : MS.LinEquiv M (FM.Free (plus n (suc j)))) {
   module SQ = ED.Square[M,M,bM,bM,idlin,n,e,plus n (suc j),e'] ;
   module I = ED.Inv[M,FM.Free n,e] ; module I' = ED.Inv[M,FM.Free (plus n (suc j)),e'] ;
   injective : FM.InjectiveL (FM.Free (plus n (suc j))) (FM.Free n) SQ.g = \ y hy -> calc (FM.Free (plus n (suc j))).M {
    y =< sym (I'.inv-eq y) > e'.1.1 (I'.inv y)
     =< ap e'.1.1 (trans (sym (I.ret-eq (I'.inv y))) (trans (ap I.inv hy) (SM.Lin[FM.Free n,M,I.linear].map-z))) > e'.1.1 M.mz
     =< SM.Lin[M,FM.Free (plus n (suc j)),FM.lin M (FM.Free (plus n (suc j))) e'].map-z > (FM.Free (plus n (suc j))).mz } ;
   result : Id R o z = MI.trivial n j SQ.A (FM.injective (plus n (suc j)) n SQ.g injective) ;
  } ;
  big (n n' j : Nat) (w : Id Nat n' (plus n (suc j))) (e : MS.LinEquiv M (FM.Free n)) (e' : MS.LinEquiv M (FM.Free n')) : Id R o z =
   subst (\ k -> MS.LinEquiv M (FM.Free k) -> Id R o z) (sym w) (\ e'' -> Big[n,j,e,e''].result) e' ;
  big-cases (n n' : Nat) (e : MS.LinEquiv M (FM.Free n)) (e' : MS.LinEquiv M (FM.Free n')) :
   Plus ((j : Nat) * Id Nat n' (plus n (suc j))) ((j : Nat) * Id Nat n (plus n' (suc j))) -> Id R o z = split {
   inl w -> big n n' w.1 w.2 e e' ;
   inr w -> big n' n w.1 w.2 e' e } ;
  unique-cases (n n' : Nat) (e : MS.LinEquiv M (FM.Free n)) (e' : MS.LinEquiv M (FM.Free n')) :
   Compare n n' -> Plus (Id R o z) (Id Nat n n') = split {
   inl w -> inr w ;
   inr w -> inl (big-cases n n' e e' w) } ;
  unique (n n' : Nat) (e : MS.LinEquiv M (FM.Free n)) (e' : MS.LinEquiv M (FM.Free n')) : Plus (Id R o z) (Id Nat n n') =
   unique-cases n n' e e' (compare n n') ;
 } ;
} ;
