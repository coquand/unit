-- The structure theorem without bases (cffru, step 2, T2).
-- Buchsbaum-Eisenbud (BE1, Thm 3.1 and the remark after it) in cffr's
-- layout (Cor85): finite free modules G t, merely with bases of d t
-- elements (one truncation for the family, bs), linear maps
-- f t : G t -> G (t+1) with f (t+1) f t = 0 (cz) and rk (t+1) + rk t =
-- d (t+1) (hd), for t <= T.  The lines (Lns):
--   R_0 = R ,   R_(t+1) = Hom(R_t, ∧^(rk (t+1) + rk t) G (t+1)) ,
-- a_0 : R -> ∧^0 G 1, c |-> c 1 (Unit), and a structure (Structure) is
-- a_(t+1) : R_(t+1) -> ∧^(rk (t+1)) G (t+2) for t <= T (Mid for t < T,
-- and the last one) with (*) at every f (t+1) (StageStar.Stage.Star,
-- a' = a_t) and a_t regular for t <= T (StageStar.RegularMap).
-- Theorem: if, for every choice of bases, the matrices satisfy cffr's
-- hypotheses (Gr(D_(rk (t+1))(M (t+1))) >= 2 for t < T, D(M (T+1))
-- regular), the type of structures is contractible (contractible).
-- Proof.  Uniqueness (Agree): by induction on t, a_t = a'_t, then (*)
-- determines a_(t+1) (StageStar.Bases.unique, R_t a line: lines).
-- Existence (Center): the claim is a proposition, so take bases es.  The
-- lines get bases iota t (Lines.HomLine over the top lines,
-- TopLine.TopBasis); a_(t+1) is v |-> from(iota(v) beta_(t+1)) (FromCoord),
-- where beta is the normalised chain of Factorisations (centre) and
-- gamma the last factor.  In the coordinates of StageStar.Coords, b =
-- beta_t (b-value) and c = beta_(t+1) (FromCoord.at-unit), so (*) is
-- Dictionary's Wedge for (M (t+1), beta_t, beta_(t+1)), which is
-- Dictionary.Chain.stage-wedge (Last.last-wedge for the last map);
-- regularity of a_t is that of beta_t (Cor85: Gr(beta_t) >= 2).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module C = ExteriorCoordinates[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module SS = StageStar[l].Over[Rg,setR] ;
 module TL = SS.TL ; module ED = SS.ED ; module EF = SS.EF ; module FM = SS.FM ; module FF = SS.FF ;
 module SM = SS.SM ; module MS = SS.MS ; module AL = SS.AL ; module EC = SS.EC ; module DG = SS.DG ;
 module HO = SS.HO ; module MM = SS.MM ; module MI = SS.MI ; module LN = SS.LN ; module DI = SS.DI ;
 module CO = SS.CO ; module EA = SS.EA ; module FA = SS.FA ;
 module C85 = Cor85[l].Over[Rg,setR] ;
 module L84 = Lemma84[l].Over[Rg,setR] ;
 id-line : MS.LinEquiv FM.regular FM.regular =
  ((\ x -> x,Pr.qinv R R (\ x -> x) (\ x -> x) (\ x -> refl x) (\ x -> refl x)),\ x y -> refl (add x y),\ a x -> refl (mul a x)) ;

 -- a_0 : R -> ∧^0 M, c |-> c 1
 module Unit (M : FM.Module) (b : Tr.Trunc[FF.Based M].carrier) {
  module LM = EF.Lam[M,b] ;
  module P0 = TL.Piece[M,b,zero] ;
  one-degree : ED.Deg M b zero LM.alg.one = \ n e ->
   subst (DG.Deg n zero) (sym (ED.Coord[M,b,n,e].to.2.2.2.2)) (C85.one-degree n) ;
  map : SM.Linear FM.regular P0.carrier = (\ c -> (LM.alg.scale c LM.alg.one,P0.sub.scale c LM.alg.one one-degree),
   \ x y -> P0.SB.eq _ _ (LM.alg.add-scale x y LM.alg.one),
   \ a x -> P0.SB.eq _ _ (sym (LM.alg.scale-scale a x LM.alg.one))) ;
  -- in coordinates a_0(1) = 1
  at-unit (n : Nat) (e : MS.LinEquiv M (FM.Free n)) : Id (Ext n) (ED.Coord[M,b,n,e].to.1 (map.1 o).1) (eone n) =
   trans (ED.Coord[M,b,n,e].to.2.2.1 o LM.alg.one)
    (trans (ap (escale n o) ED.Coord[M,b,n,e].to.2.2.2.2) (EA.escale-one n (eone n))) ;
 } ;
 -- a linear map V -> ∧^k Q given in coordinates: v |-> from(iV(v) c)
 module FromCoord (Q : FM.Module) (bQ : Tr.Trunc[FF.Based Q].carrier) (g : Nat) (eQ : MS.LinEquiv Q (FM.Free g)) (k : Nat)
  (V : FM.Module) (iV : MS.LinEquiv V FM.regular) (c : Ext g) (dc : DG.Deg g k c) {
  module IQ = TL.Inverse[Q,bQ,g,eQ] ;
  module PQ = TL.Piece[Q,bQ,k] ;
  fun (v : V.M) : PQ.carrier.M =
   (IQ.from.1 (escale g (iV.1.1 v) c),IQ.from-degree k (escale g (iV.1.1 v) c) (HO.deg-scale g k (iV.1.1 v) c dc)) ;
  map : SM.Linear V PQ.carrier = (fun,
   \ x y -> PQ.SB.eq _ _ (trans (ap (\ t -> IQ.from.1 (escale g t c)) (iV.2.1 x y))
    (trans (ap IQ.from.1 (EA.eadd-scale g (iV.1.1 x) (iV.1.1 y) c)) (IQ.from.2.1 (escale g (iV.1.1 x) c) (escale g (iV.1.1 y) c)))),
   \ a x -> PQ.SB.eq _ _ (trans (ap (\ t -> IQ.from.1 (escale g t c)) (iV.2.2 a x))
    (trans (ap IQ.from.1 (sym (EA.escale-scale g a (iV.1.1 x) c))) (IQ.from.2.2.1 a (escale g (iV.1.1 x) c))))) ;
  -- in coordinates, at iV^-1(1): c
  at-unit : Id (Ext g) (IQ.CE.to.1 (map.1 (iV.1.2.sec o)).1) c =
   trans (IQ.to-from (escale g (iV.1.1 (iV.1.2.sec o)) c))
    (trans (ap (\ t -> escale g t c) (iV.1.2.sec-eq o)) (EA.escale-one g c)) ;
 } ;

 module Chain (s : Nat -> Nat) {
  module CH = C85.Chain[s] ;
  module Res (T : Nat) (d : Nat -> Nat) (G : Nat -> FM.Module) (f : (t : Nat) -> SM.Linear (G t) (G (suc t)))
   (bs : Tr.Trunc[(t : Nat) -> MS.LinEquiv (G t) (FM.Free (d t))].carrier)
   (hd : (t : Nat) -> C85.lt t (suc T) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)))
   (cz : (t : Nat) -> C85.lt t (suc T) -> FM.ComposeZeroL (G t) (G (suc t)) (G (suc (suc t))) (f t) (f (suc t))) {
   Bs : U l = (t : Nat) -> MS.LinEquiv (G t) (FM.Free (d t)) ;
   bG (t : Nat) : Tr.Trunc[MS.LinEquiv (G t) (FM.Free (d t))].carrier = TC.map Bs (MS.LinEquiv (G t) (FM.Free (d t))) (\ es -> es t) bs ;
   bb (t : Nat) : Tr.Trunc[FF.Based (G t)].carrier = TC.map Bs (FF.Based (G t)) (\ es -> (d t,es t)) bs ;
   -- the lines
   module TopP (t : Nat) { module P = TL.Piece[G (suc t),bb (suc t),plus (CH.rk (suc t)) (CH.rk t)] ; } ;
   Lns : Nat -> FM.Module = split { zero -> FM.regular ; suc t | r -> SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) r } ;
   module TargetP (t : Nat) { module P = TL.Piece[G (suc t),bb (suc t),CH.rk t] ; } ;
   module U0 = Unit[G (suc zero),bb (suc zero)] ;
   lines : (t : Nat) -> C85.lt t (suc T) -> LN.Line (Lns t) = split {
    zero -> \ h -> Tr.Trunc[MS.LinEquiv FM.regular FM.regular].inc id-line ;
    suc t | r -> \ h -> LN.hom-line (Lns t) (TopP[t].P.carrier) (r (C85.lt-pred t (suc T) h))
     TL.Top[G (suc t),bb (suc t),plus (CH.rk (suc t)) (CH.rk t),d (suc t),hd t (C85.lt-pred t (suc T) h),bG (suc t)].line } ;

   -- structures
   Mid : U l = (t : Nat) -> C85.lt t T -> SM.Linear (SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) (Lns t)) (TargetP[suc t].P.carrier) ;
   LastMap : U l = SM.Linear (SS.RkOf (G (suc T)) (bb (suc T)) (CH.rk (suc T)) (CH.rk T) (Lns T)) (TargetP[suc T].P.carrier) ;
   prev (as : Mid) : (t : Nat) -> C85.lt t (suc T) -> SM.Linear (Lns t) (TargetP[t].P.carrier) = split {
    zero -> \ h -> U0.map ;
    suc t -> \ h -> as t h } ;
   -- the stage at f (t+1), with a' = a_t
   module St (as : Mid) (t : Nat) (h : C85.lt t (suc T)) {
    module S = SS.Stage[G (suc t),G (suc (suc t)),bb (suc t),bb (suc (suc t)),f (suc t),CH.rk (suc t),CH.rk t,Lns t,prev as t h] ;
   } ;
   Laws (as : Mid) (last : LastMap) : U l =
    ((t : Nat) (h : C85.lt t T) -> St[as,t,C85.lt-pred t (suc T) h].S.Star (as t h)) *
    (St[as,T,C85.lt-self T].S.Star last *
     ((t : Nat) (h : C85.lt t (suc T)) -> St[as,t,h].S.Regular)) ;
   Structure : U l = (m : Mid * LastMap) * Laws m.1 m.2 ;
   laws-prop (as : Mid) (last : LastMap) : Pr.isProp (Laws as last) =
    HO.prod-prop ((t : Nat) (h : C85.lt t T) -> St[as,t,C85.lt-pred t (suc T) h].S.Star (as t h))
     (St[as,T,C85.lt-self T].S.Star last * ((t : Nat) (h : C85.lt t (suc T)) -> St[as,t,h].S.Regular))
     (F.isProp-Pi Nat (\ t -> (h : C85.lt t T) -> St[as,t,C85.lt-pred t (suc T) h].S.Star (as t h)) (\ t ->
      F.isProp-Pi (C85.lt t T) (\ h -> St[as,t,C85.lt-pred t (suc T) h].S.Star (as t h)) (\ h ->
       St[as,t,C85.lt-pred t (suc T) h].S.star-prop (as t h))))
     (HO.prod-prop (St[as,T,C85.lt-self T].S.Star last) ((t : Nat) (h : C85.lt t (suc T)) -> St[as,t,h].S.Regular)
      (St[as,T,C85.lt-self T].S.star-prop last)
      (F.isProp-Pi Nat (\ t -> (h : C85.lt t (suc T)) -> St[as,t,h].S.Regular) (\ t ->
       F.isProp-Pi (C85.lt t (suc T)) (\ h -> St[as,t,h].S.Regular) (\ h ->
        SS.regular-prop (Lns t) (TargetP[t].P.carrier) (prev as t h))))) ;

   -- two structures agree
   module Agree (u v : Structure) {
    -- (*) at the stage t, with a_t = a'_t, determines a_(t+1)
    step (t : Nat) (h : C85.lt t (suc T)) (e : Id (SM.Linear (Lns t) (TargetP[t].P.carrier)) (prev u.1.1 t h) (prev v.1.1 t h))
     (x y : SM.Linear (SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) (Lns t)) (TargetP[suc t].P.carrier)) (hx : St[u.1.1,t,h].S.Star x) (hy : St[v.1.1,t,h].S.Star y) :
     Id (SM.Linear (SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) (Lns t)) (TargetP[suc t].P.carrier)) x y =
     St[u.1.1,t,h].S.Bases[d (suc t),hd t h,bG (suc t),lines t h].unique (u.2.2.2 t h) x y hx
      (subst (\ a' -> SS.Stage[G (suc t),G (suc (suc t)),bb (suc t),bb (suc (suc t)),f (suc t),CH.rk (suc t),CH.rk t,Lns t,a'].Star y)
       (sym e) hy) ;
    mid : (t : Nat) (h : C85.lt t T) -> Id (SM.Linear (SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) (Lns t)) (TargetP[suc t].P.carrier)) (u.1.1 t h) (v.1.1 t h) = split {
     zero -> \ h -> step zero (C85.lt-pred zero (suc T) h) (refl U0.map) (u.1.1 zero h) (v.1.1 zero h)
      (u.2.1 zero h) (v.2.1 zero h) ;
     suc t | r -> \ h -> step (suc t) (C85.lt-pred (suc t) (suc T) h) (r (C85.lt-pred (suc t) (suc T) h))
      (u.1.1 (suc t) h) (v.1.1 (suc t) h) (u.2.1 (suc t) h) (v.2.1 (suc t) h) } ;
    prev-eq : (t : Nat) (h : C85.lt t (suc T)) -> Id (SM.Linear (Lns t) (TargetP[t].P.carrier)) (prev u.1.1 t h) (prev v.1.1 t h) = split {
     zero -> \ h -> refl U0.map ;
     suc t -> \ h -> mid t h } ;
    mids : Id Mid u.1.1 v.1.1 =
     F.funext Nat (\ t -> (h : C85.lt t T) -> SM.Linear (SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) (Lns t)) (TargetP[suc t].P.carrier)) u.1.1 v.1.1 (\ t ->
      F.funext (C85.lt t T) (\ h -> SM.Linear (SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) (Lns t)) (TargetP[suc t].P.carrier)) (u.1.1 t) (v.1.1 t) (\ h -> mid t h)) ;
    last : Id LastMap u.1.2 v.1.2 =
     step T (C85.lt-self T) (prev-eq T (C85.lt-self T)) u.1.2 v.1.2 u.2.2.1 v.2.2.1 ;
    result : Id Structure u v =
     Pr.Sigma-eq (Mid * LastMap) (\ m -> Laws m.1 m.2) u.1 v.1 u.2 v.2 (ExteriorAlgebra[l].pair-eq mids last) (laws-prop v.1.1 v.1.2) ;
   } ;
   structure-prop : Pr.isProp Structure = \ u v -> Agree[u,v].result ;

   ---------------------------------------------------------------------
   -- existence, with bases
   M (es : Bs) (t : Nat) : MM.Mat (d t) (d (suc t)) = ED.Square[G t,G (suc t),bb t,bb (suc t),f t,d (suc t),es (suc t),d t,es t].A ;
   -- the matrices compose to 0
   module CZ (es : Bs) (t : Nat) (h : C85.lt t (suc T)) {
    module S0 = ED.Square[G t,G (suc t),bb t,bb (suc t),f t,d (suc t),es (suc t),d t,es t] ;
    module S1 = ED.Square[G (suc t),G (suc (suc t)),bb (suc t),bb (suc (suc t)),f (suc t),d (suc (suc t)),es (suc (suc t)),d (suc t),es (suc t)] ;
    module I0 = ED.Inv[G t,FM.Free (d t),es t] ; module I1 = ED.Inv[G (suc t),FM.Free (d (suc t)),es (suc t)] ;
    zero-l : FM.ComposeZeroL (FM.Free (d t)) (FM.Free (d (suc t))) (FM.Free (d (suc (suc t)))) S0.g S1.g = \ x -> calc (MM.Vec (d (suc (suc t)))) {
     S1.g.1 (S0.g.1 x)
      =< ap (\ y -> (es (suc (suc t))).1.1 ((f (suc t)).1 y)) (I1.ret-eq ((f t).1 (I0.inv x)))
      > (es (suc (suc t))).1.1 ((f (suc t)).1 ((f t).1 (I0.inv x)))
      =< ap (es (suc (suc t))).1.1 (cz t h (I0.inv x)) > (es (suc (suc t))).1.1 (G (suc (suc t))).mz
      =< SM.Lin[G (suc (suc t)),FM.Free (d (suc (suc t))),FM.lin (G (suc (suc t))) (FM.Free (d (suc (suc t)))) (es (suc (suc t)))].map-z
      > (FM.Free (d (suc (suc t)))).mz } ;
    result : MM.ComposeZero (d t) (d (suc t)) (d (suc (suc t))) (M es t) (M es (suc t)) =
     FM.compose-zero (d t) (d (suc t)) (d (suc (suc t))) S0.g S1.g zero-l ;
   } ;
   -- cffr's hypotheses, for every choice of bases
   GradeHyp : U l = (es : Bs) (t : Nat) -> C85.lt (suc t) (suc T) ->
    L84.GrTwo (MI.Index (CH.rk (suc t)) (d (suc t)) (d (suc (suc t)))) (MI.minors (CH.rk (suc t)) (d (suc t)) (d (suc (suc t))) (M es (suc t))) ;
   RegHyp : U l = (es : Bs) -> MI.RegularD (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))) (M es (suc T)) ;

   module Center (es : Bs) (gm : GradeHyp) (rg : RegHyp) {
    module DR = DI.Chain[s].Res[T,d,M es,hd,\ t h -> CZ[es,t,h].result,gm es] ;
    module FR = DR.FR ;
    beta (t : Nat) (h : C85.lt t (suc T)) : Ext (d (suc t)) = FR.center.1 t h ;
    module LS = DR.Last[rg es] ;
    -- bases of the lines
    TB (t : Nat) (h : C85.lt t (suc T)) : MS.LinEquiv (TopP[t].P.carrier) FM.regular =
     TL.TopBasis[G (suc t),bb (suc t),plus (CH.rk (suc t)) (CH.rk t),d (suc t),hd t h,es (suc t)].line ;
    iota : (t : Nat) -> C85.lt t (suc T) -> MS.LinEquiv (Lns t) FM.regular = split {
     zero -> \ h -> id-line ;
     suc t | r -> \ h -> LN.HomLine[Lns t,TopP[t].P.carrier,r (C85.lt-pred t (suc T) h),TB t (C85.lt-pred t (suc T) h)].line } ;
    iota-last : MS.LinEquiv (SS.RkOf (G (suc T)) (bb (suc T)) (CH.rk (suc T)) (CH.rk T) (Lns T)) FM.regular = LN.HomLine[Lns T,TopP[T].P.carrier,iota T (C85.lt-self T),TB T (C85.lt-self T)].line ;
    -- the maps
    beta-degree (t : Nat) (h : C85.lt t T) : DG.Deg (d (suc (suc t))) (CH.rk (suc t)) (beta (suc t) h) =
     C85.St[d (suc t),CH.rk (suc t),d (suc (suc t)),M es (suc t),FR.RS.stage (suc t) h].beta-degree ;
    module FC (t : Nat) (h : C85.lt t T) {
     module FM1 = FromCoord[G (suc (suc t)),bb (suc (suc t)),d (suc (suc t)),es (suc (suc t)),CH.rk (suc t),SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) (Lns t),iota (suc t) h,
      beta (suc t) h,beta-degree t h] ;
    } ;
    module FL = FromCoord[G (suc (suc T)),bb (suc (suc T)),d (suc (suc T)),es (suc (suc T)),CH.rk (suc T),SS.RkOf (G (suc T)) (bb (suc T)) (CH.rk (suc T)) (CH.rk T) (Lns T),iota-last,
     LS.FI.gamma,LS.FI.gamma-degree] ;
    as : Mid = \ t h -> FC[t,h].FM1.map ;
    last : LastMap = FL.map ;
    -- the coordinates of the stage at f (t+1)
    module Co (t : Nat) (h : C85.lt t (suc T)) {
     module CS = St[as,t,h].S.Coords[d (suc t),hd t h,es (suc t),d (suc (suc t)),es (suc (suc t)),iota t h] ;
    } ;
    -- b = beta_t
    b-value : (t : Nat) (h : C85.lt t (suc T)) -> Id (Ext (d (suc t))) Co[t,h].CS.b (beta t h) = split {
     zero -> \ h -> U0.at-unit (d (suc zero)) (es (suc zero)) ;
     suc t -> \ h -> FC[t,h].FM1.at-unit } ;
    -- Dictionary's Wedge for (b, c) gives (*)
    module Wd (t : Nat) (h : C85.lt t (suc T)) (a : SM.Linear (SS.RkOf (G (suc t)) (bb (suc t)) (CH.rk (suc t)) (CH.rk t) (Lns t)) (TargetP[suc t].P.carrier)) (c : Ext (d (suc (suc t))))
     (ec : Id (Ext (d (suc (suc t)))) Co[t,h].CS.At[a].c c)
     (w : DI.Stage[d (suc t),d (suc (suc t)),CH.rk (suc t),M es (suc t),beta t h,c].Wedge) {
     wedge : Co[t,h].CS.At[a].DS.Wedge = \ x dx -> trans (w x dx)
      (trans (ap (\ y -> escale (d (suc (suc t))) (top (d (suc t)) (emul (d (suc t)) x y)) c) (sym (b-value t h)))
       (ap (escale (d (suc (suc t))) (top (d (suc t)) (emul (d (suc t)) x Co[t,h].CS.b))) (sym ec))) ;
     star : St[as,t,h].S.Star a = Co[t,h].CS.At[a].from-coords wedge ;
    } ;
    mid-star (t : Nat) (h : C85.lt t T) : St[as,t,C85.lt-pred t (suc T) h].S.Star (as t h) =
     Wd[t,C85.lt-pred t (suc T) h,as t h,beta (suc t) h,FC[t,h].FM1.at-unit,DR.stage-wedge FR.center t h].star ;
    last-star : St[as,T,C85.lt-self T].S.Star last =
     Wd[T,C85.lt-self T,last,LS.FI.gamma,FL.at-unit,LS.last-wedge].star ;
    -- a_t is regular: beta_t is (Cor85)
    regular (t : Nat) (h : C85.lt t (suc T)) : St[as,t,h].S.Regular =
     Co[t,h].CS.reg-from (subst (\ y -> MI.RI.Regular (C.Index (d (suc t))) (CO.coeff (d (suc t)) y)) (sym (b-value t h))
      C85.St[d t,CH.rk t,d (suc t),M es t,FR.RS.stage t h].beta-grade.1) ;
    center : Structure = ((as,last),(mid-star,(last-star,regular))) ;
   } ;

   -- Theorem: the structures form a contractible type
   contractible (gm : GradeHyp) (rg : RegHyp) : FunExtUA[l].isContr Structure =
    Tr.Trunc[Bs].induction @l (\ w -> FunExtUA[l].isContr Structure) (\ w -> Torsor[l].isProp-isContr Structure)
     (\ es -> (Center[es,gm,rg].center,\ v -> structure-prop Center[es,gm,rg].center v)) bs ;
  } ;
 } ;
} ;
