-- The endpoints of sag/etale-classical-global with choice as the only
-- premise beyond univalence and replacement: Global is the classical
-- segment Cl instantiated with lem (Diaconescu) and prime-existence
-- (Krull), both derived from ac.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;

-- primewise good elements give a finite cover  sum_i s_i a_i = 1
module Cover (A : CRing) (setA : Pr.isSet A.R) (G : A.R -> U l) {
 module PC = Global.ClassicalPrimeCover[l].Over[A,setA,G] ;
 theorem (pointwise : PC.Pointwise) : Truncation[l].Trunc[PC.Cover].carrier =
  PC.Given[pointwise].theorem ;
} ;

-- primewise standard etale neighbourhoods give a finite cover by them
module Etale (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R)
 (iota : RingHom[l].Hom A E) {
 module EC = Global.ClassicalEtaleCover[l].Over[A,setA,E,setE,iota] ;
 cover (local : EC.LocalTheorem) : Truncation[l+].Trunc[EC.Global.Cover].carrier =
  EC.Given[local].theorem ;
 flat-cover (local : EC.FlatLocalTheorem) : Truncation[l+].Trunc[EC.FlatGlobal.Cover].carrier =
  EC.GivenFlat[local].theorem ;
 monic-cover (local : EC.MonicLocalTheorem) : Truncation[l+].Trunc[EC.MonicGlobal.Cover].carrier =
  EC.GivenMonic[local].theorem ;
} ;
