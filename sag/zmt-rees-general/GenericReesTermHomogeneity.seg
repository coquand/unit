-- Bridge the natural shifted convention used by finite-fibre sections
-- to the integer term-degree convention used by Rees generators.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module C = CechPolynomialAction[l].Over[A,setA,n] ; module M = ShiftedMatrixAction[l].Over[A,setA,n] ;
 hom (d : Base.Nat) : (ps : C.A.Polys) -> M.HomShift zero d ps -> C.Hom (pos d) ps = split {
  nil -> \ h -> tt ; cons u us | rec -> \ h -> (ap (\ x -> pos x) h.1,rec h.2) } ;
} ;
