-- Scaling coefficients of term lists agrees with the constant scalar
-- action in the constructed polynomial tower; finite polynomial sums
-- are the already proved generic tower products/sums.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module N = FiniteExponents[l] ; module NA = NatArith[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar : Nat) {
 module B = PolynomialTowerBridge[l].Over[A,setA] ; module T = B.T ;
 module P = PolynomialTowerProducts[l].Over[A,setA,nvar] ; module FA = P.FA ;
 module X = LaurentExponentBridge[l].At[nvar] ;
 scale (c : A.R) : List (B.Term nvar) -> List (B.Term nvar) = split {
   nil -> nil ; cons u us | rec -> cons (A.mul c u.1,u.2) rec } ;
 add-zero (u : N.Exp nvar) : Id (N.Exp nvar) (X.addN u (N.zeroE nvar)) u =
   N.ext nvar _ _ (\ i -> NA.plus-zero (u i)) ;
 module ScaleStep (c : A.R) (u : B.Term nvar) (us : List (B.Term nvar))
   (rec : Id (List (B.Term nvar)) (FA.scaleT (c,N.zeroE nvar) us) (scale c us)) {
   mid : List (B.Term nvar) = cons (A.mul c u.1,u.2) (FA.scaleT (c,N.zeroE nvar) us) ;
   first : Id (List (B.Term nvar)) (FA.scaleT (c,N.zeroE nvar) (cons u us)) mid =
     ap (\ e -> cons (A.mul c u.1,e) (FA.scaleT (c,N.zeroE nvar) us)) (add-zero u.2) ;
   second : Id (List (B.Term nvar)) mid (scale c (cons u us)) = ap (\ qs -> cons (A.mul c u.1,u.2) qs) rec ;
   result : Id (List (B.Term nvar)) (FA.scaleT (c,N.zeroE nvar) (cons u us)) (scale c (cons u us)) = trans first second ;
 } ;
 scale-agree (c : A.R) : (ps : List (B.Term nvar)) -> Id (List (B.Term nvar)) (FA.scaleT (c,N.zeroE nvar) ps) (scale c ps) = split {
   nil -> refl nil ; cons u us | rec -> ScaleStep[c,u,us,rec].result } ;
 term-zero : (n : Nat) (c : A.R) -> Id (T.D n).R (B.term n (c,N.zeroE n)) ((T.grD n).iota.1 c) = split {
   zero -> \ c -> refl c ; suc n | rec -> \ c -> ap B.Level[n].X.constant (rec c) } ;
 constant (c : A.R) : Id (T.D nvar).R (B.phi nvar (cons (c,N.zeroE nvar) nil)) ((T.grD nvar).iota.1 c) =
   trans ((T.D nvar).addZ (B.term nvar (c,N.zeroE nvar))) (term-zero nvar c) ;
 phi-scale (c : A.R) (ps : List (B.Term nvar)) :
   Id (T.D nvar).R (B.phi nvar (scale c ps)) ((T.D nvar).mul ((T.grD nvar).iota.1 c) (B.phi nvar ps)) =
   trans (ap (B.phi nvar) (sym (scale-agree c ps)))
     (trans (sym (trans (P.append (FA.scaleT (c,N.zeroE nvar) ps) nil)
       ((T.D nvar).addZ (B.phi nvar (FA.scaleT (c,N.zeroE nvar) ps)))))
       (trans (P.product (cons (c,N.zeroE nvar) nil) ps)
         (ap (\ x -> (T.D nvar).mul x (B.phi nvar ps)) (constant c)))) ;
} ;
