-- A fixed finite bihomogeneous KG list, term representatives and explicit
-- factorisation of every evaluated KG through the ORIGINAL equations P.
-- All finite representative choices remain under truncation.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (nvar t : Nat) (b0 : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module BR = GenericReesRepresentatives[l].Over[A,setA,nvar,t,b0,s,p,e,hp] ; module X = BR.X ; module RR = X.RR ;
 module WC = RR.WithCFN[K0,cfnA] ; module RK = RR.RK ; module HR = HomogeneousRepresentatives[l].Over[A,setA,nvar] ;
 module PA = PolynomialTowerProducts[l].Over[A,setA,nvar] ;
 module Fixed (w : WC.ReesW) (fw : WC.WithGens[w].F.FixedW) {
   module F = WC.WithGens[w].F ; module K = F.KG[fw] ;
   dX (j : Ps.Fin K.na) : Base.Nat = (K.ix j).2.2 ;
   dU (j : Ps.Fin K.na) : Base.Nat = CoefficientParts[l].toB (K.ix j).2.1 ;
   Representatives : U l = (j : Ps.Fin K.na) -> BR.Rep (dU j) (dX j) (K.kg j) ;
   representatives : Tr.Trunc[Representatives].carrier = FinCat[l].fchoice K.na
     (\ j -> BR.Rep (dU j) (dX j) (K.kg j)) (\ j -> BR.bihomogeneous (K.ix j).2.1 (dX j) (K.kg j) (K.kg-bihom j)) ;
   Certs : U l = (k : Ps.Fin F.GC.L) -> RK.CertW (F.GC.LG.elem w.1 k) ;
   certs : Tr.Trunc[Certs].carrier = FinCat[l].fchoice F.GC.L (\ k -> RK.CertW (F.GC.LG.elem w.1 k))
     (\ k -> RK.cert (F.GC.LG.elem w.1 k) (ReesFiniteList4[l].all-elem RR.R (RK.SQ.blk (suc zero)) RK.Elim w.1 w.2.1 k)) ;
   module Chosen (reps : Representatives) {
     gD (j : Ps.Fin K.na) : List (X.BD.Term nvar) = (reps j).1 ;
     hgD (j : Ps.Fin K.na) : BR.HomX (dX j) (gD j) = (reps j).2.1 ;
     hfD (j : Ps.Fin K.na) : BR.BA.CoefHom (dU j) (gD j) = (reps j).2.2.1 ;
     phi-gen (j : Ps.Fin K.na) : Id X.DX.R (X.BD.phi nvar (gD j)) (X.psi.1 (K.kg j)) = (reps j).2.2.2 ;
     gA (j : Ps.Fin K.na) : List (RR.BR.Term nvar) = X.evT (gD j) ;
     eval-gen (j : Ps.Fin K.na) : Id RR.S.R (RR.BR.phi nvar (gA j)) (RK.RG.ev (K.kg j)) =
       trans (sym (X.eval-eta-polynomial (gD j)))
         (ap RK.RG.ev (trans (ap X.eta.1 (phi-gen j)) (X.eta-psi (K.kg j)))) ;
     module Certificates (ws : Certs) {
       HX (j : Ps.Fin K.na) (q : Ps.Fin s) : RR.S.R = RR.RC.HX (K.gen j) (ws (K.ix j).1) (K.ix j).2.1 (dX j) q ;
       hx (j : Ps.Fin K.na) (q : Ps.Fin s) : RR.GXL.Hom (PolynomialAction4[l].minus (pos (dX j)) (e q)) (HX j q) =
         subst (\ d -> RR.GXL.Hom d (HX j q)) (sub-pos (pos (dX j)) (e q)) (K.kg-hom-HX j (ws (K.ix j).1) q) ;
       HReps : U l = (q : Ps.Fin s) (j : Ps.Fin K.na) -> HR.ShiftedRep (e q) (dX j) (HX j q) ;
       hrepresentatives : Tr.Trunc[HReps].carrier = FinCat[l].fchoice s
         (\ q -> (j : Ps.Fin K.na) -> HR.ShiftedRep (e q) (dX j) (HX j q))
         (\ q -> FinCat[l].fchoice K.na (\ j -> HR.ShiftedRep (e q) (dX j) (HX j q))
           (\ j -> HR.shifted-representative (e q) (dX j) (HX j q) (hx j q))) ;
       module Factorized (hr : HReps) {
         h (q : Ps.Fin s) (j : Ps.Fin K.na) : List (RR.BR.Term nvar) = (hr q j).1 ;
         hh (q : Ps.Fin s) (j : Ps.Fin K.na) : HR.HomShift (e q) (dX j) (h q j) = (hr q j).2.2 ;
         hphi (q : Ps.Fin s) (j : Ps.Fin K.na) : Id RR.S.R (RR.BR.phi nvar (h q j)) (HX j q) = (hr q j).2.1 ;
         phi-factor (j : Ps.Fin K.na) : Id RR.S.R (RR.BR.phi nvar (gA j))
           (RR.BR.phi nvar (PA.FA.psum s (\ q -> PA.FA.pmul (p q) (h q j)))) =
           trans (eval-gen j) (trans (K.kg-certX j (ws (K.ix j).1))
             (trans (RR.RK.RSB.sum-cong s (\ q -> RR.S.mul (HX j q) (RR.P q))
               (\ q -> RR.S.mul (RR.BR.phi nvar (p q)) (RR.BR.phi nvar (h q j)))
               (\ q -> trans (RR.S.mulC (HX j q) (RR.P q)) (ap (RR.S.mul (RR.P q)) (sym (hphi q j)))))
               (trans (PA.SS.sum-cong s _ _ (\ q -> sym (PA.product (p q) (h q j))))
                 (sym (PA.sum s (\ q -> PA.FA.pmul (p q) (h q j))))))) ;
         factor (j : Ps.Fin K.na) (v : FiniteExponents[l].Exp nvar) :
           Id A.R (PA.FA.coef (gA j) v) (PA.FA.coef (PA.FA.psum s (\ q -> PA.FA.pmul (p q) (h q j))) v) =
           trans (sym (PolynomialActionTowerComparison[l].Over[A,setA,nvar].coefficient-ring (gA j) v))
             (trans (ap (\ x -> RR.BR.Coeff nvar x v) (phi-factor j))
               (PolynomialActionTowerComparison[l].Over[A,setA,nvar].coefficient-ring
                 (PA.FA.psum s (\ q -> PA.FA.pmul (p q) (h q j))) v)) ;
       } ;
     } ;
   } ;
 } ;
 Data : U l = (w : WC.ReesW) * ((fw : WC.WithGens[w].F.FixedW) *
   ((reps : Fixed[w,fw].Representatives) * ((ws : Fixed[w,fw].Certs) *
     Fixed[w,fw].Chosen[reps].Certificates[ws].HReps))) ;
 module ForFixed (w : WC.ReesW) (fw : WC.WithGens[w].F.FixedW) {
   module F = Fixed[w,fw] ;
   from-reps (reps : F.Representatives) : Tr.Trunc[Data].carrier =
     TC.bind F.Certs Data (\ ws -> TC.map F.Chosen[reps].Certificates[ws].HReps Data
       (\ hr -> (w,(fw,(reps,(ws,hr))))) F.Chosen[reps].Certificates[ws].hrepresentatives) F.certs ;
   constructed : Tr.Trunc[Data].carrier = TC.bind F.Representatives Data from-reps F.representatives ;
 } ;
 constructed : Tr.Trunc[Data].carrier = TC.bind WC.ReesW Data
   (\ w -> TC.bind WC.WithGens[w].F.FixedW Data (\ fw -> ForFixed[w,fw].constructed) WC.WithGens[w].F.fixed) WC.presentation ;
} ;
