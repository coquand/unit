-- Coefficient evaluation commutes with zero extension to Laurent exponents.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module L = GenericLaurent[l] ; module LP = LaurentPolynomialCoefficients[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (f : RH.Hom A B) (n : Nat) {
 module P = PolynomialCoefficientNaturality[l].Over[A,B,setA,setB,f] ;
 module LA = LP.Over[A,setA].At[n] ; module LB = LP.Over[B,setB].At[n] ;
 cases (qs : List (P.N.PA.Term n)) (m : L.Exp n) : (sg : LP.Sign n m) ->
  Id B.R (f.1 (LA.read (P.N.PA.phi n qs) m sg)) (LB.read (P.N.PB.phi n (P.N.mapT n qs)) m sg) = split {
   inl pp -> P.polynomial n qs pp.1 ; inr pp -> RH.zero A B f } ;
 equation (qs : List (P.N.PA.Term n)) (m : L.Exp n) :
  Id B.R (f.1 (LA.coeff (P.N.PA.phi n qs) m)) (LB.coeff (P.N.PB.phi n (P.N.mapT n qs)) m) = cases qs m (LP.classify n m) ;
} ;
