-- Explicit image witnesses and ideal-power images for a constructed linear map.
-- Chart and Cech wrappers instantiate this same quotient bookkeeping.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (t : Nat) (a : Ps.Fin t -> A.R)
 (Source Target : IP.Mod[A]) (action : IP.Lin[A,Source,Target]) {
 module ML = IP.ModL[A,Target] ;
 module LJ = RelationCertificate[l].LinL[A,Source,Target,action] ;
 module FC = FiniteIdealPowers[l].Over[A,Target,t,a] ;
 module FA = FiniteIdealPowers[l].Over[A,IP.regular A,t,a] ;
 module S0 = Comb[l].Sums[A,Target] ;
 module BL = Comb[l].Bilinear[A,Target] ;
    -- x in J C(n): x = sum_q P_q y_q, y_q in C(n - e_q)
    JW (x : Target.M) : U l = (y : Source.M) * Id Target.M x (action.f y) ;
    InJ (x : Target.M) : U l = Tr.Trunc[JW x].carrier ;
    in-prop (x : Target.M) : Pr.isProp (InJ x) = Tr.Trunc[JW x].proposition ;
    jw-zero : JW Target.mz = (Source.mz, sym LJ.f-zero) ;
    jw-add (x x' : Target.M) (w : JW x) (w' : JW x') : JW (Target.madd x x') =
      (Source.madd w.1 w'.1, trans (ML.G.cong-add w.2 w'.2) (sym (action.f-add w.1 w'.1))) ;
    jw-neg (x : Target.M) (w : JW x) : JW (Target.mneg x) = (Source.mneg w.1, trans (ap Target.mneg w.2) (sym (LJ.f-neg w.1))) ;
    jw-sub (x x' : Target.M) (w : JW x) (w' : JW x') : JW (ML.msub x x') = jw-add x (Target.mneg x') w (jw-neg x' w') ;
    jw-sm (c : A.R) (x : Target.M) (w : JW x) : JW (Target.sm c x) = (Source.sm c w.1, trans (ap (Target.sm c) w.2) (sym (action.f-sm c w.1))) ;
    in-zero : InJ Target.mz = Tr.Trunc[JW Target.mz].inc jw-zero ;
    in-add (x x' : Target.M) (h : InJ x) (h' : InJ x') : InJ (Target.madd x x') = TC.map2 (JW x) (JW x') (JW (Target.madd x x')) (jw-add x x') h h' ;
    in-neg (x : Target.M) (h : InJ x) : InJ (Target.mneg x) = TC.map (JW x) (JW (Target.mneg x)) (jw-neg x) h ;
    in-sm (c : A.R) (x : Target.M) (h : InJ x) : InJ (Target.sm c x) = TC.map (JW x) (JW (Target.sm c x)) (jw-sm c x) h ;
    in-of (x : Target.M) (w : JW x) : InJ x = Tr.Trunc[JW x].inc w ;

    -- x = x' modulo J
    Cong (x x' : Target.M) : U l = InJ (ML.msub x x') ;
    cong-refl (x : Target.M) : Cong x x = subst InJ (sym (ML.sub-self x)) in-zero ;
    cong-of-id (x x' : Target.M) (h : Id Target.M x x') : Cong x x' = subst (Cong x) h (cong-refl x) ;
    neg-sub (x x' : Target.M) : Id Target.M (Target.mneg (ML.msub x x')) (ML.msub x' x) =
      trans (ML.G.neg-add x (Target.mneg x')) (trans (ap (Target.madd (Target.mneg x)) (ML.G.neg-neg x')) (Target.maddC (Target.mneg x) x')) ;
    cong-sym (x x' : Target.M) (h : Cong x x') : Cong x' x = subst InJ (neg-sub x x') (in-neg (ML.msub x x') h) ;
    sub-chain (x y w : Target.M) : Id Target.M (Target.madd (ML.msub x y) (ML.msub y w)) (ML.msub x w) = calc Target.M {
      Target.madd (Target.madd x (Target.mneg y)) (Target.madd y (Target.mneg w))
        =< sym (Target.maddA x (Target.mneg y) (Target.madd y (Target.mneg w))) > Target.madd x (Target.madd (Target.mneg y) (Target.madd y (Target.mneg w)))
        =< ap (Target.madd x) (Target.maddA (Target.mneg y) y (Target.mneg w)) > Target.madd x (Target.madd (Target.madd (Target.mneg y) y) (Target.mneg w))
        =< ap (\ u -> Target.madd x (Target.madd u (Target.mneg w))) (trans (Target.maddC (Target.mneg y) y) (Target.maddN y))
        > Target.madd x (Target.madd Target.mz (Target.mneg w))
        =< ap (Target.madd x) (ML.G.zl (Target.mneg w)) > ML.msub x w } ;
    cong-trans (x y w : Target.M) (h : Cong x y) (h' : Cong y w) : Cong x w =
      subst InJ (sub-chain x y w) (in-add (ML.msub x y) (ML.msub y w) h h') ;
    cong-add (x x' y y' : Target.M) (h : Cong x x') (h' : Cong y y') : Cong (Target.madd x y) (Target.madd x' y') =
      subst InJ (sym (ML.sub-swap x y x' y')) (in-add (ML.msub x x') (ML.msub y y') h h') ;
    cong-neg (y y' : Target.M) (h : Cong y y') : Cong (Target.mneg y) (Target.mneg y') =
      subst InJ (ML.G.neg-add y (Target.mneg y')) (in-neg (ML.msub y y') h) ;
    cong-sub (x x' y y' : Target.M) (h : Cong x x') (h' : Cong y y') : Cong (ML.msub x y) (ML.msub x' y') =
      cong-add x x' (Target.mneg y) (Target.mneg y') h (cong-neg y y' h') ;
    cong-sm (c : A.R) (x x' : Target.M) (h : Cong x x') : Cong (Target.sm c x) (Target.sm c x') =
      subst InJ (ML.sm-sub c x x') (in-sm c (ML.msub x x') h) ;
    -- an element of J C(n) is 0 modulo J
    cong-zero (x : Target.M) (h : InJ x) : Cong x Target.mz = subst InJ (sym (trans (ap (Target.madd x) ML.G.neg-zero) (Target.maddZ x))) h ;
    zero-cong (x : Target.M) (h : Cong x Target.mz) : InJ x = subst InJ (trans (ap (Target.madd x) ML.G.neg-zero) (Target.maddZ x)) h ;

    ------------------------------------------------------------------------
    -- images of I^k C(S) in C(M)

    IJW (k : Base.Nat) (x : Target.M) : U l = (x' : Target.M) * (FC.Wit k x' * JW (ML.msub x x')) ;
    IJ (k : Base.Nat) (x : Target.M) : U l = Tr.Trunc[IJW k x].carrier ;
    ij-of-wit (k : Base.Nat) (x : Target.M) (w : FC.Wit k x) : IJ k x =
      Tr.Trunc[IJW k x].inc (x, (w, subst JW (sym (ML.sub-self x)) jw-zero)) ;
    -- I^(k+1) C(S) is in I C(S)
    wit-one (k : Base.Nat) (x : Target.M) (w : FC.Wit (suc k) x) : FC.Wit (suc zero) x = (w.1, (\ j -> tt, w.2.2)) ;
    -- I C(S) is closed under + and -
    gen-neg (xs : Ps.Fin t -> Target.M) : Id Target.M (FC.gen (\ j -> Target.mneg (xs j))) (Target.mneg (FC.gen xs)) =
      trans (S0.sum-cong t (\ j -> Target.sm (a j) (Target.mneg (xs j))) (\ j -> Target.mneg (Target.sm (a j) (xs j))) (\ j -> ML.sm-neg (a j) (xs j)))
        (S0.sum-neg t (\ j -> Target.sm (a j) (xs j))) ;
    wit1-add (x y : Target.M) (wx : FC.Wit (suc zero) x) (wy : FC.Wit (suc zero) y) : FC.Wit (suc zero) (Target.madd x y) =
      (\ j -> Target.madd (wx.1 j) (wy.1 j), (\ j -> tt, trans (ML.G.cong-add wx.2.2 wy.2.2) (sym (S0.comb-addv t a wx.1 wy.1)))) ;
    wit1-neg (x : Target.M) (wx : FC.Wit (suc zero) x) : FC.Wit (suc zero) (Target.mneg x) =
      (\ j -> Target.mneg (wx.1 j), (\ j -> tt, trans (ap Target.mneg wx.2.2) (sym (gen-neg wx.1)))) ;
    wit1-sub (x y : Target.M) (wx : FC.Wit (suc zero) x) (wy : FC.Wit (suc zero) y) : FC.Wit (suc zero) (ML.msub x y) =
      wit1-add x (Target.mneg y) wx (wit1-neg y wy) ;
    -- r z for a scalar r in I
    wit1-sm (r : A.R) (wr : FA.Wit (suc zero) r) (z : Target.M) : FC.Wit (suc zero) (Target.sm r z) =
      (\ j -> Target.sm (wr.1 j) z, (\ j -> tt,
        trans (ap (\ c -> Target.sm c z) wr.2.2)
          (trans (BL.sm-sum t (\ j -> A.mul (a j) (wr.1 j)) z)
            (S0.sum-cong t (\ j -> Target.sm (A.mul (a j) (wr.1 j)) z) (\ j -> Target.sm (a j) (Target.sm (wr.1 j) z))
               (\ j -> sym (Target.smA (a j) (wr.1 j) z)))))) ;
    -- classes in I C(M)
    ij-add (x w : Target.M) (h : IJ (suc zero) x) (ww : FC.Wit (suc zero) w) : IJ (suc zero) (Target.madd x w) =
      TC.map (IJW (suc zero) x) (IJW (suc zero) (Target.madd x w))
        (\ v -> (Target.madd v.1 w, (wit1-add v.1 w v.2.1 ww,
                  subst JW (sym (trans (ML.sub-swap x w v.1 w) (trans (ap (Target.madd (ML.msub x v.1)) (ML.sub-self w)) (Target.maddZ (ML.msub x v.1)))))
                    v.2.2))) h ;
    ij-sub (x w : Target.M) (h : IJ (suc zero) x) (ww : FC.Wit (suc zero) w) : IJ (suc zero) (ML.msub x w) =
      ij-add x (Target.mneg w) h (wit1-neg w ww) ;
    ij-cong (x y : Target.M) (c : Cong x y) (h : IJ (suc zero) y) : IJ (suc zero) x =
      TC.map2 (JW (ML.msub x y)) (IJW (suc zero) y) (IJW (suc zero) x)
        (\ w v -> (v.1, (v.2.1, subst JW (sub-chain x y v.1) (jw-add (ML.msub x y) (ML.msub y v.1) w v.2.2)))) c h ;
} ;
