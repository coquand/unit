-- Polynomial coefficients commute with an arbitrary coefficient ring map.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module FP = FinitePolynomial4[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (f : RH.Hom A B) {
 module N = GenericPolynomialNaturality[l].Over[A,B,setA,setB,f] ; module E = FiniteExponents[l] ;
 cf (n : Nat) (v : E.Exp n) : (ps : List (N.PA.Term n)) ->
   Id B.R (f.1 (N.PA.cf n ps v)) (N.PB.cf n (N.mapT n ps) v) = split {
  nil -> RH.zero A B f ;
  cons u us | rec -> trans (f.2.2.1 (FP.sel A u.1 (Id (E.Exp n) u.2 v) (E.dec n u.2 v)) (N.PA.cf n us v))
   (trans (ap (\ z -> B.add z (f.1 (N.PA.cf n us v))) (FP.sel-map A B f.1 (RH.zero A B f) u.1 (Id (E.Exp n) u.2 v) (E.dec n u.2 v))) (ap (B.add (FP.sel B (f.1 u.1) (Id (E.Exp n) u.2 v) (E.dec n u.2 v))) rec)) } ;
 polynomial (n : Nat) (ps : List (N.PA.Term n)) (v : E.Exp n) :
  Id B.R (f.1 (N.PA.Coeff n (N.PA.phi n ps) v)) (N.PB.Coeff n (N.PB.phi n (N.mapT n ps)) v) =
  trans (ap f.1 (N.PA.coeff-phi n ps v)) (trans (cf n v ps) (sym (N.PB.coeff-phi n (N.mapT n ps) v))) ;
} ;
