-- Exact exchange/evaluation maps at the generic Rees rings. Both variable
-- blocks remain finite functions; no coordinate-specific formula occurs.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar t : Nat) (b0 : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar))
 (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module RR = GenericReesRings[l].Rings[A,setA,nvar,t,b0,s,p,e,hp] ;
 module EX = TowerExchange[l].Swap[A,setA,nvar,t] ;
 module DT = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
 D : CRing = DT.D t ; setD : Pr.isSet D.R = DT.setD t ;
 GD : Graded[A,t,D] = DT.grD t ; module GDL = Laws[A,t,D,setD,GD] ;
 module BD = PolynomialTowerBridge[l].Over[D,setD] ; module XD = BD.T ;
 DX : CRing = XD.D nvar ; setDX : Pr.isSet DX.R = XD.setD nvar ;
 GX : Graded[D,nvar,DX] = XD.grD nvar ;
 psi : RH.Hom RR.R DX = EX.forward ; eta : RH.Hom DX RR.R = EX.backward ;
 eta-psi (x : RR.R.R) : Id RR.R.R (eta.1 (psi.1 x)) x = EX.backward-forward x ;
 psi-eta (x : DX.R) : Id DX.R (psi.1 (eta.1 x)) x = EX.forward-backward x ;
 coeff : RH.Hom D RR.R = EX.B.baseMap ;
 eta-base (x : D.R) : Id RR.R.R (eta.1 (GX.iota.1 x)) (coeff.1 x) = EX.B.on-base x ;
 eta-variable (i : Ps.Fin nvar) : Id RR.R.R (eta.1 (GX.var i)) (RR.GU.iota.1 (RR.GX.var i)) = EX.B.on-U i ;
 coeff-base (x : A.R) : Id RR.R.R (coeff.1 (GD.iota.1 x)) (RR.GU.iota.1 (RR.GX.iota.1 x)) =
   EX.B.EX.base t EX.B.aR EX.B.xR x ;
 coeff-variable (j : Ps.Fin t) : Id RR.R.R (coeff.1 (GD.var j)) (RR.GU.var j) = EX.B.EX.variable t EX.B.aR EX.B.xR j ;
 incS : RH.Hom RR.S DX = RH.compose RR.S RR.R DX psi RR.GU.iota ;
 inc-base (x : A.R) : Id DX.R (incS.1 (RR.GX.iota.1 x)) (GX.iota.1 (GD.iota.1 x)) = EX.F.on-A x ;
 inc-variable (i : Ps.Fin nvar) : Id DX.R (incS.1 (RR.GX.var i)) (GX.var i) = EX.F.on-X i ;
 module IncNatural = GenericPolynomialNaturality[l].Over[A,D,setA,setD,GD.iota] ;
 module IN = IncNatural.Given[nvar,incS,inc-base,inc-variable] ;
 liftC : List (RR.BR.Term nvar) -> List (BD.Term nvar) = IncNatural.mapT nvar ;
 inc-polynomial (q : List (RR.BR.Term nvar)) : Id DX.R (incS.1 (RR.BR.phi nvar q)) (BD.phi nvar (liftC q)) = IN.polynomial q ;
 psi-variable (j : Ps.Fin t) : Id DX.R (psi.1 (RR.GU.var j)) (GX.iota.1 (GD.var j)) = EX.F.on-U j ;
 evD : RH.Hom D A = GD.ev b0 ;
 module RG = RR.RK.RG ;
 evCoeff : RH.Hom D RR.S = RH.compose D RR.R RR.S RG.EV.ev coeff ;
 baseEv : RH.Hom D RR.S = RH.compose D A RR.S RR.GX.iota evD ;
 evCoeff-base (x : A.R) : Id RR.S.R (evCoeff.1 (GD.iota.1 x)) (baseEv.1 (GD.iota.1 x)) =
   trans (ap RG.ev (coeff-base x))
     (trans (RR.GU.ev-iota RR.b (RR.GX.iota.1 x)) (sym (ap RR.GX.iota.1 (GD.ev-iota b0 x)))) ;
 evCoeff-variable (j : Ps.Fin t) : Id RR.S.R (evCoeff.1 (GD.var j)) (baseEv.1 (GD.var j)) =
   trans (ap RG.ev (coeff-variable j)) (trans (RR.GU.ev-var RR.b j) (sym (ap RR.GX.iota.1 (GD.ev-var b0 j)))) ;
 evCoeff-path : Id (RH.Hom D RR.S) evCoeff baseEv =
   TowerUniversal[l].Over[A,RR.S,setA,RR.setS].ext t evCoeff baseEv evCoeff-base evCoeff-variable ;
 evCoeff-at (x : D.R) : Id RR.S.R (RG.ev (coeff.1 x)) (RR.GX.iota.1 (evD.1 x)) = ap (\ h -> h.1 x) evCoeff-path ;
 evalEta : RH.Hom DX RR.S = RH.compose DX RR.R RR.S RG.EV.ev eta ;
 evalEta-base (x : D.R) : Id RR.S.R (evalEta.1 (GX.iota.1 x)) (RR.GX.iota.1 (evD.1 x)) =
   trans (ap RG.ev (eta-base x)) (evCoeff-at x) ;
 evalEta-variable (i : Ps.Fin nvar) : Id RR.S.R (evalEta.1 (GX.var i)) (RR.GX.var i) =
   trans (ap RG.ev (eta-variable i)) (RR.GU.ev-iota RR.b (RR.GX.var i)) ;
 module EvNatural = GenericPolynomialNaturality[l].Over[D,A,setD,setA,evD] ;
 module EN = EvNatural.Given[nvar,evalEta,evalEta-base,evalEta-variable] ;
 evT : List (BD.Term nvar) -> List (RR.BR.Term nvar) = EvNatural.mapT nvar ;
 eval-eta-polynomial (q : List (BD.Term nvar)) : Id RR.S.R (RG.ev (eta.1 (BD.phi nvar q))) (RR.BR.phi nvar (evT q)) = EN.polynomial q ;
 module GL = RR.RC.GL ;
 coeff-base-hom (x : A.R) : GL.Hom zeroZ (coeff.1 (GD.iota.1 x)) =
   subst (GL.Hom zeroZ) (sym (coeff-base x)) (GL.hom-iota (RR.GX.iota.1 x)) ;
 coeff-variable-hom (j : Ps.Fin t) : GL.Hom (pos (suc zero)) (coeff.1 (GD.var j)) =
   subst (GL.Hom (pos (suc zero))) (sym (coeff-variable j)) (RR.GU.var-hom j) ;
 module GH = GradedHomogeneousMap[l].Over[A,RR.S,t,D,RR.R,setD,RR.setR,GD,t,RR.GU,coeff,coeff-base-hom,coeff-variable-hom] ;
 coeff-hom (n : Base.Nat) (x : D.R) (hx : GDL.Hom (pos n) x) : GL.Hom (pos n) (coeff.1 x) = GH.homogeneous n x hx ;
} ;
