-- Elimination gives membership in the fixed KG ideal after block exchange.
-- No flatness theorem is used; finite witnesses are mapped by a ring map.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (nvar t : Nat) (b0 : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module L = GenericReesList[l].Over[K0,A,setA,cfnA,nvar,t,b0,s,p,e,hp] ;
 module X = L.X ; module RR = X.RR ; module RK = RR.RK ; module B = X.BD ;
 module PH = GenericReesPolynomialHom[l].Over[A,setA,nvar,t,b0,s,p,e,hp] ;
 module SS = Comb[l].Sums[X.DX,IdealPowers[l].regular X.DX] ; module HS = CoefficientParts[l].HomSum[RR.R,X.DX,X.psi] ;
 module Fixed (w : L.WC.ReesW) (fw : L.WC.WithGens[w].F.FixedW) (reps : L.Fixed[w,fw].Representatives) {
   module F = L.Fixed[w,fw] ; module C = F.Chosen[reps] ; module K = F.K ;
   gs (j : Ps.Fin K.na) : X.DX.R = B.phi nvar (C.gD j) ;
   module FC = ReesComponents4[l].ReesFinComb[X.DX,Ps.Fin K.na,gs] ;
   gen-map (j : Ps.Fin K.na) : Id X.DX.R (X.psi.1 (K.kg j)) (gs j) = sym (C.phi-gen j) ;
   map-witness (x : RR.R.R) (v : K.FK.CombW x) : FC.CombW (X.psi.1 x) =
    (v.1,(v.2.1,(\ i -> X.psi.1 (v.2.2.1 i),
     trans (ap X.psi.1 v.2.2.2)
      (trans (HS.map-sum v.1 (\ i -> RR.R.mul (v.2.2.1 i) (K.kg (v.2.1 i))))
       (SS.sum-cong v.1 (\ i -> X.psi.1 (RR.R.mul (v.2.2.1 i) (K.kg (v.2.1 i)))) (\ i -> X.DX.mul (X.psi.1 (v.2.2.1 i)) (gs (v.2.1 i))) (\ i -> trans (X.psi.2.2.2 (v.2.2.1 i) (K.kg (v.2.1 i)))
          (ap (X.DX.mul (X.psi.1 (v.2.2.1 i))) (gen-map (v.2.1 i))))))))) ;
   map-membership (x : RR.R.R) (hx : K.FK.InComb x) : FC.InComb (X.psi.1 x) =
    TC.map (K.FK.CombW x) (FC.CombW (X.psi.1 x)) (map-witness x) hx ;
   membership (k : Base.Nat) (q : List (B.Term nvar)) (hq : PH.CoefHom k nvar q)
     (hj : RK.InJ (RR.BR.phi nvar (X.evT q))) : FC.InComb (B.phi nvar q) =
    FC.in-cong (X.psi.1 (X.eta.1 (B.phi nvar q))) (B.phi nvar q) (X.psi-eta (B.phi nvar q))
     (map-membership (X.eta.1 (B.phi nvar q))
       (K.kernel-elim (RK.ub (X.eta.1 (B.phi nvar q)))
         (RK.elim-of-hom k (X.eta.1 (B.phi nvar q)) (PH.eta-phi-hom k q hq)
           (subst RK.InJ (sym (X.eval-eta-polynomial q)) hj)))) ;
   module GI = RegularIdeal[l].Generated[X.DX,K.na,gs] ;
   ideal-sum : (k : Nat) (xs : Ps.Fin k -> X.DX.R) -> ((i : Ps.Fin k) -> GI.In (xs i)) -> GI.In (SS.sum k xs) = split {
    zero -> \ xs h -> GI.ideal.in-zero ;
    suc k | rec -> \ xs h -> GI.ideal.in-add (xs (inr tt)) (SS.sum k (\ i -> xs (inl i)))
      (h (inr tt)) (rec (\ i -> xs (inl i)) (\ i -> h (inl i))) } ;
   ideal-witness (x : X.DX.R) (v : FC.CombW x) : GI.In x = subst GI.In (sym v.2.2.2)
    (ideal-sum v.1 (\ i -> X.DX.mul (v.2.2.1 i) (gs (v.2.1 i)))
      (\ i -> GI.ideal.in-mul (v.2.2.1 i) (gs (v.2.1 i)) (GI.generator (v.2.1 i)))) ;
   fixed-membership (k : Base.Nat) (q : List (B.Term nvar)) (hq : PH.CoefHom k nvar q)
     (hj : RK.InJ (RR.BR.phi nvar (X.evT q))) : GI.In (B.phi nvar q) =
    TC.rec (FC.CombW (B.phi nvar q)) @l (GI.In (B.phi nvar q)) (GI.in-prop (B.phi nvar q))
      (ideal-witness (B.phi nvar q)) (membership k q hq hj) ;
 } ;
} ;
