-- Termwise coefficient homogeneity passes to all Laurent coefficients.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module LG = Logic[l] ; module FP = FinitePolynomial4[l] ;
module L = GenericLaurent[l] ; module LP = LaurentPolynomialCoefficients[l] ;
module Over (A : CRing) (t : Nat) (D : CRing) (setD : Pr.isSet D.R) (G : Graded[A,t,D]) (n : Nat) {
 module B = PolynomialTowerBridge[l].Over[D,setD] ; module GL = Laws[A,t,D,setD,G] ;
 module BA = GenericBihomogeneousAction[l].Over[A,t,D,setD,G,n] ; module LC = LP.Over[D,setD].At[n] ;
 module E = FiniteExponents[l] ;
 selected (k : Int) (c : D.R) (hc : GL.Hom k c) (P : U l) : (dec : LG.Dec P) -> GL.Hom k (FP.sel D c P dec) = split {
  yes h -> hc ; no ne -> GL.hom-zero k } ;
 cf (k : Base.Nat) (v : E.Exp n) : (qs : List (B.Term n)) -> BA.CoefHom k qs -> GL.Hom (pos k) (B.cf n qs v) = split {
  nil -> \ h -> GL.hom-zero (pos k) ;
  cons u us | rec -> \ h -> GL.hom-add (pos k) (FP.sel D u.1 (Id (E.Exp n) u.2 v) (E.dec n u.2 v)) (B.cf n us v)
    (selected (pos k) u.1 h.1 (Id (E.Exp n) u.2 v) (E.dec n u.2 v)) (rec h.2) } ;
 natural (k : Base.Nat) (qs : List (B.Term n)) (hq : BA.CoefHom k qs) (v : E.Exp n) : GL.Hom (pos k) (B.Coeff n (B.phi n qs) v) =
  subst (GL.Hom (pos k)) (sym (B.coeff-phi n qs v)) (cf k v qs hq) ;
 cases (k : Base.Nat) (qs : List (B.Term n)) (hq : BA.CoefHom k qs) (m : L.Exp n) :
  (sg : LP.Sign n m) -> GL.Hom (pos k) (LC.read (B.phi n qs) m sg) = split {
   inl pp -> natural k qs hq pp.1 ; inr pp -> GL.hom-zero (pos k) } ;
 homogeneous (k : Base.Nat) (qs : List (B.Term n)) (hq : BA.CoefHom k qs) (m : L.Exp n) : GL.Hom (pos k) (LC.coeff (B.phi n qs) m) =
   cases k qs hq m (LP.classify n m) ;
} ;
