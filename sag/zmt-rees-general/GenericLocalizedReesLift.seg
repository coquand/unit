-- Homogeneous fixed-KG coefficients for an arbitrary chart intersection.
-- Project the polynomial ideal witness, then translate back by exactly the
-- common denominator already used for elimination membership.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module E = FiniteExponents[l] ; module L = GenericLaurent[l] ;
module GS = GenericSupport[l] ; module CD = ChartDenominators[l] ; module XB = LaurentExponentBridge[l] ; module PA = PolynomialAction4[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (nvar t : Nat) (b0 : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module LM = GenericLocalizedReesMembership[l].Over[K0,A,setA,cfnA,nvar,t,b0,s,p,e,hp] ; module X = LM.X ;
 module T = X.BD.T ; module DG = PolynomialDegreeBridge[l].Over[X.D,X.setD] ;
 module GL = Laws[X.D,nvar,X.DX,X.setDX,X.GX] ;
 module LS = LocalizedSyzygies[l].Over[X.D,X.setD,nvar] ; module LC = LS.LC ; module FA = LS.FA ; module SS = LS.SS ;
 module CB = ClearingCoefficientBridge[l].Over[X.D,X.setD] ; module V = XB.At[nvar] ;
 hom-phi (dd : Base.Nat) : (ps : List (X.BD.Term nvar)) -> LM.PM.L.BR.HomX dd ps -> GL.Hom (pos dd) (X.BD.phi nvar ps) = split {
  nil -> \ h -> GL.hom-zero (pos dd) ;
  cons u us | rec -> \ h -> GL.hom-add (pos dd) (X.BD.term nvar u) (X.BD.phi nvar us)
    (subst (\ k -> GL.Hom k (X.BD.term nvar u)) h.1 (DG.term-hom nvar u)) (rec h.2) } ;
 module Fixed (w : LM.PM.L.WC.ReesW) (fw : LM.PM.L.WC.WithGens[w].F.FixedW) (reps : LM.PM.L.Fixed[w,fw].Representatives) {
  module M = LM.PM.Fixed[w,fw,reps] ; module F = M.F ; module K = F.K ; module C = M.C ;
  hg (j : Ps.Fin K.na) : GL.Hom (pos (F.dX j)) (M.gs j) = hom-phi (F.dX j) (C.gD j) (C.hgD j) ;
  module Chart (chart : Sub nvar) (support : List (L.Exp nvar)) (k : Base.Nat) (twist : Int)
   (f : L.Exp nvar -> X.D.R)
   (fs : (m : L.Exp nvar) -> Not (L.Mem (L.Exp nvar) m support) -> Id X.D.R (f m) X.D.z)
   (fv : (m : L.Exp nvar) -> GS.bad nvar (L.mask nvar m) chart -> Id X.D.R (f m) X.D.z)
   (fh : (m : L.Exp nvar) -> X.GDL.Hom (pos k) (f m))
   (fx : (m : L.Exp nvar) -> Not (Id Int (L.total nvar m) twist) -> Id X.D.R (f m) X.D.z)
   (v : Ps.Fin s -> L.Exp nvar -> A.R)
   (vs : (q : Ps.Fin s) (m : L.Exp nvar) -> Not (L.Mem (L.Exp nvar) m support) -> Id A.R (v q m) A.z)
   (vv : (q : Ps.Fin s) (m : L.Exp nvar) -> GS.bad nvar (L.mask nvar m) chart -> Id A.R (v q m) A.z)
   (eq : (m : L.Exp nvar) -> Id A.R (X.evD.1 (f m)) (LM.FA.RS.sum s (\ q -> LM.FA.mulP (p q) (v q) m))) {
   module P = LM.Chart[chart,support,k,f,fs,fv,fh,v,vs,vv,eq] ;
   module B = CB.Clear[nvar,chart,support,f,fs,fv] ;
   raised : Int = addP twist (E.degree nvar P.C.C.u) ;
   homogeneous : GL.Hom raised P.C.cleared = P.C.Degree[twist,fx].homogeneous ;
   Coordinates : U l = M.GI.S.Coordinates K.na M.gs P.C.cleared ;
   regular-sum : (a : Nat) (xs : Ps.Fin a -> X.DX.R) -> Id X.DX.R (M.GI.S.sum a xs) (SS.sum a xs) = split {
    zero -> \ xs -> refl X.DX.z ; suc a | rec -> \ xs -> ap (X.DX.add (xs (inr tt))) (rec (\ i -> xs (inl i))) } ;
   module From (co : Coordinates) {
    z (j : Ps.Fin K.na) : X.DX.R = X.GX.pr (PA.minus raised (F.dX j)) (co.1 j) ;
    hz (j : Ps.Fin K.na) : GL.Hom (PA.minus raised (F.dX j)) (z j) = GL.hom-pr (PA.minus raised (F.dX j)) (co.1 j) ;
    sum-equation : Id X.DX.R (SS.sum K.na (\ j -> X.DX.mul (M.gs j) (z j))) P.C.cleared =
     trans (SS.sum-cong K.na _ _ (\ j -> sym (GL.pr-mul-pos-left raised (F.dX j) (M.gs j) (co.1 j) (hg j))))
      (trans (sym (GL.pr-sum raised K.na (\ j -> X.DX.mul (M.gs j) (co.1 j))))
       (trans (ap (X.GX.pr raised) (trans (sym (regular-sum K.na (\ j -> X.DX.mul (M.gs j) (co.1 j)))) co.2)) homogeneous)) ;
    value (j : Ps.Fin K.na) (m : L.Exp nvar) : X.D.R = LC.coeff (z j) (CD.up nvar m P.C.C.u) ;
    chart-van (j : Ps.Fin K.na) (m : L.Exp nvar) (bad : GS.bad nvar (L.mask nvar m) chart) : Id X.D.R (value j m) X.D.z =
     P.C.inverse-van (LC.coeff (z j)) (LC.coeff-neg (z j)) m bad ;
    degree (j : Ps.Fin K.na) (m : L.Exp nvar) (ne : Not (Id Int (L.total nvar m) (PA.minus twist (F.dX j)))) : Id X.D.R (value j m) X.D.z =
     LC.Degree[PA.minus raised (F.dX j),z j,hz j].homogeneous (CD.up nvar m P.C.C.u) (\ eq -> ne
       (PA.addP-inj (L.total nvar m) (PA.minus twist (F.dX j)) (E.degree nvar P.C.C.u)
        (trans (sym (XB.deg-add nvar m P.C.C.u)) (trans eq (sym (PA.addP-minus twist (F.dX j) (E.degree nvar P.C.C.u))))))) ;
    Support (j : Ps.Fin K.na) : U l = (ms : List (L.Exp nvar)) * ((m : L.Exp nvar) -> Not (L.Mem (L.Exp nvar) m ms) -> Id X.D.R (value j m) X.D.z) ;
    module Supp (j : Ps.Fin K.na) (sw : LC.Support (z j)) {
     ms : List (L.Exp nvar) = ChartPolynomialization[l].mapL (L.Exp nvar) (L.Exp nvar) (\ m -> CD.down nvar m P.C.C.u) sw.1 ;
     module MM = LocalizedSyzygies[l].MapLaurentMembers[nvar,\ m -> CD.down nvar m P.C.C.u] ;
     vanish (m : L.Exp nvar) (out : Not (L.Mem (L.Exp nvar) m ms)) : Id X.D.R (value j m) X.D.z =
      sw.2 (CD.up nvar m P.C.C.u) (\ h -> out (subst (\ x -> L.Mem (L.Exp nvar) x ms) (CD.down-up nvar m P.C.C.u)
        (MM.member sw.1 (CD.up nvar m P.C.C.u) h))) ;
     witness : Support j = (ms,vanish) ;
    } ;
    finite (j : Ps.Fin K.na) : Tr.Trunc[Support j].carrier = TC.map (LC.Support (z j)) (Support j) (\ sw -> Supp[j,sw].witness) (LC.finite (z j)) ;
    equation (m : L.Exp nvar) : Id X.D.R (FA.RS.sum K.na (\ j -> FA.mulP (C.gD j) (value j) m)) (f m) =
     trans (FA.RS.sum-cong K.na (\ j -> FA.mulP (C.gD j) (value j) m) (\ j -> FA.mulP (C.gD j) (LC.coeff (z j)) (CD.up nvar m P.C.C.u)) (\ j -> FA.mulP-shift (\ x -> CD.up nvar x P.C.C.u)
       (\ x u -> V.sub-add-comm x u P.C.C.u) (C.gD j) (LC.coeff (z j)) m))
      (trans (FA.RS.sum-cong K.na (\ j -> FA.mulP (C.gD j) (LC.coeff (z j)) (CD.up nvar m P.C.C.u)) (\ j -> LC.coeff (X.DX.mul (M.gs j) (z j)) (CD.up nvar m P.C.C.u)) (\ j -> LS.TA.action (C.gD j) (z j) (CD.up nvar m P.C.C.u)))
       (trans (sym (LS.coeff-sum (CD.up nvar m P.C.C.u) K.na (\ j -> X.DX.mul (M.gs j) (z j))))
        (trans (ap (\ x -> LC.coeff x (CD.up nvar m P.C.C.u)) sum-equation)
         (trans (B.equation (CD.up nvar m P.C.C.u)) (ap f (CD.down-up nvar m P.C.C.u)))))) ;
   } ;
   membership : Tr.Trunc[Coordinates].carrier = P.Fixed[w,fw,reps].membership ;
  } ;
 } ;
} ;
