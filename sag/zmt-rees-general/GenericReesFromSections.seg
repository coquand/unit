-- Unconditional Rees comparison and finite correction from explicit
-- finite-fibre sections. KG, all localized memberships and the sequence
-- lifts are constructed here and eliminated into the final truncation.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module L = GenericLaurent[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Kd = GenericDegree[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (extra t : Nat) (b : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term (plus extra (suc (suc (suc zero)))))) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,plus extra (suc (suc (suc zero)))].Hom (pos (e q)) (p q)) {
 module R = GenericReesCorrection[l].Over[K0,A,setA,cfnA,extra,t,b,s,p,e,hp] ;
 module EV = R.EV ; module J = R.J ; module Q0 = R.CJ0 ; module Q1 = R.CJ1 ;
 module PL = GenericReesPowerLift[l].Over[A,setA,t,R.X.D,R.X.setD,R.X.GD,b,R.nvar].Chart[L.Exp R.nvar,GenericCube[l].Sub R.nvar,GenericCech[l].Bad R.nvar (negsuc zero) (Kd.topRank (suc (suc zero)))] ;
 module JL = GenericReesChartLaws[l].Over[A,setA,R.nvar,t,b,s,p,e,hp] ;
 module JD = JL.Diff[negsuc zero,Kd.topRank (suc (suc zero))] ; module Q2 = JD.Target.Q ;
 module D1A = JD.DT ; module D1D = GenericCechTheorems[l].Over[R.X.D,R.X.setD].Linear[R.nvar,negsuc zero,Kd.topRank (suc (suc zero))] ;
 module L1 = RelationCertificate[l].LinL[A,Q1.Target,Q2.Target,D1A.d] ;
 module EC2 = EV.CochainEv[negsuc zero,Kd.topRank (suc (suc (suc zero)))].E ;
 module EvalD = EV.Diff[negsuc zero,Kd.topRank (suc (suc zero))] ;
 module Sections (z : Nat -> Q0.Target.M) (w : Nat -> Q1.Target.M)
  (wit : (n : Nat) -> Q1.FC.Wit (suc (toB n)) (w n))
  (remainder : (n : Nat) -> Q1.JW (Q1.ML.msub (R.d (z n)) (w n)))
  (compatibility : (n : Nat) -> Q0.IJ (suc zero) (Q0.ML.msub (z n) (z zero))) {
  lifted (n : Nat) : PL.Lift (suc (toB n)) (w n) = PL.lift (suc (toB n)) (w n) (wit n) ;
  c (n : Nat) : PL.CD.El = (lifted n).1 ;
  hc (n : Nat) : PL.P.Hom (cdeg (suc n)) (c n) = (lifted n).2.1 ;
  ec (n : Nat) : Id Q1.Target.M (PL.E.evc (c n)) (w n) = (lifted n).2.2 ;
  dd (x : Q0.Target.M) : Id Q2.Target.M (D1A.d.f (R.d x)) Q2.Target.mz =
   JD.Target.Target.M.eq _ _ (GenericCech[l].Over[A,setA].SquareZero[R.nvar,negsuc zero,Kd.topRank (suc zero)].dd x) ;
  derivative-remainder (n : Nat) : Id Q2.Target.M (D1A.d.f (Q1.ML.msub (R.d (z n)) (w n))) (Q2.Target.mneg (D1A.d.f (w n))) =
   trans (L1.f-sub (R.d (z n)) (w n))
    (trans (ap (\ x -> Q2.ML.msub x (D1A.d.f (w n))) (dd (z n))) (Q2.ML.G.zl (Q2.Target.mneg (D1A.d.f (w n))))) ;
  section-closed (n : Nat) : Q2.InJ (D1A.d.f (w n)) =
   subst Q2.InJ (trans (ap Q2.Target.mneg (derivative-remainder n)) (Q2.ML.G.neg-neg (D1A.d.f (w n))))
    (Q2.in-neg (D1A.d.f (Q1.ML.msub (R.d (z n)) (w n)))
      (JD.membership (Q1.ML.msub (R.d (z n)) (w n)) (Q1.in-of _ (remainder n)))) ;
  closed-evaluation (n : Nat) : Q2.InJ (EC2.evc (D1D.d.f (c n))) =
   subst Q2.InJ (sym (trans (EvalD.equation (c n)) (ap D1A.d.f (ec n)))) (section-closed n) ;
  hz (n : Nat) : Q1.Cong (PL.E.evc (c n)) (R.d (z n)) =
   Q1.cong-trans (PL.E.evc (c n)) (w n) (R.d (z n)) (Q1.cong-of-id _ _ (ec n))
    (Q1.cong-sym (R.d (z n)) (w n) (Q1.in-of (Q1.ML.msub (R.d (z n)) (w n)) (remainder n))) ;
  Corrected : U l = (zz : Q0.Target.M) * (Q1.InJ (R.d zz) * Q0.IJ (suc zero) (Q0.ML.msub zz (z zero))) ;
  module Chosen (dat : R.LS.Data) {
   wkg : R.LS.WC.ReesW = dat.1 ; fw : R.LS.WC.WithGens[wkg].F.FixedW = dat.2.1 ;
   reps : R.LS.Fixed[wkg,fw].Representatives = dat.2.2.1 ;
   ws : R.LS.Fixed[wkg,fw].Certs = dat.2.2.2.1 ;
   hr : R.LS.Fixed[wkg,fw].Chosen[reps].Certificates[ws].HReps = dat.2.2.2.2 ;
   module F = R.Fixed[wkg,fw,reps,ws,hr] ;
   module KG = R.FF.CM.Fixed[wkg,fw,reps].At[negsuc zero,Kd.topRank (suc (suc (suc zero)))] ;
   module CP = EV.CC.Diff[R.nvar,negsuc zero,Kd.topRank (suc (suc zero))] ;
   homogeneous (n : Nat) : KG.EC.P.Hom (cdeg (suc n)) (D1D.d.f (c n)) = \ chart m ->
    ap (\ x -> KG.Target.val x chart m)
     (trans (CP.equation (cdeg (suc n)) (c n)) (ap D1D.d.f (CP.P0.proj-hom (cdeg (suc n)) (c n) (hc n)))) ;
   module Action (u : KG.Source.El) (chart : GenericCube[l].Sub R.nvar) (m : L.Exp R.nvar) {
    raw : R.X.D.R = R.FF.CM.LL.FA.RS.sum F.K.na (\ j -> R.FF.CM.LL.FA.mulP (F.C.gD j)
      (R.FF.CM.CE.Cochains[R.nvar,KG.twists j,Kd.topRank (suc (suc (suc zero)))].val (u j) chart) m) ;
    left : Id R.X.D.R (KG.Target.val (KG.Sum.lin.f u) chart m) raw =
     R.FF.CM.CS.ChartSum[negsuc zero,Kd.topRank (suc (suc (suc zero)))].val F.K.na (\ j -> (KG.entry j).f (u j)) chart m ;
    right : Id R.X.D.R (KG.Target.val (F.ED.CI.I.A2.A.lin.f u (inr tt)) chart m) raw =
     trans (ap (\ x -> KG.Target.val x chart m) (F.ED.CI.I.A2.A.row-value u (inr tt)))
      (R.FF.CM.CS.ChartSum[negsuc zero,Kd.topRank (suc (suc (suc zero)))].val F.K.na (\ j -> (F.ED.CI.I.A2.A.entry (inr tt) j).f (u j)) chart m) ;
    equation : Id R.X.D.R (KG.Target.val (KG.Sum.lin.f u) chart m) (KG.Target.val (F.ED.CI.I.A2.A.lin.f u (inr tt)) chart m) = trans left (sym right) ;
   } ;
   action (u : KG.Source.El) : Id KG.Target.El (KG.Sum.lin.f u) (F.ED.CI.I.A2.A.lin.f u (inr tt)) =
    KG.Target.M.eq _ _ (\ chart m -> Action[u,chart,m].equation) ;
   lift (n : Nat) : Tr.Trunc[F.ED.CI.Lifted (c n)].carrier =
    TC.map KG.Input[suc (toB n),D1D.d.f (c n),homogeneous n,closed-evaluation n].Result
      (F.ED.CI.Lifted (c n)) (\ sol -> (sol.1,trans (sym sol.2) (action sol.1)))
      KG.Input[suc (toB n),D1D.d.f (c n),homogeneous n,closed-evaluation n].lift ;
   corrected : Tr.Trunc[Corrected].carrier = F.Seq[c,hc,lift,z,hz,compatibility].correction ;
  } ;
  correction : Tr.Trunc[Corrected].carrier = TC.bind R.LS.Data Corrected (\ dat -> Chosen[dat].corrected) R.LS.constructed ;
 } ;
} ;
