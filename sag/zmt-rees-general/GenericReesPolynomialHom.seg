-- A polynomial whose coefficients all have U-degree k remains of that
-- U-degree after reverse exchange: X variables have U-degree zero.
-- The proof follows the actual tower's one-variable monomial recursion.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar t : Nat) (b0 : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module X = GenericReesExchange[l].Over[A,setA,nvar,t,b0,s,p,e,hp] ; module RR = X.RR ; module GL = X.GL ;
 module T = X.BD.T ; module B = X.BD ;
 module TU = TowerUniversal[l].Over[X.D,RR.R,X.setD,RR.setR] ;
 ext (n : Nat) (a : Ps.Fin n -> RR.R.R) : RH.Hom (T.D n) RR.R = TU.extend n X.coeff a ;
 module Step (n : Nat) (a : Ps.Fin (suc n) -> RR.R.R) (ha : (i : Ps.Fin (suc n)) -> GL.Hom zeroZ (a i))
   (k : Base.Nat) (c : (T.D n).R) (hc : GL.Hom (pos k) ((ext n (\ i -> a (inl i))).1 c)) {
   module UP = Universal[l].Property[T.D n,RR.R,T.setD n,RR.setR] ;
   module UPM = UP.Given[ext n (\ i -> a (inl i)),a (inr tt)] ;
   varhom : GL.Hom zeroZ ((ext (suc n) a).1 B.Level[n].X.variable) =
     subst (GL.Hom zeroZ) (sym UPM.on-variable) (ha (inr tt)) ;
   mono : (j : Base.Nat) -> GL.Hom (pos k) ((ext (suc n) a).1 (B.Level[n].mono c j)) = split {
     zero -> subst (GL.Hom (pos k)) (sym (UPM.on-constants c)) hc ;
     suc j | rec -> subst (GL.Hom (pos k))
       (sym ((ext (suc n) a).2.2.2 B.Level[n].X.variable (B.Level[n].mono c j)))
       (subst (GL.Hom (pos k))
         (RR.R.mulC ((ext (suc n) a).1 (B.Level[n].mono c j)) ((ext (suc n) a).1 B.Level[n].X.variable))
         (GL.hom-mul (pos k) zeroZ ((ext (suc n) a).1 (B.Level[n].mono c j)) ((ext (suc n) a).1 B.Level[n].X.variable) rec varhom)) } ;
 } ;
 term (k : Base.Nat) : (n : Nat) (a : Ps.Fin n -> RR.R.R) -> ((i : Ps.Fin n) -> GL.Hom zeroZ (a i)) ->
   (u : B.Term n) -> X.GDL.Hom (pos k) u.1 -> GL.Hom (pos k) ((ext n a).1 (B.term n u)) = split {
   zero -> \ a ha u hu -> X.coeff-hom k u.1 hu ;
   suc n | rec -> \ a ha u hu -> Step[n,a,ha,k,B.term n (u.1,FiniteExponents[l].old n u.2),
     rec (\ i -> a (inl i)) (\ i -> ha (inl i)) (u.1,FiniteExponents[l].old n u.2) hu].mono (u.2 (inr tt)) } ;
 CoefHom (k : Base.Nat) (n : Nat) : List (B.Term n) -> U l = split {
   nil -> Top ; cons u us | rec -> X.GDL.Hom (pos k) u.1 * rec } ;
 phi (k : Base.Nat) (n : Nat) (a : Ps.Fin n -> RR.R.R) (ha : (i : Ps.Fin n) -> GL.Hom zeroZ (a i)) :
   (qs : List (B.Term n)) -> CoefHom k n qs -> GL.Hom (pos k) ((ext n a).1 (B.phi n qs)) = split {
   nil -> \ h -> subst (GL.Hom (pos k)) (sym (RH.zero (T.D n) RR.R (ext n a))) (GL.hom-zero (pos k)) ;
   cons u us | rec -> \ h -> subst (GL.Hom (pos k)) (sym ((ext n a).2.2.1 (B.term n u) (B.phi n us)))
     (GL.hom-add (pos k) ((ext n a).1 (B.term n u)) ((ext n a).1 (B.phi n us)) (term k n a ha u h.1) (rec h.2)) } ;
 vars (i : Ps.Fin nvar) : RR.R.R = RR.GU.iota.1 (RR.GX.var i) ;
 varshom (i : Ps.Fin nvar) : GL.Hom zeroZ (vars i) = GL.hom-iota (RR.GX.var i) ;
 eta-path : Id (RH.Hom X.DX RR.R) X.eta (ext nvar vars) = TU.unique nvar X.coeff vars X.eta X.eta-base X.eta-variable ;
 eta-phi-hom (k : Base.Nat) (qs : List (B.Term nvar)) (hq : CoefHom k nvar qs) : GL.Hom (pos k) (X.eta.1 (B.phi nvar qs)) =
   subst (GL.Hom (pos k)) (sym (ap (\ h -> h.1 (B.phi nvar qs)) eta-path)) (phi k nvar vars varshom qs hq) ;
} ;
