-- Original-equation images are preserved by the structural differential.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module PA = PolynomialAction4[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar t : Nat) (b : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module J = GenericReesChart[l].Over[A,setA,nvar,t,b,s,p,e,hp] ;
 module CT = GenericCechTheorems[l].Over[A,setA] ; module SC = ShiftedCech4[l].Over[A,setA] ;
 module Diff (k r : Int) {
  module Source = J.At[k,r] ; module Target = J.At[k,sucZ r] ;
  module DT = CT.Linear[nvar,k,r] ; module DF = J.M.Differential[s,Source.ki,r] ;
  module TS = Comb[l].Sums[A,Target.Target.mod] ;
  equation (y : Source.Source.El) : Id Target.Target.El (DT.d.f (Source.action.f y)) (Target.action.f (DF.lin.f y)) =
   trans (SC.LinSum[Source.Target.mod,Target.Target.mod,DT.d].lin-sum s (\ q -> (Source.entry q).f (y q)))
    (TS.sum-cong s (\ q -> DT.d.f ((Source.entry q).f (y q))) (\ q -> (Target.entry q).f (DF.lin.f y q))
      (\ q -> J.C.Comm[Source.ki q,k,r,p q,J.M.shifts k zero (e q) (p q) (J.hp-shift q)].equation (y q))) ;
  witness (x : Source.Target.El) (w : Source.Q.JW x) : Target.Q.JW (DT.d.f x) =
   (DF.lin.f w.1,trans (ap DT.d.f w.2) (equation w.1)) ;
  membership (x : Source.Target.El) (h : Source.Q.InJ x) : Target.Q.InJ (DT.d.f x) =
   TC.map (Source.Q.JW x) (Target.Q.JW (DT.d.f x)) (witness x) h ;
 } ;
} ;
