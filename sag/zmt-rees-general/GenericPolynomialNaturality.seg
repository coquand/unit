-- Coefficient extension on arbitrary finite polynomial towers. Construct
-- it one variable at a time; monomial and term-list comparison follow
-- directly from the one-variable constant/variable characterisations.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ;
module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (f : RH.Hom A B) {
 module PA = PolynomialTowerBridge[l].Over[A,setA] ; module PB = PolynomialTowerBridge[l].Over[B,setB] ;
 module TA = PA.T ; module TB = PB.T ;
 mapT (n : Nat) : List (PA.Term n) -> List (PB.Term n) = split {
   nil -> nil ; cons u us | rec -> cons (f.1 u.1,u.2) rec } ;
 maps : (n : Nat) -> RH.Hom (TA.D n) (TB.D n) = split {
   zero -> f ;
   suc n | rec -> Universal[l].Property[TA.D n,TB.D (suc n),TA.setD n,TB.setD (suc n)].Given[
     RH.compose (TA.D n) (TB.D n) (TB.D (suc n)) PB.Level[n].X.inclusion rec,PB.Level[n].X.variable].extend } ;
 module Step (n : Nat) {
   module UP = Universal[l].Property[TA.D n,TB.D (suc n),TA.setD n,TB.setD (suc n)] ;
   base : RH.Hom (TA.D n) (TB.D (suc n)) = RH.compose (TA.D n) (TB.D n) (TB.D (suc n)) PB.Level[n].X.inclusion (maps n) ;
   module M = UP.Given[base,PB.Level[n].X.variable] ;
   constant (x : (TA.D n).R) : Id (TB.D (suc n)).R ((maps (suc n)).1 (PA.Level[n].X.constant x))
     (PB.Level[n].X.constant ((maps n).1 x)) = M.on-constants x ;
   variable : Id (TB.D (suc n)).R ((maps (suc n)).1 PA.Level[n].X.variable) PB.Level[n].X.variable = M.on-variable ;
   mono (c : (TA.D n).R) : (e : Base.Nat) ->
     Id (TB.D (suc n)).R ((maps (suc n)).1 (PA.Level[n].mono c e)) (PB.Level[n].mono ((maps n).1 c) e) = split {
     zero -> constant c ;
     suc e | rec -> trans ((maps (suc n)).2.2.2 PA.Level[n].X.variable (PA.Level[n].mono c e))
       (Presentations[l].cong2 (TB.D (suc n)).R (TB.D (suc n)).mul _ _ _ _ variable rec) } ;
 } ;
 on-base : (n : Nat) (a : A.R) -> Id (TB.D n).R ((maps n).1 ((TA.grD n).iota.1 a)) ((TB.grD n).iota.1 (f.1 a)) = split {
   zero -> \ a -> refl (f.1 a) ;
   suc n | rec -> \ a -> trans (Step[n].constant ((TA.grD n).iota.1 a)) (ap PB.Level[n].X.constant (rec a)) } ;
 on-variable : (n : Nat) (i : Ps.Fin n) -> Id (TB.D n).R ((maps n).1 ((TA.grD n).var i)) ((TB.grD n).var i) = split {
   zero -> \ i -> absurd (Id (TB.D zero).R ((maps zero).1 ((TA.grD zero).var i)) ((TB.grD zero).var i)) i ;
   suc n | rec -> split {
     inl i -> trans (Step[n].constant ((TA.grD n).var i)) (ap PB.Level[n].X.constant (rec i)) ;
     inr t -> topVariable n t } }
 where { topVariable (n : Nat) : (t : Top) ->
   Id (TB.D (suc n)).R ((maps (suc n)).1 ((TA.grD (suc n)).var (inr t))) ((TB.grD (suc n)).var (inr t)) = split {
     tt -> Step[n].variable } } ;
 term : (n : Nat) (u : PA.Term n) -> Id (TB.D n).R ((maps n).1 (PA.term n u)) (PB.term n (f.1 u.1,u.2)) = split {
   zero -> \ u -> refl (f.1 u.1) ;
   suc n | rec -> \ u -> trans (Step[n].mono (PA.term n (u.1,FiniteExponents[l].old n u.2)) (u.2 (inr tt)))
     (ap (\ c -> PB.Level[n].mono c (u.2 (inr tt))) (rec (u.1,FiniteExponents[l].old n u.2))) } ;
 phi (n : Nat) : (p : List (PA.Term n)) -> Id (TB.D n).R ((maps n).1 (PA.phi n p)) (PB.phi n (mapT n p)) = split {
   nil -> RH.zero (TA.D n) (TB.D n) (maps n) ;
   cons u us | rec -> trans ((maps n).2.2.1 (PA.term n u) (PA.phi n us))
     (Presentations[l].cong2 (TB.D n).R (TB.D n).add _ _ _ _ (term n u) rec) } ;
 module Given (n : Nat) (g : RH.Hom (TA.D n) (TB.D n))
   (hc : (a : A.R) -> Id (TB.D n).R (g.1 ((TA.grD n).iota.1 a)) ((TB.grD n).iota.1 (f.1 a)))
   (hv : (i : Ps.Fin n) -> Id (TB.D n).R (g.1 ((TA.grD n).var i)) ((TB.grD n).var i)) {
   equation : Id (RH.Hom (TA.D n) (TB.D n)) g (maps n) =
     TowerUniversal[l].Over[A,TB.D n,setA,TB.setD n].ext n g (maps n)
       (\ a -> trans (hc a) (sym (on-base n a))) (\ i -> trans (hv i) (sym (on-variable n i))) ;
   polynomial (p : List (PA.Term n)) : Id (TB.D n).R (g.1 (PA.phi n p)) (PB.phi n (mapT n p)) =
     trans (ap (\ h -> h.1 (PA.phi n p)) equation) (phi n p) ;
 } ;
} ;
