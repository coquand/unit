-- Finite bitset choice assembles the constructed local Rees lifts into
-- actual shifted GenericCech families, preserving the same fixed KG list.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module L = GenericLaurent[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module LG = Logic[l] ; module FC = FiniteChartChoice[l] ;
module Kd = GenericDegree[l] ; module PA = PolynomialAction4[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (nvar t : Nat) (b0 : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module LL = GenericLocalizedReesLift[l].Over[K0,A,setA,cfnA,nvar,t,b0,s,p,e,hp] ; module LM = LL.LM ; module X = LL.X ;
 module EV = GenericCoefficientEvaluation[l].Over[A,setA,t,X.D,X.setD,X.GD,b0,nvar] ;
 module J = GenericReesChart[l].Over[A,setA,nvar,t,b0,s,p,e,hp] ;
 module M = ShiftedMatrixAction[l].Over[X.D,X.setD,nvar] ; module CE = M.E ;
 module SD = FC.Over[X.D,L.Exp nvar] ; module SA = FC.Over[A,L.Exp nvar] ;
 module CS = GlobalCechSyzygies[l].Over[X.D,X.setD,nvar] ;
 module Fixed (w : LM.PM.L.WC.ReesW) (fw : LM.PM.L.WC.WithGens[w].F.FixedW) (reps : LM.PM.L.Fixed[w,fw].Representatives) {
  module Local = LL.Fixed[w,fw,reps] ; module F = Local.F ; module C = Local.C ; module K = Local.K ;
  module HR = HomogeneousRepresentatives[l].Over[X.D,X.setD,nvar] ;
  hom-convert (dd : Base.Nat) : (ps : List (X.BD.Term nvar)) -> LM.PM.L.BR.HomX dd ps -> HR.Hom (pos dd) ps = split {
   nil -> \ h -> tt ; cons u us | rec -> \ h -> (h.1,rec h.2) } ;
  shift-convert (dd ee : Base.Nat) : (ps : List (X.BD.Term nvar)) -> HR.HomShift dd ee ps -> M.HomShift dd ee ps = split {
   nil -> \ h -> tt ; cons u us | rec -> \ h -> (h.1,rec h.2) } ;
  hg (j : Ps.Fin K.na) : M.HomShift zero (F.dX j) (C.gD j) = shift-convert zero (F.dX j) (C.gD j)
    (HR.shifted zero (F.dX j) (C.gD j) (hom-convert (F.dX j) (C.gD j) (C.hgD j))) ;
  module At (twist rank : Int) {
   module Target = CE.Cochains[nvar,twist,rank] ;
   twists (j : Ps.Fin K.na) : Int = PA.minus twist (F.dX j) ;
   module Source = M.Family[K.na,twists,rank] ;
   entry (j : Ps.Fin K.na) : IP.Lin[X.D,Source.Md j,Target.mod] = M.A.Act[twists j,twist,rank,C.gD j,M.shifts twist zero (F.dX j) (C.gD j) (hg j)].lin ;
   module Sum = Source.Prod.SumMap[Target.mod,entry] ;
   module EC = EV.CochainEv[twist,rank].E ; module JA = J.At[twist,rank] ;
   module Input (k : Base.Nat) (y : Target.El) (hy : EC.P.Hom (pos k) y) (jy : JA.Q.InJ (EC.evc y)) {
    Result : U l = (z : Source.El) * Id Target.El (Sum.lin.f z) y ;
    module WithJ (jw : JA.Q.JW (EC.evc y)) {
     vs (q : Ps.Fin s) (chart : Sub nvar) : L.Exp nvar -> A.R = J.CE.Cochains[nvar,JA.ki q,rank].val (jw.1 q) chart ;
     VSupport : U l = SA.Witness (Ps.Fin s * Sub nvar) (\ pair -> vs pair.1 pair.2) ;
     v-support : Tr.Trunc[VSupport].carrier = SA.finite-fin (Sub nvar) s vs
      (\ q -> J.CE.Cochains[nvar,JA.ki q,rank].M.supp (jw.1 q)) ;
     module Supported (ys : Target.M.SuppW (Target.val y)) (vw : VSupport) {
      support : List (L.Exp nvar) = L.append (L.Exp nvar) ys.1 vw.1 ;
      module Chart (chart : Sub nvar) {
       f (m : L.Exp nvar) : X.D.R = Target.val y chart m ;
       fs (m : L.Exp nvar) (nm : Not (L.Mem (L.Exp nvar) m support)) : Id X.D.R (f m) X.D.z =
        ys.2 chart m (\ h -> nm (L.mem-left (L.Exp nvar) m ys.1 vw.1 h)) ;
       vf (q : Ps.Fin s) : L.Exp nvar -> A.R = vs q chart ;
       vfs (q : Ps.Fin s) (m : L.Exp nvar) (nm : Not (L.Mem (L.Exp nvar) m support)) : Id A.R (vf q m) A.z =
        vw.2 (q,chart) m (\ h -> nm (L.mem-right (L.Exp nvar) m ys.1 vw.1 h)) ;
       equation (m : L.Exp nvar) : Id A.R (X.evD.1 (f m)) (LM.FA.RS.sum s (\ q -> LM.FA.mulP (p q) (vf q) m)) =
        trans (ap (\ x -> JA.Target.val x chart m) jw.2)
         (GlobalCechSyzygies[l].Over[A,setA,nvar].ChartSum[twist,rank].val s (\ q -> (JA.entry q).f (jw.1 q)) chart m) ;
       module Lift = Local.Chart[chart,support,k,twist,f,fs,\ m b -> Target.support y m chart b,hy chart,
        \ m ne -> Target.projective y m ne chart,vf,vfs,\ q m b -> J.CE.Cochains[nvar,JA.ki q,rank].support (jw.1 q) m chart b,equation] ;
      } ;
      Choices : U l = (chart : Sub nvar) -> Chart[chart].Lift.Coordinates ;
      choices : Tr.Trunc[Choices].carrier = FC.choice nvar (\ chart -> Chart[chart].Lift.Coordinates) (\ chart -> Chart[chart].Lift.membership) ;
      module Selected (sol : Choices) {
       module AtChart (chart : Sub nvar) { module Z = Chart[chart].Lift.From[sol chart] ; } ;
       raw (j : Ps.Fin K.na) (chart : Sub nvar) (m : L.Exp nvar) : X.D.R = AtChart[chart].Z.value j m ;
       choose (j : Ps.Fin K.na) (chart : Sub nvar) (m : L.Exp nvar) : LG.Dec (Id Int (Kd.card nvar chart) rank) -> X.D.R = split {
        yes eq -> raw j chart m ; no ne -> X.D.z } ;
       value (j : Ps.Fin K.na) (chart : Sub nvar) (m : L.Exp nvar) : X.D.R = choose j chart m (int-dec (Kd.card nvar chart) rank) ;
       choose-zero (j : Ps.Fin K.na) (chart : Sub nvar) (m : L.Exp nvar) (eq : Id X.D.R (raw j chart m) X.D.z) :
        (dec : LG.Dec (Id Int (Kd.card nvar chart) rank)) -> Id X.D.R (choose j chart m dec) X.D.z = split { yes h -> eq ; no ne -> refl X.D.z } ;
       rank-zero (j : Ps.Fin K.na) (chart : Sub nvar) (m : L.Exp nvar) (ne : Not (Id Int (Kd.card nvar chart) rank)) :
        (dec : LG.Dec (Id Int (Kd.card nvar chart) rank)) -> Id X.D.R (choose j chart m dec) X.D.z = split {
         yes eq -> absurd (Id X.D.R (raw j chart m) X.D.z) (ne eq) ; no nq -> refl X.D.z } ;
       finite-support (j : Ps.Fin K.na) : CE.Cochains[nvar,twists j,rank].M.Supp (value j) =
        TC.map (SD.Witness (Sub nvar) (raw j)) (CE.Cochains[nvar,twists j,rank].M.SuppW (value j))
         (\ sw -> (sw.1,\ chart m nm -> choose-zero j chart m (sw.2 chart m nm) (int-dec (Kd.card nvar chart) rank)))
         (SD.finite-sub nvar (raw j) (\ chart -> AtChart[chart].Z.finite j)) ;
       van (j : Ps.Fin K.na) (chart : Sub nvar) (m : L.Exp nvar) : GenericCech[l].Bad nvar (twists j) rank chart m -> Id X.D.R (value j chart m) X.D.z = split {
        inl ne -> choose-zero j chart m (AtChart[chart].Z.degree j m ne) (int-dec (Kd.card nvar chart) rank) ;
        inr b -> other j chart m b }
       where { other (j : Ps.Fin K.na) (chart : Sub nvar) (m : L.Exp nvar) :
        Plus (GenericSupport[l].bad nvar (L.mask nvar m) chart) (Not (Id Int (Kd.card nvar chart) rank)) -> Id X.D.R (value j chart m) X.D.z = split {
         inl b -> choose-zero j chart m (AtChart[chart].Z.chart-van j m b) (int-dec (Kd.card nvar chart) rank) ;
         inr ne -> rank-zero j chart m ne (int-dec (Kd.card nvar chart) rank) } } ;
       z (j : Ps.Fin K.na) : (Source.Md j).M = CE.Cochains[nvar,twists j,rank].M.mk (value j) (finite-support j) (van j) ;
       equation-case (chart : Sub nvar) (m : L.Exp nvar) : (dec : LG.Dec (Id Int (Kd.card nvar chart) rank)) ->
        Id X.D.R (LL.FA.RS.sum K.na (\ j -> LL.FA.mulP (C.gD j) (\ x -> choose j chart x dec) m)) (Target.val y chart m) = split {
         yes eq -> AtChart[chart].Z.equation m ;
         no ne -> trans (LL.FA.RS.sum-cong K.na _ _ (\ j -> LL.FA.mulP-zero (C.gD j) m))
          (trans (LL.FA.RS.sum-zero K.na) (sym (Target.rank y m chart (\ eq -> Pr.absurd Empty (ne eq))))) } ;
       equation : Id Target.El (Sum.lin.f z) y = Target.M.eq _ _ (\ chart m ->
        trans (CS.ChartSum[twist,rank].val K.na (\ j -> (entry j).f (z j)) chart m) (equation-case chart m (int-dec (Kd.card nvar chart) rank))) ;
       result : Result = (z,equation) ;
      } ;
      lift : Tr.Trunc[Result].carrier = TC.map Choices Result (\ sol -> Selected[sol].result) choices ;
     } ;
     lift : Tr.Trunc[Result].carrier = TC.bind (Target.M.SuppW (Target.val y)) Result
      (\ ys -> TC.bind VSupport Result (\ vw -> Supported[ys,vw].lift) v-support) (Target.M.supp y) ;
    } ;
    lift : Tr.Trunc[Result].carrier = TC.bind (JA.Q.JW (EC.evc y)) Result (\ jw -> WithJ[jw].lift) jy ;
   } ;
  } ;
 } ;
} ;
