-- Bihomogeneous Rees elements merely have finite term-list representatives
-- over D=A[U], retaining both degrees and their EXACT exchange-ring image.
-- Choose homogeneous X representatives only in the finitely branching
-- coefficient expression, under truncation; no infinite choice is used.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar t : Nat) (b0 : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar))
 (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module X = GenericReesExchange[l].Over[A,setA,nvar,t,b0,s,p,e,hp] ; module RR = X.RR ;
 module B = X.BD ; module PX = PolynomialTowerProducts[l].Over[X.D,X.setD,nvar] ;
 module SC = GenericPolynomialScalar[l].Over[X.D,X.setD,nvar] ;
 module H = HomogeneousRepresentatives[l].Over[A,setA,nvar] ;
 module C = CechPolynomialAction[l].Over[X.D,X.setD,nvar] ;
 module BA = GenericBihomogeneousAction[l].Over[A,t,X.D,X.setD,X.GD,nvar] ;
 module DX = Laws[X.D,nvar,X.DX,X.setDX,X.GX] ;
 module HS = HomSum[RR.R,X.DX,X.psi] ;
 HomX (d : Base.Nat) : List (B.Term nvar) -> U l = C.Hom (pos d) ;
 Rep (k d : Base.Nat) (y : RR.R.R) : U l = (q : List (B.Term nvar)) *
   (HomX d q * (BA.CoefHom k q * Id X.DX.R (B.phi nvar q) (X.psi.1 y))) ;
 hom-app (d : Base.Nat) : (qs rs : List (B.Term nvar)) -> HomX d qs -> HomX d rs -> HomX d (Bar[l].app qs rs) = split {
   nil -> \ rs hq hr -> hr ; cons u us | rec -> \ rs hq hr -> (hq.1,rec rs hq.2 hr) } ;
 coef-app (k : Base.Nat) : (qs rs : List (B.Term nvar)) -> BA.CoefHom k qs -> BA.CoefHom k rs -> BA.CoefHom k (Bar[l].app qs rs) = split {
   nil -> \ rs hq hr -> hr ; cons u us | rec -> \ rs hq hr -> (hq.1,rec rs hq.2 hr) } ;
 hom-sum (d : Base.Nat) : (a : Nat) (qs : Ps.Fin a -> List (B.Term nvar)) -> ((i : Ps.Fin a) -> HomX d (qs i)) ->
   HomX d (PX.FA.psum a qs) = split {
   zero -> \ qs hq -> tt ; suc a | rec -> \ qs hq -> hom-app d (qs (inr tt)) (PX.FA.psum a (\ i -> qs (inl i)))
     (hq (inr tt)) (rec (\ i -> qs (inl i)) (\ i -> hq (inl i))) } ;
 coef-sum (k : Base.Nat) : (a : Nat) (qs : Ps.Fin a -> List (B.Term nvar)) -> ((i : Ps.Fin a) -> BA.CoefHom k (qs i)) ->
   BA.CoefHom k (PX.FA.psum a qs) = split {
   zero -> \ qs hq -> tt ; suc a | rec -> \ qs hq -> coef-app k (qs (inr tt)) (PX.FA.psum a (\ i -> qs (inl i)))
     (hq (inr tt)) (rec (\ i -> qs (inl i)) (\ i -> hq (inl i))) } ;
 hom-scale (c : X.D.R) (d : Base.Nat) : (qs : List (B.Term nvar)) -> HomX d qs -> HomX d (SC.scale c qs) = split {
   nil -> \ h -> tt ; cons u us | rec -> \ h -> (h.1,rec h.2) } ;
 coef-scale (j : Ps.Fin t) (k : Base.Nat) : (qs : List (B.Term nvar)) -> BA.CoefHom k qs -> BA.CoefHom (suc k) (SC.scale (X.GD.var j) qs) = split {
   nil -> \ h -> tt ; cons u us | rec -> \ h ->
     (subst (X.GDL.Hom (pos (suc k))) (X.D.mulC u.1 (X.GD.var j))
       (X.GDL.hom-mul (pos k) (pos (suc zero)) u.1 (X.GD.var j) h.1 (X.GD.var-hom j)),rec h.2) } ;
 hom-lift (d : Base.Nat) : (qs : List (RR.BR.Term nvar)) -> H.Hom (pos d) qs -> HomX d (X.liftC qs) = split {
   nil -> \ h -> tt ; cons u us | rec -> \ h -> (h.1,rec h.2) } ;
 coef-lift : (qs : List (RR.BR.Term nvar)) -> BA.CoefHom zero (X.liftC qs) = split {
   nil -> tt ; cons u us | rec -> (X.GDL.hom-iota u.1,rec) } ;
 base (d : Base.Nat) (y : RR.S.R) (hy : RR.GXL.Hom (pos d) y) : Tr.Trunc[Rep zero d (RR.GU.iota.1 y)].carrier =
   TC.map (H.Rep (pos d) y) (Rep zero d (RR.GU.iota.1 y))
     (\ q -> (X.liftC q.1,(hom-lift d q.1 q.2.2,(coef-lift q.1,
       trans (sym (X.inc-polynomial q.1)) (ap X.incS.1 q.2.1))))) (H.representative (pos d) y hy) ;
 module Step (d k : Base.Nat) (ex : RR.RC.GL.Expr (suc k))
   (hx : RR.RC.AllE (suc k) (RR.GXL.Hom (pos d)) ex)
   (reps : (j : Ps.Fin t) -> Rep k d (RR.RC.GL.value k (ex j))) {
   qs (j : Ps.Fin t) : List (B.Term nvar) = SC.scale (X.GD.var j) (reps j).1 ;
   list : List (B.Term nvar) = PX.FA.psum t qs ;
   hx-list : HomX d list = hom-sum d t qs (\ j -> hom-scale (X.GD.var j) d (reps j).1 (reps j).2.1) ;
   hu-list : BA.CoefHom (suc k) list = coef-sum (suc k) t qs (\ j -> coef-scale j k (reps j).1 (reps j).2.2.1) ;
   phi-entry (j : Ps.Fin t) : Id X.DX.R (B.phi nvar (qs j)) (X.psi.1 (RR.R.mul (RR.GU.var j) (RR.RC.GL.value k (ex j)))) =
     trans (SC.phi-scale (X.GD.var j) (reps j).1)
       (trans (Ps.cong2 X.DX.R X.DX.mul _ _ _ _ (sym (X.psi-variable j)) (reps j).2.2.2)
         (sym (X.psi.2.2.2 (RR.GU.var j) (RR.RC.GL.value k (ex j))))) ;
   equation : Id X.DX.R (B.phi nvar list) (X.psi.1 (RR.RC.GL.value (suc k) ex)) =
     trans (PX.sum t qs) (trans (PX.SS.sum-cong t _ _ phi-entry) (sym (HS.map-sum t (\ j -> RR.R.mul (RR.GU.var j) (RR.RC.GL.value k (ex j)))))) ;
   result : Rep (suc k) d (RR.RC.GL.value (suc k) ex) = (list,(hx-list,(hu-list,equation))) ;
 } ;
 expr (d : Base.Nat) : (k : Base.Nat) (ex : RR.RC.GL.Expr k) -> RR.RC.AllE k (RR.GXL.Hom (pos d)) ex ->
   Tr.Trunc[Rep k d (RR.RC.GL.value k ex)].carrier = split {
   zero -> base d ;
   suc k | rec -> \ ex hx -> TC.map ((j : Ps.Fin t) -> Rep k d (RR.RC.GL.value k (ex j)))
     (Rep (suc k) d (RR.RC.GL.value (suc k) ex)) (\ reps -> Step[d,k,ex,hx,reps].result)
       (FinCat[l].fchoice t (\ j -> Rep k d (RR.RC.GL.value k (ex j))) (\ j -> rec (ex j) (hx j))) } ;
 bihomogeneous (n : Nat) (d : Base.Nat) (y : RR.R.R) (hy : RR.RC.BiHom n d y) :
   Tr.Trunc[Rep (CoefficientParts[l].toB n) d y].carrier =
   TC.map (Rep (CoefficientParts[l].toB n) d (RR.RC.GL.value (CoefficientParts[l].toB n) hy.1))
     (Rep (CoefficientParts[l].toB n) d y)
     (\ q -> (q.1,(q.2.1,(q.2.2.1,trans q.2.2.2 (ap X.psi.1 hy.2.2)))))
       (expr d (CoefficientParts[l].toB n) hy.1 hy.2.1) ;
} ;
