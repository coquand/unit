-- Actual generic Cech modules modulo the original homogeneous equations.
-- Ideal-power membership means the image in this quotient, with an explicit
-- original-equation remainder, and does not assert ideal powers of M.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module PA = PolynomialAction4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (nvar t : Nat) (b : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module M = ShiftedMatrixAction[l].Over[A,setA,nvar] ; module CE = M.E ; module C = M.A ;
 module H = HomogeneousRepresentatives[l].Over[A,setA,nvar] ;
 hom-convert (d : Int) : (ps : List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) -> C.Hom d ps -> H.Hom d ps = split {
  nil -> \ h -> tt ; cons u us | rec -> \ h -> (h.1,rec h.2) } ;
 shifted-convert (dd ee : Base.Nat) : (ps : List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) -> H.HomShift dd ee ps -> M.HomShift dd ee ps = split {
  nil -> \ h -> tt ; cons u us | rec -> \ h -> (h.1,rec h.2) } ;
 hp-shift (q : Ps.Fin s) : M.HomShift zero (e q) (p q) = shifted-convert zero (e q) (p q) (H.shifted zero (e q) (p q) (hom-convert (pos (e q)) (p q) (hp q))) ;
 module At (k r : Int) {
  module Target = CE.Cochains[nvar,k,r] ;
  ki (q : Ps.Fin s) : Int = PA.minus k (e q) ;
  module Source = M.Family[s,ki,r] ;
  entry (q : Ps.Fin s) : IP.Lin[A,Source.Md q,Target.mod] = C.Act[ki q,k,r,p q,M.shifts k zero (e q) (p q) (hp-shift q)].lin ;
  module Sum = Source.Prod.SumMap[Target.mod,entry] ;
  action : IP.Lin[A,Source.mod,Target.mod] = Sum.lin ;
  module Q = ImageQuotient[l].Over[A,t,b,Source.mod,Target.mod,action] ;
 } ;
} ;
