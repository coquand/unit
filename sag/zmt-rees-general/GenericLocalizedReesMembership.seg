-- A common chart-supported denominator clears the input and all original
-- ideal multipliers. The actual polynomial KG membership is then obtained
-- from the constructed Rees elimination theorem.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module L = GenericLaurent[l] ; module E = FiniteExponents[l] ;
module CD = ChartDenominators[l] ; module XB = LaurentExponentBridge[l] ; module GS = GenericSupport[l] ;
module Tr = Truncation[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (nvar t : Nat) (b0 : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module PM = GenericReesPolynomialMembership[l].Over[K0,A,setA,cfnA,nvar,t,b0,s,p,e,hp] ;
 module X = PM.X ; module RR = PM.RR ; module B = X.BD ; module RK = PM.RK ;
 module PC = PolynomialCoefficientNaturality[l].Over[X.D,A,X.setD,setA,X.evD] ;
 module DC = ChartPolynomialization[l].Over[X.D,X.setD] ; module AC = ChartPolynomialization[l].Over[A,setA] ;
 module AB = ClearingCoefficientBridge[l].Over[A,setA] ;
 module TA = TowerLaurentAction[l].Over[A,setA].At[nvar] ; module LC = LaurentPolynomialCoefficients[l].Over[A,setA].At[nvar] ;
 module V = XB.At[nvar] ; module FA = TA.FA ; module RS = RK.RSB ;
 coeff-sum : (a : Nat) (xs : Ps.Fin a -> RR.S.R) (m : L.Exp nvar) ->
  Id A.R (LC.coeff (RS.sum a xs) m) (FA.RS.sum a (\ i -> LC.coeff (xs i) m)) = split {
  zero -> \ xs m -> LC.coeff-zero m ;
  suc a | rec -> \ xs m -> trans (LC.coeff-add (xs (inr tt)) (RS.sum a (\ i -> xs (inl i))) m)
   (ap (A.add (LC.coeff (xs (inr tt)) m)) (rec (\ i -> xs (inl i)) m)) } ;
 module Chart (chart : Sub nvar) (support : List (L.Exp nvar)) (k : Base.Nat)
  (f : L.Exp nvar -> X.D.R)
  (fs : (m : L.Exp nvar) -> Not (L.Mem (L.Exp nvar) m support) -> Id X.D.R (f m) X.D.z)
  (fv : (m : L.Exp nvar) -> GS.bad nvar (L.mask nvar m) chart -> Id X.D.R (f m) X.D.z)
  (fh : (m : L.Exp nvar) -> X.GDL.Hom (pos k) (f m))
  (v : Ps.Fin s -> L.Exp nvar -> A.R)
  (vs : (q : Ps.Fin s) (m : L.Exp nvar) -> Not (L.Mem (L.Exp nvar) m support) -> Id A.R (v q m) A.z)
  (vv : (q : Ps.Fin s) (m : L.Exp nvar) -> GS.bad nvar (L.mask nvar m) chart -> Id A.R (v q m) A.z)
  (eq : (m : L.Exp nvar) -> Id A.R (X.evD.1 (f m)) (FA.RS.sum s (\ q -> FA.mulP (p q) (v q) m))) {
  module C = DC.Clear[nvar,chart,support,f,fs,fv] ;
  q : List (B.Term nvar) = C.SR.poly C.nsupport ;
  q-hom : PM.PH.CoefHom k nvar q = tl-hom (C.SR.NE.nub C.nsupport)
   where { tl-hom : (us : List (E.Exp nvar)) -> PM.PH.CoefHom k nvar (C.SR.tl us) = split {
    nil -> tt ; cons u us | rec -> (fh (CD.down nvar (V.emb u) C.C.u),rec) } } ;
  module Entry (j : Ps.Fin s) { module F = AC.Clear[nvar,chart,support,v j,vs j,vv j] ;
    module CB = AB.Clear[nvar,chart,support,v j,vs j,vv j] ; } ;
  coeff (j : Ps.Fin s) : RR.S.R = Entry[j].F.cleared ;
  sum : RR.S.R = RS.sum s (\ j -> RR.S.mul (RR.P j) (coeff j)) ;
  shiftcomm (m : L.Exp nvar) (u : E.Exp nvar) : Id (L.Exp nvar)
    (V.subE (CD.down nvar m C.C.u) u) (CD.down nvar (V.subE m u) C.C.u) = V.sub-comm m C.C.u u ;
  sum-coefficient (m : L.Exp nvar) : Id A.R (LC.coeff sum m)
    (FA.RS.sum s (\ j -> FA.mulP (p j) (v j) (CD.down nvar m C.C.u))) =
   trans (coeff-sum s (\ j -> RR.S.mul (RR.P j) (coeff j)) m)
    (FA.RS.sum-cong s _ _ (\ j -> trans (sym (TA.action (p j) (coeff j) m))
      (trans (FA.mulP-cong (p j) (LC.coeff (coeff j)) (\ z -> v j (CD.down nvar z C.C.u)) (Entry[j].CB.equation) m)
       (FA.mulP-shift (\ z -> CD.down nvar z C.C.u) shiftcomm (p j) (v j) m)))) ;
  polynomial-equation (u : E.Exp nvar) : Id A.R (RR.BR.Coeff nvar (RR.BR.phi nvar (X.evT q)) u) (RR.BR.Coeff nvar sum u) =
   trans (sym (PC.polynomial nvar q u))
    (trans (ap X.evD.1 (C.coefficients u))
     (trans (eq (CD.down nvar (V.emb u) C.C.u))
      (trans (sym (sum-coefficient (V.emb u))) (LC.coeff-emb sum u)))) ;
  phi-equation : Id RR.S.R (RR.BR.phi nvar (X.evT q)) sum = RR.BR.ext nvar _ _ polynomial-equation ;
  in-J : RK.InJ (RR.BR.phi nvar (X.evT q)) = Tr.Trunc[RK.JW (RR.BR.phi nvar (X.evT q))].inc
   (coeff,trans phi-equation (RS.sum-cong s (\ j -> RR.S.mul (RR.P j) (coeff j))
      (\ j -> RR.S.mul (coeff j) (RR.P j)) (\ j -> RR.S.mulC (RR.P j) (coeff j)))) ;
  module Fixed (w : PM.L.WC.ReesW) (fw : PM.L.WC.WithGens[w].F.FixedW) (reps : PM.L.Fixed[w,fw].Representatives) {
   module M = PM.Fixed[w,fw,reps] ;
   membership : M.GI.In C.cleared = M.fixed-membership k q q-hom in-J ;
  } ;
 } ;
} ;
