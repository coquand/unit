-- Finite correction from the evaluated weighted theorem. All original
-- KG terms are killed by their constructed factorisations through P.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module NA = NatArith[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Kd = GenericDegree[l] ;
-- toB (k + n) = toB k + toB n
toB-plus : (k n : Nat) -> Id Base.Nat (toB (plus k n)) (NA.plus (toB k) (toB n)) = split {
  zero -> \ n -> refl (toB n) ;
  suc k | r -> \ n -> ap (\ x -> suc x) (r n) } ;
addP-pos-correct (k n : Base.Nat) : Id Int (addP (pos k) n) (pos (NA.plus k n)) =
 trans (ShiftedParts[l].addP-pos k n) (ap (\ z -> pos z) (NA.plus-comm n k)) ;
-- N - i = K + 1 for N = K + (i + 1)
lower-pos (K i N : Nat) (h : Id Nat (plus K (suc i)) N) : Id Int (lowerZ (cdeg N) i) (pos (suc (toB K))) = calc Int {
  minus (pos (toB N)) (toB i)
    =< ap (\ x -> minus (pos (toB x)) (toB i)) (sym h) > minus (pos (toB (plus K (suc i)))) (toB i)
    =< ap (\ x -> minus (pos x) (toB i)) (trans (toB-plus K (suc i)) (NA.plus-suc (toB K) (toB i))) > minus (pos (NA.plus (suc (toB K)) (toB i))) (toB i)
    =< ap (\ x -> minus x (toB i)) (sym (addP-pos-correct (suc (toB K)) (toB i))) > minus (addP (pos (suc (toB K))) (toB i)) (toB i)
    =< minus-addP (pos (suc (toB K))) (toB i) > pos (suc (toB K)) } ;

module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (extra t : Nat) (b : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term (plus extra (suc (suc (suc zero)))))) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,plus extra (suc (suc (suc zero)))].Hom (pos (e q)) (p q)) {
 nvar : Nat = plus extra (suc (suc (suc zero))) ;
 module FF = GenericReesFactor[l].Over[K0,A,setA,cfnA,nvar,t,b,s,p,e,hp] ; module LS = FF.LS ; module X = LS.X ;
 module EV = FF.CM.EV ; module J = FF.J ; module CT = GenericCechTheorems[l].Over[A,setA] ;
 module CJ0 = J.At[negsuc zero,Kd.topRank (suc zero)].Q ;
 module CJ1 = J.At[negsuc zero,Kd.topRank (suc (suc zero))].Q ;
 module D0 = CT.Linear[nvar,negsuc zero,Kd.topRank (suc zero)] ;
 d (x : CJ0.Target.M) : CJ1.Target.M = D0.d.f x ;
 module LD = RelationCertificate[l].LinL[A,CJ0.Target,CJ1.Target,D0.d] ;
 module Fixed (w : LS.WC.ReesW) (fw : LS.WC.WithGens[w].F.FixedW) (reps : LS.Fixed[w,fw].Representatives)
  (ws : LS.Fixed[w,fw].Certs) (hr : LS.Fixed[w,fw].Chosen[reps].Certificates[ws].HReps) {
  module F = LS.Fixed[w,fw] ; module C = F.Chosen[reps] ; module K = F.K ;
  module G = FF.CM.Fixed[w,fw,reps] ; module FAC = FF.Fixed[w,fw,reps,ws,hr].At[negsuc zero,Kd.topRank (suc (suc zero))] ;
  hgD (j : Ps.Fin K.na) : G.HR.HomShift zero (F.dX j) (C.gD j) = G.HR.shifted zero (F.dX j) (C.gD j) (G.hom-convert (F.dX j) (C.gD j) (C.hgD j)) ;
  module ED = EvaluatedWeightedDependence[l].Concrete[K0,A,setA,cfnA,t,extra,b].ED.Input[K.na,F.dX,F.dU,C.gD,hgD,C.hfD] ;
  evaluated-action (y : ED.AF.El) : Id CJ1.Target.M (ED.actionA y) (FAC.Sum.lin.f y) =
   J.CE.Cochains[nvar,negsuc zero,Kd.topRank (suc (suc zero))].M.eq _ _ (\ chart m ->
    trans (FAC.CS.ChartSum[negsuc zero,Kd.topRank (suc (suc zero))].val K.na (\ j -> ED.Entries[j].E.AA.lin.f (y j)) chart m)
     (trans (FF.RS.sum-cong K.na
       (\ j -> FF.FA.mulP (EV.evT (C.gD j)) (J.CE.Cochains[nvar,FAC.GD.twists j,Kd.topRank (suc (suc zero))].val (y j) chart) m)
       (\ j -> FF.FA.mulP (C.gA j) (J.CE.Cochains[nvar,FAC.GD.twists j,Kd.topRank (suc (suc zero))].val (y j) chart) m)
       (\ j -> ap (\ ps -> FF.FA.mulP ps (J.CE.Cochains[nvar,FAC.GD.twists j,Kd.topRank (suc (suc zero))].val (y j) chart) m)
          (FF.Fixed[w,fw,reps,ws,hr].ev-list (C.gD j))))
      (sym (FAC.CS.ChartSum[negsuc zero,Kd.topRank (suc (suc zero))].val K.na (\ j -> (FAC.entry j).f (y j)) chart m)))) ;
    module Seq (c : Nat -> ED.W.E1.El) (hc : (n : Nat) -> ED.W.P1.Hom (cdeg (suc n)) (c n))
      (lift : (n : Nat) -> Tr.Trunc[ED.CI.Lifted (c n)].carrier)
      (z : Nat -> CJ0.Target.M) (hz : (n : Nat) -> CJ1.Cong (ED.E1.evc (c n)) (d (z n)))
      (hcompat : (n : Nat) -> CJ0.IJ (suc zero) (CJ0.ML.msub (z n) (z zero))) {
      module ES = ED.Seq[c,hc,lift] ;
      -- sum_{i<N} r_i z_i and sum_{i<N} r_i delta z_i for rs = [r_(N-1), .., r_0]
      sumZ : List X.D.R -> CJ0.Target.M = split {
        nil -> CJ0.Target.mz ;
        cons x xs | r -> CJ0.Target.madd (CJ0.Target.sm (EV.ev.1 x) (z (len xs))) r } ;
      sumD : List X.D.R -> CJ1.Target.M = split {
        nil -> CJ1.Target.mz ;
        cons x xs | r -> CJ1.Target.madd (CJ1.Target.sm (EV.ev.1 x) (d (z (len xs)))) r } ;
      d-sumZ : (xs : List X.D.R) -> Id CJ1.Target.M (d (sumZ xs)) (sumD xs) = split {
        nil -> LD.f-zero ;
        cons x xs | r -> trans (D0.d.f-add (CJ0.Target.sm (EV.ev.1 x) (z (len xs))) (sumZ xs))
                          (CJ1.ML.G.cong-add (D0.d.f-sm (EV.ev.1 x) (z (len xs))) r) } ;
      -- sum r_i delta z_i = sum r_i ev c_i modulo J
      cong-sumD : (xs : List X.D.R) -> CJ1.Cong (sumD xs) (ES.sumA xs) = split {
        nil -> CJ1.cong-refl CJ1.Target.mz ;
        cons x xs | r -> CJ1.cong-add (CJ1.Target.sm (EV.ev.1 x) (d (z (len xs)))) (CJ1.Target.sm (EV.ev.1 x) (ES.cA (len xs)))
          (sumD xs) (ES.sumA xs)
          (CJ1.cong-sm (EV.ev.1 x) (d (z (len xs))) (ES.cA (len xs)) (CJ1.cong-sym (ES.cA (len xs)) (d (z (len xs))) (hz (len xs)))) r } ;
      -- every ev(r_i) z_i is in I C^0(S)
      witS (N : Nat) : (xs : List X.D.R) (Kx : Nat) -> Id Nat (plus Kx (len xs)) N -> ES.PowL N xs -> CJ0.FC.Wit (suc zero) (sumZ xs) = split {
        nil -> \ Kx hK pw -> CJ0.FC.wit-zero (suc zero) ;
        cons x xs | r -> \ Kx hK pw ->
          CJ0.wit1-add (CJ0.Target.sm (EV.ev.1 x) (z (len xs))) (sumZ xs)
            (CJ0.wit1-sm (EV.ev.1 x)
               ((subst (\ k -> CJ0.FA.WitZ k (EV.ev.1 x)) (lower-pos Kx (len xs) N hK) pw.1).1,
                (\ j -> tt, (subst (\ k -> CJ0.FA.WitZ k (EV.ev.1 x)) (lower-pos Kx (len xs) N hK) pw.1).2.2))
               (z (len xs)))
            (r (suc Kx) (trans (sym (plus-suc Kx (len xs))) hK) pw.2) } ;

      -- one evaluated weighted result, with certificates
      module Corr (r : ES.EvResult) {
        module W = ES.WS.WR[r.1] ;
        vA : CJ0.Target.M = ED.E0.evc W.v ;
        -- THE CORRECTION  z = z_N - sum_{i<N} ev(r_i) z_i - ev v
        zc : CJ0.Target.M = CJ0.ML.msub (CJ0.ML.msub (z W.N) (sumZ W.rs)) vA ;
        -- the kernel-generator terms are sum_q P_q (sum_j h_qj ev(a'_j))
        kernel-terms : Id CJ1.Target.M (ED.actionA (ED.evE1 W.a')) (J.At[negsuc zero,Kd.topRank (suc (suc zero))].action.f (FAC.HM.A.lin.f (ED.evE1 W.a'))) = trans (evaluated-action (ED.evE1 W.a')) (FAC.factor (ED.evE1 W.a')) ;
        kernel-J : CJ1.JW (ED.actionA (ED.evE1 W.a')) = (FAC.HM.A.lin.f (ED.evE1 W.a'), kernel-terms) ;
        -- delta z, by linearity
        d-zc : Id CJ1.Target.M (d zc) (CJ1.ML.msub (CJ1.ML.msub (d (z W.N)) (sumD W.rs)) (d vA)) =
          trans (LD.f-sub (CJ0.ML.msub (z W.N) (sumZ W.rs)) vA)
            (ap (\ u -> CJ1.ML.msub u (d vA)) (trans (LD.f-sub (z W.N) (sumZ W.rs)) (ap (CJ1.ML.msub (d (z W.N))) (d-sumZ W.rs)))) ;
        -- (x + y) - x = y
        add-sub (x y : CJ1.Target.M) : Id CJ1.Target.M (CJ1.ML.msub (CJ1.Target.madd x y) x) y = calc CJ1.Target.M {
          CJ1.Target.madd (CJ1.Target.madd x y) (CJ1.Target.mneg x)
            =< ap (\ u -> CJ1.Target.madd u (CJ1.Target.mneg x)) (CJ1.Target.maddC x y) > CJ1.Target.madd (CJ1.Target.madd y x) (CJ1.Target.mneg x)
            =< sym (CJ1.Target.maddA y x (CJ1.Target.mneg x)) > CJ1.Target.madd y (CJ1.Target.madd x (CJ1.Target.mneg x))
            =< ap (CJ1.Target.madd y) (CJ1.Target.maddN x) > CJ1.Target.madd y CJ1.Target.mz
            =< CJ1.Target.maddZ y > y } ;
        -- the evaluated identity, minus delta (ev v)
        ident : Id CJ1.Target.M (CJ1.ML.msub (CJ1.ML.msub (ES.cA W.N) (ES.sumA W.rs)) (d vA)) (ED.actionA (ED.evE1 W.a')) =
          trans (ap (\ u -> CJ1.ML.msub u (d vA)) r.2.1) (add-sub (d vA) (ED.actionA (ED.evE1 W.a'))) ;
        -- delta z = sum_j ev(g_j) ev(a'_j) modulo J
        cong-d : CJ1.Cong (d zc) (ED.actionA (ED.evE1 W.a')) =
          CJ1.cong-trans (d zc) (CJ1.ML.msub (CJ1.ML.msub (ES.cA W.N) (ES.sumA W.rs)) (d vA)) (ED.actionA (ED.evE1 W.a'))
            (CJ1.cong-trans (d zc) (CJ1.ML.msub (CJ1.ML.msub (d (z W.N)) (sumD W.rs)) (d vA)) (CJ1.ML.msub (CJ1.ML.msub (ES.cA W.N) (ES.sumA W.rs)) (d vA))
               (CJ1.cong-of-id (d zc) (CJ1.ML.msub (CJ1.ML.msub (d (z W.N)) (sumD W.rs)) (d vA)) d-zc)
               (CJ1.cong-sub (CJ1.ML.msub (d (z W.N)) (sumD W.rs)) (CJ1.ML.msub (ES.cA W.N) (ES.sumA W.rs)) (d vA) (d vA)
                  (CJ1.cong-sub (d (z W.N)) (ES.cA W.N) (sumD W.rs) (ES.sumA W.rs) (CJ1.cong-sym (ES.cA W.N) (d (z W.N)) (hz W.N)) (cong-sumD W.rs))
                  (CJ1.cong-refl (d vA))))
            (CJ1.cong-of-id (CJ1.ML.msub (CJ1.ML.msub (ES.cA W.N) (ES.sumA W.rs)) (d vA)) (ED.actionA (ED.evE1 W.a')) ident) ;
        -- z is closed in the chart complex of M: delta z in J C^1(-1)
        closed : CJ1.InJ (d zc) =
          CJ1.zero-cong (d zc) (CJ1.cong-trans (d zc) (ED.actionA (ED.evE1 W.a')) CJ1.Target.mz cong-d
            (CJ1.cong-zero (ED.actionA (ED.evE1 W.a')) (CJ1.in-of (ED.actionA (ED.evE1 W.a')) kernel-J))) ;
        -- the degrees: ev(r_i) in I^(N-i) (each in I), ev v in I^(N+1) C^0(S)
        wit-r : CJ0.FC.Wit (suc zero) (sumZ W.rs) = witS W.N W.rs zero (refl W.N) r.2.2.1 ;
        wit-v : CJ0.FC.Wit (suc (toB W.N)) vA = r.2.2.2.1 ;
        rearrange : Id CJ0.Target.M (CJ0.ML.msub zc (z zero)) (CJ0.ML.msub (CJ0.ML.msub (CJ0.ML.msub (z W.N) (z zero)) (sumZ W.rs)) vA) =
          trans (CJ0.ML.sub-comm (CJ0.ML.msub (z W.N) (sumZ W.rs)) vA (z zero))
            (ap (\ u -> CJ0.ML.msub u vA) (CJ0.ML.sub-comm (z W.N) (sumZ W.rs) (z zero))) ;
        -- z - z_0 in I C^0(M)
        reduces : CJ0.IJ (suc zero) (CJ0.ML.msub zc (z zero)) =
          subst (CJ0.IJ (suc zero)) (sym rearrange)
            (CJ0.ij-sub (CJ0.ML.msub (CJ0.ML.msub (z W.N) (z zero)) (sumZ W.rs)) vA
              (CJ0.ij-sub (CJ0.ML.msub (z W.N) (z zero)) (sumZ W.rs) (hcompat W.N) wit-r)
              (CJ0.wit-one (toB W.N) vA wit-v)) ;
      } ;

      Corrected : U l = (zz : CJ0.Target.M) * (CJ1.InJ (d zz) * CJ0.IJ (suc zero) (CJ0.ML.msub zz (z zero))) ;
      correction : Tr.Trunc[Corrected].carrier = TC.map ES.EvResult Corrected
       (\ r -> (Corr[r].zc,(Corr[r].closed,Corr[r].reduces))) ES.evaluated ;
    } ;
 } ;
} ;
