-- Five-coordinate nonzero polynomial/chart memberships use the constructed
-- Rees list. The chart may be any bitset, including proper intersections.
-- The evaluated input is the newest variable X4, with coefficient one.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ; open GenericCube[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module N = FiniteExponents[l] ; module L = GenericLaurent[l] ; module CD = ChartDenominators[l] ; module XB = LaurentExponentBridge[l] ;
one : Nat = suc zero ; two : Nat = suc one ; four : Nat = suc (suc two) ; five : Nat = suc four ;
oneB : Base.Nat = suc zero ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) {
 module B = PolynomialTowerBridge[l].Over[A,setA] ; module ZD = GenericCertificateRegression[l] ;
 ex : N.Exp five = N.join four (N.zeroE four) oneB ;
 degree : Id Base.Nat (N.degree five ex) oneB = trans (ap (NatArith[l].plus oneB) (ZD.degree-zero four)) (NatArith[l].plus-zero oneB) ;
 ps : List (B.Term five) = cons (A.o,ex) nil ;
 p (i : Ps.Fin one) : List (B.Term five) = ps ;
 e (i : Ps.Fin one) : Base.Nat = oneB ;
 hp (i : Ps.Fin one) : CechPolynomialAction[l].Over[A,setA,five].Hom (pos oneB) (p i) = (ap (\ d -> pos d) degree,tt) ;
 b (i : Ps.Fin one) : A.R = A.o ;
 module LL = GenericLocalizedReesLift[l].Over[K0,A,setA,cfnA,five,one,b,one,p,e,hp] ; module X = LL.X ; module LS = LL.LM.PM.L ;
 uj : Ps.Fin one = inr tt ;
 qs : List (X.BD.Term five) = cons (X.GD.var uj,ex) nil ;
 hqs : LL.LM.PM.PH.CoefHom oneB five qs = (X.GD.var-hom uj,tt) ;
 ev-list : Id (List (B.Term five)) (X.evT qs) ps = ap (\ c -> cons (c,ex) nil) (X.GD.ev-var b uj) ;
 module RK = X.RR.RK ;
 gen-eq : Id X.RR.S.R (RK.RSB.comb one (\ i -> X.RR.S.o) X.RR.P) (B.phi five ps) =
  trans (X.RR.S.addZ (X.RR.S.mul X.RR.S.o (X.RR.P uj)))
    (trans (X.RR.S.mulC X.RR.S.o (X.RR.P uj)) (X.RR.S.mulO (X.RR.P uj))) ;
 in-J : RK.InJ (B.phi five (X.evT qs)) = Tr.Trunc[RK.JW (B.phi five (X.evT qs))].inc
  (\ i -> X.RR.S.o,trans (ap (B.phi five) ev-list) (sym gen-eq)) ;
 module Selected (dat : LS.Data) {
  module F = LS.Fixed[dat.1,dat.2.1] ; module C = F.Chosen[dat.2.2.1] ;
  module PM = LL.LM.PM.Fixed[dat.1,dat.2.1,dat.2.2.1] ;
  polynomial-membership : PM.GI.In (X.BD.phi five qs) = PM.fixed-membership oneB qs hqs in-J ;
 } ;
 SelectedMembership : U l = (dat : LS.Data) * Selected[dat].PM.GI.In (X.BD.phi five qs) ;
 polynomial-membership : Tr.Trunc[SelectedMembership].carrier = TC.map LS.Data SelectedMembership
  (\ dat -> (dat,Selected[dat].polynomial-membership)) LS.constructed ;
 module LC = LL.LC ; module AC = LL.LM.LC ; module CH = GenericCoefficientPolynomialHom[l].Over[A,one,X.D,X.setD,X.GD,five] ;
 module EN = LaurentCoefficientNaturality[l].Over[X.D,A,X.setD,setA,X.evD,five] ;
 f : L.Exp five -> X.D.R = LC.coeff (X.BD.phi five qs) ;
 v (i : Ps.Fin one) : L.Exp five -> A.R = AC.coeff X.RR.S.o ;
 fh (m : L.Exp five) : X.GDL.Hom (pos oneB) (f m) = CH.homogeneous oneB qs (X.GD.var-hom uj,tt) m ;
 eval-input (m : L.Exp five) : Id A.R (X.evD.1 (f m)) (AC.coeff (B.phi five ps) m) =
  trans (EN.equation qs m) (ap (\ q -> AC.coeff (B.phi five q) m) ev-list) ;
 action-input (m : L.Exp five) : Id A.R (LL.LM.FA.RS.sum one (\ i -> LL.LM.FA.mulP (p i) (v i) m)) (AC.coeff (B.phi five ps) m) =
  trans (A.addZ (LL.LM.FA.mulP ps (v uj) m))
   (trans (LL.LM.TA.action ps X.RR.S.o m) (ap (\ x -> AC.coeff x m) (X.RR.S.mulO (B.phi five ps)))) ;
 eq (m : L.Exp five) : Id A.R (X.evD.1 (f m)) (LL.LM.FA.RS.sum one (\ i -> LL.LM.FA.mulP (p i) (v i) m)) =
  trans (eval-input m) (sym (action-input m)) ;
 evaluated-coordinate : Id A.R (X.evD.1 (f (XB.At[five].emb ex))) A.o =
  trans (eval-input (XB.At[five].emb ex))
   (trans (AC.coeff-emb (B.phi five ps) ex)
    (trans (B.coeff-phi five ps ex)
      (trans (ap (\ c -> A.add c A.z) (FinitePolynomial4[l].sel-yes A A.o (Id (N.Exp five) ex ex) (refl ex) (N.dec five ex ex))) (A.addZ A.o)))) ;
 module Supports (sw : LC.Support (X.BD.phi five qs)) (vw : AC.Support X.RR.S.o) {
  support : List (L.Exp five) = L.append (L.Exp five) sw.1 vw.1 ;
  fs (m : L.Exp five) (nm : Not (L.Mem (L.Exp five) m support)) : Id X.D.R (f m) X.D.z = sw.2 m (\ h -> nm (L.mem-left (L.Exp five) m sw.1 vw.1 h)) ;
  vs (i : Ps.Fin one) (m : L.Exp five) (nm : Not (L.Mem (L.Exp five) m support)) : Id A.R (v i m) A.z = vw.2 m (\ h -> nm (L.mem-right (L.Exp five) m sw.1 vw.1 h)) ;
  module Chart (chart : Sub five) {
   fv (m : L.Exp five) (bad : GenericSupport[l].bad five (L.mask five m) chart) : Id X.D.R (f m) X.D.z =
    LC.coeff-neg (X.BD.phi five qs) m (CD.bad-witness five chart m bad).1 (CD.bad-witness five chart m bad).2.1 ;
   vv (i : Ps.Fin one) (m : L.Exp five) (bad : GenericSupport[l].bad five (L.mask five m) chart) : Id A.R (v i m) A.z =
    AC.coeff-neg X.RR.S.o m (CD.bad-witness five chart m bad).1 (CD.bad-witness five chart m bad).2.1 ;
   module Input = LL.LM.Chart[chart,support,oneB,f,fs,fv,fh,v,vs,vv,eq] ;
   module Fixed (dat : LS.Data) {
    membership : Selected[dat].PM.GI.In Input.C.cleared = Input.Fixed[dat.1,dat.2.1,dat.2.2.1].membership ;
   } ;
  } ;
 } ;
 module WithData (dat : LS.Data) (sw : LC.Support (X.BD.phi five qs)) (vw : AC.Support X.RR.S.o) (chart : Sub five) {
  module S = Supports[sw,vw] ; module Q = S.Chart[chart] ;
  module LP = LL.Fixed[dat.1,dat.2.1,dat.2.2.1].Chart[chart,S.support,oneB,pos oneB,f,S.fs,Q.fv,fh,
    LC.Degree[pos oneB,X.BD.phi five qs,LL.hom-phi oneB qs (ap (\ x -> pos x) degree,tt)].homogeneous,v,S.vs,Q.vv,eq] ;
  lift : Tr.Trunc[LP.Coordinates].carrier = LP.membership ;
 } ;
 ChartResult (chart : Sub five) : U l = (dat : LS.Data) * ((sw : LC.Support (X.BD.phi five qs)) *
   ((vw : AC.Support X.RR.S.o) * WithData[dat,sw,vw,chart].LP.Coordinates)) ;
 chart-lift (chart : Sub five) : Tr.Trunc[ChartResult chart].carrier = TC.bind LS.Data (ChartResult chart)
  (\ dat -> TC.bind (LC.Support (X.BD.phi five qs)) (ChartResult chart)
   (\ sw -> TC.bind (AC.Support X.RR.S.o) (ChartResult chart)
    (\ vw -> TC.map WithData[dat,sw,vw,chart].LP.Coordinates (ChartResult chart)
      (\ co -> (dat,(sw,(vw,co)))) WithData[dat,sw,vw,chart].lift) (AC.finite X.RR.S.o))
    (LC.finite (X.BD.phi five qs))) LS.constructed ;

} ;

module OverZ {
 module Z = Over[Nat * Nat,ZRing[l].ring,int-set,ZCFN[l].cfn] ;
 -- This evaluated coefficient is the integer 1, so the memberships above
 -- do not test only a zero input or a zero generator.
 coefficient-one : Id ZRing[l].ring.R (Z.X.evD.1 (Z.f (XB.At[five].emb Z.ex))) (pos (suc zero)) = Z.evaluated-coordinate ;
 localized (chart : Sub five) : Tr.Trunc[Z.ChartResult chart].carrier = Z.chart-lift chart ;
} ;
