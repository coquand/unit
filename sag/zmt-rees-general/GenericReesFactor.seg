-- The evaluated fixed KG action factors through the ORIGINAL equation
-- action on actual generic Cech modules, in every twist and cardinality.
level l ; open Ring[l] ; open ZInt[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module L = GenericLaurent[l] ;
module PA = PolynomialAction4[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (nvar t : Nat) (b0 : Ps.Fin t -> A.R) (s : Nat)
 (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar)) (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module CM = GenericReesCochainMembership[l].Over[K0,A,setA,cfnA,nvar,t,b0,s,p,e,hp] ; module LS = CM.LM.PM.L ;
 module J = CM.J ; module M = J.M ; module MA = MatrixActionLaws[l].Over[A,setA,nvar] ; module FA = MA.FA ; module RS = MA.RS ;
 module Fixed (w : LS.WC.ReesW) (fw : LS.WC.WithGens[w].F.FixedW) (reps : LS.Fixed[w,fw].Representatives)
  (ws : LS.Fixed[w,fw].Certs) (hr : LS.Fixed[w,fw].Chosen[reps].Certificates[ws].HReps) {
  module F = LS.Fixed[w,fw] ; module C = F.Chosen[reps] ; module H = C.Certificates[ws].Factorized[hr] ;
  module G = CM.Fixed[w,fw,reps] ; module K = F.K ;
  hh (q : Ps.Fin s) (j : Ps.Fin K.na) : M.HomShift (e q) (F.dX j) (H.h q j) = J.shifted-convert (e q) (F.dX j) (H.h q j) (H.hh q j) ;
  ev-list : (ps : List (CM.X.BD.Term nvar)) -> Id (List (LS.RR.BR.Term nvar)) (CM.EV.evT ps) (CM.X.evT ps) = split {
   nil -> refl nil ; cons u us | rec -> ap (\ xs -> cons (CM.EV.ev.1 u.1,u.2) xs) rec } ;
  module At (twist rank : Int) {
   module JA = J.At[twist,rank] ; module GD = G.At[twist,rank] ;
   module AF = M.Family[K.na,GD.twists,rank] ;
   module HM = MA.Matrix[s,K.na,JA.ki,GD.twists,H.h,\ q j -> M.shifts twist (e q) (F.dX j) (H.h q j) (hh q j),rank] ;
   hgA (j : Ps.Fin K.na) : M.HomShift zero (F.dX j) (C.gA j) = subst (M.HomShift zero (F.dX j)) (ev-list (C.gD j)) (CM.EV.hom-evT zero (F.dX j) (C.gD j) (G.hg j)) ;
   entry (j : Ps.Fin K.na) : IP.Lin[A,AF.Md j,JA.Target.mod] = M.A.Act[GD.twists j,twist,rank,C.gA j,M.shifts twist zero (F.dX j) (C.gA j) (hgA j)].lin ;
   module Sum = AF.Prod.SumMap[JA.Target.mod,entry] ;
   module CS = GlobalCechSyzygies[l].Over[A,setA,nvar] ;
   col (z : AF.El) (j : Ps.Fin K.na) (chart : GenericCube[l].Sub nvar) (m : L.Exp nvar) :
    Id A.R (RS.sum s (\ q -> FA.mulP (p q) (\ x -> FA.mulP (H.h q j) (J.CE.Cochains[nvar,GD.twists j,rank].val (z j) chart) x) m))
      (FA.mulP (C.gA j) (J.CE.Cochains[nvar,GD.twists j,rank].val (z j) chart) m) =
    trans (RS.sum-cong s _ _ (\ q -> sym (FA.mulP-pmul (p q) (H.h q j) (J.CE.Cochains[nvar,GD.twists j,rank].val (z j) chart) m)))
      (trans (sym (FA.mulP-psum s (\ q -> FA.pmul (p q) (H.h q j)) (J.CE.Cochains[nvar,GD.twists j,rank].val (z j) chart) m))
        (sym (FA.act-coef (C.gA j) (FA.psum s (\ q -> FA.pmul (p q) (H.h q j))) (H.factor j) (J.CE.Cochains[nvar,GD.twists j,rank].val (z j) chart) m))) ;
   module Point (z : AF.El) (chart : GenericCube[l].Sub nvar) (m : L.Exp nvar) {
    zz (j : Ps.Fin K.na) : L.Exp nvar -> A.R = J.CE.Cochains[nvar,GD.twists j,rank].val (z j) chart ;
    old (q : Ps.Fin s) : L.Exp nvar -> A.R = J.CE.Cochains[nvar,JA.ki q,rank].val (HM.A.lin.f z q) chart ;
    inn (q : Ps.Fin s) (x : L.Exp nvar) : A.R = RS.sum K.na (\ j -> FA.mulP (H.h q j) (zz j) x) ;
    nested (q : Ps.Fin s) (j : Ps.Fin K.na) : A.R = FA.mulP (p q) (\ x -> FA.mulP (H.h q j) (zz j) x) m ;
    first : Id A.R (JA.Target.val (JA.action.f (HM.A.lin.f z)) chart m) (RS.sum s (\ q -> FA.mulP (p q) (old q) m)) =
      CS.ChartSum[twist,rank].val s (\ q -> (JA.entry q).f (HM.A.lin.f z q)) chart m ;
    second : Id A.R (RS.sum s (\ q -> FA.mulP (p q) (old q) m)) (RS.sum s (\ q -> FA.mulP (p q) (inn q) m)) =
      RS.sum-cong s (\ q -> FA.mulP (p q) (old q) m) (\ q -> FA.mulP (p q) (inn q) m)
       (\ q -> FA.mulP-cong (p q) (old q) (inn q) (\ x -> HM.value z q chart x) m) ;
    third : Id A.R (RS.sum s (\ q -> FA.mulP (p q) (inn q) m)) (RS.sum s (\ q -> RS.sum K.na (nested q))) =
      RS.sum-cong s (\ q -> FA.mulP (p q) (inn q) m) (\ q -> RS.sum K.na (nested q))
       (\ q -> MA.mul-sum (p q) m K.na (\ j x -> FA.mulP (H.h q j) (zz j) x)) ;
    fourth : Id A.R (RS.sum s (\ q -> RS.sum K.na (nested q))) (RS.sum K.na (\ j -> FA.mulP (C.gA j) (zz j) m)) =
      trans (RS.sum-swap s K.na nested)
       (RS.sum-cong K.na (\ j -> RS.sum s (\ q -> nested q j)) (\ j -> FA.mulP (C.gA j) (zz j) m) (\ j -> col z j chart m)) ;
    fifth : Id A.R (RS.sum K.na (\ j -> FA.mulP (C.gA j) (zz j) m)) (JA.Target.val (Sum.lin.f z) chart m) =
      sym (CS.ChartSum[twist,rank].val K.na (\ j -> (entry j).f (z j)) chart m) ;
    equation : Id A.R (JA.Target.val (JA.action.f (HM.A.lin.f z)) chart m) (JA.Target.val (Sum.lin.f z) chart m) =
      trans first (trans second (trans third (trans fourth fifth))) ;
   } ;
   factor (z : AF.El) : Id JA.Target.El (Sum.lin.f z) (JA.action.f (HM.A.lin.f z)) =
     sym (JA.Target.M.eq _ _ (\ chart m -> Point[z,chart,m].equation)) ;
   in-J (z : AF.El) : JA.Q.InJ (Sum.lin.f z) = JA.Q.in-of (Sum.lin.f z) (HM.A.lin.f z,factor z) ;
  } ;
 } ;
} ;
