-- An explicit ideal-power tree gives a coefficient-homogeneous lift.
-- Replace each ideal generator b_j by U_j, preserving the chart module.
-- This construction is a function of the witness and uses no choice.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module RH = RingHom[l] ;
module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (t : Nat) (D : CRing) (setD : Pr.isSet D.R)
 (G : Graded[A,t,D]) (b : Ps.Fin t -> A.R) (nvar : Nat) {
 module EV = GenericCoefficientEvaluation[l].Over[A,setA,t,D,setD,G,b,nvar] ; module GL = EV.GL ;
 module Chart (Ex I : U l) (Bad : I -> Ex -> U l) {
  module E = EV.EvChart[Ex,I,Bad] ; module CA = E.CHA ; module CD = E.CHD ; module P = E.P ;
  module SD = E.SD ; module SA = E.SA ;
  raw (x : CA.El) : CD.Raw = \ i m -> G.iota.1 (CA.val x i m) ;
  base (x : CA.El) : CD.El = CD.mk (raw x)
   (TC.map (CA.SuppW (CA.val x)) (CD.SuppW (raw x))
     (\ w -> (w.1,\ i m nm -> trans (ap G.iota.1 (w.2 i m nm)) (RH.zero A D G.iota))) (CA.supp x))
   (\ i m bad -> trans (ap G.iota.1 (CA.van x i m bad)) (RH.zero A D G.iota)) ;
  base-hom (x : CA.El) : P.Hom zeroZ (base x) = \ i m -> GL.hom-iota (CA.val x i m) ;
  base-eval (x : CA.El) : Id CA.El (E.evc (base x)) x = CA.eq _ _ (\ i m -> G.ev-iota b (CA.val x i m)) ;
  Lift (k : Base.Nat) (x : CA.El) : U l = (c : CD.El) * (P.Hom (pos k) c * Id CA.El (E.evc c) x) ;
  module Step (k : Base.Nat) (x : CA.El) (w : E.FC.Wit (suc k) x) (ls : (j : Ps.Fin t) -> Lift k (w.1 j)) {
   c : CD.El = SD.sum t (\ j -> CD.mod.sm (G.var j) (ls j).1) ;
   val (i : I) (m : Ex) : Id D.R (CD.val c i m) (GL.RS.sum t (\ j -> D.mul (G.var j) (CD.val (ls j).1 i m))) =
    GlobalValues t (\ j -> CD.mod.sm (G.var j) (ls j).1) i m
    where { GlobalValues : (a : Nat) (xs : Ps.Fin a -> CD.El) (i : I) (m : Ex) ->
     Id D.R (CD.val (SD.sum a xs) i m) (GL.RS.sum a (\ j -> CD.val (xs j) i m)) = split {
      zero -> \ xs i m -> refl D.z ; suc a | rec -> \ xs i m -> ap (D.add (CD.val (xs (inr tt)) i m)) (rec (\ j -> xs (inl j)) i m) } } ;
   hom (i : I) (m : Ex) : GL.Hom (pos (suc k)) (CD.val c i m) = subst (GL.Hom (pos (suc k))) (sym (val i m))
    (GL.hom-sum (pos (suc k)) t (\ j -> D.mul (G.var j) (CD.val (ls j).1 i m))
      (\ j -> subst (GL.Hom (pos (suc k))) (D.mulC (CD.val (ls j).1 i m) (G.var j))
        (GL.hom-mul (pos k) (pos (suc zero)) (CD.val (ls j).1 i m) (G.var j) ((ls j).2.1 i m) (G.var-hom j)))) ;
   equation : Id CA.El (E.evc c) x = trans (E.evc-sum t (\ j -> CD.mod.sm (G.var j) (ls j).1))
    (trans (SA.sum-cong t (\ j -> E.evc (CD.mod.sm (G.var j) (ls j).1)) (\ j -> CA.mod.sm (b j) (w.1 j)) (\ j -> trans (E.evc-sm (G.var j) (ls j).1)
       (trans (ap (\ a -> CA.mod.sm a (E.evc (ls j).1)) (G.ev-var b j)) (ap (CA.mod.sm (b j)) (ls j).2.2))))
      (sym w.2.2)) ;
   result : Lift (suc k) x = (c,(hom,equation)) ;
  } ;
  lift : (k : Base.Nat) (x : CA.El) -> E.FC.Wit k x -> Lift k x = split {
   zero -> \ x w -> (base x,(base-hom x,base-eval x)) ;
   suc k | rec -> \ x w -> Step[k,x,w,\ j -> rec (w.1 j) (w.2.1 j)].result } ;
 } ;
} ;
