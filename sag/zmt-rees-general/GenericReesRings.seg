-- Rees elimination and finite bihomogeneous kernel generators over an
-- arbitrary finite-coordinate polynomial tower. The elimination theorem
-- and finite component extraction are the unchanged generic Rees*4 proofs;
-- no four-coordinate exponent or chart is used here.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Rings (A : CRing) (setA : Pr.isSet A.R) (nvar t : Nat) (b0 : Ps.Fin t -> A.R)
 (s : Nat) (p : Ps.Fin s -> List (PolynomialTowerBridge[l].Over[A,setA].Term nvar))
 (e : Ps.Fin s -> Base.Nat)
 (hp : (q : Ps.Fin s) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos (e q)) (p q)) {
 module BR = PolynomialTowerBridge[l].Over[A,setA] ; module XT = BR.T ;
 S : CRing = XT.D nvar ; setS : Pr.isSet S.R = XT.setD nvar ;
 GX : Graded[A,nvar,S] = XT.grD nvar ;
 module GXL = Laws[A,nvar,S,setS,GX] ;
 module DG = PolynomialDegreeBridge[l].Over[A,setA] ;
 hom-phi (dd : Base.Nat) : (ps : List (BR.Term nvar)) -> CechPolynomialAction[l].Over[A,setA,nvar].Hom (pos dd) ps ->
   GXL.Hom (pos dd) (BR.phi nvar ps) = split {
   nil -> \ h -> GXL.hom-zero (pos dd) ;
   cons u ps | rec -> \ h -> GXL.hom-add (pos dd) (BR.term nvar u) (BR.phi nvar ps)
     (subst (\ k -> GXL.Hom k (BR.term nvar u)) h.1 (DG.term-hom nvar u)) (rec h.2) } ;
 P (q : Ps.Fin s) : S.R = BR.phi nvar (p q) ;
 hP (q : Ps.Fin s) : GXL.Hom (pos (e q)) (P q) = hom-phi (e q) (p q) (hp q) ;
 module UT = CoefficientPolynomial[l].CoefficientTower[S,setS] ;
 R : CRing = UT.D t ; setR : Pr.isSet R.R = UT.setD t ;
 GU : Graded[S,t,R] = UT.grD t ;
 b (j : Ps.Fin t) : S.R = GX.iota.1 (b0 j) ;
 hb (j : Ps.Fin t) : Id S.R (GX.pr zeroZ (b j)) (b j) = GX.iota-hom (b0 j) ;
 module RC = ReesComponents4[l].Over[A,nvar,S,setS,GX,t,R,setR,GU,b,s,P,e,hP,hb] ;
 module RK = RC.RK ;
 decB : (y : S.R) -> RC.DX.FinDeg y = DegreeDecomposition4[l].TowerDecomposition[A,setA].fin-deg nvar ;
 decR : (x : R.R) -> RC.DU.FinDeg x = DegreeDecomposition4[l].TowerDecomposition[S,setS].fin-deg t ;
 module FL = ReesFiniteList4[l].Over[A,nvar,S,setS,GX,t,R,setR,GU,b,s,P,e,hP,hb] ;
 module WithCFN (K0 : U l) (cfnA : CFN[l].CFN[K0,A]) {
   cfnS : CFN[l].CFN[K0,S] = XT.cfnD K0 cfnA nvar ;
   cfnR : CFN[l].CFN[K0,R] = UT.cfnD K0 cfnS t ;
   module DC = DegreeCor[l].Free[R,cfnR.disc,cfnR.coh,CFN[l].fl K0 R cfnR,suc zero,suc zero,RK.RG.S,RK.RG.gens] ;
   module MS = Spans[l].Over[R,RK.SQ.blk (suc zero)] ;
   ReesW : U l = (Gs : List RK.Blk1) * (DegreeCor[l].AllL RK.Blk1 RK.Elim Gs *
     ((u : RK.Blk1) -> RK.Elim u -> MS.Mm Gs u)) ;
   presentation : Tr.Trunc[ReesW].carrier = DC.gen zero ;
   module WithGens (w : ReesW) { module F = FL.Gens[decB,decR,w.1,w.2.1,w.2.2] ; } ;
   ListW : U l = (w : ReesW) * WithGens[w].F.FiniteGen ;
   finite-list : Tr.Trunc[ListW].carrier = TC.bind ReesW ListW
     (\ w -> TC.map WithGens[w].F.FiniteGen ListW (\ x -> (w,x)) WithGens[w].F.finite-generation) presentation ;
 } ;
} ;
