-- Scalar extension of a finite free algebra, constructed on B^n.
-- Multiplication uses the structure constants lambda_i(b_j b_k), mapped
-- from R to B.  It is bilinear.  Its identities on the pure R-vectors
-- follow from reconstruction in S; linear extensionality then reduces
-- associativity, commutativity and the unit law to basis vectors.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (S B : Algebras[l].Over[R,setR].Algebra)
 (n : Nat) (b : TraceBasis[l].Over[R,setR,S].Basis[n]) {
 module C = Algebras[l].Over[R,setR] ;
 module V = FiniteVectorLinear[l].Over[B.ring,B.set,n] ;
 module BS = FiniteIdeal[l].Sums[B.ring] ;
 module TB = TraceBasis[l].Over[R,setR,S].At[n,b] ;
 module DM = Determinant[l].Over[B.ring,B.set] ;
 module Iota = DeterminantLemma[l].Map[R,B.ring,setR,B.set,B.iota] ;
 matrix (a : S.ring.R) : DM.Mat n = \ j i -> B.iota.1 (b.coordinate (S.ring.mul a (b.vector j)) i) ;
 row (a : S.ring.R) (v : V.V) : V.V = DM.act n (matrix a) v ;
 row-linear (a : S.ring.R) : V.Linear[row a] =
  V.mkLinear (row a)
   (\ v w -> V.ext _ _ (DM.act-add n (matrix a) v w))
   (\ c v -> V.ext _ _ (DM.act-scale n (matrix a) c v)) ;
 product (v w : V.V) : V.V = \ i -> BS.sum n (\ j -> B.ring.mul (v j) (row (b.vector j) w i)) ;
 linear-left (w : V.V) : V.Linear[\ v -> product v w] =
  V.mkLinear (\ v -> product v w)
   (\ v u -> V.ext _ _ (\ i ->
    trans (BS.sum-cong n
      (\ j -> B.ring.mul (B.ring.add (v j) (u j)) (row (b.vector j) w i))
      (\ j -> B.ring.add (B.ring.mul (v j) (row (b.vector j) w i)) (B.ring.mul (u j) (row (b.vector j) w i)))
      (\ j -> RL[B.ring].dist-left (v j) (u j) (row (b.vector j) w i)))
     (BS.sum-add n (\ j -> B.ring.mul (v j) (row (b.vector j) w i)) (\ j -> B.ring.mul (u j) (row (b.vector j) w i)))))
   (\ a v -> V.ext _ _ (\ i ->
    trans (BS.sum-cong n
      (\ j -> B.ring.mul (B.ring.mul a (v j)) (row (b.vector j) w i))
      (\ j -> B.ring.mul a (B.ring.mul (v j) (row (b.vector j) w i)))
      (\ j -> sym (B.ring.mulA a (v j) (row (b.vector j) w i))))
     (BS.sum-scale a n (\ j -> B.ring.mul (v j) (row (b.vector j) w i))))) ;
 linear-right (v : V.V) : V.Linear[product v] =
  V.mkLinear (product v)
   (\ w u -> V.ext _ _ (\ i ->
    trans (BS.sum-cong n
      (\ j -> B.ring.mul (v j) (row (b.vector j) (V.add w u) i))
      (\ j -> B.ring.add (B.ring.mul (v j) (row (b.vector j) w i)) (B.ring.mul (v j) (row (b.vector j) u i))) (\ j ->
      trans (ap (B.ring.mul (v j)) (ap (\ t -> t i) ((row-linear (b.vector j)).preserves-add w u)))
       (B.ring.dist (v j) (row (b.vector j) w i) (row (b.vector j) u i))))
     (BS.sum-add n (\ j -> B.ring.mul (v j) (row (b.vector j) w i)) (\ j -> B.ring.mul (v j) (row (b.vector j) u i)))))
   (\ a w -> V.ext _ _ (\ i ->
    trans (BS.sum-cong n
      (\ j -> B.ring.mul (v j) (row (b.vector j) (V.scale a w) i))
      (\ j -> B.ring.mul a (B.ring.mul (v j) (row (b.vector j) w i))) (\ j ->
      trans (ap (B.ring.mul (v j)) (ap (\ t -> t i) ((row-linear (b.vector j)).preserves-scale a w)))
       (RL[B.ring].mul-swap (v j) a (row (b.vector j) w i))))
     (BS.sum-scale a n (\ j -> B.ring.mul (v j) (row (b.vector j) w i))))) ;
 pure (a : S.ring.R) : V.V = \ i -> B.iota.1 (b.coordinate a i) ;
 pure-add (a c : S.ring.R) : Id V.V (pure (S.ring.add a c)) (V.add (pure a) (pure c)) =
  V.ext _ _ (\ i -> trans (ap B.iota.1 (b.add a c i)) (B.iota.2.2.1 (b.coordinate a i) (b.coordinate c i))) ;
 row-pure (a c : S.ring.R) : Id V.V (row a (pure c)) (pure (S.ring.mul a c)) =
  V.ext _ _ (\ i ->
   trans (BS.sum-cong n
     (\ j -> B.ring.mul (B.iota.1 (b.coordinate c j)) (B.iota.1 (b.coordinate (S.ring.mul a (b.vector j)) i)))
     (\ j -> B.iota.1 (R.mul (b.coordinate c j) (b.coordinate (S.ring.mul a (b.vector j)) i)))
     (\ j -> sym (B.iota.2.2.2 (b.coordinate c j) (b.coordinate (S.ring.mul a (b.vector j)) i))))
    (trans (sym (Iota.sum-map n (\ j -> R.mul (b.coordinate c j) (b.coordinate (S.ring.mul a (b.vector j)) i))))
     (ap B.iota.1 (sym (TB.product-coordinate a c i))))) ;
 pure-product (a c : S.ring.R) : Id V.V (product (pure a) (pure c)) (pure (S.ring.mul a c)) =
  trans (V.ext _ _ (\ i -> BS.sum-cong n
    (\ j -> B.ring.mul (pure a j) (row (b.vector j) (pure c) i))
    (\ j -> B.ring.mul (pure a j) (B.iota.1 (b.coordinate (S.ring.mul c (b.vector j)) i)))
    (\ j -> ap (B.ring.mul (pure a j))
     (trans (ap (\ v -> v i) (row-pure (b.vector j) c))
      (ap (\ x -> B.iota.1 (b.coordinate x i)) (S.ring.mulC (b.vector j) c))))))
   (trans (row-pure c a) (ap pure (S.ring.mulC c a))) ;
 pure-basis (j : Fin n) : Id V.V (pure (b.vector j)) (V.unit j) =
  V.ext _ _ (\ i -> trans (ap B.iota.1 (b.on-vector j i)) (Iota.delta-map n i j)) ;
 Associative (v w u : V.V) : U l = Id V.V (product v (product w u)) (product (product v w) u) ;
 pure-assoc (a c d : S.ring.R) : Associative (pure a) (pure c) (pure d) =
  trans (ap (product (pure a)) (pure-product c d))
   (trans (pure-product a (S.ring.mul c d))
    (trans (ap pure (S.ring.mulA a c d))
     (trans (sym (pure-product (S.ring.mul a c) d))
      (ap (\ v -> product v (pure d)) (sym (pure-product a c)))))) ;
 basis-assoc (j k h : Fin n) : Associative (V.unit j) (V.unit k) (V.unit h) =
  subst (\ v -> Associative v (V.unit k) (V.unit h)) (pure-basis j)
   (subst (\ w -> Associative (pure (b.vector j)) w (V.unit h)) (pure-basis k)
    (subst (Associative (pure (b.vector j)) (pure (b.vector k))) (pure-basis h)
     (pure-assoc (b.vector j) (b.vector k) (b.vector h)))) ;
 assoc-two (j k : Fin n) (u : V.V) : Associative (V.unit j) (V.unit k) u =
  V.maps-equal (\ u -> product (V.unit j) (product (V.unit k) u)) (product (product (V.unit j) (V.unit k)))
   (V.compose (product (V.unit k)) (product (V.unit j)) (linear-right (V.unit k)) (linear-right (V.unit j)))
   (linear-right (product (V.unit j) (V.unit k))) (basis-assoc j k) u ;
 assoc-one (j : Fin n) (w u : V.V) : Associative (V.unit j) w u =
  V.maps-equal (\ w -> product (V.unit j) (product w u)) (\ w -> product (product (V.unit j) w) u)
   (V.compose (\ w -> product w u) (product (V.unit j)) (linear-left u) (linear-right (V.unit j)))
   (V.compose (product (V.unit j)) (\ w -> product w u) (linear-right (V.unit j)) (linear-left u))
   (\ k -> assoc-two j k u) w ;
 associative (v w u : V.V) : Associative v w u =
  V.maps-equal (\ v -> product v (product w u)) (\ v -> product (product v w) u)
   (linear-left (product w u))
   (V.compose (\ v -> product v w) (\ v -> product v u) (linear-left w) (linear-left u))
   (\ j -> assoc-one j w u) v ;
 pure-comm (a c : S.ring.R) : Id V.V (product (pure a) (pure c)) (product (pure c) (pure a)) =
  trans (pure-product a c) (trans (ap pure (S.ring.mulC a c)) (sym (pure-product c a))) ;
 basis-comm (j k : Fin n) : Id V.V (product (V.unit j) (V.unit k)) (product (V.unit k) (V.unit j)) =
  subst (\ v -> Id V.V (product v (V.unit k)) (product (V.unit k) v)) (pure-basis j)
   (subst (\ w -> Id V.V (product (pure (b.vector j)) w) (product w (pure (b.vector j)))) (pure-basis k)
    (pure-comm (b.vector j) (b.vector k))) ;
 comm-one (j : Fin n) (w : V.V) : Id V.V (product (V.unit j) w) (product w (V.unit j)) =
  V.maps-equal (product (V.unit j)) (\ w -> product w (V.unit j))
   (linear-right (V.unit j)) (linear-left (V.unit j)) (basis-comm j) w ;
 commutative (v w : V.V) : Id V.V (product v w) (product w v) =
  V.maps-equal (\ v -> product v w) (product w) (linear-left w) (linear-right w)
   (\ j -> comm-one j w) v ;
 one : V.V = pure S.ring.o ;
 basis-one (j : Fin n) : Id V.V (product (V.unit j) one) (V.unit j) =
  trans (ap (\ v -> product v one) (sym (pure-basis j)))
   (trans (pure-product (b.vector j) S.ring.o) (trans (ap pure (S.ring.mulO (b.vector j))) (pure-basis j))) ;
 right-one (v : V.V) : Id V.V (product v one) v =
  V.maps-equal (\ v -> product v one) (\ v -> v) (linear-left one) V.identity basis-one v ;
 ring : CRing = mkCRing V.V V.z one V.add product V.neg
  V.add-assoc V.add-comm V.add-zero V.add-neg associative commutative right-one
  (\ v w u -> (linear-right v).preserves-add w u) ;
 pure-hom : H.Hom S.ring ring = (pure,refl one,pure-add,\ a c -> sym (pure-product a c)) ;
 scalar (a : B.ring.R) : V.V = V.scale a one ;
 scalar-action (a : B.ring.R) (v : V.V) : Id V.V (product (scalar a) v) (V.scale a v) =
  trans ((linear-left v).preserves-scale a one)
   (ap (V.scale a) (trans (commutative one v) (right-one v))) ;
 scalar-product (a c : B.ring.R) : Id V.V (scalar (B.ring.mul a c)) (product (scalar a) (scalar c)) =
  trans (V.scale-assoc a c one)
   (trans (ap (\ v -> V.scale a (V.scale c v)) (sym (right-one one)))
    (trans (ap (V.scale a) (sym ((linear-right one).preserves-scale c one)))
     (sym ((linear-left (V.scale c one)).preserves-scale a one)))) ;
 scalar-hom : H.Hom B.ring ring =
  (scalar,V.scale-one one,\ a c -> V.scale-add a c one,scalar-product) ;
 scalar-commutes (r : R.R) : Id V.V (pure (S.iota.1 r)) (scalar (B.iota.1 r)) =
  V.ext _ _ (\ i ->
   trans (ap B.iota.1 (trans (ap (\ a -> b.coordinate a i) (sym (S.ring.mulO (S.iota.1 r))))
     (b.scale r S.ring.o i))) (B.iota.2.2.2 r (b.coordinate S.ring.o i))) ;
 algebra : C.Algebra = C.mkAlgebra ring V.set (H.compose R B.ring ring scalar-hom B.iota) ;
 left : C.Hom S algebra = (pure-hom,scalar-commutes) ;
 right : C.Hom B algebra = (scalar-hom,\ r -> refl (scalar (B.iota.1 r))) ;
} ;
