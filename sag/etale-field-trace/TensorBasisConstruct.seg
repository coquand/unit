-- The algebra coproduct has the scalar-extended module basis.
-- Map D=S tensor_R S to the constructed coordinate algebra S^n by its
-- coproduct property.  Evaluation of coordinates back in D is a ring
-- map.  Its composite with the forward map is the identity because it
-- agrees on both S-factors.  This supplies reconstruction; the forward
-- ring-map laws supply additive and right-S-linear coordinates.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module Tn = Tensor[l].Over[R,setR] ;
 module At (S D : C.Algebra) (cp : Tn.Coproduct S S D)
  (n : Nat) (b : TraceBasis[l].Over[R,setR,S].Basis[n]) {
  module DK = DiagonalKernel[l].Over[R,setR].At[S,D,cp] ;
  module X = FiniteBasisScalarExtension[l].Over[R,setR,S,S,n,b] ;
  module Forward = DK.To[X.algebra,X.left,X.right] ;
  module Backward = FiniteBasisEvaluation[l].Over[R,setR,S,S,n,b].At[D,DK.left,DK.right] ;
  composite : C.Hom D D = C.compose D X.algebra D Backward.hom Forward.arrow ;
  inverse : Id (C.Hom D D) composite (C.identity D) =
   DK.hom-ext D composite (C.identity D)
    (\ s -> trans (ap Backward.value (Forward.on-left s)) (Backward.value-pure s))
    (\ s -> trans (ap Backward.value (Forward.on-right s)) (Backward.value-scalar s)) ;
  coordinate (y : D.ring.R) (i : Fin n) : S.ring.R = Forward.arrow.1.1 y i ;
  coordinate-add (y z : D.ring.R) (i : Fin n) :
   Id S.ring.R (coordinate (D.ring.add y z) i) (S.ring.add (coordinate y i) (coordinate z i)) =
   ap (\ v -> v i) (Forward.arrow.1.2.2.1 y z) ;
  coordinate-scale (s : S.ring.R) (y : D.ring.R) (i : Fin n) :
   Id S.ring.R (coordinate (D.ring.mul (DK.right.1.1 s) y) i) (S.ring.mul s (coordinate y i)) =
   ap (\ v -> v i)
    (trans (Forward.arrow.1.2.2.2 (DK.right.1.1 s) y)
     (trans (ap (\ v -> X.product v (Forward.arrow.1.1 y)) (Forward.on-right s))
      (X.scalar-action s (Forward.arrow.1.1 y)))) ;
  coordinate-left (s : S.ring.R) (i : Fin n) :
   Id S.ring.R (coordinate (DK.left.1.1 s) i) (S.iota.1 (b.coordinate s i)) =
   ap (\ v -> v i) (Forward.on-left s) ;
  reconstruction (y : D.ring.R) :
   Id D.ring.R (FiniteIdeal[l].Sums[D.ring].sum n
    (\ j -> D.ring.mul (DK.left.1.1 (b.vector j)) (DK.right.1.1 (coordinate y j)))) y =
   ap (\ h -> h.1.1 y) inverse ;
  module Bridge = DiagonalTraceBridge[l].Over[R,setR].At[S,D,cp,n,b] ;
  basis : Bridge.TensorBasis =
   Bridge.mkTensorBasis coordinate coordinate-add coordinate-scale coordinate-left reconstruction ;
  module Trace = Bridge.Coordinates[basis] ;
 } ;
} ;
