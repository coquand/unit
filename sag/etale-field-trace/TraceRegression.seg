-- Full construction on the rank-one base algebra, over every base ring
-- and explicitly over Z/4Z; and the rank-zero trace identity in the zero
-- algebra.  The first test runs the constructed tensor and scalar-extension
-- basis, not an assumed coordinate certificate.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
one : Nat = suc zero ;
one-index : (i : Fin one) -> Id (Fin one) i (inr tt) = split {
 inl e -> efq e ; inr t -> ap (\ u -> inr u) (FinSum[l].top-prop t tt) } ;
module BaseCase (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module TB = TraceBasis[l].Over[R,setR,C.base] ;
 module D = MnSums[l].Over[R] ;
 delta-one (i j : Fin one) : Id R.R (D.delta one i j) R.o =
  trans (ap (\ k -> D.delta one k j) (one-index i))
   (ap (D.delta one (inr tt)) (one-index j)) ;
 basis : TB.Basis[one] = TB.mkBasis one
  (\ i -> R.o) (\ a i -> a)
  (\ a b i -> refl (R.add a b)) (\ r a i -> refl (R.mul r a))
  (\ a -> trans (R.addZ (R.mul a R.o)) (R.mulO a))
  (\ j i -> sym (delta-one i j)) ;
 module B = TB.At[one,basis] ;
 trace-value (a : R.R) : Id R.R (B.trace a) a =
  trans (R.addZ (R.mul a R.o)) (R.mulO a) ;
 module T = FiniteUnramifiedTrace[l].Over[R,setR].At[C.base,one,basis] ;
 theorem : T.Result = T.theorem BasePresentation[l].Over[R,setR].finitely-presented
  DiagonalRegression[l].Empty[R,setR].unique ;
 module ActualTensor = DiagonalCertificate[l].Over[R,setR].Concrete[
  BasePresentation[l].Over[R,setR].empty,C.base,BasePresentation[l].Over[R,setR].presentation,
  DiagonalRegression[l].Empty[R,setR].unique] ;
 module Coordinates = TensorBasisConstruct[l].Over[R,setR].At[C.base,ActualTensor.T.T,ActualTensor.T.coproduct,one,basis] ;
 reconstructed (y : ActualTensor.T.T.ring.R) :
  Id ActualTensor.T.T.ring.R (Coordinates.Backward.value (Coordinates.Forward.arrow.1.1 y)) y =
  Coordinates.reconstruction y ;
} ;
module Nonreduced = BaseCase[ZMod4[l].ring,ZMod4[l].set] ;
over-z4 : Nonreduced.T.Result = Nonreduced.theorem ;
trace-two : Id ZMod4[l].ring.R (Nonreduced.B.trace q2) q2 = Nonreduced.trace-value q2 ;
module ZeroCase (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 ring : CRing = mkCRing Top tt tt (\ a b -> tt) (\ a b -> tt) (\ a -> tt)
  (\ a b c -> refl tt) (\ a b -> refl tt) (\ a -> FinSum[l].top-prop tt a) (\ a -> refl tt)
  (\ a b c -> refl tt) (\ a b -> refl tt) (\ a -> FinSum[l].top-prop tt a) (\ a b c -> refl tt) ;
 set : Pr.isSet Top = Pr.prop-to-set Top FinSum[l].top-prop ;
 algebra : C.Algebra = C.mkAlgebra ring set (\ r -> tt,refl tt,\ r s -> refl tt,\ r s -> refl tt) ;
 module TB = TraceBasis[l].Over[R,setR,algebra] ;
 basis : TB.Basis[zero] = TB.mkBasis zero (\ i -> efq i) (\ a i -> efq i)
  (\ a b i -> efq i) (\ r a i -> efq i) (\ a -> FinSum[l].top-prop tt a) (\ j i -> efq j) ;
 module TD = TraceDuality[l].Over[R,setR,algebra,zero,basis] ;
 certificate : TD.Certificate = TD.mkCertificate (\ i -> efq i) (refl tt) (\ z i -> efq i) ;
 module T = TD.Given[certificate] ;
 theorem : RL[R].unit (ExteriorModel[l].Over[R].det zero T.gram) = T.gram-determinant-unit ;
 identity (a : Top) : Id Top a tt = T.trace-identity a ;
} ;
