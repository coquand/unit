-- Finite free, finitely presented, formally unramified algebras have
-- invertible trace Gram determinant.  Everything beyond the finite basis
-- is constructed: the diagonal tensor, its averaging element, its scalar
-- extension coordinates, and the trace identity.  There is no assumed
-- tensor-coordinate/equalization certificate or standard presentation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module E = FormallyEtale[l].Over[R,setR] ; module DC = DiagonalCertificate[l].Over[R,setR] ;
 module At (S : C.Algebra) (n : Nat) (b : TraceBasis[l].Over[R,setR,S].Basis[n]) {
  module B = TraceBasis[l].Over[R,setR,S].At[n,b] ;
  module TD = TraceDuality[l].Over[R,setR,S,n,b] ;
  gram (j i : Fin n) : R.R = B.trace (S.ring.mul (b.vector j) (b.vector i)) ;
  Result : U l = RL[R].unit (ExteriorModel[l].Over[R].det n gram) ;
  result-prop : Pr.isProp Result = FormallyEtale[l].Units[R,setR].unit-prop (ExteriorModel[l].Over[R].det n gram) ;
  from-diagonal (d : DC.Result S) : Result =
   TensorBasisConstruct[l].Over[R,setR].At[S,d.1,d.2.1,n,b].Trace.Extract[d.2.2].Trace.gram-determinant-unit ;
  -- Keep the actual dual cofactors available, merely; Given[c] exports
  -- the trace identity, inverse matrix and nondegeneracy for this c.
  duality (fp : P.FP S) (unique : E.Unique S) : Truncation[l].Trunc[TD.Certificate].carrier =
   Truncation[l+].Trunc[DC.Result S].induction @l
    (\ d -> Truncation[l].Trunc[TD.Certificate].carrier)
    (\ d -> Truncation[l].Trunc[TD.Certificate].proposition)
    (\ d -> Truncation[l].Trunc[TD.Certificate].inc
     TensorBasisConstruct[l].Over[R,setR].At[S,d.1,d.2.1,n,b].Trace.Extract[d.2.2].certificate)
    (DC.exists S fp unique) ;
  theorem (fp : P.FP S) (unique : E.Unique S) : Result =
   Truncation[l+].Trunc[DC.Result S].induction @l (\ d -> Result) (\ d -> result-prop)
    from-diagonal (DC.exists S fp unique) ;
 } ;
} ;
