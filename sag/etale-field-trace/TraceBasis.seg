-- Coordinates of a finite basis and the trace of multiplication.
-- The record is an ordinary finite R-basis, expressed in the underlying
-- algebra: linear coordinate maps, reconstruction, and Kronecker values.
-- No field or separability assumption occurs in these linear lemmas.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (S : Algebras[l].Over[R,setR].Algebra) {
 module RS = FiniteIdeal[l].Sums[R] ;
 module SS = FiniteIdeal[l].Sums[S.ring] ;
 module Delta = MnSums[l].Over[R] ;
 record Basis (n : Nat) {
  vector : Fin n -> S.ring.R ;
  coordinate : S.ring.R -> Fin n -> R.R ;
  add (a b : S.ring.R) (i : Fin n) :
   Id R.R (coordinate (S.ring.add a b) i) (R.add (coordinate a i) (coordinate b i)) ;
  scale (r : R.R) (a : S.ring.R) (i : Fin n) :
   Id R.R (coordinate (S.ring.mul (S.iota.1 r) a) i) (R.mul r (coordinate a i)) ;
  reconstruction (a : S.ring.R) :
   Id S.ring.R (SS.sum n (\ j -> S.ring.mul (S.iota.1 (coordinate a j)) (vector j))) a ;
  on-vector (j i : Fin n) : Id R.R (coordinate (vector j) i) (Delta.delta n i j) ;
 } ;
 module At (n : Nat) (b : Basis[n]) {
  zero (i : Fin n) : Id R.R (b.coordinate S.ring.z i) R.z =
   RL[R].add-cancel (b.coordinate S.ring.z i) (b.coordinate S.ring.z i)
    (trans (sym (b.add S.ring.z S.ring.z i)) (ap (\ a -> b.coordinate a i) (S.ring.addZ S.ring.z))) ;
  sum : (m : Nat) (a : Fin m -> S.ring.R) (i : Fin n) ->
   Id R.R (b.coordinate (SS.sum m a) i) (RS.sum m (\ j -> b.coordinate (a j) i)) = split {
   zero -> \ a i -> zero i ;
   suc m | ih -> \ a i -> trans (b.add (a (inr tt)) (SS.sum m (\ j -> a (inl j))) i)
    (ap (R.add (b.coordinate (a (inr tt)) i)) (ih (\ j -> a (inl j)) i)) } ;
  combination (m : Nat) (v : Fin m -> S.ring.R) (r : Fin m -> R.R) (i : Fin n) :
   Id R.R (b.coordinate (SS.sum m (\ j -> S.ring.mul (S.iota.1 (r j)) (v j))) i)
    (RS.sum m (\ j -> R.mul (r j) (b.coordinate (v j) i))) =
   trans (sum m (\ j -> S.ring.mul (S.iota.1 (r j)) (v j)) i)
    (RS.sum-cong m _ _ (\ j -> b.scale (r j) (v j) i)) ;
  coordinates-determine (a c : S.ring.R) (h : (i : Fin n) -> Id R.R (b.coordinate a i) (b.coordinate c i)) :
   Id S.ring.R a c =
   trans (sym (b.reconstruction a))
    (trans (SS.sum-cong n _ _ (\ i -> ap (\ r -> S.ring.mul (S.iota.1 r) (b.vector i)) (h i)))
     (b.reconstruction c)) ;
  trace (a : S.ring.R) : R.R = RS.sum n (\ i -> b.coordinate (S.ring.mul a (b.vector i)) i) ;
  -- Multiplication in basis coordinates, before scalar extension.
  product-coordinate (a c : S.ring.R) (i : Fin n) :
   Id R.R (b.coordinate (S.ring.mul a c) i)
    (RS.sum n (\ j -> R.mul (b.coordinate c j) (b.coordinate (S.ring.mul a (b.vector j)) i))) =
   trans (ap (\ x -> b.coordinate (S.ring.mul a x) i) (sym (b.reconstruction c)))
    (trans (ap (\ x -> b.coordinate x i)
      (sym (SS.sum-scale a n (\ j -> S.ring.mul (S.iota.1 (b.coordinate c j)) (b.vector j)))))
     (trans (sum n (\ j -> S.ring.mul a (S.ring.mul (S.iota.1 (b.coordinate c j)) (b.vector j))) i)
      (RS.sum-cong n _ _ (\ j ->
       trans (ap (\ x -> b.coordinate x i) (RL[S.ring].mul-swap a (S.iota.1 (b.coordinate c j)) (b.vector j)))
        (b.scale (b.coordinate c j) (S.ring.mul a (b.vector j)) i))))) ;
  -- The index identity in the trace-duality calculation: the i-th
  -- coordinate of multiplication by a*b_j on b_i is lambda_i(a*b_i*b_j).
  trace-index (a : S.ring.R) (j : Fin n) :
   Id R.R (RS.sum n (\ i -> b.coordinate (S.ring.mul (S.ring.mul a (b.vector i)) (b.vector j)) i))
    (trace (S.ring.mul a (b.vector j))) =
   RS.sum-cong n
    (\ i -> b.coordinate (S.ring.mul (S.ring.mul a (b.vector i)) (b.vector j)) i)
    (\ i -> b.coordinate (S.ring.mul (S.ring.mul a (b.vector j)) (b.vector i)) i)
    (\ i -> ap (\ x -> b.coordinate x i)
    (trans (sym (S.ring.mulA a (b.vector i) (b.vector j)))
     (trans (ap (S.ring.mul a) (S.ring.mulC (b.vector i) (b.vector j)))
      (S.ring.mulA a (b.vector j) (b.vector i))))) ;
  trace-add (a c : S.ring.R) : Id R.R (trace (S.ring.add a c)) (R.add (trace a) (trace c)) =
   trans (RS.sum-cong n
    (\ i -> b.coordinate (S.ring.mul (S.ring.add a c) (b.vector i)) i)
    (\ i -> R.add (b.coordinate (S.ring.mul a (b.vector i)) i) (b.coordinate (S.ring.mul c (b.vector i)) i)) (\ i ->
    trans (ap (\ x -> b.coordinate x i) (RL[S.ring].dist-left a c (b.vector i)))
     (b.add (S.ring.mul a (b.vector i)) (S.ring.mul c (b.vector i)) i)))
    (RS.sum-add n (\ i -> b.coordinate (S.ring.mul a (b.vector i)) i)
     (\ i -> b.coordinate (S.ring.mul c (b.vector i)) i)) ;
  trace-scale (r : R.R) (a : S.ring.R) :
   Id R.R (trace (S.ring.mul (S.iota.1 r) a)) (R.mul r (trace a)) =
   trans (RS.sum-cong n
    (\ i -> b.coordinate (S.ring.mul (S.ring.mul (S.iota.1 r) a) (b.vector i)) i)
    (\ i -> R.mul r (b.coordinate (S.ring.mul a (b.vector i)) i)) (\ i ->
    trans (ap (\ x -> b.coordinate x i) (sym (S.ring.mulA (S.iota.1 r) a (b.vector i))))
     (b.scale r (S.ring.mul a (b.vector i)) i)))
    (RS.sum-scale r n (\ i -> b.coordinate (S.ring.mul a (b.vector i)) i)) ;
 } ;
} ;
