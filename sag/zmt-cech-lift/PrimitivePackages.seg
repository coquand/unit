-- Exact Contract/Terminal interfaces for FiniteZigzagCertificate.
-- Repackage the constructed finite-coordinate map into Comb.Free's
-- identical pointwise carrier/operations, avoiding equality of complete
-- module records. A single named ambient transport handles n=suc p.
level l ; open Ring[l] ; open ZInt[l] ;
module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module K = GenericDegree[l] ;
module Tr = Truncation[l] ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 module FP = FamilyPrimitives[l].Over[D,setD] ;
 module BelowTop (n a : Nat) (k : Ps.Fin a -> Int) (p : Nat)
   (ne : Not (Id Int (K.topRank n) (K.topRank (suc p)))) {
   module P = FP.BelowTop[n,a,k,p,ne] ;
   Contract : U l = (y : P.Source.El) -> Id P.Out.Target.El (P.Out.lin.f y) P.Out.Target.mod.mz ->
     Tr.Trunc[(h : P.Target.El) * Id P.Source.El (P.Back.lin.f h) y].carrier ;
   contract : Contract = \ y closed ->
     Tr.Trunc[(h : P.Target.El) * Id P.Source.El (P.Back.lin.f h) y].inc
       (P.Input[y,closed].primitive,P.Input[y,closed].equation) ;
 } ;
 module Top (p a : Nat) (k : Ps.Fin a -> Int) {
   module Ambient (n : Nat) {
     module M = ShiftedMatrixAction[l].Over[D,setD,n] ;
     module Source = M.Family[a,k,K.topRank (suc p)] ;
     module Previous = M.Family[a,k,K.topRank p] ;
     module Back = M.Differential[a,k,K.topRank p] ;
     Terminal : U l = (v : Nat) * ((top : IP.Lin[D,Source.mod,Comb[l].Free[D,v].mod]) *
       ((y : Source.El) -> Id Comb[l].Free[D,v].Vec (top.f y) Comb[l].Free[D,v].mod.mz ->
         Tr.Trunc[(h : Previous.El) * Id Source.El (Back.lin.f h) y].carrier)) ;
   } ;
   module T = FP.Top[p,a,k] ; module Free = Comb[l].Free[D,T.Coords.rank] ;
   top : IP.Lin[D,T.Source.mod,Free.mod] = IP.mkLin D T.Source.mod Free.mod T.Coords.extract
     T.Coords.lin.f-add T.Coords.lin.f-sm ;
   base : Ambient[suc p].Terminal = (T.Coords.rank,(top,\ y hz ->
     Tr.Trunc[(h : T.Target.El) * Id T.Source.El (T.Back.lin.f h) y].inc
       (T.Input[y,hz].primitive,T.Input[y,hz].equation))) ;
   terminal (n : Nat) (e : Id Nat n (suc p)) : Ambient[n].Terminal =
     subst (\ m -> Ambient[m].Terminal) (sym e) base ;
 } ;
} ;
