-- The natural-cardinality primitive wrappers in the relevant small
-- dimensions. These use actual family equalities, not raw equations.
level l ; open Ring[l] ; open ZInt[l] ;
module Ps = Presentations[l] ; module F = FamilyPrimitives[l] ;
n1 : Nat = suc zero ; n2 : Nat = suc n1 ; n3 : Nat = suc n2 ; n4 : Nat = suc n3 ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) (a : Nat) (k : Ps.Fin a -> Int) {
 module P = F.Over[D,setD] ; module Old = GenericRegression[l].Over[D,setD] ;
 module P3Degree1 = P.BelowTop[n4,a,k,n1,Old.neq42] ;
 module P3Degree2 = P.BelowTop[n4,a,k,n2,Old.neq43] ;
 module P3Top = P.Top[n3,a,k] ;
 module TopInput (y : P3Top.Source.El)
   (hz : Id P3Top.Coords.free.M (P3Top.Coords.lin.f y) P3Top.Coords.free.mz) {
   module I = P3Top.Input[y,hz] ;
   primitive : P3Top.Target.El = I.primitive ;
   equation : Id P3Top.Source.El (P3Top.Back.lin.f primitive) y = I.equation ;
 } ;
 -- n=1 top gives a primitive in the augmentation at cardinality 0.
 module Singleton = P.Top[zero,a,k] ;
 -- n=0 remains an augmented empty-coordinate complex; the below-top
 -- rank-one theorem is still valid, and no negative natural rank occurs.
 ne01 : Not (Id Int (GenericDegree[l].topRank zero) (GenericDegree[l].topRank n1)) =
   \ e -> Prelude[l].absurd Empty (ZInt[l].encode zeroZ (sucZ zeroZ) e) ;
 module Empty = P.BelowTop[zero,a,k,zero,ne01] ;
} ;
