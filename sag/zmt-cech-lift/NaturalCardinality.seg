-- A strict natural-cardinality inequality supplies precisely the
-- unequal integer degrees required by the generic contraction theorem.
level l ; open Ring[l] ; open ZInt[l] ;
module K = GenericDegree[l] ; module B = GenericCardinality[l] ; module O = NatOrder[l] ;
top-raise : (n : Nat) -> Id Int (K.topRank n) (B.raise n zeroZ) = split {
 zero -> refl zeroZ ; suc n | rec -> ap sucZ rec } ;
lt-ne : (q : Nat) (n : Nat) -> O.Lt q n -> Not (Id Int (K.topRank n) (K.topRank q)) = split {
 zero -> split {
   zero -> \ h e -> h ;
   suc n -> \ h e -> B.zero-bound n (trans (sym e) (ap sucZ (top-raise n))) } ;
 suc q | rec -> split {
   zero -> \ h e -> h ;
   suc n -> \ h e -> rec n h (trans (sym (pred-suc (K.topRank n))) (trans (ap predZ e) (pred-suc (K.topRank q)))) } } ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) (n a : Nat) (k : Presentations[l].Fin a -> Int) (p : Nat)
 (lt : O.Lt (suc p) n) {
 module P = FamilyPrimitives[l].Over[D,setD].BelowTop[n,a,k,p,lt-ne (suc p) n lt] ;
} ;
