-- Transport the cardinality index of actual cochains along an integer
-- equality. The raw coefficients and finite support are preserved.
-- This named map isolates pred(suc r)=r in natural-degree primitives.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module L = GenericLaurent[l] ; module E = GenericCech[l] ; module IP = IdealPowers[l] ;
bad (n : Nat) (k r r' : Int) (e : Id Int r r') (s : Sub n) (m : L.Exp n) :
 E.Bad n k r' s m -> E.Bad n k r s m = split {
 inl ne -> inl ne ; inr b -> other n k r r' e s m b }
where { other (n : Nat) (k r r' : Int) (e : Id Int r r') (s : Sub n) (m : L.Exp n) :
 Plus (GenericSupport[l].bad n (L.mask n m) s) (Not (Id Int (GenericDegree[l].card n s) r')) -> E.Bad n k r s m = split {
   inl b -> inr (inl b) ; inr ne -> inr (inr (\ h -> ne (trans h e))) } } ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) (n : Nat) (k r r' : Int) (e : Id Int r r') {
 module CE = E.Over[D,setD] ; module Source = CE.Cochains[n,k,r] ; module Target = CE.Cochains[n,k,r'] ;
 move (c : Source.El) : Target.El = Target.M.mk (Source.val c) (Source.M.supp c)
   (\ s m b -> Source.M.van c s m (bad n k r r' e s m b)) ;
 val (c : Source.El) (s : Sub n) (m : L.Exp n) : Id D.R (Target.val (move c) s m) (Source.val c s m) = refl (Source.val c s m) ;
 lin : IP.Lin[D,Source.mod,Target.mod] = IP.mkLin D Source.mod Target.mod move
   (\ c c' -> Target.M.eq _ _ (\ s m -> refl (D.add (Source.val c s m) (Source.val c' s m))))
   (\ a c -> Target.M.eq _ _ (\ s m -> refl (D.mul a (Source.val c s m)))) ;
} ;
