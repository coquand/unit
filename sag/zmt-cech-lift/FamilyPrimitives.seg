-- Actual primitives on finite shifted families, with natural cardinality
-- indices suitable for a zigzag schedule. The only transports are the
-- named coefficient-preserving CechRankTransport maps.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ;
module Ps = Presentations[l] ; module IP = IdealPowers[l] ; module K = GenericDegree[l] ;
module L = GenericLaurent[l] ;
module Over (D : CRing) (setD : Prelude[l].isSet D.R) {
 module C = GenericCube[l].Over[D,setD] ; module H = GenericContraction[l].Over[D,setD] ;
 module CE = GenericCech[l].Over[D,setD] ; module F = GenericCechTheorems[l].Over[D,setD] ;
 module BelowTop (n a : Nat) (k : Ps.Fin a -> Int) (p : Nat)
   (ne : Not (Id Int (K.topRank n) (K.topRank (suc p)))) {
   module M = ShiftedMatrixAction[l].Over[D,setD,n] ;
   module Source = M.Family[a,k,K.topRank (suc p)] ; module Target = M.Family[a,k,K.topRank p] ;
   module Out = M.Differential[a,k,K.topRank (suc p)] ; module Back = M.Differential[a,k,K.topRank p] ;
   module Input (y : Source.El) (closed : Id Out.Target.El (Out.lin.f y) Out.Target.mod.mz) {
     module At (i : Ps.Fin a) {
       module O = CE.Operations[n,k i,K.topRank (suc p)] ;
       hc (s : Sub n) (m : L.Exp n) : Id D.R (O.dRaw (y i) s m) D.z =
         ap (\ z -> CE.Cochains[n,k i,sucZ (K.topRank (suc p))].val (z i) s m) closed ;
       module P = O.Primitive[y i,ne,hc] ;
       module Move = CechRankTransport[l].Over[D,setD,n,k i,predZ (K.topRank (suc p)),K.topRank p,pred-suc (K.topRank p)] ;
       primitive : CE.Cochains[n,k i,K.topRank p].El = Move.move P.primitive ;
     } ;
     primitive : Target.El = \ i -> At[i].primitive ;
     equation : Id Source.El (Back.lin.f primitive) y = Source.Prod.ext _ _ (\ i ->
       CE.Cochains[n,k i,K.topRank (suc p)].M.eq _ _ (At[i].P.equation)) ;
   } ;
 } ;
 module Top (p a : Nat) (k : Ps.Fin a -> Int) {
   n : Nat = suc p ;
   module M = ShiftedMatrixAction[l].Over[D,setD,n] ;
   module Source = M.Family[a,k,K.topRank n] ; module Target = M.Family[a,k,K.topRank p] ;
   module Back = M.Differential[a,k,K.topRank p] ;
   module Coords = ShiftedTopPresentation[l].Over[D,setD,n,a,k] ;
   module Input (y : Source.El) (hz : Id Coords.free.M (Coords.lin.f y) Coords.free.mz) {
     module At (i : Ps.Fin a) {
       module O = CE.Operations[n,k i,K.topRank n] ;
       module Move = CechRankTransport[l].Over[D,setD,n,k i,predZ (K.topRank n),K.topRank p,pred-suc (K.topRank p)] ;
       primitive : CE.Cochains[n,k i,K.topRank p].El = Move.move (O.h (y i)) ;
       pi-zero (s : Sub n) (m : L.Exp n) : Id D.R (O.pRaw (y i) s m) D.z =
         Coords.top-zero y (\ j -> ap (\ v -> v j) hz) i s m ;
       equation (s : Sub n) (m : L.Exp n) :
         Id D.R (C.diff n (\ t -> CE.Cochains[n,k i,K.topRank p].val primitive t m) s) (O.A.val (y i) s m) =
         trans (sym (D.addZ (C.diff n (\ t -> O.Down.val (O.h (y i)) t m) s)))
           (trans (ap (D.add (C.diff n (\ t -> O.Down.val (O.h (y i)) t m) s)) (sym (pi-zero s m)))
             (F.Top[n,k i].decomposition (y i) s m)) ;
     } ;
     primitive : Target.El = \ i -> At[i].primitive ;
     equation : Id Source.El (Back.lin.f primitive) y = Source.Prod.ext _ _ (\ i ->
       CE.Cochains[n,k i,K.topRank n].M.eq _ _ (At[i].equation)) ;
   } ;
 } ;
} ;
