-- Bundle componentwise explicit ideal-power trees in a dependent product,
-- then assemble singleton chart families into actual global cochains.
-- Every coefficient tree is built pointwise; no choice is used here.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
module IP = IdealPowers[l] ; module Ps = Presentations[l] ; module Pr = Prelude[l] ;

module Over (A : CRing) (I : U l) (M : I -> IP.Mod[A]) (t : Nat) (b : Ps.Fin t -> A.R) {
  module P = ChartFamilyAssembly4[l].Product[A,I,M] ;
  module PF = FiniteIdealPowers[l].Over[A,P.mod,t,b] ;
  module PS = Comb[l].Sums[A,P.mod] ;
  module Local (i : I) {
    module F = FiniteIdealPowers[l].Over[A,M i,t,b] ;
    module S = Comb[l].Sums[A,M i] ;
  } ;
  sum-eval : (n : Nat) (xs : Ps.Fin n -> P.El) (i : I) ->
    Id (M i).M (PS.sum n xs i) (Local[i].S.sum n (\ j -> xs j i)) = split {
    zero -> \ xs i -> refl (M i).mz ;
    suc n | r -> \ xs i -> ap ((M i).madd (xs (inr tt) i)) (r (\ j -> xs (inl j)) i) } ;
  gen-eval (xs : Ps.Fin t -> P.El) (i : I) :
    Id (M i).M (PF.gen xs i) (Local[i].F.gen (\ j -> xs j i)) =
    sum-eval t (\ j -> P.mod.sm (b j) (xs j)) i ;
  bundle : (p : Base.Nat) (x : P.El) ->
    ((i : I) -> Local[i].F.Wit p (x i)) -> PF.Wit p x = split {
    zero -> \ x ws -> tt ;
    suc p | r -> \ x ws ->
      (\ j i -> (ws i).1 j,
        (\ j -> r (\ i -> (ws i).1 j) (\ i -> (ws i).2.1 j),
          P.ext x (PF.gen (\ j i -> (ws i).1 j))
            (\ i -> trans (ws i).2.2 (sym (gen-eval (\ j i -> (ws i).1 j) i))))) } ;
} ;

module Assemble (A : CRing) (setA : Pr.isSet A.R) (I : U l) (set : I -> Sub4)
  (n : Nat) (ix : Ps.Fin n -> I) (cover : (i : I) -> (j : Ps.Fin n) * Id I (ix j) i)
  (k : Int) (t : Nat) (b : Ps.Fin t -> A.R) {
  module CS = ChartFamilyAssembly4[l].Over[A,setA,I,set,n,ix,cover,k] ;
  module PI = Over[A,I,\ i -> CS.Local[i].C.mod,t,b] ;
  module LL = RelationCertificate[l].LinL[A,CS.P.mod,CS.CH.mod,CS.linear] ;
  module MP = IdealPowerWitnessTransport[l].Over[A,A,CS.P.mod,CS.CH.mod,t,b,b,
    CS.linear.f,LL.f-zero,CS.linear.f-add,\ j x -> CS.linear.f-sm (b j) x] ;
  assembledWitness (p : Base.Nat) (x : CS.P.El)
    (ws : (i : I) -> PI.Local[i].F.Wit p (x i)) : MP.FN.Wit p (CS.assemble x) =
    MP.witness p x (PI.bundle p x ws) ;
} ;
