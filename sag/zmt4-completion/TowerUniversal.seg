-- The universal property of the coefficient tower, with arbitrary target.
-- Extend a base map and finitely many variable values one polynomial
-- extension at a time.  Two maps agree if they agree on the base and all
-- variables: at each step use the one-variable universal property.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ;

module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) {
  module T = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
  extend : (n : Nat) -> RH.Hom A B -> (Ps.Fin n -> B.R) -> RH.Hom (T.D n) B = split {
    zero -> \ f a -> f ;
    suc n | r -> \ f a -> Universal[l].Property[T.D n,B,T.setD n,setB].Given[r f (\ j -> a (inl j)),a (inr tt)].extend } ;
  base : (n : Nat) (f : RH.Hom A B) (a : Ps.Fin n -> B.R) (x : A.R) ->
    Id B.R ((extend n f a).1 ((T.grD n).iota.1 x)) (f.1 x) = split {
    zero -> \ f a x -> refl (f.1 x) ;
    suc n | r -> \ f a x ->
      trans (Universal[l].Property[T.D n,B,T.setD n,setB].Given[extend n f (\ j -> a (inl j)),a (inr tt)].on-constants ((T.grD n).iota.1 x))
        (r f (\ j -> a (inl j)) x) } ;
  variable : (n : Nat) (f : RH.Hom A B) (a : Ps.Fin n -> B.R) (j : Ps.Fin n) ->
    Id B.R ((extend n f a).1 ((T.grD n).var j)) (a j) = split {
    zero -> \ f a j -> absurd (Id B.R ((extend zero f a).1 ((T.grD zero).var j)) (a j)) j ;
    suc n | r -> \ f a -> split {
      inl j -> trans (Universal[l].Property[T.D n,B,T.setD n,setB].Given[extend n f (\ k -> a (inl k)),a (inr tt)].on-constants ((T.grD n).var j))
                 (r f (\ k -> a (inl k)) j) ;
      inr u -> trans Universal[l].Property[T.D n,B,T.setD n,setB].Given[extend n f (\ k -> a (inl k)),a (inr tt)].on-variable
                 (ap (\ v -> a (inr v)) (CoefficientPolynomial[l].top-eta u)) } } ;

  -- Restricting maps along the last constant inclusion exposes exactly
  -- the preceding tower, so induction needs no representatives or choice.
  module Step (n : Nat) (f g : RH.Hom (T.D (suc n)) B) {
    module X = PolynomialRing[l].Extension[T.D n,T.setD n] ;
    rf : RH.Hom (T.D n) B = RH.compose (T.D n) X.ring B f X.inclusion ;
    rg : RH.Hom (T.D n) B = RH.compose (T.D n) X.ring B g X.inclusion ;
    module UP = Universal[l].Property[T.D n,B,T.setD n,setB] ;
    finish (hc : (x : (T.D n).R) -> Id B.R (rf.1 x) (rg.1 x))
      (hv : Id B.R (f.1 X.variable) (g.1 X.variable)) : Id (RH.Hom X.ring B) f g =
      trans (UP.Given[rg,g.1 X.variable].unique f hc hv) (UP.bf g) ;
  } ;
  ext : (n : Nat) (f g : RH.Hom (T.D n) B) ->
    ((x : A.R) -> Id B.R (f.1 ((T.grD n).iota.1 x)) (g.1 ((T.grD n).iota.1 x))) ->
    ((j : Ps.Fin n) -> Id B.R (f.1 ((T.grD n).var j)) (g.1 ((T.grD n).var j))) ->
    Id (RH.Hom (T.D n) B) f g = split {
    zero -> \ f g hc hv -> RH.Properties[A,B,setB].ext f g hc ;
    suc n | r -> \ f g hc hv ->
      Step[n,f,g].finish
        (\ x -> ap (\ h -> h.1 x) (r Step[n,f,g].rf Step[n,f,g].rg hc (\ j -> hv (inl j))))
        (hv (inr tt)) } ;
  unique (n : Nat) (f : RH.Hom A B) (a : Ps.Fin n -> B.R) (g : RH.Hom (T.D n) B)
    (hc : (x : A.R) -> Id B.R (g.1 ((T.grD n).iota.1 x)) (f.1 x))
    (hv : (j : Ps.Fin n) -> Id B.R (g.1 ((T.grD n).var j)) (a j)) :
    Id (RH.Hom (T.D n) B) g (extend n f a) =
      ext n g (extend n f a) (\ x -> trans (hc x) (sym (base n f a x)))
        (\ j -> trans (hv j) (sym (variable n f a j))) ;
} ;
