-- ZMT4ExtractionGeneral.seg: the checked extraction argument with the
-- homogeneous defining generators made explicit. The proof body is the
-- proof of ZMT4Extract, parameterized only in P, degree, homogeneity and
-- vanishing under dehomogenisation. No special shape of P is used by it.
-- Global exponent lemmas and the certificate theorem are reused unchanged.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
open FinitePolynomial4[l] ; open ShiftedCech4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ; module NA = NatArith[l] ; module LG = Logic[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module IP = IdealPowers[l] ;
module LSL = LaurentSyzygyLift4[l] ; module ZM = ZMT4Certificate[l] ; module ZP = ZMT4Polynomials[l] ; module ZS = ZMT4Setup[l] ;
module RA = ResidualAlgebra[l] ; module ZC = ZMTCertificate[l] ; module TL4 = TopList4[l] ;

module XE = ZMT4Extract[l] ;

module ForGenerators (A : CRing) (setA : Pr.isSet A.R) (D0 : RA.Residual[A,setA,ZM.three])
  (pJ : Ps.Fin ZM.three -> TPoly A.R) (dJ : Ps.Fin ZM.three -> Base.Nat)
  (hpJ : (q : Ps.Fin ZM.three) -> HomDeg A.R (dJ q) (pJ q))
  (dehJ : (q : Ps.Fin ZM.three) -> Id ZS.Over[A,setA,D0].E.R
    (ZS.Over[A,setA,D0].CO.deh (pJ q)) ZS.Over[A,setA,D0].E.z) {
  module ST = ZS.Over[A,setA,D0] ;
  E : CRing = ST.E ;
  module CO = ST.CO ;
  module DH = ZP.Deh[A,setA,ST.E,ST.setE,ST.iota,ST.FD.y] ;
  module PO = ZP.Over[A,setA] ;
  module PAA = PolynomialAction4[l].Over[A,setA] ; module FPA = FinitePolynomial4[l].Over[A,setA] ;
  module RSA = Comb[l].Sums[A,IP.regular A] ; module FS = FiniteIdeal[l].Sums[ST.E] ;
  module LA = RL[A] ; module LE = RL[ST.E] ;
  module CH = ReesChart4[l].Over[A,setA,D0.t,D0.b,ZM.three,pJ,dJ,hpJ] ;
  module CJ0 = CH.JC[Pt,setPt,TL4.mOne] ;
  module CJ1 = CH.JC[Ed,setEd,TL4.mOne] ;
  module CA = Cech4[l].Over[A,setA] ;
  -- the Cech differential on C^0(-1)
  d (x : CJ0.E.El) : CJ1.E.El = (CA.D0 TL4.mOne).f x ;
  -- by definition of the differential: (d x)_{0k} = x_k - x_0
  d-val1 (x : CJ0.E.El) (m : E4) : Id A.R (CJ1.E.val (d x) e01 m) (A.add (CJ0.E.val x p1 m) (A.neg (CJ0.E.val x p0 m))) = refl (CJ1.E.val (d x) e01 m) ;
  d-val2 (x : CJ0.E.El) (m : E4) : Id A.R (CJ1.E.val (d x) e02 m) (A.add (CJ0.E.val x p2 m) (A.neg (CJ0.E.val x p0 m))) = refl (CJ1.E.val (d x) e02 m) ;
  d-val3 (x : CJ0.E.El) (m : E4) : Id A.R (CJ1.E.val (d x) e03 m) (A.add (CJ0.E.val x p3 m) (A.neg (CJ0.E.val x p0 m))) = refl (CJ1.E.val (d x) e03 m) ;

  -- deh of a finite sum of terms with dehomogenisation 0
  deh-psum-zero : (n : Nat) (f : Ps.Fin n -> TPoly A.R) -> ((i : Ps.Fin n) -> Id ST.E.R (CO.deh (f i)) ST.E.z) -> Id ST.E.R (CO.deh (PAA.psum n f)) ST.E.z = split {
    zero -> \ f h -> refl ST.E.z ;
    suc n | r -> \ f h -> trans (ST.deh-app (f (inr tt)) (PAA.psum n (\ i -> f (inl i))))
                           (trans (Ps.cong2 ST.E.R ST.E.add _ _ _ _ (h (inr tt)) (r (\ i -> f (inl i)) (\ i -> h (inl i)))) (ST.E.addZ ST.E.z)) } ;
  -- J-multiples dehomogenise to 0
  deh-J (TY : Ps.Fin ZM.three -> TPoly A.R) (q : Ps.Fin ZM.three) : Id ST.E.R (CO.deh (PAA.pmul (pJ q) (TY q))) ST.E.z =
    trans (ST.deh-pmul (pJ q) (TY q)) (trans (ap (\ w -> ST.E.mul w (CO.deh (TY q))) (dehJ q)) (LE.zero-mul (CO.deh (TY q)))) ;
  -- y + (x - y) = x
  recombine (y x : A.R) : Id A.R (A.add y (A.add x (A.neg y))) x =
    trans (LA.add-swap y x (A.neg y)) (trans (ap (A.add x) (A.addN y)) (A.addZ x)) ;
  -- a scaled term list with coefficient 1
  deh-shift (u : N4) (p : TPoly A.R) : Id ST.E.R (CO.deh (PAA.scaleT (A.o, u) p)) (ST.E.mul (CO.mon u) (CO.deh p)) =
    trans (CO.deh-scale A.o u p) (ap (\ w -> ST.E.mul w (CO.deh p)) (trans (ap (\ w -> ST.E.mul w (CO.mon u)) ST.iota.2.1) (LE.one-left (CO.mon u)))) ;
  cf-shift (u : N4) (p : TPoly A.R) (m : E4) : Id A.R (FPA.cf (PAA.scaleT (A.o, u) p) m) (FPA.cf p (subE m u)) =
    trans (PAA.mulP-scaleT (A.o, u) p FPA.delta0 m) (LA.one-left (FPA.cf p (subE m u))) ;

  ------------------------------------------------------------------------
  -- X^L f for a chart function f of degree -1, as a term list of degree dd

  module HP (E' : Sub4) (f : E4 -> A.R) (S : List E4) (supp : (m : E4) -> Not (Mem m S) -> Id A.R (f m) A.z)
    (van : (m : E4) -> Out E' m -> Id A.R (f m) A.z) (vdeg : (m : E4) -> Not (Id Int (deg m) TL4.mOne) -> Id A.R (f m) A.z)
    (L : N4) (dom : (m : E4) -> Mem m S -> Not (Out E' m) -> LSL.LeN4 (LSL.negN4 m) L)
    (dd : Base.Nat) (e : Id Int (minus (pos dd) (size L)) TL4.mOne) {
    module CP = PO.ChartPoly[E',f,S,supp,van,L,dom] ;
    T : TPoly A.R = PO.filtT dd CP.rep.1 ;
    hom : HomDeg A.R dd T = PO.hom-filtT dd CP.rep.1 ;
    cfD (m : E4) : (dc : LG.Dec (Id Int (deg m) (pos dd))) -> Id A.R (FPA.cf T m) (f (subE m L)) = split {
      yes h -> trans (PO.cf-filt dd m h CP.rep.1) (CP.rep.2 m) ;
      no n -> trans (PO.cf-filt-off dd CP.rep.1 m (inl (\ h -> ZP.bot Empty (n h))))
                (sym (vdeg (subE m L) (not-deg-subE TL4.mOne (pos dd) m L e (\ h -> ZP.bot Empty (n h))))) } ;
    cf-T (m : E4) : Id A.R (FPA.cf T m) (f (subE m L)) = cfD m (int-dec (deg m) (pos dd)) ;
  } ;

  ------------------------------------------------------------------------
  -- the section and its witnesses

  module Sec (z z0 : CJ0.E.El) (hz0 : (m : E4) -> Id A.R (CJ0.E.val z0 p0 m) (FPA.delta0 (addE m (nx (suc zero) zero zero zero)))) {
    module W (w : CJ1.JW (d z)) (v : CJ0.IJW (suc zero) (CJ0.ML.msub z z0)) {
      -- the components of the witnesses
      module CY (q : Ps.Fin ZM.three) { module C = CH.HM.LO.Chart[Ed,BadI Ed setEd (CJ1.F.k1 q)] ; } ;
      module CY' (q : Ps.Fin ZM.three) { module C = CH.HM.LO.Chart[Pt,BadI Pt setPt (CJ0.F.k1 q)] ; } ;
      Yv (q : Ps.Fin ZM.three) : Ed -> E4 -> A.R = CY[q].C.val (w.1 q) ;
      Yv' (q : Ps.Fin ZM.three) : Pt -> E4 -> A.R = CY'[q].C.val (v.2.2.1 q) ;
      xs (j : Ps.Fin D0.t) : CJ0.E.El = v.2.1.1 j ;
      module SCA = ShiftedCech4[l].Over[A,setA] ;
      -- d z = sum_q P_q y_q on an edge, pointwise
      hJ (i : Ed) (m : E4) : Id A.R (CJ1.E.val (d z) i m) (RSA.sum ZM.three (\ q -> PAA.mulP (pJ q) (Yv q i) m)) =
        trans (ap (\ x -> CJ1.E.val x i m) w.2) (SCA.ChartSums[Ed,BadI Ed setEd TL4.mOne].val-sum ZM.three (\ q -> (CJ1.F.gi q).f (w.1 q)) i m) ;

      module L (S : List E4) (sz : CJ0.E.Vanish S (CJ0.E.val z)) (sy : (q : Ps.Fin ZM.three) -> CY[q].C.Vanish S (Yv q))
        (sx : (j : Ps.Fin D0.t) -> CJ0.E.Vanish S (CJ0.E.val (xs j))) (sy' : (q : Ps.Fin ZM.three) -> CY'[q].C.Vanish S (Yv' q)) {
        B : N4 = LSL.bound S ;
        B0 : Base.Nat = n0 B ;
        L0 : N4 = nx (suc B0) zero zero zero ;
        dom (E' : Sub4) (le : Le4 E' E') (L : N4) (hL : Id N4 (ZP.Lpat E' B) L) (m : E4) (hm : Mem m S) (nout : Not (Out E' m)) :
          LSL.LeN4 (LSL.negN4 m) L = subst (LSL.LeN4 (LSL.negN4 m)) hL (ZP.dom-pat S E' E' le m hm nout) ;
        -- s = deh (X^L0 z_Z)
        module HS = HP[setPt p0,CJ0.E.val z p0,S,\ m nm -> sz p0 m nm,\ m o -> CJ0.E.van z p0 m (inr o),\ m h -> CJ0.E.van z p0 m (inl h),
          L0,dom (setPt p0) (XE.le4-refl (setPt p0)) L0 (XE.lpat-p0 B),B0,trans (ap (minus (pos B0)) (XE.size-s0 B0)) (XE.mone-shift B0)] ;
        sT : TPoly A.R = HS.T ;
        s : ST.E.R = CO.deh sT ;

        -- the edge {Z, X_k}
        module Edge (pk : Pt) (ek : Ed) (Lk' Lk : N4) (bk : Base.Nat) (yk : ST.E.R)
          (domK : (m : E4) -> Mem m S -> Not (Out (setPt pk) m) -> LSL.LeN4 (LSL.negN4 m) Lk')
          (domE : (m : E4) -> Mem m S -> Not (Out (setEd ek) m) -> LSL.LeN4 (LSL.negN4 m) Lk)
          (szK : Id Base.Nat (size Lk') (suc bk))
          (sh1 : (m : E4) -> Id E4 (subE (subE m L0) Lk') (subE m Lk))
          (sh2 : (m : E4) -> Id E4 (subE (subE m Lk') L0) (subE m Lk))
          (monK : Id ST.E.R (CO.mon Lk') (CO.bpow yk (suc bk)))
          (dv : (m : E4) -> Id A.R (CJ1.E.val (d z) ek m) (A.add (CJ0.E.val z pk m) (A.neg (CJ0.E.val z p0 m)))) {
          module HK = HP[setPt pk,CJ0.E.val z pk,S,\ m nm -> sz pk m nm,\ m o -> CJ0.E.van z pk m (inr o),\ m h -> CJ0.E.van z pk m (inl h),
            Lk',domK,bk,trans (ap (minus (pos bk)) szK) (XE.mone-shift bk)] ;
          qk : TPoly A.R = HK.T ;
          module TYq (q : Ps.Fin ZM.three) {
            module C = PO.ChartPoly[setEd ek,Yv q ek,S,\ m nm -> sy q ek m nm,\ m o -> CY[q].C.van (w.1 q) ek m (inr o),Lk,domE] ;
          } ;
          TY (q : Ps.Fin ZM.three) : TPoly A.R = TYq[q].C.rep.1 ;
          rhs : TPoly A.R = Bar[l].app (PAA.scaleT (A.o, Lk') sT) (PAA.psum ZM.three (\ q -> PAA.pmul (pJ q) (TY q))) ;
          -- the shifted J identity, in coefficient functions
          cf-J (m : E4) : Id A.R (FPA.cf (PAA.psum ZM.three (\ q -> PAA.pmul (pJ q) (TY q))) m)
            (A.add (CJ0.E.val z pk (subE m Lk)) (A.neg (CJ0.E.val z p0 (subE m Lk)))) = calc A.R {
            FPA.cf (PAA.psum ZM.three (\ q -> PAA.pmul (pJ q) (TY q))) m
              =< FPA.cf-psum ZM.three (\ q -> PAA.pmul (pJ q) (TY q)) m > RSA.sum ZM.three (\ q -> FPA.cf (PAA.pmul (pJ q) (TY q)) m)
              =< RSA.sum-cong ZM.three (\ q -> FPA.cf (PAA.pmul (pJ q) (TY q)) m) (\ q -> PAA.mulP (pJ q) (Yv q ek) (subE m Lk))
                   (\ q -> trans (FPA.cf-pmul (pJ q) (TY q) m)
                            (trans (PAA.mulP-cong (pJ q) (FPA.cf (TY q)) (\ m' -> Yv q ek (subE m' Lk)) (TYq[q].C.rep.2) m)
                              (PAA.mulP-shift (\ x -> subE x Lk) (\ x u -> subE-comm x Lk u) (pJ q) (Yv q ek) m)))
              > RSA.sum ZM.three (\ q -> PAA.mulP (pJ q) (Yv q ek) (subE m Lk))
              =< sym (trans (sym (dv (subE m Lk))) (hJ ek (subE m Lk)))
              > A.add (CJ0.E.val z pk (subE m Lk)) (A.neg (CJ0.E.val z p0 (subE m Lk))) } ;
          cf-id (m : E4) : Id A.R (FPA.cf (PAA.scaleT (A.o, L0) qk) m) (FPA.cf rhs m) = calc A.R {
            FPA.cf (PAA.scaleT (A.o, L0) qk) m
              =< cf-shift L0 qk m > FPA.cf qk (subE m L0)
              =< HK.cf-T (subE m L0) > CJ0.E.val z pk (subE (subE m L0) Lk')
              =< ap (CJ0.E.val z pk) (sh1 m) > CJ0.E.val z pk (subE m Lk)
              =< sym (recombine (CJ0.E.val z p0 (subE m Lk)) (CJ0.E.val z pk (subE m Lk)))
              > A.add (CJ0.E.val z p0 (subE m Lk)) (A.add (CJ0.E.val z pk (subE m Lk)) (A.neg (CJ0.E.val z p0 (subE m Lk))))
              =< Ps.cong2 A.R A.add _ _ _ _
                   (sym (trans (cf-shift Lk' sT m) (trans (HS.cf-T (subE m Lk')) (ap (CJ0.E.val z p0) (sh2 m)))))
                   (sym (cf-J m))
              > A.add (FPA.cf (PAA.scaleT (A.o, Lk') sT) m) (FPA.cf (PAA.psum ZM.three (\ q -> PAA.pmul (pJ q) (TY q))) m)
              =< sym (FPA.cf-app (PAA.scaleT (A.o, Lk') sT) (PAA.psum ZM.three (\ q -> PAA.pmul (pJ q) (TY q))) m)
              > FPA.cf rhs m } ;
          -- (DL) on this edge
          dl : Id ST.E.R (ST.E.mul s (CO.bpow yk (suc bk))) (CO.deh qk) = sym (calc ST.E.R {
            CO.deh qk
              =< sym (trans (deh-shift L0 qk) (trans (ap (\ w' -> ST.E.mul w' (CO.deh qk)) ST.one3) (LE.one-left (CO.deh qk))))
              > CO.deh (PAA.scaleT (A.o, L0) qk)
              =< DH.deh-cf (PAA.scaleT (A.o, L0) qk) rhs cf-id > CO.deh rhs
              =< ST.deh-app (PAA.scaleT (A.o, Lk') sT) (PAA.psum ZM.three (\ q -> PAA.pmul (pJ q) (TY q)))
              > ST.E.add (CO.deh (PAA.scaleT (A.o, Lk') sT)) (CO.deh (PAA.psum ZM.three (\ q -> PAA.pmul (pJ q) (TY q))))
              =< Ps.cong2 ST.E.R ST.E.add _ _ _ _ (deh-shift Lk' sT) (deh-psum-zero ZM.three (\ q -> PAA.pmul (pJ q) (TY q)) (deh-J TY))
              > ST.E.add (ST.E.mul (CO.mon Lk') s) ST.E.z
              =< trans (ST.E.addZ (ST.E.mul (CO.mon Lk') s)) (trans (ap (\ w' -> ST.E.mul w' s) monK) (ST.E.mulC (CO.bpow yk (suc bk)) s))
              > ST.E.mul s (CO.bpow yk (suc bk)) }) ;
        } ;

        -- the three edges
        B1 : Base.Nat = n1 B ;
        B2 : Base.Nat = n2 B ;
        B3 : Base.Nat = n3 B ;
        monK1 : Id ST.E.R (CO.mon (nx zero (suc B1) zero zero)) (CO.bpow (ST.FD.y ZM.i1) (suc B1)) =
          trans (ap (ST.E.mul (CO.bpow (ST.FD.y ZM.i1) (suc B1))) (LE.one-left ST.E.o)) (ST.E.mulO (CO.bpow (ST.FD.y ZM.i1) (suc B1))) ;
        monK2 : Id ST.E.R (CO.mon (nx zero zero (suc B2) zero)) (CO.bpow (ST.FD.y ZM.i2) (suc B2)) =
          trans (LE.one-left (ST.E.mul (CO.bpow (ST.FD.y ZM.i2) (suc B2)) ST.E.o)) (ST.E.mulO (CO.bpow (ST.FD.y ZM.i2) (suc B2))) ;
        monK3 : Id ST.E.R (CO.mon (nx zero zero zero (suc B3))) (CO.bpow (ST.FD.y ZM.i3) (suc B3)) =
          trans (LE.one-left (ST.E.mul ST.E.o (CO.bpow (ST.FD.y ZM.i3) (suc B3)))) (LE.one-left (CO.bpow (ST.FD.y ZM.i3) (suc B3))) ;
        module E1 = Edge[p1,e01,nx zero (suc B1) zero zero,nx (suc B0) (suc B1) zero zero,B1,ST.FD.y ZM.i1,
          dom (setPt p1) (XE.le4-refl (setPt p1)) (nx zero (suc B1) zero zero) (XE.lpat-p1 B),
          dom (setEd e01) (XE.le4-refl (setEd e01)) (nx (suc B0) (suc B1) zero zero) (XE.lpat-e01 B),
          XE.size-s1 B1,XE.sh1-1 (suc B0) (suc B1),XE.sh2-1 (suc B0) (suc B1),monK1,d-val1 z] ;
        module E2 = Edge[p2,e02,nx zero zero (suc B2) zero,nx (suc B0) zero (suc B2) zero,B2,ST.FD.y ZM.i2,
          dom (setPt p2) (XE.le4-refl (setPt p2)) (nx zero zero (suc B2) zero) (XE.lpat-p2 B),
          dom (setEd e02) (XE.le4-refl (setEd e02)) (nx (suc B0) zero (suc B2) zero) (XE.lpat-e02 B),
          XE.size-s2 B2,XE.sh1-2 (suc B0) (suc B2),XE.sh2-2 (suc B0) (suc B2),monK2,d-val2 z] ;
        module E3 = Edge[p3,e03,nx zero zero zero (suc B3),nx (suc B0) zero zero (suc B3),B3,ST.FD.y ZM.i3,
          dom (setPt p3) (XE.le4-refl (setPt p3)) (nx zero zero zero (suc B3)) (XE.lpat-p3 B),
          dom (setEd e03) (XE.le4-refl (setEd e03)) (nx (suc B0) zero zero (suc B3)) (XE.lpat-e03 B),
          XE.size-s3 B3,XE.sh1-3 (suc B0) (suc B3),XE.sh2-3 (suc B0) (suc B3),monK3,d-val3 z] ;
        -- the data indexed by the three generators
        mF2 : Ps.Fin (suc (suc zero)) -> Base.Nat = split { inl k -> B1 ; inr u -> B2 } ;
        mF : Ps.Fin ZM.three -> Base.Nat = split { inl k -> mF2 k ; inr u -> B3 } ;
        qF2 : Ps.Fin (suc (suc zero)) -> TPoly A.R = split { inl k -> E1.qk ; inr u -> E2.qk } ;
        qF : Ps.Fin ZM.three -> TPoly A.R = split { inl k -> qF2 k ; inr u -> E3.qk } ;
        hqF2 : (k : Ps.Fin (suc (suc zero))) -> HomDeg A.R (mF2 k) (qF2 k) = split { inl k -> E1.HK.hom ; inr u -> E2.HK.hom } ;
        hqF : (k : Ps.Fin ZM.three) -> HomDeg A.R (mF k) (qF k) = split { inl k -> hqF2 k ; inr u -> E3.HK.hom } ;
        dlT1 : (u : Top) -> Id ST.E.R (ST.E.mul s (CO.bpow (ST.FD.y (inl (inl (inr u)))) (suc B1))) (CO.deh E1.qk) = split { tt -> E1.dl } ;
        dlT2 : (u : Top) -> Id ST.E.R (ST.E.mul s (CO.bpow (ST.FD.y (inl (inr u))) (suc B2))) (CO.deh E2.qk) = split { tt -> E2.dl } ;
        dlT3 : (u : Top) -> Id ST.E.R (ST.E.mul s (CO.bpow (ST.FD.y (inr u)) (suc B3))) (CO.deh E3.qk) = split { tt -> E3.dl } ;
        dlF1 : (k : Ps.Fin (suc zero)) -> Id ST.E.R (ST.E.mul s (CO.bpow (ST.FD.y (inl (inl k))) (suc B1))) (CO.deh E1.qk) = split {
          inl k -> absurd (Id ST.E.R (ST.E.mul s (CO.bpow (ST.FD.y (inl (inl (inl k)))) (suc B1))) (CO.deh E1.qk)) k ;
          inr u -> dlT1 u } ;
        dlF2 : (k : Ps.Fin (suc (suc zero))) -> Id ST.E.R (ST.E.mul s (CO.bpow (ST.FD.y (inl k)) (suc (mF2 k)))) (CO.deh (qF2 k)) = split {
          inl k -> dlF1 k ;
          inr u -> dlT2 u } ;
        dlF : (k : Ps.Fin ZM.three) -> Id ST.E.R (ST.E.mul s (CO.bpow (ST.FD.y k) (suc (mF k)))) (CO.deh (qF k)) = split {
          inl k -> dlF2 k ;
          inr u -> dlT3 u } ;

        -- s = 1 + sum_j b_j v_j, from the chart Z
        X (j : Ps.Fin D0.t) : TPoly A.R =
          HP[setPt p0,CJ0.E.val (xs j) p0,S,\ m nm -> sx j p0 m nm,\ m o -> CJ0.E.van (xs j) p0 m (inr o),\ m h -> CJ0.E.van (xs j) p0 m (inl h),
             L0,dom (setPt p0) (XE.le4-refl (setPt p0)) L0 (XE.lpat-p0 B),B0,trans (ap (minus (pos B0)) (XE.size-s0 B0)) (XE.mone-shift B0)].T ;
        cf-X (j : Ps.Fin D0.t) (m : E4) : Id A.R (FPA.cf (X j) m) (CJ0.E.val (xs j) p0 (subE m L0)) =
          HP[setPt p0,CJ0.E.val (xs j) p0,S,\ m nm -> sx j p0 m nm,\ m o -> CJ0.E.van (xs j) p0 m (inr o),\ m h -> CJ0.E.van (xs j) p0 m (inl h),
             L0,dom (setPt p0) (XE.le4-refl (setPt p0)) L0 (XE.lpat-p0 B),B0,trans (ap (minus (pos B0)) (XE.size-s0 B0)) (XE.mone-shift B0)].cf-T m ;
        module TY'q (q : Ps.Fin ZM.three) {
          module C = PO.ChartPoly[setPt p0,Yv' q p0,S,\ m nm -> sy' q p0 m nm,\ m o -> CY'[q].C.van (v.2.2.1 q) p0 m (inr o),
            L0,dom (setPt p0) (XE.le4-refl (setPt p0)) L0 (XE.lpat-p0 B)] ;
        } ;
        TY' (q : Ps.Fin ZM.three) : TPoly A.R = TY'q[q].C.rep.1 ;
        O : TPoly A.R = cons (A.o, nx B0 zero zero zero) nil ;
        XS : TPoly A.R = PAA.psum D0.t (\ j -> PAA.scaleT (D0.b j, nx zero zero zero zero) (X j)) ;
        YS : TPoly A.R = PAA.psum ZM.three (\ q -> PAA.pmul (pJ q) (TY' q)) ;
        rhsZ : TPoly A.R = Bar[l].app O (Bar[l].app XS YS) ;
        -- the I- and J-witnesses on the chart Z, pointwise
        x' : CJ0.E.El = v.1 ;
        hx (m : E4) : Id A.R (CJ0.E.val x' p0 m) (RSA.sum D0.t (\ j -> A.mul (D0.b j) (CJ0.E.val (xs j) p0 m))) =
          trans (ap (\ x -> CJ0.E.val x p0 m) v.2.1.2.2)
            (ShiftedCech4[l].Over[A,setA].ChartSums[Pt,BadI Pt setPt TL4.mOne].val-sum D0.t (\ j -> CJ0.E.mod.sm (D0.b j) (xs j)) p0 m) ;
        hY (m : E4) : Id A.R (A.add (A.add (CJ0.E.val z p0 m) (A.neg (CJ0.E.val z0 p0 m))) (A.neg (CJ0.E.val x' p0 m)))
          (RSA.sum ZM.three (\ q -> PAA.mulP (pJ q) (Yv' q p0) m)) =
          trans (ap (\ x -> CJ0.E.val x p0 m) v.2.2.2)
            (ShiftedCech4[l].Over[A,setA].ChartSums[Pt,BadI Pt setPt TL4.mOne].val-sum ZM.three (\ q -> (CJ0.F.gi q).f (v.2.2.1 q)) p0 m) ;
        -- a - b - c = r gives a = b + (c + r)
        solve3 (a b c r : A.R) (h : Id A.R (A.add (A.add a (A.neg b)) (A.neg c)) r) : Id A.R a (A.add b (A.add c r)) = calc A.R {
          a =< sym (recombine b a) > A.add b (A.add a (A.neg b))
            =< ap (A.add b) (sym (recombine c (A.add a (A.neg b)))) > A.add b (A.add c (A.add (A.add a (A.neg b)) (A.neg c)))
            =< ap (\ w' -> A.add b (A.add c w')) h > A.add b (A.add c r) } ;
        cf-Z (m : E4) : Id A.R (FPA.cf sT m) (FPA.cf rhsZ m) = calc A.R {
          FPA.cf sT m
            =< HS.cf-T m > CJ0.E.val z p0 (subE m L0)
            =< solve3 (CJ0.E.val z p0 (subE m L0)) (CJ0.E.val z0 p0 (subE m L0)) (CJ0.E.val x' p0 (subE m L0))
                 (RSA.sum ZM.three (\ q -> PAA.mulP (pJ q) (Yv' q p0) (subE m L0))) (hY (subE m L0))
            > A.add (CJ0.E.val z0 p0 (subE m L0)) (A.add (CJ0.E.val x' p0 (subE m L0)) (RSA.sum ZM.three (\ q -> PAA.mulP (pJ q) (Yv' q p0) (subE m L0))))
            =< Ps.cong2 A.R A.add _ _ _ _
                 (trans (hz0 (subE m L0)) (sym (trans (A.addZ (A.mul A.o (FPA.delta0 (subE m (nx B0 zero zero zero)))))
                    (trans (LA.one-left (FPA.delta0 (subE m (nx B0 zero zero zero)))) (ap FPA.delta0 (sym (XE.shift-one B0 m)))))))
                 (Ps.cong2 A.R A.add _ _ _ _
                   (trans (hx (subE m L0))
                     (sym (trans (FPA.cf-psum D0.t (\ j -> PAA.scaleT (D0.b j, nx zero zero zero zero) (X j)) m)
                       (RSA.sum-cong D0.t (\ j -> FPA.cf (PAA.scaleT (D0.b j, nx zero zero zero zero) (X j)) m)
                          (\ j -> A.mul (D0.b j) (CJ0.E.val (xs j) p0 (subE m L0)))
                          (\ j -> trans (PAA.mulP-scaleT (D0.b j, nx zero zero zero zero) (X j) FPA.delta0 m)
                                    (ap (A.mul (D0.b j)) (trans (ap (FPA.cf (X j)) (XE.subE-zero m)) (cf-X j m))))))))
                   (sym (trans (FPA.cf-psum ZM.three (\ q -> PAA.pmul (pJ q) (TY' q)) m)
                     (RSA.sum-cong ZM.three (\ q -> FPA.cf (PAA.pmul (pJ q) (TY' q)) m) (\ q -> PAA.mulP (pJ q) (Yv' q p0) (subE m L0))
                        (\ q -> trans (FPA.cf-pmul (pJ q) (TY' q) m)
                                 (trans (PAA.mulP-cong (pJ q) (FPA.cf (TY' q)) (\ m' -> Yv' q p0 (subE m' L0)) (TY'q[q].C.rep.2) m)
                                   (PAA.mulP-shift (\ x -> subE x L0) (\ x u -> subE-comm x L0 u) (pJ q) (Yv' q p0) m)))))))
            > A.add (FPA.cf O m) (A.add (FPA.cf XS m) (FPA.cf YS m))
            =< sym (trans (FPA.cf-app O (Bar[l].app XS YS) m) (ap (A.add (FPA.cf O m)) (FPA.cf-app XS YS m)))
            > FPA.cf rhsZ m } ;
        deh-psum : (n : Nat) (f : Ps.Fin n -> TPoly A.R) -> Id ST.E.R (CO.deh (PAA.psum n f)) (FS.sum n (\ i -> CO.deh (f i))) = split {
          zero -> \ f -> refl ST.E.z ;
          suc n | r -> \ f -> trans (ST.deh-app (f (inr tt)) (PAA.psum n (\ i -> f (inl i)))) (ap (ST.E.add (CO.deh (f (inr tt)))) (r (\ i -> f (inl i)))) } ;
        vj (j : Ps.Fin D0.t) : ST.E.R = CO.deh (X j) ;
        cong : FiniteIdeal[l].Over[ST.E,D0.t,\ j -> ST.iota.1 (D0.b j)].Certificate s ST.E.o = (vj, calc ST.E.R {
          s =< DH.deh-cf sT rhsZ cf-Z > CO.deh rhsZ
            =< trans (ST.deh-app O (Bar[l].app XS YS)) (ap (ST.E.add (CO.deh O)) (ST.deh-app XS YS))
            > ST.E.add (CO.deh O) (ST.E.add (CO.deh XS) (CO.deh YS))
            =< Ps.cong2 ST.E.R ST.E.add _ _ _ _
                 (trans (ST.deh-term A.o (nx B0 zero zero zero)) (trans (ap (\ w' -> ST.E.mul w' (CO.mon3 zero zero zero)) ST.iota.2.1)
                    (trans (LE.one-left (CO.mon3 zero zero zero)) ST.one3)))
                 (Ps.cong2 ST.E.R ST.E.add _ _ _ _
                   (trans (deh-psum D0.t (\ j -> PAA.scaleT (D0.b j, nx zero zero zero zero) (X j)))
                     (FS.sum-cong D0.t (\ j -> CO.deh (PAA.scaleT (D0.b j, nx zero zero zero zero) (X j))) (\ j -> ST.E.mul (ST.iota.1 (D0.b j)) (vj j))
                        (\ j -> trans (CO.deh-scale (D0.b j) (nx zero zero zero zero) (X j))
                                  (ap (\ w' -> ST.E.mul w' (vj j)) (trans (ap (ST.E.mul (ST.iota.1 (D0.b j))) ST.one3) (ST.E.mulO (ST.iota.1 (D0.b j))))))))
                   (deh-psum-zero ZM.three (\ q -> PAA.pmul (pJ q) (TY' q)) (deh-J TY')))
            > ST.E.add ST.E.o (ST.E.add (FS.lin D0.t (\ j -> ST.iota.1 (D0.b j)) vj) ST.E.z)
            =< ap (ST.E.add ST.E.o) (ST.E.addZ (FS.lin D0.t (\ j -> ST.iota.1 (D0.b j)) vj))
            > ST.E.add ST.E.o (FS.lin D0.t (\ j -> ST.iota.1 (D0.b j)) vj) }) ;

        -- THE CERTIFICATE (ZMT4Certificate.Data)
        module DA = CO.Data[s,B0,sT,HS.hom,refl s,mF,qF,hqF,dlF,D0.t,D0.b,cong] ;
        certificate : ZC.ZMTCert[A,ST.E,ST.iota,ZM.three,ST.FD.y,D0.t,D0.b] = DA.certificate ;
      } ;

      -- the supports, merely, and one list containing them
      ZT : U l = ZC.ZMTCert[A,ST.E,ST.iota,ZM.three,ST.FD.y,D0.t,D0.b] ;
      SZ : U l = CJ0.E.SuppW (CJ0.E.val z) ;
      SYs : U l = (q : Ps.Fin ZM.three) -> CY[q].C.SuppW (Yv q) ;
      SXs : U l = (j : Ps.Fin D0.t) -> CJ0.E.SuppW (CJ0.E.val (xs j)) ;
      SY's : U l = (q : Ps.Fin ZM.three) -> CY'[q].C.SuppW (Yv' q) ;
      -- vanishing off a larger list
      vsub (I : U l) (c : I -> E4 -> A.R) (s0 S : List E4) (inc : (m : E4) -> Mem m s0 -> Mem m S)
        (h : (i : I) (m : E4) -> Not (Mem m s0) -> Id A.R (c i m) A.z) (i : I) (m : E4) (nm : Not (Mem m S)) : Id A.R (c i m) A.z =
        h i m (\ hm -> nm (inc m hm)) ;
      module All4 (cz : SZ) (cy : SYs) (cx : SXs) (cy' : SY's) {
        sY : List E4 = LSL.catL ZM.three (\ q -> (cy q).1) ;
        sX : List E4 = LSL.catL D0.t (\ j -> (cx j).1) ;
        sY' : List E4 = LSL.catL ZM.three (\ q -> (cy' q).1) ;
        S : List E4 = appL cz.1 (appL sY (appL sX sY')) ;
        inc-z (m : E4) (h : Mem m cz.1) : Mem m S = mem-appl m cz.1 (appL sY (appL sX sY')) h ;
        inc-y (q : Ps.Fin ZM.three) (m : E4) (h : Mem m (cy q).1) : Mem m S =
          mem-appr m cz.1 (appL sY (appL sX sY')) (mem-appl m sY (appL sX sY') (LSL.mem-cat ZM.three (\ q' -> (cy q').1) q m h)) ;
        inc-x (j : Ps.Fin D0.t) (m : E4) (h : Mem m (cx j).1) : Mem m S =
          mem-appr m cz.1 (appL sY (appL sX sY')) (mem-appr m sY (appL sX sY') (mem-appl m sX sY' (LSL.mem-cat D0.t (\ j' -> (cx j').1) j m h))) ;
        inc-y' (q : Ps.Fin ZM.three) (m : E4) (h : Mem m (cy' q).1) : Mem m S =
          mem-appr m cz.1 (appL sY (appL sX sY')) (mem-appr m sY (appL sX sY') (mem-appr m sX sY' (LSL.mem-cat ZM.three (\ q' -> (cy' q').1) q m h))) ;
        module LL = L[S,vsub Pt (CJ0.E.val z) cz.1 S inc-z cz.2,
          \ q -> vsub Ed (Yv q) (cy q).1 S (inc-y q) (cy q).2,
          \ j -> vsub Pt (CJ0.E.val (xs j)) (cx j).1 S (inc-x j) (cx j).2,
          \ q -> vsub Pt (Yv' q) (cy' q).1 S (inc-y' q) (cy' q).2] ;
      } ;
      cert : Tr.Trunc[ZT].carrier =
        TC.bind SZ ZT (\ cz ->
          TC.bind SYs ZT (\ cy ->
            TC.bind SXs ZT (\ cx ->
              TC.map SY's ZT (\ cy' -> All4[cz,cy,cx,cy'].LL.certificate)
                (LSL.fin-choice ZM.three (\ q -> CY'[q].C.SuppW (Yv' q)) (\ q -> CY'[q].C.supp (v.2.2.1 q))))
              (LSL.fin-choice D0.t (\ j -> CJ0.E.SuppW (CJ0.E.val (xs j))) (\ j -> CJ0.E.supp (xs j))))
            (LSL.fin-choice ZM.three (\ q -> CY[q].C.SuppW (Yv q)) (\ q -> CY[q].C.supp (w.1 q))))
          (CJ0.E.supp z) ;
    } ;

    -- THEOREM (extraction): a section closed modulo J and reducing to Z^-1
    -- modulo I gives merely the certificate
    extract (cl : CJ1.InJ (d z)) (red : CJ0.IJ (suc zero) (CJ0.ML.msub z z0)) : Tr.Trunc[ZC.ZMTCert[A,ST.E,ST.iota,ZM.three,ST.FD.y,D0.t,D0.b]].carrier =
      TC.bind (CJ1.JW (d z)) (ZC.ZMTCert[A,ST.E,ST.iota,ZM.three,ST.FD.y,D0.t,D0.b])
        (\ w -> TC.bind (CJ0.IJW (suc zero) (CJ0.ML.msub z z0)) (ZC.ZMTCert[A,ST.E,ST.iota,ZM.three,ST.FD.y,D0.t,D0.b]) (\ v -> W[w,v].cert) red) cl ;
  } ;
} ;
