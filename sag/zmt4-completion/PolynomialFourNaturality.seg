-- A map of four-variable rings which sends coefficients by f and fixes
-- the four named variables sends the value of a term list to the value
-- of the coefficient-mapped list.  Prove this term by term, then add.
level l ; open Ring[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ;

module Over (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R)
  (f : RH.Hom A B) {
  module X = PolynomialRing4Bridge[l].Over[A,setA] ;
  module Y = PolynomialRing4Bridge[l].Over[B,setB] ;
  mapT : TPoly A.R -> TPoly B.R = split {
    nil -> nil ; cons t p | r -> cons (f.1 t.1,t.2) r } ;
  module Given (h : RH.Hom X.S Y.S)
    (hc : (c : A.R) -> Id Y.S.R (h.1 (X.cst c)) (Y.cst (f.1 c)))
    (h0 : Id Y.S.R (h.1 X.X0) Y.X0) (h1 : Id Y.S.R (h.1 X.X1) Y.X1)
    (h2 : Id Y.S.R (h.1 X.X2) Y.X2) (h3 : Id Y.S.R (h.1 X.X3) Y.X3) {
    times (x y : X.S.R) (v w : Y.S.R) (hx : Id Y.S.R (h.1 x) v) (hy : Id Y.S.R (h.1 y) w) :
      Id Y.S.R (h.1 (X.S.mul x y)) (Y.S.mul v w) =
      trans (h.2.2.2 x y) (Ps.cong2 Y.S.R Y.S.mul _ _ _ _ hx hy) ;
    power (x : X.S.R) (v : Y.S.R) (hx : Id Y.S.R (h.1 x) v) :
      (n : Base.Nat) -> Id Y.S.R (h.1 (X.pw x n)) (Y.pw v n) = split {
      zero -> h.2.1 ;
      suc n | r -> times (X.pw x n) x (Y.pw v n) v r hx } ;
    term (c : A.R) : (u : N4) -> Id Y.S.R (h.1 (X.term c u)) (Y.term (f.1 c) u) = split {
      nx a b c1 d -> times (X.cst c)
        (X.S.mul (X.pw X.X0 a) (X.S.mul (X.pw X.X1 b) (X.S.mul (X.pw X.X2 c1) (X.pw X.X3 d))))
        (Y.cst (f.1 c))
        (Y.S.mul (Y.pw Y.X0 a) (Y.S.mul (Y.pw Y.X1 b) (Y.S.mul (Y.pw Y.X2 c1) (Y.pw Y.X3 d)))) (hc c)
        (times (X.pw X.X0 a) (X.S.mul (X.pw X.X1 b) (X.S.mul (X.pw X.X2 c1) (X.pw X.X3 d)))
          (Y.pw Y.X0 a) (Y.S.mul (Y.pw Y.X1 b) (Y.S.mul (Y.pw Y.X2 c1) (Y.pw Y.X3 d))) (power X.X0 Y.X0 h0 a)
          (times (X.pw X.X1 b) (X.S.mul (X.pw X.X2 c1) (X.pw X.X3 d))
            (Y.pw Y.X1 b) (Y.S.mul (Y.pw Y.X2 c1) (Y.pw Y.X3 d)) (power X.X1 Y.X1 h1 b)
            (times (X.pw X.X2 c1) (X.pw X.X3 d) (Y.pw Y.X2 c1) (Y.pw Y.X3 d)
              (power X.X2 Y.X2 h2 c1) (power X.X3 Y.X3 h3 d)))) } ;
    phi : (p : TPoly A.R) -> Id Y.S.R (h.1 (X.phi p)) (Y.phi (mapT p)) = split {
      nil -> RH.zero X.S Y.S h ;
      cons t p | r -> trans (h.2.2.1 (X.term t.1 t.2) (X.phi p))
        (Ps.cong2 Y.S.R Y.S.add _ _ _ _ (term t.1 t.2) r) } ;
  } ;
} ;
