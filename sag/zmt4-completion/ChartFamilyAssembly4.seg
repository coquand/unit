-- Assemble finitely many local singleton-chart cochains into the actual
-- I-indexed chart module. A finite enumeration need only cover I; it need
-- not be injective. Choose finitely many support lists inside truncation,
-- take their union, and retain the actual coefficients pointwise.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;

module Product (A : CRing) (I : U l) (M : I -> IP.Mod[A]) {
  El : U l = (i : I) -> (M i).M ;
  ext (x y : El) (h : (i : I) -> Id (M i).M (x i) (y i)) : Id El x y =
    FE.funext I (\ i -> (M i).M) x y h ;
  mod : IP.Mod[A] = IP.mkMod A El (\ i -> (M i).mz)
    (\ x y i -> (M i).madd (x i) (y i)) (\ x i -> (M i).mneg (x i))
    (\ x y z -> ext _ _ (\ i -> (M i).maddA (x i) (y i) (z i)))
    (\ x y -> ext _ _ (\ i -> (M i).maddC (x i) (y i)))
    (\ x -> ext _ _ (\ i -> (M i).maddZ (x i)))
    (\ x -> ext _ _ (\ i -> (M i).maddN (x i)))
    (\ a x i -> (M i).sm a (x i))
    (\ a b x -> ext _ _ (\ i -> (M i).smA a b (x i)))
    (\ x -> ext _ _ (\ i -> (M i).smO (x i)))
    (\ a x y -> ext _ _ (\ i -> (M i).smD a (x i) (y i)))
    (\ a b x -> ext _ _ (\ i -> (M i).smE a b (x i))) ;
} ;

module Over (A : CRing) (setA : Pr.isSet A.R) (I : U l) (set : I -> Sub4)
  (n : Nat) (ix : Ps.Fin n -> I) (cover : (i : I) -> (j : Ps.Fin n) * Id I (ix j) i) (k : Int) {
  module LO = Laurent4[l].Over[A,setA] ;
  module CH = LO.Chart[I,BadI I set k] ;
  module Local (i : I) {
    module C = LO.Chart[Sq,BadI Sq (\ j -> set i) k] ;
  } ;
  module P = Product[A,I,\ i -> Local[i].C.mod] ;
  raw (f : P.El) (i : I) (m : E4) : A.R = Local[i].C.val (f i) s0123 m ;
  Supports (f : P.El) : U l = (j : Ps.Fin n) -> Local[ix j].C.SuppW (Local[ix j].C.val (f (ix j))) ;
  module Support (f : P.El) (sw : Supports f) {
    lists (j : Ps.Fin n) : List E4 = (sw j).1 ;
    union : List E4 = LaurentSyzygyLift4[l].catL n lists ;
    at (i : I) (m : E4) : Id A.R (raw f (ix (cover i).1) m) (raw f i m) =
      ap (\ j -> raw f j m) (cover i).2 ;
    outside (i : I) (m : E4) (off : Not (Mem m union)) : Id A.R (raw f i m) A.z =
      trans (sym (at i m))
        ((sw (cover i).1).2 s0123 m
          (\ h -> off (LaurentSyzygyLift4[l].mem-cat n lists (cover i).1 m h))) ;
    witness : CH.SuppW (raw f) = (union, outside) ;
  } ;
  support (f : P.El) : CH.Supp (raw f) =
    TC.map (Supports f) (CH.SuppW (raw f)) (\ sw -> Support[f,sw].witness)
      (LaurentSyzygyLift4[l].fin-choice n
        (\ j -> Local[ix j].C.SuppW (Local[ix j].C.val (f (ix j))))
        (\ j -> Local[ix j].C.supp (f (ix j)))) ;
  assemble (f : P.El) : CH.El = CH.mk (raw f) (support f)
    (\ i m b -> Local[i].C.van (f i) s0123 m b) ;
  value (f : P.El) (i : I) (m : E4) : Id A.R (CH.val (assemble f) i m) (Local[i].C.val (f i) s0123 m) =
    refl (Local[i].C.val (f i) s0123 m) ;
  linear : IP.Lin[A,P.mod,CH.mod] = IP.mkLin A P.mod CH.mod assemble
    (\ f g -> CH.eq _ _ (\ i m -> refl (A.add (raw f i m) (raw g i m))))
    (\ a f -> CH.eq _ _ (\ i m -> refl (A.mul a (raw f i m)))) ;
} ;

one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ;
four : Nat = suc three ; five : Nat = suc four ; six : Nat = suc five ;
pt1 (j : Ps.Fin one) : Pt = p0 ;
pt2 : Ps.Fin two -> Pt = Ps.snoc (Ps.Fin one) Pt pt1 p1 ;
pt3 : Ps.Fin three -> Pt = Ps.snoc (Ps.Fin two) Pt pt2 p2 ;
pt : Ps.Fin four -> Pt = Ps.snoc (Ps.Fin three) Pt pt3 p3 ;
cover-pt : (i : Pt) -> (j : Ps.Fin four) * Id Pt (pt j) i = split {
  p0 -> (inl (inl (inl (inr tt))),refl p0) ;
  p1 -> (inl (inl (inr tt)),refl p1) ;
  p2 -> (inl (inr tt),refl p2) ;
  p3 -> (inr tt,refl p3) } ;
ed1 (j : Ps.Fin one) : Ed = e01 ;
ed2 : Ps.Fin two -> Ed = Ps.snoc (Ps.Fin one) Ed ed1 e02 ;
ed3 : Ps.Fin three -> Ed = Ps.snoc (Ps.Fin two) Ed ed2 e03 ;
ed4 : Ps.Fin four -> Ed = Ps.snoc (Ps.Fin three) Ed ed3 e12 ;
ed5 : Ps.Fin five -> Ed = Ps.snoc (Ps.Fin four) Ed ed4 e13 ;
ed : Ps.Fin six -> Ed = Ps.snoc (Ps.Fin five) Ed ed5 e23 ;
cover-ed : (i : Ed) -> (j : Ps.Fin six) * Id Ed (ed j) i = split {
  e01 -> (inl (inl (inl (inl (inl (inr tt))))),refl e01) ;
  e02 -> (inl (inl (inl (inl (inr tt)))),refl e02) ;
  e03 -> (inl (inl (inl (inr tt))),refl e03) ;
  e12 -> (inl (inl (inr tt)),refl e12) ;
  e13 -> (inl (inr tt),refl e13) ;
  e23 -> (inr tt,refl e23) } ;
