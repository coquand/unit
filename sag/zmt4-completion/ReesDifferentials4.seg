-- The two differential facts used in assembling the section sequence:
-- evaluation commutes with delta:C^1->C^2; J chart images are stable under
-- delta.  Thus delta w is in J whenever delta z-w is in J, by delta²=0.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ; open ShiftedCech4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Over (A : CRing) (setA : Pr.isSet A.R) (t : Nat) (a : Ps.Fin t -> A.R)
  (s : Nat) (p : Ps.Fin s -> TPoly A.R) (e : Ps.Fin s -> Base.Nat)
  (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
  module BG = ReesBridge4[l].Over[A,setA,t,a,s,p,e,hp] ;
  module EV = BG.EV ;
  module CD = Cech4[l].Over[BG.D,BG.setD] ;
  module CA = Cech4[l].Over[A,setA] ;
  module CH = ReesChart4[l].Over[A,setA,t,a,s,p,e,hp] ;
  tri-eval (x y z : BG.D.R) :
    Id A.R (EV.ev.1 (BG.D.add (CD.DL.msub x y) z))
      (A.add (CA.DL.msub (EV.ev.1 x) (EV.ev.1 y)) (EV.ev.1 z)) =
    trans (EV.ev.2.2.1 (CD.DL.msub x y) z) (ap (\ v -> A.add v (EV.ev.1 z)) (EV.ev-sub x y)) ;
  tri-raw (x : Ed -> E4 -> BG.D.R) : (i : Tri) (m : E4) ->
    Id A.R (EV.ev.1 (CD.d1 x i m)) (CA.d1 (\ j m' -> EV.ev.1 (x j m')) i m) = split {
    t012 -> \ m -> tri-eval (x e12 m) (x e02 m) (x e01 m) ;
    t013 -> \ m -> tri-eval (x e13 m) (x e03 m) (x e01 m) ;
    t023 -> \ m -> tri-eval (x e23 m) (x e03 m) (x e02 m) ;
    t123 -> \ m -> tri-eval (x e23 m) (x e13 m) (x e12 m) } ;
  module Degree (k : Int) {
    module EC1 = EV.EvChart[Ed,BadI Ed setEd k] ;
    module EC2 = EV.EvChart[Tri,BadI Tri setTri k] ;
    module J0 = CH.JC[Pt,setPt,k] ;
    module J1 = CH.JC[Ed,setEd,k] ;
    module J2 = CH.JC[Tri,setTri,k] ;
    module DL = RelationCertificate[l].LinL[A,J1.E.mod,J2.E.mod,CA.D1 k] ;
    module JD = CH.HM.DiffFam[CH.MJ,Ed,setEd,Tri,setTri,CA.D1,
      \ k0 k1 p0 h x -> CH.SCA.Comm[k0,k1,p0,h].d1 x,k] ;
    eval-d1 (x : EC1.CHD.El) : Id EC2.CHA.El (EC2.evc ((CD.D1 k).f x)) ((CA.D1 k).f (EC1.evc x)) =
      EC2.CHA.eq _ _ (tri-raw (EC1.CHD.val x)) ;
    module CP = BG.BA.CC.Diff[k] ;
    hom-d1 (n : Int) (x : EC1.CHD.El) (hx : EC1.P.Hom n x) : EC2.P.Hom n ((CD.D1 k).f x) =
      \ i m -> ap (\ y -> EC2.CHD.val y i m)
        (trans (CP.D1-proj n x) (ap (CD.D1 k).f (CP.P1.proj-hom n x hx))) ;
    jw-d1 (x : J1.E.El) (h : J1.JW x) : J2.JW ((CA.D1 k).f x) =
      (JD.d1.f h.1, trans (ap (CA.D1 k).f h.2) (JD.dA h.1)) ;
    in-d1 (x : J1.E.El) (h : J1.InJ x) : J2.InJ ((CA.D1 k).f x) =
      TC.map (J1.JW x) (J2.JW ((CA.D1 k).f x)) (jw-d1 x) h ;
    section-closed (z : J0.E.El) (w : J1.E.El) (h : J1.JW (J1.ML.msub ((CA.D0 k).f z) w)) :
      J2.InJ ((CA.D1 k).f w) =
      J2.zero-cong ((CA.D1 k).f w)
        (J2.cong-trans ((CA.D1 k).f w) ((CA.D1 k).f ((CA.D0 k).f z)) J2.E.mod.mz
          (J2.cong-sym ((CA.D1 k).f ((CA.D0 k).f z)) ((CA.D1 k).f w)
            (subst J2.InJ (DL.f-sub ((CA.D0 k).f z) w)
              (in-d1 (J1.ML.msub ((CA.D0 k).f z) w) (J1.in-of (J1.ML.msub ((CA.D0 k).f z) w) h))))
          (J2.cong-of-id ((CA.D1 k).f ((CA.D0 k).f z)) J2.E.mod.mz (CA.DD0 k z))) ;
  } ;
} ;
