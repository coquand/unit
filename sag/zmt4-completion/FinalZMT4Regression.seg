-- Unconditional end-to-end regressions: all supported generator counts
-- over Z/4Z, the zero fibre, and residual certificates over Z for finite
-- points and degree-zero monic equations. No ZMT principle parameter.
level l ; open Ring[l] ;
module Tr = Truncation[l] ; module Ps = Presentations[l] ;
module F = FinalZMT4[l] ; module Q = QuotientExamples[l] ; module DE = DescentExamples[l] ;

module Nonreduced (arity : F.Arity) {
  x (i : Ps.Fin (F.number arity)) : Q.R4.R = q2 ;
  module T = F.Theorem[Q.R4,Q.set4,Q.two,Q.even-prop,DE.E4,arity,x,Q.gen (F.number arity) x,Q.Two.finite] ;
  result : Tr.Trunc[T.F.Conclusion].carrier = T.result ;
} ;
module N0 = Nonreduced[generators0] ;
module N1 = Nonreduced[generators1] ;
module N2 = Nonreduced[generators2] ;
module N3 = Nonreduced[generators3] ;
zero-generators : Tr.Trunc[N0.T.F.Conclusion].carrier = N0.result ;
one-generator : Tr.Trunc[N1.T.F.Conclusion].carrier = N1.result ;
two-generators : Tr.Trunc[N2.T.F.Conclusion].carrier = N2.result ;
three-generators : Tr.Trunc[N3.T.F.Conclusion].carrier = N3.result ;

module ZeroFibre (arity : F.Arity) {
  x (i : Ps.Fin (F.number arity)) : Q.R4.R = q2 ;
  module T = F.Theorem[Q.R4,Q.set4,Q.all,\ a -> ZMod4[l].top-prop,DE.E4,arity,x,Q.gen (F.number arity) x,Q.Zero.finite] ;
  result : Tr.Trunc[T.F.Conclusion].carrier = T.result ;
} ;
module Z0 = ZeroFibre[generators0] ;
module Z3 = ZeroFibre[generators3] ;
zero-fibre-empty : Tr.Trunc[Z0.T.F.Conclusion].carrier = Z0.result ;
zero-fibre-three : Tr.Trunc[Z3.T.F.Conclusion].carrier = Z3.result ;

module IntegerResiduals {
  module Z = ZRing[l] ;
  module Point = SectionsRegressionData4[l].Point[Z.ring,Z.set] ;
  module Empty = SectionsRegressionData4[l].ZeroFibre[Z.ring,Z.set] ;
  module P = F.Residual[Nat * Nat,Z.ring,Z.set,ZCFN[l].cfn,Point.D0] ;
  module E = F.Residual[Nat * Nat,Z.ring,Z.set,ZCFN[l].cfn,Empty.D0] ;
  point : Tr.Trunc[P.T.AX.ZT].carrier = P.certificate ;
  empty : Tr.Trunc[E.T.AX.ZT].carrier = E.certificate ;
} ;
