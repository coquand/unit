-- Assemble the remaining theorem from explicit finite-fibre sections.
-- Ideal-power witnesses lift by the explicit Rees function.  Evaluation
-- commutes with delta; delta²=0 and the section remainders put evaluated
-- delta(c_n) in J.  Constructed localized kernel membership supplies the
-- exact KG lifts required by correction.  Eliminate the finite kernel
-- list only into the truncated certificate; no infinite choice is used.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module RA = ResidualAlgebra[l] ; module TL = TopList4[l] ;
module ZM = ZMT4Certificate[l] ;

module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
  (D0 : RA.Residual[A,setA,ZM.three])
  (pJ : Ps.Fin ZM.three -> TPoly A.R) (dJ : Ps.Fin ZM.three -> Base.Nat)
  (hpJ : (q : Ps.Fin ZM.three) -> HomDeg A.R (dJ q) (pJ q))
  (dehJ : (q : Ps.Fin ZM.three) -> Id ZMT4Setup[l].Over[A,setA,D0].E.R
    (ZMT4Setup[l].Over[A,setA,D0].CO.deh (pJ q)) ZMT4Setup[l].Over[A,setA,D0].E.z) {
  module AX = ZMT4AssemblyGeneral[l].ForGenerators[K0,A,setA,cfnA,D0,pJ,dJ,hpJ,dehJ] ;
  module RC = AX.RC ;
  module RDiff = ReesDifferentials4[l].Over[A,setA,D0.t,D0.b,ZM.three,pJ,dJ,hpJ] ;
  module RD = RDiff.Degree[TL.mOne] ;
  module RL = IdealPowerReesLift4[l].Over[A,setA,D0.t,D0.b].Chart[Ed,BadI Ed setEd TL.mOne] ;
  module KL = ReesCochainLift4[l].Over[K0,A,setA,cfnA,D0.t,D0.b,ZM.three,pJ,dJ,hpJ] ;
  module Sections (z : Nat -> RC.CJ0.E.El) (w : Nat -> RC.CJ1.E.El)
    (wit : (n : Nat) -> RC.CJ1.FC.Wit (suc (CoefficientParts[l].toB n)) (w n))
    (remainder : (n : Nat) -> RC.CJ1.JW (RC.CJ1.ML.msub (RC.d (z n)) (w n)))
    (compatibility : (n : Nat) -> RC.CJ0.IJ (suc zero) (RC.CJ0.ML.msub (z n) (z zero)))
    (hz0 : (m : E4) -> Id A.R (RC.CJ0.E.val (z zero) p0 m)
      (AX.X.FPA.delta0 (addE m (nx (suc zero) zero zero zero)))) {
    lifted (n : Nat) : RL.Result (suc (CoefficientParts[l].toB n)) (w n) =
      RL.lift (suc (CoefficientParts[l].toB n)) (w n) (wit n) ;
    c (n : Nat) : RL.CD.El = (lifted n).1 ;
    hc (n : Nat) : RL.EC.P.Hom (CoefficientParts[l].cdeg (suc n)) (c n) = (lifted n).2.1 ;
    ec (n : Nat) : Id RC.CJ1.E.El (RL.EC.evc (c n)) (w n) = (lifted n).2.2 ;
    closed-evaluation (n : Nat) : RD.J2.InJ (RD.EC2.evc ((RDiff.CD.D1 TL.mOne).f (c n))) =
      subst RD.J2.InJ
        (sym (trans (RD.eval-d1 (c n)) (ap (RDiff.CA.D1 TL.mOne).f (ec n))))
        (RD.section-closed (z n) (w n) (remainder n)) ;
    hz (n : Nat) : RC.CJ1.Cong (RL.EC.evc (c n)) (RC.d (z n)) =
      RC.CJ1.cong-trans (RL.EC.evc (c n)) (w n) (RC.d (z n))
        (RC.CJ1.cong-of-id (RL.EC.evc (c n)) (w n) (ec n))
        (RC.CJ1.cong-sym (RC.d (z n)) (w n)
          (RC.CJ1.in-of (RC.CJ1.ML.msub (RC.d (z n)) (w n)) (remainder n))) ;
    module List (kg : RC.WC.ReesW) (fw : RC.WC.WithGens[kg].F.FixedW) {
      module K = KL.List[kg,fw] ;
      lift (n : Nat) : Tr.Trunc[K.CI.Lifted (c n)].carrier =
        K.Input[suc (CoefficientParts[l].toB n),c n,hc n,closed-evaluation n].lift ;
      certificate : Tr.Trunc[AX.ZT].carrier =
        AX.Inputs[kg,fw,c,hc,lift,z,hz,compatibility,hz0].certificate ;
    } ;
    certificate : Tr.Trunc[AX.ZT].carrier =
      TC.bind RC.WC.ListW AX.ZT (\ kw -> List[kw.1,kw.2.1].certificate) RC.WC.finite-list ;
  } ;
} ;
