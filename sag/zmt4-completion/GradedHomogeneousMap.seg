-- Homogeneous elements are finite expressions in degree-one variables
-- with degree-zero base coefficients.  A ring map preserving these
-- degrees preserves homogeneity, without any choice of representatives.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ;

module Over (A B : CRing) (t : Nat) (R S : CRing)
  (setR : Pr.isSet R.R) (setS : Pr.isSet S.R)
  (G : Graded[A,t,R]) (v : Nat) (H : Graded[B,v,S])
  (f : RH.Hom R S)
  (hc : (a : A.R) -> Id S.R (H.pr zeroZ (f.1 (G.iota.1 a))) (f.1 (G.iota.1 a)))
  (hv : (j : Ps.Fin t) -> Id S.R (H.pr (pos (suc zero)) (f.1 (G.var j))) (f.1 (G.var j))) {
  module GL = Laws[A,t,R,setR,G] ;
  module HL = Laws[B,v,S,setS,H] ;
  module HS = HomSum[R,S,f] ;
  value-hom : (n : Base.Nat) (e : GL.Expr n) -> HL.Hom (pos n) (f.1 (GL.value n e)) = split {
    zero -> \ a -> hc a ;
    suc n | r -> \ e -> subst (HL.Hom (pos (suc n)))
      (sym (HS.map-sum t (\ j -> R.mul (G.var j) (GL.value n (e j)))))
      (HL.hom-sum (pos (suc n)) t (\ j -> f.1 (R.mul (G.var j) (GL.value n (e j))))
        (\ j -> subst (HL.Hom (pos (suc n))) (sym (f.2.2.2 (G.var j) (GL.value n (e j))))
          (subst (HL.Hom (pos (suc n))) (S.mulC (f.1 (GL.value n (e j))) (f.1 (G.var j)))
            (HL.hom-mul (pos n) (pos (suc zero)) (f.1 (GL.value n (e j))) (f.1 (G.var j)) (r (e j)) (hv j))))) } ;
  homogeneous (n : Base.Nat) (x : R.R) (hx : GL.Hom (pos n) x) : HL.Hom (pos n) (f.1 x) =
    subst (\ y -> HL.Hom (pos n) (f.1 y)) (GL.expr-value n x hx) (value-hom n (GL.expr n x hx)) ;
} ;
