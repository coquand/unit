-- The explicit local section and its naturality under ring maps. Both
-- natural-number sorts occur in the input (monic degree / power bound).
-- Everything is a finite ring expression; restrictions of charts
-- therefore carry the same section to the expression on the overlap.
level l ; open Ring[l] ;
module Ps = Presentations[l] ; module RH = RingHom[l] ; module IP = IdealPowers[l] ;

module Expression (R : CRing) (x z v : R.R) (unit : Id R.R (R.mul x v) R.o)
  (d : Nat) (c : Ps.Fin d -> R.R) (p M : Base.Nat) {
  module N = NormalizedMonicAlgebra[l].Over[R,x,z,v,unit] ;
  module P = SectionsPowerAlgebra[l].Over[R] ;
  module L = RL[R] ; module ML = IP.ModL[R,IP.regular R] ;
  u : R.R = N.u ;
  Q : R.R = N.quotient d c ;
  H : R.R = R.add R.o (R.mul u Q) ;
  module HP = P.PowersOfOne[u,Q,H,refl H] ;
  Qp : R.R = HP.quotient p ;
  module SG = SectionsErrorWitness[l].Separator[R,u,Qp,P.power H p,HP.factor p,M] ;
  a : R.R = SG.a ;
  b : R.R = SG.b ;
  t : R.R = SG.t ;
  section : R.R = R.mul t v ;
  coordinate-product : Id R.R (R.mul z section) (R.mul u t) =
    trans (L.mul-swap z t v) (R.mulC t u) ;
  error : Id R.R (ML.msub R.o (R.mul z section)) (R.mul a (P.power H p)) =
    trans (ap (ML.msub R.o) coordinate-product) SG.error ;
  B : R.R = R.mul b v ;
  factor : Id R.R section (R.mul B (P.power u M)) =
    trans (sym (R.mulA b (P.power u M) v))
      (trans (ap (R.mul b) (R.mulC (P.power u M) v)) (R.mulA b v (P.power u M))) ;
} ;

module Natural (R S : CRing) (f : RH.Hom R S)
  (x z v : R.R) (unit : Id R.R (R.mul x v) R.o)
  (x' z' v' : S.R) (unit' : Id S.R (S.mul x' v') S.o)
  (ex : Id S.R (f.1 x) x') (ez : Id S.R (f.1 z) z') (ev : Id S.R (f.1 v) v') {
  module NR = NormalizedMonicAlgebra[l].Over[R,x,z,v,unit] ;
  module NS = NormalizedMonicAlgebra[l].Over[S,x',z',v',unit'] ;
  module PR = SectionsPowerAlgebra[l].Over[R] ; module PS = SectionsPowerAlgebra[l].Over[S] ;
  times (a b : R.R) (a' b' : S.R) (ha : Id S.R (f.1 a) a') (hb : Id S.R (f.1 b) b') :
    Id S.R (f.1 (R.mul a b)) (S.mul a' b') = trans (f.2.2.2 a b) (Ps.cong2 S.R S.mul _ _ _ _ ha hb) ;
  plus (a b : R.R) (a' b' : S.R) (ha : Id S.R (f.1 a) a') (hb : Id S.R (f.1 b) b') :
    Id S.R (f.1 (R.add a b)) (S.add a' b') = trans (f.2.2.1 a b) (Ps.cong2 S.R S.add _ _ _ _ ha hb) ;
  u-map : Id S.R (f.1 NR.u) NS.u = times z v z' v' ez ev ;
  power (a : R.R) (a' : S.R) (ha : Id S.R (f.1 a) a') : (p : Base.Nat) ->
    Id S.R (f.1 (PR.power a p)) (PS.power a' p) = split {
    zero -> f.2.1 ; suc p | r -> times a (PR.power a p) a' (PS.power a' p) ha r } ;
  quotient : (d : Nat) (c : Ps.Fin d -> R.R) (c' : Ps.Fin d -> S.R) ->
    ((i : Ps.Fin d) -> Id S.R (f.1 (c i)) (c' i)) ->
    Id S.R (f.1 (NR.quotient d c)) (NS.quotient d c') = split {
    zero -> \ c c' hc -> RH.zero R S f ;
    suc d | r -> \ c c' hc -> plus (c (inr tt)) (R.mul NR.u (NR.quotient d (\ i -> c (inl i))))
      (c' (inr tt)) (S.mul NS.u (NS.quotient d (\ i -> c' (inl i)))) (hc (inr tt))
      (times NR.u (NR.quotient d (\ i -> c (inl i))) NS.u (NS.quotient d (\ i -> c' (inl i))) u-map
        (r (\ i -> c (inl i)) (\ i -> c' (inl i)) (\ i -> hc (inl i)))) } ;
  module At (d : Nat) (c : Ps.Fin d -> R.R) (c' : Ps.Fin d -> S.R)
    (hc : (i : Ps.Fin d) -> Id S.R (f.1 (c i)) (c' i)) {
    Q : R.R = NR.quotient d c ; Q' : S.R = NS.quotient d c' ;
    H : R.R = R.add R.o (R.mul NR.u Q) ; H' : S.R = S.add S.o (S.mul NS.u Q') ;
    Q-map : Id S.R (f.1 Q) Q' = quotient d c c' hc ;
    H-map : Id S.R (f.1 H) H' = plus R.o (R.mul NR.u Q) S.o (S.mul NS.u Q') f.2.1 (times NR.u Q NS.u Q' u-map Q-map) ;
    module HR = PR.PowersOfOne[NR.u,Q,H,refl H] ;
    module HS = PS.PowersOfOne[NS.u,Q',H',refl H'] ;
    power-quotient : (p : Base.Nat) -> Id S.R (f.1 (HR.quotient p)) (HS.quotient p) = split {
      zero -> RH.zero R S f ;
      suc p | r -> plus Q (R.mul H (HR.quotient p)) Q' (S.mul H' (HS.quotient p)) Q-map
        (times H (HR.quotient p) H' (HS.quotient p) H-map r) } ;
    module Bound (p M : Base.Nat) {
      module ER = Expression[R,x,z,v,unit,d,c,p,M] ;
      module ES = Expression[S,x',z',v',unit',d,c',p,M] ;
      b-map : Id S.R (f.1 ER.b) ES.b =
        power (R.neg ER.Qp) (S.neg ES.Qp)
          (trans (RH.negation R S f ER.Qp) (ap S.neg (power-quotient p))) (suc M) ;
      t-map : Id S.R (f.1 ER.t) ES.t = times ER.b (PR.power NR.u M) ES.b (PS.power NS.u M) b-map (power NR.u NS.u u-map M) ;
      section : Id S.R (f.1 ER.section) ES.section = times ER.t v ES.t v' t-map ev ;
    } ;
  } ;
} ;
