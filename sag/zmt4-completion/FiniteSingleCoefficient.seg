-- Insert a single coefficient in a finite family by structural recursion
-- on Fin n. No equality of coefficients or even equality decision on the
-- index is used. Its linear combination is exactly the selected term.
level l ; open Ring[l] ;
module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Over (R : CRing) {
  module S = Comb[l].Sums[R,IP.regular R] ; module L = RL[R] ;
  single : (n : Nat) -> Ps.Fin n -> R.R -> Ps.Fin n -> R.R = split {
    zero -> \ i x j -> absurd R.R i ;
    suc n | r -> split {
      inl i -> \ x -> split { inl j -> r i x j ; inr u -> R.z } ;
      inr u -> \ x -> split { inl j -> R.z ; inr v -> x } } } ;
  equation : (n : Nat) (J : Ps.Fin n -> R.R) (i : Ps.Fin n) (x : R.R) ->
    Id R.R (S.comb n J (single n i x)) (R.mul (J i) x) = split {
    zero -> \ J i x -> absurd (Id R.R (S.comb zero J (single zero i x)) (R.mul (J i) x)) i ;
    suc n | r -> \ J -> split {
      inl i -> \ x -> trans (ap (\ y -> R.add y (S.comb n (\ j -> J (inl j)) (single n i x))) (L.mul-zero (J (inr tt))))
        (trans (L.zl (S.comb n (\ j -> J (inl j)) (single n i x))) (r (\ j -> J (inl j)) i x)) ;
      inr u -> \ x -> trans (ap (R.add (R.mul (J (inr tt)) x))
        (S.comb-vanish n (\ j -> J (inl j)) (\ j -> R.z) (\ j -> refl R.z)))
        (trans (R.addZ (R.mul (J (inr tt)) x))
          (ap (\ v -> R.mul (J (inr v)) x) (CoefficientPolynomial[l].top-eta u))) } } ;
} ;
