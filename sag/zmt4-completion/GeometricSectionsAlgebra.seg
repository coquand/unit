-- Algebra for the finite-fibre sections, before chart representation.
-- For H=1+uQ and L=M+1, put a=sum_{i<L}(-uQ)^i,
-- t=(-Q)^L u^M.  Then 1 = a H + u t, exactly.
-- If G=u^delta H is an error term, multiplication by u^M with
-- M>=delta clears the same error on any overlap.  Pairwise section
-- differences use z-w=z(1-Zw)-w(1-Zz), without idempotence lemmas.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;

module Over (R : CRing) {
  module L = RL[R] ; module PW = AffinePowers[l].Over[R] ;
  module ML = IP.ModL[R,IP.regular R] ;
  sum (x : R.R) : Nat -> R.R = split {
    zero -> R.z ;
    suc n | r -> R.add R.o (R.mul (R.neg x) r) } ;
  geom (x : R.R) : (n : Nat) ->
    Id R.R (R.add (R.mul (sum x n) (R.add R.o x)) (PW.power (R.neg x) n)) R.o = split {
    zero -> trans (ap (\ v -> R.add v R.o) (L.zero-mul (R.add R.o x))) (L.zl R.o) ;
    suc n | r -> calc R.R {
      R.add (R.mul (R.add R.o (R.mul (R.neg x) (sum x n))) (R.add R.o x)) (R.mul (R.neg x) (PW.power (R.neg x) n))
        =< ap (\ v -> R.add v (R.mul (R.neg x) (PW.power (R.neg x) n)))
          (trans (L.dist-left R.o (R.mul (R.neg x) (sum x n)) (R.add R.o x))
            (Ps.cong2 R.R R.add _ _ _ _ (L.one-left (R.add R.o x))
              (sym (R.mulA (R.neg x) (sum x n) (R.add R.o x)))))
        > R.add (R.add (R.add R.o x) (R.mul (R.neg x) (R.mul (sum x n) (R.add R.o x)))) (R.mul (R.neg x) (PW.power (R.neg x) n))
        =< sym (R.addA (R.add R.o x) (R.mul (R.neg x) (R.mul (sum x n) (R.add R.o x))) (R.mul (R.neg x) (PW.power (R.neg x) n)))
        > R.add (R.add R.o x) (R.add (R.mul (R.neg x) (R.mul (sum x n) (R.add R.o x))) (R.mul (R.neg x) (PW.power (R.neg x) n)))
        =< ap (R.add (R.add R.o x)) (sym (R.dist (R.neg x) (R.mul (sum x n) (R.add R.o x)) (PW.power (R.neg x) n)))
        > R.add (R.add R.o x) (R.mul (R.neg x) (R.add (R.mul (sum x n) (R.add R.o x)) (PW.power (R.neg x) n)))
        =< ap (\ v -> R.add (R.add R.o x) (R.mul (R.neg x) v)) r
        > R.add (R.add R.o x) (R.mul (R.neg x) R.o)
        =< ap (R.add (R.add R.o x)) (R.mulO (R.neg x)) > R.add (R.add R.o x) (R.neg x)
        =< L.add-neg-cancel R.o x > R.o } } ;
  module Separator (u Q H : R.R) (hH : Id R.R H (R.add R.o (R.mul u Q))) (M : Nat) {
    bound : Nat = suc M ;
    a : R.R = sum (R.mul u Q) bound ;
    b : R.R = PW.power (R.neg Q) bound ;
    t : R.R = R.mul b (PW.power u M) ;
    remainder : Id R.R (PW.power (R.neg (R.mul u Q)) bound) (R.mul u t) =
      trans (ap (\ x -> PW.power x bound) (sym (L.mul-neg u Q)))
        (trans (PW.power-mul u (R.neg Q) bound)
          (trans (R.mulC (PW.power u bound) b) (sym (L.mul-swap u b (PW.power u M))))) ;
    identity : Id R.R (R.add (R.mul a H) (R.mul u t)) R.o =
      trans (Ps.cong2 R.R R.add _ _ _ _ (ap (R.mul a) hH) (sym remainder)) (geom (R.mul u Q) bound) ;
    error : Id R.R (ML.msub R.o (R.mul u t)) (R.mul a H) =
      trans (ap (\ x -> ML.msub x (R.mul u t)) (sym identity)) (L.add-neg-cancel (R.mul a H) (R.mul u t)) ;
  } ;
  product-error (Z z w : R.R) :
    Id R.R (R.mul z (ML.msub R.o (R.mul Z w))) (ML.msub z (R.mul z (R.mul Z w))) =
      trans (R.dist z R.o (R.neg (R.mul Z w)))
        (Ps.cong2 R.R R.add _ _ _ _ (R.mulO z) (L.mul-neg z (R.mul Z w))) ;
  cross (Z z w : R.R) : Id R.R (R.mul z (R.mul Z w)) (R.mul w (R.mul Z z)) =
    trans (L.mul-swap z Z w) (trans (ap (R.mul Z) (R.mulC z w)) (sym (L.mul-swap w Z z))) ;
  difference (Z z w : R.R) :
    Id R.R (ML.msub z w)
      (ML.msub (R.mul z (ML.msub R.o (R.mul Z w))) (R.mul w (ML.msub R.o (R.mul Z z)))) =
      sym (trans (Ps.cong2 R.R ML.msub _ _ _ _ (product-error Z z w) (product-error Z w z))
        (trans (ap (\ c -> ML.msub (ML.msub z c) (ML.msub w (R.mul w (R.mul Z z)))) (cross Z z w))
          (ML.sub-cancel z w (R.mul w (R.mul Z z))))) ;
  module ModIdeal (J : RegularIdeal[l].IdealPred[R]) {
    module JL = RegularIdeal[l].IdealLaws[R,J] ;
    overlap (Z z w : R.R)
      (hz : J.In (R.mul z (ML.msub R.o (R.mul Z w))))
      (hw : J.In (R.mul w (ML.msub R.o (R.mul Z z)))) : J.In (ML.msub z w) =
      subst J.In (sym (difference Z z w))
        (JL.in-sub (R.mul z (ML.msub R.o (R.mul Z w))) (R.mul w (ML.msub R.o (R.mul Z z))) hz hw) ;
  } ;
} ;
