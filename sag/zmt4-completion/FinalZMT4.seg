-- ZMT for at most three affine generators, over arbitrary bases.
-- The finite-fibre sections, Rees lifts, correction and extraction are
-- all constructed. No UniversalZMT or CFNZMT principle is an input.
-- The only ambient parameters are those already present in All.Theory.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module ZM = ZMT4Certificate[l] ; module RA = ResidualAlgebra[l] ; module CB = CoefficientBase[l] ;
module CD = CFNDescent[l] ;

-- The two earlier interfaces use independently named conversions between
-- the natural-number representations. Identify them explicitly once.
toB-agree : (n : Nat) -> Id Base.Nat (PolynomialRing4Bridge[l].toB n) (CoefficientParts[l].toB n) = split {
  zero -> refl zero ; suc n | r -> ap (\ k -> suc k) r } ;

-- The certificate theorem at residual data over any CFN base.
module Residual (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
  (D0 : RA.Residual[A,setA,ZM.three]) {
  module S = FiniteFibreSections4[l].Over[A,setA,D0] ;
  module T = ZMT4FromSections[l].Over[K0,A,setA,cfnA,D0,S.ST.P,S.ST.e,S.ST.hp,S.ST.deh-P] ;
  wit (n : Nat) : S.CJ1.FC.Wit (suc (CoefficientParts[l].toB n)) (S.w n) =
    subst {Base.Nat} (\ k -> S.CJ1.FC.Wit k (S.w n)) (ap {Base.Nat} {Base.Nat} (\ k -> suc k) (toB-agree n)) (S.wit n) ;
  certificate : Tr.Trunc[T.AX.ZT].carrier =
    T.Sections[S.z,S.w,wit,S.remainder,S.compatibility,S.hz0].certificate ;
} ;

-- These are proofs of the previously explicit principles, not parameters.
universal3 : CD.UniversalZMT ZM.three = \ m D0 ->
  Residual[CB.Codes,CB.ring m,CB.set m,CB.cfn m,D0].certificate ;
two : Nat = suc (suc zero) ;
one : Nat = suc zero ;
universal2 : CD.UniversalZMT two = ResidualPadding[l].lower two universal3 ;
universal1 : CD.UniversalZMT one = ResidualPadding[l].lower one universal2 ;
universal0 : CD.UniversalZMT zero = ResidualPadding[l].lower zero universal1 ;

data Arity = generators0 | generators1 | generators2 | generators3 ;
number : Arity -> Nat = split {
  generators0 -> zero ; generators1 -> one ; generators2 -> two ; generators3 -> ZM.three } ;
principle : (a : Arity) -> CD.UniversalZMT (number a) = split {
  generators0 -> universal0 ; generators1 -> universal1 ;
  generators2 -> universal2 ; generators3 -> universal3 } ;

-- The usual arbitrary-base theorem. FiniteFibreLocalisation provides the
-- actual image subalgebra R[s,sx_i], its finite spanning family and the
-- equivalence induced by inclusion after inverting s.
module Theorem (R : CRing) (setR : Pr.isSet R.R)
  (I : RegularIdeal[l].IdealPred[R]) (propI : (r : R.R) -> Pr.isProp (I.In r))
  (Ea : Algebras[l].Over[R,setR].Algebra) (arity : Arity)
  (x : Ps.Fin (number arity) -> Ea.ring.R)
  (gen : (e : Ea.ring.R) -> Tr.Trunc[(H : Presentations[l].Over[R,setR].Expr (Ps.Fin (number arity))) *
    Id Ea.ring.R (Presentations[l].Over[R,setR].eval (Ps.Fin (number arity)) Ea x H) e].carrier)
  (fo : Tr.Trunc[QuotientFibre[l].Over[R,setR,I,propI,Ea].Finite].carrier) {
  module F = FiniteFibreLocalisation[l].Over[R,setR,I,propI,Ea,number arity,x,gen,fo] ;
  result : Tr.Trunc[F.Conclusion].carrier = F.Theorem[principle arity].result ;
} ;
