-- A coefficient-homogeneous polynomial over D whose evaluation belongs
-- to J belongs to the ideal generated by the fixed bridged kernel list.
-- Exchange the variable blocks, use the constructed elimination ideal,
-- and transport a finite combination through the exchange ring map.
-- No flatness or tensor-product identification is used.
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
  (t : Nat) (a : Ps.Fin t -> A.R) (s : Nat) (p : Ps.Fin s -> TPoly A.R)
  (e : Ps.Fin s -> Base.Nat) (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
  module RX = ReesExchange4[l].Over[A,setA,t,a,s,p,e,hp] ;
  module RC = ReesCorrection4[l].Over[K0,A,setA,cfnA,t,a,s,p,e,hp] ;
  module BG = RX.BG ; module RR = RX.RR ; module RK = RR.RK ; module BD = RX.BD ;
  module HS = CoefficientParts[l].HomSum[RR.R,BD.S,RX.psi] ;
  module List (w : RC.WC.ReesW) (fw : RC.WC.WithGens[w].F.FixedW) {
    module LS = RC.List[w,fw] ; module K = LS.K ;
    gs (j : Ps.Fin K.na) : BD.S.R = BD.phi (LS.gD j) ;
    module FC = ReesComponents4[l].ReesFinComb[BD.S,Ps.Fin K.na,gs] ;
    gen-map (j : Ps.Fin K.na) : Id BD.S.R (RX.psi.1 (K.kg j)) (gs j) =
      sym (RX.biT-psi (K.ix j).2.1 (K.ix j).2.2 (K.kg j) (K.kg-bihom j)) ;
    map-witness (x : RR.R.R) (v : K.FK.CombW x) : FC.CombW (RX.psi.1 x) =
      (v.1, (v.2.1, (\ i -> RX.psi.1 (v.2.2.1 i),
        trans (ap RX.psi.1 v.2.2.2)
          (trans (HS.map-sum v.1 (\ i -> RR.R.mul (v.2.2.1 i) (K.kg (v.2.1 i))))
            (BD.SS.sum-cong v.1
              (\ i -> RX.psi.1 (RR.R.mul (v.2.2.1 i) (K.kg (v.2.1 i))))
              (\ i -> BD.S.mul (RX.psi.1 (v.2.2.1 i)) (gs (v.2.1 i)))
              (\ i -> trans (RX.psi.2.2.2 (v.2.2.1 i) (K.kg (v.2.1 i)))
                (ap (BD.S.mul (RX.psi.1 (v.2.2.1 i))) (gen-map (v.2.1 i))))))))) ;
    map-membership (x : RR.R.R) (hx : K.FK.InComb x) : FC.InComb (RX.psi.1 x) =
      TC.map (K.FK.CombW x) (FC.CombW (RX.psi.1 x)) (map-witness x) hx ;
    -- THEOREM: the missing polynomial kernel-membership bridge.
    membership (n : Base.Nat) (q : TPoly BG.D.R) (hq : BG.BA.CoefHom n q)
      (hj : RK.InJ (RR.BR.phi (BG.EV.evT q))) : FC.InComb (BD.phi q) =
      FC.in-cong (RX.psi.1 (RX.eta.1 (BD.phi q))) (BD.phi q) (RX.psi-eta (BD.phi q))
        (map-membership (RX.eta.1 (BD.phi q))
          (K.kernel-elim (RK.ub (RX.eta.1 (BD.phi q)))
            (RK.elim-of-hom n (RX.eta.1 (BD.phi q)) (RX.eta-phi-hom n q hq)
              (subst RK.InJ (sym (RX.eval-eta-phi q)) hj)))) ;
    -- Collect repetitions in a finite combination into one coefficient
    -- for each member of the fixed list, using the existing ideal API.
    module GI = RegularIdeal[l].Generated[BD.S,K.na,gs] ;
    ideal-sum : (k : Nat) (xs : Ps.Fin k -> BD.S.R) ->
      ((i : Ps.Fin k) -> GI.In (xs i)) -> GI.In (BD.SS.sum k xs) = split {
      zero -> \ xs h -> GI.ideal.in-zero ;
      suc k | r -> \ xs h -> GI.ideal.in-add (xs (inr tt)) (BD.SS.sum k (\ i -> xs (inl i)))
        (h (inr tt)) (r (\ i -> xs (inl i)) (\ i -> h (inl i))) } ;
    ideal-witness (x : BD.S.R) (v : FC.CombW x) : GI.In x =
      subst GI.In (sym v.2.2.2)
        (ideal-sum v.1 (\ i -> BD.S.mul (v.2.2.1 i) (gs (v.2.1 i)))
          (\ i -> GI.ideal.in-mul (v.2.2.1 i) (gs (v.2.1 i)) (GI.generator (v.2.1 i)))) ;
    fixed-membership (n : Base.Nat) (q : TPoly BG.D.R) (hq : BG.BA.CoefHom n q)
      (hj : RK.InJ (RR.BR.phi (BG.EV.evT q))) : GI.In (BD.phi q) =
      TC.rec (FC.CombW (BD.phi q)) @l (GI.In (BD.phi q)) (GI.in-prop (BD.phi q))
        (ideal-witness (BD.phi q)) (membership n q hq hj) ;
  } ;
} ;
