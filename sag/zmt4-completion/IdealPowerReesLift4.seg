-- Explicit Rees lifting of an ideal-power witness on actual chart
-- cochains.  At degree zero lift every coefficient along A -> A[U].
-- At the next degree replace sum a_j x_j by sum U_j lift(x_j).
-- The witness tree gives all choices: the construction is a function,
-- not a sequence of independently truncated representatives.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;

module Over (A : CRing) (setA : Pr.isSet A.R) (t : Nat) (a : Ps.Fin t -> A.R) {
  module DT = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
  D : CRing = DT.D t ;
  setD : Pr.isSet D.R = DT.setD t ;
  G : Graded[A,t,D] = DT.grD t ;
  module GL = Laws[A,t,D,setD,G] ;
  module EV = CoefficientEvaluation4[l].Over[A,setA,t,D,setD,G,a] ;
  module EV0 = CoefficientEvaluation4[l].Over[A,setA,zero,A,setA,CoefficientPolynomial[l].BaseGrading[A,setA].graded,\ j -> absurd A.R j] ;
  module Chart (I : U l) (Bad : I -> E4 -> U l) {
    module EC = EV.EvChart[I,Bad] ;
    module AD = EV0.EvChart[I,Bad].Pointwise[D,setD,G.iota.1,RH.zero A D G.iota] ;
    module CD = EC.CHD ; module CA = EC.CHA ;
    module SD = ShiftedCech4[l].Over[D,setD].ChartSums[I,Bad] ;
    module RS = Comb[l].Sums[D,IP.regular D] ;
    inc (x : CA.El) : CD.El = AD.map x ;
    inc-hom (x : CA.El) : EC.P.Hom zeroZ (inc x) = \ i m -> GL.hom-iota (CA.val x i m) ;
    ev-inc (x : CA.El) : Id CA.El (EC.evc (inc x)) x =
      CA.eq _ _ (\ i m -> G.ev-iota a (CA.val x i m)) ;
    total (ys : Ps.Fin t -> CD.El) : CD.El = SD.S.sum t (\ j -> CD.mod.sm (G.var j) (ys j)) ;
    total-val (ys : Ps.Fin t -> CD.El) (i : I) (m : E4) :
      Id D.R (CD.val (total ys) i m) (RS.sum t (\ j -> D.mul (G.var j) (CD.val (ys j) i m))) =
      SD.val-sum t (\ j -> CD.mod.sm (G.var j) (ys j)) i m ;
    total-hom (k : Base.Nat) (ys : Ps.Fin t -> CD.El) (hy : (j : Ps.Fin t) -> EC.P.Hom (pos k) (ys j)) :
      EC.P.Hom (pos (suc k)) (total ys) = \ i m ->
      subst (GL.Hom (pos (suc k))) (sym (total-val ys i m))
        (GL.hom-sum (pos (suc k)) t (\ j -> D.mul (G.var j) (CD.val (ys j) i m))
          (\ j -> subst (GL.Hom (pos (suc k))) (D.mulC (CD.val (ys j) i m) (G.var j))
            (GL.hom-mul (pos k) (pos (suc zero)) (CD.val (ys j) i m) (G.var j) (hy j i m) (G.var-hom j)))) ;
    ev-total (ys : Ps.Fin t -> CD.El) : Id CA.El (EC.evc (total ys)) (EC.FC.gen (\ j -> EC.evc (ys j))) =
      CA.eq _ _ (\ i m -> trans (ap EV.ev.1 (total-val ys i m))
        (trans (EV.HS.map-sum t (\ j -> D.mul (G.var j) (CD.val (ys j) i m)))
          (trans (EV.RSA.sum-cong t (\ j -> EV.ev.1 (D.mul (G.var j) (CD.val (ys j) i m)))
            (\ j -> A.mul (a j) (EV.ev.1 (CD.val (ys j) i m)))
            (\ j -> trans (EV.ev.2.2.2 (G.var j) (CD.val (ys j) i m))
              (ap (\ v -> A.mul v (EV.ev.1 (CD.val (ys j) i m))) (G.ev-var a j))))
            (sym (EC.gen-val (\ j -> EC.evc (ys j)) i m))))) ;
    Result (k : Base.Nat) (x : CA.El) : U l =
      (c : CD.El) * (EC.P.Hom (pos k) c * Id CA.El (EC.evc c) x) ;
    module Step (k : Base.Nat) (x : CA.El) (w : EC.FC.Wit (suc k) x)
      (r : (j : Ps.Fin t) -> Result k (w.1 j)) {
      cs (j : Ps.Fin t) : CD.El = (r j).1 ;
      hc (j : Ps.Fin t) : EC.P.Hom (pos k) (cs j) = (r j).2.1 ;
      ec (j : Ps.Fin t) : Id CA.El (EC.evc (cs j)) (w.1 j) = (r j).2.2 ;
      result : Result (suc k) x = (total cs, (total-hom k cs hc,
        trans (ev-total cs)
          (trans (EC.SCA.S.sum-cong t (\ j -> CA.mod.sm (a j) (EC.evc (cs j))) (\ j -> CA.mod.sm (a j) (w.1 j))
            (\ j -> ap (CA.mod.sm (a j)) (ec j))) (sym w.2.2)))) ;
    } ;
    lift : (k : Base.Nat) (x : CA.El) -> EC.FC.Wit k x -> Result k x = split {
      zero -> \ x w -> (inc x, (inc-hom x, ev-inc x)) ;
      suc k | r -> \ x w -> Step[k,x,w,\ j -> r (w.1 j) (w.2.1 j)].result } ;
  } ;
} ;
