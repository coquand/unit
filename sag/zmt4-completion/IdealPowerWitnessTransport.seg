-- Transport finite ideal-power witness trees between modules over
-- possibly different rings.  The map only preserves zero/addition and
-- the actions of the specified generators. It need not be linear over
-- the source ring.  This applies to a chart-ring degree projection.
level l ; open Ring[l] ;
module IP = IdealPowers[l] ; module Ps = Presentations[l] ;

module Over (R A : CRing) (M : IP.Mod[R]) (N : IP.Mod[A]) (t : Nat)
  (c : Ps.Fin t -> R.R) (b : Ps.Fin t -> A.R) (f : M.M -> N.M)
  (fzero : Id N.M (f M.mz) N.mz)
  (fadd : (x y : M.M) -> Id N.M (f (M.madd x y)) (N.madd (f x) (f y)))
  (fgen : (j : Ps.Fin t) (x : M.M) -> Id N.M (f (M.sm (c j) x)) (N.sm (b j) (f x))) {
  module FM = FiniteIdealPowers[l].Over[R,M,t,c] ;
  module FN = FiniteIdealPowers[l].Over[A,N,t,b] ;
  module SM = Comb[l].Sums[R,M] ; module SN = Comb[l].Sums[A,N] ;
  module LM = IP.ModL[R,M] ; module LN = IP.ModL[A,N] ;
  map-sum : (k : Nat) (xs : Ps.Fin k -> M.M) ->
    Id N.M (f (SM.sum k xs)) (SN.sum k (\ j -> f (xs j))) = split {
    zero -> \ xs -> fzero ;
    suc k | r -> \ xs -> trans (fadd (xs (inr tt)) (SM.sum k (\ j -> xs (inl j))))
      (ap (N.madd (f (xs (inr tt)))) (r (\ j -> xs (inl j)))) } ;
  map-gen (xs : Ps.Fin t -> M.M) : Id N.M (f (FM.gen xs)) (FN.gen (\ j -> f (xs j))) =
    trans (map-sum t (\ j -> M.sm (c j) (xs j)))
      (SN.sum-cong t (\ j -> f (M.sm (c j) (xs j))) (\ j -> N.sm (b j) (f (xs j))) (\ j -> fgen j (xs j))) ;
  witness : (p : Base.Nat) (x : M.M) -> FM.Wit p x -> FN.Wit p (f x) = split {
    zero -> \ x w -> tt ;
    suc p | r -> \ x w -> (\ j -> f (w.1 j),
      (\ j -> r (w.1 j) (w.2.1 j), trans (ap f w.2.2) (map-gen w.1))) } ;
  map-neg (x : M.M) : Id N.M (f (M.mneg x)) (N.mneg (f x)) =
    LN.G.neg-uniq (f x) (f (M.mneg x))
      (trans (sym (fadd x (M.mneg x))) (trans (ap f (M.maddN x)) fzero)) ;
  map-sub (x y : M.M) : Id N.M (f (LM.msub x y)) (LN.msub (f x) (f y)) =
    trans (fadd x (M.mneg y)) (ap (N.madd (f x)) (map-neg y)) ;
} ;
