-- Regressions for the actual variable exchange, geometric separator and
-- explicit ideal-power lifting.  The polynomial exchange is tested over
-- arbitrary rings, including the nonreduced ring Z/4Z; neither block may
-- be confused with the other.  Empty blocks exercise the base cases.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;

one : Nat = suc zero ;
two : Nat = suc one ;
j0 : Ps.Fin two = inl (inr tt) ;
j1 : Ps.Fin two = inr tt ;
i0 : Ps.Fin one = inr tt ;
module Exchange (A : CRing) (setA : Pr.isSet A.R) {
  module W = TowerExchange[l].Swap[A,setA,one,two] ;
  module F = W.F ;
  module Q = AffinePowers[l].Over[F.L] ;
  module P = AffinePowers[l].Over[F.R] ;
  -- X^2 U_0 + X U_1^3, with both variable blocks present.
  source : F.L.R = F.L.add (F.L.mul (Q.power (F.xL i0) two) (F.uL j0))
    (F.L.mul (F.xL i0) (Q.power (F.uL j1) (suc two))) ;
  target : F.R.R = F.R.add (F.R.mul (P.power (F.xR i0) two) (F.uR j0))
    (F.R.mul (F.xR i0) (P.power (F.uR j1) (suc two))) ;
  image : Id F.R.R (W.forward.1 source) target =
    trans (W.forward.2.2.1 (F.L.mul (Q.power (F.xL i0) two) (F.uL j0))
      (F.L.mul (F.xL i0) (Q.power (F.uL j1) (suc two))))
      (Ps.cong2 F.R.R F.R.add _ _ _ _
        (trans (W.forward.2.2.2 (Q.power (F.xL i0) two) (F.uL j0))
          (Ps.cong2 F.R.R F.R.mul _ _ _ _
            (trans (AffinePowers[l].power-map F.L F.R W.forward (F.xL i0) two)
              (ap (\ x -> P.power x two) (F.on-X i0))) (F.on-U j0)))
        (trans (W.forward.2.2.2 (F.xL i0) (Q.power (F.uL j1) (suc two)))
          (Ps.cong2 F.R.R F.R.mul _ _ _ _ (F.on-X i0)
            (trans (AffinePowers[l].power-map F.L F.R W.forward (F.uL j1) (suc two))
              (ap (\ x -> P.power x (suc two)) (F.on-U j1)))))) ;
  recovered : Id F.L.R (W.backward.1 target) source =
    trans (ap W.backward.1 (sym image)) (W.backward-forward source) ;
  module EmptyLeft = TowerExchange[l].Swap[A,setA,zero,two] ;
  empty-left (x : EmptyLeft.F.L.R) : Id EmptyLeft.F.L.R (EmptyLeft.backward.1 (EmptyLeft.forward.1 x)) x = EmptyLeft.backward-forward x ;
  module EmptyRight = TowerExchange[l].Swap[A,setA,two,zero] ;
  empty-right (x : EmptyRight.F.L.R) : Id EmptyRight.F.L.R (EmptyRight.backward.1 (EmptyRight.forward.1 x)) x = EmptyRight.backward-forward x ;
} ;
module Nonreduced {
  module X = Exchange[ZMod4[l].ring,ZMod4[l].set] ;
  exchange : Id X.F.R.R (X.W.forward.1 X.source) X.target = X.image ;
  module G = GeometricSectionsAlgebra[l].Over[ZMod4[l].ring] ;
  -- u=2, Q=1, H=3, M=1: a=3, b=1, t=2 and aH+ut=1 mod4.
  module SP = G.Separator[q2,q1,q3,refl q3,one] ;
  separator-t : Id ZMod4[l].ring.R SP.t q2 = refl q2 ;
  separator-a : Id ZMod4[l].ring.R SP.a q3 = refl q3 ;
  separator-identity : Id ZMod4[l].ring.R
    (ZMod4[l].ring.add (ZMod4[l].ring.mul SP.a q3) (ZMod4[l].ring.mul q2 SP.t)) q1 = SP.identity ;
  module PA = ResidualPadding[l].Over[ZMod4[l].ring,ZMod4[l].set,one,DescentExamples[l].T2.D] ;
  padding-new-degree : Id Nat (PA.padded.P (inr tt)).deg one = refl one ;
  padding-old-degree : Id Nat (PA.padded.P (inl i0)).deg two = refl two ;
  padding-new-zero : Id PA.E.R (PA.point (inr tt)) PA.E.z = refl PA.E.z ;
  padding-old-generator : Id PA.E.R (PA.TO.phi.1.1 (PA.FP.y (inl i0))) (PA.FD.y i0) = PA.TO.phi-y (inl i0) ;
  padding-new-generator : Id PA.E.R (PA.TO.phi.1.1 (PA.FP.y (inr tt))) PA.E.z = PA.TO.phi-y (inr tt) ;
} ;
