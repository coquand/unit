-- An invertible coordinate allows any section to be written with any
-- prescribed positive coordinate power. This lets the same overlap
-- denominator-clearing lemma handle edges containing the Z chart.
level l ; open Ring[l] ;
module Over (R : CRing) {
  module P = SectionsPowerAlgebra[l].Over[R] ; module L = RL[R] ;
  one-power : (n : Base.Nat) -> Id R.R (P.power R.o n) R.o = split {
    zero -> refl R.o ; suc n | r -> trans (L.one-left (P.power R.o n)) r } ;
  unit-powers (u v : R.R) (h : Id R.R (R.mul u v) R.o) (n : Base.Nat) :
    Id R.R (R.mul (P.power u n) (P.power v n)) R.o =
    trans (sym (P.power-mul u v n)) (trans (ap (\ x -> P.power x n) h) (one-power n)) ;
  factor (z u v : R.R) (h : Id R.R (R.mul u v) R.o) (n : Base.Nat) :
    Id R.R z (R.mul (R.mul z (P.power v n)) (P.power u n)) =
    sym (trans (sym (R.mulA z (P.power v n) (P.power u n)))
      (trans (ap (R.mul z) (unit-powers v u (trans (R.mulC v u) h) n)) (R.mulO z))) ;
} ;
