-- Variable exchange at the exact rings of ReesBridge4.
-- Characterising equations are named once at the boundary between the
-- coefficient towers and PolynomialRing4Bridge's four iterated levels.
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ;

module Over (A : CRing) (setA : Pr.isSet A.R) (t : Nat) (a : Ps.Fin t -> A.R)
  (s : Nat) (p : Ps.Fin s -> TPoly A.R) (e : Ps.Fin s -> Base.Nat)
  (hp : (q : Ps.Fin s) -> HomDeg A.R (e q) (p q)) {
  module BG = ReesBridge4[l].Over[A,setA,t,a,s,p,e,hp] ;
  module RR = BG.RR ; module BR = RR.BR ;
  module DT = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
  module BD = PolynomialRing4Bridge[l].Over[DT.D t,DT.setD t] ;
  module EX = TowerExchange[l].Swap[A,setA,ReesPresentation4[l].four,t] ;
  psi : RH.Hom RR.R BD.S = EX.forward ;
  eta : RH.Hom BD.S RR.R = EX.backward ;
  eta-psi (x : RR.R.R) : Id RR.R.R (eta.1 (psi.1 x)) x = EX.backward-forward x ;
  psi-eta (x : BD.S.R) : Id BD.S.R (psi.1 (eta.1 x)) x = EX.forward-backward x ;
  -- Constants D -> D[X] and S -> S[U] are the existing tower maps.
  GD4 : CoefficientParts[l].Graded[BG.D,ReesPresentation4[l].four,BD.S] = EX.F.TR.grD ReesPresentation4[l].four ;
  iotaD-cst (x : BG.D.R) : Id BD.S.R (GD4.iota.1 x) (BD.cst x) = refl (BD.cst x) ;
  xD0 : Id BD.S.R (GD4.var RR.TL.x0) BD.X0 = refl BD.X0 ;
  xD1 : Id BD.S.R (GD4.var RR.TL.x1) BD.X1 = refl BD.X1 ;
  xD2 : Id BD.S.R (GD4.var RR.TL.x2) BD.X2 = refl BD.X2 ;
  xD3 : Id BD.S.R (GD4.var RR.TL.x3) BD.X3 = refl BD.X3 ;
  coeff : RH.Hom BG.D RR.R = EX.B.baseMap ;
  eta-cst (x : BG.D.R) : Id RR.R.R (eta.1 (BD.cst x)) (coeff.1 x) =
    trans (ap eta.1 (sym (iotaD-cst x))) (EX.B.on-base x) ;
  eta-X0 : Id RR.R.R (eta.1 BD.X0) (RR.GU.iota.1 BR.X0) =
    trans (ap eta.1 (sym xD0)) (trans (EX.B.on-U RR.TL.x0) (ap RR.GU.iota.1 RR.var-x0)) ;
  eta-X1 : Id RR.R.R (eta.1 BD.X1) (RR.GU.iota.1 BR.X1) =
    trans (ap eta.1 (sym xD1)) (trans (EX.B.on-U RR.TL.x1) (ap RR.GU.iota.1 RR.var-x1)) ;
  eta-X2 : Id RR.R.R (eta.1 BD.X2) (RR.GU.iota.1 BR.X2) =
    trans (ap eta.1 (sym xD2)) (trans (EX.B.on-U RR.TL.x2) (ap RR.GU.iota.1 RR.var-x2)) ;
  eta-X3 : Id RR.R.R (eta.1 BD.X3) (RR.GU.iota.1 BR.X3) =
    trans (ap eta.1 (sym xD3)) (trans (EX.B.on-U RR.TL.x3) (ap RR.GU.iota.1 RR.var-x3)) ;
  coeff-A (x : A.R) : Id RR.R.R (coeff.1 (BG.GD.iota.1 x)) (RR.GU.iota.1 (BR.cst x)) =
    trans (EX.B.EX.base t EX.B.aR EX.B.xR x) (ap RR.GU.iota.1 (RR.iota-cst x)) ;
  coeff-U (j : Ps.Fin t) : Id RR.R.R (coeff.1 (BG.GD.var j)) (RR.GU.var j) =
    EX.B.EX.variable t EX.B.aR EX.B.xR j ;

  -- The inclusion S -> D[X] is coefficient extension on term lists.
  incS : RH.Hom BR.S BD.S = RH.compose BR.S RR.R BD.S psi RR.GU.iota ;
  inc-cst (x : A.R) : Id BD.S.R (incS.1 (BR.cst x)) (BD.cst (BG.GD.iota.1 x)) =
    trans (ap (\ y -> psi.1 (RR.GU.iota.1 y)) (sym (RR.iota-cst x)))
      (trans (EX.F.on-A x) (iotaD-cst (BG.GD.iota.1 x))) ;
  inc-X0 : Id BD.S.R (incS.1 BR.X0) BD.X0 =
    trans (ap (\ y -> psi.1 (RR.GU.iota.1 y)) (sym RR.var-x0)) (trans (EX.F.on-X RR.TL.x0) xD0) ;
  inc-X1 : Id BD.S.R (incS.1 BR.X1) BD.X1 =
    trans (ap (\ y -> psi.1 (RR.GU.iota.1 y)) (sym RR.var-x1)) (trans (EX.F.on-X RR.TL.x1) xD1) ;
  inc-X2 : Id BD.S.R (incS.1 BR.X2) BD.X2 =
    trans (ap (\ y -> psi.1 (RR.GU.iota.1 y)) (sym RR.var-x2)) (trans (EX.F.on-X RR.TL.x2) xD2) ;
  inc-X3 : Id BD.S.R (incS.1 BR.X3) BD.X3 =
    trans (ap (\ y -> psi.1 (RR.GU.iota.1 y)) (sym RR.var-x3)) (trans (EX.F.on-X RR.TL.x3) xD3) ;
  module PN = PolynomialFourNaturality[l].Over[A,DT.D t,setA,DT.setD t,BG.GD.iota] ;
  module NI = PN.Given[incS,inc-cst,inc-X0,inc-X1,inc-X2,inc-X3] ;
  liftC-map : (q : TPoly A.R) -> Id (TPoly BG.D.R) (PN.mapT q) (BG.liftC q) = split {
    nil -> refl nil ; cons u q | r -> ap (\ qs -> cons (BG.GD.iota.1 u.1,u.2) qs) r } ;
  inc-phi (q : TPoly A.R) : Id BD.S.R (incS.1 (BR.phi q)) (BD.phi (BG.liftC q)) =
    trans (NI.phi q) (ap BD.phi (liftC-map q)) ;

  -- The canonical bihomogeneous list of the earlier bridge maps back to
  -- the original element, not just to an element with equal evaluation.
  module HS = CoefficientParts[l].HomSum[RR.R,BD.S,psi] ;
  psi-U (j : Ps.Fin t) : Id BD.S.R (psi.1 (RR.GU.var j)) (BD.cst (BG.GD.var j)) =
    trans (EX.F.on-U j) (iotaD-cst (BG.GD.var j)) ;
  expr-bridge (d : Base.Nat) : (n : Base.Nat) (x : RR.RC.GL.Expr n)
    (hx : RR.RC.AllE n (RR.GXL.Hom (pos d)) x) ->
    Id BD.S.R (psi.1 (RR.RC.GL.value n x)) (BD.phi (BG.tlU d n x hx)) = split {
    zero -> \ x hx -> trans (ap incS.1 (sym (BG.phi-tlX d x hx))) (inc-phi (BG.tlX d x hx)) ;
    suc n | r -> \ x hx -> trans (HS.map-sum t (\ j -> RR.R.mul (RR.GU.var j) (RR.RC.GL.value n (x j))))
      (trans (BD.SS.sum-cong t
        (\ j -> psi.1 (RR.R.mul (RR.GU.var j) (RR.RC.GL.value n (x j))))
        (\ j -> BD.phi (BG.PAD.scaleT (BG.GD.var j,BR.zeroN) (BG.tlU d n (x j) (hx j))))
        (\ j -> trans (psi.2.2.2 (RR.GU.var j) (RR.RC.GL.value n (x j)))
          (trans (Presentations[l].cong2 BD.S.R BD.S.mul _ _ _ _ (psi-U j) (r (x j) (hx j)))
            (sym (BD.phi-scale (BG.GD.var j) (BG.tlU d n (x j) (hx j)))))))
        (sym (BD.phi-psum t (\ j -> BG.PAD.scaleT (BG.GD.var j,BR.zeroN) (BG.tlU d n (x j) (hx j)))))) } ;
  biT-psi (n : Nat) (d : Base.Nat) (y : RR.R.R) (hy : RR.RC.BiHom n d y) :
    Id BD.S.R (BD.phi (BG.biT n d y hy)) (psi.1 y) =
    trans (sym (expr-bridge d (CoefficientParts[l].toB n) hy.1 hy.2.1)) (ap psi.1 hy.2.2) ;
  eta-biT (n : Nat) (d : Base.Nat) (y : RR.R.R) (hy : RR.RC.BiHom n d y) :
    Id RR.R.R (eta.1 (BD.phi (BG.biT n d y hy))) y =
    trans (ap eta.1 (biT-psi n d y hy)) (eta-psi y) ;

  -- Evaluation commutes with exchanging the variable blocks.  Compare
  -- the two coefficient maps by the tower universal property, then use
  -- four-variable naturality on the entire term list.
  module RG = RR.RK.RG ;
  evCoeff : RH.Hom BG.D BR.S = RH.compose BG.D RR.R BR.S RG.EV.ev coeff ;
  baseEv : RH.Hom BG.D BR.S = RH.compose BG.D A BR.S RR.GX.iota BG.EV.ev ;
  evCoeff-A (x : A.R) : Id BR.S.R (evCoeff.1 (BG.GD.iota.1 x)) (baseEv.1 (BG.GD.iota.1 x)) =
    trans (ap RG.ev (coeff-A x))
      (trans (RR.GU.ev-iota RR.b (BR.cst x))
        (sym (trans (ap RR.GX.iota.1 (BG.GD.ev-iota a x)) (RR.iota-cst x)))) ;
  evCoeff-U (j : Ps.Fin t) : Id BR.S.R (evCoeff.1 (BG.GD.var j)) (baseEv.1 (BG.GD.var j)) =
    trans (ap RG.ev (coeff-U j))
      (trans (RR.GU.ev-var RR.b j) (sym (ap RR.GX.iota.1 (BG.GD.ev-var a j)))) ;
  evCoeff-path : Id (RH.Hom BG.D BR.S) evCoeff baseEv =
    TowerUniversal[l].Over[A,BR.S,setA,BR.setS].ext t evCoeff baseEv evCoeff-A evCoeff-U ;
  evCoeff-at (x : BG.D.R) : Id BR.S.R (RG.ev (coeff.1 x)) (RR.GX.iota.1 (BG.EV.ev.1 x)) =
    ap (\ h -> h.1 x) evCoeff-path ;
  evalEta : RH.Hom BD.S BR.S = RH.compose BD.S RR.R BR.S RG.EV.ev eta ;
  evalEta-cst (x : BG.D.R) : Id BR.S.R (evalEta.1 (BD.cst x)) (BR.cst (BG.EV.ev.1 x)) =
    trans (ap RG.ev (eta-cst x)) (trans (evCoeff-at x) (RR.iota-cst (BG.EV.ev.1 x))) ;
  evalEta-X0 : Id BR.S.R (evalEta.1 BD.X0) BR.X0 = trans (ap RG.ev eta-X0) (RR.GU.ev-iota RR.b BR.X0) ;
  evalEta-X1 : Id BR.S.R (evalEta.1 BD.X1) BR.X1 = trans (ap RG.ev eta-X1) (RR.GU.ev-iota RR.b BR.X1) ;
  evalEta-X2 : Id BR.S.R (evalEta.1 BD.X2) BR.X2 = trans (ap RG.ev eta-X2) (RR.GU.ev-iota RR.b BR.X2) ;
  evalEta-X3 : Id BR.S.R (evalEta.1 BD.X3) BR.X3 = trans (ap RG.ev eta-X3) (RR.GU.ev-iota RR.b BR.X3) ;
  module EN = PolynomialFourNaturality[l].Over[DT.D t,A,DT.setD t,setA,BG.EV.ev] ;
  module EI = EN.Given[evalEta,evalEta-cst,evalEta-X0,evalEta-X1,evalEta-X2,evalEta-X3] ;
  evT-map : (q : TPoly BG.D.R) -> Id (TPoly A.R) (EN.mapT q) (BG.EV.evT q) = split {
    nil -> refl nil ; cons u q | r -> ap (\ qs -> cons (BG.EV.ev.1 u.1,u.2) qs) r } ;
  eval-eta-phi (q : TPoly BG.D.R) : Id BR.S.R (RG.ev (eta.1 (BD.phi q))) (BR.phi (BG.EV.evT q)) =
    trans (EI.phi q) (ap BR.phi (evT-map q)) ;

  -- A coefficient-homogeneous list has a preimage of that same U-degree.
  module GL = RR.RC.GL ;
  coeff-base-hom (x : A.R) : GL.Hom zeroZ (coeff.1 (BG.GD.iota.1 x)) =
    subst (GL.Hom zeroZ) (sym (coeff-A x)) (GL.hom-iota (BR.cst x)) ;
  coeff-var-hom (j : Ps.Fin t) : GL.Hom (pos (suc zero)) (coeff.1 (BG.GD.var j)) =
    subst (GL.Hom (pos (suc zero))) (sym (coeff-U j)) (RR.GU.var-hom j) ;
  module GH = GradedHomogeneousMap[l].Over[A,BR.S,t,BG.D,RR.R,BG.setD,RR.setR,BG.GD,t,RR.GU,coeff,coeff-base-hom,coeff-var-hom] ;
  coeff-hom (n : Base.Nat) (x : BG.D.R) (hx : BG.GDL.Hom (pos n) x) : GL.Hom (pos n) (coeff.1 x) = GH.homogeneous n x hx ;
  eta-cst-hom (n : Base.Nat) (x : BG.D.R) (hx : BG.GDL.Hom (pos n) x) : GL.Hom (pos n) (eta.1 (BD.cst x)) =
    subst (GL.Hom (pos n)) (sym (eta-cst x)) (coeff-hom n x hx) ;
  eta-zero-times (k : Int) (x y : BD.S.R) (hx : GL.Hom k (eta.1 x)) (hy : GL.Hom zeroZ (eta.1 y)) :
    GL.Hom k (eta.1 (BD.S.mul x y)) =
    subst (GL.Hom k) (sym (eta.2.2.2 x y)) (GL.hom-mul k zeroZ (eta.1 x) (eta.1 y) hx hy) ;
  eta-pw-zero (x : BD.S.R) (hx : GL.Hom zeroZ (eta.1 x)) :
    (n : Base.Nat) -> GL.Hom zeroZ (eta.1 (BD.pw x n)) = split {
    zero -> subst (GL.Hom zeroZ) (sym eta.2.1) GL.hom-one ;
    suc n | r -> eta-zero-times zeroZ (BD.pw x n) x r hx } ;
  eta-hom-X0 : GL.Hom zeroZ (eta.1 BD.X0) = subst (GL.Hom zeroZ) (sym eta-X0) (GL.hom-iota BR.X0) ;
  eta-hom-X1 : GL.Hom zeroZ (eta.1 BD.X1) = subst (GL.Hom zeroZ) (sym eta-X1) (GL.hom-iota BR.X1) ;
  eta-hom-X2 : GL.Hom zeroZ (eta.1 BD.X2) = subst (GL.Hom zeroZ) (sym eta-X2) (GL.hom-iota BR.X2) ;
  eta-hom-X3 : GL.Hom zeroZ (eta.1 BD.X3) = subst (GL.Hom zeroZ) (sym eta-X3) (GL.hom-iota BR.X3) ;
  eta-term-hom (n : Base.Nat) (c : BG.D.R) (hc : BG.GDL.Hom (pos n) c) :
    (u : N4) -> GL.Hom (pos n) (eta.1 (BD.term c u)) = split {
    nx a0 a1 a2 a3 -> eta-zero-times (pos n) (BD.cst c)
      (BD.S.mul (BD.pw BD.X0 a0) (BD.S.mul (BD.pw BD.X1 a1) (BD.S.mul (BD.pw BD.X2 a2) (BD.pw BD.X3 a3))))
      (eta-cst-hom n c hc)
      (eta-zero-times zeroZ (BD.pw BD.X0 a0) (BD.S.mul (BD.pw BD.X1 a1) (BD.S.mul (BD.pw BD.X2 a2) (BD.pw BD.X3 a3)))
        (eta-pw-zero BD.X0 eta-hom-X0 a0)
        (eta-zero-times zeroZ (BD.pw BD.X1 a1) (BD.S.mul (BD.pw BD.X2 a2) (BD.pw BD.X3 a3))
          (eta-pw-zero BD.X1 eta-hom-X1 a1)
          (eta-zero-times zeroZ (BD.pw BD.X2 a2) (BD.pw BD.X3 a3)
            (eta-pw-zero BD.X2 eta-hom-X2 a2) (eta-pw-zero BD.X3 eta-hom-X3 a3)))) } ;
  eta-phi-hom (n : Base.Nat) : (q : TPoly BG.D.R) -> BG.BA.CoefHom n q -> GL.Hom (pos n) (eta.1 (BD.phi q)) = split {
    nil -> \ h -> subst (GL.Hom (pos n)) (sym (RH.zero BD.S RR.R eta)) (GL.hom-zero (pos n)) ;
    cons u q | r -> \ h -> subst (GL.Hom (pos n)) (sym (eta.2.2.1 (BD.term u.1 u.2) (BD.phi q)))
      (GL.hom-add (pos n) (eta.1 (BD.term u.1 u.2)) (eta.1 (BD.phi q)) (eta-term-hom n u.1 h.1 u.2) (r h.2)) } ;
} ;
