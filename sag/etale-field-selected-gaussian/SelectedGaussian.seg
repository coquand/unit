-- Gaussian elimination at one decidable prime of a regular ring.
-- Work over A/q, lift finite matrices, and kill their finite errors by
-- one idempotent outside q. No global quasifree decomposition is built.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (q : PrimeIdempotents[l].Over[A].Prime)
 (regular : (a : A.R) -> Tr.Trunc[(b : A.R) * Id A.R a (A.mul (A.mul a a) b)].carrier) {
 module V = GaussianVectors[l].Over[A] ; module G = GaussianLinear[l].Over[A] ;
 record NormalForm (n m : Nat) (v : Fin m -> V.Vec n) {
  e : A.R ;
  idempotent : Id A.R (A.mul e e) e ;
  outside : Not (q.ideal.In e) ;
  rank : Nat ;
  project : V.Linear[n,rank] ;
  section : V.Linear[rank,n] ;
  coefficients : V.Linear[n,m] ;
  retract (x : V.Vec rank) (i : Fin rank) :
   Id A.R (A.mul e (A.add (project.map (section.map x) i) (A.neg (x i)))) A.z ;
  kills (j : Fin m) (i : Fin rank) : Id A.R (A.mul e (project.map (v j) i)) A.z ;
  difference (x : V.Vec n) (i : Fin n) :
   Id A.R (A.mul e (A.add (V.comb n m v (coefficients.map x) i)
    (A.neg (A.add (x i) (A.neg (section.map (project.map x) i)))))) A.z ;
 } ;
} ;
