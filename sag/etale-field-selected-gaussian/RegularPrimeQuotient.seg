-- A regular ring modulo a specified decidable prime is a discrete field.
-- Regular witnesses are eliminated only into proposition-valued unit data.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (q : PrimeIdempotents[l].Over[A].Prime)
 (regular : (a : A.R) -> Truncation[l].Trunc[(b : A.R) * Id A.R a (A.mul (A.mul a a) b)].carrier) {
 module Q = QuotientRing[l].Over[A,q.ideal,q.proposition] ;
 module PI = PrimeIdempotents[l].Over[A] ; module PQ = PI.At[q] ;
 module L = RL[Q.ring] ; module Units = FormallyEtale[l].Units[Q.ring,Q.set] ;
 nonzero : Not (Id Q.Carrier Q.oneQ Q.zeroQ) = \ eq -> q.proper (Q.kernel A.o eq) ;
 Decision (x : Q.Carrier) : U l = Plus (Id Q.Carrier x Q.zeroQ) (L.unit x) ;
 incompatible (x : Q.Carrier) (zero : Id Q.Carrier x Q.zeroQ) (u : L.unit x) : Empty =
  nonzero (trans (sym u.2) (trans (ap (\ y -> Q.ring.mul y u.1) zero) (L.zero-mul u.1))) ;
 decision-prop (x : Q.Carrier) : Pr.isProp (Decision x) = split {
  inl p -> split { inl r -> ap (\ h -> inl h) (Q.set x Q.zeroQ p r) ; inr u -> efq (incompatible x p u) } ;
  inr u -> split { inl p -> efq (incompatible x p u) ; inr v -> ap (\ w -> inr w) (Units.unit-prop x u v) } } ;
 module Inverse (a : A.R) (out : Not (q.ideal.In a))
  (b : A.R) (eq : Id A.R a (A.mul (A.mul a a) b)) {
  module Rg = PI.Regular[a,b,eq] ;
  e-out : Not (q.ideal.In Rg.e) = \ h -> out
   (subst q.ideal.In Rg.absorb (q.ideal.in-mul a Rg.e h)) ;
  complement-zero : Id Q.Carrier (Q.include (PI.complement Rg.e)) Q.zeroQ =
   Q.to-zero _ (PQ.complement-in Rg.e Rg.idempotent e-out) ;
  -- Use the complementary idempotent's sum with e to identify [e] with 1.
  equal-one : Id Q.Carrier (Q.include Rg.e) Q.oneQ =
   trans (sym (Q.ring.addZ (Q.include Rg.e)))
    (trans (ap (Q.ring.add (Q.include Rg.e)) (sym complement-zero))
     (trans (sym (Q.projection.2.2.1 Rg.e (PI.complement Rg.e)))
      (ap Q.include (PI.complement-sum Rg.e)))) ;
  result : L.unit (Q.include a) =
   (Q.include b,trans (sym (Q.projection.2.2.2 a b)) equal-one) ;
 } ;
 inverse (a : A.R) (out : Not (q.ideal.In a)) : L.unit (Q.include a) =
  TC.rec ((b : A.R) * Id A.R a (A.mul (A.mul a a) b)) @l (L.unit (Q.include a))
   (Units.unit-prop _) (\ w -> Inverse[a,out,w.1,w.2].result) (regular a) ;
 from-prime (a : A.R) : Plus (q.ideal.In a) (Not (q.ideal.In a)) -> Decision (Q.include a) = split {
  inl h -> inl (Q.to-zero a h) ; inr h -> inr (inverse a h) } ;
 decide : (x : Q.Carrier) -> Decision x =
  Q.Q.induction @l Decision decision-prop (\ a -> from-prime a (q.decide a)) ;
} ;
