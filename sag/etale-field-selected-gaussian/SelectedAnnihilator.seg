-- A finite family in the selected prime is killed by one idempotent
-- outside that prime. Only finitely many regular witnesses are used.
level l ; open Ring[l] ; open Presentations[l] ;
module TC = TruncationCombinators[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (q : PrimeIdempotents[l].Over[A].Prime)
 (regular : (a : A.R) -> Tr.Trunc[(b : A.R) * Id A.R a (A.mul (A.mul a a) b)].carrier) {
 module PI = PrimeIdempotents[l].Over[A] ; module PQ = PI.At[q] ; module L = RL[A] ;
 record Cut (n : Nat) (x : Fin n -> A.R) {
  e : A.R ;
  idempotent : Id A.R (A.mul e e) e ;
  outside : Not (q.ideal.In e) ;
  kills (i : Fin n) : Id A.R (A.mul e (x i)) A.z ;
 } ;
 empty (x : Fin zero -> A.R) : Cut[zero,x] = new Cut[zero,x,A.o,A.mulO A.o,q.proper,\ i -> efq i] ;
 product-out-case (a b : A.R) (ha : Not (q.ideal.In a)) (hb : Not (q.ideal.In b)) :
  Plus (q.ideal.In a) (q.ideal.In b) -> Empty = split { inl h -> ha h ; inr h -> hb h } ;
 product-out (a b : A.R) (ha : Not (q.ideal.In a)) (hb : Not (q.ideal.In b)) : Not (q.ideal.In (A.mul a b)) =
  \ h -> product-out-case a b ha hb (q.prime a b h) ;
 module Step (n : Nat) (x : Fin (suc n) -> A.R) (hx : q.ideal.In (x (inr tt)))
  (previous : Cut[n,\ i -> x (inl i)]) (b : A.R)
  (eq : Id A.R (x (inr tt)) (A.mul (A.mul (x (inr tt)) (x (inr tt))) b)) {
  module Reg = PI.Regular[x (inr tt),b,eq] ;
  inside : q.ideal.In Reg.e = subst q.ideal.In (A.mulC b (x (inr tt))) (q.ideal.in-mul b (x (inr tt)) hx) ;
  e : A.R = A.mul previous.e Reg.annihilator ;
  lower (i : Fin n) : Id A.R (A.mul e (x (inl i))) A.z =
   trans (sym (A.mulA previous.e Reg.annihilator (x (inl i))))
    (trans (L.mul-swap previous.e Reg.annihilator (x (inl i)))
     (trans (ap (A.mul Reg.annihilator) (previous.kills i)) (L.mul-zero Reg.annihilator))) ;
  last : Id A.R (A.mul e (x (inr tt))) A.z =
   trans (sym (A.mulA previous.e Reg.annihilator (x (inr tt))))
    (trans (ap (A.mul previous.e) Reg.kills) (L.mul-zero previous.e)) ;
  result : Cut[suc n,x] = new Cut[suc n,x,e,
   PI.product-idempotent previous.e Reg.annihilator previous.idempotent Reg.annihilator-idempotent,
   product-out previous.e Reg.annihilator previous.outside (PQ.outside-complement Reg.e inside),
   AffineFinite[l].section n (\ i -> Id A.R (A.mul e (x i)) A.z) lower last] ;
 } ;
 next (n : Nat) (x : Fin (suc n) -> A.R) (hx : q.ideal.In (x (inr tt)))
  (previous : Cut[n,\ i -> x (inl i)]) : Tr.Trunc[Cut[suc n,x]].carrier =
  TC.map ((b : A.R) * Id A.R (x (inr tt)) (A.mul (A.mul (x (inr tt)) (x (inr tt))) b)) (Cut[suc n,x])
   (\ w -> Step[n,x,hx,previous,w.1,w.2].result) (regular (x (inr tt))) ;
 theorem : (n : Nat) (x : Fin n -> A.R) -> ((i : Fin n) -> q.ideal.In (x i)) -> Tr.Trunc[Cut[n,x]].carrier = split {
  zero -> \ x hx -> Tr.Trunc[Cut[zero,x]].inc (empty x) ;
  suc n | ih -> \ x hx -> TC.bind (Cut[n,\ i -> x (inl i)]) (Cut[suc n,x])
   (next n x (hx (inr tt))) (ih (\ i -> x (inl i)) (\ i -> hx (inl i))) } ;
} ;
