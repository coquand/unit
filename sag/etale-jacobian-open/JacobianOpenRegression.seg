-- Actual base, redundant-presentation and zero-localisation instances.
level l ; open Ring[l] ;
module Big = Truncation[l+] ; module Tr = Truncation[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module BaseInput (R : CRing) (setR : Pr.isSet R.R) (a : R.R) {
 module B = DirectRegression[l].Empty[R,setR] ;
 module Red = DirectRegression[l].Point[R,setR,a] ;
 module J = JacobianOpenReduction[l].Over[R,setR].At[B.C.base] ;
 empty-presentation : Big.Trunc[J.Result].carrier = J.etale B.theorem ;
 redundant-presentation : Big.Trunc[J.Result].carrier = J.etale Red.redundant-theorem ;
 module Quot = SmoothQuotientOpen[l].Over[R,setR].At[B.C.base,B.C.base,B.C.identity B.C.base,
  \ r -> Tr.Trunc[(s : R.R) * Id R.R s r].inc (r,refl r)] ;
 identity : Big.Trunc[Quot.Result].carrier = Quot.theorem
  (Big.Trunc[B.P.Witness B.C.base].inc B.presentation)
  (Big.Trunc[B.P.Witness B.C.base].inc B.presentation) B.unique B.theorem.1.1 ;
} ;
module Nonreduced {
 module Z = ZMod4[l] ;
 module B = BaseInput[Z.ring,Z.set,q2] ;
 empty : Big.Trunc[B.J.Result].carrier = B.empty-presentation ;
 redundant : Big.Trunc[B.J.Result].carrier = B.redundant-presentation ;
 module N = DirectRegression[l].NilpotentLocalisation ;
 module J = JacobianOpenReduction[l].Over[Z.ring,Z.set].At[N.L.algebra] ;
 zero-localisation : Big.Trunc[J.Result].carrier = J.etale N.theorem ;
 -- The actual quotient map R -> R[1/2] is surjective with kernel 1.
 -- This exercises a nonzero kernel in SmoothQuotientOpen.
 E : N.C.Algebra = N.L.algebra ;
 u : N.C.Hom N.C.base E = N.L.inclusion ;
 module Un = FormallyEtale[l].Units[E.ring,E.set] ;
 x : E.ring.R = u.1.1 q2 ;
 square-zero : Id E.ring.R (E.ring.mul x x) E.ring.z =
  trans (sym (u.1.2.2.2 q2 q2)) (H.zero Z.ring E.ring u.1) ;
 square-unit : RL[E.ring].unit (E.ring.mul x x) = Un.unit-mul x x N.L.inverse N.L.inverse ;
 one-zero : Id E.ring.R E.ring.o E.ring.z =
  trans (sym square-unit.2)
   (trans (ap (\ a -> E.ring.mul a square-unit.1) square-zero) (RL[E.ring].zero-mul square-unit.1)) ;
 vanishes (e : E.ring.R) : Id E.ring.R e E.ring.z =
  trans (sym (E.ring.mulO e)) (trans (ap (E.ring.mul e) one-zero) (RL[E.ring].mul-zero e)) ;
 onto (e : E.ring.R) : Tr.Trunc[(r : Z.ring.R) * Id E.ring.R (u.1.1 r) e].carrier =
  Tr.Trunc[(r : Z.ring.R) * Id E.ring.R (u.1.1 r) e].inc
   (q0,trans (H.zero Z.ring E.ring u.1) (sym (vanishes e))) ;
 kernel-one : Id E.ring.R (u.1.1 q1) E.ring.z = trans u.1.2.1 one-zero ;
 module Q = SmoothQuotientOpen[l].Over[Z.ring,Z.set].At[N.C.base,E,u,onto] ;
 quotient-open : Big.Trunc[Q.Result].carrier = Q.theorem
  (Big.Trunc[N.P.Witness N.C.base].inc N.B.presentation)
  N.L.fp N.B.unique N.theorem.1.1 ;
} ;
