-- A smooth fp quotient of an unramified fp algebra is an idempotent
-- principal localisation. Finite kernel and idempotent are constructed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module Big = Truncation[l+] ;
module TC = TruncationCombinators[l] ; module BTC = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module FE = FormallyEtale[l].Over[R,setR] ; module I = AffineInterface[l].Over[R,setR] ;
 module At (S T : C.Algebra) (u : C.Hom S T)
  (surj : (t : T.ring.R) -> Tr.Trunc[(s : S.ring.R) * Id T.ring.R (u.1.1 s) t].carrier) {
  module Su = EtaleCase[l].Over[R,setR].Surjection[S,T,u,surj] ;
  Result : U l+ = (f : S.ring.R) * Id S.ring.R (S.ring.mul f f) f *
   Id T.ring.R (u.1.1 f) T.ring.o * I.Localizes S T f u ;
  module Presented (ps pt : P.Presentation) (sp : P.Presents ps S) (tp : P.Presents pt T) {
   module K = FiniteSurjectionKernel[l].Over[R,setR].At[S,T,ps,pt,sp,tp,u] ;
   module Finite (k : K.Certificate) {
    module E = EtaleCase[l].Over[R,setR].Section2[S,T,u,surj,k.number,k.generator,k.killed,k.generates] ;
    module Chosen (cert : (j : Fin k.number) -> E.Certificate (k.generator j)) {
     module II = E.Idem[cert].II ;
     f : S.ring.R = II.f ;
     image-one : Id T.ring.R (u.1.1 f) T.ring.o =
      sym (FormallyEtale[l].Units[T.ring,T.set].sub-zero T.ring.o (u.1.1 f)
       (trans (sym (trans (u.1.2.2.1 S.ring.o (S.ring.neg f))
        (cong2 T.ring.R T.ring.add _ _ _ _ u.1.2.1 (H.negation S.ring T.ring u.1 f))))
        II.one-minus)) ;
     image-unit : RL[T.ring].unit (u.1.1 f) =
      subst (RL[T.ring].unit) (sym image-one) FormallyEtale[l].Units[T.ring,T.set].unit-one ;
     module To (B : C.Algebra) {
      module Un = FormallyEtale[l].Units[B.ring,B.set] ;
      module Kills (h : C.Hom S B) (unit : RL[B.ring].unit (h.1.1 f)) {
       one : Id B.ring.R (h.1.1 f) B.ring.o =
        Un.idempotent-one (h.1.1 f) (trans (sym (h.1.2.2.2 f f)) (ap h.1.1 II.idempotent)) unit ;
       complement-zero : Id B.ring.R (h.1.1 (S.ring.add S.ring.o (S.ring.neg f))) B.ring.z =
        trans (h.1.2.2.1 S.ring.o (S.ring.neg f))
         (trans (cong2 B.ring.R B.ring.add _ _ _ _ h.1.2.1
          (trans (H.negation S.ring B.ring h.1 f) (ap B.ring.neg one))) (B.ring.addN B.ring.o)) ;
       kills (x : S.ring.R) (hx : Su.Kernel x) : Id B.ring.R (h.1.1 x) B.ring.z =
        trans (ap h.1.1 (sym (II.generated x hx)))
         (trans (h.1.2.2.2 (S.ring.add S.ring.o (S.ring.neg f)) x)
          (trans (ap (\ t -> B.ring.mul t (h.1.1 x)) complement-zero) (RL[B.ring].zero-mul (h.1.1 x)))) ;
      } ;
      module Factor (d : I.LocalData S B f) {
       module F = Su.Factor[B,d.1,Kills[d.1,d.2].kills] ;
      } ;
      backward (d : I.LocalData S B f) : C.Hom T B = Factor[d].F.hom ;
      forward (h : C.Hom T B) : I.LocalData S B f = I.local-map S T B f u image-unit h ;
      fb (d : I.LocalData S B f) : Id (I.LocalData S B f) (forward (backward d)) d =
       Pr.Sigma-eq (C.Hom S B) (\ h -> RL[B.ring].unit (h.1.1 f)) _ _ _ _
        (C.ext S B (forward (backward d)).1 d.1 (Factor[d].F.beta)) (Un.unit-prop (d.1.1.1 f)) ;
      bf (h : C.Hom T B) : Id (C.Hom T B) (backward (forward h)) h =
       Su.unique B (backward (forward h)) h (Factor[forward h].F.beta) ;
      universal : Pr.isEquiv (C.Hom T B) (I.LocalData S B f) forward =
       Pr.qinv (C.Hom T B) (I.LocalData S B f) forward backward fb bf ;
     } ;
     result : Result = (f,II.idempotent,image-one,image-unit,\ B -> To[B].universal) ;
    } ;
    result (unique : FE.Unique S) (smooth : FE.Lift T) : Big.Trunc[Result].carrier =
     TC.rec ((j : Fin k.number) -> E.Certificate (k.generator j)) @l+
      Big.Trunc[Result].carrier Big.Trunc[Result].proposition
      (\ cert -> Big.Trunc[Result].inc Chosen[cert].result) E.Square[unique,smooth].certificates ;
   } ;
   result (unique : FE.Unique S) (smooth : FE.Lift T) : Big.Trunc[Result].carrier =
    TC.rec K.Certificate @l+ Big.Trunc[Result].carrier Big.Trunc[Result].proposition
     (\ k -> Finite[k].result unique smooth) K.Surjective[surj].theorem ;
  } ;
  theorem (fps : P.FP S) (fpt : P.FP T) (unique : FE.Unique S) (smooth : FE.Lift T) :
   Big.Trunc[Result].carrier =
   BTC.bind2 (P.Witness S) (P.Witness T) Result
    (\ ps pt -> Presented[ps.1,pt.1,ps.2,pt.2].result unique smooth) fps fpt ;
  witness (fpt : P.FP T) (w : Result) : I.LocalizationWitness S w.1 =
   (T,fpt,u,w.2.2.2) ;
 } ;
} ;
