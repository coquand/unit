-- Preserve the square system and its actual determinant localisation
-- when constructing an etale source. Every fp formally etale target is
-- an idempotent principal open in that source, without a flatness input.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Big = Truncation[l+] ;
module TC = TruncationCombinators[l] ; module BTC = TruncationCombinators[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module FE = FormallyEtale[l].Over[R,setR] ; module I = AffineInterface[l].Over[R,setR] ;
 module GS = Generated[l].Over[R,setR] ;
 record System {
  number : Nat ;
  equation : Fin number -> P.Expr (Fin number) ;
  quotient : C.Algebra ;
  presentation : P.Presents JacobianLifting[l].Over[R,setR,number,equation].pres quotient ;
  determinant-expression : P.Expr (Fin number) ;
  determinant-rep : Id quotient.ring.R (P.eval (Fin number) quotient presentation.1.1 determinant-expression)
   JacobianLifting[l].Over[R,setR,number,equation].At[quotient,presentation].delta ;
 } ;
 module SourceAt (system : System) {
  module J = JacobianLifting[l].Over[R,setR,system.number,system.equation] ;
  module Q = J.At[system.quotient,system.presentation] ;
  module S = Q.Chart[system.determinant-expression,system.determinant-rep] ;
 } ;
 module At (E : C.Algebra) {
  record Result {
   system : System ;
   map : C.Hom SourceAt[system].S.S E ;
   onto (e : E.ring.R) : Tr.Trunc[(s : SourceAt[system].S.S.ring.R) * Id E.ring.R (map.1.1 s) e].carrier ;
   denominator : SourceAt[system].S.S.ring.R ;
   idempotent : Id SourceAt[system].S.S.ring.R
    (SourceAt[system].S.S.ring.mul denominator denominator) denominator ;
   image-one : Id E.ring.R (map.1.1 denominator) E.ring.o ;
   localizes : I.Localizes SourceAt[system].S.S E denominator map ;
  } ;
  source-etale (w : Result) : FE.Etale SourceAt[w.system].S.S = SourceAt[w.system].S.etale ;
  localisation (fp : P.FP E) (w : Result) : I.LocalizationWitness SourceAt[w.system].S.S w.denominator =
   (E,fp,w.map,w.localizes) ;
  module Presented (p : P.Presentation) (pe : P.Presents p E) (unique : FE.Unique E) (smooth : FE.Lift E) {
   module Old = UnramifiedEtaleSource[l].Over[R,setR,E].Presented[p,pe,unique] ;
   module From (w : Old.DJ.Witness) {
    module F = Old.From[w] ;
    module Chosen (reps : F.Representatives) {
     module G = F.Chosen[reps] ;
     Representation : U l = GS.Representation G.JL.pres G.A G.pa G.SourceAt.delta ;
     module Localised (rep : Representation) {
      module Previous = G.Localised[rep] ;
      system : System = new System[p.1,G.equation,G.A,G.pa,rep.1,rep.2] ;
      module Source = SourceAt[system].S ;
      module Open = SmoothQuotientOpen[l].Over[R,setR].At[Source.S,E,Previous.map,Previous.onto] ;
      retain (o : Open.Result) : Result =
       new Result[system,Previous.map,Previous.onto,o.1,o.2.1,o.2.2.1,o.2.2.2] ;
      result : Big.Trunc[Result].carrier = BTC.map Open.Result Result retain
       (Open.theorem (Big.Trunc[P.Witness Source.S].inc Source.etale.2)
        (Big.Trunc[P.Witness E].inc (p,pe)) Source.etale.1.2 smooth) ;
     } ;
     result : Big.Trunc[Result].carrier = TC.rec Representation @l+
      Big.Trunc[Result].carrier Big.Trunc[Result].proposition (\ r -> Localised[r].result)
      (GS.Generated[G.JL.pres,G.A,G.pa].generated G.SourceAt.delta) ;
    } ;
    result : Big.Trunc[Result].carrier = TC.rec F.Representatives @l+
     Big.Trunc[Result].carrier Big.Trunc[Result].proposition (\ reps -> Chosen[reps].result) F.representatives ;
   } ;
   theorem : Big.Trunc[Result].carrier = TC.rec Old.DJ.Witness @l+
    Big.Trunc[Result].carrier Big.Trunc[Result].proposition (\ w -> From[w].result) Old.DJ.Unramified[unique].theorem ;
  } ;
  theorem (fp : P.FP E) (formal : FE.FormallyEtale E) : Big.Trunc[Result].carrier =
   BTC.bind (P.Witness E) Result (\ p -> Presented[p.1,p.2,formal.2,formal.1].theorem) fp ;
  etale (e : FE.Etale E) : Big.Trunc[Result].carrier = theorem (Big.Trunc[P.Witness E].inc e.2) e.1 ;
 } ;
} ;
