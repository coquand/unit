-- Empty equations give the zero kernel of R->R. The equation 1=0
-- gives the whole kernel of R->R/(1), using the actual presented algebra.
-- These checks do not assume R is a field or reduced.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 empty (i : Fin zero) : R.R = efq i ;
 base-ext (T : C.Algebra) (f g : C.Hom C.base T)
  (h : (i : Fin zero) -> Id T.ring.R (f.1.1 (empty i)) (g.1.1 (empty i)))
  (a : R.R) : Id T.ring.R (f.1.1 a) (g.1.1 a) = trans (f.2 a) (sym (g.2 a)) ;
 module B = BasePresentation[l].Over[R,setR] ;
 module Identity = PresentationKernel[l].Over[R,setR].At[C.base,C.base,B.empty,B.presentation,
  empty,C.identity C.base,\ i -> efq i,base-ext] ;
 no-equations : Id Nat Identity.number zero = refl zero ;
 zero-kernel (a : R.R) (h : Id R.R a R.z) : Identity.Ideal.In a = Identity.kernel a h ;
 unit-equation : P.Presentation = (zero,cons (cst R.o) nil) ;
 module Zero = PresentationExistence[l].Over[R,setR,unit-equation] ;
 u : C.Hom C.base Zero.A.algebra = (Zero.A.inclusion,\ r -> refl (Zero.A.constant r)) ;
 module Whole = PresentationKernel[l].Over[R,setR].At[C.base,Zero.A.algebra,unit-equation,Zero.presentation,
  empty,u,\ i -> efq i,base-ext] ;
 one-equation : Id Nat Whole.number (suc zero) = refl (suc zero) ;
 generator-one : Id R.R (Whole.generators (inr tt)) R.o = refl R.o ;
 killed-one : Id Zero.A.Carrier (u.1.1 R.o) Zero.A.zeroQ = Whole.killed (inr tt) ;
 unit-kernel : Whole.Ideal.In R.o = Whole.kernel R.o killed-one ;
 zero-all (a : R.R) : Id Zero.A.Carrier (u.1.1 a) Zero.A.zeroQ =
  trans (sym (Zero.A.ring.mulO (u.1.1 a)))
   (trans (ap (Zero.A.ring.mul (u.1.1 a)) (trans (sym u.1.2.1) killed-one))
    (RL[Zero.A.ring].mul-zero (u.1.1 a))) ;
 whole-kernel (a : R.R) : Whole.Ideal.In a = Whole.kernel a (zero-all a) ;
} ;
