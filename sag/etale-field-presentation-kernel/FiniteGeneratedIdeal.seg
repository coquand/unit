-- The ideal generated by one fixed finite family. Membership carries
-- merely coefficients; its equality orientation matches finite-kernel
-- and finite-free quotient APIs.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (n : Nat) (g : Fin n -> A.R) {
 module S = FiniteIdeal[l].Sums[A] ;
 Certificate (x : A.R) : U l = (a : Fin n -> A.R) * Id A.R x (S.lin n g a) ;
 In (x : A.R) : U l = Tr.Trunc[Certificate x].carrier ;
 prop (x : A.R) : Pr.isProp (In x) = Tr.Trunc[Certificate x].proposition ;
 zero : Certificate A.z = (\ i -> A.z,sym (S.lin-zero n g)) ;
 add (x y : A.R) (a : Certificate x) (b : Certificate y) : Certificate (A.add x y) =
  (\ i -> A.add (a.1 i) (b.1 i),trans (cong2 A.R A.add _ _ _ _ a.2 b.2) (sym (S.lin-add n g a.1 b.1))) ;
 scale (c x : A.R) (a : Certificate x) : Certificate (A.mul c x) =
  (\ i -> A.mul c (a.1 i),trans (ap (A.mul c) a.2) (sym (S.lin-scale n g a.1 c))) ;
 ideal : RegularIdeal[l].IdealPred[A] = RegularIdeal[l].mkIdealPred A In
  (Tr.Trunc[Certificate A.z].inc zero)
  (\ x y hx hy -> TC.map2 (Certificate x) (Certificate y) (Certificate (A.add x y)) (add x y) hx hy)
  (\ c x hx -> TC.map (Certificate x) (Certificate (A.mul c x)) (scale c x) hx) ;
 generator (i : Fin n) : In (g i) =
  Tr.Trunc[Certificate (g i)].inc ((S.coordinates n g i).1,sym (S.coordinates n g i).2) ;
} ;
