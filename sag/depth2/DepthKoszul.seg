-- Depth's explicit Depth2 is the Koszul grade Gr(a; E) >= 2 of koszul/
-- (cffr §6 item 2): koszul/GradeOne and GradeTwo prove both directions in
-- the alternating form a_i y_j - a_j y_i = 0, which is Proportional
-- (x - y = 0 iff x = y).  So the theorems of depth2/ hold with Gr as in
-- koszul/ and cffr/.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module D = Depth[l].Over[Rg,setR] ;
 module GR = Grade[l].Over[Rg,setR] ;
 module G1 = GradeOne[l].Over[Rg,setR] ;
 module G2 = GradeTwo[l].Over[Rg,setR] ;
 module At (E : D.MO.Module) (N : Nat) (a : Ps.Fin N -> R) {
  module A = D.At[E] ;
  module I1 = G1.Item1[E,N,a] ;
  module I2 = G2.Item2[E,N,a] ;
  to-explicit (d : A.Depth2 (Ps.Fin N) a) : I2.Explicit = \ y h ->
   d.2 y (\ i j -> A.MA.sub-zero (E.sm (a i) (y j)) (E.sm (a j) (y i)) (h i j)) ;
  vanish (y : Ps.Fin N -> E.M) (p : A.Proportional (Ps.Fin N) a y) (i j : Ps.Fin N) :
   Id E.M (E.madd (E.sm (a i) (y j)) (E.mneg (E.sm (a j) (y i)))) E.mz =
   trans (ap (\ v -> A.MA.sub v (E.sm (a j) (y i))) (p i j)) (A.MA.sub-self (E.sm (a j) (y i))) ;
  -- Depth2 gives Gr(a; E) >= 2
  to-koszul (d : A.Depth2 (Ps.Fin N) a) : GR.Gr E N a (suc (suc zero)) = I2.back (I1.back d.1) (to-explicit d) ;
  -- and conversely
  from-koszul (g : GR.Gr E N a (suc (suc zero))) : A.Depth2 (Ps.Fin N) a =
   (I1.forward (I2.forward g).1,\ y p -> (I2.forward g).2 y (vanish y p)) ;
 } ;
} ;
