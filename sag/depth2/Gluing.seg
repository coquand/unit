-- livre B-7.4 (covering a module by localisations, in depth 2), for the
-- monoids generated by one element s_i, elementwise.
--
-- "x = y / s^k in E[1/s]" is Loc s k x y: merely N with
-- s^N (s^k x - y) = 0.  Fractions y_i / s_i^(k_i) agree in E[1/(s_i s_j)]
-- (Compat): merely N with (s_i s_j)^N (s_j^(k_j) y_i - s_i^(k_i) y_j) = 0.
-- Theorem: if Gr(s; E) >= 2 and the fractions agree pairwise, there is a
-- unique x in E with x = y_i / s_i^(k_i) in every E[1/s_i].
--
-- Uniqueness.  If x and x' both are, s_i^Q (s_i^(k_i) x) = s_i^Q y_i =
-- s_i^Q (s_i^(k_i) x') for Q = N_i + N'_i, so s_i^(Q + k_i) kills x - x';
-- the s_i^(Q + k_i) are regular (cffr Corollary 2.2), so x = x'.  The
-- solutions thus form a proposition, and the theorem gives x itself.
-- Existence (the book's proof).  Choose the N_ij (finite choice; the goal
-- is a proposition) and let M be their double sum: every N_ij kills, so M
-- does (kills-sum: s^N w = 0 gives s^(d+N) w = 0 and s^(N+d) w = 0).  With
-- u_i = s_i^M and sigma_i = s_i^(k_i + M) = s_i^(k_i) u_i, the family
-- z_i = u_i y_i is proportional to sigma: sigma_j z_i = (s_i s_j)^M
-- s_j^(k_j) y_i = (s_i s_j)^M s_i^(k_i) y_j = sigma_i z_j.  The sigma_i have
-- depth 2 (DepthPowers), so z = sigma e, i.e. u_i y_i = u_i s_i^(k_i) e:
-- e = y_i / s_i^(k_i) in E[1/s_i], with N = M.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module L = RL[Rg] ;
 module D = Depth[l].Over[Rg,setR] ;
 module DP = DepthPowers[l].Over[Rg,setR] ;
 module Pow = AffinePowers[l].Over[Rg] ;
 power (c : R) (k : Nat) : R = Pow.power c k ;
 -- the double sum of a finite family of exponents
 natsum : (n : Nat) -> (Ps.Fin n -> Nat) -> Nat = split {
  zero -> \ f -> zero ;
  suc n | r -> \ f -> plus (f (inr tt)) (r (\ i -> f (inl i))) } ;
 module At (E : D.MO.Module) {
  module A = D.At[E] ;
  module MA = A.MA ;
  module DPA = DP.At[E] ;
  M : U l = A.M ;
  sc (a : R) (x : M) : M = A.sc a x ;
  sub (x y : M) : M = MA.sub x y ;

  ---------------------------------------------------------------------
  -- killing by powers
  Kills (c : R) (w : M) (N : Nat) : U l = Id M (sc (power c N) w) E.mz ;
  kill-mul (a b : R) (w : M) (h : Id M (sc b w) E.mz) : Id M (sc (mul a b) w) E.mz =
   trans (sym (E.smA a b w)) (trans (ap (sc a) h) (MA.sm-zr a)) ;
  kills-left (c : R) (w : M) (N d : Nat) (h : Kills c w N) : Kills c w (plus d N) =
   trans (ap (\ t -> sc t w) (Pow.power-add c d N)) (kill-mul (power c d) (power c N) w h) ;
  kills-right (c : R) (w : M) (N d : Nat) (h : Kills c w N) : Kills c w (plus N d) =
   Pr.subst Nat (Kills c w) (plus d N) (plus N d) (plus-comm d N) (kills-left c w N d h) ;
  kills-sum-last (c : R) (w : M) (n : Nat) (f : Ps.Fin (suc n) -> Nat) (r : Nat) (u : Top)
   (h : Kills c w (f (inr u))) : Kills c w (plus (f (inr tt)) r) =
   kills-right c w (f (inr tt)) r (Pr.subst Top (\ v -> Kills c w (f (inr v))) u tt (MnSums[l].top-eq u tt) h) ;
  kills-sum (c : R) (w : M) : (n : Nat) (f : Ps.Fin n -> Nat) (i : Ps.Fin n) -> Kills c w (f i) -> Kills c w (natsum n f) = split {
   zero -> \ f i h -> efq i ;
   suc n | r -> \ f -> split {
    inl i -> \ h -> kills-left c w (natsum n (\ j -> f (inl j))) (f (inr tt)) (r (\ j -> f (inl j)) i h) ;
    inr u -> \ h -> kills-sum-last c w n f (natsum n (\ j -> f (inl j))) u h } } ;
  -- q (u - v) = 0 iff q u = q v
  eq-of-kill (q : R) (u v : M) (h : Id M (sc q (sub u v)) E.mz) : Id M (sc q u) (sc q v) =
   MA.sub-zero (sc q u) (sc q v) (trans (sym (MA.sm-sub q u v)) h) ;
  kill-of-eq (q : R) (u v : M) (h : Id M (sc q u) (sc q v)) : Id M (sc q (sub u v)) E.mz =
   trans (MA.sm-sub q u v) (trans (ap (\ t -> sub t (sc q v)) h) (MA.sub-self (sc q v))) ;
  -- a (b w) = (a b) w
  sc2 (a b : R) (w : M) : Id M (sc a (sc b w)) (sc (mul a b) w) = E.smA a b w ;

  ---------------------------------------------------------------------
  -- fractions
  LocAt (c : R) (k : Nat) (x y : M) (N : Nat) : U l = Kills c (sub (sc (power c k) x) y) N ;
  Loc (c : R) (k : Nat) (x y : M) : U l = Tr.Trunc[(N : Nat) * LocAt c k x y N].carrier ;
  CompatAt (a b : R) (ka kb : Nat) (ya yb : M) (N : Nat) : U l =
   Kills (mul a b) (sub (sc (power b kb) ya) (sc (power a ka) yb)) N ;
  Compat (a b : R) (ka kb : Nat) (ya yb : M) : U l = Tr.Trunc[(N : Nat) * CompatAt a b ka kb ya yb N].carrier ;

  module Glue (n : Nat) (s : Ps.Fin n -> R) (d : A.Depth2 (Ps.Fin n) s) (k : Ps.Fin n -> Nat) (y : Ps.Fin n -> M)
   (cp : (i j : Ps.Fin n) -> Compat (s i) (s j) (k i) (k j) (y i) (y j)) {
   Sol : U l = (x : M) * ((i : Ps.Fin n) -> Loc (s i) (k i) x (y i)) ;

   -- uniqueness
   module Unique (x x' : M) {
    module Exps (N N' : Ps.Fin n -> Nat) (h : (i : Ps.Fin n) -> LocAt (s i) (k i) x (y i) (N i))
     (h' : (i : Ps.Fin n) -> LocAt (s i) (k i) x' (y i) (N' i)) {
     Q (i : Ps.Fin n) : Nat = plus (N i) (N' i) ;
     e1 (i : Ps.Fin n) : Id M (sc (power (s i) (Q i)) (sc (power (s i) (k i)) x)) (sc (power (s i) (Q i)) (y i)) =
      eq-of-kill (power (s i) (Q i)) (sc (power (s i) (k i)) x) (y i) (kills-right (s i) _ (N i) (N' i) (h i)) ;
     e2 (i : Ps.Fin n) : Id M (sc (power (s i) (Q i)) (sc (power (s i) (k i)) x')) (sc (power (s i) (Q i)) (y i)) =
      eq-of-kill (power (s i) (Q i)) (sc (power (s i) (k i)) x') (y i) (kills-left (s i) _ (N' i) (N i) (h' i)) ;
     kill (i : Ps.Fin n) : Id M (sc (power (s i) (plus (Q i) (k i))) (sub x x')) E.mz =
      kill-of-eq (power (s i) (plus (Q i) (k i))) x x' (calc M {
       sc (power (s i) (plus (Q i) (k i))) x =< ap (\ t -> sc t x) (Pow.power-add (s i) (Q i) (k i)) >
       sc (mul (power (s i) (Q i)) (power (s i) (k i))) x =< sym (sc2 (power (s i) (Q i)) (power (s i) (k i)) x) >
       sc (power (s i) (Q i)) (sc (power (s i) (k i)) x) =< trans (e1 i) (sym (e2 i)) >
       sc (power (s i) (Q i)) (sc (power (s i) (k i)) x') =< sc2 (power (s i) (Q i)) (power (s i) (k i)) x' >
       sc (mul (power (s i) (Q i)) (power (s i) (k i))) x' =< ap (\ t -> sc t x') (sym (Pow.power-add (s i) (Q i) (k i))) >
       sc (power (s i) (plus (Q i) (k i))) x' }) ;
     result : Id M x x' = MA.sub-zero x x'
      (A.RI.regular-powers n s (\ i -> plus (Q i) (k i)) d.1 (sub x x') tt kill) ;
    } ;
    result (lx : (i : Ps.Fin n) -> Loc (s i) (k i) x (y i)) (lx' : (i : Ps.Fin n) -> Loc (s i) (k i) x' (y i)) : Id M x x' =
     Tr.Trunc[(i : Ps.Fin n) -> (N : Nat) * LocAt (s i) (k i) x (y i) N].induction @l (\ w -> Id M x x') (\ w -> E.setM x x')
      (\ w -> Tr.Trunc[(i : Ps.Fin n) -> (N : Nat) * LocAt (s i) (k i) x' (y i) N].induction @l (\ w' -> Id M x x') (\ w' -> E.setM x x')
       (\ w' -> Exps[\ i -> (w i).1,\ i -> (w' i).1,\ i -> (w i).2,\ i -> (w' i).2].result)
       (AffineFinite[l].choice n (\ i -> (N : Nat) * LocAt (s i) (k i) x' (y i) N) lx'))
      (AffineFinite[l].choice n (\ i -> (N : Nat) * LocAt (s i) (k i) x (y i) N) lx) ;
   } ;
   loc-prop (x : M) : Pr.isProp ((i : Ps.Fin n) -> Loc (s i) (k i) x (y i)) =
    F.isProp-Pi (Ps.Fin n) (\ i -> Loc (s i) (k i) x (y i)) (\ i -> Tr.Trunc[(N : Nat) * LocAt (s i) (k i) x (y i) N].proposition) ;
   sol-prop : Pr.isProp Sol = \ u v ->
    Pr.Sigma-eq M (\ x -> (i : Ps.Fin n) -> Loc (s i) (k i) x (y i)) u.1 v.1 u.2 v.2 (Unique[u.1,v.1].result u.2 v.2) (loc-prop v.1) ;

   -- existence
   module Exists (N : Ps.Fin n -> Ps.Fin n -> Nat) (h : (i j : Ps.Fin n) -> CompatAt (s i) (s j) (k i) (k j) (y i) (y j) (N i j)) {
    Mx : Nat = natsum n (\ i -> natsum n (\ j -> N i j)) ;
    w (i j : Ps.Fin n) : M = sub (sc (power (s j) (k j)) (y i)) (sc (power (s i) (k i)) (y j)) ;
    killM (i j : Ps.Fin n) : Kills (mul (s i) (s j)) (w i j) Mx =
     kills-sum (mul (s i) (s j)) (w i j) n (\ a -> natsum n (\ b -> N a b)) i
      (kills-sum (mul (s i) (s j)) (w i j) n (\ b -> N i b) j (h i j)) ;
    u (i : Ps.Fin n) : R = power (s i) Mx ;
    ex (i : Ps.Fin n) : Nat = plus (k i) Mx ;
    sigma (i : Ps.Fin n) : R = power (s i) (ex i) ;
    z (i : Ps.Fin n) : M = sc (u i) (y i) ;
    P (i j : Ps.Fin n) : R = power (mul (s i) (s j)) Mx ;
    eqP (i j : Ps.Fin n) : Id M (sc (P i j) (sc (power (s j) (k j)) (y i))) (sc (P i j) (sc (power (s i) (k i)) (y j))) =
     eq-of-kill (P i j) (sc (power (s j) (k j)) (y i)) (sc (power (s i) (k i)) (y j)) (killM i j) ;
    -- sigma_j u_i = P_ij s_j^(k_j)
    ring-eq (i j : Ps.Fin n) : Id R (mul (sigma j) (u i)) (mul (P i j) (power (s j) (k j))) = calc R {
     mul (sigma j) (u i) =< ap (\ t -> mul t (u i)) (Pow.power-add (s j) (k j) Mx) >
     mul (mul (power (s j) (k j)) (u j)) (u i) =< mulC (mul (power (s j) (k j)) (u j)) (u i) >
     mul (u i) (mul (power (s j) (k j)) (u j)) =< ap (mul (u i)) (mulC (power (s j) (k j)) (u j)) >
     mul (u i) (mul (u j) (power (s j) (k j))) =< mulA (u i) (u j) (power (s j) (k j)) >
     mul (mul (u i) (u j)) (power (s j) (k j)) =< ap (\ t -> mul t (power (s j) (k j))) (sym (Pow.power-mul (s i) (s j) Mx)) >
     mul (P i j) (power (s j) (k j)) } ;
    -- sigma_j z_i = P_ij (s_j^(k_j) y_i)
    side (i j : Ps.Fin n) : Id M (sc (sigma j) (z i)) (sc (P i j) (sc (power (s j) (k j)) (y i))) = calc M {
     sc (sigma j) (z i) =< sc2 (sigma j) (u i) (y i) > sc (mul (sigma j) (u i)) (y i)
      =< ap (\ t -> sc t (y i)) (ring-eq i j) > sc (mul (P i j) (power (s j) (k j))) (y i)
      =< sym (sc2 (P i j) (power (s j) (k j)) (y i)) > sc (P i j) (sc (power (s j) (k j)) (y i)) } ;
    Pc (i j : Ps.Fin n) : Id R (P i j) (P j i) = ap (\ t -> power t Mx) (mulC (s i) (s j)) ;
    prop (i j : Ps.Fin n) : Id M (sc (sigma i) (z j)) (sc (sigma j) (z i)) = calc M {
     sc (sigma i) (z j) =< side j i > sc (P j i) (sc (power (s i) (k i)) (y j))
      =< ap (\ t -> sc t (sc (power (s i) (k i)) (y j))) (Pc j i) > sc (P i j) (sc (power (s i) (k i)) (y j))
      =< sym (eqP i j) > sc (P i j) (sc (power (s j) (k j)) (y i)) =< sym (side i j) > sc (sigma j) (z i) } ;
    dsigma : A.Depth2 (Ps.Fin n) sigma = DPA.powers n s ex d ;
    -- z = sigma e gives the solution e
    local (e : M) (he : (i : Ps.Fin n) -> Id M (z i) (sc (sigma i) e)) (i : Ps.Fin n) : LocAt (s i) (k i) e (y i) Mx =
     kill-of-eq (u i) (sc (power (s i) (k i)) e) (y i) (calc M {
      sc (u i) (sc (power (s i) (k i)) e) =< sc2 (u i) (power (s i) (k i)) e >
      sc (mul (u i) (power (s i) (k i))) e =< ap (\ t -> sc t e) (mulC (u i) (power (s i) (k i))) >
      sc (mul (power (s i) (k i)) (u i)) e =< ap (\ t -> sc t e) (sym (Pow.power-add (s i) (k i) Mx)) >
      sc (sigma i) e =< sym (he i) > z i }) ;
    sol (m : A.Multiple (Ps.Fin n) sigma z) : Sol =
     (m.1,\ i -> Tr.Trunc[(N : Nat) * LocAt (s i) (k i) m.1 (y i) N].inc (Mx,local m.1 m.2 i)) ;
    result : Sol = sol (A.multiple (Ps.Fin n) sigma dsigma z prop) ;
   } ;
   -- the exponents N_ij, by finite choice (twice)
   row (i : Ps.Fin n) : Tr.Trunc[(j : Ps.Fin n) -> (N : Nat) * CompatAt (s i) (s j) (k i) (k j) (y i) (y j) N].carrier =
    AffineFinite[l].choice n (\ j -> (N : Nat) * CompatAt (s i) (s j) (k i) (k j) (y i) (y j) N) (cp i) ;
   all : Tr.Trunc[(i : Ps.Fin n) -> (j : Ps.Fin n) -> (N : Nat) * CompatAt (s i) (s j) (k i) (k j) (y i) (y j) N].carrier =
    AffineFinite[l].choice n (\ i -> (j : Ps.Fin n) -> (N : Nat) * CompatAt (s i) (s j) (k i) (k j) (y i) (y j) N) row ;
   result : Sol =
    Tr.Trunc[(i : Ps.Fin n) -> (j : Ps.Fin n) -> (N : Nat) * CompatAt (s i) (s j) (k i) (k j) (y i) (y j) N].induction @l
     (\ t -> Sol) (\ t -> sol-prop) (\ c -> Exists[\ i j -> (c i j).1,\ i j -> (c i j).2].result) all ;
  } ;
 } ;
} ;
