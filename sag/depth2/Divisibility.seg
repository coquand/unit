-- livre B-7.1 (local-global principle for divisibility, in depth 2), for the
-- monoids generated by one element s_i, elementwise; the ring A is the
-- module Modules.Over.regular, so depth is Depth's.
--
-- "y | w in A[1/s]" is LocDiv s y w: merely e, c with s^e w = y c.
-- "y is regular in A[1/s]" is LocReg s y: s^N (y z) = 0 merely gives
-- s^N' z = 0 merely.  Elements of A[1/s] are units times elements of A, so
-- statements about all elements of A[1/s] are statements about A.
--
-- (1) divides: y regular, Gr(s) >= 2, y | x in every A[1/s_i] give y | x.
--     Choose e_i, c_i with s_i^(e_i) x = y c_i.  Then (c_i) is proportional
--     to sigma_i = s_i^(e_i): y (sigma_j c_i) = sigma_j sigma_i x =
--     y (sigma_i c_j), and y is regular.  Gr(sigma) >= 2 (DepthPowers), so
--     c_i = sigma_i c, and sigma_i x = y sigma_i c = sigma_i (y c), so
--     x = y c (sigma regular).
-- (2) strong gcd: b is a strong gcd of b_1..b_m (b | b_j, and for y
--     regular, y | x b_j for all j gives y | x b).  If (b_j) is regular,
--     Gr(s) >= 2, and b is a strong gcd in every A[1/s_i], then b is a
--     strong gcd.  b is regular: b z = 0 gives s_i^e b_j z = c b z = 0, so
--     b_j z = 0 (powers of s are regular), so z = 0.  b | b_j by (1).  If y
--     is regular and y | x b_j for all j, then y is regular and y | x b_j
--     in every A[1/s_i], so y | x b there, and y | x b by (1).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module L = RL[Rg] ;
 module D = Depth[l].Over[Rg,setR] ;
 module DP = DepthPowers[l].Over[Rg,setR] ;
 module Pow = AffinePowers[l].Over[Rg] ;
 power (c : R) (k : Nat) : R = Pow.power c k ;
 module A = D.At[D.MO.regular] ;
 module DPA = DP.At[D.MO.regular] ;

 Regular (y : R) : U l = (w : R) -> Id R (mul y w) z -> Id R w z ;
 regular-prop (y : R) : Pr.isProp (Regular y) =
  F.isProp-Pi R (\ w -> Id R (mul y w) z -> Id R w z) (\ w ->
   F.isProp-Pi (Id R (mul y w) z) (\ h -> Id R w z) (\ h -> setR w z)) ;
 Cofactor (y w : R) : U l = (c : R) * Id R w (mul y c) ;
 Divides (y w : R) : U l = Tr.Trunc[Cofactor y w].carrier ;
 LocCofactor (s y w : R) : U l = (e : Nat) * (c : R) * Id R (mul (power s e) w) (mul y c) ;
 LocDiv (s y w : R) : U l = Tr.Trunc[LocCofactor s y w].carrier ;
 Killed (s w : R) : U l = Tr.Trunc[(N : Nat) * Id R (mul (power s N) w) z].carrier ;
 LocReg (s y : R) : U l = (w : R) -> Killed s (mul y w) -> Killed s w ;

 -- y regular: y a = y b gives a = b
 cancel (y : R) (ry : Regular y) (a b : R) (h : Id R (mul y a) (mul y b)) : Id R a b =
  A.MA.sub-zero a b (ry (add a (neg b)) (trans (A.MA.sm-sub y a b) (trans (ap (\ t -> add t (neg (mul y b))) h) (addN (mul y b))))) ;
 cofactor-prop (y : R) (ry : Regular y) (w : R) : Pr.isProp (Cofactor y w) = \ u v ->
  Pr.Sigma-eq R (\ c -> Id R w (mul y c)) u.1 v.1 u.2 v.2 (cancel y ry u.1 v.1 (trans (sym u.2) v.2)) (setR w (mul y v.1)) ;

 ---------------------------------------------------------------------
 -- (1)
 module Divide (n : Nat) (s : Ps.Fin n -> R) (d : A.Depth2 (Ps.Fin n) s) (y : R) (ry : Regular y) (x : R)
  (loc : (i : Ps.Fin n) -> LocDiv (s i) y x) {
  module Exps (q : (i : Ps.Fin n) -> LocCofactor (s i) y x) {
   e (i : Ps.Fin n) : Nat = (q i).1 ;
   c (i : Ps.Fin n) : R = (q i).2.1 ;
   sigma (i : Ps.Fin n) : R = power (s i) (e i) ;
   hq (i : Ps.Fin n) : Id R (mul (sigma i) x) (mul y (c i)) = (q i).2.2 ;
   prop (i j : Ps.Fin n) : Id R (mul (sigma i) (c j)) (mul (sigma j) (c i)) = cancel y ry _ _ (calc R {
    mul y (mul (sigma i) (c j)) =< L.mul-swap y (sigma i) (c j) > mul (sigma i) (mul y (c j))
     =< ap (mul (sigma i)) (sym (hq j)) > mul (sigma i) (mul (sigma j) x)
     =< L.mul-swap (sigma i) (sigma j) x > mul (sigma j) (mul (sigma i) x)
     =< ap (mul (sigma j)) (hq i) > mul (sigma j) (mul y (c i))
     =< L.mul-swap (sigma j) y (c i) > mul y (mul (sigma j) (c i)) }) ;
   dsigma : A.Depth2 (Ps.Fin n) sigma = DPA.powers n s e d ;
   m : A.Multiple (Ps.Fin n) sigma c = A.multiple (Ps.Fin n) sigma dsigma c prop ;
   same (i : Ps.Fin n) : Id R (mul (sigma i) x) (mul (sigma i) (mul y m.1)) = calc R {
    mul (sigma i) x =< hq i > mul y (c i) =< ap (mul y) (m.2 i) > mul y (mul (sigma i) m.1)
     =< L.mul-swap y (sigma i) m.1 > mul (sigma i) (mul y m.1) } ;
   result : Cofactor y x = (m.1,A.reg-eq (Ps.Fin n) sigma dsigma.1 x (mul y m.1) same) ;
  } ;
  cofactor : Cofactor y x =
   Tr.Trunc[(i : Ps.Fin n) -> LocCofactor (s i) y x].induction @l (\ t -> Cofactor y x) (\ t -> cofactor-prop y ry x)
    (\ q -> Exps[q].result) (AffineFinite[l].choice n (\ i -> LocCofactor (s i) y x) loc) ;
  result : Divides y x = Tr.Trunc[Cofactor y x].inc cofactor ;
 } ;

 ---------------------------------------------------------------------
 -- (2)
 StrongGcd (m : Nat) (b : R) (bs : Ps.Fin m -> R) : U l =
  ((j : Ps.Fin m) -> Divides b (bs j)) *
  ((x y : R) -> Regular y -> ((j : Ps.Fin m) -> Divides y (mul x (bs j))) -> Divides y (mul x b)) ;
 LocStrongGcd (s : R) (m : Nat) (b : R) (bs : Ps.Fin m -> R) : U l =
  ((j : Ps.Fin m) -> LocDiv s b (bs j)) *
  ((x y : R) -> LocReg s y -> ((j : Ps.Fin m) -> LocDiv s y (mul x (bs j))) -> LocDiv s y (mul x b)) ;

 module Gcd (n : Nat) (s : Ps.Fin n -> R) (d : A.Depth2 (Ps.Fin n) s) (m : Nat) (bs : Ps.Fin m -> R)
  (rb : (w : R) -> ((j : Ps.Fin m) -> Id R (mul (bs j) w) z) -> Id R w z) (b : R)
  (loc : (i : Ps.Fin n) -> LocStrongGcd (s i) m b bs) {
  -- powers of the s_i are regular
  killed-all (w : R) (h : (i : Ps.Fin n) -> Killed (s i) w) : Id R w z =
   Tr.Trunc[(i : Ps.Fin n) -> (N : Nat) * Id R (mul (power (s i) N) w) z].induction @l (\ t -> Id R w z) (\ t -> setR w z)
    (\ k -> A.RI.regular-powers n s (\ i -> (k i).1) d.1 w tt (\ i -> (k i).2))
    (AffineFinite[l].choice n (\ i -> (N : Nat) * Id R (mul (power (s i) N) w) z) h) ;
  -- b is regular
  module BReg (w : R) (hw : Id R (mul b w) z) {
   kill (j : Ps.Fin m) (i : Ps.Fin n) (q : LocCofactor (s i) b (bs j)) : (N : Nat) * Id R (mul (power (s i) N) (mul (bs j) w)) z =
    (q.1,calc R {
     mul (power (s i) q.1) (mul (bs j) w) =< mulA (power (s i) q.1) (bs j) w > mul (mul (power (s i) q.1) (bs j)) w
      =< ap (\ t -> mul t w) q.2.2 > mul (mul b q.2.1) w =< ap (\ t -> mul t w) (mulC b q.2.1) > mul (mul q.2.1 b) w
      =< sym (mulA q.2.1 b w) > mul q.2.1 (mul b w) =< ap (mul q.2.1) hw > mul q.2.1 z =< L.mul-zero q.2.1 > z }) ;
   each (j : Ps.Fin m) : Id R (mul (bs j) w) z =
    killed-all (mul (bs j) w) (\ i -> TC.map (LocCofactor (s i) b (bs j)) ((N : Nat) * Id R (mul (power (s i) N) (mul (bs j) w)) z)
     (kill j i) ((loc i).1 j)) ;
   result : Id R w z = rb w each ;
  } ;
  b-regular : Regular b = \ w hw -> BReg[w,hw].result ;
  divides (j : Ps.Fin m) : Divides b (bs j) = Divide[n,s,d,b,b-regular,bs j,\ i -> (loc i).1 j].result ;
  -- a regular element is regular in A[1/s]
  loc-reg (t y : R) (ry : Regular y) : LocReg t y = \ w k ->
   TC.map ((N : Nat) * Id R (mul (power t N) (mul y w)) z) ((N : Nat) * Id R (mul (power t N) w) z)
    (\ p -> (p.1,ry (mul (power t p.1) w) (trans (L.mul-swap y (power t p.1) w) p.2))) k ;
  -- y | w gives y | w in A[1/s]
  loc-div (t y w : R) (h : Divides y w) : LocDiv t y w =
   TC.map (Cofactor y w) (LocCofactor t y w) (\ q -> (zero,q.1,trans (L.one-left w) q.2)) h ;
  strong (x y : R) (ry : Regular y) (h : (j : Ps.Fin m) -> Divides y (mul x (bs j))) : Divides y (mul x b) =
   Divide[n,s,d,y,ry,mul x b,\ i -> (loc i).2 x y (loc-reg (s i) y ry) (\ j -> loc-div (s i) y (mul x (bs j)) (h j))].result ;
  result : StrongGcd m b bs = (divides,strong) ;
 } ;
} ;
