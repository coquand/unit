-- Depth 2 of powers: Gr(s; E) >= 2 gives Gr(s_1^(k_1), ..., s_n^(k_n); E) >= 2
-- (the depth-2 analogue of cffr Corollary 2.2).
--
-- (one) A family containing 1 has depth 2: x = 1 x, and a proportional
-- family y has y_i = s_i y0 (y0 the value at the index of 1).
-- (last-power) Depth2 (t, c) gives Depth2 (t, c^k), by induction on k:
-- c^0 = 1 (one), c^(k+1) = c c^k (Depth.Product).
-- (block) For families on Fin n + Y: Depth2 u gives Depth2 of u with its
-- Fin n part raised to the powers k, by induction on n.  For n + 1, move
-- the last index of Fin (n + 1) to the end (Fin n + Y) + Top, raise it
-- (last-power), move it into the block, (Fin n) + (Top + Y), and raise the
-- Fin n part (induction, with Top + Y for Y).  The moves are reindexings
-- along bijections (Depth.Reindex) followed by pointwise equality of the
-- families (Depth.ext).
-- (powers) Y = Empty.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module D = Depth[l].Over[Rg,setR] ;
 module Pow = AffinePowers[l].Over[Rg] ;
 top-eq (u v : Top) : Id Top u v = MnSums[l].top-eq u v ;

 -- the bijections
 -- (Fin n + Top) + Y  ->  (Fin n + Y) + Top
 to-last-low (n : Nat) (Y : U l) : Plus (Ps.Fin n) Top -> Plus (Plus (Ps.Fin n) Y) Top = split {
  inl i -> inl (inl i) ; inr t -> inr t } ;
 to-last (n : Nat) (Y : U l) : Plus (Plus (Ps.Fin n) Top) Y -> Plus (Plus (Ps.Fin n) Y) Top = split {
  inl w -> to-last-low n Y w ; inr y -> inl (inr y) } ;
 from-last-low (n : Nat) (Y : U l) : Plus (Ps.Fin n) Y -> Plus (Plus (Ps.Fin n) Top) Y = split {
  inl i -> inl (inl i) ; inr y -> inr y } ;
 from-last (n : Nat) (Y : U l) : Plus (Plus (Ps.Fin n) Y) Top -> Plus (Plus (Ps.Fin n) Top) Y = split {
  inl w -> from-last-low n Y w ; inr t -> inl (inr t) } ;
 last-ft-low (n : Nat) (Y : U l) : (w : Plus (Ps.Fin n) Y) -> Id (Plus (Plus (Ps.Fin n) Y) Top) (to-last n Y (from-last-low n Y w)) (inl w) = split {
  inl i -> refl (inl (inl i)) ; inr y -> refl (inl (inr y)) } ;
 last-ft (n : Nat) (Y : U l) : (w : Plus (Plus (Ps.Fin n) Y) Top) -> Id (Plus (Plus (Ps.Fin n) Y) Top) (to-last n Y (from-last n Y w)) w = split {
  inl w -> last-ft-low n Y w ; inr t -> refl (inr t) } ;
 last-tf-low (n : Nat) (Y : U l) : (w : Plus (Ps.Fin n) Top) -> Id (Plus (Plus (Ps.Fin n) Top) Y) (from-last n Y (to-last-low n Y w)) (inl w) = split {
  inl i -> refl (inl (inl i)) ; inr t -> refl (inl (inr t)) } ;
 last-tf (n : Nat) (Y : U l) : (w : Plus (Plus (Ps.Fin n) Top) Y) -> Id (Plus (Plus (Ps.Fin n) Top) Y) (from-last n Y (to-last n Y w)) w = split {
  inl w -> last-tf-low n Y w ; inr y -> refl (inr y) } ;
 -- (Fin n + Y) + Top  ->  Fin n + (Top + Y)
 to-block-low (n : Nat) (Y : U l) : Plus (Ps.Fin n) Y -> Plus (Ps.Fin n) (Plus Top Y) = split {
  inl i -> inl i ; inr y -> inr (inr y) } ;
 to-block (n : Nat) (Y : U l) : Plus (Plus (Ps.Fin n) Y) Top -> Plus (Ps.Fin n) (Plus Top Y) = split {
  inl w -> to-block-low n Y w ; inr t -> inr (inl t) } ;
 from-block-high (n : Nat) (Y : U l) : Plus Top Y -> Plus (Plus (Ps.Fin n) Y) Top = split {
  inl t -> inr t ; inr y -> inl (inr y) } ;
 from-block (n : Nat) (Y : U l) : Plus (Ps.Fin n) (Plus Top Y) -> Plus (Plus (Ps.Fin n) Y) Top = split {
  inl i -> inl (inl i) ; inr w -> from-block-high n Y w } ;
 block-ft-low (n : Nat) (Y : U l) : (w : Plus (Ps.Fin n) Y) -> Id (Plus (Plus (Ps.Fin n) Y) Top) (from-block n Y (to-block-low n Y w)) (inl w) = split {
  inl i -> refl (inl (inl i)) ; inr y -> refl (inl (inr y)) } ;
 block-ft (n : Nat) (Y : U l) : (w : Plus (Plus (Ps.Fin n) Y) Top) -> Id (Plus (Plus (Ps.Fin n) Y) Top) (from-block n Y (to-block n Y w)) w = split {
  inl w -> block-ft-low n Y w ; inr t -> refl (inr t) } ;
 block-tf-high (n : Nat) (Y : U l) : (w : Plus Top Y) -> Id (Plus (Ps.Fin n) (Plus Top Y)) (to-block n Y (from-block-high n Y w)) (inr w) = split {
  inl t -> refl (inr (inl t)) ; inr y -> refl (inr (inr y)) } ;
 block-tf (n : Nat) (Y : U l) : (w : Plus (Ps.Fin n) (Plus Top Y)) -> Id (Plus (Ps.Fin n) (Plus Top Y)) (to-block n Y (from-block n Y w)) w = split {
  inl i -> refl (inl i) ; inr w -> block-tf-high n Y w } ;

 -- the Fin n part of a family raised to the powers k
 powl (n : Nat) (Y : U l) (u : Plus (Ps.Fin n) Y -> R) (k : Ps.Fin n -> Nat) : Plus (Ps.Fin n) Y -> R = split {
  inl i -> Pow.power (u (inl i)) (k i) ; inr y -> u (inr y) } ;

 module At (E : D.MO.Module) {
  module A = D.At[E] ;
  M : U l = A.M ;
  -- a family containing 1
  one-on (Z : U l) (t : Z -> R) (y : Plus Z Top -> M) (p : A.Proportional (Plus Z Top) (A.fam Z t o) y) :
   (i : Plus Z Top) -> Id M (y i) (A.sc (A.fam Z t o i) (y (inr tt))) = split {
   inl w -> trans (sym (E.smO (y (inl w)))) (p (inr tt) (inl w)) ;
   inr u -> trans (ap (\ v -> y (inr v)) (top-eq u tt)) (sym (E.smO (y (inr tt)))) } ;
  one (Z : U l) (t : Z -> R) : A.Depth2 (Plus Z Top) (A.fam Z t o) =
   (\ x u h -> trans (sym (E.smO x)) (h (inr tt)),
    \ y p -> Tr.Trunc[A.Multiple (Plus Z Top) (A.fam Z t o) y].inc (y (inr tt),one-on Z t y p)) ;
  last-power (Z : U l) (t : Z -> R) (c : R) (d : A.Depth2 (Plus Z Top) (A.fam Z t c)) :
   (k : Nat) -> A.Depth2 (Plus Z Top) (A.fam Z t (Pow.power c k)) = split {
   zero -> one Z t ;
   suc k | ih -> A.Product[Z,t,c,Pow.power c k,d,ih].result } ;

  module Step (n : Nat) (ih : (Y : U l) (u : Plus (Ps.Fin n) Y -> R) (k : Ps.Fin n -> Nat) ->
     A.Depth2 (Plus (Ps.Fin n) Y) u -> A.Depth2 (Plus (Ps.Fin n) Y) (powl n Y u k))
   (Y : U l) (u : Plus (Ps.Fin (suc n)) Y -> R) (k : Ps.Fin (suc n) -> Nat) (d : A.Depth2 (Plus (Ps.Fin (suc n)) Y) u) {
   Z : U l = Plus (Ps.Fin n) Y ;
   c : R = u (inl (inr tt)) ;
   t : Z -> R = \ w -> u (from-last-low n Y w) ;
   -- (1) the last index of Fin (n + 1) at the end
   d1 : A.Depth2 (Plus Z Top) (\ w -> u (from-last n Y w)) =
    A.Reindex[Plus (Ps.Fin (suc n)) Y,Plus Z Top,from-last n Y,to-last n Y,last-tf n Y,last-ft n Y,u,d].result ;
   e1 : (w : Plus Z Top) -> Id R (u (from-last n Y w)) (A.fam Z t c w) = split {
    inl w -> refl (u (from-last-low n Y w)) ; inr s -> ap (\ v -> u (inl (inr v))) (top-eq s tt) } ;
   d2 : A.Depth2 (Plus Z Top) (A.fam Z t c) = A.ext (Plus Z Top) (\ w -> u (from-last n Y w)) (A.fam Z t c) e1 d1 ;
   -- (2) raised
   cK : R = Pow.power c (k (inr tt)) ;
   d3 : A.Depth2 (Plus Z Top) (A.fam Z t cK) = last-power Z t c d2 (k (inr tt)) ;
   -- (3) into the block: Fin n + (Top + Y)
   v : Plus (Ps.Fin n) (Plus Top Y) -> R = \ w -> A.fam Z t cK (from-block n Y w) ;
   d4 : A.Depth2 (Plus (Ps.Fin n) (Plus Top Y)) v =
    A.Reindex[Plus Z Top,Plus (Ps.Fin n) (Plus Top Y),from-block n Y,to-block n Y,block-ft n Y,block-tf n Y,A.fam Z t cK,d3].result ;
   -- (4) the Fin n part raised (induction)
   kl : Ps.Fin n -> Nat = \ i -> k (inl i) ;
   d5 : A.Depth2 (Plus (Ps.Fin n) (Plus Top Y)) (powl n (Plus Top Y) v kl) = ih (Plus Top Y) v kl d4 ;
   -- (5) back to (Fin n + Top) + Y
   back : Plus (Ps.Fin (suc n)) Y -> Plus (Ps.Fin n) (Plus Top Y) = \ w -> to-block n Y (to-last n Y w) ;
   forth : Plus (Ps.Fin n) (Plus Top Y) -> Plus (Ps.Fin (suc n)) Y = \ w -> from-last n Y (from-block n Y w) ;
   bf (w : Plus (Ps.Fin n) (Plus Top Y)) : Id (Plus (Ps.Fin n) (Plus Top Y)) (back (forth w)) w =
    trans (ap (to-block n Y) (last-ft n Y (from-block n Y w))) (block-tf n Y w) ;
   fb (w : Plus (Ps.Fin (suc n)) Y) : Id (Plus (Ps.Fin (suc n)) Y) (forth (back w)) w =
    trans (ap (from-last n Y) (block-ft n Y (to-last n Y w))) (last-tf n Y w) ;
   d6 : A.Depth2 (Plus (Ps.Fin (suc n)) Y) (\ w -> powl n (Plus Top Y) v kl (back w)) =
    A.Reindex[Plus (Ps.Fin n) (Plus Top Y),Plus (Ps.Fin (suc n)) Y,back,forth,bf,fb,powl n (Plus Top Y) v kl,d5].result ;
   e6-low : (w : Plus (Ps.Fin n) Top) -> Id R (powl n (Plus Top Y) v kl (back (inl w))) (powl (suc n) Y u k (inl w)) = split {
    inl i -> refl (Pow.power (u (inl (inl i))) (k (inl i))) ;
    inr s -> ap (\ q -> Pow.power (u (inl (inr q))) (k (inr q))) (top-eq tt s) } ;
   e6 : (w : Plus (Ps.Fin (suc n)) Y) -> Id R (powl n (Plus Top Y) v kl (back w)) (powl (suc n) Y u k w) = split {
    inl w -> e6-low w ; inr y -> refl (u (inr y)) } ;
   result : A.Depth2 (Plus (Ps.Fin (suc n)) Y) (powl (suc n) Y u k) =
    A.ext (Plus (Ps.Fin (suc n)) Y) (\ w -> powl n (Plus Top Y) v kl (back w)) (powl (suc n) Y u k) e6 d6 ;
  } ;

  -- empty block
  base-eq (Y : U l) (u : Plus (Ps.Fin zero) Y -> R) (k : Ps.Fin zero -> Nat) :
   (w : Plus (Ps.Fin zero) Y) -> Id R (u w) (powl zero Y u k w) = split {
   inl i -> efq i ; inr y -> refl (u (inr y)) } ;
  block : (n : Nat) (Y : U l) (u : Plus (Ps.Fin n) Y -> R) (k : Ps.Fin n -> Nat) ->
   A.Depth2 (Plus (Ps.Fin n) Y) u -> A.Depth2 (Plus (Ps.Fin n) Y) (powl n Y u k) = split {
   zero -> \ Y u k d -> A.ext (Plus (Ps.Fin zero) Y) u (powl zero Y u k) (base-eq Y u k) d ;
   suc n | ih -> \ Y u k d -> Step[n,ih,Y,u,k,d].result } ;

  -- Gr(s; E) >= 2 gives Gr(s^k; E) >= 2
  module Powers (n : Nat) (s : Ps.Fin n -> R) (k : Ps.Fin n -> Nat) (d : A.Depth2 (Ps.Fin n) s) {
   out : Plus (Ps.Fin n) Empty -> Ps.Fin n = split { inl i -> i ; inr e -> efq e } ;
   inn (i : Ps.Fin n) : Plus (Ps.Fin n) Empty = inl i ;
   oi (i : Ps.Fin n) : Id (Ps.Fin n) (out (inn i)) i = refl i ;
   io : (w : Plus (Ps.Fin n) Empty) -> Id (Plus (Ps.Fin n) Empty) (inn (out w)) w = split {
    inl i -> refl (inl i) ; inr e -> efq e } ;
   u : Plus (Ps.Fin n) Empty -> R = \ w -> s (out w) ;
   d1 : A.Depth2 (Plus (Ps.Fin n) Empty) u =
    A.Reindex[Ps.Fin n,Plus (Ps.Fin n) Empty,out,inn,oi,io,s,d].result ;
   d2 : A.Depth2 (Plus (Ps.Fin n) Empty) (powl n Empty u k) = block n Empty u k d1 ;
   result : A.Depth2 (Ps.Fin n) (\ i -> Pow.power (s i) (k i)) =
    A.Reindex[Plus (Ps.Fin n) Empty,Ps.Fin n,inn,out,io,oi,powl n Empty u k,d2].result ;
  } ;
  powers (n : Nat) (s : Ps.Fin n -> R) (k : Ps.Fin n -> Nat) (d : A.Depth2 (Ps.Fin n) s) :
   A.Depth2 (Ps.Fin n) (\ i -> Pow.power (s i) (k i)) = Powers[n,s,k,d].result ;
 } ;
} ;
