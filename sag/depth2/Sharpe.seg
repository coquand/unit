-- livre B-7.5 (Sharpe, Grade and the theory of linear equations, 1977),
-- for F = A: a linear system U X = V (n unknowns, m equations) whose
-- (n + 1)-minors of W = [U | V] vanish, with Gr(D_n(U)) >= 2, has a unique
-- solution.  The n-minors are the family delta_rho over all lists of rows
-- rho : Fin n -> Fin m (SharpeRows; it generates D_n(U)); depth is Depth's,
-- for the ring as a module.
--
-- (unique) Gr(D_n(U)) >= 1 suffices: if (U x)_r = (U y)_r for all r then
-- U_rho x = U_rho y, so delta_rho x = adj(U_rho) U_rho x = delta_rho y for
-- all rho, and x = y.
-- (exists) For all rho, (U X_rho)_r = delta_rho V_r (SharpeRows.row, the
-- (n + 1)-minor being 0).  So delta_rho' X_rho and delta_rho X_rho' have the
-- same image delta_rho delta_rho' V, and are equal (unique): for each k the
-- family (X_rho,k)_rho is proportional to (delta_rho)_rho.  Gr >= 2 gives
-- x_k with X_rho,k = delta_rho x_k.  Then delta_rho (U x)_r = (U X_rho)_r =
-- delta_rho V_r for all rho, so (U x)_r = V_r.
-- (necessary) Conversely a solution makes every (n + 1)-minor of W vanish:
-- the last column V_sigma is sum_j x_j u_j o sigma, and det is linear in it
-- and vanishes on a repeated column (Adjugate.adj-case).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module ADJ = Adjugate[l].Over[Rg,setR] ;
 module DK = DeterminantTrick[l].Over[Rg,setR] ;
 module SR = SharpeRows[l].Over[Rg,setR] ;
 module DD = Depth[l].Over[Rg,setR] ;
 module A = DD.At[DD.MO.regular] ;
 open ExteriorModel[l].Over[Rg] ;

 module System (n m : Nat) (u : Ps.Fin n -> AL.Vec m) (V : AL.Vec m) {
  module SY = SR.Sys[n,m,u,V] ;
  Rows : U l = Ps.Fin n -> Ps.Fin m ;
  delta (rho : Rows) : R = SY.delta rho ;
  lin (x : AL.Vec n) (r : Ps.Fin m) : R = SY.lin x r ;
  Solves (x : AL.Vec n) : U l = (r : Ps.Fin m) -> Id R (lin x r) (V r) ;
  Sol : U l = (x : AL.Vec n) * Solves x ;
  Minors : U l = (sigma : Ps.Fin (suc n) -> Ps.Fin m) -> Id R (det (suc n) (SY.Wmat sigma)) z ;

  -- adj(U_rho) U_rho x = delta_rho x
  adj-cancel (rho : Rows) (x : AL.Vec n) (k : Ps.Fin n) :
   Id R (DT.act n (ADJ.adj n (SY.Urho rho)) (DT.act n (SY.Urho rho) x) k) (mul (delta rho) (x k)) = calc R {
   DT.act n (ADJ.adj n (SY.Urho rho)) (DT.act n (SY.Urho rho) x) k
    =< sym (DK.act-mmul n (ADJ.adj n (SY.Urho rho)) (SY.Urho rho) x k) >
   DT.act n (DT.mmul n (ADJ.adj n (SY.Urho rho)) (SY.Urho rho)) x k
    =< ap (\ N -> DT.act n N x k) (ADJ.adj-mul-mat n (SY.Urho rho)) >
   DT.act n (\ j i -> mul (delta rho) (D.delta n j i)) x k =< DK.act-scalar n (delta rho) x k > mul (delta rho) (x k) } ;
  -- (U x) = (U y) gives x = y, when the delta_rho are regular
  module Inj (rg : A.Reg Rows delta) (x y : AL.Vec n) (h : (r : Ps.Fin m) -> Id R (lin x r) (lin y r)) {
   same-image (rho : Rows) : Id (AL.Vec n) (DT.act n (SY.Urho rho) x) (DT.act n (SY.Urho rho) y) =
    F.funext (Ps.Fin n) (\ t -> R) (DT.act n (SY.Urho rho) x) (DT.act n (SY.Urho rho) y) (\ t -> h (rho t)) ;
   at (k : Ps.Fin n) (rho : Rows) : Id R (mul (delta rho) (x k)) (mul (delta rho) (y k)) =
    trans (sym (adj-cancel rho x k)) (trans (ap (\ w -> DT.act n (ADJ.adj n (SY.Urho rho)) w k) (same-image rho)) (adj-cancel rho y k)) ;
   result (k : Ps.Fin n) : Id R (x k) (y k) = A.reg-eq Rows delta rg (x k) (y k) (at k) ;
  } ;
  -- the solution is unique when Gr(D_n(U)) >= 1
  sol-prop (rg : A.Reg Rows delta) : Pr.isProp Sol = \ a b ->
   Pr.Sigma-eq (AL.Vec n) Solves a.1 b.1 a.2 b.2
    (F.funext (Ps.Fin n) (\ k -> R) a.1 b.1 (Inj[rg,a.1,b.1,\ r -> trans (a.2 r) (sym (b.2 r))].result))
    (F.isProp-Pi (Ps.Fin m) (\ r -> Id R (lin b.1 r) (V r)) (\ r -> setR (lin b.1 r) (V r))) ;

  -- lin (a x) = a lin x
  lin-scale (a : R) (x : AL.Vec n) (r : Ps.Fin m) : Id R (lin (\ j -> mul a (x j)) r) (mul a (lin x r)) =
   trans (S.sum-cong n (\ j -> mul (mul a (x j)) (u j r)) (\ j -> mul a (mul (x j) (u j r))) (\ j -> sym (mulA a (x j) (u j r))))
    (S.sum-scale a n (\ j -> mul (x j) (u j r))) ;

  module Exists (mn : Minors) (dp : A.Depth2 Rows delta) {
   -- (U X_rho)_r = delta_rho V_r
   cramer (rho : Rows) (r : Ps.Fin m) : Id R (lin (SY.X rho) r) (mul (delta rho) (V r)) =
    trans (sym (L.zl (lin (SY.X rho) r))) (trans (ap (\ t -> add t (lin (SY.X rho) r)) (sym (mn (SY.ext rho r)))) (SY.row rho r)) ;
   -- delta_rho' X_rho = delta_rho X_rho'
   cross (rho rho' : Rows) (r : Ps.Fin m) :
    Id R (lin (\ j -> mul (delta rho') (SY.X rho j)) r) (lin (\ j -> mul (delta rho) (SY.X rho' j)) r) = calc R {
    lin (\ j -> mul (delta rho') (SY.X rho j)) r =< lin-scale (delta rho') (SY.X rho) r >
    mul (delta rho') (lin (SY.X rho) r) =< ap (mul (delta rho')) (cramer rho r) >
    mul (delta rho') (mul (delta rho) (V r)) =< L.mul-swap (delta rho') (delta rho) (V r) >
    mul (delta rho) (mul (delta rho') (V r)) =< ap (mul (delta rho)) (sym (cramer rho' r)) >
    mul (delta rho) (lin (SY.X rho') r) =< sym (lin-scale (delta rho) (SY.X rho') r) >
    lin (\ j -> mul (delta rho) (SY.X rho' j)) r } ;
   prop (k : Ps.Fin n) : A.Proportional Rows delta (\ rho -> SY.X rho k) = \ rho rho' ->
    Inj[dp.1,\ j -> mul (delta rho) (SY.X rho' j),\ j -> mul (delta rho') (SY.X rho j),\ r -> sym (cross rho rho' r)].result k ;
   mult (k : Ps.Fin n) : A.Multiple Rows delta (\ rho -> SY.X rho k) = A.multiple Rows delta dp (\ rho -> SY.X rho k) (prop k) ;
   x : AL.Vec n = \ k -> (mult k).1 ;
   solves (r : Ps.Fin m) : Id R (lin x r) (V r) = A.reg-eq Rows delta dp.1 (lin x r) (V r) (\ rho -> calc R {
    mul (delta rho) (lin x r) =< sym (lin-scale (delta rho) x r) >
    lin (\ j -> mul (delta rho) (x j)) r =< S.sum-cong n (\ j -> mul (mul (delta rho) (x j)) (u j r)) (\ j -> mul (SY.X rho j) (u j r))
                                            (\ j -> ap (\ t -> mul t (u j r)) (sym ((mult j).2 rho))) >
    lin (SY.X rho) r =< cramer rho r > mul (delta rho) (V r) }) ;
   result : Sol = (x,solves) ;
  } ;
  -- livre B-7.5
  theorem (mn : Minors) (dp : A.Depth2 Rows delta) : Sol = Exists[mn,dp].result ;

  -- a solution makes the (n + 1)-minors vanish
  module Necessary (s : Sol) (sigma : Ps.Fin (suc n) -> Ps.Fin m) {
   W : DT.Mat (suc n) = SY.Wmat sigma ;
   f (b : AL.Vec (suc n)) : R = ADJ.colform (suc n) W (inr tt) b ;
   g (j : Ps.Fin n) : AL.Vec (suc n) = AL.vscale (suc n) (s.1 j) (W (inl j)) ;
   last : Id (AL.Vec (suc n)) (W (inr tt)) (\ t -> S.sum n (\ j -> g j t)) =
    F.funext (Ps.Fin (suc n)) (\ t -> R) (W (inr tt)) (\ t -> S.sum n (\ j -> g j t)) (\ t -> sym (s.2 (sigma t))) ;
   repeat (j : Ps.Fin n) : Id R (f (W (inl j))) z =
    trans (ADJ.adj-case (suc n) W (inl j) (inr tt) (ADJ.dec-fin (suc n) (inl j) (inr tt)))
     (trans (ap (mul (det (suc n) W)) (D.delta-off (suc n) (inl j) (inr tt) (\ e -> ADJ.inl-inr {Ps.Fin n} e))) (L.mul-zero (det (suc n) W))) ;
   result : Id R (det (suc n) W) z = calc R {
    det (suc n) W =< ap (det (suc n)) (sym (F.funext (Ps.Fin (suc n)) (\ c -> AL.Vec (suc n)) (ADJ.repl (suc n) (suc n) W (inr tt) (W (inr tt))) W
                       (ADJ.repl-self (suc n) (suc n) W (inr tt)))) >
    f (W (inr tt)) =< ap f last > f (\ t -> S.sum n (\ j -> g j t))
     =< ADJ.form-sum (suc n) f (ADJ.colform-lin (suc n) W (inr tt)) n g > S.sum n (\ j -> f (g j))
     =< S.sum-cong n (\ j -> f (g j)) (\ j -> z) (\ j -> trans ((ADJ.colform-lin (suc n) W (inr tt)).2 (s.1 j) (W (inl j)))
          (trans (ap (mul (s.1 j)) (repeat j)) (L.mul-zero (s.1 j)))) >
    S.sum n (\ j -> z) =< S.sum-zero n > z } ;
  } ;
  necessary (s : Sol) : Minors = \ sigma -> Necessary[s,sigma].result ;
 } ;
} ;
