-- Depth 1 and 2 of a family s : X -> R on a module E, in the explicit form
-- of cffr §6 items 1–2 (koszul/GradeOne, GradeTwo: for X = Fin N these are
-- Gr(s; E) >= 1 and >= 2 for the Koszul grade).
--
--   Reg X s       s_i x = 0 for all i gives x = 0 (cffr/RegularIdeal for
--                 the module, GradeOne.action);
--   Proportional  s_i y_j = s_j y_i for all i, j;
--   Depth2 X s    Reg, and every proportional family y is merely s e.
--
-- Under Reg the multiple e is unique (s_i (e - e') = 0), so Depth2 gives it
-- without truncation (multiple).  Depth2 is a proposition, and depends
-- only on the family up to pointwise equality (ext) and on the index type
-- up to bijection (reindex: y on Y gives z = y o g on X, proportional for
-- s since f (g i) = i; then y = z o f since g (f j) = j).
--
-- Families on Z + Top: fam t c is t on Z and c at the new index.
-- (product) Depth2 (t, a) and Depth2 (t, b) give Depth2 (t, ab).  Reg: if
-- t x = 0 and ab x = 0 then t (b x) = 0 and a (b x) = 0, so b x = 0, so
-- x = 0.  A family (y, y0) proportional to (t, ab) gives (b y, y0)
-- proportional to (t, a): t_z (b y_w) = b (t_z y_w) = b (t_w y_z), and
-- t_z y0 = (ab) y_z = a (b y_z); so b y = t e and y0 = a e.  Then (y, e) is
-- proportional to (t, b): t_z e = b y_z; so y = t f and e = b f, and
-- y0 = a (b f) = (ab) f.
-- (last-power) Depth2 (t, c) gives Depth2 (t, c^k): c^0 = 1 (a family
-- containing 1 has depth 2: e = y0), and c^(k+1) = c c^k by product.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MO = Modules[l].Over[Rg,setR] ;
 module G1 = GradeOne[l].Over[Rg,setR] ;
 module Pow = AffinePowers[l].Over[Rg] ;
 module At (E : MO.Module) {
  module RI = RegularIdeal[l].Over[Rg,G1.action E] ;
  module MA = Alg73[l].MA[MO.ring,E] ;
  M : U l = E.M ;
  sc (a : R) (x : M) : M = E.sm a x ;

  ---------------------------------------------------------------------
  -- the notions
  Reg (X : U l) (s : X -> R) : U l = RI.Regular X s ;
  reg (X : U l) (s : X -> R) (r : Reg X s) (x : M) (h : (i : X) -> Id M (sc (s i) x) E.mz) : Id M x E.mz =
   r x tt h ;
  Proportional (X : U l) (s : X -> R) (y : X -> M) : U l = (i j : X) -> Id M (sc (s i) (y j)) (sc (s j) (y i)) ;
  Multiple (X : U l) (s : X -> R) (y : X -> M) : U l = (e : M) * ((i : X) -> Id M (y i) (sc (s i) e)) ;
  Depth2 (X : U l) (s : X -> R) : U l =
   Reg X s * ((y : X -> M) -> Proportional X s y -> Tr.Trunc[Multiple X s y].carrier) ;

  -- s_i x = s_i x' for all i gives x = x'
  reg-eq (X : U l) (s : X -> R) (r : Reg X s) (x x' : M) (h : (i : X) -> Id M (sc (s i) x) (sc (s i) x')) : Id M x x' =
   MA.sub-zero x x' (reg X s r (MA.sub x x') (\ i -> trans (MA.sm-sub (s i) x x')
    (trans (ap (\ v -> MA.sub v (sc (s i) x')) (h i)) (MA.sub-self (sc (s i) x'))))) ;
  multiple-prop (X : U l) (s : X -> R) (r : Reg X s) (y : X -> M) : Pr.isProp (Multiple X s y) = \ u v ->
   Pr.Sigma-eq M (\ e -> (i : X) -> Id M (y i) (sc (s i) e)) u.1 v.1 u.2 v.2
    (reg-eq X s r u.1 v.1 (\ i -> trans (sym (u.2 i)) (v.2 i)))
    (F.isProp-Pi X (\ i -> Id M (y i) (sc (s i) v.1)) (\ i -> E.setM (y i) (sc (s i) v.1))) ;
  -- the multiple, by unique choice
  multiple (X : U l) (s : X -> R) (d : Depth2 X s) (y : X -> M) (p : Proportional X s y) : Multiple X s y =
   Tr.Trunc[Multiple X s y].induction @l (\ w -> Multiple X s y) (\ w -> multiple-prop X s d.1 y)
    (\ w -> w) (d.2 y p) ;

  reg-prop (X : U l) (s : X -> R) : Pr.isProp (Reg X s) =
   F.isProp-Pi M (\ x -> Top -> RI.ZeroOn X s x -> Id M x E.mz) (\ x ->
    F.isProp-Pi Top (\ t -> RI.ZeroOn X s x -> Id M x E.mz) (\ t ->
     F.isProp-Pi (RI.ZeroOn X s x) (\ h -> Id M x E.mz) (\ h -> E.setM x E.mz))) ;
  depth2-prop (X : U l) (s : X -> R) : Pr.isProp (Depth2 X s) =
   Pr.isProp-Sigma (Reg X s) (\ r -> (y : X -> M) -> Proportional X s y -> Tr.Trunc[Multiple X s y].carrier)
    (reg-prop X s) (\ r -> F.isProp-Pi (X -> M) (\ y -> Proportional X s y -> Tr.Trunc[Multiple X s y].carrier) (\ y ->
     F.isProp-Pi (Proportional X s y) (\ p -> Tr.Trunc[Multiple X s y].carrier) (\ p -> Tr.Trunc[Multiple X s y].proposition))) ;

  ---------------------------------------------------------------------
  -- pointwise equal families
  ext (X : U l) (s s' : X -> R) (h : (i : X) -> Id R (s i) (s' i)) (d : Depth2 X s) : Depth2 X s' =
   Pr.subst (X -> R) (Depth2 X) s s' (F.funext X (\ i -> R) s s' h) d ;

  -- reindexing along a bijection f : Y -> X with inverse g
  module Reindex (X Y : U l) (f : Y -> X) (g : X -> Y) (fg : (i : X) -> Id X (f (g i)) i)
   (gf : (j : Y) -> Id Y (g (f j)) j) (s : X -> R) (d : Depth2 X s) {
   t : Y -> R = \ j -> s (f j) ;
   reg-t : Reg Y t = \ x u h -> reg X s d.1 x (\ i -> Pr.subst X (\ k -> Id M (sc (s k) x) E.mz) (f (g i)) i (fg i) (h (g i))) ;
   module Fam (y : Y -> M) (p : Proportional Y t y) {
    z : X -> M = \ i -> y (g i) ;
    pz (i j : X) : Id M (sc (s i) (z j)) (sc (s j) (z i)) = calc M {
     sc (s i) (z j) =< ap (\ k -> sc (s k) (z j)) (sym (fg i)) > sc (s (f (g i))) (z j)
      =< p (g i) (g j) > sc (s (f (g j))) (z i) =< ap (\ k -> sc (s k) (z i)) (fg j) > sc (s j) (z i) } ;
    back (w : Multiple X s z) : Multiple Y t y =
     (w.1,\ j -> trans (ap y (sym (gf j))) (w.2 (f j))) ;
    result : Tr.Trunc[Multiple Y t y].carrier = TC.map (Multiple X s z) (Multiple Y t y) back (d.2 z pz) ;
   } ;
   result : Depth2 Y t = (reg-t,\ y p -> Fam[y,p].result) ;
  } ;

  ---------------------------------------------------------------------
  -- families with a last index
  fam (Z : U l) (t : Z -> R) (c : R) : Plus Z Top -> R = split { inl w -> t w ; inr u -> c } ;
  -- proportionality on Z + Top from its three cases
  module Prop3 (Z : U l) (t : Z -> R) (c : R) (y : Z -> M) (y0 : M)
   (pzz : (i j : Z) -> Id M (sc (t i) (y j)) (sc (t j) (y i)))
   (pz0 : (i : Z) -> Id M (sc (t i) y0) (sc c (y i))) {
   yy : Plus Z Top -> M = split { inl w -> y w ; inr u -> y0 } ;
   low (i : Z) : (j : Plus Z Top) -> Id M (sc (fam Z t c (inl i)) (yy j)) (sc (fam Z t c j) (yy (inl i))) = split {
    inl j -> pzz i j ; inr u -> pz0 i } ;
   high (u : Top) : (j : Plus Z Top) -> Id M (sc (fam Z t c (inr u)) (yy j)) (sc (fam Z t c j) (yy (inr u))) = split {
    inl j -> sym (pz0 j) ; inr v -> refl (sc c y0) } ;
   result : Proportional (Plus Z Top) (fam Z t c) yy = split { inl i -> low i ; inr u -> high u } ;
  } ;
  module Product (Z : U l) (t : Z -> R) (a b : R) (da : Depth2 (Plus Z Top) (fam Z t a)) (db : Depth2 (Plus Z Top) (fam Z t b)) {
   ab : R = mul a b ;
   -- t (b x) = b (t x)
   swap (c : R) (x : M) : Id M (sc c (sc b x)) (sc b (sc c x)) = MA.sm-swap c b x ;
   module RegAB (x : M) (h : RI.ZeroOn (Plus Z Top) (fam Z t ab) x) {
    bx-t (i : Z) : Id M (sc (t i) (sc b x)) E.mz = trans (swap (t i) x) (trans (ap (sc b) (h (inl i))) (MA.sm-zr b)) ;
    bx-a : Id M (sc a (sc b x)) E.mz = trans (E.smA a b x) (h (inr tt)) ;
    bx-on : (i : Plus Z Top) -> Id M (sc (fam Z t a i) (sc b x)) E.mz = split { inl i -> bx-t i ; inr u -> bx-a } ;
    bx : Id M (sc b x) E.mz = reg (Plus Z Top) (fam Z t a) da.1 (sc b x) bx-on ;
    x-on : (i : Plus Z Top) -> Id M (sc (fam Z t b i) x) E.mz = split { inl i -> h (inl i) ; inr u -> bx } ;
    result : Id M x E.mz = reg (Plus Z Top) (fam Z t b) db.1 x x-on ;
   } ;
   module Fam (y : Plus Z Top -> M) (p : Proportional (Plus Z Top) (fam Z t ab) y) {
    yl (i : Z) : M = y (inl i) ;
    y0 : M = y (inr tt) ;
    -- (b y, y0) is proportional to (t, a)
    p1zz (i j : Z) : Id M (sc (t i) (sc b (yl j))) (sc (t j) (sc b (yl i))) = calc M {
     sc (t i) (sc b (yl j)) =< swap (t i) (yl j) > sc b (sc (t i) (yl j))
      =< ap (sc b) (p (inl i) (inl j)) > sc b (sc (t j) (yl i)) =< sym (swap (t j) (yl i)) > sc (t j) (sc b (yl i)) } ;
    p1z0 (i : Z) : Id M (sc (t i) y0) (sc a (sc b (yl i))) = trans (p (inl i) (inr tt)) (sym (E.smA a b (yl i))) ;
    module P1 = Prop3[Z,t,a,\ i -> sc b (yl i),y0,p1zz,p1z0] ;
    module Second (w : Multiple (Plus Z Top) (fam Z t a) P1.yy) {
     e : M = w.1 ;
     -- (y, e) is proportional to (t, b)
     p2z0 (i : Z) : Id M (sc (t i) e) (sc b (yl i)) = sym (w.2 (inl i)) ;
     module P2 = Prop3[Z,t,b,yl,e,\ i j -> p (inl i) (inl j),p2z0] ;
     split-at (v : Multiple (Plus Z Top) (fam Z t b) P2.yy) : (i : Plus Z Top) -> Id M (y i) (sc (fam Z t ab i) v.1) = split {
      inl i -> v.2 (inl i) ;
      inr u -> trans (ap (\ k -> y (inr k)) (MnSums[l].top-eq u tt))
       (calc M { y0 =< w.2 (inr tt) > sc a e =< ap (sc a) (v.2 (inr tt)) > sc a (sc b v.1)
        =< E.smA a b v.1 > sc ab v.1 }) } ;
     fin (v : Multiple (Plus Z Top) (fam Z t b) P2.yy) : Multiple (Plus Z Top) (fam Z t ab) y =
      (v.1,split-at v) ;
     result : Tr.Trunc[Multiple (Plus Z Top) (fam Z t ab) y].carrier =
      TC.map (Multiple (Plus Z Top) (fam Z t b) P2.yy) (Multiple (Plus Z Top) (fam Z t ab) y) fin
       (db.2 P2.yy (P2.result)) ;
    } ;
    result : Tr.Trunc[Multiple (Plus Z Top) (fam Z t ab) y].carrier =
     Tr.Trunc[Multiple (Plus Z Top) (fam Z t a) P1.yy].induction @l
      (\ w -> Tr.Trunc[Multiple (Plus Z Top) (fam Z t ab) y].carrier)
      (\ w -> Tr.Trunc[Multiple (Plus Z Top) (fam Z t ab) y].proposition)
      (\ w -> Second[w].result) (da.2 P1.yy P1.result) ;
   } ;
   result : Depth2 (Plus Z Top) (fam Z t ab) = (\ x u h -> RegAB[x,h].result,\ y p -> Fam[y,p].result) ;
  } ;
 } ;
} ;
