-- livre B-7.2 for k = 2: depth 2 is local for a depth-2 covering.  For
-- s_1, ..., s_n with Gr(s; E) >= 2 and a family a_1, ..., a_p:
-- if Gr(a; E[1/s_i]) >= 2 for every i, then Gr(a; E) >= 2.
--
-- Elementwise (Gluing): x = x' in E[1/c] is Eq c x x' (merely N with
-- c^N (x - x') = 0).  Gr(a; E[1/c]) >= 2 is LDepth2 c a: a_j x = 0 in
-- E[1/c] for all j gives x = 0 in E[1/c], and a family y with
-- a_j y_k = a_k y_j in E[1/c] is merely y_j = a_j (w / c^f) in E[1/c].  A
-- family of fractions can be given the denominator 1 (multiply by a power
-- of c, a unit), so this is the general statement.
--
-- Proof.  Reg: a_j x = 0 gives x = 0 in every E[1/s_i], so a power of each
-- s_i kills x, and x = 0 (cffr Corollary 2.2).  Depth 2: let y be
-- proportional to a.  In every E[1/s_i], y_j = a_j (w_i / s_i^(f_i)).
-- These fractions agree in E[1/(s_i s_l)] (compat): with
-- t = s_l^(f_l) w_i - s_i^(f_i) w_l, a_j t = 0 there (both terms are
-- s_i^(f_i) s_l^(f_l) y_j there), so (s_i s_l)^Q a_j t = 0 for all j, and
-- s_i^Q a_j (s_l^Q t) = 0: s_l^Q t = 0 in E[1/s_i] (a is regular there),
-- s_i^K s_l^Q t = 0, so (s_i s_l)^(K+Q) t = 0.  Gluing (7.4) gives e with
-- e = w_i / s_i^(f_i) in every E[1/s_i]; then s_i^(f_i) y_j = a_j w_i =
-- s_i^(f_i) a_j e in E[1/s_i], so y_j - a_j e = 0 in every E[1/s_i], and
-- y_j = a_j e.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module D = Depth[l].Over[Rg,setR] ;
 module GL = Gluing[l].Over[Rg,setR] ;
 module Pow = AffinePowers[l].Over[Rg] ;
 power (c : R) (k : Nat) : R = Pow.power c k ;
 module At (E : D.MO.Module) {
  module A = D.At[E] ;
  module MA = A.MA ;
  module G = GL.At[E] ;
  M : U l = A.M ;
  sc (a : R) (x : M) : M = A.sc a x ;
  sub (x y : M) : M = MA.sub x y ;

  ---------------------------------------------------------------------
  -- x = x' in E[1/c]
  EqAt (c : R) (x x' : M) (N : Nat) : U l = G.Kills c (sub x x') N ;
  Eq (c : R) (x x' : M) : U l = Tr.Trunc[(N : Nat) * EqAt c x x' N].carrier ;
  eq-exact (c : R) (x x' : M) (h : Id M x x') : Eq c x x' =
   Tr.Trunc[(N : Nat) * EqAt c x x' N].inc (zero,trans (E.smO (sub x x')) (trans (ap (\ v -> sub v x') h) (MA.sub-self x'))) ;
  sym-at (c : R) (x x' : M) (N : Nat) (h : EqAt c x x' N) : EqAt c x' x N =
   G.kill-of-eq (power c N) x' x (sym (G.eq-of-kill (power c N) x x' h)) ;
  trans-at (c : R) (x x' x'' : M) (N N' : Nat) (h : EqAt c x x' N) (h' : EqAt c x' x'' N') : EqAt c x x'' (plus N N') =
   G.kill-of-eq (power c (plus N N')) x x''
    (trans (G.eq-of-kill (power c (plus N N')) x x' (G.kills-right c (sub x x') N N' h))
     (G.eq-of-kill (power c (plus N N')) x' x'' (G.kills-left c (sub x' x'') N' N h'))) ;
  scale-at (c a : R) (x x' : M) (N : Nat) (h : EqAt c x x' N) : EqAt c (sc a x) (sc a x') N =
   G.kill-of-eq (power c N) (sc a x) (sc a x') (calc M {
    sc (power c N) (sc a x) =< MA.sm-swap (power c N) a x > sc a (sc (power c N) x)
     =< ap (sc a) (G.eq-of-kill (power c N) x x' h) > sc a (sc (power c N) x')
     =< MA.sm-swap a (power c N) x' > sc (power c N) (sc a x') }) ;
  -- from E[1/c] or E[1/b] to E[1/(c b)]
  widen-right (c b : R) (x x' : M) (N : Nat) (h : EqAt c x x' N) : EqAt (mul c b) x x' N =
   trans (ap (\ t -> sc t (sub x x')) (trans (Pow.power-mul c b N) (mulC (power c N) (power b N))))
    (G.kill-mul (power b N) (power c N) (sub x x') h) ;
  widen-left (c b : R) (x x' : M) (N : Nat) (h : EqAt b x x' N) : EqAt (mul c b) x x' N =
   trans (ap (\ t -> sc t (sub x x')) (Pow.power-mul c b N)) (G.kill-mul (power c N) (power b N) (sub x x') h) ;
  -- the truncated forms
  eq-sym (c : R) (x x' : M) (h : Eq c x x') : Eq c x' x =
   TC.map ((N : Nat) * EqAt c x x' N) ((N : Nat) * EqAt c x' x N) (\ q -> (q.1,sym-at c x x' q.1 q.2)) h ;
  eq-trans (c : R) (x x' x'' : M) (h : Eq c x x') (h' : Eq c x' x'') : Eq c x x'' =
   TC.map2 ((N : Nat) * EqAt c x x' N) ((N : Nat) * EqAt c x' x'' N) ((N : Nat) * EqAt c x x'' N)
    (\ q q' -> (plus q.1 q'.1,trans-at c x x' x'' q.1 q'.1 q.2 q'.2)) h h' ;
  eq-scale (c a : R) (x x' : M) (h : Eq c x x') : Eq c (sc a x) (sc a x') =
   TC.map ((N : Nat) * EqAt c x x' N) ((N : Nat) * EqAt c (sc a x) (sc a x') N) (\ q -> (q.1,scale-at c a x x' q.1 q.2)) h ;
  eq-right (c b : R) (x x' : M) (h : Eq c x x') : Eq (mul c b) x x' =
   TC.map ((N : Nat) * EqAt c x x' N) ((N : Nat) * EqAt (mul c b) x x' N) (\ q -> (q.1,widen-right c b x x' q.1 q.2)) h ;
  eq-left (c b : R) (x x' : M) (h : Eq b x x') : Eq (mul c b) x x' =
   TC.map ((N : Nat) * EqAt b x x' N) ((N : Nat) * EqAt (mul c b) x x' N) (\ q -> (q.1,widen-left c b x x' q.1 q.2)) h ;
  eq-cong (c : R) (x x' y y' : M) (p : Id M x y) (q : Id M x' y') (h : Eq c x x') : Eq c y y' =
   Pr.subst M (\ v -> Eq c y v) x' y' q (Pr.subst M (\ v -> Eq c v x') x y p h) ;
  -- x - mz = x
  sub-mz (x : M) : Id M (sub x E.mz) x = trans (ap (E.madd x) MA.mneg-z) (E.maddZ x) ;

  ---------------------------------------------------------------------
  -- Gr(a; E[1/c]) >= 2, elementwise
  LReg (c : R) (p : Nat) (a : Ps.Fin p -> R) : U l = (x : M) -> ((j : Ps.Fin p) -> Eq c (sc (a j) x) E.mz) -> Eq c x E.mz ;
  LProp (c : R) (p : Nat) (a : Ps.Fin p -> R) (y : Ps.Fin p -> M) : U l = (j k : Ps.Fin p) -> Eq c (sc (a j) (y k)) (sc (a k) (y j)) ;
  LMult (c : R) (p : Nat) (a : Ps.Fin p -> R) (y : Ps.Fin p -> M) : U l =
   (w : M) * (f : Nat) * ((j : Ps.Fin p) -> Eq c (sc (power c f) (y j)) (sc (a j) w)) ;
  LDepth2 (c : R) (p : Nat) (a : Ps.Fin p -> R) : U l =
   LReg c p a * ((y : Ps.Fin p -> M) -> LProp c p a y -> Tr.Trunc[LMult c p a y].carrier) ;

  module Theorem (n : Nat) (s : Ps.Fin n -> R) (d : A.Depth2 (Ps.Fin n) s) (p : Nat) (a : Ps.Fin p -> R)
   (loc : (i : Ps.Fin n) -> LDepth2 (s i) p a) {
   -- x = 0 in every E[1/s_i] gives x = 0
   zero-all (x : M) (h : (i : Ps.Fin n) -> Eq (s i) x E.mz) : Id M x E.mz =
    Tr.Trunc[(i : Ps.Fin n) -> (N : Nat) * EqAt (s i) x E.mz N].induction @l (\ t -> Id M x E.mz) (\ t -> E.setM x E.mz)
     (\ k -> A.RI.regular-powers n s (\ i -> (k i).1) d.1 x tt (\ i -> trans (ap (sc (power (s i) (k i).1)) (sym (sub-mz x))) (k i).2))
     (AffineFinite[l].choice n (\ i -> (N : Nat) * EqAt (s i) x E.mz N) h) ;
   reg : A.Reg (Ps.Fin p) a = \ x u h -> zero-all x (\ i -> (loc i).1 x (\ j -> eq-exact (s i) (sc (a j) x) E.mz (h j))) ;

   module Fam (y : Ps.Fin p -> M) (py : A.Proportional (Ps.Fin p) a y) {
    lprop (i : Ps.Fin n) : LProp (s i) p a y = \ j k -> eq-exact (s i) (sc (a j) (y k)) (sc (a k) (y j)) (py j k) ;
    module WithW (wf : (i : Ps.Fin n) -> LMult (s i) p a y) {
     w (i : Ps.Fin n) : M = (wf i).1 ;
     f (i : Ps.Fin n) : Nat = (wf i).2.1 ;
     P (i : Ps.Fin n) : R = power (s i) (f i) ;
     hw (i : Ps.Fin n) (j : Ps.Fin p) : Eq (s i) (sc (P i) (y j)) (sc (a j) (w i)) = (wf i).2.2 j ;
     -- the fractions w_i / s_i^(f_i) agree on overlaps
     module Compat (i k : Ps.Fin n) {
      c : R = mul (s i) (s k) ;
      t : M = sub (sc (P k) (w i)) (sc (P i) (w k)) ;
      q (j : Ps.Fin p) : M = sc (P k) (sc (P i) (y j)) ;
      first (j : Ps.Fin p) : Eq c (sc (P k) (sc (a j) (w i))) (q j) =
       eq-right (s i) (s k) _ _ (eq-scale (s i) (P k) _ _ (eq-sym (s i) _ _ (hw i j))) ;
      second (j : Ps.Fin p) : Eq c (sc (P i) (sc (a j) (w k))) (q j) =
       eq-left (s i) (s k) _ _ (eq-cong (s k) _ _ _ _ (refl (sc (P i) (sc (a j) (w k)))) (MA.sm-swap (P i) (P k) (y j))
        (eq-scale (s k) (P i) _ _ (eq-sym (s k) _ _ (hw k j)))) ;
      ta (j : Ps.Fin p) : M = sc (P k) (sc (a j) (w i)) ;
      tb (j : Ps.Fin p) : M = sc (P i) (sc (a j) (w k)) ;
      ab (j : Ps.Fin p) : Eq c (ta j) (tb j) = eq-trans c (ta j) (q j) (tb j) (first j) (eq-sym c (tb j) (q j) (second j)) ;
      ek (j : Ps.Fin p) : Id M (sub (ta j) (tb j)) (sub (sc (a j) t) E.mz) =
       trans (sym (trans (MA.sm-sub (a j) (sc (P k) (w i)) (sc (P i) (w k)))
          (Ps.cong2 M sub _ _ _ _ (MA.sm-swap (a j) (P k) (w i)) (MA.sm-swap (a j) (P i) (w k)))))
        (sym (sub-mz (sc (a j) t))) ;
      at (j : Ps.Fin p) : Eq c (sc (a j) t) E.mz =
       Pr.subst M (\ v -> Tr.Trunc[(N : Nat) * G.Kills c v N].carrier) (sub (ta j) (tb j)) (sub (sc (a j) t) E.mz) (ek j) (ab j) ;
      -- note: Eq c u v is c^N (u - v) = 0; with v = mz this is c^N u = 0 up to sub-mz
      module Exps (N : Ps.Fin p -> Nat) (hN : (j : Ps.Fin p) -> EqAt c (sc (a j) t) E.mz (N j)) {
       Q : Nat = GL.natsum p N ;
       kill-j (j : Ps.Fin p) : G.Kills c (sc (a j) t) Q =
        trans (ap (sc (power c Q)) (sym (sub-mz (sc (a j) t))))
         (G.kills-sum c (sub (sc (a j) t) E.mz) p N j (hN j)) ;
       x : M = sc (power (s k) Q) t ;
       local (j : Ps.Fin p) : Eq (s i) (sc (a j) x) E.mz =
        Tr.Trunc[(K : Nat) * EqAt (s i) (sc (a j) x) E.mz K].inc (Q,trans (ap (sc (power (s i) Q)) (sub-mz (sc (a j) x))) (calc M {
         sc (power (s i) Q) (sc (a j) (sc (power (s k) Q) t)) =< ap (sc (power (s i) Q)) (MA.sm-swap (a j) (power (s k) Q) t) >
         sc (power (s i) Q) (sc (power (s k) Q) (sc (a j) t)) =< G.sc2 (power (s i) Q) (power (s k) Q) (sc (a j) t) >
         sc (mul (power (s i) Q) (power (s k) Q)) (sc (a j) t) =< ap (\ r -> sc r (sc (a j) t)) (sym (Pow.power-mul (s i) (s k) Q)) >
         sc (power c Q) (sc (a j) t) =< kill-j j > E.mz })) ;
       x-zero : Eq (s i) x E.mz = (loc i).1 x local ;
       -- s_i^K s_k^Q t = 0 gives (s_i s_k)^(K+Q) t = 0
       ring (K : Nat) : Id R (power c (plus K Q))
         (mul (mul (power (s i) Q) (power (s k) K)) (mul (power (s i) K) (power (s k) Q))) = calc R {
        power c (plus K Q) =< Pow.power-mul (s i) (s k) (plus K Q) > mul (power (s i) (plus K Q)) (power (s k) (plus K Q))
         =< Ps.cong2 R mul _ _ _ _ (trans (Pow.power-add (s i) K Q) (mulC (power (s i) K) (power (s i) Q))) (Pow.power-add (s k) K Q) >
        mul (mul (power (s i) Q) (power (s i) K)) (mul (power (s k) K) (power (s k) Q))
         =< L.mul-four (power (s i) Q) (power (s i) K) (power (s k) K) (power (s k) Q) >
        mul (mul (power (s i) Q) (power (s k) K)) (mul (power (s i) K) (power (s k) Q)) } ;
       from (K : Nat) (h : EqAt (s i) x E.mz K) : (N' : Nat) * GL.At[E].CompatAt (s i) (s k) (f i) (f k) (w i) (w k) N' =
        (plus K Q,trans (ap (\ r -> sc r t) (ring K))
         (G.kill-mul (mul (power (s i) Q) (power (s k) K)) (mul (power (s i) K) (power (s k) Q)) t
          (trans (sym (G.sc2 (power (s i) K) (power (s k) Q) t)) (trans (ap (sc (power (s i) K)) (sym (sub-mz x))) h)))) ;
       result : G.Compat (s i) (s k) (f i) (f k) (w i) (w k) =
        TC.map ((K : Nat) * EqAt (s i) x E.mz K) ((N' : Nat) * GL.At[E].CompatAt (s i) (s k) (f i) (f k) (w i) (w k) N')
         (\ r -> from r.1 r.2) x-zero ;
      } ;
      result : G.Compat (s i) (s k) (f i) (f k) (w i) (w k) =
       Tr.Trunc[(j : Ps.Fin p) -> (N : Nat) * EqAt c (sc (a j) t) E.mz N].induction @l
        (\ u -> G.Compat (s i) (s k) (f i) (f k) (w i) (w k))
        (\ u -> Tr.Trunc[(N' : Nat) * GL.At[E].CompatAt (s i) (s k) (f i) (f k) (w i) (w k) N'].proposition)
        (\ ch -> Exps[\ j -> (ch j).1,\ j -> (ch j).2].result)
        (AffineFinite[l].choice p (\ j -> (N : Nat) * EqAt c (sc (a j) t) E.mz N) at) ;
     } ;
     glued : G.Glue[n,s,d,f,w,\ i k -> Compat[i,k].result].Sol = G.Glue[n,s,d,f,w,\ i k -> Compat[i,k].result].result ;
     e : M = glued.1 ;
     -- y_j = a_j e
     module Final (j : Ps.Fin p) {
      z0 : M = sub (y j) (sc (a j) e) ;
      loc-eq (i : Ps.Fin n) : Eq (s i) (sc (P i) (y j)) (sc (P i) (sc (a j) e)) =
       eq-trans (s i) (sc (P i) (y j)) (sc (a j) (w i)) (sc (P i) (sc (a j) e)) (hw i j)
        (eq-cong (s i) (sc (a j) (w i)) (sc (a j) (sc (P i) e)) (sc (a j) (w i)) (sc (P i) (sc (a j) e))
         (refl (sc (a j) (w i))) (MA.sm-swap (a j) (P i) e)
         (eq-scale (s i) (a j) (w i) (sc (P i) e) (eq-sym (s i) (sc (P i) e) (w i) (glued.2 i)))) ;
      zero-at (i : Ps.Fin n) (K : Nat) (h : EqAt (s i) (sc (P i) (y j)) (sc (P i) (sc (a j) e)) K) : EqAt (s i) z0 E.mz (plus K (f i)) =
       trans (ap (sc (power (s i) (plus K (f i)))) (sub-mz z0)) (calc M {
        sc (power (s i) (plus K (f i))) z0 =< ap (\ r -> sc r z0) (Pow.power-add (s i) K (f i)) >
        sc (mul (power (s i) K) (P i)) z0 =< sym (G.sc2 (power (s i) K) (P i) z0) >
        sc (power (s i) K) (sc (P i) z0) =< ap (sc (power (s i) K)) (MA.sm-sub (P i) (y j) (sc (a j) e)) >
        sc (power (s i) K) (sub (sc (P i) (y j)) (sc (P i) (sc (a j) e))) =< h > E.mz }) ;
      zero (i : Ps.Fin n) : Eq (s i) z0 E.mz =
       TC.map ((K : Nat) * EqAt (s i) (sc (P i) (y j)) (sc (P i) (sc (a j) e)) K) ((N : Nat) * EqAt (s i) z0 E.mz N)
        (\ r -> (plus r.1 (f i),zero-at i r.1 r.2)) (loc-eq i) ;
      result : Id M (y j) (sc (a j) e) = MA.sub-zero (y j) (sc (a j) e) (zero-all z0 zero) ;
     } ;
     result : A.Multiple (Ps.Fin p) a y = (e,\ j -> Final[j].result) ;
    } ;
    result : Tr.Trunc[A.Multiple (Ps.Fin p) a y].carrier =
     Tr.Trunc[(i : Ps.Fin n) -> LMult (s i) p a y].induction @l
      (\ u -> Tr.Trunc[A.Multiple (Ps.Fin p) a y].carrier) (\ u -> Tr.Trunc[A.Multiple (Ps.Fin p) a y].proposition)
      (\ wf -> Tr.Trunc[A.Multiple (Ps.Fin p) a y].inc WithW[wf].result)
      (AffineFinite[l].choice n (\ i -> LMult (s i) p a y) (\ i -> (loc i).2 y (lprop i))) ;
   } ;
   result : A.Depth2 (Ps.Fin p) a = (reg,\ y py -> Fam[y,py].result) ;
  } ;
 } ;
} ;
