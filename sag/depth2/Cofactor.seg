-- Cofactor symmetry, A adj(A) = det A . I, and Cramer's rule for existence.
-- Matrices are lists of columns (exterior/Determinant): A k i is the entry
-- in column k and row i, A[i <- b] replaces column i (Adjugate.repl), and
-- adj(A)_ki = det A[k <- e_i] (Adjugate.adj).
--
-- (clear) Let Z = Z(A, i, k) be A with column i replaced by e_k and the
-- other entries of row k replaced by 0.  Then A[i <- e_k] E = Z for the
-- elementary matrix E = I + e_i w^T (WiebeMatrices.emat), w_l = -A_lk for
-- l /= i and w_i = 0: the column l /= i of the product is a_l - A_lk e_k.
-- So det A[i <- e_k] = det Z (det E = 1, WiebeMatrices.det-emat).
-- (symmetry) Z(A^T, k, i) = Z(A, i, k)^T, entry by entry, hence
-- det A^T[k <- e_i] = det Z(A, i, k)^T = det Z(A, i, k) = det A[i <- e_k].
-- (adj-right) (A adj A)_ji = sum_t det A[t <- e_j] A_ti
-- = sum_t (A^T)_it det A^T[j <- e_t] = (adj(A^T) A^T)_ij = det A . delta
-- (Adjugate.adj-mul for A^T, det A^T = det A).
-- (cramer) sum_k det B[k <- a] b_k = det B . a: the vector of the
-- det B[k <- a] is adj(B) a (column linearity), and B (adj(B) a) =
-- (B adj B) a = det B . a.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module ADJ = Adjugate[l].Over[Rg,setR] ;
 module TP = ExteriorTranspose[l].Over[Rg,setR] ;
 module DK = DeterminantTrick[l].Over[Rg,setR] ;
 module WM = WiebeMatrices[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 -- A[i <- e_k]
 rk (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) : DT.Mat n = ADJ.repl n n A i (D.delta n k) ;
 rk-at (n : Nat) (A : DT.Mat n) (i k j : Ps.Fin n) : Id R (rk n A i k i j) (D.delta n k j) =
  ap (\ v -> v j) (ADJ.repl-at n n A i (D.delta n k)) ;
 rk-off (n : Nat) (A : DT.Mat n) (i k l j : Ps.Fin n) (ne : Not (Id (Ps.Fin n) l i)) : Id R (rk n A i k l j) (A l j) =
  ap (\ v -> v j) (ADJ.repl-off n n A i (D.delta n k) l ne) ;

 ---------------------------------------------------------------------
 -- Z(A, i, k), entry (l, j), from the two decisions l = i and j = k
 zin (n : Nat) (A : DT.Mat n) (k l j : Ps.Fin n) : ADJ.Dec n j k -> R = split {
  inl q -> z ; inr nq -> A l j } ;
 zgen (n : Nat) (A : DT.Mat n) (i k l j : Ps.Fin n) : ADJ.Dec n l i -> ADJ.Dec n j k -> R = split {
  inl p -> \ d -> D.delta n k j ; inr np -> zin n A k l j } ;
 zmat (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) : DT.Mat n = \ l j -> zgen n A i k l j (ADJ.dec-fin n l i) (ADJ.dec-fin n j k) ;

 -- the elementary matrix
 wsel (n : Nat) (A : DT.Mat n) (i k l : Ps.Fin n) : ADJ.Dec n l i -> R = split { inl p -> z ; inr np -> neg (A l k) } ;
 wv (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) : AL.Vec n = \ l -> wsel n A i k l (ADJ.dec-fin n l i) ;
 wsel-at (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) : (d : ADJ.Dec n i i) -> Id R (wsel n A i k i d) z = split {
  inl p -> refl z ; inr np -> efq (np (refl i)) } ;
 emat (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) : DT.Mat n = WM.emat n i (wv n A i k) ;

 -- column l of A[i <- e_k] E is column l plus w_l times column i
 col (n : Nat) (M : DT.Mat n) (i : Ps.Fin n) (w : AL.Vec n) (l j : Ps.Fin n) :
  Id R (DT.mmul n M (WM.emat n i w) l j) (add (M l j) (mul (w l) (M i j))) =
  trans (ap (\ v -> DT.act n M v j) (F.funext (Ps.Fin n) (\ t -> R) (WM.emat n i w l)
          (AL.vadd n (D.delta n l) (AL.vscale n (w l) (D.delta n i))) (\ t -> ap (add (D.delta n l t)) (mulC (D.delta n i t) (w l)))))
   (trans (DT.act-add n M (D.delta n l) (AL.vscale n (w l) (D.delta n i)) j)
    (trans (ap (add (DT.act n M (D.delta n l) j)) (DT.act-scale n M (w l) (D.delta n i) j))
     (ap2 (DT.act-delta n M l j) (ap (mul (w l)) (DT.act-delta n M i j)))))
  where { ap2 {a a1 b b1 : R} (p : Id R a a1) (q : Id R b b1) : Id R (add a b) (add a1 b1) = Ps.cong2 R add a a1 b b1 p q ; } ;
 -- the entries, case by case
 clear-off (n : Nat) (A : DT.Mat n) (i k l j : Ps.Fin n) (np : Not (Id (Ps.Fin n) l i)) : (d : ADJ.Dec n j k) ->
  Id R (add (A l j) (mul (neg (A l k)) (D.delta n k j))) (zin n A k l j d) = split {
  inl q -> Pr.subst (Ps.Fin n) (\ j1 -> Id R (add (A l j1) (mul (neg (A l k)) (D.delta n k j1))) z) k j (sym q)
   (trans (ap (add (A l k)) (trans (ap (mul (neg (A l k))) (D.delta-diag n k)) (mulO (neg (A l k))))) (addN (A l k))) ;
  inr nq -> trans (ap (add (A l j)) (trans (ap (mul (neg (A l k))) (D.delta-off n k j (\ e -> nq (sym e)))) (L.mul-zero (neg (A l k)))))
   (addZ (A l j)) } ;
 clear-at (n : Nat) (A : DT.Mat n) (i k l j : Ps.Fin n) : (d1 : ADJ.Dec n l i) (d2 : ADJ.Dec n j k) ->
  Id R (add (rk n A i k l j) (mul (wsel n A i k l d1) (rk n A i k i j))) (zgen n A i k l j d1 d2) = split {
  inl p -> \ d2 -> trans (ap (add (rk n A i k l j)) (L.zero-mul (rk n A i k i j)))
   (trans (addZ (rk n A i k l j)) (trans (ap (\ l1 -> rk n A i k l1 j) p) (rk-at n A i k j))) ;
  inr np -> \ d2 -> trans (Ps.cong2 R add _ _ _ _ (rk-off n A i k l j np) (ap (mul (neg (A l k))) (rk-at n A i k j)))
   (clear-off n A i k l j np d2) } ;
 clear (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) (l j : Ps.Fin n) :
  Id R (DT.mmul n (rk n A i k) (emat n A i k) l j) (zmat n A i k l j) =
  trans (col n (rk n A i k) i (wv n A i k) l j) (clear-at n A i k l j (ADJ.dec-fin n l i) (ADJ.dec-fin n j k)) ;
 mat-eq (n : Nat) (A B : DT.Mat n) (h : (l j : Ps.Fin n) -> Id R (A l j) (B l j)) : Id (DT.Mat n) A B =
  F.funext (Ps.Fin n) (\ l -> AL.Vec n) A B (\ l -> F.funext (Ps.Fin n) (\ j -> R) (A l) (B l) (h l)) ;
 -- det A[i <- e_k] = det Z(A, i, k)
 det-clear (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) : Id R (det n (rk n A i k)) (det n (zmat n A i k)) = calc R {
  det n (rk n A i k) =< sym (mulO (det n (rk n A i k))) > mul (det n (rk n A i k)) o
   =< ap (mul (det n (rk n A i k))) (sym (WM.det-emat n i (wv n A i k) (wsel-at n A i k (ADJ.dec-fin n i i)))) >
  mul (det n (rk n A i k)) (det n (emat n A i k)) =< sym (DT.det-mul n (rk n A i k) (emat n A i k)) >
  det n (DT.mmul n (rk n A i k) (emat n A i k)) =< ap (det n) (mat-eq n _ _ (clear n A i k)) > det n (zmat n A i k) } ;

 ---------------------------------------------------------------------
 -- Z(A^T, k, i) = Z(A, i, k)^T
 tr-in (n : Nat) (A : DT.Mat n) (i k l j : Ps.Fin n) (np : Not (Id (Ps.Fin n) l k)) : (d2 : ADJ.Dec n j i) ->
  Id R (zin n (TP.transpose n A) i l j d2) (zgen n A i k j l d2 (inr np)) = split {
  inl q -> sym (D.delta-off n k l (\ e -> np (sym e))) ;
  inr nq -> TP.transpose-value n A l j } ;
 tr-at (n : Nat) (A : DT.Mat n) (i k l j : Ps.Fin n) (p : Id (Ps.Fin n) l k) : (d2 : ADJ.Dec n j i) ->
  Id R (D.delta n i j) (zgen n A i k j l d2 (inl p)) = split {
  inl q -> trans (ap (D.delta n i) q) (trans (D.delta-diag n i) (sym (trans (ap (D.delta n k) p) (D.delta-diag n k)))) ;
  inr nq -> D.delta-off n i j (\ e -> nq (sym e)) } ;
 tr-gen (n : Nat) (A : DT.Mat n) (i k l j : Ps.Fin n) : (d1 : ADJ.Dec n l k) (d2 : ADJ.Dec n j i) ->
  Id R (zgen n (TP.transpose n A) k i l j d1 d2) (zgen n A i k j l d2 d1) = split {
  inl p -> \ d2 -> tr-at n A i k l j p d2 ;
  inr np -> \ d2 -> tr-in n A i k l j np d2 } ;
 zmat-transpose (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) :
  Id (DT.Mat n) (zmat n (TP.transpose n A) k i) (TP.transpose n (zmat n A i k)) =
  mat-eq n _ _ (\ l j -> trans (tr-gen n A i k l j (ADJ.dec-fin n l k) (ADJ.dec-fin n j i))
   (sym (TP.transpose-value n (zmat n A i k) l j))) ;
 -- det A^T[k <- e_i] = det A[i <- e_k]
 symmetry (n : Nat) (A : DT.Mat n) (i k : Ps.Fin n) : Id R (det n (rk n (TP.transpose n A) k i)) (det n (rk n A i k)) = calc R {
  det n (rk n (TP.transpose n A) k i) =< det-clear n (TP.transpose n A) k i > det n (zmat n (TP.transpose n A) k i)
   =< ap (det n) (zmat-transpose n A i k) > det n (TP.transpose n (zmat n A i k))
   =< sym (TP.det-transpose n (zmat n A i k)) > det n (zmat n A i k)
   =< sym (det-clear n A i k) > det n (rk n A i k) } ;

 ---------------------------------------------------------------------
 -- A adj(A) = det A . I
 adj-right-entry (n : Nat) (A : DT.Mat n) (j i : Ps.Fin n) :
  Id R (DT.mmul n A (ADJ.adj n A) j i) (mul (det n A) (D.delta n j i)) = calc R {
  DT.mmul n A (ADJ.adj n A) j i
   =< S.sum-cong n (\ t -> mul (det n (rk n A t j)) (A t i)) (\ t -> mul (TP.transpose n A i t) (det n (rk n (TP.transpose n A) j t)))
       (\ t -> trans (mulC (det n (rk n A t j)) (A t i))
         (Ps.cong2 R mul _ _ _ _ (sym (TP.transpose-value n A i t)) (sym (symmetry n A t j)))) >
  DT.mmul n (ADJ.adj n (TP.transpose n A)) (TP.transpose n A) i j
   =< ADJ.adj-mul n (TP.transpose n A) i j > mul (det n (TP.transpose n A)) (D.delta n i j)
   =< Ps.cong2 R mul _ _ _ _ (sym (TP.det-transpose n A)) (D.delta-sym n i j) > mul (det n A) (D.delta n j i) } ;
 adj-right (n : Nat) (A : DT.Mat n) : Id (DT.Mat n) (DT.mmul n A (ADJ.adj n A)) (\ j i -> mul (det n A) (D.delta n j i)) =
  mat-eq n _ _ (adj-right-entry n A) ;

 -- Cramer: sum_k det B[k <- a] B_k = det B . a
 cramer-vec (n : Nat) (B : DT.Mat n) (a : AL.Vec n) : AL.Vec n = \ k -> det n (ADJ.repl n n B k a) ;
 cramer-adj (n : Nat) (B : DT.Mat n) (a : AL.Vec n) (k : Ps.Fin n) : Id R (DT.act n (ADJ.adj n B) a k) (cramer-vec n B a k) =
  sym (ADJ.form-expand n (ADJ.colform n B k) (ADJ.colform-lin n B k) a) ;
 cramer (n : Nat) (B : DT.Mat n) (a : AL.Vec n) (i : Ps.Fin n) : Id R (DT.act n B (cramer-vec n B a) i) (mul (det n B) (a i)) = calc R {
  DT.act n B (cramer-vec n B a) i
   =< ap (\ v -> DT.act n B v i) (sym (F.funext (Ps.Fin n) (\ k -> R) (DT.act n (ADJ.adj n B) a) (cramer-vec n B a) (cramer-adj n B a))) >
  DT.act n B (DT.act n (ADJ.adj n B) a) i =< sym (DK.act-mmul n B (ADJ.adj n B) a i) >
  DT.act n (DT.mmul n B (ADJ.adj n B)) a i =< ap (\ N -> DT.act n N a i) (adj-right n B) >
  DT.act n (\ j t -> mul (det n B) (D.delta n j t)) a i =< DK.act-scalar n (det n B) a i > mul (det n B) (a i) } ;
} ;
