-- The rows of a linear system against its maximal minors (for livre B-7.5).
--
-- The system: U X = V, U with n columns u_j in R^m (m equations), V in
-- R^m; (U X)_r = sum_j X_j u_j(r) (lin).  For a list of rows
-- rho : Fin n -> Fin m, U_rho is the square matrix of these rows,
-- delta_rho = det U_rho, and X_rho = (det U_rho[j <- V_rho])_j (Cramer's
-- numerators).  For sigma : Fin (n + 1) -> Fin m, W_sigma is the square
-- matrix of the rows sigma of W = [U | V] (an (n + 1)-minor of W).
--
-- row: for every rho and r, with sigma = (rho, r),
--     det W_sigma + (U X_rho)_r = delta_rho V_r.
-- Row[rho,r,v] is the same for any last column v in place of V_sigma:
--     det N[last <- v] + sum_j det U_rho[j <- v'] u_j(r) = delta_rho v_last
-- (v' the first n entries of v), used with v = e_t for unknowns in a module
-- (SharpeModule).
-- Proof.  Let N = W_sigma with its last column replaced by e_last.  Then
-- det N = delta_rho (WiebeMatrices.BlockDet), and Cramer for N and
-- v = V_sigma (Cofactor.cramer), at the last coordinate, reads
--     det N[last <- v] . 1 + sum_j det N[j <- v] u_j(r) = det N . V_r.
-- N[last <- v] = W_sigma, and N[j <- v] has last column e_last, so its
-- determinant is that of its top left block (BlockDet again), which is
-- U_rho[j <- V_rho]: det N[j <- v] = X_rho,j.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module ADJ = Adjugate[l].Over[Rg,setR] ;
 module WM = WiebeMatrices[l].Over[Rg,setR] ;
 module CF = Cofactor[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 -- restricting the rows commutes with replacing a column
 restrict-at (n : Nat) (Uc : Ps.Fin n -> AL.Vec (suc n)) (j : Ps.Fin n) (v : AL.Vec (suc n)) (i t : Ps.Fin n) :
  ADJ.Dec n i j -> Id R (ADJ.repl (suc n) n Uc j v i (inl t)) (ADJ.repl n n (\ a b -> Uc a (inl b)) j (\ b -> v (inl b)) i t) = split {
  inl p -> Pr.subst (Ps.Fin n) (\ i1 -> Id R (ADJ.repl (suc n) n Uc j v i1 (inl t)) (ADJ.repl n n (\ a b -> Uc a (inl b)) j (\ b -> v (inl b)) i1 t))
   j i (sym p) (trans (ap (\ w -> w (inl t)) (ADJ.repl-at (suc n) n Uc j v))
    (sym (ap (\ w -> w t) (ADJ.repl-at n n (\ a b -> Uc a (inl b)) j (\ b -> v (inl b)))))) ;
  inr ne -> trans (ap (\ w -> w (inl t)) (ADJ.repl-off (suc n) n Uc j v i ne))
   (sym (ap (\ w -> w t) (ADJ.repl-off n n (\ a b -> Uc a (inl b)) j (\ b -> v (inl b)) i ne))) } ;

 module Sys (n m : Nat) (u : Ps.Fin n -> AL.Vec m) (V : AL.Vec m) {
  wcol : Ps.Fin (suc n) -> AL.Vec m = split { inl j -> u j ; inr t -> V } ;
  Wmat (sigma : Ps.Fin (suc n) -> Ps.Fin m) : DT.Mat (suc n) = \ c t -> wcol c (sigma t) ;
  Urho (rho : Ps.Fin n -> Ps.Fin m) : DT.Mat n = \ j t -> u j (rho t) ;
  delta (rho : Ps.Fin n -> Ps.Fin m) : R = det n (Urho rho) ;
  X (rho : Ps.Fin n -> Ps.Fin m) : AL.Vec n = CF.cramer-vec n (Urho rho) (\ t -> V (rho t)) ;
  ext (rho : Ps.Fin n -> Ps.Fin m) (r : Ps.Fin m) : Ps.Fin (suc n) -> Ps.Fin m = split { inl t -> rho t ; inr s -> r } ;
  lin (x : AL.Vec n) (r : Ps.Fin m) : R = S.sum n (\ j -> mul (x j) (u j r)) ;

  -- for any last column v
  module Row (rho : Ps.Fin n -> Ps.Fin m) (r : Ps.Fin m) (v : AL.Vec (suc n)) {
   W0 : DT.Mat (suc n) = Wmat (ext rho r) ;
   N : DT.Mat (suc n) = ADJ.repl (suc n) (suc n) W0 (inr tt) (D.delta (suc n) (inr tt)) ;
   det-N : Id R (det (suc n) N) (delta rho) = WM.BlockDet[n,W0].result ;
   -- the column replacement in U_rho by the first n entries of v
   vr (j : Ps.Fin n) : R = det n (ADJ.repl n n (Urho rho) j (\ t -> v (inl t))) ;
   -- N[j <- v] is (W_sigma[j <- v])[last <- e_last]
   module Col (j : Ps.Fin n) {
    Wj : DT.Mat (suc n) = ADJ.repl (suc n) (suc n) W0 (inl j) v ;
    same : (c : Ps.Fin (suc n)) -> Id (AL.Vec (suc n)) (ADJ.repl (suc n) (suc n) N (inl j) v c)
      (ADJ.repl (suc n) (suc n) Wj (inr tt) (D.delta (suc n) (inr tt)) c) = split {
     inl i -> refl (ADJ.repl (suc n) n (\ a -> W0 (inl a)) j v i) ; inr s -> refl (D.delta (suc n) (inr tt)) } ;
    block : Id (DT.Mat n) (WM.Block n Wj) (ADJ.repl n n (Urho rho) j (\ t -> v (inl t))) =
     CF.mat-eq n _ _ (\ i t -> restrict-at n (\ a -> W0 (inl a)) j v i t (ADJ.dec-fin n i j)) ;
    result : Id R (det (suc n) (ADJ.repl (suc n) (suc n) N (inl j) v)) (vr j) = calc R {
     det (suc n) (ADJ.repl (suc n) (suc n) N (inl j) v)
      =< ap (det (suc n)) (F.funext (Ps.Fin (suc n)) (\ c -> AL.Vec (suc n)) _ _ same) >
     det (suc n) (ADJ.repl (suc n) (suc n) Wj (inr tt) (D.delta (suc n) (inr tt)))
      =< WM.BlockDet[n,Wj].result > det n (WM.Block n Wj) =< ap (det n) block > vr j } ;
   } ;
   -- Cramer for N at the last coordinate
   cr : Id R (DT.act (suc n) N (CF.cramer-vec (suc n) N v) (inr tt)) (mul (det (suc n) N) (v (inr tt))) =
    CF.cramer (suc n) N v (inr tt) ;
   result : Id R (add (det (suc n) (ADJ.repl (suc n) (suc n) N (inr tt) v)) (S.sum n (\ k -> mul (vr k) (u k r))))
     (mul (delta rho) (v (inr tt))) = calc R {
    add (det (suc n) (ADJ.repl (suc n) (suc n) N (inr tt) v)) (S.sum n (\ k -> mul (vr k) (u k r)))
     =< Ps.cong2 R add _ _ _ _
         (trans (sym (mulO (det (suc n) (ADJ.repl (suc n) (suc n) N (inr tt) v))))
          (ap (mul (det (suc n) (ADJ.repl (suc n) (suc n) N (inr tt) v))) (sym (D.delta-diag (suc n) (inr tt)))))
         (S.sum-cong n (\ k -> mul (vr k) (u k r)) (\ k -> mul (CF.cramer-vec (suc n) N v (inl k)) (N (inl k) (inr tt)))
          (\ k -> ap (\ t -> mul t (u k r)) (sym (Col[k].result)))) >
    DT.act (suc n) N (CF.cramer-vec (suc n) N v) (inr tt) =< cr >
    mul (det (suc n) N) (v (inr tt)) =< ap (\ t -> mul t (v (inr tt))) det-N > mul (delta rho) (v (inr tt)) } ;
  } ;
  -- with v the last column of W_sigma, N[last <- v] = W_sigma
  module RowW (rho : Ps.Fin n -> Ps.Fin m) (r : Ps.Fin m) {
   module RV = Row[rho,r,Wmat (ext rho r) (inr tt)] ;
   back : (c : Ps.Fin (suc n)) -> Id (AL.Vec (suc n)) (ADJ.repl (suc n) (suc n) RV.N (inr tt) (RV.W0 (inr tt)) c) (RV.W0 c) = split {
    inl j -> refl (RV.W0 (inl j)) ; inr s -> refl (RV.W0 (inr tt)) } ;
   back-mat : Id (DT.Mat (suc n)) (ADJ.repl (suc n) (suc n) RV.N (inr tt) (RV.W0 (inr tt))) RV.W0 =
    F.funext (Ps.Fin (suc n)) (\ c -> AL.Vec (suc n)) _ _ back ;
   result : Id R (add (det (suc n) RV.W0) (lin (X rho) r)) (mul (delta rho) (V r)) =
    trans (ap (\ t -> add (det (suc n) t) (lin (X rho) r)) (sym back-mat)) RV.result ;
  } ;
  -- det W_(rho, r) + (U X_rho)_r = delta_rho V_r
  row (rho : Ps.Fin n -> Ps.Fin m) (r : Ps.Fin m) : Id R (add (det (suc n) (Wmat (ext rho r))) (lin (X rho) r)) (mul (delta rho) (V r)) =
   RowW[rho,r].result ;
 } ;
} ;
