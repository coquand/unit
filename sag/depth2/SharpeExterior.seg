-- livre B-7.5 (Sharpe, Grade and the theory of linear equations, 1977), in
-- the exterior algebra of R^m.  The system: n columns u_j in R^m, a
-- right-hand side V in F^m (F a module), unknowns x in F^n,
-- (U x)_r = sum_j u_j(r) x_j (lin).
--
-- omega = u_1 ... u_n; its coordinates c_I (I a subset of the m rows) are
-- the n-minors of U, so Gr(Delta_n(U); F) >= 2 is Depth2 of the family c.
-- The (n+1)-minors of [U | V] are the coordinates of omega V:
-- mu_I = sum_t [omega e_t]_I V_t in F.  Cramer's numerators are
-- lambda_k(I) = sum_t [P_k(e_t)]_I V_t, P_k(b) = u_1 ... b ... u_n (b in
-- place k); for F = R, lambda_k(I) = [P_k(V)]_I.
--
-- (pair) sum_t [P_k(e_t)]_I (U x)_t = c_I x_k: b |-> [P_k(b)]_I is linear
-- and P_k(u_j) = delta_kj omega (repeated column).  So U x = U y gives
-- c_I x_k = c_I y_k for all I, and x = y when the c_I are regular (inj).
-- (key) (U lambda(I))_r = c_I V_r + sum_I' k_I' mu_I', from
-- WedgeContraction.General at b = e_t (sum_j u_j(r) P_j(b) = b_r omega -
-- alpha(c_r(omega b))) and the expansion of the linear form
-- y |-> [-alpha(c_r(y))]_I in the coordinates of y.
-- (theorem) If all mu_I = 0: U lambda(I) = c_I V.  Then
-- c_I' lambda(I) and c_I lambda(I') have the same image c_I c_I' V, so they
-- are equal (inj): each family (lambda_k(I))_I is proportional to c, and
-- Depth2 gives x_k with lambda_k(I) = c_I x_k.  Then c_I (U x)_r =
-- (U lambda(I))_r = c_I V_r, so U x = V; unique by inj.
-- (necessary) If U x = V then mu_I = sum_j [omega u_j]_I x_j = 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module C = ExteriorCoordinates[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module AD = Adjugate[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module WC = WedgeContraction[l].Over[Rg,setR] ;
 module DD = Depth[l].Over[Rg,setR] ;
 open ExteriorModel[l].Over[Rg] ;

 module At (E : DD.MO.Module) {
  module A = DD.At[E] ;
  module MA = A.MA ;
  M : U l = A.M ;
  sc (a : R) (x : M) : M = A.sc a x ;

  ---------------------------------------------------------------------
  -- finite sums in F, over Fin k and over subsets
  msum : (n : Nat) -> (Ps.Fin n -> M) -> M = split {
   zero -> \ f -> E.mz ; suc n | r -> \ f -> E.madd (f (inr tt)) (r (\ i -> f (inl i))) } ;
  msum-cong : (n : Nat) (f g : Ps.Fin n -> M) -> ((i : Ps.Fin n) -> Id M (f i) (g i)) -> Id M (msum n f) (msum n g) = split {
   zero -> \ f g h -> refl E.mz ;
   suc n | r -> \ f g h -> Ps.cong2 M E.madd _ _ _ _ (h (inr tt)) (r (\ i -> f (inl i)) (\ i -> g (inl i)) (\ i -> h (inl i))) } ;
  msum-zero : (n : Nat) -> Id M (msum n (\ i -> E.mz)) E.mz = split {
   zero -> refl E.mz ; suc n | r -> trans (ap (E.madd E.mz) r) (E.maddZ E.mz) } ;
  msum-add : (n : Nat) (f g : Ps.Fin n -> M) -> Id M (msum n (\ i -> E.madd (f i) (g i))) (E.madd (msum n f) (msum n g)) = split {
   zero -> \ f g -> sym (E.maddZ E.mz) ;
   suc n | r -> \ f g -> trans (ap (E.madd (E.madd (f (inr tt)) (g (inr tt)))) (r (\ i -> f (inl i)) (\ i -> g (inl i))))
    (MA.swap4 (f (inr tt)) (g (inr tt)) (msum n (\ i -> f (inl i))) (msum n (\ i -> g (inl i)))) } ;
  msum-sm (a : R) : (n : Nat) (f : Ps.Fin n -> M) -> Id M (sc a (msum n f)) (msum n (\ i -> sc a (f i))) = split {
   zero -> \ f -> MA.sm-zr a ;
   suc n | r -> \ f -> trans (E.smD a (f (inr tt)) (msum n (\ i -> f (inl i)))) (ap (E.madd (sc a (f (inr tt)))) (r (\ i -> f (inl i)))) } ;
  sum-sc (w : M) : (n : Nat) (f : Ps.Fin n -> R) -> Id M (sc (S.sum n f) w) (msum n (\ i -> sc (f i) w)) = split {
   zero -> \ f -> MA.sm-zl w ;
   suc n | r -> \ f -> trans (E.smE (f (inr tt)) (S.sum n (\ i -> f (inl i))) w) (ap (E.madd (sc (f (inr tt)) w)) (r (\ i -> f (inl i)))) } ;
  exchange (k : Nat) : (n : Nat) (g : Ps.Fin n -> Ps.Fin k -> M) ->
   Id M (msum n (\ t -> msum k (\ j -> g t j))) (msum k (\ j -> msum n (\ t -> g t j))) = split {
   zero -> \ g -> sym (msum-zero k) ;
   suc n | r -> \ g -> trans (ap (E.madd (msum k (\ j -> g (inr tt) j))) (r (\ t j -> g (inl t) j)))
    (sym (msum-add k (\ j -> g (inr tt) j) (\ j -> msum n (\ t -> g (inl t) j)))) } ;
  msum-delta : (n : Nat) (i : Ps.Fin n) (x : Ps.Fin n -> M) -> Id M (msum n (\ k -> sc (D.delta n i k) (x k))) (x i) = split {
   zero -> \ i x -> efq i ;
   suc n | r -> split {
    inl a -> \ x -> trans (ap (\ v -> E.madd v (msum n (\ k -> sc (D.delta n a k) (x (inl k))))) (MA.sm-zl (x (inr tt))))
     (trans (MA.mzl (msum n (\ k -> sc (D.delta n a k) (x (inl k))))) (r a (\ k -> x (inl k)))) ;
    inr s -> \ x -> trans (Ps.cong2 M E.madd _ _ _ _ (E.smO (x (inr tt)))
      (trans (msum-cong n (\ k -> sc z (x (inl k))) (\ k -> E.mz) (\ k -> MA.sm-zl (x (inl k)))) (msum-zero n)))
     (trans (E.maddZ (x (inr tt))) (ap (\ t -> x (inr t)) (MnSums[l].top-eq tt s))) } } ;
  -- sum_j (delta_ij c) x_j = c x_i
  msum-delta-scaled (n : Nat) (c : R) (i : Ps.Fin n) (x : Ps.Fin n -> M) :
   Id M (msum n (\ j -> sc (mul (D.delta n i j) c) (x j))) (sc c (x i)) = calc M {
   msum n (\ j -> sc (mul (D.delta n i j) c) (x j))
    =< msum-cong n (\ j -> sc (mul (D.delta n i j) c) (x j)) (\ j -> sc c (sc (D.delta n i j) (x j)))
        (\ j -> trans (ap (\ t -> sc t (x j)) (mulC (D.delta n i j) c)) (sym (E.smA c (D.delta n i j) (x j)))) >
   msum n (\ j -> sc c (sc (D.delta n i j) (x j))) =< sym (msum-sm c n (\ j -> sc (D.delta n i j) (x j))) >
   sc c (msum n (\ j -> sc (D.delta n i j) (x j))) =< ap (sc c) (msum-delta n i x) > sc c (x i) } ;
  -- sums over subsets
  module SM = C.Sum[M,E.madd] ;
  SM-zero : (k : Nat) -> Id M (SM.sum k (\ i -> E.mz)) E.mz = split {
   zero -> refl E.mz ; suc k | r -> trans (Ps.cong2 M E.madd _ _ _ _ r r) (E.maddZ E.mz) } ;
  SM-add : (k : Nat) (f g : C.Index k -> M) -> Id M (SM.sum k (\ i -> E.madd (f i) (g i))) (E.madd (SM.sum k f) (SM.sum k g)) = split {
   zero -> \ f g -> refl (E.madd (f tt) (g tt)) ;
   suc k | r -> \ f g -> trans (Ps.cong2 M E.madd _ _ _ _ (r (\ i -> f (inl i)) (\ i -> g (inl i))) (r (\ i -> f (inr i)) (\ i -> g (inr i))))
    (MA.swap4 (SM.sum k (\ i -> f (inl i))) (SM.sum k (\ i -> g (inl i))) (SM.sum k (\ i -> f (inr i))) (SM.sum k (\ i -> g (inr i)))) } ;
  SM-exchange (k : Nat) : (n : Nat) (h : Ps.Fin n -> C.Index k -> M) ->
   Id M (msum n (\ t -> SM.sum k (h t))) (SM.sum k (\ i -> msum n (\ t -> h t i))) = split {
   zero -> \ h -> sym (SM-zero k) ;
   suc n | r -> \ h -> trans (ap (E.madd (SM.sum k (h (inr tt)))) (r (\ t -> h (inl t))))
    (sym (SM-add k (h (inr tt)) (\ i -> msum n (\ t -> h (inl t) i)))) } ;
  -- (sum_i g_i) w = sum_i g_i w, over subsets
  sm-sumR (w : M) (k : Nat) (g : C.Index k -> R) : Id M (sc (CO.S.sum k g) w) (SM.sum k (\ i -> sc (g i) w)) =
   C.SumMap[R,M,add,E.madd,\ a -> sc a w,\ a b -> E.smE a b w].map k g ;

  ---------------------------------------------------------------------
  module System (n m : Nat) (u : Ps.Fin n -> AL.Vec m) (V : Ps.Fin m -> M) {
   omega : Ext m = WC.omega m n u ;
   c (I : C.Index m) : R = CO.coeff m omega I ;
   e (t : Ps.Fin m) : AL.Vec m = D.delta m t ;
   -- b |-> [P_k(b)]_I and b |-> [omega b]_I, linear forms
   fP (I : C.Index m) (k : Ps.Fin n) (b : AL.Vec m) : R = CO.coeff m (WC.P m n u k b) I ;
   fP-lin (I : C.Index m) (k : Ps.Fin n) : AD.LinForm m (fP I k) =
    (\ a b -> trans (ap (\ y -> CO.coeff m y I) (AD.repl-add m n u k a b)) (CO.coeff-add m (WC.P m n u k a) (WC.P m n u k b) I),
     \ a b -> trans (ap (\ y -> CO.coeff m y I) (AD.repl-scale m n u k a b)) (CO.coeff-scale m a (WC.P m n u k b) I)) ;
   fW (I : C.Index m) (b : AL.Vec m) : R = CO.coeff m (emul m omega (gen m b)) I ;
   fW-lin (I : C.Index m) : AD.LinForm m (fW I) =
    (\ a b -> trans (ap (\ y -> CO.coeff m (emul m omega y) I) (EA.gen-add m a b))
               (trans (ap (\ y -> CO.coeff m y I) (EA.dist-left m omega (gen m a) (gen m b)))
                (CO.coeff-add m (emul m omega (gen m a)) (emul m omega (gen m b)) I)),
     \ a b -> trans (ap (\ y -> CO.coeff m (emul m omega y) I) (EA.gen-scale m a b))
               (trans (ap (\ y -> CO.coeff m y I) (EA.scale-mul-right m a omega (gen m b)))
                (CO.coeff-scale m a (emul m omega (gen m b)) I))) ;
   -- Cramer's numerators, the (n+1)-minors, the system
   lam (I : C.Index m) (k : Ps.Fin n) : M = msum m (\ t -> sc (fP I k (e t)) (V t)) ;
   mu (I : C.Index m) : M = msum m (\ t -> sc (fW I (e t)) (V t)) ;
   lin (x : Ps.Fin n -> M) (r : Ps.Fin m) : M = msum n (\ j -> sc (u j r) (x j)) ;
   Minors : U l = (I : C.Index m) -> Id M (mu I) E.mz ;
   Solves (x : Ps.Fin n -> M) : U l = (r : Ps.Fin m) -> Id M (lin x r) (V r) ;
   Sol : U l = (x : Ps.Fin n -> M) * Solves x ;

   -- a linear form f on R^m: sum_t f(e_t) (U x)_t = sum_j f(u_j) x_j
   transfer (f : AL.Vec m -> R) (hf : AD.LinForm m f) (x : Ps.Fin n -> M) :
    Id M (msum m (\ t -> sc (f (e t)) (lin x t))) (msum n (\ j -> sc (f (u j)) (x j))) = calc M {
    msum m (\ t -> sc (f (e t)) (lin x t))
     =< msum-cong m (\ t -> sc (f (e t)) (lin x t)) (\ t -> msum n (\ j -> sc (mul (u j t) (f (e t))) (x j)))
         (\ t -> trans (msum-sm (f (e t)) n (\ j -> sc (u j t) (x j)))
           (msum-cong n (\ j -> sc (f (e t)) (sc (u j t) (x j))) (\ j -> sc (mul (u j t) (f (e t))) (x j))
            (\ j -> trans (E.smA (f (e t)) (u j t) (x j)) (ap (\ a -> sc a (x j)) (mulC (f (e t)) (u j t)))))) >
    msum m (\ t -> msum n (\ j -> sc (mul (u j t) (f (e t))) (x j)))
     =< exchange n m (\ t j -> sc (mul (u j t) (f (e t))) (x j)) >
    msum n (\ j -> msum m (\ t -> sc (mul (u j t) (f (e t))) (x j)))
     =< msum-cong n (\ j -> msum m (\ t -> sc (mul (u j t) (f (e t))) (x j))) (\ j -> sc (f (u j)) (x j))
         (\ j -> trans (sym (sum-sc (x j) m (\ t -> mul (u j t) (f (e t)))))
          (ap (\ a -> sc a (x j)) (sym (AD.form-expand m f hf (u j))))) >
    msum n (\ j -> sc (f (u j)) (x j)) } ;

   -- (pair) P_k(u_j) = delta_kj omega, coefficientwise
   column (I : C.Index m) (k j : Ps.Fin n) : AD.Dec n k j -> Id R (fP I k (u j)) (mul (D.delta n k j) (c I)) = split {
    inl p -> idJ (Ps.Fin n) k (\ j1 p1 -> Id R (fP I k (u j1)) (mul (D.delta n k j1) (c I)))
      (trans (ap (\ y -> CO.coeff m y I) (DT-self k))
       (sym (trans (ap (\ y -> mul y (c I)) (D.delta-diag n k)) (L.one-left (c I))))) j p ;
    inr ne -> trans (ap (\ y -> CO.coeff m y I)
        (AD.repeat-zero m n (AD.repl m n u k (u j)) j k (\ p -> ne (sym p))
         (trans (AD.repl-off m n u k (u j) j (\ p -> ne (sym p))) (sym (AD.repl-at m n u k (u j))))))
      (trans (CO.coeff-zero m I) (sym (trans (ap (\ y -> mul y (c I)) (D.delta-off n k j ne)) (L.zero-mul (c I))))) }
   where {
    DT-self (k : Ps.Fin n) : Id (Ext m) (WC.P m n u k (u k)) omega =
     Determinant[l].Over[Rg,setR].eprod-cong m n (\ j -> gen m (AD.repl m n u k (u k) j)) (\ j -> gen m (u j))
      (\ j -> ap (gen m) (AD.repl-self m n u k j)) ;
   } ;
   pair (I : C.Index m) (k : Ps.Fin n) (x : Ps.Fin n -> M) : Id M (msum m (\ t -> sc (fP I k (e t)) (lin x t))) (sc (c I) (x k)) =
    trans (transfer (fP I k) (fP-lin I k) x)
     (trans (msum-cong n (\ j -> sc (fP I k (u j)) (x j)) (\ j -> sc (mul (D.delta n k j) (c I)) (x j))
       (\ j -> ap (\ a -> sc a (x j)) (column I k j (AD.dec-fin n k j))))
      (msum-delta-scaled n (c I) k x)) ;
   module Inj (rg : A.Reg (C.Index m) c) (x y : Ps.Fin n -> M) (h : (r : Ps.Fin m) -> Id M (lin x r) (lin y r)) {
    at (k : Ps.Fin n) (I : C.Index m) : Id M (sc (c I) (x k)) (sc (c I) (y k)) =
     trans (sym (pair I k x)) (trans (msum-cong m (\ t -> sc (fP I k (e t)) (lin x t)) (\ t -> sc (fP I k (e t)) (lin y t))
      (\ t -> ap (sc (fP I k (e t))) (h t))) (pair I k y)) ;
    result (k : Ps.Fin n) : Id M (x k) (y k) = A.reg-eq (C.Index m) c rg (x k) (y k) (at k) ;
   } ;
   sol-prop (rg : A.Reg (C.Index m) c) : Pr.isProp Sol = \ a b ->
    Pr.Sigma-eq (Ps.Fin n -> M) Solves a.1 b.1 a.2 b.2
     (F.funext (Ps.Fin n) (\ k -> M) a.1 b.1 (Inj[rg,a.1,b.1,\ r -> trans (a.2 r) (sym (b.2 r))].result))
     (F.isProp-Pi (Ps.Fin m) (\ r -> Id M (lin b.1 r) (V r)) (\ r -> E.setM (lin b.1 r) (V r))) ;

   -- (key) the error term y |-> [-alpha(c_r(y))]_I
   module Key (I : C.Index m) (r : Ps.Fin m) {
    Kf (y : Ext m) : R = CO.coeff m (eneg m (alpha m (VC.contract m (e r) y))) I ;
    K-add (y y' : Ext m) : Id R (Kf (eadd m y y')) (add (Kf y) (Kf y')) =
     trans (ap (\ w -> CO.coeff m (eneg m (alpha m w)) I) (VC.contract-add m (e r) y y'))
      (trans (ap (\ w -> CO.coeff m (eneg m w) I) (EA.alpha-add m (VC.contract m (e r) y) (VC.contract m (e r) y')))
       (trans (ap (\ w -> CO.coeff m w I) (EA.At[m].G.neg-add (alpha m (VC.contract m (e r) y)) (alpha m (VC.contract m (e r) y'))))
        (CO.coeff-add m (eneg m (alpha m (VC.contract m (e r) y))) (eneg m (alpha m (VC.contract m (e r) y'))) I))) ;
    K-scale (a : R) (y : Ext m) : Id R (Kf (escale m a y)) (mul a (Kf y)) =
     trans (ap (\ w -> CO.coeff m (eneg m (alpha m w)) I) (VC.contract-scale m (e r) a y))
      (trans (ap (\ w -> CO.coeff m (eneg m w) I) (EA.alpha-scale m a (VC.contract m (e r) y)))
       (trans (ap (\ w -> CO.coeff m w I) (sym (EA.escale-neg m a (alpha m (VC.contract m (e r) y)))))
        (CO.coeff-scale m a (eneg m (alpha m (VC.contract m (e r) y))) I))) ;
    k (I' : C.Index m) : R = Kf (CO.basis m I') ;
    expand (y : Ext m) : Id R (Kf y) (CO.S.sum m (\ I' -> mul (CO.coeff m y I') (k I'))) =
     trans (ap Kf (CO.vector-expansion m y))
      (trans (C.SumMap[Ext m,R,eadd m,add,Kf,K-add].map m (\ I' -> escale m (CO.coeff m y I') (CO.basis m I')))
       (CO.S.cong m (\ I' -> Kf (escale m (CO.coeff m y I') (CO.basis m I'))) (\ I' -> mul (CO.coeff m y I') (k I'))
        (\ I' -> K-scale (CO.coeff m y I') (CO.basis m I')))) ;
    -- sum_j u_j(r) [P_j(b)]_I = b_r c_I + Kf(omega b)
    general (b : AL.Vec m) : Id R (S.sum n (\ j -> mul (u j r) (fP I j b))) (add (mul (b r) (c I)) (Kf (emul m omega (gen m b)))) = calc R {
     S.sum n (\ j -> mul (u j r) (fP I j b))
      =< S.sum-cong n (\ j -> mul (u j r) (fP I j b)) (\ j -> CO.coeff m (escale m (VC.vdot m (e r) (u j)) (WC.P m n u j b)) I)
          (\ j -> sym (trans (CO.coeff-scale m (VC.vdot m (e r) (u j)) (WC.P m n u j b) I)
                        (ap (\ a -> mul a (fP I j b)) (WC.vdot-delta m r (u j))))) >
     S.sum n (\ j -> CO.coeff m (escale m (VC.vdot m (e r) (u j)) (WC.P m n u j b)) I)
      =< sym (WC.coeff-esum m I n (\ j -> escale m (VC.vdot m (e r) (u j)) (WC.P m n u j b))) >
     CO.coeff m (WC.Sigma m n u (e r) b) I =< ap (\ y -> CO.coeff m y I) (WC.General[m,n,u,e r,b].result) >
     CO.coeff m (eadd m (escale m (VC.vdot m (e r) b) omega) (eneg m (alpha m (VC.contract m (e r) (emul m omega (gen m b)))))) I
      =< CO.coeff-add m (escale m (VC.vdot m (e r) b) omega) (eneg m (alpha m (VC.contract m (e r) (emul m omega (gen m b))))) I >
     add (CO.coeff m (escale m (VC.vdot m (e r) b) omega) I) (Kf (emul m omega (gen m b)))
      =< ap (\ a -> add a (Kf (emul m omega (gen m b))))
          (trans (CO.coeff-scale m (VC.vdot m (e r) b) omega I) (ap (\ a -> mul a (c I)) (WC.vdot-delta m r b))) >
     add (mul (b r) (c I)) (Kf (emul m omega (gen m b))) } ;
    -- the error, as a combination of the (n+1)-minors
    error : Id M (msum m (\ t -> sc (Kf (emul m omega (gen m (e t)))) (V t))) (SM.sum m (\ I' -> sc (k I') (mu I'))) = calc M {
     msum m (\ t -> sc (Kf (emul m omega (gen m (e t)))) (V t))
      =< msum-cong m (\ t -> sc (Kf (emul m omega (gen m (e t)))) (V t)) (\ t -> SM.sum m (\ I' -> sc (mul (fW I' (e t)) (k I')) (V t)))
          (\ t -> trans (ap (\ a -> sc a (V t)) (expand (emul m omega (gen m (e t)))))
                   (sm-sumR (V t) m (\ I' -> mul (fW I' (e t)) (k I')))) >
     msum m (\ t -> SM.sum m (\ I' -> sc (mul (fW I' (e t)) (k I')) (V t)))
      =< SM-exchange m m (\ t I' -> sc (mul (fW I' (e t)) (k I')) (V t)) >
     SM.sum m (\ I' -> msum m (\ t -> sc (mul (fW I' (e t)) (k I')) (V t)))
      =< SM.cong m (\ I' -> msum m (\ t -> sc (mul (fW I' (e t)) (k I')) (V t))) (\ I' -> sc (k I') (mu I')) (\ I' -> trans (msum-cong m (\ t -> sc (mul (fW I' (e t)) (k I')) (V t)) (\ t -> sc (k I') (sc (fW I' (e t)) (V t)))
                                       (\ t -> trans (ap (\ a -> sc a (V t)) (mulC (fW I' (e t)) (k I'))) (sym (E.smA (k I') (fW I' (e t)) (V t)))))
                              (sym (msum-sm (k I') m (\ t -> sc (fW I' (e t)) (V t))))) >
     SM.sum m (\ I' -> sc (k I') (mu I')) } ;
    -- (U lambda(I))_r = c_I V_r + error
    result : Id M (lin (\ j -> lam I j) r) (E.madd (sc (c I) (V r)) (SM.sum m (\ I' -> sc (k I') (mu I')))) = calc M {
     lin (\ j -> lam I j) r
      =< msum-cong n (\ j -> sc (u j r) (lam I j)) (\ j -> msum m (\ t -> sc (mul (u j r) (fP I j (e t))) (V t)))
          (\ j -> trans (msum-sm (u j r) m (\ t -> sc (fP I j (e t)) (V t)))
                   (msum-cong m (\ t -> sc (u j r) (sc (fP I j (e t)) (V t))) (\ t -> sc (mul (u j r) (fP I j (e t))) (V t))
                     (\ t -> E.smA (u j r) (fP I j (e t)) (V t)))) >
     msum n (\ j -> msum m (\ t -> sc (mul (u j r) (fP I j (e t))) (V t)))
      =< sym (exchange n m (\ t j -> sc (mul (u j r) (fP I j (e t))) (V t))) >
     msum m (\ t -> msum n (\ j -> sc (mul (u j r) (fP I j (e t))) (V t)))
      =< msum-cong m (\ t -> msum n (\ j -> sc (mul (u j r) (fP I j (e t))) (V t)))
          (\ t -> E.madd (sc (mul (e t r) (c I)) (V t)) (sc (Kf (emul m omega (gen m (e t)))) (V t)))
          (\ t -> trans (sym (sum-sc (V t) n (\ j -> mul (u j r) (fP I j (e t)))))
                   (trans (ap (\ a -> sc a (V t)) (general (e t)))
                    (E.smE (mul (e t r) (c I)) (Kf (emul m omega (gen m (e t)))) (V t)))) >
     msum m (\ t -> E.madd (sc (mul (e t r) (c I)) (V t)) (sc (Kf (emul m omega (gen m (e t)))) (V t)))
      =< msum-add m (\ t -> sc (mul (e t r) (c I)) (V t)) (\ t -> sc (Kf (emul m omega (gen m (e t)))) (V t)) >
     E.madd (msum m (\ t -> sc (mul (e t r) (c I)) (V t))) (msum m (\ t -> sc (Kf (emul m omega (gen m (e t)))) (V t)))
      =< Ps.cong2 M E.madd _ _ _ _
          (trans (msum-cong m (\ t -> sc (mul (e t r) (c I)) (V t)) (\ t -> sc (mul (D.delta m r t) (c I)) (V t))
                    (\ t -> ap (\ a -> sc (mul a (c I)) (V t)) (D.delta-sym m t r)))
                 (msum-delta-scaled m (c I) r V))
          error >
     E.madd (sc (c I) (V r)) (SM.sum m (\ I' -> sc (k I') (mu I'))) } ;
   } ;

   module Exists (mn : Minors) (dp : A.Depth2 (C.Index m) c) {
    cramer (I : C.Index m) (r : Ps.Fin m) : Id M (lin (\ j -> lam I j) r) (sc (c I) (V r)) = calc M {
     lin (\ j -> lam I j) r =< Key[I,r].result >
     E.madd (sc (c I) (V r)) (SM.sum m (\ I' -> sc (Key[I,r].k I') (mu I')))
      =< ap (E.madd (sc (c I) (V r))) (trans (SM.cong m (\ I' -> sc (Key[I,r].k I') (mu I')) (\ I' -> E.mz) (\ I' -> trans (ap (sc (Key[I,r].k I')) (mn I')) (MA.sm-zr (Key[I,r].k I'))))
                                         (SM-zero m)) >
     E.madd (sc (c I) (V r)) E.mz =< E.maddZ (sc (c I) (V r)) > sc (c I) (V r) } ;
    lin-scale (a : R) (x : Ps.Fin n -> M) (r : Ps.Fin m) : Id M (lin (\ j -> sc a (x j)) r) (sc a (lin x r)) =
     trans (msum-cong n (\ j -> sc (u j r) (sc a (x j))) (\ j -> sc a (sc (u j r) (x j))) (\ j -> MA.sm-swap (u j r) a (x j)))
      (sym (msum-sm a n (\ j -> sc (u j r) (x j)))) ;
    cross (I I' : C.Index m) (r : Ps.Fin m) :
     Id M (lin (\ j -> sc (c I') (lam I j)) r) (lin (\ j -> sc (c I) (lam I' j)) r) = calc M {
     lin (\ j -> sc (c I') (lam I j)) r =< lin-scale (c I') (\ j -> lam I j) r >
     sc (c I') (lin (\ j -> lam I j) r) =< ap (sc (c I')) (cramer I r) >
     sc (c I') (sc (c I) (V r)) =< MA.sm-swap (c I') (c I) (V r) >
     sc (c I) (sc (c I') (V r)) =< ap (sc (c I)) (sym (cramer I' r)) >
     sc (c I) (lin (\ j -> lam I' j) r) =< sym (lin-scale (c I) (\ j -> lam I' j) r) >
     lin (\ j -> sc (c I) (lam I' j)) r } ;
    prop (k : Ps.Fin n) : A.Proportional (C.Index m) c (\ I -> lam I k) = \ I I' ->
     Inj[dp.1,\ j -> sc (c I) (lam I' j),\ j -> sc (c I') (lam I j),\ r -> sym (cross I I' r)].result k ;
    mult (k : Ps.Fin n) : A.Multiple (C.Index m) c (\ I -> lam I k) = A.multiple (C.Index m) c dp (\ I -> lam I k) (prop k) ;
    x : Ps.Fin n -> M = \ k -> (mult k).1 ;
    solves (r : Ps.Fin m) : Id M (lin x r) (V r) = A.reg-eq (C.Index m) c dp.1 (lin x r) (V r) (\ I -> calc M {
     sc (c I) (lin x r) =< sym (lin-scale (c I) x r) >
     lin (\ j -> sc (c I) (x j)) r =< msum-cong n (\ j -> sc (u j r) (sc (c I) (x j))) (\ j -> sc (u j r) (lam I j))
                                        (\ j -> ap (sc (u j r)) (sym ((mult j).2 I))) >
     lin (\ j -> lam I j) r =< cramer I r > sc (c I) (V r) }) ;
    result : Sol = (x,solves) ;
   } ;
   -- livre B-7.5
   theorem (mn : Minors) (dp : A.Depth2 (C.Index m) c) : Sol = Exists[mn,dp].result ;

   -- (necessary) a solution makes the (n+1)-minors vanish
   -- u with u_j adjoined at the end: omega u_j
   adjoin (j : Ps.Fin n) : Ps.Fin (suc n) -> AL.Vec m = split { inl i -> u i ; inr s -> u j } ;
   omega-col (I : C.Index m) (j : Ps.Fin n) : Id R (fW I (u j)) z =
    trans (ap (\ y -> CO.coeff m y I) (AD.repeat-zero m (suc n) (adjoin j) (inl j) (inr tt) (\ p -> AD.inl-inr {Ps.Fin n} p) (refl (u j))))
     (CO.coeff-zero m I) ;
   necessary (s : Sol) : Minors = \ I -> calc M {
    mu I =< msum-cong m (\ t -> sc (fW I (e t)) (V t)) (\ t -> sc (fW I (e t)) (lin s.1 t)) (\ t -> ap (sc (fW I (e t))) (sym (s.2 t))) >
    msum m (\ t -> sc (fW I (e t)) (lin s.1 t)) =< transfer (fW I) (fW-lin I) s.1 >
    msum n (\ j -> sc (fW I (u j)) (s.1 j)) =< msum-cong n (\ j -> sc (fW I (u j)) (s.1 j)) (\ j -> E.mz)
                                                (\ j -> trans (ap (\ a -> sc a (s.1 j)) (omega-col I j)) (MA.sm-zl (s.1 j))) >
    msum n (\ j -> E.mz) =< msum-zero n > E.mz } ;
  } ;
 } ;

 ---------------------------------------------------------------------
 -- F = R: the hypothesis is u_1 ... u_n V = 0, and lambda_k(I) = [P_k(V)]_I
 module InRing (n m : Nat) (u : Ps.Fin n -> AL.Vec m) (V : AL.Vec m) {
  module AR = At[DD.MO.regular] ;
  module SY = AR.System[n,m,u,V] ;
  -- sums in the ring as a module are ring sums
  msum-sum : (k : Nat) (f : Ps.Fin k -> R) -> Id R (AR.msum k f) (S.sum k f) = split {
   zero -> \ f -> refl z ; suc k | r -> \ f -> ap (add (f (inr tt))) (r (\ i -> f (inl i))) } ;
  lam-ring (I : C.Index m) (k : Ps.Fin n) : Id R (SY.lam I k) (CO.coeff m (WC.P m n u k V) I) =
   trans (msum-sum m (\ t -> mul (SY.fP I k (SY.e t)) (V t))) (trans (S.sum-cong m (\ t -> mul (SY.fP I k (SY.e t)) (V t)) (\ t -> mul (V t) (SY.fP I k (SY.e t))) (\ t -> mulC (SY.fP I k (SY.e t)) (V t)))
    (sym (AD.form-expand m (SY.fP I k) (SY.fP-lin I k) V))) ;
  minors (h : Id (Ext m) (emul m (WC.omega m n u) (gen m V)) (ezero m)) : SY.Minors = \ I ->
   trans (msum-sum m (\ t -> mul (SY.fW I (SY.e t)) (V t))) (trans (S.sum-cong m (\ t -> mul (SY.fW I (SY.e t)) (V t)) (\ t -> mul (V t) (SY.fW I (SY.e t))) (\ t -> mulC (SY.fW I (SY.e t)) (V t)))
    (trans (sym (AD.form-expand m (SY.fW I) (SY.fW-lin I) V)) (trans (ap (\ y -> CO.coeff m y I) h) (CO.coeff-zero m I)))) ;
  -- if u_1 ... u_n V = 0 and Gr(Delta_n(U)) >= 2, U x = V has a unique solution
  theorem (h : Id (Ext m) (emul m (WC.omega m n u) (gen m V)) (ezero m)) (dp : AR.A.Depth2 (C.Index m) SY.c) : SY.Sol =
   SY.theorem (minors h) dp ;
 } ;
} ;
