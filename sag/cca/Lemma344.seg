-- CCA Lemma 3.4.4 (i), (ii): overtly discrete types and BG (G an overtly
-- discrete group) are I-local: const : X -> (I -> X) is an equivalence.
--
-- (i)  If every map I -> X is constant, const is an equivalence (inverse:
--      evaluation at a point of I); Thm 3.4.3 (i).
-- (ii) BG = the G-torsors (worker B, em/GTorsor).  For torsors X, Y,
--      X = Y is the set Hom X Y of equivariant maps (fundamental theorem of
--      identity types, em/FundThm, from GTor.contr), and the carrier of a
--      torsor is overtly discrete (a point p gives G = Y, a |-> a . p); so a
--      map I -> (X = Y) is constant pointwise in Hom X Y, hence constant,
--      and X = Y is I-local by (i).  Then (ByIds, general) ap const :
--      (X = Y) -> (const X = const Y) is homotopic to the equivalence
--      p |-> funext (i |-> p), so const is an embedding; its fibres are
--      propositions (Groupoid.emb-fib-prop), merely inhabited by Thm 3.4.3
--      (ii) (H^1(I, G) = 0), so const is an equivalence.
level l ;
open Base ; open Prelude[l] ; open Paths[l+] ; open Group[l] ; open ODisc[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module P1 = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module F1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module SA = StoneAxioms[l,l] ;
module L27 = Lemma27[l] ;
module In = Interval[l] ;
module GT = GTorsor[l] ;
module Bi = Bijection[l] ;

-- I-local types (at level l+, which contains the types of level l)
isLocal (Z : U l+) : U l+ = P1.isEquiv Z (In.I -> Z) (\ z i -> z) ;
point : In.I = In.cs (\ n -> false) ;
module FromConstant (Z : U l+) (c : (f : In.I -> Z) (i j : In.I) -> Id Z (f i) (f j)) {
  ev (f : In.I -> Z) : Z = f point ;
  local : isLocal Z = P1.qinv Z (In.I -> Z) (\ z i -> z) ev
    (\ f -> F1.funext In.I (\ i -> Z) (\ i -> f point) f (\ i -> c f point i)) (\ z -> refl z) ;
} ;
-- an equivalence up to homotopy
homotopy-equiv (A B : U l+) (f g : A -> B) (h : (a : A) -> Id B (f a) (g a)) (eg : P1.isEquiv A B g) : P1.isEquiv A B f =
  P1.qinv A B f eg.sec (\ b -> transH (h (eg.sec b)) (eg.sec-eq b)) (\ a -> transH (apH eg.sec (h a)) (P1.sec-ret A B g eg a)) ;
-- an embedding with merely inhabited fibres is an equivalence
module EmbOnto (A B : U l+) (f : A -> B) (apE : (a a' : A) -> P1.isEquiv (Id A a a') (Id B (f a) (f a')) (P1.ap A B f a a'))
  (onto : (b : B) -> T1.Trunc[(a : A) * Id B (f a) b].carrier) {
  fib-prop (b : B) : P1.isProp ((a : A) * Id B (f a) b) = Groupoid[l+].emb-fib-prop A B f apE b ;
  pt (b : B) : (a : A) * Id B (f a) b = TC1.rec ((a : A) * Id B (f a) b) @(l+) ((a : A) * Id B (f a) b) (fib-prop b) (\ w -> w) (onto b) ;
  equiv : P1.isEquiv A B f = P1.qinv A B f (\ b -> (pt b).1) (\ b -> (pt b).2)
    (\ a -> P1.ap ((a1 : A) * Id B (f a1) (f a)) A (\ w -> w.1) (pt (f a)) (a, refl (f a)) (fib-prop (f a) (pt (f a)) (a, refl (f a)))) ;
} ;

-- Z is I-local if its identity types are and every map I -> Z is merely
-- constant: ap const is then homotopic to the equivalence
-- p |-> funext (i |-> p), so const is an embedding, with merely inhabited
-- fibres.
module ByIds (Z : U l+) (idl : (x y : Z) -> isLocal (Id Z x y))
  (onto : (f : In.I -> Z) -> T1.Trunc[(z : Z) * Id (In.I -> Z) (\ i -> z) f].carrier) {
  funext-equiv (x y : Z) : P1.Equiv (In.I -> Id Z x y) (Id (In.I -> Z) (\ i -> x) (\ i -> y)) =
    (F1.funext In.I (\ i -> Z) (\ i -> x) (\ i -> y),
     P1.qinv (In.I -> Id Z x y) (Id (In.I -> Z) (\ i -> x) (\ i -> y)) (F1.funext In.I (\ i -> Z) (\ i -> x) (\ i -> y))
       (P1.happly In.I (\ i -> Z) (\ i -> x) (\ i -> y)) (F1.funext-happly In.I (\ i -> Z) (\ i -> x) (\ i -> y))
       (F1.happly-funext In.I (\ i -> Z) (\ i -> x) (\ i -> y))) ;
  e (x y : Z) : P1.Equiv (Id Z x y) (Id (In.I -> Z) (\ i -> x) (\ i -> y)) =
    Equivalences[l+].compose (Id Z x y) (In.I -> Id Z x y) (Id (In.I -> Z) (\ i -> x) (\ i -> y)) ((\ p i -> p), idl x y) (funext-equiv x y) ;
  ap-e (x : Z) : (y : Z) (p : Id Z x y) -> Id (Id (In.I -> Z) (\ i -> x) (\ i -> y)) (P1.ap Z (In.I -> Z) (\ z i -> z) x y p) ((e x y).1 p) =
    \ y p -> idJ Z x (\ y1 p1 -> Id (Id (In.I -> Z) (\ i -> x) (\ i -> y1)) (P1.ap Z (In.I -> Z) (\ z i -> z) x y1 p1) ((e x y1).1 p1))
      (P1.sym (Id (In.I -> Z) (\ i -> x) (\ i -> x)) ((e x x).1 (refl x)) (refl (\ i -> x))
        (F1.funext-happly In.I (\ i -> Z) (\ i -> x) (\ i -> x) (refl (\ i -> x)))) y p ;
  apE (x y : Z) : P1.isEquiv (Id Z x y) (Id (In.I -> Z) (\ i -> x) (\ i -> y)) (P1.ap Z (In.I -> Z) (\ z i -> z) x y) =
    homotopy-equiv (Id Z x y) (Id (In.I -> Z) (\ i -> x) (\ i -> y)) (P1.ap Z (In.I -> Z) (\ z i -> z) x y) (e x y).1
      (ap-e x y) (e x y).2 ;
  local : isLocal Z = EmbOnto[Z, In.I -> Z, \ z i -> z, apE, onto].equiv ;
} ;

module Over (ax : SA.Assumptions) {
  module L341 = Lemma341[l].Over[ax] ;
  -- (i)
  odisc-local (X : U l) (oX : isODisc X) : isLocal X = FromConstant[X, \ f i j -> L341.thm343i X oX f i j].local ;

  -- (ii)
  module BGLocal (Gr : Grp) (oG : isODisc Gr.G) {
    module T = GT.GTor[Gr] ;
    -- carriers of torsors are overtly discrete
    carrier-odisc (Y : T.Tor) : isODisc Y.1 =
      TC.rec Y.1 @(l+) (isODisc Y.1) T1.Trunc[Pres[Y.1]].proposition
        (\ p -> L27.odisc-equiv Y.1 Gr.G (Bi.inverse Gr.G Y.1 T.HE[T.triv, Y, T.pt-hom Y p].equiv) oG) Y.2.2.2.2.2.2 ;
    -- identity types of BG are I-local
    module Ids (X Y : T.Tor) {
      module FT1 = FundThm[l+].FT[T.Tor, X, \ Y1 -> T.Hom X Y1, T.idhom X, T.contr X] ;
      hom-eq (f g : T.Hom X Y) (e : (t : X.1) -> Id Y.1 (f.1 t) (g.1 t)) : Id (T.Hom X Y) f g =
        Sigma-eq (X.1 -> Y.1) (T.EqvH X Y) f.1 g.1 f.2 g.2 (F.funext X.1 (\ t -> Y.1) f.1 g.1 e) (T.eqvh-prop X Y g.1) ;
      constant (f : In.I -> Id T.Tor X Y) (i j : In.I) : Id (Id T.Tor X Y) (f i) (f j) =
        transH (P1.sym (Id T.Tor X Y) (FT1.un Y (FT1.tr Y (f i))) (f i) (FT1.un-tr Y (f i)))
          (transH (P1.ap (T.Hom X Y) (Id T.Tor X Y) (FT1.un Y) (FT1.tr Y (f i)) (FT1.tr Y (f j))
             (hom-eq (FT1.tr Y (f i)) (FT1.tr Y (f j)) (\ t -> L341.thm343i Y.1 (carrier-odisc Y) (\ k -> (FT1.tr Y (f k)).1 t) i j)))
            (FT1.un-tr Y (f j))) ;
      local : isLocal (Id T.Tor X Y) = FromConstant[Id T.Tor X Y, constant].local ;
    } ;
    -- every map I -> BG is merely constant (Thm 3.4.3 (ii))
    onto (f : In.I -> T.Tor) : T1.Trunc[(X : T.Tor) * Id (In.I -> T.Tor) (\ i -> X) f].carrier =
      TC1.map ((x : In.I) -> Id T.Tor (f x) T.triv) ((X : T.Tor) * Id (In.I -> T.Tor) (\ i -> X) f)
        (\ h -> (T.triv, F1.funext In.I (\ i -> T.Tor) (\ i -> T.triv) f (\ x -> P1.sym T.Tor (f x) T.triv (h x))))
        (Thm343ii[l].Over[ax].thm343ii Gr oG f) ;
    local : isLocal T.Tor = ByIds[T.Tor, \ X Y -> Ids[X, Y].local, onto].local ;
  } ;
  bg-local (Gr : Grp) (oG : isODisc Gr.G) : isLocal (GT.GTor[Gr].Tor) = BGLocal[Gr, oG].local ;
} ;
