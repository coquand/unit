-- CCA Prop. 2.1.4 (i), (iv), (v), in the forms used below.
--
--  (i) Finite sets are Stone: X is the limit of the constant sequence
--      X <- X <- .. (a compatible sequence is constant, equal to its value
--      at 0), which is Stone (SSD Lemma 3.2).
--  (iv) Local choice for Stone spaces (SSD Axiom 3): from S = Sp B, move
--      the family to Sp B and the chosen cover Sp C ->> Sp B back to S.
--  (v) A map c : S -> N on a Stone space is bounded (SSD Lemma 3.6): S is
--      a limit of finite sets E n (SSD Lemma 3.1); c factors through some
--      E n (SSD Cor. 3.7, onto), and a map on a finite set is bounded.
-- With CCA Lemma 2.1.5 (SSD Cor. 4.4).
-- (ii) is SSD Theorem 4.18 (Thm418.thm418) and Lemma 3.10; stated here for
-- fibres and binary products.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module P = Presented[l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module Fi = Finite[l] ;
module FCl = FiniteClosure[l] ;
module DCh = DependentChoice[l] ;
module Eq = Equivalences[l] ;

-- the constant sequence on X, and its limit
module Constant (X : U l) (sX : isSet X) {
  E (n : Nat) : U l = X ;
  p (n : Nat) (x : X) : X = x ;
  Lim : U l = DCh.Lim E p ;
  const (x : X) : Lim = (\ n -> x, \ n -> refl x) ;
  -- a compatible sequence is constant
  value : (z : Lim) (n : Nat) -> Id X (z.1 n) (z.1 zero) = \ z -> split {
    zero -> refl (z.1 zero) ;
    suc n | r -> transH (z.2 n) r } ;
  const-value (z : Lim) : Id Lim (const (z.1 zero)) z =
    Sigma-eq ((n : Nat) -> X) (\ x -> (n : Nat) -> Id X (x (suc n)) (x n))
      (\ n -> z.1 zero) z.1 (\ n -> refl (z.1 zero)) z.2
      (F.funext Nat (\ n -> X) (\ n -> z.1 zero) z.1 (\ n -> symH (value z n)))
      (F.isProp-Pi Nat (\ n -> Id X (z.1 (suc n)) (z.1 n)) (\ n -> sX (z.1 (suc n)) (z.1 n))) ;
  equiv : Equiv X Lim = (const, qinv X Lim const (\ z -> z.1 zero) const-value (\ x -> refl x)) ;
} ;

-- isStone is invariant under equivalence
stone-equiv (X Y : U l) (e : Equiv X Y) (sY : PF.isStone Y) : PF.isStone X =
  TC1.map (PF.StoneW Y) (PF.StoneW X) (\ w -> (w.1, Eq.compose X Y (P.Sp w.1.1) e w.2)) sY ;

-- the data of local choice over S
record Cover (S : U l) (A : S -> U l) {
  T : U l ;
  stone : PF.isStone T ;
  q : T -> S ;
  onto : DCh.Surjective q ;
  section : (t : T) -> A (q t) ;
} ;

module Over (ax : SA.Assumptions) {
  sp-stone (C : P.Booleω) : PF.isStone (P.Sp C.1) = T1.Trunc[PF.StoneW (P.Sp C.1)].inc (C, idEquiv (P.Sp C.1)) ;
  stone-set (S : U l) (sS : PF.isStone S) : isSet S = CHaus[l].Over[ax].stone-set S sS ;

  -- (ii): fibres of a map of Stone spaces, binary products (Theorem 4.18;
  -- equality in a Stone space is closed, SSD Lemma 3.10, Cor. 3.9)
  fibre-stone (T S : U l) (sT : PF.isStone T) (sS : PF.isStone S) (q : T -> S) (x : S)
    : PF.isStone (Bijection[l].Fibre q x) =
    Thm418[l].Over[ax].thm418 T sT (\ t -> Id S (q t) x) (\ t ->
      StoneClosed[l,l].Over[ax].closed-stone (Id S (q t) x) (stone-set S sS (q t) x) (StoneClosed[l,l].lemma310 S sS (q t) x)) ;
  product-stone (X Y : U l) (sX : PF.isStone X) (sY : PF.isStone Y) : PF.isStone (X * Y) =
    Thm418[l].Over[ax].thm418 X sX (\ x -> Y) (\ x -> sY) ;

  -- CCA Lemma 2.1.5 (SSD Cor. 4.4): forall x : S of open propositions is open
  lemma215 (S : U l) (sS : PF.isStone S) (A : S -> U l) (pA : (x : S) -> isProp (A x))
    (oA : (x : S) -> OpenClosed[l,l].isOpen (A x)) : OpenClosed[l,l].isOpen ((x : S) -> A x) =
    CHaus[l].Over[ax].Covered[S, stone-set S sS, StoneClosed[l,l].lemma310 S sS,
      (S, sS, \ x -> x, \ x -> Tr.Trunc[(y : S) * Id S y x].inc (x, refl x))].forall-open A pA oA ;

  -- (i)
  finite-stone (X : U l) (fX : Fi.isFinite X) : PF.isStone X =
    stone-equiv X Constant[X, FCl.finite-set X fX].Lim Constant[X, FCl.finite-set X fX].equiv
      (Lemma32[l,l].Over[ax].lemma32 Constant[X, FCl.finite-set X fX].E Constant[X, FCl.finite-set X fX].p (\ n -> fX)) ;

  -- (iv)
  module OnSp (S : U l) (A : S -> U l) (B : P.Booleω) (e : Equiv S (P.Sp B.1)) {
    A' (s : P.Sp B.1) : U l = A (e.2.sec s) ;
    cover (ld : SA.LocalData B A') : Cover[S, A] =
      mkCover S A (P.Sp ld.1.1) (sp-stone ld.1) (\ t -> e.2.sec (ld.2.1 t))
        (\ x -> TC.map (Bijection[l].Fibre ld.2.1 (e.1 x)) (Bijection[l].Fibre {P.Sp ld.1.1} {S} (\ t -> e.2.sec (ld.2.1 t)) x)
          (\ u -> (u.1, transH (apH e.2.sec u.2) (sec-ret S (P.Sp B.1) e.1 e.2 x))) (ld.2.2.1 (e.1 x)))
        ld.2.2.2 ;
  } ;
  local (S : U l) (sS : PF.isStone S) (A : S -> U l) (h : (x : S) -> Tr.Trunc[A x].carrier) : T1.Trunc[Cover[S, A]].carrier =
    TC1.rec (PF.StoneW S) @(l+) T1.Trunc[Cover[S, A]].carrier T1.Trunc[Cover[S, A]].proposition (\ w ->
      TC1.map (SA.LocalData w.1 OnSp[S, A, w.1, w.2].A') Cover[S, A] OnSp[S, A, w.1, w.2].cover
        (ax.local w.1 OnSp[S, A, w.1, w.2].A' (\ s -> h (w.2.2.sec s)))) sS ;

  -- (v)
  module Bounded (S : U l) (c : S -> Nat) {
    Goal : U l = Tr.Trunc[Fi.Bound S c].carrier ;
    module OnLim (lp : PF.LimPres[S]) {
      module C = Cor37[l,l].Over[ax].Cor37[lp.E, lp.p, lp.finite] ;
      f (z : C.M.Lim) : Nat = c (lp.equiv.2.sec z) ;
      -- a map g on the stage n bounds c
      from-stage (n : Nat) (g : lp.E n -> Nat) (h : Id (C.M.Lim -> Nat) (C.M.phi (C.M.CN.inc n g)) f) : Goal =
        TC.map (Fi.Bound (lp.E n) g) (Fi.Bound S c) (\ b -> (b.1, \ x ->
          substH {Nat} (\ k -> Le k b.1) (calc Nat {
            g ((lp.equiv.1 x).1 n) =< symH (happly C.M.Lim (\ z -> Nat) (C.M.phi (C.M.CN.inc n g)) (\ z -> g (z.1 n)) (C.M.R.beta n g) (lp.equiv.1 x)) > C.M.phi (C.M.CN.inc n g) (lp.equiv.1 x)
              =< happly C.M.Lim (\ z -> Nat) (C.M.phi (C.M.CN.inc n g)) f h (lp.equiv.1 x) > c (lp.equiv.2.sec (lp.equiv.1 x))
              =< apH c (sec-ret S C.M.Lim lp.equiv.1 lp.equiv.2 x) > c x })
            (b.2 ((lp.equiv.1 x).1 n))))
          (Fi.bound (lp.E n) (lp.finite n) g) ;
      result : Goal =
        TC.rec ((u : C.M.CN.colim) * Id (C.M.Lim -> Nat) (C.M.phi u) f) @l Goal Tr.Trunc[Fi.Bound S c].proposition
          (\ w -> C.M.CN.induction @l (\ u -> Id (C.M.Lim -> Nat) (C.M.phi u) f -> Goal)
            (\ u -> F.isProp-Pi (Id (C.M.Lim -> Nat) (C.M.phi u) f) (\ h -> Goal) (\ h -> Tr.Trunc[Fi.Bound S c].proposition))
            from-stage w.1 w.2)
          (C.surjective f) ;
    } ;
    result (sS : PF.isStone S) : Goal =
      TC1.rec (PF.LimPres[S]) @l Goal Tr.Trunc[Fi.Bound S c].proposition (\ lp -> OnLim[lp].result)
        (Profinite[l,l].Over[ax].lemma31 S sS) ;
  } ;
  bounded (S : U l) (sS : PF.isStone S) (c : S -> Nat) : Tr.Trunc[Fi.Bound S c].carrier = Bounded[S, c].result sS ;
} ;
