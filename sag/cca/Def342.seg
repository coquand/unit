-- CCA Def. 3.4.2: Sigma (x : I) (cs^-1 x)^(k+1) = lim_n I~^k_n.
--
-- Both sides are the (k+1)-tuples t of points of 2^N that are pairwise ~:
--  - Sigma (x : I) (Fin (k+1) -> Fibre cs x)
--      = Sigma (t : Fin (k+1) -> 2^N) Sigma (x : I) (forall i. cs (t i) = x)
--    (Pi of Sigma, swap), and Sigma (x : I) (forall i. cs (t i) = x) is a
--    proposition (I is a set) equivalent to "the t i are pairwise ~" (the
--    quotient is effective);
--  - a compatible sequence of tuples of near vertices is, coordinate by
--    coordinate, a tuple of points of lim V = 2^N (Dyadic.Cantor), and
--    "near at every stage" is ~ by definition.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open FinChoice[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module DCh = DependentChoice[l] ;
module SL = SeqLim[l] ;
module Eq = Equivalences[l] ;
module FCl = FiniteClosure[l] ;
module L27 = Lemma27[l] ;
module In = Interval[l] ;
module Dy = Dyadic[l] ;

-- Pi of Sigma, and swapping Sigmas
pi-sigma (A X : U l) (B : A -> X -> U l)
  : Equiv ((i : A) -> (x : X) * B i x) ((t : A -> X) * ((i : A) -> B i (t i))) =
  (\ h -> (\ i -> (h i).1, \ i -> (h i).2), qinv ((i : A) -> (x : X) * B i x) ((t : A -> X) * ((i : A) -> B i (t i)))
    (\ h -> (\ i -> (h i).1, \ i -> (h i).2)) (\ w i -> (w.1 i, w.2 i)) (\ w -> refl w) (\ h -> refl h)) ;
sigma-swap (A B : U l) (C : A -> B -> U l) : Equiv ((a : A) * (b : B) * C a b) ((b : B) * (a : A) * C a b) =
  (\ w -> (w.2.1, w.1, w.2.2), qinv ((a : A) * (b : B) * C a b) ((b : B) * (a : A) * C a b)
    (\ w -> (w.2.1, w.1, w.2.2)) (\ w -> (w.2.1, w.1, w.2.2)) (\ w -> refl w) (\ w -> refl w)) ;

module Def342 (k : Nat) {
  Ix : U l = Fin (suc k) ;
  Cantor : U l = Nat -> Bool ;
  -- pairwise related tuples of points of 2^N
  RelPw (t : Ix -> Cantor) : U l = (i j : Ix) -> In.Rel (t i) (t j) ;
  relpw-prop (t : Ix -> Cantor) : isProp (RelPw t) =
    F.isProp-Pi Ix (\ i -> (j : Ix) -> In.Rel (t i) (t j)) (\ i -> F.isProp-Pi Ix (\ j -> In.Rel (t i) (t j)) (\ j -> In.rel-prop (t i) (t j))) ;
  Pw : U l = (t : Ix -> Cantor) * RelPw t ;

  -- the fibre product side
  Over (t : Ix -> Cantor) : U l = (x : In.I) * ((i : Ix) -> Id In.I (In.cs (t i)) x) ;
  over-prop (t : Ix -> Cantor) : isProp (Over t) = \ u v ->
    Sigma-eq In.I (\ x -> (i : Ix) -> Id In.I (In.cs (t i)) x) u.1 v.1 u.2 v.2 (transH (symH (u.2 none)) (v.2 none))
      (F.isProp-Pi Ix (\ i -> Id In.I (In.cs (t i)) v.1) (\ i -> In.i-set (In.cs (t i)) v.1)) ;
  over-rel (t : Ix -> Cantor) : Equiv (Over t) (RelPw t) =
    prop-equiv (Over t) (RelPw t) (over-prop t) (relpw-prop t)
      (\ u i j -> In.Q.effective (t i) (t j) (transH (u.2 i) (symH (u.2 j))))
      (\ r -> (In.cs (t none), \ i -> In.Q.relates (t i) (t none) (r i none))) ;
  fibres : Equiv ((x : In.I) * (Ix -> Fibre In.cs x)) Pw =
    Eq.compose ((x : In.I) * (Ix -> Fibre In.cs x)) ((x : In.I) * (t : Ix -> Cantor) * ((i : Ix) -> Id In.I (In.cs (t i)) x)) Pw
      (L27.sigma-fibre In.I (\ x -> Ix -> Fibre In.cs x) (\ x -> (t : Ix -> Cantor) * ((i : Ix) -> Id In.I (In.cs (t i)) x))
        (\ x -> pi-sigma Ix Cantor (\ i a -> Id In.I (In.cs a) x)))
      (Eq.compose ((x : In.I) * (t : Ix -> Cantor) * ((i : Ix) -> Id In.I (In.cs (t i)) x)) ((t : Ix -> Cantor) * Over t) Pw
        (sigma-swap In.I (Ix -> Cantor) (\ x t -> (i : Ix) -> Id In.I (In.cs (t i)) x))
        (L27.sigma-fibre (Ix -> Cantor) Over RelPw over-rel)) ;

  -- the limit side
  T (n : Nat) : U l = Dy.Tuples k n ;
  Lim : U l = DCh.Lim T (Dy.tuple-down k) ;
  t-set (n : Nat) : isSet (T n) = FCl.finite-set (T n) Dy.TupleFinite[k, n].finite ;
  t-eq (n : Nat) (u v : T n) (e : (i : Ix) -> Id (Dy.V n) (u.1 i) (v.1 i)) : Id (T n) u v =
    Sigma-eq (Ix -> Dy.V n) (Dy.Pairwise k n) u.1 v.1 u.2 v.2 (F.funext Ix (\ i -> Dy.V n) u.1 v.1 e) (Dy.pairwise-prop k n v.1) ;
  module C = Dy.Cantor ;
  to-lim (w : Pw) : Lim = (\ n -> (\ i -> (C.to (w.1 i)).1 n, \ i j -> w.2 i j n),
    \ n -> t-eq n (Dy.tuple-down k n ((\ i -> (C.to (w.1 i)).1 (suc n)), \ i j -> w.2 i j (suc n))) ((\ i -> (C.to (w.1 i)).1 n), \ i j -> w.2 i j n)
      (\ i -> (C.to (w.1 i)).2 n)) ;
  -- the i-th coordinate of a compatible sequence of tuples
  coord (z : Lim) (i : Ix) : C.Lim = (\ n -> (z.1 n).1 i, \ n -> happly Ix (\ i1 -> Dy.V n) (Dy.tuple-down k n (z.1 (suc n))).1 (z.1 n).1
    (apH (\ u -> u.1) (z.2 n)) i) ;
  from-lim (z : Lim) : Pw = (\ i -> C.from (coord z i), \ i j n ->
    substH (\ b -> In.Near (In.N n (C.from (coord z i))) b) (symH (C.num-from (coord z j) n))
      (substH (\ a -> In.Near a ((z.1 n).1 j).1) (symH (C.num-from (coord z i) n)) ((z.1 n).2 i j))) ;
  to-from (z : Lim) : Id Lim (to-lim (from-lim z)) z =
    SL.Limit[SL.mkInvSeq T (Dy.tuple-down k)].Sets[t-set].lim-eq (to-lim (from-lim z)) z (\ n ->
      t-eq n ((to-lim (from-lim z)).1 n) (z.1 n) (\ i -> happly Nat Dy.V (C.to (C.from (coord z i))).1 (coord z i).1
        (apH (\ x -> x.1) (C.to-from (coord z i))) n)) ;
  from-to (w : Pw) : Id Pw (from-lim (to-lim w)) w =
    Sigma-eq (Ix -> Cantor) RelPw (from-lim (to-lim w)).1 w.1 (from-lim (to-lim w)).2 w.2
      (F.funext Ix (\ i -> Cantor) (from-lim (to-lim w)).1 w.1 (\ i -> C.from-to (w.1 i))) (relpw-prop w.1) ;
  limit : Equiv Pw Lim = (to-lim, qinv Pw Lim to-lim from-lim to-from from-to) ;

  -- Def. 3.4.2
  def342 : Equiv ((x : In.I) * (Ix -> Fibre In.cs x)) Lim =
    Eq.compose ((x : In.I) * (Ix -> Fibre In.cs x)) Pw Lim fibres limit ;
} ;
