-- Products: finite sets and overtly discrete types are stable under
-- products over a finite set; Pi along the fibres of a map; finite sets
-- are overtly discrete.
--
--  - A product over Fin 0 is Top; a product over Fin (k+1) = Opt (Fin k)
--    is P none x (the product over Fin k).  Binary products are Sigma
--    types (FiniteClosure.sigma-finite, Lemma27.sigma-odisc); by induction
--    on k, then along X = Fin k (FiniteClosure.Transfer).
--  - (t : T) -> G (pi t)  =  (y : Y) -> Fibre pi y -> G y:
--    h |-> (y, (t, e)) |-> e_* (h t), back k |-> t |-> k (pi t) (t, refl).
--  - X finite is the colimit of the constant sequence X -> X -> ..: a
--    class [n, x] is [0, x] (glue, n times).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Bijection[l] ; open SeqColim[l] ; open FinChoice[l] ; open Finite[l] ;
open FiniteClosure[l] ; open ODisc[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module FL2 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module L27 = Lemma27[l] ;
module CCh = CountableChoice[l] ;

-- products over Fin k
pi-zero (P : Fin zero -> U l) : Equiv ((i : Fin zero) -> P i) Top =
  (\ h -> tt, qinv ((i : Fin zero) -> P i) Top (\ h -> tt) (\ u -> fin-zero P) (\ u -> isTop tt u)
    (\ h -> F.funext (Fin zero) P (fin-zero P) h (fin-zero (\ i -> Id (P i) (fin-zero P i) (h i))))) ;
pi-suc (k : Nat) (P : Fin (suc k) -> U l) : Equiv ((i : Fin (suc k)) -> P i) (P none * ((j : Fin k) -> P (some j))) =
  (\ h -> (h none, \ j -> h (some j)),
   qinv ((i : Fin (suc k)) -> P i) (P none * ((j : Fin k) -> P (some j))) (\ h -> (h none, \ j -> h (some j)))
     (\ w -> combine k P w.1 w.2) (\ w -> refl w)
     (\ h -> F.funext (Fin (suc k)) P (combine k P (h none) (\ j -> h (some j))) h
       (combine k (\ i -> Id (P i) (combine k P (h none) (\ j -> h (some j)) i) (h i)) (refl (h none)) (\ j -> refl (h (some j)))))) ;
pi-domain (X Y : U l) (e : Equiv X Y) (B : U l) : Equiv (Y -> B) (X -> B) =
  (\ g x -> g (e.1 x), qinv (Y -> B) (X -> B) (\ g x -> g (e.1 x)) (\ h y -> h (e.2.sec y))
    (\ h -> F.funext X (\ x -> B) (\ x -> h (e.2.sec (e.1 x))) h (\ x -> apH h (sec-ret X Y e.1 e.2 x)))
    (\ g -> F.funext Y (\ y -> B) (\ y -> g (e.1 (e.2.sec y))) g (\ y -> apH g (e.2.sec-eq y)))) ;
pi-fibre (A : U l) (B C : A -> U l) (e : (a : A) -> Equiv (B a) (C a)) : Equiv ((a : A) -> B a) ((a : A) -> C a) =
  (\ h a -> (e a).1 (h a), qinv ((a : A) -> B a) ((a : A) -> C a) (\ h a -> (e a).1 (h a)) (\ k a -> (e a).2.sec (k a))
    (\ k -> F.funext A C (\ a -> (e a).1 ((e a).2.sec (k a))) k (\ a -> (e a).2.sec-eq (k a)))
    (\ h -> F.funext A B (\ a -> (e a).2.sec ((e a).1 (h a))) h (\ a -> sec-ret (B a) (C a) (e a).1 (e a).2 (h a)))) ;

-- along the fibres of a map
module PiFibres (T Y : U l) (pi : T -> Y) (G : Y -> U l) {
  to (h : (t : T) -> G (pi t)) (y : Y) (u : Fibre pi y) : G y = substH G u.2 (h u.1) ;
  from (k : (y : Y) -> Fibre pi y -> G y) (t : T) : G (pi t) = k (pi t) (t, refl (pi t)) ;
  to-from-at (k : (y : Y) -> Fibre pi y -> G y) (t : T) (y : Y) (e : Id Y (pi t) y) : Id (G y) (to (from k) y (t, e)) (k y (t, e)) =
    idJ Y (pi t) (\ y1 e1 -> Id (G y1) (to (from k) y1 (t, e1)) (k y1 (t, e1))) (refl (k (pi t) (t, refl (pi t)))) y e ;
  to-from (k : (y : Y) -> Fibre pi y -> G y) : Id ((y : Y) -> Fibre pi y -> G y) (to (from k)) k =
    F.funext Y (\ y -> Fibre pi y -> G y) (to (from k)) k (\ y ->
      F.funext (Fibre pi y) (\ u -> G y) (to (from k) y) (k y) (\ u -> to-from-at k u.1 y u.2)) ;
  equiv : Equiv ((t : T) -> G (pi t)) ((y : Y) -> Fibre pi y -> G y) =
    (to, qinv ((t : T) -> G (pi t)) ((y : Y) -> Fibre pi y -> G y) to from to-from (\ h -> refl h)) ;
} ;

-- finite products of finite sets
PiFinite (X : U l) : U l+ = (P : X -> U l) -> ((x : X) -> isFinite (P x)) -> isFinite ((x : X) -> P x) ;
pi-finite-prop (X : U l) : Prelude[l+].isProp (PiFinite X) =
  FL2.isProp-Pi (X -> U l) (\ P -> ((x : X) -> isFinite (P x)) -> isFinite ((x : X) -> P x)) (\ P ->
    FL2.isProp-Pi ((x : X) -> isFinite (P x)) (\ fP -> isFinite ((x : X) -> P x)) (\ fP -> Tr.Trunc[FinEquiv ((x : X) -> P x)].proposition)) ;
pi-fin-finite : (k : Nat) -> PiFinite (Fin k) = split {
  zero -> \ P fP -> finite-equiv ((i : Fin zero) -> P i) Top (pi-zero P) top-finite ;
  suc k | r -> \ P fP -> finite-equiv ((i : Fin (suc k)) -> P i) (P none * ((j : Fin k) -> P (some j))) (pi-suc k P)
    (sigma-finite (P none) (fP none) (\ a -> (j : Fin k) -> P (some j)) (\ a -> r (\ j -> P (some j)) (\ j -> fP (some j)))) } ;
pi-finite (X : U l) (fX : isFinite X) : PiFinite X = Transfer[PiFinite, pi-finite-prop, pi-fin-finite].finite X fX ;

-- finite sets are overtly discrete
module ConstantSeq (X : U l) (sX : isSet X) {
  seq : Seq = mkSeq (\ n -> X) (\ n x -> x) ;
  module C = Colim[seq] ;
  module R = C.Rec[X, sX, C.mkCocone X (\ n x -> x) (\ n x -> refl x)] ;
  at-zero : (n : Nat) (x : X) -> Id C.colim (C.inc n x) (C.inc zero x) = split {
    zero -> \ x -> refl (C.inc zero x) ;
    suc n | r -> \ x -> transH (symH (C.glue n x)) (r x) } ;
  back (c : C.colim) : Id C.colim (C.inc zero (R.map c)) c =
    C.induction @l (\ c -> Id C.colim (C.inc zero (R.map c)) c) (\ c -> C.set (C.inc zero (R.map c)) c)
      (\ n x -> transH (apH (C.inc zero) (R.beta n x)) (symH (at-zero n x))) c ;
  equiv : Equiv X C.colim = (C.inc zero, qinv X C.colim (C.inc zero) R.map back (\ x -> R.beta zero x)) ;
} ;
finite-odisc (X : U l) (fX : isFinite X) : isODisc X =
  T1.Trunc[Pres[X]].inc (mkPres X ConstantSeq[X, finite-set X fX].seq (\ n -> fX) ConstantSeq[X, finite-set X fX].equiv) ;

-- finite products of overtly discrete types
PiODisc (X : U l) : U l+ = (P : X -> U l) -> ((x : X) -> isODisc (P x)) -> isODisc ((x : X) -> P x) ;
pi-odisc-prop (X : U l) : Prelude[l+].isProp (PiODisc X) =
  FL2.isProp-Pi (X -> U l) (\ P -> ((x : X) -> isODisc (P x)) -> isODisc ((x : X) -> P x)) (\ P ->
    FL2.isProp-Pi ((x : X) -> isODisc (P x)) (\ oP -> isODisc ((x : X) -> P x)) (\ oP -> T1.Trunc[Pres[(x : X) -> P x]].proposition)) ;
module Products (cc : CCh.CC) (dc : DependentChoice[l+].DC) {
  pi-fin-odisc : (k : Nat) -> PiODisc (Fin k) = split {
    zero -> \ P oP -> L27.odisc-equiv ((i : Fin zero) -> P i) Top (pi-zero P) (finite-odisc Top top-finite) ;
    suc k | r -> \ P oP -> L27.odisc-equiv ((i : Fin (suc k)) -> P i) (P none * ((j : Fin k) -> P (some j))) (pi-suc k P)
      (L27.sigma-odisc cc dc (P none) (oP none) (\ a -> (j : Fin k) -> P (some j)) (\ a -> r (\ j -> P (some j)) (\ j -> oP (some j)))) } ;
  pi-odisc (X : U l) (fX : isFinite X) : PiODisc X = Transfer[PiODisc, pi-odisc-prop, pi-fin-odisc].finite X fX ;
} ;
