-- CCA Thm 2.4.6 (Scott continuity for compact Hausdorff spaces): for a
-- tower in C_CHaus -- compact Hausdorff C 0 <- C 1 <- .., overtly discrete
-- I n over C n, maps q n x : I n (c x) -> I (n+1) x -- the canonical map
--   colim_n ((x : C n) -> I n x)  ->  (y : lim C) -> colim_n I n (y n)
-- is an equivalence.
--
-- Proof.  Lemma 2.4.2 gives Stone S n ->> C n, compatible, with
-- lim S ->> lim C; pull the families back to a tower in C_Stone (the maps
-- transport along the squares).  Pulling sections back is injective (the
-- p n are onto), and at z : lim S the tower of the I n (z n) is the one at
-- y = lim p z, up to transport (At.phi), so the canonical maps commute.
-- Injective: by Thm 2.3.11 for the pulled back tower.
-- Surjective: phi pulled back is the image of a class [g] (Thm 2.3.11);
-- on the Stone tower of pairs E n = {(s, s') | p s = p s'}, the sections
-- e_* (g s) and g s' have the same image over lim E (both come from
-- phi), so they agree after d steps (Thm 2.3.11, injective, for the tower
-- over E); then shift_d g is compatible along p and descends to C (d + i)
-- (ConstantMap), with canonical image phi.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open SeqColim[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module CH = CHaus[l] ;
module OD = ODisc[l] ;
module DCh = DependentChoice[l] ;
module SM = SeqMaps[l] ;
module T23 = Thm2311[l] ;

-- a tower in C_CHaus
record HTower {
  C : Nat -> U l ;
  c : (n : Nat) -> C (suc n) -> C n ;
  cC : (n : Nat) -> CH.isCHaus (C n) ;
  I : (n : Nat) -> C n -> U l ;
  q : (n : Nat) (x : C (suc n)) -> I n (c n x) -> I (suc n) x ;
  sI : (n : Nat) (x : C n) -> isSet (I n x) ;
  oI : (n : Nat) (x : C n) -> OD.isODisc (I n x) ;
} ;
ft (T : HTower) : T23.FTower = T23.mkFTower T.C T.c T.I T.q ;

-- moving along pi in S, then along the inverse of sq, is moving along the
-- inverse of sq . p pi
pull-move (S C : U l) (p : S -> C) (I : C -> U l) (x0 : C) (s1 s2 : S) (sq : Id C x0 (p s1)) (pi : Id S s1 s2) (a : I (p s2)) :
  Id (I x0) (substH I (symH sq) (substH (\ s -> I (p s)) (symH pi) a)) (substH I (symH (transH sq (apH p pi))) a) =
  idJ S s1 (\ s3 pi3 -> (a3 : I (p s3)) -> Id (I x0) (substH I (symH sq) (substH (\ s -> I (p s)) (symH pi3) a3))
      (substH I (symH (transH sq (apH p pi3))) a3))
    (\ a3 -> refl (substH I (symH sq) a3)) s2 pi a ;

-- q is natural in its base point
q-nat (C D : U l) (c : C -> D) (J : D -> U l) (K : C -> U l) (q : (x : C) -> J (c x) -> K x) (x x' : C) (e : Id C x x') (b : J (c x)) :
  Id (K x') (q x' (substH J (apH c e) b)) (substH K e (q x b)) =
  idJ C x (\ x1 e1 -> Id (K x1) (q x1 (substH J (apH c e1) b)) (substH K e1 (q x b))) (refl (q x b)) x' e ;
-- moving along t . s, then back along s, is moving along t
cancel-r (X : U l) (I : X -> U l) (a0 x y : X) (t : Id X a0 x) (s : Id X x y) (b : I a0) :
  Id (I x) (substH I (symH s) (substH I (transH t s) b)) (substH I t b) =
  idJ X x (\ y1 s1 -> Id (I x) (substH I (symH s1) (substH I (transH t s1) b)) (substH I t b)) (refl (substH I t b)) y s ;
-- transport in a pulled back family
subst-ap (A B : U l) (f : A -> B) (F : B -> U l) (a a' : A) (p : Id A a a') (b : F (f a)) :
  Id (F (f a')) (substH (\ u -> F (f u)) p b) (substH F (apH f p) b) =
  idJ A a (\ a1 p1 -> Id (F (f a1)) (substH (\ u -> F (f u)) p1 b) (substH F (apH f p1) b)) (refl b) a' p ;
-- two sections agreeing at a point agree along a path
sections-path (A : U l) (B : A -> U l) (u v : (a : A) -> B a) (a a' : A) (p : Id A a a') (e : Id (B a) (u a) (v a)) : Id (B a') (u a') (v a') =
  idJ A a (\ a1 p1 -> Id (B a1) (u a1) (v a1)) e a' p ;

module Over (ax : SA.Assumptions) {
  module P243 = Prop243[l].Over[ax] ;
  module P214 = Prop214[l].Over[ax] ;
  module CP = CountableProduct[l].Over[ax] ;
  module Thm246 (T : HTower) {
    module H = T23.Pis[ft T] ;
    module WithCovers (cv : (k : Nat) -> CH.Cover (T.C k)) {
      module L = P243.Lemma242[T.C, T.c, T.cC, cv] ;
      -- the pulled back tower in C_Stone
      I' (n : Nat) (s : L.S n) : U l = T.I n (L.p n s) ;
      q' (n : Nat) (w : L.S (suc n)) (a : I' n (L.down n w)) : I' (suc n) w =
        T.q n (L.p (suc n) w) (substH (T.I n) (symH (L.square n w)) a) ;
      CT : T23.CTower = T23.mkCTower L.S L.down L.stone I' q' (\ n s -> T.sI n (L.p n s)) (\ n s -> T.oI n (L.p n s)) ;
      module P = T23.Pis[T23.fam CT] ;
      -- pulling sections back
      pb (n : Nat) (h : H.Pi n) : P.Pi n = \ s -> h (L.p n s) ;
      pb-next (n : Nat) (h : H.Pi n) : Id (P.Pi (suc n)) (P.next n (pb n h)) (pb (suc n) (H.next n h)) =
        F.funext (L.S (suc n)) (I' (suc n)) (P.next n (pb n h)) (pb (suc n) (H.next n h)) (\ w ->
          apH (T.q n (L.p (suc n) w)) (Prop239[l].transport-section (T.C n) (T.I n) h (L.p n (L.down n w)) (T.c n (L.p (suc n) w))
            (symH (L.square n w)))) ;
      PB : SM.SeqMap[H.pis, P.pis] = SM.mkSeqMap H.pis P.pis pb pb-next ;
      module IPB = SM.Induced[H.pis, P.pis, PB] ;
      pb-inj (n : Nat) : Injective (pb n) = \ h h' e -> F.funext (T.C n) (T.I n) h h' (\ x ->
        TC.rec (Fibre (L.p n) x) @l (Id (T.I n x) (h x) (h' x)) (T.sI n x (h x) (h' x))
          (\ u -> transH (symH (Prop239[l].transport-section (T.C n) (T.I n) h (L.p n u.1) x u.2))
            (transH (apH (substH (T.I n) u.2) (happly (L.S n) (I' n) (pb n h) (pb n h') e u.1))
              (Prop239[l].transport-section (T.C n) (T.I n) h' (L.p n u.1) x u.2)))
          (L.onto n x)) ;
      pb-injective : Injective IPB.map = IPB.Inj[pb-inj].injective ;
      -- at a point of lim S, the two towers have the same colimit
      module At (z : P.L) {
        y : H.L = L.lim-map z ;
        cmp-c (n : Nat) (a : T.I n (L.p n (z.1 n))) : Id (T.I (suc n) (L.p (suc n) (z.1 (suc n)))) ((H.at y).f n a) ((P.at z).f n a) =
          apH (T.q n (L.p (suc n) (z.1 (suc n)))) (symH (pull-move (L.S n) (T.C n) (L.p n) (T.I n) (T.c n (L.p (suc n) (z.1 (suc n))))
            (L.down n (z.1 (suc n))) (z.1 n) (L.square n (z.1 (suc n))) (z.2 n) a)) ;
        PH : SM.SeqMap[P.at z, H.at y] = SM.mkSeqMap (P.at z) (H.at y) (\ n a -> a) cmp-c ;
        module IPH = SM.Induced[P.at z, H.at y, PH] ;
        phi (u : Colim[P.at z].colim) : Colim[H.at y].colim = IPH.map u ;
        phi-inj : Injective phi = IPH.Inj[\ n a a' e -> e].injective ;
      } ;
      -- the canonical maps commute
      comm (u : H.PC.colim) (z : P.L) : Id (Colim[H.at (L.lim-map z)].colim) (At[z].phi (P.canonical (IPB.map u) z)) (H.canonical u (L.lim-map z)) =
        H.PC.induction @l (\ u1 -> Id (Colim[H.at (L.lim-map z)].colim) (At[z].phi (P.canonical (IPB.map u1) z)) (H.canonical u1 (L.lim-map z)))
          (\ u1 -> Colim[H.at (L.lim-map z)].set (At[z].phi (P.canonical (IPB.map u1) z)) (H.canonical u1 (L.lim-map z)))
          (\ n h -> calc (Colim[H.at (L.lim-map z)].colim) {
            At[z].phi (P.canonical (IPB.map (H.PC.inc n h)) z)
              =< apH (\ v -> At[z].phi (P.canonical v z)) (IPB.map-inc n h) > At[z].phi (P.canonical (P.PC.inc n (pb n h)) z)
              =< apH At[z].phi (happly P.L (\ z1 -> Colim[P.at z1].colim) (P.canonical (P.PC.inc n (pb n h))) (P.pointwise n (pb n h)) (P.canonical-inc n (pb n h)) z) >
            At[z].phi (Colim[P.at z].inc n (h (L.p n (z.1 n))))
              =< At[z].IPH.map-inc n (h (L.p n (z.1 n))) > Colim[H.at (L.lim-map z)].inc n (h (L.p n (z.1 n)))
              =< symH (happly H.L (\ y1 -> Colim[H.at y1].colim) (H.canonical (H.PC.inc n h)) (H.pointwise n h) (H.canonical-inc n h) (L.lim-map z)) >
            H.canonical (H.PC.inc n h) (L.lim-map z) }) u ;
      injective : Injective H.canonical = \ u u' e ->
        pb-injective u u' (T23.Over[ax].Thm2311[CT].injective (IPB.map u) (IPB.map u')
          (F.funext P.L (\ z -> Colim[P.at z].colim) (P.canonical (IPB.map u)) (P.canonical (IPB.map u')) (\ z ->
            At[z].phi-inj (P.canonical (IPB.map u) z) (P.canonical (IPB.map u') z)
              (transH (comm u z) (transH (happly H.L (\ y1 -> Colim[H.at y1].colim) (H.canonical u) (H.canonical u') e (L.lim-map z))
                (symH (comm u' z))))))) ;
      -- surjectivity
      module Surj (phi : H.Target) {
        at-equiv (z : P.L) : isEquiv (Colim[P.at z].colim) (Colim[H.at (L.lim-map z)].colim) At[z].phi =
          Bij[Colim[P.at z].colim, Colim[H.at (L.lim-map z)].colim, Colim[H.at (L.lim-map z)].set, At[z].phi, At[z].phi-inj,
            At[z].IPH.Surj[\ n a -> Tr.Trunc[Fibre {T.I n (L.p n (z.1 n))} {T.I n (L.p n (z.1 n))} (\ a1 -> a1) a].inc (a, refl a)].surjective].equiv ;
        psi : P.Target = \ z -> (at-equiv z).sec (phi (L.lim-map z)) ;
        -- the pair tower
        E (n : Nat) : U l = (w : L.S n * L.S n) * Id (T.C n) (L.p n w.1) (L.p n w.2) ;
        down-E (n : Nat) (u : E (suc n)) : E n = ((L.down n u.1.1, L.down n u.1.2),
          transH (transH (symH (L.square n u.1.1)) (apH (T.c n) u.2)) (L.square n u.1.2)) ;
        e-stone (n : Nat) : PF.isStone (E n) = CP.sub-stone (L.S n * L.S n) (P214.product-stone (L.S n) (L.S n) (L.stone n) (L.stone n))
          (\ w -> Id (T.C n) (L.p n w.1) (L.p n w.2)) (\ w -> (T.cC n).1 (L.p n w.1) (L.p n w.2)) (\ w -> (T.cC n).2.1 (L.p n w.1) (L.p n w.2)) ;
        K (n : Nat) (u : E n) : U l = T.I n (L.p n u.1.2) ;
        qE (n : Nat) (u : E (suc n)) (a : K n (down-E n u)) : K (suc n) u = q' n u.1.2 a ;
        ET : T23.CTower = T23.mkCTower E down-E e-stone K qE (\ n u -> T.sI n (L.p n u.1.2)) (\ n u -> T.oI n (L.p n u.1.2)) ;
        module PE = T23.Pis[T23.fam ET] ;
        -- the two projections of lim E
        pr1 (zeta : PE.L) : P.L = (\ n -> (zeta.1 n).1.1, \ n -> apH (\ u -> u.1.1) (zeta.2 n)) ;
        pr2 (zeta : PE.L) : P.L = (\ n -> (zeta.1 n).1.2, \ n -> apH (\ u -> u.1.2) (zeta.2 n)) ;
        same-y (zeta : PE.L) : Id H.L (L.lim-map (pr1 zeta)) (L.lim-map (pr2 zeta)) =
          SeqLim[l].Limit[SeqLim[l].mkInvSeq T.C T.c].Sets[\ k -> (T.cC k).1].lim-eq (L.lim-map (pr1 zeta)) (L.lim-map (pr2 zeta))
            (\ n -> (zeta.1 n).2) ;
        -- the tower at a point of lim E is the tower at its second projection
        module AtE (zeta : PE.L) {
          z2 : P.L = pr2 zeta ;
          cmp (n : Nat) (a : T.I n (L.p n (z2.1 n))) : Id (T.I (suc n) (L.p (suc n) (z2.1 (suc n)))) ((P.at z2).f n a) ((PE.at zeta).f n a) =
            apH (q' n (z2.1 (suc n))) (transH
              (apH {Id (L.S n) (zeta.1 n).1.2 (L.down n (zeta.1 (suc n)).1.2)} {I' n (L.down n (zeta.1 (suc n)).1.2)} (\ e -> substH (I' n) e a)
                (P214.stone-set (L.S n) (L.stone n) (zeta.1 n).1.2 (L.down n (zeta.1 (suc n)).1.2)
                  (symH (apH (\ u -> u.1.2) (zeta.2 n))) (apH (\ u -> u.1.2) (symH (zeta.2 n)))))
              (symH (subst-ap (E n) (L.S n) (\ u -> u.1.2) (I' n) (zeta.1 n) (down-E n (zeta.1 (suc n))) (symH (zeta.2 n)) a))) ;
          PM : SM.SeqMap[PE.at zeta, P.at z2] = SM.mkSeqMap (PE.at zeta) (P.at z2) (\ n a -> a) (\ n a -> cmp n a) ;
          module IPM = SM.Induced[PE.at zeta, P.at z2, PM] ;
          psiE (c : Colim[PE.at zeta].colim) : Colim[P.at z2].colim = IPM.map c ;
          psiE-inj : Injective psiE = IPM.Inj[\ n a a' e -> e].injective ;
        } ;
        -- transport of classes along a path of lim C
        tr-inc (i : Nat) (y1 y2 : H.L) (Y : Id H.L y1 y2) (a : T.I i (y1.1 i)) :
          Id (Colim[H.at y2].colim) (substH (\ y -> Colim[H.at y].colim) Y (Colim[H.at y1].inc i a))
            (Colim[H.at y2].inc i (substH (T.I i) (apH (\ y -> y.1 i) Y) a)) =
          idJ H.L y1 (\ y3 Y3 -> Id (Colim[H.at y3].colim) (substH (\ y -> Colim[H.at y].colim) Y3 (Colim[H.at y1].inc i a))
              (Colim[H.at y3].inc i (substH (T.I i) (apH (\ y -> y.1 i) Y3) a)))
            (refl (Colim[H.at y1].inc i a)) y2 Y ;
        module Stage (i : Nat) (g : P.Pi i) (pt : (z : P.L) -> Id (Colim[P.at z].colim) (Colim[P.at z].inc i (g (z.1 i))) (psi z)) {
          key (z : P.L) : Id (Colim[H.at (L.lim-map z)].colim) (Colim[H.at (L.lim-map z)].inc i (g (z.1 i))) (phi (L.lim-map z)) =
            transH (symH (At[z].IPH.map-inc i (g (z.1 i)))) (transH (apH At[z].phi (pt z)) ((at-equiv z).sec-eq (phi (L.lim-map z)))) ;
          A (u : E i) : K i u = substH {T.C i} (T.I i) {L.p i u.1.1} {L.p i u.1.2} u.2 (g u.1.1) ;
          B (u : E i) : K i u = g u.1.2 ;
          agree-H (zeta : PE.L) : Id (Colim[H.at (L.lim-map (pr2 zeta))].colim)
              (Colim[H.at (L.lim-map (pr2 zeta))].inc i (A (zeta.1 i))) (Colim[H.at (L.lim-map (pr2 zeta))].inc i (B (zeta.1 i))) =
            calc (Colim[H.at (L.lim-map (pr2 zeta))].colim) {
              Colim[H.at (L.lim-map (pr2 zeta))].inc i (A (zeta.1 i))
                =< apH (\ e -> Colim[H.at (L.lim-map (pr2 zeta))].inc i (substH {T.C i} (T.I i) {L.p i (zeta.1 i).1.1} {L.p i (zeta.1 i).1.2} e (g (zeta.1 i).1.1)))
                     ((T.cC i).1 (L.p i (zeta.1 i).1.1) (L.p i (zeta.1 i).1.2) (zeta.1 i).2 (apH (\ y -> y.1 i) (same-y zeta))) >
              Colim[H.at (L.lim-map (pr2 zeta))].inc i (substH {T.C i} (T.I i) {L.p i (zeta.1 i).1.1} {L.p i (zeta.1 i).1.2} (apH (\ y -> y.1 i) (same-y zeta)) (g (zeta.1 i).1.1))
                =< symH (tr-inc i (L.lim-map (pr1 zeta)) (L.lim-map (pr2 zeta)) (same-y zeta) (g (zeta.1 i).1.1)) >
              substH (\ y -> Colim[H.at y].colim) (same-y zeta) (Colim[H.at (L.lim-map (pr1 zeta))].inc i (g (zeta.1 i).1.1))
                =< apH (substH (\ y -> Colim[H.at y].colim) (same-y zeta)) (key (pr1 zeta)) >
              substH (\ y -> Colim[H.at y].colim) (same-y zeta) (phi (L.lim-map (pr1 zeta)))
                =< Prop239[l].transport-section H.L (\ y -> Colim[H.at y].colim) phi (L.lim-map (pr1 zeta)) (L.lim-map (pr2 zeta)) (same-y zeta) >
              phi (L.lim-map (pr2 zeta))
                =< symH (key (pr2 zeta)) > Colim[H.at (L.lim-map (pr2 zeta))].inc i (B (zeta.1 i)) } ;
          agree (zeta : PE.L) : Id (Colim[PE.at zeta].colim) (Colim[PE.at zeta].inc i (A (zeta.1 i))) (Colim[PE.at zeta].inc i (B (zeta.1 i))) =
            AtE[zeta].psiE-inj (Colim[PE.at zeta].inc i (A (zeta.1 i))) (Colim[PE.at zeta].inc i (B (zeta.1 i)))
              (transH (AtE[zeta].IPM.map-inc i (A (zeta.1 i))) (transH
                (At[pr2 zeta].phi-inj (Colim[P.at (pr2 zeta)].inc i (A (zeta.1 i))) (Colim[P.at (pr2 zeta)].inc i (B (zeta.1 i)))
                  (transH (At[pr2 zeta].IPH.map-inc i (A (zeta.1 i))) (transH (agree-H zeta) (symH (At[pr2 zeta].IPH.map-inc i (B (zeta.1 i)))))))
                (symH (AtE[zeta].IPM.map-inc i (B (zeta.1 i)))))) ;
          same : Id PE.PC.colim (PE.PC.inc i A) (PE.PC.inc i B) = T23.Over[ax].Thm2311[ET].Same[i, A, B, agree].result ;
          -- shifting the two sections
          shiftB : (d : Nat) (u : E (plus d i)) -> Id (K (plus d i) u) (PE.PC.shift d i B u) (P.PC.shift d i g u.1.2) = split {
            zero -> \ u -> refl (g u.1.2) ;
            suc d | r -> \ u -> apH (q' (plus d i) u.1.2) (r (down-E (plus d i) u)) } ;
          shiftA : (d : Nat) (u : E (plus d i)) -> Id (K (plus d i) u) (PE.PC.shift d i A u) (substH {T.C (plus d i)} (T.I (plus d i)) {L.p (plus d i) u.1.1} {L.p (plus d i) u.1.2} u.2 (P.PC.shift d i g u.1.1)) = split {
            zero -> \ u -> refl (A u) ;
            suc d | r -> \ u -> calc (K (suc (plus d i)) u) {
              q' (plus d i) u.1.2 (PE.PC.shift d i A (down-E (plus d i) u))
                =< apH (q' (plus d i) u.1.2) (r (down-E (plus d i) u)) >
              q' (plus d i) u.1.2 (substH {T.C (plus d i)} (T.I (plus d i)) {L.p (plus d i) (L.down (plus d i) u.1.1)} {L.p (plus d i) (L.down (plus d i) u.1.2)} (down-E (plus d i) u).2 (P.PC.shift d i g (L.down (plus d i) u.1.1)))
                =< apH (T.q (plus d i) (L.p (suc (plus d i)) u.1.2))
                     (cancel-r (T.C (plus d i)) (T.I (plus d i)) (L.p (plus d i) (L.down (plus d i) u.1.1)) (T.c (plus d i) (L.p (suc (plus d i)) u.1.2))
                       (L.p (plus d i) (L.down (plus d i) u.1.2))
                       (transH (symH (L.square (plus d i) u.1.1)) (apH (T.c (plus d i)) u.2)) (L.square (plus d i) u.1.2)
                       (P.PC.shift d i g (L.down (plus d i) u.1.1))) >
              T.q (plus d i) (L.p (suc (plus d i)) u.1.2)
                (substH {T.C (plus d i)} (T.I (plus d i)) {L.p (plus d i) (L.down (plus d i) u.1.1)} {T.c (plus d i) (L.p (suc (plus d i)) u.1.2)} (transH (symH (L.square (plus d i) u.1.1)) (apH (T.c (plus d i)) u.2)) (P.PC.shift d i g (L.down (plus d i) u.1.1)))
                =< apH (T.q (plus d i) (L.p (suc (plus d i)) u.1.2))
                     (symH (T23.subst-trans (T.C (plus d i)) (T.I (plus d i)) (L.p (plus d i) (L.down (plus d i) u.1.1))
                       (T.c (plus d i) (L.p (suc (plus d i)) u.1.1)) (T.c (plus d i) (L.p (suc (plus d i)) u.1.2))
                       (symH (L.square (plus d i) u.1.1)) (apH (T.c (plus d i)) u.2) (P.PC.shift d i g (L.down (plus d i) u.1.1)))) >
              T.q (plus d i) (L.p (suc (plus d i)) u.1.2)
                (substH (T.I (plus d i)) (apH (T.c (plus d i)) u.2) (substH {T.C (plus d i)} (T.I (plus d i)) {L.p (plus d i) (L.down (plus d i) u.1.1)} {T.c (plus d i) (L.p (suc (plus d i)) u.1.1)} (symH (L.square (plus d i) u.1.1)) (P.PC.shift d i g (L.down (plus d i) u.1.1))))
                =< q-nat (T.C (suc (plus d i))) (T.C (plus d i)) (T.c (plus d i)) (T.I (plus d i)) (T.I (suc (plus d i))) (T.q (plus d i))
                     (L.p (suc (plus d i)) u.1.1) (L.p (suc (plus d i)) u.1.2) u.2
                     (substH {T.C (plus d i)} (T.I (plus d i)) {L.p (plus d i) (L.down (plus d i) u.1.1)} {T.c (plus d i) (L.p (suc (plus d i)) u.1.1)} (symH (L.square (plus d i) u.1.1)) (P.PC.shift d i g (L.down (plus d i) u.1.1))) >
              substH {T.C (suc (plus d i))} (T.I (suc (plus d i))) {L.p (suc (plus d i)) u.1.1} {L.p (suc (plus d i)) u.1.2} u.2 (q' (plus d i) u.1.1 (P.PC.shift d i g (L.down (plus d i) u.1.1))) } } ;
          module Later (w : (d : Nat) * Id (PE.Pi (plus d i)) (PE.PC.shift d i A) (PE.PC.shift d i B)) {
            m : Nat = plus w.1 i ;
            G' : P.Pi m = P.PC.shift w.1 i g ;
            compat (u : E m) : Id (T.I m (L.p m u.1.2)) (substH {T.C m} (T.I m) {L.p m u.1.1} {L.p m u.1.2} u.2 (G' u.1.1)) (G' u.1.2) =
              transH (symH (shiftA w.1 u)) (transH (happly (E m) (K m) (PE.PC.shift w.1 i A) (PE.PC.shift w.1 i B) w.2 u) (shiftB w.1 u)) ;
            value-at (x : T.C m) (v : Fibre (L.p m) x) : T.I m x = substH {T.C m} (T.I m) {L.p m v.1} {x} v.2 (G' v.1) ;
            wc (x : T.C m) (v v' : Fibre (L.p m) x) : Id (T.I m x) (value-at x v) (value-at x v') =
              transH (symH (Prop245[l].cancel (T.C m) (T.I m) (L.p m v.1) (L.p m v'.1) x v'.2 v.2 (G' v.1)))
                (apH (substH (T.I m) v'.2) (compat ((v.1, v'.1), transH v.2 (symH v'.2)))) ;
            module KC (x : T.C m) { module M = ConstantMap[l].Constant[Fibre (L.p m) x, T.I m x, T.sI m x, value-at x, wc x] ; } ;
            h (x : T.C m) : T.I m x = KC[x].M.value (L.onto m x) ;
            h-at (s : L.S m) : Id (T.I m (L.p m s)) (h (L.p m s)) (G' s) = KC[L.p m s].M.value-at (L.onto m (L.p m s)) (s, refl (L.p m s)) ;
            at-z (z : P.L) : Id (Colim[H.at (L.lim-map z)].colim) (H.canonical (H.PC.inc m h) (L.lim-map z)) (phi (L.lim-map z)) =
              calc (Colim[H.at (L.lim-map z)].colim) {
                H.canonical (H.PC.inc m h) (L.lim-map z)
                  =< happly H.L (\ y1 -> Colim[H.at y1].colim) (H.canonical (H.PC.inc m h)) (H.pointwise m h) (H.canonical-inc m h) (L.lim-map z) >
                Colim[H.at (L.lim-map z)].inc m (h (L.p m (z.1 m)))
                  =< apH (Colim[H.at (L.lim-map z)].inc m) (h-at (z.1 m)) > Colim[H.at (L.lim-map z)].inc m (G' (z.1 m))
                  =< symH (At[z].IPH.map-inc m (G' (z.1 m))) > At[z].phi (Colim[P.at z].inc m (G' (z.1 m)))
                  =< apH At[z].phi (symH (happly P.L (\ z1 -> Colim[P.at z1].colim) (P.canonical (P.PC.inc m G')) (P.pointwise m G') (P.canonical-inc m G') z)) >
                At[z].phi (P.canonical (P.PC.inc m G') z)
                  =< apH (\ v -> At[z].phi (P.canonical v z)) (P.PC.inc-shift w.1 i g) > At[z].phi (P.canonical (P.PC.inc i g) z)
                  =< apH At[z].phi (transH (happly P.L (\ z1 -> Colim[P.at z1].colim) (P.canonical (P.PC.inc i g)) (P.pointwise i g) (P.canonical-inc i g) z) (pt z)) >
                At[z].phi (psi z)
                  =< (at-equiv z).sec-eq (phi (L.lim-map z)) > phi (L.lim-map z) } ;
            at-y (y : H.L) : Id (Colim[H.at y].colim) (H.canonical (H.PC.inc m h) y) (phi y) =
              TC.rec (Fibre L.lim-map y) @l (Id (Colim[H.at y].colim) (H.canonical (H.PC.inc m h) y) (phi y))
                (Colim[H.at y].set (H.canonical (H.PC.inc m h) y) (phi y))
                (\ v -> sections-path H.L (\ y1 -> Colim[H.at y1].colim) (H.canonical (H.PC.inc m h)) phi (L.lim-map v.1) y v.2 (at-z v.1))
                (L.lim-onto y) ;
            onto : Fibre H.canonical phi = (H.PC.inc m h, F.funext H.L (\ y -> Colim[H.at y].colim) (H.canonical (H.PC.inc m h)) phi at-y) ;
          } ;
          result : Tr.Trunc[Fibre H.canonical phi].carrier =
            TC.map ((d : Nat) * Id (PE.Pi (plus d i)) (PE.PC.shift d i A) (PE.PC.shift d i B)) (Fibre H.canonical phi) (\ v -> Later[v].onto)
              (SeqProp[l].IdColim[PE.pis, \ n -> F.isSet-Pi (E n) (K n) (\ u -> T.sI n (L.p n u.1.2)), i, A, B].to same) ;
        } ;
        result : Tr.Trunc[Fibre H.canonical phi].carrier =
          TC.rec (Fibre P.canonical psi) @l (Tr.Trunc[Fibre H.canonical phi].carrier) Tr.Trunc[Fibre H.canonical phi].proposition (\ v ->
            P.PC.induction @l (\ u -> Id P.Target (P.canonical u) psi -> Tr.Trunc[Fibre H.canonical phi].carrier)
              (\ u -> F.isProp-Pi (Id P.Target (P.canonical u) psi) (\ e -> Tr.Trunc[Fibre H.canonical phi].carrier) (\ e -> Tr.Trunc[Fibre H.canonical phi].proposition))
              (\ i g e -> Stage[i, g, happly P.L (\ z -> Colim[P.at z].colim) (P.pointwise i g) psi (transH (symH (P.canonical-inc i g)) e)].result)
              v.1 v.2)
            (T23.Over[ax].Theorem[CT].surjective psi) ;
      } ;
    } ;
    -- Thm 2.4.6
    covers : T1.Trunc[(k : Nat) -> CH.Cover (T.C k)].carrier = P243.cc1 (\ k -> CH.Cover (T.C k)) (\ k -> (T.cC k).2.2) ;
    injective-prop : isProp (Injective H.canonical) =
      F.isProp-Pi H.PC.colim (\ u -> (v : H.PC.colim) -> Id H.Target (H.canonical u) (H.canonical v) -> Id H.PC.colim u v) (\ u ->
        F.isProp-Pi H.PC.colim (\ v -> Id H.Target (H.canonical u) (H.canonical v) -> Id H.PC.colim u v) (\ v ->
          F.isProp-Pi (Id H.Target (H.canonical u) (H.canonical v)) (\ e -> Id H.PC.colim u v) (\ e -> H.PC.set u v))) ;
    injective : Injective H.canonical =
      TC1.rec ((k : Nat) -> CH.Cover (T.C k)) @l (Injective H.canonical) injective-prop (\ cv -> WithCovers[cv].injective) covers ;
    surjective (phi : H.Target) : Tr.Trunc[Fibre H.canonical phi].carrier =
      TC1.rec ((k : Nat) -> CH.Cover (T.C k)) @l (Tr.Trunc[Fibre H.canonical phi].carrier) Tr.Trunc[Fibre H.canonical phi].proposition
        (\ cv -> WithCovers[cv].Surj[phi].result) covers ;
    equivalence : isEquiv H.PC.colim H.Target H.canonical = Bij[H.PC.colim, H.Target, H.target-set, H.canonical, injective, surjective].equiv ;
  } ;
  thm246 (T : HTower) : isEquiv (T23.Pis[ft T].PC.colim) (T23.Pis[ft T].Target) (T23.Pis[ft T].canonical) = Thm246[T].equivalence ;
} ;
