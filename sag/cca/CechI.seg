-- The Čech cohomology of the interval for the cover T x = cs^-1 x vanishes:
-- for an overtly discrete abelian group A and every k, Ȟ^k(I, T, A) = 0
-- (Cochains.Cech.Vanish; at k = 0 exactness at the 0-cochains).  This is
-- the computation in the proof of CCA Thm 3.4.3 (ii), (iii), in all
-- degrees.
--
-- Proof (as Thm343ii, with Lemma C.0.6 in place of C.0.5).  Let alpha be a
-- cocycle of length k + 1.  On the tuples it is a map
-- Sigma (x : I) (cs^-1 x)^(k+1) -> A, i.e. (Def. 3.4.2) lim_n I~^k_n -> A,
-- so (Prop. 2.3.7) it is delta0 o pi_n for some delta0 : I~^k_n -> A.
-- Extend delta0 by o off the near tuples to a cochain a0 on the vertices
-- V n; pulled back along the vertices of points of a fibre it is alpha, so
-- (naturality of delta) delta a0 vanishes on lim_n I~^(k+1)_n, and
-- (Prop. 2.3.7, injective) on I~^(k+1)_m for some m = e + n.  The cochain
-- a1 at stage m (delta0 o down, extended by o) agrees on near tuples with
-- a0 pulled back along down : V m -> V n, so it is a cocycle on near
-- tuples (locality, naturality), and Lemma C.0.6 gives beta0 at stage m
-- with delta beta0 = a1 on near tuples.  Then beta t = beta0 (the m-th
-- vertices of t) has delta beta = alpha (naturality again).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open SeqColim[l] ; open Logic[l] ; open FinChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module SA = StoneAxioms[l,l] ;
module OD = ODisc[l] ;
module FCo = FiniteCode[l] ;
module Eq = Equivalences[l] ;
module To = Torsor[l] ;
module In = Interval[l] ;
module Dy = Dyadic[l] ;
module D342 = Def342[l] ;
module L236 = Lemma236[l] ;
module Co = Cochains[l] ;
module C6 = LemmaC06[l] ;

-- the points of a tuple, going down e stages
pts-down (n j : Nat) : (e : Nat) (u : Dy.Tuples j (plus e n)) (i : Fin (suc j)) ->
  Id (Dy.V n) ((FCo.down (Dy.Tuples j) (Dy.tuple-down j) n e u).1 i) (FCo.down Dy.V Dy.v-down n e (u.1 i)) = split {
  zero -> \ u i -> refl (u.1 i) ;
  suc e | r -> \ u i -> r (Dy.tuple-down j (plus e n) u) i } ;
-- the vertex of a point of 2^N at stage m
vtx (m : Nat) (y : Nat -> Bool) : Dy.V m = (In.N m y, Dy.num-below m y) ;

module Over (ax : SA.Assumptions) {
  module CechI (Gr : To.Ab) (oA : OD.isODisc Gr.A) (k : Nat) {
    open Gr ;
    open Co.AbSub[Gr] ;
    module CC = Co.Cech[In.I, Fibre In.cs, \ x -> Gr] ;
    vx (m : Nat) (x : In.I) (y : Fibre In.cs x) : Dy.V m = vtx m y.1 ;
    module D1 = D342.Def342[k] ;
    module D2 = D342.Def342[suc k] ;
    Fib1 : U l = (x : In.I) * (Fin (suc k) -> Fibre In.cs x) ;
    Fib2 : U l = (x : In.I) * (Fin (suc (suc k)) -> Fibre In.cs x) ;
    tup1 (m : Nat) (w : Fib1) : Dy.Tuples k m = (D1.def342.1 w).1 m ;
    tup2 (m : Nat) (w : Fib2) : Dy.Tuples (suc k) m = (D2.def342.1 w).1 m ;
    tup1-pts (m : Nat) (w : Fib1) : Id (Fin (suc k) -> Dy.V m) (tup1 m w).1 (\ i -> vx m w.1 (w.2 i)) = refl (\ i -> vx m w.1 (w.2 i)) ;
    module M1 = L236.FMaps[Dy.Tuples k, Dy.tuple-down k, A, setA] ;
    module M2 = L236.FMaps[Dy.Tuples (suc k), Dy.tuple-down (suc k), A, setA] ;
    eqv1 : isEquiv M1.CF.colim (M1.Lim -> A) M1.canonical =
      Prop237[l].Over[ax].prop237 (Dy.Tuples k) (Dy.tuple-down k) (\ n -> Dy.TupleFinite[k, n].finite) A setA oA ;
    eqv2 : isEquiv M2.CF.colim (M2.Lim -> A) M2.canonical =
      Prop237[l].Over[ax].prop237 (Dy.Tuples (suc k)) (Dy.tuple-down (suc k)) (\ n -> Dy.TupleFinite[suc k, n].finite) A setA oA ;

    -- a map on the near tuples, extended by o
    ext-at (m j : Nat) (g : Dy.Tuples j m -> A) (t : Fin (suc j) -> Dy.V m) : Dec (Dy.Pairwise j m t) -> A = split {
      yes p -> g (t, p) ; no np -> o } ;
    ext (m j : Nat) (g : Dy.Tuples j m -> A) : Co.Cochains[Gr, Dy.V m].C (suc j) = \ t -> ext-at m j g t (Dy.TupleFinite[j, m].pairwise-dec t) ;
    ext-eq-at (m j : Nat) (g : Dy.Tuples j m -> A) (t : Fin (suc j) -> Dy.V m) (p : Dy.Pairwise j m t) :
      (dd : Dec (Dy.Pairwise j m t)) -> Id A (ext-at m j g t dd) (g (t, p)) = split {
      yes p' -> apH (\ q -> g (t, q)) (Dy.pairwise-prop j m t p' p) ;
      no np -> absurd (Id A o (g (t, p))) (np p) } ;
    ext-eq (m j : Nat) (g : Dy.Tuples j m -> A) (t : Fin (suc j) -> Dy.V m) (p : Dy.Pairwise j m t) : Id A (ext m j g t) (g (t, p)) =
      ext-eq-at m j g t p (Dy.TupleFinite[j, m].pairwise-dec t) ;
    -- at the points of a near tuple u
    ext-tuple (m j : Nat) (g : Dy.Tuples j m -> A) (u : Dy.Tuples j m) (t : Fin (suc j) -> Dy.V m)
      (pts : (i : Fin (suc j)) -> Id (Dy.V m) (u.1 i) (t i)) : Id A (ext m j g t) (g u) =
      transH (ext-eq m j g t (substH (Dy.Pairwise j m) (F.funext (Fin (suc j)) (\ i -> Dy.V m) u.1 t pts) u.2))
        (apH g (D342.Def342[j].t-eq m (t, substH (Dy.Pairwise j m) (F.funext (Fin (suc j)) (\ i -> Dy.V m) u.1 t pts) u.2) u (\ i -> symH (pts i)))) ;

    module Cocycle (alpha : CC.Ch (suc k)) (ca : CC.isCocycle k alpha) {
      D (w : Fib1) : A = alpha w.1 w.2 ;
      D' (z : D1.Lim) : A = D (D1.def342.2.sec z) ;
      module Stage (n : Nat) (delta0 : Dy.Tuples k n -> A) (hd : (z : D1.Lim) -> Id A (delta0 (z.1 n)) (D' z)) {
        module Vn = Co.Cochains[Gr, Dy.V n] ;
        at-fib (w : Fib1) : Id A (delta0 (tup1 n w)) (D w) =
          transH (hd (D1.def342.1 w)) (apH D (sec-ret Fib1 D1.Lim D1.def342.1 D1.def342.2 w)) ;
        a0 : Vn.C (suc k) = ext n k delta0 ;
        -- pulled back to a fibre, a0 is alpha
        pull-eq (x : In.I) (t : Fin (suc k) -> Fibre In.cs x) : Id A (a0 (\ i -> vx n x (t i))) (alpha x t) =
          transH (ext-eq n k delta0 (\ i -> vx n x (t i)) (tup1 n (x, t)).2) (at-fib (x, t)) ;
        C1 (u : Dy.Tuples (suc k) n) : A = Vn.delta (suc k) a0 u.1 ;
        C2 (u : Dy.Tuples (suc k) n) : A = o ;
        agree-fib (w : Fib2) : Id A (C1 (tup2 n w)) o = calc A {
          C1 (tup2 n w)
            =< symH (Co.Natural[Gr, Fibre In.cs w.1, Dy.V n, vx n w.1].natural (suc k) a0 w.2) >
          Co.Cochains[Gr, Fibre In.cs w.1].delta (suc k) (Co.Natural[Gr, Fibre In.cs w.1, Dy.V n, vx n w.1].pull (suc k) a0) w.2
            =< Co.Cochains[Gr, Fibre In.cs w.1].delta-cong (suc k) (Co.Natural[Gr, Fibre In.cs w.1, Dy.V n, vx n w.1].pull (suc k) a0) (alpha w.1)
                 (pull-eq w.1) w.2 >
          CC.d (suc k) alpha w.1 w.2 =< ca w.1 w.2 > o } ;
        agree-lim (z : D2.Lim) : Id A (C1 (z.1 n)) (C2 (z.1 n)) =
          substH (\ z1 -> Id A (C1 (z1.1 n)) o) (D2.def342.2.sec-eq z) (agree-fib (D2.def342.2.sec z)) ;
        same : Id M2.CF.colim (M2.CF.inc n C1) (M2.CF.inc n C2) =
          Eq.injective M2.CF.colim (M2.Lim -> A) M2.canonical eqv2 (M2.CF.inc n C1) (M2.CF.inc n C2) (calc (M2.Lim -> A) {
            M2.canonical (M2.CF.inc n C1) =< M2.canonical-inc n C1 > M2.restrict n C1
              =< F.funext M2.Lim (\ z -> A) (M2.restrict n C1) (M2.restrict n C2) agree-lim > M2.restrict n C2
              =< symH (M2.canonical-inc n C2) > M2.canonical (M2.CF.inc n C2) }) ;
        module Later (w : (e : Nat) * Id (Dy.Tuples (suc k) (plus e n) -> A) (M2.CF.shift e n C1) (M2.CF.shift e n C2)) {
          m : Nat = plus w.1 n ;
          module Vm = Co.Cochains[Gr, Dy.V m] ;
          module LC = C6.LemmaC06[Gr, m] ;
          module Rm = Vm.Region[LC.Nr, \ a -> In.near-refl a.1, \ a b -> In.near-sym a.1 b.1] ;
          dn1 (t : Dy.Tuples k m) : Dy.Tuples k n = FCo.down (Dy.Tuples k) (Dy.tuple-down k) n w.1 t ;
          dn2 (u : Dy.Tuples (suc k) m) : Dy.Tuples (suc k) n = FCo.down (Dy.Tuples (suc k)) (Dy.tuple-down (suc k)) n w.1 u ;
          vd (a : Dy.V m) : Dy.V n = FCo.down Dy.V Dy.v-down n w.1 a ;
          module ND = Co.Natural[Gr, Dy.V m, Dy.V n, vd] ;
          a1 : Vm.C (suc k) = ext m k (\ t -> delta0 (dn1 t)) ;
          agree-a1 (t : Vm.Tup (suc k)) (g : Rm.Good LC.All (suc k) t) : Id A (a1 t) (ND.pull (suc k) a0 t) =
            transH (ext-tuple m k (\ t1 -> delta0 (dn1 t1)) (t, g.2) t (\ i -> refl (t i)))
              (symH (ext-tuple n k delta0 (dn1 (t, g.2)) (ND.ftup (suc k) t) (pts-down n k w.1 (t, g.2)))) ;
          cocycle-m : LC.Cocycle LC.All k a1 = \ s g -> calc A {
            Vm.delta (suc k) a1 s =< Rm.locality (suc k) LC.All a1 (ND.pull (suc k) a0) agree-a1 s g >
            Vm.delta (suc k) (ND.pull (suc k) a0) s =< ND.natural (suc k) a0 s >
            Vn.delta (suc k) a0 (ND.ftup (suc (suc k)) s)
              =< apH (Vn.delta (suc k) a0) (F.funext (Fin (suc (suc k))) (\ i -> Dy.V n) (ND.ftup (suc (suc k)) s) (dn2 (s, g.2)).1
                   (\ i -> symH (pts-down n (suc k) w.1 (s, g.2) i))) >
            C1 (dn2 (s, g.2)) =< symH (M2.shift-down n C1 w.1 (s, g.2)) > M2.CF.shift w.1 n C1 (s, g.2)
              =< happly (Dy.Tuples (suc k) m) (\ u1 -> A) (M2.CF.shift w.1 n C1) (M2.CF.shift w.1 n C2) w.2 (s, g.2) >
            M2.CF.shift w.1 n C2 (s, g.2) =< M2.shift-down n C2 w.1 (s, g.2) > o } ;
          -- Lemma C.0.6 at stage m
          ex : (b : Vm.C k) * LC.Solves LC.All k a1 b = LC.exact k a1 cocycle-m ;
          beta : CC.Ch k = \ x t -> ex.1 (\ i -> vx m x (t i)) ;
          bound (x : In.I) (t : Fin (suc k) -> Fibre In.cs x) : Id A (CC.d k beta x t) (alpha x t) = calc A {
            CC.d k beta x t =< Co.Natural[Gr, Fibre In.cs x, Dy.V m, vx m x].natural k ex.1 t >
            Vm.delta k ex.1 (\ i -> vx m x (t i)) =< ex.2 (\ i -> vx m x (t i)) (\ i -> tt, (tup1 m (x, t)).2) >
            a1 (\ i -> vx m x (t i)) =< ext-tuple m k (\ t1 -> delta0 (dn1 t1)) (tup1 m (x, t)) (\ i -> vx m x (t i)) (\ i -> refl (vx m x (t i))) >
            delta0 (dn1 (tup1 m (x, t))) =< apH delta0 (M1.down-lim n (D1.def342.1 (x, t)) w.1) >
            delta0 (tup1 n (x, t)) =< at-fib (x, t) > alpha x t } ;
          result : Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].carrier =
            Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].inc (beta, bound) ;
        } ;
        result : Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].carrier =
          TC.rec ((e : Nat) * Id (Dy.Tuples (suc k) (plus e n) -> A) (M2.CF.shift e n C1) (M2.CF.shift e n C2)) @l
            (Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].carrier)
            Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].proposition (\ v -> Later[v].result)
            (SeqProp[l].IdColim[M2.seq, M2.stage-set, n, C1, C2].to same) ;
      } ;
      result : Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].carrier =
        M1.CF.induction @l (\ u -> Id (M1.Lim -> A) (M1.canonical u) D' -> Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].carrier)
          (\ u -> F.isProp-Pi (Id (M1.Lim -> A) (M1.canonical u) D') (\ e -> Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].carrier)
            (\ e -> Tr.Trunc[(b : CC.Ch k) * CC.Bounds k alpha b].proposition))
          (\ n delta0 e -> Stage[n, delta0, happly M1.Lim (\ z -> A) (M1.restrict n delta0) D' (transH (symH (M1.canonical-inc n delta0)) e)].result)
          (eqv1.sec D') (eqv1.sec-eq D') ;
    } ;
    vanish : CC.Vanish k = \ alpha ca -> Cocycle[alpha, ca].result ;
  } ;
  -- Ȟ^k(I, cs^-1, A) = 0 for every k
  cech-I (Gr : To.Ab) (oA : OD.isODisc Gr.A) (k : Nat) : Co.Cech[In.I, Fibre In.cs, \ x -> Gr].Vanish k = CechI[Gr, oA, k].vanish ;
} ;
