-- CCA Prop. 2.4.5 (Tychonov's dual for compact Hausdorff spaces): for C
-- compact Hausdorff and I x overtly discrete, (x : C) -> I x is overtly
-- discrete.
--
-- Proof.  Take a cover p : S ->> C with S Stone.  (x : C) -> I x is the
-- subtype of the g : (s : S) -> I (p s) that are compatible
-- (Prop239.Descent238), and (s : S) -> I (p s) is overtly discrete
-- (Prop. 2.3.9).  Compatibility is equivalent to
--   for all (s, s', e) in E = { s, s' : S | p s = p s' }, e_* (g s) = g s',
-- (for points (s, e), (s', e') of a fibre over x use e . e'^-1; the
-- converse is the pair (s, e), (s', refl)), a forall over the Stone space
-- E (identity types of C are closed) of open propositions, so open by
-- Lemma 2.1.5.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Bijection[l] ; open ODisc[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module OC = OpenClosed[l,l] ;
module CH = CHaus[l] ;
module L27 = Lemma27[l] ;
module L28 = Lemma28[l,l] ;

-- e_* (e . e'^-1)_* t = e_* t, for e' : b = x, e : a = x
cancel (C : U l) (I : C -> U l) (a b x : C) (v : Id C b x) (w : Id C a x) (t : I a) :
  Id (I x) (substH I v (substH I (transH w (symH v)) t)) (substH I w t) =
  idJ C b (\ x1 v1 -> (w1 : Id C a x1) -> Id (I x1) (substH I v1 (substH I (transH w1 (symH v1)) t)) (substH I w1 t))
    (\ w1 -> refl (substH I w1 t)) x v w ;

module Over (ax : SA.Assumptions) {
  module P214 = Prop214[l].Over[ax] ;
  module CP = CountableProduct[l].Over[ax] ;
  module P239 = Prop239[l].Over[ax] ;
  module Prop245 (C : U l) (cC : CH.isCHaus C) (I : C -> U l) (sI : (x : C) -> isSet (I x)) (oI : (x : C) -> isODisc (I x)) {
    module WithCover (cv : CH.Cover C) {
      S : U l = cv.1 ;
      p (s : S) : C = cv.2.2.1 s ;
      module PP = P239.Pairs238[C, S, p, I] ;
      E : U l = (u : S * S) * Id C (p u.1) (p u.2) ;
      e-stone : PF.isStone E = CP.sub-stone (S * S) (P214.product-stone S S cv.2.1 cv.2.1) (\ u -> Id C (p u.1) (p u.2))
        (\ u -> cC.1 (p u.1) (p u.2)) (\ u -> cC.2.1 (p u.1) (p u.2)) ;
      Agree (g : PP.Lifts) (w : E) : U l = Id (I (p w.1.2)) (substH I w.2 (g w.1.1)) (g w.1.2) ;
      Compat (g : PP.Lifts) : U l = (w : E) -> Agree g w ;
      to-compat (g : PP.Lifts) (c : Compat g) : PP.Compat g = \ w ->
        transH (symH (cancel C I (p w.2.1.1) (p w.2.2.1) w.1 w.2.2.2 w.2.1.2 (g w.2.1.1)))
          (apH (substH I w.2.2.2) (c ((w.2.1.1, w.2.2.1), transH w.2.1.2 (symH w.2.2.2)))) ;
      from-compat (g : PP.Lifts) (c : PP.Compat g) : Compat g = \ w ->
        c (p w.1.2, (w.1.1, w.2), (w.1.2, refl (p w.1.2))) ;
      copen (g : PP.Lifts) : OC.isOpen (PP.Compat g) =
        OC.open-iff (PP.Compat g) (Compat g) (from-compat g, to-compat g)
          (P214.lemma215 E e-stone (Agree g) (\ w -> sI (p w.1.2) (substH I w.2 (g w.1.1)) (g w.1.2)) (\ w ->
            L28.odisc-open (Agree g w) (sI (p w.1.2) (substH I w.2 (g w.1.1)) (g w.1.2))
              (L27.id-odisc (I (p w.1.2)) (oI (p w.1.2)) (substH I w.2 (g w.1.1)) (g w.1.2)))) ;
      module D = P239.Descent238[C, S, p, cv.2.2.2, I, sI, oI, copen] ;
      result : isODisc ((x : C) -> I x) = D.result (P239.prop239 S cv.2.1 (\ s -> I (p s)) (\ s -> oI (p s))) ;
    } ;
    result : isODisc ((x : C) -> I x) =
      TC1.rec (CH.Cover C) @(l+) (isODisc ((x : C) -> I x)) T1.Trunc[Pres[(x : C) -> I x]].proposition
        (\ cv -> WithCover[cv].result) cC.2.2 ;
  } ;
  prop245 (C : U l) (cC : CH.isCHaus C) (I : C -> U l) (oI : (x : C) -> isODisc (I x)) : isODisc ((x : C) -> I x) =
    Prop245[C, cC, I, \ x -> L27.odisc-set (I x) (oI x), oI].result ;
} ;
