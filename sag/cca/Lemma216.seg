-- CCA Lemma 2.1.6: an increasing cover of a Stone space by subsets U i (field sub) is
-- eventually everything.
--
-- Proof.  By local choice there are a Stone space T and q : T ->> S with
-- an index i t and a point of U (i t) (q t) for each t.  By boundedness
-- (Prop. 2.1.4 (v)) some k bounds every i t, so U k (q t) for every t
-- (the U i increase); q is onto and U k x is a proposition, so U k x for
-- every x.  (The paper assumes the U i open; the proof does not use it.)
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module Fi = Finite[l] ;

-- an increasing sequence of subsets of S
record Increasing (S : U l) {
  sub : Nat -> S -> U l ;
  prop : (i : Nat) (x : S) -> isProp (sub i x) ;
  mono : (i : Nat) (x : S) -> sub i x -> sub (suc i) x ;
} ;

module Up (S : U l) (V : Increasing[S]) {
  -- from stage i to stage d + i, and to any later stage
  plus-up : (d i : Nat) (x : S) -> V.sub i x -> V.sub (plus d i) x = split {
    zero -> \ i x u -> u ;
    suc d | r -> \ i x u -> V.mono (plus d i) x (r i x u) } ;
  up (i k : Nat) (h : Le i k) (x : S) (u : V.sub i x) : V.sub k x = substH (\ j -> V.sub j x) h.2 (plus-up h.1 i x u) ;
  Cover (x : S) : U l = (i : Nat) * V.sub i x ;
  Everywhere : U l = Tr.Trunc[(k : Nat) * ((x : S) -> V.sub k x)].carrier ;
} ;

module Over (ax : SA.Assumptions) {
  module P214 = Prop214[l].Over[ax] ;
  module Lemma216 (S : U l) (sS : PF.isStone S) (V : Increasing[S]) {
    module W = Up[S, V] ;
    module Chosen (cv : Prop214[l].Cover[S, W.Cover]) {
      index (t : cv.T) : Nat = (cv.section t).1 ;
      everywhere (b : Fi.Bound cv.T index) (x : S) : V.sub b.1 x =
        TC.rec (Bijection[l].Fibre cv.q x) @l (V.sub b.1 x) (V.prop b.1 x)
          (\ w -> substH (V.sub b.1) w.2 (W.up (index w.1) b.1 (b.2 w.1) (cv.q w.1) (cv.section w.1).2))
          (cv.onto x) ;
      result : W.Everywhere =
        TC.map (Fi.Bound cv.T index) ((k : Nat) * ((x : S) -> V.sub k x)) (\ b -> (b.1, everywhere b))
          (P214.bounded cv.T cv.stone index) ;
    } ;
    result (cover : (x : S) -> Tr.Trunc[W.Cover x].carrier) : W.Everywhere =
      TC1.rec (Prop214[l].Cover[S, W.Cover]) @l W.Everywhere Tr.Trunc[(k : Nat) * ((x : S) -> V.sub k x)].proposition
        (\ cv -> Chosen[cv].result) (P214.local S sS W.Cover cover) ;
  } ;
  lemma216 (S : U l) (sS : PF.isStone S) (V : Increasing[S]) (cover : (x : S) -> Tr.Trunc[Up[S, V].Cover x].carrier)
    : Up[S, V].Everywhere = Lemma216[S, sS, V].result cover ;
} ;
