-- CCA Prop. 2.3.7, for a tower of finite sets: for E 0 <- E 1 <- .. finite
-- and I overtly discrete, the canonical map
--   colim_k (E k -> I)  ->  (lim E -> I),   [g] |-> g o pi_k
-- is an equivalence.  (The paper: a tower of Stone spaces.)
--
-- Let I = colim_i J i with J i finite, psi : I = colim J.
-- Injective.  At a common stage N, let g, g' : E N -> I agree on lim E.
--   (1) E N is finite, so g and g' factor through one stage m of J:
--       psi (g y) = [H y], psi (g' y) = [H' y] (finite choice, a bound).
--   (2) For x : lim E, [H x_N] = [H' x_N], so some d has
--       shift_d (H x_N) = shift_d (H' x_N); by Lemma 2.1.6 (lim E is Stone)
--       one d serves every x.
--   (3) So k = shift_d o H and k' = shift_d o H' : E N -> J (d + m) agree on
--       lim E, and by Lemma 2.3.6 they agree after e more steps: on
--       E (e + N), k o down = k' o down.
--   (4) Then psi o g o down = psi o g' o down, so g and g' agree after e
--       steps (psi is injective), and [g] = [g'].
-- Surjective.  Let f : lim E -> I.  By Prop. 2.3.5 (lim E Stone, the
--   constant tower J) psi o f = [h] for some h : lim E -> J i, and by
--   Lemma 2.3.6 h = h' o pi_K for some h' : E K -> J i; then
--   g = psi^-1 o [-] o h' : E K -> I has g o pi_K = f.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open SeqColim[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module Fi = Finite[l] ;
module FCl = FiniteClosure[l] ;
module OD = ODisc[l] ;
module FCo = FiniteCode[l] ;
module L216 = Lemma216[l] ;
module L236 = Lemma236[l] ;
module P235 = Prop235[l] ;

module Over (ax : SA.Assumptions) {
  module Scott237 (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) (sE : (n : Nat) -> PF.isStone (E n))
    (I : U l) (sI : isSet I) (pr : OD.Pres[I]) {
    J : Seq = pr.seq ;
    module CJ = Colim[J] ;
    sJ (i : Nat) : isSet (J.A i) = FCl.finite-set (J.A i) (pr.finite i) ;
    psi (a : I) : CJ.colim = pr.equiv.1 a ;
    unpsi (c : CJ.colim) : I = pr.equiv.2.sec c ;
    unpsi-psi (a : I) : Id I (unpsi (psi a)) a = sec-ret I CJ.colim pr.equiv.1 pr.equiv.2 a ;
    module M = L236.FMaps[E, p, I, sI] ;
    lim-stone : PF.isStone M.Lim = CountableProduct[l].Over[ax].lim-stone E p sE ;
    -- maps into the stage J i
    module MJ (i : Nat) { module L = Lemma236Stone[l].Over[ax].Stone236[E, p, sE, J.A i, pr.finite i] ; } ;
    -- the class [z] of z : J n raised to a later stage
    lift (y : CJ.colim) (n k : Nat) (h : Le n k) (w : (z : J.A n) * Id CJ.colim (CJ.inc n z) y)
      : (z : J.A k) * Id CJ.colim (CJ.inc k z) y = (CJ.raise n k h w.1, transH (CJ.inc-raise n k h w.1) w.2) ;

    -- injective, at one stage
    module Same (N : Nat) (g g' : E N -> I) (e : (x : M.Lim) -> Id I (g (x.1 N)) (g' (x.1 N))) {
      -- (1) g and g' through one stage of J
      Lift (a : I) (n : Nat) : U l = (z : J.A n) * Id CJ.colim (CJ.inc n z) (psi a) ;
      Q (y : E N) (n : Nat) : U l = Lift (g y) n * Lift (g' y) n ;
      -- a : E N -> I through a stage of J (Prop. 2.3.5 for the Stone space E N)
      Tw0 : P235.Tower[E N] = P235.mkTower (E N) (\ y -> J) (\ i y -> sJ i) ;
      module C0 = P235.Colims[E N, Tw0] ;
      factor (a : E N -> I) : Tr.Trunc[(n : Nat) * ((y : E N) -> Lift (a y) n)].carrier =
        TC.rec ((u : C0.CP.colim) * Id C0.Target (C0.canonical u) (\ y -> psi (a y))) @l
          (Tr.Trunc[(n : Nat) * ((y : E N) -> Lift (a y) n)].carrier) Tr.Trunc[(n : Nat) * ((y : E N) -> Lift (a y) n)].proposition (\ v ->
          C0.CP.induction @l (\ u -> Id C0.Target (C0.canonical u) (\ y -> psi (a y)) -> Tr.Trunc[(n : Nat) * ((y : E N) -> Lift (a y) n)].carrier)
            (\ u -> F.isProp-Pi (Id C0.Target (C0.canonical u) (\ y -> psi (a y))) (\ q -> Tr.Trunc[(n : Nat) * ((y : E N) -> Lift (a y) n)].carrier)
              (\ q -> Tr.Trunc[(n : Nat) * ((y : E N) -> Lift (a y) n)].proposition))
            (\ n h q -> Tr.Trunc[(n' : Nat) * ((y : E N) -> Lift (a y) n')].inc (n, \ y -> (h y,
               happly (E N) (\ y1 -> CJ.colim) (C0.pointwise n h) (\ y1 -> psi (a y1)) (transH (symH (C0.canonical-inc n h)) q) y)))
            v.1 v.2)
          (P235.Over[ax].Prop235[E N, sE N, Tw0].Surjectivity[\ y -> psi (a y)].result) ;
      both (u : (n : Nat) * ((y : E N) -> Lift (g y) n)) (v : (n : Nat) * ((y : E N) -> Lift (g' y) n)) : (n : Nat) * ((y : E N) -> Q y n) =
        (plus v.1 u.1, \ y -> (lift (psi (g y)) u.1 (plus v.1 u.1) (le-sum-r u.1 v.1) (u.2 y),
          lift (psi (g' y)) v.1 (plus v.1 u.1) (le-sum-l u.1 v.1) (v.2 y))) ;
      start : Tr.Trunc[(n : Nat) * ((y : E N) -> Q y n)].carrier =
        TC.map2 ((n : Nat) * ((y : E N) -> Lift (g y) n)) ((n : Nat) * ((y : E N) -> Lift (g' y) n)) ((n : Nat) * ((y : E N) -> Q y n)) both
          (factor g) (factor g') ;
      Goal : U l = Id M.CF.colim (M.CF.inc N g) (M.CF.inc N g') ;
      goal-prop : isProp Goal = M.CF.set (M.CF.inc N g) (M.CF.inc N g') ;
      module Stage (m : Nat) (qs : (y : E N) -> Q y m) {
        H (y : E N) : J.A m = (qs y).1.1 ;
        H' (y : E N) : J.A m = (qs y).2.1 ;
        -- (2) one d for every point of lim E
        at-lim (x : M.Lim) : Id CJ.colim (CJ.inc m (H (x.1 N))) (CJ.inc m (H' (x.1 N))) =
          transH (qs (x.1 N)).1.2 (transH (apH psi (e x)) (symH (qs (x.1 N)).2.2)) ;
        agree : L216.Increasing[M.Lim] = L216.mkIncreasing M.Lim
          (\ d x -> Id (J.A (plus d m)) (CJ.shift d m (H (x.1 N))) (CJ.shift d m (H' (x.1 N))))
          (\ d x -> sJ (plus d m) (CJ.shift d m (H (x.1 N))) (CJ.shift d m (H' (x.1 N))))
          (\ d x q -> apH (J.f (plus d m)) q) ;
        cover (x : M.Lim) : Tr.Trunc[L216.Up[M.Lim, agree].Cover x].carrier =
          SeqProp[l].IdColim[J, sJ, m, H (x.1 N), H' (x.1 N)].to (at-lim x) ;
        module Shift (d : Nat) (ag : (x : M.Lim) -> agree.sub d x) {
          k (y : E N) : J.A (plus d m) = CJ.shift d m (H y) ;
          k' (y : E N) : J.A (plus d m) = CJ.shift d m (H' y) ;
          module L = MJ[plus d m].L ;
          -- (3) k and k' agree after e steps (Lemma 2.3.6)
          same-k : Id L.M.CF.colim (L.M.CF.inc N k) (L.M.CF.inc N k') =
            L.injective (L.M.CF.inc N k) (L.M.CF.inc N k') (calc (M.Lim -> J.A (plus d m)) {
              L.M.canonical (L.M.CF.inc N k) =< L.M.canonical-inc N k > L.M.restrict N k
                =< F.funext M.Lim (\ x -> J.A (plus d m)) (L.M.restrict N k) (L.M.restrict N k') ag > L.M.restrict N k'
                =< symH (L.M.canonical-inc N k') > L.M.canonical (L.M.CF.inc N k') }) ;
          -- (4) then g and g' agree after e steps
          module After (w : (e' : Nat) * Id (E (plus e' N) -> J.A (plus d m)) (L.M.CF.shift e' N k) (L.M.CF.shift e' N k')) {
            down (y : E (plus w.1 N)) : E N = FCo.down E p N w.1 y ;
            k-down (y : E (plus w.1 N)) : Id (J.A (plus d m)) (k (down y)) (k' (down y)) =
              transH (symH (L.M.shift-down N k w.1 y)) (transH (happly (E (plus w.1 N)) (\ z -> J.A (plus d m)) (L.M.CF.shift w.1 N k) (L.M.CF.shift w.1 N k') w.2 y) (L.M.shift-down N k' w.1 y)) ;
            psi-down (y : E (plus w.1 N)) : Id CJ.colim (psi (g (down y))) (psi (g' (down y))) = calc CJ.colim {
              psi (g (down y)) =< symH (qs (down y)).1.2 > CJ.inc m (H (down y))
                =< symH (CJ.inc-shift d m (H (down y))) > CJ.inc (plus d m) (k (down y))
                =< apH (CJ.inc (plus d m)) (k-down y) > CJ.inc (plus d m) (k' (down y))
                =< CJ.inc-shift d m (H' (down y)) > CJ.inc m (H' (down y))
                =< (qs (down y)).2.2 > psi (g' (down y)) } ;
            g-down (y : E (plus w.1 N)) : Id I (M.CF.shift w.1 N g y) (M.CF.shift w.1 N g' y) = calc I {
              M.CF.shift w.1 N g y =< M.shift-down N g w.1 y > g (down y)
                =< symH (unpsi-psi (g (down y))) > unpsi (psi (g (down y)))
                =< apH unpsi (psi-down y) > unpsi (psi (g' (down y)))
                =< unpsi-psi (g' (down y)) > g' (down y)
                =< symH (M.shift-down N g' w.1 y) > M.CF.shift w.1 N g' y } ;
            result : Goal = calc M.CF.colim {
              M.CF.inc N g =< symH (M.CF.inc-shift w.1 N g) > M.CF.inc (plus w.1 N) (M.CF.shift w.1 N g)
                =< apH (M.CF.inc (plus w.1 N)) (F.funext (E (plus w.1 N)) (\ y -> I) (M.CF.shift w.1 N g) (M.CF.shift w.1 N g') g-down) >
                M.CF.inc (plus w.1 N) (M.CF.shift w.1 N g')
                =< M.CF.inc-shift w.1 N g' > M.CF.inc N g' } ;
          } ;
          result : Goal =
            TC.rec ((e' : Nat) * Id (E (plus e' N) -> J.A (plus d m)) (L.M.CF.shift e' N k) (L.M.CF.shift e' N k')) @l Goal goal-prop
              (\ w -> After[w].result)
              (SeqProp[l].IdColim[L.M.seq, \ n -> L.M.stage-set n, N, k, k'].to same-k) ;
        } ;
        result : Goal =
          TC.rec ((d : Nat) * ((x : M.Lim) -> agree.sub d x)) @l Goal goal-prop (\ w -> Shift[w.1, w.2].result)
            (L216.Over[ax].lemma216 M.Lim lim-stone agree cover) ;
      } ;
      result : Goal =
        TC.rec ((n : Nat) * ((y : E N) -> Q y n)) @l Goal goal-prop (\ w -> Stage[w.1, w.2].result)
          start ;
    } ;
    injective : Injective M.canonical =
      StageInjective[l].StageInjective[M.seq, M.Lim -> I, M.canonical, \ N g g' q ->
        Same[N, g, g', happly M.Lim (\ x -> I) (M.restrict N g) (M.restrict N g')
          (transH (symH (M.canonical-inc N g)) (transH q (M.canonical-inc N g')))].result].injective ;

    -- surjective
    Tw : P235.Tower[M.Lim] = P235.mkTower M.Lim (\ x -> J) (\ i x -> sJ i) ;
    module C = P235.Colims[M.Lim, Tw] ;
    module Onto (f : M.Lim -> I) {
      Goal : U l = Tr.Trunc[Fibre M.canonical f].carrier ;
      phi : C.Target = \ x -> psi (f x) ;
      -- psi o f = [h], h : lim E -> J i, and h = h' o pi_K
      module Factor (i : Nat) (h : M.Lim -> J.A i) (hf : (x : M.Lim) -> Id CJ.colim (CJ.inc i (h x)) (psi (f x))) {
        module L = MJ[i].L ;
        module Stage (K : Nat) (h' : E K -> J.A i) (eq : (x : M.Lim) -> Id (J.A i) (h' (x.1 K)) (h x)) {
          g (y : E K) : I = unpsi (CJ.inc i (h' y)) ;
          at-point (x : M.Lim) : Id I (g (x.1 K)) (f x) = calc I {
            g (x.1 K) =< apH (\ z -> unpsi (CJ.inc i z)) (eq x) > unpsi (CJ.inc i (h x))
              =< apH unpsi (hf x) > unpsi (psi (f x))
              =< unpsi-psi (f x) > f x } ;
          onto : Fibre M.canonical f =
            (M.CF.inc K g, transH (M.canonical-inc K g) (F.funext M.Lim (\ x -> I) (M.restrict K g) f at-point)) ;
        } ;
        result : Goal =
          TC.rec (Fibre L.M.canonical h) @l Goal Tr.Trunc[Fibre M.canonical f].proposition (\ v ->
            L.M.CF.induction @l (\ u -> Id (M.Lim -> J.A i) (L.M.canonical u) h -> Goal)
              (\ u -> F.isProp-Pi (Id (M.Lim -> J.A i) (L.M.canonical u) h) (\ q -> Goal) (\ q -> Tr.Trunc[Fibre M.canonical f].proposition))
              (\ K h' q -> Tr.Trunc[Fibre M.canonical f].inc (Stage[K, h', happly M.Lim (\ x -> J.A i) (L.M.restrict K h') h
                 (transH (symH (L.M.canonical-inc K h')) q)].onto))
              v.1 v.2)
            (L.surjective h) ;
      } ;
      result : Goal =
        TC.rec ((u : C.CP.colim) * Id C.Target (C.canonical u) phi) @l Goal Tr.Trunc[Fibre M.canonical f].proposition (\ v ->
          C.CP.induction @l (\ u -> Id C.Target (C.canonical u) phi -> Goal)
            (\ u -> F.isProp-Pi (Id C.Target (C.canonical u) phi) (\ q -> Goal) (\ q -> Tr.Trunc[Fibre M.canonical f].proposition))
            (\ i h q -> Factor[i, h, happly M.Lim (\ x -> CJ.colim) (C.pointwise i h) phi
               (transH (symH (C.canonical-inc i h)) q)].result)
            v.1 v.2)
          (P235.Over[ax].Prop235[M.Lim, lim-stone, Tw].Surjectivity[phi].result) ;
    } ;
    equivalence : isEquiv M.CF.colim (M.Lim -> I) M.canonical =
      Bij[M.CF.colim, M.Lim -> I, M.fun-set, M.canonical, injective, \ f -> Onto[f].result].equiv ;
  } ;
  -- for a tower of finite sets
  module Prop237 (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) (fin : (n : Nat) -> Fi.isFinite (E n))
    (I : U l) (sI : isSet I) (pr : OD.Pres[I]) {
    module G = Scott237[E, p, \ n -> Prop214[l].Over[ax].finite-stone (E n) (fin n), I, sI, pr] ;
    injective : Injective G.M.canonical = G.injective ;
    equivalence : isEquiv G.M.CF.colim (G.M.Lim -> I) G.M.canonical = G.equivalence ;
  } ;
  -- with I merely presented
  prop237-stone (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) (sE : (n : Nat) -> PF.isStone (E n))
    (I : U l) (sI : isSet I) (oI : OD.isODisc I) : isEquiv (L236.FMaps[E, p, I, sI].CF.colim) (L236.FMaps[E, p, I, sI].Lim -> I) (L236.FMaps[E, p, I, sI].canonical) =
    Truncation[l+].Trunc[OD.Pres[I]].induction @l
      (\ t -> isEquiv (L236.FMaps[E, p, I, sI].CF.colim) (L236.FMaps[E, p, I, sI].Lim -> I) (L236.FMaps[E, p, I, sI].canonical))
      (\ t -> AffineHLevels[l].EquivalenceProofs[L236.FMaps[E, p, I, sI].CF.colim, L236.FMaps[E, p, I, sI].Lim -> I,
         L236.FMaps[E, p, I, sI].fun-set, L236.FMaps[E, p, I, sI].canonical].proposition)
      (\ pr -> Scott237[E, p, sE, I, sI, pr].equivalence) oI ;
  prop237 (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) (fin : (n : Nat) -> Fi.isFinite (E n))
    (I : U l) (sI : isSet I) (oI : OD.isODisc I) : isEquiv (L236.FMaps[E, p, I, sI].CF.colim) (L236.FMaps[E, p, I, sI].Lim -> I) (L236.FMaps[E, p, I, sI].canonical) =
    Truncation[l+].Trunc[OD.Pres[I]].induction @l
      (\ t -> isEquiv (L236.FMaps[E, p, I, sI].CF.colim) (L236.FMaps[E, p, I, sI].Lim -> I) (L236.FMaps[E, p, I, sI].canonical))
      (\ t -> AffineHLevels[l].EquivalenceProofs[L236.FMaps[E, p, I, sI].CF.colim, L236.FMaps[E, p, I, sI].Lim -> I,
         L236.FMaps[E, p, I, sI].fun-set, L236.FMaps[E, p, I, sI].canonical].proposition)
      (\ pr -> Prop237[E, p, fin, I, sI, pr].equivalence) oI ;
} ;
