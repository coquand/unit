-- Fibres commute with sequential limits: for a map H : E -> G of inverse
-- sequences of finite sets and z : lim G, the fibre of lim H over z is the
-- limit of the fibres of H k over z k.
--
-- To the limit: the cone of the fibres of lim H (FibreSeq.Fibres.cone).
-- Back: a compatible sequence of points (e k, h k) of the fibres has
-- compatible first components (transport along a path of G keeps the first
-- component, FibrePairs.fib-subst), hence a point a of lim E, and the h k
-- say lim H a = z (equality in a limit of sets is componentwise).  The two
-- round trips are the identity on first components, and points of fibres
-- with equal first components are equal (G and lim G are sets).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Finite[l] ; open FiniteClosure[l] ; open SeqLim[l] ;

module LimFibre (SE SG : InvSeq) (H : InvMap[SE, SG]) (finE : (k : Nat) -> isFinite (SE.E k))
  (finG : (k : Nat) -> isFinite (SG.E k)) {
  module Fi = FibreSeq[l].Fibres[SE, SG, H, finE, finG] ;
  module O = Over[SG, Fi.Fib] ;
  fib-set (z : Limit[SG].lim) (k : Nat) : isSet (Fi.P[k].Q.fib (z.1 k)) =
    finite-set (Fi.P[k].Q.fib (z.1 k)) (Fi.fib-finite k (z.1 k)) ;

  to (z : Limit[SG].lim) (u : Fi.PL.fib z) : O.T-lim z = (\ k -> Fi.pr k z u, \ k -> Fi.cone.pc k z u) ;

  module Back (z : Limit[SG].lim) (v : O.T-lim z) {
    -- the first components are compatible
    compat (k : Nat) : Id (SE.E k) (SE.p k (v.1 (suc k)).1) (v.1 k).1 =
      transH (symH (Fi.P[k].Q.fib-subst (SG.p k (z.1 (suc k))) (z.1 k) (z.2 k) (Fi.Fib.q k (z.1 (suc k)) (v.1 (suc k)))))
        (apH (\ w -> w.1) (v.2 k)) ;
    a : Limit[SE].lim = (\ k -> (v.1 k).1, compat) ;
    over : Id (Limit[SG].lim) (lim-map SE SG H a) z =
      Limit[SG].Sets[Fi.sG].lim-eq (lim-map SE SG H a) z (\ k -> (v.1 k).2) ;
    point : Fi.PL.fib z = (a, over) ;
  } ;

  to-back (z : Limit[SG].lim) (v : O.T-lim z) : Id (O.T-lim z) (to z Back[z, v].point) v =
    Limit[O.fibre z].Sets[fib-set z].lim-eq (to z Back[z, v].point) v
      (\ k -> Fi.P[k].Q.fib-eq (z.1 k) (Fi.pr k z Back[z, v].point) (v.1 k) (refl (v.1 k).1)) ;
  back-to (z : Limit[SG].lim) (u : Fi.PL.fib z) : Id (Fi.PL.fib z) Back[z, to z u].point u =
    Fi.PL.fib-eq z Back[z, to z u].point u
      (Limit[SE].Sets[Fi.sE].lim-eq Back[z, to z u].a u.1 (\ k -> refl (u.1.1 k))) ;

  equiv (z : Limit[SG].lim) : Equiv (Fi.PL.fib z) (O.T-lim z) =
    (to z, qinv (Fi.PL.fib z) (O.T-lim z) (to z) (\ v -> Back[z, v].point) (to-back z) (back-to z)) ;
} ;
