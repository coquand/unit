-- CCA Lemma 3.4.4 (iii): for an overtly discrete abelian group A and every
-- m, K(A, m) is I-local (EMMaps.KK indexing: K 0 = A).
--
-- Proof, by induction on m.  m = 0: Lemma 3.4.4 (i), A is overtly
-- discrete.  m + 1: K(A, m+1) is connected, so each identity type
-- x = y is merely the loop space at the base point, which is K(A, m)
-- (EMMaps.KK.e m; univalence), I-local by induction; being I-local is a
-- proposition.  Every map I -> K(A, m+1) is merely constant by Thm 3.4.3
-- (iii) (I -> K(A, m+1) is 0-connected).  So K(A, m+1) is I-local
-- (Lemma344.ByIds, the argument of Lemma 3.4.4 (ii)).
level l ;
open Base ; open Prelude[l] ; open Paths[l+] ; open Torsor[l] ; open Connected[l] ; open EMMaps[l] ; open AbHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ;
module SA = StoneAxioms[l,l] ;
module OD = ODisc[l] ;
module In = Interval[l] ;
module L344 = Lemma344[l] ;
module UL = Axioms[l].UnivalenceLemmas[univ @l] ;

module Over (ax : SA.Assumptions) {
  module KLocal (Gr : Ab) (oA : OD.isODisc Gr.A) {
    module K = KK[Gr] ;
    local-prop (Z : U l) : Prelude[l+].isProp (L344.isLocal Z) = EquivProp[l+].isEquiv-prop Z (In.I -> Z) (\ z i -> z) ;
    -- the loop space is K(A, m)
    loops (m : Nat) : Id (U l) ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (K.K m) = UL.ua ((Id (K.K (suc m)) (K.pt (suc m)) (K.pt (suc m)))) (K.K m) ((K.e m).1.1, (K.e m).2) ;
    -- identity types of K(A, m+1)
    ids (m : Nat) (r : L344.isLocal (K.K m)) (x y : K.K (suc m)) : L344.isLocal (Id (K.K (suc m)) x y) =
      TC.rec (Id (K.K (suc m)) x (K.pt (suc m))) @(l+) (L344.isLocal (Id (K.K (suc m)) x y)) (local-prop (Id (K.K (suc m)) x y)) (\ p ->
        TC.rec (Id (K.K (suc m)) y (K.pt (suc m))) @(l+) (L344.isLocal (Id (K.K (suc m)) x y)) (local-prop (Id (K.K (suc m)) x y)) (\ q ->
          substH (\ z -> L344.isLocal (Id (K.K (suc m)) z y)) (symH p)
            (substH (\ z -> L344.isLocal (Id (K.K (suc m)) (K.pt (suc m)) z)) (symH q)
              (substH (\ T -> L344.isLocal T) (symH (loops m)) r)))
          (conn-path m (K.K (suc m)) (K.conn m) y (K.pt (suc m))))
        (conn-path m (K.K (suc m)) (K.conn m) x (K.pt (suc m))) ;
    -- maps I -> K(A, m+1) are merely constant
    onto (m : Nat) (f : In.I -> K.K (suc m)) : T1.Trunc[(z : K.K (suc m)) * Id (In.I -> K.K (suc m)) (\ i -> z) f].carrier =
      TC.rec (Id (In.I -> K.K (suc m)) (\ i -> K.pt (suc m)) f) @(l+)
        (T1.Trunc[(z : K.K (suc m)) * Id (In.I -> K.K (suc m)) (\ i -> z) f].carrier)
        T1.Trunc[(z : K.K (suc m)) * Id (In.I -> K.K (suc m)) (\ i -> z) f].proposition
        (\ p -> T1.Trunc[(z : K.K (suc m)) * Id (In.I -> K.K (suc m)) (\ i -> z) f].inc (K.pt (suc m), p))
        (conn-path zero (In.I -> K.K (suc m)) (Thm343iii[l].Over[ax].thm343iii Gr oA m) (\ i -> K.pt (suc m)) f) ;
    local : (m : Nat) -> L344.isLocal (K.K m) = split {
      zero -> L344.Over[ax].odisc-local Gr.A oA ;
      suc m | r -> L344.ByIds[K.K (suc m), ids m r, onto m].local } ;
  } ;
  em-local (Gr : Ab) (oA : OD.isODisc Gr.A) (m : Nat) : L344.isLocal (KK[Gr].K m) = KLocal[Gr, oA].local m ;
} ;
