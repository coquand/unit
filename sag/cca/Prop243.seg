-- CCA Lemma 2.4.2 and Prop. 2.4.3: compact Hausdorff spaces (Def. 2.4.1 =
-- SSD Def. 4.1, CHaus.isCHaus: a set with closed identity types, merely
-- covered by a Stone space).
--
-- Lemma 2.4.2.  For a tower C of compact Hausdorff spaces there are a tower
--   of Stone spaces S and p_k : S_k -> C_k, compatible, levelwise onto, with
--   lim S ->> lim C.  Choose covers q_k : T_k ->> C_k for all k at once
--   (countable choice); S_0 = T_0 and S_(k+1) = T_(k+1) x_(C_k) S_k (a closed
--   subset of a product of Stone spaces), p_(k+1) (t, s) = q_(k+1) t.  Then
--   S_(k+1) -> C_(k+1) x_(C_k) S_k is onto (q_(k+1) is); for y in lim C the
--   fibres of the p_k over the y_k form a tower with onto maps, so dependent
--   choice gives a point of lim S over y.
-- Prop. 2.4.3.  (i) Stone spaces are compact Hausdorff.  (ii) identity
--   types are closed propositions, hence Stone; Sigma is SSD Lemma 4.11.
--   (iii) for R a closed equivalence relation, X/R is a set with
--   [a] = [b] iff R a b (closed), covered by S ->> X ->> X/R.  (iv) lim C
--   has closed identity types (countably many closed equalities) and is
--   covered by lim S (Lemma 2.4.2, Prop. 2.1.4 (iii)).  (v) local choice on
--   a cover.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module OC = OpenClosed[l,l] ;
module CH = CHaus[l] ;
module DCh = DependentChoice[l] ;
module SL = SeqLim[l] ;

module Over (ax : SA.Assumptions) {
  module P214 = Prop214[l].Over[ax] ;
  module CP = CountableProduct[l].Over[ax] ;
  module CHO = CH.Over[ax] ;
  cc1 : CountableChoice[l+].CC = CountableChoice[l+].cc (ax.dc @(l+)) ;

  -- (i), (ii)
  stone-chaus (X : U l) (sX : PF.isStone X) : CH.isCHaus X = CHO.stone-chaus X sX ;
  finite-chaus (X : U l) (fX : Finite[l].isFinite X) : CH.isCHaus X = stone-chaus X (P214.finite-stone X fX) ;
  id-chaus (X : U l) (cX : CH.isCHaus X) (x y : X) : CH.isCHaus (Id X x y) =
    stone-chaus (Id X x y) (CP.closed-stone (Id X x y) (cX.1 x y) (cX.2.1 x y)) ;
  sigma-chaus (X : U l) (cX : CH.isCHaus X) (Y : X -> U l) (cY : (x : X) -> CH.isCHaus (Y x)) : CH.isCHaus ((x : X) * Y x) =
    Sigma411[l].Over[ax].sigma-chaus X cX Y cY ;

  -- (iii) quotients by closed equivalence relations
  module Quot (X : U l) (cX : CH.isCHaus X) (R : X -> X -> U l) (pR : (a b : X) -> isProp (R a b))
    (rr : (a : X) -> R a a) (rs : (a b : X) -> R a b -> R b a) (rt : (a b c : X) -> R a b -> R b c -> R a c)
    (cR : (a b : X) -> OC.isClosed (R a b)) {
    module Q = Quotient[l].Quot[X, R, pR, rr, rs, rt] ;
    id-closed (x y : Q.Q) : OC.isClosed (Id Q.Q x y) =
      Q.induction @l (\ x1 -> OC.isClosed (Id Q.Q x1 y)) (\ x1 -> Tr.Trunc[OC.ClosedW (Id Q.Q x1 y)].proposition) (\ a ->
        Q.induction @l (\ y1 -> OC.isClosed (Id Q.Q (Q.inc a) y1)) (\ y1 -> Tr.Trunc[OC.ClosedW (Id Q.Q (Q.inc a) y1)].proposition) (\ b ->
          OC.closed-iff (Id Q.Q (Q.inc a) (Q.inc b)) (R a b) (Q.effective a b, Q.relates a b) (cR a b)) y) x ;
    inc-onto : DCh.Surjective Q.inc = \ x ->
      Q.induction @l (\ x1 -> Tr.Trunc[Fibre Q.inc x1].carrier) (\ x1 -> Tr.Trunc[Fibre Q.inc x1].proposition)
        (\ a -> Tr.Trunc[Fibre Q.inc (Q.inc a)].inc (a, refl (Q.inc a))) x ;
    cover (cv : CH.Cover X) : CH.Cover Q.Q = (cv.1, cv.2.1, \ s -> Q.inc (cv.2.2.1 s), \ x ->
      TC.bind (Fibre Q.inc x) (Fibre {cv.1} {Q.Q} (\ s -> Q.inc (cv.2.2.1 s)) x) (\ u ->
        TC.map (Fibre cv.2.2.1 u.1) (Fibre {cv.1} {Q.Q} (\ s -> Q.inc (cv.2.2.1 s)) x) (\ v -> (v.1, transH (apH Q.inc v.2) u.2)) (cv.2.2.2 u.1))
        (inc-onto x)) ;
    chaus : CH.isCHaus Q.Q = (Q.set, id-closed, TC1.map (CH.Cover X) (CH.Cover Q.Q) cover cX.2.2) ;
  } ;

  -- (v) local choice
  module LocalCH (C : U l) (A : C -> U l) (cv : CH.Cover C) {
    module Lift (lc : Prop214[l].Cover[cv.1, \ s -> A (cv.2.2.1 s)]) {
      q (t : lc.T) : C = cv.2.2.1 (lc.q t) ;
      onto : DCh.Surjective q = \ x ->
        TC.bind (Fibre cv.2.2.1 x) (Fibre q x) (\ u ->
          TC.map (Fibre lc.q u.1) (Fibre q x) (\ v -> (v.1, transH (apH cv.2.2.1 v.2) u.2)) (lc.onto u.1)) (cv.2.2.2 x) ;
      result : Prop214[l].Cover[C, A] = Prop214[l].mkCover C A lc.T lc.stone q onto lc.section ;
    } ;
    result (h : (x : C) -> Tr.Trunc[A x].carrier) : T1.Trunc[Prop214[l].Cover[C, A]].carrier =
      TC1.map (Prop214[l].Cover[cv.1, \ s -> A (cv.2.2.1 s)]) (Prop214[l].Cover[C, A]) (\ lc -> Lift[lc].result)
        (P214.local cv.1 cv.2.1 (\ s -> A (cv.2.2.1 s)) (\ s -> h (cv.2.2.1 s))) ;
  } ;
  local-chaus (C : U l) (cC : CH.isCHaus C) (A : C -> U l) (h : (x : C) -> Tr.Trunc[A x].carrier) : T1.Trunc[Prop214[l].Cover[C, A]].carrier =
    TC1.rec (CH.Cover C) @(l+) (T1.Trunc[Prop214[l].Cover[C, A]].carrier) T1.Trunc[Prop214[l].Cover[C, A]].proposition
      (\ cv -> LocalCH[C, A, cv].result h) cC.2.2 ;

  -- Lemma 2.4.2
  module Lemma242 (C : Nat -> U l) (c : (k : Nat) -> C (suc k) -> C k) (cC : (k : Nat) -> CH.isCHaus (C k))
    (cv : (k : Nat) -> CH.Cover (C k)) {
    T (k : Nat) : U l = (cv k).1 ;
    q (k : Nat) : T k -> C k = (cv k).2.2.1 ;
    stage : (k : Nat) -> (X : U l) * (X -> C k) = split {
      zero -> (T zero, q zero) ;
      suc k | r -> ((t : T (suc k)) * (s : r.1) * Id (C k) (c k (q (suc k) t)) (r.2 s), \ w -> q (suc k) w.1) } ;
    S (k : Nat) : U l = (stage k).1 ;
    p (k : Nat) : S k -> C k = (stage k).2 ;
    down (k : Nat) (w : S (suc k)) : S k = w.2.1 ;
    square (k : Nat) (w : S (suc k)) : Id (C k) (c k (p (suc k) w)) (p k (down k w)) = w.2.2 ;
    stone : (k : Nat) -> PF.isStone (S k) = split {
      zero -> (cv zero).2.1 ;
      suc k | r -> Thm418[l].Over[ax].thm418 (T (suc k)) (cv (suc k)).2.1 (\ t -> (s : S k) * Id (C k) (c k (q (suc k) t)) (p k s)) (\ t ->
        CP.sub-stone (S k) r (\ s -> Id (C k) (c k (q (suc k) t)) (p k s)) (\ s -> (cC k).1 (c k (q (suc k) t)) (p k s))
          (\ s -> (cC k).2.1 (c k (q (suc k) t)) (p k s))) } ;
    onto : (k : Nat) -> DCh.Surjective (p k) = split {
      zero -> (cv zero).2.2.2 ;
      suc k | r -> \ y -> TC.bind (Fibre (q (suc k)) y) (Fibre (p (suc k)) y) (\ u ->
        TC.map (Fibre (p k) (c k y)) (Fibre (p (suc k)) y) (\ v -> ((u.1, v.1, transH (apH (c k) u.2) (symH v.2)), u.2)) (r (c k y)))
        ((cv (suc k)).2.2.2 y) } ;
    lim-map (x : DCh.Lim S down) : DCh.Lim C c = (\ k -> p k (x.1 k), \ k -> transH (square k (x.1 (suc k))) (apH (p k) (x.2 k))) ;
    -- the fibres over a point of lim C, with onto maps
    module AtPoint (y : DCh.Lim C c) {
      Fb (k : Nat) : U l = (s : S k) * Id (C k) (p k s) (y.1 k) ;
      fb-down (k : Nat) (u : Fb (suc k)) : Fb k = (down k u.1, transH (symH (square k u.1)) (transH (apH (c k) u.2) (y.2 k))) ;
      fb-eq (k : Nat) (u v : Fb k) (e : Id (S k) u.1 v.1) : Id (Fb k) u v =
        Sigma-eq (S k) (\ s -> Id (C k) (p k s) (y.1 k)) u.1 v.1 u.2 v.2 e ((cC k).1 (p k v.1) (y.1 k)) ;
      fb-onto (k : Nat) (u : Fb k) : Tr.Trunc[Fibre (fb-down k) u].carrier =
        TC.map (Fibre (q (suc k)) (y.1 (suc k))) (Fibre (fb-down k) u) (\ v ->
          (((v.1, u.1, transH (apH (c k) v.2) (transH (y.2 k) (symH u.2))), v.2),
           fb-eq k (fb-down k ((v.1, u.1, transH (apH (c k) v.2) (transH (y.2 k) (symH u.2))), v.2)) u (refl u.1)))
          ((cv (suc k)).2.2.2 (y.1 (suc k))) ;
      point (z : DCh.Lim Fb fb-down) : Fibre lim-map y =
        ((\ k -> (z.1 k).1, \ k -> apH (\ u -> u.1) (z.2 k)),
         SL.Limit[SL.mkInvSeq C c].Sets[\ k -> (cC k).1].lim-eq (lim-map (\ k -> (z.1 k).1, \ k -> apH (\ u -> u.1) (z.2 k))) y
           (\ k -> (z.1 k).2)) ;
      result : Tr.Trunc[Fibre lim-map y].carrier =
        TC.bind (Fb zero) (Fibre lim-map y) (\ u0 ->
          TC.map (Fibre (DCh.proj0 Fb fb-down) u0) (Fibre lim-map y) (\ w -> point w.1) ((ax.dc @l) Fb fb-down fb-onto u0))
          ((cv zero).2.2.2 (y.1 zero)) ;
    } ;
    lim-onto : DCh.Surjective lim-map = \ y -> AtPoint[y].result ;
  } ;

  -- (iv) sequential limits
  module Limit (C : Nat -> U l) (c : (k : Nat) -> C (suc k) -> C k) (cC : (k : Nat) -> CH.isCHaus (C k)) {
    L : U l = DCh.Lim C c ;
    module LS = SL.Limit[SL.mkInvSeq C c].Sets[\ k -> (cC k).1] ;
    id-closed (x y : L) : OC.isClosed (Id L x y) =
      OC.closed-iff (Id L x y) ((k : Nat) -> Id (C k) (x.1 k) (y.1 k)) (\ e k -> apH (\ z -> z.1 k) e, LS.lim-eq x y)
        (OC.Countable[CountableChoice[l].cc (ax.dc @l)].closed-all (\ k -> Id (C k) (x.1 k) (y.1 k)) (\ k -> (cC k).2.1 (x.1 k) (y.1 k))) ;
    cover (cv : (k : Nat) -> CH.Cover (C k)) : CH.Cover L =
      (DCh.Lim Lemma242[C, c, cC, cv].S Lemma242[C, c, cC, cv].down,
       CP.lim-stone Lemma242[C, c, cC, cv].S Lemma242[C, c, cC, cv].down Lemma242[C, c, cC, cv].stone,
       Lemma242[C, c, cC, cv].lim-map, Lemma242[C, c, cC, cv].lim-onto) ;
    chaus : CH.isCHaus L = (LS.set, id-closed,
      TC1.map ((k : Nat) -> CH.Cover (C k)) (CH.Cover L) cover (cc1 (\ k -> CH.Cover (C k)) (\ k -> (cC k).2.2))) ;
  } ;
  lim-chaus (C : Nat -> U l) (c : (k : Nat) -> C (suc k) -> C k) (cC : (k : Nat) -> CH.isCHaus (C k)) : CH.isCHaus (DCh.Lim C c) =
    Limit[C, c, cC].chaus ;
} ;
