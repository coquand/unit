-- CCA Thm 3.4.3 (iii): for an overtly discrete abelian group A,
-- H^(n+1)(I, A) = 0 for every n, i.e. (x : I) -> K(A, n+1) is 0-connected.
--
-- Proof.  Thm 3.3.2 in the form (C') (worker B, ccacoh/Thm332C) for the
-- compact Hausdorff I and the cover cs : 2^N ->> I: its hypothesis
-- Ȟ^(m+1)(I, cs^-1, A) = 0 for all m is CechI.cech-I (Def. 3.4.2,
-- Prop. 2.3.7 and Lemma C.0.6).  (The paper: Thm 3.3.2 as an isomorphism
-- and Lemma C.0.6 through Eilenberg-Steenrod VI.6.10.)
level l ;
open Base ; open Prelude[l] ; open Torsor[l] ; open Connected[l] ; open EMMaps[l] ; open AbHom[l] ;
module SA = StoneAxioms[l,l] ;
module OD = ODisc[l] ;
module In = Interval[l] ;

module Over (ax : SA.Assumptions) {
  module T = Thm332C[l].Over[ax, In.I, In.i-set, In.Over[ax].id-closed, Nat -> Bool, Sigma411[l].cantor-stone, In.cs, In.cs-surjective] ;
  thm343iii (Gr : Ab) (oA : OD.isODisc Gr.A) (n : Nat) : isConn (suc (suc zero)) (In.I -> KK[Gr].K (suc n)) =
    T.thm332 n (\ x -> Gr) (\ x -> oA) (\ m -> CechI[l].Over[ax].cech-I Gr oA (suc m)) ;
} ;
