-- CCA Lemma 2.1.7: for S Stone and T x Stone and merely inhabited, there
-- are families T k x (finite, hence Stone) with maps T (k+1) x -> T k x,
-- such that T x = lim_k T k x and every (x : S) -> T k x is merely
-- inhabited.
--
-- Proof.  The projection (x : S) * T x ->> S is merely a limit of
-- surjections g k : E k ->> G k of finite sets, S = lim G (SSD Lemma 5.8,
-- from Remark 3.4 and Theorem 4.18: Lemma59Stone.lemma58).  Let T k x be
-- the fibre of g k over the k-th component of x (finite: Sigma and
-- identity types of finite sets).  T x is the fibre of lim g over x
-- (Lemma59Stone.FromLimit.phi), which is lim_k T k x (LimFibre).  g k
-- has merely a section (finite choice), and x |-> section (x k) is a point
-- of (x : S) -> T k x.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open SeqLim[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module Fi = Finite[l] ;
module DCh = DependentChoice[l] ;
module Eq = Equivalences[l] ;
module R34 = Remark34[l] ;

-- a tower of finite families approximating T
record Approx (S : U l) (T : S -> U l) {
  Tk : Nat -> S -> U l ;
  d : (k : Nat) (x : S) -> Tk (suc k) x -> Tk k x ;
  finite : (k : Nat) (x : S) -> Fi.isFinite (Tk k x) ;
  limit : (x : S) -> Equiv (T x) (DCh.Lim (\ k -> Tk k x) (\ k -> d k x)) ;
  sections : (k : Nat) -> Tr.Trunc[(x : S) -> Tk k x].carrier ;
} ;

module Over (ax : SA.Assumptions) {
  module FromLimit (S : U l) (T : S -> U l) (dl : R34.SurjLim[(x : S) * T x, S, CechTransfer[l].fst S T]) {
    module FL = Lemma59Stone[l].Over[ax].FromLimit[S, T, dl] ;
    module LF = LimFibre[l].LimFibre[FL.SE, FL.SG, FL.H, dl.finE, dl.finG] ;
    -- the k-th component of x
    base (k : Nat) (x : S) : dl.G k = (dl.eY.1 x).1 k ;
    Tk (k : Nat) (x : S) : U l = LF.Fi.P[k].Q.fib (base k x) ;
    d (k : Nat) (x : S) : Tk (suc k) x -> Tk k x = (LF.O.fibre (dl.eY.1 x)).p k ;
    limit (x : S) : Equiv (T x) (DCh.Lim (\ k -> Tk k x) (\ k -> d k x)) =
      Eq.compose (T x) (LF.Fi.PL.fib (dl.eY.1 x)) (DCh.Lim (\ k -> Tk k x) (\ k -> d k x)) (FL.phi x) (LF.equiv (dl.eY.1 x)) ;
    sections (k : Nat) : Tr.Trunc[(x : S) -> Tk k x].carrier =
      TC.map ((y : dl.G k) -> LF.Fi.P[k].Q.fib y) ((x : S) -> Tk k x) (\ s x -> s (base k x))
        (Fi.choice (dl.G k) (dl.finG k) LF.Fi.P[k].Q.fib (dl.surj k)) ;
    approx : Approx[S, T] = mkApprox S T Tk d (\ k x -> LF.Fi.fib-finite k (base k x)) limit sections ;
  } ;
  lemma217 (S : U l) (sS : PF.isStone S) (T : S -> U l) (sT : (x : S) -> PF.isStone (T x))
    (inh : (x : S) -> Tr.Trunc[T x].carrier) : T1.Trunc[Approx[S, T]].carrier =
    TC1.map (R34.SurjLim[(x : S) * T x, S, CechTransfer[l].fst S T]) Approx[S, T] (\ dl -> FromLimit[S, T, dl].approx)
      (Lemma59Stone[l].Over[ax].lemma58 S sS T sT inh) ;
  -- the stages are Stone
  stage-stone (S : U l) (T : S -> U l) (A : Approx[S, T]) (k : Nat) (x : S) : PF.isStone (A.Tk k x) =
    Prop214[l].Over[ax].finite-stone (A.Tk k x) (A.finite k x) ;
} ;
