-- CCA Lemma 2.3.4 and Prop. 2.3.5: for S Stone and a tower of sets
-- I 0 x -> I 1 x -> .. over S (a sequence Tw.at x at each x), the canonical map
--   colim_i ((x : S) -> I i x)  ->  (x : S) -> colim_i I i x,
--   [h] |-> (x |-> [h x])
-- is an equivalence.
--
-- Injective.  Raise two points to a common stage N; so let a, b : (x : S) ->
--   I N x with [a x] = [b x] for every x.  For each x some d has
--   shift_d (a x) = shift_d (b x) (identity types of a colimit); these
--   subsets increase with d, so by Lemma 2.1.6 one d serves every x, and
--   then shift_d a = shift_d b, so [a] = [b].
-- Surjective.  Let phi : (x : S) -> colim I x.  Each phi x lies in the
--   image Im_i x of some stage I i x; the Im_i increase, so by Lemma 2.1.6
--   phi x is in Im_j x for one j and every x.  (Lemma 2.3.4) By local
--   choice there are T Stone, q : T ->> S and g t : I j (q t) with
--   [g t] = phi (q t).  On the Stone space P of triples (x, (t, e), (t', e'))
--   with e : q t = x, e' : q t' = x, the transports of g t and g t' to x
--   both have class phi x, so they agree after d steps, for one d and every
--   triple (Lemma 2.1.6).  Hence (t, e) |-> shift_d (e_* (g t)) is
--   weakly constant on the fibre of q over x, which is merely inhabited:
--   it defines h x : I (d + j) x (ConstantMap), and [h] |-> phi.
-- Only that the I i x are sets is used (the paper: overtly discrete), and
-- Lemma 2.3.3 (the in-image are open) is not needed: Lemma 2.1.6 does not
-- use openness.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open SeqColim[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module L216 = Lemma216[l] ;

-- a tower of sets over S: a sequence at each x
record Tower (S : U l) {
  at : S -> Seq ;
  sets : (i : Nat) (x : S) -> isSet ((at x).A i) ;
} ;

module Colims (S : U l) (Tw : Tower[S]) {
  -- the stages and maps at x, and the tower of products
  I (i : Nat) (x : S) : U l = (Tw.at x).A i ;
  f (i : Nat) (x : S) (z : I i x) : I (suc i) x = (Tw.at x).f i z ;
  pis : Seq = mkSeq (\ i -> (x : S) -> I i x) (\ i h x -> f i x (h x)) ;
  module CP = Colim[pis] ;
  Target : U l = (x : S) -> Colim[Tw.at x].colim ;
  target-set : isSet Target = F.isSet-Pi S (\ x -> Colim[Tw.at x].colim) (\ x -> Colim[Tw.at x].set) ;
  -- the canonical map
  pointwise (n : Nat) (h : (x : S) -> I n x) : Target = \ x -> Colim[Tw.at x].inc n (h x) ;
  cocone : CP.Cocone[Target] = CP.mkCocone Target pointwise (\ n h ->
    F.funext S (\ x -> Colim[Tw.at x].colim) (pointwise (suc n) (\ x -> f n x (h x))) (pointwise n h)
      (\ x -> symH (Colim[Tw.at x].glue n (h x)))) ;
  module R = CP.Rec[Target, target-set, cocone] ;
  canonical (u : CP.colim) : Target = R.map u ;
  canonical-inc (n : Nat) (h : (x : S) -> I n x) : Id Target (canonical (CP.inc n h)) (pointwise n h) = R.beta n h ;
  -- shifting a product is shifting pointwise
  shift-at : (d n : Nat) (h : (x : S) -> I n x) (x : S) ->
    Id (I (plus d n) x) (CP.shift d n h x) (Colim[Tw.at x].shift d n (h x)) = split {
    zero -> \ n h x -> refl (h x) ;
    suc d | r -> \ n h x -> apH (f (plus d n) x) (r n h x) } ;
  -- the class of z at stage i is phi x
  Image (phi : Target) (i : Nat) (x : S) : U l = Tr.Trunc[(z : I i x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc i z) (phi x)].carrier ;
} ;

module Over (ax : SA.Assumptions) {
  module P214 = Prop214[l].Over[ax] ;
  module Prop235 (S : U l) (sS : PF.isStone S) (Tw : Tower[S]) {
    module C = Colims[S, Tw] ;
    module CP = C.CP ;

    -- injective, at one stage
    module SameStage (N : Nat) (a b : (x : S) -> C.I N x)
      (e : (x : S) -> Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc N (a x)) (Colim[Tw.at x].inc N (b x))) {
      agree : L216.Increasing[S] = L216.mkIncreasing S
        (\ d x -> Id (C.I (plus d N) x) (Colim[Tw.at x].shift d N (a x)) (Colim[Tw.at x].shift d N (b x)))
        (\ d x -> Tw.sets (plus d N) x (Colim[Tw.at x].shift d N (a x)) (Colim[Tw.at x].shift d N (b x)))
        (\ d x p -> apH (C.f (plus d N) x) p) ;
      cover (x : S) : Tr.Trunc[L216.Up[S, agree].Cover x].carrier =
        SeqProp[l].IdColim[Tw.at x, \ i -> Tw.sets i x, N, a x, b x].to (e x) ;
      from-stage (w : (k : Nat) * ((x : S) -> agree.sub k x)) : Id CP.colim (CP.inc N a) (CP.inc N b) = calc CP.colim {
        CP.inc N a =< symH (CP.inc-shift w.1 N a) > CP.inc (plus w.1 N) (CP.shift w.1 N a)
          =< apH (CP.inc (plus w.1 N)) (F.funext S (\ x -> C.I (plus w.1 N) x) (CP.shift w.1 N a) (CP.shift w.1 N b)
               (\ x -> transH (C.shift-at w.1 N a x) (transH (w.2 x) (symH (C.shift-at w.1 N b x))))) >
          CP.inc (plus w.1 N) (CP.shift w.1 N b)
          =< CP.inc-shift w.1 N b > CP.inc N b } ;
      same : Id CP.colim (CP.inc N a) (CP.inc N b) =
        TC.rec ((k : Nat) * ((x : S) -> agree.sub k x)) @l (Id CP.colim (CP.inc N a) (CP.inc N b)) (CP.set (CP.inc N a) (CP.inc N b))
          from-stage (L216.Over[ax].lemma216 S sS agree cover) ;
    } ;
    -- injective
    injective : Injective C.canonical =
      StageInjective[l].StageInjective[C.pis, C.Target, C.canonical, \ N a b q ->
        SameStage[N, a, b, happly S (\ x -> Colim[Tw.at x].colim) (C.pointwise N a) (C.pointwise N b)
          (transH (symH (C.canonical-inc N a)) (transH q (C.canonical-inc N b)))].same].injective ;

    -- Lemma 2.3.4: a phi lying in the image of the stage j comes from a
    -- product at a later stage
    module Lemma234 (phi : C.Target) (j : Nat) (m : (x : S) -> C.Image phi j x) {
      A (x : S) : U l = (z : C.I j x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc j z) (phi x) ;
      module Chosen (cv : Prop214[l].Cover[S, A]) {
        g (t : cv.T) : C.I j (cv.q t) = (cv.section t).1 ;
        -- g t moved to x along e : q t = x
        move (x : S) (u : Fibre cv.q x) : C.I j x = substH (C.I j) u.2 (g u.1) ;
        -- its class is phi x
        move-class (x : S) (u : Fibre cv.q x) : Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc j (move x u)) (phi x) =
          idJ S (cv.q u.1) (\ y e -> Id (Colim[Tw.at y].colim) (Colim[Tw.at y].inc j (substH (C.I j) e (g u.1))) (phi y))
            (cv.section u.1).2 x u.2 ;
        -- the Stone space of pairs of points over a common x
        Pairs : U l = (x : S) * (Fibre cv.q x * Fibre cv.q x) ;
        pairs-stone : PF.isStone Pairs =
          Thm418[l].Over[ax].thm418 S sS (\ x -> Fibre cv.q x * Fibre cv.q x) (\ x ->
            P214.product-stone (Fibre cv.q x) (Fibre cv.q x) (P214.fibre-stone cv.T S cv.stone sS cv.q x)
              (P214.fibre-stone cv.T S cv.stone sS cv.q x)) ;
        agree : L216.Increasing[Pairs] = L216.mkIncreasing Pairs
          (\ d w -> Id (C.I (plus d j) w.1) (Colim[Tw.at w.1].shift d j (move w.1 w.2.1)) (Colim[Tw.at w.1].shift d j (move w.1 w.2.2)))
          (\ d w -> Tw.sets (plus d j) w.1 (Colim[Tw.at w.1].shift d j (move w.1 w.2.1)) (Colim[Tw.at w.1].shift d j (move w.1 w.2.2)))
          (\ d w p -> apH (C.f (plus d j) w.1) p) ;
        cover (w : Pairs) : Tr.Trunc[L216.Up[Pairs, agree].Cover w].carrier =
          SeqProp[l].IdColim[Tw.at w.1, \ i -> Tw.sets i w.1, j, move w.1 w.2.1, move w.1 w.2.2].to
            (transH (move-class w.1 w.2.1) (symH (move-class w.1 w.2.2))) ;
        -- with one d for every pair, the value at x
        module Stage (d : Nat) (ag : (w : Pairs) -> agree.sub d w) {
          value-at (x : S) (u : Fibre cv.q x) : C.I (plus d j) x = Colim[Tw.at x].shift d j (move x u) ;
          module K (x : S) { module M = ConstantMap[l].Constant[Fibre cv.q x, C.I (plus d j) x, Tw.sets (plus d j) x,
            value-at x, \ u u' -> ag (x, u, u')] ; } ;
          h (x : S) : C.I (plus d j) x = K[x].M.value (cv.onto x) ;
          h-class (x : S) : Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc (plus d j) (h x)) (phi x) =
            TC.rec (Fibre cv.q x) @l (Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc (plus d j) (h x)) (phi x))
              (Colim[Tw.at x].set (Colim[Tw.at x].inc (plus d j) (h x)) (phi x)) (\ u -> calc (Colim[Tw.at x].colim) {
                Colim[Tw.at x].inc (plus d j) (h x) =< apH (Colim[Tw.at x].inc (plus d j)) (K[x].M.value-at (cv.onto x) u) >
                Colim[Tw.at x].inc (plus d j) (value-at x u)
                  =< Colim[Tw.at x].inc-shift d j (move x u) > Colim[Tw.at x].inc j (move x u)
                  =< move-class x u > phi x }) (cv.onto x) ;
          onto : (u : CP.colim) * Id C.Target (C.canonical u) phi =
            (CP.inc (plus d j) h, transH (C.canonical-inc (plus d j) h)
              (F.funext S (\ x -> Colim[Tw.at x].colim) (C.pointwise (plus d j) h) phi h-class)) ;
        } ;
        result : Tr.Trunc[(u : CP.colim) * Id C.Target (C.canonical u) phi].carrier =
          TC.map ((d : Nat) * ((w : Pairs) -> agree.sub d w)) ((u : CP.colim) * Id C.Target (C.canonical u) phi)
            (\ w -> Stage[w.1, w.2].onto) (L216.Over[ax].lemma216 Pairs pairs-stone agree cover) ;
      } ;
      result : Tr.Trunc[(u : CP.colim) * Id C.Target (C.canonical u) phi].carrier =
        TC1.rec (Prop214[l].Cover[S, A]) @l (Tr.Trunc[(u : CP.colim) * Id C.Target (C.canonical u) phi].carrier)
          Tr.Trunc[(u : CP.colim) * Id C.Target (C.canonical u) phi].proposition
          (\ cv -> Chosen[cv].result) (P214.local S sS A m) ;
    } ;

    -- surjective
    module Surjectivity (phi : C.Target) {
      in-image : L216.Increasing[S] = L216.mkIncreasing S (C.Image phi)
        (\ i x -> Tr.Trunc[(z : C.I i x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc i z) (phi x)].proposition)
        (\ i x -> TC.map ((z : C.I i x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc i z) (phi x))
          ((z : C.I (suc i) x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc (suc i) z) (phi x))
          (\ v -> (C.f i x v.1, transH (symH (Colim[Tw.at x].glue i v.1)) v.2))) ;
      -- every point of colim I x is in some image
      cover (x : S) : Tr.Trunc[L216.Up[S, in-image].Cover x].carrier =
        Colim[Tw.at x].induction @l (\ c -> Id (Colim[Tw.at x].colim) c (phi x) -> Tr.Trunc[L216.Up[S, in-image].Cover x].carrier)
          (\ c -> F.isProp-Pi (Id (Colim[Tw.at x].colim) c (phi x)) (\ p -> Tr.Trunc[L216.Up[S, in-image].Cover x].carrier)
            (\ p -> Tr.Trunc[L216.Up[S, in-image].Cover x].proposition))
          (\ n z p -> Tr.Trunc[L216.Up[S, in-image].Cover x].inc
            (n, Tr.Trunc[(z' : C.I n x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc n z') (phi x)].inc (z, p)))
          (phi x) (refl (phi x)) ;
      result : Tr.Trunc[(u : CP.colim) * Id C.Target (C.canonical u) phi].carrier =
        TC.rec ((j : Nat) * ((x : S) -> C.Image phi j x)) @l (Tr.Trunc[(u : CP.colim) * Id C.Target (C.canonical u) phi].carrier)
          Tr.Trunc[(u : CP.colim) * Id C.Target (C.canonical u) phi].proposition
          (\ w -> Lemma234[phi, w.1, w.2].result) (L216.Over[ax].lemma216 S sS in-image cover) ;
    } ;

    equivalence : isEquiv CP.colim C.Target C.canonical =
      Bij[CP.colim, C.Target, C.target-set, C.canonical, injective, \ phi -> Surjectivity[phi].result].equiv ;
  } ;
  prop235 (S : U l) (sS : PF.isStone S) (Tw : Tower[S]) : isEquiv (Colims[S, Tw].CP.colim) (Colims[S, Tw].Target) (Colims[S, Tw].canonical) =
    Prop235[S, sS, Tw].equivalence ;
} ;
