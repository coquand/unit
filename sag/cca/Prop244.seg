-- CCA Prop. 2.4.4 (Tychonov): for I overtly discrete and C i compact
-- Hausdorff, (i : I) -> C i is compact Hausdorff.
--
-- Proof.  Being compact Hausdorff is a proposition, invariant under
-- equivalence.  A product over Fin 0 is Top, over Fin (k+1) it is a binary
-- product (a Sigma, Prop. 2.4.3 (ii)); so finite products are compact
-- Hausdorff, and then along X = Fin k.  For I = colim_k J k with J k finite
-- (univalence moves the statement along I = colim J), a section over the
-- colimit is a compatible sequence of sections over the stages:
--   (c : colim J) -> C c  =  lim_k ((j : J k) -> C [j])
-- (the maps transport along glue; back, the cocone (j, h j) into the set
-- (c : colim J) * C c gives a map whose first component is the identity);
-- this is a limit of finite products, compact Hausdorff by Prop. 2.4.3 (iv).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Bijection[l] ; open SeqColim[l] ; open FinChoice[l] ; open ODisc[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module FL2 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module SA = StoneAxioms[l,l] ;
module OC = OpenClosed[l,l] ;
module CH = CHaus[l] ;
module DCh = DependentChoice[l] ;
module SL = SeqLim[l] ;
module FCl = FiniteClosure[l] ;
module Fi = Finite[l] ;
module To = Torsor[l] ;
module PC = PiClosure[l] ;

-- transport along the first component of a path of a Sigma type
sigma-snd (A : U l) (B : A -> U l) (u v : (a : A) * B a) (p : Id ((a : A) * B a) u v) : Id (B v.1) (substH B (apH (\ w -> w.1) p) u.2) v.2 =
  idJ ((a : A) * B a) u (\ v1 p1 -> Id (B v1.1) (substH B (apH (\ w -> w.1) p1) u.2) v1.2) (refl u.2) v p ;

-- sections over a sequential colimit of sets
module PiColim (J : Seq) (C : Colim[J].colim -> U l) (sC : (c : Colim[J].colim) -> isSet (C c)) {
  module CJ = Colim[J] ;
  D (k : Nat) : U l = (j : J.A k) -> C (CJ.inc k j) ;
  r (k : Nat) (h : D (suc k)) : D k = \ j -> substH C (symH (CJ.glue k j)) (h (J.f k j)) ;
  d-set (k : Nat) : isSet (D k) = F.isSet-Pi (J.A k) (\ j -> C (CJ.inc k j)) (\ j -> sC (CJ.inc k j)) ;
  Lim : U l = DCh.Lim D r ;
  to (h : (c : CJ.colim) -> C c) : Lim = (\ k j -> h (CJ.inc k j), \ k ->
    F.funext (J.A k) (\ j -> C (CJ.inc k j)) (r k (\ j -> h (CJ.inc (suc k) j))) (\ j -> h (CJ.inc k j)) (\ j ->
      Prop239[l].transport-section CJ.colim C h (CJ.inc (suc k) (J.f k j)) (CJ.inc k j) (symH (CJ.glue k j)))) ;
  Tot : U l = (c : CJ.colim) * C c ;
  tot-set : isSet Tot = isSet-Sigma CJ.colim C CJ.set sC ;
  module From (w : Lim) {
    module R = CJ.Rec[Tot, tot-set, CJ.mkCocone Tot (\ k j -> (CJ.inc k j, w.1 k j)) (\ k j ->
      Sigma-path CJ.colim C (CJ.inc (suc k) (J.f k j)) (CJ.inc k j) (w.1 (suc k) (J.f k j)) (w.1 k j) (symH (CJ.glue k j))
        (happly (J.A k) (\ j1 -> C (CJ.inc k j1)) (r k (w.1 (suc k))) (w.1 k) (w.2 k) j))] ;
    fst-m (c : CJ.colim) : Id CJ.colim (R.map c).1 c =
      CJ.induction @l (\ c1 -> Id CJ.colim (R.map c1).1 c1) (\ c1 -> CJ.set (R.map c1).1 c1)
        (\ k j -> apH (\ u -> u.1) (R.beta k j)) c ;
    value (c : CJ.colim) : C c = substH C (fst-m c) (R.map c).2 ;
    value-inc (k : Nat) (j : J.A k) : Id (C (CJ.inc k j)) (value (CJ.inc k j)) (w.1 k j) =
      transH (apH (\ e -> substH C e (R.map (CJ.inc k j)).2) (CJ.set (R.map (CJ.inc k j)).1 (CJ.inc k j) (fst-m (CJ.inc k j)) (apH (\ u -> u.1) (R.beta k j))))
        (sigma-snd CJ.colim C (R.map (CJ.inc k j)) (CJ.inc k j, w.1 k j) (R.beta k j)) ;
  } ;
  from (w : Lim) (c : CJ.colim) : C c = From[w].value c ;
  to-from (w : Lim) : Id Lim (to (from w)) w =
    SL.Limit[SL.mkInvSeq D r].Sets[d-set].lim-eq (to (from w)) w (\ k ->
      F.funext (J.A k) (\ j -> C (CJ.inc k j)) (\ j -> from w (CJ.inc k j)) (w.1 k) (From[w].value-inc k)) ;
  from-to (h : (c : CJ.colim) -> C c) : Id ((c : CJ.colim) -> C c) (from (to h)) h =
    F.funext CJ.colim C (from (to h)) h (\ c ->
      CJ.induction @l (\ c1 -> Id (C c1) (from (to h) c1) (h c1)) (\ c1 -> sC c1 (from (to h) c1) (h c1))
        (\ k j -> From[to h].value-inc k j) c) ;
  equiv : Equiv ((c : CJ.colim) -> C c) Lim = (to, qinv ((c : CJ.colim) -> C c) Lim to from to-from from-to) ;
} ;

module Over (ax : SA.Assumptions) {
  module P243 = Prop243[l].Over[ax] ;
  -- being compact Hausdorff is a proposition, invariant under equivalence
  chaus-prop (X : U l) : Prelude[l+].isProp (CH.isCHaus X) =
    Prelude[l+].isProp-Sigma (isSet X) (\ s -> ((x y : X) -> OC.isClosed (Id X x y)) * T1.Trunc[CH.Cover X].carrier) (To.isProp-isSet X) (\ s ->
      Prelude[l+].isProp-Sigma ((x y : X) -> OC.isClosed (Id X x y)) (\ c -> T1.Trunc[CH.Cover X].carrier)
        (F.isProp-Pi X (\ x -> (y : X) -> OC.isClosed (Id X x y)) (\ x -> F.isProp-Pi X (\ y -> OC.isClosed (Id X x y)) (\ y -> Tr.Trunc[OC.ClosedW (Id X x y)].proposition)))
        (\ c -> T1.Trunc[CH.Cover X].proposition)) ;
  chaus-equiv (X Y : U l) (e : Equiv X Y) (cY : CH.isCHaus Y) : CH.isCHaus X =
    (isSet-retract X Y e.1 e.2.sec (sec-ret X Y e.1 e.2) cY.1,
     \ x y -> OC.closed-iff (Id X x y) (Id Y (e.1 x) (e.1 y))
       (apH e.1, \ q -> transH (symH (sec-ret X Y e.1 e.2 x)) (transH (apH e.2.sec q) (sec-ret X Y e.1 e.2 y))) (cY.2.1 (e.1 x) (e.1 y)),
     TC1.map (CH.Cover Y) (CH.Cover X) (\ cv -> (cv.1, cv.2.1, \ s -> e.2.sec (cv.2.2.1 s), \ x ->
       TC.map (Fibre cv.2.2.1 (e.1 x)) (Fibre {cv.1} {X} (\ s -> e.2.sec (cv.2.2.1 s)) x) (\ u -> (u.1, transH (apH e.2.sec u.2) (sec-ret X Y e.1 e.2 x)))
         (cv.2.2.2 (e.1 x)))) cY.2.2) ;
  -- finite products
  PiCH (X : U l) : U l+ = (C : X -> U l) -> ((x : X) -> CH.isCHaus (C x)) -> CH.isCHaus ((x : X) -> C x) ;
  pich-prop (X : U l) : Prelude[l+].isProp (PiCH X) =
    FL2.isProp-Pi (X -> U l) (\ C -> ((x : X) -> CH.isCHaus (C x)) -> CH.isCHaus ((x : X) -> C x)) (\ C ->
      FL2.isProp-Pi ((x : X) -> CH.isCHaus (C x)) (\ cC -> CH.isCHaus ((x : X) -> C x)) (\ cC -> chaus-prop ((x : X) -> C x))) ;
  pi-fin-chaus : (k : Nat) -> PiCH (Fin k) = split {
    zero -> \ C cC -> chaus-equiv ((i : Fin zero) -> C i) Top (PC.pi-zero C) (P243.finite-chaus Top FCl.top-finite) ;
    suc k | r -> \ C cC -> chaus-equiv ((i : Fin (suc k)) -> C i) (C none * ((j : Fin k) -> C (some j))) (PC.pi-suc k C)
      (P243.sigma-chaus (C none) (cC none) (\ a -> (j : Fin k) -> C (some j)) (\ a -> r (\ j -> C (some j)) (\ j -> cC (some j)))) } ;
  pi-finite-chaus (X : U l) (fX : Fi.isFinite X) : PiCH X = FCl.Transfer[PiCH, pich-prop, pi-fin-chaus].finite X fX ;

  -- over a colimit of finite sets
  module OverColim (J : Seq) (fin : (n : Nat) -> Fi.isFinite (J.A n)) {
    statement : PiCH (Colim[J].colim) = \ C cC ->
      chaus-equiv ((c : Colim[J].colim) -> C c) PiColim[J, C, \ c -> (cC c).1].Lim PiColim[J, C, \ c -> (cC c).1].equiv
        (P243.lim-chaus PiColim[J, C, \ c -> (cC c).1].D PiColim[J, C, \ c -> (cC c).1].r (\ k ->
          pi-finite-chaus (J.A k) (fin k) (\ j -> C (Colim[J].inc k j)) (\ j -> cC (Colim[J].inc k j)))) ;
  } ;
  -- Prop. 2.4.4
  tychonov (I : U l) (oI : isODisc I) : PiCH I =
    TC1.rec (Pres[I]) @(l+) (PiCH I) (pich-prop I) (\ pr ->
      Axioms[l].UnivalenceLemmas[univ @l].eqind (Colim[pr.seq].colim) (\ X1 e -> PiCH X1) (OverColim[pr.seq, pr.finite].statement)
        I (inverse I (Colim[pr.seq].colim) pr.equiv)) oI ;
} ;
