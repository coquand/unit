-- CCA Thm 3.4.3 (ii): for an overtly discrete group G, H^1(I, G) = 0.
--
-- Proof.  By Prop. 3.1.8 (worker B, H1Stone.Prop318.backward) for the cover
-- cs : 2^N ->> I, it is enough that Ȟ^1(I, cs^-1, G) = 0.  Let d be a
-- cocycle.  On the pairs, d is a map  Sigma (x : I) (cs^-1 x)^2 -> G,
-- i.e. (Def. 3.4.2) a map  lim_n I~^1_n -> G, so (Prop. 2.3.7) it is
-- delta o pi_n for some delta : I~^1_n -> G.  The two sides of the cocycle
-- condition are then  (delta o face_12) . (delta o face_01)  and
-- delta o face_02  on I~^2_n; they agree on lim_n I~^2_n, so (Prop. 2.3.7,
-- injective) after a further steps, on I~^2_m, m = a + n: delta' = delta o
-- down is a cocycle at stage m in the sense of Lemma C.0.5, which gives
-- beta : V m -> G with beta a1 . delta' (a0, a1) = beta a0.  Then
-- g x y = beta (the m-th numerator of y) trivialises d.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open SeqColim[l] ; open FinChoice[l] ;
open Group[l] ; open CechNA[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module SA = StoneAxioms[l,l] ;
module OD = ODisc[l] ;
module FCo = FiniteCode[l] ;
module Eq = Equivalences[l] ;
module In = Interval[l] ;
module Dy = Dyadic[l] ;
module D342 = Def342[l] ;
module L236 = Lemma236[l] ;
module C05 = LemmaC05[l] ;

-- the indices
three : Nat = suc (suc (suc zero)) ;
two : Nat = suc (suc zero) ;
i0 : Fin three = none ;
i1 : Fin three = some none ;
i2 : Fin three = some (some none) ;
pairmap (a b : Fin three) : Fin two -> Fin three = split { none -> a ; some e -> b } ;
-- faces of triples of vertices
face (n : Nat) (a b : Fin three) (u : Dy.Tuples two n) : Dy.Tuples (suc zero) n =
  (\ i -> u.1 (pairmap a b i), \ i j -> u.2 (pairmap a b i) (pairmap a b j)) ;
-- pairs and triples of vertices
pair-v (n : Nat) (a b : Dy.V n) : Fin two -> Dy.V n = split { none -> a ; some e -> b } ;
pair-pw (n : Nat) (a b : Dy.V n) (h : In.Near a.1 b.1) : (i j : Fin two) -> In.Near (pair-v n a b i).1 (pair-v n a b j).1 = split {
  none -> split { none -> In.near-refl a.1 ; some e -> h } ;
  some e -> split { none -> In.near-sym a.1 b.1 h ; some e' -> In.near-refl b.1 } } ;
pair-t (n : Nat) (a b : Dy.V n) (h : In.Near a.1 b.1) : Dy.Tuples (suc zero) n = (pair-v n a b, pair-pw n a b h) ;
module Triple (n : Nat) (a0 a1 a2 : Dy.V n) (h01 : In.Near a0.1 a1.1) (h12 : In.Near a1.1 a2.1) (h02 : In.Near a0.1 a2.1) {
  v-some : Fin two -> Dy.V n = split { none -> a1 ; some e -> a2 } ;
  v : Fin three -> Dy.V n = split { none -> a0 ; some j -> v-some j } ;
  row0s : (j : Fin two) -> In.Near a0.1 (v-some j).1 = split { none -> h01 ; some e -> h02 } ;
  row0 : (j : Fin three) -> In.Near a0.1 (v j).1 = split { none -> In.near-refl a0.1 ; some j -> row0s j } ;
  row1s : (j : Fin two) -> In.Near a1.1 (v-some j).1 = split { none -> In.near-refl a1.1 ; some e -> h12 } ;
  row1 : (j : Fin three) -> In.Near a1.1 (v j).1 = split { none -> In.near-sym a0.1 a1.1 h01 ; some j -> row1s j } ;
  row2s : (j : Fin two) -> In.Near a2.1 (v-some j).1 = split { none -> In.near-sym a1.1 a2.1 h12 ; some e -> In.near-refl a2.1 } ;
  row2 : (j : Fin three) -> In.Near a2.1 (v j).1 = split { none -> In.near-sym a0.1 a2.1 h02 ; some j -> row2s j } ;
  rows : (i : Fin two) (j : Fin three) -> In.Near (v-some i).1 (v j).1 = split { none -> row1 ; some e -> row2 } ;
  pw : (i j : Fin three) -> In.Near (v i).1 (v j).1 = split { none -> row0 ; some i' -> rows i' } ;
  t : Dy.Tuples two n = (v, pw) ;
} ;

module Over (ax : SA.Assumptions) {
  module Thm343ii (Gr : Grp) (oG : OD.isODisc Gr.G) {
    open Gr ;
    module CN = CechNA[l].CechNA[In.I, Fibre In.cs, In.cs-surjective, \ x -> Gr] ;
    module D1 = D342.Def342[suc zero] ;
    module D2 = D342.Def342[two] ;
    Fib1 : U l = (x : In.I) * (Fin two -> Fibre In.cs x) ;
    Fib2 : U l = (x : In.I) * (Fin three -> Fibre In.cs x) ;
    module M1 = L236.FMaps[Dy.Tuples (suc zero), Dy.tuple-down (suc zero), G, setG] ;
    module M2 = L236.FMaps[Dy.Tuples two, Dy.tuple-down two, G, setG] ;
    eqv1 : isEquiv M1.CF.colim (M1.Lim -> G) M1.canonical =
      Prop237[l].Over[ax].prop237 (Dy.Tuples (suc zero)) (Dy.tuple-down (suc zero)) (\ n -> Dy.TupleFinite[suc zero, n].finite) G setG oG ;
    eqv2 : isEquiv M2.CF.colim (M2.Lim -> G) M2.canonical =
      Prop237[l].Over[ax].prop237 (Dy.Tuples two) (Dy.tuple-down two) (\ n -> Dy.TupleFinite[two, n].finite) G setG oG ;
    -- faces of triples of points of fibres
    fface (a b : Fin three) (w : Fib2) : Fib1 = (w.1, \ i -> w.2 (pairmap a b i)) ;
    face-lim (n : Nat) (a b : Fin three) (w : Fib2) :
      Id (Dy.Tuples (suc zero) n) (face n a b ((D2.def342.1 w).1 n)) ((D1.def342.1 (fface a b w)).1 n) =
      D1.t-eq n (face n a b ((D2.def342.1 w).1 n)) ((D1.def342.1 (fface a b w)).1 n) (\ i -> refl (((D1.def342.1 (fface a b w)).1 n).1 i)) ;
    face-down-one (k : Nat) (a b : Fin three) (u : Dy.Tuples two (suc k)) :
      Id (Dy.Tuples (suc zero) k) (face k a b (Dy.tuple-down two k u)) (Dy.tuple-down (suc zero) k (face (suc k) a b u)) =
      D1.t-eq k (face k a b (Dy.tuple-down two k u)) (Dy.tuple-down (suc zero) k (face (suc k) a b u)) (\ i -> refl (Dy.v-down k (u.1 (pairmap a b i)))) ;
    face-down (n : Nat) (a b : Fin three) : (e : Nat) (u : Dy.Tuples two (plus e n)) ->
      Id (Dy.Tuples (suc zero) n) (face n a b (FCo.down (Dy.Tuples two) (Dy.tuple-down two) n e u))
        (FCo.down (Dy.Tuples (suc zero)) (Dy.tuple-down (suc zero)) n e (face (plus e n) a b u)) = split {
      zero -> \ u -> refl (face n a b u) ;
      suc e | r -> \ u -> transH (r (Dy.tuple-down two (plus e n) u))
        (apH (FCo.down (Dy.Tuples (suc zero)) (Dy.tuple-down (suc zero)) n e) (face-down-one (plus e n) a b u)) } ;

    module Cocycle (d : CN.C1) (cd : CN.Cocycle d) {
      D (w : Fib1) : G = d w.1 (w.2 none) (w.2 (some none)) ;
      D' (z : D1.Lim) : G = D (D1.def342.2.sec z) ;
      module Stage (n : Nat) (delta : Dy.Tuples (suc zero) n -> G) (hd : (z : D1.Lim) -> Id G (delta (z.1 n)) (D' z)) {
        at-fib (w : Fib1) : Id G (delta ((D1.def342.1 w).1 n)) (D w) =
          transH (hd (D1.def342.1 w)) (apH D (sec-ret Fib1 D1.Lim D1.def342.1 D1.def342.2 w)) ;
        C1 (u : Dy.Tuples two n) : G = mul (delta (face n i1 i2 u)) (delta (face n i0 i1 u)) ;
        C2 (u : Dy.Tuples two n) : G = delta (face n i0 i2 u) ;
        agree-fib (w : Fib2) : Id G (C1 ((D2.def342.1 w).1 n)) (C2 ((D2.def342.1 w).1 n)) = calc G {
          C1 ((D2.def342.1 w).1 n)
            =< apH (\ t -> mul (delta t) (delta (face n i0 i1 ((D2.def342.1 w).1 n)))) (face-lim n i1 i2 w) >
          mul (delta ((D1.def342.1 (fface i1 i2 w)).1 n)) (delta (face n i0 i1 ((D2.def342.1 w).1 n)))
            =< apH (\ t -> mul (delta ((D1.def342.1 (fface i1 i2 w)).1 n)) (delta t)) (face-lim n i0 i1 w) >
          mul (delta ((D1.def342.1 (fface i1 i2 w)).1 n)) (delta ((D1.def342.1 (fface i0 i1 w)).1 n))
            =< apH (\ x -> mul x (delta ((D1.def342.1 (fface i0 i1 w)).1 n))) (at-fib (fface i1 i2 w)) >
          mul (D (fface i1 i2 w)) (delta ((D1.def342.1 (fface i0 i1 w)).1 n))
            =< apH (mul (D (fface i1 i2 w))) (at-fib (fface i0 i1 w)) > mul (D (fface i1 i2 w)) (D (fface i0 i1 w))
            =< cd w.1 (w.2 i0) (w.2 i1) (w.2 i2) > D (fface i0 i2 w)
            =< symH (at-fib (fface i0 i2 w)) > delta ((D1.def342.1 (fface i0 i2 w)).1 n)
            =< symH (apH delta (face-lim n i0 i2 w)) > C2 ((D2.def342.1 w).1 n) } ;
        agree-lim (z : D2.Lim) : Id G (C1 (z.1 n)) (C2 (z.1 n)) =
          substH (\ z1 -> Id G (C1 (z1.1 n)) (C2 (z1.1 n))) (D2.def342.2.sec-eq z) (agree-fib (D2.def342.2.sec z)) ;
        same : Id M2.CF.colim (M2.CF.inc n C1) (M2.CF.inc n C2) =
          Eq.injective M2.CF.colim (M2.Lim -> G) M2.canonical eqv2 (M2.CF.inc n C1) (M2.CF.inc n C2) (calc (M2.Lim -> G) {
            M2.canonical (M2.CF.inc n C1) =< M2.canonical-inc n C1 > M2.restrict n C1
              =< F.funext M2.Lim (\ z -> G) (M2.restrict n C1) (M2.restrict n C2) agree-lim > M2.restrict n C2
              =< symH (M2.canonical-inc n C2) > M2.canonical (M2.CF.inc n C2) }) ;
        module Later (w : (a : Nat) * Id (Dy.Tuples two (plus a n) -> G) (M2.CF.shift a n C1) (M2.CF.shift a n C2)) {
          m : Nat = plus w.1 n ;
          dn1 (t : Dy.Tuples (suc zero) m) : Dy.Tuples (suc zero) n = FCo.down (Dy.Tuples (suc zero)) (Dy.tuple-down (suc zero)) n w.1 t ;
          dn2 (u : Dy.Tuples two m) : Dy.Tuples two n = FCo.down (Dy.Tuples two) (Dy.tuple-down two) n w.1 u ;
          delta' (t : Dy.Tuples (suc zero) m) : G = delta (dn1 t) ;
          cocycle' (u : Dy.Tuples two m) : Id G (mul (delta' (face m i1 i2 u)) (delta' (face m i0 i1 u))) (delta' (face m i0 i2 u)) = calc G {
            mul (delta' (face m i1 i2 u)) (delta' (face m i0 i1 u))
              =< apH (\ t -> mul (delta t) (delta' (face m i0 i1 u))) (symH (face-down n i1 i2 w.1 u)) >
            mul (delta (face n i1 i2 (dn2 u))) (delta' (face m i0 i1 u))
              =< apH (\ t -> mul (delta (face n i1 i2 (dn2 u))) (delta t)) (symH (face-down n i0 i1 w.1 u)) > C1 (dn2 u)
              =< symH (M2.shift-down n C1 w.1 u) > M2.CF.shift w.1 n C1 u
              =< happly (Dy.Tuples two m) (\ u1 -> G) (M2.CF.shift w.1 n C1) (M2.CF.shift w.1 n C2) w.2 u > M2.CF.shift w.1 n C2 u
              =< M2.shift-down n C2 w.1 u > C2 (dn2 u)
              =< apH delta (face-down n i0 i2 w.1 u) > delta' (face m i0 i2 u) } ;
          -- Lemma C.0.5 at stage m
          dC (a b : Dy.V m) (h : In.Near a.1 b.1) : G = delta' (pair-t m a b h) ;
          module Tr3 (a0 a1 a2 : Dy.V m) (h01 : In.Near a0.1 a1.1) (h12 : In.Near a1.1 a2.1) (h02 : In.Near a0.1 a2.1) {
            module X = Triple[m, a0, a1, a2, h01, h12, h02] ;
            fp-at (a b : Fin three) (x y : Dy.V m) (ex : Id (Dy.V m) (X.v a) x) (ey : Id (Dy.V m) (X.v b) y) :
              (i : Fin two) -> Id (Dy.V m) (X.v (pairmap a b i)) (pair-v m x y i) = split { none -> ex ; some e -> ey } ;
            fp (a b : Fin three) (x y : Dy.V m) (ex : Id (Dy.V m) (X.v a) x) (ey : Id (Dy.V m) (X.v b) y) (h : In.Near x.1 y.1) :
              Id (Dy.Tuples (suc zero) m) (face m a b X.t) (pair-t m x y h) =
              D1.t-eq m (face m a b X.t) (pair-t m x y h) (fp-at a b x y ex ey) ;
            result : Id G (mul (dC a1 a2 h12) (dC a0 a1 h01)) (dC a0 a2 h02) = calc G {
              mul (dC a1 a2 h12) (dC a0 a1 h01)
                =< apH {Dy.Tuples (suc zero) m} {G} (\ t -> mul (delta' t) (dC a0 a1 h01)) (symH (fp i1 i2 a1 a2 (refl a1) (refl a2) h12)) >
              mul (delta' (face m i1 i2 X.t)) (dC a0 a1 h01)
                =< apH {Dy.Tuples (suc zero) m} {G} (\ t -> mul (delta' (face m i1 i2 X.t)) (delta' t)) (symH (fp i0 i1 a0 a1 (refl a0) (refl a1) h01)) >
              mul (delta' (face m i1 i2 X.t)) (delta' (face m i0 i1 X.t))
                =< cocycle' X.t > delta' (face m i0 i2 X.t)
                =< apH delta' (fp i0 i2 a0 a2 (refl a0) (refl a2) h02) > dC a0 a2 h02 } ;
          } ;
          module C5 = C05.LemmaC05[Gr, m].AtOne[dC, \ a0 a1 a2 h01 h12 h02 -> Tr3[a0, a1, a2, h01, h12, h02].result] ;
          vertex (y : Nat -> Bool) : Dy.V m = (In.N m y, Dy.num-below m y) ;
          g : CN.C0 = \ x y -> C5.g (vertex y.1) ;
          module Pair (x : In.I) (y0 y1 : Fibre In.cs x) {
            pf : Fin two -> Fibre In.cs x = split { none -> y0 ; some e -> y1 } ;
            pw : Fib1 = (x, pf) ;
            near : In.Near (In.N m y0.1) (In.N m y1.1) = ((D1.def342.1 pw).1 m).2 none (some none) ;
            stage-at : (i : Fin two) -> Id (Dy.V m) (((D1.def342.1 pw).1 m).1 i) (pair-v m (vertex y0.1) (vertex y1.1) i) = split {
              none -> refl (vertex y0.1) ; some e -> refl (vertex y1.1) } ;
            stage-m : Id (Dy.Tuples (suc zero) m) ((D1.def342.1 pw).1 m) (pair-t m (vertex y0.1) (vertex y1.1) near) =
              D1.t-eq m ((D1.def342.1 pw).1 m) (pair-t m (vertex y0.1) (vertex y1.1) near) stage-at ;
            d-at : Id G (d x y0 y1) (dC (vertex y0.1) (vertex y1.1) near) = calc G {
              d x y0 y1 =< symH (at-fib pw) > delta ((D1.def342.1 pw).1 n)
                =< apH delta (symH (M1.down-lim n (D1.def342.1 pw) w.1)) > delta' ((D1.def342.1 pw).1 m)
                =< apH delta' stage-m > dC (vertex y0.1) (vertex y1.1) near } ;
            bound : Id G (mul (g x y1) (d x y0 y1)) (g x y0) =
              transH (apH (mul (g x y1)) d-at) (C5.trivial (vertex y0.1) (vertex y1.1) near) ;
          } ;
          result : CN.Trivial d = Tr.Trunc[(g' : CN.C0) * CN.Bounds d g'].inc (g, \ x y0 y1 -> Pair[x, y0, y1].bound) ;
        } ;
        result : CN.Trivial d =
          TC.rec ((a : Nat) * Id (Dy.Tuples two (plus a n) -> G) (M2.CF.shift a n C1) (M2.CF.shift a n C2)) @l (CN.Trivial d)
            Tr.Trunc[(g' : CN.C0) * CN.Bounds d g'].proposition (\ v -> Later[v].result)
            (SeqProp[l].IdColim[M2.seq, M2.stage-set, n, C1, C2].to same) ;
      } ;
      result : CN.Trivial d =
        M1.CF.induction @l (\ u -> Id (M1.Lim -> G) (M1.canonical u) D' -> CN.Trivial d)
          (\ u -> F.isProp-Pi (Id (M1.Lim -> G) (M1.canonical u) D') (\ e -> CN.Trivial d) (\ e -> Tr.Trunc[(g' : CN.C0) * CN.Bounds d g'].proposition))
          (\ n delta e -> Stage[n, delta, happly M1.Lim (\ z -> G) (M1.restrict n delta) D' (transH (symH (M1.canonical-inc n delta)) e)].result)
          (eqv1.sec D') (eqv1.sec-eq D') ;
    } ;
    h1zero : CN.H1Zero = \ d cd -> Cocycle[d, cd].result ;
    theorem : CohZero In.I (\ x -> Gr) =
      H1Stone[l].Over[ax].Prop318[In.I, Nat -> Bool, Sigma411[l].cantor-stone, In.cs, In.cs-surjective, \ x -> Gr, \ x -> oG].backward h1zero ;
  } ;
  thm343ii (Gr : Grp) (oG : OD.isODisc Gr.G) : CohZero In.I (\ x -> Gr) = Thm343ii[Gr, oG].theorem ;
} ;
