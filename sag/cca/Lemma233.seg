-- CCA Lemma 2.3.3 and Lemma 2.3.4 as stated.
--
-- Lemma 2.3.3.  For a tower X of overtly discrete types and y : colim X,
--   "y is in the image of the stage i" is || (z : X i) * inc i z = y ||.
--   colim X is overtly discrete (SSD Lemma 2.6), so are its identity types
--   and the Sigma over X i (SSD Lemma 2.7), and its truncation; an overtly
--   discrete proposition is open (SSD Lemma 2.8).
-- Lemma 2.3.4.  For S Stone and a tower of sets I over S, let Im i x be the
--   image of I i x in colim I x (a subset, increasing in i).  The map of
--   towers (x : S) -> I i x  to  (x : S) -> Im i x  (h |-> classes of h x)
--   induces a surjection of colimits.  Forgetting the witnesses,
--   colim_i ((x : S) -> Im i x) -> (x : S) -> colim I x, is injective (on
--   one stage it is the inclusion of a subset), and after the induced map it
--   is the canonical map of Prop. 2.3.5.  A point of colim_i (x : S) -> Im i x
--   is merely the class of some g at a stage j; its underlying phi lies in
--   the image of stage j everywhere, so (Prop235's Lemma234: local choice +
--   Lemma 2.1.6) phi = canonical u for some u, and by injectivity the
--   induced map sends u to the class of g.
-- Lemma 2.3.4 only uses that the I i x are sets.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Bijection[l] ; open SeqColim[l] ; open ODisc[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module OC = OpenClosed[l,l] ;
module L27 = Lemma27[l] ;
module L28 = Lemma28[l,l] ;
module SM = SeqMaps[l] ;
module P235 = Prop235[l] ;

-- the image of the stage i of X in colim X
InImage (X : Seq) (i : Nat) (y : Colim[X].colim) : U l =
  Tr.Trunc[(z : X.A i) * Id (Colim[X].colim) (Colim[X].inc i z) y].carrier ;

-- Lemma 2.3.4: the tower of the images over S, and the map to it
module Images (S : U l) (Tw : P235.Tower[S]) {
  module C = P235.Colims[S, Tw] ;
  Im (i : Nat) (x : S) : U l = (c : Colim[Tw.at x].colim) * InImage (Tw.at x) i c ;
  im-up (i : Nat) (x : S) (w : Im i x) : Im (suc i) x =
    (w.1, TC.map ((z : C.I i x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc i z) w.1)
      ((z : C.I (suc i) x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc (suc i) z) w.1)
      (\ v -> (C.f i x v.1, transH (symH (Colim[Tw.at x].glue i v.1)) v.2)) w.2) ;
  -- two points of Im i x with the same underlying point are equal
  im-ext (i : Nat) (x : S) (w w' : Im i x) (q : Id (Colim[Tw.at x].colim) w.1 w'.1) : Id (Im i x) w w' =
    Sigma-eq (Colim[Tw.at x].colim) (InImage (Tw.at x) i) w.1 w'.1 w.2 w'.2 q
      Tr.Trunc[(z : C.I i x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc i z) w'.1].proposition ;
  ims : Seq = mkSeq (\ i -> (x : S) -> Im i x) (\ i g x -> im-up i x (g x)) ;
  module CI = Colim[ims] ;

  -- stage i: a point and its class
  to-image (i : Nat) (h : (x : S) -> C.I i x) (x : S) : Im i x =
    (Colim[Tw.at x].inc i (h x), Tr.Trunc[(z : C.I i x) * Id (Colim[Tw.at x].colim) (Colim[Tw.at x].inc i z) (Colim[Tw.at x].inc i (h x))].inc
      (h x, refl (Colim[Tw.at x].inc i (h x)))) ;
  stagemap : SM.SeqMap[C.pis, ims] = SM.mkSeqMap C.pis ims to-image (\ i h ->
    F.funext S (Im (suc i)) (\ x -> im-up i x (to-image i h x)) (to-image (suc i) (\ x -> C.f i x (h x)))
      (\ x -> im-ext (suc i) x (im-up i x (to-image i h x)) (to-image (suc i) (\ x' -> C.f i x' (h x')) x) (Colim[Tw.at x].glue i (h x)))) ;
  module Ind = SM.Induced[C.pis, ims, stagemap] ;
  map (u : C.CP.colim) : CI.colim = Ind.map u ;

  -- forgetting the witnesses
  module Forget = CI.Rec[C.Target, C.target-set, CI.mkCocone C.Target (\ i g x -> (g x).1) (\ i g -> refl (\ x -> (g x).1))] ;
  forget (w : CI.colim) : C.Target = Forget.map w ;
  forget-injective : Injective forget = StageInjective[l].StageInjective[ims, C.Target, forget, \ N a b q ->
    apH (CI.inc N) (F.funext S (Im N) a b (\ x -> im-ext N x (a x) (b x)
      (happly S (\ x' -> Colim[Tw.at x'].colim) (\ x' -> (a x').1) (\ x' -> (b x').1)
        (transH (symH (Forget.beta N a)) (transH q (Forget.beta N b))) x)))].injective ;
  -- after map, forget is the canonical map of Prop. 2.3.5
  forget-map (u : C.CP.colim) : Id C.Target (forget (map u)) (C.canonical u) =
    C.CP.ext C.Target C.target-set (\ u' -> forget (map u')) C.canonical (\ n h -> calc C.Target {
      forget (map (C.CP.inc n h)) =< apH forget (Ind.map-inc n h) > forget (CI.inc n (to-image n h))
        =< Forget.beta n (to-image n h) > C.pointwise n h
        =< symH (C.canonical-inc n h) > C.canonical (C.CP.inc n h) }) u ;
} ;

module Over (ax : SA.Assumptions) {
  cc : CountableChoice[l].CC = CountableChoice[l].cc (ax.dc @l) ;

  -- Lemma 2.3.3
  module Lemma233 (X : Seq) (oX : (i : Nat) -> isODisc (X.A i)) {
    colim-odisc : isODisc (Colim[X].colim) = Lemma26[l].Lemma26[cc, ax.dc @(l+), X, oX].theorem ;
    witnesses-odisc (i : Nat) (y : Colim[X].colim) : isODisc ((z : X.A i) * Id (Colim[X].colim) (Colim[X].inc i z) y) =
      L27.sigma-odisc cc (ax.dc @(l+)) (X.A i) (oX i) (\ z -> Id (Colim[X].colim) (Colim[X].inc i z) y)
        (\ z -> L27.id-odisc (Colim[X].colim) colim-odisc (Colim[X].inc i z) y) ;
    image-open (i : Nat) (y : Colim[X].colim) : OC.isOpen (InImage X i y) =
      L28.odisc-open (InImage X i y) Tr.Trunc[(z : X.A i) * Id (Colim[X].colim) (Colim[X].inc i z) y].proposition
        (L27.trunc-odisc ((z : X.A i) * Id (Colim[X].colim) (Colim[X].inc i z) y) (witnesses-odisc i y)) ;
  } ;
  lemma233 (X : Seq) (oX : (i : Nat) -> isODisc (X.A i)) (i : Nat) (y : Colim[X].colim) : OC.isOpen (InImage X i y) =
    Lemma233[X, oX].image-open i y ;

  -- Lemma 2.3.4
  module Lemma234 (S : U l) (sS : PF.isStone S) (Tw : P235.Tower[S]) {
    module G = Images[S, Tw] ;
    module P = P235.Over[ax].Prop235[S, sS, Tw] ;
    -- the class of g at the stage j
    module At (j : Nat) (g : (x : S) -> G.Im j x) {
      phi : G.C.Target = \ x -> (g x).1 ;
      phi-forget : Id G.C.Target phi (G.forget (G.CI.inc j g)) = symH (G.Forget.beta j g) ;
      lift (v : (u : G.C.CP.colim) * Id G.C.Target (G.C.canonical u) phi) : Fibre G.map (G.CI.inc j g) =
        (v.1, G.forget-injective (G.map v.1) (G.CI.inc j g) (transH (G.forget-map v.1) (transH v.2 phi-forget))) ;
      result : Tr.Trunc[Fibre G.map (G.CI.inc j g)].carrier =
        TC.map ((u : G.C.CP.colim) * Id G.C.Target (G.C.canonical u) phi) (Fibre G.map (G.CI.inc j g)) lift
          (P.Lemma234[phi, j, \ x -> (g x).2].result) ;
    } ;
    surjective (w : G.CI.colim) : Tr.Trunc[Fibre G.map w].carrier =
      G.CI.induction @l (\ w' -> Tr.Trunc[Fibre G.map w'].carrier) (\ w' -> Tr.Trunc[Fibre G.map w'].proposition)
        (\ j g -> At[j, g].result) w ;
  } ;
  lemma234 (S : U l) (sS : PF.isStone S) (Tw : P235.Tower[S]) (w : Images[S, Tw].CI.colim)
    : Tr.Trunc[Fibre (Images[S, Tw].map) w].carrier = Lemma234[S, sS, Tw].surjective w ;
} ;
