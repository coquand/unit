-- CCA Lemma 2.3.6 for a tower of Stone spaces: for S 0 <- S 1 <- .. Stone
-- and B finite, the canonical map colim_k (S k -> B) -> (lim S -> B),
-- [g] |-> g o pi_k, is an equivalence.  (The paper uses Stone duality for
-- colimits of algebras; here: compactness on the Stone spaces lim S
-- (Prop. 2.1.4 (iii)) and Lemma 2.1.6.)
--
-- Injective at stage 0.  Let g, g' : S 0 -> B agree on lim S, and y in the
--   decidable subset D = {g /= g'}.  The fibres Phi_d y of S d -> S 0 over y
--   form a tower of Stone spaces with no limit point (it would be a point of
--   lim S over y); so not every Phi_d y is inhabited (a limit of inhabited
--   Stone spaces is inhabited, LimInhabited), and by Markov some Phi_d y is
--   empty (inhabitation of a Stone space is closed).  These conditions
--   increase with d, so by Lemma 2.1.6 one d serves every y in D: g and g'
--   agree on the image of S d, and [g] = [g'].
-- Injective at stage N+1: lim S = lim (S o suc) (extend a point by p 0 of
--   its first component), so this is stage N for the tower S o suc, and
--   colim (S (k+1) -> B) maps to colim (S k -> B).
-- Surjective, B = 2.  Let f : lim S -> 2.  Points x, x' with f x = 1,
--   f x' = 0 differ, so they differ at some stage (Markov, equality is
--   closed), increasingly; Lemma 2.1.6 on the Stone space of such pairs gives
--   one k.  The images in S k of {f = 1} and {f = 0} are then disjoint
--   closed subsets, separated by a decidable d (SSD Lemma 3.16): d o pi_k = f.
-- Surjective, B = Fin m.  The characteristic maps [f = i] come from one
--   stage K (finite choice, a bound), as h i : S K -> 2; at a point of the
--   image exactly one h i is 1, and g = the first such i (pick) has
--   g o pi_K = f.  For m = 0, lim S is empty, and then the constant maps
--   true, false : S 0 -> 2 are equal in the colimit (injectivity), so some
--   S d is empty.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open SeqColim[l] ; open Logic[l] ; open Ring[l] ;
open FinChoice[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module OC = OpenClosed[l,l] ;
module BR = BooleanRing[l] ;
module TP = TwoPresented[l] ;
module DF = DecFree[l] ;
module Fi = Finite[l] ;
module FCl = FiniteClosure[l] ;
module DCh = DependentChoice[l] ;
module FCo = FiniteCode[l] ;
module L216 = Lemma216[l] ;
module L236 = Lemma236[l] ;

-- going down to stage 0
dn (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) : (d : Nat) -> S d -> S zero = split {
  zero -> \ z -> z ;
  suc d | r -> \ z -> r (p d z) } ;
-- the shifted tower, and the comparison of colimits
module Shift (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (B : U l) (sB : isSet B) {
  S' (d : Nat) : U l = S (suc d) ;
  p' (d : Nat) (z : S' (suc d)) : S' d = p (suc d) z ;
  head (w : DCh.Lim S' p') : (n : Nat) -> S n = split { zero -> p zero (w.1 zero) ; suc d -> w.1 d } ;
  head-compat (w : DCh.Lim S' p') : (n : Nat) -> Id (S n) (p n (head w (suc n))) (head w n) = split {
    zero -> refl (p zero (w.1 zero)) ; suc d -> w.2 d } ;
  extend (w : DCh.Lim S' p') : DCh.Lim S p = (head w, head-compat w) ;
  module M = L236.FMaps[S, p, B, sB] ;
  module M' = L236.FMaps[S', p', B, sB] ;
  module R = M'.CF.Rec[M.CF.colim, M.CF.set, M'.CF.mkCocone M.CF.colim (\ n h -> M.CF.inc (suc n) h)
    (\ n h -> symH (M.CF.glue (suc n) h))] ;
  down (u : M'.CF.colim) : M.CF.colim = R.map u ;
} ;
-- the class of g at stage 0 is the class of g o dn d at stage d
inc-dn (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (B : U l) (sB : isSet B) (g : S zero -> B)
  : (d : Nat) -> Id (L236.FMaps[S, p, B, sB].CF.colim) (L236.FMaps[S, p, B, sB].CF.inc zero g)
      (L236.FMaps[S, p, B, sB].CF.inc d (\ z -> g (dn S p d z))) = split {
  zero -> refl (L236.FMaps[S, p, B, sB].CF.inc zero g) ;
  suc d | r -> transH r (L236.FMaps[S, p, B, sB].CF.glue d (\ z -> g (dn S p d z))) } ;

-- deciding a proposition as a Boolean
holds (A : U l) : Dec A -> Bool = split { yes a -> true ; no n -> false } ;
holds-yes (A : U l) : (d : Dec A) -> A -> Id Bool (holds A d) true = split {
  yes a -> \ a' -> refl true ; no n -> \ a -> absurd (Id Bool false true) (n a) } ;
holds-elim (A : U l) : (d : Dec A) -> Id Bool (holds A d) true -> A = split {
  yes a -> \ t -> a ; no n -> \ t -> absurd A (BR.true-false (symH t)) } ;
not-true : (b : Bool) -> Not (Id Bool b true) -> Id Bool b false = split {
  true -> \ n -> absurd (Id Bool true false) (n (refl true)) ; false -> \ n -> refl false } ;

-- the first i with h i = 1
choose (m : Nat) (rest : Fin (suc m)) : Bool -> Fin (suc (suc m)) = split { true -> none ; false -> some rest } ;
pick : (m : Nat) -> (Fin (suc m) -> Bool) -> Fin (suc m) = split {
  zero -> \ h -> none ;
  suc m | r -> \ h -> choose m (r (\ i -> h (some i))) (h none) } ;
some-inj (A : U l) (a b : A) (e : Id (Opt A) (some a) (some b)) : Id A a b = apH (L236.get A a) e ;
fin-one : (j : Fin (suc zero)) -> Id (Fin (suc zero)) none j = split { none -> refl none ; some e -> absurd (Id (Fin (suc zero)) none (some e)) e } ;
module PickSpec (m : Nat) (h : Fin (suc (suc m)) -> Bool) (r : Fin (suc m)) {
  at-true (t : Id Bool (h none) true) : Id (Fin (suc (suc m))) (choose m r (h none)) none =
    apH (choose m r) t ;
  at-false (t : Id Bool (h none) false) : Id (Fin (suc (suc m))) (choose m r (h none)) (some r) =
    apH (choose m r) t ;
} ;
module PickCases (m : Nat) (h : Fin (suc (suc m)) -> Bool) (j : Fin (suc (suc m)))
  (sp : (i : Fin (suc (suc m))) -> Id Bool (h i) true -> Id (Fin (suc (suc m))) i j) (hj : Id Bool (h j) true)
  (r : (h' : Fin (suc m) -> Bool) (j' : Fin (suc m)) (sp' : (i : Fin (suc m)) -> Id Bool (h' i) true -> Id (Fin (suc m)) i j')
       (hj' : Id Bool (h' j') true) -> Id (Fin (suc m)) (pick m h') j') {
  h' (i : Fin (suc m)) : Bool = h (some i) ;
  rest : Fin (suc m) = pick m h' ;
  module PS = PickSpec[m, h, rest] ;
  in-rest (j' : Fin (suc m)) (e : Id (Fin (suc (suc m))) (some j') j) (t : Id Bool (h none) false) :
    Id (Fin (suc (suc m))) (choose m rest (h none)) j =
    transH (PS.at-false t) (transH (apH (\ i0 -> some i0) (r h' j' (\ i hi -> some-inj (Fin (suc m)) i j' (transH (sp (some i) hi) (symH e)))
      (substH (\ k -> Id Bool (h k) true) (symH e) hj))) e) ;
  on-j (t : Id Bool (h none) false) : (k : Fin (suc (suc m))) -> Id (Fin (suc (suc m))) k j -> Id (Fin (suc (suc m))) (choose m rest (h none)) j = split {
    none -> \ e -> absurd (Id (Fin (suc (suc m))) (choose m rest (h none)) j)
      (BR.true-false (transH (symH (substH (\ k -> Id Bool (h k) true) (symH e) hj)) t)) ;
    some j' -> \ e -> in-rest j' e t } ;
  by-head : Plus (Id Bool (h none) true) (Id Bool (h none) false) -> Id (Fin (suc (suc m))) (choose m rest (h none)) j = split {
    inl t -> transH (PS.at-true t) (sp none t) ;
    inr t -> on-j t j (refl j) } ;
  result : Id (Fin (suc (suc m))) (pick (suc m) h) j = by-head (TP.bool-cases (h none)) ;
} ;

pick-spec : (m : Nat) (h : Fin (suc m) -> Bool) (j : Fin (suc m)) (sp : (i : Fin (suc m)) -> Id Bool (h i) true -> Id (Fin (suc m)) i j)
  (hj : Id Bool (h j) true) -> Id (Fin (suc m)) (pick m h) j = split {
  zero -> \ h j sp hj -> fin-one j ;
  suc m | r -> \ h j sp hj -> PickCases[m, h, j, sp, hj, r].result } ;
module Over (ax : SA.Assumptions) {
  module P214 = Prop214[l].Over[ax] ;
  module CP = CountableProduct[l].Over[ax] ;
  module LI = LimInhabited[l].Over[ax] ;

  -- injective at stage 0
  module Zero (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (B : U l) (fB : Fi.isFinite B) (g g' : S zero -> B) (agree : (x : DCh.Lim S p) -> Id B (g (x.1 zero)) (g' (x.1 zero))) {
    sB : isSet B = FCl.finite-set B fB ;
    module M = L236.FMaps[S, p, B, sB] ;
    D (y : S zero) : Bool = L236.differ (Id B (g y) (g' y)) (L236.eq-dec B fB (g y) (g' y)) ;
    Bad : U l = (y : S zero) * Id Bool (D y) true ;
    bad-stone : PF.isStone Bad = CP.sub-stone (S zero) (sS zero) (\ y -> Id Bool (D y) true) (\ y -> BR.bool-set (D y) true)
      (\ y -> OC.dec-closed (Id Bool (D y) true) (DF.bool-dec (D y) true)) ;
    Phi (y : S zero) (d : Nat) : U l = Fibre (dn S p d) y ;
    phi-stone (y : S zero) (d : Nat) : PF.isStone (Phi y d) = P214.fibre-stone (S d) (S zero) (sS d) (sS zero) (dn S p d) y ;
    phi-p (y : S zero) (d : Nat) (u : Phi y (suc d)) : Phi y d = (p d u.1, u.2) ;
    -- a limit point of the fibres over y is a point of lim S over y
    no-limit (y : S zero) (b : Id Bool (D y) true) (w : DCh.Lim (Phi y) (phi-p y)) : Empty =
      BR.true-false (transH (symH b) (transH (apH D (symH (w.1 zero).2))
        (L236.differ-yes (Id B (g (w.1 zero).1) (g' (w.1 zero).1)) (L236.eq-dec B fB (g (w.1 zero).1) (g' (w.1 zero).1))
          (agree (\ d -> (w.1 d).1, \ d -> apH (\ u -> u.1) (w.2 d)))))) ;
    empty-at : L216.Increasing[Bad] = L216.mkIncreasing Bad (\ d v -> Not (Tr.Trunc[Phi v.1 d].carrier))
      (\ d v -> not-prop (Tr.Trunc[Phi v.1 d].carrier))
      (\ d v ne t -> ne (TC.map (Phi v.1 (suc d)) (Phi v.1 d) (phi-p v.1 d) t)) ;
    cover (v : Bad) : Tr.Trunc[L216.Up[Bad, empty-at].Cover v].carrier =
      CountableProduct[l].NotAll[ax, \ d -> Tr.Trunc[Phi v.1 d].carrier,
        \ d -> StoneClosed[l,l].Over[ax].cor38 (Phi v.1 d) (phi-stone v.1 d),
        \ all -> TC.rec (DCh.Lim (Phi v.1) (phi-p v.1)) @l Empty isProp-Empty (no-limit v.1 v.2)
          (LI.lim-inhabited (Phi v.1) (phi-p v.1) (phi-stone v.1) all)].result ;
    module Stage (d : Nat) (em : (v : Bad) -> Not (Tr.Trunc[Phi v.1 d].carrier)) {
      not-bad (z : S d) : Id Bool (D (dn S p d z)) false =
        not-true (D (dn S p d z)) (\ b -> em (dn S p d z, b) (Tr.Trunc[Phi (dn S p d z) d].inc (z, refl (dn S p d z)))) ;
      same-d : Id (S d -> B) (\ z -> g (dn S p d z)) (\ z -> g' (dn S p d z)) =
        F.funext (S d) (\ z -> B) (\ z -> g (dn S p d z)) (\ z -> g' (dn S p d z)) (\ z ->
          L236.differ-elim (Id B (g (dn S p d z)) (g' (dn S p d z))) (L236.eq-dec B fB (g (dn S p d z)) (g' (dn S p d z))) (not-bad z)) ;
      result : Id M.CF.colim (M.CF.inc zero g) (M.CF.inc zero g') = calc M.CF.colim {
        M.CF.inc zero g =< inc-dn S p B sB g d > M.CF.inc d (\ z -> g (dn S p d z))
          =< apH (M.CF.inc d) same-d > M.CF.inc d (\ z -> g' (dn S p d z))
          =< symH (inc-dn S p B sB g' d) > M.CF.inc zero g' } ;
    } ;
    result : Id M.CF.colim (M.CF.inc zero g) (M.CF.inc zero g') =
      TC.rec ((d : Nat) * ((v : Bad) -> Not (Tr.Trunc[Phi v.1 d].carrier))) @l (Id M.CF.colim (M.CF.inc zero g) (M.CF.inc zero g'))
        (M.CF.set (M.CF.inc zero g) (M.CF.inc zero g')) (\ w -> Stage[w.1, w.2].result)
        (L216.Over[ax].lemma216 Bad bad-stone empty-at cover) ;
  } ;
  -- injective at every stage
  inj-at : (N : Nat) (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (B : U l) (fB : Fi.isFinite B) (g g' : S N -> B) (agree : (x : DCh.Lim S p) -> Id B (g (x.1 N)) (g' (x.1 N))) ->
    Id (L236.FMaps[S, p, B, FCl.finite-set B fB].CF.colim) (L236.FMaps[S, p, B, FCl.finite-set B fB].CF.inc N g)
      (L236.FMaps[S, p, B, FCl.finite-set B fB].CF.inc N g') = split {
    zero -> \ S p sS B fB g g' agree -> Zero[S, p, sS, B, fB, g, g', agree].result ;
    suc N | r -> \ S p sS B fB g g' agree ->
      transH (symH (Shift[S, p, B, FCl.finite-set B fB].R.beta N g))
        (transH (apH Shift[S, p, B, FCl.finite-set B fB].down
           (r Shift[S, p, B, FCl.finite-set B fB].S' Shift[S, p, B, FCl.finite-set B fB].p' (\ d -> sS (suc d)) B fB g g'
             (\ w -> agree (Shift[S, p, B, FCl.finite-set B fB].extend w))))
          (Shift[S, p, B, FCl.finite-set B fB].R.beta N g')) } ;

  module Lemma236Stone (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (B : U l) (fB : Fi.isFinite B) {
    module M = L236.FMaps[S, p, B, FCl.finite-set B fB] ;
    lim-stone : PF.isStone M.Lim = CP.lim-stone S p sS ;
    injective : Injective M.canonical =
      StageInjective[l].StageInjective[M.seq, M.Lim -> B, M.canonical, \ N g g' q ->
        inj-at N S p sS B fB g g' (happly M.Lim (\ x -> B) (M.restrict N g) (M.restrict N g')
          (transH (symH (M.canonical-inc N g)) (transH q (M.canonical-inc N g'))))].injective ;
  } ;

  -- surjective for B = 2
  module SurjBool (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (f : DCh.Lim S p -> Bool) {
    module M = L236.FMaps[S, p, Bool, BR.bool-set] ;
    lim-stone : PF.isStone M.Lim = CP.lim-stone S p sS ;
    lim-set : isSet M.Lim = P214.stone-set M.Lim lim-stone ;
    Goal : U l = Tr.Trunc[Fibre M.canonical f].carrier ;
    Cond (u : M.Lim * M.Lim) : U l = Id Bool (f u.1) true * Id Bool (f u.2) false ;
    Pairs : U l = (u : M.Lim * M.Lim) * Cond u ;
    pairs-stone : PF.isStone Pairs =
      CP.sub-stone (M.Lim * M.Lim) (P214.product-stone M.Lim M.Lim lim-stone lim-stone) Cond
        (\ u -> isProp-Sigma (Id Bool (f u.1) true) (\ t -> Id Bool (f u.2) false) (BR.bool-set (f u.1) true) (\ t -> BR.bool-set (f u.2) false))
        (\ u -> OC.closed-and (Id Bool (f u.1) true) (Id Bool (f u.2) false)
          (OC.dec-closed (Id Bool (f u.1) true) (DF.bool-dec (f u.1) true)) (OC.dec-closed (Id Bool (f u.2) false) (DF.bool-dec (f u.2) false))) ;
    apart : L216.Increasing[Pairs] = L216.mkIncreasing Pairs (\ k w -> Not (Id (S k) (w.1.1.1 k) (w.1.2.1 k)))
      (\ k w -> not-prop (Id (S k) (w.1.1.1 k) (w.1.2.1 k)))
      (\ k w ne e -> ne (transH (symH (w.1.1.2 k)) (transH (apH (p k) e) (w.1.2.2 k)))) ;
    module Apart (w : Pairs) {
      eq (all : (k : Nat) -> Id (S k) (w.1.1.1 k) (w.1.2.1 k)) : Id M.Lim w.1.1 w.1.2 =
        SeqLim[l].Limit[SeqLim[l].mkInvSeq S p].Sets[\ n -> P214.stone-set (S n) (sS n)].lim-eq w.1.1 w.1.2 all ;
    } ;
    cover (w : Pairs) : Tr.Trunc[L216.Up[Pairs, apart].Cover w].carrier =
      CountableProduct[l].NotAll[ax, \ k -> Id (S k) (w.1.1.1 k) (w.1.2.1 k),
        \ k -> StoneClosed[l,l].lemma310 (S k) (sS k) (w.1.1.1 k) (w.1.2.1 k),
        \ all -> BR.true-false (transH (symH w.2.1) (transH (apH f (Apart[w].eq all)) w.2.2))].result ;
    module Stage (k : Nat) (sep-k : (w : Pairs) -> Not (Id (S k) (w.1.1.1 k) (w.1.2.1 k))) {
      Side (b : Bool) (y : S k) : U l = Tr.Trunc[(x : M.Lim) * (Id (S k) (x.1 k) y * Id Bool (f x) b)].carrier ;
      over-closed (b : Bool) (y : S k) : OC.isClosed (Side b y) =
        Thm311[l].Over[ax].closed-exists M.Lim lim-stone (\ x -> Id (S k) (x.1 k) y * Id Bool (f x) b)
          (\ x -> isProp-Sigma (Id (S k) (x.1 k) y) (\ e -> Id Bool (f x) b) (P214.stone-set (S k) (sS k) (x.1 k) y) (\ e -> BR.bool-set (f x) b))
          (\ x -> OC.closed-and (Id (S k) (x.1 k) y) (Id Bool (f x) b) (StoneClosed[l,l].lemma310 (S k) (sS k) (x.1 k) y)
            (OC.dec-closed (Id Bool (f x) b) (DF.bool-dec (f x) b))) ;
      disjoint (y : S k) (a : Side true y) (c : Side false y) : Empty =
        TC.rec ((x : M.Lim) * (Id (S k) (x.1 k) y * Id Bool (f x) true)) @l Empty isProp-Empty (\ u ->
          TC.rec ((x : M.Lim) * (Id (S k) (x.1 k) y * Id Bool (f x) false)) @l Empty isProp-Empty (\ v ->
            sep-k ((u.1, v.1), u.2.2, v.2.2) (transH u.2.1 (symH v.2.1))) c) a ;
      module Sep (sep : Lemma316[l].Separation (S k) (Side true) (Side false)) {
        at-point (x : M.Lim) : Plus (Id Bool (f x) true) (Id Bool (f x) false) -> Id Bool (sep.1 (x.1 k)) (f x) = split {
          inl t -> transH (sep.2.1 (x.1 k) (Tr.Trunc[(x' : M.Lim) * (Id (S k) (x'.1 k) (x.1 k) * Id Bool (f x') true)].inc (x, refl (x.1 k), t))) (symH t) ;
          inr t -> transH (sep.2.2 (x.1 k) (Tr.Trunc[(x' : M.Lim) * (Id (S k) (x'.1 k) (x.1 k) * Id Bool (f x') false)].inc (x, refl (x.1 k), t))) (symH t) } ;
        onto : Fibre M.canonical f = (M.CF.inc k sep.1, transH (M.canonical-inc k sep.1)
          (F.funext M.Lim (\ x -> Bool) (M.restrict k sep.1) f (\ x -> at-point x (TP.bool-cases (f x))))) ;
      } ;
      result : Goal =
        TC.map (Lemma316[l].Separation (S k) (Side true) (Side false)) (Fibre M.canonical f) (\ sep -> Sep[sep].onto)
          (Lemma316[l].Over[ax].lemma316 (S k) (sS k) (Side true) (Side false)
            (\ y -> Tr.Trunc[(x : M.Lim) * (Id (S k) (x.1 k) y * Id Bool (f x) true)].proposition)
            (\ y -> Tr.Trunc[(x : M.Lim) * (Id (S k) (x.1 k) y * Id Bool (f x) false)].proposition)
            (over-closed true) (over-closed false) disjoint) ;
    } ;
    result : Goal =
      TC.rec ((k : Nat) * ((w : Pairs) -> Not (Id (S k) (w.1.1.1 k) (w.1.2.1 k)))) @l Goal Tr.Trunc[Fibre M.canonical f].proposition
        (\ v -> Stage[v.1, v.2].result) (L216.Over[ax].lemma216 Pairs pairs-stone apart cover) ;
  } ;
  -- surjective for B = Fin 0: lim S is empty, so some S d is
  module SurjEmpty (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (f : DCh.Lim S p -> Fin zero) {
    module MB = L236.FMaps[S, p, Bool, FCl.finite-set Bool FiniteFacts[l].bool-finite] ;
    module MF = L236.FMaps[S, p, Fin zero, FCl.finite-set (Fin zero) (FCl.fin-finite zero)] ;
    Goal : U l = Tr.Trunc[Fibre MF.canonical f].carrier ;
    ct (y : S zero) : Bool = true ;
    cf (y : S zero) : Bool = false ;
    same : Id MB.CF.colim (MB.CF.inc zero ct) (MB.CF.inc zero cf) =
      inj-at zero S p sS Bool FiniteFacts[l].bool-finite ct cf (\ x -> absurd (Id Bool true false) (f x)) ;
    module After (w : (d : Nat) * Id (S (plus d zero) -> Bool) (MB.CF.shift d zero ct) (MB.CF.shift d zero cf)) {
      empty (y : S (plus w.1 zero)) : Empty = BR.true-false (transH (symH (MB.shift-down zero ct w.1 y))
        (transH (happly (S (plus w.1 zero)) (\ z -> Bool) (MB.CF.shift w.1 zero ct) (MB.CF.shift w.1 zero cf) w.2 y)
          (MB.shift-down zero cf w.1 y))) ;
      g (y : S (plus w.1 zero)) : Fin zero = absurd (Fin zero) (empty y) ;
      onto : Fibre MF.canonical f = (MF.CF.inc (plus w.1 zero) g, transH (MF.canonical-inc (plus w.1 zero) g)
        (F.funext MF.Lim (\ x -> Fin zero) (MF.restrict (plus w.1 zero) g) f (\ x -> absurd (Id (Fin zero) (g (x.1 (plus w.1 zero))) (f x)) (f x)))) ;
    } ;
    result : Goal =
      TC.map ((d : Nat) * Id (S (plus d zero) -> Bool) (MB.CF.shift d zero ct) (MB.CF.shift d zero cf)) (Fibre MF.canonical f)
        (\ w -> After[w].onto) (SeqProp[l].IdColim[MB.seq, MB.stage-set, zero, ct, cf].to same) ;
  } ;

  -- surjective for B = Fin (m+1)
  module SurjSuc (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (m : Nat) (f : DCh.Lim S p -> Fin (suc m)) {
    module MF = L236.FMaps[S, p, Fin (suc m), FCl.finite-set (Fin (suc m)) (FCl.fin-finite (suc m))] ;
    module MB = L236.FMaps[S, p, Bool, BR.bool-set] ;
    Goal : U l = Tr.Trunc[Fibre MF.canonical f].carrier ;
    chi (i : Fin (suc m)) (x : MF.Lim) : Bool =
      holds (Id (Fin (suc m)) (f x) i) (L236.eq-dec (Fin (suc m)) (FCl.fin-finite (suc m)) (f x) i) ;
    -- [f = i] at a stage k
    Q (i : Fin (suc m)) (k : Nat) : U l = (h : S k -> Bool) * ((x : MF.Lim) -> Id Bool (h (x.1 k)) (chi i x)) ;
    up (i : Fin (suc m)) (k a : Nat) (q : Q i k) : Q i (plus a k) =
      (\ y -> q.1 (FCo.down S p k a y), \ x -> transH (apH q.1 (MB.down-lim k x a)) (q.2 x)) ;
    start (i : Fin (suc m)) : Tr.Trunc[(k : Nat) * Q i k].carrier =
      TC.rec (Fibre MB.canonical (chi i)) @l (Tr.Trunc[(k : Nat) * Q i k].carrier) Tr.Trunc[(k : Nat) * Q i k].proposition (\ v ->
        MB.CF.induction @l (\ u -> Id (MF.Lim -> Bool) (MB.canonical u) (chi i) -> Tr.Trunc[(k : Nat) * Q i k].carrier)
          (\ u -> F.isProp-Pi (Id (MF.Lim -> Bool) (MB.canonical u) (chi i)) (\ e -> Tr.Trunc[(k : Nat) * Q i k].carrier)
            (\ e -> Tr.Trunc[(k : Nat) * Q i k].proposition))
          (\ k h e -> Tr.Trunc[(k' : Nat) * Q i k'].inc (k, h, happly MF.Lim (\ x -> Bool) (MB.restrict k h) (chi i)
             (transH (symH (MB.canonical-inc k h)) e)))
          v.1 v.2) (SurjBool[S, p, sS, chi i].result) ;
    module Stage (K : Nat) (qs : (i : Fin (suc m)) -> Q i K) {
      g (y : S K) : Fin (suc m) = pick m (\ i -> (qs i).1 y) ;
      at-point (x : MF.Lim) : Id (Fin (suc m)) (g (x.1 K)) (f x) =
        pick-spec m (\ i -> (qs i).1 (x.1 K)) (f x)
          (\ i t -> symH (holds-elim (Id (Fin (suc m)) (f x) i) (L236.eq-dec (Fin (suc m)) (FCl.fin-finite (suc m)) (f x) i)
            (transH (symH ((qs i).2 x)) t)))
          (transH ((qs (f x)).2 x) (holds-yes (Id (Fin (suc m)) (f x) (f x)) (L236.eq-dec (Fin (suc m)) (FCl.fin-finite (suc m)) (f x) (f x))
            (refl (f x)))) ;
      onto : Fibre MF.canonical f = (MF.CF.inc K g, transH (MF.canonical-inc K g)
        (F.funext MF.Lim (\ x -> Fin (suc m)) (MF.restrict K g) f at-point)) ;
    } ;
    result : Goal =
      TC.map ((K : Nat) * ((i : Fin (suc m)) -> Q i K)) (Fibre MF.canonical f) (\ w -> Stage[w.1, w.2].onto)
        (Fi.Uniform[Fin (suc m), FCl.fin-finite (suc m), Q, up].stage start) ;
  } ;
  surj-fin (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n)) : (m : Nat) (f : DCh.Lim S p -> Fin m) ->
    Tr.Trunc[Fibre L236.FMaps[S, p, Fin m, FCl.finite-set (Fin m) (FCl.fin-finite m)].canonical f].carrier = split {
    zero -> \ f -> SurjEmpty[S, p, sS, f].result ;
    suc m -> \ f -> SurjSuc[S, p, sS, m, f].result } ;

  -- surjective for B finite, along an enumeration
  module Surj (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (B : U l) (fB : Fi.isFinite B) (f : DCh.Lim S p -> B) (c : Fi.FinEquiv B) {
    module M = L236.FMaps[S, p, B, FCl.finite-set B fB] ;
    module MF = L236.FMaps[S, p, Fin c.1, FCl.finite-set (Fin c.1) (FCl.fin-finite c.1)] ;
    Goal : U l = Tr.Trunc[Fibre M.canonical f].carrier ;
    f' (x : M.Lim) : Fin c.1 = c.2.1 (f x) ;
    module Stage (K : Nat) (g' : S K -> Fin c.1) (e : (x : M.Lim) -> Id (Fin c.1) (g' (x.1 K)) (f' x)) {
      g (y : S K) : B = c.2.2.sec (g' y) ;
      at-point (x : M.Lim) : Id B (g (x.1 K)) (f x) =
        transH (apH c.2.2.sec (e x)) (sec-ret B (Fin c.1) c.2.1 c.2.2 (f x)) ;
      onto : Fibre M.canonical f = (M.CF.inc K g, transH (M.canonical-inc K g) (F.funext M.Lim (\ x -> B) (M.restrict K g) f at-point)) ;
    } ;
    result : Goal =
      TC.rec (Fibre MF.canonical f') @l Goal Tr.Trunc[Fibre M.canonical f].proposition (\ v ->
        MF.CF.induction @l (\ u -> Id (M.Lim -> Fin c.1) (MF.canonical u) f' -> Goal)
          (\ u -> F.isProp-Pi (Id (M.Lim -> Fin c.1) (MF.canonical u) f') (\ e -> Goal) (\ e -> Tr.Trunc[Fibre M.canonical f].proposition))
          (\ K g' e -> Tr.Trunc[Fibre M.canonical f].inc (Stage[K, g', happly M.Lim (\ x -> Fin c.1) (MF.restrict K g') f'
             (transH (symH (MF.canonical-inc K g')) e)].onto))
          v.1 v.2) (surj-fin S p sS c.1 f') ;
  } ;
  -- the same, as one module
  module Stone236 (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (B : U l) (fB : Fi.isFinite B) {
    module M = L236.FMaps[S, p, B, FCl.finite-set B fB] ;
    injective : Injective M.canonical = Lemma236Stone[S, p, sS, B, fB].injective ;
    surjective (f : M.Lim -> B) : Tr.Trunc[Fibre M.canonical f].carrier =
      TC.rec (Fi.FinEquiv B) @l (Tr.Trunc[Fibre M.canonical f].carrier) Tr.Trunc[Fibre M.canonical f].proposition
        (\ c -> Surj[S, p, sS, B, fB, f, c].result) fB ;
    equivalence : isEquiv M.CF.colim (M.Lim -> B) M.canonical = Bij[M.CF.colim, M.Lim -> B, M.fun-set, M.canonical, injective, surjective].equiv ;
  } ;
  -- Lemma 2.3.6 for towers of Stone spaces
  lemma236-stone (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n))
    (B : U l) (fB : Fi.isFinite B) :
    isEquiv (L236.FMaps[S, p, B, FCl.finite-set B fB].CF.colim) (L236.FMaps[S, p, B, FCl.finite-set B fB].Lim -> B)
      (L236.FMaps[S, p, B, FCl.finite-set B fB].canonical) =
    Stone236[S, p, sS, B, fB].equivalence ;
} ;
