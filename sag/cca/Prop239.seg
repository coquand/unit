-- CCA Lemma 2.3.8 and Prop. 2.3.9 (Tychonov's dual): for S Stone and
-- I x overtly discrete, (x : S) -> I x is overtly discrete.
--
-- Small presentations.  Local choice is for families in U l, and a
-- presentation (a sequence of types) is large; but an overtly discrete X
-- merely has one by stages Fin (c n) (enumerate the stages, countable
-- choice; levelwise equivalences give an equivalence of colimits).
-- (T -> B) for T Stone, B finite: T = lim E (SSD Lemma 3.1) and
--   (lim E -> B) = colim_k (E k -> B) (Lemma 2.3.6), a colimit of finite sets.
-- (t : T) -> Fin (c t) for T Stone: c = c' o pi_K for some c' : E K -> N
--   (SSD Cor. 3.7), and (t : T) -> Fin (c' (pi_K t)) is the product over
--   the finite set E K of the (Fibre pi_K y -> Fin (c' y)), each of the
--   previous kind (fibres of a map of Stone spaces are Stone).  (The paper
--   partitions T by the values of c, bounded; this is the same with the
--   partition by E K.)
-- Lemma 2.3.8.  For q : T ->> S of Stone spaces, (x : S) -> I x is the
--   subtype of the g : (t : T) -> I (q t) that agree over each pair of
--   points of a fibre: a section h gives g = h o q, and such a g descends
--   (weakly constant on each merely inhabited fibre).  Agreeing is a
--   forall over a Stone space of identity types of overtly discrete types,
--   open by Lemma 2.1.5, so the subtype is overtly discrete (Sigma).
-- Prop. 2.3.9.  By local choice, q : T ->> S with I (q t) = colim_n
--   Fin (c_t n).  By Lemma 2.3.8 it is enough that (t : T) -> I (q t) is
--   overtly discrete; it is (t : T) -> colim_n Fin (c_t n) = colim_n
--   (t : T) -> Fin (c_t n) (Prop. 2.3.5), a colimit of overtly discrete
--   types (SSD Lemma 2.6).
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open Bijection[l] ; open SeqColim[l] ; open FinChoice[l] ; open ODisc[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module Fi = Finite[l] ;
module FCl = FiniteClosure[l] ;
module OC = OpenClosed[l,l] ;
module L27 = Lemma27[l] ;
module L28 = Lemma28[l,l] ;
module SM = SeqMaps[l] ;
module Eq = Equivalences[l] ;
module PC = PiClosure[l] ;
module P235 = Prop235[l] ;
module L236 = Lemma236[l] ;

-- presentations by the stages Fin (c n)
finSeq (c : Nat -> Nat) (m : (n : Nat) -> Fin (c n) -> Fin (c (suc n))) : Seq = mkSeq (\ n -> Fin (c n)) m ;
FinPres (X : U l) : U l = (c : Nat -> Nat) * (m : (n : Nat) -> Fin (c n) -> Fin (c (suc n))) * Equiv X (Colim[finSeq c m].colim) ;
module Enumerate (X : U l) (pr : Pres[X]) (w : (n : Nat) -> Fi.FinEquiv (pr.seq.A n)) {
  c (n : Nat) : Nat = (w n).1 ;
  h (n : Nat) (i : Fin (c n)) : pr.seq.A n = (w n).2.2.sec i ;
  m (n : Nat) (i : Fin (c n)) : Fin (c (suc n)) = (w (suc n)).2.1 (pr.seq.f n (h n i)) ;
  H : SM.SeqMap[finSeq c m, pr.seq] = SM.mkSeqMap (finSeq c m) pr.seq h (\ n i ->
    symH (sec-ret (pr.seq.A (suc n)) (Fin (c (suc n))) (w (suc n)).2.1 (w (suc n)).2.2 (pr.seq.f n (h n i)))) ;
  module I = SM.Induced[finSeq c m, pr.seq, H] ;
  h-inj (n : Nat) : Injective (h n) = \ i j e -> calc (Fin (c n)) {
    i =< symH ((w n).2.2.sec-eq i) > (w n).2.1 (h n i) =< apH (w n).2.1 e > (w n).2.1 (h n j) =< (w n).2.2.sec-eq j > j } ;
  h-surj (n : Nat) (y : pr.seq.A n) : Tr.Trunc[Fibre (h n) y].carrier =
    Tr.Trunc[Fibre (h n) y].inc ((w n).2.1 y, sec-ret (pr.seq.A n) (Fin (c n)) (w n).2.1 (w n).2.2 y) ;
  colim-equiv : Equiv (Colim[finSeq c m].colim) (Colim[pr.seq].colim) =
    (I.map, Bij[Colim[finSeq c m].colim, Colim[pr.seq].colim, Colim[pr.seq].set, I.map, I.Inj[h-inj].injective,
      I.Surj[h-surj].surjective].equiv) ;
  fin-pres : FinPres X = (c, m, Eq.compose X (Colim[pr.seq].colim) (Colim[finSeq c m].colim) pr.equiv
    (inverse (Colim[finSeq c m].colim) (Colim[pr.seq].colim) colim-equiv)) ;
} ;
fin-pres (cc : CountableChoice[l].CC) (X : U l) (oX : isODisc X) : Tr.Trunc[FinPres X].carrier =
  T1.Trunc[Pres[X]].induction @l (\ t -> Tr.Trunc[FinPres X].carrier) (\ t -> Tr.Trunc[FinPres X].proposition) (\ pr ->
    TC.map ((n : Nat) -> Fi.FinEquiv (pr.seq.A n)) (FinPres X) (\ w -> Enumerate[X, pr, w].fin-pres)
      (cc (\ n -> Fi.FinEquiv (pr.seq.A n)) pr.finite)) oX ;

-- a path of Nat gives an equivalence of the Fin
fin-path (a b : Nat) (p : Id Nat a b) : Equiv (Fin a) (Fin b) = idJ Nat a (\ b1 p1 -> Equiv (Fin a) (Fin b1)) (idEquiv (Fin a)) b p ;
-- transport along e : x = y takes h x to h y
transport-section (S : U l) (I : S -> U l) (h : (x : S) -> I x) (x y : S) (e : Id S x y) : Id (I y) (substH I e (h x)) (h y) =
  idJ S x (\ y1 e1 -> Id (I y1) (substH I e1 (h x)) (h y1)) (refl (h x)) y e ;

module Over (ax : SA.Assumptions) {
  cc : CountableChoice[l].CC = CountableChoice[l].cc (ax.dc @l) ;
  module Pd = PC.Products[cc, ax.dc @(l+)] ;
  module P214 = Prop214[l].Over[ax] ;

  -- (T -> B) for T Stone, B finite
  module StoneFin (T : U l) (B : U l) (fB : Fi.isFinite B) (lp : PF.LimPres[T]) {
    module L = L236.Over[ax].Lemma236[lp.E, lp.p, lp.finite, B, fB] ;
    pres : Pres[L.M.Lim -> B] = mkPres (L.M.Lim -> B) L.M.seq
      (\ n -> PC.pi-finite (lp.E n) (lp.finite n) (\ y -> B) (\ y -> fB))
      (inverse L.M.CF.colim (L.M.Lim -> B) (L.M.canonical, L.equivalence)) ;
    result : isODisc (T -> B) =
      L27.odisc-equiv (T -> B) (L.M.Lim -> B) (PC.pi-domain L.M.Lim T (inverse T L.M.Lim lp.equiv) B)
        (T1.Trunc[Pres[L.M.Lim -> B]].inc pres) ;
  } ;
  stone-fin-odisc (T : U l) (sT : PF.isStone T) (B : U l) (fB : Fi.isFinite B) : isODisc (T -> B) =
    TC1.rec (PF.LimPres[T]) @(l+) (isODisc (T -> B)) T1.Trunc[Pres[T -> B]].proposition (\ lp -> StoneFin[T, B, fB, lp].result)
      (Profinite[l,l].Over[ax].lemma31 T sT) ;

  -- (t : T) -> Fin (c t) for T Stone
  module FinPi (T : U l) (sT : PF.isStone T) (c : T -> Nat) (lp : PF.LimPres[T]) {
    module C = Cor37[l,l].Over[ax].Cor37[lp.E, lp.p, lp.finite] ;
    f (z : C.M.Lim) : Nat = c (lp.equiv.2.sec z) ;
    Goal : U l+ = isODisc ((t : T) -> Fin (c t)) ;
    module Stage (K : Nat) (c' : lp.E K -> Nat) (eq : (z : C.M.Lim) -> Id Nat (c' (z.1 K)) (f z)) {
      pi (t : T) : lp.E K = (lp.equiv.1 t).1 K ;
      path (t : T) : Id Nat (c t) (c' (pi t)) =
        transH (symH (apH c (sec-ret T C.M.Lim lp.equiv.1 lp.equiv.2 t))) (symH (eq (lp.equiv.1 t))) ;
      eK : PF.isStone (lp.E K) = P214.finite-stone (lp.E K) (lp.finite K) ;
      along : isODisc ((t : T) -> Fin (c' (pi t))) =
        L27.odisc-equiv ((t : T) -> Fin (c' (pi t))) ((y : lp.E K) -> Fibre pi y -> Fin (c' y)) PC.PiFibres[T, lp.E K, pi, \ y -> Fin (c' y)].equiv
          (Pd.pi-odisc (lp.E K) (lp.finite K) (\ y -> Fibre pi y -> Fin (c' y)) (\ y ->
            stone-fin-odisc (Fibre pi y) (P214.fibre-stone T (lp.E K) sT eK pi y) (Fin (c' y)) (FCl.fin-finite (c' y)))) ;
      result : Goal =
        L27.odisc-equiv ((t : T) -> Fin (c t)) ((t : T) -> Fin (c' (pi t)))
          (PC.pi-fibre T (\ t -> Fin (c t)) (\ t -> Fin (c' (pi t))) (\ t -> fin-path (c t) (c' (pi t)) (path t))) along ;
    } ;
    result : Goal =
      TC.rec ((u : C.M.CN.colim) * Id (C.M.Lim -> Nat) (C.M.phi u) f) @(l+) Goal T1.Trunc[Pres[(t : T) -> Fin (c t)]].proposition
        (\ w -> C.M.CN.induction @(l+) (\ u -> Id (C.M.Lim -> Nat) (C.M.phi u) f -> Goal)
          (\ u -> Axioms[l+].FunExtLemmas[fe @(l+)].isProp-Pi (Id (C.M.Lim -> Nat) (C.M.phi u) f) (\ h -> Goal) (\ h -> T1.Trunc[Pres[(t : T) -> Fin (c t)]].proposition))
          (\ K c' h -> Stage[K, c', \ z -> transH (symH (happly C.M.Lim (\ z1 -> Nat) (C.M.phi (C.M.CN.inc K c')) (C.M.restrict K c')
              (C.M.R.beta K c') z)) (happly C.M.Lim (\ z1 -> Nat) (C.M.phi (C.M.CN.inc K c')) f h z)].result)
          w.1 w.2)
        (C.surjective f) ;
  } ;
  fin-pi-odisc (T : U l) (sT : PF.isStone T) (c : T -> Nat) : isODisc ((t : T) -> Fin (c t)) =
    TC1.rec (PF.LimPres[T]) @(l+) (isODisc ((t : T) -> Fin (c t))) T1.Trunc[Pres[(t : T) -> Fin (c t)]].proposition
      (\ lp -> FinPi[T, sT, c, lp].result) (Profinite[l,l].Over[ax].lemma31 T sT) ;

  -- Lemma 2.3.8
  -- descent along a surjection q : T ->> S (S any type), when compatibility is open
  module Pairs238 (S T : U l) (q : T -> S) (I : S -> U l) {
    Pairs : U l = (x : S) * (Fibre q x * Fibre q x) ;
    Lifts : U l = (t : T) -> I (q t) ;
    move (g : Lifts) (x : S) (u : Fibre q x) : I x = substH I u.2 (g u.1) ;
    Agree (g : Lifts) (w : Pairs) : U l = Id (I w.1) (move g w.1 w.2.1) (move g w.1 w.2.2) ;
    Compat (g : Lifts) : U l = (w : Pairs) -> Agree g w ;
  } ;
  module Descent238 (S T : U l) (q : T -> S) (onto : DependentChoice[l].Surjective q)
    (I : S -> U l) (sI : (x : S) -> isSet (I x)) (oI : (x : S) -> isODisc (I x))
    (copen : (g : Pairs238[S, T, q, I].Lifts) -> OC.isOpen (Pairs238[S, T, q, I].Compat g)) {
    module PP = Pairs238[S, T, q, I] ;
    compat-prop (g : PP.Lifts) : isProp (PP.Compat g) =
      F.isProp-Pi PP.Pairs (PP.Agree g) (\ w -> sI w.1 (PP.move g w.1 w.2.1) (PP.move g w.1 w.2.2)) ;
    compat-odisc (g : PP.Lifts) : isODisc (PP.Compat g) = L28.open-odisc (PP.Compat g) (compat-prop g) (copen g) ;
    -- sections are the compatible lifts
    lift (h : (x : S) -> I x) : (g : PP.Lifts) * PP.Compat g =
      (\ t -> h (q t), \ w -> transH (transport-section S I h (q w.2.1.1) w.1 w.2.1.2)
        (symH (transport-section S I h (q w.2.2.1) w.1 w.2.2.2))) ;
    module Descend (g : PP.Lifts) (cp : PP.Compat g) (x : S) {
      module K = ConstantMap[l].Constant[Fibre q x, I x, sI x, PP.move g x, \ u u' -> cp (x, u, u')] ;
      value : I x = K.value (onto x) ;
    } ;
    descend (v : (g : PP.Lifts) * PP.Compat g) (x : S) : I x = Descend[v.1, v.2, x].value ;
    descend-lift (h : (x : S) -> I x) : Id ((x : S) -> I x) (descend (lift h)) h =
      F.funext S I (descend (lift h)) h (\ x ->
        TC.rec (Fibre q x) @l (Id (I x) (descend (lift h) x) (h x)) (sI x (descend (lift h) x) (h x))
          (\ u -> transH (Descend[(lift h).1, (lift h).2, x].K.value-at (onto x) u) (transport-section S I h (q u.1) x u.2))
          (onto x)) ;
    lift-descend (v : (g : PP.Lifts) * PP.Compat g) : Id ((g : PP.Lifts) * PP.Compat g) (lift (descend v)) v =
      Sigma-eq PP.Lifts PP.Compat (lift (descend v)).1 v.1 (lift (descend v)).2 v.2
        (F.funext T (\ t -> I (q t)) (lift (descend v)).1 v.1 (\ t ->
          Descend[v.1, v.2, q t].K.value-at (onto (q t)) (t, refl (q t))))
        (compat-prop v.1) ;
    equiv : Equiv ((x : S) -> I x) ((g : PP.Lifts) * PP.Compat g) =
      (lift, qinv ((x : S) -> I x) ((g : PP.Lifts) * PP.Compat g) lift descend lift-descend descend-lift) ;
    result (oT : isODisc PP.Lifts) : isODisc ((x : S) -> I x) =
      L27.odisc-equiv ((x : S) -> I x) ((g : PP.Lifts) * PP.Compat g) equiv
        (L27.sigma-odisc cc (ax.dc @(l+)) PP.Lifts oT PP.Compat compat-odisc) ;
  } ;
  -- Lemma 2.3.8: S Stone
  module Lemma238 (S : U l) (sS : PF.isStone S) (T : U l) (sT : PF.isStone T) (q : T -> S) (onto : DependentChoice[l].Surjective q)
    (I : S -> U l) (sI : (x : S) -> isSet (I x)) (oI : (x : S) -> isODisc (I x)) {
    module PP = Pairs238[S, T, q, I] ;
    pairs-stone : PF.isStone PP.Pairs =
      Thm418[l].Over[ax].thm418 S sS (\ x -> Fibre q x * Fibre q x) (\ x ->
        P214.product-stone (Fibre q x) (Fibre q x) (P214.fibre-stone T S sT sS q x) (P214.fibre-stone T S sT sS q x)) ;
    copen (g : PP.Lifts) : OC.isOpen (PP.Compat g) =
      P214.lemma215 PP.Pairs pairs-stone (PP.Agree g) (\ w -> sI w.1 (PP.move g w.1 w.2.1) (PP.move g w.1 w.2.2)) (\ w ->
        L28.odisc-open (PP.Agree g w) (sI w.1 (PP.move g w.1 w.2.1) (PP.move g w.1 w.2.2))
          (L27.id-odisc (I w.1) (oI w.1) (PP.move g w.1 w.2.1) (PP.move g w.1 w.2.2))) ;
    module D = Descent238[S, T, q, onto, I, sI, oI, copen] ;
    result (oT : isODisc PP.Lifts) : isODisc ((x : S) -> I x) = D.result oT ;
  } ;

  -- Prop. 2.3.9
  module Prop239 (S : U l) (sS : PF.isStone S) (I : S -> U l) (sI : (x : S) -> isSet (I x)) (oI : (x : S) -> isODisc (I x)) {
    module Chosen (cv : Prop214[l].Cover[S, \ x -> FinPres (I x)]) {
      c (t : cv.T) : Nat -> Nat = (cv.section t).1 ;
      Tw : P235.Tower[cv.T] = P235.mkTower cv.T (\ t -> finSeq (c t) (cv.section t).2.1) (\ i t -> FCl.fin-set (c t i)) ;
      module C = P235.Colims[cv.T, Tw] ;
      stages (n : Nat) : isODisc (C.pis.A n) = fin-pi-odisc cv.T cv.stone (\ t -> c t n) ;
      colim-odisc : isODisc C.CP.colim = Lemma26[l].Lemma26[cc, ax.dc @(l+), C.pis, stages].theorem ;
      target-odisc : isODisc C.Target =
        L27.odisc-equiv C.Target C.CP.colim
          (inverse C.CP.colim C.Target (C.canonical, P235.Over[ax].prop235 cv.T cv.stone Tw)) colim-odisc ;
      lifts-odisc : isODisc ((t : cv.T) -> I (cv.q t)) =
        L27.odisc-equiv ((t : cv.T) -> I (cv.q t)) C.Target
          (PC.pi-fibre cv.T (\ t -> I (cv.q t)) (\ t -> Colim[Tw.at t].colim) (\ t -> (cv.section t).2.2)) target-odisc ;
      result : isODisc ((x : S) -> I x) =
        Lemma238[S, sS, cv.T, cv.stone, cv.q, cv.onto, I, sI, oI].result lifts-odisc ;
    } ;
    result : isODisc ((x : S) -> I x) =
      TC1.rec (Prop214[l].Cover[S, \ x -> FinPres (I x)]) @(l+) (isODisc ((x : S) -> I x)) T1.Trunc[Pres[(x : S) -> I x]].proposition
        (\ cv -> Chosen[cv].result) (P214.local S sS (\ x -> FinPres (I x)) (\ x -> fin-pres cc (I x) (oI x))) ;
  } ;
  prop239 (S : U l) (sS : PF.isStone S) (I : S -> U l) (oI : (x : S) -> isODisc (I x)) : isODisc ((x : S) -> I x) =
    Prop239[S, sS, I, \ x -> L27.odisc-set (I x) (oI x), oI].result ;
} ;
