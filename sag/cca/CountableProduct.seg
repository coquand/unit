-- Countable products and sequential limits of Stone spaces (CCA
-- Prop. 2.1.4 (iii)), without colimits of Boolean algebras.
--
--  - Cantor's unpair : N -> N x N (Pairing) is an equivalence: it is onto
--    (Pairing.hit), and pair (a, b) = b + T (a + b), T s = 0 + 1 + .. + s,
--    has pair (step u) = pair u + 1, hence pair (unpair m) = m.  So
--    N -> N -> 2 = (N x N -> 2) = 2^N is Stone.
--  - Pi_k S_k for S_k Stone: choose presentations S_k = Sp (2[N]/(r_k))
--    (countable choice); then Pi_k S_k = Pi_k { a | r_k (a) = 0 }
--    = { beta : N -> N -> 2 | r_k n (beta k) = 0 for all k, n }, a closed
--    subset of a Stone space (one closed condition: alpha m = r_k n (beta k)
--    for (k, n) = unpair m), hence Stone (Cor. 3.12).
--  - lim S = { x : Pi_k S_k | p_n (x (n+1)) = x n for all n }: a countable
--    conjunction of closed equalities (SSD Lemma 3.10, Lemma 1.21), so a
--    closed subset of a Stone space.
--  - For closed P n, not (forall n. P n) gives merely an n with not (P n):
--    forall n. P n is "alpha = 0" for the join alpha of their witnesses, and
--    Markov's principle gives a 1 of alpha, in the witness of some P n.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open Logic[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module T1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module PF = Profinite[l,l] ;
module SA = StoneAxioms[l,l] ;
module P = Presented[l] ;
module FN = FreeCountable[l] ;
module Pg = Pairing[l] ;
module OC = OpenClosed[l,l] ;
module Om = Omniscience[l,l] ;
module BS = BoolSeq[l] ;
module BR = BooleanRing[l] ;
module DCh = DependentChoice[l] ;
module Eq = Equivalences[l] ;
module PC = PiClosure[l] ;

-- Cantor's pairing is an equivalence
tri : Nat -> Nat = split { zero -> zero ; suc s | r -> suc (plus s r) } ;
pair (u : Pg.Pair) : Nat = plus u.2 (tri (plus u.1 u.2)) ;
pair-step : (a b : Nat) -> Id Nat (pair (Pg.step-at a b)) (suc (pair (a, b))) = split {
  zero -> \ b -> apH (\ s -> suc (plus s (tri s))) (plus-zero b) ;
  suc a -> \ b -> apH (\ s -> suc (plus b (tri s))) (plus-suc a b) } ;
pair-unpair : (m : Nat) -> Id Nat (pair (Pg.unpair m)) m = split {
  zero -> refl zero ;
  suc m | r -> transH (pair-step (Pg.unpair m).1 (Pg.unpair m).2) (apH (\ k -> suc k) r) } ;
pair-set : isSet Pg.Pair = isSet-Sigma Nat (\ a -> Nat) nat-set (\ a -> nat-set) ;
unpair-inj : Injective Pg.unpair = \ m m' e -> transH (symH (pair-unpair m)) (transH (apH pair e) (pair-unpair m')) ;
pairing : Equiv Nat Pg.Pair = (Pg.unpair, Bij[Nat, Pg.Pair, pair-set, Pg.unpair, unpair-inj,
  \ u -> Tr.Trunc[Fibre Pg.unpair u].inc (Pg.hit u.1 u.2)].equiv) ;
curry : Equiv (Pg.Pair -> Bool) (Nat -> Nat -> Bool) =
  (\ a k n -> a (k, n), qinv (Pg.Pair -> Bool) (Nat -> Nat -> Bool) (\ a k n -> a (k, n)) (\ b u -> b u.1 u.2)
    (\ b -> refl b) (\ a -> refl a)) ;

-- Pi and Sigma
pi-sigma (A : Nat -> U l) (B : (k : Nat) -> A k -> U l)
  : Equiv ((k : Nat) -> (a : A k) * B k a) ((x : (k : Nat) -> A k) * ((k : Nat) -> B k (x k))) =
  (\ h -> (\ k -> (h k).1, \ k -> (h k).2), qinv ((k : Nat) -> (a : A k) * B k a) ((x : (k : Nat) -> A k) * ((k : Nat) -> B k (x k)))
    (\ h -> (\ k -> (h k).1, \ k -> (h k).2)) (\ w k -> (w.1 k, w.2 k)) (\ w -> refl w) (\ h -> refl h)) ;

-- for closed P n: not (forall n. P n) -> merely some n with not (P n)
module NotAll (ax : SA.Assumptions) (P : Nat -> U l) (c : (n : Nat) -> OC.isClosed (P n)) (h : Not ((n : Nat) -> P n)) {
  module W (w : (n : Nat) -> OC.ClosedW (P n)) {
    alpha : Nat -> Bool = BS.sq (\ n -> (w n).1) ;
    holds (z : Om.AllZero alpha) (n : Nat) : P n = (w n).2.2 (\ m ->
      OC.Countable[CountableChoice[l].cc (ax.dc @l)].closed-all-step (\ n1 -> (w n1).1) n m z (TwoPresented[l].bool-cases ((w n).1 m))) ;
    hit : (k : Nat) * Id Bool (alpha k) true = Om.Over[ax].markov alpha (\ z -> h (holds z)) ;
    index : Nat = (BS.sq-true-inv (\ n1 -> (w n1).1) hit.1 hit.2).1 ;
    refutes (p : P index) : Empty = BR.true-false (transH (symH (BS.sq-true-inv (\ n1 -> (w n1).1) hit.1 hit.2).2.2) ((w index).2.1 p (BS.sq-true-inv (\ n1 -> (w n1).1) hit.1 hit.2).2.1)) ;
  } ;
  result : Tr.Trunc[(n : Nat) * Not (P n)].carrier =
    TC.map ((n : Nat) -> OC.ClosedW (P n)) ((n : Nat) * Not (P n)) (\ w -> (W[w].index, W[w].refutes))
      (CountableChoice[l].cc (ax.dc @l) (\ n -> OC.ClosedW (P n)) c) ;
} ;

module Over (ax : SA.Assumptions) {
  module P214 = Prop214[l].Over[ax] ;
  closed-stone (Q : U l) (pQ : isProp Q) (c : OC.isClosed Q) : PF.isStone Q = StoneClosed[l,l].Over[ax].closed-stone Q pQ c ;
  -- Stone subsets cut out by closed conditions
  sub-stone (X : U l) (sX : PF.isStone X) (A : X -> U l) (pA : (x : X) -> isProp (A x)) (cA : (x : X) -> OC.isClosed (A x))
    : PF.isStone ((x : X) * A x) =
    Thm418[l].Over[ax].thm418 X sX A (\ x -> closed-stone (A x) (pA x) (cA x)) ;
  cantor2-stone : PF.isStone (Nat -> Nat -> Bool) =
    Prop214[l].stone-equiv (Nat -> Nat -> Bool) (Nat -> Bool)
      (Eq.compose (Nat -> Nat -> Bool) (Pg.Pair -> Bool) (Nat -> Bool) (inverse (Pg.Pair -> Bool) (Nat -> Nat -> Bool) curry)
        (PC.pi-domain Nat Pg.Pair pairing Bool))
      Sigma411[l].cantor-stone ;

  -- countable products
  Pres (X : U l) : U l = (r : Nat -> FN.Elem) * Equiv X (P.Sp (P.Presented r)) ;
  pres (X : U l) (sX : PF.isStone X) : Tr.Trunc[Pres X].carrier =
    StoneClosed[l,l].on-stone1 X Tr.Trunc[Pres X].carrier Tr.Trunc[Pres X].proposition sX (\ r e -> Tr.Trunc[Pres X].inc (r, e)) ;
  module Prod (S : Nat -> U l) (q : (k : Nat) -> Pres (S k)) {
    Zeros (k : Nat) (a : Nat -> Bool) : U l = P.Zeros (q k).1 a ;
    Cond (b : Nat -> Nat -> Bool) : U l = (k : Nat) -> Zeros k (b k) ;
    cond-prop (b : Nat -> Nat -> Bool) : isProp (Cond b) =
      F.isProp-Pi Nat (\ k -> Zeros k (b k)) (\ k -> F.isProp-Pi Nat (\ n -> Id Bool (((q k).1 n).1 (b k)) false) (\ n -> BR.bool-set _ _)) ;
    alpha (b : Nat -> Nat -> Bool) (m : Nat) : Bool = (((q (Pg.unpair m).1).1 (Pg.unpair m).2).1 (b (Pg.unpair m).1)) ;
    cond-closed (b : Nat -> Nat -> Bool) : OC.isClosed (Cond b) = Tr.Trunc[OC.ClosedW (Cond b)].inc (alpha b,
      (\ c m -> c (Pg.unpair m).1 (Pg.unpair m).2,
       \ z k n -> transH (apH (\ u -> ((q u.1).1 u.2).1 (b u.1)) (symH (Pg.hit k n).2)) (z (Pg.hit k n).1))) ;
    equiv : Equiv ((k : Nat) -> S k) ((b : Nat -> Nat -> Bool) * Cond b) =
      Eq.compose ((k : Nat) -> S k) ((k : Nat) -> (a : Nat -> Bool) * Zeros k a) ((b : Nat -> Nat -> Bool) * Cond b)
        (PC.pi-fibre Nat S (\ k -> (a : Nat -> Bool) * Zeros k a) (\ k ->
          Eq.compose (S k) (P.Sp (P.Presented (q k).1)) ((a : Nat -> Bool) * Zeros k a) (q k).2 (P.sp-presented (q k).1)))
        (pi-sigma (\ k -> Nat -> Bool) Zeros) ;
    stone : PF.isStone ((k : Nat) -> S k) =
      Prop214[l].stone-equiv ((k : Nat) -> S k) ((b : Nat -> Nat -> Bool) * Cond b) equiv
        (sub-stone (Nat -> Nat -> Bool) cantor2-stone Cond cond-prop cond-closed) ;
  } ;
  pi-stone (S : Nat -> U l) (sS : (k : Nat) -> PF.isStone (S k)) : PF.isStone ((k : Nat) -> S k) =
    TC.rec ((k : Nat) -> Pres (S k)) @(l+) (PF.isStone ((k : Nat) -> S k)) T1.Trunc[PF.StoneW ((k : Nat) -> S k)].proposition
      (\ q -> Prod[S, q].stone) (CountableChoice[l].cc (ax.dc @l) (\ k -> Pres (S k)) (\ k -> pres (S k) (sS k))) ;

  -- Prop. 2.1.4 (iii): sequential limits
  module Limit (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n)) {
    Compat (x : (n : Nat) -> S n) (n : Nat) : U l = Id (S n) (p n (x (suc n))) (x n) ;
    compat-prop (x : (n : Nat) -> S n) (n : Nat) : isProp (Compat x n) = P214.stone-set (S n) (sS n) (p n (x (suc n))) (x n) ;
    stone : PF.isStone (DCh.Lim S p) =
      sub-stone ((n : Nat) -> S n) (pi-stone S sS) (\ x -> (n : Nat) -> Compat x n)
        (\ x -> F.isProp-Pi Nat (Compat x) (compat-prop x))
        (\ x -> OC.Countable[CountableChoice[l].cc (ax.dc @l)].closed-all (Compat x) (\ n ->
          StoneClosed[l,l].lemma310 (S n) (sS n) (p n (x (suc n))) (x n))) ;
  } ;
  lim-stone (S : Nat -> U l) (p : (n : Nat) -> S (suc n) -> S n) (sS : (n : Nat) -> PF.isStone (S n)) : PF.isStone (DCh.Lim S p) =
    Limit[S, p, sS].stone ;
} ;
