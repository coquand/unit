-- A map out of a sequential colimit into a set is injective when it is on
-- points of one stage: two points inc n a, inc n' a' are raised to the
-- common stage N = n' + n, where they have the same images.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open NatArith[l] ; open Bijection[l] ; open SeqColim[l] ;

module StageInjective (S : Seq) (B : U l) (phi : Colim[S].colim -> B)
  (same : (N : Nat) (a b : S.A N) -> Id B (phi (Colim[S].inc N a)) (phi (Colim[S].inc N b)) -> Id (Colim[S].colim) (Colim[S].inc N a) (Colim[S].inc N b)) {
  module C = Colim[S] ;
  module Pair (n : Nat) (a : S.A n) (n' : Nat) (a' : S.A n') (q : Id B (phi (C.inc n a)) (phi (C.inc n' a'))) {
    N : Nat = plus n' n ;
    A : S.A N = C.raise n N (le-sum-r n n') a ;
    A' : S.A N = C.raise n' N (le-sum-l n n') a' ;
    q' : Id B (phi (C.inc N A)) (phi (C.inc N A')) = calc B {
      phi (C.inc N A) =< apH phi (C.inc-raise n N (le-sum-r n n') a) > phi (C.inc n a)
        =< q > phi (C.inc n' a')
        =< symH (apH phi (C.inc-raise n' N (le-sum-l n n') a')) > phi (C.inc N A') } ;
    result : Id C.colim (C.inc n a) (C.inc n' a') = calc C.colim {
      C.inc n a =< symH (C.inc-raise n N (le-sum-r n n') a) > C.inc N A
        =< same N A A' q' > C.inc N A'
        =< C.inc-raise n' N (le-sum-l n n') a' > C.inc n' a' } ;
  } ;
  injective : Injective phi = C.injective-on-inc B phi (\ n a n' a' q -> Pair[n, a, n', a', q].result) ;
} ;
