-- D_k(u) = 0 and "D_k(u) regular" in two forms: by the minors (coefficients
-- of products of k columns, Minors) and by the image (products of k vectors
-- of im u, MinorKill).  The image form is invariant under column operations
-- and is what the proofs use; the minor form is the statement and passes to
-- R[1/c] coefficientwise (minors of the image of u are the images of the
-- minors: BaseChange, LocalExact.coeff-B; regularity by LocalExact.regular).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module MK = MinorKill[l].Over[Rg,setR] ;
 module RI = RegularIdeal[l].Over[Rg,RegularIdeal[l].self Rg] ;
 ImageVanish (k p q : Nat) (u : MM.Mat p q) : U l = MK.ImageKilled k p q u o ;
 ImageRegular (k p q : Nat) (u : MM.Mat p q) : U l = (x : R) -> MK.ImageKilled k p q u x -> Id R x z ;
 columns-of-image (k p q : Nat) (u : MM.Mat p q) (x : R) (h : MK.ImageKilled k p q u x) : MK.ColumnsKilled k p q u x =
  \ c -> subst (\ v -> MK.KillsW q x (MM.wedge k q v))
   (F.funext (Fin k) (\ t -> MM.Vec q) (MK.compose k p q u (\ t -> MnSums[l].Over[Rg].delta p (c t))) (MK.cols k p q u c)
    (\ t -> MI.Map[p,q,u].apply-delta (c t)))
   (h (\ t -> MnSums[l].Over[Rg].delta p (c t))) ;
 zero-on (k p q : Nat) (u : MM.Mat p q) (x : R) (h : MK.ColumnsKilled k p q u x) : RI.ZeroOn (MI.Index k p q) (MI.minors k p q u) x =
  \ ci -> MK.to-coeff q x (MM.wedge k q (MK.cols k p q u ci.1)) (h ci.1) ci.2 ;
 vanish-to-image (k p q : Nat) (u : MM.Mat p q) (h : MI.Vanish k p q u) : ImageVanish k p q u =
  MK.image k p q u o (MK.columns k p q u o (\ ci -> trans (mulO (MI.minors k p q u ci)) (h ci))) ;
 image-to-vanish (k p q : Nat) (u : MM.Mat p q) (h : ImageVanish k p q u) : MI.Vanish k p q u =
  \ ci -> trans (sym (mulO (MI.minors k p q u ci))) (zero-on k p q u o (columns-of-image k p q u o h) ci) ;
 regular-to-image (k p q : Nat) (u : MM.Mat p q) (h : MI.RegularD k p q u) : ImageRegular k p q u =
  \ x hk -> h x tt (zero-on k p q u x (columns-of-image k p q u x hk)) ;
 image-to-regular (k p q : Nat) (u : MM.Mat p q) (h : ImageRegular k p q u) : MI.RegularD k p q u =
  \ x t hk -> h x (MK.image k p q u x (MK.columns k p q u x hk)) ;

 -- in R[1/c]
 module Local (c : R) {
  module LE = LocalExact[l].Over[Rg,setR,c] ;
  MIL (k p q : Nat) (u : Matrices[l].Over[LE.I.ring].Mat p q) (ci : MI.Index k p q) : LE.I.ring.R =
   Minors[l].Over[LE.I.ring,LE.setL].minors k p q u ci ;
  minors-k (k p q : Nat) (u : MM.Mat p q) (ci : MI.Index k p q) :
   Id LE.I.ring.R (MIL k p q (LE.extend p q u) ci) (LE.k (MI.minors k p q u ci)) =
   trans (ap (\ y -> LE.ECL.coeff q y ci.2) (sym (LE.BC.B-wedge q k (MK.cols k p q u ci.1))))
    (LE.coeff-B q (MM.wedge k q (MK.cols k p q u ci.1)) ci.2) ;
  vanish (k p q : Nat) (u : MM.Mat p q) (h : MI.Vanish k p q u) :
   Minors[l].Over[LE.I.ring,LE.setL].Vanish k p q (LE.extend p q u) =
   \ ci -> trans (minors-k k p q u ci) (trans (ap LE.k (h ci)) LE.FL.k-zero) ;
  regular (k p q : Nat) (u : MM.Mat p q) (h : MI.RegularD k p q u) :
   Minors[l].Over[LE.I.ring,LE.setL].RegularD k p q (LE.extend p q u) =
   \ x t hk -> LE.regular (MI.Index k p q) (CommonPower[l].common-minors k p q) (MI.minors k p q u) h x tt
    (\ ci -> trans (ap (\ y -> LE.I.ring.mul y x) (sym (minors-k k p q u ci))) (hk ci)) ;
 } ;
} ;
