-- cffr Corollary 7.5 (exactness criterion, Buchsbaum–Eisenbud one way), top
-- map first: a complex u, T 0, ..., T (k-1) (composites 0) with ranks r
-- (s 0 = r 0 + p, s (i+1) = r (i+1) + r i), Gr(D_p(u)) >= k + 1 and
-- Gr(D_(r i)(T i)) >= k - i (true grade) is a resolution: u is injective
-- and the complex is exact.
-- Given (parameters, from worker B): Theorem 7.1 in the elementwise form
-- (a list a of grade >= k' + 2 is regular on the last cokernel of a
-- resolution with k' + 1 maps), and the transport of the true grade to
-- R[1/x].
-- Induction on k, and on p for each k (as Theorem 6.8):
-- k = 0: Gr(D_p(u)) >= 1, so u is injective (Theorem 2.5).
-- p = 0: u = 0; the complex starting at T 0 satisfies the hypotheses with
--   k - 1 maps after its top (r 0 = s 0), so it is a resolution (induction
--   on k); hence T 0 is injective and the whole complex is exact.
-- p = p0 + 1: without its last map the complex is a resolution (induction
--   on k).  The last spot: the entries x of u have Gr(x) >= k + 1 (they
--   contain D_p(u)), so by Theorem 7.1 they are regular on the last
--   cokernel; in each R[1/x_j] the reduced complex (Reduce) satisfies the
--   hypotheses (Reduce.Back, grades carried to R[1/x_j]) with top size p0,
--   so it is a resolution (induction on p), and so is the original
--   complex there (Reduce.Down); exactness at the last spot then follows
--   from LocalExactness.glue.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module TG = TrueGrade[l] ; module GT = GradeTools[l] ; module RS = Resolution[l] ;
module T68 = Thm68[l] ; module TL = TrueGradeLocal[l] ;
-- the complex with u in front (as in Thm68.Top)
s1 (p : Nat) (s : Nat -> Nat) : Nat -> Nat = split { zero -> p ; suc i -> s i } ;
T1 (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) :
 (i : Nat) -> RS.Mat D (s1 p s i) (s1 p s (suc i)) = split { zero -> u ; suc i -> T i } ;
-- membership in the image of the j-th map
InIm (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i)))
 (j : Nat) (y : Matrices[l].Over[D.1].Vec (s1 p s (suc j))) : U l =
 Tr.Trunc[(x : Matrices[l].Over[D.1].Vec (s1 p s j)) *
  ((i : Fin (s1 p s (suc j))) -> Id D.1.R (Matrices[l].Over[D.1].apply (s1 p s j) (s1 p s (suc j)) (T1 D p s u T j) x i) (y i))].carrier ;
-- Theorem 7.1, elementwise, for the last cokernel of a resolution with k + 1 maps
Thm71 : U l+ =
 (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) ->
 T68.Res D k p s u T -> (n : Nat) (a : Fin n -> D.1.R) -> TG.TGr (suc (suc k)) D zero (GT.J0 D) n a ->
 (y : Matrices[l].Over[D.1].Vec (s1 p s (suc k))) ->
 ((i : Fin n) -> InIm D p s u T k (\ j -> D.1.mul (a i) (y j))) -> InIm D p s u T k y ;
-- the true grade in R[1/c]
TgrLoc : U l+ =
 (k : Nat) (D : TG.RD) (n : Nat) (I : Fin n -> D.1.R) (c : D.1.R) -> TG.TGr k D zero (GT.J0 D) n I ->
 TG.TGr k (TL.Loc D c) zero (GT.J0 (TL.Loc D c)) n (\ i -> (TL.loc D c).1 (I i)) ;

module Over (thm71 : Thm71) (tgr-loc : TgrLoc) {
 -- the hypotheses
 CZ (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) : U l =
  ((d : Nat) -> Id Nat k (suc d) -> Matrices[l].Over[D.1].ComposeZero p (s zero) (s (suc zero)) u (T zero)) *
  ((i d : Nat) -> Id Nat k (plus (suc (suc i)) d) ->
   Matrices[l].Over[D.1].ComposeZero (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i))) ;
 TopG (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) : U l =
  TG.TGr (suc k) D zero (GT.J0 D) (T68.NL p p (s zero)) (T68.minors D p p (s zero) u) ;
 Hyp (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat) : U l =
  CZ D k p s u T * RS.Ranks k p s r * TopG D k p s u * T68.Grades D k s r T ;
 ClaimK (k : Nat) : U l+ =
  (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat) ->
  Hyp D k p s u T r -> T68.Res D k p s u T ;
 ClaimP (k p : Nat) : U l+ =
  (D : TG.RD) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat) ->
  Hyp D k p s u T r -> T68.Res D k p s u T ;

 -- k = 0: D_p(u) regular, u injective (Theorem 2.5)
 module Start (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i)))
  (g : TopG D zero p s u) {
  module AB = GT.Absolute[D] ;
  module MI = Minors[l].Over[D.1,D.2] ;
  module E = Enumerate[l] ;
  rid : TG.RegId D zero (GT.J0 D) (T68.NL p p (s zero)) (T68.minors D p p (s zero) u) =
   TrueGradeThm9[l].gr1-to D zero (GT.J0 D) (T68.NL p p (s zero)) (T68.minors D p p (s zero) u) g ;
  reg : MI.RegularD p p (s zero) u = \ x t h ->
   AB.from0 x (rid x tt (\ m -> AB.in0 (D.1.mul (T68.minors D p p (s zero) u m) x) (h (E.list _ (E.minors-index p p (s zero)) m)))) ;
  result : T68.Res D zero p s u T =
   (MI.theorem25 p (s zero) u reg,(\ d e -> efq (zero-suc d e),\ i d e -> efq (zero-suc (plus (suc i) d) e))) ;
 } ;
 -- p = 0: shift (u = 0)
 module PZero (k : Nat) (ih : ClaimK k) (D : TG.RD) (s : Nat -> Nat) (u : RS.Mat D zero (s zero))
  (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat) (h : Hyp D (suc k) zero s u T r) {
  module MM = Matrices[l].Over[D.1] ;
  r0 : Id Nat (r zero) (s zero) = sym (trans (h.2.1.1 k (refl (suc k))) (plus-zero (r zero))) ;
  hyp' : Hyp D k (s zero) (\ i -> s (suc i)) (T zero) (\ i -> T (suc i)) (\ i -> r (suc i)) =
   ((\ d e -> h.1.2 zero d (ap (\ j -> suc j) e),\ i d e -> h.1.2 (suc i) d (ap (\ j -> suc j) e)),
    (\ d e -> trans (h.2.1.2 zero d (ap (\ j -> suc j) e)) (ap (plus (r (suc zero))) r0),
     \ i d e -> h.2.1.2 (suc i) d (ap (\ j -> suc j) e)),
    subst {Nat} (\ rr -> TG.TGr (suc k) D zero (GT.J0 D) (T68.NL rr (s zero) (s (suc zero))) (T68.minors D rr (s zero) (s (suc zero)) (T zero)))
     {r zero} {s zero} r0 (h.2.2.2 zero k (refl (suc k))),
    \ i d e -> h.2.2.2 (suc i) d (ap (\ j -> suc j) e)) ;
  res' : T68.Res D k (s zero) (\ i -> s (suc i)) (T zero) (\ i -> T (suc i)) =
   ih D (s zero) (\ i -> s (suc i)) (T zero) (\ i -> T (suc i)) (\ i -> r (suc i)) hyp' ;
  top-exact (d : Nat) (e : Id Nat (suc k) (suc d)) : MM.Exact zero (s zero) (s (suc zero)) u (T zero) = \ y hy ->
   Tr.Trunc[(x : MM.Vec zero) * ((i : Fin (s zero)) -> Id D.1.R (MM.apply zero (s zero) u x i) (y i))].inc
    ((\ i -> efq i),\ i -> sym (res'.1 y hy i)) ;
  pairs : (i d : Nat) -> Id Nat (suc k) (plus (suc (suc i)) d) ->
   MM.ComposeZero (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) * MM.Exact (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) = split {
   zero -> \ d e -> res'.2.1 d (suc-inj {k} {suc d} e) ;
   suc i -> \ d e -> res'.2.2 i d (suc-inj {k} {plus (suc (suc i)) d} e) } ;
  result : T68.Res D (suc k) zero s u T =
   ((\ x hx i -> efq i),(\ d e -> (h.1.1 d e,top-exact d e),pairs)) ;
 } ;
 -- exactness at every spot of a resolution, in the layout with u in front
 spot-res (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i)))
  (res : T68.Res D k p s u T) : (i d : Nat) -> Id Nat k (plus (suc i) d) ->
  Matrices[l].Over[D.1].Exact (s1 p s i) (s1 p s (suc i)) (s1 p s (suc (suc i))) (T1 D p s u T i) (T1 D p s u T (suc i)) = split {
  zero -> \ d e -> (res.2.1 d e).2 ;
  suc i -> \ d e -> (res.2.2 i d e).2 } ;
 -- p = p0 + 1
 module PSucc (k p0 : Nat) (ihk : ClaimK k) (ihp : ClaimP (suc k) p0) (D : TG.RD) (s : Nat -> Nat)
  (u : RS.Mat D (suc p0) (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat)
  (h : Hyp D (suc k) (suc p0) s u T r) {
  module MM = Matrices[l].Over[D.1] ;
  -- without the last map
  eqT (i d : Nat) (e : Id Nat k (plus (suc (suc i)) d)) : Id Nat (suc k) (plus (suc (suc i)) (suc d)) =
   trans (ap (\ j -> suc j) e) (sym (plus-suc (suc (suc i)) d)) ;
  eqG (i d : Nat) (e : Id Nat k (plus (suc i) d)) : Id Nat (suc k) (plus (suc i) (suc d)) =
   trans (ap (\ j -> suc j) e) (sym (plus-suc (suc i) d)) ;
  hypT : Hyp D k (suc p0) s u T r =
   ((\ d e -> h.1.1 (suc d) (ap (\ j -> suc j) e),\ i d e -> h.1.2 i (suc d) (eqT i d e)),
    (\ d e -> h.2.1.1 (suc d) (ap (\ j -> suc j) e),\ i d e -> h.2.1.2 i (suc d) (eqT i d e)),
    TG.mono (suc k) D zero (GT.J0 D) (T68.NL (suc p0) (suc p0) (s zero)) (T68.minors D (suc p0) (suc p0) (s zero) u) h.2.2.1,
    \ i d e -> TG.mono (suc d) D zero (GT.J0 D) (T68.NL (r i) (s i) (s (suc i))) (T68.minors D (r i) (s i) (s (suc i)) (T i)) (h.2.2.2 i (suc d) (eqG i d e))) ;
  resT : T68.Res D k (suc p0) s u T = ihk D (suc p0) s u T r hypT ;
  -- the entries of u, regular on the last cokernel (Theorem 7.1)
  module EN = GT.Entries[D,suc p0,s zero,u] ;
  N : Nat = EN.N ;
  x (j : Fin N) : D.1.R = EN.entry j ;
  gx : TG.TGr (suc (suc k)) D zero (GT.J0 D) N x =
   GT.tgr-mono (suc (suc k)) D zero (GT.J0 D) (T68.NL (suc p0) (suc p0) (s zero)) (T68.minors D (suc p0) (suc p0) (s zero) u) N x
    (\ m -> EN.minor-in p0 (Enumerate[l].list _ (Enumerate[l].minors-index (suc p0) (suc p0) (s zero)) m)) h.2.2.1 ;
  module LX = LocalExactness[l].Over[D.1,D.2,s1 (suc p0) s k,s1 (suc p0) s (suc k),s1 (suc p0) s (suc (suc k)),
   T1 D (suc p0) s u T k,T1 D (suc p0) s u T (suc k)] ;
  reg-last : LX.RI.Regular (Fin N) x = \ y t hk -> thm71 D k (suc p0) s u T resT N x gx y hk ;
  -- in R[1/x_j]
  module Loc (j : Fin N) {
   c : D.1.R = x j ;
   Lc : TG.RD = TL.Loc D c ;
   module MP = McCoyMod[l].Map[D.1,(TL.Loc D c).1,D.2,(TL.Loc D c).2,TL.loc D c] ;
   module LE = LocalExact[l].Over[D.1,D.2,c] ;
   uL : RS.Mat Lc (suc p0) (s zero) = MP.extend (suc p0) (s zero) u ;
   TL1 (i : Nat) : RS.Mat Lc (s i) (s (suc i)) = MP.extend (s i) (s (suc i)) (T i) ;
   k0 : Fin (suc p0) = (FinPairs[l].enum (suc p0) (s zero) j).1 ;
   i0 : Fin (s zero) = (FinPairs[l].enum (suc p0) (s zero) j).2 ;
   unit : RL[Lc.1].unit (uL k0 i0) = LocalRegular[l].Invert[D.1,c].B.inverse c (suc zero,sym (D.1.mulO c)) ;
   module RD = Reduce[l].Over[Lc.1,Lc.2,p0,s zero,s (suc zero),s (suc (suc zero)),s (suc (suc (suc zero))),
    uL,TL1 zero,TL1 (suc zero),TL1 (suc (suc zero)),k0,i0,unit] ;
   s-suc : Nat -> Nat = split { zero -> suc (s (suc zero)) ; suc i -> s (suc (suc i)) } ;
   sR : Nat -> Nat = split { zero -> s zero ; suc i -> s-suc i } ;
   T-suc : (i : Nat) -> RS.Mat Lc (s-suc i) (s-suc (suc i)) = split { zero -> RD.Z ; suc i -> TL1 (suc (suc i)) } ;
   TR : (i : Nat) -> RS.Mat Lc (sR i) (sR (suc i)) = split { zero -> RD.B' ; suc i -> T-suc i } ;
   rR : Nat -> Nat = split { zero -> suc (r zero) ; suc i -> r (suc i) } ;
   czL (i d : Nat) (e : Id Nat (suc k) (plus (suc (suc i)) d)) :
    Matrices[l].Over[Lc.1].ComposeZero (s i) (s (suc i)) (s (suc (suc i))) (TL1 i) (TL1 (suc i)) =
    LE.compose-zero (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) (h.1.2 i d e) ;
   czL-top (d : Nat) (e : Id Nat (suc k) (suc d)) : Matrices[l].Over[Lc.1].ComposeZero (suc p0) (s zero) (s (suc zero)) uL (TL1 zero) =
    LE.compose-zero (suc p0) (s zero) (s (suc zero)) u (T zero) (h.1.1 d e) ;
   bz : Matrices[l].Over[Lc.1].ComposeZero (suc p0) (s zero) (s (suc zero)) uL (TL1 zero) = czL-top k (refl (suc k)) ;
   cz-suc : (i d : Nat) -> Id Nat (suc k) (plus (suc (suc (suc i))) d) ->
    Matrices[l].Over[Lc.1].ComposeZero (s-suc i) (s-suc (suc i)) (s-suc (suc (suc i))) (T-suc i) (T-suc (suc i)) = split {
    zero -> \ d e -> RD.compose-ZD (czL (suc zero) d e) ;
    suc i -> \ d e -> czL (suc (suc i)) d e } ;
   czR : (i d : Nat) -> Id Nat (suc k) (plus (suc (suc i)) d) ->
    Matrices[l].Over[Lc.1].ComposeZero (sR i) (sR (suc i)) (sR (suc (suc i))) (TR i) (TR (suc i)) = split {
    zero -> \ d e -> RD.compose-B'Z (czL zero d e) ;
    suc i -> cz-suc i } ;
   ranks2 : (i d : Nat) -> Id Nat (suc k) (plus (suc (suc i)) d) -> Id Nat (sR (suc i)) (plus (rR (suc i)) (rR i)) = split {
    zero -> \ d e -> trans (ap (\ jj -> suc jj) (h.2.1.2 zero d e)) (sym (plus-suc (r (suc zero)) (r zero))) ;
    suc i -> \ d e -> h.2.1.2 (suc i) d e } ;
   -- grades carried to R[1/x_j]
   loc-list (rr p1 q1 : Nat) (M : RS.Mat D p1 q1) :
    Id (Fin (T68.NL rr p1 q1) -> Lc.1.R) (\ m -> (TL.loc D c).1 (T68.minors D rr p1 q1 M m)) (T68.minors Lc rr p1 q1 (MP.extend p1 q1 M)) =
    F.funext (Fin (T68.NL rr p1 q1)) (\ m -> Lc.1.R) _ _ (\ m ->
     sym (MP.minors-map rr p1 q1 M (Enumerate[l].list _ (Enumerate[l].minors-index rr p1 q1) m))) ;
   up (g : Nat) (rr p1 q1 : Nat) (M : RS.Mat D p1 q1) (h1 : TG.TGr g D zero (GT.J0 D) (T68.NL rr p1 q1) (T68.minors D rr p1 q1 M)) :
    TG.TGr g Lc zero (GT.J0 Lc) (T68.NL rr p1 q1) (T68.minors Lc rr p1 q1 (MP.extend p1 q1 M)) =
    subst {Fin (T68.NL rr p1 q1) -> Lc.1.R} (\ L1 -> TG.TGr g Lc zero (GT.J0 Lc) (T68.NL rr p1 q1) L1) (loc-list rr p1 q1 M)
     (tgr-loc g D (T68.NL rr p1 q1) (T68.minors D rr p1 q1 M) c h1) ;
   module BK = RD.Back[bz] ;
   topG : TopG Lc (suc k) p0 sR RD.A2 =
    GT.tgr-mono (suc (suc k)) Lc zero (GT.J0 Lc) (T68.NL (suc p0) (suc p0) (s zero)) (T68.minors Lc (suc p0) (suc p0) (s zero) uL)
     (T68.NL p0 p0 (s zero)) (T68.minors Lc p0 p0 (s zero) RD.A2)
     (\ m -> BK.IntoA2.minor (Enumerate[l].list _ (Enumerate[l].minors-index (suc p0) (suc p0) (s zero)) m))
     (up (suc (suc k)) (suc p0) (suc p0) (s zero) u h.2.2.1) ;
   gradesR-suc : (i d : Nat) -> Id Nat (suc k) (plus (suc (suc i)) d) -> T68.GradeAt Lc sR rR TR (suc i) (suc d) = split {
    zero -> \ d e -> GT.tgr-mono (suc d) Lc zero (GT.J0 Lc)
      (T68.NL (r (suc zero)) (s (suc zero)) (s (suc (suc zero)))) (T68.minors Lc (r (suc zero)) (s (suc zero)) (s (suc (suc zero))) (TL1 (suc zero)))
      (T68.NL (r (suc zero)) (suc (s (suc zero))) (s (suc (suc zero)))) (T68.minors Lc (r (suc zero)) (suc (s (suc zero))) (s (suc (suc zero))) RD.Z)
      (\ m -> BK.IntoZ[r (suc zero)].minor (Enumerate[l].list _ (Enumerate[l].minors-index (r (suc zero)) (s (suc zero)) (s (suc (suc zero)))) m))
      (up (suc d) (r (suc zero)) (s (suc zero)) (s (suc (suc zero))) (T (suc zero)) (h.2.2.2 (suc zero) d e)) ;
    suc i -> \ d e -> up (suc d) (r (suc (suc i))) (s (suc (suc i))) (s (suc (suc (suc i)))) (T (suc (suc i))) (h.2.2.2 (suc (suc i)) d e) } ;
   gradesR : (i d : Nat) -> Id Nat (suc k) (plus (suc i) d) -> T68.GradeAt Lc sR rR TR i (suc d) = split {
    zero -> \ d e -> GT.tgr-mono (suc d) Lc zero (GT.J0 Lc)
      (T68.NL (r zero) (s zero) (s (suc zero))) (T68.minors Lc (r zero) (s zero) (s (suc zero)) (TL1 zero))
      (T68.NL (suc (r zero)) (s zero) (suc (s (suc zero)))) (T68.minors Lc (suc (r zero)) (s zero) (suc (s (suc zero))) RD.B')
      (\ m -> BK.IntoB'[r zero].minor (Enumerate[l].list _ (Enumerate[l].minors-index (r zero) (s zero) (s (suc zero))) m))
      (up (suc d) (r zero) (s zero) (s (suc zero)) (T zero) (h.2.2.2 zero d e)) ;
    suc i -> gradesR-suc i } ;
   hypR : Hyp Lc (suc k) p0 sR RD.A2 TR rR =
    ((\ d e -> RD.compose-A2 (czL-top d e),czR),
     (\ d e -> trans (h.2.1.1 d e) (plus-suc (r zero) p0),ranks2),
     topG,gradesR) ;
   resR : T68.Res Lc (suc k) p0 sR RD.A2 TR = ihp Lc sR RD.A2 TR rR hypR ;
   module DN = RD.Down[bz] ;
   -- the original complex is exact in R[1/x_j]
   orig-suc2 : (i d : Nat) -> Id Nat (suc k) (plus (suc (suc (suc i))) d) ->
    Matrices[l].Over[Lc.1].Exact (s (suc i)) (s (suc (suc i))) (s (suc (suc (suc i)))) (TL1 (suc i)) (TL1 (suc (suc i))) = split {
    zero -> \ d e -> DN.exact2 (resR.2.2 (suc zero) d e).2 ;
    suc i -> \ d e -> (resR.2.2 (suc (suc i)) d e).2 } ;
   orig-suc : (i d : Nat) -> Id Nat (suc k) (plus (suc (suc i)) d) ->
    Matrices[l].Over[Lc.1].Exact (s i) (s (suc i)) (s (suc (suc i))) (TL1 i) (TL1 (suc i)) = split {
    zero -> \ d e -> DN.exact1 (resR.2.2 zero d e).2 ;
    suc i -> orig-suc2 i } ;
   orig : (i d : Nat) -> Id Nat (suc k) (plus (suc i) d) ->
    Matrices[l].Over[Lc.1].Exact (s1 (suc p0) s i) (s1 (suc p0) s (suc i)) (s1 (suc p0) s (suc (suc i)))
     (MP.extend (s1 (suc p0) s i) (s1 (suc p0) s (suc i)) (T1 D (suc p0) s u T i))
     (MP.extend (s1 (suc p0) s (suc i)) (s1 (suc p0) s (suc (suc i))) (T1 D (suc p0) s u T (suc i))) = split {
    zero -> \ d e -> DN.exact0 (resR.2.1 d e).2 ;
    suc i -> orig-suc i } ;
   last : Matrices[l].Over[Lc.1].Exact (s1 (suc p0) s k) (s1 (suc p0) s (suc k)) (s1 (suc p0) s (suc (suc k)))
     (MP.extend (s1 (suc p0) s k) (s1 (suc p0) s (suc k)) (T1 D (suc p0) s u T k))
     (MP.extend (s1 (suc p0) s (suc k)) (s1 (suc p0) s (suc (suc k))) (T1 D (suc p0) s u T (suc k))) =
    orig k zero (sym (plus-zero (suc k))) ;
  } ;
  -- the last spot, glued
  last : MM.Exact (s1 (suc p0) s k) (s1 (suc p0) s (suc k)) (s1 (suc p0) s (suc (suc k)))
   (T1 D (suc p0) s u T k) (T1 D (suc p0) s u T (suc k)) =
   LX.glue N x reg-last (\ j -> Loc[j].last) ;
  -- every spot
  all : (i d : Nat) -> Id Nat (suc k) (plus (suc i) d) ->
   MM.Exact (s1 (suc p0) s i) (s1 (suc p0) s (suc i)) (s1 (suc p0) s (suc (suc i))) (T1 D (suc p0) s u T i) (T1 D (suc p0) s u T (suc i)) =
   \ i -> split {
    zero -> \ e -> subst {Nat} (\ n -> MM.Exact (s1 (suc p0) s n) (s1 (suc p0) s (suc n)) (s1 (suc p0) s (suc (suc n)))
       (T1 D (suc p0) s u T n) (T1 D (suc p0) s u T (suc n))) {k} {i}
      (trans (suc-inj {k} {plus i zero} e) (plus-zero i)) last ;
    suc d -> \ e -> spot-res D k (suc p0) s u T resT i d
     (trans (suc-inj {k} {plus i (suc d)} e) (plus-suc i d)) } ;
  result : T68.Res D (suc k) (suc p0) s u T =
   (resT.1,(\ d e -> (h.1.1 d e,all zero d e),\ i d e -> (h.1.2 i d e,all (suc i) d e))) ;
 } ;
 -- the induction
 claim-suc (k : Nat) (ihk : ClaimK k) : (p : Nat) -> ClaimP (suc k) p = split {
  zero -> \ D s u T r h -> PZero[k,ihk,D,s,u,T,r,h].result ;
  suc p0 | ihp -> \ D s u T r h -> PSucc[k,p0,ihk,ihp,D,s,u,T,r,h].result } ;
 cor75 : (k : Nat) -> ClaimK k = split {
  zero -> \ D p s u T r h -> Start[D,p,s,u,T,h.2.2.1].result ;
  suc k | ihk -> \ D p s u T r h -> claim-suc k ihk p D s u T r h } ;
} ;
