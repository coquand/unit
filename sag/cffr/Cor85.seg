-- cffr Corollary 8.5: the iteration of Lemma 8.4 along a complex (*).
-- The complex is indexed from the top: M t : R^(d t) -> R^(d (t+1)), of
-- rank rk (t+1) (rk 0 = 0), with rk (t+1) + rk t = d (t+1) (hd; the
-- dimensions are data, so a resolution in the layout of Thm68 fits).
-- M 0 is the map into the top module (beta_(m+1) = 1 of the paper).
-- A stage at A : R^e -> R^N (Stage) is the data of Lemma 8.4: alpha in
-- Lambda^p(R^e) regular, beta in Lambda^p(R^N) with Gr(beta) >= 2, and
-- ∧^p(A) = beta alpha^T.
-- * base: at the top p = 0 and alpha = beta = 1.
-- * step: Lemma 8.4 gives the stage at the next map (alpha' = bhat,
--   beta' = gamma, Gr(gamma) >= 2 from Gr(D_q(B)) >= 2); first for
--   N = q + p (Step), then for any N with q + p = N (by transport).
-- * Chain.Res.stage: by induction on t, for M 0, ..., M (T+1) with
--   Gr(D_(rk (t+1))(M (t+1))) >= 2 for t < T.  At the last map only
--   D_(rk (T+1))(M (T+1)) regular is assumed: Res.final gives gamma
--   (beta_1 of the paper), regular, of degree rk (T+1), and h with
--   Gr(h) >= 2 and every minor of M (T+1) equal to h_c gamma_J (Final).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Tr = Truncation[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module RI = MI.RI ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module RP = ExteriorReplacement[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module CB = ColumnBlocks[l].Over[Rg,setR] ;
 module L84 = Lemma84[l].Over[Rg,setR] ;

 -- t < T
 lt : Nat -> Nat -> U l = split {
  zero -> split { zero -> Empty ; suc T -> Top } ;
  suc t | r -> split { zero -> Empty ; suc T -> r T } } ;
 lt-pred : (t T : Nat) -> lt (suc t) T -> lt t T = split {
  zero -> split { zero -> \ h -> efq h ; suc T -> \ h -> tt } ;
  suc t | r -> split { zero -> \ h -> efq h ; suc T -> \ h -> r T h } } ;
 lt-self : (T : Nat) -> lt T (suc T) = split { zero -> tt ; suc T | r -> r } ;
 lt-zero : (t : Nat) -> lt t zero -> Empty = split { zero -> \ h -> h ; suc t -> \ h -> h } ;

 -- the empty subset and the unit 1 of Lambda(R^n)
 none : (n : Nat) -> C.Index n = split { zero -> tt ; suc n | r -> inl r } ;
 one-none : (n : Nat) -> Id R (CO.coeff n (eone n) (none n)) o = split { zero -> refl o ; suc n | r -> r } ;
 one-count : (n : Nat) (I : C.Index n) -> Id Nat (BA.count n I) zero -> Id R (CO.coeff n (eone n) I) o = split {
  zero -> \ I e -> refl o ;
  suc n | r -> split { inl I -> \ e -> r I e ; inr I -> \ e -> efq (suc-zero (BA.count n I) e) } } ;
 eprod-none (n : Nat) : (c : Nat) (f : Ps.Fin c -> Ext n) -> Id Nat c zero -> Id (Ext n) (eprod n c f) (eone n) = split {
  zero -> \ f e -> refl (eone n) ; suc c -> \ f e -> efq (suc-zero c e) } ;
 one-degree (n : Nat) : DG.Deg n zero (eone n) = DG.deg-eprod n zero (\ k -> efq k) (\ k -> efq k) ;
 one-regular (n : Nat) : RI.Regular (C.Index n) (CO.coeff n (eone n)) = \ x t h ->
  trans (sym (L.one-left x)) (trans (ap (\ c -> mul c x) (sym (one-none n))) (h (none n))) ;
 one-grade (n : Nat) : L84.GrTwo (C.Index n) (CO.coeff n (eone n)) =
  (one-regular n,\ y hy -> Tr.Trunc[L84.Multiple (C.Index n) (CO.coeff n (eone n)) y].inc (y (none n),\ K -> calc R {
   y K =< sym (L.one-left (y K)) > mul o (y K)
    =< ap (\ c -> mul c (y K)) (sym (one-none n)) > mul (CO.coeff n (eone n) (none n)) (y K)
    =< hy (none n) K > mul (CO.coeff n (eone n) K) (y (none n))
    =< mulC (CO.coeff n (eone n) K) (y (none n)) > mul (y (none n)) (CO.coeff n (eone n) K) })) ;

 -- a stage: the data of Lemma 8.4 at A : R^e -> R^N
 Stage (e p N : Nat) (A : MM.Mat e N) : U l =
  (a0 : Ext e) * (DG.Deg e p a0 * (RI.Regular (C.Index e) (CO.coeff e a0) *
  ((b0 : Ext N) * (DG.Deg N p b0 * (L84.GrTwo (C.Index N) (CO.coeff N b0) *
   ((I : C.Index e) -> Id Nat (BA.count e I) p ->
    Id (Ext N) (CB.Selected[N].selected-product e I A) (escale N (CO.coeff e a0 I) b0))))))) ;
 module St (e p N : Nat) (A : MM.Mat e N) (s : Stage e p N A) {
  alpha0 : Ext e = s.1 ;
  alpha-degree : DG.Deg e p alpha0 = s.2.1 ;
  alpha-regular : RI.Regular (C.Index e) (CO.coeff e alpha0) = s.2.2.1 ;
  beta0 : Ext N = s.2.2.2.1 ;
  beta-degree : DG.Deg N p beta0 = s.2.2.2.2.1 ;
  beta-grade : L84.GrTwo (C.Index N) (CO.coeff N beta0) = s.2.2.2.2.2.1 ;
  columns : (I : C.Index e) -> Id Nat (BA.count e I) p ->
   Id (Ext N) (CB.Selected[N].selected-product e I A) (escale N (CO.coeff e alpha0 I) beta0) = s.2.2.2.2.2.2 ;
 } ;

 -- the top: p = 0, alpha = beta = 1
 base (e N : Nat) (A : MM.Mat e N) : Stage e zero N A =
  (eone e,(one-degree e,(one-regular e,(eone N,(one-degree N,(one-grade N,
   \ I eI -> trans (eprod-none N (BA.count e I) (\ k -> gen N (RP.Columns[AL.Vec N].selected e I A k)) eI)
    (sym (trans (ap (\ c -> escale N c (eone N)) (one-count e I eI)) (EA.escale-one N (eone N)))))))))) ;

 -- what the last map gives: h, gamma and the minors
 Final (q N g : Nat) (B : MM.Mat N g) : U l =
  (h : (Ps.Fin q -> Ps.Fin N) -> R) * (L84.GrTwo (Ps.Fin q -> Ps.Fin N) h *
  ((gamma : Ext g) * (DG.Deg g q gamma * (RI.Regular (C.Index g) (CO.coeff g gamma) *
   ((m : MI.Index q N g) -> Id R (MI.minors q N g B m) (mul (h m.1) (CO.coeff g gamma m.2))))))) ;
 module Fi (q N g : Nat) (B : MM.Mat N g) (f : Final q N g B) {
  h (c : Ps.Fin q -> Ps.Fin N) : R = f.1 c ;
  h-grade : L84.GrTwo (Ps.Fin q -> Ps.Fin N) h = f.2.1 ;
  gamma : Ext g = f.2.2.1 ;
  gamma-degree : DG.Deg g q gamma = f.2.2.2.1 ;
  gamma-regular : RI.Regular (C.Index g) (CO.coeff g gamma) = f.2.2.2.2.1 ;
  minor-value : (m : MI.Index q N g) -> Id R (MI.minors q N g B m) (mul (h m.1) (CO.coeff g gamma m.2)) = f.2.2.2.2.2 ;
 } ;

 -- one step: Lemma 8.4, first for N = q + p
 module Step (e q p g : Nat) (A : MM.Mat e (plus q p)) (B : MM.Mat (plus q p) g)
  (cz : MM.ComposeZero e (plus q p) g A B) (s : Stage e p (plus q p) A) {
  module S = St[e,p,plus q p,A,s] ;
  module LA = L84.At[e,q,p,g,A,B,cz,S.alpha0,S.alpha-degree,S.alpha-regular,S.beta0,S.beta-degree,S.beta-grade,S.columns] ;
  next (gm : L84.GrTwo (MI.Index q (plus q p) g) (MI.minors q (plus q p) g B)) : Stage (plus q p) q g B =
   (LA.bhat,(LA.bhat-degree,(LA.bhat-regular,(LA.gamma,(LA.gamma-degree,(LA.GammaGrade[gm].result,LA.lemma84)))))) ;
  last (rg : MI.RegularD q (plus q p) g B) : Final q (plus q p) g B =
   (LA.h,(LA.h-grade LA.bhat-grade,(LA.gamma,(LA.gamma-degree,(LA.gamma-regular rg,LA.minor-value))))) ;
 } ;
 -- and for any N with q + p = N
 StepType (e p q g N : Nat) : U l =
  (A : MM.Mat e N) (B : MM.Mat N g) -> MM.ComposeZero e N g A B -> Stage e p N A ->
  L84.GrTwo (MI.Index q N g) (MI.minors q N g B) -> Stage N q g B ;
 step (e p q g N : Nat) (hN : Id Nat (plus q p) N) : StepType e p q g N =
  subst (StepType e p q g) hN (\ A B cz s gm -> Step[e,q,p,g,A,B,cz,s].next gm) ;
 LastType (e p q g N : Nat) : U l =
  (A : MM.Mat e N) (B : MM.Mat N g) -> MM.ComposeZero e N g A B -> Stage e p N A ->
  MI.RegularD q N g B -> Final q N g B ;
 last (e p q g N : Nat) (hN : Id Nat (plus q p) N) : LastType e p q g N =
  subst (LastType e p q g) hN (\ A B cz s rg -> Step[e,q,p,g,A,B,cz,s].last rg) ;

 -- Corollary 8.5: a complex M 0, ..., M (T+1), M t : R^(d t) -> R^(d (t+1)),
 -- M t of rank rk (t+1), with rk (t+1) + rk t = d (t+1)
 module Chain (s : Nat -> Nat) {
  rk : Nat -> Nat = split { zero -> zero ; suc t -> s t } ;
  module Res (T : Nat) (d : Nat -> Nat) (M : (t : Nat) -> MM.Mat (d t) (d (suc t)))
   (hd : (t : Nat) -> lt t (suc T) -> Id Nat (plus (rk (suc t)) (rk t)) (d (suc t)))
   (cz : (t : Nat) -> lt t (suc T) -> MM.ComposeZero (d t) (d (suc t)) (d (suc (suc t))) (M t) (M (suc t)))
   (gm : (t : Nat) -> lt (suc t) (suc T) ->
    L84.GrTwo (MI.Index (rk (suc t)) (d (suc t)) (d (suc (suc t)))) (MI.minors (rk (suc t)) (d (suc t)) (d (suc (suc t))) (M (suc t)))) {
   stage : (t : Nat) -> lt t (suc T) -> Stage (d t) (rk t) (d (suc t)) (M t) = split {
    zero -> \ h -> base (d zero) (d (suc zero)) (M zero) ;
    suc t | r -> \ h -> step (d t) (rk t) (rk (suc t)) (d (suc (suc t))) (d (suc t)) (hd t (lt-pred t (suc T) h))
     (M t) (M (suc t)) (cz t (lt-pred t (suc T) h)) (r (lt-pred t (suc T) h)) (gm t h) } ;
   -- the last map (only D_(rk (T+1))(M (T+1)) regular)
   final (rg : MI.RegularD (rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T))) : Final (rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T)) =
    last (d T) (rk T) (rk (suc T)) (d (suc (suc T))) (d (suc T)) (hd T (lt-self T)) (M T) (M (suc T)) (cz T (lt-self T)) (stage T (lt-self T)) rg ;
  } ;
 } ;
} ;
