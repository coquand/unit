-- cffr Corollary 8.8 (Hilbert-Burch).  If R^n -A-> R^(n+1) -(a_0..a_n)-> R
-- is a complex (a A = 0) with Gr(D_n(A)) >= 2 and (a_0, ..., a_n) regular,
-- then a_0, ..., a_n have a greatest common divisor, and it is regular.
-- Proof: Theorem 8.7 for the complex 0 -> R^n -A-> R^(n+1) -a-> R
-- (Cor85.Chain with ranks n, 1: M 0 the map from R^0, M 1 = A, M 2 = a as
-- a matrix with one row).  Its gcd is one of the 1 x 1 minors of a, which
-- are the a_j and 0 (OneRow), hence one of the a_j (Lemma86.Transfer).
-- (Exactness is not needed; the paper notes that with exactness the
-- grade hypothesis follows from Theorem 6.8: this is Theorem 8.9.)
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module RI = MI.RI ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module L84 = Lemma84[l].Over[Rg,setR] ;
 module C85 = Cor85[l].Over[Rg,setR] ;
 module L86 = Lemma86[l].Over[Rg,setR] ;
 module T87 = Thm87[l].Over[Rg,setR] ;

 -- the 1 x 1 minors of a matrix with one row are its entries and 0
 module OneRow (n : Nat) (A : MM.Mat n (suc zero)) {
  entry (j : Ps.Fin n) : R = A j (inr tt) ;
  wedge-one (v : MM.Vec (suc zero)) : Id (Ext (suc zero)) (MM.wedge (suc zero) (suc zero) (\ t -> v)) (gen (suc zero) v) =
   EA.one-left (suc zero) (gen (suc zero) v) ;
  minor-at : (c : Ps.Fin (suc zero) -> Ps.Fin n) (J : C.Index (suc zero)) ->
   Plus ((j : Ps.Fin n) * Id R (MI.minors (suc zero) n (suc zero) A (c,J)) (entry j)) (Id R (MI.minors (suc zero) n (suc zero) A (c,J)) z) =
   \ c -> split {
    inl t -> inr (ap (\ w -> CO.coeff (suc zero) w (inl t)) (wedge-one (A (c (inr tt))))) ;
    inr t -> inl (c (inr tt),ap (\ w -> CO.coeff (suc zero) w (inr t)) (wedge-one (A (c (inr tt))))) } ;
  minor-hit (m : MI.Index (suc zero) n (suc zero)) :
   Plus ((j : Ps.Fin n) * Id R (MI.minors (suc zero) n (suc zero) A m) (entry j)) (Id R (MI.minors (suc zero) n (suc zero) A m) z) =
   minor-at m.1 m.2 ;
  entry-minor (j : Ps.Fin n) : (m : MI.Index (suc zero) n (suc zero)) * Id R (MI.minors (suc zero) n (suc zero) A m) (entry j) =
   ((\ t -> j,inr tt),ap (\ w -> CO.coeff (suc zero) w (inr tt)) (wedge-one (A j))) ;
  -- (a_j) regular gives D_1 regular
  regular (ra : RI.Regular (Ps.Fin n) entry) : MI.RegularD (suc zero) n (suc zero) A = \ x t h ->
   ra x tt (\ j -> trans (ap (\ c -> mul c x) (sym (entry-minor j).2)) (h (entry-minor j).1)) ;
  -- a gcd of D_1 is a gcd of the a_j
  gcd (g : R) (gg : L86.Gcd (MI.Index (suc zero) n (suc zero)) (MI.minors (suc zero) n (suc zero) A) g) :
   L86.Gcd (Ps.Fin n) entry g =
   L86.Transfer[Ps.Fin n,MI.Index (suc zero) n (suc zero),entry,MI.minors (suc zero) n (suc zero) A,minor-hit,entry-minor,g,gg].result ;
 } ;

 module Cor88 (n : Nat) (A : MM.Mat n (suc n)) (a : Ps.Fin (suc n) -> R)
  (cz : MM.ComposeZero n (suc n) (suc zero) A (\ j t -> a j))
  (gA : L84.GrTwo (MI.Index n n (suc n)) (MI.minors n n (suc n) A))
  (ra : RI.Regular (Ps.Fin (suc n)) a) {
  aM : MM.Mat (suc n) (suc zero) = \ j t -> a j ;
  module OR = OneRow[suc n,aM] ;
  -- the complex 0 -> R^n -A-> R^(n+1) -a-> R, with ranks n, 1
  s : Nat -> Nat = split { zero -> n ; suc t -> suc zero } ;
  module CH = C85.Chain[s] ;
  d2 : Nat -> Nat = split { zero -> suc n ; suc t -> suc zero } ;
  d1 : Nat -> Nat = split { zero -> n ; suc t -> d2 t } ;
  d : Nat -> Nat = split { zero -> zero ; suc t -> d1 t } ;
  M2 : (t : Nat) -> MM.Mat (d2 t) (d2 (suc t)) = split { zero -> aM ; suc t -> \ k j -> z } ;
  M1 : (t : Nat) -> MM.Mat (d1 t) (d1 (suc t)) = split { zero -> A ; suc t -> M2 t } ;
  M : (t : Nat) -> MM.Mat (d t) (d (suc t)) = split { zero -> \ k -> efq k ; suc t -> M1 t } ;
  hd1 : (t : Nat) -> C85.lt (suc t) (suc (suc zero)) -> Id Nat (plus (CH.rk (suc (suc t))) (CH.rk (suc t))) (d (suc (suc t))) = split {
   zero -> \ h -> refl (suc n) ; suc t -> \ h -> efq (C85.lt-zero t h) } ;
  hd : (t : Nat) -> C85.lt t (suc (suc zero)) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)) = split {
   zero -> \ h -> plus-zero n ; suc t -> hd1 t } ;
  cz1 : (t : Nat) -> C85.lt (suc t) (suc (suc zero)) -> MM.ComposeZero (d (suc t)) (d (suc (suc t))) (d (suc (suc (suc t)))) (M (suc t)) (M (suc (suc t))) = split {
   zero -> \ h -> cz ; suc t -> \ h -> efq (C85.lt-zero t h) } ;
  cz' : (t : Nat) -> C85.lt t (suc (suc zero)) -> MM.ComposeZero (d t) (d (suc t)) (d (suc (suc t))) (M t) (M (suc t)) = split {
   zero -> \ h k -> efq k ; suc t -> cz1 t } ;
  gm : (t : Nat) -> C85.lt (suc t) (suc (suc zero)) ->
   L84.GrTwo (MI.Index (CH.rk (suc t)) (d (suc t)) (d (suc (suc t)))) (MI.minors (CH.rk (suc t)) (d (suc t)) (d (suc (suc t))) (M (suc t))) = split {
   zero -> \ h -> gA ; suc t -> \ h -> efq (C85.lt-zero t h) } ;
  module TH = T87.Thm87[s].Res[suc zero,d,M,hd,cz',gm,OR.regular ra,refl (suc zero)] ;
  -- Corollary 8.8
  gcd : R = TH.det ;
  cor88 : L86.Gcd (Ps.Fin (suc n)) a gcd = OR.gcd TH.det TH.theorem87 ;
  gcd-regular : L86.RegularElement gcd = TH.det-regular ;
 } ;
} ;
