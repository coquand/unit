-- cffr Corollary 7.6: for an n x (n+1) matrix A (n columns in R^(n+1)) with
-- Gr(D_n(A)) >= 3, 1 is in D_n(A).
-- D_n(A) is the ideal of the coefficients of W = i(A_1) ... i(A_n) in the
-- exterior algebra of R^(n+1).  Put Delta_k = top(W e_k).
-- * Delta . A = 0: sum_k a_k Delta_k = top(W i(a)) = 0 for a column a of A,
--   since W i(a) has a repeated factor.
-- * (Delta) = D_n(A): Delta_k is a coefficient of a multiple of W; and
--   W e_k = Delta_k omega (degree n+1), while W = alpha(sum_k c_k(W e_k))
--   (Euler), so the coefficients of W lie in (Delta).
-- * 0 -> R^n -A-> R^(n+1) -Delta-> R is exact by Corollary 7.5 (Gr >= 2 for
--   D_n(A), Gr >= 1 for D_1(Delta) = (Delta)).  Delta_j kills R / (Delta),
--   so by Theorem 7.1 (Chain.Elem, Gr(Delta) >= 3) the vector 1 is in the
--   image of Delta: 1 is in (Delta) = D_n(A).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module TG = TrueGrade[l] ; module GT = GradeTools[l] ; module RS = Resolution[l] ; module T68 = Thm68[l] ;
module E = Enumerate[l] ;
module Over (D : TG.RD) (n : Nat) (A : Matrices[l].Over[D.1].Mat n (suc n)) {
 module L = RL[D.1] ;
 open ExteriorModel[l].Over[D.1] ;
 module MM = Matrices[l].Over[D.1] ;
 module MI = Minors[l].Over[D.1,D.2] ;
 module EA = ExteriorAlgebra[l].Over[D.1,D.2] ;
 module EC = ExteriorCoordinates[l].Over[D.1,D.2] ;
 module DU = ExteriorDuality[l].Over[D.1,D.2] ;
 module DG = ExteriorDegree[l].Over[D.1,D.2] ;
 module WS = WedgeStep[l].Over[D.1,D.2,suc n] ;
 module EU = Euler[l].Over[D.1,D.2,suc n] ;
 module ET = Euler[l].Top[D.1,D.2,n,A] ;
 module FS = FiniteIdeal[l].Sums[D.1] ;
 module G = EA.At[suc n].G ;
 q : Nat = suc n ;
 W : Ext q = MM.wedge n q A ;
 Delta (k : Fin q) : D.1.R = top q (emul q W (EU.e k)) ;
 Dl : MM.Mat q (suc zero) = \ k j -> Delta k ;
 -- a product of generators times one of its factors is 0
 rep : (m : Nat) (c : Fin m) (v : MM.Mat m q) -> Id (Ext q) (emul q (MM.wedge m q v) (gen q (v c))) (ezero q) = split {
  zero -> \ c v -> efq c ;
  suc m | r -> split {
   inl c -> \ v -> calc (Ext q) { emul q (MM.wedge (suc m) q v) (gen q (v (inl c)))
     =< sym (EA.mulA' q (MM.wedge m q (\ k -> v (inl k))) (gen q (v (inr tt))) (gen q (v (inl c))))
     > emul q (MM.wedge m q (\ k -> v (inl k))) (emul q (gen q (v (inr tt))) (gen q (v (inl c))))
     =< ap (emul q (MM.wedge m q (\ k -> v (inl k)))) (WS.anti (v (inr tt)) (v (inl c)))
     > emul q (MM.wedge m q (\ k -> v (inl k))) (eneg q (emul q (gen q (v (inl c))) (gen q (v (inr tt)))))
     =< EA.mul-neg-r q (MM.wedge m q (\ k -> v (inl k))) (emul q (gen q (v (inl c))) (gen q (v (inr tt))))
     > eneg q (emul q (MM.wedge m q (\ k -> v (inl k))) (emul q (gen q (v (inl c))) (gen q (v (inr tt)))))
     =< ap (eneg q) (EA.mulA' q (MM.wedge m q (\ k -> v (inl k))) (gen q (v (inl c))) (gen q (v (inr tt))))
     > eneg q (emul q (emul q (MM.wedge m q (\ k -> v (inl k))) (gen q (v (inl c)))) (gen q (v (inr tt))))
     =< ap (\ y -> eneg q (emul q y (gen q (v (inr tt))))) (r c (\ k -> v (inl k)))
     > eneg q (emul q (ezero q) (gen q (v (inr tt))))
     =< trans (ap (eneg q) (EA.mul-zero-l q (gen q (v (inr tt))))) G.neg-zero > ezero q } ;
   inr t -> \ v -> calc (Ext q) { emul q (MM.wedge (suc m) q v) (gen q (v (inr t)))
     =< ap (\ s -> emul q (MM.wedge (suc m) q v) (gen q (v (inr s)))) (MnSums[l].top-eq t tt)
     > emul q (MM.wedge (suc m) q v) (gen q (v (inr tt)))
     =< sym (EA.mulA' q (MM.wedge m q (\ k -> v (inl k))) (gen q (v (inr tt))) (gen q (v (inr tt))))
     > emul q (MM.wedge m q (\ k -> v (inl k))) (emul q (gen q (v (inr tt))) (gen q (v (inr tt))))
     =< ap (emul q (MM.wedge m q (\ k -> v (inl k)))) (EA.gen-sq q (v (inr tt)))
     > emul q (MM.wedge m q (\ k -> v (inl k))) (ezero q)
     =< EA.mul-zero-r q (MM.wedge m q (\ k -> v (inl k))) > ezero q } } } ;
 top-zero : Id D.1.R (top q (ezero q)) D.1.z =
  trans (ap (top q) (sym (EA.zero-scale q (ezero q)))) (trans (DG.top-scale q D.1.z (ezero q)) (L.zero-mul (top q (ezero q)))) ;
 -- top of a sum
 top-esum : (m : Nat) (f : Fin m -> Ext q) -> Id D.1.R (top q (EU.esum m f)) (FS.sum m (\ k -> top q (f k))) = split {
  zero -> \ f -> top-zero ;
  suc m | r -> \ f -> trans (DU.top-add q (f (inr tt)) (EU.esum m (\ k -> f (inl k))))
   (ap (D.1.add (top q (f (inr tt)))) (r (\ k -> f (inl k)))) } ;
 -- Delta . a = top(W i(a))
 pair (a : MM.Vec q) : Id D.1.R (FS.sum q (\ k -> D.1.mul (a k) (Delta k))) (top q (emul q W (gen q a))) =
  sym (calc D.1.R { top q (emul q W (gen q a))
   =< ap (\ y -> top q (emul q W y)) (EU.expand a)
   > top q (emul q W (EU.esum q (\ k -> escale q (a k) (EU.e k))))
   =< ap (top q) (sym (EU.esum-left q W (\ k -> escale q (a k) (EU.e k))))
   > top q (EU.esum q (\ k -> emul q W (escale q (a k) (EU.e k))))
   =< top-esum q (\ k -> emul q W (escale q (a k) (EU.e k)))
   > FS.sum q (\ k -> top q (emul q W (escale q (a k) (EU.e k))))
   =< FS.sum-cong q _ (\ k -> D.1.mul (a k) (Delta k))
       (\ k -> trans (ap (top q) (EA.scale-mul-right q (a k) W (EU.e k))) (DG.top-scale q (a k) (emul q W (EU.e k))))
   > FS.sum q (\ k -> D.1.mul (a k) (Delta k)) }) ;
 compose-zero : MM.ComposeZero n q (suc zero) A Dl = \ c j ->
  trans (pair (A c)) (trans (ap (top q) (rep n c A)) (top-zero)) ;
 -- D_n(A): the coefficients of W, as a list
 IX : E.Enum (ExteriorCoordinates[l].Index q) = E.index q ;
 Nw : Nat = IX.1 ;
 mw (i : Fin Nw) : D.1.R = EC.coeff q W (E.list _ IX i) ;
 full : (m : Nat) -> ExteriorCoordinates[l].Index m = split { zero -> tt ; suc m | r -> inr r } ;
 top-coeff : (m : Nat) (x : Ext m) -> Id D.1.R (top m x) (EC.coeff m x (full m)) = split {
  zero -> \ x -> refl x ; suc m | r -> \ x -> r x.2 } ;
 -- (Delta) in D_n(A)
 module GW = RegularIdeal[l].Generated[D.1,Nw,mw] ;
 module IEW = IdealExt[l].Over[D.1,D.2,GW.ideal] ;
 W-in : IEW.InCoeff q W = \ J ->
  subst (\ J1 -> GW.In (EC.coeff q W J1)) (E.pre-eq _ IX J) (GW.generator (E.pre _ IX J)) ;
 delta-in (k : Fin q) : GW.In (Delta k) =
  subst GW.In (sym (top-coeff q (emul q W (EU.e k)))) (IEW.in-mul-right q W (EU.e k) W-in (full q)) ;
 -- D_n(A) in (Delta)
 module GD = RegularIdeal[l].Generated[D.1,q,Delta] ;
 module IED = IdealExt[l].Over[D.1,D.2,GD.ideal] ;
 module ILD = RegularIdeal[l].IdealLaws[D.1,GD.ideal] ;
 in-scaled (c : D.1.R) (hc : GD.In c) (y : Ext q) : IED.InCoeff q (escale q c y) = \ J ->
  ILD.in-eq (D.1.mul (EC.coeff q y J) c) (EC.coeff q (escale q c y) J)
   (trans (D.1.mulC (EC.coeff q y J) c) (sym (EC.coeff-scale q c y J))) (GD.ideal.in-mul (EC.coeff q y J) c hc) ;
 in-esum : (m : Nat) (f : Fin m -> Ext q) -> ((k : Fin m) -> IED.InCoeff q (f k)) -> IED.InCoeff q (EU.esum m f) = split {
  zero -> \ f h -> IED.in-zero q ;
  suc m | r -> \ f h -> IED.in-add q (f (inr tt)) (EU.esum m (\ k -> f (inl k))) (h (inr tt)) (r (\ k -> f (inl k)) (\ k -> h (inl k))) } ;
 top-form (k : Fin q) : Id (Ext q) (emul q W (EU.e k)) (escale q (Delta k) (DG.omega q)) =
  DG.deg-top q (emul q W (EU.e k))
   (DG.deg-mul1 q n W (EU.e k) (DG.deg-eprod q n (\ c -> gen q (A c)) (\ c -> DG.deg-gen q (A c))) (DG.deg-gen q (EU.delta k))) ;
 S-in : IED.InCoeff q (EU.S W) =
  in-esum q (\ k -> EU.c k (emul q W (EU.e k)))
   (\ k -> IED.in-contract q (EU.delta k) (emul q W (EU.e k))
     (IED.in-eq q (escale q (Delta k) (DG.omega q)) (emul q W (EU.e k)) (sym (top-form k))
      (in-scaled (Delta k) (GD.generator k) (DG.omega q)))) ;
 W-inD : IED.InCoeff q W = IED.in-eq q (alpha q (EU.S W)) W ET.sum-identity (IED.in-alpha q (EU.S W) S-in) ;
 mw-in (i : Fin Nw) : GD.In (mw i) = W-inD (E.list _ IX i) ;
 -- the complex R^n -A-> R^(n+1) -Delta-> R
 s76 : Nat -> Nat = split { zero -> q ; suc i -> suc zero } ;
 T76 : (i : Nat) -> RS.Mat D (s76 i) (s76 (suc i)) = split { zero -> Dl ; suc i -> \ a b -> D.1.z } ;
 r76 (i : Nat) : Nat = suc zero ;
 module C = Cor75Inst[l].C ;
 -- D_n(A) is in the ideal of all n-minors (Thm68 list)
 NA : Nat = T68.NL n n q ;
 MA (i : Fin NA) : D.1.R = T68.minors D n n q A i ;
 mw-minor (i : Fin Nw) : TG.InI D NA MA (mw i) =
  subst (\ ci -> TG.InI D NA MA (MI.minors n n q A ci)) (E.pre-eq _ (E.minors-index n n q) ((\ t -> t),E.list _ IX i))
   (RegularIdeal[l].Generated[D.1,NA,MA].generator (E.pre _ (E.minors-index n n q) ((\ t -> t),E.list _ IX i))) ;
 -- Delta_k is a 1-minor of Delta
 N1 : Nat = T68.NL (suc zero) q (suc zero) ;
 M1 (i : Fin N1) : D.1.R = T68.minors D (suc zero) q (suc zero) Dl i ;
 delta-minor (k : Fin q) : TG.InI D N1 M1 (Delta k) =
  subst (TG.InI D N1 M1) (ap (\ y -> EC.coeff (suc zero) y (full (suc zero))) (EA.one-left (suc zero) (gen (suc zero) (Dl k))))
   (subst (\ ci -> TG.InI D N1 M1 (MI.minors (suc zero) q (suc zero) Dl ci)) (E.pre-eq _ (E.minors-index (suc zero) q (suc zero)) ((\ t -> k),full (suc zero)))
    (RegularIdeal[l].Generated[D.1,N1,M1].generator (E.pre _ (E.minors-index (suc zero) q (suc zero)) ((\ t -> k),full (suc zero))))) ;
 module Main (g3 : TG.TGr (suc (suc (suc zero))) D zero (GT.J0 D) Nw mw) {
  topG : C.TopG D (suc zero) n s76 A =
   TG.mono (suc (suc zero)) D zero (GT.J0 D) NA MA (GT.tgr-mono (suc (suc (suc zero))) D zero (GT.J0 D) Nw mw NA MA mw-minor g3) ;
  g1 : TG.TGr (suc zero) D zero (GT.J0 D) N1 M1 =
   TG.mono (suc zero) D zero (GT.J0 D) N1 M1 (TG.mono (suc (suc zero)) D zero (GT.J0 D) N1 M1
    (GT.tgr-mono (suc (suc (suc zero))) D zero (GT.J0 D) Nw mw N1 M1
     (\ i -> GT.in-trans D q Delta N1 M1 (mw i) (mw-in i) delta-minor) g3)) ;
  grades : (i d : Nat) -> Id Nat (suc zero) (plus (suc i) d) -> T68.GradeAt D s76 r76 T76 i (suc d) = split {
   zero -> \ d e -> subst {Nat} (\ d1 -> T68.GradeAt D s76 r76 T76 zero (suc d1)) {zero} {d} (suc-inj e) g1 ;
   suc i -> \ d e -> efq (zero-suc (plus i d) (suc-inj e)) } ;
  hyp : C.Hyp D (suc zero) n s76 A T76 r76 =
   ((\ d e -> compose-zero,\ i d e -> efq (zero-suc (plus i d) (suc-inj e))),
    (\ d e -> refl q,\ i d e -> efq (zero-suc (plus i d) (suc-inj e))),
    topG,grades) ;
  res : T68.Res D (suc zero) n s76 A T76 = Cor75Inst[l].cor75 (suc zero) D n s76 A T76 r76 hyp ;
  -- Gr(Delta) >= 3, Koszul form
  gD : TG.TGr (suc (suc (suc zero))) D zero (GT.J0 D) q Delta =
   GT.tgr-mono (suc (suc (suc zero))) D zero (GT.J0 D) Nw mw q Delta mw-in g3 ;
  one1 : MM.Vec (suc zero) = \ j -> D.1.o ;
  kill (j : Fin q) : Tr.Trunc[Bijection[l].Fibre (MM.apply q (suc zero) Dl) (\ i -> D.1.mul (Delta j) D.1.o)].carrier =
   Tr.Trunc[Bijection[l].Fibre (MM.apply q (suc zero) Dl) (\ i -> D.1.mul (Delta j) D.1.o)].inc
    (EU.delta j,F.funext (Fin (suc zero)) (\ i -> D.1.R) (MM.apply q (suc zero) Dl (EU.delta j)) (\ i -> D.1.mul (Delta j) D.1.o)
      (\ i -> trans (MnSums[l].Over[D.1].sum-delta q j Delta) (sym (trans (D.1.mulC (Delta j) D.1.o) (L.one-left (Delta j)))))) ;
  module CH = Resolutions[l].Over[D.1,D.2].Chain[suc zero,n,s76,A,T76,res.1,res.2,q,Delta] ;
  hit : Tr.Trunc[Bijection[l].Fibre (MM.apply q (suc zero) Dl) one1].carrier =
   CH.Elem[TrueKoszul[l].Absolute[D,q,Delta].result (suc (suc (suc zero))) gD,one1,kill].result ;
  one-in : GD.In D.1.o =
   TC.map (Bijection[l].Fibre (MM.apply q (suc zero) Dl) one1) (FS.Coordinates q Delta D.1.o)
    (\ w -> (w.1,trans (FS.sum-cong q (\ k -> D.1.mul (Delta k) (w.1 k)) (\ k -> D.1.mul (w.1 k) (Delta k)) (\ k -> D.1.mulC (Delta k) (w.1 k)))
       (ap (\ v -> v (inr tt)) w.2))) hit ;
  -- Corollary 7.6
  result : TG.InI D Nw mw D.1.o = GT.in-trans D q Delta Nw mw D.1.o one-in delta-in ;
 } ;
} ;
-- Corollary 7.6: Gr(D_n(A)) >= 3 gives 1 in D_n(A)
cor76 (D : TG.RD) (n : Nat) (A : Matrices[l].Over[D.1].Mat n (suc n))
 (g : TG.TGr (suc (suc (suc zero))) D zero (GT.J0 D) (Over[D,n,A].Nw) (Over[D,n,A].mw)) :
 TG.InI D (Over[D,n,A].Nw) (Over[D,n,A].mw) D.1.o = Over[D,n,A].Main[g].result ;
