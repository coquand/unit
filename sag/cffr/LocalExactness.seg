-- Exactness is local (cffr Cor. 7.5, proof): for R^p -A-> R^q -B-> R^l and a
-- list x_1, ..., x_n which is regular on R^q / im A (if x_i y is in im A for
-- all i then y is in im A), if (A, B) is exact in every R[1/x_i] then it is
-- exact.  Let B y = 0.  In R[1/x_i], y = A w; clearing denominators,
-- s w = W and t (s y - A W) = 0 for powers s, t of x_i, so (t s) y is in
-- im A.  So a power of every x_i sends y into im A, and Corollary 2.2 on
-- R^q / im A (RegularIdeal over the action whose "zero" is im A) gives y in
-- im A.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (p q l1 : Nat)
 (A : Matrices[l].Over[Rg].Mat p q) (B : Matrices[l].Over[Rg].Mat q l1) {
 open Rg ; module L = RL[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module RR = RingRearrange[l] ;
 vec-ext (n : Nat) (u v : MM.Vec n) (h : (i : Fin n) -> Id R (u i) (v i)) : Id (MM.Vec n) u v = F.funext (Fin n) (\ i -> R) u v h ;
 -- R^q modulo im A
 InIm (y : MM.Vec q) : U l = Tr.Trunc[(x : MM.Vec p) * ((i : Fin q) -> Id R (MM.apply p q A x i) (y i))].carrier ;
 scale (c : R) (y : MM.Vec q) : MM.Vec q = \ i -> mul c (y i) ;
 im-scale (c : R) (y : MM.Vec q) (h : InIm y) : InIm (scale c y) =
  TC.map ((x : MM.Vec p) * ((i : Fin q) -> Id R (MM.apply p q A x i) (y i)))
   ((x : MM.Vec p) * ((i : Fin q) -> Id R (MM.apply p q A x i) (scale c y i)))
   (\ w -> ((\ k -> mul c (w.1 k)),\ i -> trans (MM.apply-scale p q A c w.1 i) (ap (mul c) (w.2 i)))) h ;
 action : RegularIdeal[l].Action[Rg] =
  RegularIdeal[l].mkAction Rg (MM.Vec q) InIm scale
   (\ a b y -> vec-ext q (scale (mul a b) y) (scale a (scale b y)) (\ i -> sym (mulA a b (y i))))
   (\ y -> vec-ext q (scale o y) y (\ i -> L.one-left (y i)))
   im-scale ;
 module RI = RegularIdeal[l].Over[Rg,action] ;
 module Glue (n : Nat) (x : Fin n -> R) (reg : RI.Regular (Fin n) x)
  (loc : (i : Fin n) -> Matrices[l].Over[LocalExact[l].Over[Rg,setR,x i].I.ring].Exact p q l1
   (LocalExact[l].Over[Rg,setR,x i].extend p q A) (LocalExact[l].Over[Rg,setR,x i].extend q l1 B))
  (y : MM.Vec q) (hy : (j : Fin l1) -> Id R (MM.apply q l1 B y j) z) {
  Killed (i : Fin n) : U l = (e : Nat) * InIm (scale (RI.power (x i) e) y) ;
  module At (i : Fin n) {
   module LE = LocalExact[l].Over[Rg,setR,x i] ;
   module FL = LE.FL ;
   module ML = Matrices[l].Over[LE.I.ring] ;
   ky (j : Fin q) : LE.I.ring.R = LE.k (y j) ;
   hky (j : Fin l1) : Id LE.I.ring.R (ML.apply q l1 (LE.extend q l1 B) ky j) LE.I.ring.z =
    trans (sym (LE.apply-k q l1 B y j)) (trans (ap LE.k (hy j)) FL.k-zero) ;
   module W (w : ML.Vec p) (hw : (j : Fin q) -> Id LE.I.ring.R (ML.apply p q (LE.extend p q A) w j) (ky j)) {
    module C (cl : FL.Cleared p w) {
     s : R = cl.1 ; Wv (k : Fin p) : R = cl.2.2.1 k ;
     image (j : Fin q) : Id LE.I.ring.R (LE.k (add (mul s (y j)) (neg (MM.apply p q A Wv j)))) LE.I.ring.z =
      calc LE.I.ring.R { LE.k (add (mul s (y j)) (neg (MM.apply p q A Wv j)))
       =< LE.I.inclusion.2.2.1 (mul s (y j)) (neg (MM.apply p q A Wv j))
       > LE.I.ring.add (LE.k (mul s (y j))) (LE.k (neg (MM.apply p q A Wv j)))
       =< ap (LE.I.ring.add (LE.k (mul s (y j)))) (RingHom[l].negation Rg LE.I.ring LE.I.inclusion (MM.apply p q A Wv j))
       > LE.I.ring.add (LE.k (mul s (y j))) (LE.I.ring.neg (LE.k (MM.apply p q A Wv j)))
       =< ap (\ t -> LE.I.ring.add t (LE.I.ring.neg (LE.k (MM.apply p q A Wv j))))
           (calc LE.I.ring.R { LE.k (mul s (y j))
             =< FL.k-mul s (y j) > LE.I.ring.mul (LE.k s) (ky j)
             =< ap (LE.I.ring.mul (LE.k s)) (sym (hw j)) > LE.I.ring.mul (LE.k s) (ML.apply p q (LE.extend p q A) w j)
             =< sym (ML.apply-scale p q (LE.extend p q A) (LE.k s) w j) > ML.apply p q (LE.extend p q A) (\ k -> LE.I.ring.mul (LE.k s) (w k)) j
             =< ap {ML.Vec p} (\ v -> ML.apply p q (LE.extend p q A) v j)
                 (F.funext (Fin p) (\ k -> LE.I.ring.R) _ (\ k -> LE.k (Wv k)) (\ k -> cl.2.2.2 k))
             > ML.apply p q (LE.extend p q A) (\ k -> LE.k (Wv k)) j
             =< sym (LE.apply-k p q A Wv j) > LE.k (MM.apply p q A Wv j) })
       > LE.I.ring.add (LE.k (MM.apply p q A Wv j)) (LE.I.ring.neg (LE.k (MM.apply p q A Wv j)))
       =< LE.I.ring.addN (LE.k (MM.apply p q A Wv j)) > LE.I.ring.z } ;
     module K (kv : FL.KilledV q (\ j -> add (mul s (y j)) (neg (MM.apply p q A Wv j)))) {
      t : R = FL.power kv.1 ;
      e : Nat = plus kv.1 cl.2.1.1 ;
      power-e : Id R (RI.power (x i) e) (mul t s) =
       trans (LE.I.Pow.power-add (x i) kv.1 cl.2.1.1) (ap (mul t) (sym cl.2.1.2)) ;
      result : Killed i =
       (e,Tr.Trunc[(v : MM.Vec p) * ((j : Fin q) -> Id R (MM.apply p q A v j) (scale (RI.power (x i) e) y j))].inc
        ((\ k -> mul t (Wv k)),\ j -> trans (MM.apply-scale p q A t Wv j)
          (trans (sym (RR.cancel-difference Rg t (mul s (y j)) (MM.apply p q A Wv j) (kv.2 j)))
           (trans (mulA t s (y j)) (ap (\ c -> mul c (y j)) (sym power-e)))))) ;
     } ;
     result : Tr.Trunc[Killed i].carrier =
      TC.map (FL.KilledV q (\ j -> add (mul s (y j)) (neg (MM.apply p q A Wv j)))) (Killed i) (\ kv -> K[kv].result)
       (FL.killV q (\ j -> add (mul s (y j)) (neg (MM.apply p q A Wv j))) (\ j -> LE.I.kernel (add (mul s (y j)) (neg (MM.apply p q A Wv j))) (image j))) ;
    } ;
    result : Tr.Trunc[Killed i].carrier = TC.bind (FL.Cleared p w) (Killed i) (\ cl -> C[cl].result) (FL.clear p w) ;
   } ;
   result : Tr.Trunc[Killed i].carrier =
    TC.bind ((w : ML.Vec p) * ((j : Fin q) -> Id LE.I.ring.R (ML.apply p q (LE.extend p q A) w j) (ky j))) (Killed i)
     (\ ww -> W[ww.1,ww.2].result) (loc i ky hky) ;
  } ;
  result : InIm y =
   Tr.Trunc[(i : Fin n) -> Killed i].induction @l (\ w -> InIm y)
    (\ w -> Tr.Trunc[(x1 : MM.Vec p) * ((i : Fin q) -> Id R (MM.apply p q A x1 i) (y i))].proposition)
    (\ k -> RI.regular-powers n x (\ i -> (k i).1) reg y tt (\ i -> (k i).2))
    (AffineFinite[l].choice n Killed (\ i -> At[i].result)) ;
 } ;
 glue (n : Nat) (x : Fin n -> R) (reg : RI.Regular (Fin n) x)
  (loc : (i : Fin n) -> Matrices[l].Over[LocalExact[l].Over[Rg,setR,x i].I.ring].Exact p q l1
   (LocalExact[l].Over[Rg,setR,x i].extend p q A) (LocalExact[l].Over[Rg,setR,x i].extend q l1 B)) :
  MM.Exact p q l1 A B = \ y hy -> Glue[n,x,reg,loc,y,hy].result ;
} ;
