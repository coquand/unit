-- Complexes modulo an ideal K (a list), and cffr Lemma 4.1 for adding one
-- element b regular mod J: from mod J to mod (J, b).
-- u : R^p -> R^q is injective mod K when u x in K^q gives x in K^p; the pair
-- (u, v) is exact mod K at R^q when v y in K gives, merely, y = u x mod K.
-- (inj) u injective mod J, v u = 0, (u, v) exact mod J, b regular mod J
--   => u injective mod (J, b).  If u x = b w mod J, then b v w = v u x = 0
--   mod J, so v w = 0 mod J, w = u y mod J, and u (x - b y) = 0 mod J;
--   hence x = b y mod J, i.e. x in (J, b).
-- (exact) (u, v), (v, w) exact mod J, w v = 0, b regular mod J
--   => (u, v) exact mod (J, b).  If v y = b z mod J, then b w z = 0 mod J,
--   so z = v t mod J; v (y - b t) = 0 mod J, so y - b t = u x mod J, i.e.
--   y = u x mod (J, b).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module TI = TrueGradeIdeals[l].Over[Rg,setR] ;
 module TG = TrueGrade[l] ;
 sub (x y : R) : R = TI.sub x y ;
 In (m : Nat) (K : Fin m -> R) (x : R) : U l = TI.In m K x ;
 module AG = ExteriorAlgebra[l].AG[R,z,add,neg,addA,addC,addZ,addN] ;
 VecIn (m : Nat) (K : Fin m -> R) (q : Nat) (y : MM.Vec q) : U l = (j : Fin q) -> In m K (y j) ;
 InjMod (m : Nat) (K : Fin m -> R) (p q : Nat) (u : MM.Mat p q) : U l =
  (x : MM.Vec p) -> VecIn m K q (MM.apply p q u x) -> VecIn m K p x ;
 ExactMod (m : Nat) (K : Fin m -> R) (p q l1 : Nat) (u : MM.Mat p q) (v : MM.Mat q l1) : U l =
  (y : MM.Vec q) -> VecIn m K l1 (MM.apply q l1 v y) ->
  Tr.Trunc[(x : MM.Vec p) * VecIn m K q (\ j -> sub (y j) (MM.apply p q u x j))].carrier ;
 Kb (m : Nat) (J : Fin m -> R) (b : R) : Fin (suc m) -> R = TG.extend (Rg,setR) m J b ;

 -- ring identities
 sub-sum (x y w : R) : Id R (add (sub x y) (sub y w)) (sub x w) =
  trans (sym (addA x (neg y) (add y (neg w))))
   (ap (add x) (trans (addA (neg y) y (neg w)) (trans (ap (\ t -> add t (neg w)) (trans (addC (neg y) y) (addN y))) (L.zl (neg w))))) ;
 mul-sub (b x y : R) : Id R (mul b (sub x y)) (sub (mul b x) (mul b y)) =
  trans (dist b x (neg y)) (ap (add (mul b x)) (L.mul-neg b y)) ;
 ring-1 (A b B C : R) : Id R (add (sub A (mul b B)) (mul b (sub B C))) (sub A (mul b C)) =
  trans (ap (add (sub A (mul b B))) (mul-sub b B C)) (sub-sum A (mul b B) (mul b C)) ;
 zero-sub (x : R) : Id R (sub z x) (neg x) = L.zl (neg x) ;
 -- apply u (x - c y) = u x - c u y
 apply-sub (p q : Nat) (u : MM.Mat p q) (x y : MM.Vec p) (c : R) (j : Fin q) :
  Id R (MM.apply p q u (\ k -> sub (x k) (mul c (y k))) j) (sub (MM.apply p q u x j) (mul c (MM.apply p q u y j))) =
  trans (ap {MM.Vec p} (\ w -> MM.apply p q u w j)
          (WedgeStep[l].Over[Rg,setR,p].vec-ext p (\ k -> sub (x k) (mul c (y k))) (\ k -> add (x k) (mul (neg c) (y k)))
           (\ k -> ap (add (x k)) (sym (L.neg-mul-left c (y k))))))
   (trans (MM.apply-comb p q u x y (neg c) j) (ap (add (MM.apply p q u x j)) (L.neg-mul-left c (MM.apply p q u y j)))) ;
 -- K-vectors go to K-vectors
 apply-in (m : Nat) (K : Fin m -> R) (q l1 : Nat) (v : MM.Mat q l1) (y : MM.Vec q) (h : VecIn m K q y) :
  VecIn m K l1 (MM.apply q l1 v y) = \ i ->
  TI.in-sum m K q (\ j -> mul (y j) (v j i))
   (\ j -> RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,K].ideal].in-eq (mul (v j i) (y j)) (mul (y j) (v j i)) (mulC (v j i) (y j))
     (RegularIdeal[l].Generated[Rg,m,K].ideal.in-mul (v j i) (y j) (h j))) ;
 -- b x in J gives x in J, for b regular mod J
 regular (m : Nat) (J : Fin m -> R) (b : R) (rb : TG.RegEl (Rg,setR) m J b) (x : R) (h : In m J (mul b x)) : In m J x =
  rb x tt h ;
 -- a vector mod (J, b), as w with x - b w in J
 split-vec (m : Nat) (J : Fin m -> R) (b : R) (q : Nat) (y : MM.Vec q) (h : VecIn (suc m) (Kb m J b) q y) :
  Tr.Trunc[(w : MM.Vec q) * VecIn m J q (\ j -> sub (y j) (mul b (w j)))].carrier =
  TC.map ((j : Fin q) -> (w : R) * In m J (sub (y j) (mul b w))) ((w : MM.Vec q) * VecIn m J q (\ j -> sub (y j) (mul b (w j))))
   (\ f -> (\ j -> (f j).1,\ j -> (f j).2))
   (AffineFinite[l].choice q (\ j -> (w : R) * In m J (sub (y j) (mul b w))) (\ j -> TI.Plus[m,J,b].from (y j) (h j))) ;

 -- (inj)
 module Inj (m : Nat) (J : Fin m -> R) (b : R) (rb : TG.RegEl (Rg,setR) m J b)
  (p q l1 : Nat) (u : MM.Mat p q) (v : MM.Mat q l1)
  (inj : InjMod m J p q u) (cz : MM.ComposeZero p q l1 u v) (ex : ExactMod m J p q l1 u v)
  (x : MM.Vec p) (hx : VecIn (suc m) (Kb m J b) q (MM.apply p q u x)) (k : Fin p) {
  module W (w : MM.Vec q) (hw : VecIn m J q (\ j -> sub (MM.apply p q u x j) (mul b (w j)))) {
   vw (i : Fin l1) : In m J (MM.apply q l1 v w i) =
    regular m J b rb (MM.apply q l1 v w i)
     (RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-eq (neg (neg (mul b (MM.apply q l1 v w i)))) (mul b (MM.apply q l1 v w i)) (AG.neg-neg (mul b (MM.apply q l1 v w i)))
      (RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-neg (neg (mul b (MM.apply q l1 v w i)))
       (RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-eq (MM.apply q l1 v (\ j -> sub (MM.apply p q u x j) (mul b (w j))) i) (neg (mul b (MM.apply q l1 v w i)))
        (trans (apply-sub q l1 v (MM.apply p q u x) w b i)
         (trans (ap (\ t -> sub t (mul b (MM.apply q l1 v w i))) (MM.compose-zero p q l1 u v cz x i)) (zero-sub (mul b (MM.apply q l1 v w i)))))
        (apply-in m J q l1 v (\ j -> sub (MM.apply p q u x j) (mul b (w j))) hw i)))) ;
   module Y (y : MM.Vec p) (hy : VecIn m J q (\ j -> sub (w j) (MM.apply p q u y j))) {
    diff : VecIn m J q (MM.apply p q u (\ k1 -> sub (x k1) (mul b (y k1)))) = \ j ->
     RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-eq (add (sub (MM.apply p q u x j) (mul b (w j))) (mul b (sub (w j) (MM.apply p q u y j))))
      (MM.apply p q u (\ k1 -> sub (x k1) (mul b (y k1))) j)
      (trans (ring-1 (MM.apply p q u x j) b (w j) (MM.apply p q u y j)) (sym (apply-sub p q u x y b j)))
      (RegularIdeal[l].Generated[Rg,m,J].ideal.in-add (sub (MM.apply p q u x j) (mul b (w j))) (mul b (sub (w j) (MM.apply p q u y j))) (hw j)
       (RegularIdeal[l].Generated[Rg,m,J].ideal.in-mul b (sub (w j) (MM.apply p q u y j)) (hy j))) ;
    result : In (suc m) (Kb m J b) (x k) = TI.Plus[m,J,b].to (x k) (y k) (inj (\ k1 -> sub (x k1) (mul b (y k1))) diff k) ;
   } ;
   result : In (suc m) (Kb m J b) (x k) =
    Tr.Trunc[(y : MM.Vec p) * VecIn m J q (\ j -> sub (w j) (MM.apply p q u y j))].induction @l
     (\ t -> In (suc m) (Kb m J b) (x k)) (\ t -> TI.in-prop (suc m) (Kb m J b) (x k))
     (\ yy -> Y[yy.1,yy.2].result) (ex w vw) ;
  } ;
  result : In (suc m) (Kb m J b) (x k) =
   Tr.Trunc[(w : MM.Vec q) * VecIn m J q (\ j -> sub (MM.apply p q u x j) (mul b (w j)))].induction @l
    (\ t -> In (suc m) (Kb m J b) (x k)) (\ t -> TI.in-prop (suc m) (Kb m J b) (x k))
    (\ ww -> W[ww.1,ww.2].result) (split-vec m J b q (MM.apply p q u x) hx) ;
 } ;
 inj-step (m : Nat) (J : Fin m -> R) (b : R) (rb : TG.RegEl (Rg,setR) m J b)
  (p q l1 : Nat) (u : MM.Mat p q) (v : MM.Mat q l1)
  (inj : InjMod m J p q u) (cz : MM.ComposeZero p q l1 u v) (ex : ExactMod m J p q l1 u v) :
  InjMod (suc m) (Kb m J b) p q u = \ x hx k -> Inj[m,J,b,rb,p,q,l1,u,v,inj,cz,ex,x,hx,k].result ;

 -- (exact)
 module Ex (m : Nat) (J : Fin m -> R) (b : R) (rb : TG.RegEl (Rg,setR) m J b)
  (p q l1 l2 : Nat) (u : MM.Mat p q) (v : MM.Mat q l1) (w : MM.Mat l1 l2)
  (ex1 : ExactMod m J p q l1 u v) (ex2 : ExactMod m J q l1 l2 v w) (cz : MM.ComposeZero q l1 l2 v w)
  (y : MM.Vec q) (hy : VecIn (suc m) (Kb m J b) l1 (MM.apply q l1 v y)) {
  Goal : U l = (x : MM.Vec p) * VecIn (suc m) (Kb m J b) q (\ j -> sub (y j) (MM.apply p q u x j)) ;
  module Z (zz : MM.Vec l1) (hz : VecIn m J l1 (\ i -> sub (MM.apply q l1 v y i) (mul b (zz i)))) {
   wz (i : Fin l2) : In m J (MM.apply l1 l2 w zz i) =
    regular m J b rb (MM.apply l1 l2 w zz i)
     (RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-eq (neg (neg (mul b (MM.apply l1 l2 w zz i)))) (mul b (MM.apply l1 l2 w zz i)) (AG.neg-neg (mul b (MM.apply l1 l2 w zz i)))
      (RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-neg (neg (mul b (MM.apply l1 l2 w zz i)))
       (RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-eq (MM.apply l1 l2 w (\ j -> sub (MM.apply q l1 v y j) (mul b (zz j))) i) (neg (mul b (MM.apply l1 l2 w zz i)))
        (trans (apply-sub l1 l2 w (MM.apply q l1 v y) zz b i)
         (trans (ap (\ t -> sub t (mul b (MM.apply l1 l2 w zz i))) (MM.compose-zero q l1 l2 v w cz y i)) (zero-sub (mul b (MM.apply l1 l2 w zz i)))))
        (apply-in m J l1 l2 w (\ j -> sub (MM.apply q l1 v y j) (mul b (zz j))) hz i)))) ;
   module T (t : MM.Vec q) (ht : VecIn m J l1 (\ i -> sub (zz i) (MM.apply q l1 v t i))) {
    yt : MM.Vec q = \ j -> sub (y j) (mul b (t j)) ;
    vyt : VecIn m J l1 (MM.apply q l1 v yt) = \ i ->
     RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-eq (add (sub (MM.apply q l1 v y i) (mul b (zz i))) (mul b (sub (zz i) (MM.apply q l1 v t i))))
      (MM.apply q l1 v yt i)
      (trans (ring-1 (MM.apply q l1 v y i) b (zz i) (MM.apply q l1 v t i)) (sym (apply-sub q l1 v y t b i)))
      (RegularIdeal[l].Generated[Rg,m,J].ideal.in-add (sub (MM.apply q l1 v y i) (mul b (zz i))) (mul b (sub (zz i) (MM.apply q l1 v t i))) (hz i)
       (RegularIdeal[l].Generated[Rg,m,J].ideal.in-mul b (sub (zz i) (MM.apply q l1 v t i)) (ht i))) ;
    lift (xx : (x : MM.Vec p) * VecIn m J q (\ j -> sub (yt j) (MM.apply p q u x j))) : Goal =
     (xx.1,\ j -> TI.Plus[m,J,b].to (sub (y j) (MM.apply p q u xx.1 j)) (t j)
       (RegularIdeal[l].IdealLaws[Rg,RegularIdeal[l].Generated[Rg,m,J].ideal].in-eq (sub (sub (y j) (mul b (t j))) (MM.apply p q u xx.1 j)) (sub (sub (y j) (MM.apply p q u xx.1 j)) (mul b (t j)))
        (TI.sub-sub (y j) (mul b (t j)) (MM.apply p q u xx.1 j)) (xx.2 j))) ;
    result : Tr.Trunc[Goal].carrier =
     TC.map ((x : MM.Vec p) * VecIn m J q (\ j -> sub (yt j) (MM.apply p q u x j))) Goal lift (ex1 yt vyt) ;
   } ;
   result : Tr.Trunc[Goal].carrier =
    TC.bind ((t : MM.Vec q) * VecIn m J l1 (\ i -> sub (zz i) (MM.apply q l1 v t i))) Goal (\ tt1 -> T[tt1.1,tt1.2].result) (ex2 zz wz) ;
  } ;
  result : Tr.Trunc[Goal].carrier =
   TC.bind ((zz : MM.Vec l1) * VecIn m J l1 (\ i -> sub (MM.apply q l1 v y i) (mul b (zz i)))) Goal
    (\ z1 -> Z[z1.1,z1.2].result) (split-vec m J b l1 (MM.apply q l1 v y) hy) ;
 } ;
 exact-step (m : Nat) (J : Fin m -> R) (b : R) (rb : TG.RegEl (Rg,setR) m J b)
  (p q l1 l2 : Nat) (u : MM.Mat p q) (v : MM.Mat q l1) (w : MM.Mat l1 l2)
  (ex1 : ExactMod m J p q l1 u v) (ex2 : ExactMod m J q l1 l2 v w) (cz : MM.ComposeZero q l1 l2 v w) :
  ExactMod (suc m) (Kb m J b) p q l1 u v = \ y hy -> Ex[m,J,b,rb,p,q,l1,l2,u,v,w,ex1,ex2,cz,y,hy].result ;
} ;
