-- cffr Theorem 6.8, first part: the ranks along a finite free resolution,
-- top first (the layout of Thm68): R^q0 -v-> R^(s 0) -T 0-> R^(s 1) -> ...
-- -T (k-1)-> R^(s k), exact at R^(s 0), ..., R^(s (k-1)).
-- If v is stable of rank n then either 1 = 0, or there are ranks r with
-- s 0 = r 0 + n, s (i+1) = r (i+1) + r i, and T i stable of rank r i.
-- Induction on k, removing the top map: if n <= s 0, write s 0 = n + r0;
-- Lemma 4.3 makes T 0 stable of rank r0, and the complex starting with T 0
-- gives the other ranks; if n > s 0, the n-products of vectors of R^(s 0)
-- vanish while D_n(v) is regular: 1 = 0.  For a resolution the top u is
-- injective, hence stable of rank p (Theorem 2.4).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module TG = TrueGrade[l] ;
module Compare (n q : Nat) (c : Plus ((r : Nat) * Id Nat q (plus n r)) ((d : Nat) * Id Nat n (plus q (suc d)))) {
 up : Plus ((r : Nat) * Id Nat q (plus n r)) ((d : Nat) * Id Nat n (plus q (suc d))) ->
  Plus ((r : Nat) * Id Nat (suc q) (plus (suc n) r)) ((d : Nat) * Id Nat (suc n) (plus (suc q) (suc d))) = split {
  inl w -> inl (w.1,ap (\ k -> suc k) w.2) ;
  inr w -> inr (w.1,ap (\ k -> suc k) w.2) } ;
 result : Plus ((r : Nat) * Id Nat (suc q) (plus (suc n) r)) ((d : Nat) * Id Nat (suc n) (plus (suc q) (suc d))) = up c ;
} ;
-- n <= q (q = n + r) or n > q (n = q + 1 + d)
compare : (n q : Nat) -> Plus ((r : Nat) * Id Nat q (plus n r)) ((d : Nat) * Id Nat n (plus q (suc d))) = split {
 zero -> \ q -> inl (q,refl q) ;
 suc n | ih -> split {
  zero -> inr (n,refl (suc n)) ;
  suc q -> Compare[n,q,ih q].result } } ;

Mat (D : TG.RD) (p q : Nat) : U l = Matrices[l].Over[D.1].Mat p q ;
-- the complex v, T 0, ..., T (k-1): composites 0 and exact
Pairs (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (u : Mat D p (s zero)) (T : (i : Nat) -> Mat D (s i) (s (suc i))) : U l =
 ((d : Nat) -> Id Nat k (suc d) ->
  Matrices[l].Over[D.1].ComposeZero p (s zero) (s (suc zero)) u (T zero) *
  Matrices[l].Over[D.1].Exact p (s zero) (s (suc zero)) u (T zero)) *
 ((i d : Nat) -> Id Nat k (plus (suc (suc i)) d) ->
  Matrices[l].Over[D.1].ComposeZero (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) *
  Matrices[l].Over[D.1].Exact (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i))) ;
Ranks (k p : Nat) (s r : Nat -> Nat) : U l =
 ((d : Nat) -> Id Nat k (suc d) -> Id Nat (s zero) (plus (r zero) p)) *
 ((i d : Nat) -> Id Nat k (plus (suc (suc i)) d) -> Id Nat (s (suc i)) (plus (r (suc i)) (r i))) ;
-- stable of rank n, in the image form
Stable (D : TG.RD) (n p q : Nat) (u : Mat D p q) : U l =
 MinorForms[l].Over[D.1,D.2].ImageVanish (suc n) p q u * MinorForms[l].Over[D.1,D.2].ImageRegular n p q u ;
Stables (D : TG.RD) (k : Nat) (s r : Nat -> Nat) (T : (i : Nat) -> Mat D (s i) (s (suc i))) : U l =
 (i d : Nat) -> Id Nat k (plus (suc i) d) -> Stable D (r i) (s i) (s (suc i)) (T i) ;
Result (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (T : (i : Nat) -> Mat D (s i) (s (suc i))) : U l =
 Plus (Id D.1.R D.1.o D.1.z) ((r : Nat -> Nat) * Ranks k p s r * Stables D k s r T) ;

-- n vectors of R^q with n > q have product 0, so D_n regular forces 1 = 0
too-big (D : TG.RD) (n p q d : Nat) (e : Id Nat n (plus q (suc d))) (u : Mat D p q)
 (h : MinorForms[l].Over[D.1,D.2].ImageRegular n p q u) : Id D.1.R D.1.o D.1.z =
 h D.1.o (subst (\ k -> MinorKill[l].Over[D.1,D.2].ImageKilled k p q u D.1.o) (sym e) (\ C ->
  trans (ExteriorAlgebra[l].Over[D.1,D.2].escale-one q (Matrices[l].Over[D.1].wedge (plus q (suc d)) q (MinorKill[l].Over[D.1,D.2].compose (plus q (suc d)) p q u C)))
   (ExteriorDegree[l].Over[D.1,D.2].deg-high q d (Matrices[l].Over[D.1].wedge (plus q (suc d)) q (MinorKill[l].Over[D.1,D.2].compose (plus q (suc d)) p q u C))
    (ExteriorDegree[l].Over[D.1,D.2].deg-eprod q (plus q (suc d))
     (\ t -> ExteriorModel[l].Over[D.1].gen q (Matrices[l].Over[D.1].apply p q u (C t)))
     (\ t -> ExteriorDegree[l].Over[D.1,D.2].deg-gen q (Matrices[l].Over[D.1].apply p q u (C t))))))) ;

Claim (k : Nat) : U l+ =
 (D : TG.RD) (p n : Nat) (s : Nat -> Nat) (v : Mat D p (s zero)) (T : (i : Nat) -> Mat D (s i) (s (suc i))) ->
 Stable D n p (s zero) v -> Pairs D k p s v T -> Result D k n s T ;
module Step (k : Nat) (ih : Claim k) (D : TG.RD) (p n : Nat) (s : Nat -> Nat) (v : Mat D p (s zero))
 (T : (i : Nat) -> Mat D (s i) (s (suc i))) (st : Stable D n p (s zero) v) (pr : Pairs D (suc k) p s v T) {
 module Fits (r0 : Nat) (e : Id Nat (s zero) (plus n r0)) {
  st0 : Stable D r0 (s zero) (s (suc zero)) (T zero) =
   Lemma43[l].Over[p,s zero].lemma43 n D.1 D.2 (s (suc zero)) r0 e v (T zero)
    (pr.1 k (refl (suc k))).1 (pr.1 k (refl (suc k))).2 st.1 st.2 ;
  pairs' : Pairs D k (s zero) (\ i -> s (suc i)) (T zero) (\ i -> T (suc i)) =
   (\ d e1 -> pr.2 zero d (ap (\ j -> suc j) e1),\ i d e1 -> pr.2 (suc i) d (ap (\ j -> suc j) e1)) ;
  module Lift (w : (r : Nat -> Nat) * Ranks k r0 (\ i -> s (suc i)) r * Stables D k (\ i -> s (suc i)) r (\ i -> T (suc i))) {
   r : Nat -> Nat = split { zero -> r0 ; suc i -> w.1 i } ;
   eqs2 : (i d : Nat) -> Id Nat (suc k) (plus (suc (suc i)) d) -> Id Nat (s (suc i)) (plus (r (suc i)) (r i)) = split {
    zero -> \ d e1 -> w.2.1.1 d (suc-inj e1) ;
    suc i -> \ d e1 -> w.2.1.2 i d (suc-inj e1) } ;
   stables : (i d : Nat) -> Id Nat (suc k) (plus (suc i) d) -> Stable D (r i) (s i) (s (suc i)) (T i) = split {
    zero -> \ d e1 -> st0 ;
    suc i -> \ d e1 -> w.2.2 i d (suc-inj e1) } ;
   result : (r : Nat -> Nat) * Ranks (suc k) n s r * Stables D (suc k) s r T =
    (r,(\ d e1 -> trans e (plus-comm n r0),eqs2),stables) ;
  } ;
  lift : Result D k r0 (\ i -> s (suc i)) (\ i -> T (suc i)) -> Result D (suc k) n s T = split {
   inl t -> inl t ;
   inr w -> inr (Lift[w].result) } ;
  result : Result D (suc k) n s T = lift (ih D (s zero) r0 (\ i -> s (suc i)) (T zero) (\ i -> T (suc i)) st0 pairs') ;
 } ;
 pick : Plus ((r : Nat) * Id Nat (s zero) (plus n r)) ((d : Nat) * Id Nat n (plus (s zero) (suc d))) -> Result D (suc k) n s T = split {
  inl w -> Fits[w.1,w.2].result ;
  inr w -> inl (too-big D n p (s zero) w.1 w.2 v st.2) } ;
 result : Result D (suc k) n s T = pick (compare n (s zero)) ;
} ;
ranks-from : (k : Nat) -> Claim k = split {
 zero -> \ D p n s v T st pr -> inr (\ i -> zero,(\ d e -> efq (zero-suc d e),\ i d e -> efq (zero-suc (plus (suc i) d) e)),
   \ i d e -> efq (zero-suc (plus i d) e)) ;
 suc k | ih -> \ D p n s v T st pr -> Step[k,ih,D,p,n,s,v,T,st,pr].result } ;
-- a resolution: the top u is injective, stable of rank p (Theorem 2.4)
ranks (k : Nat) (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : Mat D p (s zero)) (T : (i : Nat) -> Mat D (s i) (s (suc i)))
 (inj : Matrices[l].Over[D.1].Injective p (s zero) u) (pr : Pairs D k p s u T) : Result D k p s T =
 ranks-from k D p p s u T
  (MinorForms[l].Over[D.1,D.2].vanish-to-image (suc p) p (s zero) u (Minors[l].Over[D.1,D.2].theorem24 p (s zero) u inj).1,
   MinorForms[l].Over[D.1,D.2].regular-to-image p p (s zero) u (Minors[l].Over[D.1,D.2].theorem24 p (s zero) u inj).2) pr ;
