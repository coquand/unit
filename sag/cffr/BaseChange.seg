-- Change of rings for the exterior model: a ring map f : R -> L gives
--   B : Ext_R n -> Ext_L n ,  B_0 = f ,  B_{n+1} (w0, w1) = (B w0, B w1),
-- i.e. f applied to every coefficient.  By induction on n, B preserves
-- zero, addition, negation, scaling (B (c x) = f(c) B x), the scalars emb
-- and the grade involution, hence the product (whose clause is built from
-- these), the generators (B (gen v) = gen (f o v)), the products of
-- generators, and the coefficients (coeff (B x) I = f (coeff x I)).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg Lg : CRing) (h : RingHom[l].Hom Rg Lg) {
 module M = ExteriorModel[l].Over[Rg] ;
 module N = ExteriorModel[l].Over[Lg] ;
 f (a : Rg.R) : Lg.R = h.1 a ;
 f-one : Id Lg.R (f Rg.o) Lg.o = h.2.1 ;
 f-add (a b : Rg.R) : Id Lg.R (f (Rg.add a b)) (Lg.add (f a) (f b)) = h.2.2.1 a b ;
 f-mul (a b : Rg.R) : Id Lg.R (f (Rg.mul a b)) (Lg.mul (f a) (f b)) = h.2.2.2 a b ;
 f-zero : Id Lg.R (f Rg.z) Lg.z = RingHom[l].zero Rg Lg h ;
 f-neg (a : Rg.R) : Id Lg.R (f (Rg.neg a)) (Lg.neg (f a)) = RingHom[l].negation Rg Lg h a ;
 pair {A : U l} {x x' y y' : A} (p : Id A x x') (q : Id A y y') : Id (A * A) (x,y) (x',y') =
  ExteriorAlgebra[l].pair-eq p q ;

 B : (n : Nat) -> M.Ext n -> N.Ext n = split {
  zero -> f ; suc n | r -> \ u -> (r u.1,r u.2) } ;

 B-zero : (n : Nat) -> Id (N.Ext n) (B n (M.ezero n)) (N.ezero n) = split {
  zero -> f-zero ; suc n | r -> pair r r } ;
 B-add : (n : Nat) (x y : M.Ext n) -> Id (N.Ext n) (B n (M.eadd n x y)) (N.eadd n (B n x) (B n y)) = split {
  zero -> f-add ; suc n | r -> \ x y -> pair (r x.1 y.1) (r x.2 y.2) } ;
 B-neg : (n : Nat) (x : M.Ext n) -> Id (N.Ext n) (B n (M.eneg n x)) (N.eneg n (B n x)) = split {
  zero -> f-neg ; suc n | r -> \ x -> pair (r x.1) (r x.2) } ;
 B-scale : (n : Nat) (c : Rg.R) (x : M.Ext n) -> Id (N.Ext n) (B n (M.escale n c x)) (N.escale n (f c) (B n x)) = split {
  zero -> f-mul ; suc n | r -> \ c x -> pair (r c x.1) (r c x.2) } ;
 B-emb : (n : Nat) (c : Rg.R) -> Id (N.Ext n) (B n (M.emb n c)) (N.emb n (f c)) = split {
  zero -> \ c -> refl (f c) ; suc n | r -> \ c -> pair (r c) (B-zero n) } ;
 B-one (n : Nat) : Id (N.Ext n) (B n (M.eone n)) (N.eone n) = trans (B-emb n Rg.o) (ap (N.emb n) f-one) ;
 B-alpha : (n : Nat) (x : M.Ext n) -> Id (N.Ext n) (B n (M.alpha n x)) (N.alpha n (B n x)) = split {
  zero -> \ x -> refl (f x) ;
  suc n | r -> \ x -> pair (r x.1) (trans (B-neg n (M.alpha n x.2)) (ap (N.eneg n) (r x.2))) } ;
 B-mul : (n : Nat) (x y : M.Ext n) -> Id (N.Ext n) (B n (M.emul n x y)) (N.emul n (B n x) (B n y)) = split {
  zero -> f-mul ;
  suc n | r -> \ x y -> pair (r x.1 y.1)
   (calc (N.Ext n) { B n (M.eadd n (M.emul n x.1 y.2) (M.emul n x.2 (M.alpha n y.1)))
    =< B-add n (M.emul n x.1 y.2) (M.emul n x.2 (M.alpha n y.1))
    > N.eadd n (B n (M.emul n x.1 y.2)) (B n (M.emul n x.2 (M.alpha n y.1)))
    =< ap (\ t -> N.eadd n t (B n (M.emul n x.2 (M.alpha n y.1)))) (r x.1 y.2)
    > N.eadd n (N.emul n (B n x.1) (B n y.2)) (B n (M.emul n x.2 (M.alpha n y.1)))
    =< ap (N.eadd n (N.emul n (B n x.1) (B n y.2)))
        (trans (r x.2 (M.alpha n y.1)) (ap (N.emul n (B n x.2)) (B-alpha n y.1)))
    > N.eadd n (N.emul n (B n x.1) (B n y.2)) (N.emul n (B n x.2) (N.alpha n (B n y.1))) }) } ;
 B-gen : (n : Nat) (v : Ps.Fin n -> Rg.R) -> Id (N.Ext n) (B n (M.gen n v)) (N.gen n (\ k -> f (v k))) = split {
  zero -> \ v -> f-zero ;
  suc n | r -> \ v -> pair (r (\ k -> v (inl k))) (B-emb n (v (inr tt))) } ;
 B-eprod (n : Nat) : (m : Nat) (u : Ps.Fin m -> M.Ext n) ->
  Id (N.Ext n) (B n (M.eprod n m u)) (N.eprod n m (\ k -> B n (u k))) = split {
  zero -> \ u -> B-one n ;
  suc m | r -> \ u -> trans (B-mul n (M.eprod n m (\ k -> u (inl k))) (u (inr tt)))
   (ap (\ t -> N.emul n t (B n (u (inr tt)))) (r (\ k -> u (inl k)))) } ;
 -- the wedge of the columns
 B-wedge (q m : Nat) (u : Ps.Fin m -> Ps.Fin q -> Rg.R) :
  Id (N.Ext q) (B q (Matrices[l].Over[Rg].wedge m q u)) (N.eprod q m (\ k -> N.gen q (\ i -> f (u k i)))) =
  trans (B-eprod q m (\ k -> M.gen q (u k)))
   (ap (N.eprod q m) (F.funext (Ps.Fin m) (\ k -> N.Ext q) (\ k -> B q (M.gen q (u k)))
     (\ k -> N.gen q (\ i -> f (u k i))) (\ k -> B-gen q (u k)))) ;
} ;
