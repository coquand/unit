-- The matrix B' = (B ; lambda) : L^q -> L^(l+1) (B with the extra row lambda),
-- for B a = 0 and lambda . a = 1.  In the exterior algebra of L^(l+1) an
-- element is a pair (w0, w1) = w0 + w1 e (ExteriorModel), e the new basis
-- vector, and the generator of (v, s) is (i(v), s).
-- (=) The first component of a product of generators of vectors of im B' is
--     the product of the corresponding vectors of im B (first-wedge).
-- (down) If x kills every product of k+1 vectors of im B', x kills every
--     product P of k vectors of im B: B' a = e = (0, 1), and the second
--     component of P' i(e) is P (P' the product over im B').
-- (up) If x kills every product of k vectors of im B, x kills every product
--     of k+1 vectors of im B': im B' lies in V + L e with V = {(v, 0) :
--     v in im B} = im M, M = (B ; 0), the products over V are (P, 0), and
--     Splitting applies with lambda' = the last coordinate form.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Lg : CRing) (setL : Pr.isSet Lg.R) (q l1 : Nat) (B : Matrices[l].Over[Lg].Mat q l1)
 (lam : Matrices[l].Over[Lg].Vec q) {
 open Lg ; module L = RL[Lg] ;
 open ExteriorModel[l].Over[Lg] ;
 module MM = Matrices[l].Over[Lg] ;
 module MK = MinorKill[l].Over[Lg,setL] ;
 module EA = ExteriorAlgebra[l].Over[Lg,setL] ;
 module WS = WedgeStep[l].Over[Lg,setL,suc l1] ;
 module AL1 = Alternating[l].Over[Lg,setL].In[EA.algebra l1] ;
 ext (v : MM.Vec l1) (s : R) : MM.Vec (suc l1) = split { inl j -> v j ; inr t -> s } ;
 B' : MM.Mat q (suc l1) = \ i -> ext (B i) (lam i) ;
 M : MM.Mat q (suc l1) = \ i -> ext (B i) z ;
 e1 : MM.Vec (suc l1) = ext (\ j -> z) o ;

 emb-zero : (n : Nat) -> Id (Ext n) (emb n z) (ezero n) = split {
  zero -> refl z ; suc n | r -> ExteriorAlgebra[l].pair-eq r (refl (ezero n)) } ;
 gen-zero : (n : Nat) -> Id (Ext n) (gen n (\ j -> z)) (ezero n) = split {
  zero -> refl z ; suc n | r -> ExteriorAlgebra[l].pair-eq r (emb-zero n) } ;

 sum-mul-zero (v : MM.Vec q) : Id R (MM.S.sum q (\ i -> mul (v i) z)) z =
  trans (MM.S.sum-cong q (\ i -> mul (v i) z) (\ i -> z) (\ i -> L.mul-zero (v i))) (MM.S.sum-zero q) ;
 -- (=)
 first-wedge : (m : Nat) (C : MM.Mat m q) ->
  Id (Ext l1) (MM.wedge m (suc l1) (MK.compose m q (suc l1) B' C)).1 (MM.wedge m l1 (MK.compose m q l1 B C)) = split {
  zero -> \ C -> refl (eone l1) ;
  suc m | r -> \ C -> ap (\ y -> emul l1 y (gen l1 (MM.apply q l1 B (C (inr tt))))) (r (\ t -> C (inl t))) } ;

 -- (down)
 module DownEq (a : MM.Vec q) (ba : (j : Fin l1) -> Id R (MM.apply q l1 B a j) z)
  (one : Id R (MM.apply q (suc l1) B' a (inr tt)) o) (m : Nat) (C : MM.Mat m q) {
  y : Ext (suc l1) = MM.wedge m (suc l1) (MK.compose m q (suc l1) B' C) ;
  g0-zero : Id (Ext l1) (gen l1 (\ j -> MM.apply q l1 B a j)) (ezero l1) =
   trans (ap (gen l1) (WedgeStep[l].Over[Lg,setL,l1].vec-ext l1 (\ j -> MM.apply q l1 B a j) (\ j -> z) ba)) (gen-zero l1) ;
  second : Id (Ext l1)
   (eadd l1 (emul l1 y.1 (emb l1 (MM.apply q (suc l1) B' a (inr tt)))) (emul l1 y.2 (alpha l1 (gen l1 (\ j -> MM.apply q l1 B a j)))))
   (MM.wedge m l1 (MK.compose m q l1 B C)) =
   calc (Ext l1) { eadd l1 (emul l1 y.1 (emb l1 (MM.apply q (suc l1) B' a (inr tt)))) (emul l1 y.2 (alpha l1 (gen l1 (\ j -> MM.apply q l1 B a j))))
    =< EA.At[l1].G.cong-add
        (trans (EA.mul-emb l1 y.1 (MM.apply q (suc l1) B' a (inr tt)))
         (trans (ap (\ s -> escale l1 s y.1) one) (EA.escale-one l1 y.1)))
        (trans (ap (\ w -> emul l1 y.2 (alpha l1 w)) g0-zero)
         (trans (ap (emul l1 y.2) (EA.alpha-zero l1)) (EA.mul-zero-r l1 y.2)))
    > eadd l1 y.1 (ezero l1)
    =< EA.eaddZ l1 y.1 > y.1
    =< first-wedge m C > MM.wedge m l1 (MK.compose m q l1 B C) } ;
 } ;
 module Down (a : MM.Vec q) (ba : (j : Fin l1) -> Id R (MM.apply q l1 B a j) z)
  (one : Id R (MM.apply q (suc l1) B' a (inr tt)) o) (x : R) (m : Nat) (C : MM.Mat m q)
  (h : MK.KillsW (suc l1) x (MM.wedge (suc m) (suc l1) (MK.compose (suc m) q (suc l1) B' (CommonPower[l].extend (MM.Vec q) m C a)))) {
  result : MK.KillsW l1 x (MM.wedge m l1 (MK.compose m q l1 B C)) =
   trans (ap (escale l1 x) (sym DownEq[a,ba,one,m,C].second)) (ap (\ w -> w.2) h) ;
 } ;

 -- (up)
 iota-wedge : (m : Nat) (C : MM.Mat m q) ->
  Id (Ext (suc l1)) (MM.wedge m (suc l1) (MK.compose m q (suc l1) M C)) (MM.wedge m l1 (MK.compose m q l1 B C),ezero l1) = split {
  zero -> \ C -> refl (eone (suc l1)) ;
  suc m | r -> \ C ->
   trans (ap (\ y -> emul (suc l1) y (gen (suc l1) (MM.apply q (suc l1) M (C (inr tt))))) (r (\ t -> C (inl t))))
    (ExteriorAlgebra[l].pair-eq (refl (emul l1 (MM.wedge m l1 (MK.compose m q l1 B (\ t -> C (inl t)))) (gen l1 (MM.apply q l1 B (C (inr tt))))))
     (calc (Ext l1) {
       eadd l1 (emul l1 (MM.wedge m l1 (MK.compose m q l1 B (\ t -> C (inl t)))) (emb l1 (MM.apply q (suc l1) M (C (inr tt)) (inr tt))))
        (emul l1 (ezero l1) (alpha l1 (gen l1 (MM.apply q l1 B (C (inr tt))))))
       =< EA.At[l1].G.cong-add
           (trans (EA.mul-emb l1 (MM.wedge m l1 (MK.compose m q l1 B (\ t -> C (inl t)))) (MM.apply q (suc l1) M (C (inr tt)) (inr tt)))
            (trans (ap (\ s -> escale l1 s (MM.wedge m l1 (MK.compose m q l1 B (\ t -> C (inl t)))))
                     (sum-mul-zero (C (inr tt))))
             (AL1.scale-zero-l (MM.wedge m l1 (MK.compose m q l1 B (\ t -> C (inl t)))))))
           (EA.mul-zero-l l1 (alpha l1 (gen l1 (MM.apply q l1 B (C (inr tt))))))
       > eadd l1 (ezero l1) (ezero l1)
       =< EA.eaddZ l1 (ezero l1) > ezero l1 })) } ;
 lam' : MM.Vec (suc l1) = WS.sdelta (suc l1) o (inr tt) ;
 orth (y : MM.Vec q) : Id R (WS.VC.vdot (suc l1) lam' (MM.apply q (suc l1) M y)) z =
  trans (WS.vdot-delta (suc l1) o (inr tt) (MM.apply q (suc l1) M y))
   (trans (L.one-left (MM.apply q (suc l1) M y (inr tt)))
    (sum-mul-zero y)) ;
 one' : Id R (WS.VC.vdot (suc l1) lam' e1) o = trans (WS.vdot-delta (suc l1) o (inr tt) e1) (mulO o) ;
 -- (up), for products with coefficients in an ideal I
 module UpIn (I : RegularIdeal[l].IdealPred[Lg]) (m : Nat)
  (h : (C1 : MM.Mat m q) -> IdealExt[l].Over[Lg,setL,I].InCoeff l1 (MM.wedge m l1 (MK.compose m q l1 B C1))) {
  module IE = IdealExt[l].Over[Lg,setL,I] ;
  module SP = Splitting[l].Over[Lg,setL,q,suc l1,lam',e1,one',M,orth,I] ;
  hyp (C1 : MM.Mat m q) : IE.InCoeff (suc l1) (MM.wedge m (suc l1) (MK.compose m q (suc l1) M C1)) =
   IE.in-eq (suc l1) (MM.wedge m l1 (MK.compose m q l1 B C1),ezero l1) (MM.wedge m (suc l1) (MK.compose m q (suc l1) M C1))
    (sym (iota-wedge m C1)) (IE.in-pair l1 _ _ (h C1) (IE.in-zero l1)) ;
  -- the vectors of im B' are M y + s e
  as-vec-at (y : MM.Vec q) : (j : Fin (suc l1)) ->
   Id R (SP.vec y (MM.apply q (suc l1) B' y (inr tt)) j) (MM.apply q (suc l1) B' y j) = split {
   inl j -> trans (ap (add (MM.apply q (suc l1) M y (inl j))) (L.mul-zero (MM.apply q (suc l1) B' y (inr tt))))
            (addZ (MM.apply q (suc l1) M y (inl j))) ;
   inr t -> trans (ap (\ w -> add (MM.apply q (suc l1) M y (inr w)) (mul (MM.apply q (suc l1) B' y (inr tt)) (e1 (inr w)))) (MnSums[l].top-eq t tt))
            (trans (WS.AR.cong-add (sum-mul-zero y)
                                   (mulO (MM.apply q (suc l1) B' y (inr tt))))
             (trans (L.zl (MM.apply q (suc l1) B' y (inr tt)))
              (ap (\ w -> MM.apply q (suc l1) B' y (inr w)) (MnSums[l].top-eq tt t)))) } ;
  as-vec (y : MM.Vec q) : Id (MM.Vec (suc l1)) (SP.vec y (MM.apply q (suc l1) B' y (inr tt))) (MM.apply q (suc l1) B' y) =
   WS.vec-ext (suc l1) (SP.vec y (MM.apply q (suc l1) B' y (inr tt))) (MM.apply q (suc l1) B' y) (as-vec-at y) ;
  result (C : MM.Mat (suc m) q) : IE.InCoeff (suc l1) (MM.wedge (suc m) (suc l1) (MK.compose (suc m) q (suc l1) B' C)) =
   subst (\ v -> IE.InCoeff (suc l1) (MM.wedge (suc m) (suc l1) v))
    (F.funext (Fin (suc m)) (\ t -> MM.Vec (suc l1)) (SP.vecs (suc m) C (\ t -> MM.apply q (suc l1) B' (C t) (inr tt)))
      (MK.compose (suc m) q (suc l1) B' C) (\ t -> as-vec (C t)))
    (SP.splitting m hyp C (\ t -> MM.apply q (suc l1) B' (C t) (inr tt))) ;
 } ;
 -- (up) for "x kills": I = Ann(x)
 module Up (x : R) (m : Nat) (h : MK.ImageKilled m q l1 B x) {
  module UI = UpIn[IdealExt[l].annihilator Lg x,m,\ C1 -> MK.to-coeff l1 x (MM.wedge m l1 (MK.compose m q l1 B C1)) (h C1)] ;
  result : MK.ImageKilled (suc m) q (suc l1) B' x = \ C ->
   MK.from-coeff (suc l1) x (MM.wedge (suc m) (suc l1) (MK.compose (suc m) q (suc l1) B' C)) (UI.result C) ;
 } ;
} ;
