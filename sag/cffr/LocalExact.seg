-- Passing to L = R[1/c] (k : R -> L the inclusion):
-- * coefficients of the exterior model commute with k (coeff-B);
-- * a regular family d over an index type with common exponents (CommonPower)
--   stays regular in L: if k(d_i) x = 0 with s x = k(m) (s a power of c),
--   then k(d_i m) = 0, so one power t of c has t d_i m = 0 for all i; d is
--   regular, so t m = 0, hence k(m) = 0 and x = 0 (t, s units);
-- * B A = 0 stays B A = 0 (sums commute with k);
-- * exactness ker B = im A stays exact: for B y = 0 in L, clear the
--   denominators (s y = k(Y)), a power t of c kills B Y, so t Y = A X, and
--   y = A (u k(X)) with u the inverse of k(t s).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (c : Rg.R) {
 open Rg ;
 module FL = Flat[l].Over[Rg,c] ;
 module I = FL.I ; module Bm = FL.Bm ;
 setL : Pr.isSet I.ring.R = Bm.set ;
 k (a : R) : I.ring.R = FL.k a ;
 module MR = Matrices[l].Over[Rg] ; module ML = Matrices[l].Over[I.ring] ;
 module SR = FiniteIdeal[l].Sums[Rg] ; module SL = FiniteIdeal[l].Sums[I.ring] ;
 module RIR = RegularIdeal[l].Over[Rg,RegularIdeal[l].self Rg] ;
 module RIL = RegularIdeal[l].Over[I.ring,RegularIdeal[l].self I.ring] ;
 module BC = BaseChange[l].Over[Rg,I.ring,I.inclusion] ;
 module ECR = ExteriorCoordinates[l].Over[Rg,setR] ;
 module ECL = ExteriorCoordinates[l].Over[I.ring,setL] ;
 module KS = StandardOpens[l].SumMap[Rg,I.ring,I.inclusion] ;
 power (e : Nat) : R = FL.power e ;

 -- coefficients
 coeff-B : (n : Nat) (y : ExteriorModel[l].Over[Rg].Ext n) (J : ExteriorCoordinates[l].Index n) ->
  Id I.ring.R (ECL.coeff n (BC.B n y) J) (k (ECR.coeff n y J)) = split {
  zero -> \ y J -> refl (k y) ;
  suc n | r -> \ y -> split { inl J -> r y.1 J ; inr J -> r y.2 J } } ;

 -- regularity
 Killed (d : R) (m : R) (e : Nat) : U l = Id R (mul (power e) (mul d m)) z ;
 killed-mono (X : U l) (d : X -> R) (m : R) : CommonPower[l].Monotone X (\ i -> Killed (d i) m) =
  \ i e e1 h -> calc R { mul (power (plus e e1)) (mul (d i) m)
   =< ap (\ t -> mul t (mul (d i) m)) (trans (I.Pow.power-add c e e1) (mulC (power e) (power e1)))
   > mul (mul (power e1) (power e)) (mul (d i) m)
   =< sym (mulA (power e1) (power e) (mul (d i) m)) > mul (power e1) (mul (power e) (mul (d i) m))
   =< ap (mul (power e1)) h > mul (power e1) z
   =< RL[Rg].mul-zero (power e1) > z } ;
 module Regular (X : U l) (cx : CommonPower[l].Common X) (d : X -> R) (reg : RIR.Regular X d)
  (x : I.ring.R) (h : RIL.ZeroOn X (\ i -> k (d i)) x) {
  module Given (f : Bm.Raw.Fraction) (e : Id I.ring.R (Bm.include f) x) {
   m : R = f.1 ; s : R = f.2.1 ;
   sx : Id I.ring.R (I.ring.mul (k s) x) (k m) = trans (ap (I.ring.mul (k s)) (sym e)) (Bm.fraction-equation f) ;
   image (i : X) : Id I.ring.R (k (mul (d i) m)) I.ring.z =
    calc I.ring.R { k (mul (d i) m)
     =< FL.k-mul (d i) m > I.ring.mul (k (d i)) (k m)
     =< ap (I.ring.mul (k (d i))) (sym sx) > I.ring.mul (k (d i)) (I.ring.mul (k s) x)
     =< RL[I.ring].mul-swap (k (d i)) (k s) x > I.ring.mul (k s) (I.ring.mul (k (d i)) x)
     =< ap (I.ring.mul (k s)) (h i) > I.ring.mul (k s) I.ring.z
     =< RL[I.ring].mul-zero (k s) > I.ring.z } ;
   module Common (w : (e : Nat) * ((i : X) -> Killed (d i) m e)) {
    tm : Id R (mul (power w.1) m) z =
     reg (mul (power w.1) m) tt (\ i -> trans (RL[Rg].mul-swap (d i) (power w.1) m) (w.2 i)) ;
    km : Id I.ring.R (k m) I.ring.z =
     FL.unit-kills I.ring (k (power w.1)) (k m) (FL.power-unit w.1) (trans (sym (FL.k-mul (power w.1) m)) (trans (ap k tm) FL.k-zero)) ;
    result : Id I.ring.R x I.ring.z = FL.unit-kills I.ring (k s) x (Bm.inverse s f.2.2) (trans sx km) ;
   } ;
   result : Id I.ring.R x I.ring.z =
    Tr.Trunc[(e : Nat) * ((i : X) -> Killed (d i) m e)].induction @l (\ w -> Id I.ring.R x I.ring.z) (\ w -> setL x I.ring.z)
     (\ w -> Common[w].result)
     (cx (\ i -> Killed (d i) m) (killed-mono X d m)
      (\ i -> I.kernel (mul (d i) m) (image i))) ;
  } ;
  result : Id I.ring.R x I.ring.z =
   Tr.Trunc[Bm.Representatives x].induction @l (\ w -> Id I.ring.R x I.ring.z) (\ w -> setL x I.ring.z)
    (\ rep -> Given[rep.1,rep.2].result) (Bm.representatives x) ;
 } ;
 regular (X : U l) (cx : CommonPower[l].Common X) (d : X -> R) (reg : RIR.Regular X d) :
  RIL.Regular X (\ i -> k (d i)) = \ x t h -> Regular[X,cx,d,reg,x,h].result ;

 -- (a^-1 b^-1) (a (b y)) = y
 inv-left (a y : I.ring.R) (ha : RL[I.ring].unit a) : Id I.ring.R (I.ring.mul ha.1 (I.ring.mul a y)) y =
  trans (I.ring.mulA ha.1 a y) (trans (ap (\ w -> I.ring.mul w y) (trans (I.ring.mulC ha.1 a) ha.2)) (RL[I.ring].one-left y)) ;
 cancel2 (a b y : I.ring.R) (ha : RL[I.ring].unit a) (hb : RL[I.ring].unit b) :
  Id I.ring.R (I.ring.mul (I.ring.mul ha.1 hb.1) (I.ring.mul a (I.ring.mul b y))) y =
  calc I.ring.R { I.ring.mul (I.ring.mul ha.1 hb.1) (I.ring.mul a (I.ring.mul b y))
   =< sym (I.ring.mulA ha.1 hb.1 (I.ring.mul a (I.ring.mul b y))) > I.ring.mul ha.1 (I.ring.mul hb.1 (I.ring.mul a (I.ring.mul b y)))
   =< ap (I.ring.mul ha.1) (RL[I.ring].mul-swap hb.1 a (I.ring.mul b y)) > I.ring.mul ha.1 (I.ring.mul a (I.ring.mul hb.1 (I.ring.mul b y)))
   =< ap (\ w -> I.ring.mul ha.1 (I.ring.mul a w)) (inv-left b y hb) > I.ring.mul ha.1 (I.ring.mul a y)
   =< inv-left a y ha > y } ;

 -- matrices
 extend (p q : Nat) (u : MR.Mat p q) : ML.Mat p q = FL.extend p q u ;
 apply-k (p q : Nat) (u : MR.Mat p q) (x : MR.Vec p) (j : Fin q) :
  Id I.ring.R (k (MR.apply p q u x j)) (ML.apply p q (extend p q u) (\ i -> k (x i)) j) =
  trans (KS.natural p (\ i -> mul (x i) (u i j)))
   (SL.sum-cong p (\ i -> k (mul (x i) (u i j))) (\ i -> I.ring.mul (k (x i)) (k (u i j))) (\ i -> FL.k-mul (x i) (u i j))) ;
 compose-zero (p q l1 : Nat) (A : MR.Mat p q) (B : MR.Mat q l1) (h : MR.ComposeZero p q l1 A B) :
  ML.ComposeZero p q l1 (extend p q A) (extend q l1 B) =
  \ i j -> trans (sym (apply-k q l1 B (A i) j)) (trans (ap k (h i j)) FL.k-zero) ;

 -- exactness
 module Exact (p q l1 : Nat) (A : MR.Mat p q) (B : MR.Mat q l1) (ex : MR.Exact p q l1 A B)
  (y : ML.Vec q) (hy : (j : Fin l1) -> Id I.ring.R (ML.apply q l1 (extend q l1 B) y j) I.ring.z) {
  Goal : U l = (x : ML.Vec p) * ((i : Fin q) -> Id I.ring.R (ML.apply p q (extend p q A) x i) (y i)) ;
  module Given (cl : FL.Cleared q y) {
   s : R = cl.1 ; Y (i : Fin q) : R = cl.2.2.1 i ;
   image (j : Fin l1) : Id I.ring.R (k (MR.apply q l1 B Y j)) I.ring.z =
    calc I.ring.R { k (MR.apply q l1 B Y j)
     =< apply-k q l1 B Y j > ML.apply q l1 (extend q l1 B) (\ i -> k (Y i)) j
     =< ap {ML.Vec q} (\ v -> ML.apply q l1 (extend q l1 B) v j) (WedgeStep[l].Over[I.ring,setL,q].vec-ext q (\ i -> k (Y i)) (\ i -> I.ring.mul (k s) (y i)) (\ i -> sym (cl.2.2.2 i)))
     > ML.apply q l1 (extend q l1 B) (\ i -> I.ring.mul (k s) (y i)) j
     =< ML.apply-scale q l1 (extend q l1 B) (k s) y j > I.ring.mul (k s) (ML.apply q l1 (extend q l1 B) y j)
     =< ap (I.ring.mul (k s)) (hy j) > I.ring.mul (k s) I.ring.z
     =< RL[I.ring].mul-zero (k s) > I.ring.z } ;
   module Powered (kv : FL.KilledV l1 (MR.apply q l1 B Y)) {
    t : R = power kv.1 ;
    tY (i : Fin q) : R = mul t (Y i) ;
    btY (j : Fin l1) : Id R (MR.apply q l1 B tY j) z = trans (MR.apply-scale q l1 B t Y j) (kv.2 j) ;
    u : I.ring.R = I.ring.mul (FL.power-unit kv.1).1 (Bm.inverse s cl.2.1).1 ;
    module Pre (X : MR.Vec p) (hx : (i : Fin q) -> Id R (MR.apply p q A X i) (tY i)) {
     x (i : Fin p) : I.ring.R = I.ring.mul u (k (X i)) ;
     eq (i : Fin q) : Id I.ring.R (ML.apply p q (extend p q A) x i) (y i) =
      calc I.ring.R { ML.apply p q (extend p q A) x i
       =< ML.apply-scale p q (extend p q A) u (\ j -> k (X j)) i > I.ring.mul u (ML.apply p q (extend p q A) (\ j -> k (X j)) i)
       =< ap (I.ring.mul u) (sym (apply-k p q A X i)) > I.ring.mul u (k (MR.apply p q A X i))
       =< ap (\ w -> I.ring.mul u (k w)) (hx i) > I.ring.mul u (k (mul t (Y i)))
       =< ap (I.ring.mul u) (trans (FL.k-mul t (Y i)) (ap (I.ring.mul (k t)) (sym (cl.2.2.2 i))))
       > I.ring.mul u (I.ring.mul (k t) (I.ring.mul (k s) (y i)))
       =< cancel2 (k t) (k s) (y i) (FL.power-unit kv.1) (Bm.inverse s cl.2.1) > y i } ;
     result : Goal = (x,eq) ;
    } ;
    result : Tr.Trunc[Goal].carrier =
     TC.map ((X : MR.Vec p) * ((i : Fin q) -> Id R (MR.apply p q A X i) (tY i))) Goal
      (\ w -> Pre[w.1,w.2].result) (ex tY btY) ;
   } ;
   result : Tr.Trunc[Goal].carrier =
    TC.bind (FL.KilledV l1 (MR.apply q l1 B Y)) Goal (\ kv -> Powered[kv].result)
     (FL.killV l1 (MR.apply q l1 B Y) (\ j -> I.kernel (MR.apply q l1 B Y j) (image j))) ;
  } ;
  result : Tr.Trunc[Goal].carrier = TC.bind (FL.Cleared q y) Goal (\ cl -> Given[cl].result) (FL.clear q y) ;
 } ;
 exact (p q l1 : Nat) (A : MR.Mat p q) (B : MR.Mat q l1) (ex : MR.Exact p q l1 A B) :
  ML.Exact p q l1 (extend p q A) (extend q l1 B) = \ y hy -> Exact[p,q,l1,A,B,ex,y,hy].result ;
} ;
