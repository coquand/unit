-- The splitting lemma behind Lemma 4.3 (and the normal form diag(1, A')).
--
-- In the exterior algebra of L^q, let lambda be a linear form and a a vector
-- with lambda . a = 1, g = i(a), and M : L^p -> L^q with lambda . M y = 0 for
-- all y (V = im M lies in ker lambda).  Write c for the contraction by
-- lambda and "x kills y" for x y = 0.
-- Split: if every product of m vectors of V has its coefficients in an ideal
-- I, so has every product of m + 1 vectors v_t = M C_t + s_t a of V + L a.
-- (x kills y is the case I = Ann(x); "x kills" below reads "lies in I".)
-- Proof.  Let W = i(v_1) ... i(v_{m+1}).  By contract-right,
--   c(W g) = c(W) g + (lambda . a) alpha(W) = c(W) g + alpha(W).
-- (1) W g = i(M C_1) ... i(M C_{m+1}) g (shear), and x kills it, so x kills
--     c(W g).
-- (2) x kills c(W) g (claim, with Y = 1).  Claim: if g Y g = 0 and x kills
--     P' Y g for every product P' of m' vectors of V, then x kills
--     c(i(v_1) ... i(v_{m'+1})) Y g.  Induction on m': write the product as
--     P i(w), w = w' + s a; c(P i(w)) = c(P) i(w) + (lambda . w) alpha(P).
--     c(P) i(w) Y g = c(P) i(w') Y g since g Y g = 0 (absorb), and the
--     induction hypothesis applies with Y' = i(w') Y.  alpha(P) is the
--     product of the -v_t, and alpha(P) Y g = (product of -M C_t) Y g by the
--     shear with the suffix Y g (since g Y g = 0): killed.
-- (3) So x kills alpha(W) = c(W g) - c(W) g, hence W = alpha(alpha(W)).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Lg : CRing) (setL : Pr.isSet Lg.R) (p q : Nat)
 (lam a : Matrices[l].Over[Lg].Vec q)
 (one : Id Lg.R (ExteriorVectorContraction[l].Over[Lg,setL].vdot q lam a) Lg.o)
 (M : Matrices[l].Over[Lg].Mat p q)
 (orth : (y : Matrices[l].Over[Lg].Vec p) ->
   Id Lg.R (ExteriorVectorContraction[l].Over[Lg,setL].vdot q lam (Matrices[l].Over[Lg].apply p q M y)) Lg.z)
 (I : RegularIdeal[l].IdealPred[Lg]) {
 open Lg ; module L = RL[Lg] ;
 open ExteriorModel[l].Over[Lg] ;
 module MM = Matrices[l].Over[Lg] ;
 module EA = ExteriorAlgebra[l].Over[Lg,setL] ;
 module AL = Alternating[l].Over[Lg,setL] ;
 module VC = ExteriorVectorContraction[l].Over[Lg,setL] ;
 module WS = WedgeStep[l].Over[Lg,setL,q] ;
 module MK = MinorKill[l].Over[Lg,setL] ;
 module G = EA.At[q].G ;
 g : Ext q = gen q a ;
 c (y : Ext q) : Ext q = VC.contract q lam y ;
 module IE = IdealExt[l].Over[Lg,setL,I] ;
 -- "y has its coefficients in I" (x kills y: I = IdealExt.annihilator x)
 Kx (y : Ext q) : U l = IE.InCoeff q y ;

 -- closure properties (IdealExt)
 kx-right (y w : Ext q) (h : Kx y) : Kx (emul q y w) = IE.in-mul-right q y w h ;
 kx-left (y w : Ext q) (h : Kx w) : Kx (emul q y w) = IE.in-mul-left q y w h ;
 kx-add (y w : Ext q) (hy : Kx y) (hw : Kx w) : Kx (eadd q y w) = IE.in-add q y w hy hw ;
 kx-scale (s : R) (y : Ext q) (h : Kx y) : Kx (escale q s y) = IE.in-scale q s y h ;
 kx-alpha (y : Ext q) (h : Kx y) : Kx (alpha q y) = IE.in-alpha q y h ;
 kx-eq (y w : Ext q) (e : Id (Ext q) y w) (h : Kx y) : Kx w = subst Kx e h ;
 kx-contract (y : Ext q) (h : Kx y) : Kx (c y) = IE.in-contract q lam y h ;
 -- y = w - z with w, z in I
 kx-solve (y w z1 : Ext q) (e : Id (Ext q) w (eadd q z1 y)) (hw : Kx w) (hz : Kx z1) : Kx y =
  kx-eq (eadd q (eneg q z1) w) y
   (trans (ap (eadd q (eneg q z1)) e)
    (trans (EA.eaddA q (eneg q z1) z1 y)
     (trans (ap (\ t -> eadd q t y) (trans (EA.eaddC q (eneg q z1) z1) (EA.eaddN q z1))) (G.zl y))))
   (kx-add (eneg q z1) w (IE.in-neg q z1 hz) hw) ;

 -- the vectors M C_t + s_t a
 vec (C : MM.Vec p) (s : R) : MM.Vec q = WS.comb (MM.apply p q M C) s a ;
 vecs (m : Nat) (C : MM.Mat m p) (s : Fin m -> R) : MM.Mat m q = \ t -> vec (C t) (s t) ;
 lam-vec (C : MM.Vec p) (s : R) : Id R (VC.vdot q lam (vec C s)) s =
  trans (WS.vdot-comb q lam (MM.apply p q M C) a s)
   (trans (ap (\ t -> add t (mul s (VC.vdot q lam a))) (orth C))
    (trans (L.zl (mul s (VC.vdot q lam a))) (trans (ap (mul s) one) (mulO s)))) ;

 -- g Z = 0: then i(w + s a) Z = i(w) Z, and g i(w) Z = 0
 Absorbs (Z : Ext q) : U l = Id (Ext q) (emul q g Z) (ezero q) ;
 absorb (w : MM.Vec q) (s : R) (Z : Ext q) (hZ : Absorbs Z) :
  Id (Ext q) (emul q (gen q (WS.comb w s a)) Z) (emul q (gen q w) Z) =
  calc (Ext q) { emul q (gen q (WS.comb w s a)) Z
   =< ap (\ t -> emul q t Z) (trans (EA.gen-add q w (\ j -> mul s (a j))) (ap (eadd q (gen q w)) (EA.gen-scale q s a)))
   > emul q (eadd q (gen q w) (escale q s g)) Z
   =< EA.dist-right q (gen q w) (escale q s g) Z > eadd q (emul q (gen q w) Z) (emul q (escale q s g) Z)
   =< ap (eadd q (emul q (gen q w) Z)) (trans (EA.scale-mul-left q s g Z) (trans (ap (escale q s) hZ) (EA.escale-zero q s)))
   > eadd q (emul q (gen q w) Z) (ezero q)
   =< EA.eaddZ q (emul q (gen q w) Z) > emul q (gen q w) Z } ;
 absorbs-gen (w : MM.Vec q) (Z : Ext q) (hZ : Absorbs Z) : Absorbs (emul q (gen q w) Z) =
  calc (Ext q) { emul q g (emul q (gen q w) Z)
   =< EA.mulA' q g (gen q w) Z > emul q (emul q g (gen q w)) Z
   =< ap (\ t -> emul q t Z) (WS.anti a w) > emul q (eneg q (emul q (gen q w) g)) Z
   =< EA.mul-neg-l q (emul q (gen q w) g) Z > eneg q (emul q (emul q (gen q w) g) Z)
   =< ap (eneg q) (sym (EA.mulA' q (gen q w) g Z)) > eneg q (emul q (gen q w) (emul q g Z))
   =< ap (\ t -> eneg q (emul q (gen q w) t)) hZ > eneg q (emul q (gen q w) (ezero q))
   =< ap (eneg q) (EA.mul-zero-r q (gen q w)) > eneg q (ezero q)
   =< G.neg-zero > ezero q } ;
 -- shear with a suffix Z, g Z = 0
 shear : (m : Nat) (w : MM.Mat m q) (s : Fin m -> R) (Z : Ext q) -> Absorbs Z ->
  Id (Ext q) (emul q (MM.wedge m q (\ t -> WS.comb (w t) (s t) a)) Z) (emul q (MM.wedge m q w) Z) = split {
  zero -> \ w s Z hZ -> refl (emul q (eone q) Z) ;
  suc m | r -> \ w s Z hZ ->
   calc (Ext q) { emul q (emul q (MM.wedge m q (\ t -> WS.comb (w (inl t)) (s (inl t)) a)) (gen q (WS.comb (w (inr tt)) (s (inr tt)) a))) Z
    =< sym (EA.mulA' q (MM.wedge m q (\ t -> WS.comb (w (inl t)) (s (inl t)) a)) (gen q (WS.comb (w (inr tt)) (s (inr tt)) a)) Z)
    > emul q (MM.wedge m q (\ t -> WS.comb (w (inl t)) (s (inl t)) a)) (emul q (gen q (WS.comb (w (inr tt)) (s (inr tt)) a)) Z)
    =< ap (emul q (MM.wedge m q (\ t -> WS.comb (w (inl t)) (s (inl t)) a))) (absorb (w (inr tt)) (s (inr tt)) Z hZ)
    > emul q (MM.wedge m q (\ t -> WS.comb (w (inl t)) (s (inl t)) a)) (emul q (gen q (w (inr tt))) Z)
    =< r (\ t -> w (inl t)) (\ t -> s (inl t)) (emul q (gen q (w (inr tt))) Z) (absorbs-gen (w (inr tt)) Z hZ)
    > emul q (MM.wedge m q (\ t -> w (inl t))) (emul q (gen q (w (inr tt))) Z)
    =< EA.mulA' q (MM.wedge m q (\ t -> w (inl t))) (gen q (w (inr tt))) Z
    > emul q (MM.wedge (suc m) q w) Z } } ;

 module DTe = Determinant[l].Over[Lg,setL] ;
 -- alpha of a product of generators: the product of the opposite vectors
 opp (v : MM.Vec q) : MM.Vec q = \ j -> mul (neg o) (v j) ;
 neg-scale (y : Ext q) : Id (Ext q) (escale q (neg o) y) (eneg q y) =
  G.neg-uniq y (escale q (neg o) y)
   (trans (ap (\ t -> eadd q t (escale q (neg o) y)) (sym (EA.escale-one q y)))
    (trans (sym (EA.eadd-scale q o (neg o) y))
     (trans (ap (\ d -> escale q d y) (addN o)) (AL.In[EA.algebra q].scale-zero-l y)))) ;
 alpha-wedge : (m : Nat) (w : MM.Mat m q) ->
  Id (Ext q) (alpha q (MM.wedge m q w)) (MM.wedge m q (\ t -> opp (w t))) = split {
  zero -> \ w -> EA.alpha-emb q o ;
  suc m | r -> \ w -> trans (EA.alpha-mul q (MM.wedge m q (\ t -> w (inl t))) (gen q (w (inr tt))))
   (DTe.emul-cong q (r (\ t -> w (inl t)))
    (trans (EA.alpha-gen q (w (inr tt))) (trans (sym (neg-scale (gen q (w (inr tt))))) (sym (EA.gen-scale q (neg o) (w (inr tt))))))) } ;
 -- the opposite of M C + s a is M (-C) + (-s) a
 opp-vec (C : MM.Vec p) (s : R) : Id (MM.Vec q) (opp (vec C s)) (vec (\ k -> mul (neg o) (C k)) (mul (neg o) s)) =
  WS.vec-ext q (opp (vec C s)) (vec (\ k -> mul (neg o) (C k)) (mul (neg o) s)) (\ j ->
   calc R { mul (neg o) (add (MM.apply p q M C j) (mul s (a j)))
    =< dist (neg o) (MM.apply p q M C j) (mul s (a j))
    > add (mul (neg o) (MM.apply p q M C j)) (mul (neg o) (mul s (a j)))
    =< WS.AR.cong-add
        (trans (sym (MM.S.sum-scale (neg o) p (\ k -> mul (C k) (M k j))))
         (MM.S.sum-cong p _ (\ k -> mul (mul (neg o) (C k)) (M k j)) (\ k -> mulA (neg o) (C k) (M k j))))
        (mulA (neg o) s (a j))
    > add (MM.apply p q M (\ k -> mul (neg o) (C k)) j) (mul (mul (neg o) s) (a j)) }) ;

 absorbs-shift (w1 : MM.Vec q) (Y : Ext q) (hY : Absorbs (emul q Y g)) :
  Absorbs (emul q (emul q (gen q w1) Y) g) =
  subst Absorbs (EA.mulA' q (gen q w1) Y g) (absorbs-gen w1 (emul q Y g) hY) ;
 -- one more column
 extend (m : Nat) (C1 : MM.Mat m p) (v : MM.Vec p) : MM.Mat (suc m) p = split { inl t -> C1 t ; inr u -> v } ;
 -- alpha(P) Z for P the product of the M C_t + s_t a, Z = Y g
 alpha-part (m : Nat) (C : MM.Mat m p) (s : Fin m -> R) (Z : Ext q) (hZ : Absorbs Z)
  (h : (C1 : MM.Mat m p) -> Kx (emul q (MM.wedge m q (MK.compose m p q M C1)) Z)) :
  Kx (emul q (alpha q (MM.wedge m q (vecs m C s))) Z) =
  kx-eq (emul q (MM.wedge m q (MK.compose m p q M (\ t k -> mul (neg o) (C t k)))) Z)
   (emul q (alpha q (MM.wedge m q (vecs m C s))) Z)
   (sym (calc (Ext q) { emul q (alpha q (MM.wedge m q (vecs m C s))) Z
     =< ap (\ y -> emul q y Z) (alpha-wedge m (vecs m C s)) > emul q (MM.wedge m q (\ t -> opp (vecs m C s t))) Z
     =< ap (\ y -> emul q (MM.wedge m q y) Z)
         (F.funext (Fin m) (\ t -> MM.Vec q) (\ t -> opp (vecs m C s t)) (vecs m (\ t k -> mul (neg o) (C t k)) (\ t -> mul (neg o) (s t)))
          (\ t -> opp-vec (C t) (s t)))
     > emul q (MM.wedge m q (vecs m (\ t k -> mul (neg o) (C t k)) (\ t -> mul (neg o) (s t)))) Z
     =< shear m (MK.compose m p q M (\ t k -> mul (neg o) (C t k))) (\ t -> mul (neg o) (s t)) Z hZ
     > emul q (MM.wedge m q (MK.compose m p q M (\ t k -> mul (neg o) (C t k)))) Z }))
   (h (\ t k -> mul (neg o) (C t k))) ;
 -- c(P i(w)) Z = c(P) i(w) Z + (lambda . w) alpha(P) Z
 contract-step (P Z : Ext q) (w : MM.Vec q) :
  Id (Ext q) (emul q (c (emul q P (gen q w))) Z)
   (eadd q (emul q (emul q (c P) (gen q w)) Z) (escale q (VC.vdot q lam w) (emul q (alpha q P) Z))) =
  trans (ap (\ y -> emul q y Z) (VC.contract-right q lam w P))
   (trans (EA.dist-right q (emul q (c P) (gen q w)) (escale q (VC.vdot q lam w) (alpha q P)) Z)
    (ap (eadd q (emul q (emul q (c P) (gen q w)) Z)) (EA.scale-mul-left q (VC.vdot q lam w) (alpha q P) Z))) ;

 -- the claim
 Hyp (m : Nat) (Y : Ext q) : U l = (C1 : MM.Mat m p) -> Kx (emul q (MM.wedge m q (MK.compose m p q M C1)) (emul q Y g)) ;
 Concl (m : Nat) (Y : Ext q) : U l =
  (C : MM.Mat (suc m) p) (s : Fin (suc m) -> R) -> Kx (emul q (c (MM.wedge (suc m) q (vecs (suc m) C s))) (emul q Y g)) ;
 module Claim (m : Nat) (ih : (Y : Ext q) -> Absorbs (emul q Y g) -> Hyp m Y -> Concl m Y)
  (Y : Ext q) (hY : Absorbs (emul q Y g)) (h : Hyp (suc m) Y)
  (C : MM.Mat (suc (suc m)) p) (s : Fin (suc (suc m)) -> R) {
  Cl : MM.Vec p = C (inr tt) ; sl : R = s (inr tt) ;
  w : MM.Vec q = vec Cl sl ; w1 : MM.Vec q = MM.apply p q M Cl ;
  Pv : Ext q = MM.wedge (suc m) q (vecs (suc m) (\ t -> C (inl t)) (\ t -> s (inl t))) ;
  Y1 : Ext q = emul q (gen q w1) Y ;
  hyp1 : Hyp m Y1 = \ C1 ->
   kx-eq (emul q (MM.wedge (suc m) q (MK.compose (suc m) p q M (extend m C1 Cl))) (emul q Y g))
    (emul q (MM.wedge m q (MK.compose m p q M C1)) (emul q Y1 g))
    (calc (Ext q) { emul q (emul q (MM.wedge m q (MK.compose m p q M C1)) (gen q w1)) (emul q Y g)
      =< sym (EA.mulA' q (MM.wedge m q (MK.compose m p q M C1)) (gen q w1) (emul q Y g))
      > emul q (MM.wedge m q (MK.compose m p q M C1)) (emul q (gen q w1) (emul q Y g))
      =< ap (emul q (MM.wedge m q (MK.compose m p q M C1))) (EA.mulA' q (gen q w1) Y g)
      > emul q (MM.wedge m q (MK.compose m p q M C1)) (emul q Y1 g) })
    (h (extend m C1 Cl)) ;
  first : Kx (emul q (emul q (c Pv) (gen q w)) (emul q Y g)) =
   kx-eq (emul q (c Pv) (emul q Y1 g)) (emul q (emul q (c Pv) (gen q w)) (emul q Y g))
    (calc (Ext q) { emul q (c Pv) (emul q Y1 g)
     =< ap (emul q (c Pv)) (sym (EA.mulA' q (gen q w1) Y g)) > emul q (c Pv) (emul q (gen q w1) (emul q Y g))
     =< ap (emul q (c Pv)) (sym (absorb w1 sl (emul q Y g) hY)) > emul q (c Pv) (emul q (gen q w) (emul q Y g))
     =< EA.mulA' q (c Pv) (gen q w) (emul q Y g) > emul q (emul q (c Pv) (gen q w)) (emul q Y g) })
    (ih Y1 (absorbs-shift w1 Y hY) hyp1 (\ t -> C (inl t)) (\ t -> s (inl t))) ;
  second : Kx (escale q (VC.vdot q lam w) (emul q (alpha q Pv) (emul q Y g))) =
   kx-scale (VC.vdot q lam w) (emul q (alpha q Pv) (emul q Y g))
    (alpha-part (suc m) (\ t -> C (inl t)) (\ t -> s (inl t)) (emul q Y g) hY h) ;
  result : Kx (emul q (c (MM.wedge (suc (suc m)) q (vecs (suc (suc m)) C s))) (emul q Y g)) =
   kx-eq (eadd q (emul q (emul q (c Pv) (gen q w)) (emul q Y g)) (escale q (VC.vdot q lam w) (emul q (alpha q Pv) (emul q Y g))))
    (emul q (c (MM.wedge (suc (suc m)) q (vecs (suc (suc m)) C s))) (emul q Y g))
    (sym (contract-step Pv (emul q Y g) w))
    (kx-add (emul q (emul q (c Pv) (gen q w)) (emul q Y g)) (escale q (VC.vdot q lam w) (emul q (alpha q Pv) (emul q Y g))) first second) ;
 } ;
 module Start (Y : Ext q) (hY : Absorbs (emul q Y g)) (h : Hyp zero Y) (C : MM.Mat (suc zero) p) (s : Fin (suc zero) -> R) {
  w : MM.Vec q = vec (C (inr tt)) (s (inr tt)) ;
  result : Kx (emul q (c (MM.wedge (suc zero) q (vecs (suc zero) C s))) (emul q Y g)) =
   kx-eq (eadd q (emul q (emul q (c (eone q)) (gen q w)) (emul q Y g)) (escale q (VC.vdot q lam w) (emul q (alpha q (eone q)) (emul q Y g))))
    (emul q (c (MM.wedge (suc zero) q (vecs (suc zero) C s))) (emul q Y g))
    (sym (contract-step (eone q) (emul q Y g) w))
    (kx-add _ _
     (kx-eq (ezero q) (emul q (emul q (c (eone q)) (gen q w)) (emul q Y g))
      (sym (trans (ap (\ y -> emul q (emul q y (gen q w)) (emul q Y g)) (WS.Contraction[lam].contract-emb q lam o))
        (trans (ap (\ y -> emul q y (emul q Y g)) (EA.mul-zero-l q (gen q w))) (EA.mul-zero-l q (emul q Y g)))))
      (IE.in-zero q))
     (kx-scale (VC.vdot q lam w) (emul q (alpha q (eone q)) (emul q Y g))
      (kx-eq (emul q (eone q) (emul q Y g)) (emul q (alpha q (eone q)) (emul q Y g))
       (ap (\ y -> emul q y (emul q Y g)) (sym (EA.alpha-emb q o))) (h (\ t -> efq t))))) ;
 } ;
 claim : (m : Nat) (Y : Ext q) -> Absorbs (emul q Y g) -> Hyp m Y -> Concl m Y = split {
  zero -> \ Y hY h C s -> Start[Y,hY,h,C,s].result ;
  suc m | r -> \ Y hY h C s -> Claim[m,r,Y,hY,h,C,s].result } ;

 -- the splitting lemma
 module Main (m : Nat) (h : (C1 : MM.Mat m p) -> Kx (MM.wedge m q (MK.compose m p q M C1)))
  (C : MM.Mat (suc m) p) (s : Fin (suc m) -> R) {
  W : Ext q = MM.wedge (suc m) q (vecs (suc m) C s) ;
  gg : Absorbs g = WS.EA.gen-sq q a ;
  -- (1)
  wg : Kx (emul q W g) =
   kx-eq (emul q (MM.wedge (suc m) q (MK.compose (suc m) p q M C)) g) (emul q W g)
    (sym (shear (suc m) (MK.compose (suc m) p q M C) s g gg))
    (kx-right (MM.wedge (suc m) q (MK.compose (suc m) p q M C)) g
     (kx-right (MM.wedge m q (MK.compose m p q M (\ t -> C (inl t)))) (gen q (MM.apply p q M (C (inr tt))))
      (h (\ t -> C (inl t))))) ;
  -- (2)
  cwg : Kx (emul q (c W) g) =
   kx-eq (emul q (c W) (emul q (eone q) g)) (emul q (c W) g) (ap (emul q (c W)) (EA.one-left q g))
    (claim m (eone q) (subst Absorbs (sym (EA.one-left q g)) gg)
     (\ C1 -> kx-right (MM.wedge m q (MK.compose m p q M C1)) (emul q (eone q) g) (h C1)) C s) ;
  -- (3)
  alpha-W : Kx (alpha q W) =
   kx-solve (alpha q W) (c (emul q W g)) (emul q (c W) g)
    (trans (VC.contract-right q lam a W)
     (ap (eadd q (emul q (c W) g)) (trans (ap (\ d -> escale q d (alpha q W)) one) (EA.escale-one q (alpha q W)))))
    (kx-contract (emul q W g) wg) cwg ;
  result : Kx W = kx-eq (alpha q (alpha q W)) W (EA.alpha-alpha q W) (kx-alpha (alpha q W) alpha-W) ;
 } ;
 splitting (m : Nat) (h : (C1 : MM.Mat m p) -> Kx (MM.wedge m q (MK.compose m p q M C1)))
  (C : MM.Mat (suc m) p) (s : Fin (suc m) -> R) : Kx (MM.wedge (suc m) q (vecs (suc m) C s)) =
  Main[m,h,C,s].result ;
} ;
