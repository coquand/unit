-- cffr Theorem 6.8, the top map: if
--   R^(s 0) -T 0-> R^(s 1) -T 1-> ... -T k-> R^(s (k+1))
-- has T 0 injective mod J and is exact mod J at R^(s 1), ..., R^(s k)
-- (with T (i+1) T i = 0), then Gr(D_(s 0)(T 0)) >= k + 1 mod J (true grade,
-- ctete Def. 5; D_(s 0)(T 0) as the list Enumerate.MinorList).
-- Induction on k (paper: "using Lemma 4.1 ... iterating this argument").
-- k = 0: D_(s 0)(T 0) is regular mod J (McCoyMod), so Gr >= 1 (gr1-from).
-- k + 1: let f in R[X] be the Kronecker polynomial of D_(s 0)(T 0): f is in
-- D_(s 0)(T 0) R[X] and regular mod J[X] (TrueGradeThm9.Kron).  Over R[X]
-- the complex stays injective and exact mod J[X] (PolyExact); by Lemma 4.1
-- (ExactMod) T 0 is injective mod (J[X], f) and the complex is exact mod
-- (J[X], f) at R^(s 1), ..., R^(s k).  By induction Gr(D_(s 0)(T 0)) >= k + 1
-- mod (J[X], f) over R[X]; the minors over R[X] are the constants of the
-- minors (McCoyMod.Map), so cons gives Gr >= k + 2 mod J[X] over R[X], and
-- tower brings it down to R.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module TG = TrueGrade[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
-- the resolution data, top first
Seq (D : TG.RD) (s : Nat -> Nat) : U l = (i : Nat) -> Matrices[l].Over[D.1].Mat (s i) (s (suc i)) ;
TopRes (D : TG.RD) (mJ : Nat) (J : Fin mJ -> D.1.R) (k : Nat) (s : Nat -> Nat) (T : Seq D s) : U l =
 ExactMod[l].Over[D.1,D.2].InjMod mJ J (s zero) (s (suc zero)) (T zero) *
 ((i d : Nat) -> Id Nat k (plus (suc i) d) ->
  Matrices[l].Over[D.1].ComposeZero (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) *
  ExactMod[l].Over[D.1,D.2].ExactMod mJ J (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i))) ;
-- the minors of the top map, as a list
N (s : Nat -> Nat) : Nat = (Enumerate[l].minors-index (s zero) (s zero) (s (suc zero))).1 ;
minors (D : TG.RD) (s : Nat -> Nat) (T : Seq D s) (i : Fin (N s)) : D.1.R =
 Enumerate[l].MinorList[D.1,D.2,s zero,s zero,s (suc zero),T zero].minor-list i ;
Claim (k : Nat) : U l+ =
 (D : TG.RD) (mJ : Nat) (J : Fin mJ -> D.1.R) (s : Nat -> Nat) (T : Seq D s) ->
 TopRes D mJ J k s T -> TG.TGr (suc k) D mJ J (N s) (minors D s T) ;

-- the top map: D_(s 0)(T 0) regular mod J
module Regular (D : TG.RD) (mJ : Nat) (J : Fin mJ -> D.1.R) (s : Nat -> Nat) (T : Seq D s)
 (inj : ExactMod[l].Over[D.1,D.2].InjMod mJ J (s zero) (s (suc zero)) (T zero)) {
 module G = RegularIdeal[l].Generated[D.1,mJ,J] ;
 module MM = McCoyMod[l].Over[D.1,D.2,G.ideal,G.in-prop] ;
 module E = Enumerate[l] ;
 module ML = E.MinorList[D.1,D.2,s zero,s zero,s (suc zero),T zero] ;
 index-reg : MM.RJ.Regular (ML.MI.Index (s zero) (s zero) (s (suc zero))) (ML.MI.minors (s zero) (s zero) (s (suc zero)) (T zero)) =
  MM.mccoy-mod (s zero) (s (suc zero)) (T zero) inj ;
 result : TG.RegId D mJ J (N s) (minors D s T) = \ x t h ->
  index-reg x t (\ ci -> subst (\ c1 -> G.In (D.1.mul (ML.MI.minors (s zero) (s zero) (s (suc zero)) (T zero) c1) x))
    (E.pre-eq (ML.MI.Index (s zero) (s zero) (s (suc zero))) ML.E ci) (h (E.pre (ML.MI.Index (s zero) (s zero) (s (suc zero))) ML.E ci))) ;
} ;

module Step (k : Nat) (ih : Claim k) (D : TG.RD) (mJ : Nat) (J : Fin mJ -> D.1.R) (s : Nat -> Nat) (T : Seq D s)
 (h : TopRes D mJ J (suc k) s T) {
 module PE = PolyExact[l].Over[D.1,D.2,mJ,J] ;
 module KR = TrueGradeThm9[l].Kron[D] ;
 D1 : TG.RD = TG.ext1 D ;
 module EX = ExactMod[l].Over[(TG.ext1 D).1,(TG.ext1 D).2] ;
 a (i : Fin (N s)) : D.1.R = minors D s T i ;
 f : (TG.ext1 D).1.R = KR.f (N s) a ;
 J1 (j : Fin mJ) : (TG.ext1 D).1.R = KR.c (J j) ;
 rf : TG.RegEl (TG.ext1 D) mJ J1 f = KR.f-reg mJ J (N s) a (Regular[D,mJ,J,s,T,h.1].result) ;
 T1 (i : Nat) : Matrices[l].Over[(TG.ext1 D).1].Mat (s i) (s (suc i)) = PE.cmat (s i) (s (suc i)) (T i) ;
 at (i d : Nat) (e : Id Nat (suc k) (plus (suc i) d)) : U l =
  Matrices[l].Over[(TG.ext1 D).1].ComposeZero (s i) (s (suc i)) (s (suc (suc i))) (T1 i) (T1 (suc i)) *
  EX.ExactMod mJ J1 (s i) (s (suc i)) (s (suc (suc i))) (T1 i) (T1 (suc i)) ;
 lift (i d : Nat) (e : Id Nat (suc k) (plus (suc i) d)) : at i d e =
  (PE.compose-zero (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) ((h.2 i d e).1),
   PE.exact (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) ((h.2 i d e).2)) ;
 inj1 : EX.InjMod mJ J1 (s zero) (s (suc zero)) (T1 zero) = PE.inj (s zero) (s (suc zero)) (T zero) h.1 ;
 -- modulo (J1, f)
 J2 : Fin (suc mJ) -> (TG.ext1 D).1.R = EX.Kb mJ J1 f ;
 inj2 : EX.InjMod (suc mJ) J2 (s zero) (s (suc zero)) (T1 zero) =
  EX.inj-step mJ J1 f rf (s zero) (s (suc zero)) (s (suc (suc zero))) (T1 zero) (T1 (suc zero)) inj1
   (lift zero k (refl (suc k))).1 (lift zero k (refl (suc k))).2 ;
 rest (i d : Nat) (e : Id Nat k (plus (suc i) d)) :
  Matrices[l].Over[(TG.ext1 D).1].ComposeZero (s i) (s (suc i)) (s (suc (suc i))) (T1 i) (T1 (suc i)) *
  EX.ExactMod (suc mJ) J2 (s i) (s (suc i)) (s (suc (suc i))) (T1 i) (T1 (suc i)) =
  ((lift i (suc d) (trans (ap (\ j -> suc j) e) (sym (plus-suc (suc i) d)))).1,
   EX.exact-step mJ J1 f rf (s i) (s (suc i)) (s (suc (suc i))) (s (suc (suc (suc i)))) (T1 i) (T1 (suc i)) (T1 (suc (suc i)))
    (lift i (suc d) (trans (ap (\ j -> suc j) e) (sym (plus-suc (suc i) d)))).2
    (lift (suc i) d (ap (\ j -> suc j) e)).2 (lift (suc i) d (ap (\ j -> suc j) e)).1) ;
 g : TG.TGr (suc k) (TG.ext1 D) (suc mJ) J2 (N s) (minors (TG.ext1 D) s T1) =
  ih (TG.ext1 D) (suc mJ) J2 s T1 (inj2,rest) ;
 -- the minors over R[X] are the constants of the minors
 module CM = McCoyMod[l].Map[D.1,(TG.ext1 D).1,D.2,(TG.ext1 D).2,TG.PolyX[D].X.inclusion] ;
 module E = Enumerate[l] ;
 same : Id (Fin (N s) -> (TG.ext1 D).1.R) (minors (TG.ext1 D) s T1) (\ i -> KR.c (a i)) =
  F.funext (Fin (N s)) (\ i -> (TG.ext1 D).1.R) _ _ (\ i ->
   CM.minors-map (s zero) (s zero) (s (suc zero)) (T zero) (E.list _ (E.minors-index (s zero) (s zero) (s (suc zero))) i)) ;
 g1 : TG.TGr (suc k) (TG.ext1 D) (suc mJ) J2 (N s) (\ i -> KR.c (a i)) =
  subst (\ L -> TG.TGr (suc k) (TG.ext1 D) (suc mJ) J2 (N s) L) same g ;
 g2 : TG.TGr (suc (suc k)) (TG.ext1 D) mJ J1 (N s) (\ i -> KR.c (a i)) =
  TrueGradeProduct[l].cons (TG.ext1 D) (suc k) mJ J1 (N s) (\ i -> KR.c (a i)) f (KR.f-in (N s) a) rf g1 ;
 result : TG.TGr (suc (suc k)) D mJ J (N s) a =
  TrueGradeTools[l].tower (suc (suc k)) D mJ J (N s) a (suc zero) g2 ;
} ;

top-grade : (k : Nat) -> Claim k = split {
 zero -> \ D mJ J s T h -> TrueGradeThm9[l].gr1-from D mJ J (N s) (minors D s T) (Regular[D,mJ,J,s,T,h.1].result) ;
 suc k | ih -> \ D mJ J s T h -> Step[k,ih,D,mJ,J,s,T,h].result } ;
