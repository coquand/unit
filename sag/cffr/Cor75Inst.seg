-- cffr Corollary 7.5, with worker B's Theorem 7.1 (koszul/Resolutions,
-- Chain.Elem: the elementwise form for the last cokernel, Koszul grade) and
-- the transport of the true grade to R[1/x] (koszul/TrueGradeLocUp).  The
-- true grade of Theorem 6.8 becomes the Koszul grade by
-- TrueKoszul.Absolute.result.  The layouts agree once the index of the last
-- map is split (zero: u; suc i: T i), and fibres are equalities of vectors
-- (pointwise here).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module TG = TrueGrade[l] ; module GT = GradeTools[l] ; module RS = Resolution[l] ;
module T68 = Thm68[l] ; module TL = TrueGradeLocal[l] ; module C75 = Cor75[l] ;
-- Gr >= k + 2 as Koszul grade, in the form of Chain.Elem
koszul (D : TG.RD) (k n : Nat) (a : Fin n -> D.1.R) (g : TG.TGr (suc (suc k)) D zero (GT.J0 D) n a) :
 Grade[l].Over[D.1,D.2].Gr Thm64[l].Over[D.1,D.2].reg n a (suc (plus k (suc zero))) =
 subst {Nat} (\ m -> Grade[l].Over[D.1,D.2].Gr Thm64[l].Over[D.1,D.2].reg n a (suc m)) {suc k} {plus k (suc zero)}
  (sym (trans (plus-suc k zero) (ap (\ j -> suc j) (plus-zero k))))
  (TrueKoszul[l].Absolute[D,n,a].result (suc (suc k)) g) ;
module Inst (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) {
 module MM = Matrices[l].Over[D.1] ;
 module RES = Resolutions[l].Over[D.1,D.2] ;
 -- fibres: equality of vectors <-> pointwise
 Pt (p1 q1 : Nat) (M : MM.Mat p1 q1) (y : MM.Vec q1) : U l =
  (x : MM.Vec p1) * ((i : Fin q1) -> Id D.1.R (MM.apply p1 q1 M x i) (y i)) ;
 to-pt (p1 q1 : Nat) (M : MM.Mat p1 q1) (y : MM.Vec q1)
  (h : Tr.Trunc[Bijection[l].Fibre (MM.apply p1 q1 M) y].carrier) : Tr.Trunc[Pt p1 q1 M y].carrier =
  TC.map (Bijection[l].Fibre (MM.apply p1 q1 M) y) (Pt p1 q1 M y) (\ w -> (w.1,\ i -> ap (\ v -> v i) w.2)) h ;
 from-pt (p1 q1 : Nat) (M : MM.Mat p1 q1) (y : MM.Vec q1)
  (h : Tr.Trunc[Pt p1 q1 M y].carrier) : Tr.Trunc[Bijection[l].Fibre (MM.apply p1 q1 M) y].carrier =
  TC.map (Pt p1 q1 M y) (Bijection[l].Fibre (MM.apply p1 q1 M) y)
   (\ w -> (w.1,F.funext (Fin q1) (\ i -> D.1.R) (MM.apply p1 q1 M w.1) y w.2)) h ;
 thm71 : (k : Nat) -> T68.Res D k p s u T -> (n : Nat) (a : Fin n -> D.1.R) -> TG.TGr (suc (suc k)) D zero (GT.J0 D) n a ->
  (y : MM.Vec (C75.s1 p s (suc k))) -> ((i : Fin n) -> C75.InIm D p s u T k (\ j -> D.1.mul (a i) (y j))) -> C75.InIm D p s u T k y = split {
  zero -> \ res n a g y hk -> to-pt p (s zero) u y
   (RES.Chain[zero,p,s,u,T,res.1,res.2,n,a].Elem[koszul D zero n a g,y,
     \ j -> from-pt p (s zero) u (\ i -> D.1.mul (a j) (y i)) (hk j)].result) ;
  suc k -> \ res n a g y hk -> to-pt (s k) (s (suc k)) (T k) y
   (RES.Chain[suc k,p,s,u,T,res.1,res.2,n,a].Elem[koszul D (suc k) n a g,y,
     \ j -> from-pt (s k) (s (suc k)) (T k) (\ i -> D.1.mul (a j) (y i)) (hk j)].result) } ;
} ;
thm71 : C75.Thm71 = \ D k p s u T res n a g y hk -> Inst[D,p,s,u,T].thm71 k res n a g y hk ;
tgr-loc : C75.TgrLoc = \ k D n I c g ->
 subst {Fin zero -> (TL.Loc D c).1.R} (\ J1 -> TG.TGr k (TL.Loc D c) zero J1 n (\ i -> (TL.loc D c).1 (I i)))
  {\ j -> (TL.loc D c).1 (GT.J0 D j)} {GT.J0 (TL.Loc D c)}
  (F.funext (Fin zero) (\ j -> (TL.Loc D c).1.R) _ _ (\ j -> efq j))
  (TrueGradeLocUp[l].tgr-loc k D zero (GT.J0 D) n I c g) ;
-- Corollary 7.5
module C = C75.Over[thm71,tgr-loc] ;
cor75 (k : Nat) : C.ClaimK k = C.cor75 k ;
