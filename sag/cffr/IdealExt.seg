-- Elements of the exterior algebra with all coefficients in an ideal I
-- (InCoeff).  By induction on n, through the pair model (w0, w1) = w0 + w1 e
-- of ExteriorModel: this set is closed under sums, scalars, negation, the
-- grade involution, contraction by a vector, and multiplication by any
-- element on either side (the product's components are sums of products
-- with one factor from the given element).  Generators of vectors with
-- coordinates in I are in it.  Being killed by x is the case I = Ann(x)
-- (annihilator).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (I : RegularIdeal[l].IdealPred[Rg]) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module EC = ExteriorCoordinates[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 module IL = RegularIdeal[l].IdealLaws[Rg,I] ;
 InCoeff (n : Nat) (y : Ext n) : U l = (J : ExteriorCoordinates[l].Index n) -> I.In (EC.coeff n y J) ;
 in-eq (n : Nat) (y w : Ext n) (e : Id (Ext n) y w) (h : InCoeff n y) : InCoeff n w = subst (InCoeff n) e h ;
 in-zero (n : Nat) : InCoeff n (ezero n) = \ J -> IL.in-eq z (EC.coeff n (ezero n) J) (sym (EC.coeff-zero n J)) I.in-zero ;
 in-add (n : Nat) (y w : Ext n) (hy : InCoeff n y) (hw : InCoeff n w) : InCoeff n (eadd n y w) = \ J ->
  IL.in-eq (add (EC.coeff n y J) (EC.coeff n w J)) (EC.coeff n (eadd n y w) J) (sym (EC.coeff-add n y w J))
   (I.in-add (EC.coeff n y J) (EC.coeff n w J) (hy J) (hw J)) ;
 in-scale (n : Nat) (s : R) (y : Ext n) (h : InCoeff n y) : InCoeff n (escale n s y) = \ J ->
  IL.in-eq (mul s (EC.coeff n y J)) (EC.coeff n (escale n s y) J) (sym (EC.coeff-scale n s y J)) (I.in-mul s (EC.coeff n y J) (h J)) ;
 -- by components
 coeff-neg : (n : Nat) (y : Ext n) (J : ExteriorCoordinates[l].Index n) -> Id R (EC.coeff n (eneg n y) J) (neg (EC.coeff n y J)) = split {
  zero -> \ y J -> refl (neg y) ;
  suc n | r -> \ y -> split { inl J -> r y.1 J ; inr J -> r y.2 J } } ;
 in-neg (n : Nat) (y : Ext n) (h : InCoeff n y) : InCoeff n (eneg n y) = \ J ->
  IL.in-eq (neg (EC.coeff n y J)) (EC.coeff n (eneg n y) J) (sym (coeff-neg n y J)) (IL.in-neg (EC.coeff n y J) (h J)) ;
 in-alpha : (n : Nat) (y : Ext n) -> InCoeff n y -> InCoeff n (alpha n y) = split {
  zero -> \ y h -> h ;
  suc n | r -> \ y h -> split {
   inl J -> r y.1 (\ J1 -> h (inl J1)) J ;
   inr J -> in-neg n (alpha n y.2) (r y.2 (\ J1 -> h (inr J1))) J } } ;
 in-mul-right : (n : Nat) (y w : Ext n) -> InCoeff n y -> InCoeff n (emul n y w) = split {
  zero -> \ y w h J -> IL.in-eq (mul w y) (mul y w) (mulC w y) (I.in-mul w y (h tt)) ;
  suc n | r -> \ y w h -> split {
   inl J -> r y.1 w.1 (\ J1 -> h (inl J1)) J ;
   inr J -> in-add n (emul n y.1 w.2) (emul n y.2 (alpha n w.1))
    (r y.1 w.2 (\ J1 -> h (inl J1))) (r y.2 (alpha n w.1) (\ J1 -> h (inr J1))) J } } ;
 in-mul-left : (n : Nat) (y w : Ext n) -> InCoeff n w -> InCoeff n (emul n y w) = split {
  zero -> \ y w h J -> I.in-mul y w (h tt) ;
  suc n | r -> \ y w h -> split {
   inl J -> r y.1 w.1 (\ J1 -> h (inl J1)) J ;
   inr J -> in-add n (emul n y.1 w.2) (emul n y.2 (alpha n w.1))
    (r y.1 w.2 (\ J1 -> h (inr J1))) (r y.2 (alpha n w.1) (in-alpha n w.1 (\ J1 -> h (inl J1)))) J } } ;
 -- the opaque accessors of ExteriorModel and the components
 first-is (n : Nat) (x : Ext (suc n)) : Id (Ext n) (first n x) x.1 = ap (\ w -> w.1) (components n x) ;
 second-is (n : Nat) (x : Ext (suc n)) : Id (Ext n) (second n x) x.2 = ap (\ w -> w.2) (components n x) ;
 in-pair (n : Nat) (a b : Ext n) (ha : InCoeff n a) (hb : InCoeff n b) : InCoeff (suc n) (a,b) = split {
  inl J -> ha J ; inr J -> hb J } ;
 in-contract : (n : Nat) (v : Matrices[l].Over[Rg].Vec n) (y : Ext n) -> InCoeff n y -> InCoeff n (VC.contract n v y) = split {
  zero -> \ v y h J -> IL.in-eq z (VC.contract zero v y) (sym (VC.contract-zero-def v y)) I.in-zero ;
  suc n | r -> \ v y h ->
   let { h1 : InCoeff n (first n y) = in-eq n y.1 (first n y) (sym (first-is n y)) (\ J1 -> h (inl J1)) ;
         h2 : InCoeff n (second n y) = in-eq n y.2 (second n y) (sym (second-is n y)) (\ J1 -> h (inr J1)) ; } in
   in-eq (suc n) _ (VC.contract (suc n) v y) (sym (VC.contract-step-def n v y))
    (in-pair n _ _
     (in-add n (VC.contract n (VC.vector-prefix n v) (first n y)) (escale n (VC.vector-last n v) (alpha n (second n y)))
      (r (VC.vector-prefix n v) (first n y) h1)
      (in-scale n (VC.vector-last n v) (alpha n (second n y)) (in-alpha n (second n y) h2)))
     (r (VC.vector-prefix n v) (second n y) h2)) } ;
 -- generators
 in-emb : (n : Nat) (c : R) -> I.In c -> InCoeff n (emb n c) = split {
  zero -> \ c h J -> h ;
  suc n | r -> \ c h -> split { inl J -> r c h J ; inr J -> in-zero n J } } ;
 in-gen : (n : Nat) (v : Matrices[l].Over[Rg].Vec n) -> ((i : Fin n) -> I.In (v i)) -> InCoeff n (gen n v) = split {
  zero -> \ v h J -> I.in-zero ;
  suc n | r -> \ v h -> split {
   inl J -> r (\ i -> v (inl i)) (\ i -> h (inl i)) J ;
   inr J -> in-emb n (v (inr tt)) (h (inr tt)) J } } ;
} ;
-- the annihilator of x
annihilator (Rg : CRing) (x : Rg.R) : RegularIdeal[l].IdealPred[Rg] =
 RegularIdeal[l].mkIdealPred Rg (\ y -> Id Rg.R (Rg.mul y x) Rg.z) (RL[Rg].zero-mul x)
  (\ a b ha hb -> trans (RL[Rg].dist-left a b x) (trans (ExteriorAlgebra[l].AG[Rg.R,Rg.z,Rg.add,Rg.neg,Rg.addA,Rg.addC,Rg.addZ,Rg.addN].cong-add ha hb) (Rg.addZ Rg.z)))
  (\ b y h -> trans (sym (Rg.mulA b y x)) (trans (ap (Rg.mul b) h) (RL[Rg].mul-zero b))) ;
