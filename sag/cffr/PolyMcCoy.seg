-- McCoy's theorem for one indeterminate (ctete Theorem 4, cffr Theorem 3.1),
-- modulo an ideal I of R (I = 0 is the absolute case; CFFR-INTERFACE,
-- option (R): "regular modulo J" without quotient rings), on coefficient
-- lists (Poly: lowest degree first), for a family f_j (j : X).  c(f) is
-- the family of all the coefficients of all the f_j; a polynomial g is in
-- I[X] (InI g) when all its coefficients are in I.
--
-- (1) If c(f) is regular mod I and g f_j in I[X] for every j then g in I[X].
--     Induction on the length n of g.  Let g = b0 + X g1 (g1 of length n).
--     For every j and every coefficient a of f_j we show a g in I[X]
--     (inner, by induction on f' = a + X f'' running through the tails of
--     f_j, with f' g in I[X]): the constant coefficient of f' g is a b0, so
--     a b0 in I; then a g = a b0 + X (a g1) and f_j (a g1) in I[X] for all
--     j, since X f_j (a g1) = f_j (a g) - a b0 f_j and f_j (a g) =
--     a (f_j g); so a g1 in I[X] by induction on n, and a g in I[X]; and
--     f' g = a g + X (f'' g) gives f'' g in I[X].  So every coefficient of
--     g is killed by c(f) modulo I: g in I[X].
-- (2) Conversely, if (f_j) is regular mod I[X] then c(f) is regular mod I:
--     x c(f) in I gives f_j x in I[X] for all j, so x in I.
-- With X = 1 this is McCoy for one polynomial; with constant f_j it says
-- that a regular ideal stays regular in R[X].
level l ; open Ring[l] ; open Poly[l] ; open Mul[l] ;
module Over (A : CRing) (I : RegularIdeal[l].IdealPred[A]) (X : U l) (f : X -> PolyR[A].P) {
 open A ; open RL[A] ; open PolyR[A] ; open MulR[A] ;
 module RL0 = RawLaws[l].Laws[A] ;
 module RM = RawMultiplication[l].Laws[A] ;
 module IL = RegularIdeal[l].IdealLaws[A,I] ;
 module RI = RegularIdeal[l].Over[A,RegularIdeal[l].modulo A I] ;
 -- c(f)
 Content : U l = X * Nat ;
 content (ci : Content) : R = coef (f ci.1) ci.2 ;
 InI (g : P) : U l = (k : Nat) -> I.In (coef g k) ;
 Kill (g : P) : U l = (j : X) -> InI (pmul (f j) g) ;
 PolyRegular : U l = (g : P) -> Kill g -> InI g ;

 in-peq (p q : P) (h : peq p q) (hq : InI q) : InI p = \ k -> IL.in-eq (coef q k) (coef p k) (sym (h k)) (hq k) ;
 in-nil : InI nil = \ k -> I.in-zero ;
 shift-in (h : P) (e : InI (cons z h)) : InI h = \ k -> e (suc k) ;
 in-scal (a : R) (h : P) (e : InI h) : InI (scal a h) = \ k ->
  IL.in-eq (mul a (coef h k)) (coef (scal a h) k) (sym (coef-scal a h k)) (I.in-mul a (coef h k) (e k)) ;
 in-scal-left (c : R) (h : P) (e : I.In c) : InI (scal c h) = \ k ->
  IL.in-eq (mul (coef h k) c) (coef (scal c h) k) (trans (mulC (coef h k) c) (sym (coef-scal c h k)))
   (I.in-mul (coef h k) c e) ;
 add-cancel (p q : P) (hp : InI p) (h : InI (addP p q)) : InI q = \ k ->
  IL.in-cancel (coef p k) (coef q k) (hp k) (IL.in-eq (coef (addP p q) k) (add (coef p k) (coef q k)) (coef-addP p q k) (h k)) ;
 plen-scal (a : R) : (h : P) -> Id Nat (plen (scal a h)) (plen h) = split {
  nil -> refl zero ; cons x h | r -> ap (\ k -> suc k) r } ;

 module Inner (reg : RI.Regular Content content) (n : Nat)
  (ih : (h : P) -> Id Nat (plen h) n -> Kill h -> InI h)
  (b0 : R) (g1 : P) (len : Id Nat (plen g1) n) (kg : Kill (cons b0 g1)) {
  g : P = cons b0 g1 ;
  -- a b0 in I gives a g1 in I[X]
  split-g (a : R) : peq (scal a g) (addP (RL0.constantP (mul a b0)) (cons z (scal a g1))) =
   peq-sym _ _ (RL0.single-shift (mul a b0) (scal a g1)) ;
  shifted (a : R) (ab : I.In (mul a b0)) (j : X) : InI (cons z (pmul (f j) (scal a g1))) =
   in-peq (cons z (pmul (f j) (scal a g1))) (pmul (f j) (cons z (scal a g1)))
    (peq-sym _ _ (RM.mul-shift-right (f j) (scal a g1)))
    (add-cancel (pmul (f j) (RL0.constantP (mul a b0))) (pmul (f j) (cons z (scal a g1)))
     (in-peq (pmul (f j) (RL0.constantP (mul a b0))) (scal (mul a b0) (f j))
      (RL0.eq _ _ _ (RM.mul-comm (f j) (RL0.constantP (mul a b0))) (RM.mul-single-left (mul a b0) (f j)))
      (in-scal-left (mul a b0) (f j) ab))
     (in-peq (addP (pmul (f j) (RL0.constantP (mul a b0))) (pmul (f j) (cons z (scal a g1)))) (scal a (pmul (f j) g))
      (RL0.eq _ _ _ (peq-sym _ _ (RM.mul-add-right (f j) (RL0.constantP (mul a b0)) (cons z (scal a g1))))
       (RL0.eq _ _ _ (RM.mul-cong (f j) (f j) _ _ (RL0.rr (f j)) (peq-sym _ _ (split-g a)))
        (RM.mul-scal-right a (f j) g)))
      (in-scal a (pmul (f j) g) (kg j)))) ;
  scal-g1 (a : R) (ab : I.In (mul a b0)) : InI (scal a g1) =
   ih (scal a g1) (trans (plen-scal a g1) len) (\ j -> shift-in (pmul (f j) (scal a g1)) (shifted a ab j)) ;
  scal-g (a : R) (ab : I.In (mul a b0)) : InI (scal a g) = split {
   zero -> ab ; suc k -> scal-g1 a ab k } ;
  -- the tails f' = a + X f'' of a polynomial with f' g in I[X]
  low (a : R) (f2 : P) (h : InI (pmul (cons a f2) g)) : I.In (mul a b0) =
   IL.in-eq (coef (pmul (cons a f2) g) zero) (mul a b0) (coef0-pmul (cons a f2) g) (h zero) ;
  rest (a : R) (f2 : P) (h : InI (pmul (cons a f2) g)) : InI (pmul f2 g) =
   shift-in (pmul f2 g)
    (add-cancel (scal a g) (cons z (pmul f2 g)) (scal-g a (low a f2 h))
     (in-peq (addP (scal a g) (cons z (pmul f2 g))) (pmul (cons a f2) g) (peq-sym _ _ (RM.mul-cons-left a f2 g)) h)) ;
  inner : (f1 : P) -> InI (pmul f1 g) -> (i : Nat) -> InI (scal (coef f1 i) g) = split {
   nil -> \ h i -> in-peq (scal z g) nil (RL0.scal-zero g) in-nil ;
   cons a f2 | r -> \ h -> split {
    zero -> scal-g a (low a f2 h) ;
    suc i -> r (rest a f2 h) i } } ;
  -- every coefficient of g is killed by c(f) modulo I
  result : InI g = \ k ->
   reg (coef g k) tt (\ ci -> IL.in-eq (coef (scal (content ci) g) k) (mul (content ci) (coef g k))
     (coef-scal (content ci) g k) (inner (f ci.1) (kg ci.1) ci.2 k)) ;
 } ;

 -- (1)
 main (reg : RI.Regular Content content) : (n : Nat) (g : P) -> Id Nat (plen g) n -> Kill g -> InI g = split {
  zero -> split {
   nil -> \ e kg -> in-nil ;
   cons b g1 -> \ e kg -> efq (suc-zero (plen g1) e) } ;
  suc n | ih -> split {
   nil -> \ e kg -> in-nil ;
   cons b0 g1 -> \ e kg -> Inner[reg,n,ih,b0,g1,suc-inj e,kg].result } } ;
 mccoy (reg : RI.Regular Content content) : PolyRegular =
  \ g kg -> main reg (plen g) g (refl (plen g)) kg ;

 -- (2)
 kill-constant (x : R) (k : RI.ZeroOn Content content x) : Kill (cons x nil) = \ j i ->
  IL.in-eq (mul (coef (f j) i) x) (coef (pmul (f j) (cons x nil)) i)
   (sym (trans (coef-addP (scal x (f j)) (cons z nil) i)
    (trans (ap (add (coef (scal x (f j)) i)) (cz i))
     (trans (addZ (coef (scal x (f j)) i))
      (trans (coef-scal x (f j) i) (mulC x (coef (f j) i)))))))
   (k (j,i)) ;
 converse (h : PolyRegular) : RI.Regular Content content = \ x t k -> h (cons x nil) (kill-constant x k) zero ;
} ;
