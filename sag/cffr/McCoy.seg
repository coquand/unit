-- cffr Theorem 2.4 (McCoy), first form: if u : R^p -> R^q is injective,
-- then its wedge i(u_1) ... i(u_p) is regular: x i(u_1) ... i(u_p) = 0
-- implies x = 0.  (Minors.seg reads this as: D_p(u) is regular.)
--
-- Induction on p, for every ring at once (q fixed).
-- p = 0: the wedge is 1, and the coefficient of 1 in x 1 is x.
-- p + 1: let v = u_{p+1}.  Its coordinates v_1, ..., v_q form a regular
-- ideal: v_j y = 0 for all j says that u sends (0, ..., 0, y) to 0, so
-- y = 0.  By Lemma 2.3 (LocalRegular.Zero) it is enough to show x = 0 in
-- each L = R[1/v_i].  There u stays injective (Flat), the wedge is the
-- wedge of the images (BaseChange), and v_i is a unit; with
-- lambda = v_i^{-1} e_i we have lambda . v = 1, so by WedgeStep.Reduce
-- x times the wedge of the p sheared columns is 0, and these columns are
-- injective.  By induction x = 0 in L.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (q : Nat) {
 module Start (Rg : CRing) (setR : Pr.isSet Rg.R) (u : Matrices[l].Over[Rg].Mat zero q) {
  open Rg ;
  module EC = ExteriorCoordinates[l].Over[Rg,setR] ;
  open ExteriorModel[l].Over[Rg] ;
  -- the empty subset, and the coefficient of 1
  empty : (n : Nat) -> ExteriorCoordinates[l].Index n = split { zero -> tt ; suc n | r -> inl r } ;
  coeff-emb : (n : Nat) (c : R) -> Id R (EC.coeff n (emb n c) (empty n)) c = split {
   zero -> \ c -> refl c ; suc n | r -> \ c -> r c } ;
  result : Matrices[l].Over[Rg].WedgeRegular zero q u = \ x h ->
   calc R { x
    =< sym (mulO x) > mul x o
    =< ap (mul x) (sym (coeff-emb q o)) > mul x (EC.coeff q (emb q o) (empty q))
    =< sym (EC.coeff-scale q x (emb q o) (empty q)) > EC.coeff q (escale q x (emb q o)) (empty q)
    =< ap (\ y -> EC.coeff q y (empty q)) h > EC.coeff q (ezero q) (empty q)
    =< EC.coeff-zero q (empty q) > z } ;
 } ;

 module Step (p : Nat)
  (ih : (Rg : CRing) (setR : Pr.isSet Rg.R) (u : Matrices[l].Over[Rg].Mat p q) ->
   Matrices[l].Over[Rg].Injective p q u -> Matrices[l].Over[Rg].WedgeRegular p q u)
  (Rg : CRing) (setR : Pr.isSet Rg.R) (u : Matrices[l].Over[Rg].Mat (suc p) q)
  (inj : Matrices[l].Over[Rg].Injective (suc p) q u) (x : Rg.R)
  (hx : Id (ExteriorModel[l].Over[Rg].Ext q)
         (ExteriorModel[l].Over[Rg].escale q x (Matrices[l].Over[Rg].wedge (suc p) q u))
         (ExteriorModel[l].Over[Rg].ezero q)) {
  open Rg ;
  module MR = Matrices[l].Over[Rg] ;
  module RI = RegularIdeal[l].Over[Rg,RegularIdeal[l].self Rg] ;
  v : MR.Vec q = u (inr tt) ;
  -- the coordinates of v form a regular ideal
  last-only (y : R) : MR.Vec (suc p) = split { inl k -> z ; inr t -> y } ;
  v-regular : RI.Regular (Fin q) v = \ y t h -> inj (last-only y) (\ j ->
   calc R { add (mul y (v j)) (MR.S.sum p (\ k -> mul z (u (inl k) j)))
    =< ap (add (mul y (v j))) (trans (MR.S.sum-cong p (\ k -> mul z (u (inl k) j)) (\ k -> z) (\ k -> RL[Rg].zero-mul (u (inl k) j)))
                                (MR.S.sum-zero p))
    > add (mul y (v j)) z
    =< addZ (mul y (v j)) > mul y (v j)
    =< mulC y (v j) > mul (v j) y
    =< h j > z }) (inr tt) ;
  -- in R[1/v_i]
  module Loc (i : Fin q) {
   module FL = Flat[l].Over[Rg,v i] ;
   module ML = Matrices[l].Over[FL.I.ring] ;
   module NL = ExteriorModel[l].Over[FL.I.ring] ;
   module BC = BaseChange[l].Over[Rg,FL.I.ring,FL.I.inclusion] ;
   w : ML.Mat (suc p) q = FL.extend (suc p) q u ;
   hw : Id (NL.Ext q) (NL.escale q (FL.k x) (ML.wedge (suc p) q w)) (NL.ezero q) =
    calc (NL.Ext q) { NL.escale q (FL.k x) (ML.wedge (suc p) q w)
     =< ap (NL.escale q (FL.k x)) (sym (BC.B-wedge q (suc p) u)) > NL.escale q (FL.k x) (BC.B q (MR.wedge (suc p) q u))
     =< sym (BC.B-scale q x (MR.wedge (suc p) q u)) > BC.B q (ExteriorModel[l].Over[Rg].escale q x (MR.wedge (suc p) q u))
     =< ap (BC.B q) hx > BC.B q (ExteriorModel[l].Over[Rg].ezero q)
     =< BC.B-zero q > NL.ezero q } ;
   inverse : RL[FL.I.ring].unit (FL.k (v i)) = FL.Bm.inverse (v i) (suc zero,sym (mulO (v i))) ;
   module WS = WedgeStep[l].Over[FL.I.ring,FL.Bm.set,q] ;
   lam : ML.Vec q = WS.sdelta q inverse.1 i ;
   one : Id FL.I.ring.R (WS.VC.vdot q lam (w (inr tt))) FL.I.ring.o =
    trans (WS.vdot-delta q inverse.1 i (w (inr tt)))
     (trans (FL.I.ring.mulC inverse.1 (FL.k (v i))) inverse.2) ;
   module Rd = WS.Reduce[lam,p,w,one] ;
   local : Id FL.I.ring.R (FL.k x) FL.I.ring.z =
    ih FL.I.ring FL.Bm.set Rd.sheared (Rd.injective (FL.injective (suc p) q u inj)) (FL.k x) (Rd.kill (FL.k x) hw) ;
  } ;
  result : Id R x z =
   LocalRegular[l].AtFractions[Rg,setR,q,v].LR.Zero[v-regular,x,\ i -> Loc[i].local].result ;
 } ;

 mccoy : (p : Nat) (Rg : CRing) (setR : Pr.isSet Rg.R) (u : Matrices[l].Over[Rg].Mat p q) ->
  Matrices[l].Over[Rg].Injective p q u -> Matrices[l].Over[Rg].WedgeRegular p q u = split {
  zero -> \ Rg setR u inj -> Start[Rg,setR,u].result ;
  suc p | ih -> \ Rg setR u inj x hx -> Step[p,ih,Rg,setR,u,inj,x,hx].result } ;
} ;
