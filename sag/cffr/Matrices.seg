-- Matrices by their columns (CFFR-DESIGN §4): a linear map R^p -> R^q is
-- u : Fin p -> Vec q, and  (u x)_j = sum_k x_k u_kj  (as Determinant.act).
-- u is injective when u x = 0 implies x = 0.  The product of the
-- generators of the columns, i(u_1) ... i(u_p) in the exterior algebra of
-- R^q, is the wedge of u; its coefficients are the p x p minors of u.  The
-- wedge is regular when x . wedge = 0 implies x = 0.
level l ; open Ring[l] ;
module Ps = Presentations[l] ;
module Over (Rg : CRing) {
 open Rg ;
 open ExteriorModel[l].Over[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 Vec (q : Nat) : U l = Ps.Fin q -> R ;
 Mat (p q : Nat) : U l = Ps.Fin p -> Vec q ;
 apply (p q : Nat) (u : Mat p q) (x : Vec p) : Vec q = \ j -> S.sum p (\ k -> mul (x k) (u k j)) ;
 apply-value (p q : Nat) (u : Mat p q) (x : Vec p) (j : Ps.Fin q) :
  Id R (apply p q u x j) (S.sum p (\ k -> mul (x k) (u k j))) = refl (apply p q u x j) ;
 Injective (p q : Nat) (u : Mat p q) : U l =
  (x : Vec p) -> ((j : Ps.Fin q) -> Id R (apply p q u x j) z) -> (k : Ps.Fin p) -> Id R (x k) z ;
 wedge (p q : Nat) (u : Mat p q) : Ext q = eprod q p (\ k -> gen q (u k)) ;
 wedge-step (p q : Nat) (u : Mat (suc p) q) :
  Id (Ext q) (wedge (suc p) q u) (emul q (wedge p q (\ k -> u (inl k))) (gen q (u (inr tt)))) =
  refl (wedge (suc p) q u) ;
 WedgeRegular (p q : Nat) (u : Mat p q) : U l =
  (x : R) -> Id (Ext q) (escale q x (wedge p q u)) (ezero q) -> Id R x z ;
 -- complexes R^p -A-> R^q -B-> R^l
 ComposeZero (p q l1 : Nat) (A : Mat p q) (B : Mat q l1) : U l =
  (k : Ps.Fin p) (j : Ps.Fin l1) -> Id R (apply q l1 B (A k) j) z ;
 Exact (p q l1 : Nat) (A : Mat p q) (B : Mat q l1) : U l =
  (y : Vec q) -> ((j : Ps.Fin l1) -> Id R (apply q l1 B y j) z) ->
  Truncation[l].Trunc[(x : Vec p) * ((i : Ps.Fin q) -> Id R (apply p q A x i) (y i))].carrier ;
 -- apply is linear in the vector
 apply-comb (p q : Nat) (u : Mat p q) (v w : Vec p) (c : R) (j : Ps.Fin q) :
  Id R (apply p q u (\ k -> add (v k) (mul c (w k))) j) (add (apply p q u v j) (mul c (apply p q u w j))) =
  trans (S.sum-cong p (\ k -> mul (add (v k) (mul c (w k))) (u k j))
          (\ k -> add (mul (v k) (u k j)) (mul c (mul (w k) (u k j))))
          (\ k -> trans (RL[Rg].dist-left (v k) (mul c (w k)) (u k j)) (ap (add (mul (v k) (u k j))) (sym (mulA c (w k) (u k j))))))
   (trans (S.sum-add p (\ k -> mul (v k) (u k j)) (\ k -> mul c (mul (w k) (u k j))))
    (ap (add (apply p q u v j)) (S.sum-scale c p (\ k -> mul (w k) (u k j))))) ;
 apply-scale (p q : Nat) (u : Mat p q) (c : R) (v : Vec p) (j : Ps.Fin q) :
  Id R (apply p q u (\ k -> mul c (v k)) j) (mul c (apply p q u v j)) =
  trans (S.sum-cong p (\ k -> mul (mul c (v k)) (u k j)) (\ k -> mul c (mul (v k) (u k j))) (\ k -> sym (mulA c (v k) (u k j))))
   (S.sum-scale c p (\ k -> mul (v k) (u k j))) ;
 -- exchange of two finite sums
 interchange : (r n : Nat) (v : Ps.Fin r -> Ps.Fin n -> R) ->
  Id R (S.sum r (\ j -> S.sum n (v j))) (S.sum n (\ i -> S.sum r (\ j -> v j i))) = split {
  zero -> \ n v -> sym (S.sum-zero n) ;
  suc r | ih -> \ n v ->
   trans (ap (add (S.sum n (v (inr tt)))) (ih n (\ j -> v (inl j))))
    (sym (S.sum-add n (v (inr tt)) (\ i -> S.sum r (\ j -> v (inl j) i)))) } ;
 -- (B A) x = B (A x), columnwise data
 apply-apply (p q l1 : Nat) (A : Mat p q) (B : Mat q l1) (x : Vec p) (j : Ps.Fin l1) :
  Id R (apply q l1 B (apply p q A x) j) (S.sum p (\ k -> mul (x k) (apply q l1 B (A k) j))) =
  trans (S.sum-cong q (\ i -> mul (S.sum p (\ k -> mul (x k) (A k i))) (B i j))
          (\ i -> S.sum p (\ k -> mul (x k) (mul (A k i) (B i j))))
          (\ i -> trans (mulC (S.sum p (\ k -> mul (x k) (A k i))) (B i j))
           (trans (sym (S.sum-scale (B i j) p (\ k -> mul (x k) (A k i))))
            (S.sum-cong p _ _ (\ k -> trans (RL[Rg].mul-swap (B i j) (x k) (A k i)) (ap (mul (x k)) (mulC (B i j) (A k i))))))))
   (trans (interchange q p (\ i k -> mul (x k) (mul (A k i) (B i j))))
    (S.sum-cong p _ _ (\ k -> S.sum-scale (x k) q (\ i -> mul (A k i) (B i j))))) ;
 compose-zero (p q l1 : Nat) (A : Mat p q) (B : Mat q l1) (h : ComposeZero p q l1 A B) (x : Vec p) (j : Ps.Fin l1) :
  Id R (apply q l1 B (apply p q A x) j) z =
  trans (apply-apply p q l1 A B x j)
   (trans (S.sum-cong p _ (\ k -> z) (\ k -> trans (ap (mul (x k)) (h k j)) (RL[Rg].mul-zero (x k)))) (S.sum-zero p)) ;
} ;
