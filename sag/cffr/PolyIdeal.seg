-- The extension J.R[X] of a finitely generated ideal J = (J_1, ..., J_n) of R:
-- g lies in J.R[X] iff every coefficient of g lies in J.
-- On lists: g = sum_j J_j h_j (comb h) gives coef g k = sum_j J_j coef h_j k;
-- conversely, from coordinates of each coefficient of g = c + X g' one
-- builds h_j = (v_j + X h'_j) by induction on g (from-coeff).
-- In R[X] (PolynomialRing): J.R[X] is the ideal generated by the constants
-- J_j (Generated over AX.ring); both directions pass to representatives
-- (finite choice for the coordinates in R[X]).
level l ; open Ring[l] ; open Poly[l] ; open Mul[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (J : Fin n -> A.R) {
 open A ; open PolyR[A] ; open MulR[A] ;
 module RL0 = RawLaws[l].Laws[A] ;
 module RM = RawMultiplication[l].Laws[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module G = RegularIdeal[l].Generated[A,n,J] ;
 module PR = PolyRegular[l].Over[A,setA] ;
 module AX = PR.AX ;
 module SX = FiniteIdeal[l].Sums[AX.ring] ;
 module GX = RegularIdeal[l].Generated[AX.ring,n,\ j -> AX.constant (J j)] ;
 module IdealEq = RegularIdeal[l].IdealLaws[A,G.ideal] ;

 -- on lists
 psum : (m : Nat) -> (Fin m -> P) -> P = split {
  zero -> \ w -> nil ; suc m | r -> \ w -> addP (w (inr tt)) (r (\ i -> w (inl i))) } ;
 coef-psum : (m : Nat) (w : Fin m -> P) (k : Nat) -> Id R (coef (psum m w) k) (S.sum m (\ i -> coef (w i) k)) = split {
  zero -> \ w k -> refl z ;
  suc m | r -> \ w k -> trans (coef-addP (w (inr tt)) (psum m (\ i -> w (inl i))) k)
   (ap (add (coef (w (inr tt)) k)) (r (\ i -> w (inl i)) k)) } ;
 comb (h : Fin n -> P) : P = psum n (\ j -> scal (J j) (h j)) ;
 coef-comb (h : Fin n -> P) (k : Nat) : Id R (coef (comb h) k) (S.lin n J (\ j -> coef (h j) k)) =
  trans (coef-psum n (\ j -> scal (J j) (h j)) k) (S.sum-cong n (\ j -> coef (scal (J j) (h j)) k) (\ j -> mul (J j) (coef (h j) k)) (\ j -> coef-scal (J j) (h j) k)) ;
 InJ (p : P) : U l = (k : Nat) -> G.In (coef p k) ;
 Combo (p : P) : U l = (h : Fin n -> P) * peq p (comb h) ;
 to-coeff (p : P) (c : Combo p) : InJ p = \ k ->
  Tr.Trunc[S.Coordinates n J (coef p k)].inc
   (\ j -> coef (c.1 j) k,trans (sym (coef-comb c.1 k)) (sym (c.2 k))) ;
 combo-nil : Combo nil =
  (\ j -> nil,\ k -> sym (trans (coef-comb (\ j -> nil) k) (S.lin-zero n J))) ;
 module ConsCombo (c : R) (p1 : P) (u : S.Coordinates n J c) (w : Combo p1) {
  h (j : Fin n) : P = cons (u.1 j) (w.1 j) ;
  eq : peq (cons c p1) (comb h) = split {
   zero -> trans (sym u.2) (sym (coef-comb h zero)) ;
   suc k -> trans (w.2 k) (trans (coef-comb w.1 k) (sym (coef-comb h (suc k)))) } ;
  result : Combo (cons c p1) = (h,eq) ;
 } ;
 from-coeff : (p : P) -> InJ p -> Tr.Trunc[Combo p].carrier = split {
  nil -> \ e -> Tr.Trunc[Combo nil].inc combo-nil ;
  cons c p1 | r -> \ e -> TC.map2 (S.Coordinates n J c) (Combo p1) (Combo (cons c p1))
   (\ u w -> ConsCombo[c,p1,u,w].result) (e zero) (r (\ k -> e (suc k))) } ;

 -- in R[X]
 sum-include : (m : Nat) (h : Fin m -> P) (c : Fin m -> R) ->
  Id AX.Carrier (SX.sum m (\ j -> AX.mulQ (AX.constant (c j)) (AX.include (h j))))
   (AX.include (psum m (\ j -> scal (c j) (h j)))) = split {
  zero -> \ h c -> refl AX.zeroQ ;
  suc m | r -> \ h c ->
   trans (ap (AX.addQ (AX.mulQ (AX.constant (c (inr tt))) (AX.include (h (inr tt)))))
          (r (\ j -> h (inl j)) (\ j -> c (inl j))))
    (trans (ap (\ y -> AX.addQ y (AX.include (psum m (\ j -> scal (c (inl j)) (h (inl j))))))
            (trans (PR.product (RL0.constantP (c (inr tt))) (h (inr tt)))
             (AX.Q.relates _ _ (RM.mul-single-left (c (inr tt)) (h (inr tt))))))
     (AX.Add.beta (scal (c (inr tt)) (h (inr tt))) (psum m (\ j -> scal (c (inl j)) (h (inl j)))))) } ;
 -- g in J.R[X] gives every coefficient in J
 module ToCoeff (g : AX.Carrier) (cx : SX.Coordinates n (\ j -> AX.constant (J j)) g)
  (fr : (j : Fin n) -> PR.Rep (cx.1 j)) (k : Nat) {
  h (j : Fin n) : P = (fr j).1 ;
  as-comb : Id AX.Carrier g (AX.include (comb h)) =
   trans (sym cx.2)
    (trans (SX.sum-cong n (\ j -> AX.mulQ (AX.constant (J j)) (cx.1 j)) (\ j -> AX.mulQ (AX.constant (J j)) (AX.include (h j)))
             (\ j -> ap (AX.mulQ (AX.constant (J j))) (sym (fr j).2)))
     (sum-include n h J)) ;
  result : G.In (PR.coefQ g k) =
   IdealEq.in-eq (coef (comb h) k) (PR.coefQ g k)
    (trans (sym (PR.coefQ-include (comb h) k)) (ap (\ y -> PR.coefQ y k) (sym as-comb)))
    (to-coeff (comb h) (h,RL0.rr (comb h)) k) ;
 } ;
 to-coefficients (g : AX.Carrier) (e : GX.In g) (k : Nat) : G.In (PR.coefQ g k) =
  Tr.Trunc[SX.Coordinates n (\ j -> AX.constant (J j)) g].induction @l (\ w -> G.In (PR.coefQ g k))
   (\ w -> G.in-prop (PR.coefQ g k))
   (\ cx -> Tr.Trunc[(j : Fin n) -> PR.Rep (cx.1 j)].induction @l (\ w -> G.In (PR.coefQ g k))
     (\ w -> G.in-prop (PR.coefQ g k)) (\ fr -> ToCoeff[g,cx,fr,k].result)
     (AffineFinite[l].choice n (\ j -> PR.Rep (cx.1 j)) (\ j -> PR.rep (cx.1 j)))) e ;
 -- every coefficient in J gives g in J.R[X]
 module FromCoeff (g : AX.Carrier) (gp : PR.Rep g) (c : Combo gp.1) {
  coordinates : SX.Coordinates n (\ j -> AX.constant (J j)) g =
   (\ j -> AX.include (c.1 j),
    trans (sum-include n c.1 J) (trans (AX.Q.relates _ _ (peq-sym _ _ c.2)) gp.2)) ;
 } ;
 from-coefficients (g : AX.Carrier) (e : (k : Nat) -> G.In (PR.coefQ g k)) : GX.In g =
  Tr.Trunc[PR.Rep g].induction @l (\ w -> GX.In g) (\ w -> GX.in-prop g)
   (\ gp -> TC.map (Combo gp.1) (SX.Coordinates n (\ j -> AX.constant (J j)) g)
     (\ c -> FromCoeff[g,gp,c].coordinates)
     (from-coeff gp.1 (\ k -> IdealEq.in-eq (PR.coefQ g k) (coef gp.1 k)
        (trans (ap (\ y -> PR.coefQ y k) (sym gp.2)) (PR.coefQ-include gp.1 k)) (e k))))
   (PR.rep g) ;
} ;
