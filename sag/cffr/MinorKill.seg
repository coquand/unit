-- Killing D_k(u) is killing all wedges of k vectors in the image of u.
--
-- x kills y in the exterior algebra when x y = 0, i.e. x kills every
-- coefficient of y (from-coeff, to-coeff).  If x kills D_k(u) (the
-- coefficients of i(u_c1) ... i(u_ck) for all choices c of k columns),
-- then x kills i(u C_1) ... i(u C_k) for all vectors C_1, ..., C_k of R^p.
-- Proof: more generally, for every Y, if x kills i(u_c1)...i(u_cj) Y for
-- all c then x kills i(u C_1)...i(u C_j) Y for all C (image, induction on
-- j).  For j + 1, write the product as P i(u C_{j+1}) Y with P on j
-- factors, and apply the induction hypothesis to Y' = i(u C_{j+1}) Y: we
-- need x P' i(u v) Y = 0 for P' on j columns of u and v = C_{j+1}.  Each
-- coefficient of x P' i(u v) Y is a linear form in v (gen, apply, the
-- product and the scaling are linear), so it is sum_m v_m times its value
-- at e_m, where i(u e_m) = i(u_m) and P' i(u_m) is a product of j + 1
-- columns of u: 0.
-- Consequences: D_k(u C) is killed by what kills D_k(u) (image-compose);
-- so column operations do not change the annihilator of D_k.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module EC = ExteriorCoordinates[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module AD = Adjugate[l].Over[Rg,setR] ;
 module D = MnSums[l].Over[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module RI = RegularIdeal[l].Over[Rg,RegularIdeal[l].self Rg] ;

 KillsW (q : Nat) (x : R) (y : Ext q) : U l = Id (Ext q) (escale q x y) (ezero q) ;
 from-coeff (q : Nat) (x : R) (y : Ext q)
  (h : (I : ExteriorCoordinates[l].Index q) -> Id R (mul (EC.coeff q y I) x) z) : KillsW q x y =
  EC.ext q (escale q x y) (ezero q) (\ I ->
   trans (EC.coeff-scale q x y I) (trans (mulC x (EC.coeff q y I)) (trans (h I) (sym (EC.coeff-zero q I))))) ;
 to-coeff (q : Nat) (x : R) (y : Ext q) (h : KillsW q x y) (I : ExteriorCoordinates[l].Index q) :
  Id R (mul (EC.coeff q y I) x) z =
  trans (mulC (EC.coeff q y I) x)
   (trans (sym (EC.coeff-scale q x y I)) (trans (ap (\ w -> EC.coeff q w I) h) (EC.coeff-zero q I))) ;

 -- the columns of u chosen by c, and the image vectors u C_t
 cols (k p q : Nat) (u : MM.Mat p q) (c : Fin k -> Fin p) : MM.Mat k q = \ t -> u (c t) ;
 compose (k p q : Nat) (u : MM.Mat p q) (C : MM.Mat k p) : MM.Mat k q = \ t -> MM.apply p q u (C t) ;
 ColumnsKilled (k p q : Nat) (u : MM.Mat p q) (x : R) : U l =
  (c : Fin k -> Fin p) -> KillsW q x (MM.wedge k q (cols k p q u c)) ;
 ImageKilled (k p q : Nat) (u : MM.Mat p q) (x : R) : U l =
  (C : MM.Mat k p) -> KillsW q x (MM.wedge k q (compose k p q u C)) ;
 columns (k p q : Nat) (u : MM.Mat p q) (x : R) (h : RI.ZeroOn (MI.Index k p q) (MI.minors k p q u) x) :
  ColumnsKilled k p q u x =
  \ c -> from-coeff q x (MM.wedge k q (cols k p q u c)) (\ I -> h (c,I)) ;

 -- generally: products with coefficients in an ideal I
 module Image (p q : Nat) (u : MM.Mat p q) (I : RegularIdeal[l].IdealPred[Rg]) {
  module MP = MI.Map[p,q,u] ;
  module IE = IdealExt[l].Over[Rg,setR,I] ;
  module IL = RegularIdeal[l].IdealLaws[Rg,I] ;
  -- v |-> P i(u v) Y is linear
  phi (P Y : Ext q) (v : MM.Vec p) : Ext q = emul q P (emul q (gen q (MM.apply p q u v)) Y) ;
  phi-add (P Y : Ext q) (a b : MM.Vec p) :
   Id (Ext q) (phi P Y (AL.vadd p a b)) (eadd q (phi P Y a) (phi P Y b)) =
   calc (Ext q) { phi P Y (AL.vadd p a b)
    =< ap (\ w -> emul q P (emul q (gen q w) Y))
        (MI.vec-ext q (MM.apply p q u (AL.vadd p a b)) (AL.vadd q (MM.apply p q u a) (MM.apply p q u b)) (MP.apply-add a b))
    > emul q P (emul q (gen q (AL.vadd q (MM.apply p q u a) (MM.apply p q u b))) Y)
    =< ap (\ w -> emul q P (emul q w Y)) (EA.gen-add q (MM.apply p q u a) (MM.apply p q u b))
    > emul q P (emul q (eadd q (gen q (MM.apply p q u a)) (gen q (MM.apply p q u b))) Y)
    =< ap (emul q P) (EA.dist-right q (gen q (MM.apply p q u a)) (gen q (MM.apply p q u b)) Y)
    > emul q P (eadd q (emul q (gen q (MM.apply p q u a)) Y) (emul q (gen q (MM.apply p q u b)) Y))
    =< EA.dist-left q P (emul q (gen q (MM.apply p q u a)) Y) (emul q (gen q (MM.apply p q u b)) Y)
    > eadd q (phi P Y a) (phi P Y b) } ;
  phi-scale (P Y : Ext q) (c : R) (a : MM.Vec p) :
   Id (Ext q) (phi P Y (AL.vscale p c a)) (escale q c (phi P Y a)) =
   calc (Ext q) { phi P Y (AL.vscale p c a)
    =< ap (\ w -> emul q P (emul q (gen q w) Y))
        (MI.vec-ext q (MM.apply p q u (AL.vscale p c a)) (AL.vscale q c (MM.apply p q u a)) (MP.apply-scale c a))
    > emul q P (emul q (gen q (AL.vscale q c (MM.apply p q u a))) Y)
    =< ap (\ w -> emul q P (emul q w Y)) (EA.gen-scale q c (MM.apply p q u a))
    > emul q P (emul q (escale q c (gen q (MM.apply p q u a))) Y)
    =< ap (emul q P) (EA.scale-mul-left q c (gen q (MM.apply p q u a)) Y)
    > emul q P (escale q c (emul q (gen q (MM.apply p q u a)) Y))
    =< EA.scale-mul-right q c P (emul q (gen q (MM.apply p q u a)) Y)
    > escale q c (phi P Y a) } ;
  -- a coefficient of phi, as a linear form
  form (P Y : Ext q) (J : ExteriorCoordinates[l].Index q) (v : MM.Vec p) : R = EC.coeff q (phi P Y v) J ;
  form-lin (P Y : Ext q) (J : ExteriorCoordinates[l].Index q) : AD.LinForm p (form P Y J) =
   (\ a b -> trans (ap (\ w -> EC.coeff q w J) (phi-add P Y a b)) (EC.coeff-add q (phi P Y a) (phi P Y b) J),
    \ c a -> trans (ap (\ w -> EC.coeff q w J) (phi-scale P Y c a)) (EC.coeff-scale q c (phi P Y a) J)) ;
  -- the extension of a choice of columns by one more column
  snoc (j : Nat) (c : Fin j -> Fin p) (m : Fin p) : Fin (suc j) -> Fin p = split {
   inl t -> c t ; inr s -> m } ;
  in-sum : (n : Nat) (v : Fin n -> R) -> ((i : Fin n) -> I.In (v i)) -> I.In (S.sum n v) = split {
   zero -> \ v h -> I.in-zero ;
   suc n | r -> \ v h -> I.in-add (v (inr tt)) (S.sum n (\ i -> v (inl i))) (h (inr tt)) (r (\ i -> v (inl i)) (\ i -> h (inl i))) } ;
  -- the step
  step (j : Nat) (Y : Ext q) (c : Fin j -> Fin p)
   (h : (c1 : Fin (suc j) -> Fin p) -> IE.InCoeff q (emul q (MM.wedge (suc j) q (cols (suc j) p q u c1)) Y))
   (v : MM.Vec p) : IE.InCoeff q (emul q (MM.wedge j q (cols j p q u c)) (emul q (gen q (MM.apply p q u v)) Y)) = \ J ->
   IL.in-eq (S.sum p (\ i -> mul (v i) (form (MM.wedge j q (cols j p q u c)) Y J (D.delta p i))))
    (form (MM.wedge j q (cols j p q u c)) Y J v)
    (sym (AD.form-expand p (form (MM.wedge j q (cols j p q u c)) Y J) (form-lin (MM.wedge j q (cols j p q u c)) Y J) v))
    (in-sum p (\ i -> mul (v i) (form (MM.wedge j q (cols j p q u c)) Y J (D.delta p i))) (\ i ->
     I.in-mul (v i) (form (MM.wedge j q (cols j p q u c)) Y J (D.delta p i))
      (IL.in-eq (EC.coeff q (emul q (MM.wedge (suc j) q (cols (suc j) p q u (snoc j c i))) Y) J)
        (form (MM.wedge j q (cols j p q u c)) Y J (D.delta p i))
        (sym (trans (ap (\ w -> EC.coeff q (emul q (MM.wedge j q (cols j p q u c)) (emul q (gen q w) Y)) J) (MP.apply-delta i))
          (ap (\ w -> EC.coeff q w J) (EA.mulA' q (MM.wedge j q (cols j p q u c)) (gen q (u i)) Y))))
        (h (snoc j c i) J)))) ;
  image : (j : Nat) (Y : Ext q) ->
   ((c : Fin j -> Fin p) -> IE.InCoeff q (emul q (MM.wedge j q (cols j p q u c)) Y)) ->
   (C : MM.Mat j p) -> IE.InCoeff q (emul q (MM.wedge j q (compose j p q u C)) Y) = split {
   zero -> \ Y h C -> h (\ t -> efq t) ;
   suc j | r -> \ Y h C ->
    IE.in-eq q (emul q (MM.wedge j q (compose j p q u (\ t -> C (inl t)))) (emul q (gen q (MM.apply p q u (C (inr tt)))) Y))
     (emul q (MM.wedge (suc j) q (compose (suc j) p q u C)) Y)
     (EA.mulA' q (MM.wedge j q (compose j p q u (\ t -> C (inl t)))) (gen q (MM.apply p q u (C (inr tt)))) Y)
     (r (emul q (gen q (MM.apply p q u (C (inr tt)))) Y) (\ c -> step j Y c h (C (inr tt))) (\ t -> C (inl t))) } ;
  -- the columns in I give the image in I
  result (k : Nat) (h : (c : Fin k -> Fin p) -> IE.InCoeff q (MM.wedge k q (cols k p q u c))) (C : MM.Mat k p) :
   IE.InCoeff q (MM.wedge k q (compose k p q u C)) =
   IE.in-eq q (emul q (MM.wedge k q (compose k p q u C)) (eone q)) (MM.wedge k q (compose k p q u C))
    (EA.one-right q (MM.wedge k q (compose k p q u C)))
    (image k (eone q) (\ c -> IE.in-eq q (MM.wedge k q (cols k p q u c)) (emul q (MM.wedge k q (cols k p q u c)) (eone q))
      (sym (EA.one-right q (MM.wedge k q (cols k p q u c)))) (h c)) C) ;
 } ;
 -- x kills D_k(u) => x kills the wedges of k vectors of the image of u (I = Ann(x))
 image (k p q : Nat) (u : MM.Mat p q) (x : R) (h : ColumnsKilled k p q u x) : ImageKilled k p q u x =
  \ C -> from-coeff q x (MM.wedge k q (compose k p q u C))
   (Image[p,q,u,IdealExt[l].annihilator Rg x].result k (\ c -> to-coeff q x (MM.wedge k q (cols k p q u c)) (h c)) C) ;
} ;
