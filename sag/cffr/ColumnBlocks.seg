-- Column blocks, for cffr Lemma 8.2.  A square matrix of size q + p is
-- written by its columns B = (y_1, ..., y_p, v_1, ..., v_q) = `concat q v`
-- (y a parameter): the v's occupy the last q positions.  As in
-- ExteriorCoordinates, Fin (1 + m) = Fin m + Top and Index (1 + m) =
-- Index m + Index m (omit / contain the last position), and plus recurses
-- on its first argument, so Index (q + p) peels off the v positions first.
-- K0 = lift q (full p) is the subset of the first p positions.
--
-- * Clauses: the defining equations of selected and replace at an inl /
--   inr subset (ExteriorReplacement locks them; they are stated here once,
--   by refl, and locked again).
-- * selected-product m K c = the product of the columns of c selected by
--   K; product-inl, product-inr are its two clauses.
-- * concat-product: B_1 ... B_(q+p) = (y_1 ... y_p)(v_1 ... v_q), by
--   induction on q and associativity.
-- * replace-lift: replacing the columns of B at K0 by a gives
--   (a_1 ... a_p)(v_1 ... v_q): induction on q, and at q = 0 replacing all
--   columns gives a (replace-full, induction on p).
-- * selected-lift: the columns of B selected by K0 are y (with
--   selected-full at q = 0).
-- * Sums over subsets.  sum-lift: if the terms at the subsets meeting the
--   last q positions (Hit) are 0, the sum over Index (q + p) is the sum
--   over the subsets of the first p positions.  sum-full: if the terms at
--   the subsets K with |K| < p are 0, the sum over Index p is the term at
--   the full subset.  Also count-lift, count-full, low-irrefl (not p < p).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = ExteriorHomogeneous[l].Over[Rg,setR] ;
 module RP = ExteriorReplacement[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;

 -- subsets: |K| < p is impossible for K = full p, and the count of full p
 low-irrefl : (p : Nat) -> BA.Low p p -> Empty = split { zero -> \ h -> h ; suc p | r -> r } ;
 count-full : (p : Nat) -> Id Nat (BA.count p (BA.full p)) p = split {
  zero -> refl zero ; suc p | r -> ap (\ k -> suc k) r } ;
 sum-full : (p : Nat) (h : C.Index p -> R) -> ((K : C.Index p) -> BA.Low p (BA.count p K) -> Id R (h K) z) ->
  Id R (CO.S.sum p h) (h (BA.full p)) = split {
  zero -> \ h hz -> refl (h tt) ;
  suc p | r -> \ h hz ->
   trans (DU.cong (HO.scalar-sum-zero p (\ K -> h (inl K)) (\ K -> hz (inl K) (BA.count-bound p K)))
     (r (\ K -> h (inr K)) (\ K -> hz (inr K))))
    (L.zl (h (inr (BA.full p)))) } ;

 -- the subsets of the first p positions among q + p, and those meeting the last q
 module Lift (p : Nat) {
  lift : (q : Nat) -> C.Index p -> C.Index (plus q p) = split {
   zero -> \ K -> K ; suc q | r -> \ K -> inl (r K) } ;
  Hit : (q : Nat) -> C.Index (plus q p) -> U l = split {
   zero -> \ K -> Empty ; suc q | r -> split { inl K -> r K ; inr K -> Top } } ;
  count-lift : (q : Nat) (K : C.Index p) -> Id Nat (BA.count (plus q p) (lift q K)) (BA.count p K) = split {
   zero -> \ K -> refl (BA.count p K) ; suc q | r -> r } ;
  sum-lift : (q : Nat) (f : C.Index (plus q p) -> R) -> ((K : C.Index (plus q p)) -> Hit q K -> Id R (f K) z) ->
   Id R (CO.S.sum (plus q p) f) (CO.S.sum p (\ K -> f (lift q K))) = split {
   zero -> \ f h -> refl (CO.S.sum p f) ;
   suc q | r -> \ f h ->
    trans (DU.cong (r (\ K -> f (inl K)) (\ K -> h (inl K)))
      (HO.scalar-sum-zero (plus q p) (\ K -> f (inr K)) (\ K -> h (inr K) tt)))
     (addZ (CO.S.sum p (\ K -> f (inl (lift q K))))) } ;
 } ;

 -- the clauses of selected and replace
 module Clauses (X : U l) {
  module V = RP.Columns[X] ;
  transparent RP.positions ; transparent V.selected ; transparent V.replace ;
  selected-inl (m : Nat) (K : C.Index m) (c : Ps.Fin (suc m) -> X) (k : Ps.Fin (BA.count m K)) :
   Id X (V.selected (suc m) (inl K) c k) (V.selected m K (\ j -> c (inl j)) k) =
   refl (V.selected m K (\ j -> c (inl j)) k) ;
  selected-inr (m : Nat) (K : C.Index m) (c : Ps.Fin (suc m) -> X) (k : Ps.Fin (BA.count m K)) :
   Id X (V.selected (suc m) (inr K) c (inl k)) (V.selected m K (\ j -> c (inl j)) k) =
   refl (V.selected m K (\ j -> c (inl j)) k) ;
  selected-last (m : Nat) (K : C.Index m) (c : Ps.Fin (suc m) -> X) (t : Top) :
   Id X (V.selected (suc m) (inr K) c (inr t)) (c (inr t)) = refl (c (inr t)) ;
  replace-inl (m : Nat) (K : C.Index m) (a : Ps.Fin (BA.count m K) -> X) (b : Ps.Fin (suc m) -> X) (k : Ps.Fin m) :
   Id X (V.replace (suc m) (inl K) a b (inl k)) (V.replace m K a (\ j -> b (inl j)) k) =
   refl (V.replace m K a (\ j -> b (inl j)) k) ;
  replace-inl-last (m : Nat) (K : C.Index m) (a : Ps.Fin (BA.count m K) -> X) (b : Ps.Fin (suc m) -> X) (t : Top) :
   Id X (V.replace (suc m) (inl K) a b (inr t)) (b (inr t)) = refl (b (inr t)) ;
  replace-inr (m : Nat) (K : C.Index m) (a : Ps.Fin (suc (BA.count m K)) -> X) (b : Ps.Fin (suc m) -> X) (k : Ps.Fin m) :
   Id X (V.replace (suc m) (inr K) a b (inl k)) (V.replace m K (\ j -> a (inl j)) (\ j -> b (inl j)) k) =
   refl (V.replace m K (\ j -> a (inl j)) (\ j -> b (inl j)) k) ;
  replace-inr-last (m : Nat) (K : C.Index m) (a : Ps.Fin (suc (BA.count m K)) -> X) (b : Ps.Fin (suc m) -> X) (t : Top) :
   Id X (V.replace (suc m) (inr K) a b (inr t)) (a (inr t)) = refl (a (inr t)) ;
  opaque RP.positions ; opaque V.selected ; opaque V.replace ;
 } ;

 -- products of selected columns, and the full subset
 module Selected (n : Nat) {
  module V = RP.Columns[AL.Vec n] ;
  module CL = Clauses[AL.Vec n] ;
  selected-product (m : Nat) (K : C.Index m) (c : Ps.Fin m -> AL.Vec n) : Ext n =
   eprod n (BA.count m K) (\ k -> gen n (V.selected m K c k)) ;
  product-inl (m : Nat) (K : C.Index m) (c : Ps.Fin (suc m) -> AL.Vec n) :
   Id (Ext n) (selected-product (suc m) (inl K) c) (selected-product m K (\ j -> c (inl j))) =
   DT.eprod-cong n (BA.count m K) (\ k -> gen n (V.selected (suc m) (inl K) c k))
    (\ k -> gen n (V.selected m K (\ j -> c (inl j)) k)) (\ k -> ap (gen n) (CL.selected-inl m K c k)) ;
  product-inr (m : Nat) (K : C.Index m) (c : Ps.Fin (suc m) -> AL.Vec n) :
   Id (Ext n) (selected-product (suc m) (inr K) c) (emul n (selected-product m K (\ j -> c (inl j))) (gen n (c (inr tt)))) =
   DT.emul-cong n
    (DT.eprod-cong n (BA.count m K) (\ k -> gen n (V.selected (suc m) (inr K) c (inl k)))
     (\ k -> gen n (V.selected m K (\ j -> c (inl j)) k)) (\ k -> ap (gen n) (CL.selected-inr m K c k)))
    (ap (gen n) (CL.selected-last m K c tt)) ;
  replace-full : (p : Nat) (a : Ps.Fin (BA.count p (BA.full p)) -> AL.Vec n) (b : Ps.Fin p -> AL.Vec n) ->
   Id (Ext n) (eprod n p (\ k -> gen n (V.replace p (BA.full p) a b k))) (eprod n (BA.count p (BA.full p)) (\ k -> gen n (a k))) = split {
   zero -> \ a b -> refl (eone n) ;
   suc p | r -> \ a b -> DT.emul-cong n
    (trans (DT.eprod-cong n p (\ k -> gen n (V.replace (suc p) (BA.full (suc p)) a b (inl k)))
      (\ k -> gen n (V.replace p (BA.full p) (\ j -> a (inl j)) (\ j -> b (inl j)) k))
      (\ k -> ap (gen n) (CL.replace-inr p (BA.full p) a b k)))
     (r (\ j -> a (inl j)) (\ j -> b (inl j))))
    (ap (gen n) (CL.replace-inr-last p (BA.full p) a b tt)) } ;
  selected-full : (p : Nat) (b : Ps.Fin p -> AL.Vec n) ->
   Id (Ext n) (selected-product p (BA.full p) b) (eprod n p (\ k -> gen n (b k))) = split {
   zero -> \ b -> refl (eone n) ;
   suc p | r -> \ b -> trans (product-inr p (BA.full p) b)
    (ap (\ x -> emul n x (gen n (b (inr tt)))) (r (\ j -> b (inl j)))) } ;
 } ;

 -- the matrix (y, v) of size q + p
 module Blocks (n p : Nat) (y : Ps.Fin p -> AL.Vec n) {
  module V = RP.Columns[AL.Vec n] ;
  module CL = Clauses[AL.Vec n] ;
  module PR = Selected[n] ;
  module LP = Lift[p] ;
  y-product : Ext n = eprod n p (\ k -> gen n (y k)) ;
  concat : (q : Nat) -> (Ps.Fin q -> AL.Vec n) -> Ps.Fin (plus q p) -> AL.Vec n = split {
   zero -> \ v -> y ; suc q | r -> \ v -> split { inl k -> r (\ j -> v (inl j)) k ; inr t -> v (inr t) } } ;
  concat-product : (q : Nat) (v : Ps.Fin q -> AL.Vec n) ->
   Id (Ext n) (eprod n (plus q p) (\ k -> gen n (concat q v k))) (emul n y-product (eprod n q (\ k -> gen n (v k)))) = split {
   zero -> \ v -> sym (EA.one-right n y-product) ;
   suc q | r -> \ v -> calc (Ext n) {
    emul n (eprod n (plus q p) (\ k -> gen n (concat q (\ j -> v (inl j)) k))) (gen n (v (inr tt)))
     =< ap (\ x -> emul n x (gen n (v (inr tt)))) (r (\ j -> v (inl j)))
     > emul n (emul n y-product (eprod n q (\ k -> gen n (v (inl k))))) (gen n (v (inr tt)))
     =< sym (EA.mulA' n y-product (eprod n q (\ k -> gen n (v (inl k)))) (gen n (v (inr tt))))
     > emul n y-product (eprod n (suc q) (\ k -> gen n (v k))) } } ;
  replace-lift : (q : Nat) (v : Ps.Fin q -> AL.Vec n) (a : Ps.Fin (BA.count (plus q p) (LP.lift q (BA.full p))) -> AL.Vec n) ->
   Id (Ext n) (eprod n (plus q p) (\ k -> gen n (V.replace (plus q p) (LP.lift q (BA.full p)) a (concat q v) k)))
    (emul n (eprod n (BA.count (plus q p) (LP.lift q (BA.full p))) (\ k -> gen n (a k))) (eprod n q (\ k -> gen n (v k)))) = split {
   zero -> \ v a -> trans (PR.replace-full p a y) (sym (EA.one-right n (eprod n (BA.count p (BA.full p)) (\ k -> gen n (a k))))) ;
   suc q | r -> \ v a -> calc (Ext n) {
    eprod n (suc (plus q p)) (\ k -> gen n (V.replace (suc (plus q p)) (inl (LP.lift q (BA.full p))) a (concat (suc q) v) k))
     =< DT.emul-cong n
         (DT.eprod-cong n (plus q p)
          (\ k -> gen n (V.replace (suc (plus q p)) (inl (LP.lift q (BA.full p))) a (concat (suc q) v) (inl k)))
          (\ k -> gen n (V.replace (plus q p) (LP.lift q (BA.full p)) a (concat q (\ j -> v (inl j))) k))
          (\ k -> ap (gen n) (CL.replace-inl (plus q p) (LP.lift q (BA.full p)) a (concat (suc q) v) k)))
         (ap (gen n) (CL.replace-inl-last (plus q p) (LP.lift q (BA.full p)) a (concat (suc q) v) tt))
     > emul n (eprod n (plus q p) (\ k -> gen n (V.replace (plus q p) (LP.lift q (BA.full p)) a (concat q (\ j -> v (inl j))) k)))
        (gen n (v (inr tt)))
     =< ap (\ x -> emul n x (gen n (v (inr tt)))) (r (\ j -> v (inl j)) a)
     > emul n (emul n (eprod n (BA.count (plus q p) (LP.lift q (BA.full p))) (\ k -> gen n (a k))) (eprod n q (\ k -> gen n (v (inl k)))))
        (gen n (v (inr tt)))
     =< sym (EA.mulA' n (eprod n (BA.count (plus q p) (LP.lift q (BA.full p))) (\ k -> gen n (a k)))
         (eprod n q (\ k -> gen n (v (inl k)))) (gen n (v (inr tt))))
     > emul n (eprod n (BA.count (plus q p) (LP.lift q (BA.full p))) (\ k -> gen n (a k))) (eprod n (suc q) (\ k -> gen n (v k))) } } ;
  selected-lift : (q : Nat) (v : Ps.Fin q -> AL.Vec n) ->
   Id (Ext n) (PR.selected-product (plus q p) (LP.lift q (BA.full p)) (concat q v)) y-product = split {
   zero -> \ v -> PR.selected-full p y ;
   suc q | r -> \ v -> trans (PR.product-inl (plus q p) (LP.lift q (BA.full p)) (concat (suc q) v)) (r (\ j -> v (inl j))) } ;
 } ;
} ;
