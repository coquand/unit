-- cffr §2.1: minors as exterior coordinates, D_k, stable of rank p,
-- Theorem 2.4 (McCoy), the remark after it, and Theorem 2.5.
--
-- u : R^p -> R^q by its columns.  For a choice c : Fin k -> Fin p of k
-- columns, the coefficients of i(u_c1) ... i(u_ck) in the exterior algebra
-- of R^q are the k x k minors of u on the columns c (up to sign; a repeated
-- column gives 0).  D_k(u) is the ideal they generate, indexed by
-- (c, I) with I a subset of the rows (CFFR-DESIGN §4: minors are exterior
-- coordinates).  u is stable of rank r when D_{r+1}(u) = 0 and D_r(u) is
-- regular.
--
-- The algebra map Lambda(u) : Lambda(R^p) -> Lambda(R^q) extending u
-- (universal property) sends i(e_c1) ... i(e_ck) to i(u_c1) ... i(u_ck)
-- (choice).  Hence:
--  * for k > p the product of k generators of Lambda(R^p) has degree > p,
--    so it is 0, and D_k(u) = 0 (high);
--  * for k = p, i(e_c1) ... i(e_cp) = d omega with d = det(e_c1, ..., e_cp),
--    and Lambda(u)(omega) = wedge u, so each p x p minor is d times a
--    coefficient of wedge u (top).  So D_p(u) is regular iff wedge u is
--    regular (to-wedge, from-wedge).
-- Theorem 2.4: u injective gives D_{p+1}(u) = 0 (high) and D_p(u) regular
--  (McCoy.mccoy and from-wedge).
-- Remark: an injective u : R^p -> R^q with p > q forces 1 = 0, since then
--  wedge u, a product of p > q generators of Lambda(R^q), is 0, and it is
--  regular.
-- Theorem 2.5 (Cramer): if D_p(u) is regular then u is injective.  Let
--  u x = 0 and fix k.  Write P(b) for the wedge of u with column k replaced
--  by b (Adjugate.P); b |-> coefficient of P(b) is linear, so
--    0 = P(u x) = sum_j x_j P(u_j) = x_k wedge u ,
--  since P(u_j) has u_j twice for j /= k.  So x_k kills wedge u, hence
--  all p x p minors (top), hence x_k = 0.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module EC = ExteriorCoordinates[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module UP = ExteriorUniversal[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module AD = Adjugate[l].Over[Rg,setR] ;
 module D = MnSums[l].Over[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module RI = RegularIdeal[l].Over[Rg,RegularIdeal[l].self Rg] ;
 vec-ext (n : Nat) (a b : MM.Vec n) (h : (j : Fin n) -> Id R (a j) (b j)) : Id (MM.Vec n) a b =
  F.funext (Fin n) (\ j -> R) a b h ;

 -- minors
 Index (k p q : Nat) : U l = (Fin k -> Fin p) * ExteriorCoordinates[l].Index q ;
 minors (k p q : Nat) (u : MM.Mat p q) (ci : Index k p q) : R =
  EC.coeff q (MM.wedge k q (\ t -> u (ci.1 t))) ci.2 ;
 Vanish (k p q : Nat) (u : MM.Mat p q) : U l = (ci : Index k p q) -> Id R (minors k p q u ci) z ;
 RegularD (k p q : Nat) (u : MM.Mat p q) : U l = RI.Regular (Index k p q) (minors k p q u) ;
 Stable (r p q : Nat) (u : MM.Mat p q) : U l = Vanish (suc r) p q u * RegularD r p q u ;

 -- the algebra map extending u
 module Map (p q : Nat) (u : MM.Mat p q) {
  apply-add (a b : MM.Vec p) (i : Fin q) :
   Id R (MM.apply p q u (AL.vadd p a b) i) (AL.vadd q (MM.apply p q u a) (MM.apply p q u b) i) =
   trans (S.sum-cong p (\ j -> mul (add (a j) (b j)) (u j i)) (\ j -> add (mul (a j) (u j i)) (mul (b j) (u j i)))
           (\ j -> L.dist-left (a j) (b j) (u j i)))
    (S.sum-add p (\ j -> mul (a j) (u j i)) (\ j -> mul (b j) (u j i))) ;
  apply-scale (c : R) (a : MM.Vec p) (i : Fin q) :
   Id R (MM.apply p q u (AL.vscale p c a) i) (AL.vscale q c (MM.apply p q u a) i) =
   trans (S.sum-cong p (\ j -> mul (mul c (a j)) (u j i)) (\ j -> mul c (mul (a j) (u j i)))
           (\ j -> sym (mulA c (a j) (u j i))))
    (S.sum-scale c p (\ j -> mul (a j) (u j i))) ;
  alt : AL.In[UP.Lam q].Alt p =
   (\ v -> gen q (MM.apply p q u v),
    ((\ a b -> trans (ap (gen q) (vec-ext q (MM.apply p q u (AL.vadd p a b))
                                    (AL.vadd q (MM.apply p q u a) (MM.apply p q u b)) (apply-add a b)))
                (EA.gen-add q (MM.apply p q u a) (MM.apply p q u b)),
      \ c a -> trans (ap (gen q) (vec-ext q (MM.apply p q u (AL.vscale p c a))
                                    (AL.vscale q c (MM.apply p q u a)) (apply-scale c a)))
                (EA.gen-scale q c (MM.apply p q u a))),
     \ v -> EA.gen-sq q (MM.apply p q u v))) ;
  phi : AL.AlgHom (UP.Lam p) (UP.Lam q) = UP.In[UP.Lam q].ext p alt ;
  phi-gen (v : MM.Vec p) : Id (Ext q) (phi.1 (gen p v)) (gen q (MM.apply p q u v)) =
   (UP.In[UP.Lam q].extend p alt).2.1 v ;
  opaque phi ;
  value : Ext p -> Ext q = phi.1 ;
  value-scale (a : R) (x : Ext p) : Id (Ext q) (value (escale p a x)) (escale q a (value x)) = phi.2.2.1 a x ;
  value-zero : Id (Ext q) (value (ezero p)) (ezero q) = AL.In[UP.Lam q].H[UP.Lam p,phi].zero ;
  apply-delta (j : Fin p) : Id (MM.Vec q) (MM.apply p q u (D.delta p j)) (u j) =
   vec-ext q (MM.apply p q u (D.delta p j)) (u j) (\ i -> D.sum-delta p j (\ k -> u k i)) ;
  -- Lambda(u) (i(e_c1) ... i(e_ck)) = i(u_c1) ... i(u_ck)
  choice (k : Nat) (c : Fin k -> Fin p) :
   Id (Ext q) (value (eprod p k (\ t -> gen p (D.delta p (c t))))) (MM.wedge k q (\ t -> u (c t))) =
   trans (DT.hom-eprod p q phi k (\ t -> gen p (D.delta p (c t))))
    (DT.eprod-cong q k (\ t -> value (gen p (D.delta p (c t)))) (\ t -> gen q (u (c t)))
     (\ t -> trans (phi-gen (D.delta p (c t))) (ap (gen q) (apply-delta (c t))))) ;
  -- more than p columns
  high (m : Nat) (c : Fin (plus p (suc m)) -> Fin p) :
   Id (Ext q) (MM.wedge (plus p (suc m)) q (\ t -> u (c t))) (ezero q) =
   trans (sym (choice (plus p (suc m)) c))
    (trans (ap value (DG.deg-high p m (eprod p (plus p (suc m)) (\ t -> gen p (D.delta p (c t))))
       (DG.deg-eprod p (plus p (suc m)) (\ t -> gen p (D.delta p (c t))) (\ t -> DG.deg-gen p (D.delta p (c t))))))
     value-zero) ;
  -- exactly p columns: i(u_c1) ... i(u_cp) = d . wedge u
  det-choice (c : Fin p -> Fin p) : R = det p (\ t -> D.delta p (c t)) ;
  square (c : Fin p -> Fin p) :
   Id (Ext q) (MM.wedge p q (\ t -> u (c t))) (escale q (det-choice c) (MM.wedge p q u)) =
   trans (sym (choice p c))
    (trans (ap value (DT.free p (\ t -> D.delta p (c t))))
     (trans (value-scale (det-choice c) (DG.omega p))
      (ap (escale q (det-choice c))
       (trans (ap value (sym (DT.std-omega p))) (choice p (\ t -> t)))))) ;
 } ;

 -- D_k(u) = 0 for k > p
 vanish-high (p q m : Nat) (u : MM.Mat p q) : Vanish (plus p (suc m)) p q u =
  \ ci -> trans (ap (\ y -> EC.coeff q y ci.2) (Map[p,q,u].high m ci.1)) (EC.coeff-zero q ci.2) ;

 -- D_p(u) regular iff wedge u regular
 module Kill (p q : Nat) (u : MM.Mat p q) (x : R) {
  from-coeff (h : (I : ExteriorCoordinates[l].Index q) -> Id R (mul (EC.coeff q (MM.wedge p q u) I) x) z) :
   Id (Ext q) (escale q x (MM.wedge p q u)) (ezero q) =
   EC.ext q (escale q x (MM.wedge p q u)) (ezero q) (\ I ->
    trans (EC.coeff-scale q x (MM.wedge p q u) I)
     (trans (mulC x (EC.coeff q (MM.wedge p q u) I)) (trans (h I) (sym (EC.coeff-zero q I))))) ;
  to-coeff (h : Id (Ext q) (escale q x (MM.wedge p q u)) (ezero q)) (I : ExteriorCoordinates[l].Index q) :
   Id R (mul (EC.coeff q (MM.wedge p q u) I) x) z =
   trans (mulC (EC.coeff q (MM.wedge p q u) I) x)
    (trans (sym (EC.coeff-scale q x (MM.wedge p q u) I))
     (trans (ap (\ y -> EC.coeff q y I) h) (EC.coeff-zero q I))) ;
  -- x kills wedge u gives x kills D_p(u)
  kills-minors (h : Id (Ext q) (escale q x (MM.wedge p q u)) (ezero q)) : RI.ZeroOn (Index p p q) (minors p p q u) x =
   \ ci -> calc R { mul (EC.coeff q (MM.wedge p q (\ t -> u (ci.1 t))) ci.2) x
    =< ap (\ y -> mul (EC.coeff q y ci.2) x) (Map[p,q,u].square ci.1)
    > mul (EC.coeff q (escale q (Map[p,q,u].det-choice ci.1) (MM.wedge p q u)) ci.2) x
    =< ap (\ y -> mul y x) (EC.coeff-scale q (Map[p,q,u].det-choice ci.1) (MM.wedge p q u) ci.2)
    > mul (mul (Map[p,q,u].det-choice ci.1) (EC.coeff q (MM.wedge p q u) ci.2)) x
    =< sym (mulA (Map[p,q,u].det-choice ci.1) (EC.coeff q (MM.wedge p q u) ci.2) x)
    > mul (Map[p,q,u].det-choice ci.1) (mul (EC.coeff q (MM.wedge p q u) ci.2) x)
    =< ap (mul (Map[p,q,u].det-choice ci.1)) (to-coeff h ci.2) > mul (Map[p,q,u].det-choice ci.1) z
    =< L.mul-zero (Map[p,q,u].det-choice ci.1) > z } ;
 } ;
 from-wedge (p q : Nat) (u : MM.Mat p q) (h : MM.WedgeRegular p q u) : RegularD p p q u =
  \ x t k -> h x (Kill[p,q,u,x].from-coeff (\ I -> k (\ s -> s,I))) ;
 to-wedge (p q : Nat) (u : MM.Mat p q) (h : RegularD p p q u) : MM.WedgeRegular p q u =
  \ x k -> h x tt (Kill[p,q,u,x].kills-minors k) ;

 -- Theorem 2.4
 theorem24 (p q : Nat) (u : MM.Mat p q) (inj : MM.Injective p q u) : Stable p p q u =
  (subst (\ k -> Vanish k p q u) (DG.plus-one p) (vanish-high p q zero u),
   from-wedge p q u (McCoy[l].Over[q].mccoy p Rg setR u inj)) ;
 -- the remark after Theorem 2.4
 trivial (q m : Nat) (u : MM.Mat (plus q (suc m)) q) (inj : MM.Injective (plus q (suc m)) q u) : Id R o z =
  McCoy[l].Over[q].mccoy (plus q (suc m)) Rg setR u inj o
   (trans (EA.escale-one q (MM.wedge (plus q (suc m)) q u))
    (DG.deg-high q m (MM.wedge (plus q (suc m)) q u)
     (DG.deg-eprod q (plus q (suc m)) (\ t -> gen q (u t)) (\ t -> DG.deg-gen q (u t))))) ;

 -- Theorem 2.5
 module Cramer (p q : Nat) (u : MM.Mat p q) (x : MM.Vec p)
  (hx : (j : Fin q) -> Id R (MM.apply p q u x j) z) (k : Fin p) {
  Pk (b : MM.Vec q) : Ext q = AD.P q p u k b ;
  form (I : ExteriorCoordinates[l].Index q) (b : MM.Vec q) : R = EC.coeff q (Pk b) I ;
  form-lin (I : ExteriorCoordinates[l].Index q) : AD.LinForm q (form I) =
   (\ a b -> trans (ap (\ y -> EC.coeff q y I) (AD.repl-add q p u k a b)) (EC.coeff-add q (Pk a) (Pk b) I),
    \ c a -> trans (ap (\ y -> EC.coeff q y I) (AD.repl-scale q p u k c a)) (EC.coeff-scale q c (Pk a) I)) ;
  self : Id (Ext q) (Pk (u k)) (MM.wedge p q u) =
   DT.eprod-cong q p (\ j -> gen q (AD.repl q p u k (u k) j)) (\ j -> gen q (u j))
    (\ j -> ap (gen q) (AD.repl-self q p u k j)) ;
  -- P(u_j) = delta_kj wedge u, coefficientwise
  column (I : ExteriorCoordinates[l].Index q) (j : Fin p) : AD.Dec p k j ->
   Id R (form I (u j)) (mul (D.delta p k j) (EC.coeff q (MM.wedge p q u) I)) = split {
   inl e -> idJ (Fin p) k (\ j1 e1 -> Id R (form I (u j1)) (mul (D.delta p k j1) (EC.coeff q (MM.wedge p q u) I)))
     (trans (ap (\ y -> EC.coeff q y I) self)
      (sym (trans (ap (\ y -> mul y (EC.coeff q (MM.wedge p q u) I)) (D.delta-diag p k)) (L.one-left (EC.coeff q (MM.wedge p q u) I)))))
     j e ;
   inr ne -> trans (ap (\ y -> EC.coeff q y I)
       (AD.repeat-zero q p (AD.repl q p u k (u j)) j k (\ e -> ne (sym e))
        (trans (AD.repl-off q p u k (u j) j (\ e -> ne (sym e))) (sym (AD.repl-at q p u k (u j))))))
     (trans (EC.coeff-zero q I)
      (sym (trans (ap (\ y -> mul y (EC.coeff q (MM.wedge p q u) I)) (D.delta-off p k j ne))
        (L.zero-mul (EC.coeff q (MM.wedge p q u) I))))) } ;
  killed (I : ExteriorCoordinates[l].Index q) : Id R (mul (EC.coeff q (MM.wedge p q u) I) (x k)) z =
   calc R { mul (EC.coeff q (MM.wedge p q u) I) (x k)
    =< mulC (EC.coeff q (MM.wedge p q u) I) (x k) > mul (x k) (EC.coeff q (MM.wedge p q u) I)
    =< sym (D.sum-delta p k (\ j -> mul (x j) (EC.coeff q (MM.wedge p q u) I)))
    > S.sum p (\ j -> mul (D.delta p k j) (mul (x j) (EC.coeff q (MM.wedge p q u) I)))
    =< S.sum-cong p (\ j -> mul (D.delta p k j) (mul (x j) (EC.coeff q (MM.wedge p q u) I)))
        (\ j -> mul (x j) (form I (u j)))
        (\ j -> trans (L.mul-swap (D.delta p k j) (x j) (EC.coeff q (MM.wedge p q u) I))
          (ap (mul (x j)) (sym (column I j (AD.dec-fin p k j)))))
    > S.sum p (\ j -> mul (x j) (form I (u j)))
    =< S.sum-cong p (\ j -> mul (x j) (form I (u j))) (\ j -> form I (AL.vscale q (x j) (u j)))
        (\ j -> sym ((form-lin I).2 (x j) (u j)))
    > S.sum p (\ j -> form I (AL.vscale q (x j) (u j)))
    =< sym (AD.form-sum q (form I) (form-lin I) p (\ j -> AL.vscale q (x j) (u j)))
    > form I (MM.apply p q u x)
    =< ap (form I) (vec-ext q (MM.apply p q u x) (\ j -> z) hx) > form I (\ j -> z)
    =< AD.form-zero q (form I) (form-lin I) > z } ;
 } ;
 theorem25 (p q : Nat) (u : MM.Mat p q) (h : RegularD p p q u) : MM.Injective p q u =
  \ x hx k -> to-wedge p q u h (x k) (Kill[p,q,u,x k].from-coeff (Cramer[p,q,u,x,hx,k].killed)) ;
} ;
