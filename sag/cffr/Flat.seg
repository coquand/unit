-- An injective u : R^p -> R^q stays injective over R[1/c].
--
-- Let y in R[1/c]^p with sum_k y_k u_k = 0 over R[1/c].
-- (1) Common denominator (clear): merely a power s of c and m in R^p with
--     s y_k = m_k for every k (induction on p, from a representative
--     a / s2 of the last y and s1, m1 for the others: s = s2 s1).
-- (2) Then sum_k m_k u_k = s sum_k y_k u_k = 0 in R[1/c], so each
--     coordinate of the vector u m is killed by a power of c, and a single
--     power t of c kills them all (killV, induction on q: t = t1 t2).
-- (3) u (t m) = t (u m) = 0, so t m_k = 0 by injectivity; t and s are units
--     in R[1/c], so m_k = 0 and y_k = 0 there.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (Rg : CRing) (c : Rg.R) {
 open Rg ;
 module I = LocalRegular[l].Invert[Rg,c] ;
 module Bm = I.B ;
 module SR = FiniteIdeal[l].Sums[Rg] ; module SL = FiniteIdeal[l].Sums[I.ring] ;
 module MR = Matrices[l].Over[Rg] ; module ML = Matrices[l].Over[I.ring] ;
 module AF = AffineFinite[l] ;
 k (a : R) : I.ring.R = I.inclusion.1 a ;
 k-mul (a b : R) : Id I.ring.R (k (mul a b)) (I.ring.mul (k a) (k b)) = I.inclusion.2.2.2 a b ;
 k-zero : Id I.ring.R (k z) I.ring.z = RingHom[l].zero Rg I.ring I.inclusion ;
 power (n : Nat) : R = I.Pow.power c n ;
 power-unit (n : Nat) : RL[I.ring].unit (k (power n)) = Bm.inverse (power n) (n,refl (power n)) ;

 -- u a = 0 with u a unit gives a = 0
 unit-kills (X : CRing) (u a : X.R) (hu : RL[X].unit u) (h : Id X.R (X.mul u a) X.z) : Id X.R a X.z =
  calc X.R { a
   =< sym (X.mulO a) > X.mul a X.o
   =< ap (X.mul a) (sym hu.2) > X.mul a (X.mul u hu.1)
   =< X.mulA a u hu.1 > X.mul (X.mul a u) hu.1
   =< ap (\ t -> X.mul t hu.1) (trans (X.mulC a u) h) > X.mul X.z hu.1
   =< RL[X].zero-mul hu.1 > X.z } ;

 -- (1)
 Cleared (p : Nat) (y : Fin p -> I.ring.R) : U l =
  (s : R) * I.Powers s * (m : Fin p -> R) * ((i : Fin p) -> Id I.ring.R (I.ring.mul (k s) (y i)) (k (m i))) ;
 module ClearStep (p : Nat) (y : Fin (suc p) -> I.ring.R) (rest : Cleared p (\ i -> y (inl i)))
  (f : Bm.Raw.Fraction) (e : Id I.ring.R (Bm.include f) (y (inr tt))) {
  s1 : R = rest.1 ; m1 (i : Fin p) : R = rest.2.2.1 i ;
  a : R = f.1 ; s2 : R = f.2.1 ;
  s : R = mul s2 s1 ;
  m : Fin (suc p) -> R = split { inl i -> mul s2 (m1 i) ; inr t -> mul s1 a } ;
  old (i : Fin p) : Id I.ring.R (I.ring.mul (k s) (y (inl i))) (k (m (inl i))) =
   calc I.ring.R { I.ring.mul (k s) (y (inl i))
    =< ap (\ t -> I.ring.mul t (y (inl i))) (k-mul s2 s1) > I.ring.mul (I.ring.mul (k s2) (k s1)) (y (inl i))
    =< sym (I.ring.mulA (k s2) (k s1) (y (inl i))) > I.ring.mul (k s2) (I.ring.mul (k s1) (y (inl i)))
    =< ap (I.ring.mul (k s2)) (rest.2.2.2 i) > I.ring.mul (k s2) (k (m1 i))
    =< sym (k-mul s2 (m1 i)) > k (mul s2 (m1 i)) } ;
  last : Id I.ring.R (I.ring.mul (k s) (y (inr tt))) (k (m (inr tt))) =
   calc I.ring.R { I.ring.mul (k s) (y (inr tt))
    =< ap (\ t -> I.ring.mul t (y (inr tt))) (trans (k-mul s2 s1) (I.ring.mulC (k s2) (k s1)))
    > I.ring.mul (I.ring.mul (k s1) (k s2)) (y (inr tt))
    =< sym (I.ring.mulA (k s1) (k s2) (y (inr tt))) > I.ring.mul (k s1) (I.ring.mul (k s2) (y (inr tt)))
    =< ap (\ t -> I.ring.mul (k s1) (I.ring.mul (k s2) t)) (sym e) > I.ring.mul (k s1) (I.ring.mul (k s2) (Bm.include f))
    =< ap (I.ring.mul (k s1)) (Bm.fraction-equation f) > I.ring.mul (k s1) (k a)
    =< sym (k-mul s1 a) > k (mul s1 a) } ;
  result : Cleared (suc p) y =
   (s,I.product s2 s1 f.2.2 rest.2.1,m,
    AF.section p (\ i -> Id I.ring.R (I.ring.mul (k s) (y i)) (k (m i))) old last) ;
 } ;
 clear : (p : Nat) (y : Fin p -> I.ring.R) -> Tr.Trunc[Cleared p y].carrier = split {
  zero -> \ y -> Tr.Trunc[Cleared zero y].inc
   (o,I.one,\ i -> efq i,AF.empty-section (\ i -> Id I.ring.R (I.ring.mul (k o) (y i)) (k (efq i)))) ;
  suc p | ih -> \ y ->
   TC.bind (Cleared p (\ i -> y (inl i))) (Cleared (suc p) y)
    (\ rest -> TC.map (Bm.Representatives (y (inr tt))) (Cleared (suc p) y)
      (\ rep -> ClearStep[p,y,rest,rep.1,rep.2].result) (Bm.representatives (y (inr tt))))
    (ih (\ i -> y (inl i))) } ;

 -- (2)
 KilledV (q : Nat) (x : Fin q -> R) : U l = (n : Nat) * ((j : Fin q) -> Id R (mul (power n) (x j)) z) ;
 module KillStep (q : Nat) (x : Fin (suc q) -> R) (r1 : KilledV q (\ j -> x (inl j))) (r2 : I.Killed (x (inr tt))) {
  n : Nat = plus r1.1 r2.1 ;
  split-power : Id R (power n) (mul (power r1.1) (power r2.1)) = I.Pow.power-add c r1.1 r2.1 ;
  old (j : Fin q) : Id R (mul (power n) (x (inl j))) z =
   calc R { mul (power n) (x (inl j))
    =< ap (\ t -> mul t (x (inl j))) (trans split-power (mulC (power r1.1) (power r2.1)))
    > mul (mul (power r2.1) (power r1.1)) (x (inl j))
    =< sym (mulA (power r2.1) (power r1.1) (x (inl j))) > mul (power r2.1) (mul (power r1.1) (x (inl j)))
    =< ap (mul (power r2.1)) (r1.2 j) > mul (power r2.1) z
    =< RL[Rg].mul-zero (power r2.1) > z } ;
  last : Id R (mul (power n) (x (inr tt))) z =
   calc R { mul (power n) (x (inr tt))
    =< ap (\ t -> mul t (x (inr tt))) split-power > mul (mul (power r1.1) (power r2.1)) (x (inr tt))
    =< sym (mulA (power r1.1) (power r2.1) (x (inr tt))) > mul (power r1.1) (mul (power r2.1) (x (inr tt)))
    =< ap (mul (power r1.1)) r2.2 > mul (power r1.1) z
    =< RL[Rg].mul-zero (power r1.1) > z } ;
  result : KilledV (suc q) x = (n,AF.section q (\ j -> Id R (mul (power n) (x j)) z) old last) ;
 } ;
 killV : (q : Nat) (x : Fin q -> R) -> ((j : Fin q) -> Tr.Trunc[I.Killed (x j)].carrier) ->
  Tr.Trunc[KilledV q x].carrier = split {
  zero -> \ x h -> Tr.Trunc[KilledV zero x].inc (zero,AF.empty-section (\ j -> Id R (mul (power zero) (x j)) z)) ;
  suc q | ih -> \ x h ->
   TC.bind (KilledV q (\ j -> x (inl j))) (KilledV (suc q) x)
    (\ r1 -> TC.map (I.Killed (x (inr tt))) (KilledV (suc q) x) (\ r2 -> KillStep[q,x,r1,r2].result) (h (inr tt)))
    (ih (\ j -> x (inl j)) (\ j -> h (inl j))) } ;

 -- (3)
 extend (p q : Nat) (u : MR.Mat p q) : ML.Mat p q = \ i j -> k (u i j) ;
 module Main (p q : Nat) (u : MR.Mat p q) (inj : MR.Injective p q u) (y : Fin p -> I.ring.R)
  (hy : (j : Fin q) -> Id I.ring.R (ML.apply p q (extend p q u) y j) I.ring.z) {
  module Given (cl : Cleared p y) {
   s : R = cl.1 ; m (i : Fin p) : R = cl.2.2.1 i ;
   image (j : Fin q) : Id I.ring.R (k (MR.apply p q u m j)) I.ring.z =
    calc I.ring.R { k (SR.sum p (\ i -> mul (m i) (u i j)))
     =< StandardOpens[l].SumMap[Rg,I.ring,I.inclusion].natural p (\ i -> mul (m i) (u i j))
     > SL.sum p (\ i -> k (mul (m i) (u i j)))
     =< SL.sum-cong p (\ i -> k (mul (m i) (u i j))) (\ i -> I.ring.mul (k s) (I.ring.mul (y i) (k (u i j))))
         (\ i -> trans (k-mul (m i) (u i j))
          (trans (ap (\ t -> I.ring.mul t (k (u i j))) (sym (cl.2.2.2 i))) (sym (I.ring.mulA (k s) (y i) (k (u i j))))))
     > SL.sum p (\ i -> I.ring.mul (k s) (I.ring.mul (y i) (k (u i j))))
     =< SL.sum-scale (k s) p (\ i -> I.ring.mul (y i) (k (u i j))) > I.ring.mul (k s) (SL.sum p (\ i -> I.ring.mul (y i) (k (u i j))))
     =< ap (I.ring.mul (k s)) (hy j) > I.ring.mul (k s) I.ring.z
     =< RL[I.ring].mul-zero (k s) > I.ring.z } ;
   module Killed (kv : KilledV q (MR.apply p q u m)) {
    t : R = power kv.1 ;
    scaled (j : Fin q) : Id R (MR.apply p q u (\ i -> mul t (m i)) j) z =
     calc R { SR.sum p (\ i -> mul (mul t (m i)) (u i j))
      =< SR.sum-cong p (\ i -> mul (mul t (m i)) (u i j)) (\ i -> mul t (mul (m i) (u i j))) (\ i -> sym (mulA t (m i) (u i j)))
      > SR.sum p (\ i -> mul t (mul (m i) (u i j)))
      =< SR.sum-scale t p (\ i -> mul (m i) (u i j)) > mul t (MR.apply p q u m j)
      =< kv.2 j > z } ;
    km (i : Fin p) : Id I.ring.R (k (m i)) I.ring.z =
     unit-kills I.ring (k t) (k (m i)) (power-unit kv.1)
      (trans (sym (k-mul t (m i))) (trans (ap k (inj (\ i1 -> mul t (m i1)) scaled i)) k-zero)) ;
    yk (i : Fin p) : Id I.ring.R (y i) I.ring.z =
     unit-kills I.ring (k s) (y i) (Bm.inverse s cl.2.1) (trans (cl.2.2.2 i) (km i)) ;
   } ;
   result (i : Fin p) : Id I.ring.R (y i) I.ring.z =
    Tr.Trunc[KilledV q (MR.apply p q u m)].induction @l (\ w -> Id I.ring.R (y i) I.ring.z) (\ w -> Bm.set (y i) I.ring.z)
     (\ kv -> Killed[kv].yk i)
     (killV q (MR.apply p q u m) (\ j -> I.kernel (MR.apply p q u m j) (image j))) ;
  } ;
  result (i : Fin p) : Id I.ring.R (y i) I.ring.z =
   Tr.Trunc[Cleared p y].induction @l (\ w -> Id I.ring.R (y i) I.ring.z) (\ w -> Bm.set (y i) I.ring.z)
    (\ cl -> Given[cl].result i) (clear p y) ;
 } ;
 injective (p q : Nat) (u : MR.Mat p q) (inj : MR.Injective p q u) : ML.Injective p q (extend p q u) =
  \ y hy i -> Main[p,q,u,inj,y,hy].result i ;
} ;
