-- Theorem 2.4 modulo an ideal I (a proposition): if u : R^p -> R^q is
-- injective modulo I (u x in I^q gives x in I^p), then D_p(u) is regular
-- modulo I.  Through R/I (QuotientRing): the image u' of u is injective over
-- R/I (lift a vector to representatives; u x in I^q gives x in I^p), so
-- D_p(u') is regular (Theorem 2.4); the minors of u' are the images of the
-- minors of u (along any ring map: Map), and x D_p(u) in I gives
-- pi(x) D_p(u') = 0, so pi(x) = 0, i.e. x in I.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
-- minors and matrices along a ring map
module Map (Rg Lg : CRing) (setR : Pr.isSet Rg.R) (setL : Pr.isSet Lg.R) (h : RingHom[l].Hom Rg Lg) {
 module MR = Matrices[l].Over[Rg] ; module ML = Matrices[l].Over[Lg] ;
 module BC = BaseChange[l].Over[Rg,Lg,h] ;
 module ECR = ExteriorCoordinates[l].Over[Rg,setR] ;
 module ECL = ExteriorCoordinates[l].Over[Lg,setL] ;
 module MIR = Minors[l].Over[Rg,setR] ; module MIL = Minors[l].Over[Lg,setL] ;
 module MK = MinorKill[l].Over[Rg,setR] ;
 f (a : Rg.R) : Lg.R = h.1 a ;
 extend (p q : Nat) (u : MR.Mat p q) : ML.Mat p q = \ i j -> f (u i j) ;
 apply-map (p q : Nat) (u : MR.Mat p q) (x : MR.Vec p) (j : Fin q) :
  Id Lg.R (f (MR.apply p q u x j)) (ML.apply p q (extend p q u) (\ i -> f (x i)) j) =
  trans (StandardOpens[l].SumMap[Rg,Lg,h].natural p (\ i -> Rg.mul (x i) (u i j)))
   (FiniteIdeal[l].Sums[Lg].sum-cong p (\ i -> f (Rg.mul (x i) (u i j))) (\ i -> Lg.mul (f (x i)) (f (u i j))) (\ i -> h.2.2.2 (x i) (u i j))) ;
 coeff-B : (n : Nat) (y : ExteriorModel[l].Over[Rg].Ext n) (J : ExteriorCoordinates[l].Index n) ->
  Id Lg.R (ECL.coeff n (BC.B n y) J) (f (ECR.coeff n y J)) = split {
  zero -> \ y J -> refl (f y) ;
  suc n | r -> \ y -> split { inl J -> r y.1 J ; inr J -> r y.2 J } } ;
 minors-map (k p q : Nat) (u : MR.Mat p q) (ci : MIR.Index k p q) :
  Id Lg.R (MIL.minors k p q (extend p q u) ci) (f (MIR.minors k p q u ci)) =
  trans (ap (\ y -> ECL.coeff q y ci.2) (sym (BC.B-wedge q k (MK.cols k p q u ci.1))))
   (coeff-B q (Matrices[l].Over[Rg].wedge k q (MK.cols k p q u ci.1)) ci.2) ;
} ;

module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (I : RegularIdeal[l].IdealPred[Rg])
 (prop : (x : Rg.R) -> Pr.isProp (I.In x)) {
 open Rg ;
 module QR = QuotientRing[l].Over[Rg,I,prop] ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module MP = Map[Rg,QR.ring,setR,QR.set,QR.projection] ;
 module RJ = RegularIdeal[l].Over[Rg,RegularIdeal[l].modulo Rg I] ;
 InjectiveMod (p q : Nat) (u : MM.Mat p q) : U l =
  (x : MM.Vec p) -> ((j : Fin q) -> I.In (MM.apply p q u x j)) -> (k : Fin p) -> I.In (x k) ;
 module Injective (p q : Nat) (u : MM.Mat p q) (inj : InjectiveMod p q u) (y : Fin p -> QR.Carrier)
  (hy : (j : Fin q) -> Id QR.Carrier (Matrices[l].Over[QR.ring].apply p q (MP.extend p q u) y j) QR.zeroQ) {
  Rep (k : Fin p) : U l = (a : R) * Id QR.Carrier (QR.include a) (y k) ;
  rep (k : Fin p) : Tr.Trunc[Rep k].carrier =
   QR.Q.induction @l (\ w -> Tr.Trunc[(a : R) * Id QR.Carrier (QR.include a) w].carrier)
    (\ w -> Tr.Trunc[(a : R) * Id QR.Carrier (QR.include a) w].proposition)
    (\ a -> Tr.Trunc[(a1 : R) * Id QR.Carrier (QR.include a1) (QR.include a)].inc (a,refl (QR.include a))) (y k) ;
  module Given (r : (k : Fin p) -> Rep k) {
   Y (k : Fin p) : R = (r k).1 ;
   eqY : Id (Fin p -> QR.Carrier) (\ k -> QR.include (Y k)) y =
    Axioms[l].FunExtLemmas[fe @l].funext (Fin p) (\ k -> QR.Carrier) _ y (\ k -> (r k).2) ;
   in-image (j : Fin q) : I.In (MM.apply p q u Y j) =
    QR.kernel (MM.apply p q u Y j)
     (trans (MP.apply-map p q u Y j)
      (trans (ap (\ w -> Matrices[l].Over[QR.ring].apply p q (MP.extend p q u) w j) eqY) (hy j))) ;
   result (k : Fin p) : Id QR.Carrier (y k) QR.zeroQ =
    trans (sym (r k).2) (QR.to-zero (Y k) (inj Y in-image k)) ;
  } ;
  result (k : Fin p) : Id QR.Carrier (y k) QR.zeroQ =
   Tr.Trunc[(k1 : Fin p) -> Rep k1].induction @l (\ w -> Id QR.Carrier (y k) QR.zeroQ) (\ w -> QR.set (y k) QR.zeroQ)
    (\ r -> Given[r].result k) (AffineFinite[l].choice p Rep rep) ;
 } ;
 -- Theorem 2.4 modulo I, in the minor form
 mccoy-mod (p q : Nat) (u : MM.Mat p q) (inj : InjectiveMod p q u) :
  RJ.Regular (MI.Index p p q) (MI.minors p p q u) = \ x t hk ->
  QR.kernel x
   (Minors[l].Over[QR.ring,QR.set].from-wedge p q (MP.extend p q u)
     (McCoy[l].Over[q].mccoy p QR.ring QR.set (MP.extend p q u) (\ y hy k -> Injective[p,q,u,inj,y,hy].result k))
     (QR.include x) tt
     (\ ci -> trans (ap (\ w -> QR.mulQ w (QR.include x)) (MP.minors-map p p q u ci))
       (trans (QR.Multiply.beta (MI.minors p p q u ci) x) (QR.to-zero (mul (MI.minors p p q u ci) x) (hk ci))))) ;
} ;
