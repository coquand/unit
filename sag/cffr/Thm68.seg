-- cffr Theorem 6.8, the grades: for a resolution
--   0 -> R^p -u-> R^(s 0) -T 0-> R^(s 1) -> ... -T (k-1)-> R^(s k)
-- (u injective, exact at R^(s 0), ..., R^(s (k-1))) with ranks r
-- (s 0 = r 0 + p, s (i+1) = r (i+1) + r i), Gr(D_(r i)(T i)) >= k - i for
-- i < k, and Gr(D_p(u)) >= k + 1 (TopGrade).  (Top first: u is A_m with
-- m = k + 1, T i is A_(m-1-i), so these are the bounds Gr >= index of the
-- paper.)  The ranks themselves come from Resolution.ranks.
-- Induction on k, and on p for each k.
-- k = 0: nothing to prove.
-- p = 0: u = 0, so T 0 is injective (exact at R^(s 0)); the complex starting
--   at T 0 is a resolution with k - 1 maps after its top: TopGrade for T 0,
--   induction on k for the others.
-- p = p0 + 1: Lemma 6.7 with x = the entries of u: Gr(x) >= k + 1 since the
--   minors of u lie in (x) (GradeTools).  In L = R[1/x_j] the entry x_j of u
--   is a unit, and Reduce gives a resolution with top of size p0:
--   (pi u without a column, (T 0 ; lambda), (T 1 | 0), T 2, ...), ranks
--   (r 0 + 1, r 1, r 2, ...); by induction on p its grades hold, and they
--   give those of T 0, T 1, ... over L, since D_(r0+1)(T 0 ; lambda) lies in
--   (D_r0(T 0)), D_r1(T 1 | 0) in (D_r1(T 1)) (Reduce) and the minors over L
--   are the images of the minors (McCoyMod.Map).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module TG = TrueGrade[l] ;
module GT = GradeTools[l] ;
module RS = Resolution[l] ;
-- a resolution: u injective, composites 0, exact (Resolution.Pairs)
Res (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) : U l =
 Matrices[l].Over[D.1].Injective p (s zero) u * RS.Pairs D k p s u T ;
NL (r p q : Nat) : Nat = (Enumerate[l].minors-index r p q).1 ;
minors (D : TG.RD) (r p q : Nat) (u : RS.Mat D p q) (i : Fin (NL r p q)) : D.1.R =
 Enumerate[l].MinorList[D.1,D.2,r,p,q,u].minor-list i ;
GradeAt (D : TG.RD) (s r : Nat -> Nat) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (i g : Nat) : U l =
 TG.TGr g D zero (GT.J0 D) (NL (r i) (s i) (s (suc i))) (minors D (r i) (s i) (s (suc i)) (T i)) ;
Grades (D : TG.RD) (k : Nat) (s r : Nat -> Nat) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) : U l =
 (i d : Nat) -> Id Nat k (plus (suc i) d) -> GradeAt D s r T i (suc d) ;
Claim (k : Nat) : U l+ =
 (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat) ->
 Res D k p s u T -> RS.Ranks k p s r -> Grades D k s r T ;

-- Gr >= a + b gives Gr >= b
tgr-down (D : TG.RD) (mJ : Nat) (J : Fin mJ -> D.1.R) (n : Nat) (I : Fin n -> D.1.R) (b : Nat) :
 (a : Nat) -> TG.TGr (plus a b) D mJ J n I -> TG.TGr b D mJ J n I = split {
 zero -> \ g -> g ;
 suc a | r -> \ g -> r (TG.mono (plus a b) D mJ J n I g) } ;

-- the top grade, in this layout
module Top (D : TG.RD) (k p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i)))
 (h : Res D k p s u T) {
 module AB = GT.Absolute[D] ;
 s1 : Nat -> Nat = split { zero -> p ; suc i -> s i } ;
 T1 : (i : Nat) -> RS.Mat D (s1 i) (s1 (suc i)) = split { zero -> u ; suc i -> T i } ;
 pairs : (i d : Nat) -> Id Nat k (plus (suc i) d) ->
  Matrices[l].Over[D.1].ComposeZero (s1 i) (s1 (suc i)) (s1 (suc (suc i))) (T1 i) (T1 (suc i)) *
  ExactMod[l].Over[D.1,D.2].ExactMod zero (GT.J0 D) (s1 i) (s1 (suc i)) (s1 (suc (suc i))) (T1 i) (T1 (suc i)) = split {
  zero -> \ d e -> ((h.2.1 d e).1,AB.exact p (s zero) (s (suc zero)) u (T zero) (h.2.1 d e).2) ;
  suc i -> \ d e -> ((h.2.2 i d e).1,AB.exact (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) (h.2.2 i d e).2) } ;
 grade : TG.TGr (suc k) D zero (GT.J0 D) (NL p p (s zero)) (minors D p p (s zero) u) =
  TopGrade[l].top-grade k D zero (GT.J0 D) s1 T1 (AB.inj p (s zero) u h.1,pairs) ;
} ;

-- k = 0
start (D : TG.RD) (s r : Nat -> Nat) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) : Grades D zero s r T =
 \ i d e -> efq (zero-suc (plus i d) e) ;

-- p = 0: shift
module PZero (k : Nat) (ih : Claim k) (D : TG.RD) (s : Nat -> Nat) (u : RS.Mat D zero (s zero))
 (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat)
 (h : Res D (suc k) zero s u T) (rk : RS.Ranks (suc k) zero s r) {
 module MM = Matrices[l].Over[D.1] ;
 inj0 : MM.Injective (s zero) (s (suc zero)) (T zero) = \ y hy i ->
  Tr.Trunc[(x : MM.Vec zero) * ((j : Fin (s zero)) -> Id D.1.R (MM.apply zero (s zero) u x j) (y j))].induction @l
   (\ w -> Id D.1.R (y i) D.1.z) (\ w -> D.2 (y i) D.1.z) (\ w -> sym (w.2 i)) ((h.2.1 k (refl (suc k))).2 y hy) ;
 s' (i : Nat) : Nat = s (suc i) ;
 T' (i : Nat) : RS.Mat D (s' i) (s' (suc i)) = T (suc i) ;
 r' (i : Nat) : Nat = r (suc i) ;
 res : Res D k (s zero) s' (T zero) T' =
  (inj0,\ d e -> h.2.2 zero d (ap (\ j -> suc j) e),\ i d e -> h.2.2 (suc i) d (ap (\ j -> suc j) e)) ;
 r0 : Id Nat (r zero) (s zero) = sym (trans (rk.1 k (refl (suc k))) (plus-zero (r zero))) ;
 ranks : RS.Ranks k (s zero) s' r' =
  (\ d e -> trans (rk.2 zero d (ap (\ j -> suc j) e)) (ap (plus (r (suc zero))) r0),
   \ i d e -> rk.2 (suc i) d (ap (\ j -> suc j) e)) ;
 rest : Grades D k s' r' T' = ih D (s zero) s' (T zero) T' r' res ranks ;
 top : TG.TGr (suc k) D zero (GT.J0 D) (NL (s zero) (s zero) (s (suc zero))) (minors D (s zero) (s zero) (s (suc zero)) (T zero)) =
  Top[D,k,s zero,s',T zero,T',res].grade ;
 result : Grades D (suc k) s r T = split {
  zero -> \ d e -> subst {Nat} (\ dd -> GradeAt D s r T zero (suc dd)) {k} {d} (suc-inj {k} {d} e)
   (subst {Nat} (\ rr -> TG.TGr (suc k) D zero (GT.J0 D) (NL rr (s zero) (s (suc zero))) (minors D rr (s zero) (s (suc zero)) (T zero)))
    {s zero} {r zero} (sym r0) top) ;
  suc i -> \ d e -> rest i d (suc-inj {k} {plus (suc i) d} e) } ;
} ;

ClaimP (k p : Nat) : U l+ =
 (D : TG.RD) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat) ->
 Res D k p s u T -> RS.Ranks k p s r -> Grades D k s r T ;

-- p = p0 + 1: Lemma 6.7 at the entries of u
module PSucc (k p0 : Nat) (ihp : ClaimP k p0) (D : TG.RD) (s : Nat -> Nat) (u : RS.Mat D (suc p0) (s zero))
 (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat)
 (h : Res D k (suc p0) s u T) (rk : RS.Ranks k (suc p0) s r) {
 module TL = TrueGradeLocal[l] ;
 module EN = GT.Entries[D,suc p0,s zero,u] ;
 N : Nat = EN.N ;
 x (j : Fin N) : D.1.R = EN.entry j ;
 top : TG.TGr (suc k) D zero (GT.J0 D) (NL (suc p0) (suc p0) (s zero)) (minors D (suc p0) (suc p0) (s zero) u) =
  Top[D,k,suc p0,s,u,T,h].grade ;
 top-x : TG.TGr (suc k) D zero (GT.J0 D) N x =
  GT.tgr-mono (suc k) D zero (GT.J0 D) (NL (suc p0) (suc p0) (s zero)) (minors D (suc p0) (suc p0) (s zero) u) N x
   (\ m -> EN.minor-in p0 (Enumerate[l].list _ (Enumerate[l].minors-index (suc p0) (suc p0) (s zero)) m)) top ;
 gx (i d : Nat) (e : Id Nat k (plus (suc i) d)) : TG.TGr (suc d) D zero (GT.J0 D) N x =
  tgr-down D zero (GT.J0 D) N x (suc d) (suc i)
   (subst {Nat} (\ g -> TG.TGr g D zero (GT.J0 D) N x) {suc k} {plus (suc i) (suc d)}
    (trans {Nat} {suc k} {suc (suc (plus i d))} {suc (plus i (suc d))} (ap (\ j -> suc j) e) (ap (\ j -> suc j) (sym (plus-suc i d)))) top-x) ;
 -- in R[1/x_j]
 module Loc (j : Fin N) {
  c : D.1.R = x j ;
  module MP = McCoyMod[l].Map[D.1,(TL.Loc D c).1,D.2,(TL.Loc D c).2,TL.loc D c] ;
  module LE = LocalExact[l].Over[D.1,D.2,c] ;
  Lc : TG.RD = TL.Loc D c ;
  uL : RS.Mat Lc (suc p0) (s zero) = MP.extend (suc p0) (s zero) u ;
  TL1 (i : Nat) : RS.Mat Lc (s i) (s (suc i)) = MP.extend (s i) (s (suc i)) (T i) ;
  k0 : Fin (suc p0) = (FinPairs[l].enum (suc p0) (s zero) j).1 ;
  i0 : Fin (s zero) = (FinPairs[l].enum (suc p0) (s zero) j).2 ;
  unit : RL[Lc.1].unit (uL k0 i0) = LocalRegular[l].Invert[D.1,c].B.inverse c (suc zero,sym (D.1.mulO c)) ;
  module RD = Reduce[l].Over[Lc.1,Lc.2,p0,s zero,s (suc zero),s (suc (suc zero)),s (suc (suc (suc zero))),
   uL,TL1 zero,TL1 (suc zero),TL1 (suc (suc zero)),k0,i0,unit] ;
  -- the reduced data
  s-suc : Nat -> Nat = split { zero -> suc (s (suc zero)) ; suc i -> s (suc (suc i)) } ;
  s1 : Nat -> Nat = split { zero -> s zero ; suc i -> s-suc i } ;
  T-suc : (i : Nat) -> RS.Mat Lc (s-suc i) (s-suc (suc i)) = split { zero -> RD.Z ; suc i -> TL1 (suc (suc i)) } ;
  T1 : (i : Nat) -> RS.Mat Lc (s1 i) (s1 (suc i)) = split { zero -> RD.B' ; suc i -> T-suc i } ;
  r1 : Nat -> Nat = split { zero -> suc (r zero) ; suc i -> r (suc i) } ;
  cz (i d : Nat) (e : Id Nat k (plus (suc (suc i)) d)) :
   Matrices[l].Over[Lc.1].ComposeZero (s i) (s (suc i)) (s (suc (suc i))) (TL1 i) (TL1 (suc i)) =
   LE.compose-zero (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) (h.2.2 i d e).1 ;
  ex (i d : Nat) (e : Id Nat k (plus (suc (suc i)) d)) :
   Matrices[l].Over[Lc.1].Exact (s i) (s (suc i)) (s (suc (suc i))) (TL1 i) (TL1 (suc i)) =
   LE.exact (s i) (s (suc i)) (s (suc (suc i))) (T i) (T (suc i)) (h.2.2 i d e).2 ;
  cz-top (d : Nat) (e : Id Nat k (suc d)) : Matrices[l].Over[Lc.1].ComposeZero (suc p0) (s zero) (s (suc zero)) uL (TL1 zero) =
   LE.compose-zero (suc p0) (s zero) (s (suc zero)) u (T zero) (h.2.1 d e).1 ;
  ex-top (d : Nat) (e : Id Nat k (suc d)) : Matrices[l].Over[Lc.1].Exact (suc p0) (s zero) (s (suc zero)) uL (TL1 zero) =
   LE.exact (suc p0) (s zero) (s (suc zero)) u (T zero) (h.2.1 d e).2 ;
  pairs-suc : (i d : Nat) -> Id Nat k (plus (suc (suc (suc i))) d) ->
   Matrices[l].Over[Lc.1].ComposeZero (s-suc i) (s-suc (suc i)) (s-suc (suc (suc i))) (T-suc i) (T-suc (suc i)) *
   Matrices[l].Over[Lc.1].Exact (s-suc i) (s-suc (suc i)) (s-suc (suc (suc i))) (T-suc i) (T-suc (suc i)) = split {
   zero -> \ d e -> (RD.compose-ZD (cz (suc zero) d e),RD.exact-ZD (ex (suc zero) d e)) ;
   suc i -> \ d e -> (cz (suc (suc i)) d e,ex (suc (suc i)) d e) } ;
  pairs : (i d : Nat) -> Id Nat k (plus (suc (suc i)) d) ->
   Matrices[l].Over[Lc.1].ComposeZero (s1 i) (s1 (suc i)) (s1 (suc (suc i))) (T1 i) (T1 (suc i)) *
   Matrices[l].Over[Lc.1].Exact (s1 i) (s1 (suc i)) (s1 (suc (suc i))) (T1 i) (T1 (suc i)) = split {
   zero -> \ d e -> (RD.compose-B'Z (cz zero d e),RD.exact-B'Z (ex zero d e) (cz-top (suc d) e)) ;
   suc i -> pairs-suc i } ;
  res : Res Lc k p0 s1 RD.A2 T1 =
   (RD.injective (Flat[l].Over[D.1,c].injective (suc p0) (s zero) u h.1),
    \ d e -> (RD.compose-A2 (cz-top d e),RD.exact-A2 (ex-top d e)),
    pairs) ;
  ranks2 : (i d : Nat) -> Id Nat k (plus (suc (suc i)) d) -> Id Nat (s1 (suc i)) (plus (r1 (suc i)) (r1 i)) = split {
   zero -> \ d e -> trans (ap (\ j -> suc j) (rk.2 zero d e)) (sym (plus-suc (r (suc zero)) (r zero))) ;
   suc i -> \ d e -> rk.2 (suc i) d e } ;
  ranks : RS.Ranks k p0 s1 r1 = (\ d e -> trans (rk.1 d e) (plus-suc (r zero) p0),ranks2) ;
  grades : Grades Lc k s1 r1 T1 = ihp Lc s1 RD.A2 T1 r1 res ranks ;
  module GradedSuc {
   at : (i d : Nat) -> Id Nat k (plus (suc (suc i)) d) ->
    TG.TGr (suc d) Lc zero (GT.J0 Lc) (NL (r (suc i)) (s (suc i)) (s (suc (suc i)))) (minors Lc (r (suc i)) (s (suc i)) (s (suc (suc i))) (TL1 (suc i))) = split {
    zero -> \ d e -> GT.tgr-mono (suc d) Lc zero (GT.J0 Lc)
      (NL (r (suc zero)) (suc (s (suc zero))) (s (suc (suc zero)))) (minors Lc (r (suc zero)) (suc (s (suc zero))) (s (suc (suc zero))) RD.Z)
      (NL (r (suc zero)) (s (suc zero)) (s (suc (suc zero)))) (minors Lc (r (suc zero)) (s (suc zero)) (s (suc (suc zero))) (TL1 (suc zero)))
      (\ m -> RD.MinorsZ[r (suc zero)].minor-Z (Enumerate[l].list _ (Enumerate[l].minors-index (r (suc zero)) (suc (s (suc zero))) (s (suc (suc zero)))) m))
      (grades (suc zero) d e) ;
    suc i -> \ d e -> grades (suc (suc i)) d e } ;
  } ;  -- back to the localised T i
  graded : (i d : Nat) -> Id Nat k (plus (suc i) d) ->
   TG.TGr (suc d) Lc zero (GT.J0 Lc) (NL (r i) (s i) (s (suc i))) (minors Lc (r i) (s i) (s (suc i)) (TL1 i)) = split {
   zero -> \ d e -> GT.tgr-mono (suc d) Lc zero (GT.J0 Lc)
     (NL (suc (r zero)) (s zero) (suc (s (suc zero)))) (minors Lc (suc (r zero)) (s zero) (suc (s (suc zero))) RD.B')
     (NL (r zero) (s zero) (s (suc zero))) (minors Lc (r zero) (s zero) (s (suc zero)) (TL1 zero))
     (\ m -> RD.MinorsB[r zero].minor-B' (Enumerate[l].list _ (Enumerate[l].minors-index (suc (r zero)) (s zero) (suc (s (suc zero)))) m))
     (grades zero d e) ;
   suc i -> GradedSuc.at i } ;

 } ;
} ;

module Assemble (k p0 : Nat) (ihp : ClaimP k p0) (D : TG.RD) (s : Nat -> Nat) (u : RS.Mat D (suc p0) (s zero))
 (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (r : Nat -> Nat)
 (h : Res D k (suc p0) s u T) (rk : RS.Ranks k (suc p0) s r) {
 module P = PSucc[k,p0,ihp,D,s,u,T,r,h,rk] ;
 module TL = TrueGradeLocal[l] ;
 ga (i d : Nat) (e : Id Nat k (plus (suc i) d)) (j : Fin P.N) :
  TG.TGr (suc d) (TL.Loc D (P.x j)) zero (\ m -> (TL.loc D (P.x j)).1 (GT.J0 D m))
   (NL (r i) (s i) (s (suc i))) (\ m -> (TL.loc D (P.x j)).1 (minors D (r i) (s i) (s (suc i)) (T i) m)) =
  subst {Fin (NL (r i) (s i) (s (suc i))) -> (TL.Loc D (P.x j)).1.R} (\ L -> TG.TGr (suc d) (TL.Loc D (P.x j)) zero (\ m -> (TL.loc D (P.x j)).1 (GT.J0 D m)) (NL (r i) (s i) (s (suc i))) L)
   (F.funext (Fin (NL (r i) (s i) (s (suc i)))) (\ m -> (TL.Loc D (P.x j)).1.R)
     (minors (TL.Loc D (P.x j)) (r i) (s i) (s (suc i)) (P.Loc[j].TL1 i)) (\ m -> (TL.loc D (P.x j)).1 (minors D (r i) (s i) (s (suc i)) (T i) m))
    (\ m -> P.Loc[j].MP.minors-map (r i) (s i) (s (suc i)) (T i)
      (Enumerate[l].list _ (Enumerate[l].minors-index (r i) (s i) (s (suc i))) m)))
   (subst {Fin zero -> (TL.Loc D (P.x j)).1.R} (\ J1 -> TG.TGr (suc d) (TL.Loc D (P.x j)) zero J1 (NL (r i) (s i) (s (suc i)))
      (minors (TL.Loc D (P.x j)) (r i) (s i) (s (suc i)) (P.Loc[j].TL1 i)))
    (F.funext (Fin zero) (\ m -> (TL.Loc D (P.x j)).1.R) (GT.J0 (TL.Loc D (P.x j))) (\ m -> (TL.loc D (P.x j)).1 (GT.J0 D m)) (\ m -> efq m))
    (P.Loc[j].graded i d e)) ;
 result : Grades D k s r T = \ i d e ->
  TrueGradeLemma67[l].lemma67 (suc d) D zero (GT.J0 D) P.N P.x (NL (r i) (s i) (s (suc i))) (minors D (r i) (s i) (s (suc i)) (T i))
   (P.gx i d e) (ga i d e) ;
} ;

-- the double induction
claim-suc (k : Nat) (ih : Claim k) : (p : Nat) -> ClaimP (suc k) p = split {
 zero -> \ D s u T r h rk -> PZero[k,ih,D,s,u,T,r,h,rk].result ;
 suc p0 | ihp -> \ D s u T r h rk -> Assemble[suc k,p0,ihp,D,s,u,T,r,h,rk].result } ;
grades : (k : Nat) -> Claim k = split {
 zero -> \ D p s u T r h rk -> start D s r T ;
 suc k | ih -> \ D p s u T r h rk -> claim-suc k ih p D s u T r h rk } ;

module Lift68 (k : Nat) (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero))
 (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (h : Res D k p s u T) {
 lift : RS.Result D k p s T ->
  Plus (Id D.1.R D.1.o D.1.z) ((r : Nat -> Nat) * RS.Ranks k p s r * RS.Stables D k s r T * Grades D k s r T) = split {
  inl t -> inl t ;
  inr w -> inr (w.1,w.2.1,w.2.2,grades k D p s u T w.1 h w.2.1) } ;
} ;
-- Theorem 6.8: 1 = 0, or ranks r with A_i stable of rank r_i and
-- Gr(D_(r_i)(T i)) >= k - i, and Gr(D_p(u)) >= k + 1
theorem68 (k : Nat) (D : TG.RD) (p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero))
 (T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) (h : Res D k p s u T) :
 Plus (Id D.1.R D.1.o D.1.z) ((r : Nat -> Nat) * RS.Ranks k p s r * RS.Stables D k s r T * Grades D k s r T) *
 TG.TGr (suc k) D zero (GT.J0 D) (NL p p (s zero)) (minors D p p (s zero) u) =
 (Lift68[k,D,p,s,u,T,h].lift (RS.ranks k D p s u T h.1 h.2),Top[D,k,p,s,u,T,h].grade) ;
