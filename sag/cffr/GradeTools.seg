-- Tools for the grades in Theorem 6.8.
-- * in-trans: if x is in (I) and every I_i is in (K) then x is in (K);
--   tgr-mono: Gr(I) >= k mod J and I in (K) give Gr(K) >= k mod J (the
--   witnesses of ctete Def. 5 in I are in K, also after adding variables).
-- * Every minor of at least one column of u lies in the ideal of the
--   entries of u (the product ends with i(u_c), whose coordinates are
--   entries: IdealExt).
-- * Exactness and injectivity in R are exactness and injectivity modulo
--   the empty list (J0).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module TG = TrueGrade[l] ;
J0 (D : TG.RD) : Fin zero -> D.1.R = \ i -> efq i ;
in-trans (D : TG.RD) (n : Nat) (I : Fin n -> D.1.R) (m : Nat) (K : Fin m -> D.1.R) (x : D.1.R)
 (hx : TG.InI D n I x) (hI : (i : Fin n) -> TG.InI D m K (I i)) : TG.InI D m K x =
 Tr.Trunc[FiniteIdeal[l].Sums[D.1].Coordinates n I x].induction @l (\ w -> TG.InI D m K x)
  (\ w -> RegularIdeal[l].Generated[D.1,m,K].in-prop x)
  (\ v -> subst (TG.InI D m K) v.2
    (TrueGradeIdeals[l].Over[D.1,D.2].in-sum m K n (\ i -> D.1.mul (I i) (v.1 i))
     (\ i -> RegularIdeal[l].IdealLaws[D.1,RegularIdeal[l].Generated[D.1,m,K].ideal].in-eq (D.1.mul (v.1 i) (I i)) (D.1.mul (I i) (v.1 i))
       (D.1.mulC (v.1 i) (I i)) (RegularIdeal[l].Generated[D.1,m,K].ideal.in-mul (v.1 i) (I i) (hI i))))) hx ;
tgr-mono (k : Nat) (D : TG.RD) (mJ : Nat) (J : Fin mJ -> D.1.R) (n : Nat) (I : Fin n -> D.1.R) (m : Nat) (K : Fin m -> D.1.R)
 (hI : (i : Fin n) -> TG.InI D m K (I i)) (g : TG.TGr k D mJ J n I) : TG.TGr k D mJ J m K =
 TC.map ((p : Nat) * TG.Seq D k mJ J n I p) ((p : Nat) * TG.Seq D k mJ J m K p)
  (\ w -> (w.1,w.2.1,\ i -> in-trans (TG.ext w.1 D) n (TG.img w.1 D n I) m (TG.img w.1 D m K) (w.2.1 i) (w.2.2.1 i)
     (\ j -> TrueGradeBase[l].hom-in D (TG.ext w.1 D) (TG.incl w.1 D) m K (I j) (hI j)),w.2.2.2)) g ;

-- minors lie in the ideal of the entries
module Entries (D : TG.RD) (p q : Nat) (u : Matrices[l].Over[D.1].Mat p q) {
 module MI = Minors[l].Over[D.1,D.2] ;
 module FP = FinPairs[l] ;
 N : Nat = FP.times p q ;
 entry (i : Fin N) : D.1.R = u (FP.enum p q i).1 (FP.enum p q i).2 ;
 module GE = RegularIdeal[l].Generated[D.1,N,entry] ;
 module IE = IdealExt[l].Over[D.1,D.2,GE.ideal] ;
 is-entry (c : Fin p) (j : Fin q) : GE.In (u c j) =
  subst (\ w -> GE.In (u w.1 w.2)) (FP.preimage p q c j).2 (GE.generator (FP.preimage p q c j).1) ;
 minor-in (k : Nat) (ci : MI.Index (suc k) p q) : GE.In (MI.minors (suc k) p q u ci) =
  IE.in-mul-left q (Matrices[l].Over[D.1].wedge k q (\ t -> u (ci.1 (inl t)))) (ExteriorModel[l].Over[D.1].gen q (u (ci.1 (inr tt))))
   (IE.in-gen q (u (ci.1 (inr tt))) (\ j -> is-entry (ci.1 (inr tt)) j)) ci.2 ;
} ;

-- absolute = modulo the empty list
module Absolute (D : TG.RD) {
 module MM = Matrices[l].Over[D.1] ;
 module EMod = ExactMod[l].Over[D.1,D.2] ;
 in0 (x : D.1.R) (h : Id D.1.R x D.1.z) : EMod.In zero (J0 D) x =
  Tr.Trunc[FiniteIdeal[l].Sums[D.1].Coordinates zero (J0 D) x].inc (\ i -> efq i,sym h) ;
 from0 (x : D.1.R) (h : EMod.In zero (J0 D) x) : Id D.1.R x D.1.z =
  Tr.Trunc[FiniteIdeal[l].Sums[D.1].Coordinates zero (J0 D) x].induction @l (\ w -> Id D.1.R x D.1.z) (\ w -> D.2 x D.1.z)
   (\ v -> sym v.2) h ;
 inj (p q : Nat) (u : MM.Mat p q) (h : MM.Injective p q u) : EMod.InjMod zero (J0 D) p q u =
  \ x hx k -> in0 (x k) (h x (\ j -> from0 (MM.apply p q u x j) (hx j)) k) ;
 exact (p q l1 : Nat) (u : MM.Mat p q) (v : MM.Mat q l1) (h : MM.Exact p q l1 u v) : EMod.ExactMod zero (J0 D) p q l1 u v =
  \ y hy -> TC.map ((x : MM.Vec p) * ((i : Fin q) -> Id D.1.R (MM.apply p q u x i) (y i)))
   ((x : MM.Vec p) * EMod.VecIn zero (J0 D) q (\ j -> EMod.sub (y j) (MM.apply p q u x j)))
   (\ w -> (w.1,\ j -> in0 (EMod.sub (y j) (MM.apply p q u w.1 j))
     (trans (ap (EMod.sub (y j)) (w.2 j)) (D.1.addN (y j)))))
   (h y (\ j -> from0 (MM.apply q l1 v y j) (hy j))) ;
} ;
