-- The two dualities on Lambda(R^(q+p)), for cffr Lemma 8.4.  For y in
-- Lambda(R^n), star(y) has (star y | e_I) = [y e_I] (ExteriorDuality,
-- star-pair) and y* = bstar(y) has (y* | e_I) = [e_I y] (Lemma82).
-- Claim: if y = v_1 ... v_q is a product of q generators, n = q + p, then
--   star(y) = c y*,   c = (sgn p)^q,  sgn k = (-1)^k,
-- hence y = c unstar(y*)  (unstar-bstar).
-- Proof.  y x = alpha^q(x) y for every x (wedge-swap: gen(v) x =
-- alpha(x) gen(v), induction on q).  alpha(e_I) = sgn|I| e_I (alpha-wedge
-- and basis-product), so alpha^q(e_I) = (sgn|I|)^q e_I (alphas-scale).
-- For |I| = p: [y e_I] = [alpha^q(e_I) y] = c [e_I y].  For |I| /= p both
-- sides are 0 by degree (q + |I| /= q + p).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ; module H = ExteriorHomogeneous[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module EC = ExteriorContr[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module L82 = Lemma82[l].Over[Rg,setR] ;
 sgn : Nat -> R = split { zero -> o ; suc k | r -> neg r } ;
 pw (a : R) : Nat -> R = split { zero -> o ; suc k | r -> mul a r } ;
 module At (n : Nat) {
  module EU = Euler[l].Over[Rg,setR,n] ;
  neg-scale (s : R) (x : Ext n) : Id (Ext n) (escale n (neg s) x) (eneg n (escale n s x)) =
   trans (ap (\ c -> escale n c x) (sym (trans (L.neg-mul-left o s) (ap neg (L.one-left s)))))
    (trans (sym (EA.escale-scale n (neg o) s x)) (EU.neg-scale (escale n s x))) ;
  unstar-scale (a : R) (x : Ext n) : Id (Ext n) (DU.unstar n (escale n a x)) (escale n a (DU.unstar n x)) =
   trans (ap (\ t -> DU.unstar n (escale n a t)) (sym (DU.star-unstar n x)))
    (trans (ap (DU.unstar n) (sym (DU.star-scale n a (DU.unstar n x)))) (DU.unstar-star n (escale n a (DU.unstar n x)))) ;
  -- alpha on a product of m generators
  alpha-wedge : (m : Nat) (a : Ps.Fin m -> AL.Vec n) ->
   Id (Ext n) (alpha n (eprod n m (\ k -> gen n (a k)))) (escale n (sgn m) (eprod n m (\ k -> gen n (a k)))) = split {
   zero -> \ a -> trans (EA.alpha-emb n o) (sym (EA.escale-one n (eone n))) ;
   suc m | r -> \ a -> calc (Ext n) {
    alpha n (emul n (eprod n m (\ k -> gen n (a (inl k)))) (gen n (a (inr tt))))
     =< EA.alpha-mul n (eprod n m (\ k -> gen n (a (inl k)))) (gen n (a (inr tt)))
     > emul n (alpha n (eprod n m (\ k -> gen n (a (inl k))))) (alpha n (gen n (a (inr tt))))
     =< DT.emul-cong n (r (\ k -> a (inl k))) (EA.alpha-gen n (a (inr tt)))
     > emul n (escale n (sgn m) (eprod n m (\ k -> gen n (a (inl k))))) (eneg n (gen n (a (inr tt))))
     =< EA.mul-neg-r n (escale n (sgn m) (eprod n m (\ k -> gen n (a (inl k))))) (gen n (a (inr tt)))
     > eneg n (emul n (escale n (sgn m) (eprod n m (\ k -> gen n (a (inl k))))) (gen n (a (inr tt))))
     =< ap (eneg n) (EA.scale-mul-left n (sgn m) (eprod n m (\ k -> gen n (a (inl k)))) (gen n (a (inr tt))))
     > eneg n (escale n (sgn m) (emul n (eprod n m (\ k -> gen n (a (inl k)))) (gen n (a (inr tt)))))
     =< sym (neg-scale (sgn m) (emul n (eprod n m (\ k -> gen n (a (inl k)))) (gen n (a (inr tt)))))
     > escale n (neg (sgn m)) (emul n (eprod n m (\ k -> gen n (a (inl k)))) (gen n (a (inr tt)))) } } ;
  alpha-basis (I : C.Index n) : Id (Ext n) (alpha n (CO.basis n I)) (escale n (sgn (BA.count n I)) (CO.basis n I)) =
   trans (ap (alpha n) (BA.basis-product n I))
    (trans (alpha-wedge (BA.count n I) (BA.select n I)) (ap (escale n (sgn (BA.count n I))) (sym (BA.basis-product n I)))) ;
  -- alpha applied k times
  alphas : Nat -> Ext n -> Ext n = split { zero -> \ x -> x ; suc k | r -> \ x -> r (alpha n x) } ;
  alphas-commute : (k : Nat) (s : R) (x : Ext n) -> Id (Ext n) (alphas k (escale n s x)) (escale n s (alphas k x)) = split {
   zero -> \ s x -> refl (escale n s x) ;
   suc k | r -> \ s x -> trans (ap (alphas k) (EA.alpha-scale n s x)) (r s (alpha n x)) } ;
  alphas-scale : (k : Nat) (s : R) (x : Ext n) -> Id (Ext n) (alpha n x) (escale n s x) ->
   Id (Ext n) (alphas k x) (escale n (pw s k) x) = split {
   zero -> \ s x h -> sym (EA.escale-one n x) ;
   suc k | r -> \ s x h -> trans (ap (alphas k) h)
    (trans (alphas-commute k s x)
     (trans (ap (escale n s) (r s x h)) (EA.escale-scale n s (pw s k) x))) } ;
  -- y x = alpha^q(x) y for y a product of q generators
  wedge-swap : (q : Nat) (b : Ps.Fin q -> AL.Vec n) (x : Ext n) ->
   Id (Ext n) (emul n (eprod n q (\ k -> gen n (b k))) x) (emul n (alphas q x) (eprod n q (\ k -> gen n (b k)))) = split {
   zero -> \ b x -> trans (EA.one-left n x) (sym (EA.one-right n x)) ;
   suc q | r -> \ b x -> calc (Ext n) {
    emul n (emul n (eprod n q (\ k -> gen n (b (inl k)))) (gen n (b (inr tt)))) x
     =< sym (EA.mulA' n (eprod n q (\ k -> gen n (b (inl k)))) (gen n (b (inr tt))) x)
     > emul n (eprod n q (\ k -> gen n (b (inl k)))) (emul n (gen n (b (inr tt))) x)
     =< ap (emul n (eprod n q (\ k -> gen n (b (inl k))))) (EC.gen-commute n (b (inr tt)) x)
     > emul n (eprod n q (\ k -> gen n (b (inl k)))) (emul n (alpha n x) (gen n (b (inr tt))))
     =< EA.mulA' n (eprod n q (\ k -> gen n (b (inl k)))) (alpha n x) (gen n (b (inr tt)))
     > emul n (emul n (eprod n q (\ k -> gen n (b (inl k)))) (alpha n x)) (gen n (b (inr tt)))
     =< ap (\ t -> emul n t (gen n (b (inr tt)))) (r (\ k -> b (inl k)) (alpha n x))
     > emul n (emul n (alphas q (alpha n x)) (eprod n q (\ k -> gen n (b (inl k))))) (gen n (b (inr tt)))
     =< sym (EA.mulA' n (alphas q (alpha n x)) (eprod n q (\ k -> gen n (b (inl k)))) (gen n (b (inr tt))))
     > emul n (alphas q (alpha n x)) (emul n (eprod n q (\ k -> gen n (b (inl k)))) (gen n (b (inr tt)))) } } ;
 } ;

 -- star(y) = c y* for y a product of q generators in Lambda(R^(q+p))
 module Dual (q p : Nat) (b : Ps.Fin q -> AL.Vec (plus q p)) {
  module AT = At[plus q p] ;
  y : Ext (plus q p) = eprod (plus q p) q (\ k -> gen (plus q p) (b k)) ;
  y-degree : DG.Deg (plus q p) q y = DG.deg-eprod (plus q p) q (\ k -> gen (plus q p) (b k)) (\ k -> DG.deg-gen (plus q p) (b k)) ;
  c : R = pw (sgn p) q ;
  star-top (I : C.Index (plus q p)) :
   Id R (CO.coeff (plus q p) (DU.star (plus q p) y) I) (top (plus q p) (emul (plus q p) y (CO.basis (plus q p) I))) =
   trans (sym (CO.dot-basis (plus q p) (DU.star (plus q p) y) I)) (DU.star-pair (plus q p) y (CO.basis (plus q p) I)) ;
  at (I : C.Index (plus q p)) : Plus (Id Nat (BA.count (plus q p) I) p) (Not (Id Nat (BA.count (plus q p) I) p)) ->
   Id R (CO.coeff (plus q p) (DU.star (plus q p) y) I) (mul c (CO.coeff (plus q p) (L82.bstar (plus q p) y) I)) = split {
   inl e -> calc R {
    CO.coeff (plus q p) (DU.star (plus q p) y) I
     =< star-top I > top (plus q p) (emul (plus q p) y (CO.basis (plus q p) I))
     =< ap (top (plus q p)) (AT.wedge-swap q b (CO.basis (plus q p) I))
     > top (plus q p) (emul (plus q p) (AT.alphas q (CO.basis (plus q p) I)) y)
     =< ap (\ t -> top (plus q p) (emul (plus q p) t y))
         (AT.alphas-scale q (sgn p) (CO.basis (plus q p) I)
          (trans (AT.alpha-basis I) (ap (\ k -> escale (plus q p) (sgn k) (CO.basis (plus q p) I)) e)))
     > top (plus q p) (emul (plus q p) (escale (plus q p) c (CO.basis (plus q p) I)) y)
     =< ap (top (plus q p)) (EA.scale-mul-left (plus q p) c (CO.basis (plus q p) I) y)
     > top (plus q p) (escale (plus q p) c (emul (plus q p) (CO.basis (plus q p) I) y))
     =< DG.top-scale (plus q p) c (emul (plus q p) (CO.basis (plus q p) I) y)
     > mul c (top (plus q p) (emul (plus q p) (CO.basis (plus q p) I) y))
     =< ap (mul c) (sym (L82.bstar-coeff (plus q p) y I))
     > mul c (CO.coeff (plus q p) (L82.bstar (plus q p) y) I) } ;
   inr ne -> trans (star-top I)
    (trans (HO.top-product-vanish (plus q p) q (BA.count (plus q p) I) y (CO.basis (plus q p) I) y-degree
      (BA.basis-degree (plus q p) I) (\ h -> ne (H.plus-cancel-left q (BA.count (plus q p) I) p h)))
     (sym (trans (ap (mul c) (trans (L82.bstar-coeff (plus q p) y I)
       (HO.top-product-vanish (plus q p) (BA.count (plus q p) I) q (CO.basis (plus q p) I) y
        (BA.basis-degree (plus q p) I) y-degree
        (\ h -> ne (H.plus-cancel-right (BA.count (plus q p) I) p q (trans h (plus-comm q p)))))))
      (L.mul-zero c)))) } ;
  star-bstar : Id (Ext (plus q p)) (DU.star (plus q p) y) (escale (plus q p) c (L82.bstar (plus q p) y)) =
   CO.ext (plus q p) (DU.star (plus q p) y) (escale (plus q p) c (L82.bstar (plus q p) y))
    (\ I -> trans (at I (H.DecNat.dec (BA.count (plus q p) I) p))
     (sym (CO.coeff-scale (plus q p) c (L82.bstar (plus q p) y) I))) ;
  unstar-bstar : Id (Ext (plus q p)) y (escale (plus q p) c (DU.unstar (plus q p) (L82.bstar (plus q p) y))) =
   trans (sym (DU.unstar-star (plus q p) y))
    (trans (ap (DU.unstar (plus q p)) star-bstar) (AT.unstar-scale c (L82.bstar (plus q p) y))) ;
 } ;
} ;
