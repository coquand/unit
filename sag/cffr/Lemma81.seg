-- cffr Lemma 8.1.  If v is orthogonal to u_1, ..., u_p in R^n
-- (v . u_i = 0), then W = u_1 ... u_p is orthogonal to v beta for every
-- beta in Lambda(R^n).
-- Proof.  c_v(W) = 0 (W is killed by v), by induction on p: c_v(1) = 0
-- (Euler.cemb), and c_v(W' u) = c_v(W') u + (v . u) alpha(W')
-- (contract-right) is 0 + 0.  Then
--   (W | v beta) = (c_v W | beta) = 0      (contract-pair).
-- For Lemma 8.2 we also use the other side: if c_v(w) = 0 then
-- (w | X v) = 0 for every X, since X v = v alpha(X) (right-commute).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (n : Nat) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 module EU = Euler[l].Over[Rg,setR,n] ;
 -- v is orthogonal to the columns of u
 Orthogonal (p : Nat) (v : MM.Vec n) (u : MM.Mat p n) : U l =
  (i : Ps.Fin p) -> Id R (VC.vdot n v (u i)) z ;
 -- w is killed by v: c_v(w) = 0
 Killed (v : MM.Vec n) (w : Ext n) : U l = Id (Ext n) (VC.contract n v w) (ezero n) ;
 killed : (p : Nat) (v : MM.Vec n) (u : MM.Mat p n) -> Orthogonal p v u -> Killed v (MM.wedge p n u) = split {
  zero -> \ v u h -> EU.cemb n v o ;
  suc p | r -> \ v u h -> calc (Ext n) {
   VC.contract n v (emul n (MM.wedge p n (\ k -> u (inl k))) (gen n (u (inr tt))))
    =< VC.contract-right n v (u (inr tt)) (MM.wedge p n (\ k -> u (inl k)))
    > eadd n (emul n (VC.contract n v (MM.wedge p n (\ k -> u (inl k)))) (gen n (u (inr tt))))
        (escale n (VC.vdot n v (u (inr tt))) (alpha n (MM.wedge p n (\ k -> u (inl k)))))
    =< EA.At[n].G.cong-add
        (trans (ap (\ y -> emul n y (gen n (u (inr tt)))) (r v (\ k -> u (inl k)) (\ k -> h (inl k))))
         (EA.mul-zero-l n (gen n (u (inr tt)))))
        (trans (ap (\ c -> escale n c (alpha n (MM.wedge p n (\ k -> u (inl k))))) (h (inr tt)))
         (EA.zero-scale n (alpha n (MM.wedge p n (\ k -> u (inl k))))))
    > eadd n (ezero n) (ezero n)
    =< EA.eaddZ n (ezero n) > ezero n } } ;
 -- a killed element is orthogonal to v beta and to X v
 left-orthogonal (v : MM.Vec n) (w : Ext n) (k : Killed v w) (beta : Ext n) :
  Id R (DU.dot n w (emul n (gen n v) beta)) z = calc R {
  DU.dot n w (emul n (gen n v) beta)
   =< ap (DU.dot n w) (sym (VC.left-wedge-value n v beta)) > DU.dot n w (VC.left-wedge n v beta)
   =< sym (VC.contract-pair n v w beta) > DU.dot n (VC.contract n v w) beta
   =< ap (\ x -> DU.dot n x beta) k > DU.dot n (ezero n) beta
   =< DU.dot-zero-left n beta > z } ;
 right-orthogonal (v : MM.Vec n) (w : Ext n) (k : Killed v w) (X : Ext n) :
  Id R (DU.dot n w (emul n X (gen n v))) z =
  trans (ap (DU.dot n w) (sym (VC.right-commute n v X))) (left-orthogonal v w k (alpha n X)) ;
 -- Lemma 8.1
 lemma81 (p : Nat) (v : MM.Vec n) (u : MM.Mat p n) (h : Orthogonal p v u) (beta : Ext n) :
  Id R (DU.dot n (MM.wedge p n u) (emul n (gen n v) beta)) z =
  left-orthogonal v (MM.wedge p n u) (killed p v u h) beta ;
} ;
