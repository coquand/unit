-- cffr Lemma 8.6.  If (a_K) is regular and a_K = g b_K with Gr(b) >= 2
-- (Lemma84.GrTwo), then g is regular and is a greatest common divisor of
-- the a_K: g divides every a_K, and every s dividing every a_K
-- (a_K = s c_K) divides g.
-- Proof.  g x = 0 gives a_K x = b_K (g x) = 0, so x = 0.  Let a_K = s c_K.
-- Then s is regular in the same way, and s (b_K c_M - b_M c_K) =
-- b_K a_M - b_M a_K = g (b_K b_M - b_M b_K) = 0, so c is proportional to b,
-- hence (Gr(b) >= 2) merely c_K = t b_K.  Then (g - s t) b_K = a_K - s c_K
-- = 0 for all K, so g = s t since b is regular.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module RI = MI.RI ;
 module L84 = Lemma84[l].Over[Rg,setR] ;
 Divides (X : U l) (s : R) (a : X -> R) : U l = (c : X -> R) * ((K : X) -> Id R (a K) (mul s (c K))) ;
 Gcd (X : U l) (a : X -> R) (g : R) : U l =
  Divides X g a * ((s : R) -> Divides X s a -> Tr.Trunc[(t : R) * Id R g (mul s t)].carrier) ;
 RegularElement (g : R) : U l = (x : R) -> Id R (mul g x) z -> Id R x z ;
 -- a factor of a regular family is a regular element
 factor-regular (X : U l) (a c : X -> R) (s : R) (h : (K : X) -> Id R (a K) (mul s (c K))) (ra : RI.Regular X a) :
  RegularElement s = \ x hx -> ra x tt (\ K -> calc R {
  mul (a K) x =< ap (\ y -> mul y x) (h K) > mul (mul s (c K)) x
   =< ap (\ y -> mul y x) (mulC s (c K)) > mul (mul (c K) s) x
   =< sym (mulA (c K) s x) > mul (c K) (mul s x)
   =< ap (mul (c K)) hx > mul (c K) z
   =< L.mul-zero (c K) > z }) ;
 module Lemma86 (X : U l) (a b : X -> R) (g : R) (ha : (K : X) -> Id R (a K) (mul g (b K)))
  (ra : RI.Regular X a) (gb : L84.GrTwo X b) {
  g-regular : RegularElement g = factor-regular X a b g ha ra ;
  module Greatest (s : R) (d : Divides X s a) {
   c (K : X) : R = d.1 K ;
   s-regular : RegularElement s = factor-regular X a c s d.2 ra ;
   -- c is proportional to b
   prop (K M : X) : Id R (mul (b K) (c M)) (mul (b M) (c K)) =
    L84.eq-from-sub (mul (b K) (c M)) (mul (b M) (c K))
     (s-regular (add (mul (b K) (c M)) (neg (mul (b M) (c K)))) (calc R {
      mul s (add (mul (b K) (c M)) (neg (mul (b M) (c K))))
       =< dist s (mul (b K) (c M)) (neg (mul (b M) (c K)))
       > add (mul s (mul (b K) (c M))) (mul s (neg (mul (b M) (c K))))
       =< Ps.cong2 R add _ _ _ _ (L.mul-swap s (b K) (c M))
           (trans (L.mul-neg s (mul (b M) (c K))) (ap neg (L.mul-swap s (b M) (c K))))
       > add (mul (b K) (mul s (c M))) (neg (mul (b M) (mul s (c K))))
       =< Ps.cong2 R (\ u w -> add (mul (b K) u) (neg (mul (b M) w))) _ _ _ _
           (trans (sym (d.2 M)) (ha M)) (trans (sym (d.2 K)) (ha K))
       > add (mul (b K) (mul g (b M))) (neg (mul (b M) (mul g (b K))))
       =< ap (\ u -> add (mul (b K) (mul g (b M))) (neg u))
           (trans (L.mul-swap (b M) g (b K)) (trans (ap (mul g) (mulC (b M) (b K))) (sym (L.mul-swap (b K) g (b M)))))
       > add (mul (b K) (mul g (b M))) (neg (mul (b K) (mul g (b M))))
       =< addN (mul (b K) (mul g (b M))) > z })) ;
   -- c = t b gives g = s t
   from (m : L84.Multiple X b c) : Id R g (mul s m.1) =
    L84.eq-from-sub g (mul s m.1) (gb.1 (add g (neg (mul s m.1))) tt (\ K -> calc R {
     mul (b K) (add g (neg (mul s m.1)))
      =< dist (b K) g (neg (mul s m.1)) > add (mul (b K) g) (mul (b K) (neg (mul s m.1)))
      =< ap (add (mul (b K) g)) (L.mul-neg (b K) (mul s m.1)) > add (mul (b K) g) (neg (mul (b K) (mul s m.1)))
      =< Ps.cong2 R (\ u w -> add u (neg w)) _ _ _ _
          (trans (mulC (b K) g) (sym (ha K)))
          (trans (L.mul-swap (b K) s m.1) (trans (ap (mul s) (trans (mulC (b K) m.1) (sym (m.2 K)))) (sym (d.2 K))))
      > add (a K) (neg (a K))
      =< addN (a K) > z })) ;
   module TT = Tr.Trunc[(t : R) * Id R g (mul s t)] ;
   result : TT.carrier =
    Tr.Trunc[L84.Multiple X b c].induction @l (\ w -> TT.carrier) (\ w -> TT.proposition)
     (\ m -> TT.inc (m.1,from m)) (gb.2 c prop) ;
  } ;
  -- Lemma 8.6
  result : Gcd X a g = ((b,ha),\ s d -> Greatest[s,d].result) ;
 } ;
 -- a gcd of a family is a gcd of any family with the same elements, up to zeros
 module Transfer (X Y : U l) (a : X -> R) (b : Y -> R)
  (ab : (y : Y) -> Plus ((x : X) * Id R (b y) (a x)) (Id R (b y) z)) (ba : (x : X) -> (y : Y) * Id R (b y) (a x))
  (g : R) (gb : Gcd Y b g) {
  divides : Divides X g a = (\ x -> gb.1.1 (ba x).1,\ x -> trans (sym (ba x).2) (gb.1.2 (ba x).1)) ;
  cc (s : R) (d : Divides X s a) (y : Y) : Plus ((x : X) * Id R (b y) (a x)) (Id R (b y) z) -> R = split {
   inl w -> d.1 w.1 ; inr e -> z } ;
  cc-eq (s : R) (d : Divides X s a) (y : Y) : (h : Plus ((x : X) * Id R (b y) (a x)) (Id R (b y) z)) -> Id R (b y) (mul s (cc s d y h)) = split {
   inl w -> trans w.2 (d.2 w.1) ; inr e -> trans e (sym (L.mul-zero s)) } ;
  result : Gcd X a g = (divides,\ s d -> gb.2 s (\ y -> cc s d y (ab y),\ y -> cc-eq s d y (ab y))) ;
 } ;
} ;
