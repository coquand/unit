-- From the true grade (Thm 6.8) to the explicit forms used in §8.
-- For a list a in R: Gr(a) >= 1 (true grade, mod the empty list) gives a
-- regular, and Gr(a) >= 2 gives GrTwo (Lemma84): by TrueKoszul.Absolute
-- (true grade => Koszul grade Gr(a; R)) and cffr §6 items 1 and 2
-- (GradeOne.Item1.forward, GradeTwo.Item2.forward; a_i y_j - a_j y_i = 0
-- is the proportionality of Lemma84).  D_k(u) as the list of Thm68
-- (Enumerate.MinorList) and as the family Minors.minors: the family
-- contains the list, and the list reaches the family, so GrTwo passes
-- from the list to the family (Lemma84.Enlarge) and regularity both ways
-- (MinorList.from-list).  down: Gr >= k + 2 gives Gr >= 2.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ;
module TG = TrueGrade[l] ; module GT = GradeTools[l] ;
module Over (D : TG.RD) {
 module L = RL[D.1] ;
 module MI = Minors[l].Over[D.1,D.2] ;
 module RI = MI.RI ;
 module L84 = Lemma84[l].Over[D.1,D.2] ;
 module G1 = GradeOne[l].Over[D.1,D.2] ;
 module G2 = GradeTwo[l].Over[D.1,D.2] ;
 module EN = Enumerate[l] ;
 module T68 = Thm68[l] ;
 down : (k : Nat) (n : Nat) (a : Ps.Fin n -> D.1.R) -> TG.TGr (suc (suc k)) D zero (GT.J0 D) n a -> TG.TGr (suc (suc zero)) D zero (GT.J0 D) n a = split {
  zero -> \ n a g -> g ;
  suc k | r -> \ n a g -> r n a (TG.mono (suc (suc k)) D zero (GT.J0 D) n a g) } ;
 module Bridge (n : Nat) (a : Ps.Fin n -> D.1.R) {
  module AB = TrueKoszul[l].Absolute[D,n,a] ;
  module I1 = G1.Item1[AB.R0,n,a] ;
  module I2 = G2.Item2[AB.R0,n,a] ;
  regular (g : TG.TGr (suc zero) D zero (GT.J0 D) n a) : RI.Regular (Ps.Fin n) a =
   I1.forward (AB.result (suc zero) g) ;
  module Two (g : TG.TGr (suc (suc zero)) D zero (GT.J0 D) n a) {
   fw : G2.GR.Gr AB.R0 n a (suc zero) * I2.Explicit = I2.forward (AB.result (suc (suc zero)) g) ;
   alt-zero (y : Ps.Fin n -> D.1.R) (hy : (i j : Ps.Fin n) -> Id D.1.R (D.1.mul (a i) (y j)) (D.1.mul (a j) (y i))) (i j : Ps.Fin n) :
    Id D.1.R (D.1.add (D.1.mul (a i) (y j)) (D.1.neg (D.1.mul (a j) (y i)))) D.1.z =
    trans (ap (\ c -> D.1.add c (D.1.neg (D.1.mul (a j) (y i)))) (hy i j)) (D.1.addN (D.1.mul (a j) (y i))) ;
   module TM (y : Ps.Fin n -> D.1.R) { module T = Tr.Trunc[L84.Multiple (Ps.Fin n) a y] ; } ;
   result : L84.GrTwo (Ps.Fin n) a =
    (I1.forward fw.1,\ y hy ->
     Tr.Trunc[(e : D.1.R) * ((i : Ps.Fin n) -> Id D.1.R (y i) (D.1.mul (a i) e))].induction @l (\ w -> TM[y].T.carrier) (\ w -> TM[y].T.proposition)
      (\ w -> TM[y].T.inc (w.1,\ i -> trans (w.2 i) (D.1.mulC (a i) w.1))) (fw.2 y (alt-zero y hy))) ;
  } ;
 } ;
 -- D_k(u): from the list of Thm68 to the family of Minors
 module Minor (k p q : Nat) (u : Matrices[l].Over[D.1].Mat p q) {
  module ML = EN.MinorList[D.1,D.2,k,p,q,u] ;
  module BR = Bridge[T68.NL k p q,T68.minors D k p q u] ;
  regular (g : TG.TGr (suc zero) D zero (GT.J0 D) (T68.NL k p q) (T68.minors D k p q u)) : MI.RegularD k p q u =
   ML.from-list (BR.regular g) ;
  two (g : TG.TGr (suc (suc zero)) D zero (GT.J0 D) (T68.NL k p q) (T68.minors D k p q u)) :
   L84.GrTwo (MI.Index k p q) (MI.minors k p q u) =
   L84.Enlarge[Ps.Fin (T68.NL k p q),MI.Index k p q,T68.minors D k p q u,MI.minors k p q u,BR.Two[g].result,
    \ i -> inl (EN.list (MI.Index k p q) ML.E i,refl (T68.minors D k p q u i))].result ;
 } ;
} ;
