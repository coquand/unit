-- PolyRegular modulo a finitely generated ideal J = (J_1, ..., J_n) of R
-- (CFFR-INTERFACE, option R).  In R[X], J.R[X] is GX, the ideal generated by
-- the constants J_j; "regular mod J" is RegularIdeal.modulo of Generated.
-- For F_1, ..., F_m in R[X]:
--   c(F) regular mod J in R  iff  (F_j) regular mod J.R[X] in R[X].
-- (=>) Let F_j x in J.R[X] for all j.  On representatives f_j, g of F_j, x:
--   every coefficient of f_j g is in J (PolyIdeal), so by PolyMcCoy modulo J
--   every coefficient of g is in J, i.e. x in J.R[X] (PolyIdeal).
-- (<=) Let c(F) y in J.  Then F_j y has all coefficients in J
--   (kill-constant), so F_j y in J.R[X]; hence y in J.R[X], and y = the
--   constant coefficient of the constant y is in J.
-- Corollaries as in PolyRegular: ideals of R (Ideal.up/down), elements
-- (element-up/down), and the Kronecker polynomial (Kronecker.regular).
level l ; open Ring[l] ; open Poly[l] ; open Mul[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (J : Fin n -> A.R) {
 open A ; open PolyR[A] ; open MulR[A] ;
 module PI = PolyIdeal[l].Over[A,setA,n,J] ;
 module PR = PI.PR ; module AX = PR.AX ;
 module G = PI.G ; module GX = PI.GX ;
 module IL = RegularIdeal[l].IdealLaws[A,G.ideal] ;
 module RJ = RegularIdeal[l].Over[A,RegularIdeal[l].modulo A G.ideal] ;
 module RXJ = RegularIdeal[l].Over[AX.ring,RegularIdeal[l].modulo AX.ring GX.ideal] ;
 Carrier : U l = AX.Carrier ;
 in-include (p : P) (k : Nat) (h : G.In (PR.coefQ (AX.include p) k)) : G.In (coef p k) =
  IL.in-eq (PR.coefQ (AX.include p) k) (coef p k) (PR.coefQ-include p k) h ;

 module Family (m : Nat) (Fm : Fin m -> Carrier) {
  Content : U l = Fin m * Nat ;
  content (ci : Content) : R = PR.coefQ (Fm ci.1) ci.2 ;
  module On (fr : (j : Fin m) -> PR.Rep (Fm j)) {
   f (j : Fin m) : P = (fr j).1 ;
   module PM = PolyMcCoy[l].Over[A,G.ideal,Fin m,f] ;
   same (ci : Content) : Id R (PM.content ci) (content ci) =
    trans (sym (PR.coefQ-include (f ci.1) ci.2)) (ap (\ y -> PR.coefQ y ci.2) (fr ci.1).2) ;
   module Forward (reg : RJ.Regular Content content) (x : Carrier)
    (k : RXJ.ZeroOn (Fin m) Fm x) (g : PR.Rep x) {
    product (j : Fin m) : Id Carrier (AX.include (pmul (f j) g.1)) (AX.mulQ (Fm j) x) =
     trans (sym (PR.product (f j) g.1))
      (trans (ap (\ y -> AX.mulQ y (AX.include g.1)) (fr j).2) (ap (AX.mulQ (Fm j)) g.2)) ;
    kill : PM.Kill g.1 = \ j i ->
     in-include (pmul (f j) g.1) i
      (IL.in-eq (PR.coefQ (AX.mulQ (Fm j) x) i) (PR.coefQ (AX.include (pmul (f j) g.1)) i)
       (ap (\ y -> PR.coefQ y i) (sym (product j))) (PI.to-coefficients (AX.mulQ (Fm j) x) (k j) i)) ;
    in-g : PM.InI g.1 =
     PM.mccoy (\ y t h -> reg y t (\ ci -> IL.in-eq (mul (PM.content ci) y) (mul (content ci) y)
       (ap (\ c -> mul c y) (same ci)) (h ci))) g.1 kill ;
    result : GX.In x =
     PI.from-coefficients x (\ i -> IL.in-eq (coef g.1 i) (PR.coefQ x i)
      (trans (sym (PR.coefQ-include g.1 i)) (ap (\ y -> PR.coefQ y i) g.2)) (in-g i)) ;
   } ;
   module Backward (reg : RXJ.Regular (Fin m) Fm) (y : R) (k : RJ.ZeroOn Content content y) {
    kill : PM.Kill (cons y nil) =
     PM.kill-constant y (\ ci -> IL.in-eq (mul (content ci) y) (mul (PM.content ci) y) (ap (\ c -> mul c y) (sym (same ci))) (k ci)) ;
    in-constant : GX.In (AX.constant y) =
     reg (AX.constant y) tt (\ j -> PI.from-coefficients (AX.mulQ (Fm j) (AX.constant y)) (\ i ->
      IL.in-eq (coef (pmul (f j) (cons y nil)) i) (PR.coefQ (AX.mulQ (Fm j) (AX.constant y)) i)
       (trans (sym (PR.coefQ-include (pmul (f j) (cons y nil)) i))
        (ap (\ w -> PR.coefQ w i)
         (trans (sym (PR.product (f j) (cons y nil))) (ap (\ w -> AX.mulQ w (AX.constant y)) (fr j).2))))
       (kill j i))) ;
    result : G.In y = in-include (cons y nil) zero (PI.to-coefficients (AX.constant y) in-constant zero) ;
   } ;
  } ;
  reps : Tr.Trunc[(j : Fin m) -> PR.Rep (Fm j)].carrier =
   AffineFinite[l].choice m (\ j -> PR.Rep (Fm j)) (\ j -> PR.rep (Fm j)) ;
  forward (reg : RJ.Regular Content content) : RXJ.Regular (Fin m) Fm = \ x t k ->
   Tr.Trunc[(j : Fin m) -> PR.Rep (Fm j)].induction @l (\ w -> GX.In x) (\ w -> GX.in-prop x)
    (\ fr -> Tr.Trunc[PR.Rep x].induction @l (\ w -> GX.In x) (\ w -> GX.in-prop x)
      (\ g -> On[fr].Forward[reg,x,k,g].result) (PR.rep x)) reps ;
  backward (reg : RXJ.Regular (Fin m) Fm) : RJ.Regular Content content = \ y t k ->
   Tr.Trunc[(j : Fin m) -> PR.Rep (Fm j)].induction @l (\ w -> G.In y) (\ w -> G.in-prop y)
    (\ fr -> On[fr].Backward[reg,y,k].result) reps ;
 } ;

 -- an ideal (a_j) of R: regular mod J iff its constants are regular mod J.R[X]
 module Ideal (r : Nat) (a : Fin r -> R) {
  module Fa = Family[r,\ j -> AX.constant (a j)] ;
  content-zero (j : Fin r) : Id R (Fa.content (j,zero)) (a j) = PR.coefQ-include (PI.RL0.constantP (a j)) zero ;
  content-suc (j : Fin r) (i : Nat) : Id R (Fa.content (j,suc i)) z = PR.coefQ-include (PI.RL0.constantP (a j)) (suc i) ;
  kills (y : R) (k : RJ.ZeroOn (Fin r) a y) : (j : Fin r) (i : Nat) -> G.In (mul (Fa.content (j,i)) y) = \ j -> split {
   zero -> IL.in-eq (mul (a j) y) (mul (Fa.content (j,zero)) y) (ap (\ c -> mul c y) (sym (content-zero j))) (k j) ;
   suc i -> IL.in-eq z (mul (Fa.content (j,suc i)) y)
    (sym (trans (ap (\ c -> mul c y) (content-suc j i)) (RL[A].zero-mul y))) G.ideal.in-zero } ;
  up (reg : RJ.Regular (Fin r) a) : RXJ.Regular (Fin r) (\ j -> AX.constant (a j)) =
   Fa.forward (\ y t k -> reg y t (\ j -> IL.in-eq (mul (Fa.content (j,zero)) y) (mul (a j) y)
     (ap (\ c -> mul c y) (content-zero j)) (k (j,zero)))) ;
  down (reg : RXJ.Regular (Fin r) (\ j -> AX.constant (a j))) : RJ.Regular (Fin r) a =
   \ y t k -> Fa.backward reg y t (\ ci -> kills y k ci.1 ci.2) ;
 } ;
 -- one element b of R: regular mod J iff the constant b is regular mod J.R[X]
 element-up (b : R) (reg : RJ.ElementUnder (\ x -> Top) b) : RXJ.ElementUnder (\ x -> Top) (AX.constant b) =
  \ x t k -> Ideal[suc zero,\ j -> b].up (\ y t1 h -> reg y t1 (h (inr tt))) x t (\ j -> k) ;
 element-down (b : R) (reg : RXJ.ElementUnder (\ x -> Top) (AX.constant b)) : RJ.ElementUnder (\ x -> Top) b =
  \ y t k -> Ideal[suc zero,\ j -> b].down (\ x t1 h -> reg x t1 (h (inr tt))) y t (\ j -> k) ;

 -- the Kronecker polynomial of (a_1, ..., a_r)
 module Kronecker (r : Nat) (a : Fin r -> R) {
  f : Carrier = AX.include (PR.kron r a) ;
  module F1 = Family[suc zero,\ j -> f] ;
  coef-f (ci : F1.Content) : Id R (F1.content ci) (coef (PR.kron r a) ci.2) = PR.coefQ-include (PR.kron r a) ci.2 ;
  kron-killed : (s : Nat) (b : Fin s -> R) (y : R) -> ((i : Nat) -> G.In (mul (coef (PR.kron s b) i) y)) ->
   RJ.ZeroOn (Fin s) b y = split {
   zero -> \ b y h -> AffineFinite[l].empty-section (\ j -> G.In (mul (b j) y)) ;
   suc s | rr -> \ b y h -> AffineFinite[l].section s (\ j -> G.In (mul (b j) y))
    (rr (\ j -> b (inl j)) y (\ i -> h (suc i))) (h zero) } ;
  kron-kills : (s : Nat) (b : Fin s -> R) (y : R) -> RJ.ZeroOn (Fin s) b y ->
   (i : Nat) -> G.In (mul (coef (PR.kron s b) i) y) = split {
   zero -> \ b y k i -> IL.in-eq z (mul z y) (sym (RL[A].zero-mul y)) G.ideal.in-zero ;
   suc s | rr -> \ b y k -> split {
    zero -> k (inr tt) ;
    suc i -> rr (\ j -> b (inl j)) y (\ j -> k (inl j)) i } } ;
  regular (reg : RJ.Regular (Fin r) a) : RXJ.Regular (Fin (suc zero)) (\ j -> f) =
   F1.forward (\ y t k -> reg y t (kron-killed r a y (\ i ->
    IL.in-eq (mul (F1.content (inr tt,i)) y) (mul (coef (PR.kron r a) i) y) (ap (\ c -> mul c y) (coef-f (inr tt,i))) (k (inr tt,i))))) ;
  content-regular (reg : RXJ.Regular (Fin (suc zero)) (\ j -> f)) : RJ.Regular (Fin r) a =
   \ y t k -> F1.backward reg y t (\ ci -> IL.in-eq (mul (coef (PR.kron r a) ci.2) y) (mul (F1.content ci) y)
     (ap (\ c -> mul c y) (sym (coef-f ci))) (kron-kills r a y k ci.2)) ;
 } ;
} ;
