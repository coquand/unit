-- An enumeration of Fin p * Fin q by Fin (times p q), with explicit
-- preimages, so that a family indexed by pairs (the entries of a matrix)
-- can be used where Lemma 2.3 asks for a list.
-- Fin (q + m) splits into Fin q + Fin m (split-fin, with the two
-- injections left and right as sections); Fin ((p+1) q) = Fin (q + p q):
-- the first q elements are the pairs (last, j), the others come from p.
level l ; open Ring[l] ; open Presentations[l] ;
times : Nat -> Nat -> Nat = split { zero -> \ q -> zero ; suc p | r -> \ q -> plus q (r q) } ;
lift-left (q m : Nat) : Plus (Fin q) (Fin m) -> Plus (Fin (suc q)) (Fin m) = split {
 inl a -> inl (inl a) ; inr b -> inr b } ;
split-fin : (q m : Nat) -> Fin (plus q m) -> Plus (Fin q) (Fin m) = split {
 zero -> \ m i -> inr i ;
 suc q | r -> \ m -> split { inl i -> lift-left q m (r m i) ; inr t -> inl (inr t) } } ;
left : (q m : Nat) -> Fin q -> Fin (plus q m) = split {
 zero -> \ m a -> efq a ;
 suc q | r -> \ m -> split { inl a -> inl (r m a) ; inr t -> inr t } } ;
right : (q m : Nat) -> Fin m -> Fin (plus q m) = split {
 zero -> \ m b -> b ; suc q | r -> \ m b -> inl (r m b) } ;
split-left : (q m : Nat) (a : Fin q) -> Id (Plus (Fin q) (Fin m)) (split-fin q m (left q m a)) (inl a) = split {
 zero -> \ m a -> efq a ;
 suc q | r -> \ m -> split {
  inl a -> ap (lift-left q m) (r m a) ;
  inr t -> refl (inl (inr t)) } } ;
split-right : (q m : Nat) (b : Fin m) -> Id (Plus (Fin q) (Fin m)) (split-fin q m (right q m b)) (inr b) = split {
 zero -> \ m b -> refl (inr b) ;
 suc q | r -> \ m b -> ap (lift-left q m) (r m b) } ;

pair-of (p q : Nat) (r : Fin (times p q) -> Fin p * Fin q) : Plus (Fin q) (Fin (times p q)) -> Fin (suc p) * Fin q = split {
 inl j -> (inr tt,j) ; inr i -> (inl (r i).1,(r i).2) } ;
enum : (p q : Nat) -> Fin (times p q) -> Fin p * Fin q = split {
 zero -> \ q i -> efq i ;
 suc p | r -> \ q i -> pair-of p q (r q) (split-fin q (times p q) i) } ;
Preimage (p q : Nat) (u : Fin p * Fin q) : U l = (i : Fin (times p q)) * Id (Fin p * Fin q) (enum p q i) u ;
preimage-last (p q : Nat) (j : Fin q) : Preimage (suc p) q (inr tt,j) =
 (left q (times p q) j,ap (pair-of p q (enum p q)) (split-left q (times p q) j)) ;
module Step (p q : Nat) (a : Fin p) (j : Fin q) (w : Preimage p q (a,j)) {
 i : Fin (times (suc p) q) = right q (times p q) w.1 ;
 eq : Id (Fin (suc p) * Fin q) (enum (suc p) q i) (inl a,j) =
  trans (ap (pair-of p q (enum p q)) (split-right q (times p q) w.1))
   (ap (\ u -> (inl u.1,u.2)) w.2) ;
 result : Preimage (suc p) q (inl a,j) = (i,eq) ;
} ;
preimage : (p q : Nat) (a : Fin p) (j : Fin q) -> Preimage p q (a,j) = split {
 zero -> \ q a j -> efq a ;
 suc p | r -> \ q -> split {
  inl a -> \ j -> Step[p,q,a,j,r q a j].result ;
  inr t -> \ j -> subst (\ s -> Preimage (suc p) q (inr s,j)) (MnSums[l].top-eq tt t) (preimage-last p q j) } } ;
