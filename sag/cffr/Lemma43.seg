-- cffr Lemma 4.3: if R^p -A-> R^q -B-> R^l is exact (B A = 0, ker B = im A)
-- and A is stable of rank n (D_(n+1)(A) = 0, D_n(A) regular), q = n + r,
-- then B is stable of rank r (D_(r+1)(B) = 0, D_r(B) regular).
-- In the image form of MinorForms (products of vectors of im A, im B).
-- Induction on n, for all rings and all l at once (p, q fixed).
-- n = 0: D_1(A) = 0 gives A = 0, so B is injective, and stable of rank q
--   (Theorem 2.4).
-- n + 1: the entries of A form a regular ideal (x killing them kills
--   D_(n+1)(A)); by Lemma 2.3 (LocalRegular) it is enough to prove the
--   conclusion in each L = R[1/a_kj], where the hypotheses still hold
--   (LocalExact, MinorForms.Local).  There a_kj is a unit, and UnitStep
--   gives (A', B') : L^p -> L^q -> L^(l+1), exact, A' stable of rank n; by
--   induction B' is stable of rank r + 1 (q = n + (r + 1)), hence B is
--   stable of rank r (ExtraRow: down for D_(r+1), up for D_r).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (p q : Nat) {
 Claim (n : Nat) : U l+ =
  (Rg : CRing) (setR : Pr.isSet Rg.R) (l1 r : Nat) -> Id Nat q (plus n r) ->
  (A : Matrices[l].Over[Rg].Mat p q) (B : Matrices[l].Over[Rg].Mat q l1) ->
  Matrices[l].Over[Rg].ComposeZero p q l1 A B -> Matrices[l].Over[Rg].Exact p q l1 A B ->
  MinorForms[l].Over[Rg,setR].ImageVanish (suc n) p q A -> MinorForms[l].Over[Rg,setR].ImageRegular n p q A ->
  MinorForms[l].Over[Rg,setR].ImageVanish (suc r) q l1 B * MinorForms[l].Over[Rg,setR].ImageRegular r q l1 B ;

 -- n = 0
 module Start (Rg : CRing) (setR : Pr.isSet Rg.R) (l1 r : Nat) (e : Id Nat q r)
  (A : Matrices[l].Over[Rg].Mat p q) (B : Matrices[l].Over[Rg].Mat q l1)
  (ex : Matrices[l].Over[Rg].Exact p q l1 A B)
  (van : MinorForms[l].Over[Rg,setR].ImageVanish (suc zero) p q A) {
  open Rg ;
  open ExteriorModel[l].Over[Rg] ;
  module MM = Matrices[l].Over[Rg] ;
  module MF = MinorForms[l].Over[Rg,setR] ;
  module MK = MinorKill[l].Over[Rg,setR] ;
  module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
  emb-inj : (n : Nat) (c : R) -> Id (Ext n) (emb n c) (ezero n) -> Id R c z = split {
   zero -> \ c h -> h ; suc n | r1 -> \ c h -> r1 c (ap (\ w -> w.1) h) } ;
  gen-inj : (n : Nat) (v : MM.Vec n) -> Id (Ext n) (gen n v) (ezero n) -> (i : Fin n) -> Id R (v i) z = split {
   zero -> \ v h i -> efq i ;
   suc n | r1 -> \ v h -> split {
    inl i -> r1 (\ j -> v (inl j)) (ap (\ w -> w.1) h) i ;
    inr t -> subst (\ s -> Id R (v (inr s)) z) (MnSums[l].top-eq tt t) (emb-inj n (v (inr tt)) (ap (\ w -> w.2) h)) } } ;
  zero-A (x : MM.Vec p) (i : Fin q) : Id R (MM.apply p q A x i) z =
   gen-inj q (MM.apply p q A x)
    (trans (sym (EA.escale-one q (gen q (MM.apply p q A x))))
     (trans (ap (escale q o) (sym (EA.one-left q (gen q (MM.apply p q A x))))) (van (\ t -> x)))) i ;
  injective : MM.Injective q l1 B = \ y hy i ->
   Tr.Trunc[(x : MM.Vec p) * ((j : Fin q) -> Id R (MM.apply p q A x j) (y j))].induction @l
    (\ w -> Id R (y i) z) (\ w -> setR (y i) z)
    (\ w -> trans (sym (w.2 i)) (zero-A w.1 i)) (ex y hy) ;
  stable : Minors[l].Over[Rg,setR].Stable q q l1 B = Minors[l].Over[Rg,setR].theorem24 q l1 B injective ;
  result : MF.ImageVanish (suc r) q l1 B * MF.ImageRegular r q l1 B =
   subst (\ s -> MF.ImageVanish (suc s) q l1 B * MF.ImageRegular s q l1 B) e
    (MF.vanish-to-image (suc q) q l1 B stable.1,MF.regular-to-image q q l1 B stable.2) ;
 } ;

 -- n + 1
 module Next (n : Nat) (ih : Claim n) (Rg : CRing) (setR : Pr.isSet Rg.R) (l1 r : Nat)
  (e : Id Nat q (plus (suc n) r))
  (A : Matrices[l].Over[Rg].Mat p q) (B : Matrices[l].Over[Rg].Mat q l1)
  (bz : Matrices[l].Over[Rg].ComposeZero p q l1 A B) (ex : Matrices[l].Over[Rg].Exact p q l1 A B)
  (van : MinorForms[l].Over[Rg,setR].ImageVanish (suc (suc n)) p q A)
  (reg : MinorForms[l].Over[Rg,setR].ImageRegular (suc n) p q A) {
  open Rg ;
  open ExteriorModel[l].Over[Rg] ;
  module MM = Matrices[l].Over[Rg] ;
  module MF = MinorForms[l].Over[Rg,setR] ;
  module MI = Minors[l].Over[Rg,setR] ;
  module MK = MinorKill[l].Over[Rg,setR] ;
  module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
  module RI = RegularIdeal[l].Over[Rg,RegularIdeal[l].self Rg] ;
  e1 : Id Nat q (plus n (suc r)) = trans e (sym (plus-suc n r)) ;
  -- the entries of A, enumerated
  N : Nat = FinPairs[l].times p q ;
  a (i : Fin N) : R = A (FinPairs[l].enum p q i).1 (FinPairs[l].enum p q i).2 ;
  module Entries (x : R) (h : RI.ZeroOn (Fin N) a x) {
   entry (k : Fin p) (j : Fin q) : Id R (mul (A k j) x) z =
    subst (\ u -> Id R (mul (A u.1 u.2) x) z) (FinPairs[l].preimage p q k j).2 (h (FinPairs[l].preimage p q k j).1) ;
   column (v : MM.Vec p) : Id (MM.Vec q) (\ j -> mul x (MM.apply p q A v j)) (\ j -> z) =
    WedgeStep[l].Over[Rg,setR,q].vec-ext q _ (\ j -> z) (\ j ->
     trans (sym (MM.S.sum-scale x p (\ k -> mul (v k) (A k j))))
      (trans (MM.S.sum-cong p _ (\ k -> z) (\ k -> trans (RL[Rg].mul-swap x (v k) (A k j))
         (trans (ap (mul (v k)) (trans (mulC x (A k j)) (entry k j))) (RL[Rg].mul-zero (v k)))))
       (MM.S.sum-zero p))) ;
   killed : MK.ImageKilled (suc n) p q A x = \ C ->
    trans (sym (EA.scale-mul-right q x (MM.wedge n q (MK.compose n p q A (\ t -> C (inl t)))) (gen q (MM.apply p q A (C (inr tt))))))
     (trans (ap (emul q (MM.wedge n q (MK.compose n p q A (\ t -> C (inl t)))))
       (trans (sym (EA.gen-scale q x (MM.apply p q A (C (inr tt)))))
        (trans (ap (gen q) (column (C (inr tt)))) (ExtraRow[l].Over[Rg,setR,q,q,\ i j -> z,\ i -> z].gen-zero q))))
      (EA.mul-zero-r q (MM.wedge n q (MK.compose n p q A (\ t -> C (inl t)))))) ;
  } ;
  entries : RI.Regular (Fin N) a = \ x t h -> reg x (Entries[x,h].killed) ;
  -- in R[1/a_i]
  module Loc (i : Fin N) {
   module LE = LocalExact[l].Over[Rg,setR,a i] ;
   module ML = MF.Local[a i] ;
   module MFL = MinorForms[l].Over[LE.I.ring,LE.setL] ;
   AL : Matrices[l].Over[LE.I.ring].Mat p q = LE.extend p q A ;
   BL : Matrices[l].Over[LE.I.ring].Mat q l1 = LE.extend q l1 B ;
   vanL : MFL.ImageVanish (suc (suc n)) p q AL =
    MFL.vanish-to-image (suc (suc n)) p q AL (ML.vanish (suc (suc n)) p q A (MF.image-to-vanish (suc (suc n)) p q A van)) ;
   regL : MFL.ImageRegular (suc n) p q AL =
    MFL.regular-to-image (suc n) p q AL (ML.regular (suc n) p q A (MF.image-to-regular (suc n) p q A reg)) ;
   unit : RL[LE.I.ring].unit (AL (FinPairs[l].enum p q i).1 (FinPairs[l].enum p q i).2) =
    LE.Bm.inverse (a i) (suc zero,sym (mulO (a i))) ;
   module US = UnitStep[l].Over[LE.I.ring,LE.setL,p,q,l1,AL,BL,(FinPairs[l].enum p q i).1,(FinPairs[l].enum p q i).2,unit] ;
   step : MFL.ImageVanish (suc (suc r)) q (suc l1) US.B' * MFL.ImageRegular (suc r) q (suc l1) US.B' =
    ih LE.I.ring LE.setL (suc l1) (suc r) e1 US.A' US.B'
     (US.Compose[LE.compose-zero p q l1 A B bz].result) (\ y hy -> US.Ex[LE.exact p q l1 A B ex,y,hy].result)
     (US.vanish n vanL) (US.regular n regL) ;
   bzL : Matrices[l].Over[LE.I.ring].ComposeZero p q l1 AL BL = LE.compose-zero p q l1 A B bz ;
   last-one : Id LE.I.ring.R (Matrices[l].Over[LE.I.ring].apply q (suc l1) US.B' US.a (inr tt)) LE.I.ring.o =
    trans (US.last-row US.a) US.one ;
   vanish : MFL.ImageVanish (suc r) q l1 BL = \ C ->
    US.XR.Down[US.a,bzL (FinPairs[l].enum p q i).1,last-one,LE.I.ring.o,suc r,C,
     step.1 (CommonPower[l].extend (Matrices[l].Over[LE.I.ring].Vec q) (suc r) C US.a)].result ;
   regular : MFL.ImageRegular r q l1 BL = \ x h -> step.2 x (US.XR.Up[x,r,h].result) ;
   vanish-minors : Minors[l].Over[LE.I.ring,LE.setL].Vanish (suc r) q l1 BL = MFL.image-to-vanish (suc r) q l1 BL vanish ;
   regular-minors : Minors[l].Over[LE.I.ring,LE.setL].RegularD r q l1 BL = MFL.image-to-regular r q l1 BL regular ;
  } ;
  -- back to R (Lemma 2.3)
  module LR = LocalRegular[l].AtFractions[Rg,setR,N,a].LR ;
  vanish-minors : MI.Vanish (suc r) q l1 B = \ ci ->
   LR.Zero[entries,MI.minors (suc r) q l1 B ci,\ i ->
    trans (sym (Loc[i].ML.minors-k (suc r) q l1 B ci)) (Loc[i].vanish-minors ci)].result ;
  regular-minors : MI.RegularD r q l1 B =
   LR.Ideal[entries,MI.Index r q l1,MI.minors r q l1 B,\ i -> \ y t hk ->
    Loc[i].regular-minors y t (\ ci -> trans (ap (\ w -> Loc[i].LE.I.ring.mul w y) (Loc[i].ML.minors-k r q l1 B ci)) (hk ci))].result ;
  result : MF.ImageVanish (suc r) q l1 B * MF.ImageRegular r q l1 B =
   (MF.vanish-to-image (suc r) q l1 B vanish-minors,MF.regular-to-image r q l1 B regular-minors) ;
 } ;

 lemma43 : (n : Nat) -> Claim n = split {
  zero -> \ Rg setR l1 r e A B bz ex van reg -> Start[Rg,setR,l1,r,e,A,B,ex,van].result ;
  suc n | ih -> \ Rg setR l1 r e A B bz ex van reg -> Next[n,ih,Rg,setR,l1,r,e,A,B,bz,ex,van,reg].result } ;
} ;
