-- cffr §2: regular finitely generated ideals, Lemma 2.1 and Corollary 2.2.
--
-- E is an R-set with a zero predicate: an action b x with (ab) x = a (b x),
-- 1 x = x, and a predicate Z ("is zero") with Z x -> Z (b x).  R itself
-- (Z x: x = 0), R modulo an ideal J (Z = membership in J) and every
-- R-module are instances.  A finitely
-- generated ideal is a list a : Fin n -> R (or a : X -> R, X finite); it is
-- regular for E when  a_1 x = ... = a_n x = 0  implies  x = 0  (Regular X a).
-- We work relative to a property Q of E closed under the action
-- (Q x gives Q (b x)): a is regular under Q when Q x and a_i x = 0 for
-- all i imply x = 0.  Regularity is the case Q = everything; the paper's
-- (a, a_1, ..., a_n) is the element a under Q = "a_1 x = ... = a_n x = 0",
-- which is closed since a_i (b x) = b (a_i x) = b 0 = 0.
--
-- Lemma 2.1.  If a and b are regular under Q, so is ab.  Indeed from Q x
-- and (ab) x = a (b x) = 0 we get Q (b x), hence b x = 0, hence x = 0.
-- Powers: a regular under Q gives a^k regular under Q, by Lemma 2.1 and
-- induction on k (a^0 x = x).
-- Corollary 2.2, with an exponent k_i for each generator, by induction on
-- n.  If a_1, ..., a_{n+1} is regular under Q then a_{n+1} is regular under
-- Q1 x = (Q x, a_1 x = ... = a_n x = 0), so a_{n+1}^k is (powers); that is,
-- a_1, ..., a_n is regular under Q2 x = (Q x, a_{n+1}^k x = 0), so by
-- induction a_1^{k_1}, ..., a_n^{k_n} is regular under Q2, which is the claim.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;

record Action (Rg : CRing) {
  E : U l ;
  -- "is zero": x = 0 for R or a module, x in J for "modulo J"
  Z : E -> U l ;
  act : Rg.R -> E -> E ;
  act-mul (a b : Rg.R) (x : E) : Id E (act (Rg.mul a b) x) (act a (act b x)) ;
  act-one (x : E) : Id E (act Rg.o x) x ;
  zero-closed (b : Rg.R) (x : E) : Z x -> Z (act b x) ;
} ;

-- an ideal of R given by its membership predicate
record IdealPred (Rg : CRing) {
  In : Rg.R -> U l ;
  in-zero : In Rg.z ;
  in-add (a b : Rg.R) : In a -> In b -> In (Rg.add a b) ;
  in-mul (b x : Rg.R) : In x -> In (Rg.mul b x) ;
} ;
module IdealLaws (Rg : CRing) (I : IdealPred[Rg]) {
 open Rg ;
 in-eq (a b : R) (h : Id R a b) (ha : I.In a) : I.In b = subst I.In h ha ;
 in-neg (a : R) (ha : I.In a) : I.In (neg a) =
  in-eq (mul (neg o) a) (neg a) (trans (RL[Rg].neg-mul-left o a) (ap neg (RL[Rg].one-left a))) (I.in-mul (neg o) a ha) ;
 in-cancel (a b : R) (ha : I.In a) (h : I.In (add a b)) : I.In b =
  in-eq (add (neg a) (add a b)) b
   (trans (addA (neg a) a b) (trans (ap (\ c -> add c b) (trans (addC (neg a) a) (addN a))) (RL[Rg].zl b)))
   (I.in-add (neg a) (add a b) (in-neg a ha) h) ;
 in-sub (a b : R) (ha : I.In a) (hb : I.In b) : I.In (add a (neg b)) = I.in-add a (neg b) ha (in-neg b hb) ;
} ;
-- the zero ideal
zero-ideal (Rg : CRing) : IdealPred[Rg] =
 mkIdealPred Rg (\ y -> Id Rg.R y Rg.z) (refl Rg.z)
  (\ a b ha hb -> trans (ap (\ c -> Rg.add c b) ha) (trans (RL[Rg].zl b) hb))
  (\ b x h -> trans (ap (Rg.mul b) h) (RL[Rg].mul-zero b)) ;
-- R modulo an ideal: x is "zero" when it lies in the ideal
modulo (Rg : CRing) (I : IdealPred[Rg]) : Action[Rg] =
 mkAction Rg Rg.R I.In Rg.mul (\ a b x -> sym (Rg.mulA a b x)) (RL[Rg].one-left) I.in-mul ;
-- the ring acting on itself
self (Rg : CRing) : Action[Rg] = modulo Rg (zero-ideal Rg) ;

module Over (Rg : CRing) (Ac : Action[Rg]) {
 open Rg ; open Ac ;
 module Pow = AffinePowers[l].Over[Rg] ;
 power (a : R) (k : Nat) : R = Pow.power a k ;

 -- the action commutes with itself
 act-swap (a b : R) (x : E) : Id E (act a (act b x)) (act b (act a x)) =
  calc E { act a (act b x)
   =< sym (act-mul a b x) > act (mul a b) x
   =< ap (\ c -> act c x) (mulC a b) > act (mul b a) x
   =< act-mul b a x > act b (act a x) } ;

 Kills (a : R) (x : E) : U l = Z (act a x) ;
 ZeroOn (X : U l) (a : X -> R) (x : E) : U l = (i : X) -> Kills (a i) x ;
 -- a regular under Q
 RegularUnder (Q : E -> U l) (X : U l) (a : X -> R) : U l =
  (x : E) -> Q x -> ZeroOn X a x -> Z x ;
 Regular (X : U l) (a : X -> R) : U l = RegularUnder (\ x -> Top) X a ;
 -- one element under Q
 ElementUnder (Q : E -> U l) (a : R) : U l = (x : E) -> Q x -> Kills a x -> Z x ;
 Closed (Q : E -> U l) : U l = (b : R) (x : E) -> Q x -> Q (act b x) ;

 kills-closed (a : R) : Closed (Kills a) =
  \ b x h -> subst Z (act-swap b a x) (zero-closed b (act a x) h) ;
 zero-on-closed (X : U l) (a : X -> R) : Closed (ZeroOn X a) =
  \ b x h i -> kills-closed (a i) b x (h i) ;
 both-closed (Q P : E -> U l) (cq : Closed Q) (cp : Closed P) : Closed (\ x -> Q x * P x) =
  \ b x h -> (cq b x h.1,cp b x h.2) ;
 top-closed : Closed (\ x -> Top) = \ b x h -> tt ;

 -- Lemma 2.1
 lemma21 (Q : E -> U l) (cq : Closed Q) (a b : R)
  (ha : ElementUnder Q a) (hb : ElementUnder Q b) : ElementUnder Q (mul a b) =
  \ x q k -> hb x q (ha (act b x) (cq b x q) (subst Z (act-mul a b x) k)) ;

 powers (Q : E -> U l) (cq : Closed Q) (a : R) (ha : ElementUnder Q a) :
  (k : Nat) -> ElementUnder Q (power a k) = split {
  zero -> \ x q h -> subst Z (act-one x) h ;
  suc k | ih -> lemma21 Q cq a (power a k) ha ih } ;

 -- the last generator, and the first n
 module Split (n : Nat) (a : Fin (suc n) -> R) {
  first (i : Fin n) : R = a (inl i) ;
  last : R = a (inr tt) ;
  join (x : E) (h : ZeroOn (Fin n) first x) (k : Kills last x) : ZeroOn (Fin (suc n)) a x =
   AffineFinite[l].section n (\ i -> Kills (a i) x) h k ;
 } ;

 -- Corollary 2.2: the induction step, with the hypothesis ih for n
 module Step (n : Nat)
  (ih : (Q : E -> U l) (cq : Closed Q) (a : Fin n -> R) (k : Fin n -> Nat) ->
   RegularUnder Q (Fin n) a -> RegularUnder Q (Fin n) (\ i -> power (a i) (k i)))
  (Q : E -> U l) (cq : Closed Q) (a : Fin (suc n) -> R) (k : Fin (suc n) -> Nat)
  (ha : RegularUnder Q (Fin (suc n)) a) {
  module S = Split[n,a] ;
  K : Nat = k (inr tt) ;
  Q1 (x : E) : U l = Q x * ZeroOn (Fin n) S.first x ;
  Q2 (x : E) : U l = Q x * Kills (power S.last K) x ;
  last1 : ElementUnder Q1 (power S.last K) =
   powers Q1 (both-closed Q (ZeroOn (Fin n) S.first) cq (zero-on-closed (Fin n) S.first)) S.last
    (\ x q h -> ha x q.1 (S.join x q.2 h)) K ;
  first2 : RegularUnder Q2 (Fin n) (\ i -> power (S.first i) (k (inl i))) =
   ih Q2 (both-closed Q (Kills (power S.last K)) cq (kills-closed (power S.last K)))
    S.first (\ i -> k (inl i)) (\ x q h -> last1 x (q.1,h) q.2) ;
  result : RegularUnder Q (Fin (suc n)) (\ i -> power (a i) (k i)) =
   \ x q h -> first2 x (q,h (inr tt)) (\ i -> h (inl i)) ;
 } ;
 corollary22 : (n : Nat) (Q : E -> U l) (cq : Closed Q) (a : Fin n -> R)
  (k : Fin n -> Nat) -> RegularUnder Q (Fin n) a ->
  RegularUnder Q (Fin n) (\ i -> power (a i) (k i)) = split {
  zero -> \ Q cq a k ha x q h -> ha x q (AffineFinite[l].empty-section (\ i -> Kills (a i) x)) ;
  suc n | ih -> \ Q cq a k ha -> Step[n,ih,Q,cq,a,k,ha].result } ;

 -- Corollary 2.2 as in the paper: a regular gives a^k regular, for any exponents
 regular-powers (n : Nat) (a : Fin n -> R) (k : Fin n -> Nat) (ha : Regular (Fin n) a) :
  Regular (Fin n) (\ i -> power (a i) (k i)) =
  corollary22 n (\ x -> Top) top-closed a k ha ;
} ;

-- the ideal generated by J_1, ..., J_n: x in J when merely x = sum_j v_j J_j
module Generated (Rg : CRing) (n : Nat) (J : Fin n -> Rg.R) {
 open Rg ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
 module AG = ExteriorAlgebra[l].AG[R,z,add,neg,addA,addC,addZ,addN] ;
 In (x : R) : U l = Tr.Trunc[S.Coordinates n J x].carrier ;
 in-prop (x : R) : Pr.isProp (In x) = Tr.Trunc[S.Coordinates n J x].proposition ;
 ideal : IdealPred[Rg] = mkIdealPred Rg In
  (Tr.Trunc[S.Coordinates n J z].inc (\ i -> z,S.lin-zero n J))
  (\ a b -> TC.map2 (S.Coordinates n J a) (S.Coordinates n J b) (S.Coordinates n J (add a b))
    (\ u v -> (\ i -> add (u.1 i) (v.1 i),trans (S.lin-add n J u.1 v.1) (AG.cong-add u.2 v.2))))
  (\ b x -> TC.map (S.Coordinates n J x) (S.Coordinates n J (mul b x))
    (\ u -> (\ i -> mul b (u.1 i),trans (S.lin-scale n J u.1 b) (ap (mul b) u.2)))) ;
 generator (i : Fin n) : In (J i) = Tr.Trunc[S.Coordinates n J (J i)].inc (S.coordinates n J i) ;
} ;
