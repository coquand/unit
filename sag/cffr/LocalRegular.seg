-- cffr Lemma 2.3: the local-global principle that replaces minimal primes.
--
-- Let I = (a_1, ..., a_n) be a regular ideal of R, and phi_i : R -> L_i ring
-- maps whose kernels are killed by powers of a_i: phi_i x = 0 gives,
-- merely, k with a_i^k x = 0.  (R[1/a_i] is the instance, below.)
--
-- (1) If phi_i x = 0 for every i then x = 0.  Choose k_i with
--     a_i^{k_i} x = 0 (finite choice); the ideal (a_1^{k_1}, ..., a_n^{k_n})
--     is regular (Corollary 2.2), so x = 0.  A finitely generated ideal J
--     which is 0 in each L_i is 0: apply this to its generators.
-- (2) If J = (b_j), j in a finite X, is regular in each L_i then J is regular.  Let
--     b_j y = 0 for all j.  Then phi_i(b_j) phi_i(y) = phi_i(b_j y) = 0, so
--     phi_i y = 0 since J is regular in L_i, for each i; so y = 0 by (1).
--
-- Instance: L = R[1/a], the ring of fractions (horrocks/MonoidLocalization)
-- at the powers of a; its kernel is killed by a power of a.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;

module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (n : Nat) (a : Fin n -> Rg.R)
 (L : Fin n -> CRing) (phi : (i : Fin n) -> RingHom[l].Hom Rg (L i))
 (kernel : (i : Fin n) (x : Rg.R) -> Id (L i).R ((phi i).1 x) (L i).z ->
   Tr.Trunc[(k : Nat) * Id Rg.R (Rg.mul (AffinePowers[l].Over[Rg].power (a i) k) x) Rg.z].carrier) {
 open Rg ;
 module RI = RegularIdeal[l].Over[Rg,RegularIdeal[l].self Rg] ;
 f (i : Fin n) (x : R) : (L i).R = (phi i).1 x ;
 Killed (x : R) (i : Fin n) : U l = (k : Nat) * Id R (mul (RI.power (a i) k) x) z ;

 module Zero (reg : RI.Regular (Fin n) a) (x : R) (local : (i : Fin n) -> Id (L i).R (f i x) (L i).z) {
  from-exponents (k : (i : Fin n) -> Killed x i) : Id R x z =
   RI.regular-powers n a (\ i -> (k i).1) reg x tt (\ i -> (k i).2) ;
  -- (1)
  result : Id R x z =
   Tr.Trunc[(i : Fin n) -> Killed x i].induction @l (\ w -> Id R x z) (\ w -> setR x z)
    from-exponents (AffineFinite[l].choice n (Killed x) (\ i -> kernel i x (local i))) ;
 } ;

 -- (2)
 module Ideal (reg : RI.Regular (Fin n) a) (X : U l) (b : X -> R)
  (local : (i : Fin n) -> RegularIdeal[l].Over[L i,RegularIdeal[l].self (L i)].Regular X (\ j -> f i (b j))) {
  module At (y : R) (h : RI.ZeroOn X b y) {
   image (i : Fin n) (j : X) : Id (L i).R ((L i).mul (f i (b j)) (f i y)) (L i).z =
    calc (L i).R { (L i).mul (f i (b j)) (f i y)
     =< sym ((phi i).2.2.2 (b j) y) > f i (mul (b j) y)
     =< ap (f i) (h j) > f i z
     =< RingHom[l].zero Rg (L i) (phi i) > (L i).z } ;
   vanish (i : Fin n) : Id (L i).R (f i y) (L i).z = local i (f i y) tt (image i) ;
  } ;
  result : RI.Regular X b = \ y t h -> Zero[reg,y,At[y,h].vanish].result ;
 } ;
} ;

-- R[1/a]: the fractions with denominators the powers of a
module Invert (Rg : CRing) (a : Rg.R) {
 open Rg ;
 module Pow = AffinePowers[l].Over[Rg] ;
 Powers (s : R) : U l = (k : Nat) * Id R s (Pow.power a k) ;
 one : Powers o = (zero,refl o) ;
 product (s t : R) (hs : Powers s) (ht : Powers t) : Powers (mul s t) =
  (plus hs.1 ht.1,
   trans (cong2 R mul _ _ _ _ hs.2 ht.2) (sym (Pow.power-add a hs.1 ht.1))) ;
 module B = MonoidLocalization[l].Over[Rg,Powers,one,product] ;
 ring : CRing = B.ring ;
 inclusion : RingHom[l].Hom Rg ring = B.inclusion ;
 Killed (x : R) : U l = (k : Nat) * Id R (mul (Pow.power a k) x) z ;
 killed (x : R) (w : B.Kernel x) : Killed x =
  (w.2.1.1,trans (ap (\ c -> mul c x) (sym w.2.1.2)) w.2.2) ;
 kernel (x : R) (h : Id ring.R (inclusion.1 x) ring.z) : Tr.Trunc[Killed x].carrier =
  Tr.Trunc[B.Kernel x].induction @l (\ w -> Tr.Trunc[Killed x].carrier)
   (\ w -> Tr.Trunc[Killed x].proposition)
   (\ w -> Tr.Trunc[Killed x].inc (killed x w)) (B.kernel x h) ;
} ;

-- Lemma 2.3 at the localisations R[1/a_i]
module AtFractions (Rg : CRing) (setR : Pr.isSet Rg.R) (n : Nat) (a : Fin n -> Rg.R) {
 module LR = Over[Rg,setR,n,a,\ i -> Invert[Rg,a i].ring,\ i -> Invert[Rg,a i].inclusion,
   \ i -> Invert[Rg,a i].kernel] ;
} ;
