-- cffr Lemma 2.3 modulo a finitely generated ideal J = (J_1, ..., J_m)
-- (option R of CFFR-INTERFACE).  For ring maps phi_i : R -> L_i, "in J" in
-- L_i means in the ideal generated by the phi_i(J_j).  Hypothesis (clear):
-- if phi_i(x) is in J L_i then merely a_i^e x is in J for some e.
-- (1) If (a_1, ..., a_n) is regular mod J and phi_i(x) is in J L_i for
--     every i, then x is in J: choose e_i with a_i^(e_i) x in J; Cor. 2.2
--     modulo J (RegularIdeal over modulo) gives x in J.
-- (2) If b is regular mod J L_i in every L_i, then b is regular mod J: if
--     b_j y is in J for all j then phi(b_j) phi(y) = phi(b_j y) is in J L_i,
--     so phi(y) is in J L_i, and y is in J by (1).
-- Instance L_i = R[1/a_i]: if k(x) = sum_j k(J_j) y_j, clear the
-- denominators, s y_j = k(M_j); then k(s x - sum_j J_j M_j) = 0, so
-- t (s x - sum_j J_j M_j) = 0 for a power t of a_i, and (t s) x is in J.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) (m : Nat) (J : Fin m -> Rg.R)
 (n : Nat) (a : Fin n -> Rg.R)
 (L : Fin n -> CRing) (phi : (i : Fin n) -> RingHom[l].Hom Rg (L i))
 (clear : (i : Fin n) (x : Rg.R) ->
   RegularIdeal[l].Generated[L i,m,\ j -> (phi i).1 (J j)].In ((phi i).1 x) ->
   Tr.Trunc[(e : Nat) * RegularIdeal[l].Generated[Rg,m,J].In (Rg.mul (AffinePowers[l].Over[Rg].power (a i) e) x)].carrier) {
 open Rg ;
 module G = RegularIdeal[l].Generated[Rg,m,J] ;
 module RJ = RegularIdeal[l].Over[Rg,RegularIdeal[l].modulo Rg G.ideal] ;
 f (i : Fin n) (x : R) : (L i).R = (phi i).1 x ;
 GL (i : Fin n) : RegularIdeal[l].IdealPred[L i] = RegularIdeal[l].Generated[L i,m,\ j -> f i (J j)].ideal ;
 Killed (x : R) (i : Fin n) : U l = (e : Nat) * G.In (mul (RJ.power (a i) e) x) ;
 -- phi maps J into J L_i
 map-in (i : Fin n) (y : R) (h : G.In y) : (GL i).In (f i y) =
  TC.map (G.S.Coordinates m J y) (FiniteIdeal[l].Sums[L i].Coordinates m (\ j -> f i (J j)) (f i y))
   (\ v -> (\ j -> f i (v.1 j),trans (sym (StandardOpens[l].SumMap[Rg,L i,phi i].combination m J v.1)) (ap (f i) v.2))) h ;
 -- (1)
 module Zero (reg : RJ.Regular (Fin n) a) (x : R) (local : (i : Fin n) -> (GL i).In (f i x)) {
  from-exponents (k : (i : Fin n) -> Killed x i) : G.In x =
   RJ.regular-powers n a (\ i -> (k i).1) reg x tt (\ i -> (k i).2) ;
  result : G.In x =
   Tr.Trunc[(i : Fin n) -> Killed x i].induction @l (\ w -> G.In x) (\ w -> G.in-prop x)
    from-exponents (AffineFinite[l].choice n (Killed x) (\ i -> clear i x (local i))) ;
 } ;
 -- (2)
 module Ideal (reg : RJ.Regular (Fin n) a) (X : U l) (b : X -> R)
  (local : (i : Fin n) -> RegularIdeal[l].Over[L i,RegularIdeal[l].modulo (L i) (GL i)].Regular X (\ j -> f i (b j))) {
  module At (y : R) (h : RJ.ZeroOn X b y) {
   image (i : Fin n) (j : X) : (GL i).In ((L i).mul (f i (b j)) (f i y)) =
    subst (GL i).In ((phi i).2.2.2 (b j) y) (map-in i (mul (b j) y) (h j)) ;
   in-local (i : Fin n) : (GL i).In (f i y) = local i (f i y) tt (image i) ;
  } ;
  result : RJ.Regular X b = \ y t h -> Zero[reg,y,At[y,h].in-local].result ;
 } ;
} ;

-- the instance at R[1/a_i]
module Clear (Rg : CRing) (setR : Pr.isSet Rg.R) (m : Nat) (J : Fin m -> Rg.R) (c : Rg.R) (x : Rg.R) {
 open Rg ;
 module FL = Flat[l].Over[Rg,c] ;
 module I = FL.I ;
 module G = RegularIdeal[l].Generated[Rg,m,J] ;
 module GL = RegularIdeal[l].Generated[I.ring,m,\ j -> FL.k (J j)] ;
 module SR = FiniteIdeal[l].Sums[Rg] ; module SL = FiniteIdeal[l].Sums[I.ring] ;
 Goal : U l = (e : Nat) * G.In (mul (I.Pow.power c e) x) ;
 module Given (co : SL.Coordinates m (\ j -> FL.k (J j)) (FL.k x)) (cl : FL.Cleared m co.1) {
  s : R = cl.1 ; M (j : Fin m) : R = cl.2.2.1 j ;
  sum : R = SR.lin m J M ;
  ksx : Id I.ring.R (FL.k (mul s x)) (FL.k sum) =
   calc I.ring.R { FL.k (mul s x)
    =< FL.k-mul s x > I.ring.mul (FL.k s) (FL.k x)
    =< ap (I.ring.mul (FL.k s)) (sym co.2) > I.ring.mul (FL.k s) (SL.lin m (\ j -> FL.k (J j)) co.1)
    =< sym (SL.lin-scale m (\ j -> FL.k (J j)) co.1 (FL.k s))
    > SL.lin m (\ j -> FL.k (J j)) (\ j -> I.ring.mul (FL.k s) (co.1 j))
    =< SL.sum-cong m (\ j -> I.ring.mul (FL.k (J j)) (I.ring.mul (FL.k s) (co.1 j))) (\ j -> I.ring.mul (FL.k (J j)) (FL.k (M j)))
        (\ j -> ap (I.ring.mul (FL.k (J j))) (cl.2.2.2 j))
    > SL.lin m (\ j -> FL.k (J j)) (\ j -> FL.k (M j))
    =< sym (StandardOpens[l].SumMap[Rg,I.ring,I.inclusion].combination m J M) > FL.k sum } ;
  image : Id I.ring.R (FL.k (add (mul s x) (neg sum))) I.ring.z =
   calc I.ring.R { FL.k (add (mul s x) (neg sum))
    =< I.inclusion.2.2.1 (mul s x) (neg sum) > I.ring.add (FL.k (mul s x)) (FL.k (neg sum))
    =< ap (I.ring.add (FL.k (mul s x))) (RingHom[l].negation Rg I.ring I.inclusion sum)
    > I.ring.add (FL.k (mul s x)) (I.ring.neg (FL.k sum))
    =< ap {I.ring.R} (\ w -> I.ring.add w (I.ring.neg (FL.k sum))) ksx
    > I.ring.add (FL.k sum) (I.ring.neg (FL.k sum))
    =< I.ring.addN (FL.k sum) > I.ring.z } ;
  module Power (w : I.Killed (add (mul s x) (neg sum))) {
   t : R = I.Pow.power c w.1 ;
   ts : Id R (mul t (mul s x)) (mul t sum) = RingRearrange[l].cancel-difference Rg t (mul s x) sum w.2 ;
   e : Nat = plus w.1 cl.2.1.1 ;
   power-e : Id R (I.Pow.power c e) (mul t s) =
    trans (I.Pow.power-add c w.1 cl.2.1.1) (ap (mul t) (sym cl.2.1.2)) ;
   result : Goal =
    (e,RegularIdeal[l].IdealLaws[Rg,G.ideal].in-eq (mul t sum) (mul (I.Pow.power c e) x)
      (sym (trans (ap (\ y -> mul y x) power-e) (trans (sym (mulA t s x)) ts)))
      (G.ideal.in-mul t sum (Tr.Trunc[SR.Coordinates m J sum].inc (M,refl sum)))) ;
  } ;
  result : Tr.Trunc[Goal].carrier =
   TC.map (I.Killed (add (mul s x) (neg sum))) Goal (\ w -> Power[w].result) (I.kernel (add (mul s x) (neg sum)) image) ;
 } ;
 result (h : GL.In (FL.k x)) : Tr.Trunc[Goal].carrier =
  TC.bind (SL.Coordinates m (\ j -> FL.k (J j)) (FL.k x)) Goal
   (\ co -> TC.bind (FL.Cleared m co.1) Goal (\ cl -> Given[co,cl].result) (FL.clear m co.1)) h ;
} ;
module AtFractions (Rg : CRing) (setR : Pr.isSet Rg.R) (m : Nat) (J : Fin m -> Rg.R) (n : Nat) (a : Fin n -> Rg.R) {
 module LR = Over[Rg,setR,m,J,n,a,\ i -> LocalRegular[l].Invert[Rg,a i].ring,\ i -> LocalRegular[l].Invert[Rg,a i].inclusion,
   \ i x h -> Clear[Rg,setR,m,J,a i,x].result h] ;
} ;
