-- The step of McCoy's theorem (cffr Thm 2.4) in the exterior algebra of
-- L^q, for a linear form lambda = (lambda . -) and a vector v with
-- lambda . v = 1.  Write i(a) for the generator of a and P(w) for the
-- product i(w_1) ... i(w_m).
--
-- (1) lambda . (a + c v) = lambda . a + c (lambda . v)   (induction on q).
-- (2) i(a) i(b) = - i(b) i(a), so P i(a) i(v) = - (P i(v)) i(a).
-- (3) Shear: P(w_1 + t_1 v, ..., w_m + t_m v) i(v) = P(w) i(v), by
--     induction on m: i(a + c v) i(v) = i(a) i(v) since i(v)^2 = 0, and by
--     (2) the last factor moves past i(v) and back.
-- (4) Contraction c = c_lambda (ExteriorVectorContraction): c(1) = 0, and
--     c(P i(w)) = c(P) i(w) + (lambda . w) alpha(P) (contract-right), so
--     c(P(w)) = 0 when lambda . w_k = 0 for every k.
-- (5) If c(P) = 0 then c(P i(v)) = alpha(P); hence x P i(v) = 0 gives
--     x alpha(P) = 0, hence x P = alpha(x alpha(P)) = 0.
-- With t_k = -(lambda . w_k), the sheared vectors w'_k = w_k + t_k v have
-- lambda . w'_k = 0 by (1), so (3), (4), (5) give: x P(w) i(v) = 0 implies
-- x P(w') = 0  (Reduce.kill).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Lg : CRing) (setL : Pr.isSet Lg.R) (q : Nat) {
 open Lg ; module L = RL[Lg] ;
 module EA = ExteriorAlgebra[l].Over[Lg,setL] ;
 module AL = Alternating[l].Over[Lg,setL] ;
 module VC = ExteriorVectorContraction[l].Over[Lg,setL] ;
 module AR = ExteriorAlgebra[l].AG[R,z,add,neg,addA,addC,addZ,addN] ;
 open ExteriorModel[l].Over[Lg] ;
 module G = EA.At[q].G ;
 module MM = Matrices[l].Over[Lg] ; module S = FiniteIdeal[l].Sums[Lg] ; module D = MnSums[l].Over[Lg] ;
 -- a + c v
 comb (a : (AL.Vec q)) (c : R) (v : (AL.Vec q)) : (AL.Vec q) = \ j -> add (a j) (mul c (v j)) ;

 -- the prefix and the last coordinate of a + c v
 prefix-comb (n : Nat) (a v : AL.Vec (suc n)) (c : R) :
  Id (AL.Vec n) (VC.vector-prefix n (\ j -> add (a j) (mul c (v j))))
   (\ j -> add (VC.vector-prefix n a j) (mul c (VC.vector-prefix n v j))) =
  F.funext (Ps.Fin n) (\ j -> R) _ _ (\ j ->
   trans (VC.vector-prefix-value n (\ j1 -> add (a j1) (mul c (v j1))) j)
    (sym (AR.cong-add (VC.vector-prefix-value n a j) (ap (mul c) (VC.vector-prefix-value n v j))))) ;
 last-comb (n : Nat) (a v : AL.Vec (suc n)) (c : R) :
  Id R (VC.vector-last n (\ j -> add (a j) (mul c (v j))))
   (add (VC.vector-last n a) (mul c (VC.vector-last n v))) =
  trans (VC.vector-last-value n (\ j -> add (a j) (mul c (v j))))
   (sym (AR.cong-add (VC.vector-last-value n a) (ap (mul c) (VC.vector-last-value n v)))) ;

 -- (1)
 vdot-comb : (n : Nat) (lam a v : AL.Vec n) (c : R) ->
  Id R (VC.vdot n lam (\ j -> add (a j) (mul c (v j)))) (add (VC.vdot n lam a) (mul c (VC.vdot n lam v))) = split {
  zero -> \ lam a v c -> calc R { VC.vdot zero lam (\ j -> add (a j) (mul c (v j)))
   =< VC.vdot-zero-def lam (\ j -> add (a j) (mul c (v j))) > z
   =< sym (trans (ap (add z) (L.mul-zero c)) (addZ z)) > add z (mul c z)
   =< sym (AR.cong-add (VC.vdot-zero-def lam a) (ap (mul c) (VC.vdot-zero-def lam v)))
   > add (VC.vdot zero lam a) (mul c (VC.vdot zero lam v)) } ;
  suc n | r -> \ lam a v c ->
   calc R { VC.vdot (suc n) lam (\ j -> add (a j) (mul c (v j)))
    =< VC.vdot-step-def n lam (\ j -> add (a j) (mul c (v j)))
    > add (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n (\ j -> add (a j) (mul c (v j)))))
          (mul (VC.vector-last n lam) (VC.vector-last n (\ j -> add (a j) (mul c (v j)))))
    =< AR.cong-add (trans (ap (VC.vdot n (VC.vector-prefix n lam)) (prefix-comb n a v c))
                     (r (VC.vector-prefix n lam) (VC.vector-prefix n a) (VC.vector-prefix n v) c))
        (trans (ap (mul (VC.vector-last n lam)) (last-comb n a v c))
         (trans (dist (VC.vector-last n lam) (VC.vector-last n a) (mul c (VC.vector-last n v)))
          (ap (add (mul (VC.vector-last n lam) (VC.vector-last n a))) (L.mul-swap (VC.vector-last n lam) c (VC.vector-last n v)))))
    > add (add (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n a)) (mul c (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n v))))
          (add (mul (VC.vector-last n lam) (VC.vector-last n a)) (mul c (mul (VC.vector-last n lam) (VC.vector-last n v))))
    =< AR.swap (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n a)) (mul c (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n v)))
        (mul (VC.vector-last n lam) (VC.vector-last n a)) (mul c (mul (VC.vector-last n lam) (VC.vector-last n v)))
    > add (add (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n a)) (mul (VC.vector-last n lam) (VC.vector-last n a)))
          (add (mul c (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n v))) (mul c (mul (VC.vector-last n lam) (VC.vector-last n v))))
    =< ap (add (add (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n a)) (mul (VC.vector-last n lam) (VC.vector-last n a))))
        (sym (dist c (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n v)) (mul (VC.vector-last n lam) (VC.vector-last n v))))
    > add (add (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n a)) (mul (VC.vector-last n lam) (VC.vector-last n a)))
          (mul c (add (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n v)) (mul (VC.vector-last n lam) (VC.vector-last n v))))
    =< sym (AR.cong-add (VC.vdot-step-def n lam a) (ap (mul c) (VC.vdot-step-def n lam v)))
    > add (VC.vdot (suc n) lam a) (mul c (VC.vdot (suc n) lam v)) } } ;

 -- lambda = s e_i:  lambda . w = s w_i
 vec-ext (n : Nat) (a b : AL.Vec n) (h : (j : Ps.Fin n) -> Id R (a j) (b j)) : Id (AL.Vec n) a b =
  F.funext (Ps.Fin n) (\ j -> R) a b h ;
 zero-vec (n : Nat) : AL.Vec n = \ j -> z ;
 sdelta (n : Nat) (s : R) (i : Ps.Fin n) : AL.Vec n = \ j -> mul s (D.delta n i j) ;
 zero-vdot : (n : Nat) (w : AL.Vec n) -> Id R (VC.vdot n (zero-vec n) w) z = split {
  zero -> \ w -> VC.vdot-zero-def (zero-vec zero) w ;
  suc n | r -> \ w -> calc R { VC.vdot (suc n) (zero-vec (suc n)) w
   =< VC.vdot-step-def n (zero-vec (suc n)) w
   > add (VC.vdot n (VC.vector-prefix n (zero-vec (suc n))) (VC.vector-prefix n w))
         (mul (VC.vector-last n (zero-vec (suc n))) (VC.vector-last n w))
   =< AR.cong-add
       (trans (ap {AL.Vec n} (\ y -> VC.vdot n y (VC.vector-prefix n w))
         (vec-ext n (VC.vector-prefix n (zero-vec (suc n))) (zero-vec n) (VC.vector-prefix-value n (zero-vec (suc n)))))
        (r (VC.vector-prefix n w)))
       (trans (ap (\ y -> mul y (VC.vector-last n w)) (VC.vector-last-value n (zero-vec (suc n))))
        (L.zero-mul (VC.vector-last n w)))
   > add z z
   =< addZ z > z } } ;
 module SD (n : Nat) (s : R) {
  prefix-inl (a : Ps.Fin n) : Id (AL.Vec n) (VC.vector-prefix n (sdelta (suc n) s (inl a))) (sdelta n s a) =
   vec-ext n (VC.vector-prefix n (sdelta (suc n) s (inl a))) (sdelta n s a) (VC.vector-prefix-value n (sdelta (suc n) s (inl a))) ;
  last-inl (a : Ps.Fin n) : Id R (VC.vector-last n (sdelta (suc n) s (inl a))) z =
   trans (VC.vector-last-value n (sdelta (suc n) s (inl a))) (L.mul-zero s) ;
  prefix-inr (t : Top) : Id (AL.Vec n) (VC.vector-prefix n (sdelta (suc n) s (inr t))) (zero-vec n) =
   vec-ext n (VC.vector-prefix n (sdelta (suc n) s (inr t))) (zero-vec n)
    (\ j -> trans (VC.vector-prefix-value n (sdelta (suc n) s (inr t)) j) (L.mul-zero s)) ;
  last-inr (t : Top) : Id R (VC.vector-last n (sdelta (suc n) s (inr t))) s =
   trans (VC.vector-last-value n (sdelta (suc n) s (inr t))) (mulO s) ;
 } ;
 vdot-delta : (n : Nat) (s : R) (i : Ps.Fin n) (w : AL.Vec n) ->
  Id R (VC.vdot n (sdelta n s i) w) (mul s (w i)) = split {
  zero -> \ s i w -> efq i ;
  suc n | r -> \ s -> split {
   inl a -> \ w -> calc R { VC.vdot (suc n) (sdelta (suc n) s (inl a)) w
    =< VC.vdot-step-def n (sdelta (suc n) s (inl a)) w
    > add (VC.vdot n (VC.vector-prefix n (sdelta (suc n) s (inl a))) (VC.vector-prefix n w))
          (mul (VC.vector-last n (sdelta (suc n) s (inl a))) (VC.vector-last n w))
    =< AR.cong-add
        (trans (ap {AL.Vec n} (\ y -> VC.vdot n y (VC.vector-prefix n w)) (SD[n,s].prefix-inl a))
         (trans (r s a (VC.vector-prefix n w)) (ap (mul s) (VC.vector-prefix-value n w a))))
        (trans (ap (\ y -> mul y (VC.vector-last n w)) (SD[n,s].last-inl a)) (L.zero-mul (VC.vector-last n w)))
    > add (mul s (w (inl a))) z
    =< addZ (mul s (w (inl a))) > mul s (w (inl a)) } ;
   inr t -> \ w -> calc R { VC.vdot (suc n) (sdelta (suc n) s (inr t)) w
    =< VC.vdot-step-def n (sdelta (suc n) s (inr t)) w
    > add (VC.vdot n (VC.vector-prefix n (sdelta (suc n) s (inr t))) (VC.vector-prefix n w))
          (mul (VC.vector-last n (sdelta (suc n) s (inr t))) (VC.vector-last n w))
    =< AR.cong-add
        (trans (ap {AL.Vec n} (\ y -> VC.vdot n y (VC.vector-prefix n w)) (SD[n,s].prefix-inr t))
         (zero-vdot n (VC.vector-prefix n w)))
        (trans (ap (\ y -> mul y (VC.vector-last n w)) (SD[n,s].last-inr t))
         (ap (mul s) (trans (VC.vector-last-value n w) (ap (\ y -> w (inr y)) (MnSums[l].top-eq tt t)))))
    > add z (mul s (w (inr t)))
    =< L.zl (mul s (w (inr t))) > mul s (w (inr t)) } } } ;

 mul-cong {a a1 b b1 : R} (e1 : Id R a a1) (e2 : Id R b b1) : Id R (mul a b) (mul a1 b1) =
  trans (ap (\ t -> mul t b) e1) (ap (mul a1) e2) ;
 -- lambda . v as a sum (as ExteriorTranspose.vdot-sum, which is not linked yet)
 vdot-sum : (n : Nat) (lam w : AL.Vec n) -> Id R (VC.vdot n lam w) (S.sum n (\ i -> mul (lam i) (w i))) = split {
  zero -> \ lam w -> VC.vdot-zero-def lam w ;
  suc n | r -> \ lam w -> calc R { VC.vdot (suc n) lam w
   =< VC.vdot-step-def n lam w
   > add (VC.vdot n (VC.vector-prefix n lam) (VC.vector-prefix n w)) (mul (VC.vector-last n lam) (VC.vector-last n w))
   =< AR.cong-add
       (trans (r (VC.vector-prefix n lam) (VC.vector-prefix n w))
        (S.sum-cong n _ (\ i -> mul (lam (inl i)) (w (inl i)))
         (\ i -> mul-cong (VC.vector-prefix-value n lam i) (VC.vector-prefix-value n w i))))
       (mul-cong (VC.vector-last-value n lam) (VC.vector-last-value n w))
   > add (S.sum n (\ i -> mul (lam (inl i)) (w (inl i)))) (mul (lam (inr tt)) (w (inr tt)))
   =< addC (S.sum n (\ i -> mul (lam (inl i)) (w (inl i)))) (mul (lam (inr tt)) (w (inr tt)))
   > S.sum (suc n) (\ i -> mul (lam i) (w i)) } } ;
 -- lambda . (u y) = sum_k y_k (lambda . u_k)
 vdot-apply (p : Nat) (lam : AL.Vec q) (u : MM.Mat p q) (y : MM.Vec p) :
  Id R (VC.vdot q lam (MM.apply p q u y)) (S.sum p (\ k -> mul (y k) (VC.vdot q lam (u k)))) =
  calc R { VC.vdot q lam (MM.apply p q u y)
   =< vdot-sum q lam (MM.apply p q u y) > S.sum q (\ i -> mul (lam i) (MM.apply p q u y i))
   =< S.sum-cong q _ (\ i -> S.sum p (\ k -> mul (y k) (mul (lam i) (u k i))))
       (\ i -> trans (sym (S.sum-scale (lam i) p (\ k -> mul (y k) (u k i))))
        (S.sum-cong p _ _ (\ k -> L.mul-swap (lam i) (y k) (u k i))))
   > S.sum q (\ i -> S.sum p (\ k -> mul (y k) (mul (lam i) (u k i))))
   =< MM.interchange q p (\ i k -> mul (y k) (mul (lam i) (u k i)))
   > S.sum p (\ k -> S.sum q (\ i -> mul (y k) (mul (lam i) (u k i))))
   =< S.sum-cong p _ _ (\ k -> trans (S.sum-scale (y k) q (\ i -> mul (lam i) (u k i)))
        (ap (mul (y k)) (sym (vdot-sum q lam (u k)))))
   > S.sum p (\ k -> mul (y k) (VC.vdot q lam (u k))) } ;

 -- (2)
 anti (a b : (AL.Vec q)) : Id (Ext q) (emul q (gen q a) (gen q b)) (eneg q (emul q (gen q b) (gen q a))) =
  trans (sym (G.neg-neg (emul q (gen q a) (gen q b))))
   (ap (eneg q) (sym (calc (Ext q) { emul q (gen q b) (gen q a)
    =< ExteriorContr[l].Over[Lg,setL].gen-commute q b (gen q a) > emul q (alpha q (gen q a)) (gen q b)
    =< ap (\ t -> emul q t (gen q b)) (EA.alpha-gen q a) > emul q (eneg q (gen q a)) (gen q b)
    =< EA.mul-neg-l q (gen q a) (gen q b) > eneg q (emul q (gen q a) (gen q b)) }))) ;
 move (X : (Ext q)) (a v : (AL.Vec q)) :
  Id (Ext q) (emul q X (emul q (gen q a) (gen q v))) (eneg q (emul q (emul q X (gen q v)) (gen q a))) =
  calc (Ext q) { emul q X (emul q (gen q a) (gen q v))
   =< ap (emul q X) (anti a v) > emul q X (eneg q (emul q (gen q v) (gen q a)))
   =< EA.mul-neg-r q X (emul q (gen q v) (gen q a)) > eneg q (emul q X (emul q (gen q v) (gen q a)))
   =< ap (eneg q) (EA.mulA' q X (gen q v) (gen q a)) > eneg q (emul q (emul q X (gen q v)) (gen q a)) } ;

 -- (3)
 absorb (a : (AL.Vec q)) (c : R) (v : (AL.Vec q)) : Id (Ext q) (emul q (gen q (comb a c v)) (gen q v)) (emul q (gen q a) (gen q v)) =
  calc (Ext q) { emul q (gen q (comb a c v)) (gen q v)
   =< ap (\ t -> emul q t (gen q v)) (trans (EA.gen-add q a (\ j -> mul c (v j))) (ap (eadd q (gen q a)) (EA.gen-scale q c v)))
   > emul q (eadd q (gen q a) (escale q c (gen q v))) (gen q v)
   =< EA.dist-right q (gen q a) (escale q c (gen q v)) (gen q v)
   > eadd q (emul q (gen q a) (gen q v)) (emul q (escale q c (gen q v)) (gen q v))
   =< ap (eadd q (emul q (gen q a) (gen q v)))
       (trans (EA.scale-mul-left q c (gen q v) (gen q v)) (trans (ap (escale q c) (EA.gen-sq q v)) (EA.escale-zero q c)))
   > eadd q (emul q (gen q a) (gen q v)) (ezero q)
   =< EA.eaddZ q (emul q (gen q a) (gen q v)) > emul q (gen q a) (gen q v) } ;
 shear (v : (AL.Vec q)) : (m : Nat) (w : Ps.Fin m -> (AL.Vec q)) (t : Ps.Fin m -> R) ->
  Id (Ext q) (emul q (MM.wedge m q (\ k -> comb (w k) (t k) v)) (gen q v)) (emul q (MM.wedge m q w) (gen q v)) = split {
  zero -> \ w t -> refl (emul q (eone q) (gen q v)) ;
  suc m | r -> \ w t ->
   let { W' : (Ext q) = MM.wedge m q (\ k -> comb (w (inl k)) (t (inl k)) v) ;
         W : (Ext q) = MM.wedge m q (\ k -> w (inl k)) ;
         a : (AL.Vec q) = w (inr tt) ; } in
   calc (Ext q) { emul q (emul q W' (gen q (comb a (t (inr tt)) v))) (gen q v)
    =< sym (EA.mulA' q W' (gen q (comb a (t (inr tt)) v)) (gen q v)) > emul q W' (emul q (gen q (comb a (t (inr tt)) v)) (gen q v))
    =< ap (emul q W') (absorb a (t (inr tt)) v) > emul q W' (emul q (gen q a) (gen q v))
    =< move W' a v > eneg q (emul q (emul q W' (gen q v)) (gen q a))
    =< ap (\ y -> eneg q (emul q y (gen q a))) (r (\ k -> w (inl k)) (\ k -> t (inl k)))
    > eneg q (emul q (emul q W (gen q v)) (gen q a))
    =< sym (move W a v) > emul q W (emul q (gen q a) (gen q v))
    =< EA.mulA' q W (gen q a) (gen q v) > emul q (emul q W (gen q a)) (gen q v) } } ;

 -- (4)
 module Contraction (lam : (AL.Vec q)) {
  c (x : (Ext q)) : (Ext q) = VC.contract q lam x ;
  contract-emb : (n : Nat) (lm : AL.Vec n) (a : R) -> Id (Ext n) (VC.contract n lm (emb n a)) (ezero n) = split {
   zero -> \ lm a -> VC.contract-zero-def lm a ;
   suc n | r -> \ lm a -> trans (VC.contract-step-def n lm (emb n a,ezero n))
    (ExteriorAlgebra[l].pair-eq
     (calc (Ext n) { eadd n (VC.contract n (VC.vector-prefix n lm) (first n (emb n a,ezero n)))
                          (escale n (VC.vector-last n lm) (alpha n (second n (emb n a,ezero n))))
      =< EA.At[n].G.cong-add (trans (ap (VC.contract n (VC.vector-prefix n lm)) (first-pair n (emb n a) (ezero n)))
                               (r (VC.vector-prefix n lm) a))
          (trans (ap (\ y -> escale n (VC.vector-last n lm) (alpha n y)) (second-pair n (emb n a) (ezero n)))
           (trans (ap (escale n (VC.vector-last n lm)) (EA.alpha-zero n)) (EA.escale-zero n (VC.vector-last n lm))))
      > eadd n (ezero n) (ezero n)
      =< EA.eaddZ n (ezero n) > ezero n })
     (trans (ap (VC.contract n (VC.vector-prefix n lm)) (second-pair n (emb n a) (ezero n)))
      (VC.contract-zero n (VC.vector-prefix n lm)))) } ;
  kill-product (X : (Ext q)) (w : (AL.Vec q)) (cX : Id (Ext q) (c X) (ezero q)) :
   Id (Ext q) (c (emul q X (gen q w))) (escale q (VC.vdot q lam w) (alpha q X)) =
   calc (Ext q) { c (emul q X (gen q w))
    =< VC.contract-right q lam w X > eadd q (emul q (c X) (gen q w)) (escale q (VC.vdot q lam w) (alpha q X))
    =< ap (\ y -> eadd q (emul q y (gen q w)) (escale q (VC.vdot q lam w) (alpha q X))) cX
    > eadd q (emul q (ezero q) (gen q w)) (escale q (VC.vdot q lam w) (alpha q X))
    =< ap (\ y -> eadd q y (escale q (VC.vdot q lam w) (alpha q X))) (EA.mul-zero-l q (gen q w))
    > eadd q (ezero q) (escale q (VC.vdot q lam w) (alpha q X))
    =< G.zl (escale q (VC.vdot q lam w) (alpha q X)) > escale q (VC.vdot q lam w) (alpha q X) } ;
  kills : (m : Nat) (w : Ps.Fin m -> (AL.Vec q)) -> ((k : Ps.Fin m) -> Id R (VC.vdot q lam (w k)) z) ->
   Id (Ext q) (c (MM.wedge m q w)) (ezero q) = split {
   zero -> \ w h -> contract-emb q lam o ;
   suc m | r -> \ w h -> trans (kill-product (MM.wedge m q (\ k -> w (inl k))) (w (inr tt)) (r (\ k -> w (inl k)) (\ k -> h (inl k))))
    (trans (ap (\ s -> escale q s (alpha q (MM.wedge m q (\ k -> w (inl k))))) (h (inr tt)))
     (AL.In[EA.algebra q].scale-zero-l (alpha q (MM.wedge m q (\ k -> w (inl k)))))) } ;
  -- (5)
  cancel (X : (Ext q)) (v : (AL.Vec q)) (cX : Id (Ext q) (c X) (ezero q)) (one : Id R (VC.vdot q lam v) o) (x : R)
   (h : Id (Ext q) (escale q x (emul q X (gen q v))) (ezero q)) : Id (Ext q) (escale q x X) (ezero q) =
   calc (Ext q) { escale q x X
    =< ap (escale q x) (sym (EA.alpha-alpha q X)) > escale q x (alpha q (alpha q X))
    =< sym (EA.alpha-scale q x (alpha q X)) > alpha q (escale q x (alpha q X))
    =< ap (\ y -> alpha q (escale q x y))
        (sym (trans (kill-product X v cX) (trans (ap (\ s -> escale q s (alpha q X)) one) (EA.escale-one q (alpha q X)))))
    > alpha q (escale q x (c (emul q X (gen q v))))
    =< ap (alpha q) (sym (VC.contract-scale q lam x (emul q X (gen q v)))) > alpha q (c (escale q x (emul q X (gen q v))))
    =< ap (\ y -> alpha q (c y)) h > alpha q (c (ezero q))
    =< ap (alpha q) (VC.contract-zero q lam) > alpha q (ezero q)
    =< EA.alpha-zero q > ezero q } ;
 } ;

 -- the step: the columns u_1, ..., u_m, v of u, with lambda . v = 1
 module Reduce (lam : AL.Vec q) (m : Nat) (u : MM.Mat (suc m) q)
  (one : Id R (VC.vdot q lam (u (inr tt))) o) {
  v : AL.Vec q = u (inr tt) ;
  w (k : Ps.Fin m) : AL.Vec q = u (inl k) ;
  t (k : Ps.Fin m) : R = neg (VC.vdot q lam (w k)) ;
  sheared (k : Ps.Fin m) : AL.Vec q = comb (w k) (t k) v ;
  orthogonal (k : Ps.Fin m) : Id R (VC.vdot q lam (sheared k)) z =
   calc R { VC.vdot q lam (sheared k)
    =< vdot-comb q lam (w k) v (t k) > add (VC.vdot q lam (w k)) (mul (t k) (VC.vdot q lam v))
    =< ap (add (VC.vdot q lam (w k))) (trans (ap (mul (t k)) one) (mulO (t k)))
    > add (VC.vdot q lam (w k)) (t k)
    =< addN (VC.vdot q lam (w k)) > z } ;
  kill (x : R) (h : Id (Ext q) (escale q x (MM.wedge (suc m) q u)) (ezero q)) :
   Id (Ext q) (escale q x (MM.wedge m q sheared)) (ezero q) =
   Contraction[lam].cancel (MM.wedge m q sheared) v (Contraction[lam].kills m sheared orthogonal) one x
    (trans (ap (escale q x) (shear v m w t)) h) ;
  -- the sheared columns are independent: sum_k y_k (w_k + t_k v) = u (y, sum_k y_k t_k)
  T (y : MM.Vec m) : R = S.sum m (\ k -> mul (y k) (t k)) ;
  lift (y : MM.Vec m) : MM.Vec (suc m) = split { inl k -> y k ; inr s -> T y } ;
  lift-apply (y : MM.Vec m) (j : Ps.Fin q) : Id R (MM.apply (suc m) q u (lift y) j) (MM.apply m q sheared y j) =
   sym (calc R { S.sum m (\ k -> mul (y k) (add (w k j) (mul (t k) (v j))))
    =< S.sum-cong m (\ k -> mul (y k) (add (w k j) (mul (t k) (v j))))
        (\ k -> add (mul (y k) (w k j)) (mul (v j) (mul (y k) (t k))))
        (\ k -> trans (dist (y k) (w k j) (mul (t k) (v j)))
          (ap (add (mul (y k) (w k j))) (trans (mulA (y k) (t k) (v j)) (mulC (mul (y k) (t k)) (v j)))))
    > S.sum m (\ k -> add (mul (y k) (w k j)) (mul (v j) (mul (y k) (t k))))
    =< S.sum-add m (\ k -> mul (y k) (w k j)) (\ k -> mul (v j) (mul (y k) (t k)))
    > add (S.sum m (\ k -> mul (y k) (w k j))) (S.sum m (\ k -> mul (v j) (mul (y k) (t k))))
    =< ap (add (S.sum m (\ k -> mul (y k) (w k j)))) (trans (S.sum-scale (v j) m (\ k -> mul (y k) (t k))) (mulC (v j) (T y)))
    > add (S.sum m (\ k -> mul (y k) (w k j))) (mul (T y) (v j))
    =< addC (S.sum m (\ k -> mul (y k) (w k j))) (mul (T y) (v j))
    > add (mul (T y) (v j)) (S.sum m (\ k -> mul (y k) (w k j))) }) ;
  injective (inj : MM.Injective (suc m) q u) : MM.Injective m q sheared =
   \ y hy k -> inj (lift y) (\ j -> trans (lift-apply y j) (hy j)) (inl k) ;
 } ;
} ;
