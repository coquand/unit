-- The step of Lemma 4.3 where an entry of A is a unit (in R[1/a_ij]).
-- R^p -A-> R^q -B-> R^l with B A = 0 and ker B = im A; a = A_k0 has the
-- unit coordinate a_i0; lambda = a_i0^{-1} e_i0, so lambda . a = 1.
-- pi v = v - (lambda . v) a, A' = pi A (column k0 of A' is 0), and
-- B' = (B ; lambda) : R^q -> R^(l+1) (ExtraRow).
-- (o) lambda . pi v = 0, so im A' lies in ker lambda (orth);
--     A' y = A y - (lambda . A y) a and A y = A' y + (lambda . A y) a.
-- (i) B' A' = 0: B pi = B since B a = 0, and lambda A' = 0.
-- (ii) ker B' = im A': B y = 0 and lambda . y = 0 give y = A x, and then
--     A' x = A x - (lambda . y) a = y.
-- (iii) D_(n+2)(A) = 0 gives D_(n+1)(A') = 0: for P a product of n+1
--     vectors of im A', P i(a) is a product of n+2 vectors of im A, so 0,
--     and c_lambda(P) = 0, so P = 0 (WedgeStep, cancel).
-- (iv) D_(n+1)(A) regular gives D_n(A') regular: if x kills the products of
--     n vectors of im A', it kills the products of n+1 vectors of
--     im A' + L a, which contains im A (Splitting).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Lg : CRing) (setL : Pr.isSet Lg.R) (p q l1 : Nat)
 (A : Matrices[l].Over[Lg].Mat p q) (B : Matrices[l].Over[Lg].Mat q l1)
 (k0 : Fin p) (i0 : Fin q) (unit : RL[Lg].unit (A k0 i0)) {
 open Lg ; module L = RL[Lg] ;
 open ExteriorModel[l].Over[Lg] ;
 module MM = Matrices[l].Over[Lg] ;
 module MK = MinorKill[l].Over[Lg,setL] ;
 module MF = MinorForms[l].Over[Lg,setL] ;
 module MI = Minors[l].Over[Lg,setL] ;
 module WS = WedgeStep[l].Over[Lg,setL,q] ;
 module S = FiniteIdeal[l].Sums[Lg] ;
 module D = MnSums[l].Over[Lg] ;
 a : MM.Vec q = A k0 ;
 lam : MM.Vec q = WS.sdelta q unit.1 i0 ;
 lv (v : MM.Vec q) : R = WS.VC.vdot q lam v ;
 one : Id R (lv a) o = trans (WS.vdot-delta q unit.1 i0 a) (trans (mulC unit.1 (A k0 i0)) unit.2) ;
 pi (v : MM.Vec q) : MM.Vec q = WS.comb v (neg (lv v)) a ;
 A' : MM.Mat p q = \ k -> pi (A k) ;
 module XR = ExtraRow[l].Over[Lg,setL,q,l1,B,lam] ;
 B' : MM.Mat q (suc l1) = XR.B' ;

 -- (o)
 lam-pi (v : MM.Vec q) : Id R (lv (pi v)) z =
  calc R { lv (pi v)
   =< WS.vdot-comb q lam v a (neg (lv v)) > add (lv v) (mul (neg (lv v)) (lv a))
   =< ap (\ s -> add (lv v) (mul (neg (lv v)) s)) one > add (lv v) (mul (neg (lv v)) o)
   =< ap (add (lv v)) (mulO (neg (lv v))) > add (lv v) (neg (lv v))
   =< addN (lv v) > z } ;
 orth (y : MM.Vec p) : Id R (lv (MM.apply p q A' y)) z =
  trans (WS.vdot-apply p lam A' y)
   (trans (S.sum-cong p (\ k -> mul (y k) (lv (A' k))) (\ k -> z) (\ k -> trans (ap (mul (y k)) (lam-pi (A k))) (L.mul-zero (y k))))
    (S.sum-zero p)) ;
 -- A' y = A y - (lambda . A y) a
 coeff-sum (y : MM.Vec p) : Id R (S.sum p (\ k -> mul (y k) (neg (lv (A k))))) (neg (lv (MM.apply p q A y))) =
  trans (S.lin-neg p y (\ k -> lv (A k))) (ap neg (sym (WS.vdot-apply p lam A y))) ;
 apply-A'-at (y : MM.Vec p) (j : Fin q) :
  Id R (MM.apply p q A' y j) (add (MM.apply p q A y j) (mul (neg (lv (MM.apply p q A y))) (a j))) =
  calc R { S.sum p (\ k -> mul (y k) (add (A k j) (mul (neg (lv (A k))) (a j))))
   =< S.sum-cong p _ (\ k -> add (mul (y k) (A k j)) (mul (a j) (mul (y k) (neg (lv (A k))))))
       (\ k -> trans (dist (y k) (A k j) (mul (neg (lv (A k))) (a j)))
        (ap (add (mul (y k) (A k j))) (trans (mulA (y k) (neg (lv (A k))) (a j)) (mulC (mul (y k) (neg (lv (A k)))) (a j)))))
   > S.sum p (\ k -> add (mul (y k) (A k j)) (mul (a j) (mul (y k) (neg (lv (A k))))))
   =< S.sum-add p (\ k -> mul (y k) (A k j)) (\ k -> mul (a j) (mul (y k) (neg (lv (A k)))))
   > add (MM.apply p q A y j) (S.sum p (\ k -> mul (a j) (mul (y k) (neg (lv (A k))))))
   =< ap (add (MM.apply p q A y j))
       (trans (S.sum-scale (a j) p (\ k -> mul (y k) (neg (lv (A k)))))
        (trans (mulC (a j) (S.sum p (\ k -> mul (y k) (neg (lv (A k)))))) (ap (\ s -> mul s (a j)) (coeff-sum y))))
   > add (MM.apply p q A y j) (mul (neg (lv (MM.apply p q A y))) (a j)) } ;
 apply-A' (y : MM.Vec p) : Id (MM.Vec q) (MM.apply p q A' y) (pi (MM.apply p q A y)) =
  WS.vec-ext q (MM.apply p q A' y) (pi (MM.apply p q A y)) (apply-A'-at y) ;
 -- A y = A' y + (lambda . A y) a
 back-at (y : MM.Vec p) (j : Fin q) :
  Id R (WS.comb (MM.apply p q A' y) (lv (MM.apply p q A y)) a j) (MM.apply p q A y j) =
  calc R { add (MM.apply p q A' y j) (mul (lv (MM.apply p q A y)) (a j))
   =< ap (\ s -> add s (mul (lv (MM.apply p q A y)) (a j))) (apply-A'-at y j)
   > add (add (MM.apply p q A y j) (mul (neg (lv (MM.apply p q A y))) (a j))) (mul (lv (MM.apply p q A y)) (a j))
   =< sym (addA (MM.apply p q A y j) (mul (neg (lv (MM.apply p q A y))) (a j)) (mul (lv (MM.apply p q A y)) (a j)))
   > add (MM.apply p q A y j) (add (mul (neg (lv (MM.apply p q A y))) (a j)) (mul (lv (MM.apply p q A y)) (a j)))
   =< ap (add (MM.apply p q A y j))
       (trans (sym (L.dist-left (neg (lv (MM.apply p q A y))) (lv (MM.apply p q A y)) (a j)))
        (trans (ap (\ s -> mul s (a j)) (trans (addC (neg (lv (MM.apply p q A y))) (lv (MM.apply p q A y))) (addN (lv (MM.apply p q A y)))))
         (L.zero-mul (a j))))
   > add (MM.apply p q A y j) z
   =< addZ (MM.apply p q A y j) > MM.apply p q A y j } ;

 -- the last row of B' is lambda
 last-row (v : MM.Vec q) : Id R (MM.apply q (suc l1) B' v (inr tt)) (lv v) =
  trans (S.sum-cong q (\ i -> mul (v i) (lam i)) (\ i -> mul (lam i) (v i)) (\ i -> mulC (v i) (lam i)))
   (sym (WS.vdot-sum q lam v)) ;

 -- (i)
 module Compose (bz : MM.ComposeZero p q l1 A B) {
  at (k : Fin p) : (j : Fin (suc l1)) -> Id R (MM.apply q (suc l1) B' (A' k) j) z = split {
   inl j -> trans (MM.apply-comb q l1 B (A k) a (neg (lv (A k))) j)
    (trans (WS.AR.cong-add (bz k j) (trans (ap (mul (neg (lv (A k)))) (bz k0 j)) (L.mul-zero (neg (lv (A k))))))
     (addZ z)) ;
   inr t -> trans (ap (\ s -> MM.apply q (suc l1) B' (A' k) (inr s)) (MnSums[l].top-eq t tt))
    (trans (last-row (A' k)) (lam-pi (A k))) } ;
  result : MM.ComposeZero p q (suc l1) A' B' = at ;
 } ;
 -- (ii)
 module Ex (ex : MM.Exact p q l1 A B) (y : MM.Vec q) (hy : (j : Fin (suc l1)) -> Id R (MM.apply q (suc l1) B' y j) z) {
  ly : Id R (lv y) z = trans (sym (last-row y)) (hy (inr tt)) ;
  Goal : U l = (x : MM.Vec p) * ((i : Fin q) -> Id R (MM.apply p q A' x i) (y i)) ;
  from (w : (x : MM.Vec p) * ((i : Fin q) -> Id R (MM.apply p q A x i) (y i))) : Goal =
   (w.1,\ i -> trans (apply-A'-at w.1 i)
     (trans (ap (\ v -> add (MM.apply p q A w.1 i) (mul (neg (lv v)) (a i))) (WS.vec-ext q (MM.apply p q A w.1) y w.2))
      (trans (ap (\ s -> add (MM.apply p q A w.1 i) (mul (neg s) (a i))) ly)
       (trans (ap (\ s -> add (MM.apply p q A w.1 i) (mul s (a i))) L.neg-zero)
        (trans (ap (add (MM.apply p q A w.1 i)) (L.zero-mul (a i))) (trans (addZ (MM.apply p q A w.1 i)) (w.2 i))))))) ;
  result : Truncation[l].Trunc[Goal].carrier =
   TC.map ((x : MM.Vec p) * ((i : Fin q) -> Id R (MM.apply p q A x i) (y i))) Goal from (ex y (\ j -> hy (inl j))) ;
 } ;
 -- (iii)
 delta-k0 : MM.Vec p = D.delta p k0 ;
 apply-delta : Id (MM.Vec q) (MM.apply p q A delta-k0) a = MI.Map[p,q,A].apply-delta k0 ;
 lifted (v : MM.Vec p) : MM.Vec p = \ k -> add (v k) (mul (neg (lv (MM.apply p q A v))) (delta-k0 k)) ;
 lifted-apply (v : MM.Vec p) : Id (MM.Vec q) (MM.apply p q A (lifted v)) (MM.apply p q A' v) =
  WS.vec-ext q (MM.apply p q A (lifted v)) (MM.apply p q A' v) (\ j ->
   trans (MM.apply-comb p q A v delta-k0 (neg (lv (MM.apply p q A v))) j)
    (trans (ap (\ w -> add (MM.apply p q A v j) (mul (neg (lv (MM.apply p q A v))) (w j))) apply-delta)
     (sym (apply-A'-at v j)))) ;
 module Vanish (n : Nat) (van : MF.ImageVanish (suc (suc n)) p q A) (C : MM.Mat (suc n) p) {
  W : Ext q = MM.wedge (suc n) q (MK.compose (suc n) p q A' C) ;
  C2 : MM.Mat (suc (suc n)) p = CommonPower[l].extend (MM.Vec p) (suc n) (\ t -> lifted (C t)) delta-k0 ;
  times-a : Id (Ext q) (MM.wedge (suc (suc n)) q (MK.compose (suc (suc n)) p q A C2)) (emul q W (gen q a)) =
   trans (ap (\ v -> emul q (MM.wedge (suc n) q v) (gen q (MM.apply p q A delta-k0)))
          (F.funext (Fin (suc n)) (\ t -> MM.Vec q) (\ t -> MM.apply p q A (lifted (C t))) (MK.compose (suc n) p q A' C)
           (\ t -> lifted-apply (C t))))
    (ap (\ v -> emul q W (gen q v)) apply-delta) ;
  killed : Id (Ext q) (escale q o (emul q W (gen q a))) (ezero q) =
   trans (ap (escale q o) (sym times-a)) (van C2) ;
  result : MK.KillsW q o W =
   WS.Contraction[lam].cancel W a (WS.Contraction[lam].kills (suc n) (MK.compose (suc n) p q A' C) (\ t -> orth (C t))) one o killed ;
 } ;
 vanish (n : Nat) (van : MF.ImageVanish (suc (suc n)) p q A) : MF.ImageVanish (suc n) p q A' =
  \ C -> Vanish[n,van,C].result ;
 -- (iv)
 regular (n : Nat) (reg : MF.ImageRegular (suc n) p q A) : MF.ImageRegular n p q A' = \ x h ->
  reg x (\ C -> subst (\ v -> MK.KillsW q x (MM.wedge (suc n) q v))
   (F.funext (Fin (suc n)) (\ t -> MM.Vec q)
     (Splitting[l].Over[Lg,setL,p,q,lam,a,one,A',orth,IdealExt[l].annihilator Lg x].vecs (suc n) C (\ t -> lv (MM.apply p q A (C t))))
     (MK.compose (suc n) p q A C)
     (\ t -> WS.vec-ext q _ (MM.apply p q A (C t)) (back-at (C t))))
   (MK.from-coeff q x (MM.wedge (suc n) q (Splitting[l].Over[Lg,setL,p,q,lam,a,one,A',orth,IdealExt[l].annihilator Lg x].vecs (suc n) C (\ t -> lv (MM.apply p q A (C t)))))
    (Splitting[l].Over[Lg,setL,p,q,lam,a,one,A',orth,IdealExt[l].annihilator Lg x].splitting n
     (\ C1 -> MK.to-coeff q x (MM.wedge n q (MK.compose n p q A' C1)) (h C1)) C (\ t -> lv (MM.apply p q A (C t)))))) ;
} ;
