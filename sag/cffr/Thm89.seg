-- cffr Theorem 8.9 and Corollary 8.10.
-- Theorem 8.9.  Let 0 -> R^p -u-> R^(s 0) -T 0-> ... -T m-> R^(s (m+1))
-- be a finite free resolution (Thm68.Res, k = m + 1 maps after u) with
-- s (m+1) = 1, i.e. a resolution of R/(a), the a_i being the entries of
-- the last map T m (its 1 x 1 minors, Cor88.OneRow).  Then either all a_i
-- are 0, or the a_i have a greatest common divisor which is regular.
-- (The paper says "a gcd which is regular"; for a = 0 that holds only in
-- the trivial ring, so the case a = 0 is stated separately.)
-- Proof.  Theorem 6.8: either 1 = 0 (then everything is 0), or ranks r
-- with T i stable of rank r i, Gr(D_(r i)(T i)) >= k - i and
-- Gr(D_p(u)) >= k + 1 (true grades).  The last rank r m is 0, 1 or >= 2
-- (in place of the paper's use of Vasconcelos' theorem):
-- * r m = 0: T m is stable of rank 0, so D_1(T m) = 0: all a_i = 0;
-- * r m >= 2 > s (m+1) = 1: D_(r m)(T m) = 0 and is regular, so 1 = 0;
-- * r m = 1 = s (m+1): the complex 0 -> R^p -u-> ... -T m-> R^1 is of the
--   form (*) (Cor85.Chain with ranks p, r 0, r 1, ...): Gr >= 2 for u and
--   T 0, ..., T (m-1), and D_1(T m) regular (GradeBridge), so Theorem 8.7
--   gives the Cayley determinant as a regular gcd of D_1(T m).
-- Corollary 8.10.  If every ideal (a, b) has a finite free resolution (FFR:
-- one as above whose last map has exactly a, b as nonzero entries), then
-- any a, b have a gcd, which is regular unless a = b = 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ;
module TG = TrueGrade[l] ; module GT = GradeTools[l] ;
module RS = Resolution[l] ; module T68 = Thm68[l] ;
module Over (D : TG.RD) {
 module L = RL[D.1] ;
 module MM = Matrices[l].Over[D.1] ;
 module MI = Minors[l].Over[D.1,D.2] ;
 module RI = MI.RI ;
 module MF = MinorForms[l].Over[D.1,D.2] ;
 module L84 = Lemma84[l].Over[D.1,D.2] ;
 module C85 = Cor85[l].Over[D.1,D.2] ;
 module L86 = Lemma86[l].Over[D.1,D.2] ;
 module T87 = Thm87[l].Over[D.1,D.2] ;
 module GB = GradeBridge[l].Over[D] ;
 -- t < T gives T = t + 1 + d
 lt-split : (t T : Nat) -> C85.lt t T -> (d : Nat) * Id Nat T (plus (suc t) d) = split {
  zero -> split { zero -> \ h -> efq h ; suc T -> \ h -> (T,refl (suc T)) } ;
  suc t | r -> split { zero -> \ h -> efq h ; suc T -> \ h -> ((r T h).1,ap (\ k -> suc k) (r T h).2) } } ;
 all-zero (e : Id D.1.R D.1.o D.1.z) (x : D.1.R) : Id D.1.R x D.1.z =
  trans (sym (L.one-left x)) (trans (ap (\ c -> D.1.mul c x) e) (L.zero-mul x)) ;

 module Thm89 (m p : Nat) (s : Nat -> Nat) (u : RS.Mat D p (s zero)) (T : (i : Nat) -> RS.Mat D (s i) (s (suc i)))
  (res : T68.Res D (suc m) p s u T) (es : Id Nat (s (suc m)) (suc zero)) {
  Conclusion : U l =
   Plus (MI.Vanish (suc zero) (s m) (s (suc m)) (T m))
    ((g : D.1.R) * (L86.Gcd (MI.Index (suc zero) (s m) (s (suc m))) (MI.minors (suc zero) (s m) (s (suc m)) (T m)) g * L86.RegularElement g)) ;
  th : Plus (Id D.1.R D.1.o D.1.z) ((r : Nat -> Nat) * RS.Ranks (suc m) p s r * RS.Stables D (suc m) s r T * T68.Grades D (suc m) s r T) *
   TG.TGr (suc (suc m)) D zero (GT.J0 D) (T68.NL p p (s zero)) (T68.minors D p p (s zero) u) = T68.theorem68 (suc m) D p s u T res ;
  trivial (e : Id D.1.R D.1.o D.1.z) : MI.Vanish (suc zero) (s m) (s (suc m)) (T m) = \ ci -> all-zero e (MI.minors (suc zero) (s m) (s (suc m)) (T m) ci) ;
  module Main (r : Nat -> Nat) (ranks : RS.Ranks (suc m) p s r) (st : RS.Stables D (suc m) s r T) (gr : T68.Grades D (suc m) s r T) {
   last-stable : RS.Stable D (r m) (s m) (s (suc m)) (T m) = st m zero (sym (plus-zero (suc m))) ;
   last-grade : T68.GradeAt D s r T m (suc zero) = gr m zero (sym (plus-zero (suc m))) ;
   -- the complex in the form (*): ranks p, r 0, r 1, ...
   s' : Nat -> Nat = split { zero -> p ; suc t -> r t } ;
   module CH = C85.Chain[s'] ;
   d1 : Nat -> Nat = split { zero -> p ; suc t -> s t } ;
   d : Nat -> Nat = split { zero -> zero ; suc t -> d1 t } ;
   M1 : (t : Nat) -> MM.Mat (d1 t) (d1 (suc t)) = split { zero -> u ; suc t -> T t } ;
   M : (t : Nat) -> MM.Mat (d t) (d (suc t)) = split { zero -> \ k -> efq k ; suc t -> M1 t } ;
   hd1 : (t : Nat) -> C85.lt (suc t) (suc (suc m)) -> Id Nat (plus (CH.rk (suc (suc t))) (CH.rk (suc t))) (d (suc (suc t))) = split {
    zero -> \ h -> sym (ranks.1 m (refl (suc m))) ;
    suc i -> \ h -> sym (ranks.2 i (lt-split (suc i) (suc m) h).1 (lt-split (suc i) (suc m) h).2) } ;
   hd : (t : Nat) -> C85.lt t (suc (suc m)) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)) = split {
    zero -> \ h -> plus-zero p ; suc t -> hd1 t } ;
   cz1 : (t : Nat) -> C85.lt (suc t) (suc (suc m)) ->
    MM.ComposeZero (d (suc t)) (d (suc (suc t))) (d (suc (suc (suc t)))) (M (suc t)) (M (suc (suc t))) = split {
    zero -> \ h -> (res.2.1 m (refl (suc m))).1 ;
    suc i -> \ h -> (res.2.2 i (lt-split (suc i) (suc m) h).1 (lt-split (suc i) (suc m) h).2).1 } ;
   cz : (t : Nat) -> C85.lt t (suc (suc m)) -> MM.ComposeZero (d t) (d (suc t)) (d (suc (suc t))) (M t) (M (suc t)) = split {
    zero -> \ h k -> efq k ; suc t -> cz1 t } ;
   -- Gr >= 2 at u and at T 0, ..., T (m-1)
   index-eq (i e : Nat) (w : Id Nat (suc m) (plus (suc (suc i)) e)) : Id Nat (suc m) (plus (suc i) (suc e)) =
    trans w (sym (ap (\ k -> suc k) (plus-suc i e))) ;
   gm : (t : Nat) -> C85.lt (suc t) (suc (suc m)) ->
    L84.GrTwo (MI.Index (CH.rk (suc t)) (d (suc t)) (d (suc (suc t)))) (MI.minors (CH.rk (suc t)) (d (suc t)) (d (suc (suc t))) (M (suc t))) = split {
    zero -> \ h -> GB.Minor[p,p,s zero,u].two (GB.down m (T68.NL p p (s zero)) (T68.minors D p p (s zero) u) th.2) ;
    suc i -> \ h -> GB.Minor[r i,s i,s (suc i),T i].two
     (GB.down (lt-split (suc i) (suc m) h).1 (T68.NL (r i) (s i) (s (suc i))) (T68.minors D (r i) (s i) (s (suc i)) (T i))
      (gr i (suc (lt-split (suc i) (suc m) h).1) (index-eq i (lt-split (suc i) (suc m) h).1 (lt-split (suc i) (suc m) h).2))) } ;
   -- D_(r m)(T m) regular
   rg : MI.RegularD (r m) (s m) (s (suc m)) (T m) = GB.Minor[r m,s m,s (suc m),T m].regular last-grade ;
   -- r m = 1
   module Case (e : Id Nat (r m) (s (suc m))) {
    module TH = T87.Thm87[s'].Res[suc m,d,M,hd,cz,gm,rg,e] ;
    gcd-one : L86.Gcd (MI.Index (suc zero) (s m) (s (suc m))) (MI.minors (suc zero) (s m) (s (suc m)) (T m)) TH.det =
     subst (\ k -> L86.Gcd (MI.Index k (s m) (s (suc m))) (MI.minors k (s m) (s (suc m)) (T m)) TH.det) (trans e es) TH.theorem87 ;
    result : Conclusion = inr (TH.det,(gcd-one,TH.det-regular)) ;
   } ;
   -- r m = 0: T m stable of rank 0, D_1(T m) = 0
   zero-case (e : Id Nat (r m) zero) : MI.Vanish (suc zero) (s m) (s (suc m)) (T m) =
    MF.image-to-vanish (suc zero) (s m) (s (suc m)) (T m)
     (subst (\ k -> MF.ImageVanish (suc k) (s m) (s (suc m)) (T m)) e last-stable.1) ;
   -- r m >= 2 > 1: 1 = 0
   big-case (k : Nat) (e : Id Nat (r m) (suc (suc k))) : Id D.1.R D.1.o D.1.z =
    RS.too-big D (r m) (s m) (s (suc m)) k (trans e (ap (\ x -> plus x (suc k)) (sym es))) (T m) last-stable.2 ;
   cases1 : (k : Nat) -> Id Nat (r m) (suc k) -> Conclusion = split {
    zero -> \ e -> Case[trans e (sym es)].result ;
    suc k -> \ e -> inl (trivial (big-case k e)) } ;
   cases : (k : Nat) -> Id Nat (r m) k -> Conclusion = split {
    zero -> \ e -> inl (zero-case e) ;
    suc k -> \ e -> cases1 k e } ;
   result : Conclusion = cases (r m) (refl (r m)) ;
  } ;
  conclude : Plus (Id D.1.R D.1.o D.1.z) ((r : Nat -> Nat) * RS.Ranks (suc m) p s r * RS.Stables D (suc m) s r T * T68.Grades D (suc m) s r T) ->
   Conclusion = split {
   inl e -> inl (trivial e) ;
   inr w -> Main[w.1,w.2.1,w.2.2.1,w.2.2.2].result } ;
  -- Theorem 8.9
  theorem89 : Conclusion = conclude th.1 ;
 } ;

 -- Corollary 8.10
 pair (a b : D.1.R) : Ps.Fin (suc (suc zero)) -> D.1.R = split { inl k -> a ; inr t -> b } ;
 -- a finite free resolution of R/(a, b): the nonzero entries of its last map are a and b
 FFR (a b : D.1.R) : U l =
  (m : Nat) * ((p : Nat) * ((s : Nat -> Nat) * ((u : RS.Mat D p (s zero)) * ((T : (i : Nat) -> RS.Mat D (s i) (s (suc i))) *
  (T68.Res D (suc m) p s u T * ((es : Id Nat (s (suc m)) (suc zero)) *
  (((y : MI.Index (suc zero) (s m) (s (suc m))) -> Plus ((x : Ps.Fin (suc (suc zero))) * Id D.1.R (MI.minors (suc zero) (s m) (s (suc m)) (T m) y) (pair a b x))
     (Id D.1.R (MI.minors (suc zero) (s m) (s (suc m)) (T m) y) D.1.z)) *
   ((x : Ps.Fin (suc (suc zero))) -> (y : MI.Index (suc zero) (s m) (s (suc m))) * Id D.1.R (MI.minors (suc zero) (s m) (s (suc m)) (T m) y) (pair a b x))))))))) ;
 GcdOf (a b : D.1.R) : U l =
  (g : D.1.R) * (L86.Gcd (Ps.Fin (suc (suc zero))) (pair a b) g * Plus (L86.RegularElement g) (Id D.1.R a D.1.z * Id D.1.R b D.1.z)) ;
 -- gcd(0, 0) = 0
 zero-gcd (a b : D.1.R) (ha : Id D.1.R a D.1.z) (hb : Id D.1.R b D.1.z) : GcdOf a b =
  (D.1.z,((\ x -> D.1.z,pair-zero),\ s dv -> Tr.Trunc[(t : D.1.R) * Id D.1.R D.1.z (D.1.mul s t)].inc (D.1.z,sym (L.mul-zero s))),inr (ha,hb))
  where { pair-zero : (x : Ps.Fin (suc (suc zero))) -> Id D.1.R (pair a b x) (D.1.mul D.1.z D.1.z) = split {
    inl k -> trans ha (sym (L.zero-mul D.1.z)) ; inr t -> trans hb (sym (L.zero-mul D.1.z)) } ; } ;
 module FromFFR (a b : D.1.R) (f : FFR a b) {
  m : Nat = f.1 ;
  p : Nat = f.2.1 ;
  s : Nat -> Nat = f.2.2.1 ;
  u : RS.Mat D p (s zero) = f.2.2.2.1 ;
  T : (i : Nat) -> RS.Mat D (s i) (s (suc i)) = f.2.2.2.2.1 ;
  res : T68.Res D (suc m) p s u T = f.2.2.2.2.2.1 ;
  es : Id Nat (s (suc m)) (suc zero) = f.2.2.2.2.2.2.1 ;
  ab : (y : MI.Index (suc zero) (s m) (s (suc m))) -> Plus ((x : Ps.Fin (suc (suc zero))) * Id D.1.R (MI.minors (suc zero) (s m) (s (suc m)) (T m) y) (pair a b x))
     (Id D.1.R (MI.minors (suc zero) (s m) (s (suc m)) (T m) y) D.1.z) = f.2.2.2.2.2.2.2.1 ;
  ba : (x : Ps.Fin (suc (suc zero))) -> (y : MI.Index (suc zero) (s m) (s (suc m))) * Id D.1.R (MI.minors (suc zero) (s m) (s (suc m)) (T m) y) (pair a b x) =
   f.2.2.2.2.2.2.2.2 ;
  module TH = Thm89[m,p,s,u,T,res,es] ;
  vanish-a (v : MI.Vanish (suc zero) (s m) (s (suc m)) (T m)) (x : Ps.Fin (suc (suc zero))) : Id D.1.R (pair a b x) D.1.z =
   trans (sym (ba x).2) (v (ba x).1) ;
  from : TH.Conclusion -> GcdOf a b = split {
   inl v -> zero-gcd a b (vanish-a v (inl (inr tt))) (vanish-a v (inr tt)) ;
   inr w -> (w.1,(L86.Transfer[Ps.Fin (suc (suc zero)),MI.Index (suc zero) (s m) (s (suc m)),pair a b,
     MI.minors (suc zero) (s m) (s (suc m)) (T m),ab,ba,w.1,w.2.1].result,inl w.2.2)) } ;
  result : GcdOf a b = from TH.theorem89 ;
 } ;
 module Cor810 (h : (a b : D.1.R) -> Tr.Trunc[FFR a b].carrier) (a b : D.1.R) {
  module TG2 = Tr.Trunc[GcdOf a b] ;
  -- Corollary 8.10: every a, b merely have a gcd
  cor810 : TG2.carrier =
   Tr.Trunc[FFR a b].induction @l (\ w -> TG2.carrier) (\ w -> TG2.proposition) (\ f -> TG2.inc (FromFFR[a,b,f].result)) (h a b) ;
 } ;
} ;
