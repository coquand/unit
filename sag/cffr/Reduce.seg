-- One step of the reduction in the proof of Theorem 6.8 (in R[1/x], x an
-- entry of the top map that is a unit; cf. the normal form diag(1, A') of
-- the paper).  Given R^p -A-> R^q -B-> R^l1 -C2-> R^l2 -Dm-> R^l3 with
-- A injective, B A = 0, C2 B = 0, Dm C2 = 0, exact at R^q, R^l1, R^l2, and
-- A_k0 i0 a unit (p = p0 + 1):
--   A'' = (pi A) without its column k0 (UnitStep: pi A_k0 = 0),
--   B'  = (B ; lambda)            (ExtraRow),
--   Z   = (C2 | 0)                (a zero column for the new coordinate),
-- and Dm unchanged form again such a complex: A'' injective, all
-- composites 0, exact at R^q, R^(l1+1), R^l2.
-- * A'' x = 0: with X = x put back with 0 at k0 (unskip), pi (A X) = 0, so
--   A X = c a, A (X - c e_k0) = 0, X = c e_k0, x = 0.
-- * exact at R^q: B' y = 0 gives y = A' x (UnitStep) = A'' (x without k0).
-- * exact at R^(l1+1): Z (y, t) = C2 y = 0 gives y = B z, and
--   (y, t) = B' (z + (t - lambda z) a), since B a = 0 and lambda a = 1.
-- * exact at R^l2: y = C2 z = Z (z, 0).
-- Minors: every (r+1)-minor of B' lies in the ideal of the r-minors of B
-- (ExtraRow.UpIn with Splitting), every r-minor of Z in that of C2 (the
-- columns of Z are in the image of C2: MinorKill.Image).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
-- Fin (p0+1) without k0
skip : (p0 : Nat) -> Fin (suc p0) -> Fin p0 -> Fin (suc p0) = split {
 zero -> split { inl k -> \ i -> efq k ; inr t -> \ i -> inl i } ;
 suc p0 | r -> split {
  inl k -> split { inl i -> inl (r k i) ; inr t -> inr t } ;
  inr t -> \ i -> inl i } } ;
module Skip (Rg : CRing) {
 open Rg ; module L = RL[Rg] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module D = MnSums[l].Over[Rg] ;
 module AG = ExteriorAlgebra[l].AG[R,z,add,neg,addA,addC,addZ,addN] ;
 -- x without k0, put back with t at k0
 unskip : (p0 : Nat) -> Fin (suc p0) -> (Fin p0 -> R) -> R -> Fin (suc p0) -> R = split {
  zero -> split {
   inl k -> \ x t j -> efq k ;
   inr s -> \ x t -> split { inl j -> x j ; inr u -> t } } ;
  suc p0 | r -> split {
   inl k -> \ x t -> split { inl j -> r k (\ i -> x (inl i)) t j ; inr u -> x (inr tt) } ;
   inr s -> \ x t -> split { inl j -> x j ; inr u -> t } } } ;
 unskip-skip : (p0 : Nat) (k0 : Fin (suc p0)) (x : Fin p0 -> R) (t : R) (i : Fin p0) ->
  Id R (unskip p0 k0 x t (skip p0 k0 i)) (x i) = split {
  zero -> split { inl k -> \ x t i -> efq k ; inr s -> \ x t i -> refl (x i) } ;
  suc p0 | r -> split {
   inl k -> \ x t -> split {
    inl i -> r k (\ i1 -> x (inl i1)) t i ;
    inr u -> ap (\ w -> x (inr w)) (MnSums[l].top-eq tt u) } ;
   inr s -> \ x t i -> refl (x i) } } ;
 unskip-at : (p0 : Nat) (k0 : Fin (suc p0)) (x : Fin p0 -> R) (t : R) -> Id R (unskip p0 k0 x t k0) t = split {
  zero -> split { inl k -> \ x t -> efq k ; inr s -> \ x t -> refl t } ;
  suc p0 | r -> split {
   inl k -> \ x t -> r k (\ i -> x (inl i)) t ;
   inr s -> \ x t -> refl t } } ;
 delta-skip : (p0 : Nat) (k0 : Fin (suc p0)) (i : Fin p0) -> Id R (D.delta (suc p0) k0 (skip p0 k0 i)) z = split {
  zero -> split { inl k -> \ i -> efq k ; inr s -> \ i -> refl z } ;
  suc p0 | r -> split {
   inl k -> split { inl i -> r k i ; inr u -> refl z } ;
   inr s -> \ i -> refl z } } ;
 swap3 (a b c : R) : Id R (add a (add b c)) (add b (add a c)) =
  trans (addA a b c) (trans (ap (\ w -> add w c) (addC a b)) (sym (addA b a c))) ;
 sum-skip : (p0 : Nat) (k0 : Fin (suc p0)) (f : Fin (suc p0) -> R) ->
  Id R (S.sum (suc p0) f) (add (f k0) (S.sum p0 (\ i -> f (skip p0 k0 i)))) = split {
  zero -> split {
   inl k -> \ f -> efq k ;
   inr s -> \ f -> ap (\ w -> add (f (inr w)) z) (MnSums[l].top-eq tt s) } ;
  suc p0 | r -> split {
   inl k -> \ f -> trans (ap (add (f (inr tt))) (r k (\ i -> f (inl i)))) (swap3 (f (inr tt)) (f (inl k)) (S.sum p0 (\ i -> f (inl (skip p0 k i))))) ;
   inr s -> \ f -> ap (\ w -> add (f (inr w)) (S.sum (suc p0) (\ i -> f (inl i)))) (MnSums[l].top-eq tt s) } } ;
} ;

module Over (Lg : CRing) (setL : Pr.isSet Lg.R) (p0 q l1 l2 l3 : Nat)
 (A : Matrices[l].Over[Lg].Mat (suc p0) q) (B : Matrices[l].Over[Lg].Mat q l1)
 (C2 : Matrices[l].Over[Lg].Mat l1 l2) (Dm : Matrices[l].Over[Lg].Mat l2 l3)
 (k0 : Fin (suc p0)) (i0 : Fin q) (unit : RL[Lg].unit (A k0 i0)) {
 open Lg ; module L = RL[Lg] ;
 module MM = Matrices[l].Over[Lg] ;
 module US = UnitStep[l].Over[Lg,setL,suc p0,q,l1,A,B,k0,i0,unit] ;
 module SK = Skip[Lg] ;
 module S = FiniteIdeal[l].Sums[Lg] ;
 vec-ext (n : Nat) (u v : MM.Vec n) (h : (i : Fin n) -> Id R (u i) (v i)) : Id (MM.Vec n) u v =
  F.funext (Fin n) (\ i -> R) u v h ;
 sum-zero (n : Nat) (f : Fin n -> R) (h : (i : Fin n) -> Id R (f i) z) : Id R (S.sum n f) z =
  trans (S.sum-cong n f (\ i -> z) h) (S.sum-zero n) ;
 -- the matrices
 A2 : MM.Mat p0 q = \ i -> US.A' (skip p0 k0 i) ;
 B' : MM.Mat q (suc l1) = US.B' ;
 Z : MM.Mat (suc l1) l2 = split { inl i -> C2 i ; inr u -> \ j -> z } ;
 -- pi a = 0
 A'-k0 (j : Fin q) : Id R (US.A' k0 j) z =
  calc R { add (US.a j) (mul (neg (US.lv US.a)) (US.a j))
   =< ap (\ s -> add (US.a j) (mul (neg s) (US.a j))) US.one > add (US.a j) (mul (neg o) (US.a j))
   =< ap (add (US.a j)) (trans (L.neg-mul-left o (US.a j)) (ap neg (L.one-left (US.a j)))) > add (US.a j) (neg (US.a j))
   =< addN (US.a j) > z } ;
 -- A' x = A2 (x without k0)
 apply-A2 (x : MM.Vec (suc p0)) (j : Fin q) :
  Id R (MM.apply (suc p0) q US.A' x j) (MM.apply p0 q A2 (\ i -> x (skip p0 k0 i)) j) =
  trans (SK.sum-skip p0 k0 (\ k -> mul (x k) (US.A' k j)))
   (trans (ap (\ w -> add w (MM.apply p0 q A2 (\ i -> x (skip p0 k0 i)) j)) (trans (ap (mul (x k0)) (A'-k0 j)) (L.mul-zero (x k0))))
    (L.zl (MM.apply p0 q A2 (\ i -> x (skip p0 k0 i)) j))) ;
 -- injective
 module Inj (inj : MM.Injective (suc p0) q A) (x : MM.Vec p0) (hx : (j : Fin q) -> Id R (MM.apply p0 q A2 x j) z) {
  X : MM.Vec (suc p0) = SK.unskip p0 k0 x z ;
  A'X (j : Fin q) : Id R (MM.apply (suc p0) q US.A' X j) z =
   trans (apply-A2 X j)
    (trans (ap {MM.Vec p0} (\ w -> MM.apply p0 q A2 w j) (vec-ext p0 (\ i -> X (skip p0 k0 i)) x (\ i -> SK.unskip-skip p0 k0 x z i))) (hx j)) ;
  c : R = US.lv (MM.apply (suc p0) q A X) ;
  W : MM.Vec (suc p0) = \ k -> TrueGradeIdeals[l].Over[Lg,setL].sub (X k) (mul c (MnSums[l].Over[Lg].delta (suc p0) k0 k)) ;
  AX (j : Fin q) : Id R (MM.apply (suc p0) q A X j) (mul c (US.a j)) =
   trans (sym (US.back-at X j)) (trans (ap (\ w -> add w (mul c (US.a j))) (A'X j)) (L.zl (mul c (US.a j)))) ;
  AW (j : Fin q) : Id R (MM.apply (suc p0) q A W j) z =
   trans (ExactMod[l].Over[Lg,setL].apply-sub (suc p0) q A X (MnSums[l].Over[Lg].delta (suc p0) k0) c j)
    (trans (ap (\ w -> add (MM.apply (suc p0) q A X j) (neg (mul c (w j)))) US.apply-delta)
     (trans (ap (\ w -> add w (neg (mul c (US.a j)))) (AX j)) (addN (mul c (US.a j))))) ;
  result (i : Fin p0) : Id R (x i) z =
   calc R { x i
    =< sym (SK.unskip-skip p0 k0 x z i) > X (skip p0 k0 i)
    =< sym (trans (ap (\ s -> add (X (skip p0 k0 i)) (neg (mul c s))) (SK.delta-skip p0 k0 i))
         (trans (ap (\ s -> add (X (skip p0 k0 i)) (neg s)) (L.mul-zero c)) (trans (ap (add (X (skip p0 k0 i))) L.neg-zero) (addZ (X (skip p0 k0 i))))))
    > W (skip p0 k0 i)
    =< inj W AW (skip p0 k0 i) > z } ;
 } ;
 injective (inj : MM.Injective (suc p0) q A) : MM.Injective p0 q A2 = \ x hx i -> Inj[inj,x,hx].result i ;
 -- B' A2 = 0, exact at R^q
 compose-A2 (bz : MM.ComposeZero (suc p0) q l1 A B) : MM.ComposeZero p0 q (suc l1) A2 B' =
  \ i -> US.Compose[bz].result (skip p0 k0 i) ;
 exact-A2 (ex : MM.Exact (suc p0) q l1 A B) : MM.Exact p0 q (suc l1) A2 B' = \ y hy ->
  TC.map ((x : MM.Vec (suc p0)) * ((i : Fin q) -> Id R (MM.apply (suc p0) q US.A' x i) (y i)))
   ((x : MM.Vec p0) * ((i : Fin q) -> Id R (MM.apply p0 q A2 x i) (y i)))
   (\ w -> (\ i -> w.1 (skip p0 k0 i),\ i -> trans (sym (apply-A2 w.1 i)) (w.2 i)))
   (US.Ex[ex,y,hy].result) ;
 -- Z B' = 0, exact at R^(l1+1)
 apply-Z (y : MM.Vec (suc l1)) (j : Fin l2) :
  Id R (MM.apply (suc l1) l2 Z y j) (MM.apply l1 l2 C2 (\ i -> y (inl i)) j) =
  trans (ap (\ s -> add s (MM.apply l1 l2 C2 (\ i -> y (inl i)) j)) (L.mul-zero (y (inr tt))))
   (L.zl (MM.apply l1 l2 C2 (\ i -> y (inl i)) j)) ;
 compose-B'Z (cz : MM.ComposeZero q l1 l2 B C2) : MM.ComposeZero q (suc l1) l2 B' Z =
  \ i j -> trans (apply-Z (B' i) j) (cz i j) ;
 module ExZ (ex : MM.Exact q l1 l2 B C2) (bz : MM.ComposeZero (suc p0) q l1 A B)
  (y : MM.Vec (suc l1)) (hy : (j : Fin l2) -> Id R (MM.apply (suc l1) l2 Z y j) z) {
  Goal : U l = (w : MM.Vec q) * ((i : Fin (suc l1)) -> Id R (MM.apply q (suc l1) B' w i) (y i)) ;
  module Given (zz : MM.Vec q) (hz : (i : Fin l1) -> Id R (MM.apply q l1 B zz i) (y (inl i))) {
   cc : R = add (y (inr tt)) (neg (US.lv zz)) ;
   w : MM.Vec q = WedgeStep[l].Over[Lg,setL,q].comb zz cc US.a ;
   at : (i : Fin (suc l1)) -> Id R (MM.apply q (suc l1) B' w i) (y i) = split {
    inl i -> trans (MM.apply-comb q l1 B zz US.a cc i)
     (trans (ap (add (MM.apply q l1 B zz i)) (trans (ap (mul cc) (bz k0 i)) (L.mul-zero cc)))
      (trans (addZ (MM.apply q l1 B zz i)) (hz i))) ;
    inr t -> trans (ap (\ s -> MM.apply q (suc l1) B' w (inr s)) (MnSums[l].top-eq t tt))
     (trans (US.last-row w)
      (trans (WedgeStep[l].Over[Lg,setL,q].vdot-comb q US.lam zz US.a cc)
       (trans (ap (\ s -> add (US.lv zz) (mul cc s)) US.one)
        (trans (ap (add (US.lv zz)) (mulO cc))
         (trans (TrueGradeIdeals[l].Over[Lg,setL].add-sub (US.lv zz) (y (inr tt)))
          (ap (\ s -> y (inr s)) (MnSums[l].top-eq tt t))))))) } ;
   result : Goal = (w,at) ;
  } ;
  result : Tr.Trunc[Goal].carrier =
   TC.map ((zz : MM.Vec q) * ((i : Fin l1) -> Id R (MM.apply q l1 B zz i) (y (inl i)))) Goal
    (\ v -> Given[v.1,v.2].result) (ex (\ i -> y (inl i)) (\ j -> trans (sym (apply-Z y j)) (hy j))) ;
 } ;
 exact-B'Z (ex : MM.Exact q l1 l2 B C2) (bz : MM.ComposeZero (suc p0) q l1 A B) : MM.Exact q (suc l1) l2 B' Z =
  \ y hy -> ExZ[ex,bz,y,hy].result ;
 -- Dm Z = 0, exact at R^l2
 compose-ZD (cz : MM.ComposeZero l1 l2 l3 C2 Dm) : MM.ComposeZero (suc l1) l2 l3 Z Dm = split {
  inl i -> cz i ;
  inr u -> \ j -> sum-zero l2 (\ i -> mul z (Dm i j)) (\ i -> L.zero-mul (Dm i j)) } ;
 exact-ZD (ex : MM.Exact l1 l2 l3 C2 Dm) : MM.Exact (suc l1) l2 l3 Z Dm = \ y hy ->
  TC.map ((x : MM.Vec l1) * ((i : Fin l2) -> Id R (MM.apply l1 l2 C2 x i) (y i)))
   ((x : MM.Vec (suc l1)) * ((i : Fin l2) -> Id R (MM.apply (suc l1) l2 Z x i) (y i)))
   (\ w -> (CommonPower[l].extend R l1 w.1 z,\ i -> trans (apply-Z (CommonPower[l].extend R l1 w.1 z) i) (w.2 i)))
   (ex y hy) ;
 -- minors of B' and Z
 module MinorsB (r : Nat) {
  module ML = Enumerate[l].MinorList[Lg,setL,r,q,l1,B] ;
  module GB = RegularIdeal[l].Generated[Lg,ML.N,ML.minor-list] ;
  module IE = IdealExt[l].Over[Lg,setL,GB.ideal] ;
  module MK = MinorKill[l].Over[Lg,setL] ;
  module MI = Minors[l].Over[Lg,setL] ;
  is-minor (ci : MI.Index r q l1) : GB.In (MI.minors r q l1 B ci) =
   subst (\ c1 -> GB.In (MI.minors r q l1 B c1)) (Enumerate[l].pre-eq (MI.Index r q l1) ML.E ci)
    (GB.generator (Enumerate[l].pre (MI.Index r q l1) ML.E ci)) ;
  image (C1 : MM.Mat r q) : IE.InCoeff l1 (MM.wedge r l1 (MK.compose r q l1 B C1)) =
   MK.Image[q,l1,B,GB.ideal].result r (\ c J -> is-minor (c,J)) C1 ;
  module UI = US.XR.UpIn[GB.ideal,r,image] ;
  minor-B' (ci : MI.Index (suc r) q (suc l1)) : GB.In (MI.minors (suc r) q (suc l1) B' ci) =
   subst (\ v -> GB.In (ExteriorCoordinates[l].Over[Lg,setL].coeff (suc l1) (MM.wedge (suc r) (suc l1) v) ci.2))
    (F.funext (Fin (suc r)) (\ t -> MM.Vec (suc l1)) (MK.compose (suc r) q (suc l1) B' (\ t -> MnSums[l].Over[Lg].delta q (ci.1 t)))
     (MK.cols (suc r) q (suc l1) B' ci.1) (\ t -> MI.Map[q,suc l1,B'].apply-delta (ci.1 t)))
    (UI.result (\ t -> MnSums[l].Over[Lg].delta q (ci.1 t)) ci.2) ;
 } ;
 module MinorsZ (r : Nat) {
  module ML = Enumerate[l].MinorList[Lg,setL,r,l1,l2,C2] ;
  module GC = RegularIdeal[l].Generated[Lg,ML.N,ML.minor-list] ;
  module MK = MinorKill[l].Over[Lg,setL] ;
  module MI = Minors[l].Over[Lg,setL] ;
  is-minor (ci : MI.Index r l1 l2) : GC.In (MI.minors r l1 l2 C2 ci) =
   subst (\ c1 -> GC.In (MI.minors r l1 l2 C2 c1)) (Enumerate[l].pre-eq (MI.Index r l1 l2) ML.E ci)
    (GC.generator (Enumerate[l].pre (MI.Index r l1 l2) ML.E ci)) ;
  Cz : MM.Mat (suc l1) l1 = split { inl i -> MnSums[l].Over[Lg].delta l1 i ; inr u -> \ j -> z } ;
  col : (j : Fin (suc l1)) -> Id (MM.Vec l2) (MM.apply l1 l2 C2 (Cz j)) (Z j) = split {
   inl i -> MI.Map[l1,l2,C2].apply-delta i ;
   inr u -> vec-ext l2 (MM.apply l1 l2 C2 (\ j -> z)) (\ j -> z) (\ j -> sum-zero l1 (\ i -> mul z (C2 i j)) (\ i -> L.zero-mul (C2 i j))) } ;
  minor-Z (ci : MI.Index r (suc l1) l2) : GC.In (MI.minors r (suc l1) l2 Z ci) =
   subst (\ v -> GC.In (ExteriorCoordinates[l].Over[Lg,setL].coeff l2 (MM.wedge r l2 v) ci.2))
    (F.funext (Fin r) (\ t -> MM.Vec l2) (MK.compose r l1 l2 C2 (\ t -> Cz (ci.1 t))) (MK.cols r (suc l1) l2 Z ci.1) (\ t -> col (ci.1 t)))
    (MK.Image[l1,l2,C2,GC.ideal].result r (\ c J -> is-minor (c,J)) (\ t -> Cz (ci.1 t)) ci.2) ;
 } ;
 -- the converse inclusions: minors of A, B, C2 in the ideals of minors of A2, B', Z
 module Back (bz : MM.ComposeZero (suc p0) q l1 A B) {
  module MK = MinorKill[l].Over[Lg,setL] ;
  module MI = Minors[l].Over[Lg,setL] ;
  module E = Enumerate[l] ;
  ba (j : Fin l1) : Id R (MM.apply q l1 B US.a j) z = bz k0 j ;
  one' : Id R (MM.apply q (suc l1) B' US.a (inr tt)) o = trans (US.last-row US.a) US.one ;
  deltas (k : Nat) (n : Nat) (c : Fin k -> Fin n) : MM.Mat k n = \ t -> MnSums[l].Over[Lg].delta n (c t) ;
  -- D_r(B) in (D_(r+1)(B'))
  module IntoB' (r : Nat) {
   module ML = E.MinorList[Lg,setL,suc r,q,suc l1,B'] ;
   module G = RegularIdeal[l].Generated[Lg,ML.N,ML.minor-list] ;
   is-minor (ci : MI.Index (suc r) q (suc l1)) : G.In (MI.minors (suc r) q (suc l1) B' ci) =
    subst (\ c1 -> G.In (MI.minors (suc r) q (suc l1) B' c1)) (E.pre-eq (MI.Index (suc r) q (suc l1)) ML.E ci)
     (G.generator (E.pre (MI.Index (suc r) q (suc l1)) ML.E ci)) ;
   minor (ci : MI.Index r q l1) : G.In (MI.minors r q l1 B ci) =
    subst (\ w -> G.In (ExteriorCoordinates[l].Over[Lg,setL].coeff l1 w ci.2))
     (trans (US.XR.DownEq[US.a,ba,one',r,deltas r q ci.1].second)
      (ap (MM.wedge r l1) (F.funext (Fin r) (\ t -> MM.Vec l1) (MK.compose r q l1 B (deltas r q ci.1)) (MK.cols r q l1 B ci.1)
        (\ t -> MI.Map[q,l1,B].apply-delta (ci.1 t)))))
     (MK.Image[q,suc l1,B',G.ideal].result (suc r) (\ c J -> is-minor (c,J))
      (CommonPower[l].extend (MM.Vec q) r (deltas r q ci.1) US.a) (inr ci.2)) ;
  } ;
  -- D_r(C2) in (D_r(Z))
  module IntoZ (r : Nat) {
   module ML = E.MinorList[Lg,setL,r,suc l1,l2,Z] ;
   module G = RegularIdeal[l].Generated[Lg,ML.N,ML.minor-list] ;
   minor (ci : MI.Index r l1 l2) : G.In (MI.minors r l1 l2 C2 ci) =
    subst (\ c1 -> G.In (MI.minors r (suc l1) l2 Z c1)) (E.pre-eq (MI.Index r (suc l1) l2) ML.E ((\ t -> inl (ci.1 t)),ci.2))
     (G.generator (E.pre (MI.Index r (suc l1) l2) ML.E ((\ t -> inl (ci.1 t)),ci.2))) ;
  } ;
  -- D_(p0+1)(A) in (D_p0(A2))
  module IntoA2 {
   module ML = E.MinorList[Lg,setL,p0,p0,q,A2] ;
   module G = RegularIdeal[l].Generated[Lg,ML.N,ML.minor-list] ;
   module IE = IdealExt[l].Over[Lg,setL,G.ideal] ;
   module SP = Splitting[l].Over[Lg,setL,suc p0,q,US.lam,US.a,US.one,US.A',US.orth,G.ideal] ;
   is-minor (ci : MI.Index p0 p0 q) : G.In (MI.minors p0 p0 q A2 ci) =
    subst (\ c1 -> G.In (MI.minors p0 p0 q A2 c1)) (E.pre-eq (MI.Index p0 p0 q) ML.E ci)
     (G.generator (E.pre (MI.Index p0 p0 q) ML.E ci)) ;
   hyp (C1 : MM.Mat p0 (suc p0)) : IE.InCoeff q (MM.wedge p0 q (MK.compose p0 (suc p0) q US.A' C1)) =
    subst (\ v -> IE.InCoeff q (MM.wedge p0 q v))
     (F.funext (Fin p0) (\ t -> MM.Vec q) (MK.compose p0 p0 q A2 (\ t i -> C1 t (skip p0 k0 i))) (MK.compose p0 (suc p0) q US.A' C1)
      (\ t -> vec-ext q _ _ (\ j -> sym (apply-A2 (C1 t) j))))
     (MK.Image[p0,q,A2,G.ideal].result p0 (\ c J -> is-minor (c,J)) (\ t i -> C1 t (skip p0 k0 i))) ;
   image (C : MM.Mat (suc p0) (suc p0)) : IE.InCoeff q (MM.wedge (suc p0) q (MK.compose (suc p0) (suc p0) q A C)) =
    subst (\ v -> IE.InCoeff q (MM.wedge (suc p0) q v))
     (F.funext (Fin (suc p0)) (\ t -> MM.Vec q) (SP.vecs (suc p0) C (\ t -> US.lv (MM.apply (suc p0) q A (C t))))
      (MK.compose (suc p0) (suc p0) q A C) (\ t -> vec-ext q _ (MM.apply (suc p0) q A (C t)) (US.back-at (C t))))
     (SP.splitting p0 hyp C (\ t -> US.lv (MM.apply (suc p0) q A (C t)))) ;
   minor (ci : MI.Index (suc p0) (suc p0) q) : G.In (MI.minors (suc p0) (suc p0) q A ci) =
    subst (\ v -> G.In (ExteriorCoordinates[l].Over[Lg,setL].coeff q (MM.wedge (suc p0) q v) ci.2))
     (F.funext (Fin (suc p0)) (\ t -> MM.Vec q) (MK.compose (suc p0) (suc p0) q A (deltas (suc p0) (suc p0) ci.1)) (MK.cols (suc p0) (suc p0) q A ci.1)
      (\ t -> MI.Map[suc p0,q,A].apply-delta (ci.1 t)))
     (image (deltas (suc p0) (suc p0) ci.1) ci.2) ;
  } ;
 } ;
 -- the reduced complex exact gives the original one exact
 module Down (bz : MM.ComposeZero (suc p0) q l1 A B) {
  module SB = TrueGradeIdeals[l].Over[Lg,setL] ;
  ring-1 (y m1 c1 aj : R) : Id R (add (add (add y (mul (neg c1) aj)) (mul m1 aj)) (mul (add c1 (neg m1)) aj)) y =
   calc R { add (add (add y (mul (neg c1) aj)) (mul m1 aj)) (mul (add c1 (neg m1)) aj)
    =< sym (addA (add y (mul (neg c1) aj)) (mul m1 aj) (mul (add c1 (neg m1)) aj))
    > add (add y (mul (neg c1) aj)) (add (mul m1 aj) (mul (add c1 (neg m1)) aj))
    =< ap (add (add y (mul (neg c1) aj)))
        (trans (sym (L.dist-left m1 (add c1 (neg m1)) aj)) (ap (\ s -> mul s aj) (SB.add-sub m1 c1)))
    > add (add y (mul (neg c1) aj)) (mul c1 aj)
    =< sym (addA y (mul (neg c1) aj) (mul c1 aj))
    > add y (add (mul (neg c1) aj) (mul c1 aj))
    =< ap (add y) (trans (sym (L.dist-left (neg c1) c1 aj)) (trans (ap (\ s -> mul s aj) (trans (addC (neg c1) c1) (addN c1))) (L.zero-mul aj)))
    > add y z
    =< addZ y > y } ;
  module Ex0 (ex : MM.Exact p0 q (suc l1) A2 B') (y : MM.Vec q) (hy : (j : Fin l1) -> Id R (MM.apply q l1 B y j) z) {
   y1 : MM.Vec q = US.pi y ;
   hy1 : (j : Fin (suc l1)) -> Id R (MM.apply q (suc l1) B' y1 j) z = split {
    inl j -> trans (MM.apply-comb q l1 B y US.a (neg (US.lv y)) j)
     (trans (WedgeStep[l].Over[Lg,setL,q].AR.cong-add (hy j) (trans (ap (mul (neg (US.lv y))) (bz k0 j)) (L.mul-zero (neg (US.lv y)))))
      (addZ z)) ;
    inr t -> trans (ap (\ s -> MM.apply q (suc l1) B' y1 (inr s)) (MnSums[l].top-eq t tt)) (trans (US.last-row y1) (US.lam-pi y)) } ;
   Goal : U l = (x : MM.Vec (suc p0)) * ((i : Fin q) -> Id R (MM.apply (suc p0) q A x i) (y i)) ;
   module Given (zz : MM.Vec p0) (hz : (i : Fin q) -> Id R (MM.apply p0 q A2 zz i) (y1 i)) {
    X0 : MM.Vec (suc p0) = SK.unskip p0 k0 zz z ;
    m1 : R = US.lv (MM.apply (suc p0) q A X0) ;
    c1 : R = add (US.lv y) (neg m1) ;
    X : MM.Vec (suc p0) = \ k -> add (X0 k) (mul c1 (MnSums[l].Over[Lg].delta (suc p0) k0 k)) ;
    A'X0 (j : Fin q) : Id R (MM.apply (suc p0) q US.A' X0 j) (y1 j) =
     trans (apply-A2 X0 j)
      (trans (ap {MM.Vec p0} (\ w -> MM.apply p0 q A2 w j) (vec-ext p0 (\ i -> X0 (skip p0 k0 i)) zz (\ i -> SK.unskip-skip p0 k0 zz z i))) (hz j)) ;
    eq (j : Fin q) : Id R (MM.apply (suc p0) q A X j) (y j) =
     calc R { MM.apply (suc p0) q A X j
      =< MM.apply-comb (suc p0) q A X0 (MnSums[l].Over[Lg].delta (suc p0) k0) c1 j
      > add (MM.apply (suc p0) q A X0 j) (mul c1 (MM.apply (suc p0) q A (MnSums[l].Over[Lg].delta (suc p0) k0) j))
      =< ap (\ w -> add (MM.apply (suc p0) q A X0 j) (mul c1 (w j))) US.apply-delta
      > add (MM.apply (suc p0) q A X0 j) (mul c1 (US.a j))
      =< ap (\ s -> add s (mul c1 (US.a j))) (sym (US.back-at X0 j))
      > add (add (MM.apply (suc p0) q US.A' X0 j) (mul m1 (US.a j))) (mul c1 (US.a j))
      =< ap (\ s -> add (add s (mul m1 (US.a j))) (mul c1 (US.a j))) (A'X0 j)
      > add (add (add (y j) (mul (neg (US.lv y)) (US.a j))) (mul m1 (US.a j))) (mul c1 (US.a j))
      =< ring-1 (y j) m1 (US.lv y) (US.a j) > y j } ;
    result : Goal = (X,eq) ;
   } ;
   result : Truncation[l].Trunc[Goal].carrier =
    TC.map ((zz : MM.Vec p0) * ((i : Fin q) -> Id R (MM.apply p0 q A2 zz i) (y1 i))) Goal (\ w -> Given[w.1,w.2].result) (ex y1 hy1) ;
  } ;
  exact0 (ex : MM.Exact p0 q (suc l1) A2 B') : MM.Exact (suc p0) q l1 A B = \ y hy -> Ex0[ex,y,hy].result ;
  exact1 (ex : MM.Exact q (suc l1) l2 B' Z) : MM.Exact q l1 l2 B C2 = \ y hy ->
   TC.map ((w : MM.Vec q) * ((i : Fin (suc l1)) -> Id R (MM.apply q (suc l1) B' w i) (CommonPower[l].extend R l1 y z i)))
    ((w : MM.Vec q) * ((i : Fin l1) -> Id R (MM.apply q l1 B w i) (y i)))
    (\ w -> (w.1,\ i -> w.2 (inl i)))
    (ex (CommonPower[l].extend R l1 y z) (\ j -> trans (apply-Z (CommonPower[l].extend R l1 y z) j) (hy j))) ;
  exact2 (ex : MM.Exact (suc l1) l2 l3 Z Dm) : MM.Exact l1 l2 l3 C2 Dm = \ y hy ->
   TC.map ((w : MM.Vec (suc l1)) * ((i : Fin l2) -> Id R (MM.apply (suc l1) l2 Z w i) (y i)))
    ((w : MM.Vec l1) * ((i : Fin l2) -> Id R (MM.apply l1 l2 C2 w i) (y i)))
    (\ w -> ((\ i -> w.1 (inl i)),\ i -> trans (sym (apply-Z w.1 i)) (w.2 i)))
    (ex y hy) ;
 } ;
} ;
