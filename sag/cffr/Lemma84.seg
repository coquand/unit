-- cffr Lemma 8.4.  A complex E -A-> F -B-> G with E = R^e, F = R^(q+p),
-- G = R^g (B A = 0).  Assume alpha in Lambda^p(E) regular, beta in
-- Lambda^p(F) with Gr(beta) >= 2, and ∧^p(A) = beta alpha^T, i.e. the
-- product A_I of the columns of A selected by I is alpha_I beta when
-- |I| = p.  Then ∧^q(B) = gamma bhat^T: B_K = bhat_K gamma for |K| = q,
-- with bhat = unstar(beta) (regular, of degree q) and gamma in Lambda(G).
-- The paper writes beta* for bhat; they differ by a sign depending only on
-- p, q (StarDual), which gamma absorbs.  D_q(B) is the family of Minors
-- (tuples c of q columns): B_c = Lambda(B)(e_c) = sum_I (e_c)_I B_I =
-- h_c gamma with h_c = (e_c | bhat) (minor-value), so D_q(B) is in (gamma);
-- h contains every bhat_I with |I| = q (h-tuple), so h is regular and
-- Gr(h) >= 2 (Enlarge: Gr >= 2 survives adding elements to a family).
-- GammaGrade: Gr(D_q(B)) >= 2 gives Gr(gamma) >= 2.
--
-- Gr(beta) >= 2 is used in its explicit form (cffr §6, item 2;
-- GrTwo): beta regular, and a family y with beta_K y_L = beta_L y_K is
-- merely a multiple t beta; t is unique since beta is regular, so it is
-- obtained by unique choice (`multiple`).
--
-- Proof.  The rows v_j of B (MinorTranspose.transpose) are orthogonal to
-- the columns of A (row-orth).  Fix J with |J| = q, w = v_J (the product of
-- the rows selected by J; r = these rows as a list of length q).  For
-- |I| = p, A_I and w* are proportional (Lemma 8.2, Killed82, with Lemma
-- 8.1: each row kills A_I), i.e. alpha_I (beta_K w*_L - beta_L w*_K) = 0;
-- also for |I| /= p since then alpha_I = 0.  As alpha is regular, beta and
-- w* are proportional (cancel), so w* = gamma_J beta, and by StarDual
-- w = c unstar(w*) = c gamma_J bhat.  Finally the coefficient of B_K at J
-- is the coefficient of v_J at K (MinorTranspose.minor-transpose), i.e.
-- bhat_K (c gamma_J); for |J| /= q it is 0 by degree.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ; module H = ExteriorHomogeneous[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module RI = MI.RI ;
 module EA = ExteriorAlgebra[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module RP = ExteriorReplacement[l].Over[Rg,setR] ;
 module PS = ExteriorPluckerSylvester[l].Over[Rg,setR] ;
 module VC = ExteriorVectorContraction[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module S = FiniteIdeal[l].Sums[Rg] ;
 module CB = ColumnBlocks[l].Over[Rg,setR] ;
 module L82 = Lemma82[l].Over[Rg,setR] ;
 module MT = MinorTranspose[l].Over[Rg,setR] ;
 module DT = Determinant[l].Over[Rg,setR] ;
 module SD = StarDual[l].Over[Rg,setR] ;
 Dec (a b : Nat) : U l = Plus (Id Nat a b) (Not (Id Nat a b)) ;
 eq-from-sub (a b : R) (h : Id R (add a (neg b)) z) : Id R a b =
  sym (trans (sym (L.neg-neg b)) (trans (ap neg (L.neg-uniq a (neg b) h)) (L.neg-neg a))) ;

 -- Gr >= 2 in explicit form (cffr §6, item 2), for R itself
 Multiple (X : U l) (b y : X -> R) : U l = (t : R) * ((K : X) -> Id R (y K) (mul t (b K))) ;
 GrTwo (X : U l) (b : X -> R) : U l =
  RI.Regular X b *
  ((y : X -> R) -> ((K L : X) -> Id R (mul (b K) (y L)) (mul (b L) (y K))) -> Tr.Trunc[Multiple X b y].carrier) ;
 -- for b regular the multiple is unique
 multiple-unique (X : U l) (b y : X -> R) (rb : RI.Regular X b) (m m' : Multiple X b y) : Id R m.1 m'.1 =
  eq-from-sub m.1 m'.1 (rb (add m.1 (neg m'.1)) tt (\ K -> calc R {
   mul (b K) (add m.1 (neg m'.1))
    =< dist (b K) m.1 (neg m'.1) > add (mul (b K) m.1) (mul (b K) (neg m'.1))
    =< ap (add (mul (b K) m.1)) (L.mul-neg (b K) m'.1) > add (mul (b K) m.1) (neg (mul (b K) m'.1))
    =< Ps.cong2 R (\ s t -> add s (neg t)) _ _ _ _ (trans (mulC (b K) m.1) (sym (m.2 K))) (trans (mulC (b K) m'.1) (sym (m'.2 K)))
    > add (y K) (neg (y K))
    =< addN (y K) > z })) ;
 multiple-prop (X : U l) (b y : X -> R) (rb : RI.Regular X b) : Pr.isProp (Multiple X b y) = \ m m' ->
  Pr.Sigma-eq R (\ t -> (K : X) -> Id R (y K) (mul t (b K))) m.1 m'.1 m.2 m'.2 (multiple-unique X b y rb m m')
   (F.isProp-Pi X (\ K -> Id R (y K) (mul m'.1 (b K))) (\ K -> setR (y K) (mul m'.1 (b K)))) ;
 multiple (X : U l) (b : X -> R) (gb : GrTwo X b) (y : X -> R)
  (hy : (K L : X) -> Id R (mul (b K) (y L)) (mul (b L) (y K))) : Multiple X b y =
  Tr.Trunc[Multiple X b y].induction @l (\ w -> Multiple X b y) (\ w -> multiple-prop X b y gb.1) (\ m -> m) (gb.2 y hy) ;

 -- Gr >= 2 survives enlarging the family: if every a_i is some b_m or is 0
 module Enlarge (A B : U l) (a : A -> R) (b : B -> R) (ga : GrTwo A a)
  (sg : (i : A) -> Plus ((m : B) * Id R (b m) (a i)) (Id R (a i) z)) {
  Hit (i : A) : U l = Plus ((m : B) * Id R (b m) (a i)) (Id R (a i) z) ;
  kill-a (x : R) (h : RI.ZeroOn B b x) (i : A) : Hit i -> Id R (mul (a i) x) z = split {
   inl w -> trans (ap (\ c -> mul c x) (sym w.2)) (h w.1) ;
   inr e -> trans (ap (\ c -> mul c x) e) (L.zero-mul x) } ;
  regular : RI.Regular B b = \ x t h -> ga.1 x tt (\ i -> kill-a x h i (sg i)) ;
  module Fam (y : B -> R) (hy : (m m' : B) -> Id R (mul (b m) (y m')) (mul (b m') (y m))) {
   z0 (i : A) : Hit i -> R = split { inl w -> y w.1 ; inr e -> z } ;
   zz (i : A) : R = z0 i (sg i) ;
   pz (i j : A) : (di : Hit i) -> (dj : Hit j) -> Id R (mul (a i) (z0 j dj)) (mul (a j) (z0 i di)) = split {
    inl w -> split {
     inl w' -> trans (ap (\ c -> mul c (y w'.1)) (sym w.2)) (trans (hy w.1 w'.1) (ap (\ c -> mul c (y w.1)) w'.2)) ;
     inr e' -> trans (L.mul-zero (a i)) (sym (trans (ap (\ c -> mul c (y w.1)) e') (L.zero-mul (y w.1)))) } ;
    inr e -> \ dj -> trans (trans (ap (\ c -> mul c (z0 j dj)) e) (L.zero-mul (z0 j dj))) (sym (L.mul-zero (a j))) } ;
   m0 : Multiple A a zz = multiple A a ga zz (\ i j -> pz i j (sg i) (sg j)) ;
   -- b_m (y_m - t b_m) ... in fact a_i (y_m - t b_m) = 0 for all i
   module At (m : B) {
    x : R = add (y m) (neg (mul m0.1 (b m))) ;
    kill (i : A) : (di : Hit i) -> Id R (z0 i di) (mul m0.1 (a i)) -> Id R (mul (a i) x) z = split {
     inl w -> \ hz -> calc R {
      mul (a i) x =< dist (a i) (y m) (neg (mul m0.1 (b m))) > add (mul (a i) (y m)) (mul (a i) (neg (mul m0.1 (b m))))
       =< ap (add (mul (a i) (y m))) (L.mul-neg (a i) (mul m0.1 (b m))) > add (mul (a i) (y m)) (neg (mul (a i) (mul m0.1 (b m))))
       =< ap (\ c -> add c (neg (mul (a i) (mul m0.1 (b m)))))
           (trans (ap (\ c -> mul c (y m)) (sym w.2)) (trans (hy w.1 m) (trans (ap (mul (b m)) hz) (L.mul-swap (b m) m0.1 (a i)))))
       > add (mul m0.1 (mul (b m) (a i))) (neg (mul (a i) (mul m0.1 (b m))))
       =< ap (\ c -> add (mul m0.1 (mul (b m) (a i))) (neg c)) (trans (L.mul-swap (a i) m0.1 (b m)) (ap (mul m0.1) (mulC (a i) (b m))))
       > add (mul m0.1 (mul (b m) (a i))) (neg (mul m0.1 (mul (b m) (a i))))
       =< addN (mul m0.1 (mul (b m) (a i))) > z } ;
     inr e -> \ hz -> trans (ap (\ c -> mul c x) e) (L.zero-mul x) } ;
    result : Id R (y m) (mul m0.1 (b m)) =
     eq-from-sub (y m) (mul m0.1 (b m)) (ga.1 x tt (\ i -> kill i (sg i) (m0.2 i))) ;
   } ;
   result : Tr.Trunc[Multiple B b y].carrier = Tr.Trunc[Multiple B b y].inc (m0.1,\ m -> At[m].result) ;
  } ;
  result : GrTwo B b = (regular,\ y hy -> Fam[y,hy].result) ;
 } ;

 -- Gr(star x) >= 2 gives Gr(x) >= 2
 module StarGrade (n : Nat) (x : Ext n) (g : GrTwo (C.Index n) (CO.coeff n (DU.star n x))) {
  B (K : C.Index n) : R = CO.coeff n (DU.star n x) K ;
  xs (K : C.Index n) : R = CO.coeff n x K ;
  eps (K : C.Index n) : R = HO.epsilon n K ;
  cK (K : C.Index n) : C.Index n = H.complement n K ;
  B-at (K : C.Index n) : Id R (B K) (mul (eps (cK K)) (xs (cK K))) =
   trans (ap B (sym (H.complement-invol n K))) (HO.coeff-star n x (cK K)) ;
  regular : RI.Regular (C.Index n) xs = \ t u h -> g.1 t tt (\ K -> calc R {
   mul (B K) t =< ap (\ c -> mul c t) (B-at K) > mul (mul (eps (cK K)) (xs (cK K))) t
    =< sym (mulA (eps (cK K)) (xs (cK K)) t) > mul (eps (cK K)) (mul (xs (cK K)) t)
    =< ap (mul (eps (cK K))) (h (cK K)) > mul (eps (cK K)) z
    =< L.mul-zero (eps (cK K)) > z }) ;
  module Fam (y : C.Index n -> R) (hy : (K M : C.Index n) -> Id R (mul (xs K) (y M)) (mul (xs M) (y K))) {
   Y (K : C.Index n) : R = mul (eps (cK K)) (y (cK K)) ;
   hY (K M : C.Index n) : Id R (mul (B K) (Y M)) (mul (B M) (Y K)) = calc R {
    mul (B K) (Y M) =< ap (\ c -> mul c (Y M)) (B-at K)
     > mul (mul (eps (cK K)) (xs (cK K))) (mul (eps (cK M)) (y (cK M)))
     =< L.mul-four (eps (cK K)) (xs (cK K)) (eps (cK M)) (y (cK M))
     > mul (mul (eps (cK K)) (eps (cK M))) (mul (xs (cK K)) (y (cK M)))
     =< Ps.cong2 R mul _ _ _ _ (mulC (eps (cK K)) (eps (cK M))) (hy (cK K) (cK M))
     > mul (mul (eps (cK M)) (eps (cK K))) (mul (xs (cK M)) (y (cK K)))
     =< sym (L.mul-four (eps (cK M)) (xs (cK M)) (eps (cK K)) (y (cK K)))
     > mul (mul (eps (cK M)) (xs (cK M))) (mul (eps (cK K)) (y (cK K)))
     =< ap (\ c -> mul c (Y K)) (sym (B-at M)) > mul (B M) (Y K) } ;
   from (m : Multiple (C.Index n) B Y) (i : C.Index n) : Id R (y i) (mul m.1 (xs i)) =
    -- eps_i y_i = Y (c i) = t B (c i) = t eps_i x_i, and eps_i eps_i = 1
    calc R { y i
     =< sym (trans (ap (\ c -> mul c (y i)) (HO.epsilon-square n i)) (L.one-left (y i)))
     > mul (mul (eps i) (eps i)) (y i)
     =< sym (mulA (eps i) (eps i) (y i)) > mul (eps i) (mul (eps i) (y i))
     =< ap (mul (eps i)) (trans (sym (ap (\ j -> mul (eps j) (y j)) (H.complement-invol n i)))
         (trans (m.2 (cK i)) (trans (ap (mul m.1) (HO.coeff-star n x i)) (L.mul-swap m.1 (eps i) (xs i)))))
     > mul (eps i) (mul (eps i) (mul m.1 (xs i)))
     =< mulA (eps i) (eps i) (mul m.1 (xs i)) > mul (mul (eps i) (eps i)) (mul m.1 (xs i))
     =< trans (ap (\ c -> mul c (mul m.1 (xs i))) (HO.epsilon-square n i)) (L.one-left (mul m.1 (xs i)))
     > mul m.1 (xs i) } ;
   module TY = Tr.Trunc[Multiple (C.Index n) xs y] ;
   result : TY.carrier =
    Tr.Trunc[Multiple (C.Index n) B Y].induction @l (\ w -> TY.carrier) (\ w -> TY.proposition)
     (\ m -> TY.inc (m.1,from m)) (g.2 Y hY) ;
  } ;
  result : GrTwo (C.Index n) xs = (regular,\ y hy -> Fam[y,hy].result) ;
 } ;

 module At (e q p g : Nat) (A : MM.Mat e (plus q p)) (B : MM.Mat (plus q p) g)
  (cz : MM.ComposeZero e (plus q p) g A B)
  (a0 : Ext e) (da : DG.Deg e p a0) (ra : RI.Regular (C.Index e) (CO.coeff e a0))
  (b0 : Ext (plus q p)) (db : DG.Deg (plus q p) p b0) (gb : GrTwo (C.Index (plus q p)) (CO.coeff (plus q p) b0))
  (hA : (I : C.Index e) -> Id Nat (BA.count e I) p ->
   Id (Ext (plus q p)) (CB.Selected[plus q p].selected-product e I A) (escale (plus q p) (CO.coeff e a0 I) b0)) {
  module SE = CB.Selected[plus q p] ;
  module SG = CB.Selected[g] ;
  module VN = RP.Columns[AL.Vec (plus q p)] ;
  module TR = MT.Transpose[plus q p,g,B] ;
  module L81 = Lemma81[l].Over[Rg,setR,plus q p] ;
  module WS = WedgeStep[l].Over[Rg,setR,plus q p] ;
  -- the rows of B, orthogonal to the columns of A
  v : MM.Mat g (plus q p) = MT.transpose (plus q p) g B ;
  Orth (x : AL.Vec (plus q p)) : U l = (k : Ps.Fin e) -> Id R (VC.vdot (plus q p) x (A k)) z ;
  row-orth (j : Ps.Fin g) : Orth (v j) = \ k ->
   trans (WS.vdot-sum (plus q p) (v j) (A k))
    (trans (S.sum-cong (plus q p) (\ i -> mul (B i j) (A k i)) (\ i -> mul (A k i) (B i j)) (\ i -> mulC (B i j) (A k i)))
     (cz k j)) ;
  transparent PS.transport-list ;
  transport-orth (m : Nat) (a : Ps.Fin m -> AL.Vec (plus q p)) (h : (k : Ps.Fin m) -> Orth (a k)) (m' : Nat) (eq : Id Nat m m') :
   (k : Ps.Fin m') -> Orth (PS.transport-list (plus q p) m m' eq a k) =
   idJ Nat m (\ m1 e1 -> (k : Ps.Fin m1) -> Orth (PS.transport-list (plus q p) m m1 e1 a k)) h m' eq ;
  opaque PS.transport-list ;

  -- a subset J of q rows
  module Row (J : C.Index g) (eJ : Id Nat (BA.count g J) q) {
   r : Ps.Fin q -> AL.Vec (plus q p) = PS.transport-list (plus q p) (BA.count g J) q eJ (VN.selected g J v) ;
   w : Ext (plus q p) = SE.selected-product g J v ;
   r-product : Id (Ext (plus q p)) (eprod (plus q p) q (\ k -> gen (plus q p) (r k))) w =
    PS.product-transport (plus q p) (BA.count g J) (VN.selected g J v) q eJ ;
   r-orth : (k : Ps.Fin q) -> Orth (r k) =
    transport-orth (BA.count g J) (VN.selected g J v)
     (\ k -> subst Orth (sym (VN.selected-value g J v k)) (row-orth (RP.positions g J k))) q eJ ;
   killed (I : C.Index e) (k : Ps.Fin q) : L81.Killed (r k) (SE.selected-product e I A) =
    L81.killed (BA.count e I) (r k) (VN.selected e I A)
     (\ i -> subst (\ x -> Id R (VC.vdot (plus q p) (r k) x) z) (sym (VN.selected-value e I A i))
      (r-orth k (RP.positions e I i))) ;
   degree (I : C.Index e) (eI : Id Nat (BA.count e I) p) : DG.Deg (plus q p) p (SE.selected-product e I A) =
    subst (\ c -> DG.Deg (plus q p) c (SE.selected-product e I A)) eI
     (DG.deg-eprod (plus q p) (BA.count e I) (\ k -> gen (plus q p) (VN.selected e I A k))
      (\ k -> DG.deg-gen (plus q p) (VN.selected e I A k))) ;
   -- Lemma 8.2: A_I and w* are proportional
   prop (I : C.Index e) (eI : Id Nat (BA.count e I) p) :
    L82.Proportional (plus q p) (SE.selected-product e I A) (L82.bstar (plus q p) w) =
    subst (\ t -> L82.Proportional (plus q p) (SE.selected-product e I A) (L82.bstar (plus q p) t)) r-product
     (L82.Killed82[q,p,r,SE.selected-product e I A,degree I eI,\ k -> killed I k].result) ;
   y (K : C.Index (plus q p)) : R = CO.coeff (plus q p) (L82.bstar (plus q p) w) K ;
   -- the coefficient of A_I at K is alpha_I beta_K
   coeff-A (I : C.Index e) (eI : Id Nat (BA.count e I) p) (K : C.Index (plus q p)) :
    Id R (CO.coeff (plus q p) (SE.selected-product e I A) K) (mul (CO.coeff e a0 I) (CO.coeff (plus q p) b0 K)) =
    trans (ap (\ t -> CO.coeff (plus q p) t K) (hA I eI)) (CO.coeff-scale (plus q p) (CO.coeff e a0 I) b0 K) ;
   -- beta and w* are proportional, since alpha is regular
   module Cancel (K M : C.Index (plus q p)) {
    x : R = add (mul (CO.coeff (plus q p) b0 K) (y M)) (neg (mul (CO.coeff (plus q p) b0 M) (y K))) ;
    kill (I : C.Index e) : Dec (BA.count e I) p -> Id R (mul (CO.coeff e a0 I) x) z = split {
     inl eI -> calc R {
      mul (CO.coeff e a0 I) x
       =< dist (CO.coeff e a0 I) (mul (CO.coeff (plus q p) b0 K) (y M)) (neg (mul (CO.coeff (plus q p) b0 M) (y K)))
       > add (mul (CO.coeff e a0 I) (mul (CO.coeff (plus q p) b0 K) (y M)))
          (mul (CO.coeff e a0 I) (neg (mul (CO.coeff (plus q p) b0 M) (y K))))
       =< Ps.cong2 R add _ _ _ _ (mulA (CO.coeff e a0 I) (CO.coeff (plus q p) b0 K) (y M))
           (trans (L.mul-neg (CO.coeff e a0 I) (mul (CO.coeff (plus q p) b0 M) (y K)))
            (ap neg (mulA (CO.coeff e a0 I) (CO.coeff (plus q p) b0 M) (y K))))
       > add (mul (mul (CO.coeff e a0 I) (CO.coeff (plus q p) b0 K)) (y M))
          (neg (mul (mul (CO.coeff e a0 I) (CO.coeff (plus q p) b0 M)) (y K)))
       =< ap (\ s -> add (mul (mul (CO.coeff e a0 I) (CO.coeff (plus q p) b0 K)) (y M)) (neg s))
           (trans (sym (ap (\ s -> mul s (y K)) (coeff-A I eI M)))
            (trans (sym (prop I eI K M)) (ap (\ s -> mul s (y M)) (coeff-A I eI K))))
       > add (mul (mul (CO.coeff e a0 I) (CO.coeff (plus q p) b0 K)) (y M))
          (neg (mul (mul (CO.coeff e a0 I) (CO.coeff (plus q p) b0 K)) (y M)))
       =< addN (mul (mul (CO.coeff e a0 I) (CO.coeff (plus q p) b0 K)) (y M)) > z } ;
     inr ne -> trans (ap (\ c -> mul c x) (HO.coeff-support e p a0 da I ne)) (L.zero-mul x) } ;
    result : Id R (mul (CO.coeff (plus q p) b0 K) (y M)) (mul (CO.coeff (plus q p) b0 M) (y K)) =
     eq-from-sub (mul (CO.coeff (plus q p) b0 K) (y M)) (mul (CO.coeff (plus q p) b0 M) (y K))
      (ra x tt (\ I -> kill I (H.DecNat.dec (BA.count e I) p))) ;
   } ;
   gam : Multiple (C.Index (plus q p)) (CO.coeff (plus q p) b0) y =
    multiple (C.Index (plus q p)) (CO.coeff (plus q p) b0) gb y (\ K M -> Cancel[K,M].result) ;
   gamma-J : R = gam.1 ;
   bstar-w : Id (Ext (plus q p)) (L82.bstar (plus q p) w) (escale (plus q p) gamma-J b0) =
    CO.ext (plus q p) (L82.bstar (plus q p) w) (escale (plus q p) gamma-J b0)
     (\ K -> trans (gam.2 K) (sym (CO.coeff-scale (plus q p) gamma-J b0 K))) ;
   module DR = SD.Dual[q,p,r] ;
   -- w = c gamma_J unstar(beta)
   w-value : Id (Ext (plus q p)) w (escale (plus q p) (mul DR.c gamma-J) (DU.unstar (plus q p) b0)) = calc (Ext (plus q p)) {
    w =< sym r-product > DR.y
     =< DR.unstar-bstar > escale (plus q p) DR.c (DU.unstar (plus q p) (L82.bstar (plus q p) DR.y))
     =< ap (\ t -> escale (plus q p) DR.c (DU.unstar (plus q p) (L82.bstar (plus q p) t))) r-product
     > escale (plus q p) DR.c (DU.unstar (plus q p) (L82.bstar (plus q p) w))
     =< ap (\ t -> escale (plus q p) DR.c (DU.unstar (plus q p) t)) bstar-w
     > escale (plus q p) DR.c (DU.unstar (plus q p) (escale (plus q p) gamma-J b0))
     =< ap (escale (plus q p) DR.c) (DR.AT.unstar-scale gamma-J b0)
     > escale (plus q p) DR.c (escale (plus q p) gamma-J (DU.unstar (plus q p) b0))
     =< EA.escale-scale (plus q p) DR.c gamma-J (DU.unstar (plus q p) b0)
     > escale (plus q p) (mul DR.c gamma-J) (DU.unstar (plus q p) b0) } ;
  } ;

  -- gamma and bhat
  sign : R = SD.pw (SD.sgn p) q ;
  gamma-at (J : C.Index g) : Dec (BA.count g J) q -> R = split {
   inl eJ -> mul sign (Row[J,eJ].gamma-J) ; inr ne -> z } ;
  gamma : Ext g = CO.tab g (\ J -> gamma-at J (H.DecNat.dec (BA.count g J) q)) ;
  bhat : Ext (plus q p) = DU.unstar (plus q p) b0 ;
  minor (K : C.Index (plus q p)) (eK : Id Nat (BA.count (plus q p) K) q) (J : C.Index g) :
   (d : Dec (BA.count g J) q) ->
   Id R (CO.coeff g (SG.selected-product (plus q p) K B) J) (mul (CO.coeff (plus q p) bhat K) (gamma-at J d)) = split {
   inl eJ -> calc R {
    CO.coeff g (SG.selected-product (plus q p) K B) J
     =< TR.minor-transpose K J > CO.coeff (plus q p) (Row[J,eJ].w) K
     =< ap (\ t -> CO.coeff (plus q p) t K) (Row[J,eJ].w-value)
     > CO.coeff (plus q p) (escale (plus q p) (mul sign (Row[J,eJ].gamma-J)) bhat) K
     =< CO.coeff-scale (plus q p) (mul sign (Row[J,eJ].gamma-J)) bhat K
     > mul (mul sign (Row[J,eJ].gamma-J)) (CO.coeff (plus q p) bhat K)
     =< mulC (mul sign (Row[J,eJ].gamma-J)) (CO.coeff (plus q p) bhat K)
     > mul (CO.coeff (plus q p) bhat K) (mul sign (Row[J,eJ].gamma-J)) } ;
   inr ne -> trans (HO.coeff-support g q (SG.selected-product (plus q p) K B)
      (subst (\ c -> DG.Deg g c (SG.selected-product (plus q p) K B)) eK
       (DG.deg-eprod g (BA.count (plus q p) K) (\ k -> gen g (RP.Columns[AL.Vec g].selected (plus q p) K B k))
        (\ k -> DG.deg-gen g (RP.Columns[AL.Vec g].selected (plus q p) K B k)))) J ne)
    (sym (L.mul-zero (CO.coeff (plus q p) bhat K))) } ;
  -- Lemma 8.4: ∧^q(B) = gamma bhat^T
  lemma84 (K : C.Index (plus q p)) (eK : Id Nat (BA.count (plus q p) K) q) :
   Id (Ext g) (SG.selected-product (plus q p) K B) (escale g (CO.coeff (plus q p) bhat K) gamma) =
   CO.ext g (SG.selected-product (plus q p) K B) (escale g (CO.coeff (plus q p) bhat K) gamma)
    (\ J -> trans (minor K eK J (H.DecNat.dec (BA.count g J) q))
     (sym (trans (CO.coeff-scale g (CO.coeff (plus q p) bhat K) gamma J)
      (ap (mul (CO.coeff (plus q p) bhat K)) (CO.coeff-tab g (\ J1 -> gamma-at J1 (H.DecNat.dec (BA.count g J1) q)) J))))) ;
  -- bhat has degree q and is regular
  bhat-degree : DG.Deg (plus q p) q bhat = HO.unstar-degree (plus q p) q p b0 db (refl (plus q p)) ;
  bhat-regular : RI.Regular (C.Index (plus q p)) (CO.coeff (plus q p) bhat) = \ x t h ->
   gb.1 x tt (\ K -> trans (mulC (CO.coeff (plus q p) b0 K) x)
    (trans (sym (CO.coeff-scale (plus q p) x b0 K))
     (trans (ap (\ u -> CO.coeff (plus q p) u K)
       (trans (ap (escale (plus q p) x) (sym (DU.star-unstar (plus q p) b0)))
        (trans (sym (DU.star-scale (plus q p) x bhat))
         (trans (ap (DU.star (plus q p))
           (CO.ext (plus q p) (escale (plus q p) x bhat) (ezero (plus q p))
            (\ K1 -> trans (CO.coeff-scale (plus q p) x bhat K1)
             (trans (mulC x (CO.coeff (plus q p) bhat K1)) (trans (h K1) (sym (CO.coeff-zero (plus q p) K1)))))))
          (HO.star-zero (plus q p))))))
      (CO.coeff-zero (plus q p) K)))) ;

  -- gamma has degree q
  gamma-off (J : C.Index g) (ne : Not (Id Nat (BA.count g J) q)) : (d : Dec (BA.count g J) q) -> Id R (gamma-at J d) z = split {
   inl eJ -> efq (ne eJ) ; inr n -> refl z } ;
  gamma-coeff (J : C.Index g) : Id R (CO.coeff g gamma J) (gamma-at J (H.DecNat.dec (BA.count g J) q)) =
   CO.coeff-tab g (\ J1 -> gamma-at J1 (H.DecNat.dec (BA.count g J1) q)) J ;
  gamma-degree : DG.Deg g q gamma =
   HO.support-degree g q gamma (\ J ne -> trans (gamma-coeff J) (gamma-off J ne (H.DecNat.dec (BA.count g J) q))) ;
  -- Gr(beta) >= 2 passes to bhat = unstar(beta)
  bhat-grade : GrTwo (C.Index (plus q p)) (CO.coeff (plus q p) bhat) =
   StarGrade[plus q p,bhat,subst (\ w -> GrTwo (C.Index (plus q p)) (CO.coeff (plus q p) w))
    (sym (DU.star-unstar (plus q p) b0)) gb].result ;
  -- the minors of B on a tuple c of q columns: B_c = Lambda(B)(e_c) = h_c gamma
  module MB = MI.Map[plus q p,g,B] ;
  module LB = MT.Laws[plus q p,g,B] ;
  module DS = MnSums[l].Over[Rg] ;
  module SR = C.SumMap[R,Ext g,add,eadd g,\ a -> escale g a gamma,\ a b -> EA.eadd-scale g a b gamma] ;
  ec (c : Ps.Fin q -> Ps.Fin (plus q p)) : Ext (plus q p) = eprod (plus q p) q (\ t -> gen (plus q p) (DS.delta (plus q p) (c t))) ;
  ec-degree (c : Ps.Fin q -> Ps.Fin (plus q p)) : DG.Deg (plus q p) q (ec c) =
   DG.deg-eprod (plus q p) q (\ t -> gen (plus q p) (DS.delta (plus q p) (c t))) (\ t -> DG.deg-gen (plus q p) (DS.delta (plus q p) (c t))) ;
  h (c : Ps.Fin q -> Ps.Fin (plus q p)) : R = DU.dot (plus q p) (ec c) bhat ;
  term (c : Ps.Fin q -> Ps.Fin (plus q p)) (I : C.Index (plus q p)) : (d : Dec (BA.count (plus q p) I) q) ->
   Id (Ext g) (escale g (CO.coeff (plus q p) (ec c) I) (SG.selected-product (plus q p) I B))
    (escale g (mul (CO.coeff (plus q p) (ec c) I) (CO.coeff (plus q p) bhat I)) gamma) = split {
   inl e -> trans (ap (escale g (CO.coeff (plus q p) (ec c) I)) (lemma84 I e))
    (EA.escale-scale g (CO.coeff (plus q p) (ec c) I) (CO.coeff (plus q p) bhat I) gamma) ;
   inr ne -> trans (ap (\ a -> escale g a (SG.selected-product (plus q p) I B)) (HO.coeff-support (plus q p) q (ec c) (ec-degree c) I ne))
    (trans (EA.zero-scale g (SG.selected-product (plus q p) I B))
     (sym (trans (ap (\ a -> escale g a gamma)
       (trans (ap (\ a -> mul a (CO.coeff (plus q p) bhat I)) (HO.coeff-support (plus q p) q (ec c) (ec-degree c) I ne))
        (L.zero-mul (CO.coeff (plus q p) bhat I))))
      (EA.zero-scale g gamma)))) } ;
  wedge-value (c : Ps.Fin q -> Ps.Fin (plus q p)) :
   Id (Ext g) (MM.wedge q g (\ t -> B (c t))) (escale g (h c) gamma) = calc (Ext g) {
   MM.wedge q g (\ t -> B (c t))
    =< sym (MB.choice q c) > MB.value (ec c)
    =< CO.map-expansion (plus q p) g MB.value LB.linear (ec c)
    > CO.ES[g].SumE.sum (plus q p) (\ I -> escale g (CO.coeff (plus q p) (ec c) I) (MB.value (CO.basis (plus q p) I)))
    =< CO.ES[g].SumE.cong (plus q p) _ (\ I -> escale g (CO.coeff (plus q p) (ec c) I) (SG.selected-product (plus q p) I B))
        (\ I -> ap (escale g (CO.coeff (plus q p) (ec c) I)) (LB.column-image I))
    > CO.ES[g].SumE.sum (plus q p) (\ I -> escale g (CO.coeff (plus q p) (ec c) I) (SG.selected-product (plus q p) I B))
    =< CO.ES[g].SumE.cong (plus q p) _ (\ I -> escale g (mul (CO.coeff (plus q p) (ec c) I) (CO.coeff (plus q p) bhat I)) gamma)
        (\ I -> term c I (H.DecNat.dec (BA.count (plus q p) I) q))
    > CO.ES[g].SumE.sum (plus q p) (\ I -> escale g (mul (CO.coeff (plus q p) (ec c) I) (CO.coeff (plus q p) bhat I)) gamma)
    =< sym (SR.map (plus q p) (\ I -> mul (CO.coeff (plus q p) (ec c) I) (CO.coeff (plus q p) bhat I)))
    > escale g (CO.S.sum (plus q p) (\ I -> mul (CO.coeff (plus q p) (ec c) I) (CO.coeff (plus q p) bhat I))) gamma
    =< ap (\ a -> escale g a gamma) (sym (CO.dot-sum (plus q p) (ec c) bhat)) > escale g (h c) gamma } ;
  -- each minor of B is h_c gamma_J
  minor-value (m : MI.Index q (plus q p) g) :
   Id R (MI.minors q (plus q p) g B m) (mul (h m.1) (CO.coeff g gamma m.2)) =
   trans (ap (\ t -> CO.coeff g t m.2) (wedge-value m.1)) (CO.coeff-scale g (h m.1) gamma m.2) ;
  -- the tuple of the elements of a subset I with |I| = q: h at it is bhat_I
  tuple (I : C.Index (plus q p)) (e : Id Nat (BA.count (plus q p) I) q) : Ps.Fin q -> Ps.Fin (plus q p) =
   subst (\ k -> Ps.Fin k -> Ps.Fin (plus q p)) e (RP.positions (plus q p) I) ;
  ec-positions (I : C.Index (plus q p)) :
   Id (Ext (plus q p)) (eprod (plus q p) (BA.count (plus q p) I) (\ t -> gen (plus q p) (DS.delta (plus q p) (RP.positions (plus q p) I t))))
    (CO.basis (plus q p) I) =
   sym (trans (BA.basis-product (plus q p) I)
    (DT.eprod-cong (plus q p) (BA.count (plus q p) I) (\ t -> gen (plus q p) (BA.select (plus q p) I t))
     (\ t -> gen (plus q p) (DS.delta (plus q p) (RP.positions (plus q p) I t)))
     (\ t -> ap (gen (plus q p)) (RP.select-position (plus q p) I t)))) ;
  ec-tuple (I : C.Index (plus q p)) (e : Id Nat (BA.count (plus q p) I) q) : Id (Ext (plus q p)) (ec (tuple I e)) (CO.basis (plus q p) I) =
   idJ Nat (BA.count (plus q p) I)
    (\ k e1 -> Id (Ext (plus q p)) (eprod (plus q p) k (\ t -> gen (plus q p) (DS.delta (plus q p)
       (subst (\ k1 -> Ps.Fin k1 -> Ps.Fin (plus q p)) e1 (RP.positions (plus q p) I) t)))) (CO.basis (plus q p) I))
    (ec-positions I) q e ;
  h-tuple (I : C.Index (plus q p)) (e : Id Nat (BA.count (plus q p) I) q) : Id R (h (tuple I e)) (CO.coeff (plus q p) bhat I) =
   trans (ap (\ w -> DU.dot (plus q p) w bhat) (ec-tuple I e))
    (trans (DU.dot-sym (plus q p) (CO.basis (plus q p) I) bhat) (CO.dot-basis (plus q p) bhat I)) ;
  -- every bhat_I is an h_c or 0
  h-hit (I : C.Index (plus q p)) : (d : Dec (BA.count (plus q p) I) q) ->
   Plus ((c : Ps.Fin q -> Ps.Fin (plus q p)) * Id R (h c) (CO.coeff (plus q p) bhat I)) (Id R (CO.coeff (plus q p) bhat I) z) = split {
   inl e -> inl (tuple I e,h-tuple I e) ;
   inr ne -> inr (HO.coeff-support (plus q p) q bhat bhat-degree I ne) } ;
  h-kill (x : R) (hh : RI.ZeroOn (Ps.Fin q -> Ps.Fin (plus q p)) h x) (I : C.Index (plus q p)) :
   Plus ((c : Ps.Fin q -> Ps.Fin (plus q p)) * Id R (h c) (CO.coeff (plus q p) bhat I)) (Id R (CO.coeff (plus q p) bhat I) z) ->
   Id R (mul (CO.coeff (plus q p) bhat I) x) z = split {
   inl w -> trans (ap (\ a -> mul a x) (sym w.2)) (hh w.1) ;
   inr e -> trans (ap (\ a -> mul a x) e) (L.zero-mul x) } ;
  h-regular : RI.Regular (Ps.Fin q -> Ps.Fin (plus q p)) h = \ x t hh ->
   bhat-regular x tt (\ I -> h-kill x hh I (h-hit I (H.DecNat.dec (BA.count (plus q p) I) q))) ;
  -- Gr(bhat) >= 2 gives Gr(h) >= 2
  h-grade (gh : GrTwo (C.Index (plus q p)) (CO.coeff (plus q p) bhat)) : GrTwo (Ps.Fin q -> Ps.Fin (plus q p)) h =
   Enlarge[C.Index (plus q p),Ps.Fin q -> Ps.Fin (plus q p),CO.coeff (plus q p) bhat,h,gh,
    \ I -> h-hit I (H.DecNat.dec (BA.count (plus q p) I) q)].result ;
  -- D_q(B) regular gives gamma regular
  gamma-regular (rg : MI.RegularD q (plus q p) g B) : RI.Regular (C.Index g) (CO.coeff g gamma) = \ x t hh -> rg x tt (\ m -> calc R {
   mul (MI.minors q (plus q p) g B m) x
    =< ap (\ c -> mul c x) (minor-value m) > mul (mul (h m.1) (CO.coeff g gamma m.2)) x
    =< sym (mulA (h m.1) (CO.coeff g gamma m.2) x) > mul (h m.1) (mul (CO.coeff g gamma m.2) x)
    =< ap (mul (h m.1)) (hh m.2) > mul (h m.1) z
    =< L.mul-zero (h m.1) > z }) ;
  -- Gr(D_q(B)) >= 2 gives Gr(gamma) >= 2
  module GammaGrade (gm : GrTwo (MI.Index q (plus q p) g) (MI.minors q (plus q p) g B)) {
   gj (J : C.Index g) : R = CO.coeff g gamma J ;
   module Fam (y : C.Index g -> R) (hy : (J J' : C.Index g) -> Id R (mul (gj J) (y J')) (mul (gj J') (y J))) {
    Y (m : MI.Index q (plus q p) g) : R = mul (h m.1) (y m.2) ;
    hY (m m' : MI.Index q (plus q p) g) :
     Id R (mul (MI.minors q (plus q p) g B m) (Y m')) (mul (MI.minors q (plus q p) g B m') (Y m)) = calc R {
     mul (MI.minors q (plus q p) g B m) (Y m')
      =< ap (\ c -> mul c (Y m')) (minor-value m) > mul (mul (h m.1) (gj m.2)) (mul (h m'.1) (y m'.2))
      =< L.mul-four (h m.1) (gj m.2) (h m'.1) (y m'.2) > mul (mul (h m.1) (h m'.1)) (mul (gj m.2) (y m'.2))
      =< Ps.cong2 R mul _ _ _ _ (mulC (h m.1) (h m'.1)) (hy m.2 m'.2)
      > mul (mul (h m'.1) (h m.1)) (mul (gj m'.2) (y m.2))
      =< sym (L.mul-four (h m'.1) (gj m'.2) (h m.1) (y m.2)) > mul (mul (h m'.1) (gj m'.2)) (mul (h m.1) (y m.2))
      =< ap (\ c -> mul c (Y m)) (sym (minor-value m')) > mul (MI.minors q (plus q p) g B m') (Y m) } ;
    -- a multiple t of the minors for Y gives y = t gamma, since h is regular
    module From (mm : Multiple (MI.Index q (plus q p) g) (MI.minors q (plus q p) g B) Y) (J : C.Index g) {
     x : R = add (y J) (neg (mul mm.1 (gj J))) ;
     kill (c : Ps.Fin q -> Ps.Fin (plus q p)) : Id R (mul (h c) x) z = calc R {
      mul (h c) x
       =< dist (h c) (y J) (neg (mul mm.1 (gj J))) > add (mul (h c) (y J)) (mul (h c) (neg (mul mm.1 (gj J))))
       =< ap (add (mul (h c) (y J)))
           (trans (L.mul-neg (h c) (mul mm.1 (gj J)))
            (ap neg (trans (L.mul-swap (h c) mm.1 (gj J)) (ap (mul mm.1) (sym (minor-value (c,J)))))))
       > add (Y (c,J)) (neg (mul mm.1 (MI.minors q (plus q p) g B (c,J))))
       =< ap (\ a -> add a (neg (mul mm.1 (MI.minors q (plus q p) g B (c,J))))) (mm.2 (c,J))
       > add (mul mm.1 (MI.minors q (plus q p) g B (c,J))) (neg (mul mm.1 (MI.minors q (plus q p) g B (c,J))))
       =< addN (mul mm.1 (MI.minors q (plus q p) g B (c,J))) > z } ;
     result : Id R (y J) (mul mm.1 (gj J)) = eq-from-sub (y J) (mul mm.1 (gj J)) (h-regular x tt kill) ;
    } ;
    module TG = Tr.Trunc[Multiple (C.Index g) gj y] ;
    result : TG.carrier =
     Tr.Trunc[Multiple (MI.Index q (plus q p) g) (MI.minors q (plus q p) g B) Y].induction @l (\ w -> TG.carrier) (\ w -> TG.proposition)
      (\ mm -> TG.inc (mm.1,\ J -> From[mm,J].result)) (gm.2 Y hY) ;
   } ;
   result : GrTwo (C.Index g) gj = (gamma-regular gm.1,\ y hy -> Fam[y,hy].result) ;
  } ;
 } ;
} ;
