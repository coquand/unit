-- cffr Lemma 8.2 (Northcott Ch. 7, Lemma 2, without its extra hypotheses).
-- Let n = q + p.  For beta in Lambda(R^n), beta* = sum_I [e_I beta] e_I
-- (bstar; [x] = top(x)), i.e. (e_I | beta*) = [e_I beta].  Two elements
-- a, b are proportional if a_I b_J = a_J b_I for all subsets I, J (all
-- sizes; for elements of degree p this is the paper's condition).
--
-- Lemma 8.2.  If u_1..u_p, v_1..v_q in R^n are pairwise orthogonal, then
-- omega = u_1 ... u_p and beta* are proportional (beta = v_1 ... v_q).
--
-- Proof.  By Lemma 8.1 each v_l kills omega, and omega has degree p.  We
-- prove the statement for any w of degree p killed by all v_l.
-- * Exchange: for x, y in (R^n)^p, with X = x_1 ... x_p, Y = y_1 ... y_p,
--     [Y beta] (w | X) = [X beta] (w | Y).
--   Apply Prop. 8.3 (ExteriorPluckerSylvester.At.cramer) to a = x and the
--   matrix B = (y, v) (ColumnBlocks.concat):
--     det(B) X = sum_{|K| = p} det(B[K <- x]) B_K.
--   det(B) = [Y beta] (concat-product).  Pair with w.  A subset K that
--   meets the v positions has a v_l among its columns, so B_K = X' v_l and
--   (w | B_K) = 0 (Lemma81.right-orthogonal; `hit`, induction on q).  The
--   sum is then over the subsets of the first p positions (sum-lift), of
--   which only K0 = full has p elements (sum-full).  At K0, B_K0 = Y
--   (selected-lift) and det(B[K0 <- x]) = [X beta] (replace-lift).
-- * For subsets I, J of size p, take x, y the generators of e_I, e_J
--   (basis-product, transported to length p): [e_J beta] w_I =
--   [e_I beta] w_J.  If |I| is not p, then w_I = 0 (degree of w) and
--   [e_I beta] = 0 (degree |I| + q is not n); the same for J.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ; module H = ExteriorHomogeneous[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module DU = ExteriorDuality[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module HO = H.Over[Rg,setR] ;
 module RP = ExteriorReplacement[l].Over[Rg,setR] ;
 module PS = ExteriorPluckerSylvester[l].Over[Rg,setR] ;
 module AL = Alternating[l].Over[Rg,setR] ;
 module CB = ColumnBlocks[l].Over[Rg,setR] ;

 -- beta* and proportionality
 bstar (n : Nat) (beta : Ext n) : Ext n = CO.tab n (\ I -> top n (emul n (CO.basis n I) beta)) ;
 bstar-coeff (n : Nat) (beta : Ext n) (I : C.Index n) :
  Id R (CO.coeff n (bstar n beta) I) (top n (emul n (CO.basis n I) beta)) =
  CO.coeff-tab n (\ J -> top n (emul n (CO.basis n J) beta)) I ;
 opaque bstar ;
 Proportional (n : Nat) (a b : Ext n) : U l =
  (I J : C.Index n) -> Id R (mul (CO.coeff n a I) (CO.coeff n b J)) (mul (CO.coeff n a J) (CO.coeff n b I)) ;

 -- the products B_K meeting the v positions are orthogonal to w
 module Orth (n p : Nat) (y : Ps.Fin p -> AL.Vec n) (w : Ext n) {
  module L81 = Lemma81[l].Over[Rg,setR,n] ;
  module BL = CB.Blocks[n,p,y] ;
  hit : (q : Nat) (v : Ps.Fin q -> AL.Vec n) -> ((k : Ps.Fin q) -> L81.Killed (v k) w) ->
   (K : C.Index (plus q p)) -> BL.LP.Hit q K -> Id R (DU.dot n w (BL.PR.selected-product (plus q p) K (BL.concat q v))) z = split {
   zero -> \ v hv K h -> efq h ;
   suc q | r -> \ v hv -> split {
    inl K -> \ h -> trans (ap (DU.dot n w) (BL.PR.product-inl (plus q p) K (BL.concat (suc q) v)))
     (r (\ j -> v (inl j)) (\ j -> hv (inl j)) K h) ;
    inr K -> \ h -> trans (ap (DU.dot n w) (BL.PR.product-inr (plus q p) K (BL.concat (suc q) v)))
     (L81.right-orthogonal (v (inr tt)) w (hv (inr tt))
      (BL.PR.selected-product (plus q p) K (\ j -> BL.concat (suc q) v (inl j)))) } } ;
 } ;

 module Exchange (q p : Nat) (v : Ps.Fin q -> AL.Vec (plus q p)) (y x : Ps.Fin p -> AL.Vec (plus q p))
  (w : Ext (plus q p)) (hv : (k : Ps.Fin q) -> Lemma81[l].Over[Rg,setR,plus q p].Killed (v k) w) {
  module OR = Orth[plus q p,p,y,w] ;
  module BL = OR.BL ;
  module PA = PS.At[plus q p,p,x,BL.concat q v] ;
  module RA = RP.At[plus q p] ;
  module DW = C.SumMap[Ext (plus q p),R,eadd (plus q p),add,DU.dot (plus q p) w,DU.dot-add (plus q p) w] ;
  beta : Ext (plus q p) = eprod (plus q p) q (\ k -> gen (plus q p) (v k)) ;
  -- a term of the Cramer sum, paired with w
  Dec (K : C.Index (plus q p)) : U l = Plus (Id Nat (BA.count (plus q p) K) p) (Not (Id Nat (BA.count (plus q p) K) p)) ;
  f (K : C.Index (plus q p)) : R =
   DU.dot (plus q p) w (PA.S.term PA.summand K (H.DecNat.dec (BA.count (plus q p) K) p)) ;
  term-dot (K : C.Index (plus q p)) (e : Id Nat (BA.count (plus q p) K) p) :
   Id R (DU.dot (plus q p) w (PA.summand K e))
    (mul (PA.replacement-determinant K e) (DU.dot (plus q p) w (BL.PR.selected-product (plus q p) K (BL.concat q v)))) =
   trans (DU.dot-scale (plus q p) (PA.replacement-determinant K e) w (RA.product K (BL.concat q v)))
    (ap (\ t -> mul (PA.replacement-determinant K e) (DU.dot (plus q p) w t)) (RA.product-value K (BL.concat q v))) ;
  zero-hit (K : C.Index (plus q p)) (h : BL.LP.Hit q K) : (d : Dec K) ->
   Id R (DU.dot (plus q p) w (PA.S.term PA.summand K d)) z = split {
   inl e -> trans (ap (DU.dot (plus q p) w) (PA.S.term-yes PA.summand K e))
    (trans (term-dot K e)
     (trans (ap (mul (PA.replacement-determinant K e)) (OR.hit q v hv K h)) (L.mul-zero (PA.replacement-determinant K e)))) ;
   inr ne -> trans (ap (DU.dot (plus q p) w) (PA.S.term-no PA.summand K ne)) (DU.dot-zero (plus q p) w) } ;
  zero-low (K : C.Index p) (lo : BA.Low p (BA.count p K)) : (d : Dec (BL.LP.lift q K)) ->
   Id R (DU.dot (plus q p) w (PA.S.term PA.summand (BL.LP.lift q K) d)) z = split {
   inl e -> efq (CB.low-irrefl p (subst (\ c -> BA.Low p c) (trans (sym (BL.LP.count-lift q K)) e) lo)) ;
   inr ne -> trans (ap (DU.dot (plus q p) w) (PA.S.term-no PA.summand (BL.LP.lift q K) ne)) (DU.dot-zero (plus q p) w) } ;
  -- the first p positions
  count-first : Id Nat (BA.count (plus q p) (BL.LP.lift q (BA.full p))) p =
   trans (BL.LP.count-lift q (BA.full p)) (CB.count-full p) ;
  first-determinant (e : Id Nat (BA.count (plus q p) (BL.LP.lift q (BA.full p))) p) :
   Id R (PA.replacement-determinant (BL.LP.lift q (BA.full p)) e) (top (plus q p) (emul (plus q p) PA.a-product beta)) =
   ap (top (plus q p))
    (trans (BL.replace-lift q v (PA.subset-a (BL.LP.lift q (BA.full p)) e))
     (ap (\ t -> emul (plus q p) t beta) (PA.subset-a-product (BL.LP.lift q (BA.full p)) e))) ;
  at-first : (d : Dec (BL.LP.lift q (BA.full p))) ->
   Id R (DU.dot (plus q p) w (PA.S.term PA.summand (BL.LP.lift q (BA.full p)) d))
    (mul (top (plus q p) (emul (plus q p) PA.a-product beta)) (DU.dot (plus q p) w BL.y-product)) = split {
   inl e -> calc R {
    DU.dot (plus q p) w (PA.S.term PA.summand (BL.LP.lift q (BA.full p)) (inl e))
     =< ap (DU.dot (plus q p) w) (PA.S.term-yes PA.summand (BL.LP.lift q (BA.full p)) e)
     > DU.dot (plus q p) w (PA.summand (BL.LP.lift q (BA.full p)) e)
     =< term-dot (BL.LP.lift q (BA.full p)) e
     > mul (PA.replacement-determinant (BL.LP.lift q (BA.full p)) e)
        (DU.dot (plus q p) w (BL.PR.selected-product (plus q p) (BL.LP.lift q (BA.full p)) (BL.concat q v)))
     =< Ps.cong2 R mul _ _ _ _ (first-determinant e) (ap (DU.dot (plus q p) w) (BL.selected-lift q v))
     > mul (top (plus q p) (emul (plus q p) PA.a-product beta)) (DU.dot (plus q p) w BL.y-product) } ;
   inr ne -> efq (ne count-first) } ;
  exchange : Id R (mul (top (plus q p) (emul (plus q p) BL.y-product beta)) (DU.dot (plus q p) w PA.a-product))
   (mul (top (plus q p) (emul (plus q p) PA.a-product beta)) (DU.dot (plus q p) w BL.y-product)) = calc R {
   mul (top (plus q p) (emul (plus q p) BL.y-product beta)) (DU.dot (plus q p) w PA.a-product)
    =< ap (\ d -> mul d (DU.dot (plus q p) w PA.a-product)) (sym (ap (top (plus q p)) (BL.concat-product q v)))
    > mul (det (plus q p) (BL.concat q v)) (DU.dot (plus q p) w PA.a-product)
    =< sym (DU.dot-scale (plus q p) (det (plus q p) (BL.concat q v)) w PA.a-product)
    > DU.dot (plus q p) w (escale (plus q p) (det (plus q p) (BL.concat q v)) PA.a-product)
    =< ap (DU.dot (plus q p) w) (trans PA.cramer (PA.S.value-equation PA.summand))
    > DU.dot (plus q p) w (PA.ES.sum (plus q p) (\ K -> PA.S.term PA.summand K (H.DecNat.dec (BA.count (plus q p) K) p)))
    =< DW.map (plus q p) (\ K -> PA.S.term PA.summand K (H.DecNat.dec (BA.count (plus q p) K) p))
    > CO.S.sum (plus q p) f
    =< BL.LP.sum-lift q f (\ K h -> zero-hit K h (H.DecNat.dec (BA.count (plus q p) K) p))
    > CO.S.sum p (\ K -> f (BL.LP.lift q K))
    =< CB.sum-full p (\ K -> f (BL.LP.lift q K))
        (\ K lo -> zero-low K lo (H.DecNat.dec (BA.count (plus q p) (BL.LP.lift q K)) p))
    > f (BL.LP.lift q (BA.full p))
    =< at-first (H.DecNat.dec (BA.count (plus q p) (BL.LP.lift q (BA.full p))) p)
    > mul (top (plus q p) (emul (plus q p) PA.a-product beta)) (DU.dot (plus q p) w BL.y-product) } ;
 } ;

 -- Lemma 8.2 for any w of degree p killed by v_1, ..., v_q
 module Killed82 (q p : Nat) (v : Ps.Fin q -> AL.Vec (plus q p)) (w : Ext (plus q p)) (dw : DG.Deg (plus q p) p w)
  (hv : (k : Ps.Fin q) -> Lemma81[l].Over[Rg,setR,plus q p].Killed (v k) w) {
  beta : Ext (plus q p) = eprod (plus q p) q (\ k -> gen (plus q p) (v k)) ;
  beta-degree : DG.Deg (plus q p) q beta = DG.deg-eprod (plus q p) q (\ k -> gen (plus q p) (v k)) (\ k -> DG.deg-gen (plus q p) (v k)) ;
  Dec (I : C.Index (plus q p)) : U l = Plus (Id Nat (BA.count (plus q p) I) p) (Not (Id Nat (BA.count (plus q p) I) p)) ;
  Goal (I J : C.Index (plus q p)) : U l =
   Id R (mul (CO.coeff (plus q p) w I) (top (plus q p) (emul (plus q p) (CO.basis (plus q p) J) beta)))
    (mul (CO.coeff (plus q p) w J) (top (plus q p) (emul (plus q p) (CO.basis (plus q p) I) beta))) ;
  -- the generators of e_I, as a list of length p
  generators (I : C.Index (plus q p)) (e : Id Nat (BA.count (plus q p) I) p) : Ps.Fin p -> AL.Vec (plus q p) =
   PS.transport-list (plus q p) (BA.count (plus q p) I) p e (BA.select (plus q p) I) ;
  generators-product (I : C.Index (plus q p)) (e : Id Nat (BA.count (plus q p) I) p) :
   Id (Ext (plus q p)) (eprod (plus q p) p (\ k -> gen (plus q p) (generators I e k))) (CO.basis (plus q p) I) =
   trans (PS.product-transport (plus q p) (BA.count (plus q p) I) (BA.select (plus q p) I) p e) (sym (BA.basis-product (plus q p) I)) ;
  both (I J : C.Index (plus q p)) (eI : Id Nat (BA.count (plus q p) I) p) (eJ : Id Nat (BA.count (plus q p) J) p) : Goal I J = calc R {
   mul (CO.coeff (plus q p) w I) (top (plus q p) (emul (plus q p) (CO.basis (plus q p) J) beta))
    =< mulC (CO.coeff (plus q p) w I) (top (plus q p) (emul (plus q p) (CO.basis (plus q p) J) beta))
    > mul (top (plus q p) (emul (plus q p) (CO.basis (plus q p) J) beta)) (CO.coeff (plus q p) w I)
    =< sym (Ps.cong2 R mul _ _ _ _ (ap (\ t -> top (plus q p) (emul (plus q p) t beta)) (generators-product J eJ))
        (trans (ap (DU.dot (plus q p) w) (generators-product I eI)) (CO.dot-basis (plus q p) w I)))
    > mul (top (plus q p) (emul (plus q p) (eprod (plus q p) p (\ k -> gen (plus q p) (generators J eJ k))) beta)) (DU.dot (plus q p) w (eprod (plus q p) p (\ k -> gen (plus q p) (generators I eI k))))
    =< Exchange[q,p,v,generators J eJ,generators I eI,w,hv].exchange
    > mul (top (plus q p) (emul (plus q p) (eprod (plus q p) p (\ k -> gen (plus q p) (generators I eI k))) beta)) (DU.dot (plus q p) w (eprod (plus q p) p (\ k -> gen (plus q p) (generators J eJ k))))
    =< Ps.cong2 R mul _ _ _ _ (ap (\ t -> top (plus q p) (emul (plus q p) t beta)) (generators-product I eI))
        (trans (ap (DU.dot (plus q p) w) (generators-product J eJ)) (CO.dot-basis (plus q p) w J))
    > mul (top (plus q p) (emul (plus q p) (CO.basis (plus q p) I) beta)) (CO.coeff (plus q p) w J)
    =< mulC (top (plus q p) (emul (plus q p) (CO.basis (plus q p) I) beta)) (CO.coeff (plus q p) w J)
    > mul (CO.coeff (plus q p) w J) (top (plus q p) (emul (plus q p) (CO.basis (plus q p) I) beta)) } ;
  -- |I| is not p: [e_I beta] = 0 (degree |I| + q is not q + p) and w_I = 0
  top-vanish (I : C.Index (plus q p)) (ne : Not (Id Nat (BA.count (plus q p) I) p)) : Id R (top (plus q p) (emul (plus q p) (CO.basis (plus q p) I) beta)) z =
   HO.top-product-vanish (plus q p) (BA.count (plus q p) I) q (CO.basis (plus q p) I) beta (BA.basis-degree (plus q p) I) beta-degree
    (\ e -> ne (H.plus-cancel-right (BA.count (plus q p) I) p q (trans e (plus-comm q p)))) ;
  vanish-left (I : C.Index (plus q p)) (ne : Not (Id Nat (BA.count (plus q p) I) p)) (J : C.Index (plus q p)) : Goal I J =
   trans (trans (ap (\ c -> mul c (top (plus q p) (emul (plus q p) (CO.basis (plus q p) J) beta))) (HO.coeff-support (plus q p) p w dw I ne))
     (L.zero-mul (top (plus q p) (emul (plus q p) (CO.basis (plus q p) J) beta))))
    (sym (trans (ap (mul (CO.coeff (plus q p) w J)) (top-vanish I ne)) (L.mul-zero (CO.coeff (plus q p) w J)))) ;
  vanish-right (I J : C.Index (plus q p)) (ne : Not (Id Nat (BA.count (plus q p) J) p)) : Goal I J =
   trans (trans (ap (mul (CO.coeff (plus q p) w I)) (top-vanish J ne)) (L.mul-zero (CO.coeff (plus q p) w I)))
    (sym (trans (ap (\ c -> mul c (top (plus q p) (emul (plus q p) (CO.basis (plus q p) I) beta))) (HO.coeff-support (plus q p) p w dw J ne))
     (L.zero-mul (top (plus q p) (emul (plus q p) (CO.basis (plus q p) I) beta))))) ;
  cases (I J : C.Index (plus q p)) : Dec I -> Dec J -> Goal I J = split {
   inl eI -> split { inl eJ -> both I J eI eJ ; inr ne -> vanish-right I J ne } ;
   inr ne -> \ dJ -> vanish-left I ne J } ;
  result : Proportional (plus q p) w (bstar (plus q p) beta) = \ I J ->
   trans (ap (mul (CO.coeff (plus q p) w I)) (bstar-coeff (plus q p) beta J))
    (trans (cases I J (H.DecNat.dec (BA.count (plus q p) I) p) (H.DecNat.dec (BA.count (plus q p) J) p))
     (sym (ap (mul (CO.coeff (plus q p) w J)) (bstar-coeff (plus q p) beta I)))) ;
 } ;

 -- Lemma 8.2: u_1..u_p orthogonal to v_1..v_q in R^(q+p)
 module L82 (q p : Nat) {
  module L81 = Lemma81[l].Over[Rg,setR,plus q p] ;
  lemma82 (u : MM.Mat p (plus q p)) (v : MM.Mat q (plus q p)) (orth : (k : Ps.Fin q) -> L81.Orthogonal p (v k) u) :
   Proportional (plus q p) (MM.wedge p (plus q p) u) (bstar (plus q p) (MM.wedge q (plus q p) v)) =
   Killed82[q,p,v,MM.wedge p (plus q p) u,DG.deg-eprod (plus q p) p (\ k -> gen (plus q p) (u k)) (\ k -> DG.deg-gen (plus q p) (u k)),
    \ k -> L81.killed p (v k) u (orth k)].result ;
 } ;
} ;
