-- cffr Theorem 8.7: the Cayley determinant of the complex (*) is a
-- greatest common divisor of the r_1 x r_1 minors of A_1 (and regular).
-- In Cor85's indexing the last map is M (T+1) : R^(d (T+1)) -> R^(d (T+2));
-- (*) asks F_0 = R^(r_1), i.e. rk (T+1) = d (T+2) (ed).  Then gamma, the
-- last beta (beta_1 of the paper), has top degree, so gamma = det omega
-- with det = [beta_1] (the Cayley determinant), and each minor of
-- M (T+1) on a tuple c and a subset J is h_c det omega_J (Cor85.Final).
-- Lemma 8.6 applies with b(c, J) = h_c omega_J: Gr(b) >= 2 since b
-- contains h (J = the full subset, omega_full = 1) and Gr(h) >= 2
-- (Lemma84.Enlarge).
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module C = ExteriorCoordinates[l] ;
module Over (Rg : CRing) (setR : Pr.isSet Rg.R) {
 open Rg ; module L = RL[Rg] ;
 open ExteriorModel[l].Over[Rg] ;
 module MM = Matrices[l].Over[Rg] ;
 module MI = Minors[l].Over[Rg,setR] ;
 module DG = ExteriorDegree[l].Over[Rg,setR] ;
 module CO = C.Over[Rg,setR] ;
 module BA = ExteriorBasis[l].Over[Rg,setR] ;
 module L84 = Lemma84[l].Over[Rg,setR] ;
 module C85 = Cor85[l].Over[Rg,setR] ;
 module L86 = Lemma86[l].Over[Rg,setR] ;
 -- omega has coefficient 1 at the full subset
 coeff-full : (n : Nat) (x : Ext n) -> Id R (CO.coeff n x (BA.full n)) (top n x) = split {
  zero -> \ x -> refl x ; suc n | r -> \ x -> r x.2 } ;
 omega-full (n : Nat) : Id R (CO.coeff n (DG.omega n) (BA.full n)) o = trans (coeff-full n (DG.omega n)) (DG.top-omega n) ;

 -- Theorem 8.7
 module Thm87 (s : Nat -> Nat) {
  module CH = C85.Chain[s] ;
  module Res (T : Nat) (d : Nat -> Nat) (M : (t : Nat) -> MM.Mat (d t) (d (suc t)))
   (hd : (t : Nat) -> C85.lt t (suc T) -> Id Nat (plus (CH.rk (suc t)) (CH.rk t)) (d (suc t)))
   (cz : (t : Nat) -> C85.lt t (suc T) -> MM.ComposeZero (d t) (d (suc t)) (d (suc (suc t))) (M t) (M (suc t)))
   (gm : (t : Nat) -> C85.lt (suc t) (suc T) ->
    L84.GrTwo (MI.Index (CH.rk (suc t)) (d (suc t)) (d (suc (suc t)))) (MI.minors (CH.rk (suc t)) (d (suc t)) (d (suc (suc t))) (M (suc t))))
   (rg : MI.RegularD (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T)))
   (ed : Id Nat (CH.rk (suc T)) (d (suc (suc T)))) {
   module RS = CH.Res[T,d,M,hd,cz,gm] ;
   module FI = C85.Fi[CH.rk (suc T),d (suc T),d (suc (suc T)),M (suc T),RS.final rg] ;
   -- F_0 = R^(r_1): gamma has top degree, gamma = det omega
   top-degree : DG.Deg (d (suc (suc T))) (d (suc (suc T))) FI.gamma =
    subst (\ k -> DG.Deg (d (suc (suc T))) k FI.gamma) ed FI.gamma-degree ;
   -- the Cayley determinant [beta_1]
   det : R = top (d (suc (suc T))) FI.gamma ;
   gamma-value : Id (Ext (d (suc (suc T)))) FI.gamma (escale (d (suc (suc T))) det (DG.omega (d (suc (suc T))))) =
    DG.deg-top (d (suc (suc T))) FI.gamma top-degree ;
   -- b(c, J) = h_c omega_J has Gr >= 2
   b (m : MI.Index (CH.rk (suc T)) (d (suc T)) (d (suc (suc T)))) : R =
    mul (FI.h m.1) (CO.coeff (d (suc (suc T))) (DG.omega (d (suc (suc T)))) m.2) ;
   b-full (c : Ps.Fin (CH.rk (suc T)) -> Ps.Fin (d (suc T))) : Id R (b (c,BA.full (d (suc (suc T))))) (FI.h c) =
    trans (ap (mul (FI.h c)) (omega-full (d (suc (suc T))))) (mulO (FI.h c)) ;
   b-grade : L84.GrTwo (MI.Index (CH.rk (suc T)) (d (suc T)) (d (suc (suc T)))) b =
    L84.Enlarge[Ps.Fin (CH.rk (suc T)) -> Ps.Fin (d (suc T)),MI.Index (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))),FI.h,b,FI.h-grade,
     \ c -> inl ((c,BA.full (d (suc (suc T)))),b-full c)].result ;
   -- each minor of the last map is det b(c, J)
   minor-value (m : MI.Index (CH.rk (suc T)) (d (suc T)) (d (suc (suc T)))) :
    Id R (MI.minors (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T)) m) (mul det (b m)) = calc R {
    MI.minors (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T)) m
     =< FI.minor-value m > mul (FI.h m.1) (CO.coeff (d (suc (suc T))) FI.gamma m.2)
     =< ap (mul (FI.h m.1)) (trans (ap (\ w -> CO.coeff (d (suc (suc T))) w m.2) gamma-value)
         (CO.coeff-scale (d (suc (suc T))) det (DG.omega (d (suc (suc T)))) m.2))
     > mul (FI.h m.1) (mul det (CO.coeff (d (suc (suc T))) (DG.omega (d (suc (suc T)))) m.2))
     =< L.mul-swap (FI.h m.1) det (CO.coeff (d (suc (suc T))) (DG.omega (d (suc (suc T)))) m.2) > mul det (b m) } ;
   module LG = L86.Lemma86[MI.Index (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))),
    MI.minors (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T)),b,det,minor-value,rg,b-grade] ;
   -- Theorem 8.7
   theorem87 : L86.Gcd (MI.Index (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))))
    (MI.minors (CH.rk (suc T)) (d (suc T)) (d (suc (suc T))) (M (suc T))) det = LG.result ;
   det-regular : L86.RegularElement det = LG.g-regular ;
  } ;
 } ;
} ;
