-- Algebra-free powers of an endomorphism and raising a denominator.
level l ; open Ring[l] ;
module CB = CoefficientBound[l] ;
plus-zero : (n : Nat) -> Id Nat (plus n zero) n = split {
 zero -> refl zero ; suc n | ih -> ap (\ k -> suc k) ih } ;
plus-suc : (n k : Nat) -> Id Nat (plus n (suc k)) (suc (plus n k)) = split {
 zero -> \ k -> refl (suc k) ; suc n | ih -> \ k -> ap (\ k -> suc k) (ih k) } ;
plus-comm : (n k : Nat) -> Id Nat (plus n k) (plus k n) = split {
 zero -> \ k -> sym (plus-zero k) ;
 suc n | ih -> \ k -> trans (ap (\ k -> suc k) (ih k)) (sym (plus-suc k n)) } ;
excess : (n N : Nat) -> CB.le n N -> Nat = split {
 zero -> \ N h -> N ;
 suc n | ih -> split { zero -> \ h -> efq h ; suc N -> \ h -> ih N h } } ;
excess-law : (n N : Nat) (h : CB.le n N) -> Id Nat (plus (excess n N h) n) N = split {
 zero -> \ N h -> plus-zero N ;
 suc n | ih -> split {
  zero -> \ h -> efq h ;
  suc N -> \ h -> trans (plus-suc (excess n N h) n) (ap (\ k -> suc k) (ih N h)) } } ;
module On (M : U l) (step : M -> M) {
 power : Nat -> M -> M = split {
  zero -> \ m -> m ; suc n | ih -> \ m -> step (ih m) } ;
 power-add : (n k : Nat) (m : M) -> Id M (power (plus n k) m) (power n (power k m)) = split {
  zero -> \ k m -> refl (power k m) ;
  suc n | ih -> \ k m -> ap step (ih k m) } ;
 power-comm (n k : Nat) (m : M) : Id M (power n (power k m)) (power k (power n m)) =
  trans (sym (power-add n k m))
   (trans (ap (\ j -> power j m) (plus-comm n k)) (power-add k n m)) ;
 raise-equality (u v : M) (n N : Nat) (h : CB.le n N)
  (p : Id M (power n u) (power n v)) : Id M (power N u) (power N v) =
  let {
   d : Nat = excess n N h ;
   left (m : M) : Id M (power N m) (power d (power n m)) =
    trans (ap (\ k -> power k m) (sym (excess-law n N h))) (power-add d n m) ;
  } in trans (left u) (trans (ap (power d) p) (sym (left v))) ;
} ;
