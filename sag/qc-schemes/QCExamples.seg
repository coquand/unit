-- Boundary tests: empty schemes and the necessity of positive exponents.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module S = Schemes[l].Over[R,setR] ;
 module RE = Restriction718[l].Over[R,setR,axioms] ;
 module Fr = MD.Fractions[MD.regular] ;
 zero-kills-after-one : Fr.Kills R.z R.o (suc zero) =
  trans (R.mulO (R.mul R.z R.o)) (R.mulO R.z) ;
 zero-does-not-kill-immediately (p : Fr.Kills R.z R.o zero) : Empty =
  axioms.loc.1 (trans (sym (R.mulO R.o)) p) ;
 #fails {
  false-zero-exponent : Fr.Kills R.z R.o zero = refl R.z ;
 } ;
 empty-bundle : MD.WqcBundle Empty (\ x -> MD.regular) = \ x -> efq x ;
 empty-restriction : MD.Restriction Empty (\ x -> MD.regular) =
  RE.At[Empty,SB.empty,\ x -> MD.regular,empty-bundle].theorem-7-1-8 ;
 module AnyScheme (X : U l) (scheme : S.Scheme X) (Mx : X -> MD.Module)
  (w : MD.WqcBundle X Mx) {
  on-empty-open : MD.Restriction (X * Empty) (\ y -> Mx y.1) =
   RE.Open[X,scheme,Mx,w,\ x -> Empty,\ x -> OpenOps[l].Over[R,setR].open-empty].theorem ;
 } ;
 -- A fraction system in which equality requires one step: step sends everything
 -- to zero, and all fractions have the same value. This tests denominator raising.
 module F = FractionSections[l].Over[R,setR,axioms].At[Top,SB.top,
  \ x -> R.R,\ x -> setR,\ x m -> R.z,
  \ x -> Top,\ x -> Pr.prop-to-set Top FinSum[l].top-prop,\ x m k -> tt] ;
 module Laws = F.Laws[
  \ x d k m -> refl tt,
  \ x k u v p -> Tr.Trunc[(e : Nat) * Id R.R
   (Iterates[l].On[R.R,\ m -> R.z].power e u)
   (Iterates[l].On[R.R,\ m -> R.z].power e v)].inc (suc zero,refl R.z)] ;
 common-numerator : Tr.Trunc[Laws.Section[\ x -> tt].Goal].carrier =
  Laws.Section[\ x -> tt].theorem
   (\ x -> Tr.Trunc[Laws.Section[\ x -> tt].Rep x].inc (zero,R.o,refl tt)) ;
 uniform-fraction-equality : Tr.Trunc[Laws.Equal[\ x -> R.o,\ x -> R.z,zero,zero,\ x -> refl tt].Goal].carrier =
  Laws.Equal[\ x -> R.o,\ x -> R.z,zero,zero,\ x -> refl tt].theorem ;
 #fails {
  -- Equal fractions do not imply equal numerators before scaling.
  false-numerator-equality : Id R.R R.o R.z = refl R.o ;
 } ;
} ;
