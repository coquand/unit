-- R is weakly quasi-coherent. Use SQC for R_g and its fraction/kernel laws.
-- No module localization or tensor product is constructed.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module NF = NatFin[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module RB = RingBridge[l].Over[R,setR] ;
 module SC = BundleOperations[l].Over[R,setR,axioms].Scalar[MD.regular] ;
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module RF = LocalizationFractions[l].Over[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 module Pt = Affine[l].PtL[MD.ring,MD.regular] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module Local (g : R.R) (loc : I.LocalizationWitness C.base g) {
  L : C.Algebra = loc.1 ;
  inc : C.Hom C.base L = loc.2.2.1 ;
  unit-at (x : C.Spec L) : MD.RA.unit g =
   Pr.subst R.R RL[R].unit _ g ((C.compose C.base L C.base x inc).2 g)
    (AffineRing[l].unit-map L.ring R x.1 (inc.1.1 g) loc.2.2.2.1) ;
  point (d : MD.RA.unit g) : C.Spec L =
   (loc.2.2.2.2 C.base).sec (C.identity C.base,d) ;
  beta (d : MD.RA.unit g) (a : R.R) : Id R.R ((point d).1.1 (inc.1.1 a)) a =
   ap (\ v -> v.1.1.1 a) ((loc.2.2.2.2 C.base).sec-eq (C.identity C.base,d)) ;
  module Represent (s : MD.RA.unit g -> R.R) {
   values (x : C.Spec L) : R.R = s (unit-at x) ;
   a : L.ring.R = (axioms.sqc L loc.2.1).sec values ;
   at-point (d : MD.RA.unit g) : Id R.R ((point d).1.1 a) (s d) =
    trans (ap (\ h -> h (point d)) ((axioms.sqc L loc.2.1).sec-eq values))
     (ap s (RR.unit-prop g (unit-at (point d)) d)) ;
   module Fraction (w : RF.Form C.base g loc a) {
    b : R.R = w.1 ;
    n : Nat = w.2.1 ;
    numerator (d : MD.RA.unit g) : Id R.R b (R.mul (MD.RA.pw g (NF.toN n)) (s d)) =
     trans (sym (beta d b))
      (trans (ap (point d).1.1 w.2.2)
       (trans ((point d).1.2.2.2 (AffinePowers[l].Over[L.ring].power (inc.1.1 g) n) a)
        (trans (ap (\ r -> R.mul r ((point d).1.1 a))
         (trans (AffinePowers[l].power-map L.ring R (point d).1 (inc.1.1 g) n)
          (trans (ap (\ r -> Pow.power r n) (beta d g)) (sym (RB.power g n)))))
         (ap (R.mul (MD.RA.pw g (NF.toN n))) (at-point d))))) ;
    result : SC.Rep g s = (b,NF.toN n,\ d ->
     trans (sym (Pt.cancel-pw g d.1 d.2 (NF.toN n) (s d)))
      (ap (R.mul (MD.RA.pw d.1 (NF.toN n))) (sym (numerator d)))) ;
   } ;
   theorem : Tr.Trunc[SC.Rep g s].carrier =
    Tr.Trunc[RF.Form C.base g loc a].induction @l
     (\ z -> Tr.Trunc[SC.Rep g s].carrier) (\ z -> Tr.Trunc[SC.Rep g s].proposition)
     (\ w -> Tr.Trunc[SC.Rep g s].inc Fraction[w].result)
     (RF.fractions C.base BasePresentation[l].Over[R,setR].finitely-presented g loc a) ;
  } ;
  module Killed (m : R.R) (v : MD.RA.unit g -> Id R.R m R.z) {
   module Kernel = LocalizationKernel[l].Over[R,setR].At[C.base,L,g,inc,loc.2.2.2] ;
   in-localization : Id L.ring.R (inc.1.1 m) L.ring.z =
    Equivalences[l].injective L.ring.R (C.Spec L -> R.R) (C.evaluation L) (axioms.sqc L loc.2.1) _ _
     (F.funext (C.Spec L) (\ x -> R.R) _ _ (\ x ->
      trans ((C.compose C.base L C.base x inc).2 m)
       (trans (v (unit-at x)) (sym (RingHom[l].zero L.ring R x.1))))) ;
   theorem : Tr.Trunc[SC.Kill g m].carrier =
    Tr.Trunc[Kernel.Witness m].induction @l
     (\ z -> Tr.Trunc[SC.Kill g m].carrier) (\ z -> Tr.Trunc[SC.Kill g m].proposition)
     (\ w -> Tr.Trunc[SC.Kill g m].inc
      (NF.toN w.1,trans (ap (\ r -> R.mul r m) (RB.power g w.1)) w.2))
     (Kernel.clear m in-localization) ;
  } ;
 } ;
 represent (g : R.R) (s : MD.RA.unit g -> R.R) : Tr.Trunc[SC.Rep g s].carrier =
  Tr1.Trunc[I.LocalizationWitness C.base g].induction @l
   (\ z -> Tr.Trunc[SC.Rep g s].carrier) (\ z -> Tr.Trunc[SC.Rep g s].proposition)
   (\ loc -> Local[g,loc].Represent[s].theorem)
   (I.localize C.base BasePresentation[l].Over[R,setR].finitely-presented g) ;
 killed (g m : R.R) (v : MD.RA.unit g -> Id R.R m R.z) : Tr.Trunc[SC.Kill g m].carrier =
  Tr1.Trunc[I.LocalizationWitness C.base g].induction @l
   (\ z -> Tr.Trunc[SC.Kill g m].carrier) (\ z -> Tr.Trunc[SC.Kill g m].proposition)
   (\ loc -> Local[g,loc].Killed[m,v].theorem)
   (I.localize C.base BasePresentation[l].Over[R,setR].finitely-presented g) ;
 theorem : MD.WeaklyQC MD.regular = SC.Clauses[represent,killed].theorem ;
} ;
