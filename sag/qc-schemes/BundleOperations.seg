-- SAG 7.1.10--12. Sections over ANY scheme preserve weak quasi-coherence.
-- This scheme version is needed for direct images, whose fibres need not be affine.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module S = Schemes[l].Over[R,setR] ;
 module RA = MD.RA ;
 -- Remove the harmless Top-indexing in Modules.WeaklyQC.
 module Scalar (M : MD.Module) {
  Rep (g : R.R) (s : RA.unit g -> M.M) : U l =
   (m : M.M) * (n : Base.Nat) *
    ((d : RA.unit g) -> Id M.M (s d) (M.sm (RA.pw d.1 n) m)) ;
  Kill (g : R.R) (m : M.M) : U l =
   (n : Base.Nat) * Id M.M (M.sm (RA.pw g n) m) M.mz ;
  module Point = Affine[l].Aff[MD.ring,Top,\ t -> M] ;
  module Clauses
   (rep : (g : R.R) (s : RA.unit g -> M.M) -> Tr.Trunc[Rep g s].carrier)
   (kill : (g : R.R) (m : M.M) -> (RA.unit g -> Id M.M m M.mz) -> Tr.Trunc[Kill g m].carrier) {
   represent (g : Top -> R.R) (s : (t : Top) -> RA.unit (g t) -> M.M) :
    Tr.Trunc[Point.Rep g s].carrier =
    Tr.Trunc[Rep (g tt) (s tt)].induction @l
     (\ z -> Tr.Trunc[Point.Rep g s].carrier) (\ z -> Tr.Trunc[Point.Rep g s].proposition)
     (\ a -> Tr.Trunc[Point.Rep g s].inc
      (\ t -> a.1,a.2.1,\ t -> Pr.subst Top
       (\ t -> (d : RA.unit (g t)) -> Id M.M (s t d) (M.sm (RA.pw d.1 a.2.1) a.1))
       tt t (FinSum[l].top-prop tt t) a.2.2)) (rep (g tt) (s tt)) ;
   killed (g : Top -> R.R) (m : Top -> M.M)
    (v : (t : Top) -> RA.unit (g t) -> Id M.M (m t) M.mz) : Tr.Trunc[Point.Kill g m].carrier =
    Tr.Trunc[Kill (g tt) (m tt)].induction @l
     (\ z -> Tr.Trunc[Point.Kill g m].carrier) (\ z -> Tr.Trunc[Point.Kill g m].proposition)
     (\ a -> Tr.Trunc[Point.Kill g m].inc
      (a.1,\ t -> Pr.subst Top
       (\ t -> Id M.M (M.sm (RA.pw (g t) a.1) (m t)) M.mz)
       tt t (FinSum[l].top-prop tt t) a.2)) (kill (g tt) (m tt) (v tt)) ;
   theorem : MD.WeaklyQC M = \ g -> (represent g,killed g) ;
  } ;
 } ;
 module Sections (X : U l) (scheme : S.Scheme X) (Mx : X -> MD.Module)
  (w : MD.WqcBundle X Mx) {
  section-module : MD.Module = MD.pi X Mx ;
  module SC = Scalar[section-module] ;
  module Af = Affine[l].Aff[MD.ring,X,Mx] ;
  restriction : MD.Restriction X Mx =
   Restriction718[l].Over[R,setR,axioms].At[X,scheme,Mx,w].theorem-7-1-8 ;
  represent (g : R.R) (s : RA.unit g -> section-module.M) : Tr.Trunc[SC.Rep g s].carrier =
   Tr.Trunc[Af.Rep (\ x -> g) (\ x d -> s d x)].induction @l
    (\ z -> Tr.Trunc[SC.Rep g s].carrier) (\ z -> Tr.Trunc[SC.Rep g s].proposition)
    (\ a -> Tr.Trunc[SC.Rep g s].inc (a.1,a.2.1,\ d ->
     F.funext X (\ x -> (Mx x).M) _ _ (\ x -> a.2.2 x d)))
    ((restriction (\ x -> g)).1 (\ x d -> s d x)) ;
  killed (g : R.R) (m : section-module.M)
   (v : RA.unit g -> Id section-module.M m section-module.mz) : Tr.Trunc[SC.Kill g m].carrier =
   Tr.Trunc[Af.Kill (\ x -> g) m].induction @l
    (\ z -> Tr.Trunc[SC.Kill g m].carrier) (\ z -> Tr.Trunc[SC.Kill g m].proposition)
    (\ a -> Tr.Trunc[SC.Kill g m].inc (a.1,F.funext X (\ x -> (Mx x).M) _ _ a.2))
    ((restriction (\ x -> g)).2 m (\ x d -> ap (\ h -> h x) (v d))) ;
  theorem-7-1-10 : MD.WeaklyQC section-module = SC.Clauses[represent,killed].theorem ;
 } ;
 -- 7.1.11(a) and 7.1.12(a) need no scheme hypothesis.
 inverse (X Y : U l) (f : X -> Y) (Ny : Y -> MD.Module) : X -> MD.Module = \ x -> Ny (f x) ;
 inverse-qc (X Y : U l) (f : X -> Y) (Ny : Y -> MD.Module)
  (w : MD.WqcBundle Y Ny) : MD.WqcBundle X (inverse X Y f Ny) = \ x -> w (f x) ;
 -- 7.1.11(b): the direct image is the product over the actual fibre.
 direct (X Y : U l) (f : X -> Y) (Mx : X -> MD.Module) : Y -> MD.Module =
  \ y -> MD.pi (SchemeMaps[l].Fiber X Y f y) (\ a -> Mx a.1) ;
 direct-qc (X Y : U l) (sx : S.Scheme X) (sy : S.Scheme Y) (f : X -> Y)
  (Mx : X -> MD.Module) (w : MD.WqcBundle X Mx) : MD.WqcBundle Y (direct X Y f Mx) =
  \ y -> Sections[SchemeMaps[l].Fiber X Y f y,
   SchemePullbacks[l].Over[R,setR,axioms].fibre Y X sy sx f y,
   \ a -> Mx a.1,\ a -> w a.1].theorem-7-1-10 ;
} ;
