-- Weak quasi-coherence transfers backwards along an equivalence preserving
-- zero and scalar multiplication. No module-identity principle is required.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module NF = NatFin[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module MF = ModuleFractions[l].Over[R,setR] ;
 module At (M N : MD.Module) (e : Pr.Equiv M.M N.M)
  (zero-map : Id N.M (e.1 M.mz) N.mz)
  (scalar-map : (r : R.R) (m : M.M) -> Id N.M (e.1 (M.sm r m)) (N.sm r (e.1 m)))
  (w : MD.WeaklyQC N) {
  module SC = BundleOperations[l].Over[R,setR,axioms].Scalar[M] ;
  module W = MF.Single[N,w] ;
  injective (u v : M.M) : Id N.M (e.1 u) (e.1 v) -> Id M.M u v =
   Equivalences[l].injective M.M N.M e.1 e.2 u v ;
  represent (g : R.R) (s : MD.RA.unit g -> M.M) : Tr.Trunc[SC.Rep g s].carrier =
   Tr.Trunc[W.Represent g (\ d -> e.1 (s d))].induction @l
    (\ z -> Tr.Trunc[SC.Rep g s].carrier) (\ z -> Tr.Trunc[SC.Rep g s].proposition)
    (\ a -> Tr.Trunc[SC.Rep g s].inc
     (e.2.sec a.2.1,NF.toN a.1,\ d -> injective _ _
      (trans (sym (a.2.2 d))
       (trans (ap (N.sm (MD.RA.pw d.1 (NF.toN a.1))) (sym (e.2.sec-eq a.2.1)))
        (sym (scalar-map (MD.RA.pw d.1 (NF.toN a.1)) (e.2.sec a.2.1)))))))
    (W.represent g (\ d -> e.1 (s d))) ;
  killed (g : R.R) (m : M.M) (v : MD.RA.unit g -> Id M.M m M.mz) :
   Tr.Trunc[SC.Kill g m].carrier =
   Tr.Trunc[W.Kill g (e.1 m)].induction @l
    (\ z -> Tr.Trunc[SC.Kill g m].carrier) (\ z -> Tr.Trunc[SC.Kill g m].proposition)
    (\ a -> Tr.Trunc[SC.Kill g m].inc
     (NF.toN a.1,injective _ _ (trans (scalar-map (MD.RA.pw g (NF.toN a.1)) m)
      (trans a.2 (sym zero-map)))))
    (W.kill g (e.1 m) (\ d -> trans (ap e.1 (v d)) zero-map)) ;
  theorem : MD.WeaklyQC M = SC.Clauses[represent,killed].theorem ;
 } ;
} ;
