-- The new closure results have no extra quasi-coherence assumptions for R
-- or finitely presented algebras. Direct images use the actual fibres.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module S = Schemes[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module BO = BundleOperations[l].Over[R,setR,axioms] ;
 module AQ = AlgebraQC[l].Over[R,setR,axioms] ;
 module C = Algebras[l].Over[R,setR] ;
 base-algebra-qc : MD.WeaklyQC (AQ.module-structure C.base) =
  AQ.theorem-7-1-9 C.base BasePresentation[l].Over[R,setR].finitely-presented ;
 functions-on-scheme (X : U l) (scheme : S.Scheme X) :
  MD.WeaklyQC (MD.pi X (\ x -> MD.regular)) =
  BO.Sections[X,scheme,\ x -> MD.regular,\ x -> RegularQC[l].Over[R,setR,axioms].theorem].theorem-7-1-10 ;
 empty-map (e : Empty) : Top = efq e ;
 empty-direct : Top -> MD.Module = BO.direct Empty Top empty-map (\ e -> MD.regular) ;
 empty-direct-qc : MD.WqcBundle Top empty-direct =
  BO.direct-qc Empty Top SB.empty SB.top empty-map (\ e -> MD.regular) (\ e -> efq e) ;
 empty-direct-zero (m : (empty-direct tt).M) : Id (empty-direct tt).M m (empty-direct tt).mz =
  F.funext (SchemeMaps[l].Fiber Empty Top empty-map tt) (\ a -> R.R) _ _ (\ a -> efq a.1) ;
 identity-map (t : Top) : Top = t ;
 identity-direct : Top -> MD.Module = BO.direct Top Top identity-map (\ t -> MD.regular) ;
 identity-direct-qc : MD.WqcBundle Top identity-direct =
  BO.direct-qc Top Top SB.top SB.top identity-map (\ t -> MD.regular)
   (\ t -> RegularQC[l].Over[R,setR,axioms].theorem) ;
 one-section : (identity-direct tt).M = \ a -> R.o ;
 identity-nonzero (p : Id (identity-direct tt).M one-section (identity-direct tt).mz) : Empty =
  axioms.loc.1 (ap (\ h -> h (tt,refl tt)) p) ;
 #fails {
  -- Direct image along the identity does not collapse a nonzero module.
  false-direct-zero : Id (identity-direct tt).M one-section (identity-direct tt).mz =
   refl one-section ;
 } ;
 pulled-back-qc : MD.WqcBundle (Top * Top)
  (BO.inverse (Top * Top) Top (\ p -> p.1) (\ t -> MD.regular)) =
  BO.inverse-qc (Top * Top) Top (\ p -> p.1) (\ t -> MD.regular)
   (\ t -> RegularQC[l].Over[R,setR,axioms].theorem) ;
} ;
