-- SAG 7.1.9 via SQC: A = (Spec A -> R) as R-modules.
-- RegularQC supplies R, and the scheme version of 7.1.10 supplies its sections.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module At (A : C.Algebra) {
  module AR = RingBridge[l].Over[A.ring,A.set].RA ;
  scalar (r : R.R) (a : A.ring.R) : A.ring.R = A.ring.mul (A.iota.1 r) a ;
  scalar-assoc (r s : R.R) (a : A.ring.R) :
   Id A.ring.R (scalar r (scalar s a)) (scalar (R.mul r s) a) =
   trans (A.ring.mulA (A.iota.1 r) (A.iota.1 s) a)
    (ap (\ t -> A.ring.mul t a) (sym (A.iota.2.2.2 r s))) ;
  scalar-one (a : A.ring.R) : Id A.ring.R (scalar R.o a) a =
   trans (ap (\ t -> A.ring.mul t a) A.iota.2.1) (AR.ol a) ;
  scalar-add (r s : R.R) (a : A.ring.R) :
   Id A.ring.R (scalar (R.add r s) a) (A.ring.add (scalar r a) (scalar s a)) =
   trans (ap (\ t -> A.ring.mul t a) (A.iota.2.2.1 r s))
    (AR.rdist (A.iota.1 r) (A.iota.1 s) a) ;
  module-structure : MD.Module = new Alg73[l].Mod[MD.ring,
   A.ring.R,A.set,A.ring.z,A.ring.add,A.ring.neg,
   A.ring.addA,A.ring.addC,A.ring.addZ,A.ring.addN,
   scalar,scalar-assoc,scalar-one,\ r -> A.ring.dist (A.iota.1 r),scalar-add] ;
  function-module : MD.Module = MD.pi (C.Spec A) (\ x -> MD.regular) ;
  evaluation-zero : Id function-module.M (C.evaluation A A.ring.z) function-module.mz =
   F.funext (C.Spec A) (\ x -> R.R) _ _ (\ x -> RingHom[l].zero A.ring R x.1) ;
  evaluation-scalar (r : R.R) (a : A.ring.R) :
   Id function-module.M (C.evaluation A (scalar r a)) (function-module.sm r (C.evaluation A a)) =
   F.funext (C.Spec A) (\ x -> R.R) _ _ (\ x ->
    trans (x.1.2.2.2 (A.iota.1 r) a) (ap (\ t -> R.mul t (x.1.1 a)) (x.2 r))) ;
  module Presented (fp : P.FP A) {
   affine : FA.Affine (C.Spec A) =
    Tr1.Trunc[FA.AffineWitness (C.Spec A)].inc (A,fp,Pr.idEquiv (C.Spec A)) ;
   sections-qc : MD.WeaklyQC function-module =
    BundleOperations[l].Over[R,setR,axioms].Sections[C.Spec A,SB.affine (C.Spec A) affine,
     \ x -> MD.regular,\ x -> RegularQC[l].Over[R,setR,axioms].theorem].theorem-7-1-10 ;
   theorem-7-1-9 : MD.WeaklyQC module-structure =
    QCTransport[l].Over[R,setR,axioms].At[module-structure,function-module,
     (C.evaluation A,axioms.sqc A fp),evaluation-zero,evaluation-scalar,sections-qc].theorem ;
  } ;
 } ;
 module-structure (A : C.Algebra) : MD.Module = At[A].module-structure ;
 theorem-7-1-9 (A : C.Algebra) (fp : P.FP A) : MD.WeaklyQC (module-structure A) =
  At[A].Presented[fp].theorem-7-1-9 ;
 bundle (X : U l) (As : X -> C.Algebra) (fp : (x : X) -> P.FP (As x)) :
  MD.WqcBundle X (\ x -> module-structure (As x)) = \ x -> theorem-7-1-9 (As x) (fp x) ;
} ;
