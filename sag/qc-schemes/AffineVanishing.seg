-- SAG 7.3.6 with the paper's fibrewise weak quasi-coherence hypothesis.
-- The former global Restriction hypothesis is discharged by 7.1.8.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module S = Schemes[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Torsors (X : U l) (Mx : X -> MD.Module) (w : MD.WqcBundle X Mx)
  (T : X -> U l)
  (ts : (x : X) -> Torsor[l].TorBase[Affine[l].Aff[MD.ring,X,Mx].ab x].TorStr (T x)) {
  Goal : U l = Tr.Trunc[(x : X) -> T x].carrier ;
  affine (aff : FA.Affine X) : Goal =
   Theorem736[l].Over[R,setR,axioms].Torsors[X,Mx,
    Restriction718[l].Over[R,setR,axioms].At[X,SB.affine X aff,Mx,w].theorem-7-1-8,T,ts].affine aff ;
  small-affine (aff : SA.Affine X) : Goal = affine (SA.to-affine X aff) ;
  presented (A : C.Algebra) (fp : P.FP A) (e : Pr.Equiv X (C.Spec A)) : Goal =
   affine (Tr1.Trunc[FA.AffineWitness X].inc (A,fp,e)) ;
 } ;
} ;
