-- SAG 3.3.1. For finitely presented B and a finitely presented tensor
-- product T = A (x) B, the map
--   T -> (Spec A -> B),   c |-> (phi |-> (phi (x) B)(c))
-- is an equivalence.  As in the paper: SQC for T, Spec T = Spec A * Spec B,
-- currying, SQC for B; the last step uses psi o (phi (x) B) = phi (x) psi.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
module Fn = Functions[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module TO = Tensor[l].Over[R,setR] ;
 module At (A B T : C.Algebra) (c : TO.Coproduct A B T) (ft : P.FP T) (fb : P.FP B) {
  Pts : U l = C.Spec A * C.Spec B ;
  point : C.Hom C.base B = (B.iota,\ r -> refl (B.iota.1 r)) ;
  -- phi (x) B : T -> R (x) B = B
  tensorB (phi : C.Spec A) : C.Hom T B =
   (c.2.2 B).sec (C.compose A C.base B point phi,C.identity B) ;
  map (t : T.ring.R) (phi : C.Spec A) : B.ring.R = (tensorB phi).1.1 t ;
  -- phi (x) psi : T -> R
  pairing (x : Pts) : C.Spec T = (c.2.2 C.base).sec x ;
  -- psi o (phi (x) B) = phi (x) psi
  restricted (x : Pts) :
   Id Pts (TO.restrict A B T c.1 c.2.1 C.base (C.compose T B C.base x.2 (tensorB x.1))) x =
   Pr.trans Pts _ (x.1,(TO.restrict A B T c.1 c.2.1 C.base (C.compose T B C.base x.2 (tensorB x.1))).2) x
    (Pr.ap (C.Spec A) Pts (\ y -> (y,(TO.restrict A B T c.1 c.2.1 C.base (C.compose T B C.base x.2 (tensorB x.1))).2)) _ _
     (C.ext A C.base _ x.1 (\ a ->
      trans (ap x.2.1.1 (ap (\ d -> d.1.1.1 a) ((c.2.2 B).sec-eq (C.compose A C.base B point x.1,C.identity B))))
       (x.2.2 (x.1.1.1 a)))))
    (Pr.ap (C.Spec B) Pts (\ y -> (x.1,y)) _ _
     (C.ext B C.base _ x.2 (\ b ->
      ap x.2.1.1 (ap (\ d -> d.2.1.1 b) ((c.2.2 B).sec-eq (C.compose A C.base B point x.1,C.identity B)))))) ;
  key (x : Pts) : Id (C.Spec T) (C.compose T B C.base x.2 (tensorB x.1)) (pairing x) =
   E.injective (C.Spec T) Pts (TO.restrict A B T c.1 c.2.1 C.base) (c.2.2 C.base) _ _
    (trans (restricted x) (sym ((c.2.2 C.base).sec-eq x))) ;
  -- the two sides of the paper's chain
  ev2 : Pr.Equiv (C.Spec A -> B.ring.R) (Pts -> R.R) =
   E.compose _ _ _ (Fn.post (C.Spec A) B.ring.R (C.Spec B -> R.R) (C.evaluation B,sqc B fb))
    (Fn.uncurry (C.Spec A) (C.Spec B) R.R) ;
  chain : Pr.Equiv T.ring.R (Pts -> R.R) =
   E.compose _ _ _ (C.evaluation T,sqc T ft)
    (Fn.pre Pts (C.Spec T) R.R (Fn.inverse (C.Spec T) Pts (TO.spec-product A B T c))) ;
  agree (t : T.ring.R) : Id (Pts -> R.R) (chain.1 t) (ev2.1 (map t)) =
   F.funext Pts (\ x -> R.R) _ _ (\ x -> sym (ap (\ h -> h.1.1 t) (key x))) ;
  theorem : Pr.isEquiv T.ring.R (C.Spec A -> B.ring.R) map =
   Fn.cancel T.ring.R (C.Spec A -> B.ring.R) (Pts -> R.R) map ev2
    (E.homotopy T.ring.R (Pts -> R.R) chain (\ t -> ev2.1 (map t)) (\ t -> sym (agree t))) ;
 } ;
} ;
