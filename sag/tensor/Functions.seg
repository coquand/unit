-- Equivalences of function types: inverse, pre- and post-composition,
-- currying.
level l ; open Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
inverse (X Y : U l) (e : Equiv X Y) : Equiv Y X =
 (e.2.sec,qinv Y X e.2.sec e.1 (sec-ret X Y e.1 e.2) e.2.sec-eq) ;
pre (X Y Z : U l) (e : Equiv X Y) : Equiv (Y -> Z) (X -> Z) =
 (\ u x -> u (e.1 x),qinv (Y -> Z) (X -> Z) (\ u x -> u (e.1 x)) (\ u y -> u (e.2.sec y))
  (\ u -> F.funext X (\ x -> Z) _ u (\ x -> ap X Z u _ _ (sec-ret X Y e.1 e.2 x)))
  (\ u -> F.funext Y (\ y -> Z) _ u (\ y -> ap Y Z u _ _ (e.2.sec-eq y)))) ;
post (X Y Z : U l) (e : Equiv Y Z) : Equiv (X -> Y) (X -> Z) =
 (\ u x -> e.1 (u x),qinv (X -> Y) (X -> Z) (\ u x -> e.1 (u x)) (\ u x -> e.2.sec (u x))
  (\ u -> F.funext X (\ x -> Z) _ u (\ x -> e.2.sec-eq (u x)))
  (\ u -> F.funext X (\ x -> Y) _ u (\ x -> sec-ret Y Z e.1 e.2 (u x)))) ;
uncurry (X Y Z : U l) : Equiv (X -> Y -> Z) ((X * Y) -> Z) =
 (\ u x -> u x.1 x.2,qinv (X -> Y -> Z) ((X * Y) -> Z) (\ u x -> u x.1 x.2) (\ v x y -> v (x,y))
  (\ v -> refl v) (\ u -> refl u)) ;
-- if g and g o f are equivalences, so is f
cancel (X Y Z : U l) (f : X -> Y) (g : Equiv Y Z) (gf : isEquiv X Z (\ x -> g.1 (f x))) : isEquiv X Y f =
 Equivalences[l].homotopy X Y
  (Equivalences[l].compose X Z Y (\ x -> g.1 (f x),gf) (inverse Y Z g)) f
  (\ x -> sym Y _ _ (sec-ret Y Z g.1 g.2 (f x))) ;
