-- Checked instance: R[X] (x) R[X], built from two copies of the one-variable
-- presentation; its spectrum is Spec R[X] * Spec R[X].
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module TO = Tensor[l].Over[R,setR] ;
 module AV = AddVariable[l].Over[R,setR] ;
 module BP = BasePresentation[l].Over[R,setR] ;
 module RX = C.Polynomial[C.base] ;
 line : Presentations[l].Over[R,setR].Presentation = AV.added BP.empty ;
 line-presents : Presentations[l].Over[R,setR].Presents line RX.algebra =
  AV.Extension[BP.empty,C.base,BP.presentation].presentation ;
 module Plane = TO.Presented[line,line,RX.algebra,RX.algebra,line-presents,line-presents] ;
 plane : Pr.Equiv (C.Spec Plane.T) (C.Spec RX.algebra * C.Spec RX.algebra) =
  TO.spec-product RX.algebra RX.algebra Plane.T Plane.coproduct ;
 two-variables : Id Nat (FinSum[l].Over[R,setR].tensor line line).1 (suc (suc zero)) = refl (suc (suc zero)) ;
} ;
