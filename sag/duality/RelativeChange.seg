-- jonas.pdf Lemma 50 at presentations over A: for u a presentation with
-- coefficients in A, X an A-algebra presented by u and Y a B-algebra
-- presented by u.h, the square
--
--        A ---p---> total X
--        |            | up = h+
--        h            v
--        B ---j---> total Y
--
-- is a pushout of R-algebras.  So P = <u>_{T/A} with p = p_u, and every
-- h has a chosen base change (Y from PresentationExistence over B).
--
-- Informal proof.  up is the map of A-algebras X -> Y|h sending the
-- generators of X to those of Y (Y's generators solve u.h in Y, so u in
-- Y|h, Relative (1)).  It satisfies up p = j h by construction.
-- Given a cocone (r, s, r p = s h) into D, r is a map of A-algebras
-- X -> under D (s h) (Relative (2)); its values on the generators solve
-- u in under D (s h) = (under D s)|h, so u.h in under D s; this gives a
-- map of B-algebras Y -> under D s, hence m : total Y -> D with m j = s.
-- m up = r: both are A-maps out of X agreeing on the generators.
-- Conversely, from m, the cocone (m up, m j) gives back m: both are
-- B-maps out of Y agreeing on the generators.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
open Presentations[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module PO = Pushout[l].Over[R,setR] ;
 module BC = BaseChange[l].Over[R,setR] ;
 module Rel = Relative[l].Over[R,setR] ;
 module At (A B : C.Algebra) (h : C.Hom A B)
  (u : Presentations[l].Over[A.ring,A.set].Presentation)
  (X : Algebras[l].Over[A.ring,A.set].Algebra) (px : Presentations[l].Over[A.ring,A.set].Presents u X)
  (Y : Algebras[l].Over[B.ring,B.set].Algebra)
  (py : Presentations[l].Over[B.ring,B.set].Presents (Relative[l].Along[A.ring,A.set,B.ring,B.set,h.1].change u) Y) {
  module PA = Presentations[l].Over[A.ring,A.set] ;
  module PB = Presentations[l].Over[B.ring,B.set] ;
  module CA = Algebras[l].Over[A.ring,A.set] ;
  module CB = Algebras[l].Over[B.ring,B.set] ;
  module Ch = Relative[l].Along[A.ring,A.set,B.ring,B.set,h.1] ;
  module UA = Rel.Under[A] ;
  module UB = Rel.Under[B] ;
  P : C.Algebra = UA.total X ;
  p : C.Hom A P = UA.structure X ;
  Q : C.Algebra = UB.total Y ;
  j : C.Hom B Q = UB.structure Y ;
  -- h+
  hat : CA.Hom X (UA.under Q (C.compose A B Q j h)) =
   (px.2 (UA.under Q (C.compose A B Q j h))).sec (Ch.solutions-down u Y py.1) ;
  up : C.Hom P Q = (UA.up X Q (C.compose A B Q j h) hat).1 ;
  agree (x : A.ring.R) : Id Q.ring.R (up.1.1 (p.1.1 x)) (j.1.1 (h.1.1 x)) = hat.2 x ;
  up-gen (v : Fin u.1) : Id Q.ring.R (up.1.1 (px.1.1 v)) (py.1.1 v) =
   ap (\ s -> s.1 v) ((px.2 (UA.under Q (C.compose A B Q j h))).sec-eq (Ch.solutions-down u Y py.1)) ;
  module Sq = PO.Square[P,B,A,p,h] ;
  module To (D : C.Algebra) {
   module Back (c : Sq.Cocone D) {
    t : C.Hom A D = C.compose A B D c.1.2 h ;
    rhat : CA.Hom X (UA.under D t) = UA.down X D t (c.1.1,c.2) ;
    sol : PB.Solutions (Ch.change u) (UB.under D c.1.2) =
     Ch.solutions-up u (UB.under D c.1.2) (PA.canonical u X px.1 (UA.under D t) rhat) ;
    mhat : CB.Hom Y (UB.under D c.1.2) = (py.2 (UB.under D c.1.2)).sec sol ;
    mhat-gen (v : Fin u.1) : Id D.ring.R (mhat.1.1 (py.1.1 v)) (c.1.1.1.1 (px.1.1 v)) =
     ap (\ s -> s.1 v) ((py.2 (UB.under D c.1.2)).sec-eq sol) ;
    map : C.Hom Q D = (UB.up Y D c.1.2 mhat).1 ;
   } ;
   restrict (m : C.Hom Q D) : Sq.Cocone D = Sq.restrict Q up j agree D m ;
   fb (c : Sq.Cocone D) : Id (Sq.Cocone D) (restrict (Back[c].map)) c =
    Pr.Sigma-eq (C.Hom P D * C.Hom B D)
     (\ d -> (x : A.ring.R) -> Id D.ring.R (d.1.1.1 (p.1.1 x)) (d.2.1.1 (h.1.1 x)))
     (restrict (Back[c].map)).1 c.1 (restrict (Back[c].map)).2 c.2
     (Pr.trans (C.Hom P D * C.Hom B D) _ (c.1.1,C.compose B Q D Back[c].map j) _
      (Pr.ap (C.Hom P D) (C.Hom P D * C.Hom B D) (\ a -> (a,C.compose B Q D Back[c].map j)) _ _
       (C.ext P D (C.compose P Q D Back[c].map up) c.1.1 (\ y -> ap (\ k -> k.1.1 y)
        (Tensor[l].Over[A.ring,A.set].hom-eq u X px (UA.under D Back[c].t)
         (H.compose X.ring Q.ring D.ring Back[c].map.1 up.1,
          \ a -> trans (ap Back[c].map.1.1 (hat.2 a)) (Back[c].mhat.2 (h.1.1 a)))
         Back[c].rhat
         (\ v -> trans (ap Back[c].map.1.1 (up-gen v)) (Back[c].mhat-gen v))))))
      (Pr.ap (C.Hom B D) (C.Hom P D * C.Hom B D) (\ b -> (c.1.1,b)) _ _
       (C.ext B D (C.compose B Q D Back[c].map j) c.1.2 Back[c].mhat.2)))
     (Sq.cocone-prop D c.1) ;
   bf (m : C.Hom Q D) : Id (C.Hom Q D) (Back[restrict m].map) m =
    C.ext Q D Back[restrict m].map m (\ y -> ap (\ k -> k.1.1 y)
     (Tensor[l].Over[B.ring,B.set].hom-eq (Ch.change u) Y py (UB.under D (C.compose B Q D m j))
      Back[restrict m].mhat
      (UB.down Y D (C.compose B Q D m j) (m,\ b -> refl (m.1.1 (Y.iota.1 b))))
      (\ v -> trans (Back[restrict m].mhat-gen v) (ap m.1.1 (up-gen v))))) ;
   universal : Pr.isEquiv (C.Hom Q D) (Sq.Cocone D) restrict =
    Pr.qinv (C.Hom Q D) (Sq.Cocone D) restrict (\ c -> Back[c].map) fb bf ;
  } ;
  change : BC.Along[A,P,p].Change B h = (Q,up,j,agree,\ D -> To[D].universal) ;
 } ;
 -- every h : A -> B has a chosen base change of p_u, by a presented <u.h>
 module Chosen (A : C.Algebra) (u : Presentations[l].Over[A.ring,A.set].Presentation)
  (X : Algebras[l].Over[A.ring,A.set].Algebra) (px : Presentations[l].Over[A.ring,A.set].Presents u X) {
  P : C.Algebra = Rel.Under[A].total X ;
  p : C.Hom A P = Rel.Under[A].structure X ;
  module Fibre (B : C.Algebra) (h : C.Hom A B) {
   w : Presentations[l].Over[B.ring,B.set].Presentation =
    Relative[l].Along[A.ring,A.set,B.ring,B.set,h.1].change u ;
   module Y = PresentationExistence[l].Over[B.ring,B.set,w] ;
   module Sq = At[A,B,h,u,X,px,Y.A.algebra,Y.presentation] ;
  } ;
  ch (B : C.Algebra) (h : C.Hom A B) : BC.Along[A,P,p].Change B h = Fibre[B,h].Sq.change ;
 } ;
} ;
