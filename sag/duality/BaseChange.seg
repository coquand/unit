-- Base change of an algebra map, generically from the pushout property
-- (jonas.pdf Lemma 50, its laws, and the retraction q_u before Prop 58).
--
-- Fix p : A -> P.  A base change of p along h : A -> B is a pushout
--
--        A ---p---> P
--        |          | up
--        h          v
--        B ---j---> Q
--
-- (Square[P,B,A,p,h].Pushout Q of tensor/Pushout.seg: Hom(Q,D) is the
-- type of cocones (r, s, r p = s h) under the span, for every D.)
--
-- Informal proof.
-- (1) induced r s e : Q -> D is the map with cocone (r, s, e); by
--     definition of the equivalence it satisfies induced up = r and
--     induced j = s (pointwise).  Two maps Q -> D that agree after up
--     and after j are equal, since restriction to cocones is injective
--     and the agreement condition of a cocone is a proposition.
-- (2) Comparison (Lemma 50's h+ between two base changes).  For base
--     changes c1 of p along h1 : A -> B1 and c2 along h2 : A -> B2, and
--     k : B1 -> B2 with k h1 = h2, move = induced (up2, j2 k) : Q1 -> Q2.
--     It is the unique map with move up1 = up2 and move j1 = j2 k, by (1).
--     Identity law: the identity of Q satisfies the equations of
--     move along the identity of B.  Composition law: move' move
--     satisfies the equations of the move along k' k.  Both by (1).
-- (3) Ret = retractions of j : B -> Q.  For r : P -> B with r p = h,
--     retraction r = induced (r, id_B) is one, with retraction up = r.
-- (4) At B = P, h = p, the retraction of the identity is q, the common
--     retraction of up = p+ and j = p_{u p}:  q up = id, q j = id.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module PO = Pushout[l].Over[R,setR] ;
 module Along (A P : C.Algebra) (p : C.Hom A P) {
  -- a base change of p along h
  Change (B : C.Algebra) (h : C.Hom A B) : U l+ =
   (Q : C.Algebra) * PO.Square[P,B,A,p,h].Pushout Q ;
  module On (B : C.Algebra) (h : C.Hom A B) (c : Change B h) {
   module Sq = PO.Square[P,B,A,p,h] ;
   Q : C.Algebra = c.1 ;
   up : C.Hom P Q = c.2.1 ;
   j : C.Hom B Q = c.2.2.1 ;
   agree (x : A.ring.R) : Id Q.ring.R (up.1.1 (p.1.1 x)) (j.1.1 (h.1.1 x)) = c.2.2.2.1 x ;
   universal (D : C.Algebra) : Pr.isEquiv (C.Hom Q D) (Sq.Cocone D) (Sq.restrict Q up j c.2.2.2.1 D) =
    c.2.2.2.2 D ;
   -- (1)
   module Induced (D : C.Algebra) (r : C.Hom P D) (s : C.Hom B D)
    (e : (x : A.ring.R) -> Id D.ring.R (r.1.1 (p.1.1 x)) (s.1.1 (h.1.1 x))) {
    map : C.Hom Q D = (universal D).sec ((r,s),e) ;
    on-up (y : P.ring.R) : Id D.ring.R (map.1.1 (up.1.1 y)) (r.1.1 y) =
     ap (\ d -> d.1.1.1.1 y) ((universal D).sec-eq ((r,s),e)) ;
    on-j (b : B.ring.R) : Id D.ring.R (map.1.1 (j.1.1 b)) (s.1.1 b) =
     ap (\ d -> d.1.2.1.1 b) ((universal D).sec-eq ((r,s),e)) ;
   } ;
   unique (D : C.Algebra) (m n : C.Hom Q D)
    (a : (y : P.ring.R) -> Id D.ring.R (m.1.1 (up.1.1 y)) (n.1.1 (up.1.1 y)))
    (b : (z : B.ring.R) -> Id D.ring.R (m.1.1 (j.1.1 z)) (n.1.1 (j.1.1 z))) : Id (C.Hom Q D) m n =
    E.injective (C.Hom Q D) (Sq.Cocone D) (Sq.restrict Q up j c.2.2.2.1 D) (universal D) m n
     (Pr.Sigma-eq (C.Hom P D * C.Hom B D)
       (\ d -> (x : A.ring.R) -> Id D.ring.R (d.1.1.1 (p.1.1 x)) (d.2.1.1 (h.1.1 x)))
       (C.compose P Q D m up,C.compose B Q D m j) (C.compose P Q D n up,C.compose B Q D n j)
       (\ x -> ap m.1.1 (agree x)) (\ x -> ap n.1.1 (agree x))
       (Pr.trans (C.Hom P D * C.Hom B D) _ (C.compose P Q D n up,C.compose B Q D m j) _
        (Pr.ap (C.Hom P D) (C.Hom P D * C.Hom B D) (\ u -> (u,C.compose B Q D m j)) _ _
         (C.ext P D (C.compose P Q D m up) (C.compose P Q D n up) a))
        (Pr.ap (C.Hom B D) (C.Hom P D * C.Hom B D) (\ v -> (C.compose P Q D n up,v)) _ _
         (C.ext B D (C.compose B Q D m j) (C.compose B Q D n j) b)))
       (Sq.cocone-prop D (C.compose P Q D n up,C.compose B Q D n j))) ;
   -- (3)
   Ret : U l = (r : C.Hom Q B) * ((z : B.ring.R) -> Id B.ring.R (r.1.1 (j.1.1 z)) z) ;
   module Retraction (r : C.Hom P B) (e : (x : A.ring.R) -> Id B.ring.R (r.1.1 (p.1.1 x)) (h.1.1 x)) {
    module I = Induced[B,r,C.identity B,e] ;
    ret : Ret = (I.map,I.on-j) ;
    on-up (y : P.ring.R) : Id B.ring.R (ret.1.1.1 (up.1.1 y)) (r.1.1 y) = I.on-up y ;
   } ;
  } ;
  -- (2)
  module Compare (B1 B2 : C.Algebra) (h1 : C.Hom A B1) (h2 : C.Hom A B2)
   (c1 : Change B1 h1) (c2 : Change B2 h2) (k : C.Hom B1 B2)
   (e : (x : A.ring.R) -> Id B2.ring.R (k.1.1 (h1.1.1 x)) (h2.1.1 x)) {
   module O1 = On[B1,h1,c1] ;
   module O2 = On[B2,h2,c2] ;
   module I = O1.Induced[O2.Q,O2.up,C.compose B1 B2 O2.Q O2.j k,\ x -> trans (O2.agree x) (ap O2.j.1.1 (sym (e x)))] ;
   move : C.Hom O1.Q O2.Q = I.map ;
   move-up (y : P.ring.R) : Id O2.Q.ring.R (move.1.1 (O1.up.1.1 y)) (O2.up.1.1 y) = I.on-up y ;
   move-j (z : B1.ring.R) : Id O2.Q.ring.R (move.1.1 (O1.j.1.1 z)) (O2.j.1.1 (k.1.1 z)) = I.on-j z ;
   unique (m : C.Hom O1.Q O2.Q)
    (a : (y : P.ring.R) -> Id O2.Q.ring.R (m.1.1 (O1.up.1.1 y)) (O2.up.1.1 y))
    (b : (z : B1.ring.R) -> Id O2.Q.ring.R (m.1.1 (O1.j.1.1 z)) (O2.j.1.1 (k.1.1 z))) :
    Id (C.Hom O1.Q O2.Q) m move =
    O1.unique O2.Q m move (\ y -> trans (a y) (sym (move-up y))) (\ z -> trans (b z) (sym (move-j z))) ;
  } ;
  -- the identity law: moving along the identity of B is the identity
  identity-law (B : C.Algebra) (h : C.Hom A B) (c : Change B h) :
   Id (C.Hom c.1 c.1) (C.identity c.1) Compare[B,B,h,h,c,c,C.identity B,\ x -> refl (h.1.1 x)].move =
   Compare[B,B,h,h,c,c,C.identity B,\ x -> refl (h.1.1 x)].unique (C.identity c.1)
    (\ y -> refl (c.2.1.1.1 y)) (\ z -> refl (c.2.2.1.1.1 z)) ;
  -- the composition law
  module Composition (B1 B2 B3 : C.Algebra) (h1 : C.Hom A B1) (h2 : C.Hom A B2) (h3 : C.Hom A B3)
   (c1 : Change B1 h1) (c2 : Change B2 h2) (c3 : Change B3 h3)
   (k : C.Hom B1 B2) (e : (x : A.ring.R) -> Id B2.ring.R (k.1.1 (h1.1.1 x)) (h2.1.1 x))
   (k' : C.Hom B2 B3) (e' : (x : A.ring.R) -> Id B3.ring.R (k'.1.1 (h2.1.1 x)) (h3.1.1 x))
   (e'' : (x : A.ring.R) -> Id B3.ring.R (k'.1.1 (k.1.1 (h1.1.1 x))) (h3.1.1 x)) {
   module M = Compare[B1,B2,h1,h2,c1,c2,k,e] ;
   module M' = Compare[B2,B3,h2,h3,c2,c3,k',e'] ;
   module M'' = Compare[B1,B3,h1,h3,c1,c3,C.compose B1 B2 B3 k' k,e''] ;
   law : Id (C.Hom c1.1 c3.1) (C.compose c1.1 c2.1 c3.1 M'.move M.move) M''.move =
    M''.unique (C.compose c1.1 c2.1 c3.1 M'.move M.move)
     (\ y -> trans (ap M'.move.1.1 (M.move-up y)) (M'.move-up y))
     (\ z -> trans (ap M'.move.1.1 (M.move-j z)) (M'.move-j (k.1.1 z))) ;
  } ;
  -- (4) q, the common retraction of up = p+ and j = p_{u p}
  module Diagonal (c : Change P p) {
   module O = On[P,p,c] ;
   module Rq = O.Retraction[C.identity P,\ x -> refl (p.1.1 x)] ;
   q : C.Hom O.Q P = Rq.ret.1 ;
   q-up (y : P.ring.R) : Id P.ring.R (q.1.1 (O.up.1.1 y)) y = Rq.on-up y ;
   q-j (y : P.ring.R) : Id P.ring.R (q.1.1 (O.j.1.1 y)) y = Rq.ret.2 y ;
  } ;
 } ;
} ;
