-- The base part of jonas.pdf Construction 57: retractions of p_w are the
-- solutions of w in B, compatibly with evaluation; with Prop 58's base
-- part this gives the classical description of the spectrum,
--
--   Hom(<u>, B) = (h : Hom(A,B)) * Solutions(u.h, B),
--   r |-> (r p_u, the values of r on the generators of <u>).
--
-- Informal proof.
-- (1) For w with coefficients in B and Y presenting w: a retraction of
--     p_w : B -> total Y is a map total Y -> B under B, that is a map of
--     B-algebras Y -> B (Relative (2), at s = id), that is a solution of
--     w in B (Y presents w).  The solution is the values of the
--     retraction on the generators, and the retraction applied to the
--     value of an expression is the expression evaluated at the solution
--     (naturality of evaluation).
-- (2) Compose Prop 58's base part (Representability) with (1) in every
--     fibre, at the chosen base changes of RelativeChange.  The value of
--     the composite at r on a generator v is the induced retraction on
--     up v = (generator v of <u.h>), which is r v (evaluation equation).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
open Presentations[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module Rel = Relative[l].Over[R,setR] ;
 module RC = RelativeChange[l].Over[R,setR] ;
 module Rep = Representability[l].Over[R,setR] ;
 -- (1)
 module Points (B : C.Algebra) (w : Presentations[l].Over[B.ring,B.set].Presentation)
  (Y : Algebras[l].Over[B.ring,B.set].Algebra) (py : Presentations[l].Over[B.ring,B.set].Presents w Y) {
  module PB = Presentations[l].Over[B.ring,B.set] ;
  module CB = Algebras[l].Over[B.ring,B.set] ;
  module UB = Rel.Under[B] ;
  self : CB.Algebra = UB.under B (C.identity B) ;
  Ret : U l = UB.Lifted Y B (C.identity B) ;
  forward (t : Ret) : PB.Solutions w self = PB.canonical w Y py.1 self (UB.down Y B (C.identity B) t) ;
  equivalence : Pr.Equiv Ret (PB.Solutions w self) =
   E.compose Ret (CB.Hom Y self) (PB.Solutions w self) (UB.lifted Y B (C.identity B))
    (PB.canonical w Y py.1 self,py.2 self) ;
  values (t : Ret) (v : Fin w.1) : Id B.ring.R ((forward t).1 v) (t.1.1.1 (py.1.1 v)) =
   refl (t.1.1.1 (py.1.1 v)) ;
  evaluation (t : Ret) (e : PB.Expr (Fin w.1)) :
   Id B.ring.R (t.1.1.1 (PB.eval (Fin w.1) Y py.1.1 e)) (PB.eval (Fin w.1) self (forward t).1 e) =
   PB.natural (Fin w.1) Y self (UB.down Y B (C.identity B) t) py.1.1 e ;
 } ;
 -- (2)
 module Spectrum (A : C.Algebra) (u : Presentations[l].Over[A.ring,A.set].Presentation)
  (X : Algebras[l].Over[A.ring,A.set].Algebra) (px : Presentations[l].Over[A.ring,A.set].Presents u X)
  (B : C.Algebra) {
  module Ch = RC.Chosen[A,u,X,px] ;
  module Rp = Rep.At[A,Ch.P,Ch.p,B,Ch.ch B] ;
  module Fib (h : C.Hom A B) {
   module Bh = Ch.Fibre[B,h] ;
   module Pt = Points[B,Bh.w,Bh.Y.A.algebra,Bh.Y.presentation] ;
   Sols : U l = Pt.PB.Solutions Bh.w Pt.self ;
   equivalence : Pr.Equiv Rp.Fibre[h].O.Ret Sols = Pt.equivalence ;
  } ;
  Sols : U l = (h : C.Hom A B) * Fib[h].Sols ;
  total : Pr.Equiv Rp.Total Sols =
   (\ t -> (t.1,Fib[t.1].equivalence.1 t.2),
    Pr.qinv Rp.Total Sols (\ t -> (t.1,Fib[t.1].equivalence.1 t.2)) (\ s -> (s.1,Fib[s.1].equivalence.2.sec s.2))
     (\ s -> Pr.ap Fib[s.1].Sols Sols (\ v -> (s.1,v)) _ _ (Fib[s.1].equivalence.2.sec-eq s.2))
     (\ t -> Pr.ap Rp.Fibre[t.1].O.Ret Rp.Total (\ v -> (t.1,v)) _ _
       (Pr.sec-ret Rp.Fibre[t.1].O.Ret Fib[t.1].Sols Fib[t.1].equivalence.1 Fib[t.1].equivalence.2 t.2))) ;
  spectrum : Pr.Equiv (C.Hom Ch.P B) Sols =
   E.compose (C.Hom Ch.P B) Rp.Total Sols (Rp.forward,Rp.representation) total ;
  -- by definition, spectrum is forward followed by the fibre equivalence
  spectrum-at (r : C.Hom Ch.P B) : Id Sols (spectrum.1 r) (total.1 (Rp.forward r)) =
   refl (spectrum.1 r) ;
  -- the evaluation clause: the solution attached to r is r on the generators
  -- (opens ~50 definitions: the accessors of BaseChange.On applied to ch h
  -- are matched against the names of RelativeChange.At by unfolding)
  generators (r : C.Hom Ch.P B) (v : Fin u.1) :
   Id B.ring.R ((total.1 (Rp.forward r)).2.1 v) (r.1.1 (px.1.1 v)) =
   trans (ap (Rp.forward r).2.1.1.1 (sym (Fib[C.compose A Ch.P B r Ch.p].Bh.Sq.up-gen v)))
    (Rp.evaluation r (px.1.1 v)) ;
 } ;
} ;
