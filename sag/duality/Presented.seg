-- T1.5: chosen presentations give base changes.  For presented P, B, A
-- (presentations p, q, k), maps f : A -> P, h : A -> B, and chosen
-- expressions for the images of A's generators (eP, eB), the algebra
-- built by tensor/Pushout.seg's Construction is a base change of f along
-- h.  No elimination from truncated FP witnesses: everything is chosen.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
open Presentations[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Presentations[l].Over[R,setR] ; open P ;
 module C = Algebras[l].Over[R,setR] ;
 module G = Generated[l].Over[R,setR] ;
 module PO = Pushout[l].Over[R,setR] ;
 module BC = BaseChange[l].Over[R,setR] ;
 module Chosen (p q k : Presentation) (Pa B A : C.Algebra)
  (pp : Presents p Pa) (pb : Presents q B) (pa : Presents k A)
  (f : C.Hom A Pa) (h : C.Hom A B)
  (eP : (v : Fin k.1) -> G.Representation p Pa pp (f.1.1 (pa.1.1 v)))
  (eB : (v : Fin k.1) -> G.Representation q B pb (h.1.1 (pa.1.1 v))) {
  module X = PO.Construction[p,q,k,Pa,B,A,pp,pb,pa,f,h,eP,eB] ;
  change : BC.Along[A,Pa,f].Change B h = (X.T,X.pushout) ;
 } ;
} ;
