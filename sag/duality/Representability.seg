-- The base part of jonas.pdf Prop 58, with the evaluation clause of
-- Construction 57: for p : A -> P and a base change ch h of p along every
-- h : A -> B,
--
--   forward : Hom(P,B) -> (h : Hom(A,B)) * Ret_B(ch h),
--   forward r = (r p, the retraction induced by (r, id_B)),
--
-- is an equivalence, and (forward r).2 up = r  (the evaluation equation).
--
-- Informal proof.  Write Lift r h for the pointwise r p = h.
-- (a) For fixed h, Ret(ch h) = (r : Hom(P,B)) * Lift r h, by
--     t |-> (t up, t agree . t j = id) and (r, e) |-> retraction r e.
--     One way: retraction r e up = r (BaseChange (3)), and Lift is a
--     proposition.  Other way: the two maps Q -> B agree after up (by
--     definition) and after j (both retract j), so are equal by the
--     uniqueness in BaseChange (1); the retraction condition is a
--     proposition.
-- (b) Hom(P,B) = (r : Hom(P,B)) * (h : Hom(A,B)) * Lift r h, by
--     r |-> (r, r p, refl): the pairs (h, Lift r h) form a singleton.
-- (c) Swap the first two components, then apply (a) in each fibre.
-- The composite of (b), (c) and (a) is forward, by definition.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module BC = BaseChange[l].Over[R,setR] ;
 module At (A P : C.Algebra) (p : C.Hom A P) (B : C.Algebra)
  (ch : (h : C.Hom A B) -> BC.Along[A,P,p].Change B h) {
  Lift (r : C.Hom P B) (h : C.Hom A B) : U l =
   (x : A.ring.R) -> Id B.ring.R (r.1.1 (p.1.1 x)) (h.1.1 x) ;
  lift-prop (r : C.Hom P B) (h : C.Hom A B) : Pr.isProp (Lift r h) =
   F.isProp-Pi A.ring.R (\ x -> Id B.ring.R (r.1.1 (p.1.1 x)) (h.1.1 x)) (\ x -> B.set _ _) ;
  -- (a)
  module Fibre (h : C.Hom A B) {
   module O = BC.Along[A,P,p].On[B,h,ch h] ;
   Lifts : U l = (r : C.Hom P B) * Lift r h ;
   to (t : O.Ret) : Lifts =
    (C.compose P O.Q B t.1 O.up,\ x -> trans (ap t.1.1.1 (O.agree x)) (t.2 (h.1.1 x))) ;
   from (s : Lifts) : O.Ret = O.Retraction[s.1,s.2].ret ;
   to-from (s : Lifts) : Id Lifts (to (from s)) s =
    Pr.Sigma-eq (C.Hom P B) (\ r -> Lift r h) (to (from s)).1 s.1 (to (from s)).2 s.2
     (C.ext P B (to (from s)).1 s.1 (O.Retraction[s.1,s.2].on-up)) (lift-prop s.1 h) ;
   from-to (t : O.Ret) : Id O.Ret (from (to t)) t =
    Pr.Sigma-eq (C.Hom O.Q B) (\ r -> (z : B.ring.R) -> Id B.ring.R (r.1.1 (O.j.1.1 z)) z)
     (from (to t)).1 t.1 (from (to t)).2 t.2
     (O.unique B (from (to t)).1 t.1
       (O.Retraction[(to t).1,(to t).2].on-up)
       (\ z -> trans ((from (to t)).2 z) (sym (t.2 z))))
     (F.isProp-Pi B.ring.R (\ z -> Id B.ring.R (t.1.1.1 (O.j.1.1 z)) z) (\ z -> B.set _ _)) ;
   equivalence : Pr.Equiv Lifts O.Ret = (from,Pr.qinv Lifts O.Ret from to from-to to-from) ;
  } ;
  Total : U l = (h : C.Hom A B) * Fibre[h].O.Ret ;
  -- (b)
  Mid : U l = (r : C.Hom P B) * (h : C.Hom A B) * Lift r h ;
  singleton (r : C.Hom P B) (s : (h : C.Hom A B) * Lift r h) :
   Id ((h : C.Hom A B) * Lift r h) (C.compose A P B r p,\ x -> refl (r.1.1 (p.1.1 x))) s =
   Pr.Sigma-eq (C.Hom A B) (\ h -> Lift r h) (C.compose A P B r p) s.1 (\ x -> refl (r.1.1 (p.1.1 x))) s.2
    (C.ext A B (C.compose A P B r p) s.1 s.2) (lift-prop r s.1) ;
  step-b : Pr.Equiv (C.Hom P B) Mid =
   (\ r -> (r,C.compose A P B r p,\ x -> refl (r.1.1 (p.1.1 x))),
    Pr.qinv (C.Hom P B) Mid (\ r -> (r,C.compose A P B r p,\ x -> refl (r.1.1 (p.1.1 x)))) (\ m -> m.1)
     (\ m -> Pr.ap ((h : C.Hom A B) * Lift m.1 h) Mid (\ s -> (m.1,s)) _ _ (singleton m.1 m.2))
     (\ r -> refl r)) ;
  -- (c)
  Swapped : U l = (h : C.Hom A B) * Fibre[h].Lifts ;
  step-swap : Pr.Equiv Mid Swapped =
   (\ m -> (m.2.1,m.1,m.2.2),
    Pr.qinv Mid Swapped (\ m -> (m.2.1,m.1,m.2.2)) (\ w -> (w.2.1,w.1,w.2.2))
     (\ w -> refl w) (\ m -> refl m)) ;
  step-a : Pr.Equiv Swapped Total =
   (\ w -> (w.1,Fibre[w.1].from w.2),
    Pr.qinv Swapped Total (\ w -> (w.1,Fibre[w.1].from w.2)) (\ t -> (t.1,Fibre[t.1].to t.2))
     (\ t -> Pr.ap Fibre[t.1].O.Ret Total (\ v -> (t.1,v)) _ _ (Fibre[t.1].from-to t.2))
     (\ w -> Pr.ap Fibre[w.1].Lifts Swapped (\ v -> (w.1,v)) _ _ (Fibre[w.1].to-from w.2))) ;
  -- the map of Prop 58, and its equivalence
  forward (r : C.Hom P B) : Total =
   (C.compose A P B r p,Fibre[C.compose A P B r p].O.Retraction[r,\ x -> refl (r.1.1 (p.1.1 x))].ret) ;
  representation : Pr.isEquiv (C.Hom P B) Total forward =
   E.homotopy (C.Hom P B) Total (E.compose (C.Hom P B) Swapped Total (E.compose (C.Hom P B) Mid Swapped step-b step-swap) step-a)
    forward (\ r -> refl (forward r)) ;
  -- the evaluation equation (Construction 57, base part)
  evaluation (r : C.Hom P B) (y : P.ring.R) :
   Id B.ring.R ((forward r).2.1.1.1 (Fibre[C.compose A P B r p].O.up.1.1 y)) (r.1.1 y) =
   Fibre[C.compose A P B r p].O.Retraction[r,\ x -> refl (r.1.1 (p.1.1 x))].on-up y ;
 } ;
} ;
