-- Presentations with coefficients in an algebra (jonas.pdf §6.4.1,
-- Pr_{T/A}): change of coefficients u |-> u.phi along a ring map, and
-- algebras under A read as A-algebras.
--
-- Informal account.
-- (1) Along phi : S -> T, an expression with constants in S becomes one
--     with constants in T by applying phi to the constants; u.phi is u
--     with every equation so changed.  A T-algebra Y restricts to an
--     S-algebra Y|phi (same ring, structure map Y.iota phi).  Evaluating
--     e.phi in Y is evaluating e in Y|phi (induction on e); hence the
--     zeros and the solutions of u.phi in Y are those of u in Y|phi,
--     with the same values on the variables.
-- (2) For an R-algebra A, an A-algebra X is an R-algebra total X (along
--     A.iota) with a map structure X : A -> total X.  An R-algebra D
--     with s : A -> D is an A-algebra under D s.  A map of R-algebras
--     r : total X -> D with r . structure = s pointwise is the same as a
--     map of A-algebras X -> under D s (the R-condition follows from the
--     A-condition and s.2).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
open Presentations[l] ;
-- (1)
module Along (S : CRing) (setS : Pr.isSet S.R) (T : CRing) (setT : Pr.isSet T.R) (phi : H.Hom S T) {
 module PS = Presentations[l].Over[S,setS] ;
 module PT = Presentations[l].Over[T,setT] ;
 module CS = Algebras[l].Over[S,setS] ;
 module CT = Algebras[l].Over[T,setT] ;
 restrict (Y : CT.Algebra) : CS.Algebra = CS.mkAlgebra Y.ring Y.set (H.compose S T Y.ring Y.iota phi) ;
 mapE (V : U l) : PS.Expr V -> PT.Expr V = split {
  var v -> var v ; cst r -> cst (phi.1 r) ;
  sumE p q | rp rq -> sumE rp rq ; mulE p q | rp rq -> mulE rp rq } ;
 mapL (V : U l) : PS.Equations V -> PT.Equations V = split {
  nil -> nil ; cons e es | r -> cons (mapE V e) r } ;
 change (u : PS.Presentation) : PT.Presentation = (u.1,mapL (Fin u.1) u.2) ;
 eval-map (V : U l) (Y : CT.Algebra) (a : V -> Y.ring.R) :
  (e : PS.Expr V) -> Id Y.ring.R (PT.eval V Y a (mapE V e)) (PS.eval V (restrict Y) a e) = split {
  var v -> refl (a v) ; cst r -> refl (Y.iota.1 (phi.1 r)) ;
  sumE p q | rp rq -> cong2 Y.ring.R Y.ring.add _ _ _ _ rp rq ;
  mulE p q | rp rq -> cong2 Y.ring.R Y.ring.mul _ _ _ _ rp rq } ;
 zeros-down (V : U l) (Y : CT.Algebra) (a : V -> Y.ring.R) :
  (es : PS.Equations V) -> PT.Zeros V Y a (mapL V es) -> PS.Zeros V (restrict Y) a es = split {
  nil -> \ z -> tt ;
  cons e es | r -> \ z -> (trans (sym (eval-map V Y a e)) z.1,r z.2) } ;
 zeros-up (V : U l) (Y : CT.Algebra) (a : V -> Y.ring.R) :
  (es : PS.Equations V) -> PS.Zeros V (restrict Y) a es -> PT.Zeros V Y a (mapL V es) = split {
  nil -> \ z -> tt ;
  cons e es | r -> \ z -> (trans (eval-map V Y a e) z.1,r z.2) } ;
 solutions-down (u : PS.Presentation) (Y : CT.Algebra) (s : PT.Solutions (change u) Y) :
  PS.Solutions u (restrict Y) = (s.1,zeros-down (Fin u.1) Y s.1 u.2 s.2) ;
 solutions-up (u : PS.Presentation) (Y : CT.Algebra) (s : PS.Solutions u (restrict Y)) :
  PT.Solutions (change u) Y = (s.1,zeros-up (Fin u.1) Y s.1 u.2 s.2) ;
} ;
-- (2)
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module Under (A : C.Algebra) {
  module CA = Algebras[l].Over[A.ring,A.set] ;
  total (X : CA.Algebra) : C.Algebra = Along[R,setR,A.ring,A.set,A.iota].restrict X ;
  structure (X : CA.Algebra) : C.Hom A (total X) = (X.iota,\ r -> refl (X.iota.1 (A.iota.1 r))) ;
  under (D : C.Algebra) (s : C.Hom A D) : CA.Algebra = CA.mkAlgebra D.ring D.set s.1 ;
  Lifted (X : CA.Algebra) (D : C.Algebra) (s : C.Hom A D) : U l =
   (r : C.Hom (total X) D) * ((a : A.ring.R) -> Id D.ring.R (r.1.1 (X.iota.1 a)) (s.1.1 a)) ;
  down (X : CA.Algebra) (D : C.Algebra) (s : C.Hom A D) (m : Lifted X D s) : CA.Hom X (under D s) =
   (m.1.1,m.2) ;
  up (X : CA.Algebra) (D : C.Algebra) (s : C.Hom A D) (g : CA.Hom X (under D s)) : Lifted X D s =
   ((g.1,\ r -> trans (g.2 (A.iota.1 r)) (s.2 r)),g.2) ;
  up-down (X : CA.Algebra) (D : C.Algebra) (s : C.Hom A D) (m : Lifted X D s) :
   Id (Lifted X D s) (up X D s (down X D s m)) m =
   Pr.Sigma-eq (C.Hom (total X) D) (\ r -> (a : A.ring.R) -> Id D.ring.R (r.1.1 (X.iota.1 a)) (s.1.1 a))
    (up X D s (down X D s m)).1 m.1 m.2 m.2
    (C.ext (total X) D (up X D s (down X D s m)).1 m.1 (\ y -> refl (m.1.1.1 y)))
    (F.isProp-Pi A.ring.R (\ a -> Id D.ring.R (m.1.1.1 (X.iota.1 a)) (s.1.1 a)) (\ a -> D.set _ _)) ;
  lifted (X : CA.Algebra) (D : C.Algebra) (s : C.Hom A D) : Pr.Equiv (Lifted X D s) (CA.Hom X (under D s)) =
   (down X D s,Pr.qinv (Lifted X D s) (CA.Hom X (under D s)) (down X D s) (up X D s)
    (\ g -> refl g) (up-down X D s)) ;
 } ;
} ;
