-- CCmpK18.seg (canonicity-c2; (K) for cmpI, part 18): over GS, the element
-- (z_t, cmpI z_t = g) of the fibre of cmpI over g (CCmpK17), and its image
-- in the truncation of the fibre.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module K18 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K17m = CCmpK17[a].K17[R, encK, pe, y] ;
 module K12m = K17m.K12m ;
 module I = K12m.I ;
 Nl : C.Ctx = C.nil ;
 GS : C.Ctx = K12m.GS ;
 GB : C.Ctx = K12m.GB ;
 HS : C.Ty Nl = K12m.HS ;
 HTT : C.Ty Nl = K12m.HTT ;
 s0 : C.Sub GS Nl = K12m.s0 ;
 pp : C.Sub GS GB = K12m.pp ;
 HS0 : C.Ty GS = K17m.HS0 ;
 HTT0 : C.Ty GS = K17m.HTT0 ;
 Xs : C.Ty GS = C.subT GS GB I.Xb pp ;
 PXs : Id (C.Ty GS) HS0 Xs = C.subT-o GS GB Nl HS (C.p Nl HTT) pp ;
 hv : C.El GS Xs = OV.trE GS HS0 Xs PXs K12m.z ;
 hvr (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (Xs.1.tob K w)) (hv.eob K w) (K12m.z.eob K w) =
  transH (CAppRd[a].trE-rd GS HS0 Xs PXs K12m.z K w) (CAppRd[a].same-rd GS HS0 Xs PXs K w (refl (Xs.1.tob K w)) (K12m.z.eob K w)) ;
 lf : C.Sub (C.ext GS Xs) I.GX = C.lift GS GB I.Xb pp ;
 Ys : C.Ty (C.ext GS Xs) = C.subT (C.ext GS Xs) I.GX I.Fm lf ;
 rho : C.Sub GS I.GX = C.o GS (C.ext GS Xs) I.GX lf (C.sec GS Xs hv) ;
 T0x : C.Ty I.GX = OV.wkT I.GB I.Xb I.Bb ;
 qw : C.El I.GX T0x = OV.wkE I.GB I.Xb I.Bb (C.q Nl I.B) ;
 module MX = K12m.Mv[HTT, I.GX, T0x, C.o I.GX I.GB Nl (C.p Nl I.B) I.pX, symH (C.subT-o I.GX I.GB Nl I.B (C.p Nl I.B) I.pX), rho, \ K w -> refl (s0.nt K w)] ;
 QK (K : Ob) (w : V1.Ix (GS.ob K)) : U a+ = V1.Ix (HTT0.1.tob K w) ;
 px (K : Ob) (w : V1.Ix (GS.ob K)) : Id (QK K w) (K17m.pc.eob K w) ((MX.el I.apX).eob K w) =
  transH (K17m.pcr K w)
   (symH (transH (CAppRd[a].trE-rd GS (C.subT GS I.GX T0x rho) HTT0 MX.P (C.subt GS I.GX T0x I.apX rho) K w)
      (transH (CAppRd[a].same-rd GS (C.subT GS I.GX T0x rho) HTT0 MX.P K w (refl (HTT0.1.tob K w)) (I.apX.eob K (rho.nt K w)))
        (transH (I.appR K (rho.nt K w)) (apH {V1.Ix (HS.1.tob K w.1.1.1)} {QK K w} (I.n.nfun K w.1.1.1) (hvr K w)))))) ;
 py (K : Ob) (w : V1.Ix (GS.ob K)) : Id (QK K w) (K17m.pg.eob K w) ((MX.el qw).eob K w) =
  transH (K17m.pgr K w)
   (symH (transH (CAppRd[a].trE-rd GS (C.subT GS I.GX T0x rho) HTT0 MX.P (C.subt GS I.GX T0x qw rho) K w)
      (CAppRd[a].same-rd GS (C.subT GS I.GX T0x rho) HTT0 MX.P K w (refl (HTT0.1.tob K w)) (qw.eob K (rho.nt K w))))) ;
 iv0 : C.El GS (IJ.IdT GS HTT0 (MX.el I.apX) (MX.el qw)) =
  CCmpU14[a].rwId GS HTT0 K17m.pc (MX.el I.apX) K17m.pg (MX.el qw) px py K17m.ip ;
 -- back to the fibre's types
 T0r : C.Ty GS = C.subT GS I.GX T0x rho ;
 iv1a : C.El GS (IJ.IdT GS T0r (OV.trE GS HTT0 T0r (symH MX.P) (MX.el I.apX)) (OV.trE GS HTT0 T0r (symH MX.P) (MX.el qw))) =
  CInjP[a].idFwdL GS HTT0 T0r (symH MX.P) (MX.el I.apX) (MX.el qw) iv0 ;
 iv1 : C.El GS (IJ.IdT GS T0r (C.subt GS I.GX T0x I.apX rho) (C.subt GS I.GX T0x qw rho)) =
  subst (C.El GS T0r) (\ v -> C.El GS (IJ.IdT GS T0r (C.subt GS I.GX T0x I.apX rho) v)) (OV.trE GS HTT0 T0r (symH MX.P) (MX.el qw)) (C.subt GS I.GX T0x qw rho)
   (CInjP[a].trInv GS T0r HTT0 MX.P (C.subt GS I.GX T0x qw rho))
   (subst (C.El GS T0r) (\ v -> C.El GS (IJ.IdT GS T0r v (OV.trE GS HTT0 T0r (symH MX.P) (MX.el qw)))) (OV.trE GS HTT0 T0r (symH MX.P) (MX.el I.apX)) (C.subt GS I.GX T0x I.apX rho)
      (CInjP[a].trInv GS T0r HTT0 MX.P (C.subt GS I.GX T0x I.apX rho)) iv1a) ;
 iv2 : C.El GS (C.subT GS I.GX I.Fm rho) =
  OV.trE GS (IJ.IdT GS T0r (C.subt GS I.GX T0x I.apX rho) (C.subt GS I.GX T0x qw rho)) (C.subT GS I.GX I.Fm rho) (symH (IJ.IdT-nat GS I.GX T0x I.apX qw rho)) iv1 ;
 iv : C.El GS (C.subT GS (C.ext GS Xs) Ys (C.sec GS Xs hv)) =
  OV.trE GS (C.subT GS I.GX I.Fm rho) (C.subT GS (C.ext GS Xs) Ys (C.sec GS Xs hv)) (C.subT-o GS (C.ext GS Xs) I.GX I.Fm lf (C.sec GS Xs hv)) iv2 ;
 fEl : C.El GS (C.subT GS GB I.Fib pp) =
  OV.trE GS (SS.Sig GS Xs Ys) (C.subT GS GB I.Fib pp) (symH (FibCwF[a, a+].fibSig.Sig-nat GS GB I.Xb I.Fm pp)) (INm.pr GS Xs Ys hv iv) ;
 -- into the truncation, and the elimination of mere surjectivity
 TA : CwFTrunc.Trunc[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv].TruncAt = CQSurj[a].TA ;
 TrF : C.Ty GB = TA.Tr GB I.Fib ;
 xS : C.Sub GS (C.ext GB I.Fib) = CQSurj[a].Ex[C].exS GS GB I.Fib pp fEl ;
 incF : C.El GS (C.subT GS GB TrF pp) =
  OV.trE GS (C.subT GS (C.ext GB I.Fib) (OV.wkT GB I.Fib TrF) xS) (C.subT GS GB TrF pp)
   (transH (symH (C.subT-o GS (C.ext GB I.Fib) GB TrF (C.p GB I.Fib) xS)) (apH {C.Sub GS GB} {C.Ty GS} (\ s -> C.subT GS GB TrF s) (INm.p-extS GS GB I.Fib pp fEl)))
   (C.subt GS (C.ext GB I.Fib) (OV.wkT GB I.Fib TrF) (TA.inc GB I.Fib) xS) ;
} ;
