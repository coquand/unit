-- CPshC.seg (canonicity-45; COBAR.md, DUALITY.md §6 item 2): presheaves
-- on a V-small category C with values in the base model (posets), i.e.
-- PSh(C) over the cubical base, as C-indexed families of base presheaves
-- with a C-action (design (b): the base's fibrancy stack applies at each
-- object of C verbatim).
--
--   CCtx        ob x : PCtx, act f : ob x -> ob y for f : y -> x (a PSub),
--               functorial pointwise
--   CTy G       ty x : PTy[G x], and the action on totals tE f : G.A at x
--               -> G.A at y over act f (a PSub with tE-pt), functorial
--   CEl, CSub   per object, natural in C pointwise
--   LTriv, LFib levelwise (trivial) fibrancy = the base notions at every x
--               (Fib(U G , U A) of the paper)
--   mapside     the C-action on sides (same sieve, values moved by tE f);
--               mapside-join: it commutes with Join
--   Unif        uniformity in C of a family of RC structures: the
--               extension of a moved side is the moved extension;
--               UTriv = LTriv with uniformity in C
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;

module CPsh (C : SmallCat[a].SmallCat) {
 -- the objects and maps of C
 CO : U a = SmallCat[a].Objs[C.obV].Ob ;
 CH (y x : CO) : U a = SmallCat[a].Homs[C.obV, C.homV].Hom y x ;
 cid (x : CO) : CH x x = C.idC x ;
 co (z y x : CO) (f : CH y x) (h : CH z y) : CH z x = C.oC z y x f h ;
 co-idl (y x : CO) (f : CH y x) : Id (CH y x) (co y x x (cid x) f) f = C.oC-idl y x f ;
 co-idr (y x : CO) (f : CH y x) : Id (CH y x) (co y y x f (cid y)) f = C.oC-idr y x f ;
 co-assoc (w z y x : CO) (f : CH y x) (h : CH z y) (k : CH w z)
  : Id (CH w x) (co w z x (co z y x f h) k) (co w y x f (co w z y h k)) = C.oC-assoc w z y x f h k ;

 ------------------------------------------------------------------
 -- contexts, types, elements, substitutions

 record CCtx {
  ob (x : CO) : PCtx ;
  act (y x : CO) (f : CH y x) : PSub[ob x, ob y] ;
  act-id (x : CO) (X : Ob) (g : W0.Ix ((ob x).ob X)) : Id (W0.Ix ((ob x).ob X)) ((act x x (cid x)).nt X g) g ;
  act-o (z y x : CO) (f : CH y x) (h : CH z y) (X : Ob) (g : W0.Ix ((ob x).ob X))
   : Id (W0.Ix ((ob z).ob X)) ((act z x (co z y x f h)).nt X g) ((act z y h).nt X ((act y x f).nt X g)) ;
 } ;

 record CTy (G : CCtx) {
  ty (x : CO) : PTy[G.ob x] ;
  -- the action on totals, over act f
  tE (y x : CO) (f : CH y x) : PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y)] ;
  tE-pt (y x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (ty x) X)
   : Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (ty y) X ((tE y x f).nt X w)) ((G.act y x f).nt X (fstE (G.ob x) (ty x) X w)) ;
  tE-id (x : CO) (X : Ob) (w : SigT (G.ob x) (ty x) X) : Id (SigT (G.ob x) (ty x) X) ((tE x x (cid x)).nt X w) w ;
  tE-o (z y x : CO) (f : CH y x) (h : CH z y) (X : Ob) (w : SigT (G.ob x) (ty x) X)
   : Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w)) ;
 } ;

 record CEl (G : CCtx) (A : CTy[G]) {
  el (x : CO) : PEl[G.ob x, A.ty x] ;
  el-nat (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X))
   : Id (SigT (G.ob y) (A.ty y) X)
      ((A.tE y x f).nt X (pairE (G.ob x) (A.ty x) X g ((el x).eob X g)))
      (pairE (G.ob y) (A.ty y) X ((G.act y x f).nt X g) ((el y).eob X ((G.act y x f).nt X g))) ;
 } ;

 record CSub (D G : CCtx) {
  sb (x : CO) : PSub[D.ob x, G.ob x] ;
  sb-nat (y x : CO) (f : CH y x) (X : Ob) (d : W0.Ix ((D.ob x).ob X))
   : Id (W0.Ix ((G.ob y).ob X)) ((sb y).nt X ((D.act y x f).nt X d)) ((G.act y x f).nt X ((sb x).nt X d)) ;
 } ;

 ------------------------------------------------------------------
 -- levelwise fibrancy: the base notions at every object (Fib(U G , U A))

 LTriv (G : CCtx) (A : CTy[G]) : U l+ = (x : CO) -> CP.ContrOp (G.ob x) (A.ty x) ;
 LFib (G : CCtx) (A : CTy[G]) : U l+ = (x : CO) -> PB.CLine[l].Lines[G.ob x, A.ty x].Fib ;

 ------------------------------------------------------------------
 -- the C-action on sides

 module MapSide (G : CCtx) (A : CTy[G]) (y x : CO) (f : CH y x) {
  module Px = CP.Partials[G.ob x, A.ty x] ;
  module Py = CP.Partials[G.ob y, A.ty y] ;
  m (X : Ob) (w : SigT (G.ob x) (A.ty x) X) : SigT (G.ob y) (A.ty y) X = (A.tE y x f).nt X w ;
  ac (X : Ob) (g : W0.Ix ((G.ob x).ob X)) : W0.Ix ((G.ob y).ob X) = (G.act y x f).nt X g ;

  mapside (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (s : Px.Side[X, g]) : Py.Side[X, ac X g] =
   new Py.Side[X, ac X g, s.pQ, \ W h i -> m W (s.pv W h i),
    \ W h i -> transH (A.tE-pt y x f W (s.pv W h i))
                (transH (apH (\ z -> ac W z) (s.ppt W h i)) ((G.act y x f).nt-nat W X h g)),
    \ W' W chi h i i' -> transH (symH ((A.tE y x f).nt-nat W' W chi (s.pv W h i)))
                           (apH (m W') (s.pnat W' W chi h i i'))] ;

  -- mapside commutes with Join
  module MJ (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (r : Nat) (S : Arith[a].Fin r -> Px.Side[X, g])
   (c : (k k' : Arith[a].Fin r) (W : Ob) (h : Hom W X) (i : PB.Lands W X (S k).pQ h) (i' : PB.Lands W X (S k').pQ h)
        -> Id (GPR.TyL[G.ob x, A.ty x].EI W) ((S k).pv W h i) ((S k').pv W h i')) {
   module Jx = CP.Join[G.ob x, A.ty x, X, g, r, S, c] ;
   module Jy = CP.Join[G.ob y, A.ty y, X, ac X g, r, \ k -> mapside X g (S k),
     \ k k' W h i i' -> apH (m W) (c k k' W h i i')] ;
   mapside-join : Id (Py.Side[X, ac X g]) (mapside X g Jx.side) Jy.side =
    Py.side-ext X (ac X g) (mapside X g Jx.side) Jy.side (refl Jx.Q)
     (\ W h i i' -> apH (m W) (Px.pv-irr X g Jx.side W h i i')) ;
  } ;
 } ;

 ------------------------------------------------------------------
 -- uniformity in C of a family of relative contractibility structures

 module Unif (G : CCtx) (S T : CTy[G]) (mm : (x : CO) -> CP.PMap[G.ob x, S.ty x, T.ty x])
  (k : (x : CO) -> CP.Rel[G.ob x, S.ty x, T.ty x, mm x].RC) {
  CUnif : U l =
   (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (s : CP.Partials[G.ob x, S.ty x].Side[X, g])
   -> Id (SigT (G.ob y) (T.ty y) X)
       ((T.tE y x f).nt X (pairE (G.ob x) (T.ty x) X g ((k x).kop X g s)))
       (pairE (G.ob y) (T.ty y) X ((G.act y x f).nt X g)
          ((k y).kop X ((G.act y x f).nt X g) (MapSide[G, S, y, x, f].mapside X g s))) ;
 } ;

 UTriv (G : CCtx) (A : CTy[G]) : U l+ =
  (c : LTriv G A) * Unif[G, A, A, \ x -> CP.pmap-id (G.ob x) (A.ty x), c].CUnif ;
} ;
