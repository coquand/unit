-- CCeEq.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', on the
-- closed copy Ec of yo(y).A, for every term p of y.u: Q's evaluation of p at
-- the Q-tuple is homotopic to Q's evaluation at psi of the G-tuple (by
-- recursion on p: the variables by CCeVar, the constants on the nose, the
-- operations by CApOp2's congruence).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module EQ (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module VA = CCeVar[a].VA[R, encK, pe, y, u, y'] ;
 module TU = VA.TU ;
 module HO = TU.HO ;
 module E = TU.E ;
 module AQ = TU.AQ ;
 module AP = TU.AP ;
 Nl : L.PCtx = TU.Nl ;
 Ec : L.PTy[Nl] = TU.Ec ;
 Qc : L.PTy[Nl] = TU.Qc ;
 kk : Nat = TU.kk ;
 LQ (p : SX.Over[R].Expr (SX.Fin kk)) : HO.NMap[Nl, Ec, Qc] = HO.compN Nl Ec TU.PQt Qc TU.tupQ (AQ.evA kk p) ;
 LG (p : SX.Over[R].Expr (SX.Fin kk)) : HO.NMap[Nl, Ec, Qc] = HO.compN Nl Ec TU.PG Qc TU.tupG (AP.evGt kk p) ;
 module AOa = CApOp2[a].AO[Nl, Ec, Qc, E.addA, E.addAN] ;
 module AOm = CApOp2[a].AO[Nl, Ec, Qc, E.mulA, E.mulAN] ;
 ChainQ : (p : SX.Over[R].Expr (SX.Fin kk)) -> L.PEl[L.extP Nl Ec, HO.HT[Nl, Ec, Qc, LQ p, LG p].PT.PathP] = split {
  var v -> HO.Ret[Nl, Ec, Qc, VA.Av v, VA.Bv v, LQ (var v), LG (var v),
     \ I o w -> refl ((LQ (var v)).nfun I o w), \ I o w -> refl ((LG (var v)).nfun I o w), VA.VH[v].res].res ;
  cst r -> HO.Ret[Nl, Ec, Qc, LQ (cst r), LQ (cst r), LQ (cst r), LG (cst r),
     \ I o w -> refl ((LQ (cst r)).nfun I o w), \ I o w -> refl ((LG (cst r)).nfun I o w), HO.Rf[Nl, Ec, Qc, LQ (cst r)].res].res ;
  sumE p q | rp rq -> HO.Ret[Nl, Ec, Qc, AOa.OP (LQ p) (LQ q), AOa.OP (LG p) (LG q), LQ (sumE p q), LG (sumE p q),
     \ I o w -> refl ((LQ (sumE p q)).nfun I o w), \ I o w -> refl ((LG (sumE p q)).nfun I o w),
     AOa.Ap[LQ p, LG p, LQ q, LG q, rp, rq].res].res ;
  mulE p q | rp rq -> HO.Ret[Nl, Ec, Qc, AOm.OP (LQ p) (LQ q), AOm.OP (LG p) (LG q), LQ (mulE p q), LG (mulE p q),
     \ I o w -> refl ((LQ (mulE p q)).nfun I o w), \ I o w -> refl ((LG (mulE p q)).nfun I o w),
     AOm.Ap[LQ p, LG p, LQ q, LG q, rp, rq].res].res } ;
 -- G's evaluation at the copy is the total site's evaluation of the renamed term
 module TW = VA.TW ;
 n : Nat = TU.n ;
 m : Nat = TU.m ;
 GK (I : Ob) : U a+ = VA.GK I ;
 projLk : (j : Nat) (i : SX.Fin j) (I : Ob) (x0 : V1.Ix ((TU.PW.Gk j).ob (TU.CV.K0 I)))
  -> Id (GK I) ((AP.proj j i).nfun I tt (TU.cG0 j I x0)) (TW.E1.lk j i (TU.CV.K0 I) x0) = split {
  zero -> \ i -> absurd ((I : Ob) (x0 : V1.Ix ((TU.PW.Gk zero).ob (TU.CV.K0 I))) -> Id (GK I) ((AP.proj zero i).nfun I tt (TU.cG0 zero I x0)) (TW.E1.lk zero i (TU.CV.K0 I) x0)) i ;
  suc j | r -> split {
   inl v -> \ I x0 -> r v I x0.1 ;
   inr w -> \ I x0 -> refl x0.2 } } ;
 lk2cs (I : Ob) (x : V1.Ix ((VA.UP.Ex m).ob (TU.CV.K0 I))) : (c : VA.PlusNM)
  -> Id (GK I) (VA.csG m I (\ i -> TW.E1.lk n i (TU.CV.K0 I) (TW.dropN m (TU.CV.K0 I) x)) (\ k -> TW.lkX m k (TU.CV.K0 I) x) c) (TW.lk2 c (TU.CV.K0 I) x) = split {
  inl i -> refl (TW.E1.lk n i (TU.CV.K0 I) (TW.dropN m (TU.CV.K0 I) x)) ;
  inr k -> refl (TW.lkX m k (TU.CV.K0 I) x) } ;
 RN (p : SX.Over[R].Expr (SX.Fin kk)) : SX.Over[R].Expr TW.Var = SX.Rel[R].rename (SX.Fin kk) TW.Var (VA.AYm.spl m) p ;
 evIdG : (p : SX.Over[R].Expr (SX.Fin kk)) (I : Ob) (x : V1.Ix ((VA.UP.Ex m).ob (TU.CV.K0 I)))
  -> Id (GK I) ((AP.evA kk p).nfun I tt (TU.cG m I x)) (TW.ev (RN p) (TU.CV.K0 I) x) = split {
  var v -> \ I x -> transH (VA.GC m v I x)
     (transH (VA.csGc m I (\ i -> (AP.proj n i).nfun I tt (TU.cG0 n I (TW.dropN m (TU.CV.K0 I) x))) (\ i -> TW.E1.lk n i (TU.CV.K0 I) (TW.dropN m (TU.CV.K0 I) x))
        (\ k -> TW.lkX m k (TU.CV.K0 I) x) (\ i -> projLk n i I (TW.dropN m (TU.CV.K0 I) x)) (VA.AYm.spl m v))
       (lk2cs I x (VA.AYm.spl m v))) ;
  cst r -> \ I x -> refl (TU.H.cT r I tt) ;
  sumE p q | rp rq -> \ I x ->
   transH (apH {GK I} {GK I} (\ z -> E.AddO.opT I tt z ((AP.evA kk q).nfun I tt (TU.cG m I x))) (rp I x))
    (apH {GK I} {GK I} (\ z -> E.AddO.opT I tt (TW.ev (RN p) (TU.CV.K0 I) x) z) (rq I x)) ;
  mulE p q | rp rq -> \ I x ->
   transH (apH {GK I} {GK I} (\ z -> E.MulO.opT I tt z ((AP.evA kk q).nfun I tt (TU.cG m I x))) (rp I x))
    (apH {GK I} {GK I} (\ z -> E.MulO.opT I tt (TW.ev (RN p) (TU.CV.K0 I) x) z) (rq I x)) } ;
 -- Q's evaluation on Q-tuples is c2's evaluation
 module EV = TU.S1.EV ;
 QK (I : Ob) : U a+ = VA.QK I ;
 projLkQ : (j : Nat) (i : SX.Fin j) (I : Ob) (x0 : V1.Ix ((EV.Gk j).ob I))
  -> Id (QK I) ((AQ.proj j i).nfun I tt (TU.cQ j I x0)) (EV.lk j i I x0) = split {
  zero -> \ i -> absurd ((I : Ob) (x0 : V1.Ix ((EV.Gk zero).ob I)) -> Id (QK I) ((AQ.proj zero i).nfun I tt (TU.cQ zero I x0)) (EV.lk zero i I x0)) i ;
  suc j | r -> split {
   inl v -> \ I x0 -> r v I x0.1 ;
   inr w -> \ I x0 -> refl x0.2 } } ;
 evIdQ : (p : SX.Over[R].Expr (SX.Fin kk)) (I : Ob) (x : V1.Ix ((EV.Gk kk).ob I))
  -> Id (QK I) ((AQ.evA kk p).nfun I tt (TU.cQ kk I x)) (EV.ev kk p I x) = split {
  var v -> \ I x -> projLkQ kk v I x ;
  cst r -> \ I x -> refl (TU.H.cA r I tt) ;
  sumE p q | rp rq -> \ I x ->
   transH (apH {QK I} {QK I} (\ z -> E.addA I tt z ((AQ.evA kk q).nfun I tt (TU.cQ kk I x))) (rp I x))
    (apH {QK I} {QK I} (\ z -> E.addA I tt (EV.ev kk p I x) z) (rq I x)) ;
  mulE p q | rp rq -> \ I x ->
   transH (apH {QK I} {QK I} (\ z -> E.mulA I tt z ((AQ.evA kk q).nfun I tt (TU.cQ kk I x))) (rp I x))
    (apH {QK I} {QK I} (\ z -> E.mulA I tt (EV.ev kk p I x) z) (rq I x)) } ;
} ;
