-- CPshIdFib.seg (canonicity-45; (B) stage 2(b), COBAR.md): the Yoneda Id
-- of a uniformly fibrant C-type is uniformly fibrant, and the law of its
-- substitution.
--   YU[G, A, a, b, d, dc, kI, cuI]   the fibrations of the Yoneda Id at each
--            x are core's moved along the Yoneda iso (PosIdY (4), a cart
--            C_x : IdYT -> core IdT over the identity); the iso commutes
--            with the C-actions on readings (taC), hence on end data (sVC),
--            strict fibres (mSC) and totals of the other end (mTC); the
--            moved family is C-uniform when core's is (Res, as
--            CPshUFib.UP.Res with the iso in place of the pull-back cart)
--   idCl     the UFib of Id(a , b): PosIdY.fib at each x, YU in both
--            directions from CPshPathU.PU and CPshCoreIdU.IU
--   INat.law the law of substitution for (IdT , idCl): CPshId.IdNatC.nat
--            and the base's FibIdCen.idTy-nat at each x

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module CIm = PB.CId[l] ;
module PY = PosIdY[a, l] ;
module FIC = FibIdCen[a, l] ;

module IdFibOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module IdM = CPshId[a, l].IdOf[C] ;
 module PUm = CPshPathU[a, l].PathUOf[C] ;
 module CUm = CPshCoreIdU[a, l].CoreIdUOf[C] ;
 module M1 = CPshIdFibM[a, l].IdFibMOf[C] ;
 module M2 = CPshIdFibT[a, l].IdFibTOf[C] ;
 open P ;

 module YU (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) (e e' : PB.IPt)
  (kI : (x : CO) -> CL.Lines[G.ob x, CUm.CoreIdC[G, A, a0, b0].ty x].CompK[e, e'].Comp)
  (cuI : LO.UF[G, CUm.CoreIdC[G, A, a0, b0].IdT].UComp e e' kI) {
  module Y1 = M1.YU1[G, A, a0, b0, e, e', kI, cuI] ;
  module Y2 = M2.YU2[G, A, a0, b0, e, e', kI, cuI] ;
  module IC = Y1.IC ; module CI = Y1.CI ;
  Yt : CTy[G] = Y1.Yt ; Ct : CTy[G] = Y1.Ct ;
  module SFy = Y1.SFy ; module SFc = Y1.SFc ; module AEy = Y1.AEy ; module AEc = Y1.AEc ; module SCt-y = Y1.SCt-y ; module SCt-c = Y1.SCt-c ;
  module At (x : CO) { module M = Y1.At[x].M ; module E = Y1.At[x].E ; } ;
  sVC (y x : CO) (f : CH y x) (X : Ob) (w : AEy.TVT x X) : Id (AEc.TVT y X) (At[y].E.sV X (AEy.tEv y x f X w)) (AEc.tEv y x f X (At[x].E.sV X w)) = Y1.sVC y x f X w ;
  mSC (y x : CO) (f : CH y x) (W : Ob) (u : SFy.TST x W) : Id (SFc.TST y W) (At[y].E.mS W (SFy.tES y x f W u)) (SFc.tES y x f W (At[x].E.mS W u)) = Y1.mSC y x f W u ;
  mTC (y x : CO) (f : CH y x) (X : Ob) (v : At[x].M.TT'.EI X) : Id (At[y].M.TT.EI X) (At[y].M.mT X (SCt-y.tEs y x f X v)) (SCt-c.tEs y x f X (At[x].M.mT X v)) = Y2.mTC y x f X v ;

  -- the moved compositions
  module MV (x : CO) {
   module Mx = At[x].M ;
   k' : CL.Lines[G.ob x, Yt.ty x].CompK[e, e'].Comp = Mx.move (kI x) ;
  } ;

  module Res (y x : CO) (gC : CH y x) (X : Ob) (w : AEy.TVT x X)
   (sd : CP.Partials[SFy.TVC.ob x, SFy.SFC.ty x].Side[X, w]) {
   module Mx = At[x].M ;
   module My = At[y].M ;
   w' : AEy.TVT y X = AEy.tEv y x gC X w ;
   sm : CP.Partials[SFy.TVC.ob y, SFy.SFC.ty y].Side[X, w'] = MapSide[SFy.TVC, SFy.SFC, y, x, gC].mapside X w sd ;
   R : Id (CP.Partials[SFc.TVC.ob y, SFc.SFC.ty y].Side[X, At[y].E.sV X w'])
         (subst (AEc.TVT y X) (\ z -> CP.Partials[SFc.TVC.ob y, SFc.SFC.ty y].Side[X, z])
            (AEc.tEv y x gC X (At[x].E.sV X w)) (At[y].E.sV X w') (symH (sVC y x gC X w))
            (MapSide[SFc.TVC, SFc.SFC, y, x, gC].mapside X (At[x].E.sV X w) (Mx.mside (kI x) X w sd)))
         (My.mside (kI y) X w' sm) =
    CP.Partials[SFc.TVC.ob y, SFc.SFC.ty y].side-extH X (AEc.tEv y x gC X (At[x].E.sV X w)) (At[y].E.sV X w') (symH (sVC y x gC X w))
     (MapSide[SFc.TVC, SFc.SFC, y, x, gC].mapside X (At[x].E.sV X w) (Mx.mside (kI x) X w sd))
     (My.mside (kI y) X w' sm)
     (refl sd.pQ)
     (\ W h i i' -> transH (apH (\ v -> SFc.tES y x gC W (At[x].E.mS W v)) (CP.Partials[SFy.TVC.ob x, SFy.SFC.ty x].pv-irr X w sd W h i i'))
                    (symH (mSC y x gC W (sd.pv W h i')))) ;
   res : Id (SigT (SFy.TVC.ob y) ((SFy.TendC e').ty y) X)
           (((SFy.TendC e').tE y x gC).nt X (pairE (SFy.TVC.ob x) ((SFy.TendC e').ty x) X w (MV[x].k'.kop X w sd)))
           (pairE (SFy.TVC.ob y) ((SFy.TendC e').ty y) X ((SFy.TVC.act y x gC).nt X w) (MV[y].k'.kop X ((SFy.TVC.act y x gC).nt X w) (MapSide[SFy.TVC, SFy.SFC, y, x, gC].mapside X w sd))) =
    My.mTinj X (SCt-y.tEs y x gC X (pairE (SFy.TVC.ob x) (SCt-y.ST x) X w (MV[x].k'.kop X w sd))) (pairE (SFy.TVC.ob y) (SCt-y.ST y) X w' (MV[y].k'.kop X w' sm)) (refl w')
     (transH (mTC y x gC X (pairE (SFy.TVC.ob x) (SCt-y.ST x) X w (MV[x].k'.kop X w sd)))
       (transH (apH (SCt-c.tEs y x gC X) (Mx.kopMv (kI x) X w sd))
         (transH (cuI y x gC X (At[x].E.sV X w) (Mx.mside (kI x) X w sd))
           (transH (CP.Rel[SFc.TVC.ob y, SFc.SFC.ty y, SCt-c.ST y, CL.Lines[G.ob y, Ct.ty y].CompK[e, e'].endL].kop-cong
                      (kI y) X (AEc.tEv y x gC X (At[x].E.sV X w)) (At[y].E.sV X w') (symH (sVC y x gC X w))
                      (MapSide[SFc.TVC, SFc.SFC, y, x, gC].mapside X (At[x].E.sV X w) (Mx.mside (kI x) X w sd))
                      (My.mside (kI y) X w' sm) R)
             (symH (My.kopMv (kI y) X w' sm)))))) ;
  } ;

  res : LO.UF[G, Yt].UComp e e' (\ x -> MV[x].k') = \ y x gC X w sd -> Res[y, x, gC, X, w, sd].res ;
 } ;

 ------------------------------------------------------------------
 -- Id of a uniformly fibrant C-type is uniformly fibrant

 module IdCl (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) (uA : UF.Cl G A) {
  module IC = IdM.IdC[G, A, a0, b0] ;
  module PC = PUm.PathC[G, A, a0, b0] ;
  dc : CIm.DConj = PosId[a, l].dc ;
  module PU1 = PUm.PU[G, A, a0, b0, true, \ x -> (uA.1 x).1, uA.2.1] ;
  module PU2 = PUm.PU[G, A, a0, b0, false, \ x -> (uA.1 x).2, uA.2.2] ;
  module IU1 = CUm.IU[G, A, a0, b0, true, dc, PU1.kP, PU1.res] ;
  module IU2 = CUm.IU[G, A, a0, b0, false, dc, PU2.kP, PU2.res] ;
  module YU1 = YU[G, A, a0, b0, PB.e0, PB.e1, IU1.kI, IU1.res] ;
  module YU2 = YU[G, A, a0, b0, PB.e1, PB.e0, IU2.kI, IU2.res] ;
  idCl : UF.Cl G IC.IdT = (\ x -> IC.Y[x].I.fib (uA.1 x), (YU1.res, YU2.res)) ;
 } ;
 idCl (G : CCtx) (A : UF.FCC.STy G) (a0 b0 : CEl[G, A.1]) : UF.Cl G (IdM.IdC[G, A.1, a0, b0].IdT) = IdCl[G, A.1, a0, b0, A.2].idCl ;

 -- the law of substitution, from the base's at each x
 module INat (D G : CCtx) (A : UF.FCC.STy G) (a0 b0 : CEl[G, A.1]) (s : CSub[D, G]) {
  module IN = IdM.IdNatC[D, G, s, A.1, a0, b0] ;
  A' : UF.FCC.STy D = UF.FCC.subS D G A s ;
  a' : CEl[D, A'.1] = CW.subCEl D G A.1 a0 s ;
  b' : CEl[D, A'.1] = CW.subCEl D G A.1 b0 s ;
  Ig : CTy[G] = IN.IG.IdT ;
  Id' : CTy[D] = IN.ID.IdT ;
  Sg : CTy[D] = LO.subCTy D G s Ig ;
  base (x : CO) : Id (FibCwF[a, l].FC.STy (D.ob x))
    (FibCwF[a, l].FC.subS (D.ob x) (G.ob x) (IN.IG.ty x, IN.IG.Y[x].I.fib (A.2.1 x)) (s.sb x))
    (IN.ID.ty x, IN.ID.Y[x].I.fib (A'.2.1 x)) =
   FIC.idTy-nat (D.ob x) (G.ob x) (A.1.ty x, A.2.1 x) (a0.el x) (b0.el x) (s.sb x) ;
  opaque base ;
  law : Id (UF.FCC.STy D) (UF.FCC.subS D G (Ig, idCl G A a0 b0) s) (Id', idCl D A' a' b') =
   Sigma-path (CTy[D]) (UF.Cl D) Sg Id' (UF.clSubU D G s Ig (idCl G A a0 b0)) (idCl D A' a' b') IN.nat
    (UF.ufib-eq D Id' (subst (CTy[D]) (UF.Cl D) Sg Id' IN.nat (UF.clSubU D G s Ig (idCl G A a0 b0))) (idCl D A' a' b')
      (\ x ->
       transH (UF.fibTrC D Sg Id' IN.nat (UF.clSubU D G s Ig (idCl G A a0 b0)) x)
        (transH (apH (\ pp -> subst (PTy[D.ob x]) (\ T -> CL.Lines[D.ob x, T].Fib) (Sg.ty x) (Id'.ty x) pp
                               (PB.CFibSub[l].FibSub[D.ob x, G.ob x, s.sb x, Ig.ty x].sub (IN.IG.Y[x].I.fib (A.2.1 x))))
                   (isSet-PTy (D.ob x) (Sg.ty x) (Id'.ty x) (apH (\ X -> X.ty x) IN.nat) (apH (\ u -> u.1) (base x))))
          (UF.sigSnd (PTy[D.ob x]) (UF.FCL.Cl (D.ob x))
             (FibCwF[a, l].FC.subS (D.ob x) (G.ob x) (IN.IG.ty x, IN.IG.Y[x].I.fib (A.2.1 x)) (s.sb x))
             (IN.ID.ty x, IN.ID.Y[x].I.fib (A'.2.1 x)) (base x))))) ;
 } ;
} ;
