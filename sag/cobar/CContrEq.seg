-- CContrEq.seg (canonicity-45; COBAR.md "constants"): (1) IdRd: an
-- internal Id(t1, q) over G.Y read as a path homotopy al ~ id (EqQinv's
-- HtpyRd for any end t1 with its pointwise reading); (2) a contractible
-- fibrant type Y maps to a closed type U with equal points by an
-- equivalence: quasi-inverse the centre, the homotopies from the
-- contraction (IdRd) and from U's points being equal; QinvEq.QE.
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;
module FCw = FibCwF[a, l] ;
module FC = FCw.FC ;
module LR = CLocBoundRetr[a, l] ;
module OV = CwFOv.Ov[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module S4 = CwFS4.S4[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;
module RD = FibIdRd[a, l] ;
module QI = QinvEq[a, l] ;
module KI = CwFKrInv.KrInv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;

------------------------------------------------------------------------
-- a homotopy f ~ g as a pointwise identity of the bodies
module QP = CwFQP.QP[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module DR = CwFDer.Der[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;

-- an element of Fun P Q as a natural map
module SG = CwFSing.Sing[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;

module IdRd (G : PCtx) (Y : FC.STy G) (al : HO.NMap[G, Y.1, Y.1])
  (t1 : FCw.fibCwF.El (extP G Y.1) (OV.wkT G Y Y))
  (t1v : (W : Ob) (z : W0.Ix ((extP G Y.1).ob W)) -> Id (W0.Ix (Y.1.tob W (GPR.TyL[G, Y.1].pr1 W z))) (t1.eob W z) (al.nfun W (GPR.TyL[G, Y.1].pr1 W z) (GPR.TyL[G, Y.1].pr2 W z)))
  (hb : FCw.fibCwF.El (extP G Y.1) (FibId[a, l].fibId.IdT (extP G Y.1) (OV.wkT G Y Y) t1 (qP G Y.1))) {
  module T = HO.HT[G, Y.1, Y.1, al, HO.idN G Y.1] ;
  module TY = GPR.TyL[G, Y.1] ;
  K : PCtx = extP G Y.1 ;
  YY : FC.STy K = OV.wkT G Y Y ;
  module IY = PosIdY[a, l].IdY[K, YY.1, t1, qP G Y.1] ;
  mp (V : Ob) (q : IY.TA.EI V) : TY.EI V = TY.pr V (TY.pr1 V (IY.TA.pr1 V q)) (IY.TA.pr2 V q) ;
  tv (W : Ob) (z : W0.Ix (K.ob W)) (V : Ob) (g : Hom V W) (j : Hom V Iv) : TY.EI V = mp V (IY.rd W z (hb.eob W z) V g j) ;
  tn (W : Ob) (z : W0.Ix (K.ob W)) (V' V : Ob) (g' : Hom V' V) (g : Hom V W) (j : Hom V Iv)
    : Id (TY.EI V') (TY.E.act V' V g' (tv W z V g j)) (tv W z V' (compH V' V W g g') (compH V' V Iv j g')) =
    transH (TY.pr-tact V' V g' (TY.pr1 V (K.act V W g z)) (TY.pr1 V' (K.act V' W (compH V' V W g g') z))
              (ntEq K G (pP G Y.1) V' V g' (K.act V W g z) (K.act V' W (compH V' V W g g') z) (IY.ptn W z V' V g' g)) ((hb.eob W z).1.1 V g j))
      (apH (TY.pr V' (TY.pr1 V' (K.act V' W (compH V' V W g g') z))) ((hb.eob W z).1.2.1 V' V g' g j)) ;
  e0E (W : Ob) (z : W0.Ix (K.ob W)) : Id (TY.EI W) (tv W z W (idH W) (PB.ptH W PB.e0)) (T.aE W z) =
    transH (apH (TY.pr W (TY.pr1 W (K.act W W (idH W) z))) ((hb.eob W z).1.2.2.1 W (idH W)))
      (transH (apH {W0.Ix (K.ob W)} {TY.EI W} (\ z2 -> TY.pr W (TY.pr1 W z2) (t1.eob W z2)) (K.act-id W z))
        (apH (TY.pr W (TY.pr1 W z)) (t1v W z))) ;
  e1E (W : Ob) (z : W0.Ix (K.ob W)) : Id (TY.EI W) (tv W z W (idH W) (PB.ptH W PB.e1)) (T.bE W z) =
    transH (apH (TY.pr W (TY.pr1 W (K.act W W (idH W) z))) ((hb.eob W z).1.2.2.2 W (idH W)))
      (apH {W0.Ix (K.ob W)} {TY.EI W} (\ z2 -> TY.pr W (TY.pr1 W z2) ((qP G Y.1).eob W z2)) (K.act-id W z)) ;
  path (W : Ob) (z : W0.Ix (K.ob W)) : W0.Ix (T.PT.tobP W z) =
    T.PT.mkPath W z (tv W z) (\ V' V g' g j -> tn W z V' V g' g j) (\ V g j -> refl (G.act V W g (TY.pr1 W z))) (e0E W z) (e1E W z) ;
  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (K.ob I)) (z' : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' e (path I z)) (path J z')
      (\ V f i -> transH (symH (apH (mp V) (IY.Tact[J, I, h, z, z', e, hb.eob I z].rdc V f i)))
         (apH (\ w2 -> mp V (IY.rd J z' w2 V f i)) (hb.enat J I h z z' e))) ;
  res : PEl[K, T.PT.PathP] = new PEl[K, T.PT.PathP, path, enat] ;
} ;

-- a map of types with its point law as a natural map: the fibre part
-- coerced along the point law

-- a contractible type maps to a closed type with equal points by an equivalence
module CtrE (Y Ut : FC.STy FCw.fibCwF.nil) (kY : FCw.fibCwF.El FCw.fibCwF.nil (EQ.isContr FCw.fibCwF.nil Y))
  (tU : (I : Ob) (x : W0.Ix (FCw.fibCwF.nil.ob I)) -> W0.Ix (Ut.1.tob I x))
  (tUN : (J I : Ob) (h : Hom J I) (x : W0.Ix (FCw.fibCwF.nil.ob I)) (y : W0.Ix (FCw.fibCwF.nil.ob J)) (e : Id (W0.Ix (FCw.fibCwF.nil.ob J)) (FCw.fibCwF.nil.act J I h x) y)
     -> Id (W0.Ix (Ut.1.tob J y)) (Ut.1.tact J I h x y e (tU I x)) (tU J y))
  (uniq : (I : Ob) (x : W0.Ix (FCw.fibCwF.nil.ob I)) (u v : W0.Ix (Ut.1.tob I x)) -> Id (W0.Ix (Ut.1.tob I x)) u v) {
  N0 : PCtx = FCw.fibCwF.nil ;
  c : FCw.fibCwF.El N0 Y = SG.cenOf N0 Y kY ;
  fN : HO.NMap[N0, Y.1, Ut.1] = new HO.NMap[N0, Y.1, Ut.1, \ I x h -> tU I x, \ J I h x y e a0 -> tUN J I h x y e] ;
  gN : HO.NMap[N0, Ut.1, Y.1] = new HO.NMap[N0, Ut.1, Y.1, \ I x u -> c.eob I x, \ J I h x y e u -> c.enat J I h x y e] ;
  hb : FCw.fibCwF.El (extP N0 Y.1) (FibId[a, l].fibId.IdT (extP N0 Y.1) (OV.wkT N0 Y Y) (OV.wkE N0 Y Y c) (qP N0 Y.1)) =
   OV.bod N0 Y (FibId[a, l].fibId.IdT (extP N0 Y.1) (OV.wkT N0 Y Y) (OV.wkE N0 Y Y c) (qP N0 Y.1)) (SG.ctrPiOf N0 Y kY) ;
  module IR = IdRd[N0, Y, HO.compN N0 Y.1 Ut.1 Y.1 fN gN, OV.wkE N0 Y Y c, \ W z -> refl (c.eob W (GPR.TyL[N0, Y.1].pr1 W z)), hb] ;
  module EP = HO.Ret[N0, Ut.1, Ut.1, HO.idN N0 Ut.1, HO.idN N0 Ut.1, HO.compN N0 Ut.1 Y.1 Ut.1 gN fN, HO.idN N0 Ut.1,
    \ I x u -> uniq I x (tU I x) u, \ I x u -> refl u, HO.Rf[N0, Ut.1, Ut.1, HO.idN N0 Ut.1].res] ;
  module QE = QI.QE[N0, Y, Ut, fN, gN, IR.res, EP.res] ;
  eqf : CE.EquivOp N0 Y.1 Ut.1 LR.Map[N0, Y.1, Ut.1, fN].pmap = QE.qinvEq ;
} ;
