-- CDFw5.seg (canonicity-c2; (d)(1), part 5): for an equation p of u, the
-- equation holds at fwd's valuation: ev_p (fwd) = ev_p (z) = z (cls p) =
-- z (cls 0) = ev_0 (z) = ev_0 (fwd) (CDFw4.cg, CDEv6.h, the class Id of p's
-- derivation in x.u moved through z's evaluation).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module Fw5 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F4m = CDFw4[a].Fw4[R, encK, pe, x, u, y] ;
 module F3m = F4m.F3m ;
 module F2m = F3m.F2m ;
 module F1 = F3m.F1 ;
 module DE = F1.DE ;
 module C1 = F3m.C1 ;
 module H6 = CDEv6[a].DE6[R, encK, pe, F1.xu, y] ;
 module Dc = SX.Over[R].Der[F1.xu] ;
 Nl : C.Ctx = C.nil ;
 m : Nat = F1.m ;
 D1 : C.Ctx = F1.D1 ;
 QYd : C.Ty D1 = DE.QYd ;
 Tm : U a = SX.Over[R].Expr (F2m.Fk m) ;
 open Ring[a] ;
 -- membership of u's equations in x.u's
 memR (p : Tm) (mm : Dc.Member p u.2) : (es : List Tm) -> Dc.Member p (SX.appL Tm es u.2) = split {
  nil -> mm ;
  cons q qs | r -> inr r } ;
 inU (p : Tm) (mm : Dc.Member p u.2) : Dc.Member p F1.xu.2 =
  memR p mm (SX.mapL (SX.Over[R].Expr (SX.Fin x.1)) Tm (SX.Rel[R].rename (SX.Fin x.1) (F2m.Fk m) (SX.emb x.1 u.1)) x.2) ;
 -- the chain for an equation p of u
 rel (p : Tm) (mm : Dc.Member p u.2) : C.El D1 (IJ.IdT D1 QYd (C1.ev2T p) (C1.ev2T Dc.zeroE)) =
  PT.transM D1 QYd (C1.ev2T p) (DE.evT p) (C1.ev2T Dc.zeroE)
   (PT.symM D1 QYd (DE.evT p) (C1.ev2T p) (F4m.cg p))
   (PT.transM D1 QYd (DE.evT p) (DE.apZ (F3m.PM.AT.cls p)) (C1.ev2T Dc.zeroE)
     (PT.symM D1 QYd (DE.apZ (F3m.PM.AT.cls p)) (DE.evT p) (H6.h p))
     (PT.transM D1 QYd (DE.apZ (F3m.PM.AT.cls p)) (DE.apZ (F3m.PM.AT.cls Dc.zeroE)) (C1.ev2T Dc.zeroE)
       (F3m.mv (F3m.PM.AT.cls p) (F3m.PM.AT.cls Dc.zeroE) (F3m.PM.AT.clsEq p Dc.zeroE (Dc.equationP p (inU p mm))))
       (PT.transM D1 QYd (DE.apZ (F3m.PM.AT.cls Dc.zeroE)) (DE.evT Dc.zeroE) (C1.ev2T Dc.zeroE)
         (H6.h Dc.zeroE) (F4m.cg Dc.zeroE)))) ;
} ;
