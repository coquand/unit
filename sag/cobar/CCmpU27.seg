-- CCmpU27.seg (canonicity-c2; (K) for cmpI, part 27): (U) at the classes in
-- the form of ext1H, and ext1H: the two map components agree as functions.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module U27 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module U26m = CCmpU26[a].U26[R, encK, pe, y] ;
 module U24m = CCmpU24[a].U24[R, encK, pe, y] ;
 module U13m = U24m.U13m ;
 module AS = U24m.AS ;
 Nl : C.Ctx = C.nil ;
 H : C.Ty Nl = U26m.H ;
 GH : C.Ctx = U26m.GH ;
 QA : C.Ty Nl = U26m.QA ;
 QY : C.Ty Nl = U26m.QY ;
 QH : C.Ty GH = U26m.QH ;
 QYh : C.Ty GH = U26m.QYh ;
 module ZA = U26m.Z[U13m.ZA.e] ;
 module ZB = U26m.Z[U13m.ZB.e] ;
 apA (c : C.El Nl QA) : C.El GH QYh = OV.app GH QH QYh ZA.f (OV.wkE Nl H QA c) ;
 apB (c : C.El Nl QA) : C.El GH QYh = OV.app GH QH QYh ZB.f (OV.wkE Nl H QA c) ;
 rA (c : C.El Nl QA) (K : Ob) : (o : Top) (h : V1.Ix (H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) ((U13m.ZA.apC c).eob K (o, h)) ((apA c).eob K (o, h)) =
  split { tt -> \ h -> transH (U13m.ZA.rdF c K (tt, h)) (symH (ZA.rd0 c K h)) } ;
 rB (c : C.El Nl QA) (K : Ob) : (o : Top) (h : V1.Ix (H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) ((U13m.ZB.apC c).eob K (o, h)) ((apB c).eob K (o, h)) =
  split { tt -> \ h -> transH (U13m.ZB.rdF c K (tt, h)) (symH (ZB.rd0 c K h)) } ;
 h2 (t : AS.AX.Term) : C.El GH (IJ.IdT GH QYh (apA (AS.AX.cls t)) (apB (AS.AX.cls t))) =
  CCmpU14[a].rwId GH QYh (U13m.ZA.apC (AS.AX.cls t)) (apA (AS.AX.cls t)) (U13m.ZB.apC (AS.AX.cls t)) (apB (AS.AX.cls t))
   (\ K w -> rA (AS.AX.cls t) K w.1 w.2) (\ K w -> rB (AS.AX.cls t) K w.1 w.2) (U24m.h t) ;
 module E6 = U13m.E6 ;
 qq : Id (C.Ty GH) QH E6.EPH[H].QH = refl QH ;
 qc (t : AS.AX.Term) : Id (C.El Nl QA) (AS.AX.cls t) (E6.AX.cls t) = refl (AS.AX.cls t) ;
 qf : Id (C.Ty GH) (OV.Fun GH QH QYh) (OV.Fun GH E6.EPH[H].QH (OV.wkT Nl H QY)) = refl (OV.Fun GH QH QYh) ;
 -- moving app along an Id of the domain type
 appX (X : C.Ty GH) (P : Id (C.Ty GH) QH X) (f : C.El GH (OV.Fun GH QH QYh)) (a : C.El GH QH)
   : Id (C.El GH QYh) (OV.app GH QH QYh f a)
        (OV.app GH X QYh (subst (C.Ty GH) (\ T -> C.El GH (OV.Fun GH T QYh)) QH X P f) (subst (C.Ty GH) (\ T -> C.El GH T) QH X P a)) =
  idJ (C.Ty GH) QH (\ X2 P2 -> Id (C.El GH QYh) (OV.app GH QH QYh f a)
        (OV.app GH X2 QYh (subst (C.Ty GH) (\ T -> C.El GH (OV.Fun GH T QYh)) QH X2 P2 f) (subst (C.Ty GH) (\ T -> C.El GH T) QH X2 P2 a)))
   (refl (OV.app GH QH QYh f a)) X P ;
 QH6 : C.Ty GH = E6.EPH[H].QH ;
 a6 (f : C.El GH (OV.Fun GH QH QYh)) (t : E6.AX.Term) : C.El GH QYh = OV.app GH QH6 QYh f (OV.wkE Nl H E6.Qt (E6.AX.cls t)) ;
 mA (t : E6.AX.Term) : Id (C.El GH QYh) (apA (AS.AX.cls t)) (a6 ZA.f t) = appX QH6 (refl QH) ZA.f (OV.wkE Nl H QA (AS.AX.cls t)) ;
 mB (t : E6.AX.Term) : Id (C.El GH QYh) (apB (AS.AX.cls t)) (a6 ZB.f t) = appX QH6 (refl QH) ZB.f (OV.wkE Nl H QA (AS.AX.cls t)) ;
 h3 (t : E6.AX.Term) : C.El GH (IJ.IdT GH QYh (a6 ZA.f t) (a6 ZB.f t)) =
  subst (C.El GH QYh) (\ u -> C.El GH (IJ.IdT GH QYh (a6 ZA.f t) u)) (apB (AS.AX.cls t)) (a6 ZB.f t) (mB t)
   (subst (C.El GH QYh) (\ u -> C.El GH (IJ.IdT GH QYh u (apB (AS.AX.cls t)))) (apA (AS.AX.cls t)) (a6 ZA.f t) (mA t) (h2 t)) ;
 sB : CQCtx[a].G3Of[QY].SetQiTy = CwFQuotElim1[a].QE1[R, encK, y, pe].setQi ;
} ;
