-- CHomT13.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 10: HomT's fibres come
-- back, alpha (beta z) = z: the function part on the nose, each datum by
-- Pi extensionality (piCode-eq) with its family's transports cancelled.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module RT2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module TM = CHomT8[a].ToM[R, encK, pe, s, t] ;
 module FM = CHomT11[a].FromM[R, encK, pe, s, t] ;
 module P = TM.P ;
 module F = P.F ;
 module H = P.H ;
 module At (I : Ob) (z : P.Z I) {
  m : F.M I = TM.beta I z ;
  ph : F.Fam I = z.1.1 ;
  x : V1.Ix (H.B0.Gh.ob I) = (tt, z.1) ;
  module BA = FM.RA.Back[I, m.1.1, m.1.2, m.2.1.1, m.2.1.2] ;
  module BM = FM.RM.Back[I, m.1.1, m.1.2, m.2.2.1.1, m.2.2.1.2] ;
  module BC = FM.RC.Back[I, m.1.1, m.1.2, \ r -> (m.2.2.2 r).1, \ r -> (m.2.2.2 r).2] ;
  eA : Id (V1.Ix (H.BA.DataBin.1.tob I x)) BA.piEl z.2.1 =
   FM.RA.PC.piCode-eq I (FM.RA.PC.ptOf I x) (FM.RA.PC.cOf I x) (FM.RA.PC.eOf I x) BA.piEl z.2.1 (\ K f wp ->
    CHomT12[a].sInvL (Hom K I) (\ k -> V1.Ix (FM.RA.IT.1.tob K (F.T.mk3 K (F.mp3 I ph K k (wp.1, (wp.2.1, wp.2.2.1))))))
     (compH K K I f (idH K)) f (comp-idr K I f) (z.2.1.1 K f wp)) ;
  eM : Id (V1.Ix (H.BM.DataBin.1.tob I x)) BM.piEl z.2.2.1 =
   FM.RM.PC.piCode-eq I (FM.RM.PC.ptOf I x) (FM.RM.PC.cOf I x) (FM.RM.PC.eOf I x) BM.piEl z.2.2.1 (\ K f wp ->
    CHomT12[a].sInvL (Hom K I) (\ k -> V1.Ix (FM.RM.IT.1.tob K (F.T.mk3 K (F.mp3 I ph K k (wp.1, (wp.2.1, wp.2.2.1))))))
     (compH K K I f (idH K)) f (comp-idr K I f) (z.2.2.1.1 K f wp)) ;
  module CC (K : Ob) (f : Hom K I) (wq : V1.Ix (H.CS.Wc.1.tob K tt)) {
   r : R.R = wq.1 ;
   u : F.S.QK K = wq.2.1 ;
   module Q = FM.RC.RR[r] ;
   module CR = P.CR[r] ;
   cT (K2 : Ob) : F.T.QK K2 = (P.HP.Alg[t].AX.cls (cst r)).eob K2 tt ;
   Zf (k : Hom K I) : U a+ = V1.Ix (FM.RC.IG.1.tob K ((tt, cT K), ph K k u)) ;
   pS2 : V1.Ix (Q.AS.1.tob K (tt, u)) =
    subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) CR.PS.CT.IdCst Q.AS (symH CR.PS.IdP)
     (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) Q.AS CR.PS.CT.IdCst CR.PS.IdP wq.2.2) ;
   inner : Zf (compH K K I f (idH K)) = z.2.2.2.1 K f (r, (u, pS2)) ;
   s1 : Id (Zf f) (subst (C.Ty CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, ph K f u))) CR.PT.CT.IdCst Q.AT (symH CR.PT.IdP)
                    (subst (C.Ty CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, ph K f u))) Q.AT CR.PT.CT.IdCst CR.PT.IdP
                       (subst (Hom K I) (\ k -> Zf k) (compH K K I f (idH K)) f (comp-idr K I f) inner)))
                 (subst (Hom K I) (\ k -> Zf k) (compH K K I f (idH K)) f (comp-idr K I f) inner) =
    CHomT10[a].trInvL CR.PT.Q3.G1 Q.AT CR.PT.CT.IdCst CR.PT.IdP K (tt, ph K f u) (subst (Hom K I) (\ k -> Zf k) (compH K K I f (idH K)) f (comp-idr K I f) inner) ;
   s2 : Id (Zf (compH K K I f (idH K))) (subst (Hom K I) (\ k -> Zf k) f (compH K K I f (idH K)) (symH (comp-idr K I f))
                                          (subst (Hom K I) (\ k -> Zf k) (compH K K I f (idH K)) f (comp-idr K I f) inner)) inner =
    CHomT12[a].sInvL (Hom K I) (\ k -> Zf k) (compH K K I f (idH K)) f (comp-idr K I f) inner ;
   s3 : Id (Zf (compH K K I f (idH K))) inner (z.2.2.2.1 K f wq) =
    apH {V1.Ix (Q.AS.1.tob K (tt, u))} {Zf (compH K K I f (idH K))} (\ q -> z.2.2.2.1 K f (r, (u, q)))
     (CHomT10[a].trInvL CR.PS.Q3.G1 Q.AS CR.PS.CT.IdCst CR.PS.IdP K (tt, u) wq.2.2) ;
   law : Id (Zf (compH K K I f (idH K))) (BC.phiC K f wq) (z.2.2.2.1 K f wq) =
    transH (apH {Zf f} {Zf (compH K K I f (idH K))} (\ v -> subst (Hom K I) (\ k -> Zf k) f (compH K K I f (idH K)) (symH (comp-idr K I f)) v) s1)
     (transH s2 s3) ;
  } ;
  eC : Id (V1.Ix (H.CS.DataCst.1.tob I x)) BC.piEl z.2.2.2 =
   FM.RC.PCc.piCode-eq I (FM.RC.PCc.ptOf I x) (FM.RC.PCc.cOf I x) (FM.RC.PCc.eOf I x) BC.piEl z.2.2.2 (\ K f wq -> CC[K, f, wq].law) ;
  rt : Id (P.Z I) (FM.alpha I m) z =
   transH (apH {V1.Ix (H.BA.DataBin.1.tob I x)} {P.Z I} (\ v -> (z.1, (v, (BM.piEl, BC.piEl)))) eA)
    (transH (apH {V1.Ix (H.BM.DataBin.1.tob I x)} {P.Z I} (\ v -> (z.1, (z.2.1, (v, BC.piEl)))) eM)
      (apH {V1.Ix (H.CS.DataCst.1.tob I x)} {P.Z I} (\ v -> (z.1, (z.2.1, (z.2.2.1, v)))) eC)) ;
 } ;
} ;
