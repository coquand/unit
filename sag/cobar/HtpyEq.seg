-- HtpyEq.seg (canonicity-45; COBAR.md "Lemma 16"): core's equivalence
-- structure moves along a homotopy.
--   Input: f, g : A -> B natural maps between fibrant types, a homotopy
--   H : f ~ g (CHtpyOps.HT), and CEquiv.EquivOp of f (as LR.Map's PMap).
--   Output: EquivOp of g.
-- Through the CwF of fibrant types:
--   HtpyOf2  H as an element of Pi A (Id (bod fC) (bod gC)) (FibNF.LineY
--            on the readings of H at (id, j), ends by QinvEq.FunOf.bod-eq)
--   HE       FibS3 S3a (EquivOp -> Kr, after retargeting f to the body of
--            fC by CHFibCart.moveEq), c2's CwFKrInv.krHt (Kr moves along
--            the homotopy), FibS3 S3b (Kr -> EquivOp), retargeted to g.
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;
module FCw = FibCwF[a, l] ;
module FC = FCw.FC ;
module LR = CLocBoundRetr[a, l] ;
module OV = CwFOv.Ov[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module S4 = CwFS4.S4[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;
module RD = FibIdRd[a, l] ;
module QI = QinvEq[a, l] ;
module KI = CwFKrInv.KrInv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;

------------------------------------------------------------------------
-- a homotopy f ~ g as a pointwise identity of the bodies

module HtpyOf2 (G : PCtx) (A B : FC.STy G) (f g : HO.NMap[G, A.1, B.1])
  (H : PEl[extP G A.1, HO.HT[G, A.1, B.1, f, g].PT.PathP]) {
  module T = HO.HT[G, A.1, B.1, f, g] ;
  module TA = GPR.TyL[G, A.1] ;
  module TB = GPR.TyL[G, B.1] ;
  K : PCtx = extP G A.1 ;
  module FF = QI.FunOf[G, A, B, f] ;
  module FG = QI.FunOf[G, A, B, g] ;
  BA : FC.STy K = OV.wkT G A B ;
  tf : FCw.fibCwF.El K BA = OV.bod G A BA FF.fC ;
  tg : FCw.fibCwF.El K BA = OV.bod G A BA FG.fC ;

  pvz (W : Ob) (z : W0.Ix (K.ob W)) (j : Hom W Iv) : TB.EI W = T.pv H W z W (idH W) j ;
  pteq (W : Ob) (z : W0.Ix (K.ob W)) (j : Hom W Iv) : Id (W0.Ix (G.ob W)) (TB.pr1 W (pvz W z j)) (TA.pr1 W z) =
    transH ((H.eob W z).2.1 W (idH W) j) (G.act-id W (TA.pr1 W z)) ;
  Lf (W : Ob) (z : W0.Ix (K.ob W)) (j : Hom W Iv) : W0.Ix (B.1.tob W (TA.pr1 W z)) =
    TB.coeT W (TB.pr1 W (pvz W z j)) (TA.pr1 W z) (pteq W z j) (TB.pr2 W (pvz W z j)) ;
  Lf-rd (W : Ob) (z : W0.Ix (K.ob W)) (j : Hom W Iv) : Id (TB.EI W) (TB.pr W (TA.pr1 W z) (Lf W z j)) (pvz W z j) =
    symH (TB.pr-coe W (TB.pr1 W (pvz W z j)) (TA.pr1 W z) (pteq W z j) (TB.pr2 W (pvz W z j))) ;

  Unat (V W : Ob) (g0 : Hom V W) (z : W0.Ix (K.ob W)) (z' : W0.Ix (K.ob V)) (E : Id (W0.Ix (K.ob V)) (K.act V W g0 z) z') (j : Hom W Iv)
    : Id (W0.Ix (BA.1.tob V z')) (BA.1.tact V W g0 z z' E (Lf W z j)) (Lf V z' (compH V W Iv j g0)) =
    TB.pr-inj V (TA.pr1 V z') (BA.1.tact V W g0 z z' E (Lf W z j)) (Lf V z' (compH V W Iv j g0))
      (calc (TB.EI V) {
          TB.pr V (TA.pr1 V z') (BA.1.tact V W g0 z z' E (Lf W z j))
        =< symH (TB.pr-tact V W g0 (TA.pr1 W z) (TA.pr1 V z') (ntEq K G (pP G A.1) V W g0 z z' E) (Lf W z j)) >
          TB.E.act V W g0 (TB.pr W (TA.pr1 W z) (Lf W z j))
        =< apH (TB.E.act V W g0) (Lf-rd W z j) >
          TB.E.act V W g0 (pvz W z j)
        =< (H.eob W z).1.2 V W g0 (idH W) j >
          T.pv H W z V (compH V W W (idH W) g0) (compH V W Iv j g0)
        =< apH (\ k -> T.pv H W z V k (compH V W Iv j g0)) (transH (PB.comp-idl V W g0) (symH (PB.comp-idr V W g0))) >
          T.pv H W z V (compH V V W g0 (idH V)) (compH V W Iv j g0)
        =< T.pv-res H V W g0 z z' E V (idH V) (compH V W Iv j g0) >
          pvz V z' (compH V W Iv j g0)
        =< symH (Lf-rd V z' (compH V W Iv j g0)) >
          TB.pr V (TA.pr1 V z') (Lf V z' (compH V W Iv j g0)) }) ;

  U0 (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (B.1.tob W (TA.pr1 W z))) (Lf W z (PB.ptH W PB.e0)) (tf.eob W z) =
    TB.pr-inj W (TA.pr1 W z) (Lf W z (PB.ptH W PB.e0)) (tf.eob W z)
      (transH (Lf-rd W z (PB.ptH W PB.e0))
        (transH (H.eob W z).2.2.1
          (apH (TB.pr W (TA.pr1 W z)) (symH (FF.bod-eq W z))))) ;

  U1 (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (B.1.tob W (TA.pr1 W z))) (Lf W z (PB.ptH W PB.e1)) (tg.eob W z) =
    TB.pr-inj W (TA.pr1 W z) (Lf W z (PB.ptH W PB.e1)) (tg.eob W z)
      (transH (Lf-rd W z (PB.ptH W PB.e1))
        (transH (H.eob W z).2.2.2
          (apH (TB.pr W (TA.pr1 W z)) (symH (FG.bod-eq W z))))) ;

  module LY = FibNF[a, l].LineY[K, BA.1, tf, tg, Lf, Unat, U0, U1] ;

  htpy : FCw.fibCwF.El G (FCw.fibPi.Pi G A (FibId[a, l].fibId.IdT K BA tf tg)) = OV.lam G A (FibId[a, l].fibId.IdT K BA tf tg) LY.el ;
} ;

------------------------------------------------------------------------
-- the theorem

module HE (G : PCtx) (A B : FC.STy G) (f g : HO.NMap[G, A.1, B.1])
  (H : PEl[extP G A.1, HO.HT[G, A.1, B.1, f, g].PT.PathP])
  (eop : CE.EquivOp G A.1 B.1 LR.Map[G, A.1, B.1, f].pmap) {
  module TA = GPR.TyL[G, A.1] ;
  module TB = GPR.TyL[G, B.1] ;
  module HO2 = HtpyOf2[G, A, B, f, g, H] ;
  module FF = HO2.FF ;
  module FG = HO2.FG ;
  module S3f = FibS3[a, l].S3[G, B, A, FF.fC] ;
  module S3g = FibS3[a, l].S3[G, B, A, FG.fC] ;
  fM : CP.PMap[G, A.1, B.1] = LR.Map[G, A.1, B.1, f].pmap ;
  gM : CP.PMap[G, A.1, B.1] = LR.Map[G, A.1, B.1, g].pmap ;
  alf-eq (W : Ob) (w : TA.EI W) : Id (TB.EI W) (S3f.al.mE W w) (fM.mE W w) =
    apH (TB.pr W (TA.pr1 W w)) (FF.bod-eq W w) ;
  alg-eq (W : Ob) (w : TA.EI W) : Id (TB.EI W) (S3g.al.mE W w) (gM.mE W w) =
    apH (TB.pr W (TA.pr1 W w)) (FG.bod-eq W w) ;

  -- f's structure on the body of fC
  module HCf = PB.CHFibCart[l, l].HCart[G, A.1, B.1, S3f.al, G, A.1, B.1, fM,
     \ W d -> d, \ V W g0 d -> refl (G.act V W g0 d),
     \ W v -> v, \ W v -> refl (TB.pr1 W v), \ V W g0 v -> refl (TB.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TB.pr X x u),
     \ W v -> v, \ W v -> refl (TA.pr1 W v), \ V W g0 v -> refl (TA.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TA.pr X x u),
     \ W v -> alf-eq W v] ;
  eopf : CE.EquivOp G A.1 B.1 S3f.al = HCf.moveEq eop ;

  kf : FCw.fibCwF.El G (KI.QP.Kr G B A FF.fC) = S3f.A[eopf].k ;
  kg : FCw.fibCwF.El G (KI.QP.Kr G B A FG.fC) = KI.krHt G B A FF.fC FG.fC HO2.htpy kf ;
  eopg : CE.EquivOp G A.1 B.1 S3g.al = S3g.B[kg].eop ;

  module HCg = PB.CHFibCart[l, l].HCart[G, A.1, B.1, gM, G, A.1, B.1, S3g.al,
     \ W d -> d, \ V W g0 d -> refl (G.act V W g0 d),
     \ W v -> v, \ W v -> refl (TB.pr1 W v), \ V W g0 v -> refl (TB.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TB.pr X x u),
     \ W v -> v, \ W v -> refl (TA.pr1 W v), \ V W g0 v -> refl (TA.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TA.pr X x u),
     \ W v -> symH (alg-eq W v)] ;

  htpyEq : CE.EquivOp G A.1 B.1 gM = HCg.moveEq eopg ;
} ;
