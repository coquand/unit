-- CwFSetX1.seg (canonicity-c2; SIMPLIFIED.md item 3, the quotient's
-- set-ness): the relation of two predicates P Q : B -> PropU,
--     Rel(P , Q) = Pi (b : B) (Dec P b -> Dec Q b) x (Dec Q b -> Dec P b),
-- in a CwF with Pi, Sigma, Swan Id, a universe and naive funext NF:
--   rflR      Rel(P , P) (the identities)
--   prodProp  a product of propositions is a proposition (propOver, sigC)
--   pRel      Rel(P , Q) is a proposition
--   RelN      Rel is stable under substitution (bodNat, Dec-nat, Fun-ov,
--             Sig-ov, Pi-ov; by J on the path of B to the case of a lift)
open Base ;

module SetX1 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module PPp = CwFPropProp.PropProp[l, C, PS, SS, IJ, Un, NF] ;
  module SC = CwFSigC.SigC[l, C, PS, SS, IJ] ;

  FunU (D : Ctx) (B : Ty D) : Ty D = Fun D B (PU.PropU D) ;

  module RelOf (D : Ctx) (B : Ty D) (P Q : El D (FunU D B)) {
    DB : Ctx = ext D B ;
    WU : Ty DB = wkT D B (PU.PropU D) ;
    PWU : Id (Ty DB) WU (PU.PropU DB) = PU.PropU-ov DB D (p D B) ;
    mP : El DB (PU.PropU DB) = trE DB WU (PU.PropU DB) PWU (bod D B WU P) ;
    mQ : El DB (PU.PropU DB) = trE DB WU (PU.PropU DB) PWU (bod D B WU Q) ;
    TP : Ty DB = PU.DecP DB mP ;
    TQ : Ty DB = PU.DecP DB mQ ;
    F1 : Ty DB = Fun DB TP TQ ;
    F2 : Ty DB = Fun DB TQ TP ;
    S : Ty DB = SS.Sig DB F1 (wkT DB F1 F2) ;
    Rel : Ty D = PS.Pi D B S ;
  } ;
  Rel (D : Ctx) (B : Ty D) (P Q : El D (FunU D B)) : Ty D = RelOf[D, B, P, Q].Rel ;

  -- reflexivity
  rflR (D : Ctx) (B : Ty D) (P : El D (FunU D B)) : El D (Rel D B P P) =
    lam D B RelOf[D, B, P, P].S
      (IN.pr RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1 (wkT RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1 RelOf[D, B, P, P].F1)
         (IN.idF RelOf[D, B, P, P].DB RelOf[D, B, P, P].TP)
         (trE RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1
            (subT RelOf[D, B, P, P].DB (ext RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1) (wkT RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1 RelOf[D, B, P, P].F1)
               (sec RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1 (IN.idF RelOf[D, B, P, P].DB RelOf[D, B, P, P].TP)))
            (sym (Ty RelOf[D, B, P, P].DB)
               (subT RelOf[D, B, P, P].DB (ext RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1) (wkT RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1 RelOf[D, B, P, P].F1)
                  (sec RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1 (IN.idF RelOf[D, B, P, P].DB RelOf[D, B, P, P].TP)))
               RelOf[D, B, P, P].F1
               (p-sec-T RelOf[D, B, P, P].DB RelOf[D, B, P, P].F1 RelOf[D, B, P, P].F1 (IN.idF RelOf[D, B, P, P].DB RelOf[D, B, P, P].TP)))
            (IN.idF RelOf[D, B, P, P].DB RelOf[D, B, P, P].TP))) ;

  -- a product of propositions is a proposition
  module PrP (G : Ctx) (A B : Ty G) (pA : El G (PU.isProp G A)) (pB : El G (PU.isProp G B)) {
    S : Ty G = SS.Sig G A (wkT G A B) ;
    GS : Ctx = ext G S ;
    A1 : Ty GS = wkT G S A ;
    B1 : Ty GS = wkT G S B ;
    S1 : Ty GS = SS.Sig GS A1 (wkT GS A1 B1) ;
    PS1 : Id (Ty GS) (wkT G S S) S1 =
      Sig-ov GS G A (wkT G A B) (p G S) A1 (refl A1) (wkT GS A1 B1) (wkT-ov GS G A B (p G S) A1 (refl A1) B1 (refl B1)) ;
    w0 : El GS S1 = trE GS (wkT G S S) S1 PS1 (q G S) ;
    a0 : El GS A1 = IN.fst GS A1 (wkT GS A1 B1) w0 ;
    b0 : El GS B1 =
      trE GS (subT GS (ext GS A1) (wkT GS A1 B1) (sec GS A1 a0)) B1 (p-sec-T GS A1 B1 a0) (IN.snd GS A1 (wkT GS A1 B1) w0) ;
    kA : El GS (EQ.isContr GS A1) = PPp.contrOfProp GS A1 (PU.wkProp G S A pA) a0 ;
    kB : El (ext GS A1) (EQ.isContr (ext GS A1) (wkT GS A1 B1)) =
      PPp.contrOfProp (ext GS A1) (wkT GS A1 B1) (PU.wkProp GS A1 B1 (PU.wkProp G S B pB)) (wkE GS A1 B1 b0) ;
    kS : El GS (EQ.isContr GS (wkT G S S)) =
      trE GS (EQ.isContr GS S1) (EQ.isContr GS (wkT G S S))
        (ap (Ty GS) (Ty GS) (\ X -> EQ.isContr GS X) S1 (wkT G S S) (sym (Ty GS) (wkT G S S) S1 PS1))
        (SC.sigC GS A1 (wkT GS A1 B1) kA kB) ;
    prodProp : El G (PU.isProp G S) = PPp.propOver G S kS ;
  } ;
  prodProp (G : Ctx) (A B : Ty G) (pA : El G (PU.isProp G A)) (pB : El G (PU.isProp G B))
    : El G (PU.isProp G (SS.Sig G A (wkT G A B))) = PrP[G, A, B, pA, pB].prodProp ;

  -- Rel is a proposition
  funProp (G : Ctx) (A B : Ty G) (pB : El G (PU.isProp G B)) : El G (PU.isProp G (Fun G A B)) =
    PPp.piProp G A (wkT G A B) (PU.wkProp G A B pB) ;
  pRel (D : Ctx) (B : Ty D) (P Q : El D (FunU D B)) : El D (PU.isProp D (Rel D B P Q)) =
    PPp.piProp D B RelOf[D, B, P, Q].S
      (prodProp RelOf[D, B, P, Q].DB RelOf[D, B, P, Q].F1 RelOf[D, B, P, Q].F2
         (funProp RelOf[D, B, P, Q].DB RelOf[D, B, P, Q].TP RelOf[D, B, P, Q].TQ (PU.decProp RelOf[D, B, P, Q].DB RelOf[D, B, P, Q].mQ))
         (funProp RelOf[D, B, P, Q].DB RelOf[D, B, P, Q].TQ RelOf[D, B, P, Q].TP (PU.decProp RelOf[D, B, P, Q].DB RelOf[D, B, P, Q].mP))) ;

  -- stability under substitution, along a lift
  PF (E D : Ctx) (s : Sub E D) (B : Ty D) (B' : Ty E) (PB : Id (Ty E) (subT E D B s) B')
    : Id (Ty E) (subT E D (FunU D B) s) (FunU E B') =
    Fun-ov E D B (PU.PropU D) s B' PB (PU.PropU E) (PU.PropU-ov E D s) ;
  module N0 (E D : Ctx) (s : Sub E D) (B : Ty D) (P Q : El D (FunU D B)) (P' Q' : El E (FunU E (subT E D B s)))
    (oP : Ov E D (FunU D B) s (FunU E (subT E D B s)) (PF E D s B (subT E D B s) (refl (subT E D B s))) P P')
    (oQ : Ov E D (FunU D B) s (FunU E (subT E D B s)) (PF E D s B (subT E D B s) (refl (subT E D B s))) Q Q') {
    Bs : Ty E = subT E D B s ;
    module R = RelOf[D, B, P, Q] ;
    module R' = RelOf[E, Bs, P', Q'] ;
    u : Sub (ext E Bs) R.DB = lift E D B s ;
    EB : Ctx = ext E Bs ;
    QB : Id (Ty EB) (subT EB R.DB R.WU u) R'.WU = wkT-ov E D B (PU.PropU D) s Bs (refl Bs) (PU.PropU E) (PU.PropU-ov E D s) ;
    bO (f : El D (FunU D B)) (f' : El E (FunU E Bs)) (o : Ov E D (FunU D B) s (FunU E Bs) (PF E D s B Bs (refl Bs)) f f')
      : Ov EB R.DB R.WU u R'.WU QB (bod D B R.WU f) (bod E Bs R'.WU f') =
      trans (El EB R'.WU) (trE EB (subT EB R.DB R.WU u) R'.WU QB (subt EB R.DB R.WU (bod D B R.WU f) u))
        (bod E Bs R'.WU (trE E (subT E D (FunU D B) s) (FunU E Bs) (PF E D s B Bs (refl Bs)) (subt E D (FunU D B) f s)))
        (bod E Bs R'.WU f')
        (sym (El EB R'.WU) (bod E Bs R'.WU (trE E (subT E D (FunU D B) s) (FunU E Bs) (PF E D s B Bs (refl Bs)) (subt E D (FunU D B) f s)))
           (trE EB (subT EB R.DB R.WU u) R'.WU QB (subt EB R.DB R.WU (bod D B R.WU f) u))
           (bodNat E D B R.WU s R'.WU QB (PF E D s B Bs (refl Bs)) f))
        (ap (El E (FunU E Bs)) (El EB R'.WU) (\ g -> bod E Bs R'.WU g)
           (trE E (subT E D (FunU D B) s) (FunU E Bs) (PF E D s B Bs (refl Bs)) (subt E D (FunU D B) f s)) f' o) ;
    PUu : Id (Ty EB) (subT EB R.DB (PU.PropU R.DB) u) (PU.PropU EB) = PU.PropU-ov EB R.DB u ;
    mO (f : El D (FunU D B)) (f' : El E (FunU E Bs)) (o : Ov E D (FunU D B) s (FunU E Bs) (PF E D s B Bs (refl Bs)) f f')
      : Ov EB R.DB (PU.PropU R.DB) u (PU.PropU EB) PUu
          (trE R.DB R.WU (PU.PropU R.DB) R.PWU (bod D B R.WU f)) (trE EB R'.WU (PU.PropU EB) R'.PWU (bod E Bs R'.WU f')) =
      ovTr EB R.DB R.WU (PU.PropU R.DB) R.PWU u R'.WU (PU.PropU EB) R'.PWU QB PUu (bod D B R.WU f) (bod E Bs R'.WU f') (bO f f' o) ;
    decO (m : El R.DB (PU.PropU R.DB)) (m' : El EB (PU.PropU EB)) (o : Ov EB R.DB (PU.PropU R.DB) u (PU.PropU EB) PUu m m')
      : Id (Ty EB) (subT EB R.DB (PU.DecP R.DB m) u) (PU.DecP EB m') =
      trans (Ty EB) (subT EB R.DB (PU.DecP R.DB m) u) (Un.Dec EB (PU.UU.DU.subU EB R.DB (PU.codeOf R.DB m) u)) (PU.DecP EB m')
        (Un.Dec-nat EB R.DB (PU.codeOf R.DB m) u)
        (ap (El EB (Un.Cod EB)) (Ty EB) (\ c2 -> Un.Dec EB c2) (PU.UU.DU.subU EB R.DB (PU.codeOf R.DB m) u) (PU.codeOf EB m')
           (IN.fst-ov EB R.DB (Un.Cod R.DB) (PU.PropFam R.DB) u (Un.Cod EB) (Un.Cod-nat EB R.DB u) (PU.PropFam EB) (PU.PropFam-ov EB R.DB u) PUu
              m m' o)) ;
    TPo : Id (Ty EB) (subT EB R.DB R.TP u) R'.TP = decO R.mP R'.mP (mO P P' oP) ;
    TQo : Id (Ty EB) (subT EB R.DB R.TQ u) R'.TQ = decO R.mQ R'.mQ (mO Q Q' oQ) ;
    F1o : Id (Ty EB) (subT EB R.DB R.F1 u) R'.F1 = Fun-ov EB R.DB R.TP R.TQ u R'.TP TPo R'.TQ TQo ;
    F2o : Id (Ty EB) (subT EB R.DB R.F2 u) R'.F2 = Fun-ov EB R.DB R.TQ R.TP u R'.TQ TQo R'.TP TPo ;
    So : Id (Ty EB) (subT EB R.DB R.S u) R'.S =
      Sig-ov EB R.DB R.F1 (wkT R.DB R.F1 R.F2) u R'.F1 F1o (wkT EB R'.F1 R'.F2) (wkT-ov EB R.DB R.F1 R.F2 u R'.F1 F1o R'.F2 F2o) ;
    law : Id (Ty E) (subT E D R.Rel s) R'.Rel = Pi-ov E D B R.S s Bs (refl Bs) R'.S So ;
  } ;
  -- in general, along any path of B
  RelN (E D : Ctx) (s : Sub E D) (B : Ty D) (P Q : El D (FunU D B)) (B' : Ty E) (PB : Id (Ty E) (subT E D B s) B')
    (P' Q' : El E (FunU E B'))
    (oP : Ov E D (FunU D B) s (FunU E B') (PF E D s B B' PB) P P')
    (oQ : Ov E D (FunU D B) s (FunU E B') (PF E D s B B' PB) Q Q')
    : Id (Ty E) (subT E D (Rel D B P Q) s) (Rel E B' P' Q') =
    idJ (Ty E) (subT E D B s)
      (\ B2 PB2 -> (P2 Q2 : El E (FunU E B2)) -> Ov E D (FunU D B) s (FunU E B2) (PF E D s B B2 PB2) P P2
         -> Ov E D (FunU D B) s (FunU E B2) (PF E D s B B2 PB2) Q Q2 -> Id (Ty E) (subT E D (Rel D B P Q) s) (Rel E B2 P2 Q2))
      (\ P2 Q2 o1 o2 -> N0[E, D, s, B, P, Q, P2, Q2, o1, o2].law)
      B' PB P' Q' oP oQ ;
} ;
