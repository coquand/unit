-- CUG16.seg (canonicity-c2; the generic (U), part 16 of CCmpU16's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU16 with
-- F2 replaced by s.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module UG16 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) {
 module HZ = CHomT3[a].HomP[R, encK, pe].Hom[s, y] ;
 module BZ = HZ.B0 ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = HZ.HomT ;
 D1 : C.Ctx = C.ext Nl HS ;
 QA : C.Ty Nl = HZ.AS.Qt ;
 QY : C.Ty Nl = HZ.AT.Qt ;
 MapT : C.Ty Nl = BZ.MapT ;
 Gh : C.Ctx = BZ.Gh ;
 -- the map component, as a substitution to nil.MapT
 sAn (K : Ob) (w : V1.Ix (D1.ob K)) : V1.Ix (Gh.ob K) = (w.1, w.2.1) ;
 sA : C.Sub D1 Gh = new L.PSub[D1, Gh, sAn, \ J I f w -> refl (sAn J (D1.act J I f w))] ;
 clT (D : C.Ctx) (T : C.Ty Nl) (s1 s2 : C.Sub D Nl) : Id (C.Ty D) (C.subT D Nl T s1) (C.subT D Nl T s2) =
  apH {C.Sub D Nl} {C.Ty D} (\ s -> C.subT D Nl T s) (transH (C.eps-uniq D s1) (symH (C.eps-uniq D s2))) ;
 idFwd (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (u : C.El G (IJ.IdT G X x y))
   : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)) =
  idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y))) u X' P ;
 QYd : C.Ty D1 = OV.wkT Nl HS QY ;
 W4d (W4 : C.Ty Nl) : C.Ty D1 = OV.wkT Nl HS W4 ;
 -- the datum of a binary operation, applied at a closed point wt of W4
 module DB (opS : C.El Nl (OV.Fun Nl QA (OV.Fun Nl QA QA))) (opT : C.El Nl (OV.Fun Nl QY (OV.Fun Nl QY QY)))
   (dk : (K : Ob) (w : V1.Ix (D1.ob K)) -> V1.Ix (BZ.BinOf[opS, opT].DataBin.1.tob K (sAn K w)))
   (dkN : (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I))
     -> Id (V1.Ix (BZ.BinOf[opS, opT].DataBin.1.tob J (sAn J (D1.act J I f w))))
          ((C.subT D1 Gh BZ.BinOf[opS, opT].DataBin sA).1.tact J I f w (D1.act J I f w) (refl (D1.act J I f w)) (dk I w)) (dk J (D1.act J I f w)))
   (wt : C.El Nl BZ.BinOf[opS, opT].W4) {
  module BB = BZ.BinOf[opS, opT] ;
  module GT = BZ.GT ;
  module OT = GT.OpTy[opT] ;
  DS : C.Ty D1 = C.subT D1 Gh BB.DataBin sA ;
  dE : C.El D1 DS = L.mkPEl D1 DS.1 dk (\ J I f w w' e ->
   idJ (V1.Ix (D1.ob J)) (D1.act J I f w) (\ w2 e2 -> Id (V1.Ix (DS.1.tob J w2)) (DS.1.tact J I f w w2 e2 (dk I w)) (dk J w2))
     (dkN J I f w) w' e) ;
  W4s : C.Ty D1 = C.subT D1 Gh BB.W4h sA ;
  E : C.Ctx = C.ext D1 W4s ;
  lf : C.Sub E BB.Dw = C.lift D1 Gh BB.W4h sA ;
  IdT3s : C.Ty E = C.subT E BB.Dw BB.IdT3 lf ;
  PN : Id (C.Ty D1) DS (FibCwF[a, a+].fibPi.Pi D1 W4s IdT3s) = FibCwF[a, a+].fibPi.Pi-nat D1 Gh BB.W4h BB.IdT3 sA ;
  dP : C.El D1 (FibCwF[a, a+].fibPi.Pi D1 W4s IdT3s) = OV.trE D1 DS (FibCwF[a, a+].fibPi.Pi D1 W4s IdT3s) PN dE ;
  PW : Id (C.Ty D1) (W4d BB.W4) W4s =
   symH (transH (symH (C.subT-o D1 Gh Nl BB.W4 BZ.pG sA)) (clT D1 BB.W4 (C.o D1 Gh Nl BZ.pG sA) (C.p Nl HS))) ;
  wh : C.El D1 W4s = OV.trE D1 (W4d BB.W4) W4s PW (OV.wkE Nl HS BB.W4 wt) ;
  r : C.El D1 (C.subT D1 E IdT3s (C.sec D1 W4s wh)) = C.subt D1 E IdT3s (OV.bod D1 W4s IdT3s dP) (C.sec D1 W4s wh) ;
  ta : C.Sub D1 GT.G3 = C.o D1 E GT.G3 (C.o E BB.Dw GT.G3 BB.sigT lf) (C.sec D1 W4s wh) ;
  TE1 : Id (C.Ty D1) (C.subT D1 E IdT3s (C.sec D1 W4s wh)) (C.subT D1 GT.G3 OT.IdOp ta) =
   transH (apH {C.Ty E} {C.Ty D1} (\ T -> C.subT D1 E T (C.sec D1 W4s wh)) (symH (C.subT-o E BB.Dw GT.G3 OT.IdOp BB.sigT lf)))
    (symH (C.subT-o D1 E GT.G3 OT.IdOp (C.o E BB.Dw GT.G3 BB.sigT lf) (C.sec D1 W4s wh))) ;
  r1 : C.El D1 (IJ.IdT D1 (C.subT D1 GT.G3 GT.Qw3 ta) (C.subt D1 GT.G3 GT.Qw3 OT.o12w ta) (C.subt D1 GT.G3 GT.Qw3 (C.q GT.G2 GT.Qw2) ta)) =
   OV.trE D1 (C.subT D1 E IdT3s (C.sec D1 W4s wh)) (IJ.IdT D1 (C.subT D1 GT.G3 GT.Qw3 ta) (C.subt D1 GT.G3 GT.Qw3 OT.o12w ta) (C.subt D1 GT.G3 GT.Qw3 (C.q GT.G2 GT.Qw2) ta))
    (transH TE1 (IJ.IdT-nat D1 GT.G3 GT.Qw3 OT.o12w (C.q GT.G2 GT.Qw2) ta)) r ;
  -- the type of the values is QY weakened
  s12 : C.Sub GT.G2 Nl = C.o GT.G2 GT.G1 Nl (C.p Nl QY) (C.p GT.G1 GT.Qw) ;
  pi3 : C.Sub GT.G3 Nl = C.o GT.G3 GT.G2 Nl s12 (C.p GT.G2 GT.Qw2) ;
  QW3 : Id (C.Ty GT.G3) GT.Qw3 (C.subT GT.G3 Nl QY pi3) =
   transH (apH {C.Ty GT.G2} {C.Ty GT.G3} (\ T -> C.subT GT.G3 GT.G2 T (C.p GT.G2 GT.Qw2)) (symH (C.subT-o GT.G2 GT.G1 Nl QY (C.p Nl QY) (C.p GT.G1 GT.Qw))))
    (symH (C.subT-o GT.G3 GT.G2 Nl QY s12 (C.p GT.G2 GT.Qw2))) ;
  PQ : Id (C.Ty D1) (C.subT D1 GT.G3 GT.Qw3 ta) QYd =
   transH (apH {C.Ty GT.G3} {C.Ty D1} (\ T -> C.subT D1 GT.G3 T ta) QW3)
    (transH (symH (C.subT-o D1 GT.G3 Nl QY pi3 ta)) (clT D1 QY (C.o D1 GT.G3 Nl pi3 ta) (C.p Nl HS))) ;
  e1 : C.El D1 QYd = OV.trE D1 (C.subT D1 GT.G3 GT.Qw3 ta) QYd PQ (C.subt D1 GT.G3 GT.Qw3 OT.o12w ta) ;
  e3 : C.El D1 QYd = OV.trE D1 (C.subT D1 GT.G3 GT.Qw3 ta) QYd PQ (C.subt D1 GT.G3 GT.Qw3 (C.q GT.G2 GT.Qw2) ta) ;
  res : C.El D1 (IJ.IdT D1 QYd e1 e3) =
   idFwd D1 (C.subT D1 GT.G3 GT.Qw3 ta) QYd PQ (C.subt D1 GT.G3 GT.Qw3 OT.o12w ta) (C.subt D1 GT.G3 GT.Qw3 (C.q GT.G2 GT.Qw2) ta) r1 ;
  -- readings
  module SO = CSemOp[a].SemOp[QY, opT] ;
  W4K (K : Ob) (o : V1.Ix (Nl.ob K)) : U a+ = V1.Ix (BB.W4.1.tob K o) ;
  whrd (K : Ob) (w : V1.Ix (D1.ob K)) : Id (W4K K w.1) (wh.eob K w) (wt.eob K w.1) =
   transH (CAppRd[a].trE-rd D1 (W4d BB.W4) W4s PW (OV.wkE Nl HS BB.W4 wt) K w)
    (CAppRd[a].same-rd D1 (W4d BB.W4) W4s PW K w (refl ((W4d BB.W4).1.tob K w)) (wt.eob K w.1)) ;
  v1 (K : Ob) (w : V1.Ix (D1.ob K)) (u : W4K K w.1) : V1.Ix (QY.1.tob K w.1) = SO.ev2 K w.1 (BZ.hv K w.1 w.2.1 u.1) (BZ.hv K w.1 w.2.1 u.2.1) ;
  v3 (K : Ob) (w : V1.Ix (D1.ob K)) (u : W4K K w.1) : V1.Ix (QY.1.tob K w.1) = BZ.hv K w.1 w.2.1 u.2.2.1 ;
  e1rd (K : Ob) (w : V1.Ix (D1.ob K)) : Id (V1.Ix (QY.1.tob K w.1)) (e1.eob K w) (v1 K w (wt.eob K w.1)) =
   transH (CAppRd[a].trE-rd D1 (C.subT D1 GT.G3 GT.Qw3 ta) QYd PQ (C.subt D1 GT.G3 GT.Qw3 OT.o12w ta) K w)
    (transH (CAppRd[a].same-rd D1 (C.subT D1 GT.G3 GT.Qw3 ta) QYd PQ K w (refl (QYd.1.tob K w)) ((C.subt D1 GT.G3 GT.Qw3 OT.o12w ta).eob K w))
      (apH {W4K K w.1} {V1.Ix (QY.1.tob K w.1)} (v1 K w) (whrd K w))) ;
  e3rd (K : Ob) (w : V1.Ix (D1.ob K)) : Id (V1.Ix (QY.1.tob K w.1)) (e3.eob K w) (v3 K w (wt.eob K w.1)) =
   transH (CAppRd[a].trE-rd D1 (C.subT D1 GT.G3 GT.Qw3 ta) QYd PQ (C.subt D1 GT.G3 GT.Qw3 (C.q GT.G2 GT.Qw2) ta) K w)
    (transH (CAppRd[a].same-rd D1 (C.subT D1 GT.G3 GT.Qw3 ta) QYd PQ K w (refl (QYd.1.tob K w)) ((C.subt D1 GT.G3 GT.Qw3 (C.q GT.G2 GT.Qw2) ta).eob K w))
      (apH {W4K K w.1} {V1.Ix (QY.1.tob K w.1)} (v3 K w) (whrd K w))) ;
 } ;
} ;
