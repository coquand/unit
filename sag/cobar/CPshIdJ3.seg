-- CPshIdJ3.seg (part 7a of the Id instance: J-nat, the data at x and the commutation of upS with pr and psi) (part 7 of the Id instance, canonicity-45): J is stable
-- under C-substitutions.  PosJNat.JNatG at each x for the record's upS
-- read at x, with the base's Yoneda data (FibId.JNt's Y, Y') spelled as
-- the base spells them; the commutation of upS with the J-data is the
-- base's (JNt.prEq, lamEq, psiEq) through upSEqC; the transported start
-- is compared through FibIdRd.elTr with the path of codes of the centres
-- (cenNat's pointwise form, CPshIdJ2.CNC.At.pt).  Each conversion between
-- the record's spelling and the base's is one opaque lemma.
--   JN[D, G, A, a, s, CM, d].law : subCEl J upS = J (CM[upS]) d''

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module FBC = FibCwF[a, l] ;
module FIC = FibIdCen[a, l] ;
module FID = FibId[a, l] ;
module RD = FibIdRd[a, l] ;
module PJ = PosJNat[a, l] ;

module IdJ3Of (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 module JB = CPshIdJb[a, l].IdJbOf[C] ;
 module JC2 = CPshIdJc2[a, l].IdJc2Of[C] ;
 module J1 = CPshIdJ1[a, l].IdJ1Of[C] ;
 module J2 = CPshIdJ2[a, l].IdJ2Of[C] ;
 open P ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;
 module DRC = JA.DRC ;
 module DRB = JA.DRB ;

 module JN (D G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (s : CSub[D, G]) (CM : STy (DRC.Dx G A a0))
  (d : CEl[G, (UF.FCC.subS G (DRC.Dx G A a0) CM (DRC.cen G A a0)).1]) {
  A' : STy D = UF.FCC.subS D G A s ;
  a' : CEl[D, A'.1] = CW.subCEl D G A.1 a0 s ;
  Dc : CCtx = DRC.Dx G A a0 ;
  Dd : CCtx = DRC.Dx D A' a' ;
  up : CSub[Dd, Dc] = DRC.upS D G A a0 s ;
  cenG : CSub[G, Dc] = DRC.cen G A a0 ;
  cenD : CSub[D, Dd] = DRC.cen D A' a' ;
  CM' : STy Dd = (UF.FCC.subS (DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)) (DRC.Dx G A a0) CM (DRC.upS D G A a0 s)) ;
  Zs : STy D = UF.FCC.subS D G (UF.FCC.subS G (DRC.Dx G A a0) CM (DRC.cen G A a0)) s ;
  Zd : STy D = UF.FCC.subS D (DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)) (UF.FCC.subS (DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)) (DRC.Dx G A a0) CM (DRC.upS D G A a0 s)) (DRC.cen D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)) ;
  PT : Id (STy D) Zs Zd = DRC.cenT D G A a0 s (J2.cenNat D G A a0 s) CM ;
  d'' : CEl[D, (UF.FCC.subS D (DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)) (UF.FCC.subS (DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)) (DRC.Dx G A a0) CM (DRC.upS D G A a0 s)) (DRC.cen D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s))).1] =
   subst (STy D) (\ Z -> CEl[D, Z.1]) Zs Zd PT (CW.subCEl D G (UF.FCC.subS G (DRC.Dx G A a0) CM (DRC.cen G A a0)).1 d s) ;
  module JG = J1.JEl[G, A, a0, CM, d] ;
  module JD = J1.JEl[D, UF.FCC.subS D G A s, CW.subCEl D G A.1 a0 s, UF.FCC.subS (DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)) (DRC.Dx G A a0) CM (DRC.upS D G A a0 s), d''] ;

  module At (x : CO) {
   -- the base's J-nat data at x (its motive and start in the base's spelling)
   CMx : FBC.FC.STy (DRB.Dx (G.ob x) (JA.As G A x) (a0.el x)) = (CM.1.ty x, CM.2.1 x) ;
   dB : PEl[G.ob x, subTy (G.ob x) (DRB.Dx (G.ob x) (JA.As G A x) (a0.el x)) (CM.1.ty x) (DRB.cen (G.ob x) (JA.As G A x) (a0.el x))] =
    subst (PSub[G.ob x, DRB.Dx (G.ob x) (JA.As G A x) (a0.el x)]) (\ t -> PEl[G.ob x, subTy (G.ob x) (DRB.Dx (G.ob x) (JA.As G A x) (a0.el x)) (CM.1.ty x) t])
      (cenG.sb x) (DRB.cen (G.ob x) (JA.As G A x) (a0.el x)) (JB.cenEqC G A a0 x) (d.el x) ;
   module Nt = FID.JNt[D.ob x, G.ob x, JA.As G A x, a0.el x, s.sb x, CMx, dB] ;
   upB : PSub[Dd.ob x, Dc.ob x] = DRB.upS (D.ob x) (G.ob x) (JA.As G A x) (a0.el x) (s.sb x) ;
   uE : Id (PSub[Dd.ob x, Dc.ob x]) (up.sb x) upB = JC2.upSEqC D G A a0 s x ;
   opaque uE ;
   -- the base's commutations for upB, in the record's spelling (one conversion each)
   NtPr (X : Ob) (z : W0.Ix ((Dd.ob x).ob X)) : Id (W0.Ix ((G.ob x).ob X)) (JG.Y[x].J.prY.nt X (upB.nt X z)) ((s.sb x).nt X (JD.Y[x].J.prY.nt X z)) = Nt.prEq X z ;
   opaque NtPr ;
   prEq (X : Ob) (z : W0.Ix ((Dd.ob x).ob X)) : Id (W0.Ix ((G.ob x).ob X)) (JG.Y[x].J.prY.nt X ((up.sb x).nt X z)) ((s.sb x).nt X (JD.Y[x].J.prY.nt X z)) =
    transH (apH (\ t -> JG.Y[x].J.prY.nt X (t.nt X z)) uE) (NtPr X z) ;
   opaque prEq ;
  } ;
 } ;
} ;
