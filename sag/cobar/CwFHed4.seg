-- CwFHed4.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit for the
-- quotient's set-ness): Hedberg-Kraus at a point, in a CwF with Pi, Sigma
-- and Swan Id.
--
-- Informal text.  Let R be a type over G.A, rho : R(x) and
-- f : R -> Id(x , -) over G.A.  Put c = f_x rho (a loop at x) and
-- phi = chi o f, chi the map of CwFHed3 for c, so that phi_x rho = refl
-- (internally).  By J on u : Id(x , y), with that path as the base at the
-- centre:  phi_y (trP R u rho) = u  (lawb; the reading of phi at points is
-- CwFHed1's At, that of u is CwFHed2's L0).  Hence two paths u u' whose
-- transports of rho are joined (e.g. R a proposition) are joined (Fin).
open Base ;

module Hed4 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module H1 = CwFHed1.Hed1[l, C, PS, SS, IJ] ;
  module H2 = CwFHed2.Hed2[l, C, PS, SS, IJ] ;
  module H3 = CwFHed3.Hed3[l, C, PS, SS, IJ] ;

  module Hed (G : Ctx) (A : Ty G) (x : El G A) (R : Ty (ext G A)) (rho : El G (subT G (ext G A) R (sec G A x)))
    (f : El (ext (ext G A) R) (wkT (ext G A) R (JP.IK G A x))) {
    GA : Ctx = ext G A ;
    GAR : Ctx = ext GA R ;
    IK : Ty GA = JP.IK G A x ;
    H : Ctx = JP.Dx G A x ;
    WK : Ty H = wkT GA IK IK ;
    Ix : Ty G = subT G GA IK (sec G A x) ;
    Ixx : Ty G = IJ.IdT G A x x ;
    PKx : Id (Ty G) Ix Ixx = JP.IKpt G A x x ;
    module Lf = H1.L1[G, A, x, R, IK, f, rho] ;
    w : El G Ix = Lf.phiAt x rho ;
    c : El G Ixx = trE G Ix Ixx PKx w ;
    module CH = H3.Chi[G, A, x, c] ;
    chiF : El H WK = trE H CH.Ixt WK (sym (Ty H) WK CH.Ixt (JP.uvP G A x)) CH.chi ;
    m : Sub GAR H = extS GAR GA IK (p GA R) f ;
    PM : Id (Ty GAR) (subT GAR H WK m) (wkT GA R IK) = IN.wkT-extS GAR GA IK IK (p GA R) f ;
    phi : El GAR (wkT GA R IK) = trE GAR (subT GAR H WK m) (wkT GA R IK) PM (subt GAR H WK chiF m) ;
    module L1 = H1.L1[G, A, x, R, IK, phi, rho] ;
    r0 : El G Ix = DJ.reflE G A x ;
    -- phi_x rho, read in Id(x , x), is chi_x c
    e : Sub G GAR = extS G GA R (sec G A x) rho ;
    Pe : Id (Ty G) (subT G GAR (wkT GA R IK) e) Ix = IN.wkT-extS G GA R IK (sec G A x) rho ;
    ob : Ov G H WK (o G GAR H m e) Ix (H2.comp3 G GAR H WK m e (wkT GA R IK) PM Ix Pe) chiF (L1.phiAt x rho) =
      H2.ovC G GAR H WK m e (wkT GA R IK) PM Ix Pe chiF phi (L1.phiAt x rho) (refl phi) (refl (L1.phiAt x rho)) ;
    -- o m e = (x , c), the point sg of CwFHed3
    PWf : Id (Ty GAR) (subT GAR H (wkT GA IK IK) m) (subT GAR GA IK (p GA R)) = IN.wkT-extS GAR GA IK IK (p GA R) f ;
    Pfe : Id (Ty G) (subT G GAR (subT GAR GA IK (p GA R)) e) Ix = IN.wkT-extS G GA R IK (sec G A x) rho ;
    qme : Ov G H WK (o G GAR H m e) Ix (H2.comp3 G GAR H WK m e (subT GAR GA IK (p GA R)) PWf Ix Pfe) (q GA IK) w =
      H2.ovC G GAR H WK m e (subT GAR GA IK (p GA R)) PWf Ix Pfe (q GA IK) f w (JP.q-extS GAR GA IK (p GA R) f PWf) (refl w) ;
    qme' : Ov G H WK (o G GAR H m e) Ixx (trans (Ty G) (subT G H WK (o G GAR H m e)) Ix Ixx (H2.comp3 G GAR H WK m e (subT GAR GA IK (p GA R)) PWf Ix Pfe) PKx) (q GA IK) c =
      ovTr G H WK WK (refl WK) (o G GAR H m e) Ix Ixx PKx (H2.comp3 G GAR H WK m e (subT GAR GA IK (p GA R)) PWf Ix Pfe)
        (trans (Ty G) (subT G H WK (o G GAR H m e)) Ix Ixx (H2.comp3 G GAR H WK m e (subT GAR GA IK (p GA R)) PWf Ix Pfe) PKx) (q GA IK) w qme ;
    QTs : Id (Ty G) (subT G H WK CH.sg) Ixx = JP.qT-inst G A IK x Ixx PKx c ;
    qs : Ov G H WK CH.sg Ixx QTs (q GA IK) c = JP.q-inst G A IK x Ixx PKx c QTs ;
    pme : Id (Sub G GA) (o G H GA (p GA IK) (o G GAR H m e)) (sec G A x) =
      trans (Sub G GA) (o G H GA (p GA IK) (o G GAR H m e)) (o G GAR GA (o GAR H GA (p GA IK) m) e) (sec G A x)
        (sym (Sub G GA) (o G GAR GA (o GAR H GA (p GA IK) m) e) (o G H GA (p GA IK) (o G GAR H m e)) (o-assoc G GAR H GA (p GA IK) m e))
        (trans (Sub G GA) (o G GAR GA (o GAR H GA (p GA IK) m) e) (o G GAR GA (p GA R) e) (sec G A x)
           (ap (Sub GAR GA) (Sub G GA) (\ r -> o G GAR GA r e) (o GAR H GA (p GA IK) m) (p GA R) (IN.p-extS GAR GA IK (p GA R) f))
           (IN.p-extS G GA R (sec G A x) rho)) ;
    meEq : Id (Sub G H) (o G GAR H m e) CH.sg =
      IN.ext-eq G GA IK (o G GAR H m e) CH.sg
        (trans (Sub G GA) (o G H GA (p GA IK) (o G GAR H m e)) (sec G A x) (o G H GA (p GA IK) CH.sg)
           pme (sym (Sub G GA) (o G H GA (p GA IK) CH.sg) (sec G A x) (JP.p-inst G A IK x Ixx PKx c)))
        Ixx c
        (trans (Ty G) (subT G H WK (o G GAR H m e)) Ix Ixx (H2.comp3 G GAR H WK m e (subT GAR GA IK (p GA R)) PWf Ix Pfe) PKx) qme'
        QTs qs ;
    -- chiF read at sg, in Id(x , x), is chiX
    PS1 : Id (Ty G) (subT G H WK CH.sg) Ixx =
      trans (Ty G) (subT G H WK CH.sg) (subT G H CH.Ixt CH.sg) Ixx
        (ap (Ty H) (Ty G) (\ X -> subT G H X CH.sg) WK CH.Ixt (JP.uvP G A x)) CH.PB3 ;
    cs : Ov G H WK CH.sg Ixx PS1 chiF CH.chiX =
      ovTr G H CH.Ixt WK (sym (Ty H) WK CH.Ixt (JP.uvP G A x)) CH.sg Ixx Ixx (refl Ixx) CH.PB3 PS1 CH.chi CH.chiX (refl CH.chiX) ;
    Pob : Id (Ty G) (subT G H WK (o G GAR H m e)) Ixx =
      trans (Ty G) (subT G H WK (o G GAR H m e)) Ix Ixx (H2.comp3 G GAR H WK m e (wkT GA R IK) PM Ix Pe) PKx ;
    phX : Id (El G Ixx) (trE G Ix Ixx PKx (L1.phiAt x rho)) CH.chiX =
      calc (El G Ixx) {
          trE G Ix Ixx PKx (L1.phiAt x rho)
        =< ap (El G Ix) (El G Ixx) (\ v -> trE G Ix Ixx PKx v) (L1.phiAt x rho)
             (trE G (subT G H WK (o G GAR H m e)) Ix (H2.comp3 G GAR H WK m e (wkT GA R IK) PM Ix Pe) (subt G H WK chiF (o G GAR H m e)))
             (sym (El G Ix) (trE G (subT G H WK (o G GAR H m e)) Ix (H2.comp3 G GAR H WK m e (wkT GA R IK) PM Ix Pe) (subt G H WK chiF (o G GAR H m e))) (L1.phiAt x rho) ob) >
          trE G Ix Ixx PKx (trE G (subT G H WK (o G GAR H m e)) Ix (H2.comp3 G GAR H WK m e (wkT GA R IK) PM Ix Pe) (subt G H WK chiF (o G GAR H m e)))
        =< trE-tr G (subT G H WK (o G GAR H m e)) Ix Ixx (H2.comp3 G GAR H WK m e (wkT GA R IK) PM Ix Pe) PKx (subt G H WK chiF (o G GAR H m e)) >
          trE G (subT G H WK (o G GAR H m e)) Ixx Pob (subt G H WK chiF (o G GAR H m e))
        =< SJ.subtEq G H WK chiF (o G GAR H m e) CH.sg meEq Ixx Pob PS1 >
          trE G (subT G H WK CH.sg) Ixx PS1 (subt G H WK chiF CH.sg)
        =< cs >
          CH.chiX } ;
    -- the base: phi_x rho = r0, internally
    Pa0 : Id (El G Ix) (trE G Ixx Ix (sym (Ty G) Ix Ixx PKx) CH.chiX) (L1.phiAt x rho) =
      trans (El G Ix) (trE G Ixx Ix (sym (Ty G) Ix Ixx PKx) CH.chiX) (trE G Ixx Ix (sym (Ty G) Ix Ixx PKx) (trE G Ix Ixx PKx (L1.phiAt x rho))) (L1.phiAt x rho)
        (ap (El G Ixx) (El G Ix) (\ v -> trE G Ixx Ix (sym (Ty G) Ix Ixx PKx) v) CH.chiX (trE G Ix Ixx PKx (L1.phiAt x rho))
           (sym (El G Ixx) (trE G Ix Ixx PKx (L1.phiAt x rho)) CH.chiX phX))
        (IN.trE-symL G Ix Ixx PKx (L1.phiAt x rho)) ;
    Pb0 : Id (El G Ix) (trE G Ixx Ix (sym (Ty G) Ix Ixx PKx) (IJ.rfl G A x)) r0 =
      trE-irr G Ixx Ix (sym (Ty G) Ix Ixx PKx) (sym (Ty G) Ix Ixx (DJ.reflT G A x)) (IJ.rfl G A x) ;
    bq : Id (Ty G) (IJ.IdT G Ixx CH.chiX (IJ.rfl G A x)) (IJ.IdT G Ix (L1.phiAt x rho) r0) =
      DJ.idCong G Ixx Ix (sym (Ty G) Ix Ixx PKx) CH.chiX (IJ.rfl G A x) (L1.phiAt x rho) r0 Pa0 Pb0 ;
    b : El G (IJ.IdT G Ix (L1.phiAt x rho) r0) = trE G (IJ.IdT G Ixx CH.chiX (IJ.rfl G A x)) (IJ.IdT G Ix (L1.phiAt x rho) r0) bq CH.law ;
    -- the J: phi at the transported rho is the path variable
    CQ : Ty H = TR.CMt G A x IK ;
    Mb : Ty H = IJ.IdT H CQ L1.phiJ (q GA IK) ;
    Mbc : Id (Ty G) (subT G H Mb (DJ.cen G A x)) (IJ.IdT G Ix (L1.phiAt x rho) r0) =
      Id-ov G H CQ L1.phiJ (q GA IK) (DJ.cen G A x) Ix L1.CN.WQy (L1.phiAt x rho) r0 L1.pa (JP.q-extS G GA IK (sec G A x) r0 L1.CN.WQy) ;
    baseb : El G (subT G H Mb (DJ.cen G A x)) =
      trE G (IJ.IdT G Ix (L1.phiAt x rho) r0) (subT G H Mb (DJ.cen G A x)) (sym (Ty G) (subT G H Mb (DJ.cen G A x)) (IJ.IdT G Ix (L1.phiAt x rho) r0) Mbc) b ;
    Eb : El H Mb = IJ.J G A x Mb baseb ;
    module At (y : El G A) (u : El G (IJ.IdT G A x y)) {
      module AY = L1.At[y, IJ.IdT G A x y, JP.IKpt G A x y, u] ;
      module LP = H2.L0[G, A, x].Pt[y, u] ;
      Iy : Ty G = subT G GA IK (sec G A y) ;
      tu : El G (subT G GA R (sec G A y)) = TR.trP G A R x y u rho ;
      Mbp : Id (Ty G) (subT G H Mb AY.pt) (IJ.IdT G Iy (L1.phiAt y tu) LP.uI) =
        Id-ov G H CQ L1.phiJ (q GA IK) AY.pt Iy AY.WQy (L1.phiAt y tu) LP.uI AY.law LP.qOv' ;
      law : El G (IJ.IdT G Iy (L1.phiAt y tu) LP.uI) = trE G (subT G H Mb AY.pt) (IJ.IdT G Iy (L1.phiAt y tu) LP.uI) Mbp (subt G H Mb Eb AY.pt) ;
    } ;
    -- two paths whose transports of rho are joined are joined
    module Fin (y : El G A) (u u' : El G (IJ.IdT G A x y))
      (e1 : El G (IJ.IdT G (subT G GA R (sec G A y)) (TR.trP G A R x y u rho) (TR.trP G A R x y u' rho))) {
      module A1 = At[y, u] ;
      module A2 = At[y, u'] ;
      Ry : Ty G = subT G GA R (sec G A y) ;
      Iy : Ty G = subT G GA IK (sec G A y) ;
      Ixy : Ty G = IJ.IdT G A x y ;
      PK : Id (Ty G) Iy Ixy = JP.IKpt G A x y ;
      lf : Sub (ext G Ry) GAR = lift G GA R (sec G A y) ;
      PLf : Id (Ty (ext G Ry)) (subT (ext G Ry) GAR (wkT GA R IK) lf) (wkT G Ry Iy) = p-lift-T G GA R IK (sec G A y) ;
      rf : El (ext G Ry) (wkT G Ry Iy) = trE (ext G Ry) (subT (ext G Ry) GAR (wkT GA R IK) lf) (wkT G Ry Iy) PLf (subt (ext G Ry) GAR (wkT GA R IK) L1.phi lf) ;
      eqA (t : El G Ry) : Id (El G Iy) (PT.atv G Ry Iy rf t) (L1.phiAt y t) =
        trans (El G Iy) (PT.atv G Ry Iy rf t)
          (trE G (subT G GAR (wkT GA R IK) (o G (ext G Ry) GAR lf (sec G Ry t))) Iy
             (H2.comp3 G (ext G Ry) GAR (wkT GA R IK) lf (sec G Ry t) (wkT G Ry Iy) PLf Iy (p-sec-T G Ry Iy t))
             (subt G GAR (wkT GA R IK) L1.phi (o G (ext G Ry) GAR lf (sec G Ry t))))
          (L1.phiAt y t)
          (sym (El G Iy) (trE G (subT G GAR (wkT GA R IK) (o G (ext G Ry) GAR lf (sec G Ry t))) Iy
                 (H2.comp3 G (ext G Ry) GAR (wkT GA R IK) lf (sec G Ry t) (wkT G Ry Iy) PLf Iy (p-sec-T G Ry Iy t))
                 (subt G GAR (wkT GA R IK) L1.phi (o G (ext G Ry) GAR lf (sec G Ry t))))
             (PT.atv G Ry Iy rf t)
             (H2.ovC G (ext G Ry) GAR (wkT GA R IK) lf (sec G Ry t) (wkT G Ry Iy) PLf Iy (p-sec-T G Ry Iy t) L1.phi rf (PT.atv G Ry Iy rf t)
                (refl rf) (refl (PT.atv G Ry Iy rf t))))
          (trE-irr G (subT G GAR (wkT GA R IK) (o G (ext G Ry) GAR lf (sec G Ry t))) Iy
             (H2.comp3 G (ext G Ry) GAR (wkT GA R IK) lf (sec G Ry t) (wkT G Ry Iy) PLf Iy (p-sec-T G Ry Iy t))
             (IN.wkT-extS G GA R IK (sec G A y) t)
             (subt G GAR (wkT GA R IK) L1.phi (o G (ext G Ry) GAR lf (sec G Ry t)))) ;
      tu : El G Ry = A1.tu ;
      tu' : El G Ry = A2.tu ;
      e2 : El G (IJ.IdT G Iy (PT.atv G Ry Iy rf tu) (PT.atv G Ry Iy rf tu')) = PT.apM G Ry Iy rf tu tu' e1 ;
      PQ : Id (Ty G) (IJ.IdT G Iy (PT.atv G Ry Iy rf tu) (PT.atv G Ry Iy rf tu')) (IJ.IdT G Iy (L1.phiAt y tu) (L1.phiAt y tu')) =
        trans (Ty G) (IJ.IdT G Iy (PT.atv G Ry Iy rf tu) (PT.atv G Ry Iy rf tu')) (IJ.IdT G Iy (PT.atv G Ry Iy rf tu) (L1.phiAt y tu')) (IJ.IdT G Iy (L1.phiAt y tu) (L1.phiAt y tu'))
          (ap (El G Iy) (Ty G) (\ v -> IJ.IdT G Iy (PT.atv G Ry Iy rf tu) v) (PT.atv G Ry Iy rf tu') (L1.phiAt y tu') (eqA tu'))
          (ap (El G Iy) (Ty G) (\ v -> IJ.IdT G Iy v (L1.phiAt y tu')) (PT.atv G Ry Iy rf tu) (L1.phiAt y tu) (eqA tu)) ;
      e2' : El G (IJ.IdT G Iy (L1.phiAt y tu) (L1.phiAt y tu')) =
        trE G (IJ.IdT G Iy (PT.atv G Ry Iy rf tu) (PT.atv G Ry Iy rf tu')) (IJ.IdT G Iy (L1.phiAt y tu) (L1.phiAt y tu')) PQ e2 ;
      uI : El G Iy = A1.LP.uI ;
      uI' : El G Iy = A2.LP.uI ;
      pI : El G (IJ.IdT G Iy uI uI') =
        PT.transM G Iy uI (L1.phiAt y tu') uI'
          (PT.transM G Iy uI (L1.phiAt y tu) (L1.phiAt y tu') (PT.symM G Iy (L1.phiAt y tu) uI A1.law) e2')
          A2.law ;
      res : El G (IJ.IdT G Ixy u u') =
        trE G (IJ.IdT G Iy uI uI') (IJ.IdT G Ixy u u')
          (DJ.idCong G Iy Ixy PK uI uI' u u' (JP.trE-sym G Iy Ixy PK u) (JP.trE-sym G Iy Ixy PK u')) pI ;
    } ;
  } ;
} ;
