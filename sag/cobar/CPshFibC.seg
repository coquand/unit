-- CPshFibC.seg (canonicity-c2; COBAR.md (B), the S3 bridge, part (II-a)):
-- the fibres of a map f : Y -> X of C-types, as C-types over G.X.
--
--   FVc    Sigma (y : Y) Id_X (f y , x) (CPshSig's SigC over CPshId's IdC
--          on K = G.X.Y, with the ends a0C = f y, b0C = x as C-elements);
--          at each x it is CPshFibMaps.RawFib's FV1 on the nose.  The
--          identity type is rewrapped (IdR) so that its type at x is
--          written with RawFib's names: one vocabulary (comparing the two
--          forms of the types repeatedly made declarations overrun)
--   HP     core's homotopy fibre as a C-type (Prop13.HP)
-- a0C is natural in C because f is (mp-nat).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module RF = CPshFibMaps[a, l] ;
module LR = CLocBoundRetr[a, l] ;

module FibCOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module IDm = CPshId[a, l].IdOf[C] ;
 module SGm = CPshSig[a, l].SigOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module UR = CPshURel[a, l].URelOf[C] ;
 open P ;

 module Fb (G : CCtx) (Y X : CTy[G]) (f : P13.CMap[G, Y, X]) {
  module Rm (x : CO) { module R = RF.RawFib[G.ob x, Y.ty x, X.ty x, f.mp x] ; } ;
  Dc : CCtx = LO.ExtC G X ;
  module SCY = LO.SC[Dc, G, LO.pPC G X, Y] ;
  Yp : CTy[Dc] = SCY.subCTy ;
  Kc : CCtx = LO.ExtC Dc Yp ;
  module SCD = LO.SC[Dc, G, LO.pPC G X, X] ;
  XDc : CTy[Dc] = SCD.subCTy ;
  module SCK = LO.SC[Kc, Dc, LO.pPC Dc Yp, XDc] ;
  XKc : CTy[Kc] = SCK.subCTy ;

  -- the end f y is natural in C
  module A0 (y x : CO) (h : CH y x) (W : Ob) (z : W0.Ix ((Kc.ob x).ob W)) {
   z' : W0.Ix ((Kc.ob y).ob W) = (Kc.act y x h).nt W z ;
   lhs : SCK.Tt y W = (XKc.tE y x h).nt W (pairE (Kc.ob x) (XKc.ty x) W z (Rm[x].R.a0v W z)) ;
   rhs : SCK.Tt y W = pairE (Kc.ob y) (XKc.ty y) W z' (Rm[y].R.a0v W z') ;
   e1 : Id (SigT (G.ob y) (X.ty y) W) (SCD.rB y W (SCK.rB y W lhs)) ((X.tE y x h).nt W (Rm[x].R.HF.aE W z)) =
    transH (apH (\ t -> SCD.rB y W t) (SCK.rBtE y x h W (pairE (Kc.ob x) (XKc.ty x) W z (Rm[x].R.a0v W z))))
     (transH (SCD.rBtE y x h W (SCK.rB x W (pairE (Kc.ob x) (XKc.ty x) W z (Rm[x].R.a0v W z))))
       (apH (\ t -> (X.tE y x h).nt W t) (Rm[x].R.aQ W z))) ;
   e2 : Id (SigT (G.ob y) (X.ty y) W) ((X.tE y x h).nt W (Rm[x].R.HF.aE W z)) (Rm[y].R.HF.aE W z') =
    transH (f.mp-nat y x h W (SCY.rB x W z))
     (apH (\ t -> (f.mp y).mE W t) (symH (SCY.rBtE y x h W z))) ;
   res : Id (SCK.Tt y W) lhs rhs =
    SCK.sub-eq y W lhs rhs (refl z')
     (SCD.sub-eq y W (SCK.rB y W lhs) (SCK.rB y W rhs) (refl (((LO.pPC Dc Yp).sb y).nt W z'))
       (transH e1 (transH e2 (symH (Rm[y].R.aQ W z'))))) ;
  } ;
  a0C : CEl[Kc, XKc] = new CEl[Kc, XKc, \ x -> Rm[x].R.a0, \ y x h W z -> A0[y, x, h, W, z].res] ;
  b0C : CEl[Kc, XKc] = CW.subCEl Kc Dc XDc (CW.qC G X) (LO.pPC Dc Yp) ;

  module IdK = IDm.IdC[Kc, XKc, a0C, b0C] ;
  module HPc = P13.HP[G, Y, X, f] ;
  hp-ty (x : CO) : Id (PTy[Dc.ob x]) (HPc.PC.ty x) Rm[x].R.HF.FibT = refl Rm[x].R.HF.FibT ;

  ------------------------------------------------------------------
  -- ONE VOCABULARY.  From here on the fibre is written with RawFib's
  -- names (Rm[x].R.FV1, .K, .YC.Y): FVc is FV1C with its type at x given
  -- as Rm[x].R.FV1 (comparing the two forms of the type costs a second
  -- each time, so it is done once per field here).

  -- the identity type with its type at x written as RawFib's
  idTy (x : CO) : Id (PTy[Kc.ob x]) (IdK.ty x) Rm[x].R.YC.Y.IdYT = refl Rm[x].R.YC.Y.IdYT ;
  IdR : CTy[Kc] = new CTy[Kc, \ x -> Rm[x].R.YC.Y.IdYT, IdK.IdT.tE, IdK.IdT.tE-pt, IdK.IdT.tE-id, IdK.IdT.tE-o] ;
  module SGr = SGm.SG[Dc, Yp, IdR] ;
  FVc : CTy[Dc] = SGr.SigC ;
  fvc-ty (x : CO) : Id (PTy[Dc.ob x]) (FVc.ty x) Rm[x].R.FV1 = refl Rm[x].R.FV1 ;

  ------------------------------------------------------------------
  -- the X-reading of a total of X over K, and its C-naturality
  prX (x : CO) (W : Ob) (t : SCK.Tt x W) : SigT (G.ob x) (X.ty x) W = SCD.rB x W (SCK.rB x W t) ;
  prX-C (y x : CO) (h : CH y x) (W : Ob) (t : SCK.Tt x W)
   : Id (SigT (G.ob y) (X.ty y) W) (prX y W ((XKc.tE y x h).nt W t)) ((X.tE y x h).nt W (prX x W t)) =
   transH (apH (\ v -> SCD.rB y W v) (SCK.rBtE y x h W t)) (SCD.rBtE y x h W (SCK.rB x W t)) ;

  -- the action of h on a total of the fibre
  module TF (y x : CO) (h : CH y x) (W : Ob) (u : SigT (Dc.ob x) Rm[x].R.FV1 W) {
   kz : W0.Ix (Rm[x].R.K.ob W) = pairE (Dc.ob x) Rm[x].R.HF.B1 W (fstE (Dc.ob x) Rm[x].R.FV1 W u) (sndE (Dc.ob x) Rm[x].R.FV1 W u).1 ;
   wI : W0.Ix (Rm[x].R.YC.Y.tob W kz) = (sndE (Dc.ob x) Rm[x].R.FV1 W u).2 ;
   kz' : W0.Ix (Rm[y].R.K.ob W) = (Kc.act y x h).nt W kz ;
   wI' : W0.Ix (Rm[y].R.YC.Y.tob W kz') = IdK.TC[y, x, h, W, kz, wI].res ;
   res : SigT (Dc.ob y) Rm[y].R.FV1 W =
    pairE (Dc.ob y) Rm[y].R.FV1 W (fstE (Dc.ob y) Rm[y].R.HF.B1 W kz') (sndE (Dc.ob y) Rm[y].R.HF.B1 W kz', wI') ;
   -- by definition of CPshSig's action
   res-def : Id (SigT (Dc.ob y) Rm[y].R.FV1 W) ((FVc.tE y x h).nt W u) res = refl res ;
   rdR (W' : Ob) (g : Hom W' W) (i : Hom W' Iv)
    : Id (SigT (Kc.ob y) (XKc.ty y) W') (Rm[y].R.YC.Y.rd W kz' wI' W' g i) ((XKc.tE y x h).nt W' (Rm[x].R.YC.Y.rd W kz wI W' g i)) =
    IdK.rd-C y x h W kz wI W' g i ;
  } ;

  ------------------------------------------------------------------
  -- gN (FV1 -> HFib: the path of the readings) commutes with the C-actions
  module GC (y x : CO) (h : CH y x) (W : Ob) (u : SigT (Dc.ob x) Rm[x].R.FV1 W) {
   module Gx = LR.Map[Dc.ob x, Rm[x].R.FV1, Rm[x].R.HF.FibT, Rm[x].R.gN] ;
   module Gy = LR.Map[Dc.ob y, Rm[y].R.FV1, Rm[y].R.HF.FibT, Rm[y].R.gN] ;
   module Tu = TF[y, x, h, W, u] ;
   lt : Rm[y].R.HF.TF.EI W = HPc.res y x h W (Gx.onE W u) ;
   rt : Rm[y].R.HF.TF.EI W = Gy.onE W Tu.res ;
   qb : Id (SigT (G.ob y) (Y.ty y) W) (Rm[y].R.HF.fibB W lt) (Rm[y].R.HF.fibB W rt) =
    transH (HPc.rb y x h W (Gx.onE W u)) (symH (SCY.rBtE y x h W Tu.kz)) ;
   ql (W' : Ob) (g : Hom W' W) (i : Hom W' Iv)
    : Id (SigT (G.ob y) (X.ty y) W') (Rm[y].R.HF.fibL W lt W' g i) (Rm[y].R.HF.fibL W rt W' g i) =
    symH (transH (apH (\ t -> prX y W' t) (Tu.rdR W' g i))
           (prX-C y x h W' (Rm[x].R.YC.Y.rd W Tu.kz Tu.wI W' g i))) ;
   res : Id (Rm[y].R.HF.TF.EI W) lt rt =
    Rm[y].R.HF.fibE-eq W lt rt (refl ((X.tE y x h).nt W (fstE (Dc.ob x) Rm[x].R.FV1 W u))) qb ql ;
  } ;

  ------------------------------------------------------------------
  -- fN (HFib -> FV1: the Yoneda Id element of the path, empty sieve)
  -- commutes with the C-actions: same point (Pt), same readings (q: both
  -- read in X as X.tE h of the values of the path), empty sieves
  module FC (y x : CO) (h : CH y x) (W : Ob) (u : SigT (Dc.ob x) Rm[x].R.HF.FibT W) {
   module Fx = LR.Map[Dc.ob x, Rm[x].R.HF.FibT, Rm[x].R.FV1, Rm[x].R.fN] ;
   module Fy = LR.Map[Dc.ob y, Rm[y].R.HF.FibT, Rm[y].R.FV1, Rm[y].R.fN] ;
   module Tu = TF[y, x, h, W, Fx.onE W u] ;
   u' : SigT (Dc.ob y) Rm[y].R.HF.FibT W = HPc.res y x h W u ;
   rt : SigT (Dc.ob y) Rm[y].R.FV1 W = Fy.onE W u' ;
   kzR : W0.Ix (Rm[y].R.K.ob W) = pairE (Dc.ob y) Rm[y].R.HF.B1 W (fstE (Dc.ob y) Rm[y].R.FV1 W rt) (sndE (Dc.ob y) Rm[y].R.FV1 W rt).1 ;
   wR : W0.Ix (Rm[y].R.YC.Y.tob W kzR) = (sndE (Dc.ob y) Rm[y].R.FV1 W rt).2 ;
   vx : W0.Ix (Rm[x].R.YC.IO.tobI W Tu.kz) = Rm[x].R.emb.nfun W Tu.kz (sndE (Dc.ob x) Rm[x].R.HF.FibT W u).2 ;
   vy : W0.Ix (Rm[y].R.YC.IO.tobI W kzR) = Rm[y].R.emb.nfun W kzR (sndE (Dc.ob y) Rm[y].R.HF.FibT W u').2 ;
   Pt : Id (W0.Ix (Rm[y].R.K.ob W)) Tu.kz' kzR =
    SCY.sub-eq y W Tu.kz' kzR (refl ((X.tE y x h).nt W (fstE (Dc.ob x) Rm[x].R.HF.FibT W u)))
     (transH (SCY.rBtE y x h W Tu.kz) (symH (HPc.rb y x h W u))) ;
   module Qr (V1 : Ob) (k : Hom V1 W) (j : Hom V1 Iv) {
    ra : SigT (Kc.ob y) (XKc.ty y) V1 = Rm[y].R.YC.Y.rd W Tu.kz' Tu.wI' V1 k j ;
    rb' : SigT (Kc.ob y) (XKc.ty y) V1 = Rm[y].R.YC.Y.rd W kzR wR V1 k j ;
    ptK : Id (W0.Ix ((Kc.ob y).ob V1)) (fstE (Kc.ob y) (XKc.ty y) V1 ra) (fstE (Kc.ob y) (XKc.ty y) V1 rb') =
     apH (\ z -> (Kc.ob y).act V1 W k z) Pt ;
    xE : Id (SigT (G.ob y) (X.ty y) V1) (prX y V1 ra) (prX y V1 rb') =
     transH (apH (\ t -> prX y V1 t) (Tu.rdR V1 k j))
      (transH (prX-C y x h V1 (Rm[x].R.YC.Y.rd W Tu.kz Tu.wI V1 k j))
        (transH (apH (\ t -> (X.tE y x h).nt V1 t) (Rm[x].R.YC.FC[W, Tu.kz, vx].uC-E V1 k j))
          (symH (Rm[y].R.YC.FC[W, kzR, vy].uC-E V1 k j)))) ;
    res : Id (SigT (Kc.ob y) (XKc.ty y) V1) ra rb' =
     SCK.sub-eq y V1 ra rb' ptK
      (SCD.sub-eq y V1 (SCK.rB y V1 ra) (SCK.rB y V1 rb') (apH (\ z -> ((LO.pPC Dc Yp).sb y).nt V1 z) ptK) xE) ;
   } ;
   zEq : Id (SigT (Kc.ob y) Rm[y].R.YC.Y.IdYT W) (pairE (Kc.ob y) Rm[y].R.YC.Y.IdYT W Tu.kz' Tu.wI') (pairE (Kc.ob y) Rm[y].R.YC.Y.IdYT W kzR wR) =
    IdK.idC-eq y W (pairE (Kc.ob y) Rm[y].R.YC.Y.IdYT W Tu.kz' Tu.wI') (pairE (Kc.ob y) Rm[y].R.YC.Y.IdYT W kzR wR) Pt
     (\ V1 k j -> Qr[V1, k, j].res) (refl (PB.emptyS W)) ;
   res : Id (SigT (Dc.ob y) Rm[y].R.FV1 W) Tu.res rt =
    apH (\ z -> pairE (Dc.ob y) Rm[y].R.FV1 W (fstE (Dc.ob y) Rm[y].R.HF.B1 W (fstE (Kc.ob y) Rm[y].R.YC.Y.IdYT W z))
                  (sndE (Dc.ob y) Rm[y].R.HF.B1 W (fstE (Kc.ob y) Rm[y].R.YC.Y.IdYT W z), sndE (Kc.ob y) Rm[y].R.YC.Y.IdYT W z)) zEq ;
  } ;

  ------------------------------------------------------------------
  -- U-Rel: a uniform ContrOp of the fibre FVc gives one of the homotopy
  -- fibre HP (HP is a retract of FVc at each x, by maps commuting with
  -- the C-actions)
  utHP (ut : UTriv Dc FVc) : UTriv Dc HPc.PC =
   UR.URel[Dc, HPc.PC, FVc, \ x -> Rm[x].R.fN, \ x -> Rm[x].R.gN, \ x -> Rm[x].R.mId,
     \ y x h W u -> FC[y, x, h, W, u].res, \ y x h W u -> GC[y, x, h, W, u].res, ut].utS ;
 } ;
} ;
