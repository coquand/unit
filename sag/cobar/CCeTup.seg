-- CCeTup.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', over the
-- empty context, on the closed copy Ec of yo(y).A: the two tuples of an
-- equation's variables as natural maps into CHtpyAlg's iterated products
-- Pm (m + n): the G-tuple (the telescope point: gY(d) then the new values)
-- and the Q-tuple (c2's valuation point: hval(alpha d) then psi of the new
-- values), by conversions from the telescope contexts, by recursion.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module TU (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module CV = CCeVals[a].CV[R, encK, pe, y, u, y'] ;
 module PO2 = CPsiOps2[a].PO2[R, encK, pe, y'] ;
 module E = PO2.E ;
 module H = PO2.H ;
 module HO = PO2.HO ;
 module AP = PO2.AP ;
 module AQ = CHtpyAlg[a].Alg[R, PO2.Nl, PO2.Qc, PO2.Qc, E.addA, E.addAN, E.mulA, E.mulAN, H.cA, H.cAN, E.addA, E.addAN, E.mulA, E.mulAN, H.cA, H.cAN, HO.idN PO2.Nl PO2.Qc] ;
 module PW = CV.UP.SO.PW ;
 module S1 = CV.S1 ;
 Nl : L.PCtx = PO2.Nl ;
 Ec : L.PTy[Nl] = CV.Ec ;
 n : Nat = y.1 ;
 m : Nat = u.1 ;
 kk : Nat = Arith[a].plus m n ;
 -- G side: the telescope contexts to Pm
 cG0 : (j : Nat) (I : Ob) -> V1.Ix ((PW.Gk j).ob (CV.K0 I)) -> V1.Ix ((AP.Pm j).tob I tt) = split {
  zero -> \ I x -> tt ;
  suc j | r -> \ I x -> (r I x.1, x.2) } ;
 cG : (j : Nat) (I : Ob) -> V1.Ix ((CV.UP.Ex j).ob (CV.K0 I)) -> V1.Ix ((AP.Pm (Arith[a].plus j n)).tob I tt) = split {
  zero -> \ I x -> cG0 n I x ;
  suc j | r -> \ I x -> (r I x.1, x.2) } ;
 -- Q side: c2's contexts of Q-tuples to Pm
 cQ : (j : Nat) (I : Ob) -> V1.Ix ((S1.EV.Gk j).ob I) -> V1.Ix ((AQ.Pm j).tob I tt) = split {
  zero -> \ I x -> tt ;
  suc j | r -> \ I x -> (r I x.1, x.2) } ;
 -- naturality of the G-side conversions
 cG0N : (j : Nat) (J I : Ob) (h : Hom J I) (x : V1.Ix ((PW.Gk j).ob (CV.K0 I)))
  -> Id (V1.Ix ((AP.Pm j).tob J tt)) ((AP.Pm j).tact J I h tt tt (refl tt) (cG0 j I x)) (cG0 j J ((PW.Gk j).act (CV.K0 J) (CV.K0 I) (CV.qm J I h) x)) = split {
  zero -> \ J I h x -> refl tt ;
  suc j | r -> \ J I h x -> apH {V1.Ix ((AP.Pm j).tob J tt)} {V1.Ix ((AP.Pm (suc j)).tob J tt)} (\ a0 -> (a0, PO2.Tc.tact J I h tt tt (refl tt) x.2)) (r J I h x.1) } ;
 cGN : (j : Nat) (J I : Ob) (h : Hom J I) (x : V1.Ix ((CV.UP.Ex j).ob (CV.K0 I)))
  -> Id (V1.Ix ((AP.Pm (Arith[a].plus j n)).tob J tt)) ((AP.Pm (Arith[a].plus j n)).tact J I h tt tt (refl tt) (cG j I x)) (cG j J ((CV.UP.Ex j).act (CV.K0 J) (CV.K0 I) (CV.qm J I h) x)) = split {
  zero -> \ J I h x -> cG0N n J I h x ;
  suc j | r -> \ J I h x -> apH {V1.Ix ((AP.Pm (Arith[a].plus j n)).tob J tt)} {V1.Ix ((AP.Pm (suc (Arith[a].plus j n))).tob J tt)} (\ a0 -> (a0, PO2.Tc.tact J I h tt tt (refl tt) x.2)) (r J I h x.1) } ;
 -- the G-tuple
 PG : L.PTy[Nl] = AP.Pm kk ;
 fG (I : Ob) : (x : Top) -> V1.Ix (Ec.tob I x) -> V1.Ix (PG.tob I x) = split { tt -> \ w -> cG m I (CV.xi I w) } ;
 fGn (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (PG.tob J tt)) (PG.tact J I h tt tt e (cG m I (CV.xi I w))) (cG m J (CV.xi J (Ec.tact J I h tt tt e w))) =
  transH (L.tact-irr Nl PG J I h tt tt e (refl tt) (cG m I (CV.xi I w)))
   (transH (cGN m J I h (CV.xi I w)) (apH {V1.Ix ((CV.UP.Ex m).ob (CV.K0 J))} {V1.Ix (PG.tob J tt)} (cG m J) (CV.xiN J I h w))) ;
 tupG : HO.NMap[Nl, Ec, PG] = CV.CB.TopN[PG, fG, fGn].nm ;
 -- naturality of the Q-side conversion
 module S2 = CSolT[a].SolOf2[R, encK, pe, y, u, y'] ;
 Qc : L.PTy[Nl] = PO2.Qc ;
 cQN : (j : Nat) (J I : Ob) (h : Hom J I) (x : V1.Ix ((S1.EV.Gk j).ob I))
  -> Id (V1.Ix ((AQ.Pm j).tob J tt)) ((AQ.Pm j).tact J I h tt tt (refl tt) (cQ j I x)) (cQ j J ((S1.EV.Gk j).act J I h x)) = split {
  zero -> \ J I h x -> refl tt ;
  suc j | r -> \ J I h x ->
   transH (apH {V1.Ix ((AQ.Pm j).tob J tt)} {V1.Ix ((AQ.Pm (suc j)).tob J tt)}
      (\ a0 -> (a0, Qc.tact J I h tt tt (L.ntEq (L.extP Nl (AQ.Pm j)) Nl (L.pP Nl (AQ.Pm j)) J I h (tt, cQ j I x.1) (tt, (AQ.Pm j).tact J I h tt tt (refl tt) (cQ j I x.1)) (L.pair-act Nl (AQ.Pm j) J I h tt tt (refl tt) (cQ j I x.1))) x.2)) (r J I h x.1))
    (apH {V1.Ix (Qc.tob J tt)} {V1.Ix ((AQ.Pm (suc j)).tob J tt)} (\ b0 -> (cQ j J ((S1.EV.Gk j).act J I h x.1), b0))
      (L.tact-irr Nl Qc J I h tt tt (L.ntEq (L.extP Nl (AQ.Pm j)) Nl (L.pP Nl (AQ.Pm j)) J I h (tt, cQ j I x.1) (tt, (AQ.Pm j).tact J I h tt tt (refl tt) (cQ j I x.1)) (L.pair-act Nl (AQ.Pm j) J I h tt tt (refl tt) (cQ j I x.1)))
         (L.ntEq (S1.EV.Gk j) Nl (FibCwF[a, a+].fibCwF.eps (S1.EV.Gk j)) J I h x.1 ((S1.EV.Gk j).act J I h x.1) (refl ((S1.EV.Gk j).act J I h x.1))) x.2)) } ;
 -- the Q-tuple
 PQt : L.PTy[Nl] = AQ.Pm kk ;
 zz (I : Ob) (w : V1.Ix (Ec.tob I tt)) : V1.Ix (S1.HXY.1.tob I tt) = CV.CB.hN.nfun I tt w ;
 vv (I : Ob) (w : V1.Ix (Ec.tob I tt)) : S1.PK m I = CV.vN.nfun I tt w ;
 fQ (I : Ob) : (x : Top) -> V1.Ix (Ec.tob I x) -> V1.Ix (PQt.tob I x) = split { tt -> \ w -> cQ kk I (S1.sgT I tt (zz I w) (vv I w)) } ;
 fQn (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (PQt.tob J tt)) (PQt.tact J I h tt tt e (cQ kk I (S1.sgT I tt (zz I w) (vv I w)))) (cQ kk J (S1.sgT J tt (zz J (Ec.tact J I h tt tt e w)) (vv J (Ec.tact J I h tt tt e w)))) =
  transH (L.tact-irr Nl PQt J I h tt tt e (refl tt) (cQ kk I (S1.sgT I tt (zz I w) (vv I w))))
   (transH (cQN kk J I h (S1.sgT I tt (zz I w) (vv I w)))
     (apH {V1.Ix ((S1.EV.Gk kk).ob J)} {V1.Ix (PQt.tob J tt)} (cQ kk J)
       (transH (symH (S2.sgNatT I J h tt (zz I w) (vv I w)))
         (transH (apH {V1.Ix (S1.HXY.1.tob J tt)} {V1.Ix ((S1.EV.Gk kk).ob J)} (\ z2 -> S1.sgT J tt z2 (S2.PmA' I J h tt (zz I w) (vv I w))) (CV.CB.hN.nnat J I h tt tt (refl tt) w))
           (apH {S1.PK m J} {V1.Ix ((S1.EV.Gk kk).ob J)} (\ v2 -> S1.sgT J tt (zz J (Ec.tact J I h tt tt (refl tt) w)) v2)
             (transH (L.tact-irr Nl (S1.Pm m).1 J I h tt tt (L.ntEq S1.Gh Nl (FibCwF[a, a+].fibCwF.eps S1.Gh) J I h (tt, zz I w) (S1.Gh.act J I h (tt, zz I w)) (refl (S1.Gh.act J I h (tt, zz I w)))) (refl tt) (vv I w))
               (CV.vN.nnat J I h tt tt (refl tt) w))))))) ;
 tupQ : HO.NMap[Nl, Ec, PQt] = CV.CB.TopN[PQt, fQ, fQn].nm ;
} ;
