-- CPshDT.seg (canonicity-45; COBAR.md "Plan: Theorem 29"): the lex
-- operation D-bar A := (D A)[tau_G] on C-types (jonas.pdf §2.3, "DA :=
-- (DA)alpha", for the cobar pseudomorphism D of Cobar.seg), and the record
-- DescentOp: jonas.pdf Definition 4 for T = id, on the raw CwF of C-types
-- with the fibrancy class Cl (CPshUFib), maps of types as CMaps
-- (Prop13), "f is an equivalence" in Prop13U's shape: a uniform trivial
-- fibrancy (UTriv) of the homotopy fibres of f (Prop13.HP).
--   Dbar G A     (D A)[tau_G]  (= Cor15's DAC, DSubT's DAG, by definition)
--   Dbar-sub     (Dbar A)[s] = Dbar (A[s])            (CPshDSubT.DAC-sub)
--   Dbar-fib     A uniformly fibrant => Dbar A uniformly fibrant
--                (Lemma12F along tau_G)
--   eta G A      the unit tau_A : A -> Dbar A as a CMap (Cor15.tauA)
--   DescentOp    the record (Dt, Dt-sub, Dt-fib, unit, Dm, desc1, desc2)
-- The record lives on the raw CwF of C-types with the fibrancy class Cl
-- as a predicate (as T2's DS), not on the CwF of fibrant C-types: there
-- Dt-sub would need Lemma 12's fibration structures to be stable under
-- substitution on the nose.  The paper's Lemma 12 is "naturally in
-- Gamma", so that stability is part of its statement; it is NOT proved
-- here (nothing downstream uses it; recorded in DUALITY.md as a gap).
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;

module DTOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module DST = CPshDSubT[a, l].DSubTOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 open P ;

 -- D-bar on types
 Dbar (G : CCtx) (A : CTy[G]) : CTy[G] = LO.subCTy G DD.DC[G].DCtx DD.DC[G].tau DD.DT[G, A].DCTy ;

 -- it is Cor15's DAC and DSubT's DAG
 Dbar-is (G : CCtx) (A : CTy[G]) : Id (CTy[G]) (Dbar G A) Cor15[a, l].C15[C, G, A].DAC = refl (Dbar G A) ;

 -- stable under C-substitution
 Dbar-sub (De G : CCtx) (s : CSub[De, G]) (A : CTy[G])
  : Id (CTy[De]) (LO.subCTy De G s (Dbar G A)) (Dbar De (LO.subCTy De G s A)) =
  DST.T[De, G, s, A].DAC-sub ;

 -- fibrancy: Lemma 12 over D G, pulled back along tau_G
 Dbar-fib (G : CCtx) (A : CTy[G]) (c : UF.Cl G A) : UF.Cl G (Dbar G A) =
  UF.clSubU G DD.DC[G].DCtx DD.DC[G].tau DD.DT[G, A].DCTy (Lemma12F[a, l].F12[C, G, A, c.1].lemma12F) ;

 -- the unit
 eta (G : CCtx) (A : CTy[G]) : P13.CMap[G, A, Dbar G A] = Cor15[a, l].C15[C, G, A].tauA ;

 ------------------------------------------------------------------
 -- Definition 4 (T = id): a lex operation on C-types, lifting to the
 -- fibrant ones, whose Dt unit_A and unit_(Dt A) are equivalences
 -- (UTriv of their homotopy fibres, uniform in C) for A fibrant

 record DescentOp {
  Dt (G : CCtx) (A : CTy[G]) : CTy[G] ;
  Dt-sub (De G : CCtx) (s : CSub[De, G]) (A : CTy[G]) : Id (CTy[De]) (LO.subCTy De G s (Dt G A)) (Dt De (LO.subCTy De G s A)) ;
  Dt-fib (G : CCtx) (A : CTy[G]) (c : UF.Cl G A) : UF.Cl G (Dt G A) ;
  unit (G : CCtx) (A : CTy[G]) : P13.CMap[G, A, Dt G A] ;
  Dm (G : CCtx) (A B : CTy[G]) (f : P13.CMap[G, A, B]) : P13.CMap[G, Dt G A, Dt G B] ;
  desc1 (G : CCtx) (A : CTy[G]) (c : UF.Cl G A)
   : UTriv (LO.ExtC G (Dt G (Dt G A))) (P13.HP[G, Dt G A, Dt G (Dt G A), Dm G A (Dt G A) (unit G A)].PC) ;
  desc2 (G : CCtx) (A : CTy[G]) (c : UF.Cl G A)
   : UTriv (LO.ExtC G (Dt G (Dt G A))) (P13.HP[G, Dt G A, Dt G (Dt G A), unit G (Dt G A)].PC) ;
 } ;
} ;
