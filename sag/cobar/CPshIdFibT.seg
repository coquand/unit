-- CPshIdFibT.seg (part 2a of CPshIdFib: mT commutes with the C-action, steps m1-m3; the rest and mTC in CPshIdFibT2, split for the ten-second cap) (canonicity-45; (B) stage 2(b), COBAR.md): the Yoneda Id
-- of a uniformly fibrant C-type is uniformly fibrant, and the law of its
-- substitution.
--   YU[G, A, a, b, d, dc, kI, cuI]   the fibrations of the Yoneda Id at each
--            x are core's moved along the Yoneda iso (PosIdY (4), a cart
--            C_x : IdYT -> core IdT over the identity); the iso commutes
--            with the C-actions on readings (taC), hence on end data (sVC),
--            strict fibres (mSC) and totals of the other end (mTC); the
--            moved family is C-uniform when core's is (Res, as
--            CPshUFib.UP.Res with the iso in place of the pull-back cart)
--   idCl     the UFib of Id(a , b): PosIdY.fib at each x, YU in both
--            directions from CPshPathU.PU and CPshCoreIdU.IU
--   INat.law the law of substitution for (IdT , idCl): CPshId.IdNatC.nat
--            and the base's FibIdCen.idTy-nat at each x

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module CIm = PB.CId[l] ;
module PY = PosIdY[a, l] ;
module FIC = FibIdCen[a, l] ;

module IdFibTOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CUm = CPshCoreIdU[a, l].CoreIdUOf[C] ;
 module M1 = CPshIdFibM[a, l].IdFibMOf[C] ;
 open P ;

 module YU2 (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) (e e' : PB.IPt)
  (kI : (x : CO) -> CL.Lines[G.ob x, CUm.CoreIdC[G, A, a0, b0].ty x].CompK[e, e'].Comp)
  (cuI : LO.UF[G, CUm.CoreIdC[G, A, a0, b0].IdT].UComp e e' kI) {
  module Y1 = M1.YU1[G, A, a0, b0, e, e', kI, cuI] ;
  module At (x : CO) { module M = Y1.At[x].M ; module E = Y1.At[x].E ; module E' = Y1.At[x].E' ; } ;
  module SFy = Y1.SFy ; module SFc = Y1.SFc ; module AEy' = Y1.AEy' ; module AEc' = Y1.AEc' ; module SCt-y = Y1.SCt-y ; module SCt-c = Y1.SCt-c ;
  sVC' (y x : CO) (f : CH y x) (X : Ob) (w : AEy'.TVT x X) : Id (AEc'.TVT y X) (At[y].E'.sV X (AEy'.tEv y x f X w)) (AEc'.tEv y x f X (At[x].E'.sV X w)) = Y1.sVC' y x f X w ;
  sVC (y x : CO) (f : CH y x) (X : Ob) (w : Y1.AEy.TVT x X) : Id (Y1.AEc.TVT y X) (At[y].E.sV X (Y1.AEy.tEv y x f X w)) (Y1.AEc.tEv y x f X (At[x].E.sV X w)) = Y1.sVC y x f X w ;
  -- the map of totals of the other end mT commutes with the C-action
  -- (the readings of the two sides, step by step)
  m1 (y x : CO) (f : CH y x) (X : Ob) (v : At[x].M.TT'.EI X)
   : Id (AEc'.TVT y X) (At[y].M.CK.SE.mV X (At[y].M.mT X (SCt-y.tEs y x f X v))) (At[y].E'.sV X (SCt-y.rB y X (SCt-y.tEs y x f X v))) =
   refl (At[y].E'.sV X (SCt-y.rB y X (SCt-y.tEs y x f X v))) ;
  opaque m1 ;
  m2 (y x : CO) (f : CH y x) (X : Ob) (v : At[x].M.TT'.EI X)
   : Id (AEc'.TVT y X) (At[y].E'.sV X (SCt-y.rB y X (SCt-y.tEs y x f X v))) (At[y].E'.sV X (AEy'.tEv y x f X (SCt-y.rB x X v))) =
   apH (At[y].E'.sV X) (SCt-y.rBtE y x f X v) ;
  opaque m2 ;
  m3 (y x : CO) (f : CH y x) (X : Ob) (v : At[x].M.TT'.EI X)
   : Id (AEc'.TVT y X) (At[y].E'.sV X (AEy'.tEv y x f X (SCt-y.rB x X v))) (AEc'.tEv y x f X (At[x].E'.sV X (SCt-y.rB x X v))) =
   sVC' y x f X (SCt-y.rB x X v) ;
  opaque m3 ;
 } ;
} ;
