-- CPshPiFib.seg (canonicity-c2; COBAR.md (B) stage 2(c), M1): the
-- compositions of (Pi_A B)_x from compositions of its components.
--
-- Fix x and two ends e, e'.  For (y , f : y -> x) let T y f be the base
-- product Pi_y pulled back along act f, a base type over G_x, and
-- al y f : (Pi_A B)_x -> T y f the projection b |-> b y f (a map of base
-- types over G_x).  CMapLine moves points over an end (tvM), partial
-- lines (tsM) and sides (mapS) along al y f.  Given compositions cT y f
-- of the T y f, the family
--     kcomp X w p = \ y f -> (cT y f).kop (tvM w) (mapS p)
-- is the composition of (Pi_A B)_x as soon as it is natural in C
-- (NatComp, a hypothesis of this file, discharged in CPshPiFibN):
-- kside and kunif hold componentwise (tot-extC: a total of Pi is
-- determined by its projections).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module MLn = PB.CMapLine[l] ;

module FibOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 open P ;

 module Fr (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (x : CO) (e e' : PB.IPt) {
  module PC = PO.PiC[G, A, B] ;
  Gx : PCtx = G.ob x ;
  PiX : PTy[Gx] = PC.piTy x ;
  module TP = GPR.TyL[Gx, PiX] ;
  module CKP = CL.Lines[Gx, PiX].CompK[e, e'] ;
  module KPe = CL.EndKit[Gx, PiX, e'] ;
  module TTP = GPR.TyL[CKP.EK.TV.E, CKP.Tend] ;

  -- the components, as base types over G_x, and the projections
  TT (y : CO) (f : CH y x) : PTy[Gx] = subTy Gx (G.ob y) (PC.PiB y) (G.act y x f) ;
  prM (y : CO) (f : CH y x) (X : Ob) (w : TP.EI X) : SigT Gx (TT y f) X =
   pairE Gx (TT y f) X (fstE Gx PiX X w) ((sndE Gx PiX X w).1 y f) ;
  al (y : CO) (f : CH y x) : CP.PMap[Gx, PiX, TT y f] =
   new CP.PMap[Gx, PiX, TT y f, prM y f, \ X w -> refl (fstE Gx PiX X w),
    \ Y X h w -> apH (\ v -> pairE Gx (TT y f) Y (Gx.act Y X h (fstE Gx PiX X w)) v)
       (tact-irr (G.ob y) (PC.PiB y) Y X h (PC.At[x, X, fstE Gx PiX X w].ptC y f) (PC.At[x, Y, Gx.act Y X h (fstE Gx PiX X w)].ptC y f)
          (PC.Act[x, Y, X, h, fstE Gx PiX X w, Gx.act Y X h (fstE Gx PiX X w), refl (Gx.act Y X h (fstE Gx PiX X w))].ePt y f)
          (ntEq Gx (G.ob y) (G.act y x f) Y X h (fstE Gx PiX X w) (Gx.act Y X h (fstE Gx PiX X w)) (refl (Gx.act Y X h (fstE Gx PiX X w))))
          ((sndE Gx PiX X w).1 y f))] ;

  -- a total of Pi is determined by its projections
  tot-extC (W : Ob) (u v : TP.EI W) (H : (y : CO) (f : CH y x) -> Id (SigT Gx (TT y f) W) (prM y f W u) (prM y f W v)) : Id (TP.EI W) u v =
   idJ (W0.Ix (Gx.ob W)) (fstE Gx PiX W u)
    (\ g1 p1 -> (u1 : PC.At[x, W, g1].PiIx)
       -> ((y : CO) (f : CH y x) -> Id (SigT Gx (TT y f) W) (prM y f W u) (pairE Gx (TT y f) W g1 (u1.1 y f)))
       -> Id (TP.EI W) u (pairE Gx PiX W g1 u1))
    (\ u1 H1 -> apH (\ z -> pairE Gx PiX W (fstE Gx PiX W u) z)
       (PC.At[x, W, fstE Gx PiX W u].pi-eqC (sndE Gx PiX W u) u1 (\ y f ->
          GPR.TyL[Gx, TT y f].pr-inj W (fstE Gx PiX W u) ((sndE Gx PiX W u).1 y f) (u1.1 y f) (H1 y f))))
    (fstE Gx PiX W v) (apH (\ t -> fstE Gx (TT x (cid x)) W t) (H x (cid x))) (sndE Gx PiX W v) H ;

  -- the other end, read in E
  rdP (V : Ob) (u : TTP.EI V) : TP.EI V = KPe.endE V (CKP.SE.mV V u) ;
  rdP-act (V' V : Ob) (g : Hom V' V) (u : TTP.EI V) : Id (TP.EI V') (rdP V' (TTP.E.act V' V g u)) (TP.E.act V' V g (rdP V u)) =
   transH (apH (KPe.endE V') (symH (CKP.SE.mV-nat V' V g u))) (KPe.endE-act V' V g (CKP.SE.mV V u)) ;
  tt-ext (W : Ob) (u v : TTP.EI W) (p : Id (CKP.EK.TV.EI W) (TTP.pr1 W u) (TTP.pr1 W v)) (q : Id (TP.EI W) (rdP W u) (rdP W v)) : Id (TTP.EI W) u v =
   CKP.SE.mV-inj W u v p (KPe.tv-eq W (CKP.SE.mV W u) (CKP.SE.mV W v) (apH (\ z -> CKP.EK.TV.pr1 W z) p) q) ;

  -- at (y , f)
  module Cm (y : CO) (f : CH y x) {
   module M = MLn.MapLine[Gx, PiX, TT y f, al y f, e] ;
   module CKT = CL.Lines[Gx, TT y f].CompK[e, e'] ;
   module KTe = CL.EndKit[Gx, TT y f, e'] ;
   module TTT = GPR.TyL[CKT.EK.TV.E, CKT.Tend] ;
   module TTy = GPR.TyL[Gx, TT y f] ;
   module RCT = CP.Rel[CKT.EK.TV.E, CKT.EK.SFm.SF, CKT.Tend, CKT.endL] ;
   rdT (V : Ob) (u : TTT.EI V) : TTy.EI V = KTe.endE V (CKT.SE.mV V u) ;
   rdT-act (V' V : Ob) (g : Hom V' V) (u : TTT.EI V) : Id (TTy.EI V') (rdT V' (TTT.E.act V' V g u)) (TTy.E.act V' V g (rdT V u)) =
    transH (apH (KTe.endE V') (symH (CKT.SE.mV-nat V' V g u))) (KTe.endE-act V' V g (CKT.SE.mV V u)) ;
   -- the other end of a moved line is the projection of the other end
   endM-rd (W : Ob) (u : CKP.EK.TS.EI W) : Id (TTy.EI W) (rdT W (CKT.endL.mE W (M.tsM W u))) (prM y f W (rdP W (CKP.endL.mE W u))) =
    transH (CKT.EV'.endB-E W (CKT.EK.lineL W (M.tsM W u)))
     (transH (M.tsM-val W u W (idH W) (PB.ptH W e'))
       (apH (\ t -> prM y f W t) (symH (CKP.EV'.endB-E W (CKP.EK.lineL W u))))) ;
  } ;

  ------------------------------------------------------------------
  -- the composition, from compositions of the components

  gE (X : Ob) (w : CKP.EK.TV.EI X) : W0.Ix (Gx.ob X) = (CL.FC[Gx].ev e').nt X (CKP.EK.TV.pr1 X w) ;

  module Cp (cT : (y : CO) (f : CH y x) -> Cm[y, f].CKT.Comp) {
   kcomp (X : Ob) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w]) : PC.At[x, X, gE X w].Comp =
    \ y f -> (cT y f).kop X (Cm[y, f].M.tvM X w) (Cm[y, f].M.mapS X w p) ;
   -- the hypothesis: the family of composites is natural in C
   NatComp : U l = (X : Ob) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w]) -> PC.At[x, X, gE X w].CNat (kcomp X w p) ;

   module Wn (nc : NatComp) {
    kop (X : Ob) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w]) : TTP.T X w = (kcomp X w p, nc X w p) ;
    kt (X : Ob) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w]) : TTP.EI X = TTP.pr X w (kop X w p) ;
    ktT (y : CO) (f : CH y x) (X : Ob) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w]) : Cm[y, f].TTT.EI X =
     Cm[y, f].TTT.pr X (Cm[y, f].M.tvM X w) ((cT y f).kop X (Cm[y, f].M.tvM X w) (Cm[y, f].M.mapS X w p)) ;
    -- by definition: the reading of the composite, projected
    kt-rd (y : CO) (f : CH y x) (X : Ob) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w])
     : Id (Cm[y, f].TTy.EI X) (prM y f X (rdP X (kt X w p))) (Cm[y, f].rdT X (ktT y f X w p)) =
     refl (Cm[y, f].rdT X (ktT y f X w p)) ;
    -- the reading of the restricted composite, projected
    kt-act (y : CO) (f : CH y x) (W X : Ob) (h : Hom W X) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w])
     : Id (Cm[y, f].TTy.EI W) (prM y f W (rdP W (TTP.E.act W X h (kt X w p))))
         (Cm[y, f].rdT W (Cm[y, f].TTT.E.act W X h (ktT y f X w p))) =
     transH (apH (\ t -> prM y f W t) (rdP-act W X h (kt X w p)))
      (transH ((al y f).mnat W X h (rdP X (kt X w p)))
        (symH (Cm[y, f].rdT-act W X h (ktT y f X w p)))) ;

    ksideC (X : Ob) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w]) (W : Ob) (h : Hom W X) (i : PB.Lands W X p.pQ h)
     (y : CO) (f : CH y x)
     : Id (Cm[y, f].TTy.EI W) (prM y f W (rdP W (TTP.E.act W X h (kt X w p)))) (prM y f W (rdP W (CKP.endL.mE W (p.pv W h i)))) =
     transH (kt-act y f W X h w p)
      (transH (apH (\ t -> Cm[y, f].rdT W t) ((cT y f).kside X (Cm[y, f].M.tvM X w) (Cm[y, f].M.mapS X w p) W h i))
        (Cm[y, f].endM-rd W (p.pv W h i))) ;
    kside (X : Ob) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w]) (W : Ob) (h : Hom W X) (i : PB.Lands W X p.pQ h)
     : Id (TTP.EI W) (TTP.E.act W X h (kt X w p)) (CKP.endL.mE W (p.pv W h i)) =
     tt-ext W (TTP.E.act W X h (kt X w p)) (CKP.endL.mE W (p.pv W h i)) (symH (p.ppt W h i))
      (tot-extC W (rdP W (TTP.E.act W X h (kt X w p))) (rdP W (CKP.endL.mE W (p.pv W h i))) (ksideC X w p W h i)) ;

    -- the projected side of the restricted side
    sdR (y : CO) (f : CH y x) (Y X : Ob) (h : Hom Y X) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w])
     : Id (Cm[y, f].CKT.EK.PT.Side[Y, Cm[y, f].M.tvM Y (CKP.EK.TV.E.act Y X h w)])
         (subst (Cm[y, f].CKT.EK.TV.EI Y) (\ z -> Cm[y, f].CKT.EK.PT.Side[Y, z])
            (Cm[y, f].CKT.EK.TV.E.act Y X h (Cm[y, f].M.tvM X w)) (Cm[y, f].M.tvM Y (CKP.EK.TV.E.act Y X h w))
            (symH (Cm[y, f].M.tvM-act Y X h w))
            (Cm[y, f].CKT.EK.PT.rside Y X h (Cm[y, f].M.tvM X w) (Cm[y, f].M.mapS X w p)))
         (Cm[y, f].M.mapS Y (CKP.EK.TV.E.act Y X h w) (CKP.EK.PT.rside Y X h w p)) =
     Cm[y, f].CKT.EK.PT.side-extH Y (Cm[y, f].CKT.EK.TV.E.act Y X h (Cm[y, f].M.tvM X w)) (Cm[y, f].M.tvM Y (CKP.EK.TV.E.act Y X h w))
      (symH (Cm[y, f].M.tvM-act Y X h w))
      (Cm[y, f].CKT.EK.PT.rside Y X h (Cm[y, f].M.tvM X w) (Cm[y, f].M.mapS X w p))
      (Cm[y, f].M.mapS Y (CKP.EK.TV.E.act Y X h w) (CKP.EK.PT.rside Y X h w p))
      (refl (PB.pre Y X h p.pQ))
      (\ W g i i' -> apH (\ t -> Cm[y, f].M.tsM W t) (CKP.EK.PT.pv-irr Y (CKP.EK.TV.E.act Y X h w) (CKP.EK.PT.rside Y X h w p) W g i i')) ;
    kunifC (Y X : Ob) (h : Hom Y X) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w]) (y : CO) (f : CH y x)
     : Id (Cm[y, f].TTy.EI Y) (prM y f Y (rdP Y (TTP.E.act Y X h (kt X w p))))
         (prM y f Y (rdP Y (kt Y (CKP.EK.TV.E.act Y X h w) (CKP.EK.PT.rside Y X h w p)))) =
     transH (kt-act y f Y X h w p)
      (apH (\ t -> Cm[y, f].rdT Y t)
        (transH ((cT y f).kunif Y X h (Cm[y, f].M.tvM X w) (Cm[y, f].M.mapS X w p))
          (Cm[y, f].RCT.kop-cong (cT y f) Y (Cm[y, f].CKT.EK.TV.E.act Y X h (Cm[y, f].M.tvM X w)) (Cm[y, f].M.tvM Y (CKP.EK.TV.E.act Y X h w))
             (symH (Cm[y, f].M.tvM-act Y X h w))
             (Cm[y, f].CKT.EK.PT.rside Y X h (Cm[y, f].M.tvM X w) (Cm[y, f].M.mapS X w p))
             (Cm[y, f].M.mapS Y (CKP.EK.TV.E.act Y X h w) (CKP.EK.PT.rside Y X h w p))
             (sdR y f Y X h w p)))) ;
    kunif (Y X : Ob) (h : Hom Y X) (w : CKP.EK.TV.EI X) (p : CKP.EK.PT.Side[X, w])
     : Id (TTP.EI Y) (TTP.E.act Y X h (kt X w p)) (kt Y (CKP.EK.TV.E.act Y X h w) (CKP.EK.PT.rside Y X h w p)) =
     tt-ext Y (TTP.E.act Y X h (kt X w p)) (kt Y (CKP.EK.TV.E.act Y X h w) (CKP.EK.PT.rside Y X h w p)) (refl (CKP.EK.TV.E.act Y X h w))
      (tot-extC Y (rdP Y (TTP.E.act Y X h (kt X w p))) (rdP Y (kt Y (CKP.EK.TV.E.act Y X h w) (CKP.EK.PT.rside Y X h w p))) (kunifC Y X h w p)) ;

    -- the composition of (Pi_A B)_x from e to e'
    comp : CKP.Comp = CP.Rel[CKP.EK.TV.E, CKP.EK.SFm.SF, CKP.Tend, CKP.endL].mkRC kop kside kunif ;
   } ;
  } ;
 } ;
} ;
