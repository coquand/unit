-- CUG25.seg (canonicity-c2; the generic (U), part 25 of CCmpU25's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU25 with
-- F2 replaced by s and the generator cases a hypothesis gen.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
-- transporting a Pi element along an Id of families, and its body
bodTr (G : C.Ctx) (A : C.Ty G) (B1 B2 : C.Ty (C.ext G A)) (P : Id (C.Ty (C.ext G A)) B1 B2) (F : C.El G (FibCwF[a, a+].fibPi.Pi G A B1))
  : Id (C.El (C.ext G A) B2)
       (OV.bod G A B2 (OV.trE G (FibCwF[a, a+].fibPi.Pi G A B1) (FibCwF[a, a+].fibPi.Pi G A B2) (apH {C.Ty (C.ext G A)} {C.Ty G} (\ B -> FibCwF[a, a+].fibPi.Pi G A B) P) F))
       (OV.trE (C.ext G A) B1 B2 P (OV.bod G A B1 F)) =
 idJ (C.Ty (C.ext G A)) B1
  (\ B3 P3 -> Id (C.El (C.ext G A) B3)
       (OV.bod G A B3 (OV.trE G (FibCwF[a, a+].fibPi.Pi G A B1) (FibCwF[a, a+].fibPi.Pi G A B3) (apH {C.Ty (C.ext G A)} {C.Ty G} (\ B -> FibCwF[a, a+].fibPi.Pi G A B) P3) F))
       (OV.trE (C.ext G A) B1 B3 P3 (OV.bod G A B1 F)))
  (refl (OV.bod G A B1 F)) B2 P ;
module UG25 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) (gen : (v : SX.Fin s.1) -> C.El (C.ext C.nil H) (CUG20[a].UG20[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN].IdZ (CHomT3[a].HomP[R, encK, pe].Alg[s].AX.cls (var v)))) {
 module U24m = CUG24[a].UG24[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN, gen] ;
 module U13m = U24m.U13m ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = U13m.GH ;
 QA : C.Ty Nl = U13m.QA ;
 QY : C.Ty Nl = U13m.QY ;
 QYh : C.Ty GH = U13m.QYh ;
 MTh : C.Ty GH = U13m.MTh ;
 module T6 = CCmpU6[a].TR6[H, QA, QY] ;
 QH : C.Ty GH = T6.A' ;
 E1 : C.Ctx = C.ext GH QH ;
 FunT : C.Ty GH = OV.Fun GH QH QYh ;
 sL : C.Sub E1 Nl = C.o E1 (C.ext Nl QA) Nl (C.p Nl QA) (C.lift GH Nl QA (C.p Nl H)) ;
 sR : C.Sub E1 Nl = C.o E1 GH Nl (C.p Nl H) (C.p GH QH) ;
 PB1 : Id (C.Ty E1) T6.B' (C.subT E1 Nl QY sL) = symH (C.subT-o E1 (C.ext Nl QA) Nl QY (C.p Nl QA) (C.lift GH Nl QA (C.p Nl H))) ;
 PB2 : Id (C.Ty E1) (C.subT E1 Nl QY sL) (C.subT E1 Nl QY sR) =
  apH {C.Sub E1 Nl} {C.Ty E1} (\ s -> C.subT E1 Nl QY s) (transH (C.eps-uniq E1 sL) (symH (C.eps-uniq E1 sR))) ;
 PB3 : Id (C.Ty E1) (C.subT E1 Nl QY sR) (OV.wkT GH QH QYh) = C.subT-o E1 GH Nl QY (C.p Nl H) (C.p GH QH) ;
 PB : Id (C.Ty E1) T6.B' (OV.wkT GH QH QYh) = transH PB1 (transH PB2 PB3) ;
 Ppi : Id (C.Ty GH) T6.PiT FunT = apH {C.Ty E1} {C.Ty GH} (\ B -> FibCwF[a, a+].fibPi.Pi GH QH B) PB ;
 } ;
