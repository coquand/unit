-- CCst2.seg (canonicity-45; COBAR.md "constants"): the comparison
-- yo F0 -> 1 (F0 the presentation with no generators) is a levelwise
-- equivalence, from Hom(F0, y) contractible at each copy (c2's nullary
-- (U)/(E), a module parameter): CtrE (CContrEq) at HomT(F0, y) and a closed
-- unit type, moved to C's codes (alpha on yo F0, the identity on 1), the
-- copies assembled (CCopy3.eqG0); Prop 13 makes D of it an equivalence.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module LR = CLocBoundRetr[a, a+] ;
module FC = FibCwF[a, a+].FC ;
module HO = PB.CHtpyOps[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Cst (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module CM = CC.CM ;
 module TR = CC.TR ;
 module CT = CTotCtxTy[a, a+, a+].CtxTy[CM.IC] ;
 module HP = CHomT3[a].HomP[R, encK, pe] ;
 F0 : SX.Over[R].Presentation = (zero, nil) ;
 Y0 : CM.TP.TCtx = CM.Yo[F0].yoT ;
 module O0 = CT.Of[Y0] ;
 module OT = CT.Of[CT.T1] ;
 -- yo F0 -> 1 as a map of types over the terminal context
 cF : TR.G1.GB.CPartial[a+].PMap[CT.P1, O0.Y1T, OT.Y1T] =
  TR.G1.GB.CPartial[a+].mkPMap CT.P1 O0.Y1T OT.Y1T (\ X w -> (w.1, tt)) (\ X w -> refl w.1) (\ Z X h w -> refl ((CT.P1.act Z X h w.1), tt)) ;
 module PD = CTotP13d[a, a+, a+].P13d[CM.IC, CT.T1, O0.Y1T, OT.Y1T, cF] ;
 -- the closed unit type at a copy
 Ut : FC.STy C.nil = CConst[a, a+].ConstOf[CCyl[a].PosCyl.posCyl, V1.unitV].constS C.nil ;
 module EQ3 = CCopy3[a].EqC[R, encK, pe, PD.UG, PD.UA, PD.UB, PD.Uf] ;
 module Cp (y' : SX.Over[R].Presentation) {
  module Yy = EQ3.Y[y'] ;
  D : L.PCtx = Yy.Gy ;
  By : L.PTy[D] = Yy.By ;
  Ay : L.PTy[D] = Yy.Ay ;
  HU : C.Ty C.nil = HP.Hom[F0, y'].HomT ;
   module P = CHomT4[a].P3[R, encK, pe, F0, y'] ;
   module FM = CHomT11[a].FromM[R, encK, pe, F0, y'] ;
   module TM = CHomT8[a].ToM[R, encK, pe, F0, y'] ;
   module NA = CHomT16[a].Nat[R, encK, pe, F0, y'] ;
   probe (I : Ob) (o : V1.Ix (D.ob I)) (m : V1.Ix (By.tob I o)) : P.F.M I = m ;
   resEq (J I : Ob) (uu : Hom J I) (o : V1.Ix (D.ob I)) (o' : V1.Ix (D.ob J)) (e : Id (V1.Ix (D.ob J)) (D.act J I uu o) o') (m : V1.Ix (By.tob I o))
    : Id (P.F.M J) (By.tact J I uu o o' e m) (P.F.res I J uu m) =
    P.F.mExt J (By.tact J I uu o o' e m) (P.F.res I J uu m) (refl (P.F.fpOf J (P.F.res I J uu m))) ;
   module TBp = PB.GPre[a+].TyL[D, By] ;
   module TB0 = PB.GPre[a+].TyL[C.nil, HU.1] ;
   Z (W : Ob) : U a+ = V1.Ix (HU.1.tob W tt) ;
   -- the cart on yo(y.u): alpha
   tB (W : Ob) (v : TBp.EI W) : TB0.EI W = (tt, FM.alpha W v.2) ;
   aR (V W : Ob) (g : Hom V W) (v : TBp.EI W) : Id (Z V) (HU.1.tact V W g tt tt (refl tt) (FM.alpha W v.2)) (FM.alpha V (TBp.E.act V W g v).2) =
    transH (symH (NA.aNat W V g v.2))
     (apH {P.F.M V} {Z V} (FM.alpha V) (symH (resEq V W g v.1 (D.act V W g v.1) (refl (D.act V W g v.1)) v.2))) ;
   tBnat (V W : Ob) (g : Hom V W) (v : TBp.EI W) : Id (TB0.EI V) (TB0.E.act V W g (tB W v)) (tB V (TBp.E.act V W g v)) =
    apH {Z V} {TB0.EI V} (\ z -> (tt, z)) (aR V W g v) ;
   snd2 (W : Ob) (z z' : Z W) (Q : Id (TB0.EI W) (tt, z) (tt, z')) : Id (Z W) z z' =
    apH {TB0.EI W} {Z W} (\ pp -> subst Top (\ o -> V1.Ix (HU.1.tob W o)) pp.1 tt (isTop pp.1 tt) pp.2) Q ;
   tBinj (W : Ob) (v v' : TBp.EI W) (Pe : Id (V1.Ix (D.ob W)) v.1 v'.1) (Q : Id (TB0.EI W) (tB W v) (tB W v')) : Id (TBp.EI W) v v' =
    transH (apH {V1.Ix (D.ob W)} {TBp.EI W} (\ o2 -> (o2, v.2)) Pe)
     (apH {P.F.M W} {TBp.EI W} (\ m2 -> (v'.1, m2))
       (transH (symH (CHomT12[a].RT1[R, encK, pe, F0, y'].At[W, v.2].rt))
         (transH (apH {Z W} {P.F.M W} (TM.beta W) (snd2 W (FM.alpha W v.2) (FM.alpha W v'.2) Q))
           (CHomT12[a].RT1[R, encK, pe, F0, y'].At[W, v'.2].rt)))) ;
   bkB (X : Ob) (x : V1.Ix (D.ob X)) (z : Z X) : V1.Ix (By.tob X x) = TM.beta X z ;
   bkBta (X : Ob) (x : V1.Ix (D.ob X)) (z : Z X) : Id (TB0.EI X) (tB X (TBp.pr X x (bkB X x z))) (TB0.pr X tt z) =
    apH {Z X} {TB0.EI X} (\ z0 -> (tt, z0)) (CHomT13[a].RT2[R, encK, pe, F0, y'].At[X, z].rt) ;
   -- the cart on 1: the identity on fibres
   module TAp = PB.GPre[a+].TyL[D, Ay] ;
   module TA0 = PB.GPre[a+].TyL[C.nil, Ut.1] ;
   tA (W : Ob) (v : TAp.EI W) : TA0.EI W = (tt, v.2) ;
   tAinj (W : Ob) (v v' : TAp.EI W) (Pe : Id (V1.Ix (D.ob W)) v.1 v'.1) (Q : Id (TA0.EI W) (tA W v) (tA W v')) : Id (TAp.EI W) v v' =
    transH (apH {V1.Ix (D.ob W)} {TAp.EI W} (\ o2 -> (o2, v.2)) Pe) (apH {V1.Ix (Ay.tob W v'.1)} {TAp.EI W} (\ b -> (v'.1, b)) (isTop v.2 v'.2)) ;
   module Mv (kY : C.El C.nil (EQ.isContr C.nil HU)) {
    module CQ = CContrEq[a, a+].CtrE[HU, Ut, kY, \ I x -> tt, \ J I h x y e -> refl tt, \ I x u v -> isTop u v] ;
    module H = PB.CHFibCart[a+, a+].HCart[D, By, Ay, Yy.fy, C.nil, HU.1, Ut.1, LR.Map[C.nil, HU.1, Ut.1, CQ.fN].pmap, \ W x -> tt, \ V W g d -> refl tt,
      tA, \ W v -> refl tt, \ V W g v -> refl (tA V (TAp.E.act V W g v)), tAinj, \ X x z -> z, \ X x z -> refl (TA0.pr X tt z),
      tB, \ W v -> refl tt, tBnat, tBinj, bkB, bkBta, \ W v -> refl (tA W (Yy.fy.mE W v))] ;
    eqy : PB.CEquiv[a+].EquivOp D By Ay Yy.fy = H.moveEq CQ.eqf ;
   } ;
 } ;
 -- the levelwise equivalence, and D of it
 module Fin (cF0 : (y' : SX.Over[R].Presentation) -> C.El C.nil (EQ.isContr C.nil (HP.Hom[F0, y'].HomT))) {
  ef0 : CC.G0.GB.CEquiv[a+].EquivOp PD.UG PD.UA PD.UB PD.Uf = EQ3.eqG0 (\ y' -> Cp[y'].Mv[cF0 y'].eqy) ;
  module P13 = CTotP13o[a, a+, a+].P13[CM.IC, CT.T1, O0.Y1T, OT.Y1T, cF] ;
  dF : TR.G1.GB.CEquiv[a+].EquivOp P13.DF.DG P13.DF.DA.DTy P13.DF.DB.DTy P13.DF.Df = P13.prop13 ef0 ;
 } ;
} ;
