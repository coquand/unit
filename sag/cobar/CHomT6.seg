-- CHomT6.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 3: the function part's
-- naturality in CMorX's form (natPh: the Fun fibre's naturality, its two
-- actions normalised by tact-irr, as CSemOp's step C).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
module PB = PosFull[a].PB ;
module LP = PB.GPre[a+].PS ;

module NatOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module P = CHomT4[a].P3[R, encK, pe, s, t] ;
 module F = P.F ;
 module H = P.H ;
 QS : C.Ty C.nil = P.HP.Alg[s].Qt ;
 QT : C.Ty C.nil = P.HP.Alg[t].Qt ;
 module PC = PresheafPi[a, a+].PPi[PB.BC].PiCode[C.nil, QS.1, (OV.wkT C.nil QS QT).1] ;
 natPh (I : Ob) (z : P.Z I) : F.Nat I (P.ph I z) = \ K L f g u ->
  transH {F.T.QK L} {F.T.rs K L g (P.ph I z K f u)}
    {PC.BactOf I (PC.ptOf I tt) (PC.cOf I tt) (PC.eOf I tt) K L f g u (P.ph I z K f u)} {P.ph I z L (compH L K I f g) (F.S.rs K L g u)}
   (LP.tact-irr C.nil QT.1 L K g tt tt (refl tt)
      (LP.ntEq (C.ext C.nil QS) C.nil (C.p C.nil QS) L K g (LP.pairE C.nil QS.1 K tt u) (LP.pairE C.nil QS.1 L tt (PC.AactOf I (PC.ptOf I tt) (PC.cOf I tt) K L f g u)) (PC.eOf I tt K L f g u))
      (P.ph I z K f u))
   (transH {F.T.QK L} {PC.BactOf I (PC.ptOf I tt) (PC.cOf I tt) (PC.eOf I tt) K L f g u (P.ph I z K f u)}
      {P.ph I z L (compH L K I f g) (PC.AactOf I (PC.ptOf I tt) (PC.cOf I tt) K L f g u)} {P.ph I z L (compH L K I f g) (F.S.rs K L g u)}
     (z.1.2 K L f g u)
     (apH {F.S.QK L} {F.T.QK L} (\ b -> P.ph I z L (compH L K I f g) b) (LP.tact-irr C.nil QS.1 L K g tt tt (PC.cOf I tt K L f g) (refl tt) u))) ;
} ;
