-- CTotP13o.seg (canonicity-45; SIMPLIFIED.md step 4): PROPOSITION 13 at
-- the total site.  For a context G and a map f : A -> B of types over it
-- at the total site of an internal category C: an equivalence structure
-- of U f (f restricted to the levelwise site) gives one of D f.
-- The contraction of D of f's homotopy fibre (c2's Lemma 12 at the
-- levelwise input, CTotP13d) moved by CMove.Mv along Psi on the homotopy
-- fibre of D f: points by the pairing (phi, phiN), totals by CTotP13f,
-- naturality CTotP13g, injectivity CTotP13h, lift back CTotP13l, read-back
-- CTotP13n.
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module P13 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PD = CTotP13d[a, vl, l].P13d[C, G, A, B, f] ;
 module PN = CTotP13n[a, vl, l].P13n[C, G, A, B, f] ;
 module PH = CTotP13h[a, vl, l].P13h[C, G, A, B, f] ;
 module PL = PN.PL ;
 module PG = PN.PG ;
 module PF = PN.PF ;
 module PE = PN.PE ;
 module PB13 = PE.PB13 ;
 module TR = PE.TR ;
 module G0 = TR.G0 ;
 module G1 = TR.G1 ;
 module DF = PE.DF ;
 module HD = PE.HD ;
 module DS = PN.DS ;
 module PR = PE.PR ;
 module TS = G1.GB.GPre[l].TyL[HD.EA, HD.FibT] ;
 module Fin (ef : G0.GB.CEquiv[l].EquivOp PD.UG PD.UA PD.UB PD.Uf) {
  module M = G1.GB.CMove[l, l].Mv[HD.EA, HD.FibT, HD.FibT, G1.GB.CPartial[l].pmap-id HD.EA HD.FibT,
    PG.D0, DS.DTy, DS.DTy, G1.GB.CPartial[l].pmap-id PG.D0 DS.DTy,
    \ W x -> PR.phi W x, \ V W g x -> PR.phiN V W g x,
    \ W v -> PF.mS W v, \ W v -> refl (PR.phi W (TS.pr1 W v)), \ V W g v -> PG.NS[V, W, g, v].law,
    \ W v -> PF.mS W v, \ W v -> refl (PR.phi W (TS.pr1 W v)), \ V W g v -> PG.NS[V, W, g, v].law,
    \ W v v' P Q -> PH.Inj[W, v, v', P, Q].law,
    \ X x u -> PL.BK[X, x, u].bk, \ X x u -> PN.BM[X, x, u].bkMv,
    \ W v -> refl (PF.mS W v), PD.AL[ef].k] ;
 } ;
 -- Proposition 13
 prop13 (ef : G0.GB.CEquiv[l].EquivOp PD.UG PD.UA PD.UB PD.Uf) : G1.GB.CEquiv[l].EquivOp DF.DG DF.DA.DTy DF.DB.DTy DF.Df = Fin[ef].M.rc ;
} ;
