-- CMorX.seg (canonicity-45; SIMPLIFIED.md step 3): the maps of the internal
-- category C of presented k-algebras (jonas.pdf Construction 39), part 1:
-- the hom codes at a stage, their restriction along the base, identities
-- and composition.  Part 2 (CMorXC): the laws and the CIntCat.IC instance.
--
-- A map y -> x of C over a base map J -> I (homD J I u y x, independent of
-- u: the objects are the constant presentations) is, at the stage J, a map
-- of algebras A_x -> A_y read in the presheaf semantics:
--   the function part   the fibre at J of the internal Fun Q_x Q_y: a
--                       family ph K f : Q_x(K) -> Q_y(K) over the slice
--                       f : K -> J with its naturality nt;
--   Hoefer's data       for each operation o of arity n (add, mul binary;
--                       the constants phi r, r : R, nullary; zero = phi R.z,
--                       one = phi R.o since zeroE = cst R.z, oneE = cst R.o;
--                       neg = mul (phi (-1)) is derived, not a datum): for
--                       every K, f : K -> J, point w = (u, v) of Q_x^n x Q_x
--                       at K and element of the Id fibre (o u = v) at w,
--                       an element of the Id fibre (o (ph u) = ph v) at the
--                       point (ph K f u, ph K f v), natural along the base
--                       (stated for an arbitrary proof e of the point
--                       equation; tact-irr makes the choice immaterial).
-- The data are valued in the Id fibre AT THE POINT (ph u, ph v), not in the
-- fibre of the internal type (o (h u) = h v) over the variable h, whose
-- semantics inserts transports along the context's act-id: so identities
-- are identities and composition is composition in each component, on the
-- nose.  The restriction along v : K -> J is the pure one (ph K' f' :=
-- ph K' (v . f')), so the laws of IC hold on the nose in the function and
-- data families up to the laws of the base category (comp-idl, comp-assoc
-- in the slice argument), the naturality components being propositions
-- (isSetIx + fe): part 2 proves them through one extensionality lemma.
-- No new axioms beyond the named premises (fe) and the module parameters
-- (the operations of the A_x, from c2's elim2 through CAlgX.Ops).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module LP = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module VL = VLift[a, a+] ;
module FB = FibCwF[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module CF = CAlgFun[a] ;
C : CwF.CwF[a++] = FB.fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

------------------------------------------------------------------
-- transport lemmas (all by J)
-- u = tr (sym e) v from tr e u = v
substSym (A : U a++) (P : A -> U a++) (x y : A) (e : Id A x y) (u : P x) (w : P y) (h : Id (P y) (subst A P x y e u) w) : Id (P x) u (subst A P y x (symH e) w) =
 idJ A x (\ y2 e2 -> (w2 : P y2) -> Id (P y2) (subst A P x y2 e2 u) w2 -> Id (P x) u (subst A P y2 x (symH e2) w2)) (\ w2 h2 -> h2) y e w h ;
-- a dependent function applied to a transported argument
depMap (X Y : U a++) (P : X -> U a++) (Q : Y -> U a++) (m : X -> Y) (D : (w : X) -> P w -> Q (m w)) (w1 w2 : X) (e : Id X w1 w2) (q : P w2)
 : Id (Q (m w2)) (subst Y Q (m w1) (m w2) (apH {X} {Y} m e) (D w1 (subst X P w2 w1 (symH e) q))) (D w2 q) =
 idJ X w1 (\ w3 e3 -> (q3 : P w3) -> Id (Q (m w3)) (subst Y Q (m w1) (m w3) (apH {X} {Y} m e3) (D w1 (subst X P w3 w1 (symH e3) q3))) (D w3 q3)) (\ q3 -> refl (D w1 q3)) w2 e q ;
-- the action of a presheaf type along a composite point equation
tactTr (G : C.Ctx) (T : C.Ty G) (J I : Ob) (f : Hom J I) (x : V1.Ix (G.ob I)) (y y' : V1.Ix (G.ob J)) (e : Id (V1.Ix (G.ob J)) (G.act J I f x) y) (e' : Id (V1.Ix (G.ob J)) y y') (t : V1.Ix (T.1.tob I x))
 : Id (V1.Ix (T.1.tob J y')) (T.1.tact J I f x y' (transH e e') t) (subst (V1.Ix (G.ob J)) (\ z -> V1.Ix (T.1.tob J z)) y y' e' (T.1.tact J I f x y e t)) =
 idJ (V1.Ix (G.ob J)) y (\ y2 e2 -> Id (V1.Ix (T.1.tob J y2)) (T.1.tact J I f x y2 (transH e e2) t) (subst (V1.Ix (G.ob J)) (\ z -> V1.Ix (T.1.tob J z)) y y2 e2 (T.1.tact J I f x y e t)))
  (refl (T.1.tact J I f x y e t)) y' e' ;
apdS (A : U a++) (P : A -> U a++) (D : (x : A) -> P x) (x y : A) (e : Id A x y) : Id (P y) (subst A P x y e (D x)) (D y) =
 idJ A x (\ y2 e2 -> Id (P y2) (subst A P x y2 e2 (D x)) (D y2)) (refl (D x)) y e ;

module MorOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (addO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (mulO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt))) {
 Pres : U a = SX.Over[R].Presentation ;
 Nl : C.Ctx = C.nil ;
 RV : W0.V = EN.codeOf R.R encK ;

 ------------------------------------------------------------------
 -- the algebra A_x: its fibres, points of nil.Q, nil.Q.Q.Q, the Id types
 -- of the operations at the variables
 module At (x : Pres) {
  module AX = CAlgX[a].AlgX[R, encK, x, pe] ;
  Qt : C.Ty Nl = AX.Qt ;
  QV (K : Ob) : V1.V = Qt.1.tob K tt ;
  QK (K : Ob) : U a+ = V1.Ix (QV K) ;
  rs (K L : Ob) (g : Hom L K) (u : QK K) : QK L = Qt.1.tact L K g tt tt (refl tt) u ;
  FQ : C.Ty Nl = OV.Fun Nl Qt Qt ;
  G1 : C.Ctx = C.ext Nl Qt ;
  Qw : C.Ty G1 = OV.wkT Nl Qt Qt ;
  q0 : C.El G1 Qw = C.q Nl Qt ;
  G2 : C.Ctx = C.ext G1 Qw ;
  Qw2 : C.Ty G2 = OV.wkT G1 Qw Qw ;
  G3 : C.Ctx = C.ext G2 Qw2 ;
  Qw3 : C.Ty G3 = OV.wkT G2 Qw2 Qw2 ;
  -- points
  P1 (K : Ob) : U a+ = V1.Ix (G1.ob K) ;
  mk1 (K : Ob) (u : QK K) : P1 K = (tt, u) ;
  P3 (K : Ob) : U a+ = V1.Ix (G3.ob K) ;
  T3 (K : Ob) : U a+ = (u1 : QK K) * (u2 : QK K) * QK K ;
  t3V (K : Ob) : V1.V = V1.SigV (QV K) (\ u1 -> V1.SigV (QV K) (\ u2 -> QV K)) ;
  mk3 (K : Ob) (w : T3 K) : P3 K = (((tt, w.1), w.2.1), w.2.2) ;
  rs3 (K L : Ob) (g : Hom L K) (w : T3 K) : T3 L = (rs K L g w.1, (rs K L g w.2.1, rs K L g w.2.2)) ;
  -- the operation applied to the first two variables, over nil.Q.Q
  module Op (op : C.El Nl (OV.Fun Nl Qt FQ)) {
   wG : C.El G1 (OV.Fun G1 Qw (OV.wkT Nl Qt FQ)) = EQ.wkF Nl Qt Qt FQ op ;
   o1 : C.El G1 (OV.Fun G1 Qw Qw) = CF.toFun Qt Qt Qt (OV.app G1 Qw (OV.wkT Nl Qt FQ) wG q0) ;
   o12 : C.El G2 Qw2 = OV.app G2 Qw2 Qw2 (EQ.wkF G1 Qw Qw Qw o1) (C.q G1 Qw) ;
   -- the type  op u1 u2 = v  over nil.Q.Q.Q
   IdB : C.Ty G3 = IJ.IdT G3 Qw3 (OV.wkE G2 Qw2 Qw2 o12) (C.q G2 Qw2) ;
  } ;
  IdA : C.Ty G3 = Op[addO x].IdB ;
  IdM : C.Ty G3 = Op[mulO x].IdB ;
  phiQ (r : R.R) : C.El Nl Qt = AX.cls (cst r) ;
  -- the type  phi r = v  over nil.Q
  IdC (r : R.R) : C.Ty G1 = IJ.IdT G1 Qw (OV.wkE Nl Qt Qt (phiQ r)) q0 ;
 } ;

 ------------------------------------------------------------------
 -- maps of algebras from A_s to A_t at a stage J
 module Fn (s t : Pres) {
  module S = At[s] ;
  module T = At[t] ;
  Fam (J : Ob) : U a+ = (K : Ob) (f : Hom K J) -> S.QK K -> T.QK K ;
  Nat (J : Ob) (ph : Fam J) : U a+ =
   (K L : Ob) (f : Hom K J) (g : Hom L K) (a : S.QK K) -> Id (T.QK L) (T.rs K L g (ph K f a)) (ph L (compH L K J f g) (S.rs K L g a)) ;
  natP (J : Ob) (ph : Fam J) : isProp (Nat J ph) =
   isProp-Pi Ob (\ K -> (L : Ob) (f : Hom K J) (g : Hom L K) (a : S.QK K) -> Id (T.QK L) (T.rs K L g (ph K f a)) (ph L (compH L K J f g) (S.rs K L g a))) (\ K ->
   isProp-Pi Ob (\ L -> (f : Hom K J) (g : Hom L K) (a : S.QK K) -> Id (T.QK L) (T.rs K L g (ph K f a)) (ph L (compH L K J f g) (S.rs K L g a))) (\ L ->
   isProp-Pi (Hom K J) (\ f -> (g : Hom L K) (a : S.QK K) -> Id (T.QK L) (T.rs K L g (ph K f a)) (ph L (compH L K J f g) (S.rs K L g a))) (\ f ->
   isProp-Pi (Hom L K) (\ g -> (a : S.QK K) -> Id (T.QK L) (T.rs K L g (ph K f a)) (ph L (compH L K J f g) (S.rs K L g a))) (\ g ->
   isProp-Pi (S.QK K) (\ a -> Id (T.QK L) (T.rs K L g (ph K f a)) (ph L (compH L K J f g) (S.rs K L g a))) (\ a ->
   V1.isSetIx (T.QV L) (T.rs K L g (ph K f a)) (ph L (compH L K J f g) (S.rs K L g a))))))) ;
  -- the function part: the fibre of Fun Q_s Q_t at J, whose members are the pairs (ph, nt)
  PF (J : Ob) : V1.V = (OV.Fun Nl S.Qt T.Qt).1.tob J tt ;
  mkF (J : Ob) (ph : Fam J) (nt : Nat J ph) : V1.Ix (PF J) = (ph, nt) ;
  -- the pure restriction of a family along v : K -> J
  resF (J K : Ob) (v : Hom K J) (ph : Fam J) : Fam K = \ K' f' a -> ph K' (compH K' K J v f') a ;
  resN (J K : Ob) (v : Hom K J) (ph : Fam J) (nt : Nat J ph) : Nat K (resF J K v ph) = \ K' L' f' g' a ->
   transH (nt K' L' (compH K' K J v f') g' a) (apH {Hom L' J} {T.QK L'} (\ h -> ph L' h (S.rs K' L' g' a)) (comp-assoc L' K' K J v f' g')) ;
  -- the image of a point of Q_s^3 under ph
  mp3 (J : Ob) (ph : Fam J) (K : Ob) (f : Hom K J) (w : S.T3 K) : T.T3 K = (ph K f w.1, (ph K f w.2.1, ph K f w.2.2)) ;
  ap3 (K : Ob) (w w' : T.T3 K) (e1 : Id (T.QK K) w.1 w'.1) (e2 : Id (T.QK K) w.2.1 w'.2.1) (e3 : Id (T.QK K) w.2.2 w'.2.2) : Id (T.T3 K) w w' =
   transH (transH (apH {T.QK K} {T.T3 K} (\ z -> (z, (w.2.1, w.2.2))) e1) (apH {T.QK K} {T.T3 K} (\ z -> (w'.1, (z, w.2.2))) e2)) (apH {T.QK K} {T.T3 K} (\ z -> (w'.1, (w'.2.1, z))) e3) ;
  -- the point equation from the naturality of ph
  E3 (J : Ob) (ph : Fam J) (nt : Nat J ph) (K L : Ob) (f : Hom K J) (g : Hom L K) (w : S.T3 K)
   : Id (T.T3 L) (T.rs3 K L g (mp3 J ph K f w)) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) =
   ap3 L (T.rs3 K L g (mp3 J ph K f w)) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) (nt K L f g w.1) (nt K L f g w.2.1) (nt K L f g w.2.2) ;

  ----------------------------------------------------------------
  -- data for a binary operation, with Id types IS (over nil.Q_s^3) and IT
  module Bin (IS : C.Ty S.G3) (IT : C.Ty T.G3) {
   FS (K : Ob) (w : S.T3 K) : V1.V = IS.1.tob K (S.mk3 K w) ;
   FT (K : Ob) (w : T.T3 K) : V1.V = IT.1.tob K (T.mk3 K w) ;
   -- the actions: at the canonical point equation on the source, at a given one on the target
   acS (K L : Ob) (g : Hom L K) (w : S.T3 K) (p : V1.Ix (FS K w)) : V1.Ix (FS L (S.rs3 K L g w)) =
    IS.1.tact L K g (S.mk3 K w) (S.mk3 L (S.rs3 K L g w)) (refl (S.mk3 L (S.rs3 K L g w))) p ;
   EqT (K L : Ob) (g : Hom L K) (w : T.T3 K) (w' : T.T3 L) : U a+ = Id (T.P3 L) (T.G3.act L K g (T.mk3 K w)) (T.mk3 L w') ;
   acT (K L : Ob) (g : Hom L K) (w : T.T3 K) (w' : T.T3 L) (e : EqT K L g w w') (p : V1.Ix (FT K w)) : V1.Ix (FT L w') =
    IT.1.tact L K g (T.mk3 K w) (T.mk3 L w') e p ;
   -- two proofs of the point equation give the same action; the action along a composite
   acT-irr (K L : Ob) (g : Hom L K) (w : T.T3 K) (w' : T.T3 L) (e e' : EqT K L g w w') (p : V1.Ix (FT K w)) : Id (V1.Ix (FT L w')) (acT K L g w w' e p) (acT K L g w w' e' p) =
    LP.tact-irr T.G3 IT.1 L K g (T.mk3 K w) (T.mk3 L w') e e' p ;
   acT-tr (K L : Ob) (g : Hom L K) (w : T.T3 K) (w' w'' : T.T3 L) (e : EqT K L g w w') (q : Id (T.T3 L) w' w'') (p : V1.Ix (FT K w))
    : Id (V1.Ix (FT L w'')) (acT K L g w w'' (transH e (apH {T.T3 L} {T.P3 L} (T.mk3 L) q)) p) (subst (T.T3 L) (\ z -> V1.Ix (FT L z)) w' w'' q (acT K L g w w' e p)) =
    transH (tactTr T.G3 IT L K g (T.mk3 K w) (T.mk3 L w') (T.mk3 L w'') e (apH {T.T3 L} {T.P3 L} (T.mk3 L) q) p)
     (symH (subst-ap (T.T3 L) (T.P3 L) (T.mk3 L) (\ y -> V1.Ix (IT.1.tob L y)) w' w'' q (acT K L g w w' e p))) ;
   -- the data of a map ph and their naturality
   DT (J : Ob) (ph : Fam J) : U a+ = (K : Ob) (f : Hom K J) (w : S.T3 K) -> V1.Ix (FS K w) -> V1.Ix (FT K (mp3 J ph K f w)) ;
   DN (J : Ob) (ph : Fam J) (d : DT J ph) : U a+ =
    (K L : Ob) (f : Hom K J) (g : Hom L K) (w : S.T3 K) (e : EqT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (p : V1.Ix (FS K w))
    -> Id (V1.Ix (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p))
         (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p)) ;
   dnP (J : Ob) (ph : Fam J) (d : DT J ph) : isProp (DN J ph d) =
    isProp-Pi Ob (\ K -> (L : Ob) (f : Hom K J) (g : Hom L K) (w : S.T3 K) (e : EqT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (p : V1.Ix (FS K w))
      -> Id (V1.Ix (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p)) (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))) (\ K ->
    isProp-Pi Ob (\ L -> (f : Hom K J) (g : Hom L K) (w : S.T3 K) (e : EqT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (p : V1.Ix (FS K w))
      -> Id (V1.Ix (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p)) (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))) (\ L ->
    isProp-Pi (Hom K J) (\ f -> (g : Hom L K) (w : S.T3 K) (e : EqT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (p : V1.Ix (FS K w))
      -> Id (V1.Ix (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p)) (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))) (\ f ->
    isProp-Pi (Hom L K) (\ g -> (w : S.T3 K) (e : EqT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (p : V1.Ix (FS K w))
      -> Id (V1.Ix (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p)) (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))) (\ g ->
    isProp-Pi (S.T3 K) (\ w -> (e : EqT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (p : V1.Ix (FS K w))
      -> Id (V1.Ix (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p)) (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))) (\ w ->
    isProp-Pi (EqT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (\ e -> (p : V1.Ix (FS K w))
      -> Id (V1.Ix (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p)) (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))) (\ e ->
    isProp-Pi (V1.Ix (FS K w)) (\ p -> Id (V1.Ix (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p)) (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))) (\ p ->
    V1.isSetIx (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p)) (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))))))))) ;
   -- codes
   dV (J : Ob) (ph : Fam J) : V1.V =
    VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) (\ K -> VL.PiS (Hom K J) (VL.encIx (homV K J)) (VL.encIx-inj (homV K J)) (\ f ->
     V1.PiV (S.t3V K) (\ w -> V1.PiV (FS K w) (\ p -> FT K (mp3 J ph K f w))))) ;
   dnV (J : Ob) (ph : Fam J) (d : DT J ph) : V1.V =
    VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) (\ K -> VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) (\ L ->
     VL.PiS (Hom K J) (VL.encIx (homV K J)) (VL.encIx-inj (homV K J)) (\ f -> VL.PiS (Hom L K) (VL.encIx (homV L K)) (VL.encIx-inj (homV L K)) (\ g ->
      V1.PiV (S.t3V K) (\ w -> V1.PiV (V1.IdV (T.G3.ob L) (T.G3.act L K g (T.mk3 K (mp3 J ph K f w))) (T.mk3 L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)))) (\ e ->
       V1.PiV (FS K w) (\ p -> V1.IdV (FT L (mp3 J ph L (compH L K J f g) (S.rs3 K L g w))) (acT K L g (mp3 J ph K f w) (mp3 J ph L (compH L K J f g) (S.rs3 K L g w)) e (d K f w p))
                                      (d L (compH L K J f g) (S.rs3 K L g w) (acS K L g w p))))))))) ;
   DV (J : Ob) (ph : Fam J) : V1.V = V1.SigV (dV J ph) (\ d -> dnV J ph d) ;
   D (J : Ob) (ph : Fam J) : U a+ = (d : DT J ph) * DN J ph d ;
   mkD (J : Ob) (ph : Fam J) (d : DT J ph) (dn : DN J ph d) : V1.Ix (DV J ph) = (d, dn) ;
   -- restriction along v : K -> J
   resD (J K : Ob) (v : Hom K J) (ph : Fam J) (d : DT J ph) : DT K (resF J K v ph) = \ K' f' w p -> d K' (compH K' K J v f') w p ;
   module ResN (J K : Ob) (v : Hom K J) (ph : Fam J) (d : DT J ph) (dn : DN J ph d) (K' L' : Ob) (f' : Hom K' K) (g' : Hom L' K') (w : S.T3 K')
    (e : EqT K' L' g' (mp3 J ph K' (compH K' K J v f') w) (mp3 J ph L' (compH L' K J v (compH L' K' K f' g')) (S.rs3 K' L' g' w))) (p : V1.Ix (FS K' w)) {
    h1 : Hom L' J = compH L' K' J (compH K' K J v f') g' ;
    h2 : Hom L' J = compH L' K J v (compH L' K' K f' g') ;
    as : Id (Hom L' J) h1 h2 = comp-assoc L' K' K J v f' g' ;
    w0 : T.T3 K' = mp3 J ph K' (compH K' K J v f') w ;
    w1 : T.T3 L' = mp3 J ph L' h1 (S.rs3 K' L' g' w) ;
    w2 : T.T3 L' = mp3 J ph L' h2 (S.rs3 K' L' g' w) ;
    q : Id (T.T3 L') w1 w2 = apH {Hom L' J} {T.T3 L'} (\ h -> mp3 J ph L' h (S.rs3 K' L' g' w)) as ;
    e1 : EqT K' L' g' w0 w1 = transH e (symH (apH {T.T3 L'} {T.P3 L'} (T.mk3 L') q)) ;
    X : V1.Ix (FT K' w0) = d K' (compH K' K J v f') w p ;
    Y (h : Hom L' J) : V1.Ix (FT L' (mp3 J ph L' h (S.rs3 K' L' g' w))) = d L' h (S.rs3 K' L' g' w) (acS K' L' g' w p) ;
    s1 : Id (V1.Ix (FT L' w2)) (acT K' L' g' w0 w2 e X) (acT K' L' g' w0 w2 (transH e1 (apH {T.T3 L'} {T.P3 L'} (T.mk3 L') q)) X) =
     acT-irr K' L' g' w0 w2 e (transH e1 (apH {T.T3 L'} {T.P3 L'} (T.mk3 L') q)) X ;
    s2 : Id (V1.Ix (FT L' w2)) (acT K' L' g' w0 w2 (transH e1 (apH {T.T3 L'} {T.P3 L'} (T.mk3 L') q)) X) (subst (T.T3 L') (\ z -> V1.Ix (FT L' z)) w1 w2 q (acT K' L' g' w0 w1 e1 X)) =
     acT-tr K' L' g' w0 w1 w2 e1 q X ;
    s3 : Id (V1.Ix (FT L' w2)) (subst (T.T3 L') (\ z -> V1.Ix (FT L' z)) w1 w2 q (acT K' L' g' w0 w1 e1 X)) (subst (T.T3 L') (\ z -> V1.Ix (FT L' z)) w1 w2 q (Y h1)) =
     apH {V1.Ix (FT L' w1)} {V1.Ix (FT L' w2)} (\ z -> subst (T.T3 L') (\ z2 -> V1.Ix (FT L' z2)) w1 w2 q z) (dn K' L' (compH K' K J v f') g' w e1 p) ;
    s4 : Id (V1.Ix (FT L' w2)) (subst (T.T3 L') (\ z -> V1.Ix (FT L' z)) w1 w2 q (Y h1)) (Y h2) =
     transH (symH (subst-ap (Hom L' J) (T.T3 L') (\ h -> mp3 J ph L' h (S.rs3 K' L' g' w)) (\ z -> V1.Ix (FT L' z)) h1 h2 as (Y h1)))
      (apdS (Hom L' J) (\ h -> V1.Ix (FT L' (mp3 J ph L' h (S.rs3 K' L' g' w)))) Y h1 h2 as) ;
    res : Id (V1.Ix (FT L' w2)) (acT K' L' g' w0 w2 e X) (Y h2) = transH s1 (transH s2 (transH s3 s4)) ;
   } ;
   resDN (J K : Ob) (v : Hom K J) (ph : Fam J) (d : DT J ph) (dn : DN J ph d) : DN K (resF J K v ph) (resD J K v ph d) =
    \ K' L' f' g' w e p -> ResN[J, K, v, ph, d, dn, K', L', f', g', w, e, p].res ;
  } ;

  ----------------------------------------------------------------
  -- data for a constant, with Id types IS (over nil.Q_s) and IT
  module Nul (IS : C.Ty S.G1) (IT : C.Ty T.G1) {
   FS (K : Ob) (u : S.QK K) : V1.V = IS.1.tob K (S.mk1 K u) ;
   FT (K : Ob) (u : T.QK K) : V1.V = IT.1.tob K (T.mk1 K u) ;
   acS (K L : Ob) (g : Hom L K) (u : S.QK K) (p : V1.Ix (FS K u)) : V1.Ix (FS L (S.rs K L g u)) =
    IS.1.tact L K g (S.mk1 K u) (S.mk1 L (S.rs K L g u)) (refl (S.mk1 L (S.rs K L g u))) p ;
   EqT (K L : Ob) (g : Hom L K) (u : T.QK K) (u' : T.QK L) : U a+ = Id (T.P1 L) (T.G1.act L K g (T.mk1 K u)) (T.mk1 L u') ;
   acT (K L : Ob) (g : Hom L K) (u : T.QK K) (u' : T.QK L) (e : EqT K L g u u') (p : V1.Ix (FT K u)) : V1.Ix (FT L u') =
    IT.1.tact L K g (T.mk1 K u) (T.mk1 L u') e p ;
   acT-irr (K L : Ob) (g : Hom L K) (u : T.QK K) (u' : T.QK L) (e e' : EqT K L g u u') (p : V1.Ix (FT K u)) : Id (V1.Ix (FT L u')) (acT K L g u u' e p) (acT K L g u u' e' p) =
    LP.tact-irr T.G1 IT.1 L K g (T.mk1 K u) (T.mk1 L u') e e' p ;
   acT-tr (K L : Ob) (g : Hom L K) (u : T.QK K) (u' u'' : T.QK L) (e : EqT K L g u u') (q : Id (T.QK L) u' u'') (p : V1.Ix (FT K u))
    : Id (V1.Ix (FT L u'')) (acT K L g u u'' (transH e (apH {T.QK L} {T.P1 L} (T.mk1 L) q)) p) (subst (T.QK L) (\ z -> V1.Ix (FT L z)) u' u'' q (acT K L g u u' e p)) =
    transH (tactTr T.G1 IT L K g (T.mk1 K u) (T.mk1 L u') (T.mk1 L u'') e (apH {T.QK L} {T.P1 L} (T.mk1 L) q) p)
     (symH (subst-ap (T.QK L) (T.P1 L) (T.mk1 L) (\ y -> V1.Ix (IT.1.tob L y)) u' u'' q (acT K L g u u' e p))) ;
   DT (J : Ob) (ph : Fam J) : U a+ = (K : Ob) (f : Hom K J) (u : S.QK K) -> V1.Ix (FS K u) -> V1.Ix (FT K (ph K f u)) ;
   DN (J : Ob) (ph : Fam J) (d : DT J ph) : U a+ =
    (K L : Ob) (f : Hom K J) (g : Hom L K) (u : S.QK K) (e : EqT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u))) (p : V1.Ix (FS K u))
    -> Id (V1.Ix (FT L (ph L (compH L K J f g) (S.rs K L g u)))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p)) ;
   dnP (J : Ob) (ph : Fam J) (d : DT J ph) : isProp (DN J ph d) =
    isProp-Pi Ob (\ K -> (L : Ob) (f : Hom K J) (g : Hom L K) (u : S.QK K) (e : EqT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u))) (p : V1.Ix (FS K u))
      -> Id (V1.Ix (FT L (ph L (compH L K J f g) (S.rs K L g u)))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))) (\ K ->
    isProp-Pi Ob (\ L -> (f : Hom K J) (g : Hom L K) (u : S.QK K) (e : EqT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u))) (p : V1.Ix (FS K u))
      -> Id (V1.Ix (FT L (ph L (compH L K J f g) (S.rs K L g u)))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))) (\ L ->
    isProp-Pi (Hom K J) (\ f -> (g : Hom L K) (u : S.QK K) (e : EqT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u))) (p : V1.Ix (FS K u))
      -> Id (V1.Ix (FT L (ph L (compH L K J f g) (S.rs K L g u)))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))) (\ f ->
    isProp-Pi (Hom L K) (\ g -> (u : S.QK K) (e : EqT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u))) (p : V1.Ix (FS K u))
      -> Id (V1.Ix (FT L (ph L (compH L K J f g) (S.rs K L g u)))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))) (\ g ->
    isProp-Pi (S.QK K) (\ u -> (e : EqT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u))) (p : V1.Ix (FS K u))
      -> Id (V1.Ix (FT L (ph L (compH L K J f g) (S.rs K L g u)))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))) (\ u ->
    isProp-Pi (EqT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u))) (\ e -> (p : V1.Ix (FS K u))
      -> Id (V1.Ix (FT L (ph L (compH L K J f g) (S.rs K L g u)))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))) (\ e ->
    isProp-Pi (V1.Ix (FS K u)) (\ p -> Id (V1.Ix (FT L (ph L (compH L K J f g) (S.rs K L g u)))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))) (\ p ->
    V1.isSetIx (FT L (ph L (compH L K J f g) (S.rs K L g u))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p)) (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))))))))) ;
   dV (J : Ob) (ph : Fam J) : V1.V =
    VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) (\ K -> VL.PiS (Hom K J) (VL.encIx (homV K J)) (VL.encIx-inj (homV K J)) (\ f ->
     V1.PiV (S.QV K) (\ u -> V1.PiV (FS K u) (\ p -> FT K (ph K f u))))) ;
   dnV (J : Ob) (ph : Fam J) (d : DT J ph) : V1.V =
    VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) (\ K -> VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) (\ L ->
     VL.PiS (Hom K J) (VL.encIx (homV K J)) (VL.encIx-inj (homV K J)) (\ f -> VL.PiS (Hom L K) (VL.encIx (homV L K)) (VL.encIx-inj (homV L K)) (\ g ->
      V1.PiV (S.QV K) (\ u -> V1.PiV (V1.IdV (T.G1.ob L) (T.G1.act L K g (T.mk1 K (ph K f u))) (T.mk1 L (ph L (compH L K J f g) (S.rs K L g u)))) (\ e ->
       V1.PiV (FS K u) (\ p -> V1.IdV (FT L (ph L (compH L K J f g) (S.rs K L g u))) (acT K L g (ph K f u) (ph L (compH L K J f g) (S.rs K L g u)) e (d K f u p))
                                      (d L (compH L K J f g) (S.rs K L g u) (acS K L g u p))))))))) ;
   DV (J : Ob) (ph : Fam J) : V1.V = V1.SigV (dV J ph) (\ d -> dnV J ph d) ;
   D (J : Ob) (ph : Fam J) : U a+ = (d : DT J ph) * DN J ph d ;
   resD (J K : Ob) (v : Hom K J) (ph : Fam J) (d : DT J ph) : DT K (resF J K v ph) = \ K' f' u p -> d K' (compH K' K J v f') u p ;
   module ResN (J K : Ob) (v : Hom K J) (ph : Fam J) (d : DT J ph) (dn : DN J ph d) (K' L' : Ob) (f' : Hom K' K) (g' : Hom L' K') (u : S.QK K')
    (e : EqT K' L' g' (ph K' (compH K' K J v f') u) (ph L' (compH L' K J v (compH L' K' K f' g')) (S.rs K' L' g' u))) (p : V1.Ix (FS K' u)) {
    h1 : Hom L' J = compH L' K' J (compH K' K J v f') g' ;
    h2 : Hom L' J = compH L' K J v (compH L' K' K f' g') ;
    as : Id (Hom L' J) h1 h2 = comp-assoc L' K' K J v f' g' ;
    u0 : T.QK K' = ph K' (compH K' K J v f') u ;
    u1 : T.QK L' = ph L' h1 (S.rs K' L' g' u) ;
    u2 : T.QK L' = ph L' h2 (S.rs K' L' g' u) ;
    q : Id (T.QK L') u1 u2 = apH {Hom L' J} {T.QK L'} (\ h -> ph L' h (S.rs K' L' g' u)) as ;
    e1 : EqT K' L' g' u0 u1 = transH e (symH (apH {T.QK L'} {T.P1 L'} (T.mk1 L') q)) ;
    X : V1.Ix (FT K' u0) = d K' (compH K' K J v f') u p ;
    Y (h : Hom L' J) : V1.Ix (FT L' (ph L' h (S.rs K' L' g' u))) = d L' h (S.rs K' L' g' u) (acS K' L' g' u p) ;
    s1 : Id (V1.Ix (FT L' u2)) (acT K' L' g' u0 u2 e X) (acT K' L' g' u0 u2 (transH e1 (apH {T.QK L'} {T.P1 L'} (T.mk1 L') q)) X) =
     acT-irr K' L' g' u0 u2 e (transH e1 (apH {T.QK L'} {T.P1 L'} (T.mk1 L') q)) X ;
    s2 : Id (V1.Ix (FT L' u2)) (acT K' L' g' u0 u2 (transH e1 (apH {T.QK L'} {T.P1 L'} (T.mk1 L') q)) X) (subst (T.QK L') (\ z -> V1.Ix (FT L' z)) u1 u2 q (acT K' L' g' u0 u1 e1 X)) =
     acT-tr K' L' g' u0 u1 u2 e1 q X ;
    s3 : Id (V1.Ix (FT L' u2)) (subst (T.QK L') (\ z -> V1.Ix (FT L' z)) u1 u2 q (acT K' L' g' u0 u1 e1 X)) (subst (T.QK L') (\ z -> V1.Ix (FT L' z)) u1 u2 q (Y h1)) =
     apH {V1.Ix (FT L' u1)} {V1.Ix (FT L' u2)} (\ z -> subst (T.QK L') (\ z2 -> V1.Ix (FT L' z2)) u1 u2 q z) (dn K' L' (compH K' K J v f') g' u e1 p) ;
    s4 : Id (V1.Ix (FT L' u2)) (subst (T.QK L') (\ z -> V1.Ix (FT L' z)) u1 u2 q (Y h1)) (Y h2) =
     transH (symH (subst-ap (Hom L' J) (T.QK L') (\ h -> ph L' h (S.rs K' L' g' u)) (\ z -> V1.Ix (FT L' z)) h1 h2 as (Y h1)))
      (apdS (Hom L' J) (\ h -> V1.Ix (FT L' (ph L' h (S.rs K' L' g' u)))) Y h1 h2 as) ;
    res : Id (V1.Ix (FT L' u2)) (acT K' L' g' u0 u2 e X) (Y h2) = transH s1 (transH s2 (transH s3 s4)) ;
   } ;
   resDN (J K : Ob) (v : Hom K J) (ph : Fam J) (d : DT J ph) (dn : DN J ph d) : DN K (resF J K v ph) (resD J K v ph d) =
    \ K' L' f' g' u e p -> ResN[J, K, v, ph, d, dn, K', L', f', g', u, e, p].res ;
  } ;

  ----------------------------------------------------------------
  -- the hom code at J: function part, data for add, mul and the constants
  module BA = Bin[S.IdA, T.IdA] ;
  module BM = Bin[S.IdM, T.IdM] ;
  module NC (r : R.R) { module N = Nul[S.IdC r, T.IdC r] ; } ;
  Rest (J : Ob) (ph : Fam J) : U a+ = BA.D J ph * BM.D J ph * ((r : R.R) -> NC[r].N.D J ph) ;
  restV (J : Ob) (ph : Fam J) : V1.V =
   V1.SigV (BA.DV J ph) (\ da -> V1.SigV (BM.DV J ph) (\ dm -> VL.PiS (W0.Ix RV) (VL.encIx RV) (VL.encIx-inj RV) (\ r -> NC[r].N.DV J ph))) ;
  MorV (J : Ob) : V1.V = V1.SigV (PF J) (\ e -> restV J e.1) ;
  M (J : Ob) : U a+ = V1.Ix (MorV J) ;
  mkM (J : Ob) (ph : Fam J) (nt : Nat J ph) (rt : Rest J ph) : M J = ((ph, nt), rt) ;
  -- accessors
  ph (J : Ob) (m : M J) : Fam J = m.1.1 ;
  nt (J : Ob) (m : M J) : Nat J (ph J m) = m.1.2 ;
  da (J : Ob) (m : M J) : BA.DT J (ph J m) = m.2.1.1 ;
  dm (J : Ob) (m : M J) : BM.DT J (ph J m) = m.2.2.1.1 ;
  dc (J : Ob) (m : M J) (r : R.R) : NC[r].N.DT J (ph J m) = (m.2.2.2 r).1 ;
  -- restriction along v : K -> J (the hom presheaf)
  res (J K : Ob) (v : Hom K J) (m : M J) : M K =
   mkM K (resF J K v (ph J m)) (resN J K v (ph J m) (nt J m))
    ((BA.resD J K v (ph J m) (da J m), BA.resDN J K v (ph J m) (da J m) m.2.1.2),
     ((BM.resD J K v (ph J m) (dm J m), BM.resDN J K v (ph J m) (dm J m) m.2.2.1.2),
      \ r -> (NC[r].N.resD J K v (ph J m) (dc J m r), NC[r].N.resDN J K v (ph J m) (dc J m r) (m.2.2.2 r).2))) ;

  ----------------------------------------------------------------
  -- extensionality: a map is determined by its families (function part
  -- and data); the naturality components form a proposition
  FP (J : Ob) : U a+ = (p : Fam J) * BA.DT J p * BM.DT J p * ((c : R.R) -> NC[c].N.DT J p) ;
  PR (J : Ob) (a0 : FP J) : U a+ = Nat J a0.1 * BA.DN J a0.1 a0.2.1 * BM.DN J a0.1 a0.2.2.1 * ((c : R.R) -> NC[c].N.DN J a0.1 (a0.2.2.2 c)) ;
  prP (J : Ob) (a0 : FP J) : isProp (PR J a0) =
   isProp-Sigma (Nat J a0.1) (\ z -> BA.DN J a0.1 a0.2.1 * BM.DN J a0.1 a0.2.2.1 * ((c : R.R) -> NC[c].N.DN J a0.1 (a0.2.2.2 c))) (natP J a0.1) (\ z ->
   isProp-Sigma (BA.DN J a0.1 a0.2.1) (\ z2 -> BM.DN J a0.1 a0.2.2.1 * ((c : R.R) -> NC[c].N.DN J a0.1 (a0.2.2.2 c))) (BA.dnP J a0.1 a0.2.1) (\ z2 ->
   isProp-Sigma (BM.DN J a0.1 a0.2.2.1) (\ z3 -> (c : R.R) -> NC[c].N.DN J a0.1 (a0.2.2.2 c)) (BM.dnP J a0.1 a0.2.2.1) (\ z3 ->
   isProp-Pi R.R (\ c -> NC[c].N.DN J a0.1 (a0.2.2.2 c)) (\ c -> NC[c].N.dnP J a0.1 (a0.2.2.2 c))))) ;
  pack (J : Ob) (a0 : FP J) (pr : PR J a0) : M J =
   ((a0.1, pr.1), ((a0.2.1, pr.2.1), ((a0.2.2.1, pr.2.2.1), \ c -> (a0.2.2.2 c, pr.2.2.2 c)))) ;
  fpOf (J : Ob) (m : M J) : FP J = (m.1.1, (m.2.1.1, (m.2.2.1.1, \ c -> (m.2.2.2 c).1))) ;
  prOf (J : Ob) (m : M J) : PR J (fpOf J m) = (m.1.2, (m.2.1.2, (m.2.2.1.2, \ c -> (m.2.2.2 c).2))) ;
  mExt (J : Ob) (m m' : M J) (e : Id (FP J) (fpOf J m) (fpOf J m')) : Id (M J) m m' =
   idJ (FP J) (fpOf J m) (\ a2 e2 -> (pr2 : PR J a2) -> Id (M J) m (pack J a2 pr2))
    (\ pr2 -> apH {PR J (fpOf J m)} {M J} (pack J (fpOf J m)) (prP J (fpOf J m) (prOf J m) pr2)) (fpOf J m') e (prOf J m') ;
  -- reindexing the families along a map of slices (restriction is the case k |-> v . k)
  rx (J K : Ob) (sg : (K' : Ob) -> Hom K' K -> Hom K' J) (a0 : FP J) : FP K =
   (\ K' k u -> a0.1 K' (sg K' k) u,
    (\ K' k w p -> a0.2.1 K' (sg K' k) w p,
     (\ K' k w p -> a0.2.2.1 K' (sg K' k) w p,
      \ c K' k u p -> a0.2.2.2 c K' (sg K' k) u p))) ;
  rxEq (J K : Ob) (sg sg' : (K' : Ob) -> Hom K' K -> Hom K' J) (h : (K' : Ob) (k : Hom K' K) -> Id (Hom K' J) (sg K' k) (sg' K' k)) (a0 : FP J)
   : Id (FP K) (rx J K sg a0) (rx J K sg' a0) =
   apH {(K' : Ob) -> Hom K' K -> Hom K' J} {FP K} (\ s2 -> rx J K s2 a0)
    (funext Ob (\ K' -> Hom K' K -> Hom K' J) sg sg' (\ K' -> funext (Hom K' K) (\ k -> Hom K' J) (sg K') (sg' K') (\ k -> h K' k))) ;
 } ;

 -- composition of the families (the families of Cmp's composite, on the nose)
 module CmpF (s t r : Pres) {
  module F = Fn[s, t] ;
  module G = Fn[t, r] ;
  module H = Fn[s, r] ;
  -- the data compose, over abstract Id types (cheap to check)
  module DB (J : Ob) (phF : F.Fam J) (phG : G.Fam J) (IS : C.Ty F.S.G3) (IT : C.Ty F.T.G3) (IR : C.Ty G.T.G3) {
   cd (dF : F.Bin[IS, IT].DT J phF) (dG : G.Bin[IT, IR].DT J phG) : H.Bin[IS, IR].DT J (\ K k u -> phG K k (phF K k u)) =
    \ K k w p -> dG K k (F.mp3 J phF K k w) (dF K k w p) ;
  } ;
  module DN (J : Ob) (phF : F.Fam J) (phG : G.Fam J) (IS : C.Ty F.S.G1) (IT : C.Ty F.T.G1) (IR : C.Ty G.T.G1) {
   cd (dF : F.Nul[IS, IT].DT J phF) (dG : G.Nul[IT, IR].DT J phG) : H.Nul[IS, IR].DT J (\ K k u -> phG K k (phF K k u)) =
    \ K k u p -> dG K k (phF K k u) (dF K k u p) ;
  } ;
  cmpFP (J : Ob) (a0 : F.FP J) (b0 : G.FP J) : H.FP J =
   (\ K k u -> b0.1 K k (a0.1 K k u),
    (DB[J, a0.1, b0.1, F.S.IdA, F.T.IdA, G.T.IdA].cd a0.2.1 b0.2.1,
     (DB[J, a0.1, b0.1, F.S.IdM, F.T.IdM, G.T.IdM].cd a0.2.2.1 b0.2.2.1,
      \ c -> DN[J, a0.1, b0.1, F.S.IdC c, F.T.IdC c, G.T.IdC c].cd (a0.2.2.2 c) (b0.2.2.2 c)))) ;
 } ;

 ------------------------------------------------------------------
 -- the identity of A_x at every stage
 module Idn (x : Pres) {
  module F = Fn[x, x] ;
  idF (J : Ob) : F.Fam J = \ K f u -> u ;
  idN (J : Ob) : F.Nat J (idF J) = \ K L f g u -> refl (F.S.rs K L g u) ;
  idA (J : Ob) : F.BA.DT J (idF J) = \ K f w p -> p ;
  idAN (J : Ob) : F.BA.DN J (idF J) (idA J) = \ K L f g w e p -> F.BA.acT-irr K L g w (F.S.rs3 K L g w) e (refl (F.S.mk3 L (F.S.rs3 K L g w))) p ;
  idM (J : Ob) : F.BM.DT J (idF J) = \ K f w p -> p ;
  idMN (J : Ob) : F.BM.DN J (idF J) (idM J) = \ K L f g w e p -> F.BM.acT-irr K L g w (F.S.rs3 K L g w) e (refl (F.S.mk3 L (F.S.rs3 K L g w))) p ;
  idC (J : Ob) (r : R.R) : F.NC[r].N.DT J (idF J) = \ K f u p -> p ;
  idCN (J : Ob) (r : R.R) : F.NC[r].N.DN J (idF J) (idC J r) = \ K L f g u e p -> F.NC[r].N.acT-irr K L g u (F.S.rs K L g u) e (refl (F.S.mk1 L (F.S.rs K L g u))) p ;
  idM' (J : Ob) : F.M J = F.mkM J (idF J) (idN J) ((idA J, idAN J), ((idM J, idMN J), \ r -> (idC J r, idCN J r))) ;
 } ;

 ------------------------------------------------------------------
 -- composition at a stage: f : A_s -> A_t then g : A_t -> A_r
 module Cmp (s t r : Pres) (J : Ob) (f : Fn[s, t].M J) (g : Fn[t, r].M J) {
  module F = Fn[s, t] ;
  module G = Fn[t, r] ;
  module H = Fn[s, r] ;
  phF : F.Fam J = F.ph J f ;
  phG : G.Fam J = G.ph J g ;
  ntF : F.Nat J phF = F.nt J f ;
  ntG : G.Nat J phG = G.nt J g ;
  cph : H.Fam J = \ K k a -> phG K k (phF K k a) ;
  cnt : H.Nat J cph = \ K L k h a -> transH (ntG K L k h (phF K k a)) (apH {F.T.QK L} {G.T.QK L} (phG L (compH L K J k h)) (ntF K L k h a)) ;
  -- the data compose, on the nose; their naturality
  module CB (IS : C.Ty F.S.G3) (IT : C.Ty F.T.G3) (IR : C.Ty G.T.G3) (dF : F.Bin[IS, IT].DT J phF) (dnF : F.Bin[IS, IT].DN J phF dF) (dG : G.Bin[IT, IR].DT J phG) (dnG : G.Bin[IT, IR].DN J phG dG) {
   module BF = F.Bin[IS, IT] ;
   module BG = G.Bin[IT, IR] ;
   module BH = H.Bin[IS, IR] ;
   cd : BH.DT J cph = \ K k w p -> dG K k (F.mp3 J phF K k w) (dF K k w p) ;
   module N (K L : Ob) (k : Hom K J) (h : Hom L K) (w : F.S.T3 K) (e : BH.EqT K L h (H.mp3 J cph K k w) (H.mp3 J cph L (compH L K J k h) (F.S.rs3 K L h w))) (p : V1.Ix (BF.FS K w)) {
    kh : Hom L J = compH L K J k h ;
    wF : F.T.T3 K = F.mp3 J phF K k w ;
    wF' : F.T.T3 L = F.mp3 J phF L kh (F.S.rs3 K L h w) ;
    rwF : F.T.T3 L = F.T.rs3 K L h wF ;
    EF : Id (F.T.T3 L) rwF wF' = F.E3 J phF ntF K L k h w ;
    eF : BF.EqT K L h wF wF' = apH {F.T.T3 L} {F.T.P3 L} (F.T.mk3 L) EF ;
    EG : Id (G.T.T3 L) (G.T.rs3 K L h (G.mp3 J phG K k wF)) (G.mp3 J phG L kh rwF) = G.E3 J phG ntG K L k h wF ;
    eG : BG.EqT K L h (G.mp3 J phG K k wF) (G.mp3 J phG L kh rwF) = apH {G.T.T3 L} {G.T.P3 L} (G.T.mk3 L) EG ;
    q : Id (G.T.T3 L) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') = apH {F.T.T3 L} {G.T.T3 L} (G.mp3 J phG L kh) EF ;
    X : V1.Ix (BG.FT K (G.mp3 J phG K k wF)) = dG K k wF (dF K k w p) ;
    q' : V1.Ix (BF.FT L wF') = dF L kh (F.S.rs3 K L h w) (BF.acS K L h w p) ;
    -- the source datum moved along the canonical equation, then along eF
    t1 : Id (V1.Ix (BF.FT L wF')) (subst (F.T.T3 L) (\ z -> V1.Ix (BF.FT L z)) rwF wF' EF (BF.acT K L h wF rwF (refl (F.T.mk3 L rwF)) (dF K k w p))) q' =
     transH (symH (BF.acT-tr K L h wF rwF wF' (refl (F.T.mk3 L rwF)) EF (dF K k w p)))
      (transH (BF.acT-irr K L h wF wF' (transH (refl (F.T.mk3 L rwF)) eF) eF (dF K k w p)) (dnF K L k h w eF p)) ;
    t2 : Id (V1.Ix (BF.FT L rwF)) (BF.acT K L h wF rwF (refl (F.T.mk3 L rwF)) (dF K k w p)) (subst (F.T.T3 L) (\ z -> V1.Ix (BF.FT L z)) wF' rwF (symH EF) q') =
     substSym (F.T.T3 L) (\ z -> V1.Ix (BF.FT L z)) rwF wF' EF (BF.acT K L h wF rwF (refl (F.T.mk3 L rwF)) (dF K k w p)) q' t1 ;
    s1 : Id (V1.Ix (BH.FT L (H.mp3 J cph L kh (F.S.rs3 K L h w)))) (BH.acT K L h (H.mp3 J cph K k w) (H.mp3 J cph L kh (F.S.rs3 K L h w)) e X)
                                                                     (BG.acT K L h (G.mp3 J phG K k wF) (G.mp3 J phG L kh wF') (transH eG (apH {G.T.T3 L} {G.T.P3 L} (G.T.mk3 L) q)) X) =
     BH.acT-irr K L h (H.mp3 J cph K k w) (H.mp3 J cph L kh (F.S.rs3 K L h w)) e (transH eG (apH {G.T.T3 L} {G.T.P3 L} (G.T.mk3 L) q)) X ;
    s2 : Id (V1.Ix (BG.FT L (G.mp3 J phG L kh wF'))) (BG.acT K L h (G.mp3 J phG K k wF) (G.mp3 J phG L kh wF') (transH eG (apH {G.T.T3 L} {G.T.P3 L} (G.T.mk3 L) q)) X)
                                                        (subst (G.T.T3 L) (\ z -> V1.Ix (BG.FT L z)) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') q (BG.acT K L h (G.mp3 J phG K k wF) (G.mp3 J phG L kh rwF) eG X)) =
     BG.acT-tr K L h (G.mp3 J phG K k wF) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') eG q X ;
    s3 : Id (V1.Ix (BG.FT L (G.mp3 J phG L kh wF'))) (subst (G.T.T3 L) (\ z -> V1.Ix (BG.FT L z)) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') q (BG.acT K L h (G.mp3 J phG K k wF) (G.mp3 J phG L kh rwF) eG X))
                                                        (subst (G.T.T3 L) (\ z -> V1.Ix (BG.FT L z)) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') q (dG L kh rwF (BG.acS K L h wF (dF K k w p)))) =
     apH {V1.Ix (BG.FT L (G.mp3 J phG L kh rwF))} {V1.Ix (BG.FT L (G.mp3 J phG L kh wF'))} (\ z -> subst (G.T.T3 L) (\ z2 -> V1.Ix (BG.FT L z2)) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') q z)
      (dnG K L k h wF eG (dF K k w p)) ;
    s4 : Id (V1.Ix (BG.FT L (G.mp3 J phG L kh wF'))) (subst (G.T.T3 L) (\ z -> V1.Ix (BG.FT L z)) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') q (dG L kh rwF (BG.acS K L h wF (dF K k w p))))
                                                        (subst (G.T.T3 L) (\ z -> V1.Ix (BG.FT L z)) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') q (dG L kh rwF (subst (F.T.T3 L) (\ z -> V1.Ix (BF.FT L z)) wF' rwF (symH EF) q'))) =
     apH {V1.Ix (BF.FT L rwF)} {V1.Ix (BG.FT L (G.mp3 J phG L kh wF'))} (\ z -> subst (G.T.T3 L) (\ z2 -> V1.Ix (BG.FT L z2)) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') q (dG L kh rwF z)) t2 ;
    s5 : Id (V1.Ix (BG.FT L (G.mp3 J phG L kh wF'))) (subst (G.T.T3 L) (\ z -> V1.Ix (BG.FT L z)) (G.mp3 J phG L kh rwF) (G.mp3 J phG L kh wF') q (dG L kh rwF (subst (F.T.T3 L) (\ z -> V1.Ix (BF.FT L z)) wF' rwF (symH EF) q')))
                                                        (dG L kh wF' q') =
     depMap (F.T.T3 L) (G.T.T3 L) (\ z -> V1.Ix (BF.FT L z)) (\ z -> V1.Ix (BG.FT L z)) (G.mp3 J phG L kh) (dG L kh) rwF wF' EF q' ;
    res : Id (V1.Ix (BH.FT L (H.mp3 J cph L kh (F.S.rs3 K L h w)))) (BH.acT K L h (H.mp3 J cph K k w) (H.mp3 J cph L kh (F.S.rs3 K L h w)) e (cd K k w p)) (cd L kh (F.S.rs3 K L h w) (BF.acS K L h w p)) =
     transH s1 (transH s2 (transH s3 (transH s4 s5))) ;
   } ;
   cdn : BH.DN J cph cd = \ K L k h w e p -> N[K, L, k, h, w, e, p].res ;
  } ;
  module CN (IS : C.Ty F.S.G1) (IT : C.Ty F.T.G1) (IR : C.Ty G.T.G1) (dF : F.Nul[IS, IT].DT J phF) (dnF : F.Nul[IS, IT].DN J phF dF) (dG : G.Nul[IT, IR].DT J phG) (dnG : G.Nul[IT, IR].DN J phG dG) {
   module BF = F.Nul[IS, IT] ;
   module BG = G.Nul[IT, IR] ;
   module BH = H.Nul[IS, IR] ;
   cd : BH.DT J cph = \ K k u p -> dG K k (phF K k u) (dF K k u p) ;
   module N (K L : Ob) (k : Hom K J) (h : Hom L K) (u : F.S.QK K) (e : BH.EqT K L h (cph K k u) (cph L (compH L K J k h) (F.S.rs K L h u))) (p : V1.Ix (BF.FS K u)) {
    kh : Hom L J = compH L K J k h ;
    uF : F.T.QK K = phF K k u ;
    uF' : F.T.QK L = phF L kh (F.S.rs K L h u) ;
    ruF : F.T.QK L = F.T.rs K L h uF ;
    EF : Id (F.T.QK L) ruF uF' = ntF K L k h u ;
    eF : BF.EqT K L h uF uF' = apH {F.T.QK L} {F.T.P1 L} (F.T.mk1 L) EF ;
    EG : Id (G.T.QK L) (G.T.rs K L h (phG K k uF)) (phG L kh ruF) = ntG K L k h uF ;
    eG : BG.EqT K L h (phG K k uF) (phG L kh ruF) = apH {G.T.QK L} {G.T.P1 L} (G.T.mk1 L) EG ;
    q : Id (G.T.QK L) (phG L kh ruF) (phG L kh uF') = apH {F.T.QK L} {G.T.QK L} (phG L kh) EF ;
    X : V1.Ix (BG.FT K (phG K k uF)) = dG K k uF (dF K k u p) ;
    q' : V1.Ix (BF.FT L uF') = dF L kh (F.S.rs K L h u) (BF.acS K L h u p) ;
    t1 : Id (V1.Ix (BF.FT L uF')) (subst (F.T.QK L) (\ z -> V1.Ix (BF.FT L z)) ruF uF' EF (BF.acT K L h uF ruF (refl (F.T.mk1 L ruF)) (dF K k u p))) q' =
     transH (symH (BF.acT-tr K L h uF ruF uF' (refl (F.T.mk1 L ruF)) EF (dF K k u p)))
      (transH (BF.acT-irr K L h uF uF' (transH (refl (F.T.mk1 L ruF)) eF) eF (dF K k u p)) (dnF K L k h u eF p)) ;
    t2 : Id (V1.Ix (BF.FT L ruF)) (BF.acT K L h uF ruF (refl (F.T.mk1 L ruF)) (dF K k u p)) (subst (F.T.QK L) (\ z -> V1.Ix (BF.FT L z)) uF' ruF (symH EF) q') =
     substSym (F.T.QK L) (\ z -> V1.Ix (BF.FT L z)) ruF uF' EF (BF.acT K L h uF ruF (refl (F.T.mk1 L ruF)) (dF K k u p)) q' t1 ;
    s1 : Id (V1.Ix (BH.FT L (cph L kh (F.S.rs K L h u)))) (BH.acT K L h (cph K k u) (cph L kh (F.S.rs K L h u)) e X)
                                                      (BG.acT K L h (phG K k uF) (phG L kh uF') (transH eG (apH {G.T.QK L} {G.T.P1 L} (G.T.mk1 L) q)) X) =
     BH.acT-irr K L h (cph K k u) (cph L kh (F.S.rs K L h u)) e (transH eG (apH {G.T.QK L} {G.T.P1 L} (G.T.mk1 L) q)) X ;
    s2 : Id (V1.Ix (BG.FT L (phG L kh uF'))) (BG.acT K L h (phG K k uF) (phG L kh uF') (transH eG (apH {G.T.QK L} {G.T.P1 L} (G.T.mk1 L) q)) X)
                                           (subst (G.T.QK L) (\ z -> V1.Ix (BG.FT L z)) (phG L kh ruF) (phG L kh uF') q (BG.acT K L h (phG K k uF) (phG L kh ruF) eG X)) =
     BG.acT-tr K L h (phG K k uF) (phG L kh ruF) (phG L kh uF') eG q X ;
    s3 : Id (V1.Ix (BG.FT L (phG L kh uF'))) (subst (G.T.QK L) (\ z -> V1.Ix (BG.FT L z)) (phG L kh ruF) (phG L kh uF') q (BG.acT K L h (phG K k uF) (phG L kh ruF) eG X))
                                           (subst (G.T.QK L) (\ z -> V1.Ix (BG.FT L z)) (phG L kh ruF) (phG L kh uF') q (dG L kh ruF (BG.acS K L h uF (dF K k u p)))) =
     apH {V1.Ix (BG.FT L (phG L kh ruF))} {V1.Ix (BG.FT L (phG L kh uF'))} (\ z -> subst (G.T.QK L) (\ z2 -> V1.Ix (BG.FT L z2)) (phG L kh ruF) (phG L kh uF') q z) (dnG K L k h uF eG (dF K k u p)) ;
    s4 : Id (V1.Ix (BG.FT L (phG L kh uF'))) (subst (G.T.QK L) (\ z -> V1.Ix (BG.FT L z)) (phG L kh ruF) (phG L kh uF') q (dG L kh ruF (BG.acS K L h uF (dF K k u p))))
                                           (subst (G.T.QK L) (\ z -> V1.Ix (BG.FT L z)) (phG L kh ruF) (phG L kh uF') q (dG L kh ruF (subst (F.T.QK L) (\ z -> V1.Ix (BF.FT L z)) uF' ruF (symH EF) q'))) =
     apH {V1.Ix (BF.FT L ruF)} {V1.Ix (BG.FT L (phG L kh uF'))} (\ z -> subst (G.T.QK L) (\ z2 -> V1.Ix (BG.FT L z2)) (phG L kh ruF) (phG L kh uF') q (dG L kh ruF z)) t2 ;
    s5 : Id (V1.Ix (BG.FT L (phG L kh uF'))) (subst (G.T.QK L) (\ z -> V1.Ix (BG.FT L z)) (phG L kh ruF) (phG L kh uF') q (dG L kh ruF (subst (F.T.QK L) (\ z -> V1.Ix (BF.FT L z)) uF' ruF (symH EF) q'))) (dG L kh uF' q') =
     depMap (F.T.QK L) (G.T.QK L) (\ z -> V1.Ix (BF.FT L z)) (\ z -> V1.Ix (BG.FT L z)) (phG L kh) (dG L kh) ruF uF' EF q' ;
    res : Id (V1.Ix (BH.FT L (cph L kh (F.S.rs K L h u)))) (BH.acT K L h (cph K k u) (cph L kh (F.S.rs K L h u)) e (cd K k u p)) (cd L kh (F.S.rs K L h u) (BF.acS K L h u p)) =
     transH s1 (transH s2 (transH s3 (transH s4 s5))) ;
   } ;
   cdn : BH.DN J cph cd = \ K L k h u e p -> N[K, L, k, h, u, e, p].res ;
  } ;
  module A = CB[F.S.IdA, F.T.IdA, G.T.IdA, F.da J f, f.2.1.2, G.da J g, g.2.1.2] ;
  module Mu = CB[F.S.IdM, F.T.IdM, G.T.IdM, F.dm J f, f.2.2.1.2, G.dm J g, g.2.2.1.2] ;
  module Cn (c : R.R) { module N = CN[F.S.IdC c, F.T.IdC c, G.T.IdC c, F.dc J f c, (f.2.2.2 c).2, G.dc J g c, (g.2.2.2 c).2] ; } ;
  cmp : H.M J = H.mkM J cph cnt ((A.cd, A.cdn), ((Mu.cd, Mu.cdn), \ c -> (Cn[c].N.cd, Cn[c].N.cdn))) ;
 } ;
} ;
