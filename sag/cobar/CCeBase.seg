-- CCeBase.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', over the
-- empty context, on the closed copy Ec of yo(y).A (whose fibres and action
-- are those of Prop 58's Yy.Ay): the base of cE, the hom alpha(d) of the
-- code d of a point (d, a) (c2's FromM, natural by CHomT16).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module CB (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module EH = CEqHt[a].EH[R, encK, pe, y, u] ;
 module RH = CRestrHT[a].RHT[R, encK, pe, y'] ;
 module HO = PB.CHtpyOps[a+] ;
 Nl : L.PCtx = RH.Nl ;
 Ec : L.PTy[Nl] = RH.ClT[EH.Ez].ty ;
 module FMy = CHomT11[a].FromM[R, encK, pe, y, y'] ;
 module NAy = CHomT16[a].Nat[R, encK, pe, y, y'] ;
 module Py = FMy.P ;
 HXY : FibCwF[a, a+].fibCwF.Ty Nl = CHomT3[a].HomP[R, encK, pe].Hom[y, y'].HomT ;
 dOf (I : Ob) (w : V1.Ix (Ec.tob I tt)) : Py.F.M I = w.1 ;
 resE (J I : Ob) (h : Hom J I) (w : V1.Ix (Ec.tob I tt)) : Id (Py.F.M J) (dOf J (Ec.tact J I h tt tt (refl tt) w)) (Py.F.res I J h (dOf I w)) =
  Py.F.mExt J (dOf J (Ec.tact J I h tt tt (refl tt) w)) (Py.F.res I J h (dOf I w)) (refl (Py.F.fpOf J (Py.F.res I J h (dOf I w)))) ;
 k1 (J I : Ob) (h : Hom J I) (m : Py.F.M I)
  : Id (V1.Ix (HXY.1.tob J tt)) (HXY.1.tact J I h tt tt (refl tt) (FMy.alpha I m)) (FMy.alpha J (Py.F.res I J h m)) = symH (NAy.aNat I J h m) ;
 k2 (J I : Ob) (h : Hom J I) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (HXY.1.tob J tt)) (FMy.alpha J (Py.F.res I J h (dOf I w))) (FMy.alpha J (dOf J (Ec.tact J I h tt tt (refl tt) w))) =
  apH {Py.F.M J} {V1.Ix (HXY.1.tob J tt)} (FMy.alpha J) (symH (resE J I h w)) ;
 k3 (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (Ec.tob J tt)) (Ec.tact J I h tt tt e w) (Ec.tact J I h tt tt (refl tt) w) = refl (Ec.tact J I h tt tt (refl tt) w) ;
 k4 (J I : Ob) (h : Hom J I) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (HXY.1.tob J tt)) (HXY.1.tact J I h tt tt (refl tt) (FMy.alpha I (dOf I w))) (FMy.alpha J (dOf J (Ec.tact J I h tt tt (refl tt) w))) =
  transH (k1 J I h (dOf I w)) (k2 J I h w) ;
 k5 (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (HXY.1.tob J tt)) (HXY.1.tact J I h tt tt e (FMy.alpha I (dOf I w))) (HXY.1.tact J I h tt tt (refl tt) (FMy.alpha I (dOf I w))) =
  L.tact-irr Nl HXY.1 J I h tt tt e (refl tt) (FMy.alpha I (dOf I w)) ;
 k6 (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (HXY.1.tob J tt)) (HXY.1.tact J I h tt tt e (FMy.alpha I (dOf I w))) (FMy.alpha J (dOf J (Ec.tact J I h tt tt e w))) =
  transH (k5 J I h e w) (transH (k4 J I h w) (apH {V1.Ix (Ec.tob J tt)} {V1.Ix (HXY.1.tob J tt)} (\ w2 -> FMy.alpha J (dOf J w2)) (symH (k3 J I h e w)))) ;
 -- a natural map out of a closed type over the empty context, from its naturality at the point tt
 -- (generic in the values, so the split on Top does not unfold them)
 module TopN (B : L.PTy[Nl]) (F : (I : Ob) (x : Top) -> V1.Ix (Ec.tob I x) -> V1.Ix (B.tob I x))
   (Fn : (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
      -> Id (V1.Ix (B.tob J tt)) (B.tact J I h tt tt e (F I tt w)) (F J tt (Ec.tact J I h tt tt e w))) {
  nat (J I : Ob) (h : Hom J I) : (x x' : Top) (e : Id Top (Nl.act J I h x) x') (w : V1.Ix (Ec.tob I x))
   -> Id (V1.Ix (B.tob J x')) (B.tact J I h x x' e (F I x w)) (F J x' (Ec.tact J I h x x' e w)) = split {
   tt -> split { tt -> \ e w -> Fn J I h e w } } ;
  nm : HO.NMap[Nl, Ec, B] = new HO.NMap[Nl, Ec, B, \ I o w -> F I o w, \ J I h x x' e w -> nat J I h x x' e w] ;
 } ;
 fA (I : Ob) : (x : Top) -> V1.Ix (Ec.tob I x) -> V1.Ix (HXY.1.tob I x) = split { tt -> \ w -> FMy.alpha I (dOf I w) } ;
 hN : HO.NMap[Nl, Ec, HXY.1] = TopN[HXY.1, fA, k6].nm ;
} ;
