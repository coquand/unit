-- CTruncLevelCwF.seg (canonicity-c2; SIMPLIFIED.md item 2, for
-- canonicity-45's relation): elimination of the decoded closed
-- truncation into a proposition, at the level of the CwF of fibrant types.
--
-- P0 is a closed level-a type, with a fibration cT of its truncation; Dt
-- is the decoding over G of the code of that truncation (CClosedCode).
-- For P fibrant over G (level a+) with an internal proof pP that P is a
-- proposition (Swan's Id), and f an element of P over G.P0 (P0 read at
-- level a+), elim is an element of P over G.Dt.
--   pP gives core's homotopy (FibHt.YH), hence a contraction of P over
--   itself (CTruncHProp), hence the seeded operation of P
--   (CTruncFromProp); CTruncLevel.ElimUp is the map.
-- No computation rule is stated: the target is a proposition.
level a ;
open Base ; open Prelude[a++] ; open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GS = PB.GPre[a].PS ;
module L = PB.GPre[a+].PS ;
module FCw = FibCwF[a, a+] ;
module FC = FCw.FC ;
module HO = PB.CHtpyOps[a+] ;
module EQ = CwFEq.Eqv[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

-- an internal proposition is one in core's sense
module CoreProp (G : L.PCtx) (B : FC.STy G) (pB : FCw.fibCwF.El G (PU.isProp G B)) {
  D : L.PCtx = L.extP G B.1 ;
  C : L.PTy[D] = L.subTy D G B.1 (L.pP G B.1) ;
  Bw : FC.STy D = FCw.fibCwF.subT D G B (FCw.fibCwF.p G B) ;
  w : L.PEl[L.extP D C, PosIdY[a, a+].IdY[L.extP D C, L.subTy (L.extP D C) D C (L.pP D C), L.subEl (L.extP D C) D C (L.qP G B.1) (L.pP D C), L.qP D C].IdYT] =
    (FCw.fibPi.Pi-iso D Bw (EQ.Id2 G B)).fun ((FCw.fibPi.Pi-iso G B (FCw.fibPi.Pi D Bw (EQ.Id2 G B))).fun pB) ;
  module Y = FibHt[a, a+].YH[D, C, C, CLocBoundContr[a, a+].constant D C (L.qP G B.1), HO.idN D C,
    L.subEl (L.extP D C) D C (L.qP G B.1) (L.pP D C), L.qP D C,
    \ X z -> refl ((L.qP G B.1).eob X (L.fstE D C X z)), \ X z -> refl (L.sndE D C X z), w] ;
  coreProp : CTruncHProp[a, a+].Proposition[G, B.1].isProp = Y.H ;
  contrOp : PB.CPartial[a+].ContrOp D C = CTruncHProp[a, a+].Proposition[G, B.1].Fibrant[B.2.1, coreProp].contract ;
} ;

-- a map of types as an element over the extended context
module ElOfN (G : L.PCtx) (A B : L.PTy[G]) (n : HO.NMap[G, A, B]) {
  GA : L.PCtx = L.extP G A ;
  Bw : L.PTy[GA] = L.subTy GA G B (L.pP G A) ;
  ev (X : Ob) (z : V1.Ix (GA.ob X)) : V1.Ix (Bw.tob X z) = n.nfun X (L.fstE G A X z) (L.sndE G A X z) ;
  en (J I : Ob) (h : Hom J I) (z : V1.Ix (GA.ob I)) (z' : V1.Ix (GA.ob J)) (e : Id (V1.Ix (GA.ob J)) (GA.act J I h z) z')
    : Id (V1.Ix (Bw.tob J z')) (Bw.tact J I h z z' e (ev I z)) (ev J z') =
    idJ (V1.Ix (GA.ob J)) (GA.act J I h z)
      (\ z2 e2 -> Id (V1.Ix (Bw.tob J z2)) (Bw.tact J I h z z2 e2 (ev I z)) (ev J z2))
      (transH (L.tact-irr G B J I h (L.fstE G A I z) (G.act J I h (L.fstE G A I z))
                 (L.ntEq GA G (L.pP G A) J I h z (GA.act J I h z) (refl (GA.act J I h z)))
                 (refl (G.act J I h (L.fstE G A I z))) (ev I z))
         (n.nnat J I h (L.fstE G A I z) (G.act J I h (L.fstE G A I z)) (refl (G.act J I h (L.fstE G A I z))) (L.sndE G A I z)))
      z' e ;
  el : L.PEl[GA, Bw] = L.mkPEl GA Bw ev en ;
} ;

module ElimUpP (P0 : GS.PTy[GS.nilP]) (cT : PB.CFibCl.Cl GS.nilP CTrunc[a, a].Truncation[GS.nilP, P0].Ty)
  (G : L.PCtx) (P : FC.STy G) (pP : FCw.fibCwF.El G (PU.isProp G P)) {
  ApG : L.PTy[G] = L.subTy G L.nilP CTruncLevel[a].Lift[P0].Ap (L.epsP G) ;
  module TAp = PB.GPre[a+].TyL[G, ApG] ;
  kP : CTruncSeededBack[a, a+].Seeded[G, P.1].Op = CTruncFromProp[a, a+].FromPointed[G, P.1, CoreProp[G, P, pP].contrOp].op ;
  module On (f : L.PEl[L.extP G ApG, L.subTy (L.extP G ApG) G P.1 (L.pP G ApG)]) {
    fN : HO.NMap[G, ApG, P.1] =
      new HO.NMap[G, ApG, P.1, \ I x a0 -> f.eob I (x, a0),
        \ J I g x y e a0 ->
          transH (L.tact-irr G P.1 J I g x y e
                    (L.ntEq (L.extP G ApG) G (L.pP G ApG) J I g (x, a0) (y, ApG.tact J I g x y e a0)
                       (TAp.pr-tact J I g x y e a0)) (f.eob I (x, a0)))
            (f.enat J I g (x, a0) (y, ApG.tact J I g x y e a0) (TAp.pr-tact J I g x y e a0))] ;
    module EU = CTruncLevel[a].ElimUp[P0, cT, G, P.1, kP, fN] ;
    elimN : HO.NMap[G, EU.Dt, P.1] = EU.elim ;
    elim : L.PEl[L.extP G EU.Dt, L.subTy (L.extP G EU.Dt) G P.1 (L.pP G EU.Dt)] = ElOfN[G, EU.Dt, P.1, elimN].el ;
  } ;
} ;
