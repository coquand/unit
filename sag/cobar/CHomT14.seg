-- CHomT14.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 11: beta is natural in
-- the stage (res (beta z) = beta (tact z), by mExt: the families agree;
-- each datum is a transport of the same value between the same points of
-- the set of points, after the argument's transport back (bk) is undone).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module BNat (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module TM = CHomT8[a].ToM[R, encK, pe, s, t] ;
 module P = TM.P ;
 module F = P.F ;
 module H = P.H ;
 tactZ (I J : Ob) (v : Hom J I) (z : P.Z I) : P.Z J = H.HomT.1.tact J I v tt tt (refl tt) z ;
 phEq (I J : Ob) (v : Hom J I) (z : P.Z I) : Id (F.Fam J) (F.resF I J v (P.ph I z)) (P.ph J (tactZ I J v z)) = refl (F.resF I J v (P.ph I z)) ;
} ;

module BinN (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation)
  (opS : C.El C.nil (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[s].Qt (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[s].Qt CHomT3[a].HomP[R, encK, pe].Alg[s].Qt)))
  (opT : C.El C.nil (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[t].Qt (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[t].Qt CHomT3[a].HomP[R, encK, pe].Alg[t].Qt)))
  (sel : (I : Ob) (z : CHomT4[a].P3[R, encK, pe, s, t].Z I) -> V1.Ix (CHomT4[a].P3[R, encK, pe, s, t].H.B0.BinOf[opS, opT].DataBin.1.tob I (tt, z.1)))
  (selAct : (I J : Ob) (v : Hom J I) (z : CHomT4[a].P3[R, encK, pe, s, t].Z I)
     -> Id (PresheafPi[a, a+].PPi[PosFull[a].PB.BC].PiCode[CHomT4[a].P3[R, encK, pe, s, t].H.B0.Gh, CHomT4[a].P3[R, encK, pe, s, t].H.B0.BinOf[opS, opT].W4h.1, CHomT4[a].P3[R, encK, pe, s, t].H.B0.BinOf[opS, opT].IdT3.1].FunT J
              (PresheafPi[a, a+].PPi[PosFull[a].PB.BC].PiCode[CHomT4[a].P3[R, encK, pe, s, t].H.B0.Gh, CHomT4[a].P3[R, encK, pe, s, t].H.B0.BinOf[opS, opT].W4h.1, CHomT4[a].P3[R, encK, pe, s, t].H.B0.BinOf[opS, opT].IdT3.1].ptOf J (tt, (BNat[R, encK, pe, s, t].tactZ I J v z).1)))
          (sel J (BNat[R, encK, pe, s, t].tactZ I J v z)).1
          (PresheafPi[a, a+].PPi[PosFull[a].PB.BC].PiCode[CHomT4[a].P3[R, encK, pe, s, t].H.B0.Gh, CHomT4[a].P3[R, encK, pe, s, t].H.B0.BinOf[opS, opT].W4h.1, CHomT4[a].P3[R, encK, pe, s, t].H.B0.BinOf[opS, opT].IdT3.1].piFun J I v (tt, z.1) (tt, (BNat[R, encK, pe, s, t].tactZ I J v z).1) (refl (tt, (BNat[R, encK, pe, s, t].tactZ I J v z).1)) (sel I z).1)) {
 module BN0 = BNat[R, encK, pe, s, t] ;
 module D5 = CHomT5[a].DNOf[R, encK, pe, s, t, opS, opT, sel] ;
 module P = D5.P ;
 module F = D5.F ;
 module H = D5.H ;
 module HB = D5.HB ;
 module BB = D5.BB ;
 module PC = D5.PC ;
 IT : C.Ty F.T.G3 = D5.IT ;
 P3 (K : Ob) : U a+ = D5.P3 K ;
 W4K (K : Ob) : U a+ = D5.W4K K ;
 module DE (I J : Ob) (v : Hom J I) (z : P.Z I) (K : Ob) (f : Hom K J) (w : F.S.T3 K) (p : V1.Ix (BB.FS K w)) {
  z' : P.Z J = BN0.tactZ I J v z ;
  ph : F.Fam I = P.ph I z ;
  x : V1.Ix (H.B0.Gh.ob I) = (tt, z.1) ;
  x' : V1.Ix (H.B0.Gh.ob J) = (tt, z'.1) ;
  vf : Hom K I = compH K J I v f ;
  wp : W4K K = (w.1, (w.2.1, (w.2.2, p))) ;
  y : V1.Ix (H.B0.Gh.ob K) = H.B0.Gh.act K I vf x ;
  y' : V1.Ix (H.B0.Gh.ob K) = H.B0.Gh.act K J f x' ;
  qy : Id (V1.Ix (H.B0.Gh.ob K)) y y' = PC.piPt J I v x x' (refl x') K f ;
  a0 : W4K K = PresheafPi[a, a+].PPi[PosFull[a].PB.BC].bk H.B0.Gh HB.W4h.1 K y y' qy wp ;
  -- the argument moved back is the argument (the fibre of W4 along G's points depends only on the nil point)
  pia : Id (W4K K) a0 wp =
   transH (subst-ap (V1.Ix (H.B0.Gh.ob K)) (V1.Ix (C.nil.ob K)) (\ y1 -> y1.1) (\ o -> V1.Ix (HB.W4.1.tob K o)) y' y (symH qy) wp)
    (apH {Id (V1.Ix (C.nil.ob K)) tt tt} {W4K K} (\ r -> subst (V1.Ix (C.nil.ob K)) (\ o -> V1.Ix (HB.W4.1.tob K o)) tt tt r wp)
       (V1.isSetIx (C.nil.ob K) tt tt (ap (V1.Ix (H.B0.Gh.ob K)) (V1.Ix (C.nil.ob K)) (\ y1 -> y1.1) y' y (symH qy)) (refl tt))) ;
  phi : PC.FunT I (PC.ptOf I x) = (sel I z).1 ;
  sgY (aa : W4K K) : P3 K = HB.sigN K (y, aa) ;
  X' : V1.Ix (IT.1.tob K (sgY a0)) = phi K vf a0 ;
  X : V1.Ix (IT.1.tob K (sgY wp)) = phi K vf wp ;
  eX : Id (V1.Ix (IT.1.tob K (sgY wp))) (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY a0) (sgY wp) (ap (W4K K) (P3 K) sgY a0 wp pia) X') X =
   transH (symH (subst-ap (W4K K) (P3 K) sgY (\ v2 -> V1.Ix (IT.1.tob K v2)) a0 wp pia X'))
    (CMorX[a].apdS (W4K K) (\ aa -> V1.Ix (IT.1.tob K (sgY aa))) (\ aa -> phi K vf aa) a0 wp pia) ;
  pp : Id (V1.Ix (HB.Dw.ob K)) (y, a0) (y', wp) = PresheafPi[a, a+].PPi[PosFull[a].PB.BC].pairpath H.B0.Gh HB.W4h.1 K y y' qy wp ;
  tgt : P3 K = F.T.mk3 K (F.mp3 I ph K vf w) ;
  qL : Id (P3 K) (sgY wp) tgt = ap (Hom K I) (P3 K) (\ k -> F.T.mk3 K (F.mp3 I ph K k w)) (compH K K I vf (idH K)) vf (comp-idr K I vf) ;
  qR : Id (P3 K) (HB.sigN K (y', wp)) tgt = ap (Hom K J) (P3 K) (\ k -> F.T.mk3 K (F.mp3 J (F.resF I J v ph) K k w)) (compH K K J f (idH K)) f (comp-idr K J f) ;
  path1 : Id (P3 K) (sgY a0) tgt = transH (ap (W4K K) (P3 K) sgY a0 wp pia) qL ;
  path2 : Id (P3 K) (sgY a0) tgt = transH (ap (V1.Ix (HB.Dw.ob K)) (P3 K) (HB.sigN K) (y, a0) (y', wp) pp) qR ;
  Tt : U a+ = V1.Ix (IT.1.tob K tgt) ;
  L1 : Id Tt (D5.dT I z K vf w p) (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY wp) tgt qL X) =
   subst-ap (Hom K I) (P3 K) (\ k -> F.T.mk3 K (F.mp3 I ph K k w)) (\ v2 -> V1.Ix (IT.1.tob K v2)) (compH K K I vf (idH K)) vf (comp-idr K I vf) X ;
  L2 : Id Tt (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY wp) tgt qL X) (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY a0) tgt path1 X') =
   transH (apH {V1.Ix (IT.1.tob K (sgY wp))} {Tt} (\ u -> subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY wp) tgt qL u) (symH eX))
    (symH (D5.substTr K (sgY a0) (sgY wp) tgt (ap (W4K K) (P3 K) sgY a0 wp pia) qL X')) ;
  M : Id Tt (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY a0) tgt path1 X') (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY a0) tgt path2 X') =
   apH {Id (P3 K) (sgY a0) tgt} {Tt} (\ r -> subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY a0) tgt r X') (V1.isSetIx (F.T.G3.ob K) (sgY a0) tgt path1 path2) ;
  R1 : Id Tt (D5.dT J (BN0.tactZ I J v z) K f w p) (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (HB.sigN K (y', wp)) tgt qR ((sel J (BN0.tactZ I J v z)).1 K f wp)) =
   subst-ap (Hom K J) (P3 K) (\ k -> F.T.mk3 K (F.mp3 J (F.resF I J v ph) K k w)) (\ v2 -> V1.Ix (IT.1.tob K v2)) (compH K K J f (idH K)) f (comp-idr K J f) ((sel J (BN0.tactZ I J v z)).1 K f wp) ;
  R2 : Id (V1.Ix (IT.1.tob K (HB.sigN K (y', wp)))) ((sel J (BN0.tactZ I J v z)).1 K f wp) (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY a0) (HB.sigN K (y', wp)) (ap (V1.Ix (HB.Dw.ob K)) (P3 K) (HB.sigN K) (y, a0) (y', wp) pp) X') =
   transH (apH {PC.FunT J (PC.ptOf J x')} {V1.Ix (IT.1.tob K (HB.sigN K (y', wp)))} (\ F2 -> F2 K f wp) (selAct I J v z))
    (subst-ap (V1.Ix (HB.Dw.ob K)) (P3 K) (HB.sigN K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (y, a0) (y', wp) pp X') ;
  R3 : Id Tt (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (HB.sigN K (y', wp)) tgt qR ((sel J (BN0.tactZ I J v z)).1 K f wp)) (subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (sgY a0) tgt path2 X') =
   transH (apH {V1.Ix (IT.1.tob K (HB.sigN K (y', wp)))} {Tt} (\ u -> subst (P3 K) (\ v2 -> V1.Ix (IT.1.tob K v2)) (HB.sigN K (y', wp)) tgt qR u) R2)
    (symH (D5.substTr K (sgY a0) (HB.sigN K (y', wp)) tgt (ap (V1.Ix (HB.Dw.ob K)) (P3 K) (HB.sigN K) (y, a0) (y', wp) pp) qR X')) ;
  law : Id Tt (D5.dT I z K vf w p) (D5.dT J (BN0.tactZ I J v z) K f w p) =
   transH L1 (transH L2 (transH M (symH (transH R1 R3)))) ;
 } ;
} ;
