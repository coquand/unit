-- The one temporary Proposition 58 premise for the conditional duality pass.
-- At a fixed syntactic relative presentation u and target copy y, the
-- comparison fwd has a merely inhabited homotopy fibre at every target.
-- The type below is exactly CInjSurj.ContrFib's surjectivity input; no
-- inverse or chosen representative is assumed.
level a ;
open Base ;
open Prelude[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module QP = CwFQP.QP[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module D3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x)
  (y : SX.Over[R].Presentation) {
 module F = CDFw8[a].Fw8[R, encK, pe, x, u, y] ;
 module Fib = CInjSurj[a].ContrFib[C.nil, F.HU, F.T0, F.fwd] ;
 MereSurj : U a++ = C.El Fib.GB Fib.T ;
 -- The checked generic implication: propositional fibres plus the one
 -- mere-surjectivity premise give the contractible-fibre datum used by CRho2.
 module Assemble (pF : C.El Fib.GB (PU.isProp Fib.GB Fib.Fib))
   (ms : MereSurj) {
  contr : C.El Fib.GB (EQ.isContr Fib.GB Fib.Fib) = Fib.PF[pF, ms].contrFib ;
  Kd : C.El C.nil (QP.Kr C.nil F.T0 F.HU F.fwd) =
   OV.lam C.nil F.T0 (EQ.isContr Fib.GB Fib.Fib) contr ;
 } ;
} ;
