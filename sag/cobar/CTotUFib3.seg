-- CTotUFib3.seg (canonicity-c2; SIMPLIFIED.md item 5): "U of a fibration
-- of the total site is a levelwise fibration": the composite.
--   KP.k0   the composite of U A at (Y, z0, s0): the composite of A at
--           the extended point and side (KP.rdEq: the same total of A)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module UFib3 (C : CIntCat[a, vl].IC) {
 module U2 = CTotUFib2[a, vl, l].UFib2[C] ;
 module UX = U2.UX ;
 module TR = U2.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;

 module Cp (G : P1.PCtx) (A : P1.PTy[G]) (e e' : G1.GB.IPt)
   (c1 : G1.GB.CLine[l].Lines[G, A].CompK[e, e'].Comp) {
  module SD = U2.Sd[G, A, e] ;
  module EKm = SD.EKm ;
  module EK1 = EKm.EK1 ;
  module EK0 = EKm.EK0 ;
  module XB = EKm.XB ;
  module FT1 = EKm.FT1 ;
  module FT0 = EKm.FT0 ;
  UG : P0.PCtx = EKm.UG ;
  UA : P0.PTy[UG] = EKm.UA ;
  module CK1 = G1.GB.CLine[l].Lines[G, A].CompK[e, e'] ;
  module CK0 = G0.GB.CLine[l].Lines[UG, UA].CompK[e, e'] ;
  module SB1 = G1.GB.CSub[l].SubE[XB.RH.F1.GI, G, XB.RH.F1.ev e', A] ;
  module SB0 = G0.GB.CSub[l].SubE[XB.RH.F0.GI, UG, XB.RH.F0.ev e', UA] ;
  Tot1 (X : Ob1) : U l = EKm.Tot1 X ;
  Pt1 (X : Ob1) : U l = EKm.Pt1 X ;
  -- an element over the other end, read as a total of A
  rd1 (X : Ob1) (v : CK1.SE.TS.EI X) : Tot1 X = SB1.mV X (CK1.SE.mV X v) ;
  rd0 (Y : Ob0) (v : CK0.SE.TS.EI Y) : Tot1 (RN.o Y) = SB0.mV Y (CK0.SE.mV Y v) ;
  pe' (Y : Ob0) : G1.GB.IvP (RN.o Y) = G1.GB.ptH (RN.o Y) e' ;

  module KP (Y : Ob0) (z0 : EK0.TV.EI Y) (s0 : EK0.PT.Side[Y, z0]) {
   module Z = EKm.XZ[Y, z0] ;
   module P = SD.XP[Y, z0, s0] ;
   p0' : Pt1 (RN.o Y) = (XB.RH.F0.ev e').nt Y Z.x0 ;
   p1' : Pt1 (RN.o Y) = (XB.RH.F1.ev e').nt (RN.o Y) Z.x1 ;
   q' : Id (Pt1 (RN.o Y)) p1' p0' =
    trans (Pt1 (RN.o Y)) p1' (Z.x1.1 (RN.o Y) (TR.fn.onH Y Y (EKm.id0 Y)) (pe' Y)) p0'
     (ap (RN.Hom1 (RN.o Y) (RN.o Y)) (Pt1 (RN.o Y)) (\ k -> Z.x1.1 (RN.o Y) k (pe' Y)) (EKm.id1 Y) (TR.fn.onH Y Y (EKm.id0 Y)) (symH (TR.fn.onId Y)))
     XB.RE[Y, Z.x0, Y, EKm.id0 Y, pe' Y].ret ;
   k1 : W0.Ix (A.tob (RN.o Y) p1') = c1.kop (RN.o Y) Z.z1 P.side ;
   k0 : W0.Ix (UA.tob Y p0') = EK1.TA.coeT (RN.o Y) p1' p0' q' k1 ;
   t1 : CK1.SE.TS.EI (RN.o Y) = CK1.SE.TS.pr (RN.o Y) Z.z1 k1 ;
   t0 : CK0.SE.TS.EI Y = CK0.SE.TS.pr Y z0 k0 ;
   rdEq : Id (Tot1 (RN.o Y)) (rd0 Y t0) (rd1 (RN.o Y) t1) = symH (EK1.TA.pr-coe (RN.o Y) p1' p0' q' k1) ;
  } ;

  -- reading is natural
  rdN1 (Z X : Ob1) (g : RN.Hom1 Z X) (v : CK1.SE.TS.EI X)
   : Id (Tot1 Z) (rd1 Z (CK1.SE.TS.E.act Z X g v)) (SB1.TC.E.act Z X g (rd1 X v)) =
   trans (Tot1 Z) (rd1 Z (CK1.SE.TS.E.act Z X g v)) (SB1.mV Z (CK1.SE.TC.E.act Z X g (CK1.SE.mV X v))) (SB1.TC.E.act Z X g (rd1 X v))
    (ap (CK1.SE.TC.EI Z) (Tot1 Z) (SB1.mV Z) (CK1.SE.mV Z (CK1.SE.TS.E.act Z X g v)) (CK1.SE.TC.E.act Z X g (CK1.SE.mV X v))
       (symH (CK1.SE.mV-nat Z X g v)))
    (symH (SB1.mV-nat Z X g (CK1.SE.mV X v))) ;
  rdN0 (Z Y : Ob0) (h : RN.Hom0 Z Y) (v : CK0.SE.TS.EI Y)
   : Id (Tot1 (RN.o Z)) (rd0 Z (CK0.SE.TS.E.act Z Y h v)) (SB1.TC.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (rd0 Y v)) =
   trans (Tot1 (RN.o Z)) (rd0 Z (CK0.SE.TS.E.act Z Y h v)) (SB0.mV Z (CK0.SE.TC.E.act Z Y h (CK0.SE.mV Y v)))
     (SB1.TC.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (rd0 Y v))
    (ap (CK0.SE.TC.EI Z) (Tot1 (RN.o Z)) (SB0.mV Z) (CK0.SE.mV Z (CK0.SE.TS.E.act Z Y h v)) (CK0.SE.TC.E.act Z Y h (CK0.SE.mV Y v))
       (symH (CK0.SE.mV-nat Z Y h v)))
    (symH (SB0.mV-nat Z Y h (CK0.SE.mV Y v))) ;

  -- the composite of A at equal points and sides with the same values
  kopExt (X : Ob1) (x x' : EK1.TV.EI X) (Pq : Id (EK1.TV.EI X) x x') (s : EK1.PT.Side[X, x]) (s' : EK1.PT.Side[X, x'])
   (eQ : Id (G1.GB.Phi X) s.pQ s'.pQ)
   (ev : (W : Ob1) (f : RN.Hom1 W X) (i : G1.GB.Lands W X s.pQ f) (i' : G1.GB.Lands W X s'.pQ f) -> Id (EK1.TS.EI W) (s.pv W f i) (s'.pv W f i'))
   : Id (CK1.SE.TS.EI X) (CK1.SE.TS.pr X x (c1.kop X x s)) (CK1.SE.TS.pr X x' (c1.kop X x' s')) =
   idJ (EK1.TV.EI X) x
    (\ x2 P2 -> (s2 : EK1.PT.Side[X, x2]) -> Id (G1.GB.Phi X) s.pQ s2.pQ
       -> ((W : Ob1) (f : RN.Hom1 W X) (i : G1.GB.Lands W X s.pQ f) (i' : G1.GB.Lands W X s2.pQ f) -> Id (EK1.TS.EI W) (s.pv W f i) (s2.pv W f i'))
       -> Id (CK1.SE.TS.EI X) (CK1.SE.TS.pr X x (c1.kop X x s)) (CK1.SE.TS.pr X x2 (c1.kop X x2 s2)))
    (\ s2 eQ2 ev2 -> ap (EK1.PT.Side[X, x]) (CK1.SE.TS.EI X) (\ w -> CK1.SE.TS.pr X x (c1.kop X x w)) s s2 (EK1.PT.side-ext X x s s2 eQ2 ev2))
    x' Pq s' eQ ev ;

  -- uniformity
  module KUn (Z Y : Ob0) (h : RN.Hom0 Z Y) (z0 : EK0.TV.EI Y) (s0 : EK0.PT.Side[Y, z0]) {
   module K = KP[Y, z0, s0] ;
   z0' : EK0.TV.EI Z = EK0.TV.E.act Z Y h z0 ;
   s0' : EK0.PT.Side[Z, z0'] = EK0.PT.rside Z Y h z0 s0 ;
   module K' = KP[Z, z0', s0'] ;
   fh : RN.Hom1 (RN.o Z) (RN.o Y) = TR.fn.onH Z Y h ;
   rs1 : EK1.PT.Side[RN.o Z, EK1.TV.E.act (RN.o Z) (RN.o Y) fh K.Z.z1] = EK1.PT.rside (RN.o Z) (RN.o Y) fh K.Z.z1 K.P.side ;
   module EV (W : Ob1) (k : RN.Hom1 W (RN.o Z)) (i : G1.GB.Lands W (RN.o Z) rs1.pQ k) (i' : G1.GB.Lands W (RN.o Z) K'.P.side.pQ k) {
    kk : RN.Hom1 W (RN.o Y) = G1.GB.BC.oC W (RN.o Z) (RN.o Y) fh k ;
    LZ : Ob0 = UX.lf Z W k ;
    LY : Ob0 = UX.lf Y W kk ;
    cz : RN.Hom0 LZ Z = UX.cl Z W k ;
    c' : RN.Hom0 LZ Y = G0.GB.BC.oC LZ Z Y h cz ;
    vz : RN.Hom1 W (RN.o LZ) = SD.vp Z W k ;
    vy : RN.Hom1 W (RN.o LY) = SD.vp Y W kk ;
    ek : Id (RN.Hom1 W (RN.o Y)) (G1.GB.BC.oC W (RN.o LZ) (RN.o Y) (TR.fn.onH LZ Y c') vz) kk =
     trans (RN.Hom1 W (RN.o Y)) (G1.GB.BC.oC W (RN.o LZ) (RN.o Y) (TR.fn.onH LZ Y c') vz)
       (G1.GB.BC.oC W (RN.o LZ) (RN.o Y) (G1.GB.BC.oC (RN.o LZ) (RN.o Z) (RN.o Y) fh (TR.fn.onH LZ Z cz)) vz) kk
      (ap (RN.Hom1 (RN.o LZ) (RN.o Y)) (RN.Hom1 W (RN.o Y)) (\ w -> G1.GB.BC.oC W (RN.o LZ) (RN.o Y) w vz) (TR.fn.onH LZ Y c')
         (G1.GB.BC.oC (RN.o LZ) (RN.o Z) (RN.o Y) fh (TR.fn.onH LZ Z cz)) (TR.fn.onComp LZ Z Y h cz))
      (trans (RN.Hom1 W (RN.o Y)) (G1.GB.BC.oC W (RN.o LZ) (RN.o Y) (G1.GB.BC.oC (RN.o LZ) (RN.o Z) (RN.o Y) fh (TR.fn.onH LZ Z cz)) vz)
         (G1.GB.BC.oC W (RN.o Z) (RN.o Y) fh (G1.GB.BC.oC W (RN.o LZ) (RN.o Z) (TR.fn.onH LZ Z cz) vz)) kk
         (G1.GB.BC.oC-assoc W (RN.o LZ) (RN.o Z) (RN.o Y) fh (TR.fn.onH LZ Z cz) vz)
         (ap (RN.Hom1 W (RN.o Z)) (RN.Hom1 W (RN.o Y)) (\ w -> G1.GB.BC.oC W (RN.o Z) (RN.o Y) fh w)
            (G1.GB.BC.oC W (RN.o LZ) (RN.o Z) (TR.fn.onH LZ Z cz) vz) k TR.DS.Fact[Z, W, k].vp-eq)) ;
    module I = TR.DS.Ini[Y, LZ, W, c', vz, kk, ek] ;
    iL : G1.GB.Lands W (RN.o Y) s0.pQ kk = G1.GB.lands-pre W (RN.o Z) (RN.o Y) fh s0.pQ k i ;
    jz : G0.GB.Lands LZ Y s0.pQ c' = G0.GB.lands-pre LZ Z Y h s0.pQ cz i' ;
    uZ : EK0.TS.EI LZ = s0.pv LZ c' jz ;
    j2 : G0.GB.Lands LY Y s0.pQ (G0.GB.BC.oC LY LZ Y c' I.d) = G0.GB.lands-comp LY LZ Y s0.pQ c' I.d jz ;
    e1 : Id (EK0.TS.EI LY) (EK0.TS.E.act LY LZ I.d uZ) (K.P.u W kk iL) =
     trans (EK0.TS.EI LY) (EK0.TS.E.act LY LZ I.d uZ) (s0.pv LY (G0.GB.BC.oC LY LZ Y c' I.d) j2) (K.P.u W kk iL)
      (s0.pnat LY LZ I.d c' jz j2)
      (EK0.PT.pv-hom Y z0 s0 LY (G0.GB.BC.oC LY LZ Y c' I.d) (UX.cl Y W kk) I.eq1 j2 iL) ;
    xz : EK1.TS.EI (RN.o LZ) = EKm.XS[LZ, uZ].u1 ;
    r1 : Id (EK1.TS.EI W) (EK1.TS.E.act W (RN.o LZ) vz xz) (EK1.TS.E.act W (RN.o LY) vy (EK1.TS.E.act (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) xz)) =
     trans (EK1.TS.EI W) (EK1.TS.E.act W (RN.o LZ) vz xz)
       (EK1.TS.E.act W (RN.o LZ) (G1.GB.BC.oC W (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) vy) xz)
       (EK1.TS.E.act W (RN.o LY) vy (EK1.TS.E.act (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) xz))
      (ap (RN.Hom1 W (RN.o LZ)) (EK1.TS.EI W) (\ w -> EK1.TS.E.act W (RN.o LZ) w xz) vz
         (G1.GB.BC.oC W (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) vy) (symH I.eq2))
      (EK1.TS.E.act-o W (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) vy xz) ;
    r2 : Id (EK1.TS.EI (RN.o LY)) (EK1.TS.E.act (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) xz) (K.P.x W kk iL) =
     trans (EK1.TS.EI (RN.o LY)) (EK1.TS.E.act (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) xz) (EKm.XS[LY, EK0.TS.E.act LY LZ I.d uZ].u1) (K.P.x W kk iL)
      EKm.SN[LY, LZ, I.d, uZ].nat
      (ap (EK0.TS.EI LY) (EK1.TS.EI (RN.o LY)) (\ w -> EKm.XS[LY, w].u1) (EK0.TS.E.act LY LZ I.d uZ) (K.P.u W kk iL) e1) ;
    ev : Id (EK1.TS.EI W) (rs1.pv W k i) (K'.P.side.pv W k i') =
     symH (trans (EK1.TS.EI W) (EK1.TS.E.act W (RN.o LZ) vz xz) (EK1.TS.E.act W (RN.o LY) vy (EK1.TS.E.act (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) xz))
        (K.P.pv W kk iL) r1
        (ap (EK1.TS.EI (RN.o LY)) (EK1.TS.EI W) (\ w -> EK1.TS.E.act W (RN.o LY) vy w)
           (EK1.TS.E.act (RN.o LY) (RN.o LZ) (TR.fn.onH LY LZ I.d) xz) (K.P.x W kk iL) r2)) ;
   } ;
   T1 : Id (CK1.SE.TS.EI (RN.o Z)) (CK1.SE.TS.E.act (RN.o Z) (RN.o Y) fh K.t1) K'.t1 =
    trans (CK1.SE.TS.EI (RN.o Z)) (CK1.SE.TS.E.act (RN.o Z) (RN.o Y) fh K.t1)
      (CK1.SE.TS.pr (RN.o Z) (EK1.TV.E.act (RN.o Z) (RN.o Y) fh K.Z.z1) (c1.kop (RN.o Z) (EK1.TV.E.act (RN.o Z) (RN.o Y) fh K.Z.z1) rs1)) K'.t1
     (c1.kunif (RN.o Z) (RN.o Y) fh K.Z.z1 K.P.side)
     (kopExt (RN.o Z) (EK1.TV.E.act (RN.o Z) (RN.o Y) fh K.Z.z1) K'.Z.z1 EKm.ZN[Z, Y, h, z0].nat rs1 K'.P.side (refl rs1.pQ)
        (\ W k i i' -> EV[W, k, i, i'].ev)) ;
   lhs : CK0.SE.TS.EI Z = CK0.SE.TS.E.act Z Y h K.t0 ;
   Q2 : Id (Tot1 (RN.o Z)) (rd0 Z lhs) (rd0 Z K'.t0) =
    trans (Tot1 (RN.o Z)) (rd0 Z lhs) (SB1.TC.E.act (RN.o Z) (RN.o Y) fh (rd0 Y K.t0)) (rd0 Z K'.t0)
     (rdN0 Z Y h K.t0)
     (trans (Tot1 (RN.o Z)) (SB1.TC.E.act (RN.o Z) (RN.o Y) fh (rd0 Y K.t0)) (SB1.TC.E.act (RN.o Z) (RN.o Y) fh (rd1 (RN.o Y) K.t1)) (rd0 Z K'.t0)
        (ap (Tot1 (RN.o Y)) (Tot1 (RN.o Z)) (\ w -> SB1.TC.E.act (RN.o Z) (RN.o Y) fh w) (rd0 Y K.t0) (rd1 (RN.o Y) K.t1) K.rdEq)
        (trans (Tot1 (RN.o Z)) (SB1.TC.E.act (RN.o Z) (RN.o Y) fh (rd1 (RN.o Y) K.t1)) (rd1 (RN.o Z) K'.t1) (rd0 Z K'.t0)
           (trans (Tot1 (RN.o Z)) (SB1.TC.E.act (RN.o Z) (RN.o Y) fh (rd1 (RN.o Y) K.t1)) (rd1 (RN.o Z) (CK1.SE.TS.E.act (RN.o Z) (RN.o Y) fh K.t1)) (rd1 (RN.o Z) K'.t1)
              (symH (rdN1 (RN.o Z) (RN.o Y) fh K.t1))
              (ap (CK1.SE.TS.EI (RN.o Z)) (Tot1 (RN.o Z)) (rd1 (RN.o Z)) (CK1.SE.TS.E.act (RN.o Z) (RN.o Y) fh K.t1) K'.t1 T1))
           (symH K'.rdEq))) ;
   kunif : Id (CK0.SE.TS.EI Z) lhs K'.t0 =
    CK0.SE.mV-inj Z lhs K'.t0 (refl z0')
     (SB0.mV-inj Z (CK0.SE.mV Z lhs) (CK0.SE.mV Z K'.t0) (refl K'.Z.x0) Q2) ;
  } ;
 } ;
} ;
