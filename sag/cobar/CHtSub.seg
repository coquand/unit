-- CHtSub.seg (canonicity-45; COBAR.md "Prop 58"): a path homotopy H : f ~ g
-- of maps A -> B over a context G, pulled back along a context map s : D -> G,
-- is a path homotopy over D between the substituted maps (values: H's path at
-- (s d, a), coerced along s's naturality; equalities through the map of
-- totals (d, v) |-> (s d, v), injective over a fixed point).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module HS (D G : L.PCtx) (s : L.PSub[D, G]) (A B : L.PTy[G]) (f g : PB.CHtpyOps[a+].NMap[G, A, B])
  (H : L.PEl[L.extP G A, PB.CHtpyOps[a+].HT[G, A, B, f, g].PT.PathP]) {
 module HO = PB.CHtpyOps[a+] ;
 A' : L.PTy[D] = L.subTy D G A s ;
 B' : L.PTy[D] = L.subTy D G B s ;
 sub (u : HO.NMap[G, A, B]) : HO.NMap[D, A', B'] = new HO.NMap[D, A', B', \ I d a0 -> u.nfun I (s.nt I d) a0,
  \ J I h d d' e a0 -> u.nnat J I h (s.nt I d) (s.nt J d') (L.ntEq D G s J I h d d' e) a0] ;
 module T = HO.HT[G, A, B, f, g] ;
 module T' = HO.HT[D, A', B', sub f, sub g] ;
 module TB = PB.GPre[a+].TyL[G, B] ;
 module TB' = PB.GPre[a+].TyL[D, B'] ;
 sz (W : Ob) (z : V1.Ix (T'.GA.ob W)) : V1.Ix (T.GA.ob W) = (L.liftP D G A s).nt W z ;
 M (V : Ob) (q : TB'.EI V) : TB.EI V = TB.pr V (s.nt V q.1) q.2 ;
 Minj (V : Ob) (q q' : TB'.EI V) (P : Id (V1.Ix (D.ob V)) q.1 q'.1) (Q : Id (TB.EI V) (M V q) (M V q')) : Id (TB'.EI V) q q' =
  idJ (V1.Ix (D.ob V)) q.1 (\ d2 P2 -> (v2 : V1.Ix (B'.tob V d2)) -> Id (TB.EI V) (M V q) (M V (d2, v2)) -> Id (TB'.EI V) q (d2, v2))
   (\ v2 Q2 -> apH {V1.Ix (B'.tob V q.1)} {TB'.EI V} (\ v3 -> (q.1, v3)) (TB.pr-inj V (s.nt V q.1) q.2 v2 Q2)) q'.1 P q'.2 Q ;
 Mact (V' V : Ob) (g0 : Hom V' V) (q : TB'.EI V) : Id (TB.EI V') (M V' (TB'.E.act V' V g0 q)) (TB.E.act V' V g0 (M V q)) =
  symH (TB.pr-tact V' V g0 (s.nt V q.1) (s.nt V' (D.act V' V g0 q.1)) (L.ntEq D G s V' V g0 q.1 (D.act V' V g0 q.1) (refl (D.act V' V g0 q.1))) q.2) ;
 -- the values
 pvz (W : Ob) (z : V1.Ix (T'.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : TB.EI V = T.pv H W (sz W z) V k j ;
 pe (W : Ob) (z : V1.Ix (T'.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : Id (V1.Ix (G.ob V)) (TB.pr1 V (pvz W z V k j)) (s.nt V (D.act V W k z.1)) =
  transH ((H.eob W (sz W z)).2.1 V k j) (symH (s.nt-nat V W k z.1)) ;
 tv (W : Ob) (z : V1.Ix (T'.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : TB'.EI V =
  (D.act V W k z.1, TB.coeT V (TB.pr1 V (pvz W z V k j)) (s.nt V (D.act V W k z.1)) (pe W z V k j) (TB.pr2 V (pvz W z V k j))) ;
 Mtv (W : Ob) (z : V1.Ix (T'.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : Id (TB.EI V) (M V (tv W z V k j)) (pvz W z V k j) =
  symH (TB.pr-coe V (TB.pr1 V (pvz W z V k j)) (s.nt V (D.act V W k z.1)) (pe W z V k j) (TB.pr2 V (pvz W z V k j))) ;
 path (W : Ob) (z : V1.Ix (T'.GA.ob W)) : V1.Ix (T'.PT.tobP W z) =
  T'.PT.mkPath W z (tv W z)
   (\ V' V g0 k j -> Minj V' (TB'.E.act V' V g0 (tv W z V k j)) (tv W z V' (compH V' V W k g0) (compH V' V Iv j g0)) (symH (D.act-o V' V W k g0 z.1))
      (transH (Mact V' V g0 (tv W z V k j)) (transH (apH {TB.EI V} {TB.EI V'} (TB.E.act V' V g0) (Mtv W z V k j))
        (transH ((H.eob W (sz W z)).1.2 V' V g0 k j) (symH (Mtv W z V' (compH V' V W k g0) (compH V' V Iv j g0)))))))
   (\ V k j -> refl (D.act V W k z.1))
   (Minj W (tv W z W (idH W) (PB.ptH W PB.e0)) (T'.aE W z) (D.act-id W z.1) (transH (Mtv W z W (idH W) (PB.ptH W PB.e0)) (H.eob W (sz W z)).2.2.1))
   (Minj W (tv W z W (idH W) (PB.ptH W PB.e1)) (T'.bE W z) (D.act-id W z.1) (transH (Mtv W z W (idH W) (PB.ptH W PB.e1)) (H.eob W (sz W z)).2.2.2)) ;
 enat (J I : Ob) (h : Hom J I) (z : V1.Ix (T'.GA.ob I)) (z' : V1.Ix (T'.GA.ob J)) (ee : Id (V1.Ix (T'.GA.ob J)) (T'.GA.act J I h z) z')
  : Id (V1.Ix (T'.PT.tobP J z')) (T'.PT.PathP.tact J I h z z' ee (path I z)) (path J z') =
  T'.PT.path-eq J z' (T'.PT.PathP.tact J I h z z' ee (path I z)) (path J z') (\ V f i ->
   Minj V (tv I z V (compH V J I h f) i) (tv J z' V f i)
    (transH (D.act-o V J I h f z.1) (apH {V1.Ix (D.ob J)} {V1.Ix (D.ob V)} (D.act V J f) (apH {V1.Ix (T'.GA.ob J)} {V1.Ix (D.ob J)} (\ w -> w.1) ee)))
    (transH (Mtv I z V (compH V J I h f) i)
      (transH (T.pv-res H J I h (sz I z) (sz J z') (L.ntEq T'.GA T.GA (L.liftP D G A s) J I h z z' ee) V f i)
        (symH (Mtv J z' V f i))))) ;
 -- H pulled back along s
 res : L.PEl[T'.GA, T'.PT.PathP] = new L.PEl[T'.GA, T'.PT.PathP, path, enat] ;
} ;
