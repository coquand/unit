-- CLinePre.seg (canonicity-45; COBAR.md "Prop 58", 4e's ruling on code
-- paths): a global line of codes l : F1 -> t from a to b (CLineC) gives a
-- path homotopy at the total site between the precompositions yo(t) -> yo(F1)
-- with a and with b (maps of contexts read as types over the terminal
-- context): the value at h and (k, j) is (h restricted along k) . l(j).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module PL (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation)
  (ma : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mna : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (ma J)) (ma K))
  (mb : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mnb : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (mb J)) (mb K))
  (lc : (W : Ob) (j : Hom W Iv) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M W)
  (lcN : (V W : Ob) (g : Hom V W) (j : Hom W Iv) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M V)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res W V g (lc W j)) (lc V (compH V W Iv j g)))
  (lc0 : (W : Ob) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M W) (lc W (PB.ptH W PB.e0)) (ma W))
  (lc1 : (W : Ob) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M W) (lc W (PB.ptH W PB.e1)) (mb W)) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module CM = CC.CM ;
 module TR = CC.TR ;
 module G1 = TR.G1 ;
 module HO1 = G1.GB.CHtpyOps[a+] ;
 module CT = CTotCtxTy[a, a+, a+].CtxTy[CM.IC] ;
 module QT = CT.Of[CM.Yo[t].yoT] ;
 module Q1 = CT.Of[CM.Yo[CM.F1].yoT] ;
 module PA = CM.Pre[t, CM.F1, ma, mna] ;
 module PBb = CM.Pre[t, CM.F1, mb, mnb] ;
 mA : HO1.NMap[CT.P1, QT.Y1T, Q1.Y1T] = new HO1.NMap[CT.P1, QT.Y1T, Q1.Y1T, \ X o w -> PA.pre X.1 X.2 w, \ J I f x x' e w -> symH (PA.pre-nat J.1 I.1 f.1 J.2 I.2 f.2 w)] ;
 mB : HO1.NMap[CT.P1, QT.Y1T, Q1.Y1T] = new HO1.NMap[CT.P1, QT.Y1T, Q1.Y1T, \ X o w -> PBb.pre X.1 X.2 w, \ J I f x x' e w -> symH (PBb.pre-nat J.1 I.1 f.1 J.2 I.2 f.2 w)] ;
 module T = HO1.HT[CT.P1, QT.Y1T, Q1.Y1T, mA, mB] ;
 -- the value at h and (k, j): (h restricted along k) . l(j)
 vl (X : CT.TC.TOb) (z : V1.Ix (T.GA.ob X)) (V : CT.TC.TOb) (k : CT.TC.THm V X) (j : Hom V.1 Iv) : CM.MO.Fn[CM.F1, V.2].M V.1 =
  CM.CO.cmpM V.1 V.1 V.1 (idH V.1) V.2 t CM.F1 (lc V.1 j) (CM.Yo[t].yoa V.1 X.1 k.1 V.2 X.2 k.2 z.2) ;
 val (X : CT.TC.TOb) (z : V1.Ix (T.GA.ob X)) (V : CT.TC.TOb) (k : CT.TC.THm V X) (j : Hom V.1 Iv) : T.TB.EI V =
  T.TB.pr V (T.s X z V k j) (vl X z V k j) ;
 -- composition with a code then restriction along u
 module FF = CM.MO.Fn[CM.F1, t] ;
 cw (J : Ob) (y : SX.Over[R].Presentation) (f0 : FF.M J) (h : CM.MO.Fn[t, y].M J) : CM.MO.Fn[CM.F1, y].M J = CM.MO.Cmp[CM.F1, t, y, J, f0, h].cmp ;
 L1 (J I : Ob) (u : Hom J I) (y x : SX.Over[R].Presentation) (f : CM.MO.Fn[x, y].M J) (f0 : FF.M I) (h : CM.MO.Fn[t, x].M I)
  : Id (CM.MO.Fn[CM.F1, y].M J) (CM.Yo[CM.F1].yoa J I u y x f (CM.CO.cmpM I I I (idH I) x t CM.F1 f0 h))
       (cw J y (FF.res I J (compH J I I (idH I) u) f0) (CM.Yo[t].yoa J I u y x f h)) =
  apH {(w : Hom J I) * CM.MO.Fn[CM.F1, y].M J} {CM.MO.Fn[CM.F1, y].M J} (\ p -> p.2) (CM.CO.As[J, I, I, I, idH I, idH I, u, y, x, t, CM.F1, f0, h, f].law) ;
 -- the line's code restricted: res (lc I j) along (id . u) is res (lc J (j u)) along id
 L2 (J I : Ob) (u : Hom J I) (j : Hom I Iv)
  : Id (FF.M J) (FF.res I J (compH J I I (idH I) u) (lc I j)) (FF.res J J (idH J) (lc J (compH J I Iv j u))) =
  transH (lcN J I (compH J I I (idH I) u) j)
   (transH (apH {Hom J I} {FF.M J} (\ h -> lc J (compH J I Iv j h)) (comp-idl J I u))
     (transH (apH {Hom J Iv} {FF.M J} (lc J) (symH (comp-idr J Iv (compH J I Iv j u))))
       (symH (lcN J J (idH J) (compH J I Iv j u))))) ;
 -- naturality of the values along g : V' -> V
 vN (X : CT.TC.TOb) (z : V1.Ix (T.GA.ob X)) (V' V : CT.TC.TOb) (g : CT.TC.THm V' V) (k : CT.TC.THm V X) (j : Hom V.1 Iv)
  : Id (CM.MO.Fn[CM.F1, V'.2].M V'.1) (CM.Yo[CM.F1].yoa V'.1 V.1 g.1 V'.2 V.2 g.2 (vl X z V k j))
       (vl X z V' (CT.TC.TotCat.oC V' V X k g) (compH V'.1 V.1 Iv j g.1)) =
  transH (L1 V'.1 V.1 g.1 V'.2 V.2 g.2 (lc V.1 j) (CM.Yo[t].yoa V.1 X.1 k.1 V.2 X.2 k.2 z.2))
   (transH (apH {FF.M V'.1} {CM.MO.Fn[CM.F1, V'.2].M V'.1} (\ f0 -> cw V'.1 V'.2 f0 (CM.Yo[t].yoa V'.1 V.1 g.1 V'.2 V.2 g.2 (CM.Yo[t].yoa V.1 X.1 k.1 V.2 X.2 k.2 z.2)))
             (L2 V'.1 V.1 g.1 j))
     (apH {CM.MO.Fn[t, V'.2].M V'.1} {CM.MO.Fn[CM.F1, V'.2].M V'.1} (\ h' -> cw V'.1 V'.2 (FF.res V'.1 V'.1 (idH V'.1) (lc V'.1 (compH V'.1 V.1 Iv j g.1))) h')
       (symH (CM.Yo[t].yo-o V'.1 V.1 X.1 k.1 g.1 V'.2 V.2 X.2 k.2 g.2 z.2)))) ;
 -- totals over the terminal context: the point is irrelevant
 prE (X : CT.TC.TOb) (p p' : V1.Ix (CT.P1.ob X)) (v v' : CM.MO.Fn[CM.F1, X.2].M X.1) (q : Id (CM.MO.Fn[CM.F1, X.2].M X.1) v v')
  : Id (T.TB.EI X) (T.TB.pr X p v) (T.TB.pr X p' v') =
  transH (apH {V1.Ix (CT.P1.ob X)} {T.TB.EI X} (\ p2 -> T.TB.pr X p2 v) (isTop p p'))
   (apH {CM.MO.Fn[CM.F1, X.2].M X.1} {T.TB.EI X} (T.TB.pr X p') q) ;
 nat (X : CT.TC.TOb) (z : V1.Ix (T.GA.ob X)) (V' V : CT.TC.TOb) (g : CT.TC.THm V' V) (k : CT.TC.THm V X) (j : Hom V.1 Iv)
  : Id (T.TB.EI V') (T.TB.E.act V' V g (val X z V k j)) (val X z V' (CT.TC.TotCat.oC V' V X k g) (compH V'.1 V.1 Iv j g.1)) =
  transH (T.TB.pr-tact V' V g (T.s X z V k j) (CT.P1.act V' V g (T.s X z V k j)) (refl (CT.P1.act V' V g (T.s X z V k j))) (vl X z V k j))
   (prE V' (CT.P1.act V' V g (T.s X z V k j)) (T.s X z V' (CT.TC.TotCat.oC V' V X k g) (compH V'.1 V.1 Iv j g.1)) _ _ (vN X z V' V g k j)) ;
 e0 (X : CT.TC.TOb) (z : V1.Ix (T.GA.ob X)) : Id (T.TB.EI X) (val X z X (CT.TC.TotCat.idC X) (PB.ptH X.1 PB.e0)) (T.aE X z) =
  prE X (T.s X z X (CT.TC.TotCat.idC X) (PB.ptH X.1 PB.e0)) z.1 _ _
   (transH (apH {FF.M X.1} {CM.MO.Fn[CM.F1, X.2].M X.1} (\ f0 -> CM.CO.cmpM X.1 X.1 X.1 (idH X.1) X.2 t CM.F1 f0 (CM.Yo[t].yoa X.1 X.1 (CT.TC.TotCat.idC X).1 X.2 X.2 (CT.TC.TotCat.idC X).2 z.2)) (lc0 X.1))
     (apH {CM.MO.Fn[t, X.2].M X.1} {CM.MO.Fn[CM.F1, X.2].M X.1} (\ h -> CM.CO.cmpM X.1 X.1 X.1 (idH X.1) X.2 t CM.F1 (ma X.1) h) (CM.Yo[t].yo-id X.1 X.2 z.2))) ;
 e1 (X : CT.TC.TOb) (z : V1.Ix (T.GA.ob X)) : Id (T.TB.EI X) (val X z X (CT.TC.TotCat.idC X) (PB.ptH X.1 PB.e1)) (T.bE X z) =
  prE X (T.s X z X (CT.TC.TotCat.idC X) (PB.ptH X.1 PB.e1)) z.1 _ _
   (transH (apH {FF.M X.1} {CM.MO.Fn[CM.F1, X.2].M X.1} (\ f0 -> CM.CO.cmpM X.1 X.1 X.1 (idH X.1) X.2 t CM.F1 f0 (CM.Yo[t].yoa X.1 X.1 (CT.TC.TotCat.idC X).1 X.2 X.2 (CT.TC.TotCat.idC X).2 z.2)) (lc1 X.1))
     (apH {CM.MO.Fn[t, X.2].M X.1} {CM.MO.Fn[CM.F1, X.2].M X.1} (\ h -> CM.CO.cmpM X.1 X.1 X.1 (idH X.1) X.2 t CM.F1 (mb X.1) h) (CM.Yo[t].yo-id X.1 X.2 z.2))) ;
 path (X : CT.TC.TOb) (z : V1.Ix (T.GA.ob X)) : V1.Ix (T.PT.tobP X z) =
  T.PT.mkPath X z (val X z) (\ V' V g k j -> nat X z V' V g k j) (\ V k j -> refl (T.s X z V k j)) (e0 X z) (e1 X z) ;
 vR (J I : CT.TC.TOb) (h : CT.TC.THm J I) (z : V1.Ix (T.GA.ob I)) (V : CT.TC.TOb) (f : CT.TC.THm V J) (i : Hom V.1 Iv)
  : Id (T.TB.EI V) (val I z V (CT.TC.TotCat.oC V J I h f) i) (val J (T.GA.act J I h z) V f i) =
  prE V (T.s I z V (CT.TC.TotCat.oC V J I h f) i) (T.s J (T.GA.act J I h z) V f i) _ _
   (apH {CM.MO.Fn[t, V.2].M V.1} {CM.MO.Fn[CM.F1, V.2].M V.1} (\ h' -> CM.CO.cmpM V.1 V.1 V.1 (idH V.1) V.2 t CM.F1 (lc V.1 i) h')
     (CM.Yo[t].yo-o V.1 J.1 I.1 h.1 f.1 V.2 J.2 I.2 h.2 f.2 z.2)) ;
 enat (J I : CT.TC.TOb) (h : CT.TC.THm J I) (z : V1.Ix (T.GA.ob I)) (z' : V1.Ix (T.GA.ob J)) (ee : Id (V1.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
  : Id (V1.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z') =
  T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z') (\ V f i ->
   transH (vR J I h z V f i) (apH {V1.Ix (T.GA.ob J)} {T.TB.EI V} (\ z2 -> val J z2 V f i) ee)) ;
 -- pre_a ~ pre_b at the total site
 res : G1.GB.GPre[a+].PS.PEl[T.GA, T.PT.PathP] = new G1.GB.GPre[a+].PS.PEl[T.GA, T.PT.PathP, path, enat] ;
} ;
