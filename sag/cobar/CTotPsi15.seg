-- CTotPsi15.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 15: a line of D G is recovered from Psi.
-- For a total map f : W -> X, an interval point j at W and an index q' of
-- W: the reading of ln at (f, j) at q' is the value of psi at the moved
-- index at (id, j restricted).  (CTotPsi8's ext, the reading's
-- naturality along the identity with its tail moved, fn.onId, RE.ret.)
-- Generic in the context G.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi15 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) {
 module P8 = CTotPsi8[a, vl, l].Psi8[C, G] ;
 module P3 = CTotPsi3[a, vl, l].Psi3[C, G] ;
 module P2 = P3.P2 ;
 module PO = P3.PO ;
 module TR = PO.TR ;
 module G0 = TR.G0 ;
 module TC = PO.TC ;
 module VT = PO.VT ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module XB = P3.XB ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;

 module Rec (X : TC.TOb) (ln : W0.Ix (PO.FL.ob X)) (W : TC.TOb) (f : TC.THm W X) (n : Nat) (J : Ob) (u' : Hom J W.1) (z : Obj J)
   (c' : CT.Ch J n (C.res J W.1 u' W.2) z) (i : Wt.Pn n J) (j : PB.IvP W.1) {
  module XL = P8.XL[X, ln, W, f, n, J, u', z, c', i, j] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  U0 : Hom J I = XL.U0 ;
  cc : CT.Ch J n (C.res J I U0 x) z = XL.cc ;
  j0 : PB.IvP J = XL.j0 ;
  module Q = P2.PQ[X, ln, n, J, U0, z, cc, i] ;
  Y : Ob0 = (J, z) ;
  id0 : TR.RN.Hom0 Y Y = G0.GB.BC.idC Y ;
  e' : Id (Obj J) (C.res J J (idH J) z) z = symH id0.2 ;
  U1 : Hom J I = compH J J I U0 (idH J) ;
  cc1 : CT.Ch J n (C.res J I U1 x) (C.res J J (idH J) z) = DO.rCh J J I (idH J) U0 x n z cc ;
  R1 : Wt.Pn n J = Wt.Res[n, J, J, idH J, i].res ;
  module N = PO.PL[X, ln].NC[n, J, z, U0, cc, i, j0, J, idH J] ;
  -- the reading along the identity, tail moved
  natT (y : Obj J) (e2 : Id (Obj J) (C.res J J (idH J) z) y)
   : Id (W0.Ix (G.ob J y)) (G.act J J (idH J) y z (VT.trD J J (idH J) (C.res J J (idH J) z) y e2 z (C.cart J J (idH J) z)) (PO.PL[X, ln].rdC n J z U0 cc i j0))
       (PO.PL[X, ln].rdC n J y U1 (subst (Obj J) (\ t -> CT.Ch J n (C.res J I U1 x) t) (C.res J J (idH J) z) y e2 cc1) R1 (PB.ivA J J (idH J) j0)) =
   idJ (Obj J) (C.res J J (idH J) z)
    (\ y2 e3 -> Id (W0.Ix (G.ob J y2)) (G.act J J (idH J) y2 z (VT.trD J J (idH J) (C.res J J (idH J) z) y2 e3 z (C.cart J J (idH J) z)) (PO.PL[X, ln].rdC n J z U0 cc i j0))
       (PO.PL[X, ln].rdC n J y2 U1 (subst (Obj J) (\ t -> CT.Ch J n (C.res J I U1 x) t) (C.res J J (idH J) z) y2 e3 cc1) R1 (PB.ivA J J (idH J) j0)))
    N.nat y e2 ;
  a1 : Id (W0.Ix (G.ob J z)) (PO.GP.act Y Y (TR.fn.onH Y Y id0) (PO.PL[X, ln].rdC n J z U0 cc i j0)) (PO.PL[X, ln].rdC n J z U0 cc i j0) =
   transH (apH {TC.THm Y Y} {W0.Ix (G.ob J z)} (\ k -> PO.GP.act Y Y k (PO.PL[X, ln].rdC n J z U0 cc i j0)) (TR.fn.onId Y))
    (PO.GP.act-id Y (PO.PL[X, ln].rdC n J z U0 cc i j0)) ;
  b1 : Id (W0.Ix (G.ob J z)) (Q.vg J (idH J) z e' j0)
         (PO.PL[X, ln].rdC n J z U1 (Q.cT J (idH J) z e') R1 (PB.ivA J J (idH J) j0)) =
   apH {PB.IvP J} {W0.Ix (G.ob J z)} (\ jj -> PO.PL[X, ln].rdC n J z U1 (Q.cT J (idH J) z e') R1 jj) (symH (PB.ivA-id J j0)) ;
  -- the value of psi at the identity
  b2 : Id (W0.Ix (G.ob J z)) (Q.psiq.1 Y (TC.tid Y) j0) (Q.vg J (idH J) z e' j0) =
   transH (apH {TC.THm Y Y} {W0.Ix (G.ob J z)} (\ k -> Q.psiq.1 Y k j0) (symH (TR.fn.onId Y)))
    XB.RE[Y, Q.L0, Y, id0, j0].ret ;
  law : Id (W0.Ix (G.ob J z)) ((ln.1 W f j).1 (n, J, u', z, c', i.1) i.2) (Q.psiq.1 Y (TC.tid Y) j0) =
   transH (symH XL.ext)
    (transH (symH a1)
      (transH (natT z e')
        (transH (symH b1) (symH b2)))) ;
 } ;
} ;
