-- CAxKer.seg (canonicity-c2; the axioms' statements, duality: kernel).
-- For u (k coefficients, n points, equations q_1..q_m; a metatheory schema),
-- over Pr_u.(c : Delta(Exp_n) -> G).(d : Delta N).(h : ev_u (d, c) = 0):
--     || Sigma (a : Delta(N x Exp_n) -> G). Sigma (e : Delta N).
--          trunc_d c = Sum_i (trunc_e a_i) * q_i ||
-- in G[X] as coefficient vectors: trunc_d c (gamma) = c gamma if |gamma| <= d
-- and 0 otherwise; a_i = a (i, -) are the cofactors, all of degree bound e;
-- the product with q_i is the convolution (b * q)(gamma) = Sum_{al <= gamma}
-- b(al) q^(gamma - al), q^(beta) the coefficient of x^beta in q_i, a term in
-- the k coefficients (CAxPoly.coef); the sum and the product are G's, at each
-- metatheory gamma, packed over Delta(Exp_n) (CAxPack) and Delta N.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module KerOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (addV mulV : (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X)
  (addN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (addV I u v)) (addV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (mulN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (mulV I u v)) (mulV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (cV : R.R -> (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X)
  (cN : (r : R.R) (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (cV r I)) (cV r J))
  (k n : Nat) {
 module SU = CAxSurj[a].SurjOf[R, encK, pe, addV, mulV, addN, mulN, cV, cN, k, n] ;
 module PJ = SU.PJ ;
 module S = SU.S ;
 module PW = S.PW ;
 C : CwF.CwF[a++] = S.C ;
 module OV = S.OV ;
 Nl : C.Ctx = S.Nl ;
 Pr : C.Ctx = S.Pr ;
 Eqs : U a = PJ.Eqs ;
 GA (E : C.Ctx) : C.Ty E = SU.GA E ;
 module Main (qs : Eqs) {
  module DL = CAxDelta[a].DeltaOf[R, encK, pe] ;
  module MN = CAxMon[a].MonOf[R, n] ;
  module PL = CAxPoly[a].PolyOf[R, k, n] ;
  open PL.RL ;
  module EO = CAxElOps[a].ElOps[R, encK, pe, addV, mulV, addN, mulN, cV, cN] ;
  module E1 = CAxEv[a].EvG[R, encK, pe].Of[addV, mulV, addN, mulN, cV, cN] ;
  module LN = PW.G1.FT.GCConstLam[a+].LamOf[DL.CY.cylG, V1.natV] ;
  module PX = CAxPack[a].PackOf[R, encK, pe, MN.ExpV n] ;
  CmV : V1.V = V1.SigV V1.natV (\ _ -> MN.ExpV n) ;
  module PM = CAxPack[a].PackOf[R, encK, pe, CmV] ;
  unIx : (j : Nat) -> V1.Ix (MN.ExpV j) -> MN.Exp j = split { zero -> \ x -> tt ; suc j | r -> \ x -> (r x.1, x.2) } ;
  -- coefficient vectors, and cofactor vectors
  Cf (E : C.Ctx) : C.Ty E = OV.Fun E (PX.DX E) (GA E) ;
  Cm (E : C.Ctx) : C.Ty E = OV.Fun E (PM.DX E) (GA E) ;
  dSub (E Z : C.Ctx) (s : C.Sub E Z) (D0 : C.Ty Nl) : Id (C.Ty E) (C.subT E Z (C.subT Z Nl D0 (C.eps Z)) s) (C.subT E Nl D0 (C.eps E)) =
   transH (symH (C.subT-o E Z Nl D0 (C.eps Z) s))
    (apH {C.Sub E Nl} {C.Ty E} (\ t -> C.subT E Nl D0 t) (transH (C.eps-uniq E (C.o E Z Nl (C.eps Z) s)) (symH (C.eps-uniq E (C.eps E))))) ;
  cfSub (E Z : C.Ctx) (s : C.Sub E Z) : Id (C.Ty E) (C.subT E Z (Cf Z) s) (Cf E) =
   OV.Fun-ov E Z (PX.DX Z) (GA Z) s (PX.DX E) (dSub E Z s PX.D0) (GA E) (SU.gatSub E Z s) ;
  cmSub (E Z : C.Ctx) (s : C.Sub E Z) : Id (C.Ty E) (C.subT E Z (Cm Z) s) (Cm E) =
   OV.Fun-ov E Z (PM.DX Z) (GA Z) s (PM.DX E) (dSub E Z s PM.D0) (GA E) (SU.gatSub E Z s) ;
  -- the hypotheses: c, d, h
  ExpG : C.Ty Pr = S.Exp PW.GTy qs ;
  Gc : C.Ctx = C.ext Pr (Cf Pr) ;
  p2 : C.Sub Gc Pr = C.p Pr (Cf Pr) ;
  cF : C.El Gc (Cf Gc) = OV.trE Gc (C.subT Gc Pr (Cf Pr) p2) (Cf Gc) (cfSub Gc Pr p2) (C.q Pr (Cf Pr)) ;
  module AC = SU.At[Gc, p2, qs] ;
  prSc : C.Sub AC.Sc Gc = C.o AC.Sc AC.Xn Gc (AC.prX n) AC.prS ;
  rho : MN.Var -> C.El AC.Sc (GA AC.Sc) = split {
   inl al -> SU.gs AC.Sc Gc prSc (OV.app Gc (PX.DX Gc) (GA Gc) cF (PX.cX Gc (MN.expIx n al))) ;
   inr i -> SU.gs AC.Sc AC.Xn AC.prS (AC.xv n i) } ;
  T : C.Ty Gc = C.subT Gc Pr ExpG p2 ;
  evd (dv : Nat) : C.El Gc T = OV.trE Gc (PJ.PiSp Gc p2 qs (GA AC.Sc)) T (symH AC.stab) (AC.lamSp (EO.evA MN.Var AC.Sc rho (MN.poly dv))) ;
  zT : C.El Gc T = OV.trE Gc (PJ.PiSp Gc p2 qs (GA AC.Sc)) T (symH AC.stab) (AC.lamSp (EO.cstE AC.Sc R.z)) ;
  Gd : C.Ctx = C.ext Gc (DL.DN Gc) ;
  pd : C.Sub Gd Gc = C.p Gc (DL.DN Gc) ;
  Td : C.Ty Gd = C.subT Gd Gc T pd ;
  evE : C.El Gd Td = LN.packN Gc T.1 evd ;
  Hk : C.Ctx = C.ext Gd (S.IdT Gd Td evE (C.subt Gd Gc T zT pd)) ;
  -- a coefficient vector from a metatheory family of elements of G
  upX (E : C.Ctx) (e : V1.Ix (MN.ExpV n)) (g : C.El E (GA E)) : C.El E (C.subT E (PX.GX E) (OV.wkT E (PX.DX E) (GA E)) (PX.sX E e)) =
   OV.trE E (GA E) (C.subT E (PX.GX E) (OV.wkT E (PX.DX E) (GA E)) (PX.sX E e)) (symH (CConstLam[a, a+].PST[C].pst E (PX.DX E) (GA E) (PX.cX E e))) g ;
  vecOf (E : C.Ctx) (f : MN.Exp n -> C.El E (GA E)) : C.El E (Cf E) =
   OV.lam E (PX.DX E) (OV.wkT E (PX.DX E) (GA E)) (PX.Pack[E, OV.wkT E (PX.DX E) (GA E), \ e -> upX E e (f (unIx n e))].res) ;
  zeroE (E : C.Ctx) : C.El E (GA E) = EO.cstE E R.z ;
  ifE (E : C.Ctx) (x y : C.El E (GA E)) : Bool -> C.El E (GA E) = split { true -> x ; false -> y } ;
  -- trunc_dv c
  trunc (E : C.Ctx) (c : C.El E (Cf E)) (dv : Nat) : C.El E (Cf E) =
   vecOf E (\ g -> ifE E (OV.app E (PX.DX E) (GA E) c (PX.cX E (MN.expIx n g))) (zeroE E) (leb (MN.deg n g) dv)) ;
  -- the left side, packed over d
  Lp : C.El Gd (C.subT Gd Gc (Cf Gc) pd) = LN.packN Gc (Cf Gc).1 (trunc Gc cF) ;
  -- the cofactors a, then e
  Ha : C.Ctx = C.ext Hk (Cm Hk) ;
  pa : C.Sub Ha Hk = C.p Hk (Cm Hk) ;
  aF : C.El Ha (Cm Ha) = OV.trE Ha (C.subT Ha Hk (Cm Hk) pa) (Cm Ha) (cmSub Ha Hk pa) (C.q Hk (Cm Hk)) ;
  sHa : C.Sub Ha Pr = C.o Ha Gc Pr p2 (C.o Ha Gd Gc pd (C.o Ha Hk Gd (C.p Gd (S.IdT Gd Td evE (C.subt Gd Gc T zT pd))) pa)) ;
  coefQ (q : S.Term) (b : MN.Exp n) : C.El Ha (GA Ha) = SU.gs Ha Pr sHa (E1.evE k (PL.coef q b)) ;
  aAt (i : Nat) (al : MN.Exp n) : C.El Ha (GA Ha) = OV.app Ha (PM.DX Ha) (GA Ha) aF (PM.cX Ha (i, MN.expIx n al)) ;
  nAt (ev : Nat) (i : Nat) (al : MN.Exp n) : C.El Ha (GA Ha) = ifE Ha (aAt i al) (zeroE Ha) (leb (MN.deg n al) ev) ;
  convL (ev : Nat) (i : Nat) (q : S.Term) (g : MN.Exp n) : List (MN.Exp n) -> C.El Ha (GA Ha) = split {
   nil -> zeroE Ha ;
   cons al als | r -> EO.AE.opE Ha (EO.ME.opE Ha (nAt ev i al) (coefQ q (PL.subX n g al))) r } ;
  sumQ (ev : Nat) (g : MN.Exp n) : Eqs -> Nat -> C.El Ha (GA Ha) = split {
   nil -> \ i -> zeroE Ha ;
   cons q qs2 | r -> \ i -> EO.AE.opE Ha (convL ev i q g (PL.below n g)) (r (suc i)) } ;
  rAt (ev : Nat) : C.El Ha (Cf Ha) = vecOf Ha (\ g -> sumQ ev g qs zero) ;
  -- the degree bound e, the two sides, and the statement
  He : C.Ctx = C.ext Ha (DL.DN Ha) ;
  pe' : C.Sub He Ha = C.p Ha (DL.DN Ha) ;
  Rp : C.El He (Cf He) = OV.trE He (C.subT He Ha (Cf Ha) pe') (Cf He) (cfSub He Ha pe') (LN.packN Ha (Cf Ha).1 rAt) ;
  sg : C.Sub He Gd = C.o He Hk Gd (C.p Gd (S.IdT Gd Td evE (C.subt Gd Gc T zT pd))) (C.o He Ha Hk pa pe') ;
  Lq : C.El He (Cf He) =
   OV.trE He (C.subT He Gd (C.subT Gd Gc (Cf Gc) pd) sg) (Cf He)
    (transH (symH (C.subT-o He Gd Gc (Cf Gc) pd sg)) (cfSub He Gc (C.o He Gd Gc pd sg)))
    (C.subt He Gd (C.subT Gd Gc (Cf Gc) pd) Lp sg) ;
  Eq : C.Ty He = S.IdT He (Cf He) Lq Rp ;
  P : C.Ty Hk = PJ.NO.Tr Hk (PW.G1.fibSig-T.Sig Hk (Cm Hk) (PW.G1.fibSig-T.Sig Ha (DL.DN Ha) Eq)) ;
 } ;
} ;
