-- CTotPsi5.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for lines
-- at the total site, part 5: the top face equation of Psi (topP) and Psi
-- as a D-element of lines (PsiL).  At the top face weight Psi is the
-- vertical action of the line of G along the dropped map: compared on
-- levelwise restrictions (rho-inj); the D-element's top equation and the
-- drop of a restricted chain on one side, the factorisation of the
-- composite through a cartesian lift (rmap-eq) and the extended line's
-- naturality on the other.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;

module Psi5 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) {
 module P4 = CTotPsi4[a, vl, l].Psi4[C, G] ;
 module P3 = P4.P3 ;
 module P2 = P3.P2 ;
 module PO = P3.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module VT = PO.VT ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module XB = P3.XB ;
 module DL = P3.DL ;
 module FG1 = P3.FG1 ;
 module TP0 = CTPsh[a, vl, l].TPshOf[C] ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;

 module PT (X : TC.TOb) (ln : W0.Ix (PO.FL.ob X)) {
  module PN = P3.PN[X, ln] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module TT (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : CT.Ch J (suc n) (C.res J I u x) z) (i : Wt.Pn n J) {
   module K = CT.KJ[J].K ;
   rux : Obj J = C.res J I u x ;
   DD : K.DR n rux z = K.drop n rux z c ;
   z' : Obj J = DD.1 ;
   c' : CT.Ch J n rux z' = DD.2.1 ;
   g : VT.VMap J z z' = DD.2.2 ;
   hr : Tr.IsT (Tr.leb (suc n) (suc n)) = Tr.leb-refl (suc n) ;
   ft : Wt.Pn (suc n) J = Wt.Face[n, J, suc n, hr].Of[i].face ;
   module QA = P2.PQ[X, ln, suc n, J, u, z, c, ft] ;
   module QB = P2.PQ[X, ln, n, J, u, z', c', i] ;
   Y : Ob0 = (J, z) ;
   Y' : Ob0 = (J, z') ;
   gv : TC.THm Y Y' = (idH J, g) ;
   actB : W0.Ix (XB.RH.F1.ob (TR.RN.o Y)) = FG1.actF Y Y' gv QB.psiq ;
   module V0 (W1 : Ob) (v : Hom W1 J) (j : PB.IvP W1) {
    rz : Obj W1 = C.res W1 J v z ;
    rz' : Obj W1 = C.res W1 J v z' ;
    uv : Hom W1 I = compH W1 J I u v ;
    ry : Obj W1 = C.res W1 I uv x ;
    Ri : Wt.Pn n W1 = Wt.Res[n, W1, J, v, i].res ;
    rg : VT.VMap W1 rz rz' = VT.rmap W1 J v z z' g ;
    inner : W0.Ix (G.ob W1 rz') = PO.PL[X, ln].rdC n W1 rz' uv (DO.rCh W1 J I v u x n z' c') Ri j ;
    Bval : W0.Ix (G.ob W1 rz) = G.act W1 W1 (idH W1) rz rz' rg inner ;
    -- the extended line along the composite
    m : TC.THm (W1, rz) (W1, rz') = (idH W1, rg) ;
    kc : TC.THm (W1, rz') Y' = (v, C.cart W1 J v z') ;
    kL : TC.THm (W1, rz) Y' = TC.tcomp (W1, rz) Y Y' gv (v, C.cart W1 J v z) ;
    kR : TC.THm (W1, rz) Y' = TC.tcomp (W1, rz) (W1, rz') Y' kc m ;
    l1 : Id (W0.Ix (G.ob W1 rz)) (QB.psiq.1 (W1, rz) kL j) (QB.psiq.1 (W1, rz) kR j) =
     apH {TC.THm (W1, rz) Y'} {W0.Ix (G.ob W1 rz)} (\ kk -> QB.psiq.1 (W1, rz) kk j) (symH (VT.rmap-eq W1 J v z z' g)) ;
    l2 : Id (W0.Ix (G.ob W1 rz)) (QB.psiq.1 (W1, rz) kR j) (QB.psiq.1 (W1, rz) kR (PB.ivA W1 W1 (idH W1) j)) =
     apH {PB.IvP W1} {W0.Ix (G.ob W1 rz)} (\ jj -> QB.psiq.1 (W1, rz) kR jj) (symH (PB.ivA-id W1 j)) ;
    l3 : Id (W0.Ix (G.ob W1 rz)) (QB.psiq.1 (W1, rz) kR (PB.ivA W1 W1 (idH W1) j)) (G.act W1 W1 (idH W1) rz rz' rg (QB.psiq.1 (W1, rz') kc j)) =
     symH (QB.psiq.2 (W1, rz) (W1, rz') m kc j) ;
    l4 : Id (W0.Ix (G.ob W1 rz')) (QB.psiq.1 (W1, rz') kc j) inner = XB.RE[Y', QB.L0, (W1, rz'), (v, refl rz'), j].ret ;
    lhs : Id (W0.Ix (G.ob W1 rz)) (actB.1 (W1, rz) (v, C.cart W1 J v z) j) Bval =
     transH l1 (transH l2 (transH l3
       (apH {W0.Ix (G.ob W1 rz')} {W0.Ix (G.ob W1 rz)} (\ q -> G.act W1 W1 (idH W1) rz rz' rg q) l4))) ;
    -- the levelwise line at the top face weight
    module A1 = PO.PL[X, ln].RC[suc n, W1, rz, uv, DO.rCh W1 J I v u x (suc n) z c, Wt.Res[suc n, W1, J, v, ft].res, j] ;
    t : W0.Ix (PO.DG.ob A1.Xv) = A1.t ;
    rr : Obj W1 = C.res W1 W1 (idH W1) ry ;
    qh : Id (Obj W1) ry rr = symH (C.res-id W1 ry) ;
    pq : Id (Obj W1) (C.res W1 J v rux) ry = symH (C.res-comp W1 J I u v x) ;
    module CF = CChainsF[vl].CF[VT.VCat J, VT.VCat W1, VT.rfun W1 J v] ;
    dropR : Id (CT.KJ[W1].K.DR n ry rz) (CT.KJ[W1].K.drop n ry rz (DO.rCh W1 J I v u x (suc n) z c))
              (rz', DO.rCh W1 J I v u x n z' c', rg) =
     transH (CT.trCh-drop W1 n (C.res W1 J v rux) ry pq rz (CF.chF (suc n) rux z c))
      (apH {CT.KJ[W1].K.DR n (C.res W1 J v rux) rz} {CT.KJ[W1].K.DR n ry rz}
         (\ E2 -> (E2.1, CT.trCh W1 n (C.res W1 J v rux) ry pq E2.1 E2.2.1, E2.2.2)) (symH (CF.chF-drop n rux z c))) ;
    DDP : Id (CT.KJ[W1].K.DR n rr rz) (CT.KJ[W1].K.drop n rr rz A1.CA.ch)
            (rz', CT.trCh W1 n ry rr qh rz' (DO.rCh W1 J I v u x n z' c'), rg) =
     transH (CT.trCh-drop W1 n ry rr qh rz (DO.rCh W1 J I v u x (suc n) z c))
      (apH {CT.KJ[W1].K.DR n ry rz} {CT.KJ[W1].K.DR n rr rz} (\ E2 -> (E2.1, CT.trCh W1 n ry rr qh E2.1 E2.2.1, E2.2.2)) dropR) ;
    rhs : Id (W0.Ix (G.ob W1 rz)) (QA.vg W1 v rz (refl rz) j) Bval =
     transH (apH {Wt.Pn (suc n) W1} {W0.Ix (G.ob W1 rz)} (\ p -> t.1 (suc n, W1, idH W1, rz, A1.CA.ch, p.1) p.2)
               (Wt.RF[n, J, W1, v, suc n, hr, i].resFace))
      (transH (t.2.2.2 (n, W1, idH W1, rz, A1.CA.ch, Ri.1) Ri.2)
        (apH {CT.KJ[W1].K.DR n rr rz} {W0.Ix (G.ob W1 rz)}
           (\ E2 -> TP0.vertAct G W1 rz E2.1 E2.2.2 (t.1 (n, W1, idH W1, E2.1, E2.2.1, Ri.1) Ri.2)) DDP)) ;
    base : Id (W0.Ix (G.ob W1 rz)) (actB.1 (W1, rz) (TR.fn.onH (W1, rz) Y (v, refl rz)) j) (QA.vg W1 v rz (refl rz) j) =
     transH lhs (symH rhs) ;
    gen (y : Obj W1) (e' : Id (Obj W1) rz y)
     : Id (W0.Ix (G.ob W1 y)) (actB.1 (W1, y) (TR.fn.onH (W1, y) Y (v, symH e')) j) (QA.vg W1 v y e' j) =
     idJ (Obj W1) rz (\ y2 e2 -> Id (W0.Ix (G.ob W1 y2)) (actB.1 (W1, y2) (TR.fn.onH (W1, y2) Y (v, symH e2)) j) (QA.vg W1 v y2 e2 j))
      base y e' ;
    genE (y : Obj W1) (e : Id (Obj W1) y rz)
     : Id (W0.Ix (G.ob W1 y)) (actB.1 (W1, y) (TR.fn.onH (W1, y) Y (v, e)) j) (QA.vg W1 v y (symH e) j) =
     transH (apH {Id (Obj W1) y rz} {W0.Ix (G.ob W1 y)} (\ ee -> actB.1 (W1, y) (TR.fn.onH (W1, y) Y (v, ee)) j)
               (CT.setObj W1 y rz e (symH (symH e))))
      (gen y (symH e)) ;
   } ;
   law : Id (W0.Ix (XB.RH.F1.ob (TR.RN.o Y))) QA.psiq actB =
    XB.rho-inj Y QA.psiq actB
     (transH (XB.rho-ext Y QA.L0)
        (XB.RH.F0.fam-eq Y QA.L0 (XB.RH.rhoV Y actB) (\ W h j -> symH (V0[W.1, h.1, j].genE W.2 h.2)))) ;
  } ;
  topP : W0.Ix (DL.topEq I x PN.tP) = \ r lq ->
   TT[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (r.2.2.2.2.2, lq)].law ;
  PsiL : DL.Ob' I x = (PN.tP, PN.natP, P4.PF[X, ln].faceP, topP) ;
 } ;
} ;
