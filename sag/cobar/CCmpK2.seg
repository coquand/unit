-- CCmpK2.seg (canonicity-c2; (K) for cmpI, part 2): over nil.HTT (a pair
-- g = (g1, g2) of homs F1 -> y) the generator values a_i = g_i (cls x),
-- by the generic evaluation maps (CUG13 at s := F1, H := HTT).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module K2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K1m = CCmpK1[a].K1[R, encK, pe, y] ;
 module CI = CPreI[a].PreOf[R, encK, pe].CmpI[y] ;
 module CM = K1m.CM ;
 F1 : SX.Over[R].Presentation = CM.F1 ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = CI.HT ;
 HTT : C.Ty Nl = CI.HTT ;
 DT : C.Ctx = C.ext Nl HT ;
 Ga : C.Ctx = C.ext Nl HTT ;
 gA (K : Ob) (w : V1.Ix (Ga.ob K)) : V1.Ix (HT.1.tob K w.1) = w.2.1 ;
 gB (K : Ob) (w : V1.Ix (Ga.ob K)) : V1.Ix (HT.1.tob K w.1) = w.2.2 ;
 gAN (J I : Ob) (f : Hom J I) (w : V1.Ix (Ga.ob I)) : Id (V1.Ix (HT.1.tob J w.1)) (HT.1.tact J I f w.1 w.1 (refl w.1) (gA I w)) (gA J (Ga.act J I f w)) =
  refl (HT.1.tact J I f w.1 w.1 (refl w.1) (gA I w)) ;
 gBN (J I : Ob) (f : Hom J I) (w : V1.Ix (Ga.ob I)) : Id (V1.Ix (HT.1.tob J w.1)) (HT.1.tact J I f w.1 w.1 (refl w.1) (gB I w)) (gB J (Ga.act J I f w)) =
  L.tact-irr Nl HT.1 J I f w.1 w.1 (refl w.1)
   (L.ntEq DT Nl (L.pP Nl HT.1) J I f (w.1, w.2.1) (Nl.act J I f w.1, HT.1.tact J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1)
      (L.pair-act Nl HT.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1))
   w.2.2 ;
 module EvM = CUG13[a].UG13[R, encK, pe, F1, y, HTT, gA, gB, gAN, gBN] ;
 module AF1 = CHomT3[a].HomP[R, encK, pe].Alg[F1] ;
 cx : C.El Nl AF1.Qt = AF1.AX.cls (var (inr tt)) ;
 a1 : C.El Ga EvM.QYh = EvM.ZA.apC cx ;
 a2 : C.El Ga EvM.QYh = EvM.ZB.apC cx ;
} ;
