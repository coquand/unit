-- CTruncPushAlg.seg (canonicity-c2; SIMPLIFIED.md item 1): a seeded
-- extension operation on P (SAG's "proposition": given an element,
-- extend any partial element) gives one on the pushforward s_* P.
--
-- Informal text.  A partial element S of s_* P at (X , x) is projected
-- at every h : W -> X and point d of D above x.h to a partial element
-- of P at (W , d): at k : W' -> W in the restricted cofibration it is
-- S's family at (h k), read at (W' , id , d.k) (PS.side).  The
-- extension of S with seed u is, at (W , h , d), P's extension of the
-- projected side with seed u W h d.  It is natural, restricts to S on
-- the cofibration and is uniform, each by the same property of P's
-- operation and the equality of the projected sides (same cofibration
-- by pre-comp, same values by S's naturality).
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ;

module PushOp (D G : PCtx) (s : PSub[D, G]) (P : PTy[D]) {
  module Pu = CTruncPush[a, l].Push[D, G, s, P] ;
  module TG = PR.TyL[G, Pu.pushTy] ;
  module TD = PR.TyL[D, P] ;
  module PPg = CP.Partials[G, Pu.pushTy] ;
  module PPd = CP.Partials[D, P] ;

  -- a total of s_* P read at a point of D above its point
  rdT (X : Ob) (t : TG.EI X) (dd : Pu.DP X) (ee : Pu.Ov X t.1 X (idH X) dd) : TD.EI X =
    TD.pr X dd (t.2.1 X (idH X) dd ee) ;
  rdT-eq (X : Ob) (t t' : TG.EI X) (p : Id (TG.EI X) t t') (dd dd' : Pu.DP X) (q : Id (Pu.DP X) dd dd')
    (ee : Pu.Ov X t.1 X (idH X) dd) (ee' : Pu.Ov X t'.1 X (idH X) dd')
    : Id (TD.EI X) (rdT X t dd ee) (rdT X t' dd' ee') =
    idJ (TG.EI X) t
      (\ t2 p2 -> (dd2 : Pu.DP X) (q2 : Id (Pu.DP X) dd dd2) (ee2 : Pu.Ov X t2.1 X (idH X) dd2) -> Id (TD.EI X) (rdT X t dd ee) (rdT X t2 dd2 ee2))
      (\ dd2 q2 -> idJ (Pu.DP X) dd
         (\ dd3 q3 -> (ee3 : Pu.Ov X t.1 X (idH X) dd3) -> Id (TD.EI X) (rdT X t dd ee) (rdT X t dd3 ee3))
         (\ ee3 -> apH (\ z -> TD.pr X dd (t.2.1 X (idH X) dd z))
                    (W.isSetIx (G.ob X) (s.nt X dd) (G.act X X (idH X) t.1) ee ee3))
         dd2 q2)
      t' p dd' q ee' ;

  -- the projected side
  module PS (X : Ob) (x : Pu.GP X) (S : PPg.Side[X, x]) (Y : Ob) (h : Hom Y X) (d : Pu.DP Y) (e : Pu.Ov X x Y h d) {
    QY : PB.Phi Y = PB.pre Y X h S.pQ ;
    li (Z : Ob) (k : Hom Z Y) (i : PB.Lands Z Y QY k) : PB.Lands Z X S.pQ (compH Z Y X h k) = PB.lands-pre Z Y X h S.pQ k i ;
    eR (Z : Ob) (k : Hom Z Y) (i : PB.Lands Z Y QY k)
      : Pu.Ov Z (S.pv Z (compH Z Y X h k) (li Z k i)).1 Z (idH Z) (D.act Z Y k d) =
      transH (Pu.ovK X x Z Y k h d e)
        (transH (symH (S.ppt Z (compH Z Y X h k) (li Z k i)))
          (symH (G.act-id Z (S.pv Z (compH Z Y X h k) (li Z k i)).1))) ;
    pv' (Z : Ob) (k : Hom Z Y) (i : PB.Lands Z Y QY k) : TD.EI Z =
      rdT Z (S.pv Z (compH Z Y X h k) (li Z k i)) (D.act Z Y k d) (eR Z k i) ;
    ppt' : PPd.PptTy Y d QY pv' = \ Z k i -> refl (D.act Z Y k d) ;
    module Pn (Z2 Z1 : Ob) (chi : Hom Z2 Z1) (k : Hom Z1 Y) (i : PB.Lands Z1 Y QY k) (i' : PB.Lands Z2 Y QY (compH Z2 Z1 Y k chi)) {
      t1 : TG.EI Z1 = S.pv Z1 (compH Z1 Y X h k) (li Z1 k i) ;
      d1 : Pu.DP Z1 = D.act Z1 Y k d ;
      d2 : Pu.DP Z2 = D.act Z2 Z1 chi d1 ;
      -- the restricted total, read at d2
      t1r : TG.EI Z2 = TG.E.act Z2 Z1 chi t1 ;
      er : Pu.Ov Z2 t1r.1 Z2 (idH Z2) d2 =
        transH (Pu.ovK Z1 t1.1 Z2 Z1 chi (idH Z1) d1 (eR Z1 k i))
          (transH (apH (\ f -> G.act Z2 Z1 f t1.1) (comp-idl Z2 Z1 chi)) (symH (G.act-id Z2 t1r.1))) ;
      a1 : Id (TD.EI Z2) (TD.E.act Z2 Z1 chi (pv' Z1 k i)) (rdT Z2 t1r d2 er) =
        transH (TD.pr-tact Z2 Z1 chi d1 d2 (refl d2) (t1.2.1 Z1 (idH Z1) d1 (eR Z1 k i)))
          (apH (TD.pr Z2 d2)
            (transH (t1.2.2 Z2 Z1 chi (idH Z1) d1 (eR Z1 k i))
              (Pu.ov-irr Z1 t1.1 t1.2.1 Z2 (compH Z2 Z1 Z1 (idH Z1) chi) (compH Z2 Z2 Z1 chi (idH Z2))
                 (transH (comp-idl Z2 Z1 chi) (symH (comp-idr Z2 Z1 chi))) d2
                 (Pu.ovK Z1 t1.1 Z2 Z1 chi (idH Z1) d1 (eR Z1 k i))
                 (Pu.Res[Z2, Z1, chi, t1.1, t1r.1, refl t1r.1, t1.2].eC Z2 (idH Z2) d2 er)))) ;
      tp : Id (TG.EI Z2) t1r (S.pv Z2 (compH Z2 Y X h (compH Z2 Z1 Y k chi)) (li Z2 (compH Z2 Z1 Y k chi) i')) =
        transH (S.pnat Z2 Z1 chi (compH Z1 Y X h k) (li Z1 k i) (PB.lands-comp Z2 Z1 X S.pQ (compH Z1 Y X h k) chi (li Z1 k i)))
          (PPg.pv-hom X x S Z2 (compH Z2 Z1 X (compH Z1 Y X h k) chi) (compH Z2 Y X h (compH Z2 Z1 Y k chi))
             (comp-assoc Z2 Z1 Y X h k chi)
             (PB.lands-comp Z2 Z1 X S.pQ (compH Z1 Y X h k) chi (li Z1 k i))
             (li Z2 (compH Z2 Z1 Y k chi) i')) ;
      res : Id (TD.EI Z2) (TD.E.act Z2 Z1 chi (pv' Z1 k i)) (pv' Z2 (compH Z2 Z1 Y k chi) i') =
        transH a1 (rdT-eq Z2 t1r (S.pv Z2 (compH Z2 Y X h (compH Z2 Z1 Y k chi)) (li Z2 (compH Z2 Z1 Y k chi) i')) tp
                     d2 (D.act Z2 Y (compH Z2 Z1 Y k chi) d) (symH (D.act-o Z2 Z1 Y k chi d)) er (eR Z2 (compH Z2 Z1 Y k chi) i')) ;
    } ;
    pnat' : PPd.PnTy Y QY pv' = \ Z2 Z1 chi k i i' -> Pn[Z2, Z1, chi, k, i, i'].res ;
    side : PPd.Side[Y, d] = PPd.mkSide Y d QY pv' ppt' pnat' ;
  } ;

  ------------------------------------------------------------------
  -- the operation on s_* P

  module Op (kP : CTruncSeededBack[a, l].Seeded[D, P].Op) {
    module LP = CTruncSeededBack[a, l].Seeded[D, P].Laws[kP] ;

    module KX (X : Ob) (x : Pu.GP X) (u : Pu.El X x) (S : PPg.Side[X, x]) {
      fam : Pu.Fam X x = \ Y h d e -> kP.kop Y d (u.1 Y h d e) PS[X, x, S, Y, h, d, e].side ;
      module Nt (Z Y : Ob) (k : Hom Z Y) (h : Hom Y X) (d : Pu.DP Y) (e : Pu.Ov X x Y h d) {
        module S1 = PS[X, x, S, Y, h, d, e] ;
        d' : Pu.DP Z = D.act Z Y k d ;
        e' : Pu.Ov X x Z (compH Z Y X h k) d' = Pu.ovK X x Z Y k h d e ;
        module S2 = PS[X, x, S, Z, compH Z Y X h k, d', e'] ;
        seed : W.Ix (P.tob Y d) = u.1 Y h d e ;
        sides : Id (PPd.Side[Z, d']) (PPd.rside Z Y k d S1.side) S2.side =
          PPd.side-ext Z d' (PPd.rside Z Y k d S1.side) S2.side (PB.pre-comp Z Y X k h S.pQ)
            (\ Vb g i i' -> rdT-eq Vb
               (S.pv Vb (compH Vb Y X h (compH Vb Z Y k g)) (S1.li Vb (compH Vb Z Y k g) (PB.lands-pre Vb Z Y k S1.QY g i)))
               (S.pv Vb (compH Vb Z X (compH Z Y X h k) g) (S2.li Vb g i'))
               (PPg.pv-hom X x S Vb (compH Vb Y X h (compH Vb Z Y k g)) (compH Vb Z X (compH Z Y X h k) g)
                  (symH (comp-assoc Vb Z Y X h k g))
                  (S1.li Vb (compH Vb Z Y k g) (PB.lands-pre Vb Z Y k S1.QY g i)) (S2.li Vb g i'))
               (D.act Vb Y (compH Vb Z Y k g) d) (D.act Vb Z g d') (D.act-o Vb Z Y k g d)
               (S1.eR Vb (compH Vb Z Y k g) (PB.lands-pre Vb Z Y k S1.QY g i)) (S2.eR Vb g i')) ;
        tot : Id (TD.EI Z) (TD.pr Z d' (P.tact Z Y k d d' (refl d') (kP.kop Y d seed S1.side)))
                (TD.pr Z d' (kP.kop Z d' (u.1 Z (compH Z Y X h k) d' e') S2.side)) =
          transH (symH (TD.pr-tact Z Y k d d' (refl d') (kP.kop Y d seed S1.side)))
            (transH (kP.kunif Z Y k d seed S1.side)
              (LP.cong Z d' d' (refl d') (P.tact Z Y k d d' (refl d') seed) (u.1 Z (compH Z Y X h k) d' e')
                 (apH (TD.pr Z d') (u.2 Z Y k h d e))
                 (PPd.rside Z Y k d S1.side) S2.side sides)) ;
        res : Id (W.Ix (P.tob Z d')) (P.tact Z Y k d d' (refl d') (fam Y h d e)) (fam Z (compH Z Y X h k) d' e') =
          TD.pr-inj Z d' _ _ tot ;
      } ;
      nat : Pu.NatF X x fam = \ Z Y k h d e -> Nt[Z, Y, k, h, d, e].res ;
      val : Pu.El X x = (fam, nat) ;
    } ;
    kop (X : Ob) (x : Pu.GP X) (u : Pu.El X x) (S : PPg.Side[X, x]) : Pu.El X x = KX[X, x, u, S].val ;

    -- totals of s_* P with equal points and equal values are equal
    ptot-eq (X : Ob) (g g' : Pu.GP X) (p : Id (Pu.GP X) g g') (phi : Pu.El X g) (phi' : Pu.El X g')
      (H : (Y : Ob) (h : Hom Y X) (d : Pu.DP Y) (e : Pu.Ov X g Y h d) (e' : Pu.Ov X g' Y h d)
           -> Id (W.Ix (P.tob Y d)) (phi.1 Y h d e) (phi'.1 Y h d e'))
      : Id (TG.EI X) (TG.pr X g phi) (TG.pr X g' phi') =
      idJ (Pu.GP X) g
        (\ g2 p2 -> (phi2 : Pu.El X g2)
           -> ((Y : Ob) (h : Hom Y X) (d : Pu.DP Y) (e : Pu.Ov X g Y h d) (e2 : Pu.Ov X g2 Y h d) -> Id (W.Ix (P.tob Y d)) (phi.1 Y h d e) (phi2.1 Y h d e2))
           -> Id (TG.EI X) (TG.pr X g phi) (TG.pr X g2 phi2))
        (\ phi2 H2 -> apH (TG.pr X g) (Pu.push-eq X g phi phi2 (\ Y h d e -> H2 Y h d e e)))
        g' p phi' H ;

    -- uniformity
    module Un (Y X : Ob) (h0 : Hom Y X) (x : Pu.GP X) (u : Pu.El X x) (S : PPg.Side[X, x]) {
      y : Pu.GP Y = G.act Y X h0 x ;
      uY : Pu.El Y y = Pu.tact Y X h0 x y (refl y) u ;
      SY : PPg.Side[Y, y] = PPg.rside Y X h0 x S ;
      lhsF : Pu.El Y y = Pu.tact Y X h0 x y (refl y) (kop X x u S) ;
      rhsF : Pu.El Y y = kop Y y uY SY ;
      module At (Vb : Ob) (h : Hom Vb Y) (d : Pu.DP Vb) (e : Pu.Ov Y y Vb h d) {
        eC : Pu.Ov X x Vb (compH Vb Y X h0 h) d = Pu.Res[Y, X, h0, x, y, refl y, u].eC Vb h d e ;
        module S1 = PS[X, x, S, Vb, compH Vb Y X h0 h, d, eC] ;
        module S2 = PS[Y, y, SY, Vb, h, d, e] ;
        sides : Id (PPd.Side[Vb, d]) S1.side S2.side =
          PPd.side-ext Vb d S1.side S2.side (symH (PB.pre-comp Vb Y X h h0 S.pQ))
            (\ Z g i i' -> rdT-eq Z
               (S.pv Z (compH Z Vb X (compH Vb Y X h0 h) g) (S1.li Z g i))
               (SY.pv Z (compH Z Vb Y h g) (S2.li Z g i'))
               (PPg.pv-hom X x S Z (compH Z Vb X (compH Vb Y X h0 h) g) (compH Z Y X h0 (compH Z Vb Y h g))
                  (comp-assoc Z Vb Y X h0 h g) (S1.li Z g i)
                  (PB.lands-pre Z Y X h0 S.pQ (compH Z Vb Y h g) (S2.li Z g i')))
               (D.act Z Vb g d) (D.act Z Vb g d) (refl (D.act Z Vb g d)) (S1.eR Z g i) (S2.eR Z g i')) ;
        res : Id (W.Ix (P.tob Vb d)) (lhsF.1 Vb h d e) (rhsF.1 Vb h d e) =
          apH (\ sd -> kP.kop Vb d (u.1 Vb (compH Vb Y X h0 h) d eC) sd) sides ;
      } ;
      res : Id (TG.EI Y) (TG.E.act Y X h0 (TG.pr X x (kop X x u S))) (TG.pr Y y rhsF) =
        transH (TG.pr-tact Y X h0 x y (refl y) (kop X x u S))
          (apH (TG.pr Y y) (Pu.push-eq Y y lhsF rhsF (\ Vb h d e -> At[Vb, h, d, e].res))) ;
    } ;

    -- on the cofibration the extension is the partial element
    module Sd (X : Ob) (x : Pu.GP X) (u : Pu.El X x) (S : PPg.Side[X, x]) (Y : Ob) (h0 : Hom Y X) (i : PB.Lands Y X S.pQ h0) {
      y : Pu.GP Y = G.act Y X h0 x ;
      t0 : TG.EI Y = S.pv Y h0 i ;
      lhsF : Pu.El Y y = Pu.tact Y X h0 x y (refl y) (kop X x u S) ;
      module At (Vb : Ob) (h : Hom Vb Y) (d : Pu.DP Vb) (e : Pu.Ov Y y Vb h d) (e' : Pu.Ov Y t0.1 Vb h d) {
        eC : Pu.Ov X x Vb (compH Vb Y X h0 h) d = Pu.Res[Y, X, h0, x, y, refl y, u].eC Vb h d e ;
        module S1 = PS[X, x, S, Vb, compH Vb Y X h0 h, d, eC] ;
        i2 : PB.Lands Vb X S.pQ (compH Vb Y X h0 h) = PB.lands-comp Vb Y X S.pQ h0 h i ;
        iV : PB.Lands Vb Vb S1.QY (idH Vb) =
          PB.pre-lands Vb Vb X (compH Vb Y X h0 h) S.pQ (idH Vb)
            (PB.lands-eq Vb X S.pQ (compH Vb Y X h0 h) (compH Vb Vb X (compH Vb Y X h0 h) (idH Vb))
               (symH (comp-idr Vb X (compH Vb Y X h0 h))) i2) ;
        kv : W.Ix (P.tob Vb d) = kP.kop Vb d (u.1 Vb (compH Vb Y X h0 h) d eC) S1.side ;
        tr : TG.EI Vb = TG.E.act Vb Y h t0 ;
        ee0 : Pu.Ov Vb tr.1 Vb (idH Vb) d = transH e' (symH (G.act-id Vb tr.1)) ;
        c1 : Id (TD.EI Vb) (TD.pr Vb d kv) (S1.pv' Vb (idH Vb) iV) =
          transH (symH (TD.E.act-id Vb (TD.pr Vb d kv))) (kP.kside Vb d (u.1 Vb (compH Vb Y X h0 h) d eC) S1.side Vb (idH Vb) iV) ;
        tp : Id (TG.EI Vb) (S.pv Vb (compH Vb Vb X (compH Vb Y X h0 h) (idH Vb)) (S1.li Vb (idH Vb) iV)) tr =
          transH (PPg.pv-hom X x S Vb (compH Vb Vb X (compH Vb Y X h0 h) (idH Vb)) (compH Vb Y X h0 h)
                    (comp-idr Vb X (compH Vb Y X h0 h)) (S1.li Vb (idH Vb) iV) i2)
            (symH (S.pnat Vb Y h h0 i i2)) ;
        c2 : Id (TD.EI Vb) (S1.pv' Vb (idH Vb) iV) (rdT Vb tr d ee0) =
          rdT-eq Vb (S.pv Vb (compH Vb Vb X (compH Vb Y X h0 h) (idH Vb)) (S1.li Vb (idH Vb) iV)) tr tp
            (D.act Vb Vb (idH Vb) d) d (D.act-id Vb d) (S1.eR Vb (idH Vb) iV) ee0 ;
        c3 : Id (TD.EI Vb) (rdT Vb tr d ee0) (TD.pr Vb d (t0.2.1 Vb h d e')) =
          apH (TD.pr Vb d)
            (Pu.ov-irr Y t0.1 t0.2.1 Vb (compH Vb Vb Y h (idH Vb)) h (comp-idr Vb Y h) d
               (Pu.Res[Vb, Y, h, t0.1, tr.1, refl tr.1, t0.2].eC Vb (idH Vb) d ee0) e') ;
        res : Id (W.Ix (P.tob Vb d)) (lhsF.1 Vb h d e) (t0.2.1 Vb h d e') =
          TD.pr-inj Vb d _ _ (transH c1 (transH c2 c3)) ;
      } ;
      res : Id (TG.EI Y) (TG.E.act Y X h0 (TG.pr X x (kop X x u S))) t0 =
        transH (TG.pr-tact Y X h0 x y (refl y) (kop X x u S))
          (ptot-eq Y y t0.1 (symH (S.ppt Y h0 i)) lhsF t0.2 (\ Vb h d e e' -> At[Vb, h, d, e, e'].res)) ;
    } ;

    op : CTruncSeededBack[a, l].Seeded[G, Pu.pushTy].Op =
      new CTruncSeededBack[a, l].Seeded[G, Pu.pushTy].Op[kop,
        \ X x u S Y h0 i -> Sd[X, x, u, S, Y, h0, i].res,
        \ Y X h0 x u S -> Un[Y, X, h0, x, u, S].res] ;
  } ;
} ;

-- in the algebra form used by the truncation's recursor
module PushAlg (D G : PCtx) (s : PSub[D, G]) (P : PTy[D]) (kP : CTruncSeededBack[a, l].Seeded[D, P].Op) {
  module PO = PushOp[D, G, s, P] ;
  algebra : CTruncAlg[a, l].Algebras[G, PO.Pu.pushTy].Algebra =
    CTruncSeededBack[a, l].Seeded[G, PO.Pu.pushTy].Algebra[PO.Op[kP].op].algebra ;
} ;
