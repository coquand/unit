-- CDEv1.seg (canonicity-c2; (d), part 1): over D1 = nil.HomT(s, y) (any
-- presentation s, variable z), the valuation of z at the generators of s as
-- a substitution into nil.Q_y^n (CEvT), ev_t at it, and z at classes.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module DE1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) {
 module SO1 = CSolT[a].SolOf[R, encK, pe, s, (zero, nil), y] ;
 module S2 = CSolT[a].SolOf2[R, encK, pe, s, (zero, nil), y] ;
 module EV = SO1.EV ;
 module HZ = CHomT3[a].HomP[R, encK, pe].Hom[s, y] ;
 module BZ = HZ.B0 ;
 Nl : C.Ctx = C.nil ;
 n : Nat = s.1 ;
 HS : C.Ty Nl = HZ.HomT ;
 QY : C.Ty Nl = SO1.Qy ;
 QA : C.Ty Nl = HZ.AS.Qt ;
 D1 : C.Ctx = C.ext Nl HS ;
 QYd : C.Ty D1 = OV.wkT Nl HS QY ;
 -- the valuation
 vT (K : Ob) : (o : Top) -> V1.Ix (HS.1.tob K o) -> V1.Ix ((EV.Gk n).ob K) = split { tt -> \ z -> SO1.tup n K (SO1.hval K z) } ;
 vNat (Lo K : Ob) (g : Hom Lo K) : (o : Top) (z : V1.Ix (HS.1.tob K o))
   -> Id (V1.Ix ((EV.Gk n).ob Lo)) (vT Lo o (HS.1.tact Lo K g o o (refl o) z)) ((EV.Gk n).act Lo K g (vT K o z)) = split {
  tt -> \ z -> symH (transH (SO1.tupNat n K Lo g (SO1.hval K z))
     (apH {SX.Fin n -> EV.QK Lo} {V1.Ix ((EV.Gk n).ob Lo)} (\ ff -> SO1.tup n Lo ff)
        (funext (SX.Fin n) (\ i -> EV.QK Lo) (\ i -> SO1.rsQ K Lo g (SO1.hval K z i)) (SO1.hval Lo (S2.tactH K Lo g z)) (S2.hvalNat K Lo g z)))) } ;
 sv : C.Sub D1 (EV.Gk n) = new L.PSub[D1, EV.Gk n, \ K w -> vT K w.1 w.2, \ J I f w -> vNat J I f w.1 w.2] ;
 PQ : Id (C.Ty D1) (C.subT D1 (EV.Gk n) (EV.Qk n) sv) QYd =
  transH (symH (C.subT-o D1 (EV.Gk n) Nl QY (C.eps (EV.Gk n)) sv))
   (apH {C.Sub D1 Nl} {C.Ty D1} (\ t -> C.subT D1 Nl QY t) (transH (C.eps-uniq D1 (C.o D1 (EV.Gk n) Nl (C.eps (EV.Gk n)) sv)) (symH (C.eps-uniq D1 (C.p Nl HS))))) ;
 evT (t : SX.Over[R].Expr (SX.Fin n)) : C.El D1 QYd = OV.trE D1 (C.subT D1 (EV.Gk n) (EV.Qk n) sv) QYd PQ (C.subt D1 (EV.Gk n) (EV.Qk n) (EV.evE n t) sv) ;
 QK (K : Ob) (w : V1.Ix (D1.ob K)) : U a+ = V1.Ix (QY.1.tob K w.1) ;
 evTr (t : SX.Over[R].Expr (SX.Fin n)) (K : Ob) (z : V1.Ix (HS.1.tob K tt)) : Id (QK K (tt, z)) ((evT t).eob K (tt, z)) (EV.ev n t K (vT K tt z)) =
  transH (CAppRd[a].trE-rd D1 (C.subT D1 (EV.Gk n) (EV.Qk n) sv) QYd PQ (C.subt D1 (EV.Gk n) (EV.Qk n) (EV.evE n t) sv) K (tt, z))
   (CAppRd[a].same-rd D1 (C.subT D1 (EV.Gk n) (EV.Qk n) sv) QYd PQ K (tt, z) (refl (QYd.1.tob K (tt, z))) (EV.ev n t K (vT K tt z))) ;
 -- lookups in a tuple
 lkTT (k : Nat) (K : Ob) (g : SX.Fin (suc k) -> EV.QK K) : (u : Top) -> Id (EV.QK K) (g (inr tt)) (g (inr u)) = split { tt -> refl (g (inr tt)) } ;
 lkTup : (k : Nat) (i : SX.Fin k) (K : Ob) (g : SX.Fin k -> EV.QK K) -> Id (EV.QK K) (EV.lk k i K (SO1.tup k K g)) (g i) = split {
  zero -> \ i K g -> absurd (Id (EV.QK K) (EV.lk zero i K (SO1.tup zero K g)) (g i)) i ;
  suc k | r -> split {
   inl v -> \ K g -> r v K (\ v2 -> g (inl v2)) ;
   inr u -> \ K g -> lkTT k K g u } } ;
 -- z at closed classes (CUG13 at H := HomT(s, y))
 pk (K : Ob) (w : V1.Ix (D1.ob K)) : V1.Ix (HS.1.tob K w.1) = w.2 ;
 module U13m = CUG13[a].UG13[R, encK, pe, s, y, HS, pk, pk, \ J I f w -> refl (HS.1.tact J I f w.1 w.1 (refl w.1) w.2), \ J I f w -> refl (HS.1.tact J I f w.1 w.1 (refl w.1) w.2)] ;
 apZ (c : C.El Nl QA) : C.El D1 QYd = U13m.ZA.apC c ;
 -- the variable case
 rwId (G : C.Ctx) (T : C.Ty G) (x x' y y' : C.El G T)
  (px : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (x.eob K w) (x'.eob K w))
  (py : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (y.eob K w) (y'.eob K w))
  (p : C.El G (IJ.IdT G T x y)) : C.El G (IJ.IdT G T x' y') = CCmpU14[a].rwId G T x x' y y' px py p ;
 vrd (i : SX.Fin n) (K : Ob) : (o : Top) (z : V1.Ix (HS.1.tob K o)) -> Id (QK K (o, z)) ((apZ (HZ.AS.AX.cls (var i))).eob K (o, z)) ((evT (var i)).eob K (o, z)) = split {
  tt -> \ z -> transH (U13m.ZA.rdF (HZ.AS.AX.cls (var i)) K (tt, z)) (symH (transH (evTr (var i) K z) (lkTup n i K (SO1.hval K z)))) } ;
 hVar (i : SX.Fin n) : C.El D1 (IJ.IdT D1 QYd (apZ (HZ.AS.AX.cls (var i))) (evT (var i))) =
  rwId D1 QYd (apZ (HZ.AS.AX.cls (var i))) (apZ (HZ.AS.AX.cls (var i))) (apZ (HZ.AS.AX.cls (var i))) (evT (var i))
   (\ K w -> refl ((apZ (HZ.AS.AX.cls (var i))).eob K w)) (\ K w -> vrd i K w.1 w.2) (IJ.rfl D1 QYd (apZ (HZ.AS.AX.cls (var i)))) ;
} ;
