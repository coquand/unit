-- CGRing.seg (canonicity-45; COBAR.md "Prop 58"): G's operations with their
-- paths (CCmpY5.Ops2), tau's compatibility with + and x (CCmpY6), and E1 at
-- every copy (CE1Done), with no assumed inputs: al / eqal / commH from
-- CAlEq (c2's (K) for pairs).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module GR (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module AE (y : SX.Over[R].Presentation) { module A = CAlEq[a].AE[R, encK, pe, y] ; } ;
 al (y : SX.Over[R].Presentation) : PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1] = AE[y].A.al ;
 module GO = CCmpY5[a].Ops2[R, encK, pe, al, \ y -> AE[y].A.eqal, \ y -> AE[y].A.commH] ;
 module C6 = CCmpY6[a].Cp6[R, encK, pe, al, \ y -> AE[y].A.eqal, \ y -> AE[y].A.commH] ;
 module E1 (y' : SX.Over[R].Presentation) {
  module D = CE1Done[a].D[R, encK, pe, al, \ y -> AE[y].A.eqal, \ y -> AE[y].A.commH, y'] ;
  -- G's evaluation of every term is homotopic to tau' of its evaluation in Q_y'
  e1 : (k : Nat) (t : SX.Over[R].Expr (SX.Fin k))
   -> L.PEl[L.extP D.FI.Nl (D.PR.H.AL.Pm k), D.FI.HO.HT[D.FI.Nl, D.PR.H.AL.Pm k, D.FI.E.Tc, D.PR.H.AL.evGt k t, D.FI.HO.compN D.FI.Nl (D.PR.H.AL.Pm k) D.FI.E.Qc D.FI.E.Tc (D.PR.H.AL.evA k t) D.PR.H.tau'].PT.PathP] = D.E1 ;
 } ;
 addCompat : C6.PS1.PEl[C6.AddC.HC.GA, C6.AddC.HC.PT.PathP] = C6.addCompat ;
 mulCompat : C6.PS1.PEl[C6.MulC.HC.GA, C6.MulC.HC.PT.PathP] = C6.mulCompat ;
} ;
