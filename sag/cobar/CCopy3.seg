-- CCopy3.seg (canonicity-45; SIMPLIFIED.md step 6): an equivalence
-- structure on the levelwise site G0 from one on each copy of the poset
-- site, for C with constant objects.  For a G0 map of types f : B -> A
-- over G and y a presentation: the restriction (to the copy y) of the G0
-- homotopy fibre of f maps to the poset homotopy fibre of the restricted f
-- (ta: the path restricted along u |-> (u, refl)); it is cartesian (the
-- way back extends a poset path by transport along the presentation
-- equation of a G0 map); so each copy's equivalence structure moves to a
-- contraction of the restricted G0 fibre (CCart.moveContr), and these
-- assemble (CCopy2) into the G0 equivalence structure.
-- Specific to this C (constant objects).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module EqC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (G : CCopy[a].ConcC[R, encK, pe].P0.PCtx) (B A : CCopy[a].ConcC[R, encK, pe].P0.PTy[G])
  (f : CCopy[a].ConcC[R, encK, pe].G0.GB.CPartial[a+].PMap[G, B, A]) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module G0 = CC.G0 ;
 module H0 = G0.GB.CEquiv[a+].HFib[G, B, A, f] ;
 module Y (y : SX.Over[R].Presentation) {
  module Cy = CC.Copy[y] ;
  Gy : L.PCtx = Cy.rCy G ;
  By : L.PTy[Gy] = Cy.rTy G B ;
  Ay : L.PTy[Gy] = Cy.rTy G A ;
  fy : PB.CPartial[a+].PMap[Gy, By, Ay] = Cy.rMy G B A f ;
  module Hy = PB.CEquiv[a+].HFib[Gy, By, Ay, fy] ;
  A' : L.PTy[Cy.rCy H0.EA] = Cy.rTy H0.EA H0.FibT ;
  module TA' = PB.GPre[a+].TyL[Cy.rCy H0.EA, A'] ;
  -- a G0 fibre element restricted to the copy
  ta (I : Ob) (v : TA'.EI I) : Hy.TF.EI I =
   Hy.mkFib I (TA'.pr1 I v) (TA'.pr2 I v).1 (\ J u i -> H0.fibL (Cy.o0 I) v (Cy.o0 J) (Cy.h0 J I u) i)
    (\ V J g u i -> H0.fibL-nat (Cy.o0 I) v (Cy.o0 V) (Cy.o0 J) (Cy.h0 V J g) (Cy.h0 J I u) i)
    (\ J u i -> H0.fibL-pt (Cy.o0 I) v (Cy.o0 J) (Cy.h0 J I u) i)
    (H0.fibL-0 (Cy.o0 I) v) (H0.fibL-1 (Cy.o0 I) v) ;
  tanat (V W : Ob) (g : Hom V W) (v : TA'.EI W) : Id (Hy.TF.EI V) (Hy.TF.E.act V W g (ta W v)) (ta V (TA'.E.act V W g v)) =
   Hy.fibE-eq V (Hy.TF.E.act V W g (ta W v)) (ta V (TA'.E.act V W g v)) (refl (Hy.TF.pr1 V (Hy.TF.E.act V W g (ta W v))))
    (transH (Hy.fibB-act V W g (ta W v)) (symH (H0.fibB-act (Cy.o0 V) (Cy.o0 W) (Cy.h0 V W g) v)))
    (\ Z h i -> refl (H0.fibL (Cy.o0 W) v (Cy.o0 Z) (Cy.h0 Z W (compH Z V W g h)) i)) ;
  ObjT (J : Ob) : U a+ = V1.Ix (CC.CM.IC.obD J) ;
  module Inj (I : Ob) (v v' : TA'.EI I) (Pe : Id (V1.Ix ((Cy.rCy H0.EA).ob I)) (TA'.pr1 I v) (TA'.pr1 I v')) (Q : Id (Hy.TF.EI I) (ta I v) (ta I v')) {
   module LV (W : G0.TOb) (k : G0.THm W (Cy.o0 I)) (i : PB.IvP W.1) {
    Mot (y2 : ObjT W.1) (q : Id (ObjT W.1) y y2) : U a++ =
     Id (H0.TA.EI (W.1, y2)) (H0.fibL (Cy.o0 I) v (W.1, y2) (k.1, symH q) i) (H0.fibL (Cy.o0 I) v' (W.1, y2) (k.1, symH q) i) ;
    base : Mot y (refl y) = apH {Hy.TF.EI I} {H0.TA.EI (Cy.o0 W.1)} (\ T -> Hy.fibL I T W.1 k.1 i) Q ;
    gen : Mot W.2 (symH k.2) = idJ (ObjT W.1) y Mot base W.2 (symH k.2) ;
    ss : Id (Id (ObjT W.1) W.2 y) (symH (symH k.2)) k.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 y (symH (symH k.2)) k.2 ;
    law : Id (H0.TA.EI W) (H0.fibL (Cy.o0 I) v W k i) (H0.fibL (Cy.o0 I) v' W k i) =
     subst (Id (ObjT W.1) W.2 y) (\ e2 -> Id (H0.TA.EI W) (H0.fibL (Cy.o0 I) v W (k.1, e2) i) (H0.fibL (Cy.o0 I) v' W (k.1, e2) i))
      (symH (symH k.2)) k.2 ss gen ;
   } ;
   law : Id (TA'.EI I) v v' =
    H0.fibE-eq (Cy.o0 I) v v' Pe (apH {Hy.TF.EI I} {Hy.TB.EI I} (Hy.fibB I) Q) (\ W k i -> LV[W, k, i].law) ;
  } ;
  module BK (I : Ob) (w : V1.Ix ((Cy.rCy H0.EA).ob I)) (u0 : V1.Ix (Hy.FibT.tob I w)) {
   vy : Hy.TF.EI I = Hy.TF.pr I w u0 ;
   tv (W : G0.TOb) (k : G0.THm W (Cy.o0 I)) (i : PB.IvP W.1) : H0.TA.EI W =
    subst (ObjT W.1) (\ y2 -> H0.TA.EI (W.1, y2)) y W.2 (symH k.2) (Hy.fibL I vy W.1 k.1 i) ;
   -- the base condition, by induction on the presentation equation
   module TP (W : G0.TOb) (k : G0.THm W (Cy.o0 I)) (i : PB.IvP W.1) {
    Mot (y2 : ObjT W.1) (q : Id (ObjT W.1) y y2) : U a++ =
     Id (V1.Ix (G.ob (W.1, y2))) (H0.TA.pr1 (W.1, y2) (tv (W.1, y2) (k.1, symH q) i)) (G.act (W.1, y2) (Cy.o0 I) (k.1, symH q) (H0.TA.pr1 (Cy.o0 I) w)) ;
    gen : Mot W.2 (symH k.2) = idJ (ObjT W.1) y Mot (Hy.fibL-pt I vy W.1 k.1 i) W.2 (symH k.2) ;
    ss : Id (Id (ObjT W.1) W.2 y) (symH (symH k.2)) k.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 y (symH (symH k.2)) k.2 ;
    law : Id (V1.Ix (G.ob W)) (H0.TA.pr1 W (tv W k i)) (G.act W (Cy.o0 I) k (H0.TA.pr1 (Cy.o0 I) w)) =
     subst (Id (ObjT W.1) W.2 y) (\ e2 -> Id (V1.Ix (G.ob W)) (H0.TA.pr1 W (tv W (k.1, e2) i)) (G.act W (Cy.o0 I) (k.1, e2) (H0.TA.pr1 (Cy.o0 I) w)))
      (symH (symH k.2)) k.2 ss gen ;
   } ;
   -- the naturality, by induction on both presentation equations
   module TN (Vo W : G0.TOb) (g : G0.THm Vo W) (k : G0.THm W (Cy.o0 I)) (i : PB.IvP W.1) {
    St (y2 : ObjT W.1) (ek : Id (ObjT W.1) y2 y) (y3 : ObjT Vo.1) (eg : Id (ObjT Vo.1) y3 y2) : U a++ =
     Id (H0.TA.EI (Vo.1, y3)) (H0.TA.E.act (Vo.1, y3) (W.1, y2) (g.1, eg) (tv (W.1, y2) (k.1, ek) i))
      (tv (Vo.1, y3) (G0.tcomp (Vo.1, y3) (W.1, y2) (Cy.o0 I) (k.1, ek) (g.1, eg)) (PB.ivA Vo.1 W.1 g.1 i)) ;
    base : St y (refl y) y (refl y) = Hy.fibL-nat I vy Vo.1 W.1 g.1 k.1 i ;
    gen : (y2 : ObjT W.1) (q : Id (ObjT W.1) y y2) (y3 : ObjT Vo.1) (q' : Id (ObjT Vo.1) y2 y3) -> St y2 (symH q) y3 (symH q') =
     \ y2 q -> idJ (ObjT W.1) y (\ y4 q4 -> (y3 : ObjT Vo.1) (q' : Id (ObjT Vo.1) y4 y3) -> St y4 (symH q4) y3 (symH q'))
      (\ y3 q' -> idJ (ObjT Vo.1) y (\ y5 q5 -> St y (refl y) y5 (symH q5)) base y3 q') y2 q ;
    g0 : St W.2 (symH (symH k.2)) Vo.2 (symH (symH g.2)) = gen W.2 (symH k.2) Vo.2 (symH g.2) ;
    sk : Id (Id (ObjT W.1) W.2 y) (symH (symH k.2)) k.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 y (symH (symH k.2)) k.2 ;
    sg : Id (Id (ObjT Vo.1) Vo.2 W.2) (symH (symH g.2)) g.2 = V1.isSetIx (CC.CM.IC.obD Vo.1) Vo.2 W.2 (symH (symH g.2)) g.2 ;
    g1 : St W.2 (symH (symH k.2)) Vo.2 g.2 = subst (Id (ObjT Vo.1) Vo.2 W.2) (\ e2 -> St W.2 (symH (symH k.2)) Vo.2 e2) (symH (symH g.2)) g.2 sg g0 ;
    law : St W.2 k.2 Vo.2 g.2 = subst (Id (ObjT W.1) W.2 y) (\ e2 -> St W.2 e2 Vo.2 g.2) (symH (symH k.2)) k.2 sk g1 ;
   } ;
   res : V1.Ix (A'.tob I w) =
    (H0.mkFib (Cy.o0 I) w u0.1 tv (\ Vo W g k i -> TN[Vo, W, g, k, i].law) (\ W k i -> TP[W, k, i].law)
       (Hy.fibL-0 I vy) (Hy.fibL-1 I vy)).2 ;
   bkta : Id (Hy.TF.EI I) (ta I (TA'.pr I w res)) (Hy.TF.pr I w u0) =
    Hy.fibE-eq I (ta I (TA'.pr I w res)) (Hy.TF.pr I w u0) (refl w) (refl (Hy.fibB I (Hy.TF.pr I w u0)))
     (\ J u i -> refl (Hy.fibL I vy J u i)) ;
  } ;
  module CT = PB.CCart[a+, a+].Cart[Cy.rCy H0.EA, A', Hy.EA, Hy.FibT, \ W x -> x, \ Vo W g d -> refl ((Cy.rCy H0.EA).act Vo W g d),
    ta, \ W v -> refl (TA'.pr1 W v), tanat, \ W v v' Pe Q -> Inj[W, v, v', Pe, Q].law,
    \ X x u -> BK[X, x, u].res, \ X x u -> BK[X, x, u].bkta] ;
  contrY (eqy : PB.CEquiv[a+].EquivOp Gy By Ay fy) : PB.CPartial[a+].ContrOp (Cy.rCy H0.EA) A' = CT.moveContr eqy ;
 } ;
 -- the G0 equivalence structure from the copies'
 eqG0 (eqy : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp Y[y].Gy Y[y].By Y[y].Ay Y[y].fy)
  : G0.GB.CEquiv[a+].EquivOp G B A f = CCopy2[a].Comp[R, encK, pe, H0.EA, H0.FibT, \ y -> Y[y].contrY (eqy y)].contr ;
} ;
