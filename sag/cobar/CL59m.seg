-- CL59m.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part m: CL59d's conversions and CL59e's downstream composite for
-- the evaluation ev'' over Om (CL59l):
--   C1     a D-element of the context yo(y).A and a point w of D Om give a
--          D-element of E over w (the same family)
--   C2     a D-element of Q over w gives one over tau of the terminal point
--   Gf2    tau_Q^-1 . C2 . D ev'' . C1, natural (GN2)
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module CvO (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
 module OL = CL59l[a].Om[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
 module DF2 = CTotP13a[a, a+, a+].DFOf[CM.IC, OL.OmT, OL.Ew, OL.Qw, OL.ev''] ;
 module C15Q = CTotC15[a, a+, a+].C15[CM.IC, CT.T1, Q.1] ;
 B2Q : TR.P1.PTy[CT.P1] = C15Q.LB.Bt ;
 module DO = CobarI[a, a+, a+].DOfI[CM.IC] ;
 module DOm = DO.DC[OL.OmT] ;
 module DE = DO.DC[CT.TC.ofP OL.E] ;
 module DA = DF2.DA ;
 Obj (I : Ob) : U a+ = V1.Ix (CM.IC.obD I) ;
 pe2 (X : CT.TC.TOb) (q q' : V1.Ix (OL.OmT.ob X.1 X.2)) (b b' : V1.Ix ((CT.TC.ofP OL.E).ob X.1 X.2)) (eq : Id (V1.Ix (OL.OmT.ob X.1 X.2)) q q') (eb : Id (V1.Ix ((CT.TC.ofP OL.E).ob X.1 X.2)) b b')
  : Id (DA.Ez X.1 X.2) (q, b) (q', b') =
  transH (apH {V1.Ix (OL.OmT.ob X.1 X.2)} {DA.Ez X.1 X.2} (\ z -> (z, b)) eq) (apH {V1.Ix ((CT.TC.ofP OL.E).ob X.1 X.2)} {DA.Ez X.1 X.2} (\ c -> (q', c)) eb) ;
 module C1 (I : Ob) (x : Obj I) (w : DOm.Ob' I x) (d : DE.Ob' I x) {
  av : DA.TA I x w = \ q l -> d.1 q l ;
  anat : V1.Ix (DA.anatEq I x w av) = \ r l ->
   pe2 (r.2.1, CM.IC.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) _ _ _ _ (w.2.1 r l) (d.2.1 r l) ;
  aface : V1.Ix (DA.afaceEq I x w av) = \ r l -> pe2 (r.2.2.2.1, r.2.2.2.2.2.1) _ _ _ _ (w.2.2.1 r l) (d.2.2.1 r l) ;
  atop : V1.Ix (DA.atopEq I x w av) = \ r l -> pe2 (r.2.1, r.2.2.2.1) _ _ _ _ (w.2.2.2 r l) (d.2.2.2 r l) ;
  res : DA.TOb' I x w = (av, (anat, (aface, atop))) ;
 } ;
 -- c2: a D-element of B1 over w gives a D-element of Q over tau of the terminal point
 module DB = DF2.DB ;
 module DQ = CobarIT[a, a+, a+].DTI[CM.IC, CT.T1, Q.1] ;
 module DT1 = DO.DC[CT.T1] ;
 sndQ (X : CT.TC.TOb) (p : DB.Ez X.1 X.2) : DQ.Ez X.1 X.2 = (tt, p.2) ;
 module C2 (I : Ob) (x : Obj I) (w : DOm.Ob' I x) (b : DB.TOb' I x w) {
  tg : DT1.Ob' I x = DT1.tau I x tt ;
  av : DQ.TA I x tg = \ q l -> b.1 q l ;
  anat : V1.Ix (DQ.anatEq I x tg av) = \ r l -> apH (sndQ (r.2.1, CM.IC.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (b.2.1 r l) ;
  aface : V1.Ix (DQ.afaceEq I x tg av) = \ r l -> apH (sndQ (r.2.2.2.1, r.2.2.2.2.2.1)) (b.2.2.1 r l) ;
  atop : V1.Ix (DQ.atopEq I x tg av) = \ r l -> apH (sndQ (r.2.1, r.2.2.2.1)) (b.2.2.2 r l) ;
  res : DQ.TOb' I x tg = (av, (anat, (aface, atop))) ;
 } ;
 -- c1 and c2 commute with D's actions
 module C1N (J0 I : Ob) (u0 : Hom J0 I) (y0 : Obj J0) (x : Obj I) (f0 : DO.VT.HomD J0 I u0 y0 x) (w : DOm.Ob' I x) (d : DE.Ob' I x) {
  w' : DOm.Ob' J0 y0 = DOm.act J0 I u0 y0 x f0 w ;
  d' : DE.Ob' J0 y0 = DE.act J0 I u0 y0 x f0 d ;
  module TB = DA.TB[J0, I, u0, y0, x, f0, w, w', refl w', C1[I, x, w, d].res] ;
  law : Id (DA.TOb' J0 y0 w') TB.res C1[J0, y0, w', d'].res =
   DA.tob-eq J0 y0 w' TB.res C1[J0, y0, w', d'].res (\ q l -> DA.pr-inj q.2.1 q.2.2.2.1 (w'.1 q l) (TB.a' q l) (d'.1 q l) (TB.pc q l)) ;
 } ;
 module C2N (J0 I : Ob) (u0 : Hom J0 I) (y0 : Obj J0) (x : Obj I) (f0 : DO.VT.HomD J0 I u0 y0 x) (w : DOm.Ob' I x) (b : DB.TOb' I x w) {
  w' : DOm.Ob' J0 y0 = DOm.act J0 I u0 y0 x f0 w ;
  module TBb = DB.TB[J0, I, u0, y0, x, f0, w, w', refl w', b] ;
  eT : Id (DT1.Ob' J0 y0) (DT1.act J0 I u0 y0 x f0 (DT1.tau I x tt)) (DT1.tau J0 y0 tt) = symH (DT1.tau-nat J0 I u0 y0 x f0 tt) ;
  module TBq = DQ.TB[J0, I, u0, y0, x, f0, DT1.tau I x tt, DT1.tau J0 y0 tt, eT, C2[I, x, w, b].res] ;
  law : Id (DQ.TOb' J0 y0 (DT1.tau J0 y0 tt)) TBq.res C2[J0, y0, w', TBb.res].res =
   DQ.tob-eq J0 y0 (DT1.tau J0 y0 tt) TBq.res C2[J0, y0, w', TBb.res].res (\ q l ->
    DQ.pr-inj q.2.1 q.2.2.2.1 ((DT1.tau J0 y0 tt).1 q l) (TBq.a' q l) (TBb.a' q l)
     (transH (TBq.pc q l) (symH (apH (sndQ (q.2.1, q.2.2.2.1)) (TBb.pc q l))))) ;
 } ;
  -- the downstream composite, for any natural map tinv : B2Q -> Q
  module Down (tinv : G1.GB.CHtpyOps[a+].NMap[CT.P1, B2Q, Q.1]) {
  Gf2 (X : CT.TC.TOb) (w : DOm.Ob' X.1 X.2) (d : DE.Ob' X.1 X.2) : V1.Ix (Q.1.tob X tt) =
   tinv.nfun X tt (C2[X.1, X.2, w, DF2.DM[X.1, X.2, w, C1[X.1, X.2, w, d].res].res].res) ;
  module GN2 (J K : CT.TC.TOb) (g : CT.TC.THm K J) (w : DOm.Ob' J.1 J.2) (d : DE.Ob' J.1 J.2) {
   w' : DOm.Ob' K.1 K.2 = DOm.act K.1 J.1 g.1 K.2 J.2 g.2 w ;
   d' : DE.Ob' K.1 K.2 = DE.act K.1 J.1 g.1 K.2 J.2 g.2 d ;
   aJ : DF2.DA.TOb' J.1 J.2 w = C1[J.1, J.2, w, d].res ;
   bJ : DF2.DB.TOb' J.1 J.2 w = DF2.DM[J.1, J.2, w, aJ].res ;
   cJ : V1.Ix (B2Q.tob J tt) = C2[J.1, J.2, w, bJ].res ;
   module N1 = C1N[K.1, J.1, g.1, K.2, J.2, g.2, w, d] ;
   module N3 = C2N[K.1, J.1, g.1, K.2, J.2, g.2, w, bJ] ;
   m2 : Id (DF2.DB.TOb' K.1 K.2 w') (DF2.DM[K.1, K.2, w', N1.TB.res].res) N3.TBb.res =
    G1.GB.GPre[a+].TyL[DF2.DG, DF2.DB.DTy].pr-inj K w' _ _ DF2.DN[K, J, g, (w, aJ)].nat ;
   module TBB = DQ.TB[K.1, J.1, g.1, K.2, J.2, g.2, DT1.tau J.1 J.2 tt, DT1.tau K.1 K.2 tt,
      G1.GB.GPre[a+].PS.ntEq CT.P1 (CT.TC.toP DT1.DCtx) (CT.TC.toPS CT.T1 DT1.DCtx DT1.tauS) K J g tt tt (refl tt), cJ] ;
   tbIrr : Id (V1.Ix (B2Q.tob K tt)) TBB.res N3.TBq.res =
    DQ.tob-eq K.1 K.2 (DT1.tau K.1 K.2 tt) TBB.res N3.TBq.res (\ q l ->
     DQ.pr-inj q.2.1 q.2.2.2.1 ((DT1.tau K.1 K.2 tt).1 q l) (TBB.a' q l) (N3.TBq.a' q l) (transH (TBB.pc q l) (symH (N3.TBq.pc q l)))) ;
   chainC : Id (V1.Ix (B2Q.tob K tt)) TBB.res (C2[K.1, K.2, w', DF2.DM[K.1, K.2, w', C1[K.1, K.2, w', d'].res].res].res) =
    transH tbIrr (transH N3.law
     (apH {DF2.DB.TOb' K.1 K.2 w'} {V1.Ix (B2Q.tob K tt)} (\ b -> C2[K.1, K.2, w', b].res)
       (transH (symH m2) (apH {DF2.DA.TOb' K.1 K.2 w'} {DF2.DB.TOb' K.1 K.2 w'} (\ a0 -> DF2.DM[K.1, K.2, w', a0].res) N1.law)))) ;
   law (e : Id (V1.Ix (G1.fibCwF-T.nil.ob K)) (G1.fibCwF-T.nil.act K J g tt) tt)
    : Id (V1.Ix (Q.1.tob K tt)) (Q.1.tact K J g tt tt e (Gf2 J w d)) (Gf2 K w' d') =
    transH (G1.GB.GPre[a+].PS.tact-irr G1.fibCwF-T.nil Q.1 K J g tt tt e (refl tt) (Gf2 J w d))
     (transH (tinv.nnat K J g tt tt (refl tt) cJ)
       (apH {V1.Ix (B2Q.tob K tt)} {V1.Ix (Q.1.tob K tt)} (tinv.nfun K tt) chainC)) ;
  } ;
  } ;
 } ;
} ;
