-- CwFTrunc.seg (canonicity-c2; SIMPLIFIED.md item 3): the interface of
-- a propositional truncation in a CwF with Pi, Sigma, Swan Id, WITHOUT
-- stability under substitution (ruling 4e 2026-11-11: every use takes
-- the truncation of one type over one context and substitutes it).
--   Tr G A     a type over G
--   inc        the unit, an element of (Tr A)[p] over G.A
--   incS       the same as a substitution G.A -> G.Tr A over G
--   trProp     Tr A is a proposition
--   elim       elimination into a family of propositions over G.Tr A,
--              from its values on the unit
open Base ;

module Trunc (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;

  record TruncAt {
    Tr (G : Ctx) (A : Ty G) : Ty G ;
    inc (G : Ctx) (A : Ty G) : El (ext G A) (wkT G A (Tr G A)) ;
    incS (G : Ctx) (A : Ty G) : Sub (ext G A) (ext G (Tr G A)) = extS (ext G A) G (Tr G A) (p G A) (inc G A) ;
    trProp (G : Ctx) (A : Ty G) : El G (PU.isProp G (Tr G A)) ;
    elim (G : Ctx) (A : Ty G) (B : Ty (ext G (Tr G A)))
      (pB : El (ext G (Tr G A)) (PU.isProp (ext G (Tr G A)) B))
      (b : El (ext G A) (subT (ext G A) (ext G (Tr G A)) B (incS G A)))
      : El (ext G (Tr G A)) B ;
  } ;
} ;
