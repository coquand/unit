-- CCmpK30.seg (canonicity-c2; (K) for cmpI, part 30): R1 over nil.Q (stage
-- 1, by CMsElim), the centre of the fibre of cmpI over the variable g of
-- nil.HTT (R1 at q1 := ev g_1, g, refl), and contractibility of the fibres.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module K30 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K29m = CCmpK29[a].K29[R, encK, pe, y] ;
 module K26m = K29m.K26m ;
 module K25m = K26m.K25m ;
 module K19m = K29m.K19m ;
 module K12m = K19m.K12m ;
 module I = K12m.I ;
 module QS = K19m.QS ;
 module Ex = CQSurj[a].Ex[C] ;
 Nl : C.Ctx = C.nil ;
 HTT : C.Ty Nl = K19m.HTT ;
 G1 : C.Ctx = K19m.G1 ;
 C1 : C.Ctx = K19m.C1 ;
 GB : C.Ctx = K12m.GB ;
 E2 : C.Ctx = K26m.E2 ;
 D1 : C.Ctx = K26m.D1 ;
 H1l : C.Ty D1 = C.subT D1 C1 K25m.H1 K26m.l1 ;
 x2 : C.El D1 (C.subT D1 C1 K25m.PiH1 K26m.l1) =
  OV.trE D1 (FibCwF[a, a+].fibPi.Pi D1 H1l K29m.F1l) (C.subT D1 C1 K25m.PiH1 K26m.l1) (symH (FibCwF[a, a+].fibPi.Pi-nat D1 C1 K25m.H1 K25m.F1 K26m.l1))
   (OV.lam D1 H1l K29m.F1l K29m.body) ;
 X2p : C.Ty E2 = C.subT E2 G1 K19m.X2 K26m.pE2 ;
 bb : C.El E2 (C.subT E2 G1 K25m.B1 K26m.pE2) =
  OV.trE E2 (FibCwF[a, a+].fibPi.Pi E2 X2p (C.subT D1 C1 K25m.PiH1 K26m.l1)) (C.subT E2 G1 K25m.B1 K26m.pE2) (symH (FibCwF[a, a+].fibPi.Pi-nat E2 G1 K19m.X2 K25m.PiH1 K26m.pE2))
   (OV.lam E2 X2p (C.subT D1 C1 K25m.PiH1 K26m.l1) x2) ;
 R1 : C.El G1 K25m.B1 = CMsElim[a].ME[G1, QS.S, QS.msurj, K25m.B1, K25m.pB1, bb].res ;
 -- at the variable g of nil.HTT
 X2s : C.Ty GB = C.subT GB G1 K19m.X2 K12m.sg1 ;
 gN (J I : Ob) (f : Hom J I) (w : V1.Ix (GB.ob I))
   : Id (V1.Ix (X2s.1.tob J (GB.act J I f w))) (X2s.1.tact J I f w (GB.act J I f w) (refl (GB.act J I f w)) w.2) (GB.act J I f w).2 =
  L.tact-irr Nl HTT.1 J I f w.1 w.1
   (L.ntEq G1 Nl K19m.s1G J I f (K12m.sg1.nt I w) (K12m.sg1.nt J (GB.act J I f w)) (L.ntEq GB G1 K12m.sg1 J I f w (GB.act J I f w) (refl (GB.act J I f w)))) (refl w.1) w.2 ;
 gS : C.El GB X2s = L.mkPEl GB X2s.1 (\ K w -> w.2) (\ J I f w w' e ->
  idJ (V1.Ix (GB.ob J)) (GB.act J I f w) (\ w2 e2 -> Id (V1.Ix (X2s.1.tob J w2)) (X2s.1.tact J I f w w2 e2 w.2) w2.2) (gN J I f w) w' e) ;
 nu1 : C.Sub GB C1 = Ex.exS GB G1 K19m.X2 K12m.sg1 gS ;
 QC1n : C.Ty GB = C.subT GB C1 K19m.QC1 nu1 ;
 r0 : C.El GB (IJ.IdT GB QC1n (C.subt GB C1 K19m.QC1 K25m.ev1C1 nu1) (C.subt GB C1 K19m.QC1 K19m.q2C1 nu1)) =
  CCmpU14[a].rwId GB QC1n (C.subt GB C1 K19m.QC1 K25m.ev1C1 nu1) (C.subt GB C1 K19m.QC1 K25m.ev1C1 nu1) (C.subt GB C1 K19m.QC1 K25m.ev1C1 nu1) (C.subt GB C1 K19m.QC1 K19m.q2C1 nu1)
   (\ K w -> refl ((C.subt GB C1 K19m.QC1 K25m.ev1C1 nu1).eob K w)) (\ K w -> refl ((C.subt GB C1 K19m.QC1 K25m.ev1C1 nu1).eob K w))
   (IJ.rfl GB QC1n (C.subt GB C1 K19m.QC1 K25m.ev1C1 nu1)) ;
 rEl : C.El GB (C.subT GB C1 K25m.H1 nu1) =
  OV.trE GB (IJ.IdT GB QC1n (C.subt GB C1 K19m.QC1 K25m.ev1C1 nu1) (C.subt GB C1 K19m.QC1 K19m.q2C1 nu1)) (C.subT GB C1 K25m.H1 nu1)
   (symH (IJ.IdT-nat GB C1 K19m.QC1 K25m.ev1C1 K19m.q2C1 nu1)) r0 ;
 nu : C.Sub GB K25m.Cc = Ex.exS GB C1 K25m.H1 nu1 rEl ;
 c1 : C.El C1 K25m.PiH1 = OV.bod G1 K19m.X2 K25m.PiH1 R1 ;
 c2 : C.El K25m.Cc K25m.F1 = OV.bod C1 K25m.H1 K25m.F1 c1 ;
 PC : Id (C.Ty GB) (C.subT GB K25m.Cc K25m.F1 nu) I.Fib =
  transH (symH (C.subT-o GB K25m.Cc GB I.Fib K25m.tg nu))
   (transH (apH {C.Sub GB GB} {C.Ty GB} (\ s -> C.subT GB GB I.Fib s) (L.sub-ext GB GB (C.o GB K25m.Cc GB K25m.tg nu) (C.id GB) (\ K w -> refl w)))
     (C.subT-id GB I.Fib)) ;
 centre : C.El GB I.Fib = OV.trE GB (C.subT GB K25m.Cc K25m.F1 nu) I.Fib PC (C.subt GB K25m.Cc K25m.F1 c2 nu) ;
 contr : C.El GB (EQ.isContr GB I.Fib) = PPp.contrOfProp GB I.Fib K12m.K9m.pF centre ;
 pF : C.El GB (PU.isProp GB I.Fib) = K12m.K9m.pF ;
 -- the inverse cop : HTT -> HS, and cmpI (cop g) = g
 invB : C.El GB I.Xb = INm.fst GB I.Xb I.Fm centre ;
 cop : C.El Nl (OV.Fun Nl I.B I.A) = OV.lam Nl I.B I.Xb invB ;
 sec1 : C.El GB (C.subT GB I.GX I.Fm (C.sec GB I.Xb invB)) = INm.snd GB I.Xb I.Fm centre ;
} ;
