-- GFibYC.seg: GENERATED from FibYC.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change FibYC.seg or the generator.
-- FibYC.seg (M1 step 3, S4, S3 toolkit): the Yoneda Id of a pulled-back
-- type and core's Swan Id in a total space (CId.IdOver) are isomorphic,
-- by natural maps both ways; natural maps of fibres lift to Sigma types;
-- an extension relative to a map equal to the identity is a ContrOp.
--
-- Informal text.
-- (1) Let pi = pi1 pi2 : K -> D -> H, A over H, and a0 , b0 elements of A[pi1][pi2] whose
--     readings in the total space of A are aE , bE.  An element of the
--     Yoneda Id(a0 , b0) at z has values in the fibres A(W , pi (z f)); its
--     readings, with the K part of the point forgotten, are a path of
--     core's IdOver with the same sieve (toC).  Conversely the values of
--     an IdOver path lie over pi (z f) (its point condition), so they are
--     read back in the fibres (frC).  Both are natural (readings of a
--     restriction) and inverse (fromE-eq, pr-inj).
-- (2) A natural map of the fibres B -> B' over G.A gives one of
--     Sigma A B -> Sigma A B' (the A part is kept).
-- (3) An extension relative to m with m(w) = w at every w is an absolute
--     one (kside composed with that equation).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module PFm = PresheafFormers[a, l].PFormers[PB.BC] ;

------------------------------------------------------------------------
-- (1) Yoneda Id and IdOver

module YC (K D H : PCtx) (pi2 : PSub[K, D]) (pi1 : PSub[D, H]) (A : PTy[H])
  (s : (X : Ob) -> W0.Ix (K.ob X) -> (W : Ob) -> Hom W X -> IvP W -> W0.Ix (H.ob W))
  (sN : (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
        (W : Ob) (f : Hom W J) (i : IvP W) -> Id (W0.Ix (H.ob W)) (s I x W (compH W J I h f) i) (s J y W f i))
  (aE bE : (W : Ob) -> W0.Ix (K.ob W) -> GPR.TyL[H, A].EI W)
  (aE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (aE X x)) (aE W (K.act W X f x)))
  (bE-act : (W X : Ob) (f : Hom W X) (x : W0.Ix (K.ob X))
            -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].E.act W X f (bE X x)) (bE W (K.act W X f x)))
  (sP : (X : Ob) (x : W0.Ix (K.ob X)) (W : Ob) (f : Hom W X) (i : IvP W) -> Id (W0.Ix (H.ob W)) (pi1.nt W (pi2.nt W (K.act W X f x))) (s X x W f i))
  (a0 b0 : PEl[K, subTy K D (subTy D H A pi1) pi2])
  (aQ : (W : Ob) (z : W0.Ix (K.ob W)) -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].pr W (pi1.nt W (pi2.nt W z)) (a0.eob W z)) (aE W z))
  (bQ : (W : Ob) (z : W0.Ix (K.ob W)) -> Id (GPR.TyL[H, A].EI W) (GPR.TyL[H, A].pr W (pi1.nt W (pi2.nt W z)) (b0.eob W z)) (bE W z)) {
  module TA = GPR.TyL[H, A] ;
  module Y = GPosIdY[l].IdY[K, subTy K D (subTy D H A pi1) pi2, a0, b0] ;
  module IO = PB.CId[l].IdOver[K, H, A, s, sN, aE, bE, aE-act, bE-act] ;

  -- a reading, with the K part of the point forgotten
  proj (W : Ob) (v : Y.TA.EI W) : TA.EI W = TA.pr W (pi1.nt W (pi2.nt W (Y.TA.pr1 W v))) (Y.TA.pr2 W v) ;

  -- a reading of an element at an end
  endR (c : PEl[K, subTy K D (subTy D H A pi1) pi2]) (cE : (W : Ob) -> W0.Ix (K.ob W) -> TA.EI W)
    (cQ : (W : Ob) (z : W0.Ix (K.ob W)) -> Id (TA.EI W) (TA.pr W (pi1.nt W (pi2.nt W z)) (c.eob W z)) (cE W z))
    (Z : Ob) (z : W0.Ix (K.ob Z)) (u : W0.Ix (A.tob Z (pi1.nt Z (pi2.nt Z (Y.pt Z z Z (idH Z))))))
    (Ez : Id (W0.Ix (A.tob Z (pi1.nt Z (pi2.nt Z (Y.pt Z z Z (idH Z)))))) u (c.eob Z (Y.pt Z z Z (idH Z))))
    : Id (TA.EI Z) (TA.pr Z (pi1.nt Z (pi2.nt Z (Y.pt Z z Z (idH Z)))) u) (cE Z z) =
    transH (apH (TA.pr Z (pi1.nt Z (pi2.nt Z (Y.pt Z z Z (idH Z))))) Ez)
      (transH (apH (\ z1 -> TA.pr Z (pi1.nt Z (pi2.nt Z z1)) (c.eob Z z1)) (K.act-id Z z)) (cQ Z z)) ;

  ----------------------------------------------------------------------
  -- to core

  toC (Z : Ob) (z : W0.Ix (K.ob Z)) (w : W0.Ix (Y.tob Z z)) : W0.Ix (IO.tobI Z z) =
    (IO.PT.mkPath Z z (\ W f j -> proj W (Y.rd Z z w W f j))
       (\ V W g f j ->
          transH (TA.pr-tact V W g (pi1.nt W (pi2.nt W (Y.pt Z z W f))) (pi1.nt V (pi2.nt V (Y.pt Z z V (compH V W Z f g))))
                    (ntEq D H pi1 V W g (pi2.nt W (Y.pt Z z W f)) (pi2.nt V (Y.pt Z z V (compH V W Z f g))) (ntEq K D pi2 V W g (Y.pt Z z W f) (Y.pt Z z V (compH V W Z f g)) (Y.ptn Z z V W g f))) (w.1.1 W f j))
            (apH (TA.pr V (pi1.nt V (pi2.nt V (Y.pt Z z V (compH V W Z f g))))) (w.1.2.1 V W g f j)))
       (\ W f j -> sP Z z W f j)
       (endR a0 aE aQ Z z (w.1.1 Z (idH Z) (PB.ptH Z e0)) (w.1.2.2.1 Z (idH Z)))
       (endR b0 bE bQ Z z (w.1.1 Z (idH Z) (PB.ptH Z e1)) (w.1.2.2.2 Z (idH Z))),
     (w.2.1, \ W f i j -> transH (apH (TA.pr W (pi1.nt W (pi2.nt W (Y.pt Z z W f)))) (w.2.2 W f i j)) (aQ W (Y.pt Z z W f)))) ;

  toNat (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y) (w : W0.Ix (Y.tob I x))
    : Id (W0.Ix (IO.tobI J y)) (IO.IdT.tact J I h x y e (toC I x w)) (toC J y (Y.tactY J I h x y e w)) =
    IO.idI-eq J y (IO.IdT.tact J I h x y e (toC I x w)) (toC J y (Y.tactY J I h x y e w))
      (IO.PT.path-eq J y (IO.IdT.tact J I h x y e (toC I x w)).1 (toC J y (Y.tactY J I h x y e w)).1
         (\ W f j -> apH (proj W) (symH (Y.Tact[J, I, h, x, y, e, w].rdc W f j))))
      (refl (PB.pre J I h w.2.1)) ;

  toN : HO.NMap[K, Y.IdYT, IO.IdT] = new HO.NMap[K, Y.IdYT, IO.IdT, toC, toNat] ;

  ----------------------------------------------------------------------
  -- from core

  module FC (Z : Ob) (z : W0.Ix (K.ob Z)) (v : W0.Ix (IO.tobI Z z)) {
    L (W : Ob) (f : Hom W Z) (j : IvP W) : TA.EI W = v.1.1.1 W f j ;

    Lpt (W : Ob) (f : Hom W Z) (j : IvP W) : Id (W0.Ix (H.ob W)) (TA.pr1 W (L W f j)) (pi1.nt W (pi2.nt W (Y.pt Z z W f))) =
      transH (v.1.2.1 W f j) (symH (sP Z z W f j)) ;

    uC (W : Ob) (f : Hom W Z) (j : IvP W) : W0.Ix (A.tob W (pi1.nt W (pi2.nt W (Y.pt Z z W f)))) =
      TA.fromE W (pi1.nt W (pi2.nt W (Y.pt Z z W f))) (L W f j) (Lpt W f j) ;

    uC-E (W : Ob) (f : Hom W Z) (j : IvP W) : Id (TA.EI W) (TA.pr W (pi1.nt W (pi2.nt W (Y.pt Z z W f))) (uC W f j)) (L W f j) =
      TA.fromE-eq W (pi1.nt W (pi2.nt W (Y.pt Z z W f))) (L W f j) (Lpt W f j) ;

    -- a condition L = cE, read on the values
    atE (c : PEl[K, subTy K D (subTy D H A pi1) pi2]) (cE : (W : Ob) -> W0.Ix (K.ob W) -> TA.EI W)
      (cQ : (W : Ob) (z1 : W0.Ix (K.ob W)) -> Id (TA.EI W) (TA.pr W (pi1.nt W (pi2.nt W z1)) (c.eob W z1)) (cE W z1))
      (W : Ob) (f : Hom W Z) (j : IvP W) (E : Id (TA.EI W) (L W f j) (cE W (Y.pt Z z W f)))
      : Id (W0.Ix (A.tob W (pi1.nt W (pi2.nt W (Y.pt Z z W f))))) (uC W f j) (c.eob W (Y.pt Z z W f)) =
      TA.pr-inj W (pi1.nt W (pi2.nt W (Y.pt Z z W f))) (uC W f j) (c.eob W (Y.pt Z z W f))
        (transH (uC-E W f j) (transH E (symH (cQ W (Y.pt Z z W f))))) ;

    natC (V W : Ob) (g : Hom V W) (f : Hom W Z) (j : IvP W)
      : Id (W0.Ix (A.tob V (pi1.nt V (pi2.nt V (Y.pt Z z V (compH V W Z f g))))))
           ((subTy K D (subTy D H A pi1) pi2).tact V W g (Y.pt Z z W f) (Y.pt Z z V (compH V W Z f g)) (Y.ptn Z z V W g f) (uC W f j))
           (uC V (compH V W Z f g) (ivA V W g j)) =
      TA.pr-inj V (pi1.nt V (pi2.nt V (Y.pt Z z V (compH V W Z f g))))
        ((subTy K D (subTy D H A pi1) pi2).tact V W g (Y.pt Z z W f) (Y.pt Z z V (compH V W Z f g)) (Y.ptn Z z V W g f) (uC W f j))
        (uC V (compH V W Z f g) (ivA V W g j))
        (transH (symH (TA.pr-tact V W g (pi1.nt W (pi2.nt W (Y.pt Z z W f))) (pi1.nt V (pi2.nt V (Y.pt Z z V (compH V W Z f g))))
                         (ntEq D H pi1 V W g (pi2.nt W (Y.pt Z z W f)) (pi2.nt V (Y.pt Z z V (compH V W Z f g))) (ntEq K D pi2 V W g (Y.pt Z z W f) (Y.pt Z z V (compH V W Z f g)) (Y.ptn Z z V W g f))) (uC W f j)))
          (transH (apH (TA.E.act V W g) (uC-E W f j))
            (transH (v.1.1.2 V W g f j) (symH (uC-E V (compH V W Z f g) (ivA V W g j)))))) ;

    res : W0.Ix (Y.tob Z z) =
      ((uC,
        (natC,
         (\ W f -> atE a0 aE aQ W f (PB.ptH W e0) (IO.PT.end0g Z z v.1 W f),
          \ W f -> atE b0 bE bQ W f (PB.ptH W e1) (IO.PT.end1g Z z v.1 W f)))),
       (v.2.1, \ W f i j -> atE a0 aE aQ W f j (v.2.2 W f i j))) ;
  } ;

  frC (Z : Ob) (z : W0.Ix (K.ob Z)) (v : W0.Ix (IO.tobI Z z)) : W0.Ix (Y.tob Z z) = FC[Z, z, v].res ;

  -- a value read back is determined by its point and its reading
  frE-eq (V : Ob) (p p' : W0.Ix (K.ob V)) (E : Id (W0.Ix (K.ob V)) p p') (L : TA.EI V)
    (P : Id (W0.Ix (H.ob V)) (TA.pr1 V L) (pi1.nt V (pi2.nt V p))) (P' : Id (W0.Ix (H.ob V)) (TA.pr1 V L) (pi1.nt V (pi2.nt V p')))
    : Id (Y.TA.EI V) (Y.TA.pr V p (TA.fromE V (pi1.nt V (pi2.nt V p)) L P)) (Y.TA.pr V p' (TA.fromE V (pi1.nt V (pi2.nt V p')) L P')) =
    idJ (W0.Ix (K.ob V)) p
      (\ p2 E2 -> (P2 : Id (W0.Ix (H.ob V)) (TA.pr1 V L) (pi1.nt V (pi2.nt V p2)))
         -> Id (Y.TA.EI V) (Y.TA.pr V p (TA.fromE V (pi1.nt V (pi2.nt V p)) L P)) (Y.TA.pr V p2 (TA.fromE V (pi1.nt V (pi2.nt V p2)) L P2)))
      (\ P2 -> apH (\ Q -> Y.TA.pr V p (TA.fromE V (pi1.nt V (pi2.nt V p)) L Q)) (W0.isSetIx (H.ob V) (TA.pr1 V L) (pi1.nt V (pi2.nt V p)) P P2))
      p' E P' ;

  frNat (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y) (v : W0.Ix (IO.tobI I x))
    : Id (W0.Ix (Y.tob J y)) (Y.tactY J I h x y e (frC I x v)) (frC J y (IO.IdT.tact J I h x y e v)) =
    Y.idY-eq J y (Y.tactY J I h x y e (frC I x v)) (frC J y (IO.IdT.tact J I h x y e v))
      (\ V g j -> transH (Y.Tact[J, I, h, x, y, e, frC I x v].rdc V g j)
         (frE-eq V (Y.pt I x V (compH V J I h g)) (Y.pt J y V g) (Y.Tact[J, I, h, x, y, e, frC I x v].pi V g)
            (v.1.1.1 V (compH V J I h g) j) (FC[I, x, v].Lpt V (compH V J I h g) j) (FC[J, y, IO.IdT.tact J I h x y e v].Lpt V g j)))
      (refl (PB.pre J I h v.2.1)) ;

  frN : HO.NMap[K, IO.IdT, Y.IdYT] = new HO.NMap[K, IO.IdT, Y.IdYT, frC, frNat] ;

  ----------------------------------------------------------------------
  -- the two maps are inverse

  fr-to (Z : Ob) (z : W0.Ix (K.ob Z)) (w : W0.Ix (Y.tob Z z)) : Id (W0.Ix (Y.tob Z z)) (frC Z z (toC Z z w)) w =
    Y.idY-eq Z z (frC Z z (toC Z z w)) w
      (\ V g j -> apH (Y.TA.pr V (Y.pt Z z V g))
         (TA.pr-inj V (pi1.nt V (pi2.nt V (Y.pt Z z V g))) (FC[Z, z, toC Z z w].uC V g j) (w.1.1 V g j) (FC[Z, z, toC Z z w].uC-E V g j)))
      (refl w.2.1) ;

  to-fr (Z : Ob) (z : W0.Ix (K.ob Z)) (v : W0.Ix (IO.tobI Z z)) : Id (W0.Ix (IO.tobI Z z)) (toC Z z (frC Z z v)) v =
    IO.idI-eq Z z (toC Z z (frC Z z v)) v
      (IO.PT.path-eq Z z (toC Z z (frC Z z v)).1 v.1 (\ W f j -> FC[Z, z, v].uC-E W f j))
      (refl v.2.1) ;
} ;

------------------------------------------------------------------------
-- (2) natural maps of fibres lift to Sigma types

module SigN (G : PCtx) (A : PTy[G]) (B B' : PTy[extP G A]) (n : HO.NMap[extP G A, B, B']) {
  module S = PFm.SigAB[G, A, B] ;
  module S' = PFm.SigAB[G, A, B'] ;

  nf (I : Ob) (x : W0.Ix (G.ob I)) (ab : S.Fb I x) : S'.Fb I x = (ab.1, n.nfun I (pairE G A I x ab.1) ab.2) ;

  nn (J I : Ob) (f : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y) (ab : S.Fb I x)
    : Id (S'.Fb J y) (S'.SigP.tact J I f x y e (nf I x ab)) (nf J y (S.SigP.tact J I f x y e ab)) =
    apH (\ b -> (A.tact J I f x y e ab.1, b))
      (n.nnat J I f (pairE G A I x ab.1) (pairE G A J y (A.tact J I f x y e ab.1)) (pair-act G A J I f x y e ab.1) ab.2) ;

  map : HO.NMap[G, S.SigP, S'.SigP] = new HO.NMap[G, S.SigP, S'.SigP, nf, nn] ;
} ;

------------------------------------------------------------------------
-- (3) relative to a map that is the identity

module RelId (G : PCtx) (A : PTy[G]) (m : CP.PMap[G, A, A])
  (mId : (X : Ob) (w : SigT G A X) -> Id (SigT G A X) (m.mE X w) w)
  (k : CP.Rel[G, A, A, m].RC) {
  contrOp : CP.ContrOp G A = new CP.Rel[G, A, A, CP.pmap-id G A].RC[
    k.kop,
    \ X x s W f i -> transH (k.kside X x s W f i) (mId W (s.pv W f i)),
    k.kunif] ;
} ;
