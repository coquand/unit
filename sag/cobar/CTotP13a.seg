-- CTotP13a.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part a: D on maps of types.  For f : A -> B a map of types over G
-- (a PMap over the identity of G), D f : D A -> D B over D G is f index by
-- index (read in the total spaces, moved to the point d at q along f's
-- point equation); its three equations from D A's through f's naturality.
--   DM[X, d, av].res   D f at a point;  Df : PMap over D G
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module DFOf (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module P = Presheaf[vl, l].Psh[TC.TotCat] ;
 module VT = CVert[a, vl].VertOf[C] ;
 module DO = CobarI[a, vl, l].DOfI[C] ;
 module D = DO.DC[G] ;
 module DA = CobarIT[a, vl, l].DTI[C, G, A] ;
 module DB = CobarIT[a, vl, l].DTI[C, G, B] ;
 module TR = CTotR[a, vl, l].TotR[C] ;
 module CP = TR.G1.GB.CPartial[l] ;
 GP : P.PCtx = TC.toP G ;
 EA : P.PCtx = DA.E ;
 EB : P.PCtx = DB.E ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 module DM (I : Ob) (x : Obj I) (d : D.Ob' I x) (av : DA.TOb' I x d) {
  v (q : DA.Idx I x) (l : DA.LandsI I x q) : DB.Ez q.2.1 q.2.2.2.1 = f.mE (q.2.1, q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (d.1 q l) (av.1 q l)) ;
  b : DB.TA I x d = \ q l ->
   DB.coeT q.2.1 q.2.2.2.1 (P.fstE GP B (q.2.1, q.2.2.2.1) (v q l)) (d.1 q l) (f.mpt (q.2.1, q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (d.1 q l) (av.1 q l)))
    (P.sndE GP B (q.2.1, q.2.2.2.1) (v q l)) ;
  pc (q : DA.Idx I x) (l : DA.LandsI I x q) : Id (DB.Ez q.2.1 q.2.2.2.1) (DB.prz q.2.1 q.2.2.2.1 (d.1 q l) (b q l)) (v q l) =
   symH (DB.pr-coe q.2.1 q.2.2.2.1 (P.fstE GP B (q.2.1, q.2.2.2.1) (v q l)) (d.1 q l) (f.mpt (q.2.1, q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (d.1 q l) (av.1 q l)))
     (P.sndE GP B (q.2.1, q.2.2.2.1) (v q l))) ;
  anat' : W0.Ix (DB.anatEq I x d b) = \ r l ->
   transH (apH {DB.Ez r.1.2.1 r.1.2.2.2.1} {DB.Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
             (EB.act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (pc r.1 l))
    (transH (symH (f.mnat (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
                     (DA.prz r.1.2.1 r.1.2.2.2.1 (d.1 r.1 l) (av.1 r.1 l))))
      (transH (apH {DA.Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} {DB.Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} (f.mE (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (av.2.1 r l))
        (symH (pc (r.1.1, r.2.1, compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1,
                   DO.rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1,
                   (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                  (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)))) ;
  aface' : W0.Ix (DB.afaceEq I x d b) = \ r l ->
   transH (pc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF I x r l).1) (DA.afaceF I x r l).2)
    (transH (apH {DA.Ez r.2.2.2.1 r.2.2.2.2.2.1} {DB.Ez r.2.2.2.1 r.2.2.2.2.2.1} (f.mE (r.2.2.2.1, r.2.2.2.2.2.1)) (av.2.2.1 r l))
      (symH (pc (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l))) ;
  atop' : W0.Ix (DB.atopEq I x d b) = \ r l ->
   transH (pc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF I x r l).1) (DA.atopF I x r l).2)
    (transH (apH {DA.Ez r.2.1 r.2.2.2.1} {DB.Ez r.2.1 r.2.2.2.1} (f.mE (r.2.1, r.2.2.2.1)) (av.2.2.2 r l))
      (transH (f.mnat (r.2.1, r.2.2.2.1) (r.2.1, (D.topD I x r).1) (idH r.2.1, (D.topD I x r).2.2)
                 (DA.prz r.2.1 (D.topD I x r).1 (d.1 (r.1, r.2.1, r.2.2.1, (D.topD I x r).1, (D.topD I x r).2.1, r.2.2.2.2.2) l)
                    (av.1 (r.1, r.2.1, r.2.2.1, (D.topD I x r).1, (D.topD I x r).2.1, r.2.2.2.2.2) l)))
        (apH {DB.Ez r.2.1 (D.topD I x r).1} {DB.Ez r.2.1 r.2.2.2.1} (EB.act (r.2.1, r.2.2.2.1) (r.2.1, (D.topD I x r).1) (idH r.2.1, (D.topD I x r).2.2))
           (symH (pc (r.1, r.2.1, r.2.2.1, (D.topD I x r).1, (D.topD I x r).2.1, r.2.2.2.2.2) l))))) ;
  res : DB.TOb' I x d = (b, (anat', (aface', atop'))) ;
 } ;
 -- D f as a map of types over D G
 DG : P.PCtx = TC.toP D.DCtx ;
 mE (X : TC.TOb) (w : P.SigT DG DA.DTy X) : P.SigT DG DB.DTy X =
  P.pairE DG DB.DTy X (P.fstE DG DA.DTy X w) (DM[X.1, X.2, P.fstE DG DA.DTy X w, P.sndE DG DA.DTy X w].res) ;
 module DN (Y X : TC.TOb) (h : TC.THm Y X) (w : P.SigT DG DA.DTy X) {
  d : D.Ob' X.1 X.2 = P.fstE DG DA.DTy X w ;
  av : DA.TOb' X.1 X.2 d = P.sndE DG DA.DTy X w ;
  d' : D.Ob' Y.1 Y.2 = DG.act Y X h d ;
  av' : DA.TOb' Y.1 Y.2 d' = DA.DTy.tact Y X h d d' (refl d') av ;
  module M1 = DM[X.1, X.2, d, av] ;
  module M2 = DM[Y.1, Y.2, d', av'] ;
  module TBb = DB.TB[Y.1, X.1, h.1, Y.2, X.2, h.2, d, d', refl d', M1.res] ;
  module TBa = DA.TB[Y.1, X.1, h.1, Y.2, X.2, h.2, d, d', refl d', av] ;
  eqv : Id (DB.TOb' Y.1 Y.2 d') TBb.res M2.res =
   DB.tob-eq Y.1 Y.2 d' TBb.res M2.res (\ q l ->
    DB.pr-inj q.2.1 q.2.2.2.1 (d'.1 q l) (TBb.res.1 q l) (M2.res.1 q l)
     (transH (TBb.pc q l)
       (transH (M1.pc (TBb.sh q) l)
         (transH (apH {DA.Ez q.2.1 q.2.2.2.1} {DB.Ez q.2.1 q.2.2.2.1} (f.mE (q.2.1, q.2.2.2.1)) (symH (TBa.pc q l)))
           (symH (M2.pc q l)))))) ;
  nat : Id (P.SigT DG DB.DTy Y) (mE Y ((P.extP DG DA.DTy).act Y X h w)) ((P.extP DG DB.DTy).act Y X h (mE X w)) =
   symH (apH {DB.TOb' Y.1 Y.2 d'} {P.SigT DG DB.DTy Y} (P.pairE DG DB.DTy Y d') eqv) ;
 } ;
 Df : CP.PMap[DG, DA.DTy, DB.DTy] = CP.mkPMap DG DA.DTy DB.DTy mE (\ X w -> refl (P.fstE DG DA.DTy X w)) (\ Y X h w -> DN[Y, X, h, w].nat) ;
} ;
