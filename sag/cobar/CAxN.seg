-- CAxN.seg (canonicity-c2; the axioms' statements, part 5): constancy of N.
-- N_D := D(Delta N) (45's CNDFib, fibrant at the total site).  For each
-- metatheory u (a schema; the internal form over the model's naturals is a
-- later step), over the coefficients Pr_u = G^k:
--   Nsurj: over Pr.(f : N_D^{Sp u}),       || Sigma (c : N_D). const c = f ||
--   Ninj:  over Pr.(c d : N_D).(h : const c = const d),   || c = d ||
-- where const c = \ x h. c is built by Pi-nat along any substitution.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module NOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (addV mulV : (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X)
  (addN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (addV I u v)) (addV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (mulN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (mulV I u v)) (mulV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (cV : R.R -> (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X)
  (cN : (r : R.R) (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (cV r I)) (cV r J))
  (k n : Nat) {
 module S = CAxSp[a].SpOf[R, encK, pe, addV, mulV, addN, mulN, cV, cN, k, n] ;
 module PW = S.PW ;
 C : CwF.CwF[a++] = S.C ;
 module OV = S.OV ;
 Nl : C.Ctx = S.Nl ;
 Pr : C.Ctx = S.Pr ;
 Term : U a = S.Term ;
 module ND = CNDFib[a].NDF[R, encK, pe] ;
 NDs : C.Ty Nl = ND.NDs ;
 Bat (E : C.Ctx) : C.Ty E = C.subT E Nl NDs (C.eps E) ;
 batSub (D E : C.Ctx) (s : C.Sub D E) : Id (C.Ty D) (C.subT D E (Bat E) s) (Bat D) =
  transH (symH (C.subT-o D E Nl NDs (C.eps E) s))
   (apH {C.Sub D Nl} {C.Ty D} (\ t -> C.subT D Nl NDs t) (transH (C.eps-uniq D (C.o D E Nl (C.eps E) s)) (symH (C.eps-uniq D (C.eps D))))) ;
 wkB (D : C.Ctx) (A : C.Ty D) (c : C.El D (Bat D)) : C.El (C.ext D A) (Bat (C.ext D A)) =
  OV.trE (C.ext D A) (C.subT (C.ext D A) D (Bat D) (C.p D A)) (Bat (C.ext D A)) (batSub (C.ext D A) D (C.p D A)) (C.subt (C.ext D A) D (Bat D) c (C.p D A)) ;
 -- a constant section of a Pi, along any substitution
 Sec (E : C.Ctx) (T : C.Ty E) : U a++ = (D : C.Ctx) (s : C.Sub D E) (c : C.El D (Bat D)) -> C.El D (C.subT D E T s) ;
 piC (E : C.Ctx) (A : C.Ty E) (T : C.Ty (C.ext E A)) (h : Sec (C.ext E A) T) : Sec E (S.Pi E A T) =
  \ D s c -> OV.trE D (S.Pi D (C.subT D E A s) (C.subT (C.ext D (C.subT D E A s)) (C.ext E A) T (C.lift D E A s))) (C.subT D E (S.Pi E A T) s)
     (symH (PW.G1.fibPi-T.Pi-nat D E A T s))
     (OV.lam D (C.subT D E A s) (C.subT (C.ext D (C.subT D E A s)) (C.ext E A) T (C.lift D E A s))
        (h (C.ext D (C.subT D E A s)) (C.lift D E A s) (wkB D (C.subT D E A s) c))) ;
 cH : (qs : SX.Over[R].Equations S.TW.Var) (B : C.Ty (S.HS qs).1) (h : Sec (S.HS qs).1 B) -> Sec S.Xc (S.PiH qs B) = split {
  nil -> \ B h -> h ;
  cons q qs | r -> \ B h -> r (S.Pi (S.HS qs).1 (S.EqT (S.HS qs).1 (S.HS qs).2 q) B) (piC (S.HS qs).1 (S.EqT (S.HS qs).1 (S.HS qs).2 q) B h) } ;
 cX : (j : Nat) (B : C.Ty (PW.Ext Pr j)) (h : Sec (PW.Ext Pr j) B) -> Sec Pr (S.PiX j B) = split {
  zero -> \ B h -> h ;
  suc j | r -> \ B h -> r (S.Pi (PW.Ext Pr j) (PW.Gat (PW.Ext Pr j)) B) (piC (PW.Ext Pr j) (PW.Gat (PW.Ext Pr j)) B h) } ;
 h0 (E : C.Ctx) : Sec E (Bat E) = \ D s c -> OV.trE D (Bat D) (C.subT D E (Bat E) s) (symH (batSub D E s)) c ;
 -- const c : N_D^{Sp u}, along s : D -> Pr
 const (qs : SX.Over[R].Equations S.TW.Var) : Sec Pr (S.Exp NDs qs) = cX n (S.PiH qs (Bat (S.HS qs).1)) (cH qs (Bat (S.HS qs).1) (h0 (S.HS qs).1)) ;
 -- the truncation at the total site
 module TT = CTotTr[a, a+, a+].TotTr[PW.GB.YF.CM.IC] ;
 Tr (G : C.Ctx) (A : C.Ty G) : C.Ty G = TT.Tr[G, A].Tr ;
 Eqs : U a = SX.Over[R].Equations S.TW.Var ;
 -- N surjective: over Pr.(f : N_D^{Sp u})
 module Surj (qs : Eqs) {
  ExpN : C.Ty Pr = S.Exp NDs qs ;
  G1 : C.Ctx = C.ext Pr ExpN ;
  s1 : C.Sub G1 Pr = C.p Pr ExpN ;
  G2 : C.Ctx = C.ext G1 (Bat G1) ;
  p2 : C.Sub G2 G1 = C.p G1 (Bat G1) ;
  s2 : C.Sub G2 Pr = C.o G2 G1 Pr s1 p2 ;
  cv : C.El G2 (Bat G2) = OV.trE G2 (C.subT G2 G1 (Bat G1) p2) (Bat G2) (batSub G2 G1 p2) (C.q G1 (Bat G1)) ;
  f2 : C.El G2 (C.subT G2 Pr ExpN s2) =
   OV.trE G2 (C.subT G2 G1 (C.subT G1 Pr ExpN s1) p2) (C.subT G2 Pr ExpN s2) (symH (C.subT-o G2 G1 Pr ExpN s1 p2))
    (C.subt G2 G1 (C.subT G1 Pr ExpN s1) (C.q Pr ExpN) p2) ;
  P : C.Ty G1 = Tr G1 (PW.G1.fibSig-T.Sig G1 (Bat G1) (S.IdT G2 (C.subT G2 Pr ExpN s2) (const qs G2 s2 cv) f2)) ;
 } ;
 -- N injective: over Pr.(c d : N_D).(h : const c = const d)
 module Inj (qs : Eqs) {
  ExpN : C.Ty Pr = S.Exp NDs qs ;
  D1 : C.Ctx = C.ext Pr (Bat Pr) ;
  D2 : C.Ctx = C.ext D1 (Bat D1) ;
  t2 : C.Sub D2 Pr = C.o D2 D1 Pr (C.p Pr (Bat Pr)) (C.p D1 (Bat D1)) ;
  cD2 : C.El D2 (Bat D2) = wkB D1 (Bat D1) (OV.trE D1 (C.subT D1 Pr (Bat Pr) (C.p Pr (Bat Pr))) (Bat D1) (batSub D1 Pr (C.p Pr (Bat Pr))) (C.q Pr (Bat Pr))) ;
  dD2 : C.El D2 (Bat D2) = OV.trE D2 (C.subT D2 D1 (Bat D1) (C.p D1 (Bat D1))) (Bat D2) (batSub D2 D1 (C.p D1 (Bat D1))) (C.q D1 (Bat D1)) ;
  Hc : C.Ty D2 = S.IdT D2 (C.subT D2 Pr ExpN t2) (const qs D2 t2 cD2) (const qs D2 t2 dD2) ;
  D3 : C.Ctx = C.ext D2 Hc ;
  P : C.Ty D3 = Tr D3 (S.IdT D3 (Bat D3) (wkB D2 Hc cD2) (wkB D2 Hc dD2)) ;
 } ;
} ;
