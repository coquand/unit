-- EqQinv.seg (canonicity-45; COBAR.md "Lemma 59"): an equivalence structure
-- gives a quasi-inverse.  For f : A -> B between fibrant types with an
-- EquivOp, internally: f has contractible fibres (FibS3 S3a), the centre of
-- its sections (CwFS4.LCm.kS) gives g with f . g ~ id, and CwFDer.fibRet
-- gives g . f ~ id; then g is read as a natural map and the two internal
-- homotopies as path homotopies (the path of a Swan Id element, ends by
-- QinvEq.AppW / FunOf.bod-eq).
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;
module FCw = FibCwF[a, l] ;
module FC = FCw.FC ;
module LR = CLocBoundRetr[a, l] ;
module OV = CwFOv.Ov[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module S4 = CwFS4.S4[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;
module RD = FibIdRd[a, l] ;
module QI = QinvEq[a, l] ;
module KI = CwFKrInv.KrInv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;

------------------------------------------------------------------------
-- a homotopy f ~ g as a pointwise identity of the bodies
module QP = CwFQP.QP[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module DR = CwFDer.Der[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;

-- an element of Fun P Q as a natural map
module NM (G : PCtx) (P Q : FC.STy G) (w : FCw.fibCwF.El G (OV.Fun G P Q)) {
  K : PCtx = extP G P.1 ;
  bw : FCw.fibCwF.El K (OV.wkT G P Q) = OV.bod G P (OV.wkT G P Q) w ;
  nf (I : Ob) (x : W0.Ix (G.ob I)) (a0 : W0.Ix (P.1.tob I x)) : W0.Ix (Q.1.tob I x) = bw.eob I (pairE G P.1 I x a0) ;
  nn (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y) (a0 : W0.Ix (P.1.tob I x))
    : Id (W0.Ix (Q.1.tob J y)) (Q.1.tact J I h x y e (nf I x a0)) (nf J y (P.1.tact J I h x y e a0)) =
    transH (tact-irr G Q.1 J I h x y e
              (ntEq K G (pP G P.1) J I h (pairE G P.1 I x a0) (pairE G P.1 J y (P.1.tact J I h x y e a0)) (pair-act G P.1 J I h x y e a0)) (nf I x a0))
      (bw.enat J I h (pairE G P.1 I x a0) (pairE G P.1 J y (P.1.tact J I h x y e a0)) (pair-act G P.1 J I h x y e a0)) ;
  nm : HO.NMap[G, P.1, Q.1] = new HO.NMap[G, P.1, Q.1, nf, nn] ;
} ;

-- an element of Htpy u v as a path homotopy u v ~ id (the converse of
-- QinvEq.HtpyOf): the readings of the Swan Id element, in the fibres of Y
module HtpyRd (G : PCtx) (X Y : FC.STy G) (u : HO.NMap[G, X.1, Y.1]) (v : HO.NMap[G, Y.1, X.1])
  (uC : FCw.fibCwF.El G (OV.Fun G X Y)) (vC : FCw.fibCwF.El G (OV.Fun G Y X))
  (pu : (W : Ob) (x : W0.Ix (G.ob W)) (a0 : W0.Ix (X.1.tob W x)) -> Id (W0.Ix (Y.1.tob W x)) ((OV.bod G X (OV.wkT G X Y) uC).eob W (pairE G X.1 W x a0)) (u.nfun W x a0))
  (pv : (W : Ob) (x : W0.Ix (G.ob W)) (a0 : W0.Ix (Y.1.tob W x)) -> Id (W0.Ix (X.1.tob W x)) ((OV.bod G Y (OV.wkT G Y X) vC).eob W (pairE G Y.1 W x a0)) (v.nfun W x a0))
  (hh : FCw.fibCwF.El G (EQ.Htpy G X Y uC vC)) {
  module T = HO.HT[G, Y.1, Y.1, HO.compN G Y.1 X.1 Y.1 v u, HO.idN G Y.1] ;
  module TY = GPR.TyL[G, Y.1] ;
  K : PCtx = extP G Y.1 ;
  YY : FC.STy K = OV.wkT G Y Y ;
  YX : FC.STy K = OV.wkT G Y X ;
  t0 : FCw.fibCwF.El K YX = OV.app K YY YX (EQ.wkF G Y Y X vC) (qP G Y.1) ;
  t1 : FCw.fibCwF.El K YY = OV.app K YX YY (EQ.wkF G Y X Y uC) t0 ;
  module A0 = QI.AppW[G, Y, Y, X, vC, qP G Y.1] ;
  module A1 = QI.AppW[G, Y, X, Y, uC, t0] ;
  t0v (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (X.1.tob W (TY.pr1 W z))) (t0.eob W z) (v.nfun W (TY.pr1 W z) (TY.pr2 W z)) =
    transH (A0.val W z) (pv W (TY.pr1 W z) (TY.pr2 W z)) ;
  t1v (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (Y.1.tob W (TY.pr1 W z))) (t1.eob W z) (u.nfun W (TY.pr1 W z) (v.nfun W (TY.pr1 W z) (TY.pr2 W z))) =
    transH (A1.val W z) (transH (pu W (TY.pr1 W z) (t0.eob W z)) (apH (u.nfun W (TY.pr1 W z)) (t0v W z))) ;
  IdTy : FC.STy K = FibId[a, l].fibId.IdT K YY t1 (qP G Y.1) ;
  hb : FCw.fibCwF.El K IdTy = OV.bod G Y IdTy hh ;
  module IY = PosIdY[a, l].IdY[K, YY.1, t1, qP G Y.1] ;
  mp (V : Ob) (q : IY.TA.EI V) : TY.EI V = TY.pr V (TY.pr1 V (IY.TA.pr1 V q)) (IY.TA.pr2 V q) ;
  tv (W : Ob) (z : W0.Ix (K.ob W)) (V : Ob) (g : Hom V W) (j : Hom V Iv) : TY.EI V = mp V (IY.rd W z (hb.eob W z) V g j) ;
  tn (W : Ob) (z : W0.Ix (K.ob W)) (V' V : Ob) (g' : Hom V' V) (g : Hom V W) (j : Hom V Iv)
    : Id (TY.EI V') (TY.E.act V' V g' (tv W z V g j)) (tv W z V' (compH V' V W g g') (compH V' V Iv j g')) =
    transH (TY.pr-tact V' V g' (TY.pr1 V (K.act V W g z)) (TY.pr1 V' (K.act V' W (compH V' V W g g') z))
              (ntEq K G (pP G Y.1) V' V g' (K.act V W g z) (K.act V' W (compH V' V W g g') z) (IY.ptn W z V' V g' g)) ((hb.eob W z).1.1 V g j))
      (apH (TY.pr V' (TY.pr1 V' (K.act V' W (compH V' V W g g') z))) ((hb.eob W z).1.2.1 V' V g' g j)) ;
  e0E (W : Ob) (z : W0.Ix (K.ob W)) : Id (TY.EI W) (tv W z W (idH W) (PB.ptH W PB.e0)) (T.aE W z) =
    transH (apH (TY.pr W (TY.pr1 W (K.act W W (idH W) z))) ((hb.eob W z).1.2.2.1 W (idH W)))
      (transH (apH {W0.Ix (K.ob W)} {TY.EI W} (\ z2 -> TY.pr W (TY.pr1 W z2) (t1.eob W z2)) (K.act-id W z))
        (apH (TY.pr W (TY.pr1 W z)) (t1v W z))) ;
  e1E (W : Ob) (z : W0.Ix (K.ob W)) : Id (TY.EI W) (tv W z W (idH W) (PB.ptH W PB.e1)) (T.bE W z) =
    transH (apH (TY.pr W (TY.pr1 W (K.act W W (idH W) z))) ((hb.eob W z).1.2.2.2 W (idH W)))
      (apH {W0.Ix (K.ob W)} {TY.EI W} (\ z2 -> TY.pr W (TY.pr1 W z2) ((qP G Y.1).eob W z2)) (K.act-id W z)) ;
  path (W : Ob) (z : W0.Ix (K.ob W)) : W0.Ix (T.PT.tobP W z) =
    T.PT.mkPath W z (tv W z) (\ V' V g' g j -> tn W z V' V g' g j) (\ V g j -> refl (G.act V W g (TY.pr1 W z))) (e0E W z) (e1E W z) ;
  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (K.ob I)) (z' : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' e (path I z)) (path J z')
      (\ V f i -> transH (symH (apH (mp V) (IY.Tact[J, I, h, z, z', e, hb.eob I z].rdc V f i)))
         (apH (\ w2 -> mp V (IY.rd J z' w2 V f i)) (hb.enat J I h z z' e))) ;
  res : PEl[K, T.PT.PathP] = new PEl[K, T.PT.PathP, path, enat] ;
} ;

-- a map of types with its point law as a natural map: the fibre part
-- coerced along the point law
module PN (G : PCtx) (A B : PTy[G]) (al : CP.PMap[G, A, B]) {
  module TA = GPR.TyL[G, A] ;
  module TB = GPR.TyL[G, B] ;
  nf (I : Ob) (x : W0.Ix (G.ob I)) (a0 : W0.Ix (A.tob I x)) : W0.Ix (B.tob I x) =
    TB.coeT I (TB.pr1 I (al.mE I (TA.pr I x a0))) x (al.mpt I (TA.pr I x a0)) (TB.pr2 I (al.mE I (TA.pr I x a0))) ;
  etaT (I : Ob) (m : TB.EI I) : Id (TB.EI I) (TB.pr I (TB.pr1 I m) (TB.pr2 I m)) m = refl m ;
  q0 (I : Ob) (x : W0.Ix (G.ob I)) (a0 : W0.Ix (A.tob I x))
    : Id (TB.EI I) (TB.pr I x (nf I x a0)) (TB.pr I (TB.pr1 I (al.mE I (TA.pr I x a0))) (TB.pr2 I (al.mE I (TA.pr I x a0)))) =
    symH (TB.pr-coe I (TB.pr1 I (al.mE I (TA.pr I x a0))) x (al.mpt I (TA.pr I x a0)) (TB.pr2 I (al.mE I (TA.pr I x a0)))) ;
  q (I : Ob) (x : W0.Ix (G.ob I)) (a0 : W0.Ix (A.tob I x)) : Id (TB.EI I) (TB.pr I x (nf I x a0)) (al.mE I (TA.pr I x a0)) =
    transH (q0 I x a0) (etaT I (al.mE I (TA.pr I x a0))) ;
  nn (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y) (a0 : W0.Ix (A.tob I x))
    : Id (W0.Ix (B.tob J y)) (B.tact J I h x y e (nf I x a0)) (nf J y (A.tact J I h x y e a0)) =
    TB.pr-inj J y (B.tact J I h x y e (nf I x a0)) (nf J y (A.tact J I h x y e a0))
      (transH (symH (TB.pr-tact J I h x y e (nf I x a0)))
        (transH (apH (TB.E.act J I h) (q I x a0))
          (transH (symH (al.mnat J I h (TA.pr I x a0)))
            (transH (apH (al.mE J) (TA.pr-tact J I h x y e a0)) (symH (q J y (A.tact J I h x y e a0))))))) ;
  nm : HO.NMap[G, A, B] = new HO.NMap[G, A, B, nf, nn] ;
} ;

module EQI (G : PCtx) (A B : FC.STy G) (f : HO.NMap[G, A.1, B.1]) (al : CP.PMap[G, A.1, B.1]) (e : CE.EquivOp G A.1 B.1 al)
  (sq : (W : Ob) (w : GPR.TyL[G, A.1].EI W) -> Id (GPR.TyL[G, B.1].EI W) (LR.Map[G, A.1, B.1, f].onE W w) (al.mE W w)) {
  module TA = GPR.TyL[G, A.1] ;
  module TB = GPR.TyL[G, B.1] ;
  module FF = QI.FunOf[G, A, B, f] ;
  fC : FCw.fibCwF.El G (OV.Fun G A B) = FF.fC ;
  module S3 = FibS3[a, l].S3[G, B, A, fC] ;
  fM : CP.PMap[G, A.1, B.1] = LR.Map[G, A.1, B.1, f].pmap ;
  alf-eq (W : Ob) (w : TA.EI W) : Id (TB.EI W) (S3.al.mE W w) (fM.mE W w) = apH (TB.pr W (TA.pr1 W w)) (FF.bod-eq W w) ;
  module HCf = PB.CHFibCart[l, l].HCart[G, A.1, B.1, S3.al, G, A.1, B.1, al,
     \ W d -> d, \ V W g0 d -> refl (G.act V W g0 d),
     \ W v -> v, \ W v -> refl (TB.pr1 W v), \ V W g0 v -> refl (TB.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TB.pr X x u),
     \ W v -> v, \ W v -> refl (TA.pr1 W v), \ V W g0 v -> refl (TA.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TA.pr X x u),
     \ W v -> transH (alf-eq W v) (sq W v)] ;
  k : FCw.fibCwF.El G (QP.Kr G B A fC) = S3.A[HCf.moveEq e].k ;
  -- the centre of the sections of f
  module LC = S4.LCm[G, B, A, fC, k] ;
  ST : FCw.fibCwF.Ty G = QP.SecT G A B fC ;
  cS : FCw.fibCwF.El G ST = ((FCw.fibSig.Sig-iso G ST (FCw.fibPi.Pi (FCw.fibCwF.ext G ST) (OV.wkT G ST ST) (EQ.Id2 G ST))).fun LC.kS).1 ;
  gC : FCw.fibCwF.El G (OV.Fun G B A) = ((FCw.fibSig.Sig-iso G (OV.Fun G B A) (EQ.SecH G A B fC)).fun cS).1 ;
  hC : FCw.fibCwF.El G (EQ.Htpy G A B fC gC) =
   OV.trE G (FCw.fibCwF.subT G (FCw.fibCwF.ext G (OV.Fun G B A)) (EQ.SecH G A B fC) (FCw.fibCwF.sec G (OV.Fun G B A) gC)) (EQ.Htpy G A B fC gC)
    (QP.PSecH G A B fC gC) (((FCw.fibSig.Sig-iso G (OV.Fun G B A) (EQ.SecH G A B fC)).fun cS).2) ;
  kx : FCw.fibCwF.El (FCw.fibCwF.ext G B) (EQ.isContr (FCw.fibCwF.ext G B) (QP.FVr G B A fC)) = OV.bod G B (EQ.isContr (FCw.fibCwF.ext G B) (QP.FVr G B A fC)) k ;
  fr : FCw.fibCwF.El G (EQ.Htpy G B A gC fC) = DR.FRm[G, A, B, fC, gC, kx, hC].fibRet ;
  -- the quasi-inverse as natural data
  gN : HO.NMap[G, B.1, A.1] = NM[G, B, A, gC].nm ;
  module H1 = HtpyRd[G, A, B, f, gN, fC, gC, \ W x a0 -> FF.bod-eq W (pairE G A.1 W x a0), \ W x a0 -> refl (gN.nfun W x a0), hC] ;
  module H2 = HtpyRd[G, B, A, gN, f, gC, fC, \ W x a0 -> refl (gN.nfun W x a0), \ W x a0 -> FF.bod-eq W (pairE G A.1 W x a0), fr] ;
  -- f g ~ id and g f ~ id
  eps : PEl[extP G B.1, HO.HT[G, B.1, B.1, HO.compN G B.1 A.1 B.1 gN f, HO.idN G B.1].PT.PathP] = H1.res ;
  eta : PEl[extP G A.1, HO.HT[G, A.1, A.1, HO.compN G A.1 B.1 A.1 f gN, HO.idN G A.1].PT.PathP] = H2.res ;
} ;

-- the PMap form
module EQP (G : PCtx) (A B : FC.STy G) (al : CP.PMap[G, A.1, B.1]) (e : CE.EquivOp G A.1 B.1 al) {
  module PNa = PN[G, A.1, B.1, al] ;
  module EI = EQI[G, A, B, PNa.nm, al, e, \ W w -> PNa.q W w.1 w.2] ;
} ;
