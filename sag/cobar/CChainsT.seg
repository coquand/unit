-- CChainsT.seg (canonicity-45; SIMPLIFIED.md step 4): chains at a stage of
-- an internal category (Chains.ChainsOf at the vertical category CVert.VCat
-- J), with their head moved along paths of objects (trCh), their
-- restriction along a base map (rCh: the chain map of the restriction
-- functor, head moved along res-comp), and the reindexing-then-move used
-- by the action of D (rxM).  Laws: the head transport commutes with the
-- faces, the reindexing and the chain maps; rCh commutes with rxM up to
-- the associativity of the base (the key lemma of D's naturality); objects
-- at a stage form a set, so paths of objects are irrelevant.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module ChT (C : CIntCat[a].IC) {
 module VT = CVert[a].VertOf[C] ;
 Obj (I : Ob) : U a = VT.Obj I ;
 setObj (J : Ob) : isSet (Obj J) = VA.isSetIx (C.obD J) ;
 module KJ (J : Ob) { module K = Chains[a].ChainsOf[VT.VCat J] ; } ;
 Ch (J : Ob) (n : Nat) (x z : Obj J) : U a = KJ[J].K.Ch n x z ;

 -- the head of a chain moved along a path of objects
 trCh (J : Ob) (n : Nat) (x x' : Obj J) (p : Id (Obj J) x x') (z : Obj J) (c : Ch J n x z) : Ch J n x' z =
  subst (Obj J) (\ w -> Ch J n w z) x x' p c ;
 trCh-trans (J : Ob) (n : Nat) (x x' x'' : Obj J) (p : Id (Obj J) x x') (q : Id (Obj J) x' x'') (z : Obj J) (c : Ch J n x z)
  : Id (Ch J n x'' z) (trCh J n x' x'' q z (trCh J n x x' p z c)) (trCh J n x x'' (transH p q) z c) =
  idJ (Obj J) x' (\ w r -> Id (Ch J n w z) (trCh J n x' w r z (trCh J n x x' p z c)) (trCh J n x w (transH p r) z c)) (refl (trCh J n x x' p z c)) x'' q ;
 trCh-irr (J : Ob) (n : Nat) (x x' : Obj J) (p q : Id (Obj J) x x') (z : Obj J) (c : Ch J n x z)
  : Id (Ch J n x' z) (trCh J n x x' p z c) (trCh J n x x' q z c) =
  apH {Id (Obj J) x x'} {Ch J n x' z} (\ r -> trCh J n x x' r z c) (setObj J x x' p q) ;
 trCh-refl (J : Ob) (n : Nat) (x : Obj J) (p : Id (Obj J) x x) (z : Obj J) (c : Ch J n x z) : Id (Ch J n x z) (trCh J n x x p z c) c =
  apH {Id (Obj J) x x} {Ch J n x z} (\ r -> trCh J n x x r z c) (setObj J x x p (refl x)) ;
 -- the head transport commutes with the faces
 trCh-comp (J : Ob) (n k : Nat) (x x' : Obj J) (p : Id (Obj J) x x') (z : Obj J) (c : Ch J (suc n) x z)
  : Id (Ch J n x' z) (KJ[J].K.comp n k x' z (trCh J (suc n) x x' p z c)) (trCh J n x x' p z (KJ[J].K.comp n k x z c)) =
  idJ (Obj J) x (\ w r -> Id (Ch J n w z) (KJ[J].K.comp n k w z (trCh J (suc n) x w r z c)) (trCh J n x w r z (KJ[J].K.comp n k x z c))) (refl (KJ[J].K.comp n k x z c)) x' p ;
 trCh-drop (J : Ob) (n : Nat) (x x' : Obj J) (p : Id (Obj J) x x') (z : Obj J) (c : Ch J (suc n) x z)
  : Id (KJ[J].K.DR n x' z) (KJ[J].K.drop n x' z (trCh J (suc n) x x' p z c))
      ((KJ[J].K.drop n x z c).1, trCh J n x x' p (KJ[J].K.drop n x z c).1 (KJ[J].K.drop n x z c).2.1, (KJ[J].K.drop n x z c).2.2) =
  idJ (Obj J) x (\ w r -> Id (KJ[J].K.DR n w z) (KJ[J].K.drop n w z (trCh J (suc n) x w r z c))
                           ((KJ[J].K.drop n x z c).1, trCh J n x w r (KJ[J].K.drop n x z c).1 (KJ[J].K.drop n x z c).2.1, (KJ[J].K.drop n x z c).2.2))
   (refl (KJ[J].K.drop n x z c)) x' p ;
 -- reindexing along a map with its domain moved
 rx-trD (J : Ob) (n : Nat) (x0 x' x : Obj J) (p : Id (Obj J) x0 x') (g : VT.VMap J x' x) (z : Obj J) (c : Ch J n x0 z)
  : Id (Ch J n x z) (KJ[J].K.rx n x' x g z (trCh J n x0 x' p z c)) (KJ[J].K.rx n x0 x (VT.trD J J (idH J) x' x0 (symH p) x g) z c) =
  idJ (Obj J) x0 (\ w r -> (g2 : VT.VMap J w x) -> Id (Ch J n x z) (KJ[J].K.rx n w x g2 z (trCh J n x0 w r z c)) (KJ[J].K.rx n x0 x (VT.trD J J (idH J) w x0 (symH r) x g2) z c))
   (\ g2 -> refl (KJ[J].K.rx n x0 x g2 z c)) x' p g ;
 -- reindexing along a map with its codomain moved
 rx-trC (J : Ob) (n : Nat) (x' x x1 : Obj J) (q : Id (Obj J) x x1) (g : VT.VMap J x' x) (z : Obj J) (c : Ch J n x' z)
  : Id (Ch J n x1 z) (KJ[J].K.rx n x' x1 (VT.trC J J (idH J) x' x x1 q g) z c) (trCh J n x x1 q z (KJ[J].K.rx n x' x g z c)) =
  idJ (Obj J) x (\ w r -> Id (Ch J n w z) (KJ[J].K.rx n x' w (VT.trC J J (idH J) x' x w r g) z c) (trCh J n x w r z (KJ[J].K.rx n x' x g z c)))
   (refl (KJ[J].K.rx n x' x g z c)) x1 q ;
 -- the chain map of a functor commutes with the head transport
 chF-trCh (J J' : Ob) (F : CChainsF[a].FunOf[VT.VCat J, VT.VCat J'].SFun) (n : Nat) (x x' : Obj J) (p : Id (Obj J) x x') (z : Obj J) (c : Ch J n x z)
  : Id (Ch J' n (F.onO x') (F.onO z)) (CChainsF[a].CF[VT.VCat J, VT.VCat J', F].chF n x' z (trCh J n x x' p z c))
      (trCh J' n (F.onO x) (F.onO x') (apH {Obj J} {Obj J'} F.onO p) (F.onO z) (CChainsF[a].CF[VT.VCat J, VT.VCat J', F].chF n x z c)) =
  idJ (Obj J) x (\ w r -> Id (Ch J' n (F.onO w) (F.onO z)) (CChainsF[a].CF[VT.VCat J, VT.VCat J', F].chF n w z (trCh J n x w r z c))
                            (trCh J' n (F.onO x) (F.onO w) (apH {Obj J} {Obj J'} F.onO r) (F.onO z) (CChainsF[a].CF[VT.VCat J, VT.VCat J', F].chF n x z c)))
   (refl (CChainsF[a].CF[VT.VCat J, VT.VCat J', F].chF n x z c)) x' p ;

 -- restriction of a chain at J along v : J' -> J, ending at res (u . v) x
 rCh (J' J I : Ob) (v : Hom J' J) (u : Hom J I) (x : Obj I) (n : Nat) (z : Obj J) (c : Ch J n (C.res J I u x) z)
  : Ch J' n (C.res J' I (compH J' J I u v) x) (C.res J' J v z) =
  trCh J' n (C.res J' J v (C.res J I u x)) (C.res J' I (compH J' J I u v) x) (symH (C.res-comp J' J I u v x)) (C.res J' J v z)
   (CChainsF[a].CF[VT.VCat J, VT.VCat J', VT.rfun J' J v].chF n (C.res J I u x) z c) ;
 -- reindexing along the restriction of a vertical map g0 : y -> res u0 x at J0, then moving the head
 rxM (J J0 I : Ob) (u : Hom J J0) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (g0 : VT.VMap J0 y (C.res J0 I u0 x)) (n : Nat) (z : Obj J) (c : Ch J n (C.res J J0 u y) z)
  : Ch J n (C.res J I (compH J J0 I u0 u) x) z =
  trCh J n (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z
   (KJ[J].K.rx n (C.res J J0 u y) (C.res J J0 u (C.res J0 I u0 x)) (VT.rmap J J0 u y (C.res J0 I u0 x) g0) z c) ;
 -- the composite of a chain with its head moved
 tot-trCh (J : Ob) (n : Nat) (x x' : Obj J) (p : Id (Obj J) x x') (z : Obj J) (c : Ch J n x z)
  : Id (VT.VMap J z x') (KJ[J].K.tot n x' z (trCh J n x x' p z c)) (VT.trC J J (idH J) z x x' p (KJ[J].K.tot n x z c)) =
  idJ (Obj J) x (\ w r -> Id (VT.VMap J z w) (KJ[J].K.tot n w z (trCh J n x w r z c)) (VT.trC J J (idH J) z x w r (KJ[J].K.tot n x z c))) (refl (KJ[J].K.tot n x z c)) x' p ;
 -- the composite of a restricted chain: the restriction of the composite, moved
 tot-rCh (J' J I : Ob) (v : Hom J' J) (u : Hom J I) (x : Obj I) (n : Nat) (z : Obj J) (c : Ch J n (C.res J I u x) z)
  : Id (VT.VMap J' (C.res J' J v z) (C.res J' I (compH J' J I u v) x)) (KJ[J'].K.tot n (C.res J' I (compH J' J I u v) x) (C.res J' J v z) (rCh J' J I v u x n z c))
      (VT.trC J' J' (idH J') (C.res J' J v z) (C.res J' J v (C.res J I u x)) (C.res J' I (compH J' J I u v) x) (symH (C.res-comp J' J I u v x)) (VT.rmap J' J v z (C.res J I u x) (KJ[J].K.tot n (C.res J I u x) z c))) =
  transH (tot-trCh J' n (C.res J' J v (C.res J I u x)) (C.res J' I (compH J' J I u v) x) (symH (C.res-comp J' J I u v x)) (C.res J' J v z)
            (CChainsF[a].CF[VT.VCat J, VT.VCat J', VT.rfun J' J v].chF n (C.res J I u x) z c))
   (apH {VT.VMap J' (C.res J' J v z) (C.res J' J v (C.res J I u x))} {VT.VMap J' (C.res J' J v z) (C.res J' I (compH J' J I u v) x)}
      (\ w -> VT.trC J' J' (idH J') (C.res J' J v z) (C.res J' J v (C.res J I u x)) (C.res J' I (compH J' J I u v) x) (symH (C.res-comp J' J I u v x)) w)
      (CChainsF[a].CF[VT.VCat J, VT.VCat J', VT.rfun J' J v].chF-tot n (C.res J I u x) z c)) ;
 -- the composite of the action's reindexing
 tot-rxM (J J0 I : Ob) (u : Hom J J0) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (g0 : VT.VMap J0 y (C.res J0 I u0 x)) (n : Nat) (z : Obj J) (c : Ch J n (C.res J J0 u y) z)
  : Id (VT.VMap J z (C.res J I (compH J J0 I u0 u) x)) (KJ[J].K.tot n (C.res J I (compH J J0 I u0 u) x) z (rxM J J0 I u u0 y x g0 n z c))
      (VT.trC J J (idH J) z (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x))
        (VT.vcomp J z (C.res J J0 u y) (C.res J J0 u (C.res J0 I u0 x)) (VT.rmap J J0 u y (C.res J0 I u0 x) g0) (KJ[J].K.tot n (C.res J J0 u y) z c))) =
  transH (tot-trCh J n (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z
            (KJ[J].K.rx n (C.res J J0 u y) (C.res J J0 u (C.res J0 I u0 x)) (VT.rmap J J0 u y (C.res J0 I u0 x) g0) z c))
   (apH {VT.VMap J z (C.res J J0 u (C.res J0 I u0 x))} {VT.VMap J z (C.res J I (compH J J0 I u0 u) x)}
      (\ w -> VT.trC J J (idH J) z (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) w)
      (KJ[J].K.tot-rx n (C.res J J0 u y) (C.res J J0 u (C.res J0 I u0 x)) (VT.rmap J J0 u y (C.res J0 I u0 x) g0) z c)) ;

 -- a transport of the domain along any two paths agrees (objects form a set)
 trD-irr (J : Ob) (x0 x' x : Obj J) (p q : Id (Obj J) x0 x') (g : VT.VMap J x0 x) : Id (VT.VMap J x' x) (VT.trD J J (idH J) x0 x' p x g) (VT.trD J J (idH J) x0 x' q x g) =
  apH {Id (Obj J) x0 x'} {VT.VMap J x' x} (\ r -> VT.trD J J (idH J) x0 x' r x g) (setObj J x0 x' p q) ;

 -- THE KEY LEMMA: restriction commutes with the reindexing-then-move of
 -- the action, up to the associativity of the base on the head
 module RR (J' J J0 I : Ob) (v : Hom J' J) (u : Hom J J0) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (g0 : VT.VMap J0 y (C.res J0 I u0 x)) (n : Nat) (z : Obj J) (c : Ch J n (C.res J J0 u y) z) {
  module F = CChainsF[a].CF[VT.VCat J, VT.VCat J', VT.rfun J' J v] ;
  rv (w : Obj J) : Obj J' = C.res J' J v w ;
  uv : Hom J' J0 = compH J' J J0 u v ;
  X0 : Obj J0 = C.res J0 I u0 x ;
  h : VT.VMap J (C.res J J0 u y) (C.res J J0 u X0) = VT.rmap J J0 u y X0 g0 ;
  huv : VT.VMap J' (C.res J' J0 uv y) (C.res J' J0 uv X0) = VT.rmap J' J0 uv y X0 g0 ;
  rcY : Id (Obj J') (C.res J' J0 uv y) (rv (C.res J J0 u y)) = C.res-comp J' J J0 u v y ;
  rcX : Id (Obj J') (C.res J' J0 uv X0) (rv (C.res J J0 u X0)) = C.res-comp J' J J0 u v X0 ;
  cv : Ch J' n (rv (C.res J J0 u y)) (rv z) = F.chF n (C.res J J0 u y) z c ;
  -- the common chain
  X : Ch J' n (C.res J' J0 uv X0) (rv z) = KJ[J'].K.rx n (C.res J' J0 uv y) (C.res J' J0 uv X0) huv (rv z) (trCh J' n (rv (C.res J J0 u y)) (C.res J' J0 uv y) (symH rcY) (rv z) cv) ;
  -- rmap v (rmap u g0) is huv moved at both ends
  ho : Id (VT.VMap J' (rv (C.res J J0 u y)) (rv (C.res J J0 u X0))) (VT.rmap J' J v (C.res J J0 u y) (C.res J J0 u X0) h)
         (VT.trC J' J' (idH J') (rv (C.res J J0 u y)) (C.res J' J0 uv X0) (rv (C.res J J0 u X0)) rcX (VT.trD J' J' (idH J') (C.res J' J0 uv y) (rv (C.res J J0 u y)) rcY (C.res J' J0 uv X0) huv)) =
   transH (symH (VT.trC-back J' J' (idH J') (rv (C.res J J0 u y)) (C.res J' J0 uv X0) (rv (C.res J J0 u X0)) rcX (VT.rmap J' J v (C.res J J0 u y) (C.res J J0 u X0) h)))
    (apH {VT.VMap J' (rv (C.res J J0 u y)) (C.res J' J0 uv X0)} {VT.VMap J' (rv (C.res J J0 u y)) (rv (C.res J J0 u X0))}
       (\ w -> VT.trC J' J' (idH J') (rv (C.res J J0 u y)) (C.res J' J0 uv X0) (rv (C.res J J0 u X0)) rcX w)
       (transH (symH (VT.trD-back J' J' (idH J') (C.res J' J0 uv y) (rv (C.res J J0 u y)) rcY (C.res J' J0 uv X0)
                        (VT.trC J' J' (idH J') (rv (C.res J J0 u y)) (rv (C.res J J0 u X0)) (C.res J' J0 uv X0) (symH rcX) (VT.rmap J' J v (C.res J J0 u y) (C.res J J0 u X0) h))))
          (apH {VT.VMap J' (C.res J' J0 uv y) (C.res J' J0 uv X0)} {VT.VMap J' (rv (C.res J J0 u y)) (C.res J' J0 uv X0)}
             (\ w -> VT.trD J' J' (idH J') (C.res J' J0 uv y) (rv (C.res J J0 u y)) rcY (C.res J' J0 uv X0) w) (symH (VT.rmap-o J' J J0 u v y X0 g0))))) ;
  -- the left-hand side is X with its head moved
  pX : Id (Obj J') (C.res J' J0 uv X0) (rv (C.res J I (compH J J0 I u0 u) x)) = transH rcX (apH {Obj J} {Obj J'} rv (symH (C.res-comp J J0 I u0 u x))) ;
  pL : Id (Obj J') (C.res J' J0 uv X0) (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) =
   transH pX (symH (C.res-comp J' J I (compH J J0 I u0 u) v x)) ;
  -- the chain map of the reindexed chain, as X with its head moved along pX
  inner : Id (Ch J' n (rv (C.res J I (compH J J0 I u0 u) x)) (rv z))
            (F.chF n (C.res J I (compH J J0 I u0 u) x) z (trCh J n (C.res J J0 u X0) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z (KJ[J].K.rx n (C.res J J0 u y) (C.res J J0 u X0) h z c)))
            (trCh J' n (C.res J' J0 uv X0) (rv (C.res J I (compH J J0 I u0 u) x)) pX (rv z) X) =
   transH (chF-trCh J J' (VT.rfun J' J v) n (C.res J J0 u X0) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z
             (KJ[J].K.rx n (C.res J J0 u y) (C.res J J0 u X0) h z c))
    (transH (apH {Ch J' n (rv (C.res J J0 u X0)) (rv z)} {Ch J' n (rv (C.res J I (compH J J0 I u0 u) x)) (rv z)}
               (\ w -> trCh J' n (rv (C.res J J0 u X0)) (rv (C.res J I (compH J J0 I u0 u) x)) (apH {Obj J} {Obj J'} rv (symH (C.res-comp J J0 I u0 u x))) (rv z) w)
               (transH (F.chF-rx n (C.res J J0 u y) (C.res J J0 u X0) h z c)
                 (transH (apH {VT.VMap J' (rv (C.res J J0 u y)) (rv (C.res J J0 u X0))} {Ch J' n (rv (C.res J J0 u X0)) (rv z)}
                            (\ w -> KJ[J'].K.rx n (rv (C.res J J0 u y)) (rv (C.res J J0 u X0)) w (rv z) cv) ho)
                   (transH (rx-trC J' n (rv (C.res J J0 u y)) (C.res J' J0 uv X0) (rv (C.res J J0 u X0)) rcX (VT.trD J' J' (idH J') (C.res J' J0 uv y) (rv (C.res J J0 u y)) rcY (C.res J' J0 uv X0) huv) (rv z) cv)
                     (apH {Ch J' n (C.res J' J0 uv X0) (rv z)} {Ch J' n (rv (C.res J J0 u X0)) (rv z)}
                        (\ w -> trCh J' n (C.res J' J0 uv X0) (rv (C.res J J0 u X0)) rcX (rv z) w)
                        (transH (apH {VT.VMap J' (rv (C.res J J0 u y)) (C.res J' J0 uv X0)} {Ch J' n (C.res J' J0 uv X0) (rv z)}
                                   (\ w -> KJ[J'].K.rx n (rv (C.res J J0 u y)) (C.res J' J0 uv X0) w (rv z) cv)
                                   (trD-irr J' (C.res J' J0 uv y) (rv (C.res J J0 u y)) (C.res J' J0 uv X0) rcY (symH (symH rcY)) huv))
                          (symH (rx-trD J' n (rv (C.res J J0 u y)) (C.res J' J0 uv y) (C.res J' J0 uv X0) (symH rcY) huv (rv z) cv))))))))
      (trCh-trans J' n (C.res J' J0 uv X0) (rv (C.res J J0 u X0)) (rv (C.res J I (compH J J0 I u0 u) x)) rcX (apH {Obj J} {Obj J'} rv (symH (C.res-comp J J0 I u0 u x))) (rv z) X)) ;
  pR : Id (Obj J') (C.res J' J0 uv X0) (C.res J' I (compH J' J0 I u0 uv) x) = symH (C.res-comp J' J0 I u0 uv x) ;
  left : Id (Ch J' n (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) (rv z))
           (rCh J' J I v (compH J J0 I u0 u) x n z (rxM J J0 I u u0 y x g0 n z c))
           (trCh J' n (C.res J' J0 uv X0) (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) pL (rv z) X) =
   transH (apH {Ch J' n (rv (C.res J I (compH J J0 I u0 u) x)) (rv z)} {Ch J' n (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) (rv z)}
             (\ w -> trCh J' n (rv (C.res J I (compH J J0 I u0 u) x)) (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) (symH (C.res-comp J' J I (compH J J0 I u0 u) v x)) (rv z) w) inner)
    (trCh-trans J' n (C.res J' J0 uv X0) (rv (C.res J I (compH J J0 I u0 u) x)) (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) pX (symH (C.res-comp J' J I (compH J J0 I u0 u) v x)) (rv z) X) ;
  right : Id (Ch J' n (C.res J' I (compH J' J0 I u0 uv) x) (rv z)) (rxM J' J0 I uv u0 y x g0 n (rv z) (rCh J' J J0 v u y n z c))
            (trCh J' n (C.res J' J0 uv X0) (C.res J' I (compH J' J0 I u0 uv) x) pR (rv z) X) =
   refl (rxM J' J0 I uv u0 y x g0 n (rv z) (rCh J' J J0 v u y n z c)) ;
  -- the key equation
  pA : Id (Obj J') (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) (C.res J' I (compH J' J0 I u0 uv) x) =
   apH {Hom J' I} {Obj J'} (\ w -> C.res J' I w x) (comp-assoc J' J J0 I u0 u v) ;
  law : Id (Ch J' n (C.res J' I (compH J' J0 I u0 uv) x) (rv z))
          (trCh J' n (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) (C.res J' I (compH J' J0 I u0 uv) x) pA (rv z)
             (rCh J' J I v (compH J J0 I u0 u) x n z (rxM J J0 I u u0 y x g0 n z c)))
          (rxM J' J0 I uv u0 y x g0 n (rv z) (rCh J' J J0 v u y n z c)) =
   transH (apH {Ch J' n (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) (rv z)} {Ch J' n (C.res J' I (compH J' J0 I u0 uv) x) (rv z)}
             (\ w -> trCh J' n (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) (C.res J' I (compH J' J0 I u0 uv) x) pA (rv z) w) left)
    (transH (trCh-trans J' n (C.res J' J0 uv X0) (C.res J' I (compH J' J I (compH J J0 I u0 u) v) x) (C.res J' I (compH J' J0 I u0 uv) x) pL pA (rv z) X)
      (transH (trCh-irr J' n (C.res J' J0 uv X0) (C.res J' I (compH J' J0 I u0 uv) x) (transH pL pA) pR (rv z) X) (symH right))) ;
 } ;
 ------------------------------------------------------------------
 -- the action's reindexing along the vertical part of an identity is the
 -- identity (after moving the head along res (idH . u) x = res u x)
 module RxId (J I : Ob) (u : Hom J I) (x : Obj I) (n : Nat) (z : Obj J) (c : Ch J n (C.res J I u x) z) {
  i : Hom I I = idH I ;
  rx0 : Obj I = C.res I I i x ;
  g0 : VT.VMap I x rx0 = VT.vpart I I i x x (C.idD I x) ;
  q : Id (Obj I) x rx0 = symH (C.res-id I x) ;
  q' : Id (Obj J) (C.res J I u x) (C.res J I u rx0) = apH {Obj I} {Obj J} (\ w -> C.res J I u w) q ;
  p1 : Id (Obj J) (C.res J I u rx0) (C.res J I (compH J I I i u) x) = symH (C.res-comp J I I i u x) ;
  p0 : Id (Obj J) (C.res J I (compH J I I i u) x) (C.res J I u x) = apH {Hom J I} {Obj J} (\ w -> C.res J I w x) (comp-idl J I u) ;
  h : VT.VMap J (C.res J I u x) (C.res J I u rx0) = VT.rmap J I u x rx0 g0 ;
  hEq : Id (VT.VMap J (C.res J I u x) (C.res J I u rx0)) h (VT.trC J J (idH J) (C.res J I u x) (C.res J I u x) (C.res J I u rx0) q' (VT.vid J (C.res J I u x))) =
   transH (apH {VT.VMap I x rx0} {VT.VMap J (C.res J I u x) (C.res J I u rx0)} (\ w -> VT.rmap J I u x rx0 w) (VT.vpart-id I x))
    (transH (VT.rmap-trC J I u x x rx0 q (C.idD I x))
      (apH {VT.VMap J (C.res J I u x) (C.res J I u x)} {VT.VMap J (C.res J I u x) (C.res J I u rx0)} (\ w -> VT.trC J J (idH J) (C.res J I u x) (C.res J I u x) (C.res J I u rx0) q' w) (symH (VT.rmap-id J I u x)))) ;
  inner : Id (Ch J n (C.res J I u rx0) z) (KJ[J].K.rx n (C.res J I u x) (C.res J I u rx0) h z c) (trCh J n (C.res J I u x) (C.res J I u rx0) q' z c) =
   transH (apH {VT.VMap J (C.res J I u x) (C.res J I u rx0)} {Ch J n (C.res J I u rx0) z} (\ w -> KJ[J].K.rx n (C.res J I u x) (C.res J I u rx0) w z c) hEq)
    (transH (rx-trC J n (C.res J I u x) (C.res J I u x) (C.res J I u rx0) q' (VT.vid J (C.res J I u x)) z c)
      (apH {Ch J n (C.res J I u x) z} {Ch J n (C.res J I u rx0) z} (\ w -> trCh J n (C.res J I u x) (C.res J I u rx0) q' z w) (KJ[J].K.rx-id n (C.res J I u x) z c))) ;
  law : Id (Ch J n (C.res J I u x) z) (trCh J n (C.res J I (compH J I I i u) x) (C.res J I u x) p0 z (rxM J I I u i x x g0 n z c)) c =
   transH (apH {Ch J n (C.res J I u rx0) z} {Ch J n (C.res J I u x) z}
             (\ w -> trCh J n (C.res J I (compH J I I i u) x) (C.res J I u x) p0 z (trCh J n (C.res J I u rx0) (C.res J I (compH J I I i u) x) p1 z w)) inner)
    (transH (apH {Ch J n (C.res J I (compH J I I i u) x) z} {Ch J n (C.res J I u x) z} (\ w -> trCh J n (C.res J I (compH J I I i u) x) (C.res J I u x) p0 z w)
               (trCh-trans J n (C.res J I u x) (C.res J I u rx0) (C.res J I (compH J I I i u) x) q' p1 z c))
      (transH (trCh-trans J n (C.res J I u x) (C.res J I (compH J I I i u) x) (C.res J I u x) (transH q' p1) p0 z c)
        (trCh-refl J n (C.res J I u x) (transH (transH q' p1) p0) z c))) ;
 } ;

 -- the action's reindexing along the vertical part of a composite is the
 -- composite of the reindexings (after moving the head along associativity)
 module RxO (L K J I : Ob) (s : Hom L K) (v : Hom K J) (u : Hom J I) (z : Obj K) (y : Obj J) (x : Obj I) (f : VT.HomD J I u y x) (f' : VT.HomD K J v z y)
  (n : Nat) (z' : Obj L) (c : Ch L n (C.res L K s z) z') {
  uv : Hom K I = compH K J I u v ;
  vs : Hom L J = compH L K J v s ;
  g0 : VT.VMap J y (C.res J I u x) = VT.vpart J I u y x f ;
  g'0 : VT.VMap K z (C.res K J v y) = VT.vpart K J v z y f' ;
  g00 : VT.VMap K z (C.res K I uv x) = VT.vpart K I uv z x (C.compD K J I u v z y x f f') ;
  rux : Obj J = C.res J I u x ;
  rc : Id (Obj K) (C.res K I uv x) (C.res K J v rux) = C.res-comp K J I u v x ;
  rc1 : Id (Obj L) (C.res L I (compH L K I uv s) x) (C.res L K s (C.res K I uv x)) = C.res-comp L K I uv s x ;
  rc2 : Id (Obj L) (C.res L I (compH L J I u vs) x) (C.res L J vs rux) = C.res-comp L J I u vs x ;
  rcY : Id (Obj L) (C.res L J vs y) (C.res L K s (C.res K J v y)) = C.res-comp L K J v s y ;
  rcX : Id (Obj L) (C.res L J vs rux) (C.res L K s (C.res K J v rux)) = C.res-comp L K J v s rux ;
  h : VT.VMap L (C.res L J vs y) (C.res L J vs rux) = VT.rmap L J vs y rux g0 ;
  h' : VT.VMap L (C.res L K s z) (C.res L K s (C.res K J v y)) = VT.rmap L K s z (C.res K J v y) g'0 ;
  C1 : Ch L n (C.res L K s (C.res K J v y)) z' = KJ[L].K.rx n (C.res L K s z) (C.res L K s (C.res K J v y)) h' z' c ;
  X : Ch L n (C.res L J vs rux) z' = KJ[L].K.rx n (C.res L J vs y) (C.res L J vs rux) h z' (trCh L n (C.res L K s (C.res K J v y)) (C.res L J vs y) (symH rcY) z' C1) ;
  -- the left-hand side is X moved along rc2
  left : Id (Ch L n (C.res L I (compH L J I u vs) x) z') (rxM L J I vs u y x g0 n z' (rxM L K J s v z y g'0 n z' c))
           (trCh L n (C.res L J vs rux) (C.res L I (compH L J I u vs) x) (symH rc2) z' X) =
   refl (rxM L J I vs u y x g0 n z' (rxM L K J s v z y g'0 n z' c)) ;
  -- the map of the right-hand side
  m : VT.VMap L (C.res L K s z) (C.res L K s (C.res K I uv x)) = VT.rmap L K s z (C.res K I uv x) g00 ;
  sm : VT.VMap L (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux)) = VT.rmap L K s (C.res K J v y) (C.res K J v rux) (VT.rmap K J v y rux g0) ;
  smEq : Id (VT.VMap L (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux))) sm
           (VT.trC L L (idH L) (C.res L K s (C.res K J v y)) (C.res L J vs rux) (C.res L K s (C.res K J v rux)) rcX
             (VT.trD L L (idH L) (C.res L J vs y) (C.res L K s (C.res K J v y)) rcY (C.res L J vs rux) h)) =
   transH (symH (VT.trC-back L L (idH L) (C.res L K s (C.res K J v y)) (C.res L J vs rux) (C.res L K s (C.res K J v rux)) rcX sm))
    (apH {VT.VMap L (C.res L K s (C.res K J v y)) (C.res L J vs rux)} {VT.VMap L (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux))}
       (\ w -> VT.trC L L (idH L) (C.res L K s (C.res K J v y)) (C.res L J vs rux) (C.res L K s (C.res K J v rux)) rcX w)
       (transH (symH (VT.trD-back L L (idH L) (C.res L J vs y) (C.res L K s (C.res K J v y)) rcY (C.res L J vs rux)
                        (VT.trC L L (idH L) (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux)) (C.res L J vs rux) (symH rcX) sm)))
         (apH {VT.VMap L (C.res L J vs y) (C.res L J vs rux)} {VT.VMap L (C.res L K s (C.res K J v y)) (C.res L J vs rux)}
            (\ w -> VT.trD L L (idH L) (C.res L J vs y) (C.res L K s (C.res K J v y)) rcY (C.res L J vs rux) w) (symH (VT.rmap-o L K J v s y rux g0))))) ;
  mEq : Id (VT.VMap L (C.res L K s z) (C.res L K s (C.res K I uv x))) m
          (VT.trC L L (idH L) (C.res L K s z) (C.res L K s (C.res K J v rux)) (C.res L K s (C.res K I uv x)) (apH {Obj K} {Obj L} (\ w -> C.res L K s w) (symH rc))
            (VT.vcomp L (C.res L K s z) (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux)) sm h')) =
   transH (apH {VT.VMap K z (C.res K I uv x)} {VT.VMap L (C.res L K s z) (C.res L K s (C.res K I uv x))} (\ w -> VT.rmap L K s z (C.res K I uv x) w) (VT.vpart-o K J I u v z y x f f'))
    (transH (VT.rmap-trC L K s z (C.res K J v rux) (C.res K I uv x) (symH rc) (VT.vcomp K z (C.res K J v y) (C.res K J v rux) (VT.rmap K J v y rux g0) g'0))
      (apH {VT.VMap L (C.res L K s z) (C.res L K s (C.res K J v rux))} {VT.VMap L (C.res L K s z) (C.res L K s (C.res K I uv x))}
         (\ w -> VT.trC L L (idH L) (C.res L K s z) (C.res L K s (C.res K J v rux)) (C.res L K s (C.res K I uv x)) (apH {Obj K} {Obj L} (\ w2 -> C.res L K s w2) (symH rc)) w)
         (symH (VT.rmap-comp L K s z (C.res K J v y) (C.res K J v rux) (VT.rmap K J v y rux g0) g'0)))) ;
  pR : Id (Obj L) (C.res L J vs rux) (C.res L I (compH L K I uv s) x) =
   transH (transH rcX (apH {Obj K} {Obj L} (\ w -> C.res L K s w) (symH rc))) (symH rc1) ;
  -- the reindexing along m is X moved
  rxm : Id (Ch L n (C.res L K s (C.res K I uv x)) z') (KJ[L].K.rx n (C.res L K s z) (C.res L K s (C.res K I uv x)) m z' c)
          (trCh L n (C.res L J vs rux) (C.res L K s (C.res K I uv x)) (transH rcX (apH {Obj K} {Obj L} (\ w -> C.res L K s w) (symH rc))) z' X) =
   transH (apH {VT.VMap L (C.res L K s z) (C.res L K s (C.res K I uv x))} {Ch L n (C.res L K s (C.res K I uv x)) z'} (\ w -> KJ[L].K.rx n (C.res L K s z) (C.res L K s (C.res K I uv x)) w z' c) mEq)
    (transH (rx-trC L n (C.res L K s z) (C.res L K s (C.res K J v rux)) (C.res L K s (C.res K I uv x)) (apH {Obj K} {Obj L} (\ w -> C.res L K s w) (symH rc))
               (VT.vcomp L (C.res L K s z) (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux)) sm h') z' c)
      (transH (apH {Ch L n (C.res L K s (C.res K J v rux)) z'} {Ch L n (C.res L K s (C.res K I uv x)) z'}
                 (\ w -> trCh L n (C.res L K s (C.res K J v rux)) (C.res L K s (C.res K I uv x)) (apH {Obj K} {Obj L} (\ w2 -> C.res L K s w2) (symH rc)) z' w)
                 (transH (KJ[L].K.rx-o n (C.res L K s z) (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux)) sm h' z' c)
                   (transH (apH {VT.VMap L (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux))} {Ch L n (C.res L K s (C.res K J v rux)) z'}
                              (\ w -> KJ[L].K.rx n (C.res L K s (C.res K J v y)) (C.res L K s (C.res K J v rux)) w z' C1) smEq)
                     (transH (rx-trC L n (C.res L K s (C.res K J v y)) (C.res L J vs rux) (C.res L K s (C.res K J v rux)) rcX
                                (VT.trD L L (idH L) (C.res L J vs y) (C.res L K s (C.res K J v y)) rcY (C.res L J vs rux) h) z' C1)
                       (apH {Ch L n (C.res L J vs rux) z'} {Ch L n (C.res L K s (C.res K J v rux)) z'} (\ w -> trCh L n (C.res L J vs rux) (C.res L K s (C.res K J v rux)) rcX z' w)
                          (transH (apH {VT.VMap L (C.res L K s (C.res K J v y)) (C.res L J vs rux)} {Ch L n (C.res L J vs rux) z'}
                                     (\ w -> KJ[L].K.rx n (C.res L K s (C.res K J v y)) (C.res L J vs rux) w z' C1)
                                     (trD-irr L (C.res L J vs y) (C.res L K s (C.res K J v y)) (C.res L J vs rux) rcY (symH (symH rcY)) h))
                            (symH (rx-trD L n (C.res L K s (C.res K J v y)) (C.res L J vs y) (C.res L J vs rux) (symH rcY) h z' C1))))))))
        (trCh-trans L n (C.res L J vs rux) (C.res L K s (C.res K J v rux)) (C.res L K s (C.res K I uv x)) rcX (apH {Obj K} {Obj L} (\ w -> C.res L K s w) (symH rc)) z' X))) ;
  right : Id (Ch L n (C.res L I (compH L K I uv s) x) z') (rxM L K I s uv z x g00 n z' c)
            (trCh L n (C.res L J vs rux) (C.res L I (compH L K I uv s) x) pR z' X) =
   transH (apH {Ch L n (C.res L K s (C.res K I uv x)) z'} {Ch L n (C.res L I (compH L K I uv s) x) z'} (\ w -> trCh L n (C.res L K s (C.res K I uv x)) (C.res L I (compH L K I uv s) x) (symH rc1) z' w) rxm)
    (trCh-trans L n (C.res L J vs rux) (C.res L K s (C.res K I uv x)) (C.res L I (compH L K I uv s) x) (transH rcX (apH {Obj K} {Obj L} (\ w -> C.res L K s w) (symH rc))) (symH rc1) z' X) ;
  pA : Id (Obj L) (C.res L I (compH L J I u vs) x) (C.res L I (compH L K I uv s) x) =
   apH {Hom L I} {Obj L} (\ w -> C.res L I w x) (symH (comp-assoc L K J I u v s)) ;
  law : Id (Ch L n (C.res L I (compH L K I uv s) x) z')
          (trCh L n (C.res L I (compH L J I u vs) x) (C.res L I (compH L K I uv s) x) pA z' (rxM L J I vs u y x g0 n z' (rxM L K J s v z y g'0 n z' c)))
          (rxM L K I s uv z x g00 n z' c) =
   transH (apH {Ch L n (C.res L I (compH L J I u vs) x) z'} {Ch L n (C.res L I (compH L K I uv s) x) z'} (\ w -> trCh L n (C.res L I (compH L J I u vs) x) (C.res L I (compH L K I uv s) x) pA z' w) left)
    (transH (trCh-trans L n (C.res L J vs rux) (C.res L I (compH L J I u vs) x) (C.res L I (compH L K I uv s) x) (symH rc2) pA z' X)
      (transH (trCh-irr L n (C.res L J vs rux) (C.res L I (compH L K I uv s) x) (transH (symH rc2) pA) pR z' X) (symH right))) ;
 } ;
} ;
