-- Feed the single temporary (d)(3) premise to Proposition 58's h side
-- at every target copy.  The cE equivalence and commH remain separate.
level a ;
open Base ;
open Prelude[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module QP = CwFQP.QP[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Conditional (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y)
  (ms : (y' : SX.Over[R].Presentation) -> CDFwD3[a].D3[R, encK, pe, y, u, y'].MereSurj) {
 module RS = CRhoSig[a].RS[R, encK, pe, y, u] ;
 module HS = CRho2[a].HSide[R, encK, pe, y, u].Data[RS.A, RS.rho, RS.rho1] ;
 module At (y' : SX.Over[R].Presentation) {
  module D = CDFwD4[a].Move[R, encK, pe, y, u, y'] ;
  fwd : C.El C.nil (OV.Fun C.nil HS.Cp[y'].HU HS.Cp[y'].T0) = D.D.F.fwd ;
  Kd : C.El C.nil (QP.Kr C.nil HS.Cp[y'].T0 HS.Cp[y'].HU fwd) = D.Conditional[ms y'].Kd ;
 } ;
} ;
