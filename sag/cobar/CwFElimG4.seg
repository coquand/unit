-- CwFElimG4.seg (canonicity-c2; SIMPLIFIED.md item 3, the quotient's
-- eliminator into sets): (SA) a type X with internal set-ness
-- sp : isProp (Id(v1 , v2)) over G.X.X, read at two elements over any
-- context (CwFSetX3's At, for any X); (PR) the recipe's Sigma is a
-- proposition once one point a0 of the predicate is given (both values
-- are fD a0, App) and Id in B is a proposition over its inner context.
open Base ;

module ElimG4 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module PPr = CwFPropPair.PropPair[l, C, PS, SS, IJ, Un] ;
  module PPp = CwFPropProp.PropProp[l, C, PS, SS, IJ, Un, NF] ;
  module X1 = CwFSetX1.SetX1[l, C, PS, SS, IJ, Un, NF] ;
  module EG2 = CwFElimG2.ElimG2[l, C, PS, SS, IJ, Un, NF] ;

  module SA (G : Ctx) (X : Ty G) (sp : El (ext (ext G X) (wkT G X X)) (PU.isProp (ext (ext G X) (wkT G X X))
        (IJ.IdT (ext (ext G X) (wkT G X X)) (wkT (ext G X) (wkT G X X) (wkT G X X)) (wkE (ext G X) (wkT G X X) (wkT G X X) (q G X)) (q (ext G X) (wkT G X X))))) {
    G1 : Ctx = ext G X ;
    Xw : Ty G1 = wkT G X X ;
    G2 : Ctx = ext G1 Xw ;
    X2 : Ty G2 = wkT G1 Xw Xw ;
    v1 : El G2 X2 = wkE G1 Xw Xw (q G X) ;
    v2 : El G2 X2 = q G1 Xw ;
    T : Ty G2 = IJ.IdT G2 X2 v1 v2 ;
    SPT : Ty G2 = PU.isProp G2 T ;
    module At (D : Ctx) (sd : Sub D G) (Y : Ty D) (PY : Id (Ty D) (subT D G X sd) Y) (a b : El D Y) {
      a' : El D (subT D G X sd) = trE D Y (subT D G X sd) (sym (Ty D) (subT D G X sd) Y PY) a ;
      s1 : Sub D G1 = extS D G X sd a' ;
      PW1 : Id (Ty D) (subT D G1 Xw s1) (subT D G X sd) = IN.wkT-extS D G X X sd a' ;
      PXw : Id (Ty D) (subT D G1 Xw s1) Y = trans (Ty D) (subT D G1 Xw s1) (subT D G X sd) Y PW1 PY ;
      b' : El D (subT D G1 Xw s1) = trE D Y (subT D G1 Xw s1) (sym (Ty D) (subT D G1 Xw s1) Y PXw) b ;
      sg : Sub D G2 = extS D G1 Xw s1 b' ;
      PW2 : Id (Ty D) (subT D G2 X2 sg) (subT D G1 Xw s1) = IN.wkT-extS D G1 Xw Xw s1 b' ;
      PX2' : Id (Ty D) (subT D G2 X2 sg) Y = trans (Ty D) (subT D G2 X2 sg) (subT D G1 Xw s1) Y PW2 PXw ;
      qa : Id (El D (subT D G X sd)) (trE D (subT D G1 Xw s1) (subT D G X sd) PW1 (subt D G1 Xw (q G X) s1)) a' = JP.q-extS D G X sd a' PW1 ;
      o1 : Ov D G2 X2 sg Y PX2' v1 (trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1)) =
        ovTr D G2 X2 X2 (refl X2) sg (subT D G1 Xw s1) Y PXw PW2 PX2' v1 (subt D G1 Xw (q G X) s1)
          (IN.wkE-extS D G1 Xw Xw (q G X) s1 b' PW2) ;
      ea : Id (El D Y) (trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1)) a =
        calc (El D Y) {
            trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1)
          =< sym (El D Y) (trE D (subT D G X sd) Y PY (trE D (subT D G1 Xw s1) (subT D G X sd) PW1 (subt D G1 Xw (q G X) s1)))
               (trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1))
               (trE-tr D (subT D G1 Xw s1) (subT D G X sd) Y PW1 PY (subt D G1 Xw (q G X) s1)) >
            trE D (subT D G X sd) Y PY (trE D (subT D G1 Xw s1) (subT D G X sd) PW1 (subt D G1 Xw (q G X) s1))
          =< ap (El D (subT D G X sd)) (El D Y) (\ v -> trE D (subT D G X sd) Y PY v)
               (trE D (subT D G1 Xw s1) (subT D G X sd) PW1 (subt D G1 Xw (q G X) s1)) a' qa >
            trE D (subT D G X sd) Y PY a'
          =< JP.trE-sym D (subT D G X sd) Y PY a >
            a } ;
      ov1 : Ov D G2 X2 sg Y PX2' v1 a =
        trans (El D Y) (trE D (subT D G2 X2 sg) Y PX2' (subt D G2 X2 v1 sg)) (trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1)) a o1 ea ;
      o2 : Ov D G2 X2 sg Y PX2' v2 (trE D (subT D G1 Xw s1) Y PXw b') =
        ovTr D G2 X2 X2 (refl X2) sg (subT D G1 Xw s1) Y PXw PW2 PX2' v2 b' (JP.q-extS D G1 Xw s1 b' PW2) ;
      ov2 : Ov D G2 X2 sg Y PX2' v2 b =
        trans (El D Y) (trE D (subT D G2 X2 sg) Y PX2' (subt D G2 X2 v2 sg)) (trE D (subT D G1 Xw s1) Y PXw b') b o2
          (JP.trE-sym D (subT D G1 Xw s1) Y PXw b) ;
      PSP : Id (Ty D) (subT D G2 SPT sg) (PU.isProp D (IJ.IdT D Y a b)) =
        PU.isProp-ov D G2 T sg (IJ.IdT D Y a b) (Id-ov D G2 X2 v1 v2 sg Y PX2' a b ov1 ov2) ;
      law : El D (PU.isProp D (IJ.IdT D Y a b)) = trE D (subT D G2 SPT sg) (PU.isProp D (IJ.IdT D Y a b)) PSP (subt D G2 SPT sp sg) ;
    } ;
  } ;

  module PR (D : Ctx) (B T0 : Ty D) (P0 : El D (X1.FunU D T0)) (fD : El D (Fun D T0 B))
    (a0 : El D T0) (rho : El D (subT D (ext D T0) EG2.R[D, B, T0, P0, fD].TP0 (sec D T0 a0)))
    (idPE : El EG2.R[D, B, T0, P0, fD].E (PU.isProp EG2.R[D, B, T0, P0, fD].E EG2.R[D, B, T0, P0, fD].K.Y))
    (w1 w2 : El D EG2.R[D, B, T0, P0, fD].K.CF) {
    module RR = EG2.R[D, B, T0, P0, fD] ;
    b1 : El D B = IN.fst D B RR.K.H w1 ;
    b2 : El D B = IN.fst D B RR.K.H w2 ;
    module A1 = RR.AtB[b1] ;
    module A2 = RR.AtB[b2] ;
    g1 : El D A1.H0 = trE D (subT D RR.DB RR.K.H A1.sb) A1.H0 A1.Ho (IN.snd D B RR.K.H w1) ;
    g2 : El D A2.H0 = trE D (subT D RR.DB RR.K.H A2.sb) A2.H0 A2.Ho (IN.snd D B RR.K.H w2) ;
    e1 : El D (IJ.IdT D B (app D T0 B fD a0) b1) = A1.App[g1, a0, rho].res ;
    e2 : El D (IJ.IdT D B (app D T0 B fD a0) b2) = A2.App[g2, a0, rho].res ;
    e12 : El D (IJ.IdT D B b1 b2) = PT.transM D B b1 (app D T0 B fD a0) b2 (PT.symM D B (app D T0 B fD a0) b1 e1) e2 ;
    pH : El RR.DB (PU.isProp RR.DB RR.K.H) = PPp.piProp RR.DB RR.T RR.K.F (X1.funProp RR.E RR.K.TP RR.K.Y idPE) ;
    res : El D (IJ.IdT D RR.K.CF w1 w2) = PPr.At[D, B, RR.K.H].pairPath pH w1 w2 e12 ;
  } ;
} ;
