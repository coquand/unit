-- CInjP2.seg (canonicity-c2): CInjP, the use: from injectivity over nil.H
-- (Id of the two projections), the fibres of FunOf n are propositions.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module Use (A B : C.Ty C.nil) (n : HO.NMap[C.nil, A.1, B.1]) (sB : CQCtx[a].G3Of[B].SetQiTy)
  (zA zB : C.El (CInjP[a].IP[A, B, n].GH) (OV.wkT C.nil (CInjP[a].IP[A, B, n].H) A))
  (zAr : (K : Ob) (w : V1.Ix ((CInjP[a].IP[A, B, n].GH).ob K)) -> Id (V1.Ix (A.1.tob K w.1)) (zA.eob K w) w.2.1)
  (zBr : (K : Ob) (w : V1.Ix ((CInjP[a].IP[A, B, n].GH).ob K)) -> Id (V1.Ix (A.1.tob K w.1)) (zB.eob K w) w.2.2.1)
  (inj : C.El (CInjP[a].IP[A, B, n].GH) (IJ.IdT (CInjP[a].IP[A, B, n].GH) (OV.wkT C.nil (CInjP[a].IP[A, B, n].H) A) zA zB)) {
 module I = CInjP[a].IP[A, B, n] ;
 Nl : C.Ctx = C.nil ;
 E2 : C.Ctx = I.E2 ;
 HA : C.Ty I.GH = OV.wkT Nl I.H A ;
 TA : C.Ty E2 = C.subT E2 I.GH HA I.tau ;
 j1 : C.El E2 (IJ.IdT E2 TA (C.subt E2 I.GH HA zA I.tau) (C.subt E2 I.GH HA zB I.tau)) =
  OV.trE E2 (C.subT E2 I.GH (IJ.IdT I.GH HA zA zB) I.tau) (IJ.IdT E2 TA (C.subt E2 I.GH HA zA I.tau) (C.subt E2 I.GH HA zB I.tau))
   (IJ.IdT-nat E2 I.GH HA zA zB I.tau) (C.subt E2 I.GH (IJ.IdT I.GH HA zA zB) inj I.tau) ;
 PX : Id (C.Ty E2) TA I.X2 =
  transH (symH (C.subT-o E2 I.GH Nl A (C.p Nl I.H) I.tau))
   (transH (apH {C.Sub E2 Nl} {C.Ty E2} (\ s -> C.subT E2 Nl A s) (L.sub-ext E2 Nl (C.o E2 I.GH Nl (C.p Nl I.H) I.tau) I.s0 (\ K w -> refl (I.s0.nt K w))))
     (symH I.PA2)) ;
 j2 : C.El E2 (IJ.IdT E2 I.X2 (OV.trE E2 TA I.X2 PX (C.subt E2 I.GH HA zA I.tau)) (OV.trE E2 TA I.X2 PX (C.subt E2 I.GH HA zB I.tau))) =
  CInjP[a].idFwdL E2 TA I.X2 PX (C.subt E2 I.GH HA zA I.tau) (C.subt E2 I.GH HA zB I.tau) j1 ;
 rd (z : C.El I.GH HA) (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (I.X2.1.tob K w)) ((OV.trE E2 TA I.X2 PX (C.subt E2 I.GH HA z I.tau)).eob K w) (z.eob K (I.tau.nt K w)) =
  transH (CAppRd[a].trE-rd E2 TA I.X2 PX (C.subt E2 I.GH HA z I.tau) K w) (CAppRd[a].same-rd E2 TA I.X2 PX K w (refl (I.X2.1.tob K w)) (z.eob K (I.tau.nt K w))) ;
 ra (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (I.X2.1.tob K w)) ((OV.trE E2 TA I.X2 PX (C.subt E2 I.GH HA zA I.tau)).eob K w) (I.a1.eob K w) =
  transH (rd zA K w) (transH (zAr K (I.tau.nt K w)) (I.br I.a1 K w)) ;
 rb (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (I.X2.1.tob K w)) ((OV.trE E2 TA I.X2 PX (C.subt E2 I.GH HA zB I.tau)).eob K w) (I.a2.eob K w) =
  transH (rd zB K w) (transH (zBr K (I.tau.nt K w))
   (transH (transH (CAppRd[a].trE-rd E2 (C.subT E2 Nl A I.s0) (C.subT E2 I.D1 I.Aw I.t1) I.PT1 I.b2 K w)
              (CAppRd[a].same-rd E2 (C.subT E2 Nl A I.s0) (C.subT E2 I.D1 I.Aw I.t1) I.PT1 K w (refl (A.1.tob K (I.s0.nt K w))) (I.b2.eob K w)))
     (I.br I.a2 K w))) ;
 e : C.El E2 (IJ.IdT E2 I.X2 I.a1 I.a2) =
  CCmpU14[a].rwId E2 I.X2 (OV.trE E2 TA I.X2 PX (C.subt E2 I.GH HA zA I.tau)) I.a1 (OV.trE E2 TA I.X2 PX (C.subt E2 I.GH HA zB I.tau)) I.a2 ra rb j2 ;
} ;
