-- CTotPsi2.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for lines
-- at the total site, part 2: Psi of a line of D G at an index q of X.
--   L0     the levelwise line of U G at (J, z): at a levelwise map (v, e)
--          the line read at cart (u . v) x at the identity index of the
--          restricted chain (its tail moved along e); natural
--   psiq   its extension to a line of G at (J, z) (CTotUExt)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi2 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) {
 module PO = CTotPsi[a, vl, l].PsiOf[C, G] ;
 module TR = PO.TR ;
 module G0 = TR.G0 ;
 module TC = PO.TC ;
 module VT = PO.VT ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module CL = PO.CL ;
 resres (n : Nat) (W'' W' W : Ob) (h : Hom W' W) (chi : Hom W'' W') (i : Wt.Pn n W)
  : Id (Wt.Pn n W'') (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res) (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res) =
  Sigma-eq (Wt.Coords n W'') (\ cs -> PB.Lands W'' W'' (Wt.oneS n W'' cs) (PB.idH W''))
   (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).1 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1
   (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).2 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).2
   (funext (Arith[a].Fin (suc n)) (\ k -> Hom W'' PosFull[a].ivO)
      (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).1 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1
      (\ k -> PB.comp-assoc W'' W' W PosFull[a].ivO (i.1 k) h chi))
   (PB.isProp-Lands W'' W'' (Wt.oneS n W'' (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1) (PB.idH W'')) ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;
 module UX = CTotUExt[a, vl, l].UExt[C] ;
 module XB = UX.FI.XG[PO.GP] ;
 UG : TR.P0.PCtx = TR.RS.rC PO.GP ;

 module PQ (X : TC.TOb) (ln : W0.Ix (PO.FL.ob X)) (n : Nat) (J : Ob) (u : Hom J X.1) (z : Obj J)
   (c : CT.Ch J n (C.res J X.1 u X.2) z) (i : Wt.Pn n J) {
  module P = PO.PL[X, ln] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  Y : Ob0 = (J, z) ;
  rdS (W1 : Ob) (y : Obj W1) (sw : D.S I x n W1 y) (R : Wt.Pn n W1) (j : PB.IvP W1) : W0.Ix (G.ob W1 y) = P.rdC n W1 y sw.1 sw.2 R j ;
  cT (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) : CT.Ch W1 n (C.res W1 I (compH W1 J I u v) x) y =
   subst (Obj W1) (\ t -> CT.Ch W1 n (C.res W1 I (compH W1 J I u v) x) t) (C.res W1 J v z) y e (DO.rCh W1 J I v u x n z c) ;
  vg (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) (j : PB.IvP W1) : W0.Ix (G.ob W1 y) =
   P.rdC n W1 y (compH W1 J I u v) (cT W1 v y e) (Wt.Res[n, W1, J, v, i].res) j ;
  module NG (W1 : Ob) (v : Hom W1 J) (j : PB.IvP W1) (W2 : Ob) (w : Hom W2 W1) {
   rz : Obj W1 = C.res W1 J v z ;
   T0 : Obj W2 = C.res W2 W1 w rz ;
   vw : Hom W2 J = compH W2 W1 J v w ;
   uv : Hom W1 I = compH W1 J I u v ;
   j' : PB.IvP W2 = PB.ivA W2 W1 w j ;
   module N = P.NC[n, W1, rz, uv, DO.rCh W1 J I v u x n z c, Wt.Res[n, W1, J, v, i].res, j, W2, w] ;
   module R2 = CL.RC2[W2, W1, J, I, w, v, u, x, n, z, c] ;
   SP (eT : Id (Obj W2) (C.res W2 J vw z) T0)
    : Id (D.S I x n W2 T0) (compH W2 W1 I uv w, DO.rCh W2 W1 I w uv x n rz (DO.rCh W1 J I v u x n z c)) (compH W2 J I u vw, cT W2 vw T0 eT) =
    D.sEq I x n W2 T0 (compH W2 W1 I uv w) (compH W2 J I u vw) (comp-assoc W2 W1 J I u v w)
     (DO.rCh W2 W1 I w uv x n rz (DO.rCh W1 J I v u x n z c)) (cT W2 vw T0 eT)
     (transH R2.law
        (apH {Id (Obj W2) (C.res W2 J vw z) T0} {CT.Ch W2 n (C.res W2 I (compH W2 J I u vw) x) T0} (\ e -> cT W2 vw T0 e)
           (CT.setObj W2 (C.res W2 J vw z) T0 R2.et eT))) ;
   base (eT : Id (Obj W2) (C.res W2 J vw z) T0)
    : Id (W0.Ix (G.ob W2 T0)) (G.act W2 W1 w T0 rz (C.cart W2 W1 w rz) (vg W1 v rz (refl rz) j)) (vg W2 vw T0 eT j') =
    transH N.nat
     (transH (apH {D.S I x n W2 T0} {W0.Ix (G.ob W2 T0)} (\ sw -> rdS W2 T0 sw (Wt.Res[n, W2, W1, w, Wt.Res[n, W1, J, v, i].res].res) j') (SP eT))
       (apH {Wt.Pn n W2} {W0.Ix (G.ob W2 T0)} (\ r -> rdS W2 T0 (compH W2 J I u vw, cT W2 vw T0 eT) r j')
          (resres n W2 W1 J v w i))) ;
   natg (y : Obj W1) (e : Id (Obj W1) rz y) (y2 : Obj W2) (e2 : Id (Obj W2) (C.res W2 W1 w y) y2) (eT : Id (Obj W2) (C.res W2 J vw z) y2)
    : Id (W0.Ix (G.ob W2 y2)) (G.act W2 W1 w y2 y (VT.trD W2 W1 w (C.res W2 W1 w y) y2 e2 y (C.cart W2 W1 w y)) (vg W1 v y e j))
        (vg W2 vw y2 eT j') =
    idJ (Obj W1) rz
     (\ y' e' -> (y3 : Obj W2) (e3 : Id (Obj W2) (C.res W2 W1 w y') y3) (eT3 : Id (Obj W2) (C.res W2 J vw z) y3)
        -> Id (W0.Ix (G.ob W2 y3)) (G.act W2 W1 w y3 y' (VT.trD W2 W1 w (C.res W2 W1 w y') y3 e3 y' (C.cart W2 W1 w y')) (vg W1 v y' e' j))
             (vg W2 vw y3 eT3 j'))
     (\ y3 e3 -> idJ (Obj W2) T0
        (\ y4 e4 -> (eT4 : Id (Obj W2) (C.res W2 J vw z) y4)
           -> Id (W0.Ix (G.ob W2 y4)) (G.act W2 W1 w y4 rz (VT.trD W2 W1 w T0 y4 e4 rz (C.cart W2 W1 w rz)) (vg W1 v rz (refl rz) j))
                (vg W2 vw y4 eT4 j'))
        base y3 e3)
     y e y2 e2 eT ;
  } ;
  -- the levelwise line, and its extension
  L0 : W0.Ix (XB.RH.F0.ob Y) =
   (\ W h j -> vg W.1 h.1 W.2 (symH h.2) j,
    \ W' W chi h j -> NG[W.1, h.1, j, W'.1, chi.1].natg W.2 (symH h.2) W'.2 (symH chi.2) (symH (G0.GB.BC.oC W' W Y h chi).2)) ;
  psiq : W0.Ix (XB.RH.F1.ob (TR.RN.o Y)) = XB.extV Y L0 ;
 } ;
} ;
