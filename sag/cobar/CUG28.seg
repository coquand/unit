-- CUG28.seg (canonicity-c2; the generic (U), part 28 of CCmpU28's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU28 with
-- F2 replaced by s and the generator cases a hypothesis gen.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module UG28 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) (gen : (v : SX.Fin s.1) -> C.El (C.ext C.nil H) (CUG20[a].UG20[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN].IdZ (CHomT3[a].HomP[R, encK, pe].Alg[s].AX.cls (var v)))) {
 module U27m = CUG27[a].UG27[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN, gen] ;
 module E6 = U27m.E6 ;
 Nl : C.Ctx = C.nil ;
 QY : C.Ty Nl = U27m.QY ;
 GH : C.Ctx = U27m.GH ;
 QH6 : C.Ty GH = U27m.QH6 ;
 QYh : C.Ty GH = U27m.QYh ;
 GHQ : C.Ctx = C.ext GH QH6 ;
 sB : CQCtx[a].G3Of[QY].SetQiTy = U27m.sB ;
 f : C.El GH (OV.Fun GH QH6 QYh) = U27m.ZA.f ;
 g : C.El GH (OV.Fun GH QH6 QYh) = U27m.ZB.f ;
 h (t : E6.AX.Term) : C.El GH (IJ.IdT GH QYh (OV.app GH QH6 QYh f (OV.wkE Nl H E6.Qt (E6.AX.cls t))) (OV.app GH QH6 QYh g (OV.wkE Nl H E6.Qt (E6.AX.cls t)))) = U27m.h3 t ;

BH : C.Ty GH = QYh ;
WB : C.Ty GHQ = OV.wkT GH QH6 BH ;
Pw : C.Ty GHQ = IJ.IdT GHQ WB (OV.bod GH QH6 WB f) (OV.bod GH QH6 WB g) ;
sE : C.Sub GHQ Nl = C.o GHQ GH Nl (C.p Nl H) (C.p GH QH6) ;
PWB : Id (C.Ty GHQ) (C.subT GHQ Nl QY sE) WB = C.subT-o GHQ GH Nl QY (C.p Nl H) (C.p GH QH6) ;
pPw : C.El GHQ (PU.isProp GHQ Pw) =
 idJ (C.Ty GHQ) (C.subT GHQ Nl QY sE)
   (\ Y2 P2 -> (u v : C.El GHQ Y2) -> C.El GHQ (PU.isProp GHQ (IJ.IdT GHQ Y2 u v)))
   (\ u v -> CwFFunSetB[a].SetB[QY, sB].idPB GHQ sE u v) WB PWB (OV.bod GH QH6 WB f) (OV.bod GH QH6 WB g) ;
module T (t : E6.AX.Term) {
 ct : C.El GH QH6 = OV.wkE Nl H E6.Qt (E6.AX.cls t) ;
 PI : Id (C.Ty GH) (C.subT GH GHQ Pw (C.sec GH QH6 ct)) (IJ.IdT GH BH (OV.app GH QH6 BH f ct) (OV.app GH QH6 BH g ct)) =
  OV.Id-ov GH GHQ WB (OV.bod GH QH6 WB f) (OV.bod GH QH6 WB g) (C.sec GH QH6 ct) BH
    (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH6 BH ct) (OV.app GH QH6 BH f ct) (OV.app GH QH6 BH g ct)
    (refl (OV.app GH QH6 BH f ct)) (refl (OV.app GH QH6 BH g ct)) ;
 hh : C.El GH (C.subT GH GHQ Pw (C.sec GH QH6 ct)) =
  OV.trE GH (IJ.IdT GH BH (OV.app GH QH6 BH f ct) (OV.app GH QH6 BH g ct)) (C.subT GH GHQ Pw (C.sec GH QH6 ct)) (symH PI) (h t) ;
} ;
pw : C.El GHQ Pw = E6.elimPH H Pw pPw (\ t -> T[t].hh) ;
res : C.El GH (IJ.IdT GH (OV.Fun GH QH6 QYh) f g) = FibNF[a, a+].nf GH QH6 WB f g (OV.lam GH QH6 Pw pw) ;
} ;
