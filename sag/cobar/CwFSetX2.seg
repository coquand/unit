-- CwFSetX2.seg (canonicity-c2; SIMPLIFIED.md item 3, the quotient's
-- set-ness): X = Sigma (P : B -> PropU) Tr(P), Tr a family of
-- propositions, is a set, in a CwF with Pi, Sigma, Swan Id, a universe,
-- naive funext NF and propositional extensionality pe.
--
-- Informal text.  Fix x : X.  Over G.X (variable y) let
-- R(y) = Rel(fst x , fst y) (CwFSetX1), a proposition; rho : R(x) is
-- rflR, read along sec x (RelN).  f : R(y) -> Id(x , y): for r : R(y), at
-- each b the two maps give fst x b = fst y b in PropU (pe, then a pair
-- path), so fst x = fst y (NF), so x = y (pair path, Tr a proposition).
-- Hedberg (CwFHed4) gives: two paths u u' : Id(x , y) are joined.
open Base ;

module SetX2 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g))
  (pe : CwFPropU.PropU[l, C, PS, SS, IJ, Un].PropExtTy) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module PPr = CwFPropPair.PropPair[l, C, PS, SS, IJ, Un] ;
  module PPp = CwFPropProp.PropProp[l, C, PS, SS, IJ, Un, NF] ;
  module MP = CwFMaps.Maps[l, C, PS, SS, IJ] ;
  module X1 = CwFSetX1.SetX1[l, C, PS, SS, IJ, Un, NF] ;
  module H4 = CwFHed4.Hed4[l, C, PS, SS, IJ] ;

  idBack (G : Ctx) (X X' : Ty G) (P : Id (Ty G) X X') (x y : El G X)
    (u : El G (IJ.IdT G X' (trE G X X' P x) (trE G X X' P y))) : El G (IJ.IdT G X x y) =
    idJ (Ty G) X (\ Z PZ -> El G (IJ.IdT G Z (trE G X Z PZ x) (trE G X Z PZ y)) -> El G (IJ.IdT G X x y)) (\ v -> v) X' P u ;

  module SX (G : Ctx) (B : Ty G) (Tr : Ty (ext G (X1.FunU G B))) (pT : El (ext G (X1.FunU G B)) (PU.isProp (ext G (X1.FunU G B)) Tr))
    (x : El G (SS.Sig G (X1.FunU G B) Tr)) {
    PA : Ty G = X1.FunU G B ;
    X : Ty G = SS.Sig G PA Tr ;
    module FF = MP.FstF[G, PA, Tr] ;
    GX : Ctx = ext G X ;
    pX : Sub GX G = p G X ;
    BX : Ty GX = wkT G X B ;
    Xd : Ty GX = FF.Xd ;
    PFp : Id (Ty GX) Xd (X1.FunU GX BX) = X1.PF GX G pX B BX (refl BX) ;
    SGX : Ty GX = SS.Sig GX Xd FF.Yd ;
    xw : El GX (wkT G X X) = wkE G X X x ;
    -- the predicate of an element over G.X
    Pz (z : El GX (wkT G X X)) : El GX (X1.FunU GX BX) = trE GX Xd (X1.FunU GX BX) PFp (IN.fst GX Xd FF.Yd (trE GX (wkT G X X) SGX FF.SW z)) ;
    Px : El GX (X1.FunU GX BX) = Pz xw ;
    Py : El GX (X1.FunU GX BX) = Pz (q G X) ;
    R : Ty GX = X1.Rel GX BX Px Py ;
    pR : El GX (PU.isProp GX R) = X1.pRel GX BX Px Py ;
    -- rho: R at x is Rel(fst x , fst x)
    fx : El G PA = IN.fst G PA Tr x ;
    PB0 : Id (Ty G) (subT G GX BX (sec G X x)) B = p-sec-T G X B x ;
    PFs : Id (Ty G) (subT G GX (X1.FunU GX BX) (sec G X x)) PA = X1.PF G GX (sec G X x) BX B PB0 ;
    PXs : Id (Ty G) (subT G GX Xd (sec G X x)) PA = p-sec-T G X PA x ;
    fxw : Id (El GX Xd) (IN.fst GX Xd FF.Yd (trE GX (wkT G X X) SGX FF.SW xw)) (wkE G X PA fx) =
      IN.fst-nat GX G PA Tr pX FF.Yd (refl FF.Yd) FF.SW x ;
    oX0 : Ov G GX Xd (sec G X x) PA PXs (IN.fst GX Xd FF.Yd (trE GX (wkT G X X) SGX FF.SW xw)) fx =
      trans (El G PA) (trE G (subT G GX Xd (sec G X x)) PA PXs (subt G GX Xd (IN.fst GX Xd FF.Yd (trE GX (wkT G X X) SGX FF.SW xw)) (sec G X x)))
        (trE G (subT G GX Xd (sec G X x)) PA PXs (subt G GX Xd (wkE G X PA fx) (sec G X x))) fx
        (ap (El GX Xd) (El G PA) (\ v -> trE G (subT G GX Xd (sec G X x)) PA PXs (subt G GX Xd v (sec G X x)))
           (IN.fst GX Xd FF.Yd (trE GX (wkT G X X) SGX FF.SW xw)) (wkE G X PA fx) fxw)
        (IN.wkE-sec G X PA x fx PXs) ;
    oX : Ov G GX (X1.FunU GX BX) (sec G X x) PA PFs Px fx =
      ovTr G GX Xd (X1.FunU GX BX) PFp (sec G X x) PA PA (refl PA) PXs PFs (IN.fst GX Xd FF.Yd (trE GX (wkT G X X) SGX FF.SW xw)) fx oX0 ;
    oY : Ov G GX (X1.FunU GX BX) (sec G X x) PA PFs Py fx =
      ovTr G GX Xd (X1.FunU GX BX) PFp (sec G X x) PA PA (refl PA) FF.At[x].PX PFs FF.m fx
        (IN.fst-ov G GX Xd FF.Yd (sec G X x) PA FF.At[x].PX Tr (FF.At[x].US.fam Tr) FF.At[x].PW FF.qS x FF.At[x].Pw) ;
    RN : Id (Ty G) (subT G GX R (sec G X x)) (X1.Rel G B fx fx) = X1.RelN G GX (sec G X x) BX Px Py B PB0 fx fx oX oY ;
    rho : El G (subT G GX R (sec G X x)) =
      trE G (X1.Rel G B fx fx) (subT G GX R (sec G X x)) (sym (Ty G) (subT G GX R (sec G X x)) (X1.Rel G B fx fx) RN) (X1.rflR G B fx) ;
    -- f : R -> Id(x , y), over G.X.R
    GXR : Ctx = ext GX R ;
    pR' : Sub GXR GX = p GX R ;
    B2 : Ty GXR = wkT GX R BX ;
    Xd2 : Ty GXR = subT GXR GX Xd pR' ;
    Yd2 : Ty (ext GXR Xd2) = subT (ext GXR Xd2) (ext GX Xd) FF.Yd (lift GXR GX Xd pR') ;
    S2 : Ty GXR = SS.Sig GXR Xd2 Yd2 ;
    F2 : Id (Ty GXR) (subT GXR GX SGX pR') S2 = SS.Sig-nat GXR GX Xd FF.Yd pR' ;
    wz (z : El GX (wkT G X X)) : El GXR S2 = trE GXR (subT GXR GX SGX pR') S2 F2 (subt GXR GX SGX (trE GX (wkT G X X) SGX FF.SW z) pR') ;
    PFr : Id (Ty GXR) (subT GXR GX (X1.FunU GX BX) pR') (X1.FunU GXR B2) = X1.PF GXR GX pR' BX B2 (refl B2) ;
    PX2 : Id (Ty GXR) Xd2 (X1.FunU GXR B2) =
      trans (Ty GXR) Xd2 (subT GXR GX (X1.FunU GX BX) pR') (X1.FunU GXR B2)
        (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') Xd (X1.FunU GX BX) PFp) PFr ;
    P' (z : El GX (wkT G X X)) : El GXR (X1.FunU GXR B2) = trE GXR Xd2 (X1.FunU GXR B2) PX2 (IN.fst GXR Xd2 Yd2 (wz z)) ;
    oZ (z : El GX (wkT G X X)) : Ov GXR GX (X1.FunU GX BX) pR' (X1.FunU GXR B2) PFr (Pz z) (P' z) =
      calc (El GXR (X1.FunU GXR B2)) {
          trE GXR (subT GXR GX (X1.FunU GX BX) pR') (X1.FunU GXR B2) PFr (subt GXR GX (X1.FunU GX BX) (Pz z) pR')
        =< ap (El GXR (subT GXR GX (X1.FunU GX BX) pR')) (El GXR (X1.FunU GXR B2)) (\ v -> trE GXR (subT GXR GX (X1.FunU GX BX) pR') (X1.FunU GXR B2) PFr v)
             (subt GXR GX (X1.FunU GX BX) (Pz z) pR')
             (trE GXR Xd2 (subT GXR GX (X1.FunU GX BX) pR') (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') Xd (X1.FunU GX BX) PFp) (subt GXR GX Xd az pR'))
             (subt-tr GXR GX Xd (X1.FunU GX BX) PFp az pR') >
          trE GXR (subT GXR GX (X1.FunU GX BX) pR') (X1.FunU GXR B2) PFr
            (trE GXR Xd2 (subT GXR GX (X1.FunU GX BX) pR') (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') Xd (X1.FunU GX BX) PFp) (subt GXR GX Xd az pR'))
        =< trE-tr GXR Xd2 (subT GXR GX (X1.FunU GX BX) pR') (X1.FunU GXR B2) (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') Xd (X1.FunU GX BX) PFp) PFr
             (subt GXR GX Xd az pR') >
          trE GXR Xd2 (X1.FunU GXR B2) PX2 (subt GXR GX Xd az pR')
        =< ap (El GXR Xd2) (El GXR (X1.FunU GXR B2)) (\ v -> trE GXR Xd2 (X1.FunU GXR B2) PX2 v) (subt GXR GX Xd az pR') (IN.fst GXR Xd2 Yd2 (wz z))
             (sym (El GXR Xd2) (IN.fst GXR Xd2 Yd2 (wz z)) (subt GXR GX Xd az pR')
                (IN.fst-nat GXR GX Xd FF.Yd pR' Yd2 (refl Yd2) F2 (trE GX (wkT G X X) SGX FF.SW z))) >
          P' z }
     where { az : El GX Xd = IN.fst GX Xd FF.Yd (trE GX (wkT G X X) SGX FF.SW z) ; } ;
    Pxr : El GXR (X1.FunU GXR B2) = P' xw ;
    Pyr : El GXR (X1.FunU GXR B2) = P' (q G X) ;
    RN2 : Id (Ty GXR) (subT GXR GX R pR') (X1.Rel GXR B2 Pxr Pyr) = X1.RelN GXR GX pR' BX Px Py B2 (refl B2) Pxr Pyr (oZ xw) (oZ (q G X)) ;
    rr : El GXR (X1.Rel GXR B2 Pxr Pyr) = trE GXR (subT GXR GX R pR') (X1.Rel GXR B2 Pxr Pyr) RN2 (q GX R) ;
    module RR = X1.RelOf[GXR, B2, Pxr, Pyr] ;
    bd : El RR.DB RR.S = bod GXR B2 RR.S rr ;
    g1 : El RR.DB RR.F1 = IN.fst RR.DB RR.F1 (wkT RR.DB RR.F1 RR.F2) bd ;
    g2 : El RR.DB RR.F2 =
      trE RR.DB (subT RR.DB (ext RR.DB RR.F1) (wkT RR.DB RR.F1 RR.F2) (sec RR.DB RR.F1 g1)) RR.F2 (p-sec-T RR.DB RR.F1 RR.F2 g1)
        (IN.snd RR.DB RR.F1 (wkT RR.DB RR.F1 RR.F2) bd) ;
    ec : El RR.DB (IJ.IdT RR.DB (Un.Cod RR.DB) (PU.codeOf RR.DB RR.mP) (PU.codeOf RR.DB RR.mQ)) =
      pe RR.DB (PU.codeOf RR.DB RR.mP) (PU.codeOf RR.DB RR.mQ) (PU.decProp RR.DB RR.mP) (PU.decProp RR.DB RR.mQ)
        (bod RR.DB RR.TP (wkT RR.DB RR.TP RR.TQ) g1) (bod RR.DB RR.TQ (wkT RR.DB RR.TQ RR.TP) g2) ;
    KD : Ctx = ext RR.DB (Un.Cod RR.DB) ;
    em : El RR.DB (IJ.IdT RR.DB (PU.PropU RR.DB) RR.mP RR.mQ) =
      PPr.At[RR.DB, Un.Cod RR.DB, PU.PropFam RR.DB].pairPath (PPp.propProp KD (Un.Dec KD (PU.UU.qc RR.DB))) RR.mP RR.mQ ec ;
    hD : El RR.DB (IJ.IdT RR.DB RR.WU (bod GXR B2 RR.WU Pxr) (bod GXR B2 RR.WU Pyr)) =
      idBack RR.DB RR.WU (PU.PropU RR.DB) RR.PWU (bod GXR B2 RR.WU Pxr) (bod GXR B2 RR.WU Pyr) em ;
    e0 : El GXR (IJ.IdT GXR (X1.FunU GXR B2) Pxr Pyr) =
      NF GXR B2 RR.WU Pxr Pyr (lam GXR B2 (IJ.IdT RR.DB RR.WU (bod GXR B2 RR.WU Pxr) (bod GXR B2 RR.WU Pyr)) hD) ;
    e1 : El GXR (IJ.IdT GXR Xd2 (IN.fst GXR Xd2 Yd2 (wz xw)) (IN.fst GXR Xd2 Yd2 (wz (q G X)))) =
      idBack GXR Xd2 (X1.FunU GXR B2) PX2 (IN.fst GXR Xd2 Yd2 (wz xw)) (IN.fst GXR Xd2 Yd2 (wz (q G X))) e0 ;
    pT1 : El (ext GX Xd) (PU.isProp (ext GX Xd) FF.Yd) =
      trE (ext GX Xd) (subT (ext GX Xd) (ext G PA) (PU.isProp (ext G PA) Tr) FF.up0) (PU.isProp (ext GX Xd) FF.Yd)
        (PU.isProp-ov (ext GX Xd) (ext G PA) Tr FF.up0 FF.Yd (refl FF.Yd)) (subt (ext GX Xd) (ext G PA) (PU.isProp (ext G PA) Tr) pT FF.up0) ;
    pT2 : El (ext GXR Xd2) (PU.isProp (ext GXR Xd2) Yd2) =
      trE (ext GXR Xd2) (subT (ext GXR Xd2) (ext GX Xd) (PU.isProp (ext GX Xd) FF.Yd) (lift GXR GX Xd pR')) (PU.isProp (ext GXR Xd2) Yd2)
        (PU.isProp-ov (ext GXR Xd2) (ext GX Xd) FF.Yd (lift GXR GX Xd pR') Yd2 (refl Yd2))
        (subt (ext GXR Xd2) (ext GX Xd) (PU.isProp (ext GX Xd) FF.Yd) pT1 (lift GXR GX Xd pR')) ;
    pS : El GXR (IJ.IdT GXR S2 (wz xw) (wz (q G X))) = PPr.At[GXR, Xd2, Yd2].pairPath pT2 (wz xw) (wz (q G X)) e1 ;
    -- back to Id(x , y) read over G.X.R
    XR : Ty GXR = subT GXR GX (wkT G X X) pR' ;
    FS : Id (Ty GXR) XR S2 =
      trans (Ty GXR) XR (subT GXR GX SGX pR') S2 (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') (wkT G X X) SGX FF.SW) F2 ;
    wzEq (z : El GX (wkT G X X)) : Id (El GXR S2) (wz z) (trE GXR XR S2 FS (subt GXR GX (wkT G X X) z pR')) =
      trans (El GXR S2) (wz z)
        (trE GXR (subT GXR GX SGX pR') S2 F2 (trE GXR XR (subT GXR GX SGX pR') (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') (wkT G X X) SGX FF.SW) (subt GXR GX (wkT G X X) z pR')))
        (trE GXR XR S2 FS (subt GXR GX (wkT G X X) z pR'))
        (ap (El GXR (subT GXR GX SGX pR')) (El GXR S2) (\ v -> trE GXR (subT GXR GX SGX pR') S2 F2 v)
           (subt GXR GX SGX (trE GX (wkT G X X) SGX FF.SW z) pR')
           (trE GXR XR (subT GXR GX SGX pR') (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') (wkT G X X) SGX FF.SW) (subt GXR GX (wkT G X X) z pR'))
           (subt-tr GXR GX (wkT G X X) SGX FF.SW z pR'))
        (trE-tr GXR XR (subT GXR GX SGX pR') S2 (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') (wkT G X X) SGX FF.SW) F2 (subt GXR GX (wkT G X X) z pR')) ;
    pS' : El GXR (IJ.IdT GXR S2 (trE GXR XR S2 FS (subt GXR GX (wkT G X X) xw pR')) (trE GXR XR S2 FS (subt GXR GX (wkT G X X) (q G X) pR'))) =
      subst (El GXR S2) (\ v -> El GXR (IJ.IdT GXR S2 v (trE GXR XR S2 FS (subt GXR GX (wkT G X X) (q G X) pR'))))
        (wz xw) (trE GXR XR S2 FS (subt GXR GX (wkT G X X) xw pR')) (wzEq xw)
        (subst (El GXR S2) (\ v -> El GXR (IJ.IdT GXR S2 (wz xw) v)) (wz (q G X)) (trE GXR XR S2 FS (subt GXR GX (wkT G X X) (q G X) pR')) (wzEq (q G X)) pS) ;
    IK : Ty GX = JP.IK G X x ;
    IKr : Id (Ty GXR) (subT GXR GX IK pR') (IJ.IdT GXR XR (subt GXR GX (wkT G X X) xw pR') (subt GXR GX (wkT G X X) (q G X) pR')) =
      Id-ov GXR GX (wkT G X X) xw (q G X) pR' XR (refl XR) (subt GXR GX (wkT G X X) xw pR') (subt GXR GX (wkT G X X) (q G X) pR')
        (refl (subt GXR GX (wkT G X X) xw pR')) (refl (subt GXR GX (wkT G X X) (q G X) pR')) ;
    f : El GXR (wkT GX R IK) =
      trE GXR (IJ.IdT GXR XR (subt GXR GX (wkT G X X) xw pR') (subt GXR GX (wkT G X X) (q G X) pR')) (subT GXR GX IK pR')
        (sym (Ty GXR) (subT GXR GX IK pR') (IJ.IdT GXR XR (subt GXR GX (wkT G X X) xw pR') (subt GXR GX (wkT G X X) (q G X) pR')) IKr)
        (idBack GXR XR S2 FS (subt GXR GX (wkT G X X) xw pR') (subt GXR GX (wkT G X X) (q G X) pR') pS') ;
    -- Hedberg
    module HH = H4.Hed[G, X, x, R, rho, f] ;
    module Fin (y : El G X) (u u' : El G (IJ.IdT G X x y)) {
      Ry : Ty G = subT G GX R (sec G X y) ;
      pRy : El G (PU.isProp G Ry) =
        trE G (subT G GX (PU.isProp GX R) (sec G X y)) (PU.isProp G Ry) (PU.isProp-ov G GX R (sec G X y) Ry (refl Ry)) (subt G GX (PU.isProp GX R) pR (sec G X y)) ;
      res : El G (IJ.IdT G (IJ.IdT G X x y) u u') =
        HH.Fin[y, u, u', PU.propPath G Ry pRy (TR.trP G X R x y u rho) (TR.trP G X R x y u' rho)].res ;
    } ;
  } ;
} ;
