-- CPshPiStr.seg (canonicity-c2; COBAR.md (B) stage 2(c)): abstraction
-- commutes with C-substitution (Pi-iso-nat), and the Pi structure
-- CwF.Formers.PiStr on the raw CwF of C-presheaves (CPCwF).
--
-- Pi-iso-nat.  (lam v)[s], transported along Pi-nat, is lam (v[lift s]):
-- at x and d, the component (y , f) of the transport is tr of the base
-- abstraction of v_y at act f (s d) (trFst); moved along s.sb-nat it is
-- the base abstraction at s (act f d) (v_y is an element: apd-el), and
-- moved along the base Pi-nat it is the base abstraction of v_y[lift s]
-- (the base's Pi-iso-nat).
--
-- Premises: fe; univ only through V's extensionality (propV-ext in Pi-nat).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;
module PN = CPshPiNat[a, l] ;

-- the values of an element transported along a path of types
elTr (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (e : PEl[Gb, T]) (X : Ob) (p : W0.Ix (Gb.ob X))
 : Id (W0.Ix (T'.tob X p)) ((subst (PTy[Gb]) (\ T1 -> PEl[Gb, T1]) T T' Pt e).eob X p) (PN.tyTr Gb T T' Pt X p (e.eob X p)) =
 idJ (PTy[Gb]) T
  (\ T1 P1 -> Id (W0.Ix (T1.tob X p)) ((subst (PTy[Gb]) (\ T2 -> PEl[Gb, T2]) T T1 P1 e).eob X p) (PN.tyTr Gb T T1 P1 X p (e.eob X p)))
  (refl (e.eob X p)) T' Pt ;

module StrOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module PL = CPshPiLaws[a, l].PiLawOf[C] ;
 module NA = PN.NatOf[C] ;
 open P ;

 module IN (D G : CCtx) (s : CSub[D, G]) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (v : CEl[LO.ExtC G A, B]) {
  module N = NA.N[D, G, s, A, B] ;
  module LG = PL.L[G, A, B].Lam[v] ;
  v' : CEl[LO.ExtC D N.A', N.B'] = CW.subCEl (LO.ExtC D N.A') (LO.ExtC G A) B v N.Ls ;
  module LD = PL.L[D, N.A', N.B'].Lam[v'] ;
  uEl : CEl[D, LO.subCTy D G s N.PG.PiT] = CW.subCEl D G N.PG.PiT LG.lam s ;

  module AtI (x : CO) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) (y : CO) (f : CH y x) {
   module Nx = N.AtN[x, X, d] ;
   module BN = PP.PiNat[D.ob y, G.ob y, A.ty y, B.ty y, s.sb y] ;
   lG : PEl[G.ob y, N.PG.PiB y] = PP.PiCode[G.ob y, A.ty y, B.ty y].lamEl (v.el y) ;
   pD : W0.Ix ((D.ob y).ob X) = Nx.SD.ptC y f ;
   i1 : Id (W0.Ix ((N.ST y).tob X pD)) (Nx.mvS y f (LG.AtL[x, X, (s.sb x).nt X d].lamB y f)) (lG.eob X ((s.sb y).nt X pD)) =
    PP.apd-el (G.ob y) (N.PG.PiB y) lG X (Nx.SG.ptC y f) ((s.sb y).nt X pD) (Nx.qS y f) ;
   i2 : Id (W0.Ix (Nx.FD y f)) (PN.tyTr (D.ob y) (N.ST y) (N.PD.PiB y) (N.NP y) X pD (lG.eob X ((s.sb y).nt X pD)))
         (LD.AtL[x, X, d].lamB y f) =
    transH (symH (elTr (D.ob y) (N.ST y) (N.PD.PiB y) (N.NP y) (subEl (D.ob y) (G.ob y) (N.PG.PiB y) lG (s.sb y)) X pD))
     (apH (\ e -> e.eob X pD) (BN.PiP-iso-nat (v.el y))) ;
   res : Id (W0.Ix (Nx.FD y f)) (Nx.trC y f (LG.AtL[x, X, (s.sb x).nt X d].lamB y f)) (LD.AtL[x, X, d].lamB y f) =
    transH (apH (\ w -> PN.tyTr (D.ob y) (N.ST y) (N.PD.PiB y) (N.NP y) X pD w) i1) i2 ;
  } ;
  hx (x : CO) (X : Ob) (d : W0.Ix ((D.ob x).ob X))
   : Id (W0.Ix ((N.PD.piTy x).tob X d))
       ((subst (PTy[D.ob x]) (\ T -> PEl[D.ob x, T]) (N.LT x) (N.PD.piTy x) (N.Pf x) (uEl.el x)).eob X d)
       (LD.AtL[x, X, d].lamI) =
   transH (elTr (D.ob x) (N.LT x) (N.PD.piTy x) (N.Pf x) (uEl.el x) X d)
    (N.AtN[x, X, d].SD.pi-eqC
       (PN.tyTr (D.ob x) (N.LT x) (N.PD.piTy x) (N.Pf x) X d LG.AtL[x, X, (s.sb x).nt X d].lamI) LD.AtL[x, X, d].lamI
       (\ y f -> transH (apH (\ b -> b y f) (N.trFst x X d LG.AtL[x, X, (s.sb x).nt X d].lamI)) AtI[x, X, d, y, f].res)) ;
  res : Id (CEl[D, N.PD.PiT])
         (subst (CTy[D]) (\ T -> CEl[D, T]) (LO.subCTy D G s N.PG.PiT) N.PD.PiT N.PiT-nat uEl) LD.lam =
   CW.cel-subst D (LO.subCTy D G s N.PG.PiT) N.PD.PiT N.PiT-nat N.Pf uEl LD.lam (\ x ->
    el-ext (D.ob x) (N.PD.piTy x)
     (subst (PTy[D.ob x]) (\ T -> PEl[D.ob x, T]) (N.LT x) (N.PD.piTy x) (N.Pf x) (uEl.el x)) (LD.lamEl x) (hx x)) ;
 } ;

 -- the Pi structure on the raw CwF of C-presheaves
 module F = CwF.Formers[l+, CW.CPCwF] ;
 PiC : F.PiStr = new F.PiStr[
   Pi         := \ G A B -> PO.PiC[G, A, B].PiT,
   Pi-nat     := \ D G A B s -> NA.N[D, G, s, A, B].PiT-nat,
   Pi-iso     := \ G A B -> PL.L[G, A, B].PiIso,
   Pi-iso-nat := \ D G A B f s -> IN[D, G, s, A, B, f].res ] ;
} ;
