-- CCmpU10.seg (canonicity-c2; (K) for cmpI, part 10): evaluation of the
-- i-th component of HTT at a closed c : Q_F1, as a natural map
-- HTT -> Q_y over nil (its naturality is the Fun fibre's, CHomT1.NTh).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module U10 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation)
  (c : C.El C.nil CPreI[a].PreOf[R, encK, pe].CmpI[y].Q1.FM.P.H.AS.Qt) {
 module PO = CPreI[a].PreOf[R, encK, pe] ;
 module CI = PO.CmpI[y] ;
 module H1 = CI.Q1.FM.P.H ;
 module B0 = H1.B0 ;
 module L = PosFull[a].PB.GPre[a+].PS ;
 module HO = PosFull[a].PB.CHtpyOps[a+] ;
 Nl : C.Ctx = C.nil ;
 HTT : C.Ty Nl = CI.HTT ;
 QA : C.Ty Nl = H1.AS.Qt ;
 QY : C.Ty Nl = H1.AT.Qt ;
 nf1 (K : Ob) : (o : Top) -> V1.Ix (HTT.1.tob K o) -> V1.Ix (QY.1.tob K o) = split { tt -> \ w -> B0.hv K tt w.1.1 (c.eob K tt) } ;
 nf2 (K : Ob) : (o : Top) -> V1.Ix (HTT.1.tob K o) -> V1.Ix (QY.1.tob K o) = split { tt -> \ w -> B0.hv K tt w.2.1 (c.eob K tt) } ;
 nn1 (J I : Ob) (f : Hom J I) : (x x' : Top) (e : Id Top (Nl.act J I f x) x') (w : V1.Ix (HTT.1.tob I x))
   -> Id (V1.Ix (QY.1.tob J x')) (QY.1.tact J I f x x' e (nf1 I x w)) (nf1 J x' (HTT.1.tact J I f x x' e w)) =
  split { tt -> split { tt -> \ e w ->
   transH (L.tact-irr Nl QY.1 J I f tt tt e (refl tt) (B0.hv I tt w.1.1 (c.eob I tt)))
    (transH (symH (B0.NTh[I, J, f, tt, w.1.1, c.eob I tt].law))
      (transH (apH {V1.Ix (B0.MapT.1.tob J tt)} {V1.Ix (QY.1.tob J tt)} (\ m -> B0.hv J tt m (B0.rsS I J f tt (c.eob I tt)))
                 (L.tact-irr Nl B0.MapT.1 J I f tt tt (refl tt) _ w.1.1))
        (apH {V1.Ix (QA.1.tob J tt)} {V1.Ix (QY.1.tob J tt)} (\ u -> B0.hv J tt (B0.MapT.1.tact J I f tt tt e w.1.1) u)
           (c.enat J I f tt tt (refl tt))))) } } ;
 nn2 (J I : Ob) (f : Hom J I) : (x x' : Top) (e : Id Top (Nl.act J I f x) x') (w : V1.Ix (HTT.1.tob I x))
   -> Id (V1.Ix (QY.1.tob J x')) (QY.1.tact J I f x x' e (nf2 I x w)) (nf2 J x' (HTT.1.tact J I f x x' e w)) =
  split { tt -> split { tt -> \ e w ->
   transH (L.tact-irr Nl QY.1 J I f tt tt e (refl tt) (B0.hv I tt w.2.1 (c.eob I tt)))
    (transH (symH (B0.NTh[I, J, f, tt, w.2.1, c.eob I tt].law))
      (transH (apH {V1.Ix (B0.MapT.1.tob J tt)} {V1.Ix (QY.1.tob J tt)} (\ m -> B0.hv J tt m (B0.rsS I J f tt (c.eob I tt)))
                 (L.tact-irr Nl B0.MapT.1 J I f tt tt (refl tt) _ w.2.1))
        (apH {V1.Ix (QA.1.tob J tt)} {V1.Ix (QY.1.tob J tt)} (\ u -> B0.hv J tt (B0.MapT.1.tact J I f tt tt (L.ntEq (L.extP Nl H1.HomT.1) Nl (L.pP Nl H1.HomT.1) J I f (tt, w.1) (tt, H1.HomT.1.tact J I f tt tt e w.1) (L.pair-act Nl H1.HomT.1 J I f tt tt e w.1)) w.2.1) u)
           (c.enat J I f tt tt (refl tt))))) } } ;
 n1 : HO.NMap[Nl, HTT.1, QY.1] = new HO.NMap[Nl, HTT.1, QY.1, nf1, nn1] ;
 n2 : HO.NMap[Nl, HTT.1, QY.1] = new HO.NMap[Nl, HTT.1, QY.1, nf2, nn2] ;
} ;
