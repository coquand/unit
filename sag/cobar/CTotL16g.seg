-- CTotL16g.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, the double reading MW2, part 4, SPECIFIC TO OUR C: the outer
-- family and its naturality along stage maps.
--   totEq     equality in the total space of DAC = (D A)[tau_G]: equal
--             points and equal readings (idJ, DA.tob-eq, pr-inj)
--   rxMcart0  reindexing along the vertical part of a cartesian lift is the
--             identity (vpart-cart, rmap-id, rx-id; transports by refl)
--   ov        the outer family: at q' the inner element (CTotL16f)
--   ON.eq     its naturality: D A's action along (h, cart h y) shifts the
--             inner index by rq; the concatenated indices agree (comp-assoc,
--             rChrCh, rxMcart0, resRes)
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a+] ;
module VA = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, a+] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module RG (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module RF = CTotL16f[a].RR[R, encK, pe] ;
 IC : CIntCat[a, a+].IC = RF.IC ;
 module VT = RF.VT ;
 module DO = RF.DO ;
 Obj (I : Ob) : U a+ = VT.Obj I ;
 module LDd = CTotL14d[a, a+, a+].L14d[IC] ;
 rxMcart0 (J J0 I : Ob) (u : Hom J J0) (u0 : Hom J0 I) (x : Obj I) (n : Nat) (z : Obj J) (c : DO.KJ[J].K.Ch n x z)
  : Id (DO.KJ[J].K.Ch n x z) (DO.CT.rxM J J0 I u u0 x x (VT.vpart J0 I u0 x x (IC.cart J0 I u0 x)) n z c) c =
  transH (apH {VT.VMap J0 x x} {DO.KJ[J].K.Ch n x z} (\ g -> DO.CT.rxM J J0 I u u0 x x g n z c) (LDd.vpart-cart J0 I u0 x))
   (transH (apH {VT.VMap J x x} {DO.KJ[J].K.Ch n x z} (\ h -> DO.KJ[J].K.rx n x x h z c) (symH (VT.rmap-id J J0 u x)))
     (LDd.rx-id J n x z c)) ;

 -- the vertical part of a vertical map is itself (left unit, vpart-eq)
 vpartV (J : Ob) (y x : Obj J) (f : VT.VMap J y x) : Id (VT.VMap J y x) (VT.vpart J J (idH J) y x f) f =
  VT.THom-snd' J J y x (idH J, VT.vpart J J (idH J) y x f) (idH J, f)
   (transH (symH (IC.idl J J (idH J) y x (VT.vpart J J (idH J) y x f))) (VT.vpart-eq J J (idH J) y x f)) (refl (idH J)) ;
 -- the bounds of the outer face positions inside the concatenation
 leZ (n : Nat) : (k : Nat) -> (hk : Tr.IsT (Tr.leb k zero)) -> Tr.IsT (Tr.leb k (suc n)) = split {
  zero -> \ hk -> refl true ;
  suc k -> \ hk -> absurd (Tr.IsT (Tr.leb (suc k) (suc n))) (Tr.false-true hk) } ;
 leS (m' : Nat) (ih : (n k : Nat) (hk : Tr.IsT (Tr.leb k m')) -> Tr.IsT (Tr.leb k (Ar.plus m' (suc n)))) (n : Nat)
  : (k : Nat) -> (hk : Tr.IsT (Tr.leb k (suc m'))) -> Tr.IsT (Tr.leb k (suc (Ar.plus m' (suc n)))) = split {
  zero -> \ hk -> refl true ;
  suc k -> \ hk -> ih n k hk } ;
 leCat : (m : Nat) -> (n k : Nat) (hk : Tr.IsT (Tr.leb k m)) -> Tr.IsT (Tr.leb k (Ar.plus m (suc n))) = split {
  zero -> \ n k hk -> leZ n k hk ;
  suc m' | ih -> \ n k hk -> leS m' ih n k hk } ;
 leSuc : (m : Nat) -> (n : Nat) -> Tr.IsT (Tr.leb (suc m) (Ar.plus m (suc n))) = split {
  zero -> \ n -> refl true ;
  suc m' | ih -> \ n -> ih n } ;
 module Out (G : CTPsh[a, a+, a+].TPshOf[IC].TCtx) (A : Presheaf[a+, a+].Psh[CTotCat[a, a+, a+].TotOf[IC].TotCat].PTy[CTotCat[a, a+, a+].TotOf[IC].toP G])
  (Wf : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (CTotL16b[a, a+, a+].substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face)) {
  module LE = CTotL16e[a, a+, a+].L16e[IC, G, A, Wf, WfaceR] ;
  module LD = LE.LD ;
  module LB = LD.LB ;
  module DA = LB.DA ;
  module D = LB.D ;
  module L16a = CTotL16a[a, a+, a+].L16a[IC, G, A] ;
  module D2 = L16a.CD.LB.DA ;
  GP : LB.P.PCtx = LB.GP ;
  DAC : LB.P.PTy[GP] = L16a.DAC ;
  -- equality in the total space of DAC
  totEq (J : Ob) (y : Obj J) (g : W0.Ix (G.ob J y)) : (g' : W0.Ix (G.ob J y)) (pp : Id (W0.Ix (G.ob J y)) g g')
    (d : DA.TOb' J y (D.tau J y g)) (d' : DA.TOb' J y (D.tau J y g'))
    (H : (q : DA.Idx J y) (l : DA.LandsI J y q) -> Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 ((D.tau J y g).1 q l) (d.1 q l)) (DA.prz q.2.1 q.2.2.2.1 ((D.tau J y g').1 q l) (d'.1 q l)))
    -> Id (D2.Ez J y) (D2.prz J y g d) (D2.prz J y g' d') =
   \ g' pp -> idJ (W0.Ix (G.ob J y)) g
    (\ g2 e2 -> (d : DA.TOb' J y (D.tau J y g)) (d2 : DA.TOb' J y (D.tau J y g2))
       (H : (q : DA.Idx J y) (l : DA.LandsI J y q) -> Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 ((D.tau J y g).1 q l) (d.1 q l)) (DA.prz q.2.1 q.2.2.2.1 ((D.tau J y g2).1 q l) (d2.1 q l)))
       -> Id (D2.Ez J y) (D2.prz J y g d) (D2.prz J y g2 d2))
    (\ d d2 H -> apH {DA.TOb' J y (D.tau J y g)} {D2.Ez J y} (\ v -> D2.prz J y g v)
       (DA.tob-eq J y (D.tau J y g) d d2 (\ q l -> DA.pr-inj q.2.1 q.2.2.2.1 ((D.tau J y g).1 q l) (d.1 q l) (d2.1 q l) (H q l))))
    g' pp ;

  module MW (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) (t : Hom I PFO.ivO) {
   tg : D.Ob' I x = D.tau I x g ;
   module InO (q' : DA.Idx I x) (l' : DA.LandsI I x q') { module M = RF.In[G, A, Wf, Wres, WfaceR, I, x, g, u, t, q', l'] ; } ;
   ov : D2.TA I x tg = \ q' l' -> InO[q', l'].M.ires ;
   module RDm = LE.RD[I, x, g, u] ;

   -- outer naturality: restrict the outer index along h : J2 -> J
   module ON (r : VA.Ix (D.natIdxV I x)) (l' : DA.LandsI I x r.1) {
    module Oa = InO[r.1, l'].M ;
    q'h : DA.Idx I x = (r.1.1, r.2.1, compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2, r.1.2.2.2.1, DO.rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1,
                        (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).1) ;
    l'h : DA.LandsI I x q'h = (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).2 ;
    module OB = InO[q'h, l'h].M ;
    gmh : W0.Ix (G.ob r.2.1 r.1.2.2.2.1) = G.act r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1 r.1.2.2.2.1 (IC.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) Oa.OFm.gmy ;
    pp : Id (W0.Ix (G.ob r.2.1 r.1.2.2.2.1)) gmh OB.OFm.gmy = tg.2.1 r l' ;
    module TBo = DA.TB[r.2.1, r.1.2.1, r.2.2, r.1.2.2.2.1, r.1.2.2.2.1, IC.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1, Oa.OFm.tgy, D.tau r.2.1 r.1.2.2.2.1 gmh,
                      LB.P.ntEq GP L16a.DGc.DG L16a.tauS (r.2.1, r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, IC.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) Oa.OFm.gmy gmh (refl gmh),
                      Oa.ires] ;
    module RCm (q : DA.Idx r.2.1 r.1.2.2.2.1) { module M = RF.RC[q.2.1, r.2.1, r.1.2.1, q.2.2.1, r.2.2] ; } ;
    module HQ (q : DA.Idx r.2.1 r.1.2.2.2.1) (li : DA.LandsI r.2.1 r.1.2.2.2.1 q) {
     module Sa = LD.Inner[I, x, g, u, t, r.1, l', (TBo.sh q), li] ;
     module Tb = LD.Inner[I, x, g, u, t, q'h, l'h, q, li] ;
     eq : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 ((D.tau r.2.1 r.1.2.2.2.1 gmh).1 q li) (TBo.res.1 q li))
          (DA.prz q.2.1 q.2.2.2.1 (OB.OFm.tgy.1 q li) (OB.ires.1 q li)) =
      transH (TBo.pc q li) (transH (Sa.pc) (transH (apH {Hom q.2.1 I} {DA.Ez q.2.1 q.2.2.2.1} (\ k -> RDm.rd (Ar.plus r.1.1 (suc q.1)) q.2.1 k q.2.2.2.1 (Sa.cc) (Wf r.1.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t k) (Sa.jr) (q.2.2.2.2.2, li))) (symH (PB.comp-assoc q.2.1 r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2 q.2.2.1))) (transH (apH {DO.KJ[q.2.1].K.Ch r.1.1 x r.1.2.2.2.1} {DA.Ez q.2.1 q.2.2.2.1} (\ c2 -> RDm.rd (Ar.plus r.1.1 (suc q.1)) q.2.1 (Tb.gg) q.2.2.2.1 (CTotL16c[a, a+, a+].CA[IC, q.2.1].catA r.1.1 q.1 x r.1.2.2.2.1 q.2.2.2.1 c2 (Sa.c)) (Wf r.1.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t (Tb.gg)) (Sa.jr) (q.2.2.2.2.2, li))) (symH (RCm[q].M.rChrCh r.1.1 x r.1.2.2.2.1 r.1.2.2.2.2.1))) (transH (apH {DO.KJ[q.2.1].K.Ch q.1 r.1.2.2.2.1 q.2.2.2.1} {DA.Ez q.2.1 q.2.2.2.1} (\ cc -> RDm.rd (Ar.plus r.1.1 (suc q.1)) q.2.1 (Tb.gg) q.2.2.2.1 (CTotL16c[a, a+, a+].CA[IC, q.2.1].catA r.1.1 q.1 x r.1.2.2.2.1 q.2.2.2.1 (Tb.c2) cc) (Wf r.1.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t (Tb.gg)) (Sa.jr) (q.2.2.2.2.2, li))) (rxMcart0 q.2.1 r.2.1 r.1.2.1 q.2.2.1 r.2.2 r.1.2.2.2.1 q.1 q.2.2.2.1 q.2.2.2.2.1)) (transH (apH {Wt.Pn r.1.1 q.2.1} {DA.Ez q.2.1 q.2.2.2.1} (\ jj -> RDm.rd (Ar.plus r.1.1 (suc q.1)) q.2.1 (Tb.gg) q.2.2.2.1 (Tb.cc) (Wf r.1.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t (Tb.gg)) jj (q.2.2.2.2.2, li))) (symH (RF.resRes r.1.1 q.2.1 r.2.1 r.1.2.1 q.2.2.1 r.2.2 (r.1.2.2.2.2.2, l')))) (symH (Tb.pc))))))) ;
    } ;
    H (q : DA.Idx r.2.1 r.1.2.2.2.1) (li : DA.LandsI r.2.1 r.1.2.2.2.1 q)
     : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 ((D.tau r.2.1 r.1.2.2.2.1 gmh).1 q li) (TBo.res.1 q li))
          (DA.prz q.2.1 q.2.2.2.1 (OB.OFm.tgy.1 q li) (OB.ires.1 q li)) = HQ[q, li].eq ;
    eq : Id (D2.Ez r.2.1 r.1.2.2.2.1) (D2.anatL I x tg ov r l') (D2.anatR I x tg ov r l') =
     totEq r.2.1 r.1.2.2.2.1 gmh OB.OFm.gmy pp TBo.res OB.ires H ;
   } ;
   onat : W0.Ix (D2.anatEq I x tg ov) = \ r l' -> ON[r, l'].eq ;

   -- outer faces in the first block (cat-left)
   module OF (r : VA.Ix (D.faceIdxV I x)) (l' : D.faceLd I x r) {
    q'a : DA.Idx I x = (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (D2.afaceF I x r l').1) ;
    l'a : DA.LandsI I x q'a = (D2.afaceF I x r l').2 ;
    q'b : DA.Idx I x = (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 x r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) ;
    module Oa = InO[q'a, l'a].M ;
    module OB = InO[q'b, l'].M ;
    pp : Id (W0.Ix (G.ob r.2.2.2.1 r.2.2.2.2.2.1)) Oa.OFm.gmy OB.OFm.gmy = tg.2.2.1 r l' ;
    module HQ (q : DA.Idx r.2.2.2.1 r.2.2.2.2.2.1) (li : DA.LandsI r.2.2.2.1 r.2.2.2.2.2.1 q) {
     module Sa = LD.Inner[I, x, g, u, t, q'a, l'a, q, li] ;
     module Tb = LD.Inner[I, x, g, u, t, q'b, l', q, li] ;
     module CFg = CChainsF[a+].CF[VT.VCat r.2.2.2.1, VT.VCat q.2.1, VT.rfun q.2.1 r.2.2.2.1 q.2.2.1] ;
     module CA = CTotL16c[a, a+, a+].CA[IC, q.2.1] ;
     eq : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (Oa.OFm.tgy.1 q li) (Oa.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (OB.OFm.tgy.1 q li) (OB.ires.1 q li)) =
      transH Sa.pc
       (transH (apH {Wt.Pn (suc r.1) q.2.1} {DA.Ez q.2.1 q.2.2.2.1}
                  (\ jj -> RDm.rd (Ar.plus (suc r.1) (suc q.1)) q.2.1 Sa.gg q.2.2.2.1 Sa.cc (Wf (suc r.1) q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t Sa.gg) jj (q.2.2.2.2.2, li)))
                  (Wt.RF[r.1, r.2.2.2.1, q.2.1, q.2.2.1, r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1, (r.2.2.2.2.2.2.2, l')].resFace))
        (transH (apH (RDm.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 Sa.gg q.2.2.2.1 Sa.cc)
                   (WfaceL r.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t Sa.gg) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1) Tb.jr (q.2.2.2.2.2, li)))
         (transH (apH (RDm.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 Sa.gg q.2.2.2.1 Sa.cc)
                    (LE.U12.faceW-irr (Ar.plus r.1 (suc q.1)) q.2.1 r.2.1 (Wt.hkB r.1 q.1 r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1))
                       (Ar.leb-step r.2.1 (Ar.plus r.1 (suc q.1)) (leCat r.1 q.1 r.2.1 r.2.2.1)) Tb.w))
          (transH (u.2.2.1 (Ar.plus r.1 (suc q.1), r.2.1, leCat r.1 q.1 r.2.1 r.2.2.1, q.2.1, Sa.gg, q.2.2.2.1, Sa.cc, Tb.w.1) Tb.w.2)
           (transH (apH {DO.KJ[q.2.1].K.Ch (Ar.plus r.1 (suc q.1)) x q.2.2.2.1} {DA.Ez q.2.1 q.2.2.2.1} (\ ch -> RDm.rd (Ar.plus r.1 (suc q.1)) q.2.1 Sa.gg q.2.2.2.1 ch Tb.w)
                      (transH (CA.cat-left r.1 q.1 r.2.1 r.2.2.1 x r.2.2.2.2.2.1 q.2.2.2.1 Sa.c2 q.2.2.2.2.1)
                        (apH {DO.KJ[q.2.1].K.Ch r.1 x r.2.2.2.2.2.1} {DO.KJ[q.2.1].K.Ch (Ar.plus r.1 (suc q.1)) x q.2.2.2.1}
                           (\ c2 -> CA.catA r.1 q.1 x r.2.2.2.2.2.1 q.2.2.2.1 c2 q.2.2.2.2.1)
                           (symH (CFg.chF-comp r.1 r.2.1 x r.2.2.2.2.2.1 r.2.2.2.2.2.2.1)))))
            (symH Tb.pc)))))) ;
    } ;
    eq : Id (D2.Ez r.2.2.2.1 r.2.2.2.2.2.1) (D2.afaceL I x tg ov r l') (D2.afaceR I x tg ov r l') =
     totEq r.2.2.2.1 r.2.2.2.2.2.1 Oa.OFm.gmy OB.OFm.gmy pp Oa.ires OB.ires (\ q li -> HQ[q, li].eq) ;
   } ;
   oface : W0.Ix (D2.afaceEq I x tg ov) = \ r l' -> OF[r, l'].eq ;

   -- the outer top face: D A's vertical action along the last map of c' (cat-junction)
   module OT (r : VA.Ix (D.topIdxV I x)) (l' : D.topLd I x r) {
    q'a : DA.Idx I x = (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (D2.atopF I x r l').1) ;
    l'a : DA.LandsI I x q'a = (D2.atopF I x r l').2 ;
    dr : DO.KJ[r.2.1].K.DR r.1 x r.2.2.2.1 = D.topD I x r ;
    q'b : DA.Idx I x = (r.1, r.2.1, r.2.2.1, dr.1, dr.2.1, r.2.2.2.2.2) ;
    module Oa = InO[q'a, l'a].M ;
    module OB = InO[q'b, l'].M ;
    gmf : W0.Ix (G.ob r.2.1 r.2.2.2.1) = G.act r.2.1 r.2.1 (idH r.2.1) r.2.2.2.1 dr.1 dr.2.2 OB.OFm.gmy ;
    pp : Id (W0.Ix (G.ob r.2.1 r.2.2.2.1)) Oa.OFm.gmy gmf = tg.2.2.2 r l' ;
    module TBt = DA.TB[r.2.1, r.2.1, idH r.2.1, r.2.2.2.1, dr.1, dr.2.2, OB.OFm.tgy, D.tau r.2.1 r.2.2.2.1 gmf,
                       LB.P.ntEq GP L16a.DGc.DG L16a.tauS (r.2.1, r.2.2.2.1) (r.2.1, dr.1) (idH r.2.1, dr.2.2) OB.OFm.gmy gmf (refl gmf), OB.ires] ;
    module HQ (q : DA.Idx r.2.1 r.2.2.2.1) (li : DA.LandsI r.2.1 r.2.2.2.1 q) {
     module Sa = LD.Inner[I, x, g, u, t, q'a, l'a, q, li] ;
     module Tb = LD.Inner[I, x, g, u, t, q'b, l', (TBt.sh q), li] ;
     module CFg = CChainsF[a+].CF[VT.VCat r.2.1, VT.VCat q.2.1, VT.rfun q.2.1 r.2.1 q.2.2.1] ;
     module CA = CTotL16c[a, a+, a+].CA[IC, q.2.1] ;
     jrg : Wt.Pn r.1 q.2.1 = Wt.Res[r.1, q.2.1, r.2.1, q.2.2.1, (r.2.2.2.2.2, l')].res ;
     wg : Wt.Pn (Ar.plus r.1 (suc q.1)) q.2.1 = Wf r.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t Sa.gg) jrg (q.2.2.2.2.2, li) ;
     rxc : DO.KJ[q.2.1].K.Ch q.1 dr.1 q.2.2.2.1 = DO.KJ[q.2.1].K.rx q.1 r.2.2.2.1 dr.1 (VT.rmap q.2.1 r.2.1 q.2.2.1 r.2.2.2.1 dr.1 (VT.vpart r.2.1 r.2.1 (idH r.2.1) r.2.2.2.1 dr.1 dr.2.2)) q.2.2.2.1 q.2.2.2.2.1 ;
     eq : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (Oa.OFm.tgy.1 q li) (Oa.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 ((D.tau r.2.1 r.2.2.2.1 gmf).1 q li) (TBt.res.1 q li)) =
      transH Sa.pc
       (transH (apH {Wt.Pn (suc r.1) q.2.1} {DA.Ez q.2.1 q.2.2.2.1}
                  (\ jj -> RDm.rd (Ar.plus (suc r.1) (suc q.1)) q.2.1 Sa.gg q.2.2.2.1 Sa.cc (Wf (suc r.1) q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t Sa.gg) jj (q.2.2.2.2.2, li)))
                  (Wt.RF[r.1, r.2.1, q.2.1, q.2.2.1, suc r.1, Tr.leb-refl (suc r.1), (r.2.2.2.2.2, l')].resFace))
        (transH (apH (RDm.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 Sa.gg q.2.2.2.1 Sa.cc)
                   (WfaceL r.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t Sa.gg) (suc r.1) (Tr.leb-refl (suc r.1)) jrg (q.2.2.2.2.2, li)))
         (transH (apH (RDm.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 Sa.gg q.2.2.2.1 Sa.cc)
                    (LE.U12.faceW-irr (Ar.plus r.1 (suc q.1)) q.2.1 (suc r.1) (Wt.hkB r.1 q.1 (suc r.1) (Tr.leb-refl (suc r.1)))
                       (Ar.leb-step (suc r.1) (Ar.plus r.1 (suc q.1)) (leSuc r.1 q.1)) wg))
          (transH (u.2.2.1 (Ar.plus r.1 (suc q.1), suc r.1, leSuc r.1 q.1, q.2.1, Sa.gg, q.2.2.2.1, Sa.cc, wg.1) wg.2)
           (transH (apH {DO.KJ[q.2.1].K.Ch (Ar.plus r.1 (suc q.1)) x q.2.2.2.1} {DA.Ez q.2.1 q.2.2.2.1} (\ ch -> RDm.rd (Ar.plus r.1 (suc q.1)) q.2.1 Sa.gg q.2.2.2.1 ch wg)
                      (transH (CA.cat-junction r.1 q.1 x r.2.2.2.1 q.2.2.2.1 Sa.c2 q.2.2.2.2.1)
                        (apH {DO.KJ[q.2.1].K.DR r.1 x r.2.2.2.1} {DO.KJ[q.2.1].K.Ch (Ar.plus r.1 (suc q.1)) x q.2.2.2.1}
                           (\ Dd -> CA.catA r.1 q.1 x Dd.1 q.2.2.2.1 Dd.2.1 (DO.KJ[q.2.1].K.rx q.1 r.2.2.2.1 Dd.1 Dd.2.2 q.2.2.2.1 q.2.2.2.2.1))
                           (symH (CFg.chF-drop r.1 x r.2.2.2.1 r.2.2.2.2.1)))))
            (transH (apH {VT.VMap r.2.1 r.2.2.2.1 dr.1} {DA.Ez q.2.1 q.2.2.2.1}
                       (\ ff -> RDm.rd (Ar.plus r.1 (suc q.1)) q.2.1 Sa.gg q.2.2.2.1
                                  (CA.catA r.1 q.1 x dr.1 q.2.2.2.1 (CFg.chF r.1 x dr.1 dr.2.1) (DO.KJ[q.2.1].K.rx q.1 r.2.2.2.1 dr.1 (VT.rmap q.2.1 r.2.1 q.2.2.1 r.2.2.2.1 dr.1 ff) q.2.2.2.1 q.2.2.2.2.1)) wg)
                       (symH (vpartV r.2.1 r.2.2.2.1 dr.1 dr.2.2)))
             (transH (apH {Hom q.2.1 r.2.1} {DA.Ez q.2.1 q.2.2.2.1}
                        (\ k -> RDm.rd (Ar.plus r.1 (suc q.1)) q.2.1 (compH q.2.1 r.2.1 I r.2.2.1 k) q.2.2.2.1
                                   (CA.catA r.1 q.1 x dr.1 q.2.2.2.1 (CChainsF[a+].CF[VT.VCat r.2.1, VT.VCat q.2.1, VT.rfun q.2.1 r.2.1 k].chF r.1 x dr.1 dr.2.1) rxc)
                                   (Wf r.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t (compH q.2.1 r.2.1 I r.2.2.1 k)) (Wt.Res[r.1, q.2.1, r.2.1, k, (r.2.2.2.2.2, l')].res) (q.2.2.2.2.2, li)))
                        (symH (comp-idl q.2.1 r.2.1 q.2.2.1)))
              (transH (symH Tb.pc) (symH (TBt.pc q li)))))))))) ;
    } ;
    eq : Id (D2.Ez r.2.1 r.2.2.2.1) (D2.atopL I x tg ov r l') (D2.atopR I x tg ov r l') =
     totEq r.2.1 r.2.2.2.1 Oa.OFm.gmy gmf pp Oa.ires TBt.res (\ q li -> HQ[q, li].eq) ;
   } ;
   otop : W0.Ix (D2.atopEq I x tg ov) = \ r l' -> OT[r, l'].eq ;
   -- the element of (D DAC)[tau_G] at (I, x) over g
   res : W0.Ix (L16a.B2.tob (I, x) g) = (ov, (onat, (oface, otop))) ;
  } ;
 } ;
} ;
