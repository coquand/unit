-- CAlEq.seg (canonicity-45; COBAR.md "Prop 58"): the parameters al / eqal of
-- G's operations (CCmpY5.Ops2, CCmpY6.Cp6): cmpI : HomT(F2, y) -> HomT(F1, y)^2
-- (CPreI) is an equivalence, by c2's inverse cop and its two round trips
-- (CCmpK30, CCmpK32, read by IdRd) through QinvEq.QE.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module AE (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module CI = CPreI[a].PreOf[R, encK, pe].CmpI[y] ;
 module K30 = CCmpK30[a].K30[R, encK, pe, y] ;
 module K32 = CCmpK32[a].K32[R, encK, pe, y] ;
 module HO = CI.HO ;
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 copN : HO.NMap[Nl, CI.HTT.1, CI.HS.1] = EqQinv[a, a+].NM[Nl, CI.HTT, CI.HS, K30.cop].nm ;
 module ER = CContrEq[a, a+].IdRd[Nl, CI.HS, HO.compN Nl CI.HS.1 CI.HTT.1 CI.HS.1 CI.nmap copN, K32.t1, \ W z -> K32.t1v W z, K32.ret] ;
 module SR = CContrEq[a, a+].IdRd[Nl, CI.HTT, HO.compN Nl CI.HTT.1 CI.HS.1 CI.HTT.1 copN CI.nmap, K32.t2, \ W z -> K32.t2v W z, K32.secR] ;
 module Q = QinvEq[a, a+].QE[Nl, CI.HS, CI.HTT, CI.nmap, copN, ER.res, SR.res] ;
 al : PB.CPartial[a+].PMap[Nl, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1] = Q.fM ;
 eqal : PB.CEquiv[a+].EquivOp Nl CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 al = Q.qinvEq ;
 -- commH: on codes, the comparison (precomposition along I1, I2) agrees with cmpI after alpha
 module SD = CCmpY2[a].Sides[R, encK, pe, y] ;
 module CY = SD.CY ;
 rt2 (W : Ob) (m : CY.P.F.M W) : Id (CY.P.F.M W) (SD.TM2.beta W (SD.FM2.alpha W m)) m = CHomT12[a].RT1[R, encK, pe, SD.FR.F2, y].At[W, m].rt ;
 commH (W : Ob) (v : SD.TB'.EI W) : Id (SD.TA.EI W) (SD.tA W (CY.al'.mE W v)) (al.mE W (SD.tB W v)) =
  apH {SD.Z1 W * SD.Z1 W} {SD.TA.EI W} (\ zz -> (tt, zz))
   (CY.CM.PD.pairE2 (SD.Z1 W) (SD.Z1 W) (SD.FM1.alpha W (CY.al'.mE W v).2.1) (CI.Q1.val W (SD.FM2.alpha W v.2))
      (SD.FM1.alpha W (CY.al'.mE W v).2.2) (CI.Q2.val W (SD.FM2.alpha W v.2))
      (apH {CY.P.F.M W} {SD.Z1 W} (\ m -> SD.FM1.alpha W (CI.Q1.PR.pre W y m)) (symH (rt2 W v.2)))
      (apH {CY.P.F.M W} {SD.Z1 W} (\ m -> SD.FM1.alpha W (CI.Q2.PR.pre W y m)) (symH (rt2 W v.2)))) ;
} ;
