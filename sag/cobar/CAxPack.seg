-- CAxPack.seg (canonicity-c2; the axioms' statements, duality kernel part 2):
-- metatheory families over the constant type Delta E substituted from the
-- empty context (DX G = (Delta E)[eps], as CAxSurj's DEx), packaged as an
-- element over G.DX (the pattern of GCConstLam.Pack; the constant type acts
-- trivially, so the points of G.DX are pairs with trivial action).
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module PackOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (E : V1.V) {
 module DL = CAxDelta[a].DeltaOf[R, encK, pe] ;
 module PW = DL.PW ;
 module PS = PW.TR.P1 ;
 C : CwF.CwF[a++] = PW.C ;
 Nl : C.Ctx = PW.Nl ;
 module LC = PW.G1.FT.GCConstLam[a+].LamC[DL.CY.cylG, E] ;
 D0 : C.Ty Nl = DL.D E Nl ;
 DX (G : C.Ctx) : C.Ty G = C.subT G Nl D0 (C.eps G) ;
 GX (G : C.Ctx) : C.Ctx = C.ext G (DX G) ;
 cX (G : C.Ctx) (e : V1.Ix E) : C.El G (DX G) = C.subt G Nl D0 (LC.cE Nl e) (C.eps G) ;
 sX (G : C.Ctx) (e : V1.Ix E) : C.Sub G (GX G) = C.sec G (DX G) (cX G e) ;
 module Pack (G : C.Ctx) (B : C.Ty (GX G)) (f : (e : V1.Ix E) -> C.El G (C.subT G (GX G) B (sX G e))) {
  ob (I : CAxEv[a].EvG[R, encK, pe].Ob) (w : V1.Ix ((GX G).ob I)) : V1.Ix (B.1.tob I w) = (f w.2).eob I w.1 ;
  nat (J I : CAxEv[a].EvG[R, encK, pe].Ob) (g : CAxEv[a].EvG[R, encK, pe].Hm J I) (w : V1.Ix ((GX G).ob I)) (w' : V1.Ix ((GX G).ob J)) (p : Id (V1.Ix ((GX G).ob J)) ((GX G).act J I g w) w')
   : Id (V1.Ix (B.1.tob J w')) (B.1.tact J I g w w' p (ob I w)) (ob J w') =
   idJ (V1.Ix ((GX G).ob J)) ((GX G).act J I g w)
    (\ w2 p2 -> Id (V1.Ix (B.1.tob J w2)) (B.1.tact J I g w w2 p2 (ob I w)) (ob J w2))
    (transH (apH {Id (V1.Ix ((GX G).ob J)) ((GX G).act J I g w) ((GX G).act J I g w)} {V1.Ix (B.1.tob J ((GX G).act J I g w))}
               (\ r -> B.1.tact J I g w ((GX G).act J I g w) r (ob I w))
               (V1.isSetIx ((GX G).ob J) ((GX G).act J I g w) ((GX G).act J I g w) (refl ((GX G).act J I g w))
                  (PS.ntEq G (GX G) (sX G w.2) J I g w.1 (G.act J I g w.1) (refl (G.act J I g w.1)))))
      ((f w.2).enat J I g w.1 (G.act J I g w.1) (refl (G.act J I g w.1))))
    w' p ;
  res : C.El (GX G) B = PS.mkPEl (GX G) B.1 ob nat ;
 } ;
} ;
