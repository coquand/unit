-- CPshIdJ2.seg (part 6 of the Id instance, canonicity-45): the laws of
-- substitution of the Id structure of the CwF of fibrant C-types, from
-- the base's at each x, and the instance PIdJ : SwanId.IdJStr.
--   rflNat   refl is stable: FibIdCen.RflNat.pt at each x, the two
--            transports of rflY compared through FibIdRd.elTr with one path
--            of codes
--   cenNat   the centre is stable: FibIdCen.CN.ptR at each x through
--            cenEqC and upSEqC
--   jNat     J is stable: PosJNat.JNatG at each x for the map upS of the
--            record read at x (its commutation with the J-data from
--            FibId.JNt's through upSEqC), the transported start compared
--            through elTr with the path of codes of the centres (dEqC)
--   PIdJ     the IdJStr instance

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module FBC = FibCwF[a, l] ;
module FIC = FibIdCen[a, l] ;
module FID = FibId[a, l] ;
module RD = FibIdRd[a, l] ;
module PYJ = PosIdYJ[a, l] ;
module PJ = PosJNat[a, l] ;

module IdJ2Of (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module IdM = CPshId[a, l].IdOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 module JB = CPshIdJb[a, l].IdJbOf[C] ;
 module JC2 = CPshIdJc2[a, l].IdJc2Of[C] ;
 module J1 = CPshIdJ1[a, l].IdJ1Of[C] ;
 open P ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;
 module SW2 = JA.SW2 ;
 module DRC = JA.DRC ;
 module DRB = JA.DRB ;
 As (G : CCtx) (A : STy G) (x : CO) : FBC.FC.STy (G.ob x) = JA.As G A x ;
 IdTS (G : CCtx) (A : STy G) (a0 b0 : CEl[G, A.1]) : STy G = JA.IdTS G A a0 b0 ;
 rflS (G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) : CEl[G, (IdTS G A a0 a0).1] = JA.rflS G A a0 ;

 ------------------------------------------------------------------
 -- refl is stable

 module RN (D G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (s : CSub[D, G]) {
  A' : STy D = UF.FCC.subS D G A s ;
  a' : CEl[D, A'.1] = CW.subCEl D G A.1 a0 s ;
  Ts : STy D = UF.FCC.subS D G (IdTS G A a0 a0) s ;
  Td : STy D = IdTS D A' a' a' ;
  u : CEl[D, Td.1] =
   subst (STy D) (\ Z -> CEl[D, Z.1]) Ts Td (JA.IdT-natS D G A a0 a0 s) (CW.subCEl D G (IdTS G A a0 a0).1 (rflS G A a0) s) ;
  PC : Id (CTy[D]) Ts.1 Td.1 = apH (\ Z -> Z.1) (JA.IdT-natS D G A a0 a0 s) ;
  uC : Id (CEl[D, Td.1]) u (subst (CTy[D]) (\ X -> CEl[D, X]) Ts.1 Td.1 PC (CW.subCEl D G (IdTS G A a0 a0).1 (rflS G A a0) s)) =
   subst-ap (STy D) (CTy[D]) (\ Z -> Z.1) (\ X -> CEl[D, X]) Ts Td (JA.IdT-natS D G A a0 a0 s) (CW.subCEl D G (IdTS G A a0 a0).1 (rflS G A a0) s) ;
  opaque uC ;
  module At (x : CO) {
   Dx' : PCtx = D.ob x ;
   Gx : PCtx = G.ob x ;
   module N = FIC.RflNat[Dx', Gx, As G A x, a0.el x, s.sb x] ;
   PCx : Id (PTy[Dx']) (Ts.1.ty x) (Td.1.ty x) = apH (\ X -> X.ty x) PC ;
   cd (X : Ob) (g : W0.Ix (Dx'.ob X)) : Id W0.V ((Ts.1.ty x).tob X g) ((Td.1.ty x).tob X g) = apH (\ T -> T.tob X g) PCx ;
   -- the record's transported refl, at a point
   vC (X : Ob) (g : W0.Ix (Dx'.ob X))
    : Id (W0.Ix ((Td.1.ty x).tob X g)) ((u.el x).eob X g)
        (subst W0.V (\ v -> W0.Ix v) ((Ts.1.ty x).tob X g) ((Td.1.ty x).tob X g) (cd X g) (((CW.subCEl D G (IdTS G A a0 a0).1 (rflS G A a0) s).el x).eob X g)) =
    transH (apH (\ e -> (e.el x).eob X g) uC)
     (transH (apH (\ e -> e.eob X g) (CW.elTrC D Ts.1 Td.1 PC (CW.subCEl D G (IdTS G A a0 a0).1 (rflS G A a0) s) x))
       (RD.elTr Dx' (PTy[Dx']) (\ T -> T) (Ts.1.ty x) (Td.1.ty x) PCx ((CW.subCEl D G (IdTS G A a0 a0).1 (rflS G A a0) s).el x) X g (cd X g))) ;
   opaque vC ;
   -- the base's transported refl, at a point
   vB (X : Ob) (g : W0.Ix (Dx'.ob X))
    : Id (W0.Ix ((Td.1.ty x).tob X g)) (N.u.eob X g)
        (subst W0.V (\ v -> W0.Ix v) ((Ts.1.ty x).tob X g) ((Td.1.ty x).tob X g) (cd X g) (((CW.subCEl D G (IdTS G A a0 a0).1 (rflS G A a0) s).el x).eob X g)) =
    RD.elTr Dx' (FBC.FC.STy Dx') (\ Z -> Z.1) (FBC.FC.subS Dx' Gx (FIC.idTy Gx (As G A x) (a0.el x) (a0.el x)) (s.sb x))
      (FIC.idTy Dx' (FBC.FC.subS Dx' Gx (As G A x) (s.sb x)) (subEl Dx' Gx (A.1.ty x) (a0.el x) (s.sb x)) (subEl Dx' Gx (A.1.ty x) (a0.el x) (s.sb x)))
      (FIC.idTy-nat Dx' Gx (As G A x) (a0.el x) (a0.el x) (s.sb x)) (subEl Dx' Gx N.RG.Y.IdYT N.RG.rflY (s.sb x)) X g (cd X g) ;
   opaque vB ;
   pt (X : Ob) (g : W0.Ix (Dx'.ob X)) : Id (W0.Ix ((Td.1.ty x).tob X g)) ((u.el x).eob X g) (((rflS D A' a').el x).eob X g) =
    transH (vC X g) (transH (symH (vB X g)) (N.pt X g)) ;
   opaque pt ;
  } ;
  law : Id (CEl[D, Td.1]) u (rflS D A' a') = EX.cel-ext D Td.1 u (rflS D A' a') (\ x X g -> At[x].pt X g) ;
  opaque law ;
 } ;

 ------------------------------------------------------------------
 -- the centre is stable

 module CNC (D G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (s : CSub[D, G]) {
  A' : STy D = UF.FCC.subS D G A s ;
  a' : CEl[D, A'.1] = CW.subCEl D G A.1 a0 s ;
  Dc : CCtx = DRC.Dx G A a0 ;
  Dd : CCtx = DRC.Dx D A' a' ;
  lhs : CSub[D, Dc] = CW.coC D G Dc (DRC.cen G A a0) s ;
  rhs : CSub[D, Dc] = CW.coC D Dd Dc (DRC.upS D G A a0 s) (DRC.cen D A' a') ;
  module At (x : CO) {
   module CN = FIC.CN[D.ob x, G.ob x, As G A x, a0.el x, s.sb x] ;
   pt (X : Ob) (x0 : W0.Ix ((D.ob x).ob X)) : Id (W0.Ix ((Dc.ob x).ob X)) ((lhs.sb x).nt X x0) ((rhs.sb x).nt X x0) =
    transH (apH (\ t -> t.nt X ((s.sb x).nt X x0)) (JB.cenEqC G A a0 x))
     (transH (CN.ptR X x0)
       (symH (transH (apH (\ t -> t.nt X (((DRC.cen D A' a').sb x).nt X x0)) (JC2.upSEqC D G A a0 s x))
                (apH (\ t -> (DRB.upS (D.ob x) (G.ob x) (As G A x) (a0.el x) (s.sb x)).nt X (t.nt X x0)) (JB.cenEqC D A' a' x))))) ;
   opaque pt ;
  } ;
  law : DRC.CenNat D G A a0 s = EX.csub-ext D Dc lhs rhs (\ x X x0 -> At[x].pt X x0) ;
  opaque law ;
 } ;
 cenNat (D G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (s : CSub[D, G]) : DRC.CenNat D G A a0 s = CNC[D, G, A, a0, s].law ;
} ;
