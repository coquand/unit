-- Evaluation of F3 homomorphisms at its three generators.  The target is
-- the same threefold product used by proposition-valued quotient induction.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Eval3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (y : SX.Over[R].Presentation) {
  module F = CFree3Assoc[a].Free3[R] ;
  module D = CDEv1[a].DE1[R, encK, pe, F.F3, y] ;
  module S2 = D.S2 ;
  HS : C.Ty C.nil = D.HS ;
  QY : C.Ty C.nil = D.QY ;
  module At (i : SX.Fin F.F3.1) {
    nf (K : Ob) : (o : Top) -> V1.Ix (HS.1.tob K o) -> V1.Ix (QY.1.tob K o) =
      split { tt -> \ z -> D.SO1.hval K z i } ;
    nn (J I : Ob) (f : Hom J I) : (o o' : Top)
      (e : Id Top (C.nil.act J I f o) o') (z : V1.Ix (HS.1.tob I o)) ->
      Id (V1.Ix (QY.1.tob J o')) (QY.1.tact J I f o o' e (nf I o z))
        (nf J o' (HS.1.tact J I f o o' e z)) =
      split { tt -> split { tt -> \ e z ->
        transH (L.tact-irr C.nil QY.1 J I f tt tt e (refl tt) (D.SO1.hval I z i))
          (transH (S2.hvalNat I J f z i)
            (apH {V1.Ix (HS.1.tob J tt)} {V1.Ix (QY.1.tob J tt)}
              (\ h -> D.SO1.hval J h i)
              (L.tact-irr C.nil HS.1 J I f tt tt (refl tt) e z))) } } ;
    nmap : HO.NMap[C.nil, HS.1, QY.1] =
      new HO.NMap[C.nil, HS.1, QY.1, nf, nn] ;
  } ;
  module E1 = At[inl (inl (inr tt))] ;
  module E2 = At[inl (inr tt)] ;
  module E3 = At[inr tt] ;
  module P12 = CF3HomCmp[a].PairN[HS, QY, QY, E1.nmap, E2.nmap] ;
  module P123 = CF3HomCmp[a].PairN[HS, P12.YZ, QY, P12.nmap, E3.nmap] ;
  QYYY : C.Ty C.nil = P123.YZ ;
  ev3 : C.El C.nil (OV.Fun C.nil HS QYYY) =
    QinvEq[a, a+].FunOf[C.nil, HS, QYYY, P123.nmap].fC ;
} ;
