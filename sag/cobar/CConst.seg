-- CConst.seg (canonicity-45; SIMPLIFIED.md step 1, the pilot): constant
-- types.  For a metatheory set E (a V-code) the constant type Delta E over
-- any context: fibres E, trivial action.  It is fibrant: every line of
-- Delta E over a line of the context is the restriction of one line over
-- the cylinder (CCyl), so its values are all equal (lc); hence a side of
-- a composition problem, whose lines start at the given end a, consists
-- of lines with all values a, and the composite is a itself (kop ignores
-- the side), uniform on the nose.
--   constTy G       : PTy[G]
--   C[G].lc         values of a line in Delta E are constant
--   C[G].fib        : Lines[G, constTy G].Fib
--   constS G        : the fibrant type (FibCwF.FC.STy G)
-- Poset instance of the cylinder: CCyl.PosCyl.posCyl.  No new axioms.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module FBC = FibCwF[a, l] ;
module CY = CCyl[a].CylOf[PB.BC, PFO.ivO] ;

module ConstOf (cy : CY.Cyl) (E : W0.V) {
 -- the constant type over any context
 constTy (G : PCtx) : PTy[G] =
  mkTy G (\ I x -> E) (\ J I f x y e a -> a) (\ I x e a -> refl a) (\ K J I f g x y z e1 e2 e3 a -> refl a) ;

 module C (G : PCtx) {
  A : PTy[G] = constTy G ;
  module LN = CL.Lines[G, A] ;
  module FG = CL.FC[G] ;
  module FA = CL.FT[G, A] ;
  module TA = GPR.TyL[G, A] ;
  module FE = CL.FC[TA.E] ;

  -- a coercion in the constant fibre is the identity
  coeC (I : Ob) (x y : TA.Pt I) (e : Id (TA.Pt I) x y) (b : W0.Ix E) : Id (W0.Ix E) (TA.coeT I x y e b) b =
   idJ (TA.Pt I) x (\ y2 e2 -> Id (W0.Ix E) (TA.coeT I x y2 e2 b) b) (refl b) y e ;

  -- the values of a line in E are all the value over the cylinder
  lc (W : Ob) (L : W0.Ix (FE.ob W)) (V : Ob) (g : Hom V W) (j : Hom V Iv)
   : Id (W0.Ix E) (sndE G A V (L.1 V g j)) (sndE G A (cy.cyl W) (L.1 (cy.cyl W) (cy.cpr1 W) (cy.cpr2 W))) =
   transH {W0.Ix E} {sndE G A V (L.1 V g j)} {sndE G A V (L.1 V (compH V (cy.cyl W) W (cy.cpr1 W) (cy.cpair W V g j)) j)} {sndE G A (cy.cyl W) (L.1 (cy.cyl W) (cy.cpr1 W) (cy.cpr2 W))}
    (apH {Hom V W} {W0.Ix E} (\ f' -> sndE G A V (L.1 V f' j)) (symH (cy.cpr1-pair W V g j)))
    (transH {W0.Ix E} {sndE G A V (L.1 V (compH V (cy.cyl W) W (cy.cpr1 W) (cy.cpair W V g j)) j)}
            {sndE G A V (L.1 V (compH V (cy.cyl W) W (cy.cpr1 W) (cy.cpair W V g j)) (compH V (cy.cyl W) Iv (cy.cpr2 W) (cy.cpair W V g j)))}
            {sndE G A (cy.cyl W) (L.1 (cy.cyl W) (cy.cpr1 W) (cy.cpr2 W))}
      (apH {Hom V Iv} {W0.Ix E} (\ j' -> sndE G A V (L.1 V (compH V (cy.cyl W) W (cy.cpr1 W) (cy.cpair W V g j)) j')) (symH (cy.cpr2-pair W V g j)))
      (symH (apH {W0.Ix (TA.E.ob V)} {W0.Ix E} (sndE G A V) (L.2 V (cy.cyl W) (cy.cpair W V g j) (cy.cpr1 W) (cy.cpr2 W))))) ;
  opaque lc ;
  -- so the two ends agree
  le (W : Ob) (L : W0.Ix (FE.ob W)) (e e' : PB.IPt)
   : Id (W0.Ix E) (sndE G A W (L.1 W (idH W) (PB.ptH W e))) (sndE G A W (L.1 W (idH W) (PB.ptH W e'))) =
   transH (lc W L W (idH W) (PB.ptH W e)) (symH (lc W L W (idH W) (PB.ptH W e'))) ;

  -- the composition from e to e': the composite is the given end
  module Cmp (e e' : PB.IPt) {
   module K = LN.CompK[e, e'] ;
   module EK = CL.EndKit[G, A, e] ;
   module EV = FA.Ev[e] ;
   module EV' = FA.Ev[e'] ;
   module TT = GPR.TyL[EK.TV.E, K.Tend] ;
   module PS = CP.Partials[EK.TV.E, EK.SFm.SF] ;
   kop (X : Ob) (w : EK.TV.EI X) (s : PS.Side[X, w]) : W0.Ix E = EK.TV.pr2 X w ;
   -- the e'-end of a line of the side is its e-end, which is the given end
   module Sd (X : Ob) (w : EK.TV.EI X) (s : PS.Side[X, w]) (W : Ob) (f : Hom W X) (i : PB.Lands W X s.pQ f) {
    u : EK.TS.EI W = s.pv W f i ;
    L : FA.TL.EI W = EK.lineL W u ;
    -- the e'-end value, as the value of the line
    e'v : Id (W0.Ix E) (EV'.endB W L) (sndE G A W (FA.lval W L W (idH W) (PB.ptH W e'))) =
     coeC W (TA.pr1 W (FA.lval W L W (idH W) (PB.ptH W e'))) ((FA.TL.pr1 W L).1 W (idH W) (PB.ptH W e'))
      (apH (\ y -> y.1 W (idH W) (PB.ptH W e')) (FA.TL.pr2 W L).2) (TA.pr2 W (FA.lval W L W (idH W) (PB.ptH W e'))) ;
    ev : Id (W0.Ix E) (EV.endB W L) (sndE G A W (FA.lval W L W (idH W) (PB.ptH W e))) =
     coeC W (TA.pr1 W (FA.lval W L W (idH W) (PB.ptH W e))) ((FA.TL.pr1 W L).1 W (idH W) (PB.ptH W e))
      (apH (\ y -> y.1 W (idH W) (PB.ptH W e)) (FA.TL.pr2 W L).2) (TA.pr2 W (FA.lval W L W (idH W) (PB.ptH W e))) ;
    -- the e-end is the point of the side element, which is the given end restricted
    endIs : Id (W0.Ix E) (EV.endB W L) (EK.TV.pr2 X w) =
     transH {W0.Ix E} {EV.endB W L} {EK.TV.pr2 W (EK.TS.pr1 W u)} {EK.TV.pr2 X w} (apH {EK.TV.EI W} {W0.Ix E} (EK.TV.pr2 W) (EK.TS.pr2 W u).2) (apH {EK.TV.EI W} {W0.Ix E} (EK.TV.pr2 W) (s.ppt W f i)) ;
    res : Id (W0.Ix E) (EV'.endB W L) (EK.TV.pr2 X w) =
     transH e'v (transH (le W (FA.lline W L) e' e) (transH (symH ev) endIs)) ;
   } ;
   kside (X : Ob) (w : EK.TV.EI X) (s : PS.Side[X, w]) (W : Ob) (f : Hom W X) (i : PB.Lands W X s.pQ f)
    : Id (TT.EI W) (TT.E.act W X f (pairE EK.TV.E K.Tend X w (kop X w s))) (K.endL.mE W (s.pv W f i)) =
    TT.pr-eqV W (EK.TV.E.act W X f w) (EK.TS.pr1 W (s.pv W f i)) (symH (s.ppt W f i)) (kop X w s) (EV'.endB W (EK.lineL W (s.pv W f i)))
     (refl E) (symH Sd[X, w, s, W, f, i].res) ;
   opaque kside ;
   kunif (Y X : Ob) (h : Hom Y X) (w : EK.TV.EI X) (s : PS.Side[X, w])
    : Id (TT.EI Y) (TT.E.act Y X h (pairE EK.TV.E K.Tend X w (kop X w s)))
        (pairE EK.TV.E K.Tend Y (EK.TV.E.act Y X h w) (kop Y (EK.TV.E.act Y X h w) (PS.rside Y X h w s))) =
    refl (pairE EK.TV.E K.Tend Y (EK.TV.E.act Y X h w) (kop X w s)) ;
   comp : K.Comp = new CP.Rel[EK.TV.E, EK.SFm.SF, K.Tend, K.endL].RC[kop, kside, kunif] ;
  } ;
  fib : LN.Fib = (Cmp[PB.e0, PB.e1].comp, Cmp[PB.e1, PB.e0].comp) ;
 } ;

 -- the fibrant type
 constS (G : PCtx) : FBC.FC.STy G = (constTy G, C[G].fib) ;
} ;
