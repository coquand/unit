-- CL59d.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part d: moving D-elements between the forms the inverse uses.
--   c1   a D-element of the context yo(y.u) and a point w of D Qc give a
--        D-element of A1 over w (A1 ignores Qc: the same family; each
--        equation is the pair of the two components' equations)
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
module VA = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Cv (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (yu : SX.Over[R].Presentation)
  (Q : CCopy6[a].YoF[R, encK, pe].TR.G1.fibCwF-T.Ty CCopy6[a].YoF[R, encK, pe].TR.G1.fibCwF-T.nil) {
 module QC = CL59c[a].QCt[R, encK, pe, yu, Q] ;
 module CM = QC.CM ;
 module DO = CobarI[a, a+, a+].DOfI[CM.IC] ;
 module DQc = DO.DC[QC.Qc] ;
 module DYu = DO.DC[QC.Yu] ;
 module DA = QC.DF.DA ;
 Obj (I : Ob) : U a+ = V1.Ix (CM.IC.obD I) ;
 pe2 (X : QC.CT.TC.TOb) (q q' : V1.Ix (QC.Qc.ob X.1 X.2)) (b b' : V1.Ix (QC.Yu.ob X.1 X.2)) (eq : Id (V1.Ix (QC.Qc.ob X.1 X.2)) q q') (eb : Id (V1.Ix (QC.Yu.ob X.1 X.2)) b b')
  : Id (DA.Ez X.1 X.2) (q, b) (q', b') =
  transH (apH {V1.Ix (QC.Qc.ob X.1 X.2)} {DA.Ez X.1 X.2} (\ z -> (z, b)) eq) (apH {V1.Ix (QC.Yu.ob X.1 X.2)} {DA.Ez X.1 X.2} (\ c -> (q', c)) eb) ;
 module C1 (I : Ob) (x : Obj I) (w : DQc.Ob' I x) (d : DYu.Ob' I x) {
  av : DA.TA I x w = \ q l -> d.1 q l ;
  anat : V1.Ix (DA.anatEq I x w av) = \ r l ->
   pe2 (r.2.1, CM.IC.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) _ _ _ _ (w.2.1 r l) (d.2.1 r l) ;
  aface : V1.Ix (DA.afaceEq I x w av) = \ r l -> pe2 (r.2.2.2.1, r.2.2.2.2.2.1) _ _ _ _ (w.2.2.1 r l) (d.2.2.1 r l) ;
  atop : V1.Ix (DA.atopEq I x w av) = \ r l -> pe2 (r.2.1, r.2.2.2.1) _ _ _ _ (w.2.2.2 r l) (d.2.2.2 r l) ;
  res : DA.TOb' I x w = (av, (anat, (aface, atop))) ;
 } ;
 -- c2: a D-element of B1 over w gives a D-element of Q over tau of the terminal point
 module DB = QC.DF.DB ;
 module DQ = CobarIT[a, a+, a+].DTI[CM.IC, QC.CT.T1, Q.1] ;
 module DT1 = DO.DC[QC.CT.T1] ;
 sndQ (X : QC.CT.TC.TOb) (p : DB.Ez X.1 X.2) : DQ.Ez X.1 X.2 = (tt, p.2) ;
 module C2 (I : Ob) (x : Obj I) (w : DQc.Ob' I x) (b : DB.TOb' I x w) {
  tg : DT1.Ob' I x = DT1.tau I x tt ;
  av : DQ.TA I x tg = \ q l -> b.1 q l ;
  anat : V1.Ix (DQ.anatEq I x tg av) = \ r l -> apH (sndQ (r.2.1, CM.IC.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (b.2.1 r l) ;
  aface : V1.Ix (DQ.afaceEq I x tg av) = \ r l -> apH (sndQ (r.2.2.2.1, r.2.2.2.2.2.1)) (b.2.2.1 r l) ;
  atop : V1.Ix (DQ.atopEq I x tg av) = \ r l -> apH (sndQ (r.2.1, r.2.2.2.1)) (b.2.2.2 r l) ;
  res : DQ.TOb' I x tg = (av, (anat, (aface, atop))) ;
 } ;
 -- c1 and c2 commute with D's actions
 module C1N (J0 I : Ob) (u0 : Hom J0 I) (y0 : Obj J0) (x : Obj I) (f0 : DO.VT.HomD J0 I u0 y0 x) (w : DQc.Ob' I x) (d : DYu.Ob' I x) {
  w' : DQc.Ob' J0 y0 = DQc.act J0 I u0 y0 x f0 w ;
  d' : DYu.Ob' J0 y0 = DYu.act J0 I u0 y0 x f0 d ;
  module TB = DA.TB[J0, I, u0, y0, x, f0, w, w', refl w', C1[I, x, w, d].res] ;
  law : Id (DA.TOb' J0 y0 w') TB.res C1[J0, y0, w', d'].res =
   DA.tob-eq J0 y0 w' TB.res C1[J0, y0, w', d'].res (\ q l -> DA.pr-inj q.2.1 q.2.2.2.1 (w'.1 q l) (TB.a' q l) (d'.1 q l) (TB.pc q l)) ;
 } ;
 module C2N (J0 I : Ob) (u0 : Hom J0 I) (y0 : Obj J0) (x : Obj I) (f0 : DO.VT.HomD J0 I u0 y0 x) (w : DQc.Ob' I x) (b : DB.TOb' I x w) {
  w' : DQc.Ob' J0 y0 = DQc.act J0 I u0 y0 x f0 w ;
  module TBb = DB.TB[J0, I, u0, y0, x, f0, w, w', refl w', b] ;
  eT : Id (DT1.Ob' J0 y0) (DT1.act J0 I u0 y0 x f0 (DT1.tau I x tt)) (DT1.tau J0 y0 tt) = symH (DT1.tau-nat J0 I u0 y0 x f0 tt) ;
  module TBq = DQ.TB[J0, I, u0, y0, x, f0, DT1.tau I x tt, DT1.tau J0 y0 tt, eT, C2[I, x, w, b].res] ;
  law : Id (DQ.TOb' J0 y0 (DT1.tau J0 y0 tt)) TBq.res C2[J0, y0, w', TBb.res].res =
   DQ.tob-eq J0 y0 (DT1.tau J0 y0 tt) TBq.res C2[J0, y0, w', TBb.res].res (\ q l ->
    DQ.pr-inj q.2.1 q.2.2.2.1 ((DT1.tau J0 y0 tt).1 q l) (TBq.a' q l) (TBb.a' q l)
     (transH (TBq.pc q l) (symH (apH (sndQ (q.2.1, q.2.2.2.1)) (TBb.pc q l))))) ;
 } ;
} ;
