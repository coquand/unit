-- CClosedCode.seg (canonicity-c2; SIMPLIFIED.md item 2): a closed
-- small fibrant type has a code in the universe over every context.
--
-- For T over the terminal context (level a, with its fibration), the
-- code at a stage I is T pulled back along y I -> 1; it is natural in I
-- because substitution composes (clSub-o) and two maps into 1 are
-- equal.  So I |-> code is a constant element of the universe over any
-- context G.  (A type over a varying context has no such code unless
-- it is strictly stable under substitution.)
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GS = PB.GPre[a].PS ;
module L = PB.GPre[a+].PS ;
module GY = PB.GYon[a] ;
module FU = FibUniv[a] ;
module UU = CPosEl1[a].UU ;

module Closed (T0 : GS.PTy[GS.nilP]) (c : PB.CFibCl.Cl GS.nilP T0) {
  eI (I : Ob) : GS.PSub[GY.yP I, GS.nilP] = GS.epsP (GY.yP I) ;
  cc (I : Ob) : UU.U0 I = (GS.subTy (GY.yP I) GS.nilP T0 (eI I), PB.CFibCl.clSub (GY.yP I) GS.nilP (eI I) T0 c) ;
  epsE (J I : Ob) (f : Hom J I) : Id (GS.PSub[GY.yP J, GS.nilP]) (GS.oS (GY.yP J) (GY.yP I) GS.nilP (eI I) (GY.yH J I f)) (eI J) =
    GS.sub-ext (GY.yP J) GS.nilP (GS.oS (GY.yP J) (GY.yP I) GS.nilP (eI I) (GY.yH J I f)) (eI J) (\ X x -> refl tt) ;
  ccN (J I : Ob) (f : Hom J I) : Id (UU.U0 J) (UU.uAct J I f (cc I)) (cc J) =
    transH (symH (PB.CFibCl.clSub-o (GY.yP J) (GY.yP I) GS.nilP (eI I) (GY.yH J I f) T0 c))
      (apH (\ t -> (GS.subTy (GY.yP J) GS.nilP T0 t, PB.CFibCl.clSub (GY.yP J) GS.nilP t T0 c)) (epsE J I f)) ;
  -- the constant code over a context
  code (G : L.PCtx) : L.PEl[G, (FU.Cod G).1] =
    L.mkPEl G (FU.Cod G).1 (\ I x -> cc I) (\ J I f x y e -> ccN J I f) ;
  -- its decoding
  DecT (G : L.PCtx) : FU.FC.STy G = FU.Dec G (code G) ;

  -- the elements of the decoding at a stage are those of T
  toDec (G : L.PCtx) (I : Ob) (x : V1.Ix (G.ob I)) (t : W0.Ix (T0.tob I tt)) : V1.Ix ((DecT G).1.tob I x) = t ;
  fromDec (G : L.PCtx) (I : Ob) (x : V1.Ix (G.ob I)) (t : V1.Ix ((DecT G).1.tob I x)) : W0.Ix (T0.tob I tt) = t ;
  -- the action of the generic family at these codes is T's action
  tg (J I : Ob) (f : Hom J I) (E : Id (UU.U0 J) (UU.uAct J I f (cc I)) (cc J)) (t : W0.Ix (T0.tob I tt))
    : Id (W0.Ix (T0.tob J tt)) (UU.tactG J I f (cc I) (cc J) E t) (T0.tact J I f tt tt (refl tt) t) =
    transH (UU.substF J (UU.uAct J I f (cc I)) (cc J) E
              ((cc I).1.tact J I f (idH I) ((GY.yH J I f).nt J (idH J)) (UU.idf-eq J I f) t))
      (transH (UU.loopV (T0.tob J tt) (ap (UU.U0 J) W0.V (UU.fib0 J) (UU.uAct J I f (cc I)) (cc J) E)
                 ((cc I).1.tact J I f (idH I) ((GY.yH J I f).nt J (idH J)) (UU.idf-eq J I f) t))
        (GS.tact-irr GS.nilP T0 J I f tt tt
           (GS.ntEq (GY.yP I) GS.nilP (eI I) J I f (idH I) ((GY.yH J I f).nt J (idH J)) (UU.idf-eq J I f))
           (refl tt) t)) ;
  dec-nat (G : L.PCtx) (J I : Ob) (f : Hom J I) (x : V1.Ix (G.ob I)) (y : V1.Ix (G.ob J)) (e : Id (V1.Ix (G.ob J)) (G.act J I f x) y)
    (t : W0.Ix (T0.tob I tt))
    : Id (V1.Ix ((DecT G).1.tob J y)) ((DecT G).1.tact J I f x y e (toDec G I x t)) (toDec G J y (T0.tact J I f tt tt (refl tt) t)) =
    tg J I f (L.ntEq G UU.UCtx (FU.clMap G (code G)) J I f x y e) t ;
  -- a closed element of T as an element of the decoding
  elUp (G : L.PCtx) (t : GS.PEl[GS.nilP, T0]) : L.PEl[G, (DecT G).1] =
    L.mkPEl G (DecT G).1 (\ I x -> t.eob I tt)
      (\ J I f x y e -> transH (dec-nat G J I f x y e (t.eob I tt)) (t.enat J I f tt tt (refl tt))) ;
} ;
