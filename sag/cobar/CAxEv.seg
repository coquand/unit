-- CAxEv.seg (canonicity-c2; the axioms' statements, part 2): the value of a
-- metatheory term t over Fin k at the generic point of G^k, given G's
-- operations on the fibres with their naturality (instantiated with GO in
-- CAxOps): variables are projections, sums and products G's operations at
-- the values, constants G's constants; natural by induction on t (as CEvT).
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module EvG (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module PW = CAxPow[a].PowOf[R, encK, pe] ;
 module GB = PW.GB ;
 module PS = PW.TR.P1 ;
 C : CwF.CwF[a++] = PW.C ;
 Nl : C.Ctx = PW.Nl ;
 Ob : U a+ = GB.CT.TC.TOb ;
 Hm (J I : Ob) : U a+ = GB.CT.TC.THm J I ;
 GV (X : Ob) : U a+ = V1.Ix (GB.GT.tob X tt) ;
 rsG (J I : Ob) (f : Hm J I) (v : GV I) : GV J = GB.GT.tact J I f tt tt (refl tt) v ;
 Gk (k : Nat) : C.Ctx = PW.Gk k ;
 Qk (k : Nat) : C.Ty (Gk k) = PW.Gat (Gk k) ;
 module Of (addV mulV : (X : Ob) -> GV X -> GV X -> GV X)
   (addN : (J I : Ob) (f : Hm J I) (u v : GV I) -> Id (GV J) (rsG J I f (addV I u v)) (addV J (rsG J I f u) (rsG J I f v)))
   (mulN : (J I : Ob) (f : Hm J I) (u v : GV I) -> Id (GV J) (rsG J I f (mulV I u v)) (mulV J (rsG J I f u) (rsG J I f v)))
   (cV : R.R -> (X : Ob) -> GV X)
   (cN : (r : R.R) (J I : Ob) (f : Hm J I) -> Id (GV J) (rsG J I f (cV r I)) (cV r J)) {
  lk : (k : Nat) -> SX.Fin k -> (X : Ob) -> V1.Ix ((Gk k).ob X) -> GV X = split {
   zero -> \ v -> absurd ((X : Ob) -> V1.Ix ((Gk zero).ob X) -> GV X) v ;
   suc k | r -> split { inl v -> \ X x -> r v X x.1 ; inr w -> \ X x -> x.2 } } ;
  ev (k : Nat) : SX.Over[R].Expr (SX.Fin k) -> (X : Ob) -> V1.Ix ((Gk k).ob X) -> GV X = split {
   var v -> \ X x -> lk k v X x ;
   cst r -> \ X x -> cV r X ;
   sumE p q | rp rq -> \ X x -> addV X (rp X x) (rq X x) ;
   mulE p q | rp rq -> \ X x -> mulV X (rp X x) (rq X x) } ;
  lkNat : (k : Nat) (v : SX.Fin k) (J I : Ob) (f : Hm J I) (x : V1.Ix ((Gk k).ob I)) -> Id (GV J) (rsG J I f (lk k v I x)) (lk k v J ((Gk k).act J I f x)) = split {
   zero -> \ v -> absurd ((J I : Ob) (f : Hm J I) (x : V1.Ix ((Gk zero).ob I)) -> Id (GV J) (rsG J I f (lk zero v I x)) (lk zero v J ((Gk zero).act J I f x))) v ;
   suc k | r -> split {
    inl v -> \ J I f x -> r v J I f x.1 ;
    inr w -> \ J I f x -> PS.tact-irr Nl GB.GT J I f tt tt (refl tt) (PS.ntEq (Gk k) Nl (C.eps (Gk k)) J I f x.1 ((Gk k).act J I f x.1) (refl ((Gk k).act J I f x.1))) x.2 } } ;
  evNat (k : Nat) : (t : SX.Over[R].Expr (SX.Fin k)) (J I : Ob) (f : Hm J I) (x : V1.Ix ((Gk k).ob I)) -> Id (GV J) (rsG J I f (ev k t I x)) (ev k t J ((Gk k).act J I f x)) = split {
   var v -> \ J I f x -> lkNat k v J I f x ;
   cst r -> \ J I f x -> cN r J I f ;
   sumE p q | rp rq -> \ J I f x -> transH (addN J I f (ev k p I x) (ev k q I x))
     (transH (apH {GV J} {GV J} (\ z -> addV J z (rsG J I f (ev k q I x))) (rp J I f x))
        (apH {GV J} {GV J} (\ z -> addV J (ev k p J ((Gk k).act J I f x)) z) (rq J I f x))) ;
   mulE p q | rp rq -> \ J I f x -> transH (mulN J I f (ev k p I x) (ev k q I x))
     (transH (apH {GV J} {GV J} (\ z -> mulV J z (rsG J I f (ev k q I x))) (rp J I f x))
        (apH {GV J} {GV J} (\ z -> mulV J (ev k p J ((Gk k).act J I f x)) z) (rq J I f x))) } ;
  enat (k : Nat) (t : SX.Over[R].Expr (SX.Fin k)) (J I : Ob) (f : Hm J I) (x : V1.Ix ((Gk k).ob I)) (y : V1.Ix ((Gk k).ob J))
    (e : Id (V1.Ix ((Gk k).ob J)) ((Gk k).act J I f x) y) : Id (GV J) ((Qk k).1.tact J I f x y e (ev k t I x)) (ev k t J y) =
   transH (PS.tact-irr Nl GB.GT J I f tt tt (PS.ntEq (Gk k) Nl (C.eps (Gk k)) J I f x y e) (refl tt) (ev k t I x))
    (transH (evNat k t J I f x) (apH {V1.Ix ((Gk k).ob J)} {GV J} (ev k t J) e)) ;
  -- the value of t at the generic point of G^k
  evE (k : Nat) (t : SX.Over[R].Expr (SX.Fin k)) : C.El (Gk k) (Qk k) = PS.mkPEl (Gk k) (Qk k).1 (ev k t) (enat k t) ;
 } ;
 -- terms over coefficients (Fin k) and points (Fin n), at the generic point of
 -- the telescope G^k.G^n (the coefficients first, then the points)
 module Two (addV mulV : (X : Ob) -> GV X -> GV X -> GV X)
   (addN : (J I : Ob) (f : Hm J I) (u v : GV I) -> Id (GV J) (rsG J I f (addV I u v)) (addV J (rsG J I f u) (rsG J I f v)))
   (mulN : (J I : Ob) (f : Hm J I) (u v : GV I) -> Id (GV J) (rsG J I f (mulV I u v)) (mulV J (rsG J I f u) (rsG J I f v)))
   (cV : R.R -> (X : Ob) -> GV X)
   (cN : (r : R.R) (J I : Ob) (f : Hm J I) -> Id (GV J) (rsG J I f (cV r I)) (cV r J)) (k n : Nat) {
  module E1 = Of[addV, mulV, addN, mulN, cV, cN] ;
  Vc : C.Ctx = PW.Ext (Gk k) n ;
  QVc : C.Ty Vc = PW.Gat Vc ;
  Var : U a = Arith[a].Plus (SX.Fin k) (SX.Fin n) ;
  dropN : (j : Nat) (X : Ob) -> V1.Ix ((PW.Ext (Gk k) j).ob X) -> V1.Ix ((Gk k).ob X) = split {
   zero -> \ X x -> x ;
   suc j | r -> \ X x -> r X x.1 } ;
  dropNat : (j : Nat) (J I : Ob) (f : Hm J I) (x : V1.Ix ((PW.Ext (Gk k) j).ob I))
    -> Id (V1.Ix ((Gk k).ob J)) (dropN j J ((PW.Ext (Gk k) j).act J I f x)) ((Gk k).act J I f (dropN j I x)) = split {
   zero -> \ J I f x -> refl ((Gk k).act J I f x) ;
   suc j | r -> \ J I f x -> r J I f x.1 } ;
  lkX : (j : Nat) -> SX.Fin j -> (X : Ob) -> V1.Ix ((PW.Ext (Gk k) j).ob X) -> GV X = split {
   zero -> \ v -> absurd ((X : Ob) -> V1.Ix ((PW.Ext (Gk k) zero).ob X) -> GV X) v ;
   suc j | r -> split { inl v -> \ X x -> r v X x.1 ; inr w -> \ X x -> x.2 } } ;
  lkXNat : (j : Nat) (v : SX.Fin j) (J I : Ob) (f : Hm J I) (x : V1.Ix ((PW.Ext (Gk k) j).ob I))
    -> Id (GV J) (rsG J I f (lkX j v I x)) (lkX j v J ((PW.Ext (Gk k) j).act J I f x)) = split {
   zero -> \ v -> absurd ((J I : Ob) (f : Hm J I) (x : V1.Ix ((PW.Ext (Gk k) zero).ob I)) -> Id (GV J) (rsG J I f (lkX zero v I x)) (lkX zero v J ((PW.Ext (Gk k) zero).act J I f x))) v ;
   suc j | r -> split {
    inl v -> \ J I f x -> r v J I f x.1 ;
    inr w -> \ J I f x -> PS.tact-irr Nl GB.GT J I f tt tt (refl tt)
               (PS.ntEq (PW.Ext (Gk k) j) Nl (C.eps (PW.Ext (Gk k) j)) J I f x.1 ((PW.Ext (Gk k) j).act J I f x.1) (refl ((PW.Ext (Gk k) j).act J I f x.1))) x.2 } } ;
  lk2 : Var -> (X : Ob) -> V1.Ix (Vc.ob X) -> GV X = split {
   inl i -> \ X x -> E1.lk k i X (dropN n X x) ;
   inr j -> \ X x -> lkX n j X x } ;
  lk2Nat : (v : Var) (J I : Ob) (f : Hm J I) (x : V1.Ix (Vc.ob I)) -> Id (GV J) (rsG J I f (lk2 v I x)) (lk2 v J (Vc.act J I f x)) = split {
   inl i -> \ J I f x -> transH (E1.lkNat k i J I f (dropN n I x)) (apH {V1.Ix ((Gk k).ob J)} {GV J} (E1.lk k i J) (symH (dropNat n J I f x))) ;
   inr j -> \ J I f x -> lkXNat n j J I f x } ;
  ev : SX.Over[R].Expr Var -> (X : Ob) -> V1.Ix (Vc.ob X) -> GV X = split {
   var v -> \ X x -> lk2 v X x ;
   cst r -> \ X x -> cV r X ;
   sumE p q | rp rq -> \ X x -> addV X (rp X x) (rq X x) ;
   mulE p q | rp rq -> \ X x -> mulV X (rp X x) (rq X x) } ;
  evNat : (t : SX.Over[R].Expr Var) (J I : Ob) (f : Hm J I) (x : V1.Ix (Vc.ob I)) -> Id (GV J) (rsG J I f (ev t I x)) (ev t J (Vc.act J I f x)) = split {
   var v -> \ J I f x -> lk2Nat v J I f x ;
   cst r -> \ J I f x -> cN r J I f ;
   sumE p q | rp rq -> \ J I f x -> transH (addN J I f (ev p I x) (ev q I x))
     (transH (apH {GV J} {GV J} (\ z -> addV J z (rsG J I f (ev q I x))) (rp J I f x))
        (apH {GV J} {GV J} (\ z -> addV J (ev p J (Vc.act J I f x)) z) (rq J I f x))) ;
   mulE p q | rp rq -> \ J I f x -> transH (mulN J I f (ev p I x) (ev q I x))
     (transH (apH {GV J} {GV J} (\ z -> mulV J z (rsG J I f (ev q I x))) (rp J I f x))
        (apH {GV J} {GV J} (\ z -> mulV J (ev p J (Vc.act J I f x)) z) (rq J I f x))) } ;
  enat (t : SX.Over[R].Expr Var) (J I : Ob) (f : Hm J I) (x : V1.Ix (Vc.ob I)) (y : V1.Ix (Vc.ob J))
    (e : Id (V1.Ix (Vc.ob J)) (Vc.act J I f x) y) : Id (GV J) (QVc.1.tact J I f x y e (ev t I x)) (ev t J y) =
   transH (PS.tact-irr Nl GB.GT J I f tt tt (PS.ntEq Vc Nl (C.eps Vc) J I f x y e) (refl tt) (ev t I x))
    (transH (evNat t J I f x) (apH {V1.Ix (Vc.ob J)} {GV J} (ev t J) e)) ;
  -- the value of t at the generic point of G^k.G^n
  evE (t : SX.Over[R].Expr Var) : C.El Vc QVc = PS.mkPEl Vc QVc.1 (ev t) (enat t) ;
 } ;
} ;
