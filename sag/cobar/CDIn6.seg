-- CDIn6.seg (canonicity-c2; (d)(2), part 6): over nil.H, at x's generator j:
-- the first components of the fwd images at x_j agree (CDIn4 with CDIn5.EJ),
-- read as the two homs at p_u (x_j), then moved along p_u's beta (CDIn3.Gen).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module In6 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module K4 = CDIn4[a].In4[R, encK, pe, x, u, y] ;
 module K5m = K4.K5m ;
 module K2 = K4.K4m ;
 module I5 = CDIn5[a].In5[R, encK, pe, x, u, y] ;
 module I1m = K4.I1m ;
 module F9 = CDFw9[a].Fw9[R, encK, pe, x, u, y] ;
 module PM = I1m.F1.PC.PM ;
 module U13m = K4.U13m ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = K4.GH ;
 QA : C.Ty Nl = K4.QA ;
 QYh : C.Ty GH = K4.QYh ;
 HU : C.Ty Nl = I1m.HU ;
 cp (j : SX.Fin x.1) : C.El Nl QA = OV.app Nl PM.AS.Qt QA PM.Phi (PM.AS.cls (var j)) ;
 cv (j : SX.Fin x.1) : C.El Nl QA = PM.AT.cls (var (SX.emb x.1 u.1 j)) ;
 lAt (j : SX.Fin x.1) (K : Ob) (z : V1.Ix (HU.1.tob K tt)) : Id (V1.Ix (K4.QY.1.tob K tt)) ((I5.EJ[j].m).nfun K tt (I1m.fwdN.nfun K tt z)) (U13m.BZ.hv K tt z.1 ((cp j).eob K tt)) =
  transH (apH {V1.Ix (I1m.F1.S1.HXY.1.tob K tt)} {V1.Ix (K4.QY.1.tob K tt)} (\ h -> I5.EJ[j].EA.nf K tt h) (F9.rdH K z))
   (symH (apH {V1.Ix (QA.1.tob K tt)} {V1.Ix (K4.QY.1.tob K tt)} (\ c -> U13m.BZ.hv K tt z.1 c) (CAppRd[a].App0[PM.AS.Qt, QA, PM.Phi, PM.AS.cls (var j)].rd K tt))) ;
 lA (j : SX.Fin x.1) (K : Ob) : (o : Top) (h : V1.Ix (K2.H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) ((I5.EJ[j].m).nfun K o (I1m.fwdN.nfun K o (K2.pkA K (o, h)))) ((U13m.ZA.apC (cp j)).eob K (o, h)) =
  split { tt -> \ h -> transH (lAt j K h.1) (symH (U13m.ZA.rdF (cp j) K (tt, h))) } ;
 lB (j : SX.Fin x.1) (K : Ob) : (o : Top) (h : V1.Ix (K2.H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) ((I5.EJ[j].m).nfun K o (I1m.fwdN.nfun K o (K2.pkB K (o, h)))) ((U13m.ZB.apC (cp j)).eob K (o, h)) =
  split { tt -> \ h -> transH (lAt j K h.2.1) (symH (U13m.ZB.rdF (cp j) K (tt, h))) } ;
 g0 (j : SX.Fin x.1) : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC (cp j)) (U13m.ZB.apC (cp j))) =
  K4.Cmp[I5.EJ[j].m, cp j, \ K w -> lA j K w.1 w.2, \ K w -> lB j K w.1 w.2].res ;
 old (j : SX.Fin x.1) : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC (cv j)) (U13m.ZB.apC (cv j))) =
  K5m.Gen[cp j, cv j, PM.beta (var j), g0 j].res ;
} ;
