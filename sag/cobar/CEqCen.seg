-- CEqCen.seg (canonicity-45; SIMPLIFIED.md step 6): the centre map of an
-- equivalence structure at the total site.  For al : B -> A over a context
-- D and e an equivalence structure of al, the contraction at the empty side
-- gives at each point w of D.A a centre of al's homotopy fibre; its B part
-- is a map inv : A -> B over D (a PMap), natural by e's uniformity
-- (kunif) and kop-cong (the restricted empty side is the empty side,
-- pre-empty).
--   cen     the centre of the fibre over w
--   inv     the map of types A -> B
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module Cen (C : CIntCat[a, vl].IC)
  (D : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PCtx)
  (B A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[D])
  (al : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[D, B, A])
  (e : CTotR[a, vl, l].TotR[C].G1.GB.CEquiv[l].EquivOp D B A al) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module GB = TR.G1.GB ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module CP = GB.CPartial[l] ;
 module H = GB.CEquiv[l].HFib[D, B, A, al] ;
 module PS = CP.Partials[H.EA, H.FibT] ;
 module RL = CP.Rel[H.EA, H.FibT, H.FibT, CP.pmap-id H.EA H.FibT] ;
 emptyP (X : TC.TOb) (w : W0.Ix (H.EA.ob X)) : PS.Side[X, w] =
  new PS.Side[X, w, GB.emptyS X, \ V f i -> absurd _ (GB.empty-lands V X f i), \ V f i -> absurd _ (GB.empty-lands V X f i),
   \ W' W chi f i i' -> absurd _ (GB.empty-lands W X f i)] ;
 cen (X : TC.TOb) (w : W0.Ix (H.EA.ob X)) : W0.Ix (H.FibT.tob X w) = e.kop X w (emptyP X w) ;
 cenT (X : TC.TOb) (w : W0.Ix (H.EA.ob X)) : H.TF.EI X = H.TF.pr X w (cen X w) ;
 -- the centre commutes with restriction
 cenNat (Y X : TC.TOb) (h : TC.THm Y X) (w : W0.Ix (H.EA.ob X)) : Id (H.TF.EI Y) (H.TF.E.act Y X h (cenT X w)) (cenT Y (H.EA.act Y X h w)) =
  transH (e.kunif Y X h w (emptyP X w))
   (RL.kop-cong e Y (H.EA.act Y X h w) (H.EA.act Y X h w) (refl (H.EA.act Y X h w))
      (PS.rside Y X h w (emptyP X w)) (emptyP Y (H.EA.act Y X h w))
      (PS.side-extH Y (H.EA.act Y X h w) (H.EA.act Y X h w) (refl (H.EA.act Y X h w))
         (PS.rside Y X h w (emptyP X w)) (emptyP Y (H.EA.act Y X h w))
         (GB.pre-empty Y X h) (\ W f i i' -> absurd _ (GB.empty-lands W Y f i')))) ;
 -- the inverse map
 invE (X : TC.TOb) (w : H.TA.EI X) : H.TB.EI X = H.fibB X (cenT X w) ;
 inv : CP.PMap[D, A, B] =
  CP.mkPMap D A B invE (\ X w -> refl (H.TA.pr1 X w))
   (\ Y X h w -> transH (symH (apH {H.TF.EI Y} {H.TB.EI Y} (H.fibB Y) (cenNat Y X h w))) (H.fibB-act Y X h (cenT X w))) ;
} ;
