-- CPshJNatT.seg (canonicity-45; (B) stage 2(b), COBAR.md): J commutes
-- with the C-action.  Generalisation of PosJNat.JNatG: for a C-context Dc
-- over Gc, a C-type CM over Dc, J-data (PosJNat.JD) at two objects y, x of
-- C whose maps commute with the C-action along f : y -> x (prEq, lamEq,
-- psiEq), compositions kC' at x and kC at y that commute with the
-- C-action (cu: the body of LO.UF.UComp at (y, x, f)), and starts d', d
-- that commute (dEq), the J of CJ at x, moved by CM.tE, is the J at y at
-- the moved point.  In JNatG the type at x is C[upD] and the composition
-- the moved one, so kopMv does the work; here the type map CM.tE y x f over
-- Dc.act y x f replaces the substitution and cu replaces kopMv.
--   JNatT[Gc, Dc, CM, y, x, f, jd', jd, prEq, lamEq, psiEq, kC', kC, cu, d', d, dEq].jnat
--     : ((CM.tE y x f).nt X (pairE z (J1.J.eob X z))) = pairE (upD z) (J0.J.eob X (upD z))

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module PJ = PosJNat[a, l] ;

module JNatTOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 open P ;

 module JNatT (Gc Dc : CCtx) (CM : CTy[Dc]) (y x : CO) (f : CH y x)
  (jd' : PJ.JD[Gc.ob x, Dc.ob x]) (jd : PJ.JD[Gc.ob y, Dc.ob y])
  (prEq : (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) -> Id (W0.Ix ((Gc.ob y).ob X)) (jd.pr.nt X ((Dc.act y x f).nt X z)) ((Gc.act y x f).nt X (jd'.pr.nt X z)))
  (lamEq : (X : Ob) (z : W0.Ix ((Dc.ob x).ob X))
     -> Id (W0.Ix (CL.FC[Dc.ob y].ob X)) (CL.FMap[Dc.ob x, Dc.ob y, Dc.act y x f].mapF X (jd'.lam X z)) (jd.lam X ((Dc.act y x f).nt X z)))
  (psiEq : (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) -> Id (PB.Phi X) (jd'.psi X z) (jd.psi X ((Dc.act y x f).nt X z)))
  (kC' : CL.Lines[Dc.ob x, CM.ty x].CompK[PB.e0, PB.e1].Comp) (kC : CL.Lines[Dc.ob y, CM.ty y].CompK[PB.e0, PB.e1].Comp)
  (cu : (X : Ob) (w : W0.Ix ((LO.SF[Dc, CM, PB.e0].TVC.ob x).ob X)) (sd : CP.Partials[LO.SF[Dc, CM, PB.e0].TVC.ob x, LO.SF[Dc, CM, PB.e0].SFC.ty x].Side[X, w])
     -> Id (SigT (LO.SF[Dc, CM, PB.e0].TVC.ob y) ((LO.SF[Dc, CM, PB.e0].TendC PB.e1).ty y) X)
          (((LO.SF[Dc, CM, PB.e0].TendC PB.e1).tE y x f).nt X (pairE (LO.SF[Dc, CM, PB.e0].TVC.ob x) ((LO.SF[Dc, CM, PB.e0].TendC PB.e1).ty x) X w (kC'.kop X w sd)))
          (pairE (LO.SF[Dc, CM, PB.e0].TVC.ob y) ((LO.SF[Dc, CM, PB.e0].TendC PB.e1).ty y) X ((LO.SF[Dc, CM, PB.e0].TVC.act y x f).nt X w)
             (kC.kop X ((LO.SF[Dc, CM, PB.e0].TVC.act y x f).nt X w) (MapSide[LO.SF[Dc, CM, PB.e0].TVC, LO.SF[Dc, CM, PB.e0].SFC, y, x, f].mapside X w sd))))
  (d' : PEl[Gc.ob x, subTy (Gc.ob x) (Dc.ob x) (CM.ty x) jd'.c]) (d : PEl[Gc.ob y, subTy (Gc.ob y) (Dc.ob y) (CM.ty y) jd.c])
  (dEq : (X : Ob) (x0 : W0.Ix ((Gc.ob x).ob X))
     -> Id (SigT (Dc.ob y) (CM.ty y) X) ((CM.tE y x f).nt X (pairE (Dc.ob x) (CM.ty x) X (jd'.c.nt X x0) (d'.eob X x0)))
                                        (pairE (Dc.ob y) (CM.ty y) X (jd.c.nt X ((Gc.act y x f).nt X x0)) (d.eob X ((Gc.act y x f).nt X x0)))) {
  module SFe = LO.SF[Dc, CM, PB.e0] ;
  module AEe = SFe.AE' ;
  module AEt = LO.AE[Dc, CM, PB.e1] ;
  module SCe = LO.SC[SFe.TVC, LO.LinC Dc, LO.pPC (LO.LinC Dc) AEe.AevC, AEt.AevC] ;
  module MS = MapSide[SFe.TVC, SFe.SFC, y, x, f] ;
  module J0 = PJ.JJ[Gc.ob y, Dc.ob y, jd, CM.ty y, kC, d].J0 ;
  module J1 = PJ.JJ[Gc.ob x, Dc.ob x, jd', CM.ty x, kC', d'].J0 ;
  module TC = J0.TC ;
  module TC' = J1.TC ;
  module EK = J0.EK ;
  module EK' = J1.EK ;
  upD (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) : W0.Ix ((Dc.ob y).ob X) = (Dc.act y x f).nt X z ;
  ta (W : Ob) (v : TC'.EI W) : TC.EI W = (CM.tE y x f).nt W v ;
  tv (X : Ob) (w : EK'.TV.EI X) : EK.TV.EI X = AEe.tEv y x f X w ;
  ts (W : Ob) (u : EK'.TS.EI W) : EK.TS.EI W = SFe.tES y x f W u ;
  tv-nat (V X : Ob) (g : Hom V X) (w : EK'.TV.EI X) : Id (EK.TV.EI V) (tv V (EK'.TV.E.act V X g w)) (EK.TV.E.act V X g (tv X w)) =
   (AEe.tEvP y x f).nt-nat V X g w ;

  -- d' read at upD is d read at Gc.act
  dEq' (X : Ob) (x0 : W0.Ix ((Gc.ob x).ob X)) : Id (TC.EI X) (ta X (J1.dE X x0)) (J0.dE X ((Gc.act y x f).nt X x0)) = dEq X x0 ;

  -- the moved start is the start at upD z
  ptEq (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) : Id (EK.TV.EI X) (tv X (J1.start X z)) (J0.start X (upD X z)) =
   EK.tv-eq X (tv X (J1.start X z)) (J0.start X (upD X z)) (lamEq X z)
    (calc (TC.EI X) {
        EK.endE X (tv X (J1.start X z))
      =< AEe.endEv y x f X (J1.start X z) >
        ta X (EK'.endE X (J1.start X z))
      =< apH (ta X) (J1.start-E X z) >
        ta X (J1.dE X (jd'.pr.nt X z))
      =< dEq' X (jd'.pr.nt X z) >
        J0.dE X ((Gc.act y x f).nt X (jd'.pr.nt X z))
      =< apH (J0.dE X) (symH (prEq X z)) >
        J0.dE X (jd.pr.nt X (upD X z))
      =< symH (J0.start-E X (upD X z)) >
        EK.endE X (J0.start X (upD X z)) }) ;

  -- the values of the constant lines at d agree
  tEq (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) (V : Ob) (h : Hom V X)
   : Id (TC.EI V) (ta V (J1.dz X z V h)) (J0.dz X (upD X z) V h) =
   transH (dEq' V (jd'.pr.nt V ((Dc.ob x).act V X h z)))
    (apH (J0.dE V) (transH (symH (prEq V ((Dc.ob x).act V X h z))) (apH (jd.pr.nt V) ((Dc.act y x f).nt-nat V X h z)))) ;

  -- the moved side is the side at upD z
  sideEq (X : Ob) (z : W0.Ix ((Dc.ob x).ob X))
   : Id (EK.PT.Side[X, J0.start X (upD X z)])
       (subst (EK.TV.EI X) (\ w -> EK.PT.Side[X, w]) (tv X (J1.start X z)) (J0.start X (upD X z)) (ptEq X z) (MS.mapside X (J1.start X z) (J1.side X z)))
       (J0.side X (upD X z)) =
   EK.PT.side-extH X (tv X (J1.start X z)) (J0.start X (upD X z)) (ptEq X z) (MS.mapside X (J1.start X z) (J1.side X z)) (J0.side X (upD X z))
    (psiEq X z)
    (\ W h i i' ->
     EK.ts-ext W (ts W (J1.sideV X z W h i)) (J0.sideV X (upD X z) W h i')
      (calc (EK.TV.EI W) {
          EK.TS.pr1 W (ts W (J1.sideV X z W h i))
        =< apH (tv W) (EK'.mkTS-pt W (EK'.TV.E.act W X h (J1.start X z)) J1.Sd[X, z, W, h, i].L (refl (J1.FD.actF W X h (jd'.lam X z))) J1.Sd[X, z, W, h, i].q) >
          tv W (EK'.TV.E.act W X h (J1.start X z))
        =< tv-nat W X h (J1.start X z) >
          EK.TV.E.act W X h (tv X (J1.start X z))
        =< apH (EK.TV.E.act W X h) (ptEq X z) >
          EK.TV.E.act W X h (J0.start X (upD X z))
        =< symH (EK.mkTS-pt W (EK.TV.E.act W X h (J0.start X (upD X z))) J0.Sd[X, upD X z, W, h, i'].L (refl (J0.FD.actF W X h (jd.lam X (upD X z)))) J0.Sd[X, upD X z, W, h, i'].q) >
          EK.TS.pr1 W (J0.sideV X (upD X z) W h i') })
      (\ V g j ->
       calc (TC.EI V) {
           EK.lv W (ts W (J1.sideV X z W h i)) V g j
         =< apH (\ M -> ta V (J1.FA.lval W M V g j)) (EK'.mkTS-line W (EK'.TV.E.act W X h (J1.start X z)) J1.Sd[X, z, W, h, i].L (refl (J1.FD.actF W X h (jd'.lam X z))) J1.Sd[X, z, W, h, i].q) >
           ta V (J1.dz X z V (compH V W X h g))
         =< tEq X z V (compH V W X h g) >
           J0.dz X (upD X z) V (compH V W X h g)
         =< symH (apH (\ M -> J0.FA.lval W M V g j) (EK.mkTS-line W (EK.TV.E.act W X h (J0.start X (upD X z))) J0.Sd[X, upD X z, W, h, i'].L (refl (J0.FD.actF W X h (jd.lam X (upD X z)))) J0.Sd[X, upD X z, W, h, i'].q)) >
           EK.lv W (J0.sideV X (upD X z) W h i') V g j })) ;
  opaque ptEq ; opaque sideEq ;

  -- a composite, moved and read in CM, is the composite read in CM
  mVrB (x0 : CO) (W : Ob) (u : SigT (SFe.TVC.ob x0) ((SFe.TendC PB.e1).ty x0) W)
   : Id (AEt.TVT x0 W) (CL.Lines[Dc.ob x0, CM.ty x0].CompK[PB.e0, PB.e1].SE.mV W u) (SCe.rB x0 W u) = refl (SCe.rB x0 W u) ;
  opaque mVrB ;
  rdC (X : Ob) (v : J1.TT.EI X) : Id (TC.EI X) (J0.rd X (((SFe.TendC PB.e1).tE y x f).nt X v)) (ta X (J1.rd X v)) =
   transH {TC.EI X} {J0.EK'.endE X (J0.CK.SE.mV X (SCe.tEs y x f X v))} {J0.EK'.endE X (AEt.tEv y x f X (SCe.rB x X v))} {ta X (J1.rd X v)}
    (apH (J0.EK'.endE X) (transH (mVrB y X (SCe.tEs y x f X v)) (SCe.rBtE y x f X v)))
    (transH {TC.EI X} {J0.EK'.endE X (AEt.tEv y x f X (SCe.rB x X v))} {ta X (J1.EK'.endE X (SCe.rB x X v))} {ta X (J1.rd X v)}
      (AEt.endEv y x f X (SCe.rB x X v))
      (apH (ta X) (apH (J1.EK'.endE X) (symH (mVrB x X v))))) ;
  opaque rdC ;

  -- the composite at z, moved, is the composite at upD z
  outEq (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) : Id (J0.TT.EI X) (((SFe.TendC PB.e1).tE y x f).nt X (J1.out X z)) (J0.out X (upD X z)) =
   transH (cu X (J1.start X z) (J1.side X z))
    (J0.RC.kop-cong kC X (tv X (J1.start X z)) (J0.start X (upD X z)) (ptEq X z)
       (MS.mapside X (J1.start X z) (J1.side X z)) (J0.side X (upD X z)) (sideEq X z)) ;
  opaque outEq ;

  -- the theorem: the value of J at z, moved, is the value of J at upD z
  jnat (X : Ob) (z : W0.Ix ((Dc.ob x).ob X))
   : Id (TC.EI X) (ta X (TC'.pr X z (J1.J.eob X z))) (TC.pr X (upD X z) (J0.J.eob X (upD X z))) =
   calc (TC.EI X) {
       ta X (TC'.pr X z (J1.jv X z))
     =< apH (ta X) (J1.jv-E X z) >
       ta X (J1.rd X (J1.out X z))
     =< symH (rdC X (J1.out X z)) >
       J0.rd X (((SFe.TendC PB.e1).tE y x f).nt X (J1.out X z))
     =< apH (J0.rd X) (outEq X z) >
       J0.rd X (J0.out X (upD X z))
     =< symH (J0.jv-E X (upD X z)) >
       TC.pr X (upD X z) (J0.jv X (upD X z)) } ;
  opaque jnat ;
 } ;
} ;
