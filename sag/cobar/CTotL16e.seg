-- CTotL16e.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, the double reading MW2, part 2: for an outer index q', the inner
-- face and top equations of the inner family (Lemma16.seg's IF / IT).
--   rd, rdTr   u read at an index, and at an index with its arity
--              transported (catS)
--   IF.eq      the face k of c is the face m+1+k of catA (rCh c') c
--              (comp-back)
--   IT.eq      the top face of catA (rCh c') c is the top face of c
--              (drop-cat)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module WB = CTotL16b[a, vl, l] ;

plusLe : (m : Nat) -> (k n : Nat) (hk : Tr.IsT (Tr.leb k n)) -> Tr.IsT (Tr.leb (Ar.plus m (suc k)) (Ar.plus m (suc n))) = split {
 zero -> \ k n hk -> hk ;
 suc m' | ih -> \ k n hk -> ih k n hk } ;

module L16e (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (Wf : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (WB.substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face)) {
 module LD = CTotL16d[a, vl, l].L16d[C, G, A, Wf] ;
 module LB = LD.LB ;
 module D = LB.D ;
 module DO = LD.DO ;
 module DA = LB.DA ;
 module VT = LB.VT ;
 module U12 = Lemma12I[a, vl, l].L12I[C, G, A] ;
 E : LB.P.PCtx = LB.E ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 facePos (n : Nat) (J : Ob) (y y' : Nat) (e : Id Nat y y') (hy : Tr.IsT (Tr.leb y (suc n))) (hy' : Tr.IsT (Tr.leb y' (suc n))) (p : Wt.Pn n J)
  : Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[p].face) (Wt.Face[n, J, y', hy'].Of[p].face) =
  idJ Nat y (\ y2 e2 -> (hy2 : Tr.IsT (Tr.leb y2 (suc n))) -> Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[p].face) (Wt.Face[n, J, y2, hy2].Of[p].face))
   (\ hy2 -> U12.faceW-irr n J y hy hy2 p) y' e hy' ;

 module RD (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) {
  tg : D.Ob' I x = D.tau I x g ;
  rd (N : Nat) (J' : Ob) (k : Hom J' I) (z : Obj J') (ch : DO.KJ[J'].K.Ch N (C.res J' I k x) z) (w : Wt.Pn N J') : DA.Ez J' z =
   DA.prz J' z (tg.1 (N, J', k, z, ch, w.1) w.2) (u.1 (N, J', k, z, ch, w.1) w.2) ;
  rdTr (N N' : Nat) (e : Id Nat N N') (J' : Ob) (k : Hom J' I) (z : Obj J') (ch : DO.KJ[J'].K.Ch N (C.res J' I k x) z) (w : Wt.Pn N J')
   : Id (DA.Ez J' z) (rd N J' k z ch w) (rd N' J' k z (CTotL16c[a, vl, l].CA[C, J'].trCh N N' e (C.res J' I k x) z ch) (WB.substP J' N N' e w)) =
   idJ Nat N (\ N2 e2 -> Id (DA.Ez J' z) (rd N J' k z ch w) (rd N2 J' k z (CTotL16c[a, vl, l].CA[C, J'].trCh N N2 e2 (C.res J' I k x) z ch) (WB.substP J' N N2 e2 w)))
    (refl (rd N J' k z ch w)) N' e ;
 } ;

 module OF (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) (t : Hom I PFO.ivO)
   (q' : DA.Idx I x) (l' : DA.LandsI I x q') {
  module R = RD[I, x, g, u] ;
  m : Nat = q'.1 ;
  J : Ob = q'.2.1 ;
  y : Obj q'.2.1 = q'.2.2.2.1 ;
  gmy : W0.Ix (G.ob q'.2.1 q'.2.2.2.1) = (D.tau I x g).1 q' l' ;
  tgy : D.Ob' q'.2.1 q'.2.2.2.1 = D.tau q'.2.1 q'.2.2.2.1 gmy ;
  iv : DA.TA q'.2.1 q'.2.2.2.1 tgy = \ q li -> LD.Inner[I, x, g, u, t, q', l', q, li].val ;

  -- the inner faces
  module IF (r : VA.Ix (D.faceIdxV q'.2.1 q'.2.2.2.1)) (li : D.faceLd q'.2.1 q'.2.2.2.1 r) {
   J' : Ob = r.2.2.2.1 ;
   z : Obj r.2.2.2.1 = r.2.2.2.2.2.1 ;
   module Ia = LD.Inner[I, x, g, u, t, q', l', (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF q'.2.1 q'.2.2.2.1 r li).1), (DA.afaceF q'.2.1 q'.2.2.2.1 r li).2] ;
   module Ib = LD.Inner[I, x, g, u, t, q', l', (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 q'.2.1 r.2.2.2.2.1 q'.2.2.2.1) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2), li] ;
   module CA = CTotL16c[a, vl, l].CA[C, r.2.2.2.1] ;
   N' : Nat = Ar.plus m (suc r.1) ;
   cS : DO.KJ[r.2.2.2.1].K.Ch (suc (Ar.plus m (suc r.1))) Ia.X' r.2.2.2.2.2.1 = CA.catS m r.1 Ia.X' Ia.Y' r.2.2.2.2.2.1 Ia.c2 r.2.2.2.2.2.2.1 ;
   hkU : Tr.IsT (Tr.leb (Ar.plus m (suc r.2.1)) (Ar.plus m (suc r.1))) = plusLe m r.2.1 r.1 r.2.2.1 ;
   eq : Id (DA.Ez r.2.2.2.1 r.2.2.2.2.2.1) (DA.afaceL q'.2.1 q'.2.2.2.1 tgy iv r li) (DA.afaceR q'.2.1 q'.2.2.2.1 tgy iv r li) =
    transH Ia.pc
     (transH (R.rdTr (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1)) r.2.2.2.1 Ia.gg r.2.2.2.2.2.1 Ia.cc Ia.w)
       (transH (apH (R.rd (suc N') r.2.2.2.1 Ia.gg r.2.2.2.2.2.1 cS) (WfaceR m r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PFO.ivO t Ia.gg) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1) Ib.jr Ib.iP))
         (transH (apH (R.rd (suc N') r.2.2.2.1 Ia.gg r.2.2.2.2.2.1 cS)
                    (U12.faceW-irr N' r.2.2.2.1 (Ar.plus m (suc r.2.1)) (Wt.hRB m r.1 r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1)) (Ar.leb-step (Ar.plus m (suc r.2.1)) N' hkU) Ib.w))
           (transH (u.2.2.1 (N', Ar.plus m (suc r.2.1), hkU, r.2.2.2.1, Ia.gg, r.2.2.2.2.2.1, cS, Ib.w.1) Ib.w.2)
             (transH (apH (\ ch -> R.rd N' r.2.2.2.1 Ia.gg r.2.2.2.2.2.1 ch Ib.w) (CA.comp-back m r.1 r.2.1 Ia.X' Ia.Y' r.2.2.2.2.2.1 Ia.c2 r.2.2.2.2.2.2.1))
               (symH Ib.pc)))))) ;
  } ;
  iface : W0.Ix (DA.afaceEq q'.2.1 q'.2.2.2.1 tgy iv) = \ r li -> IF[r, li].eq ;

  -- the top face
  module IT (r : VA.Ix (D.topIdxV q'.2.1 q'.2.2.2.1)) (li : D.topLd q'.2.1 q'.2.2.2.1 r) {
   module Ia = LD.Inner[I, x, g, u, t, q', l', (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF q'.2.1 q'.2.2.2.1 r li).1), (DA.atopF q'.2.1 q'.2.2.2.1 r li).2] ;
   dr : DO.KJ[r.2.1].K.DR r.1 (C.res r.2.1 q'.2.1 r.2.2.1 q'.2.2.2.1) r.2.2.2.1 = D.topD q'.2.1 q'.2.2.2.1 r ;
   module Ib = LD.Inner[I, x, g, u, t, q', l', (r.1, r.2.1, r.2.2.1, dr.1, dr.2.1, r.2.2.2.2.2), li] ;
   module CA = CTotL16c[a, vl, l].CA[C, r.2.1] ;
   N' : Nat = Ar.plus m (suc r.1) ;
   cS : DO.KJ[r.2.1].K.Ch (suc (Ar.plus m (suc r.1))) Ia.X' r.2.2.2.1 = CA.catS m r.1 Ia.X' Ia.Y' r.2.2.2.1 Ia.c2 r.2.2.2.2.1 ;
   eq : Id (DA.Ez r.2.1 r.2.2.2.1) (DA.atopL q'.2.1 q'.2.2.2.1 tgy iv r li) (DA.atopR q'.2.1 q'.2.2.2.1 tgy iv r li) =
    transH Ia.pc
     (transH (R.rdTr (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1)) r.2.1 Ia.gg r.2.2.2.1 Ia.cc Ia.w)
       (transH (apH (R.rd (suc N') r.2.1 Ia.gg r.2.2.2.1 cS) (WfaceR m r.1 r.2.1 (PB.compH r.2.1 I PFO.ivO t Ia.gg) (suc r.1) (Tr.leb-refl (suc r.1)) Ib.jr Ib.iP))
         (transH (apH (R.rd (suc N') r.2.1 Ia.gg r.2.2.2.1 cS)
                    (facePos N' r.2.1 (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1))
                       (Wt.hRB m r.1 (suc r.1) (Tr.leb-refl (suc r.1))) (Tr.leb-refl (suc N')) Ib.w))
           (transH (u.2.2.2 (N', r.2.1, Ia.gg, r.2.2.2.1, cS, Ib.w.1) Ib.w.2)
             (transH (apH {DO.KJ[r.2.1].K.DR N' Ia.X' r.2.2.2.1} {DA.Ez r.2.1 r.2.2.2.1}
                        (\ Dd -> E.act (r.2.1, r.2.2.2.1) (r.2.1, Dd.1) (idH r.2.1, Dd.2.2) (R.rd N' r.2.1 Ia.gg Dd.1 Dd.2.1 Ib.w))
                        (CA.drop-cat m r.1 Ia.X' Ia.Y' r.2.2.2.1 Ia.c2 r.2.2.2.2.1))
               (apH {DA.Ez r.2.1 dr.1} {DA.Ez r.2.1 r.2.2.2.1} (E.act (r.2.1, r.2.2.2.1) (r.2.1, dr.1) (idH r.2.1, dr.2.2)) (symH Ib.pc))))))) ;
  } ;
  itop : W0.Ix (DA.atopEq q'.2.1 q'.2.2.2.1 tgy iv) = \ r li -> IT[r, li].eq ;
 } ;
} ;
