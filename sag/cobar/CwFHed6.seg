-- CwFHed6.seg (canonicity-c2; for "D preserves h-sets"): Hedberg's
-- conclusion as an internal statement. With Hedberg data (R a proposition,
-- rho : R(x), f : R -> Id(x , -)) at G.A, x : A, the identity type
-- Id(x , y) over G.A (y the variable) is a proposition: Fin at
-- G.A.Id.Id along the projection (CwFHed5), read back along subT-o,
-- Id-ov and idBack.
open Base ;

module Hed6 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module TRm = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module H5 = CwFHed5.Hed5[l, C, PS, SS, IJ] ;
  module PN = CwFPropNoU.PropNoU[l, C, PS, SS, IJ, NF] ;
  idBack (G : Ctx) (X X' : Ty G) (P : Id (Ty G) X X') (x y : El G X)
    (u : El G (IJ.IdT G X' (trE G X X' P x) (trE G X X' P y))) : El G (IJ.IdT G X x y) =
    idJ (Ty G) X (\ Z PZ -> El G (IJ.IdT G Z (trE G X Z PZ x) (trE G X Z PZ y)) -> El G (IJ.IdT G X x y)) (\ v -> v) X' P u ;
  module S (G : Ctx) (A : Ty G) (x : El G A) (R : Ty (ext G A)) (rho : El G (subT G (ext G A) R (sec G A x)))
    (f : El (ext (ext G A) R) (wkT (ext G A) R (JP.IK G A x))) (pR : El (ext G A) (PN.isProp (ext G A) R)) {
    K : Ctx = ext G A ;
    IK : Ty K = JP.IK G A x ;
    KI : Ctx = ext K IK ;
    IKw : Ty KI = wkT K IK IK ;
    G3 : Ctx = ext KI IKw ;
    pp : Sub G3 K = o G3 KI K (p K IK) (p KI IKw) ;
    s3 : Sub G3 G = o G3 K G (p G A) pp ;
    module M = H5.Mv[G, G3, A, x, R, rho, f, s3] ;
    PA : Id (Ty G3) (subT G3 K (wkT G A A) pp) M.A' = sym (Ty G3) M.A' (subT G3 K (wkT G A A) pp) (subT-o G3 K G A (p G A) pp) ;
    y3 : El G3 M.A' = trE G3 (subT G3 K (wkT G A A) pp) M.A' PA (subt G3 K (wkT G A A) (q G A) pp) ;
    Pa : Ov G3 K (wkT G A A) pp M.A' PA (wkE G A A x) M.x' =
      trans (El G3 M.A') (trE G3 (subT G3 K (wkT G A A) pp) M.A' PA (subt G3 K (wkT G A A) (wkE G A A x) pp))
        (trE G3 (subT G3 K (wkT G A A) pp) M.A' PA (trE G3 M.A' (subT G3 K (wkT G A A) pp) (subT-o G3 K G A (p G A) pp) M.x'))
        M.x'
        (ap (El G3 (subT G3 K (wkT G A A) pp)) (El G3 M.A') (\ z -> trE G3 (subT G3 K (wkT G A A) pp) M.A' PA z)
           (subt G3 K (wkT G A A) (wkE G A A x) pp) (trE G3 M.A' (subT G3 K (wkT G A A) pp) (subT-o G3 K G A (p G A) pp) M.x')
           (sym (El G3 (subT G3 K (wkT G A A) pp)) (trE G3 M.A' (subT G3 K (wkT G A A) pp) (subT-o G3 K G A (p G A) pp) M.x')
              (subt G3 K (wkT G A A) (wkE G A A x) pp) (subt-o G3 K G A x (p G A) pp)))
        (trans (El G3 M.A') (trE G3 (subT G3 K (wkT G A A) pp) M.A' PA (trE G3 M.A' (subT G3 K (wkT G A A) pp) (subT-o G3 K G A (p G A) pp) M.x'))
           (trE G3 M.A' M.A' (trans (Ty G3) M.A' (subT G3 K (wkT G A A) pp) M.A' (subT-o G3 K G A (p G A) pp) PA) M.x') M.x'
           (trE-tr G3 M.A' (subT G3 K (wkT G A A) pp) M.A' (subT-o G3 K G A (p G A) pp) PA M.x')
           (trE-irr G3 M.A' M.A' (trans (Ty G3) M.A' (subT G3 K (wkT G A A) pp) M.A' (subT-o G3 K G A (p G A) pp) PA) (refl M.A') M.x')) ;
    -- the two path variables, as elements of Id(x' , y3)
    I3 : Ty G3 = IJ.IdT G3 M.A' M.x' y3 ;
    P3 : Id (Ty G3) (wkT KI IKw IKw) I3 =
      trans (Ty G3) (wkT KI IKw IKw) (subT G3 K IK pp) I3
        (sym (Ty G3) (subT G3 K IK pp) (wkT KI IKw IKw) (subT-o G3 KI K IK (p K IK) (p KI IKw)))
        (Id-ov G3 K (wkT G A A) (wkE G A A x) (q G A) pp M.A' PA M.x' y3 Pa (refl y3)) ;
    u3 : El G3 I3 = trE G3 (wkT KI IKw IKw) I3 P3 (wkE KI IKw IKw (q K IK)) ;
    u3' : El G3 I3 = trE G3 (wkT KI IKw IKw) I3 P3 (q KI IKw) ;
    -- R' is a proposition, so the transports of rho' along u3 and u3' are joined
    pR' : El M.DA (PN.isProp M.DA M.R') =
      trE M.DA (subT M.DA K (PN.isProp K R) M.ls) (PN.isProp M.DA M.R') (PN.isProp-ov M.DA K R M.ls M.R' (refl M.R'))
        (subt M.DA K (PN.isProp K R) pR M.ls) ;
    Ry : Ty G3 = subT G3 M.DA M.R' (sec G3 M.A' y3) ;
    pRy : El G3 (PN.isProp G3 Ry) =
      trE G3 (subT G3 M.DA (PN.isProp M.DA M.R') (sec G3 M.A' y3)) (PN.isProp G3 Ry) (PN.isProp-ov G3 M.DA M.R' (sec G3 M.A' y3) Ry (refl Ry))
        (subt G3 M.DA (PN.isProp M.DA M.R') pR' (sec G3 M.A' y3)) ;
    e3 : El G3 (IJ.IdT G3 Ry (TRm.trP G3 M.A' M.R' M.x' y3 u3 M.rho') (TRm.trP G3 M.A' M.R' M.x' y3 u3' M.rho')) =
      PN.propPath G3 Ry pRy (TRm.trP G3 M.A' M.R' M.x' y3 u3 M.rho') (TRm.trP G3 M.A' M.R' M.x' y3 u3' M.rho') ;
    res3 : El G3 (IJ.IdT G3 I3 u3 u3') = M.HH.Fin[y3, u3, u3', e3].res ;
    bd : El G3 (EQ.Id2 K IK) = idBack G3 (wkT KI IKw IKw) I3 P3 (wkE KI IKw IKw (q K IK)) (q KI IKw) res3 ;
    -- Id(x , y) over G.A is a proposition
    propIK : El K (PN.isProp K IK) = lam K IK (PS.Pi KI IKw (EQ.Id2 K IK)) (lam KI IKw (EQ.Id2 K IK) bd) ;
  } ;
} ;
