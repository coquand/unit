-- CTotL12h.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part h: the face piece k of level m+1 at an
-- index (J, u, z, c, i): on the sieve [i_k = 0], at a levelwise map
-- (v, e) : (W, y) -> (J, z), level m read through the face k of the
-- restricted chain at the unfaced restricted weight (CTotL12g.phi).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;
module Ar = Arith[a] ;

module L12h (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LG = CTotL12g[a, vl, l].L12g[C, G, A] ;
 module LB = CTotL12b[a, vl, l].L12b[C, G, A] ;
 module LA = LG.LA ;
 module CL = LG.CL ;
 module TR = LA.TR ;
 module G0 = TR.G0 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LB.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;

 module Fh (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FG = LG.Fg[X, gm, s] ;
  module F = FG.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  module FP (m : Nat) (p : F.Up m) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn (suc m) J)
    (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) {
   module PH = FG.Ph[m, p, k] ;
   Y : Ob0 = (J, z) ;
   gp : W0.Ix (G.ob J z) = F.gpt (suc m) J u z c i ;
   kF : Ar.Fin (suc (suc m)) = (k, hk) ;
   Q : PB.Phi J = PB.pre J PFO.ivO (i.1 kF) (PFO.ptSO PB.e0) ;
   ih (W1 : Ob) (v : Hom W1 J) : Wt.Pn (suc m) W1 = Wt.Res[suc m, W1, J, v, i].res ;
   zh (W1 : Ob) (v : Hom W1 J) (lh : PB.Lands W1 J Q v) : PB.Lands W1 PFO.ivO (PFO.ptSO PB.e0) ((ih W1 v).1 kF) =
    PB.lands-pre W1 J PFO.ivO (i.1 kF) (PFO.ptSO PB.e0) v lh ;
   pw (W1 : Ob) (v : Hom W1 J) (lh : PB.Lands W1 J Q v) : Wt.Pn m W1 = Wt.Unface[m, W1, k, hk, ih W1 v, zh W1 v lh].p' ;
   -- the face of the unfaced weight is the weight
   wpU (W1 : Ob) (v : Hom W1 J) (lh : PB.Lands W1 J Q v) : Id (Wt.Pn (suc m) W1) (Wt.Face[m, W1, k, hk].Of[pw W1 v lh].face) (ih W1 v) =
    Sigma-eq (Wt.Coords (suc m) W1) (\ cs -> PB.Lands W1 W1 (Wt.oneS (suc m) W1 cs) (PB.idH W1))
     (Wt.Face[m, W1, k, hk].Of[pw W1 v lh].face).1 (ih W1 v).1 (Wt.Face[m, W1, k, hk].Of[pw W1 v lh].face).2 (ih W1 v).2
     (funext (Ar.Fin (suc (suc m))) (\ j -> Hom W1 PFO.ivO) (Wt.Face[m, W1, k, hk].Of[pw W1 v lh].face).1 (ih W1 v).1
        (\ j -> Wt.Unface[m, W1, k, hk, ih W1 v, zh W1 v lh].face-eq j))
     (PB.isProp-Lands W1 W1 (Wt.oneS (suc m) W1 (ih W1 v).1) (PB.idH W1)) ;
   c1 (W1 : Ob) (v : Hom W1 J) : CT.Ch W1 (suc m) (C.res W1 I (compH W1 J I u v) x) (C.res W1 J v z) = DO.rCh W1 J I v u x (suc m) z c ;
   chT (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) : CT.Ch W1 (suc m) (C.res W1 I (compH W1 J I u v) x) y =
    subst (Obj W1) (\ t -> CT.Ch W1 (suc m) (C.res W1 I (compH W1 J I u v) x) t) (C.res W1 J v z) y e (c1 W1 v) ;
   vg (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) (lh : PB.Lands W1 J Q v) : DA.Ez W1 y =
    PH.phi W1 (compH W1 J I u v) y (chT W1 v y e) (pw W1 v lh) ;
   pv : Py.PvTy Y Q = \ W h lh -> vg W.1 h.1 W.2 (symH h.2) lh ;
   -- its point
   module PT (W1 : Ob) (v : Hom W1 J) (lh : PB.Lands W1 J Q v) {
    uv : Hom W1 I = compH W1 J I u v ;
    rz : Obj W1 = C.res W1 J v z ;
    module UD = LA.L1.UD[I, x, gm, m, W1, uv, rz, c1 W1 v, pw W1 v lh] ;
    base : Id (W0.Ix (G.ob W1 rz)) (vg W1 v rz (refl rz) lh).1 (G.act W1 J v rz z (C.cart W1 J v z) gp) =
     transH (symH (UD.uf k hk))
      (transH (apH {Wt.Pn (suc m) W1} {W0.Ix (G.ob W1 rz)} (\ q -> gm.1 (suc m, W1, uv, rz, c1 W1 v, q.1) q.2) (wpU W1 v lh))
        (symH (gm.2.1 ((suc m, J, u, z, c, i.1), (W1, v)) i.2))) ;
    gen (y : Obj W1) (e : Id (Obj W1) rz y)
     : Id (W0.Ix (G.ob W1 y)) (vg W1 v y e lh).1 (G.act W1 J v y z (VT.trD W1 J v rz y e z (C.cart W1 J v z)) gp) =
     idJ (Obj W1) rz (\ y2 e2 -> Id (W0.Ix (G.ob W1 y2)) (vg W1 v y2 e2 lh).1 (G.act W1 J v y2 z (VT.trD W1 J v rz y2 e2 z (C.cart W1 J v z)) gp))
      base y e ;
   } ;
   ppt : Py.PptTy Y gp Q pv = \ W h lh -> PT[W.1, h.1, lh].gen W.2 (symH h.2) ;
   -- naturality along the levelwise maps
   module NG (W1 : Ob) (v : Hom W1 J) (lh : PB.Lands W1 J Q v) (W2 : Ob) (w : Hom W2 W1) (lh' : PB.Lands W2 J Q (compH W2 W1 J v w)) {
    rz : Obj W1 = C.res W1 J v z ;
    T0 : Obj W2 = C.res W2 W1 w rz ;
    vw : Hom W2 J = compH W2 W1 J v w ;
    uv : Hom W1 I = compH W1 J I u v ;
    module N = PH.PN[W1, uv, rz, c1 W1 v, pw W1 v lh, W2, w] ;
    module R2 = CL.RC2[W2, W1, J, I, w, v, u, x, suc m, z, c] ;
    SP (eT : Id (Obj W2) (C.res W2 J vw z) T0)
     : Id (D.S I x (suc m) W2 T0) (compH W2 W1 I uv w, DO.rCh W2 W1 I w uv x (suc m) rz (c1 W1 v)) (compH W2 J I u vw, chT W2 vw T0 eT) =
     D.sEq I x (suc m) W2 T0 (compH W2 W1 I uv w) (compH W2 J I u vw) (comp-assoc W2 W1 J I u v w)
      (DO.rCh W2 W1 I w uv x (suc m) rz (c1 W1 v)) (chT W2 vw T0 eT)
      (transH R2.law
         (apH {Id (Obj W2) (C.res W2 J vw z) T0} {CT.Ch W2 (suc m) (C.res W2 I (compH W2 J I u vw) x) T0} (\ e -> chT W2 vw T0 e)
            (CT.setObj W2 (C.res W2 J vw z) T0 R2.et eT))) ;
    wP : Id (Wt.Pn m W2) (Wt.Res[m, W2, W1, w, pw W1 v lh].res) (pw W2 vw lh') =
     Sigma-eq (Wt.Coords m W2) (\ cs -> PB.Lands W2 W2 (Wt.oneS m W2 cs) (PB.idH W2))
      (Wt.Res[m, W2, W1, w, pw W1 v lh].res).1 (pw W2 vw lh').1
      (Wt.Res[m, W2, W1, w, pw W1 v lh].res).2 (pw W2 vw lh').2
      (funext (Ar.Fin (suc m)) (\ j -> Hom W2 PFO.ivO) (Wt.Res[m, W2, W1, w, pw W1 v lh].res).1 (pw W2 vw lh').1
         (\ j -> PB.comp-assoc W2 W1 J PFO.ivO (i.1 (Wt.Face[m, W1, k, hk].skipF j)) v w))
      (PB.isProp-Lands W2 W2 (Wt.oneS m W2 (pw W2 vw lh').1) (PB.idH W2)) ;
    base (eT : Id (Obj W2) (C.res W2 J vw z) T0)
     : Id (DA.Ez W2 T0) (DA.E.act (W2, T0) (W1, rz) (w, C.cart W2 W1 w rz) (vg W1 v rz (refl rz) lh)) (vg W2 vw T0 eT lh') =
     transH N.law
      (transH (apH {D.S I x (suc m) W2 T0} {DA.Ez W2 T0} (\ sw -> PH.phi W2 sw.1 T0 sw.2 (Wt.Res[m, W2, W1, w, pw W1 v lh].res)) (SP eT))
        (apH {Wt.Pn m W2} {DA.Ez W2 T0} (\ q -> PH.phi W2 (compH W2 J I u vw) T0 (chT W2 vw T0 eT) q) wP)) ;
    natg (y : Obj W1) (e : Id (Obj W1) rz y) (y2 : Obj W2) (e2 : Id (Obj W2) (C.res W2 W1 w y) y2) (eT : Id (Obj W2) (C.res W2 J vw z) y2)
     : Id (DA.Ez W2 y2) (DA.E.act (W2, y2) (W1, y) (w, VT.trD W2 W1 w (C.res W2 W1 w y) y2 e2 y (C.cart W2 W1 w y)) (vg W1 v y e lh))
         (vg W2 vw y2 eT lh') =
     idJ (Obj W1) rz
      (\ y' e' -> (y3 : Obj W2) (e3 : Id (Obj W2) (C.res W2 W1 w y') y3) (eT3 : Id (Obj W2) (C.res W2 J vw z) y3)
         -> Id (DA.Ez W2 y3) (DA.E.act (W2, y3) (W1, y') (w, VT.trD W2 W1 w (C.res W2 W1 w y') y3 e3 y' (C.cart W2 W1 w y')) (vg W1 v y' e' lh))
              (vg W2 vw y3 eT3 lh'))
      (\ y3 e3 -> idJ (Obj W2) T0
         (\ y4 e4 -> (eT4 : Id (Obj W2) (C.res W2 J vw z) y4)
            -> Id (DA.Ez W2 y4) (DA.E.act (W2, y4) (W1, rz) (w, VT.trD W2 W1 w T0 y4 e4 rz (C.cart W2 W1 w rz)) (vg W1 v rz (refl rz) lh))
                 (vg W2 vw y4 eT4 lh'))
         base y3 e3)
      y e y2 e2 eT ;
   } ;
   pnat : Py.PnTy Y Q pv = \ W' W chi h lh lh' ->
    NG[W.1, h.1, lh, W'.1, chi.1, lh'].natg W.2 (symH h.2) W'.2 (symH chi.2) (symH (G0.GB.BC.oC W' W Y h chi).2) ;
   side : Py.Side[Y, gp] = Py.mkSide Y gp Q pv ppt pnat ;
  } ;
 } ;
} ;
