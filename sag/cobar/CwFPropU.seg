-- CwFPropU.seg (canonicity-c2; SIMPLIFIED.md item 2c): the universe of
-- propositions of a CwF with Pi, Sigma, Swan Id and a universe, and the
-- statement of propositional extensionality.
--
--   isProp G A   = Pi (x : A) Pi (y : A) Id(x , y)
--   PropU G      = Sigma (c : Cod) isProp (Dec c)
--   propPath, isProp-ov, wkProp   elements of a proposition are joined;
--                isProp is stable under substitution
--   PropExtTy    two codes of propositions with maps both ways between
--                their decodings are joined by an element of Id in Cod.
-- PropExtTy is a HYPOTHESIS of the files that use it (a module parameter,
-- ruling 4e 2026-11-11): it follows from the universe's univalence
-- UaContr (CwFUaEq), whose base instance is the S4 assembly.
open Base ;

module PropU (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module UU = CwFU.UnivUa[l, C, PS, SS, IJ, Un] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;

  isProp (G : Ctx) (A : Ty G) : Ty G = PS.Pi G A (PS.Pi (ext G A) (wkT G A A) (EQ.Id2 G A)) ;

  -- two elements of a proposition are joined
  propPath (G : Ctx) (A : Ty G) (pa : El G (isProp G A)) (x y : El G A) : El G (IJ.IdT G A x y) =
    trE G (subT G (ext G A) (JP.IK G A x) (sec G A y)) (IJ.IdT G A x y) (JP.IKpt G A x y)
      (IN.appD G A (JP.IK G A x)
         (trE G (subT G (ext G A) (SG.CP G A) (sec G A x)) (PS.Pi G A (JP.IK G A x)) (SG.PCP G A x)
            (IN.appD G A (SG.CP G A) pa x))
         y) ;

  -- isProp is stable under substitution, in particular weakening
  isProp-ov (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    : Id (Ty D) (subT D G (isProp G A) s) (isProp D A') =
    Pi-ov D G A (PS.Pi K Ap (EQ.Id2 G A)) s A' PA (PS.Pi K' Ap' (EQ.Id2 D A'))
      (Pi-ov K' K Ap (EQ.Id2 G A) s1 Ap' PAp (EQ.Id2 D A')
         (Id-ov (ext K' Ap') (ext K Ap) App (wkE K Ap Ap (q G A)) (q K Ap) s2 App' PApp
            (wkE K' Ap' Ap' (q D A')) (q K' Ap')
            (wkE-ov K' K Ap Ap (q G A) s1 Ap' PAp Ap' PAp (q D A') (q-ov D G A s A' PA PAp) PApp)
            (q-ov K' K Ap s1 Ap' PAp PApp)))
   where {
    K : Ctx = ext G A ;
    K' : Ctx = ext D A' ;
    Ap : Ty K = wkT G A A ;
    Ap' : Ty K' = wkT D A' A' ;
    App : Ty (ext K Ap) = wkT K Ap Ap ;
    App' : Ty (ext K' Ap') = wkT K' Ap' Ap' ;
    s1 : Sub K' K = upT D G A s A' PA ;
    PAp : Id (Ty K') (subT K' K Ap s1) Ap' = wkT-ov D G A A s A' PA A' PA ;
    s2 : Sub (ext K' Ap') (ext K Ap) = upT K' K Ap s1 Ap' PAp ;
    PApp : Id (Ty (ext K' Ap')) (subT (ext K' Ap') (ext K Ap) App s2) App' = wkT-ov K' K Ap Ap s1 Ap' PAp Ap' PAp ;
   } ;
  wkProp (G : Ctx) (Z A : Ty G) (pa : El G (isProp G A)) : El (ext G Z) (isProp (ext G Z) (wkT G Z A)) =
    trE (ext G Z) (wkT G Z (isProp G A)) (isProp (ext G Z) (wkT G Z A))
      (isProp-ov (ext G Z) G A (p G Z) (wkT G Z A) (refl (wkT G Z A)))
      (wkE G Z (isProp G A) pa) ;


  -- over G.Cod: the last variable decodes to a proposition
  PropFam (G : Ctx) : Ty (ext G (Un.Cod G)) = isProp (ext G (Un.Cod G)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G)) ;
  PropU (G : Ctx) : Ty G = SS.Sig G (Un.Cod G) (PropFam G) ;

  -- the last variable of G.Cod at a code c is c
  qc-pt (G : Ctx) (b : El G (Un.Cod G))
    : Ov G (ext G (Un.Cod G)) (Un.Cod (ext G (Un.Cod G))) (sec G (Un.Cod G) b) (Un.Cod G)
         (Un.Cod-nat G (ext G (Un.Cod G)) (sec G (Un.Cod G) b)) (UU.qc G) b =
    ovTr G (ext G (Un.Cod G)) (wkT G (Un.Cod G) (Un.Cod G)) (Un.Cod (ext G (Un.Cod G)))
      (Un.Cod-nat (ext G (Un.Cod G)) G (p G (Un.Cod G))) (sec G (Un.Cod G) b) (Un.Cod G) (Un.Cod G) (refl (Un.Cod G))
      (p-sec-T G (Un.Cod G) (Un.Cod G) b) (Un.Cod-nat G (ext G (Un.Cod G)) (sec G (Un.Cod G) b))
      (q G (Un.Cod G)) b (IN.q-secO G (Un.Cod G) b (p-sec-T G (Un.Cod G) (Un.Cod G) b)) ;
  DecQ-pt (G : Ctx) (c : El G (Un.Cod G))
    : Id (Ty G) (subT G (ext G (Un.Cod G)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G)) (sec G (Un.Cod G) c)) (Un.Dec G c) =
    trans (Ty G) (subT G (ext G (Un.Cod G)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G)) (sec G (Un.Cod G) c))
                 (Un.Dec G (UU.DU.subU G (ext G (Un.Cod G)) (UU.qc G) (sec G (Un.Cod G) c))) (Un.Dec G c)
      (Un.Dec-nat G (ext G (Un.Cod G)) (UU.qc G) (sec G (Un.Cod G) c))
      (ap (El G (Un.Cod G)) (Ty G) (\ c2 -> Un.Dec G c2) (UU.DU.subU G (ext G (Un.Cod G)) (UU.qc G) (sec G (Un.Cod G) c)) c (qc-pt G c)) ;
  PropFam-pt (G : Ctx) (c : El G (Un.Cod G))
    : Id (Ty G) (subT G (ext G (Un.Cod G)) (PropFam G) (sec G (Un.Cod G) c)) (isProp G (Un.Dec G c)) =
    isProp-ov G (ext G (Un.Cod G)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G)) (sec G (Un.Cod G) c) (Un.Dec G c) (DecQ-pt G c) ;

  -- PropU is stable under substitution
  DecQ-ov (D G : Ctx) (s : Sub D G)
    : Id (Ty (ext D (Un.Cod D)))
         (subT (ext D (Un.Cod D)) (ext G (Un.Cod G)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G)) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s)))
         (Un.Dec (ext D (Un.Cod D)) (UU.qc D)) =
    trans (Ty (ext D (Un.Cod D)))
      (subT (ext D (Un.Cod D)) (ext G (Un.Cod G)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G)) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s)))
      (Un.Dec (ext D (Un.Cod D)) (UU.DU.subU (ext D (Un.Cod D)) (ext G (Un.Cod G)) (UU.qc G) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s))))
      (Un.Dec (ext D (Un.Cod D)) (UU.qc D))
      (Un.Dec-nat (ext D (Un.Cod D)) (ext G (Un.Cod G)) (UU.qc G) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s)))
      (ap (El (ext D (Un.Cod D)) (Un.Cod (ext D (Un.Cod D)))) (Ty (ext D (Un.Cod D))) (\ c2 -> Un.Dec (ext D (Un.Cod D)) c2)
         (UU.DU.subU (ext D (Un.Cod D)) (ext G (Un.Cod G)) (UU.qc G) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s))) (UU.qc D)
         (UU.qc-ov D G s)) ;
  PropFam-ov (D G : Ctx) (s : Sub D G)
    : Id (Ty (ext D (Un.Cod D)))
         (subT (ext D (Un.Cod D)) (ext G (Un.Cod G)) (PropFam G) (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s)))
         (PropFam D) =
    isProp-ov (ext D (Un.Cod D)) (ext G (Un.Cod G)) (Un.Dec (ext G (Un.Cod G)) (UU.qc G))
      (upT D G (Un.Cod G) s (Un.Cod D) (Un.Cod-nat D G s)) (Un.Dec (ext D (Un.Cod D)) (UU.qc D)) (DecQ-ov D G s) ;
  PropU-ov (D G : Ctx) (s : Sub D G) : Id (Ty D) (subT D G (PropU G) s) (PropU D) =
    Sig-ov D G (Un.Cod G) (PropFam G) s (Un.Cod D) (Un.Cod-nat D G s) (PropFam D) (PropFam-ov D G s) ;

  -- an element of PropU: its code, its decoding, a proposition; and back
  codeOf (G : Ctx) (w : El G (PropU G)) : El G (Un.Cod G) = IN.fst G (Un.Cod G) (PropFam G) w ;
  DecP (G : Ctx) (w : El G (PropU G)) : Ty G = Un.Dec G (codeOf G w) ;
  decProp (G : Ctx) (w : El G (PropU G)) : El G (isProp G (DecP G w)) =
    trE G (subT G (ext G (Un.Cod G)) (PropFam G) (sec G (Un.Cod G) (codeOf G w))) (isProp G (DecP G w))
      (PropFam-pt G (codeOf G w)) (IN.snd G (Un.Cod G) (PropFam G) w) ;
  mkProp (G : Ctx) (c : El G (Un.Cod G)) (pc : El G (isProp G (Un.Dec G c))) : El G (PropU G) =
    IN.pr G (Un.Cod G) (PropFam G) c
      (trE G (isProp G (Un.Dec G c)) (subT G (ext G (Un.Cod G)) (PropFam G) (sec G (Un.Cod G) c))
         (sym (Ty G) (subT G (ext G (Un.Cod G)) (PropFam G) (sec G (Un.Cod G) c)) (isProp G (Un.Dec G c)) (PropFam-pt G c)) pc) ;

  PropExtTy : U l =
    (G : Ctx) (a b : El G (Un.Cod G)) (pa : El G (isProp G (Un.Dec G a))) (pb : El G (isProp G (Un.Dec G b)))
    (f : El (ext G (Un.Dec G a)) (wkT G (Un.Dec G a) (Un.Dec G b)))
    (g : El (ext G (Un.Dec G b)) (wkT G (Un.Dec G b) (Un.Dec G a)))
    -> El G (IJ.IdT G (Un.Cod G) a b) ;
} ;
