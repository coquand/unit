-- CHomT3.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras.  For presentations s, t (with c2's eliminator
-- package, QE1-QE5):
--   DR        the constant type of the ring's elements (CConst at a+)
--   cst x     the constants r |-> cls (cst r) as an element over nil.DR
--             (semantic; naturality by the class's)
--   HomT      Sigma (h : Fun Q_s Q_t) (data for +) x (data for *) x
--             (data for the constants), CHomT1 / CHomT2's data types
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

module HomP (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 Nl : C.Ctx = C.nil ;
 RV : V[a].V = EN.codeOf R.R encK ;
 DRV : V1.V = Encode[a, a+].codeOf R.R (Encode[a, a+].encIx0 RV) ;
 DR : C.Ty Nl = CConst[a, a+].ConstOf[CCyl[a].PosCyl.posCyl, DRV].constS Nl ;
 GP : C.Ctx = C.ext Nl DR ;
 module Alg (x : SX.Over[R].Presentation) {
  module AX = CAlgX[a].AlgX[R, encK, x, pe] ;
  module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
  module Q3 = CwFQuotElim3[a].QE3[R, encK, x, pe] ;
  module O = AX.Ops[Q1.setQ, Q1.setQi, Q3.elim2, Q3.elim2-beta] ;
  Qt : C.Ty Nl = AX.Qt ;
  QP : C.Ty GP = OV.wkT Nl DR Qt ;
  eobC (K : Ob) (w : V1.Ix (GP.ob K)) : V1.Ix (QP.1.tob K w) = (AX.cls (cst w.2)).eob K w.1 ;
  enatC (J I : Ob) (f : Hom J I) (w : V1.Ix (GP.ob I)) (y : V1.Ix (GP.ob J)) (e : Id (V1.Ix (GP.ob J)) (GP.act J I f w) y)
   : Id (V1.Ix (QP.1.tob J y)) (QP.1.tact J I f w y e (eobC I w)) (eobC J y) =
   idJ (V1.Ix (GP.ob J)) (GP.act J I f w) (\ y2 e2 -> Id (V1.Ix (QP.1.tob J y2)) (QP.1.tact J I f w y2 e2 (eobC I w)) (eobC J y2))
    (transH (L.tact-irr Nl Qt.1 J I f w.1 w.1 (L.ntEq GP Nl (C.p Nl DR) J I f w (GP.act J I f w) (refl (GP.act J I f w))) (refl w.1) (eobC I w))
       ((AX.cls (cst w.2)).enat J I f w.1 w.1 (refl w.1)))
    y e ;
  cstE : C.El GP QP = new L.PEl[GP, QP.1, eobC, enatC] ;
 } ;
 module Hom (s t : SX.Over[R].Presentation) {
  module AS = Alg[s] ;
  module AT = Alg[t] ;
  module B0 = CHomT1[a].BaseOf[AS.Qt, AT.Qt] ;
  module BA = B0.BinOf[AS.O.addQ, AT.O.addQ] ;
  module BM = B0.BinOf[AS.O.mulQ, AT.O.mulQ] ;
  module CS = CHomT2[a].CstOf[AS.Qt, AT.Qt, DR, AS.cstE, AT.cstE] ;
  MapT : C.Ty Nl = B0.MapT ;
  Gh : C.Ctx = B0.Gh ;
  DataT : C.Ty Gh = SS.Sig Gh BA.DataBin (OV.wkT Gh BA.DataBin (SS.Sig Gh BM.DataBin (OV.wkT Gh BM.DataBin CS.DataCst))) ;
  HomT : C.Ty Nl = SS.Sig Nl MapT DataT ;
 } ;
} ;
