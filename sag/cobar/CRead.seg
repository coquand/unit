-- CRead.seg (canonicity-45; COBAR.md "comparison"): the readings of E1's
-- operations and constants on codes F1 -> y' (CE1Copy.Fin's rdA / rdM /
-- kR).  Codes go to HomT(F1, y') by alpha (natural here), and two maps into
-- HomT agree up to homotopy as soon as their evaluations at the generator
-- do (CHtInj, with c2's round trips eta / eps as parameters until they land).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;

module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;

module RD (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module PH = CPhi[a].Phi[R, encK, pe, y'] ;
 module HO = PH.HO ;
 Nl : L.PCtx = PH.Nl ;
 HT : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = PH.HT ;
 Ac : L.PTy[Nl] = PH.Ac ;
 module E1v = CEv1[a].E1[R, encK, pe, y'] ;
 Qc : L.PTy[Nl] = E1v.QY.1 ;
 evN : HO.NMap[Nl, HT.1, Qc] = E1v.nm ;
 cH : PB.CLine[a+].Lines[Nl, HT.1].CompK[PB.e0, PB.e1].Comp = HT.2.1 ;
 cQ : PB.CLine[a+].Lines[Nl, Qc].CompK[PB.e0, PB.e1].Comp = E1v.QY.2.1 ;
 -- alpha as a natural map codes -> HomT (by cases on the terminal point)
 at (I : Ob) : (o : Top) -> V1.Ix (Ac.tob I o) -> V1.Ix (HT.1.tob I o) = split { tt -> \ m -> PH.FM.alpha I m } ;
 anat (J I : Ob) (h : Hom J I) : (x : Top) (x' : Top) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h x) x') (m : V1.Ix (Ac.tob I x))
  -> Id (V1.Ix (HT.1.tob J x')) (HT.1.tact J I h x x' e (at I x m)) (at J x' (Ac.tact J I h x x' e m)) = split {
  tt -> split { tt -> \ e m -> transH (L.tact-irr Nl HT.1 J I h tt tt e (refl tt) (PH.FM.alpha I m))
    (transH (symH (PH.NN.aNat I J h m)) (apH {PH.FF.M J} {V1.Ix (HT.1.tob J tt)} (PH.FM.alpha J) (symH (PH.resE J I h m)))) } } ;
 alphaN : HO.NMap[Nl, Ac, HT.1] = new HO.NMap[Nl, Ac, HT.1, at, \ J I h x x' e m -> anat J I h x x' e m] ;
 -- beta . alpha = id on codes, at any terminal point
 ba (I : Ob) : (o : Top) (m : V1.Ix (Ac.tob I o)) -> Id (V1.Ix (Ac.tob I o)) m (PH.bt I o (at I o m)) = split {
  tt -> \ m -> symH (CHomT12[a].RT1[R, encK, pe, PH.F1, y'].At[I, m].rt) } ;
 -- two maps into codes agree when their evaluations at the generator do (given eta)
 module Agree (eta : L.PEl[L.extP Nl HT.1, HO.HT[Nl, HT.1, HT.1, HO.compN Nl HT.1 Qc HT.1 evN PH.invN, HO.idN Nl HT.1].PT.PathP])
   (X : L.PTy[Nl]) (u v : HO.NMap[Nl, X, Ac])
   (h : L.PEl[L.extP Nl X, HO.HT[Nl, X, Qc, HO.compN Nl X HT.1 Qc (HO.compN Nl X Ac HT.1 u alphaN) evN, HO.compN Nl X HT.1 Qc (HO.compN Nl X Ac HT.1 v alphaN) evN].PT.PathP]) {
  module HJ = CHtInj[a].HI[Nl, HT.1, Qc, evN, PH.invN, cH, eta].At[X, HO.compN Nl X Ac HT.1 u alphaN, HO.compN Nl X Ac HT.1 v alphaN, h] ;
  module WB = HO.WL[Nl, X, HT.1, Ac, HO.compN Nl X Ac HT.1 u alphaN, HO.compN Nl X Ac HT.1 v alphaN, PH.betaN, HJ.res] ;
  module RB = HO.Ret[Nl, X, Ac, HO.compN Nl X HT.1 Ac (HO.compN Nl X Ac HT.1 u alphaN) PH.betaN, HO.compN Nl X HT.1 Ac (HO.compN Nl X Ac HT.1 v alphaN) PH.betaN, u, v,
     \ I x a0 -> ba I x (u.nfun I x a0), \ I x a0 -> ba I x (v.nfun I x a0), WB.res] ;
  res : L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, u, v].PT.PathP] = RB.res ;
 } ;
 -- the constants: ev (alpha k_r) = cls (cst r)
 module K4 (r : R.R) { module K = CCst4[a].C4[R, encK, pe, CUF0[a].cF0 R encK pe, y', r] ; } ;
 cA (r : R.R) (I : Ob) (o : V1.Ix (Nl.ob I)) : V1.Ix (Qc.tob I o) = (PH.HP.Alg[y'].AX.cls (cst r)).eob I o ;
 module KK (r : R.R) {
  module K = K4[r].K ;
  module SCk = K.KR.SC ;
  module SCn = K.SCan ;
  Qy : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = E1v.QY ;
  inner : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil SCk.SM.AT.Qt = OV.app FibCwF[a, a+].fibCwF.nil SCk.SM.AS.Qt SCk.SM.AT.Qt SCk.SM.Phi E1v.cx ;
  outer : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil Qy = OV.app FibCwF[a, a+].fibCwF.nil SCn.SM.AS.Qt Qy SCn.SM.Phi inner ;
  Pk : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (OV.Fun FibCwF[a, a+].fibCwF.nil SCk.SM.AS.Qt SCk.SM.AT.Qt) = SCk.SM.Phi ;
  Pn : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (OV.Fun FibCwF[a, a+].fibCwF.nil SCn.SM.AS.Qt Qy) = SCn.SM.Phi ;
  ev0 (I : Ob) : V1.Ix (Qc.tob I tt) = (Pn.eob I tt).1 I (idH I) ((Pk.eob I tt).1 I (compH I I I (idH I) (idH I)) (E1v.cx.eob I tt)) ;
  evk0 (I : Ob) : Id (V1.Ix (Qc.tob I tt)) (evN.nfun I tt (at I tt (K.kc I))) (ev0 I) = refl (ev0 I) ;
  evk (I : Ob) : Id (V1.Ix (Qc.tob I tt)) (evN.nfun I tt (at I tt (K.kc I))) (outer.eob I tt) =
   transH (apH {Hom I I} {V1.Ix (Qc.tob I tt)} (\ f -> (Pn.eob I tt).1 I (idH I) ((Pk.eob I tt).1 I f (E1v.cx.eob I tt))) (comp-idl I I (idH I)))
    (transH (apH {V1.Ix (SCk.SM.AT.Qt.1.tob I tt)} {V1.Ix (Qc.tob I tt)} (\ v -> (Pn.eob I tt).1 I (idH I) v)
              (symH (CAppRd[a].App0[SCk.SM.AS.Qt, SCk.SM.AT.Qt, Pk, E1v.cx].rd I tt)))
      (symH (CAppRd[a].App0[SCn.SM.AS.Qt, Qy, Pn, inner].rd I tt))) ;
  -- the internal Id: Phi_can (Phi_k (cls x)) = cls (cst r)
  mid : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil SCk.SM.AT.Qt = SCk.SM.AT.cls (SCk.SM.SB.sbT (var (inr tt))) ;
  b1 : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (FibId[a, a+].fibId.IdT FibCwF[a, a+].fibCwF.nil SCk.SM.AT.Qt inner mid) = SCk.SM.beta (var (inr tt)) ;
  a1 : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (FibId[a, a+].fibId.IdT FibCwF[a, a+].fibCwF.nil Qy outer (OV.app FibCwF[a, a+].fibCwF.nil SCn.SM.AS.Qt Qy Pn mid)) =
   PT.apM FibCwF[a, a+].fibCwF.nil SCn.SM.AS.Qt Qy (OV.bod FibCwF[a, a+].fibCwF.nil SCn.SM.AS.Qt (OV.wkT FibCwF[a, a+].fibCwF.nil SCn.SM.AS.Qt Qy) Pn) inner mid b1 ;
  b2 : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (FibId[a, a+].fibId.IdT FibCwF[a, a+].fibCwF.nil Qy (OV.app FibCwF[a, a+].fibCwF.nil SCn.SM.AS.Qt Qy Pn mid) (SCn.SM.AT.cls (cst r))) =
   SCn.SM.beta (cst r) ;
  eK : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (FibId[a, a+].fibId.IdT FibCwF[a, a+].fibCwF.nil Qy outer (SCn.SM.AT.cls (cst r))) =
   PT.transM FibCwF[a, a+].fibCwF.nil Qy outer (OV.app FibCwF[a, a+].fibCwF.nil SCn.SM.AS.Qt Qy Pn mid) (SCn.SM.AT.cls (cst r)) a1 b2 ;
 } ;
 -- alpha . beta = id on HomT, at any terminal point
 ab (I : Ob) : (o : Top) (z : V1.Ix (HT.1.tob I o)) -> Id (V1.Ix (HT.1.tob I o)) (at I o (PH.bt I o z)) z = split {
  tt -> \ z -> CHomT13[a].RT2[R, encK, pe, PH.F1, y'].At[I, z].rt } ;
 -- the reading of the constants, given c2's round trips eta (on HomT) and eps (on Q_y')
 module Trips (eta : L.PEl[L.extP Nl HT.1, HO.HT[Nl, HT.1, HT.1, HO.compN Nl HT.1 Qc HT.1 evN PH.invN, HO.idN Nl HT.1].PT.PathP])
   (eps : L.PEl[L.extP Nl Qc, HO.HT[Nl, Qc, Qc, HO.compN Nl Qc HT.1 Qc PH.invN evN, HO.idN Nl Qc].PT.PathP]) {
  module KRd (r : R.R) (X : L.PTy[Nl]) {
   module KQ = KK[r] ;
   cE : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil KQ.Qy = KQ.SCn.SM.AT.cls (cst r) ;
   u : HO.NMap[Nl, X, Ac] = new HO.NMap[Nl, X, Ac, \ I o w -> KQ.K.kc I, \ J I f x y e w -> KQ.K.kcN J I f] ;
   cQN : HO.NMap[Nl, X, Qc] = new HO.NMap[Nl, X, Qc, \ I o w -> cE.eob I o, \ J I f x y e w -> cE.enat J I f x y e] ;
   v : HO.NMap[Nl, X, Ac] = HO.compN Nl X Qc Ac cQN PH.phi ;
   ul : HO.NMap[Nl, X, Qc] = HO.compN Nl X HT.1 Qc (HO.compN Nl X Ac HT.1 u alphaN) evN ;
   vl : HO.NMap[Nl, X, Qc] = HO.compN Nl X HT.1 Qc (HO.compN Nl X Ac HT.1 v alphaN) evN ;
   module CR = CClRd[a, a+].ClRd[Nl, KQ.Qy, KQ.outer, cE, KQ.eK, X] ;
   pa1 (I : Ob) : (x : Top) (w : V1.Ix (X.tob I x)) -> Id (V1.Ix (Qc.tob I x)) (ul.nfun I x w) (CR.cA.nfun I x w) = split {
    tt -> \ w -> KQ.evk I } ;
   module R1 = HO.Ret[Nl, X, Qc, CR.cA, CR.cB, ul, cQN, pa1, \ I x w -> refl (cE.eob I x), CR.res] ;
   module W2 = HO.WR[Nl, Qc, Qc, X, HO.compN Nl Qc HT.1 Qc PH.invN evN, HO.idN Nl Qc, cQN, eps] ;
   module I2 = HO.Inv[Nl, X, Qc, HO.compN Nl X Qc Qc cQN (HO.compN Nl Qc HT.1 Qc PH.invN evN), HO.compN Nl X Qc Qc cQN (HO.idN Nl Qc), cQ, W2.res] ;
   pb2 (I : Ob) : (x : Top) (w : V1.Ix (X.tob I x)) -> Id (V1.Ix (Qc.tob I x)) (vl.nfun I x w) (evN.nfun I x (PH.invN.nfun I x (cE.eob I x))) = split {
    tt -> \ w -> apH {V1.Ix (HT.1.tob I tt)} {V1.Ix (Qc.tob I tt)} (evN.nfun I tt) (ab I tt (PH.invN.nfun I tt (cE.eob I tt))) } ;
   module R2 = HO.Ret[Nl, X, Qc, HO.compN Nl X Qc Qc cQN (HO.idN Nl Qc), HO.compN Nl X Qc Qc cQN (HO.compN Nl Qc HT.1 Qc PH.invN evN), cQN, vl,
      \ I x w -> refl (cE.eob I x), pb2, I2.res] ;
   module C3 = HO.Cat[Nl, X, Qc, ul, cQN, vl, cQ, R1.res, R2.res] ;
   module AG = Agree[eta, X, u, v, C3.res] ;
   res : L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, u, v].PT.PathP] = AG.res ;
  } ;
 } ;
} ;
