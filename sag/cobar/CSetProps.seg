-- CSetProps.seg (canonicity-c2; for (K) and (d)): propositions in the
-- poset fibrant CwF.
--   idPropC   an Id type in a closed set Q pulled back to any context is a
--             proposition (Q's SetQiTy along the semantic pair (a , b))
--   moveIsProp  isProp of an Id type moves along a type path with the
--             matching transports of the end points
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;

module PN = CwFPropNoU.PropNoU[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibNF[a, a+].nf] ;
moveIsProp (D : C.Ctx) (X X' : C.Ty D) (P : Id (C.Ty D) X X') (x y : C.El D X) (x' y' : C.El D X')
  (ex : Id (C.El D X') (OV.trE D X X' P x) x') (ey : Id (C.El D X') (OV.trE D X X' P y) y')
  (h : C.El D (PU.isProp D (IJ.IdT D X x y))) : C.El D (PU.isProp D (IJ.IdT D X' x' y')) =
 subst (C.El D X') (\ c -> C.El D (PU.isProp D (IJ.IdT D X' x' c))) (OV.trE D X X' P y) y' ey
  (subst (C.El D X') (\ c -> C.El D (PU.isProp D (IJ.IdT D X' c (OV.trE D X X' P y)))) (OV.trE D X X' P x) x' ex
    (idJ (C.Ty D) X (\ Z PZ -> C.El D (PU.isProp D (IJ.IdT D Z (OV.trE D X Z PZ x) (OV.trE D X Z PZ y)))) h X' P)) ;
module IdPropC (Q : C.Ty C.nil) (sQ : CQCtx[a].G3Of[Q].SetQiTy) (D : C.Ctx) (a1 a2 : C.El D (C.subT D C.nil Q (C.eps D))) {
 Nl : C.Ctx = C.nil ;
 module GQ = CQCtx[a].G3Of[Q] ;
 QD : C.Ty D = C.subT D Nl Q (C.eps D) ;
 clT (T : C.Ty Nl) (s1 s2 : C.Sub D Nl) : Id (C.Ty D) (C.subT D Nl T s1) (C.subT D Nl T s2) =
  apH {C.Sub D Nl} {C.Ty D} (\ s -> C.subT D Nl T s) (transH (C.eps-uniq D s1) (symH (C.eps-uniq D s2))) ;
 s1 : C.Sub D GQ.G1 = C.o D (C.ext D QD) GQ.G1 (C.lift D Nl Q (C.eps D)) (C.sec D QD a1) ;
 Qs1 : C.Ty D = C.subT D GQ.G1 GQ.Qw s1 ;
 PQs1 : Id (C.Ty D) Qs1 QD = transH (symH (C.subT-o D GQ.G1 Nl Q (C.p Nl Q) s1)) (clT Q (C.o D GQ.G1 Nl (C.p Nl Q) s1) (C.eps D)) ;
 a2' : C.El D Qs1 = OV.trE D QD Qs1 (symH PQs1) a2 ;
 s2 : C.Sub D GQ.G2 = C.o D (C.ext D Qs1) GQ.G2 (C.lift D GQ.G1 GQ.Qw s1) (C.sec D Qs1 a2') ;
 IQ : C.Ty GQ.G2 = IJ.IdT GQ.G2 GQ.Qw2 GQ.v1 GQ.v2 ;
 Q2s : C.Ty D = C.subT D GQ.G2 GQ.Qw2 s2 ;
 c1 : C.El D Q2s = C.subt D GQ.G2 GQ.Qw2 GQ.v1 s2 ;
 c2 : C.El D Q2s = C.subt D GQ.G2 GQ.Qw2 GQ.v2 s2 ;
 h0 : C.El D (PU.isProp D (IJ.IdT D Q2s c1 c2)) =
  OV.trE D (C.subT D GQ.G2 (PU.isProp GQ.G2 IQ) s2) (PU.isProp D (IJ.IdT D Q2s c1 c2))
    (PU.isProp-ov D GQ.G2 IQ s2 (IJ.IdT D Q2s c1 c2) (IJ.IdT-nat D GQ.G2 GQ.Qw2 GQ.v1 GQ.v2 s2))
    (C.subt D GQ.G2 (PU.isProp GQ.G2 IQ) (GQ.setV2 sQ) s2) ;
 pp2 : C.Sub D Nl = C.o D GQ.G2 Nl (C.o GQ.G2 GQ.G1 Nl (C.p Nl Q) (C.p GQ.G1 GQ.Qw)) s2 ;
 PQ2 : Id (C.Ty D) Q2s QD =
  transH (apH {C.Ty GQ.G2} {C.Ty D} (\ T -> C.subT D GQ.G2 T s2) (symH (C.subT-o GQ.G2 GQ.G1 Nl Q (C.p Nl Q) (C.p GQ.G1 GQ.Qw))))
   (transH (symH (C.subT-o D GQ.G2 Nl Q (C.o GQ.G2 GQ.G1 Nl (C.p Nl Q) (C.p GQ.G1 GQ.Qw)) s2)) (clT Q pp2 (C.eps D))) ;
 ex (K : Ob) (w : V1.Ix (D.ob K)) : Id (V1.Ix (QD.1.tob K w)) ((OV.trE D Q2s QD PQ2 c1).eob K w) (a1.eob K w) =
  transH (CAppRd[a].trE-rd D Q2s QD PQ2 c1 K w) (CAppRd[a].same-rd D Q2s QD PQ2 K w (refl (QD.1.tob K w)) (c1.eob K w)) ;
 ey (K : Ob) (w : V1.Ix (D.ob K)) : Id (V1.Ix (QD.1.tob K w)) ((OV.trE D Q2s QD PQ2 c2).eob K w) (a2.eob K w) =
  transH (CAppRd[a].trE-rd D Q2s QD PQ2 c2 K w)
   (transH (CAppRd[a].same-rd D Q2s QD PQ2 K w (refl (QD.1.tob K w)) (c2.eob K w))
     (transH (CAppRd[a].trE-rd D QD Qs1 (symH PQs1) a2 K w) (CAppRd[a].same-rd D QD Qs1 (symH PQs1) K w (refl (QD.1.tob K w)) (a2.eob K w)))) ;
 -- THE Id TYPE IS A PROPOSITION
 idP : C.El D (PU.isProp D (IJ.IdT D QD a1 a2)) =
  moveIsProp D Q2s QD PQ2 c1 c2 a1 a2
    (L.el-ext D QD.1 (OV.trE D Q2s QD PQ2 c1) a1 (\ K w -> ex K w))
    (L.el-ext D QD.1 (OV.trE D Q2s QD PQ2 c2) a2 (\ K w -> ey K w)) h0 ;
} ;
-- a Sigma of propositions is a proposition
module SigProp (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (pA : C.El G (PU.isProp G A)) (pB : C.El (C.ext G A) (PU.isProp (C.ext G A) B)) {
 module IN = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
 module PPr = CwFPropPair.PropPair[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibUniv[a].fibUniv] ;
 module H6 = CwFHed6.Hed6[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibNF[a, a+].nf] ;
 S : C.Ty G = SS.Sig G A B ;
 GS : C.Ctx = C.ext G S ;
 Sw : C.Ty GS = OV.wkT G S S ;
 K : C.Ctx = C.ext GS Sw ;
 pp : C.Sub K G = C.o K GS G (C.p G S) (C.p GS Sw) ;
 Ak : C.Ty K = C.subT K G A pp ;
 Bk : C.Ty (C.ext K Ak) = C.subT (C.ext K Ak) (C.ext G A) B (C.lift K G A pp) ;
 Sk : C.Ty K = SS.Sig K Ak Bk ;
 TPs : Id (C.Ty K) (OV.wkT GS Sw Sw) Sk = transH (symH (C.subT-o K GS G S (C.p G S) (C.p GS Sw))) (SS.Sig-nat K G A B pp) ;
 u1 : C.El K (OV.wkT GS Sw Sw) = OV.wkE GS Sw Sw (C.q G S) ;
 u2 : C.El K (OV.wkT GS Sw Sw) = C.q GS Sw ;
 w1 : C.El K Sk = OV.trE K (OV.wkT GS Sw Sw) Sk TPs u1 ;
 w2 : C.El K Sk = OV.trE K (OV.wkT GS Sw Sw) Sk TPs u2 ;
 pAk : C.El K (PU.isProp K Ak) =
  OV.trE K (C.subT K G (PU.isProp G A) pp) (PU.isProp K Ak) (PU.isProp-ov K G A pp Ak (refl Ak)) (C.subt K G (PU.isProp G A) pA pp) ;
 pBk : C.El (C.ext K Ak) (PU.isProp (C.ext K Ak) Bk) =
  OV.trE (C.ext K Ak) (C.subT (C.ext K Ak) (C.ext G A) (PU.isProp (C.ext G A) B) (C.lift K G A pp)) (PU.isProp (C.ext K Ak) Bk)
    (PU.isProp-ov (C.ext K Ak) (C.ext G A) B (C.lift K G A pp) Bk (refl Bk))
    (C.subt (C.ext K Ak) (C.ext G A) (PU.isProp (C.ext G A) B) pB (C.lift K G A pp)) ;
 e : C.El K (IJ.IdT K Ak (IN.fst K Ak Bk w1) (IN.fst K Ak Bk w2)) = PU.propPath K Ak pAk (IN.fst K Ak Bk w1) (IN.fst K Ak Bk w2) ;
 pq : C.El K (IJ.IdT K Sk w1 w2) = PPr.At[K, Ak, Bk].pairPath pBk w1 w2 e ;
 bd : C.El K (IJ.IdT K (OV.wkT GS Sw Sw) u1 u2) = H6.idBack K (OV.wkT GS Sw Sw) Sk TPs u1 u2 pq ;
 -- Sigma A B IS A PROPOSITION
 sigProp : C.El G (PU.isProp G S) =
  OV.lam G S (FibCwF[a, a+].fibPi.Pi GS Sw (IJ.IdT K (OV.wkT GS Sw Sw) u1 u2)) (OV.lam GS Sw (IJ.IdT K (OV.wkT GS Sw Sw) u1 u2) bd) ;
} ;

