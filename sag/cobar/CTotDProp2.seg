-- CTotDProp2.seg (canonicity-c2; "D preserves propositions", part 2):
-- the move data from D(A1) over D(G.A) back to D A weakened over
-- D G . D A: bk (the same values, the triple equations projected),
-- bkMv, and the injectivity mTinj.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module DP2 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module P1m = CTotDProp1[a, vl, l].DP1[C, G, A] ;
 module TC = P1m.TC ;
 module P = P1m.P ;
 module DA = P1m.DA ;
 module DA1 = P1m.DA1 ;
 module PR = P1m.PR ;
 DG : P.PCtx = TC.toP DA.D.DCtx ;
 SF : P.PTy[PR.Ext] = P.subTy PR.Ext DG DA.DTy (P.pP DG DA.DTy) ;
 module G1 = CTotR[a, vl, l].TotR[C].G1 ;
 module TS = G1.GB.GPre[l].TyL[PR.Ext, SF] ;
 module TS0 = G1.GB.GPre[l].TyL[PR.DEP, DA1.DTy] ;
 mS (W : TC.TOb) (v : TS.EI W) : TS0.EI W = TS0.pr W (PR.phi W v.1) (P1m.MS[W.1, W.2, v.1, v.2].res) ;
 -- back: the same values, the equations projected from triples to pairs
 module Bk (X : TC.TOb) (x : W0.Ix (PR.Ext.ob X)) (u : DA1.TOb' X.1 X.2 (PR.phi X x)) {
  pj (J : TC.TOb) (z : P.SigT P1m.EP P1m.A1 J) : P.SigT P1m.GP A J = P.pairE P1m.GP A J z.1.1 z.2 ;
  anat' : W0.Ix (DA.anatEq X.1 X.2 x.1 u.1) = \ r lq ->
   apH {P.SigT P1m.EP P1m.A1 (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} {P.SigT P1m.GP A (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
     (pj (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (u.2.1 r lq) ;
  aface' : W0.Ix (DA.afaceEq X.1 X.2 x.1 u.1) = \ r lq ->
   apH {P.SigT P1m.EP P1m.A1 (r.2.2.2.1, r.2.2.2.2.2.1)} {P.SigT P1m.GP A (r.2.2.2.1, r.2.2.2.2.2.1)} (pj (r.2.2.2.1, r.2.2.2.2.2.1)) (u.2.2.1 r lq) ;
  atop' : W0.Ix (DA.atopEq X.1 X.2 x.1 u.1) = \ r lq ->
   apH {P.SigT P1m.EP P1m.A1 (r.2.1, r.2.2.2.1)} {P.SigT P1m.GP A (r.2.1, r.2.2.2.1)} (pj (r.2.1, r.2.2.2.1)) (u.2.2.2 r lq) ;
  res : W0.Ix (SF.tob X x) = (u.1, anat', aface', atop') ;
 } ;
 bk (X : TC.TOb) (x : W0.Ix (PR.Ext.ob X)) (u : W0.Ix (DA1.DTy.tob X (PR.phi X x))) : W0.Ix (SF.tob X x) = Bk[X, x, u].res ;
 bkMv (X : TC.TOb) (x : W0.Ix (PR.Ext.ob X)) (u : W0.Ix (DA1.DTy.tob X (PR.phi X x)))
   : Id (TS0.EI X) (mS X (TS.pr X x (bk X x u))) (TS0.pr X (PR.phi X x) u) =
  apH {DA1.TOb' X.1 X.2 (PR.phi X x)} {TS0.EI X} (\ c -> TS0.pr X (PR.phi X x) c)
    (DA1.tob-eq X.1 X.2 (PR.phi X x) (P1m.MS[X.1, X.2, x, bk X x u].res) u (\ q lq -> refl (u.1 q lq))) ;
 -- mS is injective over equal points
 mTinj (W : TC.TOb) (v v' : TS.EI W) (Pp : Id (W0.Ix (PR.Ext.ob W)) (TS.pr1 W v) (TS.pr1 W v')) (Q : Id (TS0.EI W) (mS W v) (mS W v'))
   : Id (TS.EI W) v v' =
  idJ (W0.Ix (PR.Ext.ob W)) v.1
    (\ t2 P2 -> (s2 : W0.Ix (SF.tob W t2)) -> Id (TS0.EI W) (mS W v) (mS W (t2, s2)) -> Id (TS.EI W) v (t2, s2))
    (\ s2 Q2 -> apH {W0.Ix (SF.tob W v.1)} {TS.EI W} (\ c -> (v.1, c))
       (DA.tob-eq W.1 W.2 v.1.1 v.2 s2 (\ q lq ->
          apH {DA1.TOb' W.1 W.2 (PR.phi W v.1)} {W0.Ix (A.tob (q.2.1, q.2.2.2.1) (v.1.1.1 q lq))} (\ c -> c.1 q lq)
            (P.pairE-inj PR.DEP DA1.DTy W (PR.phi W v.1) (P1m.MS[W.1, W.2, v.1, v.2].res) (P1m.MS[W.1, W.2, v.1, s2].res) Q2))))
    v'.1 Pp v'.2 Q ;
 -- mS is natural: compare the readings (L12m.totEq at (ET , A1)); the left
 -- one by D A1's action (TB.pc), the right one by D A's actions on t's
 -- values and on s (TB.pc twice) put together by tripleE
 module LM1 = CTotL12m[a, vl, l].L12m[C, P1m.ET, P1m.A1] ;
 module NS (Va Wa : TC.TOb) (g : TC.THm Va Wa) (v : TS.EI Wa) {
  t : W0.Ix (PR.Ext.ob Wa) = v.1 ;
  s : W0.Ix (SF.tob Wa t) = v.2 ;
  t' : W0.Ix (PR.Ext.ob Va) = PR.Ext.act Va Wa g t ;
  eS : Id (W0.Ix (DG.ob Va)) (DG.act Va Wa g t.1) t'.1 = P.ntEq PR.Ext DG (P.pP DG DA.DTy) Va Wa g t t' (refl t') ;
  module TL = DA1.TB[Va.1, Wa.1, g.1, Va.2, Wa.2, g.2, PR.phi Wa t, PR.DEP.act Va Wa g (PR.phi Wa t), refl (PR.DEP.act Va Wa g (PR.phi Wa t)), P1m.MS[Wa.1, Wa.2, t, s].res] ;
  module TA = DA.TB[Va.1, Wa.1, g.1, Va.2, Wa.2, g.2, t.1, t'.1, refl t'.1, t.2] ;
  module TSs = DA.TB[Va.1, Wa.1, g.1, Va.2, Wa.2, g.2, t.1, t'.1, eS, s] ;
  H (q : DA.Idx Va.1 Va.2) (lq : DA.LandsI Va.1 Va.2 q)
    : Id (DA1.Ez q.2.1 q.2.2.2.1) (LM1.LB.rdT Va (TS0.E.act Va Wa g (mS Wa v)) q lq) (LM1.LB.rdT Va (mS Va (TS.E.act Va Wa g v)) q lq) =
   transH (TL.pc q lq)
     (symH (P1m.tripleE (q.2.1, q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (t'.1.1 q lq) (t'.2.1 q lq)) (DA.prz q.2.1 q.2.2.2.1 (t.1.1 (TA.sh q) lq) (t.2.1 (TA.sh q) lq))
        (TSs.a' q lq) (s.1 (TA.sh q) lq) (TA.pc q lq) (TSs.pc q lq))) ;
  law : Id (TS0.EI Va) (TS0.E.act Va Wa g (mS Wa v)) (mS Va (TS.E.act Va Wa g v)) =
   LM1.totEq Va (TS0.E.act Va Wa g (mS Wa v)) (mS Va (TS.E.act Va Wa g v)) (symH (PR.phiN Va Wa g t)) (\ q lq -> H q lq) ;
 } ;
} ;
