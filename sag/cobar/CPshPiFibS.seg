-- CPshPiFibS.seg (canonicity-c2; COBAR.md (B) stage 2(c), M3b): the
-- uniform fibration structure of Pi_A B is natural in the C-substitution
-- (piCl-nat of CwFCl.ClPi), hence Pi on the CwF of fibrant C-types.
--
-- At each x: K, the cartesian map from (Pi_{A[s]} B[lift s])_x to
-- (Pi_A B)_x over s_x (transport back along CPshPiNat's Pf x, then the
-- lift, as CPiCart at the base); FibCwF.MoveNat turns the substituted
-- structure, transported along Pf x, into the move along K.
--   prS    the (y , f) projection of a total read by K, read in Pi_y, is
--          CPiCart's reading at y of the (y , f) projection of the total
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module PN = CPshPiNat[a, l] ;

-- transport back after transport forth along a path of types
trV-tyTr (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (X : Ob) (p : W0.Ix (Gb.ob X)) (v : W0.Ix (T.tob X p))
 : Id (W0.Ix (T.tob X p)) (PB.CTrFib[l].TR[Gb, T].trV T' Pt X p (PN.tyTr Gb T T' Pt X p v)) v =
 idJ (PTy[Gb]) T
  (\ T1 P1 -> Id (W0.Ix (T.tob X p)) (PB.CTrFib[l].TR[Gb, T].trV T1 P1 X p (PN.tyTr Gb T T1 P1 X p v)) v)
  (refl v) T' Pt ;
tyTr-trV (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (X : Ob) (p : W0.Ix (Gb.ob X)) (v : W0.Ix (T'.tob X p))
 : Id (W0.Ix (T'.tob X p)) (PN.tyTr Gb T T' Pt X p (PB.CTrFib[l].TR[Gb, T].trV T' Pt X p v)) v =
 idJ (PTy[Gb]) T
  (\ T1 P1 -> (v1 : W0.Ix (T1.tob X p)) -> Id (W0.Ix (T1.tob X p)) (PN.tyTr Gb T T1 P1 X p (PB.CTrFib[l].TR[Gb, T].trV T1 P1 X p v1)) v1)
  (\ v1 -> refl v1) T' Pt v ;

module SOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module NA = PN.NatOf[C] ;
 module FB = CPshPiFib[a, l].FibOf[C] ;
 module NN = CPshPiFibN[a, l].NOf[C] ;
 open P ;

 module Sx (D G : CCtx) (s : CSub[D, G]) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (x : CO) {
  module N = NA.N[D, G, s, A, B] ;
  Dx : PCtx = D.ob x ;
  Gx : PCtx = G.ob x ;
  XG : PTy[Gx] = N.PG.piTy x ;
  YD : PTy[Dx] = N.PD.piTy x ;
  module TRm = PB.CTrFib[l].TR[Dx, N.LT x] ;
  module SEP = PB.CSub[l].SubE[Dx, Gx, s.sb x, XG] ;
  module TY = GPR.TyL[Dx, YD] ;
  module TX = GPR.TyL[Gx, XG] ;

  -- the cartesian map
  ta (W : Ob) (v : TY.EI W) : TX.EI W = SEP.mV W (TRm.ta YD (N.Pf x) W v) ;
  tanat (V W : Ob) (g : Hom V W) (v : TY.EI W) : Id (TX.EI V) (TX.E.act V W g (ta W v)) (ta V (TY.E.act V W g v)) =
   transH (SEP.mV-nat V W g (TRm.ta YD (N.Pf x) W v)) (apH (\ t -> SEP.mV V t) (TRm.tanat YD (N.Pf x) V W g v)) ;
  tainj (W : Ob) (v v' : TY.EI W) (Pp : Id (W0.Ix (Dx.ob W)) (TY.pr1 W v) (TY.pr1 W v')) (Q : Id (TX.EI W) (ta W v) (ta W v')) : Id (TY.EI W) v v' =
   TRm.tainj YD (N.Pf x) W v v' Pp (SEP.mV-inj W (TRm.ta YD (N.Pf x) W v) (TRm.ta YD (N.Pf x) W v') Pp Q) ;
  bk (X : Ob) (dd : W0.Ix (Dx.ob X)) (u : W0.Ix (XG.tob X ((s.sb x).nt X dd))) : W0.Ix (YD.tob X dd) = TRm.fwV YD (N.Pf x) X dd u ;
  bkta (X : Ob) (dd : W0.Ix (Dx.ob X)) (u : W0.Ix (XG.tob X ((s.sb x).nt X dd)))
   : Id (TX.EI X) (ta X (TY.pr X dd (bk X dd u))) (TX.pr X ((s.sb x).nt X dd) u) =
   apH (\ t -> SEP.mV X t) (TRm.bkta YD (N.Pf x) X dd u) ;
  module K = PB.CCart[l, l].Cart[Dx, YD, Gx, XG, (s.sb x).nt, (s.sb x).nt-nat, ta, \ W v -> refl ((s.sb x).nt W (TY.pr1 W v)), tanat, tainj, bk, bkta] ;
  module MN = FibCwF[a, l].MoveNat[Dx, Gx, s.sb x, XG, YD, N.Pf x, ta, \ W v -> refl ((s.sb x).nt W (TY.pr1 W v)), tanat, tainj, bk, bkta, \ W v -> refl (ta W v)] ;

  -- the projection of a read total
  module Py (y : CO) (f : CH y x) {
   module PCy = PB.CPiCart[l].PiCart[D.ob y, G.ob y, s.sb y, A.ty y, B.ty y] ;
   module SEg = PB.CSub[l].SubE[Gx, G.ob y, G.act y x f, N.PG.PiB y] ;
   module SEd = PB.CSub[l].SubE[Dx, D.ob y, D.act y x f, N.PD.PiB y] ;
   module FG = FB.Fr[G, A, B, x, PB.e0, PB.e1] ;
   module FD = FB.Fr[D, N.A', N.B', x, PB.e0, PB.e1] ;
   module At (W : Ob) (t : TY.EI W) {
    dd : W0.Ix (Dx.ob W) = TY.pr1 W t ;
    module Nx = N.AtN[x, W, dd] ;
    uD : Nx.SD.PiIx = TY.pr2 W t ;
    uG : Nx.SG.PiIx = TRm.trV YD (N.Pf x) W dd uD ;
    e1 : Id (W0.Ix (Nx.FD y f)) (Nx.trC y f (uG.1 y f)) (uD.1 y f) =
     transH (symH (apH (\ b -> b y f) (N.trFst x W dd uG)))
      (apH (\ u -> u.1 y f) (tyTr-trV Dx (N.LT x) YD (N.Pf x) W dd uD)) ;
    e2 : Id (W0.Ix ((N.ST y).tob W (Nx.SD.ptC y f))) (PCy.TRm.trV PCy.PED.P PCy.P2 W (Nx.SD.ptC y f) (uD.1 y f)) (Nx.mvS y f (uG.1 y f)) =
     transH (apH (\ v -> PCy.TRm.trV PCy.PED.P PCy.P2 W (Nx.SD.ptC y f) v) (symH e1))
      (trV-tyTr (D.ob y) (N.ST y) (N.PD.PiB y) (N.NP y) W (Nx.SD.ptC y f) (Nx.mvS y f (uG.1 y f))) ;
    res : Id (PCy.PEG.TP.EI W) (SEg.mV W (FG.prM y f W (ta W t))) (PCy.ta W (SEd.mV W (FD.prM y f W t))) =
     transH (GPR.TyL[G.ob y, N.PG.PiB y].pr-coe W (Nx.SG.ptC y f) ((s.sb y).nt W (Nx.SD.ptC y f)) (Nx.qS y f) (uG.1 y f))
      (apH (\ v -> PCy.PEG.TP.pr W ((s.sb y).nt W (Nx.SD.ptC y f)) v) (symH e2)) ;
   } ;
   prS (W : Ob) (t : TY.EI W) : Id (PCy.PEG.TP.EI W) (SEg.mV W (FG.prM y f W (ta W t))) (PCy.ta W (SEd.mV W (FD.prM y f W t))) = At[W, t].res ;
  } ;

  ------------------------------------------------------------------
  -- S2: in the direction d, the composition of (Pi_{A[s]} B[lift s])_x
  -- is the move along K of that of (Pi_A B)_x, given (cmpY) that at each
  -- y the base composition of the substituted product is CPiCart's move
  -- of the base composition of the product (the base's CPiNat)

  module Hd (d : Bool)
   (kA : (y : CO) -> CL.Lines[G.ob y, A.ty y].Fill (PB.tgt d))
   (cB : (y : CO) -> CL.Lines[extP (G.ob y) (A.ty y), B.ty y].CompK[PB.src d, PB.tgt d].Comp)
   (kA' : (y : CO) -> CL.Lines[D.ob y, N.A'.ty y].Fill (PB.tgt d))
   (cB' : (y : CO) -> CL.Lines[extP (D.ob y) (N.A'.ty y), N.B'.ty y].CompK[PB.src d, PB.tgt d].Comp)
   (cmpY : (y : CO) -> Id (CL.Lines[D.ob y, N.PD.PiB y].CompK[PB.src d, PB.tgt d].Comp)
              (PB.CPi[l].PiC[D.ob y, N.A'.ty y, N.B'.ty y, d, kA' y, cB' y].comp)
              (PB.CPiCart[l].PiCart[D.ob y, G.ob y, s.sb y, A.ty y, B.ty y].C.MoveComp[PB.src d, PB.tgt d].move
                 (PB.CPi[l].PiC[G.ob y, A.ty y, B.ty y, d, kA y, cB y].comp))) {
   module NG = NN.Nd[G, A, B, x, d, kA, cB] ;
   module ND = NN.Nd[D, N.A', N.B', x, d, kA', cB'] ;
   module FGd = NG.F ;
   module FDd = ND.F ;
   module MC = K.MoveComp[PB.src d, PB.tgt d] ;

   -- at (y , f): the moved data agree
   module Cy (y : CO) (f : CH y x) {
    module PCy = PB.CPiCart[l].PiCart[D.ob y, G.ob y, s.sb y, A.ty y, B.ty y] ;
    module MCy = PCy.C.MoveComp[PB.src d, PB.tgt d] ;
    module PiKG = PB.CPi[l].PiC[G.ob y, A.ty y, B.ty y, d, kA y, cB y] ;
    module PiKD = PB.CPi[l].PiC[D.ob y, N.A'.ty y, N.B'.ty y, d, kA' y, cB' y] ;
    module AG = NG.AtY[y, f] ;
    module AD = ND.AtY[y, f] ;
    module CmG = FGd.Cm[y, f] ;
    module CmD = FDd.Cm[y, f] ;
    module SEg = PB.CSub[l].SubE[Gx, G.ob y, G.act y x f, N.PG.PiB y] ;
    module SEd = PB.CSub[l].SubE[Dx, D.ob y, D.act y x f, N.PD.PiB y] ;
    prS (W : Ob) (t : TY.EI W) : Id (PiKG.TP.EI W) (SEg.mV W (FGd.prM y f W (ta W t))) (PCy.ta W (SEd.mV W (FDd.prM y f W t))) =
     Py[y, f].prS W t ;
    lnW (W : Ob) (wp : FDd.CKP.EK.TV.EI W)
     : Id (W0.Ix (CL.FC[G.ob y].ob W)) (PiKG.KP.TV.pr1 W (MCy.E.sV W (AD.FS.E.sV W (CmD.M.tvM W wp))))
         (PiKG.KP.TV.pr1 W (AG.FS.E.sV W (CmG.M.tvM W (MC.E.sV W wp)))) =
     CL.FC[G.ob y].fam-eq W (PiKG.KP.TV.pr1 W (MCy.E.sV W (AD.FS.E.sV W (CmD.M.tvM W wp))))
      (PiKG.KP.TV.pr1 W (AG.FS.E.sV W (CmG.M.tvM W (MC.E.sV W wp))))
      (\ V k j -> s.sb-nat y x f V ((FDd.CKP.EK.TV.pr1 W wp).1 V k j)) ;
    endW1 (W : Ob) (wp : FDd.CKP.EK.TV.EI W)
     : Id (PiKG.TP.EI W) (PiKG.KP.endE W (MCy.E.sV W (AD.FS.E.sV W (CmD.M.tvM W wp))))
         (PCy.ta W (SEd.mV W (FDd.prM y f W (FDd.CKP.EK.endE W wp)))) =
     transH (MCy.E.sVE W (AD.FS.E.sV W (CmD.M.tvM W wp)))
      (apH (\ t -> PCy.ta W t)
        (transH (AD.FS.E.sVE W (CmD.M.tvM W wp)) (apH (\ t -> SEd.mV W t) (CmD.M.tvM-E W wp)))) ;
    endW2 (W : Ob) (wp : FDd.CKP.EK.TV.EI W)
     : Id (PiKG.TP.EI W) (PiKG.KP.endE W (AG.FS.E.sV W (CmG.M.tvM W (MC.E.sV W wp))))
         (SEg.mV W (FGd.prM y f W (ta W (FDd.CKP.EK.endE W wp)))) =
     transH (AG.FS.E.sVE W (CmG.M.tvM W (MC.E.sV W wp)))
      (transH (apH (\ t -> SEg.mV W t) (CmG.M.tvM-E W (MC.E.sV W wp)))
        (apH (\ t -> SEg.mV W (FGd.prM y f W t)) (MC.E.sVE W wp))) ;
    eWs (W : Ob) (wp : FDd.CKP.EK.TV.EI W)
     : Id (PiKG.KP.TV.EI W) (MCy.E.sV W (AD.FS.E.sV W (CmD.M.tvM W wp))) (AG.FS.E.sV W (CmG.M.tvM W (MC.E.sV W wp))) =
     PiKG.KP.tv-eq W (MCy.E.sV W (AD.FS.E.sV W (CmD.M.tvM W wp))) (AG.FS.E.sV W (CmG.M.tvM W (MC.E.sV W wp))) (lnW W wp)
      (transH (endW1 W wp) (transH (symH (prS W (FDd.CKP.EK.endE W wp))) (symH (endW2 W wp)))) ;
    tsPt (W : Ob) (u : FDd.CKP.EK.TS.EI W)
     : Id (PiKG.KP.TV.EI W) (PiKG.KP.TS.pr1 W (MCy.E.mS W (AD.FS.E.mS W (CmD.M.tsM W u))))
         (PiKG.KP.TS.pr1 W (AG.FS.E.mS W (CmG.M.tsM W (MC.E.mS W u)))) =
     transH (MCy.E.mSpt W (AD.FS.E.mS W (CmD.M.tsM W u)))
      (transH (apH (\ t -> MCy.E.sV W t) (transH (AD.FS.E.mSpt W (CmD.M.tsM W u)) (apH (\ t -> AD.FS.E.sV W t) (CmD.M.tsM-pt W u))))
        (transH (eWs W (FDd.CKP.EK.TS.pr1 W u))
          (symH (transH (AG.FS.E.mSpt W (CmG.M.tsM W (MC.E.mS W u)))
                   (apH (\ t -> AG.FS.E.sV W t) (transH (CmG.M.tsM-pt W (MC.E.mS W u)) (apH (\ t -> CmG.M.tvM W t) (MC.E.mSpt W u)))))))) ;
    tsLv (W : Ob) (u : FDd.CKP.EK.TS.EI W) (V : Ob) (k : Hom V W) (j : Hom V Iv)
     : Id (PiKG.TP.EI V) (PiKG.KP.lv W (MCy.E.mS W (AD.FS.E.mS W (CmD.M.tsM W u))) V k j)
         (PiKG.KP.lv W (AG.FS.E.mS W (CmG.M.tsM W (MC.E.mS W u))) V k j) =
     transH (MCy.E.mS-val W (AD.FS.E.mS W (CmD.M.tsM W u)) V k j)
      (transH (apH (\ t -> PCy.ta V t)
                 (transH (AD.FS.E.mS-val W (CmD.M.tsM W u) V k j) (apH (\ t -> SEd.mV V t) (CmD.M.tsM-val W u V k j))))
        (transH (symH (prS V (FDd.CKP.EK.lv W u V k j)))
          (symH (transH (AG.FS.E.mS-val W (CmG.M.tsM W (MC.E.mS W u)) V k j)
                   (transH (apH (\ t -> SEg.mV V t) (CmG.M.tsM-val W (MC.E.mS W u) V k j))
                     (apH (\ t -> SEg.mV V (FGd.prM y f V t)) (MC.E.mS-val W u V k j))))))) ;
    tsEs (W : Ob) (u : FDd.CKP.EK.TS.EI W)
     : Id (PiKG.KP.TS.EI W) (MCy.E.mS W (AD.FS.E.mS W (CmD.M.tsM W u))) (AG.FS.E.mS W (CmG.M.tsM W (MC.E.mS W u))) =
     PiKG.KP.ts-ext W (MCy.E.mS W (AD.FS.E.mS W (CmD.M.tsM W u))) (AG.FS.E.mS W (CmG.M.tsM W (MC.E.mS W u))) (tsPt W u) (tsLv W u) ;
   } ;

   -- the composite of the substituted product, read by K, is the
   -- composite of the product at the moved data.  Only the families of
   -- component composites matter (kcomp), so any proofs of NatComp do.
   module Hn (ncG : NG.Cq.NatComp) (ncD : ND.Cq.NatComp) {
    compG : FGd.CKP.Comp = NG.Cq.Wn[ncG].comp ;
    compD : FDd.CKP.Comp = ND.Cq.Wn[ncD].comp ;
    module Hw (X : Ob) (w : FDd.CKP.EK.TV.EI X) (sd : FDd.CKP.EK.PT.Side[X, w]) {
     wG : FGd.CKP.EK.TV.EI X = MC.E.sV X w ;
     sG : FGd.CKP.EK.PT.Side[X, wG] = MC.mside compG X w sd ;
     ltD : FDd.TTP.EI X = FDd.TTP.pr X w (compD.kop X w sd) ;
     lt : FGd.TTP.EI X = MC.mT X ltD ;
     rt : FGd.TTP.EI X = FGd.TTP.pr X wG (compG.kop X wG sG) ;
     rdLt : Id (FGd.TP.EI X) (FGd.rdP X lt) (ta X (FDd.rdP X ltD)) = MC.E'.sVE X (FDd.CKP.SE.mV X ltD) ;
     module Wy (y : CO) (f : CH y x) {
      module Kc = Cy[y, f] ;
      module VD = ND.Val[X, w, sd, y, f] ;
      module VG = NG.Val[X, wG, sG, y, f] ;
      wM : Kc.PiKG.KP.TV.EI X = Kc.MCy.E.sV X VD.wY ;
      pM : Kc.PiKG.KP.PT.Side[X, wM] = Kc.MCy.mside Kc.PiKG.comp X VD.wY VD.pY ;
      -- the base composite of the substituted product, read by CPiCart
      k1 : Id (Kc.PiKG.TP.EI X) (Kc.PCy.ta X (Kc.PiKD.TP.pr X VD.CX.xT VD.CX.cop))
            (Kc.PiKG.rdP X (Kc.PiKG.TTP.pr X wM (Kc.PiKG.comp.kop X wM pM))) =
       transH (symH (Kc.MCy.E'.sVE X (Kc.MCy.CK'.SE.mV X (Kc.PiKD.TTP.pr X VD.wY VD.CX.cop))))
        (apH (\ t -> Kc.PiKG.rdP X t)
          (transH (apH (\ c -> Kc.MCy.mT X (Kc.PiKD.TTP.pr X VD.wY (c.kop X VD.wY VD.pY))) (cmpY y))
            (Kc.MCy.kopMv Kc.PiKG.comp X VD.wY VD.pY))) ;
      -- the moved sides agree
      eS : Id (Kc.PiKG.KP.PT.Side[X, VG.wY]) (subst (Kc.PiKG.KP.TV.EI X) (\ t -> Kc.PiKG.KP.PT.Side[X, t]) wM VG.wY (Kc.eWs X w) pM) VG.pY =
       Kc.PiKG.KP.PT.side-extH X wM VG.wY (Kc.eWs X w) pM VG.pY (refl sd.pQ)
        (\ W k i i' -> transH (Kc.tsEs W (sd.pv W k i))
           (apH (\ t -> Kc.AG.FS.E.mS W (Kc.CmG.M.tsM W (MC.E.mS W t))) (FDd.CKP.EK.PT.pv-irr X w sd W k i i'))) ;
      k2 : Id (Kc.PiKG.TTP.EI X) (Kc.PiKG.TTP.pr X wM (Kc.PiKG.comp.kop X wM pM)) (Kc.PiKG.TTP.pr X VG.wY VG.CX.cop) =
       Kc.PiKG.RCP.kop-cong Kc.PiKG.comp X wM VG.wY (Kc.eWs X w) pM VG.pY eS ;
      q1 : Id (Kc.PiKG.TP.EI X) (Kc.SEg.mV X (FGd.prM y f X (FGd.rdP X lt))) (Kc.SEg.mV X (FGd.prM y f X (FGd.rdP X rt))) =
       transH (apH (\ t -> Kc.SEg.mV X (FGd.prM y f X t)) rdLt)
        (transH (Kc.prS X (FDd.rdP X ltD))
          (transH (apH (\ t -> Kc.PCy.ta X t) VD.compE)
            (transH k1 (transH (apH (\ t -> Kc.PiKG.rdP X t) k2) (symH VG.compE))))) ;
      res : Id (SigT Gx (FGd.TT y f) X) (FGd.prM y f X (FGd.rdP X lt)) (FGd.prM y f X (FGd.rdP X rt)) =
       Kc.SEg.mV-inj X (FGd.prM y f X (FGd.rdP X lt)) (FGd.prM y f X (FGd.rdP X rt))
        (apH (\ t -> fstE Gx XG X t) rdLt) q1 ;
     } ;
     res : Id (FGd.TTP.EI X) lt rt =
      FGd.tt-ext X lt rt (refl wG) (FGd.tot-extC X (FGd.rdP X lt) (FGd.rdP X rt) (\ y f -> Wy[y, f].res)) ;
    } ;
    -- the composition of the substituted product is the moved composition
    uniq : Id (FDd.CKP.Comp) compD (MC.move compG) = MC.unique compG compD (\ X w sd -> Hw[X, w, sd].res) ;
   } ;
  } ;
 } ;
} ;
