-- CDEv2.seg (canonicity-c2; (d), part 2): over D1 = nil.HomT(s, y), for every
-- term t over s's generators, z (cls t) = ev_t (z at the generators): by
-- recursion on t through z's data (CUG19 at the binary operations, CUG22 at
-- the constants) and the congruence of the operations (CCmpU18.Ap2).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module DE2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) {
 module D = CDEv1[a].DE1[R, encK, pe, s, y] ;
 module HZ = D.HZ ;
 module AS = HZ.AS ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = D.HS ;
 QY : C.Ty Nl = D.QY ;
 D1 : C.Ctx = D.D1 ;
 QYd : C.Ty D1 = D.QYd ;
 Tm : U a = SX.Over[R].Expr (SX.Fin D.n) ;
 pkN (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (D.pk I w)) (D.pk J (D1.act J I f w)) =
  refl (HS.1.tact J I f w.1 w.1 (refl w.1) w.2) ;
 module U19m = CUG19[a].UG19[R, encK, pe, s, y, HS, D.pk, D.pk, pkN, pkN] ;
 module U20m = CUG20[a].UG20[R, encK, pe, s, y, HS, D.pk, D.pk, pkN, pkN] ;
 module U22m = CUG22[a].UG22[R, encK, pe, s, y, HS, D.pk, D.pk, pkN, pkN] ;
 U16D : C.Ctx = U19m.U16m.D1 ;
 HE (t : Tm) : C.Ty D1 = IJ.IdT D1 QYd (D.apZ (AS.AX.cls t)) (D.evT t) ;
 -- constants
 cRd (r : R.R) (K : Ob) : (o : Top) (z : V1.Ix (HS.1.tob K o)) -> Id (D.QK K (o, z)) ((D.evT (cst r)).eob K (o, z)) ((HZ.AT.AX.cls (cst r)).eob K o) =
  split { tt -> \ z -> D.evTr (cst r) K z } ;
 hCst (r : R.R) : C.El D1 (HE (cst r)) =
  D.rwId D1 QYd (U22m.At[r].e3) (D.apZ (AS.AX.cls (cst r))) (U22m.At[r].e1) (D.evT (cst r))
   (\ K w -> transH (U22m.At[r].e3rd K w) (symH (D.U13m.ZA.rdF (AS.AX.cls (cst r)) K w)))
   (\ K w -> transH (U22m.At[r].e1rd K w) (symH (cRd r K w.1 w.2)))
   (PT.symM D1 QYd (U22m.At[r].e1) (U22m.At[r].e3) (U22m.At[r].res)) ;
} ;
