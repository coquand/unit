-- CDFw8.seg (canonicity-c2; (d)(1), part 8): fwd : HomT(x.u, y) -> T0 =
-- Sigma (h : HomT(x, y)). Sol_h(u) (CSolT), z |-> (z . p_u, (z at the new
-- generators, the equations of u)) (CDFw1-7).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module Fw8 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F7m = CDFw7[a].Fw7[R, encK, pe, x, u, y] ;
 module F1 = F7m.F1 ;
 module S2 = F1.S2 ;
 module S1 = F1.S1 ;
 Nl : C.Ctx = C.nil ;
 D1 : C.Ctx = F1.D1 ;
 Gh : C.Ctx = S1.Gh ;
 HU : C.Ty Nl = F1.HU ;
 HXY : C.Ty Nl = S1.HXY ;
 sg1 : C.Sub D1 Gh = F1.sg1 ;
 Pm' : C.Ty Gh = S1.Pm' ;
 RP : C.Ty S1.Dv = S2.RelProd u.2 ;
 PmD : C.Ty D1 = C.subT D1 Gh Pm' sg1 ;
 lf1 : C.Sub (C.ext D1 PmD) S1.Dv = C.lift D1 Gh Pm' sg1 ;
 PS1 : Id (C.Ty D1) (C.subT D1 S1.Dv RP F1.sg2) (C.subT D1 (C.ext D1 PmD) (C.subT (C.ext D1 PmD) S1.Dv RP lf1) (C.sec D1 PmD F1.vv)) =
  transH (apH {C.Sub D1 S1.Dv} {C.Ty D1} (\ s -> C.subT D1 S1.Dv RP s) (L.sub-ext D1 S1.Dv F1.sg2 (C.o D1 (C.ext D1 PmD) S1.Dv lf1 (C.sec D1 PmD F1.vv)) (\ K w -> refl (F1.sg2.nt K w))))
   (C.subT-o D1 (C.ext D1 PmD) S1.Dv RP lf1 (C.sec D1 PmD F1.vv)) ;
 sol : C.El D1 (C.subT D1 Gh S2.Sol sg1) =
  OV.trE D1 (SS.Sig D1 PmD (C.subT (C.ext D1 PmD) S1.Dv RP lf1)) (C.subT D1 Gh S2.Sol sg1) (symH (FibCwF[a, a+].fibSig.Sig-nat D1 Gh Pm' RP sg1))
   (INm.pr D1 PmD (C.subT (C.ext D1 PmD) S1.Dv RP lf1) F1.vv
     (OV.trE D1 (C.subT D1 S1.Dv RP F1.sg2) (C.subT D1 (C.ext D1 PmD) (C.subT (C.ext D1 PmD) S1.Dv RP lf1) (C.sec D1 PmD F1.vv)) PS1
       (F7m.relEl u.2 (\ p mm -> mm)))) ;
 T0 : C.Ty Nl = SS.Sig Nl HXY S2.Sol ;
 HXD : C.Ty D1 = C.subT D1 Nl HXY (C.p Nl HU) ;
 lf0 : C.Sub (C.ext D1 HXD) Gh = C.lift D1 Nl HXY (C.p Nl HU) ;
 PS0 : Id (C.Ty D1) (C.subT D1 Gh S2.Sol sg1) (C.subT D1 (C.ext D1 HXD) (C.subT (C.ext D1 HXD) Gh S2.Sol lf0) (C.sec D1 HXD F1.hX)) =
  transH (apH {C.Sub D1 Gh} {C.Ty D1} (\ s -> C.subT D1 Gh S2.Sol s) (L.sub-ext D1 Gh sg1 (C.o D1 (C.ext D1 HXD) Gh lf0 (C.sec D1 HXD F1.hX)) (\ K w -> refl (sg1.nt K w))))
   (C.subT-o D1 (C.ext D1 HXD) Gh S2.Sol lf0 (C.sec D1 HXD F1.hX)) ;
 t0 : C.El D1 (C.subT D1 Nl T0 (C.p Nl HU)) =
  OV.trE D1 (SS.Sig D1 HXD (C.subT (C.ext D1 HXD) Gh S2.Sol lf0)) (C.subT D1 Nl T0 (C.p Nl HU)) (symH (FibCwF[a, a+].fibSig.Sig-nat D1 Nl HXY S2.Sol (C.p Nl HU)))
   (INm.pr D1 HXD (C.subT (C.ext D1 HXD) Gh S2.Sol lf0) F1.hX (OV.trE D1 (C.subT D1 Gh S2.Sol sg1) (C.subT D1 (C.ext D1 HXD) (C.subT (C.ext D1 HXD) Gh S2.Sol lf0) (C.sec D1 HXD F1.hX)) PS0 sol)) ;
 fwd : C.El Nl (OV.Fun Nl HU T0) = OV.lam Nl HU (OV.wkT Nl HU T0) t0 ;
} ;
