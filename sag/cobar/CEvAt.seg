-- CEvAt.seg (canonicity-45; COBAR.md "Prop 58"): over the empty context,
-- evaluation at a closed element c, h |-> h(c), is a natural map from the
-- maps QS -> QT (CHomT1's MapT) to QT, and a closed internal Id e : a = b in
-- QS gives a path homotopy between evaluation at a and at b (the values of
-- e's Yoneda Id fibre, pushed through h; naturality by CHomT1's NTh).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module FCP = FibCwF[a, a+] ;
module EA (QS QT : FCP.fibCwF.Ty FCP.fibCwF.nil) {
 module HO = PB.CHtpyOps[a+] ;
 module B0 = CHomT1[a].BaseOf[QS, QT] ;
 Nl : L.PCtx = FCP.fibCwF.nil ;
 MT : L.PTy[Nl] = B0.MapT.1 ;
 module At (c : FCP.fibCwF.El Nl QS) {
  nat1 (J I : Ob) (g : Hom J I) (e1 : Id (V1.Ix (Nl.ob J)) (Nl.act J I g tt) tt) (h : V1.Ix (MT.tob I tt))
   : Id (V1.Ix (QT.1.tob J tt)) (QT.1.tact J I g tt tt e1 (B0.hv I tt h (c.eob I tt))) (B0.hv J tt (MT.tact J I g tt tt e1 h) (c.eob J tt)) =
   transH (L.tact-irr Nl QT.1 J I g tt tt e1 (refl tt) (B0.hv I tt h (c.eob I tt)))
    (transH (symH (B0.NTh[I, J, g, tt, h, c.eob I tt].law))
      (transH (apH {V1.Ix (MT.tob J tt)} {V1.Ix (QT.1.tob J tt)} (\ h2 -> B0.hv J tt h2 (B0.rsS I J g tt (c.eob I tt))) (L.tact-irr Nl MT J I g tt tt (refl tt) e1 h))
        (apH {V1.Ix (QS.1.tob J tt)} {V1.Ix (QT.1.tob J tt)} (B0.hv J tt (MT.tact J I g tt tt e1 h)) (c.enat J I g tt tt (refl tt))))) ;
  nat (J I : Ob) (g : Hom J I) : (o o' : Top) (e1 : Id (V1.Ix (Nl.ob J)) (Nl.act J I g o) o') (h : V1.Ix (MT.tob I o))
   -> Id (V1.Ix (QT.1.tob J o')) (QT.1.tact J I g o o' e1 (B0.hv I o h (c.eob I o))) (B0.hv J o' (MT.tact J I g o o' e1 h) (c.eob J o')) = split {
   tt -> split { tt -> \ e1 h -> nat1 J I g e1 h } } ;
  evN : HO.NMap[Nl, MT, QT.1] = new HO.NMap[Nl, MT, QT.1, \ I o h -> B0.hv I o h (c.eob I o), \ J I g o o' e1 h -> nat J I g o o' e1 h] ;
 } ;
 -- a closed Id a = b gives evaluation at a ~ evaluation at b
 module Ht (a0 b0 : FCP.fibCwF.El Nl QS) (e : FCP.fibCwF.El Nl (FibId[a, a+].fibId.IdT Nl QS a0 b0)) {
  module EA0 = At[a0] ;
  module EB0 = At[b0] ;
  module T = HO.HT[Nl, MT, QT.1, EA0.evN, EB0.evN] ;
  module TQ = PB.GPre[a+].TyL[Nl, QT.1] ;
  module IY = PosIdY[a, a+].IdY[Nl, QS.1, a0, b0] ;
  uv (W : Ob) (V : Ob) (k : Hom V W) (j : Hom V Iv) : V1.Ix (QS.1.tob V tt) = (e.eob W tt).1.1 V k j ;
  hk (W : Ob) (h : V1.Ix (MT.tob W tt)) (V : Ob) (k : Hom V W) : V1.Ix (MT.tob V tt) = MT.tact V W k tt tt (refl tt) h ;
  tv (W : Ob) (h : V1.Ix (MT.tob W tt)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : TQ.EI V = TQ.pr V tt (B0.hv V tt (hk W h V k) (uv W V k j)) ;
  vn (W : Ob) (h : V1.Ix (MT.tob W tt)) (V' V : Ob) (g0 : Hom V' V) (k : Hom V W) (j : Hom V Iv)
   : Id (V1.Ix (QT.1.tob V' tt)) (QT.1.tact V' V g0 tt tt (refl tt) (B0.hv V tt (hk W h V k) (uv W V k j)))
        (B0.hv V' tt (hk W h V' (compH V' V W k g0)) (uv W V' (compH V' V W k g0) (compH V' V Iv j g0))) =
   transH (symH (B0.NTh[V, V', g0, tt, hk W h V k, uv W V k j].law))
    (transH (apH {V1.Ix (MT.tob V' tt)} {V1.Ix (QT.1.tob V' tt)} (\ h2 -> B0.hv V' tt h2 (B0.rsS V V' g0 tt (uv W V k j)))
        (symH (MT.tact-o V' V W k g0 tt tt tt (refl tt) (refl tt) (refl tt) h)))
      (apH {V1.Ix (QS.1.tob V' tt)} {V1.Ix (QT.1.tob V' tt)} (B0.hv V' tt (hk W h V' (compH V' V W k g0)))
        (transH (L.tact-irr Nl QS.1 V' V g0 tt tt (refl tt) (IY.ptn W tt V' V g0 k) (uv W V k j)) ((e.eob W tt).1.2.1 V' V g0 k j)))) ;
   e0E (W : Ob) (h : V1.Ix (MT.tob W tt)) : Id (TQ.EI W) (tv W h W (idH W) (PB.ptH W PB.e0)) (T.aE W (tt, h)) =
   apH {V1.Ix (QT.1.tob W tt)} {TQ.EI W} (TQ.pr W tt)
    (transH (apH {V1.Ix (MT.tob W tt)} {V1.Ix (QT.1.tob W tt)} (\ h2 -> B0.hv W tt h2 (uv W W (idH W) (PB.ptH W PB.e0))) (MT.tact-id W tt (refl tt) h))
      (apH {V1.Ix (QS.1.tob W tt)} {V1.Ix (QT.1.tob W tt)} (B0.hv W tt h) ((e.eob W tt).1.2.2.1 W (idH W)))) ;
  e1E (W : Ob) (h : V1.Ix (MT.tob W tt)) : Id (TQ.EI W) (tv W h W (idH W) (PB.ptH W PB.e1)) (T.bE W (tt, h)) =
   apH {V1.Ix (QT.1.tob W tt)} {TQ.EI W} (TQ.pr W tt)
    (transH (apH {V1.Ix (MT.tob W tt)} {V1.Ix (QT.1.tob W tt)} (\ h2 -> B0.hv W tt h2 (uv W W (idH W) (PB.ptH W PB.e1))) (MT.tact-id W tt (refl tt) h))
      (apH {V1.Ix (QS.1.tob W tt)} {V1.Ix (QT.1.tob W tt)} (B0.hv W tt h) ((e.eob W tt).1.2.2.2 W (idH W)))) ;
  pathT (W : Ob) : (o : Top) (h : V1.Ix (MT.tob W o)) -> V1.Ix (T.PT.tobP W (o, h)) = split {
   tt -> \ h -> T.PT.mkPath W (tt, h) (tv W h)
     (\ V' V g0 k j -> transH (TQ.pr-tact V' V g0 tt tt (refl tt) (B0.hv V tt (hk W h V k) (uv W V k j)))
        (apH {V1.Ix (QT.1.tob V' tt)} {TQ.EI V'} (TQ.pr V' tt) (vn W h V' V g0 k j)))
     (\ V k j -> refl tt) (e0E W h) (e1E W h) } ;
  path (W : Ob) (z : V1.Ix (T.GA.ob W)) : V1.Ix (T.PT.tobP W z) = pathT W z.1 z.2 ;
  uvN (J I : Ob) (hh : Hom J I) (V : Ob) (f : Hom V J) (i : Hom V Iv) : Id (V1.Ix (QS.1.tob V tt)) (uv I V (compH V J I hh f) i) (uv J V f i) =
   transH (symH (apH {IY.TA.EI V} {V1.Ix (QS.1.tob V tt)} (\ q -> subst Top (\ o2 -> V1.Ix (QS.1.tob V o2)) q.1 tt (isTop q.1 tt) q.2) (IY.Tact[J, I, hh, tt, tt, refl tt, e.eob I tt].rdc V f i)))
    (apH {V1.Ix ((FibId[a, a+].fibId.IdT Nl QS a0 b0).1.tob J tt)} {V1.Ix (QS.1.tob V tt)} (\ w2 -> w2.1.1 V f i) (e.enat J I hh tt tt (refl tt))) ;
  enatT (J I : Ob) (hh : Hom J I) : (o : Top) (h : V1.Ix (MT.tob I o)) (o' : Top) (h' : V1.Ix (MT.tob J o')) (ee : Id (V1.Ix (T.GA.ob J)) (T.GA.act J I hh (o, h)) (o', h'))
   -> Id (V1.Ix (T.PT.tobP J (o', h'))) (T.PT.PathP.tact J I hh (o, h) (o', h') ee (pathT I o h)) (pathT J o' h') = split {
   tt -> \ h -> split { tt -> \ h' ee ->
    T.PT.path-eq J (tt, h') (T.PT.PathP.tact J I hh (tt, h) (tt, h') ee (pathT I tt h)) (pathT J tt h') (\ V f i ->
     apH {V1.Ix (QT.1.tob V tt)} {TQ.EI V} (TQ.pr V tt)
      (transH (apH {V1.Ix (MT.tob V tt)} {V1.Ix (QT.1.tob V tt)} (\ h2 -> B0.hv V tt h2 (uv I V (compH V J I hh f) i))
                 (MT.tact-o V J I hh f tt tt tt (refl tt) (refl tt) (refl tt) h))
        (transH (apH {V1.Ix (T.GA.ob J)} {V1.Ix (QT.1.tob V tt)} (\ z2 -> B0.hv V tt (MT.tact V J f z2.1 tt (isTop (Nl.act V J f z2.1) tt) z2.2) (uv I V (compH V J I hh f) i)) ee)
          (apH {V1.Ix (QS.1.tob V tt)} {V1.Ix (QT.1.tob V tt)} (B0.hv V tt (hk J h' V f)) (uvN J I hh V f i))))) } } ;
  res : L.PEl[T.GA, T.PT.PathP] = new L.PEl[T.GA, T.PT.PathP, path, \ J I hh z z' ee -> enatT J I hh z.1 z.2 z'.1 z'.2 ee] ;
} ;
} ;
