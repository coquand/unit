-- CTotKL.seg (canonicity-c2; SIMPLIFIED.md, KL): the Key Lemma at the
-- total site, part 1: a contraction structure gives a section (the
-- extension of the empty side, natural by uniformity; the restricted
-- empty side is the empty side, side-ext and pre-empty).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module KL0 (C : CIntCat[a, vl].IC) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module GB = TR.G1.GB ;
 module CP = GB.CPartial[l] ;
 module P1 = TR.P1 ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module SC (D : P1.PCtx) (A : P1.PTy[D]) (k : CP.ContrOp D A) {
  module RL = CP.Rel[D, A, A, CP.pmap-id D A] ;
  emp (X : TC.TOb) (x : W0.Ix (D.ob X)) : RL.PS'.Side[X, x] =
   new RL.PS'.Side[X, x, GB.emptyS X, \ W f i -> absurd _ (GB.empty-lands W X f i), \ W f i -> absurd _ (GB.empty-lands W X f i),
     \ W' W chi f i i' -> absurd _ (GB.empty-lands W X f i)] ;
  ob (X : TC.TOb) (x : W0.Ix (D.ob X)) : W0.Ix (A.tob X x) = k.kop X x (emp X x) ;
  rEq (Y X : TC.TOb) (h : TC.THm Y X) (x : W0.Ix (D.ob X)) : Id (RL.PS'.Side[Y, D.act Y X h x]) (RL.PS'.rside Y X h x (emp X x)) (emp Y (D.act Y X h x)) =
   RL.PS'.side-ext Y (D.act Y X h x) (RL.PS'.rside Y X h x (emp X x)) (emp Y (D.act Y X h x)) (GB.pre-empty Y X h)
     (\ W f i i' -> absurd _ (GB.empty-lands W Y f i')) ;
  nat (J I : TC.TOb) (f : TC.THm J I) (x : W0.Ix (D.ob I)) (y : W0.Ix (D.ob J)) (e : Id (W0.Ix (D.ob J)) (D.act J I f x) y)
    : Id (W0.Ix (A.tob J y)) (A.tact J I f x y e (ob I x)) (ob J y) =
   idJ (W0.Ix (D.ob J)) (D.act J I f x) (\ y2 e2 -> Id (W0.Ix (A.tob J y2)) (A.tact J I f x y2 e2 (ob I x)) (ob J y2))
     (P1.pairE-inj D A J (D.act J I f x) (A.tact J I f x (D.act J I f x) (refl (D.act J I f x)) (ob I x)) (ob J (D.act J I f x))
        (transH (k.kunif J I f x (emp I x))
           (apH {RL.PS'.Side[J, D.act J I f x]} {P1.SigT D A J} (\ s -> P1.pairE D A J (D.act J I f x) (k.kop J (D.act J I f x) s)) (rEq J I f x))))
     y e ;
  sec : P1.PEl[D, A] = P1.mkPEl D A ob nat ;
 } ;
} ;

-- KL: a family P over G with a natural map (D P)[tau] -> P and a levelwise
-- contraction of U P over U G has a section over G
module KL (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (P : CTotR[a, vl, l].TotR[C].P1.PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module K0 = KL0[C] ;
 module TR = K0.TR ;
 module TC = K0.TC ;
 module P1 = TR.P1 ;
 module DA = CobarIT[a, vl, l].DTI[C, G, P] ;
 module D = DA.D ;
 module HO = TR.G1.GB.CHtpyOps[l] ;
 GP : P1.PCtx = TC.toP G ;
 DG : P1.PCtx = TC.toP D.DCtx ;
 tS : P1.PSub[GP, DG] = TC.toPS G D.DCtx D.tauS ;
 Bt : P1.PTy[GP] = P1.subTy GP DG DA.DTy tS ;
 module At (rP : HO.NMap[GP, Bt, P]) (al : TR.G0.GB.CPartial[l].ContrOp (TR.RS.rC GP) (TR.RS.rT GP P)) {
  k : TR.G1.GB.CPartial[l].ContrOp DG DA.DTy = CTotL12n[a, vl, l].L12n[C, G, P].lemma12 al ;
  sD : P1.PEl[DG, DA.DTy] = K0.SC[DG, DA.DTy, k].sec ;
  sT : P1.PEl[GP, Bt] = P1.subEl GP DG DA.DTy sD tS ;
  ob (X : TC.TOb) (g : W0.Ix (GP.ob X)) : W0.Ix (P.tob X g) = rP.nfun X g (sT.eob X g) ;
  nat (Y X : TC.TOb) (f : TC.THm Y X) (g : W0.Ix (GP.ob X)) (g' : W0.Ix (GP.ob Y)) (e : Id (W0.Ix (GP.ob Y)) (GP.act Y X f g) g')
    : Id (W0.Ix (P.tob Y g')) (P.tact Y X f g g' e (ob X g)) (ob Y g') =
   transH (rP.nnat Y X f g g' e (sT.eob X g)) (apH {W0.Ix (Bt.tob Y g')} {W0.Ix (P.tob Y g')} (rP.nfun Y g') (sT.enat Y X f g g' e)) ;
  sec : P1.PEl[GP, P] = P1.mkPEl GP P ob nat ;
 } ;
} ;
