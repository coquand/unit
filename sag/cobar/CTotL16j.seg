-- CTotL16j.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, SPECIFIC TO OUR C: MW at two weight families agreeing at every
-- index is the same element (MWEq); the bridge mN2 (MW at cat j' i) as a
-- natural map DAC -> B2; the ends t = 1 of the lines p (meet on the left
-- block) and q (meet on the right block) are mN2 (catMeet1L / 1R).
-- No new axioms beyond the named premises (fe).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a+] ;
module VA = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, a+] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

WfT : U a = (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J ;
WresT (Wf : WfT) : U a = (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J)
  -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
       (Wf m n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)) ;
WfaceRT (Wf : WfT) : U a = (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
  -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
       (CTotL16b[a, a+, a+].substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
       (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face) ;
WfaceLT (Wf : WfT) : U a = (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
  -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
       (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face) ;
module WB = CTotL16b[a, a+, a+] ;
module L14 = CTotL14f[a, a+, a+] ;

module RJ (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module RG = CTotL16g[a].RG[R, encK, pe] ;
 module RH = CTotL16h[a].RH[R, encK, pe] ;
 module RI = CTotL16i[a].RI[R, encK, pe] ;
 IC : CIntCat[a, a+].IC = RG.IC ;
 module VT = RG.VT ;
 Obj (I : Ob) : U a+ = VT.Obj I ;
 module F (G : CTPsh[a, a+, a+].TPshOf[IC].TCtx) (A : Presheaf[a+, a+].Psh[CTotCat[a, a+, a+].TotOf[IC].TotCat].PTy[CTotCat[a, a+, a+].TotOf[IC].toP G]) {
  module Oc = RG.Out[G, A, WB.WfCat, WB.WresCat, WB.WfaceRCat, WB.WfaceLCat] ;
  module LB = Oc.LB ;
  module DA = Oc.DA ;
  module D = Oc.D ;
  module D2 = Oc.D2 ;
  module L16a = Oc.L16a ;
  module HO1 = L16a.HO1 ;
  GP : LB.P.PCtx = Oc.GP ;
  DAC : LB.P.PTy[GP] = L16a.DAC ;
  B2 : LB.P.PTy[GP] = L16a.B2 ;
  -- MW at two weight families agreeing at every index
  module MWEq (Wf : WfT) (Wres : WresT Wf) (WfaceR : WfaceRT Wf) (WfaceL : WfaceLT Wf)
   (Vf : WfT) (Vres : WresT Vf) (VfaceR : WfaceRT Vf) (VfaceL : WfaceLT Vf)
   (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) (t t' : Hom I PFO.ivO)
   (Hw : (q' : DA.Idx I x) (l' : DA.LandsI I x q') (q : DA.Idx q'.2.1 q'.2.2.2.1) (li : DA.LandsI q'.2.1 q'.2.2.2.1 q)
      -> Id (Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.1) (CTotL16d[a, a+, a+].L16d[IC, G, A, Wf].Inner[I, x, g, u, t, q', l', q, li].w)
           (CTotL16d[a, a+, a+].L16d[IC, G, A, Vf].Inner[I, x, g, u, t', q', l', q, li].w)) {
   module O1 = RG.Out[G, A, Wf, Wres, WfaceR, WfaceL] ;
   module O2 = RG.Out[G, A, Vf, Vres, VfaceR, VfaceL] ;
   module M1 = O1.MW[I, x, g, u, t] ;
   module M2 = O2.MW[I, x, g, u, t'] ;
   module At (q' : DA.Idx I x) (l' : DA.LandsI I x q') {
    module HQ (q : DA.Idx q'.2.1 q'.2.2.2.1) (li : DA.LandsI q'.2.1 q'.2.2.2.1 q) {
     module S1 = O1.LD.Inner[I, x, g, u, t, q', l', q, li] ;
     module S2 = O2.LD.Inner[I, x, g, u, t', q', l', q, li] ;
     eq : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (M1.InO[q', l'].M.OFm.tgy.1 q li) (M1.InO[q', l'].M.ires.1 q li))
             (DA.prz q.2.1 q.2.2.2.1 (M2.InO[q', l'].M.OFm.tgy.1 q li) (M2.InO[q', l'].M.ires.1 q li)) =
      transH S1.pc (transH (apH (M1.RDm.rd (Ar.plus q'.1 (suc q.1)) q.2.1 S1.gg q.2.2.2.1 S1.cc) (Hw q' l' q li)) (symH S2.pc)) ;
    } ;
    eq : Id (D2.Ez q'.2.1 q'.2.2.2.1) (D2.prz q'.2.1 q'.2.2.2.1 (M1.tg.1 q' l') (M1.ov q' l')) (D2.prz q'.2.1 q'.2.2.2.1 (M1.tg.1 q' l') (M2.ov q' l')) =
     O1.totEq q'.2.1 q'.2.2.2.1 (M1.tg.1 q' l') (M1.tg.1 q' l') (refl (M1.tg.1 q' l')) (M1.ov q' l') (M2.ov q' l') (\ q li -> HQ[q, li].eq) ;
   } ;
   eq : Id (W0.Ix (B2.tob (I, x) g)) M1.res M2.res =
    D2.tob-eq I x M1.tg M1.res M2.res (\ q' l' -> D2.pr-inj q'.2.1 q'.2.2.2.1 (M1.tg.1 q' l') (M1.ov q' l') (M2.ov q' l') At[q', l'].eq) ;
  } ;
  -- the bridge: MW at cat j' i (independent of t), natural
  module Nc = RH.Nat[G, A, WB.WfCat, WB.WresCat, WB.WfaceRCat, WB.WfaceLCat] ;
  mN2 : HO1.NMap[GP, DAC, B2] =
   new HO1.NMap[GP, DAC, B2, \ X g u -> Oc.MW[X.1, X.2, g, u, PB.ptH X.1 PB.e1].res,
    \ Y X h g g' e u ->
     transH (Nc.At0[Y.1, X.1, h.1, Y.2, X.2, h.2, g, g', e, u, PB.ptH X.1 PB.e1].nat)
      (MWEq[WB.WfCat, WB.WresCat, WB.WfaceRCat, WB.WfaceLCat, WB.WfCat, WB.WresCat, WB.WfaceRCat, WB.WfaceLCat, Y.1, Y.2, g', DAC.tact Y X h g g' e u, PB.compH Y.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) h.1, PB.ptH Y.1 PB.e1,
         \ q' l' q li -> refl (CTotL16d[a, a+, a+].L16d[IC, G, A, WB.WfCat].Inner[Y.1, Y.2, g', DAC.tact Y X h g g' e u, PB.compH Y.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) h.1, q', l', q, li].w)].eq)] ;
  module Lp = RI.Ln[G, A, WB.WfML, WB.WresML, WB.WfaceRML, WB.WfaceLML] ;
  module Lq = RI.Ln[G, A, WB.WfMR, WB.WresMR, WB.WfaceRMR, WB.WfaceLMR] ;
  module TZ = Lp.TZ ;
  module TX = Lp.TX ;
  -- the ends t = 1: both lines end at the bridge
  module E1 (X : LB.TC.TOb) (z : TZ.EI X) {
   gm : W0.Ix (G.ob X.1 X.2) = TZ.pr1 X z ;
   u : DA.TOb' X.1 X.2 (D.tau X.1 X.2 (TZ.pr1 X z)) = TZ.pr2 X z ;
   hwp (q' : DA.Idx X.1 X.2) (l' : DA.LandsI X.1 X.2 q') (q : DA.Idx q'.2.1 q'.2.2.2.1) (li : DA.LandsI q'.2.1 q'.2.2.2.1 q)
    : Id (Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.1) (CTotL16d[a, a+, a+].L16d[IC, G, A, WB.WfML].Inner[X.1, X.2, gm, u, PB.ptH X.1 PB.e1, q', l', q, li].w)
         (CTotL16d[a, a+, a+].L16d[IC, G, A, WB.WfCat].Inner[X.1, X.2, gm, u, PB.ptH X.1 PB.e1, q', l', q, li].w) =
    L14.pnEq (Ar.plus q'.1 (suc q.1)) q.2.1 _ _ (\ k ->
     transH (apH (\ jj -> Wt.catC q'.1 q.1 q.2.1 jj q.2.2.2.2.2 k)
               (L14.coEq q'.1 q.2.1 (Wt.meetC q'.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) (compH q.2.1 q'.2.1 X.1 q'.2.2.1 q.2.2.1)) (Wt.resC q'.1 q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.2.2))
                  (Wt.meetC q'.1 q.2.1 (PB.ptH q.2.1 PB.e1) (Wt.resC q'.1 q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.2.2))
                  (\ k2 -> apH (\ jj -> Wt.meetC q'.1 q.2.1 jj (Wt.resC q'.1 q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.2.2) k2)
                              (PB.ptH-nat q.2.1 X.1 (compH q.2.1 q'.2.1 X.1 q'.2.2.1 q.2.2.1) PB.e1))))
      (Wt.catMeet1L q'.1 q.1 q.2.1 (Wt.resC q'.1 q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.2.2) q.2.2.2.2.2 k)) ;
   hwq (q' : DA.Idx X.1 X.2) (l' : DA.LandsI X.1 X.2 q') (q : DA.Idx q'.2.1 q'.2.2.2.1) (li : DA.LandsI q'.2.1 q'.2.2.2.1 q)
    : Id (Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.1) (CTotL16d[a, a+, a+].L16d[IC, G, A, WB.WfMR].Inner[X.1, X.2, gm, u, PB.ptH X.1 PB.e1, q', l', q, li].w)
         (CTotL16d[a, a+, a+].L16d[IC, G, A, WB.WfCat].Inner[X.1, X.2, gm, u, PB.ptH X.1 PB.e1, q', l', q, li].w) =
    L14.pnEq (Ar.plus q'.1 (suc q.1)) q.2.1 _ _ (\ k ->
     transH (apH (\ ii -> Wt.catC q'.1 q.1 q.2.1 (Wt.resC q'.1 q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.2.2) ii k)
               (L14.coEq q.1 q.2.1 (Wt.meetC q.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) (compH q.2.1 q'.2.1 X.1 q'.2.2.1 q.2.2.1)) q.2.2.2.2.2)
                  (Wt.meetC q.1 q.2.1 (PB.ptH q.2.1 PB.e1) q.2.2.2.2.2)
                  (\ k2 -> apH (\ jj -> Wt.meetC q.1 q.2.1 jj q.2.2.2.2.2 k2) (PB.ptH-nat q.2.1 X.1 (compH q.2.1 q'.2.1 X.1 q'.2.2.1 q.2.2.1) PB.e1))))
      (Wt.catMeet1R q'.1 q.1 q.2.1 (Wt.resC q'.1 q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.2.2) q.2.2.2.2.2 k)) ;
   p1 : Id (TX.EI X) (Lp.mwe X z (PB.ptH X.1 PB.e1)) (HO1.HT[GP, DAC, B2, L16a.tauD, mN2].bE X z) =
    apH (TX.pr X gm) (MWEq[WB.WfML, WB.WresML, WB.WfaceRML, WB.WfaceLML, WB.WfCat, WB.WresCat, WB.WfaceRCat, WB.WfaceLCat, X.1, X.2, gm, u, PB.ptH X.1 PB.e1, PB.ptH X.1 PB.e1, hwp].eq) ;
   q1 : Id (TX.EI X) (Lq.mwe X z (PB.ptH X.1 PB.e1)) (HO1.HT[GP, DAC, B2, L16a.dTau, mN2].bE X z) =
    apH (TX.pr X gm) (MWEq[WB.WfMR, WB.WresMR, WB.WfaceRMR, WB.WfaceLMR, WB.WfCat, WB.WresCat, WB.WfaceRCat, WB.WfaceLCat, X.1, X.2, gm, u, PB.ptH X.1 PB.e1, PB.ptH X.1 PB.e1, hwq].eq) ;
  } ;
 } ;
} ;
