-- CPshIdJc.seg (part 3 of the Id instance, canonicity-45): the map of
-- motive contexts upS of the record (SwanId.Der.upS, a transport of the
-- lift along IKnat) at x is the base's (FibIdCen.DR.upS): both are the
-- base's lift with the second component coerced along one path of codes
-- (FibIdRd.subTr on both sides with the same path), after the transport
-- of a C-substitution along a path of C-types is read at x (subTrC).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module FBC = FibCwF[a, l] ;
module FIC = FibIdCen[a, l] ;
module RD = FibIdRd[a, l] ;

module IdJcOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 open P ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;
 module DRC = JA.DRC ;
 module DRB = JA.DRB ;
 As (G : CCtx) (A : STy G) (x : CO) : FBC.FC.STy (G.ob x) = JA.As G A x ;

 -- a transport of a C-substitution along a path of C-types, read at x
 subTrC (E Z : CCtx) (B B' : CTy[E]) (Pf : Id (CTy[E]) B B') (u : CSub[LO.ExtC E B, Z]) (x : CO)
  : Id (PSub[(LO.ExtC E B').ob x, Z.ob x])
      ((subst (CTy[E]) (\ X -> CSub[LO.ExtC E X, Z]) B B' Pf u).sb x)
      (subst (PTy[E.ob x]) (\ T -> PSub[extP (E.ob x) T, Z.ob x]) (B.ty x) (B'.ty x) (apH (\ X -> X.ty x) Pf) (u.sb x)) =
  idJ (CTy[E]) B (\ B2 P2 -> Id (PSub[(LO.ExtC E B2).ob x, Z.ob x])
                     ((subst (CTy[E]) (\ X -> CSub[LO.ExtC E X, Z]) B B2 P2 u).sb x)
                     (subst (PTy[E.ob x]) (\ T -> PSub[extP (E.ob x) T, Z.ob x]) (B.ty x) (B2.ty x) (apH (\ X -> X.ty x) P2) (u.sb x)))
   (refl (u.sb x)) B' Pf ;

 module UpE (D G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (s : CSub[D, G]) (x : CO) {
  Dx' : PCtx = D.ob x ;
  Gx : PCtx = G.ob x ;
  Ax : FBC.FC.STy Gx = As G A x ;
  ax : PEl[Gx, A.1.ty x] = a0.el x ;
  sx : PSub[Dx', Gx] = s.sb x ;
  -- the C-level data
  As' : STy D = UF.FCC.subS D G A s ;
  a' : CEl[D, As'.1] = CW.subCEl D G A.1 a0 s ;
  E : CCtx = LO.ExtC D As'.1 ;
  IKl : STy E = UF.FCC.subS E (LO.ExtC G A.1) (DRC.IK G A a0) (CW.liftC D G A.1 s) ;
  IKd : STy E = DRC.IK D As' a' ;
  Zc : CCtx = DRC.Dx G A a0 ;
  lC : CSub[LO.ExtC E IKl.1, Zc] = CW.liftC E (LO.ExtC G A.1) (DRC.IK G A a0).1 (CW.liftC D G A.1 s) ;
  -- the base's data at x
  Ex : PCtx = E.ob x ;
  Zx : PCtx = DRB.Dx Gx Ax ax ;
  IKlB : FBC.FC.STy Ex = FBC.FC.subS Ex (extP Gx (A.1.ty x)) (DRB.IK Gx Ax ax) (liftP Dx' Gx (A.1.ty x) sx) ;
  IKdB : FBC.FC.STy Ex = DRB.IK Dx' (FBC.FC.subS Dx' Gx Ax sx) (subEl Dx' Gx (A.1.ty x) ax sx) ;
  lB : PSub[extP Ex IKlB.1, Zx] = liftP Ex (extP Gx (A.1.ty x)) (DRB.IK Gx Ax ax).1 (liftP Dx' Gx (A.1.ty x) sx) ;
  -- the C-level upS, as a transport over CTy, read at x
  PCt : Id (CTy[E]) IKl.1 IKd.1 = apH (\ Z -> Z.1) (DRC.IKnat D G A a0 s) ;
  PCx : Id (PTy[Ex]) (IKl.1.ty x) (IKd.1.ty x) = apH (\ X -> X.ty x) PCt ;
  upC : Id (CSub[LO.ExtC E IKd.1, Zc]) (DRC.upS D G A a0 s) (subst (CTy[E]) (\ X -> CSub[LO.ExtC E X, Zc]) IKl.1 IKd.1 PCt lC) =
   subst-ap (STy E) (CTy[E]) (\ Z -> Z.1) (\ X -> CSub[LO.ExtC E X, Zc]) IKl IKd (DRC.IKnat D G A a0 s) lC ;
  opaque upC ;
  -- the C-level objects at x, coerced once into the base's spelling
  lCB : PSub[extP Ex IKlB.1, Zx] = lC.sb x ;
  PCxB : Id (PTy[Ex]) IKlB.1 IKdB.1 = PCx ;
  upCY : PSub[extP Ex IKdB.1, Zx] = (DRC.upS D G A a0 s).sb x ;
  -- the C-level upS at x is the transport of the lift, in the base's spelling
  upC' : Id (PSub[extP Ex IKdB.1, Zx]) upCY (subst (PTy[Ex]) (\ T -> PSub[extP Ex T, Zx]) IKlB.1 IKdB.1 PCxB lCB) =
   transH (apH (\ t -> t.sb x) upC) (subTrC E Zc IKl.1 IKd.1 PCt lC x) ;
  opaque upC' ;
 } ;
} ;
