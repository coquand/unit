-- CCop.seg (canonicity-45; COBAR.md "comparison"): the pairing of codes
-- at a copy y' (CE1Fin's cop and its two sections): pair two codes
-- F1 -> y' into HomT(F1, y')^2 by alpha, apply c2's inverse cop of cmpI
-- (CCmpK30), back to codes F2 -> y' by beta; its sections from c2's
-- cmpI (cop g) = g (CCmpK32, read by IdRd), cmpI's components being alpha
-- of the precompositions (CPreI).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module CP (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) (y' : SX.Over[R].Presentation) {
 module E = CE1Copy[a].E1C[R, encK, pe, al, eqal, commH, y'] ;
 module HO = E.HO ;
 Nl : L.PCtx = E.Nl ;
 module RD = CRead[a].RD[R, encK, pe, y'] ;
 module A2 = CReadA[a].AN[R, encK, pe, E.CM.F2, y'] ;
 module CI = CPreI[a].PreOf[R, encK, pe].CmpI[y'] ;
 HT : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = CI.HT ;
 HS : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = CI.HS ;
 HTT : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = CI.HTT ;
 -- beta for codes F2 -> y', at any terminal point
 module TM2 = CHomT8[a].ToM[R, encK, pe, E.CM.F2, y'] ;
 bt2 (I : Ob) : (o : Top) -> V1.Ix (HS.1.tob I o) -> V1.Ix (E.A2c.tob I o) = split { tt -> \ z -> TM2.beta I z } ;
 bnat2 (J I : Ob) (h : Hom J I) (z : V1.Ix (HS.1.tob I tt))
  : Id (V1.Ix (E.A2c.tob J tt)) (E.A2c.tact J I h tt tt (refl tt) (TM2.beta I z)) (TM2.beta J (HS.1.tact J I h tt tt (refl tt) z)) =
  transH (A2.resE J I h (TM2.beta I z))
   (transH (symH (CHomT12[a].RT1[R, encK, pe, E.CM.F2, y'].At[J, A2.FF.res I J h (TM2.beta I z)].rt))
     (apH {V1.Ix (HS.1.tob J tt)} {V1.Ix (E.A2c.tob J tt)} (TM2.beta J)
       (transH (A2.NN.aNat I J h (TM2.beta I z))
         (apH {V1.Ix (HS.1.tob I tt)} {V1.Ix (HS.1.tob J tt)} (\ u -> HS.1.tact J I h tt tt (refl tt) u) (CHomT13[a].RT2[R, encK, pe, E.CM.F2, y'].At[I, z].rt))))) ;
 bnat2g (J I : Ob) (h : Hom J I) : (x : Top) (x' : Top) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h x) x') (z : V1.Ix (HS.1.tob I x))
  -> Id (V1.Ix (E.A2c.tob J x')) (E.A2c.tact J I h x x' e (bt2 I x z)) (bt2 J x' (HS.1.tact J I h x x' e z)) = split {
  tt -> split { tt -> \ e z -> transH (bnat2 J I h z) (apH {V1.Ix (HS.1.tob J tt)} {V1.Ix (E.A2c.tob J tt)} (TM2.beta J) (L.tact-irr Nl HS.1 J I h tt tt (refl tt) e z)) } } ;
 betaN2 : HO.NMap[Nl, HS.1, E.A2c] = new HO.NMap[Nl, HS.1, E.A2c, bt2, \ J I h x x' e z -> bnat2g J I h x x' e z] ;
 -- pairs in HomT(F1, y')^2
 pr1N : HO.NMap[Nl, HTT.1, HT.1] = new HO.NMap[Nl, HTT.1, HT.1, \ I o p -> p.1, \ J I h x x' e p -> refl (HT.1.tact J I h x x' e p.1)] ;
 module Pair (X : L.PTy[Nl]) (g1 g2 : HO.NMap[Nl, X, HT.1]) {
  pv (I : Ob) (o : Top) (w : V1.Ix (X.tob I o)) : V1.Ix (HTT.1.tob I o) = (g1.nfun I o w, g2.nfun I o w) ;
  pn (J I : Ob) (h : Hom J I) : (x : Top) (x' : Top) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h x) x') (w : V1.Ix (X.tob I x))
   -> Id (V1.Ix (HTT.1.tob J x')) (HTT.1.tact J I h x x' e (pv I x w)) (pv J x' (X.tact J I h x x' e w)) = split {
   tt -> split { tt -> \ e w ->
    transH (CI.actP J I h e (g1.nfun I tt w) (g2.nfun I tt w))
     (transH (apH {V1.Ix (HT.1.tob J tt)} {V1.Ix (HTT.1.tob J tt)} (\ c -> (c, HT.1.tact J I h tt tt (CI.wkP J I h e (g1.nfun I tt w)) (g2.nfun I tt w))) (g1.nnat J I h tt tt e w))
       (apH {V1.Ix (HT.1.tob J tt)} {V1.Ix (HTT.1.tob J tt)} (\ c -> (g1.nfun J tt (X.tact J I h tt tt e w), c))
         (transH (L.tact-irr Nl HT.1 J I h tt tt (CI.wkP J I h e (g1.nfun I tt w)) e (g2.nfun I tt w)) (g2.nnat J I h tt tt e w)))) } } ;
  pN : HO.NMap[Nl, X, HTT.1] = new HO.NMap[Nl, X, HTT.1, pv, \ J I h x x' e w -> pn J I h x x' e w] ;
 } ;
 pr2N : HO.NMap[Nl, HTT.1, HT.1] = new HO.NMap[Nl, HTT.1, HT.1, \ I o p -> p.2,
  \ J I h x x' e p -> (L.tact-irr Nl HT.1 J I h x x' e (L.ntEq (L.extP Nl HT.1) Nl (L.pP Nl HT.1) J I h (x, p.1) (x', HT.1.tact J I h x x' e p.1) (L.pair-act Nl HT.1 J I h x x' e p.1)) p.2)] ;
 -- cmpI's components at beta z are alpha of the code precompositions
 c1 (I : Ob) : (o : Top) (z : V1.Ix (HS.1.tob I o)) -> Id (V1.Ix (HT.1.tob I o)) (CI.nmap.nfun I o z).1 (RD.at I o (E.p1c.nfun I o (bt2 I o z))) = split {
  tt -> \ z -> refl (CI.nmap.nfun I tt z).1 } ;
 c2 (I : Ob) : (o : Top) (z : V1.Ix (HS.1.tob I o)) -> Id (V1.Ix (HT.1.tob I o)) (CI.nmap.nfun I o z).2 (RD.at I o (E.p2c.nfun I o (bt2 I o z))) = split {
  tt -> \ z -> refl (CI.nmap.nfun I tt z).2 } ;
 -- the pairing of codes and its sections, from c2's cop and cmpI (cop g) ~ g
 module Sec (copN : HO.NMap[Nl, HTT.1, HS.1])
   (sR : L.PEl[L.extP Nl HTT.1, HO.HT[Nl, HTT.1, HTT.1, HO.compN Nl HTT.1 HS.1 HTT.1 copN CI.nmap, HO.idN Nl HTT.1].PT.PathP]) {
  module PP (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, E.Ac]) {
   module PA = Pair[X, HO.compN Nl X E.Ac HT.1 f1 RD.alphaN, HO.compN Nl X E.Ac HT.1 f2 RD.alphaN] ;
   ch : HO.NMap[Nl, X, HS.1] = HO.compN Nl X HTT.1 HS.1 PA.pN copN ;
   cop : HO.NMap[Nl, X, E.A2c] = HO.compN Nl X HS.1 E.A2c ch betaN2 ;
   module W1 = HO.WR[Nl, HTT.1, HTT.1, X, HO.compN Nl HTT.1 HS.1 HTT.1 copN CI.nmap, HO.idN Nl HTT.1, PA.pN, sR] ;
   module Side (pr : HO.NMap[Nl, HTT.1, HT.1]) (pc : HO.NMap[Nl, E.A2c, E.Ac]) (fk : HO.NMap[Nl, X, E.Ac])
     (ck : (I : Ob) (o : Top) (z : V1.Ix (HS.1.tob I o)) -> Id (V1.Ix (HT.1.tob I o)) (pr.nfun I o (CI.nmap.nfun I o z)) (RD.at I o (pc.nfun I o (bt2 I o z))))
     (fq : (I : Ob) (o : Top) (w : V1.Ix (X.tob I o)) -> Id (V1.Ix (HT.1.tob I o)) (pr.nfun I o (PA.pv I o w)) (RD.at I o (fk.nfun I o w))) {
    module W2 = HO.WL[Nl, X, HTT.1, HT.1, HO.compN Nl X HTT.1 HTT.1 PA.pN (HO.compN Nl HTT.1 HS.1 HTT.1 copN CI.nmap), HO.compN Nl X HTT.1 HTT.1 PA.pN (HO.idN Nl HTT.1), pr, W1.res] ;
    lk : HO.NMap[Nl, X, E.Ac] = HO.compN Nl X E.A2c E.Ac cop pc ;
    module R2 = HO.Ret[Nl, X, HT.1, HO.compN Nl X HTT.1 HT.1 (HO.compN Nl X HTT.1 HTT.1 PA.pN (HO.compN Nl HTT.1 HS.1 HTT.1 copN CI.nmap)) pr,
      HO.compN Nl X HTT.1 HT.1 (HO.compN Nl X HTT.1 HTT.1 PA.pN (HO.idN Nl HTT.1)) pr,
      HO.compN Nl X E.Ac HT.1 lk RD.alphaN, HO.compN Nl X E.Ac HT.1 fk RD.alphaN,
      \ I x w -> symH (ck I x (ch.nfun I x w)), \ I x w -> symH (fq I x w), W2.res] ;
    module W3 = HO.WL[Nl, X, HT.1, E.Ac, HO.compN Nl X E.Ac HT.1 lk RD.alphaN, HO.compN Nl X E.Ac HT.1 fk RD.alphaN, RD.PH.betaN, R2.res] ;
    module R3 = HO.Ret[Nl, X, E.Ac, HO.compN Nl X HT.1 E.Ac (HO.compN Nl X E.Ac HT.1 lk RD.alphaN) RD.PH.betaN, HO.compN Nl X HT.1 E.Ac (HO.compN Nl X E.Ac HT.1 fk RD.alphaN) RD.PH.betaN,
      lk, fk, \ I x w -> RD.ba I x (lk.nfun I x w), \ I x w -> RD.ba I x (fk.nfun I x w), W3.res] ;
    res : L.PEl[L.extP Nl X, HO.HT[Nl, X, E.Ac, lk, fk].PT.PathP] = R3.res ;
   } ;
   sec1 : L.PEl[L.extP Nl X, HO.HT[Nl, X, E.Ac, HO.compN Nl X E.A2c E.Ac cop E.p1c, f1].PT.PathP] =
    Side[pr1N, E.p1c, f1, c1, \ I o w -> refl (RD.at I o (f1.nfun I o w))].res ;
   sec2 : L.PEl[L.extP Nl X, HO.HT[Nl, X, E.Ac, HO.compN Nl X E.A2c E.Ac cop E.p2c, f2].PT.PathP] =
    Side[pr2N, E.p2c, f2, c2, \ I o w -> refl (RD.at I o (f2.nfun I o w))].res ;
  } ;
 } ;
 -- c2's (K) for pairs: cop, and cmpI (cop g) = g
 module K30 = CCmpK30[a].K30[R, encK, pe, y'] ;
 module K32 = CCmpK32[a].K32[R, encK, pe, y'] ;
 copN : HO.NMap[Nl, HTT.1, HS.1] = EqQinv[a, a+].NM[Nl, HTT, HS, K30.cop].nm ;
 module SRd = CContrEq[a, a+].IdRd[Nl, HTT, HO.compN Nl HTT.1 HS.1 HTT.1 copN CI.nmap, K32.t2, \ W z -> K32.t2v W z, K32.secR] ;
 module SC = Sec[copN, SRd.res] ;
} ;
