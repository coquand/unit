-- CDIn1.seg (canonicity-c2; (d)(2), part 1): fwd as a natural map
-- HomT(x.u, y) -> T0 (the points of its body t0 over nil.HomT(x.u, y)), its
-- value as an element (evS) read as fwd's body, and the context nil.H of pairs
-- with the same image (CInjP.IP).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module In1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F8 = CDFw8[a].Fw8[R, encK, pe, x, u, y] ;
 module F1 = F8.F1 ;
 Nl : C.Ctx = C.nil ;
 HU : C.Ty Nl = F8.HU ;
 T0 : C.Ty Nl = F8.T0 ;
 D1 : C.Ctx = F8.D1 ;
 nf (K : Ob) (o : Top) (z : V1.Ix (HU.1.tob K o)) : V1.Ix (T0.1.tob K o) = F8.t0.eob K (o, z) ;
 nn (J I : Ob) (f : Hom J I) (o o' : Top) (e : Id Top (Nl.act J I f o) o') (z : V1.Ix (HU.1.tob I o))
   : Id (V1.Ix (T0.1.tob J o')) (T0.1.tact J I f o o' e (nf I o z)) (nf J o' (HU.1.tact J I f o o' e z)) =
  transH (L.tact-irr Nl T0.1 J I f o o' e
           (L.ntEq D1 Nl (L.pP Nl HU.1) J I f (o, z) (o', HU.1.tact J I f o o' e z) (L.pair-act Nl HU.1 J I f o o' e z)) (nf I o z))
   (F8.t0.enat J I f (o, z) (o', HU.1.tact J I f o o' e z) (L.pair-act Nl HU.1 J I f o o' e z)) ;
 fwdN : HO.NMap[Nl, HU.1, T0.1] = new HO.NMap[Nl, HU.1, T0.1, nf, nn] ;
 module IPm = CInjP[a].IP[HU, T0, fwdN] ;
} ;
