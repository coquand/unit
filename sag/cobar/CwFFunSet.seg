-- CwFFunSet.seg (canonicity-c2; SIMPLIFIED.md item 3, for elim2): a
-- function type into a set is a set, in a CwF with Pi, Sigma, Swan Id, a
-- universe and naive funext NF.  Hedberg (CwFHed4) at x : A -> B with
-- R(y) = Pi (a : A) Id(x a , y a): a proposition (B a set: idPB), rho the
-- pointwise refl, f : R -> Id(x , y) by NF.
open Base ;

module FunSet (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module PPp = CwFPropProp.PropProp[l, C, PS, SS, IJ, Un, NF] ;
  module EG2 = CwFElimG2.ElimG2[l, C, PS, SS, IJ, Un, NF] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module EG5 = CwFElimG5.ElimG5[l, C, PS, SS, IJ, Un, NF] ;
  module H4 = CwFHed4.Hed4[l, C, PS, SS, IJ] ;

  -- B a set, at every context over G
  IdPB (G : Ctx) (B : Ty G) : U l = (E : Ctx) (sE : Sub E G) (u v : El E (subT E G B sE)) -> El E (PU.isProp E (IJ.IdT E (subT E G B sE) u v)) ;
  -- read along a type path
  idPBAt (G : Ctx) (B : Ty G) (idPB : IdPB G B) (E : Ctx) (sE : Sub E G) (Y : Ty E) (PY : Id (Ty E) (subT E G B sE) Y) (u v : El E Y)
    : El E (PU.isProp E (IJ.IdT E Y u v)) =
    idJ (Ty E) (subT E G B sE) (\ Y2 P2 -> (u2 v2 : El E Y2) -> El E (PU.isProp E (IJ.IdT E Y2 u2 v2))) (\ u2 v2 -> idPB E sE u2 v2) Y PY u v ;

  module SX (G : Ctx) (A B : Ty G) (idPB : IdPB G B) (x : El G (Fun G A B)) {
    X : Ty G = Fun G A B ;
    GX : Ctx = ext G X ;
    A1 : Ty GX = wkT G X A ;
    B1 : Ty GX = wkT G X B ;
    PF1 : Id (Ty GX) (wkT G X X) (Fun GX A1 B1) = Fun-ov GX G A B (p G X) A1 (refl A1) B1 (refl B1) ;
    xw : El GX (Fun GX A1 B1) = trE GX (wkT G X X) (Fun GX A1 B1) PF1 (wkE G X X x) ;
    yv : El GX (Fun GX A1 B1) = trE GX (wkT G X X) (Fun GX A1 B1) PF1 (q G X) ;
    E1 : Ctx = ext GX A1 ;
    WB1 : Ty E1 = wkT GX A1 B1 ;
    I1 : Ty E1 = IJ.IdT E1 WB1 (bod GX A1 WB1 xw) (bod GX A1 WB1 yv) ;
    R : Ty GX = PS.Pi GX A1 I1 ;
    sE1 : Sub E1 G = o E1 GX G (p G X) (p GX A1) ;
    PB1 : Id (Ty E1) (subT E1 G B sE1) WB1 = subT-o E1 GX G B (p G X) (p GX A1) ;
    pR : El GX (PU.isProp GX R) =
      PPp.piProp GX A1 I1 (idPBAt G B idPB E1 sE1 WB1 PB1 (bod GX A1 WB1 xw) (bod GX A1 WB1 yv)) ;
    -- rho: R at x is Pi a. Id(x a , x a)
    sx : Sub G GX = sec G X x ;
    PA : Id (Ty G) (subT G GX A1 sx) A = p-sec-T G X A x ;
    WB0 : Ty (ext G A) = wkT G A B ;
    PWB : Id (Ty (ext G A)) (subT (ext G A) E1 WB1 (upT G GX A1 sx A PA)) WB0 = wkT-ov G GX A1 B1 sx A PA B (p-sec-T G X B x) ;
    PFx : Id (Ty G) (subT G GX (Fun GX A1 B1) sx) X = Fun-ov G GX A1 B1 sx A PA B (p-sec-T G X B x) ;
    oxw : Ov G GX (Fun GX A1 B1) sx X PFx xw x =
      ovTr G GX (wkT G X X) (Fun GX A1 B1) PF1 sx X X (refl X) (p-sec-T G X X x) PFx (wkE G X X x) x (IN.wkE-sec G X X x x (p-sec-T G X X x)) ;
    oyv : Ov G GX (Fun GX A1 B1) sx X PFx yv x =
      ovTr G GX (wkT G X X) (Fun GX A1 B1) PF1 sx X X (refl X) (p-sec-T G X X x) PFx (q G X) x (IN.q-secO G X x (p-sec-T G X X x)) ;
    I0 : Ty (ext G A) = IJ.IdT (ext G A) WB0 (bod G A WB0 x) (bod G A WB0 x) ;
    PI : Id (Ty (ext G A)) (subT (ext G A) E1 I1 (upT G GX A1 sx A PA)) I0 =
      Id-ov (ext G A) E1 WB1 (bod GX A1 WB1 xw) (bod GX A1 WB1 yv) (upT G GX A1 sx A PA) WB0 PWB (bod G A WB0 x) (bod G A WB0 x)
        (EG2.bodOv G GX A1 WB1 sx A PA WB0 PWB PFx xw x oxw) (EG2.bodOv G GX A1 WB1 sx A PA WB0 PWB PFx yv x oyv) ;
    PR : Id (Ty G) (subT G GX R sx) (PS.Pi G A I0) = Pi-ov G GX A1 I1 sx A PA I0 PI ;
    rho : El G (subT G GX R sx) =
      trE G (PS.Pi G A I0) (subT G GX R sx) (sym (Ty G) (subT G GX R sx) (PS.Pi G A I0) PR) (lam G A I0 (IJ.rfl (ext G A) WB0 (bod G A WB0 x))) ;
    -- f : R -> Id(x , y), over G.X.R
    GXR : Ctx = ext GX R ;
    pR' : Sub GXR GX = p GX R ;
    A2 : Ty GXR = wkT GX R A1 ;
    B2 : Ty GXR = wkT GX R B1 ;
    PF2 : Id (Ty GXR) (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) = Fun-ov GXR GX A1 B1 pR' A2 (refl A2) B2 (refl B2) ;
    xw2 : El GXR (Fun GXR A2 B2) = trE GXR (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) PF2 (subt GXR GX (Fun GX A1 B1) xw pR') ;
    yv2 : El GXR (Fun GXR A2 B2) = trE GXR (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) PF2 (subt GXR GX (Fun GX A1 B1) yv pR') ;
    E2 : Ctx = ext GXR A2 ;
    WB2 : Ty E2 = wkT GXR A2 B2 ;
    PWB2 : Id (Ty E2) (subT E2 E1 WB1 (lift GXR GX A1 pR')) WB2 = wkT-ov GXR GX A1 B1 pR' A2 (refl A2) B2 (refl B2) ;
    I2 : Ty E2 = IJ.IdT E2 WB2 (bod GXR A2 WB2 xw2) (bod GXR A2 WB2 yv2) ;
    PI2 : Id (Ty E2) (subT E2 E1 I1 (lift GXR GX A1 pR')) I2 =
      Id-ov E2 E1 WB1 (bod GX A1 WB1 xw) (bod GX A1 WB1 yv) (lift GXR GX A1 pR') WB2 PWB2 (bod GXR A2 WB2 xw2) (bod GXR A2 WB2 yv2)
        (EG2.bodOv GXR GX A1 WB1 pR' A2 (refl A2) WB2 PWB2 PF2 xw xw2 (refl xw2))
        (EG2.bodOv GXR GX A1 WB1 pR' A2 (refl A2) WB2 PWB2 PF2 yv yv2 (refl yv2)) ;
    PR2 : Id (Ty GXR) (subT GXR GX R pR') (PS.Pi GXR A2 I2) = Pi-ov GXR GX A1 I1 pR' A2 (refl A2) I2 PI2 ;
    pt : El GXR (PS.Pi GXR A2 I2) = trE GXR (subT GXR GX R pR') (PS.Pi GXR A2 I2) PR2 (q GX R) ;
    e0 : El GXR (IJ.IdT GXR (Fun GXR A2 B2) xw2 yv2) = NF GXR A2 WB2 xw2 yv2 pt ;
    -- back to Id(x , y) read over G.X.R
    XR : Ty GXR = subT GXR GX (wkT G X X) pR' ;
    FS : Id (Ty GXR) XR (Fun GXR A2 B2) =
      trans (Ty GXR) XR (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') (wkT G X X) (Fun GX A1 B1) PF1) PF2 ;
    zEq (z : El GX (wkT G X X)) : Id (El GXR (Fun GXR A2 B2))
         (trE GXR (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) PF2 (subt GXR GX (Fun GX A1 B1) (trE GX (wkT G X X) (Fun GX A1 B1) PF1 z) pR'))
         (trE GXR XR (Fun GXR A2 B2) FS (subt GXR GX (wkT G X X) z pR')) =
      trans (El GXR (Fun GXR A2 B2))
        (trE GXR (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) PF2 (subt GXR GX (Fun GX A1 B1) (trE GX (wkT G X X) (Fun GX A1 B1) PF1 z) pR'))
        (trE GXR (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) PF2 (trE GXR XR (subT GXR GX (Fun GX A1 B1) pR') (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') (wkT G X X) (Fun GX A1 B1) PF1) (subt GXR GX (wkT G X X) z pR')))
        (trE GXR XR (Fun GXR A2 B2) FS (subt GXR GX (wkT G X X) z pR'))
        (ap (El GXR (subT GXR GX (Fun GX A1 B1) pR')) (El GXR (Fun GXR A2 B2)) (\ v -> trE GXR (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) PF2 v)
           (subt GXR GX (Fun GX A1 B1) (trE GX (wkT G X X) (Fun GX A1 B1) PF1 z) pR')
           (trE GXR XR (subT GXR GX (Fun GX A1 B1) pR') (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') (wkT G X X) (Fun GX A1 B1) PF1) (subt GXR GX (wkT G X X) z pR'))
           (subt-tr GXR GX (wkT G X X) (Fun GX A1 B1) PF1 z pR'))
        (trE-tr GXR XR (subT GXR GX (Fun GX A1 B1) pR') (Fun GXR A2 B2) (ap (Ty GX) (Ty GXR) (\ T -> subT GXR GX T pR') (wkT G X X) (Fun GX A1 B1) PF1) PF2 (subt GXR GX (wkT G X X) z pR')) ;
    e0' : El GXR (IJ.IdT GXR (Fun GXR A2 B2) (trE GXR XR (Fun GXR A2 B2) FS (subt GXR GX (wkT G X X) (wkE G X X x) pR')) (trE GXR XR (Fun GXR A2 B2) FS (subt GXR GX (wkT G X X) (q G X) pR'))) =
      subst (El GXR (Fun GXR A2 B2)) (\ v -> El GXR (IJ.IdT GXR (Fun GXR A2 B2) v (trE GXR XR (Fun GXR A2 B2) FS (subt GXR GX (wkT G X X) (q G X) pR'))))
        xw2 (trE GXR XR (Fun GXR A2 B2) FS (subt GXR GX (wkT G X X) (wkE G X X x) pR')) (zEq (wkE G X X x))
        (subst (El GXR (Fun GXR A2 B2)) (\ v -> El GXR (IJ.IdT GXR (Fun GXR A2 B2) xw2 v)) yv2 (trE GXR XR (Fun GXR A2 B2) FS (subt GXR GX (wkT G X X) (q G X) pR')) (zEq (q G X)) e0) ;
    IK : Ty GX = JP.IK G X x ;
    IKr : Id (Ty GXR) (subT GXR GX IK pR') (IJ.IdT GXR XR (subt GXR GX (wkT G X X) (wkE G X X x) pR') (subt GXR GX (wkT G X X) (q G X) pR')) =
      Id-ov GXR GX (wkT G X X) (wkE G X X x) (q G X) pR' XR (refl XR) (subt GXR GX (wkT G X X) (wkE G X X x) pR') (subt GXR GX (wkT G X X) (q G X) pR')
        (refl (subt GXR GX (wkT G X X) (wkE G X X x) pR')) (refl (subt GXR GX (wkT G X X) (q G X) pR')) ;
    f : El GXR (wkT GX R IK) =
      trE GXR (IJ.IdT GXR XR (subt GXR GX (wkT G X X) (wkE G X X x) pR') (subt GXR GX (wkT G X X) (q G X) pR')) (subT GXR GX IK pR')
        (sym (Ty GXR) (subT GXR GX IK pR') (IJ.IdT GXR XR (subt GXR GX (wkT G X X) (wkE G X X x) pR') (subt GXR GX (wkT G X X) (q G X) pR')) IKr)
        (EG5.idBack GXR XR (Fun GXR A2 B2) FS (subt GXR GX (wkT G X X) (wkE G X X x) pR') (subt GXR GX (wkT G X X) (q G X) pR') e0') ;
    module HH = H4.Hed[G, X, x, R, rho, f] ;
    module Fin (y : El G X) (u u' : El G (IJ.IdT G X x y)) {
      Ry : Ty G = subT G GX R (sec G X y) ;
      pRy : El G (PU.isProp G Ry) =
        trE G (subT G GX (PU.isProp GX R) (sec G X y)) (PU.isProp G Ry) (PU.isProp-ov G GX R (sec G X y) Ry (refl Ry)) (subt G GX (PU.isProp GX R) pR (sec G X y)) ;
      res : El G (IJ.IdT G (IJ.IdT G X x y) u u') =
        HH.Fin[y, u, u', PU.propPath G Ry pRy (TR.trP G X R x y u rho) (TR.trP G X R x y u' rho)].res ;
    } ;
  } ;
  module SP (G : Ctx) (A B : Ty G) (idPB : IdPB G B) {
    X : Ty G = Fun G A B ;
    G1 : Ctx = ext G X ;
    Xw : Ty G1 = wkT G X X ;
    G2 : Ctx = ext G1 Xw ;
    X2 : Ty G2 = wkT G1 Xw Xw ;
    v1 : El G2 X2 = wkE G1 Xw Xw (q G X) ;
    v2 : El G2 X2 = q G1 Xw ;
    T : Ty G2 = IJ.IdT G2 X2 v1 v2 ;
    SPT : Ty G2 = PU.isProp G2 T ;
    G3 : Ctx = ext G2 T ;
    Tw : Ty G3 = wkT G2 T T ;
    Gm : Ctx = ext G3 Tw ;
    -- one substitution to G, and the data read there
    s2 : Sub G2 G = o G2 G1 G (p G X) (p G1 Xw) ;
    sG : Sub Gm G2 = o Gm G3 G2 (p G2 T) (p G3 Tw) ;
    s : Sub Gm G = o Gm G2 G s2 sG ;
    Am : Ty Gm = subT Gm G A s ;
    Bm : Ty Gm = subT Gm G B s ;
    idPBm (E : Ctx) (sE : Sub E Gm) (u v : El E (subT E Gm Bm sE)) : El E (PU.isProp E (IJ.IdT E (subT E Gm Bm sE) u v)) =
      idPBAt G B idPB E (o E Gm G s sE) (subT E Gm Bm sE) (subT-o E Gm G B s sE) u v ;
    Xm : Ty Gm = Fun Gm Am Bm ;
    PXm : Id (Ty Gm) (subT Gm G X s) Xm = Fun-ov Gm G A B s Am (refl Am) Bm (refl Bm) ;
    PX2 : Id (Ty G2) X2 (subT G2 G X s2) = sym (Ty G2) (subT G2 G X s2) X2 (subT-o G2 G1 G X (p G X) (p G1 Xw)) ;
    PX2m : Id (Ty Gm) (subT Gm G2 X2 sG) Xm =
      trans (Ty Gm) (subT Gm G2 X2 sG) (subT Gm G2 (subT G2 G X s2) sG) Xm
        (ap (Ty G2) (Ty Gm) (\ Y -> subT Gm G2 Y sG) X2 (subT G2 G X s2) PX2)
        (trans (Ty Gm) (subT Gm G2 (subT G2 G X s2) sG) (subT Gm G X s) Xm (sym (Ty Gm) (subT Gm G X s) (subT Gm G2 (subT G2 G X s2) sG) (subT-o Gm G2 G X s2 sG)) PXm) ;
    xm : El Gm Xm = trE Gm (subT Gm G2 X2 sG) Xm PX2m (subt Gm G2 X2 v1 sG) ;
    ym : El Gm Xm = trE Gm (subT Gm G2 X2 sG) Xm PX2m (subt Gm G2 X2 v2 sG) ;
    -- the two path variables, read in Id(xm , ym)
    TT : Ty Gm = wkT G3 Tw Tw ;
    PTT : Id (Ty Gm) TT (IJ.IdT Gm Xm xm ym) =
      trans (Ty Gm) TT (subT Gm G2 T sG) (IJ.IdT Gm Xm xm ym)
        (sym (Ty Gm) (subT Gm G2 T sG) TT (subT-o Gm G3 G2 T (p G2 T) (p G3 Tw)))
        (Id-ov Gm G2 X2 v1 v2 sG Xm PX2m xm ym (refl xm) (refl ym)) ;
    u : El Gm TT = wkE G3 Tw Tw (q G2 T) ;
    u' : El Gm TT = q G3 Tw ;
    module F = SX[Gm, Am, Bm, idPBm, xm].Fin[ym, trE Gm TT (IJ.IdT Gm Xm xm ym) PTT u, trE Gm TT (IJ.IdT Gm Xm xm ym) PTT u'] ;
    e : El Gm (EQ.Id2 G2 T) = EG5.idBack Gm TT (IJ.IdT Gm Xm xm ym) PTT u u' F.res ;
    sp : El G2 SPT = lam G2 T (PS.Pi G3 Tw (EQ.Id2 G2 T)) (lam G3 Tw (EQ.Id2 G2 T) e) ;
    setPi : El G (PS.Pi G X (PS.Pi G1 Xw SPT)) = lam G X (PS.Pi G1 Xw SPT) (lam G1 Xw SPT sp) ;
    -- read at two elements a b of X over any D (along s : D -> G, X[s] = Y)
    module At (D : Ctx) (sd : Sub D G) (Y : Ty D) (PY : Id (Ty D) (subT D G X sd) Y) (a b : El D Y) {
      a' : El D (subT D G X sd) = trE D Y (subT D G X sd) (sym (Ty D) (subT D G X sd) Y PY) a ;
      s1 : Sub D G1 = extS D G X sd a' ;
      PW1 : Id (Ty D) (subT D G1 Xw s1) (subT D G X sd) = IN.wkT-extS D G X X sd a' ;
      PXw : Id (Ty D) (subT D G1 Xw s1) Y = trans (Ty D) (subT D G1 Xw s1) (subT D G X sd) Y PW1 PY ;
      b' : El D (subT D G1 Xw s1) = trE D Y (subT D G1 Xw s1) (sym (Ty D) (subT D G1 Xw s1) Y PXw) b ;
      sg : Sub D G2 = extS D G1 Xw s1 b' ;
      PW2 : Id (Ty D) (subT D G2 X2 sg) (subT D G1 Xw s1) = IN.wkT-extS D G1 Xw Xw s1 b' ;
      PX2' : Id (Ty D) (subT D G2 X2 sg) Y = trans (Ty D) (subT D G2 X2 sg) (subT D G1 Xw s1) Y PW2 PXw ;
      qa : Id (El D (subT D G X sd)) (trE D (subT D G1 Xw s1) (subT D G X sd) PW1 (subt D G1 Xw (q G X) s1)) a' = JP.q-extS D G X sd a' PW1 ;
      o1 : Ov D G2 X2 sg Y PX2' v1 (trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1)) =
        ovTr D G2 X2 X2 (refl X2) sg (subT D G1 Xw s1) Y PXw PW2 PX2' v1 (subt D G1 Xw (q G X) s1)
          (IN.wkE-extS D G1 Xw Xw (q G X) s1 b' PW2) ;
      ea : Id (El D Y) (trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1)) a =
        calc (El D Y) {
            trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1)
          =< sym (El D Y) (trE D (subT D G X sd) Y PY (trE D (subT D G1 Xw s1) (subT D G X sd) PW1 (subt D G1 Xw (q G X) s1)))
               (trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1))
               (trE-tr D (subT D G1 Xw s1) (subT D G X sd) Y PW1 PY (subt D G1 Xw (q G X) s1)) >
            trE D (subT D G X sd) Y PY (trE D (subT D G1 Xw s1) (subT D G X sd) PW1 (subt D G1 Xw (q G X) s1))
          =< ap (El D (subT D G X sd)) (El D Y) (\ v -> trE D (subT D G X sd) Y PY v)
               (trE D (subT D G1 Xw s1) (subT D G X sd) PW1 (subt D G1 Xw (q G X) s1)) a' qa >
            trE D (subT D G X sd) Y PY a'
          =< JP.trE-sym D (subT D G X sd) Y PY a >
            a } ;
      ov1 : Ov D G2 X2 sg Y PX2' v1 a =
        trans (El D Y) (trE D (subT D G2 X2 sg) Y PX2' (subt D G2 X2 v1 sg)) (trE D (subT D G1 Xw s1) Y PXw (subt D G1 Xw (q G X) s1)) a o1 ea ;
      o2 : Ov D G2 X2 sg Y PX2' v2 (trE D (subT D G1 Xw s1) Y PXw b') =
        ovTr D G2 X2 X2 (refl X2) sg (subT D G1 Xw s1) Y PXw PW2 PX2' v2 b' (JP.q-extS D G1 Xw s1 b' PW2) ;
      ov2 : Ov D G2 X2 sg Y PX2' v2 b =
        trans (El D Y) (trE D (subT D G2 X2 sg) Y PX2' (subt D G2 X2 v2 sg)) (trE D (subT D G1 Xw s1) Y PXw b') b o2
          (JP.trE-sym D (subT D G1 Xw s1) Y PXw b) ;
      PSP : Id (Ty D) (subT D G2 SPT sg) (PU.isProp D (IJ.IdT D Y a b)) =
        PU.isProp-ov D G2 T sg (IJ.IdT D Y a b) (Id-ov D G2 X2 v1 v2 sg Y PX2' a b ov1 ov2) ;
      law : El D (PU.isProp D (IJ.IdT D Y a b)) = trE D (subT D G2 SPT sg) (PU.isProp D (IJ.IdT D Y a b)) PSP (subt D G2 SPT sp sg) ;
    } ;
  } ;
} ;
