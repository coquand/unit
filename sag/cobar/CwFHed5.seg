-- CwFHed5.seg (canonicity-c2; for "D preserves h-sets"): CwFHed4's data
-- moved along a substitution s : D -> G, in a CwF with Pi, Sigma and Swan
-- Id. From R over G.A, rho : R(x) and f : R -> Id(x , -) over G.A, the
-- same data at D over A[s] and x[s]: R[lift s], rho[s] (along sec-o),
-- f[lift (lift s)] (along wkT-ov and Id-ov).
open Base ;

module Hed5 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module H4 = CwFHed4.Hed4[l, C, PS, SS, IJ] ;
  module Mv (G D : Ctx) (A : Ty G) (x : El G A) (R : Ty (ext G A)) (rho : El G (subT G (ext G A) R (sec G A x)))
    (f : El (ext (ext G A) R) (wkT (ext G A) R (JP.IK G A x))) (s : Sub D G) {
    A' : Ty D = subT D G A s ;
    x' : El D A' = subt D G A x s ;
    GA : Ctx = ext G A ;
    DA : Ctx = ext D A' ;
    ls : Sub DA GA = lift D G A s ;
    R' : Ty DA = subT DA GA R ls ;
    pr1 : Id (Ty D) (subT D G (subT G GA R (sec G A x)) s) (subT D DA R' (sec D A' x')) =
      trans (Ty D) (subT D G (subT G GA R (sec G A x)) s) (subT D GA R (o D G GA (sec G A x) s)) (subT D DA R' (sec D A' x'))
        (sym (Ty D) (subT D GA R (o D G GA (sec G A x) s)) (subT D G (subT G GA R (sec G A x)) s) (subT-o D G GA R (sec G A x) s))
        (trans (Ty D) (subT D GA R (o D G GA (sec G A x) s)) (subT D GA R (o D DA GA ls (sec D A' x'))) (subT D DA R' (sec D A' x'))
           (ap (Sub D GA) (Ty D) (\ t -> subT D GA R t) (o D G GA (sec G A x) s) (o D DA GA ls (sec D A' x')) (sec-o D G A x s))
           (subT-o D DA GA R ls (sec D A' x'))) ;
    rho' : El D (subT D DA R' (sec D A' x')) =
      trE D (subT D G (subT G GA R (sec G A x)) s) (subT D DA R' (sec D A' x')) pr1 (subt D G (subT G GA R (sec G A x)) rho s) ;
    PW : Id (Ty DA) (subT DA GA (wkT G A A) ls) (wkT D A' A') = wkT-ov D G A A s A' (refl A') A' (refl A') ;
    pIK : Id (Ty DA) (subT DA GA (JP.IK G A x) ls) (JP.IK D A' x') =
      Id-ov DA GA (wkT G A A) (wkE G A A x) (q G A) ls (wkT D A' A') PW (wkE D A' A' x') (q D A')
        (wkE-ov D G A A x s A' (refl A') A' (refl A') x' (refl x') PW)
        (q-ov D G A s A' (refl A') PW) ;
    KR : Ctx = ext GA R ;
    KR' : Ctx = ext DA R' ;
    lls : Sub KR' KR = lift DA GA R ls ;
    pf : Id (Ty KR') (subT KR' KR (wkT GA R (JP.IK G A x)) lls) (wkT DA R' (JP.IK D A' x')) =
      trans (Ty KR') (subT KR' KR (wkT GA R (JP.IK G A x)) lls) (wkT DA R' (subT DA GA (JP.IK G A x) ls)) (wkT DA R' (JP.IK D A' x'))
        (wkT-ov DA GA R (JP.IK G A x) ls R' (refl R') (subT DA GA (JP.IK G A x) ls) (refl (subT DA GA (JP.IK G A x) ls)))
        (ap (Ty DA) (Ty KR') (\ T -> wkT DA R' T) (subT DA GA (JP.IK G A x) ls) (JP.IK D A' x') pIK) ;
    f' : El KR' (wkT DA R' (JP.IK D A' x')) =
      trE KR' (subT KR' KR (wkT GA R (JP.IK G A x)) lls) (wkT DA R' (JP.IK D A' x')) pf (subt KR' KR (wkT GA R (JP.IK G A x)) f lls) ;
    module HH = H4.Hed[D, A', x', R', rho', f'] ;
  } ;
} ;
