-- CCmpK11.seg (canonicity-c2; (K) for cmpI, part 11): over Delta Term_y^2,
-- the family of Ids z_s (Phi_k cx) = cls s_k (k = 1, 2): Phi_k's beta, then
-- the beta of the substitution x_i |-> s_i at x_k (closed, packed by K1.IdFam).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module K11 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K1m = CCmpK1[a].K1[R, encK, pe, y] ;
 module E1m = CEv1[a].E1[R, encK, pe, y] ;
 module CM = K1m.CM ;
 module AS = K1m.HZ.AS ;
 Nl : C.Ctx = C.nil ;
 TmY : U a = K1m.TmY ;
 QA : C.Ty Nl = AS.Qt ;
 QY : C.Ty Nl = E1m.QY ;
 cx : C.El Nl E1m.QA = E1m.cx ;
 Phi (s1 s2 : TmY) : C.El Nl (OV.Fun Nl QA QY) = K1m.SC[s1, s2].S0.SM.Phi ;
 module G (Pk : C.El Nl (OV.Fun Nl E1m.QA QA)) (v : SX.Fin (suc (suc zero))) (bk : C.El Nl (IJ.IdT Nl QA (OV.app Nl E1m.QA QA Pk cx) (AS.AX.cls (var v)))) {
  cP : C.El Nl QA = OV.app Nl E1m.QA QA Pk cx ;
  c1 (s1 s2 : TmY) : C.El Nl QY = OV.app Nl QA QY (Phi s1 s2) cP ;
  c2 (s1 s2 : TmY) : C.El Nl QY = E1m.HZ.AT.AX.cls (K1m.sg s1 s2 v) ;
  ee (s1 s2 : TmY) : C.El Nl (IJ.IdT Nl QY (c1 s1 s2) (c2 s1 s2)) =
   PT.transM Nl QY (c1 s1 s2) (OV.app Nl QA QY (Phi s1 s2) (AS.AX.cls (var v))) (c2 s1 s2)
    (PT.apM Nl QA QY (OV.bod Nl QA (OV.wkT Nl QA QY) (Phi s1 s2)) cP (AS.AX.cls (var v)) bk)
    (K1m.SC[s1, s2].S0.SM.beta (var v)) ;
  bfam : C.El K1m.DP (IJ.IdT K1m.DP (OV.wkT Nl K1m.TP QY) K1m.Fam[QY, c1].el K1m.Fam[QY, c2].el) = K1m.IdFam[QY, c1, c2, ee].res ;
 } ;
 module SM1 = CM.II.I1.SM ;
 module SM2 = CM.II.I2.SM ;
 module G1 = G[SM1.Phi, inl (inr tt), SM1.beta (var (inr tt))] ;
 module G2 = G[SM2.Phi, inr tt, SM2.beta (var (inr tt))] ;
 b1 : C.El K1m.DP (IJ.IdT K1m.DP (OV.wkT Nl K1m.TP QY) K1m.Fam[QY, G1.c1].el K1m.Fam[QY, G1.c2].el) = G1.bfam ;
 b2 : C.El K1m.DP (IJ.IdT K1m.DP (OV.wkT Nl K1m.TP QY) K1m.Fam[QY, G2.c1].el K1m.Fam[QY, G2.c2].el) = G2.bfam ;
} ;
