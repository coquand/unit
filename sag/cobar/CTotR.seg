-- CTotR.seg (canonicity-c2; SIMPLIFIED.md item 5): U and R between the
-- total site of an internal category C and its levelwise site (the total
-- site of the discrete category on C's objects, CDisc), and the transfer
-- of contractions: a levelwise trivial fibration B gives a trivial
-- fibration R B.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module TotR (C : CIntCat[a, vl].IC) {
 module DS = CDisc[a, vl, l].DiscOf[C] ;
 module G1 = CGrothBase[a, vl, l].GrothOf[C] ;
 module G0 = CGrothBase[a, vl, l].GrothOf[DS.disc] ;
 -- the functor of CDisc, between the categories of the two bases
 fn : CChainsF[vl].FunOf[G0.GB.BC, G1.GB.BC].SFun =
  new CChainsF[vl].FunOf[G0.GB.BC, G1.GB.BC].SFun[DS.fnO, DS.fnH, DS.fnId, DS.fnComp] ;
 module RN = CRan[vl, l].Ran[G0.GB.BC, G1.GB.BC, fn] ;
 module RS = RN.RS ;
 module P0 = RN.P0 ;
 module P1 = RN.P1 ;
 -- the two sites have the same sieves, and restriction along the functor
 -- is restriction along the base part
 phi-same (X : G0.TOb) : Id (U vl) (G0.GB.Phi X) (G1.GB.Phi (DS.fnO X)) = refl (G0.GB.Phi X) ;
 pre-same (Y X : G0.TOb) (h : G0.THm Y X) (Q : G0.GB.Phi X)
  : Id (G0.GB.Phi Y) (G0.GB.pre Y X h Q) (G1.GB.pre (DS.fnO Y) (DS.fnO X) (DS.fnH Y X h) Q) = refl (G0.GB.pre Y X h Q) ;
 lands-same (W X : G0.TOb) (Q : G0.GB.Phi X) (h : G0.THm W X)
  : Id (U vl) (G0.GB.Lands W X Q h) (G1.GB.Lands (DS.fnO W) (DS.fnO X) Q (DS.fnH W X h)) = refl (G0.GB.Lands W X Q h) ;

 ----------------------------------------------------------------------
 -- R preserves contractions (Lemma 9): fill componentwise
 module L9 (G : P1.PCtx) (B : P0.PTy[RS.rC G]) {
  module RT = RN.Ty[G, B] ;
  UG : P0.PCtx = RS.rC G ;
  Ob1 : U vl = RN.Ob1 ;
  Ob0 : U vl = RN.Ob0 ;
  Pt (X : Ob1) : U l = W0.Ix (G.ob X) ;
  Tot1 (X : Ob1) : U l = P1.SigT G RT.RB X ;
  Tot0 (Y : Ob0) : U l = P0.SigT UG B Y ;
  E1 : P1.PCtx = P1.extP G RT.RB ;
  E0 : P0.PCtx = P0.extP UG B ;
  -- the component of a total of R B at a stage F Z, at the identity
  prI (Z : Ob0) (t : Tot1 (RN.o Z)) : Tot0 Z =
   P0.pairE UG B Z t.1 (t.2.1 Z (G1.GB.BC.idC (RN.o Z)) t.1 (symH (G.act-id (RN.o Z) t.1))) ;
  -- it commutes with the actions
  module PA (Z' Z : Ob0) (chi : RN.Hom0 Z' Z) (t : Tot1 (RN.o Z)) {
   g : Pt (RN.o Z) = t.1 ;
   g' : Pt (RN.o Z') = G.act (RN.o Z') (RN.o Z) (fn.onH Z' Z chi) g ;
   module A = RT.Act[RN.o Z', RN.o Z, fn.onH Z' Z chi, g, g', refl g', t.2] ;
   m1 : RN.Hom1 (RN.o Z') (RN.o Z) = G1.GB.BC.oC (RN.o Z') (RN.o Z) (RN.o Z) (G1.GB.BC.idC (RN.o Z)) (fn.onH Z' Z chi) ;
   m2 : RN.Hom1 (RN.o Z') (RN.o Z) = G1.GB.BC.oC (RN.o Z') (RN.o Z') (RN.o Z) (fn.onH Z' Z chi) (G1.GB.BC.idC (RN.o Z')) ;
   pm : Id (RN.Hom1 (RN.o Z') (RN.o Z)) m1 m2 =
    transH (G1.GB.BC.oC-idl (RN.o Z') (RN.o Z) (fn.onH Z' Z chi)) (symH (G1.GB.BC.oC-idr (RN.o Z') (RN.o Z) (fn.onH Z' Z chi))) ;
   E' : Id (Pt (RN.o Z')) g' (RT.at (RN.o Z) g Z' m1) =
    apH {RN.Hom1 (RN.o Z') (RN.o Z)} {Pt (RN.o Z')} (\ mm -> G.act (RN.o Z') (RN.o Z) mm g) (symH (G1.GB.BC.oC-idl (RN.o Z') (RN.o Z) (fn.onH Z' Z chi))) ;
   e0' : Id (Pt (RN.o Z')) g' (RT.at (RN.o Z') g' Z' (G1.GB.BC.idC (RN.o Z'))) = symH (G.act-id (RN.o Z') g') ;
   law : Id (Tot0 Z') (E0.act Z' Z chi (prI Z t)) (prI Z' (E1.act (RN.o Z') (RN.o Z) (fn.onH Z' Z chi) t)) =
    apH {W0.Ix (B.tob Z' g')} {Tot0 Z'} (\ v -> P0.pairE UG B Z' g' v)
     (transH (t.2.2 Z' Z chi (G1.GB.BC.idC (RN.o Z)) g (symH (G.act-id (RN.o Z) g)) g' E' (refl g'))
        (RT.famCong (RN.o Z) g t.2.1 Z' m1 m2 pm g' E' (transH e0' (A.ek Z' (G1.GB.BC.idC (RN.o Z')))))) ;
  } ;

  module Px = G1.GB.CPartial[l].Partials[G, RT.RB] ;
  module Py = G0.GB.CPartial[l].Partials[UG, B] ;
  -- m after F h, and its compatibility with composition in the levelwise site
  mh (X : Ob1) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) (Z : Ob0) (h : RN.Hom0 Z Y) : RN.Hom1 (RN.o Z) X =
   G1.GB.BC.oC (RN.o Z) (RN.o Y) X m (fn.onH Z Y h) ;
  mhc (X : Ob1) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) (Z' Z : Ob0) (chi : RN.Hom0 Z' Z) (h : RN.Hom0 Z Y)
   : Id (RN.Hom1 (RN.o Z') X) (G1.GB.BC.oC (RN.o Z') (RN.o Z) X (mh X Y m Z h) (fn.onH Z' Z chi)) (mh X Y m Z' (G0.GB.BC.oC Z' Z Y h chi)) =
   transH (G1.GB.BC.oC-assoc (RN.o Z') (RN.o Z) (RN.o Y) X m (fn.onH Z Y h) (fn.onH Z' Z chi))
    (apH {RN.Hom1 (RN.o Z') (RN.o Y)} {RN.Hom1 (RN.o Z') X} (\ k -> G1.GB.BC.oC (RN.o Z') (RN.o Y) X m k) (symH (fn.onComp Z' Z Y h chi))) ;

  -- a side of R B at (X , g), projected at (Y , m , p)
  module PS (X : Ob1) (g : Pt X) (s : Px.Side[X, g]) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) (p : Pt (RN.o Y))
    (e : Id (Pt (RN.o Y)) p (G.act (RN.o Y) X m g)) {
   Q : G0.GB.Phi Y = G1.GB.pre (RN.o Y) X m s.pQ ;
   pv (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.Lands Z Y Q h) : Tot0 Z = prI Z (s.pv (RN.o Z) (mh X Y m Z h) i) ;
   ppt (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.Lands Z Y Q h) : Id (Pt (RN.o Z)) (P0.fstE UG B Z (pv Z h i)) (UG.act Z Y h p) =
    transH (s.ppt (RN.o Z) (mh X Y m Z h) i)
     (transH (G.act-o (RN.o Z) (RN.o Y) X m (fn.onH Z Y h) g)
        (apH {Pt (RN.o Y)} {Pt (RN.o Z)} (\ z -> G.act (RN.o Z) (RN.o Y) (fn.onH Z Y h) z) (symH e))) ;
   module PN (Z' Z : Ob0) (chi : RN.Hom0 Z' Z) (h : RN.Hom0 Z Y) (i : G0.GB.Lands Z Y Q h)
     (i' : G0.GB.Lands Z' Y Q (G0.GB.BC.oC Z' Z Y h chi)) {
    k2 : RN.Hom1 (RN.o Z') X = G1.GB.BC.oC (RN.o Z') (RN.o Z) X (mh X Y m Z h) (fn.onH Z' Z chi) ;
    k3 : RN.Hom1 (RN.o Z') X = mh X Y m Z' (G0.GB.BC.oC Z' Z Y h chi) ;
    t0 : Tot1 (RN.o Z) = s.pv (RN.o Z) (mh X Y m Z h) i ;
    i2 : G1.GB.Lands (RN.o Z') X s.pQ k2 = G1.GB.lands-eq (RN.o Z') X s.pQ k3 k2 (symH (mhc X Y m Z' Z chi h)) i' ;
    t2 : Tot1 (RN.o Z') = s.pv (RN.o Z') k2 i2 ;
    t3 : Tot1 (RN.o Z') = s.pv (RN.o Z') k3 i' ;
    q1 : Id (Tot1 (RN.o Z')) (E1.act (RN.o Z') (RN.o Z) (fn.onH Z' Z chi) t0) t2 =
     s.pnat (RN.o Z') (RN.o Z) (fn.onH Z' Z chi) (mh X Y m Z h) i i2 ;
    q2 : Id (Tot1 (RN.o Z')) t2 t3 = Px.pv-hom X g s (RN.o Z') k2 k3 (mhc X Y m Z' Z chi h) i2 i' ;
    pnat : Id (Tot0 Z') (E0.act Z' Z chi (pv Z h i)) (pv Z' (G0.GB.BC.oC Z' Z Y h chi) i') =
     trans (Tot0 Z') (E0.act Z' Z chi (pv Z h i)) (prI Z' (E1.act (RN.o Z') (RN.o Z) (fn.onH Z' Z chi) t0)) (prI Z' t3)
      PA[Z', Z, chi, t0].law
      (ap (Tot1 (RN.o Z')) (Tot0 Z') (prI Z') (E1.act (RN.o Z') (RN.o Z) (fn.onH Z' Z chi) t0) t3
         (trans (Tot1 (RN.o Z')) (E1.act (RN.o Z') (RN.o Z) (fn.onH Z' Z chi) t0) t2 t3 q1 q2)) ;
   } ;
   side : Py.Side[Y, p] = Py.mkSide Y p Q pv ppt (\ Z' Z chi h i i' -> PN[Z', Z, chi, h, i, i'].pnat) ;
  } ;

  --------------------------------------------------------------------
  -- the componentwise extension, and its naturality along the levelwise maps
  module KO (al : G0.GB.CPartial[l].ContrOp UG B) {
   module TL0 = G0.GB.GPre[l].TyL[UG, B] ;
   kfam (X : Ob1) (g : Pt X) (s : Px.Side[X, g]) : RT.Fam X g = \ Y m p e -> al.kop Y p PS[X, g, s, Y, m, p, e].side ;
   module KN (X : Ob1) (g : Pt X) (s : Px.Side[X, g]) (Z Y : Ob0) (h : RN.Hom0 Z Y) (m : RN.Hom1 (RN.o Y) X) (p : Pt (RN.o Y))
     (e : Id (Pt (RN.o Y)) p (G.act (RN.o Y) X m g)) {
    q0 : Pt (RN.o Z) = UG.act Z Y h p ;
    e0' : Id (Pt (RN.o Z)) q0 (G.act (RN.o Z) X (mh X Y m Z h) g) =
     transH (apH {Pt (RN.o Y)} {Pt (RN.o Z)} (\ z -> G.act (RN.o Z) (RN.o Y) (fn.onH Z Y h) z) e)
      (symH (G.act-o (RN.o Z) (RN.o Y) X m (fn.onH Z Y h) g)) ;
    module S = PS[X, g, s, Y, m, p, e] ;
    module S' = PS[X, g, s, Z, mh X Y m Z h, q0, e0'] ;
    rs : Py.Side[Z, q0] = Py.rside Z Y h p S.side ;
    eQ : Id (G0.GB.Phi Z) rs.pQ S'.side.pQ = G1.GB.pre-comp (RN.o Z) (RN.o Y) X (fn.onH Z Y h) m s.pQ ;
    ev (W : Ob0) (k : RN.Hom0 W Z) (i : G0.GB.Lands W Z rs.pQ k) (i' : G0.GB.Lands W Z S'.side.pQ k)
     : Id (Tot0 W) (rs.pv W k i) (S'.side.pv W k i') =
     ap (Tot1 (RN.o W)) (Tot0 W) (prI W)
      (s.pv (RN.o W) (mh X Y m W (G0.GB.BC.oC W Z Y h k)) (G0.GB.lands-pre W Z Y h S.side.pQ k i))
      (s.pv (RN.o W) (mh X Z (mh X Y m Z h) W k) i')
      (Px.pv-hom X g s (RN.o W) (mh X Y m W (G0.GB.BC.oC W Z Y h k)) (mh X Z (mh X Y m Z h) W k)
         (symH (mhc X Y m W Z k h)) (G0.GB.lands-pre W Z Y h S.side.pQ k i) i') ;
    sideEq : Id (Py.Side[Z, q0]) rs S'.side = Py.side-ext Z q0 rs S'.side eQ ev ;
    core : Id (W0.Ix (B.tob Z q0)) (B.tact Z Y h p q0 (refl q0) (al.kop Y p S.side)) (al.kop Z q0 S'.side) =
     TL0.pr-inj Z q0 (B.tact Z Y h p q0 (refl q0) (al.kop Y p S.side)) (al.kop Z q0 S'.side)
      (trans (Tot0 Z) (E0.act Z Y h (P0.pairE UG B Y p (al.kop Y p S.side))) (P0.pairE UG B Z q0 (al.kop Z q0 rs)) (P0.pairE UG B Z q0 (al.kop Z q0 S'.side))
         (al.kunif Z Y h p S.side)
         (ap (Py.Side[Z, q0]) (Tot0 Z) (\ z -> P0.pairE UG B Z q0 (al.kop Z q0 z)) rs S'.side sideEq)) ;
   } ;
   knat (X : Ob1) (g : Pt X) (s : Px.Side[X, g]) : RT.NatTy X g (kfam X g s) =
    \ Z Y h m p e q e' e'' ->
     idJ (Pt (RN.o Z)) (UG.act Z Y h p)
      (\ q2 e2 -> (e3 : Id (Pt (RN.o Z)) q2 (RT.at X g Z (mh X Y m Z h)))
          -> Id (W0.Ix (B.tob Z q2)) (B.tact Z Y h p q2 e2 (kfam X g s Y m p e)) (kfam X g s Z (mh X Y m Z h) q2 e3))
      (\ e3 -> trans (W0.Ix (B.tob Z (UG.act Z Y h p))) (B.tact Z Y h p (UG.act Z Y h p) (refl (UG.act Z Y h p)) (kfam X g s Y m p e))
                 (kfam X g s Z (mh X Y m Z h) (UG.act Z Y h p) KN[X, g, s, Z, Y, h, m, p, e].e0')
                 (kfam X g s Z (mh X Y m Z h) (UG.act Z Y h p) e3)
                 KN[X, g, s, Z, Y, h, m, p, e].core
                 (ap (Id (Pt (RN.o Z)) (UG.act Z Y h p) (RT.at X g Z (mh X Y m Z h))) (W0.Ix (B.tob Z (UG.act Z Y h p)))
                    (\ z -> kfam X g s Z (mh X Y m Z h) (UG.act Z Y h p) z) KN[X, g, s, Z, Y, h, m, p, e].e0' e3
                    (W0.isSetIx (G.ob (RN.o Z)) (UG.act Z Y h p) (RT.at X g Z (mh X Y m Z h)) KN[X, g, s, Z, Y, h, m, p, e].e0' e3)))
      q e'' e' ;
   kop (X : Ob1) (g : Pt X) (s : Px.Side[X, g]) : W0.Ix (RT.RB.tob X g) = RT.mk X g (kfam X g s) (knat X g s) ;

   -- uniformity: the action of R B is reindexing, and the projected sides agree
   module KU (Y X : Ob1) (h : RN.Hom1 Y X) (g : Pt X) (s : Px.Side[X, g]) (Y0 : Ob0) (m : RN.Hom1 (RN.o Y0) Y) (p : Pt (RN.o Y0))
     (e : Id (Pt (RN.o Y0)) p (G.act (RN.o Y0) Y m (G.act Y X h g))) {
    g' : Pt Y = G.act Y X h g ;
    module A = RT.Act[Y, X, h, g, g', refl g', kop X g s] ;
    hm : RN.Hom1 (RN.o Y0) X = G1.GB.BC.oC (RN.o Y0) Y X h m ;
    module S1 = PS[X, g, s, Y0, hm, p, transH e (A.ek Y0 m)] ;
    rs : Px.Side[Y, g'] = Px.rside Y X h g s ;
    module S2 = PS[Y, g', rs, Y0, m, p, e] ;
    eQ : Id (G0.GB.Phi Y0) S1.side.pQ S2.side.pQ = symH (G1.GB.pre-comp (RN.o Y0) Y X m h s.pQ) ;
    as (Z : Ob0) (k : RN.Hom0 Z Y0)
     : Id (RN.Hom1 (RN.o Z) X) (mh X Y0 hm Z k) (G1.GB.BC.oC (RN.o Z) Y X h (mh Y Y0 m Z k)) =
     G1.GB.BC.oC-assoc (RN.o Z) (RN.o Y0) Y X h m (fn.onH Z Y0 k) ;
    ev (Z : Ob0) (k : RN.Hom0 Z Y0) (i : G0.GB.Lands Z Y0 S1.side.pQ k) (i' : G0.GB.Lands Z Y0 S2.side.pQ k)
     : Id (Tot0 Z) (S1.side.pv Z k i) (S2.side.pv Z k i') =
     ap (Tot1 (RN.o Z)) (Tot0 Z) (prI Z)
      (s.pv (RN.o Z) (mh X Y0 hm Z k) i)
      (s.pv (RN.o Z) (G1.GB.BC.oC (RN.o Z) Y X h (mh Y Y0 m Z k)) (G1.GB.lands-pre (RN.o Z) Y X h s.pQ (mh Y Y0 m Z k) i'))
      (Px.pv-hom X g s (RN.o Z) (mh X Y0 hm Z k) (G1.GB.BC.oC (RN.o Z) Y X h (mh Y Y0 m Z k)) (as Z k) i
         (G1.GB.lands-pre (RN.o Z) Y X h s.pQ (mh Y Y0 m Z k) i')) ;
    eq : Id (W0.Ix (B.tob Y0 p)) (A.b' Y0 m p e) (kfam Y g' rs Y0 m p e) =
     ap (Py.Side[Y0, p]) (W0.Ix (B.tob Y0 p)) (\ z -> al.kop Y0 p z) S1.side S2.side (Py.side-ext Y0 p S1.side S2.side eQ ev) ;
   } ;
   kunif (Y X : Ob1) (h : RN.Hom1 Y X) (g : Pt X) (s : Px.Side[X, g])
    : Id (Tot1 Y) (E1.act Y X h (P1.pairE G RT.RB X g (kop X g s)))
        (P1.pairE G RT.RB Y (G.act Y X h g) (kop Y (G.act Y X h g) (Px.rside Y X h g s))) =
    ap (W0.Ix (RT.RB.tob Y (G.act Y X h g))) (Tot1 Y) (\ v -> P1.pairE G RT.RB Y (G.act Y X h g) v)
     (RT.Act[Y, X, h, g, G.act Y X h g, refl (G.act Y X h g), kop X g s].res)
     (kop Y (G.act Y X h g) (Px.rside Y X h g s))
     (RT.famExt Y (G.act Y X h g) (RT.Act[Y, X, h, g, G.act Y X h g, refl (G.act Y X h g), kop X g s].res)
        (kop Y (G.act Y X h g) (Px.rside Y X h g s)) (\ Y0 m p e -> KU[Y, X, h, g, s, Y0, m, p, e].eq)) ;

   -- a family at equal maps and equal points
   famPt (X : Ob1) (g : Pt X) (b : RT.Fam X g) (Y : Ob0) (m m' : RN.Hom1 (RN.o Y) X) (pm : Id (RN.Hom1 (RN.o Y) X) m m')
    (p p' : Pt (RN.o Y)) (ep : Id (Pt (RN.o Y)) p p') (e : Id (Pt (RN.o Y)) p (RT.at X g Y m)) (e' : Id (Pt (RN.o Y)) p' (RT.at X g Y m'))
    : Id (W0.Ix (B.tob Y p')) (TL0.coeT Y p p' ep (b Y m p e)) (b Y m' p' e') =
    idJ (Pt (RN.o Y)) p (\ p2 ep2 -> (e2 : Id (Pt (RN.o Y)) p2 (RT.at X g Y m')) -> Id (W0.Ix (B.tob Y p2)) (TL0.coeT Y p p2 ep2 (b Y m p e)) (b Y m' p2 e2))
     (\ e2 -> RT.famCong X g b Y m m' pm p e e2) p' ep e' ;
   -- two totals of R B with equal points and the same families are equal
   totExt (W : Ob1) (t t' : Tot1 W) (e1 : Id (Pt W) t.1 t'.1)
    (q : (Y : Ob0) (m : RN.Hom1 (RN.o Y) W) (p : Pt (RN.o Y)) (e : Id (Pt (RN.o Y)) p (RT.at W t.1 Y m)) (e' : Id (Pt (RN.o Y)) p (RT.at W t'.1 Y m))
         -> Id (W0.Ix (B.tob Y p)) (t.2.1 Y m p e) (t'.2.1 Y m p e'))
    : Id (Tot1 W) t t' =
    idJ (Pt W) t.1
     (\ g2 e2 -> (w2 : RT.T W g2)
        -> ((Y : Ob0) (m : RN.Hom1 (RN.o Y) W) (p : Pt (RN.o Y)) (e : Id (Pt (RN.o Y)) p (RT.at W t.1 Y m)) (e' : Id (Pt (RN.o Y)) p (RT.at W g2 Y m))
              -> Id (W0.Ix (B.tob Y p)) (t.2.1 Y m p e) (w2.1 Y m p e'))
        -> Id (Tot1 W) t (P1.pairE G RT.RB W g2 w2))
     (\ w2 q2 -> ap (RT.T W t.1) (Tot1 W) (\ v -> P1.pairE G RT.RB W t.1 v) t.2 w2 (RT.famExt W t.1 t.2 w2 (\ Y m p e -> q2 Y m p e e)))
     t'.1 e1 t'.2 q ;

   -- the extension agrees with the side on its sieve
   module KS (X : Ob1) (g : Pt X) (s : Px.Side[X, g]) (W : Ob1) (f : RN.Hom1 W X) (i : G1.GB.Lands W X s.pQ f)
     (Y : Ob0) (m : RN.Hom1 (RN.o Y) W) (p : Pt (RN.o Y))
     (e : Id (Pt (RN.o Y)) p (RT.at W (G.act W X f g) Y m)) (e' : Id (Pt (RN.o Y)) p (RT.at W (s.pv W f i).1 Y m)) {
    R : Tot1 W = s.pv W f i ;
    module A = RT.Act[W, X, f, g, G.act W X f g, refl (G.act W X f g), kop X g s] ;
    fm : RN.Hom1 (RN.o Y) X = G1.GB.BC.oC (RN.o Y) W X f m ;
    module S = PS[X, g, s, Y, fm, p, transH e (A.ek Y m)] ;
    kv : W0.Ix (B.tob Y p) = al.kop Y p S.side ;
    i1 : G1.GB.Lands (RN.o Y) X s.pQ fm = G1.GB.lands-comp (RN.o Y) W X s.pQ f m i ;
    kI : RN.Hom1 (RN.o Y) X = mh X Y fm Y (G0.GB.BC.idC Y) ;
    eqI : Id (RN.Hom1 (RN.o Y) X) kI fm =
     transH (apH {RN.Hom1 (RN.o Y) (RN.o Y)} {RN.Hom1 (RN.o Y) X} (\ k -> G1.GB.BC.oC (RN.o Y) (RN.o Y) X fm k) (fn.onId Y))
      (G1.GB.BC.oC-idr (RN.o Y) X fm) ;
    i0 : G0.GB.Lands Y Y S.Q (G0.GB.BC.idC Y) = G1.GB.lands-eq (RN.o Y) X s.pQ fm kI (symH eqI) i1 ;
    c1 : Id (Tot0 Y) (E0.act Y Y (G0.GB.BC.idC Y) (P0.pairE UG B Y p kv)) (S.side.pv Y (G0.GB.BC.idC Y) i0) =
     al.kside Y p S.side Y (G0.GB.BC.idC Y) i0 ;
    c0 : Id (Tot0 Y) (E0.act Y Y (G0.GB.BC.idC Y) (P0.pairE UG B Y p kv)) (P0.pairE UG B Y p kv) = E0.act-id Y (P0.pairE UG B Y p kv) ;
    gR : Pt (RN.o Y) = G.act (RN.o Y) W m R.1 ;
    c2 : Id (Tot1 (RN.o Y)) (s.pv (RN.o Y) kI i0) (E1.act (RN.o Y) W m R) =
     trans (Tot1 (RN.o Y)) (s.pv (RN.o Y) kI i0) (s.pv (RN.o Y) fm i1) (E1.act (RN.o Y) W m R)
      (Px.pv-hom X g s (RN.o Y) kI fm eqI i0 i1)
      (symH (s.pnat (RN.o Y) W m f i i1)) ;
    module AR = RT.Act[RN.o Y, W, m, R.1, gR, refl gR, R.2] ;
    EE : Id (Pt (RN.o Y)) gR (RT.at W R.1 Y (G1.GB.BC.oC (RN.o Y) (RN.o Y) W m (G1.GB.BC.idC (RN.o Y)))) =
     transH (symH (G.act-id (RN.o Y) gR)) (AR.ek Y (G1.GB.BC.idC (RN.o Y))) ;
    rv : W0.Ix (B.tob Y gR) = R.2.1 Y (G1.GB.BC.oC (RN.o Y) (RN.o Y) W m (G1.GB.BC.idC (RN.o Y))) gR EE ;
    c3 : Id (Tot0 Y) (P0.pairE UG B Y gR rv) (P0.pairE UG B Y p kv) =
     symH (trans (Tot0 Y) (P0.pairE UG B Y p kv) (E0.act Y Y (G0.GB.BC.idC Y) (P0.pairE UG B Y p kv)) (P0.pairE UG B Y gR rv)
             (symH c0)
             (trans (Tot0 Y) (E0.act Y Y (G0.GB.BC.idC Y) (P0.pairE UG B Y p kv)) (prI Y (s.pv (RN.o Y) kI i0)) (P0.pairE UG B Y gR rv)
                c1
                (ap (Tot1 (RN.o Y)) (Tot0 Y) (prI Y) (s.pv (RN.o Y) kI i0) (E1.act (RN.o Y) W m R) c2))) ;
    c4 : Id (W0.Ix (B.tob Y p)) (TL0.coeT Y gR p (symH e') rv) kv = TL0.pr-eq Y gR p (symH e') rv kv c3 ;
    c5 : Id (W0.Ix (B.tob Y p)) (TL0.coeT Y gR p (symH e') rv) (R.2.1 Y m p e') =
     famPt W R.1 R.2.1 Y (G1.GB.BC.oC (RN.o Y) (RN.o Y) W m (G1.GB.BC.idC (RN.o Y))) m (G1.GB.BC.oC-idr (RN.o Y) W m) gR p (symH e') EE e' ;
    res : Id (W0.Ix (B.tob Y p)) kv (R.2.1 Y m p e') = transH (symH c4) c5 ;
   } ;
   kside (X : Ob1) (g : Pt X) (s : Px.Side[X, g]) (W : Ob1) (f : RN.Hom1 W X) (i : G1.GB.Lands W X s.pQ f)
    : Id (Tot1 W) (E1.act W X f (P1.pairE G RT.RB X g (kop X g s))) (s.pv W f i) =
    totExt W (E1.act W X f (P1.pairE G RT.RB X g (kop X g s))) (s.pv W f i) (symH (s.ppt W f i))
     (\ Y m p e e' -> KS[X, g, s, W, f, i, Y, m, p, e, e'].res) ;

   -- R B has a contraction
   contrR : G1.GB.CPartial[l].ContrOp G RT.RB =
    G1.GB.CPartial[l].Rel[G, RT.RB, RT.RB, G1.GB.CPartial[l].pmap-id G RT.RB].mkRC kop kside kunif ;
  } ;
 } ;
} ;
