-- Internal Hom comparison for F3, built by pairing the three natural
-- precomposition maps.  This is the map whose equivalence Lemma 43 asserts.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

module PairN (X Y Z : C.Ty C.nil) (m : HO.NMap[C.nil, X.1, Y.1]) (n : HO.NMap[C.nil, X.1, Z.1]) {
  Nl : C.Ctx = C.nil ;
  YZ : C.Ty Nl = SS.Sig Nl Y (OV.wkT Nl Y Z) ;
  nf (I : Ob) (o : Top) (x : V1.Ix (X.1.tob I o)) : V1.Ix (YZ.1.tob I o) = (m.nfun I o x, n.nfun I o x) ;
  wkP (J I : Ob) (f : Hom J I) (e : Id Top (Nl.act J I f tt) tt) (b : V1.Ix (Y.1.tob I tt)) : Id Top (Nl.act J I f tt) tt =
    L.ntEq (L.extP Nl Y.1) Nl (L.pP Nl Y.1) J I f (tt, b)
      (tt, Y.1.tact J I f tt tt e b) (L.pair-act Nl Y.1 J I f tt tt e b) ;
  actP (J I : Ob) (f : Hom J I) (e : Id Top (Nl.act J I f tt) tt)
    (b : V1.Ix (Y.1.tob I tt)) (c : V1.Ix (Z.1.tob I tt)) :
    Id (V1.Ix (YZ.1.tob J tt)) (YZ.1.tact J I f tt tt e (b, c))
      (Y.1.tact J I f tt tt e b, Z.1.tact J I f tt tt (wkP J I f e b) c) =
    refl (YZ.1.tact J I f tt tt e (b, c)) ;
  n2 (J I : Ob) (f : Hom J I) (e : Id Top (Nl.act J I f tt) tt) (x : V1.Ix (X.1.tob I tt)) :
    Id (V1.Ix (Z.1.tob J tt)) (Z.1.tact J I f tt tt (wkP J I f e (m.nfun I tt x)) (n.nfun I tt x))
      (n.nfun J tt (X.1.tact J I f tt tt e x)) =
    transH (L.tact-irr Nl Z.1 J I f tt tt (wkP J I f e (m.nfun I tt x)) e (n.nfun I tt x))
      (n.nnat J I f tt tt e x) ;
  nn (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o')
    (x : V1.Ix (X.1.tob I o)) ->
    Id (V1.Ix (YZ.1.tob J o')) (YZ.1.tact J I f o o' e (nf I o x))
      (nf J o' (X.1.tact J I f o o' e x)) = split { tt -> split { tt -> \ e x ->
      transH (actP J I f e (m.nfun I tt x) (n.nfun I tt x))
        (transH (apH {V1.Ix (Y.1.tob J tt)} {V1.Ix (YZ.1.tob J tt)}
          (\ b -> (b, Z.1.tact J I f tt tt (wkP J I f e (m.nfun I tt x)) (n.nfun I tt x)))
          (m.nnat J I f tt tt e x))
          (apH {V1.Ix (Z.1.tob J tt)} {V1.Ix (YZ.1.tob J tt)}
            (\ c -> (m.nfun J tt (X.1.tact J I f tt tt e x), c)) (n2 J I f e x))) } } ;
  nmap : HO.NMap[Nl, X.1, YZ.1] = new HO.NMap[Nl, X.1, YZ.1, nf, nn] ;
} ;

module Cmp3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (y : SX.Over[R].Presentation) {
  module FC = CFree3Assoc[a].Free3Comparison[R, encK, pe] ;
  module P = CPreI[a].PreOf[R, encK, pe] ;
  module Q1 = P.PI[FC.F.F3, FC.CM.F1, FC.K1.M.mor, FC.K1.M.mor-nat, y] ;
  module Q2 = P.PI[FC.F.F3, FC.CM.F1, FC.K2.M.mor, FC.K2.M.mor-nat, y] ;
  module Q3 = P.PI[FC.F.F3, FC.CM.F1, FC.K3.M.mor, FC.K3.M.mor-nat, y] ;
  HS : C.Ty C.nil = Q1.HS ;
  HT : C.Ty C.nil = Q1.HT ;
  module P12 = PairN[HS, HT, HT, Q1.nmap, Q2.nmap] ;
  module P123 = PairN[HS, P12.YZ, HT, P12.nmap, Q3.nmap] ;
  HTTT : C.Ty C.nil = P123.YZ ;
  cmpI : C.El C.nil (OV.Fun C.nil HS HTTT) = QinvEq[a, a+].FunOf[C.nil, HS, HTTT, P123.nmap].fC ;
} ;
