-- CCmpK32.seg (canonicity-c2; (K) for cmpI, part 32): both round trips of
-- cmpI : HomT(F2, y) ~ HomT(F1, y)^2 as Ids over the variable's context
-- with the variable as right end (as CEv8; 45's IdRd form).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module K32 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module E7m = CCmpK31[a].K31[R, encK, pe, y] ;
 module E6m = E7m.E6m ;
 module I = E7m.I ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = I.A ;
 QY : C.Ty Nl = I.B ;
 D : C.Ctx = E7m.D ;
 WH : C.Ty D = OV.wkT Nl HT HT ;
 -- inv (ev g) = g
 t1 : C.El D WH = OV.trE D E7m.Xs WH (symH E7m.PXs) (C.subt D I.GB I.Xb E6m.invB E7m.sg) ;
 t1v (W : Ob) (z : V1.Ix (D.ob W)) : Id (V1.Ix (HT.1.tob W z.1)) (t1.eob W z) (E6m.invB.eob W (E7m.sg.nt W z)) =
  transH (CAppRd[a].trE-rd D E7m.Xs WH (symH E7m.PXs) (C.subt D I.GB I.Xb E6m.invB E7m.sg) W z)
   (CAppRd[a].same-rd D E7m.Xs WH (symH E7m.PXs) W z (refl (WH.1.tob W z)) (E6m.invB.eob W (E7m.sg.nt W z))) ;
 r1 : C.El D (IJ.IdT D WH t1 (OV.trE D E7m.Xs WH (symH E7m.PXs) E7m.xg)) =
  CInjP[a].idFwdL D E7m.Xs WH (symH E7m.PXs) (C.subt D I.GB I.Xb E6m.invB E7m.sg) E7m.xg E7m.ret ;
 ret : C.El D (IJ.IdT D WH t1 (C.q Nl HT)) =
  subst (C.El D WH) (\ v -> C.El D (IJ.IdT D WH t1 v)) (OV.trE D E7m.Xs WH (symH E7m.PXs) E7m.xg) (C.q Nl HT)
   (CInjP[a].trInv D WH E7m.Xs E7m.PXs (C.q Nl HT)) r1 ;
 -- ev (inv q) = q
 GB : C.Ctx = I.GB ;
 WQ : C.Ty GB = OV.wkT Nl QY QY ;
 t2 : C.El GB WQ = I.evS GB (C.p Nl QY) E6m.invB ;
 t2v (W : Ob) (z : V1.Ix (GB.ob W)) : Id (V1.Ix (QY.1.tob W z.1)) (t2.eob W z) (I.n.nfun W z.1 (E6m.invB.eob W z)) = refl (t2.eob W z) ;
 rs : C.Sub GB I.GX = C.sec GB I.Xb E6m.invB ;
 T0 : C.Ty I.GX = OV.wkT I.GB I.Xb I.Bb ;
 qw : C.El I.GX T0 = OV.wkE I.GB I.Xb I.Bb (C.q Nl QY) ;
 Ts : C.Ty GB = C.subT GB I.GX T0 rs ;
 PW : Id (C.Ty GB) Ts WQ =
  transH (symH (C.subT-o GB I.GX GB I.Bb I.pX rs))
   (transH (apH {C.Sub GB GB} {C.Ty GB} (\ s -> C.subT GB GB I.Bb s) (L.sub-ext GB GB (C.o GB I.GX GB I.pX rs) (C.id GB) (\ K w -> refl w))) (C.subT-id GB I.Bb)) ;
 s0 : C.El GB (IJ.IdT GB Ts (C.subt GB I.GX T0 I.apX rs) (C.subt GB I.GX T0 qw rs)) =
  OV.trE GB (C.subT GB I.GX I.Fm rs) (IJ.IdT GB Ts (C.subt GB I.GX T0 I.apX rs) (C.subt GB I.GX T0 qw rs)) (IJ.IdT-nat GB I.GX T0 I.apX qw rs) E6m.sec1 ;
 s1 : C.El GB (IJ.IdT GB WQ (OV.trE GB Ts WQ PW (C.subt GB I.GX T0 I.apX rs)) (OV.trE GB Ts WQ PW (C.subt GB I.GX T0 qw rs))) =
  CInjP[a].idFwdL GB Ts WQ PW (C.subt GB I.GX T0 I.apX rs) (C.subt GB I.GX T0 qw rs) s0 ;
 ra (K : Ob) (w : V1.Ix (GB.ob K)) : Id (V1.Ix (WQ.1.tob K w)) ((OV.trE GB Ts WQ PW (C.subt GB I.GX T0 I.apX rs)).eob K w) (t2.eob K w) =
  transH (CAppRd[a].trE-rd GB Ts WQ PW (C.subt GB I.GX T0 I.apX rs) K w)
   (transH (CAppRd[a].same-rd GB Ts WQ PW K w (refl (WQ.1.tob K w)) (I.apX.eob K (rs.nt K w))) (I.appR K (rs.nt K w))) ;
 rb (K : Ob) (w : V1.Ix (GB.ob K)) : Id (V1.Ix (WQ.1.tob K w)) ((OV.trE GB Ts WQ PW (C.subt GB I.GX T0 qw rs)).eob K w) ((C.q Nl QY).eob K w) =
  transH (CAppRd[a].trE-rd GB Ts WQ PW (C.subt GB I.GX T0 qw rs) K w)
   (CAppRd[a].same-rd GB Ts WQ PW K w (refl (WQ.1.tob K w)) (qw.eob K (rs.nt K w))) ;
 secR : C.El GB (IJ.IdT GB WQ t2 (C.q Nl QY)) =
  CCmpU14[a].rwId GB WQ (OV.trE GB Ts WQ PW (C.subt GB I.GX T0 I.apX rs)) t2 (OV.trE GB Ts WQ PW (C.subt GB I.GX T0 qw rs)) (C.q Nl QY) ra rb s1 ;
} ;
