-- CCmpK3.seg (canonicity-c2; (K) for cmpI, part 3): applying a natural map
-- to an internal Id (apN), and the evaluations of the two components of a
-- pair of homs F1 -> y at the generator, as natural maps HTT -> Q_y.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
-- a natural map applied to an internal Id
module ApN (X Y : C.Ty C.nil) (m : HO.NMap[C.nil, X.1, Y.1]) (G : C.Ctx) (s0 : C.Sub G C.nil) {
 module IPm = CInjP[a].IP[X, Y, m] ;
 Nl : C.Ctx = C.nil ;
 XG : C.Ty G = C.subT G Nl X s0 ;
 YG : C.Ty G = C.subT G Nl Y s0 ;
 GX : C.Ctx = C.ext G XG ;
 s1 : C.Sub GX Nl = C.o GX G Nl s0 (C.p G XG) ;
 PX : Id (C.Ty GX) (OV.wkT G XG XG) (C.subT GX Nl X s1) = symH (C.subT-o GX G Nl X s0 (C.p G XG)) ;
 PY : Id (C.Ty GX) (C.subT GX Nl Y s1) (OV.wkT G XG YG) = C.subT-o GX G Nl Y s0 (C.p G XG) ;
 xv : C.El GX (C.subT GX Nl X s1) = OV.trE GX (OV.wkT G XG XG) (C.subT GX Nl X s1) PX (C.q G XG) ;
 r : C.El GX (OV.wkT G XG YG) = OV.trE GX (C.subT GX Nl Y s1) (OV.wkT G XG YG) PY (IPm.evS GX s1 xv) ;
 rd (u : C.El G XG) (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (YG.1.tob K w)) ((PT.atv G XG YG r u).eob K w) ((IPm.evS G s0 u).eob K w) =
  transH (CProdSet[a].atvR G XG YG r u K w)
   (transH (CAppRd[a].trE-rd GX (C.subT GX Nl Y s1) (OV.wkT G XG YG) PY (IPm.evS GX s1 xv) K (w, u.eob K w))
     (transH (CAppRd[a].same-rd GX (C.subT GX Nl Y s1) (OV.wkT G XG YG) PY K (w, u.eob K w) (refl (YG.1.tob K w)) ((IPm.evS GX s1 xv).eob K (w, u.eob K w)))
       (apH {V1.Ix (X.1.tob K (s0.nt K w))} {V1.Ix (YG.1.tob K w)} (m.nfun K (s0.nt K w))
          (transH (CAppRd[a].trE-rd GX (OV.wkT G XG XG) (C.subT GX Nl X s1) PX (C.q G XG) K (w, u.eob K w))
            (CAppRd[a].same-rd GX (OV.wkT G XG XG) (C.subT GX Nl X s1) PX K (w, u.eob K w) (refl (XG.1.tob K w)) (u.eob K w)))))) ;
 ap (u v : C.El G XG) (e : C.El G (IJ.IdT G XG u v)) : C.El G (IJ.IdT G YG (IPm.evS G s0 u) (IPm.evS G s0 v)) =
  CCmpU14[a].rwId G YG (PT.atv G XG YG r u) (IPm.evS G s0 u) (PT.atv G XG YG r v) (IPm.evS G s0 v) (rd u) (rd v) (PT.apM G XG YG r u v e) ;
} ;
module K3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module E1m = CEv1[a].E1[R, encK, pe, y] ;
 module CI = CPreI[a].PreOf[R, encK, pe].CmpI[y] ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = E1m.HT ;
 HTT : C.Ty Nl = CI.HTT ;
 QY : C.Ty Nl = E1m.QY ;
 -- evaluation of the first and second component at the generator
 m1 : HO.NMap[Nl, HTT.1, QY.1] = new HO.NMap[Nl, HTT.1, QY.1, \ K o p -> E1m.nf K o p.1, \ J I f x x' e p -> E1m.nn J I f x x' e p.1] ;
 e2 (J I : Ob) (f : Hom J I) (x x' : Top) (e : Id Top (Nl.act J I f x) x') (p : V1.Ix (HTT.1.tob I x)) : Id Top (Nl.act J I f x) x' =
  L.ntEq (L.extP Nl HT.1) Nl (L.pP Nl HT.1) J I f (x, p.1) (x', HT.1.tact J I f x x' e p.1) (L.pair-act Nl HT.1 J I f x x' e p.1) ;
 m2 : HO.NMap[Nl, HTT.1, QY.1] = new HO.NMap[Nl, HTT.1, QY.1, \ K o p -> E1m.nf K o p.2, \ J I f x x' e p ->
   transH (L.tact-irr Nl QY.1 J I f x x' e (e2 J I f x x' e p) (E1m.nf I x p.2)) (E1m.nn J I f x x' (e2 J I f x x' e p) p.2)] ;
} ;
