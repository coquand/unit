-- CHomT2.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- algebras, part 2: the data type of a family of constants.  For closed
-- sets QS, QT, a closed parameter type P (the constant type of the ring's
-- elements) and constants cS, cT over nil.P, over Gh = nil.MapT:
--   IdCSt     over nil.P.QS: cS = v (formers only); IdCTt likewise
--   Wc        the closed type Sigma r v (cS r = v)
--   sT        Gh.Wc -> nil.P.QT, (r, h v) (CHomT1's NTh)
--   DataCst   Pi (w : Wc). cT r = h v
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
PS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].PiStr = FibCwF[a, a+].fibPi ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module CstOf (QS QT P : C.Ty C.nil) (cS : C.El (C.ext C.nil P) (OV.wkT C.nil P QS)) (cT : C.El (C.ext C.nil P) (OV.wkT C.nil P QT)) {
 module B1 = CHomT1[a].BaseOf[QS, QT] ;
 Nl : C.Ctx = C.nil ;
 GP : C.Ctx = C.ext Nl P ;
 -- the closed Id types over nil.P.Q
 QSP : C.Ty GP = OV.wkT Nl P QS ;
 QTP : C.Ty GP = OV.wkT Nl P QT ;
 GPS : C.Ctx = C.ext GP QSP ;
 GPT : C.Ctx = C.ext GP QTP ;
 IdCSt : C.Ty GPS = IJ.IdT GPS (OV.wkT GP QSP QSP) (OV.wkE GP QSP QSP cS) (C.q GP QSP) ;
 IdCTt : C.Ty GPT = IJ.IdT GPT (OV.wkT GP QTP QTP) (OV.wkE GP QTP QTP cT) (C.q GP QTP) ;
 -- over Gh = nil.MapT
 MapT : C.Ty Nl = B1.MapT ;
 Gh : C.Ctx = B1.Gh ;
 pG : C.Sub Gh Nl = B1.pG ;
 Wc : C.Ty Nl = SS.Sig Nl P (SS.Sig GP QSP IdCSt) ;
 Wch : C.Ty Gh = C.subT Gh Nl Wc pG ;
 Dc : C.Ctx = C.ext Gh Wch ;
 -- (r, h v)
 sTN (K : Ob) (x : V1.Ix (Dc.ob K)) : V1.Ix (GPT.ob K) = ((x.1.1, x.2.1), B1.hv K x.1.1 x.1.2 x.2.2.1) ;
 sTNat (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (Dc.ob K)) : Id (V1.Ix (GPT.ob L0)) (sTN L0 (Dc.act L0 K g x)) (GPT.act L0 K g (sTN K x)) =
  apH {B1.TK L0 x.1.1} {V1.Ix (GPT.ob L0)} (\ z -> (GP.act L0 K g (x.1.1, x.2.1), z))
   (B1.NTh[K, L0, g, x.1.1, x.1.2, x.2.2.1].law) ;
 sT : C.Sub Dc GPT = new L.PSub[Dc, GPT, sTN, sTNat] ;
 IdCT : C.Ty Dc = C.subT Dc GPT IdCTt sT ;
 DataCst : C.Ty Gh = PS.Pi Gh Wch IdCT ;
} ;
