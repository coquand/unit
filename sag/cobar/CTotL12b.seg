-- CTotL12b.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part b: the side read at the cartesian lifts.
--   rdC    for a base map U : W1 -> I in s's sieve and a chain cc from y
--          to res U x at W1: s at cart U x, read at the identity index of
--          cc (head moved along res-id)
--   ptC    its point is gm's at the index (n, W1, U, y, cc)
--   NC     naturality along a base map w : W2 -> W1: the cartesian
--          restriction of rdC at (U, cc) is rdC at (U . w, rCh w cc)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module L12b (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LA = CTotL12a[a, vl, l].L12T[C, G, A] ;
 module CL = CTotL12ch[a, vl].ChL[C] ;
 module TR = LA.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 UG : TR.P0.PCtx = TR.RS.rC DA.GP ;
 UA : TR.P0.PTy[UG] = TR.RS.rT DA.GP A ;
 module Py = G0.GB.CPartial[l].Partials[UG, UA] ;

 EE : LA.P.PCtx = LA.P.extP LA.DG DA.DTy ;
 -- the reading of an element of the total space of D A at an index
 rdT (W : TC.TOb) (t : LA.P.SigT LA.DG DA.DTy W) (q : DO.Idx W.1 W.2) (lq : DO.LandsI W.1 W.2 q) : DA.Ez q.2.1 q.2.2.2.1 =
  DA.prz q.2.1 q.2.2.2.1 (t.1.1 q lq) (t.2.1 q lq) ;
 -- the reading of an acted element is the reading at the moved index
 actRd (W' W : TC.TOb) (k : TC.THm W' W) (t : LA.P.SigT LA.DG DA.DTy W) (q : DO.Idx W'.1 W'.2) (lq : DO.LandsI W'.1 W'.2 q)
  : Id (DA.Ez q.2.1 q.2.2.2.1) (rdT W' (EE.act W' W k t) q lq) (rdT W t (D.Act[W'.1, W.1, k.1, W'.2, W.2, k.2, t.1].rq q) lq) =
  DA.TB[W'.1, W.1, k.1, W'.2, W.2, k.2, t.1, LA.DG.act W' W k t.1, refl (LA.DG.act W' W k t.1), t.2].pc q lq ;

 module Fb (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module F = LA.Fx[X, gm, s] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  module RC (n : Nat) (W1 : Ob) (y : Obj W1) (U0 : Hom W1 I) (cc : CT.Ch W1 n (C.res W1 I U0 x) y) (lU : PB.Lands W1 I s.pQ U0) (R : Wt.Pn n W1) {
   ry : Obj W1 = C.res W1 I U0 x ;
   Xv : TC.TOb = (W1, ry) ;
   f : TC.THm Xv X = TC.cartT W1 X U0 ;
   module CA = CL.Cart[W1, I, U0, x, n, y, cc] ;
   q0 : DO.Idx W1 ry = (n, W1, idH W1, y, CA.ch, R.1) ;
   t : LA.P.SigT LA.DG DA.DTy Xv = F.sv Xv f lU ;
   val : DA.Ez W1 y = rdT Xv t q0 R.2 ;
   pt : Id (W0.Ix (G.ob W1 y)) val.1 (gm.1 (n, W1, U0, y, cc, R.1) R.2) =
    trans (W0.Ix (G.ob W1 y)) val.1 (gm.1 (D.Act[W1, I, U0, ry, x, C.cart W1 I U0 x, gm].rq q0) R.2) (gm.1 (n, W1, U0, y, cc, R.1) R.2)
     (apH {W0.Ix (LA.DG.ob Xv)} {W0.Ix (G.ob W1 y)} (\ w -> w.1 q0 R.2) (F.sp Xv f lU))
     (apH {D.S I x n W1 y} {W0.Ix (G.ob W1 y)} (\ sw -> D.rd I x gm.1 n W1 y R.1 sw R.2)
        (D.sEq I x n W1 y (compH W1 W1 I U0 (idH W1)) U0 (comp-idr W1 I U0)
           (CT.rxM W1 W1 I (idH W1) U0 ry x CA.g0 n y CA.ch) cc CA.law)) ;
  } ;
  rdC (n : Nat) (W1 : Ob) (y : Obj W1) (U0 : Hom W1 I) (cc : CT.Ch W1 n (C.res W1 I U0 x) y) (lU : PB.Lands W1 I s.pQ U0) (R : Wt.Pn n W1) : DA.Ez W1 y =
   RC[n, W1, y, U0, cc, lU, R].val ;

  -- naturality along a base map
  module NC (n : Nat) (W1 : Ob) (y : Obj W1) (U0 : Hom W1 I) (cc : CT.Ch W1 n (C.res W1 I U0 x) y) (lU : PB.Lands W1 I s.pQ U0) (R : Wt.Pn n W1)
    (W2 : Ob) (w : Hom W2 W1) (lU' : PB.Lands W2 I s.pQ (compH W2 W1 I U0 w)) {
   module A1 = RC[n, W1, y, U0, cc, lU, R] ;
   module K = CL.Rk[W2, W1, I, w, U0, x, n, y, cc] ;
   R' : Wt.Pn n W2 = Wt.Res[n, W2, W1, w, R].res ;
   module A2 = RC[n, W2, K.tz, K.Uw, DO.rCh W2 W1 I w U0 x n y cc, lU', R'] ;
   Xv' : TC.TOb = A2.Xv ;
   -- the cartesian map over w between the two stages, a levelwise map
   k0 : TR.RN.Hom0 Xv' A1.Xv = (w, C.res-comp W2 W1 I U0 w x) ;
   k : TC.THm Xv' A1.Xv = TR.fn.onH Xv' A1.Xv k0 ;
   f0 : TR.RN.Hom0 A1.Xv X = (U0, refl A1.ry) ;
   f0' : TR.RN.Hom0 Xv' X = (K.Uw, refl K.ry') ;
   Efk : Id (TC.THm Xv' X) (TC.tcomp Xv' A1.Xv X A1.f k) A2.f =
    transH (symH (TR.fn.onComp Xv' A1.Xv X f0 k0))
     (apH {TR.RN.Hom0 Xv' X} {TC.THm Xv' X} (TR.fn.onH Xv' X)
        (TR.DS.pairEq W2 K.ry' I x K.Uw K.Uw (refl K.Uw) (G0.GB.BC.oC Xv' A1.Xv X f0 k0).2 (refl K.ry'))) ;
   qA : DO.Idx W1 A1.ry = (n, W2, compH W2 W1 W1 (idH W1) w, K.tz, K.cA, R'.1) ;
   qB : DO.Idx W1 A1.ry = (n, W2, compH W2 W2 W1 w (idH W2), K.tz, K.cB K.ry' K.ek, R'.1) ;
   s1 : Id (DA.Ez W2 K.tz) (DA.E.act (W2, K.tz) (W1, y) (w, C.cart W2 W1 w y) A1.val) (rdT A1.Xv A1.t qA R'.2) =
    A1.t.2.2.1 (A1.q0, (W2, w)) R.2 ;
   s2 : Id (DA.Ez W2 K.tz) (rdT A1.Xv A1.t qA R'.2) (rdT A1.Xv A1.t qB R'.2) =
    apH {D.S W1 A1.ry n W2 K.tz} {DA.Ez W2 K.tz} (\ sw -> DA.rdP W1 A1.ry A1.t.1 A1.t.2.1 n W2 K.tz R'.1 sw R'.2)
     (transH (D.sEq W1 A1.ry n W2 K.tz (compH W2 W1 W1 (idH W1) w) w (comp-idl W2 W1 w) K.cA K.F K.lawA)
        (symH (D.sEq W1 A1.ry n W2 K.tz (compH W2 W2 W1 w (idH W2)) w (comp-idr W2 W1 w) (K.cB K.ry' K.ek) K.F (K.lawB K.ry' K.ek)))) ;
   s3 : Id (DA.Ez W2 K.tz) (rdT A1.Xv A1.t qB R'.2) (rdT Xv' (EE.act Xv' A1.Xv k A1.t) A2.q0 R'.2) =
    symH (actRd Xv' A1.Xv k A1.t A2.q0 R'.2) ;
   s4 : Id (LA.P.SigT LA.DG DA.DTy Xv') (EE.act Xv' A1.Xv k A1.t) A2.t =
    transH (s.pnat Xv' A1.Xv k A1.f lU lU')
     (LA.PD.pv-hom X gm s Xv' (TC.tcomp Xv' A1.Xv X A1.f k) A2.f Efk lU' lU') ;
   nat : Id (DA.Ez W2 K.tz) (DA.E.act (W2, K.tz) (W1, y) (w, C.cart W2 W1 w y) A1.val) A2.val =
    transH s1 (transH s2 (transH s3
     (apH {LA.P.SigT LA.DG DA.DTy Xv'} {DA.Ez W2 K.tz} (\ tt -> rdT Xv' tt A2.q0 R'.2) s4))) ;
  } ;
 } ;
} ;
