-- CTotTrMod.seg (canonicity-c2; SIMPLIFIED.md, Lemma 31 for Tr): the
-- truncation Tr A at the total site is D-modal: tau : Tr A -> (D Tr A)[tau]
-- is an equivalence (internally, in the fibrant CwF of the total site).
-- Both sides are propositions (Tr A by contrTr; D Tr A by CTotDProp4, its
-- levelwise hypothesis by CTotUProp3), and there are maps both ways (tau,
-- and r of CTotRr), so CwFPropNoU.eqvP applies.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

-- a natural map X -> Y as an element of Y over G.X
module NE (C : CIntCat[a, vl].IC) (G : CTotR[a, vl, l].TotR[C].P1.PCtx) (X Y : CTotR[a, vl, l].TotR[C].P1.PTy[G])
  (n : CTotR[a, vl, l].TotR[C].G1.GB.CHtpyOps[l].NMap[G, X, Y]) {
 module P1 = CTotR[a, vl, l].TotR[C].P1 ;
 E : P1.PCtx = P1.extP G X ;
 Yw : P1.PTy[E] = P1.subTy E G Y (P1.pP G X) ;
 ob (Z : CTotCat[a, vl, l].TotOf[C].TOb) (w : W0.Ix (E.ob Z)) : W0.Ix (Yw.tob Z w) = n.nfun Z w.1 w.2 ;
 nat (J I : CTotCat[a, vl, l].TotOf[C].TOb) (f : CTotCat[a, vl, l].TotOf[C].THm J I) (x : W0.Ix (E.ob I)) (y : W0.Ix (E.ob J))
   (e : Id (W0.Ix (E.ob J)) (E.act J I f x) y) : Id (W0.Ix (Yw.tob J y)) (Yw.tact J I f x y e (ob I x)) (ob J y) =
  idJ (W0.Ix (E.ob J)) (E.act J I f x) (\ y2 e2 -> Id (W0.Ix (Yw.tob J y2)) (Yw.tact J I f x y2 e2 (ob I x)) (ob J y2))
    (transH (n.nnat J I f x.1 (E.act J I f x).1 (P1.ntEq E G (P1.pP G X) J I f x (E.act J I f x) (refl (E.act J I f x))) x.2)
       (apH {W0.Ix (X.tob J (E.act J I f x).1)} {W0.Ix (Y.tob J (E.act J I f x).1)} (n.nfun J (E.act J I f x).1)
          (P1.tact-irr G X J I f x.1 (E.act J I f x).1 (P1.ntEq E G (P1.pP G X) J I f x (E.act J I f x) (refl (E.act J I f x)))
             (refl (G.act J I f x.1)) x.2)))
    y e ;
 el : P1.PEl[E, Yw] = P1.mkPEl E Yw ob nat ;
} ;

module TM (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 GP : G1.fibCwF-T.Ctx = TC.toP G ;
 module TT = CTotTr[a, vl, l].TotTr[C].Tr[GP, A] ;
 Tr : G1.fibCwF-T.Ty GP = TT.Tr ;
 module PN1 = CwFPropNoU.PropNoU[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T, G1.nf-T] ;
 module OV = CwFOv.Ov[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T] ;
 propTr : G1.fibCwF-T.El GP (PN1.isProp GP Tr) = PN1.propOver GP Tr TT.contrTr ;
 module UP = CTotUProp3[a, vl, l].UP3[C, GP, Tr] ;
 pU : UP.G0.fibCwF-T.El UP.UG (UP.PN0.isProp UP.UG UP.UA) = UP.At[propTr].isPropU ;
 -- D Tr A is a proposition over D G, hence so is its pullback along tau
 module DP = CTotDProp4[a, vl, l].DP4[C, G, Tr] ;
 DG : G1.fibCwF-T.Ctx = DP.P3.DG ;
 DT : G1.fibCwF-T.Ty DG = DP.P3.DAT ;
 propD : G1.fibCwF-T.El DG (PN1.isProp DG DT) = DP.At[pU].isPropD ;
 tS : G1.fibCwF-T.Sub GP DG = TC.toPS G DP.P3.DA.D.DCtx DP.P3.DA.D.tauS ;
 Bt : G1.fibCwF-T.Ty GP = G1.fibCwF-T.subT GP DG DT tS ;
 propBt : G1.fibCwF-T.El GP (PN1.isProp GP Bt) =
  OV.trE GP (G1.fibCwF-T.subT GP DG (PN1.isProp DG DT) tS) (PN1.isProp GP Bt)
    (PN1.isProp-ov GP DG DT tS Bt (refl Bt)) (G1.fibCwF-T.subt GP DG (PN1.isProp DG DT) propD tS) ;
 -- the maps both ways: tau (natural along total maps by L14b.NatE) and r
 module RR = CTotRr[a, vl, l].Rr[C, G, TT.T0.1] ;
 module HO = TR.G1.GB.CHtpyOps[l] ;
 tauN : HO.NMap[GP, Tr.1, Bt.1] =
  new HO.NMap[GP, Tr.1, Bt.1, \ X g av -> RR.LB.TA.tauA X.1 X.2 g av,
   \ Y X h g g' e av -> RR.LB.NatE[Y.1, X.1, h.1, Y.2, X.2, h.2, g, av].law g' e
     (TR.P1.ntEq GP (TC.toP DP.P3.DA.D.DCtx) tS Y X h g g' e)] ;
 rN : HO.NMap[GP, Bt.1, Tr.1] =
  new HO.NMap[GP, Bt.1, Tr.1, \ X g xi -> RR.r X g xi, \ Y X h g g' e xi -> RR.rN Y X h g g' e xi] ;
 f : G1.fibCwF-T.El GP (OV.Fun GP Tr Bt) = OV.lam GP Tr (OV.wkT GP Tr Bt) (NE[C, GP, Tr.1, Bt.1, tauN].el) ;
 g : G1.fibCwF-T.El GP (OV.Fun GP Bt Tr) = OV.lam GP Bt (OV.wkT GP Bt Tr) (NE[C, GP, Bt.1, Tr.1, rN].el) ;
 -- MODALITY: tau_{Tr A} is an equivalence
 modal : G1.fibCwF-T.El GP (PN1.EQ.Equiv GP Tr Bt) = PN1.eqvP GP Tr Bt propTr propBt f g ;
} ;
