-- CTotSet1.seg (canonicity-c2; "D preserves h-sets", part 1): for A a set
-- over G at the total site, the relation R over D G . D A . D A:
--   phi2    D G . D A . D A -> D (G.A.A): Pair at G.A after CTotDProp2's mS
--   IdA     Id of A between the two variables over G.A.A
--   R       D (IdA) pulled back along phi2, a proposition (CTotDProp4,
--           its levelwise hypothesis by CTotUProp3 from A being a set)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST1 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module P2 = CTotDProp2[a, vl, l].DP2[C, G, A.1] ;
 module P1m = P2.P1m ;
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module P1 = TR.P1 ;
 module TC = P1m.TC ;
 module OV = CwFOv.Ov[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T] ;
 module PN1 = CwFPropNoU.PropNoU[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T, G1.nf-T] ;
 GP : G1.fibCwF-T.Ctx = P1m.GP ;
 module Pair2 = CTotPsi11[a, vl, l].Psi11[C, P1m.ET, CTotR[a, vl, l].TotR[C].G1.GB.src true].Pair[P1m.A1] ;
 EP : G1.fibCwF-T.Ctx = P1m.EP ;
 A1F : G1.fibCwF-T.Ty EP = G1.fibCwF-T.subT EP GP A (G1.fibCwF-T.p GP A) ;
 E1 : G1.fibCwF-T.Ctx = Pair2.DA.E ;
 GAA : CTPsh[a, vl, l].TPshOf[C].TCtx = Pair2.ET ;
 A2 : G1.fibCwF-T.Ty E1 = G1.fibCwF-T.subT E1 EP A1F (G1.fibCwF-T.p EP A1F) ;
 IdA : G1.fibCwF-T.Ty E1 = G1.fibId-T.IdT E1 A2 (OV.wkE EP A1F A1F (G1.fibCwF-T.q GP A)) (G1.fibCwF-T.q EP A1F) ;
 -- phi2
 K : P1.PCtx = P1.extP P2.PR.Ext P2.SF ;
 phi2 : P1.PSub[K, Pair2.DEP] =
  new P1.PSub[K, Pair2.DEP, \ W v -> Pair2.phi W (P2.mS W v), \ J I f v ->
    transH (apH {P2.TS0.EI J} {W0.Ix (Pair2.DEP.ob J)} (\ z -> Pair2.phi J z) (symH (P2.NS[J, I, f, v].law)))
      (Pair2.phiN J I f (P2.mS I v))] ;
} ;
