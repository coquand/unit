-- CTotL14a.seg (canonicity-45; SIMPLIFIED.md step 4): the unit of D on
-- types at the total site, tau_A : A -> (D A)[tau_G] (Lemma 14, part a).
-- For g a point of G at (I, x) and av over it, tauA g av is the family
--   q l |-> A acted on along the total map (u, tmap c) of the index q
-- over the point (tau g) at q (the action's point equation is refl).
-- Read in the total space E = G.A, it is D's unit tau_E at (g, av): so its
-- three equations are tau_E's (CobarI.DC.Tau over TC.ofP E), on the nose,
-- and its naturality along total maps is tau_E's (tau-nat), read back by
-- pr-inj.
--   tauA I x g av : DA.TOb' I x (D.tau I x g)
--   tauA-nat     : D A's action on tauA g av is tauA at the acted point
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module TauA (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module P = Presheaf[vl, l].Psh[TC.TotCat] ;
 module VT = CVert[a, vl].VertOf[C] ;
 module DO = CobarI[a, vl, l].DOfI[C] ;
 module DA = CobarIT[a, vl, l].DTI[C, G, A] ;
 module D = DA.D ;
 E : P.PCtx = DA.E ;
 module DE = DO.DC[TC.ofP E] ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 -- the family
 tv (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (av : W0.Ix (A.tob (I, x) g)) : DA.TA I x (D.tau I x g) = \ q l ->
  A.tact (q.2.1, q.2.2.2.1) (I, x) (q.2.2.1, D.tmap I x q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) g ((D.tau I x g).1 q l)
   (refl ((D.tau I x g).1 q l)) av ;
 -- read in the total space, it is tau_E
 rd (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (av : W0.Ix (A.tob (I, x) g)) (q : DA.Idx I x) (l : DA.LandsI I x q)
  : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 ((D.tau I x g).1 q l) (tv I x g av q l)) ((DE.tau I x (P.pairE DA.GP A (I, x) g av)).1 q l) =
  refl (DA.prz q.2.1 q.2.2.2.1 ((D.tau I x g).1 q l) (tv I x g av q l)) ;
 tauA (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (av : W0.Ix (A.tob (I, x) g)) : DA.TOb' I x (D.tau I x g) =
  (tv I x g av, (DE.tau I x (P.pairE DA.GP A (I, x) g av)).2) ;
 -- naturality along a total map (u0, f0) : (J0, y) -> (I, x)
 module Nat (J0 I : Ob) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y x) (g : W0.Ix (G.ob I x)) (av : W0.Ix (A.tob (I, x) g)) {
  g' : W0.Ix (G.ob J0 y) = G.act J0 I u0 y x f0 g ;
  av' : W0.Ix (A.tob (J0, y) g') = A.tact (J0, y) (I, x) (u0, f0) g g' (refl g') av ;
  pr : W0.Ix (E.ob (I, x)) = P.pairE DA.GP A (I, x) g av ;
  e : Id (D.Ob' J0 y) (D.act J0 I u0 y x f0 (D.tau I x g)) (D.tau J0 y g') = symH (D.tau-nat J0 I u0 y x f0 g) ;
  module TB = DA.TB[J0, I, u0, y, x, f0, D.tau I x g, D.tau J0 y g', e, tauA I x g av] ;
  law : Id (DA.TOb' J0 y (D.tau J0 y g')) TB.res (tauA J0 y g' av') =
   DA.tob-eq J0 y (D.tau J0 y g') TB.res (tauA J0 y g' av') (\ q l ->
    DA.pr-inj q.2.1 q.2.2.2.1 ((D.tau J0 y g').1 q l) (TB.a' q l) (tv J0 y g' av' q l)
     (transH (TB.pc q l) (apH {DE.Ob' J0 y} {DA.Ez q.2.1 q.2.2.2.1} (\ d -> d.1 q l) (symH (DE.tau-nat J0 I u0 y x f0 pr))))) ;
 } ;
} ;
