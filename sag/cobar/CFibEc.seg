-- CFibEc.seg (canonicity-45; COBAR.md "Prop 58"): the closed copy Ec of
-- yo(y).A over the empty context is fibrant: Prop 58's fibrancy of Yy.Ay
-- over D (CRho1's fbA), pulled back along the point nil -> D (CFibSub) and
-- moved to Ec, which has the same fibres and action (CCart), as CFibTc did
-- for G's fibres.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module FE (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module CB = CCeBase[a].CB[R, encK, pe, y, u, y'] ;
 module C1 = CB.EH.UP.RS.RD.Cp[y'] ;
 Nl : L.PCtx = CB.Nl ;
 Ec : L.PTy[Nl] = CB.Ec ;
 D : L.PCtx = C1.D ;
 sP : L.PSub[Nl, D] = new L.PSub[Nl, D, \ W k -> k, \ Vv W g k -> refl (D.act Vv W g k)] ;
 St : L.PTy[Nl] = L.subTy Nl D C1.Yy.Ay sP ;
 fbN : PB.CLine[a+].Lines[Nl, St].Fib = PB.CFibSub[a+].FibSub[Nl, D, sP, C1.Yy.Ay].sub C1.fbA ;
 module TS = PB.GPre[a+].TyL[Nl, St] ;
 module TT = PB.GPre[a+].TyL[Nl, Ec] ;
 ta (W : Ob) (v : TT.EI W) : TS.EI W = TS.pr W v.1 v.2 ;
 module MV = PB.CCart[a+, a+].Cart[Nl, Ec, Nl, St, \ W o -> o, \ Vv W g o -> refl (Nl.act Vv W g o), ta, \ W v -> refl v.1,
   \ Vv W g v -> refl (ta Vv (TT.E.act Vv W g v)), \ W v v' Pp Q -> Q, \ X x w -> w, \ X x w -> refl (TS.pr X x w)] ;
 fbEc : PB.CLine[a+].Lines[Nl, Ec].Fib = MV.moveFib fbN ;
 EcS : FibCwF[a, a+].FC.STy Nl = (Ec, fbEc) ;
} ;
