-- CUG13.seg (canonicity-c2; the generic (U), part 13 of CCmpU13's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU13 with
-- F2 replaced by s.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module UG13 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) {
 module HZ = CHomT3[a].HomP[R, encK, pe].Hom[s, y] ;
 module L = PosFull[a].PB.GPre[a+].PS ;
 module HO = PosFull[a].PB.CHtpyOps[a+] ;
 module BZ = HZ.B0 ;
 module E6 = CwFQuotElim6[a].QE6[R, encK, s, pe] ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = C.ext Nl H ;
 QA : C.Ty Nl = HZ.AS.Qt ;
 QY : C.Ty Nl = HZ.AT.Qt ;
 MapT : C.Ty Nl = OV.Fun Nl QA QY ;
 MTh : C.Ty GH = OV.wkT Nl H MapT ;
 QH : C.Ty GH = E6.EPH[H].QH ;
 QYh : C.Ty GH = OV.wkT Nl H QY ;
 -- a map component pk of the point of nil.H, natural (nil acts trivially)
 module MZ (pk : (K : Ob) (w : V1.Ix (GH.ob K)) -> V1.Ix (MapT.1.tob K w.1))
   (pkN : (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I))
     -> Id (V1.Ix (MapT.1.tob J w.1)) (MapT.1.tact J I f w.1 w.1 (refl w.1) (pk I w)) (pk J (GH.act J I f w))) {
  eqA (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id Top w.1 w.1 = L.ntEq GH Nl (L.pP Nl H.1) J I f w (GH.act J I f w) (refl (GH.act J I f w)) ;
  -- as an element of the weakened map type
  eB (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I))
    : Id (V1.Ix (MTh.1.tob J (GH.act J I f w))) (MTh.1.tact J I f w (GH.act J I f w) (refl (GH.act J I f w)) (pk I w)) (pk J (GH.act J I f w)) =
   transH (L.tact-irr Nl MapT.1 J I f w.1 w.1 (eqA J I f w) (refl w.1) (pk I w)) (pkN J I f w) ;
  e : C.El GH MTh = L.mkPEl GH MTh.1 pk (\ J I f w w' e0 ->
   idJ (V1.Ix (GH.ob J)) (GH.act J I f w) (\ w2 e2 -> Id (V1.Ix (MTh.1.tob J w2)) (MTh.1.tact J I f w w2 e2 (pk I w)) (pk J w2))
     (eB J I f w) w' e0) ;
  -- evaluation as a natural map QH -> QYh
  nf (K : Ob) (w : V1.Ix (GH.ob K)) (u : V1.Ix (QH.1.tob K w)) : V1.Ix (QYh.1.tob K w) = BZ.hv K w.1 (pk K w) u ;
  nB (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) (u : V1.Ix (QH.1.tob I w))
    : Id (V1.Ix (QYh.1.tob J (GH.act J I f w))) (QYh.1.tact J I f w (GH.act J I f w) (refl (GH.act J I f w)) (nf I w u))
         (nf J (GH.act J I f w) (QH.1.tact J I f w (GH.act J I f w) (refl (GH.act J I f w)) u)) =
   transH (L.tact-irr Nl QY.1 J I f w.1 w.1 (eqA J I f w) (refl w.1) (nf I w u))
    (transH (symH (BZ.NTh[I, J, f, w.1, pk I w, u].law))
     (transH (apH {V1.Ix (MapT.1.tob J w.1)} {V1.Ix (QY.1.tob J w.1)} (\ m -> BZ.hv J w.1 m (BZ.rsS I J f w.1 u)) (pkN J I f w))
       (apH {V1.Ix (QA.1.tob J w.1)} {V1.Ix (QY.1.tob J w.1)} (\ v -> BZ.hv J w.1 (pk J (GH.act J I f w)) v)
          (L.tact-irr Nl QA.1 J I f w.1 w.1 (refl w.1) (eqA J I f w) u)))) ;
  nm : HO.NMap[GH, QH.1, QYh.1] = new HO.NMap[GH, QH.1, QYh.1, nf, \ J I f w w' e0 u ->
   idJ (V1.Ix (GH.ob J)) (GH.act J I f w) (\ w2 e2 -> Id (V1.Ix (QYh.1.tob J w2)) (QYh.1.tact J I f w w2 e2 (nf I w u)) (nf J w2 (QH.1.tact J I f w w2 e2 u)))
     (nB J I f w u) w' e0] ;
  fC : C.El GH (OV.Fun GH QH QYh) = QinvEq[a, a+].FunOf[GH, QH, QYh, nm].fC ;
  -- its value at a weakened closed class
  apC (c : C.El Nl QA) : C.El GH QYh = OV.app GH QH QYh fC (OV.wkE Nl H QA c) ;
  rdF (c : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) ((apC c).eob K w) (nf K w (c.eob K w.1)) =
   transH (CCmpU1[a].AppG[GH, QH, QYh, fC, OV.wkE Nl H QA c].rd K w)
     (QinvEq[a, a+].FunOf[GH, QH, QYh, nm].bod-eq K (w, c.eob K w.1)) ;
  -- the same value as a map applied (atv of the body)
  atC (c : C.El Nl QA) : C.El GH QYh = PT.atv GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) fC) (OV.wkE Nl H QA c) ;
  rdV (c : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) ((atC c).eob K w) (nf K w (c.eob K w.1)) =
   transH (CAppRd[a].trE-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
            (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c))
            (C.subt GH (C.ext GH QH) (OV.wkT GH QH QYh) (OV.bod GH QH (OV.wkT GH QH QYh) fC) (C.sec GH QH (OV.wkE Nl H QA c))) K w)
    (transH (CAppRd[a].same-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
              (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c)) K w (refl (QYh.1.tob K w))
              ((OV.bod GH QH (OV.wkT GH QH QYh) fC).eob K (w, c.eob K w.1)))
      (QinvEq[a, a+].FunOf[GH, QH, QYh, nm].bod-eq K (w, c.eob K w.1))) ;
 } ;
 module ZA = MZ[\ K w -> (pkA K w).1, \ J I f w -> apH {V1.Ix (HZ.HomT.1.tob J w.1)} {V1.Ix (MapT.1.tob J w.1)} (\ z -> z.1) (pkAN J I f w)] ;
 module ZB = MZ[\ K w -> (pkB K w).1, \ J I f w -> apH {V1.Ix (HZ.HomT.1.tob J w.1)} {V1.Ix (MapT.1.tob J w.1)} (\ z -> z.1) (pkBN J I f w)] ;
} ;
