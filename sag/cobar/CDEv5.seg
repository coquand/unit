-- CDEv5.seg (canonicity-c2; (d), part 5): the reading of the sum of two
-- values of ev as ev of the sum term (for CDEv4.Bin at addition).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module DE5 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) {
 module DE4m = CDEv4[a].DE4[R, encK, pe, s, y] ;
 module DE2m = DE4m.DE2m ;
 module D = DE2m.D ;
 module HZ = D.HZ ;
 module AS = HZ.AS ;
 module U20m = DE2m.U20m ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = D.HS ;
 QY : C.Ty Nl = D.QY ;
 D1 : C.Ctx = D.D1 ;
 Tm : U a = DE2m.Tm ;
 module OA = CCmpU18[a].OpH[D1, QY, HZ.AT.O.addQ, C.p Nl HS] ;
 module OM = CCmpU18[a].OpH[D1, QY, HZ.AT.O.mulQ, C.p Nl HS] ;
 rA (p q : Tm) (K : Ob) (z : V1.Ix (HS.1.tob K tt)) : Id (D.QK K (tt, z)) ((OA.P2[D.evT p, D.evT q].val).eob K (tt, z)) ((D.evT (sumE p q)).eob K (tt, z)) =
  transH (OA.P2[D.evT p, D.evT q].rd K (tt, z))
   (transH (apH {D.QK K (tt, z)} {D.QK K (tt, z)} (\ u -> OA.SO.ev2 K tt u ((D.evT q).eob K (tt, z))) (D.evTr p K z))
     (transH (apH {D.QK K (tt, z)} {D.QK K (tt, z)} (\ u -> OA.SO.ev2 K tt (D.EV.ev D.n p K (D.vT K tt z)) u) (D.evTr q K z))
       (symH (D.evTr (sumE p q) K z)))) ;
} ;
