-- CTotSet6.seg (canonicity-c2; "D preserves h-sets", part 6): reading an
-- element of Id_A at an interval point. psi j (e , w) is the reading of
-- the path w at (id , j), projected to G.A; it is natural:
--   (e , w) . h  read at  j . h   is   (psi j (e , w)) . h
-- (GPosIdY's rd-nat on one side, Tact.rdc on the other).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST6 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module S3 = CTotSet3[a, vl, l].ST3[C, G, A] ;
 module S1 = S3.S1 ;
 module G1 = S1.G1 ;
 module P1 = S1.P1 ;
 module TC = S1.TC ;
 module Y = S3.Y ;
 E1 : P1.PCtx = S3.E1 ;
 GP : P1.PCtx = S1.GP ;
 EI : P1.PCtx = P1.extP E1 S3.IdYT ;
 EA : P1.PCtx = P1.extP GP A.1 ;
 proj (Z : TC.TOb) (y : Y.TA.EI Z) : W0.Ix (EA.ob Z) = P1.pairE GP A.1 Z y.1.1.1 y.2 ;
 psi (Z : TC.TOb) (j : G1.GB.IvP Z) (X : W0.Ix (EI.ob Z)) : W0.Ix (EA.ob Z) =
  proj Z (Y.rd Z X.1 X.2 Z (G1.GB.BC.idC Z) j) ;
 -- proj is natural
 projN (Z' Z : TC.TOb) (h : TC.THm Z' Z) (y : Y.TA.EI Z)
   : Id (W0.Ix (EA.ob Z')) (EA.act Z' Z h (proj Z y)) (proj Z' (Y.TA.E.act Z' Z h y)) =
  apH {W0.Ix (A.1.tob Z' (GP.act Z' Z h y.1.1.1))} {W0.Ix (EA.ob Z')} (\ c -> P1.pairE GP A.1 Z' (GP.act Z' Z h y.1.1.1) c)
    (P1.tact-irr GP A.1 Z' Z h y.1.1.1 (GP.act Z' Z h y.1.1.1) (refl (GP.act Z' Z h y.1.1.1))
       (P1.ntEq S1.EP GP (P1.pP GP A.1) Z' Z h y.1.1 (E1.act Z' Z h y.1).1
          (P1.ntEq E1 S1.EP (P1.pP S1.EP S1.A1F.1) Z' Z h y.1 (E1.act Z' Z h y.1) (refl (E1.act Z' Z h y.1)))) y.2) ;
 module PN (Z' Z : TC.TOb) (h : TC.THm Z' Z) (j : G1.GB.IvP Z) (X : W0.Ix (EI.ob Z)) {
  e : W0.Ix (E1.ob Z) = X.1 ;
  w : W0.Ix (Y.tob Z e) = X.2 ;
  j' : G1.GB.IvP Z' = G1.GB.ivA Z' Z h j ;
  module T = Y.Tact[Z', Z, h, e, E1.act Z' Z h e, refl (E1.act Z' Z h e), w] ;
  s1 : Id (Y.TA.EI Z') (Y.TA.E.act Z' Z h (Y.rd Z e w Z (G1.GB.BC.idC Z) j)) (Y.rd Z e w Z' (G1.GB.BC.oC Z' Z Z (G1.GB.BC.idC Z) h) j') =
   Y.rd-nat Z e w Z' Z h (G1.GB.BC.idC Z) j ;
  s2 : Id (Y.TA.EI Z') (Y.rd Z e w Z' (G1.GB.BC.oC Z' Z Z (G1.GB.BC.idC Z) h) j') (Y.rd Z e w Z' (G1.GB.BC.oC Z' Z' Z h (G1.GB.BC.idC Z')) j') =
   apH {TC.THm Z' Z} {Y.TA.EI Z'} (\ k -> Y.rd Z e w Z' k j')
     (transH (G1.GB.BC.oC-idl Z' Z h) (symH (G1.GB.BC.oC-idr Z' Z h))) ;
  s3 : Id (Y.TA.EI Z') (Y.rd Z e w Z' (G1.GB.BC.oC Z' Z' Z h (G1.GB.BC.idC Z')) j') (Y.rd Z' (E1.act Z' Z h e) (Y.tactY Z' Z h e (E1.act Z' Z h e) (refl (E1.act Z' Z h e)) w) Z' (G1.GB.BC.idC Z') j') =
   symH (T.rdc Z' (G1.GB.BC.idC Z') j') ;
  law : Id (W0.Ix (EA.ob Z')) (EA.act Z' Z h (psi Z j X)) (psi Z' j' (EI.act Z' Z h X)) =
   transH (projN Z' Z h (Y.rd Z e w Z (G1.GB.BC.idC Z) j))
     (apH {Y.TA.EI Z'} {W0.Ix (EA.ob Z')} (proj Z') (transH s1 (transH s2 s3))) ;
 } ;
} ;
