-- CPshNFC.seg (canonicity-c2; COBAR.md): naive function extensionality
-- in the CwF of uniformly fibrant C-types (FibNF part (C) at the
-- C-level).  For f , g : Pi A B and h : Pi x Id(f x , g x), the element
-- nf of Id(f , g) is CPshNF.NFC.nf applied to the function of h: the
-- types and elements of CFibCwF are those of the raw CwF, the Pi of
-- CPshPiFibC.FPiC and the Id of CPshIdJ4.PIdJ have the raw Pi and Id
-- as first components.
-- Premises: those of CPshNF, CPshPiFibC, CPshIdJ4 (fe, univ).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module NFCOf (C : SmallCat[a].SmallCat) {
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module PL = CPshPiLaws[a, l].PiLawOf[C] ;
 module NFm = CPshNF[a, l].NFOf[C] ;
 module PCl = CPshPiFibC[a, l].PiClOf[C] ;
 module IJ = CPshIdJ4[a, l].IdJOf[C] ;
 CF : CwF.CwF[l+] = UF.CFibCwF ;

 nf (G : CF.Ctx) (A : CF.Ty G) (B : CF.Ty (CF.ext G A))
    (f g : CF.El G (PCl.FPiC.SPi.Pi G A B))
    (h : CF.El G (PCl.FPiC.SPi.Pi G A (IJ.PIdJ.IdT (CF.ext G A) B
           ((PCl.FPiC.SPi.Pi-iso G A B).fun f) ((PCl.FPiC.SPi.Pi-iso G A B).fun g))))
  : CF.El G (IJ.PIdJ.IdT G (PCl.FPiC.SPi.Pi G A B) f g) =
  NFm.NFC[G, A.1, B.1, f, g,
     PL.L[G, A.1, (IJ.PIdJ.IdT (CF.ext G A) B
           ((PCl.FPiC.SPi.Pi-iso G A B).fun f) ((PCl.FPiC.SPi.Pi-iso G A B).fun g)).1].App[h].app].nf ;
} ;
