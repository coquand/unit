-- The three-generator comparison in the levelwise form consumed by
-- Proposition 13.  Equivalence data for its fibres is the remaining input.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Cmp3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module FC = CFree3Assoc[a].Free3Comparison[R, encK, pe] ;
  module CC = CCopy[a].ConcC[R, encK, pe] ;
  module CM = CC.CM ;
  module TR = CC.TR ;
  module CT = CTotCtxTy[a, a+, a+].CtxTy[CM.IC] ;
  module O3 = CT.Of[FC.Y3] ;
  module O111 = CT.Of[FC.Y111] ;
  cS : TR.P1.PSub[CT.TC.toP FC.Y3, CT.TC.toP FC.Y111] =
    CT.TC.toPS FC.Y3 FC.Y111 FC.cmpS ;
  cmpF : TR.G1.GB.CPartial[a+].PMap[CT.P1, O3.Y1T, O111.Y1T] =
    TR.G1.GB.CPartial[a+].mkPMap CT.P1 O3.Y1T O111.Y1T
      (\ X w -> (w.1, cS.nt X w.2)) (\ X w -> refl w.1)
      (\ Z X h w -> apH {V1.Ix ((CT.TC.toP FC.Y111).ob Z)}
        {V1.Ix ((TR.P1.extP CT.P1 O111.Y1T).ob Z)}
        (\ g -> (CT.P1.act Z X h w.1, g)) (cS.nt-nat Z X h w.2)) ;
  module PD = CTotP13d[a, a+, a+].P13d[CM.IC, CT.T1, O3.Y1T, O111.Y1T, cmpF] ;
} ;
