-- CTotLvl3.seg (canonicity-c2; SIMPLIFIED.md step 4): the levelwise input
-- of the fibration half of Lemma 12, part 3: the lift back of a levelwise
-- strict-fibre element (bk: CTotUFib's extension, moved along ext-rho),
-- bkMv, and al: the levelwise filler of U A (from its fibration
-- structure) moved by CMove.Mv to a contraction of U of the strict fibre
-- at the total site.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;

module Lvl3 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (d : Bool) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 e : TR.G1.GB.IPt = TR.G1.GB.src d ;
 module L2 = CTotLvl2[a, vl, l].Lvl2[C, G, A, e] ;
 module L1 = L2.L1 ;
 module PO = L1.PO ;
 module G0 = TR.G0 ;
 module EKm = L1.EKm ;
 module EK1 = L1.EK1 ;
 module EK0 = L1.EK0 ;
 module XB = EKm.XB ;
 Ob0 : U vl = TR.RN.Ob0 ;
 UG : TR.P0.PCtx = TR.RS.rC PO.GP ;
 UA : TR.P0.PTy[UG] = TR.RS.rT PO.GP A ;

 -- the two bases have the same end points
 srcEq : (d2 : Bool) -> Id G0.GB.IPt (G0.GB.src d2) (TR.G1.GB.src d2) = split {
  true -> refl G0.GB.e0 ;
  false -> refl G0.GB.e1 } ;
 module BK (Y : Ob0) (x : W0.Ix (L1.DU.ob Y)) (u0 : W0.Ix (EK0.SFm.sfOb Y (L1.s Y x))) {
  module P = L1.PT[Y, x] ;
  module XS = EKm.XS[Y, EK0.TS.pr Y (L1.s Y x) u0] ;
  zP : Id (EK1.TV.EI (TR.RN.o Y)) XS.Z.z1 x =
   EK1.tv-eq (TR.RN.o Y) XS.Z.z1 x (XB.ext-rho Y P.x1) (transH XS.Z.endEq P.pc) ;
  pU : Id (EK1.TV.EI (TR.RN.o Y)) (EK1.TS.pr1 (TR.RN.o Y) XS.u1) x =
   transH (EK1.mkTS-pt (TR.RN.o Y) XS.Z.z1 XS.L.line (refl XS.Z.x1) XS.q) zP ;
  bk : W0.Ix (EK1.SFm.sfOb (TR.RN.o Y) x) = EK1.TS.coeT (TR.RN.o Y) (EK1.TS.pr1 (TR.RN.o Y) XS.u1) x pU (EK1.TS.pr2 (TR.RN.o Y) XS.u1) ;
 } ;
} ;
