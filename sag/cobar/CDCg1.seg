-- CDCg1.seg (canonicity-c2; (d), congruence part 1): over D1 = nil.HomT(s, y),
-- a second valuation s2 : D1 -> nil.Q_y^n, ev_t at it (ev2T), its reading,
-- and the congruence step at an operation (CCmpU18.Ap2).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module Cg1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (s2 : C.Sub (C.ext C.nil (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT)) (CSolT[a].SolOf[R, encK, pe, s, (zero, nil), y].EV.Gk s.1)) {
 module DE5m = CDEv5[a].DE5[R, encK, pe, s, y] ;
 module D = DE5m.D ;
 module EV = D.EV ;
 Nl : C.Ctx = C.nil ;
 n : Nat = D.n ;
 HS : C.Ty Nl = D.HS ;
 QY : C.Ty Nl = D.QY ;
 D1 : C.Ctx = D.D1 ;
 QYd : C.Ty D1 = D.QYd ;
 Tm : U a = DE5m.Tm ;
 PQ2 : Id (C.Ty D1) (C.subT D1 (EV.Gk n) (EV.Qk n) s2) QYd =
  transH (symH (C.subT-o D1 (EV.Gk n) Nl QY (C.eps (EV.Gk n)) s2))
   (apH {C.Sub D1 Nl} {C.Ty D1} (\ t -> C.subT D1 Nl QY t) (transH (C.eps-uniq D1 (C.o D1 (EV.Gk n) Nl (C.eps (EV.Gk n)) s2)) (symH (C.eps-uniq D1 (C.p Nl HS))))) ;
 ev2T (t : Tm) : C.El D1 QYd = OV.trE D1 (C.subT D1 (EV.Gk n) (EV.Qk n) s2) QYd PQ2 (C.subt D1 (EV.Gk n) (EV.Qk n) (EV.evE n t) s2) ;
 ev2Tr (t : Tm) (K : Ob) (z : V1.Ix (HS.1.tob K tt)) : Id (D.QK K (tt, z)) ((ev2T t).eob K (tt, z)) (EV.ev n t K (s2.nt K (tt, z))) =
  transH (CAppRd[a].trE-rd D1 (C.subT D1 (EV.Gk n) (EV.Qk n) s2) QYd PQ2 (C.subt D1 (EV.Gk n) (EV.Qk n) (EV.evE n t) s2) K (tt, z))
   (CAppRd[a].same-rd D1 (C.subT D1 (EV.Gk n) (EV.Qk n) s2) QYd PQ2 K (tt, z) (refl (QYd.1.tob K (tt, z))) (EV.ev n t K (s2.nt K (tt, z)))) ;
 CE (t : Tm) : C.Ty D1 = IJ.IdT D1 QYd (D.evT t) (ev2T t) ;
 -- constants
 cr (r : R.R) (K : Ob) : (o : Top) (z : V1.Ix (HS.1.tob K o)) -> Id (D.QK K (o, z)) ((D.evT (cst r)).eob K (o, z)) ((ev2T (cst r)).eob K (o, z)) =
  split { tt -> \ z -> transH (D.evTr (cst r) K z) (symH (ev2Tr (cst r) K z)) } ;
 cgC (r : R.R) : C.El D1 (CE (cst r)) =
  D.rwId D1 QYd (D.evT (cst r)) (D.evT (cst r)) (D.evT (cst r)) (ev2T (cst r)) (\ K w -> refl ((D.evT (cst r)).eob K w)) (\ K w -> cr r K w.1 w.2)
   (IJ.rfl D1 QYd (D.evT (cst r))) ;
} ;
