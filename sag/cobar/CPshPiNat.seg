-- CPshPiNat.seg (canonicity-c2; COBAR.md (B) stage 2(c)): Pi_A B is
-- stable under C-substitution (Pi-nat of CwF.Formers.PiStr on CPCwF).
--
-- For s : D -> G write A' = A[s], B' = B[lift s].  At x and a point d
-- of D_x, a family b of (Pi_A B)_x over s d is sent to the family
--     tr b y f = b y f moved along s.sb-nat, then along the base Pi-nat
-- of (Pi_{A'} B')_x over d.
--   trVal     the values of tr b, read in G, are the values of b
--   natTo , natFrom   b is natural in C iff tr b is (trVal, cnat-at)
-- So the codes agree (SigV-cong, propV-ext), the actions agree
-- componentwise (the base Pi-nat is a path of types), and the C-actions
-- agree (transports of one component along paths of points).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module VC = VCode[l] ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;

------------------------------------------------------------------------
-- transport of the elements of a base type along a path of types

tyTr (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (X : Ob) (p : W0.Ix (Gb.ob X)) (v : W0.Ix (T.tob X p)) : W0.Ix (T'.tob X p) =
 subst (PTy[Gb]) (\ T1 -> W0.Ix (T1.tob X p)) T T' Pt v ;
-- it is the transport along any path of codes
tyTr-ob (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (X : Ob) (p : W0.Ix (Gb.ob X))
 (R : Id W0.V (T.tob X p) (T'.tob X p)) (v : W0.Ix (T.tob X p))
 : Id (W0.Ix (T'.tob X p)) (tyTr Gb T T' Pt X p v) (VC.substIx (T.tob X p) (T'.tob X p) R v) =
 idJ (PTy[Gb]) T
  (\ T1 P1 -> (R1 : Id W0.V (T.tob X p) (T1.tob X p)) -> Id (W0.Ix (T1.tob X p)) (tyTr Gb T T1 P1 X p v) (VC.substIx (T.tob X p) (T1.tob X p) R1 v))
  (\ R1 -> apH (\ R2 -> VC.substIx (T.tob X p) (T.tob X p) R2 v) (W0.isSetV (T.tob X p) (T.tob X p) (refl (T.tob X p)) R1))
  T' Pt R ;
tyTr-coeIx (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (X : Ob) (p : W0.Ix (Gb.ob X))
 (R : Id W0.V (T.tob X p) (T'.tob X p)) (v : W0.Ix (T.tob X p))
 : Id (W0.Ix (T'.tob X p)) (tyTr Gb T T' Pt X p v) (PP.coeIx (T.tob X p) (T'.tob X p) R v) =
 idJ (PTy[Gb]) T
  (\ T1 P1 -> (R1 : Id W0.V (T.tob X p) (T1.tob X p)) -> Id (W0.Ix (T1.tob X p)) (tyTr Gb T T1 P1 X p v) (PP.coeIx (T.tob X p) (T1.tob X p) R1 v))
  (\ R1 -> apH (\ R2 -> PP.coeIx (T.tob X p) (T.tob X p) R2 v) (W0.isSetV (T.tob X p) (T.tob X p) (refl (T.tob X p)) R1))
  T' Pt R ;
-- it commutes with the actions and with the transports along points
tyTr-tact (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (J I : Ob) (k : Hom J I) (p : W0.Ix (Gb.ob I)) (p' : W0.Ix (Gb.ob J))
 (e : Id (W0.Ix (Gb.ob J)) (Gb.act J I k p) p') (v : W0.Ix (T.tob I p))
 : Id (W0.Ix (T'.tob J p')) (tyTr Gb T T' Pt J p' (T.tact J I k p p' e v)) (T'.tact J I k p p' e (tyTr Gb T T' Pt I p v)) =
 idJ (PTy[Gb]) T
  (\ T1 P1 -> Id (W0.Ix (T1.tob J p')) (tyTr Gb T T1 P1 J p' (T.tact J I k p p' e v)) (T1.tact J I k p p' e (tyTr Gb T T1 P1 I p v)))
  (refl (T.tact J I k p p' e v)) T' Pt ;
tyTr-coe (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (X : Ob) (p p' : W0.Ix (Gb.ob X)) (q : Id (W0.Ix (Gb.ob X)) p p')
 (v : W0.Ix (T.tob X p))
 : Id (W0.Ix (T'.tob X p')) (tyTr Gb T T' Pt X p' (GPR.TyL[Gb, T].coeT X p p' q v)) (GPR.TyL[Gb, T'].coeT X p p' q (tyTr Gb T T' Pt X p v)) =
 idJ (PTy[Gb]) T
  (\ T1 P1 -> Id (W0.Ix (T1.tob X p')) (tyTr Gb T T1 P1 X p' (GPR.TyL[Gb, T].coeT X p p' q v)) (GPR.TyL[Gb, T1].coeT X p p' q (tyTr Gb T T1 P1 X p v)))
  (refl (GPR.TyL[Gb, T].coeT X p p' q v)) T' Pt ;

-- transports along points: irrelevance, composition, actions
coeT-irr (Gb : PCtx) (T : PTy[Gb]) (X : Ob) (p p' : W0.Ix (Gb.ob X)) (q q' : Id (W0.Ix (Gb.ob X)) p p') (v : W0.Ix (T.tob X p))
 : Id (W0.Ix (T.tob X p')) (GPR.TyL[Gb, T].coeT X p p' q v) (GPR.TyL[Gb, T].coeT X p p' q' v) =
 apH (\ q1 -> GPR.TyL[Gb, T].coeT X p p' q1 v) (W0.isSetIx (Gb.ob X) p p' q q') ;
coeT-coeT (Gb : PCtx) (T : PTy[Gb]) (X : Ob) (p p' p'' : W0.Ix (Gb.ob X)) (q1 : Id (W0.Ix (Gb.ob X)) p p')
 (q2 : Id (W0.Ix (Gb.ob X)) p' p'') (q : Id (W0.Ix (Gb.ob X)) p p'') (v : W0.Ix (T.tob X p))
 : Id (W0.Ix (T.tob X p'')) (GPR.TyL[Gb, T].coeT X p' p'' q2 (GPR.TyL[Gb, T].coeT X p p' q1 v)) (GPR.TyL[Gb, T].coeT X p p'' q v) =
 idJ (W0.Ix (Gb.ob X)) p'
  (\ p2 q2' -> (q0 : Id (W0.Ix (Gb.ob X)) p p2)
     -> Id (W0.Ix (T.tob X p2)) (GPR.TyL[Gb, T].coeT X p' p2 q2' (GPR.TyL[Gb, T].coeT X p p' q1 v)) (GPR.TyL[Gb, T].coeT X p p2 q0 v))
  (\ q0 -> coeT-irr Gb T X p p' q1 q0 v) p'' q2 q ;
coeT-tact (Gb : PCtx) (T : PTy[Gb]) (J I : Ob) (k : Hom J I) (p0 p : W0.Ix (Gb.ob I)) (Q : Id (W0.Ix (Gb.ob I)) p0 p)
 (z0 z : W0.Ix (Gb.ob J)) (Qz : Id (W0.Ix (Gb.ob J)) z0 z)
 (e0 : Id (W0.Ix (Gb.ob J)) (Gb.act J I k p0) z0) (e : Id (W0.Ix (Gb.ob J)) (Gb.act J I k p) z) (v : W0.Ix (T.tob I p0))
 : Id (W0.Ix (T.tob J z)) (T.tact J I k p z e (GPR.TyL[Gb, T].coeT I p0 p Q v)) (GPR.TyL[Gb, T].coeT J z0 z Qz (T.tact J I k p0 z0 e0 v)) =
 idJ (W0.Ix (Gb.ob I)) p0
  (\ p1 Q1 -> (e1 : Id (W0.Ix (Gb.ob J)) (Gb.act J I k p1) z)
     -> Id (W0.Ix (T.tob J z)) (T.tact J I k p1 z e1 (GPR.TyL[Gb, T].coeT I p0 p1 Q1 v)) (GPR.TyL[Gb, T].coeT J z0 z Qz (T.tact J I k p0 z0 e0 v)))
  (\ e1 -> idJ (W0.Ix (Gb.ob J)) z0
     (\ z1 Qz1 -> (e2 : Id (W0.Ix (Gb.ob J)) (Gb.act J I k p0) z1)
        -> Id (W0.Ix (T.tob J z1)) (T.tact J I k p0 z1 e2 v) (GPR.TyL[Gb, T].coeT J z0 z1 Qz1 (T.tact J I k p0 z0 e0 v)))
     (\ e2 -> tact-irr Gb T J I k p0 z0 e2 e0 v) z Qz e1)
  p Q e ;

-- transports along paths of codes
obTr-ob (Gb : PCtx) (o o' : TOb Gb) (PO : Id (TOb Gb) o o') (X : Ob) (p : W0.Ix (Gb.ob X))
 (R : Id W0.V (o X p) (o' X p)) (u : W0.Ix (o X p))
 : Id (W0.Ix (o' X p)) (subst (TOb Gb) (\ o1 -> W0.Ix (o1 X p)) o o' PO u) (VC.substIx (o X p) (o' X p) R u) =
 idJ (TOb Gb) o
  (\ o1 P1 -> (R1 : Id W0.V (o X p) (o1 X p)) -> Id (W0.Ix (o1 X p)) (subst (TOb Gb) (\ o2 -> W0.Ix (o2 X p)) o o1 P1 u) (VC.substIx (o X p) (o1 X p) R1 u))
  (\ R1 -> apH (\ R2 -> VC.substIx (o X p) (o X p) R2 u) (W0.isSetV (o X p) (o X p) (refl (o X p)) R1))
  o' PO R ;
coeT-ob (Gb : PCtx) (T : PTy[Gb]) (X : Ob) (p p' : W0.Ix (Gb.ob X)) (q : Id (W0.Ix (Gb.ob X)) p p')
 (R : Id W0.V (T.tob X p) (T.tob X p')) (v : W0.Ix (T.tob X p))
 : Id (W0.Ix (T.tob X p')) (GPR.TyL[Gb, T].coeT X p p' q v) (VC.substIx (T.tob X p) (T.tob X p') R v) =
 idJ (W0.Ix (Gb.ob X)) p
  (\ p1 q1 -> (R1 : Id W0.V (T.tob X p) (T.tob X p1)) -> Id (W0.Ix (T.tob X p1)) (GPR.TyL[Gb, T].coeT X p p1 q1 v) (VC.substIx (T.tob X p) (T.tob X p1) R1 v))
  (\ R1 -> apH (\ R2 -> VC.substIx (T.tob X p) (T.tob X p) R2 v) (W0.isSetV (T.tob X p) (T.tob X p) (refl (T.tob X p)) R1))
  p' q R ;
substIx-trans (X0 X1 X2 : W0.V) (R1 : Id W0.V X0 X1) (R2 : Id W0.V X1 X2) (R : Id W0.V X0 X2) (v : W0.Ix X0)
 : Id (W0.Ix X2) (VC.substIx X1 X2 R2 (VC.substIx X0 X1 R1 v)) (VC.substIx X0 X2 R v) =
 idJ W0.V X1
  (\ X3 R3 -> (R0 : Id W0.V X0 X3) -> Id (W0.Ix X3) (VC.substIx X1 X3 R3 (VC.substIx X0 X1 R1 v)) (VC.substIx X0 X3 R0 v))
  (\ R0 -> VC.substV-irr X0 X1 R1 R0 v) X2 R2 R ;
-- the first component of a transport along SigV-cong
sig0 (A0 : W0.V) (B0 B2 : W0.Ix A0 -> W0.V) (E : Id (W0.Ix A0 -> W0.V) B0 B2) (u : W0.Ix (W0.SigV A0 B0))
 : Id (W0.Ix A0) (VC.substIx (W0.SigV A0 B0) (W0.SigV A0 B2) (apH (W0.SigV A0) E) u).1 u.1 =
 idJ (W0.Ix A0 -> W0.V) B0
  (\ B3 E3 -> Id (W0.Ix A0) (VC.substIx (W0.SigV A0 B0) (W0.SigV A0 B3) (apH (W0.SigV A0) E3) u).1 u.1)
  (refl u.1) B2 E ;
sigV-fst (A0 A1 : W0.V) (P : Id W0.V A0 A1) (B0 : W0.Ix A0 -> W0.V) (B1 : W0.Ix A1 -> W0.V)
 (Q : (z : W0.Ix A0) -> Id W0.V (B0 z) (B1 (VC.substIx A0 A1 P z))) (u : W0.Ix (W0.SigV A0 B0))
 : Id (W0.Ix A1) (VC.substIx (W0.SigV A0 B0) (W0.SigV A1 B1) (VC.SigV-cong A0 A1 P B0 B1 Q) u).1 (VC.substIx A0 A1 P u.1) =
 idJ W0.V A0
  (\ A2 P2 -> (B2 : W0.Ix A2 -> W0.V) (Q2 : (z : W0.Ix A0) -> Id W0.V (B0 z) (B2 (VC.substIx A0 A2 P2 z)))
     -> Id (W0.Ix A2) (VC.substIx (W0.SigV A0 B0) (W0.SigV A2 B2) (VC.SigV-cong A0 A2 P2 B0 B2 Q2) u).1 (VC.substIx A0 A2 P2 u.1))
  (\ B2 Q2 -> sig0 A0 B0 B2 (funext (W0.Ix A0) (\ z -> W0.V) B0 B2 Q2) u)
  A1 P B1 Q ;

-- transport of a total along a path of types
totTr (Gb : PCtx) (T T' : PTy[Gb]) (Pt : Id (PTy[Gb]) T T') (X : Ob) (w : SigT Gb T X)
 : Id (SigT Gb T' X) (subst (PTy[Gb]) (\ T1 -> SigT Gb T1 X) T T' Pt w)
     (pairE Gb T' X (fstE Gb T X w) (tyTr Gb T T' Pt X (fstE Gb T X w) (sndE Gb T X w))) =
 idJ (PTy[Gb]) T
  (\ T1 P1 -> Id (SigT Gb T1 X) (subst (PTy[Gb]) (\ T2 -> SigT Gb T2 X) T T1 P1 w)
                (pairE Gb T1 X (fstE Gb T X w) (tyTr Gb T T1 P1 X (fstE Gb T X w) (sndE Gb T X w))))
  (refl w) T' Pt ;
-- transport along points in a substituted type
stCoe (Db Gb : PCtx) (T : PTy[Gb]) (sb : PSub[Db, Gb]) (X : Ob) (p p' : W0.Ix (Db.ob X)) (q : Id (W0.Ix (Db.ob X)) p p')
 (w : W0.Ix (T.tob X (sb.nt X p)))
 : Id (W0.Ix (T.tob X (sb.nt X p'))) (GPR.TyL[Db, subTy Db Gb T sb].coeT X p p' q w)
     (GPR.TyL[Gb, T].coeT X (sb.nt X p) (sb.nt X p') (apH (\ p1 -> sb.nt X p1) q) w) =
 idJ (W0.Ix (Db.ob X)) p
  (\ p1 q1 -> Id (W0.Ix (T.tob X (sb.nt X p1))) (GPR.TyL[Db, subTy Db Gb T sb].coeT X p p1 q1 w)
                (GPR.TyL[Gb, T].coeT X (sb.nt X p) (sb.nt X p1) (apH (\ p2 -> sb.nt X p2) q1) w))
  (refl w) p' q ;

module NatOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 open P ;


 -- transport along a path of families of codes, under CPshR's Prod
 FamT (x : CO) : U l+ = (y : CO) -> CH y x -> W0.V ;
 module RRr = CPshR[a, l].RR[C] ;
 prodTr (x : CO) (F F' : FamT x) (Q : Id (FamT x) F F') (R : (y : CO) (f : CH y x) -> Id W0.V (F y f) (F' y f))
  (b : W0.Ix (RRr.Prod x F)) (y : CO) (f : CH y x)
  : Id (W0.Ix (F' y f)) (VC.substIx (RRr.Prod x F) (RRr.Prod x F') (apH (\ F1 -> RRr.Prod x F1) Q) b y f) (VC.substIx (F y f) (F' y f) (R y f) (b y f)) =
  idJ (FamT x) F
   (\ F1 Q1 -> (R1 : (y1 : CO) (f1 : CH y1 x) -> Id W0.V (F y1 f1) (F1 y1 f1))
      -> Id (W0.Ix (F1 y f)) (VC.substIx (RRr.Prod x F) (RRr.Prod x F1) (apH (\ F2 -> RRr.Prod x F2) Q1) b y f) (VC.substIx (F y f) (F1 y f) (R1 y f) (b y f)))
   (\ R1 -> apH (\ R2 -> VC.substIx (F y f) (F y f) R2 (b y f)) (W0.isSetV (F y f) (F y f) (refl (F y f)) (R1 y f)))
   F' Q R ;

 module N (D G : CCtx) (s : CSub[D, G]) (A : CTy[G]) (B : CTy[LO.ExtC G A]) {
  A' : CTy[D] = LO.subCTy D G s A ;
  Ls : CSub[LO.ExtC D A', LO.ExtC G A] = CW.liftC D G A s ;
  B' : CTy[LO.ExtC D A'] = LO.subCTy (LO.ExtC D A') (LO.ExtC G A) Ls B ;
  module PG = PO.PiC[G, A, B] ;
  module PD = PO.PiC[D, A', B'] ;
  module SCA = LO.SC[D, G, s, A] ;
  module SCB = LO.SC[LO.ExtC D A', LO.ExtC G A, Ls, B] ;

  -- the base Pi-nat at y
  ST (y : CO) : PTy[D.ob y] = subTy (D.ob y) (G.ob y) (PG.PiB y) (s.sb y) ;
  NP (y : CO) : Id (PTy[D.ob y]) (ST y) (PD.PiB y) = PP.PiNat[D.ob y, G.ob y, A.ty y, B.ty y, s.sb y].PiP-nat ;

  module AtN (x : CO) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) {
   module SG = PG.At[x, X, (s.sb x).nt X d] ;
   module SD = PD.At[x, X, d] ;
   qS (y : CO) (f : CH y x) : Id (W0.Ix ((G.ob y).ob X)) (SG.ptC y f) ((s.sb y).nt X (SD.ptC y f)) = symH (s.sb-nat y x f X d) ;
   mvS (y : CO) (f : CH y x) (v : W0.Ix ((PG.PiB y).tob X (SG.ptC y f))) : W0.Ix ((ST y).tob X (SD.ptC y f)) =
    GPR.TyL[G.ob y, PG.PiB y].coeT X (SG.ptC y f) ((s.sb y).nt X (SD.ptC y f)) (qS y f) v ;
   trC (y : CO) (f : CH y x) (v : W0.Ix ((PG.PiB y).tob X (SG.ptC y f))) : W0.Ix ((PD.PiB y).tob X (SD.ptC y f)) =
    tyTr (D.ob y) (ST y) (PD.PiB y) (NP y) X (SD.ptC y f) (mvS y f v) ;
   tr (b : SG.Comp) : SD.Comp = \ y f -> trC y f (b y f) ;

   -- the values of tr b, read in G
   module TV (b : SG.Comp) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a' : SD.FA y f Y h) {
    module BN = PP.PiNat[D.ob y, G.ob y, A.ty y, B.ty y, s.sb y] ;
    pD : W0.Ix ((D.ob y).ob X) = SD.ptC y f ;
    v : W0.Ix ((ST y).tob X pD) = mvS y f (b y f) ;
    p0 : W0.Ix ((G.ob y).ob Y) = (G.ob y).act Y X h ((s.sb y).nt X pD) ;
    p1 : W0.Ix ((G.ob y).ob Y) = (s.sb y).nt Y (SD.ptH y f Y h) ;
    abk : W0.Ix ((A.ty y).tob Y p0) = PP.bk (G.ob y) (A.ty y) Y p0 p1 (BN.hs X pD Y h) a' ;
    wG : PG.TA y Y = PG.prA y Y p1 a' ;
    w0 : PG.TA y Y = PG.prA y Y p0 abk ;
    w0-wG : Id (PG.TA y Y) w0 wG = PP.pairpath (G.ob y) (A.ty y) Y p0 p1 (BN.hs X pD Y h) a' ;
    r1 : Id (W0.Ix ((G.ob y).ob Y)) p0 (SG.ptH y f Y h) = apH (\ p -> (G.ob y).act Y X h p) (symH (qS y f)) ;
    t1 : Id (W0.Ix ((B.ty y).tob Y wG)) ((tr b y f).1 Y h a')
          ((PP.coeIx ((ST y).tob X pD) ((PD.PiB y).tob X pD) (BN.RJ X pD) v).1 Y h a') =
     apH (\ u -> u.1 Y h a') (tyTr-coeIx (D.ob y) (ST y) (PD.PiB y) (NP y) X pD (BN.RJ X pD) v) ;
    t3 : Id (PG.TB y Y) (PG.prB y Y wG ((PP.coeIx ((ST y).tob X pD) ((PD.PiB y).tob X pD) (BN.RJ X pD) v).1 Y h a'))
          (PG.prB y Y w0 (v.1 Y h abk)) =
     transH (apH (\ val -> PG.prB y Y wG val) (BN.trS X pD v Y h a'))
      (symH (GPR.TyL[PG.E.ob y, B.ty y].pr-coe Y w0 wG w0-wG (v.1 Y h abk))) ;
    t4 : Id (PG.TB y Y) (PG.prB y Y w0 (v.1 Y h abk)) (SG.valAt b y f Y h w0 r1) =
     PG.coeVal y X (SG.ptC y f) ((s.sb y).nt X pD) (qS y f) (b y f) Y h abk r1 ;
    res (r : Id (W0.Ix ((G.ob y).ob Y)) p1 (SG.ptH y f Y h))
     : Id (PG.TB y Y) (PG.prB y Y wG ((tr b y f).1 Y h a')) (SG.valAt b y f Y h wG r) =
     transH (apH (\ val -> PG.prB y Y wG val) t1)
      (transH t3 (transH t4 (SG.valAt-cong b y f f (refl f) Y h h (refl h) w0 wG w0-wG r1 r))) ;
   } ;

   -- the point (act f d) h of D, read in G
   rPt (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) : Id (W0.Ix ((G.ob y).ob Y)) ((s.sb y).nt Y (SD.ptH y f Y h)) (SG.ptH y f Y h) =
    transH ((s.sb y).nt-nat Y X h (SD.ptC y f)) (apH (\ p -> (G.ob y).act Y X h p) (symH (qS y f))) ;

   -- naturality in C of b and of tr b, at (g , f , h , a'): the two
   -- sides of CNat for tr b, read in G, are the two sides for b
   module CN (b : SG.Comp) (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a' : SD.FA y f Y h) {
    module T1 = TV[b, y, f, Y, h, a'] ;
    module T2 = TV[b, z, co z y x f g, Y, h, SD.aM z y g f Y h a'] ;
    emv : Id (PG.TA z Y) ((A.tE z y g).nt Y T1.wG) T2.wG =
     transH (symH (SCA.rBtE z y g Y (PD.prA y Y (SD.ptH y f Y h) a'))) (apH (\ w -> SCA.rB z Y w) (SD.aM-mv z y g f Y h a')) ;
    R1 : Id (W0.Ix ((G.ob z).ob Y)) (fstE (G.ob z) (A.ty z) Y ((A.tE z y g).nt Y T1.wG)) (SG.ptH z (co z y x f g) Y h) =
     transH (apH (\ w -> fstE (G.ob z) (A.ty z) Y w) emv) (rPt z (co z y x f g) Y h) ;
    lD : PD.TB z Y = (B'.tE z y g).nt Y (SD.valT (tr b) y f Y h a') ;
    rD : PD.TB z Y = SD.valT (tr b) z (co z y x f g) Y h (SD.aM z y g f Y h a') ;
    lG : PG.TB z Y = (B.tE z y g).nt Y (SG.valAt b y f Y h T1.wG (rPt y f Y h)) ;
    rG : PG.TB z Y = SG.valAt b z (co z y x f g) Y h ((A.tE z y g).nt Y T1.wG) R1 ;
    eL : Id (PG.TB z Y) (SCB.rB z Y lD) lG =
     transH (SCB.rBtE z y g Y (SD.valT (tr b) y f Y h a')) (apH (\ v -> (B.tE z y g).nt Y v) (T1.res (rPt y f Y h))) ;
    eR : Id (PG.TB z Y) rG (SCB.rB z Y rD) =
     transH (SG.valAt-cong b z (co z y x f g) (co z y x f g) (refl (co z y x f g)) Y h h (refl h)
               ((A.tE z y g).nt Y T1.wG) T2.wG emv R1 (rPt z (co z y x f g) Y h))
      (symH (T2.res (rPt z (co z y x f g) Y h))) ;
    pth : Id (PD.TA z Y) (fstE (PD.E.ob z) (B'.ty z) Y lD) (fstE (PD.E.ob z) (B'.ty z) Y rD) =
     transH (B'.tE-pt z y g Y (SD.valT (tr b) y f Y h a')) (SD.aM-mv z y g f Y h a') ;
    to (nG : Id (PG.TB z Y) lG rG) : Id (PD.TB z Y) lD rD = SCB.sub-eq z Y lD rD pth (transH eL (transH nG eR)) ;
    from (nD : Id (PD.TB z Y) lD rD) : Id (PG.TB z Y) lG rG =
     transH (symH eL) (transH (apH (\ w -> SCB.rB z Y w) nD) (symH eR)) ;
   } ;
   natTo (u : SG.PiIx) : SD.CNat (tr u.1) = \ z y g f Y h a' ->
    CN[u.1, z, y, g, f, Y, h, a'].to
     (SG.cnat-at u z y g f Y h CN[u.1, z, y, g, f, Y, h, a'].T1.wG (rPt y f Y h) CN[u.1, z, y, g, f, Y, h, a'].R1) ;

   module NF (b : SG.Comp) (nD : SD.CNat (tr b)) (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a0 : SG.FA y f Y h) {
    a' : SD.FA y f Y h = GPR.TyL[G.ob y, A.ty y].coeT Y (SG.ptH y f Y h) ((s.sb y).nt Y (SD.ptH y f Y h)) (symH (rPt y f Y h)) a0 ;
    module K = CN[b, z, y, g, f, Y, h, a'] ;
    eA : Id (PG.TA y Y) (PG.prA y Y (SG.ptH y f Y h) a0) K.T1.wG =
     GPR.TyL[G.ob y, A.ty y].pr-coe Y (SG.ptH y f Y h) ((s.sb y).nt Y (SD.ptH y f Y h)) (symH (rPt y f Y h)) a0 ;
    e1 : Id (PG.TB z Y) ((B.tE z y g).nt Y (SG.valT b y f Y h a0)) K.lG =
     apH (\ v -> (B.tE z y g).nt Y v)
      (SG.valAt-cong b y f f (refl f) Y h h (refl h) (PG.prA y Y (SG.ptH y f Y h) a0) K.T1.wG eA (refl (SG.ptH y f Y h)) (rPt y f Y h)) ;
    e2 : Id (PG.TB z Y) K.rG (SG.valT b z (co z y x f g) Y h (SG.aM z y g f Y h a0)) =
     SG.valAt-cong b z (co z y x f g) (co z y x f g) (refl (co z y x f g)) Y h h (refl h)
      ((A.tE z y g).nt Y K.T1.wG) (SG.mvA z y g f Y h a0) (apH (\ w -> (A.tE z y g).nt Y w) (symH eA)) K.R1 (SG.mvPt z y g f Y h a0) ;
    res : SG.CNatAt b z y g f Y h a0 = transH e1 (transH (K.from (nD z y g f Y h a')) e2) ;
   } ;
   natFrom (b : SG.Comp) (nD : SD.CNat (tr b)) : SG.CNat b = \ z y g f Y h a0 -> NF[b, nD, z, y, g, f, Y, h, a0].res ;

   ----------------------------------------------------------------
   -- the path of codes, and the transport along it

   FG : FamT x = \ y f -> (PG.PiB y).tob X (SG.ptC y f) ;
   FD : FamT x = \ y f -> (PD.PiB y).tob X (SD.ptC y f) ;
   H1 (y : CO) (f : CH y x) : Id W0.V (FG y f) ((ST y).tob X (SD.ptC y f)) = apH (\ p -> (PG.PiB y).tob X p) (qS y f) ;
   H2 (y : CO) (f : CH y x) : Id W0.V ((ST y).tob X (SD.ptC y f)) (FD y f) = apH (\ T -> T.tob X (SD.ptC y f)) (NP y) ;
   H (y : CO) (f : CH y x) : Id W0.V (FG y f) (FD y f) = transH (H1 y f) (H2 y f) ;
   trC-H (y : CO) (f : CH y x) (v : W0.Ix (FG y f)) : Id (W0.Ix (FD y f)) (VC.substIx (FG y f) (FD y f) (H y f) v) (trC y f v) =
    symH (transH (tyTr-ob (D.ob y) (ST y) (PD.PiB y) (NP y) X (SD.ptC y f) (H2 y f) (mvS y f v))
           (transH (apH (\ w -> VC.substIx ((ST y).tob X (SD.ptC y f)) (FD y f) (H2 y f) w)
                      (coeT-ob (G.ob y) (PG.PiB y) X (SG.ptC y f) ((s.sb y).nt X (SD.ptC y f)) (qS y f) (H1 y f) v))
             (substIx-trans (FG y f) ((ST y).tob X (SD.ptC y f)) (FD y f) (H1 y f) (H2 y f) (H y f) v))) ;
   HQ : Id (FamT x) FG FD =
    funext CO (\ y -> CH y x -> W0.V) FG FD (\ y -> funext (CH y x) (\ f -> W0.V) (FG y) (FD y) (H y)) ;
   Pc : Id W0.V SG.compCode SD.compCode = apH (\ F1 -> RRr.Prod x F1) HQ ;
   compTr (b : SG.Comp) : Id SD.Comp (VC.substIx SG.compCode SD.compCode Pc b) (tr b) =
    RRr.funext2 x (\ y f -> W0.Ix (FD y f)) (VC.substIx SG.compCode SD.compCode Pc b) (tr b)
     (\ y f -> transH (prodTr x FG FD HQ H b y f) (trC-H y f (b y f))) ;
   Qn (b : SG.Comp) : Id W0.V (SG.natCode b) (SD.natCode (VC.substIx SG.compCode SD.compCode Pc b)) =
    transH (PO.propV-ext (SG.CNat b) (SD.CNat (tr b)) (SG.isProp-CNat b) (SD.isProp-CNat (tr b)) (\ n -> natTo (b, n)) (natFrom b))
     (apH (\ b1 -> SD.natCode b1) (symH (compTr b))) ;
   Pobj : Id W0.V SG.piO SD.piO = VC.SigV-cong SG.compCode SD.compCode Pc SG.natCode SD.natCode Qn ;
   -- the transport of u along any path of codes has the components tr u
   trO (R : Id W0.V SG.piO SD.piO) (u : SG.PiIx) : Id SD.Comp (VC.substIx SG.piO SD.piO R u).1 (tr u.1) =
    transH (apH (\ w -> w.1) (VC.substV-irr SG.piO SD.piO R Pobj u))
     (transH (sigV-fst SG.compCode SD.compCode Pc SG.natCode SD.natCode Qn u) (compTr u.1)) ;
  } ;

  ------------------------------------------------------------------
  -- the path of base types at x

  module SCP = LO.SC[D, G, s, PG.PiT] ;
  LT (x : CO) : PTy[D.ob x] = SCP.ST x ;
  PobjF (x : CO) : Id (TOb (D.ob x)) (LT x).tob (PD.piTy x).tob =
   funext Ob (\ X -> W0.Ix ((D.ob x).ob X) -> W0.V) (LT x).tob (PD.piTy x).tob (\ X ->
    funext (W0.Ix ((D.ob x).ob X)) (\ d -> W0.V) ((LT x).tob X) ((PD.piTy x).tob X) (\ d -> AtN[x, X, d].Pobj)) ;
  obT (x : CO) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) (u : AtN[x, X, d].SG.PiIx) : AtN[x, X, d].SD.PiIx =
   subst (TOb (D.ob x)) (\ o -> W0.Ix (o X d)) (LT x).tob (PD.piTy x).tob (PobjF x) u ;
  obT-fst (x : CO) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) (u : AtN[x, X, d].SG.PiIx)
   : Id (AtN[x, X, d].SD.Comp) (obT x X d u).1 (AtN[x, X, d].tr u.1) =
   transH (apH (\ w -> w.1) (obTr-ob (D.ob x) (LT x).tob (PD.piTy x).tob (PobjF x) X d AtN[x, X, d].Pobj u))
    (AtN[x, X, d].trO AtN[x, X, d].Pobj u) ;

  -- the base actions agree, componentwise
  module PW (x : CO) (J I : Ob) (k : Hom J I) (dd : W0.Ix ((D.ob x).ob I)) (dd' : W0.Ix ((D.ob x).ob J))
   (e : Id (W0.Ix ((D.ob x).ob J)) ((D.ob x).act J I k dd) dd') (u : AtN[x, I, dd].SG.PiIx) {
   module NI = AtN[x, I, dd] ;
   module NJ = AtN[x, J, dd'] ;
   module AG = PG.Act[x, J, I, k, (s.sb x).nt I dd, (s.sb x).nt J dd', ntEq (D.ob x) (G.ob x) (s.sb x) J I k dd dd' e] ;
   module AD = PD.Act[x, J, I, k, dd, dd', e] ;
   lhs : NJ.SD.PiIx = obT x J dd' ((LT x).tact J I k dd dd' e u) ;
   rhs : NJ.SD.PiIx = (PD.piTy x).tact J I k dd dd' e (obT x I dd u) ;
   c1 (y : CO) (f : CH y x) : Id (W0.Ix (NJ.FD y f)) (lhs.1 y f) (NJ.trC y f (AG.actC u.1 y f)) =
    apH (\ b -> b y f) (obT-fst x J dd' (AG.act u)) ;
   c2 (y : CO) (f : CH y x)
    : Id (W0.Ix (NJ.FD y f)) (NJ.trC y f (AG.actC u.1 y f))
        ((PD.PiB y).tact J I k (NI.SD.ptC y f) (NJ.SD.ptC y f) (AD.ePt y f) (NI.trC y f (u.1 y f))) =
    transH (apH (\ w -> tyTr (D.ob y) (ST y) (PD.PiB y) (NP y) J (NJ.SD.ptC y f) w)
              (symH (coeT-tact (G.ob y) (PG.PiB y) J I k (NI.SG.ptC y f) ((s.sb y).nt I (NI.SD.ptC y f)) (NI.qS y f)
                       (NJ.SG.ptC y f) ((s.sb y).nt J (NJ.SD.ptC y f)) (NJ.qS y f) (AG.ePt y f)
                       (ntEq (D.ob y) (G.ob y) (s.sb y) J I k (NI.SD.ptC y f) (NJ.SD.ptC y f) (AD.ePt y f)) (u.1 y f))))
     (tyTr-tact (D.ob y) (ST y) (PD.PiB y) (NP y) J I k (NI.SD.ptC y f) (NJ.SD.ptC y f) (AD.ePt y f) (NI.mvS y f (u.1 y f))) ;
   c3 (y : CO) (f : CH y x)
    : Id (W0.Ix (NJ.FD y f)) (rhs.1 y f)
        ((PD.PiB y).tact J I k (NI.SD.ptC y f) (NJ.SD.ptC y f) (AD.ePt y f) (NI.trC y f (u.1 y f))) =
    apH (\ b -> (PD.PiB y).tact J I k (NI.SD.ptC y f) (NJ.SD.ptC y f) (AD.ePt y f) (b y f)) (obT-fst x I dd u) ;
   res : Id NJ.SD.PiIx lhs rhs = NJ.SD.pi-eqC lhs rhs (\ y f -> transH (c1 y f) (transH (c2 y f) (symH (c3 y f)))) ;
  } ;
  Pf (x : CO) : Id (PTy[D.ob x]) (LT x) (PD.piTy x) =
   ty-ext2 (D.ob x) (LT x) (PD.piTy x) (PobjF x) (\ J I k dd dd' e u -> PW[x, J, I, k, dd, dd', e, u].res) ;
  trFst (x : CO) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) (u : AtN[x, X, d].SG.PiIx)
   : Id (AtN[x, X, d].SD.Comp) (tyTr (D.ob x) (LT x) (PD.piTy x) (Pf x) X d u).1 (AtN[x, X, d].tr u.1) =
   transH (apH (\ w -> w.1) (tyTr-ob (D.ob x) (LT x) (PD.piTy x) (Pf x) X d AtN[x, X, d].Pobj u))
    (AtN[x, X, d].trO AtN[x, X, d].Pobj u) ;

  ------------------------------------------------------------------
  -- the C-actions agree: at (y' , f') both sides are the component
  -- (y' , f f') of u, moved along a path of points, then along NP y'

  -- a family moved along a path of points, componentwise
  piCoe (y : CO) (X : Ob) (g1 g2 : W0.Ix ((G.ob y).ob X)) (q : Id (W0.Ix ((G.ob y).ob X)) g1 g2) (W : PG.At[y, X, g1].PiIx)
   (y' : CO) (f' : CH y' y)
   : Id (W0.Ix ((PG.PiB y').tob X (PG.At[y, X, g2].ptC y' f')))
       ((GPR.TyL[G.ob y, PG.piTy y].coeT X g1 g2 q W).1 y' f')
       (GPR.TyL[G.ob y', PG.PiB y'].coeT X (PG.At[y, X, g1].ptC y' f') (PG.At[y, X, g2].ptC y' f')
          (apH (\ g -> (G.act y' y f').nt X g) q) (W.1 y' f')) =
   idJ (W0.Ix ((G.ob y).ob X)) g1
    (\ g3 q3 -> Id (W0.Ix ((PG.PiB y').tob X (PG.At[y, X, g3].ptC y' f')))
       ((GPR.TyL[G.ob y, PG.piTy y].coeT X g1 g3 q3 W).1 y' f')
       (GPR.TyL[G.ob y', PG.PiB y'].coeT X (PG.At[y, X, g1].ptC y' f') (PG.At[y, X, g3].ptC y' f')
          (apH (\ g -> (G.act y' y f').nt X g) q3) (W.1 y' f')))
    (refl (W.1 y' f')) g2 q ;

  module QQ (y x : CO) (f : CH y x) (X : Ob) (w : SigT (D.ob x) (LT x) X) {
   d : W0.Ix ((D.ob x).ob X) = fstE (D.ob x) (LT x) X w ;
   dy : W0.Ix ((D.ob y).ob X) = (D.act y x f).nt X d ;
   module Nx = AtN[x, X, d] ;
   module Ny = AtN[y, X, dy] ;
   u : Nx.SG.PiIx = sndE (D.ob x) (LT x) X w ;
   uT : Nx.SD.PiIx = tyTr (D.ob x) (LT x) (PD.piTy x) (Pf x) X d u ;
   module CD = PD.CAct[y, x, f, X, d] ;
   module CG = PG.CAct[y, x, f, X, (s.sb x).nt X d] ;
   g1 : W0.Ix ((G.ob y).ob X) = (G.act y x f).nt X ((s.sb x).nt X d) ;
   g2 : W0.Ix ((G.ob y).ob X) = (s.sb y).nt X dy ;
   pth : Id (W0.Ix ((G.ob y).ob X)) g1 g2 = SCP.pth y x f X w ;
   Wg : PG.At[y, X, g1].PiIx = CG.rix u ;
   Wc : Ny.SG.PiIx = GPR.TyL[G.ob y, PG.piTy y].coeT X g1 g2 pth Wg ;
   lhsU : Ny.SD.PiIx = CD.rix uT ;
   rhsU : Ny.SD.PiIx = tyTr (D.ob y) (LT y) (PD.piTy y) (Pf y) X dy Wc ;

   module QC (y' : CO) (f' : CH y' y) {
    ff : CH y' x = co y' y x f f' ;
    v : W0.Ix (Nx.FG y' ff) = u.1 y' ff ;
    pGx : W0.Ix ((G.ob y').ob X) = Nx.SG.ptC y' ff ;
    pDx : W0.Ix ((D.ob y').ob X) = Nx.SD.ptC y' ff ;
    pDy : W0.Ix ((D.ob y').ob X) = Ny.SD.ptC y' f' ;
    qPD : Id (W0.Ix ((D.ob y').ob X)) pDx pDy = CD.qP y' f' ;
    qstar : Id (W0.Ix ((G.ob y').ob X)) pGx ((s.sb y').nt X pDy) =
     transH (Nx.qS y' ff) (apH (\ p1 -> (s.sb y').nt X p1) qPD) ;
    mid : W0.Ix ((ST y').tob X pDy) = GPR.TyL[G.ob y', PG.PiB y'].coeT X pGx ((s.sb y').nt X pDy) qstar v ;
    l1 : Id (W0.Ix (Ny.FD y' f')) (lhsU.1 y' f') (GPR.TyL[D.ob y', PD.PiB y'].coeT X pDx pDy qPD (Nx.trC y' ff v)) =
     apH (\ b -> GPR.TyL[D.ob y', PD.PiB y'].coeT X pDx pDy qPD (b y' ff)) (trFst x X d u) ;
    l2 : Id (W0.Ix (Ny.FD y' f')) (GPR.TyL[D.ob y', PD.PiB y'].coeT X pDx pDy qPD (Nx.trC y' ff v))
          (tyTr (D.ob y') (ST y') (PD.PiB y') (NP y') X pDy (GPR.TyL[D.ob y', ST y'].coeT X pDx pDy qPD (Nx.mvS y' ff v))) =
     symH (tyTr-coe (D.ob y') (ST y') (PD.PiB y') (NP y') X pDx pDy qPD (Nx.mvS y' ff v)) ;
    l3 : Id (W0.Ix ((ST y').tob X pDy)) (GPR.TyL[D.ob y', ST y'].coeT X pDx pDy qPD (Nx.mvS y' ff v)) mid =
     transH (stCoe (D.ob y') (G.ob y') (PG.PiB y') (s.sb y') X pDx pDy qPD (Nx.mvS y' ff v))
      (coeT-coeT (G.ob y') (PG.PiB y') X pGx ((s.sb y').nt X pDx) ((s.sb y').nt X pDy) (Nx.qS y' ff)
         (apH (\ p1 -> (s.sb y').nt X p1) qPD) qstar v) ;
    r1 : Id (W0.Ix (Ny.FD y' f')) (rhsU.1 y' f') (Ny.trC y' f' (Wc.1 y' f')) = apH (\ b -> b y' f') (trFst y X dy Wc) ;
    r2 : Id (W0.Ix ((PG.PiB y').tob X (Ny.SG.ptC y' f'))) (Wc.1 y' f')
          (GPR.TyL[G.ob y', PG.PiB y'].coeT X (PG.At[y, X, g1].ptC y' f') (Ny.SG.ptC y' f')
             (apH (\ g -> (G.act y' y f').nt X g) pth) (Wg.1 y' f')) =
     piCoe y X g1 g2 pth Wg y' f' ;
    r3 : Id (W0.Ix ((ST y').tob X pDy)) (Ny.mvS y' f' (Wc.1 y' f')) mid =
     transH (apH (\ w1 -> Ny.mvS y' f' w1) r2)
      (transH (apH (\ w1 -> Ny.mvS y' f' w1)
                 (coeT-coeT (G.ob y') (PG.PiB y') X pGx (PG.At[y, X, g1].ptC y' f') (Ny.SG.ptC y' f') (CG.qP y' f')
                    (apH (\ g -> (G.act y' y f').nt X g) pth)
                    (transH (CG.qP y' f') (apH (\ g -> (G.act y' y f').nt X g) pth)) v))
        (coeT-coeT (G.ob y') (PG.PiB y') X pGx (Ny.SG.ptC y' f') ((s.sb y').nt X pDy)
           (transH (CG.qP y' f') (apH (\ g -> (G.act y' y f').nt X g) pth)) (Ny.qS y' f') qstar v)) ;
    res : Id (W0.Ix (Ny.FD y' f')) (lhsU.1 y' f') (rhsU.1 y' f') =
     transH l1 (transH l2
      (transH (apH (\ w1 -> tyTr (D.ob y') (ST y') (PD.PiB y') (NP y') X pDy w1) (transH l3 (symH r3))) (symH r1))) ;
   } ;
   eq : Id Ny.SD.PiIx lhsU rhsU = Ny.SD.pi-eqC lhsU rhsU (\ y' f' -> QC[y', f'].res) ;
   res : Id (SigT (D.ob y) (PD.piTy y) X)
          ((PD.PiT.tE y x f).nt X (subst (PTy[D.ob x]) (\ T -> SigT (D.ob x) T X) (LT x) (PD.piTy x) (Pf x) w))
          (subst (PTy[D.ob y]) (\ T -> SigT (D.ob y) T X) (LT y) (PD.piTy y) (Pf y) ((SCP.subCTy.tE y x f).nt X w)) =
    transH (apH (\ w1 -> PD.tEn y x f X w1) (totTr (D.ob x) (LT x) (PD.piTy x) (Pf x) X w))
     (transH (apH (\ U1 -> PD.prP y X dy U1) eq)
       (symH (totTr (D.ob y) (LT y) (PD.piTy y) (Pf y) X ((SCP.subCTy.tE y x f).nt X w)))) ;
  } ;

  -- Pi-nat
  PiT-nat : Id (CTy[D]) (LO.subCTy D G s PG.PiT) PD.PiT =
   EX.cty-ext2 D (LO.subCTy D G s PG.PiT) PD.PiT Pf (\ y x f X w -> QQ[y, x, f, X, w].res) ;
 } ;
} ;
