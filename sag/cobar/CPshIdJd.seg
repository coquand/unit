-- CPshIdJd.seg (part 4 of the Id instance, canonicity-45): the J-data of
-- PosIdYJ (prY, lamY, psiY) at x and y commute with the C-action of the
-- record's motive context Dx along f : y -> x.  The projection by A.tE-pt,
-- the sieve by construction, the contraction by readings: the K-point of
-- lamY z at (W, h, j) is the reading of z's path at (h, j) (CIdJ.LV.kp-E),
-- its path reads z's path at (h g, cI (j g) k) (PosIdYJ.FromJ.uJ-E), and
-- readings move by A.tE (CPshId.rd-C through CPshL.SC.rBtE).
--   JDC[G, A, a, y, x, f] : prEq, lamEq, psiEq for CPshJNatT.JNatT

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module FBC = FibCwF[a, l] ;
module PYJ = PosIdYJ[a, l] ;

module IdJdOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module IdM = CPshId[a, l].IdOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 open P ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;
 module DRC = JA.DRC ;

 module JDC (G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (y x : CO) (f : CH y x) {
  Dc : CCtx = DRC.Dx G A a0 ;
  -- the Yoneda J-data at x and y
  module Yx = PYJ.YJ[G.ob x, A.1.ty x, a0.el x] ;
  module Yy = PYJ.YJ[G.ob y, A.1.ty y, a0.el y] ;
  -- the C-types of the record's IK, and their actions
  Kc : CCtx = LO.ExtC G A.1 ;
  Bc : CTy[Kc] = (DRC.Ap G A).1 ;
  module SCB = LO.SC[Kc, G, LO.pPC G A.1, A.1] ;
  module IK = IdM.IdC[Kc, Bc, DRC.ap' G A a0, CW.qC G A.1] ;
  module TAx = GPR.TyL[G.ob x, A.1.ty x] ;
  module TAy = GPR.TyL[G.ob y, A.1.ty y] ;
  upD (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) : W0.Ix ((Dc.ob y).ob X) = (Dc.act y x f).nt X z ;
  kA (X : Ob) (k : W0.Ix (Yx.K.ob X)) : W0.Ix (Yy.K.ob X) = (A.1.tE y x f).nt X k ;

  -- readings of a moved Yoneda path are A.tE of the readings
  rdGC (X : Ob) (k : W0.Ix (Yx.K.ob X)) (w : W0.Ix (Yx.YK.tob X k)) (W : Ob) (h : Hom W X) (j : Hom W Iv)
   : Id (TAy.EI W) (Yy.rdG X (kA X k) (IK.TC[y, x, f, X, k, w].res) W h j) ((A.1.tE y x f).nt W (Yx.rdG X k w W h j)) =
   transH (apH (Yy.SEB.mV W) (IK.rd-C y x f X k w W h j))
     (SCB.rBtE y x f W (Yx.YK.rd X k w W h j)) ;
  opaque rdGC ;

  -- the projection commutes
  prEq (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) : Id (W0.Ix ((G.ob y).ob X)) (Yy.prY.nt X (upD X z)) ((G.act y x f).nt X (Yx.prY.nt X z)) =
   A.1.tE-pt y x f X (Yx.TY.pr1 X z) ;
  -- the sieve commutes
  psiEq (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) : Id (PB.Phi X) (Yx.psiY X z) (Yy.psiY X (upD X z)) =
   refl (Yx.psiY X z) ;

  -- the contraction commutes: at (W, h, j), the two points of DY at y
  module Lam (X : Ob) (z : W0.Ix ((Dc.ob x).ob X)) (W : Ob) (h : Hom W X) (j : Hom W Iv) {
   k : W0.Ix (Yx.K.ob X) = Yx.TY.pr1 X z ;
   w : W0.Ix (Yx.YK.tob X k) = Yx.TY.pr2 X z ;
   module Lx = Yx.IJ.LV[X, Yx.ioV X z, W, h, j] ;
   module Ly = Yy.IJ.LV[X, Yy.ioV X (upD X z), W, h, j] ;
   -- the two points
   z1 : W0.Ix ((Dc.ob y).ob W) = (Dc.act y x f).nt W (Yx.oiV W Lx.v) ;
   z2 : W0.Ix ((Dc.ob y).ob W) = Yy.oiV W Ly.v ;
   -- the readings of the moved core path are A.tE of the readings
   uC (V : Ob) (g : Hom V W) (j' : Hom V Iv)
    : Id (TAy.EI V) (Ly.u.1.1 V (compH V W X h g) (PB.cI true V (compH V W Iv j g) j'))
        ((A.1.tE y x f).nt V (Lx.u.1.1 V (compH V W X h g) (PB.cI true V (compH V W Iv j g) j'))) =
    rdGC X k w V (compH V W X h g) (PB.cI true V (compH V W Iv j g) j') ;
   -- the K-points agree
   kEq : Id (W0.Ix (Yy.K.ob W)) (kA W Lx.kp) Ly.kp =
    transH (apH ((A.1.tE y x f).nt W) Lx.kp-E) (transH (symH (rdGC X k w W h j)) (symH Ly.kp-E)) ;
   -- the paths read equally
   rdEq (V : Ob) (g : Hom V W) (j' : Hom V Iv)
    : Id (TAy.EI V) (Yy.rdG W (kA W Lx.kp) (IK.TC[y, x, f, W, Lx.kp, Yx.fromJ W Lx.kp (Lx.pth, (Lx.Qs, Lx.cond))].res) V g j')
        (Yy.rdG W Ly.kp (Yy.fromJ W Ly.kp (Ly.pth, (Ly.Qs, Ly.cond))) V g j') =
    transH (rdGC W Lx.kp (Yx.fromJ W Lx.kp (Lx.pth, (Lx.Qs, Lx.cond))) V g j')
     (transH (apH ((A.1.tE y x f).nt V) (Yx.FromJ[W, Lx.kp, (Lx.pth, (Lx.Qs, Lx.cond))].uJ-E V g j'))
       (transH (symH (uC V g j'))
         (symH (Yy.FromJ[W, Ly.kp, (Ly.pth, (Ly.Qs, Ly.cond))].uJ-E V g j')))) ;
   eq : Id (W0.Ix ((Dc.ob y).ob W)) z1 z2 =
    Yy.YK.tpY-ext W z1 z2 kEq
     (\ V g j' -> Yy.SEB.mV-inj V (Yy.YK.rd W (kA W Lx.kp) (IK.TC[y, x, f, W, Lx.kp, Yx.fromJ W Lx.kp (Lx.pth, (Lx.Qs, Lx.cond))].res) V g j')
                    (Yy.YK.rd W Ly.kp (Yy.fromJ W Ly.kp (Ly.pth, (Ly.Qs, Ly.cond))) V g j')
                    (apH (\ k2 -> Yy.K.act V W g k2) kEq) (rdEq V g j'))
     (refl Lx.Qs) ;
  } ;
  lamEq (X : Ob) (z : W0.Ix ((Dc.ob x).ob X))
   : Id (W0.Ix (CL.FC[Dc.ob y].ob X)) (CL.FMap[Dc.ob x, Dc.ob y, Dc.act y x f].mapF X (Yx.lamY X z)) (Yy.lamY X (upD X z)) =
   Yy.FDY.fam-eq X (CL.FMap[Dc.ob x, Dc.ob y, Dc.act y x f].mapF X (Yx.lamY X z)) (Yy.lamY X (upD X z)) (\ W h j -> Lam[X, z, W, h, j].eq) ;
  opaque lamEq ;
 } ;
} ;
