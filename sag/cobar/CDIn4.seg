-- CDIn4.seg (canonicity-c2; (d)(2), part 4): for a natural map m : T0 -> Q_y
-- and a closed class c, m applied to the Id of the fwd images, rewritten by
-- readings lA/lB into an Id between the two evaluation maps at c (as CCmpK6).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module In4 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module K5m = CDIn3[a].In3[R, encK, pe, x, u, y] ;
 module K4m = K5m.K4m ;
 module U13m = K5m.U13m ;
 module I1m = K5m.I1m ;
 Nl : C.Ctx = C.nil ;
 H : C.Ty Nl = K5m.H ;
 GH : C.Ctx = K5m.GH ;
 HTT : C.Ty Nl = K5m.HTT ;
 HTTh : C.Ty GH = K5m.HTTh ;
 QY : C.Ty Nl = K5m.QY ;
 QA : C.Ty Nl = K5m.QA ;
 QYh : C.Ty GH = K5m.QYh ;
 rwId (G : C.Ctx) (T : C.Ty G) (x x' y y' : C.El G T)
  (px : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (x.eob K w) (x'.eob K w))
  (py : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (y.eob K w) (y'.eob K w))
  (p : C.El G (IJ.IdT G T x y)) : C.El G (IJ.IdT G T x' y') = CCmpU14[a].rwId G T x x' y y' px py p ;
 iAr (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (HTTh.1.tob K w)) (K4m.iA.eob K w) (I1m.fwdN.nfun K w.1 (K4m.pkA K w)) = K5m.iAr K w ;
 iBr (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (HTTh.1.tob K w)) (K4m.iB.eob K w) (I1m.fwdN.nfun K w.1 (K4m.pkB K w)) = K5m.iBr K w ;
 module Cmp (m : HO.NMap[Nl, HTT.1, QY.1]) (c : C.El Nl QA)
   (lA : (K : Ob) (w : V1.Ix (GH.ob K)) -> Id (V1.Ix (QYh.1.tob K w)) (m.nfun K w.1 (I1m.fwdN.nfun K w.1 (K4m.pkA K w))) ((U13m.ZA.apC c).eob K w))
   (lB : (K : Ob) (w : V1.Ix (GH.ob K)) -> Id (V1.Ix (QYh.1.tob K w)) (m.nfun K w.1 (I1m.fwdN.nfun K w.1 (K4m.pkB K w))) ((U13m.ZB.apC c).eob K w)) {
  module AN = CCmpK3[a].ApN[HTT, QY, m, GH, C.p Nl H] ;
  ev : C.El GH (IJ.IdT GH AN.YG (AN.IPm.evS GH (C.p Nl H) K4m.iA) (AN.IPm.evS GH (C.p Nl H) K4m.iB)) = AN.ap K4m.iA K4m.iB K4m.i2 ;
  res : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC c) (U13m.ZB.apC c)) =
   rwId GH QYh (AN.IPm.evS GH (C.p Nl H) K4m.iA) (U13m.ZA.apC c)
    (AN.IPm.evS GH (C.p Nl H) K4m.iB) (U13m.ZB.apC c)
    (\ K w -> transH (apH {V1.Ix (HTTh.1.tob K w)} {V1.Ix (QYh.1.tob K w)} (m.nfun K w.1) (iAr K w)) (lA K w))
    (\ K w -> transH (apH {V1.Ix (HTTh.1.tob K w)} {V1.Ix (QYh.1.tob K w)} (m.nfun K w.1) (iBr K w)) (lB K w)) ev ;
 } ;
} ;
