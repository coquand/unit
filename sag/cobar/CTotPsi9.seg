-- CTotPsi9.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for lines
-- at the total site, part 9: Psi is natural along total maps.  For
-- g : X' -> X and a line ln of D G at X, Psi of the restricted line is
-- the action of D on Psi: index by index the levelwise lines agree (D's
-- index laws RR / oPath with a Cart slice path, then CTotPsi8's ext).
-- Generic in the context G.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi9 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) {
 module P5 = CTotPsi5[a, vl, l].Psi5[C, G] ;
 module P8 = CTotPsi8[a, vl, l].Psi8[C, G] ;
 module P3 = P5.P3 ;
 module P2 = P3.P2 ;
 module PO = P3.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module VT = PO.VT ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module CL = PO.CL ;
 module XB = P3.XB ;
 module DL = P3.DL ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 module PNat (X' X : TC.TOb) (g : TC.THm X' X) (ln : W0.Ix (PO.FL.ob X)) {
  gln : W0.Ix (PO.FL.ob X') = PO.FL.actF X' X g ln ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  J0 : Ob = X'.1 ;
  y0 : Obj J0 = X'.2 ;
  u0 : Hom J0 I = g.1 ;
  g0 : VT.VMap J0 y0 (C.res J0 I u0 x) = VT.vpart J0 I u0 y0 x g.2 ;
  rqS (n : Nat) (W1 : Ob) (t : Obj W1) (sw : D.S J0 y0 n W1 t) : D.S I x n W1 t =
   (compH W1 J0 I u0 sw.1, CT.rxM W1 J0 I sw.1 u0 y0 x g0 n t sw.2) ;
  module P0 (n : Nat) (J : Ob) (u : Hom J J0) (z : Obj J) (c : CT.Ch J n (C.res J J0 u y0) z) (i : Wt.Pn n J) (W1 : Ob) (v : Hom W1 J) (j : PB.IvP W1) {
   module QX = P2.PQ[X, ln, n, J, compH J J0 I u0 u, z, CT.rxM J J0 I u u0 y0 x g0 n z c, i] ;
   module QY = P2.PQ[X', gln, n, J, u, z, c, i] ;
   uv : Hom W1 J0 = compH W1 J J0 u v ;
   rz : Obj W1 = C.res W1 J v z ;
   R : Wt.Pn n W1 = Wt.Res[n, W1, J, v, i].res ;
   Wv : TC.TOb = (W1, C.res W1 J0 uv y0) ;
   fk : TC.THm Wv X' = TC.cartT W1 X' uv ;
   f : TC.THm Wv X = TC.tcomp Wv X' X g fk ;
   module CAY = CL.Cart[W1, J0, uv, y0, n, rz, DO.rCh W1 J J0 v u y0 n z c] ;
   module EXT = P8.XL[X, ln, Wv, f, n, W1, idH W1, rz, CAY.ch, R, j] ;
   natP : Id (D.S I x n W1 rz)
            (compH W1 J I (compH J J0 I u0 u) v, DO.rCh W1 J I v (compH J J0 I u0 u) x n z (CT.rxM J J0 I u u0 y0 x g0 n z c))
            (compH W1 J0 I u0 uv, CT.rxM W1 J0 I uv u0 y0 x g0 n rz (DO.rCh W1 J J0 v u y0 n z c)) =
    D.sEq I x n W1 rz (compH W1 J I (compH J J0 I u0 u) v) (compH W1 J0 I u0 uv) (comp-assoc W1 J J0 I u0 u v)
     (DO.rCh W1 J I v (compH J J0 I u0 u) x n z (CT.rxM J J0 I u u0 y0 x g0 n z c))
     (CT.rxM W1 J0 I uv u0 y0 x g0 n rz (DO.rCh W1 J J0 v u y0 n z c))
     (CT.RR[W1, J, J0, I, v, u, u0, y0, x, g0, n, z, c].law) ;
   cartP : Id (D.S J0 y0 n W1 rz) (compH W1 W1 J0 uv (idH W1), CT.rxM W1 W1 J0 (idH W1) uv (C.res W1 J0 uv y0) y0 CAY.g0 n rz CAY.ch)
             (uv, DO.rCh W1 J J0 v u y0 n z c) =
    D.sEq J0 y0 n W1 rz (compH W1 W1 J0 uv (idH W1)) uv (comp-idr W1 J0 uv)
     (CT.rxM W1 W1 J0 (idH W1) uv (C.res W1 J0 uv y0) y0 CAY.g0 n rz CAY.ch) (DO.rCh W1 J J0 v u y0 n z c) CAY.law ;
   oP : Id (D.S I x n W1 rz) (rqS n W1 rz (compH W1 W1 J0 uv (idH W1), CT.rxM W1 W1 J0 (idH W1) uv (C.res W1 J0 uv y0) y0 CAY.g0 n rz CAY.ch))
          (compH W1 W1 I f.1 (idH W1), EXT.cc) =
    D.oPath W1 J0 I u0 uv (C.res W1 J0 uv y0) y0 x g.2 (C.cart W1 J0 uv y0) (n, W1, idH W1, rz, CAY.ch, R.1) ;
   sP : Id (D.S I x n W1 rz)
          (compH W1 J I (compH J J0 I u0 u) v, DO.rCh W1 J I v (compH J J0 I u0 u) x n z (CT.rxM J J0 I u u0 y0 x g0 n z c))
          (compH W1 W1 I f.1 (idH W1), EXT.cc) =
    transH natP (transH (apH {D.S J0 y0 n W1 rz} {D.S I x n W1 rz} (\ sw -> rqS n W1 rz sw) (symH cartP)) oP) ;
   base : Id (W0.Ix (G.ob W1 rz)) (QX.vg W1 v rz (refl rz) j) (QY.vg W1 v rz (refl rz) j) =
    transH (apH {D.S I x n W1 rz} {W0.Ix (G.ob W1 rz)} (\ sw -> QX.rdS W1 rz sw R j) sP)
     (transH (apH {PB.IvP W1} {W0.Ix (G.ob W1 rz)} (\ jj -> QX.rdS W1 rz (compH W1 W1 I f.1 (idH W1), EXT.cc) R jj) (symH (PB.ivA-id W1 j)))
       EXT.ext) ;
   gen (y : Obj W1) (e : Id (Obj W1) rz y) : Id (W0.Ix (G.ob W1 y)) (QX.vg W1 v y e j) (QY.vg W1 v y e j) =
    idJ (Obj W1) rz (\ y2 e2 -> Id (W0.Ix (G.ob W1 y2)) (QX.vg W1 v y2 e2 j) (QY.vg W1 v y2 e2 j)) base y e ;
  } ;
  module PQe (n : Nat) (J : Ob) (u : Hom J J0) (z : Obj J) (c : CT.Ch J n (C.res J J0 u y0) z) (i : Wt.Pn n J) {
   module QX = P2.PQ[X, ln, n, J, compH J J0 I u0 u, z, CT.rxM J J0 I u u0 y0 x g0 n z c, i] ;
   module QY = P2.PQ[X', gln, n, J, u, z, c, i] ;
   Leq : Id (W0.Ix (XB.RH.F0.ob (J, z))) QX.L0 QY.L0 =
    XB.RH.F0.fam-eq (J, z) QX.L0 QY.L0 (\ W h j -> P0[n, J, u, z, c, i, W.1, h.1, j].gen W.2 (symH h.2)) ;
   law : Id (W0.Ix (XB.RH.F1.ob (TR.RN.o (J, z)))) QY.psiq QX.psiq =
    symH (apH {W0.Ix (XB.RH.F0.ob (J, z))} {W0.Ix (XB.RH.F1.ob (TR.RN.o (J, z)))} (XB.extV (J, z)) Leq) ;
  } ;
  law : Id (DL.Ob' J0 y0) P5.PT[X', gln].PsiL (DL.act J0 I u0 y0 x g.2 P5.PT[X, ln].PsiL) =
   DL.ob-eq J0 y0 P5.PT[X', gln].PsiL (DL.act J0 I u0 y0 x g.2 P5.PT[X, ln].PsiL)
    (\ q lq -> PQe[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].law) ;
 } ;
} ;
