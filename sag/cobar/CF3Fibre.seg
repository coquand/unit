-- The evaluation fibre over three quotient variables, on the base copy.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, C].IdJStr = FibId[a, a+].fibId ;

module Fibre (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (y : SX.Over[R].Presentation) {
 module E = CF3Eval[a].Eval3[R, encK, pe, y] ;
 module Q = CQCtx[a].G3Of[E.QY] ;
 module I = CInjP[a].IP[E.HS, E.QYYY, E.P123.nmap] ;
 pack (K : Ob) (w : V1.Ix (Q.G3.ob K)) : V1.Ix (I.GB.ob K) =
  (w.1.1.1, ((w.1.1.2, w.1.2), w.2)) ;
 pack-nat (J K : Ob) (u : Hom J K) (w : V1.Ix (Q.G3.ob K)) :
  Id (V1.Ix (I.GB.ob J)) (pack J (Q.G3.act J K u w)) (I.GB.act J K u (pack K w)) =
  refl (pack J (Q.G3.act J K u w)) ;
 s : C.Sub Q.G3 I.GB = new L.PSub[Q.G3, I.GB, pack, pack-nat] ;
 P : C.Ty Q.G3 = C.subT Q.G3 I.GB I.Fib s ;
 module AtTerms (t1 t2 t3 : CAlgX[a].AlgX[R, encK, y, pe].Term) {
  module B = CF3EvalBeta[a].Beta[R, encK, pe, y, t1, t2, t3] ;
  q1 : C.El C.nil E.QY = B.b1 ;
  q2 : C.El C.nil E.QY = B.b2 ;
  q3 : C.El C.nil E.QY = B.b3 ;
  S : C.Sub C.nil Q.G3 = Q.Sec3[q1, q2, q3].sec3 ;
  sS : C.Sub C.nil I.GB = C.o C.nil Q.G3 I.GB s S ;
  sB : C.Sub C.nil I.GB = C.sec C.nil E.QYYY B.B123 ;
  rB (K : Ob) : Id (V1.Ix (E.QYYY.1.tob K tt))
   (B.B123.eob K tt)
   ((q1.eob K tt, q2.eob K tt), q3.eob K tt) =
   transH (B.P123.prR B.B12 q3 K tt)
    (apH {V1.Ix (E.P12.YZ.1.tob K tt)} {V1.Ix (E.QYYY.1.tob K tt)}
      (\ z -> (z, q3.eob K tt)) (B.P12.prR q1 q2 K tt)) ;
  eSw (K : Ob) : (w : Top) -> Id (V1.Ix (I.GB.ob K)) (sS.nt K w) (sB.nt K w) =
   split { tt -> apH {V1.Ix (E.QYYY.1.tob K tt)} {V1.Ix (I.GB.ob K)}
      (\ z -> (tt, z)) (symH (rB K)) } ;
  eS : Id (C.Sub C.nil I.GB) sS sB =
   L.sub-ext C.nil I.GB sS sB (\ K w -> eSw K w) ;
  Xs : C.Ty C.nil = C.subT C.nil I.GB I.Xb sB ;
  s0 : C.Sub C.nil C.nil = C.o C.nil I.GB C.nil (C.p C.nil E.QYYY) sB ;
  PXs : Id (C.Ty C.nil) (C.subT C.nil C.nil E.HS s0) Xs =
   C.subT-o C.nil I.GB C.nil E.HS (C.p C.nil E.QYYY) sB ;
  hs : C.El C.nil Xs = OV.trE C.nil (C.subT C.nil C.nil E.HS s0) Xs PXs (C.subt C.nil C.nil E.HS B.T.zc s0) ;
  hsr (K : Ob) : Id (V1.Ix (Xs.1.tob K tt)) (hs.eob K tt) (B.T.zc.eob K tt) =
   transH (CAppRd[a].trE-rd C.nil (C.subT C.nil C.nil E.HS s0) Xs PXs (C.subt C.nil C.nil E.HS B.T.zc s0) K tt)
    (CAppRd[a].same-rd C.nil (C.subT C.nil C.nil E.HS s0) Xs PXs K tt (refl (Xs.1.tob K tt)) (B.T.zc.eob K tt)) ;
  lf : C.Sub (C.ext C.nil Xs) I.GX = C.lift C.nil I.GB I.Xb sB ;
  Ys : C.Ty (C.ext C.nil Xs) = C.subT (C.ext C.nil Xs) I.GX I.Fm lf ;
  rho : C.Sub C.nil I.GX = C.o C.nil (C.ext C.nil Xs) I.GX lf (C.sec C.nil Xs hs) ;
  T0 : C.Ty I.GX = OV.wkT I.GB I.Xb I.Bb ;
  qw : C.El I.GX T0 = OV.wkE I.GB I.Xb I.Bb (C.q C.nil E.QYYY) ;
  Tr : C.Ty C.nil = C.subT C.nil I.GX T0 rho ;
  sb0 : C.Sub C.nil C.nil = C.o C.nil I.GX C.nil (C.o I.GX I.GB C.nil (C.p C.nil E.QYYY) I.pX) rho ;
  sm0 : C.Sub C.nil C.nil = C.o C.nil I.GB C.nil (C.p C.nil E.QYYY) (C.o C.nil I.GX I.GB I.pX rho) ;
  em0 : Id (C.Sub C.nil C.nil) sm0 sb0 = L.sub-ext C.nil C.nil sm0 sb0 (\ K w -> refl w) ;
  e0 : Id (C.Sub C.nil C.nil) sb0 (C.id C.nil) =
   L.sub-ext C.nil C.nil sb0 (C.id C.nil) (\ K w -> refl w) ;
  PB : Id (C.Ty C.nil) Tr E.QYYY =
   transH (symH (C.subT-o C.nil I.GX I.GB I.Bb I.pX rho))
    (transH (symH (C.subT-o C.nil I.GB C.nil E.QYYY (C.p C.nil E.QYYY) (C.o C.nil I.GX I.GB I.pX rho)))
     (transH (apH {C.Sub C.nil C.nil} {C.Ty C.nil} (\ v -> C.subT C.nil C.nil E.QYYY v) em0)
      (transH (apH {C.Sub C.nil C.nil} {C.Ty C.nil} (\ v -> C.subT C.nil C.nil E.QYYY v) e0)
       (C.subT-id C.nil E.QYYY)))) ;
  app0 : C.El C.nil E.QYYY = OV.app C.nil E.HS E.QYYY E.ev3 B.T.zc ;
  aTr : C.El C.nil Tr = OV.trE C.nil E.QYYY Tr (symH PB) app0 ;
  bTr : C.El C.nil Tr = OV.trE C.nil E.QYYY Tr (symH PB) B.B123 ;
  pTr : C.El C.nil (IJ.IdT C.nil Tr aTr bTr) =
   CInjP[a].idFwdL C.nil E.QYYY Tr (symH PB) app0 B.B123 B.witness ;
  appRd (K : Ob) : Id (V1.Ix (Tr.1.tob K tt))
   ((C.subt C.nil I.GX T0 I.apX rho).eob K tt) (app0.eob K tt) =
   transH (I.appR K (rho.nt K tt))
    (transH (apH {V1.Ix (E.HS.1.tob K tt)} {V1.Ix (E.QYYY.1.tob K tt)}
      (I.n.nfun K tt) (hsr K)) (symH (B.rdEv K))) ;
  pA (K : Ob) : (w : Top) -> Id (V1.Ix (Tr.1.tob K w))
   (aTr.eob K w) ((C.subt C.nil I.GX T0 I.apX rho).eob K w) =
   split { tt -> transH
    (CAppRd[a].trE-rd C.nil E.QYYY Tr (symH PB) app0 K tt)
    (transH (CAppRd[a].same-rd C.nil E.QYYY Tr (symH PB) K tt (refl (Tr.1.tob K tt)) (app0.eob K tt))
     (symH (appRd K))) } ;
  pB (K : Ob) : (w : Top) -> Id (V1.Ix (Tr.1.tob K w))
   (bTr.eob K w) ((C.subt C.nil I.GX T0 qw rho).eob K w) =
   split { tt -> transH
    (CAppRd[a].trE-rd C.nil E.QYYY Tr (symH PB) B.B123 K tt)
    (CAppRd[a].same-rd C.nil E.QYYY Tr (symH PB) K tt (refl (Tr.1.tob K tt)) (B.B123.eob K tt)) } ;
  p0 : C.El C.nil (IJ.IdT C.nil Tr
    (C.subt C.nil I.GX T0 I.apX rho) (C.subt C.nil I.GX T0 qw rho)) =
   CCmpU14[a].rwId C.nil Tr aTr (C.subt C.nil I.GX T0 I.apX rho)
    bTr (C.subt C.nil I.GX T0 qw rho) pA pB pTr ;
  y0 : C.El C.nil (C.subT C.nil I.GX I.Fm rho) =
   OV.trE C.nil (IJ.IdT C.nil Tr
     (C.subt C.nil I.GX T0 I.apX rho) (C.subt C.nil I.GX T0 qw rho))
    (C.subT C.nil I.GX I.Fm rho)
    (symH (IJ.IdT-nat C.nil I.GX T0 I.apX qw rho)) p0 ;
  ys : C.El C.nil (C.subT C.nil (C.ext C.nil Xs) Ys (C.sec C.nil Xs hs)) =
   OV.trE C.nil (C.subT C.nil I.GX I.Fm rho)
    (C.subT C.nil (C.ext C.nil Xs) Ys (C.sec C.nil Xs hs))
    (C.subT-o C.nil (C.ext C.nil Xs) I.GX I.Fm lf (C.sec C.nil Xs hs)) y0 ;
  fb : C.El C.nil (C.subT C.nil I.GB I.Fib sB) =
   OV.trE C.nil (SS.Sig C.nil Xs Ys) (C.subT C.nil I.GB I.Fib sB)
    (symH (FibCwF[a, a+].fibSig.Sig-nat C.nil I.GB I.Xb I.Fm sB))
    (IN.pr C.nil Xs Ys hs ys) ;
  PAt : C.Ty C.nil = C.subT C.nil Q.G3 P S ;
  FP : Id (C.Ty C.nil) PAt (C.subT C.nil I.GB I.Fib sB) =
   transH (symH (C.subT-o C.nil Q.G3 I.GB I.Fib s S))
    (apH {C.Sub C.nil I.GB} {C.Ty C.nil}
      (\ z -> C.subT C.nil I.GB I.Fib z) eS) ;
  term : C.El C.nil PAt = OV.trE C.nil (C.subT C.nil I.GB I.Fib sB) PAt (symH FP) fb ;
 } ;
 module Elim (pF : C.El I.GB (PU.isProp I.GB I.Fib)) {
  module QE = CwFQuotElim5[a].QE5[R, encK, y, pe] ;
  pP : C.El Q.G3 (PU.isProp Q.G3 P) = QE.pOv Q.G3 I.GB I.Fib s pF ;
  term (t1 t2 t3 : CAlgX[a].AlgX[R, encK, y, pe].Term) :
    C.El C.nil (C.subT C.nil Q.G3 P
      (Q.Sec3[CAlgX[a].AlgX[R, encK, y, pe].cls t1,
        CAlgX[a].AlgX[R, encK, y, pe].cls t2,
        CAlgX[a].AlgX[R, encK, y, pe].cls t3].sec3)) =
    AtTerms[t1, t2, t3].term ;
  section : C.El Q.G3 P = QE.elimP3 P pP term ;
 } ;
 module FromGen {
   pkA (K : Ob) (w : V1.Ix (I.GH.ob K)) : V1.Ix (E.HS.1.tob K w.1) = w.2.1 ;
   pkB (K : Ob) (w : V1.Ix (I.GH.ob K)) : V1.Ix (E.HS.1.tob K w.1) = w.2.2.1 ;
   pkAN (J K : Ob) (f : Hom J K) (w : V1.Ix (I.GH.ob K)) :
    Id (V1.Ix (E.HS.1.tob J w.1))
     (E.HS.1.tact J K f w.1 w.1 (refl w.1) (pkA K w))
     (pkA J (I.GH.act J K f w)) =
    refl (E.HS.1.tact J K f w.1 w.1 (refl w.1) (pkA K w)) ;
   pkBN (J K : Ob) (f : Hom J K) (w : V1.Ix (I.GH.ob K)) :
    Id (V1.Ix (E.HS.1.tob J w.1))
     (E.HS.1.tact J K f w.1 w.1 (refl w.1) (pkB K w))
     (pkB J (I.GH.act J K f w)) =
    L.tact-irr C.nil E.HS.1 J K f w.1 w.1 (refl w.1)
     (L.ntEq I.D1 C.nil (L.pP C.nil E.HS.1) J K f (w.1, w.2.1)
       (C.nil.act J K f w.1, E.HS.1.tact J K f w.1 (C.nil.act J K f w.1)
          (refl (C.nil.act J K f w.1)) w.2.1)
       (L.pair-act C.nil E.HS.1 J K f w.1 (C.nil.act J K f w.1)
          (refl (C.nil.act J K f w.1)) w.2.1)) w.2.2.1 ;
   module U20 = CUG20[a].UG20[R, encK, pe, E.F.F3, y, I.H, pkA, pkB, pkAN, pkBN] ;
   module Use (gen : (v : SX.Fin E.F.F3.1) ->
     C.El I.GH (U20.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[E.F.F3].AX.cls (var v)))) {
    module U30 = CUG30[a].UG30[R, encK, pe, E.F.F3, y, I.H, pkA, pkB, pkAN, pkBN, gen] ;
    sQ : CQCtx[a].G3Of[E.QY].SetQiTy = CwFQuotElim1[a].QE1[R, encK, y, pe].setQi ;
    sQ2 : CQCtx[a].G3Of[E.P12.YZ].SetQiTy = CProdSet2[a].ProdSet2[E.QY, E.QY, sQ, sQ].setQi ;
    sQ3 : CQCtx[a].G3Of[E.QYYY].SetQiTy = CProdSet2[a].ProdSet2[E.P12.YZ, E.QY, sQ2, sQ].setQi ;
    module PF = CInjP3[a].PF[E.HS, E.QYYY, E.P123.nmap, sQ3,
      U30.zA, U30.zB,
      \ K w -> refl (U30.zA.eob K w),
      \ K w -> refl (U30.zB.eob K w), U30.res] ;
    pF : C.El I.GB (PU.isProp I.GB I.Fib) = PF.pF ;
    section : C.El Q.G3 P = Elim[pF].section ;
   } ;
 }
} ;
