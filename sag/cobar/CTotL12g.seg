-- CTotL12g.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part g: level m read through the face k.
--   phi    at an index of length m+1 (U, t, cc) and a weight pw of length
--          m: the level-m value at the face k of cc, acted on along its map
--   phiN   phi is natural along base maps (cartesian restriction): the
--          level's naturality, rmap-eq, and chF commuting with faces
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;

module L12g (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LA = CTotL12a[a, vl, l].L12T[C, G, A] ;
 module CL = CTotL12ch[a, vl].ChL[C] ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 module Fg (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module F = LA.Fx[X, gm, s] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  p1of : (m : Nat) -> (p : F.Up m) -> F.P1t m (F.top m p) = split {
   zero -> \ p -> p.2.1 ;
   suc m1 -> \ p -> p.2.1 } ;
  p2of : (m : Nat) -> (p : F.Up m) -> F.P2t m (F.top m p) = split {
   zero -> \ p -> p.2.2 ;
   suc m1 -> \ p -> p.2.2.1 } ;

  module Ph (m : Nat) (p : F.Up m) (k : Nat) {
   vm : F.Vt m = F.top m p ;
   DR (W1 : Ob) (U0 : Hom W1 I) (t : Obj W1) : U vl = DO.KJ[W1].K.DR m (C.res W1 I U0 x) t ;
   Dk (W1 : Ob) (U0 : Hom W1 I) (t : Obj W1) (cc : CT.Ch W1 (suc m) (C.res W1 I U0 x) t) : DR W1 U0 t =
    DO.KJ[W1].K.fc m k (C.res W1 I U0 x) t cc ;
   phiD (W1 : Ob) (U0 : Hom W1 I) (t : Obj W1) (D0 : DR W1 U0 t) (pw : Wt.Pn m W1) : DA.Ez W1 t =
    DA.E.act (W1, t) (W1, D0.1) (idH W1, D0.2.2) (F.pzv m vm W1 U0 D0.1 D0.2.1 pw) ;
   phi (W1 : Ob) (U0 : Hom W1 I) (t : Obj W1) (cc : CT.Ch W1 (suc m) (C.res W1 I U0 x) t) (pw : Wt.Pn m W1) : DA.Ez W1 t =
    phiD W1 U0 t (Dk W1 U0 t cc) pw ;

   module PN (W1 : Ob) (U0 : Hom W1 I) (t : Obj W1) (cc : CT.Ch W1 (suc m) (C.res W1 I U0 x) t) (pw : Wt.Pn m W1) (W2 : Ob) (w : Hom W2 W1) {
    D0 : DR W1 U0 t = Dk W1 U0 t cc ;
    z' : Obj W1 = D0.1 ;
    c' : CT.Ch W1 m (C.res W1 I U0 x) z' = D0.2.1 ;
    g : VT.VMap W1 t z' = D0.2.2 ;
    P : DA.Ez W1 z' = F.pzv m vm W1 U0 z' c' pw ;
    rt : Obj W2 = C.res W2 W1 w t ;
    rz : Obj W2 = C.res W2 W1 w z' ;
    Uw : Hom W2 I = compH W2 W1 I U0 w ;
    kL : TC.THm (W2, rt) (W1, z') = TC.tcomp (W2, rt) (W1, t) (W1, z') (idH W1, g) (w, C.cart W2 W1 w t) ;
    kR : TC.THm (W2, rt) (W1, z') = TC.tcomp (W2, rt) (W2, rz) (W1, z') (w, C.cart W2 W1 w z') (idH W2, VT.rmap W2 W1 w t z' g) ;
    module CF = CTotL12ch[a, vl].CFc[VT.VCat W1, VT.VCat W2, VT.rfun W2 W1 w] ;
    D2path : Id (DR W2 Uw rt) (Dk W2 Uw rt (DO.rCh W2 W1 I w U0 x (suc m) t cc)) (rz, DO.rCh W2 W1 I w U0 x m z' c', VT.rmap W2 W1 w t z' g) =
     transH (CL.fc-trCh W2 m k (C.res W2 W1 w (C.res W1 I U0 x)) (C.res W2 I Uw x) (symH (C.res-comp W2 W1 I U0 w x)) rt
               (CF.CF.chF (suc m) (C.res W1 I U0 x) t cc))
      (apH {DO.KJ[W2].K.DR m (C.res W2 W1 w (C.res W1 I U0 x)) rt} {DR W2 Uw rt}
         (\ E2 -> (E2.1, CT.trCh W2 m (C.res W2 W1 w (C.res W1 I U0 x)) (C.res W2 I Uw x) (symH (C.res-comp W2 W1 I U0 w x)) E2.1 E2.2.1, E2.2.2))
         (symH (CF.chF-fc m k (C.res W1 I U0 x) t cc))) ;
    law : Id (DA.Ez W2 rt) (DA.E.act (W2, rt) (W1, t) (w, C.cart W2 W1 w t) (phi W1 U0 t cc pw))
            (phi W2 Uw rt (DO.rCh W2 W1 I w U0 x (suc m) t cc) (Wt.Res[m, W2, W1, w, pw].res)) =
     transH (symH (DA.E.act-o (W2, rt) (W1, t) (W1, z') (idH W1, g) (w, C.cart W2 W1 w t) P))
      (transH (apH {TC.THm (W2, rt) (W1, z')} {DA.Ez W2 rt} (\ kk -> DA.E.act (W2, rt) (W1, z') kk P) (symH (VT.rmap-eq W2 W1 w t z' g)))
        (transH (DA.E.act-o (W2, rt) (W2, rz) (W1, z') (w, C.cart W2 W1 w z') (idH W2, VT.rmap W2 W1 w t z' g) P)
          (transH (apH {DA.Ez W2 rz} {DA.Ez W2 rt} (\ q -> DA.E.act (W2, rt) (W2, rz) (idH W2, VT.rmap W2 W1 w t z' g) q)
                     (p1of m p W1 U0 z' c' pw W2 w))
            (apH {DR W2 Uw rt} {DA.Ez W2 rt} (\ E2 -> phiD W2 Uw rt E2 (Wt.Res[m, W2, W1, w, pw].res)) (symH D2path))))) ;
   } ;
  } ;
 } ;
} ;
