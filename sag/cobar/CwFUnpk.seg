-- CwFUnpk.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit): the context
-- G.(Sigma A B) is a retract of G.A.B, in a CwF with Pi, Sigma, Swan Id.
--   pk : G.A.B -> G.S     the pair of the variables (CwFSig's pv)
--   unpk : G.S -> G.A.B   CwFSig's unpacking map
--   pkUnpk                pk after unpk is the identity of G.S
--   back P                so a type P over G.S is (P[pk])[unpk]; a section
--                         of P[pk] over G.A.B gives one of P (sect)
open Base ;

module Unpk (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;

  module At (G : Ctx) (A : Ty G) (B : Ty (ext G A)) {
    module VS = SV.At[G, A, B] ;
    S : Ty G = VS.S ;
    ES : Ctx = VS.ES ;
    E2 : Ctx = VS.E2 ;
    pk : Sub E2 ES = extS E2 G S VS.pp VS.pv ;
    WS : Ty ES = wkT G S S ;
    ePk : Id (Sub ES G) (o ES ES G (p G S) (o ES E2 ES pk VS.unpk)) (o ES ES G (p G S) (id ES)) =
      trans (Sub ES G) (o ES ES G (p G S) (o ES E2 ES pk VS.unpk)) (p G S) (o ES ES G (p G S) (id ES))
        (trans (Sub ES G) (o ES ES G (p G S) (o ES E2 ES pk VS.unpk)) (o ES E2 G (o E2 ES G (p G S) pk) VS.unpk) (p G S)
           (sym (Sub ES G) (o ES E2 G (o E2 ES G (p G S) pk) VS.unpk) (o ES ES G (p G S) (o ES E2 ES pk VS.unpk))
              (o-assoc ES E2 ES G (p G S) pk VS.unpk))
           (trans (Sub ES G) (o ES E2 G (o E2 ES G (p G S) pk) VS.unpk) (o ES E2 G VS.pp VS.unpk) (p G S)
              (ap (Sub E2 G) (Sub ES G) (\ t -> o ES E2 G t VS.unpk) (o E2 ES G (p G S) pk) VS.pp (IN.p-extS E2 G S VS.pp VS.pv))
              VS.pp-unpk))
        (sym (Sub ES G) (o ES ES G (p G S) (id ES)) (p G S) (o-idr ES G (p G S))) ;
    -- the last variable along pk after unpk is itself
    PWq : Id (Ty E2) (subT E2 ES WS pk) VS.SW = IN.wkT-extS E2 G S S VS.pp VS.pv ;
    P1 : Id (Ty ES) (subT ES ES WS (o ES E2 ES pk VS.unpk)) WS =
      trans (Ty ES) (subT ES ES WS (o ES E2 ES pk VS.unpk)) (subT ES E2 (subT E2 ES WS pk) VS.unpk) WS
        (subT-o ES E2 ES WS pk VS.unpk)
        (trans (Ty ES) (subT ES E2 (subT E2 ES WS pk) VS.unpk) (subT ES E2 VS.SW VS.unpk) WS
           (ap (Ty E2) (Ty ES) (\ X -> subT ES E2 X VS.unpk) (subT E2 ES WS pk) VS.SW PWq)
           VS.PU) ;
    q1 : Ov ES ES WS (o ES E2 ES pk VS.unpk) WS P1 (q G S) (q G S) =
      JP.ovO ES E2 ES WS pk VS.unpk VS.SW PWq WS VS.PU P1 (q G S) VS.pv (q G S)
        (JP.q-extS E2 G S VS.pp VS.pv PWq) VS.pv-unpk ;
    q2 : Ov ES ES WS (id ES) WS (subT-id ES WS) (q G S) (q G S) = subt-id ES WS (q G S) ;
    pkUnpk : Id (Sub ES ES) (o ES E2 ES pk VS.unpk) (id ES) =
      IN.ext-eq ES G S (o ES E2 ES pk VS.unpk) (id ES) ePk WS (q G S) P1 q1 (subT-id ES WS) q2 ;

    -- a type over G.S is its reading along pk, read along unpk
    back (P : Ty ES) : Id (Ty ES) (subT ES E2 (subT E2 ES P pk) VS.unpk) P =
      trans (Ty ES) (subT ES E2 (subT E2 ES P pk) VS.unpk) (subT ES ES P (o ES E2 ES pk VS.unpk)) P
        (sym (Ty ES) (subT ES ES P (o ES E2 ES pk VS.unpk)) (subT ES E2 (subT E2 ES P pk) VS.unpk) (subT-o ES E2 ES P pk VS.unpk))
        (trans (Ty ES) (subT ES ES P (o ES E2 ES pk VS.unpk)) (subT ES ES P (id ES)) P
           (ap (Sub ES ES) (Ty ES) (\ t -> subT ES ES P t) (o ES E2 ES pk VS.unpk) (id ES) pkUnpk)
           (subT-id ES P)) ;
    -- so a section of P[pk] over G.A.B gives a section of P over G.S
    sect (P : Ty ES) (s : El E2 (subT E2 ES P pk)) : El ES P =
      trE ES (subT ES E2 (subT E2 ES P pk) VS.unpk) P (back P) (subt ES E2 (subT E2 ES P pk) s VS.unpk) ;
  } ;
} ;
