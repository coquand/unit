-- CCeEq2.seg (canonicity-45; COBAR.md "Prop 58"): readings for the
-- equations of A's telescope at the total site: the value of an element of
-- G moved along a map into the points (CAxSp's gsub) is its value at the
-- image point; dropping the equations of an unpacked point gives back the
-- telescope point (by recursion on the list of equations).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module E2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module UP = CUnpack[a].UP[R, encK, pe, y, u] ;
 module RS = UP.RS ;
 module SO = UP.SO ;
 module PW = SO.PW ;
 C : CwF.CwF[a++] = UP.C ;
 TOb : U a+ = CTotCat[a, a+, a+].TotOf[CCopy[a].ConcC[R, encK, pe].CM.IC].TOb ;
 -- gsub read at a point
 gP (E : C.Ctx) (s : C.Sub E SO.Xc) : Id (C.Ty E) (C.subT E SO.Xc (PW.Gat SO.Xc) s) (PW.Gat E) =
  transH (symH (C.subT-o E SO.Xc PW.Nl PW.GTy (C.eps SO.Xc) s))
   (apH {C.Sub E PW.Nl} {C.Ty E} (\ t -> C.subT E PW.Nl PW.GTy t) (transH (C.eps-uniq E (C.o E SO.Xc PW.Nl (C.eps SO.Xc) s)) (symH (C.eps-uniq E (C.eps E))))) ;
 gRd (E : C.Ctx) (s : C.Sub E SO.Xc) (g : C.El SO.Xc (PW.Gat SO.Xc)) (X : TOb) (x : V1.Ix (E.ob X))
  : Id (V1.Ix ((PW.Gat E).1.tob X x)) ((SO.gsub E s g).eob X x) (g.eob X (s.nt X x)) =
  transH (RS.T.trERd E (C.subT E SO.Xc (PW.Gat SO.Xc) s) (PW.Gat E) (gP E s) (C.subt E SO.Xc (PW.Gat SO.Xc) g s) X x)
   (RS.T.sameRd E (C.subT E SO.Xc (PW.Gat SO.Xc) s) (PW.Gat E) (gP E s) X x (refl ((PW.Gat E).1.tob X x)) (g.eob X (s.nt X x))) ;
 -- dropping the equations
 dUH : (L : SX.Over[R].Equations SO.TW.Var) (B : C.Ty (SO.HS L).1) (X : TOb) (z : V1.Ix ((C.ext SO.Xc (UP.SA.SigH L B)).ob X))
  -> Id (V1.Ix (SO.Xc.ob X)) ((SO.HS L).2.nt X ((UP.UH L B).nt X z).1) z.1 = split {
  nil -> \ B X z -> refl z.1 ;
  cons q L | r -> \ B X z -> r (UP.SS.Sig (SO.HS L).1 (SO.EqT (SO.HS L).1 (SO.HS L).2 q) B) X z } ;
} ;
