-- CTotP13n.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part n: bkMv, Psi of the lift back is u (as c2's CTotPsi22).  At
-- each index the elements of A agree on the nose; the two paths agree by
-- rho-inj at the context G.B: their levelwise restrictions are the lift
-- back read at cartesian lifts and u's path restricted (CTotP13m).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13n (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PM = CTotP13m[a, vl, l].P13m[C, G, A, B, f] ;
 module PL = CTotP13l[a, vl, l].P13l[C, G, A, B, f] ;
 module PG = CTotP13g[a, vl, l].P13g[C, G, A, B, f] ;
 module PF = PG.PF ;
 module PE = PM.PE ;
 module PB13 = PE.PB13 ;
 module TC = PE.TC ;
 module DO = PE.DO ;
 module CT = DO.CT ;
 module DF = PE.DF ;
 module H = PE.H ;
 module HD = PE.HD ;
 module DS = PM.DS ;
 module XBE = PE.Q2E.XB ;
 Obj (I : Ob) : U vl = PE.Obj I ;

 module BM (X : TC.TOb) (w : HD.TA.EI X) (u : DS.TOb' X.1 X.2 (PE.PR.phi X w)) {
  module BM1 = PM.BM[X, w, u] ;
  module BK = PL.BK[X, w, u] ;
  vt : HD.TF.EI X = HD.TF.pr X w BK.bk ;
  module M = PE.MS[X, vt] ;
  module BD = BM1.BD ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module PQ (n : Nat) (J : Ob) (Ub : Hom J I) (z : Obj J) (cc : CT.Ch J n (C.res J I Ub x) z) (i : Wt.Pn n J) {
   module P1 = BM1.PQ[n, J, Ub, z, cc, i] ;
   qq : DO.Idx I x = P1.qq ;
   Y : TC.TOb = P1.Y ;
   module MQ = M.PQ[n, J, Ub, z, cc, i] ;
   module QE = MQ.QE ;
   lnq : W0.Ix (PE.FTg.FE.ob Y) = P1.lnq ;
   module RV (W1 : Ob) (vv : Hom W1 J) (j : PB.IvP W1) (y : Obj W1) (e1 : Id (Obj W1) (C.res W1 J vv z) y) {
    module LV = P1.LV[W1, vv, j] ;
    R : Wt.Pn n W1 = LV.R ;
    Uv : Hom W1 I = LV.Uv ;
    module RC = PE.PO.PL[X, BK.ln].RC[n, W1, y, Uv, P1.cT W1 vv y e1, R, j] ;
    module RQ = BD.AB[RC.Xv, RC.f, j].RQ[RC.q0, R.2] ;
    law : Id (H.TA.EI (W1, y)) (QE.vg W1 vv y e1 j) ((LV.lineAt y e1).1 (W1, y) (TC.tid (W1, y)) j) =
     transH RQ.beq
      (transH (apH {DF.D.S I x n W1 y} {H.TA.EI (W1, y)}
                 (\ sw -> (BD.lineE (n, W1, sw.1, y, sw.2, R.1) R.2).1 (W1, y) (TC.tid (W1, y)) RQ.RC.j0)
                 (DF.D.sEq I x n W1 y (compH W1 W1 I Uv (idH W1)) Uv (comp-idr W1 I Uv)
                    (CT.rxM W1 W1 I (idH W1) Uv RC.ry x RC.CA.g0 n y RC.CA.ch) (P1.cT W1 vv y e1) RC.CA.law))
        (apH {PB.IvP W1} {H.TA.EI (W1, y)} (\ jj -> (LV.lineAt y e1).1 (W1, y) (TC.tid (W1, y)) jj) (PB.ivA-id W1 j))) ;
   } ;
   Leq : Id (W0.Ix (XBE.RH.F0.ob Y)) QE.L0 (XBE.RH.rhoV Y lnq) =
    XBE.RH.F0.fam-eq Y QE.L0 (XBE.RH.rhoV Y lnq)
     (\ W h j -> transH (RV[W.1, h.1, j, W.2, symH h.2].law) (P1.LV[W.1, h.1, j].gen W.2 (symH h.2))) ;
   lineEq : Id (W0.Ix (PE.FTg.FE.ob Y)) MQ.psiE lnq =
    transH (apH {W0.Ix (XBE.RH.F0.ob Y)} {W0.Ix (PE.FTg.FE.ob Y)} (XBE.extV Y) Leq) (XBE.ext-rho Y lnq) ;
   law : Id (H.TF.EI Y) (DS.prz Y.1 Y.2 ((PE.PR.phi X w).1 qq i.2) MQ.fib) (DS.prz Y.1 Y.2 ((PE.PR.phi X w).1 qq i.2) (u.1 qq i.2)) =
    H.fibE-eq Y (DS.prz Y.1 Y.2 ((PE.PR.phi X w).1 qq i.2) MQ.fib) (DS.prz Y.1 Y.2 ((PE.PR.phi X w).1 qq i.2) (u.1 qq i.2))
     (refl ((PE.PR.phi X w).1 qq i.2))
     (refl (H.fibB Y (DS.prz Y.1 Y.2 ((PE.PR.phi X w).1 qq i.2) (u.1 qq i.2))))
     (\ Vb g j -> apH {W0.Ix (PE.FTg.FE.ob Y)} {H.TA.EI Vb} (\ MM -> MM.1 Vb g j) lineEq) ;
  } ;
  bkMv : Id (PG.Tot0 X) (PF.mS X vt) (PE.PR.phi X w, u) =
   PB13.LZ.LM.totEq X (PF.mS X vt) (PE.PR.phi X w, u) (refl (PE.PR.phi X w))
    (\ q lq -> PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].law) ;
 } ;
} ;
