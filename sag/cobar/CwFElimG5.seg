-- CwFElimG5.seg (canonicity-c2; SIMPLIFIED.md item 3, the quotient's
-- eliminator into sets): the recipe's Sigma is a proposition (PropCF),
-- given a point a0 of the predicate (rho) and, at every context over D,
-- that Id in B is a proposition (idP): PR over D.CF.CF, the recipe read
-- there through one substitution (RNg).
open Base ;

module ElimG5 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module X1 = CwFSetX1.SetX1[l, C, PS, SS, IJ, Un, NF] ;
  module EG2 = CwFElimG2.ElimG2[l, C, PS, SS, IJ, Un, NF] ;
  module EG3 = CwFElimG3.ElimG3[l, C, PS, SS, IJ, Un, NF] ;
  module EG4 = CwFElimG4.ElimG4[l, C, PS, SS, IJ, Un, NF] ;

  idBack (G : Ctx) (X X' : Ty G) (P : Id (Ty G) X X') (x y : El G X)
    (u : El G (IJ.IdT G X' (trE G X X' P x) (trE G X X' P y))) : El G (IJ.IdT G X x y) =
    idJ (Ty G) X (\ Z PZ -> El G (IJ.IdT G Z (trE G X Z PZ x) (trE G X Z PZ y)) -> El G (IJ.IdT G X x y)) (\ v -> v) X' P u ;

  module PropCF (D : Ctx) (B T0 : Ty D) (P0 : El D (X1.FunU D T0)) (fD : El D (Fun D T0 B))
    (a0 : El D T0) (rho : El D (subT D (ext D T0) EG2.R[D, B, T0, P0, fD].TP0 (sec D T0 a0)))
    (idP : (E : Ctx) (sE : Sub E D) (x y : El E (subT E D B sE)) -> El E (PU.isProp E (IJ.IdT E (subT E D B sE) x y))) {
    module Rz = EG2.R[D, B, T0, P0, fD] ;
    CF0 : Ty D = Rz.K.CF ;
    Gm1 : Ctx = ext D CF0 ;
    W0 : Ty Gm1 = wkT D CF0 CF0 ;
    Gm : Ctx = ext Gm1 W0 ;
    sG : Sub Gm D = o Gm Gm1 D (p D CF0) (p Gm1 W0) ;
    TmG : Ty Gm = subT Gm D T0 sG ;
    BG : Ty Gm = subT Gm D B sG ;
    PcG : El Gm (X1.FunU Gm TmG) =
      trE Gm (subT Gm D (X1.FunU D T0) sG) (X1.FunU Gm TmG) (X1.PF Gm D sG T0 TmG (refl TmG)) (subt Gm D (X1.FunU D T0) P0 sG) ;
    PFG : Id (Ty Gm) (subT Gm D (Fun D T0 B) sG) (Fun Gm TmG BG) = Fun-ov Gm D T0 B sG TmG (refl TmG) BG (refl BG) ;
    fIG : El Gm (Fun Gm TmG BG) = trE Gm (subT Gm D (Fun D T0 B) sG) (Fun Gm TmG BG) PFG (subt Gm D (Fun D T0 B) fD sG) ;
    module RG = EG3.RNg[Gm, D, sG, B, T0, fD, P0, PcG, refl PcG, fIG, refl fIG] ;
    a0G : El Gm TmG = subt Gm D T0 a0 sG ;
    sa : Sub D (ext D T0) = sec D T0 a0 ;
    TPo : Id (Ty (ext Gm TmG)) (subT (ext Gm TmG) (ext D T0) Rz.TP0 (lift Gm D T0 sG)) RG.Rz.TP0 =
      X1.N0[Gm, D, sG, T0, P0, P0, PcG, PcG, refl PcG, refl PcG].TPo ;
    PRG : Id (Ty Gm) (subT Gm D (subT D (ext D T0) Rz.TP0 sa) sG) (subT Gm (ext Gm TmG) RG.Rz.TP0 (sec Gm TmG a0G)) =
      trans (Ty Gm) (subT Gm D (subT D (ext D T0) Rz.TP0 sa) sG) (subT Gm (ext D T0) Rz.TP0 (o Gm D (ext D T0) sa sG))
        (subT Gm (ext Gm TmG) RG.Rz.TP0 (sec Gm TmG a0G))
        (sym (Ty Gm) (subT Gm (ext D T0) Rz.TP0 (o Gm D (ext D T0) sa sG)) (subT Gm D (subT D (ext D T0) Rz.TP0 sa) sG) (subT-o Gm D (ext D T0) Rz.TP0 sa sG))
        (trans (Ty Gm) (subT Gm (ext D T0) Rz.TP0 (o Gm D (ext D T0) sa sG))
           (subT Gm (ext D T0) Rz.TP0 (o Gm (ext Gm TmG) (ext D T0) (lift Gm D T0 sG) (sec Gm TmG a0G)))
           (subT Gm (ext Gm TmG) RG.Rz.TP0 (sec Gm TmG a0G))
           (ap (Sub Gm (ext D T0)) (Ty Gm) (\ s -> subT Gm (ext D T0) Rz.TP0 s) (o Gm D (ext D T0) sa sG)
              (o Gm (ext Gm TmG) (ext D T0) (lift Gm D T0 sG) (sec Gm TmG a0G)) (sec-o Gm D T0 a0 sG))
           (trans (Ty Gm) (subT Gm (ext D T0) Rz.TP0 (o Gm (ext Gm TmG) (ext D T0) (lift Gm D T0 sG) (sec Gm TmG a0G)))
              (subT Gm (ext Gm TmG) (subT (ext Gm TmG) (ext D T0) Rz.TP0 (lift Gm D T0 sG)) (sec Gm TmG a0G))
              (subT Gm (ext Gm TmG) RG.Rz.TP0 (sec Gm TmG a0G))
              (subT-o Gm (ext Gm TmG) (ext D T0) Rz.TP0 (lift Gm D T0 sG) (sec Gm TmG a0G))
              (ap (Ty (ext Gm TmG)) (Ty Gm) (\ X -> subT Gm (ext Gm TmG) X (sec Gm TmG a0G))
                 (subT (ext Gm TmG) (ext D T0) Rz.TP0 (lift Gm D T0 sG)) RG.Rz.TP0 TPo))) ;
    rhoG : El Gm (subT Gm (ext Gm TmG) RG.Rz.TP0 (sec Gm TmG a0G)) =
      trE Gm (subT Gm D (subT D (ext D T0) Rz.TP0 sa) sG) (subT Gm (ext Gm TmG) RG.Rz.TP0 (sec Gm TmG a0G)) PRG
        (subt Gm D (subT D (ext D T0) Rz.TP0 sa) rho sG) ;
    EE : Ctx = RG.Rz.E ;
    DBG : Ctx = RG.Rz.DB ;
    sE : Sub EE D = o EE Gm D sG (o EE DBG Gm (p Gm BG) (p DBG RG.Rz.T)) ;
    PBE : Id (Ty EE) (subT EE D B sE) RG.Rz.K.BE =
      trans (Ty EE) (subT EE D B sE) (subT EE Gm BG (o EE DBG Gm (p Gm BG) (p DBG RG.Rz.T))) RG.Rz.K.BE
        (subT-o EE Gm D B sG (o EE DBG Gm (p Gm BG) (p DBG RG.Rz.T)))
        (subT-o EE DBG Gm BG (p Gm BG) (p DBG RG.Rz.T)) ;
    idPE : El EE (PU.isProp EE RG.Rz.K.Y) =
      idJ (Ty EE) (subT EE D B sE)
        (\ Y PY -> (x y : El EE Y) -> El EE (PU.isProp EE (IJ.IdT EE Y x y)))
        (\ x y -> idP EE sE x y) RG.Rz.K.BE PBE RG.Rz.fa RG.Rz.K.bE ;
    X2 : Ty Gm = wkT Gm1 W0 W0 ;
    PX : Id (Ty Gm) X2 RG.Rz.K.CF =
      trans (Ty Gm) X2 (subT Gm D CF0 sG) RG.Rz.K.CF (sym (Ty Gm) (subT Gm D CF0 sG) X2 (subT-o Gm Gm1 D CF0 (p D CF0) (p Gm1 W0))) RG.law ;
    wv1 : El Gm X2 = wkE Gm1 W0 W0 (q D CF0) ;
    wv2 : El Gm X2 = q Gm1 W0 ;
    e : El Gm (IJ.IdT Gm RG.Rz.K.CF (trE Gm X2 RG.Rz.K.CF PX wv1) (trE Gm X2 RG.Rz.K.CF PX wv2)) =
      EG4.PR[Gm, BG, TmG, PcG, fIG, a0G, rhoG, idPE, trE Gm X2 RG.Rz.K.CF PX wv1, trE Gm X2 RG.Rz.K.CF PX wv2].res ;
    eX : El Gm (EQ.Id2 D CF0) = idBack Gm X2 RG.Rz.K.CF PX wv1 wv2 e ;
    res : El D (PU.isProp D CF0) = lam D CF0 (PS.Pi Gm1 W0 (EQ.Id2 D CF0)) (lam Gm1 W0 (EQ.Id2 D CF0) eX) ;
  } ;
} ;
