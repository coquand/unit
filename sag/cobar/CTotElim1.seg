-- CTotElim1.seg (canonicity-c2; towards (c), the eliminator of Tr): at
-- the levelwise site, the truncation is not strictly stable under
-- substitution, but there is a comparison Tr0(A)[s] -> Tr0(A[s]) along
-- any s : D -> G (as in GCTruncSeed: the recursor of Tr0(A) into the
-- pushforward s_* Tr0(A[s]), then the counit).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module CmpOf (C : CIntCat[a, vl].IC) (D G : CTotR[a, vl, l].TotR[C].G0.fibCwF-T.Ctx)
  (s : CTotR[a, vl, l].TotR[C].G0.fibCwF-T.Sub D G) (A : CTotR[a, vl, l].TotR[C].G0.fibCwF-T.Ty G) {
 module G0 = CTotR[a, vl, l].TotR[C].G0 ;
 module TO = G0.FT.GCTruncCwF[l].TrOf[G, A] ;
 As : G0.fibCwF-T.Ty D = G0.fibCwF-T.subT D G A s ;
 module TO' = G0.FT.GCTruncCwF[l].TrOf[D, As] ;
 module TPm = G0.FT.GCTruncPushAdj[l].Tp[D, G, s, A.1, TO'.Ty, TO'.TT.inclusion] ;
 module PA = G0.FT.GCTruncPushAlg[l].PushAlg[D, G, s, TO'.Ty, TO'.opG] ;
 module RC = TO.TT.Recursor[TPm.Pu.pushTy, PA.algebra, TPm.map] ;
 module UTm = G0.FT.GCTruncPushAdj[l].Ut[D, G, s, TO.Ty, TO'.Ty, RC.map] ;
 cmp : G0.GB.CHtpyOps[l].NMap[D, CTotR[a, vl, l].TotR[C].P0.subTy D G TO.Ty s, TO'.Ty] = UTm.map ;
} ;
