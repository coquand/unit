-- CCst4.seg (canonicity-45; COBAR.md "constants"): at a copy y', the
-- constant cst r of G and tau of the code k_r : F1 -> y' (generator |->
-- cst r, strictly natural at the copy) are joined by a path: EqQinv's
-- homotopy of D(yo F0 -> 1) at tau of the canonical code F0 -> y', pushed
-- through D(yo k) (as CL59j); its ends by Cor 15 / CTotTauDM and tau's
-- naturality (CTauOps).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module C4 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (cF0 : (y' : SX.Over[R].Presentation) -> FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId].isContr FibCwF[a, a+].fibCwF.nil (CHomT3[a].HomP[R, encK, pe].Hom[CCst2[a].Cst[R, encK, pe].F0, y'].HomT)))
  (y' : SX.Over[R].Presentation) (r : R.R) {
 module K3 = CCst3[a].Cst3[R, encK, pe] ;
 module K2 = K3.K2 ;
 module FN = K3.Fin[cF0] ;
 module KR = FN.KR[r] ;
 module CM = K2.CM ;
 module CT = K2.CT ;
 module TR = K2.TR ;
 module G1 = TR.G1 ;
 module HO1 = G1.GB.CHtpyOps[a+] ;
 module P13 = FN.P13 ;
 DG : TR.P1.PCtx = P13.DF.DG ;
 DA0 : TR.P1.PTy[DG] = P13.DF.DA.DTy ;
 DB0 : TR.P1.PTy[DG] = P13.DF.DB.DTy ;
 module EQd = FN.EQd ;
 module TE = HO1.HT[DG, DA0, DA0, HO1.compN DG DA0 DB0 DA0 EQd.PNa.nm EQd.EI.gN, HO1.idN DG DA0] ;
 -- the canonical code F0 -> y' and the code k_r : F1 -> y'
 module SCan = CM.II.SubC[K2.F0, y', \ v -> absurd (SX.Over[R].Der[y'].Term) v, \ pp m -> absurd _ m] ;
 K0 (W : Ob) : CT.TC.TOb = (W, y') ;
 module TA0 = CTotL14a[a, a+, a+].TauA[CM.IC, CT.T1, K2.O0.Y1T] ;
 z (W : Ob) : V1.Ix (TE.GA.ob (K0 W)) = (P13.DF.D.tau W y' tt, TA0.tauA W y' tt (SCan.M.mor W)) ;
 qm (Vv W : Ob) (g : Hom Vv W) : CT.TC.THm (Vv, y') (W, y') = (g, CM.IC.cart Vv W g y') ;
 lineC (W Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv) : KR.DSr.DG.Ob' Vv y' =
  KR.DSr.dmap Vv y' (K2.O0.fw (Vv, y') (TE.pv EQd.EI.eta (K0 W) (z W) (Vv, y') (qm Vv W g) j)) ;
 -- the start: f (tau_A can) = tau_A tt, so the start is cst r
 module TDM = CTotTauDM[a, a+, a+].TauDM[CM.IC, CT.T1, K2.O0.Y1T, K2.OT.Y1T, K2.cF] ;
 module TYB = G1.GB.GPre[a+].TyL[DG, DB0] ;
 nfEq (W : Ob) : Id (P13.DF.DB.TOb' W y' (P13.DF.D.tau W y' tt)) (EQd.PNa.nf (K0 W) (P13.DF.D.tau W y' tt) (z W).2) (FN.TA1.tauA W y' tt tt) =
  transH (TYB.pr-inj (K0 W) (P13.DF.D.tau W y' tt) (EQd.PNa.nf (K0 W) (P13.DF.D.tau W y' tt) (z W).2) (TDM.At[W, y', tt, SCan.M.mor W].DMt.res)
            (EQd.PNa.q (K0 W) (P13.DF.D.tau W y' tt) (z W).2))
   (transH TDM.At[W, y', tt, SCan.M.mor W].law (apH {V1.Ix (K2.OT.Y1T.tob (W, y') tt)} {P13.DF.DB.TOb' W y' (P13.DF.D.tau W y' tt)} (FN.TA1.tauA W y' tt) (isTop TDM.At[W, y', tt, SCan.M.mor W].bv tt))) ;
 end0 : (W : Ob) -> Id (KR.DSr.DG.Ob' W y') (lineC W W (idH W) (PB.ptH W PB.e0)) (KR.cstD (K0 W)) = \ W ->
  apH {V1.Ix (TE.GA.ob (K0 W))} {KR.DSr.DG.Ob' W y'} (\ t -> KR.DSr.dmap W y' (K2.O0.fw (K0 W) t))
   (transH (EQd.EI.eta.eob (K0 W) (z W)).2.2.1
     (apH {P13.DF.DB.TOb' W y' (P13.DF.D.tau W y' tt)} {V1.Ix (TE.GA.ob (K0 W))} (\ b -> (P13.DF.D.tau W y' tt, EQd.EI.gN.nfun (K0 W) (P13.DF.D.tau W y' tt) b)) (nfEq W))) ;
 -- the end: fw z = tau can, D(yo k) (tau can) = tau (can . k) = tau k_r
 module TO = CTauOps[a, a+, a+].TauOps[CM.IC] ;
 fwz (W : Ob) : Id (KR.DSr.DD.Ob' W y') (K2.O0.fw (K0 W) (z W)) (KR.DSr.DD.tau W y' (SCan.M.mor W)) =
  KR.DSr.DD.ob-eq W y' (K2.O0.fw (K0 W) (z W)) (KR.DSr.DD.tau W y' (SCan.M.mor W)) (\ q l ->
   apH {CM.TP.HomD q.2.1 W q.2.2.1 q.2.2.2.1 y'} {V1.Ix (K2.Y0.ob q.2.1 q.2.2.2.1)} (\ f0 -> K2.Y0.act q.2.1 W q.2.2.1 q.2.2.2.1 y' f0 (SCan.M.mor W))
    (TO.tmapEq CT.T1 K2.Y0 W y' q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1)) ;
 -- the code side of the constant: the composite F1 -> F0 -> y'
 kc (W : Ob) : V1.Ix (FN.Y1.ob W y') = KR.PRe.preS.nt W y' (SCan.M.mor W) ;
 end1 : (W : Ob) -> Id (KR.DSr.DG.Ob' W y') (lineC W W (idH W) (PB.ptH W PB.e1)) (KR.DSr.DG.tau W y' (kc W)) = \ W ->
  transH (apH {V1.Ix (TE.GA.ob (K0 W))} {KR.DSr.DG.Ob' W y'} (\ t -> KR.DSr.dmap W y' (K2.O0.fw (K0 W) t)) (EQd.EI.eta.eob (K0 W) (z W)).2.2.2)
   (transH (apH {KR.DSr.DD.Ob' W y'} {KR.DSr.DG.Ob' W y'} (KR.DSr.dmap W y') (fwz W))
     (TO.TauS[K2.Y0, FN.Y1, KR.PRe.preS].law W y' (SCan.M.mor W))) ;
 -- naturality of the line along the copy's maps
 cmpEq (K J I : Ob) (uu : Hom J I) (v : Hom K J)
  : Id (CT.TC.THm (K, y') (I, y')) (CT.TC.TotCat.oC (K, y') (J, y') (I, y') (qm J I uu) (qm K J v)) (qm K I (compH K J I uu v)) =
  CM.CO.pq K I y' y' (compH K J I uu v) (compH K J I uu v) (refl (compH K J I uu v))
   (CM.CO.cmpM K J I v y' y' y' (CM.IC.cart J I uu y') (CM.IC.cart K J v y')) (CM.IC.cart K I (compH K J I uu v) y')
   (CM.MO.Fn[y', y'].mExt K (CM.CO.cmpM K J I v y' y' y' (CM.IC.cart J I uu y') (CM.IC.cart K J v y')) (CM.IC.cart K I (compH K J I uu v) y')
      (refl (CM.MO.Fn[y', y'].fpOf K (CM.IC.cart K I (compH K J I uu v) y')))) ;
 lineN (W Vb Va : Ob) (g2 : Hom Vb Va) (g : Hom Va W) (j : Hom Va Iv)
  : Id (KR.DSr.DG.Ob' Vb y') (KR.DSr.DG.act Vb Va g2 y' y' (CM.IC.cart Vb Va g2 y') (lineC W Va g j)) (lineC W Vb (compH Vb Va W g g2) (compH Vb Va Iv j g2)) =
  transH (symH (KR.DSr.dmap-nat Vb Va g2 y' y' (CM.IC.cart Vb Va g2 y') (K2.O0.fw (Va, y') (TE.pv EQd.EI.eta (K0 W) (z W) (Va, y') (qm Va W g) j))))
   (apH {KR.DSr.DD.Ob' Vb y'} {KR.DSr.DG.Ob' Vb y'} (KR.DSr.dmap Vb y')
     (transH (symH (K2.O0.fwN (Vb, y') (Va, y') (qm Vb Va g2) (TE.pv EQd.EI.eta (K0 W) (z W) (Va, y') (qm Va W g) j)))
       (apH {V1.Ix (TE.GA.ob (Vb, y'))} {KR.DSr.DD.Ob' Vb y'} (K2.O0.fw (Vb, y'))
         (transH ((EQd.EI.eta.eob (K0 W) (z W)).1.2 (Vb, y') (Va, y') (qm Vb Va g2) (qm Va W g) j)
           (apH {CT.TC.THm (Vb, y') (K0 W)} {V1.Ix (TE.GA.ob (Vb, y'))} (\ kk -> TE.pv EQd.EI.eta (K0 W) (z W) (Vb, y') kk (compH Vb Va Iv j g2)) (cmpEq Vb Va W g g2)))))) ;
 -- the closed types at the copy: G's fibres and the codes F1 -> y', and tau between them
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 module DY1 = KR.DSr.DG ;
 Y1 : CM.TP.TCtx = FN.Y1 ;
 cartId (I : Ob) (x : V1.Ix (CM.IC.obD I)) : Id (CM.TP.HomD I I (idH I) x x) (CM.IC.cart I I (idH I) x) (CM.IC.idD I x) =
  CM.MO.Fn[x, x].mExt I (CM.IC.cart I I (idH I) x) (CM.IC.idD I x) (refl (CM.MO.Fn[x, x].fpOf I (CM.IC.idD I x))) ;
 cartO (K J I : Ob) (uu : Hom J I) (v : Hom K J) : Id (CM.TP.HomD K I (compH K J I uu v) y' y') (CM.IC.cart K I (compH K J I uu v) y') (CM.IC.compD K J I uu v y' y' y' (CM.IC.cart J I uu y') (CM.IC.cart K J v y')) =
  CM.MO.Fn[y', y'].mExt K (CM.IC.cart K I (compH K J I uu v) y') (CM.IC.compD K J I uu v y' y' y' (CM.IC.cart J I uu y') (CM.IC.cart K J v y'))
   (refl (CM.MO.Fn[y', y'].fpOf K (CM.IC.cart K I (compH K J I uu v) y'))) ;
 module ClT (Z : CM.TP.TCtx) {
  tob (I : Ob) (o : V1.Ix (Nl.ob I)) : V1.V = Z.ob I y' ;
  tact (J I : Ob) (h : Hom J I) (o : V1.Ix (Nl.ob I)) (o' : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h o) o') (w : V1.Ix (tob I o)) : V1.Ix (tob J o') =
   Z.act J I h y' y' (CM.IC.cart J I h y') w ;
  ty : L.PTy[Nl] = L.mkTy Nl tob tact
   (\ I o e w -> transH (apH {CM.TP.HomD I I (idH I) y' y'} {V1.Ix (Z.ob I y')} (\ f -> Z.act I I (idH I) y' y' f w) (cartId I y')) (Z.act-id I y' w))
   (\ K J I f g o o' o'' e1 e2 e3 w -> transH (apH {CM.TP.HomD K I (compH K J I f g) y' y'} {V1.Ix (Z.ob K y')} (\ f0 -> Z.act K I (compH K J I f g) y' y' f0 w) (cartO K J I f g))
      (Z.act-o K J I f g y' y' y' (CM.IC.cart J I f y') (CM.IC.cart K J g y') w)) ;
 } ;
 Tc : L.PTy[Nl] = ClT[DY1.DCtx].ty ;
 Ac : L.PTy[Nl] = ClT[Y1].ty ;
 module HO = PB.CHtpyOps[a+] ;
 tauc : HO.NMap[Nl, Ac, Tc] =
  new HO.NMap[Nl, Ac, Tc, \ I o a0 -> DY1.tau I y' a0, \ J I h x x' e a0 -> symH (DY1.tau-nat J I h y' y' (CM.IC.cart J I h y') a0)] ;
 -- the naturality of the constants and of the point z
 canN (J I : Ob) (h : Hom J I) : Id (V1.Ix (K2.Y0.ob J y')) (K2.Y0.act J I h y' y' (CM.IC.cart J I h y') (SCan.M.mor I)) (SCan.M.mor J) =
  transH (CM.MO.Fn[K2.F0, y'].mExt J (K2.Y0.act J I h y' y' (CM.IC.cart J I h y') (SCan.M.mor I)) (CM.MO.Fn[K2.F0, y'].res I J h (SCan.M.mor I))
            (refl (CM.MO.Fn[K2.F0, y'].fpOf J (CM.MO.Fn[K2.F0, y'].res I J h (SCan.M.mor I)))))
   (SCan.M.mor-nat I J h) ;
 kcN (J I : Ob) (h : Hom J I) : Id (V1.Ix (Y1.ob J y')) (Y1.act J I h y' y' (CM.IC.cart J I h y') (kc I)) (kc J) =
  transH (symH (KR.PRe.preS.nt-nat J I h y' y' (CM.IC.cart J I h y') (SCan.M.mor I)))
   (apH {V1.Ix (K2.Y0.ob J y')} {V1.Ix (Y1.ob J y')} (KR.PRe.preS.nt J y') (canN J I h)) ;
 module TN0 (J I : Ob) (h : Hom J I) {
  module TN = TA0.Nat[J, I, h, y', y', CM.IC.cart J I h y', tt, SCan.M.mor I] ;
  zN : Id (V1.Ix (TE.GA.ob (K0 J))) (TE.GA.act (K0 J) (K0 I) (qm J I h) (z I)) (z J) =
   transH (TE.TA.pr-tact (K0 J) (K0 I) (qm J I h) (P13.DF.D.tau I y' tt) (P13.DF.D.tau J y' tt) TN.e (z I).2)
    (apH {P13.DF.DA.TOb' J y' (P13.DF.D.tau J y' tt)} {TE.TA.EI (K0 J)} (TE.TA.pr (K0 J) (P13.DF.D.tau J y' tt))
      (transH TN.law (apH {V1.Ix (K2.Y0.ob J y')} {P13.DF.DA.TOb' J y' (P13.DF.D.tau J y' tt)} (TA0.tauA J y' tt) (canN J I h)))) ;
 } ;
 -- the constants' compatibility as a path homotopy, for any domain X
 module CstH (X : L.PTy[Nl]) {
  cTN : HO.NMap[Nl, X, Tc] = new HO.NMap[Nl, X, Tc, \ I o w -> KR.cstD (K0 I), \ J I h x x' e w -> KR.NT[K0 J, K0 I, qm J I h].law] ;
  cAN : HO.NMap[Nl, X, Ac] = new HO.NMap[Nl, X, Ac, \ I o w -> kc I, \ J I h x x' e w -> kcN J I h] ;
  module CH = HO.HT[Nl, X, Tc, cTN, HO.compN Nl X Ac Tc cAN tauc] ;
  module TTc = PB.GPre[a+].TyL[Nl, Tc] ;
  path (W : Ob) (zz : V1.Ix (CH.GA.ob W)) : V1.Ix (CH.PT.tobP W zz) =
   CH.PT.mkPath W zz (\ Vv g j -> TTc.pr Vv (CH.TA.pr1 W zz) (lineC W Vv g j))
    (\ Vb Va g2 g j -> transH (TTc.pr-tact Vb Va g2 (CH.TA.pr1 W zz) (CH.TA.pr1 W zz) (refl (CH.TA.pr1 W zz)) (lineC W Va g j))
        (apH {DY1.Ob' Vb y'} {TTc.EI Vb} (TTc.pr Vb (CH.TA.pr1 W zz)) (lineN W Vb Va g2 g j)))
    (\ Vv g j -> refl (CH.TA.pr1 W zz))
    (apH {DY1.Ob' W y'} {TTc.EI W} (TTc.pr W (CH.TA.pr1 W zz)) (end0 W))
    (apH {DY1.Ob' W y'} {TTc.EI W} (TTc.pr W (CH.TA.pr1 W zz)) (end1 W)) ;
  enat (J I : Ob) (h : Hom J I) (zz : V1.Ix (CH.GA.ob I)) (zz' : V1.Ix (CH.GA.ob J)) (ee : Id (V1.Ix (CH.GA.ob J)) (CH.GA.act J I h zz) zz')
   : Id (V1.Ix (CH.PT.tobP J zz')) (CH.PT.PathP.tact J I h zz zz' ee (path I zz)) (path J zz') =
   CH.PT.path-eq J zz' (CH.PT.PathP.tact J I h zz zz' ee (path I zz)) (path J zz') (\ Vv f i ->
    transH (apH {DY1.Ob' Vv y'} {TTc.EI Vv} (TTc.pr Vv (CH.TA.pr1 I zz))
      (apH {V1.Ix (TE.GA.ob (Vv, y'))} {DY1.Ob' Vv y'} (\ t -> KR.DSr.dmap Vv y' (K2.O0.fw (Vv, y') t))
        (transH (apH {CT.TC.THm (Vv, y') (K0 I)} {V1.Ix (TE.GA.ob (Vv, y'))} (\ kk -> TE.pv EQd.EI.eta (K0 I) (z I) (Vv, y') kk i) (symH (cmpEq Vv J I h f)))
          (transH (TE.pv-res EQd.EI.eta (K0 J) (K0 I) (qm J I h) (z I) (TE.GA.act (K0 J) (K0 I) (qm J I h) (z I)) (refl (TE.GA.act (K0 J) (K0 I) (qm J I h) (z I))) (Vv, y') (qm Vv J f) i)
            (apH {V1.Ix (TE.GA.ob (K0 J))} {V1.Ix (TE.GA.ob (Vv, y'))} (\ z2 -> TE.pv EQd.EI.eta (K0 J) z2 (Vv, y') (qm Vv J f) i) TN0[J, I, h].zN)))))
     (apH {V1.Ix (CH.GA.ob J)} {TTc.EI Vv} (\ z2 -> TTc.pr Vv (CH.TA.pr1 J z2) (lineC J Vv f i)) ee)) ;
  -- cst r ~ tau (kc) as maps from X
  res : L.PEl[CH.GA, CH.PT.PathP] = new L.PEl[CH.GA, CH.PT.PathP, path, enat] ;
 } ;
} ;
