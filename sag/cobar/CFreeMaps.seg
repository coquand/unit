-- CFreeMaps.seg (canonicity-45; SIMPLIFIED.md step 6): closed algebra maps
-- A_s -> A_t from substitutions of generators, through the quotient's
-- eliminator (c2's CwFQuotElim1.QE1, here a module parameter of the agreed
-- shape Elim1Ty / Elim1Beta):
--   Phi      elim1 at the family t |-> cls (sbT t), which respects the
--            relation by CSubst's proof-sb (through CRelResp.PackAp)
--   beta     Phi (cls t) = cls (sbT t)   (internal Id)
-- Instances: the coprojections I1, I2 and the structure maps AddF, MulF
-- (F1 -> F2: the generator to x1, x2, x1 + x2, x1 x2), and p_u : A_x -> A_{x.u}
-- (Pu, from CSyntax.Rel's renaming).
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

-- the agreed shape of the one-argument eliminator (CAlgX's Elim2Ty, one argument)
module ElimTy (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module AX = CAlgX[a].AlgX[R, encK, x, pe] ;
 Elim1Ty : U a++ =
  (B : C.Ty C.nil) (sB : (b b' : C.El C.nil B) -> C.El C.nil (PU.isProp C.nil (IJ.IdT C.nil B b b')))
  (f : AX.Term -> C.El C.nil B)
  (rs : (t t' : AX.Term) -> C.El C.nil (AX.RelC t t') -> C.El C.nil (IJ.IdT C.nil B (f t) (f t')))
  -> C.El C.nil (OV.Fun C.nil AX.Qt B) ;
 Elim1Beta (elim1 : Elim1Ty) : U a++ =
  (B : C.Ty C.nil) (sB : (b b' : C.El C.nil B) -> C.El C.nil (PU.isProp C.nil (IJ.IdT C.nil B b b')))
  (f : AX.Term -> C.El C.nil B)
  (rs : (t t' : AX.Term) -> C.El C.nil (AX.RelC t t') -> C.El C.nil (IJ.IdT C.nil B (f t) (f t')))
  (t : AX.Term) -> C.El C.nil (IJ.IdT C.nil B (OV.app C.nil AX.Qt B (elim1 B sB f rs) (AX.cls t)) (f t)) ;
 SetQ : U a++ = (q q' : C.El C.nil AX.Qt) -> C.El C.nil (PU.isProp C.nil (AX.IdQ q q')) ;
} ;

module MapsOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (elim1 : (x : SX.Over[R].Presentation) -> ElimTy[R, encK, x, pe].Elim1Ty)
 (elim1-beta : (x : SX.Over[R].Presentation) -> ElimTy[R, encK, x, pe].Elim1Beta (elim1 x))
 (setQ : (x : SX.Over[R].Presentation) -> ElimTy[R, encK, x, pe].SetQ) {
 -- the closed map of a substitution of generators
 module Sub (s t : SX.Over[R].Presentation) (sg : SX.Fin s.1 -> SX.Over[R].Der[t].Term)
  (eqP : (p : SX.Over[R].Der[s].Term) -> SX.Over[R].Der[s].Member p s.2
     -> SX.Over[R].Der[t].Proof (CSubst[a].SE[R].subE (SX.Fin s.1) (SX.Fin t.1) sg p) SX.Over[R].Der[t].zeroE) {
  module AS = CAlgX[a].AlgX[R, encK, s, pe] ;
  module AT = CAlgX[a].AlgX[R, encK, t, pe] ;
  module SB = CSubst[a].SubOf[R, s, t, sg, eqP] ;
  f (u : AS.Term) : C.El C.nil AT.Qt = AT.cls (SB.sbT u) ;
  rs (u u' : AS.Term) (w : C.El C.nil (AS.RelC u u')) : C.El C.nil (AT.IdQ (f u) (f u')) =
   CRelResp[a].PackAp[R, encK, s, u, u', AT.IdQ (f u) (f u'), setQ t (f u) (f u'), \ d -> AT.clsEq (SB.sbT u) (SB.sbT u') (SB.proof-sb u u' d)].atRel w ;
  Phi : C.El C.nil (OV.Fun C.nil AS.Qt AT.Qt) = elim1 s AT.Qt (setQ t) f rs ;
  beta (u : AS.Term) : C.El C.nil (AT.IdQ (OV.app C.nil AS.Qt AT.Qt Phi (AS.cls u)) (AT.cls (SB.sbT u))) =
   elim1-beta s AT.Qt (setQ t) f rs u ;
 } ;
 module FR = CSubst[a].Free[R] ;
 module I1 = Sub[FR.F1, FR.F2, FR.I1.sg, \ p m -> FR.noEq p m _] ;
 module I2 = Sub[FR.F1, FR.F2, FR.I2.sg, \ p m -> FR.noEq p m _] ;
 module AddF = Sub[FR.F1, FR.F2, FR.AddF.sg, \ p m -> FR.noEq p m _] ;
 module MulF = Sub[FR.F1, FR.F2, FR.MulF.sg, \ p m -> FR.noEq p m _] ;
 -- p_u : A_x -> A_{x.u}, from the renaming of the generators of x
 module Pu (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) {
  module RN = SX.Rel[R].Ren[x, u] ;
  module AS = CAlgX[a].AlgX[R, encK, x, pe] ;
  module AT = CAlgX[a].AlgX[R, encK, SX.Rel[R].concat x u, pe] ;
  f (t : AS.Term) : C.El C.nil AT.Qt = AT.cls (RN.rn t) ;
  rs (t t' : AS.Term) (w : C.El C.nil (AS.RelC t t')) : C.El C.nil (AT.IdQ (f t) (f t')) =
   CRelResp[a].PackAp[R, encK, x, t, t', AT.IdQ (f t) (f t'), setQ (SX.Rel[R].concat x u) (f t) (f t'), \ d -> AT.clsEq (RN.rn t) (RN.rn t') (RN.proof-ren t t' d)].atRel w ;
  Phi : C.El C.nil (OV.Fun C.nil AS.Qt AT.Qt) = elim1 x AT.Qt (setQ (SX.Rel[R].concat x u)) f rs ;
  beta (t : AS.Term) : C.El C.nil (AT.IdQ (OV.app C.nil AS.Qt AT.Qt Phi (AS.cls t)) (AT.cls (RN.rn t))) =
   elim1-beta x AT.Qt (setQ (SX.Rel[R].concat x u)) f rs t ;
 } ;
} ;
