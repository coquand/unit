-- CCopy.seg (canonicity-45; SIMPLIFIED.md step 6): C with c2's concrete
-- quotient eliminators (QE1-QE5), and the restriction of presheaves on its
-- levelwise site G0 to the copy of the poset site at a presentation y
-- (I |-> (I, y), u |-> (u, refl)): a functor on the nose because C's
-- objects are constant presentations (res u x = x, res-id and res-comp by
-- refl).  Specific to this C, not generic in the internal category.
--   rCy / rTy / rMy   contexts, types, maps of types restricted
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module ConcC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module CM = CCmp[a].CmpOf[R, encK, pe,
   \ x -> CwFQuotElim2[a].QE2[R, encK, x, pe].elim1, \ x -> CwFQuotElim2[a].QE2[R, encK, x, pe].elim1-beta,
   \ x -> CwFQuotElim1[a].QE1[R, encK, x, pe].setQ,
   \ x -> CwFQuotElim3[a].QE3[R, encK, x, pe].elim2, \ x -> CwFQuotElim3[a].QE3[R, encK, x, pe].elim2-beta,
   \ x -> CwFQuotElim1[a].QE1[R, encK, x, pe].elimP1, \ x -> CwFQuotElim5[a].QE5[R, encK, x, pe].elimP3,
   \ x -> CwFQuotElim1[a].QE1[R, encK, x, pe].setQi] ;
 module TR = CTotR[a, a+, a+].TotR[CM.IC] ;
 module G0 = TR.G0 ;
 module P0 = TR.P0 ;
 Pres : U a = SX.Over[R].Presentation ;
 module Copy (y : Pres) {
  o0 (I : Ob) : G0.TOb = (I, y) ;
  h0 (J I : Ob) (u : Hom J I) : G0.THm (J, y) (I, y) = (u, refl y) ;
  rCy (G : P0.PCtx) : L.PCtx =
   new L.PCtx[\ I -> G.ob (o0 I), \ J I u x -> G.act (o0 J) (o0 I) (h0 J I u) x, \ I x -> G.act-id (o0 I) x,
     \ K J I u v x -> G.act-o (o0 K) (o0 J) (o0 I) (h0 J I u) (h0 K J v) x] ;
  rTy (G : P0.PCtx) (A : P0.PTy[G]) : L.PTy[rCy G] =
   L.mkTy (rCy G) (\ I x -> A.tob (o0 I) x) (\ J I u x x' e v -> A.tact (o0 J) (o0 I) (h0 J I u) x x' e v)
    (\ I x e v -> A.tact-id (o0 I) x e v)
    (\ K J I u v x x' x'' e1 e2 e3 w -> A.tact-o (o0 K) (o0 J) (o0 I) (h0 J I u) (h0 K J v) x x' x'' e1 e2 e3 w) ;
  rMy (G : P0.PCtx) (B A : P0.PTy[G]) (f : G0.GB.CPartial[a+].PMap[G, B, A]) : PB.CPartial[a+].PMap[rCy G, rTy G B, rTy G A] =
   PB.CPartial[a+].mkPMap (rCy G) (rTy G B) (rTy G A) (\ W w -> f.mE (o0 W) w) (\ W w -> f.mpt (o0 W) w)
    (\ V W u w -> f.mnat (o0 V) (o0 W) (h0 V W u) w) ;
 } ;
} ;

-- restriction commutes with context extension on the nose (used by CCopy3)
module RestrExt (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation)
  (G : ConcC[R, encK, pe].P0.PCtx) (A : ConcC[R, encK, pe].P0.PTy[G]) {
 module CC = ConcC[R, encK, pe] ;
 module Cy = CC.Copy[y] ;
 e1 : Id L.PCtx (Cy.rCy (CC.P0.extP G A)) (L.extP (Cy.rCy G) (Cy.rTy G A)) = refl (Cy.rCy (CC.P0.extP G A)) ;
} ;
