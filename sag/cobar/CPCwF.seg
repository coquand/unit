-- CPCwF.seg (canonicity-45; (B) stage 1(i), COBAR.md): the raw CwF of
-- C-presheaves over the base: contexts CCtx, substitutions CSub, types
-- CTy, elements CEl (CPshC), extension ExtC / pPC / subCTy (CPshL), with
-- identities, composition, the empty context, q, lift, sec, and the CwF
-- laws.  Every law is the base's law at each x: a C-record is determined
-- by its values (CPshExt), and a transport of a C-record along a path of
-- C-types is the transport along the base path at each x (PTy is a set),
-- so the base's subEl-id / subEl-o / liftP-id / liftP-o / qP-liftP /
-- qP-secP are the components of subt-id / subt-o / lift-id / lift-o /
-- q-lift / q-sec.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;

module CwFOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 open P ;

 ------------------------------------------------------------------
 -- substitutions: identity, composition, the empty context

 cidC (G : CCtx) : CSub[G, G] = new CSub[G, G, \ x -> idS (G.ob x), \ y x f X d -> refl ((G.act y x f).nt X d)] ;
 coC (T D G : CCtx) (s : CSub[D, G]) (t : CSub[T, D]) : CSub[T, G] =
  new CSub[T, G, \ x -> oS (T.ob x) (D.ob x) (G.ob x) (s.sb x) (t.sb x),
   \ y x f X d -> transH (apH ((s.sb y).nt X) (t.sb-nat y x f X d)) (s.sb-nat y x f X ((t.sb x).nt X d))] ;
 nilC : CCtx = new CCtx[\ x -> nilP, \ y x f -> idS nilP, \ x X g -> refl g, \ z y x f h X g -> refl g] ;
 epsC (G : CCtx) : CSub[G, nilC] = new CSub[G, nilC, \ x -> epsP (G.ob x), \ y x f X d -> refl tt] ;

 ------------------------------------------------------------------
 -- elements substituted; q, lift, sec

 subCEl (D G : CCtx) (A : CTy[G]) (a : CEl[G, A]) (s : CSub[D, G]) : CEl[D, LO.subCTy D G s A] =
  new CEl[D, LO.subCTy D G s A, \ x -> subEl (D.ob x) (G.ob x) (A.ty x) (a.el x) (s.sb x),
   \ y x f X d ->
    LO.SC[D, G, s, A].sub-eq y X _ _ (refl ((D.act y x f).nt X d))
     (transH (LO.SC[D, G, s, A].rBtE y x f X (pairE (D.ob x) (LO.SC[D, G, s, A].ST x) X d ((a.el x).eob X ((s.sb x).nt X d))))
       (transH (a.el-nat y x f X ((s.sb x).nt X d))
         (apH (\ pt -> pairE (G.ob y) (A.ty y) X pt ((a.el y).eob X pt)) (symH (s.sb-nat y x f X d)))))] ;

 qC (G : CCtx) (A : CTy[G]) : CEl[LO.ExtC G A, LO.subCTy (LO.ExtC G A) G (LO.pPC G A) A] =
  new CEl[LO.ExtC G A, LO.subCTy (LO.ExtC G A) G (LO.pPC G A) A, \ x -> qP (G.ob x) (A.ty x),
   \ y x f X w ->
    LO.SC[LO.ExtC G A, G, LO.pPC G A, A].sub-eq y X _ _ (refl ((A.tE y x f).nt X w))
     (LO.SC[LO.ExtC G A, G, LO.pPC G A, A].rBtE y x f X (pairE (extP (G.ob x) (A.ty x)) (LO.SC[LO.ExtC G A, G, LO.pPC G A, A].ST x) X w (sndE (G.ob x) (A.ty x) X w)))] ;

 liftC (D G : CCtx) (A : CTy[G]) (s : CSub[D, G]) : CSub[LO.ExtC D (LO.subCTy D G s A), LO.ExtC G A] =
  new CSub[LO.ExtC D (LO.subCTy D G s A), LO.ExtC G A, \ x -> liftP (D.ob x) (G.ob x) (A.ty x) (s.sb x),
   \ y x f X w -> LO.SC[D, G, s, A].rBtE y x f X w] ;

 secC (G : CCtx) (A : CTy[G]) (a : CEl[G, A]) : CSub[G, LO.ExtC G A] =
  new CSub[G, LO.ExtC G A, \ x -> secP (G.ob x) (A.ty x) (a.el x), \ y x f X d -> symH (a.el-nat y x f X d)] ;

 ------------------------------------------------------------------
 -- transports of C-elements and C-substitutions along a path of C-types
 -- are the transports along the base paths (PTy is a set)

 elTrC (G : CCtx) (B B' : CTy[G]) (Pc : Id (CTy[G]) B B') (u : CEl[G, B]) (x : CO)
  : Id (PEl[G.ob x, B'.ty x]) ((subst (CTy[G]) (\ X -> CEl[G, X]) B B' Pc u).el x)
       (subst (PTy[G.ob x]) (\ T -> PEl[G.ob x, T]) (B.ty x) (B'.ty x) (apH (\ X -> X.ty x) Pc) (u.el x)) =
  idJ (CTy[G]) B (\ B2 P2 -> Id (PEl[G.ob x, B2.ty x]) ((subst (CTy[G]) (\ X -> CEl[G, X]) B B2 P2 u).el x)
                     (subst (PTy[G.ob x]) (\ T -> PEl[G.ob x, T]) (B.ty x) (B2.ty x) (apH (\ X -> X.ty x) P2) (u.el x)))
   (refl (u.el x)) B' Pc ;
 cel-subst (G : CCtx) (B B' : CTy[G]) (Pc : Id (CTy[G]) B B') (Pf : (x : CO) -> Id (PTy[G.ob x]) (B.ty x) (B'.ty x))
  (u : CEl[G, B]) (t : CEl[G, B'])
  (h : (x : CO) -> Id (PEl[G.ob x, B'.ty x]) (subst (PTy[G.ob x]) (\ T -> PEl[G.ob x, T]) (B.ty x) (B'.ty x) (Pf x) (u.el x)) (t.el x))
  : Id (CEl[G, B']) (subst (CTy[G]) (\ X -> CEl[G, X]) B B' Pc u) t =
  EX.cel-ext G B' (subst (CTy[G]) (\ X -> CEl[G, X]) B B' Pc u) t (\ x X g ->
   apH (\ e -> e.eob X g)
    (transH (elTrC G B B' Pc u x)
      (transH (apH (\ pp -> subst (PTy[G.ob x]) (\ T -> PEl[G.ob x, T]) (B.ty x) (B'.ty x) pp (u.el x))
                 (isSet-PTy (G.ob x) (B.ty x) (B'.ty x) (apH (\ X2 -> X2.ty x) Pc) (Pf x)))
        (h x)))) ;

 sbTrC (G : CCtx) (Xc : CCtx) (B B' : CTy[G]) (Pc : Id (CTy[G]) B B') (u : CSub[LO.ExtC G B, Xc]) (x : CO)
  : Id (PSub[extP (G.ob x) (B'.ty x), Xc.ob x]) ((subst (CTy[G]) (\ X -> CSub[LO.ExtC G X, Xc]) B B' Pc u).sb x)
       (subst (PTy[G.ob x]) (\ T -> PSub[extP (G.ob x) T, Xc.ob x]) (B.ty x) (B'.ty x) (apH (\ X -> X.ty x) Pc) (u.sb x)) =
  idJ (CTy[G]) B (\ B2 P2 -> Id (PSub[extP (G.ob x) (B2.ty x), Xc.ob x]) ((subst (CTy[G]) (\ X -> CSub[LO.ExtC G X, Xc]) B B2 P2 u).sb x)
                     (subst (PTy[G.ob x]) (\ T -> PSub[extP (G.ob x) T, Xc.ob x]) (B.ty x) (B2.ty x) (apH (\ X -> X.ty x) P2) (u.sb x)))
   (refl (u.sb x)) B' Pc ;
 csub-subst (G : CCtx) (Xc : CCtx) (B B' : CTy[G]) (Pc : Id (CTy[G]) B B') (Pf : (x : CO) -> Id (PTy[G.ob x]) (B.ty x) (B'.ty x))
  (u : CSub[LO.ExtC G B, Xc]) (t : CSub[LO.ExtC G B', Xc])
  (h : (x : CO) -> Id (PSub[extP (G.ob x) (B'.ty x), Xc.ob x])
                      (subst (PTy[G.ob x]) (\ T -> PSub[extP (G.ob x) T, Xc.ob x]) (B.ty x) (B'.ty x) (Pf x) (u.sb x)) (t.sb x))
  : Id (CSub[LO.ExtC G B', Xc]) (subst (CTy[G]) (\ X -> CSub[LO.ExtC G X, Xc]) B B' Pc u) t =
  EX.csub-ext (LO.ExtC G B') (Xc) (subst (CTy[G]) (\ X -> CSub[LO.ExtC G X, Xc]) B B' Pc u) t (\ x X w ->
   apH (\ e -> e.nt X w)
    (transH (sbTrC G Xc B B' Pc u x)
      (transH (apH (\ pp -> subst (PTy[G.ob x]) (\ T -> PSub[extP (G.ob x) T, Xc.ob x]) (B.ty x) (B'.ty x) pp (u.sb x))
                 (isSet-PTy (G.ob x) (B.ty x) (B'.ty x) (apH (\ X2 -> X2.ty x) Pc) (Pf x)))
        (h x)))) ;

 ------------------------------------------------------------------
 -- the laws of substitution on types

 module TId (G : CCtx) (A : CTy[G]) {
  module SC = LO.SC[G, G, cidC G, A] ;
  Pf (x : CO) : Id (PTy[G.ob x]) (SC.ST x) (A.ty x) = subTy-id (G.ob x) (A.ty x) ;
  Q (y x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (SC.ST x) X)
   : Id (SigT (G.ob y) (A.ty y) X)
      ((A.tE y x f).nt X (subst (PTy[G.ob x]) (\ T -> SigT (G.ob x) T X) (SC.ST x) (A.ty x) (Pf x) w))
      (subst (PTy[G.ob y]) (\ T -> SigT (G.ob y) T X) (SC.ST y) (A.ty y) (Pf y) ((SC.subCTy.tE y x f).nt X w)) =
   transH (apH ((A.tE y x f).nt X) (EX.tyTr-same (G.ob x) (SC.ST x) (A.ty x) (Pf x) (refl (A.ty x).tob) X w))
    (transH (symH (SC.rBtE y x f X w))
      (symH (EX.tyTr-same (G.ob y) (SC.ST y) (A.ty y) (Pf y) (refl (A.ty y).tob) X (SC.tEs y x f X w)))) ;
  res : Id (CTy[G]) (LO.subCTy G G (cidC G) A) A = EX.cty-ext2 G (LO.subCTy G G (cidC G) A) A Pf Q ;
 } ;
 subT-idC (G : CCtx) (A : CTy[G]) : Id (CTy[G]) (LO.subCTy G G (cidC G) A) A = TId[G, A].res ;

 module TO (T D G : CCtx) (A : CTy[G]) (s : CSub[D, G]) (s' : CSub[T, D]) {
  module SC = LO.SC[T, G, coC T D G s s', A] ;
  module SC1 = LO.SC[D, G, s, A] ;
  module SC2 = LO.SC[T, D, s', LO.subCTy D G s A] ;
  Pf (x : CO) : Id (PTy[T.ob x]) (SC.ST x) (SC2.ST x) = subTy-o (T.ob x) (D.ob x) (G.ob x) (A.ty x) (s.sb x) (s'.sb x) ;
  -- the two actions agree: both read in A through the readings rB
  agree (y x : CO) (f : CH y x) (X : Ob) (w : SigT (T.ob x) (SC.ST x) X)
   : Id (SigT (T.ob y) (SC2.ST y) X) (SC2.tEs y x f X w) (SC.tEs y x f X w) =
   SC2.sub-eq y X (SC2.tEs y x f X w) (SC.tEs y x f X w) (refl ((T.act y x f).nt X (fstE (T.ob x) (SC.ST x) X w)))
    (SC1.sub-eq y X (SC2.rB y X (SC2.tEs y x f X w)) (SC2.rB y X (SC.tEs y x f X w)) (refl ((s'.sb y).nt X ((T.act y x f).nt X (fstE (T.ob x) (SC.ST x) X w))))
      (transH (apH (SC1.rB y X) (SC2.rBtE y x f X w))
        (transH (SC1.rBtE y x f X (SC2.rB x X w))
          (symH (SC.rBtE y x f X w))))) ;
  Q (y x : CO) (f : CH y x) (X : Ob) (w : SigT (T.ob x) (SC.ST x) X)
   : Id (SigT (T.ob y) (SC2.ST y) X)
      ((SC2.subCTy.tE y x f).nt X (subst (PTy[T.ob x]) (\ Tt -> SigT (T.ob x) Tt X) (SC.ST x) (SC2.ST x) (Pf x) w))
      (subst (PTy[T.ob y]) (\ Tt -> SigT (T.ob y) Tt X) (SC.ST y) (SC2.ST y) (Pf y) ((SC.subCTy.tE y x f).nt X w)) =
   transH (apH (SC2.tEs y x f X) (EX.tyTr-same (T.ob x) (SC.ST x) (SC2.ST x) (Pf x) (refl (SC.ST x).tob) X w))
    (transH (agree y x f X w)
      (symH (EX.tyTr-same (T.ob y) (SC.ST y) (SC2.ST y) (Pf y) (refl (SC.ST y).tob) X (SC.tEs y x f X w)))) ;
  res : Id (CTy[T]) (LO.subCTy T G (coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A)) =
   EX.cty-ext2 T (LO.subCTy T G (coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A)) Pf Q ;
 } ;
 subT-oC (T D G : CCtx) (A : CTy[G]) (s : CSub[D, G]) (s' : CSub[T, D])
  : Id (CTy[T]) (LO.subCTy T G (coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A)) = TO[T, D, G, A, s, s'].res ;

 ------------------------------------------------------------------
 -- the laws on substitutions, pointwise

 p-liftC (D G : CCtx) (A : CTy[G]) (s : CSub[D, G])
  : Id (CSub[LO.ExtC D (LO.subCTy D G s A), G])
      (coC (LO.ExtC D (LO.subCTy D G s A)) (LO.ExtC G A) G (LO.pPC G A) (liftC D G A s))
      (coC (LO.ExtC D (LO.subCTy D G s A)) D G s (LO.pPC D (LO.subCTy D G s A))) =
  EX.csub-ext (LO.ExtC D (LO.subCTy D G s A)) G _ _ (\ x X w -> refl ((s.sb x).nt X (fstE (D.ob x) (LO.SC[D, G, s, A].ST x) X w))) ;
 p-secC (G : CCtx) (A : CTy[G]) (a : CEl[G, A])
  : Id (CSub[G, G]) (coC G (LO.ExtC G A) G (LO.pPC G A) (secC G A a)) (cidC G) =
  EX.csub-ext G G _ _ (\ x X d -> refl d) ;
 sec-oC (D G : CCtx) (A : CTy[G]) (a : CEl[G, A]) (s : CSub[D, G])
  : Id (CSub[D, LO.ExtC G A]) (coC D G (LO.ExtC G A) (secC G A a) s)
      (coC D (LO.ExtC D (LO.subCTy D G s A)) (LO.ExtC G A) (liftC D G A s) (secC D (LO.subCTy D G s A) (subCEl D G A a s))) =
  EX.csub-ext D (LO.ExtC G A) _ _ (\ x X d -> refl (pairE (G.ob x) (A.ty x) X ((s.sb x).nt X d) ((a.el x).eob X ((s.sb x).nt X d)))) ;
 lift-p-sec-qC (G : CCtx) (A : CTy[G])
  : Id (CSub[LO.ExtC G A, LO.ExtC G A])
      (coC (LO.ExtC G A) (LO.ExtC (LO.ExtC G A) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) A)) (LO.ExtC G A)
         (liftC (LO.ExtC G A) G A (LO.pPC G A)) (secC (LO.ExtC G A) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) A) (qC G A)))
      (cidC (LO.ExtC G A)) =
  EX.csub-ext (LO.ExtC G A) (LO.ExtC G A) _ _ (\ x X w -> refl w) ;

 ------------------------------------------------------------------
 -- the laws with transports: the base's, at each x

 subt-idC (G : CCtx) (A : CTy[G]) (a : CEl[G, A])
  : Id (CEl[G, A]) (subst (CTy[G]) (\ X -> CEl[G, X]) (LO.subCTy G G (cidC G) A) A (subT-idC G A) (subCEl G G A a (cidC G))) a =
  cel-subst G (LO.subCTy G G (cidC G) A) A (subT-idC G A) (\ x -> subTy-id (G.ob x) (A.ty x)) (subCEl G G A a (cidC G)) a
   (\ x -> subEl-id (G.ob x) (A.ty x) (a.el x)) ;
 subt-oC (T D G : CCtx) (A : CTy[G]) (a : CEl[G, A]) (s : CSub[D, G]) (s' : CSub[T, D])
  : Id (CEl[T, LO.subCTy T D s' (LO.subCTy D G s A)])
      (subst (CTy[T]) (\ X -> CEl[T, X]) (LO.subCTy T G (coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A))
         (subT-oC T D G A s s') (subCEl T G A a (coC T D G s s')))
      (subCEl T D (LO.subCTy D G s A) (subCEl D G A a s) s') =
  cel-subst T (LO.subCTy T G (coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A)) (subT-oC T D G A s s')
   (\ x -> subTy-o (T.ob x) (D.ob x) (G.ob x) (A.ty x) (s.sb x) (s'.sb x))
   (subCEl T G A a (coC T D G s s')) (subCEl T D (LO.subCTy D G s A) (subCEl D G A a s) s')
   (\ x -> subEl-o (T.ob x) (D.ob x) (G.ob x) (A.ty x) (a.el x) (s.sb x) (s'.sb x)) ;
 lift-idC (G : CCtx) (A : CTy[G])
  : Id (CSub[LO.ExtC G A, LO.ExtC G A])
      (subst (CTy[G]) (\ B -> CSub[LO.ExtC G B, LO.ExtC G A]) (LO.subCTy G G (cidC G) A) A (subT-idC G A) (liftC G G A (cidC G)))
      (cidC (LO.ExtC G A)) =
  csub-subst G (LO.ExtC G A) (LO.subCTy G G (cidC G) A) A (subT-idC G A) (\ x -> subTy-id (G.ob x) (A.ty x)) (liftC G G A (cidC G)) (cidC (LO.ExtC G A))
   (\ x -> liftP-id (G.ob x) (A.ty x)) ;
 lift-oC (T D G : CCtx) (A : CTy[G]) (s : CSub[D, G]) (s' : CSub[T, D])
  : Id (CSub[LO.ExtC T (LO.subCTy T D s' (LO.subCTy D G s A)), LO.ExtC G A])
      (subst (CTy[T]) (\ B -> CSub[LO.ExtC T B, LO.ExtC G A]) (LO.subCTy T G (coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A))
         (subT-oC T D G A s s') (liftC T G A (coC T D G s s')))
      (coC (LO.ExtC T (LO.subCTy T D s' (LO.subCTy D G s A))) (LO.ExtC D (LO.subCTy D G s A)) (LO.ExtC G A)
         (liftC D G A s) (liftC T D (LO.subCTy D G s A) s')) =
  csub-subst T (LO.ExtC G A) (LO.subCTy T G (coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A)) (subT-oC T D G A s s')
   (\ x -> subTy-o (T.ob x) (D.ob x) (G.ob x) (A.ty x) (s.sb x) (s'.sb x))
   (liftC T G A (coC T D G s s'))
   (coC (LO.ExtC T (LO.subCTy T D s' (LO.subCTy D G s A))) (LO.ExtC D (LO.subCTy D G s A)) (LO.ExtC G A) (liftC D G A s) (liftC T D (LO.subCTy D G s A) s'))
   (\ x -> liftP-o (T.ob x) (D.ob x) (G.ob x) (A.ty x) (s.sb x) (s'.sb x)) ;

 ------------------------------------------------------------------
 -- the derived type equations of the CwF, in the instance's terms (the
 -- shape of CwF.p-lift-T / p-sec-T with the fields substituted)

 p-lift-TC (D G : CCtx) (A B : CTy[G]) (s : CSub[D, G])
  : Id (CTy[LO.ExtC D (LO.subCTy D G s A)])
      (LO.subCTy (LO.ExtC D (LO.subCTy D G s A)) (LO.ExtC G A) (liftC D G A s) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) B))
      (LO.subCTy (LO.ExtC D (LO.subCTy D G s A)) D (LO.pPC D (LO.subCTy D G s A)) (LO.subCTy D G s B)) =
  trans (CTy[E])
   (LO.subCTy E (LO.ExtC G A) (liftC D G A s) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) B))
   (LO.subCTy E G (coC E (LO.ExtC G A) G (LO.pPC G A) (liftC D G A s)) B)
   (LO.subCTy E D (LO.pPC D (LO.subCTy D G s A)) (LO.subCTy D G s B))
   (sym (CTy[E]) (LO.subCTy E G (coC E (LO.ExtC G A) G (LO.pPC G A) (liftC D G A s)) B)
                 (LO.subCTy E (LO.ExtC G A) (liftC D G A s) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) B))
                 (subT-oC E (LO.ExtC G A) G B (LO.pPC G A) (liftC D G A s)))
   (trans (CTy[E])
      (LO.subCTy E G (coC E (LO.ExtC G A) G (LO.pPC G A) (liftC D G A s)) B)
      (LO.subCTy E G (coC E D G s (LO.pPC D (LO.subCTy D G s A))) B)
      (LO.subCTy E D (LO.pPC D (LO.subCTy D G s A)) (LO.subCTy D G s B))
      (ap (CSub[E, G]) (CTy[E]) (\ s' -> LO.subCTy E G s' B)
          (coC E (LO.ExtC G A) G (LO.pPC G A) (liftC D G A s)) (coC E D G s (LO.pPC D (LO.subCTy D G s A)))
          (p-liftC D G A s))
      (subT-oC E D G B s (LO.pPC D (LO.subCTy D G s A))))
  where { E : CCtx = LO.ExtC D (LO.subCTy D G s A) ; } ;

 p-sec-TC (G : CCtx) (A B : CTy[G]) (a : CEl[G, A])
  : Id (CTy[G]) (LO.subCTy G (LO.ExtC G A) (secC G A a) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) B)) B =
  trans (CTy[G])
   (LO.subCTy G (LO.ExtC G A) (secC G A a) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) B))
   (LO.subCTy G G (coC G (LO.ExtC G A) G (LO.pPC G A) (secC G A a)) B)
   B
   (sym (CTy[G]) (LO.subCTy G G (coC G (LO.ExtC G A) G (LO.pPC G A) (secC G A a)) B)
                 (LO.subCTy G (LO.ExtC G A) (secC G A a) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) B))
                 (subT-oC G (LO.ExtC G A) G B (LO.pPC G A) (secC G A a)))
   (trans (CTy[G]) (LO.subCTy G G (coC G (LO.ExtC G A) G (LO.pPC G A) (secC G A a)) B) (LO.subCTy G G (cidC G) B) B
      (ap (CSub[G, G]) (CTy[G]) (\ s' -> LO.subCTy G G s' B)
          (coC G (LO.ExtC G A) G (LO.pPC G A) (secC G A a)) (cidC G) (p-secC G A a))
      (subT-idC G B)) ;

 ------------------------------------------------------------------
 -- the CwF

 CPCwF : CwF.CwF[l+] = new CwF.CwF[l := l+,
   Ctx      := CCtx,
   Sub      := \ D G -> CSub[D, G],
   isSetSub := EX.isSet-CSub,
   id       := cidC,
   o        := coC,
   o-idl    := \ D G s -> EX.csub-ext D G (coC D G G (cidC G) s) s (\ x X d -> refl ((s.sb x).nt X d)),
   o-idr    := \ D G s -> EX.csub-ext D G (coC D D G s (cidC D)) s (\ x X d -> refl ((s.sb x).nt X d)),
   o-assoc  := \ Q T D G s s' s'' -> EX.csub-ext Q G (coC Q T G (coC T D G s s') s'') (coC Q D G s (coC Q T D s' s''))
                 (\ x X d -> refl ((s.sb x).nt X ((s'.sb x).nt X ((s''.sb x).nt X d)))),
   nil      := nilC,
   eps      := epsC,
   eps-uniq := \ G s -> EX.csub-ext G nilC s (epsC G) (\ x X d -> isTop ((s.sb x).nt X d) tt),
   Ty       := \ G -> CTy[G],
   isSetTy  := EX.isSet-CTy,
   subT     := \ D G A s -> LO.subCTy D G s A,
   subT-id  := subT-idC,
   subT-o   := subT-oC,
   El       := \ G A -> CEl[G, A],
   isSetEl  := EX.isSet-CEl,
   subt     := subCEl,
   subt-id  := subt-idC,
   subt-o   := subt-oC,
   ext      := LO.ExtC,
   p        := LO.pPC,
   q        := qC,
   lift     := liftC,
   sec      := secC,
   lift-id  := lift-idC,
   lift-o   := lift-oC,
   p-lift   := p-liftC,
   p-sec    := p-secC,
   sec-o    := sec-oC,
   lift-p-sec-q := lift-p-sec-qC,
   q-lift   := \ D G A s ->
     cel-subst (LO.ExtC D (LO.subCTy D G s A))
       (LO.subCTy (LO.ExtC D (LO.subCTy D G s A)) (LO.ExtC G A) (liftC D G A s) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) A))
       (LO.subCTy (LO.ExtC D (LO.subCTy D G s A)) D (LO.pPC D (LO.subCTy D G s A)) (LO.subCTy D G s A))
       (p-lift-TC D G A A s)
       (\ x -> p-lift-P (D.ob x) (G.ob x) (A.ty x) (s.sb x))
       (subCEl (LO.ExtC D (LO.subCTy D G s A)) (LO.ExtC G A) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) A) (qC G A) (liftC D G A s))
       (qC D (LO.subCTy D G s A))
       (\ x -> qP-liftP (D.ob x) (G.ob x) (A.ty x) (s.sb x)),
   q-sec    := \ G A a ->
     cel-subst G (LO.subCTy G (LO.ExtC G A) (secC G A a) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) A)) A
       (p-sec-TC G A A a)
       (\ x -> p-sec-P (G.ob x) (A.ty x) (a.el x))
       (subCEl G (LO.ExtC G A) (LO.subCTy (LO.ExtC G A) G (LO.pPC G A) A) (qC G A) (secC G A a))
       a
       (\ x -> qP-secP (G.ob x) (A.ty x) (a.el x)) ] ;
} ;
