-- CTotSet5.seg (canonicity-c2; "D preserves h-sets", part 5): rho as an
-- element of R along sec q over D G . D A (CwFHed4's reflexivity).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST5 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module S4 = CTotSet4[a, vl, l].ST4[C, G, A] ;
 module S1 = S4.S1 ;
 module G1 = S1.G1 ;
 module P1 = S1.P1 ;
 module DP3 = CTotDProp3[a, vl, l].DP3[C, G, A] ;
 DG : G1.fibCwF-T.Ctx = DP3.DG ;
 DAT : G1.fibCwF-T.Ty DG = DP3.DAT ;
 Ext : G1.fibCwF-T.Ctx = G1.fibCwF-T.ext DG DAT ;
 SFT : G1.fibCwF-T.Ty Ext = G1.fibCwF-T.subT Ext DG DAT (G1.fibCwF-T.p DG DAT) ;
 K : G1.fibCwF-T.Ctx = G1.fibCwF-T.ext Ext SFT ;
 xq : G1.fibCwF-T.El Ext SFT = G1.fibCwF-T.q DG DAT ;
 module At (pS : G1.fibCwF-T.El S1.E1 (S1.PN1.isProp S1.E1 S1.IdA)) {
  module S2 = CTotSet2[a, vl, l].ST2[C, G, A].At[pS] ;
  R : G1.fibCwF-T.Ty K = G1.FT.GFibCwF[l].FC.subS K S2.DGd S2.DTd S1.phi2 ;
  RS : G1.fibCwF-T.Ty Ext = G1.fibCwF-T.subT Ext K R (G1.fibCwF-T.sec Ext SFT xq) ;
  rho : G1.fibCwF-T.El Ext RS = P1.mkPEl Ext RS.1 (\ X t -> S4.res X.1 X.2 t)
   (\ J I f t t' e -> S4.natAll J.1 I.1 f.1 J.2 I.2 f.2 t t'
     (P1.ntEq K S2.DGd S1.phi2 J I f ((G1.fibCwF-T.sec Ext SFT xq).nt I t) ((G1.fibCwF-T.sec Ext SFT xq).nt J t')
        (P1.ntEq Ext K (G1.fibCwF-T.sec Ext SFT xq) J I f t t' e))) ;
 } ;
} ;
