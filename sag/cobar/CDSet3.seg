-- CDSet3.seg (canonicity-c2; (d), T0 a set, part 3): the reassociations
-- s : T0 -> T2, (h, (v, r)) |-> ((h, v), r), and r : T2 -> T0 as natural
-- maps (naturality: a pair (y, tact along e) does not depend on e, by path
-- induction), r . s = id pointwise, so T0 is a set (CRetSet).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module Set3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module S2m = CDSet2[a].Set2[R, encK, pe, x, u, y] ;
 module S2 = S2m.S2 ;
 module S1 = S2.S1 ;
 Nl : C.Ctx = C.nil ;
 HXY : C.Ty Nl = S1.HXY ;
 Dv : C.Ctx = S1.Dv ;
 RP : C.Ty Dv = S2.RelProd u.2 ;
 T0 : C.Ty Nl = SS.Sig Nl HXY S2.Sol ;
 T2 : C.Ty Nl = S2m.T2 ;
 -- pairs (y, tact x y e r) do not depend on (y, e)
 SY (J : Ob) : U a+ = (y0 : V1.Ix (Dv.ob J)) * V1.Ix (RP.1.tob J y0) ;
 pairL (J I : Ob) (f : Hom J I) (x0 : V1.Ix (Dv.ob I)) (r : V1.Ix (RP.1.tob I x0))
   (y1 y2 : V1.Ix (Dv.ob J)) (e1 : Id (V1.Ix (Dv.ob J)) (Dv.act J I f x0) y1) (e2 : Id (V1.Ix (Dv.ob J)) (Dv.act J I f x0) y2)
   : Id (SY J) (y1, RP.1.tact J I f x0 y1 e1 r) (y2, RP.1.tact J I f x0 y2 e2 r) =
  idJ (V1.Ix (Dv.ob J)) (Dv.act J I f x0) (\ y3 e3 -> Id (SY J) (y3, RP.1.tact J I f x0 y3 e3 r) (y2, RP.1.tact J I f x0 y2 e2 r))
   (idJ (V1.Ix (Dv.ob J)) (Dv.act J I f x0) (\ y4 e4 -> Id (SY J) (Dv.act J I f x0, RP.1.tact J I f x0 (Dv.act J I f x0) (refl (Dv.act J I f x0)) r) (y4, RP.1.tact J I f x0 y4 e4 r))
      (refl (Dv.act J I f x0, RP.1.tact J I f x0 (Dv.act J I f x0) (refl (Dv.act J I f x0)) r)) y2 e2)
   y1 e1 ;
 -- from a point of Dv.RP (with nil point tt) to T2 and T0
 phi2 (J : Ob) : (o : Top) (h : V1.Ix (HXY.1.tob J o)) (v : V1.Ix (S1.Pm'.1.tob J (o, h))) -> V1.Ix (RP.1.tob J ((o, h), v)) -> V1.Ix (T2.1.tob J tt) =
  split { tt -> \ h v r -> ((h, v), r) } ;
 phi0 (J : Ob) : (o : Top) (h : V1.Ix (HXY.1.tob J o)) (v : V1.Ix (S1.Pm'.1.tob J (o, h))) -> V1.Ix (RP.1.tob J ((o, h), v)) -> V1.Ix (T0.1.tob J tt) =
  split { tt -> \ h v r -> (h, (v, r)) } ;
 phi2' (J : Ob) (p : SY J) : V1.Ix (T2.1.tob J tt) = phi2 J p.1.1.1 p.1.1.2 p.1.2 p.2 ;
 phi0' (J : Ob) (p : SY J) : V1.Ix (T0.1.tob J tt) = phi0 J p.1.1.1 p.1.1.2 p.1.2 p.2 ;
 -- the maps
 sf (K : Ob) : (o : Top) -> V1.Ix (T0.1.tob K o) -> V1.Ix (T2.1.tob K o) = split { tt -> \ t -> ((t.1, t.2.1), t.2.2) } ;
 rf (K : Ob) : (o : Top) -> V1.Ix (T2.1.tob K o) -> V1.Ix (T0.1.tob K o) = split { tt -> \ s -> (s.1.1, (s.1.2, s.2)) } ;
 rs (K : Ob) : (o : Top) (t : V1.Ix (T0.1.tob K o)) -> Id (V1.Ix (T0.1.tob K o)) (rf K o (sf K o t)) t = split { tt -> \ t -> refl t } ;
 -- naturality
 A2 : C.Ty Nl = S2m.A2 ;
 sNat (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o') (t : V1.Ix (T0.1.tob I o))
   -> Id (V1.Ix (T2.1.tob J o')) (T2.1.tact J I f o o' e (sf I o t)) (sf J o' (T0.1.tact J I f o o' e t)) = split {
  tt -> split { tt -> \ e t ->
   apH {SY J} {V1.Ix (T2.1.tob J tt)} (phi2' J)
    (pairL J I f ((tt, t.1), t.2.1) t.2.2
       (S2m.tau.nt J (tt, A2.1.tact J I f tt tt e (t.1, t.2.1)))
       ((tt, HXY.1.tact J I f tt tt e t.1), (T0.1.tact J I f tt tt e t).2.1)
       (L.ntEq S2m.GA2 Dv S2m.tau J I f (tt, (t.1, t.2.1)) (tt, A2.1.tact J I f tt tt e (t.1, t.2.1)) (L.pair-act Nl A2.1 J I f tt tt e (t.1, t.2.1)))
       (L.pair-act S1.Gh S1.Pm'.1 J I f (tt, t.1) (tt, HXY.1.tact J I f tt tt e t.1) (L.pair-act Nl HXY.1 J I f tt tt e t.1) t.2.1)) } } ;
 rNat (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o') (s : V1.Ix (T2.1.tob I o))
   -> Id (V1.Ix (T0.1.tob J o')) (T0.1.tact J I f o o' e (rf I o s)) (rf J o' (T2.1.tact J I f o o' e s)) = split {
  tt -> split { tt -> \ e s ->
   apH {SY J} {V1.Ix (T0.1.tob J tt)} (phi0' J)
    (pairL J I f ((tt, s.1.1), s.1.2) s.2
       ((tt, HXY.1.tact J I f tt tt e s.1.1), (T0.1.tact J I f tt tt e (s.1.1, (s.1.2, s.2))).2.1)
       (S2m.tau.nt J (tt, A2.1.tact J I f tt tt e s.1))
       (L.pair-act S1.Gh S1.Pm'.1 J I f (tt, s.1.1) (tt, HXY.1.tact J I f tt tt e s.1.1) (L.pair-act Nl HXY.1 J I f tt tt e s.1.1) s.1.2)
       (L.ntEq S2m.GA2 Dv S2m.tau J I f (tt, s.1) (tt, A2.1.tact J I f tt tt e s.1) (L.pair-act Nl A2.1 J I f tt tt e s.1))) } } ;
 sN : HO.NMap[Nl, T0.1, T2.1] = new HO.NMap[Nl, T0.1, T2.1, sf, sNat] ;
 rN : HO.NMap[Nl, T2.1, T0.1] = new HO.NMap[Nl, T2.1, T0.1, rf, rNat] ;
 -- T0 IS A SET
 setT0 : CQCtx[a].G3Of[T0].SetQiTy = CRetSet[a].RetSet[T0, T2, S2m.sT2, sN, rN, rs].setQi ;
} ;
