-- CTotRFib2.seg (canonicity-c2; SIMPLIFIED.md item 5): the "to" direction
-- of the currying.  A line in R B over a line of G at F Y in the total
-- site, ending at a given element, gives a line in B over the restricted
-- line at Y in the levelwise site, ending at the component of that
-- element: its value at (Z , h , i) is the component at the identity of
-- the value at (F h , i).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RFib2 (C : CIntCat[a].IC) {
 module RF = CTotRFib[a, l].RFib[C] ;
 module TR = RF.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U a = RN.Ob0 ;
 Ob1 : U a = RN.Ob1 ;

 module To (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (e : G1.GB.IPt) {
  module CT = RF.CT[G, B, e] ;
  module RT = CT.RT ;
  module RH = CT.RH ;
  module L9 = TR.L9[G, B] ;
  UG : P0.PCtx = CT.UG ;
  module EK1 = CT.EK1 ;
  module EK0 = CT.EK0 ;
  module FT1 = G1.GB.CLine[l].FT[G, RT.RB] ;
  module FT0 = G0.GB.CLine[l].FT[UG, B] ;
  Tot0 (Y : Ob0) : U l = CT.Tot0 Y ;
  Tot1 (X : Ob1) : U l = L9.Tot1 X ;

  module TS (Y : Ob0) (u : EK1.TS.EI (RN.o Y)) {
   z : EK1.TV.EI (RN.o Y) = EK1.TS.pr1 (RN.o Y) u ;
   x : W0.Ix (RH.F1.ob (RN.o Y)) = EK1.TV.pr1 (RN.o Y) z ;
   L1 : EK1.TL.EI (RN.o Y) = EK1.lineL (RN.o Y) u ;
   -- the values of the component line
   t (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.IvP Z) : Tot0 Z = L9.prI Z (EK1.lv (RN.o Y) u (RN.o Z) (TR.fn.onH Z Y h) i) ;
   tp (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.IvP Z) : Id (W0.Ix (UG.ob Z)) (P0.fstE UG B Z (t Z h i)) ((RH.rhoV Y x).1 Z h i) =
    apH {W0.Ix (RH.F1.ob (RN.o Y))} {W0.Ix (G.ob (RN.o Z))} (\ y -> y.1 (RN.o Z) (TR.fn.onH Z Y h) i) (FT1.lover (RN.o Y) L1) ;
   module TN (Vt W : Ob0) (g : RN.Hom0 Vt W) (f : RN.Hom0 W Y) (i : G0.GB.IvP W) {
    t0 : Tot1 (RN.o W) = EK1.lv (RN.o Y) u (RN.o W) (TR.fn.onH W Y f) i ;
    k2 : RN.Hom1 (RN.o Vt) (RN.o Y) = G1.GB.BC.oC (RN.o Vt) (RN.o W) (RN.o Y) (TR.fn.onH W Y f) (TR.fn.onH Vt W g) ;
    k3 : RN.Hom1 (RN.o Vt) (RN.o Y) = TR.fn.onH Vt Y (G0.GB.BC.oC Vt W Y f g) ;
    j' : G1.GB.IvP (RN.o Vt) = G1.GB.ivA (RN.o Vt) (RN.o W) (TR.fn.onH Vt W g) i ;
    q1 : Id (Tot1 (RN.o Vt)) (L9.E1.act (RN.o Vt) (RN.o W) (TR.fn.onH Vt W g) t0) (EK1.lv (RN.o Y) u (RN.o Vt) k2 j') =
     FT1.lnat (RN.o Y) L1 (RN.o Vt) (RN.o W) (TR.fn.onH Vt W g) (TR.fn.onH W Y f) i ;
    q2 : Id (Tot1 (RN.o Vt)) (EK1.lv (RN.o Y) u (RN.o Vt) k2 j') (EK1.lv (RN.o Y) u (RN.o Vt) k3 j') =
     ap (RN.Hom1 (RN.o Vt) (RN.o Y)) (Tot1 (RN.o Vt)) (\ k -> EK1.lv (RN.o Y) u (RN.o Vt) k j') k2 k3 (symH (TR.fn.onComp Vt W Y f g)) ;
    tn : Id (Tot0 Vt) (L9.E0.act Vt W g (t W f i)) (t Vt (G0.GB.BC.oC Vt W Y f g) (G0.GB.ivA Vt W g i)) =
     trans (Tot0 Vt) (L9.E0.act Vt W g (t W f i)) (L9.prI Vt (L9.E1.act (RN.o Vt) (RN.o W) (TR.fn.onH Vt W g) t0))
       (L9.prI Vt (EK1.lv (RN.o Y) u (RN.o Vt) k3 j'))
      L9.PA[Vt, W, g, t0].law
      (ap (Tot1 (RN.o Vt)) (Tot0 Vt) (L9.prI Vt) (L9.E1.act (RN.o Vt) (RN.o W) (TR.fn.onH Vt W g) t0) (EK1.lv (RN.o Y) u (RN.o Vt) k3 j')
         (trans (Tot1 (RN.o Vt)) (L9.E1.act (RN.o Vt) (RN.o W) (TR.fn.onH Vt W g) t0) (EK1.lv (RN.o Y) u (RN.o Vt) k2 j')
            (EK1.lv (RN.o Y) u (RN.o Vt) k3 j') q1 q2)) ;
   } ;
   line0 : W0.Ix (FT0.tobF Y (RH.rhoV Y x)) = FT0.lamA Y (RH.rhoV Y x) t tp (\ Vt W g f i -> TN[Vt, W, g, f, i].tn) ;
   L0 : EK0.TL.EI Y = EK0.TL.pr Y (RH.rhoV Y x) line0 ;
   -- its end at e is the component of the given element
   w : RT.T (RN.o Y) (CT.e1 Y x) = EK1.TV.pr2 (RN.o Y) z ;
   id0 : RN.Hom0 Y Y = G0.GB.BC.idC Y ;
   id1 : RN.Hom1 (RN.o Y) (RN.o Y) = G1.GB.BC.idC (RN.o Y) ;
   pe : G1.GB.IvP (RN.o Y) = G1.GB.ptH (RN.o Y) e ;
   ueq : Id (EK1.TV.EI (RN.o Y)) (FT1.Ev[e].evA.mE (RN.o Y) L1) z = (EK1.TS.pr2 (RN.o Y) u).2 ;
   s1 : Id (Tot0 Y) (EK0.endE Y (FT0.Ev[e].evA.mE Y L0)) (L9.prI Y (EK1.lv (RN.o Y) u (RN.o Y) (TR.fn.onH Y Y id0) pe)) =
    FT0.Ev[e].endB-E Y L0 ;
   s2 : Id (Tot1 (RN.o Y)) (EK1.lv (RN.o Y) u (RN.o Y) (TR.fn.onH Y Y id0) pe) (EK1.lv (RN.o Y) u (RN.o Y) id1 pe) =
    ap (RN.Hom1 (RN.o Y) (RN.o Y)) (Tot1 (RN.o Y)) (\ k -> EK1.lv (RN.o Y) u (RN.o Y) k pe) (TR.fn.onH Y Y id0) id1 (TR.fn.onId Y) ;
   s3 : Id (Tot1 (RN.o Y)) (EK1.lv (RN.o Y) u (RN.o Y) id1 pe) (EK1.endE (RN.o Y) z) =
    trans (Tot1 (RN.o Y)) (EK1.lv (RN.o Y) u (RN.o Y) id1 pe) (EK1.endE (RN.o Y) (FT1.Ev[e].evA.mE (RN.o Y) L1)) (EK1.endE (RN.o Y) z)
     (sym (Tot1 (RN.o Y)) (EK1.endE (RN.o Y) (FT1.Ev[e].evA.mE (RN.o Y) L1)) (EK1.lv (RN.o Y) u (RN.o Y) id1 pe) (FT1.Ev[e].endB-E (RN.o Y) L1))
     (ap (EK1.TV.EI (RN.o Y)) (Tot1 (RN.o Y)) (EK1.endE (RN.o Y)) (FT1.Ev[e].evA.mE (RN.o Y) L1) z ueq) ;
   s4 : Id (Tot0 Y) (L9.prI Y (EK1.endE (RN.o Y) z)) (EK0.endE Y (CT.kap Y z)) =
    CT.tfc (RN.o Y) (CT.e1 Y x) w.1 Y id1 id1 (refl id1) (CT.e1 Y x) (CT.e0 Y x) (symH (CT.e01 Y x))
     (symH (G.act-id (RN.o Y) (CT.e1 Y x))) (CT.eqk Y x) ;
   q : Id (Tot0 Y) (EK0.endE Y (FT0.Ev[e].evA.mE Y L0)) (EK0.endE Y (CT.kap Y z)) =
    trans (Tot0 Y) (EK0.endE Y (FT0.Ev[e].evA.mE Y L0)) (L9.prI Y (EK1.endE (RN.o Y) z)) (EK0.endE Y (CT.kap Y z))
     (trans (Tot0 Y) (EK0.endE Y (FT0.Ev[e].evA.mE Y L0)) (L9.prI Y (EK1.lv (RN.o Y) u (RN.o Y) (TR.fn.onH Y Y id0) pe)) (L9.prI Y (EK1.endE (RN.o Y) z))
        s1
        (ap (Tot1 (RN.o Y)) (Tot0 Y) (L9.prI Y) (EK1.lv (RN.o Y) u (RN.o Y) (TR.fn.onH Y Y id0) pe) (EK1.endE (RN.o Y) z)
           (trans (Tot1 (RN.o Y)) (EK1.lv (RN.o Y) u (RN.o Y) (TR.fn.onH Y Y id0) pe) (EK1.lv (RN.o Y) u (RN.o Y) id1 pe) (EK1.endE (RN.o Y) z) s2 s3)))
     s4 ;
   -- the element of the levelwise strict fibre
   toTS : EK0.TS.EI Y = EK0.mkTS Y (CT.kap Y z) L0 (refl (RH.rhoV Y x)) q ;
  } ;
  toTS (Y : Ob0) (u : EK1.TS.EI (RN.o Y)) : EK0.TS.EI Y = TS[Y, u].toTS ;

  -- toTS is natural along the levelwise maps
  module TSN (Z Y : Ob0) (h : RN.Hom0 Z Y) (u : EK1.TS.EI (RN.o Y)) {
   Fh : RN.Hom1 (RN.o Z) (RN.o Y) = TR.fn.onH Z Y h ;
   u' : EK1.TS.EI (RN.o Z) = EK1.TS.E.act (RN.o Z) (RN.o Y) Fh u ;
   module SY = TS[Y, u] ;
   module SZ = TS[Z, u'] ;
   lhs : EK0.TS.EI Z = SZ.toTS ;
   rhs : EK0.TS.EI Z = EK0.TS.E.act Z Y h SY.toTS ;
   pp : Id (EK0.TV.EI Z) (EK0.TS.pr1 Z lhs) (EK0.TS.pr1 Z rhs) =
    trans (EK0.TV.EI Z) (EK0.TS.pr1 Z lhs) (CT.kap Z SZ.z) (EK0.TS.pr1 Z rhs)
     (EK0.mkTS-pt Z (CT.kap Z SZ.z) SZ.L0 (refl (RH.rhoV Z SZ.x)) SZ.q)
     (trans (EK0.TV.EI Z) (CT.kap Z SZ.z) (EK0.TV.E.act Z Y h (CT.kap Y SY.z)) (EK0.TS.pr1 Z rhs)
        CT.KN[Z, Y, h, SY.z].nat
        (ap (EK0.TV.EI Y) (EK0.TV.EI Z) (\ v -> EK0.TV.E.act Z Y h v) (CT.kap Y SY.z) (EK0.TS.pr1 Y SY.toTS)
           (sym (EK0.TV.EI Y) (EK0.TS.pr1 Y SY.toTS) (CT.kap Y SY.z) (EK0.mkTS-pt Y (CT.kap Y SY.z) SY.L0 (refl (RH.rhoV Y SY.x)) SY.q)))) ;
   module QV (Vt : Ob0) (g : RN.Hom0 Vt Z) (j : G0.GB.IvP Vt) {
    Fg : RN.Hom1 (RN.o Vt) (RN.o Z) = TR.fn.onH Vt Z g ;
    k2 : RN.Hom1 (RN.o Vt) (RN.o Y) = G1.GB.BC.oC (RN.o Vt) (RN.o Z) (RN.o Y) Fh Fg ;
    k3 : RN.Hom1 (RN.o Vt) (RN.o Y) = TR.fn.onH Vt Y (G0.GB.BC.oC Vt Z Y h g) ;
    a1 : Id (Tot0 Vt) (EK0.lv Z lhs Vt g j) (L9.prI Vt (EK1.lv (RN.o Z) u' (RN.o Vt) Fg j)) =
     ap (EK0.TL.EI Z) (Tot0 Vt) (\ M -> FT0.lval Z M Vt g j) (EK0.lineL Z lhs) SZ.L0
      (EK0.mkTS-line Z (CT.kap Z SZ.z) SZ.L0 (refl (RH.rhoV Z SZ.x)) SZ.q) ;
    a2 : Id (Tot1 (RN.o Vt)) (EK1.lv (RN.o Z) u' (RN.o Vt) Fg j) (EK1.lv (RN.o Y) u (RN.o Vt) k2 j) =
     ap (EK1.TL.EI (RN.o Z)) (Tot1 (RN.o Vt)) (\ M -> FT1.lval (RN.o Z) M (RN.o Vt) Fg j) (EK1.lineL (RN.o Z) u')
      (EK1.TL.E.act (RN.o Z) (RN.o Y) Fh (EK1.lineL (RN.o Y) u)) (EK1.lineL-act (RN.o Z) (RN.o Y) Fh u) ;
    a3 : Id (Tot1 (RN.o Vt)) (EK1.lv (RN.o Y) u (RN.o Vt) k2 j) (EK1.lv (RN.o Y) u (RN.o Vt) k3 j) =
     ap (RN.Hom1 (RN.o Vt) (RN.o Y)) (Tot1 (RN.o Vt)) (\ k -> EK1.lv (RN.o Y) u (RN.o Vt) k j) k2 k3 (symH (TR.fn.onComp Vt Z Y h g)) ;
    b1 : Id (Tot0 Vt) (EK0.lv Z rhs Vt g j) (FT0.lval Y (EK0.lineL Y SY.toTS) Vt (G0.GB.BC.oC Vt Z Y h g) j) =
     ap (EK0.TL.EI Z) (Tot0 Vt) (\ M -> FT0.lval Z M Vt g j) (EK0.lineL Z rhs)
      (EK0.TL.E.act Z Y h (EK0.lineL Y SY.toTS)) (EK0.lineL-act Z Y h SY.toTS) ;
    b2 : Id (Tot0 Vt) (FT0.lval Y (EK0.lineL Y SY.toTS) Vt (G0.GB.BC.oC Vt Z Y h g) j) (L9.prI Vt (EK1.lv (RN.o Y) u (RN.o Vt) k3 j)) =
     ap (EK0.TL.EI Y) (Tot0 Vt) (\ M -> FT0.lval Y M Vt (G0.GB.BC.oC Vt Z Y h g) j) (EK0.lineL Y SY.toTS) SY.L0
      (EK0.mkTS-line Y (CT.kap Y SY.z) SY.L0 (refl (RH.rhoV Y SY.x)) SY.q) ;
    qv : Id (Tot0 Vt) (EK0.lv Z lhs Vt g j) (EK0.lv Z rhs Vt g j) =
     trans (Tot0 Vt) (EK0.lv Z lhs Vt g j) (L9.prI Vt (EK1.lv (RN.o Y) u (RN.o Vt) k3 j)) (EK0.lv Z rhs Vt g j)
      (trans (Tot0 Vt) (EK0.lv Z lhs Vt g j) (L9.prI Vt (EK1.lv (RN.o Z) u' (RN.o Vt) Fg j)) (L9.prI Vt (EK1.lv (RN.o Y) u (RN.o Vt) k3 j))
         a1
         (ap (Tot1 (RN.o Vt)) (Tot0 Vt) (L9.prI Vt) (EK1.lv (RN.o Z) u' (RN.o Vt) Fg j) (EK1.lv (RN.o Y) u (RN.o Vt) k3 j)
            (trans (Tot1 (RN.o Vt)) (EK1.lv (RN.o Z) u' (RN.o Vt) Fg j) (EK1.lv (RN.o Y) u (RN.o Vt) k2 j) (EK1.lv (RN.o Y) u (RN.o Vt) k3 j) a2 a3)))
      (sym (Tot0 Vt) (EK0.lv Z rhs Vt g j) (L9.prI Vt (EK1.lv (RN.o Y) u (RN.o Vt) k3 j))
         (trans (Tot0 Vt) (EK0.lv Z rhs Vt g j) (FT0.lval Y (EK0.lineL Y SY.toTS) Vt (G0.GB.BC.oC Vt Z Y h g) j)
            (L9.prI Vt (EK1.lv (RN.o Y) u (RN.o Vt) k3 j)) b1 b2)) ;
   } ;
   nat : Id (EK0.TS.EI Z) lhs rhs = EK0.ts-ext Z lhs rhs pp (\ Vt g j -> QV[Vt, g, j].qv) ;
  } ;
  -- toTS as a map of contexts, from U of the total-site context of fibre elements
  toS : P0.PSub[RS.rC EK1.TS.E, EK0.TS.E] =
   new P0.PSub[RS.rC EK1.TS.E, EK0.TS.E, toTS, \ J I h u -> TSN[J, I, h, u].nat] ;
 } ;
} ;
