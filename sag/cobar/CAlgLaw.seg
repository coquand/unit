-- CAlgLaw.seg (canonicity-45; SIMPLIFIED.md step 2b): a unary law of A_x
-- that holds at the classes of constants holds at every element.  For
-- F1, F2 : Fun Qt Qt with Id (app F1 (cls t)) (app F2 (cls t)) for every
-- term t, Law1 gives Id (app F1 q) (app F2 q) for every q : El nil Qt, by
-- c2's elimination into propositions (CwFQuotElimP.elimP, elimP-el): the
-- predicate P over nil.Qt is the Id of the two sides at the variable, its
-- propositionality is the set-ness of Qt (weakened, a parameter), and its
-- proof at the classes is the law at constants packaged over the constant
-- Tm (CConstLam.pack), read along incS composed with a section (c2's
-- IS.atCls).  The laws in several variables follow
-- by iterating Law1 one variable at a time (CAlgX).
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module FB = FibCwF[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module QP = CwFQuotElimP.QuotElimP[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf, CTruncAtBase[a].truncAt] ;
C : CwF.CwF[a++] = FB.fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module CF = CAlgFun[a] ;

module Law1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy)
 (setW : (a1 b1 : C.El (C.ext C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt) (OV.wkT C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt))
   -> C.El (C.ext C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt) (PU.isProp (C.ext C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt) (IJ.IdT (C.ext C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt) (OV.wkT C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt) a1 b1)))
 (F1 F2 : C.El C.nil (OV.Fun C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt))
 (lawC : (t : CRelPack[a].Rel[R, encK, x].Term)
   -> C.El C.nil (IJ.IdT C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt
        (OV.app C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt F1 (CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.clsG (CRelPack[a].Rel[R, encK, x].ct t)))
        (OV.app C.nil CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.Qt F2 (CClsEqC[a].ClsEqC[R, encK, x, pe].QQ.clsG (CRelPack[a].Rel[R, encK, x].ct t))))) {
 module CE = CClsEqC[a].ClsEqC[R, encK, x, pe] ;
 module RP = CE.RP ;
 module QQ = CE.QQ ;
 Nl : C.Ctx = C.nil ;
 Term : U a = RP.Term ;
 Tm : C.Ty Nl = RP.Tm ;
 Qt : C.Ty Nl = QQ.Qt ;
 Q : U a++ = C.El Nl Qt ;
 cls (t : Term) : Q = QQ.clsG (RP.ct t) ;
 G1 : C.Ctx = C.ext Nl Qt ;
 Qw : C.Ty G1 = OV.wkT Nl Qt Qt ;
 q0 : C.El G1 Qw = C.q Nl Qt ;
 -- the two sides at the variable
 side (F : C.El Nl (OV.Fun Nl Qt Qt)) : C.El G1 Qw = OV.app G1 Qw Qw (EQ.wkF Nl Qt Qt Qt F) q0 ;
 P : C.Ty G1 = IJ.IdT G1 Qw (side F1) (side F2) ;
 pPr : C.El G1 (PU.isProp G1 P) = setW (side F1) (side F2) ;
 -- P at a global element q is the Id of the two sides at q
 PA (q : Q) : Id (C.Ty Nl) (C.subT Nl G1 Qw (C.sec Nl Qt q)) Qt = CF.W.pst Nl Qt Qt q ;
 ovSide (F : C.El Nl (OV.Fun Nl Qt Qt)) (q : Q) : OV.Ov Nl G1 Qw (C.sec Nl Qt q) Qt (PA q) (side F) (OV.app Nl Qt Qt F q) =
  CF.Ov1[Qt, q].ovAp Qt Qt F q0 q (CF.Ov1[Qt, q].ovVar) ;
 Pat (q : Q) : Id (C.Ty Nl) (C.subT Nl G1 P (C.sec Nl Qt q)) (IJ.IdT Nl Qt (OV.app Nl Qt Qt F1 q) (OV.app Nl Qt Qt F2 q)) =
  OV.Id-ov Nl G1 Qw (side F1) (side F2) (C.sec Nl Qt q) Qt (PA q) (OV.app Nl Qt Qt F1 q) (OV.app Nl Qt Qt F2 q) (ovSide F1 q) (ovSide F2 q) ;
 -- the hypothesis at the classes, packaged over the constant Tm
 D : C.Ctx = C.ext Nl Tm ;
 incS : C.Sub D G1 = CF.W.exS D Nl Qt (C.p Nl Tm) QQ.cls ;
 PI : C.Ty D = C.subT D G1 P incS ;
 -- PI at the constant t is P at cls t
 PIat (t : Term) : Id (C.Ty Nl) (C.subT Nl D PI (C.sec Nl Tm (RP.ct t))) (IJ.IdT Nl Qt (OV.app Nl Qt Qt F1 (cls t)) (OV.app Nl Qt Qt F2 (cls t))) =
  transH (QP.IS[Nl, Tm, RP.r, RP.ct t].atCls P) (Pat (cls t)) ;
 fam (t : Term) : C.El Nl (C.subT Nl D PI (C.sec Nl Tm (RP.ct t))) =
  OV.trE Nl (IJ.IdT Nl Qt (OV.app Nl Qt Qt F1 (cls t)) (OV.app Nl Qt Qt F2 (cls t))) (C.subT Nl D PI (C.sec Nl Tm (RP.ct t))) (symH (PIat t)) (lawC t) ;
 h : C.El D PI = RP.LM.L.pack L.nilP PI.1 fam ;
 -- the law at every element
 lawAll (q : Q) : C.El Nl (IJ.IdT Nl Qt (OV.app Nl Qt Qt F1 q) (OV.app Nl Qt Qt F2 q)) =
  OV.trE Nl (C.subT Nl G1 P (C.sec Nl Qt q)) (IJ.IdT Nl Qt (OV.app Nl Qt Qt F1 q) (OV.app Nl Qt Qt F2 q)) (Pat q) (QP.elimP-el Nl Tm RP.r P pPr h q) ;
} ;
