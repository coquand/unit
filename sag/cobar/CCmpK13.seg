-- CCmpK13.seg (canonicity-c2; (K) for cmpI, part 13): over GS, the first
-- component of cmpI (z_t) equals g_1: z_t (Phi_1 cx) = cls t_1 (CCmpK11
-- moved along tau), cls t_1 = a_1 = ev g_1 (the quotient fibre), then ev is
-- injective (CCmpK10).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module K13 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K12m = CCmpK12[a].K12[R, encK, pe, y] ;
 module K11m = CCmpK11[a].K11[R, encK, pe, y] ;
 module K10m = CCmpK10[a].K10[R, encK, pe, y] ;
 module K1m = K12m.K1m ;
 module QS = K12m.QS ;
 module E1m = K10m.E1m ;
 module G = K11m.G1 ;
 Nl : C.Ctx = C.nil ;
 GS : C.Ctx = K12m.GS ;
 QY : C.Ty Nl = K12m.QY ;
 s0 : C.Sub GS Nl = K12m.s0 ;
 QS0 : C.Ty GS = C.subT GS Nl QY s0 ;
 module MB = K12m.Mv[QY, K1m.DP, OV.wkT Nl K1m.TP QY, C.p Nl K1m.TP, refl (OV.wkT Nl K1m.TP QY), K12m.tau, \ K w -> refl (s0.nt K w)] ;
 B1 : C.El GS (IJ.IdT GS QS0 (MB.el K1m.Fam[QY, G.c1].el) (MB.el K1m.Fam[QY, G.c2].el)) = MB.id K1m.Fam[QY, G.c1].el K1m.Fam[QY, G.c2].el K11m.b1 ;
 module ME = K12m.Mv[QY, QS.E, QS.T0, C.o QS.E QS.G1 Nl (C.p Nl QS.Qt) QS.pE, symH (C.subT-o QS.E QS.G1 Nl QS.Qt (C.p Nl QS.Qt) QS.pE), K12m.pi1, \ K w -> refl (s0.nt K w)] ;
 B2 : C.El GS (IJ.IdT GS QS0 (ME.el QS.clsE) (ME.el QS.qE)) = ME.idS QS.clsE QS.qE K12m.eS1 ;
 QQK (K : Ob) (w : V1.Ix (GS.ob K)) : U a+ = V1.Ix (QS0.1.tob K w) ;
 ctv (K : Ob) (o : Top) (t : K12m.K1m.TmY) : V1.Ix (QS.Qt.1.tob K o) = QS.QQ.cls.eob K (o, (QS.AX.RP.ct t).eob K o) ;
 rL1 (K : Ob) (w : V1.Ix (GS.ob K)) : Id (QQK K w) ((MB.el K1m.Fam[QY, G.c2].el).eob K w) ((G.c2 w.1.2.1 w.2.1).eob K w.1.1.1) =
  transH (CAppRd[a].trE-rd GS (C.subT GS K1m.DP (OV.wkT Nl K1m.TP QY) K12m.tau) QS0 MB.P (C.subt GS K1m.DP (OV.wkT Nl K1m.TP QY) (K1m.Fam[QY, G.c2].el) K12m.tau) K w)
   (CAppRd[a].same-rd GS (C.subT GS K1m.DP (OV.wkT Nl K1m.TP QY) K12m.tau) QS0 MB.P K w (refl (QS0.1.tob K w)) ((K1m.Fam[QY, G.c2].el).eob K (K12m.tauN K w))) ;
 rL2 (K : Ob) (o : Top) (t : K12m.K1m.TmY) : Id (V1.Ix (QS.Qt.1.tob K o)) ((QS.AX.cls t).eob K o) (ctv K o t) =
  transH (CAppRd[a].trE-rd Nl (C.subT Nl QS.D1 (OV.wkT Nl QS.Tm QS.Qt) (C.sec Nl QS.Tm (QS.AX.RP.ct t))) QS.Qt (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl QS.Tm QS.Qt (QS.AX.RP.ct t))
                (C.subt Nl QS.D1 (OV.wkT Nl QS.Tm QS.Qt) QS.QQ.cls (C.sec Nl QS.Tm (QS.AX.RP.ct t))) K o)
   (CAppRd[a].same-rd Nl (C.subT Nl QS.D1 (OV.wkT Nl QS.Tm QS.Qt) (C.sec Nl QS.Tm (QS.AX.RP.ct t))) QS.Qt (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl QS.Tm QS.Qt (QS.AX.RP.ct t)) K o
      (refl (QS.Qt.1.tob K o)) (ctv K o t)) ;
 rR (K : Ob) (w : V1.Ix (GS.ob K)) : Id (QQK K w) ((ME.el QS.clsE).eob K w) (ctv K w.1.1.1 w.1.2.1) =
  transH (CAppRd[a].trE-rd GS (C.subT GS QS.E QS.T0 K12m.pi1) QS0 ME.P (C.subt GS QS.E QS.T0 QS.clsE K12m.pi1) K w)
   (transH (CAppRd[a].same-rd GS (C.subT GS QS.E QS.T0 K12m.pi1) QS0 ME.P K w (refl (QS0.1.tob K w)) (QS.clsE.eob K (K12m.pi1N K w)))
     (transH (CAppRd[a].trE-rd QS.E (C.subT QS.E QS.D1 (OV.wkT Nl QS.Tm QS.Qt) QS.sg) QS.T0 QS.PC (C.subt QS.E QS.D1 (OV.wkT Nl QS.Tm QS.Qt) QS.QQ.cls QS.sg) K (K12m.pi1N K w))
        (CAppRd[a].same-rd QS.E (C.subT QS.E QS.D1 (OV.wkT Nl QS.Tm QS.Qt) QS.sg) QS.T0 QS.PC K (K12m.pi1N K w) (refl (QS.T0.1.tob K (K12m.pi1N K w))) (QS.QQ.cls.eob K (QS.sgN K (K12m.pi1N K w)))))) ;
 rC1 (K : Ob) (w : V1.Ix (GS.ob K)) : Id (QQK K w) ((MB.el K1m.Fam[QY, G.c2].el).eob K w) ((ME.el QS.clsE).eob K w) =
  transH (rL1 K w) (transH (rL2 K w.1.1.1 w.1.2.1) (symH (rR K w))) ;
 B12 : C.El GS (IJ.IdT GS QS0 (MB.el K1m.Fam[QY, G.c1].el) (ME.el QS.qE)) =
  PT.transM GS QS0 (MB.el K1m.Fam[QY, G.c1].el) (ME.el QS.clsE) (ME.el QS.qE)
   (CCmpU14[a].rwId GS QS0 (MB.el K1m.Fam[QY, G.c1].el) (MB.el K1m.Fam[QY, G.c1].el) (MB.el K1m.Fam[QY, G.c2].el) (ME.el QS.clsE)
      (\ K w -> refl ((MB.el K1m.Fam[QY, G.c1].el).eob K w)) rC1 B1)
   B2 ;
} ;
