-- CTotElim5.seg (canonicity-c2; SIMPLIFIED.md, (c)): THE ELIMINATOR OF
-- Tr INTO D-MODAL PROPOSITIONS. P over G.Tr A a proposition with a
-- natural map (D P)[tau] -> P, and b an element of P along inc over G.A:
-- then P has a section over G.Tr A.
-- Levelwise at (g , t): the counit eps t : Tr0 (U A) g, compared into the
-- truncation over U (G.Tr A) (CTotElim1), eliminated into U P by bb
-- (CTotElim4: transport of b from inc a to t); then KL (CTotKL2).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module EL5 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G))
  (P : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotR[a, vl, l].TotR[C].G1.fibCwF-T.ext (CTotCat[a, vl, l].TotOf[C].toP G) (CTotTr[a, vl, l].TotTr[C].Tr[CTotCat[a, vl, l].TotOf[C].toP G, A].Tr)))
  (b : CTotR[a, vl, l].TotR[C].P1.PEl[CTotElim2[a, vl, l].EL2[C, G, A].GA,
         CTotR[a, vl, l].TotR[C].P1.subTy (CTotElim2[a, vl, l].EL2[C, G, A].GA) (CTotElim2[a, vl, l].EL2[C, G, A].GT) P.1 (CTotElim2[a, vl, l].EL2[C, G, A].incS)]) {
 module E4 = CTotElim4[a, vl, l].EL4[C, G, A, P, b] ;
 module E3 = E4.E3 ;
 module E2 = E3.E2 ;
 module TR = E3.TR ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 module RN = TR.RN ;
 module RR = CTotRr[a, vl, l].Rr[C, G, E3.TT.T0.1] ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module K2 = CTotKL2[a, vl, l].KL2[C, TC.ofP E2.GT, P] ;
 Dl : P0.PCtx = E3.Dl ;
 UPd : P0.PTy[Dl] = E3.UPd.1 ;
 Tq : P0.PTy[Dl] = E3.Tp.1 ;
 module At (pP : E3.G1.fibCwF-T.El E2.GT (E3.PN1.isProp E2.GT P)) (rP : K2.K.HO.NMap[K2.K.GP, K2.K.Bt, P.1]) {
  module BBm = E4.BB[pP] ;
  el' : P0.PEl[P0.extP Dl Tq, E3.B.1] = BBm.EM.elim BBm.bb ;
  cv (Y : RN.Ob0) (x : W0.Ix (Dl.ob Y)) : W0.Ix (Tq.tob Y x) = E3.CM.cmp.nfun Y x (RR.cuN.nfun Y x.1 x.2) ;
  eob (Y : RN.Ob0) (x : W0.Ix (Dl.ob Y)) : W0.Ix (UPd.tob Y x) = el'.eob Y (x, cv Y x) ;
  module NA (J I : RN.Ob0) (f : RN.Hom0 J I) (x : W0.Ix (Dl.ob I)) {
   y : W0.Ix (Dl.ob J) = Dl.act J I f x ;
   epi : Id (W0.Ix (E3.TT.UG.ob J)) (E3.TT.UG.act J I f x.1) y.1 = P0.ntEq Dl E3.TT.UG E3.pi J I f x y (refl y) ;
   ct : Id (W0.Ix (RR.URB.tob J y.1)) (RR.URB.tact J I f x.1 y.1 epi x.2) y.2 =
    P1.tact-irr E2.GP E2.Tr.1 (RN.o J) (RN.o I) (TR.fn.onH J I f) x.1 y.1 epi (refl y.1) x.2 ;
   cc : Id (W0.Ix (Tq.tob J y)) (Tq.tact J I f x y (refl y) (cv I x)) (cv J y) =
    transH (E3.CM.cmp.nnat J I f x y (refl y) (RR.cuN.nfun I x.1 x.2))
      (apH {W0.Ix (E3.TT.T0.1.tob J y.1)} {W0.Ix (Tq.tob J y)} (E3.CM.cmp.nfun J y)
        (transH (RR.cuN.nnat J I f x.1 y.1 epi x.2)
           (apH {W0.Ix (RR.URB.tob J y.1)} {W0.Ix (E3.TT.T0.1.tob J y.1)} (RR.cuN.nfun J y.1) ct))) ;
   e2 : Id (W0.Ix ((P0.extP Dl Tq).ob J)) ((P0.extP Dl Tq).act J I f (x, cv I x)) (y, cv J y) =
    apH {W0.Ix (Tq.tob J y)} {W0.Ix ((P0.extP Dl Tq).ob J)} (\ z -> (y, z)) cc ;
   law : Id (W0.Ix (UPd.tob J y)) (UPd.tact J I f x y (refl y) (eob I x)) (eob J y) =
    transH (P0.tact-irr Dl UPd J I f x y (refl y)
              (P0.ntEq (P0.extP Dl Tq) Dl (P0.pP Dl Tq) J I f (x, cv I x) (y, cv J y) e2) (eob I x))
      (el'.enat J I f (x, cv I x) (y, cv J y) e2) ;
  } ;
  e : P0.PEl[Dl, UPd] = P0.mkPEl Dl UPd eob (\ J I f x y2 e2 ->
   idJ (W0.Ix (Dl.ob J)) (Dl.act J I f x) (\ y3 e3 -> Id (W0.Ix (UPd.tob J y3)) (UPd.tact J I f x y3 e3 (eob I x)) (eob J y3))
     (NA[J, I, f, x].law) y2 e2) ;
  -- (c)
  elim : P1.PEl[E2.GT, P.1] = K2.At[rP, E3.At[pP].pU, e].sec ;
 } ;
} ;
