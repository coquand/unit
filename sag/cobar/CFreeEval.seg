-- CFreeEval.seg (canonicity-45; SIMPLIFIED.md step 6): evaluation of the
-- free algebra on two generators in a presented algebra A_x, closed.
--   EV[t].ev   for a term t of F2: the binary operation (q1, q2) |-> t(q1, q2)
--              on A_x, elim2 at (s1, s2) |-> cls (t[s1, s2]); it respects the
--              relation by CSubCong (substitution respects derivations in
--              the substituted terms) through CAlgX.Resp
--   E          A_F2 -> Fun A_x (Fun A_x A_x), elim1 at t |-> EV[t].ev; its
--              relation-respect: two binary functions agreeing at classes
--              are equal (ext2, a module parameter in the shape agreed with
--              c2) at the betas and CSubst.proof-sb
--   Ebeta      E (cls t) = EV[t].ev
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module EvalOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (elim1 : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Ty)
 (elim1-beta : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Beta (elim1 x))
 (setQ : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].SetQ)
 (elim2 : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Ty)
 (elim2-beta : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Beta (elim2 x))
 (setQi : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].SetQiTy)
 (x : SX.Over[R].Presentation)
 (ext2 : (B : C.Ty C.nil) (sB : CQCtx[a].G3Of[B].SetQiTy)
    (f g : C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt B)))
    (h : (t u : CAlgX[a].AlgX[R, encK, x, pe].Term)
         -> C.El C.nil (IJ.IdT C.nil B (CAlgX[a].AlgX[R, encK, x, pe].ap2 B f (CAlgX[a].AlgX[R, encK, x, pe].cls t) (CAlgX[a].AlgX[R, encK, x, pe].cls u))
                                       (CAlgX[a].AlgX[R, encK, x, pe].ap2 B g (CAlgX[a].AlgX[R, encK, x, pe].cls t) (CAlgX[a].AlgX[R, encK, x, pe].cls u))))
    -> C.El C.nil (IJ.IdT C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt B)) f g)) {
 module FR = CSubst[a].Free[R] ;
 F2 : SX.Over[R].Presentation = FR.F2 ;
 module AX = CAlgX[a].AlgX[R, encK, x, pe] ;
 module A2 = CAlgX[a].AlgX[R, encK, F2, pe] ;
 module CG = CSubCong[a].Cong[R, suc (suc zero), x] ;
 module VL = CSubCong[a].Val[R, x] ;
 Nl : C.Ctx = C.nil ;
 Qt : C.Ty Nl = AX.Qt ;
 FQ : C.Ty Nl = OV.Fun Nl Qt Qt ;
 BF : C.Ty Nl = OV.Fun Nl Qt FQ ;
 tr (q1 q2 q3 : AX.Q) (e : C.El Nl (AX.IdQ q1 q2)) (e' : C.El Nl (AX.IdQ q2 q3)) : C.El Nl (AX.IdQ q1 q3) = PT.transM Nl Qt q1 q2 q3 e e' ;
 sy (q1 q2 : AX.Q) (e : C.El Nl (AX.IdQ q1 q2)) : C.El Nl (AX.IdQ q2 q1) = PT.symM Nl Qt q1 q2 e ;
 -- the binary operation of a term of F2
 module EV (t : A2.Term) {
  op (s1 s2 : AX.Term) : AX.Term = CG.sb (VL.val2 s1 s2) t ;
  module RS = AX.Resp[op, \ s1 s1' s2 s2' d e -> CG.cong (VL.val2 s1 s2) (VL.val2 s1' s2') (VL.pv2 s1 s1' s2 s2' d e) t, setQ x] ;
  ev : C.El Nl BF = elim2 x Qt (setQi x) RS.f RS.rs1 RS.rs2 ;
  beta (s1 s2 : AX.Term) : C.El Nl (AX.IdQ (AX.ap2 Qt ev (AX.cls s1) (AX.cls s2)) (AX.cls (op s1 s2))) =
   elim2-beta x Qt (setQi x) RS.f RS.rs1 RS.rs2 s1 s2 ;
 } ;
 -- set-ness of the function types
 sFQ : CQCtx[a].G3Of[FQ].SetQiTy = CwFFunSetB[a].FunSetQ[Qt, Qt, setQi x].setQi ;
 module FB = CwFFunSetB[a].FunSetQ[Qt, FQ, sFQ] ;
 sBF : CQCtx[a].G3Of[BF].SetQiTy = FB.setQi ;
 setBF (f g : C.El Nl BF) : C.El Nl (PU.isProp Nl (IJ.IdT Nl BF f g)) = FB.S.At[Nl, C.id Nl, BF, C.subT-id Nl BF, f, g].law ;
 -- related terms of F2 give equal operations
 module EQ (t t' : A2.Term) (d : A2.Dx.Proof t t') {
  module SB (s1 s2 : AX.Term) {
   module S = CSubst[a].SubOf[R, F2, x, VL.val2 s1 s2, \ p m -> absurd (AX.Dx.Proof (CSubst[a].SE[R].subE (SX.Fin F2.1) (SX.Fin x.1) (VL.val2 s1 s2) p) AX.Dx.zeroE) m] ;
   law : C.El Nl (AX.IdQ (AX.ap2 Qt EV[t].ev (AX.cls s1) (AX.cls s2)) (AX.ap2 Qt EV[t'].ev (AX.cls s1) (AX.cls s2))) =
    tr (AX.ap2 Qt EV[t].ev (AX.cls s1) (AX.cls s2)) (AX.cls (EV[t].op s1 s2)) (AX.ap2 Qt EV[t'].ev (AX.cls s1) (AX.cls s2)) (EV[t].beta s1 s2)
     (tr (AX.cls (EV[t].op s1 s2)) (AX.cls (EV[t'].op s1 s2)) (AX.ap2 Qt EV[t'].ev (AX.cls s1) (AX.cls s2))
        (AX.clsEq (EV[t].op s1 s2) (EV[t'].op s1 s2) (S.proof-sb t t' d))
        (sy (AX.ap2 Qt EV[t'].ev (AX.cls s1) (AX.cls s2)) (AX.cls (EV[t'].op s1 s2)) (EV[t'].beta s1 s2))) ;
  } ;
  evEq : C.El Nl (IJ.IdT Nl BF EV[t].ev EV[t'].ev) = ext2 Qt (setQi x) EV[t].ev EV[t'].ev (\ s1 s2 -> SB[s1, s2].law) ;
 } ;
 rsE (t t' : A2.Term) (w : C.El Nl (A2.RelC t t')) : C.El Nl (IJ.IdT Nl BF EV[t].ev EV[t'].ev) =
  CRelResp[a].PackAp[R, encK, F2, t, t', IJ.IdT Nl BF EV[t].ev EV[t'].ev, setBF EV[t].ev EV[t'].ev, \ d -> EQ[t, t', d].evEq].atRel w ;
 E : C.El Nl (OV.Fun Nl A2.Qt BF) = elim1 F2 BF sBF (\ t -> EV[t].ev) rsE ;
 Ebeta (t : A2.Term) : C.El Nl (IJ.IdT Nl BF (OV.app Nl A2.Qt BF E (A2.cls t)) EV[t].ev) = elim1-beta F2 BF sBF (\ t2 -> EV[t2].ev) rsE t ;
} ;
