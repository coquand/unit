-- CRelPack.seg (canonicity-45; SIMPLIFIED.md step 2b): the inputs of the
-- Voevodsky quotient (CwFQuot.Quot.Q) for the presented algebra A_x, over
-- the terminal context of the fibrant base CwF at level a+:
--   Tm            the constant type Delta Term_x (CConstLam at the code of
--                 Term_x lifted to level a+)
--   r             the relation Term_x -> Term_x -> PropU, packaging for
--                 constants t, u the closed code of the truncation of
--                 Proof_x t u (CRelCode) with its propositionality
--                 (PropOf, from CClosedProp's contractibility)
--   r-beta        app (app r (ct t)) (ct u) = mkProp (code t u) (prop t u)
--   RelT b b'     Quot's Rel for this r; reflR b : RelT b b, from the
--                 reflexivity derivation at the constant value of b (every
--                 element of Delta Term over the terminal context is a
--                 constant: CConstLam.constOf)
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module GS = PB.GPre[a].PS ;
module L = PB.GPre[a+].PS ;
module FU = FibUniv[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module EN1 = Encode[a, a+] ;
module FB = FibCwF[a, a+] ;
module FID = FibId[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module SG = CwFSing.Sing[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FB.fibCwF ;

------------------------------------------------------------------
-- a type whose weakening over itself is contractible is a proposition
-- (PU.isProp: Pi (x y : A) Id x y), through the centre of contraction
module PropOf (G : C.Ctx) (A : C.Ty G) (k : C.El (C.ext G A) (EQ.isContr (C.ext G A) (OV.wkT G A A))) {
 GA : C.Ctx = C.ext G A ;
 W : C.Ty GA = OV.wkT G A A ;
 H : C.Ctx = C.ext GA W ;
 X : C.Ty H = OV.wkT GA W W ;
 k' : C.El H (C.subT H GA (EQ.isContr GA W) (C.p GA W)) = C.subt H GA (EQ.isContr GA W) k (C.p GA W) ;
 k2 : C.El H (EQ.isContr H X) =
  OV.trE H (C.subT H GA (EQ.isContr GA W) (C.p GA W)) (EQ.isContr H X) (EQ.isContr-ov H GA W (C.p GA W) X (refl X)) k' ;
 x1 : C.El H X = OV.wkE GA W W (C.q G A) ;
 x2 : C.El H X = C.q GA W ;
 c : C.El H X = SG.cenOf H X k2 ;
 e : C.El H (EQ.Id2 G A) = PT.transM H X x1 c x2 (PT.symM H X c x1 (SG.ctrAt H X k2 x1)) (SG.ctrAt H X k2 x2) ;
 res : C.El G (PU.isProp G A) = OV.lam G A (FB.fibPi.Pi GA W (EQ.Id2 G A)) (OV.lam GA W (EQ.Id2 G A) e) ;
} ;

------------------------------------------------------------------
-- the relation of the presented algebra A_x
module Rel (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) {
 module RC = CRelCode[a].RelCode[R, encK, x] ;
 module Dx = SX.Over[R].Der[x] ;
 Term : U a = Dx.Term ;
 termV : W0.V = CExprCode[a].ExprCode[R, encK, x.1].exprV ;
 -- the code of Term_x at level a+ (its members are those of termV, on the nose)
 TmV : V1.V = EN1.codeOf (W0.Ix termV) (EN1.encIx0 termV) ;
 module LM = CConstLam[a, a+].LamC[CCyl[a].PosCyl.posCyl, TmV] ;
 Nl : C.Ctx = C.nil ;
 Tm : C.Ty Nl = LM.TE Nl ;
 ct (t : Term) : C.El Nl Tm = LM.cE Nl t ;
 Pr : C.Ty Nl = PU.PropU Nl ;
 PA : C.Ty Nl = OV.Fun Nl Tm Pr ;
 -- the closed code of the truncated proofs of t ~ u, and its propositionality
 code (t u : Term) : C.El Nl (FU.Cod Nl) = RC.PT[t, u].code L.nilP ;
 Dc (t u : Term) : C.Ty Nl = FU.Dec Nl (code t u) ;
 prop (t u : Term) : C.El Nl (PU.isProp Nl (Dc t u)) = PropOf[Nl, Dc t u, RC.PT[t, u].Prop[L.nilP].M.contr].res ;
 pw (t u : Term) : C.El Nl Pr = PU.mkProp Nl (code t u) (prop t u) ;
 -- the relation, as an element of Tm -> Tm -> PropU
 r : C.El Nl (OV.Fun Nl Tm PA) = LM.lamC Nl PA (\ t -> LM.lamC Nl Pr (\ u -> pw t u)) ;
 rAt (b : C.El Nl Tm) : C.El Nl PA = OV.app Nl Tm PA r b ;
 relP (b b' : C.El Nl Tm) : C.El Nl Pr = OV.app Nl Tm Pr (rAt b) b' ;
 RelT (b b' : C.El Nl Tm) : C.Ty Nl = PU.DecP Nl (relP b b') ;
 -- beta at constants
 r-beta1 (t : Term) : Id (C.El Nl PA) (rAt (ct t)) (LM.lamC Nl Pr (\ u -> pw t u)) = LM.lamC-beta Nl PA (\ t2 -> LM.lamC Nl Pr (\ u -> pw t2 u)) t ;
 r-beta (t u : Term) : Id (C.El Nl Pr) (relP (ct t) (ct u)) (pw t u) =
  transH (apH {C.El Nl PA} {C.El Nl Pr} (\ g -> OV.app Nl Tm Pr g (ct u)) (r-beta1 t)) (LM.lamC-beta Nl Pr (\ u2 -> pw t u2) u) ;
 -- the code of mkProp is its code (the first projection of the pair)
 pwY (t u : Term) : C.El Nl (C.subT Nl (C.ext Nl (FU.Cod Nl)) (PU.PropFam Nl) (C.sec Nl (FU.Cod Nl) (code t u))) =
  OV.trE Nl (PU.isProp Nl (Dc t u)) (C.subT Nl (C.ext Nl (FU.Cod Nl)) (PU.PropFam Nl) (C.sec Nl (FU.Cod Nl) (code t u)))
   (sym (C.Ty Nl) (C.subT Nl (C.ext Nl (FU.Cod Nl)) (PU.PropFam Nl) (C.sec Nl (FU.Cod Nl) (code t u))) (PU.isProp Nl (Dc t u)) (PU.PropFam-pt Nl (code t u))) (prop t u) ;
 codeOf-pw (t u : Term) : Id (C.El Nl (FU.Cod Nl)) (PU.codeOf Nl (pw t u)) (code t u) =
  IN.fst-pr Nl (FU.Cod Nl) (PU.PropFam Nl) (code t u) (pwY t u) ;
 -- RelT at two constants is the decoding of the code
 relT-ct (t u : Term) : Id (C.Ty Nl) (RelT (ct t) (ct u)) (Dc t u) =
  transH (apH {C.El Nl Pr} {C.Ty Nl} (\ w -> PU.DecP Nl w) (r-beta t u)) (apH {C.El Nl (FU.Cod Nl)} {C.Ty Nl} (\ c -> FU.Dec Nl c) (codeOf-pw t u)) ;

 -- the unit of the truncation at the reflexivity derivation, as a global
 -- element of the truncation type over the terminal context (level a)
 module Unit (t : Term) {
  module T = RC.PT[t, t].T ;
  rp : Dx.Proof t t = Dx.reflP t ;
  T0 : GS.PTy[GS.nilP] = T.Tr0.1 ;
  ob (I : Ob) (z : W0.Ix (GS.nilP.ob I)) : W0.Ix (T0.tob I z) = T.incV I (z, rp) ;
  nat (J I : Ob) (f : Hom J I) (z : W0.Ix (GS.nilP.ob I)) (z' : W0.Ix (GS.nilP.ob J)) (e : Id (W0.Ix (GS.nilP.ob J)) (GS.nilP.act J I f z) z')
   : Id (W0.Ix (T0.tob J z')) (T0.tact J I f z z' e (ob I z)) (ob J z') =
   transH (apH {Id (W0.Ix (GS.nilP.ob J)) (GS.nilP.act J I f z) z'} {W0.Ix (T0.tob J z')} (\ q -> T0.tact J I f z z' q (ob I z))
             (W0.isSetIx (GS.nilP.ob J) (GS.nilP.act J I f z) z' e
                (GS.ntEq T.GA GS.nilP (GS.pP GS.nilP RC.PT[t, t].P0.1) J I f (z, rp) (z', rp) (apH {W0.Ix (GS.nilP.ob J)} {W0.Ix (T.GA.ob J)} (\ w -> (w, rp)) e))))
    (T.incN J I f (z, rp) (z', rp) (apH {W0.Ix (GS.nilP.ob J)} {W0.Ix (T.GA.ob J)} (\ w -> (w, rp)) e)) ;
  el : GS.PEl[GS.nilP, T0] = GS.mkPEl GS.nilP T0 ob nat ;
 } ;
 -- reflexivity at a constant, then at every element
 reflR0 (t : Term) : C.El Nl (RelT (ct t) (ct t)) =
  OV.trE Nl (Dc t t) (RelT (ct t) (ct t)) (symH (relT-ct t t)) (CClosedCode[a].Closed[RC.PT[t, t].T.Tr0.1, RC.PT[t, t].T.Tr0.2].elUp L.nilP Unit[t].el) ;
 reflR (b : C.El Nl Tm) : C.El Nl (RelT b b) =
  subst (C.El Nl Tm) (\ b2 -> C.El Nl (RelT b2 b2)) (ct (LM.valOf b)) b (symH (LM.constOf b)) (reflR0 (LM.valOf b)) ;
} ;
