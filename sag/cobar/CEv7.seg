-- CEv7.seg (canonicity-c2; HomT(F1, y) ~ Q_y, part 7): the retraction
-- inv (ev g) = g over nil.HT: the fibre over ev g is a proposition with the
-- centre and (g, refl) in it, so their first components are joined.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
atvR (G : C.Ctx) (A B : C.Ty G) (r : C.El (C.ext G A) (OV.wkT G A B)) (x : C.El G A) (K : Ob) (w : V1.Ix (G.ob K))
  : Id (V1.Ix (B.1.tob K w)) ((PT.atv G A B r x).eob K w) (r.eob K (w, x.eob K w)) =
 transH (CAppRd[a].trE-rd G (C.subT G (C.ext G A) (OV.wkT G A B) (C.sec G A x)) B
          (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst G A B x) (C.subt G (C.ext G A) (OV.wkT G A B) r (C.sec G A x)) K w)
  (CAppRd[a].same-rd G (C.subT G (C.ext G A) (OV.wkT G A B) (C.sec G A x)) B
     (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst G A B x) K w (refl (B.1.tob K w)) (r.eob K (w, x.eob K w))) ;
module E7 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module E6m = CEv6[a].E6[R, encK, pe, y] ;
 module I = E6m.I ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = I.A ;
 D : C.Ctx = C.ext Nl HT ;
 gv : C.El D (C.subT D Nl HT (C.p Nl HT)) = C.q Nl HT ;
 sg : C.Sub D I.GB = CQSurj[a].Ex[C].exS D Nl I.B (C.p Nl HT) (I.evS D (C.p Nl HT) gv) ;
 -- (g, refl) in the fibre over ev g
 Xs : C.Ty D = C.subT D I.GB I.Xb sg ;
 PXs : Id (C.Ty D) (C.subT D Nl HT (C.p Nl HT)) Xs =
  transH (apH {C.Sub D Nl} {C.Ty D} (\ s -> C.subT D Nl HT s) (symH (INm.p-extS D Nl I.B (C.p Nl HT) (I.evS D (C.p Nl HT) gv))))
   (C.subT-o D I.GB Nl HT (C.p Nl I.B) sg) ;
 xg : C.El D Xs = OV.trE D (C.subT D Nl HT (C.p Nl HT)) Xs PXs gv ;
 xgr (K : Ob) (w : V1.Ix (D.ob K)) : Id (V1.Ix (Xs.1.tob K w)) (xg.eob K w) w.2 =
  transH (CAppRd[a].trE-rd D (C.subT D Nl HT (C.p Nl HT)) Xs PXs gv K w) (CAppRd[a].same-rd D (C.subT D Nl HT (C.p Nl HT)) Xs PXs K w (refl (Xs.1.tob K w)) w.2) ;
 lf : C.Sub (C.ext D Xs) I.GX = C.lift D I.GB I.Xb sg ;
 Ys : C.Ty (C.ext D Xs) = C.subT (C.ext D Xs) I.GX I.Fm lf ;
 rho : C.Sub D I.GX = C.o D (C.ext D Xs) I.GX lf (C.sec D Xs xg) ;
 T0 : C.Ty I.GX = OV.wkT I.GB I.Xb I.Bb ;
 qw : C.El I.GX T0 = OV.wkE I.GB I.Xb I.Bb (C.q Nl I.B) ;
 Tr : C.Ty D = C.subT D I.GX T0 rho ;
 er (K : Ob) (w : V1.Ix (D.ob K)) : Id (V1.Ix (Tr.1.tob K w)) ((C.subt D I.GX T0 I.apX rho).eob K w) ((C.subt D I.GX T0 qw rho).eob K w) =
  transH (I.appR K (rho.nt K w)) (apH {V1.Ix (HT.1.tob K w.1)} {V1.Ix (I.B.1.tob K w.1)} (I.n.nfun K w.1) (xgr K w)) ;
 r0 : C.El D (IJ.IdT D Tr (C.subt D I.GX T0 I.apX rho) (C.subt D I.GX T0 qw rho)) =
  CCmpU14[a].rwId D Tr (C.subt D I.GX T0 I.apX rho) (C.subt D I.GX T0 I.apX rho) (C.subt D I.GX T0 I.apX rho) (C.subt D I.GX T0 qw rho)
   (\ K w -> refl ((C.subt D I.GX T0 I.apX rho).eob K w)) er (IJ.rfl D Tr (C.subt D I.GX T0 I.apX rho)) ;
 yg : C.El D (C.subT D (C.ext D Xs) Ys (C.sec D Xs xg)) =
  OV.trE D (C.subT D I.GX I.Fm rho) (C.subT D (C.ext D Xs) Ys (C.sec D Xs xg)) (C.subT-o D (C.ext D Xs) I.GX I.Fm lf (C.sec D Xs xg))
   (OV.trE D (IJ.IdT D Tr (C.subt D I.GX T0 I.apX rho) (C.subt D I.GX T0 qw rho)) (C.subT D I.GX I.Fm rho) (symH (IJ.IdT-nat D I.GX T0 I.apX qw rho)) r0) ;
 FS : C.Ty D = C.subT D I.GB I.Fib sg ;
 PSs : Id (C.Ty D) FS (SS.Sig D Xs Ys) = FibCwF[a, a+].fibSig.Sig-nat D I.GB I.Xb I.Fm sg ;
 gr : C.El D FS = OV.trE D (SS.Sig D Xs Ys) FS (symH PSs) (INm.pr D Xs Ys xg yg) ;
 -- the centre at ev g, and the two are joined
 cs : C.El D FS = C.subt D I.GB I.Fib E6m.centre sg ;
 pFs : C.El D (PU.isProp D FS) =
  OV.trE D (C.subT D I.GB (PU.isProp I.GB I.Fib) sg) (PU.isProp D FS) (PU.isProp-ov D I.GB I.Fib sg FS (refl FS)) (C.subt D I.GB (PU.isProp I.GB I.Fib) E6m.pF sg) ;
 ecg : C.El D (IJ.IdT D FS cs gr) = PU.propPath D FS pFs cs gr ;
 -- first components
 SG : C.Ty D = SS.Sig D Xs Ys ;
 c' : C.El D SG = OV.trE D FS SG PSs cs ;
 g' : C.El D SG = OV.trE D FS SG PSs gr ;
 e1 : C.El D (IJ.IdT D SG c' g') = CInjP[a].idFwdL D FS SG PSs cs gr ecg ;
 E : C.Ctx = C.ext D SG ;
 XE : C.Ty E = OV.wkT D SG Xs ;
 fN (J I : Ob) (f : Hom J I) (z : V1.Ix (E.ob I))
   : Id (V1.Ix (XE.1.tob J (E.act J I f z))) (XE.1.tact J I f z (E.act J I f z) (refl (E.act J I f z)) z.2.1) (E.act J I f z).2.1 =
  L.tact-irr D Xs.1 J I f z.1 (D.act J I f z.1) (L.ntEq E D (L.pP D SG.1) J I f z (E.act J I f z) (refl (E.act J I f z))) (refl (D.act J I f z.1)) z.2.1 ;
 fr : C.El E XE = L.mkPEl E XE.1 (\ K z -> z.2.1) (\ J I f z z' e ->
  idJ (V1.Ix (E.ob J)) (E.act J I f z) (\ z2 e2 -> Id (V1.Ix (XE.1.tob J z2)) (XE.1.tact J I f z z2 e2 z.2.1) z2.2.1) (fN J I f z) z' e) ;
 cr (K : Ob) (w : V1.Ix (D.ob K)) : Id (V1.Ix (Xs.1.tob K w)) ((PT.atv D SG Xs fr c').eob K w) ((C.subt D I.GB I.Xb E6m.invB sg).eob K w) =
  transH (atvR D SG Xs fr c' K w)
   (apH {V1.Ix (SG.1.tob K w)} {V1.Ix (Xs.1.tob K w)} (\ v -> v.1)
     (transH (CAppRd[a].trE-rd D FS SG PSs cs K w) (CAppRd[a].same-rd D FS SG PSs K w (refl (SG.1.tob K w)) (cs.eob K w)))) ;
 grr (K : Ob) (w : V1.Ix (D.ob K)) : Id (V1.Ix (Xs.1.tob K w)) ((PT.atv D SG Xs fr g').eob K w) (xg.eob K w) =
  transH (atvR D SG Xs fr g' K w)
   (apH {V1.Ix (SG.1.tob K w)} {V1.Ix (Xs.1.tob K w)} (\ v -> v.1)
     (transH (CAppRd[a].trE-rd D FS SG PSs gr K w)
       (transH (CAppRd[a].same-rd D FS SG PSs K w (refl (SG.1.tob K w)) (gr.eob K w))
         (transH (CAppRd[a].trE-rd D SG FS (symH PSs) (INm.pr D Xs Ys xg yg) K w)
           (CAppRd[a].same-rd D SG FS (symH PSs) K w (refl (FS.1.tob K w)) ((INm.pr D Xs Ys xg yg).eob K w)))))) ;
 -- inv (ev g) = g (in the type of the fibre's first component; xg reads as g, xgr)
 ret : C.El D (IJ.IdT D Xs (C.subt D I.GB I.Xb E6m.invB sg) xg) =
  CCmpU14[a].rwId D Xs (PT.atv D SG Xs fr c') (C.subt D I.GB I.Xb E6m.invB sg) (PT.atv D SG Xs fr g') xg cr grr (PT.apM D SG Xs fr c' g' e1) ;
} ;
