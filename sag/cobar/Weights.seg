-- Weights.seg: the cosemisimplicial weights P_n of jonas.pdf Definition 10,
-- at the poset base (COBAR.md).  P_n is the cubical subset of I^(n+1) of
-- sequences with some coordinate equal to 1: at a stage W, coordinates
-- i : Fin (n+1) -> Hom W Iv such that the union over k of the faces
-- [i_k = 1] (bigU of the pullbacks of ptS e1) holds on all of W.
-- Restriction along g : V -> W precomposes the coordinates.
level a l ;
constraint a <= l ;
open Base ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module Ar = Arith[a] ;
module Pa = Prelude[a+] ;
Coords (n : Nat) (W : Ob) : U a = Ar.Fin (suc n) -> Hom W PB.Iv ;
-- the union of the faces [i_k = 1]
oneS (n : Nat) (W : Ob) (i : Coords n W) : PB.Phi W =
 PB.bigU W (suc n) (\ k -> PB.pre W PB.Iv (i k) (PB.ptS PB.e1)) ;
Pn (n : Nat) (W : Ob) : U a = (i : Coords n W) * PB.Lands W W (oneS n W i) (PB.idH W) ;
-- restriction of weights along g : Y -> W
resC (n : Nat) (Y W : Ob) (g : Hom Y W) (i : Coords n W) : Coords n Y =
 \ k -> PB.compH Y W PB.Iv (i k) g ;
module Res (n : Nat) (Y W : Ob) (g : Hom Y W) (p : Pn n W) {
 -- the union holds along g ...
 along : PB.Lands Y W (oneS n W p.1) g =
  Pa.subst (Hom Y W) (\ h -> PB.Lands Y W (oneS n W p.1) h) (PB.compH Y W W (PB.idH W) g) g
   (PB.comp-idl Y W g) (PB.lands-comp Y W W (oneS n W p.1) (PB.idH W) g p.2) ;
 k : Ar.Fin (suc n) = (PB.bigU-out Y W (suc n) (\ j -> PB.pre W PB.Iv (p.1 j) (PB.ptS PB.e1)) g along).1 ;
 -- ... so the face k holds for the restricted coordinate
 atk : PB.Lands Y PB.Iv (PB.ptS PB.e1) (PB.compH Y W PB.Iv (p.1 k) g) =
  PB.lands-pre Y W PB.Iv (p.1 k) (PB.ptS PB.e1) g
   (PB.bigU-out Y W (suc n) (\ j -> PB.pre W PB.Iv (p.1 j) (PB.ptS PB.e1)) g along).2 ;
 atk' : PB.Lands Y Y (PB.pre Y PB.Iv (resC n Y W g p.1 k) (PB.ptS PB.e1)) (PB.idH Y) =
  PB.pre-lands Y Y PB.Iv (resC n Y W g p.1 k) (PB.ptS PB.e1) (PB.idH Y)
   (Pa.subst (Hom Y PB.Iv) (\ h -> PB.Lands Y PB.Iv (PB.ptS PB.e1) h)
     (resC n Y W g p.1 k) (PB.compH Y Y PB.Iv (resC n Y W g p.1 k) (PB.idH Y))
     (Pa.sym (Hom Y PB.Iv) (PB.compH Y Y PB.Iv (resC n Y W g p.1 k) (PB.idH Y)) (resC n Y W g p.1 k)
       (PB.comp-idr Y PB.Iv (resC n Y W g p.1 k)))
     atk) ;
 res : Pn n Y = (resC n Y W g p.1,
  PB.bigU-in Y Y (suc n) (\ j -> PB.pre Y PB.Iv (resC n Y W g p.1 j) (PB.ptS PB.e1)) (PB.idH Y) k atk') ;
} ;
