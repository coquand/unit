-- Weights.seg: the cosemisimplicial weights P_n of jonas.pdf Definition 10,
-- at the poset base (COBAR.md).  P_n is the cubical subset of I^(n+1) of
-- sequences with some coordinate equal to 1: at a stage W, coordinates
-- i : Fin (n+1) -> Hom W Iv such that the union over k of the faces
-- [i_k = 1] (bigU of the pullbacks of ptS e1) holds on all of W.
-- Restriction along g : V -> W precomposes the coordinates.
level a l ;
constraint a <= l ;
open Base ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module Ar = Arith[a] ;
open Trees[a] ;
module Pa = Prelude[a+] ;
Coords (n : Nat) (W : Ob) : U a = Ar.Fin (suc n) -> Hom W PB.Iv ;
-- the union of the faces [i_k = 1]
oneS (n : Nat) (W : Ob) (i : Coords n W) : PB.Phi W =
 PB.bigU W (suc n) (\ k -> PB.pre W PB.Iv (i k) (PB.ptS PB.e1)) ;
Pn (n : Nat) (W : Ob) : U a = (i : Coords n W) * PB.Lands W W (oneS n W i) (PB.idH W) ;
-- restriction of weights along g : Y -> W
resC (n : Nat) (Y W : Ob) (g : Hom Y W) (i : Coords n W) : Coords n Y =
 \ k -> PB.compH Y W PB.Iv (i k) g ;
module Res (n : Nat) (Y W : Ob) (g : Hom Y W) (p : Pn n W) {
 -- the union holds along g ...
 along : PB.Lands Y W (oneS n W p.1) g =
  Pa.subst (Hom Y W) (\ h -> PB.Lands Y W (oneS n W p.1) h) (PB.compH Y W W (PB.idH W) g) g
   (PB.comp-idl Y W g) (PB.lands-comp Y W W (oneS n W p.1) (PB.idH W) g p.2) ;
 k : Ar.Fin (suc n) = (PB.bigU-out Y W (suc n) (\ j -> PB.pre W PB.Iv (p.1 j) (PB.ptS PB.e1)) g along).1 ;
 -- ... so the face k holds for the restricted coordinate
 atk : PB.Lands Y PB.Iv (PB.ptS PB.e1) (PB.compH Y W PB.Iv (p.1 k) g) =
  PB.lands-pre Y W PB.Iv (p.1 k) (PB.ptS PB.e1) g
   (PB.bigU-out Y W (suc n) (\ j -> PB.pre W PB.Iv (p.1 j) (PB.ptS PB.e1)) g along).2 ;
 atk' : PB.Lands Y Y (PB.pre Y PB.Iv (resC n Y W g p.1 k) (PB.ptS PB.e1)) (PB.idH Y) =
  PB.pre-lands Y Y PB.Iv (resC n Y W g p.1 k) (PB.ptS PB.e1) (PB.idH Y)
   (Pa.subst (Hom Y PB.Iv) (\ h -> PB.Lands Y PB.Iv (PB.ptS PB.e1) h)
     (resC n Y W g p.1 k) (PB.compH Y Y PB.Iv (resC n Y W g p.1 k) (PB.idH Y))
     (Pa.sym (Hom Y PB.Iv) (PB.compH Y Y PB.Iv (resC n Y W g p.1 k) (PB.idH Y)) (resC n Y W g p.1 k)
       (PB.comp-idr Y PB.Iv (resC n Y W g p.1 k)))
     atk) ;
 res : Pn n Y = (resC n Y W g p.1,
  PB.bigU-in Y Y (suc n) (\ j -> PB.pre Y PB.Iv (resC n Y W g p.1 j) (PB.ptS PB.e1)) (PB.idH Y) k atk') ;
} ;
-- the face maps d_y : P_n -> P_(n+1), y <= n+1: insert e0 at position y.
-- The value at j is e0 if j = y, and i (dg n y j) otherwise (dg undoes skip).
Tb : Bool -> U a+ = split { true -> Top ; false -> Empty } ;
not-true : (b : Bool) -> Id Bool (not b) true -> Id Bool b false = split {
 true -> \ e -> Pa.absurd (Id Bool true false) (Pa.subst Bool Tb true false (Pa.sym Bool false true e) tt) ;
 false -> \ e -> refl false } ;
module Face (n : Nat) (W : Ob) (y : Nat) (hy : IsT (leb y (suc n))) {
 valB (i : Coords n W) (j : Nat) (hj : IsT (leb j (suc n))) : (b : Bool) -> Id Bool (eqN j y) b -> Hom W PB.Iv = split {
  true -> \ e -> PB.ptH W PB.e0 ;
  false -> \ e -> i (Ar.dg n y j,Ar.dg-range n y j hj) } ;
 faceC (i : Coords n W) : Coords (suc n) W = \ k -> valB i k.1 k.2 (eqN k.1 y) (refl (eqN k.1 y)) ;
 -- the value does not depend on how eqN j y is decided
 valB-path (i : Coords n W) (j : Nat) (hj : IsT (leb j (suc n))) (b : Bool) (e : Id Bool (eqN j y) b) :
  Id (Hom W PB.Iv) (valB i j hj (eqN j y) (refl (eqN j y))) (valB i j hj b e) =
  idJ Bool (eqN j y) (\ b2 e2 -> Id (Hom W PB.Iv) (valB i j hj (eqN j y) (refl (eqN j y))) (valB i j hj b2 e2))
   (refl (valB i j hj (eqN j y) (refl (eqN j y)))) b e ;
 -- the coordinate skip y j of the face is the coordinate j
 skipF (j : Ar.Fin (suc n)) : Ar.Fin (suc (suc n)) = (Ar.skip y j.1,Ar.skip-range y j.1 n j.2) ;
 face-skip (i : Coords n W) (j : Ar.Fin (suc n)) : Id (Hom W PB.Iv) (faceC i (skipF j)) (i j) =
  Pa.trans (Hom W PB.Iv) (faceC i (skipF j))
   (valB i (Ar.skip y j.1) (skipF j).2 false (not-true (eqN (Ar.skip y j.1) y) (Ar.skip-miss y j.1))) (i j)
   (valB-path i (Ar.skip y j.1) (skipF j).2 false (not-true (eqN (Ar.skip y j.1) y) (Ar.skip-miss y j.1)))
   (Pa.ap (Ar.Fin (suc n)) (Hom W PB.Iv) i (Ar.dg n y (Ar.skip y j.1),Ar.dg-range n y (Ar.skip y j.1) (skipF j).2) j
     (Pa.Sigma-eq Nat (\ m -> IsT (Ar.ltb m (suc n))) (Ar.dg n y (Ar.skip y j.1)) j.1
       (Ar.dg-range n y (Ar.skip y j.1) (skipF j).2) j.2
       (Ar.dg-skip n y j.1 hy j.2) (Ar.isProp-IsT' (Ar.ltb j.1 (suc n))))) ;
 -- the face of a weight is a weight
 module Of (p : Pn n W) {
  QF (i : Coords (suc n) W) (k : Ar.Fin (suc (suc n))) : PB.Phi W = PB.pre W PB.Iv (i k) (PB.ptS PB.e1) ;
  out : (k : Ar.Fin (suc n)) * PB.Lands W W (PB.pre W PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH W) =
   PB.bigU-out W W (suc n) (\ k -> PB.pre W PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH W) p.2 ;
  at : PB.Lands W W (QF (faceC p.1) (skipF out.1)) (PB.idH W) =
   PB.lands-sub W W (PB.pre W PB.Iv (p.1 out.1) (PB.ptS PB.e1)) (QF (faceC p.1) (skipF out.1))
    (Pa.ap (Hom W PB.Iv) (PB.Phi W) (\ h -> PB.pre W PB.Iv h (PB.ptS PB.e1)) (p.1 out.1) (faceC p.1 (skipF out.1))
      (Pa.sym (Hom W PB.Iv) (faceC p.1 (skipF out.1)) (p.1 out.1) (face-skip p.1 out.1)))
    (PB.idH W) out.2 ;
  face : Pn (suc n) W = (faceC p.1,PB.bigU-in W W (suc (suc n)) (QF (faceC p.1)) (PB.idH W) (skipF out.1) at) ;
 } ;
} ;
-- unface: a weight of P_(n+1) whose coordinate k lands in [i_k = 0] is the
-- face d_k of the weight obtained by deleting coordinate k.  (Lemma 12:
-- on the face [i_k = 0] of its cofibration, the side is read at level n.)
module Unface (n : Nat) (W : Ob) (k : Nat) (hk : IsT (leb k (suc n))) (p : Pn (suc n) W)
 (z : PB.Lands W PB.Iv (PB.ptS PB.e0) (p.1 (k,hk))) {
 module F = Face[n,W,k,hk] ;
 c' : Coords n W = \ j -> p.1 (F.skipF j) ;
 -- the coordinate witnessing the weight
 out : (m : Ar.Fin (suc (suc n))) * PB.Lands W W (PB.pre W PB.Iv (p.1 m) (PB.ptS PB.e1)) (PB.idH W) =
  PB.bigU-out W W (suc (suc n)) (\ m -> PB.pre W PB.Iv (p.1 m) (PB.ptS PB.e1)) (PB.idH W) p.2 ;
 one : PB.Lands W PB.Iv (PB.ptS PB.e1) (p.1 out.1) =
  Pa.subst (Hom W PB.Iv) (\ h -> PB.Lands W PB.Iv (PB.ptS PB.e1) h) (PB.compH W W PB.Iv (p.1 out.1) (PB.idH W)) (p.1 out.1)
   (PB.comp-idr W PB.Iv (p.1 out.1))
   (PB.lands-pre W W PB.Iv (p.1 out.1) (PB.ptS PB.e1) (PB.idH W) out.2) ;
 -- out.1 is not k (the end points are disjoint), so it is skip k j for j = dg n k out.1
 notk (e : Id Nat out.1.1 k) : Empty =
  PB.pt-disj W (p.1 out.1)
   (Pa.subst (Ar.Fin (suc (suc n))) (\ m -> PB.Lands W PB.Iv (PB.ptS PB.e0) (p.1 m)) (k,hk) out.1
     (Pa.Sigma-eq Nat (\ m -> IsT (Ar.ltb m (suc (suc n)))) k out.1.1 hk out.1.2
       (Pa.sym Nat out.1.1 k e) (Ar.isProp-IsT' (Ar.ltb out.1.1 (suc (suc n)))))
     z)
   one ;
 jj : Ar.Fin (suc n) = (Ar.dg n k out.1.1,Ar.dg-range n k out.1.1 out.1.2) ;
 back : Id (Ar.Fin (suc (suc n))) (F.skipF jj) out.1 =
  Pa.Sigma-eq Nat (\ m -> IsT (Ar.ltb m (suc (suc n)))) (Ar.skip k jj.1) out.1.1 (F.skipF jj).2 out.1.2
   (Ar.eqN-dec (Id Nat (Ar.skip k jj.1) out.1.1) out.1.1 k
     (\ e -> Pa.absurd (Id Nat (Ar.skip k jj.1) out.1.1) (notk e))
     (\ ne -> Ar.skip-dg n k out.1.1 hk out.1.2 ne))
   (Ar.isProp-IsT' (Ar.ltb out.1.1 (suc (suc n)))) ;
 at : PB.Lands W W (PB.pre W PB.Iv (c' jj) (PB.ptS PB.e1)) (PB.idH W) =
  PB.lands-sub W W (PB.pre W PB.Iv (p.1 out.1) (PB.ptS PB.e1)) (PB.pre W PB.Iv (c' jj) (PB.ptS PB.e1))
   (Pa.ap (Ar.Fin (suc (suc n))) (PB.Phi W) (\ m -> PB.pre W PB.Iv (p.1 m) (PB.ptS PB.e1)) out.1 (F.skipF jj)
     (Pa.sym (Ar.Fin (suc (suc n))) (F.skipF jj) out.1 back))
   (PB.idH W) out.2 ;
 p' : Pn n W = (c',PB.bigU-in W W (suc n) (\ j -> PB.pre W PB.Iv (c' j) (PB.ptS PB.e1)) (PB.idH W) jj at) ;
 -- the face of p' is p, coordinatewise
 zero-k : Id (Hom W PB.Iv) (p.1 (k,hk)) (PB.ptH W PB.e0) = PB.lands-pt W PB.e0 (p.1 (k,hk)) z ;
 fin-eq (j j' : Ar.Fin (suc (suc n))) (e : Id Nat j.1 j'.1) : Id (Ar.Fin (suc (suc n))) j j' =
  Pa.Sigma-eq Nat (\ m -> IsT (Ar.ltb m (suc (suc n)))) j.1 j'.1 j.2 j'.2 e (Ar.isProp-IsT' (Ar.ltb j'.1 (suc (suc n)))) ;
 face-eq (j : Ar.Fin (suc (suc n))) : Id (Hom W PB.Iv) (F.faceC c' j) (p.1 j) =
  Ar.eqN-dec (Id (Hom W PB.Iv) (F.faceC c' j) (p.1 j)) j.1 k
   (\ e -> Pa.trans (Hom W PB.Iv) (F.faceC c' j)
      (F.valB c' j.1 j.2 true (Pa.subst Nat (\ m -> Id Bool (eqN j.1 m) true) j.1 k e (eqN-refl j.1))) (p.1 j)
      (F.valB-path c' j.1 j.2 true (Pa.subst Nat (\ m -> Id Bool (eqN j.1 m) true) j.1 k e (eqN-refl j.1)))
      (Pa.trans (Hom W PB.Iv) (PB.ptH W PB.e0) (p.1 (k,hk)) (p.1 j)
        (Pa.sym (Hom W PB.Iv) (p.1 (k,hk)) (PB.ptH W PB.e0) zero-k)
        (Pa.ap (Ar.Fin (suc (suc n))) (Hom W PB.Iv) p.1 (k,hk) j (fin-eq (k,hk) j (Pa.sym Nat j.1 k e)))))
   (\ ne -> Pa.trans (Hom W PB.Iv) (F.faceC c' j)
      (F.valB c' j.1 j.2 false (not-true (eqN j.1 k) ne)) (p.1 j)
      (F.valB-path c' j.1 j.2 false (not-true (eqN j.1 k) ne))
      (Pa.ap (Ar.Fin (suc (suc n))) (Hom W PB.Iv) p.1 (F.skipF (Ar.dg n k j.1,Ar.dg-range n k j.1 j.2)) j
        (fin-eq (F.skipF (Ar.dg n k j.1,Ar.dg-range n k j.1 j.2)) j (Ar.skip-dg n k j.1 hk j.2 ne)))) ;
} ;
-- (W3) the cosimplicial identity of the coordinate maps: for k <= z,
-- skip k (skip z j) = skip (z+1) (skip k j)  (Arith.skip-skip), and its
-- form on the coordinates of a weight p : P_(n+2).
fin-eq (r : Nat) (j j' : Ar.Fin r) (e : Id Nat j.1 j'.1) : Id (Ar.Fin r) j j' =
 Pa.Sigma-eq Nat (\ m -> IsT (Ar.ltb m r)) j.1 j'.1 j.2 j'.2 e (Ar.isProp-IsT' (Ar.ltb j'.1 r)) ;
module W3 (n : Nat) (W : Ob) (k z : Nat) (hkz : IsT (leb k z)) (hz : IsT (leb z (suc n))) {
 hk : IsT (leb k (suc n)) = leb-trans k z (suc n) hkz hz ;
 hk' : IsT (leb k (suc (suc n))) = Ar.leb-step k (suc n) hk ;
 -- d_k after d_z, and d_(z+1) after d_k, on coordinate indices
 lhs (j : Ar.Fin (suc n)) : Ar.Fin (suc (suc (suc n))) = Face[suc n,W,k,hk'].skipF (Face[n,W,z,hz].skipF j) ;
 rhs (j : Ar.Fin (suc n)) : Ar.Fin (suc (suc (suc n))) = Face[suc n,W,suc z,hz].skipF (Face[n,W,k,hk].skipF j) ;
 idx (j : Ar.Fin (suc n)) : Id (Ar.Fin (suc (suc (suc n)))) (lhs j) (rhs j) =
  fin-eq (suc (suc (suc n))) (lhs j) (rhs j)
   (Pa.sym Nat (Ar.skip (suc z) (Ar.skip k j.1)) (Ar.skip k (Ar.skip z j.1)) (Ar.skip-skip k z j.1 hkz)) ;
 coord (p : Pn (suc (suc n)) W) (j : Ar.Fin (suc n)) : Id (Hom W PB.Iv) (p.1 (lhs j)) (p.1 (rhs j)) =
  Pa.ap (Ar.Fin (suc (suc (suc n)))) (Hom W PB.Iv) p.1 (lhs j) (rhs j) (idx j) ;
} ;
-- restriction commutes with the faces: (d_k i).f' = d_k (i.f')  (moved here
-- from canonicity-45's Lemma11L, where it was first proved)
module RF (n : Nat) (J Yv : Ob) (f' : Hom Yv J) (k : Nat) (hk : IsT (leb k (suc n))) (i : Pn n J) {
 vr (jn : Nat) (hj : IsT (leb jn (suc n)))
  : (b : Bool) -> (e : Id Bool (eqN jn k) b)
    -> Id (Hom Yv PB.Iv) (PB.compH Yv J PB.Iv (Face[n, J, k, hk].valB i.1 jn hj b e) f')
                       (Face[n, Yv, k, hk].valB (resC n Yv J f' i.1) jn hj b e) = split {
  true -> \ e -> PB.ptH-nat Yv J f' PB.e0 ;
  false -> \ e -> refl (PB.compH Yv J PB.Iv (i.1 (Ar.dg n k jn, Ar.dg-range n k jn hj)) f') } ;
 resFace : Id (Pn (suc n) Yv) (Res[suc n, Yv, J, f', Face[n, J, k, hk].Of[i].face].res) (Face[n, Yv, k, hk].Of[Res[n, Yv, J, f', i].res].face) =
  Pa.Sigma-eq (Coords (suc n) Yv) (\ cs -> PB.Lands Yv Yv (oneS (suc n) Yv cs) (PB.idH Yv))
   (Res[suc n, Yv, J, f', Face[n, J, k, hk].Of[i].face].res).1 (Face[n, Yv, k, hk].Of[Res[n, Yv, J, f', i].res].face).1
   (Res[suc n, Yv, J, f', Face[n, J, k, hk].Of[i].face].res).2 (Face[n, Yv, k, hk].Of[Res[n, Yv, J, f', i].res].face).2
   (Axioms[a+].FunExtLemmas[fe @(a+)].funext (Ar.Fin (suc (suc n))) (\ j -> Hom Yv PB.Iv)
      (Res[suc n, Yv, J, f', Face[n, J, k, hk].Of[i].face].res).1 (Face[n, Yv, k, hk].Of[Res[n, Yv, J, f', i].res].face).1
      (\ j -> vr j.1 j.2 (eqN j.1 k) (refl (eqN j.1 k))))
   (PB.isProp-Lands Yv Yv (oneS (suc n) Yv (Face[n, Yv, k, hk].Of[Res[n, Yv, J, f', i].res].face).1) (PB.idH Yv)) ;
} ;
-- Lemma 14's weights: prepend a coordinate (cons), and the meet of a line
-- variable j with all coordinates (connection cI true, i.e. min).
consB (n : Nat) (W : Ob) (j : Hom W PB.Iv) (c : Coords n W) : (m : Nat) -> IsT (Ar.ltb m (suc (suc n))) -> Hom W PB.Iv = split {
 zero -> \ h -> j ;
 suc m -> \ h -> c (m,h) } ;
consC (n : Nat) (W : Ob) (j : Hom W PB.Iv) (c : Coords n W) : Coords (suc n) W = \ k -> consB n W j c k.1 k.2 ;
-- cons with first coordinate 1 is always a weight
consOne (n : Nat) (W : Ob) (c : Coords n W) : Pn (suc n) W =
 (consC n W (PB.ptH W PB.e1) c,
  PB.bigU-in W W (suc (suc n)) (\ k -> PB.pre W PB.Iv (consC n W (PB.ptH W PB.e1) c k) (PB.ptS PB.e1)) (PB.idH W) (zero,refl true)
   (PB.pre-lands W W PB.Iv (PB.ptH W PB.e1) (PB.ptS PB.e1) (PB.idH W)
     (Pa.subst (Hom W PB.Iv) (\ h -> PB.Lands W PB.Iv (PB.ptS PB.e1) h) (PB.ptH W PB.e1) (PB.compH W W PB.Iv (PB.ptH W PB.e1) (PB.idH W))
       (Pa.sym (Hom W PB.Iv) (PB.compH W W PB.Iv (PB.ptH W PB.e1) (PB.idH W)) (PB.ptH W PB.e1) (PB.comp-idr W PB.Iv (PB.ptH W PB.e1)))
       (PB.pt-lands W PB.e1)))) ;
-- the coordinatewise meet with a line variable j
meetC (n : Nat) (W : Ob) (j : Hom W PB.Iv) (c : Coords n W) : Coords n W = \ k -> PB.cI true W j (c k) ;
-- its ends: at j = 1 it is c, at j = 0 it is constantly 0
meet-one (n : Nat) (W : Ob) (c : Coords n W) (k : Ar.Fin (suc n)) :
 Id (Hom W PB.Iv) (meetC n W (PB.ptH W PB.e1) c k) (c k) = PB.cI-itgt-t W (c k) ;
meet-zero (n : Nat) (W : Ob) (c : Coords n W) (k : Ar.Fin (suc n)) :
 Id (Hom W PB.Iv) (meetC n W (PB.ptH W PB.e0) c k) (PB.ptH W PB.e0) = PB.cI-isrc-t W (c k) ;
-- restriction commutes with cons and meet
consResB (n : Nat) (Y W : Ob) (g : Hom Y W) (j : Hom W PB.Iv) (c : Coords n W)
 : (m : Nat) -> (h : IsT (Ar.ltb m (suc (suc n))))
   -> Id (Hom Y PB.Iv) (PB.compH Y W PB.Iv (consB n W j c m h) g) (consB n Y (PB.compH Y W PB.Iv j g) (resC n Y W g c) m h) = split {
 zero -> \ h -> refl (PB.compH Y W PB.Iv j g) ;
 suc m -> \ h -> refl (PB.compH Y W PB.Iv (c (m,h)) g) } ;
cons-res (n : Nat) (Y W : Ob) (g : Hom Y W) (j : Hom W PB.Iv) (c : Coords n W) (k : Ar.Fin (suc (suc n))) :
 Id (Hom Y PB.Iv) (resC (suc n) Y W g (consC n W j c) k) (consC n Y (PB.compH Y W PB.Iv j g) (resC n Y W g c) k) =
 consResB n Y W g j c k.1 k.2 ;
meet-res (n : Nat) (Y W : Ob) (g : Hom Y W) (j : Hom W PB.Iv) (c : Coords n W) (k : Ar.Fin (suc n)) :
 Id (Hom Y PB.Iv) (resC n Y W g (meetC n W j c) k) (meetC n Y (PB.compH Y W PB.Iv j g) (resC n Y W g c) k) =
 PB.cI-nat true Y W g j (c k) ;
-- cons of any first coordinate onto a weight is a weight (the coordinate
-- k+1 of consC j c is c k)
module ConsP (n : Nat) (W : Ob) (j : Hom W PB.Iv) (p : Pn n W) {
 out : (k : Ar.Fin (suc n)) * PB.Lands W W (PB.pre W PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH W) =
  PB.bigU-out W W (suc n) (\ k -> PB.pre W PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH W) p.2 ;
 consP : Pn (suc n) W = (consC n W j p.1,
  PB.bigU-in W W (suc (suc n)) (\ k -> PB.pre W PB.Iv (consC n W j p.1 k) (PB.ptS PB.e1)) (PB.idH W) (suc out.1.1,out.1.2) out.2) ;
} ;
-- Lemma 14's face laws for cons / meet (coordinatewise).
-- (W-a) face_(k+1) (cons j c) = cons j (face_k c)
module FaceCons (n : Nat) (W : Ob) (k : Nat) (hk : IsT (leb k (suc n))) (j : Hom W PB.Iv) (c : Coords n W) {
 module F1 = Face[suc n,W,suc k,hk] ;
 module F0 = Face[n,W,k,hk] ;
 sucB (m : Nat) (h : IsT (Ar.ltb m (suc (suc n)))) :
  (b : Bool) -> (e : Id Bool (eqN m k) b) -> Id (Hom W PB.Iv) (F1.valB (consC n W j c) (suc m) h b e) (F0.valB c m h b e) = split {
  true -> \ e -> refl (PB.ptH W PB.e0) ;
  false -> \ e -> Pa.ap (Ar.Fin (suc n)) (Hom W PB.Iv) c (Ar.dg n k m,Ar.dg-range n k m h) (Ar.dg n k m,Ar.dg-range n k m h)
    (fin-eq (suc n) (Ar.dg n k m,Ar.dg-range n k m h) (Ar.dg n k m,Ar.dg-range n k m h) (refl (Ar.dg n k m))) } ;
 coordB : (m : Nat) -> (h : IsT (Ar.ltb m (suc (suc (suc n)))))
  -> Id (Hom W PB.Iv) (F1.valB (consC n W j c) m h (eqN m (suc k)) (refl (eqN m (suc k)))) (consB (suc n) W j (F0.faceC c) m h) = split {
  zero -> \ h -> refl j ;
  suc m -> \ h -> sucB m h (eqN m k) (refl (eqN m k)) } ;
 coord (m : Ar.Fin (suc (suc (suc n)))) : Id (Hom W PB.Iv) (F1.faceC (consC n W j c) m) (consC (suc n) W j (F0.faceC c) m) =
  coordB m.1 m.2 ;
} ;
-- (W-b) cons e0 c = face_0 c
module ConsZero (n : Nat) (W : Ob) (c : Coords n W) {
 module F = Face[n,W,zero,refl true] ;
 coordB : (m : Nat) -> (h : IsT (Ar.ltb m (suc (suc n))))
  -> Id (Hom W PB.Iv) (consB n W (PB.ptH W PB.e0) c m h) (F.valB c m h (eqN m zero) (refl (eqN m zero))) = split {
  zero -> \ h -> refl (PB.ptH W PB.e0) ;
  suc m -> \ h -> Pa.ap (Ar.Fin (suc n)) (Hom W PB.Iv) c (m,h) (m,Ar.dg-range n zero (suc m) h)
    (fin-eq (suc n) (m,h) (m,Ar.dg-range n zero (suc m) h) (refl m)) } ;
 coord (m : Ar.Fin (suc (suc n))) : Id (Hom W PB.Iv) (consC n W (PB.ptH W PB.e0) c m) (F.faceC c m) = coordB m.1 m.2 ;
} ;
-- (W-c) the top face of (1, 0, ..., 0) is (1, 0, ..., 0) one level up
zeros (n : Nat) (W : Ob) : Coords n W = \ k -> PB.ptH W PB.e0 ;
module TopOne (W : Ob) {
 -- C1 n = (1, 0, ..., 0) with n+2 coordinates
 C1 (n : Nat) : Coords (suc n) W = consC n W (PB.ptH W PB.e1) (zeros n W) ;
 sucB (n : Nat) (hy : IsT (leb (suc (suc n)) (suc (suc n)))) (m : Nat) (h : IsT (Ar.ltb m (suc (suc n))))
  : (b : Bool) -> (e : Id Bool (eqN m (suc n)) b)
    -> Id (Hom W PB.Iv) (Face[suc n,W,suc (suc n),hy].valB (C1 n) (suc m) h b e) (PB.ptH W PB.e0) = split {
  true -> \ e -> refl (PB.ptH W PB.e0) ;
  false -> \ e -> refl (PB.ptH W PB.e0) } ;
 coordB (n : Nat) (hy : IsT (leb (suc (suc n)) (suc (suc n)))) : (m : Nat) -> (h : IsT (Ar.ltb m (suc (suc (suc n)))))
  -> Id (Hom W PB.Iv) (Face[suc n,W,suc (suc n),hy].valB (C1 n) m h (eqN m (suc (suc n))) (refl (eqN m (suc (suc n)))))
      (consB (suc n) W (PB.ptH W PB.e1) (zeros (suc n) W) m h) = split {
  zero -> \ h -> refl (PB.ptH W PB.e1) ;
  suc m -> \ h -> sucB n hy m h (eqN m (suc n)) (refl (eqN m (suc n))) } ;
 -- (W-c) the top face of C1 n is C1 (n+1)
 coord (n : Nat) (hy : IsT (leb (suc (suc n)) (suc (suc n)))) (m : Ar.Fin (suc (suc (suc n)))) :
  Id (Hom W PB.Iv) (Face[suc n,W,suc (suc n),hy].faceC (C1 n) m) (C1 (suc n) m) = coordB n hy m.1 m.2 ;
} ;
-- meet commutes with the faces
module MeetFace (n : Nat) (W : Ob) (k : Nat) (hk : IsT (leb k (suc n))) (j : Hom W PB.Iv) (c : Coords n W) {
 module F = Face[n,W,k,hk] ;
 coordB (m : Nat) (h : IsT (leb m (suc n))) : (b : Bool) -> (e : Id Bool (eqN m k) b)
  -> Id (Hom W PB.Iv) (F.valB (meetC n W j c) m h b e) (PB.cI true W j (F.valB c m h b e)) = split {
  true -> \ e -> Pa.sym (Hom W PB.Iv) (PB.cI true W j (PB.ptH W PB.e0)) (PB.ptH W PB.e0) (PB.cI-jsrc-t W j) ;
  false -> \ e -> refl (PB.cI true W j (c (Ar.dg n k m,Ar.dg-range n k m h))) } ;
 coord (m : Ar.Fin (suc (suc n))) : Id (Hom W PB.Iv) (F.faceC (meetC n W j c) m) (meetC (suc n) W j (F.faceC c) m) =
  coordB m.1 m.2 (eqN m.1 k) (refl (eqN m.1 k)) ;
} ;
-- Lemma 16: concatenation of coordinates, catC m n j i : Coords (m + n + 1)
-- (arity plus m (suc n), by recursion on m: cons the head of j).
-- j occupies the positions 0..m, i the positions m+1..m+1+n.
catC : (m : Nat) -> (n : Nat) -> (J : Ob) -> Coords m J -> Coords n J -> Coords (Ar.plus m (suc n)) J = split {
 zero -> \ n J j i -> consC n J (j (zero,refl true)) i ;
 suc m | r -> \ n J j i -> consC (Ar.plus m (suc n)) J (j (zero,refl true)) (r n J (\ k -> j (suc k.1,k.2)) i) } ;
-- arithmetic for the positions
le-plus : (m x : Nat) -> IsT (leb m (Ar.plus m x)) = split {
 zero -> \ x -> refl true ;
 suc m | ih -> \ x -> ih x } ;
plus-mono : (m a b : Nat) -> IsT (leb a b) -> IsT (leb (Ar.plus m a) (Ar.plus m b)) = split {
 zero -> \ a b h -> h ;
 suc m | ih -> \ a b h -> ih a b h } ;
-- the positions of j and of i inside catC
embL (m n : Nat) (k : Ar.Fin (suc m)) : Ar.Fin (suc (Ar.plus m (suc n))) =
 (k.1,leb-trans (suc k.1) (suc m) (suc (Ar.plus m (suc n))) k.2 (le-plus m (suc n))) ;
embR (m n : Nat) (k : Ar.Fin (suc n)) : Ar.Fin (suc (Ar.plus m (suc n))) =
 (Ar.plus m (suc k.1),plus-mono m (suc k.1) (suc n) k.2) ;
catL0 (n : Nat) (J : Ob) (j : Coords zero J) (i : Coords n J)
 : (kk : Nat) -> (h : IsT (Ar.ltb kk (suc zero))) -> Id (Hom J PB.Iv) (catC zero n J j i (embL zero n (kk,h))) (j (kk,h)) = split {
 zero -> \ h -> Pa.ap (Ar.Fin (suc zero)) (Hom J PB.Iv) j (zero,refl true) (zero,h)
   (fin-eq (suc zero) (zero,refl true) (zero,h) (refl zero)) ;
 suc kk -> \ h -> Pa.absurd (Id (Hom J PB.Iv) (catC zero n J j i (embL zero n (suc kk,h))) (j (suc kk,h)))
   (Pa.subst Bool Tb true false (Pa.sym Bool false true h) tt) } ;
catLs (m : Nat)
 (ih : (n : Nat) -> (J : Ob) -> (j : Coords m J) -> (i : Coords n J) -> (k : Ar.Fin (suc m))
   -> Id (Hom J PB.Iv) (catC m n J j i (embL m n k)) (j k))
 (n : Nat) (J : Ob) (j : Coords (suc m) J) (i : Coords n J)
 : (kk : Nat) -> (h : IsT (Ar.ltb kk (suc (suc m))))
   -> Id (Hom J PB.Iv) (catC (suc m) n J j i (embL (suc m) n (kk,h))) (j (kk,h)) = split {
 zero -> \ h -> Pa.ap (Ar.Fin (suc (suc m))) (Hom J PB.Iv) j (zero,refl true) (zero,h)
   (fin-eq (suc (suc m)) (zero,refl true) (zero,h) (refl zero)) ;
 suc kk -> \ h -> Pa.trans (Hom J PB.Iv) (catC (suc m) n J j i (embL (suc m) n (suc kk,h)))
   (catC m n J (\ k -> j (suc k.1,k.2)) i (embL m n (kk,h))) (j (suc kk,h))
   (Pa.ap (Ar.Fin (suc (Ar.plus m (suc n)))) (Hom J PB.Iv) (catC m n J (\ k -> j (suc k.1,k.2)) i)
     (kk,(embL (suc m) n (suc kk,h)).2) (embL m n (kk,h))
     (fin-eq (suc (Ar.plus m (suc n))) (kk,(embL (suc m) n (suc kk,h)).2) (embL m n (kk,h)) (refl kk)))
   (ih n J (\ k -> j (suc k.1,k.2)) i (kk,h)) } ;
catL : (m : Nat) -> (n : Nat) -> (J : Ob) -> (j : Coords m J) -> (i : Coords n J) -> (k : Ar.Fin (suc m))
 -> Id (Hom J PB.Iv) (catC m n J j i (embL m n k)) (j k) = split {
 zero -> \ n J j i k -> catL0 n J j i k.1 k.2 ;
 suc m | ih -> \ n J j i k -> catLs m ih n J j i k.1 k.2 } ;
catR : (m : Nat) -> (n : Nat) -> (J : Ob) -> (j : Coords m J) -> (i : Coords n J) -> (k : Ar.Fin (suc n))
 -> Id (Hom J PB.Iv) (catC m n J j i (embR m n k)) (i k) = split {
 zero -> \ n J j i k -> Pa.ap (Ar.Fin (suc n)) (Hom J PB.Iv) i (k.1,(embR zero n k).2) k
   (fin-eq (suc n) (k.1,(embR zero n k).2) k (refl k.1)) ;
 suc m | ih -> \ n J j i k -> Pa.trans (Hom J PB.Iv) (catC (suc m) n J j i (embR (suc m) n k))
   (catC m n J (\ kk -> j (suc kk.1,kk.2)) i (embR m n k)) (i k)
   (Pa.ap (Ar.Fin (suc (Ar.plus m (suc n)))) (Hom J PB.Iv) (catC m n J (\ kk -> j (suc kk.1,kk.2)) i)
     (Ar.plus m (suc k.1),(embR (suc m) n k).2) (embR m n k)
     (fin-eq (suc (Ar.plus m (suc n))) (Ar.plus m (suc k.1),(embR (suc m) n k).2) (embR m n k) (refl (Ar.plus m (suc k.1)))))
   (ih n J (\ kk -> j (suc kk.1,kk.2)) i k) } ;
-- concatenation of weights: a weight on either side gives a weight
module CatP (m n : Nat) (J : Ob) {
 QJ (c : Coords (Ar.plus m (suc n)) J) (k : Ar.Fin (suc (Ar.plus m (suc n)))) : PB.Phi J = PB.pre J PB.Iv (c k) (PB.ptS PB.e1) ;
 left (p : Pn m J) (i : Coords n J) : Pn (Ar.plus m (suc n)) J =
  (catC m n J p.1 i,
   PB.bigU-in J J (suc (Ar.plus m (suc n))) (QJ (catC m n J p.1 i)) (PB.idH J)
    (embL m n (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1)
    (PB.lands-sub J J
      (PB.pre J PB.Iv (p.1 (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1) (PB.ptS PB.e1))
      (QJ (catC m n J p.1 i) (embL m n (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1))
      (Pa.ap (Hom J PB.Iv) (PB.Phi J) (\ h -> PB.pre J PB.Iv h (PB.ptS PB.e1))
        (p.1 (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1)
        (catC m n J p.1 i (embL m n (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1))
        (Pa.sym (Hom J PB.Iv) (catC m n J p.1 i (embL m n (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1))
          (p.1 (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1)
          (catL m n J p.1 i (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1)))
      (PB.idH J) (PB.bigU-out J J (suc m) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).2)) ;
 right (j : Coords m J) (p : Pn n J) : Pn (Ar.plus m (suc n)) J =
  (catC m n J j p.1,
   PB.bigU-in J J (suc (Ar.plus m (suc n))) (QJ (catC m n J j p.1)) (PB.idH J)
    (embR m n (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1)
    (PB.lands-sub J J
      (PB.pre J PB.Iv (p.1 (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1) (PB.ptS PB.e1))
      (QJ (catC m n J j p.1) (embR m n (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1))
      (Pa.ap (Hom J PB.Iv) (PB.Phi J) (\ h -> PB.pre J PB.Iv h (PB.ptS PB.e1))
        (p.1 (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1)
        (catC m n J j p.1 (embR m n (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1))
        (Pa.sym (Hom J PB.Iv) (catC m n J j p.1 (embR m n (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1))
          (p.1 (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1)
          (catR m n J j p.1 (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).1)))
      (PB.idH J) (PB.bigU-out J J (suc n) (\ k -> PB.pre J PB.Iv (p.1 k) (PB.ptS PB.e1)) (PB.idH J) p.2).2)) ;
} ;
-- consC is a congruence in its tail
consC-cong (n : Nat) (W : Ob) (a : Hom W PB.Iv) (c c' : Coords n W) (e : (k : Ar.Fin (suc n)) -> Id (Hom W PB.Iv) (c k) (c' k))
 : (m : Nat) -> (h : IsT (Ar.ltb m (suc (suc n)))) -> Id (Hom W PB.Iv) (consB n W a c m h) (consB n W a c' m h) = split {
 zero -> \ h -> refl a ;
 suc m -> \ h -> e (m,h) } ;
-- restriction commutes with concatenation
catC-res : (m : Nat) -> (n : Nat) -> (Y W : Ob) -> (g : Hom Y W) -> (j : Coords m W) -> (i : Coords n W)
 -> (k : Ar.Fin (suc (Ar.plus m (suc n))))
 -> Id (Hom Y PB.Iv) (resC (Ar.plus m (suc n)) Y W g (catC m n W j i) k) (catC m n Y (resC m Y W g j) (resC n Y W g i) k) = split {
 zero -> \ n Y W g j i k -> cons-res n Y W g (j (zero,refl true)) i k ;
 suc m | ih -> \ n Y W g j i k -> Pa.trans (Hom Y PB.Iv) _
   (consC (Ar.plus m (suc n)) Y (PB.compH Y W PB.Iv (j (zero,refl true)) g) (resC (Ar.plus m (suc n)) Y W g (catC m n W (\ kk -> j (suc kk.1,kk.2)) i)) k) _
   (cons-res (Ar.plus m (suc n)) Y W g (j (zero,refl true)) (catC m n W (\ kk -> j (suc kk.1,kk.2)) i) k)
   (consC-cong (Ar.plus m (suc n)) Y (PB.compH Y W PB.Iv (j (zero,refl true)) g)
     (resC (Ar.plus m (suc n)) Y W g (catC m n W (\ kk -> j (suc kk.1,kk.2)) i))
     (catC m n Y (\ kk -> resC (suc m) Y W g j (suc kk.1,kk.2)) (resC n Y W g i))
     (ih n Y W g (\ kk -> j (suc kk.1,kk.2)) i) k.1 k.2) } ;
-- helpers: every coordinate tuple is cons of its head and tail; faceC and
-- catC are congruences (pointwise)
headC (n : Nat) (W : Ob) (c : Coords (suc n) W) : Hom W PB.Iv = c (zero,refl true) ;
tailC (n : Nat) (W : Ob) (c : Coords (suc n) W) : Coords n W = \ k -> c (suc k.1,k.2) ;
consC-eta (n : Nat) (W : Ob) (c : Coords (suc n) W)
 : (m : Nat) -> (h : IsT (Ar.ltb m (suc (suc n)))) -> Id (Hom W PB.Iv) (c (m,h)) (consB n W (headC n W c) (tailC n W c) m h) = split {
 zero -> \ h -> Pa.ap (Ar.Fin (suc (suc n))) (Hom W PB.Iv) c (zero,h) (zero,refl true) (fin-eq (suc (suc n)) (zero,h) (zero,refl true) (refl zero)) ;
 suc m -> \ h -> refl (c (suc m,h)) } ;
module FaceCong (n : Nat) (W : Ob) (y : Nat) (hy : IsT (leb y (suc n))) (c c' : Coords n W)
 (e : (k : Ar.Fin (suc n)) -> Id (Hom W PB.Iv) (c k) (c' k)) {
 module F = Face[n,W,y,hy] ;
 vB (m : Nat) (h : IsT (leb m (suc n))) : (b : Bool) -> (ee : Id Bool (eqN m y) b)
  -> Id (Hom W PB.Iv) (F.valB c m h b ee) (F.valB c' m h b ee) = split {
  true -> \ ee -> refl (PB.ptH W PB.e0) ;
  false -> \ ee -> e (Ar.dg n y m,Ar.dg-range n y m h) } ;
 coord (k : Ar.Fin (suc (suc n))) : Id (Hom W PB.Iv) (F.faceC c k) (F.faceC c' k) = vB k.1 k.2 (eqN k.1 y) (refl (eqN k.1 y)) ;
} ;
-- cons is a congruence in its head
consCongH (n : Nat) (W : Ob) (a a' : Hom W PB.Iv) (c : Coords n W) (e : Id (Hom W PB.Iv) a a')
 : (m : Nat) -> (h : IsT (Ar.ltb m (suc (suc n)))) -> Id (Hom W PB.Iv) (consB n W a c m h) (consB n W a' c m h) = split {
 zero -> \ h -> e ;
 suc m -> \ h -> refl (c (m,h)) } ;
catC-congL : (m : Nat) -> (n : Nat) -> (J : Ob) -> (j j' : Coords m J) -> (i : Coords n J)
 -> ((k : Ar.Fin (suc m)) -> Id (Hom J PB.Iv) (j k) (j' k))
 -> (k : Ar.Fin (suc (Ar.plus m (suc n)))) -> Id (Hom J PB.Iv) (catC m n J j i k) (catC m n J j' i k) = split {
 zero -> \ n J j j' i e k -> consCongH n J (j (zero,refl true)) (j' (zero,refl true)) i (e (zero,refl true)) k.1 k.2 ;
 suc m | ih -> \ n J j j' i e k -> Pa.trans (Hom J PB.Iv) _
   (consC (Ar.plus m (suc n)) J (j' (zero,refl true)) (catC m n J (\ kk -> j (suc kk.1,kk.2)) i) k) _
   (consCongH (Ar.plus m (suc n)) J (j (zero,refl true)) (j' (zero,refl true)) (catC m n J (\ kk -> j (suc kk.1,kk.2)) i) (e (zero,refl true)) k.1 k.2)
   (consC-cong (Ar.plus m (suc n)) J (j' (zero,refl true)) (catC m n J (\ kk -> j (suc kk.1,kk.2)) i)
     (catC m n J (\ kk -> j' (suc kk.1,kk.2)) i)
     (ih n J (\ kk -> j (suc kk.1,kk.2)) (\ kk -> j' (suc kk.1,kk.2)) i (\ kk -> e (suc kk.1,kk.2))) k.1 k.2) } ;
-- the face does not depend on the bound proof of its position
module FaceIrr (n : Nat) (W : Ob) (y : Nat) (hy hy' : IsT (leb y (suc n))) (c : Coords n W) {
 vB (m : Nat) (h : IsT (leb m (suc n))) : (b : Bool) -> (ee : Id Bool (eqN m y) b)
  -> Id (Hom W PB.Iv) (Face[n,W,y,hy].valB c m h b ee) (Face[n,W,y,hy'].valB c m h b ee) = split {
  true -> \ ee -> refl (PB.ptH W PB.e0) ;
  false -> \ ee -> refl (c (Ar.dg n y m,Ar.dg-range n y m h)) } ;
 coord (k : Ar.Fin (suc (suc n))) : Id (Hom W PB.Iv) (Face[n,W,y,hy].faceC c k) (Face[n,W,y,hy'].faceC c k) =
  vB k.1 k.2 (eqN k.1 y) (refl (eqN k.1 y)) ;
} ;
-- the bound of a left position inside catC
hkB (m n k : Nat) (hk : IsT (leb k (suc m))) : IsT (leb k (suc (Ar.plus m (suc n)))) =
 leb-trans k (suc m) (suc (Ar.plus m (suc n))) hk (le-plus m (suc n)) ;
-- the tail of a face at k+1 is the face at k of the tail
module TailFace (m : Nat) (W : Ob) (k : Nat) (hk : IsT (leb k (suc m))) (j : Coords (suc m) W) {
 vB (t : Nat) (h : IsT (Ar.ltb t (suc (suc m)))) : (b : Bool) -> (ee : Id Bool (eqN t k) b)
  -> Id (Hom W PB.Iv) (Face[suc m,W,suc k,hk].valB j (suc t) h b ee) (Face[m,W,k,hk].valB (tailC m W j) t h b ee) = split {
  true -> \ ee -> refl (PB.ptH W PB.e0) ;
  false -> \ ee -> refl (j (suc (Ar.dg m k t),Ar.dg-range m k t h)) } ;
 coord (t : Ar.Fin (suc (suc m))) :
  Id (Hom W PB.Iv) (tailC (suc m) W (Face[suc m,W,suc k,hk].faceC j) t) (Face[m,W,k,hk].faceC (tailC m W j) t) =
  vB t.1 t.2 (eqN t.1 k) (refl (eqN t.1 k)) ;
} ;
-- the LEFT face law of concatenation: for k <= m+1,
--   d_k (catC j i) = catC (d_k j) i     (same arity, no transport)
CFL (m n : Nat) (J : Ob) (k : Nat) (hk : IsT (leb k (suc m))) (j : Coords m J) (i : Coords n J) : U a =
 (t : Ar.Fin (suc (suc (Ar.plus m (suc n)))))
 -> Id (Hom J PB.Iv) (Face[Ar.plus m (suc n),J,k,hkB m n k hk].faceC (catC m n J j i) t)
     (catC (suc m) n J (Face[m,J,k,hk].faceC j) i t) ;
-- k = 0, any m
catFL0 (m n : Nat) (J : Ob) (hk : IsT (leb zero (suc m))) (j : Coords m J) (i : Coords n J) : CFL m n J zero hk j i = \ t ->
 Pa.trans (Hom J PB.Iv) _ (consC (Ar.plus m (suc n)) J (PB.ptH J PB.e0) (catC m n J j i) t) _
  (Pa.trans (Hom J PB.Iv) _ (Face[Ar.plus m (suc n),J,zero,refl true].faceC (catC m n J j i) t) _
    (FaceIrr[Ar.plus m (suc n),J,zero,hkB m n zero hk,refl true,catC m n J j i].coord t)
    (Pa.sym (Hom J PB.Iv) (consC (Ar.plus m (suc n)) J (PB.ptH J PB.e0) (catC m n J j i) t)
      (Face[Ar.plus m (suc n),J,zero,refl true].faceC (catC m n J j i) t)
      (ConsZero[Ar.plus m (suc n),J,catC m n J j i].coord t)))
  (consC-cong (Ar.plus m (suc n)) J (PB.ptH J PB.e0) (catC m n J j i)
    (catC m n J (tailC m J (Face[m,J,zero,hk].faceC j)) i)
    (catC-congL m n J j (tailC m J (Face[m,J,zero,hk].faceC j)) i
      (\ s -> Pa.ap (Ar.Fin (suc m)) (Hom J PB.Iv) j s (Ar.dg m zero (suc s.1),Ar.dg-range m zero (suc s.1) s.2)
        (fin-eq (suc m) s (Ar.dg m zero (suc s.1),Ar.dg-range m zero (suc s.1) s.2) (refl s.1))))
    t.1 t.2) ;
-- m = 0, k = 1
catFL01 (n : Nat) (J : Ob) (hk : IsT (leb (suc zero) (suc zero))) (j : Coords zero J) (i : Coords n J) : CFL zero n J (suc zero) hk j i = \ t ->
 Pa.trans (Hom J PB.Iv) _ (consC (suc n) J (headC zero J (Face[zero,J,suc zero,hk].faceC j)) (consC n J (PB.ptH J PB.e0) i) t) _
  (Pa.trans (Hom J PB.Iv) _ (consC (suc n) J (j (zero,refl true)) (consC n J (PB.ptH J PB.e0) i) t) _
    (Pa.trans (Hom J PB.Iv) _ (consC (suc n) J (j (zero,refl true)) (Face[n,J,zero,hkB zero n (suc zero) hk].faceC i) t) _
      (FaceCons[n,J,zero,hkB zero n (suc zero) hk,j (zero,refl true),i].coord t)
      (consC-cong (suc n) J (j (zero,refl true)) (Face[n,J,zero,hkB zero n (suc zero) hk].faceC i) (consC n J (PB.ptH J PB.e0) i)
        (\ s -> Pa.trans (Hom J PB.Iv) _ (Face[n,J,zero,refl true].faceC i s) _
          (FaceIrr[n,J,zero,hkB zero n (suc zero) hk,refl true,i].coord s)
          (Pa.sym (Hom J PB.Iv) (consC n J (PB.ptH J PB.e0) i s) (Face[n,J,zero,refl true].faceC i s) (ConsZero[n,J,i].coord s)))
        t.1 t.2))
    (consCongH (suc n) J (j (zero,refl true)) (headC zero J (Face[zero,J,suc zero,hk].faceC j)) (consC n J (PB.ptH J PB.e0) i)
      (Pa.ap (Ar.Fin (suc zero)) (Hom J PB.Iv) j (zero,refl true) (Ar.dg zero (suc zero) zero,Ar.dg-range zero (suc zero) zero (refl true))
        (fin-eq (suc zero) (zero,refl true) (Ar.dg zero (suc zero) zero,Ar.dg-range zero (suc zero) zero (refl true)) (refl zero)))
      t.1 t.2))
  (refl (catC (suc zero) n J (Face[zero,J,suc zero,hk].faceC j) i t)) ;
-- m+1, k+1, from the law at m
catFLs (m : Nat) (ih : (n : Nat) -> (J : Ob) -> (k : Nat) -> (hk : IsT (leb k (suc m))) -> (j : Coords m J) -> (i : Coords n J) -> CFL m n J k hk j i)
 (n : Nat) (J : Ob) (k : Nat) (hk : IsT (leb (suc k) (suc (suc m)))) (j : Coords (suc m) J) (i : Coords n J) : CFL (suc m) n J (suc k) hk j i = \ t ->
 Pa.trans (Hom J PB.Iv) _
  (consC (suc (Ar.plus m (suc n))) J (headC m J j) (catC (suc m) n J (Face[m,J,k,hk].faceC (tailC m J j)) i) t) _
  (Pa.trans (Hom J PB.Iv) _
    (consC (suc (Ar.plus m (suc n))) J (headC m J j) (Face[Ar.plus m (suc n),J,k,hkB (suc m) n (suc k) hk].faceC (catC m n J (tailC m J j) i)) t) _
    (FaceCons[Ar.plus m (suc n),J,k,hkB (suc m) n (suc k) hk,headC m J j,catC m n J (tailC m J j) i].coord t)
    (consC-cong (suc (Ar.plus m (suc n))) J (headC m J j)
      (Face[Ar.plus m (suc n),J,k,hkB (suc m) n (suc k) hk].faceC (catC m n J (tailC m J j) i))
      (catC (suc m) n J (Face[m,J,k,hk].faceC (tailC m J j)) i)
      (\ s -> Pa.trans (Hom J PB.Iv) _ (Face[Ar.plus m (suc n),J,k,hkB m n k hk].faceC (catC m n J (tailC m J j) i) s) _
        (FaceIrr[Ar.plus m (suc n),J,k,hkB (suc m) n (suc k) hk,hkB m n k hk,catC m n J (tailC m J j) i].coord s)
        (ih n J k hk (tailC m J j) i s))
      t.1 t.2))
  (Pa.sym (Hom J PB.Iv) (catC (suc (suc m)) n J (Face[suc m,J,suc k,hk].faceC j) i t)
    (consC (suc (Ar.plus m (suc n))) J (headC m J j) (catC (suc m) n J (Face[m,J,k,hk].faceC (tailC m J j)) i) t)
    (Pa.trans (Hom J PB.Iv) _
      (consC (suc (Ar.plus m (suc n))) J (headC m J j) (catC (suc m) n J (tailC (suc m) J (Face[suc m,J,suc k,hk].faceC j)) i) t) _
      (consCongH (suc (Ar.plus m (suc n))) J (headC (suc m) J (Face[suc m,J,suc k,hk].faceC j)) (headC m J j)
        (catC (suc m) n J (tailC (suc m) J (Face[suc m,J,suc k,hk].faceC j)) i)
        (Pa.ap (Ar.Fin (suc (suc m))) (Hom J PB.Iv) j (Ar.dg (suc m) (suc k) zero,Ar.dg-range (suc m) (suc k) zero (refl true)) (zero,refl true)
          (fin-eq (suc (suc m)) (Ar.dg (suc m) (suc k) zero,Ar.dg-range (suc m) (suc k) zero (refl true)) (zero,refl true) (refl zero)))
        t.1 t.2)
      (consC-cong (suc (Ar.plus m (suc n))) J (headC m J j)
        (catC (suc m) n J (tailC (suc m) J (Face[suc m,J,suc k,hk].faceC j)) i)
        (catC (suc m) n J (Face[m,J,k,hk].faceC (tailC m J j)) i)
        (catC-congL (suc m) n J (tailC (suc m) J (Face[suc m,J,suc k,hk].faceC j)) (Face[m,J,k,hk].faceC (tailC m J j)) i
          (TailFace[m,J,k,hk,j].coord))
        t.1 t.2))) ;
catFLz1 (n : Nat) (J : Ob) (j : Coords zero J) (i : Coords n J) : (k : Nat) -> (hk : IsT (leb (suc k) (suc zero))) -> CFL zero n J (suc k) hk j i = split {
 zero -> \ hk -> catFL01 n J hk j i ;
 suc k -> \ hk -> Pa.absurd (CFL zero n J (suc (suc k)) hk j i) (Pa.subst Bool Tb true false (Pa.sym Bool false true hk) tt) } ;
-- m = 0 by cases on k
catFLz (n : Nat) (J : Ob) (j : Coords zero J) (i : Coords n J) : (k : Nat) -> (hk : IsT (leb k (suc zero))) -> CFL zero n J k hk j i = split {
 zero -> \ hk -> catFL0 zero n J hk j i ;
 suc k -> catFLz1 n J j i k } ;
catFLsk (m : Nat) (ih : (n : Nat) -> (J : Ob) -> (k : Nat) -> (hk : IsT (leb k (suc m))) -> (j : Coords m J) -> (i : Coords n J) -> CFL m n J k hk j i)
 (n : Nat) (J : Ob) (j : Coords (suc m) J) (i : Coords n J) : (k : Nat) -> (hk : IsT (leb k (suc (suc m)))) -> CFL (suc m) n J k hk j i = split {
 zero -> \ hk -> catFL0 (suc m) n J hk j i ;
 suc k -> \ hk -> catFLs m ih n J k hk j i } ;
-- THE LEFT FACE LAW
catFL : (m : Nat) -> (n : Nat) -> (J : Ob) -> (k : Nat) -> (hk : IsT (leb k (suc m))) -> (j : Coords m J) -> (i : Coords n J) -> CFL m n J k hk j i = split {
 zero -> \ n J k hk j i -> catFLz n J j i k hk ;
 suc m | ih -> \ n J k hk j i -> catFLsk m ih n J j i k hk } ;
