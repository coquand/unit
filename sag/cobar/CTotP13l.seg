-- CTotP13l.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part l: the lift back bk.  The line Lb of D G . D B over the
-- constant line at d (its naturality: D's oPath and ivA-comp, as c2's
-- CTotPsi20), its base is the constant line by definition (tp), its end at
-- 1 is w = (d, b') (D's idPath, ptH-nat, u's end condition at 1) and its
-- end at 0 is D f a' (u's end condition at 0 and D f's values).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13l (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PJ = CTotP13j[a, vl, l].P13j[C, G, A, B, f] ;
 module PK = CTotP13k[a, vl, l].P13k[C, G, A, B, f] ;
 module PI = PJ.PI ;
 module PE = PI.PE ;
 module TR = PE.TR ;
 module G1 = TR.G1 ;
 module TC = PE.TC ;
 module DO = PE.DO ;
 module DF = PE.DF ;
 module H = PE.H ;
 module HD = PE.HD ;
 module DS = PI.DS ;
 module LMB = CTotL12m[a, vl, l].L12m[C, G, B] ;
 module LB = LMB.LB ;
 Obj (I : Ob) : U vl = PE.Obj I ;

 module BK (X : TC.TOb) (w : HD.TA.EI X) (u : DS.TOb' X.1 X.2 (PE.PR.phi X w)) {
  module BD = PI.BKd[X, w, u] ;
  ln : W0.Ix (PE.PO.FL.ob X) = BD.ln ;
  d : DF.D.Ob' X.1 X.2 = BD.d ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  bb (Wd : TC.TOb) (k : TC.THm Wd X) (j : PB.IvP Wd.1) : DF.DB.TOb' Wd.1 Wd.2 (ln.1 Wd k j) =
   (BD.AB[Wd, k, j].bfam, PJ.AN[X, w, u, Wd, k, j].anat, PK.FT[X, w, u, Wd, k, j].aface, PK.FT[X, w, u, Wd, k, j].atop) ;
  Lv (Wd : TC.TOb) (k : TC.THm Wd X) (j : PB.IvP Wd.1) : LMB.Tot Wd = (ln.1 Wd k j, bb Wd k j) ;
  module NL (V' W : TC.TOb) (h : TC.THm V' W) (k : TC.THm W X) (j : PB.IvP W.1) {
   kh : TC.THm V' X = TC.tcomp V' W X k h ;
   jh : PB.IvP V'.1 = PB.ivA V'.1 W.1 h.1 j ;
   module RD (q : DO.Idx V'.1 V'.2) (lq : DO.LandsI V'.1 V'.2 q) {
    rqh : DO.Idx W.1 W.2 = DF.D.Act[V'.1, W.1, h.1, V'.2, W.2, h.2, (ln.1 W k j)].rq q ;
    module R1 = BD.AB[W, k, j].RQ[rqh, lq] ;
    module R2 = BD.AB[V', kh, jh].RQ[q, lq] ;
    Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
    lineAt (sw : DF.D.S I x q.1 q.2.1 q.2.2.2.1) (jj : PB.IvP q.2.1) : H.TA.EI Y =
     (BD.lineE (q.1, q.2.1, sw.1, q.2.2.2.1, sw.2, q.2.2.2.2.2) lq).1 Y (TC.tid Y) jj ;
    law : Id (DF.DB.Ez q.2.1 q.2.2.2.1) (LB.rdT V' (LB.EE.act V' W h (Lv W k j)) q lq) (LB.rdT V' (Lv V' kh jh) q lq) =
     transH (LB.actRd V' W h (Lv W k j) q lq)
      (transH R1.beq
        (transH (apH {DF.D.S I x q.1 q.2.1 q.2.2.2.1} {H.TA.EI Y} (\ sw -> lineAt sw R1.RC.j0)
                   (DF.D.oPath V'.1 W.1 I k.1 h.1 V'.2 W.2 x k.2 h.2 q))
          (transH (apH {PB.IvP q.2.1} {H.TA.EI Y} (\ jj -> lineAt (R2.RC.U0, R2.RC.cc) jj)
                     (symH (PB.ivA-comp q.2.1 V'.1 W.1 h.1 q.2.2.1 j)))
            (symH R2.beq)))) ;
   } ;
   law : Id (LMB.Tot V') (LB.EE.act V' W h (Lv W k j)) (Lv V' kh jh) =
    LMB.totEq V' (LB.EE.act V' W h (Lv W k j)) (Lv V' kh jh) (ln.2 V' W h k j) (\ q lq -> RD[q, lq].law) ;
  } ;
  Lb : W0.Ix (PE.FTd.FE.ob X) = (\ W k j -> Lv W k j, \ V' W h k j -> NL[V', W, h, k, j].law) ;
  -- the ends
  module ED (e : G1.GB.IPt) (q : DO.Idx I x) (lq : DO.LandsI I x q) {
   pe : PB.IvP I = G1.GB.ptH X e ;
   module R = BD.AB[X, TC.tid X, pe].RQ[q, lq] ;
   Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
   lineAt (sw : DF.D.S I x q.1 q.2.1 q.2.2.2.1) : H.TA.EI Y =
    (BD.lineE (q.1, q.2.1, sw.1, q.2.2.2.1, sw.2, q.2.2.2.2.2) lq).1 Y (TC.tid Y) R.RC.j0 ;
   law : Id (H.TA.EI Y) (LB.rdT X (Lv X (TC.tid X) pe) q lq) ((BD.lineE q lq).1 Y (TC.tid Y) (G1.GB.ptH Y e)) =
    transH R.beq
     (transH (apH {DF.D.S I x q.1 q.2.1 q.2.2.2.1} {H.TA.EI Y} lineAt (DF.D.idPath I x q))
       (apH {PB.IvP q.2.1} {H.TA.EI Y} (\ jj -> (BD.lineE q lq).1 Y (TC.tid Y) jj) (PB.ptH-nat q.2.1 I q.2.2.1 e))) ;
  } ;
  aw : HD.TB.EI X = HD.TB.pr X d BD.a' ;
  end0 : Id (LMB.Tot X) (Lv X (TC.tid X) (G1.GB.ptH X G1.GB.e0)) (DF.Df.mE X aw) =
   LMB.totEq X (Lv X (TC.tid X) (G1.GB.ptH X G1.GB.e0)) (DF.Df.mE X aw) (PE.PO.DG.act-id X d)
    (\ q lq -> transH ED[G1.GB.e0, q, lq].law
       (transH (u.1 q lq).2.2.2.1 (symH (DF.DM[I, x, d, BD.a'].pc q lq)))) ;
  end1 : Id (LMB.Tot X) (Lv X (TC.tid X) (G1.GB.ptH X G1.GB.e1)) w =
   LMB.totEq X (Lv X (TC.tid X) (G1.GB.ptH X G1.GB.e1)) w (PE.PO.DG.act-id X d)
    (\ q lq -> transH ED[G1.GB.e1, q, lq].law (u.1 q lq).2.2.2.2) ;
  path : W0.Ix (HD.PE.tobP X (HD.TAB.pr X w BD.a')) =
   HD.PE.mkPath X (HD.TAB.pr X w BD.a') (\ W k j -> Lb.1 W k j) (\ V' W h k j -> Lb.2 V' W h k j)
    (\ W k j -> refl (ln.1 W k j)) end0 end1 ;
  bk : W0.Ix (HD.FibT.tob X w) = (BD.a', path) ;
 } ;
} ;
