-- CTrLF5.seg (canonicity-c2; SAG 8.3, location-free truncation, part 5):
-- rebasing composes: along tau : E -> D after s : D -> G (family maps psi,
-- chi) is rebasing along s . tau with the composite family map, on normal
-- forms (by recursion on the tree).
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[a+] ; open PR.PS ;
module W = V[a+] ;
module L = PR.PS ;
module Cmp (E D G : PCtx) (s : PSub[D, G]) (tau : PSub[E, D]) (A : PTy[G]) (B : PTy[D]) (psi : (X : Ob) (d : W.Ix (D.ob X)) -> W.Ix (A.tob X (s.nt X d)) -> W.Ix (B.tob X d)) (psiN : (J I : Ob) (f : Hom J I) (d : W.Ix (D.ob I)) (d' : W.Ix (D.ob J)) (e : Id (W.Ix (D.ob J)) (D.act J I f d) d') (v : W.Ix (A.tob I (s.nt I d))) -> Id (W.Ix (B.tob J d')) (B.tact J I f d d' e (psi I d v)) (psi J d' (A.tact J I f (s.nt I d) (s.nt J d') (ntEq D G s J I f d d' e) v))) (Cc : PTy[E]) (chi : (X : Ob) (d : W.Ix (E.ob X)) -> W.Ix (B.tob X (tau.nt X d)) -> W.Ix (Cc.tob X d)) (chiN : (J I : Ob) (f : Hom J I) (d : W.Ix (E.ob I)) (d' : W.Ix (E.ob J)) (e : Id (W.Ix (E.ob J)) (E.act J I f d) d') (v : W.Ix (B.tob I (tau.nt I d))) -> Id (W.Ix (Cc.tob J d')) (Cc.tact J I f d d' e (chi I d v)) (chi J d' (B.tact J I f (tau.nt I d) (tau.nt J d') (ntEq E D tau J I f d d' e) v))) {
 st : PSub[E, G] = oS E D G s tau ;
 om (X : Ob) (x : W.Ix (E.ob X)) (v : W.Ix (A.tob X (st.nt X x))) : W.Ix (Cc.tob X x) = chi X x (psi X (tau.nt X x) v) ;
 omN (J I : Ob) (f : Hom J I) (x : W.Ix (E.ob I)) (x' : W.Ix (E.ob J)) (e : Id (W.Ix (E.ob J)) (E.act J I f x) x') (v : W.Ix (A.tob I (st.nt I x)))
   : Id (W.Ix (Cc.tob J x')) (Cc.tact J I f x x' e (om I x v)) (om J x' (A.tact J I f (st.nt I x) (st.nt J x') (ntEq E G st J I f x x' e) v)) =
  transH (chiN J I f x x' e (psi I (tau.nt I x) v))
   (apH {W.Ix (B.tob J (tau.nt J x'))} {W.Ix (Cc.tob J x')} (chi J x')
     (transH (psiN J I f (tau.nt I x) (tau.nt J x') (ntEq E D tau J I f x x' e) v)
       (apH {W.Ix (A.tob J (st.nt J x'))} {W.Ix (B.tob J (tau.nt J x'))} (psi J (tau.nt J x'))
          (L.tact-irr G A J I f (st.nt I x) (st.nt J x') (ntEq D G s J I f (tau.nt I x) (tau.nt J x') (ntEq E D tau J I f x x' e)) (ntEq E G st J I f x x' e) v)))) ;
 module Gs = CTrLF4[a].G4[D, G, s, A, B, psi, psiN] ;
 module Gt = CTrLF4[a].G4[E, D, tau, B, Cc, chi, chiN] ;
 module Gst = CTrLF4[a].G4[E, G, st, A, Cc, om, omN] ;
 module BG = Gs.BG ;
 module BD = Gs.BD ;
 module BE = Gt.BD ;
 module LE = CTruncLaws[a, a+].Laws[E, Cc] ;
 slT (x : BE.Loc) : BD.Loc = (x.1, tau.nt x.1 x.2) ;
 slS (d : BD.Loc) : BG.Loc = (d.1, s.nt d.1 d.2) ;
 Mot (t : BG.Raw) : U a++ = (good : BG.Good t) (x : BE.Loc) (e : Id BG.Loc (BG.root t) (slS (slT x)))
   (g1 : BD.Good (Gs.RB.rb t good (slT x) e)) (e1 : Id BD.Loc (BD.root (Gs.RB.rb t good (slT x) e)) (slT x))
   -> Id BE.Raw (Gt.RB.rb (Gs.RB.rb t good (slT x) e) g1 x e1) (Gst.RB.rb t good x e) ;
 -- arrows of the children agree
 kT (x r2 : BE.Loc) (e1 : Id BD.Loc (slT x) (slT x)) (h2 : BE.Arr r2 x) : BD.Arr (slT r2) (slT x) =
  Gt.RB.tA (slT r2) (slT x) (slT x) (symH e1) (Gt.RB.arrS r2 x h2) ;
 kEq (z : BG.Loc) (x r2 : BE.Loc) (e : Id BG.Loc z (slS (slT x))) (e1 : Id BD.Loc (slT x) (slT x)) (h2 : BE.Arr r2 x)
   : Id (BG.Arr (slS (slT r2)) z) (Gs.RB.tA (slS (slT r2)) (slS (slT x)) z (symH e) (Gs.RB.arrS (slT r2) (slT x) (kT x r2 e1 h2)))
        (Gst.RB.tA (slS (slT r2)) (slS (slT x)) z (symH e) (Gst.RB.arrS r2 x h2)) =
  apH {BG.Arr (slS (slT r2)) (slS (slT x))} {BG.Arr (slS (slT r2)) z} (\ c -> Gs.RB.tA (slS (slT r2)) (slS (slT x)) z (symH e) c)
   (BG.arr-eq (slS (slT r2)) (slS (slT x)) (Gs.RB.arrS (slT r2) (slT x) (kT x r2 e1 h2)) (Gst.RB.arrS r2 x h2)
     (apH {BD.Arr (slT r2) (slT x)} {Hom r2.1 x.1} (\ c -> c.1) (Gt.RB.tAloop (slT r2) (slT x) (symH e1) (Gt.RB.arrS r2 x h2)))) ;
 module NC (z : BG.Loc) (Q : PB.Phi z.1) (u : (q : BG.Loc) -> BG.Arr q z -> BG.Raw) (w : (q : BG.Loc) (h : BG.Arr q z) -> PB.Lands q.1 z.1 Q h.1 -> BG.Raw)
   (cu : (q : BG.Loc) (h : BG.Arr q z) -> Mot (u q h)) (cw : (q : BG.Loc) (h : BG.Arr q z) (i : PB.Lands q.1 z.1 Q h.1) -> Mot (w q h i))
   (good : BG.Good (node z Q u w)) (x : BE.Loc) (e : Id BG.Loc z (slS (slT x)))
   (g1 : BD.Good (Gs.RB.rb (node z Q u w) good (slT x) e)) (e1 : Id BD.Loc (slT x) (slT x)) {
  dT : BD.Loc = slT x ;
  Qd : PB.Phi x.1 = Gs.RB.tQ z (slS dT) e Q ;
  aL (r2 : BE.Loc) (h2 : BE.Arr r2 x) : BG.Arr (slS (slT r2)) z = Gs.RB.tA (slS (slT r2)) (slS dT) z (symH e) (Gs.RB.arrS (slT r2) dT (kT x r2 e1 h2)) ;
  aR (r2 : BE.Loc) (h2 : BE.Arr r2 x) : BG.Arr (slS (slT r2)) z = Gst.RB.tA (slS (slT r2)) (slS dT) z (symH e) (Gst.RB.arrS r2 x h2) ;
  uL (r2 : BE.Loc) (h2 : BE.Arr r2 x) : BE.Raw =
   Gt.RB.rb (Gs.RB.rb (u (slS (slT r2)) (aL r2 h2)) (good.2.1 (slS (slT r2)) (aL r2 h2)).1 (slT r2) (good.2.1 (slS (slT r2)) (aL r2 h2)).2)
    (g1.2.1 (slT r2) (kT x r2 e1 h2)).1 r2 (g1.2.1 (slT r2) (kT x r2 e1 h2)).2 ;
  uR (r2 : BE.Loc) (h2 : BE.Arr r2 x) : BE.Raw =
   Gst.RB.rb (u (slS (slT r2)) (aR r2 h2)) (good.2.1 (slS (slT r2)) (aR r2 h2)).1 r2 (good.2.1 (slS (slT r2)) (aR r2 h2)).2 ;
  eu (r2 : BE.Loc) (h2 : BE.Arr r2 x) : Id BE.Raw (uL r2 h2) (uR r2 h2) =
   transH (cu (slS (slT r2)) (aL r2 h2) (good.2.1 (slS (slT r2)) (aL r2 h2)).1 r2 (good.2.1 (slS (slT r2)) (aL r2 h2)).2
             (g1.2.1 (slT r2) (kT x r2 e1 h2)).1 (g1.2.1 (slT r2) (kT x r2 e1 h2)).2)
    (Gst.RB.rbCong (u (slS (slT r2)) (aL r2 h2)) (u (slS (slT r2)) (aR r2 h2))
       (apH {BG.Arr (slS (slT r2)) z} {BG.Raw} (\ c -> u (slS (slT r2)) c) (kEq z x r2 e e1 h2))
       (good.2.1 (slS (slT r2)) (aL r2 h2)).1 (good.2.1 (slS (slT r2)) (aR r2 h2)).1 r2
       (good.2.1 (slS (slT r2)) (aL r2 h2)).2 (good.2.1 (slS (slT r2)) (aR r2 h2)).2) ;
  QL : PB.Phi x.1 = Gt.RB.tQ dT dT e1 Qd ;
  iD (r2 : BE.Loc) (h2 : BE.Arr r2 x) (i : PB.Lands r2.1 x.1 QL h2.1) : PB.Lands r2.1 x.1 Qd (kT x r2 e1 h2).1 =
   Gt.RB.tL (slT r2) dT dT e1 Qd (Gt.RB.arrS r2 x h2) i ;
  iG (r2 : BE.Loc) (h2 : BE.Arr r2 x) (i : PB.Lands r2.1 x.1 QL h2.1) : PB.Lands r2.1 z.1 Q (aL r2 h2).1 =
   Gs.RB.tL (slS (slT r2)) z (slS dT) e Q (Gs.RB.arrS (slT r2) dT (kT x r2 e1 h2)) (iD r2 h2 i) ;
  jG (r2 : BE.Loc) (h2 : BE.Arr r2 x) (j : PB.Lands r2.1 x.1 Qd h2.1) : PB.Lands r2.1 z.1 Q (aR r2 h2).1 =
   Gst.RB.tL (slS (slT r2)) z (slS dT) e Q (Gst.RB.arrS r2 x h2) j ;
  wL (r2 : BE.Loc) (h2 : BE.Arr r2 x) (i : PB.Lands r2.1 x.1 QL h2.1) : BE.Raw =
   Gt.RB.rb (Gs.RB.rb (w (slS (slT r2)) (aL r2 h2) (iG r2 h2 i)) (good.2.2.1 (slS (slT r2)) (aL r2 h2) (iG r2 h2 i)).1 (slT r2) (good.2.2.1 (slS (slT r2)) (aL r2 h2) (iG r2 h2 i)).2)
    (g1.2.2.1 (slT r2) (kT x r2 e1 h2) (iD r2 h2 i)).1 r2 (g1.2.2.1 (slT r2) (kT x r2 e1 h2) (iD r2 h2 i)).2 ;
  wR (r2 : BE.Loc) (h2 : BE.Arr r2 x) (j : PB.Lands r2.1 x.1 Qd h2.1) : BE.Raw =
   Gst.RB.rb (w (slS (slT r2)) (aR r2 h2) (jG r2 h2 j)) (good.2.2.1 (slS (slT r2)) (aR r2 h2) (jG r2 h2 j)).1 r2 (good.2.2.1 (slS (slT r2)) (aR r2 h2) (jG r2 h2 j)).2 ;
  ev (r2 : BE.Loc) (h2 : BE.Arr r2 x) (i : PB.Lands r2.1 x.1 QL h2.1) (j : PB.Lands r2.1 x.1 Qd h2.1) : Id BE.Raw (wL r2 h2 i) (wR r2 h2 j) =
   transH (cw (slS (slT r2)) (aL r2 h2) (iG r2 h2 i) (good.2.2.1 (slS (slT r2)) (aL r2 h2) (iG r2 h2 i)).1 r2 (good.2.2.1 (slS (slT r2)) (aL r2 h2) (iG r2 h2 i)).2
             (g1.2.2.1 (slT r2) (kT x r2 e1 h2) (iD r2 h2 i)).1 (g1.2.2.1 (slT r2) (kT x r2 e1 h2) (iD r2 h2 i)).2)
    (Gst.RB.rbCong (w (slS (slT r2)) (aL r2 h2) (iG r2 h2 i)) (w (slS (slT r2)) (aR r2 h2) (jG r2 h2 j))
       (BG.boundary-cong z Q w (slS (slT r2)) (aL r2 h2) (aR r2 h2) (kEq z x r2 e e1 h2) (iG r2 h2 i) (jG r2 h2 j))
       (good.2.2.1 (slS (slT r2)) (aL r2 h2) (iG r2 h2 i)).1 (good.2.2.1 (slS (slT r2)) (aR r2 h2) (jG r2 h2 j)).1 r2
       (good.2.2.1 (slS (slT r2)) (aL r2 h2) (iG r2 h2 i)).2 (good.2.2.1 (slS (slT r2)) (aR r2 h2) (jG r2 h2 j)).2) ;
  res : Id BE.Raw (Gt.RB.rb (Gs.RB.rb (node z Q u w) good dT e) g1 x e1) (Gst.RB.rb (node z Q u w) good x e) =
   LE.node-cong x QL Qd (Gt.RB.tQloop dT e1 Qd) uL uR wL wR eu ev ;
 } ;
 cmpRb : (t : BG.Raw) -> Mot t = split {
  leaf z v -> \ good x e g1 e1 ->
   apH {W.Ix (B.tob x.1 (tau.nt x.1 x.2))} {BE.Raw} (\ c -> leaf x (chi x.1 x.2 c))
    (Gt.RB.tVloop (slT x) e1 (psi x.1 (tau.nt x.1 x.2) (Gs.RB.tV z (slS (slT x)) e v))) ;
  node z Q u w | cu cw -> \ good x e g1 e1 -> NC[z, Q, u, w, cu, cw, good, x, e, g1, e1].res } ;
} ;
