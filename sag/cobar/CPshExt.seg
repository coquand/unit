-- CPshExt.seg (canonicity-45; (B) stage 1(i), COBAR.md): record
-- extensionality and set-ness for the C-presheaf records of CPshC
-- (CSub, CEl, CTy): the base's sub-ext / el-ext / ty paths at each x,
-- with the C-laws propositional (identities in sets).  Used by every
-- later stage of the CwF of C-presheaves.
--   csub-ext, isSet-CSub    a C-substitution is determined by its values
--   cel-ext, isSet-CEl      a C-element by its values
--   cty-ext2, isSet-CTy     a C-type by its types at each x (a path P x)
--                           and its actions on totals, compared along P
--   tyTr-same               transport of a total along a path of types
--                           whose object parts are equal is the fibre
--                           transport along that equality (TOb is a set)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;

module ExtOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 open P ;

 ------------------------------------------------------------------
 -- C-substitutions

 SbF (D G : CCtx) : U l+ = (x : CO) -> PSub[D.ob x, G.ob x] ;
 SbNat (D G : CCtx) (sb : SbF D G) : U l+ =
  (y x : CO) (f : CH y x) (X : Ob) (d : W0.Ix ((D.ob x).ob X))
  -> Id (W0.Ix ((G.ob y).ob X)) ((sb y).nt X ((D.act y x f).nt X d)) ((G.act y x f).nt X ((sb x).nt X d)) ;
 mkCSub (D G : CCtx) (sb : SbF D G) (nn : SbNat D G sb) : CSub[D, G] = new CSub[D, G, sb, nn] ;
 csub-eta (D G : CCtx) : (s : CSub[D, G]) -> Id (CSub[D, G]) s (mkCSub D G s.sb s.sb-nat) =
  split { CSub n k -> refl (mkCSub D G n k) } ;
 sbNat-prop (D G : CCtx) (sb : SbF D G) : isProp (SbNat D G sb) =
  isProp-Pi CO (\ y -> (x : CO) (f : CH y x) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) -> Id (W0.Ix ((G.ob y).ob X)) ((sb y).nt X ((D.act y x f).nt X d)) ((G.act y x f).nt X ((sb x).nt X d))) (\ y ->
  isProp-Pi CO (\ x -> (f : CH y x) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) -> Id (W0.Ix ((G.ob y).ob X)) ((sb y).nt X ((D.act y x f).nt X d)) ((G.act y x f).nt X ((sb x).nt X d))) (\ x ->
  isProp-Pi (CH y x) (\ f -> (X : Ob) (d : W0.Ix ((D.ob x).ob X)) -> Id (W0.Ix ((G.ob y).ob X)) ((sb y).nt X ((D.act y x f).nt X d)) ((G.act y x f).nt X ((sb x).nt X d))) (\ f ->
  isProp-Pi Ob (\ X -> (d : W0.Ix ((D.ob x).ob X)) -> Id (W0.Ix ((G.ob y).ob X)) ((sb y).nt X ((D.act y x f).nt X d)) ((G.act y x f).nt X ((sb x).nt X d))) (\ X ->
  isProp-Pi (W0.Ix ((D.ob x).ob X)) (\ d -> Id (W0.Ix ((G.ob y).ob X)) ((sb y).nt X ((D.act y x f).nt X d)) ((G.act y x f).nt X ((sb x).nt X d))) (\ d ->
  W0.isSetIx ((G.ob y).ob X) ((sb y).nt X ((D.act y x f).nt X d)) ((G.act y x f).nt X ((sb x).nt X d))))))) ;
 csub-ext (D G : CCtx) (s t : CSub[D, G])
  (H : (x : CO) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) -> Id (W0.Ix ((G.ob x).ob X)) ((s.sb x).nt X d) ((t.sb x).nt X d))
  : Id (CSub[D, G]) s t =
  transH (csub-eta D G s)
   (transH (idJ (SbF D G) s.sb (\ n1 P1 -> (k1 : SbNat D G n1) -> Id (CSub[D, G]) (mkCSub D G s.sb s.sb-nat) (mkCSub D G n1 k1))
             (\ k1 -> apH (\ k2 -> mkCSub D G s.sb k2) (sbNat-prop D G s.sb s.sb-nat k1))
             t.sb (funext CO (\ x -> PSub[D.ob x, G.ob x]) s.sb t.sb (\ x -> sub-ext (D.ob x) (G.ob x) (s.sb x) (t.sb x) (H x))) t.sb-nat)
     (symH (csub-eta D G t))) ;
 isSet-CSub (D G : CCtx) : isSet (CSub[D, G]) =
  isSet-retract (CSub[D, G]) ((sb : SbF D G) * SbNat D G sb) (\ s -> (s.sb, s.sb-nat)) (\ w -> mkCSub D G w.1 w.2)
   (\ s -> symH (csub-eta D G s))
   (isSet-Sigma (SbF D G) (SbNat D G) (isSet-Pi CO (\ x -> PSub[D.ob x, G.ob x]) (\ x -> isSet-PSub (D.ob x) (G.ob x)))
     (\ sb -> prop-to-set (SbNat D G sb) (sbNat-prop D G sb))) ;

 ------------------------------------------------------------------
 -- C-elements

 ElF (G : CCtx) (A : CTy[G]) : U l+ = (x : CO) -> PEl[G.ob x, A.ty x] ;
 ElNatC (G : CCtx) (A : CTy[G]) (el : ElF G A) : U l+ =
  (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X))
  -> Id (SigT (G.ob y) (A.ty y) X) ((A.tE y x f).nt X (pairE (G.ob x) (A.ty x) X g ((el x).eob X g)))
       (pairE (G.ob y) (A.ty y) X ((G.act y x f).nt X g) ((el y).eob X ((G.act y x f).nt X g))) ;
 mkCEl (G : CCtx) (A : CTy[G]) (el : ElF G A) (nn : ElNatC G A el) : CEl[G, A] = new CEl[G, A, el, nn] ;
 cel-eta (G : CCtx) (A : CTy[G]) : (a : CEl[G, A]) -> Id (CEl[G, A]) a (mkCEl G A a.el a.el-nat) =
  split { CEl n k -> refl (mkCEl G A n k) } ;
 elNatC-prop (G : CCtx) (A : CTy[G]) (el : ElF G A) : isProp (ElNatC G A el) =
  isProp-Pi CO (\ y -> (x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) -> Id (SigT (G.ob y) (A.ty y) X) ((A.tE y x f).nt X (pairE (G.ob x) (A.ty x) X g ((el x).eob X g))) (pairE (G.ob y) (A.ty y) X ((G.act y x f).nt X g) ((el y).eob X ((G.act y x f).nt X g)))) (\ y ->
  isProp-Pi CO (\ x -> (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) -> Id (SigT (G.ob y) (A.ty y) X) ((A.tE y x f).nt X (pairE (G.ob x) (A.ty x) X g ((el x).eob X g))) (pairE (G.ob y) (A.ty y) X ((G.act y x f).nt X g) ((el y).eob X ((G.act y x f).nt X g)))) (\ x ->
  isProp-Pi (CH y x) (\ f -> (X : Ob) (g : W0.Ix ((G.ob x).ob X)) -> Id (SigT (G.ob y) (A.ty y) X) ((A.tE y x f).nt X (pairE (G.ob x) (A.ty x) X g ((el x).eob X g))) (pairE (G.ob y) (A.ty y) X ((G.act y x f).nt X g) ((el y).eob X ((G.act y x f).nt X g)))) (\ f ->
  isProp-Pi Ob (\ X -> (g : W0.Ix ((G.ob x).ob X)) -> Id (SigT (G.ob y) (A.ty y) X) ((A.tE y x f).nt X (pairE (G.ob x) (A.ty x) X g ((el x).eob X g))) (pairE (G.ob y) (A.ty y) X ((G.act y x f).nt X g) ((el y).eob X ((G.act y x f).nt X g)))) (\ X ->
  isProp-Pi (W0.Ix ((G.ob x).ob X)) (\ g -> Id (SigT (G.ob y) (A.ty y) X) ((A.tE y x f).nt X (pairE (G.ob x) (A.ty x) X g ((el x).eob X g))) (pairE (G.ob y) (A.ty y) X ((G.act y x f).nt X g) ((el y).eob X ((G.act y x f).nt X g)))) (\ g ->
  W0.isSetIx (SigE (G.ob y) (A.ty y).tob X) ((A.tE y x f).nt X (pairE (G.ob x) (A.ty x) X g ((el x).eob X g))) (pairE (G.ob y) (A.ty y) X ((G.act y x f).nt X g) ((el y).eob X ((G.act y x f).nt X g)))))))) ;
 cel-ext (G : CCtx) (A : CTy[G]) (a b : CEl[G, A])
  (H : (x : CO) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) -> Id (W0.Ix ((A.ty x).tob X g)) ((a.el x).eob X g) ((b.el x).eob X g))
  : Id (CEl[G, A]) a b =
  transH (cel-eta G A a)
   (transH (idJ (ElF G A) a.el (\ n1 P1 -> (k1 : ElNatC G A n1) -> Id (CEl[G, A]) (mkCEl G A a.el a.el-nat) (mkCEl G A n1 k1))
             (\ k1 -> apH (\ k2 -> mkCEl G A a.el k2) (elNatC-prop G A a.el a.el-nat k1))
             b.el (funext CO (\ x -> PEl[G.ob x, A.ty x]) a.el b.el (\ x -> el-ext (G.ob x) (A.ty x) (a.el x) (b.el x) (H x))) b.el-nat)
     (symH (cel-eta G A b))) ;
 isSet-CEl (G : CCtx) (A : CTy[G]) : isSet (CEl[G, A]) =
  isSet-retract (CEl[G, A]) ((el : ElF G A) * ElNatC G A el) (\ a -> (a.el, a.el-nat)) (\ w -> mkCEl G A w.1 w.2)
   (\ a -> symH (cel-eta G A a))
   (isSet-Sigma (ElF G A) (ElNatC G A) (isSet-Pi CO (\ x -> PEl[G.ob x, A.ty x]) (\ x -> isSet-PEl (G.ob x) (A.ty x)))
     (\ el -> prop-to-set (ElNatC G A el) (elNatC-prop G A el))) ;

 ------------------------------------------------------------------
 -- C-types

 TyF (G : CCtx) : U l+ = (x : CO) -> PTy[G.ob x] ;
 TEF (G : CCtx) (ty : TyF G) : U l+ = (y x : CO) (f : CH y x) -> PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y)] ;
 LPt (G : CCtx) (ty : TyF G) (tE : TEF G ty) : U l+ =
  (y x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (ty x) X)
  -> Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (ty y) X ((tE y x f).nt X w)) ((G.act y x f).nt X (fstE (G.ob x) (ty x) X w)) ;
 LId (G : CCtx) (ty : TyF G) (tE : TEF G ty) : U l+ =
  (x : CO) (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob x) (ty x) X) ((tE x x (cid x)).nt X w) w ;
 LO (G : CCtx) (ty : TyF G) (tE : TEF G ty) : U l+ =
  (z y x : CO) (f : CH y x) (h : CH z y) (X : Ob) (w : SigT (G.ob x) (ty x) X)
  -> Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w)) ;
 mkCTy (G : CCtx) (ty : TyF G) (tE : TEF G ty) (lp : LPt G ty tE) (li : LId G ty tE) (lo : LO G ty tE) : CTy[G] =
  new CTy[G, ty, tE, lp, li, lo] ;
 cty-eta (G : CCtx) : (A : CTy[G]) -> Id (CTy[G]) A (mkCTy G A.ty A.tE A.tE-pt A.tE-id A.tE-o) =
  split { CTy a b c d e -> refl (mkCTy G a b c d e) } ;
 lpt-prop (G : CCtx) (ty : TyF G) (tE : TEF G ty) : isProp (LPt G ty tE) =
  isProp-Pi CO (\ y -> (x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (ty y) X ((tE y x f).nt X w)) ((G.act y x f).nt X (fstE (G.ob x) (ty x) X w))) (\ y ->
  isProp-Pi CO (\ x -> (f : CH y x) (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (ty y) X ((tE y x f).nt X w)) ((G.act y x f).nt X (fstE (G.ob x) (ty x) X w))) (\ x ->
  isProp-Pi (CH y x) (\ f -> (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (ty y) X ((tE y x f).nt X w)) ((G.act y x f).nt X (fstE (G.ob x) (ty x) X w))) (\ f ->
  isProp-Pi Ob (\ X -> (w : SigT (G.ob x) (ty x) X) -> Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (ty y) X ((tE y x f).nt X w)) ((G.act y x f).nt X (fstE (G.ob x) (ty x) X w))) (\ X ->
  isProp-Pi (SigT (G.ob x) (ty x) X) (\ w -> Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (ty y) X ((tE y x f).nt X w)) ((G.act y x f).nt X (fstE (G.ob x) (ty x) X w))) (\ w ->
  W0.isSetIx ((G.ob y).ob X) (fstE (G.ob y) (ty y) X ((tE y x f).nt X w)) ((G.act y x f).nt X (fstE (G.ob x) (ty x) X w))))))) ;
 lid-prop (G : CCtx) (ty : TyF G) (tE : TEF G ty) : isProp (LId G ty tE) =
  isProp-Pi CO (\ x -> (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob x) (ty x) X) ((tE x x (cid x)).nt X w) w) (\ x ->
  isProp-Pi Ob (\ X -> (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob x) (ty x) X) ((tE x x (cid x)).nt X w) w) (\ X ->
  isProp-Pi (SigT (G.ob x) (ty x) X) (\ w -> Id (SigT (G.ob x) (ty x) X) ((tE x x (cid x)).nt X w) w) (\ w ->
  W0.isSetIx (SigE (G.ob x) (ty x).tob X) ((tE x x (cid x)).nt X w) w))) ;
 lo-prop (G : CCtx) (ty : TyF G) (tE : TEF G ty) : isProp (LO G ty tE) =
  isProp-Pi CO (\ z -> (y x : CO) (f : CH y x) (h : CH z y) (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w))) (\ z ->
  isProp-Pi CO (\ y -> (x : CO) (f : CH y x) (h : CH z y) (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w))) (\ y ->
  isProp-Pi CO (\ x -> (f : CH y x) (h : CH z y) (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w))) (\ x ->
  isProp-Pi (CH y x) (\ f -> (h : CH z y) (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w))) (\ f ->
  isProp-Pi (CH z y) (\ h -> (X : Ob) (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w))) (\ h ->
  isProp-Pi Ob (\ X -> (w : SigT (G.ob x) (ty x) X) -> Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w))) (\ X ->
  isProp-Pi (SigT (G.ob x) (ty x) X) (\ w -> Id (SigT (G.ob z) (ty z) X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w))) (\ w ->
  W0.isSetIx (SigE (G.ob z) (ty z).tob X) ((tE z x (co z y x f h)).nt X w) ((tE z y h).nt X ((tE y x f).nt X w))))))))) ;

 -- the laws are propositions: two C-types with the same ty and tE are equal
 cty-laws (G : CCtx) (ty : TyF G) (tE : TEF G ty) (lp lp' : LPt G ty tE) (li li' : LId G ty tE) (lo lo' : LO G ty tE)
  : Id (CTy[G]) (mkCTy G ty tE lp li lo) (mkCTy G ty tE lp' li' lo') =
  transH (apH (\ u -> mkCTy G ty tE u li lo) (lpt-prop G ty tE lp lp'))
   (transH (apH (\ u -> mkCTy G ty tE lp' u lo) (lid-prop G ty tE li li'))
     (apH (\ u -> mkCTy G ty tE lp' li' u) (lo-prop G ty tE lo lo'))) ;

 -- transport of a total along a path of types: along the path of their
 -- object parts (TOb is a set)
 totTr (G : PCtx) (T T' : PTy[G]) (Pq : Id (PTy[G]) T T') (X : Ob) (w : SigT G T X)
  : Id (SigT G T' X) (subst (PTy[G]) (\ T2 -> SigT G T2 X) T T' Pq w)
       (pairE G T' X (fstE G T X w) (subst (TOb G) (\ o -> W0.Ix (o X (fstE G T X w))) T.tob T'.tob (apH (\ T2 -> T2.tob) Pq) (sndE G T X w))) =
  idJ (PTy[G]) T (\ T2 P2 -> Id (SigT G T2 X) (subst (PTy[G]) (\ T3 -> SigT G T3 X) T T2 P2 w)
                     (pairE G T2 X (fstE G T X w) (subst (TOb G) (\ o -> W0.Ix (o X (fstE G T X w))) T.tob T2.tob (apH (\ T3 -> T3.tob) P2) (sndE G T X w))))
   (refl w) T' Pq ;
 tyTr-same (G : PCtx) (T T' : PTy[G]) (Pq : Id (PTy[G]) T T') (same : Id (TOb G) T.tob T'.tob) (X : Ob) (w : SigT G T X)
  : Id (SigT G T' X) (subst (PTy[G]) (\ T2 -> SigT G T2 X) T T' Pq w)
       (pairE G T' X (fstE G T X w) (subst (TOb G) (\ o -> W0.Ix (o X (fstE G T X w))) T.tob T'.tob same (sndE G T X w))) =
  transH (totTr G T T' Pq X w)
   (apH (\ pp -> pairE G T' X (fstE G T X w) (subst (TOb G) (\ o -> W0.Ix (o X (fstE G T X w))) T.tob T'.tob pp (sndE G T X w)))
      (isSet-tob G T.tob T'.tob (apH (\ T2 -> T2.tob) Pq) same)) ;

 -- the extensionality of C-types: equal types at each x (a path P x),
 -- and the actions on totals agree along P
 module CTyExt (G : CCtx) (A B : CTy[G]) (Pf : (x : CO) -> Id (PTy[G.ob x]) (A.ty x) (B.ty x))
  (Q : (y x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (A.ty x) X)
     -> Id (SigT (G.ob y) (B.ty y) X)
          ((B.tE y x f).nt X (subst (PTy[G.ob x]) (\ T -> SigT (G.ob x) T X) (A.ty x) (B.ty x) (Pf x) w))
          (subst (PTy[G.ob y]) (\ T -> SigT (G.ob y) T X) (A.ty y) (B.ty y) (Pf y) ((A.tE y x f).nt X w))) {
  Pf' : Id (TyF G) A.ty B.ty = funext CO (\ x -> PTy[G.ob x]) A.ty B.ty Pf ;
  -- transport along Pf' at x is transport along Pf x
  trP (x : CO) (X : Ob) (w : SigT (G.ob x) (A.ty x) X)
   : Id (SigT (G.ob x) (B.ty x) X) (subst (TyF G) (\ ty -> SigT (G.ob x) (ty x) X) A.ty B.ty Pf' w)
        (subst (PTy[G.ob x]) (\ T -> SigT (G.ob x) T X) (A.ty x) (B.ty x) (Pf x) w) =
   transH (subst-ap (TyF G) (PTy[G.ob x]) (\ ty -> ty x) (\ T -> SigT (G.ob x) T X) A.ty B.ty Pf' w)
     (apH (\ pp -> subst (PTy[G.ob x]) (\ T -> SigT (G.ob x) T X) (A.ty x) (B.ty x) pp w)
        (isSet-PTy (G.ob x) (A.ty x) (B.ty x) (apH (\ ty -> ty x) Pf') (Pf x))) ;
  -- the generic step: by induction on the path of type families
  Mot (ty1 : TyF G) (P1 : Id (TyF G) A.ty ty1) : U l+ =
   (tE1 : TEF G ty1) (lp1 : LPt G ty1 tE1) (li1 : LId G ty1 tE1) (lo1 : LO G ty1 tE1)
   -> ((y x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (A.ty x) X)
       -> Id (SigT (G.ob y) (ty1 y) X)
            ((tE1 y x f).nt X (subst (TyF G) (\ ty -> SigT (G.ob x) (ty x) X) A.ty ty1 P1 w))
            (subst (TyF G) (\ ty -> SigT (G.ob y) (ty y) X) A.ty ty1 P1 ((A.tE y x f).nt X w)))
   -> Id (CTy[G]) (mkCTy G A.ty A.tE A.tE-pt A.tE-id A.tE-o) (mkCTy G ty1 tE1 lp1 li1 lo1) ;
  base (tE1 : TEF G A.ty) (lp1 : LPt G A.ty tE1) (li1 : LId G A.ty tE1) (lo1 : LO G A.ty tE1)
   (Q1 : (y x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (A.ty x) X) -> Id (SigT (G.ob y) (A.ty y) X) ((tE1 y x f).nt X w) ((A.tE y x f).nt X w))
   : Id (CTy[G]) (mkCTy G A.ty A.tE A.tE-pt A.tE-id A.tE-o) (mkCTy G A.ty tE1 lp1 li1 lo1) =
   idJ (TEF G A.ty) A.tE (\ t2 P2 -> (lp2 : LPt G A.ty t2) (li2 : LId G A.ty t2) (lo2 : LO G A.ty t2) -> Id (CTy[G]) (mkCTy G A.ty A.tE A.tE-pt A.tE-id A.tE-o) (mkCTy G A.ty t2 lp2 li2 lo2))
    (\ lp2 li2 lo2 -> cty-laws G A.ty A.tE A.tE-pt lp2 A.tE-id li2 A.tE-o lo2)
    tE1 (funext CO (\ y -> (x : CO) (f : CH y x) -> PSub[extP (G.ob x) (A.ty x), extP (G.ob y) (A.ty y)]) A.tE tE1 (\ y ->
          funext CO (\ x -> (f : CH y x) -> PSub[extP (G.ob x) (A.ty x), extP (G.ob y) (A.ty y)]) (A.tE y) (tE1 y) (\ x ->
          funext (CH y x) (\ f -> PSub[extP (G.ob x) (A.ty x), extP (G.ob y) (A.ty y)]) (A.tE y x) (tE1 y x) (\ f ->
          sub-ext (extP (G.ob x) (A.ty x)) (extP (G.ob y) (A.ty y)) (A.tE y x f) (tE1 y x f) (\ X w -> symH (Q1 y x f X w))))))
    lp1 li1 lo1 ;
  res : Id (CTy[G]) A B =
   transH (cty-eta G A)
    (transH (idJ (TyF G) A.ty Mot (\ tE1 lp1 li1 lo1 Q1 -> base tE1 lp1 li1 lo1 Q1) B.ty Pf' B.tE B.tE-pt B.tE-id B.tE-o
              (\ y x f X w -> transH (apH ((B.tE y x f).nt X) (trP x X w)) (transH (Q y x f X w) (symH (trP y X ((A.tE y x f).nt X w))))))
      (symH (cty-eta G B))) ;
 } ;
 cty-ext2 (G : CCtx) (A B : CTy[G]) (Pf : (x : CO) -> Id (PTy[G.ob x]) (A.ty x) (B.ty x))
  (Q : (y x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (A.ty x) X)
     -> Id (SigT (G.ob y) (B.ty y) X)
          ((B.tE y x f).nt X (subst (PTy[G.ob x]) (\ T -> SigT (G.ob x) T X) (A.ty x) (B.ty x) (Pf x) w))
          (subst (PTy[G.ob y]) (\ T -> SigT (G.ob y) T X) (A.ty y) (B.ty y) (Pf y) ((A.tE y x f).nt X w)))
  : Id (CTy[G]) A B = CTyExt[G, A, B, Pf, Q].res ;

 isSet-CTy (G : CCtx) : isSet (CTy[G]) =
  isSet-retract (CTy[G]) ((ty : TyF G) * (tE : TEF G ty) * LPt G ty tE * LId G ty tE * LO G ty tE)
   (\ A -> (A.ty, A.tE, A.tE-pt, A.tE-id, A.tE-o)) (\ w -> mkCTy G w.1 w.2.1 w.2.2.1 w.2.2.2.1 w.2.2.2.2)
   (\ A -> symH (cty-eta G A))
   (isSet-Sigma (TyF G) (\ ty -> (tE : TEF G ty) * LPt G ty tE * LId G ty tE * LO G ty tE)
     (isSet-Pi CO (\ x -> PTy[G.ob x]) (\ x -> isSet-PTy (G.ob x))) (\ ty ->
    isSet-Sigma (TEF G ty) (\ tE -> LPt G ty tE * LId G ty tE * LO G ty tE)
     (isSet-Pi CO (\ y -> (x : CO) (f : CH y x) -> PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y)]) (\ y ->
      isSet-Pi CO (\ x -> (f : CH y x) -> PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y)]) (\ x ->
      isSet-Pi (CH y x) (\ f -> PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y)]) (\ f -> isSet-PSub (extP (G.ob x) (ty x)) (extP (G.ob y) (ty y))))))
     (\ tE -> prop-to-set (LPt G ty tE * LId G ty tE * LO G ty tE)
        (isProp-Sigma (LPt G ty tE) (\ u -> LId G ty tE * LO G ty tE) (lpt-prop G ty tE) (\ u ->
         isProp-Sigma (LId G ty tE) (\ u' -> LO G ty tE) (lid-prop G ty tE) (\ u' -> lo-prop G ty tE)))))) ;
} ;
