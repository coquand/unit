-- CPshPiFibC.seg (canonicity-c2; COBAR.md (B) stage 2(c), M3b): Pi on
-- the CwF of uniformly fibrant C-types (CFibCwF), as CwFCl.ClPi.
--
--   piCl      the uniform fibration structure of Pi_A B (CPshPiFibF.piUFib)
--   PNat.base at each x, the substituted structure of (Pi_A B)_x is that
--             of (Pi_{A[s]} B[lift s])_x: FibCwF.MoveNat along the
--             cartesian map K of CPshPiFibS, and CPshPiFibS's uniq in the
--             two directions, with the base's CPiNat at each y (cmpY)
--   PNat.law  piCl-nat, in the shape of CPshSigFib.SNat.law
--   FPiC      the ClPi instance: Pi on CFibCwF
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module FBC = FibCwF[a, l] ;

module PiClOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module ST = CPshPiStr[a, l].StrOf[C] ;
 module PFm = CPshPiFibF[a, l].PFOf[C] ;
 module SS = CPshPiFibS[a, l].SOf[C] ;
 module NN = CPshPiFibN[a, l].NOf[C] ;
 open P ;

 piCl (G : CCtx) (A : UF.FCC.STy G) (B : UF.FCC.STy (LO.ExtC G A.1)) : UF.Cl G (PO.PiC[G, A.1, B.1].PiT) =
  PFm.PF[G, A.1, B.1, A.2, B.2].piUFib ;

 module PNat (D G : CCtx) (A : UF.FCC.STy G) (B : UF.FCC.STy (LO.ExtC G A.1)) (s : CSub[D, G]) {
  A' : UF.FCC.STy D = UF.FCC.subS D G A s ;
  B' : UF.FCC.STy (LO.ExtC D A'.1) = UF.FCC.subS (LO.ExtC D A'.1) (LO.ExtC G A.1) B (CW.liftC D G A.1 s) ;
  module PFg = PFm.PF[G, A.1, B.1, A.2, B.2] ;
  module PFd = PFm.PF[D, A'.1, B'.1, A'.2, B'.2] ;
  Pg : CTy[G] = PO.PiC[G, A.1, B.1].PiT ;
  Pd : CTy[D] = PO.PiC[D, A'.1, B'.1].PiT ;
  Ps : CTy[D] = LO.subCTy D G s Pg ;

  module Bx (x : CO) {
   module Sx = SS.Sx[D, G, s, A.1, B.1, x] ;
   module H1 = Sx.Hd[true,
     \ y -> PB.CFill[l].FillC[G.ob y, A.1.ty y, false, (A.2.1 y).2].fill, \ y -> (B.2.1 y).1,
     \ y -> PB.CFill[l].FillC[D.ob y, A'.1.ty y, false, (A'.2.1 y).2].fill, \ y -> (B'.2.1 y).1,
     \ y -> apH (\ c -> c.1) PB.CPiNat[l].PiNat[D.ob y, G.ob y, s.sb y, A.1.ty y, B.1.ty y, A.2.1 y, B.2.1 y].nat] ;
   module H0 = Sx.Hd[false,
     \ y -> PB.CFill[l].FillC[G.ob y, A.1.ty y, true, (A.2.1 y).1].fill, \ y -> (B.2.1 y).2,
     \ y -> PB.CFill[l].FillC[D.ob y, A'.1.ty y, true, (A'.2.1 y).1].fill, \ y -> (B'.2.1 y).2,
     \ y -> apH (\ c -> c.2) PB.CPiNat[l].PiNat[D.ob y, G.ob y, s.sb y, A.1.ty y, B.1.ty y, A.2.1 y, B.2.1 y].nat] ;
   module N1 = H1.Hn[H1.NG.NC[PFg.FA1.res, B.2.2.1].natComp, H1.ND.NC[PFd.FA1.res, B'.2.2.1].natComp] ;
   module N0 = H0.Hn[H0.NG.NC[PFg.FA0.res, B.2.2.2].natComp, H0.ND.NC[PFd.FA0.res, B'.2.2.2].natComp] ;
   uq : Id (CL.Lines[D.ob x, Pd.ty x].Fib) (PFd.lfib x) (Sx.K.moveFib (PFg.lfib x)) =
    transH {CL.Lines[D.ob x, Pd.ty x].Fib} {PFd.lfib x} {((Sx.K.moveFib (PFg.lfib x)).1, (PFd.lfib x).2)} {Sx.K.moveFib (PFg.lfib x)}
     (apH (\ c -> (c, (PFd.lfib x).2)) N1.uniq) (apH (\ c -> ((Sx.K.moveFib (PFg.lfib x)).1, c)) N0.uniq) ;
   base : Id (FBC.FC.STy (D.ob x)) (FBC.FC.subS (D.ob x) (G.ob x) (Pg.ty x, PFg.lfib x) (s.sb x)) (Pd.ty x, PFd.lfib x) =
    transH (Sx.MN.law (PFg.lfib x)) (apH (\ z -> (Pd.ty x, z)) (symH uq)) ;
   opaque base ;
  } ;

  nat : Id (CTy[D]) Ps Pd = ST.NA.N[D, G, s, A.1, B.1].PiT-nat ;
  law : Id (UF.FCC.STy D) (UF.FCC.subS D G (Pg, piCl G A B) s) (Pd, piCl D A' B') =
   Sigma-path (CTy[D]) (UF.Cl D) Ps Pd (UF.clSubU D G s Pg (piCl G A B)) (piCl D A' B') nat
    (UF.ufib-eq D Pd (subst (CTy[D]) (UF.Cl D) Ps Pd nat (UF.clSubU D G s Pg (piCl G A B))) (piCl D A' B')
      (\ x ->
       transH (UF.fibTrC D Ps Pd nat (UF.clSubU D G s Pg (piCl G A B)) x)
        (transH (apH (\ pp -> subst (PTy[D.ob x]) (\ T -> CL.Lines[D.ob x, T].Fib) (Ps.ty x) (Pd.ty x) pp
                               (PB.CFibSub[l].FibSub[D.ob x, G.ob x, s.sb x, Pg.ty x].sub (PFg.lfib x)))
                   (isSet-PTy (D.ob x) (Ps.ty x) (Pd.ty x) (apH (\ X -> X.ty x) nat) (apH (\ u -> u.1) Bx[x].base)))
          (UF.sigSnd (PTy[D.ob x]) (UF.FCL.Cl (D.ob x))
             (FBC.FC.subS (D.ob x) (G.ob x) (Pg.ty x, PFg.lfib x) (s.sb x))
             (Pd.ty x, PFd.lfib x) Bx[x].base)))) ;
 } ;

 -- Pi on the CwF of uniformly fibrant C-types
 module FPiC = UF.FCC.ClPi[ST.PiC, piCl, \ D G A B s -> PNat[D, G, A, B, s].law] ;
} ;
