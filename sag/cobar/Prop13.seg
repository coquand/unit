-- Prop13.seg (canonicity-45; COBAR.md "Plan: Prop 13"): D f is an
-- equivalence when U f is.  Input: f : A -> B a map of C-types over G,
-- A and B levelwise fibrant, and U f an equivalence levelwise in the
-- base's sense (CEquiv.EquivOp = ContrOp on the homotopy fibres).
--   CMap       maps of C-types: levelwise PMap, compatible with tE
--   P          the homotopy fibre of f as a C-type over G.B
--              (P.ty x = HFib[G x, A x, B x, f x].FibT; tE acts on the
--              point and the line by B.tE, on the A part by A.tE)
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;
module Wt = Weights[a, l] ;

module P13Of (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module K = Chains[a].ChainsOf[C] ;
 CO : U a = P.CO ;

 record CMap (G : P.CCtx) (A B : P.CTy[G]) {
  mp (x : CO) : CP.PMap[G.ob x, A.ty x, B.ty x] ;
  mp-nat (y x : CO) (h : P.CH y x) (X : Ob) (w : SigT (G.ob x) (A.ty x) X)
   : Id (SigT (G.ob y) (B.ty y) X) ((B.tE y x h).nt X ((mp x).mE X w)) ((mp y).mE X ((A.tE y x h).nt X w)) ;
 } ;

 module HP (G : P.CCtx) (A B : P.CTy[G]) (f : CMap[G, A, B]) {
  GB : P.CCtx = LO.ExtC G B ;

  -- the action of h : y -> x on the totals of the fibres
  module PT (y x : CO) (h : P.CH y x) (X : Ob) (v : CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.EI X) {
   module Hx = CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x] ;
   module Hy = CE.HFib[G.ob y, A.ty y, B.ty y, f.mp y] ;
   w : Hy.TA.EI X = (B.tE y x h).nt X (Hx.TF.pr1 X v) ;
   ea : Hy.TB.EI X = (A.tE y x h).nt X (Hx.fibB X v) ;
   pe : Id (W0.Ix ((G.ob y).ob X)) (Hy.TB.pr1 X ea) (Hy.TA.pr1 X w) =
    transH (A.tE-pt y x h X (Hx.fibB X v)) (symH (B.tE-pt y x h X (Hx.TF.pr1 X v))) ;
   a' : Hy.TB.T X (Hy.TA.pr1 X w) = Hy.TB.coeT X (Hy.TB.pr1 X ea) (Hy.TA.pr1 X w) pe (Hy.TB.pr2 X ea) ;
   ea-eq : Id (Hy.TB.EI X) ea (Hy.TB.pr X (Hy.TA.pr1 X w) a') = Hy.TB.pr-coe X (Hy.TB.pr1 X ea) (Hy.TA.pr1 X w) pe (Hy.TB.pr2 X ea) ;
   t (W : Ob) (g : Hom W X) (i : Hom W PB.Iv) : Hy.TA.EI W = (B.tE y x h).nt W (Hx.fibL X v W g i) ;
   res : Hy.TF.EI X =
    Hy.mkFib X w a' t
     (\ V W g g' i -> transH (symH ((B.tE y x h).nt-nat V W g (Hx.fibL X v W g' i))) (apH ((B.tE y x h).nt V) (Hx.fibL-nat X v V W g g' i)))
     (\ W g i -> transH (B.tE-pt y x h W (Hx.fibL X v W g i))
        (transH (apH ((G.act y x h).nt W) (Hx.fibL-pt X v W g i))
          (transH ((G.act y x h).nt-nat W X g (Hx.TA.pr1 X (Hx.TF.pr1 X v)))
            (apH ((G.ob y).act W X g) (symH (B.tE-pt y x h X (Hx.TF.pr1 X v)))))))
     (transH (apH ((B.tE y x h).nt X) (Hx.fibL-0 X v))
       (transH (f.mp-nat y x h X (Hx.fibB X v)) (apH ((f.mp y).mE X) ea-eq)))
     (apH ((B.tE y x h).nt X) (Hx.fibL-1 X v)) ;
  } ;

  ty (x : CO) : PTy[GB.ob x] = CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].FibT ;
  res (y x : CO) (h : P.CH y x) (X : Ob) (v : CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.EI X) : CE.HFib[G.ob y, A.ty y, B.ty y, f.mp y].TF.EI X = PT[y, x, h, X, v].res ;
  -- the B part of the action is A.tE of the B part
  rb (y x : CO) (h : P.CH y x) (X : Ob) (v : CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.EI X)
   : Id (CE.HFib[G.ob y, A.ty y, B.ty y, f.mp y].TB.EI X) (CE.HFib[G.ob y, A.ty y, B.ty y, f.mp y].fibB X (res y x h X v)) ((A.tE y x h).nt X (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibB X v)) =
   symH PT[y, x, h, X, v].ea-eq ;
  tEP (y x : CO) (h : P.CH y x) : PSub[extP (GB.ob x) (ty x), extP (GB.ob y) (ty y)] =
   new PSub[extP (GB.ob x) (ty x), extP (GB.ob y) (ty y), res y x h,
    \ Y X g v -> CE.HFib[G.ob y, A.ty y, B.ty y, f.mp y].fibE-eq Y (res y x h Y (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.E.act Y X g v)) (CE.HFib[G.ob y, A.ty y, B.ty y, f.mp y].TF.E.act Y X g (res y x h X v))
      ((B.tE y x h).nt-nat Y X g (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.pr1 X v))
      (transH (rb y x h Y (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.E.act Y X g v))
        (transH (apH ((A.tE y x h).nt Y) (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibB-act Y X g v))
          (transH ((A.tE y x h).nt-nat Y X g (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibB X v))
            (transH (apH (CE.HFib[G.ob y, A.ty y, B.ty y, f.mp y].TB.E.act Y X g) (symH (rb y x h X v)))
              (symH (CE.HFib[G.ob y, A.ty y, B.ty y, f.mp y].fibB-act Y X g (res y x h X v)))))))
      (\ W g' i -> refl ((B.tE y x h).nt W (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibL X v W (PB.compH W Y X g g') i)))] ;
  PC : P.CTy[GB] =
   new P.CTy[GB, ty, tEP,
    \ y x h X v -> refl ((B.tE y x h).nt X (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.pr1 X v)),
    \ x X v -> CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibE-eq X (res x x (P.cid x) X v) v (B.tE-id x X (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.pr1 X v))
       (transH (rb x x (P.cid x) X v) (A.tE-id x X (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibB X v)))
       (\ W g i -> B.tE-id x W (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibL X v W g i)),
    \ z y x h k X v -> CE.HFib[G.ob z, A.ty z, B.ty z, f.mp z].fibE-eq X (res z x (P.co z y x h k) X v) (res z y k X (res y x h X v))
       (B.tE-o z y x h k X (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].TF.pr1 X v))
       (transH (rb z x (P.co z y x h k) X v)
         (transH (A.tE-o z y x h k X (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibB X v))
           (transH (apH ((A.tE z y k).nt X) (symH (rb y x h X v)))
             (symH (rb z y k X (res y x h X v))))))
       (\ W g i -> B.tE-o z y x h k W (CE.HFib[G.ob x, A.ty x, B.ty x, f.mp x].fibL X v W g i))] ;
 } ;

 ------------------------------------------------------------------
 -- D f : (D A)_x -> (D B)_x over (D G)_x, indexwise

 module DF (G : P.CCtx) (A B : P.CTy[G]) (f : CMap[G, A, B]) {
  module DD = Cobar[a, l].DOf[C] ;
  module D = DD.DC[G] ;
  module DA = DD.DT[G, A] ;
  module DB = DD.DT[G, B] ;

  module DM (x : CO) (X : Ob) (d : D.Ob' x X) (av : DA.TOb' x X d) {
   v (q : DD.Idx x X) (l : DD.LandsI x X q) : SigT (G.ob q.2.1) (B.ty q.2.1) q.2.2.2.1 =
    (f.mp q.2.1).mE q.2.2.2.1 (DA.prz q.2.1 q.2.2.2.1 (d.1 q l) (av.1 q l)) ;
   b : DB.TA x X d = \ q l ->
    GPR.TyL[G.ob q.2.1, B.ty q.2.1].coeT q.2.2.2.1 (fstE (G.ob q.2.1) (B.ty q.2.1) q.2.2.2.1 (v q l)) (d.1 q l)
     ((f.mp q.2.1).mpt q.2.2.2.1 (DA.prz q.2.1 q.2.2.2.1 (d.1 q l) (av.1 q l)))
     (sndE (G.ob q.2.1) (B.ty q.2.1) q.2.2.2.1 (v q l)) ;
   pc (q : DD.Idx x X) (l : DD.LandsI x X q) : Id (W0.Ix (DB.Ez q.2.1 q.2.2.2.1)) (DB.prz q.2.1 q.2.2.2.1 (d.1 q l) (b q l)) (v q l) =
    symH (GPR.TyL[G.ob q.2.1, B.ty q.2.1].pr-coe q.2.2.2.1 (fstE (G.ob q.2.1) (B.ty q.2.1) q.2.2.2.1 (v q l)) (d.1 q l)
     ((f.mp q.2.1).mpt q.2.2.2.1 (DA.prz q.2.1 q.2.2.2.1 (d.1 q l) (av.1 q l)))
     (sndE (G.ob q.2.1) (B.ty q.2.1) q.2.2.2.1 (v q l))) ;
   anat' : W0.Ix (DB.anatEq x X d b) = \ r l ->
    transH (apH ((extP (G.ob r.1.2.1) (B.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pc r.1 l))
     (transH (symH ((f.mp r.1.2.1).mnat r.2.1 r.1.2.2.2.1 r.2.2 (DA.prz r.1.2.1 r.1.2.2.2.1 (d.1 r.1 l) (av.1 r.1 l))))
       (transH (apH ((f.mp r.1.2.1).mE r.2.1) (av.2.1 r l))
         (symH (pc (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2,
                    (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                   (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)))) ;
   aface' : W0.Ix (DB.afaceEq x X d b) = \ r l ->
    transH (pc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF x X r l).1) (DA.afaceF x X r l).2)
     (transH (apH ((f.mp r.2.2.2.1).mE r.2.2.2.2.2.1) (av.2.2.1 r l))
       (symH (pc (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l))) ;
   atop' : W0.Ix (DB.atopEq x X d b) = \ r l ->
    transH (pc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF x X r l).1) (DA.atopF x X r l).2)
     (transH (apH ((f.mp r.2.1).mE r.2.2.2.1) (av.2.2.2 r l))
       (transH (symH (f.mp-nat r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.2 r.2.2.2.1
                       (DA.prz (K.drop r.1 x r.2.1 r.2.2.1).1 r.2.2.2.1 (d.1 (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l)
                          (av.1 (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))))
         (apH ((B.tE r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.2).nt r.2.2.2.1)
            (symH (pc (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))))) ;
   res : DB.TOb' x X d = (b, anat', aface', atop') ;
  } ;

  -- D f at x as a map of base types
  mE (x : CO) (X : Ob) (w : SigT (D.obD x) (DA.DTy x) X) : SigT (D.obD x) (DB.DTy x) X =
   pairE (D.obD x) (DB.DTy x) X (fstE (D.obD x) (DA.DTy x) X w) (DM[x, X, fstE (D.obD x) (DA.DTy x) X w, sndE (D.obD x) (DA.DTy x) X w].res) ;
  module DN (x : CO) (Y X : Ob) (h : Hom Y X) (w : SigT (D.obD x) (DA.DTy x) X) {
   d : D.Ob' x X = fstE (D.obD x) (DA.DTy x) X w ;
   av : DA.TOb' x X d = sndE (D.obD x) (DA.DTy x) X w ;
   d' : D.Ob' x Y = (D.obD x).act Y X h d ;
   av' : DA.TOb' x Y d' = (DA.DTy x).tact Y X h d d' (refl d') av ;
   module M1 = DM[x, X, d, av] ;
   module M2 = DM[x, Y, d', av'] ;
   module TBb = DB.TB[x, Y, X, h, d, d', refl d', M1.res] ;
   module TBa = DA.TB[x, Y, X, h, d, d', refl d', av] ;
   eqv : Id (DB.TOb' x Y d') TBb.res M2.res =
    DB.tob-eq x Y d' TBb.res M2.res (\ q l ->
     GPR.TyL[G.ob q.2.1, B.ty q.2.1].pr-inj q.2.2.2.1 (d'.1 q l) (TBb.res.1 q l) (M2.res.1 q l)
      (transH (TBb.pc q l)
        (transH (M1.pc (TBb.sh q) l)
          (transH (apH ((f.mp q.2.1).mE q.2.2.2.1) (symH (TBa.pc q l)))
            (symH (M2.pc q l)))))) ;
   nat : Id (SigT (D.obD x) (DB.DTy x) Y) (mE x Y ((extP (D.obD x) (DA.DTy x)).act Y X h w)) ((extP (D.obD x) (DB.DTy x)).act Y X h (mE x X w)) =
    symH (transH (GPR.TyL[D.obD x, DB.DTy x].pr-tact Y X h d d' (refl d') M1.res)
      (apH (pairE (D.obD x) (DB.DTy x) Y d') eqv)) ;
  } ;
  Df (x : CO) : CP.PMap[D.obD x, DA.DTy x, DB.DTy x] =
   CP.mkPMap (D.obD x) (DA.DTy x) (DB.DTy x) (mE x) (\ X w -> refl (fstE (D.obD x) (DA.DTy x) X w)) (\ Y X h w -> DN[x, Y, X, h, w].nat) ;
 } ;

 ------------------------------------------------------------------
 -- Psi: from the homotopy fibres of D f to D of the homotopy fibres

 module PSI (G : P.CCtx) (A B : P.CTy[G]) (f : CMap[G, A, B]) (x : CO) {
  module DD = Cobar[a, l].DOf[C] ;
  module HPf = HP[G, A, B, f] ;
  module DFf = DF[G, A, B, f] ;
  module D = DFf.D ;
  module DA = DFf.DA ;
  module DB = DFf.DB ;
  module DGB = DD.DC[HPf.GB] ;
  module DPC = DD.DT[HPf.GB, HPf.PC] ;
  module Hd = CE.HFib[D.obD x, DA.DTy x, DB.DTy x, DFf.Df x] ;

  -- s : the points (d , b) of E_(D B) to D (G.B)
  sP (W : Ob) (w : Hd.TA.EI W) : DGB.Ob' x W =
   (\ q l -> DB.prz q.2.1 q.2.2.2.1 ((Hd.TA.pr1 W w).1 q l) ((Hd.TA.pr2 W w).1 q l),
    (Hd.TA.pr2 W w).2.1, (Hd.TA.pr2 W w).2.2.1, (Hd.TA.pr2 W w).2.2.2) ;
  s-nat (V W : Ob) (g : Hom V W) (w : Hd.TA.EI W) : Id (DGB.Ob' x V) (sP V (Hd.TA.E.act V W g w)) (DGB.BA[x, V, W, g, sP W w].res) =
   DGB.ob-eq x V _ _ (\ q l ->
    DB.TB[x, V, W, g, Hd.TA.pr1 W w, (D.obD x).act V W g (Hd.TA.pr1 W w), refl ((D.obD x).act V W g (Hd.TA.pr1 W w)), Hd.TA.pr2 W w].pc q l) ;

  -- an element v of the fibre of D f over (d , b) at W
  module PF (W : Ob) (v : Hd.TF.EI W) {
   w0 : Hd.TA.EI W = Hd.TF.pr1 W v ;
   d : D.Ob' x W = Hd.TA.pr1 W w0 ;
   b : DB.TOb' x W d = Hd.TA.pr2 W w0 ;
   av : DA.TOb' x W d = (Hd.TF.pr2 W v).1 ;
   -- the line of v in D (G.B)
   ln : W0.Ix (CL.FC[DGB.obD x].GI.ob W) =
    (\ V h j -> sP V (Hd.fibL W v V h j),
     \ V' V g h j -> transH (symH (s-nat V' V g (Hd.fibL W v V h j))) (apH (sP V') (Hd.fibL-nat W v V' V g h j))) ;
   module Lx = Lemma11L[a, l].PsiOf[C, HPf.GB].PL[x, W, ln] ;
   xx : W0.Ix (Hd.EAB.ob W) = Hd.TAB.pr W w0 av ;
   module RS = Lemma11L[a, l].PsiOf[C, G] ;
   -- the element of the fibre of f at the index q
   module PQ (q : DD.Idx x W) (lq : DD.LandsI x W q) {
    n : Nat = q.1 ;
    z : CO = q.2.1 ;
    c : K.Ch q.1 x q.2.1 = q.2.2.1 ;
    J : Ob = q.2.2.2.1 ;
    g : Hom q.2.2.2.1 W = q.2.2.2.2.1 ;
    module HZ = CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1] ;
    wq : HZ.TA.EI J = (sP W w0).1 q lq ;
    aq : W0.Ix ((A.ty z).tob J (d.1 q lq)) = av.1 q lq ;
    R0 : Wt.Pn n J = Wt.Res[n, J, J, PB.idH J, (q.2.2.2.2.2, lq)].res ;
    qr0 : DD.Idx x J = (n, z, c, J, PB.idH J, R0.1) ;
    tp (V : Ob) (h : Hom V J) (j : Hom V PB.Iv)
     : Id (W0.Ix ((G.ob z).ob V)) (HZ.TA.pr1 V (Lx.val q lq V h j)) ((G.ob z).act V J h (d.1 q lq)) =
     transH (apH (\ dd -> dd.1 (n, z, c, V, PB.idH V, (Wt.Res[n, V, J, h, (q.2.2.2.2.2, lq)].res).1) (Wt.Res[n, V, J, h, (q.2.2.2.2.2, lq)].res).2)
               (Hd.fibL-pt W v V (PB.compH V J W g h) j))
      (transH (apH (\ k -> d.1 (n, z, c, V, k, (Wt.Res[n, V, J, h, (q.2.2.2.2.2, lq)].res).1) (Wt.Res[n, V, J, h, (q.2.2.2.2.2, lq)].res).2)
                 (PB.comp-idr V W (PB.compH V J W g h)))
        (symH (d.2.1 (q, (V, h)) lq))) ;
    -- the reading at the restriction along the identity is the reading at q
    rid (F : (k : Hom J W) -> (p : Wt.Pn n J) -> HZ.TA.EI J) : Id (HZ.TA.EI J) (F (PB.compH J J W g (PB.idH J)) R0) (F g (q.2.2.2.2.2, lq)) =
     transH (apH (\ k -> F k R0) (PB.comp-idr J W g)) (apH (F g) (RS.resid n J (q.2.2.2.2.2, lq))) ;
    -- the ends of the line at q
    d' : D.Ob' x J = (D.obD x).act J W g d ;
    e' : Id (D.Ob' x J) ((D.obD x).act J W g (Hd.TA.pr1 W w0)) (Hd.TA.pr1 J (Hd.EA.act J W g w0)) =
     ntEq Hd.EA (D.obD x) (pP (D.obD x) (DB.DTy x)) J W g w0 (Hd.EA.act J W g w0) (refl (Hd.EA.act J W g w0)) ;
    t0 : Id (HZ.TA.EI J) (Lx.val q lq J (PB.idH J) (PB.ptH J PB.e0)) ((f.mp z).mE J (HZ.TB.pr J (d.1 q lq) aq)) =
     transH (apH (\ k -> (sP J (Hd.fibL W v J k (PB.ptH J PB.e0))).1 qr0 R0.2) (PB.comp-idr J W g))
      (transH (apH (\ y -> (sP J y).1 qr0 R0.2) (Hd.PE.end0g W xx (Hd.TF.pr2 W v).2 J g))
        (transH (DFf.DM[x, J, Hd.TA.pr1 J (Hd.EA.act J W g w0), Hd.TAB.pr2 J (Hd.EAB.act J W g xx)].pc qr0 R0.2)
          (transH (apH ((f.mp z).mE J) (DA.TB[x, J, W, g, d, Hd.TA.pr1 J (Hd.EA.act J W g w0), e', av].pc qr0 R0.2))
            (rid (\ k p -> (f.mp z).mE J (DA.prz z J (d.1 (n, z, c, J, k, p.1) p.2) (av.1 (n, z, c, J, k, p.1) p.2))))))) ;
    t1 : Id (HZ.TA.EI J) (Lx.val q lq J (PB.idH J) (PB.ptH J PB.e1)) wq =
     transH (apH (\ k -> (sP J (Hd.fibL W v J k (PB.ptH J PB.e1))).1 qr0 R0.2) (PB.comp-idr J W g))
      (transH (apH (\ y -> (sP J y).1 qr0 R0.2) (Hd.PE.end1g W xx (Hd.TF.pr2 W v).2 J g))
        (transH (DB.TB[x, J, W, g, d, d', refl d', b].pc qr0 R0.2)
          (rid (\ k p -> DB.prz z J (d.1 (n, z, c, J, k, p.1) p.2) (b.1 (n, z, c, J, k, p.1) p.2))))) ;
    psq : W0.Ix (HZ.FibT.tob J wq) = (aq, HZ.PE.mkPath J (HZ.TAB.pr J wq aq) (Lx.val q lq) (Lx.lnat q lq) tp t0 t1) ;
   } ;
   tps : DPC.TA x W (sP W w0) = \ q lq -> PQ[q, lq].psq ;
   anatS : W0.Ix (DPC.anatEq x W (sP W w0) tps) = \ r lq ->
    CE.HFib[G.ob r.1.2.1, A.ty r.1.2.1, B.ty r.1.2.1, f.mp r.1.2.1].fibE-eq r.2.1 _ _ ((sP W w0).2.1 r lq)
     (transH (CE.HFib[G.ob r.1.2.1, A.ty r.1.2.1, B.ty r.1.2.1, f.mp r.1.2.1].fibB-act r.2.1 r.1.2.2.2.1 r.2.2 (CE.HFib[G.ob r.1.2.1, A.ty r.1.2.1, B.ty r.1.2.1, f.mp r.1.2.1].TF.pr r.1.2.2.2.1 ((sP W w0).1 r.1 lq) (tps r.1 lq))) (av.2.1 r lq))
     (\ W' f' i' -> apH (\ L -> L.1 W' f' i') (Lx.natP r lq)) ;
   afaceS : W0.Ix (DPC.afaceEq x W (sP W w0) tps) = \ r lq ->
    CE.HFib[G.ob r.2.2.2.1, A.ty r.2.2.2.1, B.ty r.2.2.2.1, f.mp r.2.2.2.1].fibE-eq r.2.2.2.2.2.1 _ _ ((sP W w0).2.2.1 r lq) (av.2.2.1 r lq) (\ W' f' i' -> apH (\ L -> L.1 W' f' i') (Lx.faceP r lq)) ;
   atopS : W0.Ix (DPC.atopEq x W (sP W w0) tps) = \ r lq ->
    CE.HFib[G.ob r.2.1, A.ty r.2.1, B.ty r.2.1, f.mp r.2.1].fibE-eq r.2.2.2.1 _ _ ((sP W w0).2.2.2 r lq)
     (transH (av.2.2.2 r lq)
       (symH (HPf.rb r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.2 r.2.2.2.1
                (DPC.prz (K.drop r.1 x r.2.1 r.2.2.1).1 r.2.2.2.1
                   ((sP W w0).1 (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) lq)
                   (tps (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) lq)))))
     (\ W' f' i' -> apH (\ L -> L.1 W' f' i') (Lx.topP r lq)) ;
   psi : DPC.TOb' x W (sP W w0) = (tps, anatS, afaceS, atopS) ;
  } ;

  -- Mv's mS , mSpt , mSnat
  mS (W : Ob) (v : Hd.TF.EI W) : DPC.TotD x W = pairE (DGB.obD x) (DPC.DTy x) W (sP W (Hd.TF.pr1 W v)) PF[W, v].psi ;
  mSnat (V W : Ob) (g : Hom V W) (v : Hd.TF.EI W)
   : Id (DPC.TotD x V) ((extP (DGB.obD x) (DPC.DTy x)).act V W g (mS W v)) (mS V (Hd.TF.E.act V W g v)) =
   DPC.totD-eq x V _ _ (symH (s-nat V W g (Hd.TF.pr1 W v))) (\ q lq ->
    transH (DPC.TB[x, V, W, g, sP W (Hd.TF.pr1 W v), DGB.BA[x, V, W, g, sP W (Hd.TF.pr1 W v)].res,
                   refl (DGB.BA[x, V, W, g, sP W (Hd.TF.pr1 W v)].res), PF[W, v].psi].pc q lq)
     (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].fibE-eq q.2.2.2.1 _ _
       (symH (DB.TB[x, V, W, g, PF[W, v].d, (D.obD x).act V W g PF[W, v].d, refl ((D.obD x).act V W g PF[W, v].d), PF[W, v].b].pc q lq))
       (symH (DA.TB[x, V, W, g, PF[W, v].d, Hd.TA.pr1 V (Hd.EA.act V W g (Hd.TF.pr1 W v)),
                    ntEq Hd.EA (D.obD x) (pP (D.obD x) (DB.DTy x)) V W g (Hd.TF.pr1 W v) (Hd.EA.act V W g (Hd.TF.pr1 W v))
                      (refl (Hd.EA.act V W g (Hd.TF.pr1 W v))), PF[W, v].av].pc q lq))
       (\ W' f' i' -> apH (\ k -> (sP W' (Hd.fibL W v W' k i')).1
                                   (q.1, q.2.1, q.2.2.1, W', PB.idH W', (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, lq)].res).1)
                                   (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, lq)].res).2)
                       (PB.comp-assoc W' q.2.2.2.1 V W g q.2.2.2.2.1 f')))) ;

  -- a value of a line of v is a reading of Psi v (at q* , at (J' , id , j g'))
  module RC (W : Ob) (v : Hd.TF.EI W) (Vv : Ob) (h : Hom Vv W) (j : Hom Vv PB.Iv) (q' : DD.Idx x Vv) (lq : DD.LandsI x Vv q') {
   J' : Ob = q'.2.2.2.1 ;
   g' : Hom q'.2.2.2.1 Vv = q'.2.2.2.2.1 ;
   L : Hd.TA.EI Vv = Hd.fibL W v Vv h j ;
   qs : DD.Idx x W = (q'.1, q'.2.1, q'.2.2.1, J', PB.compH J' Vv W h g', q'.2.2.2.2.2) ;
   Rid : Wt.Pn q'.1 J' = Wt.Res[q'.1, J', J', PB.idH J', (q'.2.2.2.2.2, lq)].res ;
   qr : DD.Idx x J' = (q'.1, q'.2.1, q'.2.2.1, J', PB.idH J', Rid.1) ;
   rec : Id (W0.Ix (DB.Ez q'.2.1 J')) ((sP Vv L).1 q' lq) (PF[W, v].Lx.val qs lq J' (PB.idH J') (PB.compH J' Vv PB.Iv j g')) =
    transH (symH (transH (apH (\ k -> (sP Vv L).1 (q'.1, q'.2.1, q'.2.2.1, J', k, Rid.1) Rid.2) (PB.comp-idr J' Vv g'))
                   (apH (\ p -> (sP Vv L).1 (q'.1, q'.2.1, q'.2.2.1, J', g', p.1) p.2) (Lemma11L[a, l].PsiOf[C, G].resid q'.1 J' (q'.2.2.2.2.2, lq)))))
     (transH (apH (\ o -> o.1 qr Rid.2) (symH (s-nat J' Vv g' L)))
       (transH (apH (\ y -> (sP J' y).1 qr Rid.2) (Hd.fibL-nat W v J' Vv g' h j))
         (apH (\ k -> (sP J' (Hd.fibL W v J' k (PB.compH J' Vv PB.Iv j g'))).1 qr Rid.2) (symH (PB.comp-idr J' W (PB.compH J' Vv W h g')))))) ;
  } ;

  -- Psi is injective over equal points (Mv's mTinj)
  mTinj (W : Ob) (v v' : Hd.TF.EI W) (Pp : Id (W0.Ix (Hd.EA.ob W)) (Hd.TF.pr1 W v) (Hd.TF.pr1 W v'))
   (Q : Id (DPC.TotD x W) (mS W v) (mS W v')) : Id (Hd.TF.EI W) v v' =
   Hd.fibE-eq W v v' Pp
    (DA.totD-eq x W (Hd.fibB W v) (Hd.fibB W v') (apH (Hd.TA.pr1 W) Pp) (\ q lq ->
      apH (\ T -> CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].fibB q.2.2.2.1 (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TF.pr q.2.2.2.1 (T.1.1 q lq) (T.2.1 q lq))) Q))
    (\ V h j -> DB.totD-eq x V (Hd.fibL W v V h j) (Hd.fibL W v' V h j)
      (transH (Hd.fibL-pt W v V h j) (transH (apH (\ w -> (D.obD x).act V W h (Hd.TA.pr1 W w)) Pp) (symH (Hd.fibL-pt W v' V h j))))
      (\ q' lq ->
        transH (RC[W, v, V, h, j, q', lq].rec)
         (transH (apH (\ T -> CE.HFib[G.ob q'.2.1, A.ty q'.2.1, B.ty q'.2.1, f.mp q'.2.1].fibL q'.2.2.2.1 (CE.HFib[G.ob q'.2.1, A.ty q'.2.1, B.ty q'.2.1, f.mp q'.2.1].TF.pr q'.2.2.2.1 (T.1.1 RC[W, v, V, h, j, q', lq].qs lq) (T.2.1 RC[W, v, V, h, j, q', lq].qs lq))
                                q'.2.2.2.1 (PB.idH q'.2.2.2.1) (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1)) Q)
           (symH (RC[W, v', V, h, j, q', lq].rec))))) ;

  -- the converse of Psi over a point (Mv's bk)
  module BK (X : Ob) (w0 : Hd.TA.EI X) (u : DPC.TOb' x X (sP X w0)) {
   d : D.Ob' x X = Hd.TA.pr1 X w0 ;
   b : DB.TOb' x X d = Hd.TA.pr2 X w0 ;
   E (q : DD.Idx x X) (lq : DD.LandsI x X q) : CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TF.EI q.2.2.2.1 = CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TF.pr q.2.2.2.1 ((sP X w0).1 q lq) (u.1 q lq) ;
   av : DA.TOb' x X d =
    (\ q lq -> (u.1 q lq).1,
     \ r lq -> transH (symH (CE.HFib[G.ob r.1.2.1, A.ty r.1.2.1, B.ty r.1.2.1, f.mp r.1.2.1].fibB-act r.2.1 r.1.2.2.2.1 r.2.2 (E r.1 lq))) (apH (CE.HFib[G.ob r.1.2.1, A.ty r.1.2.1, B.ty r.1.2.1, f.mp r.1.2.1].fibB r.2.1) (u.2.1 r lq)),
     \ r lq -> apH (CE.HFib[G.ob r.2.2.2.1, A.ty r.2.2.2.1, B.ty r.2.2.2.1, f.mp r.2.2.2.1].fibB r.2.2.2.2.2.1) (u.2.2.1 r lq),
     \ r lq -> transH (apH (CE.HFib[G.ob r.2.1, A.ty r.2.1, B.ty r.2.1, f.mp r.2.1].fibB r.2.2.2.1) (u.2.2.2 r lq))
                (HPf.rb r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.2 r.2.2.2.1
                   (E (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) lq))) ;
   -- the line values: at (Vv , h , j) a total of D B over h^* d
   module LV (Vv : Ob) (h : Hom Vv X) (j : Hom Vv PB.Iv) {
    dV : D.Ob' x Vv = (D.obD x).act Vv X h d ;
    qs (q : DD.Idx x Vv) : DD.Idx x X = (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.compH q.2.2.2.1 Vv X h q.2.2.2.2.1, q.2.2.2.2.2) ;
    val (q : DD.Idx x Vv) (lq : DD.LandsI x Vv q) : CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TA.EI q.2.2.2.1 =
     CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].fibL q.2.2.2.1 (E (qs q) lq) q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.compH q.2.2.2.1 Vv PB.Iv j q.2.2.2.2.1) ;
    vpt (q : DD.Idx x Vv) (lq : DD.LandsI x Vv q) : Id (W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TA.pr1 q.2.2.2.1 (val q lq)) (dV.1 q lq) =
     transH (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].fibL-pt q.2.2.2.1 (E (qs q) lq) q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.compH q.2.2.2.1 Vv PB.Iv j q.2.2.2.2.1))
      ((G.ob q.2.1).act-id q.2.2.2.1 (d.1 (qs q) lq)) ;
    bv : DB.TA x Vv dV = \ q lq ->
     CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TA.coeT q.2.2.2.1 (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TA.pr1 q.2.2.2.1 (val q lq)) (dV.1 q lq) (vpt q lq) (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TA.pr2 q.2.2.2.1 (val q lq)) ;
    bpc (q : DD.Idx x Vv) (lq : DD.LandsI x Vv q) : Id (W0.Ix (DB.Ez q.2.1 q.2.2.2.1)) (DB.prz q.2.1 q.2.2.2.1 (dV.1 q lq) (bv q lq)) (val q lq) =
     symH (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TA.pr-coe q.2.2.2.1 (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TA.pr1 q.2.2.2.1 (val q lq)) (dV.1 q lq) (vpt q lq) (CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].TA.pr2 q.2.2.2.1 (val q lq))) ;
   } ;
  } ;
 } ;
} ;
