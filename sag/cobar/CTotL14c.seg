-- CTotL14c.seg (canonicity-45; SIMPLIFIED.md step 4): Lemma 14 at the
-- total site, part c: eps is natural along levelwise maps.
--   sInj     a slice index of length 0 is determined by its total map
--            (the image of a levelwise map is monic: CDisc.Cancel)
--   one0-res restricting the weight (1) gives (1)
--   EN       for h = (u, p) : (J, y) -> (I, x) levelwise, after path
--            induction on p the two readings are at indices with the same
--            total map cart u x (the unit's index laws TNat / TauNat)
--   epsN     eps as an NMap U B -> U A over U G
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Ar = Arith[a] ;

one0-res (W' W : Ob) (f : Hom W' W) : Id (Wt.Pn zero W') (Wt.Res[zero, W', W, f, CTotL14b[a, vl, l].one0 W].res) (CTotL14b[a, vl, l].one0 W') =
 Sigma-eq (Wt.Coords zero W') (\ cs -> PB.Lands W' W' (Wt.oneS zero W' cs) (PB.idH W'))
  (Wt.Res[zero, W', W, f, CTotL14b[a, vl, l].one0 W].res).1 (CTotL14b[a, vl, l].one0 W').1 (Wt.Res[zero, W', W, f, CTotL14b[a, vl, l].one0 W].res).2 (CTotL14b[a, vl, l].one0 W').2
  (funext (Ar.Fin (suc zero)) (\ k -> Hom W' PFO.ivO) (Wt.Res[zero, W', W, f, CTotL14b[a, vl, l].one0 W].res).1 (CTotL14b[a, vl, l].one0 W').1 (\ k -> PB.ptH-nat W' W f PB.e1))
  (PB.isProp-Lands W' W' (Wt.oneS zero W' (CTotL14b[a, vl, l].one0 W').1) (PB.idH W')) ;

module L14c (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LB = CTotL14b[a, vl, l].L14b[C, G, A] ;
 module TA = LB.TA ;
 module TC = LB.TC ;
 module P = LB.P ;
 module VT = LB.VT ;
 module DA = LB.DA ;
 module D = LB.D ;
 module TR = LB.TR ;
 module HO = LB.HO ;
 E : P.PCtx = LB.E ;
 GP : P.PCtx = LB.GP ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 ------------------------------------------------------------------
 -- a slice index of length 0 is determined by its total map
 module SI (I : Ob) (x : Obj I) (J : Ob) (z : Obj J) {
  Sx : U vl = D.S I x zero J z ;
  tot (s : Sx) : VT.TH J z I x = (s.1, D.tmap I x zero J s.1 z s.2) ;
  -- with the same base map: Cancel at the cartesian lift
  same (u : Hom J I) (c c' : VT.VMap J z (C.res J I u x))
   (E2 : Id (VT.TH J z I x) (compH J J I u (idH J), C.compD J J I u (idH J) z (C.res J I u x) x (C.cart J I u x) c)
                             (compH J J I u (idH J), C.compD J J I u (idH J) z (C.res J I u x) x (C.cart J I u x) c'))
   : Id Sx (u, c) (u, c') =
   apH {VT.VMap J z (C.res J I u x)} {Sx} (\ w -> (u, w))
    (VT.THom-snd' J J z (C.res J I u x) (idH J, c) (idH J, c')
      (TR.DS.Cancel[(J, C.res J I u x), (I, x), (J, z), (u, refl (C.res J I u x)), (idH J, c), (idH J, c'), refl (idH J), E2].law)
      (refl (idH J))) ;
  sInj (s s' : Sx) (E1 : Id (VT.TH J z I x) (tot s) (tot s')) : Id Sx s s' =
   idJ (Hom J I) s.1
    (\ w p -> (c' : VT.VMap J z (C.res J I w x))
       -> Id (VT.TH J z I x) (compH J J I s.1 (idH J), C.compD J J I s.1 (idH J) z (C.res J I s.1 x) x (C.cart J I s.1 x) s.2)
                             (compH J J I w (idH J), C.compD J J I w (idH J) z (C.res J I w x) x (C.cart J I w x) c')
       -> Id Sx (s.1, s.2) (w, c'))
    (\ c' E2 -> same s.1 s.2 c' E2)
    s'.1
    (transH (symH (comp-idr J I s.1))
      (transH (apH {VT.TH J z I x} {Hom J I} (\ h -> h.1)
                 (transH (symH (D.tmap-eq I x zero J s.1 z s.2)) (transH E1 (D.tmap-eq I x zero J s'.1 z s'.2))))
        (comp-idr J I s'.1)))
    s'.2
    (transH (symH (D.tmap-eq I x zero J s.1 z s.2)) (transH E1 (D.tmap-eq I x zero J s'.1 z s'.2))) ;
 } ;

 ------------------------------------------------------------------
 -- eps is natural: the case of a cartesian lift, then path induction
 module EN (J I : Ob) (u : Hom J I) (x : Obj I) (g : W0.Ix (G.ob I x)) (b : DA.TOb' I x (D.tau I x g)) {
  y : Obj J = C.res J I u x ;
  module EX = LB.EP[I, x, g] ;
  module SJ = SI[I, x, J, y] ;
  -- the two indices and their total maps
  c0X : VT.VMap I x (C.res I I (idH I) x) = EX.c0 ;
  s1 : SJ.Sx = (compH J I I (idH I) u, TA.DO.rCh J I I u (idH I) x zero x c0X) ;
  g0 : VT.VMap J y (C.res J I u x) = VT.vpart J I u y x (C.cart J I u x) ;
  module LY (g' : W0.Ix (G.ob J y)) {
   module EY = LB.EP[J, y, g'] ;
   s2 : SJ.Sx = (compH J J I u (idH J), TA.DO.CT.rxM J J I (idH J) u y x g0 zero y EY.c0) ;
   Q1 : Id (VT.TH J y I x) (SJ.tot s1) (u, C.cart J I u x) =
    transH (symH (D.Tau[I, x, g].TNat[zero, I, idH I, x, c0X, J, u].law))
     (transH (VT.cmpR J I I u y x x (C.cart J I u x) (idH I, D.tmap I x zero I (idH I) x c0X) (idH I, C.idD I x) EX.tm)
       (C.idl J I u y x (C.cart J I u x))) ;
   Q2 : Id (VT.TH J y I x) (SJ.tot s2) (u, C.cart J I u x) =
    transH (symH (D.TauNat[J, I, u, y, x, C.cart J I u x, zero, J, idH J, y, EY.c0].law))
     (transH (VT.cmpL J J I u y y x (C.cart J I u x) (idH J, D.tmap J y zero J (idH J) y EY.c0) (idH J, C.idD J y) EY.tm)
       (C.idr J I u y x (C.cart J I u x))) ;
   s12 : Id SJ.Sx s1 s2 = SJ.sInj s1 s2 (transH Q1 (symH Q2)) ;
   -- the reading of b on the slice at (J, y)
   rdA (s : SJ.Sx) (p : Wt.Pn zero J) : DA.Ez J y =
    DA.prz J y ((D.tau I x g).1 (zero, J, s.1, y, s.2, p.1) p.2) (b.1 (zero, J, s.1, y, s.2, p.1) p.2) ;
   rdEq : Id (DA.Ez J y) (rdA s1 (Wt.Res[zero, J, I, u, CTotL14b[a, vl, l].one0 I].res)) (rdA s2 (CTotL14b[a, vl, l].one0 J)) =
    transH (apH {SJ.Sx} {DA.Ez J y} (\ s -> rdA s (Wt.Res[zero, J, I, u, CTotL14b[a, vl, l].one0 I].res)) s12)
     (apH {Wt.Pn zero J} {DA.Ez J y} (\ p -> rdA s2 p) (one0-res J I u)) ;
   -- the naturality, for any point equation of the target
   module M (e1 : Id (W0.Ix (G.ob J y)) (G.act J I u y x (C.cart J I u x) g) g') (e0 : Id (D.Ob' J y) (D.act J I u y x (C.cart J I u x) (D.tau I x g)) (D.tau J y g')) {
    module TB = DA.TB[J, I, u, y, x, C.cart J I u x, D.tau I x g, D.tau J y g', e0, b] ;
    law : Id (W0.Ix (A.tob (J, y) g')) (A.tact (J, y) (I, x) (u, C.cart J I u x) g g' e1 (EX.ev b)) (EY.ev TB.res) =
     DA.pr-inj J y g' (A.tact (J, y) (I, x) (u, C.cart J I u x) g g' e1 (EX.ev b)) (EY.ev TB.res)
      (transH (symH (P.pair-act GP A (J, y) (I, x) (u, C.cart J I u x) g g' e1 (EX.ev b)))
        (transH (apH {DA.Ez I x} {DA.Ez J y} (\ w -> E.act (J, y) (I, x) (u, C.cart J I u x) w) (EX.epc b))
          (transH (b.2.1 (EX.q0, (J, u)) EX.l0)
            (transH rdEq
              (transH (symH (TB.pc EY.q0 EY.l0))
                (symH (EY.epc TB.res))))))) ;
   } ;
  } ;
 } ;
 -- a levelwise map (u, p) acts by the cartesian lift moved along p
 fp (J I : Ob) (u : Hom J I) (x : Obj I) (y2 : Obj J) (p2 : Id (Obj J) (C.res J I u x) y2) : VT.HomD J I u y2 x =
  VT.trD J I u (C.res J I u x) y2 p2 x (C.cart J I u x) ;
 gen (J I : Ob) (u : Hom J I) (x : Obj I) (g : W0.Ix (G.ob I x)) (b : DA.TOb' I x (D.tau I x g))
  (y2 : Obj J) (p2 : Id (Obj J) (C.res J I u x) y2) (g' : W0.Ix (G.ob J y2))
  (e1 : Id (W0.Ix (G.ob J y2)) (G.act J I u y2 x (fp J I u x y2 p2) g) g')
  (e0 : Id (D.Ob' J y2) (D.act J I u y2 x (fp J I u x y2 p2) (D.tau I x g)) (D.tau J y2 g'))
  : Id (W0.Ix (A.tob (J, y2) g')) (A.tact (J, y2) (I, x) (u, fp J I u x y2 p2) g g' e1 (LB.EP[I, x, g].ev b))
       (LB.EP[J, y2, g'].ev (DA.TB[J, I, u, y2, x, fp J I u x y2 p2, D.tau I x g, D.tau J y2 g', e0, b].res)) =
  idJ (Obj J) (C.res J I u x)
   (\ y3 p3 -> (g3 : W0.Ix (G.ob J y3)) (e13 : Id (W0.Ix (G.ob J y3)) (G.act J I u y3 x (fp J I u x y3 p3) g) g3)
      (e03 : Id (D.Ob' J y3) (D.act J I u y3 x (fp J I u x y3 p3) (D.tau I x g)) (D.tau J y3 g3))
      -> Id (W0.Ix (A.tob (J, y3) g3)) (A.tact (J, y3) (I, x) (u, fp J I u x y3 p3) g g3 e13 (LB.EP[I, x, g].ev b))
            (LB.EP[J, y3, g3].ev (DA.TB[J, I, u, y3, x, fp J I u x y3 p3, D.tau I x g, D.tau J y3 g3, e03, b].res)))
   (\ g3 e13 e03 -> EN[J, I, u, x, g, b].LY[g3].M[e13, e03].law)
   y2 p2 g' e1 e0 ;

 -- eps as a map of types over U G at the levelwise site
 epsN : HO.NMap[LB.UG, LB.UB, LB.UA] =
  new HO.NMap[LB.UG, LB.UB, LB.UA, \ X g b -> LB.EP[X.1, X.2, g].ev b,
   \ Y X h g g' e1 b -> gen Y.1 X.1 h.1 X.2 g b Y.2 (symH h.2) g' e1
     (P.ntEq GP (TC.toP D.DCtx) (TC.toPS G D.DCtx D.tauS) Y X (TR.DS.fnH Y X h) g g' e1)] ;
 -- eps tau = id pointwise, hence a homotopy
 epsTau : LB.RS.P0.PEl[LB.RS.P0.extP LB.UG LB.UA,
   HO.HT[LB.UG, LB.UA, LB.UA, HO.compN LB.UG LB.UA LB.UB LB.UA LB.tauN epsN, HO.idN LB.UG LB.UA].PT.PathP] =
  HO.Ret[LB.UG, LB.UA, LB.UA, HO.idN LB.UG LB.UA, HO.idN LB.UG LB.UA,
         HO.compN LB.UG LB.UA LB.UB LB.UA LB.tauN epsN, HO.idN LB.UG LB.UA,
         \ X g av -> LB.EP[X.1, X.2, g].et av, \ X g av -> refl av, HO.Rf[LB.UG, LB.UA, LB.UA, HO.idN LB.UG LB.UA].res].res ;
} ;
