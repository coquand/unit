-- GFibIdCen.seg: GENERATED from FibIdCen.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change FibIdCen.seg or the generator.
-- FibIdCen.seg (M1, step 3): Swan's identity type in the CwF of fibrant
-- types of B, first part: Id, refl and their naturality; the record's
-- centre is PosIdYJ's (cen = cY); its map of motive contexts is PosIdYJ's
-- at every point (upS = upY); the centre is stable (cen-nat).  FibId
-- completes the instance with J, its computation rule and J-nat.
--
-- of B: the instance fibId of CwFId.SwanId[l+, fibCwF].IdJStr.
--
-- Id(a , b) is the Yoneda Id (PosIdY) with its fibration, refl the constant
-- path (FibIdRd.ReflY); J and its computation rule are those of PosIdYJ.JY
-- at the centre cY of PosIdYJ, and J commutes with substitution by
-- PosIdYJ.YJNat.
--
-- Informal text.
-- (1) IdT-nat is PosIdYFib.FibNat.law.  rfl-nat: the transported refl has
--     at y the value of refl at s y moved along the code path of IdYNat;
--     its readings are those of refl at s y (IdYNat.rdV), which are those
--     of refl at y read through s (s is natural); sieves total.
-- (2) The centre.  The record's centre cen (CwFId.Der) is (sec a , refl a
--     transported along reflT).  At x its path is refl a x moved along any
--     code path (FibIdRd.elTr): along the triple path
--     (A , a , a) = (A[p][sec] , a[p][sec] , q[sec]), then along the code
--     path of IdYNat at sec.  Both keep the readings (triRd, bk-rd), so the
--     path is the constant one at a x, with the total sieve: the path of
--     PosIdYJ's centre cY (read through fromJ).  So cen = cY.
-- (3) The map of motive contexts.  upS (CwFId.Der) is the double lift
--     transported along IKnat; at (k , w) it is (lift k , w moved back)
--     (FibIdRd.subTr), and w moved back has the readings of w read through
--     the lift (triple path over D.A[s], then IdYNat at the lift).  These
--     are the readings of PosIdYJ's upY at (k , w).  So upS = upY.
-- (4) J is JY at cY, the motive's start transported along cen = cY; beta is
--     JY.beta read back along cen = cY (betaTr).  cen-nat: at x,
--     cen (s x) = cY (s x) = upY (cY' x) (CIdJ's cen-up through io , oi)
--     = upS (cen' x).
-- (5) J-nat: at z, J(upS z) = J(upY z) (2), = J'(C[upY] , d1) z (YJNat), =
--     J'(C[upS] , d'') z (transport along upS = upY, JTr), as points of the
--     total space of C.  The start of YJNat is matched by reading d'' at x:
--     d'' is d at s x moved along cen (s x) = upS (cen' x) (elTr, the code
--     path of the motive along cen-nat), so all four starts are the same
--     point of the total space.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;
module FC = GFibCwF[l].FC ;
module SW = CwFId.SwanId[l+, GFibCwF[l].fibCwF] ;
module R = GFibIdRd[l] ;

------------------------------------------------------------------------
-- (1) Id, its naturality, refl

idTy (G : PCtx) (A : FC.STy G) (a0 b0 : PEl[G, A.1]) : FC.STy G =
  (GPosIdY[l].IdY[G, A.1, a0, b0].IdYT, GPosIdY[l].IdY[G, A.1, a0, b0].fib A.2) ;

idTy-nat (D G : PCtx) (A : FC.STy G) (a0 b0 : PEl[G, A.1]) (s : PSub[D, G])
  : Id (FC.STy D) (FC.subS D G (idTy G A a0 b0) s) (idTy D (FC.subS D G A s) (subEl D G A.1 a0 s) (subEl D G A.1 b0 s)) =
  GPosIdYFib[l].FibNat[D, G, s, A.1, a0, b0, A.2].law ;

rflE (G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) : PEl[G, (idTy G A a0 a0).1] = R.ReflY[G, A.1, a0].rflY ;

module RflNat (D G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) (s : PSub[D, G]) {
  module N = GPosIdY[l].IdYNat[D, G, s, A.1, a0, a0] ;
  module RG = R.ReflY[G, A.1, a0] ;
  module RD = R.ReflY[D, subTy D G A.1 s, subEl D G A.1 a0 s] ;

  u : PEl[D, N.YD.IdYT] =
    subst (FC.STy D) (\ Z -> PEl[D, Z.1]) (FC.subS D G (idTy G A a0 a0) s) (idTy D (FC.subS D G A s) (subEl D G A.1 a0 s) (subEl D G A.1 a0 s))
      (idTy-nat D G A a0 a0 s) (subEl D G RG.Y.IdYT RG.rflY s) ;

  -- the code path of the fibres (IdYNat)
  cP (J : Ob) (y : W0.Ix (D.ob J)) : Id W0.V (N.YG.tob J (s.nt J y)) (N.YD.tob J y) = ap N.PS W0.V (\ z -> N.ob z J y) N.z1 N.z2 N.Z ;

  w2 (J : Ob) (y : W0.Ix (D.ob J)) : W0.Ix (N.YD.tob J y) =
    subst W0.V (\ v -> W0.Ix v) (N.YG.tob J (s.nt J y)) (N.YD.tob J y) (cP J y) (RG.val J (s.nt J y)) ;

  pt (J : Ob) (y : W0.Ix (D.ob J)) : Id (W0.Ix (N.YD.tob J y)) (u.eob J y) (RD.val J y) =
    transH (R.elTr D (FC.STy D) (\ Z -> Z.1) (FC.subS D G (idTy G A a0 a0) s) (idTy D (FC.subS D G A s) (subEl D G A.1 a0 s) (subEl D G A.1 a0 s))
              (idTy-nat D G A a0 a0 s) (subEl D G RG.Y.IdYT RG.rflY s) J y (cP J y))
      (N.YD.idY-eq J y (w2 J y) (RD.val J y)
         (\ V g j -> N.SEA.mV-inj V (N.YD.rd J y (w2 J y) V g j) (N.YD.rd J y (RD.val J y) V g j) (refl (D.act V J g y))
            (transH (N.rdV J y N.z1 N.z2 N.Z (RG.val J (s.nt J y)) V g j)
               (apH (\ v -> N.TA.pr V v (a0.eob V v)) (symH (s.nt-nat V J g y)))))
         (N.sqV J y N.z1 N.z2 N.Z (RG.val J (s.nt J y)))) ;

  law : Id (PEl[D, N.YD.IdYT]) u RD.rflY = el-ext D N.YD.IdYT u RD.rflY pt ;
} ;

module DR = SW.Der[idTy, idTy-nat, rflE] ;

------------------------------------------------------------------------
-- (2) the centre is PosIdYJ's

module Cen (G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) {
  module Y = GPosIdYJ[l].YJ[G, A.1, a0] ;
  sa : PSub[G, Y.K] = secP G A.1 a0 ;
  module N = GPosIdY[l].IdYNat[G, Y.K, sa, Y.B, Y.aK, qP G A.1] ;
  module RG = R.ReflY[G, A.1, a0] ;

  -- the centre of the record, named in the vocabulary of PosIdYJ
  cenY : PSub[G, Y.DY] = DR.cen G A a0 ;

  -- the triples: of refl, at the section, over K
  t0 : R.Tri G = (A.1, (a0, a0)) ;
  t1 : R.Tri G = (subTy G Y.K Y.B sa, (subEl G Y.K Y.B Y.aK sa, subEl G Y.K Y.B (qP G A.1) sa)) ;
  tK : R.Tri Y.K = (Y.B, (Y.aK, qP G A.1)) ;

  PA : Id (PTy[G]) A.1 (subTy G Y.K Y.B sa) =
    ty-ext2 G A.1 (subTy G Y.K Y.B sa) (refl A.1.tob)
      (\ J I f x y e v -> tact-irr G A.1 J I f x y e (ntEq Y.K G (pP G A.1) J I f (sa.nt I x) (sa.nt J y) (ntEq G Y.K sa J I f x y e)) v) ;

  T : Id (R.Tri G) t0 t1 =
    R.triPath G A.1 (subTy G Y.K Y.B sa) PA a0 a0 (subEl G Y.K Y.B Y.aK sa) (subEl G Y.K Y.B (qP G A.1) sa)
      (el-subst G A.1 (subTy G Y.K Y.B sa) PA (refl A.1.tob) a0 (subEl G Y.K Y.B Y.aK sa) (\ I x -> refl (a0.eob I x)))
      (el-subst G A.1 (subTy G Y.K Y.B sa) PA (refl A.1.tob) a0 (subEl G Y.K Y.B (qP G A.1) sa) (\ I x -> refl (a0.eob I x))) ;

  c1 (X : Ob) (x : W0.Ix (G.ob X)) : Id W0.V (R.FT G t0 X x) (R.FT G t1 X x) = apH (\ t -> R.FT G t X x) T ;

  -- refl at x, moved along the triple path, then along IdYNat at sec
  w1 (X : Ob) (x : W0.Ix (G.ob X)) : W0.Ix (N.YD.tob X x) = subst W0.V (\ v -> W0.Ix v) (R.FT G t0 X x) (R.FT G t1 X x) (c1 X x) (RG.val X x) ;
  w2 (X : Ob) (x : W0.Ix (G.ob X)) : W0.Ix (Y.YK.tob X (sa.nt X x)) =
    subst W0.V (\ v -> W0.Ix v) (N.YD.tob X x) (Y.YK.tob X (sa.nt X x)) (N.Q0 X x) (w1 X x) ;

  -- the path of cen at x is w2
  eE (X : Ob) (x : W0.Ix (G.ob X)) : Id (W0.Ix (Y.YK.tob X (sa.nt X x))) ((DR.reflE G A a0).eob X x) (w2 X x) =
    transH (R.elTr G (FC.STy G) (\ Z -> Z.1) (idTy G A a0 a0) (FC.subS G Y.K (DR.IK G A a0) sa)
              (sym (FC.STy G) (FC.subS G Y.K (DR.IK G A a0) sa) (idTy G A a0 a0) (DR.reflT G A a0)) RG.rflY X x
              (trans W0.V (R.FT G t0 X x) (N.YD.tob X x) (Y.YK.tob X (sa.nt X x)) (c1 X x) (N.Q0 X x)))
      (SW.substTr W0.V (\ v -> W0.Ix v) (R.FT G t0 X x) (N.YD.tob X x) (Y.YK.tob X (sa.nt X x)) (c1 X x) (N.Q0 X x) (RG.val X x)) ;

  -- w2 is the path of cY at x
  wEq (X : Ob) (x : W0.Ix (G.ob X)) : Id (W0.Ix (Y.YK.tob X (sa.nt X x))) (w2 X x) (Y.fromJ X (sa.nt X x) (Y.IJ.reflEl.eob X x)) =
    R.idY-eqV Y.K tK X (sa.nt X x) (w2 X x) (Y.fromJ X (sa.nt X x) (Y.IJ.reflEl.eob X x))
      (\ W f j -> transH (apH (R.vmap Y.K Y.B W) (N.bk-rd X x (w1 X x) W f j))
                    (transH (R.triRd G t0 t1 T X x (c1 X x) (RG.val X x) W f j)
                       (symH (apH (R.vmap G A.1 W) (Y.FromJ[X, sa.nt X x, Y.IJ.reflEl.eob X x].uJ-E W f j)))))
      (transH (N.bk-sq X x (w1 X x)) (R.triSq G t0 t1 T X x (c1 X x) (RG.val X x))) ;

  cenPt (X : Ob) (x : W0.Ix (G.ob X)) : Id (W0.Ix (Y.DY.ob X)) (cenY.nt X x) (Y.cY.nt X x) =
    apH (Y.TY.pr X (sa.nt X x)) (transH (eE X x) (wEq X x)) ;

  cenEq : Id (PSub[G, Y.DY]) cenY Y.cY = sub-ext G Y.DY cenY Y.cY cenPt ;
} ;

------------------------------------------------------------------------
-- (3) the map of motive contexts is PosIdYJ's

module Up (D G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) (s : PSub[D, G]) {
  module YN = GPosIdYJ[l].YJNat[D, G, s, A.1, a0] ;
  module Y = YN.Y ;
  module Y' = YN.Y' ;
  A' : PTy[D] = subTy D G A.1 s ;
  ls : PSub[Y'.K, Y.K] = liftP D G A.1 s ;
  module N = GPosIdY[l].IdYNat[Y'.K, Y.K, ls, Y.B, Y.aK, qP G A.1] ;

  -- the map of the record, named in the vocabulary of PosIdYJ
  upSY : PSub[Y'.DY, Y.DY] = DR.upS D G A a0 s ;

  -- the triples over D.A[s]: of the motive at D, and moved by the lift; over K
  t' : R.Tri Y'.K = (Y'.B, (Y'.aK, qP D A')) ;
  tL : R.Tri Y'.K = (subTy Y'.K Y.K Y.B ls, (subEl Y'.K Y.K Y.B Y.aK ls, subEl Y'.K Y.K Y.B (qP G A.1) ls)) ;
  tK : R.Tri Y.K = (Y.B, (Y.aK, qP G A.1)) ;

  PL : Id (PTy[Y'.K]) Y'.B (subTy Y'.K Y.K Y.B ls) =
    ty-ext2 Y'.K Y'.B (subTy Y'.K Y.K Y.B ls) (refl Y'.B.tob)
      (\ J I f x y e v -> tact-irr G A.1 J I f (s.nt I (fstE D A' I x)) (s.nt J (fstE D A' J y))
         (ntEq D G s J I f (fstE D A' I x) (fstE D A' J y) (ntEq Y'.K D (pP D A') J I f x y e))
         (ntEq Y.K G (pP G A.1) J I f (ls.nt I x) (ls.nt J y) (ntEq Y'.K Y.K ls J I f x y e)) v) ;

  T' : Id (R.Tri Y'.K) t' tL =
    R.triPath Y'.K Y'.B (subTy Y'.K Y.K Y.B ls) PL Y'.aK (qP D A') (subEl Y'.K Y.K Y.B Y.aK ls) (subEl Y'.K Y.K Y.B (qP G A.1) ls)
      (el-subst Y'.K Y'.B (subTy Y'.K Y.K Y.B ls) PL (refl Y'.B.tob) Y'.aK (subEl Y'.K Y.K Y.B Y.aK ls) (\ I w -> refl (Y'.aK.eob I w)))
      (el-subst Y'.K Y'.B (subTy Y'.K Y.K Y.B ls) PL (refl Y'.B.tob) (qP D A') (subEl Y'.K Y.K Y.B (qP G A.1) ls) (\ I w -> refl ((qP D A').eob I w))) ;

  c1 (X : Ob) (k : W0.Ix (Y'.K.ob X)) : Id W0.V (R.FT Y'.K t' X k) (R.FT Y'.K tL X k) = apH (\ t -> R.FT Y'.K t X k) T' ;

  module UpZ (X : Ob) (z : W0.Ix (Y'.DY.ob X)) {
    k : W0.Ix (Y'.K.ob X) = Y'.TY.pr1 X z ;
    w : W0.Ix (Y'.YK.tob X k) = Y'.TY.pr2 X z ;
    w1 : W0.Ix (N.YD.tob X k) = subst W0.V (\ c -> W0.Ix c) (R.FT Y'.K t' X k) (R.FT Y'.K tL X k) (c1 X k) w ;
    w2 : W0.Ix (Y.YK.tob X (ls.nt X k)) = subst W0.V (\ c -> W0.Ix c) (N.YD.tob X k) (Y.YK.tob X (ls.nt X k)) (N.Q0 X k) w1 ;
    tv : W0.Ix (Y.IJ.IO.tobI X (ls.nt X k)) = YN.JN.tauI X k (Y'.toJ X k w) ;

    -- w moved back is the path of upY at z
    wEq : Id (W0.Ix (Y.YK.tob X (ls.nt X k))) w2 (Y.fromJ X (ls.nt X k) tv) =
      R.idY-eqV Y.K tK X (ls.nt X k) w2 (Y.fromJ X (ls.nt X k) tv)
        (\ W f j -> transH (apH (R.vmap Y.K Y.B W) (N.bk-rd X k w1 W f j))
                      (transH (R.triRd Y'.K t' tL T' X k (c1 X k) w W f j)
                         (symH (apH (R.vmap G A.1 W) (Y.FromJ[X, ls.nt X k, tv].uJ-E W f j)))))
        (transH (N.bk-sq X k w1) (R.triSq Y'.K t' tL T' X k (c1 X k) w)) ;

    pt : Id (W0.Ix (Y.DY.ob X)) (upSY.nt X z) (YN.upYV X z) =
      transH (R.subTr Y'.K Y.DY (FC.STy Y'.K) (\ Z -> Z.1) (FC.subS Y'.K Y.K (DR.IK G A a0) ls) (DR.IK D (FC.subS D G A s) (subEl D G A.1 a0 s))
                (DR.IKnat D G A a0 s) (liftP Y'.K Y.K Y.YK.IdYT ls) X z
                (trans W0.V (R.FT Y'.K t' X k) (N.YD.tob X k) (Y.YK.tob X (ls.nt X k)) (c1 X k) (N.Q0 X k)))
        (apH (Y.TY.pr X (ls.nt X k))
           (transH (SW.substTr W0.V (\ c -> W0.Ix c) (R.FT Y'.K t' X k) (N.YD.tob X k) (Y.YK.tob X (ls.nt X k)) (c1 X k) (N.Q0 X k) w) wEq)) ;
  } ;

} ;


-- (4) J, beta, the centre is stable.  J is CJ's J (PosJNat.JJ) for the
-- J-data of PosIdYJ, over the record's context of the motive.

-- the CwF, as the record sees it
FW : CwF.CwF[l+] = GFibCwF[l].fibCwF ;

-- composites equal at every point
natSub (D G E' E : PCtx) (s : PSub[D, G]) (c : PSub[G, E]) (u : PSub[E', E]) (c' : PSub[D, E'])
  (h : (X : Ob) (x : W0.Ix (D.ob X)) -> Id (W0.Ix (E.ob X)) (c.nt X (s.nt X x)) (u.nt X (c'.nt X x)))
  : Id (PSub[D, E]) (oS D G E c s) (oS D E' E u c') = sub-ext D E (oS D G E c s) (oS D E' E u c') h ;

module CN (D G : PCtx) (A : FC.STy G) (a0 : PEl[G, A.1]) (s : PSub[D, G]) {
  module UP = Up[D, G, A, a0, s] ;
  module CG = Cen[G, A, a0] ;
  module CD = Cen[D, FC.subS D G A s, subEl D G A.1 a0 s] ;

  -- at x: cen (s x) = cY (s x) = upY (cY' x) = upS (cen' x)
  pt (X : Ob) (x : W0.Ix (D.ob X)) : Id (W0.Ix (UP.Y.DY.ob X)) (CG.cenY.nt X (s.nt X x)) (UP.upSY.nt X (CD.cenY.nt X x)) =
    transH (CG.cenPt X (s.nt X x))
      (symH (transH (UP.UpZ[X, CD.cenY.nt X x].pt)
              (transH (apH (UP.YN.upYV X) (CD.cenPt X x))
                 (transH (apH (\ w -> UP.Y.oiV X (UP.YN.JN.upV X w)) (UP.Y'.io-oi X (UP.Y'.IJ.c.nt X x)))
                         (apH (UP.Y.oiV X) (UP.YN.JN.cen-up X x)))))) ;

  -- the same, in the vocabulary of the record (one comparison, here)
  ptR (X : Ob) (x : W0.Ix (D.ob X))
    : Id (W0.Ix ((DR.Dx G A a0).ob X)) ((DR.cen G A a0).nt X (s.nt X x))
         ((DR.upS D G A a0 s).nt X ((DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)).nt X x)) = pt X x ;

  law : DR.CenNat D G A a0 s =
    natSub D G (DR.Dx D (FC.subS D G A s) (subEl D G A.1 a0 s)) (DR.Dx G A a0) s (DR.cen G A a0) (DR.upS D G A a0 s)
      (DR.cen D (FC.subS D G A s) (subEl D G A.1 a0 s)) ptR ;
} ;

