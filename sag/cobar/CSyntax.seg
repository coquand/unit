-- CSyntax.seg (canonicity-45; SIMPLIFIED.md step 2a): the syntax of
-- polynomial expressions over a metatheory ring k and of the derivations
-- of the congruence generated by the ring laws and a list of equations,
-- as metatheory sets (Tier 1's Presentations.Over.Expr and
-- ExpressionCongruence.Tree, copied without the truncated Relation: the
-- congruence of the base algebra is the BASE truncation of the constant
-- type of derivations, see INTERNAL-C.md).  Self-contained over Ring[l]
-- (sag/polynomial/Ring.seg, symlinked).
--   Fin n, Expr V (var, cst, sumE, mulE), Equations V, Presentation
--   Over[R].Der[pres]: Term, Tree (the derivation trees), ends, Valid,
--   Proof t u = (d : Tree) * Valid d * ends d = (t , u)

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Ring[l] ;

Fin : Nat -> U l = split { zero -> Empty ; suc n | r -> Plus r Top } ;

module Over (R : CRing) {
 data Expr (V : U l) : U l =
  var (v : V) | cst (r : R.R) | sumE (p q : Expr V) | mulE (p q : Expr V) ;
 cong2 (V : U l) (op : Expr V -> Expr V -> Expr V) (a a1 b b1 : Expr V) (h : Id (Expr V) a a1) (k : Id (Expr V) b b1)
  : Id (Expr V) (op a b) (op a1 b1) =
  transH (apH {Expr V} {Expr V} (\ x -> op x b) h) (apH {Expr V} {Expr V} (op a1) k) ;
 Equations (V : U l) : U l = List (Expr V) ;
 Presentation : U l = (n : Nat) * Equations (Fin n) ;

 -- derivations of the congruence generated by the ring laws and the
 -- equations of a presentation
 module Der (pres : Presentation) {
  Vs : U l = Fin pres.1 ;
  Term : U l = Expr Vs ;
  zeroE : Term = cst R.z ;
  oneE : Term = cst R.o ;
  negative (p : Term) : Term = mulE (cst (R.neg R.o)) p ;
  Member (e : Term) : List Term -> U l = split { nil -> Empty ; cons p ps | r -> Plus (Id Term e p) r } ;
  data Tree : U l =
   reflD (p : Term) | symD (d : Tree) | transD (d e : Tree)
   | sumD (d e : Tree) | mulD (d e : Tree)
   | addAssoc (p q r : Term) | addComm (p q : Term) | addZero (p : Term) | addNeg (p : Term)
   | mulAssoc (p q r : Term) | mulComm (p q : Term) | mulOne (p : Term) | distrib (p q r : Term)
   | coeffAdd (a b : R.R) | coeffMul (a b : R.R)
   | equation (p : Term) (member : Member p pres.2) ;
  ends : Tree -> Term * Term = split {
   reflD p -> (p, p) ; symD d | r -> (r.2, r.1) ; transD d e | rd re -> (rd.1, re.2) ;
   sumD d e | rd re -> (sumE rd.1 re.1, sumE rd.2 re.2) ;
   mulD d e | rd re -> (mulE rd.1 re.1, mulE rd.2 re.2) ;
   addAssoc p q r -> (sumE p (sumE q r), sumE (sumE p q) r) ;
   addComm p q -> (sumE p q, sumE q p) ; addZero p -> (sumE p zeroE, p) ;
   addNeg p -> (sumE p (negative p), zeroE) ;
   mulAssoc p q r -> (mulE p (mulE q r), mulE (mulE p q) r) ;
   mulComm p q -> (mulE p q, mulE q p) ; mulOne p -> (mulE p oneE, p) ;
   distrib p q r -> (mulE p (sumE q r), sumE (mulE p q) (mulE p r)) ;
   coeffAdd a b -> (sumE (cst a) (cst b), cst (R.add a b)) ;
   coeffMul a b -> (mulE (cst a) (cst b), cst (R.mul a b)) ;
   equation p member -> (p, zeroE) } ;
  Valid : Tree -> U l = split {
   reflD p -> Top ; symD d | r -> r ;
   transD d e | rd re -> rd * re * Id Term (ends d).2 (ends e).1 ;
   sumD d e | rd re -> rd * re ; mulD d e | rd re -> rd * re ;
   addAssoc p q r -> Top ; addComm p q -> Top ; addZero p -> Top ; addNeg p -> Top ;
   mulAssoc p q r -> Top ; mulComm p q -> Top ; mulOne p -> Top ; distrib p q r -> Top ;
   coeffAdd a b -> Top ; coeffMul a b -> Top ; equation p member -> Top } ;
  Proof (t u : Term) : U l = (d : Tree) * Valid d * Id Term (ends d).1 t * Id Term (ends d).2 u ;
  -- proofs as a congruence: reflexivity, symmetry, transitivity, the
  -- operations, and the laws (each a one-node tree with reflexive ends)
  ofTree (d : Tree) (v : Valid d) : Proof (ends d).1 (ends d).2 = (d, (v, (refl (ends d).1, refl (ends d).2))) ;
  reflP (t : Term) : Proof t t = ofTree (reflD t) tt ;
  symP (t u : Term) (w : Proof t u) : Proof u t = (symD w.1, (w.2.1, (w.2.2.2, w.2.2.1))) ;
  transP (t u v : Term) (w : Proof t u) (w' : Proof u v) : Proof t v =
   (transD w.1 w'.1, ((w.2.1, (w'.2.1, transH w.2.2.2 (symH w'.2.2.1))), (w.2.2.1, w'.2.2.2))) ;
  sumP (t t' u u' : Term) (w : Proof t t') (w' : Proof u u') : Proof (sumE t u) (sumE t' u') =
   (sumD w.1 w'.1, ((w.2.1, w'.2.1), (cong2 Vs (\ a b -> sumE a b) (ends w.1).1 t (ends w'.1).1 u w.2.2.1 w'.2.2.1,
                                      cong2 Vs (\ a b -> sumE a b) (ends w.1).2 t' (ends w'.1).2 u' w.2.2.2 w'.2.2.2))) ;
  mulP (t t' u u' : Term) (w : Proof t t') (w' : Proof u u') : Proof (mulE t u) (mulE t' u') =
   (mulD w.1 w'.1, ((w.2.1, w'.2.1), (cong2 Vs (\ a b -> mulE a b) (ends w.1).1 t (ends w'.1).1 u w.2.2.1 w'.2.2.1,
                                      cong2 Vs (\ a b -> mulE a b) (ends w.1).2 t' (ends w'.1).2 u' w.2.2.2 w'.2.2.2))) ;
  addAssocP (p q r : Term) : Proof (sumE p (sumE q r)) (sumE (sumE p q) r) = ofTree (addAssoc p q r) tt ;
  addCommP (p q : Term) : Proof (sumE p q) (sumE q p) = ofTree (addComm p q) tt ;
  addZeroP (p : Term) : Proof (sumE p zeroE) p = ofTree (addZero p) tt ;
  addNegP (p : Term) : Proof (sumE p (negative p)) zeroE = ofTree (addNeg p) tt ;
  mulAssocP (p q r : Term) : Proof (mulE p (mulE q r)) (mulE (mulE p q) r) = ofTree (mulAssoc p q r) tt ;
  mulCommP (p q : Term) : Proof (mulE p q) (mulE q p) = ofTree (mulComm p q) tt ;
  mulOneP (p : Term) : Proof (mulE p oneE) p = ofTree (mulOne p) tt ;
  distribP (p q r : Term) : Proof (mulE p (sumE q r)) (sumE (mulE p q) (mulE p r)) = ofTree (distrib p q r) tt ;
  coeffAddP (a b : R.R) : Proof (sumE (cst a) (cst b)) (cst (R.add a b)) = ofTree (coeffAdd a b) tt ;
  coeffMulP (a b : R.R) : Proof (mulE (cst a) (cst b)) (cst (R.mul a b)) = ofTree (coeffMul a b) tt ;
  equationP (p : Term) (m : Member p pres.2) : Proof p zeroE = ofTree (equation p m) tt ;
 } ;
} ;

-- lists
mapL (A B : U l) (f : A -> B) : List A -> List B = split { nil -> nil ; cons a as | r -> cons (f a) r } ;
appL (A : U l) : List A -> List A -> List A = split { nil -> \ bs -> bs ; cons a as | r -> \ bs -> cons a (r bs) } ;

-- the embedding of the old generators when m new ones are added outside
emb (n : Nat) : (m : Nat) -> Fin n -> Fin (Arith[l].plus m n) = split {
 zero -> \ v -> v ;
 suc m | ih -> \ v -> inl (ih v) } ;

module Rel (R : CRing) {
 module O = Over[R] ;
 rename (V W : U l) (u : V -> W) : O.Expr V -> O.Expr W = split {
  var v -> var (u v) ; cst r -> cst r ;
  sumE p q | rp rq -> sumE rp rq ; mulE p q | rp rq -> mulE rp rq } ;
 -- a relative presentation over x: m new generators, equations in all generators
 RelPres (x : O.Presentation) : U l = (m : Nat) * O.Equations (Fin (Arith[l].plus m x.1)) ;
 -- the concatenation x.u
 concat (x : O.Presentation) (u : RelPres x) : O.Presentation =
  (Arith[l].plus u.1 x.1, appL (O.Expr (Fin (Arith[l].plus u.1 x.1))) (mapL (O.Expr (Fin x.1)) (O.Expr (Fin (Arith[l].plus u.1 x.1))) (rename (Fin x.1) (Fin (Arith[l].plus u.1 x.1)) (emb x.1 u.1)) x.2) u.2) ;

 -- derivations over x become derivations over x.u, with renamed ends
 module Ren (x : O.Presentation) (u : RelPres x) {
  module Dx = O.Der[x] ;
  module Dc = O.Der[concat x u] ;
  e : Fin x.1 -> Fin (Arith[l].plus u.1 x.1) = emb x.1 u.1 ;
  rn : Dx.Term -> Dc.Term = rename (Fin x.1) (Fin (Arith[l].plus u.1 x.1)) e ;
  -- membership in the old equations gives membership in the concatenation
  memL (p : Dx.Term) : (es : List Dx.Term) -> Dx.Member p es
   -> Dc.Member (rn p) (appL Dc.Term (mapL Dx.Term Dc.Term rn es) u.2) = split {
   nil -> \ m -> absurd (Dc.Member (rn p) (appL Dc.Term (mapL Dx.Term Dc.Term rn nil) u.2)) m ;
   cons q qs | ih -> split { inl h -> inl (apH {Dx.Term} {Dc.Term} rn h) ; inr m -> inr (ih m) } } ;
  ren : Dx.Tree -> Dc.Tree = split {
   reflD p -> reflD (rn p) ; symD d | r -> symD r ; transD d e' | rd re -> transD rd re ;
   sumD d e' | rd re -> sumD rd re ; mulD d e' | rd re -> mulD rd re ;
   addAssoc p q r -> addAssoc (rn p) (rn q) (rn r) ; addComm p q -> addComm (rn p) (rn q) ;
   addZero p -> addZero (rn p) ; addNeg p -> addNeg (rn p) ;
   mulAssoc p q r -> mulAssoc (rn p) (rn q) (rn r) ; mulComm p q -> mulComm (rn p) (rn q) ;
   mulOne p -> mulOne (rn p) ; distrib p q r -> distrib (rn p) (rn q) (rn r) ;
   coeffAdd a b -> coeffAdd a b ; coeffMul a b -> coeffMul a b ;
   equation p m -> equation (rn p) (memL p x.2 m) } ;
  -- the ends of the renamed derivation are the renamed ends
  ends-ren : (d : Dx.Tree) -> Id (Dc.Term * Dc.Term) (Dc.ends (ren d)) (rn (Dx.ends d).1, rn (Dx.ends d).2) = split {
   reflD p -> refl (rn p, rn p) ;
   symD d | r -> apH {Dc.Term * Dc.Term} {Dc.Term * Dc.Term} (\ w -> (w.2, w.1)) r ;
   transD d e' | rd re -> apH2 (Dc.ends (ren d)) (rn (Dx.ends d).1, rn (Dx.ends d).2) (Dc.ends (ren e')) (rn (Dx.ends e').1, rn (Dx.ends e').2) rd re (\ w w' -> (w.1, w'.2)) ;
   sumD d e' | rd re -> apH2 (Dc.ends (ren d)) (rn (Dx.ends d).1, rn (Dx.ends d).2) (Dc.ends (ren e')) (rn (Dx.ends e').1, rn (Dx.ends e').2) rd re (\ w w' -> (sumE w.1 w'.1, sumE w.2 w'.2)) ;
   mulD d e' | rd re -> apH2 (Dc.ends (ren d)) (rn (Dx.ends d).1, rn (Dx.ends d).2) (Dc.ends (ren e')) (rn (Dx.ends e').1, rn (Dx.ends e').2) rd re (\ w w' -> (mulE w.1 w'.1, mulE w.2 w'.2)) ;
   addAssoc p q r -> refl (Dc.ends (addAssoc (rn p) (rn q) (rn r))) ;
   addComm p q -> refl (Dc.ends (addComm (rn p) (rn q))) ;
   addZero p -> refl (Dc.ends (addZero (rn p))) ;
   addNeg p -> refl (Dc.ends (addNeg (rn p))) ;
   mulAssoc p q r -> refl (Dc.ends (mulAssoc (rn p) (rn q) (rn r))) ;
   mulComm p q -> refl (Dc.ends (mulComm (rn p) (rn q))) ;
   mulOne p -> refl (Dc.ends (mulOne (rn p))) ;
   distrib p q r -> refl (Dc.ends (distrib (rn p) (rn q) (rn r))) ;
   coeffAdd a b -> refl (Dc.ends (coeffAdd a b)) ;
   coeffMul a b -> refl (Dc.ends (coeffMul a b)) ;
   equation p m -> refl (Dc.ends (equation (rn p) (memL p x.2 m))) }
   where {
    apH2 (a a' b b' : Dc.Term * Dc.Term) (h : Id (Dc.Term * Dc.Term) a a') (k : Id (Dc.Term * Dc.Term) b b')
     (f : (Dc.Term * Dc.Term) -> (Dc.Term * Dc.Term) -> (Dc.Term * Dc.Term)) : Id (Dc.Term * Dc.Term) (f a b) (f a' b') =
     transH (apH {Dc.Term * Dc.Term} {Dc.Term * Dc.Term} (\ z -> f z b) h) (apH {Dc.Term * Dc.Term} {Dc.Term * Dc.Term} (f a') k) ;
   } ;
  -- validity is preserved
  valid-ren : (d : Dx.Tree) -> Dx.Valid d -> Dc.Valid (ren d) = split {
   reflD p -> \ v -> tt ; symD d | r -> r ;
   transD d e' | rd re -> \ v -> (rd v.1, (re v.2.1,
     transH (apH {Dc.Term * Dc.Term} {Dc.Term} (\ w -> w.2) (ends-ren d))
      (transH (apH {Dx.Term} {Dc.Term} rn v.2.2) (symH (apH {Dc.Term * Dc.Term} {Dc.Term} (\ w -> w.1) (ends-ren e')))))) ;
   sumD d e' | rd re -> \ v -> (rd v.1, re v.2) ; mulD d e' | rd re -> \ v -> (rd v.1, re v.2) ;
   addAssoc p q r -> \ v -> tt ; addComm p q -> \ v -> tt ; addZero p -> \ v -> tt ; addNeg p -> \ v -> tt ;
   mulAssoc p q r -> \ v -> tt ; mulComm p q -> \ v -> tt ; mulOne p -> \ v -> tt ; distrib p q r -> \ v -> tt ;
   coeffAdd a b -> \ v -> tt ; coeffMul a b -> \ v -> tt ; equation p m -> \ v -> tt } ;
  -- a proof of t ~ u over x is a proof of rn t ~ rn u over x.u
  proof-ren (t u : Dx.Term) (w : Dx.Proof t u) : Dc.Proof (rn t) (rn u) =
   (ren w.1, (valid-ren w.1 w.2.1,
    (transH (apH {Dc.Term * Dc.Term} {Dc.Term} (\ z -> z.1) (ends-ren w.1)) (apH {Dx.Term} {Dc.Term} rn w.2.2.1),
     transH (apH {Dc.Term * Dc.Term} {Dc.Term} (\ z -> z.2) (ends-ren w.1)) (apH {Dx.Term} {Dc.Term} rn w.2.2.2)))) ;
 } ;
} ;
