-- CDIn8.seg (canonicity-c2; (d)(2), part 8): injectivity of fwd: over nil.H
-- (pairs of homs x.u -> y with the same fwd image) the two homs are equal (the
-- generic (U) at x.u, CUG30, with the generator cases of CDIn6/CDIn7).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module In8 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module I6 = CDIn6[a].In6[R, encK, pe, x, u, y] ;
 module I7 = CDIn7[a].In7[R, encK, pe, x, u, y] ;
 module K2 = I6.K2 ;
 module F2m = I7.F2m ;
 module U20m = K2.U20m ;
 GH : C.Ctx = K2.GH ;
 m : Nat = I7.m ;
 IdZ (c : C.El C.nil U20m.QA) : C.Ty GH = U20m.IdZ c ;
 genC (v : F2m.Fk m) : F2m.Cls m v -> C.El GH (IdZ (U20m.HZ.AS.AX.cls (var v))) = split {
  inl c -> subst (F2m.Fk m) (\ w -> C.El GH (IdZ (U20m.HZ.AS.AX.cls (var w)))) (F2m.emb m c.1) v (symH c.2) (I6.old c.1) ;
  inr c -> subst (F2m.Fk m) (\ w -> C.El GH (IdZ (U20m.HZ.AS.AX.cls (var w)))) (F2m.newI m c.1) v (symH c.2) (I7.newG c.1) } ;
 gen (v : F2m.Fk m) : C.El GH (IdZ (U20m.HZ.AS.AX.cls (var v))) = genC v (F2m.cls m v) ;
 module U30m = CUG30[a].UG30[R, encK, pe, K2.F2, y, K2.H, K2.pkA, K2.pkB, K2.pkAN, K2.pkBN, gen] ;
 inj : C.El GH (IJ.IdT GH U30m.HSh U30m.zA U30m.zB) = U30m.res ;
} ;
