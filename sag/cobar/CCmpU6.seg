-- CCmpU6.seg (canonicity-c2; (K) for cmpI, part 6): a weakened closed
-- function over nil.Hs, moved along Pi-nat, keeps its function family:
-- the code path is PresheafPi.PiNat's RJ (V is a set), read by trS.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

module TR6 (Hs Qa Qy : C.Ty C.nil) {
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = Hs ;
 QA : C.Ty Nl = Qa ;
 QY : C.Ty Nl = Qy ;
 D1 : C.Ctx = C.ext Nl HS ;
 module PN = PresheafPi[a, a+].PPi[PosFull[a].PB.BC].PiNat[D1, Nl, QA.1, (OV.wkT Nl QA QY).1, C.p Nl HS] ;
 rjT (K : Ob) (v : V1.Ix (HS.1.tob K tt)) : Id V1.V ((OV.wkT Nl HS (OV.Fun Nl QA QY)).1.tob K (tt, v)) (PN.PD.PiO K (tt, v)) = PN.RJ K (tt, v) ;
 PDt (K : Ob) (v : V1.Ix (HS.1.tob K tt)) : Id V1.V (PN.PD.PiO K (tt, v)) ((FibCwF[a, a+].fibPi.Pi D1 (C.subT D1 Nl QA (C.p Nl HS)) (C.subT (C.ext D1 (C.subT D1 Nl QA (C.p Nl HS))) (C.ext Nl QA) (OV.wkT Nl QA QY) (C.lift D1 Nl QA (C.p Nl HS)))).1.tob K (tt, v)) = refl (PN.PD.PiO K (tt, v)) ;
 -- the map of a weakened closed function, transported along Pi-nat, keeps its family
 A' : C.Ty D1 = C.subT D1 Nl QA (C.p Nl HS) ;
 B' : C.Ty (C.ext D1 A') = C.subT (C.ext D1 A') (C.ext Nl QA) (OV.wkT Nl QA QY) (C.lift D1 Nl QA (C.p Nl HS)) ;
 PiT : C.Ty D1 = FibCwF[a, a+].fibPi.Pi D1 A' B' ;
 PNt : Id (C.Ty D1) (OV.wkT Nl HS (OV.Fun Nl QA QY)) PiT = FibCwF[a, a+].fibPi.Pi-nat D1 Nl QA (OV.wkT Nl QA QY) (C.p Nl HS) ;
 substPi (K : Ob) (T : U a++) (pi : T -> V1.Ix (Nl.ob K)) (Fc : V1.Ix (Nl.ob K) -> U a++) (x y : T) (p : Id T x y)
   (hx : Id (V1.Ix (Nl.ob K)) (pi x) tt) (c : Fc (pi x)) : Id (Fc (pi y)) (subst T (\ t -> Fc (pi t)) x y p c) (subst (V1.Ix (Nl.ob K)) Fc (pi x) (pi y) (apH {T} {V1.Ix (Nl.ob K)} pi p) c) =
  idJ T x (\ y2 p2 -> Id (Fc (pi y2)) (subst T (\ t -> Fc (pi t)) x y2 p2 c) (subst (V1.Ix (Nl.ob K)) Fc (pi x) (pi y2) (apH {T} {V1.Ix (Nl.ob K)} pi p2) c))
    (refl c) y p ;
 loopTop (K : Ob) (Fc : V1.Ix (Nl.ob K) -> U a++) (e : Id (V1.Ix (Nl.ob K)) tt tt) (c : Fc tt) : Id (Fc tt) (subst (V1.Ix (Nl.ob K)) Fc tt tt e c) c =
  apH {Id (V1.Ix (Nl.ob K)) tt tt} {Fc tt} (\ e2 -> subst (V1.Ix (Nl.ob K)) Fc tt tt e2 c) (loop-refl (V1.Ix (Nl.ob K)) (V1.isSetIx (Nl.ob K)) tt e) ;
 module TRd (e : C.El D1 (OV.wkT Nl HS (OV.Fun Nl QA QY))) {
  E : C.El D1 PiT = OV.trE D1 (OV.wkT Nl HS (OV.Fun Nl QA QY)) PiT PNt e ;
  module R (K : Ob) (v : V1.Ix (HS.1.tob K tt)) (u : V1.Ix (QA.1.tob K tt)) {
   x : V1.Ix (D1.ob K) = (tt, v) ;
   cS : Id (V1.Ix (PiT.1.tob K x)) (subst V1.V (\ c -> V1.Ix c) (PN.PG.PiO K tt) (PN.PD.PiO K x) (PN.RJ K x) (e.eob K x))
          (PresheafPi[a, a+].PPi[PosFull[a].PB.BC].coeIx (PN.PG.PiO K tt) (PN.PD.PiO K x) (PN.RJ K x) (e.eob K x)) =
    idJ V1.V (PN.PG.PiO K tt)
      (\ c2 R2 -> Id (V1.Ix c2) (subst V1.V (\ c -> V1.Ix c) (PN.PG.PiO K tt) c2 R2 (e.eob K x))
                    (PresheafPi[a, a+].PPi[PosFull[a].PB.BC].coeIx (PN.PG.PiO K tt) c2 R2 (e.eob K x)))
      (refl (e.eob K x)) (PN.PD.PiO K x) (PN.RJ K x) ;
   cx : V1.Ix (PiT.1.tob K x) = PresheafPi[a, a+].PPi[PosFull[a].PB.BC].coeIx (PN.PG.PiO K tt) (PN.PD.PiO K x) (PN.RJ K x) (e.eob K x) ;
   m1 : V1.Ix (PiT.1.tob K x) = subst (C.Ty D1) (\ T -> V1.Ix (T.1.tob K x)) (OV.wkT Nl HS (OV.Fun Nl QA QY)) PiT PNt (e.eob K x) ;
   m2 : V1.Ix (PiT.1.tob K x) = subst V1.V (\ c -> V1.Ix c) (PN.PG.PiO K tt) (PN.PD.PiO K x) (PN.RJ K x) (e.eob K x) ;
   s1 : Id (V1.Ix (PiT.1.tob K x)) (E.eob K x) cx =
    trans (V1.Ix (PiT.1.tob K x)) (E.eob K x) m1 cx
     (CAppRd[a].trE-rd D1 (OV.wkT Nl HS (OV.Fun Nl QA QY)) PiT PNt e K x)
     (trans (V1.Ix (PiT.1.tob K x)) m1 m2 cx
        (CAppRd[a].same-rd D1 (OV.wkT Nl HS (OV.Fun Nl QA QY)) PiT PNt K x (PN.RJ K x) (e.eob K x)) cS) ;
   v0 : V1.Ix ((OV.wkT Nl HS (OV.Fun Nl QA QY)).1.tob K x) = e.eob K x ;
   y0 : V1.Ix (Nl.ob K) = Nl.act K K (idH K) tt ;
   y1 : V1.Ix (Nl.ob K) = (C.p Nl HS).nt K (D1.act K K (idH K) x) ;
   hs : Id (V1.Ix (Nl.ob K)) y0 y1 = PN.hs K x K (idH K) ;
   bkv : V1.Ix (QA.1.tob K y0) = PresheafPi[a, a+].PPi[PosFull[a].PB.BC].bk Nl QA.1 K y0 y1 hs u ;
   s2 : Id (V1.Ix (QY.1.tob K y1)) (cx.1 K (idH K) u)
          (subst (V1.Ix ((C.ext Nl QA).ob K)) (\ w -> V1.Ix (QY.1.tob K w.1)) (y0, bkv) (y1, u)
             (PresheafPi[a, a+].PPi[PosFull[a].PB.BC].pairpath Nl QA.1 K y0 y1 hs u) (v0.1 K (idH K) bkv)) =
    PN.trS K x v0 K (idH K) u ;
   s3 : Id (V1.Ix (QY.1.tob K y1))
          (subst (V1.Ix ((C.ext Nl QA).ob K)) (\ w -> V1.Ix (QY.1.tob K w.1)) (y0, bkv) (y1, u)
             (PresheafPi[a, a+].PPi[PosFull[a].PB.BC].pairpath Nl QA.1 K y0 y1 hs u) (v0.1 K (idH K) bkv))
          (v0.1 K (idH K) bkv) =
    transH (substPi K (V1.Ix ((C.ext Nl QA).ob K)) (\ w -> w.1) (\ o -> V1.Ix (QY.1.tob K o)) (y0, bkv) (y1, u)
              (PresheafPi[a, a+].PPi[PosFull[a].PB.BC].pairpath Nl QA.1 K y0 y1 hs u) (refl tt) (v0.1 K (idH K) bkv))
      (loopTop K (\ o -> V1.Ix (QY.1.tob K o)) _ (v0.1 K (idH K) bkv)) ;
   s4 : Id (V1.Ix (QA.1.tob K tt)) bkv u =
    transH (substPi K (V1.Ix (Nl.ob K)) (\ o -> o) (\ o -> V1.Ix (QA.1.tob K o)) y1 y0 (sym (V1.Ix (Nl.ob K)) y0 y1 hs) (refl tt) u)
      (loopTop K (\ o -> V1.Ix (QA.1.tob K o)) _ u) ;
   rdE : Id (V1.Ix (QY.1.tob K tt)) ((E.eob K x).1 K (idH K) u) (v0.1 K (idH K) u) =
    transH (apH {V1.Ix (PiT.1.tob K x)} {V1.Ix (QY.1.tob K tt)} (\ w -> w.1 K (idH K) u) s1)
     (transH s2 (transH s3 (apH {V1.Ix (QA.1.tob K tt)} {V1.Ix (QY.1.tob K tt)} (\ c -> v0.1 K (idH K) c) s4))) ;
  } ;
 } ;
 -- the body of an element of PiT reads as its family at the identity
 module BDP (F : C.El D1 PiT) (K : Ob) (v : V1.Ix (HS.1.tob K tt)) (u : V1.Ix (QA.1.tob K tt)) {
  module PP = PresheafPi[a, a+].PPi[PosFull[a].PB.BC] ;
  x : V1.Ix (D1.ob K) = (tt, v) ;
  a0 : V1.Ix (QA.1.tob K tt) = PP.bk D1 A'.1 K (D1.act K K (idH K) x) x (D1.act-id K x) u ;
  val0 : V1.Ix (QY.1.tob K tt) = (F.eob K x).1 K (idH K) a0 ;
  w0 : V1.Ix ((C.ext D1 A').ob K) = (D1.act K K (idH K) x, a0) ;
  pp : Id (V1.Ix ((C.ext D1 A').ob K)) w0 (x, u) = PP.pairpath D1 A'.1 K (D1.act K K (idH K) x) x (D1.act-id K x) u ;
  s1 : Id (V1.Ix (QY.1.tob K tt)) ((OV.bod D1 A' B' F).eob K (x, u))
         (subst (V1.Ix ((C.ext D1 A').ob K)) (\ w1 -> V1.Ix (QY.1.tob K w1.1.1)) w0 (x, u) pp val0) =
   refl ((OV.bod D1 A' B' F).eob K (x, u)) ;
  s2 : Id (V1.Ix (QY.1.tob K tt)) (subst (V1.Ix ((C.ext D1 A').ob K)) (\ w1 -> V1.Ix (QY.1.tob K w1.1.1)) w0 (x, u) pp val0) val0 =
   transH (substPi K (V1.Ix ((C.ext D1 A').ob K)) (\ w1 -> w1.1.1) (\ o -> V1.Ix (QY.1.tob K o)) w0 (x, u) pp (refl tt) val0)
     (loopTop K (\ o -> V1.Ix (QY.1.tob K o)) _ val0) ;
  s3' : Id (V1.Ix (QA.1.tob K tt)) a0 u =
   transH (substPi K (V1.Ix (D1.ob K)) (\ w -> w.1) (\ o -> V1.Ix (QA.1.tob K o)) x (D1.act K K (idH K) x)
             (sym (V1.Ix (D1.ob K)) (D1.act K K (idH K) x) x (D1.act-id K x)) (refl tt) u)
     (loopTop K (\ o -> V1.Ix (QA.1.tob K o)) _ u) ;
  bdR : Id (V1.Ix (QY.1.tob K tt)) ((OV.bod D1 A' B' F).eob K (x, u)) ((F.eob K x).1 K (idH K) u) =
   transH s1 (transH s2 (apH {V1.Ix (QA.1.tob K tt)} {V1.Ix (QY.1.tob K tt)} (\ c -> (F.eob K x).1 K (idH K) c) s3')) ;
 } ;
} ;
