-- CHtIdG.seg (canonicity-45; COBAR.md "Prop 58"; c2's pointer to
-- QinvEq.HtpyOf): at the total site G1, a path homotopy H : f ~ g of maps
-- X -> Y over a context Gamma (Y fibrant) gives an element of the internal Id
-- type over Gamma.X between f and g read as elements (GFibNF.LineY with the
-- line field H at (id, j), coerced into the fibre) — the reverse of IdRd.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module HI (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module G1 = CCopy[a].ConcC[R, encK, pe].TR.G1 ;
 module GB = G1.GB ;
 module PS1 = GB.GPre[a+].PS ;
 module HO1 = GB.CHtpyOps[a+] ;
 TO : U a+ = CTotCat[a, a+, a+].TotOf[CCopy[a].ConcC[R, encK, pe].CM.IC].TOb ;
 TH (Y X : TO) : U a+ = CTotCat[a, a+, a+].TotOf[CCopy[a].ConcC[R, encK, pe].CM.IC].THm Y X ;
 module At (Gm : PS1.PCtx) (X : PS1.PTy[Gm]) (Y : G1.fibCwF-T.Ty Gm) (f g : HO1.NMap[Gm, X, Y.1])
   (H : PS1.PEl[PS1.extP Gm X, HO1.HT[Gm, X, Y.1, f, g].PT.PathP]) {
  module T = HO1.HT[Gm, X, Y.1, f, g] ;
  module TY = GB.GPre[a+].TyL[Gm, Y.1] ;
  K : PS1.PCtx = PS1.extP Gm X ;
  YY : G1.fibCwF-T.Ty K = G1.fibCwF-T.subT K Gm Y (PS1.pP Gm X) ;
  -- f and g as elements over Gamma.X
  module EF (u : HO1.NMap[Gm, X, Y.1]) {
   eb (W : TO) (z : V1.Ix (K.ob W)) : V1.Ix (YY.1.tob W z) = u.nfun W z.1 z.2 ;
   en0 (J I : TO) (h : TH J I) (z : V1.Ix (K.ob I))
    : Id (V1.Ix (YY.1.tob J (K.act J I h z))) (YY.1.tact J I h z (K.act J I h z) (refl (K.act J I h z)) (eb I z)) (eb J (K.act J I h z)) =
    transH (PS1.tact-irr Gm Y.1 J I h z.1 (Gm.act J I h z.1) (PS1.ntEq K Gm (PS1.pP Gm X) J I h z (K.act J I h z) (refl (K.act J I h z))) (refl (Gm.act J I h z.1)) (eb I z))
     (u.nnat J I h z.1 (Gm.act J I h z.1) (refl (Gm.act J I h z.1)) z.2) ;
   el : PS1.PEl[K, YY.1] = PS1.mkPEl K YY.1 eb (\ J I h z z' e ->
    idJ (V1.Ix (K.ob J)) (K.act J I h z) (\ z2 e2 -> Id (V1.Ix (YY.1.tob J z2)) (YY.1.tact J I h z z2 e2 (eb I z)) (eb J z2)) (en0 J I h z) z' e) ;
  } ;
  a0 : PS1.PEl[K, YY.1] = EF[f].el ;
  b0 : PS1.PEl[K, YY.1] = EF[g].el ;
  -- the line field: H at (id, j), coerced into the fibre
  pvz (W : TO) (z : V1.Ix (K.ob W)) (j : GB.IvP W) : TY.EI W = T.pv H W z W (GB.idH W) j ;
  pteq (W : TO) (z : V1.Ix (K.ob W)) (j : GB.IvP W) : Id (V1.Ix (Gm.ob W)) (TY.pr1 W (pvz W z j)) z.1 =
   transH ((H.eob W z).2.1 W (GB.idH W) j) (Gm.act-id W z.1) ;
  Lf (W : TO) (z : V1.Ix (K.ob W)) (j : GB.IvP W) : V1.Ix (YY.1.tob W z) = TY.coeT W (TY.pr1 W (pvz W z j)) z.1 (pteq W z j) (TY.pr2 W (pvz W z j)) ;
  Lf-rd (W : TO) (z : V1.Ix (K.ob W)) (j : GB.IvP W) : Id (TY.EI W) (TY.pr W z.1 (Lf W z j)) (pvz W z j) =
   symH (TY.pr-coe W (TY.pr1 W (pvz W z j)) z.1 (pteq W z j) (TY.pr2 W (pvz W z j))) ;
  Unat (V W : TO) (g0 : TH V W) (z : V1.Ix (K.ob W)) (z' : V1.Ix (K.ob V)) (E : Id (V1.Ix (K.ob V)) (K.act V W g0 z) z') (j : GB.IvP W)
   : Id (V1.Ix (YY.1.tob V z')) (YY.1.tact V W g0 z z' E (Lf W z j)) (Lf V z' (GB.ivA V W g0 j)) =
   TY.pr-inj V z'.1 (YY.1.tact V W g0 z z' E (Lf W z j)) (Lf V z' (GB.ivA V W g0 j))
    (transH (symH (TY.pr-tact V W g0 z.1 z'.1 (PS1.ntEq K Gm (PS1.pP Gm X) V W g0 z z' E) (Lf W z j)))
     (transH (apH {TY.EI W} {TY.EI V} (TY.E.act V W g0) (Lf-rd W z j))
      (transH ((H.eob W z).1.2 V W g0 (GB.idH W) j)
       (transH (apH {TH V W} {TY.EI V} (\ k0 -> T.pv H W z V k0 (GB.ivA V W g0 j)) (transH (GB.comp-idl V W g0) (symH (GB.comp-idr V W g0))))
        (transH (T.pv-res H V W g0 z z' E V (GB.idH V) (GB.ivA V W g0 j))
          (symH (Lf-rd V z' (GB.ivA V W g0 j)))))))) ;
  U0 (W : TO) (z : V1.Ix (K.ob W)) : Id (V1.Ix (YY.1.tob W z)) (Lf W z (GB.ptH W GB.e0)) (a0.eob W z) =
   TY.pr-inj W z.1 (Lf W z (GB.ptH W GB.e0)) (a0.eob W z) (transH (Lf-rd W z (GB.ptH W GB.e0)) (H.eob W z).2.2.1) ;
  U1 (W : TO) (z : V1.Ix (K.ob W)) : Id (V1.Ix (YY.1.tob W z)) (Lf W z (GB.ptH W GB.e1)) (b0.eob W z) =
   TY.pr-inj W z.1 (Lf W z (GB.ptH W GB.e1)) (b0.eob W z) (transH (Lf-rd W z (GB.ptH W GB.e1)) (H.eob W z).2.2.2) ;
  module LY = G1.FT.GFibNF[a+].LineY[K, YY.1, a0, b0, Lf, Unat, U0, U1] ;
  -- f = g as an element of the internal Id type over Gamma.X
  el : G1.fibCwF-T.El K (G1.fibId-T.IdT K YY a0 b0) = LY.el ;
 } ;
} ;
