-- CwFQuotElim1.seg (canonicity-c2; SIMPLIFIED.md item 3): the quotient
-- package QE1 for canonicity-45, at the base FibCwF, for the presented
-- algebra's quotient Qt (CAlgX.AlgX), in the shapes agreed (CQCtx.G3Of,
-- CAlgX, CFreeMaps).  Part 1: set-ness.
--   setQi   Pi (q q' : Qt) isProp (Id(q , q'))     (G3Of[Qt].SetQiTy)
--   setQ    the same at two global elements
--   setW    the same at two elements over nil.Qt   (CAlgLaws' setW)
--   elimP1  elimination into a family of propositions over nil.Qt, from
--           its values at the classes of terms   (G3Of[Qt].ElimP1Ty)
-- From CwFSetX3 (Hedberg-Kraus, CwFHed1-4, applied to Qt = Sigma PA ||S||).
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module QE1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module AX = CAlgX[a].AlgX[R, encK, x, pe] ;
 module QQ = AX.QQ ;
 module GQ = CQCtx[a].G3Of[AX.Qt] ;
 Nl : C.Ctx = C.nil ;
 Qt : C.Ty Nl = AX.Qt ;
 module S3 = CwFSetX3.SetX3[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv,
   FibNF[a, a+].nf, pe].SP[Nl, AX.RP.Tm, QQ.TrS, CTruncAtBase[a].truncAt.trProp QQ.K QQ.S] ;
 -- Qt is a set, internally: S3's reading at the two variables of GQ.G2
 s2 : C.Sub GQ.G2 Nl = C.o GQ.G2 GQ.G1 Nl (C.p Nl Qt) (C.p GQ.G1 GQ.Qw) ;
 PY : Id (C.Ty GQ.G2) (C.subT GQ.G2 Nl Qt s2) GQ.Qw2 = C.subT-o GQ.G2 GQ.G1 Nl Qt (C.p Nl Qt) (C.p GQ.G1 GQ.Qw) ;
 sp : C.El GQ.G2 GQ.SP = S3.At[GQ.G2, s2, GQ.Qw2, PY, GQ.v1, GQ.v2].law ;
 setQi : GQ.SetQiTy = OV.lam Nl Qt (FibCwF[a, a+].fibPi.Pi GQ.G1 GQ.Qw GQ.SP) (OV.lam GQ.G1 GQ.Qw GQ.SP sp) ;
 -- at two global elements
 setQ (q q' : C.El Nl Qt) : C.El Nl (PU.isProp Nl (AX.IdQ q q')) = S3.At[Nl, C.id Nl, Qt, C.subT-id Nl Qt, q, q'].law ;
 -- at two elements over nil.Qt
 setW (a1 b1 : C.El GQ.G1 GQ.Qw) : C.El GQ.G1 (PU.isProp GQ.G1 (IJ.IdT GQ.G1 GQ.Qw a1 b1)) =
  S3.At[GQ.G1, C.p Nl Qt, GQ.Qw, refl GQ.Qw, a1, b1].law ;

 -- elimination into propositions, from global classes
 module QEP = CwFQuotElimP.QuotElimP[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId,
   FibUniv[a].fibUniv, FibNF[a, a+].nf, CTruncAtBase[a].truncAt] ;
 module LM = AX.RP.LM ;
 Tm : C.Ty Nl = AX.RP.Tm ;
 D : C.Ctx = C.ext Nl Tm ;
 clsS : C.Sub D GQ.G1 = QEP.Ctxs[Nl, Tm, AX.RP.r].clsS ;
 -- sec of the class of t is Sec1 at it (pointwise refl), and the class map
 -- after sec t is sec of the class (CwFQuotElimP.IS)
 sS1 (t : AX.Term) : Id (C.Sub Nl GQ.G1) (C.sec Nl Qt (AX.cls t)) (GQ.Sec1[AX.cls t].sec1) =
  L.sub-ext Nl GQ.G1 (C.sec Nl Qt (AX.cls t)) (GQ.Sec1[AX.cls t].sec1) (\ K o -> refl (o, (AX.cls t).eob K o)) ;
 sEq (t : AX.Term) : Id (C.Sub Nl GQ.G1) (C.o Nl D GQ.G1 clsS (C.sec Nl Tm (AX.RP.ct t))) (GQ.Sec1[AX.cls t].sec1) =
  transH (QEP.IS[Nl, Tm, AX.RP.r, AX.RP.ct t].incS-sec) (sS1 t) ;
 module EP1 (P : C.Ty GQ.G1) (pPr : C.El GQ.G1 (PU.isProp GQ.G1 P))
   (h : (t1 : AX.Term) -> C.El Nl (C.subT Nl GQ.G1 P (GQ.Sec1[AX.cls t1].sec1))) {
  X : C.Ty D = C.subT D GQ.G1 P clsS ;
  PT (t : AX.Term) : Id (C.Ty Nl) (C.subT Nl GQ.G1 P (GQ.Sec1[AX.cls t].sec1)) (C.subT Nl D X (C.sec Nl Tm (AX.RP.ct t))) =
   transH (apH {C.Sub Nl GQ.G1} {C.Ty Nl} (\ s -> C.subT Nl GQ.G1 P s) (symH (sEq t))) (C.subT-o Nl D GQ.G1 P clsS (C.sec Nl Tm (AX.RP.ct t))) ;
  hD : C.El D X = LM.L.pack Nl X.1 (\ t -> OV.trE Nl (C.subT Nl GQ.G1 P (GQ.Sec1[AX.cls t].sec1)) (C.subT Nl D X (C.sec Nl Tm (AX.RP.ct t))) (PT t) (h t)) ;
  elimP1 : C.El GQ.G1 P = QEP.elimP Nl Tm AX.RP.r P pPr hD ;
 } ;
 elimP1 : GQ.ElimP1Ty AX.Term AX.cls = \ P pPr h -> EP1[P, pPr, h].elimP1 ;
} ;
