-- Pilot for relative ideal certificates in the base CwF.
-- For a fixed h-set ring over a context, a principal-ideal certificate
-- is a multiplier and an internal path x = y + f*r.  Given certificates
-- x = y + f*r and u = v + f*s, distributivity rewrites x*u as
-- y*v + f*(y*s + r*u).  Every equality below is an internal path;
-- no equality of external terms or strict ring law is used.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module PR = CPilotRing[a, a+] ;
C : CwF.CwF[a++] = PR.C ;

module Pilot (G : C.Ctx) (Rg : PR.HRing[G]) {
 module CG = PR.Cong[G, Rg] ;
 E : U a++ = C.El G Rg.R ;
 add (x y : E) : E = PR.ap2 G Rg.R Rg.add x y ;
 mul (x y : E) : E = PR.ap2 G Rg.R Rg.mul x y ;
 Idr (x y : E) : C.Ty G = CG.Idr x y ;
 Path (x y : E) : U a++ = C.El G (Idr x y) ;
 tr (x y z : E) (p : Path x y) (q : Path y z) : Path x z = CG.tr x y z p q ;
 sy (x y : E) (p : Path x y) : Path y x = CG.sy x y p ;

 -- (x+y)*u = x*u + y*u, from commutativity and left distributivity.
 distRight (x y u : E) : Path (mul (add x y) u) (add (mul x u) (mul y u)) =
  tr (mul (add x y) u) (mul u (add x y)) (add (mul x u) (mul y u))
   (Rg.mul-comm (add x y) u)
   (tr (mul u (add x y)) (add (mul u x) (mul u y)) (add (mul x u) (mul y u))
     (Rg.distr u x y)
     (CG.add2 (mul u x) (mul x u) (mul u y) (mul y u)
       (Rg.mul-comm u x) (Rg.mul-comm u y))) ;
 -- a*(b*c) = b*(a*c).
 mulSwap (a b c : E) : Path (mul a (mul b c)) (mul b (mul a c)) =
  tr (mul a (mul b c)) (mul (mul a b) c) (mul b (mul a c))
   (sy (mul (mul a b) c) (mul a (mul b c)) (Rg.mul-assoc a b c))
   (tr (mul (mul a b) c) (mul (mul b a) c) (mul b (mul a c))
     (CG.mulL (mul a b) (mul b a) c (Rg.mul-comm a b))
     (Rg.mul-assoc b a c)) ;

 module Principal (f : E) {
  Certificate (x y : E) : U a++ = (r : E) * Path x (add y (mul f r)) ;
  -- Products of congruent terms remain congruent modulo f.
  multiplication (x y u v : E) (h : Certificate x y) (k : Certificate u v)
   : Certificate (mul x u) (mul y v) =
   (add (mul y k.1) (mul h.1 u),
    tr (mul x u) (mul (add y (mul f h.1)) u)
       (add (mul y v) (mul f (add (mul y k.1) (mul h.1 u))))
     (CG.mulL x (add y (mul f h.1)) u h.2)
     (tr (mul (add y (mul f h.1)) u)
         (add (mul y u) (mul (mul f h.1) u))
         (add (mul y v) (mul f (add (mul y k.1) (mul h.1 u))))
       (distRight y (mul f h.1) u)
       (tr (add (mul y u) (mul (mul f h.1) u))
           (add (mul y (add v (mul f k.1))) (mul (mul f h.1) u))
           (add (mul y v) (mul f (add (mul y k.1) (mul h.1 u))))
         (CG.addL (mul y u) (mul y (add v (mul f k.1))) (mul (mul f h.1) u)
           (CG.mulR y u (add v (mul f k.1)) k.2))
         (tr (add (mul y (add v (mul f k.1))) (mul (mul f h.1) u))
             (add (add (mul y v) (mul y (mul f k.1))) (mul (mul f h.1) u))
             (add (mul y v) (mul f (add (mul y k.1) (mul h.1 u))))
           (CG.addL (mul y (add v (mul f k.1)))
             (add (mul y v) (mul y (mul f k.1))) (mul (mul f h.1) u)
             (Rg.distr y v (mul f k.1)))
           (tr (add (add (mul y v) (mul y (mul f k.1))) (mul (mul f h.1) u))
               (add (add (mul y v) (mul f (mul y k.1))) (mul f (mul h.1 u)))
               (add (mul y v) (mul f (add (mul y k.1) (mul h.1 u))))
             (CG.add2 (add (mul y v) (mul y (mul f k.1)))
               (add (mul y v) (mul f (mul y k.1)))
               (mul (mul f h.1) u) (mul f (mul h.1 u))
               (CG.addR (mul y v) (mul y (mul f k.1)) (mul f (mul y k.1))
                 (mulSwap y f k.1))
               (Rg.mul-assoc f h.1 u))
             (tr (add (add (mul y v) (mul f (mul y k.1))) (mul f (mul h.1 u)))
                 (add (mul y v) (add (mul f (mul y k.1)) (mul f (mul h.1 u))))
                 (add (mul y v) (mul f (add (mul y k.1) (mul h.1 u))))
               (Rg.add-assoc (mul y v) (mul f (mul y k.1)) (mul f (mul h.1 u)))
               (CG.addR (mul y v)
                 (add (mul f (mul y k.1)) (mul f (mul h.1 u)))
                 (mul f (add (mul y k.1) (mul h.1 u)))
                 (sy (mul f (add (mul y k.1) (mul h.1 u)))
                   (add (mul f (mul y k.1)) (mul f (mul h.1 u)))
                   (Rg.distr f (mul y k.1) (mul h.1 u)))))))))) ;
 } ;
} ;
