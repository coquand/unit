-- CTotUFib2.seg (canonicity-c2; SIMPLIFIED.md item 5): towards "U of a
-- fibration of the total site is a levelwise fibration".
--   XP   a partial line of U A over a levelwise sieve (a side at Y in the
--        levelwise site) extends to a side at Y in the total site, over
--        the same sieve: at a total map k = (image of cl k) . vp k it is
--        the extension of the side at cl k, restricted along vp k.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module UFib2 (C : CIntCat[a, vl].IC) {
 module UF = CTotUFib[a, vl, l].UFib[C] ;
 module UX = UF.UX ;
 module TR = UF.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;

 module Sd (G : P1.PCtx) (A : P1.PTy[G]) (e : G1.GB.IPt) {
  module EKm = UF.Ek[G, A, e] ;
  module EK1 = EKm.EK1 ;
  module EK0 = EKm.EK0 ;
  vp (Y : Ob0) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) : RN.Hom1 Z (RN.o (UX.lf Y Z k)) = TR.DS.Fact[Y, Z, k].vp ;

  module XP (Y : Ob0) (z0 : EK0.TV.EI Y) (s0 : EK0.PT.Side[Y, z0]) {
   z1 : EK1.TV.EI (RN.o Y) = EKm.XZ[Y, z0].z1 ;
   L (W : Ob1) (k : RN.Hom1 W (RN.o Y)) : Ob0 = UX.lf Y W k ;
   u (W : Ob1) (k : RN.Hom1 W (RN.o Y)) (i : G1.GB.Lands W (RN.o Y) s0.pQ k) : EK0.TS.EI (L W k) = s0.pv (L W k) (UX.cl Y W k) i ;
   x (W : Ob1) (k : RN.Hom1 W (RN.o Y)) (i : G1.GB.Lands W (RN.o Y) s0.pQ k) : EK1.TS.EI (RN.o (L W k)) = EKm.XS[L W k, u W k i].u1 ;
   pv : EK1.PT.PvTy (RN.o Y) s0.pQ = \ W k i -> EK1.TS.E.act W (RN.o (L W k)) (vp Y W k) (x W k i) ;
   module PP (W : Ob1) (k : RN.Hom1 W (RN.o Y)) (i : G1.GB.Lands W (RN.o Y) s0.pQ k) {
    Lk : Ob0 = L W k ;
    c : RN.Hom0 Lk Y = UX.cl Y W k ;
    m1 : Id (EK1.TV.EI (RN.o Lk)) (EK1.TS.pr1 (RN.o Lk) (x W k i)) (EKm.XZ[Lk, EK0.TV.E.act Lk Y c z0].z1) =
     trans (EK1.TV.EI (RN.o Lk)) (EK1.TS.pr1 (RN.o Lk) (x W k i)) (EKm.XZ[Lk, EK0.TS.pr1 Lk (u W k i)].z1) (EKm.XZ[Lk, EK0.TV.E.act Lk Y c z0].z1)
      (EK1.mkTS-pt (RN.o Lk) EKm.XS[Lk, u W k i].Z.z1 EKm.XS[Lk, u W k i].L.line (refl EKm.XS[Lk, u W k i].Z.x1) EKm.XS[Lk, u W k i].q)
      (ap (EK0.TV.EI Lk) (EK1.TV.EI (RN.o Lk)) (\ z -> EKm.XZ[Lk, z].z1) (EK0.TS.pr1 Lk (u W k i)) (EK0.TV.E.act Lk Y c z0) (s0.ppt Lk c i)) ;
    m2 : Id (EK1.TV.EI (RN.o Lk)) (EK1.TS.pr1 (RN.o Lk) (x W k i)) (EK1.TV.E.act (RN.o Lk) (RN.o Y) (TR.fn.onH Lk Y c) z1) =
     trans (EK1.TV.EI (RN.o Lk)) (EK1.TS.pr1 (RN.o Lk) (x W k i)) (EKm.XZ[Lk, EK0.TV.E.act Lk Y c z0].z1) (EK1.TV.E.act (RN.o Lk) (RN.o Y) (TR.fn.onH Lk Y c) z1)
      m1 (symH EKm.ZN[Lk, Y, c, z0].nat) ;
    ppt : Id (EK1.TV.EI W) (EK1.TS.pr1 W (pv W k i)) (EK1.TV.E.act W (RN.o Y) k z1) =
     trans (EK1.TV.EI W) (EK1.TV.E.act W (RN.o Lk) (vp Y W k) (EK1.TS.pr1 (RN.o Lk) (x W k i)))
       (EK1.TV.E.act W (RN.o Lk) (vp Y W k) (EK1.TV.E.act (RN.o Lk) (RN.o Y) (TR.fn.onH Lk Y c) z1)) (EK1.TV.E.act W (RN.o Y) k z1)
      (ap (EK1.TV.EI (RN.o Lk)) (EK1.TV.EI W) (\ z -> EK1.TV.E.act W (RN.o Lk) (vp Y W k) z) (EK1.TS.pr1 (RN.o Lk) (x W k i))
         (EK1.TV.E.act (RN.o Lk) (RN.o Y) (TR.fn.onH Lk Y c) z1) m2)
      (trans (EK1.TV.EI W) (EK1.TV.E.act W (RN.o Lk) (vp Y W k) (EK1.TV.E.act (RN.o Lk) (RN.o Y) (TR.fn.onH Lk Y c) z1))
         (EK1.TV.E.act W (RN.o Y) (G1.GB.BC.oC W (RN.o Lk) (RN.o Y) (TR.fn.onH Lk Y c) (vp Y W k)) z1) (EK1.TV.E.act W (RN.o Y) k z1)
         (symH (EK1.TV.E.act-o W (RN.o Lk) (RN.o Y) (TR.fn.onH Lk Y c) (vp Y W k) z1))
         (ap (RN.Hom1 W (RN.o Y)) (EK1.TV.EI W) (\ w -> EK1.TV.E.act W (RN.o Y) w z1) (G1.GB.BC.oC W (RN.o Lk) (RN.o Y) (TR.fn.onH Lk Y c) (vp Y W k)) k
            TR.DS.Fact[Y, W, k].vp-eq)) ;
   } ;
   module PN (W' W : Ob1) (chi : RN.Hom1 W' W) (k : RN.Hom1 W (RN.o Y)) (i : G1.GB.Lands W (RN.o Y) s0.pQ k)
     (i' : G1.GB.Lands W' (RN.o Y) s0.pQ (G1.GB.BC.oC W' W (RN.o Y) k chi)) {
    module N = UX.FI.Nt[Y, W, W', chi, k] ;
    j : G0.GB.Lands N.L' Y s0.pQ (G0.GB.BC.oC N.L' N.L Y (UX.cl Y W k) N.d) = G0.GB.lands-comp N.L' N.L Y s0.pQ (UX.cl Y W k) N.d i ;
    u' : EK0.TS.EI N.L' = EK0.TS.E.act N.L' N.L N.d (u W k i) ;
    e1 : Id (EK0.TS.EI N.L') u' (u W' N.kg i') =
     trans (EK0.TS.EI N.L') u' (s0.pv N.L' (G0.GB.BC.oC N.L' N.L Y (UX.cl Y W k) N.d) j) (u W' N.kg i')
      (s0.pnat N.L' N.L N.d (UX.cl Y W k) i j)
      (EK0.PT.pv-hom Y z0 s0 N.L' (G0.GB.BC.oC N.L' N.L Y (UX.cl Y W k) N.d) (UX.cl Y W' N.kg) N.d-cl j i') ;
    a0 : EK1.TS.EI (RN.o N.L) = x W k i ;
    s1 : Id (EK1.TS.EI W') (EK1.TS.E.act W' W chi (pv W k i)) (EK1.TS.E.act W' (RN.o N.L') (vp Y W' N.kg) (EK1.TS.E.act (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) a0)) =
     trans (EK1.TS.EI W') (EK1.TS.E.act W' W chi (pv W k i)) (EK1.TS.E.act W' (RN.o N.L) N.v a0)
       (EK1.TS.E.act W' (RN.o N.L') (vp Y W' N.kg) (EK1.TS.E.act (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) a0))
      (symH (EK1.TS.E.act-o W' W (RN.o N.L) (vp Y W k) chi a0))
      (trans (EK1.TS.EI W') (EK1.TS.E.act W' (RN.o N.L) N.v a0)
         (EK1.TS.E.act W' (RN.o N.L) (G1.GB.BC.oC W' (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) (vp Y W' N.kg)) a0)
         (EK1.TS.E.act W' (RN.o N.L') (vp Y W' N.kg) (EK1.TS.E.act (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) a0))
         (ap (RN.Hom1 W' (RN.o N.L)) (EK1.TS.EI W') (\ w -> EK1.TS.E.act W' (RN.o N.L) w a0) N.v
            (G1.GB.BC.oC W' (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) (vp Y W' N.kg)) (symH N.d-vp))
         (EK1.TS.E.act-o W' (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) (vp Y W' N.kg) a0)) ;
    s2 : Id (EK1.TS.EI (RN.o N.L')) (EK1.TS.E.act (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) a0) (x W' N.kg i') =
     trans (EK1.TS.EI (RN.o N.L')) (EK1.TS.E.act (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) a0) (EKm.XS[N.L', u'].u1) (x W' N.kg i')
      EKm.SN[N.L', N.L, N.d, u W k i].nat
      (ap (EK0.TS.EI N.L') (EK1.TS.EI (RN.o N.L')) (\ w -> EKm.XS[N.L', w].u1) u' (u W' N.kg i') e1) ;
    pnat : Id (EK1.TS.EI W') (EK1.TS.E.act W' W chi (pv W k i)) (pv W' (G1.GB.BC.oC W' W (RN.o Y) k chi) i') =
     trans (EK1.TS.EI W') (EK1.TS.E.act W' W chi (pv W k i))
       (EK1.TS.E.act W' (RN.o N.L') (vp Y W' N.kg) (EK1.TS.E.act (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) a0))
       (pv W' N.kg i')
      s1
      (ap (EK1.TS.EI (RN.o N.L')) (EK1.TS.EI W') (\ w -> EK1.TS.E.act W' (RN.o N.L') (vp Y W' N.kg) w)
         (EK1.TS.E.act (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) a0) (x W' N.kg i') s2) ;
   } ;
   side : EK1.PT.Side[RN.o Y, z1] =
    EK1.PT.mkSide (RN.o Y) z1 s0.pQ pv (\ W k i -> PP[W, k, i].ppt) (\ W' W chi k i i' -> PN[W', W, chi, k, i, i'].pnat) ;
  } ;
 } ;
} ;
