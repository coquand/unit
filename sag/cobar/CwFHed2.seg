-- CwFHed2.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit for the
-- quotient's set-ness): two J-facts about Id(x , -), in a CwF with Pi,
-- Sigma and Swan Id.
--   L0     the transport of refl along u in Id(x , -) is u
--   K      "precomposition with the inverse": over the context
--          H = G.A.Id(x , t) (variables t , w) and J on (z , c) with
--          c : Id(x , z), kap (t , w , z , c) : Id(z , t), with
--          kap (t , w , x , refl) = w (J-beta).  At the diagonal
--          (z , c) = (t , w) it is refl (Lk, by J on (t , w): at the
--          centre the diagonal map IS kap's centre, so J-beta computes it).
-- No substitution of a J-term is needed except through its own centre.
open Base ;

module Hed2 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;

  -- the composite of two over-paths, with the composite type path
  comp3 (E D G : Ctx) (A : Ty G) (s1 : Sub D G) (s2 : Sub E D) (A1 : Ty D) (P1 : Id (Ty D) (subT D G A s1) A1)
    (A2 : Ty E) (P2 : Id (Ty E) (subT E D A1 s2) A2) : Id (Ty E) (subT E G A (o E D G s1 s2)) A2 =
    trans (Ty E) (subT E G A (o E D G s1 s2)) (subT E D (subT D G A s1) s2) A2
      (subT-o E D G A s1 s2)
      (trans (Ty E) (subT E D (subT D G A s1) s2) (subT E D A1 s2) A2 (ap (Ty D) (Ty E) (\ X -> subT E D X s2) (subT D G A s1) A1 P1) P2) ;
  ovC (E D G : Ctx) (A : Ty G) (s1 : Sub D G) (s2 : Sub E D) (A1 : Ty D) (P1 : Id (Ty D) (subT D G A s1) A1)
    (A2 : Ty E) (P2 : Id (Ty E) (subT E D A1 s2) A2) (a : El G A) (a1 : El D A1) (a2 : El E A2)
    (e1 : Ov D G A s1 A1 P1 a a1) (e2 : Ov E D A1 s2 A2 P2 a1 a2)
    : Ov E G A (o E D G s1 s2) A2 (comp3 E D G A s1 s2 A1 P1 A2 P2) a a2 =
    JP.ovO E D G A s1 s2 A1 P1 A2 P2 (comp3 E D G A s1 s2 A1 P1 A2 P2) a a1 a2 e1 e2 ;

  -- L0: transport of refl along u in Id(x , -), read in Id(x , -) at y
  module L0 (G : Ctx) (A : Ty G) (x : El G A) {
    GA : Ctx = ext G A ;
    IK : Ty GA = JP.IK G A x ;
    Dx : Ctx = JP.Dx G A x ;
    CI : Ty Dx = TR.CMt G A x IK ;
    r0 : El G (subT G GA IK (sec G A x)) = DJ.reflE G A x ;
    JTI : El Dx CI = TR.JT G A x IK r0 ;
    qv : El Dx CI = q GA IK ;
    M0 : Ty Dx = IJ.IdT Dx CI JTI qv ;
    Ix : Ty G = subT G GA IK (sec G A x) ;
    Mc : Id (Ty G) (subT G Dx M0 (DJ.cen G A x)) (IJ.IdT G Ix r0 r0) =
      Id-ov G Dx CI JTI qv (DJ.cen G A x) Ix (TR.PCen G A x IK) r0 r0
        (TR.JT-beta G A x IK r0) (JP.q-extS G GA IK (sec G A x) r0 (TR.PCen G A x IK)) ;
    base : El G (subT G Dx M0 (DJ.cen G A x)) =
      trE G (IJ.IdT G Ix r0 r0) (subT G Dx M0 (DJ.cen G A x)) (sym (Ty G) (subT G Dx M0 (DJ.cen G A x)) (IJ.IdT G Ix r0 r0) Mc) (IJ.rfl G Ix r0) ;
    E : El Dx M0 = IJ.J G A x M0 base ;
    module Pt (y : El G A) (u : El G (IJ.IdT G A x y)) {
      pt : Sub G Dx = TR.ptY G A x y u ;
      Iy : Ty G = subT G GA IK (sec G A y) ;
      Ixy : Ty G = IJ.IdT G A x y ;
      PK : Id (Ty G) Iy Ixy = JP.IKpt G A x y ;
      uI : El G Iy = trE G Ixy Iy (sym (Ty G) Iy Ixy PK) u ;
      QT : Id (Ty G) (subT G Dx CI pt) Ixy = JP.qT-inst G A IK y Ixy PK u ;
      qOv : Ov G Dx CI pt Ixy QT qv u = JP.q-inst G A IK y Ixy PK u QT ;
      qOv' : Ov G Dx CI pt Iy (TR.PPt G A IK x y u) qv uI =
        ovTr G Dx CI CI (refl CI) pt Ixy Iy (sym (Ty G) Iy Ixy PK) QT (TR.PPt G A IK x y u) qv u qOv ;
      tv : El G Iy = TR.trP G A IK x y u r0 ;
      Mp : Id (Ty G) (subT G Dx M0 pt) (IJ.IdT G Iy tv uI) =
        Id-ov G Dx CI JTI qv pt Iy (TR.PPt G A IK x y u) tv uI (refl tv) qOv' ;
      law : El G (IJ.IdT G Iy tv uI) = trE G (subT G Dx M0 pt) (IJ.IdT G Iy tv uI) Mp (subt G Dx M0 E pt) ;
    } ;
  } ;

  -- K: precomposition with the inverse, as a J-term over H = G.A.Id(x , t)
  module K (G : Ctx) (A : Ty G) (x : El G A) {
    GA : Ctx = ext G A ;
    IK : Ty GA = JP.IK G A x ;
    H : Ctx = JP.Dx G A x ;
    A' : Ty H = JP.wwT G A IK A ;
    x' : El H A' = JP.wwE G A IK A x ;
    t' : El H A' = JP.zv G A IK ;
    IK' : Ty (ext H A') = JP.IK H A' x' ;
    Dx' : Ctx = JP.Dx H A' x' ;
    AT : Ty Dx' = JP.wwT H A' IK' A' ;
    zz : El Dx' AT = JP.zv H A' IK' ;
    tt : El Dx' AT = JP.wwE H A' IK' A' t' ;
    Kt : Ty Dx' = IJ.IdT Dx' AT zz tt ;
    -- at kap's centre: Id(x , t), whose element is the variable w
    I0' : Ty H = TR.I0 H A' x' ;
    cn : Sub H Dx' = DJ.cen H A' x' ;
    PAc : Id (Ty H) (subT H Dx' AT cn) A' = JP.wwT-inst H A' IK' x' I0' (refl I0') (DJ.reflE H A' x') A' ;
    Kc : Id (Ty H) (subT H Dx' Kt cn) (IJ.IdT H A' x' t') =
      Id-ov H Dx' AT zz tt cn A' PAc x' t'
        (JP.zv-inst H A' IK' x' I0' (refl I0') (DJ.reflE H A' x') PAc)
        (JP.wwE-inst H A' IK' x' I0' (refl I0') (DJ.reflE H A' x') A' t' PAc) ;
    baseK : El H (subT H Dx' Kt cn) =
      trE H (IJ.IdT H A' x' t') (subT H Dx' Kt cn) (sym (Ty H) (subT H Dx' Kt cn) (IJ.IdT H A' x' t') Kc) (JP.uv G A x) ;
    kap : El Dx' Kt = IJ.J H A' x' Kt baseK ;
    -- kap at the diagonal (z , c) = (t , w)
    Ixt : Ty H = IJ.IdT H A' x' t' ;
    diag : Sub H Dx' = JP.instG H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x) ;
    PAd : Id (Ty H) (subT H Dx' AT diag) A' = JP.wwT-inst H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x) A' ;
    Kd : Id (Ty H) (subT H Dx' Kt diag) (IJ.IdT H A' t' t') =
      Id-ov H Dx' AT zz tt diag A' PAd t' t'
        (JP.zv-inst H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x) PAd)
        (JP.wwE-inst H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x) A' t' PAd) ;
    kd : El H (IJ.IdT H A' t' t') = trE H (subT H Dx' Kt diag) (IJ.IdT H A' t' t') Kd (subt H Dx' Kt kap diag) ;

    -- Lk: at the centre of (t , w), the diagonal is kap's centre
    cen : Sub G H = DJ.cen G A x ;
    PAx : Id (Ty G) (subT G H A' cen) A = JP.wwT-inst G A IK x (TR.I0 G A x) (refl (TR.I0 G A x)) (DJ.reflE G A x) A ;
    tc : Ov G H A' cen A PAx t' x = JP.zv-inst G A IK x (TR.I0 G A x) (refl (TR.I0 G A x)) (DJ.reflE G A x) PAx ;
    xc : Ov G H A' cen A PAx x' x = JP.wwE-inst G A IK x (TR.I0 G A x) (refl (TR.I0 G A x)) (DJ.reflE G A x) A x PAx ;
    HA : Ctx = ext H A' ;
    Ixx : Ty G = IJ.IdT G A x x ;
    -- (sec t') o cen = (sec x') o cen
    PW1 : Id (Ty H) (subT H HA (wkT H A' A') (sec H A' t')) A' = p-sec-T H A' A' t' ;
    PW2 : Id (Ty H) (subT H HA (wkT H A' A') (sec H A' x')) A' = p-sec-T H A' A' x' ;
    st : Sub G HA = o G H HA (sec H A' t') cen ;
    sx : Sub G HA = o G H HA (sec H A' x') cen ;
    eSec : Id (Sub G HA) st sx =
      IN.ext-eq G H A' st sx
        (trans (Sub G H) (o G HA H (p H A') st) cen (o G HA H (p H A') sx)
           (trans (Sub G H) (o G HA H (p H A') st) (o G H H (o H HA H (p H A') (sec H A' t')) cen) cen
              (sym (Sub G H) (o G H H (o H HA H (p H A') (sec H A' t')) cen) (o G HA H (p H A') st) (o-assoc G H HA H (p H A') (sec H A' t') cen))
              (trans (Sub G H) (o G H H (o H HA H (p H A') (sec H A' t')) cen) (o G H H (id H) cen) cen
                 (ap (Sub H H) (Sub G H) (\ r -> o G H H r cen) (o H HA H (p H A') (sec H A' t')) (id H) (p-sec H A' t'))
                 (o-idl G H cen)))
           (sym (Sub G H) (o G HA H (p H A') sx) cen
              (trans (Sub G H) (o G HA H (p H A') sx) (o G H H (o H HA H (p H A') (sec H A' x')) cen) cen
                 (sym (Sub G H) (o G H H (o H HA H (p H A') (sec H A' x')) cen) (o G HA H (p H A') sx) (o-assoc G H HA H (p H A') (sec H A' x') cen))
                 (trans (Sub G H) (o G H H (o H HA H (p H A') (sec H A' x')) cen) (o G H H (id H) cen) cen
                    (ap (Sub H H) (Sub G H) (\ r -> o G H H r cen) (o H HA H (p H A') (sec H A' x')) (id H) (p-sec H A' x'))
                    (o-idl G H cen)))))
        A x
        (comp3 G H HA (wkT H A' A') (sec H A' t') cen A' PW1 A PAx)
        (ovC G H HA (wkT H A' A') (sec H A' t') cen A' PW1 A PAx (q H A') t' x (IN.q-secO H A' t' PW1) tc)
        (comp3 G H HA (wkT H A' A') (sec H A' x') cen A' PW2 A PAx)
        (ovC G H HA (wkT H A' A') (sec H A' x') cen A' PW2 A PAx (q H A') x' x (IN.q-secO H A' x' PW2) xc) ;
    -- diag o cen = cn o cen
    rE' : El H (subT H HA IK' (sec H A' x')) = DJ.reflE H A' x' ;
    WI : Ty Dx' = wkT HA IK' IK' ;
    s1 : Sub G Dx' = o G H Dx' diag cen ;
    s2 : Sub G Dx' = o G H Dx' cn cen ;
    PIxt : Id (Ty G) (subT G H Ixt cen) Ixx = Id-ov G H A' x' t' cen A PAx x x xc tc ;
    QTd : Id (Ty H) (subT H Dx' WI diag) Ixt = JP.qT-inst H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x) ;
    q1 : Ov G Dx' WI s1 Ixx (comp3 G H Dx' WI diag cen Ixt QTd Ixx PIxt) (q HA IK') (IJ.rfl G A x) =
      ovC G H Dx' WI diag cen Ixt QTd Ixx PIxt (q HA IK') (JP.uv G A x) (IJ.rfl G A x)
        (JP.q-inst H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x) QTd) (JP.uv-cen G A x PIxt) ;
    PWr : Id (Ty H) (subT H Dx' WI cn) (subT H HA IK' (sec H A' x')) = IN.wkT-extS H HA IK' IK' (sec H A' x') rE' ;
    Ixx' : Ty H = IJ.IdT H A' x' x' ;
    PIr : Id (Ty G) (subT G H Ixx' cen) Ixx = Id-ov G H A' x' x' cen A PAx x x xc xc ;
    rOv : Ov G H Ixx' cen Ixx PIr (IJ.rfl H A' x') (IJ.rfl G A x) = IN.rfl-ov G H A' x' cen A PAx x xc PIr ;
    PIr2 : Id (Ty G) (subT G H (subT H HA IK' (sec H A' x')) cen) Ixx =
      trans (Ty G) (subT G H (subT H HA IK' (sec H A' x')) cen) (subT G H Ixx' cen) Ixx
        (ap (Ty H) (Ty G) (\ X -> subT G H X cen) (subT H HA IK' (sec H A' x')) Ixx' (DJ.reflT H A' x')) PIr ;
    rOv2 : Ov G H (subT H HA IK' (sec H A' x')) cen Ixx PIr2 rE' (IJ.rfl G A x) =
      ovTr G H Ixx' (subT H HA IK' (sec H A' x')) (sym (Ty H) (subT H HA IK' (sec H A' x')) Ixx' (DJ.reflT H A' x')) cen
        Ixx Ixx (refl Ixx) PIr PIr2 (IJ.rfl H A' x') (IJ.rfl G A x) rOv ;
    q2 : Ov G Dx' WI s2 Ixx (comp3 G H Dx' WI cn cen (subT H HA IK' (sec H A' x')) PWr Ixx PIr2) (q HA IK') (IJ.rfl G A x) =
      ovC G H Dx' WI cn cen (subT H HA IK' (sec H A' x')) PWr Ixx PIr2 (q HA IK') rE' (IJ.rfl G A x)
        (JP.q-extS H HA IK' (sec H A' x') rE' PWr) rOv2 ;
    pd : Id (Sub G HA) (o G Dx' HA (p HA IK') s1) st =
      trans (Sub G HA) (o G Dx' HA (p HA IK') s1) (o G H HA (o H Dx' HA (p HA IK') diag) cen) st
        (sym (Sub G HA) (o G H HA (o H Dx' HA (p HA IK') diag) cen) (o G Dx' HA (p HA IK') s1) (o-assoc G H Dx' HA (p HA IK') diag cen))
        (ap (Sub H HA) (Sub G HA) (\ r -> o G H HA r cen) (o H Dx' HA (p HA IK') diag) (sec H A' t')
           (JP.p-inst H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x))) ;
    pc : Id (Sub G HA) (o G Dx' HA (p HA IK') s2) sx =
      trans (Sub G HA) (o G Dx' HA (p HA IK') s2) (o G H HA (o H Dx' HA (p HA IK') cn) cen) sx
        (sym (Sub G HA) (o G H HA (o H Dx' HA (p HA IK') cn) cen) (o G Dx' HA (p HA IK') s2) (o-assoc G H Dx' HA (p HA IK') cn cen))
        (ap (Sub H HA) (Sub G HA) (\ r -> o G H HA r cen) (o H Dx' HA (p HA IK') cn) (sec H A' x')
           (IN.p-extS H HA IK' (sec H A' x') rE')) ;
    E1 : Id (Sub G Dx') s1 s2 =
      IN.ext-eq G HA IK' s1 s2
        (trans (Sub G HA) (o G Dx' HA (p HA IK') s1) st (o G Dx' HA (p HA IK') s2)
           pd (trans (Sub G HA) st sx (o G Dx' HA (p HA IK') s2) eSec (sym (Sub G HA) (o G Dx' HA (p HA IK') s2) sx pc)))
        Ixx (IJ.rfl G A x)
        (comp3 G H Dx' WI diag cen Ixt QTd Ixx PIxt) q1
        (comp3 G H Dx' WI cn cen (subT H HA IK' (sec H A' x')) PWr Ixx PIr2) q2 ;
    -- kd at the centre is refl: through E1 and kap's J-beta
    Itt : Ty H = IJ.IdT H A' t' t' ;
    PIt : Id (Ty G) (subT G H Itt cen) Ixx = Id-ov G H A' t' t' cen A PAx x x tc tc ;
    R1 : El G Ixx = trE G (subT G H Itt cen) Ixx PIt (subt G H Itt kd cen) ;
    stA : Ov G Dx' Kt s1 Ixx (comp3 G H Dx' Kt diag cen Itt Kd Ixx PIt) kap R1 =
      ovC G H Dx' Kt diag cen Itt Kd Ixx PIt kap kd R1 (refl kd) (refl R1) ;
    PZ : Id (Ty G) (subT G H (subT H Dx' Kt cn) cen) Ixx =
      trans (Ty G) (subT G H (subT H Dx' Kt cn) cen) (subT G H Ixt cen) Ixx
        (ap (Ty H) (Ty G) (\ X -> subT G H X cen) (subT H Dx' Kt cn) Ixt Kc) PIxt ;
    e2c : Ov G H (subT H Dx' Kt cn) cen Ixx PZ baseK (IJ.rfl G A x) =
      ovTr G H Ixt (subT H Dx' Kt cn) (sym (Ty H) (subT H Dx' Kt cn) Ixt Kc) cen Ixx Ixx (refl Ixx) PIxt PZ
        (JP.uv G A x) (IJ.rfl G A x) (JP.uv-cen G A x PIxt) ;
    stC : Ov G Dx' Kt s2 Ixx (comp3 G H Dx' Kt cn cen (subT H Dx' Kt cn) (refl (subT H Dx' Kt cn)) Ixx PZ) kap (IJ.rfl G A x) =
      ovC G H Dx' Kt cn cen (subT H Dx' Kt cn) (refl (subT H Dx' Kt cn)) Ixx PZ kap baseK (IJ.rfl G A x)
        (IJ.J-beta H A' x' Kt baseK) e2c ;
    baseEq : Id (El G Ixx) R1 (IJ.rfl G A x) =
      trans (El G Ixx) R1 (trE G (subT G Dx' Kt s1) Ixx (comp3 G H Dx' Kt diag cen Itt Kd Ixx PIt) (subt G Dx' Kt kap s1)) (IJ.rfl G A x)
        (sym (El G Ixx) (trE G (subT G Dx' Kt s1) Ixx (comp3 G H Dx' Kt diag cen Itt Kd Ixx PIt) (subt G Dx' Kt kap s1)) R1 stA)
        (trans (El G Ixx) (trE G (subT G Dx' Kt s1) Ixx (comp3 G H Dx' Kt diag cen Itt Kd Ixx PIt) (subt G Dx' Kt kap s1))
           (trE G (subT G Dx' Kt s2) Ixx (comp3 G H Dx' Kt cn cen (subT H Dx' Kt cn) (refl (subT H Dx' Kt cn)) Ixx PZ) (subt G Dx' Kt kap s2))
           (IJ.rfl G A x)
           (SJ.subtEq G Dx' Kt kap s1 s2 E1 Ixx (comp3 G H Dx' Kt diag cen Itt Kd Ixx PIt) (comp3 G H Dx' Kt cn cen (subT H Dx' Kt cn) (refl (subT H Dx' Kt cn)) Ixx PZ))
           stC) ;
    -- the motive kd = refl over H, by J on (t , w)
    ML : Ty H = IJ.IdT H Itt kd (IJ.rfl H A' t') ;
    MLc : Id (Ty G) (subT G H ML cen) (IJ.IdT G Ixx (IJ.rfl G A x) (IJ.rfl G A x)) =
      Id-ov G H Itt kd (IJ.rfl H A' t') cen Ixx PIt (IJ.rfl G A x) (IJ.rfl G A x) baseEq (IN.rfl-ov G H A' t' cen A PAx x tc PIt) ;
    baseL : El G (subT G H ML cen) =
      trE G (IJ.IdT G Ixx (IJ.rfl G A x) (IJ.rfl G A x)) (subT G H ML cen)
        (sym (Ty G) (subT G H ML cen) (IJ.IdT G Ixx (IJ.rfl G A x) (IJ.rfl G A x)) MLc) (IJ.rfl G Ixx (IJ.rfl G A x)) ;
    EL : El H ML = IJ.J G A x ML baseL ;
    -- read at (y , u)
    module LkAt (y : El G A) (u : El G (IJ.IdT G A x y)) {
      pt : Sub G H = TR.ptY G A x y u ;
      Iyy : Ty G = IJ.IdT G A y y ;
      PAy : Id (Ty G) (subT G H A' pt) A = JP.wwT-inst G A IK y (IJ.IdT G A x y) (JP.IKpt G A x y) u A ;
      ty : Ov G H A' pt A PAy t' y = JP.zv-inst G A IK y (IJ.IdT G A x y) (JP.IKpt G A x y) u PAy ;
      PIy : Id (Ty G) (subT G H Itt pt) Iyy = Id-ov G H A' t' t' pt A PAy y y ty ty ;
      kdy : El G Iyy = trE G (subT G H Itt pt) Iyy PIy (subt G H Itt kd pt) ;
      MLp : Id (Ty G) (subT G H ML pt) (IJ.IdT G Iyy kdy (IJ.rfl G A y)) =
        Id-ov G H Itt kd (IJ.rfl H A' t') pt Iyy PIy kdy (IJ.rfl G A y) (refl kdy) (IN.rfl-ov G H A' t' pt A PAy y ty PIy) ;
      law : El G (IJ.IdT G Iyy kdy (IJ.rfl G A y)) = trE G (subT G H ML pt) (IJ.IdT G Iyy kdy (IJ.rfl G A y)) MLp (subt G H ML EL pt) ;
    } ;
  } ;
} ;
