-- CAxSp.seg (canonicity-c2; the axioms' statements, part 4): for u = (k
-- coefficients, n points, equations q_1..q_m over them), the telescope
-- Sp(u) over Pr_u = G^k: the points x : G^n, then h_j : q_j(x) = 0; and B^{Sp u}
-- := Pi x. Pi h. B for a closed fibrant B (G or N_D).  Metatheory schema in u.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module SpOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (addV mulV : (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X)
  (addN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (addV I u v)) (addV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (mulN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (mulV I u v)) (mulV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (cV : R.R -> (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X)
  (cN : (r : R.R) (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (cV r I)) (cV r J))
  (k n : Nat) {
 module EG = CAxEv[a].EvG[R, encK, pe] ;
 module TW = EG.Two[addV, mulV, addN, mulN, cV, cN, k, n] ;
 module PW = EG.PW ;
 C : CwF.CwF[a++] = PW.C ;
 module OV = PW.OV ;
 Pi (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) : C.Ty G = PW.G1.fibPi-T.Pi G A B ;
 IdT (G : C.Ctx) (A : C.Ty G) (x y : C.El G A) : C.Ty G = PW.G1.fibId-T.IdT G A x y ;
 Nl : C.Ctx = PW.Nl ;
 Term : U a = SX.Over[R].Expr TW.Var ;
 -- the coefficients and the points
 Pr : C.Ctx = PW.Gk k ;
 Xc : C.Ctx = TW.Vc ;
 -- an element of G over Xc moved to E along s
 gsub (E : C.Ctx) (s : C.Sub E Xc) (g : C.El Xc (PW.Gat Xc)) : C.El E (PW.Gat E) =
  OV.trE E (C.subT E Xc (PW.Gat Xc) s) (PW.Gat E)
   (transH (symH (C.subT-o E Xc Nl PW.GTy (C.eps Xc) s))
     (apH {C.Sub E Nl} {C.Ty E} (\ t -> C.subT E Nl PW.GTy t) (transH (C.eps-uniq E (C.o E Xc Nl (C.eps Xc) s)) (symH (C.eps-uniq E (C.eps E))))))
   (C.subt E Xc (PW.Gat Xc) g s) ;
 zE : C.El Xc (PW.Gat Xc) = TW.evE (cst R.z) ;
 -- the equation q = 0 over E
 EqT (E : C.Ctx) (s : C.Sub E Xc) (q : Term) : C.Ty E = IdT E (PW.Gat E) (gsub E s (TW.evE q)) (gsub E s zE) ;
 -- the hypotheses h : q = 0, one per equation (the last equation of the list first)
 HS : SX.Over[R].Equations TW.Var -> (E : C.Ctx) * C.Sub E Xc = split {
  nil -> (Xc, C.id Xc) ;
  cons q qs | r -> (C.ext r.1 (EqT r.1 r.2 q), C.o (C.ext r.1 (EqT r.1 r.2 q)) r.1 Xc r.2 (C.p r.1 (EqT r.1 r.2 q))) } ;
 PiH : (qs : SX.Over[R].Equations TW.Var) -> C.Ty (HS qs).1 -> C.Ty Xc = split {
  nil -> \ B -> B ;
  cons q qs | r -> \ B -> r (Pi (HS qs).1 (EqT (HS qs).1 (HS qs).2 q) B) } ;
 PiX : (j : Nat) -> C.Ty (PW.Ext Pr j) -> C.Ty Pr = split {
  zero -> \ B -> B ;
  suc j | r -> \ B -> r (Pi (PW.Ext Pr j) (PW.Gat (PW.Ext Pr j)) B) } ;
 -- B^{Sp u} for a closed B
 Exp (B : C.Ty Nl) (qs : SX.Over[R].Equations TW.Var) : C.Ty Pr = PiX n (PiH qs (C.subT (HS qs).1 Nl B (C.eps (HS qs).1))) ;
} ;
