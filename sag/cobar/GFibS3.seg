-- GFibS3.seg: GENERATED from FibS3.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change FibS3.seg or the generator.
-- FibS3.seg (M1 step 3, S4, S3 part 1): at any context G of the CwF of
-- fibrant types, for Y , X fibrant and r : Y -> X: r as a map of core
-- (al), core's homotopy fibre (HFib, made with core's Path), core's fibre
-- made with Swan's Id in the total space (HFibId), and the natural maps
-- between HFibId and the interface's fibre FVr (Sigma y Id(r y , x)).
-- S3b: an element of Kr r (contractible fibres) gives core's equivalence
-- structure on al; S3a: conversely.
--
-- Informal text.
-- (1) al (y) = (x , r y) with r y the value of bod r; natural since bod r is.
-- (2) The end r y of FVr is, at each point, bod r at (y) (CwFFv.end read
--     at the point: a transport between types with the same fibre codes
--     does not change the value, FibIdRd.elTr).  So the Yoneda Id of FVr
--     and IdOver of HFib's data are isomorphic (FibYC.YC), and so are FVr
--     and HFibId (FibYC.SigN).
-- (3) HFib -> HFibId (a path with the empty sieve) -> HFib (the path) is
--     the identity.
-- (4) S3b: k : Kr r gives, over G.X, an element of isContr FVr, hence a
--     ContrOp on FVr (FibHt), on HFibId (CLocBoundRetr.Relative along the
--     maps of (2), whose composite is the identity: FibYC.RelId), and on
--     HFib (the same, with the maps of (3)).  That is EquivOp al.
-- (5) S3a: EquivOp al and core's equivalence structure on Id -> Path
--     (CIdEquiv, with the fillers of HFib's path type from CPathComp) give
--     a ContrOp on HFibId (FibC2), on FVr (the maps of (2), FibYC.RelId),
--     hence an element of isContr FVr over G.X (FibContr), and lam: Kr r.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module PFm = PresheafFormers[a, l].PFormers[PB.BC] ;
module FCw = GFibCwF[l] ;
module FC = FCw.FC ;
module LR = GCLocBoundRetr[l] ;
module OV = CwFOv.Ov[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, GFibId[l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, GFibId[l].fibId] ;
module QP = CwFQP.QP[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, GFibId[l].fibId, GFibNF[l].nf] ;
module FV = CwFFv.Fv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, GFibId[l].fibId, GFibNF[l].nf] ;
module YCm = GFibYC[l] ;

module S3 (G : PCtx) (X Y : FC.STy G) (r : FCw.fibCwF.El G (OV.Fun G Y X)) {
  module TX = GPR.TyL[G, X.1] ;
  module TY = GPR.TyL[G, Y.1] ;
  module FE = FV.E[G, X, Y, r] ;

  ----------------------------------------------------------------------
  -- (1) r as a map of core

  rb : PEl[extP G Y.1, subTy (extP G Y.1) G X.1 (pP G Y.1)] = OV.bod G Y (OV.wkT G Y X) r ;

  alE (W : Ob) (w : SigT G Y.1 W) : SigT G X.1 W = TX.pr W (TY.pr1 W w) (rb.eob W w) ;

  alN (V W : Ob) (h : Hom V W) (w : SigT G Y.1 W) : Id (SigT G X.1 V) (alE V ((extP G Y.1).act V W h w)) ((extP G X.1).act V W h (alE W w)) =
    apH (TX.pr V (G.act V W h (TY.pr1 W w)))
      (symH (transH (tact-irr G X.1 V W h (TY.pr1 W w) (G.act V W h (TY.pr1 W w)) (refl (G.act V W h (TY.pr1 W w)))
                       (ntEq (extP G Y.1) G (pP G Y.1) V W h w ((extP G Y.1).act V W h w) (refl ((extP G Y.1).act V W h w))) (rb.eob W w))
               (rb.enat V W h w ((extP G Y.1).act V W h w) (refl ((extP G Y.1).act V W h w))))) ;

  al : CP.PMap[G, Y.1, X.1] = new CP.PMap[G, Y.1, X.1, alE, \ W w -> refl (TY.pr1 W w), alN] ;

  module HF = PB.CEquiv[l].HFib[G, Y.1, X.1, al] ;

  ----------------------------------------------------------------------
  -- (2) the ends of FVr, and FVr = HFibId


  e1v (W : Ob) (z : W0.Ix (HF.EAB.ob W)) : Id (W0.Ix (X.1.tob W (fstE G X.1 W (fstE HF.EA HF.B1 W z)))) (FE.e1.eob W z) (rb.eob W (pairE G Y.1 W (fstE G X.1 W (fstE HF.EA HF.B1 W z)) (sndE HF.EA HF.B1 W z))) =
    transH (apH (\ v -> v.eob W z) (symH FE.end.2))
      (GFibIdRd[l].elTr FE.K' (FC.STy FE.K') (\ Z -> Z.1) (FCw.fibCwF.subT FE.K' (FCw.fibCwF.ext G Y) (OV.wkT G Y X) FE.tau) FE.B1 FE.end.1 FE.rt W z
         (refl (X.1.tob W (fstE G X.1 W (fstE HF.EA HF.B1 W z))))) ;

  module YC = YCm.YC[FE.K', FE.D, G, pP FE.D FE.Yd.1, pP G X.1, X.1,
    \ Z x W f i -> HF.sx W (HF.EAB.act W Z f x), HF.sN, HF.aE, HF.bE, HF.aE-act, HF.bE-act,
    \ Z x W f i -> refl (HF.sx W (HF.EAB.act W Z f x)),
    FE.e1, FE.e2,
    \ W z -> apH (TX.pr W (fstE G X.1 W (fstE HF.EA HF.B1 W z))) (e1v W z),
    \ W z -> refl (fstE HF.EA HF.B1 W z)] ;

  -- FVr as a presheaf type (CwFFv.fvDef, then the formers of FibCwF)
  FV1 : PTy[FE.D] = PFm.SigAB[FE.D, FE.Yd.1, YC.Y.IdYT].SigP ;
  fvEq : Id (PTy[FE.D]) FE.FVd.1 FV1 = refl FV1 ;
  HFibId : PTy[FE.D] = PFm.SigAB[FE.D, FE.Yd.1, YC.IO.IdT].SigP ;

  toS : HO.NMap[HF.EA, FV1, HFibId] = YCm.SigN[HF.EA, HF.B1, YC.Y.IdYT, YC.IO.IdT, YC.toN].map ;
  frS : HO.NMap[HF.EA, HFibId, FV1] = YCm.SigN[HF.EA, HF.B1, YC.IO.IdT, YC.Y.IdYT, YC.frN].map ;

  ----------------------------------------------------------------------
  -- (3) HFib and HFibId

  emb : HO.NMap[HF.EAB, HF.PE.PathP, YC.IO.IdT] = new HO.NMap[HF.EAB, HF.PE.PathP, YC.IO.IdT,
    \ Z z p -> (p, (PB.emptyS Z, \ W f i j -> absurd (Id (YC.IO.TA.EI W) (p.1.1 W f j) (HF.aE W (HF.EAB.act W Z f z))) (PB.empty-lands W Z f i))),
    \ J I h x y e p -> YC.IO.idI-eq J y _ _ (refl (HF.PE.PathP.tact J I h x y e p)) (PB.pre-empty J I h)] ;

  prj : HO.NMap[HF.EAB, YC.IO.IdT, HF.PE.PathP] = new HO.NMap[HF.EAB, YC.IO.IdT, HF.PE.PathP,
    \ Z z w -> w.1, \ J I h x y e w -> refl (HF.PE.PathP.tact J I h x y e w.1)] ;

  embS : HO.NMap[HF.EA, HF.FibT, HFibId] = YCm.SigN[HF.EA, HF.B1, HF.PE.PathP, YC.IO.IdT, emb].map ;
  prjS : HO.NMap[HF.EA, HFibId, HF.FibT] = YCm.SigN[HF.EA, HF.B1, YC.IO.IdT, HF.PE.PathP, prj].map ;

  ----------------------------------------------------------------------
  -- (4) S3b

  module B (k : FCw.fibCwF.El G (QP.Kr G X Y r)) {
    kx : FCw.fibCwF.El (FCw.fibCwF.ext G X) (EQ.isContr (FCw.fibCwF.ext G X) (QP.FVr G X Y r)) = OV.bod G X (EQ.isContr (FCw.fibCwF.ext G X) (QP.FVr G X Y r)) k ;

    c1 : CP.ContrOp HF.EA FV1 = substH {PTy[FE.D]} (\ T -> CP.ContrOp HF.EA T) fvEq
        (substH {FC.STy FE.D} (\ T -> CP.ContrOp HF.EA T.1) FE.fvDef (GFibHt[l].contrOp HF.EA (QP.FVr G X Y r) kx)) ;

    c2 : CP.ContrOp HF.EA HFibId =
      YCm.RelId[HF.EA, HFibId, LR.Map[HF.EA, HFibId, HFibId, HO.compN HF.EA HFibId FV1 HFibId frS toS].pmap,
        \ Z w -> apH (\ v -> pairE HF.EA HFibId Z (fstE HF.EA HFibId Z w) ((sndE HF.EA HFibId Z w).1, v))
                   (YC.to-fr Z (pairE HF.EA HF.B1 Z (fstE HF.EA HFibId Z w) (sndE HF.EA HFibId Z w).1) (sndE HF.EA HFibId Z w).2),
        LR.Relative[HF.EA, HFibId, FV1, frS, toS, c1].extension].contrOp ;

    eop : PB.CEquiv[l].EquivOp G Y.1 X.1 al =
      YCm.RelId[HF.EA, HF.FibT, LR.Map[HF.EA, HF.FibT, HF.FibT, HO.compN HF.EA HF.FibT HFibId HF.FibT embS prjS].pmap,
        \ Z w -> refl w,
        LR.Relative[HF.EA, HF.FibT, HFibId, embS, prjS, c2].extension].contrOp ;
  } ;

  ----------------------------------------------------------------------
  -- (5) S3a

  -- the path type of HFib is fibrant (CPathComp), so it has fillers
  sF (Z : Ob) (y : W0.Ix (FE.K'.ob Z)) (V W : Ob) (g : Hom V W) (f : Hom W Z) (i : IvP W)
    : Id (W0.Ix (G.ob V)) (G.act V W g (HF.sx W (HF.EAB.act W Z f y))) (HF.sx V (HF.EAB.act V Z (compH V W Z f g) y)) =
    symH (G.act-o V W Z f g (HF.sx Z y)) ;

  aE-pt (W : Ob) (y : W0.Ix (FE.K'.ob W)) : Id (W0.Ix (G.ob W)) (TX.pr1 W (HF.aE W y)) (HF.sx W (HF.EAB.act W W (idH W) y)) =
    symH (G.act-id W (HF.sx W y)) ;

  module PCm = PB.CPathComp[l].PathC[FE.K', G, X.1, true, \ Z x W f i -> HF.sx W (HF.EAB.act W Z f x), HF.sN, sF,
    HF.aE, HF.bE, HF.aE-act, HF.bE-act, aE-pt, aE-pt, e1, e0, X.2.2] ;

  kP : PB.CLine[l].Lines[FE.K', YC.IO.PT.PathP].Fill e1 = PB.CFill[l].FillC[FE.K', YC.IO.PT.PathP, false, PCm.comp].fill ;

  module IEm = PB.CIdEquiv[l].IE[FE.K', G, X.1, \ Z x W f i -> HF.sx W (HF.EAB.act W Z f x), HF.sN,
    HF.aE, HF.bE, HF.aE-act, HF.bE-act, kP, GPosId[l].dc] ;

  module A (eop : PB.CEquiv[l].EquivOp G Y.1 X.1 al) {
    c3 : CP.ContrOp FE.D HFibId =
      GFibC2[l].C2[FE.D, FE.Yd.1, YC.IO.IdT, YC.IO.PT.PathP, prj, YC.IO.proj, \ Z w -> refl (YC.IO.proj.mE Z w), eop, IEm.equiv].contrOp ;

    c4 : CP.ContrOp FE.D FV1 =
      YCm.RelId[FE.D, FV1, LR.Map[FE.D, FV1, FV1, HO.compN FE.D FV1 HFibId FV1 toS frS].pmap,
        \ Z w -> apH (\ v -> pairE FE.D FV1 Z (fstE FE.D FV1 Z w) ((sndE FE.D FV1 Z w).1, v))
                   (YC.fr-to Z (pairE FE.D FE.Yd.1 Z (fstE FE.D FV1 Z w) (sndE FE.D FV1 Z w).1) (sndE FE.D FV1 Z w).2),
        LR.Relative[FE.D, FV1, HFibId, toS, frS, c3].extension].contrOp ;

    c5 : CP.ContrOp FE.D (QP.FVr G X Y r).1 =
      substH {FC.STy FE.D} (\ T -> CP.ContrOp FE.D T.1) (symH FE.fvDef)
        (substH {PTy[FE.D]} (\ T -> CP.ContrOp FE.D T) (symH fvEq) c4) ;

    kx : FCw.fibCwF.El (FCw.fibCwF.ext G X) (EQ.isContr (FCw.fibCwF.ext G X) (QP.FVr G X Y r)) =
      GFibContr[l].contr FE.D (QP.FVr G X Y r) c5 ;

    k : FCw.fibCwF.El G (QP.Kr G X Y r) = OV.lam G X (EQ.isContr (FCw.fibCwF.ext G X) (QP.FVr G X Y r)) kx ;
  } ;
} ;
