-- CTPsh.seg (canonicity-45; SIMPLIFIED.md step 4): presheaves over the
-- total category of an internal category IC (CIntCat), in the displayed
-- form the cobar layer uses: a value at every (I, x), an action along
-- every total map (u : J -> I, f : homD J I u y x), with the identity and
-- composition laws of IC's total hom (THom-valued, so the laws are stated
-- with compH / compD and no transport).  Maps of such presheaves (TSub).
-- The identification with presheaves over GrothCB's total site
-- (canonicity-c2) is a repackaging, later.
--   TCtx     ob, act, act-id, act-o
--   TSub     nt, nt-nat
--   cartAct  the action along a cartesian map (u, cart u x)
--   vertAct  the action along a vertical map at a stage (idH J, g)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module TPshOf (C : CIntCat[a].IC) {
 module VT = CVert[a].VertOf[C] ;
 Obj (I : Ob) : U a = VT.Obj I ;
 HomD (J I : Ob) (u : Hom J I) (y : Obj J) (x : Obj I) : U a = VT.HomD J I u y x ;

 record TCtx {
  ob (I : Ob) (x : Obj I) : W0.V ;
  act (J I : Ob) (u : Hom J I) (y : Obj J) (x : Obj I) (f : HomD J I u y x) : W0.Ix (ob I x) -> W0.Ix (ob J y) ;
  act-id (I : Ob) (x : Obj I) (g : W0.Ix (ob I x)) : Id (W0.Ix (ob I x)) (act I I (idH I) x x (C.idD I x) g) g ;
  act-o (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : Obj K) (y : Obj J) (x : Obj I) (f : HomD J I u y x) (f' : HomD K J v z y) (g : W0.Ix (ob I x))
   : Id (W0.Ix (ob K z)) (act K I (compH K J I u v) z x (C.compD K J I u v z y x f f') g) (act K J v z y f' (act J I u y x f g)) ;
 } ;

 record TSub (D G : TCtx) {
  nt (I : Ob) (x : Obj I) : W0.Ix (D.ob I x) -> W0.Ix (G.ob I x) ;
  nt-nat (J I : Ob) (u : Hom J I) (y : Obj J) (x : Obj I) (f : HomD J I u y x) (d : W0.Ix (D.ob I x))
   : Id (W0.Ix (G.ob J y)) (nt J y (D.act J I u y x f d)) (G.act J I u y x f (nt I x d)) ;
 } ;

 -- the two special actions
 cartAct (G : TCtx) (J I : Ob) (u : Hom J I) (x : Obj I) : W0.Ix (G.ob I x) -> W0.Ix (G.ob J (C.res J I u x)) =
  G.act J I u (C.res J I u x) x (C.cart J I u x) ;
 vertAct (G : TCtx) (J : Ob) (y x : Obj J) (g : VT.VMap J y x) : W0.Ix (G.ob J x) -> W0.Ix (G.ob J y) =
  G.act J J (idH J) y x g ;
 -- moving a map along a path of base maps does not change the action
 act-tr (G : TCtx) (J I : Ob) (u u' : Hom J I) (p : Id (Hom J I) u u') (y : Obj J) (x : Obj I) (f : HomD J I u y x) (g : W0.Ix (G.ob I x))
  : Id (W0.Ix (G.ob J y)) (G.act J I u' y x (VT.trH J I u u' p y x f) g) (G.act J I u y x f g) =
  idJ (Hom J I) u (\ w q -> Id (W0.Ix (G.ob J y)) (G.act J I w y x (VT.trH J I u w q y x f) g) (G.act J I u y x f g)) (refl (G.act J I u y x f g)) u' p ;
 -- the vertical action is functorial (through the moved composite)
 vertAct-o (G : TCtx) (J : Ob) (z y x : Obj J) (g : VT.VMap J y x) (g' : VT.VMap J z y) (e : W0.Ix (G.ob J x))
  : Id (W0.Ix (G.ob J z)) (vertAct G J z x (VT.vcomp J z y x g g') e) (vertAct G J z y g' (vertAct G J y x g e)) =
  transH (act-tr G J J (compH J J J (idH J) (idH J)) (idH J) (comp-idl J J (idH J)) z x (C.compD J J J (idH J) (idH J) z y x g g') e)
   (G.act-o J J J (idH J) (idH J) z y x g g' e) ;
 -- a cartesian action followed by a vertical one is the action along the total map
 cart-vert (G : TCtx) (J I : Ob) (u : Hom J I) (y : Obj J) (x : Obj I) (f : HomD J I u y x) (e : W0.Ix (G.ob I x))
  : Id (W0.Ix (G.ob J y)) (G.act J I u y x f e)
      (vertAct G J y (C.res J I u x) (C.fact J J I u (idH J) y x (VT.trH J I u (compH J J I u (idH J)) (symH (comp-idr J I u)) y x f)) (cartAct G J I u x e)) =
  transH (symH (act-tr G J I u (compH J J I u (idH J)) (symH (comp-idr J I u)) y x f e))
   (transH (apH {HomD J I (compH J J I u (idH J)) y x} {W0.Ix (G.ob J y)} (\ w -> G.act J I (compH J J I u (idH J)) y x w e)
              (symH (C.fact-eq J J I u (idH J) y x (VT.trH J I u (compH J J I u (idH J)) (symH (comp-idr J I u)) y x f))))
     (G.act-o J J I u (idH J) y (C.res J I u x) x (C.cart J I u x) (C.fact J J I u (idH J) y x (VT.trH J I u (compH J J I u (idH J)) (symH (comp-idr J I u)) y x f)) e)) ;
} ;
