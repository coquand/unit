-- CPshNF.seg (canonicity-c2; COBAR.md (B) stage 2(c)): naive function
-- extensionality for the identity type of C-presheaves (CPshId) over Pi
-- (CPshPi); FibNF at the C-level.
--
-- (A) LineYC.  A line field of a C-type T over G is a family
--     Lf x W y j : T_x (W , y), natural in the base at each x (Unat) and
--     in C (UC).  With ends a0 and b0 it is an element of Id(a0 , b0): at
--     each x the base's FibNF.LineY; it is natural in C because the
--     readings of a moved element are the moved readings (CPshId.rd-C) and
--     the sieves are empty.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module PY = PosIdY[a, l] ;
module BNF = FibNF[a, l] ;

module NFOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module IDm = CPshId[a, l].IdOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module PL = CPshPiLaws[a, l].PiLawOf[C] ;
 module L54 = Lemma54[a, l].L54Of[C] ;
 open P ;

 module LineYC (G : CCtx) (T : CTy[G]) (a0 b0 : CEl[G, T])
  (Lf : (x : CO) (W : Ob) (y : W0.Ix ((G.ob x).ob W)) (j : Hom W Iv) -> W0.Ix ((T.ty x).tob W y))
  (Unat : (x : CO) (V W : Ob) (g : Hom V W) (y : W0.Ix ((G.ob x).ob W)) (y' : W0.Ix ((G.ob x).ob V))
          (E : Id (W0.Ix ((G.ob x).ob V)) ((G.ob x).act V W g y) y') (j : Hom W Iv)
          -> Id (W0.Ix ((T.ty x).tob V y')) ((T.ty x).tact V W g y y' E (Lf x W y j)) (Lf x V y' (compH V W Iv j g)))
  (U0 : (x : CO) (W : Ob) (y : W0.Ix ((G.ob x).ob W)) -> Id (W0.Ix ((T.ty x).tob W y)) (Lf x W y (PB.ptH W PB.e0)) ((a0.el x).eob W y))
  (U1 : (x : CO) (W : Ob) (y : W0.Ix ((G.ob x).ob W)) -> Id (W0.Ix ((T.ty x).tob W y)) (Lf x W y (PB.ptH W PB.e1)) ((b0.el x).eob W y))
  (UC : (y x : CO) (f : CH y x) (W : Ob) (g : W0.Ix ((G.ob x).ob W)) (j : Hom W Iv)
        -> Id (SigT (G.ob y) (T.ty y) W) ((T.tE y x f).nt W (pairE (G.ob x) (T.ty x) W g (Lf x W g j)))
             (pairE (G.ob y) (T.ty y) W ((G.act y x f).nt W g) (Lf y W ((G.act y x f).nt W g) j))) {
  module I = IDm.IdC[G, T, a0, b0] ;
  elx (x : CO) : PEl[G.ob x, I.ty x] = BNF.LineY[G.ob x, T.ty x, a0.el x, b0.el x, Lf x, Unat x, U0 x, U1 x].el ;
  rdE (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (V : Ob) (h : Hom V X) (j : Hom V Iv)
   : Id (SigT (G.ob y) (T.ty y) V)
       (PY.IdY[G.ob y, T.ty y, a0.el y, b0.el y].rd X ((G.act y x f).nt X g) (I.TC[y, x, f, X, g, (elx x).eob X g].res) V h j)
       (PY.IdY[G.ob y, T.ty y, a0.el y, b0.el y].rd X ((G.act y x f).nt X g) ((elx y).eob X ((G.act y x f).nt X g)) V h j) =
   transH (I.rd-C y x f X g ((elx x).eob X g) V h j)
    (transH (UC y x f V ((G.ob x).act V X h g) j)
      (apH (\ p -> pairE (G.ob y) (T.ty y) V p (Lf y V p j)) ((G.act y x f).nt-nat V X h g))) ;
  nat (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X))
   : Id (SigT (G.ob y) (I.ty y) X) ((I.IdT.tE y x f).nt X (pairE (G.ob x) (I.ty x) X g ((elx x).eob X g)))
       (pairE (G.ob y) (I.ty y) X ((G.act y x f).nt X g) ((elx y).eob X ((G.act y x f).nt X g))) =
   I.idC-eq y X ((I.IdT.tE y x f).nt X (pairE (G.ob x) (I.ty x) X g ((elx x).eob X g)))
    (pairE (G.ob y) (I.ty y) X ((G.act y x f).nt X g) ((elx y).eob X ((G.act y x f).nt X g)))
    (refl ((G.act y x f).nt X g)) (rdE y x f X g) (refl (PB.emptyS X)) ;
  el : CEl[G, I.IdT] = new CEl[G, I.IdT, elx, nat] ;
 } ;

 ------------------------------------------------------------------
 -- (B) Given f g : El (Pi_A B) and h : El (G.A , Id_B (app f , app g)),
 -- let hv x K z j : B_x (K , z) be the value of the path h z at
 -- (K , id , j).  Its total hvT is natural in the base (hvT-nat: readings
 -- are natural, h is natural) and in C (hvT-C: CPshId.rd-C, h natural in
 -- C); at the ends it is app f and app g.

 module NFC (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (f g : CEl[G, PO.PiC[G, A, B].PiT])
  (h : CEl[LO.ExtC G A, IDm.IdC[LO.ExtC G A, B, PL.L[G, A, B].App[f].app, PL.L[G, A, B].App[g].app].IdT]) {
  module PC = PO.PiC[G, A, B] ;
  module LW = PL.L[G, A, B] ;
  E : CCtx = PC.E ;
  module IB = IDm.IdC[E, B, LW.App[f].app, LW.App[g].app] ;
  module Hx (x : CO) {
   module YB = PY.IdY[E.ob x, B.ty x, LW.App[f].appEl x, LW.App[g].appEl x] ;
   module TBx = GPR.TyL[E.ob x, B.ty x] ;
   hw (K : Ob) (z : PC.TA x K) : W0.Ix (YB.tob K z) = (h.el x).eob K z ;
   hv (K : Ob) (z : PC.TA x K) (j : Hom K Iv) : W0.Ix ((B.ty x).tob K z) =
    TBx.coeT K (YB.pt K z K (idH K)) z ((E.ob x).act-id K z) ((hw K z).1.1 K (idH K) j) ;
   hvT (K : Ob) (z : PC.TA x K) (j : Hom K Iv) : PC.TB x K = PC.prB x K z (hv K z j) ;
   hv-rd (K : Ob) (z : PC.TA x K) (j : Hom K Iv) : Id (PC.TB x K) (hvT K z j) (YB.rd K z (hw K z) K (idH K) j) =
    symH (TBx.pr-coe K (YB.pt K z K (idH K)) z ((E.ob x).act-id K z) ((hw K z).1.1 K (idH K) j)) ;
   -- it depends on z and j only
   hvT-cong (K : Ob) (z z' : PC.TA x K) (ez : Id (PC.TA x K) z z') (j j' : Hom K Iv) (ej : Id (Hom K Iv) j j')
    : Id (PC.TB x K) (hvT K z j) (hvT K z' j') =
    idJ (PC.TA x K) z (\ z1 e1 -> Id (PC.TB x K) (hvT K z j) (hvT K z1 j')) (apH (\ j1 -> hvT K z j1) ej) z' ez ;
   -- naturality in the base
   hvT-nat (L K : Ob) (m : Hom L K) (z : PC.TA x K) (j : Hom K Iv)
    : Id (PC.TB x L) ((extP (E.ob x) (B.ty x)).act L K m (hvT K z j)) (hvT L ((E.ob x).act L K m z) (compH L K Iv j m)) =
    transH (apH (\ t -> (extP (E.ob x) (B.ty x)).act L K m t) (hv-rd K z j))
     (transH (YB.rd-nat K z (hw K z) L K m (idH K) j)
       (transH (apH (\ k -> YB.rd K z (hw K z) L k (compH L K Iv j m)) (transH (comp-idl L K m) (symH (comp-idr L K m))))
         (transH (symH (YB.Tact[L, K, m, z, (E.ob x).act L K m z, refl ((E.ob x).act L K m z), hw K z].rdc L (idH L) (compH L K Iv j m)))
           (transH (apH (\ w -> YB.rd L ((E.ob x).act L K m z) w L (idH L) (compH L K Iv j m))
                      ((h.el x).enat L K m z ((E.ob x).act L K m z) (refl ((E.ob x).act L K m z))))
             (symH (hv-rd L ((E.ob x).act L K m z) (compH L K Iv j m))))))) ;
   -- at an end
   hvT-end (c : PEl[E.ob x, B.ty x]) (e : PB.IPt) (K : Ob) (z : PC.TA x K)
    (Ez : Id (W0.Ix ((B.ty x).tob K (YB.pt K z K (idH K)))) ((hw K z).1.1 K (idH K) (PB.ptH K e)) (c.eob K (YB.pt K z K (idH K))))
    : Id (PC.TB x K) (hvT K z (PB.ptH K e)) (PC.prB x K z (c.eob K z)) =
    transH (hv-rd K z (PB.ptH K e))
     (transH (apH (\ v -> TBx.pr K (YB.pt K z K (idH K)) v) Ez)
       (apH (\ z1 -> TBx.pr K z1 (c.eob K z1)) ((E.ob x).act-id K z))) ;
   hvT-0 (K : Ob) (z : PC.TA x K) : Id (PC.TB x K) (hvT K z (PB.ptH K PB.e0)) (PC.prB x K z (LW.App[f].appV x K z)) =
    hvT-end (LW.App[f].appEl x) PB.e0 K z ((hw K z).1.2.2.1 K (idH K)) ;
   hvT-1 (K : Ob) (z : PC.TA x K) : Id (PC.TB x K) (hvT K z (PB.ptH K PB.e1)) (PC.prB x K z (LW.App[g].appV x K z)) =
    hvT-end (LW.App[g].appEl x) PB.e1 K z ((hw K z).1.2.2.2 K (idH K)) ;
  } ;
  -- naturality in C
  hvT-C (y x : CO) (k : CH y x) (K : Ob) (z : PC.TA x K) (j : Hom K Iv)
   : Id (PC.TB y K) ((B.tE y x k).nt K (Hx[x].hvT K z j)) (Hx[y].hvT K ((A.tE y x k).nt K z) j) =
   transH (apH (\ t -> (B.tE y x k).nt K t) (Hx[x].hv-rd K z j))
    (transH (symH (IB.rd-C y x k K z (Hx[x].hw K z) K (idH K) j))
      (transH (apH (\ w -> Hx[y].YB.rd K ((A.tE y x k).nt K z) w K (idH K) j)
                 (GPR.TyL[E.ob y, IB.ty y].pr-inj K ((A.tE y x k).nt K z) (IB.TC[y, x, k, K, z, Hx[x].hw K z].res) (Hx[y].hw K ((A.tE y x k).nt K z))
                    (h.el-nat y x k K z)))
        (symH (Hx[y].hv-rd K ((A.tE y x k).nt K z) j)))) ;

  ------------------------------------------------------------------
  -- the line field of Pi_A B: at x, (W , y , j), the family whose
  -- component (y' , f') has the values hv y' K (.. , a1) (j m)

  module LfAt (x : CO) (W : Ob) (y : W0.Ix ((G.ob x).ob W)) (j : Hom W Iv) {
   module S = PC.At[x, W, y] ;
   module Cy (y' : CO) (f' : CH y' x) {
    module Kk = L54.KB[G, A, B].AtK[y', W, S.ptC y' f'] ;
    vv : Kk.VT = \ K m a1 -> Hx[y'].hv K (PC.prA y' K (Kk.pH K m) a1) (compH K W Iv j m) ;
    vn : Kk.VN vv = \ Y' Y jj hh a0 ->
     transH (Hx[y'].hvT-nat Y' Y jj (PC.prA y' Y (Kk.pH Y hh) a0) (compH Y W Iv j hh))
      (Hx[y'].hvT-cong Y' ((E.ob y').act Y' Y jj (PC.prA y' Y (Kk.pH Y hh) a0))
         (PC.prA y' Y' (Kk.pH Y' (compH Y' Y W hh jj)) (Kk.aAct Y' Y jj hh a0)) (Kk.aAct-pr Y' Y jj hh a0)
         (compH Y' Y Iv (compH Y W Iv j hh) jj) (compH Y' W Iv j (compH Y' Y W hh jj)) (comp-assoc Y' Y W Iv j hh jj)) ;
    el : Kk.PiK = Kk.mk vv vn ;
   } ;
   lfB : S.Comp = \ y' f' -> Cy[y', f'].el ;
   valLf (y' : CO) (f' : CH y' x) (K : Ob) (m : Hom K W) (w : PC.TA y' K)
    (r : Id (W0.Ix ((G.ob y').ob K)) (fstE (G.ob y') (A.ty y') K w) (S.ptH y' f' K m))
    : Id (PC.TB y' K) (S.valAt lfB y' f' K m w r) (Hx[y'].hvT K w (compH K W Iv j m)) =
    Hx[y'].hvT-cong K (PC.prA y' K (S.ptH y' f' K m) (S.coeA y' f' K m w r)) w (symH (S.coeA-pr y' f' K m w r))
     (compH K W Iv j m) (compH K W Iv j m) (refl (compH K W Iv j m)) ;
   lfN : S.CNat lfB = \ z y' k f' K m a1 ->
    transH (hvT-C z y' k K (PC.prA y' K (S.ptH y' f' K m) a1) (compH K W Iv j m))
     (Hx[z].hvT-cong K (S.mvA z y' k f' K m a1) (PC.prA z K (S.ptH z (co z y' x f' k) K m) (S.aM z y' k f' K m a1)) (S.aM-mv z y' k f' K m a1)
        (compH K W Iv j m) (compH K W Iv j m) (refl (compH K W Iv j m))) ;
   lfI : S.PiIx = (lfB, lfN) ;
  } ;
  Lf (x : CO) (W : Ob) (y : W0.Ix ((G.ob x).ob W)) (j : Hom W Iv) : W0.Ix ((PC.piTy x).tob W y) = LfAt[x, W, y, j].lfI ;

  -- natural in the base
  module UN (x : CO) (V1 W : Ob) (g1 : Hom V1 W) (y : W0.Ix ((G.ob x).ob W)) (y' : W0.Ix ((G.ob x).ob V1))
   (Ep : Id (W0.Ix ((G.ob x).ob V1)) ((G.ob x).act V1 W g1 y) y') (j : Hom W Iv) {
   module Ac = PC.Act[x, V1, W, g1, y, y', Ep] ;
   module L1 = LfAt[x, W, y, j] ;
   module L2 = LfAt[x, V1, y', compH V1 W Iv j g1] ;
   v (y2 : CO) (f2 : CH y2 x) (K : Ob) (m : Hom K V1) (a1 : Ac.T.FA y2 f2 K m)
    : Id (PC.TB y2 K) (Ac.T.valT (Ac.actC L1.lfB) y2 f2 K m a1) (Ac.T.valT L2.lfB y2 f2 K m a1) =
    transH (Ac.valAct L1.lfB y2 f2 K m a1)
     (transH (L1.valLf y2 f2 K (compH K V1 W g1 m) (PC.prA y2 K (Ac.T.ptH y2 f2 K m) a1) (symH (Ac.pP y2 f2 K m)))
       (Hx[y2].hvT-cong K (PC.prA y2 K (Ac.T.ptH y2 f2 K m) a1) (PC.prA y2 K (Ac.T.ptH y2 f2 K m) a1) (refl (PC.prA y2 K (Ac.T.ptH y2 f2 K m) a1))
          (compH K W Iv j (compH K V1 W g1 m)) (compH K V1 Iv (compH V1 W Iv j g1) m) (symH (comp-assoc K V1 W Iv j g1 m)))) ;
   res : Id (Ac.T.PiIx) (Ac.act L1.lfI) L2.lfI =
    Ac.T.pi-eq (Ac.act L1.lfI) L2.lfI (\ y2 f2 K m a1 ->
     GPR.TyL[E.ob y2, B.ty y2].pr-inj K (PC.prA y2 K (Ac.T.ptH y2 f2 K m) a1)
      (Ac.T.val (Ac.actC L1.lfB) y2 f2 K m a1) (Ac.T.val L2.lfB y2 f2 K m a1) (v y2 f2 K m a1)) ;
  } ;

  -- its ends are f and g
  module UE (x : CO) (W : Ob) (y : W0.Ix ((G.ob x).ob W)) {
   module S = PC.At[x, W, y] ;
   v0 (y2 : CO) (f2 : CH y2 x) (K : Ob) (m : Hom K W) (a1 : S.FA y2 f2 K m)
    : Id (PC.TB y2 K) (S.valT LfAt[x, W, y, PB.ptH W PB.e0].lfB y2 f2 K m a1) (S.valT ((f.el x).eob W y).1 y2 f2 K m a1) =
    transH (Hx[y2].hvT-cong K (PC.prA y2 K (S.ptH y2 f2 K m) a1) (PC.prA y2 K (S.ptH y2 f2 K m) a1) (refl (PC.prA y2 K (S.ptH y2 f2 K m) a1))
              (compH K W Iv (PB.ptH W PB.e0) m) (PB.ptH K PB.e0) (PB.ptH-nat K W m PB.e0))
     (transH (Hx[y2].hvT-0 K (PC.prA y2 K (S.ptH y2 f2 K m) a1))
       (transH LW.Eta[f].EAt[x, W, y, y2, f2, K, m, a1].e1
         (transH LW.Eta[f].EAt[x, W, y, y2, f2, K, m, a1].e2 LW.Eta[f].EAt[x, W, y, y2, f2, K, m, a1].e3))) ;
   v1 (y2 : CO) (f2 : CH y2 x) (K : Ob) (m : Hom K W) (a1 : S.FA y2 f2 K m)
    : Id (PC.TB y2 K) (S.valT LfAt[x, W, y, PB.ptH W PB.e1].lfB y2 f2 K m a1) (S.valT ((g.el x).eob W y).1 y2 f2 K m a1) =
    transH (Hx[y2].hvT-cong K (PC.prA y2 K (S.ptH y2 f2 K m) a1) (PC.prA y2 K (S.ptH y2 f2 K m) a1) (refl (PC.prA y2 K (S.ptH y2 f2 K m) a1))
              (compH K W Iv (PB.ptH W PB.e1) m) (PB.ptH K PB.e1) (PB.ptH-nat K W m PB.e1))
     (transH (Hx[y2].hvT-1 K (PC.prA y2 K (S.ptH y2 f2 K m) a1))
       (transH LW.Eta[g].EAt[x, W, y, y2, f2, K, m, a1].e1
         (transH LW.Eta[g].EAt[x, W, y, y2, f2, K, m, a1].e2 LW.Eta[g].EAt[x, W, y, y2, f2, K, m, a1].e3))) ;
   u0 : Id S.PiIx (Lf x W y (PB.ptH W PB.e0)) ((f.el x).eob W y) =
    S.pi-eq (Lf x W y (PB.ptH W PB.e0)) ((f.el x).eob W y) (\ y2 f2 K m a1 ->
     GPR.TyL[E.ob y2, B.ty y2].pr-inj K (PC.prA y2 K (S.ptH y2 f2 K m) a1)
      (S.val LfAt[x, W, y, PB.ptH W PB.e0].lfB y2 f2 K m a1) (S.val ((f.el x).eob W y).1 y2 f2 K m a1) (v0 y2 f2 K m a1)) ;
   u1 : Id S.PiIx (Lf x W y (PB.ptH W PB.e1)) ((g.el x).eob W y) =
    S.pi-eq (Lf x W y (PB.ptH W PB.e1)) ((g.el x).eob W y) (\ y2 f2 K m a1 ->
     GPR.TyL[E.ob y2, B.ty y2].pr-inj K (PC.prA y2 K (S.ptH y2 f2 K m) a1)
      (S.val LfAt[x, W, y, PB.ptH W PB.e1].lfB y2 f2 K m a1) (S.val ((g.el x).eob W y).1 y2 f2 K m a1) (v1 y2 f2 K m a1)) ;
  } ;

  -- natural in C
  UC (y0 x : CO) (f0 : CH y0 x) (W : Ob) (g0 : W0.Ix ((G.ob x).ob W)) (j : Hom W Iv)
   : Id (PC.TP y0 W) ((PC.PiT.tE y0 x f0).nt W (PC.prP x W g0 (Lf x W g0 j)))
       (PC.prP y0 W ((G.act y0 x f0).nt W g0) (Lf y0 W ((G.act y0 x f0).nt W g0) j)) =
   PC.tot-ext y0 W ((G.act y0 x f0).nt W g0) ((G.act y0 x f0).nt W g0) (refl ((G.act y0 x f0).nt W g0))
    (PC.CAct[y0, x, f0, W, g0].rix (Lf x W g0 j)) (Lf y0 W ((G.act y0 x f0).nt W g0) j)
    (\ y2 f2 K m w r r' ->
      transH (PC.CAct[y0, x, f0, W, g0].valRix-at LfAt[x, W, g0, j].lfB y2 f2 K m w r (PC.CAct[y0, x, f0, W, g0].rS y2 f2 K m w r))
       (transH (LfAt[x, W, g0, j].valLf y2 (co y2 y0 x f0 f2) K m w (PC.CAct[y0, x, f0, W, g0].rS y2 f2 K m w r))
         (symH (LfAt[y0, W, (G.act y0 x f0).nt W g0, j].valLf y2 f2 K m w r')))) ;

  -- NAIVE FUNCTION EXTENSIONALITY
  module LY = LineYC[G, PC.PiT, f, g, Lf,
    \ x V1 W g1 y y' Ep j -> UN[x, V1, W, g1, y, y', Ep, j].res,
    \ x W y -> UE[x, W, y].u0, \ x W y -> UE[x, W, y].u1, UC] ;
  nf : CEl[G, IDm.IdC[G, PC.PiT, f, g].IdT] = LY.el ;
 } ;
} ;
