-- CTotL14d.seg (canonicity-45; SIMPLIFIED.md step 4): Lemma 14 at the
-- total site, part d: chain lemmas for prepending the identity
-- (ConsId.consId c = (x, id, c)) at a stage of the total site, where
-- restriction and reindexing act on chains (they do not at the poset site).
--   rx-id      reindexing along the identity is the identity
--   trCh-cons  moving the head commutes with consId
--   rCh-cons   restricting consId c is consId of the restricted chain
--   vpart-cart the vertical part of a cartesian lift is the identity
--   rxM-cart   reindexing along a cartesian lift (rxM at vpart cart)
--              commutes with consId
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module L14d (C : CIntCat[a, vl].IC) {
 module VT = CVert[a, vl].VertOf[C] ;
 module CT = CChainsT[a, vl].ChT[C] ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 module KJ (J : Ob) { module K = Chains[vl].ChainsOf[VT.VCat J] ; module CI = ConsId[vl].ConsOf[VT.VCat J] ; } ;

 -- reindexing along the identity
 rx-id (J : Ob) : (n : Nat) (x z : Obj J) (c : KJ[J].K.Ch n x z) -> Id (KJ[J].K.Ch n x z) (KJ[J].K.rx n x x (VT.vid J x) z c) c = split {
  zero -> \ x z c -> VT.vcomp-idl J z x c ;
  suc m -> \ x z c -> apH {VT.VMap J c.1 x} {KJ[J].K.Ch (suc m) x z} (\ h -> (c.1, h, c.2.2)) (VT.vcomp-idl J c.1 x c.2.1) } ;
 rx-id-cons (J : Ob) (n : Nat) (x z : Obj J) (c : KJ[J].K.Ch n x z)
  : Id (KJ[J].K.Ch (suc n) x z) (KJ[J].K.rx (suc n) x x (VT.vid J x) z (KJ[J].CI.consId n x z c)) (KJ[J].CI.consId n x z c) =
  rx-id J (suc n) x z (KJ[J].CI.consId n x z c) ;

 -- moving the head commutes with consId
 trCh-cons (J : Ob) (n : Nat) (x x' : Obj J) (p : Id (Obj J) x x') (z : Obj J) (c : KJ[J].K.Ch n x z)
  : Id (KJ[J].K.Ch (suc n) x' z) (CT.trCh J (suc n) x x' p z (KJ[J].CI.consId n x z c)) (KJ[J].CI.consId n x' z (CT.trCh J n x x' p z c)) =
  idJ (Obj J) x (\ w q -> Id (KJ[J].K.Ch (suc n) w z) (CT.trCh J (suc n) x w q z (KJ[J].CI.consId n x z c)) (KJ[J].CI.consId n w z (CT.trCh J n x w q z c)))
   (refl (KJ[J].CI.consId n x z c)) x' p ;

 -- restriction of consId
 rCh-cons (J' J I : Ob) (v : Hom J' J) (u : Hom J I) (x : Obj I) (n : Nat) (z : Obj J) (c : KJ[J].K.Ch n (C.res J I u x) z)
  : Id (KJ[J'].K.Ch (suc n) (C.res J' I (compH J' J I u v) x) (C.res J' J v z))
       (CT.rCh J' J I v u x (suc n) z (KJ[J].CI.consId n (C.res J I u x) z c))
       (KJ[J'].CI.consId n (C.res J' I (compH J' J I u v) x) (C.res J' J v z) (CT.rCh J' J I v u x n z c)) =
  transH (apH {VT.VMap J' (C.res J' J v (C.res J I u x)) (C.res J' J v (C.res J I u x))} {KJ[J'].K.Ch (suc n) (C.res J' I (compH J' J I u v) x) (C.res J' J v z)}
            (\ h -> CT.trCh J' (suc n) (C.res J' J v (C.res J I u x)) (C.res J' I (compH J' J I u v) x) (symH (C.res-comp J' J I u v x)) (C.res J' J v z)
                      (C.res J' J v (C.res J I u x), h, CChainsF[vl].CF[VT.VCat J, VT.VCat J', VT.rfun J' J v].chF n (C.res J I u x) z c))
            (symH (VT.rmap-id J' J v (C.res J I u x))))
   (trCh-cons J' n (C.res J' J v (C.res J I u x)) (C.res J' I (compH J' J I u v) x) (symH (C.res-comp J' J I u v x)) (C.res J' J v z)
     (CChainsF[vl].CF[VT.VCat J, VT.VCat J', VT.rfun J' J v].chF n (C.res J I u x) z c)) ;

 -- the vertical part of a cartesian lift
 vpart-cart (J I : Ob) (u : Hom J I) (x : Obj I)
  : Id (VT.VMap J (C.res J I u x) (C.res J I u x)) (VT.vpart J I u (C.res J I u x) x (C.cart J I u x)) (VT.vid J (C.res J I u x)) =
  symH (C.fact-uniq J J I u (idH J) (C.res J I u x) x
         (VT.trH J I u (compH J J I u (idH J)) (symH (comp-idr J I u)) (C.res J I u x) x (C.cart J I u x))
         (VT.vid J (C.res J I u x))
         (symH (VT.THom-snd' J I (C.res J I u x) x (u, C.cart J I u x)
                  (compH J J I u (idH J), C.compD J J I u (idH J) (C.res J I u x) (C.res J I u x) x (C.cart J I u x) (C.idD J (C.res J I u x)))
                  (symH (C.idr J I u (C.res J I u x) x (C.cart J I u x))) (symH (comp-idr J I u))))) ;

 -- reindexing along a cartesian lift commutes with consId
 rxM-cart (J J0 I : Ob) (u : Hom J J0) (u0 : Hom J0 I) (x : Obj I) (n : Nat) (z : Obj J)
  (c : KJ[J].K.Ch n (C.res J J0 u (C.res J0 I u0 x)) z)
  : Id (KJ[J].K.Ch (suc n) (C.res J I (compH J J0 I u0 u) x) z)
       (CT.rxM J J0 I u u0 (C.res J0 I u0 x) x (VT.vpart J0 I u0 (C.res J0 I u0 x) x (C.cart J0 I u0 x)) (suc n) z (KJ[J].CI.consId n (C.res J J0 u (C.res J0 I u0 x)) z c))
       (KJ[J].CI.consId n (C.res J I (compH J J0 I u0 u) x) z (CT.rxM J J0 I u u0 (C.res J0 I u0 x) x (VT.vpart J0 I u0 (C.res J0 I u0 x) x (C.cart J0 I u0 x)) n z c)) =
  transH (apH {VT.VMap J0 (C.res J0 I u0 x) (C.res J0 I u0 x)} {KJ[J].K.Ch (suc n) (C.res J I (compH J J0 I u0 u) x) z}
            (\ g -> CT.rxM J J0 I u u0 (C.res J0 I u0 x) x g (suc n) z (KJ[J].CI.consId n (C.res J J0 u (C.res J0 I u0 x)) z c))
            (vpart-cart J0 I u0 x))
   (transH (apH {VT.VMap J (C.res J J0 u (C.res J0 I u0 x)) (C.res J J0 u (C.res J0 I u0 x))} {KJ[J].K.Ch (suc n) (C.res J I (compH J J0 I u0 u) x) z}
              (\ h -> CT.trCh J (suc n) (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z
                        (KJ[J].K.rx (suc n) (C.res J J0 u (C.res J0 I u0 x)) (C.res J J0 u (C.res J0 I u0 x)) h z (KJ[J].CI.consId n (C.res J J0 u (C.res J0 I u0 x)) z c)))
              (symH (VT.rmap-id J J0 u (C.res J0 I u0 x))))
     (transH (apH {KJ[J].K.Ch (suc n) (C.res J J0 u (C.res J0 I u0 x)) z} {KJ[J].K.Ch (suc n) (C.res J I (compH J J0 I u0 u) x) z}
                (\ cc -> CT.trCh J (suc n) (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z cc)
                (rx-id-cons J n (C.res J J0 u (C.res J0 I u0 x)) z c))
       (transH (trCh-cons J n (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z c)
         (apH {KJ[J].K.Ch n (C.res J I (compH J J0 I u0 u) x) z} {KJ[J].K.Ch (suc n) (C.res J I (compH J J0 I u0 u) x) z}
            (\ cc -> KJ[J].CI.consId n (C.res J I (compH J J0 I u0 u) x) z cc)
            (symH (transH (apH {VT.VMap J0 (C.res J0 I u0 x) (C.res J0 I u0 x)} {KJ[J].K.Ch n (C.res J I (compH J J0 I u0 u) x) z}
                             (\ g -> CT.rxM J J0 I u u0 (C.res J0 I u0 x) x g n z c) (vpart-cart J0 I u0 x))
                     (transH (apH {VT.VMap J (C.res J J0 u (C.res J0 I u0 x)) (C.res J J0 u (C.res J0 I u0 x))} {KJ[J].K.Ch n (C.res J I (compH J J0 I u0 u) x) z}
                                (\ h -> CT.trCh J n (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z
                                          (KJ[J].K.rx n (C.res J J0 u (C.res J0 I u0 x)) (C.res J J0 u (C.res J0 I u0 x)) h z c))
                                (symH (VT.rmap-id J J0 u (C.res J0 I u0 x))))
                       (apH {KJ[J].K.Ch n (C.res J J0 u (C.res J0 I u0 x)) z} {KJ[J].K.Ch n (C.res J I (compH J J0 I u0 u) x) z}
                          (\ cc -> CT.trCh J n (C.res J J0 u (C.res J0 I u0 x)) (C.res J I (compH J J0 I u0 u) x) (symH (C.res-comp J J0 I u0 u x)) z cc)
                          (rx-id J n (C.res J J0 u (C.res J0 I u0 x)) z c))))))))) ;
} ;
