-- CTotL14g.seg (canonicity-45; SIMPLIFIED.md step 4): Lemma 14 at the
-- total site, part g: U tau_A has a quasi-inverse at the levelwise site,
-- given a fibration structure of D A over D G at the total site (Lemma
-- 12's fibration half, a module parameter until it lands).
--   MWEq      MW only depends on the weights it reads
--   MW0       MW at the weights (0, i) is u (u's face-0 equation, comp0)
--   q         id ~ m, the line of the weights (t, i)
--   P0.R      MW at (1, 0..0) on a chain of length n is the reading of
--             tau (eps u) there: induction on n through u's top equations
--             (the identity chain at n = 0 is read through eps, part c)
--   p         tau eps ~ m, the line of the weights (1, t /\ i)
--   lemma14   (eps, eps tau ~ id, tau eps ~ id = p . q^-1), the
--             composition of U B from fbD pulled back along tau (FibSub)
--             and restricted along U (CTotUFib4.fibU)
-- No new axioms beyond the named premises (fe) and the module parameter.

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module WS = CTotL14f[a, vl, l] ;

one0 (W : Ob) : Wt.Pn zero W = CTotL14b[a, vl, l].one0 W ;
-- the top face of (1) is (1 , 0)
base2 (J : Ob) (hy : Tr.IsT (Tr.leb (suc zero) (suc zero))) : (m : Nat) -> (h : Tr.IsT (Ar.ltb (suc m) (suc (suc zero))))
  -> Id (Hom J PFO.ivO) (Wt.Face[zero, J, suc zero, hy].valB (one0 J).1 (suc m) h (eqN (suc m) (suc zero)) (refl (eqN (suc m) (suc zero))))
                      (Wt.consB zero J (PB.ptH J PB.e1) (Wt.zeros zero J) (suc m) h) = split {
 zero -> \ h -> refl (PB.ptH J PB.e0) ;
 suc m -> \ h -> absurd _ (Tr.false-true h) } ;
base1 (J : Ob) (hy : Tr.IsT (Tr.leb (suc zero) (suc zero))) : (m : Nat) -> (h : Tr.IsT (Ar.ltb m (suc (suc zero))))
  -> Id (Hom J PFO.ivO) (Wt.Face[zero, J, suc zero, hy].valB (one0 J).1 m h (eqN m (suc zero)) (refl (eqN m (suc zero))))
                      (Wt.consB zero J (PB.ptH J PB.e1) (Wt.zeros zero J) m h) = split {
 zero -> \ h -> refl (PB.ptH J PB.e1) ;
 suc m -> base2 J hy m } ;
baseC (J : Ob) (hy : Tr.IsT (Tr.leb (suc zero) (suc zero))) (k : Ar.Fin (suc (suc zero)))
  : Id (Hom J PFO.ivO) (Wt.Face[zero, J, suc zero, hy].faceC (one0 J).1 k) (Wt.TopOne[J].C1 zero k) = base1 J hy k.1 k.2 ;

module L14g (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LB = CTotL14b[a, vl, l].L14b[C, G, A] ;
 module LC = CTotL14c[a, vl, l].L14c[C, G, A] ;
 module ME = CTotL14e[a, vl, l].L14e[C, G, A] ;
 module LF = CTotL14f[a, vl, l].L14f[C, G, A] ;
 module U12 = ME.U12 ;
 module TC = LB.TC ;
 module P = LB.P ;
 module VT = LB.VT ;
 module DA = LB.DA ;
 module D = LB.D ;
 module TR = LB.TR ;
 module G0 = TR.G0 ;
 module G1 = TR.G1 ;
 module HO = LB.HO ;
 module GP0 = LF.GP0 ;
 E : P.PCtx = LB.E ;
 GP : P.PCtx = LB.GP ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 ------------------------------------------------------------------
 -- MW only depends on the weights it reads
 module MWEq (Wf : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (Vf : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Vres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Vf n J t i].res) (Vf n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)))
  (Vface : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Vf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Vf n J t i].face))
  (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) (t t' : Hom I PFO.ivO)
  (Hw : (q : DA.Idx I x) (l : DA.LandsI I x q)
     -> Id (Wt.Pn (suc q.1) q.2.1) (Wf q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t q.2.2.1) (q.2.2.2.2.2, l))
                                  (Vf q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t' q.2.2.1) (q.2.2.2.2.2, l))) {
  module M = ME.MW[Wf, Wres, Wface, I, x, g, u, t] ;
  module M' = ME.MW[Vf, Vres, Vface, I, x, g, u, t'] ;
  eq : Id (DA.TOb' I x M.tg) M.res M'.res =
   DA.tob-eq I x M.tg M.res M'.res (\ q l ->
    DA.pr-inj q.2.1 q.2.2.2.1 (M.tg.1 q l) (M.mv q l) (M'.mv q l)
     (transH (M.mpc q l)
       (transH (apH {Wt.Pn (suc q.1) q.2.1} {DA.Ez q.2.1 q.2.2.2.1}
                  (M.rr q.1 q.2.1 q.2.2.1 q.2.2.2.1 (ME.KJ[q.2.1].CI.consId q.1 (C.res q.2.1 I q.2.2.1 x) q.2.2.2.1 q.2.2.2.2.1)) (Hw q l))
         (symH (M'.mpc q l))))) ;
 } ;

 -- MW at the weights (0, i) is u
 module MW0 (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) {
  module M = ME.MW[WS.WfCons, WS.WresCons, WS.WfaceCons, I, x, g, u, PB.ptH I PB.e0] ;
  eq : Id (DA.TOb' I x M.tg) M.res u =
   DA.tob-eq I x M.tg M.res u (\ q l ->
    DA.pr-inj q.2.1 q.2.2.2.1 (M.tg.1 q l) (M.mv q l) (u.1 q l)
     (transH (M.mpc q l)
       (transH (apH {Wt.Pn (suc q.1) q.2.1} {DA.Ez q.2.1 q.2.2.2.1}
                  (M.rr q.1 q.2.1 q.2.2.1 q.2.2.2.1 (ME.KJ[q.2.1].CI.consId q.1 (C.res q.2.1 I q.2.2.1 x) q.2.2.2.1 q.2.2.2.2.1))
                  (transH (WS.pnEq (suc q.1) q.2.1 (M.wq q l) (Wt.Face[q.1, q.2.1, zero, refl true].Of[(q.2.2.2.2.2, l)].face) (\ k ->
                             transH (apH {Hom q.2.1 PFO.ivO} {Hom q.2.1 PFO.ivO} (\ jj -> Wt.consC q.1 q.2.1 jj q.2.2.2.2.2 k) (PB.ptH-nat q.2.1 I q.2.2.1 PB.e0))
                               (Wt.ConsZero[q.1, q.2.1, q.2.2.2.2.2].coord k)))
                    (U12.faceW-irr q.1 q.2.1 zero (refl true) (Ar.leb-step zero q.1 (refl true)) (q.2.2.2.2.2, l))))
         (transH (u.2.2.1 (q.1, zero, refl true, q.2.1, q.2.2.1, q.2.2.2.1, ME.KJ[q.2.1].CI.consId q.1 (C.res q.2.1 I q.2.2.1 x) q.2.2.2.1 q.2.2.2.2.1, q.2.2.2.2.2) l)
           (apH {ME.KJ[q.2.1].K.Ch q.1 (C.res q.2.1 I q.2.2.1 x) q.2.2.2.1} {DA.Ez q.2.1 q.2.2.2.1}
              (\ cc -> DA.prz q.2.1 q.2.2.2.1 (M.tg.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, cc, q.2.2.2.2.2) l) (u.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, cc, q.2.2.2.2.2) l))
              (ME.KJ[q.2.1].CI.comp0 q.1 (C.res q.2.1 I q.2.2.1 x) q.2.2.2.1 q.2.2.2.2.1)))))) ;
 } ;

 ------------------------------------------------------------------
 -- q : id ~ m
 module QL {
  module LNc = LF.LN[WS.WfCons, WS.WresCons, WS.WfaceCons] ;
  module TX = LNc.TX ;
  en0 (X : G0.TOb) (z : W0.Ix ((LB.RS.P0.extP LB.UG LB.UB).ob X))
   : Id (TX.EI X) (LNc.mwe X z (PB.ptH X.1 PB.e0)) (HO.HT[LB.UG, LB.UB, LB.UB, HO.idN LB.UG LB.UB, LF.mN].aE X z) =
   apH {DA.TOb' X.1 X.2 (D.tau X.1 X.2 (TX.pr1 X z))} {TX.EI X} (TX.pr X (TX.pr1 X z)) (MW0[X.1, X.2, TX.pr1 X z, TX.pr2 X z].eq) ;
  en1 (X : G0.TOb) (z : W0.Ix ((LB.RS.P0.extP LB.UG LB.UB).ob X))
   : Id (TX.EI X) (LNc.mwe X z (PB.ptH X.1 PB.e1)) (HO.HT[LB.UG, LB.UB, LB.UB, HO.idN LB.UG LB.UB, LF.mN].bE X z) =
   apH {DA.TOb' X.1 X.2 (D.tau X.1 X.2 (TX.pr1 X z))} {TX.EI X} (TX.pr X (TX.pr1 X z))
    (MWEq[WS.WfCons, WS.WresCons, WS.WfaceCons, WS.WfOne, WS.WresOne, WS.WfaceOne, X.1, X.2, TX.pr1 X z, TX.pr2 X z, PB.ptH X.1 PB.e1, PB.ptH X.1 PB.e1,
      \ q l -> WS.pnEq (suc q.1) q.2.1 (WS.WfCons q.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) q.2.2.1) (q.2.2.2.2.2, l))
                 (WS.WfOne q.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) q.2.2.1) (q.2.2.2.2.2, l))
                 (\ k -> apH {Hom q.2.1 PFO.ivO} {Hom q.2.1 PFO.ivO} (\ jj -> Wt.consC q.1 q.2.1 jj q.2.2.2.2.2 k) (PB.ptH-nat q.2.1 X.1 q.2.2.1 PB.e1))].eq) ;
  qH : LB.RS.P0.PEl[LB.RS.P0.extP LB.UG LB.UB, HO.HT[LB.UG, LB.UB, LB.UB, HO.idN LB.UG LB.UB, LF.mN].PT.PathP] =
   LF.LP[WS.WfCons, WS.WresCons, WS.WfaceCons, HO.idN LB.UG LB.UB, LF.mN, en0, en1].res ;
 } ;
 ------------------------------------------------------------------
 -- p : tau eps ~ m.  The end j = 0: MW at (1, 0..0) is tau (eps u)
 module P0 (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) {
  module E0 = LB.EP[I, x, g] ;
  ev : W0.Ix (A.tob (I, x) g) = E0.ev u ;
  pt : W0.Ix (E.ob (I, x)) = P.pairE GP A (I, x) g ev ;
  module Mp = ME.MW[WS.WfMeet, WS.WresMeet, WS.WfaceMeet, I, x, g, u, PB.ptH I PB.e0] ;
  C1w (n : Nat) (J : Ob) : Wt.Pn (suc n) J = Wt.consOne n J (Wt.zeros n J) ;
  veZ (n : Nat) (J : Ob) (u' : Hom J I) (z : Obj J) (c : ME.KJ[J].K.Ch n (C.res J I u' x) z) : DA.Ez J z =
   E.act (J, z) (I, x) (u', D.tmap I x n J u' z c) pt ;
  -- u at the identity chain at (J, u') with the weight (1) is eps u acted along cart u' x
  rdA (J : Ob) (u' : Hom J I) (s : D.S I x zero J (C.res J I u' x)) (p : Wt.Pn zero J) : DA.Ez J (C.res J I u' x) =
   DA.prz J (C.res J I u' x) (Mp.tg.1 (zero, J, s.1, C.res J I u' x, s.2, p.1) p.2) (u.1 (zero, J, s.1, C.res J I u' x, s.2, p.1) p.2) ;
  F0 (J : Ob) (u' : Hom J I)
   : Id (DA.Ez J (C.res J I u' x)) (E.act (J, C.res J I u' x) (I, x) (u', C.cart J I u' x) pt)
        (rdA J u' (u', VT.vid J (C.res J I u' x)) (one0 J)) =
   transH (apH {DA.Ez I x} {DA.Ez J (C.res J I u' x)} (\ w -> E.act (J, C.res J I u' x) (I, x) (u', C.cart J I u' x) w) (E0.epc u))
    (transH (u.2.1 (E0.q0, (J, u')) E0.l0)
      (transH (apH {D.S I x zero J (C.res J I u' x)} {DA.Ez J (C.res J I u' x)} (\ s -> rdA J u' s (Wt.Res[zero, J, I, u', one0 I].res))
                 (LC.SI[I, x, J, C.res J I u' x].sInj (LC.EN[J, I, u', x, g, u].s1) (u', VT.vid J (C.res J I u' x))
                    (transH (LC.EN[J, I, u', x, g, u].LY[G.act J I u' (C.res J I u' x) x (C.cart J I u' x) g].Q1)
                       (symH (transH (D.tmap-eq I x zero J u' (C.res J I u' x) (VT.vid J (C.res J I u' x)))
                                (C.idr J I u' (C.res J I u' x) x (C.cart J I u' x)))))))
        (apH {Wt.Pn zero J} {DA.Ez J (C.res J I u' x)} (\ p -> rdA J u' (u', VT.vid J (C.res J I u' x)) p) (CTotL14c[a, vl, l].one0-res J I u')))) ;
  R : (n : Nat) -> (J : Ob) (u' : Hom J I) (z : Obj J) (c : ME.KJ[J].K.Ch n (C.res J I u' x) z)
      -> Id (DA.Ez J z) (Mp.rr n J u' z (ME.KJ[J].CI.consId n (C.res J I u' x) z c) (C1w n J)) (veZ n J u' z c) = split {
   zero -> \ J u' z c ->
    transH (apH {Wt.Pn (suc zero) J} {DA.Ez J z} (Mp.rr zero J u' z (ME.KJ[J].CI.consId zero (C.res J I u' x) z c))
              (WS.pnEq (suc zero) J (C1w zero J) (Wt.Face[zero, J, suc zero, Tr.leb-refl (suc zero)].Of[one0 J].face)
                 (\ k -> symH (baseC J (Tr.leb-refl (suc zero)) k))))
     (transH (u.2.2.2 (zero, J, u', z, ME.KJ[J].CI.consId zero (C.res J I u' x) z c, (one0 J).1) (one0 J).2)
       (transH (apH {DA.Ez J (C.res J I u' x)} {DA.Ez J z} (E.act (J, z) (J, C.res J I u' x) (idH J, c)) (symH (F0 J u')))
         (transH (symH (E.act-o (J, z) (J, C.res J I u' x) (I, x) (u', C.cart J I u' x) (idH J, c) pt))
           (apH {VT.TH J z I x} {DA.Ez J z} (\ h -> E.act (J, z) (I, x) h pt) (symH (D.tmap-eq I x zero J u' z c)))))) ;
   suc m | ih -> \ J u' z c ->
    transH (apH {Wt.Pn (suc (suc m)) J} {DA.Ez J z} (Mp.rr (suc m) J u' z (ME.KJ[J].CI.consId (suc m) (C.res J I u' x) z c))
              (WS.pnEq (suc (suc m)) J (C1w (suc m) J) (Wt.Face[suc m, J, suc (suc m), Tr.leb-refl (suc (suc m))].Of[C1w m J].face)
                 (\ k -> symH (Wt.TopOne[J].coord m (Tr.leb-refl (suc (suc m))) k))))
     (transH (u.2.2.2 (suc m, J, u', z, ME.KJ[J].CI.consId (suc m) (C.res J I u' x) z c, (C1w m J).1) (C1w m J).2)
       (transH (apH {DA.Ez J (ME.KJ[J].K.drop m (C.res J I u' x) z c).1} {DA.Ez J z}
                  (E.act (J, z) (J, (ME.KJ[J].K.drop m (C.res J I u' x) z c).1) (idH J, (ME.KJ[J].K.drop m (C.res J I u' x) z c).2.2))
                  (ih J u' (ME.KJ[J].K.drop m (C.res J I u' x) z c).1 (ME.KJ[J].K.drop m (C.res J I u' x) z c).2.1))
         (transH (symH (E.act-o (J, z) (J, (ME.KJ[J].K.drop m (C.res J I u' x) z c).1) (I, x)
                          (u', D.tmap I x m J u' (ME.KJ[J].K.drop m (C.res J I u' x) z c).1 (ME.KJ[J].K.drop m (C.res J I u' x) z c).2.1)
                          (idH J, (ME.KJ[J].K.drop m (C.res J I u' x) z c).2.2) pt))
           (apH {VT.TH J z I x} {DA.Ez J z} (\ h -> E.act (J, z) (I, x) h pt) (symH (D.Tau[I, x, g].Top[m, J, u', z, c].law)))))) } ;
  eq : Id (DA.TOb' I x Mp.tg) Mp.res (LB.TA.tauA I x g ev) =
   DA.tob-eq I x Mp.tg Mp.res (LB.TA.tauA I x g ev) (\ q l ->
    DA.pr-inj q.2.1 q.2.2.2.1 (Mp.tg.1 q l) (Mp.mv q l) (LB.TA.tv I x g ev q l)
     (transH (Mp.mpc q l)
       (transH (apH {Wt.Pn (suc q.1) q.2.1} {DA.Ez q.2.1 q.2.2.2.1}
                  (Mp.rr q.1 q.2.1 q.2.2.1 q.2.2.2.1 (ME.KJ[q.2.1].CI.consId q.1 (C.res q.2.1 I q.2.2.1 x) q.2.2.2.1 q.2.2.2.2.1))
                  (WS.pnEq (suc q.1) q.2.1 (Mp.wq q l) (C1w q.1 q.2.1) (\ k ->
                    apH {Wt.Coords q.1 q.2.1} {Hom q.2.1 PFO.ivO} (\ cc -> Wt.consC q.1 q.2.1 (PB.ptH q.2.1 PB.e1) cc k)
                     (WS.coEq q.1 q.2.1 (Wt.meetC q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO (PB.ptH I PB.e0) q.2.2.1) q.2.2.2.2.2) (Wt.zeros q.1 q.2.1)
                        (\ mm -> transH (apH {Hom q.2.1 PFO.ivO} {Hom q.2.1 PFO.ivO} (\ jj -> Wt.meetC q.1 q.2.1 jj q.2.2.2.2.2 mm) (PB.ptH-nat q.2.1 I q.2.2.1 PB.e0))
                                  (Wt.meet-zero q.1 q.2.1 q.2.2.2.2.2 mm))))))
         (R q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1)))) ;
 } ;

 module PL {
  module LNm = LF.LN[WS.WfMeet, WS.WresMeet, WS.WfaceMeet] ;
  module TX = LNm.TX ;
  te : HO.NMap[LB.UG, LB.UB, LB.UB] = HO.compN LB.UG LB.UB LB.UA LB.UB LC.epsN LB.tauN ;
  en0 (X : G0.TOb) (z : W0.Ix ((LB.RS.P0.extP LB.UG LB.UB).ob X))
   : Id (TX.EI X) (LNm.mwe X z (PB.ptH X.1 PB.e0)) (HO.HT[LB.UG, LB.UB, LB.UB, te, LF.mN].aE X z) =
   apH {DA.TOb' X.1 X.2 (D.tau X.1 X.2 (TX.pr1 X z))} {TX.EI X} (TX.pr X (TX.pr1 X z)) (P0[X.1, X.2, TX.pr1 X z, TX.pr2 X z].eq) ;
  en1 (X : G0.TOb) (z : W0.Ix ((LB.RS.P0.extP LB.UG LB.UB).ob X))
   : Id (TX.EI X) (LNm.mwe X z (PB.ptH X.1 PB.e1)) (HO.HT[LB.UG, LB.UB, LB.UB, te, LF.mN].bE X z) =
   apH {DA.TOb' X.1 X.2 (D.tau X.1 X.2 (TX.pr1 X z))} {TX.EI X} (TX.pr X (TX.pr1 X z))
    (MWEq[WS.WfMeet, WS.WresMeet, WS.WfaceMeet, WS.WfOne, WS.WresOne, WS.WfaceOne, X.1, X.2, TX.pr1 X z, TX.pr2 X z, PB.ptH X.1 PB.e1, PB.ptH X.1 PB.e1,
      \ q l -> WS.pnEq (suc q.1) q.2.1 (WS.WfMeet q.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) q.2.2.1) (q.2.2.2.2.2, l))
                 (WS.WfOne q.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) q.2.2.1) (q.2.2.2.2.2, l)) (\ k ->
                  apH {Wt.Coords q.1 q.2.1} {Hom q.2.1 PFO.ivO} (\ cc -> Wt.consC q.1 q.2.1 (PB.ptH q.2.1 PB.e1) cc k)
                   (WS.coEq q.1 q.2.1 (Wt.meetC q.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e1) q.2.2.1) q.2.2.2.2.2) q.2.2.2.2.2
                      (\ mm -> transH (apH {Hom q.2.1 PFO.ivO} {Hom q.2.1 PFO.ivO} (\ jj -> Wt.meetC q.1 q.2.1 jj q.2.2.2.2.2 mm) (PB.ptH-nat q.2.1 X.1 q.2.2.1 PB.e1))
                                (Wt.meet-one q.1 q.2.1 q.2.2.2.2.2 mm))))].eq) ;
  pH : LB.RS.P0.PEl[LB.RS.P0.extP LB.UG LB.UB, HO.HT[LB.UG, LB.UB, LB.UB, te, LF.mN].PT.PathP] =
   LF.LP[WS.WfMeet, WS.WresMeet, WS.WfaceMeet, te, LF.mN, en0, en1].res ;
 } ;

 ------------------------------------------------------------------
 -- Lemma 14: U tau_A has a quasi-inverse at the levelwise site, given a
 -- fibration structure of D A over D G at the total site
 QInv : U l+ =
  (e : HO.NMap[LB.UG, LB.UB, LB.UA])
  * LB.RS.P0.PEl[LB.RS.P0.extP LB.UG LB.UA, HO.HT[LB.UG, LB.UA, LB.UA, HO.compN LB.UG LB.UA LB.UB LB.UA LB.tauN e, HO.idN LB.UG LB.UA].PT.PathP]
  * LB.RS.P0.PEl[LB.RS.P0.extP LB.UG LB.UB, HO.HT[LB.UG, LB.UB, LB.UB, HO.compN LB.UG LB.UB LB.UA LB.UB e LB.tauN, HO.idN LB.UG LB.UB].PT.PathP] ;

 module Out (fbD : G1.GB.CLine[l].Lines[TC.toP D.DCtx, DA.DTy].Fib) {
  fbB : G1.GB.CLine[l].Lines[GP, LB.Bt].Fib =
   G1.GB.CFibSub[l].FibSub[GP, TC.toP D.DCtx, TC.toPS G D.DCtx D.tauS, DA.DTy].sub fbD ;
  fbU : G0.GB.CLine[l].Lines[LB.UG, LB.UB].Fib = CTotUFib4[a, vl, l].UFib4[C].fibU GP LB.Bt fbB ;
  cB : G0.GB.CLine[l].Lines[LB.UG, LB.UB].CompK[PB.e0, PB.e1].Comp = fbU.1 ;
  tauEps : LB.RS.P0.PEl[LB.RS.P0.extP LB.UG LB.UB, HO.HT[LB.UG, LB.UB, LB.UB, PL.te, HO.idN LB.UG LB.UB].PT.PathP] =
   HO.Cat[LB.UG, LB.UB, LB.UB, PL.te, LF.mN, HO.idN LB.UG LB.UB, cB, PL.pH,
          HO.Inv[LB.UG, LB.UB, LB.UB, HO.idN LB.UG LB.UB, LF.mN, cB, QL.qH].res].res ;
 } ;

 lemma14 (fbD : G1.GB.CLine[l].Lines[TC.toP D.DCtx, DA.DTy].Fib) : QInv = (LC.epsN, (LC.epsTau, Out[fbD].tauEps)) ;
} ;
