-- GPosJNat.seg: GENERATED from PosJNat.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change PosJNat.seg or the generator.
-- PosJNat.seg (M1, step 3): J commutes with substitution, on the base
-- PosFull.  Not in core: CIdJ gives J and beta pointwise, CIdNat the
-- naturality of Id's composition, but nothing about J under a substitution.
--
-- The theorem is proved for any data of CJ (a context D over G with a
-- centre, a contraction and a sieve: the record JD) and any map upD of such
-- data over r commuting with the base, the contraction and the sieve
-- (JNatG); CIdJ's identity type is the instance JNat, the Yoneda Id
-- (PosIdYJ) another.
--
-- Setting.  r : G' -> G, A over G, a0 : A.  D = G.A.Id(a0 , q) (CIdJ.IJ),
-- with centre c x = (x , a0 x , refl), contraction lam and sieve psi; D' the
-- same over G' for A[r], a0[r].
--
-- Informal text.
-- (1) The map upD : D' -> D.  A point (x' , b , u , ph) goes to
--     (r x' , b , u^r , ph), where u^r is u with its values read by the lift
--     of r (as CIdCart); the sieve is unchanged.
-- (2) upD commutes with the data of J: the base (pr upD = r pr', by
--     definition), the centre (upD c' = c r), the contraction
--     (upD lam' z = lam (upD z), value by value) and the sieve
--     (psi (upD z) = psi' z, by definition).
-- (3) Theorem.  For C over D with a composition cC and d over G, and d' over
--     G' whose reading at each point agrees with that of d at the image
--     point, J'(C[upD] , cC[upD] , d') z = J(C , cC , d)(upD z).
--     Proof.  J z is the composite along lam z from d (pr z) with the side
--     psi z given by constant lines at d (CJ).  cC[upD] is the moved
--     composition (CFibSub, CCart.MoveComp), so the composite of the
--     problem at z, read through the move, is the composite of the moved
--     problem (kopMv).  The moved problem is the problem at upD z: its
--     line is upD lam' z = lam (upD z), its start is d' read at upD = d
--     (ptEq), its sieve is psi' z = psi (upD z) and its constant lines are
--     equal value by value (sideEq).  So the composites agree (kop-cong),
--     and so do their ends, which are the values of J.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;

------------------------------------------------------------------------
-- the data of CJ.JC, as a record

record JD (G D : PCtx) {
  pr : PSub[D, G] ;
  c : PSub[G, D] ;
  prc (X : Ob) (x : W0.Ix (G.ob X)) : Id (W0.Ix (G.ob X)) (pr.nt X (c.nt X x)) x ;
  lam (X : Ob) (z : W0.Ix (D.ob X)) : W0.Ix (PB.CLine[l].FC[D].ob X) ;
  lam-nat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X))
    : Id (W0.Ix (PB.CLine[l].FC[D].ob Y)) (lam Y (D.act Y X h z)) (PB.CLine[l].FC[D].actF Y X h (lam X z)) ;
  lam0 (X : Ob) (z : W0.Ix (D.ob X)) : Id (W0.Ix (D.ob X)) ((lam X z).1 X (idH X) (PB.ptH X e0)) (c.nt X (pr.nt X z)) ;
  lam1 (X : Ob) (z : W0.Ix (D.ob X)) : Id (W0.Ix (D.ob X)) ((lam X z).1 X (idH X) (PB.ptH X e1)) z ;
  psi (X : Ob) (z : W0.Ix (D.ob X)) : PB.Phi X ;
  psi-nat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (D.ob X)) : Id (PB.Phi Y) (PB.pre Y X h (psi X z)) (psi Y (D.act Y X h z)) ;
  psi-c (X : Ob) (x : W0.Ix (G.ob X)) : PB.Lands X X (psi X (c.nt X x)) (idH X) ;
  lam-c (X : Ob) (z : W0.Ix (D.ob X)) (W : Ob) (f : Hom W X) (i : PB.Lands W X (psi X z) f) (j : IvP W)
    : Id (W0.Ix (D.ob W)) ((lam X z).1 W f j) (c.nt W (pr.nt W (D.act W X f z))) ;
} ;

-- J for such data (CJ)
module JJ (G D : PCtx) (jd : JD[G, D]) (C : PTy[D]) (cC : PB.CLine[l].Lines[D, C].CompK[e0, e1].Comp)
  (d : PEl[G, subTy G D C jd.c]) {
  module J0 = PB.CJ[l].JC[G, D, jd.pr, jd.c, jd.prc, jd.lam, jd.lam-nat, jd.lam0, jd.lam1, jd.psi, jd.psi-nat, jd.psi-c, jd.lam-c, C, cC, d] ;
} ;

------------------------------------------------------------------------
-- the theorem, for any map of such data over r

module JNatG (G' G : PCtx) (r : PSub[G', G]) (D' D : PCtx) (jd' : JD[G', D']) (jd : JD[G, D]) (upD : PSub[D', D])
  (prEq : (X : Ob) (z : W0.Ix (D'.ob X)) -> Id (W0.Ix (G.ob X)) (jd.pr.nt X (upD.nt X z)) (r.nt X (jd'.pr.nt X z)))
  (lamEq : (X : Ob) (z : W0.Ix (D'.ob X))
     -> Id (W0.Ix (PB.CLine[l].FC[D].ob X)) (PB.CLine[l].FMap[D', D, upD].mapF X (jd'.lam X z)) (jd.lam X (upD.nt X z)))
  (psiEq : (X : Ob) (z : W0.Ix (D'.ob X)) -> Id (PB.Phi X) (jd'.psi X z) (jd.psi X (upD.nt X z)))
  (C : PTy[D]) (cC : PB.CLine[l].Lines[D, C].CompK[e0, e1].Comp) (d : PEl[G, subTy G D C jd.c])
  (d' : PEl[G', subTy G' D' (subTy D' D C upD) jd'.c])
  (dEq : (X : Ob) (x : W0.Ix (G'.ob X))
     -> Id (GPR.TyL[D, C].EI X) (GPR.TyL[D, C].pr X (upD.nt X (jd'.c.nt X x)) (d'.eob X x))
                                (GPR.TyL[D, C].pr X (jd.c.nt X (r.nt X x)) (d.eob X (r.nt X x)))) {
  C' : PTy[D'] = subTy D' D C upD ;

  -- the substituted composition is the move along the cart of C[upD]
  module FS = PB.CFibSub[l].FibSub[D', D, upD, C] ;
  module MC = FS.C.MoveComp[e0, e1] ;
  cC' : PB.CLine[l].Lines[D', C'].CompK[e0, e1].Comp = MC.move cC ;

  module J0 = JJ[G, D, jd, C, cC, d].J0 ;
  module J1 = JJ[G', D', jd', C', cC', d'].J0 ;
  module TC = J0.TC ;
  module EK = J0.EK ;
  module EK' = J1.EK ;

  -- d' read at upD is d read at r
  dEq' (X : Ob) (x : W0.Ix (G'.ob X)) : Id (TC.EI X) (FS.SE.mV X (J1.dE X x)) (J0.dE X (r.nt X x)) = dEq X x ;

  -- the moved start is the start at upD z
  ptEq (X : Ob) (z : W0.Ix (D'.ob X)) : Id (EK.TV.EI X) (MC.E.sV X (J1.start X z)) (J0.start X (upD.nt X z)) =
    EK.tv-eq X (MC.E.sV X (J1.start X z)) (J0.start X (upD.nt X z)) (lamEq X z)
      (calc (TC.EI X) {
          EK.endE X (MC.E.sV X (J1.start X z))
        =< MC.E.sVE X (J1.start X z) >
          FS.SE.mV X (EK'.endE X (J1.start X z))
        =< apH (FS.SE.mV X) (J1.start-E X z) >
          FS.SE.mV X (J1.dE X (jd'.pr.nt X z))
        =< dEq' X (jd'.pr.nt X z) >
          J0.dE X (r.nt X (jd'.pr.nt X z))
        =< apH (J0.dE X) (symH (prEq X z)) >
          J0.dE X (jd.pr.nt X (upD.nt X z))
        =< symH (J0.start-E X (upD.nt X z)) >
          EK.endE X (J0.start X (upD.nt X z)) }) ;

  -- the values of the constant lines at d agree
  tEq (X : Ob) (z : W0.Ix (D'.ob X)) (V : Ob) (h : Hom V X)
    : Id (TC.EI V) (FS.SE.mV V (J1.dz X z V h)) (J0.dz X (upD.nt X z) V h) =
    transH (dEq' V (jd'.pr.nt V (D'.act V X h z)))
      (apH (J0.dE V) (transH (symH (prEq V (D'.act V X h z))) (apH (jd.pr.nt V) (upD.nt-nat V X h z)))) ;

  -- the moved side is the side at upD z
  sideEq (X : Ob) (z : W0.Ix (D'.ob X))
    : Id (EK.PT.Side[X, J0.start X (upD.nt X z)])
         (subst (EK.TV.EI X) (\ w -> EK.PT.Side[X, w]) (MC.E.sV X (J1.start X z)) (J0.start X (upD.nt X z)) (ptEq X z)
            (MC.mside cC X (J1.start X z) (J1.side X z)))
         (J0.side X (upD.nt X z)) =
    EK.PT.side-extH X (MC.E.sV X (J1.start X z)) (J0.start X (upD.nt X z)) (ptEq X z)
      (MC.mside cC X (J1.start X z) (J1.side X z)) (J0.side X (upD.nt X z))
      (psiEq X z)
      (\ W f i i' ->
         EK.ts-ext W (MC.E.mS W (J1.sideV X z W f i)) (J0.sideV X (upD.nt X z) W f i')
           (calc (EK.TV.EI W) {
               EK.TS.pr1 W (MC.E.mS W (J1.sideV X z W f i))
             =< MC.E.mSpt W (J1.sideV X z W f i) >
               MC.E.sV W (EK'.TS.pr1 W (J1.sideV X z W f i))
             =< apH (MC.E.sV W) (EK'.mkTS-pt W (EK'.TV.E.act W X f (J1.start X z)) J1.Sd[X, z, W, f, i].L
                  (refl (J1.FD.actF W X f (jd'.lam X z))) J1.Sd[X, z, W, f, i].q) >
               MC.E.sV W (EK'.TV.E.act W X f (J1.start X z))
             =< MC.E.sV-nat W X f (J1.start X z) >
               EK.TV.E.act W X f (MC.E.sV X (J1.start X z))
             =< apH (EK.TV.E.act W X f) (ptEq X z) >
               EK.TV.E.act W X f (J0.start X (upD.nt X z))
             =< symH (EK.mkTS-pt W (EK.TV.E.act W X f (J0.start X (upD.nt X z))) J0.Sd[X, upD.nt X z, W, f, i'].L
                  (refl (J0.FD.actF W X f (jd.lam X (upD.nt X z)))) J0.Sd[X, upD.nt X z, W, f, i'].q) >
               EK.TS.pr1 W (J0.sideV X (upD.nt X z) W f i') })
           (\ V g j ->
              calc (TC.EI V) {
                  EK.lv W (MC.E.mS W (J1.sideV X z W f i)) V g j
                =< MC.E.mS-val W (J1.sideV X z W f i) V g j >
                  FS.SE.mV V (EK'.lv W (J1.sideV X z W f i) V g j)
                =< apH (\ M -> FS.SE.mV V (J1.FA.lval W M V g j))
                     (EK'.mkTS-line W (EK'.TV.E.act W X f (J1.start X z)) J1.Sd[X, z, W, f, i].L
                        (refl (J1.FD.actF W X f (jd'.lam X z))) J1.Sd[X, z, W, f, i].q) >
                  FS.SE.mV V (J1.dz X z V (compH V W X f g))
                =< tEq X z V (compH V W X f g) >
                  J0.dz X (upD.nt X z) V (compH V W X f g)
                =< symH (apH (\ M -> J0.FA.lval W M V g j)
                     (EK.mkTS-line W (EK.TV.E.act W X f (J0.start X (upD.nt X z))) J0.Sd[X, upD.nt X z, W, f, i'].L
                        (refl (J0.FD.actF W X f (jd.lam X (upD.nt X z)))) J0.Sd[X, upD.nt X z, W, f, i'].q)) >
                  EK.lv W (J0.sideV X (upD.nt X z) W f i') V g j })) ;

  -- the composite at z, read through the move, is the composite at upD z
  outEq (X : Ob) (z : W0.Ix (D'.ob X)) : Id (J0.TT.EI X) (MC.mT X (J1.out X z)) (J0.out X (upD.nt X z)) =
    transH (MC.kopMv cC X (J1.start X z) (J1.side X z))
      (J0.RC.kop-cong cC X (MC.E.sV X (J1.start X z)) (J0.start X (upD.nt X z)) (ptEq X z)
         (MC.mside cC X (J1.start X z) (J1.side X z)) (J0.side X (upD.nt X z)) (sideEq X z)) ;

  -- the theorem
  jnat (X : Ob) (z : W0.Ix (D'.ob X)) : Id (W0.Ix (C.tob X (upD.nt X z))) (J1.J.eob X z) (J0.J.eob X (upD.nt X z)) =
    TC.pr-inj X (upD.nt X z) (J1.J.eob X z) (J0.J.eob X (upD.nt X z))
      (calc (TC.EI X) {
          TC.pr X (upD.nt X z) (J1.jv X z)
        =< apH (FS.SE.mV X) (J1.jv-E X z) >
          FS.SE.mV X (J1.rd X (J1.out X z))
        =< symH (MC.E'.sVE X (J1.CK.SE.mV X (J1.out X z))) >
          J0.rd X (MC.mT X (J1.out X z))
        =< apH (J0.rd X) (outEq X z) >
          J0.rd X (J0.out X (upD.nt X z))
        =< symH (J0.jv-E X (upD.nt X z)) >
          TC.pr X (upD.nt X z) (J0.jv X (upD.nt X z)) }) ;
} ;

------------------------------------------------------------------------
-- the instance: Swan's identity type of core (CIdJ)

-- the data of CIdJ as a JD
ijD (G : PCtx) (A : PTy[G]) (a0 : PEl[G, A]) : JD[G, PB.CIdJ[l].IJ[G, A, a0].D] =
  new JD[G, PB.CIdJ[l].IJ[G, A, a0].D, PB.CIdJ[l].IJ[G, A, a0].pr, PB.CIdJ[l].IJ[G, A, a0].c, PB.CIdJ[l].IJ[G, A, a0].prc,
    PB.CIdJ[l].IJ[G, A, a0].lam, PB.CIdJ[l].IJ[G, A, a0].lam-nat, PB.CIdJ[l].IJ[G, A, a0].lam0, PB.CIdJ[l].IJ[G, A, a0].lam1,
    PB.CIdJ[l].IJ[G, A, a0].psi, PB.CIdJ[l].IJ[G, A, a0].psi-nat, PB.CIdJ[l].IJ[G, A, a0].psi-c, PB.CIdJ[l].IJ[G, A, a0].lam-c] ;

module JNat (G' G : PCtx) (r : PSub[G', G]) (A : PTy[G]) (a0 : PEl[G, A]) {
  A' : PTy[G'] = subTy G' G A r ;
  a' : PEl[G', A'] = subEl G' G A a0 r ;

  module IJ = PB.CIdJ[l].IJ[G, A, a0] ;
  module IJ' = PB.CIdJ[l].IJ[G', A', a'] ;
  module TA = IJ.TA ;
  module TA' = IJ'.TA ;
  module TI = IJ.TI ;
  module TI' = IJ'.TI ;

  -- the lift of r : G'.A[r] -> G.A, on points of the total spaces
  rK : PSub[IJ'.K, IJ.K] = liftP G' G A r ;
  module MF = PB.CLine[l].FMap[IJ'.K, IJ.K, rK] ;

  ----------------------------------------------------------------------
  -- (1) the map upD : D' -> D

  tauI (X : Ob) (k : W0.Ix (IJ'.K.ob X)) (w : W0.Ix (IJ'.IO.tobI X k)) : W0.Ix (IJ.IO.tobI X (rK.nt X k)) =
    ((MF.mapF X w.1.1,
      (\ W f i -> transH (apH (r.nt W) (w.1.2.1 W f i)) (r.nt-nat W X f (TA'.pr1 X k)),
       (apH (rK.nt X) w.1.2.2.1, apH (rK.nt X) w.1.2.2.2))),
     (w.2.1, \ W f i j -> transH (apH (rK.nt W) (w.2.2 W f i j)) (apH (IJ.aEJ W) (rK.nt-nat W X f k)))) ;

  upV (X : Ob) (z : W0.Ix (IJ'.D.ob X)) : W0.Ix (IJ.D.ob X) =
    TI.pr X (rK.nt X (TI'.pr1 X z)) (tauI X (TI'.pr1 X z) (TI'.pr2 X z)) ;

  upV-nat (Y X : Ob) (h : Hom Y X) (z : W0.Ix (IJ'.D.ob X))
    : Id (W0.Ix (IJ.D.ob Y)) (upV Y (IJ'.D.act Y X h z)) (IJ.D.act Y X h (upV X z)) =
    IJ.IO.tpI-ext Y (upV Y (IJ'.D.act Y X h z)) (IJ.D.act Y X h (upV X z)) (rK.nt-nat Y X h (TI'.pr1 X z))
      (\ V g j -> refl (rK.nt V ((TI'.pr2 X z).1.1.1 V (compH V Y X h g) j)))
      (refl (PB.pre Y X h (TI'.pr2 X z).2.1)) ;

  upD : PSub[IJ'.D, IJ.D] = new PSub[IJ'.D, IJ.D, upV, upV-nat] ;

  ----------------------------------------------------------------------
  -- (2) upD commutes with the data of J

  -- the base: by definition
  pr-up (X : Ob) (z : W0.Ix (IJ'.D.ob X)) : Id (W0.Ix (G.ob X)) (IJ.pr.nt X (upV X z)) (r.nt X (IJ'.pr.nt X z)) =
    refl (r.nt X (IJ'.pr.nt X z)) ;

  -- the sieve: by definition
  psi-up (X : Ob) (z : W0.Ix (IJ'.D.ob X)) : Id (PB.Phi X) (IJ.psi X (upV X z)) (IJ'.psi X z) = refl (IJ'.psi X z) ;

  -- the centre
  cen-up (X : Ob) (x : W0.Ix (G'.ob X)) : Id (W0.Ix (IJ.D.ob X)) (upV X (IJ'.c.nt X x)) (IJ.c.nt X (r.nt X x)) =
    IJ.IO.tpI-ext X (upV X (IJ'.c.nt X x)) (IJ.c.nt X (r.nt X x)) (refl (rK.nt X (IJ'.sa.nt X x)))
      (\ V g j -> apH (IJ.aEJ V) (rK.nt-nat V X g (IJ'.sa.nt X x)))
      (refl (PB.topS X)) ;

  -- the contraction, value by value
  lamV-up (X : Ob) (z : W0.Ix (IJ'.D.ob X)) (W : Ob) (f : Hom W X) (j : IvP W)
    : Id (W0.Ix (IJ.D.ob W)) (upV W (IJ'.lamV X z W f j)) (IJ.lamV X (upV X z) W f j) =
    IJ.IO.tpI-ext W (upV W (IJ'.lamV X z W f j)) (IJ.lamV X (upV X z) W f j)
      (transH (apH (rK.nt W) IJ'.LV[X, z, W, f, j].kp-E) (symH IJ.LV[X, upV X z, W, f, j].kp-E))
      (\ V g k -> refl (rK.nt V ((TI'.pr2 X z).1.1.1 V (compH V W X f g) (PB.cI true V (ivA V W g j) k))))
      (refl (IJ'.LV[X, z, W, f, j].Qs)) ;

  lam-up (X : Ob) (z : W0.Ix (IJ'.D.ob X))
    : Id (W0.Ix (IJ.FD.ob X)) (PB.CLine[l].FMap[IJ'.D, IJ.D, upD].mapF X (IJ'.lam X z)) (IJ.lam X (upV X z)) =
    IJ.FD.fam-eq X (PB.CLine[l].FMap[IJ'.D, IJ.D, upD].mapF X (IJ'.lam X z)) (IJ.lam X (upV X z)) (lamV-up X z) ;
  ----------------------------------------------------------------------
  -- (3) J commutes with upD

  module JN (C : PTy[IJ.D]) (cC : PB.CLine[l].Lines[IJ.D, C].CompK[e0, e1].Comp) (d : PEl[G, subTy G IJ.D C IJ.c])
    (d' : PEl[G', subTy G' IJ'.D (subTy IJ'.D IJ.D C upD) IJ'.c])
    (dEq : (X : Ob) (x : W0.Ix (G'.ob X))
       -> Id (GPR.TyL[IJ.D, C].EI X) (GPR.TyL[IJ.D, C].pr X (upV X (IJ'.c.nt X x)) (d'.eob X x))
                                     (GPR.TyL[IJ.D, C].pr X (IJ.c.nt X (r.nt X x)) (d.eob X (r.nt X x)))) {
    module T = JNatG[G', G, r, IJ'.D, IJ.D, ijD G' A' a', ijD G A a0, upD, pr-up, lam-up, \ X z -> symH (psi-up X z), C, cC, d, d', dEq] ;

    jnat (X : Ob) (z : W0.Ix (IJ'.D.ob X)) : Id (W0.Ix (C.tob X (upV X z))) (T.J1.J.eob X z) (T.J0.J.eob X (upV X z)) = T.jnat X z ;
  } ;
} ;
