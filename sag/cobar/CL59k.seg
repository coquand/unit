-- CL59k.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part k: the last leg of ev . inv ~ id.  The homotopy
-- tau_Q^-1 tau_Q ~ id of tau_Q's quasi-inverse (CL59h, at the total site)
-- read at the copy y.u: its value at (V, y.u) along (g, cart), moved into
-- the fibre over the unit point (QinvEq.HtpyOf's pattern).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module H1c (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module JD = CL59j[a].H1[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module IVd = JD.IVd ;
  module QC = JD.QC ;
  module DA0 = JD.DA0 ;
  module Hyp (ef : TR.G0.GB.CEquiv[a+].EquivOp JD.RM.PD.UG JD.RM.PD.UA JD.RM.PD.UB JD.RM.PD.Uf)
   (mQ : G1.GB.CEquiv[a+].EquivOp CT.P1 Q.1 IVd.B2Q IVd.C15Q.tauM) {
   module J1 = JD.Hyp[ef, mQ] ;
   module EQt = J1.HH.EQt ;
   module HO1 = J1.HO1 ;
   module HO0 = J1.HO0 ;
   module TY = J1.TY ;
   K0 (W : Ob) : CT.TC.TOb = (W, LA.yu) ;
   R1 : HO1.NMap[CT.P1, Q.1, Q.1] = HO1.compN CT.P1 Q.1 IVd.B2Q Q.1 EQt.PNa.nm EQt.EI.gN ;
   module T1h = HO1.HT[CT.P1, Q.1, Q.1, R1, HO1.idN CT.P1 Q.1] ;
   module TQ1 = G1.GB.GPre[a+].TyL[CT.P1, Q.1] ;
   zt (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) : V1.Ix (T1h.GA.ob (K0 W)) = (tt, psi) ;
   pvt (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) (Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv) : TQ1.EI (Vv, LA.yu) =
    T1h.pv EQt.EI.eta (K0 W) (zt W psi) (Vv, LA.yu) (QC.qm Vv W g) j ;
   pteq (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) (Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv)
    : Id (V1.Ix (CT.P1.ob (Vv, LA.yu))) (TQ1.pr1 (Vv, LA.yu) (pvt W psi Vv g j)) tt =
    (EQt.EI.eta.eob (K0 W) (zt W psi)).2.1 (Vv, LA.yu) (QC.qm Vv W g) j ;
   Lf (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) (Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv) : V1.Ix (Q.1.tob (Vv, LA.yu) tt) =
    TQ1.coeT (Vv, LA.yu) (TQ1.pr1 (Vv, LA.yu) (pvt W psi Vv g j)) tt (pteq W psi Vv g j) (TQ1.pr2 (Vv, LA.yu) (pvt W psi Vv g j)) ;
   Lf-rd (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) (Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv)
    : Id (TQ1.EI (Vv, LA.yu)) (TQ1.pr (Vv, LA.yu) tt (Lf W psi Vv g j)) (pvt W psi Vv g j) =
    symH (TQ1.pr-coe (Vv, LA.yu) (TQ1.pr1 (Vv, LA.yu) (pvt W psi Vv g j)) tt (pteq W psi Vv g j) (TQ1.pr2 (Vv, LA.yu) (pvt W psi Vv g j))) ;
   tv2 (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (psi : V1.Ix (DA0.qTob W tt)) (Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv) : TY.EI Vv = TY.pr Vv o (Lf W psi Vv g j) ;
   tn2 (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (psi : V1.Ix (DA0.qTob W tt)) (Vb Va : Ob) (g2 : Hom Vb Va) (g : Hom Va W) (j : Hom Va Iv)
    : Id (TY.EI Vb) (TY.E.act Vb Va g2 (tv2 W o psi Va g j)) (tv2 W o psi Vb (compH Vb Va W g g2) (compH Vb Va Iv j g2)) =
    transH (TY.pr-tact Vb Va g2 o o (refl o) (Lf W psi Va g j))
     (apH {V1.Ix (Q.1.tob (Vb, LA.yu) tt)} {TY.EI Vb} (TY.pr Vb o)
       (TQ1.pr-inj (Vb, LA.yu) tt (Q.1.tact (Vb, LA.yu) (Va, LA.yu) (QC.qm Vb Va g2) tt tt (refl tt) (Lf W psi Va g j)) (Lf W psi Vb (compH Vb Va W g g2) (compH Vb Va Iv j g2))
         (transH (symH (TQ1.pr-tact (Vb, LA.yu) (Va, LA.yu) (QC.qm Vb Va g2) tt tt (refl tt) (Lf W psi Va g j)))
           (transH (apH {TQ1.EI (Va, LA.yu)} {TQ1.EI (Vb, LA.yu)} (TQ1.E.act (Vb, LA.yu) (Va, LA.yu) (QC.qm Vb Va g2)) (Lf-rd W psi Va g j))
             (transH ((EQt.EI.eta.eob (K0 W) (zt W psi)).1.2 (Vb, LA.yu) (Va, LA.yu) (QC.qm Vb Va g2) (QC.qm Va W g) j)
               (transH (apH {CT.TC.THm (Vb, LA.yu) (K0 W)} {TQ1.EI (Vb, LA.yu)} (\ k -> T1h.pv EQt.EI.eta (K0 W) (zt W psi) (Vb, LA.yu) k (compH Vb Va Iv j g2)) (QC.cmpEq Vb Va W g g2))
                 (symH (Lf-rd W psi Vb (compH Vb Va W g g2) (compH Vb Va Iv j g2))))))))) ;
   R1c : HO0.NMap[LA.Nl, DA0.QC, DA0.QC] =
    new HO0.NMap[LA.Nl, DA0.QC, DA0.QC, \ W o psi -> R1.nfun (K0 W) tt psi, \ J I h x x' e psi -> R1.nnat (K0 J) (K0 I) (QC.qm J I h) tt tt (refl tt) psi] ;
   module HC2 = HO0.HT[LA.Nl, DA0.QC, DA0.QC, R1c, HO0.idN LA.Nl DA0.QC] ;
   end0 (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (psi : V1.Ix (DA0.qTob W tt)) : Id (TY.EI W) (tv2 W o psi W (idH W) (PB.ptH W PB.e0)) (HC2.aE W (o, psi)) =
    apH {V1.Ix (Q.1.tob (K0 W) tt)} {TY.EI W} (TY.pr W o)
     (TQ1.pr-inj (K0 W) tt (Lf W psi W (idH W) (PB.ptH W PB.e0)) (R1.nfun (K0 W) tt psi)
       (transH (Lf-rd W psi W (idH W) (PB.ptH W PB.e0)) (EQt.EI.eta.eob (K0 W) (zt W psi)).2.2.1)) ;
   end1 (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (psi : V1.Ix (DA0.qTob W tt)) : Id (TY.EI W) (tv2 W o psi W (idH W) (PB.ptH W PB.e1)) (HC2.bE W (o, psi)) =
    apH {V1.Ix (Q.1.tob (K0 W) tt)} {TY.EI W} (TY.pr W o)
     (TQ1.pr-inj (K0 W) tt (Lf W psi W (idH W) (PB.ptH W PB.e1)) psi
       (transH (Lf-rd W psi W (idH W) (PB.ptH W PB.e1)) (EQt.EI.eta.eob (K0 W) (zt W psi)).2.2.2)) ;
   path2 (W : Ob) (zz : V1.Ix (HC2.GA.ob W)) : V1.Ix (HC2.PT.tobP W zz) =
    HC2.PT.mkPath W zz (\ Vv g j -> tv2 W (TY.pr1 W zz) (TY.pr2 W zz) Vv g j)
     (\ Vb Va g2 g j -> tn2 W (TY.pr1 W zz) (TY.pr2 W zz) Vb Va g2 g j)
     (\ Vv g j -> refl (TY.pr1 W zz)) (end0 W (TY.pr1 W zz) (TY.pr2 W zz)) (end1 W (TY.pr1 W zz) (TY.pr2 W zz)) ;
   -- naturality in the point
   rdN (J I : Ob) (h : Hom J I) (psi : V1.Ix (DA0.qTob I tt)) (Vv : Ob) (f : Hom Vv J) (i : Hom Vv Iv)
    : Id (V1.Ix (Q.1.tob (Vv, LA.yu) tt)) (Lf I psi Vv (compH Vv J I h f) i) (Lf J (QC.qact J I h psi) Vv f i) =
    TQ1.pr-inj (Vv, LA.yu) tt (Lf I psi Vv (compH Vv J I h f) i) (Lf J (QC.qact J I h psi) Vv f i)
     (transH (Lf-rd I psi Vv (compH Vv J I h f) i)
       (transH (apH {CT.TC.THm (Vv, LA.yu) (K0 I)} {TQ1.EI (Vv, LA.yu)} (\ k -> T1h.pv EQt.EI.eta (K0 I) (zt I psi) (Vv, LA.yu) k i) (symH (QC.cmpEq Vv J I h f)))
         (transH (T1h.pv-res EQt.EI.eta (K0 J) (K0 I) (QC.qm J I h) (zt I psi) (zt J (QC.qact J I h psi)) (refl (zt J (QC.qact J I h psi))) (Vv, LA.yu) (QC.qm Vv J f) i)
           (symH (Lf-rd J (QC.qact J I h psi) Vv f i))))) ;
   enat2 (J I : Ob) (h : Hom J I) (zz : V1.Ix (HC2.GA.ob I)) (zz' : V1.Ix (HC2.GA.ob J)) (e : Id (V1.Ix (HC2.GA.ob J)) (HC2.GA.act J I h zz) zz')
    : Id (V1.Ix (HC2.PT.tobP J zz')) (HC2.PT.PathP.tact J I h zz zz' e (path2 I zz)) (path2 J zz') =
    HC2.PT.path-eq J zz' (HC2.PT.PathP.tact J I h zz zz' e (path2 I zz)) (path2 J zz') (\ Vv f i ->
     transH (apH {V1.Ix (Q.1.tob (Vv, LA.yu) tt)} {TY.EI Vv} (TY.pr Vv (TY.pr1 I zz)) (rdN J I h (TY.pr2 I zz) Vv f i))
      (apH {V1.Ix (HC2.GA.ob J)} {TY.EI Vv} (\ z2 -> tv2 J (TY.pr1 J z2) (TY.pr2 J z2) Vv f i) e)) ;
   -- tau_Q^-1 tau_Q ~ id at the copy y.u
   h1c : L.PEl[HC2.GA, HC2.PT.PathP] = new L.PEl[HC2.GA, HC2.PT.PathP, path2, enat2] ;
   -- Psi' is tau_Q^-1 tau_Q, pointwise: D commutes with tau (CTotTauDM)
   module PE (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) {
    q : V1.Ix (Q.1.tob (K0 W) tt) = QC.qact W W (idH W) psi ;
    wq : JD.CV.DQc.Ob' W LA.yu = JD.CV.DQc.tau W LA.yu q ;
    n0d : JD.CV.DYu.Ob' W LA.yu = JD.CV.DYu.tau W LA.yu (J1.n0 W) ;
    module TA1 = CTotL14a[a, a+, a+].TauA[CM.IC, QC.Qc, QC.A1] ;
    module TB1 = CTotL14a[a, a+, a+].TauA[CM.IC, QC.Qc, QC.B1] ;
    module TQ = IVd.C15Q.LB.TA ;
    module TDM = CTotTauDM[a, a+, a+].TauDM[CM.IC, QC.Qc, QC.A1, QC.B1, QC.evM] ;
    module TD = TDM.At[W, LA.yu, q, J1.n0 W] ;
    c1 : Id (QC.DF.DA.TOb' W LA.yu wq) (JD.CV.C1[W, LA.yu, wq, n0d].res) (TA1.tauA W LA.yu q (J1.n0 W)) =
     QC.DF.DA.tob-eq W LA.yu wq (JD.CV.C1[W, LA.yu, wq, n0d].res) (TA1.tauA W LA.yu q (J1.n0 W)) (\ q' l -> refl (n0d.1 q' l)) ;
    bvEq : Id (V1.Ix (Q.1.tob (K0 W) tt)) TD.bv psi =
     transH (TDM.DB.pr-inj W LA.yu q TD.bv (QC.evq (K0 W) q (J1.n0 W)) (symH TD.fvE))
      (transH (Q.1.tact-id (K0 W) tt (refl tt) q) (Q.1.tact-id (K0 W) tt (refl tt) psi)) ;
    c3 : Id (V1.Ix (IVd.B2Q.tob (K0 W) tt)) (JD.CV.C2[W, LA.yu, wq, TB1.tauA W LA.yu q TD.bv].res) (TQ.tauA W LA.yu tt TD.bv) =
     JD.CV.DQ.tob-eq W LA.yu (JD.CV.DT1.tau W LA.yu tt) (JD.CV.C2[W, LA.yu, wq, TB1.tauA W LA.yu q TD.bv].res) (TQ.tauA W LA.yu tt TD.bv) (\ q' l ->
      G1.GB.GPre[a+].PS.tact-irr G1.fibCwF-T.nil Q.1 (q'.2.1, q'.2.2.2.1) (W, LA.yu) (q'.2.2.1, JD.CV.DYu.tmap W LA.yu q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1)
       tt tt
       (G1.GB.GPre[a+].PS.ntEq QC.PQc G1.fibCwF-T.nil (G1.fibCwF-T.eps QC.PQc) (q'.2.1, q'.2.2.2.1) (W, LA.yu)
          (q'.2.2.1, JD.CV.DYu.tmap W LA.yu q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) q ((JD.CV.DQc.tau W LA.yu q).1 q' l) (refl ((JD.CV.DQc.tau W LA.yu q).1 q' l)))
       (refl ((JD.CV.DT1.tau W LA.yu tt).1 q' l)) TD.bv) ;
    module TQB = G1.GB.GPre[a+].TyL[CT.P1, IVd.B2Q] ;
    c5 : Id (V1.Ix (IVd.B2Q.tob (K0 W) tt)) (TQ.tauA W LA.yu tt psi) (EQt.PNa.nf (K0 W) tt psi) =
     TQB.pr-inj (K0 W) tt (TQ.tauA W LA.yu tt psi) (EQt.PNa.nf (K0 W) tt psi) (symH (EQt.PNa.q (K0 W) tt psi)) ;
    chain : Id (V1.Ix (IVd.B2Q.tob (K0 W) tt)) (JD.CV.C2[W, LA.yu, wq, QC.DF.DM[W, LA.yu, wq, JD.CV.C1[W, LA.yu, wq, n0d].res].res].res) (EQt.PNa.nf (K0 W) tt psi) =
     transH (apH {QC.DF.DA.TOb' W LA.yu wq} {V1.Ix (IVd.B2Q.tob (K0 W) tt)} (\ a0 -> JD.CV.C2[W, LA.yu, wq, QC.DF.DM[W, LA.yu, wq, a0].res].res) c1)
      (transH (apH {QC.DF.DB.TOb' W LA.yu wq} {V1.Ix (IVd.B2Q.tob (K0 W) tt)} (\ b0 -> JD.CV.C2[W, LA.yu, wq, b0].res) TD.law)
        (transH c3 (transH (apH {V1.Ix (Q.1.tob (K0 W) tt)} {V1.Ix (IVd.B2Q.tob (K0 W) tt)} (TQ.tauA W LA.yu tt) bvEq) c5))) ;
    law : Id (V1.Ix (Q.1.tob (K0 W) tt)) (J1.PsiV W psi) (R1.nfun (K0 W) tt psi) =
     apH {V1.Ix (IVd.B2Q.tob (K0 W) tt)} {V1.Ix (Q.1.tob (K0 W) tt)} (EQt.EI.gN.nfun (K0 W) tt) chain ;
   } ;
   module RT = HO0.Ret[LA.Nl, DA0.QC, DA0.QC, R1c, HO0.idN LA.Nl DA0.QC, J1.PsiNM, HO0.idN LA.Nl DA0.QC,
     \ I x a0 -> PE[I, a0].law, \ I x a0 -> refl a0, h1c] ;
   -- H1 : ev . inv ~ id at the copy
   module FQ = CL59f[a].FF[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
   module CA = HO0.Cat[LA.Nl, DA0.QC, DA0.QC, J1.compo, J1.PsiNM, HO0.idN LA.Nl DA0.QC, FQ.fibQC.1, J1.h1a, RT.res] ;
   h1 : L.PEl[CA.GA, CA.T.PT.PathP] = CA.res ;
  } ;
 } ;
} ;
