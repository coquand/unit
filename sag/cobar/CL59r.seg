-- CL59r.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), assembled: the closed types of the copies are fibrant (CL59f),
-- ev and inv are natural maps, and the two homotopies (CL59k.h1, CL59q.h2)
-- are path homotopies; read in the CwF of fibrant types at the copy they are
-- elements of the internal Htpy (Pi x Id(f x, x), HtpyEq.HtpyOf2).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module L59 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module TR = LA.TR ;
 module FCw = FibCwF[a, a+] ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module DA0 = LA.Data[A, rho, rho1, Q] ;
  module FQ = CL59f[a].FF[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  -- the two closed types, fibrant
  QCs : FCw.FC.STy LA.Nl = (DA0.QC, FQ.fibQC) ;
  PiCs : FCw.FC.STy LA.Nl = (DA0.PiC, FQ.fibPiC) ;
  module K1 = CL59k[a].H1c[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module Q2 = CL59q[a].RB[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module Hyp (ef : TR.G0.GB.CEquiv[a+].EquivOp K1.JD.RM.PD.UG K1.JD.RM.PD.UA K1.JD.RM.PD.UB K1.JD.RM.PD.Uf)
   (mQ : G1.GB.CEquiv[a+].EquivOp CT.P1 Q.1 K1.IVd.B2Q K1.IVd.C15Q.tauM) {
   module H1m = K1.Hyp[ef, mQ] ;
   module H2m = Q2.Hyp[ef, mQ] ;
   module J1 = H1m.J1 ;
   module HO0 = J1.HO0 ;
   -- the quasi-inverse data
   ev : HO0.NMap[LA.Nl, DA0.PiC, DA0.QC] = J1.evNM ;
   inv : HO0.NMap[LA.Nl, DA0.QC, DA0.PiC] = J1.invNM ;
   h1 : L.PEl[L.extP LA.Nl DA0.QC, HO0.HT[LA.Nl, DA0.QC, DA0.QC, HO0.compN LA.Nl DA0.QC DA0.PiC DA0.QC inv ev, HO0.idN LA.Nl DA0.QC].PT.PathP] = H1m.h1 ;
   h2 : L.PEl[L.extP LA.Nl DA0.PiC, HO0.HT[LA.Nl, DA0.PiC, DA0.PiC, HO0.compN LA.Nl DA0.PiC DA0.QC DA0.PiC ev inv, HO0.idN LA.Nl DA0.PiC].PT.PathP] = H2m.h2 ;
   -- internally
   module I1 = HtpyEq[a, a+].HtpyOf2[LA.Nl, QCs, QCs, HO0.compN LA.Nl DA0.QC DA0.PiC DA0.QC inv ev, HO0.idN LA.Nl DA0.QC, h1] ;
   module I2 = HtpyEq[a, a+].HtpyOf2[LA.Nl, PiCs, PiCs, HO0.compN LA.Nl DA0.PiC DA0.QC DA0.PiC ev inv, HO0.idN LA.Nl DA0.PiC, h2] ;
   h1I : FCw.fibCwF.El LA.Nl (FCw.fibPi.Pi LA.Nl QCs (FibId[a, a+].fibId.IdT I1.K I1.BA I1.tf I1.tg)) = I1.htpy ;
   h2I : FCw.fibCwF.El LA.Nl (FCw.fibPi.Pi LA.Nl PiCs (FibId[a, a+].fibId.IdT I2.K I2.BA I2.tf I2.tg)) = I2.htpy ;
  } ;
 } ;
} ;
