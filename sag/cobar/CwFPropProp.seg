-- CwFPropProp.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit): being a
-- proposition is a proposition, in a CwF with Pi, Sigma, Swan Id, a
-- universe (for CwFPropU's names only) and naive function extensionality.
--
-- Informal text.  Let T = isProp A over G, and work over G.T, with f the
-- variable.  A (weakened) is a proposition by f, so over G.T.A it is
-- contractible (centre the variable, contraction f), and its Id types are
-- contractible (CwFCC.IC).  By weak function extensionality twice (CwFWfe)
-- T (weakened) is contractible over G.T; so over G.T.T the two variables
-- are joined (CwFCC.eqC): that is an element of isProp T.  The last step
-- is general (propOver): contractible over itself implies proposition.
open Base ;

module PropProp (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;
  module WF = CwFWfe.Wfe[l, C, PS, SS, IJ, NF] ;
  module CK = CwFCC.CC[l, C, PS, SS, IJ, NF] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module JPm = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module INm = CwFInt.Int[l, C, PS, SS, IJ] ;

  -- a type that is contractible over itself (as soon as it has a point)
  -- is a proposition: the two variables of G.X.X are joined
  module PO (G : Ctx) (X : Ty G) (k : El (ext G X) (EQ.isContr (ext G X) (wkT G X X))) {
    Gx : Ctx = ext G X ;
    X1 : Ty Gx = wkT G X X ;
    E : Ctx = ext Gx X1 ;
    kE : El E (EQ.isContr E (wkT Gx X1 X1)) =
      trE E (wkT Gx X1 (EQ.isContr Gx X1)) (EQ.isContr E (wkT Gx X1 X1))
        (EQ.isContr-ov E Gx X1 (p Gx X1) (wkT Gx X1 X1) (refl (wkT Gx X1 X1))) (wkE Gx X1 (EQ.isContr Gx X1) k) ;
    bd : El E (EQ.Id2 G X) = CK.eqC E (wkT Gx X1 X1) kE (wkE Gx X1 X1 (q G X)) (q Gx X1) ;
    propOver : El G (PU.isProp G X) = lam G X (PS.Pi Gx X1 (EQ.Id2 G X)) (lam Gx X1 (EQ.Id2 G X) bd) ;
  } ;
  propOver (G : Ctx) (X : Ty G) (k : El (ext G X) (EQ.isContr (ext G X) (wkT G X X))) : El G (PU.isProp G X) = PO[G, X, k].propOver ;

  -- a proposition with an element is contractible
  contrOfProp (G : Ctx) (X : Ty G) (pX : El G (PU.isProp G X)) (c : El G X) : El G (EQ.isContr G X) =
    SG.mkContr G X c
      (bod G X (JPm.IK G X c)
         (trE G (subT G (ext G X) (SG.CP G X) (sec G X c)) (PS.Pi G X (JPm.IK G X c)) (SG.PCP G X c)
            (INm.appD G X (SG.CP G X) pX c))) ;

  -- a product of propositions is a proposition
  module PiP (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (pB : El (ext G A) (PU.isProp (ext G A) B)) {
    T : Ty G = PS.Pi G A B ;
    Gf : Ctx = ext G T ;
    A1 : Ty Gf = wkT G T A ;
    up : Sub (ext Gf A1) (ext G A) = lift Gf G A (p G T) ;
    B1 : Ty (ext Gf A1) = subT (ext Gf A1) (ext G A) B up ;
    PT1 : Id (Ty Gf) (wkT G T T) (PS.Pi Gf A1 B1) = Pi-ov Gf G A B (p G T) A1 (refl A1) B1 (refl B1) ;
    f1 : El Gf (PS.Pi Gf A1 B1) = trE Gf (wkT G T T) (PS.Pi Gf A1 B1) PT1 (q G T) ;
    pB1 : El (ext Gf A1) (PU.isProp (ext Gf A1) B1) =
      trE (ext Gf A1) (subT (ext Gf A1) (ext G A) (PU.isProp (ext G A) B) up) (PU.isProp (ext Gf A1) B1)
        (PU.isProp-ov (ext Gf A1) (ext G A) B up B1 (refl B1)) (subt (ext Gf A1) (ext G A) (PU.isProp (ext G A) B) pB up) ;
    kB : El (ext Gf A1) (EQ.isContr (ext Gf A1) B1) = contrOfProp (ext Gf A1) B1 pB1 (bod Gf A1 B1 f1) ;
    k0 : El Gf (EQ.isContr Gf (PS.Pi Gf A1 B1)) = WF.wfe Gf A1 B1 kB ;
    kT : El Gf (EQ.isContr Gf (wkT G T T)) =
      trE Gf (EQ.isContr Gf (PS.Pi Gf A1 B1)) (EQ.isContr Gf (wkT G T T))
        (ap (Ty Gf) (Ty Gf) (\ X -> EQ.isContr Gf X) (PS.Pi Gf A1 B1) (wkT G T T) (sym (Ty Gf) (wkT G T T) (PS.Pi Gf A1 B1) PT1)) k0 ;
    piProp : El G (PU.isProp G T) = propOver G T kT ;
  } ;
  piProp (G : Ctx) (A : Ty G) (B : Ty (ext G A)) (pB : El (ext G A) (PU.isProp (ext G A) B)) : El G (PU.isProp G (PS.Pi G A B)) =
    PiP[G, A, B, pB].piProp ;

  module PP (G : Ctx) (A : Ty G) {
    T : Ty G = PU.isProp G A ;
    Gf : Ctx = ext G T ;
    A1 : Ty Gf = wkT G T A ;
    T1 : Ty Gf = wkT G T T ;
    PT1 : Id (Ty Gf) T1 (PU.isProp Gf A1) = PU.isProp-ov Gf G A (p G T) A1 (refl A1) ;
    f1 : El Gf (PU.isProp Gf A1) = trE Gf T1 (PU.isProp Gf A1) PT1 (q G T) ;
    K1 : Ctx = ext Gf A1 ;
    A2 : Ty K1 = wkT Gf A1 A1 ;
    -- over G.T.A the type A is contractible
    ctr : El (ext K1 A2) (EQ.Id2 Gf A1) =
      (PS.Pi-iso K1 A2 (EQ.Id2 Gf A1)).fun ((PS.Pi-iso Gf A1 (PS.Pi K1 A2 (EQ.Id2 Gf A1))).fun f1) ;
    kA : El K1 (EQ.isContr K1 A2) = SG.mkContr K1 A2 (q Gf A1) ctr ;
    -- so isProp A is contractible over G.T
    k2 : El (ext K1 A2) (EQ.isContr (ext K1 A2) (EQ.Id2 Gf A1)) = CK.IC[K1, A2, kA, q Gf A1].idC ;
    k1 : El K1 (EQ.isContr K1 (PS.Pi K1 A2 (EQ.Id2 Gf A1))) = WF.wfe K1 A2 (EQ.Id2 Gf A1) k2 ;
    k0 : El Gf (EQ.isContr Gf (PU.isProp Gf A1)) = WF.wfe Gf A1 (PS.Pi K1 A2 (EQ.Id2 Gf A1)) k1 ;
    kT : El Gf (EQ.isContr Gf T1) =
      trE Gf (EQ.isContr Gf (PU.isProp Gf A1)) (EQ.isContr Gf T1)
        (ap (Ty Gf) (Ty Gf) (\ X -> EQ.isContr Gf X) (PU.isProp Gf A1) T1 (sym (Ty Gf) T1 (PU.isProp Gf A1) PT1)) k0 ;
    propProp : El G (PU.isProp G T) = propOver G T kT ;
  } ;
  propProp (G : Ctx) (A : Ty G) : El G (PU.isProp G (PU.isProp G A)) = PP[G, A].propProp ;
} ;
