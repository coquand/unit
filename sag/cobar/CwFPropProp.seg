-- CwFPropProp.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit): being a
-- proposition is a proposition, in a CwF with Pi, Sigma, Swan Id, a
-- universe (for CwFPropU's names only) and naive function extensionality.
--
-- Informal text.  Let T = isProp A over G, and work over G.T, with f the
-- variable.  A (weakened) is a proposition by f, so over G.T.A it is
-- contractible (centre the variable, contraction f), and its Id types are
-- contractible (CwFCC.IC).  By weak function extensionality twice (CwFWfe)
-- T (weakened) is contractible over G.T; so over G.T.T the two variables
-- are joined (CwFCC.eqC): that is an element of isProp T.
open Base ;

module PropProp (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;
  module WF = CwFWfe.Wfe[l, C, PS, SS, IJ, NF] ;
  module CK = CwFCC.CC[l, C, PS, SS, IJ, NF] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;

  module PP (G : Ctx) (A : Ty G) {
    T : Ty G = PU.isProp G A ;
    Gf : Ctx = ext G T ;
    A1 : Ty Gf = wkT G T A ;
    T1 : Ty Gf = wkT G T T ;
    PT1 : Id (Ty Gf) T1 (PU.isProp Gf A1) = PU.isProp-ov Gf G A (p G T) A1 (refl A1) ;
    f1 : El Gf (PU.isProp Gf A1) = trE Gf T1 (PU.isProp Gf A1) PT1 (q G T) ;
    K1 : Ctx = ext Gf A1 ;
    A2 : Ty K1 = wkT Gf A1 A1 ;
    -- over G.T.A the type A is contractible
    ctr : El (ext K1 A2) (EQ.Id2 Gf A1) =
      (PS.Pi-iso K1 A2 (EQ.Id2 Gf A1)).fun ((PS.Pi-iso Gf A1 (PS.Pi K1 A2 (EQ.Id2 Gf A1))).fun f1) ;
    kA : El K1 (EQ.isContr K1 A2) = SG.mkContr K1 A2 (q Gf A1) ctr ;
    -- so isProp A is contractible over G.T
    k2 : El (ext K1 A2) (EQ.isContr (ext K1 A2) (EQ.Id2 Gf A1)) = CK.IC[K1, A2, kA, q Gf A1].idC ;
    k1 : El K1 (EQ.isContr K1 (PS.Pi K1 A2 (EQ.Id2 Gf A1))) = WF.wfe K1 A2 (EQ.Id2 Gf A1) k2 ;
    k0 : El Gf (EQ.isContr Gf (PU.isProp Gf A1)) = WF.wfe Gf A1 (PS.Pi K1 A2 (EQ.Id2 Gf A1)) k1 ;
    kT : El Gf (EQ.isContr Gf T1) =
      trE Gf (EQ.isContr Gf (PU.isProp Gf A1)) (EQ.isContr Gf T1)
        (ap (Ty Gf) (Ty Gf) (\ X -> EQ.isContr Gf X) (PU.isProp Gf A1) T1 (sym (Ty Gf) T1 (PU.isProp Gf A1) PT1)) k0 ;
    -- the two variables of G.T.T are joined
    E : Ctx = ext Gf T1 ;
    kE : El E (EQ.isContr E (wkT Gf T1 T1)) =
      trE E (wkT Gf T1 (EQ.isContr Gf T1)) (EQ.isContr E (wkT Gf T1 T1))
        (EQ.isContr-ov E Gf T1 (p Gf T1) (wkT Gf T1 T1) (refl (wkT Gf T1 T1))) (wkE Gf T1 (EQ.isContr Gf T1) kT) ;
    bd : El E (EQ.Id2 G T) = CK.eqC E (wkT Gf T1 T1) kE (wkE Gf T1 T1 (q G T)) (q Gf T1) ;
    propProp : El G (PU.isProp G T) = lam G T (PS.Pi Gf T1 (EQ.Id2 G T)) (lam Gf T1 (EQ.Id2 G T) bd) ;
  } ;
  propProp (G : Ctx) (A : Ty G) : El G (PU.isProp G (PU.isProp G A)) = PP[G, A].propProp ;
} ;
