-- CwFQuotElim2.seg (canonicity-c2; SIMPLIFIED.md item 3): QE1 part 2,
-- the quotient's eliminator into a set B (internal set-ness sB), from a
-- family f of elements of B at terms respecting the relation (rs):
--   elim1 : Qt -> B,  elim1-beta : elim1 (cls t) = f t
-- By unique choice: the family CF(q) = Sigma (b : B) Pi (a : Tm)
-- (Dec (fst q a) -> Id(f a , b)) over nil.Qt (CwFElimG3.Fam) is a
-- proposition and inhabited at the classes (elimP1 twice); elim1 is its
-- first projection, and beta is its second at t with reflexivity.
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module MP = CwFMaps.Maps[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module X1 = CwFSetX1.SetX1[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module EG2 = CwFElimG2.ElimG2[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module EG3 = CwFElimG3.ElimG3[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EG5 = CwFElimG5.ElimG5[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module EG4 = CwFElimG4.ElimG4[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module QE2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
 module AX = Q1.AX ;
 module QQ = AX.QQ ;
 Nl : C.Ctx = C.nil ;
 Qt : C.Ty Nl = AX.Qt ;
 Tm : C.Ty Nl = AX.RP.Tm ;
 G1 : C.Ctx = C.ext Nl Qt ;
 Tm1 : C.Ty G1 = OV.wkT Nl Qt Tm ;
 module FF = MP.FstF[Nl, QQ.PA, QQ.TrS] ;
 PFq : Id (C.Ty G1) (OV.wkT Nl Qt QQ.PA) (X1.FunU G1 Tm1) = X1.PF G1 Nl (C.p Nl Qt) Tm Tm1 (refl Tm1) ;
 Pq : C.El G1 (X1.FunU G1 Tm1) = OV.trE G1 (OV.wkT Nl Qt QQ.PA) (X1.FunU G1 Tm1) PFq FF.m ;
 -- the predicate of q at a global element c is fst c
 Pc (c : C.El Nl Qt) : C.El Nl QQ.PA = IN.fst Nl QQ.PA QQ.TrS c ;
 PFs (c : C.El Nl Qt) : Id (C.Ty Nl) (C.subT Nl G1 (X1.FunU G1 Tm1) (C.sec Nl Qt c)) QQ.PA =
  X1.PF Nl G1 (C.sec Nl Qt c) Tm1 Tm (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Qt Tm c) ;
 oPc (c : C.El Nl Qt) : OV.Ov Nl G1 (X1.FunU G1 Tm1) (C.sec Nl Qt c) QQ.PA (PFs c) Pq (Pc c) =
  OV.ovTr Nl G1 (OV.wkT Nl Qt QQ.PA) (X1.FunU G1 Tm1) PFq (C.sec Nl Qt c) QQ.PA QQ.PA (refl QQ.PA) FF.At[c].PX (PFs c) FF.m (Pc c)
   (IN.fst-ov Nl G1 FF.Xd FF.Yd (C.sec Nl Qt c) QQ.PA FF.At[c].PX QQ.TrS (FF.At[c].US.fam QQ.TrS) FF.At[c].PW FF.qS c FF.At[c].Pw) ;

 module E1 (B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy) (f : AX.Term -> C.El Nl B)
   (rs : (t t' : AX.Term) -> C.El Nl (AX.RelC t t') -> C.El Nl (IJ.IdT Nl B (f t) (f t'))) {
  fI : C.El Nl (OV.Fun Nl Tm B) = AX.RP.LM.lamC Nl B f ;
  module FM = EG3.Fam[Nl, Qt, B, Tm, fI, Pq] ;
  CF : C.Ty G1 = FM.RZ.K.CF ;
  module RN (c : C.El Nl Qt) { module M = EG3.RNs[Nl, Qt, c, B, Tm, fI, Pq, Pc c, oPc c] ; } ;
  -- B's set-ness read at two elements over any context (CwFSetX3.At, on
  -- G3Of[B]'s own terms, so that no type of another instance is converted)
  module GB = CQCtx[a].G3Of[B] ;
  spB : C.El GB.G2 GB.SP = GB.setV2 sB ;
  module SB {
   module JP = CwFJ.JPt[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
   HB0 : C.Ctx = Nl ;
   XB : C.Ty HB0 = B ;
   HB1 : C.Ctx = GB.G1 ;
   XwB : C.Ty HB1 = GB.Qw ;
   HB2 : C.Ctx = GB.G2 ;
   XB2 : C.Ty HB2 = GB.Qw2 ;
   v1 : C.El HB2 XB2 = GB.v1 ;
   v2 : C.El HB2 XB2 = GB.v2 ;
   T : C.Ty HB2 = IJ.IdT HB2 XB2 v1 v2 ;
   SPT : C.Ty HB2 = GB.SP ;
   sp : C.El HB2 SPT = spB ;
    module At (D : C.Ctx) (sd : C.Sub D HB0) (Y : C.Ty D) (PY : Id (C.Ty D) (C.subT D HB0 XB sd) Y) (xa xb : C.El D Y) {
     xa' : C.El D (C.subT D HB0 XB sd) = OV.trE D Y (C.subT D HB0 XB sd) (sym (C.Ty D) (C.subT D HB0 XB sd) Y PY) xa ;
     s1 : C.Sub D HB1 = C.o D (C.ext D (C.subT D HB0 XB sd)) (C.ext HB0 XB) (C.lift D HB0 XB sd) (C.sec D (C.subT D HB0 XB sd) xa') ;
     PW1 : Id (C.Ty D) (C.subT D HB1 XwB s1) (C.subT D HB0 XB sd) = IN.wkT-extS D HB0 XB XB sd xa' ;
     PXw : Id (C.Ty D) (C.subT D HB1 XwB s1) Y = trans (C.Ty D) (C.subT D HB1 XwB s1) (C.subT D HB0 XB sd) Y PW1 PY ;
     xb' : C.El D (C.subT D HB1 XwB s1) = OV.trE D Y (C.subT D HB1 XwB s1) (sym (C.Ty D) (C.subT D HB1 XwB s1) Y PXw) xb ;
     sg : C.Sub D HB2 = C.o D (C.ext D (C.subT D HB1 XwB s1)) (C.ext HB1 XwB) (C.lift D HB1 XwB s1) (C.sec D (C.subT D HB1 XwB s1) xb') ;
     PW2 : Id (C.Ty D) (C.subT D HB2 XB2 sg) (C.subT D HB1 XwB s1) = IN.wkT-extS D HB1 XwB XwB s1 xb' ;
     PX2' : Id (C.Ty D) (C.subT D HB2 XB2 sg) Y = trans (C.Ty D) (C.subT D HB2 XB2 sg) (C.subT D HB1 XwB s1) Y PW2 PXw ;
     qa : Id (C.El D (C.subT D HB0 XB sd)) (OV.trE D (C.subT D HB1 XwB s1) (C.subT D HB0 XB sd) PW1 (C.subt D HB1 XwB (C.q HB0 XB) s1)) xa' = JP.q-extS D HB0 XB sd xa' PW1 ;
     o1 : OV.Ov D HB2 XB2 sg Y PX2' v1 (OV.trE D (C.subT D HB1 XwB s1) Y PXw (C.subt D HB1 XwB (C.q HB0 XB) s1)) =
       OV.ovTr D HB2 XB2 XB2 (refl XB2) sg (C.subT D HB1 XwB s1) Y PXw PW2 PX2' v1 (C.subt D HB1 XwB (C.q HB0 XB) s1)
         (IN.wkE-extS D HB1 XwB XwB (C.q HB0 XB) s1 xb' PW2) ;
     ea : Id (C.El D Y) (OV.trE D (C.subT D HB1 XwB s1) Y PXw (C.subt D HB1 XwB (C.q HB0 XB) s1)) xa =
       calc (C.El D Y) {
           OV.trE D (C.subT D HB1 XwB s1) Y PXw (C.subt D HB1 XwB (C.q HB0 XB) s1)
         =< sym (C.El D Y) (OV.trE D (C.subT D HB0 XB sd) Y PY (OV.trE D (C.subT D HB1 XwB s1) (C.subT D HB0 XB sd) PW1 (C.subt D HB1 XwB (C.q HB0 XB) s1)))
              (OV.trE D (C.subT D HB1 XwB s1) Y PXw (C.subt D HB1 XwB (C.q HB0 XB) s1))
              (OV.trE-tr D (C.subT D HB1 XwB s1) (C.subT D HB0 XB sd) Y PW1 PY (C.subt D HB1 XwB (C.q HB0 XB) s1)) >
           OV.trE D (C.subT D HB0 XB sd) Y PY (OV.trE D (C.subT D HB1 XwB s1) (C.subT D HB0 XB sd) PW1 (C.subt D HB1 XwB (C.q HB0 XB) s1))
         =< ap (C.El D (C.subT D HB0 XB sd)) (C.El D Y) (\ v -> OV.trE D (C.subT D HB0 XB sd) Y PY v)
              (OV.trE D (C.subT D HB1 XwB s1) (C.subT D HB0 XB sd) PW1 (C.subt D HB1 XwB (C.q HB0 XB) s1)) xa' qa >
           OV.trE D (C.subT D HB0 XB sd) Y PY xa'
         =< JP.trE-sym D (C.subT D HB0 XB sd) Y PY xa >
           xa } ;
     ov1 : OV.Ov D HB2 XB2 sg Y PX2' v1 xa =
       trans (C.El D Y) (OV.trE D (C.subT D HB2 XB2 sg) Y PX2' (C.subt D HB2 XB2 v1 sg)) (OV.trE D (C.subT D HB1 XwB s1) Y PXw (C.subt D HB1 XwB (C.q HB0 XB) s1)) xa o1 ea ;
     o2 : OV.Ov D HB2 XB2 sg Y PX2' v2 (OV.trE D (C.subT D HB1 XwB s1) Y PXw xb') =
       OV.ovTr D HB2 XB2 XB2 (refl XB2) sg (C.subT D HB1 XwB s1) Y PXw PW2 PX2' v2 xb' (JP.q-extS D HB1 XwB s1 xb' PW2) ;
     ov2 : OV.Ov D HB2 XB2 sg Y PX2' v2 xb =
       trans (C.El D Y) (OV.trE D (C.subT D HB2 XB2 sg) Y PX2' (C.subt D HB2 XB2 v2 sg)) (OV.trE D (C.subT D HB1 XwB s1) Y PXw xb') xb o2
         (JP.trE-sym D (C.subT D HB1 XwB s1) Y PXw xb) ;
     PSP : Id (C.Ty D) (C.subT D HB2 SPT sg) (PU.isProp D (IJ.IdT D Y xa xb)) =
       PU.isProp-ov D HB2 T sg (IJ.IdT D Y xa xb) (OV.Id-ov D HB2 XB2 v1 v2 sg Y PX2' xa xb ov1 ov2) ;
     law : C.El D (PU.isProp D (IJ.IdT D Y xa xb)) = OV.trE D (C.subT D HB2 SPT sg) (PU.isProp D (IJ.IdT D Y xa xb)) PSP (C.subt D HB2 SPT sp sg) ;
   } ;
  } ;

  idBack (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X)
    (u : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y))) : C.El G (IJ.IdT G X x y) =
    idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y)) -> C.El G (IJ.IdT G X x y)) (\ v -> v) X' P u ;
  -- at the class of t, the family is a proposition
  module PC (t : AX.Term) {
   c : C.El Nl Qt = AX.cls t ;
   module RNc = RN[c].M ;
   module Rz = RNc.Rz ;
   CF0 : C.Ty Nl = Rz.K.CF ;
   a0 : C.El Nl Tm = AX.RP.ct t ;
   -- reflexivity, read in the predicate at a0
   sa : C.Sub Nl (C.ext Nl Tm) = C.sec Nl Tm a0 ;
   module RR = X1.RelOf[Nl, Tm, Pc c, Pc c] ;
   oA : OV.Ov Nl (C.ext Nl Tm) RR.WU sa (PU.PropU Nl) (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm (PU.PropU Nl) a0)
          (OV.bod Nl Tm RR.WU (Pc c)) (OV.app Nl Tm (PU.PropU Nl) (Pc c) a0) = refl (OV.app Nl Tm (PU.PropU Nl) (Pc c) a0) ;
   oM : OV.Ov Nl (C.ext Nl Tm) (PU.PropU (C.ext Nl Tm)) sa (PU.PropU Nl) (PU.PropU-ov Nl (C.ext Nl Tm) sa) RR.mP (OV.app Nl Tm (PU.PropU Nl) (Pc c) a0) =
    OV.ovTr Nl (C.ext Nl Tm) RR.WU (PU.PropU (C.ext Nl Tm)) RR.PWU sa (PU.PropU Nl) (PU.PropU Nl) (refl (PU.PropU Nl))
      (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm (PU.PropU Nl) a0) (PU.PropU-ov Nl (C.ext Nl Tm) sa)
      (OV.bod Nl Tm RR.WU (Pc c)) (OV.app Nl Tm (PU.PropU Nl) (Pc c) a0) oA ;
   eP : Id (C.El Nl (PU.PropU Nl)) (OV.app Nl Tm (PU.PropU Nl) (Pc c) a0) (AX.RP.relP a0 a0) =
    apH {C.El Nl QQ.PA} {C.El Nl (PU.PropU Nl)} (\ P -> OV.app Nl Tm (PU.PropU Nl) P a0) (QQ.fst-cls a0) ;
   oM2 : OV.Ov Nl (C.ext Nl Tm) (PU.PropU (C.ext Nl Tm)) sa (PU.PropU Nl) (PU.PropU-ov Nl (C.ext Nl Tm) sa) RR.mP (AX.RP.relP a0 a0) =
    transH oM eP ;
   PR0 : Id (C.Ty Nl) (C.subT Nl (C.ext Nl Tm) Rz.TP0 sa) (AX.RP.RelT a0 a0) = EG3.G1.decN Nl (C.ext Nl Tm) sa RR.mP (AX.RP.relP a0 a0) oM2 ;
   rho0 : C.El Nl (C.subT Nl (C.ext Nl Tm) Rz.TP0 sa) =
    OV.trE Nl (AX.RP.RelT a0 a0) (C.subT Nl (C.ext Nl Tm) Rz.TP0 sa) (symH PR0) (AX.RP.reflR0 t) ;
   -- Id in B is a proposition at every context over nil (B's set-ness)
   idP (E : C.Ctx) (sE : C.Sub E Nl) (u v : C.El E (C.subT E Nl B sE)) : C.El E (PU.isProp E (IJ.IdT E (C.subT E Nl B sE) u v)) =
    SB.At[E, sE, C.subT E Nl B sE, refl (C.subT E Nl B sE), u, v].law ;
   propC : C.El Nl (PU.isProp Nl CF0) = EG5.PropCF[Nl, B, Tm, Pc c, fI, a0, rho0, idP].res ;
  } ;
  -- the family over nil.Qt is a proposition
  hP (t : AX.Term) : C.El Nl (C.subT Nl G1 (PU.isProp G1 CF) (Q1.GQ.Sec1[AX.cls t].sec1)) =
   OV.trE Nl (C.subT Nl G1 (PU.isProp G1 CF) (C.sec Nl Qt (AX.cls t))) (C.subT Nl G1 (PU.isProp G1 CF) (Q1.GQ.Sec1[AX.cls t].sec1))
     (apH {C.Sub Nl G1} {C.Ty Nl} (\ s -> C.subT Nl G1 (PU.isProp G1 CF) s) (Q1.sS1 t))
     (OV.trE Nl (PU.isProp Nl PC[t].CF0) (C.subT Nl G1 (PU.isProp G1 CF) (C.sec Nl Qt (AX.cls t)))
        (symH (PU.isProp-ov Nl G1 CF (C.sec Nl Qt (AX.cls t)) PC[t].CF0 PC[t].RNc.law)) PC[t].propC) ;
  pCF : C.El G1 (PU.isProp G1 CF) = Q1.elimP1 (PU.isProp G1 CF) (PPp.propProp G1 CF) hP ;
  -- at the class of t: (f t , the respect proofs)
  module EL (t : AX.Term) {
   module P = PC[t] ;
   module AB = P.Rz.AtB[f t] ;
   module IU (u0 : AX.Term) {
    su : C.Sub Nl (C.ext Nl Tm) = C.sec Nl Tm (AX.RP.ct u0) ;
    X : C.Ty Nl = C.subT Nl (C.ext Nl Tm) P.Rz.TP0 su ;
    Dc : C.Ty Nl = AX.RP.Dc t u0 ;
    oA : OV.Ov Nl (C.ext Nl Tm) P.RR.WU su (PU.PropU Nl) (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm (PU.PropU Nl) (AX.RP.ct u0))
           (OV.bod Nl Tm P.RR.WU (Pc P.c)) (OV.app Nl Tm (PU.PropU Nl) (Pc P.c) (AX.RP.ct u0)) = refl (OV.app Nl Tm (PU.PropU Nl) (Pc P.c) (AX.RP.ct u0)) ;
    oM : OV.Ov Nl (C.ext Nl Tm) (PU.PropU (C.ext Nl Tm)) su (PU.PropU Nl) (PU.PropU-ov Nl (C.ext Nl Tm) su) P.RR.mP (AX.RP.relP P.a0 (AX.RP.ct u0)) =
     transH (OV.ovTr Nl (C.ext Nl Tm) P.RR.WU (PU.PropU (C.ext Nl Tm)) P.RR.PWU su (PU.PropU Nl) (PU.PropU Nl) (refl (PU.PropU Nl))
        (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm (PU.PropU Nl) (AX.RP.ct u0)) (PU.PropU-ov Nl (C.ext Nl Tm) su)
        (OV.bod Nl Tm P.RR.WU (Pc P.c)) (OV.app Nl Tm (PU.PropU Nl) (Pc P.c) (AX.RP.ct u0)) oA)
       (apH {C.El Nl QQ.PA} {C.El Nl (PU.PropU Nl)} (\ Pr -> OV.app Nl Tm (PU.PropU Nl) Pr (AX.RP.ct u0)) (QQ.fst-cls P.a0)) ;
    PX : Id (C.Ty Nl) X Dc = transH (EG3.G1.decN Nl (C.ext Nl Tm) su P.RR.mP (AX.RP.relP P.a0 (AX.RP.ct u0)) oM) (AX.RP.relT-ct t u0) ;
    Pt : C.Ty Nl = IJ.IdT Nl B (f u0) (f t) ;
    pP : C.El Nl (PU.isProp Nl Pt) = SB.At[Nl, C.id Nl, B, C.subT-id Nl B, f u0, f t].law ;
    fam (w : AX.Dx.Proof t u0) : C.El Nl Pt =
     PT.symM Nl B (f t) (f u0) (rs t u0 (OV.trE Nl Dc (AX.RelC t u0) (symH (AX.RP.relT-ct t u0)) (AX.CE.UnitP[t, u0, w].dec))) ;
    module PA = CRelResp[a].PackAp[R, encK, x, t, u0, Pt, pP, fam] ;
    el0 : C.El (C.ext Nl Dc) (OV.wkT Nl Dc Pt) = PA.O.elim ;
    Y : C.Ty Nl = C.subT Nl (C.ext Nl Tm) AB.Y0 su ;
    PY : Id (C.Ty Nl) Y Pt =
     transH (OV.Id-ov Nl (C.ext Nl Tm) P.Rz.WB P.Rz.bodf (OV.wkE Nl Tm B (f t)) su B (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm B (AX.RP.ct u0))
               (OV.app Nl Tm B fI (AX.RP.ct u0)) (f t) (refl (OV.app Nl Tm B fI (AX.RP.ct u0)))
               (IN.wkE-sec Nl Tm B (AX.RP.ct u0) (f t) (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm B (AX.RP.ct u0))))
       (apH {C.El Nl B} {C.Ty Nl} (\ v -> IJ.IdT Nl B v (f t)) (AX.RP.LM.lamC-beta Nl B f u0)) ;
    el1 : C.El (C.ext Nl X) (OV.wkT Nl X Y) =
     OV.trE (C.ext Nl X) (OV.wkT Nl X Pt) (OV.wkT Nl X Y) (apH {C.Ty Nl} {C.Ty (C.ext Nl X)} (\ Z -> OV.wkT Nl X Z) (symH PY))
       (idJ (C.Ty Nl) Dc (\ X3 P3 -> C.El (C.ext Nl X3) (OV.wkT Nl X3 Pt)) el0 X (symH PX)) ;
    PL : Id (C.Ty (C.ext Nl X)) (C.subT (C.ext Nl X) (C.ext (C.ext Nl Tm) P.Rz.TP0) (OV.wkT (C.ext Nl Tm) P.Rz.TP0 AB.Y0) (C.lift Nl (C.ext Nl Tm) P.Rz.TP0 su))
           (OV.wkT Nl X Y) = OV.wkT-ov Nl (C.ext Nl Tm) P.Rz.TP0 AB.Y0 su X (refl X) Y (refl Y) ;
    elem : C.El (C.ext Nl X) (C.subT (C.ext Nl X) (C.ext (C.ext Nl Tm) P.Rz.TP0) (OV.wkT (C.ext Nl Tm) P.Rz.TP0 AB.Y0) (C.lift Nl (C.ext Nl Tm) P.Rz.TP0 su)) =
     OV.trE (C.ext Nl X) (OV.wkT Nl X Y) (C.subT (C.ext Nl X) (C.ext (C.ext Nl Tm) P.Rz.TP0) (OV.wkT (C.ext Nl Tm) P.Rz.TP0 AB.Y0) (C.lift Nl (C.ext Nl Tm) P.Rz.TP0 su))
       (symH PL) el1 ;
   } ;
   g2 : C.El (C.ext (C.ext Nl Tm) P.Rz.TP0) (OV.wkT (C.ext Nl Tm) P.Rz.TP0 AB.Y0) =
    AX.RP.LM.L.packX Nl P.Rz.TP0.1 (OV.wkT (C.ext Nl Tm) P.Rz.TP0 AB.Y0).1 (\ u0 -> IU[u0].elem) ;
   g : C.El Nl AB.H0 = OV.lam Nl Tm AB.F0 (OV.lam (C.ext Nl Tm) P.Rz.TP0 (OV.wkT (C.ext Nl Tm) P.Rz.TP0 AB.Y0) g2) ;
   w : C.El Nl P.CF0 = AB.mk g ;
   hE : C.El Nl (C.subT Nl G1 CF (Q1.GQ.Sec1[AX.cls t].sec1)) =
    OV.trE Nl (C.subT Nl G1 CF (C.sec Nl Qt (AX.cls t))) (C.subT Nl G1 CF (Q1.GQ.Sec1[AX.cls t].sec1))
      (apH {C.Sub Nl G1} {C.Ty Nl} (\ s -> C.subT Nl G1 CF s) (Q1.sS1 t))
      (OV.trE Nl P.CF0 (C.subT Nl G1 CF (C.sec Nl Qt (AX.cls t))) (symH P.RNc.law) w) ;
  } ;
  eCF : C.El G1 CF = Q1.elimP1 CF pCF (\ t -> EL[t].hE) ;
  -- the eliminator: the first projection
  e1 : C.El G1 FM.Bw = IN.fst G1 FM.Bw FM.RZ.K.H eCF ;
  elim1 : C.El Nl (OV.Fun Nl Qt B) = OV.lam Nl Qt (OV.wkT Nl Qt B) e1 ;
  -- beta: the second projection at t, with reflexivity
  module BT (t : AX.Term) {
   module P = PC[t] ;
   c : C.El Nl Qt = AX.cls t ;
   s : C.Sub Nl G1 = C.sec Nl Qt c ;
   w : C.El Nl P.CF0 = OV.trE Nl (C.subT Nl G1 CF s) P.CF0 P.RNc.law (C.subt Nl G1 CF eCF s) ;
   oF : OV.Ov Nl G1 FM.Bw s B P.RNc.PB e1 (IN.fst Nl B P.Rz.K.H w) =
    IN.fst-ov Nl G1 FM.Bw FM.RZ.K.H s B P.RNc.PB P.Rz.K.H P.RNc.Ho P.RNc.law eCF w (refl w) ;
   eA : Id (C.El Nl B) (OV.app Nl Qt B elim1 c) (IN.fst Nl B P.Rz.K.H w) =
    transH (IN.app-lam Nl Qt B e1 c)
      (transH (OV.trE-irr Nl (C.subT Nl G1 FM.Bw s) B (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Qt B c) P.RNc.PB (C.subt Nl G1 FM.Bw e1 s)) oF) ;
   module AB = P.Rz.AtB[IN.fst Nl B P.Rz.K.H w] ;
   gw : C.El Nl AB.H0 = OV.trE Nl (C.subT Nl P.Rz.DB P.Rz.K.H AB.sb) AB.H0 AB.Ho (IN.snd Nl B P.Rz.K.H w) ;
   r : C.El Nl (IJ.IdT Nl B (OV.app Nl Tm B fI P.a0) (IN.fst Nl B P.Rz.K.H w)) = AB.App[gw, P.a0, P.rho0].res ;
   r2 : C.El Nl (IJ.IdT Nl B (IN.fst Nl B P.Rz.K.H w) (f t)) =
    subst (C.El Nl B) (\ v -> C.El Nl (IJ.IdT Nl B (IN.fst Nl B P.Rz.K.H w) v)) (OV.app Nl Tm B fI P.a0) (f t) (AX.RP.LM.lamC-beta Nl B f t)
      (PT.symM Nl B (OV.app Nl Tm B fI P.a0) (IN.fst Nl B P.Rz.K.H w) r) ;
   beta : C.El Nl (IJ.IdT Nl B (OV.app Nl Qt B elim1 c) (f t)) =
    subst (C.El Nl B) (\ v -> C.El Nl (IJ.IdT Nl B v (f t))) (IN.fst Nl B P.Rz.K.H w) (OV.app Nl Qt B elim1 c) (symH eA) r2 ;
  } ;
 } ;

 -- in the agreed shapes (CFreeMaps.ElimTy)
 elim1 : CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Ty = \ B sB f rs -> E1[B, sB, f, rs].elim1 ;
 elim1-beta : CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Beta elim1 = \ B sB f rs t -> E1[B, sB, f, rs].BT[t].beta ;
} ;
