-- Lemma14.seg (canonicity-45; COBAR.md "Lemma 14"): U tau_A is an
-- equivalence at x, as a quasi-inverse in CHtpyOps terms over G_x.
--   B          D A pulled back along tau (subTy along tauX)
--   tauA       a |-> the family A.tE (tot c) of a restricted along g
--   epsA       u |-> u at (0 , x , id , X , id , (1))
--   m , q , p  u at (n+1 , consId c , ..) with the weights consOne i ,
--              ConsP (j g) i , consOne (meetC (j g) i)
--   tau eps ~ id = Cat p (Inv q), with the composition of B from lemma12F
-- Part 1: tauA as a D A element over tau gamma, and as an NMap.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module HO = PB.CHtpyOps[l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module L14 (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A : CPshC[a, l].CPsh[C].CTy[G]) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module D = DD.DC[G] ;
 module DA = DD.DT[G, A] ;
 CO : U a = P.CO ;

 ------------------------------------------------------------------
 -- tau on A

 module TA' (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (av : W0.Ix ((A.ty x).tob X gm)) {
  tauP : D.Ob' x X = D.Tau[x, X, gm].res ;
  ae (J : Ob) (g : Hom J X) : SigT (G.ob x) (A.ty x) J = (extP (G.ob x) (A.ty x)).act J X g (pairE (G.ob x) (A.ty x) X gm av) ;
  ve (q : DD.Idx x X) : SigT (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 =
   (A.tE q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1)).nt q.2.2.2.1 (ae q.2.2.2.1 q.2.2.2.2.1) ;
  t : DA.TA x X tauP = \ q l ->
   GPR.TyL[G.ob q.2.1, A.ty q.2.1].coeT q.2.2.2.1 (fstE (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 (ve q)) (tauP.1 q l)
    (A.tE-pt q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1) q.2.2.2.1 (ae q.2.2.2.1 q.2.2.2.2.1))
    (sndE (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 (ve q)) ;
  pc (q : DD.Idx x X) (l : DD.LandsI x X q) : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (tauP.1 q l) (t q l)) (ve q) =
   symH (GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-coe q.2.2.2.1 (fstE (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 (ve q)) (tauP.1 q l)
          (A.tE-pt q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1) q.2.2.2.1 (ae q.2.2.2.1 q.2.2.2.2.1))
          (sndE (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 (ve q))) ;
  anat' : W0.Ix (DA.anatEq x X tauP t) = \ r l ->
   transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pc r.1 l))
    (transH (symH ((A.tE r.1.2.1 x (K.tot r.1.1 x r.1.2.1 r.1.2.2.1)).nt-nat r.2.1 r.1.2.2.2.1 r.2.2 (ae r.1.2.2.2.1 r.1.2.2.2.2.1)))
      (transH (apH ((A.tE r.1.2.1 x (K.tot r.1.1 x r.1.2.1 r.1.2.2.1)).nt r.2.1)
                 (symH ((extP (G.ob x) (A.ty x)).act-o r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2 (pairE (G.ob x) (A.ty x) X gm av))))
        (symH (pc (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2,
                   (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                  (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)))) ;
  aface' : W0.Ix (DA.afaceEq x X tauP t) = \ r l ->
   transH (pc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF x X r l).1) (DA.afaceF x X r l).2)
    (transH (apH (\ k' -> (A.tE r.2.2.2.1 x k').nt r.2.2.2.2.2.1 (ae r.2.2.2.2.2.1 r.2.2.2.2.2.2.1))
               (symH (K.tot-comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1)))
      (symH (pc (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l))) ;
  atop' : W0.Ix (DA.atopEq x X tauP t) = \ r l ->
   transH (pc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF x X r l).1) (DA.atopF x X r l).2)
    (transH (apH (\ k' -> (A.tE r.2.1 x k').nt r.2.2.2.1 (ae r.2.2.2.1 r.2.2.2.2.1)) (K.tot-drop r.1 x r.2.1 r.2.2.1))
      (transH (A.tE-o r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 x (K.tot r.1 x (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.1)
                 (K.drop r.1 x r.2.1 r.2.2.1).2.2 r.2.2.2.1 (ae r.2.2.2.1 r.2.2.2.2.1))
        (apH ((A.tE r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.2).nt r.2.2.2.1)
           (symH (pc (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))))) ;
  res : DA.TOb' x X tauP = (t, anat', aface', atop') ;
 } ;

 -- B : D A pulled back along tau, over G_x
 B (x : CO) : PTy[G.ob x] = subTy (G.ob x) (D.obD x) (DA.DTy x) (D.tauX x) ;

 tauN (x : CO) : HO.NMap[G.ob x, A.ty x, B x] =
  new HO.NMap[G.ob x, A.ty x, B x, \ I gm av -> TA'[x, I, gm, av].res,
   \ J I f gm gm' e av ->
    DA.tob-eq x J (TA'[x, J, gm', (A.ty x).tact J I f gm gm' e av].tauP) _ _ (\ q l ->
     GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (TA'[x, J, gm', (A.ty x).tact J I f gm gm' e av].tauP.1 q l) _ _
      (transH (DA.TB[x, J, I, f, TA'[x, I, gm, av].tauP, TA'[x, J, gm', (A.ty x).tact J I f gm gm' e av].tauP,
                     ntEq (G.ob x) (D.obD x) (D.tauX x) J I f gm gm' e, TA'[x, I, gm, av].res].pc q l)
        (transH (TA'[x, I, gm, av].pc (D.BA[x, J, I, f, TA'[x, I, gm, av].tauP].sh q) l)
          (transH (apH ((A.tE q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1)).nt q.2.2.2.1)
                     (transH ((extP (G.ob x) (A.ty x)).act-o q.2.2.2.1 J I f q.2.2.2.2.1 (pairE (G.ob x) (A.ty x) I gm av))
                        (apH ((extP (G.ob x) (A.ty x)).act q.2.2.2.1 J q.2.2.2.2.1) (GPR.TyL[G.ob x, A.ty x].pr-tact J I f gm gm' e av))))
            (symH (TA'[x, J, gm', (A.ty x).tact J I f gm gm' e av].pc q l))))))] ;

 ------------------------------------------------------------------
 -- eps: read at the identity chain with the weight (1)

 one0 (W : Ob) : Wt.Pn zero W =
  (\ k -> PB.ptH W PB.e1,
   PB.bigU-in W W (suc zero) (\ k -> PB.pre W PB.Iv (PB.ptH W PB.e1) (PB.ptS PB.e1)) (PB.idH W) (zero, refl true)
    (PB.pre-lands W W PB.Iv (PB.ptH W PB.e1) (PB.ptS PB.e1) (PB.idH W)
      (PB.lands-eq W PB.Iv (PB.ptS PB.e1) (PB.ptH W PB.e1) (PB.compH W W PB.Iv (PB.ptH W PB.e1) (PB.idH W))
         (symH (PB.comp-idr W PB.Iv (PB.ptH W PB.e1))) (PB.pt-lands W PB.e1)))) ;
 -- restricting (1) gives (1)
 one0-res (W' W : Ob) (f : Hom W' W) : Id (Wt.Pn zero W') (Wt.Res[zero, W', W, f, one0 W].res) (one0 W') =
  Sigma-eq (Wt.Coords zero W') (\ cs -> PB.Lands W' W' (Wt.oneS zero W' cs) (PB.idH W'))
   (Wt.Res[zero, W', W, f, one0 W].res).1 (one0 W').1 (Wt.Res[zero, W', W, f, one0 W].res).2 (one0 W').2
   (funext (Ar.Fin (suc zero)) (\ k -> Hom W' PB.Iv) (Wt.Res[zero, W', W, f, one0 W].res).1 (one0 W').1 (\ k -> PB.ptH-nat W' W f PB.e1))
   (PB.isProp-Lands W' W' (Wt.oneS zero W' (one0 W').1) (PB.idH W')) ;

 module EP (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) {
  q0 : DD.Idx x I = (zero, x, P.cid x, I, PB.idH I, (one0 I).1) ;
  l0 : DD.LandsI x I q0 = (one0 I).2 ;
  -- tau gm at q0 is gm
  pth : Id (W0.Ix ((G.ob x).ob I)) (((D.tauX x).nt I gm).1 q0 l0) gm =
   transH (G.act-id x I ((G.ob x).act I I (PB.idH I) gm)) ((G.ob x).act-id I gm) ;
  ev (u : W0.Ix ((B x).tob I gm)) : W0.Ix ((A.ty x).tob I gm) =
   GPR.TyL[G.ob x, A.ty x].coeT I (((D.tauX x).nt I gm).1 q0 l0) gm pth (u.1 q0 l0) ;
  epc (u : W0.Ix ((B x).tob I gm))
   : Id (W0.Ix (DA.Ez x I)) (DA.prz x I gm (ev u)) (DA.prz x I (((D.tauX x).nt I gm).1 q0 l0) (u.1 q0 l0)) =
   symH (GPR.TyL[G.ob x, A.ty x].pr-coe I (((D.tauX x).nt I gm).1 q0 l0) gm pth (u.1 q0 l0)) ;
 } ;

 epsN (x : CO) : HO.NMap[G.ob x, B x, A.ty x] =
  new HO.NMap[G.ob x, B x, A.ty x, \ I gm u -> EP[x, I, gm].ev u,
   \ J I f gm gm' e u ->
    GPR.TyL[G.ob x, A.ty x].pr-inj J gm' _ _
     (transH (symH (GPR.TyL[G.ob x, A.ty x].pr-tact J I f gm gm' e (EP[x, I, gm].ev u)))
       (transH (apH ((extP (G.ob x) (A.ty x)).act J I f) (EP[x, I, gm].epc u))
         (transH (u.2.1 (EP[x, I, gm].q0, (J, f)) EP[x, I, gm].l0)
           (transH (apH (\ k -> DA.prz x J (((D.tauX x).nt I gm).1 (zero, x, P.cid x, J, k, (Wt.Res[zero, J, I, f, one0 I].res).1) (Wt.Res[zero, J, I, f, one0 I].res).2)
                                     (u.1 (zero, x, P.cid x, J, k, (Wt.Res[zero, J, I, f, one0 I].res).1) (Wt.Res[zero, J, I, f, one0 I].res).2))
                      (transH (PB.comp-idl J I f) (symH (PB.comp-idr J I f))))
             (transH (apH (\ p -> DA.prz x J (((D.tauX x).nt I gm).1 (zero, x, P.cid x, J, PB.compH J J I f (PB.idH J), p.1) p.2)
                                     (u.1 (zero, x, P.cid x, J, PB.compH J J I f (PB.idH J), p.1) p.2))
                        (one0-res J I f))
               (transH (symH (DA.TB[x, J, I, f, (D.tauX x).nt I gm, (D.tauX x).nt J gm', ntEq (G.ob x) (D.obD x) (D.tauX x) J I f gm gm' e, u].pc
                                EP[x, J, gm'].q0 EP[x, J, gm'].l0))
                 (symH (EP[x, J, gm'].epc ((B x).tact J I f gm gm' e u)))))))))] ;

 -- eps tau = id pointwise, hence a homotopy
 et-pt (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (av : W0.Ix ((A.ty x).tob I gm))
  : Id (W0.Ix ((A.ty x).tob I gm)) ((HO.compN (G.ob x) (A.ty x) (B x) (A.ty x) (tauN x) (epsN x)).nfun I gm av) av =
  GPR.TyL[G.ob x, A.ty x].pr-inj I gm _ _
   (transH (EP[x, I, gm].epc (TA'[x, I, gm, av].res))
     (transH (TA'[x, I, gm, av].pc EP[x, I, gm].q0 EP[x, I, gm].l0)
       (transH (A.tE-id x I (TA'[x, I, gm, av].ae I (PB.idH I)))
         ((extP (G.ob x) (A.ty x)).act-id I (pairE (G.ob x) (A.ty x) I gm av))))) ;
 epsTau (x : CO) : PEl[extP (G.ob x) (A.ty x),
   HO.HT[G.ob x, A.ty x, A.ty x, HO.compN (G.ob x) (A.ty x) (B x) (A.ty x) (tauN x) (epsN x), HO.idN (G.ob x) (A.ty x)].PT.PathP] =
  HO.Ret[G.ob x, A.ty x, A.ty x, HO.idN (G.ob x) (A.ty x), HO.idN (G.ob x) (A.ty x),
         HO.compN (G.ob x) (A.ty x) (B x) (A.ty x) (tauN x) (epsN x), HO.idN (G.ob x) (A.ty x),
         et-pt x, \ I gm av -> refl av, HO.Rf[G.ob x, A.ty x, A.ty x, HO.idN (G.ob x) (A.ty x)].res].res ;

 ------------------------------------------------------------------
 -- m: read u at (n+1 , consId c , consOne i)

 module CI = ConsId[a].ConsOf[C] ;
 module U12 = Lemma12[a, l].L12[C, G, A] ;

 -- restriction of consOne i is consOne of the restriction
 consOne-res (n : Nat) (J'' J' : Ob) (h : Hom J'' J') (i : Wt.Pn n J')
  : Id (Wt.Pn (suc n) J'') (Wt.Res[suc n, J'', J', h, Wt.consOne n J' i.1].res) (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1) =
  Sigma-eq (Wt.Coords (suc n) J'') (\ cs -> PB.Lands J'' J'' (Wt.oneS (suc n) J'' cs) (PB.idH J''))
   (Wt.Res[suc n, J'', J', h, Wt.consOne n J' i.1].res).1 (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1).1
   (Wt.Res[suc n, J'', J', h, Wt.consOne n J' i.1].res).2 (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1).2
   (funext (Ar.Fin (suc (suc n))) (\ k -> Hom J'' PB.Iv)
      (Wt.Res[suc n, J'', J', h, Wt.consOne n J' i.1].res).1 (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1).1
      (\ k -> transH (Wt.cons-res n J'' J' h (PB.ptH J' PB.e1) i.1 k)
                (apH (\ jj -> Wt.consC n J'' jj (Wt.resC n J'' J' h i.1) k) (PB.ptH-nat J'' J' h PB.e1))))
   (PB.isProp-Lands J'' J'' (Wt.oneS (suc n) J'' (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1).1) (PB.idH J'')) ;

 -- consOne of a face is the face (k+1) of consOne
 consOne-face (n : Nat) (J : Ob) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (suc n)) J) (Wt.consOne (suc n) J (Wt.Face[n, J, k, hk].Of[i].face).1) (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face) =
  Sigma-eq (Wt.Coords (suc (suc n)) J) (\ cs -> PB.Lands J J (Wt.oneS (suc (suc n)) J cs) (PB.idH J))
   (Wt.consOne (suc n) J (Wt.Face[n, J, k, hk].Of[i].face).1).1 (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face).1
   (Wt.consOne (suc n) J (Wt.Face[n, J, k, hk].Of[i].face).1).2 (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face).2
   (funext (Ar.Fin (suc (suc (suc n)))) (\ m -> Hom J PB.Iv)
      (Wt.consOne (suc n) J (Wt.Face[n, J, k, hk].Of[i].face).1).1 (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face).1
      (\ m -> symH (Wt.FaceCons[n, J, k, hk, PB.ptH J PB.e1, i.1].coord m)))
   (PB.isProp-Lands J J (Wt.oneS (suc (suc n)) J (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face).1) (PB.idH J)) ;

 module MW (Wf : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PB.Iv t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((B x).tob I gm)) (t : Hom I PB.Iv) {
  wq (q : DD.Idx x I) (l : DD.LandsI x I q) : Wt.Pn (suc q.1) q.2.2.2.1 = Wf q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t q.2.2.2.2.1) (q.2.2.2.2.2, l) ;
  tg : D.Ob' x I = (D.tauX x).nt I gm ;
  i1 (q : DD.Idx x I) (l : DD.LandsI x I q) : DD.Idx x I =
   (suc q.1, q.2.1, CI.consId q.1 x q.2.1 q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (wq q l).1) ;
  l1 (q : DD.Idx x I) (l : DD.LandsI x I q) : DD.LandsI x I (i1 q l) = (wq q l).2 ;
  Pm (q : DD.Idx x I) (l : DD.LandsI x I q) : Id (W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (tg.1 (i1 q l) (l1 q l)) (tg.1 q l) =
   apH (\ k -> (G.act q.2.1 x k).nt q.2.2.2.1 ((G.ob x).act q.2.2.2.1 I q.2.2.2.2.1 gm)) (CI.consId-tot q.1 x q.2.1 q.2.2.1) ;
  mv : DA.TA x I tg = \ q l ->
   GPR.TyL[G.ob q.2.1, A.ty q.2.1].coeT q.2.2.2.1 (tg.1 (i1 q l) (l1 q l)) (tg.1 q l) (Pm q l) (u.1 (i1 q l) (l1 q l)) ;
  mpc (q : DD.Idx x I) (l : DD.LandsI x I q)
   : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (tg.1 q l) (mv q l)) (DA.prz q.2.1 q.2.2.2.1 (tg.1 (i1 q l) (l1 q l)) (u.1 (i1 q l) (l1 q l))) =
   symH (GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-coe q.2.2.2.1 (tg.1 (i1 q l) (l1 q l)) (tg.1 q l) (Pm q l) (u.1 (i1 q l) (l1 q l))) ;
  -- reading of u at (n+1 , consId c , J , g , p) for a weight p
  ru (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J I) (p : Wt.Pn (suc n) J) : W0.Ix (DA.Ez z J) =
   DA.prz z J (tg.1 (suc n, z, CI.consId n x z c, J, g, p.1) p.2) (u.1 (suc n, z, CI.consId n x z c, J, g, p.1) p.2) ;
  anat' : W0.Ix (DA.anatEq x I tg mv) = \ r l ->
   transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (mpc r.1 l))
    (transH (u.2.1 (i1 r.1 l, r.2) (l1 r.1 l))
      (transH (apH (\ p -> ru r.1.1 r.1.2.1 r.1.2.2.1 r.2.1 (PB.compH r.2.1 r.1.2.2.2.1 I r.1.2.2.2.2.1 r.2.2) p)
                 (transH (Wres r.1.1 r.2.1 r.1.2.2.2.1 r.2.2 (PB.compH r.1.2.2.2.1 I PB.Iv t r.1.2.2.2.2.1) (r.1.2.2.2.2.2, l))
                   (apH (\ t' -> Wf r.1.1 r.2.1 t' (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res))
                      (PB.comp-assoc r.2.1 r.1.2.2.2.1 I PB.Iv t r.1.2.2.2.2.1 r.2.2))))
        (symH (mpc (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 I r.1.2.2.2.2.1 r.2.2,
                    (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                   (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)))) ;
  aface' : W0.Ix (DA.afaceEq x I tg mv) = \ r l ->
   transH (mpc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF x I r l).1) (DA.afaceF x I r l).2)
    (transH (apH (ru (suc r.1) r.2.2.2.1 r.2.2.2.2.1 r.2.2.2.2.2.1 r.2.2.2.2.2.2.1)
               (transH (Wface r.1 r.2.2.2.2.2.1 (PB.compH r.2.2.2.2.2.1 I PB.Iv t r.2.2.2.2.2.2.1) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1) (r.2.2.2.2.2.2.2, l))
                 (U12.faceW-irr (suc r.1) r.2.2.2.2.2.1 (suc r.2.1) (Ar.leb-step r.2.1 r.1 r.2.2.1) (Ar.leb-step (suc r.2.1) (suc r.1) r.2.2.1)
                    (Wf r.1 r.2.2.2.2.2.1 (PB.compH r.2.2.2.2.2.1 I PB.Iv t r.2.2.2.2.2.2.1) (r.2.2.2.2.2.2.2, l)))))
      (transH (u.2.2.1 (suc r.1, suc r.2.1, r.2.2.1, r.2.2.2.1, CI.consId (suc r.1) x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (Wf r.1 r.2.2.2.2.2.1 (PB.compH r.2.2.2.2.2.1 I PB.Iv t r.2.2.2.2.2.2.1) (r.2.2.2.2.2.2.2, l)).1) (Wf r.1 r.2.2.2.2.2.1 (PB.compH r.2.2.2.2.2.1 I PB.Iv t r.2.2.2.2.2.2.1) (r.2.2.2.2.2.2.2, l)).2)
        (symH (mpc (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)))) ;
  atop' : W0.Ix (DA.atopEq x I tg mv) = \ r l ->
   transH (mpc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF x I r l).1) (DA.atopF x I r l).2)
    (transH (apH (ru (suc r.1) r.2.1 r.2.2.1 r.2.2.2.1 r.2.2.2.2.1)
               (transH (Wface r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PB.Iv t r.2.2.2.2.1) (suc r.1) (Tr.leb-refl (suc r.1)) (r.2.2.2.2.2, l))
                 (U12.faceW-irr (suc r.1) r.2.2.2.1 (suc (suc r.1)) (Tr.leb-refl (suc r.1)) (Tr.leb-refl (suc (suc r.1)))
                    (Wf r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PB.Iv t r.2.2.2.2.1) (r.2.2.2.2.2, l)))))
      (transH (u.2.2.2 (suc r.1, r.2.1, CI.consId (suc r.1) x r.2.1 r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (Wf r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PB.Iv t r.2.2.2.2.1) (r.2.2.2.2.2, l)).1)
                 (Wf r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PB.Iv t r.2.2.2.2.1) (r.2.2.2.2.2, l)).2)
        (apH ((A.tE r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.2).nt r.2.2.2.1)
           (symH (mpc (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))))) ;
  res : DA.TOb' x I tg = (mv, anat', aface', atop') ;
 } ;


 WfOne (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) : Wt.Pn (suc n) J = Wt.consOne n J i.1 ;
 module ME (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((B x).tob I gm)) {
  module M = MW[WfOne, \ n J' J h t i -> consOne-res n J' J h i, \ n J t k hk i -> consOne-face n J k hk i, x, I, gm, u, PB.ptH I PB.e1] ;
  res : DA.TOb' x I M.tg = M.res ;
  mpc (q : DD.Idx x I) (l : DD.LandsI x I q)
   : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (M.tg.1 q l) (M.mv q l)) (DA.prz q.2.1 q.2.2.2.1 (M.tg.1 (M.i1 q l) (M.l1 q l)) (u.1 (M.i1 q l) (M.l1 q l))) =
   M.mpc q l ;
  i1 (q : DD.Idx x I) (l : DD.LandsI x I q) : DD.Idx x I = M.i1 q l ;
  l1 (q : DD.Idx x I) (l : DD.LandsI x I q) : DD.LandsI x I (i1 q l) = M.l1 q l ;
 } ;

 mN (x : CO) : HO.NMap[G.ob x, B x, B x] =
  new HO.NMap[G.ob x, B x, B x, \ I gm u -> ME[x, I, gm, u].res,
   \ J I f gm gm' e u ->
    DA.tob-eq x J ((D.tauX x).nt J gm') _ _ (\ q l ->
     GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (((D.tauX x).nt J gm').1 q l) _ _
      (transH (DA.TB[x, J, I, f, (D.tauX x).nt I gm, (D.tauX x).nt J gm',
                     ntEq (G.ob x) (D.obD x) (D.tauX x) J I f gm gm' e, ME[x, I, gm, u].res].pc q l)
        (transH (ME[x, I, gm, u].mpc (D.BA[x, J, I, f, (D.tauX x).nt I gm].sh q) l)
          (transH (symH (DA.TB[x, J, I, f, (D.tauX x).nt I gm, (D.tauX x).nt J gm',
                     ntEq (G.ob x) (D.obD x) (D.tauX x) J I f gm gm' e, u].pc (ME[x, J, gm', (B x).tact J I f gm gm' e u].i1 q l)
                          (ME[x, J, gm', (B x).tact J I f gm gm' e u].l1 q l)))
            (symH (ME[x, J, gm', (B x).tact J I f gm gm' e u].mpc q l))))))] ;

 -- MW is natural in (I , t)
 module MWN (Wf : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PB.Iv t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (x : CO) (I' I : Ob) (h : Hom I' I) (gm : W0.Ix ((G.ob x).ob I)) (gm' : W0.Ix ((G.ob x).ob I'))
  (e : Id (W0.Ix ((G.ob x).ob I')) ((G.ob x).act I' I h gm) gm') (u : W0.Ix ((B x).tob I gm)) (t : Hom I PB.Iv) {
  module M = MW[Wf, Wres, Wface, x, I, gm, u, t] ;
  module M' = MW[Wf, Wres, Wface, x, I', gm', (B x).tact I' I h gm gm' e u, PB.compH I' I PB.Iv t h] ;
  module TBm = DA.TB[x, I', I, h, (D.tauX x).nt I gm, (D.tauX x).nt I' gm', ntEq (G.ob x) (D.obD x) (D.tauX x) I' I h gm gm' e, M.res] ;
  module TBu = DA.TB[x, I', I, h, (D.tauX x).nt I gm, (D.tauX x).nt I' gm', ntEq (G.ob x) (D.obD x) (D.tauX x) I' I h gm gm' e, u] ;
  nat : Id (W0.Ix ((B x).tob I' gm')) ((B x).tact I' I h gm gm' e M.res) M'.res =
   DA.tob-eq x I' ((D.tauX x).nt I' gm') _ _ (\ q l ->
    GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (((D.tauX x).nt I' gm').1 q l) _ _
     (transH (TBm.pc q l)
       (transH (M.mpc (TBm.sh q) l)
         (transH (apH (\ t' -> M.ru q.1 q.2.1 q.2.2.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I' I h q.2.2.2.2.1) (Wf q.1 q.2.2.2.1 t' (q.2.2.2.2.2, l)))
                    (symH (PB.comp-assoc q.2.2.2.1 I' I PB.Iv t h q.2.2.2.2.1)))
           (transH (symH (TBu.pc (M'.i1 q l) (M'.l1 q l)))
             (symH (M'.mpc q l))))))) ;
 } ;

 -- MW read in the total of B (base point and element from one w)
 module LN (Wf : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PB.Iv t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (x : CO) {
  module TX = GPR.TyL[G.ob x, B x] ;
  mwe (W : Ob) (w : TX.EI W) (j : Hom W PB.Iv) : TX.EI W =
   TX.pr W (TX.pr1 W w) (MW[Wf, Wres, Wface, x, W, TX.pr1 W w, TX.pr2 W w, j].res) ;
  mwe-act (V W : Ob) (g : Hom V W) (w : TX.EI W) (j : Hom W PB.Iv)
   : Id (TX.EI V) (TX.E.act V W g (mwe W w j)) (mwe V (TX.E.act V W g w) (PB.compH V W PB.Iv j g)) =
   transH (TX.pr-tact V W g (TX.pr1 W w) ((G.ob x).act V W g (TX.pr1 W w)) (refl ((G.ob x).act V W g (TX.pr1 W w)))
             (MW[Wf, Wres, Wface, x, W, TX.pr1 W w, TX.pr2 W w, j].res))
    (apH (TX.pr V ((G.ob x).act V W g (TX.pr1 W w)))
       (MWN[Wf, Wres, Wface, x, V, W, g, TX.pr1 W w, (G.ob x).act V W g (TX.pr1 W w), refl ((G.ob x).act V W g (TX.pr1 W w)), TX.pr2 W w, j].nat)) ;
 } ;

 -- a homotopy al ~ be whose line at (gamma , u) is j |-> MW at j, given its ends
 module LP (Wf : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PB.Iv t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (x : CO) (al be : HO.NMap[G.ob x, B x, B x])
  (en0 : (X : Ob) (z : W0.Ix ((extP (G.ob x) (B x)).ob X))
     -> Id (GPR.TyL[G.ob x, B x].EI X) (LN[Wf, Wres, Wface, x].mwe X z (PB.ptH X PB.e0)) (HO.HT[G.ob x, B x, B x, al, be].aE X z))
  (en1 : (X : Ob) (z : W0.Ix ((extP (G.ob x) (B x)).ob X))
     -> Id (GPR.TyL[G.ob x, B x].EI X) (LN[Wf, Wres, Wface, x].mwe X z (PB.ptH X PB.e1)) (HO.HT[G.ob x, B x, B x, al, be].bE X z)) {
  module H = HO.HT[G.ob x, B x, B x, al, be] ;
  module LNx = LN[Wf, Wres, Wface, x] ;
  module TX = LNx.TX ;
  module EL = GPR.PshL[TX.E] ;
  val (X : Ob) (z : W0.Ix (H.GA.ob X)) (W : Ob) (f : Hom W X) (j : Hom W PB.Iv) : TX.EI W = LNx.mwe W (TX.E.act W X f z) j ;
  path (X : Ob) (z : W0.Ix (H.GA.ob X)) : W0.Ix (H.PT.tobP X z) =
   H.PT.mkPath X z (val X z)
    (\ V W g f j -> transH (LNx.mwe-act V W g (TX.E.act W X f z) j) (apH (\ w -> LNx.mwe V w (PB.compH V W PB.Iv j g)) (EL.actC V W X f g z)))
    (\ W f j -> refl ((G.ob x).act W X f (TX.pr1 X z)))
    (transH (apH (\ w -> LNx.mwe X w (PB.ptH X PB.e0)) (EL.actId X (PB.idH X) (refl (PB.idH X)) z)) (en0 X z))
    (transH (apH (\ w -> LNx.mwe X w (PB.ptH X PB.e1)) (EL.actId X (PB.idH X) (refl (PB.idH X)) z)) (en1 X z)) ;
  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (H.GA.ob I)) (z' : W0.Ix (H.GA.ob J)) (e : Id (W0.Ix (H.GA.ob J)) (H.GA.act J I h z) z')
   : Id (W0.Ix (H.PT.tobP J z')) (H.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
   H.PT.path-eq J z' (H.PT.PathP.tact J I h z z' e (path I z)) (path J z')
    (\ V f j -> apH (\ w -> LNx.mwe V w j) (transH (symH (EL.actC V J I h f z)) (apH (TX.E.act V J f) e))) ;
  res : PEl[H.GA, H.PT.PathP] = new PEl[H.GA, H.PT.PathP, path, enat] ;
 } ;

 ------------------------------------------------------------------
 -- the weight families of q and p

 pnEq (n : Nat) (J : Ob) (p p' : Wt.Pn n J) (H : (k : Ar.Fin (suc n)) -> Id (Hom J PB.Iv) (p.1 k) (p'.1 k)) : Id (Wt.Pn n J) p p' =
  Sigma-eq (Wt.Coords n J) (\ cs -> PB.Lands J J (Wt.oneS n J cs) (PB.idH J)) p.1 p'.1 p.2 p'.2
   (funext (Ar.Fin (suc n)) (\ k -> Hom J PB.Iv) p.1 p'.1 H)
   (PB.isProp-Lands J J (Wt.oneS n J p'.1) (PB.idH J)) ;
 coEq (n : Nat) (J : Ob) (c c' : Wt.Coords n J) (H : (k : Ar.Fin (suc n)) -> Id (Hom J PB.Iv) (c k) (c' k)) : Id (Wt.Coords n J) c c' =
  funext (Ar.Fin (suc n)) (\ k -> Hom J PB.Iv) c c' H ;

 WfCons (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) : Wt.Pn (suc n) J = Wt.ConsP[n, J, t, i].consP ;
 WresCons (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, WfCons n J t i].res) (WfCons n J' (PB.compH J' J PB.Iv t h) (Wt.Res[n, J', J, h, i].res)) =
  pnEq (suc n) J' _ _ (\ k -> Wt.cons-res n J' J h t i.1 k) ;
 WfaceCons (n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (suc n)) J) (WfCons (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[WfCons n J t i].face) =
  pnEq (suc (suc n)) J _ _ (\ m -> symH (Wt.FaceCons[n, J, k, hk, t, i.1].coord m)) ;

 WfMeet (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) : Wt.Pn (suc n) J = Wt.consOne n J (Wt.meetC n J t i.1) ;
 WresMeet (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, WfMeet n J t i].res) (WfMeet n J' (PB.compH J' J PB.Iv t h) (Wt.Res[n, J', J, h, i].res)) =
  pnEq (suc n) J' _ _ (\ k ->
   transH (Wt.cons-res n J' J h (PB.ptH J PB.e1) (Wt.meetC n J t i.1) k)
    (transH (apH (\ jj -> Wt.consC n J' jj (Wt.resC n J' J h (Wt.meetC n J t i.1)) k) (PB.ptH-nat J' J h PB.e1))
      (apH {Wt.Coords n J'} {Hom J' PB.Iv} (\ cc -> Wt.consC n J' (PB.ptH J' PB.e1) cc k)
         (coEq n J' (Wt.resC n J' J h (Wt.meetC n J t i.1)) (Wt.meetC n J' (PB.compH J' J PB.Iv t h) (Wt.resC n J' J h i.1))
            (\ m -> Wt.meet-res n J' J h t i.1 m))))) ;
 WfaceMeet (n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (suc n)) J) (WfMeet (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[WfMeet n J t i].face) =
  pnEq (suc (suc n)) J _ _ (\ m ->
   transH (apH {Wt.Coords (suc n) J} {Hom J PB.Iv} (\ cc -> Wt.consC (suc n) J (PB.ptH J PB.e1) cc m)
             (coEq (suc n) J (Wt.meetC (suc n) J t (Wt.Face[n, J, k, hk].faceC i.1)) (Wt.Face[n, J, k, hk].faceC (Wt.meetC n J t i.1))
                (\ m' -> symH (Wt.MeetFace[n, J, k, hk, t, i.1].coord m'))))
    (symH (Wt.FaceCons[n, J, k, hk, PB.ptH J PB.e1, Wt.meetC n J t i.1].coord m))) ;

 -- MW only depends on the weights it reads
 module MWEq (Wf : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PB.Iv t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (Vf : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Vres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Vf n J t i].res) (Vf n J' (PB.compH J' J PB.Iv t h) (Wt.Res[n, J', J, h, i].res)))
  (Vface : (n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Vf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Vf n J t i].face))
  (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((B x).tob I gm)) (t t' : Hom I PB.Iv)
  (Hw : (q : DD.Idx x I) (l : DD.LandsI x I q)
     -> Id (Wt.Pn (suc q.1) q.2.2.2.1) (Wf q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t q.2.2.2.2.1) (q.2.2.2.2.2, l))
                                      (Vf q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t' q.2.2.2.2.1) (q.2.2.2.2.2, l))) {
  module M = MW[Wf, Wres, Wface, x, I, gm, u, t] ;
  module M' = MW[Vf, Vres, Vface, x, I, gm, u, t'] ;
  eq : Id (W0.Ix ((B x).tob I gm)) M.res M'.res =
   DA.tob-eq x I M.tg _ _ (\ q l ->
    GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (M.tg.1 q l) _ _
     (transH (M.mpc q l)
       (transH (apH (M.ru q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) (Hw q l))
         (symH (M'.mpc q l))))) ;
 } ;

 -- MW at the weights cons 0 is the identity (u's face 0 equation)
 module MW0 (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((B x).tob I gm)) {
  module M = MW[WfCons, WresCons, WfaceCons, x, I, gm, u, PB.ptH I PB.e0] ;
  rd (q : DD.Idx x I) (l : DD.LandsI x I q) : W0.Ix (DA.Ez q.2.1 q.2.2.2.1) = DA.prz q.2.1 q.2.2.2.1 (M.tg.1 q l) (u.1 q l) ;
  eq : Id (W0.Ix ((B x).tob I gm)) M.res u =
   DA.tob-eq x I M.tg _ _ (\ q l ->
    GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (M.tg.1 q l) _ _
     (transH (M.mpc q l)
       (transH (apH (M.ru q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1)
                  (transH (pnEq (suc q.1) q.2.2.2.1 (M.wq q l) (Wt.Face[q.1, q.2.2.2.1, zero, refl true].Of[(q.2.2.2.2.2, l)].face) (\ k ->
                             transH (apH (\ jj -> Wt.consC q.1 q.2.2.2.1 jj q.2.2.2.2.2 k) (PB.ptH-nat q.2.2.2.1 I q.2.2.2.2.1 PB.e0))
                               (Wt.ConsZero[q.1, q.2.2.2.1, q.2.2.2.2.2].coord k)))
                    (U12.faceW-irr q.1 q.2.2.2.1 zero (refl true) (Ar.leb-step zero q.1 (refl true)) (q.2.2.2.2.2, l))))
         (transH (u.2.2.1 (q.1, zero, refl true, q.2.1, CI.consId q.1 x q.2.1 q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2) l)
           (apH (\ cc -> DA.prz q.2.1 q.2.2.2.1 (M.tg.1 (q.1, q.2.1, cc, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2) l)
                          (u.1 (q.1, q.2.1, cc, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2) l))
              (CI.comp0 q.1 x q.2.1 q.2.2.1)))))) ;
 } ;
} ;
