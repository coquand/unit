-- Lemma14.seg (canonicity-45; COBAR.md "Lemma 14"): U tau_A is an
-- equivalence at x, as a quasi-inverse in CHtpyOps terms over G_x.
--   B          D A pulled back along tau (subTy along tauX)
--   tauA       a |-> the family A.tE (tot c) of a restricted along g
--   epsA       u |-> u at (0 , x , id , X , id , (1))
--   m , q , p  u at (n+1 , consId c , ..) with the weights consOne i ,
--              ConsP (j g) i , consOne (meetC (j g) i)
--   tau eps ~ id = Cat p (Inv q), with the composition of B from lemma12F
-- Part 1: tauA as a D A element over tau gamma, and as an NMap.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module HO = PB.CHtpyOps[l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module L14 (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A : CPshC[a, l].CPsh[C].CTy[G]) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module D = DD.DC[G] ;
 module DA = DD.DT[G, A] ;
 CO : U a = P.CO ;

 ------------------------------------------------------------------
 -- tau on A

 module TA' (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (av : W0.Ix ((A.ty x).tob X gm)) {
  tauP : D.Ob' x X = D.Tau[x, X, gm].res ;
  ae (J : Ob) (g : Hom J X) : SigT (G.ob x) (A.ty x) J = (extP (G.ob x) (A.ty x)).act J X g (pairE (G.ob x) (A.ty x) X gm av) ;
  ve (q : DD.Idx x X) : SigT (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 =
   (A.tE q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1)).nt q.2.2.2.1 (ae q.2.2.2.1 q.2.2.2.2.1) ;
  t : DA.TA x X tauP = \ q l ->
   GPR.TyL[G.ob q.2.1, A.ty q.2.1].coeT q.2.2.2.1 (fstE (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 (ve q)) (tauP.1 q l)
    (A.tE-pt q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1) q.2.2.2.1 (ae q.2.2.2.1 q.2.2.2.2.1))
    (sndE (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 (ve q)) ;
  pc (q : DD.Idx x X) (l : DD.LandsI x X q) : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (tauP.1 q l) (t q l)) (ve q) =
   symH (GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-coe q.2.2.2.1 (fstE (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 (ve q)) (tauP.1 q l)
          (A.tE-pt q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1) q.2.2.2.1 (ae q.2.2.2.1 q.2.2.2.2.1))
          (sndE (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1 (ve q))) ;
  anat' : W0.Ix (DA.anatEq x X tauP t) = \ r l ->
   transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pc r.1 l))
    (transH (symH ((A.tE r.1.2.1 x (K.tot r.1.1 x r.1.2.1 r.1.2.2.1)).nt-nat r.2.1 r.1.2.2.2.1 r.2.2 (ae r.1.2.2.2.1 r.1.2.2.2.2.1)))
      (transH (apH ((A.tE r.1.2.1 x (K.tot r.1.1 x r.1.2.1 r.1.2.2.1)).nt r.2.1)
                 (symH ((extP (G.ob x) (A.ty x)).act-o r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2 (pairE (G.ob x) (A.ty x) X gm av))))
        (symH (pc (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2,
                   (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                  (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)))) ;
  aface' : W0.Ix (DA.afaceEq x X tauP t) = \ r l ->
   transH (pc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF x X r l).1) (DA.afaceF x X r l).2)
    (transH (apH (\ k' -> (A.tE r.2.2.2.1 x k').nt r.2.2.2.2.2.1 (ae r.2.2.2.2.2.1 r.2.2.2.2.2.2.1))
               (symH (K.tot-comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1)))
      (symH (pc (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l))) ;
  atop' : W0.Ix (DA.atopEq x X tauP t) = \ r l ->
   transH (pc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF x X r l).1) (DA.atopF x X r l).2)
    (transH (apH (\ k' -> (A.tE r.2.1 x k').nt r.2.2.2.1 (ae r.2.2.2.1 r.2.2.2.2.1)) (K.tot-drop r.1 x r.2.1 r.2.2.1))
      (transH (A.tE-o r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 x (K.tot r.1 x (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.1)
                 (K.drop r.1 x r.2.1 r.2.2.1).2.2 r.2.2.2.1 (ae r.2.2.2.1 r.2.2.2.2.1))
        (apH ((A.tE r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.2).nt r.2.2.2.1)
           (symH (pc (r.1, (K.drop r.1 x r.2.1 r.2.2.1).1, (K.drop r.1 x r.2.1 r.2.2.1).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))))) ;
  res : DA.TOb' x X tauP = (t, anat', aface', atop') ;
 } ;

 -- B : D A pulled back along tau, over G_x
 B (x : CO) : PTy[G.ob x] = subTy (G.ob x) (D.obD x) (DA.DTy x) (D.tauX x) ;

 tauN (x : CO) : HO.NMap[G.ob x, A.ty x, B x] =
  new HO.NMap[G.ob x, A.ty x, B x, \ I gm av -> TA'[x, I, gm, av].res,
   \ J I f gm gm' e av ->
    DA.tob-eq x J (TA'[x, J, gm', (A.ty x).tact J I f gm gm' e av].tauP) _ _ (\ q l ->
     GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (TA'[x, J, gm', (A.ty x).tact J I f gm gm' e av].tauP.1 q l) _ _
      (transH (DA.TB[x, J, I, f, TA'[x, I, gm, av].tauP, TA'[x, J, gm', (A.ty x).tact J I f gm gm' e av].tauP,
                     ntEq (G.ob x) (D.obD x) (D.tauX x) J I f gm gm' e, TA'[x, I, gm, av].res].pc q l)
        (transH (TA'[x, I, gm, av].pc (D.BA[x, J, I, f, TA'[x, I, gm, av].tauP].sh q) l)
          (transH (apH ((A.tE q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1)).nt q.2.2.2.1)
                     (transH ((extP (G.ob x) (A.ty x)).act-o q.2.2.2.1 J I f q.2.2.2.2.1 (pairE (G.ob x) (A.ty x) I gm av))
                        (apH ((extP (G.ob x) (A.ty x)).act q.2.2.2.1 J q.2.2.2.2.1) (GPR.TyL[G.ob x, A.ty x].pr-tact J I f gm gm' e av))))
            (symH (TA'[x, J, gm', (A.ty x).tact J I f gm gm' e av].pc q l))))))] ;
} ;
