-- CHomT5.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 2: the datum of a binary
-- operation moved to CMorX (dT, as CHomT4's da / dm) satisfies CMorX's
-- naturality DN.  From the Pi family's naturality: the comp-idr transport
-- as a transport of points (subst-ap); the action of a transported element
-- (tactSrc: path induction and tact-irr); retargeting the action to the
-- Pi action's own target and proof (tactTr); the Pi action of the Sigma
-- type W4 is CMorX's restriction of (w, p) on the nose up to the proof of
-- tt = tt (tact-irr); apdS at the Pi family.
-- No new axioms beyond the named premises (fe).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
module PB = PosFull[a].PB ;
module LP = PB.GPre[a+].PS ;

module DNOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation)
  (opS : C.El C.nil (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[s].Qt (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[s].Qt CHomT3[a].HomP[R, encK, pe].Alg[s].Qt)))
  (opT : C.El C.nil (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[t].Qt (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[t].Qt CHomT3[a].HomP[R, encK, pe].Alg[t].Qt)))
  (sel : (I : Ob) (z : CHomT4[a].P3[R, encK, pe, s, t].Z I) -> V1.Ix (CHomT4[a].P3[R, encK, pe, s, t].H.B0.BinOf[opS, opT].DataBin.1.tob I (tt, z.1))) {
 module P = CHomT4[a].P3[R, encK, pe, s, t] ;
 module F = P.F ;
 module H = P.H ;
 module HB = H.B0.BinOf[opS, opT] ;
 module BB = F.Bin[F.S.Op[opS].IdB, F.T.Op[opT].IdB] ;
 W4K (K : Ob) : U a+ = V1.Ix (HB.W4.1.tob K tt) ;
 act (K L : Ob) (g : Hom L K) (wp : W4K K) : W4K L = HB.W4.1.tact L K g tt tt (refl tt) wp ;
 module G3 = F.T.QC ;
 IT : C.Ty F.T.G3 = F.T.Op[opT].IdB ;
 P3 (K : Ob) : U a+ = V1.Ix (F.T.G3.ob K) ;
 -- the action of a transported element
 tactSrc (K L : Ob) (g : Hom L K) (x0' x0 : P3 K) (q : Id (P3 K) x0' x0) (X : V1.Ix (IT.1.tob K x0')) (y : P3 L)
   (e : Id (P3 L) (F.T.G3.act L K g x0) y) (e' : Id (P3 L) (F.T.G3.act L K g x0') y)
  : Id (V1.Ix (IT.1.tob L y)) (IT.1.tact L K g x0 y e (subst (P3 K) (\ x -> V1.Ix (IT.1.tob K x)) x0' x0 q X)) (IT.1.tact L K g x0' y e' X) =
  idJ (P3 K) x0' (\ x1 q1 -> (e1 : Id (P3 L) (F.T.G3.act L K g x1) y) -> Id (V1.Ix (IT.1.tob L y)) (IT.1.tact L K g x1 y e1 (subst (P3 K) (\ x -> V1.Ix (IT.1.tob K x)) x0' x1 q1 X)) (IT.1.tact L K g x0' y e' X))
   (\ e1 -> LP.tact-irr F.T.G3 IT.1 L K g x0' y e1 e' X) x0 q e ;
 -- transport along a composite
 substTr (L : Ob) (x y z : P3 L) (p : Id (P3 L) x y) (q : Id (P3 L) y z) (u : V1.Ix (IT.1.tob L x))
  : Id (V1.Ix (IT.1.tob L z)) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x z (transH p q) u) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y z q (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x y p u)) =
  idJ (P3 L) y (\ z2 q2 -> Id (V1.Ix (IT.1.tob L z2)) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x z2 (transH p q2) u) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y z2 q2 (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x y p u)))
   (refl (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x y p u)) z q ;
 -- the datum moved to CMorX
 dT (I : Ob) (z : P.Z I) : BB.DT I (P.ph I z) = \ K f w p ->
  subst (Hom K I) (\ k -> V1.Ix (BB.FT K (F.mp3 I (P.ph I z) K k w))) (compH K K I f (idH K)) f (comp-idr K I f)
   ((sel I z).1 K f (w.1, (w.2.1, (w.2.2, p)))) ;
 -- the naturality DN
 module PC = PresheafPi[a, a+].PPi[PB.BC].PiCode[H.B0.Gh, HB.W4h.1, HB.IdT3.1] ;
 module DN (I : Ob) (z : P.Z I) (K L : Ob) (f : Hom K I) (g : Hom L K) (w : F.S.T3 K)
   (e : BB.EqT K L g (F.mp3 I (P.ph I z) K f w) (F.mp3 I (P.ph I z) L (compH L K I f g) (F.S.rs3 K L g w))) (p : V1.Ix (BB.FS K w)) {
  ph : F.Fam I = P.ph I z ;
  x : V1.Ix (H.B0.Gh.ob I) = (tt, z.1) ;
  phi : PC.FunT I (PC.ptOf I x) = (sel I z).1 ;
  fg : Hom L I = compH L K I f g ;
  wp : W4K K = (w.1, (w.2.1, (w.2.2, p))) ;
  X0 : V1.Ix (IT.1.tob K (F.T.mk3 K (F.mp3 I ph K (compH K K I f (idH K)) w))) = phi K f wp ;
  x0' : P3 K = F.T.mk3 K (F.mp3 I ph K (compH K K I f (idH K)) w) ;
  x0 : P3 K = F.T.mk3 K (F.mp3 I ph K f w) ;
  qA : Id (P3 K) x0' x0 = ap (Hom K I) (P3 K) (\ k -> F.T.mk3 K (F.mp3 I ph K k w)) (compH K K I f (idH K)) f (comp-idr K I f) ;
  w2 : F.T.T3 L = F.mp3 I ph L fg (F.S.rs3 K L g w) ;
  y2 : P3 L = F.T.mk3 L w2 ;
  aw : W4K L = PC.AactOf I (PC.ptOf I x) (PC.cOf I x) K L f g wp ;
  wp1 : W4K L = act K L g wp ;
  yB : P3 L = HB.sigN L (PC.ptOf I x L fg, aw) ;
  eB : Id (P3 L) (F.T.G3.act L K g x0') yB =
   LP.ntEq HB.Dw F.T.G3 HB.sigT L K g (PC.ptOf I x K f, wp) (PC.ptOf I x L fg, aw) (PC.eOf I x K L f g wp) ;
  sigL (wq : W4K L) : P3 L = HB.sigN L (PC.ptOf I x L fg, wq) ;
  piw : Id (W4K L) aw wp1 =
   LP.tact-irr C.nil HB.W4.1 L K g tt tt (LP.ntEq H.B0.Gh C.nil H.B0.pG L K g (PC.ptOf I x K f) (PC.ptOf I x L fg) (PC.cOf I x K L f g)) (refl tt) wp ;
  pip : Id (P3 L) yB (sigL wp1) = ap (W4K L) (P3 L) sigL aw wp1 piw ;
  qD : Id (P3 L) (sigL wp1) y2 = ap (Hom L I) (P3 L) (\ k -> F.T.mk3 L (F.mp3 I ph L k (F.S.rs3 K L g w))) (compH L L I fg (idH L)) fg (comp-idr L I fg) ;
  qC : Id (P3 L) yB y2 = transH pip qD ;
  X1' : V1.Ix (IT.1.tob L yB) = phi L fg aw ;
  X1 : V1.Ix (IT.1.tob L (sigL wp1)) = phi L fg wp1 ;
  nat : Id (V1.Ix (IT.1.tob L yB)) (IT.1.tact L K g x0' yB eB X0) X1' = (sel I z).2 K L f g wp ;
  T2 : U a+ = V1.Ix (IT.1.tob L y2) ;
  s1 : Id T2 (BB.acT K L g (F.mp3 I ph K f w) w2 e (dT I z K f w p)) (IT.1.tact L K g x0 y2 e (subst (P3 K) (\ v -> V1.Ix (IT.1.tob K v)) x0' x0 qA X0)) =
   apH {V1.Ix (IT.1.tob K x0)} {T2} (\ u -> IT.1.tact L K g x0 y2 e u)
    (subst-ap (Hom K I) (P3 K) (\ k -> F.T.mk3 K (F.mp3 I ph K k w)) (\ v -> V1.Ix (IT.1.tob K v)) (compH K K I f (idH K)) f (comp-idr K I f) X0) ;
  s2 : Id T2 (IT.1.tact L K g x0 y2 e (subst (P3 K) (\ v -> V1.Ix (IT.1.tob K v)) x0' x0 qA X0)) (IT.1.tact L K g x0' y2 (transH eB qC) X0) =
   tactSrc K L g x0' x0 qA X0 y2 e (transH eB qC) ;
  s3 : Id T2 (IT.1.tact L K g x0' y2 (transH eB qC) X0) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) yB y2 qC (IT.1.tact L K g x0' yB eB X0)) =
   CMorX[a].tactTr F.T.G3 IT L K g x0' yB y2 eB qC X0 ;
  s4 : Id T2 (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) yB y2 qC (IT.1.tact L K g x0' yB eB X0)) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) yB y2 qC X1') =
   apH {V1.Ix (IT.1.tob L yB)} {T2} (\ u -> subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) yB y2 qC u) nat ;
  s5 : Id T2 (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) yB y2 qC X1') (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) (sigL wp1) y2 qD (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) yB (sigL wp1) pip X1')) =
   substTr L yB (sigL wp1) y2 pip qD X1' ;
  s6 : Id (V1.Ix (IT.1.tob L (sigL wp1))) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) yB (sigL wp1) pip X1') X1 =
   transH (symH (subst-ap (W4K L) (P3 L) sigL (\ v -> V1.Ix (IT.1.tob L v)) aw wp1 piw X1'))
    (CMorX[a].apdS (W4K L) (\ wq -> V1.Ix (IT.1.tob L (sigL wq))) (\ wq -> phi L fg wq) aw wp1 piw) ;
  s7 : Id T2 (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) (sigL wp1) y2 qD (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) yB (sigL wp1) pip X1')) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) (sigL wp1) y2 qD X1) =
   apH {V1.Ix (IT.1.tob L (sigL wp1))} {T2} (\ u -> subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) (sigL wp1) y2 qD u) s6 ;
  s8 : Id T2 (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) (sigL wp1) y2 qD X1) (dT I z L fg (F.S.rs3 K L g w) (BB.acS K L g w p)) =
   symH (subst-ap (Hom L I) (P3 L) (\ k -> F.T.mk3 L (F.mp3 I ph L k (F.S.rs3 K L g w))) (\ v -> V1.Ix (IT.1.tob L v)) (compH L L I fg (idH L)) fg (comp-idr L I fg) X1) ;
  law : Id T2 (BB.acT K L g (F.mp3 I ph K f w) w2 e (dT I z K f w p)) (dT I z L fg (F.S.rs3 K L g w) (BB.acS K L g w p)) =
   transH s1 (transH s2 (transH s3 (transH s4 (transH s5 (transH s7 s8))))) ;
 } ;
 dN (I : Ob) (z : P.Z I) : BB.DN I (P.ph I z) (dT I z) = \ K L f g w e p -> DN[I, z, K, L, f, g, w, e, p].law ;
} ;
