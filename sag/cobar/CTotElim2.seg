-- CTotElim2.seg (canonicity-c2; towards (c), the eliminator of Tr): at
-- the total site, the substitution incS = (p , inc) : G.A -> G.Tr A, and
-- transport in a fibrant family P over G.Tr A between any two points of a
-- fibre of Tr A (Tr A is a proposition: GCTruncFromProp gives its seeded
-- algebra, GCTruncTransport the transport).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module EL2 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module P1 = TR.P1 ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 GP : P1.PCtx = TC.toP G ;
 module TT = CTotTr[a, vl, l].TotTr[C].Tr[GP, A] ;
 Tr : G1.fibCwF-T.Ty GP = TT.Tr ;
 GA : P1.PCtx = TT.GA1 ;
 GT : P1.PCtx = P1.extP GP Tr.1 ;
 incV (X : TC.TOb) (w : W0.Ix (GA.ob X)) : W0.Ix (Tr.1.tob X w.1) = TT.incE.eob X w ;
 incS : P1.PSub[GA, GT] =
  new P1.PSub[GA, GT, \ X w -> (w.1, incV X w), \ J I f w ->
    apH {W0.Ix (Tr.1.tob J (GP.act J I f w.1))} {W0.Ix (GT.ob J)} (\ c -> (GP.act J I f w.1, c))
      (symH (transH (P1.tact-irr GP Tr.1 J I f w.1 (GP.act J I f w.1) (refl (GP.act J I f w.1))
                        (P1.ntEq GA GP (P1.pP GP A.1) J I f w (GA.act J I f w) (refl (GA.act J I f w))) (incV I w))
                (TT.incE.enat J I f w (GA.act J I f w) (refl (GA.act J I f w)))))] ;
 -- Tr A's seeded algebra, from its contraction
 alg : G1.FT.GCTruncAlg[l].Algebras[GP, Tr.1].Algebra = G1.FT.GCTruncFromProp[l].FromPointed[GP, Tr.1, TT.rcTr].algebra ;
 module At (P : G1.fibCwF-T.Ty (G1.fibCwF-T.ext GP Tr)) {
  module TP = G1.FT.GCTruncTransport[l].Transport[GP, Tr.1, alg, P.1, P.2.1] ;
  move (X : TC.TOb) (g : W0.Ix (GP.ob X)) (u v : W0.Ix (Tr.1.tob X g)) (b : W0.Ix (P.1.tob X (g, u))) : W0.Ix (P.1.tob X (g, v)) =
   TP.At[X, g, u, v, b].value ;
 } ;
} ;
