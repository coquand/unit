-- CEv1.seg (canonicity-c2; HomT(F1, y) ~ Q_y, part 1): evaluation at the
-- generator, ev g = g (cls x), as a closed function HomT(F1, y) -> Q_y.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module E1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module CM = CCopy[a].ConcC[R, encK, pe].CM ;
 F1 : SX.Over[R].Presentation = CM.F1 ;
 module HZ = CHomT3[a].HomP[R, encK, pe].Hom[F1, y] ;
 module B0 = HZ.B0 ;
 module HO = PosFull[a].PB.CHtpyOps[a+] ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = HZ.HomT ;
 QA : C.Ty Nl = HZ.AS.Qt ;
 QY : C.Ty Nl = HZ.AT.Qt ;
 cx : C.El Nl QA = HZ.AS.AX.cls (var (inr tt)) ;
 nf (K : Ob) : (o : Top) -> V1.Ix (HT.1.tob K o) -> V1.Ix (QY.1.tob K o) = split { tt -> \ g -> B0.hv K tt g.1 (cx.eob K tt) } ;
 nn (J I : Ob) (f : Hom J I) : (x x' : Top) (e : Id Top (Nl.act J I f x) x') (g : V1.Ix (HT.1.tob I x))
   -> Id (V1.Ix (QY.1.tob J x')) (QY.1.tact J I f x x' e (nf I x g)) (nf J x' (HT.1.tact J I f x x' e g)) =
  split { tt -> split { tt -> \ e g ->
   transH (L.tact-irr Nl QY.1 J I f tt tt e (refl tt) (B0.hv I tt g.1 (cx.eob I tt)))
    (transH (symH (B0.NTh[I, J, f, tt, g.1, cx.eob I tt].law))
      (transH (apH {V1.Ix (B0.MapT.1.tob J tt)} {V1.Ix (QY.1.tob J tt)} (\ m -> B0.hv J tt m (B0.rsS I J f tt (cx.eob I tt)))
                 (L.tact-irr Nl B0.MapT.1 J I f tt tt (refl tt) e g.1))
        (apH {V1.Ix (QA.1.tob J tt)} {V1.Ix (QY.1.tob J tt)} (\ u -> B0.hv J tt (B0.MapT.1.tact J I f tt tt e g.1) u)
           (cx.enat J I f tt tt (refl tt))))) } } ;
 nm : HO.NMap[Nl, HT.1, QY.1] = new HO.NMap[Nl, HT.1, QY.1, nf, nn] ;
 ev : C.El Nl (OV.Fun Nl HT QY) = QinvEq[a, a+].FunOf[Nl, HT, QY, nm].fC ;
 -- the pairs of homs with the same value at the generator (CInjP at nm)
 module IPm = CInjP[a].IP[HT, QY, nm] ;
 evS (D : C.Ctx) (s0 : C.Sub D Nl) (g : C.El D (C.subT D Nl HT s0)) : C.El D (C.subT D Nl QY s0) = IPm.evS D s0 g ;
 D1 : C.Ctx = IPm.D1 ;
 HTw : C.Ty D1 = IPm.Aw ;
 D2 : C.Ctx = IPm.D2 ;
 s2 : C.Sub D2 Nl = IPm.s2 ;
 PH2 : Id (C.Ty D2) (OV.wkT D1 HTw HTw) (C.subT D2 Nl HT s2) = IPm.PH2 ;
 u1 : C.El D2 (C.subT D2 Nl HT s2) = IPm.u1 ;
 u2 : C.El D2 (C.subT D2 Nl HT s2) = IPm.u2 ;
 IdZ : C.Ty D2 = IPm.IdZ ;
 H : C.Ty Nl = IPm.H ;
 GH : C.Ctx = IPm.GH ;
 -- the two homs of a point of nil.H
 pkA (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HT.1.tob K w.1) = w.2.1 ;
 pkB (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HT.1.tob K w.1) = w.2.2.1 ;
 pkAN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HT.1.tob J w.1)) (HT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J (GH.act J I f w)) =
  refl (HT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) ;
 pkBN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HT.1.tob J w.1)) (HT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J (GH.act J I f w)) =
  L.tact-irr Nl HT.1 J I f w.1 w.1 (refl w.1)
   (L.ntEq D1 Nl (L.pP Nl HT.1) J I f (w.1, w.2.1) (Nl.act J I f w.1, HT.1.tact J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1)
      (L.pair-act Nl HT.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1))
   w.2.2.1 ;
 module U20m = CUG20[a].UG20[R, encK, pe, F1, y, H, pkA, pkB, pkAN, pkBN] ;
 module U13m = U20m.U13m ;
 -- the Id component as an Id between the evaluations
 sgN (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (D2.ob K) = ((w.1, w.2.1), w.2.2.1) ;
 sg : C.Sub GH D2 = new L.PSub[GH, D2, sgN, \ J I f w -> refl (sgN J (GH.act J I f w))] ;
 IdZs : C.Ty GH = C.subT GH D2 IdZ sg ;
 pIdN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I))
   : Id (V1.Ix (IdZs.1.tob J (GH.act J I f w))) (IdZs.1.tact J I f w (GH.act J I f w) (refl (GH.act J I f w)) w.2.2.2) (GH.act J I f w).2.2.2 =
  L.tact-irr D2 IdZ.1 J I f (sgN I w) (sgN J (GH.act J I f w))
    (L.ntEq GH D2 sg J I f w (GH.act J I f w) (refl (GH.act J I f w)))
    (L.pair-act D1 HTw.1 J I f (w.1, w.2.1) (Nl.act J I f w.1, HT.1.tact J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1)
       (L.pair-act Nl HT.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1) w.2.2.1)
    w.2.2.2 ;
 pId : C.El GH IdZs = L.mkPEl GH IdZs.1 (\ I w -> w.2.2.2) (\ J I f w w' e ->
  idJ (V1.Ix (GH.ob J)) (GH.act J I f w) (\ w2 e2 -> Id (V1.Ix (IdZs.1.tob J w2)) (IdZs.1.tact J I f w w2 e2 w.2.2.2) w2.2.2.2)
    (pIdN J I f w) w' e) ;
 QYh : C.Ty GH = OV.wkT Nl H QY ;
 QD2 : C.Ty D2 = C.subT D2 Nl QY s2 ;
 PQ : Id (C.Ty GH) (C.subT GH D2 QD2 sg) QYh =
  transH (symH (C.subT-o GH D2 Nl QY s2 sg))
   (apH {C.Sub GH Nl} {C.Ty GH} (\ s -> C.subT GH Nl QY s) (L.sub-ext GH Nl (C.o GH D2 Nl s2 sg) (C.p Nl H) (\ K w -> refl w.1))) ;
 i1 : C.El GH (IJ.IdT GH (C.subT GH D2 QD2 sg) (C.subt GH D2 QD2 (evS D2 s2 u1) sg) (C.subt GH D2 QD2 (evS D2 s2 u2) sg)) =
  OV.trE GH IdZs (IJ.IdT GH (C.subT GH D2 QD2 sg) (C.subt GH D2 QD2 (evS D2 s2 u1) sg) (C.subt GH D2 QD2 (evS D2 s2 u2) sg))
   (IJ.IdT-nat GH D2 QD2 (evS D2 s2 u1) (evS D2 s2 u2) sg) pId ;
 i2 : C.El GH (IJ.IdT GH QYh (OV.trE GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u1) sg)) (OV.trE GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u2) sg))) =
  CCmpU16[a].U16[R, encK, pe, y].idFwd GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u1) sg) (C.subt GH D2 QD2 (evS D2 s2 u2) sg) i1 ;
 urd (u : C.El D2 (C.subT D2 Nl HT s2)) (x0 : C.El D2 (OV.wkT D1 HTw HTw)) (Pu : Id (C.El D2 (C.subT D2 Nl HT s2)) u (OV.trE D2 (OV.wkT D1 HTw HTw) (C.subT D2 Nl HT s2) PH2 x0))
   (K : Ob) (x : V1.Ix (D2.ob K)) : Id (V1.Ix (HT.1.tob K x.1.1)) (u.eob K x) (x0.eob K x) =
  transH (apH {C.El D2 (C.subT D2 Nl HT s2)} {V1.Ix (HT.1.tob K x.1.1)} (\ v -> v.eob K x) Pu)
   (transH (CAppRd[a].trE-rd D2 (OV.wkT D1 HTw HTw) (C.subT D2 Nl HT s2) PH2 x0 K x)
     (CAppRd[a].same-rd D2 (OV.wkT D1 HTw HTw) (C.subT D2 Nl HT s2) PH2 K x (refl (HT.1.tob K x.1.1)) (x0.eob K x))) ;
 -- endpoints, read
 eA0 (K : Ob) : (o : Top) (h : V1.Ix (H.1.tob K o))
   -> Id (V1.Ix (QY.1.tob K o)) (nf K o h.1) (B0.hv K o h.1.1 (cx.eob K o)) = split { tt -> \ h -> refl (B0.hv K tt h.1.1 (cx.eob K tt)) } ;
 eB0 (K : Ob) : (o : Top) (h : V1.Ix (H.1.tob K o))
   -> Id (V1.Ix (QY.1.tob K o)) (nf K o h.2.1) (B0.hv K o h.2.1.1 (cx.eob K o)) = split { tt -> \ h -> refl (B0.hv K tt h.2.1.1 (cx.eob K tt)) } ;
 rA (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w))
   ((OV.trE GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u1) sg)).eob K w) ((U13m.ZA.apC cx).eob K w) =
  transH (CAppRd[a].trE-rd GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u1) sg) K w)
   (transH (CAppRd[a].same-rd GH (C.subT GH D2 QD2 sg) QYh PQ K w (refl (QYh.1.tob K w)) ((evS D2 s2 u1).eob K (sgN K w)))
     (transH (apH {V1.Ix (HT.1.tob K w.1)} {V1.Ix (QY.1.tob K w.1)} (nf K w.1) (urd u1 (OV.wkE D1 HTw HTw (C.q Nl HT)) (refl u1) K (sgN K w)))
       (transH (eA0 K w.1 w.2) (symH (U13m.ZA.rdF cx K w))))) ;
 rB (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w))
   ((OV.trE GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u2) sg)).eob K w) ((U13m.ZB.apC cx).eob K w) =
  transH (CAppRd[a].trE-rd GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u2) sg) K w)
   (transH (CAppRd[a].same-rd GH (C.subT GH D2 QD2 sg) QYh PQ K w (refl (QYh.1.tob K w)) ((evS D2 s2 u2).eob K (sgN K w)))
     (transH (apH {V1.Ix (HT.1.tob K w.1)} {V1.Ix (QY.1.tob K w.1)} (nf K w.1) (urd u2 (C.q D1 HTw) (refl u2) K (sgN K w)))
       (transH (eB0 K w.1 w.2) (symH (U13m.ZB.rdF cx K w))))) ;
 gx : C.El GH (U20m.IdZ cx) =
  CCmpU14[a].rwId GH QYh (OV.trE GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u1) sg)) (U13m.ZA.apC cx)
   (OV.trE GH (C.subT GH D2 QD2 sg) QYh PQ (C.subt GH D2 QD2 (evS D2 s2 u2) sg)) (U13m.ZB.apC cx) rA rB i2 ;
 gT : (u : Top) -> C.El GH (U20m.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[F1].AX.cls (var (inr u)))) = split { tt -> gx } ;
 gen : (v : SX.Fin F1.1) -> C.El GH (U20m.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[F1].AX.cls (var v))) = split {
  inl e -> absurd (C.El GH (U20m.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[F1].AX.cls (var (inl e))))) e ;
  inr u -> gT u } ;
} ;
