-- CL14C.seg (canonicity-45; COBAR.md "Prop 58"): Lemma 14 for yo F1 at
-- each copy: tau : U(yo F1) -> U(G) (G read as Cor 15's Bt over the
-- terminal context), its quasi-inverse eps and the two homotopies (Cor 15's
-- Main.q from CTotL14g, at CCopy6's levelwise fibration structure),
-- restricted to the copy of y' (CCopyH).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module L14C (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module YF = CCopy6[a].YoF[R, encK, pe] ;
 module CM = YF.CM ;
 module CT = YF.CT ;
 module C15 = CTotC15[a, a+, a+].C15[CM.IC, CT.T1, YF.O1.Y1T] ;
 module LB = C15.LB ;
 module M = C15.Main[YF.fibG0] ;
 module HO0 = LB.TR.G0.GB.CHtpyOps[a+] ;
 module Cp (y' : SX.Over[R].Presentation) {
  module RH = CCopyH[a].RH[R, encK, pe, y'].Of[LB.UG, LB.UA, LB.UB] ;
  module RH' = CCopyH[a].RH[R, encK, pe, y'].Of[LB.UG, LB.UB, LB.UA] ;
  module RHA = CCopyH[a].RH[R, encK, pe, y'].Of[LB.UG, LB.UA, LB.UA] ;
  module RHB = CCopyH[a].RH[R, encK, pe, y'].Of[LB.UG, LB.UB, LB.UB] ;
  tauC : PB.CHtpyOps[a+].NMap[RH.Gy, RH.Ay, RH.By] = RH.rN LB.tauN ;
  epsC : PB.CHtpyOps[a+].NMap[RH.Gy, RH.By, RH.Ay] = RH'.rN M.q.1 ;
  module ET = RHA.RHt[HO0.compN LB.UG LB.UA LB.UB LB.UA LB.tauN M.q.1, HO0.idN LB.UG LB.UA, M.q.2.1] ;
  module TE = RHB.RHt[HO0.compN LB.UG LB.UB LB.UA LB.UB M.q.1 LB.tauN, HO0.idN LB.UG LB.UB, M.q.2.2] ;
  -- eps tau ~ id and tau eps ~ id at the copy
  etC : L.PEl[ET.T.GA, ET.T.PT.PathP] = ET.res ;
  teC : L.PEl[TE.T.GA, TE.T.PT.PathP] = TE.res ;
 } ;
} ;
