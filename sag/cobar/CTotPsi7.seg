-- CTotPsi7.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for lines
-- at the total site, part 7: Psi on the points of TVC_e as a D-element
-- (PsiPt): its three equations by tv-eq (lines from PsiL's equations,
-- readings from av's equations through pc).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;

module Psi7 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P6 = CTotPsi6[a, vl, l].Psi6[C, G, A, e] ;
 module P5 = P6.P5 ;
 module P4 = CTotPsi4[a, vl, l].Psi4[C, G] ;
 module P3 = P6.P3 ;
 module PO = P6.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module DA = P6.DA ;
 module EKg = P6.EKg ;
 module EKd = P6.EKd ;
 module DV = P6.DV ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;

 module PE (X : TC.TOb) (w : W0.Ix (EKd.TV.E.ob X)) {
  module PP = P6.PP[X, w] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  natPt : W0.Ix (DV.natEq I x PP.tPt) = \ r lq ->
   EKg.tv-eq (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
    (EKg.TV.E.act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (PP.tPt r.1 lq))
    (PP.tPt (r.1.1, r.2.1, compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1,
             DO.rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1, (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, lq)].res).1)
       (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, lq)].res).2)
    (P3.PN[X, PP.ln].NT[r.1.1, r.1.2.1, r.1.2.2.1, r.1.2.2.2.1, r.1.2.2.2.2.1, (r.1.2.2.2.2.2, lq), r.2.1, r.2.2].law)
    (transH (EKg.endE-act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (PP.tPt r.1 lq))
       (transH (apH {EKg.TA.EI (r.1.2.1, r.1.2.2.2.1)} {EKg.TA.EI (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
                  (\ t -> EKg.TA.E.act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) t)
                  (PP.PQ[r.1.1, r.1.2.1, r.1.2.2.1, r.1.2.2.2.1, r.1.2.2.2.2.1, (r.1.2.2.2.2.2, lq)].pc))
         (transH (PP.av.2.1 r lq)
           (symH (PP.PQ[r.1.1, r.2.1, compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1,
                        DO.rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1, Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, lq)].res].pc))))) ;
  facePt : W0.Ix (DV.faceEq I x PP.tPt) = \ r lq ->
   EKg.tv-eq (r.2.2.2.1, r.2.2.2.2.2.1) _ _
    (P4.PF[X, PP.ln].FE[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (r.2.2.2.2.2.2.2, lq)].law)
    (transH (PP.PQ[suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1,
                   Wt.Face[r.1, r.2.2.2.1, r.2.1, Arith[a].leb-step r.2.1 r.1 r.2.2.1].Of[(r.2.2.2.2.2.2.2, lq)].face].pc)
       (transH (PP.av.2.2.1 r lq)
         (symH (PP.PQ[r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1,
                      DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, (r.2.2.2.2.2.2.2, lq)].pc)))) ;
  module TP2 (r : VA.Ix (DV.topIdxV I x)) (lq : DV.topLd I x r) {
   module TT = P5.PT[X, PP.ln].TT[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (r.2.2.2.2.2, lq)] ;
   module QA = PP.PQ[suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, TT.ft] ;
   module QB = PP.PQ[r.1, r.2.1, r.2.2.1, TT.z', TT.c', (r.2.2.2.2.2, lq)] ;
   law : Id (W0.Ix (P6.TVC.ob TT.Y)) QA.pt (EKg.TV.E.act TT.Y TT.Y' TT.gv QB.pt) =
    EKg.tv-eq TT.Y QA.pt (EKg.TV.E.act TT.Y TT.Y' TT.gv QB.pt) TT.law
     (transH QA.pc
       (transH (PP.av.2.2.2 r lq)
         (transH (apH {EKg.TA.EI TT.Y'} {EKg.TA.EI TT.Y} (\ t -> EKg.TA.E.act TT.Y TT.Y' TT.gv t) (symH QB.pc))
           (symH (EKg.endE-act TT.Y TT.Y' TT.gv QB.pt))))) ;
  } ;
  topPt : W0.Ix (DV.topEq I x PP.tPt) = \ r lq -> TP2[r, lq].law ;
  PsiPt : DV.Ob' I x = (PP.tPt, natPt, facePt, topPt) ;
 } ;
} ;
