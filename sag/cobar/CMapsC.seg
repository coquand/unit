-- CMapsC.seg (canonicity-45; SIMPLIFIED.md step 6): the substitution maps
-- as morphisms of C at every stage.  Against the eliminator package of the
-- quotient (c2's CwFQuotElim1.QE1, here module parameters in the agreed
-- shapes: elim1 / elim1-beta / setQ, elim2 / elim2-beta, ElimP1 / ElimP3,
-- setQi), with C's operations the quotient's (CAlgX.Ops.addQ / mulQ):
--   lawA / lawM / lawK  the homomorphism laws of Phi at classes (Phi's beta,
--                       the operations' beta rules, CAlgX's congruences,
--                       apM on Phi's body)
--   MapOf[..].DA      the addition's datum (CHomData); the multiplication's,
--                       the constants' and the morphism are in CMapsC2
-- Instances: I1, I2, AddF, MulF (F1 -> F2) and Pu x u (A_x -> A_{x.u}).
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module Inst (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (elim1 : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Ty)
 (elim1-beta : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Beta (elim1 x))
 (setQ : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].SetQ)
 (elim2 : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Ty)
 (elim2-beta : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Beta (elim2 x))
 (elimP1 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP1Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (elimP3 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP3Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (setQi : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].SetQiTy) {
 module OP (x : SX.Over[R].Presentation) { module O = CAlgX[a].AlgX[R, encK, x, pe].Ops[setQ x, setQi x, elim2 x, elim2-beta x] ; } ;
 addO (x : SX.Over[R].Presentation) : C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)) = OP[x].O.addQ ;
 mulO (x : SX.Over[R].Presentation) : C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)) = OP[x].O.mulQ ;
 module MF = CFreeMaps[a].MapsOf[R, encK, pe, elim1, elim1-beta, setQ, setQi] ;
 module AXo (x : SX.Over[R].Presentation) { module A = CAlgX[a].AlgX[R, encK, x, pe] ; } ;

 -- a closed map given on classes by t |-> cls (fT t), with beta
 module MapOf (s t : SX.Over[R].Presentation)
  (Phi : C.El C.nil (OV.Fun C.nil AXo[s].A.Qt AXo[t].A.Qt))
  (fT : AXo[s].A.Term -> AXo[t].A.Term)
  (beta : (u : AXo[s].A.Term) -> C.El C.nil (AXo[t].A.IdQ (OV.app C.nil AXo[s].A.Qt AXo[t].A.Qt Phi (AXo[s].A.cls u)) (AXo[t].A.cls (fT u))))
  (fsum : (u v : AXo[s].A.Term) -> Id (AXo[t].A.Term) (fT (sumE u v)) (sumE (fT u) (fT v)))
  (fmul : (u v : AXo[s].A.Term) -> Id (AXo[t].A.Term) (fT (mulE u v)) (mulE (fT u) (fT v)))
  (fcst : (c : R.R) -> Id (AXo[t].A.Term) (fT (cst c)) (cst c)) {
  module AS = AXo[s].A ;
  module AT = AXo[t].A ;
  module OS = OP[s].O ;
  module OT = OP[t].O ;
  Nl : C.Ctx = C.nil ;
  ph (q : AS.Q) : AT.Q = OV.app Nl AS.Qt AT.Qt Phi q ;
  -- Phi preserves Ids (apM on Phi's body)
  apPh (q q' : AS.Q) (e : C.El Nl (AS.IdQ q q')) : C.El Nl (AT.IdQ (ph q) (ph q')) =
   PT.apM Nl AS.Qt AT.Qt (OV.bod Nl AS.Qt (OV.wkT Nl AS.Qt AT.Qt) Phi) q q' e ;
  -- the laws at classes
  lawA (u v : AS.Term) : C.El Nl (AT.IdQ (OT.add (ph (AS.cls u)) (ph (AS.cls v))) (ph (OS.add (AS.cls u) (AS.cls v)))) =
   OT.tr (OT.add (ph (AS.cls u)) (ph (AS.cls v))) (OT.add (AT.cls (fT u)) (ph (AS.cls v))) (ph (OS.add (AS.cls u) (AS.cls v)))
    (OT.addL (ph (AS.cls u)) (AT.cls (fT u)) (ph (AS.cls v)) (beta u))
    (OT.tr (OT.add (AT.cls (fT u)) (ph (AS.cls v))) (OT.add (AT.cls (fT u)) (AT.cls (fT v))) (ph (OS.add (AS.cls u) (AS.cls v)))
      (OT.addR (AT.cls (fT u)) (ph (AS.cls v)) (AT.cls (fT v)) (beta v))
      (OT.tr (OT.add (AT.cls (fT u)) (AT.cls (fT v))) (AT.cls (sumE (fT u) (fT v))) (ph (OS.add (AS.cls u) (AS.cls v)))
        (OT.add-beta (fT u) (fT v))
        (OT.tr (AT.cls (sumE (fT u) (fT v))) (ph (AS.cls (sumE u v))) (ph (OS.add (AS.cls u) (AS.cls v)))
          (OT.tr (AT.cls (sumE (fT u) (fT v))) (AT.cls (fT (sumE u v))) (ph (AS.cls (sumE u v)))
             (OT.ofEq (AT.cls (sumE (fT u) (fT v))) (AT.cls (fT (sumE u v))) (apH {AT.Term} {AT.Q} AT.cls (symH (fsum u v))))
             (OT.sy (ph (AS.cls (sumE u v))) (AT.cls (fT (sumE u v))) (beta (sumE u v))))
          (apPh (AS.cls (sumE u v)) (OS.add (AS.cls u) (AS.cls v)) (OS.sy (OS.add (AS.cls u) (AS.cls v)) (AS.cls (sumE u v)) (OS.add-beta u v)))))) ;
  lawM (u v : AS.Term) : C.El Nl (AT.IdQ (OT.mul (ph (AS.cls u)) (ph (AS.cls v))) (ph (OS.mul (AS.cls u) (AS.cls v)))) =
   OT.tr (OT.mul (ph (AS.cls u)) (ph (AS.cls v))) (OT.mul (AT.cls (fT u)) (ph (AS.cls v))) (ph (OS.mul (AS.cls u) (AS.cls v)))
    (OT.mulL (ph (AS.cls u)) (AT.cls (fT u)) (ph (AS.cls v)) (beta u))
    (OT.tr (OT.mul (AT.cls (fT u)) (ph (AS.cls v))) (OT.mul (AT.cls (fT u)) (AT.cls (fT v))) (ph (OS.mul (AS.cls u) (AS.cls v)))
      (OT.mulR (AT.cls (fT u)) (ph (AS.cls v)) (AT.cls (fT v)) (beta v))
      (OT.tr (OT.mul (AT.cls (fT u)) (AT.cls (fT v))) (AT.cls (mulE (fT u) (fT v))) (ph (OS.mul (AS.cls u) (AS.cls v)))
        (OT.mul-beta (fT u) (fT v))
        (OT.tr (AT.cls (mulE (fT u) (fT v))) (ph (AS.cls (mulE u v))) (ph (OS.mul (AS.cls u) (AS.cls v)))
          (OT.tr (AT.cls (mulE (fT u) (fT v))) (AT.cls (fT (mulE u v))) (ph (AS.cls (mulE u v)))
             (OT.ofEq (AT.cls (mulE (fT u) (fT v))) (AT.cls (fT (mulE u v))) (apH {AT.Term} {AT.Q} AT.cls (symH (fmul u v))))
             (OT.sy (ph (AS.cls (mulE u v))) (AT.cls (fT (mulE u v))) (beta (mulE u v))))
          (apPh (AS.cls (mulE u v)) (OS.mul (AS.cls u) (AS.cls v)) (OS.sy (OS.mul (AS.cls u) (AS.cls v)) (AS.cls (mulE u v)) (OS.mul-beta u v)))))) ;
  lawK (c : R.R) : C.El Nl (AT.IdQ (AT.cls (cst c)) (ph (AS.cls (cst c)))) =
   OT.tr (AT.cls (cst c)) (AT.cls (fT (cst c))) (ph (AS.cls (cst c)))
    (OT.ofEq (AT.cls (cst c)) (AT.cls (fT (cst c))) (apH {AT.Term} {AT.Q} AT.cls (symH (fcst c))))
    (OT.sy (ph (AS.cls (cst c))) (AT.cls (fT (cst c))) (beta (cst c))) ;
  module HO = CHomData[a].HomOf[R, encK, pe, addO, mulO, s, t, Phi] ;
  module DA = HO.Bin[addO s, addO t].DataA[elimP3 s, setQi t, lawA] ;

 } ;
} ;
