-- CCompC.seg (canonicity-45; COBAR.md "Prop 58"): global codes for total E1:
-- the composite of a global code io : F' -> F with a global code w : F -> t
-- is a global code F' -> t (naturality from the two).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module CC2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (F F' t : SX.Over[R].Presentation)
  (io : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[F', F].M K)
  (ion : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[F', F].M K) (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[F', F].res J K v (io J)) (io K))
  (w : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[F, t].M K)
  (wn : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[F, t].M K) (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[F, t].res J K v (w J)) (w K)) {
 module CM = CCopy[a].ConcC[R, encK, pe].CM ;
 module FF = CM.MO.Fn[F', t] ;
 cw (J : Ob) (f0 : CM.MO.Fn[F', F].M J) (h : CM.MO.Fn[F, t].M J) : FF.M J = CM.MO.Cmp[F', F, t, J, f0, h].cmp ;
 cres (J K : Ob) (v : Hom K J) (f0 : CM.MO.Fn[F', F].M J) (h : CM.MO.Fn[F, t].M J)
  : Id (FF.M K) (FF.res J K v (cw J f0 h)) (cw K (CM.MO.Fn[F', F].res J K v f0) (CM.MO.Fn[F, t].res J K v h)) =
  FF.mExt K (FF.res J K v (cw J f0 h)) (cw K (CM.MO.Fn[F', F].res J K v f0) (CM.MO.Fn[F, t].res J K v h))
   (refl (FF.fpOf K (cw K (CM.MO.Fn[F', F].res J K v f0) (CM.MO.Fn[F, t].res J K v h)))) ;
 -- the composite global code (the form of CCmp's Pre.pre at w)
 module GF = CM.MO.Fn[F', F] ;
 c (K : Ob) : FF.M K = cw K (GF.res K K (idH K) (io K)) (w K) ;
 cn (J K : Ob) (v : Hom K J) : Id (FF.M K) (FF.res J K v (c J)) (c K) =
  transH (cres J K v (GF.res J J (idH J) (io J)) (w J))
   (transH (apH {GF.M J} {FF.M K} (\ f0 -> cw K (GF.res J K v f0) (CM.MO.Fn[F, t].res J K v (w J))) (ion J J (idH J)))
     (transH (apH {GF.M K} {FF.M K} (\ f0 -> cw K f0 (CM.MO.Fn[F, t].res J K v (w J))) (transH (ion J K v) (symH (ion K K (idH K)))))
       (apH {CM.MO.Fn[F, t].M K} {FF.M K} (cw K (GF.res K K (idH K) (io K))) (wn J K v)))) ;
} ;
