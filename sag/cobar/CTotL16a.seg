-- CTotL16a.seg (canonicity-45; SIMPLIFIED.md step 4, COBAR.md "Lemma 16"):
-- Lemma 16 at the total site, the frame: for A with a levelwise fibration
-- structure of U A over U G, DAC := (D A)[tau_G] is D-modal, i.e.
-- tau_DAC : DAC -> (D DAC)[tau_G] is a G1 EquivOp, given the zig homotopy
-- (D tau_A)[tau_G] ~ tau_DAC at the total site (module parameter here;
-- CTotL16b.. build it).
--   dTau     Cor 15 (CTotC15) pulled back along tau_G (CHSub.subEq), as a
--            natural map DAC -> B2 with B2 = (D DAC)[tau_G]
--   tauD     Lemma 14's tau at DAC (CTotC15.tauM at DAC), as a natural map
--   lemma16  the transfer (GHtpyEq at the total site's FT) along the zig
-- No new axioms beyond the named premises (fe) and the module parameter.

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module L16a (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module CA = CTotC15[a, vl, l].C15[C, G, A] ;
 module LB = CA.LB ;
 DAC : LB.P.PTy[LB.GP] = LB.Bt ;
 module CD = CTotC15[a, vl, l].C15[C, G, DAC] ;
 B2 : LB.P.PTy[LB.GP] = CD.LB.Bt ;
 module TR = LB.TR ;
 module G1 = TR.G1 ;
 module DGc = CA.P13.DF ;
 tauS : G1.GB.GPre[l].PS.PSub[LB.GP, DGc.DG] = LB.TC.toPS G LB.D.DCtx LB.D.tauS ;
 module HS = G1.GB.CHSub[l].HSub[LB.GP, DGc.DG, tauS, DGc.DA.DTy, DGc.DB.DTy, DGc.Df] ;
 chkA : Id (LB.P.PTy[LB.GP]) (G1.GB.GPre[l].PS.subTy LB.GP DGc.DG DGc.DA.DTy tauS) DAC = refl DAC ;
 chkB : Id (LB.P.PTy[LB.GP]) (G1.GB.GPre[l].PS.subTy LB.GP DGc.DG DGc.DB.DTy tauS) B2 = refl B2 ;
 module HO1 = G1.GB.CHtpyOps[l] ;
 module D = LB.D ;
 module DA = DGc.DA ;
 module DB = DGc.DB ;
 GP : LB.P.PCtx = LB.GP ;
 -- D tau_A pulled back along tau_G: u |-> D tau_A at the point tau g
 module DTN (Y X : LB.TC.TOb) (h : LB.TC.THm Y X) (g : W0.Ix (GP.ob X)) (g' : W0.Ix (GP.ob Y))
  (e : Id (W0.Ix (GP.ob Y)) (GP.act Y X h g) g') (u : W0.Ix (DAC.tob X g)) {
  d : D.Ob' X.1 X.2 = D.tau X.1 X.2 g ;
  d' : D.Ob' Y.1 Y.2 = D.tau Y.1 Y.2 g' ;
  ed : Id (D.Ob' Y.1 Y.2) (D.act Y.1 X.1 h.1 Y.2 X.2 h.2 d) d' = LB.P.ntEq GP DGc.DG tauS Y X h g g' e ;
  module M1 = DGc.DM[X.1, X.2, d, u] ;
  module TBb = DB.TB[Y.1, X.1, h.1, Y.2, X.2, h.2, d, d', ed, M1.res] ;
  module TBa = DA.TB[Y.1, X.1, h.1, Y.2, X.2, h.2, d, d', ed, u] ;
  module M2 = DGc.DM[Y.1, Y.2, d', TBa.res] ;
  nat : Id (W0.Ix (B2.tob Y g')) (B2.tact Y X h g g' e M1.res) M2.res =
   DB.tob-eq Y.1 Y.2 d' TBb.res M2.res (\ q l ->
    DB.pr-inj q.2.1 q.2.2.2.1 (d'.1 q l) (TBb.res.1 q l) (M2.res.1 q l)
     (transH (TBb.pc q l)
       (transH (M1.pc (TBb.sh q) l)
         (transH (apH (CA.tauM.mE (q.2.1, q.2.2.2.1)) (symH (TBa.pc q l)))
           (symH (M2.pc q l)))))) ;
 } ;
 dTau : HO1.NMap[GP, DAC, B2] =
  new HO1.NMap[GP, DAC, B2, \ X g u -> DGc.DM[X.1, X.2, D.tau X.1 X.2 g, u].res, \ Y X h g g' e u -> DTN[Y, X, h, g, g', e, u].nat] ;
 -- tau on DAC
 tauD : HO1.NMap[GP, DAC, B2] =
  new HO1.NMap[GP, DAC, B2, \ X g u -> CD.LB.TA.tauA X.1 X.2 g u,
   \ Y X h g g' e u -> CD.LB.NatE[Y.1, X.1, h.1, Y.2, X.2, h.2, g, u].law g' e (LB.P.ntEq GP DGc.DG tauS Y X h g g' e)] ;
 module LRt = G1.FT.GCLocBoundRetr[l] ;
 module TA = G1.GB.GPre[l].TyL[GP, DAC] ;
 module TB = G1.GB.GPre[l].TyL[GP, B2] ;
 dM : G1.GB.CPartial[l].PMap[GP, DAC, B2] = LRt.Map[GP, DAC, B2, dTau].pmap ;
 module HC = G1.GB.CHFibCart[l, l].HCart[GP, DAC, B2, dM, GP, DAC, B2, HS.SM.subMap,
     \ W d -> d, \ V W g0 d -> refl (GP.act V W g0 d),
     \ W v -> v, \ W v -> refl (TB.pr1 W v), \ V W g0 v -> refl (TB.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TB.pr X x u),
     \ W v -> v, \ W v -> refl (TA.pr1 W v), \ V W g0 v -> refl (TA.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TA.pr X x u),
     \ W v -> HS.SM.SA.mV-inj W (dM.mE W v) (HS.SM.subMap.mE W v) (refl (TA.pr1 W v)) (symH (HS.SM.mE-V W v))] ;
 module Main (fb : TR.G0.GB.CLine[l].Lines[LB.UG, LB.UA].Fib)
  (zig : G1.GB.GPre[l].PS.PEl[G1.GB.GPre[l].PS.extP GP DAC, HO1.HT[GP, DAC, B2, dTau, tauD].PT.PathP]) {
  module MA = CA.Main[fb] ;
  eD : G1.GB.CEquiv[l].EquivOp GP DAC B2 dM = HC.moveEq (HS.subEq MA.cor15) ;
  fD : G1.GB.CLine[l].Lines[GP, DAC].Fib = CA.LG.Out[CA.LF.lemma12F fb].fbB ;
  fbU : TR.G0.GB.CLine[l].Lines[CD.LB.UG, CD.LB.UA].Fib = CA.LG.Out[CA.LF.lemma12F fb].fbU ;
  fB2 : G1.GB.CLine[l].Lines[GP, B2].Fib = CD.LG.Out[CD.LF.lemma12F fbU].fbB ;
  -- Lemma 16: DAC is D-modal
  lemma16 : G1.GB.CEquiv[l].EquivOp GP DAC B2 (LRt.Map[GP, DAC, B2, tauD].pmap) =
   G1.FT.GHtpyEq[l].HE[GP, (DAC, fD), (B2, fB2), dTau, tauD, zig, eD].htpyEq ;
 } ;
} ;
