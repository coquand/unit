-- CCmpK7.seg (canonicity-c2; (K) for cmpI, part 7): the agreement of the two
-- homs F2 -> y of a point of nil.H at Phi_k (cx), k = 1, 2 (CCmpK6.Cmp).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module K7 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K6m = CCmpK6[a].K6[R, encK, pe, y] ;
 module K5m = K6m.K5m ;
 module K4m = K5m.K4m ;
 module K3m = K5m.K3m ;
 module E1m = K5m.E1m ;
 module U13m = K5m.U13m ;
 module CI = K5m.CI ;
 Nl : C.Ctx = C.nil ;
 H : C.Ty Nl = K5m.H ;
 GH : C.Ctx = K5m.GH ;
 QY : C.Ty Nl = K5m.QY ;
 QA : C.Ty Nl = K5m.QA ;
 QYh : C.Ty GH = K5m.QYh ;
 cx : C.El Nl E1m.QA = K5m.cx ;

 module CM = K4m.CM ;
 Phi1 : C.El Nl (OV.Fun Nl E1m.QA QA) = CM.II.I1.SM.Phi ;
 Phi2 : C.El Nl (OV.Fun Nl E1m.QA QA) = CM.II.I2.SM.Phi ;
 cP1 : C.El Nl QA = OV.app Nl E1m.QA QA Phi1 cx ;
 cP2 : C.El Nl QA = OV.app Nl E1m.QA QA Phi2 cx ;
 module P01 = CAppRd[a].App0[E1m.QA, QA, Phi1, cx] ;
 module P02 = CAppRd[a].App0[E1m.QA, QA, Phi2, cx] ;
 lA1 (K : Ob) : (o : Top) (h : V1.Ix (H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) (K3m.m1.nfun K o (CI.nmap.nfun K o h.1)) ((U13m.ZA.apC cP1).eob K (o, h)) =
  split { tt -> \ h -> symH (transH (U13m.ZA.rdF cP1 K (tt, h)) (apH {V1.Ix (QA.1.tob K tt)} {V1.Ix (QY.1.tob K tt)} (\ u -> U13m.BZ.hv K tt h.1.1 u) (P01.rd K tt))) } ;
 lB1 (K : Ob) : (o : Top) (h : V1.Ix (H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) (K3m.m1.nfun K o (CI.nmap.nfun K o h.2.1)) ((U13m.ZB.apC cP1).eob K (o, h)) =
  split { tt -> \ h -> symH (transH (U13m.ZB.rdF cP1 K (tt, h)) (apH {V1.Ix (QA.1.tob K tt)} {V1.Ix (QY.1.tob K tt)} (\ u -> U13m.BZ.hv K tt h.2.1.1 u) (P01.rd K tt))) } ;
 lA2 (K : Ob) : (o : Top) (h : V1.Ix (H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) (K3m.m2.nfun K o (CI.nmap.nfun K o h.1)) ((U13m.ZA.apC cP2).eob K (o, h)) =
  split { tt -> \ h -> symH (transH (U13m.ZA.rdF cP2 K (tt, h)) (apH {V1.Ix (QA.1.tob K tt)} {V1.Ix (QY.1.tob K tt)} (\ u -> U13m.BZ.hv K tt h.1.1 u) (P02.rd K tt))) } ;
 lB2 (K : Ob) : (o : Top) (h : V1.Ix (H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) (K3m.m2.nfun K o (CI.nmap.nfun K o h.2.1)) ((U13m.ZB.apC cP2).eob K (o, h)) =
  split { tt -> \ h -> symH (transH (U13m.ZB.rdF cP2 K (tt, h)) (apH {V1.Ix (QA.1.tob K tt)} {V1.Ix (QY.1.tob K tt)} (\ u -> U13m.BZ.hv K tt h.2.1.1 u) (P02.rd K tt))) } ;
 g1 : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC cP1) (U13m.ZB.apC cP1)) =
  K6m.Cmp[K3m.m1, Phi1, \ K w -> lA1 K w.1 w.2, \ K w -> lB1 K w.1 w.2].res ;
 g2 : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC cP2) (U13m.ZB.apC cP2)) =
  K6m.Cmp[K3m.m2, Phi2, \ K w -> lA2 K w.1 w.2, \ K w -> lB2 K w.1 w.2].res ;
 -- moved along Phi_k's beta: the generators of F2
 module SM1 = CM.II.I1.SM ;
 module SM2 = CM.II.I2.SM ;
 h1 : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC (SM1.AT.cls (SM1.SB.sbT (var (inr tt))))) (U13m.ZB.apC (SM1.AT.cls (SM1.SB.sbT (var (inr tt)))))) =
  K5m.Gen[cP1, SM1.AT.cls (SM1.SB.sbT (var (inr tt))), SM1.beta (var (inr tt)), g1].res ;
 h2 : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC (SM2.AT.cls (SM2.SB.sbT (var (inr tt))))) (U13m.ZB.apC (SM2.AT.cls (SM2.SB.sbT (var (inr tt)))))) =
  K5m.Gen[cP2, SM2.AT.cls (SM2.SB.sbT (var (inr tt))), SM2.beta (var (inr tt)), g2].res ;
} ;
