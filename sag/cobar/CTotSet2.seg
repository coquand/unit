-- CTotSet2.seg (canonicity-c2; "D preserves h-sets", part 2): for A a
-- set, R = D (IdA) pulled back along phi2 is a proposition over
-- D G . D A . D A (CTotDProp4; levelwise hypothesis by CTotUProp3).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST2 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module S1 = CTotSet1[a, vl, l].ST1[C, G, A] ;
 module G1 = S1.G1 ;
 module OV = S1.OV ;
 module PN1 = S1.PN1 ;
 E1 : G1.fibCwF-T.Ctx = S1.E1 ;
 IdA : G1.fibCwF-T.Ty E1 = S1.IdA ;
 GAA : CTPsh[a, vl, l].TPshOf[C].TCtx = S1.GAA ;
 K : G1.fibCwF-T.Ctx = S1.K ;
 module At (pS : G1.fibCwF-T.El E1 (PN1.isProp E1 IdA)) {
  module DP = CTotDProp4[a, vl, l].DP4[C, GAA, IdA] ;
  module UPm = CTotUProp3[a, vl, l].UP3[C, E1, IdA] ;
  propD : G1.fibCwF-T.El DP.P3.DG (PN1.isProp DP.P3.DG DP.P3.DAT) = DP.At[UPm.At[pS].isPropU].isPropD ;
  R : G1.fibCwF-T.Ty K = G1.fibCwF-T.subT K DP.P3.DG DP.P3.DAT S1.phi2 ;
  DGd : G1.fibCwF-T.Ctx = DP.P3.DG ;
  DTd : G1.fibCwF-T.Ty DGd = DP.P3.DAT ;
  ph2 : G1.fibCwF-T.Sub K DGd = S1.phi2 ;
  s1 : G1.fibCwF-T.El K (G1.fibCwF-T.subT K DGd (PN1.isProp DGd DTd) ph2) = G1.fibCwF-T.subt K DGd (PN1.isProp DGd DTd) propD ph2 ;
  s2 : Id (G1.fibCwF-T.Ty K) (G1.fibCwF-T.subT K DGd (PN1.isProp DGd DTd) ph2) (PN1.isProp K R) =
   PN1.isProp-ov K DGd DTd ph2 R (refl R) ;
  propR : G1.fibCwF-T.El K (PN1.isProp K R) = OV.trE K (G1.fibCwF-T.subT K DGd (PN1.isProp DGd DTd) ph2) (PN1.isProp K R) s2 s1 ;
 } ;
} ;
