-- CDEv3.seg (canonicity-c2; (d), part 3): the binary step of CDEv2's
-- recursion, first half: the operation applied to the two Ids of the
-- arguments (CCmpU18.Ap2).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module DE3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) {
 module DE2m = CDEv2[a].DE2[R, encK, pe, s, y] ;
 module D = DE2m.D ;
 module HZ = D.HZ ;
 module AS = HZ.AS ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = D.HS ;
 QY : C.Ty Nl = D.QY ;
 D1 : C.Ctx = D.D1 ;
 QYd : C.Ty D1 = D.QYd ;
 Tm : U a = DE2m.Tm ;
 module U19m = DE2m.U19m ;
 U16D : C.Ctx = DE2m.U16D ;
 HE (t : Tm) : C.Ty D1 = DE2m.HE t ;
 pkN (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (D.pk I w)) (D.pk J (D1.act J I f w)) = DE2m.pkN J I f w ;
 module Bin1 (opS : C.El Nl (OV.Fun Nl AS.Qt (OV.Fun Nl AS.Qt AS.Qt))) (opT : C.El Nl (OV.Fun Nl QY (OV.Fun Nl QY QY)))
   (dk : (K : Ob) (w : V1.Ix (U16D.ob K)) -> V1.Ix (HZ.B0.BinOf[opS, opT].DataBin.1.tob K (U19m.U16m.sAn K w)))
   (dkN : (J I : Ob) (f : Hom J I) (w : V1.Ix (U16D.ob I))
     -> Id (V1.Ix (HZ.B0.BinOf[opS, opT].DataBin.1.tob J (U19m.U16m.sAn J (U16D.act J I f w))))
          ((C.subT U16D U19m.U16m.Gh HZ.B0.BinOf[opS, opT].DataBin U19m.U16m.sA).1.tact J I f w (U16D.act J I f w) (refl (U16D.act J I f w)) (dk I w)) (dk J (U16D.act J I f w)))
   (p q tpq : Tm) (bt : C.El Nl (IJ.IdT Nl AS.Qt (OV.app Nl AS.Qt AS.Qt (OV.app Nl AS.Qt (OV.Fun Nl AS.Qt AS.Qt) opS (AS.AX.cls p)) (AS.AX.cls q)) (AS.AX.cls tpq)))
   (hp : C.El D1 (HE p)) (hq : C.El D1 (HE q))
   (rq : (K : Ob) (z : V1.Ix (HS.1.tob K tt)) -> Id (D.QK K (tt, z)) ((CCmpU18[a].OpH[D1, QY, opT, C.p Nl HS].P2[D.evT p, D.evT q].val).eob K (tt, z)) ((D.evT tpq).eob K (tt, z))) {
  module PB = U19m.PBk[opS, opT, dk, dkN, AS.AX.cls p, AS.AX.cls q, AS.AX.cls tpq, bt, D.pk, pkN, D.apZ, \ c K w -> D.U13m.ZA.rdF c K w] ;
  module A2 = CCmpU18[a].Ap2[D1, QY, opT, C.p Nl HS] ;
  a2 : C.El D1 (IJ.IdT D1 QYd (A2.O.P2[D.apZ (AS.AX.cls p), D.apZ (AS.AX.cls q)].val) (A2.O.P2[D.evT p, D.evT q].val)) =
   A2.ap2 (D.apZ (AS.AX.cls p)) (D.evT p) (D.apZ (AS.AX.cls q)) (D.evT q) hp hq ;
 } ;
} ;
