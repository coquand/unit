-- CDFw2.seg (canonicity-c2; (d)(1), part 2): the generators of x.u, old
-- (emb j) or new (newI j), and the lookups in CSolT's valuation app k xp vv
-- at either kind (metatheory, by recursion on k).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module Fw2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F1 = CDFw1[a].Fw1[R, encK, pe, x, u, y] ;
 module S1 = F1.S1 ;
 module EV = S1.EV ;
 n : Nat = S1.n ;
 Fk (k : Nat) : U a = SX.Fin (Arith[a].plus k n) ;
 emb (k : Nat) (j : SX.Fin n) : Fk k = SX.emb n k j ;
 newI : (k : Nat) -> SX.Fin k -> Fk k = split {
  zero -> \ j -> absurd (Fk zero) j ;
  suc k | r -> split { inl j -> inl (r j) ; inr t -> inr t } } ;
 Cls (k : Nat) (i : Fk k) : U a = Arith[a].Plus ((j : SX.Fin n) * Id (Fk k) i (emb k j)) ((j : SX.Fin k) * Id (Fk k) i (newI k j)) ;
 liftC (k : Nat) (i : Fk k) : Cls k i -> Cls (suc k) (inl i) = split {
  inl c -> inl (c.1, apH {Fk k} {Fk (suc k)} (\ v -> inl v) c.2) ;
  inr c -> inr (inl c.1, apH {Fk k} {Fk (suc k)} (\ v -> inl v) c.2) } ;
 cls : (k : Nat) (i : Fk k) -> Cls k i = split {
  zero -> \ i -> inl (i, refl i) ;
  suc k | r -> split { inl i -> liftC k i (r i) ; inr t -> inr (inr t, refl (inr t)) } } ;
 -- lookups
 lkOld : (k : Nat) (K : Ob) (xp : V1.Ix ((EV.Gk n).ob K)) (vv : S1.PK k K) (j : SX.Fin n)
   -> Id (EV.QK K) (EV.lk (Arith[a].plus k n) (emb k j) K (S1.app k K xp vv)) (EV.lk n j K xp) = split {
  zero -> \ K xp vv j -> refl (EV.lk n j K xp) ;
  suc k | r -> \ K xp vv j -> r K xp vv.1 j } ;
 lkNew : (k : Nat) (K : Ob) (xp : V1.Ix ((EV.Gk n).ob K)) (g : Fk k -> EV.QK K) (j : SX.Fin k)
   -> Id (EV.QK K) (EV.lk (Arith[a].plus k n) (newI k j) K (S1.app k K xp (F1.vt k K g))) (g (newI k j)) = split {
  zero -> \ K xp g j -> absurd (Id (EV.QK K) (EV.lk (Arith[a].plus zero n) (newI zero j) K (S1.app zero K xp (F1.vt zero K g))) (g (newI zero j))) j ;
  suc k | r -> \ K xp g -> split {
   inl j -> r K xp (\ v -> g (inl v)) j ;
   inr t -> F1.DE.lkTT (Arith[a].plus k n) K g t } } ;
} ;
