-- CCmpY3.seg (canonicity-45; SIMPLIFIED.md step 6): D of the comparison
-- yo F2 -> yo F1 x yo F1 is an equivalence (as types over the terminal
-- context of the total site, c2's CtxTy), from the Hom-side equivalences
-- at every presentation: each moved to C's codes (CCmpY2), assembled at
-- the levelwise site (CCopy3), Proposition 13 (CTotP13o).  The Hom-side
-- data (al, its equivalence structure, its agreement with C's comparison)
-- are module parameters: c2's internal comparison discharges them.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;

module Fin (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) {
 module BS = CCmpY[a].CmpBase[R, encK, pe] ;
 module EQ = CCopy3[a].EqC[R, encK, pe, BS.PD.UG, BS.PD.UA, BS.PD.UB, BS.PD.Uf] ;
 ef : BS.CC.G0.GB.CEquiv[a+].EquivOp BS.PD.UG BS.PD.UA BS.PD.UB BS.PD.Uf =
  EQ.eqG0 (\ y -> CCmpY2[a].Sides[R, encK, pe, y].Move[al y, eqal y, commH y].eqy) ;
 module P13 = CTotP13o[a, a+, a+].P13[BS.CM.IC, BS.CT.T1, BS.O2.Y1T, BS.O11.Y1T, BS.cmpF] ;
 dcmp : BS.TR.G1.GB.CEquiv[a+].EquivOp P13.DF.DG P13.DF.DA.DTy P13.DF.DB.DTy P13.DF.Df = P13.prop13 ef ;
} ;
