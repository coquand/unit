-- CReadOp.seg (canonicity-45; COBAR.md "comparison"): a hom z : F2 -> y'
-- (variable of nil.HomT(F2, y')) evaluated at closed classes, moved along
-- closed Ids of classes (as c2's CCmpU14.Gen), read as path homotopies on
-- HomT(F2, y') (CClRd.PRd): the pieces of CReadA's hOp.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module V0 = V[a] ;

module ZE (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) {
 module HZ = CHomT3[a].HomP[R, encK, pe].Hom[s, y] ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = HZ.HomT ;
 GH : C.Ctx = C.ext Nl HS ;
 pk (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HS.1.tob K w.1) = w.2 ;
 pkN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pk I w)) (pk J (GH.act J I f w)) =
  L.tact-irr Nl HS.1 J I f w.1 w.1 (refl w.1) (L.ntEq GH Nl (L.pP Nl HS.1) J I f w (GH.act J I f w) (refl (GH.act J I f w))) w.2 ;
 module U13 = CUG13[a].UG13[R, encK, pe, s, y, HS, pk, pk, pkN, pkN] ;
 module ZA = U13.ZA ;
 QA : C.Ty Nl = U13.QA ;
 QYh : C.Ty GH = U13.QYh ;
 QH : C.Ty GH = U13.QH ;
 -- z moved along a closed Id of classes
 module Mv (cp cv : C.El Nl QA) (bt : C.El Nl (IJ.IdT Nl QA cp cv)) {
  wid : C.El GH (IJ.IdT GH QH (OV.wkE Nl HS QA cp) (OV.wkE Nl HS QA cv)) =
   OV.trE GH (C.subT GH Nl (IJ.IdT Nl QA cp cv) (C.p Nl HS)) (IJ.IdT GH QH (OV.wkE Nl HS QA cp) (OV.wkE Nl HS QA cv))
     (IJ.IdT-nat GH Nl QA cp cv (C.p Nl HS)) (C.subt GH Nl (IJ.IdT Nl QA cp cv) bt (C.p Nl HS)) ;
  atA (c : C.El Nl QA) : C.El GH QYh = PT.atv GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) ZA.fC) (OV.wkE Nl HS QA c) ;
  rdA (c : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) ((atA c).eob K w) ((ZA.apC c).eob K w) =
   transH (CAppRd[a].trE-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl HS QA c))) QYh
            (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl HS QA c))
            (C.subt GH (C.ext GH QH) (OV.wkT GH QH QYh) (OV.bod GH QH (OV.wkT GH QH QYh) ZA.fC) (C.sec GH QH (OV.wkE Nl HS QA c))) K w)
    (transH (CAppRd[a].same-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl HS QA c))) QYh
              (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl HS QA c)) K w (refl (QYh.1.tob K w))
              ((OV.bod GH QH (OV.wkT GH QH QYh) ZA.fC).eob K (w, c.eob K w.1)))
      (transH (QinvEq[a, a+].FunOf[GH, QH, QYh, ZA.nm].bod-eq K (w, c.eob K w.1)) (symH (ZA.rdF c K w)))) ;
  res : C.El GH (IJ.IdT GH QYh (ZA.apC cp) (ZA.apC cv)) =
   CCmpU14[a].rwId GH QYh (atA cp) (ZA.apC cp) (atA cv) (ZA.apC cv) (rdA cp) (rdA cv)
    (PT.apM GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) ZA.fC) (OV.wkE Nl HS QA cp) (OV.wkE Nl HS QA cv) wid) ;
 } ;
 QY : C.Ty Nl = U13.QY ;
 -- an Id over nil.HomT between two elements of Q_y, as a homotopy of maps HomT -> Q_y
 module Rd (a0 b0 : C.El GH QYh) (e : C.El GH (IJ.IdT GH QYh a0 b0)) {
  module PR = CClRd[a, a+].PRd[Nl, HS.1, QY, a0, b0, e] ;
 } ;
} ;

-- at F2: the datum of the addition of z at (cls x1, cls x2, cls (x1 + x2))
module ZD (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module FR = CSubst[a].Free[R] ;
 module Z = ZE[R, encK, pe, FR.F2, y] ;
 module U20 = CCmpU20[a].U20[R, encK, pe, y] ;
 module U16 = CCmpU16[a].U16[R, encK, pe, y] ;
 module AS = Z.HZ.AS ;
 module AT = Z.HZ.AT ;
 q1 : C.El C.nil Z.QA = AS.AX.cls FR.x1 ;
 q2 : C.El C.nil Z.QA = AS.AX.cls FR.x2 ;
 module AddD {
  q3 : C.El C.nil Z.QA = AS.AX.cls (sumE FR.x1 FR.x2) ;
  module PO = CCmpU17[a].PrOf[Z.QA, AS.O.addQ, q1, q2, q3, AS.AX.Ops[AS.Q1.setQ, AS.Q1.setQi, AS.Q3.elim2, AS.Q3.elim2-beta].add-beta FR.x1 FR.x2] ;
  module WQ = CCmpU17[a].WP[Z.QA, AS.O.addQ, q1, q2, q3, PO.pr] ;
  module DB = U16.DB[AS.O.addQ, AT.O.addQ, U20.dkA, U20.dkAN, WQ.wt] ;
  res : C.El Z.GH (IJ.IdT Z.GH Z.QYh DB.e1 DB.e3) = DB.res ;
 } ;
 module MulD {
  q3 : C.El C.nil Z.QA = AS.AX.cls (mulE FR.x1 FR.x2) ;
  module PO = CCmpU17[a].PrOf[Z.QA, AS.O.mulQ, q1, q2, q3, AS.AX.Ops[AS.Q1.setQ, AS.Q1.setQi, AS.Q3.elim2, AS.Q3.elim2-beta].mul-beta FR.x1 FR.x2] ;
  module WQ = CCmpU17[a].WP[Z.QA, AS.O.mulQ, q1, q2, q3, PO.pr] ;
  module DB = U16.DB[AS.O.mulQ, AT.O.mulQ, U20.dkM, U20.dkMN, WQ.wt] ;
  res : C.El Z.GH (IJ.IdT Z.GH Z.QYh DB.e1 DB.e3) = DB.res ;
 } ;
} ;
