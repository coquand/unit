-- CIdPull.seg (canonicity-45; COBAR.md "Prop 58"): at the total site, an
-- internal Id e : a = b between elements of a closed context-type
-- B = Y1T(Z) over Gamma, at the point sigma(z) of a context map
-- sigma : nil.A -> Gamma.Id(a, b), read as a path homotopy over nil.A
-- between a . sigma and b . sigma (the values of e's Yoneda Id fibre, which
-- do not depend on the point since Y1T's fibres and action do not).
-- With CRestrHT's RHt this gives the homotopy at a copy.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module IP (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module G1 = CC.TR.G1 ;
 module GB = G1.GB ;
 module PS1 = GB.GPre[a+].PS ;
 module HO1 = GB.CHtpyOps[a+] ;
 module CT = CTotCtxTy[a, a+, a+].CtxTy[CC.CM.IC] ;
 C1 : CwF.CwF[a++] = G1.fibCwF-T ;
 TO : U a+ = CTotCat[a, a+, a+].TotOf[CC.CM.IC].TOb ;
 TH (Y X : TO) : U a+ = CTotCat[a, a+, a+].TotOf[CC.CM.IC].THm Y X ;
 module At (Zc : CC.CM.TP.TCtx) (fb : GB.CLine[a+].Lines[CT.P1, CT.Of[Zc].Y1T].Fib) (Gm : C1.Ctx)
   (a0 b0 : C1.El Gm (C1.subT Gm C1.nil (CT.Of[Zc].Y1T, fb) (C1.eps Gm)))
   (A1 : PS1.PTy[CT.P1])
   (sg : PS1.PSub[PS1.extP CT.P1 A1, PS1.extP Gm (G1.fibId-T.IdT Gm (C1.subT Gm C1.nil (CT.Of[Zc].Y1T, fb) (C1.eps Gm)) a0 b0).1]) {
  B1 : PS1.PTy[CT.P1] = CT.Of[Zc].Y1T ;
  Y : C1.Ty Gm = C1.subT Gm C1.nil (B1, fb) (C1.eps Gm) ;
  X : PS1.PTy[Gm] = (G1.fibId-T.IdT Gm Y a0 b0).1 ;
  Km : PS1.PCtx = PS1.extP Gm X ;
  EA : PS1.PCtx = PS1.extP CT.P1 A1 ;
  VB (V : TO) : U a+ = V1.Ix (Zc.ob V.1 V.2) ;
  module IY = G1.FT.GPosIdY[a+].IdY[Gm, Y.1, a0, b0] ;
  sx (W : TO) (z : V1.Ix (EA.ob W)) : V1.Ix (Gm.ob W) = (sg.nt W z).1 ;
  sw (W : TO) (z : V1.Ix (EA.ob W)) : V1.Ix (X.tob W (sx W z)) = (sg.nt W z).2 ;
  eK (J I : TO) (h : TH J I) (z : V1.Ix (EA.ob I)) (z' : V1.Ix (EA.ob J)) (ee : Id (V1.Ix (EA.ob J)) (EA.act J I h z) z')
   : Id (V1.Ix (Km.ob J)) (Km.act J I h (sg.nt I z)) (sg.nt J z') = PS1.ntEq EA Km sg J I h z z' ee ;
  -- the two ends as maps A -> B
  mN (c : C1.El Gm Y) : HO1.NMap[CT.P1, A1, B1] = new HO1.NMap[CT.P1, A1, B1, \ W o v -> c.eob W (sx W (o, v)),
   \ J I h o o' ee v -> c.enat J I h (sx I (o, v)) (sx J (o', A1.tact J I h o o' ee v))
      (apH {V1.Ix (Km.ob J)} {V1.Ix (Gm.ob J)} (\ k2 -> k2.1) (eK J I h (o, v) (o', A1.tact J I h o o' ee v) (PS1.pair-act CT.P1 A1 J I h o o' ee v)))] ;
  mA : HO1.NMap[CT.P1, A1, B1] = mN a0 ;
  mB : HO1.NMap[CT.P1, A1, B1] = mN b0 ;
  module T = HO1.HT[CT.P1, A1, B1, mA, mB] ;
  module TB = GB.GPre[a+].TyL[CT.P1, B1] ;
  val (W : TO) (z : V1.Ix (EA.ob W)) (V : TO) (k : TH V W) (j : GB.IvP V) : VB V = (sw W z).1.1 V k j ;
  tv (W : TO) (z : V1.Ix (EA.ob W)) (V : TO) (k : TH V W) (j : GB.IvP V) : TB.EI V = TB.pr V (CT.P1.act V W k z.1) (val W z V k j) ;
  tn (W : TO) (z : V1.Ix (EA.ob W)) (V' V : TO) (g' : TH V' V) (k : TH V W) (j : GB.IvP V)
   : Id (TB.EI V') (TB.E.act V' V g' (tv W z V k j)) (tv W z V' (GB.compH V' V W k g') (GB.ivA V' V g' j)) =
   transH (TB.pr-tact V' V g' (CT.P1.act V W k z.1) (CT.P1.act V' V g' (CT.P1.act V W k z.1)) (refl (CT.P1.act V' V g' (CT.P1.act V W k z.1))) (val W z V k j))
    (transH (apH {V1.Ix (CT.P1.ob V')} {TB.EI V'} (\ p -> TB.pr V' p (Zc.act V'.1 V.1 g'.1 V'.2 V.2 g'.2 (val W z V k j))) (symH (CT.P1.act-o V' V W k g' z.1)))
      (apH {VB V'} {TB.EI V'} (TB.pr V' (CT.P1.act V' W (GB.compH V' V W k g') z.1)) ((sw W z).1.2.1 V' V g' k j))) ;
  e0E (W : TO) (z : V1.Ix (EA.ob W)) : Id (TB.EI W) (tv W z W (GB.idH W) (GB.ptH W GB.e0)) (T.aE W z) =
   transH (apH {V1.Ix (CT.P1.ob W)} {TB.EI W} (\ p -> TB.pr W p (val W z W (GB.idH W) (GB.ptH W GB.e0))) (CT.P1.act-id W z.1))
    (apH {VB W} {TB.EI W} (TB.pr W z.1) (transH ((sw W z).1.2.2.1 W (GB.idH W)) (apH {V1.Ix (Gm.ob W)} {VB W} (a0.eob W) (Gm.act-id W (sx W z))))) ;
  e1E (W : TO) (z : V1.Ix (EA.ob W)) : Id (TB.EI W) (tv W z W (GB.idH W) (GB.ptH W GB.e1)) (T.bE W z) =
   transH (apH {V1.Ix (CT.P1.ob W)} {TB.EI W} (\ p -> TB.pr W p (val W z W (GB.idH W) (GB.ptH W GB.e1))) (CT.P1.act-id W z.1))
    (apH {VB W} {TB.EI W} (TB.pr W z.1) (transH ((sw W z).1.2.2.2 W (GB.idH W)) (apH {V1.Ix (Gm.ob W)} {VB W} (b0.eob W) (Gm.act-id W (sx W z))))) ;
  path (W : TO) (z : V1.Ix (EA.ob W)) : V1.Ix (T.PT.tobP W z) =
   T.PT.mkPath W z (tv W z) (\ V' V g' k j -> tn W z V' V g' k j) (\ V k j -> refl (CT.P1.act V W k z.1)) (e0E W z) (e1E W z) ;
 enat (J I : TO) (h : TH J I) (z : V1.Ix (EA.ob I)) (z' : V1.Ix (EA.ob J)) (ee : Id (V1.Ix (EA.ob J)) (EA.act J I h z) z')
   : Id (V1.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z') =
   T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z') (\ V f i ->
    transH (apH {V1.Ix (CT.P1.ob V)} {TB.EI V} (\ p -> TB.pr V p (val I z V (GB.compH V J I h f) i))
       (transH (CT.P1.act-o V J I h f z.1) (apH {V1.Ix (CT.P1.ob J)} {V1.Ix (CT.P1.ob V)} (CT.P1.act V J f) (apH {V1.Ix (EA.ob J)} {V1.Ix (CT.P1.ob J)} (\ z2 -> z2.1) ee))))
     (apH {VB V} {TB.EI V} (TB.pr V (CT.P1.act V J f z'.1))
       (transH (symH (apH {IY.TA.EI V} {VB V} (\ q -> q.2)
                 (IY.Tact[J, I, h, sx I z, Gm.act J I h (sx I z), refl (Gm.act J I h (sx I z)), sw I z].rdc V f i)))
         (apH {V1.Ix (Km.ob J)} {VB V} (\ k2 -> k2.2.1.1 V f i) (eK J I h z z' ee))))) ;
  res : PS1.PEl[EA, T.PT.PathP] = new PS1.PEl[EA, T.PT.PathP, path, enat] ;
} ;
} ;
