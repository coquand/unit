-- CTotL12Fib2.seg (canonicity-c2; SIMPLIFIED.md step 4): LEMMA 12 at the
-- total site, fibration half.  For a context G and a type A over it at
-- the total site of an internal category C: a fibration structure of U A
-- over U G at the levelwise site gives one of D A over D G at the total
-- site.  CTotL12Fib's assembly with the lift back (CTotPsi20 / 22) and the
-- levelwise input (CTotLvl4) at both ends.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module L12F (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LP = CTotL12Fib[a, vl, l].L12Fp[C, G, A] ;
 module TR = LP.TR ;
 module TC = LP.TC ;
 module DA = LP.DA ;
 module D = CobarI[a, vl, l].DOfI[C].DC[G] ;
 UG : TR.P0.PCtx = TR.RS.rC (TC.toP G) ;
 UA : TR.P0.PTy[UG] = TR.RS.rT (TC.toP G) A ;
 module ED (d : Bool) (comp : TR.G0.GB.CLine[l].Lines[UG, UA].CompK[TR.G0.GB.src d, TR.G0.GB.tgt d].Comp) {
  module EN = LP.End[d] ;
  module P20 = CTotPsi20[a, vl, l].Psi20[C, G, A, EN.e] ;
  module P22 = CTotPsi22[a, vl, l].Psi22[C, G, A, EN.e] ;
  bk : EN.BkTy = \ X x u -> P20.BK[X, x, u].bk ;
  bkMv : EN.BkMvTy bk = \ X x u -> P22.BM[X, x, u].bkMv ;
  al : TR.G0.GB.CPartial[l].ContrOp (TR.RS.rC (TC.toP EN.P13.TVT)) (TR.RS.rT (TC.toP EN.P13.TVT) EN.P13.SF') =
   CTotLvl4[a, vl, l].Lvl4[C, G, A, d].AL[comp].al ;
  comp1 : TR.G1.GB.CLine[l].Lines[LP.DG, DA.DTy].CompK[TR.G1.GB.src d, TR.G1.GB.tgt d].Comp = EN.MV[bk, bkMv, al].comp ;
 } ;
 -- LEMMA 12 (fibrancy half) at the total site
 lemma12F (fb : TR.G0.GB.CLine[l].Lines[UG, UA].Fib) : TR.G1.GB.CLine[l].Lines[TC.toP D.DCtx, DA.DTy].Fib =
  (ED[true, fb.1].comp1, ED[false, fb.2].comp1) ;
} ;
