-- Cobar.seg (canonicity-45; COBAR.md): the cobar construction D of
-- jonas.pdf Definition 10 in explicit form, on contexts.
--
-- (D G)_x at base stage X: families t over the index
--   q = (n , z , c : Ch n x z , J , g : J -> X , i : Coords n J)
-- and a proof l that i is a weight (i , l) : P_n(J), with values
--   t q l : (G.ob z).ob J
-- subject to (all as IdV codes, so that (D G)_x is a PCtx with V-coded
-- fibres):
--   natural in the base: (G z).act h (t (.. J g i) l) = t (.. J' (g h) (res i))
--   inner faces k <= n:  t (n+1 , c , d_k i) = t (n , comp k c , i)
--   top face:            t (n+1 , c , d_(n+1) i) = (act fm) (t (n , c' , i)),
--                        (z' , c' , fm) = drop c
-- The index is ONE V-coded Sigma (only the lands proof is a separate
-- argument, coded constantly: it is a proposition), so that equality of
-- elements is one funext plus propositions.
--   DCtx G : P.CCtx   with the base action (precompose g) and the C-action
--                     along g : x' -> x (rx)
--   at t n z c J g i  the family read at a weight i : Pn n J
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[a] ;
module VL = VLift[a, l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module DOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 CO : U a = P.CO ;
 CH (y x : CO) : U a = P.CH y x ;

 -- codes of the indices
 finV (r : Nat) : VA.V = VA.SigV VA.natV (\ j -> VA.IsTV (Ar.ltb j r)) ;
 coordV (n : Nat) (J : Ob) : VA.V = VA.PiV (finV (suc n)) (\ k -> homV J PB.Iv) ;

 idxV (x : CO) (X : Ob) : VA.V =
  VA.SigV VA.natV (\ n -> VA.SigV C.obV (\ z -> VA.SigV (K.chV n x z) (\ c ->
   VA.SigV obV (\ J -> VA.SigV (homV J X) (\ g -> coordV n J))))) ;
 Idx (x : CO) (X : Ob) : U a = VA.Ix (idxV x X) ;

 -- the weight condition of an index, a proposition
 LandsI (x : CO) (X : Ob) (q : Idx x X) : U a = PB.Lands q.2.2.2.1 q.2.2.2.1 (Wt.oneS q.1 q.2.2.2.1 q.2.2.2.2.2) (PB.idH q.2.2.2.1) ;

 -- Pi codes over an index code, and over a proposition
 piI (A : VA.V) (B : VA.Ix A -> W0.V) : W0.V = VL.PiS (VA.Ix A) (VL.encIx A) (VL.encIx-inj A) B ;
 piP (A : U a) (pA : isProp A) (B : A -> W0.V) : W0.V = VL.PiS A (\ u -> W0.emptyV) (\ u u' h -> pA u u') B ;

 -- Pi codes of propositions are propositions; identity codes are
 piIP (A : VA.V) (B : VA.Ix A -> W0.V) (h : (a : VA.Ix A) -> isProp (W0.Ix (B a))) : isProp (W0.Ix (piI A B)) =
  isProp-Pi (VA.Ix A) (\ a -> W0.Ix (B a)) h ;
 piPP (A : U a) (pA : isProp A) (B : A -> W0.V) (h : (u : A) -> isProp (W0.Ix (B u))) : isProp (W0.Ix (piP A pA B)) =
  isProp-Pi A (\ u -> W0.Ix (B u)) h ;
 idProp (A : W0.V) (u v : W0.Ix A) : isProp (W0.Ix (W0.IdV A u v)) = W0.isSetIx A u v ;

 isPropL (x : CO) (X : Ob) (q : Idx x X) : isProp (LandsI x X q) =
  PB.isProp-Lands q.2.2.2.1 q.2.2.2.1 (Wt.oneS q.1 q.2.2.2.1 q.2.2.2.2.2) (PB.idH q.2.2.2.1) ;

 module DC (G : P.CCtx) {
  -- the families
  tV (x : CO) (X : Ob) : W0.V =
   piI (idxV x X) (\ q -> piP (LandsI x X q) (isPropL x X q) (\ l -> (G.ob q.2.1).ob q.2.2.2.1)) ;
  T (x : CO) (X : Ob) : U l = W0.Ix (tV x X) ;

  -- reading at a weight
  at (x : CO) (X : Ob) (t : T x X) (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J)
   : W0.Ix ((G.ob z).ob J) = t (n, z, c, J, g, i.1) i.2 ;

  -- naturality in the base: index (q , J' , h : J' -> J)
  natIdxV (x : CO) (X : Ob) : VA.V = VA.SigV (idxV x X) (\ q -> VA.SigV obV (\ J' -> homV J' q.2.2.2.1)) ;
  natA (x : CO) (X : Ob) (r : VA.Ix (natIdxV x X)) : W0.V = (G.ob r.1.2.1).ob r.2.1 ;
  natL (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (natIdxV x X)) (l : LandsI x X r.1) : W0.Ix (natA x X r) =
   (G.ob r.1.2.1).act r.2.1 r.1.2.2.2.1 r.2.2 (t r.1 l) ;
  natR (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (natIdxV x X)) (l : LandsI x X r.1) : W0.Ix (natA x X r) =
   at x X t r.1.1 r.1.2.1 r.1.2.2.1 r.2.1 (PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2)
    (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res) ;
  natB (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (natIdxV x X)) : W0.V =
   piP (LandsI x X r.1) (isPropL x X r.1) (\ l -> W0.IdV (natA x X r) (natL x X t r l) (natR x X t r l)) ;
  natEq (x : CO) (X : Ob) (t : T x X) : W0.V = piI (natIdxV x X) (natB x X t) ;
  natP (x : CO) (X : Ob) (t : T x X) : isProp (W0.Ix (natEq x X t)) =
   piIP (natIdxV x X) (natB x X t) (\ r -> piPP (LandsI x X r.1) (isPropL x X r.1)
    (\ l -> W0.IdV (natA x X r) (natL x X t r l) (natR x X t r l)) (\ l -> idProp (natA x X r) (natL x X t r l) (natR x X t r l))) ;

  -- inner faces: index (n , k , k <= n , z , c : Ch (n+1) x z , J , g , i)
  faceIdxV (x : CO) (X : Ob) : VA.V =
   VA.SigV VA.natV (\ n -> VA.SigV VA.natV (\ k -> VA.SigV (VA.IsTV (Tr.leb k n)) (\ hk ->
    VA.SigV C.obV (\ z -> VA.SigV (K.chV (suc n) x z) (\ c ->
     VA.SigV obV (\ J -> VA.SigV (homV J X) (\ g -> coordV n J))))))) ;
  faceLd (x : CO) (X : Ob) (r : VA.Ix (faceIdxV x X)) : U a =
   PB.Lands r.2.2.2.2.2.1 r.2.2.2.2.2.1 (Wt.oneS r.1 r.2.2.2.2.2.1 r.2.2.2.2.2.2.2) (PB.idH r.2.2.2.2.2.1) ;
  facePL (x : CO) (X : Ob) (r : VA.Ix (faceIdxV x X)) : isProp (faceLd x X r) =
   PB.isProp-Lands r.2.2.2.2.2.1 r.2.2.2.2.2.1 (Wt.oneS r.1 r.2.2.2.2.2.1 r.2.2.2.2.2.2.2) (PB.idH r.2.2.2.2.2.1) ;
  faceA (x : CO) (X : Ob) (r : VA.Ix (faceIdxV x X)) : W0.V = (G.ob r.2.2.2.1).ob r.2.2.2.2.2.1 ;
  faceL (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (faceIdxV x X)) (l : faceLd x X r) : W0.Ix (faceA x X r) =
   at x X t (suc r.1) r.2.2.2.1 r.2.2.2.2.1 r.2.2.2.2.2.1 r.2.2.2.2.2.2.1
    (Wt.Face[r.1, r.2.2.2.2.2.1, r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1].Of[(r.2.2.2.2.2.2.2, l)].face) ;
  faceR (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (faceIdxV x X)) (l : faceLd x X r) : W0.Ix (faceA x X r) =
   t (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l ;
  faceB (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (faceIdxV x X)) : W0.V =
   piP (faceLd x X r) (facePL x X r) (\ l -> W0.IdV (faceA x X r) (faceL x X t r l) (faceR x X t r l)) ;
  faceEq (x : CO) (X : Ob) (t : T x X) : W0.V = piI (faceIdxV x X) (faceB x X t) ;
  faceP (x : CO) (X : Ob) (t : T x X) : isProp (W0.Ix (faceEq x X t)) =
   piIP (faceIdxV x X) (faceB x X t) (\ r -> piPP (faceLd x X r) (facePL x X r)
    (\ l -> W0.IdV (faceA x X r) (faceL x X t r l) (faceR x X t r l)) (\ l -> idProp (faceA x X r) (faceL x X t r l) (faceR x X t r l))) ;

  -- the top face: index (n , z , c : Ch (n+1) x z , J , g , i)
  topIdxV (x : CO) (X : Ob) : VA.V =
   VA.SigV VA.natV (\ n -> VA.SigV C.obV (\ z -> VA.SigV (K.chV (suc n) x z) (\ c ->
    VA.SigV obV (\ J -> VA.SigV (homV J X) (\ g -> coordV n J))))) ;
  topLd (x : CO) (X : Ob) (r : VA.Ix (topIdxV x X)) : U a =
   PB.Lands r.2.2.2.1 r.2.2.2.1 (Wt.oneS r.1 r.2.2.2.1 r.2.2.2.2.2) (PB.idH r.2.2.2.1) ;
  topPL (x : CO) (X : Ob) (r : VA.Ix (topIdxV x X)) : isProp (topLd x X r) =
   PB.isProp-Lands r.2.2.2.1 r.2.2.2.1 (Wt.oneS r.1 r.2.2.2.1 r.2.2.2.2.2) (PB.idH r.2.2.2.1) ;
  topA (x : CO) (X : Ob) (r : VA.Ix (topIdxV x X)) : W0.V = (G.ob r.2.1).ob r.2.2.2.1 ;
  topD (x : CO) (X : Ob) (r : VA.Ix (topIdxV x X)) : K.DR r.1 x r.2.1 = K.drop r.1 x r.2.1 r.2.2.1 ;
  topL (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (topIdxV x X)) (l : topLd x X r) : W0.Ix (topA x X r) =
   at x X t (suc r.1) r.2.1 r.2.2.1 r.2.2.2.1 r.2.2.2.2.1
    (Wt.Face[r.1, r.2.2.2.1, suc r.1, Tr.leb-refl (suc r.1)].Of[(r.2.2.2.2.2, l)].face) ;
  topR (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (topIdxV x X)) (l : topLd x X r) : W0.Ix (topA x X r) =
   (G.act r.2.1 (topD x X r).1 (topD x X r).2.2).nt r.2.2.2.1
    (t (r.1, (topD x X r).1, (topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l) ;
  topB (x : CO) (X : Ob) (t : T x X) (r : VA.Ix (topIdxV x X)) : W0.V =
   piP (topLd x X r) (topPL x X r) (\ l -> W0.IdV (topA x X r) (topL x X t r l) (topR x X t r l)) ;
  topEq (x : CO) (X : Ob) (t : T x X) : W0.V = piI (topIdxV x X) (topB x X t) ;
  topP (x : CO) (X : Ob) (t : T x X) : isProp (W0.Ix (topEq x X t)) =
   piIP (topIdxV x X) (topB x X t) (\ r -> piPP (topLd x X r) (topPL x X r)
    (\ l -> W0.IdV (topA x X r) (topL x X t r l) (topR x X t r l)) (\ l -> idProp (topA x X r) (topL x X t r l) (topR x X t r l))) ;

  -- the equations form a proposition
  EqsV (x : CO) (X : Ob) (t : T x X) : W0.V = W0.SigV (natEq x X t) (\ p -> W0.SigV (faceEq x X t) (\ p' -> topEq x X t)) ;
  eqs-prop (x : CO) (X : Ob) (t : T x X) : isProp (W0.Ix (EqsV x X t)) =
   isProp-Sigma (W0.Ix (natEq x X t)) (\ p -> W0.Ix (W0.SigV (faceEq x X t) (\ p' -> topEq x X t))) (natP x X t)
    (\ p -> isProp-Sigma (W0.Ix (faceEq x X t)) (\ p' -> W0.Ix (topEq x X t)) (faceP x X t) (\ p' -> topP x X t)) ;

  -- the fibre of (D G)_x at X
  obV' (x : CO) (X : Ob) : W0.V = W0.SigV (tV x X) (\ t -> EqsV x X t) ;
  Ob' (x : CO) (X : Ob) : U l = W0.Ix (obV' x X) ;

  -- elements are equal when their families are
  ob-eq (x : CO) (X : Ob) (u v : Ob' x X) (H : (q : Idx x X) (l : LandsI x X q) -> Id (W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (u.1 q l) (v.1 q l))
   : Id (Ob' x X) u v =
   Sigma-path (T x X) (\ t -> W0.Ix (EqsV x X t)) u.1 v.1 u.2 v.2
    (funext (Idx x X) (\ q -> (l : LandsI x X q) -> W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) u.1 v.1 (\ q ->
      funext (LandsI x X q) (\ l -> W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (u.1 q) (v.1 q) (H q)))
    (eqs-prop x X v.1 _ v.2) ;

  ------------------------------------------------------------------
  -- the base action: precompose g

  module BA (x : CO) (Y X : Ob) (h : Hom Y X) (u : Ob' x X) {
   sh (q : Idx x Y) : Idx x X = (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.compH q.2.2.2.1 Y X h q.2.2.2.2.1, q.2.2.2.2.2) ;
   t' : T x Y = \ q l -> u.1 (sh q) l ;
   nat' : W0.Ix (natEq x Y t') = \ r l ->
    transH (u.2.1 (sh r.1, r.2) l)
     (apH (\ k -> u.1 (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, k, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                     (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)
          (PB.comp-assoc r.2.1 r.1.2.2.2.1 Y X h r.1.2.2.2.2.1 r.2.2)) ;
   face' : W0.Ix (faceEq x Y t') = \ r l ->
    u.2.2.1 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, PB.compH r.2.2.2.2.2.1 Y X h r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l ;
   top' : W0.Ix (topEq x Y t') = \ r l ->
    u.2.2.2 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, PB.compH r.2.2.2.1 Y X h r.2.2.2.2.1, r.2.2.2.2.2) l ;
   res : Ob' x Y = (t', nat', face', top') ;
  } ;

  obD (x : CO) : PCtx =
   new PCtx[obV' x, \ Y X h u -> BA[x, Y, X, h, u].res,
    \ X u -> ob-eq x X BA[x, X, X, PB.idH X, u].res u (\ q l -> apH (\ k -> u.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l)
               (PB.comp-idl q.2.2.2.1 X q.2.2.2.2.1)),
    \ Z Y X h k u -> ob-eq x Z BA[x, Z, X, PB.compH Z Y X h k, u].res BA[x, Z, Y, k, BA[x, Y, X, h, u].res].res
               (\ q l -> apH (\ k' -> u.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k', q.2.2.2.2.2) l)
                  (PB.comp-assoc q.2.2.2.1 Z Y X h k q.2.2.2.2.1))] ;

  ------------------------------------------------------------------
  -- the C-action along gC : x' -> x: reindex the chains

  module CA (x' x : CO) (gC : CH x' x) (X : Ob) (u : Ob' x X) {
   rq (q : Idx x' X) : Idx x X = (q.1, q.2.1, K.rx q.1 x' x gC q.2.1 q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2) ;
   t' : T x' X = \ q l -> u.1 (rq q) l ;
   nat' : W0.Ix (natEq x' X t') = \ r l -> u.2.1 (rq r.1, r.2) l ;
   face' : W0.Ix (faceEq x' X t') = \ r l ->
    transH (u.2.2.1 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, K.rx (suc r.1) x' x gC r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)
     (apH (\ cc -> u.1 (r.1, r.2.2.2.1, cc, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)
        (K.rx-comp r.1 r.2.1 x' x gC r.2.2.2.1 r.2.2.2.2.1)) ;
   top' : W0.Ix (topEq x' X t') = \ r l ->
    transH (u.2.2.2 (r.1, r.2.1, K.rx (suc r.1) x' x gC r.2.1 r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l)
     (apH (\ DD -> (G.act r.2.1 DD.1 DD.2.2).nt r.2.2.2.1 (u.1 (r.1, DD.1, DD.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))
        (K.rx-drop r.1 x' x gC r.2.1 r.2.2.1)) ;
   res : Ob' x' X = (t', nat', face', top') ;
  } ;

  actC (x' x : CO) (gC : CH x' x) : PSub[obD x, obD x'] =
   new PSub[obD x, obD x', \ X u -> CA[x', x, gC, X, u].res,
    \ Y X h u -> ob-eq x' Y CA[x', x, gC, Y, BA[x, Y, X, h, u].res].res BA[x', Y, X, h, CA[x', x, gC, X, u].res].res
                   (\ q l -> refl (u.1 (q.1, q.2.1, K.rx q.1 x' x gC q.2.1 q.2.2.1, q.2.2.2.1, PB.compH q.2.2.2.1 Y X h q.2.2.2.2.1, q.2.2.2.2.2) l))] ;

  -- D G as a presheaf on C over the base
  DCtx : P.CCtx =
   new P.CCtx[obD, actC,
    \ x X u -> ob-eq x X CA[x, x, P.cid x, X, u].res u
       (\ q l -> apH (\ cc -> u.1 (q.1, q.2.1, cc, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2) l) (K.rx-id q.1 x q.2.1 q.2.2.1)),
    \ x2 y x f h X u -> ob-eq x2 X CA[x2, x, P.co x2 y x f h, X, u].res CA[x2, y, h, X, CA[y, x, f, X, u].res].res
       (\ q l -> apH (\ cc -> u.1 (q.1, q.2.1, cc, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2) l) (K.rx-o q.1 x2 y x f h q.2.1 q.2.2.1))] ;

  ------------------------------------------------------------------
  -- the unit: (tau g)_(n , z , c , J , h , i) = act (f0 ... fn) (g restricted along h)

  module Tau (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) {
   tc (q : Idx x X) : CH q.2.1 x = K.tot q.1 x q.2.1 q.2.2.1 ;
   base (J : Ob) (g : Hom J X) : W0.Ix ((G.ob x).ob J) = (G.ob x).act J X g gm ;
   t' : T x X = \ q l -> (G.act q.2.1 x (tc q)).nt q.2.2.2.1 (base q.2.2.2.1 q.2.2.2.2.1) ;
   nat' : W0.Ix (natEq x X t') = \ r l ->
    transH (symH ((G.act r.1.2.1 x (tc r.1)).nt-nat r.2.1 r.1.2.2.2.1 r.2.2 (base r.1.2.2.2.1 r.1.2.2.2.2.1)))
     (apH ((G.act r.1.2.1 x (tc r.1)).nt r.2.1) (symH ((G.ob x).act-o r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2 gm))) ;
   face' : W0.Ix (faceEq x X t') = \ r l ->
    apH (\ k' -> (G.act r.2.2.2.1 x k').nt r.2.2.2.2.2.1 (base r.2.2.2.2.2.1 r.2.2.2.2.2.2.1))
     (symH (K.tot-comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1)) ;
   top' : W0.Ix (topEq x X t') = \ r l ->
    transH (apH (\ k' -> (G.act r.2.1 x k').nt r.2.2.2.1 (base r.2.2.2.1 r.2.2.2.2.1)) (K.tot-drop r.1 x r.2.1 r.2.2.1))
     (G.act-o r.2.1 (K.drop r.1 x r.2.1 r.2.2.1).1 x (K.tot r.1 x (K.drop r.1 x r.2.1 r.2.2.1).1 (K.drop r.1 x r.2.1 r.2.2.1).2.1)
        (K.drop r.1 x r.2.1 r.2.2.1).2.2 r.2.2.2.1 (base r.2.2.2.1 r.2.2.2.2.1)) ;
   res : Ob' x X = (t', nat', face', top') ;
  } ;

  tauX (x : CO) : PSub[G.ob x, obD x] =
   new PSub[G.ob x, obD x, \ X gm -> Tau[x, X, gm].res,
    \ Y X h gm -> ob-eq x Y Tau[x, Y, (G.ob x).act Y X h gm].res BA[x, Y, X, h, Tau[x, X, gm].res].res
      (\ q l -> apH ((G.act q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1)).nt q.2.2.2.1)
                  (symH ((G.ob x).act-o q.2.2.2.1 Y X h q.2.2.2.2.1 gm)))] ;

  tau : P.CSub[G, DCtx] =
   new P.CSub[G, DCtx, tauX,
    \ y x f X gm -> ob-eq y X Tau[y, X, (G.act y x f).nt X gm].res CA[y, x, f, X, Tau[x, X, gm].res].res
      (\ q l -> transH
        (apH ((G.act q.2.1 y (K.tot q.1 y q.2.1 q.2.2.1)).nt q.2.2.2.1)
           (symH ((G.act y x f).nt-nat q.2.2.2.1 X q.2.2.2.2.1 gm)))
        (transH (symH (G.act-o q.2.1 y x f (K.tot q.1 y q.2.1 q.2.2.1) q.2.2.2.1 ((G.ob x).act q.2.2.2.1 X q.2.2.2.2.1 gm)))
           (apH (\ k' -> (G.act q.2.1 x k').nt q.2.2.2.1 ((G.ob x).act q.2.2.2.1 X q.2.2.2.2.1 gm))
              (symH (K.tot-rx q.1 y x f q.2.1 q.2.2.1)))))] ;
 } ;

 ------------------------------------------------------------------
 -- D on types: (D A)_x over (D G)_x.  Equations between values in
 -- different fibres are stated in the totals E_z = G_z . A_z.

 module DT (G : P.CCtx) (A : P.CTy[G]) {
  module D = DC[G] ;
  Ez (z : CO) (J : Ob) : W0.V = SigE (G.ob z) (A.ty z).tob J ;
  prz (z : CO) (J : Ob) (g : W0.Ix ((G.ob z).ob J)) (b : W0.Ix ((A.ty z).tob J g)) : W0.Ix (Ez z J) = pairE (G.ob z) (A.ty z) J g b ;

  aV (x : CO) (X : Ob) (u : D.Ob' x X) : W0.V =
   piI (idxV x X) (\ q -> piP (LandsI x X q) (isPropL x X q) (\ l -> (A.ty q.2.1).tob q.2.2.2.1 (u.1 q l))) ;
  TA (x : CO) (X : Ob) (u : D.Ob' x X) : U l = W0.Ix (aV x X u) ;

  -- naturality in the base
  anatL (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.natIdxV x X)) (l : LandsI x X r.1) : W0.Ix (Ez r.1.2.1 r.2.1) =
   (extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2 (prz r.1.2.1 r.1.2.2.2.1 (u.1 r.1 l) (av r.1 l)) ;
  anatR (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.natIdxV x X)) (l : LandsI x X r.1) : W0.Ix (Ez r.1.2.1 r.2.1) =
   prz r.1.2.1 r.2.1
    (u.1 (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
         (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)
    (av (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
       (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2) ;
  anatB (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.natIdxV x X)) : W0.V =
   piP (LandsI x X r.1) (isPropL x X r.1) (\ l -> W0.IdV (Ez r.1.2.1 r.2.1) (anatL x X u av r l) (anatR x X u av r l)) ;
  anatEq (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) : W0.V = piI (D.natIdxV x X) (anatB x X u av) ;
  anatP (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) : isProp (W0.Ix (anatEq x X u av)) =
   piIP (D.natIdxV x X) (anatB x X u av) (\ r -> piPP (LandsI x X r.1) (isPropL x X r.1)
    (\ l -> W0.IdV (Ez r.1.2.1 r.2.1) (anatL x X u av r l) (anatR x X u av r l)) (\ l -> idProp (Ez r.1.2.1 r.2.1) (anatL x X u av r l) (anatR x X u av r l))) ;

  -- inner faces
  afaceF (x : CO) (X : Ob) (r : VA.Ix (D.faceIdxV x X)) (l : D.faceLd x X r) : Wt.Pn (suc r.1) r.2.2.2.2.2.1 =
   Wt.Face[r.1, r.2.2.2.2.2.1, r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1].Of[(r.2.2.2.2.2.2.2, l)].face ;
  afaceL (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.faceIdxV x X)) (l : D.faceLd x X r) : W0.Ix (Ez r.2.2.2.1 r.2.2.2.2.2.1) =
   prz r.2.2.2.1 r.2.2.2.2.2.1
    (u.1 (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (afaceF x X r l).1) (afaceF x X r l).2)
    (av (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (afaceF x X r l).1) (afaceF x X r l).2) ;
  afaceR (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.faceIdxV x X)) (l : D.faceLd x X r) : W0.Ix (Ez r.2.2.2.1 r.2.2.2.2.2.1) =
   prz r.2.2.2.1 r.2.2.2.2.2.1
    (u.1 (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)
    (av (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l) ;
  afaceB (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.faceIdxV x X)) : W0.V =
   piP (D.faceLd x X r) (D.facePL x X r) (\ l -> W0.IdV (Ez r.2.2.2.1 r.2.2.2.2.2.1) (afaceL x X u av r l) (afaceR x X u av r l)) ;
  afaceEq (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) : W0.V = piI (D.faceIdxV x X) (afaceB x X u av) ;
  afaceP (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) : isProp (W0.Ix (afaceEq x X u av)) =
   piIP (D.faceIdxV x X) (afaceB x X u av) (\ r -> piPP (D.faceLd x X r) (D.facePL x X r)
    (\ l -> W0.IdV (Ez r.2.2.2.1 r.2.2.2.2.2.1) (afaceL x X u av r l) (afaceR x X u av r l))
    (\ l -> idProp (Ez r.2.2.2.1 r.2.2.2.2.2.1) (afaceL x X u av r l) (afaceR x X u av r l))) ;

  -- the top face: the C-action of A along the last map
  atopF (x : CO) (X : Ob) (r : VA.Ix (D.topIdxV x X)) (l : D.topLd x X r) : Wt.Pn (suc r.1) r.2.2.2.1 =
   Wt.Face[r.1, r.2.2.2.1, suc r.1, Tr.leb-refl (suc r.1)].Of[(r.2.2.2.2.2, l)].face ;
  atopL (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.topIdxV x X)) (l : D.topLd x X r) : W0.Ix (Ez r.2.1 r.2.2.2.1) =
   prz r.2.1 r.2.2.2.1
    (u.1 (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (atopF x X r l).1) (atopF x X r l).2)
    (av (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (atopF x X r l).1) (atopF x X r l).2) ;
  atopR (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.topIdxV x X)) (l : D.topLd x X r) : W0.Ix (Ez r.2.1 r.2.2.2.1) =
   (A.tE r.2.1 (D.topD x X r).1 (D.topD x X r).2.2).nt r.2.2.2.1
    (prz (D.topD x X r).1 r.2.2.2.1
       (u.1 (r.1, (D.topD x X r).1, (D.topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l)
       (av (r.1, (D.topD x X r).1, (D.topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l)) ;
  atopB (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) (r : VA.Ix (D.topIdxV x X)) : W0.V =
   piP (D.topLd x X r) (D.topPL x X r) (\ l -> W0.IdV (Ez r.2.1 r.2.2.2.1) (atopL x X u av r l) (atopR x X u av r l)) ;
  atopEq (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) : W0.V = piI (D.topIdxV x X) (atopB x X u av) ;
  atopP (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) : isProp (W0.Ix (atopEq x X u av)) =
   piIP (D.topIdxV x X) (atopB x X u av) (\ r -> piPP (D.topLd x X r) (D.topPL x X r)
    (\ l -> W0.IdV (Ez r.2.1 r.2.2.2.1) (atopL x X u av r l) (atopR x X u av r l))
    (\ l -> idProp (Ez r.2.1 r.2.2.2.1) (atopL x X u av r l) (atopR x X u av r l))) ;

  AEqsV (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) : W0.V =
   W0.SigV (anatEq x X u av) (\ p -> W0.SigV (afaceEq x X u av) (\ p' -> atopEq x X u av)) ;
  aeqs-prop (x : CO) (X : Ob) (u : D.Ob' x X) (av : TA x X u) : isProp (W0.Ix (AEqsV x X u av)) =
   isProp-Sigma (W0.Ix (anatEq x X u av)) (\ p -> W0.Ix (W0.SigV (afaceEq x X u av) (\ p' -> atopEq x X u av))) (anatP x X u av)
    (\ p -> isProp-Sigma (W0.Ix (afaceEq x X u av)) (\ p' -> W0.Ix (atopEq x X u av)) (afaceP x X u av) (\ p' -> atopP x X u av)) ;

  -- the fibre of (D A)_x over u
  tobV (x : CO) (X : Ob) (u : D.Ob' x X) : W0.V = W0.SigV (aV x X u) (\ av -> AEqsV x X u av) ;
  TOb' (x : CO) (X : Ob) (u : D.Ob' x X) : U l = W0.Ix (tobV x X u) ;

  tob-eq (x : CO) (X : Ob) (u : D.Ob' x X) (av b : TOb' x X u)
   (H : (q : Idx x X) (l : LandsI x X q) -> Id (W0.Ix ((A.ty q.2.1).tob q.2.2.2.1 (u.1 q l))) (av.1 q l) (b.1 q l))
   : Id (TOb' x X u) av b =
   Sigma-path (TA x X u) (\ a' -> W0.Ix (AEqsV x X u a')) av.1 b.1 av.2 b.2
    (funext (Idx x X) (\ q -> (l : LandsI x X q) -> W0.Ix ((A.ty q.2.1).tob q.2.2.2.1 (u.1 q l))) av.1 b.1 (\ q ->
      funext (LandsI x X q) (\ l -> W0.Ix ((A.ty q.2.1).tob q.2.2.2.1 (u.1 q l))) (av.1 q) (b.1 q) (H q)))
    (aeqs-prop x X u b.1 _ b.2) ;

  ------------------------------------------------------------------
  -- the base action of D A along h : Y -> X, over e : (BA h u) = v

  module TB (x : CO) (Y X : Ob) (h : Hom Y X) (u : D.Ob' x X) (v : D.Ob' x Y)
   (e : Id (D.Ob' x Y) (D.BA[x, Y, X, h, u].res) v) (av : TOb' x X u) {
   sh (q : Idx x Y) : Idx x X = D.BA[x, Y, X, h, u].sh q ;
   pe (q : Idx x Y) (l : LandsI x Y q) : Id (W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (u.1 (sh q) l) (v.1 q l) =
    apH (\ w -> w.1 q l) e ;
   a' : TA x Y v = \ q l -> GPR.TyL[G.ob q.2.1, A.ty q.2.1].coeT q.2.2.2.1 (u.1 (sh q) l) (v.1 q l) (pe q l) (av.1 (sh q) l) ;
   -- read in E, a' is av at the shifted index
   pc (q : Idx x Y) (l : LandsI x Y q)
    : Id (W0.Ix (Ez q.2.1 q.2.2.2.1)) (prz q.2.1 q.2.2.2.1 (v.1 q l) (a' q l)) (prz q.2.1 q.2.2.2.1 (u.1 (sh q) l) (av.1 (sh q) l)) =
    symH (GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-coe q.2.2.2.1 (u.1 (sh q) l) (v.1 q l) (pe q l) (av.1 (sh q) l)) ;
   nat' : W0.Ix (anatEq x Y v a') = \ r l ->
    transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pc r.1 l))
     (transH (av.2.1 (sh r.1, r.2) l)
       (transH (apH (\ k -> prz r.1.2.1 r.2.1
                   (u.1 (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, k, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                        (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)
                   (av.1 (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, k, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                        (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2))
                 (PB.comp-assoc r.2.1 r.1.2.2.2.1 Y X h r.1.2.2.2.2.1 r.2.2))
         (symH (pc (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 Y r.1.2.2.2.2.1 r.2.2,
                    (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                   (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)))) ;
   face' : W0.Ix (afaceEq x Y v a') = \ r l ->
    transH (pc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (afaceF x Y r l).1) (afaceF x Y r l).2)
     (transH (av.2.2.1 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, PB.compH r.2.2.2.2.2.1 Y X h r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)
       (symH (pc (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l))) ;
   top' : W0.Ix (atopEq x Y v a') = \ r l ->
    transH (pc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (atopF x Y r l).1) (atopF x Y r l).2)
     (transH (av.2.2.2 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, PB.compH r.2.2.2.1 Y X h r.2.2.2.2.1, r.2.2.2.2.2) l)
       (apH ((A.tE r.2.1 (D.topD x Y r).1 (D.topD x Y r).2.2).nt r.2.2.2.1)
          (symH (pc (r.1, (D.topD x Y r).1, (D.topD x Y r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l)))) ;
   res : TOb' x Y v = (a', nat', face', top') ;
  } ;

  tb-id (x : CO) (I : Ob) (u : D.Ob' x I) (e : Id (D.Ob' x I) (D.BA[x, I, I, PB.idH I, u].res) u) (av : TOb' x I u)
   : Id (TOb' x I u) (TB[x, I, I, PB.idH I, u, u, e, av].res) av =
   tob-eq x I u (TB[x, I, I, PB.idH I, u, u, e, av].res) av (\ q l ->
    GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (u.1 q l) (TB[x, I, I, PB.idH I, u, u, e, av].a' q l) (av.1 q l)
     (transH (TB[x, I, I, PB.idH I, u, u, e, av].pc q l)
       (apH (\ k -> prz q.2.1 q.2.2.2.1 (u.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l) (av.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l))
          (PB.comp-idl q.2.2.2.1 I q.2.2.2.2.1)))) ;

  tb-o (x : CO) (K' J I : Ob) (f : Hom J I) (g : Hom K' J) (u1 : D.Ob' x I) (u2 : D.Ob' x J) (u3 : D.Ob' x K')
   (e1 : Id (D.Ob' x J) (D.BA[x, J, I, f, u1].res) u2) (e2 : Id (D.Ob' x K') (D.BA[x, K', J, g, u2].res) u3)
   (e3 : Id (D.Ob' x K') (D.BA[x, K', I, PB.compH K' J I f g, u1].res) u3) (av : TOb' x I u1)
   : Id (TOb' x K' u3) (TB[x, K', I, PB.compH K' J I f g, u1, u3, e3, av].res)
       (TB[x, K', J, g, u2, u3, e2, TB[x, J, I, f, u1, u2, e1, av].res].res) =
   tob-eq x K' u3 (TB[x, K', I, PB.compH K' J I f g, u1, u3, e3, av].res) (TB[x, K', J, g, u2, u3, e2, TB[x, J, I, f, u1, u2, e1, av].res].res) (\ q l ->
    GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (u3.1 q l)
     (TB[x, K', I, PB.compH K' J I f g, u1, u3, e3, av].a' q l) (TB[x, K', J, g, u2, u3, e2, TB[x, J, I, f, u1, u2, e1, av].res].a' q l)
     (transH (TB[x, K', I, PB.compH K' J I f g, u1, u3, e3, av].pc q l)
       (transH (apH (\ k -> prz q.2.1 q.2.2.2.1 (u1.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l) (av.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l))
                  (PB.comp-assoc q.2.2.2.1 K' J I f g q.2.2.2.2.1))
         (symH (transH (TB[x, K', J, g, u2, u3, e2, TB[x, J, I, f, u1, u2, e1, av].res].pc q l)
                  (TB[x, J, I, f, u1, u2, e1, av].pc (TB[x, K', J, g, u2, u3, e2, TB[x, J, I, f, u1, u2, e1, av].res].sh q) l)))))) ;

  -- (D A)_x as a presheaf type over (D G)_x
  DTy (x : CO) : PTy[D.obD x] =
   new PTy[D.obD x, \ X u -> tobV x X u,
    \ J I h u v e av -> TB[x, J, I, h, u, v, e, av].res,
    \ I u e av -> tb-id x I u e av,
    \ K' J I f g u1 u2 u3 e1 e2 e3 av -> tb-o x K' J I f g u1 u2 u3 e1 e2 e3 av] ;
 } ;
} ;
