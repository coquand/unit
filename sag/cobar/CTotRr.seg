-- CTotRr.seg (canonicity-c2; SIMPLIFIED.md, Tr's D-modality): the
-- retraction r : (D (R B))[tau] -> R B of tau at the total site, for a
-- type B over U G.  r xi at (Y , m , p , e) is the counit of eps
-- (canonicity-45's reading at the trivial index, CTotL14b / c) at xi
-- restricted along m:
--   cuN   the counit U (R B) -> B, natural (CTotR.L9.PA)
--   tN    eps then the counit, natural levelwise
--   r     the family, natural along levelwise maps (tN's naturality and
--         the action's composition law); natural in the total site since
--         R B acts by reindexing
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module Rr (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (B : CTotR[a, vl, l].TotR[C].RS.P0.PTy[CTotR[a, vl, l].TotR[C].RS.rC (CTotCat[a, vl, l].TotOf[C].toP G)]) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = RS.P0 ;
 GP : TR.P1.PCtx = TC.toP G ;
 module RT = RN.Ty[GP, B] ;
 RB : TR.P1.PTy[GP] = RT.RB ;
 module LB = CTotL14b[a, vl, l].L14b[C, G, RB] ;
 module LC = CTotL14c[a, vl, l].L14c[C, G, RB] ;
 module L9 = TR.L9[GP, B] ;
 module HO = LB.HO ;
 UG : P0.PCtx = RS.rC GP ;
 URB : P0.PTy[UG] = RS.rT GP RB ;
 Bt : TR.P1.PTy[GP] = LB.Bt ;
 UBt : P0.PTy[UG] = RS.rT GP Bt ;
 -- the counit
 cu (Z : RN.Ob0) (p : W0.Ix (UG.ob Z)) (v : W0.Ix (URB.tob Z p)) : W0.Ix (B.tob Z p) =
  v.1 Z (TR.G1.GB.BC.idC (RN.o Z)) p (symH (GP.act-id (RN.o Z) p)) ;
 cuNat (Y X : RN.Ob0) (h : RN.Hom0 Y X) (p : W0.Ix (UG.ob X)) (p' : W0.Ix (UG.ob Y)) (e1 : Id (W0.Ix (UG.ob Y)) (UG.act Y X h p) p')
   (v : W0.Ix (URB.tob X p)) : Id (W0.Ix (B.tob Y p')) (B.tact Y X h p p' e1 (cu X p v)) (cu Y p' (URB.tact Y X h p p' e1 v)) =
  idJ (W0.Ix (UG.ob Y)) (UG.act Y X h p)
    (\ p2 e2 -> Id (W0.Ix (B.tob Y p2)) (B.tact Y X h p p2 e2 (cu X p v)) (cu Y p2 (URB.tact Y X h p p2 e2 v)))
    (P0.pairE-inj UG B Y (UG.act Y X h p) (B.tact Y X h p (UG.act Y X h p) (refl (UG.act Y X h p)) (cu X p v))
       (cu Y (UG.act Y X h p) (URB.tact Y X h p (UG.act Y X h p) (refl (UG.act Y X h p)) v))
       (L9.PA[Y, X, h, (p, v)].law))
    p' e1 ;
 cuN : HO.NMap[UG, URB, B] = new HO.NMap[UG, URB, B, \ Z p v -> cu Z p v, \ Y X h p p' e1 v -> cuNat Y X h p p' e1 v] ;
 tN : HO.NMap[UG, UBt, B] = HO.compN UG UBt URB B LC.epsN cuN ;
 -- the family of r xi
 module Rm (X : RN.Ob1) (g : RT.Pt X) (xi : W0.Ix (Bt.tob X g)) {
  xY (Y : RN.Ob0) (m : RN.Hom1 (RN.o Y) X) (p : RT.Pt (RN.o Y)) (e : Id (RT.Pt (RN.o Y)) p (RT.at X g Y m)) : W0.Ix (Bt.tob (RN.o Y) p) =
   Bt.tact (RN.o Y) X m g p (symH e) xi ;
  b : RT.Fam X g = \ Y m p e -> tN.nfun Y p (xY Y m p e) ;
  n : RT.NatTy X g b = \ Z Y h m p e q e' e'' ->
   transH (tN.nnat Z Y h p q e'' (xY Y m p e))
     (apH {W0.Ix (Bt.tob (RN.o Z) q)} {W0.Ix (B.tob Z q)} (tN.nfun Z q)
        (symH (Bt.tact-o (RN.o Z) (RN.o Y) X m (TR.fn.onH Z Y h) g p q (symH e) e'' (symH e') xi))) ;
  res : W0.Ix (RB.tob X g) = RT.mk X g b n ;
 } ;
 r (X : RN.Ob1) (g : RT.Pt X) (xi : W0.Ix (Bt.tob X g)) : W0.Ix (RB.tob X g) = Rm[X, g, xi].res ;
 -- natural along total maps: R B acts by reindexing
 rN (X' X : RN.Ob1) (k : RN.Hom1 X' X) (g : RT.Pt X) (g' : RT.Pt X') (eg : Id (RT.Pt X') (GP.act X' X k g) g') (xi : W0.Ix (Bt.tob X g))
   : Id (W0.Ix (RB.tob X' g')) (RB.tact X' X k g g' eg (r X g xi)) (r X' g' (Bt.tact X' X k g g' eg xi)) =
  RT.famExt X' g' (RB.tact X' X k g g' eg (r X g xi)) (r X' g' (Bt.tact X' X k g g' eg xi)) (\ Y m p e ->
   apH {W0.Ix (Bt.tob (RN.o Y) p)} {W0.Ix (B.tob Y p)} (tN.nfun Y p)
     (Bt.tact-o (RN.o Y) X' X k m g g' p eg (symH e) (symH (transH e (RT.Act[X', X, k, g, g', eg, r X g xi].ek Y m))) xi)) ;
 -- r after tau is the identity
 module RT1 (X : RN.Ob1) (g : RT.Pt X) (av : W0.Ix (RB.tob X g)) {
  tav : W0.Ix (Bt.tob X g) = LB.TA.tauA X.1 X.2 g av ;
  module PW (Y : RN.Ob0) (m : RN.Hom1 (RN.o Y) X) (p : RT.Pt (RN.o Y)) (e : Id (RT.Pt (RN.o Y)) p (RT.at X g Y m)) {
   oY : RN.Ob1 = RN.o Y ;
   e0 : Id (LB.D.Ob' oY.1 oY.2) (LB.D.act oY.1 X.1 m.1 oY.2 X.2 m.2 (LB.D.tau X.1 X.2 g)) (LB.D.tau oY.1 oY.2 p) =
    LB.P.ntEq GP (TC.toP LB.D.DCtx) (TC.toPS G LB.D.DCtx LB.D.tauS) oY X m g p (symH e) ;
   av' : W0.Ix (RB.tob oY p) = RB.tact oY X m g p (symH e) av ;
   s1 : Id (W0.Ix (Bt.tob oY p)) (Bt.tact oY X m g p (symH e) tav) (LB.TA.tauA oY.1 oY.2 p av') =
    LB.NatE[oY.1, X.1, m.1, oY.2, X.2, m.2, g, av].law p (symH e) e0 ;
   s2 : Id (W0.Ix (RB.tob oY p)) (LB.EP[oY.1, oY.2, p].ev (LB.TA.tauA oY.1 oY.2 p av')) av' = LB.EP[oY.1, oY.2, p].et av' ;
   s3 : Id (W0.Ix (B.tob Y p)) (cu Y p av') (av.1 Y m p e) =
    RT.famCong X g av.1 Y (TR.G1.GB.BC.oC oY oY X m (TR.G1.GB.BC.idC oY)) m (TR.G1.GB.BC.oC-idr oY X m) p
      (transH (symH (GP.act-id oY p)) (RT.Act[oY, X, m, g, p, symH e, av].ek Y (TR.G1.GB.BC.idC oY))) e ;
   law : Id (W0.Ix (B.tob Y p)) ((r X g tav).1 Y m p e) (av.1 Y m p e) =
    transH (apH {W0.Ix (Bt.tob oY p)} {W0.Ix (B.tob Y p)} (\ u -> cu Y p (LB.EP[oY.1, oY.2, p].ev u)) s1)
      (transH (apH {W0.Ix (RB.tob oY p)} {W0.Ix (B.tob Y p)} (cu Y p) s2) s3) ;
  } ;
  law : Id (W0.Ix (RB.tob X g)) (r X g tav) av = RT.famExt X g (r X g tav) av (\ Y m p e -> PW[Y, m, p, e].law) ;
 } ;
} ;
