-- Levelwise fibrancy of the threefold Yoneda product in the required sense:
-- fibrancy on each copy of the discrete-object levelwise site.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module F111 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module BS = CF3P13[a].Cmp3[R, encK, pe] ;
  module YF = CCopy6[a].YoF[R, encK, pe] ;
  module B2 = CCmpY5[a].F11[R, encK, pe] ;
  module TR = BS.TR ;
  UA111 : TR.P0.PTy[BS.PD.UG] = TR.RS.rT BS.CT.P1 BS.O111.Y1T ;
  module Cp (y : SX.Over[R].Presentation) {
    module C1 = YF.Cp[y] ;
    module C2 = B2.Cp[y] ;
    module Cy = C1.Cy ;
    D : L.PCtx = C1.D ;
    T11 : L.PTy[D] = C2.A' ;
    T1 : L.PTy[D] = C1.A' ;
    K : L.PCtx = L.extP D T11 ;
    pK : L.PSub[K, D] = L.pP D T11 ;
    T2 : L.PTy[K] = L.subTy K D T1 pK ;
    fb2 : PB.CLine[a+].Lines[K, T2].Fib = PB.CFibSub[a+].FibSub[K, D, pK, T1].sub C1.fib ;
    SgP : L.PTy[D] = PresheafFormers[a, a+].PFormers[PB.BC].SigAB[D, T11, T2].SigP ;
    fbS : PB.CLine[a+].Lines[D, SgP].Fib = PB.CSig[a+].SigFib[D, T11, T2, C2.fib, fb2].fib ;
    A' : L.PTy[D] = Cy.rTy BS.PD.UG UA111 ;
    module TA' = PB.GPre[a+].TyL[D, A'] ;
    module TS = PB.GPre[a+].TyL[D, SgP] ;
    ta (W : Ob) (v : TA'.EI W) : TS.EI W = TS.pr W (TA'.pr1 W v) (TA'.pr2 W v) ;
    tanat (Vv W : Ob) (g : Hom Vv W) (v : TA'.EI W) : Id (TS.EI Vv) (TS.E.act Vv W g (ta W v)) (ta Vv (TA'.E.act Vv W g v)) =
      refl (ta Vv (TA'.E.act Vv W g v)) ;
    tainj (W : Ob) (v v' : TA'.EI W) (Pp : Id (V1.Ix (D.ob W)) (TA'.pr1 W v) (TA'.pr1 W v'))
      (Q0 : Id (TS.EI W) (ta W v) (ta W v')) : Id (TA'.EI W) v v' = Q0 ;
    module CRT = PB.CCart[a+, a+].Cart[D, A', D, SgP, \ W o -> o, \ Vv W g d -> refl (D.act Vv W g d), ta,
      \ W v -> refl (TA'.pr1 W v), tanat, tainj, \ X x uu -> uu, \ X x uu -> refl (TS.pr X x uu)] ;
    fib : PB.CLine[a+].Lines[D, A'].Fib = CRT.moveFib fbS ;
  } ;
  fibG0 : TR.G0.GB.CLine[a+].Lines[BS.PD.UG, UA111].Fib =
    CCopy5[a].FibC[R, encK, pe, BS.PD.UG, UA111, \ y -> Cp[y].fib].fib ;
} ;
