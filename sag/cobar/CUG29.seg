-- CUG29.seg (canonicity-c2; the generic (U), part 29 of CCmpU29's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU29 with
-- F2 replaced by s and the generator cases a hypothesis gen.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
-- a transport along a composite, undone
backTr (G : C.Ctx) (A B D : C.Ty G) (P1 : Id (C.Ty G) A B) (P2 : Id (C.Ty G) B D) (e : C.El G A)
  : Id (C.El G A) (OV.trE G D A (symH (transH P1 P2)) (OV.trE G B D P2 (OV.trE G A B P1 e))) e =
 idJ (C.Ty G) A (\ B2 Q1 -> (D2 : C.Ty G) (Q2 : Id (C.Ty G) B2 D2)
     -> Id (C.El G A) (OV.trE G D2 A (symH (transH Q1 Q2)) (OV.trE G B2 D2 Q2 (OV.trE G A B2 Q1 e))) e)
  (\ D2 Q2 -> idJ (C.Ty G) A (\ D3 Q3 -> Id (C.El G A) (OV.trE G D3 A (symH (transH (refl A) Q3)) (OV.trE G A D3 Q3 (OV.trE G A A (refl A) e))) e)
      (refl e) D2 Q2) B P1 D P2 ;
module UG29 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) (gen : (v : SX.Fin s.1) -> C.El (C.ext C.nil H) (CUG20[a].UG20[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN].IdZ (CHomT3[a].HomP[R, encK, pe].Alg[s].AX.cls (var v)))) {
 module U28m = CUG28[a].UG28[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN, gen] ;
 module U27m = U28m.U27m ;
 module U25m = CUG25[a].UG25[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN, gen] ;
 module U13m = U27m.U13m ;
 GH : C.Ctx = U25m.GH ;
 MTh : C.Ty GH = U25m.MTh ;
 FunT : C.Ty GH = U25m.FunT ;
 PiT : C.Ty GH = U25m.T6.PiT ;
 eA : C.El GH MTh = U13m.ZA.e ;
 eB : C.El GH MTh = U13m.ZB.e ;
 fA : C.El GH FunT = OV.trE GH PiT FunT U25m.Ppi (OV.trE GH MTh PiT U25m.T6.PNt eA) ;
 fB : C.El GH FunT = OV.trE GH PiT FunT U25m.Ppi (OV.trE GH MTh PiT U25m.T6.PNt eB) ;
 F6 : C.Ty GH = OV.Fun GH U28m.QH6 U28m.QYh ;
 PF : Id (C.Ty GH) F6 FunT = refl F6 ;
 cA : Id (C.El GH FunT) (OV.trE GH F6 FunT PF U28m.f) fA = refl fA ;
 cB : Id (C.El GH FunT) (OV.trE GH F6 FunT PF U28m.g) fB = refl fB ;
 u0 : C.El GH (IJ.IdT GH FunT (OV.trE GH F6 FunT PF U28m.f) (OV.trE GH F6 FunT PF U28m.g)) =
  CUG16[a].UG16[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN].idFwd GH F6 FunT PF U28m.f U28m.g U28m.res ;
 u : C.El GH (IJ.IdT GH FunT fA fB) =
  subst (C.El GH FunT) (\ x -> C.El GH (IJ.IdT GH FunT fA x)) (OV.trE GH F6 FunT PF U28m.g) fB cB
   (subst (C.El GH FunT) (\ x -> C.El GH (IJ.IdT GH FunT x (OV.trE GH F6 FunT PF U28m.g))) (OV.trE GH F6 FunT PF U28m.f) fA cA u0) ;
 Ptot : Id (C.Ty GH) MTh FunT = transH U25m.T6.PNt U25m.Ppi ;
 u1 : C.El GH (IJ.IdT GH MTh (OV.trE GH FunT MTh (symH Ptot) fA) (OV.trE GH FunT MTh (symH Ptot) fB)) =
  CUG16[a].UG16[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN].idFwd GH FunT MTh (symH Ptot) fA fB u ;
 res : C.El GH (IJ.IdT GH MTh eA eB) =
  subst (C.El GH MTh) (\ x -> C.El GH (IJ.IdT GH MTh eA x)) (OV.trE GH FunT MTh (symH Ptot) fB) eB (backTr GH MTh PiT FunT U25m.T6.PNt U25m.Ppi eB)
   (subst (C.El GH MTh) (\ x -> C.El GH (IJ.IdT GH MTh x (OV.trE GH FunT MTh (symH Ptot) fB))) (OV.trE GH FunT MTh (symH Ptot) fA) eA
      (backTr GH MTh PiT FunT U25m.T6.PNt U25m.Ppi eA) u1) ;
} ;
