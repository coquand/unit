-- CTotL16h.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, SPECIFIC TO OUR C: the double reading MW is natural along total
-- maps (u0, f0) : (J0, y0) -> (I, x): D DAC's action on MW at u is MW at the
-- acted u.  The shifted outer index then the inner index is the shift of
-- the concatenated index (comp-assoc, chF-rx, rmap-o, rx-cat).
-- No new axioms beyond the named premises (fe).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a+] ;
module VA = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, a+] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module RH (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module RG = CTotL16g[a].RG[R, encK, pe] ;
 IC : CIntCat[a, a+].IC = RG.IC ;
 module VT = RG.VT ;
 module DO = RG.DO ;
 Obj (I : Ob) : U a+ = VT.Obj I ;
 module Nat (G : CTPsh[a, a+, a+].TPshOf[IC].TCtx) (A : Presheaf[a+, a+].Psh[CTotCat[a, a+, a+].TotOf[IC].TotCat].PTy[CTotCat[a, a+, a+].TotOf[IC].toP G])
  (Wf : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (CTotL16b[a, a+, a+].substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face)) {
  module O = RG.Out[G, A, Wf, Wres, WfaceR, WfaceL] ;
  module LD = O.LD ;
  module LB = O.LB ;
  module DA = O.DA ;
  module D = O.D ;
  module D2 = O.D2 ;
  module L16a = O.L16a ;
  GP : LB.P.PCtx = O.GP ;
  module At0 (J0 I : Ob) (u0 : Hom J0 I) (y0 : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y0 x)
   (g : W0.Ix (G.ob I x)) (g' : W0.Ix (G.ob J0 y0)) (e : Id (W0.Ix (G.ob J0 y0)) (G.act J0 I u0 y0 x f0 g) g')
   (u : DA.TOb' I x (D.tau I x g)) (t : Hom I PFO.ivO) {
   module M = O.MW[I, x, g, u, t] ;
   tg : D.Ob' I x = D.tau I x g ;
   tg' : D.Ob' J0 y0 = D.tau J0 y0 g' ;
   ed : Id (D.Ob' J0 y0) (D.act J0 I u0 y0 x f0 tg) tg' = LB.P.ntEq GP L16a.DGc.DG L16a.tauS (J0, y0) (I, x) (u0, f0) g g' e ;
   module TBu = DA.TB[J0, I, u0, y0, x, f0, tg, tg', ed, u] ;
   u' : DA.TOb' J0 y0 tg' = TBu.res ;
   t' : Hom J0 PFO.ivO = PB.compH J0 I PFO.ivO t u0 ;
   module M' = O.MW[J0, y0, g', u', t'] ;
   module TBm = D2.TB[J0, I, u0, y0, x, f0, tg, tg', ed, M.res] ;
   vf : VT.VMap J0 y0 x = VT.vpart J0 I u0 y0 x f0 ;
   module At (q' : DA.Idx J0 y0) (l' : DA.LandsI J0 y0 q') {
    module Oa = M.InO[(TBm.sh q'), l'].M ;
    module OB = M'.InO[q', l'].M ;
    pp : Id (W0.Ix (G.ob q'.2.1 q'.2.2.2.1)) Oa.OFm.gmy OB.OFm.gmy = TBm.pe q' l' ;
    module HQ (q : DA.Idx q'.2.1 q'.2.2.2.1) (li : DA.LandsI q'.2.1 q'.2.2.2.1 q) {
     module Sa = LD.Inner[I, x, g, u, t, (TBm.sh q'), l', q, li] ;
     module Tb = LD.Inner[J0, y0, g', u', t', q', l', q, li] ;
     module CFg = CChainsF[a+].CF[VT.VCat q'.2.1, VT.VCat q.2.1, VT.rfun q.2.1 q'.2.1 q.2.2.1] ;
     module CA = CTotL16c[a, a+, a+].CA[IC, q.2.1] ;
     K2 : Hom q.2.1 I = compH q.2.1 J0 I u0 Tb.gg ;
     chE : Id (DO.KJ[q.2.1].K.Ch (Ar.plus q'.1 (suc q.1)) x q.2.2.2.1) Sa.cc
             (DO.KJ[q.2.1].K.rx (Ar.plus q'.1 (suc q.1)) y0 x (VT.rmap q.2.1 J0 Tb.gg y0 x vf) q.2.2.2.1 Tb.cc) =
      transH (apH {DO.KJ[q.2.1].K.Ch q'.1 x q'.2.2.2.1} {DO.KJ[q.2.1].K.Ch (Ar.plus q'.1 (suc q.1)) x q.2.2.2.1}
                (\ c2 -> CA.catA q'.1 q.1 x q'.2.2.2.1 q.2.2.2.1 c2 q.2.2.2.2.1)
                (transH (CFg.chF-rx q'.1 y0 x (VT.rmap q'.2.1 J0 q'.2.2.1 y0 x vf) q'.2.2.2.1 q'.2.2.2.2.1)
                   (apH {VT.VMap q.2.1 y0 x} {DO.KJ[q.2.1].K.Ch q'.1 x q'.2.2.2.1}
                      (\ hh -> DO.KJ[q.2.1].K.rx q'.1 y0 x hh q'.2.2.2.1 (CFg.chF q'.1 y0 q'.2.2.2.1 q'.2.2.2.2.1))
                      (symH (VT.rmap-o q.2.1 q'.2.1 J0 q'.2.2.1 q.2.2.1 y0 x vf)))))
       (symH (CA.rx-cat q'.1 q.1 y0 x q'.2.2.2.1 q.2.2.2.1 (VT.rmap q.2.1 J0 Tb.gg y0 x vf) Tb.c2 q.2.2.2.2.1)) ;
     eq : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (Oa.OFm.tgy.1 q li) (Oa.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (OB.OFm.tgy.1 q li) (OB.ires.1 q li)) =
      transH Sa.pc
       (transH (apH {Hom q.2.1 I} {DA.Ez q.2.1 q.2.2.2.1}
                  (\ k -> M.RDm.rd (Ar.plus q'.1 (suc q.1)) q.2.1 k q.2.2.2.1 Sa.cc (Wf q'.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t k) Sa.jr Sa.iP))
                  (PB.comp-assoc q.2.1 q'.2.1 J0 I u0 q'.2.2.1 q.2.2.1))
        (transH (apH {Hom q.2.1 PFO.ivO} {DA.Ez q.2.1 q.2.2.2.1}
                   (\ t2 -> M.RDm.rd (Ar.plus q'.1 (suc q.1)) q.2.1 K2 q.2.2.2.1 Sa.cc (Wf q'.1 q.1 q.2.1 t2 Sa.jr Sa.iP))
                   (symH (PB.comp-assoc q.2.1 J0 I PFO.ivO t u0 Tb.gg)))
         (transH (apH {DO.KJ[q.2.1].K.Ch (Ar.plus q'.1 (suc q.1)) x q.2.2.2.1} {DA.Ez q.2.1 q.2.2.2.1}
                    (\ ch -> M.RDm.rd (Ar.plus q'.1 (suc q.1)) q.2.1 K2 q.2.2.2.1 ch Tb.w) chE)
          (transH (symH (TBu.pc Tb.idx Tb.ldx)) (symH Tb.pc))))) ;
    } ;
    eq : Id (D2.Ez q'.2.1 q'.2.2.2.1) (D2.prz q'.2.1 q'.2.2.2.1 (tg'.1 q' l') (TBm.a' q' l')) (D2.prz q'.2.1 q'.2.2.2.1 (tg'.1 q' l') (M'.ov q' l')) =
     transH (TBm.pc q' l') (O.totEq q'.2.1 q'.2.2.2.1 Oa.OFm.gmy OB.OFm.gmy pp Oa.ires OB.ires (\ q li -> HQ[q, li].eq)) ;
   } ;
   nat : Id (W0.Ix (L16a.B2.tob (J0, y0) g')) (L16a.B2.tact (J0, y0) (I, x) (u0, f0) g g' e M.res) M'.res =
    D2.tob-eq J0 y0 tg' TBm.res M'.res (\ q' l' -> D2.pr-inj q'.2.1 q'.2.2.2.1 (tg'.1 q' l') (TBm.a' q' l') (M'.ov q' l') At[q', l'].eq) ;
  } ;
 } ;
} ;
