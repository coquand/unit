-- CCmpU11.seg (canonicity-c2; (K) for cmpI, part 11): over nil.H, the Id
-- component moved to HTT and carried through Ev_i (CwFPth.apM).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module U11 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation)
  (c : C.El C.nil CPreI[a].PreOf[R, encK, pe].CmpI[y].Q1.FM.P.H.AS.Qt) {
 module U9m = CCmpU9[a].U9[R, encK, pe, y] ;
 module U10m = CCmpU10[a].U10[R, encK, pe, y, c] ;
 module L = PosFull[a].PB.GPre[a+].PS ;
 module HO = PosFull[a].PB.CHtpyOps[a+] ;
 Nl : C.Ctx = C.nil ;
 H : C.Ty Nl = U9m.H ;
 GH : C.Ctx = U9m.GH ;
 HTT : C.Ty Nl = U9m.HTT ;
 QY : C.Ty Nl = U10m.QY ;
 HTh : C.Ty GH = OV.wkT Nl H HTT ;
 QYh : C.Ty GH = OV.wkT Nl H QY ;
 -- the Id component as an Id in HTh
 HTww : C.Ty U9m.D2 = OV.wkT U9m.D1 U9m.HSw U9m.HTTw ;
 Hs : C.Ty GH = C.subT GH U9m.D2 HTww U9m.sg ;
 j1 : C.El GH Hs = C.subt GH U9m.D2 HTww U9m.i1 U9m.sg ;
 j2 : C.El GH Hs = C.subt GH U9m.D2 HTww U9m.i2 U9m.sg ;
 pI0 : C.El GH (IJ.IdT GH Hs j1 j2) = OV.trE GH U9m.IdZs (IJ.IdT GH Hs j1 j2) (IJ.IdT-nat GH U9m.D2 HTww U9m.i1 U9m.i2 U9m.sg) U9m.pId ;
 clT (D : C.Ctx) (T : C.Ty Nl) (s1 s2 : C.Sub D Nl) : Id (C.Ty D) (C.subT D Nl T s1) (C.subT D Nl T s2) =
  apH {C.Sub D Nl} {C.Ty D} (\ s -> C.subT D Nl T s) (transH (C.eps-uniq D s1) (symH (C.eps-uniq D s2))) ;
 s3 : C.Sub GH Nl = C.o GH U9m.D2 Nl (C.o U9m.D2 U9m.D1 Nl (C.p Nl U9m.HS) (C.p U9m.D1 U9m.HSw)) U9m.sg ;
 PH : Id (C.Ty GH) Hs HTh =
  transH (apH {C.Ty U9m.D2} {C.Ty GH} (\ T -> C.subT GH U9m.D2 T U9m.sg) (symH (C.subT-o U9m.D2 U9m.D1 Nl HTT (C.p Nl U9m.HS) (C.p U9m.D1 U9m.HSw))))
   (transH (symH (C.subT-o GH U9m.D2 Nl HTT (C.o U9m.D2 U9m.D1 Nl (C.p Nl U9m.HS) (C.p U9m.D1 U9m.HSw)) U9m.sg)) (clT GH HTT s3 (C.p Nl H))) ;
 x1 : C.El GH HTh = OV.trE GH Hs HTh PH j1 ;
 x2 : C.El GH HTh = OV.trE GH Hs HTh PH j2 ;
 idFwd (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (u : C.El G (IJ.IdT G X x y))
   : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)) =
  idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y))) u X' P ;
 eX : C.El GH (IJ.IdT GH HTh x1 x2) = idFwd GH Hs HTh PH j1 j2 pI0 ;
} ;
