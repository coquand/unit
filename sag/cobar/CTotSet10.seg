-- CTotSet10.seg (canonicity-c2; "D preserves h-sets", part 10): the map f
-- as an element over K.R of Id_{D A}(x , y) weakened: at (k , rv) the
-- path of CTotSet9 with the empty sieve; natural by idY-eq (readings
-- compared through the action laws of K.R).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST10 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G))
  (pS : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.El (CTotSet1[a, vl, l].ST1[C, G, A].E1)
          (CTotSet1[a, vl, l].ST1[C, G, A].PN1.isProp (CTotSet1[a, vl, l].ST1[C, G, A].E1) (CTotSet1[a, vl, l].ST1[C, G, A].IdA))) {
 module S9 = CTotSet9[a, vl, l].ST9[C, G, A] ;
 module F = S9.At[pS] ;
 module S8 = S9.S8 ;
 module S5 = S9.S5 ;
 module S1 = S9.S1 ;
 module G1 = S1.G1 ;
 module P1 = S1.P1 ;
 module TC = S1.TC ;
 module Yk = S9.Yk ;
 KR : P1.PCtx = F.KR ;
 T : P1.PTy[KR] = F.PSg.subTy KR S5.K S9.IK.1 (F.PSg.pP S5.K F.R) ;
 eobF (X : TC.TOb) (kp : W0.Ix (KR.ob X)) : W0.Ix (T.tob X kp) =
  ((\ W f j -> F.u X kp W f j,
    (\ Vb W g f j -> F.UN[X, kp, Vb, W, g, f, j].law,
     (\ W f -> S8.EN[W.1, W.2, F.kW X kp.1 W f, F.rW X kp W f].end0,
      \ W f -> S8.EN[W.1, W.2, F.kW X kp.1 W f, F.rW X kp W f].end1))),
   (G1.GB.emptyS X, \ W f i j -> absurd _ (G1.GB.empty-lands W X f i))) ;
 Fz (Vb : TC.TOb) (j : G1.GB.IvP Vb) (z : W0.Ix (KR.ob Vb)) : Yk.TA.EI Vb =
  Yk.TA.pr Vb z.1 (S9.S7.VE[Vb.1, Vb.2, z.1, z.2, j].res) ;
 module NB (J I : TC.TOb) (h : TC.THm J I) (kp : W0.Ix (KR.ob I)) {
  kp' : W0.Ix (KR.ob J) = KR.act J I h kp ;
  eP : Id (W0.Ix (S5.K.ob J)) (S5.K.act J I h kp.1) kp'.1 = F.PSg.ntEq KR S5.K (F.PSg.pP S5.K F.R) J I h kp kp' (refl kp') ;
  lhs : W0.Ix (Yk.tob J kp'.1) = Yk.tactY J I h kp.1 kp'.1 eP (eobF I kp) ;
  H (Vb : TC.TOb) (g : TC.THm Vb J) (j : G1.GB.IvP Vb) : Id (Yk.TA.EI Vb) (Yk.rd J kp'.1 lhs Vb g j) (Yk.rd J kp'.1 (eobF J kp') Vb g j) =
   transH (Yk.Tact[J, I, h, kp.1, kp'.1, eP, eobF I kp].rdc Vb g j)
     (apH {W0.Ix (KR.ob Vb)} {Yk.TA.EI Vb} (Fz Vb j) (KR.act-o Vb J I h g kp)) ;
  law : Id (W0.Ix (Yk.tob J kp'.1)) lhs (eobF J kp') =
   Yk.idY-eq J kp'.1 lhs (eobF J kp') (\ Vb g j -> H Vb g j) (G1.GB.pre-empty J I h) ;
 } ;
 fE : F.PSg.PEl[KR, T] = F.PSg.mkPEl KR T (\ X kp -> eobF X kp) (\ J I h kp kp2 e ->
  idJ (W0.Ix (KR.ob J)) (KR.act J I h kp) (\ y2 e2 -> Id (W0.Ix (T.tob J y2)) (T.tact J I h kp y2 e2 (eobF I kp)) (eobF J y2))
    NB[J, I, h, kp].law kp2 e) ;
} ;
