-- CTruncPushAdj.seg (canonicity-c2; SIMPLIFIED.md item 1): pulling back
-- along s : D -> G is left adjoint to the pushforward s_*, on natural
-- maps of types.
--   Tp   a natural map A[s] -> B over D gives A -> s_* B over G:
--        a |-> (W , h , d) |-> m (a restricted along h, read over s d)
--   Ut   a natural map C -> s_* B over G gives C[s] -> B over D:
--        c |-> (r c) read at (id , d)   (the counit CTruncPush.at)
level l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;

module Tp (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[D]) (m : HO.NMap[D, subTy D G A s, B]) {
  module Pu = GCTruncPush[l].Push[D, G, s, B] ;
  aAt (X : Ob) (x : Pu.GP X) (a0 : W.Ix (A.tob X x)) (Y : Ob) (h : Hom Y X) (d : Pu.DP Y) (e : Pu.Ov X x Y h d)
    : W.Ix (A.tob Y (s.nt Y d)) = A.tact Y X h x (s.nt Y d) (symH e) a0 ;
  fam (X : Ob) (x : Pu.GP X) (a0 : W.Ix (A.tob X x)) : Pu.Fam X x = \ Y h d e -> m.nfun Y d (aAt X x a0 Y h d e) ;
  nat (X : Ob) (x : Pu.GP X) (a0 : W.Ix (A.tob X x)) : Pu.NatF X x (fam X x a0) = \ Z Y k h d e ->
    transH (m.nnat Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)) (aAt X x a0 Y h d e))
      (apH (m.nfun Z (D.act Z Y k d))
        (symH (A.tact-o Z Y X h k x (s.nt Y d) (s.nt Z (D.act Z Y k d)) (symH e)
                 (ntEq D G s Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)))
                 (symH (Pu.ovK X x Z Y k h d e)) a0))) ;
  nfun (X : Ob) (x : Pu.GP X) (a0 : W.Ix (A.tob X x)) : Pu.El X x = (fam X x a0, nat X x a0) ;
  nnat (J I : Ob) (f : Hom J I) (x : Pu.GP I) (y : Pu.GP J) (e : Id (Pu.GP J) (G.act J I f x) y) (a0 : W.Ix (A.tob I x))
    : Id (Pu.El J y) (Pu.tact J I f x y e (nfun I x a0)) (nfun J y (A.tact J I f x y e a0)) =
    Pu.push-eq J y (Pu.tact J I f x y e (nfun I x a0)) (nfun J y (A.tact J I f x y e a0)) (\ Y h d e' ->
      apH (m.nfun Y d)
        (A.tact-o Y J I f h x y (s.nt Y d) e (symH e') (symH (Pu.Res[J, I, f, x, y, e, nfun I x a0].eC Y h d e')) a0)) ;
  map : HO.NMap[G, A, Pu.pushTy] = new HO.NMap[G, A, Pu.pushTy, nfun, nnat] ;
} ;

module Ut (D G : PCtx) (s : PSub[D, G]) (C : PTy[G]) (B : PTy[D])
  (r : HO.NMap[G, C, GCTruncPush[l].Push[D, G, s, B].pushTy]) {
  module Pu = GCTruncPush[l].Push[D, G, s, B] ;
  Cs : PTy[D] = subTy D G C s ;
  nfun (X : Ob) (d : Pu.DP X) (c : W.Ix (Cs.tob X d)) : W.Ix (B.tob X d) = Pu.at X d (r.nfun X (s.nt X d) c) ;
  module Nn (J I : Ob) (f : Hom J I) (d : Pu.DP I) (c : W.Ix (Cs.tob I d)) {
    d' : Pu.DP J = D.act J I f d ;
    phi : Pu.El I (s.nt I d) = r.nfun I (s.nt I d) c ;
    eq0 : Pu.Ov I (s.nt I d) I (idH I) d = symH (G.act-id I (s.nt I d)) ;
    eS : Id (Pu.GP J) (G.act J I f (s.nt I d)) (s.nt J d') = ntEq D G s J I f d d' (refl d') ;
    c1 : Id (W.Ix (B.tob J d')) (B.tact J I f d d' (refl d') (nfun I d c))
           (phi.1 J (compH J I I (idH I) f) d' (Pu.ovK I (s.nt I d) J I f (idH I) d eq0)) =
      phi.2 J I f (idH I) d eq0 ;
    c2 : Id (W.Ix (B.tob J d')) (phi.1 J (compH J I I (idH I) f) d' (Pu.ovK I (s.nt I d) J I f (idH I) d eq0))
           (Pu.at J d' (Pu.tact J I f (s.nt I d) (s.nt J d') eS phi)) =
      Pu.ov-irr I (s.nt I d) phi.1 J (compH J I I (idH I) f) (compH J J I f (idH J))
        (transH (comp-idl J I f) (symH (comp-idr J I f))) d'
        (Pu.ovK I (s.nt I d) J I f (idH I) d eq0)
        (Pu.Res[J, I, f, s.nt I d, s.nt J d', eS, phi].eC J (idH J) d' (symH (G.act-id J (s.nt J d')))) ;
    c3 : Id (W.Ix (B.tob J d')) (Pu.at J d' (Pu.tact J I f (s.nt I d) (s.nt J d') eS phi)) (nfun J d' (Cs.tact J I f d d' (refl d') c)) =
      apH (Pu.at J d') (r.nnat J I f (s.nt I d) (s.nt J d') eS c) ;
    res : Id (W.Ix (B.tob J d')) (B.tact J I f d d' (refl d') (nfun I d c)) (nfun J d' (Cs.tact J I f d d' (refl d') c)) =
      transH c1 (transH c2 c3) ;
  } ;
  nnat (J I : Ob) (f : Hom J I) (d : Pu.DP I) (d2 : Pu.DP J) (e : Id (Pu.DP J) (D.act J I f d) d2) (c : W.Ix (Cs.tob I d))
    : Id (W.Ix (B.tob J d2)) (B.tact J I f d d2 e (nfun I d c)) (nfun J d2 (Cs.tact J I f d d2 e c)) =
    idJ (Pu.DP J) (D.act J I f d)
      (\ d3 e3 -> Id (W.Ix (B.tob J d3)) (B.tact J I f d d3 e3 (nfun I d c)) (nfun J d3 (Cs.tact J I f d d3 e3 c)))
      Nn[J, I, f, d, c].res d2 e ;
  map : HO.NMap[D, Cs, B] = new HO.NMap[D, Cs, B, nfun, nnat] ;
} ;
