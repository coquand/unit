-- Multiplication of finite ideal certificates in the base CwF.
-- If x = y + L(c) and u = v + L(d), then
-- x*u = y*v + L(y*d + u*c), using the checked linearity of L.
-- The coefficient vector is finite and indexed by the relation list.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Ring[a++] ;

module Finite (G : CFinIntPilot[a].C.Ctx) (Rg : CFinIntPilot[a].PR.HRing[G]) {
 module FV = CFinIntVec[a].Vec[G, Rg] ;
 module P = FV.P ;
 module CG = P.CG ;
 E : U a++ = FV.E ;
 add (x y : E) : E = FV.add x y ;
 mul (x y : E) : E = FV.mul x y ;
 Path (x y : E) : U a++ = FV.Path x y ;
 Cert (fs : List E) (x y : E) : U a++ =
  (c : FV.Cof fs) * Path x (add y (FV.lin fs c)) ;

 module At (fs : List E) (x y u v : E) (h : Cert fs x y) (k : Cert fs u v) {
  c : FV.Cof fs = h.1 ;
  d : FV.Cof fs = k.1 ;
  lc : E = FV.lin fs c ;
  ld : E = FV.lin fs d ;
  cd : FV.Cof fs = FV.plus fs (FV.scale fs d y) (FV.scale fs c u) ;
  t0 : E = mul x u ;
  t1 : E = mul (add y lc) u ;
  t2 : E = add (mul y u) (mul lc u) ;
  t3 : E = add (mul y (add v ld)) (mul lc u) ;
  t4 : E = add (add (mul y v) (mul y ld)) (mul lc u) ;
  t5 : E = add (mul y v) (add (mul y ld) (mul lc u)) ;
  t6 : E = add (mul y v) (add (mul ld y) (mul lc u)) ;
  t7 : E = add (mul y v) (add (FV.lin fs (FV.scale fs d y)) (FV.lin fs (FV.scale fs c u))) ;
  t8 : E = add (mul y v) (FV.lin fs cd) ;

  p1 : Path t0 t1 = CG.mulL x (add y lc) u h.2 ;
  p2 : Path t1 t2 = P.distRight y lc u ;
  p3 : Path t2 t3 = CG.addL (mul y u) (mul y (add v ld)) (mul lc u)
    (CG.mulR y u (add v ld) k.2) ;
  p4 : Path t3 t4 = CG.addL (mul y (add v ld)) (add (mul y v) (mul y ld)) (mul lc u)
    (Rg.distr y v ld) ;
  p5 : Path t4 t5 = Rg.add-assoc (mul y v) (mul y ld) (mul lc u) ;
  p6 : Path t5 t6 = CG.addR (mul y v) (add (mul y ld) (mul lc u)) (add (mul ld y) (mul lc u))
    (CG.addL (mul y ld) (mul ld y) (mul lc u) (Rg.mul-comm y ld)) ;
  p7 : Path t6 t7 = CG.addR (mul y v)
    (add (mul ld y) (mul lc u))
    (add (FV.lin fs (FV.scale fs d y)) (FV.lin fs (FV.scale fs c u)))
    (CG.add2 (mul ld y) (FV.lin fs (FV.scale fs d y))
      (mul lc u) (FV.lin fs (FV.scale fs c u))
      (P.sy (FV.lin fs (FV.scale fs d y)) (mul ld y) (FV.lin-scale fs d y))
      (P.sy (FV.lin fs (FV.scale fs c u)) (mul lc u) (FV.lin-scale fs c u))) ;
  p8 : Path t7 t8 = CG.addR (mul y v)
    (add (FV.lin fs (FV.scale fs d y)) (FV.lin fs (FV.scale fs c u)))
    (FV.lin fs cd)
    (P.sy (FV.lin fs cd)
      (add (FV.lin fs (FV.scale fs d y)) (FV.lin fs (FV.scale fs c u)))
      (FV.lin-plus fs (FV.scale fs d y) (FV.scale fs c u))) ;
  path : Path t0 t8 = P.tr t0 t1 t8 p1
    (P.tr t1 t2 t8 p2
      (P.tr t2 t3 t8 p3
        (P.tr t3 t4 t8 p4
          (P.tr t4 t5 t8 p5
            (P.tr t5 t6 t8 p6
              (P.tr t6 t7 t8 p7 p8)))))) ;
  result : Cert fs (mul x u) (mul y v) = (cd, path) ;
 } ;
 multiplication (fs : List E) (x y u v : E) (h : Cert fs x y) (k : Cert fs u v)
   : Cert fs (mul x u) (mul y v) = At[fs, x, y, u, v, h, k].result ;
} ;
