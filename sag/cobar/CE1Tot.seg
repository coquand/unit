-- CE1Tot.seg (canonicity-45; COBAR.md "Prop 58", 4e's ruling (ii)): E1 at the
-- total site for the terms of a presentation t: G's evaluation of a term s
-- at the maps g_i = tau . pre_(x_i) : yo(t) -> G is homotopic to tau . pre_(k_s),
-- k_s the code F1 -> t sending the generator to s.  Induction on s, with the
-- codes as the algebra side: CCmpY6's compatibility at the code W = (s1, s2) :
-- F2 -> t, and the code paths of CCodeH (W . I_i ~ k_si, W . op ~ k_(s1 op s2)).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;

module T1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module CM = CC.CM ;
 module FR = CSubst[a].Free[R] ;
 module GR = CGRing[a].GR[R, encK, pe] ;
 module C6 = GR.C6 ;
 module G1 = CC.TR.G1 ;
 module HO1 = G1.GB.CHtpyOps[a+] ;
 module CT = CTotCtxTy[a, a+, a+].CtxTy[CM.IC] ;
 module QT = CT.Of[CM.Yo[t].yoT] ;
 P1 : G1.GB.GPre[a+].PS.PCtx = CT.P1 ;
 XT : G1.GB.GPre[a+].PS.PTy[P1] = QT.Y1T ;
 GT : G1.GB.GPre[a+].PS.PTy[P1] = C6.GT ;
 TmT : U a = SX.Over[R].Der[t].Term ;
 -- the code F1 -> t sending the generator to s
 module KS (s : TmT) { module S = CM.II.SubC[CM.F1, t, \ v -> s, \ pp m -> FR.noEq pp m _] ; } ;
 -- precomposition with a global code F' -> F, as a map over the terminal context
 module PreN (F F' : SX.Over[R].Presentation) (io : (J : Ob) -> CM.MO.Fn[F', F].M J)
   (ion : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[F', F].M K) (CM.MO.Fn[F', F].res J K v (io J)) (io K)) {
  module PR = CM.Pre[F, F', io, ion] ;
  module QF = CT.Of[CM.Yo[F].yoT] ;
  module QF' = CT.Of[CM.Yo[F'].yoT] ;
  nm : HO1.NMap[P1, QF.Y1T, QF'.Y1T] = new HO1.NMap[P1, QF.Y1T, QF'.Y1T, \ X o w -> PR.pre X.1 X.2 w, \ J I f x x' e w -> symH (PR.pre-nat J.1 I.1 f.1 J.2 I.2 f.2 w)] ;
 } ;
 tauN : HO1.NMap[P1, C6.Q1.Y1T, GT] = C6.TN[C6.Y1, C6.Q1.DY.tauS].nm ;
 -- tau . pre_(k_s)
 Rs (s : TmT) : HO1.NMap[P1, XT, GT] = HO1.compN P1 XT C6.Q1.Y1T GT (PreN[t, CM.F1, KS[s].S.M.mor, KS[s].S.M.mor-nat].nm) tauN ;
 -- G's operations as maps over the terminal context
 module GOp (io : (J : Ob) -> CM.MO.Fn[CM.F1, CM.F2].M J) (io-nat : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[CM.F1, CM.F2].M K) (CM.MO.Fn[CM.F1, CM.F2].res J K v (io J)) (io K)) {
  module OC = C6.Opc[io, io-nat] ;
  opT (X : CT.TC.TOb) (o : V1.Ix (P1.ob X)) (a0 b0 : V1.Ix (GT.tob X o)) : V1.Ix (GT.tob X o) = OC.OP.op.nt X.1 X.2 (a0, b0) ;
  opTN (J I : CT.TC.TOb) (f : CT.TC.THm J I) (x : V1.Ix (P1.ob I)) (y : V1.Ix (P1.ob J)) (e : Id (V1.Ix (P1.ob J)) (P1.act J I f x) y) (a0 b0 : V1.Ix (GT.tob I x))
   : Id (V1.Ix (GT.tob J y)) (GT.tact J I f x y e (opT I x a0 b0)) (opT J y (GT.tact J I f x y e a0) (GT.tact J I f x y e b0)) =
   symH (OC.OP.op.nt-nat J.1 I.1 f.1 J.2 I.2 f.2 (a0, b0)) ;
  module AO = CApOp2G[a, a+, a+].On[CM.IC].AO[P1, XT, GT, opT, opTN] ;
 } ;
 module AddG = GOp[CM.II.AddF.M.mor, CM.II.AddF.M.mor-nat] ;
 module MulG = GOp[CM.II.MulF.M.mor, CM.II.MulF.M.mor-nat] ;
 -- the code W = (s1, s2) : F2 -> t
 module WC (s1 s2 : TmT) {
  sg : SX.Fin CM.F2.1 -> TmT = split { inl v -> s1 ; inr u -> s2 } ;
  module S = CM.II.SubC[CM.F2, t, sg, \ pp m -> absurd (SX.Over[R].Der[t].Proof (CSubst[a].SE[R].subE (SX.Fin CM.F2.1) (SX.Fin t.1) sg pp) SX.Over[R].Der[t].zeroE) m] ;
  -- W . io against k_s' (s' the image of io's term under W), as a total-site homotopy
  module Step (io : (J : Ob) -> CM.MO.Fn[CM.F1, CM.F2].M J) (ion : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[CM.F1, CM.F2].M K) (CM.MO.Fn[CM.F1, CM.F2].res J K v (io J)) (io K))
    (Phi : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (OV.Fun FibCwF[a, a+].fibCwF.nil (CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt) (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt)))
    (ioE : (I : Ob) (f : Hom I I) (u : V1.Ix ((CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt).1.tob I tt)) -> Id (V1.Ix ((CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt).1.tob I tt)) ((io I).1.1 I f u) ((Phi.eob I tt).1 I f u))
    (u0 : SX.Over[R].Der[CM.F2].Term)
    (bt : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (IJ.IdT FibCwF[a, a+].fibCwF.nil (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt)
            (OV.app FibCwF[a, a+].fibCwF.nil (CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt) (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt) Phi (CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].AX.cls (var (inr tt))))
            (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].AX.cls u0))) {
   module WI = CCompC[a].CC2[R, encK, pe, CM.F2, CM.F1, t, io, ion, S.M.mor, S.M.mor-nat] ;
   s' : TmT = S.SM.SB.sbT u0 ;
   module KB = KS[s'] ;
   module GO = CCodeH[a].GenOf[R, encK, pe, t, WI.c, WI.cn, KB.S.M.mor, KB.S.M.mor-nat] ;
   Nl : FibCwF[a, a+].fibCwF.Ctx = FibCwF[a, a+].fibCwF.nil ;
   Q1 : FibCwF[a, a+].fibCwF.Ty Nl = CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt ;
   Q2 : FibCwF[a, a+].fibCwF.Ty Nl = CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt ;
   Qt : FibCwF[a, a+].fibCwF.Ty Nl = GO.QY ;
   cx : FibCwF[a, a+].fibCwF.El Nl Q1 = CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].AX.cls (var (inr tt)) ;
   c2 : FibCwF[a, a+].fibCwF.El Nl Q2 = OV.app Nl Q1 Q2 Phi cx ;
   Ea : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q2 Qt S.SM.Phi c2 ;
   Eb : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q1 Qt KB.S.SM.Phi cx ;
   mid : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q2 Qt S.SM.Phi (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].AX.cls u0) ;
   cs : FibCwF[a, a+].fibCwF.El Nl Qt = CHomT3[a].HomP[R, encK, pe].Alg[t].AX.cls s' ;
   E : FibCwF[a, a+].fibCwF.El Nl (IJ.IdT Nl Qt Ea Eb) =
    PT.transM Nl Qt Ea mid Eb (PT.apM Nl Q2 Qt (OV.bod Nl Q2 (OV.wkT Nl Q2 Qt) S.SM.Phi) c2 (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].AX.cls u0) bt)
     (PT.transM Nl Qt mid cs Eb (S.SM.beta u0) (PT.symM Nl Qt Eb cs (KB.S.SM.beta (var (inr tt))))) ;
   ra (K : Ob) : Id (V1.Ix (Qt.1.tob K tt)) (Ea.eob K tt) (GO.fa K) =
    transH (CAppRd[a].App0[Q2, Qt, S.SM.Phi, c2].rd K tt)
     (apH {V1.Ix (Q2.1.tob K tt)} {V1.Ix (Qt.1.tob K tt)} (\ v -> (S.SM.Phi.eob K tt).1 K (idH K) v)
       (transH (CAppRd[a].App0[Q1, Q2, Phi, cx].rd K tt)
         (transH (apH {Hom K K} {V1.Ix (Q2.1.tob K tt)} (\ f -> (Phi.eob K tt).1 K f (cx.eob K tt)) (symH (comp-idl K K (idH K))))
           (symH (ioE K (compH K K K (idH K) (idH K)) (cx.eob K tt)))))) ;
   rb (K : Ob) : Id (V1.Ix (Qt.1.tob K tt)) (Eb.eob K tt) (GO.fb K) = CAppRd[a].App0[Q1, Qt, KB.S.SM.Phi, cx].rd K tt ;
   module G = GO.At[Ea, Eb, E, ra, rb] ;
   -- (c . W) . io = c . (W . io)
   assoc (K : Ob) (x : SX.Over[R].Presentation) (c : CM.MO.Fn[t, x].M K)
    : Id (CM.MO.Fn[CM.F1, x].M K) (CM.Pre[CM.F2, CM.F1, io, ion].pre K x (CM.Pre[t, CM.F2, S.M.mor, S.M.mor-nat].pre K x c))
         (CM.Pre[t, CM.F1, WI.c, WI.cn].pre K x c) =
    symH (transH (apH {(w : Hom K K) * CM.MO.Fn[CM.F1, x].M K} {CM.MO.Fn[CM.F1, x].M K} (\ p -> p.2)
                    (CM.CO.As[K, K, K, K, idH K, idH K, idH K, x, t, CM.F2, CM.F1, io K, S.M.mor K, c].law))
      (apH {Hom K K} {CM.MO.Fn[CM.F1, x].M K} (\ hh -> CM.CO.cmpM K K K hh x CM.F2 CM.F1 (io K) (CM.CO.cmpM K K K (idH K) x t CM.F2 (S.M.mor K) c)) (comp-idl K K (idH K)))) ;
  } ;
 } ;
 -- Kan composition in G at the total site
 cB : G1.GB.CLine[a+].Lines[P1, GT].CompK[G1.GB.e0, G1.GB.e1].Comp = CGBr[a].GBr[R, encK, pe].fbGT.1 ;
 -- tau . pre along a global code F1 -> t
 aC (c : (J : Ob) -> CM.MO.Fn[CM.F1, t].M J) (cn : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[CM.F1, t].M K) (CM.MO.Fn[CM.F1, t].res J K v (c J)) (c K))
  : HO1.NMap[P1, XT, GT] = HO1.compN P1 XT C6.Q1.Y1T GT (PreN[t, CM.F1, c, cn].nm) tauN ;
} ;
