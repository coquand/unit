-- CSubst.seg (canonicity-45; SIMPLIFIED.md step 6): substitution of terms
-- for generators, on terms and on derivations.  For presentations s, t and
-- sg : generators of s -> terms of t sending each equation of s to a term
-- provably zero over t:
--   sbT     the substituted term
--   sbP     a derivation over s gives a proof over t between the
--           substituted ends (by induction on the tree; the equation case
--           is the given proof)
--   proof-sb  Proof_s t u -> Proof_t (sbT t) (sbT u)
-- Instances (the generic algebra's structure maps): F1 = (1, nil) to
-- F2 = (2, nil) by the generator going to x1, x2, x1 + x2, x1 x2.
-- No new axioms.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Ring[l] ;
module SX = CSyntax[l] ;

-- substitution on expressions
module SE (R : CRing) {
 subE (V W : U l) (sg : V -> SX.Over[R].Expr W) : SX.Over[R].Expr V -> SX.Over[R].Expr W = split {
  var v -> sg v ; cst r -> cst r ;
  sumE p q | rp rq -> sumE rp rq ; mulE p q | rp rq -> mulE rp rq } ;
} ;

module SubOf (R : CRing) (s t : SX.Over[R].Presentation)
 (sg : SX.Fin s.1 -> SX.Over[R].Der[t].Term)
 (eqP : (p : SX.Over[R].Der[s].Term) -> SX.Over[R].Der[s].Member p s.2
     -> SX.Over[R].Der[t].Proof (SE[R].subE (SX.Fin s.1) (SX.Fin t.1) sg p) SX.Over[R].Der[t].zeroE) {
 module Ds = SX.Over[R].Der[s] ;
 module Dt = SX.Over[R].Der[t] ;
 sbT (p : Ds.Term) : Dt.Term = SE[R].subE (SX.Fin s.1) (SX.Fin t.1) sg p ;
 PT (d : Ds.Tree) : U l = Dt.Proof (sbT (Ds.ends d).1) (sbT (Ds.ends d).2) ;
 sbP : (d : Ds.Tree) -> Ds.Valid d -> PT d = split {
  reflD p -> \ v -> Dt.reflP (sbT p) ;
  symD d | r -> \ v -> Dt.symP (sbT (Ds.ends d).1) (sbT (Ds.ends d).2) (r v) ;
  transD d e | rd re -> \ v ->
   Dt.transP (sbT (Ds.ends d).1) (sbT (Ds.ends d).2) (sbT (Ds.ends e).2) (rd v.1)
    (Prelude[l].subst Ds.Term (\ w -> Dt.Proof (sbT w) (sbT (Ds.ends e).2)) (Ds.ends e).1 (Ds.ends d).2 (symH v.2.2) (re v.2.1)) ;
  sumD d e | rd re -> \ v -> Dt.sumP (sbT (Ds.ends d).1) (sbT (Ds.ends d).2) (sbT (Ds.ends e).1) (sbT (Ds.ends e).2) (rd v.1) (re v.2) ;
  mulD d e | rd re -> \ v -> Dt.mulP (sbT (Ds.ends d).1) (sbT (Ds.ends d).2) (sbT (Ds.ends e).1) (sbT (Ds.ends e).2) (rd v.1) (re v.2) ;
  addAssoc p q r -> \ v -> Dt.addAssocP (sbT p) (sbT q) (sbT r) ;
  addComm p q -> \ v -> Dt.addCommP (sbT p) (sbT q) ;
  addZero p -> \ v -> Dt.addZeroP (sbT p) ;
  addNeg p -> \ v -> Dt.addNegP (sbT p) ;
  mulAssoc p q r -> \ v -> Dt.mulAssocP (sbT p) (sbT q) (sbT r) ;
  mulComm p q -> \ v -> Dt.mulCommP (sbT p) (sbT q) ;
  mulOne p -> \ v -> Dt.mulOneP (sbT p) ;
  distrib p q r -> \ v -> Dt.distribP (sbT p) (sbT q) (sbT r) ;
  coeffAdd a b -> \ v -> Dt.coeffAddP a b ;
  coeffMul a b -> \ v -> Dt.coeffMulP a b ;
  equation p m -> \ v -> eqP p m } ;
 proof-sb (u u' : Ds.Term) (w : Ds.Proof u u') : Dt.Proof (sbT u) (sbT u') =
  Prelude[l].subst Ds.Term (\ z -> Dt.Proof (sbT u) (sbT z)) (Ds.ends w.1).2 u' w.2.2.2
   (Prelude[l].subst Ds.Term (\ z -> Dt.Proof (sbT z) (sbT (Ds.ends w.1).2)) (Ds.ends w.1).1 u w.2.2.1 (sbP w.1 w.2.1)) ;
} ;

-- the free presentations on one and two generators, and the structure maps
module Free (R : CRing) {
 F1 : SX.Over[R].Presentation = (suc zero, nil) ;
 F2 : SX.Over[R].Presentation = (suc (suc zero), nil) ;
 module D2 = SX.Over[R].Der[F2] ;
 x1 : D2.Term = var (inl (inr tt)) ;
 x2 : D2.Term = var (inr tt) ;
 noEq (p : SX.Over[R].Der[F1].Term) (m : SX.Over[R].Der[F1].Member p F1.2) (Z : U l) : Z = absurd Z m ;
 module Map (e : D2.Term) {
  sg (v : SX.Fin (suc zero)) : D2.Term = e ;
  module SB = SubOf[R, F1, F2, sg, \ p m -> noEq p m (D2.Proof (SE[R].subE (SX.Fin (suc zero)) (SX.Fin (suc (suc zero))) sg p) D2.zeroE)] ;
 } ;
 module I1 = Map[x1] ;
 module I2 = Map[x2] ;
 module AddF = Map[sumE x1 x2] ;
 module MulF = Map[mulE x1 x2] ;
} ;
