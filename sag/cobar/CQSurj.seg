-- CQSurj.seg (canonicity-c2): the classes of a presented algebra are merely
-- surjective: over nil.Q_x (variable q), || Sigma (t : Delta Term_x). cls t = q ||
-- (CwFQuot's planned surj; elimP1 into the truncation itself, at a class by
-- the unit of the truncation at (t, refl)).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
TA : CwFTrunc.Trunc[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv].TruncAt = CTruncAtBase[a].truncAt ;
module Ex (C0 : CwF.CwF[a++]) {
 open C0 ;
 exS (D G : C0.Ctx) (A : C0.Ty G) (s : C0.Sub D G) (x : C0.El D (C0.subT D G A s)) : C0.Sub D (C0.ext G A) = extS D G A s x ;
} ;
module QSurj (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) {
 module AX = CAlgX[a].AlgX[R, encK, x, pe] ;
 module QQ = AX.QQ ;
 module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
 Nl : C.Ctx = C.nil ;
 Qt : C.Ty Nl = AX.Qt ;
 Tm : C.Ty Nl = AX.RP.Tm ;
 G1 : C.Ctx = C.ext Nl Qt ;
 D1 : C.Ctx = C.ext Nl Tm ;
 TmG : C.Ty G1 = OV.wkT Nl Qt Tm ;
 E : C.Ctx = C.ext G1 TmG ;
 -- E -> nil.Tm, (q, t) |-> t
 sgN (K : Ob) (w : V1.Ix (E.ob K)) : V1.Ix (D1.ob K) = (w.1.1, w.2) ;
 sg : C.Sub E D1 = new L.PSub[E, D1, sgN, \ J I f w -> refl (sgN J (E.act J I f w))] ;
 pE : C.Sub E G1 = C.p G1 TmG ;
 T0 : C.Ty E = C.subT E G1 (OV.wkT Nl Qt Qt) pE ;
 PC : Id (C.Ty E) (C.subT E D1 (OV.wkT Nl Tm Qt) sg) T0 =
  transH (symH (C.subT-o E D1 Nl Qt (C.p Nl Tm) sg))
   (transH (apH {C.Sub E Nl} {C.Ty E} (\ s -> C.subT E Nl Qt s) (L.sub-ext E Nl (C.o E D1 Nl (C.p Nl Tm) sg) (C.o E G1 Nl (C.p Nl Qt) pE) (\ K w -> refl w.1.1)))
     (C.subT-o E G1 Nl Qt (C.p Nl Qt) pE)) ;
 clsE : C.El E T0 = OV.trE E (C.subT E D1 (OV.wkT Nl Tm Qt) sg) T0 PC (C.subt E D1 (OV.wkT Nl Tm Qt) QQ.cls sg) ;
 qE : C.El E T0 = C.subt E G1 (OV.wkT Nl Qt Qt) (C.q Nl Qt) pE ;
 IdE : C.Ty E = IJ.IdT E T0 clsE qE ;
 S : C.Ty G1 = SS.Sig G1 TmG IdE ;
 P : C.Ty G1 = TA.Tr G1 S ;
 -- the generic class: over nil.Tm, (t, refl) in S at (cls t)
 tauN (K : Ob) (w : V1.Ix (D1.ob K)) : V1.Ix (G1.ob K) = (w.1, QQ.cls.eob K w) ;
 tau : C.Sub D1 G1 = new L.PSub[D1, G1, tauN, \ J I f w ->
  apH {V1.Ix (Qt.1.tob J w.1)} {V1.Ix (G1.ob J)} (\ c -> (w.1, c))
   (symH (transH (L.tact-irr Nl Qt.1 J I f w.1 w.1 (refl w.1) (L.ntEq D1 Nl (L.pP Nl Tm.1) J I f w (D1.act J I f w) (refl (D1.act J I f w))) (QQ.cls.eob I w))
            (QQ.cls.enat J I f w (D1.act J I f w) (refl (D1.act J I f w)))))] ;
 X' : C.Ty D1 = C.subT D1 G1 TmG tau ;
 PX : Id (C.Ty D1) (C.subT D1 Nl Tm (C.p Nl Tm)) X' =
  transH (apH {C.Sub D1 Nl} {C.Ty D1} (\ s -> C.subT D1 Nl Tm s) (L.sub-ext D1 Nl (C.p Nl Tm) (C.o D1 G1 Nl (C.p Nl Qt) tau) (\ K w -> refl w.1)))
   (C.subT-o D1 G1 Nl Tm (C.p Nl Qt) tau) ;
 xv : C.El D1 X' = OV.trE D1 (C.subT D1 Nl Tm (C.p Nl Tm)) X' PX (C.q Nl Tm) ;
 xvrd (K : Ob) (w : V1.Ix (D1.ob K)) : Id (V1.Ix (X'.1.tob K w)) (xv.eob K w) w.2 =
  transH (CAppRd[a].trE-rd D1 (C.subT D1 Nl Tm (C.p Nl Tm)) X' PX (C.q Nl Tm) K w)
   (CAppRd[a].same-rd D1 (C.subT D1 Nl Tm (C.p Nl Tm)) X' PX K w (refl (X'.1.tob K w)) w.2) ;
 lf : C.Sub (C.ext D1 X') E = C.lift D1 G1 TmG tau ;
 rho : C.Sub D1 E = C.o D1 (C.ext D1 X') E lf (C.sec D1 X' xv) ;
 Y' : C.Ty (C.ext D1 X') = C.subT (C.ext D1 X') E IdE lf ;
 Tr0 : C.Ty D1 = C.subT D1 E T0 rho ;
 crd (K : Ob) (w : V1.Ix (D1.ob K)) : Id (V1.Ix (Tr0.1.tob K w)) ((C.subt D1 E T0 qE rho).eob K w) ((C.subt D1 E T0 clsE rho).eob K w) =
  symH (transH (CAppRd[a].trE-rd E (C.subT E D1 (OV.wkT Nl Tm Qt) sg) T0 PC (C.subt E D1 (OV.wkT Nl Tm Qt) QQ.cls sg) K (rho.nt K w))
    (transH (CAppRd[a].same-rd E (C.subT E D1 (OV.wkT Nl Tm Qt) sg) T0 PC K (rho.nt K w) (refl (T0.1.tob K (rho.nt K w))) (QQ.cls.eob K (sgN K (rho.nt K w))))
      (apH {V1.Ix (Tm.1.tob K w.1)} {V1.Ix (Qt.1.tob K w.1)} (\ s -> QQ.cls.eob K (w.1, s)) (xvrd K w)))) ;
 r1 : C.El D1 (IJ.IdT D1 Tr0 (C.subt D1 E T0 clsE rho) (C.subt D1 E T0 qE rho)) =
  CCmpU14[a].rwId D1 Tr0 (C.subt D1 E T0 qE rho) (C.subt D1 E T0 clsE rho) (C.subt D1 E T0 qE rho) (C.subt D1 E T0 qE rho)
   crd (\ K w -> refl ((C.subt D1 E T0 qE rho).eob K w)) (IJ.rfl D1 Tr0 (C.subt D1 E T0 qE rho)) ;
 yv : C.El D1 (C.subT D1 (C.ext D1 X') Y' (C.sec D1 X' xv)) =
  OV.trE D1 (C.subT D1 E IdE rho) (C.subT D1 (C.ext D1 X') Y' (C.sec D1 X' xv)) (C.subT-o D1 (C.ext D1 X') E IdE lf (C.sec D1 X' xv))
   (OV.trE D1 (IJ.IdT D1 Tr0 (C.subt D1 E T0 clsE rho) (C.subt D1 E T0 qE rho)) (C.subT D1 E IdE rho) (symH (IJ.IdT-nat D1 E T0 clsE qE rho)) r1) ;
 sp : C.El D1 (C.subT D1 G1 S tau) =
  OV.trE D1 (SS.Sig D1 X' Y') (C.subT D1 G1 S tau) (symH (FibCwF[a, a+].fibSig.Sig-nat D1 G1 TmG IdE tau)) (INm.pr D1 X' Y' xv yv) ;
 eP : C.El D1 (C.subT D1 G1 P tau) =
  OV.trE D1 (C.subT D1 (C.ext G1 S) (OV.wkT G1 S P) (Ex[C].exS D1 G1 S tau sp)) (C.subT D1 G1 P tau)
   (transH (symH (C.subT-o D1 (C.ext G1 S) G1 P (C.p G1 S) (Ex[C].exS D1 G1 S tau sp)))
     (apH {C.Sub D1 G1} {C.Ty D1} (\ s -> C.subT D1 G1 P s) (INm.p-extS D1 G1 S tau sp)))
   (C.subt D1 (C.ext G1 S) (OV.wkT G1 S P) (TA.inc G1 S) (Ex[C].exS D1 G1 S tau sp)) ;
 -- at a class
 h (t1 : AX.Term) : C.El Nl (C.subT Nl G1 P (Q1.GQ.Sec1[AX.cls t1].sec1)) =
  OV.trE Nl (C.subT Nl D1 (C.subT D1 G1 P tau) (C.sec Nl Tm (AX.RP.ct t1))) (C.subT Nl G1 P (Q1.GQ.Sec1[AX.cls t1].sec1))
   (transH (symH (C.subT-o Nl D1 G1 P tau (C.sec Nl Tm (AX.RP.ct t1))))
     (apH {C.Sub Nl G1} {C.Ty Nl} (\ s -> C.subT Nl G1 P s)
        (L.sub-ext Nl G1 (C.o Nl D1 G1 tau (C.sec Nl Tm (AX.RP.ct t1))) (Q1.GQ.Sec1[AX.cls t1].sec1) (\ K o ->
          apH {V1.Ix (Qt.1.tob K o)} {V1.Ix (G1.ob K)} (\ c -> (o, c))
           (symH (transH (CAppRd[a].trE-rd Nl (C.subT Nl D1 (OV.wkT Nl Tm Qt) (C.sec Nl Tm (AX.RP.ct t1))) Qt (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm Qt (AX.RP.ct t1))
                              (C.subt Nl D1 (OV.wkT Nl Tm Qt) QQ.cls (C.sec Nl Tm (AX.RP.ct t1))) K o)
                    (CAppRd[a].same-rd Nl (C.subT Nl D1 (OV.wkT Nl Tm Qt) (C.sec Nl Tm (AX.RP.ct t1))) Qt (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm Qt (AX.RP.ct t1)) K o
                       (refl (Qt.1.tob K o)) (QQ.cls.eob K (o, (AX.RP.ct t1).eob K o)))))))))
   (C.subt Nl D1 (C.subT D1 G1 P tau) eP (C.sec Nl Tm (AX.RP.ct t1))) ;
 -- every element is merely a class
 msurj : C.El G1 P = Q1.elimP1 P (TA.trProp G1 S) h ;
} ;
