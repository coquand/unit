-- CFibTc.seg (canonicity-45; COBAR.md "comparison"): G's fibres at a copy
-- y', read as a closed type (CRestrHT's ClT), are fibrant: CGBr's
-- structure at the total site, moved to the levelwise site (CTotUFib4),
-- restricted to the copy (CCopy8) and substituted at the terminal point.
-- This is E1's Kan composition parameter cTp (CE1Copy).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module FT (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module GB = CGBr[a].GBr[R, encK, pe] ;
 module TR = GB.LB.TR ;
 module CT = GB.CT ;
 module U4 = CTotUFib4[a, a+, a+].UFib4[GB.YF.CM.IC] ;
 fb0 : TR.G0.GB.CLine[a+].Lines[TR.RS.rC CT.P1, TR.RS.rT CT.P1 GB.GT].Fib = U4.fibU CT.P1 GB.GT GB.fbGT ;
 module Cy = CCopy[a].ConcC[R, encK, pe].Copy[y'] ;
 DY : L.PCtx = Cy.rCy (TR.RS.rC CT.P1) ;
 AY : L.PTy[DY] = Cy.rTy (TR.RS.rC CT.P1) (TR.RS.rT CT.P1 GB.GT) ;
 fbY : PB.CLine[a+].Lines[DY, AY].Fib = CCopy8[a].FibR[R, encK, pe, TR.RS.rC CT.P1, TR.RS.rT CT.P1 GB.GT, fb0, y'].fib ;
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 sP : L.PSub[Nl, DY] = new L.PSub[Nl, DY, \ W k -> k, \ Vv W g k -> refl (DY.act Vv W g k)] ;
 fbN : PB.CLine[a+].Lines[Nl, L.subTy Nl DY AY sP].Fib = PB.CFibSub[a+].FibSub[Nl, DY, sP, AY].sub fbY ;
} ;

-- the plug into CE1Copy
module Plug (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) (y' : SX.Over[R].Presentation) {
 module E = CE1Copy[a].E1C[R, encK, pe, al, eqal, commH, y'] ;
 module F = FT[R, encK, pe, y'] ;
 St : L.PTy[E.Nl] = L.subTy F.Nl F.DY F.AY F.sP ;
 module TS = PB.GPre[a+].TyL[E.Nl, St] ;
 module TT = PB.GPre[a+].TyL[E.Nl, E.Tc] ;
 ta (W : Ob) (v : TT.EI W) : TS.EI W = TS.pr W v.1 v.2 ;
 fq (Vv W : Ob) (g : Hom Vv W) (o : Top) (w : V1.Ix (E.Tc.tob W o))
  : Id (V1.Ix (St.tob Vv (E.Nl.act Vv W g o))) (St.tact Vv W g o (E.Nl.act Vv W g o) (refl (E.Nl.act Vv W g o)) w) (E.Tc.tact Vv W g o (E.Nl.act Vv W g o) (refl (E.Nl.act Vv W g o)) w) =
  refl (E.Tc.tact Vv W g o (E.Nl.act Vv W g o) (refl (E.Nl.act Vv W g o)) w) ;
 module MV = PB.CCart[a+, a+].Cart[E.Nl, E.Tc, E.Nl, St, \ W o -> o, \ Vv W g o -> refl (E.Nl.act Vv W g o), ta, \ W v -> refl v.1,
   \ Vv W g v -> refl (ta Vv (TT.E.act Vv W g v)), \ W v v' Pp Q -> Q, \ X x u -> u, \ X x u -> refl (TS.pr X x u)] ;
 fbTc : PB.CLine[a+].Lines[E.Nl, E.Tc].Fib = MV.moveFib F.fbN ;
 cTp : PB.CLine[a+].Lines[E.Nl, E.Tc].CompK[PB.e0, PB.e1].Comp = fbTc.1 ;
} ;
