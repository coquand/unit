-- CCmpU20.seg (canonicity-c2; (K) for cmpI, part 20): the binary cases of
-- (U): from the two data and the Ids at the arguments, the Id at the value.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module U20 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module U19m = CCmpU19[a].U19[R, encK, pe, y] ;
 module U13m = U19m.U13m ;
 module U16m = U19m.U16m ;
 module HZ = U16m.HZ ;
 Nl : C.Ctx = C.nil ;
 H : C.Ty Nl = U19m.H ;
 GH : C.Ctx = U19m.GH ;
 HS : C.Ty Nl = U19m.HS ;
 D1 : C.Ctx = U19m.D1 ;
 QA : C.Ty Nl = U19m.QA ;
 QY : C.Ty Nl = U19m.QY ;
 QYh : C.Ty GH = U19m.QYh ;
 -- the two homs of a point of nil.H
 pkA (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HS.1.tob K w.1) = w.2.1 ;
 pkB (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HS.1.tob K w.1) = w.2.2.1 ;
 pkAN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J (GH.act J I f w)) =
  refl (HS.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) ;
 pkBN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J (GH.act J I f w)) =
  L.tact-irr Nl HS.1 J I f w.1 w.1 (refl w.1)
   (L.ntEq D1 Nl (L.pP Nl HS.1) J I f (w.1, w.2.1) (Nl.act J I f w.1, HS.1.tact J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1)
      (L.pair-act Nl HS.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1))
   w.2.2.1 ;
 -- the data of + and * of the hom of a point of D1
 module BZ = U16m.BZ ;
 Gh : C.Ctx = U16m.Gh ;
 MapT : C.Ty Nl = U16m.MapT ;
 sAn (K : Ob) (w : V1.Ix (D1.ob K)) : V1.Ix (Gh.ob K) = U16m.sAn K w ;
 module BA = BZ.BinOf[HZ.AS.O.addQ, HZ.AT.O.addQ] ;
 module BM = BZ.BinOf[HZ.AS.O.mulQ, HZ.AT.O.mulQ] ;
 E0 (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I)) : Id (V1.Ix (Gh.ob J)) (Gh.act J I f (sAn I w)) (sAn J (D1.act J I f w)) =
  L.pair-act Nl MapT.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1 ;
 dkA (K : Ob) (w : V1.Ix (D1.ob K)) : V1.Ix (BA.DataBin.1.tob K (sAn K w)) = w.2.2.1 ;
 dkAN (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I))
   : Id (V1.Ix (BA.DataBin.1.tob J (sAn J (D1.act J I f w))))
        ((C.subT D1 Gh BA.DataBin U16m.sA).1.tact J I f w (D1.act J I f w) (refl (D1.act J I f w)) (dkA I w)) (dkA J (D1.act J I f w)) =
  L.tact-irr Gh BA.DataBin.1 J I f (sAn I w) (sAn J (D1.act J I f w))
    (L.ntEq D1 Gh U16m.sA J I f w (D1.act J I f w) (refl (D1.act J I f w))) (E0 J I f w) w.2.2.1 ;
 dkM (K : Ob) (w : V1.Ix (D1.ob K)) : V1.Ix (BM.DataBin.1.tob K (sAn K w)) = w.2.2.2.1 ;
 dkMN (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I))
   : Id (V1.Ix (BM.DataBin.1.tob J (sAn J (D1.act J I f w))))
        ((C.subT D1 Gh BM.DataBin U16m.sA).1.tact J I f w (D1.act J I f w) (refl (D1.act J I f w)) (dkM I w)) (dkM J (D1.act J I f w)) =
  L.tact-irr Gh BM.DataBin.1 J I f (sAn I w) (sAn J (D1.act J I f w))
    (L.ntEq D1 Gh U16m.sA J I f w (D1.act J I f w) (refl (D1.act J I f w)))
    (L.ntEq (L.extP Gh BA.DataBin.1) Gh (L.pP Gh BA.DataBin.1) J I f (sAn I w, w.2.2.1)
       (sAn J (D1.act J I f w), BA.DataBin.1.tact J I f (sAn I w) (sAn J (D1.act J I f w)) (E0 J I f w) w.2.2.1)
       (L.pair-act Gh BA.DataBin.1 J I f (sAn I w) (sAn J (D1.act J I f w)) (E0 J I f w) w.2.2.1))
    w.2.2.2.1 ;
 -- a binary case
 IdZ (c : C.El Nl QA) : C.Ty GH = IJ.IdT GH QYh (U13m.ZA.apC c) (U13m.ZB.apC c) ;
 module Bin (opS : C.El Nl (OV.Fun Nl QA (OV.Fun Nl QA QA))) (opT : C.El Nl (OV.Fun Nl QY (OV.Fun Nl QY QY)))
   (dk : (K : Ob) (w : V1.Ix (D1.ob K)) -> V1.Ix (BZ.BinOf[opS, opT].DataBin.1.tob K (sAn K w)))
   (dkN : (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I))
     -> Id (V1.Ix (BZ.BinOf[opS, opT].DataBin.1.tob J (sAn J (D1.act J I f w))))
          ((C.subT D1 Gh BZ.BinOf[opS, opT].DataBin U16m.sA).1.tact J I f w (D1.act J I f w) (refl (D1.act J I f w)) (dk I w)) (dk J (D1.act J I f w)))
   (ct cs cv : C.El Nl QA) (bt : C.El Nl (IJ.IdT Nl QA (OV.app Nl QA QA (OV.app Nl QA (OV.Fun Nl QA QA) opS ct) cs) cv))
   (hA : C.El GH (IdZ ct)) (hB : C.El GH (IdZ cs)) {
  module PA = U19m.PBk[opS, opT, dk, dkN, ct, cs, cv, bt, pkA, pkAN, U13m.ZA.apC, U13m.ZA.rdF] ;
  module PB = U19m.PBk[opS, opT, dk, dkN, ct, cs, cv, bt, pkB, pkBN, U13m.ZB.apC, U13m.ZB.rdF] ;
  module A2 = CCmpU18[a].Ap2[GH, QY, opT, C.p Nl H] ;
  vA : C.El GH QYh = A2.O.P2[U13m.ZA.apC ct, U13m.ZA.apC cs].val ;
  vB : C.El GH QYh = A2.O.P2[U13m.ZB.apC ct, U13m.ZB.apC cs].val ;
  res : C.El GH (IdZ cv) =
   PT.transM GH QYh (U13m.ZA.apC cv) vA (U13m.ZB.apC cv)
    (PT.symM GH QYh vA (U13m.ZA.apC cv) PA.res)
    (PT.transM GH QYh vA vB (U13m.ZB.apC cv) (A2.ap2 (U13m.ZA.apC ct) (U13m.ZB.apC ct) (U13m.ZA.apC cs) (U13m.ZB.apC cs) hA hB) PB.res) ;
 } ;
} ;
