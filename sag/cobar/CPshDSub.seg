-- CPshDSub.seg (canonicity-c2; COBAR.md): the cobar construction D of
-- Cobar.seg on C-substitutions.
--
-- For s : De -> G, D s : D De -> D G applies s to every value of a
-- family: (D s u) q = s_z (u q), z and J read off the index q.  The
-- index of a family does not mention the context, so nothing is
-- reindexed, and the three equations of u are carried by s: naturality
-- in the base by the naturality of s_z, the inner faces by congruence,
-- the top face by the C-naturality of s.
--   DSb s        : CSub[D De, D G]
--   DSb-id       D of the identity is the identity
--   DSb-o        D (s o t) = D s o D t
--   tau-nat      D s o tau = tau o s      (the unit is natural)
-- Premises: fe (through Cobar's ob-eq).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module Wt = Weights[a, l] ;

module DSubOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 CO : U a = P.CO ;
 CH (y x : CO) : U a = P.CH y x ;

 module S (De G : P.CCtx) (s : P.CSub[De, G]) {
  module DE = DD.DC[De] ;
  module DG = DD.DC[G] ;

  -- s applied to the values of a family
  module Sn (x : CO) (X : Ob) (u : DE.Ob' x X) {
   t' : DG.T x X = \ q l -> (s.sb q.2.1).nt q.2.2.2.1 (u.1 q l) ;
   nat' : W0.Ix (DG.natEq x X t') = \ r l ->
    transH (symH ((s.sb r.1.2.1).nt-nat r.2.1 r.1.2.2.2.1 r.2.2 (u.1 r.1 l)))
     (apH ((s.sb r.1.2.1).nt r.2.1) (u.2.1 r l)) ;
   face' : W0.Ix (DG.faceEq x X t') = \ r l ->
    apH ((s.sb r.2.2.2.1).nt r.2.2.2.2.2.1) (u.2.2.1 r l) ;
   top' : W0.Ix (DG.topEq x X t') = \ r l ->
    transH (apH ((s.sb r.2.1).nt r.2.2.2.1) (u.2.2.2 r l))
     (s.sb-nat r.2.1 (DG.topD x X r).1 (DG.topD x X r).2.2 r.2.2.2.1
        (u.1 (r.1, (DG.topD x X r).1, (DG.topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l)) ;
   res : DG.Ob' x X = (t', nat', face', top') ;
  } ;

  sbX (x : CO) : PSub[DE.obD x, DG.obD x] =
   new PSub[DE.obD x, DG.obD x, \ X u -> Sn[x, X, u].res,
    \ Y X h u -> DG.ob-eq x Y Sn[x, Y, DE.BA[x, Y, X, h, u].res].res DG.BA[x, Y, X, h, Sn[x, X, u].res].res
       (\ q l -> refl (Sn[x, Y, DE.BA[x, Y, X, h, u].res].t' q l))] ;

  DSb : P.CSub[DE.DCtx, DG.DCtx] =
   new P.CSub[DE.DCtx, DG.DCtx, sbX,
    \ y x f X u -> DG.ob-eq y X Sn[y, X, DE.CA[y, x, f, X, u].res].res DG.CA[y, x, f, X, Sn[x, X, u].res].res
       (\ q l -> refl (Sn[y, X, DE.CA[y, x, f, X, u].res].t' q l))] ;

  -- the unit is natural
  tau-nat : Id (P.CSub[De, DG.DCtx]) (CW.coC De DE.DCtx DG.DCtx DSb DE.tau) (CW.coC De G DG.DCtx DG.tau s) =
   EX.csub-ext De DG.DCtx (CW.coC De DE.DCtx DG.DCtx DSb DE.tau) (CW.coC De G DG.DCtx DG.tau s) (\ x X gm ->
    DG.ob-eq x X Sn[x, X, DE.Tau[x, X, gm].res].res DG.Tau[x, X, (s.sb x).nt X gm].res (\ q l ->
     transH (s.sb-nat q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1) q.2.2.2.1 ((De.ob x).act q.2.2.2.1 X q.2.2.2.2.1 gm))
      (apH ((G.act q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1)).nt q.2.2.2.1) ((s.sb x).nt-nat q.2.2.2.1 X q.2.2.2.2.1 gm)))) ;
 } ;

 DSb (De G : P.CCtx) (s : P.CSub[De, G]) : P.CSub[DD.DC[De].DCtx, DD.DC[G].DCtx] = S[De, G, s].DSb ;

 DSb-id (G : P.CCtx) : Id (P.CSub[DD.DC[G].DCtx, DD.DC[G].DCtx]) (DSb G G (CW.cidC G)) (CW.cidC DD.DC[G].DCtx) =
  EX.csub-ext DD.DC[G].DCtx DD.DC[G].DCtx (DSb G G (CW.cidC G)) (CW.cidC DD.DC[G].DCtx) (\ x X u ->
   DD.DC[G].ob-eq x X S[G, G, CW.cidC G].Sn[x, X, u].res u (\ q l -> refl (u.1 q l))) ;

 DSb-o (T De G : P.CCtx) (s : P.CSub[De, G]) (t : P.CSub[T, De])
  : Id (P.CSub[DD.DC[T].DCtx, DD.DC[G].DCtx]) (DSb T G (CW.coC T De G s t))
       (CW.coC DD.DC[T].DCtx DD.DC[De].DCtx DD.DC[G].DCtx (DSb De G s) (DSb T De t)) =
  EX.csub-ext DD.DC[T].DCtx DD.DC[G].DCtx (DSb T G (CW.coC T De G s t))
   (CW.coC DD.DC[T].DCtx DD.DC[De].DCtx DD.DC[G].DCtx (DSb De G s) (DSb T De t)) (\ x X u ->
   DD.DC[G].ob-eq x X S[T, G, CW.coC T De G s t].Sn[x, X, u].res S[De, G, s].Sn[x, X, S[T, De, t].Sn[x, X, u].res].res
    (\ q l -> refl (S[T, G, CW.coC T De G s t].Sn[x, X, u].t' q l))) ;

 ------------------------------------------------------------------
 -- D on elements: (D a u) q = a_z (u q).  The equations are those of
 -- u, carried by the section g |-> (g , a_z g) of the total of A_z.

 module El (G : P.CCtx) (A : P.CTy[G]) (el : P.CEl[G, A]) {
  module DG = DD.DC[G] ;
  module DA = DD.DT[G, A] ;
  sec (z : CO) (J : Ob) (g : W0.Ix ((G.ob z).ob J)) : W0.Ix (DA.Ez z J) = DA.prz z J g ((el.el z).eob J g) ;
  -- the section commutes with the base action
  sec-act (z : CO) (J' J : Ob) (h : Hom J' J) (g : W0.Ix ((G.ob z).ob J))
   : Id (W0.Ix (DA.Ez z J')) ((extP (G.ob z) (A.ty z)).act J' J h (sec z J g)) (sec z J' ((G.ob z).act J' J h g)) =
   symH ((secP (G.ob z) (A.ty z) (el.el z)).nt-nat J' J h g) ;

  module En (x : CO) (X : Ob) (u : DG.Ob' x X) {
   a' : DA.TA x X u = \ q l -> (el.el q.2.1).eob q.2.2.2.1 (u.1 q l) ;
   nat' : W0.Ix (DA.anatEq x X u a') = \ r l ->
    transH (sec-act r.1.2.1 r.2.1 r.1.2.2.2.1 r.2.2 (u.1 r.1 l)) (apH (sec r.1.2.1 r.2.1) (u.2.1 r l)) ;
   face' : W0.Ix (DA.afaceEq x X u a') = \ r l -> apH (sec r.2.2.2.1 r.2.2.2.2.2.1) (u.2.2.1 r l) ;
   top' : W0.Ix (DA.atopEq x X u a') = \ r l ->
    transH (apH (sec r.2.1 r.2.2.2.1) (u.2.2.2 r l))
     (symH (el.el-nat r.2.1 (DG.topD x X r).1 (DG.topD x X r).2.2 r.2.2.2.1
              (u.1 (r.1, (DG.topD x X r).1, (DG.topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))) ;
   res : DA.TOb' x X u = (a', nat', face', top') ;
  } ;

  elX (x : CO) : PEl[DG.obD x, DA.DTy x] =
   new PEl[DG.obD x, DA.DTy x, \ X u -> En[x, X, u].res,
    \ Y X h u v e -> DA.tob-eq x Y v (DA.TB[x, Y, X, h, u, v, e, En[x, X, u].res].res) En[x, Y, v].res (\ q l ->
      GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (v.1 q l) (DA.TB[x, Y, X, h, u, v, e, En[x, X, u].res].a' q l) (En[x, Y, v].a' q l)
       (transH (DA.TB[x, Y, X, h, u, v, e, En[x, X, u].res].pc q l)
         (apH (sec q.2.1 q.2.2.2.1) (DA.TB[x, Y, X, h, u, v, e, En[x, X, u].res].pe q l))))] ;

  DEl : P.CEl[DG.DCtx, DA.DCTy] =
   new P.CEl[DG.DCtx, DA.DCTy, elX,
    \ y x f X u -> DA.totD-eq y X
       ((DA.tEC y x f).nt X (pairE (DG.obD x) (DA.DTy x) X u En[x, X, u].res))
       (pairE (DG.obD y) (DA.DTy y) X (DG.CA[y, x, f, X, u].res) En[y, X, DG.CA[y, x, f, X, u].res].res)
       (refl (DG.CA[y, x, f, X, u].res))
       (\ q l -> refl (sec q.2.1 q.2.2.2.1 (DG.CA[y, x, f, X, u].t' q l)))] ;
 } ;
 DEl (G : P.CCtx) (A : P.CTy[G]) (el : P.CEl[G, A]) : P.CEl[DD.DC[G].DCtx, DD.DT[G, A].DCTy] = El[G, A, el].DEl ;
} ;
