-- Finite coefficient vectors in a base-CwF h-set ring.  Their linear
-- combination respects vector addition and multiplication by a ring
-- element.  All algebraic laws below are internal paths.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Ring[a++] ;

module Vec (G : CFinIntPilot[a].C.Ctx) (Rg : CFinIntPilot[a].PR.HRing[G]) {
 module P = CFinIntPilot[a].Pilot[G, Rg] ;
 module CG = P.CG ;
 E : U a++ = P.E ;
 add (x y : E) : E = P.add x y ;
 mul (x y : E) : E = P.mul x y ;
 Path (x y : E) : U a++ = P.Path x y ;
 Cof : List E -> U a++ = split {
  nil -> Top ; cons f fs | ih -> E * ih } ;
 lin : (fs : List E) -> Cof fs -> E = split {
  nil -> \ c -> Rg.zero ;
  cons f fs | ih -> \ c -> add (mul f c.1) (ih c.2) } ;
 plus : (fs : List E) -> Cof fs -> Cof fs -> Cof fs = split {
  nil -> \ c d -> tt ;
  cons f fs | ih -> \ c d -> (add c.1 d.1, ih c.2 d.2) } ;
 scale : (fs : List E) -> Cof fs -> E -> Cof fs = split {
  nil -> \ c r -> tt ;
  cons f fs | ih -> \ c r -> (mul c.1 r, ih c.2 r) } ;

 -- (p+q)+(r+s) = (p+r)+(q+s).
 middle (q r s : E) : Path (add q (add r s)) (add r (add q s)) =
  P.tr (add q (add r s)) (add (add q r) s) (add r (add q s))
   (P.sy (add (add q r) s) (add q (add r s)) (Rg.add-assoc q r s))
   (P.tr (add (add q r) s) (add (add r q) s) (add r (add q s))
     (CG.addL (add q r) (add r q) s (Rg.add-comm q r))
     (Rg.add-assoc r q s)) ;
 swap (p q r s : E) : Path (add (add p q) (add r s)) (add (add p r) (add q s)) =
  P.tr (add (add p q) (add r s)) (add p (add q (add r s))) (add (add p r) (add q s))
   (Rg.add-assoc p q (add r s))
   (P.tr (add p (add q (add r s))) (add p (add r (add q s))) (add (add p r) (add q s))
     (CG.addR p (add q (add r s)) (add r (add q s)) (middle q r s))
     (P.sy (add (add p r) (add q s)) (add p (add r (add q s)))
       (Rg.add-assoc p r (add q s)))) ;

 lin-plus : (fs : List E) (c d : Cof fs) -> Path (lin fs (plus fs c d)) (add (lin fs c) (lin fs d)) = split {
  nil -> \ c d -> P.sy (add Rg.zero Rg.zero) Rg.zero (Rg.add-zero Rg.zero) ;
  cons f fs | ih -> \ c d ->
   P.tr (add (mul f (add c.1 d.1)) (lin fs (plus fs c.2 d.2)))
        (add (add (mul f c.1) (mul f d.1)) (add (lin fs c.2) (lin fs d.2)))
        (add (add (mul f c.1) (lin fs c.2)) (add (mul f d.1) (lin fs d.2)))
    (CG.add2 (mul f (add c.1 d.1)) (add (mul f c.1) (mul f d.1))
      (lin fs (plus fs c.2 d.2)) (add (lin fs c.2) (lin fs d.2))
      (Rg.distr f c.1 d.1) (ih c.2 d.2))
    (swap (mul f c.1) (mul f d.1) (lin fs c.2) (lin fs d.2)) } ;
 lin-scale : (fs : List E) (c : Cof fs) (r : E) -> Path (lin fs (scale fs c r)) (mul (lin fs c) r) = split {
  nil -> \ c r -> P.sy (mul Rg.zero r) Rg.zero (Rg.mul-zero r) ;
  cons f fs | ih -> \ c r ->
   P.tr (add (mul f (mul c.1 r)) (lin fs (scale fs c.2 r)))
        (add (mul (mul f c.1) r) (mul (lin fs c.2) r))
        (mul (add (mul f c.1) (lin fs c.2)) r)
    (CG.add2 (mul f (mul c.1 r)) (mul (mul f c.1) r)
      (lin fs (scale fs c.2 r)) (mul (lin fs c.2) r)
      (P.sy (mul (mul f c.1) r) (mul f (mul c.1 r)) (Rg.mul-assoc f c.1 r))
      (ih c.2 r))
    (P.sy (mul (add (mul f c.1) (lin fs c.2)) r)
      (add (mul (mul f c.1) r) (mul (lin fs c.2) r))
      (P.distRight (mul f c.1) (lin fs c.2) r)) } ;
} ;
