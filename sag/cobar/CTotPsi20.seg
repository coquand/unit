-- CTotPsi20.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 20: the lift back bk.  The line Lb of
-- D G . D A over ln (its naturality: D's oPath and ivA-comp), its
-- projection is ln (eqLb, by computation), and its end is w (pthLb: D's
-- idPath, ptH-nat and u's end condition).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi20 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P17 = CTotPsi17[a, vl, l].Psi17[C, G, A, e] ;
 module P18 = CTotPsi18[a, vl, l].Psi18[C, G, A, e] ;
 module P19 = CTotPsi19[a, vl, l].Psi19[C, G, A, e] ;
 module P13 = P17.P13 ;
 module P10 = P17.P10 ;
 module P12 = P13.P12 ;
 module PO = P17.PO ;
 module TR = PO.TR ;
 module G1 = TR.G1 ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module D = PO.D ;
 module DA = P17.DA ;
 module EKg = P17.EKg ;
 module EKd = P17.EKd ;
 module FTg = P17.FTg ;
 module FTd = P12.FTd ;
 module LM = CTotL12m[a, vl, l].L12m[C, G, A] ;
 module LB = LM.LB ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;

 module BK (X : TC.TOb) (w : EKd.TV.EI X) (u : P13.DS.TOb' X.1 X.2 (P10.psi X w)) {
  module B = P17.BKd[X, w, u] ;
  ln : W0.Ix (PO.FL.ob X) = B.PP.ln ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  ab (Wd : TC.TOb) (f : TC.THm Wd X) (j : PB.IvP Wd.1) : DA.TOb' Wd.1 Wd.2 (ln.1 Wd f j) =
   (B.AB[Wd, f, j].abfam, P18.AN[X, w, u, Wd, f, j].anat, P19.FT[X, w, u, Wd, f, j].aface, P19.FT[X, w, u, Wd, f, j].atop) ;
  Lv (Wd : TC.TOb) (f : TC.THm Wd X) (j : PB.IvP Wd.1) : LM.Tot Wd = (ln.1 Wd f j, ab Wd f j) ;
  module NL (V' W : TC.TOb) (g : TC.THm V' W) (f : TC.THm W X) (j : PB.IvP W.1) {
   fg : TC.THm V' X = TC.tcomp V' W X f g ;
   jg : PB.IvP V'.1 = PB.ivA V'.1 W.1 g.1 j ;
   module RD (q : DO.Idx V'.1 V'.2) (lq : DO.LandsI V'.1 V'.2 q) {
    rqg : DO.Idx W.1 W.2 = D.Act[V'.1, W.1, g.1, V'.2, W.2, g.2, (ln.1 W f j)].rq q ;
    module R1 = B.AB[W, f, j].RQ[rqg, lq] ;
    module R2 = B.AB[V', fg, jg].RQ[q, lq] ;
    Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
    lineAt (sw : D.S I x q.1 q.2.1 q.2.2.2.1) (jj : PB.IvP q.2.1) : EKg.TA.EI Y =
     (B.lineE (q.1, q.2.1, sw.1, q.2.2.2.1, sw.2, q.2.2.2.2.2) lq).1 Y (TC.tid Y) jj ;
    law : Id (DA.Ez q.2.1 q.2.2.2.1) (LB.rdT V' (LB.EE.act V' W g (Lv W f j)) q lq) (LB.rdT V' (Lv V' fg jg) q lq) =
     transH (LB.actRd V' W g (Lv W f j) q lq)
      (transH R1.aeq
        (transH (apH {D.S I x q.1 q.2.1 q.2.2.2.1} {EKg.TA.EI Y} (\ sw -> lineAt sw R1.RC.j0)
                   (D.oPath V'.1 W.1 I f.1 g.1 V'.2 W.2 x f.2 g.2 q))
          (transH (apH {PB.IvP q.2.1} {EKg.TA.EI Y} (\ jj -> lineAt (R2.RC.U0, R2.RC.cc) jj)
                     (symH (PB.ivA-comp q.2.1 V'.1 W.1 g.1 q.2.2.1 j)))
            (symH R2.aeq)))) ;
   } ;
   law : Id (LM.Tot V') (LB.EE.act V' W g (Lv W f j)) (Lv V' fg jg) =
    LM.totEq V' (LB.EE.act V' W g (Lv W f j)) (Lv V' fg jg) (ln.2 V' W g f j) (\ q lq -> RD[q, lq].law) ;
  } ;
  Lb : W0.Ix (FTd.FE.ob X) = (\ W f j -> Lv W f j, \ V' W g f j -> NL[V', W, g, f, j].law) ;
  eqLb : Id (W0.Ix (PO.FL.ob X)) (FTd.piL X Lb) ln = PO.FL.fam-eq X (FTd.piL X Lb) ln (\ W f j -> refl (ln.1 W f j)) ;
  wl : EKd.TL.EI X = EKd.TL.pr X ln (Lb, eqLb) ;
  pe : PB.IvP I = G1.GB.ptH X e ;
  module ED (q : DO.Idx I x) (lq : DO.LandsI I x q) {
   module R = B.AB[X, TC.tid X, pe].RQ[q, lq] ;
   module QG = B.PP.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)] ;
   Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
   lineAt (sw : D.S I x q.1 q.2.1 q.2.2.2.1) : EKg.TA.EI Y =
    (B.lineE (q.1, q.2.1, sw.1, q.2.2.2.1, sw.2, q.2.2.2.2.2) lq).1 Y (TC.tid Y) R.RC.j0 ;
   wlq : EKg.TL.EI Y = EKg.TL.pr Y QG.Q.psiq (u.1 q lq).1 ;
   law : Id (DA.Ez q.2.1 q.2.2.2.1) (LB.rdT X (Lv X (TC.tid X) pe) q lq) (DA.prz q.2.1 q.2.2.2.1 (B.PP.u0.1 q lq) (B.PP.av.1 q lq)) =
    transH R.aeq
     (transH (apH {D.S I x q.1 q.2.1 q.2.2.2.1} {EKg.TA.EI Y} lineAt (D.idPath I x q))
       (transH (apH {PB.IvP q.2.1} {EKg.TA.EI Y} (\ jj -> (B.lineE q lq).1 Y (TC.tid Y) jj) (PB.ptH-nat q.2.1 I q.2.2.1 e))
         (transH (symH (FTg.Ev[e].endB-E Y wlq))
           (transH (apH {EKg.TV.EI Y} {EKg.TA.EI Y} (EKg.endE Y) (u.1 q lq).2)
             QG.pc)))) ;
  } ;
  endL : Id (LM.Tot X) (Lv X (TC.tid X) pe) (FTd.TA.pr X B.PP.u0 B.PP.av) =
   LM.totEq X (Lv X (TC.tid X) pe) (FTd.TA.pr X B.PP.u0 B.PP.av) (refl B.PP.u0) (\ q lq -> ED[q, lq].law) ;
  pthLb : Id (EKd.TV.EI X) (FTd.Ev[e].evA.mE X wl) w =
   EKd.tv-eq X (FTd.Ev[e].evA.mE X wl) w (refl ln) (transH (FTd.Ev[e].endB-E X wl) endL) ;
  bk : W0.Ix (EKd.SFm.sfOb X w) = ((Lb, eqLb), pthLb) ;
 } ;
} ;
