-- CPshContrC.seg (canonicity-c2; COBAR.md, the S3 bridge, part (III),
-- P1): in the CwF of uniformly fibrant C-types, an element of the
-- internal isContr T is the same as a uniform ContrOp of T (UTriv:
-- a ContrOp at each x, commuting with the C-action).
--
-- The internal isContr T is Sigma (c : T) Pi (y : T) Id(c , y).  An
-- element gives a centre (cenOf) and, by the Pi-iso of the function
-- part, a contraction: an element of Id(c[p] , q) over G.T; CPshContr.C2
-- makes a uniform ContrOp of these.  Conversely CPshContr.C1 gives a
-- centre and a contraction, and mkContr packs them.
--   toUT    El G (isContr G T) -> UTriv G T.1
--   fromUT  UTriv G T.1 -> El G (isContr G T)
-- Premises: those of CPshContr, CPshPiFibC, CPshSigFib, CPshIdJ4.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ContrCOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module IDm = CPshId[a, l].IdOf[C] ;
 module CT = CPshContr[a, l].CtrOf[C] ;
 module PCl = CPshPiFibC[a, l].PiClOf[C] ;
 module SCl = CPshSigFib[a, l].SigFibOf[C] ;
 module IJ = CPshIdJ4[a, l].IdJOf[C] ;
 CF : CwF.CwF[l+] = UF.CFibCwF ;
 module SG = CwFSing.Sing[l+, CF, PCl.FPiC.SPi, SCl.FSigC.SSig, IJ.PIdJ] ;
 module EQ = CwFEq.Eqv[l+, CF, PCl.FPiC.SPi, SCl.FSigC.SSig, IJ.PIdJ] ;

 module To (G : P.CCtx) (T : UF.FCC.STy G) (kc : CF.El G (EQ.isContr G T)) {
  GT : P.CCtx = LO.ExtC G T.1 ;
  c : P.CEl[G, T.1] = SG.cenOf G T kc ;
  -- the contraction, an element of Id(c[p] , q) over G.T
  ctr : P.CEl[GT, IDm.IdC[GT, LO.subCTy GT G (LO.pPC G T.1) T.1, CW.subCEl GT G T.1 c (LO.pPC G T.1), CW.qC G T.1].IdT] =
   (PCl.FPiC.SPi.Pi-iso G T (SG.JP.IK G T c)).fun (SG.ctrPiOf G T kc) ;
  ut : P.UTriv G T.1 = CT.C2[G, T, c, ctr].ut ;
 } ;
 toUT (G : P.CCtx) (T : UF.FCC.STy G) (kc : CF.El G (EQ.isContr G T)) : P.UTriv G T.1 = To[G, T, kc].ut ;

 fromUT (G : P.CCtx) (T : UF.FCC.STy G) (ut : P.UTriv G T.1) : CF.El G (EQ.isContr G T) =
  SG.mkContr G T CT.C1[G, T, ut].c CT.C1[G, T, ut].ctr ;
} ;
