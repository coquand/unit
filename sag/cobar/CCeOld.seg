-- CCeOld.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', over the
-- empty context, on the closed copy Ec of yo(y).A: for each generator i of y,
-- psi of the G-value tau(pre_{k_i} d) is homotopic to the value at the
-- class of x_i of the hom alpha(d) (CPsiC's eps . tau ~ id, the reading of
-- eval at a composite code, CEvAt along SubC's beta at the generator).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module CO (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module CB = CCeBase[a].CB[R, encK, pe, y, u, y'] ;
 module PQ = CPsiQ[a].PQ[R, encK, pe, y'] ;
 module HO = CB.HO ;
 module T1y = CE1Tot[a].T1[R, encK, pe, y] ;
 module E1v = PQ.RA.RD.E1v ;
 Nl : L.PCtx = CB.Nl ;
 Ec : L.PTy[Nl] = CB.Ec ;
 module Gi (i : SX.Fin y.1) {
  module KSi = T1y.KS[var i] ;
  module PRi = T1y.PreN[y, T1y.CM.F1, KSi.S.M.mor, KSi.S.M.mor-nat].PR ;
  Pk : FibCwF[a, a+].fibCwF.El Nl (CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId].Fun Nl KSi.S.SM.AS.Qt KSi.S.SM.AT.Qt) = KSi.S.SM.Phi ;
  module B0 = CHomT1[a].BaseOf[KSi.S.SM.AT.Qt, E1v.QY] ;
  rd1 (I : Ob) (w : V1.Ix (Ec.tob I tt))
   : Id (V1.Ix (PQ.Qc.tob I tt)) (PQ.evc.nfun I tt (PRi.pre I y' (CB.dOf I w)))
       (B0.hv I tt (CB.dOf I w).1 ((Pk.eob I tt).1 I (compH I I I (idH I) (idH I)) (E1v.cx.eob I tt))) = refl (PQ.evc.nfun I tt (PRi.pre I y' (CB.dOf I w))) ;
  -- the precomposition map Ec -> codes F1 -> y'
  pV (I : Ob) : (x : Top) -> V1.Ix (Ec.tob I x) -> V1.Ix (PQ.PC.Ac.tob I x) = split { tt -> \ w -> PRi.pre I y' (CB.dOf I w) } ;
  pVn (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
   : Id (V1.Ix (PQ.PC.Ac.tob J tt)) (PQ.PC.Ac.tact J I h tt tt e (PRi.pre I y' (CB.dOf I w))) (PRi.pre J y' (CB.dOf J (Ec.tact J I h tt tt e w))) =
   symH (PRi.pre-nat J I h y' y' (CB.RH.CM.IC.cart J I h y') (CB.dOf I w)) ;
  preN : HO.NMap[Nl, Ec, PQ.PC.Ac] = CB.TopN[PQ.PC.Ac, pV, pVn].nm ;
  -- the map part of alpha(d)
  MT : L.PTy[Nl] = B0.MapT.1 ;
  mV (I : Ob) : (x : Top) -> V1.Ix (Ec.tob I x) -> V1.Ix (MT.tob I x) = split { tt -> \ w -> (CB.dOf I w).1 } ;
  mVn (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
   : Id (V1.Ix (MT.tob J tt)) (MT.tact J I h tt tt e (CB.dOf I w).1) (CB.dOf J (Ec.tact J I h tt tt e w)).1 =
   apH {V1.Ix (CB.HXY.1.tob J tt)} {V1.Ix (MT.tob J tt)} (\ z -> z.1) (CB.k6 J I h e w) ;
  mapN : HO.NMap[Nl, Ec, MT] = CB.TopN[MT, mV, mVn].nm ;
  -- the two closed elements and SubC's beta at the generator
  module EAm = CEvAt[a].EA[KSi.S.SM.AT.Qt, E1v.QY] ;
  a0 : FibCwF[a, a+].fibCwF.El Nl KSi.S.SM.AT.Qt = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId].app Nl KSi.S.SM.AS.Qt KSi.S.SM.AT.Qt Pk E1v.cx ;
  b0 : FibCwF[a, a+].fibCwF.El Nl KSi.S.SM.AT.Qt = KSi.S.SM.AT.cls (KSi.S.SM.SB.sbT (var (inr tt))) ;
  eB : FibCwF[a, a+].fibCwF.El Nl (FibId[a, a+].fibId.IdT Nl KSi.S.SM.AT.Qt a0 b0) = KSi.S.SM.beta (var (inr tt)) ;
  -- the chain
  Ac : L.PTy[Nl] = PQ.PC.Ac ;
  Tc : L.PTy[Nl] = PQ.Tc ;
  Qc : L.PTy[Nl] = PQ.Qc ;
  gN : HO.NMap[Nl, Ec, Tc] = HO.compN Nl Ec Ac Tc preN PQ.PC.tauT ;
  lhs : HO.NMap[Nl, Ec, Qc] = HO.compN Nl Ec Tc Qc gN PQ.psi ;
  a0N : HO.NMap[Nl, Ec, Qc] = HO.compN Nl Ec MT Qc mapN EAm.At[a0].evN ;
  b0N : HO.NMap[Nl, Ec, Qc] = HO.compN Nl Ec MT Qc mapN EAm.At[b0].evN ;
  module WE = HO.WR[Nl, Ac, Ac, Ec, HO.compN Nl Ac Tc Ac PQ.PC.tauT PQ.PC.epsT, HO.idN Nl Ac, preN, PQ.PC.et] ;
  module WF = HO.WL[Nl, Ec, Ac, Qc, HO.compN Nl Ec Ac Ac preN (HO.compN Nl Ac Tc Ac PQ.PC.tauT PQ.PC.epsT), HO.compN Nl Ec Ac Ac preN (HO.idN Nl Ac), PQ.evc, WE.res] ;
  pgT (I : Ob) : (o : Top) (w : V1.Ix (Ec.tob I o))
   -> Id (V1.Ix (Qc.tob I o)) (a0N.nfun I o w) ((HO.compN Nl Ec Ac Qc (HO.compN Nl Ec Ac Ac preN (HO.idN Nl Ac)) PQ.evc).nfun I o w) = split {
   tt -> \ w -> transH (apH {V1.Ix (KSi.S.SM.AT.Qt.1.tob I tt)} {V1.Ix (Qc.tob I tt)} (B0.hv I tt (CB.dOf I w).1) (CAppRd[a].App0[KSi.S.SM.AS.Qt, KSi.S.SM.AT.Qt, Pk, E1v.cx].rd I tt))
     (apH {Hom I I} {V1.Ix (Qc.tob I tt)} (\ k0 -> B0.hv I tt (CB.dOf I w).1 ((Pk.eob I tt).1 I k0 (E1v.cx.eob I tt))) (symH (comp-idl I I (idH I)))) } ;
  module R1 = HO.Ret[Nl, Ec, Qc, HO.compN Nl Ec Ac Qc (HO.compN Nl Ec Ac Ac preN (HO.compN Nl Ac Tc Ac PQ.PC.tauT PQ.PC.epsT)) PQ.evc,
    HO.compN Nl Ec Ac Qc (HO.compN Nl Ec Ac Ac preN (HO.idN Nl Ac)) PQ.evc, lhs, a0N,
    \ I o w -> refl (lhs.nfun I o w), pgT, WF.res] ;
  module W3 = HO.WR[Nl, MT, Qc, Ec, EAm.At[a0].evN, EAm.At[b0].evN, mapN, EAm.Ht[a0, b0, eB].res] ;
  module C3 = HO.Cat[Nl, Ec, Qc, lhs, a0N, b0N, PQ.RD.cQ, R1.res, W3.res] ;
  -- psi of the G-value ~ the value of alpha(d) at the class of x_i
  res : L.PEl[L.extP Nl Ec, HO.HT[Nl, Ec, Qc, lhs, b0N].PT.PathP] = C3.res ;
  -- the two ends, read
  lhsRd (I : Ob) (w : V1.Ix (Ec.tob I tt))
   : Id (V1.Ix (Qc.tob I tt)) (lhs.nfun I tt w) (PQ.psi.nfun I tt (CSpA2[a].GYo[R, encK, pe, y].gv i (I, y') (CB.dOf I w))) = refl (lhs.nfun I tt w) ;
  rhsRd (I : Ob) (w : V1.Ix (Ec.tob I tt))
   : Id (V1.Ix (Qc.tob I tt)) (b0N.nfun I tt w) (CSolT[a].SolOf[R, encK, pe, y, u, y'].hval I (CB.hN.nfun I tt w) i) = refl (b0N.nfun I tt w) ;
  } ;
} ;
