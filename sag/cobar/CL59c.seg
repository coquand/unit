-- CL59c.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part c: the context Qc of the values of Q at the copy y.u,
-- constant along C (Qc(I, x) = Q(I, y.u), C-maps act trivially), used to
-- apply D once to the evaluation (h, psi) |-> psi . h.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module QCt (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (yu : SX.Over[R].Presentation)
  (Q : CCopy6[a].YoF[R, encK, pe].TR.G1.fibCwF-T.Ty CCopy6[a].YoF[R, encK, pe].TR.G1.fibCwF-T.nil) {
 module YF = CCopy6[a].YoF[R, encK, pe] ;
 module TR = YF.TR ;
 module CT = YF.CT ;
 module CM = YF.CM ;
 Obj (I : Ob) : U a+ = V1.Ix (CM.IC.obD I) ;
 qm (J I : Ob) (u : Hom J I) : CT.TC.THm (J, yu) (I, yu) = (u, CM.IC.cart J I u yu) ;
 qact (J I : Ob) (u : Hom J I) (q : V1.Ix (Q.1.tob (I, yu) tt)) : V1.Ix (Q.1.tob (J, yu) tt) = Q.1.tact (J, yu) (I, yu) (qm J I u) tt tt (refl tt) q ;
 tactCong (Y X : CT.TC.TOb) (h h' : CT.TC.THm Y X) (Pp : Id (CT.TC.THm Y X) h h') (b : V1.Ix (Q.1.tob X tt))
  : Id (V1.Ix (Q.1.tob Y tt)) (Q.1.tact Y X h tt tt (refl tt) b) (Q.1.tact Y X h' tt tt (refl tt) b) =
  apH {CT.TC.THm Y X} {V1.Ix (Q.1.tob Y tt)} (\ k -> Q.1.tact Y X k tt tt (refl tt) b) Pp ;
 cmpEq (K J I : Ob) (u : Hom J I) (v : Hom K J)
  : Id (CT.TC.THm (K, yu) (I, yu)) (CT.TC.TotCat.oC (K, yu) (J, yu) (I, yu) (qm J I u) (qm K J v)) (qm K I (compH K J I u v)) =
  CM.CO.pq K I yu yu (compH K J I u v) (compH K J I u v) (refl (compH K J I u v))
   (CM.CO.cmpM K J I v yu yu yu (CM.IC.cart J I u yu) (CM.IC.cart K J v yu)) (CM.IC.cart K I (compH K J I u v) yu)
   (CM.MO.Fn[yu, yu].mExt K (CM.CO.cmpM K J I v yu yu yu (CM.IC.cart J I u yu) (CM.IC.cart K J v yu)) (CM.IC.cart K I (compH K J I u v) yu)
      (refl (CM.MO.Fn[yu, yu].fpOf K (CM.IC.cart K I (compH K J I u v) yu)))) ;
 Qc : CM.TP.TCtx =
  new CM.TP.TCtx[\ I x -> Q.1.tob (I, yu) tt, \ J I u y x f q -> qact J I u q,
   \ I x q -> Q.1.tact-id (I, yu) tt (refl tt) q,
   \ K J I u v z y x f f' q ->
    transH (tactCong (K, yu) (I, yu) (qm K I (compH K J I u v)) (CT.TC.TotCat.oC (K, yu) (J, yu) (I, yu) (qm J I u) (qm K J v)) (symH (cmpEq K J I u v)) q)
     (Q.1.tact-o (K, yu) (J, yu) (I, yu) (qm J I u) (qm K J v) tt tt tt (refl tt) (refl tt) (refl tt) q)] ;
 -- over Qc: A1 = yo(y.u) (Qc ignored), B1 = Q weakened, and the evaluation ev'
 Yu : CM.TP.TCtx = CM.Yo[yu].yoT ;
 PQc : TR.P1.PCtx = CT.TC.toP Qc ;
 PYu : TR.P1.PCtx = CT.TC.toP Yu ;
 A1 : TR.P1.PTy[PQc] =
  TR.P1.mkTy PQc (\ X q -> PYu.ob X) (\ Yy X h q q' e a -> PYu.act Yy X h a) (\ X q e a -> PYu.act-id X a)
   (\ Kk Jj Ii f g q q' q'' e1 e2 e3 a -> PYu.act-o Kk Jj Ii f g a) ;
 B1 : TR.P1.PTy[PQc] = TR.P1.subTy PQc TR.G1.fibCwF-T.nil Q.1 (TR.G1.fibCwF-T.eps PQc) ;
 -- (idH, h) : (I, x) -> (I, y.u) for h a point of yo(y.u)
 hm (X : CT.TC.TOb) (hh : V1.Ix (PYu.ob X)) : CT.TC.THm X (X.1, yu) = (idH X.1, hh) ;
 evq (X : CT.TC.TOb) (q : V1.Ix (Q.1.tob (X.1, yu) tt)) (hh : V1.Ix (PYu.ob X)) : V1.Ix (Q.1.tob X tt) =
  Q.1.tact X (X.1, yu) (hm X hh) tt tt (refl tt) q ;
 module EvP (Yy X : CT.TC.TOb) (h : CT.TC.THm Yy X) (q : V1.Ix (Q.1.tob (X.1, yu) tt)) (hh : V1.Ix (PYu.ob X)) {
  q' : V1.Ix (Q.1.tob (Yy.1, yu) tt) = qact Yy.1 X.1 h.1 q ;
  hh' : V1.Ix (PYu.ob Yy) = PYu.act Yy X h hh ;
  m1 : CT.TC.THm Yy (X.1, yu) = CT.TC.TotCat.oC Yy (Yy.1, yu) (X.1, yu) (qm Yy.1 X.1 h.1) (hm Yy hh') ;
  m2 : CT.TC.THm Yy (X.1, yu) = CT.TC.TotCat.oC Yy X (X.1, yu) (hm X hh) h ;
  mEq : Id (CT.TC.THm Yy (X.1, yu)) m1 m2 =
   CM.CO.pq Yy.1 X.1 Yy.2 yu (compH Yy.1 Yy.1 X.1 h.1 (idH Yy.1)) (compH Yy.1 X.1 X.1 (idH X.1) h.1) (transH (comp-idr Yy.1 X.1 h.1) (symH (comp-idl Yy.1 X.1 h.1)))
    m1.2 m2.2 (CM.MO.Fn[yu, Yy.2].mExt Yy.1 m1.2 m2.2 (refl (CM.MO.Fn[yu, Yy.2].fpOf Yy.1 m2.2))) ;
  e2 : Id (V1.Ix (TR.G1.fibCwF-T.nil.ob Yy)) (TR.G1.fibCwF-T.nil.act Yy X h tt) tt =
   TR.G1.GB.GPre[a+].PS.ntEq PQc TR.G1.fibCwF-T.nil (TR.G1.fibCwF-T.eps PQc) Yy X h q (PQc.act Yy X h q) (refl (PQc.act Yy X h q)) ;
  law : Id (V1.Ix (Q.1.tob Yy tt)) (evq Yy q' hh') (Q.1.tact Yy X h tt tt e2 (evq X q hh)) =
   transH (symH (Q.1.tact-o Yy (Yy.1, yu) (X.1, yu) (qm Yy.1 X.1 h.1) (hm Yy hh') tt tt tt (refl tt) (refl tt) (refl tt) q))
    (transH (tactCong Yy (X.1, yu) m1 m2 mEq q)
      (Q.1.tact-o Yy X (X.1, yu) (hm X hh) h tt tt tt (refl tt) e2 (refl tt) q)) ;
 } ;
 evM : TR.G1.GB.CPartial[a+].PMap[PQc, A1, B1] =
  TR.G1.GB.CPartial[a+].mkPMap PQc A1 B1 (\ X w -> (w.1, evq X w.1 w.2)) (\ X w -> refl w.1)
   (\ Yy X h w -> apH {V1.Ix (Q.1.tob Yy tt)} {V1.Ix ((TR.P1.extP PQc B1).ob Yy)} (\ b -> (PQc.act Yy X h w.1, b)) EvP[Yy, X, h, w.1, w.2].law) ;
 -- D of the evaluation
 module DF = CTotP13a[a, a+, a+].DFOf[CM.IC, Qc, A1, B1, evM] ;
} ;
