-- CCmpK5.seg (canonicity-c2; (K) for cmpI, part 5): over nil.H (pairs of
-- homs F2 -> y with the same cmpI image), the two homs agree at the
-- generators of F2: evaluate component k of the Id of images at F1's generator
-- and move along Phi_k's beta.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module K5 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K4m = CCmpK4[a].K4[R, encK, pe, y] ;
 module K3m = K4m.K3m ;
 module E1m = K3m.E1m ;
 module U13m = K4m.U13m ;
 module CI = K4m.CI ;
 Nl : C.Ctx = C.nil ;
 H : C.Ty Nl = K4m.H ;
 GH : C.Ctx = K4m.GH ;
 HS : C.Ty Nl = K4m.HS ;
 HTT : C.Ty Nl = K4m.HTT ;
 QY : C.Ty Nl = K3m.QY ;
 QA : C.Ty Nl = U13m.QA ;
 QH : C.Ty GH = U13m.QH ;
 QYh : C.Ty GH = U13m.QYh ;
 rwId (G : C.Ctx) (T : C.Ty G) (x x' y y' : C.El G T)
  (px : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (x.eob K w) (x'.eob K w))
  (py : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (y.eob K w) (y'.eob K w))
  (p : C.El G (IJ.IdT G T x y)) : C.El G (IJ.IdT G T x' y') = CCmpU14[a].rwId G T x x' y y' px py p ;
 -- readings of the images
 urd (u : C.El K4m.D2 (C.subT K4m.D2 Nl HS K4m.s2)) (x0 : C.El K4m.D2 (OV.wkT K4m.D1 K4m.HSw K4m.HSw))
   (Pu : Id (C.El K4m.D2 (C.subT K4m.D2 Nl HS K4m.s2)) u (OV.trE K4m.D2 (OV.wkT K4m.D1 K4m.HSw K4m.HSw) (C.subT K4m.D2 Nl HS K4m.s2) K4m.PH2 x0))
   (K : Ob) (x : V1.Ix (K4m.D2.ob K)) : Id (V1.Ix (HS.1.tob K x.1.1)) (u.eob K x) (x0.eob K x) =
  transH (apH {C.El K4m.D2 (C.subT K4m.D2 Nl HS K4m.s2)} {V1.Ix (HS.1.tob K x.1.1)} (\ v -> v.eob K x) Pu)
   (transH (CAppRd[a].trE-rd K4m.D2 (OV.wkT K4m.D1 K4m.HSw K4m.HSw) (C.subT K4m.D2 Nl HS K4m.s2) K4m.PH2 x0 K x)
     (CAppRd[a].same-rd K4m.D2 (OV.wkT K4m.D1 K4m.HSw K4m.HSw) (C.subT K4m.D2 Nl HS K4m.s2) K4m.PH2 K x (refl (HS.1.tob K x.1.1)) (x0.eob K x))) ;
 HTTh : C.Ty GH = K4m.HTTh ;
 iAr (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (HTTh.1.tob K w)) (K4m.iA.eob K w) (CI.nmap.nfun K w.1 (K4m.pkA K w)) =
  transH (CAppRd[a].trE-rd GH (C.subT GH K4m.D2 K4m.QD2 K4m.sg) HTTh K4m.PQ (C.subt GH K4m.D2 K4m.QD2 (K4m.evS K4m.D2 K4m.s2 K4m.u1) K4m.sg) K w)
   (transH (CAppRd[a].same-rd GH (C.subT GH K4m.D2 K4m.QD2 K4m.sg) HTTh K4m.PQ K w (refl (HTTh.1.tob K w)) ((K4m.evS K4m.D2 K4m.s2 K4m.u1).eob K (K4m.sgN K w)))
     (apH {V1.Ix (HS.1.tob K w.1)} {V1.Ix (HTT.1.tob K w.1)} (CI.nmap.nfun K w.1) (urd K4m.u1 (OV.wkE K4m.D1 K4m.HSw K4m.HSw (C.q Nl HS)) (refl K4m.u1) K (K4m.sgN K w)))) ;
 iBr (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (HTTh.1.tob K w)) (K4m.iB.eob K w) (CI.nmap.nfun K w.1 (K4m.pkB K w)) =
  transH (CAppRd[a].trE-rd GH (C.subT GH K4m.D2 K4m.QD2 K4m.sg) HTTh K4m.PQ (C.subt GH K4m.D2 K4m.QD2 (K4m.evS K4m.D2 K4m.s2 K4m.u2) K4m.sg) K w)
   (transH (CAppRd[a].same-rd GH (C.subT GH K4m.D2 K4m.QD2 K4m.sg) HTTh K4m.PQ K w (refl (HTTh.1.tob K w)) ((K4m.evS K4m.D2 K4m.s2 K4m.u2).eob K (K4m.sgN K w)))
     (apH {V1.Ix (HS.1.tob K w.1)} {V1.Ix (HTT.1.tob K w.1)} (CI.nmap.nfun K w.1) (urd K4m.u2 (C.q K4m.D1 K4m.HSw) (refl K4m.u2) K (K4m.sgN K w)))) ;
 -- component k at F1's generator
 cx : C.El Nl E1m.QA = E1m.cx ;
 -- generic part: from the Id of component evaluations to the generator case
 module Gen (cp cv : C.El Nl QA) (bt : C.El Nl (IJ.IdT Nl QA cp cv)) (g : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC cp) (U13m.ZB.apC cp))) {
  wid : C.El GH (IJ.IdT GH QH (OV.wkE Nl H QA cp) (OV.wkE Nl H QA cv)) =
   OV.trE GH (C.subT GH Nl (IJ.IdT Nl QA cp cv) (C.p Nl H)) (IJ.IdT GH QH (OV.wkE Nl H QA cp) (OV.wkE Nl H QA cv))
     (IJ.IdT-nat GH Nl QA cp cv (C.p Nl H)) (C.subt GH Nl (IJ.IdT Nl QA cp cv) bt (C.p Nl H)) ;
  atA (c : C.El Nl QA) : C.El GH QYh = PT.atv GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZA.fC) (OV.wkE Nl H QA c) ;
  rdA (c : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) ((atA c).eob K w) ((U13m.ZA.apC c).eob K w) =
   transH (CAppRd[a].trE-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
            (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c))
            (C.subt GH (C.ext GH QH) (OV.wkT GH QH QYh) (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZA.fC) (C.sec GH QH (OV.wkE Nl H QA c))) K w)
    (transH (CAppRd[a].same-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
              (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c)) K w (refl (QYh.1.tob K w))
              ((OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZA.fC).eob K (w, c.eob K w.1)))
      (transH (QinvEq[a, a+].FunOf[GH, QH, QYh, U13m.ZA.nm].bod-eq K (w, c.eob K w.1)) (symH (U13m.ZA.rdF c K w)))) ;
  aA : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC cp) (U13m.ZA.apC cv)) =
   rwId GH QYh (atA cp) (U13m.ZA.apC cp) (atA cv) (U13m.ZA.apC cv) (rdA cp) (rdA cv)
    (PT.apM GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZA.fC) (OV.wkE Nl H QA cp) (OV.wkE Nl H QA cv) wid) ;
  atB (c : C.El Nl QA) : C.El GH QYh = PT.atv GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZB.fC) (OV.wkE Nl H QA c) ;
  rdB (c : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) ((atB c).eob K w) ((U13m.ZB.apC c).eob K w) =
   transH (CAppRd[a].trE-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
            (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c))
            (C.subt GH (C.ext GH QH) (OV.wkT GH QH QYh) (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZB.fC) (C.sec GH QH (OV.wkE Nl H QA c))) K w)
    (transH (CAppRd[a].same-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
              (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c)) K w (refl (QYh.1.tob K w))
              ((OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZB.fC).eob K (w, c.eob K w.1)))
      (transH (QinvEq[a, a+].FunOf[GH, QH, QYh, U13m.ZB.nm].bod-eq K (w, c.eob K w.1)) (symH (U13m.ZB.rdF c K w)))) ;
  aB : C.El GH (IJ.IdT GH QYh (U13m.ZB.apC cp) (U13m.ZB.apC cv)) =
   rwId GH QYh (atB cp) (U13m.ZB.apC cp) (atB cv) (U13m.ZB.apC cv) (rdB cp) (rdB cv)
    (PT.apM GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZB.fC) (OV.wkE Nl H QA cp) (OV.wkE Nl H QA cv) wid) ;
  res : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC cv) (U13m.ZB.apC cv)) =
   PT.transM GH QYh (U13m.ZA.apC cv) (U13m.ZA.apC cp) (U13m.ZB.apC cv)
    (PT.symM GH QYh (U13m.ZA.apC cp) (U13m.ZA.apC cv) aA)
    (PT.transM GH QYh (U13m.ZA.apC cp) (U13m.ZB.apC cp) (U13m.ZB.apC cv) g aB) ;
 } ;
} ;
