-- CTotPsi14.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 14: mS is natural along total maps
-- (CMove.Mv's mSnat): points by CTotPsi10, lines of A by CTotPsi9 at the
-- context G.A (the pairing commutes with the action on lines).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi14 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P13 = CTotPsi13[a, vl, l].Psi13[C, G, A, e] ;
 module P12 = P13.P12 ;
 module P10 = CTotPsi10[a, vl, l].Psi10[C, G, A, e] ;
 module P6 = P12.P6 ;
 module PO = P6.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module D = PO.D ;
 module EKg = P6.EKg ;
 module EKd = P6.EKd ;
 module DS = P13.DS ;
 module PR = P12.PR ;
 module P9E = CTotPsi9[a, vl, l].Psi9[C, P12.ET] ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;
 D0 : TR.P1.PCtx = TC.toP DS.D.DCtx ;
 Tot0 (W : TC.TOb) : U l = TR.P1.SigT D0 DS.DTy W ;
 E0 : TR.P1.PCtx = TR.P1.extP D0 DS.DTy ;
 -- two totals of D (SF') with equal points and equal readings are equal
 totEq (W : TC.TOb) (t t' : Tot0 W) (pP : Id (W0.Ix (D0.ob W)) t.1 t'.1)
  (H : (q : DO.Idx W.1 W.2) (lq : DO.LandsI W.1 W.2 q)
       -> Id (DS.Ez q.2.1 q.2.2.2.1) (DS.prz q.2.1 q.2.2.2.1 (t.1.1 q lq) (t.2.1 q lq)) (DS.prz q.2.1 q.2.2.2.1 (t'.1.1 q lq) (t'.2.1 q lq)))
  : Id (Tot0 W) t t' =
  idJ (W0.Ix (D0.ob W)) t.1
   (\ w2 P2 -> (b : DS.TOb' W.1 W.2 w2)
      -> ((q : DO.Idx W.1 W.2) (lq : DO.LandsI W.1 W.2 q)
            -> Id (DS.Ez q.2.1 q.2.2.2.1) (DS.prz q.2.1 q.2.2.2.1 (t.1.1 q lq) (t.2.1 q lq)) (DS.prz q.2.1 q.2.2.2.1 (w2.1 q lq) (b.1 q lq)))
      -> Id (Tot0 W) t (w2, b))
   (\ b H2 -> apH {DS.TOb' W.1 W.2 t.1} {Tot0 W} (\ b2 -> (t.1, b2))
      (DS.tob-eq W.1 W.2 t.1 t.2 b (\ q lq -> DS.pr-inj q.2.1 q.2.2.2.1 (t.1.1 q lq) (t.2.1 q lq) (b.1 q lq) (H2 q lq))))
   t'.1 pP t'.2 H ;

 module NS (Vb W : TC.TOb) (g : TC.THm Vb W) (v : EKd.TS.EI W) {
  v' : EKd.TS.EI Vb = EKd.TS.E.act Vb W g v ;
  w : EKd.TV.EI W = EKd.TS.pr1 W v ;
  module SN = P10.SN[Vb, W, g, w] ;
  module MW = P12.MS[W, v] ;
  module MV = P12.MS[Vb, v'] ;
  T : Tot0 W = P13.mS W v ;
  -- the pairing commutes with the action on lines
  phiLA : Id (W0.Ix (PR.FDE.ob Vb)) MV.lE (PR.FDE.actF Vb W g MW.lE) =
   PR.FDE.fam-eq Vb MV.lE (PR.FDE.actF Vb W g MW.lE) (\ W' f j -> refl (MV.lE.1 W' f j)) ;
  module RQ (q : DO.Idx Vb.1 Vb.2) (lq : DO.LandsI Vb.1 Vb.2 q) {
   module VQ = SN.VQ[q, lq] ;
   rq : DO.Idx W.1 W.2 = VQ.rq ;
   Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
   module PN = P9E.PNat[Vb, W, g, MW.lE] ;
   lineEq : Id (W0.Ix (P12.FTg.FE.ob Y)) (MV.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].psiE)
              (MW.PQ[rq.1, rq.2.1, rq.2.2.1, rq.2.2.2.1, rq.2.2.2.2.1, (rq.2.2.2.2.2, lq)].psiE) =
    transH (apH {W0.Ix (PR.FDE.ob Vb)} {W0.Ix (P12.FTg.FE.ob Y)} (\ ln' -> P12.Q2E.PQ[Vb, ln', q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].psiq) phiLA)
     (PN.PQe[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].law) ;
   law : Id (EKg.TS.EI Y)
           (EKg.TS.pr Y (MW.PQ[rq.1, rq.2.1, rq.2.2.1, rq.2.2.2.1, rq.2.2.2.2.1, (rq.2.2.2.2.2, lq)].QG.pt)
                      (MW.PQ[rq.1, rq.2.1, rq.2.2.1, rq.2.2.2.1, rq.2.2.2.2.1, (rq.2.2.2.2.2, lq)].fib))
           (EKg.TS.pr Y (MV.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].QG.pt)
                      (MV.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].fib)) =
    EKg.ts-ext Y
     (EKg.TS.pr Y (MW.PQ[rq.1, rq.2.1, rq.2.2.1, rq.2.2.2.1, rq.2.2.2.2.1, (rq.2.2.2.2.2, lq)].QG.pt)
                  (MW.PQ[rq.1, rq.2.1, rq.2.2.1, rq.2.2.2.1, rq.2.2.2.2.1, (rq.2.2.2.2.2, lq)].fib))
     (EKg.TS.pr Y (MV.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].QG.pt)
                  (MV.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].fib))
     (symH VQ.law) (\ V2 g' j -> apH {W0.Ix (P12.FTg.FE.ob Y)} {EKg.TA.EI V2} (\ MM -> MM.1 V2 g' j) (symH lineEq)) ;
  } ;
  law : Id (Tot0 Vb) (E0.act Vb W g T) (P13.mS Vb v') =
   totEq Vb (E0.act Vb W g T) (P13.mS Vb v') (symH SN.law)
    (\ q lq -> transH (DS.TB[Vb.1, W.1, g.1, Vb.2, W.2, g.2, T.1, D0.act Vb W g T.1, refl (D0.act Vb W g T.1), T.2].pc q lq) (RQ[q, lq].law)) ;
 } ;
} ;
