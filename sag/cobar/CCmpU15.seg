-- CCmpU15.seg (canonicity-c2; (K) for cmpI, part 15): the two generator
-- cases of (U): Ev_i at the generator, rewritten to the two evaluation maps,
-- moved along Phi_i's beta to the class of the i-th generator of F2.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module U15 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module U14m = CCmpU14[a].U14[R, encK, pe, y] ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = U14m.GH ;
 module H1 = U14m.H1 ;
 c1 : C.El Nl H1.AS.Qt = U14m.c1 ;
 HTh : C.Ty GH = U14m.HTh ;
 QYh : C.Ty GH = U14m.QYh ;
 rwId (G : C.Ctx) (T : C.Ty G) (x x' y y' : C.El G T)
  (px : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (x.eob K w) (x'.eob K w))
  (py : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (y.eob K w) (y'.eob K w))
  (p : C.El G (IJ.IdT G T x y)) : C.El G (IJ.IdT G T x' y') = CCmpU14[a].rwId G T x x' y y' px py p ;
 -- the image of the generator under Phi_1
 Phi1 : C.El Nl (OV.Fun Nl H1.AS.Qt U14m.U13m.QA) = U14m.U9m.PO.CM.II.I1.SM.Phi ;
 cP : C.El Nl U14m.U13m.QA = OV.app Nl H1.AS.Qt U14m.U13m.QA Phi1 c1 ;
 module P0 = CAppRd[a].App0[H1.AS.Qt, U14m.U13m.QA, Phi1, c1] ;
 module B1 = U14m.U12m.B1 ;
 lA (K : Ob) (h : V1.Ix (U14m.U9m.H.1.tob K tt))
   : Id (V1.Ix (QYh.1.tob K (tt, h))) ((PT.atv GH HTh QYh B1.t U14m.U11m.x1).eob K (tt, h)) ((U14m.U13m.ZA.apC cP).eob K (tt, h)) =
  transH (U14m.U12m.rdA U14m.U11m.x1 K (tt, h))
   (transH (apH {V1.Ix (HTh.1.tob K (tt, h))} {V1.Ix (QYh.1.tob K (tt, h))} (\ v -> U14m.U12m.U10m.n1.nfun K tt v) (U14m.x1rd K (tt, h)))
     (symH (transH (U14m.U13m.ZA.rdF cP K (tt, h))
        (apH {V1.Ix (U14m.U13m.QA.1.tob K tt)} {V1.Ix (QYh.1.tob K (tt, h))} (\ u -> U14m.U13m.BZ.hv K tt h.1.1 u) (P0.rd K tt))))) ;
 lB (K : Ob) (h : V1.Ix (U14m.U9m.H.1.tob K tt))
   : Id (V1.Ix (QYh.1.tob K (tt, h))) ((PT.atv GH HTh QYh B1.t U14m.U11m.x2).eob K (tt, h)) ((U14m.U13m.ZB.apC cP).eob K (tt, h)) =
  transH (U14m.U12m.rdA U14m.U11m.x2 K (tt, h))
   (transH (apH {V1.Ix (HTh.1.tob K (tt, h))} {V1.Ix (QYh.1.tob K (tt, h))} (\ v -> U14m.U12m.U10m.n1.nfun K tt v) (U14m.x2rd K (tt, h)))
     (symH (transH (U14m.U13m.ZB.rdF cP K (tt, h))
        (apH {V1.Ix (U14m.U13m.QA.1.tob K tt)} {V1.Ix (QYh.1.tob K (tt, h))} (\ u -> U14m.U13m.BZ.hv K tt h.2.1.1 u) (P0.rd K tt))))) ;
 lA' (K : Ob) : (o : Top) (h : V1.Ix (U14m.U9m.H.1.tob K o))
   -> Id (V1.Ix (QYh.1.tob K (o, h))) ((PT.atv GH HTh QYh B1.t U14m.U11m.x1).eob K (o, h)) ((U14m.U13m.ZA.apC cP).eob K (o, h)) = split { tt -> lA K } ;
 lB' (K : Ob) : (o : Top) (h : V1.Ix (U14m.U9m.H.1.tob K o))
   -> Id (V1.Ix (QYh.1.tob K (o, h))) ((PT.atv GH HTh QYh B1.t U14m.U11m.x2).eob K (o, h)) ((U14m.U13m.ZB.apC cP).eob K (o, h)) = split { tt -> lB K } ;
 -- Ev_1's Id at the generator, as an Id between the two evaluation maps at Phi_1 c1
 g1 : C.El GH (IJ.IdT GH QYh (U14m.U13m.ZA.apC cP) (U14m.U13m.ZB.apC cP)) =
  rwId GH QYh (PT.atv GH HTh QYh B1.t U14m.U11m.x1) (U14m.U13m.ZA.apC cP) (PT.atv GH HTh QYh B1.t U14m.U11m.x2) (U14m.U13m.ZB.apC cP)
   (\ K w -> lA' K w.1 w.2) (\ K w -> lB' K w.1 w.2) U14m.U12m.ev1 ;
 module SM1 = U14m.U9m.PO.CM.II.I1.SM ;
 h1 : C.El GH (IJ.IdT GH QYh (U14m.U13m.ZA.apC (SM1.AT.cls (SM1.SB.sbT (var (inr tt))))) (U14m.U13m.ZB.apC (SM1.AT.cls (SM1.SB.sbT (var (inr tt)))))) =
  U14m.Gen[cP, SM1.AT.cls (SM1.SB.sbT (var (inr tt))), SM1.beta (var (inr tt)), g1].res ;
 -- the image of the generator under Phi_2
 Phi2 : C.El Nl (OV.Fun Nl H1.AS.Qt U14m.U13m.QA) = U14m.U9m.PO.CM.II.I2.SM.Phi ;
 cP2 : C.El Nl U14m.U13m.QA = OV.app Nl H1.AS.Qt U14m.U13m.QA Phi2 c1 ;
 module P02 = CAppRd[a].App0[H1.AS.Qt, U14m.U13m.QA, Phi2, c1] ;
 module B2 = U14m.U12m.B2 ;
 mA (K : Ob) (h : V1.Ix (U14m.U9m.H.1.tob K tt))
   : Id (V1.Ix (QYh.1.tob K (tt, h))) ((PT.atv GH HTh QYh B2.t U14m.U11m.x1).eob K (tt, h)) ((U14m.U13m.ZA.apC cP2).eob K (tt, h)) =
  transH (U14m.U12m.rdA2 U14m.U11m.x1 K (tt, h))
   (transH (apH {V1.Ix (HTh.1.tob K (tt, h))} {V1.Ix (QYh.1.tob K (tt, h))} (\ v -> U14m.U12m.U10m.n2.nfun K tt v) (U14m.x1rd K (tt, h)))
     (symH (transH (U14m.U13m.ZA.rdF cP2 K (tt, h))
        (apH {V1.Ix (U14m.U13m.QA.1.tob K tt)} {V1.Ix (QYh.1.tob K (tt, h))} (\ u -> U14m.U13m.BZ.hv K tt h.1.1 u) (P02.rd K tt))))) ;
 mB (K : Ob) (h : V1.Ix (U14m.U9m.H.1.tob K tt))
   : Id (V1.Ix (QYh.1.tob K (tt, h))) ((PT.atv GH HTh QYh B2.t U14m.U11m.x2).eob K (tt, h)) ((U14m.U13m.ZB.apC cP2).eob K (tt, h)) =
  transH (U14m.U12m.rdA2 U14m.U11m.x2 K (tt, h))
   (transH (apH {V1.Ix (HTh.1.tob K (tt, h))} {V1.Ix (QYh.1.tob K (tt, h))} (\ v -> U14m.U12m.U10m.n2.nfun K tt v) (U14m.x2rd K (tt, h)))
     (symH (transH (U14m.U13m.ZB.rdF cP2 K (tt, h))
        (apH {V1.Ix (U14m.U13m.QA.1.tob K tt)} {V1.Ix (QYh.1.tob K (tt, h))} (\ u -> U14m.U13m.BZ.hv K tt h.2.1.1 u) (P02.rd K tt))))) ;
 mA' (K : Ob) : (o : Top) (h : V1.Ix (U14m.U9m.H.1.tob K o))
   -> Id (V1.Ix (QYh.1.tob K (o, h))) ((PT.atv GH HTh QYh B2.t U14m.U11m.x1).eob K (o, h)) ((U14m.U13m.ZA.apC cP2).eob K (o, h)) = split { tt -> mA K } ;
 mB' (K : Ob) : (o : Top) (h : V1.Ix (U14m.U9m.H.1.tob K o))
   -> Id (V1.Ix (QYh.1.tob K (o, h))) ((PT.atv GH HTh QYh B2.t U14m.U11m.x2).eob K (o, h)) ((U14m.U13m.ZB.apC cP2).eob K (o, h)) = split { tt -> mB K } ;
 -- Ev_2's Id at the generator, as an Id between the two evaluation maps at Phi_2 c1
 g2 : C.El GH (IJ.IdT GH QYh (U14m.U13m.ZA.apC cP2) (U14m.U13m.ZB.apC cP2)) =
  rwId GH QYh (PT.atv GH HTh QYh B2.t U14m.U11m.x1) (U14m.U13m.ZA.apC cP2) (PT.atv GH HTh QYh B2.t U14m.U11m.x2) (U14m.U13m.ZB.apC cP2)
   (\ K w -> mA' K w.1 w.2) (\ K w -> mB' K w.1 w.2) U14m.U12m.ev2 ;
 module SM2 = U14m.U9m.PO.CM.II.I2.SM ;
 h2 : C.El GH (IJ.IdT GH QYh (U14m.U13m.ZA.apC (SM2.AT.cls (SM2.SB.sbT (var (inr tt))))) (U14m.U13m.ZB.apC (SM2.AT.cls (SM2.SB.sbT (var (inr tt)))))) =
  U14m.Gen[cP2, SM2.AT.cls (SM2.SB.sbT (var (inr tt))), SM2.beta (var (inr tt)), g2].res ;
} ;
