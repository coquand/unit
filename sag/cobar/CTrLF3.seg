-- CTrLF3.seg (canonicity-c2; SAG 8.3, location-free truncation, part 3):
-- rebasing commutes with restriction at a node (CTrLF2.Reb): the case split
-- on the boundary test (decideL-ind), the boundary branch by decideL-yes and
-- the irrelevance of landing proofs, the other by decideL-no and node-cong
-- with the children's arrows matched (tAloop, tAcomp, arrSc).
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[a+] ; open PR.PS ;
module W = V[a+] ;
module L = PR.PS ;
module CmN (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[D]) (psi : (X : Ob) (d : W.Ix (D.ob X)) -> W.Ix (A.tob X (s.nt X d)) -> W.Ix (B.tob X d)) (psiN : (J I : Ob) (f : Hom J I) (d : W.Ix (D.ob I)) (d' : W.Ix (D.ob J)) (e : Id (W.Ix (D.ob J)) (D.act J I f d) d') (v : W.Ix (A.tob I (s.nt I d))) -> Id (W.Ix (B.tob J d')) (B.tact J I f d d' e (psi I d v)) (psi J d' (A.tact J I f (s.nt I d) (s.nt J d') (ntEq D G s J I f d d' e) v))) {
 module RB = CTrLF2[a].Reb[D, G, s, A, B, psi, psiN] ;
 module BG = RB.BG ;
 module BD = RB.BD ;
 module LD = CTruncLaws[a, a+].Laws[D, B] ;
 module CR = CTruncRaw[a, a+] ;
 sl (d : BD.Loc) : BG.Loc = RB.sl d ;
 module At (z : BG.Loc) (Q : PB.Phi z.1) (u : (q : BG.Loc) -> BG.Arr q z -> BG.Raw) (w : (q : BG.Loc) (h : BG.Arr q z) -> PB.Lands q.1 z.1 Q h.1 -> BG.Raw)
   (good : BG.Good (node z Q u w)) (d : BD.Loc) (e : Id BG.Loc z (sl d)) (r : BD.Loc) (h : BD.Arr r d) {
  tN : BG.Raw = node z Q u w ;
  k0 : BG.Arr (sl r) z = RB.tA (sl r) (sl d) z (symH e) (RB.arrS r d h) ;
  Qd : PB.Phi d.1 = RB.tQ z (sl d) e Q ;
  RHS : BD.Raw = BD.restrict (RB.rb tN good d e) r h ;
  aD (r2 : BD.Loc) (h2 : BD.Arr r2 d) : BG.Arr (sl r2) z = RB.tA (sl r2) (sl d) z (symH e) (RB.arrS r2 d h2) ;
  uD (r2 : BD.Loc) (h2 : BD.Arr r2 d) : BD.Raw = RB.rb (u (sl r2) (aD r2 h2)) (good.2.1 (sl r2) (aD r2 h2)).1 r2 (good.2.1 (sl r2) (aD r2 h2)).2 ;
  lD (r2 : BD.Loc) (h2 : BD.Arr r2 d) (i : PB.Lands r2.1 d.1 Qd h2.1) : PB.Lands r2.1 z.1 Q (aD r2 h2).1 = RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i ;
  wD (r2 : BD.Loc) (h2 : BD.Arr r2 d) (i : PB.Lands r2.1 d.1 Qd h2.1) : BD.Raw =
   RB.rb (w (sl r2) (aD r2 h2) (lD r2 h2 i)) (good.2.2.1 (sl r2) (aD r2 h2) (lD r2 h2 i)).1 r2 (good.2.2.1 (sl r2) (aD r2 h2) (lD r2 h2 i)).2 ;
  yesD (i : PB.Lands r.1 d.1 Qd h.1) : BD.Raw = wD r h i ;
  noD (no : Id Bool (CR.dec r.1 d.1 Qd h.1) false) : BD.Raw =
   node r (PB.pre r.1 d.1 h.1 Qd) (\ r2 g -> uD r2 (BD.compose r2 r d h g)) (\ r2 g i -> wD r2 (BD.compose r2 r d h g) i) ;
  P (x : BG.Raw) : U a++ = (gx : BG.Good x) (ex : Id BG.Loc (BG.root x) (sl r)) -> Id BD.Raw (RB.rb x gx r ex) RHS ;
  -- the boundary branch
  py (i : PB.Lands r.1 z.1 Q k0.1) : P (w (sl r) k0 i) = \ gx ex ->
   transH (RB.rbCong (w (sl r) k0 i) (w (sl r) k0 (RB.tL (sl r) z (sl d) e Q (RB.arrS r d h) (RB.tLi (sl r) z (sl d) e Q (RB.arrS r d h) i)))
             (apH {PB.Lands r.1 z.1 Q k0.1} {BG.Raw} (\ j -> w (sl r) k0 j) (PB.isProp-Lands r.1 z.1 Q k0.1 i (RB.tL (sl r) z (sl d) e Q (RB.arrS r d h) (RB.tLi (sl r) z (sl d) e Q (RB.arrS r d h) i))))
             gx (good.2.2.1 (sl r) k0 (RB.tL (sl r) z (sl d) e Q (RB.arrS r d h) (RB.tLi (sl r) z (sl d) e Q (RB.arrS r d h) i))).1 r ex
             (good.2.2.1 (sl r) k0 (RB.tL (sl r) z (sl d) e Q (RB.arrS r d h) (RB.tLi (sl r) z (sl d) e Q (RB.arrS r d h) i))).2)
    (symH (CR.decideL-yes BD.Raw r.1 d.1 Qd h.1 yesD noD (RB.tLi (sl r) z (sl d) e Q (RB.arrS r d h) i))) ;
  -- the other branch
  Qp : PB.Phi r.1 = PB.pre r.1 z.1 k0.1 Q ;
  up (r3 : BG.Loc) (g3 : BG.Arr r3 (sl r)) : BG.Raw = u r3 (BG.compose r3 (sl r) z k0 g3) ;
  wp (r3 : BG.Loc) (g3 : BG.Arr r3 (sl r)) (i3 : PB.Lands r3.1 r.1 Qp g3.1) : BG.Raw = w r3 (BG.compose r3 (sl r) z k0 g3) i3 ;
  arrEq (r2 : BD.Loc) (g2 : BD.Arr r2 r) (ex : Id BG.Loc (sl r) (sl r))
    : Id (BG.Arr (sl r2) z) (BG.compose (sl r2) (sl r) z k0 (RB.tA (sl r2) (sl r) (sl r) (symH ex) (RB.arrS r2 r g2))) (aD r2 (BD.compose r2 r d h g2)) =
   transH (apH {BG.Arr (sl r2) (sl r)} {BG.Arr (sl r2) z} (\ c -> BG.compose (sl r2) (sl r) z k0 c) (RB.tAloop (sl r2) (sl r) (symH ex) (RB.arrS r2 r g2)))
    (transH (RB.tAcomp (sl r2) (sl r) z (sl d) e (RB.arrS r d h) (RB.arrS r2 r g2))
      (apH {BG.Arr (sl r2) (sl d)} {BG.Arr (sl r2) z} (\ c -> RB.tA (sl r2) (sl d) z (symH e) c) (RB.arrSc r2 r d g2 h))) ;
  -- the children of the rebased other branch
  NG : U a++ = BG.Good (node (sl r) Qp up wp) ;
  X1 (ex : Id BG.Loc (sl r) (sl r)) (r2 : BD.Loc) (g2 : BD.Arr r2 r) : BG.Arr (sl r2) (sl r) = RB.tA (sl r2) (sl r) (sl r) (symH ex) (RB.arrS r2 r g2) ;
  uL (gx : NG) (ex : Id BG.Loc (sl r) (sl r)) (r2 : BD.Loc) (g2 : BD.Arr r2 r) : BD.Raw =
   RB.rb (up (sl r2) (X1 ex r2 g2)) (gx.2.1 (sl r2) (X1 ex r2 g2)).1 r2 (gx.2.1 (sl r2) (X1 ex r2 g2)).2 ;
  iL (ex : Id BG.Loc (sl r) (sl r)) (r2 : BD.Loc) (g2 : BD.Arr r2 r) (i : PB.Lands r2.1 r.1 (RB.tQ (sl r) (sl r) ex Qp) g2.1) : PB.Lands r2.1 r.1 Qp (X1 ex r2 g2).1 =
   RB.tL (sl r2) (sl r) (sl r) ex Qp (RB.arrS r2 r g2) i ;
  wL (gx : NG) (ex : Id BG.Loc (sl r) (sl r)) (r2 : BD.Loc) (g2 : BD.Arr r2 r) (i : PB.Lands r2.1 r.1 (RB.tQ (sl r) (sl r) ex Qp) g2.1) : BD.Raw =
   RB.rb (wp (sl r2) (X1 ex r2 g2) (iL ex r2 g2 i)) (gx.2.2.1 (sl r2) (X1 ex r2 g2) (iL ex r2 g2 i)).1 r2 (gx.2.2.1 (sl r2) (X1 ex r2 g2) (iL ex r2 g2 i)).2 ;
  pn (no : Id Bool (CR.dec r.1 z.1 Q k0.1) false) : P (node (sl r) Qp up wp) = \ gx ex ->
   transH
    (LD.node-cong r (RB.tQ (sl r) (sl r) ex Qp) (PB.pre r.1 d.1 h.1 Qd)
       (transH (RB.tQloop (sl r) ex Qp) (RB.preT z (sl d) (sl r) e Q (RB.arrS r d h)))
       (uL gx ex) (\ r2 g -> uD r2 (BD.compose r2 r d h g)) (wL gx ex) (\ r2 g i -> wD r2 (BD.compose r2 r d h g) i)
       (\ r2 g2 -> RB.rbCong (up (sl r2) (X1 ex r2 g2)) (u (sl r2) (aD r2 (BD.compose r2 r d h g2)))
          (apH {BG.Arr (sl r2) z} {BG.Raw} (\ c -> u (sl r2) c) (arrEq r2 g2 ex))
          (gx.2.1 (sl r2) (X1 ex r2 g2)).1 (good.2.1 (sl r2) (aD r2 (BD.compose r2 r d h g2))).1 r2
          (gx.2.1 (sl r2) (X1 ex r2 g2)).2 (good.2.1 (sl r2) (aD r2 (BD.compose r2 r d h g2))).2)
       (\ r2 g2 i j -> RB.rbCong (wp (sl r2) (X1 ex r2 g2) (iL ex r2 g2 i)) (w (sl r2) (aD r2 (BD.compose r2 r d h g2)) (lD r2 (BD.compose r2 r d h g2) j))
          (BG.boundary-cong z Q w (sl r2) (BG.compose (sl r2) (sl r) z k0 (X1 ex r2 g2)) (aD r2 (BD.compose r2 r d h g2)) (arrEq r2 g2 ex) (iL ex r2 g2 i) (lD r2 (BD.compose r2 r d h g2) j))
          (gx.2.2.1 (sl r2) (X1 ex r2 g2) (iL ex r2 g2 i)).1 (good.2.2.1 (sl r2) (aD r2 (BD.compose r2 r d h g2)) (lD r2 (BD.compose r2 r d h g2) j)).1 r2
          (gx.2.2.1 (sl r2) (X1 ex r2 g2) (iL ex r2 g2 i)).2 (good.2.2.1 (sl r2) (aD r2 (BD.compose r2 r d h g2)) (lD r2 (BD.compose r2 r d h g2) j)).2))
    (symH (CR.decideL-no BD.Raw r.1 d.1 Qd h.1 yesD noD (transH (symH (RB.decEq z (sl d) (sl r) e Q (RB.arrS r d h))) no))) ;
  -- the node case
  rg : BG.Good (BG.restrict tN (sl r) k0) * Id BG.Loc (BG.root (BG.restrict tN (sl r) k0)) (sl r) = BG.restrict-good tN good (sl r) k0 ;
  ag : BG.Good (BG.at tN (sl d) e (sl r) (RB.arrS r d h)) * Id BG.Loc (BG.root (BG.at tN (sl d) e (sl r) (RB.arrS r d h))) (sl r) =
   BG.at-good tN good (sl d) e (sl r) (RB.arrS r d h) ;
  res : Id BD.Raw (RB.rb (BG.at tN (sl d) e (sl r) (RB.arrS r d h)) ag.1 r ag.2) RHS =
   transH (RB.rbCong (BG.at tN (sl d) e (sl r) (RB.arrS r d h)) (BG.restrict tN (sl r) k0) (RB.atRes tN (sl r) (sl d) e (RB.arrS r d h)) ag.1 rg.1 r ag.2 rg.2)
    (CR.decideL-ind BG.Raw r.1 z.1 Q k0.1 (\ i -> w (sl r) k0 i) (\ no -> node (sl r) Qp up wp) P py pn rg.1 rg.2) ;
} ;
} ;
