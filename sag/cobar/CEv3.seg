-- CEv3.seg (canonicity-c2; HomT(F1, y) ~ Q_y, part 3): for a term t of y the
-- closed hom h_t : F1 -> y (x |-> t), the family of them over Delta Term_y,
-- and the family of Ids ev h_t = cls t (beta of Phi_t at the generator).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module E3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module E1m = CEv1[a].E1[R, encK, pe, y] ;
 module CM = E1m.CM ;
 F1 : SX.Over[R].Presentation = E1m.F1 ;
 module AY = CAlgX[a].AlgX[R, encK, y, pe] ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = E1m.HT ;
 QY : C.Ty Nl = E1m.QY ;
 Tm : C.Ty Nl = AY.RP.Tm ;
 TmY : U a = SX.Over[R].Der[y].Term ;
 sg (t : TmY) : SX.Fin F1.1 -> TmY = split { inl e -> absurd TmY e ; inr u -> t } ;
 module SC (t : TmY) {
  module S0 = CM.II.SubC[F1, y, sg t,
    \ p m -> absurd (SX.Over[R].Der[y].Proof (CSubst[a].SE[R].subE (SX.Fin F1.1) (SX.Fin y.1) (sg t) p) SX.Over[R].Der[y].zeroE) m] ;
 } ;
 module FM = CHomT11[a].FromM[R, encK, pe, F1, y] ;
 module NT = CHomT16[a].Nat[R, encK, pe, F1, y] ;
 hob (t : TmY) (K : Ob) : (o : Top) -> V1.Ix (HT.1.tob K o) = split { tt -> FM.alpha K (SC[t].S0.M.mor K) } ;
 hnat (t : TmY) (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o') -> Id (V1.Ix (HT.1.tob J o')) (HT.1.tact J I f o o' e (hob t I o)) (hob t J o') =
  split { tt -> split { tt -> \ e ->
   transH (L.tact-irr Nl HT.1 J I f tt tt e (refl tt) (FM.alpha I (SC[t].S0.M.mor I)))
    (transH (symH (NT.aNat I J f (SC[t].S0.M.mor I))) (apH {CM.MO.Fn[F1, y].M J} {V1.Ix (HT.1.tob J tt)} (FM.alpha J) (SC[t].S0.M.mor-nat I J f))) } } ;
 hc (t : TmY) : C.El Nl HT = L.mkPEl Nl HT.1 (hob t) (hnat t) ;
 -- families over Delta Term_y
 module LP = CConstLam[a, a+].LamC[CCyl[a].PosCyl.posCyl, AY.RP.TmV] ;
 module LO = CConstLam[a, a+].LamOf[CCyl[a].PosCyl.posCyl, AY.RP.TmV] ;
 DT : C.Ctx = C.ext Nl Tm ;
 module Fam (A : C.Ty Nl) (cl : TmY -> C.El Nl A) {
  Aw : C.Ty DT = OV.wkT Nl Tm A ;
  fB (J I : Ob) (f : Hom J I) (w : V1.Ix (DT.ob I))
    : Id (V1.Ix (Aw.1.tob J (DT.act J I f w))) (Aw.1.tact J I f w (DT.act J I f w) (refl (DT.act J I f w)) ((cl w.2).eob I w.1)) ((cl w.2).eob J (DT.act J I f w).1) =
   transH (L.tact-irr Nl A.1 J I f w.1 w.1 (L.ntEq DT Nl (L.pP Nl Tm.1) J I f w (DT.act J I f w) (refl (DT.act J I f w))) (refl w.1) ((cl w.2).eob I w.1))
    ((cl w.2).enat J I f w.1 w.1 (refl w.1)) ;
  el : C.El DT Aw = L.mkPEl DT Aw.1 (\ K w -> (cl w.2).eob K w.1) (\ J I f w w' e ->
   idJ (V1.Ix (DT.ob J)) (DT.act J I f w) (\ w2 e2 -> Id (V1.Ix (Aw.1.tob J w2)) (Aw.1.tact J I f w w2 e2 ((cl w.2).eob I w.1)) ((cl w2.2).eob J w2.1))
    (fB J I f w) w' e) ;
 } ;
 module IdFam (A : C.Ty Nl) (c1 c2 : TmY -> C.El Nl A) (ee : (t : TmY) -> C.El Nl (IJ.IdT Nl A (c1 t) (c2 t))) {
  Aw : C.Ty DT = OV.wkT Nl Tm A ;
  e1 : C.El DT Aw = Fam[A, c1].el ;
  e2 : C.El DT Aw = Fam[A, c2].el ;
  B : C.Ty DT = IJ.IdT DT Aw e1 e2 ;
  module At (e : TmY) {
   sc : C.Sub Nl DT = C.sec Nl Tm (LP.cE Nl e) ;
   PA : Id (C.Ty Nl) (C.subT Nl DT Aw sc) A = CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Tm A (LP.cE Nl e) ;
   rd (c : TmY -> C.El Nl A) (K : Ob) (o : V1.Ix (Nl.ob K))
     : Id (V1.Ix (A.1.tob K o)) ((OV.trE Nl (C.subT Nl DT Aw sc) A PA (C.subt Nl DT Aw Fam[A, c].el sc)).eob K o) ((c e).eob K o) =
    transH (CAppRd[a].trE-rd Nl (C.subT Nl DT Aw sc) A PA (C.subt Nl DT Aw Fam[A, c].el sc) K o)
     (CAppRd[a].same-rd Nl (C.subT Nl DT Aw sc) A PA K o (refl (A.1.tob K o)) ((c e).eob K o)) ;
   PId : Id (C.Ty Nl) (IJ.IdT Nl A (c1 e) (c2 e)) (C.subT Nl DT B sc) =
    symH (transH (IJ.IdT-nat Nl DT Aw e1 e2 sc)
      (CCmpK1[a].idTEq Nl (C.subT Nl DT Aw sc) A PA (C.subt Nl DT Aw e1 sc) (C.subt Nl DT Aw e2 sc) (c1 e) (c2 e)
        (L.el-ext Nl A.1 (OV.trE Nl (C.subT Nl DT Aw sc) A PA (C.subt Nl DT Aw e1 sc)) (c1 e) (rd c1))
        (L.el-ext Nl A.1 (OV.trE Nl (C.subT Nl DT Aw sc) A PA (C.subt Nl DT Aw e2 sc)) (c2 e) (rd c2)))) ;
   fEl : C.El Nl (C.subT Nl DT B sc) = OV.trE Nl (IJ.IdT Nl A (c1 e) (c2 e)) (C.subT Nl DT B sc) PId (ee e) ;
  } ;
  res : C.El DT B = LO.pack Nl B.1 (\ e -> At[e].fEl) ;
 } ;
 hfam : C.El DT (OV.wkT Nl Tm HT) = Fam[HT, hc].el ;
 -- the beta of Phi_t at the generator
 cx : C.El Nl E1m.QA = E1m.cx ;
 pA (t : TmY) : C.El Nl QY = OV.app Nl E1m.QA QY SC[t].S0.SM.Phi cx ;
 cT (t : TmY) : C.El Nl QY = AY.cls t ;
 bt (t : TmY) : C.El Nl (IJ.IdT Nl QY (pA t) (cT t)) = SC[t].S0.SM.beta (var (inr tt)) ;
 bfam : C.El DT (IJ.IdT DT (OV.wkT Nl Tm QY) Fam[QY, pA].el Fam[QY, cT].el) = IdFam[QY, pA, cT, bt].res ;
} ;
