-- The natural map used for injectivity and CDFw8's lambda have the same
-- body.  State that body equality once, then apply lambda to it.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module L = PosFull[a].PB.GPre[a+].PS ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Eq (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x)
  (y : SX.Over[R].Presentation) {
 module I = CDIn1[a].In1[R, encK, pe, x, u, y] ;
 module F = I.F8 ;
 module Q = QinvEq[a, a+].FunOf[C.nil, I.HU, I.T0, I.fwdN] ;
 bodyEq : Id (C.El F.D1 (C.subT F.D1 C.nil F.T0 (C.p C.nil F.HU))) Q.fP F.t0 =
  L.el-ext F.D1 (C.subT F.D1 C.nil F.T0 (C.p C.nil F.HU)).1 Q.fP F.t0
    (\ W w -> refl (F.t0.eob W w)) ;
 mapEq : Id (C.El C.nil (OV.Fun C.nil F.HU F.T0)) Q.fC F.fwd =
  apH {C.El F.D1 (C.subT F.D1 C.nil F.T0 (C.p C.nil F.HU))}
      {C.El C.nil (OV.Fun C.nil F.HU F.T0)}
      (\ b -> OV.lam C.nil F.HU (OV.wkT C.nil F.HU F.T0) b) bodyEq ;
} ;
