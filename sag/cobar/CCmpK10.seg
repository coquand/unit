-- CCmpK10.seg (canonicity-c2; (K) for cmpI, part 10): ev : HomT(F1, y) -> Q_y
-- is injective over any context: inv applied to an Id of values, with the
-- retraction inv (ev g) = g (CEv8.ret) substituted at both ends.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module K10 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module E8m = CEv8[a].E8[R, encK, pe, y] ;
 module E6m = E8m.E6m ;
 module I = E8m.I ;
 module E1m = CEv1[a].E1[R, encK, pe, y] ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = E8m.HT ;
 QY : C.Ty Nl = E8m.QY ;
 GB : C.Ctx = E8m.GB ;
 -- the inverse as a natural map
 iv (K : Ob) (o : Top) (q : V1.Ix (QY.1.tob K o)) : V1.Ix (HT.1.tob K o) = E6m.invB.eob K (o, q) ;
 ivN (J I : Ob) (f : Hom J I) (x x' : Top) (e : Id Top (Nl.act J I f x) x') (q : V1.Ix (QY.1.tob I x))
   : Id (V1.Ix (HT.1.tob J x')) (HT.1.tact J I f x x' e (iv I x q)) (iv J x' (QY.1.tact J I f x x' e q)) =
  transH (L.tact-irr Nl HT.1 J I f x x' e
           (L.ntEq GB Nl (L.pP Nl QY.1) J I f (x, q) (x', QY.1.tact J I f x x' e q) (L.pair-act Nl QY.1 J I f x x' e q)) (iv I x q))
   (E6m.invB.enat J I f (x, q) (x', QY.1.tact J I f x x' e q) (L.pair-act Nl QY.1 J I f x x' e q)) ;
 minv : HO.NMap[Nl, QY.1, HT.1] = new HO.NMap[Nl, QY.1, HT.1, iv, ivN] ;
 module At (G : C.Ctx) (s0 : C.Sub G Nl) (u v : C.El G (C.subT G Nl HT s0))
   (e : C.El G (IJ.IdT G (C.subT G Nl QY s0) (E1m.evS G s0 u) (E1m.evS G s0 v))) {
  XG : C.Ty G = C.subT G Nl HT s0 ;
  module AI = CCmpK3[a].ApN[QY, HT, minv, G, s0] ;
  ai : C.El G (IJ.IdT G XG (AI.IPm.evS G s0 (E1m.evS G s0 u)) (AI.IPm.evS G s0 (E1m.evS G s0 v))) = AI.ap (E1m.evS G s0 u) (E1m.evS G s0 v) e ;
  -- the retraction at an element
  module Rt (x : C.El G XG) {
   sx : C.Sub G E8m.D = CQSurj[a].Ex[C].exS G Nl HT s0 x ;
   W : C.Ty G = C.subT G E8m.D E8m.WH sx ;
   PW : Id (C.Ty G) W XG =
    transH (symH (C.subT-o G E8m.D Nl HT (C.p Nl HT) sx))
     (apH {C.Sub G Nl} {C.Ty G} (\ s -> C.subT G Nl HT s) (INm.p-extS G Nl HT s0 x)) ;
   r0 : C.El G (IJ.IdT G W (C.subt G E8m.D E8m.WH E8m.t1 sx) (C.subt G E8m.D E8m.WH (C.q Nl HT) sx)) =
    OV.trE G (C.subT G E8m.D (IJ.IdT E8m.D E8m.WH E8m.t1 (C.q Nl HT)) sx) (IJ.IdT G W (C.subt G E8m.D E8m.WH E8m.t1 sx) (C.subt G E8m.D E8m.WH (C.q Nl HT) sx))
     (IJ.IdT-nat G E8m.D E8m.WH E8m.t1 (C.q Nl HT) sx) (C.subt G E8m.D (IJ.IdT E8m.D E8m.WH E8m.t1 (C.q Nl HT)) E8m.ret sx) ;
   r1 : C.El G (IJ.IdT G XG (OV.trE G W XG PW (C.subt G E8m.D E8m.WH E8m.t1 sx)) (OV.trE G W XG PW (C.subt G E8m.D E8m.WH (C.q Nl HT) sx))) =
    CInjP[a].idFwdL G W XG PW (C.subt G E8m.D E8m.WH E8m.t1 sx) (C.subt G E8m.D E8m.WH (C.q Nl HT) sx) r0 ;
   ra (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (XG.1.tob K w)) ((OV.trE G W XG PW (C.subt G E8m.D E8m.WH E8m.t1 sx)).eob K w) ((AI.IPm.evS G s0 (E1m.evS G s0 x)).eob K w) =
    transH (CAppRd[a].trE-rd G W XG PW (C.subt G E8m.D E8m.WH E8m.t1 sx) K w)
     (transH (CAppRd[a].same-rd G W XG PW K w (refl (XG.1.tob K w)) (E8m.t1.eob K (sx.nt K w))) (E8m.t1v K (sx.nt K w))) ;
   rb (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (XG.1.tob K w)) ((OV.trE G W XG PW (C.subt G E8m.D E8m.WH (C.q Nl HT) sx)).eob K w) (x.eob K w) =
    transH (CAppRd[a].trE-rd G W XG PW (C.subt G E8m.D E8m.WH (C.q Nl HT) sx) K w)
     (CAppRd[a].same-rd G W XG PW K w (refl (XG.1.tob K w)) (x.eob K w)) ;
   res : C.El G (IJ.IdT G XG (AI.IPm.evS G s0 (E1m.evS G s0 x)) x) =
    CCmpU14[a].rwId G XG (OV.trE G W XG PW (C.subt G E8m.D E8m.WH E8m.t1 sx)) (AI.IPm.evS G s0 (E1m.evS G s0 x))
     (OV.trE G W XG PW (C.subt G E8m.D E8m.WH (C.q Nl HT) sx)) x ra rb r1 ;
  } ;
  res : C.El G (IJ.IdT G XG u v) =
   PT.transM G XG u (AI.IPm.evS G s0 (E1m.evS G s0 u)) v
    (PT.symM G XG (AI.IPm.evS G s0 (E1m.evS G s0 u)) u Rt[u].res)
    (PT.transM G XG (AI.IPm.evS G s0 (E1m.evS G s0 u)) (AI.IPm.evS G s0 (E1m.evS G s0 v)) v ai Rt[v].res) ;
 } ;
} ;
