-- CHtIdP.seg (canonicity-45; COBAR.md "Prop 58"): over the poset base, a
-- path homotopy H : f ~ g of maps X -> Y over Gamma gives an element of the
-- internal Id type over Gamma.X between f and g as elements (FibNF's LineY
-- on H's line at (id, j)); the poset form of CHtIdG.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module HO = PB.CHtpyOps[a+] ;
module At (Gm : L.PCtx) (X : L.PTy[Gm]) (Y : FibCwF[a, a+].fibCwF.Ty Gm) (f g : HO.NMap[Gm, X, Y.1])
   (H : L.PEl[L.extP Gm X, HO.HT[Gm, X, Y.1, f, g].PT.PathP]) {
  module T = HO.HT[Gm, X, Y.1, f, g] ;
  module TY = PB.GPre[a+].TyL[Gm, Y.1] ;
  K : L.PCtx = L.extP Gm X ;
  YY : FibCwF[a, a+].fibCwF.Ty K = FibCwF[a, a+].fibCwF.subT K Gm Y (L.pP Gm X) ;
  -- f and g as elements over Gamma.X
  module EF (u : HO.NMap[Gm, X, Y.1]) {
   eb (W : Ob) (z : V1.Ix (K.ob W)) : V1.Ix (YY.1.tob W z) = u.nfun W z.1 z.2 ;
   en0 (J I : Ob) (h : Hom J I) (z : V1.Ix (K.ob I))
    : Id (V1.Ix (YY.1.tob J (K.act J I h z))) (YY.1.tact J I h z (K.act J I h z) (refl (K.act J I h z)) (eb I z)) (eb J (K.act J I h z)) =
    transH (L.tact-irr Gm Y.1 J I h z.1 (Gm.act J I h z.1) (L.ntEq K Gm (L.pP Gm X) J I h z (K.act J I h z) (refl (K.act J I h z))) (refl (Gm.act J I h z.1)) (eb I z))
     (u.nnat J I h z.1 (Gm.act J I h z.1) (refl (Gm.act J I h z.1)) z.2) ;
   el : L.PEl[K, YY.1] = L.mkPEl K YY.1 eb (\ J I h z z' e ->
    idJ (V1.Ix (K.ob J)) (K.act J I h z) (\ z2 e2 -> Id (V1.Ix (YY.1.tob J z2)) (YY.1.tact J I h z z2 e2 (eb I z)) (eb J z2)) (en0 J I h z) z' e) ;
  } ;
  a0 : L.PEl[K, YY.1] = EF[f].el ;
  b0 : L.PEl[K, YY.1] = EF[g].el ;
  -- the line field: H at (id, j), coerced into the fibre
  pvz (W : Ob) (z : V1.Ix (K.ob W)) (j : Hom W Iv) : TY.EI W = T.pv H W z W (idH W) j ;
  pteq (W : Ob) (z : V1.Ix (K.ob W)) (j : Hom W Iv) : Id (V1.Ix (Gm.ob W)) (TY.pr1 W (pvz W z j)) z.1 =
   transH ((H.eob W z).2.1 W (idH W) j) (Gm.act-id W z.1) ;
  Lf (W : Ob) (z : V1.Ix (K.ob W)) (j : Hom W Iv) : V1.Ix (YY.1.tob W z) = TY.coeT W (TY.pr1 W (pvz W z j)) z.1 (pteq W z j) (TY.pr2 W (pvz W z j)) ;
  Lf-rd (W : Ob) (z : V1.Ix (K.ob W)) (j : Hom W Iv) : Id (TY.EI W) (TY.pr W z.1 (Lf W z j)) (pvz W z j) =
   symH (TY.pr-coe W (TY.pr1 W (pvz W z j)) z.1 (pteq W z j) (TY.pr2 W (pvz W z j))) ;
  Unat (V W : Ob) (g0 : Hom V W) (z : V1.Ix (K.ob W)) (z' : V1.Ix (K.ob V)) (E : Id (V1.Ix (K.ob V)) (K.act V W g0 z) z') (j : Hom W Iv)
   : Id (V1.Ix (YY.1.tob V z')) (YY.1.tact V W g0 z z' E (Lf W z j)) (Lf V z' (compH V W Iv j g0)) =
   TY.pr-inj V z'.1 (YY.1.tact V W g0 z z' E (Lf W z j)) (Lf V z' (compH V W Iv j g0))
    (transH (symH (TY.pr-tact V W g0 z.1 z'.1 (L.ntEq K Gm (L.pP Gm X) V W g0 z z' E) (Lf W z j)))
     (transH (apH {TY.EI W} {TY.EI V} (TY.E.act V W g0) (Lf-rd W z j))
      (transH ((H.eob W z).1.2 V W g0 (idH W) j)
       (transH (apH {Hom V W} {TY.EI V} (\ k0 -> T.pv H W z V k0 (compH V W Iv j g0)) (transH (comp-idl V W g0) (symH (comp-idr V W g0))))
        (transH (T.pv-res H V W g0 z z' E V (idH V) (compH V W Iv j g0))
          (symH (Lf-rd V z' (compH V W Iv j g0)))))))) ;
  U0 (W : Ob) (z : V1.Ix (K.ob W)) : Id (V1.Ix (YY.1.tob W z)) (Lf W z (PB.ptH W PB.e0)) (a0.eob W z) =
   TY.pr-inj W z.1 (Lf W z (PB.ptH W PB.e0)) (a0.eob W z) (transH (Lf-rd W z (PB.ptH W PB.e0)) (H.eob W z).2.2.1) ;
  U1 (W : Ob) (z : V1.Ix (K.ob W)) : Id (V1.Ix (YY.1.tob W z)) (Lf W z (PB.ptH W PB.e1)) (b0.eob W z) =
   TY.pr-inj W z.1 (Lf W z (PB.ptH W PB.e1)) (b0.eob W z) (transH (Lf-rd W z (PB.ptH W PB.e1)) (H.eob W z).2.2.2) ;
  module LY = FibNF[a, a+].LineY[K, YY.1, a0, b0, Lf, Unat, U0, U1] ;
  -- f = g as an element of the internal Id type over Gamma.X
  el : FibCwF[a, a+].fibCwF.El K (FibId[a, a+].fibId.IdT K YY a0 b0) = LY.el ;
 } ;
