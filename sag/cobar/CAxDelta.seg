-- CAxDelta.seg (canonicity-c2; the axioms' statements, (A)): constant fibrant
-- types Delta E at the total site (GCConst at the Grothendieck base, with
-- its cylinder CGrothCyl), Delta N in particular, and metatheory functions
-- E -> E' as maps Delta E -> Delta E' (GCConstLam.lamC).
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module DeltaOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module PW = CAxPow[a].PowOf[R, encK, pe] ;
 module G1 = PW.G1 ;
 C : CwF.CwF[a++] = PW.C ;
 module CY = CGrothCyl[a].GCyl[PW.GB.YF.CM.IC] ;
 -- Delta E over any context
 D (E : V1.V) (G : C.Ctx) : C.Ty G = G1.FT.GCConst[a+].ConstOf[CY.cylG, E].constS G ;
 DN (G : C.Ctx) : C.Ty G = D V1.natV G ;
} ;
