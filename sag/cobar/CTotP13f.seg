-- CTotP13f.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part f: Psi on the homotopy fibre of D f as a D-element (PsiF) of
-- D Pt over the paired point, and mS (CMove.Mv's map of totals).  Each
-- equation by the homotopy fibre's extensionality (fibE-eq): the points by
-- the pairing's equations, the elements of A by a''s, the paths by Psi at
-- the context G.B (c2's CTotPsi3 / 4 / 5).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13f (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PE = CTotP13e[a, vl, l].P13e[C, G, A, B, f] ;
 module PB13 = PE.PB13 ;
 module TR = PE.TR ;
 module TC = PE.TC ;
 module H = PE.H ;
 module HD = PE.HD ;
 module DS = PB13.LZ.DA ;
 ET : CTPsh[a, vl, l].TPshOf[C].TCtx = PE.ET ;
 module P3E = CTotPsi3[a, vl, l].Psi3[C, ET] ;
 module P4E = CTotPsi4[a, vl, l].Psi4[C, ET] ;
 module P5E = CTotPsi5[a, vl, l].Psi5[C, ET] ;
 Obj (I : Ob) : U vl = PE.Obj I ;

 module SE (X : TC.TOb) (v : HD.TF.EI X) {
  module M = PE.MS[X, v] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  pt : DS.D.Ob' I x = M.pt ;
  tS : DS.TA I x pt = \ q lq -> M.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].fib ;
  anatS : W0.Ix (DS.anatEq I x pt tS) = \ r lq ->
   H.fibE-eq (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (DS.anatL I x pt tS r lq) (DS.anatR I x pt tS r lq)
    (pt.2.1 r lq)
    (transH (H.fibB-act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
               (DS.prz r.1.2.1 r.1.2.2.2.1 (pt.1 r.1 lq) (tS r.1 lq)))
      (M.a'.2.1 r lq))
    (\ V g j -> apH {W0.Ix (PE.FTg.FE.ob (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} {H.TA.EI V} (\ MM -> MM.1 V g j)
       (P3E.PN[X, M.lE].NT[r.1.1, r.1.2.1, r.1.2.2.1, r.1.2.2.2.1, r.1.2.2.2.2.1, (r.1.2.2.2.2.2, lq), r.2.1, r.2.2].law)) ;
  afaceS : W0.Ix (DS.afaceEq I x pt tS) = \ r lq ->
   H.fibE-eq (r.2.2.2.1, r.2.2.2.2.2.1) (DS.afaceL I x pt tS r lq) (DS.afaceR I x pt tS r lq)
    (pt.2.2.1 r lq) (M.a'.2.2.1 r lq)
    (\ V g j -> apH {W0.Ix (PE.FTg.FE.ob (r.2.2.2.1, r.2.2.2.2.2.1))} {H.TA.EI V} (\ MM -> MM.1 V g j)
       (P4E.PF[X, M.lE].FE[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (r.2.2.2.2.2.2.2, lq)].law)) ;
  module TP3 (r : VA.Ix (DS.D.topIdxV I x)) (lq : DS.D.topLd I x r) {
   module TT = P5E.PT[X, M.lE].TT[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (r.2.2.2.2.2, lq)] ;
   Y : TC.TOb = (r.2.1, r.2.2.2.1) ;
   uB : H.TF.EI TT.Y' = DS.prz TT.Y'.1 TT.Y'.2 (pt.1 (r.1, r.2.1, r.2.2.1, TT.z', TT.c', r.2.2.2.2.2) lq) (tS (r.1, r.2.1, r.2.2.1, TT.z', TT.c', r.2.2.2.2.2) lq) ;
   law : Id (H.TF.EI Y) (DS.atopL I x pt tS r lq) (H.TF.E.act Y TT.Y' TT.gv uB) =
    H.fibE-eq Y (DS.atopL I x pt tS r lq) (H.TF.E.act Y TT.Y' TT.gv uB) (pt.2.2.2 r lq)
     (transH (M.a'.2.2.2 r lq) (symH (H.fibB-act Y TT.Y' TT.gv uB)))
     (\ V g j -> apH {W0.Ix (PE.FTg.FE.ob Y)} {H.TA.EI V} (\ MM -> MM.1 V g j) TT.law) ;
  } ;
  atopS : W0.Ix (DS.atopEq I x pt tS) = \ r lq -> TP3[r, lq].law ;
  PsiF : DS.TOb' I x pt = (tS, anatS, afaceS, atopS) ;
 } ;
 -- the map of totals for CMove.Mv
 mS (W : TC.TOb) (v : HD.TF.EI W) : TR.P1.SigT (TC.toP DS.D.DCtx) DS.DTy W = (SE[W, v].pt, SE[W, v].PsiF) ;
} ;
