-- CTrLF4.seg (canonicity-c2; SAG 8.3, location-free truncation, part 4):
-- rebasing commutes with restriction for every good tree (CTrLF2/3), and the
-- rebased tree is good (by recursion; its naturality from the commutation and
-- the original tree's), so rebasing maps core's normal forms over (G, A) at
-- s d to those over (D, A[s]) at d.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[a+] ; open PR.PS ;
module W = V[a+] ;
module L = PR.PS ;
module G4 (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[D]) (psi : (X : Ob) (d : W.Ix (D.ob X)) -> W.Ix (A.tob X (s.nt X d)) -> W.Ix (B.tob X d)) (psiN : (J I : Ob) (f : Hom J I) (d : W.Ix (D.ob I)) (d' : W.Ix (D.ob J)) (e : Id (W.Ix (D.ob J)) (D.act J I f d) d') (v : W.Ix (A.tob I (s.nt I d))) -> Id (W.Ix (B.tob J d')) (B.tact J I f d d' e (psi I d v)) (psi J d' (A.tact J I f (s.nt I d) (s.nt J d') (ntEq D G s J I f d d' e) v))) {
 module CN = CTrLF3[a].CmN[D, G, s, A, B, psi, psiN] ;
 module RB = CN.RB ;
 module BG = RB.BG ;
 module BD = RB.BD ;
 module CR = CTruncRaw[a, a+] ;
 sl (d : BD.Loc) : BG.Loc = RB.sl d ;
 AG (t : BG.Raw) (good : BG.Good t) (d : BD.Loc) (e : Id BG.Loc (BG.root t) (sl d)) (r : BD.Loc) (h : BD.Arr r d)
   : BG.Good (BG.at t (sl d) e (sl r) (RB.arrS r d h)) * Id BG.Loc (BG.root (BG.at t (sl d) e (sl r) (RB.arrS r d h))) (sl r) =
  BG.at-good t good (sl d) e (sl r) (RB.arrS r d h) ;
 rootRb : (t : BG.Raw) (good : BG.Good t) (d : BD.Loc) (e : Id BG.Loc (BG.root t) (sl d)) -> Id BD.Loc (BD.root (RB.rb t good d e)) d = split {
  leaf z v -> \ good d e -> refl d ;
  node z Q u w -> \ good d e -> refl d } ;
 cm : (t : BG.Raw) (good : BG.Good t) (d : BD.Loc) (e : Id BG.Loc (BG.root t) (sl d)) (r : BD.Loc) (h : BD.Arr r d)
   -> Id BD.Raw (RB.rb (BG.at t (sl d) e (sl r) (RB.arrS r d h)) (AG t good d e r h).1 r (AG t good d e r h).2) (BD.at (RB.rb t good d e) d (rootRb t good d e) r h) = split {
  leaf z v -> \ good d e r h ->
   transH (RB.rbIrr (BG.at (leaf z v) (sl d) e (sl r) (RB.arrS r d h)) (AG (leaf z v) good d e r h).1 (RB.CmLeaf[z, v, d, e, r, h].ag).1 r
             (AG (leaf z v) good d e r h).2 (RB.CmLeaf[z, v, d, e, r, h].ag).2)
    RB.CmLeaf[z, v, d, e, r, h].res ;
  node z Q u w -> \ good d e r h -> CN.At[z, Q, u, w, good, d, e, r, h].res } ;
 -- the test at the identity, transported
 decId (z w : BG.Loc) (e : Id BG.Loc z w) (Q : PB.Phi z.1)
   : Id Bool (CR.dec z.1 z.1 Q (idH z.1)) (CR.dec w.1 w.1 (RB.tQ z w e Q) (idH w.1)) =
  idJ BG.Loc z (\ w2 e2 -> Id Bool (CR.dec z.1 z.1 Q (idH z.1)) (CR.dec w2.1 w2.1 (RB.tQ z w2 e2 Q) (idH w2.1)))
   (refl (CR.dec z.1 z.1 Q (idH z.1))) w e ;
 -- arrows of rebased children
 aD (z : BG.Loc) (d : BD.Loc) (e : Id BG.Loc z (sl d)) (r2 : BD.Loc) (h2 : BD.Arr r2 d) : BG.Arr (sl r2) z = RB.tA (sl r2) (sl d) z (symH e) (RB.arrS r2 d h2) ;
 aEq (z : BG.Loc) (d : BD.Loc) (e : Id BG.Loc z (sl d)) (r2 r3 : BD.Loc) (h2 : BD.Arr r2 d) (g3 : BD.Arr r3 r2)
   : Id (BG.Arr (sl r3) z) (BG.compose (sl r3) (sl r2) z (aD z d e r2 h2) (RB.arrS r3 r2 g3)) (aD z d e r3 (BD.compose r3 r2 d h2 g3)) =
  transH (RB.tAcomp (sl r3) (sl r2) z (sl d) e (RB.arrS r2 d h2) (RB.arrS r3 r2 g3))
   (apH {BG.Arr (sl r3) (sl d)} {BG.Arr (sl r3) z} (\ c -> RB.tA (sl r3) (sl d) z (symH e) c) (RB.arrSc r3 r2 d g3 h2)) ;
 -- the naturality conditions of a rebased node
 module NU (z : BG.Loc) (Q : PB.Phi z.1) (u : (q : BG.Loc) -> BG.Arr q z -> BG.Raw) (w : (q : BG.Loc) (h : BG.Arr q z) -> PB.Lands q.1 z.1 Q h.1 -> BG.Raw)
   (good : BG.Good (node z Q u w)) (d : BD.Loc) (e : Id BG.Loc z (sl d)) (r2 : BD.Loc) (h2 : BD.Arr r2 d) (r3 : BD.Loc) (g3 : BD.Arr r3 r2)
   (e' : Id BD.Loc (BD.root (RB.rb (u (sl r2) (aD z d e r2 h2)) (good.2.1 (sl r2) (aD z d e r2 h2)).1 r2 (good.2.1 (sl r2) (aD z d e r2 h2)).2)) r2) {
  c : BG.Raw = u (sl r2) (aD z d e r2 h2) ;
  gc : BG.Good c = (good.2.1 (sl r2) (aD z d e r2 h2)).1 ;
  ec : Id BG.Loc (BG.root c) (sl r2) = (good.2.1 (sl r2) (aD z d e r2 h2)).2 ;
  a3 : BG.Arr (sl r3) z = aD z d e r3 (BD.compose r3 r2 d h2 g3) ;
  res : Id BD.Raw (BD.at (RB.rb c gc r2 ec) r2 e' r3 g3) (RB.rb (u (sl r3) a3) (good.2.1 (sl r3) a3).1 r3 (good.2.1 (sl r3) a3).2) =
   transH (BD.at-irr (RB.rb c gc r2 ec) r2 e' (rootRb c gc r2 ec) r3 g3)
    (transH (symH (cm c gc r2 ec r3 g3))
      (RB.rbCong (BG.at c (sl r2) ec (sl r3) (RB.arrS r3 r2 g3)) (u (sl r3) a3)
         (transH (good.2.2.2.1 (sl r2) (aD z d e r2 h2) (sl r3) (RB.arrS r3 r2 g3) ec)
                 (apH {BG.Arr (sl r3) z} {BG.Raw} (\ k -> u (sl r3) k) (aEq z d e r2 r3 h2 g3)))
         (AG c gc r2 ec r3 g3).1 (good.2.1 (sl r3) a3).1 r3 (AG c gc r2 ec r3 g3).2 (good.2.1 (sl r3) a3).2)) ;
 } ;
 module NW (z : BG.Loc) (Q : PB.Phi z.1) (u : (q : BG.Loc) -> BG.Arr q z -> BG.Raw) (w : (q : BG.Loc) (h : BG.Arr q z) -> PB.Lands q.1 z.1 Q h.1 -> BG.Raw)
   (good : BG.Good (node z Q u w)) (d : BD.Loc) (e : Id BG.Loc z (sl d)) (r2 : BD.Loc) (h2 : BD.Arr r2 d)
   (i : PB.Lands r2.1 d.1 (RB.tQ z (sl d) e Q) h2.1) (r3 : BD.Loc) (g3 : BD.Arr r3 r2)
   (j : PB.Lands r3.1 d.1 (RB.tQ z (sl d) e Q) (BD.compose r3 r2 d h2 g3).1)
   (e' : Id BD.Loc (BD.root (RB.rb (w (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i))
          (good.2.2.1 (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i)).1 r2
          (good.2.2.1 (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i)).2)) r2) {
  iG : PB.Lands r2.1 z.1 Q (aD z d e r2 h2).1 = RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i ;
  c : BG.Raw = w (sl r2) (aD z d e r2 h2) iG ;
  gc : BG.Good c = (good.2.2.1 (sl r2) (aD z d e r2 h2) iG).1 ;
  ec : Id BG.Loc (BG.root c) (sl r2) = (good.2.2.1 (sl r2) (aD z d e r2 h2) iG).2 ;
  a3 : BG.Arr (sl r3) z = aD z d e r3 (BD.compose r3 r2 d h2 g3) ;
  jT : PB.Lands r3.1 z.1 Q a3.1 = RB.tL (sl r3) z (sl d) e Q (RB.arrS r3 d (BD.compose r3 r2 d h2 g3)) j ;
  jG : PB.Lands r3.1 z.1 Q (BG.compose (sl r3) (sl r2) z (aD z d e r2 h2) (RB.arrS r3 r2 g3)).1 =
   subst (BG.Arr (sl r3) z) (\ k -> PB.Lands r3.1 z.1 Q k.1) a3 (BG.compose (sl r3) (sl r2) z (aD z d e r2 h2) (RB.arrS r3 r2 g3)) (symH (aEq z d e r2 r3 h2 g3)) jT ;
  res : Id BD.Raw (BD.at (RB.rb c gc r2 ec) r2 e' r3 g3) (RB.rb (w (sl r3) a3 jT) (good.2.2.1 (sl r3) a3 jT).1 r3 (good.2.2.1 (sl r3) a3 jT).2) =
   transH (BD.at-irr (RB.rb c gc r2 ec) r2 e' (rootRb c gc r2 ec) r3 g3)
    (transH (symH (cm c gc r2 ec r3 g3))
      (RB.rbCong (BG.at c (sl r2) ec (sl r3) (RB.arrS r3 r2 g3)) (w (sl r3) a3 jT)
         (transH (good.2.2.2.2 (sl r2) (aD z d e r2 h2) iG (sl r3) (RB.arrS r3 r2 g3) jG ec)
                 (BG.boundary-cong z Q w (sl r3) (BG.compose (sl r3) (sl r2) z (aD z d e r2 h2) (RB.arrS r3 r2 g3)) a3 (aEq z d e r2 r3 h2 g3) jG jT))
         (AG c gc r2 ec r3 g3).1 (good.2.2.1 (sl r3) a3 jT).1 r3 (AG c gc r2 ec r3 g3).2 (good.2.2.1 (sl r3) a3 jT).2)) ;
 } ;
 -- the rebased tree is good
 goodRb : (t : BG.Raw) (good : BG.Good t) (d : BD.Loc) (e : Id BG.Loc (BG.root t) (sl d)) -> BD.Good (RB.rb t good d e) = split {
  leaf z v -> \ good d e -> tt ;
  node z Q u w | gu gw -> \ good d e ->
   (transH (symH (decId z (sl d) e Q)) good.1,
    (\ r2 h2 -> (gu (sl r2) (aD z d e r2 h2) (good.2.1 (sl r2) (aD z d e r2 h2)).1 r2 (good.2.1 (sl r2) (aD z d e r2 h2)).2,
                 rootRb (u (sl r2) (aD z d e r2 h2)) (good.2.1 (sl r2) (aD z d e r2 h2)).1 r2 (good.2.1 (sl r2) (aD z d e r2 h2)).2),
     (\ r2 h2 i -> (gw (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i)
                      (good.2.2.1 (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i)).1 r2
                      (good.2.2.1 (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i)).2,
                    rootRb (w (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i))
                      (good.2.2.1 (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i)).1 r2
                      (good.2.2.1 (sl r2) (aD z d e r2 h2) (RB.tL (sl r2) z (sl d) e Q (RB.arrS r2 d h2) i)).2),
      (\ r2 h2 r3 g3 e' -> NU[z, Q, u, w, good, d, e, r2, h2, r3, g3, e'].res,
       \ r2 h2 i r3 g3 j e' -> NW[z, Q, u, w, good, d, e, r2, h2, i, r3, g3, j, e'].res)))) } ;
 -- on normal forms
 module GD = CTruncGood[a, a+].GoodSets[D, B] ;
 rbE (d : BD.Loc) (t : BG.TrEl (sl d)) : BD.TrEl d =
  (RB.rb t.1 t.2.1 d t.2.2, (goodRb t.1 t.2.1 d t.2.2, rootRb t.1 t.2.1 d t.2.2)) ;
 -- rebasing commutes with restriction of normal forms
 rbRes (d r : BD.Loc) (h : BD.Arr r d) (t : BG.TrEl (sl d))
   : Id (BD.TrEl r) (rbE r (BG.tr-res (sl r) (sl d) (RB.arrS r d h) t)) (BD.tr-res r d h (rbE d t)) =
  GD.tr-eq r (rbE r (BG.tr-res (sl r) (sl d) (RB.arrS r d h) t)) (BD.tr-res r d h (rbE d t))
   (transH (RB.rbIrr (BG.at t.1 (sl d) t.2.2 (sl r) (RB.arrS r d h)) (BG.tr-res (sl r) (sl d) (RB.arrS r d h) t).2.1 (AG t.1 t.2.1 d t.2.2 r h).1 r
              (BG.tr-res (sl r) (sl d) (RB.arrS r d h) t).2.2 (AG t.1 t.2.1 d t.2.2 r h).2)
     (cm t.1 t.2.1 d t.2.2 r h)) ;
} ;
