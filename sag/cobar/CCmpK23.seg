-- CCmpK23.seg (canonicity-c2; (K) for cmpI, part 23): stage 2 concluded:
-- the map mu : Cb -> GS, the fibre element fEl (K18) at mu as the body,
-- three lambdas, and R2 : B2 over nil.Q by eliminating msurj natively.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module K23 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K22m = CCmpK22[a].K22[R, encK, pe, y] ;
 module K18m = CCmpK18[a].K18[R, encK, pe, y] ;
 module K20m = K22m.K20m ;
 module K19m = K22m.K19m ;
 module K12m = K19m.K12m ;
 module QS = K19m.QS ;
 module I = K12m.I ;
 Nl : C.Ctx = C.nil ;
 HTT : C.Ty Nl = K19m.HTT ;
 Cb : C.Ctx = K20m.Cb ;
 GB : C.Ctx = K12m.GB ;
 GS1 : C.Ctx = K12m.GS1 ;
 GS : C.Ctx = K12m.GS ;
 G1 : C.Ctx = K19m.G1 ;
 D2 : C.Ctx = K20m.D2 ;
 C2 : C.Ctx = K19m.C2 ;
 S1p : C.Ty D2 = C.subT D2 C2 K19m.S1' K20m.l2 ;
 mu0N (K : Ob) (w : V1.Ix (Cb.ob K)) : V1.Ix (GB.ob K) = (w.1.1.1.1.1, w.1.1.2) ;
 mu0 : C.Sub Cb GB = new L.PSub[Cb, GB, mu0N, \ J I f w -> refl (mu0N J (Cb.act J I f w))] ;
 pq : C.Sub Cb D2 = C.p D2 S1p ;
 PS1 : Id (C.Ty Cb) (C.subT Cb D2 S1p pq) (C.subT Cb GB K12m.S1 mu0) =
  transH (symH (C.subT-o Cb D2 C2 K19m.S1' K20m.l2 pq))
   (transH (symH (C.subT-o Cb C2 G1 QS.S K19m.sgS1 (C.o Cb D2 C2 K20m.l2 pq)))
     (transH (apH {C.Sub Cb G1} {C.Ty Cb} (\ s -> C.subT Cb G1 QS.S s)
               (L.sub-ext Cb G1 (C.o Cb C2 G1 K19m.sgS1 (C.o Cb D2 C2 K20m.l2 pq)) (C.o Cb GB G1 K12m.sg1 mu0) (\ K w -> refl ((C.o Cb GB G1 K12m.sg1 mu0).nt K w))))
       (C.subT-o Cb GB G1 QS.S K12m.sg1 mu0))) ;
 s1El : C.El Cb (C.subT Cb GB K12m.S1 mu0) = OV.trE Cb (C.subT Cb D2 S1p pq) (C.subT Cb GB K12m.S1 mu0) PS1 (C.q D2 S1p) ;
 mu1 : C.Sub Cb GS1 = CQSurj[a].Ex[C].exS Cb GB K12m.S1 mu0 s1El ;
 PS2 : Id (C.Ty Cb) (C.subT Cb QS.G1 QS.S K22m.SA.sg) (C.subT Cb GS1 K12m.S2 mu1) =
  transH (apH {C.Sub Cb G1} {C.Ty Cb} (\ s -> C.subT Cb G1 QS.S s)
           (L.sub-ext Cb G1 K22m.SA.sg (C.o Cb GS1 G1 K12m.sg2' mu1) (\ K w -> refl (K22m.SA.sg.nt K w))))
   (C.subT-o Cb GS1 G1 QS.S K12m.sg2' mu1) ;
 s2El : C.El Cb (C.subT Cb GS1 K12m.S2 mu1) = OV.trE Cb (C.subT Cb QS.G1 QS.S K22m.SA.sg) (C.subT Cb GS1 K12m.S2 mu1) PS2 K22m.s2 ;
 mu : C.Sub Cb GS = CQSurj[a].Ex[C].exS Cb GS1 K12m.S2 mu1 s2El ;
 -- the body
 FC3 : C.Ty Cb = C.subT Cb K19m.C3 K19m.F2 K20m.l3 ;
 PB : Id (C.Ty Cb) (C.subT Cb GS (C.subT GS GB I.Fib K12m.pp) mu) FC3 =
  transH (symH (C.subT-o Cb GS GB I.Fib K12m.pp mu))
   (transH (apH {C.Sub Cb GB} {C.Ty Cb} (\ s -> C.subT Cb GB I.Fib s)
             (L.sub-ext Cb GB (C.o Cb GS GB K12m.pp mu) (C.o Cb K19m.C3 GB K19m.tg K20m.l3) (\ K w -> refl (mu0N K w))))
     (C.subT-o Cb K19m.C3 GB I.Fib K19m.tg K20m.l3)) ;
 body : C.El Cb FC3 = OV.trE Cb (C.subT Cb GS (C.subT GS GB I.Fib K12m.pp) mu) FC3 PB (C.subt Cb GS (C.subT GS GB I.Fib K12m.pp) K18m.fEl mu) ;
} ;
