-- The underlying quotient values at every object of the total site.
-- A total arrow (J,y) -> (I,x) carries a map A_x -> A_y at J.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Underlying (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module CM = CC.CM ;
 module MO = CM.MO ;
 module TP = CM.TP ;
 Pres : U a = CM.Pres ;
 ob (I : Ob) (x : Pres) : V1.V = MO.At[x].QV I ;
 act (J I : Ob) (u : Hom J I) (y x : Pres) (f : MO.Fn[x, y].M J) (q : V1.Ix (ob I x)) : V1.Ix (ob J y) =
  MO.Fn[x, y].ph J f J (idH J) (MO.At[x].rs I J u q) ;
 act-id (I : Ob) (x : Pres) (q : V1.Ix (ob I x)) :
  Id (V1.Ix (ob I x)) (act I I (idH I) x x (CM.CO.idM I x) q) q =
  MO.At[x].Qt.1.tact-id I tt (refl tt) q ;
 module Compose (K J I : Ob) (u : Hom J I) (v : Hom K J) (z y x : Pres)
  (f : MO.Fn[x, y].M J) (g : MO.Fn[y, z].M K) (q : V1.Ix (ob I x)) {
  module F = MO.Fn[x, y] ;
  module G = MO.Fn[y, z] ;
  qJ : F.S.QK J = F.S.rs I J u q ;
  qK : F.S.QK K = F.S.rs I K (compH K J I u v) q ;
  qr : F.S.QK K = F.S.rs J K v qJ ;
  eQ : Id (F.S.QK K) qK qr =
   F.S.Qt.1.tact-o K J I u v tt tt tt (refl tt) (refl tt) (refl tt) q ;
  eF : Id (F.T.QK K) (F.ph J f K v qr) (F.T.rs J K v (F.ph J f J (idH J) qJ)) =
   symH (transH (F.nt J f J K (idH J) v qJ)
    (apH {Hom K J} {F.T.QK K} (\ h -> F.ph J f K h qr) (comp-idl K J v))) ;
  eI : Id (F.T.QK K) (F.ph J f K (compH K K J v (idH K)) qK) (F.T.rs J K v (F.ph J f J (idH J) qJ)) =
   transH (apH {Hom K J} {F.T.QK K} (\ h -> F.ph J f K h qK) (comp-idr K J v))
    (transH (apH {F.S.QK K} {F.T.QK K} (F.ph J f K v) eQ) eF) ;
  law : Id (V1.Ix (ob K z))
    (act K I (compH K J I u v) z x (CM.CO.cmpM K J I v z y x f g) q)
    (act K J v z y g (act J I u y x f q)) =
   apH {F.T.QK K} {G.T.QK K} (G.ph K g K (idH K)) eI ;
 } ;
 ctx : TP.TCtx = new TP.TCtx[ob, act, act-id,
  \ K J I u v z y x f g q -> Compose[K, J, I, u, v, z, y, x, f, g, q].law] ;
 module Y = CM.Yo[CM.F1] ;
 module FS = MO.At[CM.F1] ;
 gen : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil FS.Qt = FS.AX.cls (var (inr tt)) ;
 eval (I : Ob) (x : Pres) (h : V1.Ix (Y.yoT.ob I x)) : V1.Ix (ob I x) =
  MO.Fn[CM.F1, x].ph I h I (idH I) (gen.eob I tt) ;
 module EvalNat (J I : Ob) (u : Hom J I) (y x : Pres)
  (f : MO.Fn[x, y].M J) (h : V1.Ix (Y.yoT.ob I x)) {
  module H = MO.Fn[CM.F1, x] ;
  module F = MO.Fn[x, y] ;
  eG : Id (FS.QK J) (FS.rs I J u (gen.eob I tt)) (gen.eob J tt) =
   gen.enat J I u tt tt (refl tt) ;
  eH : Id (H.T.QK J) (H.ph I h J u (FS.rs I J u (gen.eob I tt)))
   (H.T.rs I J u (eval I x h)) =
   symH (transH (H.nt I h I J (idH I) u (gen.eob I tt))
    (apH {Hom J I} {H.T.QK J} (\ k -> H.ph I h J k (FS.rs I J u (gen.eob I tt))) (comp-idl J I u))) ;
  e0 : Id (H.T.QK J) (H.ph I h J (compH J J I u (idH J)) (gen.eob J tt))
   (H.T.rs I J u (eval I x h)) =
   transH (apH {Hom J I} {H.T.QK J} (\ k -> H.ph I h J k (gen.eob J tt)) (comp-idr J I u))
    (transH (apH {FS.QK J} {H.T.QK J} (H.ph I h J u) (symH eG)) eH) ;
  law : Id (V1.Ix (ob J y)) (eval J y (Y.yoT.act J I u y x f h)) (act J I u y x f (eval I x h)) =
   apH {H.T.QK J} {F.T.QK J} (F.ph J f J (idH J)) e0 ;
 } ;
 ev : TP.TSub[Y.yoT, ctx] = new TP.TSub[Y.yoT, ctx, eval,
  \ J I u y x f h -> EvalNat[J, I, u, y, x, f, h].law] ;
} ;
