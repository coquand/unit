-- CAxPow.seg (canonicity-c2; the axioms' statements, part 1): G as a type of
-- the total site's fibrant CwF (45's GT with its fibration structure fbGT),
-- G over any context, and the powers G^k as telescopes nil.G...G with their
-- variables.  The statements quantify over metatheory u = (n, m, shapes):
-- a metatheory schema (see CAxStat).
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module PowOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module GB = CGBr[a].GBr[R, encK, pe] ;
 module TR = GB.LB.TR ;
 module G1 = TR.G1 ;
 C : CwF.CwF[a++] = G1.fibCwF-T ;
 module OV = CwFOv.Ov[a++, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T] ;
 Nl : C.Ctx = C.nil ;
 -- G, a fibrant type over the terminal context
 GTy : C.Ty Nl = (GB.GT, GB.fbGT) ;
 -- G over any context (along the unique map to nil)
 Gat (D : C.Ctx) : C.Ty D = C.subT D Nl GTy (C.eps D) ;
 wkG (D : C.Ctx) (A : C.Ty D) : Id (C.Ty (C.ext D A)) (C.subT (C.ext D A) D (Gat D) (C.p D A)) (Gat (C.ext D A)) =
  transH (symH (C.subT-o (C.ext D A) D Nl GTy (C.eps D) (C.p D A)))
   (apH {C.Sub (C.ext D A) Nl} {C.Ty (C.ext D A)} (\ s -> C.subT (C.ext D A) Nl GTy s)
     (transH (C.eps-uniq (C.ext D A) (C.o (C.ext D A) D Nl (C.eps D) (C.p D A))) (symH (C.eps-uniq (C.ext D A) (C.eps (C.ext D A)))))) ;
 -- an element of G weakened
 wkE (D : C.Ctx) (A : C.Ty D) (g : C.El D (Gat D)) : C.El (C.ext D A) (Gat (C.ext D A)) =
  OV.trE (C.ext D A) (C.subT (C.ext D A) D (Gat D) (C.p D A)) (Gat (C.ext D A)) (wkG D A) (C.subt (C.ext D A) D (Gat D) g (C.p D A)) ;
 -- the telescope D.G^k over a context D, and its variables (the last one is k-1)
 Ext (D : C.Ctx) : Nat -> C.Ctx = split { zero -> D ; suc k | r -> C.ext r (Gat r) } ;
 vr (D : C.Ctx) : (k : Nat) -> SX.Fin k -> C.El (Ext D k) (Gat (Ext D k)) = split {
  zero -> \ v -> absurd (C.El D (Gat D)) v ;
  suc k | r -> split {
   inl v -> wkE (Ext D k) (Gat (Ext D k)) (r v) ;
   inr u -> OV.trE (Ext D (suc k)) (C.subT (Ext D (suc k)) (Ext D k) (Gat (Ext D k)) (C.p (Ext D k) (Gat (Ext D k)))) (Gat (Ext D (suc k)))
              (wkG (Ext D k) (Gat (Ext D k))) (C.q (Ext D k) (Gat (Ext D k))) } } ;
 -- G^k
 Gk (k : Nat) : C.Ctx = Ext Nl k ;
} ;
