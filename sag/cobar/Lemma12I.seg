-- Lemma12I.seg (canonicity-45; SIMPLIFIED.md step 4): Lemma 12 over the
-- total site, part 1: the uniform face equations.  For w an element of
-- D G at (I, x) (resp. av of D A over it), the value at the face d_k i of
-- a weight at the stage J, k <= n+1, is the value at i on the chain d_k c
-- = fc n k c, acted on along its map (the identity for k <= n, the last
-- map for k = n+1), through the vertical action of G (resp. of G.A) at J:
--   UD.uf : w (n+1, J, u, z, c, d_k i) = vertAct (fc k).2.2 (w (n, J, u, (fc k).1, (fc k).2.1, i))
--   UA.uf : the same in the total space G.A
-- Weight-level lemmas copied from Lemma12 (faceW-irr, resres, resid).
-- The second half (D of a levelwise trivial fibration is a trivial
-- fibration) needs partial elements over the sieves of the total site
-- (GrothCB, canonicity-c2) and follows when that exists.
-- No new axioms beyond the named premises (fe).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module L12I (C : CIntCat[a].IC) (G : CTPsh[a, l].TPshOf[C].TCtx) (A : Presheaf[a, l].Psh[CTotCat[a, l].TotOf[C].TotCat].PTy[CTotCat[a, l].TotOf[C].toP G]) {
 module TC = CTotCat[a, l].TotOf[C] ;
 module P = Presheaf[a, l].Psh[TC.TotCat] ;
 module VT = CVert[a].VertOf[C] ;
 module TP = CTPsh[a, l].TPshOf[C] ;
 module DO = CobarI[a, l].DOfI[C] ;
 module D = DO.DC[G] ;
 module DA = CobarIT[a, l].DTI[C, G, A] ;
 Obj (I : Ob) : U a = VT.Obj I ;
 E : P.PCtx = P.extP DA.GP A ;

 ------------------------------------------------------------------
 -- the face of a weight does not depend on the bound proof

 valIrr (n : Nat) (J : Ob) (y : Nat) (hy hy' : Tr.IsT (Tr.leb y (suc n))) (i : Wt.Coords n J) (jn : Nat) (hj : Tr.IsT (Tr.leb jn (suc n)))
  : (b : Bool) -> (e : Id Bool (eqN jn y) b)
    -> Id (Hom J PFO.ivO) (Wt.Face[n, J, y, hy].valB i jn hj b e) (Wt.Face[n, J, y, hy'].valB i jn hj b e) = split {
  true -> \ e -> refl (PB.ptH J PB.e0) ;
  false -> \ e -> refl (i (Ar.dg n y jn, Ar.dg-range n y jn hj)) } ;

 faceW-irr (n : Nat) (J : Ob) (y : Nat) (hy hy' : Tr.IsT (Tr.leb y (suc n))) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[i].face) (Wt.Face[n, J, y, hy'].Of[i].face) =
  Sigma-eq (Wt.Coords (suc n) J) (\ cs -> PB.Lands J J (Wt.oneS (suc n) J cs) (PB.idH J))
   (Wt.Face[n, J, y, hy].Of[i].face).1 (Wt.Face[n, J, y, hy'].Of[i].face).1
   (Wt.Face[n, J, y, hy].Of[i].face).2 (Wt.Face[n, J, y, hy'].Of[i].face).2
   (funext (Ar.Fin (suc (suc n))) (\ j -> Hom J PFO.ivO) (Wt.Face[n, J, y, hy].Of[i].face).1 (Wt.Face[n, J, y, hy'].Of[i].face).1
      (\ j -> valIrr n J y hy hy' i.1 j.1 j.2 (eqN j.1 y) (refl (eqN j.1 y))))
   (PB.isProp-Lands J J (Wt.oneS (suc n) J (Wt.Face[n, J, y, hy'].Of[i].face).1) (PB.idH J)) ;

 ------------------------------------------------------------------
 -- uniform faces of an element of D G, at the stage J of the weight

 module UD (I : Ob) (x : Obj I) (w : D.Ob' I x) (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : DO.KJ[J].K.Ch (suc n) (C.res J I u x) z) (i : Wt.Pn n J) {
  module K = DO.KJ[J].K ;
  rux : Obj J = C.res J I u x ;
  fcD (k : Nat) : K.DR n rux z = K.fc n k rux z c ;
  rd (DD : K.DR n rux z) : W0.Ix (G.ob J z) = TP.vertAct G J z DD.1 DD.2.2 (w.1 (n, J, u, DD.1, DD.2.1, i.1) i.2) ;
  rhs (k : Nat) : W0.Ix (G.ob J z) = rd (fcD k) ;
  lhs (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : W0.Ix (G.ob J z) =
   D.at I x w.1 (suc n) J u z c (Wt.Face[n, J, k, hk].Of[i].face) ;
  -- the value at a face does not depend on the bound proof
  lhs-irr (k : Nat) (hk hk' : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix (G.ob J z)) (lhs k hk) (lhs k hk') =
   apH {Wt.Pn (suc n) J} {W0.Ix (G.ob J z)} (\ p -> w.1 (suc n, J, u, z, c, p.1) p.2) (faceW-irr n J k hk hk' i) ;
  low (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (hk' : Tr.IsT (Tr.leb k n)) : Id (W0.Ix (G.ob J z)) (lhs k hk) (rhs k) =
   transH (lhs-irr k hk (Ar.leb-step k n hk'))
    (transH (w.2.2.1 (n, k, hk', J, u, z, c, i.1) i.2)
      (transH (symH (G.act-id J z (w.1 (n, J, u, z, K.comp n k rux z c, i.1) i.2)))
        (apH {K.DR n rux z} {W0.Ix (G.ob J z)} rd (symH (K.fc-comp n k hk' rux z c))))) ;
  top (hk : Tr.IsT (Tr.leb (suc n) (suc n))) : Id (W0.Ix (G.ob J z)) (lhs (suc n) hk) (rhs (suc n)) =
   transH (lhs-irr (suc n) hk (Tr.leb-refl (suc n)))
    (transH (w.2.2.2 (n, J, u, z, c, i.1) i.2)
      (apH {K.DR n rux z} {W0.Ix (G.ob J z)} rd (symH (K.fc-top n rux z c)))) ;
  uf (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix (G.ob J z)) (lhs k hk) (rhs k) =
   Arith[l].eqN-dec (Id (W0.Ix (G.ob J z)) (lhs k hk) (rhs k)) k (suc n)
    (\ e -> idJ Nat (suc n) (\ k2 e2 -> (h2 : Tr.IsT (Tr.leb k2 (suc n))) -> Id (W0.Ix (G.ob J z)) (lhs k2 h2) (rhs k2))
              (\ h2 -> top h2) k (sym Nat k (suc n) e) hk)
    (\ ne -> low k hk (Ar.leb-suc-neq k n hk ne)) ;
 } ;

 ------------------------------------------------------------------
 -- uniform faces of an element of D A over w, in the total space G.A

 module UA (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : DA.TOb' I x w) (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : DO.KJ[J].K.Ch (suc n) (C.res J I u x) z) (i : Wt.Pn n J) {
  module K = DO.KJ[J].K ;
  rux : Obj J = C.res J I u x ;
  fcD (k : Nat) : K.DR n rux z = K.fc n k rux z c ;
  rd (DD : K.DR n rux z) : DA.Ez J z =
   E.act (J, z) (J, DD.1) (idH J, DD.2.2) (DA.prz J DD.1 (w.1 (n, J, u, DD.1, DD.2.1, i.1) i.2) (av.1 (n, J, u, DD.1, DD.2.1, i.1) i.2)) ;
  rhs (k : Nat) : DA.Ez J z = rd (fcD k) ;
  lhs (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : DA.Ez J z =
   DA.prz J z (w.1 (suc n, J, u, z, c, (Wt.Face[n, J, k, hk].Of[i].face).1) (Wt.Face[n, J, k, hk].Of[i].face).2)
              (av.1 (suc n, J, u, z, c, (Wt.Face[n, J, k, hk].Of[i].face).1) (Wt.Face[n, J, k, hk].Of[i].face).2) ;
  lhs-irr (k : Nat) (hk hk' : Tr.IsT (Tr.leb k (suc n))) : Id (DA.Ez J z) (lhs k hk) (lhs k hk') =
   apH {Wt.Pn (suc n) J} {DA.Ez J z} (\ p -> DA.prz J z (w.1 (suc n, J, u, z, c, p.1) p.2) (av.1 (suc n, J, u, z, c, p.1) p.2)) (faceW-irr n J k hk hk' i) ;
  low (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (hk' : Tr.IsT (Tr.leb k n)) : Id (DA.Ez J z) (lhs k hk) (rhs k) =
   transH (lhs-irr k hk (Ar.leb-step k n hk'))
    (transH (av.2.2.1 (n, k, hk', J, u, z, c, i.1) i.2)
      (transH (symH (E.act-id (J, z) (DA.prz J z (w.1 (n, J, u, z, K.comp n k rux z c, i.1) i.2) (av.1 (n, J, u, z, K.comp n k rux z c, i.1) i.2))))
        (apH {K.DR n rux z} {DA.Ez J z} rd (symH (K.fc-comp n k hk' rux z c))))) ;
  top (hk : Tr.IsT (Tr.leb (suc n) (suc n))) : Id (DA.Ez J z) (lhs (suc n) hk) (rhs (suc n)) =
   transH (lhs-irr (suc n) hk (Tr.leb-refl (suc n)))
    (transH (av.2.2.2 (n, J, u, z, c, i.1) i.2)
      (apH {K.DR n rux z} {DA.Ez J z} rd (symH (K.fc-top n rux z c)))) ;
  uf (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : Id (DA.Ez J z) (lhs k hk) (rhs k) =
   Arith[l].eqN-dec (Id (DA.Ez J z) (lhs k hk) (rhs k)) k (suc n)
    (\ e -> idJ Nat (suc n) (\ k2 e2 -> (h2 : Tr.IsT (Tr.leb k2 (suc n))) -> Id (DA.Ez J z) (lhs k2 h2) (rhs k2))
              (\ h2 -> top h2) k (sym Nat k (suc n) e) hk)
    (\ ne -> low k hk (Ar.leb-suc-neq k n hk ne)) ;
 } ;

 ------------------------------------------------------------------
 -- weights restricted twice, and along the identity

 resres (n : Nat) (W'' W' W : Ob) (h : Hom W' W) (chi : Hom W'' W') (i : Wt.Pn n W)
  : Id (Wt.Pn n W'') (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res) (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res) =
  Sigma-eq (Wt.Coords n W'') (\ cs -> PB.Lands W'' W'' (Wt.oneS n W'' cs) (PB.idH W''))
   (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).1 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1
   (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).2 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W'' PFO.ivO)
      (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).1 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1
      (\ k -> PB.comp-assoc W'' W' W PFO.ivO (i.1 k) h chi))
   (PB.isProp-Lands W'' W'' (Wt.oneS n W'' (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1) (PB.idH W'')) ;

 resid (n : Nat) (W : Ob) (i : Wt.Pn n W) : Id (Wt.Pn n W) (Wt.Res[n, W, W, PB.idH W, i].res) i =
  Sigma-eq (Wt.Coords n W) (\ cs -> PB.Lands W W (Wt.oneS n W cs) (PB.idH W))
   (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (Wt.Res[n, W, W, PB.idH W, i].res).2 i.2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W PFO.ivO) (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (\ k -> PB.comp-idr W PFO.ivO (i.1 k)))
   (PB.isProp-Lands W W (Wt.oneS n W i.1) (PB.idH W)) ;

} ;
