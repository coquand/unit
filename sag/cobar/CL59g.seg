-- CL59g.seg (canonicity-45; COBAR.md "Lemma 59"): for A a fibrant type
-- over yo(y) at the total site, U(yo(y).A) is levelwise fibrant, for our C.
-- At a copy y' its fibre at I is Sigma (m : the code set of yo(y) at the
-- copy) A(m): the Sigma (CSig.SigFib) of U(yo y) at the copy (CCopy9) and
-- of A's levelwise structure (CTotUFib4.fibU) restricted to the copy
-- (CCopy8.FibR) and pulled back along the second projection (CFibSub),
-- moved to U(yo(y).A) at the copy (CCart); the copies assemble
-- (CCopy5.FibC).
-- Specific to this C (constant objects).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module EF (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation)
  (A : CCopy9[a].YoFF[R, encK, pe, y].TR.G1.fibCwF-T.Ty (CCopy9[a].YoFF[R, encK, pe, y].CT.TC.toP (CCopy9[a].YoFF[R, encK, pe, y].CM.Yo[y].yoT))) {
 module YF = CCopy9[a].YoFF[R, encK, pe, y] ;
 module TR = YF.TR ;
 module CT = YF.CT ;
 module CM = YF.CM ;
 PYy : TR.P1.PCtx = CT.TC.toP (CM.Yo[y].yoT) ;
 E : TR.P1.PCtx = TR.P1.extP PYy A.1 ;
 module OE = CT.Of[CT.TC.ofP E] ;
 UAE : TR.P0.PTy[YF.UG] = TR.RS.rT YF.GP OE.Y1T ;
 module U4 = CTotUFib4[a, a+, a+].UFib4[CM.IC] ;
 fbA0 : TR.G0.GB.CLine[a+].Lines[TR.RS.rC PYy, TR.RS.rT PYy A.1].Fib = U4.fibU PYy A.1 A.2 ;
 module Cp (y' : SX.Over[R].Presentation) {
  module C9 = YF.Cp[y'] ;
  module Cy = C9.Cy ;
  D : L.PCtx = C9.D ;
  T1 : L.PTy[D] = C9.A' ;
  DY : L.PCtx = Cy.rCy (TR.RS.rC PYy) ;
  AY : L.PTy[DY] = Cy.rTy (TR.RS.rC PYy) (TR.RS.rT PYy A.1) ;
  fbAy : PB.CLine[a+].Lines[DY, AY].Fib = CCopy8[a].FibR[R, encK, pe, TR.RS.rC PYy, TR.RS.rT PYy A.1, fbA0, y'].fib ;
  K : L.PCtx = L.extP D T1 ;
  module TT = PB.GPre[a+].TyL[D, T1] ;
  sNat (Vv W : Ob) (g : Hom Vv W) (k : V1.Ix (K.ob W)) : Id (V1.Ix (DY.ob Vv)) (TT.pr2 Vv (K.act Vv W g k)) (DY.act Vv W g (TT.pr2 W k)) =
   refl (TT.pr2 Vv (K.act Vv W g k)) ;
  sB : L.PSub[K, DY] = new L.PSub[K, DY, \ W k -> TT.pr2 W k, \ Vv W g k -> refl (TT.pr2 Vv (K.act Vv W g k))] ;
  A2 : L.PTy[K] = L.subTy K DY AY sB ;
  fbA2 : PB.CLine[a+].Lines[K, A2].Fib = PB.CFibSub[a+].FibSub[K, DY, sB, AY].sub fbAy ;
  SgP : L.PTy[D] = PresheafFormers[a, a+].PFormers[PB.BC].SigAB[D, T1, A2].SigP ;
  fbS : PB.CLine[a+].Lines[D, SgP].Fib = PB.CSig[a+].SigFib[D, T1, A2, C9.fib, fbA2].fib ;
  -- U(yo(y).A) at the copy
  A' : L.PTy[D] = Cy.rTy YF.UG UAE ;
  module TA' = PB.GPre[a+].TyL[D, A'] ;
  module TS = PB.GPre[a+].TyL[D, SgP] ;
  ta (W : Ob) (v : TA'.EI W) : TS.EI W = TS.pr W (TA'.pr1 W v) (TA'.pr2 W v) ;
  tanat (Vv W : Ob) (g : Hom Vv W) (v : TA'.EI W) : Id (TS.EI Vv) (TS.E.act Vv W g (ta W v)) (ta Vv (TA'.E.act Vv W g v)) =
   refl (ta Vv (TA'.E.act Vv W g v)) ;
  tainj (W : Ob) (v v' : TA'.EI W) (Pp : Id (V1.Ix (D.ob W)) (TA'.pr1 W v) (TA'.pr1 W v')) (Q0 : Id (TS.EI W) (ta W v) (ta W v')) : Id (TA'.EI W) v v' = Q0 ;
  module CRT = PB.CCart[a+, a+].Cart[D, A', D, SgP, \ W o -> o, \ Vv W g d -> refl (D.act Vv W g d), ta, \ W v -> refl (TA'.pr1 W v),
    tanat, tainj, \ X x uu -> uu, \ X x uu -> refl (TS.pr X x uu)] ;
  fib : PB.CLine[a+].Lines[D, A'].Fib = CRT.moveFib fbS ;
 } ;
 -- U(yo(y).A) is levelwise fibrant
 fibG0 : TR.G0.GB.CLine[a+].Lines[YF.UG, UAE].Fib = CCopy5[a].FibC[R, encK, pe, YF.UG, UAE, \ y' -> Cp[y'].fib].fib ;
} ;
