-- CMapsC2.seg (canonicity-45; SIMPLIFIED.md step 6): the substitution maps
-- as morphisms of C at every stage, part 2 (split from CMapsC for the
-- 10-second cap): the multiplication's and the constants' data, and the
-- morphism through CBridge.  Against the eliminator package of the
-- quotient (c2's CwFQuotElim1.QE1, here module parameters in the agreed
-- shapes: elim1 / elim1-beta / setQ, elim2 / elim2-beta, ElimP1 / ElimP3,
-- setQi), with C's operations the quotient's (CAlgX.Ops.addQ / mulQ):
--   lawA / lawM / lawK  the homomorphism laws of Phi at classes (Phi's beta,
--                       the operations' beta rules, CAlgX's congruences,
--                       apM on Phi's body)
--   Map[s, t, sg, eqP].mor J : A_s -> A_t at the stage J (CBridge, with the
--                       data of CHomData), natural in J (mor-nat)
-- Instances: I1, I2, AddF, MulF (F1 -> F2) and Pu x u (A_x -> A_{x.u}).
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module Inst2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (elim1 : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Ty)
 (elim1-beta : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Beta (elim1 x))
 (setQ : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].SetQ)
 (elim2 : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Ty)
 (elim2-beta : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Beta (elim2 x))
 (elimP1 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP1Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (elimP3 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP3Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (setQi : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].SetQiTy) {
 module IN = CMapsC[a].Inst[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi] ;
 addO (x : SX.Over[R].Presentation) : C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)) = IN.addO x ;
 mulO (x : SX.Over[R].Presentation) : C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)) = IN.mulO x ;
 module AXo (x : SX.Over[R].Presentation) { module A = CAlgX[a].AlgX[R, encK, x, pe] ; } ;
 module MapOf (s t : SX.Over[R].Presentation)
  (Phi : C.El C.nil (OV.Fun C.nil AXo[s].A.Qt AXo[t].A.Qt))
  (fT : AXo[s].A.Term -> AXo[t].A.Term)
  (beta : (u : AXo[s].A.Term) -> C.El C.nil (AXo[t].A.IdQ (OV.app C.nil AXo[s].A.Qt AXo[t].A.Qt Phi (AXo[s].A.cls u)) (AXo[t].A.cls (fT u))))
  (fsum : (u v : AXo[s].A.Term) -> Id (AXo[t].A.Term) (fT (sumE u v)) (sumE (fT u) (fT v)))
  (fmul : (u v : AXo[s].A.Term) -> Id (AXo[t].A.Term) (fT (mulE u v)) (mulE (fT u) (fT v)))
  (fcst : (c : R.R) -> Id (AXo[t].A.Term) (fT (cst c)) (cst c)) {
  module AS = AXo[s].A ;
  module AT = AXo[t].A ;
  module M1 = IN.MapOf[s, t, Phi, fT, beta, fsum, fmul, fcst] ;
  module HO = M1.HO ;
  module DM = HO.Bin[IN.mulO s, IN.mulO t].DataA[elimP3 s, setQi t, M1.lawM] ;
  module BR = CBridge[a].Bridge[R, encK, pe, IN.addO, IN.mulO, s, t, Phi, M1.DA.dA, DM.dA, \ c -> HO.Cst[AS.cls (cst c), AT.cls (cst c)].DataC[elimP1 s, setQi t, M1.lawK c].dC] ;
  mor (J : Ob) : CMorX[a].MorOf[R, encK, pe, IN.addO, IN.mulO].Fn[s, t].M J = BR.mor J ;
  mor-nat (J K : Ob) (v : Hom K J) : Id (CMorX[a].MorOf[R, encK, pe, IN.addO, IN.mulO].Fn[s, t].M K) (CMorX[a].MorOf[R, encK, pe, IN.addO, IN.mulO].Fn[s, t].res J K v (mor J)) (mor K) =
   BR.mor-nat J K v ;
 } ;
} ;
