-- CCeEq3.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', on the
-- closed copy Ec of yo(y).A, for an equation p of y.u at its place in A's
-- telescope: Q's evaluation of p at the Q-tuple is homotopic to 0, through
--   ChainQ (CCeEq) ; E1 for psi (CPsiOps2) at the G-tuple ;
--   psi of A's equation read at the copy (CEqHt, read by CCeEq2) ;
--   psi(0) ~ 0 (CPsiOps2's constants).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module E3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module EQ = CCeEq[a].EQ[R, encK, pe, y, u, y'] ;
 module E2 = CCeEq2[a].E2[R, encK, pe, y, u] ;
 module EH = CEqHt[a].EH[R, encK, pe, y, u] ;
 module TU = EQ.TU ;
 module HO = TU.HO ;
 module PO2 = TU.PO2 ;
 module AP = TU.AP ;
 module UP = E2.UP ;
 module SO = UP.SO ;
 C : CwF.CwF[a++] = UP.C ;
 Nl : L.PCtx = TU.Nl ;
 Ec : L.PTy[Nl] = TU.Ec ;
 Qc : L.PTy[Nl] = TU.Qc ;
 Tc : L.PTy[Nl] = PO2.Tc ;
 kk : Nat = TU.kk ;
 Exs : U a = SX.Over[R].Expr (SX.Fin kk) ;
 Lqs (ps : SX.Over[R].Equations (SX.Fin kk)) : SX.Over[R].Equations SO.TW.Var = SX.mapL Exs (SX.Over[R].Expr SO.TW.Var) EQ.RN ps ;
 module Q (p : Exs) (ps : SX.Over[R].Equations (SX.Fin kk)) (s : C.Sub UP.E (SO.HS (cons (EQ.RN p) (Lqs ps))).1)
   (J : (X : E2.TOb) (w : V1.Ix (UP.E.ob X)) -> Id (V1.Ix (SO.Xc.ob X)) ((SO.HS (cons (EQ.RN p) (Lqs ps))).2.nt X (s.nt X w)) ((TU.CV.XS.nt X w).1)) {
  q : SX.Over[R].Expr SO.TW.Var = EQ.RN p ;
  module EQh = EH.Eq[q, Lqs ps, s] ;
  module CH = EQh.Cp[y'] ;
  mA : HO.NMap[Nl, Ec, Tc] = CH.RO.rN EQh.I.mA ;
  mB : HO.NMap[Nl, Ec, Tc] = CH.RO.rN EQh.I.mB ;
  rA (I : Ob) (w : V1.Ix (Ec.tob I tt)) : Id (V1.Ix (Tc.tob I tt)) (mA.nfun I tt w) (SO.TW.ev q (TU.CV.K0 I) (TU.CV.xi I w)) =
   transH (E2.gRd (SO.HS (Lqs ps)).1 (SO.HS (Lqs ps)).2 (SO.TW.evE q) (TU.CV.K0 I) ((s.nt (TU.CV.K0 I) w).1))
    (apH {V1.Ix (SO.Xc.ob (TU.CV.K0 I))} {V1.Ix (Tc.tob I tt)} (SO.TW.ev q (TU.CV.K0 I)) (J (TU.CV.K0 I) w)) ;
  rB (I : Ob) (w : V1.Ix (Ec.tob I tt)) : Id (V1.Ix (Tc.tob I tt)) (mB.nfun I tt w) (TU.H.cT R.z I tt) =
   E2.gRd (SO.HS (Lqs ps)).1 (SO.HS (Lqs ps)).2 SO.zE (TU.CV.K0 I) ((s.nt (TU.CV.K0 I) w).1) ;
  -- the chain
  psi : HO.NMap[Nl, Tc, Qc] = PO2.psi ;
  GE : HO.NMap[Nl, Ec, Qc] = HO.compN Nl Ec TU.PG Qc TU.tupG (HO.compN Nl TU.PG Tc Qc (AP.evA kk p) psi) ;
  module H2 = HO.WR[Nl, TU.PG, Qc, Ec, AP.evGt kk p, HO.compN Nl TU.PG Tc Qc (AP.evA kk p) psi, TU.tupG, PO2.E1 kk p] ;
  module C1 = HO.Cat[Nl, Ec, Qc, EQ.LQ p, EQ.LG p, GE, PO2.PQ.RD.cQ, EQ.ChainQ p, H2.res] ;
  module H3 = HO.WL[Nl, Ec, Tc, Qc, mA, mB, psi, CH.res] ;
  pa3 (I : Ob) : (o : Top) (w : V1.Ix (Ec.tob I o)) -> Id (V1.Ix (Qc.tob I o)) (GE.nfun I o w) ((HO.compN Nl Ec Tc Qc mA psi).nfun I o w) = split {
   tt -> \ w -> apH {V1.Ix (Tc.tob I tt)} {V1.Ix (Qc.tob I tt)} (psi.nfun I tt) (transH (EQ.evIdG p I (TU.CV.xi I w)) (symH (rA I w))) } ;
  module R3 = HO.Ret[Nl, Ec, Qc, HO.compN Nl Ec Tc Qc mA psi, HO.compN Nl Ec Tc Qc mB psi, GE, HO.compN Nl Ec Tc Qc mB psi,
    pa3, \ I o w -> refl ((HO.compN Nl Ec Tc Qc mB psi).nfun I o w), H3.res] ;
  module C2 = HO.Cat[Nl, Ec, Qc, EQ.LQ p, GE, HO.compN Nl Ec Tc Qc mB psi, PO2.PQ.RD.cQ, C1.res, R3.res] ;
  module CC0 = PO2.CC[R.z, Ec] ;
  module I4 = HO.Inv[Nl, Ec, Qc, CC0.cAX, HO.compN Nl Ec Tc Qc CC0.cTX psi, PO2.PQ.RD.cQ, CC0.res] ;
  pa4 (I : Ob) : (o : Top) (w : V1.Ix (Ec.tob I o)) -> Id (V1.Ix (Qc.tob I o)) ((HO.compN Nl Ec Tc Qc mB psi).nfun I o w) ((HO.compN Nl Ec Tc Qc CC0.cTX psi).nfun I o w) = split {
   tt -> \ w -> apH {V1.Ix (Tc.tob I tt)} {V1.Ix (Qc.tob I tt)} (psi.nfun I tt) (rB I w) } ;
  module R4 = HO.Ret[Nl, Ec, Qc, HO.compN Nl Ec Tc Qc CC0.cTX psi, CC0.cAX, HO.compN Nl Ec Tc Qc mB psi, CC0.cAX,
    pa4, \ I o w -> refl (CC0.cAX.nfun I o w), I4.res] ;
  module C3 = HO.Cat[Nl, Ec, Qc, EQ.LQ p, HO.compN Nl Ec Tc Qc mB psi, CC0.cAX, PO2.PQ.RD.cQ, C2.res, R4.res] ;
  -- Q's evaluation of p at the Q-tuple ~ 0
  res : L.PEl[L.extP Nl Ec, HO.HT[Nl, Ec, Qc, EQ.LQ p, CC0.cAX].PT.PathP] = C3.res ;
  } ;
} ;
