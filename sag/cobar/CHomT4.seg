-- CHomT4.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes (CMorX), part 1: at a stage I
-- (fibres at the nil point tt), an element z of HomT gives the families of
-- a map code: the function part is z's Fun fibre on the nose; each datum
-- is z's Pi family moved along comp-idr (h restricted to K and read at
-- the identity is h at f . id).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module P3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module HP = CHomT3[a].HomP[R, encK, pe] ;
 module H = HP.Hom[s, t] ;
 addO (x : SX.Over[R].Presentation) : C.El C.nil (OV.Fun C.nil HP.Alg[x].Qt (OV.Fun C.nil HP.Alg[x].Qt HP.Alg[x].Qt)) = HP.Alg[x].O.addQ ;
 mulO (x : SX.Over[R].Presentation) : C.El C.nil (OV.Fun C.nil HP.Alg[x].Qt (OV.Fun C.nil HP.Alg[x].Qt HP.Alg[x].Qt)) = HP.Alg[x].O.mulQ ;
 module MO = CMorX[a].MorOf[R, encK, pe, addO, mulO] ;
 module F = MO.Fn[s, t] ;
 Z (I : Ob) : U a+ = V1.Ix (H.HomT.1.tob I tt) ;
 ph (I : Ob) (z : Z I) : F.Fam I = z.1.1 ;
 da (I : Ob) (z : Z I) : F.BA.DT I (ph I z) = \ K f w p ->
  subst (Hom K I) (\ k -> V1.Ix (F.BA.FT K (F.mp3 I (ph I z) K k w))) (compH K K I f (idH K)) f (comp-idr K I f)
   (z.2.1.1 K f (w.1, (w.2.1, (w.2.2, p)))) ;
 dm (I : Ob) (z : Z I) : F.BM.DT I (ph I z) = \ K f w p ->
  subst (Hom K I) (\ k -> V1.Ix (F.BM.FT K (F.mp3 I (ph I z) K k w))) (compH K K I f (idH K)) f (comp-idr K I f)
   (z.2.2.1.1 K f (w.1, (w.2.1, (w.2.2, p)))) ;
 -- the constants: through CHomData.PropCst's type equation IdP on both sides
 module CR (r : R.R) {
  module PS = CHomData[a].PropCst[HP.Alg[s].Qt, HP.Alg[s].AX.cls (cst r), HP.Alg[s].Q1.setQi] ;
  module PT = CHomData[a].PropCst[HP.Alg[t].Qt, HP.Alg[t].AX.cls (cst r), HP.Alg[t].Q1.setQi] ;
  tyS (K : Ob) (u : F.S.QK K) (T : C.Ty PS.Q3.G1) : U a++ = V1.Ix (T.1.tob K (tt, u)) ;
  tyT (K : Ob) (u : F.T.QK K) (T : C.Ty PT.Q3.G1) : U a++ = V1.Ix (T.1.tob K (tt, u)) ;
  dc (I : Ob) (z : Z I) : F.NC[r].N.DT I (ph I z) = \ K f u p ->
   subst (C.Ty PT.Q3.G1) (tyT K (ph I z K f u)) (C.subT PT.Q3.G1 PT.Q3.G2 (IJ.IdT PT.Q3.G2 PT.Q3.Qw2 PT.Q3.v1 PT.Q3.v2) PT.rho) PT.CT.IdCst PT.IdP
    (subst (Hom K I) (\ k -> tyT K (ph I z K k u) (C.subT PT.Q3.G1 PT.Q3.G2 (IJ.IdT PT.Q3.G2 PT.Q3.Qw2 PT.Q3.v1 PT.Q3.v2) PT.rho))
       (compH K K I f (idH K)) f (comp-idr K I f)
       (z.2.2.2.1 K f (r, (u, subst (C.Ty PS.Q3.G1) (tyS K u) PS.CT.IdCst (C.subT PS.Q3.G1 PS.Q3.G2 (IJ.IdT PS.Q3.G2 PS.Q3.Qw2 PS.Q3.v1 PS.Q3.v2) PS.rho) (symH PS.IdP) p)))) ;
 } ;
 fp (I : Ob) (z : Z I) : F.FP I = (ph I z, (da I z, (dm I z, \ r -> CR[r].dc I z))) ;
} ;
