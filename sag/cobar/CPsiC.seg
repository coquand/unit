-- CPsiC.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', over the empty
-- context, tau : codes F1 -> y' -> G (CE1Copy's tauc) has a quasi-inverse:
-- CL14C's eps and its two homotopies pulled back along the point (CHtSub),
-- moved between Cor 15's form of G and G's fibres (CGBr's cvg / cvgInv).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module PC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module LC = CL14C[a].L14C[R, encK, pe] ;
 module CP = LC.Cp[y'] ;
 module GB = CGBr[a].GBr[R, encK, pe] ;
 module RH = CRestrHT[a].RHT[R, encK, pe, y'] ;
 module HO = PB.CHtpyOps[a+] ;
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 Gy : L.PCtx = CP.RH.Gy ;
 sP : L.PSub[Nl, Gy] = new L.PSub[Nl, Gy, \ I o -> tt, \ J I h o -> isTop tt (Gy.act J I h tt)] ;
 -- maps over Gy pulled back to Nl
 subN (A B : L.PTy[Gy]) (u : HO.NMap[Gy, A, B]) : HO.NMap[Nl, L.subTy Nl Gy A sP, L.subTy Nl Gy B sP] =
  new HO.NMap[Nl, L.subTy Nl Gy A sP, L.subTy Nl Gy B sP, \ I d a0 -> u.nfun I (sP.nt I d) a0,
   \ J I h d d' e a0 -> u.nnat J I h (sP.nt I d) (sP.nt J d') (L.ntEq Nl Gy sP J I h d d' e) a0] ;
 Ap : L.PTy[Nl] = L.subTy Nl Gy CP.RH.Ay sP ;
 Bp : L.PTy[Nl] = L.subTy Nl Gy CP.RH.By sP ;
 epsP : HO.NMap[Nl, Bp, Ap] = subN CP.RH.By CP.RH.Ay CP.epsC ;
 tauP : HO.NMap[Nl, Ap, Bp] = subN CP.RH.Ay CP.RH.By CP.tauC ;
 -- G's fibres at the copy and Cor 15's form
 Tc : L.PTy[Nl] = RH.ClT[GB.O1.DY.DCtx].ty ;
 qm (J I : Ob) (h : Hom J I) : GB.CT.TC.THm (J, y') (I, y') = (h, GB.YF.CM.IC.cart J I h y') ;
 -- the square at the copy, from CGBr's comparison at the total site
 cvSq (J I : Ob) (h : Hom J I) (w : V1.Ix (Tc.tob I tt))
  : Id (V1.Ix (Bp.tob J tt)) (Bp.tact J I h tt tt (refl tt) (GB.cvg I y' tt w)) (GB.cvg J y' tt (Tc.tact J I h tt tt (refl tt) w)) =
  GB.TBt.pr-inj (J, y') tt (Bp.tact J I h tt tt (refl tt) (GB.cvg I y' tt w)) (GB.cvg J y' tt (Tc.tact J I h tt tt (refl tt) w))
   (transH (symH (GB.TBt.pr-tact (J, y') (I, y') (qm J I h) tt tt (refl tt) (GB.cvg I y' tt w)))
     (GB.tanat (J, y') (I, y') (qm J I h) (tt, w))) ;
 cvNat (J I : Ob) (h : Hom J I) : (x x' : Top) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h x) x') (w : V1.Ix (Tc.tob I x))
  -> Id (V1.Ix (Bp.tob J x')) (Bp.tact J I h x x' e (GB.cvg I y' tt w)) (GB.cvg J y' tt (Tc.tact J I h x x' e w)) = split {
  tt -> split { tt -> \ e w ->
   transH (L.tact-irr Nl Bp J I h tt tt e (refl tt) (GB.cvg I y' tt w))
    (transH (cvSq J I h w) (apH {V1.Ix (Tc.tob J tt)} {V1.Ix (Bp.tob J tt)} (GB.cvg J y' tt) (L.tact-irr Nl Tc J I h tt tt (refl tt) e w))) } } ;
 cvN : HO.NMap[Nl, Tc, Bp] = new HO.NMap[Nl, Tc, Bp, \ I o w -> GB.cvg I y' tt w, \ J I h x x' e w -> cvNat J I h x x' e w] ;
 -- the inverse conversion
 cvIsq (J I : Ob) (h : Hom J I) : (x x' : Top) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h x) x') (b : V1.Ix (Bp.tob I x))
  -> Id (V1.Ix (Tc.tob J x')) (Tc.tact J I h x x' e (GB.cvgInv I y' tt b)) (GB.cvgInv J y' tt (Bp.tact J I h x x' e b)) = split {
  tt -> split { tt -> \ e b ->
   transH (symH (GB.rt1g J y' tt (Tc.tact J I h tt tt e (GB.cvgInv I y' tt b))))
    (apH {V1.Ix (Bp.tob J tt)} {V1.Ix (Tc.tob J tt)} (GB.cvgInv J y' tt)
      (transH (symH (cvNat J I h tt tt e (GB.cvgInv I y' tt b)))
        (apH {V1.Ix (Bp.tob I tt)} {V1.Ix (Bp.tob J tt)} (Bp.tact J I h tt tt e) (GB.rt2g I y' tt b)))) } } ;
 cvI : HO.NMap[Nl, Bp, Tc] = new HO.NMap[Nl, Bp, Tc, \ I o b -> GB.cvgInv I y' tt b, \ J I h x x' e b -> cvIsq J I h x x' e b] ;
 cvgTau (I : Ob) (a0 : V1.Ix (GB.Y1.ob I y')) : Id (GB.DA.TOb' I y' (GB.O1.D1.tau I y' tt)) (GB.cvg I y' tt (GB.O1.DY.tau I y' a0)) (GB.LB.TA.tauA I y' tt a0) =
  GB.DA.tob-eq I y' (GB.O1.D1.tau I y' tt) (GB.cvg I y' tt (GB.O1.DY.tau I y' a0)) (GB.LB.TA.tauA I y' tt a0) (\ q l ->
   GB.famSub I y' (GB.O1.d1 I y') (GB.O1.D1.tau I y' tt) (GB.dEqg I y' tt) (GB.O1.Bk[I, y', GB.O1.DY.tau I y' a0].res) q l) ;
 -- the codes side: Ap and CE1Copy's Ac have the same fibres and actions
 Ac : L.PTy[Nl] = RH.ClT[RH.CM.Yo[RH.CM.F1].yoT].ty ;
 idAP : HO.NMap[Nl, Ac, Ap] = new HO.NMap[Nl, Ac, Ap, \ I o c -> c, \ J I h x x' e c -> refl (Ap.tact J I h x x' e c)] ;
 idPA : HO.NMap[Nl, Ap, Ac] = new HO.NMap[Nl, Ap, Ac, \ I o c -> c, \ J I h x x' e c -> refl (Ac.tact J I h x x' e c)] ;
 -- tau and its quasi-inverse on G's fibres
 tauT : HO.NMap[Nl, Ac, Tc] = new HO.NMap[Nl, Ac, Tc, \ I o a0 -> GB.O1.DY.tau I y' a0, \ J I h x x' e a0 -> symH (GB.O1.DY.tau-nat J I h y' y' (GB.YF.CM.IC.cart J I h y') a0)] ;
 epsT : HO.NMap[Nl, Tc, Ac] = HO.compN Nl Tc Ap Ac (HO.compN Nl Tc Bp Ap cvN epsP) idPA ;
 -- eps . tau ~ id on codes
 module HE1 = CHtSub[a].HS[Nl, Gy, sP, CP.RHA.Ay, CP.RHA.By, CP.ET.T.al, CP.ET.T.be, CP.etC] ;
 module W1 = HO.WR[Nl, Ap, Ap, Ac, HE1.sub CP.ET.T.al, HE1.sub CP.ET.T.be, idAP, HE1.res] ;
 module W1' = HO.WL[Nl, Ac, Ap, Ac, HO.compN Nl Ac Ap Ap idAP (HE1.sub CP.ET.T.al), HO.compN Nl Ac Ap Ap idAP (HE1.sub CP.ET.T.be), idPA, W1.res] ;
 module R1 = HO.Ret[Nl, Ac, Ac, HO.compN Nl Ac Ap Ac (HO.compN Nl Ac Ap Ap idAP (HE1.sub CP.ET.T.al)) idPA, HO.compN Nl Ac Ap Ac (HO.compN Nl Ac Ap Ap idAP (HE1.sub CP.ET.T.be)) idPA,
   HO.compN Nl Ac Tc Ac tauT epsT, HO.idN Nl Ac,
   \ I o c -> apH {GB.DA.TOb' I y' (GB.O1.D1.tau I y' tt)} {V1.Ix (Ac.tob I o)} (CP.epsC.nfun I tt) (cvgTau I c), \ I o c -> refl c, W1'.res] ;
 et : L.PEl[L.extP Nl Ac, HO.HT[Nl, Ac, Ac, HO.compN Nl Ac Tc Ac tauT epsT, HO.idN Nl Ac].PT.PathP] = R1.res ;
 -- tau . eps ~ id on G's fibres
 module HE2 = CHtSub[a].HS[Nl, Gy, sP, CP.RHB.Ay, CP.RHB.By, CP.TE.T.al, CP.TE.T.be, CP.teC] ;
 module W2 = HO.WR[Nl, Bp, Bp, Tc, HE2.sub CP.TE.T.al, HE2.sub CP.TE.T.be, cvN, HE2.res] ;
 module W2' = HO.WL[Nl, Tc, Bp, Tc, HO.compN Nl Tc Bp Bp cvN (HE2.sub CP.TE.T.al), HO.compN Nl Tc Bp Bp cvN (HE2.sub CP.TE.T.be), cvI, W2.res] ;
 pa2 (I : Ob) (o : V1.Ix (Nl.ob I)) (w : V1.Ix (Tc.tob I o))
  : Id (V1.Ix (Tc.tob I o)) ((HO.compN Nl Tc Ac Tc epsT tauT).nfun I o w) (GB.cvgInv I y' tt (GB.LB.TA.tauA I y' tt (CP.epsC.nfun I tt (GB.cvg I y' tt w)))) =
  transH (symH (GB.rt1g I y' tt (GB.O1.DY.tau I y' (CP.epsC.nfun I tt (GB.cvg I y' tt w)))))
   (apH {GB.DA.TOb' I y' (GB.O1.D1.tau I y' tt)} {V1.Ix (Tc.tob I o)} (GB.cvgInv I y' tt) (cvgTau I (CP.epsC.nfun I tt (GB.cvg I y' tt w)))) ;
 module R2 = HO.Ret[Nl, Tc, Tc, HO.compN Nl Tc Bp Tc (HO.compN Nl Tc Bp Bp cvN (HE2.sub CP.TE.T.al)) cvI, HO.compN Nl Tc Bp Tc (HO.compN Nl Tc Bp Bp cvN (HE2.sub CP.TE.T.be)) cvI,
   HO.compN Nl Tc Ac Tc epsT tauT, HO.idN Nl Tc, pa2, \ I o w -> symH (GB.rt1g I y' tt w), W2'.res] ;
 te : L.PEl[L.extP Nl Tc, HO.HT[Nl, Tc, Tc, HO.compN Nl Tc Ac Tc epsT tauT, HO.idN Nl Tc].PT.PathP] = R2.res ;
} ;
