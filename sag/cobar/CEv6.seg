-- CEv6.seg (canonicity-c2; HomT(F1, y) ~ Q_y, part 6): the evaluation at
-- the generator has contractible fibres (CInjSurj's argument on CInjP's fibre),
-- its inverse, and the round trip ev (inv q) = q.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module E6 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module E5m = CEv5[a].E5[R, encK, pe, y] ;
 module E2m = E5m.E4m.E2m ;
 module I = E5m.I ;
 TA : CwFTrunc.Trunc[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv].TruncAt = CQSurj[a].TA ;
 GB : C.Ctx = I.GB ;
 Fib : C.Ty GB = I.Fib ;
 T : C.Ty GB = TA.Tr GB Fib ;
 GT : C.Ctx = C.ext GB T ;
 GF : C.Ctx = C.ext GB Fib ;
 pF : C.El GB (PU.isProp GB Fib) = E2m.pF ;
 ms : C.El GB T = E5m.ms ;
 pB : C.El GT (PU.isProp GT (OV.wkT GB T Fib)) =
  OV.trE GT (C.subT GT GB (PU.isProp GB Fib) (C.p GB T)) (PU.isProp GT (OV.wkT GB T Fib))
   (PU.isProp-ov GT GB Fib (C.p GB T) (OV.wkT GB T Fib) (refl (OV.wkT GB T Fib))) (C.subt GT GB (PU.isProp GB Fib) pF (C.p GB T)) ;
 pEq : Id (C.Sub GF GB) (C.o GF GT GB (C.p GB T) (TA.incS GB Fib)) (C.p GB Fib) =
  L.sub-ext GF GB (C.o GF GT GB (C.p GB T) (TA.incS GB Fib)) (C.p GB Fib) (\ K z -> refl z.1) ;
 Pth : Id (C.Ty GF) (OV.wkT GB Fib Fib) (C.subT GF GT (OV.wkT GB T Fib) (TA.incS GB Fib)) =
  transH (apH {C.Sub GF GB} {C.Ty GF} (\ z -> C.subT GF GB Fib z) (symH pEq)) (C.subT-o GF GT GB Fib (C.p GB T) (TA.incS GB Fib)) ;
 bq : C.El GF (C.subT GF GT (OV.wkT GB T Fib) (TA.incS GB Fib)) = OV.trE GF (OV.wkT GB Fib Fib) (C.subT GF GT (OV.wkT GB T Fib) (TA.incS GB Fib)) Pth (C.q GB Fib) ;
 el : C.El GT (OV.wkT GB T Fib) = TA.elim GB Fib (OV.wkT GB T Fib) pB bq ;
 centre : C.El GB Fib = OV.trE GB (C.subT GB GT (OV.wkT GB T Fib) (C.sec GB T ms)) Fib (CAppRd[a].W.psT GB T Fib ms) (C.subt GB GT (OV.wkT GB T Fib) el (C.sec GB T ms)) ;
 contr : C.El GB (EQ.isContr GB Fib) = PPp.contrOfProp GB Fib pF centre ;
 -- the inverse, and ev (inv q) = q
 invB : C.El GB I.Xb = INm.fst GB I.Xb I.Fm centre ;
 inv : C.El C.nil (OV.Fun C.nil I.B I.A) = OV.lam C.nil I.B I.Xb invB ;
 sec1 : C.El GB (C.subT GB I.GX I.Fm (C.sec GB I.Xb invB)) = INm.snd GB I.Xb I.Fm centre ;
} ;
