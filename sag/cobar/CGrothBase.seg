-- CGrothBase.seg (canonicity-c2; SIMPLIFIED.md item 4): the base (CBase.CB)
-- at the total category of an internal category C over the poset site.
--   objects, maps    CTotCat's (I, x), (u, f)
--   interval         the presheaf (I, x) |-> IvP I of the base (not
--                    representable: C need not have terminal objects)
--   sieves           a sieve of (I, x) is a sieve of I; a total map lands
--                    in it when its base part does.  Extensionality uses
--                    the cartesian lifts: every base map into I is the
--                    base part of a total map into (I, x).
--   forall           a line of sieves over (I, x) is read as a line over I
--                    at the cartesian lifts (baseL); it agrees with the
--                    given line at every total map (canon).
--   connections      the base connection
-- No new axioms.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module GrothOf (C : CIntCat[a].IC) {
 module PB = PosFull[a].PB ;
 module TC = CTotCat[a, l].TotOf[C] ;
 module VT = CVert[a].VertOf[C] ;
 TOb : U a = TC.TOb ;
 THm (Y X : TOb) : U a = TC.THm Y X ;
 tcomp (Z Y X : TOb) (f : THm Y X) (g : THm Z Y) : THm Z X = TC.tcomp Z Y X f g ;

 -- the interval presheaf
 IvT (X : TOb) : U a = PB.IvP X.1 ;
 ivA (Y X : TOb) (g : THm Y X) (i : IvT X) : IvT Y = PB.ivA Y.1 X.1 g.1 i ;

 -- the canonical object over a base map into X, and its cartesian lift
 cob (W : Ob) (X : TOb) (u : Hom W X.1) : TOb = (W, C.res W X.1 u X.2) ;
 cart (W : Ob) (X : TOb) (u : Hom W X.1) : THm (cob W X u) X = TC.cartT W X u ;

 -- sieves
 Phi (X : TOb) : U a = PB.Phi X.1 ;
 pre (Y X : TOb) (f : THm Y X) (Q : Phi X) : Phi Y = PB.pre Y.1 X.1 f.1 Q ;
 Lands (W X : TOb) (Q : Phi X) (f : THm W X) : U a = PB.Lands W.1 X.1 Q f.1 ;
 phi-ext (X : TOb) (Q Q' : Phi X) (p : (W : TOb) (f : THm W X) -> Lands W X Q f -> Lands W X Q' f)
  (q : (W : TOb) (f : THm W X) -> Lands W X Q' f -> Lands W X Q f) : Id (Phi X) Q Q' =
  PB.phi-ext X.1 Q Q' (\ W u i -> p (cob W X u) (cart W X u) i) (\ W u i -> q (cob W X u) (cart W X u) i) ;

 -- the assumption of the truncation files, at the total site: landing in
 -- a restricted sieve is landing of the composite, by computation
 lands-pre-refl (W Y X : TOb) (h : THm Y X) (Q : Phi X) (g : THm W Y)
  : Id (U a) (Lands W Y (pre Y X h Q) g) (Lands W X Q (tcomp W Y X h g)) =
  refl (Lands W Y (pre Y X h Q) g) ;

 ----------------------------------------------------------------------
 -- lines of sieves
 PhiL (X : TOb) : U a =
  (L : (W : TOb) -> THm W X -> IvT W -> Phi W)
  * ((Vt W : TOb) (g : THm Vt W) (f : THm W X) (j : IvT W)
     -> Id (Phi Vt) (pre Vt W g (L W f j)) (L Vt (tcomp Vt W X f g) (ivA Vt W g j))) ;

 -- a line read at a total map is the line at the cartesian lift
 module Canon (X : TOb) (L : PhiL X) (Vt : TOb) (h : THm Vt X) (j : IvT Vt) {
  Vc : TOb = cob Vt.1 X h.1 ;
  e : Id (Hom Vt.1 X.1) h.1 (compH Vt.1 Vt.1 X.1 h.1 (idH Vt.1)) = symH (comp-idr Vt.1 X.1 h.1) ;
  k : THm Vt Vc = TC.factT Vt.1 Vt X h.1 (idH Vt.1) h e ;
  canon : Id (Phi Vt) (L.1 Vt h j) (L.1 Vc (cart Vt.1 X h.1) j) =
   symH (transH (symH (PB.pre-id Vt.1 (L.1 Vc (cart Vt.1 X h.1) j)))
     (transH (L.2 Vt Vc k (cart Vt.1 X h.1) j)
       (transH (apH {THm Vt X} {Phi Vt} (\ z -> L.1 Vt z (ivA Vt Vc k j)) (TC.factT-eq Vt.1 Vt X h.1 (idH Vt.1) h e))
               (apH {IvT Vt} {Phi Vt} (\ z -> L.1 Vt h z) (PB.ivA-id Vt.1 j))))) ;
 } ;

 -- the line over the base
 module BaseL (X : TOb) (L : PhiL X) {
  fam (W : Ob) (u : Hom W X.1) (j : PB.IvP W) : PB.Phi W = L.1 (cob W X u) (cart W X u) j ;
  module Nat (Vt W : Ob) (g : Hom Vt W) (u : Hom W X.1) (j : PB.IvP W) {
   Wc : TOb = cob W X u ;
   Vc : TOb = cob Vt X (compH Vt W X.1 u g) ;
   k : THm Vc Wc = TC.factT W Vc X u g (cart Vt X (compH Vt W X.1 u g)) (refl (compH Vt W X.1 u g)) ;
   nat : Id (PB.Phi Vt) (PB.pre Vt W g (fam W u j)) (fam Vt (compH Vt W X.1 u g) (PB.ivA Vt W g j)) =
    transH (L.2 Vc Wc k (cart W X u) j)
     (apH {THm Vc X} {Phi Vc} (\ z -> L.1 Vc z (ivA Vc Wc k j))
        (TC.factT-eq W Vc X u g (cart Vt X (compH Vt W X.1 u g)) (refl (compH Vt W X.1 u g)))) ;
  } ;
  baseL : PB.PhiL X.1 = (fam, \ Vt W g u j -> Nat[Vt, W, g, u, j].nat) ;
 } ;

 HoldsL (X : TOb) (L : PhiL X) (W : TOb) (f : THm W X) : U a =
  (Vt : TOb) (g : THm Vt W) (j : IvT Vt) -> Lands Vt Vt (L.1 Vt (tcomp Vt W X f g) j) (TC.tid Vt) ;

 forallS (X : TOb) (L : PhiL X) : Phi X = PB.forallS X.1 BaseL[X, L].baseL ;
 lands-forall (W X : TOb) (L : PhiL X) (f : THm W X) (i : Lands W X (forallS X L) f) : HoldsL X L W f =
  \ Vt g j -> PB.lands-sub Vt.1 Vt.1
     (L.1 (cob Vt.1 X (compH Vt.1 W.1 X.1 f.1 g.1)) (cart Vt.1 X (compH Vt.1 W.1 X.1 f.1 g.1)) j)
     (L.1 Vt (tcomp Vt W X f g) j)
     (symH Canon[X, L, Vt, tcomp Vt W X f g, j].canon) (idH Vt.1)
     (PB.lands-forall W.1 X.1 BaseL[X, L].baseL f.1 i Vt.1 g.1 j) ;
 forall-lands (W X : TOb) (L : PhiL X) (f : THm W X) (h : HoldsL X L W f) : Lands W X (forallS X L) f =
  PB.forall-lands W.1 X.1 BaseL[X, L].baseL f.1
   (\ V0 g0 j0 -> PB.lands-sub V0 V0
      (L.1 (cob V0 W g0) (tcomp (cob V0 W g0) W X f (cart V0 W g0)) j0)
      (L.1 (cob V0 X (compH V0 W.1 X.1 f.1 g0)) (cart V0 X (compH V0 W.1 X.1 f.1 g0)) j0)
      Canon[X, L, cob V0 W g0, tcomp (cob V0 W g0) W X f (cart V0 W g0), j0].canon (idH V0)
      (h (cob V0 W g0) (cart V0 W g0) j0)) ;

 -- the base at the total site
 module GB = CBase[a].CB[TC.tobV, \ Y X -> TC.thomV Y X, \ X -> TC.tid X, \ Z Y X f g -> tcomp Z Y X f g,
   TC.TotCat.oC-idl, TC.TotCat.oC-idr, TC.TotCat.oC-assoc,
   \ X -> PB.ivV X.1, ivA, \ X i -> PB.ivA-id X.1 i, \ L K J g h i -> PB.ivA-comp L.1 K.1 J.1 g.1 h.1 i,
   PB.IPt, PB.e0, PB.e1, \ X e -> PB.ptH X.1 e, \ Y X f e -> PB.ptH-nat Y.1 X.1 f.1 e,
   Phi, pre, Lands,
   \ W X Q f -> PB.isProp-Lands W.1 X.1 Q f.1,
   \ W' W X Q f chi i -> PB.lands-comp W'.1 W.1 X.1 Q f.1 chi.1 i,
   \ W Y X h Q g i -> PB.lands-pre W.1 Y.1 X.1 h.1 Q g.1 i,
   \ W Y X h Q g i -> PB.pre-lands W.1 Y.1 X.1 h.1 Q g.1 i,
   phi-ext,
   \ X -> PB.emptyS X.1, \ W X f i -> PB.empty-lands W.1 X.1 f.1 i,
   \ X -> PB.topS X.1, \ W X f -> PB.top-lands W.1 X.1 f.1,
   \ W i e -> PB.endS W.1 i e, \ Y X g i e -> PB.end-pre Y.1 X.1 g.1 i e,
   \ W e g i -> PB.lands-pt W.1 e g i, \ W e -> PB.pt-lands W.1 e, \ W g i i' -> PB.pt-disj W.1 g i i',
   \ X Q -> PB.allS X.1 Q, \ X Q h -> PB.allS-sound X.1 Q h, \ X Q i -> PB.allS-complete X.1 Q i,
   \ X r Q -> PB.bigU X.1 r Q, \ W X r Q f k i -> PB.bigU-in W.1 X.1 r Q f.1 k i, \ W X r Q f i -> PB.bigU-out W.1 X.1 r Q f.1 i,
   forallS, lands-forall, forall-lands,
   \ d W i j -> PB.cI d W.1 i j,
   \ d Vt W g i j -> PB.cI-nat d Vt.1 W.1 g.1 i j,
   \ W i -> PB.cI-jsrc-t W.1 i, \ W i -> PB.cI-jsrc-f W.1 i, \ W i -> PB.cI-jtgt-t W.1 i, \ W i -> PB.cI-jtgt-f W.1 i,
   \ W j -> PB.cI-isrc-t W.1 j, \ W j -> PB.cI-isrc-f W.1 j, \ W j -> PB.cI-itgt-t W.1 j, \ W j -> PB.cI-itgt-f W.1 j] ;

 -- the generic layers exist at the total site (a test of the instance)
 pre-id-T (X : TOb) (Q : Phi X) : Id (Phi X) (pre X X (TC.tid X) Q) Q = GB.pre-id X Q ;
 lines-T (G : Presheaf[a, l].Psh[GB.BC].PCtx) (X : TOb) : V[l].V = GB.CLine[l].FC[G].ftV X ;
 fibs-T (G : Presheaf[a, l].Psh[GB.BC].PCtx) (A : Presheaf[a, l].Psh[GB.BC].PTy[G]) : U (l+) = GB.CLine[l].Lines[G, A].Fib ;

 ----------------------------------------------------------------------
 -- dependent conjunction (the hypothesis of Swan's Id, CId.DConj), from
 -- the poset's: a family of sieves over the maps landing in Q is read at
 -- the cartesian lifts
 module DCj (X : TOb) (Q : Phi X) (F : (W : TOb) (f : THm W X) -> Lands W X Q f -> Phi W)
   (Fn : (Vt W : TOb) (g : THm Vt W) (f : THm W X) (i : Lands W X Q f) (i' : Lands Vt X Q (tcomp Vt W X f g))
         -> Id (Phi Vt) (pre Vt W g (F W f i)) (F Vt (tcomp Vt W X f g) i')) {
  Fcong (W : TOb) (h h' : THm W X) (e : Id (THm W X) h h') (i : Lands W X Q h) (i' : Lands W X Q h') : Id (Phi W) (F W h i) (F W h' i') =
   idJ (THm W X) h (\ h2 e2 -> (i2 : Lands W X Q h2) -> Id (Phi W) (F W h i) (F W h2 i2))
    (\ i2 -> apH {Lands W X Q h} {Phi W} (\ z -> F W h z) (PB.isProp-Lands W.1 X.1 Q h.1 i i2)) h' e i' ;
  F0 (W : Ob) (u : Hom W X.1) (i : PB.Lands W X.1 Q u) : PB.Phi W = F (cob W X u) (cart W X u) i ;
  Fn0 (Vt W : Ob) (g : Hom Vt W) (u : Hom W X.1) (i : PB.Lands W X.1 Q u) (i' : PB.Lands Vt X.1 Q (compH Vt W X.1 u g))
   : Id (PB.Phi Vt) (PB.pre Vt W g (F0 W u i)) (F0 Vt (compH Vt W X.1 u g) i') =
   transH (Fn (cob Vt X (compH Vt W X.1 u g)) (cob W X u)
             (TC.factT W (cob Vt X (compH Vt W X.1 u g)) X u g (cart Vt X (compH Vt W X.1 u g)) (refl (compH Vt W X.1 u g)))
             (cart W X u) i i')
    (Fcong (cob Vt X (compH Vt W X.1 u g))
       (tcomp (cob Vt X (compH Vt W X.1 u g)) (cob W X u) X (cart W X u)
          (TC.factT W (cob Vt X (compH Vt W X.1 u g)) X u g (cart Vt X (compH Vt W X.1 u g)) (refl (compH Vt W X.1 u g))))
       (cart Vt X (compH Vt W X.1 u g))
       (TC.factT-eq W (cob Vt X (compH Vt W X.1 u g)) X u g (cart Vt X (compH Vt W X.1 u g)) (refl (compH Vt W X.1 u g)))
       i' i') ;
  -- the family at a total map is the family at the cartesian lift
  module Cn (W : TOb) (f : THm W X) (i : Lands W X Q f) {
   Wc : TOb = cob W.1 X f.1 ;
   e : Id (Hom W.1 X.1) f.1 (compH W.1 W.1 X.1 f.1 (idH W.1)) = symH (comp-idr W.1 X.1 f.1) ;
   k : THm W Wc = TC.factT W.1 W X f.1 (idH W.1) f e ;
   i1 : Lands W X Q (tcomp W Wc X (cart W.1 X f.1) k) = PB.lands-eq W.1 X.1 Q f.1 (compH W.1 W.1 X.1 f.1 (idH W.1)) e i ;
   canon : Id (Phi W) (F W f i) (F0 W.1 f.1 i) =
    symH (transH (symH (PB.pre-id W.1 (F0 W.1 f.1 i)))
      (transH (Fn W Wc k (cart W.1 X f.1) i i1)
         (Fcong W (tcomp W Wc X (cart W.1 X f.1) k) f (TC.factT-eq W.1 W X f.1 (idH W.1) f e) i1 i))) ;
  } ;
  dcP : PosId[a, l].PB.CId[l].DConj = PosId[a, l].dc ;
  dconj : Phi X = dcP.dconj X.1 Q F0 Fn0 ;
  dc-in (W : TOb) (f : THm W X) (i : Lands W X Q f) (j : Lands W W (F W f i) (TC.tid W)) : Lands W X dconj f =
   dcP.dc-in W.1 X.1 Q F0 Fn0 f.1 i (PB.lands-sub W.1 W.1 (F W f i) (F0 W.1 f.1 i) Cn[W, f, i].canon (idH W.1) j) ;
  dc-out (W : TOb) (f : THm W X) (i : Lands W X dconj f) : (i' : Lands W X Q f) * Lands W W (F W f i') (TC.tid W) =
   ((dcP.dc-out W.1 X.1 Q F0 Fn0 f.1 i).1,
    PB.lands-sub W.1 W.1 (F0 W.1 f.1 (dcP.dc-out W.1 X.1 Q F0 Fn0 f.1 i).1) (F W f (dcP.dc-out W.1 X.1 Q F0 Fn0 f.1 i).1)
      (symH Cn[W, f, (dcP.dc-out W.1 X.1 Q F0 Fn0 f.1 i).1].canon) (idH W.1) (dcP.dc-out W.1 X.1 Q F0 Fn0 f.1 i).2) ;
 } ;
 dcT : GB.CId[l].DConj =
  new GB.CId[l].DConj[\ X Q F Fn -> DCj[X, Q, F, Fn].dconj, \ W X Q F Fn f i j -> DCj[X, Q, F, Fn].dc-in W f i j,
   \ W X Q F Fn f i -> DCj[X, Q, F, Fn].dc-out W f i] ;

 -- Swan's Id at the total site is fibrant (core CIdFib, generic)
 idFib-T (G : Presheaf[a, l].Psh[GB.BC].PCtx) (A : Presheaf[a, l].Psh[GB.BC].PTy[G]) (a0 b0 : Presheaf[a, l].Psh[GB.BC].PEl[G, A])
  (fA : GB.CLine[l].Lines[G, A].Fib) : GB.CLine[l].Lines[G, GB.CIdFib[l].IdFib[G, A, a0, b0].IdT].Fib =
  GB.CIdFib[l].IdFib[G, A, a0, b0].fib fA dcT ;

 ----------------------------------------------------------------------
 -- the fibrant CwF interface (CFibSeg) at the total site: the CwF of
 -- fibrant types with Pi, Sigma, Swan's Id with J, function
 -- extensionality, contractibility and homotopies, for presheaves over
 -- the total category
 module FT = CFibSeg[a].FB[TC.tobV, \ Y X -> TC.thomV Y X, \ X -> TC.tid X, \ Z Y X f g -> tcomp Z Y X f g,
   TC.TotCat.oC-idl, TC.TotCat.oC-idr, TC.TotCat.oC-assoc,
   \ X -> PB.ivV X.1, ivA, \ X i -> PB.ivA-id X.1 i, \ L K J g h i -> PB.ivA-comp L.1 K.1 J.1 g.1 h.1 i,
   PB.IPt, PB.e0, PB.e1, \ X e -> PB.ptH X.1 e, \ Y X f e -> PB.ptH-nat Y.1 X.1 f.1 e,
   Phi, pre, Lands,
   \ W X Q f -> PB.isProp-Lands W.1 X.1 Q f.1,
   \ W' W X Q f chi i -> PB.lands-comp W'.1 W.1 X.1 Q f.1 chi.1 i,
   \ W Y X h Q g i -> PB.lands-pre W.1 Y.1 X.1 h.1 Q g.1 i,
   \ W Y X h Q g i -> PB.pre-lands W.1 Y.1 X.1 h.1 Q g.1 i,
   phi-ext,
   \ X -> PB.emptyS X.1, \ W X f i -> PB.empty-lands W.1 X.1 f.1 i,
   \ X -> PB.topS X.1, \ W X f -> PB.top-lands W.1 X.1 f.1,
   \ W i e -> PB.endS W.1 i e, \ Y X g i e -> PB.end-pre Y.1 X.1 g.1 i e,
   \ W e g i -> PB.lands-pt W.1 e g i, \ W e -> PB.pt-lands W.1 e, \ W g i i' -> PB.pt-disj W.1 g i i',
   \ X Q -> PB.allS X.1 Q, \ X Q h -> PB.allS-sound X.1 Q h, \ X Q i -> PB.allS-complete X.1 Q i,
   \ X r Q -> PB.bigU X.1 r Q, \ W X r Q f k i -> PB.bigU-in W.1 X.1 r Q f.1 k i, \ W X r Q f i -> PB.bigU-out W.1 X.1 r Q f.1 i,
   forallS, lands-forall, forall-lands,
   \ d W i j -> PB.cI d W.1 i j,
   \ d Vt W g i j -> PB.cI-nat d Vt.1 W.1 g.1 i j,
   \ W i -> PB.cI-jsrc-t W.1 i, \ W i -> PB.cI-jsrc-f W.1 i, \ W i -> PB.cI-jtgt-t W.1 i, \ W i -> PB.cI-jtgt-f W.1 i,
   \ W j -> PB.cI-isrc-t W.1 j, \ W j -> PB.cI-isrc-f W.1 j, \ W j -> PB.cI-itgt-t W.1 j, \ W j -> PB.cI-itgt-f W.1 j,
   \ X Q F Fn -> DCj[X, Q, F, Fn].dconj, \ W X Q F Fn f i j -> DCj[X, Q, F, Fn].dc-in W f i j,
   \ W X Q F Fn f i -> DCj[X, Q, F, Fn].dc-out W f i] ;
 fibCwF-T : CwF.CwF[l+] = FT.GFibCwF[l].fibCwF ;
 fibPi-T : CwF.Formers[l+, fibCwF-T].PiStr = FT.GFibCwF[l].fibPi ;
 fibSig-T : CwF.Formers[l+, fibCwF-T].SigStr = FT.GFibCwF[l].fibSig ;
 fibId-T : CwFId.SwanId[l+, fibCwF-T].IdJStr = FT.GFibId[l].fibId ;
 nf-T (G : fibCwF-T.Ctx) (A : fibCwF-T.Ty G) (B : fibCwF-T.Ty (fibCwF-T.ext G A))
   (f g : fibCwF-T.El G (fibPi-T.Pi G A B))
   (h : fibCwF-T.El G (fibPi-T.Pi G A (fibId-T.IdT (fibCwF-T.ext G A) B ((fibPi-T.Pi-iso G A B).fun f) ((fibPi-T.Pi-iso G A B).fun g))))
  : fibCwF-T.El G (fibId-T.IdT G (fibPi-T.Pi G A B) f g) = FT.GFibNF[l].nf G A B f g h ;
 module EQT = CwFEq.Eqv[l+, fibCwF-T, fibPi-T, fibSig-T, fibId-T] ;
 -- an internally contractible fibrant type has a contraction (core's ContrOp), and conversely
 contrOp-T (G : fibCwF-T.Ctx) (T : fibCwF-T.Ty G) (kc : fibCwF-T.El G (EQT.isContr G T)) : GB.CPartial[l].ContrOp G T.1 =
  FT.GFibHt[l].contrOp G T kc ;
 contr-T (G : fibCwF-T.Ctx) (T : fibCwF-T.Ty G) (k : GB.CPartial[l].ContrOp G T.1) : fibCwF-T.El G (EQT.isContr G T) =
  FT.GFibContr[l].contr G T k ;
} ;
