-- CGrothBase.seg (canonicity-c2; SIMPLIFIED.md item 4): the base (CBase.CB)
-- at the total category of an internal category C over the poset site.
--   objects, maps    CTotCat's (I, x), (u, f)
--   interval         (Iv, term Iv); a map into it is its base part
--                    (ivExt), since term is terminal over every base map
--   sieves           a sieve of (I, x) is a sieve of I; a total map lands
--                    in it when its base part does.  Extensionality uses
--                    the cartesian lifts: every base map into I is the
--                    base part of a total map into (I, x).
--   forall           a line of sieves over (I, x) is read as a line over I
--                    at the cartesian lifts (baseL); it agrees with the
--                    given line at every total map (canon).
--   connections      the base connection, with the unique map to term
-- No new axioms.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module GrothOf (C : CIntCat[a].IC) {
 module PB = PosFull[a].PB ;
 module TC = CTotCat[a, l].TotOf[C] ;
 module VT = CVert[a].VertOf[C] ;
 TOb : U a = TC.TOb ;
 THm (Y X : TOb) : U a = TC.THm Y X ;
 tcomp (Z Y X : TOb) (f : THm Y X) (g : THm Z Y) : THm Z X = TC.tcomp Z Y X f g ;

 -- the interval
 IvT : TOb = (PB.Iv, C.term PB.Iv) ;
 toIv (W : TOb) (j : Hom W.1 PB.Iv) : THm W IvT = (j, C.bang W.1 PB.Iv j W.2) ;
 ivExt (W : TOb) (f g : THm W IvT) (e : Id (Hom W.1 PB.Iv) f.1 g.1) : Id (THm W IvT) f g =
  idJ (Hom W.1 PB.Iv) f.1
   (\ u' p -> (k : VT.HomD W.1 PB.Iv u' W.2 (C.term PB.Iv)) -> Id (THm W IvT) f (u', k))
   (\ k -> apH {VT.HomD W.1 PB.Iv f.1 W.2 (C.term PB.Iv)} {THm W IvT} (\ z -> (f.1, z))
            (transH (C.bang-uniq W.1 PB.Iv f.1 W.2 f.2) (symH (C.bang-uniq W.1 PB.Iv f.1 W.2 k))))
   g.1 e g.2 ;
 ptT (X : TOb) (e : PB.IPt) : THm X IvT = toIv X (PB.ptH X.1 e) ;

 -- the canonical object over a base map into X, and its cartesian lift
 cob (W : Ob) (X : TOb) (u : Hom W X.1) : TOb = (W, C.res W X.1 u X.2) ;
 cart (W : Ob) (X : TOb) (u : Hom W X.1) : THm (cob W X u) X = TC.cartT W X u ;

 -- sieves
 Phi (X : TOb) : U a = PB.Phi X.1 ;
 pre (Y X : TOb) (f : THm Y X) (Q : Phi X) : Phi Y = PB.pre Y.1 X.1 f.1 Q ;
 Lands (W X : TOb) (Q : Phi X) (f : THm W X) : U a = PB.Lands W.1 X.1 Q f.1 ;
 phi-ext (X : TOb) (Q Q' : Phi X) (p : (W : TOb) (f : THm W X) -> Lands W X Q f -> Lands W X Q' f)
  (q : (W : TOb) (f : THm W X) -> Lands W X Q' f -> Lands W X Q f) : Id (Phi X) Q Q' =
  PB.phi-ext X.1 Q Q' (\ W u i -> p (cob W X u) (cart W X u) i) (\ W u i -> q (cob W X u) (cart W X u) i) ;

 -- the assumption of the truncation files, at the total site: landing in
 -- a restricted sieve is landing of the composite, by computation
 lands-pre-refl (W Y X : TOb) (h : THm Y X) (Q : Phi X) (g : THm W Y)
  : Id (U a) (Lands W Y (pre Y X h Q) g) (Lands W X Q (tcomp W Y X h g)) =
  refl (Lands W Y (pre Y X h Q) g) ;

 ----------------------------------------------------------------------
 -- lines of sieves
 PhiL (X : TOb) : U a =
  (L : (W : TOb) -> THm W X -> THm W IvT -> Phi W)
  * ((Vt W : TOb) (g : THm Vt W) (f : THm W X) (j : THm W IvT)
     -> Id (Phi Vt) (pre Vt W g (L W f j)) (L Vt (tcomp Vt W X f g) (tcomp Vt W IvT j g))) ;

 -- a line read at a total map is the line at the cartesian lift
 module Canon (X : TOb) (L : PhiL X) (Vt : TOb) (h : THm Vt X) (j : THm Vt IvT) {
  Vc : TOb = cob Vt.1 X h.1 ;
  e : Id (Hom Vt.1 X.1) h.1 (compH Vt.1 Vt.1 X.1 h.1 (idH Vt.1)) = symH (comp-idr Vt.1 X.1 h.1) ;
  k : THm Vt Vc = TC.factT Vt.1 Vt X h.1 (idH Vt.1) h e ;
  jc : THm Vc IvT = toIv Vc j.1 ;
  canon : Id (Phi Vt) (L.1 Vt h j) (L.1 Vc (cart Vt.1 X h.1) jc) =
   symH (transH (symH (PB.pre-id Vt.1 (L.1 Vc (cart Vt.1 X h.1) jc)))
     (transH (L.2 Vt Vc k (cart Vt.1 X h.1) jc)
       (transH (apH {THm Vt X} {Phi Vt} (\ z -> L.1 Vt z (tcomp Vt Vc IvT jc k)) (TC.factT-eq Vt.1 Vt X h.1 (idH Vt.1) h e))
               (apH {THm Vt IvT} {Phi Vt} (\ z -> L.1 Vt h z) (ivExt Vt (tcomp Vt Vc IvT jc k) j (comp-idr Vt.1 PB.Iv j.1)))))) ;
 } ;

 -- the line over the base
 module BaseL (X : TOb) (L : PhiL X) {
  fam (W : Ob) (u : Hom W X.1) (j : Hom W PB.Iv) : PB.Phi W = L.1 (cob W X u) (cart W X u) (toIv (cob W X u) j) ;
  module Nat (Vt W : Ob) (g : Hom Vt W) (u : Hom W X.1) (j : Hom W PB.Iv) {
   Wc : TOb = cob W X u ;
   Vc : TOb = cob Vt X (compH Vt W X.1 u g) ;
   k : THm Vc Wc = TC.factT W Vc X u g (cart Vt X (compH Vt W X.1 u g)) (refl (compH Vt W X.1 u g)) ;
   nat : Id (PB.Phi Vt) (PB.pre Vt W g (fam W u j)) (fam Vt (compH Vt W X.1 u g) (compH Vt W PB.Iv j g)) =
    transH (L.2 Vc Wc k (cart W X u) (toIv Wc j))
     (transH (apH {THm Vc X} {Phi Vc} (\ z -> L.1 Vc z (tcomp Vc Wc IvT (toIv Wc j) k))
                (TC.factT-eq W Vc X u g (cart Vt X (compH Vt W X.1 u g)) (refl (compH Vt W X.1 u g))))
             (apH {THm Vc IvT} {Phi Vc} (\ z -> L.1 Vc (cart Vt X (compH Vt W X.1 u g)) z)
                (ivExt Vc (tcomp Vc Wc IvT (toIv Wc j) k) (toIv Vc (compH Vt W PB.Iv j g)) (refl (compH Vt W PB.Iv j g))))) ;
  } ;
  baseL : PB.PhiL X.1 = (fam, \ Vt W g u j -> Nat[Vt, W, g, u, j].nat) ;
 } ;

 HoldsL (X : TOb) (L : PhiL X) (W : TOb) (f : THm W X) : U a =
  (Vt : TOb) (g : THm Vt W) (j : THm Vt IvT) -> Lands Vt Vt (L.1 Vt (tcomp Vt W X f g) j) (TC.tid Vt) ;

 forallS (X : TOb) (L : PhiL X) : Phi X = PB.forallS X.1 BaseL[X, L].baseL ;
 lands-forall (W X : TOb) (L : PhiL X) (f : THm W X) (i : Lands W X (forallS X L) f) : HoldsL X L W f =
  \ Vt g j -> PB.lands-sub Vt.1 Vt.1
     (L.1 (cob Vt.1 X (compH Vt.1 W.1 X.1 f.1 g.1)) (cart Vt.1 X (compH Vt.1 W.1 X.1 f.1 g.1)) (toIv (cob Vt.1 X (compH Vt.1 W.1 X.1 f.1 g.1)) j.1))
     (L.1 Vt (tcomp Vt W X f g) j)
     (symH Canon[X, L, Vt, tcomp Vt W X f g, j].canon) (idH Vt.1)
     (PB.lands-forall W.1 X.1 BaseL[X, L].baseL f.1 i Vt.1 g.1 j.1) ;
 forall-lands (W X : TOb) (L : PhiL X) (f : THm W X) (h : HoldsL X L W f) : Lands W X (forallS X L) f =
  PB.forall-lands W.1 X.1 BaseL[X, L].baseL f.1
   (\ V0 g0 j0 -> PB.lands-sub V0 V0
      (L.1 (cob V0 W g0) (tcomp (cob V0 W g0) W X f (cart V0 W g0)) (toIv (cob V0 W g0) j0))
      (L.1 (cob V0 X (compH V0 W.1 X.1 f.1 g0)) (cart V0 X (compH V0 W.1 X.1 f.1 g0)) (toIv (cob V0 X (compH V0 W.1 X.1 f.1 g0)) j0))
      Canon[X, L, cob V0 W g0, tcomp (cob V0 W g0) W X f (cart V0 W g0), toIv (cob V0 W g0) j0].canon (idH V0)
      (h (cob V0 W g0) (cart V0 W g0) (toIv (cob V0 W g0) j0))) ;

 ----------------------------------------------------------------------
 -- connections
 cI (d : Bool) (W : TOb) (i j : THm W IvT) : THm W IvT = toIv W (PB.cI d W.1 i.1 j.1) ;

 -- the base at the total site
 module GB = CBase[a].CB[TC.tobV, \ Y X -> TC.thomV Y X, \ X -> TC.tid X, \ Z Y X f g -> tcomp Z Y X f g,
   TC.TotCat.oC-idl, TC.TotCat.oC-idr, TC.TotCat.oC-assoc,
   IvT, PB.IPt, PB.e0, PB.e1, ptT,
   \ Y X f e -> ivExt Y (tcomp Y X IvT (ptT X e) f) (ptT Y e) (PB.ptH-nat Y.1 X.1 f.1 e),
   Phi, pre, Lands,
   \ W X Q f -> PB.isProp-Lands W.1 X.1 Q f.1,
   \ W' W X Q f chi i -> PB.lands-comp W'.1 W.1 X.1 Q f.1 chi.1 i,
   \ W Y X h Q g i -> PB.lands-pre W.1 Y.1 X.1 h.1 Q g.1 i,
   \ W Y X h Q g i -> PB.pre-lands W.1 Y.1 X.1 h.1 Q g.1 i,
   phi-ext,
   \ X -> PB.emptyS X.1, \ W X f i -> PB.empty-lands W.1 X.1 f.1 i,
   \ X -> PB.topS X.1, \ W X f -> PB.top-lands W.1 X.1 f.1,
   PB.ptS, \ W e g i -> ivExt W g (ptT W e) (PB.lands-pt W.1 e g.1 i),
   \ W e -> PB.pt-lands W.1 e, \ W g i i' -> PB.pt-disj W.1 g.1 i i',
   \ X Q -> PB.allS X.1 Q, \ X Q h -> PB.allS-sound X.1 Q h, \ X Q i -> PB.allS-complete X.1 Q i,
   \ X r Q -> PB.bigU X.1 r Q, \ W X r Q f k i -> PB.bigU-in W.1 X.1 r Q f.1 k i, \ W X r Q f i -> PB.bigU-out W.1 X.1 r Q f.1 i,
   forallS, lands-forall, forall-lands,
   cI,
   \ d Vt W g i j -> ivExt Vt (tcomp Vt W IvT (cI d W i j) g) (cI d Vt (tcomp Vt W IvT i g) (tcomp Vt W IvT j g)) (PB.cI-nat d Vt.1 W.1 g.1 i.1 j.1),
   \ W i -> ivExt W (cI true W i (ptT W PB.e0)) (ptT W PB.e0) (PB.cI-jsrc-t W.1 i.1),
   \ W i -> ivExt W (cI false W i (ptT W PB.e1)) (ptT W PB.e1) (PB.cI-jsrc-f W.1 i.1),
   \ W i -> ivExt W (cI true W i (ptT W PB.e1)) i (PB.cI-jtgt-t W.1 i.1),
   \ W i -> ivExt W (cI false W i (ptT W PB.e0)) i (PB.cI-jtgt-f W.1 i.1),
   \ W j -> ivExt W (cI true W (ptT W PB.e0) j) (ptT W PB.e0) (PB.cI-isrc-t W.1 j.1),
   \ W j -> ivExt W (cI false W (ptT W PB.e1) j) (ptT W PB.e1) (PB.cI-isrc-f W.1 j.1),
   \ W j -> ivExt W (cI true W (ptT W PB.e1) j) j (PB.cI-itgt-t W.1 j.1),
   \ W j -> ivExt W (cI false W (ptT W PB.e0) j) j (PB.cI-itgt-f W.1 j.1)] ;

 ----------------------------------------------------------------------
 -- two maps into a canonical object with equal base parts and equal
 -- composites with the cartesian lift are equal
 cartMono (J : Ob) (Z X : TOb) (u : Hom J X.1) (m m' : THm Z (cob J X u)) (p : Id (Hom Z.1 J) m.1 m'.1)
  (q : Id (THm Z X) (tcomp Z (cob J X u) X (cart J X u) m) (tcomp Z (cob J X u) X (cart J X u) m')) : Id (THm Z (cob J X u)) m m' =
  idJ (Hom Z.1 J) m.1
   (\ v' p' -> (g' : VT.HomD Z.1 J v' Z.2 (C.res J X.1 u X.2))
       -> Id (THm Z X) (tcomp Z (cob J X u) X (cart J X u) m) (tcomp Z (cob J X u) X (cart J X u) (v', g'))
       -> Id (THm Z (cob J X u)) m (v', g'))
   (\ g' q' -> apH {VT.HomD Z.1 J m.1 Z.2 (C.res J X.1 u X.2)} {THm Z (cob J X u)} (\ z -> (m.1, z))
      (transH (TC.factT-uniq J Z X u m.1 (tcomp Z (cob J X u) X (cart J X u) (m.1, g')) (refl (compH Z.1 J X.1 u m.1)) m.2 q')
         (symH (TC.factT-uniq J Z X u m.1 (tcomp Z (cob J X u) X (cart J X u) (m.1, g')) (refl (compH Z.1 J X.1 u m.1)) g'
                  (refl (tcomp Z (cob J X u) X (cart J X u) (m.1, g')))))))
   m'.1 p m'.2 q ;

 -- the cylinder (CCyl), for the constant types
 module Cy {
  open CPosC[a] ;
  cyl (X : TOb) : TOb = cob (prodP X.1 PB.Iv) X (pr1 X.1 PB.Iv) ;
  cpr1 (X : TOb) : THm (cyl X) X = cart (prodP X.1 PB.Iv) X (pr1 X.1 PB.Iv) ;
  cpr2 (X : TOb) : THm (cyl X) IvT = toIv (cyl X) (pr2 X.1 PB.Iv) ;
  cpair (X Z : TOb) (f : THm Z X) (j : THm Z IvT) : THm Z (cyl X) =
   TC.factT (prodP X.1 PB.Iv) Z X (pr1 X.1 PB.Iv) (pairH X.1 PB.Iv Z.1 f.1 j.1) f (symH (pr1-pair X.1 PB.Iv Z.1 f.1 j.1)) ;
  cpr1-pair (X Z : TOb) (f : THm Z X) (j : THm Z IvT) : Id (THm Z X) (tcomp Z (cyl X) X (cpr1 X) (cpair X Z f j)) f =
   TC.factT-eq (prodP X.1 PB.Iv) Z X (pr1 X.1 PB.Iv) (pairH X.1 PB.Iv Z.1 f.1 j.1) f (symH (pr1-pair X.1 PB.Iv Z.1 f.1 j.1)) ;
  cpr2-pair (X Z : TOb) (f : THm Z X) (j : THm Z IvT) : Id (THm Z IvT) (tcomp Z (cyl X) IvT (cpr2 X) (cpair X Z f j)) j =
   ivExt Z (tcomp Z (cyl X) IvT (cpr2 X) (cpair X Z f j)) j (pr2-pair X.1 PB.Iv Z.1 f.1 j.1) ;
  cpair-eta (X Z : TOb) (h : THm Z (cyl X))
   : Id (THm Z (cyl X)) (cpair X Z (tcomp Z (cyl X) X (cpr1 X) h) (tcomp Z (cyl X) IvT (cpr2 X) h)) h =
   cartMono (prodP X.1 PB.Iv) Z X (pr1 X.1 PB.Iv)
    (cpair X Z (tcomp Z (cyl X) X (cpr1 X) h) (tcomp Z (cyl X) IvT (cpr2 X) h)) h
    (pair-eta X.1 PB.Iv Z.1 h.1)
    (cpr1-pair X Z (tcomp Z (cyl X) X (cpr1 X) h) (tcomp Z (cyl X) IvT (cpr2 X) h)) ;
  totCyl : CCyl[a].CylOf[GB.BC, IvT].Cyl =
   new CCyl[a].CylOf[GB.BC, IvT].Cyl[cyl, cpr1, cpr2, cpair, cpr1-pair, cpr2-pair, cpair-eta] ;
 } ;

 -- the generic layers exist at the total site (a test of the instance)
 pre-id-T (X : TOb) (Q : Phi X) : Id (Phi X) (pre X X (TC.tid X) Q) Q = GB.pre-id X Q ;
 lines-T (G : Presheaf[a, l].Psh[GB.BC].PCtx) (X : TOb) : V[l].V = GB.CLine[l].FC[G].ftV X ;
 fibs-T (G : Presheaf[a, l].Psh[GB.BC].PCtx) (A : Presheaf[a, l].Psh[GB.BC].PTy[G]) : U (l+) = GB.CLine[l].Lines[G, A].Fib ;
} ;
