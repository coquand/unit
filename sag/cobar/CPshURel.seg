-- CPshURel.seg (canonicity-c2; COBAR.md (B), the S3 bridge, part (II)):
-- U-Rel, the transfer of a uniform ContrOp along a retraction of C-types.
--
-- S , T C-types over D; at each x maps f x : S_x -> T_x and g x : T_x -> S_x
-- of base types over D_x, with g x after f x the identity (mId) and both
-- commuting with the C-actions (fC , gC).  A ContrOp of T at each x gives
-- one of S (CLocBoundRetr.Relative, FibYC.RelId: extend the f-image of
-- the side in T, come back by g); if the first is uniform in C so is the
-- second: the moved f-image of a side is the f-image of the moved side
-- (sdF, by fC), then the uniformity of T's and gC.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;
module HO = PB.CHtpyOps[l] ;
module LR = CLocBoundRetr[a, l] ;
module YCm = FibYC[a, l] ;

module URelOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 open P ;

 module URel (D : CCtx) (S T : CTy[D])
  (f : (x : CO) -> HO.NMap[D.ob x, S.ty x, T.ty x])
  (g : (x : CO) -> HO.NMap[D.ob x, T.ty x, S.ty x])
  (mId : (x : CO) (X : Ob) (w : SigT (D.ob x) (S.ty x) X)
         -> Id (SigT (D.ob x) (S.ty x) X) (LR.Map[D.ob x, S.ty x, S.ty x, HO.compN (D.ob x) (S.ty x) (T.ty x) (S.ty x) (f x) (g x)].pmap.mE X w) w)
  (fC : (y x : CO) (h : CH y x) (X : Ob) (u : SigT (D.ob x) (S.ty x) X)
        -> Id (SigT (D.ob y) (T.ty y) X) ((T.tE y x h).nt X (LR.Map[D.ob x, S.ty x, T.ty x, f x].onE X u))
             (LR.Map[D.ob y, S.ty y, T.ty y, f y].onE X ((S.tE y x h).nt X u)))
  (gC : (y x : CO) (h : CH y x) (X : Ob) (u : SigT (D.ob x) (T.ty x) X)
        -> Id (SigT (D.ob y) (S.ty y) X) ((S.tE y x h).nt X (LR.Map[D.ob x, T.ty x, S.ty x, g x].onE X u))
             (LR.Map[D.ob y, T.ty y, S.ty y, g y].onE X ((T.tE y x h).nt X u)))
  (ut : UTriv D T) {
  module Fx (x : CO) {
   module F = LR.Map[D.ob x, S.ty x, T.ty x, f x] ;
   module Gm = LR.Map[D.ob x, T.ty x, S.ty x, g x] ;
   module PS = CP.Partials[D.ob x, S.ty x] ;
   module PT = CP.Partials[D.ob x, T.ty x] ;
  } ;
  -- the ContrOp of S at x
  kS (x : CO) : CP.ContrOp (D.ob x) (S.ty x) =
   YCm.RelId[D.ob x, S.ty x, LR.Map[D.ob x, S.ty x, S.ty x, HO.compN (D.ob x) (S.ty x) (T.ty x) (S.ty x) (f x) (g x)].pmap, mId x,
     LR.Relative[D.ob x, S.ty x, T.ty x, f x, g x, ut.1 x].extension].contrOp ;
  -- by definition of Relative
  kS-E (x : CO) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) (s : Fx[x].PS.Side[X, d])
   : Id (SigT (D.ob x) (S.ty x) X) (pairE (D.ob x) (S.ty x) X d ((kS x).kop X d s))
       (Fx[x].Gm.onE X (pairE (D.ob x) (T.ty x) X d ((ut.1 x).kop X d (Fx[x].F.side X d s)))) =
   refl (pairE (D.ob x) (S.ty x) X d ((kS x).kop X d s)) ;

  module Um (y x : CO) (h : CH y x) (X : Ob) (d : W0.Ix ((D.ob x).ob X)) (s : Fx[x].PS.Side[X, d]) {
   dy : W0.Ix ((D.ob y).ob X) = (D.act y x h).nt X d ;
   msS : Fx[y].PS.Side[X, dy] = MapSide[D, S, y, x, h].mapside X d s ;
   msT : Fx[y].PT.Side[X, dy] = MapSide[D, T, y, x, h].mapside X d (Fx[x].F.side X d s) ;
   -- the moved image of the side is the image of the moved side
   sdF : Id (Fx[y].PT.Side[X, dy]) msT (Fx[y].F.side X dy msS) =
    Fx[y].PT.side-ext X dy msT (Fx[y].F.side X dy msS) (refl s.pQ)
     (\ W k i i' -> transH (fC y x h W (s.pv W k i))
        (apH (\ t -> Fx[y].F.onE W ((S.tE y x h).nt W t)) (Fx[x].PS.pv-irr X d s W k i i'))) ;
   res : Id (SigT (D.ob y) (S.ty y) X) ((S.tE y x h).nt X (pairE (D.ob x) (S.ty x) X d ((kS x).kop X d s)))
          (pairE (D.ob y) (S.ty y) X dy ((kS y).kop X dy msS)) =
    transH (gC y x h X (pairE (D.ob x) (T.ty x) X d ((ut.1 x).kop X d (Fx[x].F.side X d s))))
     (apH (\ t -> Fx[y].Gm.onE X t)
       (transH (ut.2 y x h X d (Fx[x].F.side X d s))
         (apH (\ sd -> pairE (D.ob y) (T.ty y) X dy ((ut.1 y).kop X dy sd)) sdF))) ;
  } ;
  -- U-Rel: the ContrOps of S are uniform in C
  utS : UTriv D S = (kS, \ y x h X d s -> Um[y, x, h, X, d, s].res) ;
 } ;
} ;
