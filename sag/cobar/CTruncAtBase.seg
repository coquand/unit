-- CTruncAtBase.seg (canonicity-c2; SIMPLIFIED.md item 3): the base's
-- propositional truncation (CTruncCwF) as an instance of the truncation
-- interface CwFTrunc.TruncAt, at the CwF of fibrant types FibCwF[a, a+]
-- (the level of the universe FibUniv).
--   Tr, inc    CTruncCwF's Tr0 and incE
--   trProp     over G.Tr the truncation is contractible (contrTr), so it
--              is a proposition (CwFPropProp.propOver)
--   elim       core's eliminator into propositions (ElimB)
--   truncAt    the instance of the interface
level a ;
open Base ; open Prelude[a++] ; open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ; module PR = PB.GPre[a+] ; open PR.PS ;
module FCw = FibCwF[a, a+] ;
module FC = FCw.FC ;
module TC = CTruncCwF[a, a+] ;
module PPp = CwFPropProp.PropProp[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module PU = CwFPropU.PropU[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

Tr (G : PCtx) (A : FC.STy G) : FC.STy G = TC.TrOf[G, A].Tr0 ;
inc (G : PCtx) (A : FC.STy G) : FCw.fibCwF.El (FCw.fibCwF.ext G A) (FCw.fibCwF.subT (FCw.fibCwF.ext G A) G (Tr G A) (FCw.fibCwF.p G A)) =
  TC.TrOf[G, A].incE ;
trProp (G : PCtx) (A : FC.STy G) : FCw.fibCwF.El G (PU.isProp G (Tr G A)) = PPp.propOver G (Tr G A) TC.TrOf[G, A].contrTr ;

-- elimination into a family of propositions (in the sense of Swan's Id):
-- the internal proof gives core's homotopy from the constant map to the
-- identity (FibHt.YH), which is what core's eliminator takes; the unit
-- substitution is core's inclusion map (same points)
module EQ = CwFEq.Eqv[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId] ;
module HO = PB.CHtpyOps[a+] ;
-- the unit as a substitution G.A -> G.Tr A (extS p inc, spelled out)
incS (G : PCtx) (A : FC.STy G) : PSub[FCw.fibCwF.ext G A, FCw.fibCwF.ext G (Tr G A)] =
  FCw.fibCwF.o (FCw.fibCwF.ext G A)
    (FCw.fibCwF.ext (FCw.fibCwF.ext G A) (FCw.fibCwF.subT (FCw.fibCwF.ext G A) G (Tr G A) (FCw.fibCwF.p G A)))
    (FCw.fibCwF.ext G (Tr G A))
    (FCw.fibCwF.lift (FCw.fibCwF.ext G A) G (Tr G A) (FCw.fibCwF.p G A))
    (FCw.fibCwF.sec (FCw.fibCwF.ext G A) (FCw.fibCwF.subT (FCw.fibCwF.ext G A) G (Tr G A) (FCw.fibCwF.p G A)) (inc G A)) ;

module ElimB (G : PCtx) (A : FC.STy G)
  (B : FC.STy (FCw.fibCwF.ext G (Tr G A)))
  (pB : FCw.fibCwF.El (FCw.fibCwF.ext G (Tr G A)) (PU.isProp (FCw.fibCwF.ext G (Tr G A)) B))
  (b : FCw.fibCwF.El (FCw.fibCwF.ext G A)
         (FCw.fibCwF.subT (FCw.fibCwF.ext G A) (FCw.fibCwF.ext G (Tr G A)) B
            (incS G A))) {
  module TO = TC.TrOf[G, A] ;
  GT : PCtx = TO.GT ;
  GA : PCtx = TO.GA ;
  D : PCtx = extP GT B.1 ;
  C : PTy[D] = subTy D GT B.1 (pP GT B.1) ;
  Bw : FC.STy D = FCw.fibCwF.subT D GT B (FCw.fibCwF.p GT B) ;
  w : PEl[extP D C, PosIdY[a, a+].IdY[extP D C, subTy (extP D C) D C (pP D C), subEl (extP D C) D C (qP GT B.1) (pP D C), qP D C].IdYT] =
    (FCw.fibPi.Pi-iso D Bw (EQ.Id2 GT B)).fun ((FCw.fibPi.Pi-iso GT B (FCw.fibPi.Pi D Bw (EQ.Id2 GT B))).fun pB) ;
  module Y = FibHt[a, a+].YH[D, C, C, CLocBoundContr[a, a+].constant D C (qP GT B.1), HO.idN D C,
    subEl (extP D C) D C (qP GT B.1) (pP D C), qP D C,
    \ X z -> refl ((qP GT B.1).eob X (fstE D C X z)), \ X z -> refl (sndE D C X z), w] ;
  module EE = TO.El[B, Y.H] ;
  incS1 : PSub[GA, GT] = incS G A ;
  eqS : Id (PSub[GA, GT]) incS1 EE.E.E.inclusion = sub-ext GA GT incS1 EE.E.E.inclusion (\ I x -> refl (incS1.nt I x)) ;
  b1 : PEl[GA, EE.E.atInc] = subst (PSub[GA, GT]) (\ s -> PEl[GA, subTy GA GT B.1 s]) incS1 EE.E.E.inclusion eqS b ;
  elim : PEl[GT, B.1] = EE.elim b1 ;
} ;

-- the instance
module TI = CwFTrunc.Trunc[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
truncAt : TI.TruncAt =
  new TI.TruncAt[Tr, inc, trProp, \ G A B pB b -> ElimB[G, A, B, pB, b].elim] ;

-- the Voevodsky quotient at the base: CwFQuot instantiates
module OV = CwFOv.Ov[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId] ;
module QT = CwFQuot.Quot[a++, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf, truncAt] ;
quot (G : PCtx) (A : FC.STy G) (r : FCw.fibCwF.El G (OV.Fun G A (OV.Fun G A (PU.PropU G)))) : FC.STy G = QT.Q[G, A, r].Qt ;
cls (G : PCtx) (A : FC.STy G) (r : FCw.fibCwF.El G (OV.Fun G A (OV.Fun G A (PU.PropU G)))) (x : FCw.fibCwF.El G A)
  : FCw.fibCwF.El G (quot G A r) = QT.Q[G, A, r].clsG x ;
