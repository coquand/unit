-- CTotL14e.seg (canonicity-45; SIMPLIFIED.md step 4): Lemma 14 at the
-- total site, part e: the element MW of D A over tau g read from u at the
-- chains with the identity prepended, under a family of weights Wf (the
-- lines q and p of Lemma 14 are MW at two such families).
--   MW.i1 q   (n+1, J, u', z, consId c, Wf (t . u') i) for q = (n, J, u', z, c, i)
--   MW.mv     u read at i1 q, moved to the point tau g at q (consId-tot)
--   anat'     u's naturality at i1 q (restriction of consId: part d)
--   aface'    u's face (k+1) at i1 q (faces of consId by definition)
--   atop'     u's top face at i1 q (drop of consId by definition)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;

module L14e (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LB = CTotL14b[a, vl, l].L14b[C, G, A] ;
 module LD = CTotL14d[a, vl, l].L14d[C] ;
 module U12 = Lemma12I[a, vl, l].L12I[C, G, A] ;
 module TC = LB.TC ;
 module P = LB.P ;
 module VT = LB.VT ;
 module DA = LB.DA ;
 module D = LB.D ;
 module DO = LB.TA.DO ;
 E : P.PCtx = LB.E ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 module KJ (J : Ob) { module K = LD.KJ[J].K ; module CI = LD.KJ[J].CI ; } ;

 module MW (Wf : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) (t : Hom I PFO.ivO) {
  tg : D.Ob' I x = D.tau I x g ;
  wq (q : DA.Idx I x) (l : DA.LandsI I x q) : Wt.Pn (suc q.1) q.2.1 = Wf q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t q.2.2.1) (q.2.2.2.2.2, l) ;
  i1 (q : DA.Idx I x) (l : DA.LandsI I x q) : DA.Idx I x =
   (suc q.1, q.2.1, q.2.2.1, q.2.2.2.1, KJ[q.2.1].CI.consId q.1 (C.res q.2.1 I q.2.2.1 x) q.2.2.2.1 q.2.2.2.2.1, (wq q l).1) ;
  l1 (q : DA.Idx I x) (l : DA.LandsI I x q) : DA.LandsI I x (i1 q l) = (wq q l).2 ;
  Pm (q : DA.Idx I x) (l : DA.LandsI I x q) : Id (W0.Ix (G.ob q.2.1 q.2.2.2.1)) (tg.1 (i1 q l) (l1 q l)) (tg.1 q l) =
   apH {VT.VMap q.2.1 q.2.2.2.1 (C.res q.2.1 I q.2.2.1 x)} {W0.Ix (G.ob q.2.1 q.2.2.2.1)}
    (\ k -> G.act q.2.1 I q.2.2.1 q.2.2.2.1 x
              (VT.trH q.2.1 I (compH q.2.1 q.2.1 I q.2.2.1 (idH q.2.1)) q.2.2.1 (comp-idr q.2.1 I q.2.2.1) q.2.2.2.1 x
                 (C.compD q.2.1 q.2.1 I q.2.2.1 (idH q.2.1) q.2.2.2.1 (C.res q.2.1 I q.2.2.1 x) x (C.cart q.2.1 I q.2.2.1 x) k)) g)
    (KJ[q.2.1].CI.consId-tot q.1 (C.res q.2.1 I q.2.2.1 x) q.2.2.2.1 q.2.2.2.2.1) ;
  mv : DA.TA I x tg = \ q l ->
   DA.coeT q.2.1 q.2.2.2.1 (tg.1 (i1 q l) (l1 q l)) (tg.1 q l) (Pm q l) (u.1 (i1 q l) (l1 q l)) ;
  mpc (q : DA.Idx I x) (l : DA.LandsI I x q)
   : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (tg.1 q l) (mv q l)) (DA.prz q.2.1 q.2.2.2.1 (tg.1 (i1 q l) (l1 q l)) (u.1 (i1 q l) (l1 q l))) =
   symH (DA.pr-coe q.2.1 q.2.2.2.1 (tg.1 (i1 q l) (l1 q l)) (tg.1 q l) (Pm q l) (u.1 (i1 q l) (l1 q l))) ;
  -- u read at (n+1, J, u', z, cc, p)
  rr (n : Nat) (J : Ob) (u' : Hom J I) (z : Obj J) (cc : KJ[J].K.Ch (suc n) (C.res J I u' x) z) (p : Wt.Pn (suc n) J) : DA.Ez J z =
   DA.prz J z (tg.1 (suc n, J, u', z, cc, p.1) p.2) (u.1 (suc n, J, u', z, cc, p.1) p.2) ;
  anat' : W0.Ix (DA.anatEq I x tg mv) = \ r l ->
   transH (apH {DA.Ez r.1.2.1 r.1.2.2.2.1} {DA.Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
             (E.act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (mpc r.1 l))
    (transH (u.2.1 (i1 r.1 l, r.2) (l1 r.1 l))
      (transH (apH {KJ[r.2.1].K.Ch (suc r.1.1) (C.res r.2.1 I (compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2) x) (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} {DA.Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
                 (\ cc -> rr r.1.1 r.2.1 (compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2) (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) cc (Wt.Res[suc r.1.1, r.2.1, r.1.2.1, r.2.2, wq r.1 l].res))
                 (LD.rCh-cons r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1))
        (transH (apH {Wt.Pn (suc r.1.1) r.2.1} {DA.Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
                   (\ p -> rr r.1.1 r.2.1 (compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2) (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
                             (KJ[r.2.1].CI.consId r.1.1 (C.res r.2.1 I (compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2) x) (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
                                (DO.rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1)) p)
                   (transH (Wres r.1.1 r.2.1 r.1.2.1 r.2.2 (PB.compH r.1.2.1 I PFO.ivO t r.1.2.2.1) (r.1.2.2.2.2.2, l))
                     (apH {Hom r.2.1 PFO.ivO} {Wt.Pn (suc r.1.1) r.2.1} (\ t' -> Wf r.1.1 r.2.1 t' (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res))
                        (PB.comp-assoc r.2.1 r.1.2.1 I PFO.ivO t r.1.2.2.1 r.2.2))))
          (symH (mpc (r.1.1, r.2.1, compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1,
                      DO.rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1,
                      (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                     (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2))))) ;
  aface' : W0.Ix (DA.afaceEq I x tg mv) = \ r l ->
   transH (mpc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF I x r l).1) (DA.afaceF I x r l).2)
    (transH (apH {Wt.Pn (suc (suc r.1)) r.2.2.2.1} {DA.Ez r.2.2.2.1 r.2.2.2.2.2.1}
               (rr (suc r.1) r.2.2.2.1 r.2.2.2.2.1 r.2.2.2.2.2.1 (KJ[r.2.2.2.1].CI.consId (suc r.1) (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1))
               (transH (Wface r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PFO.ivO t r.2.2.2.2.1) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1) (r.2.2.2.2.2.2.2, l))
                 (U12.faceW-irr (suc r.1) r.2.2.2.1 (suc r.2.1) (Ar.leb-step r.2.1 r.1 r.2.2.1) (Ar.leb-step (suc r.2.1) (suc r.1) r.2.2.1)
                    (Wf r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PFO.ivO t r.2.2.2.2.1) (r.2.2.2.2.2.2.2, l)))))
      (transH (u.2.2.1 (suc r.1, suc r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1,
                        KJ[r.2.2.2.1].CI.consId (suc r.1) (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1,
                        (Wf r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PFO.ivO t r.2.2.2.2.1) (r.2.2.2.2.2.2.2, l)).1)
                       (Wf r.1 r.2.2.2.1 (PB.compH r.2.2.2.1 I PFO.ivO t r.2.2.2.2.1) (r.2.2.2.2.2.2.2, l)).2)
        (symH (mpc (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)))) ;
  atop' : W0.Ix (DA.atopEq I x tg mv) = \ r l ->
   transH (mpc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF I x r l).1) (DA.atopF I x r l).2)
    (transH (apH {Wt.Pn (suc (suc r.1)) r.2.1} {DA.Ez r.2.1 r.2.2.2.1}
               (rr (suc r.1) r.2.1 r.2.2.1 r.2.2.2.1 (KJ[r.2.1].CI.consId (suc r.1) (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1))
               (transH (Wface r.1 r.2.1 (PB.compH r.2.1 I PFO.ivO t r.2.2.1) (suc r.1) (Tr.leb-refl (suc r.1)) (r.2.2.2.2.2, l))
                 (U12.faceW-irr (suc r.1) r.2.1 (suc (suc r.1)) (Tr.leb-refl (suc r.1)) (Tr.leb-refl (suc (suc r.1)))
                    (Wf r.1 r.2.1 (PB.compH r.2.1 I PFO.ivO t r.2.2.1) (r.2.2.2.2.2, l)))))
      (transH (u.2.2.2 (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, KJ[r.2.1].CI.consId (suc r.1) (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1,
                        (Wf r.1 r.2.1 (PB.compH r.2.1 I PFO.ivO t r.2.2.1) (r.2.2.2.2.2, l)).1)
                 (Wf r.1 r.2.1 (PB.compH r.2.1 I PFO.ivO t r.2.2.1) (r.2.2.2.2.2, l)).2)
        (apH {DA.Ez r.2.1 (KJ[r.2.1].K.drop r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1).1} {DA.Ez r.2.1 r.2.2.2.1}
           (E.act (r.2.1, r.2.2.2.1) (r.2.1, (KJ[r.2.1].K.drop r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1).1) (idH r.2.1, (KJ[r.2.1].K.drop r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1).2.2))
           (symH (mpc (r.1, r.2.1, r.2.2.1, (KJ[r.2.1].K.drop r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1).1, (KJ[r.2.1].K.drop r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1).2.1, r.2.2.2.2.2) l))))) ;
  res : DA.TOb' I x tg = (mv, (anat', (aface', atop'))) ;
 } ;
} ;
