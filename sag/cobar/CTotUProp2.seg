-- CTotUProp2.seg (canonicity-c2; towards "U preserves propositions"):
-- a contraction k1 of A at the total site gives the extension operation
-- of U A at the levelwise site: kop0 s = k1.kop (side1 s), and it agrees
-- with the side (kside0: the factorisation of a levelwise map is itself,
-- up to ini, as in CTotUExt's RE).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module UP2 (C : CIntCat[a, vl].IC) {
 module U1 = CTotUProp1[a, vl, l].UP1[C] ;
 module UX = U1.UX ;
 module TR = U1.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 module KO (D : P1.PCtx) (A : P1.PTy[D]) (k1 : G1.GB.CPartial[l].ContrOp D A) {
  module SX = U1.SX[D, A] ;
  E : P1.PCtx = SX.E ;
  kop0 (Y : U1.Ob0) (x : W0.Ix (D.ob (RN.o Y))) (s : SX.CP0.Side[Y, x]) : W0.Ix (A.tob (RN.o Y) x) =
   k1.kop (RN.o Y) x (SX.S[Y, x, s].side1) ;
  module KS (Y : U1.Ob0) (x : W0.Ix (D.ob (RN.o Y))) (s : SX.CP0.Side[Y, x]) (W : U1.Ob0) (h : RN.Hom0 W Y)
    (i : G0.GB.Lands W Y s.pQ h) {
   k : RN.Hom1 (RN.o W) (RN.o Y) = TR.fn.onH W Y h ;
   L : U1.Ob0 = UX.lf Y (RN.o W) k ;
   id1 : RN.Hom1 (RN.o W) (RN.o W) = G1.GB.BC.idC (RN.o W) ;
   module IN = TR.DS.Ini[Y, W, RN.o W, h, id1, k, G1.GB.BC.oC-idr (RN.o W) (RN.o Y) k] ;
   d : RN.Hom0 L W = IN.d ;
   d-cl : Id (RN.Hom0 L Y) (G0.GB.BC.oC L W Y h d) (UX.cl Y (RN.o W) k) = IN.eq1 ;
   d-vp : Id (RN.Hom1 (RN.o W) (RN.o W)) (G1.GB.BC.oC (RN.o W) (RN.o L) (RN.o W) (TR.fn.onH L W d) (U1.vp Y (RN.o W) k)) id1 = IN.eq2 ;
   b : W0.Ix (E.ob (RN.o W)) = s.pv W h i ;
   ic : G0.GB.Lands L Y s.pQ (UX.cl Y (RN.o W) k) = i ;
   i2 : G0.GB.Lands L Y s.pQ (G0.GB.BC.oC L W Y h d) = G0.GB.lands-eq L Y s.pQ (UX.cl Y (RN.o W) k) (G0.GB.BC.oC L W Y h d) (symH d-cl) ic ;
   r1 : Id (W0.Ix (E.ob (RN.o L))) (E.act (RN.o L) (RN.o W) (TR.fn.onH L W d) b) (s.pv L (UX.cl Y (RN.o W) k) ic) =
    transH (s.pnat L W d h i i2) (SX.CP0.pv-hom Y x s L (G0.GB.BC.oC L W Y h d) (UX.cl Y (RN.o W) k) d-cl i2 ic) ;
   ret : Id (W0.Ix (E.ob (RN.o W))) (SX.S[Y, x, s].pv1 (RN.o W) k i) b =
    transH (apH {W0.Ix (E.ob (RN.o L))} {W0.Ix (E.ob (RN.o W))} (\ w -> E.act (RN.o W) (RN.o L) (U1.vp Y (RN.o W) k) w) (symH r1))
     (transH (symH (E.act-o (RN.o W) (RN.o L) (RN.o W) (TR.fn.onH L W d) (U1.vp Y (RN.o W) k) b))
        (transH (ap (RN.Hom1 (RN.o W) (RN.o W)) (W0.Ix (E.ob (RN.o W))) (\ w -> E.act (RN.o W) (RN.o W) w b)
                   (G1.GB.BC.oC (RN.o W) (RN.o L) (RN.o W) (TR.fn.onH L W d) (U1.vp Y (RN.o W) k)) id1 d-vp)
           (E.act-id (RN.o W) b))) ;
   kside0 : Id (W0.Ix (E.ob (RN.o W))) (E.act (RN.o W) (RN.o Y) k (P1.pairE D A (RN.o Y) x (kop0 Y x s))) b =
    transH (k1.kside (RN.o Y) x (SX.S[Y, x, s].side1) (RN.o W) k i) ret ;
  } ;
  -- uniformity: restricting the extended side along F h is extending the
  -- restricted side (compare the factorisations by ini)
  module KU (Y' Y : U1.Ob0) (h : RN.Hom0 Y' Y) (x : W0.Ix (D.ob (RN.o Y))) (s : SX.CP0.Side[Y, x]) {
   k : RN.Hom1 (RN.o Y') (RN.o Y) = TR.fn.onH Y' Y h ;
   x' : W0.Ix (D.ob (RN.o Y')) = D.act (RN.o Y') (RN.o Y) k x ;
   s0' : SX.CP0.Side[Y', x'] = SX.CP0.rside Y' Y h x s ;
   s1 : SX.CP1.Side[RN.o Y, x] = SX.S[Y, x, s].side1 ;
   module EV (Z : U1.Ob1) (m : RN.Hom1 Z (RN.o Y')) (i : G1.GB.Lands Z (RN.o Y') (G1.GB.pre (RN.o Y') (RN.o Y) k s.pQ) m)
     (i' : G1.GB.Lands Z (RN.o Y') s0'.pQ m) {
    km : RN.Hom1 Z (RN.o Y) = G1.GB.BC.oC Z (RN.o Y') (RN.o Y) k m ;
    L1 : U1.Ob0 = UX.lf Y Z km ;
    L2 : U1.Ob0 = UX.lf Y' Z m ;
    c : RN.Hom0 L2 Y = G0.GB.BC.oC L2 Y' Y h (UX.cl Y' Z m) ;
    e : Id (RN.Hom1 Z (RN.o Y)) (G1.GB.BC.oC Z (RN.o L2) (RN.o Y) (TR.fn.onH L2 Y c) (U1.vp Y' Z m)) km =
     transH (ap (RN.Hom1 (RN.o L2) (RN.o Y)) (RN.Hom1 Z (RN.o Y)) (\ w -> G1.GB.BC.oC Z (RN.o L2) (RN.o Y) w (U1.vp Y' Z m))
               (TR.fn.onH L2 Y c) (G1.GB.BC.oC (RN.o L2) (RN.o Y') (RN.o Y) k (TR.fn.onH L2 Y' (UX.cl Y' Z m)))
               (TR.fn.onComp L2 Y' Y h (UX.cl Y' Z m)))
      (transH (G1.GB.BC.oC-assoc Z (RN.o L2) (RN.o Y') (RN.o Y) k (TR.fn.onH L2 Y' (UX.cl Y' Z m)) (U1.vp Y' Z m))
         (ap (RN.Hom1 Z (RN.o Y')) (RN.Hom1 Z (RN.o Y)) (\ w -> G1.GB.BC.oC Z (RN.o Y') (RN.o Y) k w)
            (G1.GB.BC.oC Z (RN.o L2) (RN.o Y') (TR.fn.onH L2 Y' (UX.cl Y' Z m)) (U1.vp Y' Z m)) m
            (TR.DS.Fact[Y', Z, m].vp-eq))) ;
    module IN = TR.DS.Ini[Y, L2, Z, c, U1.vp Y' Z m, km, e] ;
    j1 : G0.GB.Lands L1 Y s.pQ (UX.cl Y Z km) = G1.GB.lands-pre Z (RN.o Y') (RN.o Y) k s.pQ m i ;
    j2 : G0.GB.Lands L2 Y s.pQ c = G0.GB.lands-pre L2 Y' Y h s.pQ (UX.cl Y' Z m) i' ;
    j3 : G0.GB.Lands L1 Y s.pQ (G0.GB.BC.oC L1 L2 Y c IN.d) = G0.GB.lands-eq L1 Y s.pQ (UX.cl Y Z km) (G0.GB.BC.oC L1 L2 Y c IN.d) (symH IN.eq1) j1 ;
    a2 : W0.Ix (E.ob (RN.o L2)) = s.pv L2 c j2 ;
    chain : Id (W0.Ix (E.ob Z)) (E.act Z (RN.o L2) (U1.vp Y' Z m) a2) (E.act Z (RN.o L1) (U1.vp Y Z km) (s.pv L1 (UX.cl Y Z km) j1)) =
     transH (ap (RN.Hom1 Z (RN.o L2)) (W0.Ix (E.ob Z)) (\ w -> E.act Z (RN.o L2) w a2)
               (U1.vp Y' Z m) (G1.GB.BC.oC Z (RN.o L1) (RN.o L2) (TR.fn.onH L1 L2 IN.d) (U1.vp Y Z km)) (symH IN.eq2))
      (transH (E.act-o Z (RN.o L1) (RN.o L2) (TR.fn.onH L1 L2 IN.d) (U1.vp Y Z km) a2)
         (apH {W0.Ix (E.ob (RN.o L1))} {W0.Ix (E.ob Z)} (\ w -> E.act Z (RN.o L1) (U1.vp Y Z km) w)
            (transH (s.pnat L1 L2 IN.d c j2 j3)
               (SX.CP0.pv-hom Y x s L1 (G0.GB.BC.oC L1 L2 Y c IN.d) (UX.cl Y Z km) IN.eq1 j3 j1)))) ;
    ev : Id (W0.Ix (E.ob Z)) ((SX.CP1.rside (RN.o Y') (RN.o Y) k x s1).pv Z m i) (SX.S[Y', x', s0'].pv1 Z m i') = symH chain ;
   } ;
   R : Id (SX.CP1.Side[RN.o Y', x']) (SX.CP1.rside (RN.o Y') (RN.o Y) k x s1) (SX.S[Y', x', s0'].side1) =
    SX.CP1.side-ext (RN.o Y') x' (SX.CP1.rside (RN.o Y') (RN.o Y) k x s1) (SX.S[Y', x', s0'].side1) (refl s0'.pQ)
      (\ Z m i i' -> EV[Z, m, i, i'].ev) ;
   kunif0 : Id (W0.Ix (E.ob (RN.o Y'))) (E.act (RN.o Y') (RN.o Y) k (P1.pairE D A (RN.o Y) x (kop0 Y x s)))
      (P1.pairE D A (RN.o Y') x' (kop0 Y' x' s0')) =
    transH (k1.kunif (RN.o Y') (RN.o Y) k x s1)
      (apH {SX.CP1.Side[RN.o Y', x']} {W0.Ix (E.ob (RN.o Y'))} (\ z -> P1.pairE D A (RN.o Y') x' (k1.kop (RN.o Y') x' z)) R) ;
  } ;
  module R0 = G0.GB.CPartial[l].Rel[SX.UD, SX.UA, SX.UA, G0.GB.CPartial[l].pmap-id SX.UD SX.UA] ;
  k0 : G0.GB.CPartial[l].ContrOp SX.UD SX.UA =
   R0.mkRC (\ Y x s -> kop0 Y x s) (\ Y x s W h i -> KS[Y, x, s, W, h, i].kside0) (\ Y' Y h x s -> KU[Y', Y, h, x, s].kunif0) ;
 } ;
} ;
