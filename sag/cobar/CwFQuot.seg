-- CwFQuot.seg (canonicity-c2; SIMPLIFIED.md item 3): the quotient of a
-- type by a proposition-valued relation, as the image of
-- A -> (A -> PropU) (Voevodsky), in a CwF with Pi, Sigma, Swan Id, a
-- universe, and a truncation without stability (CwFTrunc.TruncAt).
--
-- Data: A over G and r : A -> (A -> PropU), the relation.
--   PA = A -> PropU ;  K = G.PA, with variable P
--   S  = Sigma (a : A) Id (r a , P)       over K: the fibre of r at P (CwFQinv.FibE),
--        so that CwFQinvC's lemmas for fibres at a point apply
--   Q  = Sigma (P : PA) || S ||           over G
-- One truncation over one context: every use substitutes Tr K S.
open Base ;

module Quot (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g))
  (tr : CwFTrunc.Trunc[l, C, PS, SS, IJ, Un].TruncAt) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module QB = CwFQinv.Qinv[l, C, PS, SS, IJ, NF] ;
  module QC = CwFQinvC.QinvC[l, C, PS, SS, IJ, NF] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;

  -- application respects transports of the function and of the argument
  teApp (G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (a : El G X)
    (X' : Ty G) (PX : Id (Ty G) X X') (Y' : Ty G) (PY : Id (Ty G) Y Y') (f' : El G (Fun G X' Y')) (a' : El G X')
    (tf : IN.TE G (Fun G X Y) (Fun G X' Y') f f') (ea : Id (El G X') (trE G X X' PX a) a')
    : IN.TE G Y Y' (app G X Y f a) (app G X' Y' f' a') =
    idJ (Ty G) X
      (\ X2 PX2 -> (Y2 : Ty G) (PY2 : Id (Ty G) Y Y2) (f2 : El G (Fun G X2 Y2)) (a2 : El G X2)
         -> IN.TE G (Fun G X Y) (Fun G X2 Y2) f f2 -> Id (El G X2) (trE G X X2 PX2 a) a2
         -> IN.TE G Y Y2 (app G X Y f a) (app G X2 Y2 f2 a2))
      (\ Y2 PY2 -> idJ (Ty G) Y
         (\ Y3 PY3 -> (f3 : El G (Fun G X Y3)) (a3 : El G X)
            -> IN.TE G (Fun G X Y) (Fun G X Y3) f f3 -> Id (El G X) a a3
            -> IN.TE G Y Y3 (app G X Y f a) (app G X Y3 f3 a3))
         (\ f3 a3 tf3 ea3 -> (refl Y,
            trans (El G Y) (app G X Y f a) (app G X Y f3 a) (app G X Y f3 a3)
              (ap (El G (Fun G X Y)) (El G Y) (\ h -> app G X Y h a) f f3 (IN.teAny G (Fun G X Y) (Fun G X Y) f f3 tf3 (refl (Fun G X Y))))
              (ap (El G X) (El G Y) (\ z -> app G X Y f3 z) a a3 ea3)))
         Y2 PY2)
      X' PX Y' PY f' a' tf ea ;

  module Q (G : Ctx) (A : Ty G) (r : El G (Fun G A (Fun G A (PU.PropU G)))) {
    PA : Ty G = Fun G A (PU.PropU G) ;
    K : Ctx = ext G PA ;
    AK : Ty K = wkT G PA A ;
    PAK : Ty K = wkT G PA PA ;
    rK : El K (Fun K AK PAK) = EQ.wkF G PA A PA r ;
    -- the fibre of r at the variable P: Sigma (a : A) Id (r a , P)   (CwFQinv.FibE)
    S : Ty K = QB.FibE K AK PAK rK (q G PA) ;
    TrS : Ty K = tr.Tr K S ;
    Qt : Ty G = SS.Sig G PA TrS ;

    ----------------------------------------------------------------
    -- the class map: over D = G.A, at a: (r a , | a , refl |)

    D : Ctx = ext G A ;
    AD : Ty D = wkT G A A ;
    PAd : Ty D = wkT G A PA ;
    ra0 : El D PAd = app D AD PAd (EQ.wkF G A A PA r) (q G A) ;
    sg : Sub D K = extS D G PA (p G A) ra0 ;
    PAs : Id (Ty D) (subT D K AK sg) AD = IN.wkT-extS D G PA A (p G A) ra0 ;
    PPs : Id (Ty D) (subT D K PAK sg) PAd = IN.wkT-extS D G PA PA (p G A) ra0 ;
    av : El D (subT D K AK sg) = trE D AD (subT D K AK sg) (sym (Ty D) (subT D K AK sg) AD PAs) (q G A) ;
    tau : Sub D (ext K AK) = extS D K AK sg av ;
    PA2 : Ty (ext K AK) = wkT K AK PAK ;
    P1 : Id (Ty D) (subT D (ext K AK) PA2 tau) (subT D K PAK sg) = IN.wkT-extS D K AK PAK sg av ;
    PT : Id (Ty D) (subT D (ext K AK) PA2 tau) PAd = trans (Ty D) (subT D (ext K AK) PA2 tau) (subT D K PAK sg) PAd P1 PPs ;
    Pv : El (ext K AK) PA2 = wkE K AK PAK (q G PA) ;
    raK : El (ext K AK) PA2 = app (ext K AK) (wkT K AK AK) PA2 (EQ.wkF K AK AK PAK rK) (q K AK) ;
    -- the variable P at the point is r a
    ovB : Ov D (ext K AK) PA2 tau PAd PT Pv ra0 =
      IN.teAny D (subT D (ext K AK) PA2 tau) PAd (subt D (ext K AK) PA2 Pv tau) ra0
        (IN.teT D (subT D (ext K AK) PA2 tau) (subT D K PAK sg) PAd
           (subt D (ext K AK) PA2 Pv tau) (subt D K PAK (q G PA) sg) ra0
           (P1, IN.wkE-extS D K AK PAK (q G PA) sg av P1)
           (PPs, JP.q-extS D G PA (p G A) ra0 PPs))
        PT ;
    -- r applied to the variable of A, at the point, is r a
    m1 : El D (subT D K PAK sg) = app D (subT D K AK sg) (subT D K PAK sg) (QC.fAl D K sg AK PAK rK) av ;
    eav : Id (El D AD) (trE D (subT D K AK sg) AD PAs av) (q G A) =
      IN.teAny D (subT D K AK sg) AD av (q G A)
        (IN.teS D AD (subT D K AK sg) (q G A) av (IN.teTr D AD (subT D K AK sg) (sym (Ty D) (subT D K AK sg) AD PAs) (q G A))) PAs ;
    tf : IN.TE D (Fun D (subT D K AK sg) (subT D K PAK sg)) (Fun D AD PAd) (QC.fAl D K sg AK PAK rK) (EQ.wkF G A A PA r) =
      IN.teT D (Fun D (subT D K AK sg) (subT D K PAK sg)) (subT D K (Fun K AK PAK) sg) (Fun D AD PAd)
        (QC.fAl D K sg AK PAK rK) (subt D K (Fun K AK PAK) rK sg) (EQ.wkF G A A PA r)
        (IN.teS D (subT D K (Fun K AK PAK) sg) (Fun D (subT D K AK sg) (subT D K PAK sg)) (subt D K (Fun K AK PAK) rK sg) (QC.fAl D K sg AK PAK rK)
           (IN.teTr D (subT D K (Fun K AK PAK) sg) (Fun D (subT D K AK sg) (subT D K PAK sg))
              (Fun-ov D K AK PAK sg (subT D K AK sg) (refl (subT D K AK sg)) (subT D K PAK sg) (refl (subT D K PAK sg)))
              (subt D K (Fun K AK PAK) rK sg)))
        (QC.PFs D G PA A PA (p G A) ra0, QC.wkFAt D G PA A PA r (p G A) ra0) ;
    ovA : Ov D (ext K AK) PA2 tau PAd PT raK ra0 =
      IN.teAny D (subT D (ext K AK) PA2 tau) PAd (subt D (ext K AK) PA2 raK tau) ra0
        (IN.teT D (subT D (ext K AK) PA2 tau) (subT D K PAK sg) PAd (subt D (ext K AK) PA2 raK tau) m1 ra0
           (P1, QC.appVar D K AK PAK rK sg av)
           (teApp D (subT D K AK sg) (subT D K PAK sg) (QC.fAl D K sg AK PAK rK) av AD PAs PAd PPs (EQ.wkF G A A PA r) (q G A) tf eav))
        PT ;
    -- the identity component at the point: refl
    FamT : Ty (ext K AK) = QB.FamE K AK PAK rK (q G PA) ;
    idTy : Id (Ty D) (subT D (ext K AK) FamT tau) (IJ.IdT D PAd ra0 ra0) =
      Id-ov D (ext K AK) PA2 raK Pv tau PAd PT ra0 ra0 ovA ovB ;
    idEl : El D (subT D (ext K AK) FamT tau) =
      trE D (IJ.IdT D PAd ra0 ra0) (subT D (ext K AK) FamT tau)
        (sym (Ty D) (subT D (ext K AK) FamT tau) (IJ.IdT D PAd ra0 ra0) idTy) (IJ.rfl D PAd ra0) ;
    -- the point (a , refl) of the fibre S at (p , r a)
    module PV = SV.At[K, AK, FamT] ;
    pt : Sub D PV.E2 = extS D (ext K AK) FamT tau idEl ;
    ppt : Id (Sub D K) (o D PV.E2 K PV.pp pt) sg =
      trans (Sub D K) (o D PV.E2 K PV.pp pt) (o D (ext K AK) K (p K AK) (o D PV.E2 (ext K AK) PV.p2 pt)) sg
        (o-assoc D PV.E2 (ext K AK) K (p K AK) PV.p2 pt)
        (trans (Sub D K) (o D (ext K AK) K (p K AK) (o D PV.E2 (ext K AK) PV.p2 pt)) (o D (ext K AK) K (p K AK) tau) sg
           (ap (Sub D (ext K AK)) (Sub D K) (\ t -> o D (ext K AK) K (p K AK) t) (o D PV.E2 (ext K AK) PV.p2 pt) tau
              (IN.p-extS D (ext K AK) FamT tau idEl))
           (IN.p-extS D K AK sg av)) ;
    sS : El D (subT D K S sg) =
      trE D (subT D PV.E2 PV.SW pt) (subT D K S sg)
        (trans (Ty D) (subT D PV.E2 PV.SW pt) (subT D K S (o D PV.E2 K PV.pp pt)) (subT D K S sg)
           (sym (Ty D) (subT D K S (o D PV.E2 K PV.pp pt)) (subT D PV.E2 PV.SW pt) (subT-o D PV.E2 K S PV.pp pt))
           (ap (Sub D K) (Ty D) (\ t -> subT D K S t) (o D PV.E2 K PV.pp pt) sg ppt))
        (subt D PV.E2 PV.SW PV.pv pt) ;
    -- its class in the truncation
    tS : El D (subT D K TrS sg) =
      trE D (subT D (ext K S) (wkT K S TrS) (extS D K S sg sS)) (subT D K TrS sg) (IN.wkT-extS D K S TrS sg sS)
        (subt D (ext K S) (wkT K S TrS) (tr.inc K S) (extS D K S sg sS)) ;
    -- the class of a: the pair (r a , tS), read in Q weakened to G.A
    up0 : Sub (ext D PAd) K = upT D G PA (p G A) PAd (refl PAd) ;
    TrS' : Ty (ext D PAd) = subT (ext D PAd) K TrS up0 ;
    QW : Id (Ty D) (wkT G A Qt) (SS.Sig D PAd TrS') = Sig-ov D G PA TrS (p G A) PAd (refl PAd) TrS' (refl TrS') ;
    yT : El D (subT D (ext D PAd) TrS' (sec D PAd ra0)) =
      trE D (subT D K TrS sg) (subT D (ext D PAd) TrS' (sec D PAd ra0)) (subT-o D (ext D PAd) K TrS up0 (sec D PAd ra0)) tS ;
    cls : El D (wkT G A Qt) =
      trE D (SS.Sig D PAd TrS') (wkT G A Qt) (sym (Ty D) (wkT G A Qt) (SS.Sig D PAd TrS') QW) (IN.pr D PAd TrS' ra0 yT) ;
  } ;
} ;
