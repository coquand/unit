-- CwFQuot.seg (canonicity-c2; SIMPLIFIED.md item 3): the quotient of a
-- type by a proposition-valued relation, as the image of
-- A -> (A -> PropU) (Voevodsky), in a CwF with Pi, Sigma, Swan Id, a
-- universe, and a truncation without stability (CwFTrunc.TruncAt).
--
-- Data: A over G and r : A -> (A -> PropU), the relation.
--   PA = A -> PropU ;  K = G.PA, with variable P
--   S  = Sigma (a : A) Id (r a , P)       over K: the fibre of r at P (CwFQinv.FibE),
--        so that CwFQinvC's lemmas for fibres at a point apply
--   Q  = Sigma (P : PA) || S ||           over G
-- One truncation over one context: every use substitutes Tr K S.
open Base ;

module Quot (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g))
  (tr : CwFTrunc.Trunc[l, C, PS, SS, IJ, Un].TruncAt) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module QB = CwFQinv.Qinv[l, C, PS, SS, IJ, NF] ;
  module QC = CwFQinvC.QinvC[l, C, PS, SS, IJ, NF] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module MP = CwFMaps.Maps[l, C, PS, SS, IJ] ;
  module PH = CwFPth.Pth[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;

  -- an element of Id read between equal end points
  idTr (G : Ctx) (X : Ty G) (x x' y y' : El G X) (px : Id (El G X) x x') (py : Id (El G X) y y') (u : El G (IJ.IdT G X x y))
    : El G (IJ.IdT G X x' y') =
    subst (El G X) (\ z -> El G (IJ.IdT G X x' z)) y y' py (subst (El G X) (\ z -> El G (IJ.IdT G X z y)) x x' px u) ;

  -- application respects transports of the function and of the argument
  teApp (G : Ctx) (X Y : Ty G) (f : El G (Fun G X Y)) (a : El G X)
    (X' : Ty G) (PX : Id (Ty G) X X') (Y' : Ty G) (PY : Id (Ty G) Y Y') (f' : El G (Fun G X' Y')) (a' : El G X')
    (tf : IN.TE G (Fun G X Y) (Fun G X' Y') f f') (ea : Id (El G X') (trE G X X' PX a) a')
    : IN.TE G Y Y' (app G X Y f a) (app G X' Y' f' a') =
    idJ (Ty G) X
      (\ X2 PX2 -> (Y2 : Ty G) (PY2 : Id (Ty G) Y Y2) (f2 : El G (Fun G X2 Y2)) (a2 : El G X2)
         -> IN.TE G (Fun G X Y) (Fun G X2 Y2) f f2 -> Id (El G X2) (trE G X X2 PX2 a) a2
         -> IN.TE G Y Y2 (app G X Y f a) (app G X2 Y2 f2 a2))
      (\ Y2 PY2 -> idJ (Ty G) Y
         (\ Y3 PY3 -> (f3 : El G (Fun G X Y3)) (a3 : El G X)
            -> IN.TE G (Fun G X Y) (Fun G X Y3) f f3 -> Id (El G X) a a3
            -> IN.TE G Y Y3 (app G X Y f a) (app G X Y3 f3 a3))
         (\ f3 a3 tf3 ea3 -> (refl Y,
            trans (El G Y) (app G X Y f a) (app G X Y f3 a) (app G X Y f3 a3)
              (ap (El G (Fun G X Y)) (El G Y) (\ h -> app G X Y h a) f f3 (IN.teAny G (Fun G X Y) (Fun G X Y) f f3 tf3 (refl (Fun G X Y))))
              (ap (El G X) (El G Y) (\ z -> app G X Y f3 z) a a3 ea3)))
         Y2 PY2)
      X' PX Y' PY f' a' tf ea ;

  module Q (G : Ctx) (A : Ty G) (r : El G (Fun G A (Fun G A (PU.PropU G)))) {
    PA : Ty G = Fun G A (PU.PropU G) ;
    K : Ctx = ext G PA ;
    AK : Ty K = wkT G PA A ;
    PAK : Ty K = wkT G PA PA ;
    rK : El K (Fun K AK PAK) = EQ.wkF G PA A PA r ;
    -- the fibre of r at the variable P: Sigma (a : A) Id (r a , P)   (CwFQinv.FibE)
    S : Ty K = QB.FibE K AK PAK rK (q G PA) ;
    TrS : Ty K = tr.Tr K S ;
    Qt : Ty G = SS.Sig G PA TrS ;

    ----------------------------------------------------------------
    -- the class map: over D = G.A, at a: (r a , | a , refl |)

    D : Ctx = ext G A ;
    AD : Ty D = wkT G A A ;
    PAd : Ty D = wkT G A PA ;
    ra0 : El D PAd = app D AD PAd (EQ.wkF G A A PA r) (q G A) ;
    sg : Sub D K = extS D G PA (p G A) ra0 ;
    PAs : Id (Ty D) (subT D K AK sg) AD = IN.wkT-extS D G PA A (p G A) ra0 ;
    PPs : Id (Ty D) (subT D K PAK sg) PAd = IN.wkT-extS D G PA PA (p G A) ra0 ;
    av : El D (subT D K AK sg) = trE D AD (subT D K AK sg) (sym (Ty D) (subT D K AK sg) AD PAs) (q G A) ;
    tau : Sub D (ext K AK) = extS D K AK sg av ;
    PA2 : Ty (ext K AK) = wkT K AK PAK ;
    P1 : Id (Ty D) (subT D (ext K AK) PA2 tau) (subT D K PAK sg) = IN.wkT-extS D K AK PAK sg av ;
    PT : Id (Ty D) (subT D (ext K AK) PA2 tau) PAd = trans (Ty D) (subT D (ext K AK) PA2 tau) (subT D K PAK sg) PAd P1 PPs ;
    Pv : El (ext K AK) PA2 = wkE K AK PAK (q G PA) ;
    raK : El (ext K AK) PA2 = app (ext K AK) (wkT K AK AK) PA2 (EQ.wkF K AK AK PAK rK) (q K AK) ;
    -- the variable P at the point is r a
    ovB : Ov D (ext K AK) PA2 tau PAd PT Pv ra0 =
      IN.teAny D (subT D (ext K AK) PA2 tau) PAd (subt D (ext K AK) PA2 Pv tau) ra0
        (IN.teT D (subT D (ext K AK) PA2 tau) (subT D K PAK sg) PAd
           (subt D (ext K AK) PA2 Pv tau) (subt D K PAK (q G PA) sg) ra0
           (P1, IN.wkE-extS D K AK PAK (q G PA) sg av P1)
           (PPs, JP.q-extS D G PA (p G A) ra0 PPs))
        PT ;
    -- r applied to the variable of A, at the point, is r a
    m1 : El D (subT D K PAK sg) = app D (subT D K AK sg) (subT D K PAK sg) (QC.fAl D K sg AK PAK rK) av ;
    eav : Id (El D AD) (trE D (subT D K AK sg) AD PAs av) (q G A) =
      IN.teAny D (subT D K AK sg) AD av (q G A)
        (IN.teS D AD (subT D K AK sg) (q G A) av (IN.teTr D AD (subT D K AK sg) (sym (Ty D) (subT D K AK sg) AD PAs) (q G A))) PAs ;
    tf : IN.TE D (Fun D (subT D K AK sg) (subT D K PAK sg)) (Fun D AD PAd) (QC.fAl D K sg AK PAK rK) (EQ.wkF G A A PA r) =
      IN.teT D (Fun D (subT D K AK sg) (subT D K PAK sg)) (subT D K (Fun K AK PAK) sg) (Fun D AD PAd)
        (QC.fAl D K sg AK PAK rK) (subt D K (Fun K AK PAK) rK sg) (EQ.wkF G A A PA r)
        (IN.teS D (subT D K (Fun K AK PAK) sg) (Fun D (subT D K AK sg) (subT D K PAK sg)) (subt D K (Fun K AK PAK) rK sg) (QC.fAl D K sg AK PAK rK)
           (IN.teTr D (subT D K (Fun K AK PAK) sg) (Fun D (subT D K AK sg) (subT D K PAK sg))
              (Fun-ov D K AK PAK sg (subT D K AK sg) (refl (subT D K AK sg)) (subT D K PAK sg) (refl (subT D K PAK sg)))
              (subt D K (Fun K AK PAK) rK sg)))
        (QC.PFs D G PA A PA (p G A) ra0, QC.wkFAt D G PA A PA r (p G A) ra0) ;
    ovA : Ov D (ext K AK) PA2 tau PAd PT raK ra0 =
      IN.teAny D (subT D (ext K AK) PA2 tau) PAd (subt D (ext K AK) PA2 raK tau) ra0
        (IN.teT D (subT D (ext K AK) PA2 tau) (subT D K PAK sg) PAd (subt D (ext K AK) PA2 raK tau) m1 ra0
           (P1, QC.appVar D K AK PAK rK sg av)
           (teApp D (subT D K AK sg) (subT D K PAK sg) (QC.fAl D K sg AK PAK rK) av AD PAs PAd PPs (EQ.wkF G A A PA r) (q G A) tf eav))
        PT ;
    -- the identity component at the point: refl
    FamT : Ty (ext K AK) = QB.FamE K AK PAK rK (q G PA) ;
    idTy : Id (Ty D) (subT D (ext K AK) FamT tau) (IJ.IdT D PAd ra0 ra0) =
      Id-ov D (ext K AK) PA2 raK Pv tau PAd PT ra0 ra0 ovA ovB ;
    idEl : El D (subT D (ext K AK) FamT tau) =
      trE D (IJ.IdT D PAd ra0 ra0) (subT D (ext K AK) FamT tau)
        (sym (Ty D) (subT D (ext K AK) FamT tau) (IJ.IdT D PAd ra0 ra0) idTy) (IJ.rfl D PAd ra0) ;
    -- the point (a , refl) of the fibre S at (p , r a)
    module PV = SV.At[K, AK, FamT] ;
    pt : Sub D PV.E2 = extS D (ext K AK) FamT tau idEl ;
    ppt : Id (Sub D K) (o D PV.E2 K PV.pp pt) sg =
      trans (Sub D K) (o D PV.E2 K PV.pp pt) (o D (ext K AK) K (p K AK) (o D PV.E2 (ext K AK) PV.p2 pt)) sg
        (o-assoc D PV.E2 (ext K AK) K (p K AK) PV.p2 pt)
        (trans (Sub D K) (o D (ext K AK) K (p K AK) (o D PV.E2 (ext K AK) PV.p2 pt)) (o D (ext K AK) K (p K AK) tau) sg
           (ap (Sub D (ext K AK)) (Sub D K) (\ t -> o D (ext K AK) K (p K AK) t) (o D PV.E2 (ext K AK) PV.p2 pt) tau
              (IN.p-extS D (ext K AK) FamT tau idEl))
           (IN.p-extS D K AK sg av)) ;
    sS : El D (subT D K S sg) =
      trE D (subT D PV.E2 PV.SW pt) (subT D K S sg)
        (trans (Ty D) (subT D PV.E2 PV.SW pt) (subT D K S (o D PV.E2 K PV.pp pt)) (subT D K S sg)
           (sym (Ty D) (subT D K S (o D PV.E2 K PV.pp pt)) (subT D PV.E2 PV.SW pt) (subT-o D PV.E2 K S PV.pp pt))
           (ap (Sub D K) (Ty D) (\ t -> subT D K S t) (o D PV.E2 K PV.pp pt) sg ppt))
        (subt D PV.E2 PV.SW PV.pv pt) ;
    -- its class in the truncation
    tS : El D (subT D K TrS sg) =
      trE D (subT D (ext K S) (wkT K S TrS) (extS D K S sg sS)) (subT D K TrS sg) (IN.wkT-extS D K S TrS sg sS)
        (subt D (ext K S) (wkT K S TrS) (tr.inc K S) (extS D K S sg sS)) ;
    -- the class of a: the pair (r a , tS), read in Q weakened to G.A
    up0 : Sub (ext D PAd) K = upT D G PA (p G A) PAd (refl PAd) ;
    TrS' : Ty (ext D PAd) = subT (ext D PAd) K TrS up0 ;
    QW : Id (Ty D) (wkT G A Qt) (SS.Sig D PAd TrS') = Sig-ov D G PA TrS (p G A) PAd (refl PAd) TrS' (refl TrS') ;
    yT : El D (subT D (ext D PAd) TrS' (sec D PAd ra0)) =
      trE D (subT D K TrS sg) (subT D (ext D PAd) TrS' (sec D PAd ra0)) (subT-o D (ext D PAd) K TrS up0 (sec D PAd ra0)) tS ;
    cls : El D (wkT G A Qt) =
      trE D (SS.Sig D PAd TrS') (wkT G A Qt) (sym (Ty D) (wkT G A Qt) (SS.Sig D PAd TrS') QW) (IN.pr D PAd TrS' ra0 yT) ;

    ----------------------------------------------------------------
    -- at a global element a of A: the class of a, and r a
    rAt (a : El G A) : El G PA = app G A PA r a ;
    clsG (a : El G A) : El G Qt =
      trE G (subT G D (wkT G A Qt) (sec G A a)) Qt (p-sec-T G A Qt a) (subt G D (wkT G A Qt) cls (sec G A a)) ;
    -- the relation at two global elements, as a type: the decoding of r a b
    relP (a b : El G A) : El G (PU.PropU G) = app G A (PU.PropU G) (rAt a) b ;
    Rel (a b : El G A) : Ty G = PU.DecP G (relP a b) ;
    relProp (a b : El G A) : El G (PU.isProp G (Rel a b)) = PU.decProp G (relP a b) ;

    ----------------------------------------------------------------
    -- the first component of the class of a is r a
    module FC (a : El G A) {
      sa : Sub G D = sec G A a ;
      PX : Id (Ty G) (subT G D PAd sa) PA = p-sec-T G A PA a ;
      upS : Sub (ext G PA) (ext D PAd) = upT G D PAd sa PA PX ;
      PXi : Id (Ty G) (subT G D PAd sa) (subT G G PA (id G)) =
        trans (Ty G) (subT G D PAd sa) PA (subT G G PA (id G)) PX (sym (Ty G) (subT G G PA (id G)) PA (subT-id G PA)) ;
      F (X : Ty G) : U l = Sub (ext G X) (ext D PAd) ;
      L0 : F (subT G D PAd sa) = lift G D PAd sa ;
      PXt : Id (Ty G) (subT G D PAd sa) PA = trans (Ty G) (subT G D PAd sa) (subT G G PA (id G)) PA PXi (subT-id G PA) ;
      -- upS as a transport in two steps
      e1 : Id (Sub (ext G PA) (ext D PAd)) upS
             (subst (Ty G) F (subT G G PA (id G)) PA (subT-id G PA) (upT G D PAd sa (subT G G PA (id G)) PXi)) =
        trans (Sub (ext G PA) (ext D PAd)) upS (subst (Ty G) F (subT G D PAd sa) PA PXt L0)
          (subst (Ty G) F (subT G G PA (id G)) PA (subT-id G PA) (upT G D PAd sa (subT G G PA (id G)) PXi))
          (ap (Id (Ty G) (subT G D PAd sa) PA) (Sub (ext G PA) (ext D PAd)) (\ P -> subst (Ty G) F (subT G D PAd sa) PA P L0) PX PXt
             (isSetTy G (subT G D PAd sa) PA PX PXt))
          (idJ (Ty G) (subT G G PA (id G))
             (\ X Qx -> Id (F X)
                  (subst (Ty G) F (subT G D PAd sa) X (trans (Ty G) (subT G D PAd sa) (subT G G PA (id G)) X PXi Qx) L0)
                  (subst (Ty G) F (subT G G PA (id G)) X Qx (subst (Ty G) F (subT G D PAd sa) (subT G G PA (id G)) PXi L0)))
             (refl (subst (Ty G) F (subT G D PAd sa) (subT G G PA (id G)) PXi L0))
             PA (subT-id G PA)) ;
      -- the lift of p after the lifted section is the identity
      upId : Id (Sub (ext G PA) (ext G PA)) (o (ext G PA) (ext D PAd) (ext G PA) up0 upS) (id (ext G PA)) =
        trans (Sub (ext G PA) (ext G PA)) (o (ext G PA) (ext D PAd) (ext G PA) up0 upS)
          (o (ext G PA) (ext D PAd) (ext G PA) up0 (subst (Ty G) F (subT G G PA (id G)) PA (subT-id G PA) (upT G D PAd sa (subT G G PA (id G)) PXi)))
          (id (ext G PA))
          (ap (Sub (ext G PA) (ext D PAd)) (Sub (ext G PA) (ext G PA)) (\ t -> o (ext G PA) (ext D PAd) (ext G PA) up0 t) upS
             (subst (Ty G) F (subT G G PA (id G)) PA (subT-id G PA) (upT G D PAd sa (subT G G PA (id G)) PXi)) e1)
          (trans (Sub (ext G PA) (ext G PA))
             (o (ext G PA) (ext D PAd) (ext G PA) up0 (subst (Ty G) F (subT G G PA (id G)) PA (subT-id G PA) (upT G D PAd sa (subT G G PA (id G)) PXi)))
             (subst (Ty G) (\ X -> Sub (ext G X) (ext G PA)) (subT G G PA (id G)) PA (subT-id G PA)
                (o (ext G (subT G G PA (id G))) (ext D PAd) (ext G PA) up0 (upT G D PAd sa (subT G G PA (id G)) PXi)))
             (id (ext G PA))
             (SV.substPost G D G PAd PA (subT G G PA (id G)) PA (subT-id G PA) up0 (upT G D PAd sa (subT G G PA (id G)) PXi))
             (trans (Sub (ext G PA) (ext G PA))
                (subst (Ty G) (\ X -> Sub (ext G X) (ext G PA)) (subT G G PA (id G)) PA (subT-id G PA)
                   (o (ext G (subT G G PA (id G))) (ext D PAd) (ext G PA) up0 (upT G D PAd sa (subT G G PA (id G)) PXi)))
                (subst (Ty G) (\ X -> Sub (ext G X) (ext G PA)) (subT G G PA (id G)) PA (subT-id G PA) (lift G G PA (id G)))
                (id (ext G PA))
                (ap (Sub (ext G (subT G G PA (id G))) (ext G PA)) (Sub (ext G PA) (ext G PA))
                   (\ t -> subst (Ty G) (\ X -> Sub (ext G X) (ext G PA)) (subT G G PA (id G)) PA (subT-id G PA) t)
                   (o (ext G (subT G G PA (id G))) (ext D PAd) (ext G PA) up0 (upT G D PAd sa (subT G G PA (id G)) PXi))
                   (lift G G PA (id G))
                   (SV.liftComp G D G PA (p G A) sa (id G) (p-sec G A a) PXi))
                (lift-id G PA))) ;
      PBs : Id (Ty (ext G PA)) (subT (ext G PA) (ext D PAd) TrS' upS) TrS =
        trans (Ty (ext G PA)) (subT (ext G PA) (ext D PAd) TrS' upS) (subT (ext G PA) K TrS (o (ext G PA) (ext D PAd) K up0 upS)) TrS
          (sym (Ty (ext G PA)) (subT (ext G PA) K TrS (o (ext G PA) (ext D PAd) K up0 upS)) (subT (ext G PA) (ext D PAd) TrS' upS)
             (subT-o (ext G PA) (ext D PAd) K TrS up0 upS))
          (trans (Ty (ext G PA)) (subT (ext G PA) K TrS (o (ext G PA) (ext D PAd) K up0 upS)) (subT K K TrS (id K)) TrS
             (ap (Sub (ext G PA) K) (Ty (ext G PA)) (\ t -> subT (ext G PA) K TrS t) (o (ext G PA) (ext D PAd) K up0 upS) (id K) upId)
             (subT-id K TrS)) ;
      SD : Ty D = SS.Sig D PAd TrS' ;
      PWs : Id (Ty G) (subT G D SD sa) Qt = Sig-ov G D PAd TrS' sa PA PX TrS PBs ;
      wD : El D SD = IN.pr D PAd TrS' ra0 yT ;
      Pw : Ov G D SD sa Qt PWs wD (clsG a) =
        IN.teAny G (subT G D SD sa) Qt (subt G D SD wD sa) (clsG a)
          (IN.teT G (subT G D SD sa) (subT G D (wkT G A Qt) sa) Qt (subt G D SD wD sa) (subt G D (wkT G A Qt) cls sa) (clsG a)
             (SV.teSub G D SD (wkT G A Qt) wD cls
                (IN.teTr D SD (wkT G A Qt) (sym (Ty D) (wkT G A Qt) SD QW) wD) sa)
             (IN.teTr G (subT G D (wkT G A Qt) sa) Qt (p-sec-T G A Qt a) (subt G D (wkT G A Qt) cls sa)))
          PWs ;
      f1 : Ov G D PAd sa PA PX (IN.fst D PAd TrS' wD) (IN.fst G PA TrS (clsG a)) =
        IN.fst-ov G D PAd TrS' sa PA PX TrS PBs PWs wD (clsG a) Pw ;
      PAa : Id (Ty G) (subT G D AD sa) A = p-sec-T G A A a ;
      PFa : Id (Ty G) (subT G D (Fun D AD PAd) sa) (Fun G A PA) = Fun-ov G D AD PAd sa A PAa PA PX ;
      f3 : Ov G D PAd sa PA PX ra0 (rAt a) =
        app-ov G D AD PAd sa A PAa PA PX PFa (EQ.wkF G A A PA r) r (IN.wkF-sec G A A PA a r PFa)
          (q G A) a (IN.q-secO G A a PAa) ;
      fst-cls : Id (El G PA) (IN.fst G PA TrS (clsG a)) (rAt a) =
        trans (El G PA) (IN.fst G PA TrS (clsG a)) (trE G (subT G D PAd sa) PA PX (subt G D PAd (IN.fst D PAd TrS' wD) sa)) (rAt a)
          (sym (El G PA) (trE G (subT G D PAd sa) PA PX (subt G D PAd (IN.fst D PAd TrS' wD) sa)) (IN.fst G PA TrS (clsG a)) f1)
          (trans (El G PA) (trE G (subT G D PAd sa) PA PX (subt G D PAd (IN.fst D PAd TrS' wD) sa))
             (trE G (subT G D PAd sa) PA PX (subt G D PAd ra0 sa)) (rAt a)
             (ap (El D PAd) (El G PA) (\ v -> trE G (subT G D PAd sa) PA PX (subt G D PAd v sa)) (IN.fst D PAd TrS' wD) ra0
                (IN.fst-pr D PAd TrS' ra0 yT))
             f3) ;
    } ;
    fst-cls (a : El G A) : Id (El G PA) (IN.fst G PA TrS (clsG a)) (rAt a) = FC[a].fst-cls ;

    ----------------------------------------------------------------
    -- effectiveness at global elements: equal classes are related.
    -- From Id (cls a , cls b): ap of the first projection, then of the
    -- evaluation at b, then of the code; R b b moved along the resulting
    -- path of codes is R a b.
    -- (the second half: from Id (r b , r a), for the eliminators)
    module EffP (reflR : (b : El G A) -> El G (Rel b b)) (a b : El G A) (e1 : El G (IJ.IdT G PA (rAt b) (rAt a))) {
      module F2 = MP.EvF[G, A, PU.PropU G, b] ;
      module F3 = MP.FstF[G, Un.Cod G, PU.PropFam G] ;
      e2 : El G (IJ.IdT G (PU.PropU G) (relP b b) (relP a b)) =
        idTr G (PU.PropU G) (app G PA (PU.PropU G) F2.evF (rAt b)) (relP b b) (app G PA (PU.PropU G) F2.evF (rAt a)) (relP a b)
          F2.At[rAt b].val F2.At[rAt a].val
          (MP.apF G PA (PU.PropU G) F2.evF (rAt b) (rAt a) e1) ;
      cb : El G (Un.Cod G) = PU.codeOf G (relP b b) ;
      ca : El G (Un.Cod G) = PU.codeOf G (relP a b) ;
      e3 : El G (IJ.IdT G (Un.Cod G) cb ca) =
        idTr G (Un.Cod G) (app G (PU.PropU G) (Un.Cod G) F3.fstF (relP b b)) cb (app G (PU.PropU G) (Un.Cod G) F3.fstF (relP a b)) ca
          F3.At[relP b b].val F3.At[relP a b].val
          (MP.apF G (PU.PropU G) (Un.Cod G) F3.fstF (relP b b) (relP a b) e2) ;
      DQ : Ty (ext G (Un.Cod G)) = Un.Dec (ext G (Un.Cod G)) (PU.UU.qc G) ;
      vb : El G (subT G (ext G (Un.Cod G)) DQ (sec G (Un.Cod G) cb)) =
        trE G (Rel b b) (subT G (ext G (Un.Cod G)) DQ (sec G (Un.Cod G) cb))
          (sym (Ty G) (subT G (ext G (Un.Cod G)) DQ (sec G (Un.Cod G) cb)) (Rel b b) (PU.DecQ-pt G cb)) (reflR b) ;
      res : El G (Rel a b) =
        trE G (subT G (ext G (Un.Cod G)) DQ (sec G (Un.Cod G) ca)) (Rel a b) (PU.DecQ-pt G ca)
          (TR.trP G (Un.Cod G) DQ cb ca e3 vb) ;
    } ;
    module Eff (reflR : (b : El G A) -> El G (Rel b b)) (a b : El G A) (e : El G (IJ.IdT G Qt (clsG a) (clsG b))) {
      module F1 = MP.FstF[G, PA, TrS] ;
      es : El G (IJ.IdT G Qt (clsG b) (clsG a)) = PH.symM G Qt (clsG a) (clsG b) e ;
      v1 (x : El G A) : Id (El G PA) (app G Qt PA F1.fstF (clsG x)) (rAt x) =
        trans (El G PA) (app G Qt PA F1.fstF (clsG x)) (IN.fst G PA TrS (clsG x)) (rAt x) F1.At[clsG x].val (fst-cls x) ;
      e1 : El G (IJ.IdT G PA (rAt b) (rAt a)) =
        idTr G PA (app G Qt PA F1.fstF (clsG b)) (rAt b) (app G Qt PA F1.fstF (clsG a)) (rAt a) (v1 b) (v1 a)
          (MP.apF G Qt PA F1.fstF (clsG b) (clsG a) es) ;
      res : El G (Rel a b) = EffP[reflR, a, b, e1].res ;
    } ;
    eff (reflR : (b : El G A) -> El G (Rel b b)) (a b : El G A) (e : El G (IJ.IdT G Qt (clsG a) (clsG b))) : El G (Rel a b) =
      Eff[reflR, a, b, e].res ;
    effP (reflR : (b : El G A) -> El G (Rel b b)) (a b : El G A) (e1 : El G (IJ.IdT G PA (rAt b) (rAt a))) : El G (Rel a b) =
      EffP[reflR, a, b, e1].res ;
  } ;
} ;
