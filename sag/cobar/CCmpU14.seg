-- CCmpU14.seg (canonicity-c2; (K) for cmpI, part 14): tools for the
-- generator cases of (U): readings of x1, x2; moving an Id of the two
-- evaluation maps along an Id of closed classes (Gen).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
-- rewriting the endpoints of an internal Id along pointwise equalities
rwId (G : C.Ctx) (T : C.Ty G) (x x' y y' : C.El G T)
  (px : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (x.eob K w) (x'.eob K w))
  (py : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (y.eob K w) (y'.eob K w))
  (p : C.El G (IJ.IdT G T x y)) : C.El G (IJ.IdT G T x' y') =
 subst (C.El G T) (\ u -> C.El G (IJ.IdT G T x' u)) y y' (L.el-ext G T.1 y y' py)
  (subst (C.El G T) (\ u -> C.El G (IJ.IdT G T u y)) x x' (L.el-ext G T.1 x x' px) p) ;
module U14 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module U13m = CCmpU13[a].U13[R, encK, pe, y] ;
 module U9m = U13m.U9m ;
 module CI = U9m.CI ;
 module H1 = CI.Q1.FM.P.H ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = U13m.GH ;
 c1 : C.El Nl H1.AS.Qt = H1.AS.AX.cls (var (inr tt)) ;
 module U12m = CCmpU12[a].U12[R, encK, pe, y, c1] ;
 module U11m = U12m.U11m ;
 -- the reading of x1, x2
 x1rd (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (U11m.HTh.1.tob K w)) (U11m.x1.eob K w) (CI.nmap.nfun K w.1 w.2.1) =
  transH (CAppRd[a].trE-rd GH U11m.Hs U11m.HTh U11m.PH U11m.j1 K w)
   (transH (CAppRd[a].same-rd GH U11m.Hs U11m.HTh U11m.PH K w (refl (U11m.HTh.1.tob K w)) (U11m.j1.eob K w))
      (U9m.A1.rd K (U9m.sgN K w))) ;
 x2rd (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (U11m.HTh.1.tob K w)) (U11m.x2.eob K w) (CI.nmap.nfun K w.1 w.2.2.1) =
  transH (CAppRd[a].trE-rd GH U11m.Hs U11m.HTh U11m.PH U11m.j2 K w)
   (transH (CAppRd[a].same-rd GH U11m.Hs U11m.HTh U11m.PH K w (refl (U11m.HTh.1.tob K w)) (U11m.j2.eob K w))
      (U9m.A2.rd K (U9m.sgN K w))) ;
 HTh : C.Ty GH = U11m.HTh ;
 QYh : C.Ty GH = U11m.QYh ;
 -- moving an Id of closed classes along the beta of Phi
 QA : C.Ty Nl = U13m.QA ;
 QH : C.Ty GH = U13m.QH ;
 H : C.Ty Nl = U9m.H ;
 module Gen (cp cv : C.El Nl QA) (bt : C.El Nl (IJ.IdT Nl QA cp cv)) (g : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC cp) (U13m.ZB.apC cp))) {
  wid : C.El GH (IJ.IdT GH QH (OV.wkE Nl H QA cp) (OV.wkE Nl H QA cv)) =
   OV.trE GH (C.subT GH Nl (IJ.IdT Nl QA cp cv) (C.p Nl H)) (IJ.IdT GH QH (OV.wkE Nl H QA cp) (OV.wkE Nl H QA cv))
     (IJ.IdT-nat GH Nl QA cp cv (C.p Nl H)) (C.subt GH Nl (IJ.IdT Nl QA cp cv) bt (C.p Nl H)) ;
  atA (c : C.El Nl QA) : C.El GH QYh = PT.atv GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZA.fC) (OV.wkE Nl H QA c) ;
  rdA (c : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) ((atA c).eob K w) ((U13m.ZA.apC c).eob K w) =
   transH (CAppRd[a].trE-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
            (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c))
            (C.subt GH (C.ext GH QH) (OV.wkT GH QH QYh) (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZA.fC) (C.sec GH QH (OV.wkE Nl H QA c))) K w)
    (transH (CAppRd[a].same-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
              (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c)) K w (refl (QYh.1.tob K w))
              ((OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZA.fC).eob K (w, c.eob K w.1)))
      (transH (QinvEq[a, a+].FunOf[GH, QH, QYh, U13m.ZA.nm].bod-eq K (w, c.eob K w.1)) (symH (U13m.ZA.rdF c K w)))) ;
  aA : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC cp) (U13m.ZA.apC cv)) =
   rwId GH QYh (atA cp) (U13m.ZA.apC cp) (atA cv) (U13m.ZA.apC cv) (rdA cp) (rdA cv)
    (PT.apM GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZA.fC) (OV.wkE Nl H QA cp) (OV.wkE Nl H QA cv) wid) ;
  atB (c : C.El Nl QA) : C.El GH QYh = PT.atv GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZB.fC) (OV.wkE Nl H QA c) ;
  rdB (c : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) ((atB c).eob K w) ((U13m.ZB.apC c).eob K w) =
   transH (CAppRd[a].trE-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
            (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c))
            (C.subt GH (C.ext GH QH) (OV.wkT GH QH QYh) (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZB.fC) (C.sec GH QH (OV.wkE Nl H QA c))) K w)
    (transH (CAppRd[a].same-rd GH (C.subT GH (C.ext GH QH) (OV.wkT GH QH QYh) (C.sec GH QH (OV.wkE Nl H QA c))) QYh
              (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH QH QYh (OV.wkE Nl H QA c)) K w (refl (QYh.1.tob K w))
              ((OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZB.fC).eob K (w, c.eob K w.1)))
      (transH (QinvEq[a, a+].FunOf[GH, QH, QYh, U13m.ZB.nm].bod-eq K (w, c.eob K w.1)) (symH (U13m.ZB.rdF c K w)))) ;
  aB : C.El GH (IJ.IdT GH QYh (U13m.ZB.apC cp) (U13m.ZB.apC cv)) =
   rwId GH QYh (atB cp) (U13m.ZB.apC cp) (atB cv) (U13m.ZB.apC cv) (rdB cp) (rdB cv)
    (PT.apM GH QH QYh (OV.bod GH QH (OV.wkT GH QH QYh) U13m.ZB.fC) (OV.wkE Nl H QA cp) (OV.wkE Nl H QA cv) wid) ;
  res : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC cv) (U13m.ZB.apC cv)) =
   PT.transM GH QYh (U13m.ZA.apC cv) (U13m.ZA.apC cp) (U13m.ZB.apC cv)
    (PT.symM GH QYh (U13m.ZA.apC cp) (U13m.ZA.apC cv) aA)
    (PT.transM GH QYh (U13m.ZA.apC cp) (U13m.ZB.apC cp) (U13m.ZB.apC cv) g aB) ;
 } ;
} ;
