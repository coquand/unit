-- CTrips.seg (canonicity-45; COBAR.md "comparison"): c2's two round trips
-- of the evaluation at the generator (CEv8: ret, secR) read as path
-- homotopies inv . ev ~ id on HomT(F1, y') and ev . inv ~ id on Q_y'
-- (CContrEq.IdRd): CRead.Trips's parameters eta and eps.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module TR (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module RD = CRead[a].RD[R, encK, pe, y'] ;
 module E8 = CEv8[a].E8[R, encK, pe, y'] ;
 module E6 = CEv6[a].E6[R, encK, pe, y'] ;
 Nl : L.PCtx = RD.Nl ;
 link (W : Ob) (o : V1.Ix (Nl.ob W)) (q : V1.Ix (RD.Qc.tob W o)) : Id (V1.Ix (RD.HT.1.tob W o)) (E6.invB.eob W (o, q)) (RD.PH.invN.nfun W o q) =
  refl (E6.invB.eob W (o, q)) ;
 module ET = CContrEq[a, a+].IdRd[Nl, RD.HT, RD.HO.compN Nl RD.HT.1 RD.Qc RD.HT.1 RD.evN RD.PH.invN, E8.t1,
   \ W z -> E8.t1v W z, E8.ret] ;
 eta : L.PEl[L.extP Nl RD.HT.1, RD.HO.HT[Nl, RD.HT.1, RD.HT.1, RD.HO.compN Nl RD.HT.1 RD.Qc RD.HT.1 RD.evN RD.PH.invN, RD.HO.idN Nl RD.HT.1].PT.PathP] = ET.res ;
 module EP = CContrEq[a, a+].IdRd[Nl, RD.E1v.QY, RD.HO.compN Nl RD.Qc RD.HT.1 RD.Qc RD.PH.invN RD.evN, E8.t2,
   \ W z -> E8.t2v W z, E8.secR] ;
 eps : L.PEl[L.extP Nl RD.Qc, RD.HO.HT[Nl, RD.Qc, RD.Qc, RD.HO.compN Nl RD.Qc RD.HT.1 RD.Qc RD.PH.invN RD.evN, RD.HO.idN Nl RD.Qc].PT.PathP] = EP.res ;
 -- the constants' reading
 module TP = RD.Trips[eta, eps] ;
} ;
