-- CTotUExt.seg (canonicity-c2; SIMPLIFIED.md item 5): towards "U of a
-- fibration of the total site is a levelwise fibration".
-- A total map k : Z -> Y factors as a vertical map vp k : Z -> lf k
-- followed by the image of a levelwise map cl k : lf k -> Y, initially
-- (parameters vp, vp1, vp-eq, ini: canonicity-45's factorisation).  Hence
--   ext    a line of U G at Y in the levelwise site (a family over the
--          levelwise maps) extends to a line of G at Y in the total site:
--          ext x (k, i) = (vp k)^* (x (cl k, i)); it is natural (enat).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module UExt (C : CIntCat[a, vl].IC) {
 module R1 = CTotRFib[a, vl, l].RFib[C] ;
 module TR = R1.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;
 lf (Y : Ob0) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) : Ob0 = (Z.1, C.res Z.1 Y.1 k.1 Y.2) ;
 cl (Y : Ob0) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) : RN.Hom0 (lf Y Z k) Y = (k.1, refl (C.res Z.1 Y.1 k.1 Y.2)) ;

 module Fact
  (vp : (Y : Ob0) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) -> RN.Hom1 Z (RN.o (lf Y Z k)))
  (vp1 : (Y : Ob0) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) -> Id (Hom Z.1 Z.1) (vp Y Z k).1 (idH Z.1))
  (vp-eq : (Y : Ob0) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y))
     -> Id (RN.Hom1 Z (RN.o Y)) (G1.GB.BC.oC Z (RN.o (lf Y Z k)) (RN.o Y) (TR.fn.onH (lf Y Z k) Y (cl Y Z k)) (vp Y Z k)) k)
  (ini : (Y Y' : Ob0) (Z : Ob1) (c : RN.Hom0 Y' Y) (v : RN.Hom1 Z (RN.o Y')) (k : RN.Hom1 Z (RN.o Y))
     (e : Id (RN.Hom1 Z (RN.o Y)) (G1.GB.BC.oC Z (RN.o Y') (RN.o Y) (TR.fn.onH Y' Y c) v) k)
     -> (d : RN.Hom0 (lf Y Z k) Y') * (Id (RN.Hom0 (lf Y Z k) Y) (G0.GB.BC.oC (lf Y Z k) Y' Y c d) (cl Y Z k))
        * (Id (RN.Hom1 Z (RN.o Y')) (G1.GB.BC.oC Z (RN.o (lf Y Z k)) (RN.o Y') (TR.fn.onH (lf Y Z k) Y' d) (vp Y Z k)) v)) {

  -- the comparison of the factorisations of k and of k . g
  module Nt (Y : Ob0) (Z W : Ob1) (g : RN.Hom1 W Z) (k : RN.Hom1 Z (RN.o Y)) {
   kg : RN.Hom1 W (RN.o Y) = G1.GB.BC.oC W Z (RN.o Y) k g ;
   L : Ob0 = lf Y Z k ;
   L' : Ob0 = lf Y W kg ;
   v : RN.Hom1 W (RN.o L) = G1.GB.BC.oC W Z (RN.o L) (vp Y Z k) g ;
   e : Id (RN.Hom1 W (RN.o Y)) (G1.GB.BC.oC W (RN.o L) (RN.o Y) (TR.fn.onH L Y (cl Y Z k)) v) kg =
    trans (RN.Hom1 W (RN.o Y)) (G1.GB.BC.oC W (RN.o L) (RN.o Y) (TR.fn.onH L Y (cl Y Z k)) v)
      (G1.GB.BC.oC W Z (RN.o Y) (G1.GB.BC.oC Z (RN.o L) (RN.o Y) (TR.fn.onH L Y (cl Y Z k)) (vp Y Z k)) g) kg
     (symH (G1.GB.BC.oC-assoc W Z (RN.o L) (RN.o Y) (TR.fn.onH L Y (cl Y Z k)) (vp Y Z k) g))
     (ap (RN.Hom1 Z (RN.o Y)) (RN.Hom1 W (RN.o Y)) (\ w -> G1.GB.BC.oC W Z (RN.o Y) w g)
        (G1.GB.BC.oC Z (RN.o L) (RN.o Y) (TR.fn.onH L Y (cl Y Z k)) (vp Y Z k)) k (vp-eq Y Z k)) ;
   d : RN.Hom0 L' L = (ini Y L W (cl Y Z k) v kg e).1 ;
   d-cl : Id (RN.Hom0 L' Y) (G0.GB.BC.oC L' L Y (cl Y Z k) d) (cl Y W kg) = (ini Y L W (cl Y Z k) v kg e).2.1 ;
   d-vp : Id (RN.Hom1 W (RN.o L)) (G1.GB.BC.oC W (RN.o L') (RN.o L) (TR.fn.onH L' L d) (vp Y W kg)) v = (ini Y L W (cl Y Z k) v kg e).2.2 ;
   -- the base part of d is that of g
   d1 : Id (Hom W.1 Z.1) d.1 g.1 =
    trans (Hom W.1 Z.1) d.1 (compH W.1 W.1 Z.1 d.1 (vp Y W kg).1) g.1
     (trans (Hom W.1 Z.1) d.1 (compH W.1 W.1 Z.1 d.1 (idH W.1)) (compH W.1 W.1 Z.1 d.1 (vp Y W kg).1)
        (symH (comp-idr W.1 Z.1 d.1))
        (ap (Hom W.1 W.1) (Hom W.1 Z.1) (\ w -> compH W.1 W.1 Z.1 d.1 w) (idH W.1) (vp Y W kg).1 (symH (vp1 Y W kg))))
     (trans (Hom W.1 Z.1) (compH W.1 W.1 Z.1 d.1 (vp Y W kg).1) (compH W.1 Z.1 Z.1 (vp Y Z k).1 g.1) g.1
        (ap (RN.Hom1 W (RN.o L)) (Hom W.1 Z.1) (\ w -> w.1) (G1.GB.BC.oC W (RN.o L') (RN.o L) (TR.fn.onH L' L d) (vp Y W kg)) v d-vp)
        (trans (Hom W.1 Z.1) (compH W.1 Z.1 Z.1 (vp Y Z k).1 g.1) (compH W.1 Z.1 Z.1 (idH Z.1) g.1) g.1
           (ap (Hom Z.1 Z.1) (Hom W.1 Z.1) (\ w -> compH W.1 Z.1 Z.1 w g.1) (vp Y Z k).1 (idH Z.1) (vp1 Y Z k))
           (comp-idl W.1 Z.1 g.1))) ;
  } ;

  -- the extension of lines of a context
  module XG (G : P1.PCtx) {
   module RH = R1.Rho[G] ;
   UG : P0.PCtx = RS.rC G ;
   Pt (X : Ob1) : U l = W0.Ix (G.ob X) ;
   efam (Y : Ob0) (x : W0.Ix (RH.F0.ob Y)) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) (i : G1.GB.IvP Z) : Pt Z =
    G.act Z (RN.o (lf Y Z k)) (vp Y Z k) (x.1 (lf Y Z k) (cl Y Z k) i) ;
   module EN (Y : Ob0) (x : W0.Ix (RH.F0.ob Y)) (W Z : Ob1) (g : RN.Hom1 W Z) (k : RN.Hom1 Z (RN.o Y)) (i : G1.GB.IvP Z) {
    module N = Nt[Y, Z, W, g, k] ;
    a0 : Pt (RN.o N.L) = x.1 N.L (cl Y Z k) i ;
    s1 : Id (Pt W) (G.act W Z g (efam Y x Z k i)) (G.act W (RN.o N.L) N.v a0) = symH (G.act-o W Z (RN.o N.L) (vp Y Z k) g a0) ;
    s2 : Id (Pt W) (G.act W (RN.o N.L) N.v a0) (G.act W (RN.o N.L') (vp Y W N.kg) (UG.act N.L' N.L N.d a0)) =
     trans (Pt W) (G.act W (RN.o N.L) N.v a0)
       (G.act W (RN.o N.L) (G1.GB.BC.oC W (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) (vp Y W N.kg)) a0)
       (G.act W (RN.o N.L') (vp Y W N.kg) (UG.act N.L' N.L N.d a0))
      (ap (RN.Hom1 W (RN.o N.L)) (Pt W) (\ w -> G.act W (RN.o N.L) w a0) N.v
         (G1.GB.BC.oC W (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) (vp Y W N.kg)) (symH N.d-vp))
      (G.act-o W (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) (vp Y W N.kg) a0) ;
    s3 : Id (Pt (RN.o N.L')) (UG.act N.L' N.L N.d a0) (x.1 N.L' (cl Y W N.kg) (G1.GB.ivA W Z g i)) =
     trans (Pt (RN.o N.L')) (UG.act N.L' N.L N.d a0) (x.1 N.L' (G0.GB.BC.oC N.L' N.L Y (cl Y Z k) N.d) (G0.GB.ivA N.L' N.L N.d i))
       (x.1 N.L' (cl Y W N.kg) (G1.GB.ivA W Z g i))
      (x.2 N.L' N.L N.d (cl Y Z k) i)
      (trans (Pt (RN.o N.L')) (x.1 N.L' (G0.GB.BC.oC N.L' N.L Y (cl Y Z k) N.d) (G0.GB.ivA N.L' N.L N.d i))
         (x.1 N.L' (cl Y W N.kg) (G0.GB.ivA N.L' N.L N.d i)) (x.1 N.L' (cl Y W N.kg) (G1.GB.ivA W Z g i))
        (ap (RN.Hom0 N.L' Y) (Pt (RN.o N.L')) (\ w -> x.1 N.L' w (G0.GB.ivA N.L' N.L N.d i)) (G0.GB.BC.oC N.L' N.L Y (cl Y Z k) N.d) (cl Y W N.kg) N.d-cl)
        (ap (Hom W.1 Z.1) (Pt (RN.o N.L')) (\ w -> x.1 N.L' (cl Y W N.kg) (G1.PB.ivA W.1 Z.1 w i)) N.d.1 g.1 N.d1)) ;
    nat : Id (Pt W) (G.act W Z g (efam Y x Z k i)) (efam Y x W (G1.GB.BC.oC W Z (RN.o Y) k g) (G1.GB.ivA W Z g i)) =
     trans (Pt W) (G.act W Z g (efam Y x Z k i)) (G.act W (RN.o N.L) N.v a0) (efam Y x W N.kg (G1.GB.ivA W Z g i)) s1
      (trans (Pt W) (G.act W (RN.o N.L) N.v a0) (G.act W (RN.o N.L') (vp Y W N.kg) (UG.act N.L' N.L N.d a0)) (efam Y x W N.kg (G1.GB.ivA W Z g i)) s2
         (ap (Pt (RN.o N.L')) (Pt W) (\ w -> G.act W (RN.o N.L') (vp Y W N.kg) w) (UG.act N.L' N.L N.d a0) (x.1 N.L' (cl Y W N.kg) (G1.GB.ivA W Z g i)) s3)) ;
   } ;
   extV (Y : Ob0) (x : W0.Ix (RH.F0.ob Y)) : W0.Ix (RH.F1.ob (RN.o Y)) =
    (efam Y x, \ W Z g k i -> EN[Y, x, W, Z, g, k, i].nat) ;
   -- restricted to the levelwise maps, the extension is the given line
   module RE (Y : Ob0) (x : W0.Ix (RH.F0.ob Y)) (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.IvP Z) {
    k : RN.Hom1 (RN.o Z) (RN.o Y) = TR.fn.onH Z Y h ;
    L : Ob0 = lf Y (RN.o Z) k ;
    id1 : RN.Hom1 (RN.o Z) (RN.o Z) = G1.GB.BC.idC (RN.o Z) ;
    d : RN.Hom0 L Z = (ini Y Z (RN.o Z) h id1 k (G1.GB.BC.oC-idr (RN.o Z) (RN.o Y) k)).1 ;
    d-cl : Id (RN.Hom0 L Y) (G0.GB.BC.oC L Z Y h d) (cl Y (RN.o Z) k) = (ini Y Z (RN.o Z) h id1 k (G1.GB.BC.oC-idr (RN.o Z) (RN.o Y) k)).2.1 ;
    d-vp : Id (RN.Hom1 (RN.o Z) (RN.o Z)) (G1.GB.BC.oC (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z d) (vp Y (RN.o Z) k)) id1 =
     (ini Y Z (RN.o Z) h id1 k (G1.GB.BC.oC-idr (RN.o Z) (RN.o Y) k)).2.2 ;
    d1 : Id (Hom Z.1 Z.1) d.1 (idH Z.1) =
     trans (Hom Z.1 Z.1) d.1 (compH Z.1 Z.1 Z.1 d.1 (vp Y (RN.o Z) k).1) (idH Z.1)
      (trans (Hom Z.1 Z.1) d.1 (compH Z.1 Z.1 Z.1 d.1 (idH Z.1)) (compH Z.1 Z.1 Z.1 d.1 (vp Y (RN.o Z) k).1)
         (symH (comp-idr Z.1 Z.1 d.1))
         (ap (Hom Z.1 Z.1) (Hom Z.1 Z.1) (\ w -> compH Z.1 Z.1 Z.1 d.1 w) (idH Z.1) (vp Y (RN.o Z) k).1 (symH (vp1 Y (RN.o Z) k))))
      (ap (RN.Hom1 (RN.o Z) (RN.o Z)) (Hom Z.1 Z.1) (\ w -> w.1) (G1.GB.BC.oC (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z d) (vp Y (RN.o Z) k)) id1 d-vp) ;
    b : Pt (RN.o Z) = x.1 Z h i ;
    r1 : Id (Pt (RN.o L)) (UG.act L Z d b) (x.1 L (cl Y (RN.o Z) k) i) =
     trans (Pt (RN.o L)) (UG.act L Z d b) (x.1 L (G0.GB.BC.oC L Z Y h d) (G0.GB.ivA L Z d i)) (x.1 L (cl Y (RN.o Z) k) i)
      (x.2 L Z d h i)
      (trans (Pt (RN.o L)) (x.1 L (G0.GB.BC.oC L Z Y h d) (G0.GB.ivA L Z d i)) (x.1 L (cl Y (RN.o Z) k) (G0.GB.ivA L Z d i)) (x.1 L (cl Y (RN.o Z) k) i)
         (ap (RN.Hom0 L Y) (Pt (RN.o L)) (\ w -> x.1 L w (G0.GB.ivA L Z d i)) (G0.GB.BC.oC L Z Y h d) (cl Y (RN.o Z) k) d-cl)
         (ap (G0.GB.IvP Z) (Pt (RN.o L)) (\ j -> x.1 L (cl Y (RN.o Z) k) j) (G0.GB.ivA L Z d i) i
            (trans (G0.GB.IvP Z) (G1.PB.ivA Z.1 Z.1 d.1 i) (G1.PB.ivA Z.1 Z.1 (idH Z.1) i) i
               (ap (Hom Z.1 Z.1) (G0.GB.IvP Z) (\ w -> G1.PB.ivA Z.1 Z.1 w i) d.1 (idH Z.1) d1)
               (G1.PB.ivA-id Z.1 i)))) ;
    ret : Id (Pt (RN.o Z)) (efam Y x (RN.o Z) k i) b =
     trans (Pt (RN.o Z)) (efam Y x (RN.o Z) k i) (G.act (RN.o Z) (RN.o L) (vp Y (RN.o Z) k) (UG.act L Z d b)) b
      (ap (Pt (RN.o L)) (Pt (RN.o Z)) (\ w -> G.act (RN.o Z) (RN.o L) (vp Y (RN.o Z) k) w) (x.1 L (cl Y (RN.o Z) k) i) (UG.act L Z d b)
         (symH r1))
      (trans (Pt (RN.o Z)) (G.act (RN.o Z) (RN.o L) (vp Y (RN.o Z) k) (UG.act L Z d b))
         (G.act (RN.o Z) (RN.o Z) (G1.GB.BC.oC (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z d) (vp Y (RN.o Z) k)) b) b
         (symH (G.act-o (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z d) (vp Y (RN.o Z) k) b))
         (trans (Pt (RN.o Z)) (G.act (RN.o Z) (RN.o Z) (G1.GB.BC.oC (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z d) (vp Y (RN.o Z) k)) b)
            (G.act (RN.o Z) (RN.o Z) id1 b) b
            (ap (RN.Hom1 (RN.o Z) (RN.o Z)) (Pt (RN.o Z)) (\ w -> G.act (RN.o Z) (RN.o Z) w b)
               (G1.GB.BC.oC (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z d) (vp Y (RN.o Z) k)) id1 d-vp)
            (G.act-id (RN.o Z) b))) ;
   } ;
   -- rho (ext x) = x
   rho-ext (Y : Ob0) (x : W0.Ix (RH.F0.ob Y)) : Id (W0.Ix (RH.F0.ob Y)) (RH.rhoV Y (extV Y x)) x =
    RH.F0.fam-eq Y (RH.rhoV Y (extV Y x)) x (\ Z h i -> RE[Y, x, Z, h, i].ret) ;
   -- ext (rho x) = x: a line of the total site is determined by its restriction
   module ER (Y : Ob0) (x : W0.Ix (RH.F1.ob (RN.o Y))) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) (i : G1.GB.IvP Z) {
    L : Ob0 = lf Y Z k ;
    c : RN.Hom1 (RN.o L) (RN.o Y) = TR.fn.onH L Y (cl Y Z k) ;
    eq : Id (Pt Z) (efam Y (RH.rhoV Y x) Z k i) (x.1 Z k i) =
     trans (Pt Z) (efam Y (RH.rhoV Y x) Z k i) (x.1 Z (G1.GB.BC.oC Z (RN.o L) (RN.o Y) c (vp Y Z k)) (G1.GB.ivA Z (RN.o L) (vp Y Z k) i)) (x.1 Z k i)
      (x.2 Z (RN.o L) (vp Y Z k) c i)
      (trans (Pt Z) (x.1 Z (G1.GB.BC.oC Z (RN.o L) (RN.o Y) c (vp Y Z k)) (G1.GB.ivA Z (RN.o L) (vp Y Z k) i))
         (x.1 Z k (G1.GB.ivA Z (RN.o L) (vp Y Z k) i)) (x.1 Z k i)
         (ap (RN.Hom1 Z (RN.o Y)) (Pt Z) (\ w -> x.1 Z w (G1.GB.ivA Z (RN.o L) (vp Y Z k) i)) (G1.GB.BC.oC Z (RN.o L) (RN.o Y) c (vp Y Z k)) k (vp-eq Y Z k))
         (ap (G1.GB.IvP Z) (Pt Z) (\ j -> x.1 Z k j) (G1.GB.ivA Z (RN.o L) (vp Y Z k) i) i
            (trans (G1.GB.IvP Z) (G1.PB.ivA Z.1 Z.1 (vp Y Z k).1 i) (G1.PB.ivA Z.1 Z.1 (idH Z.1) i) i
               (ap (Hom Z.1 Z.1) (G1.GB.IvP Z) (\ w -> G1.PB.ivA Z.1 Z.1 w i) (vp Y Z k).1 (idH Z.1) (vp1 Y Z k))
               (G1.PB.ivA-id Z.1 i)))) ;
   } ;
   ext-rho (Y : Ob0) (x : W0.Ix (RH.F1.ob (RN.o Y))) : Id (W0.Ix (RH.F1.ob (RN.o Y))) (extV Y (RH.rhoV Y x)) x =
    RH.F1.fam-eq (RN.o Y) (extV Y (RH.rhoV Y x)) x (\ Z k i -> ER[Y, x, Z, k, i].eq) ;
   rho-inj (Y : Ob0) (x y : W0.Ix (RH.F1.ob (RN.o Y))) (p : Id (W0.Ix (RH.F0.ob Y)) (RH.rhoV Y x) (RH.rhoV Y y))
    : Id (W0.Ix (RH.F1.ob (RN.o Y))) x y =
    trans (W0.Ix (RH.F1.ob (RN.o Y))) x (extV Y (RH.rhoV Y x)) y (symH (ext-rho Y x))
     (trans (W0.Ix (RH.F1.ob (RN.o Y))) (extV Y (RH.rhoV Y x)) (extV Y (RH.rhoV Y y)) y
        (ap (W0.Ix (RH.F0.ob Y)) (W0.Ix (RH.F1.ob (RN.o Y))) (extV Y) (RH.rhoV Y x) (RH.rhoV Y y) p) (ext-rho Y y)) ;
   -- hence ext is natural along the levelwise maps
   ext-nat (Z Y : Ob0) (h : RN.Hom0 Z Y) (x : W0.Ix (RH.F0.ob Y))
    : Id (W0.Ix (RH.F1.ob (RN.o Z))) (RH.F1.actF (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (extV Y x)) (extV Z (RH.F0.actF Z Y h x)) =
    rho-inj Z (RH.F1.actF (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (extV Y x)) (extV Z (RH.F0.actF Z Y h x))
     (trans (W0.Ix (RH.F0.ob Z)) (RH.rhoV Z (RH.F1.actF (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (extV Y x))) (RH.F0.actF Z Y h x)
        (RH.rhoV Z (extV Z (RH.F0.actF Z Y h x)))
        (trans (W0.Ix (RH.F0.ob Z)) (RH.rhoV Z (RH.F1.actF (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (extV Y x))) (RH.F0.actF Z Y h (RH.rhoV Y (extV Y x)))
           (RH.F0.actF Z Y h x)
           (RH.rho.nt-nat Z Y h (extV Y x))
           (ap (W0.Ix (RH.F0.ob Y)) (W0.Ix (RH.F0.ob Z)) (RH.F0.actF Z Y h) (RH.rhoV Y (extV Y x)) x (rho-ext Y x)))
        (symH (rho-ext Z (RH.F0.actF Z Y h x)))) ;
  } ;
 } ;
 -- the factorisation is canonicity-45's (CDisc: Fact, Ini)
 module FI = Fact[\ Y Z k -> TR.DS.Fact[Y, Z, k].vp, \ Y Z k -> refl (idH Z.1), \ Y Z k -> TR.DS.Fact[Y, Z, k].vp-eq,
   \ Y Y' Z c v k e -> (TR.DS.Ini[Y, Y', Z, c, v, k, e].d, TR.DS.Ini[Y, Y', Z, c, v, k, e].eq1, TR.DS.Ini[Y, Y', Z, c, v, k, e].eq2)] ;
} ;
