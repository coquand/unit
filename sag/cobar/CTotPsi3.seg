-- CTotPsi3.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for lines
-- at the total site, part 3: Psi of a line of D G as a family over the
-- indices of X of lines of G (tP), and its naturality equation (natP):
-- restricting psi_q along the cartesian lift of h is psi at the
-- restricted index (CTotUExt's ext-nat, then the levelwise lines agree
-- by RC2, associativity and the restriction of weights).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi3 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) {
 module P2 = CTotPsi2[a, vl, l].Psi2[C, G] ;
 module PO = P2.PO ;
 module TR = PO.TR ;
 module G0 = TR.G0 ;
 module G1 = TR.G1 ;
 module TC = PO.TC ;
 module VT = PO.VT ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module CL = PO.CL ;
 module XB = P2.XB ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;
 module FG1 = G1.GB.CLine[l].FC[PO.GP] ;
 LinT : CTPsh[a, vl, l].TPshOf[C].TCtx = TC.ofP FG1.GI ;
 module DL = DO.DC[LinT] ;

 module PN (X : TC.TOb) (ln : W0.Ix (PO.FL.ob X)) {
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  tP : DL.T I x = \ q lq -> P2.PQ[X, ln, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].psiq ;

  module NT (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : CT.Ch J n (C.res J I u x) z) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J) {
   module Q = P2.PQ[X, ln, n, J, u, z, c, i] ;
   uh : Hom J' I = compH J' J I u h ;
   rzh : Obj J' = C.res J' J h z ;
   module Q' = P2.PQ[X, ln, n, J', uh, rzh, DO.rCh J' J I h u x n z c, Wt.Res[n, J', J, h, i].res] ;
   Y : Ob0 = (J, z) ;
   Y' : Ob0 = (J', rzh) ;
   hh : TR.RN.Hom0 Y' Y = (h, refl rzh) ;
   module EV (W1 : Ob) (f1 : Hom W1 J') (j : PB.IvP W1) {
    T0 : Obj W1 = C.res W1 J' f1 rzh ;
    hf : Hom W1 J = compH W1 J' J h f1 ;
    module R2 = CL.RC2[W1, J', J, I, f1, h, u, x, n, z, c] ;
    SP (eT : Id (Obj W1) (C.res W1 J hf z) T0)
     : Id (D.S I x n W1 T0) (compH W1 J' I uh f1, DO.rCh W1 J' I f1 uh x n rzh (DO.rCh J' J I h u x n z c)) (compH W1 J I u hf, Q.cT W1 hf T0 eT) =
     D.sEq I x n W1 T0 (compH W1 J' I uh f1) (compH W1 J I u hf) (comp-assoc W1 J' J I u h f1)
      (DO.rCh W1 J' I f1 uh x n rzh (DO.rCh J' J I h u x n z c)) (Q.cT W1 hf T0 eT)
      (transH R2.law
         (apH {Id (Obj W1) (C.res W1 J hf z) T0} {CT.Ch W1 n (C.res W1 I (compH W1 J I u hf) x) T0} (\ e -> Q.cT W1 hf T0 e)
            (CT.setObj W1 (C.res W1 J hf z) T0 R2.et eT))) ;
    base (eT : Id (Obj W1) (C.res W1 J hf z) T0) : Id (W0.Ix (G.ob W1 T0)) (Q.vg W1 hf T0 eT j) (Q'.vg W1 f1 T0 (refl T0) j) =
     symH (transH (apH {D.S I x n W1 T0} {W0.Ix (G.ob W1 T0)} (\ sw -> Q.rdS W1 T0 sw (Wt.Res[n, W1, J', f1, Wt.Res[n, J', J, h, i].res].res) j) (SP eT))
             (apH {Wt.Pn n W1} {W0.Ix (G.ob W1 T0)} (\ r -> Q.rdS W1 T0 (compH W1 J I u hf, Q.cT W1 hf T0 eT) r j) (P2.resres n W1 J' J h f1 i))) ;
    evg (y : Obj W1) (e' : Id (Obj W1) T0 y) (eT : Id (Obj W1) (C.res W1 J hf z) y)
     : Id (W0.Ix (G.ob W1 y)) (Q.vg W1 hf y eT j) (Q'.vg W1 f1 y e' j) =
     idJ (Obj W1) T0
      (\ y2 e2 -> (eT2 : Id (Obj W1) (C.res W1 J hf z) y2) -> Id (W0.Ix (G.ob W1 y2)) (Q.vg W1 hf y2 eT2 j) (Q'.vg W1 f1 y2 e2 j))
      base y e' eT ;
   } ;
   L0eq : Id (W0.Ix (XB.RH.F0.ob Y')) (XB.RH.F0.actF Y' Y hh Q.L0) Q'.L0 =
    XB.RH.F0.fam-eq Y' (XB.RH.F0.actF Y' Y hh Q.L0) Q'.L0
     (\ W f j -> EV[W.1, f.1, j].evg W.2 (symH f.2) (symH (G0.GB.BC.oC W Y' Y hh f).2)) ;
   law : Id (W0.Ix (XB.RH.F1.ob (TR.RN.o Y'))) (XB.RH.F1.actF (TR.RN.o Y') (TR.RN.o Y) (TR.fn.onH Y' Y hh) Q.psiq) Q'.psiq =
    transH (XB.ext-nat Y' Y hh Q.L0) (apH {W0.Ix (XB.RH.F0.ob Y')} {W0.Ix (XB.RH.F1.ob (TR.RN.o Y'))} (XB.extV Y') L0eq) ;
  } ;
  natP : W0.Ix (DL.natEq I x tP) = \ r lq ->
   NT[r.1.1, r.1.2.1, r.1.2.2.1, r.1.2.2.2.1, r.1.2.2.2.2.1, (r.1.2.2.2.2.2, lq), r.2.1, r.2.2].law ;
 } ;
} ;
