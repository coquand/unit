-- Cor15.seg (canonicity-45; jonas.pdf Corollary 15): D tau_A is an
-- equivalence at every x, for A levelwise fibrant.  Proposition 13 applied
-- to f = tau_A : A -> DA over G, with
--   DAC      D A as a C-type over G: DCTy pulled back along tau (subCTy)
--   tauA     tau_A as a CMap: Lemma 14's tauN at each x (LR.Map), natural
--            in C by tot-rx and A.tE-o (the C-action of D A on the total
--            of tau is the total of tau on the moved element)
--   fB       D A levelwise fibrant over G: Lemma 12 (fibD) along tau
--   ef       U tau_A an EquivOp at x: Lemma 14's quasi-inverse through
--            QinvEq.QE (A fibrant by al, D A by fB)
--   cor15    Prop13.Main.prop13 : EquivOp of D tau_A at x
-- No new axioms beyond the named premises (al, the base's CB fields).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;
module HO = PB.CHtpyOps[l] ;
module LR = CLocBoundRetr[a, l] ;

module C15 (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A : CPshC[a, l].CPsh[C].CTy[G]) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module D = DD.DC[G] ;
 module DA = DD.DT[G, A] ;
 module L14 = Lemma14[a, l].L14[C, G, A] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 open P ;

 -- D A as a C-type over G
 module SCm = LO.SC[G, D.DCtx, D.tau, DA.DCTy] ;
 DAC : P.CTy[G] = SCm.subCTy ;

 ------------------------------------------------------------------
 -- tau_A as a CMap

 tauM (x : CO) : CP.PMap[G.ob x, A.ty x, DAC.ty x] = LR.Map[G.ob x, A.ty x, DAC.ty x, L14.tauN x].pmap ;

 -- naturality in C: the two totals in D A over (D G)_y, compared by totD-eq
 module TN (y x : CO) (h : CH y x) (X : Ob) (w : SigT (G.ob x) (A.ty x) X) {
  module Tx = L14.TA'[x, X, w.1, w.2] ;
  w' : SigT (G.ob y) (A.ty y) X = (A.tE y x h).nt X w ;
  module Ty' = L14.TA'[y, X, w'.1, w'.2] ;

  -- the points agree (tau is a CSub)
  Pt : Id (D.Ob' y X) (D.CA[y, x, h, X, Tx.tauP].res) Ty'.tauP =
   transH (symH (D.tau.sb-nat y x h X w.1)) (apH (\ g -> D.Tau[y, X, g].res) (symH (A.tE-pt y x h X w))) ;

  -- the families agree in E, at every index
  H (q : DD.Idx y X) (l : DD.LandsI y X q)
   : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1))
      (DA.prz q.2.1 q.2.2.2.1 (Tx.tauP.1 (D.CA[y, x, h, X, Tx.tauP].rq q) l) (Tx.t (D.CA[y, x, h, X, Tx.tauP].rq q) l))
      (DA.prz q.2.1 q.2.2.2.1 (Ty'.tauP.1 q l) (Ty'.t q l)) =
   calc (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) {
       DA.prz q.2.1 q.2.2.2.1 (Tx.tauP.1 (D.CA[y, x, h, X, Tx.tauP].rq q) l) (Tx.t (D.CA[y, x, h, X, Tx.tauP].rq q) l)
     =< Tx.pc (D.CA[y, x, h, X, Tx.tauP].rq q) l >
       (A.tE q.2.1 x (K.tot q.1 x q.2.1 (K.rx q.1 y x h q.2.1 q.2.2.1))).nt q.2.2.2.1 (Tx.ae q.2.2.2.1 q.2.2.2.2.1)
     =< apH (\ k' -> (A.tE q.2.1 x k').nt q.2.2.2.1 (Tx.ae q.2.2.2.1 q.2.2.2.2.1)) (K.tot-rx q.1 y x h q.2.1 q.2.2.1) >
       (A.tE q.2.1 x (P.co q.2.1 y x h (K.tot q.1 y q.2.1 q.2.2.1))).nt q.2.2.2.1 (Tx.ae q.2.2.2.1 q.2.2.2.2.1)
     =< A.tE-o q.2.1 y x h (K.tot q.1 y q.2.1 q.2.2.1) q.2.2.2.1 (Tx.ae q.2.2.2.1 q.2.2.2.2.1) >
       (A.tE q.2.1 y (K.tot q.1 y q.2.1 q.2.2.1)).nt q.2.2.2.1 ((A.tE y x h).nt q.2.2.2.1 (Tx.ae q.2.2.2.1 q.2.2.2.2.1))
     =< apH ((A.tE q.2.1 y (K.tot q.1 y q.2.1 q.2.2.1)).nt q.2.2.2.1) ((A.tE y x h).nt-nat q.2.2.2.1 X q.2.2.2.2.1 w) >
       (A.tE q.2.1 y (K.tot q.1 y q.2.1 q.2.2.1)).nt q.2.2.2.1 (Ty'.ae q.2.2.2.1 q.2.2.2.2.1)
     =< symH (Ty'.pc q l) >
       DA.prz q.2.1 q.2.2.2.1 (Ty'.tauP.1 q l) (Ty'.t q l) } ;

  res : Id (SigT (G.ob y) (DAC.ty y) X) ((DAC.tE y x h).nt X ((tauM x).mE X w)) ((tauM y).mE X w') =
   SCm.sub-eq y X ((DAC.tE y x h).nt X ((tauM x).mE X w)) ((tauM y).mE X w')
    (symH (A.tE-pt y x h X w))
    (transH (SCm.rBtE y x h X ((tauM x).mE X w)) (DA.totD-eq y X _ _ Pt H)) ;
 } ;

 tauA : P13.CMap[G, A, DAC] = new P13.CMap[G, A, DAC, tauM, \ y x h X w -> TN[y, x, h, X, w].res] ;

 ------------------------------------------------------------------
 -- Corollary 15

 module Main (al : P.LFib G A) {
  module F12 = Lemma12F[a, l].F12[C, G, A, al] ;

  -- D A is levelwise fibrant over G (Lemma 12 along tau)
  fB : P.LFib G DAC = \ x -> PB.CFibSub[l].FibSub[G.ob x, D.obD x, D.tauX x, DA.DTy x].sub (F12.fibD x) ;

  -- U tau_A is an equivalence at x (Lemma 14, through QinvEq)
  ef (x : CO) : CE.EquivOp (G.ob x) (A.ty x) (DAC.ty x) (tauM x) =
   QinvEq[a, l].QE[G.ob x, (A.ty x, al x), (DAC.ty x, fB x), L14.tauN x,
                   (L14.lemma14 al x).1, (L14.lemma14 al x).2.1, (L14.lemma14 al x).2.2].qinvEq ;

  module PM = P13.Main[G, A, DAC, tauA, al, fB, ef] ;

  cor15 (x : CO) : CE.EquivOp (D.obD x) (DA.DTy x) (DD.DT[G, DAC].DTy x) (P13.DF[G, A, DAC, tauA].Df x) = PM.prop13 x ;
 } ;
} ;
