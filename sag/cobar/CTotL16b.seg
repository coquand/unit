-- CTotL16b.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, the weights (base-level, from Lemma16.seg): the families of the
-- bridge M and of the lines p, q on a concatenated weight, with their
-- restriction and face laws, and the ends (zeros on a block).
--   WfCat   cat j i                 (M)
--   WfML    cat (meet t j) i        (p: the meet on the left block)
--   WfMR    cat j (meet t i)        (q: the meet on the right block)
--   zerosTop, catZeroTop   the top face of zeros; cat j (0) is the top face of j
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Pa = Prelude[a] ;
module L14 = CTotL14f[a, vl, l] ;

pzm : (m : Nat) -> Id Nat m (Ar.plus m zero) = split {
 zero -> refl zero ;
 suc m' | ih -> Pa.ap Nat Nat (\ k -> suc k) m' (Ar.plus m' zero) ih } ;
substP (J : Ob) (N N' : Nat) (p : Id Nat N N') (w : Wt.Pn N J) : Wt.Pn N' J = subst Nat (\ M -> Wt.Pn M J) N N' p w ;
substP-1 (J : Ob) (N N' : Nat) (e : Id Nat N N') (w : Wt.Pn N J) (k : Ar.Fin (suc N'))
 : Id (Hom J PFO.ivO) ((substP J N N' e w).1 k) (Wt.substC J N N' e w.1 k) =
 idJ Nat N (\ N2 e2 -> (k2 : Ar.Fin (suc N2)) -> Id (Hom J PFO.ivO) ((substP J N N2 e2 w).1 k2) (Wt.substC J N N2 e2 w.1 k2))
  (\ k2 -> refl (w.1 k2)) N' e k ;

-- (M) concatenation
WfCat (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) : Wt.Pn (Ar.plus m (suc n)) J = Wt.CatP[m, n, J].left j i.1 ;
WresCat (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, WfCat m n J t j i].res)
      (WfCat m n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)) =
 L14.pnEq (Ar.plus m (suc n)) J' _ _ (\ k -> Wt.catC-res m n J' J h j.1 i.1 k) ;
WfaceLCat (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (WfCat (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
      (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[WfCat m n J t j i].face) =
 L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' -> symH (Wt.catFL m n J k hk j.1 i.1 k')) ;
WfaceRCat (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
      (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfCat m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
      (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[WfCat m n J t j i].face) =
 L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' ->
  transH (substP-1 J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfCat m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)) k')
    (symH (Wt.catFR m n J k hk j.1 i.1 k'))) ;

-- (p) the meet with t on the left block
WfML (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) : Wt.Pn (Ar.plus m (suc n)) J = Wt.CatP[m, n, J].right (Wt.meetC m J t j.1) i ;
WresML (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, WfML m n J t j i].res)
      (WfML m n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)) =
 L14.pnEq (Ar.plus m (suc n)) J' _ _ (\ k ->
  transH (Wt.catC-res m n J' J h (Wt.meetC m J t j.1) i.1 k)
    (Wt.catC-congL m n J' (Wt.resC m J' J h (Wt.meetC m J t j.1)) (Wt.meetC m J' (PB.compH J' J PFO.ivO t h) (Wt.resC m J' J h j.1)) (Wt.resC n J' J h i.1)
       (\ k' -> Wt.meet-res m J' J h t j.1 k') k)) ;
WfaceLML (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (WfML (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
      (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[WfML m n J t j i].face) =
 L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' ->
  transH (Wt.catC-congL (suc m) n J (Wt.meetC (suc m) J t (Wt.Face[m, J, k, hk].faceC j.1)) (Wt.Face[m, J, k, hk].faceC (Wt.meetC m J t j.1)) i.1
            (\ k2 -> symH (Wt.MeetFace[m, J, k, hk, t, j.1].coord k2)) k')
    (symH (Wt.catFL m n J k hk (Wt.meetC m J t j.1) i.1 k'))) ;
WfaceRML (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
      (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfML m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
      (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[WfML m n J t j i].face) =
 L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' ->
  transH (substP-1 J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfML m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)) k')
    (symH (Wt.catFR m n J k hk (Wt.meetC m J t j.1) i.1 k'))) ;

-- (q) the meet with t on the right block
WfMR (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) : Wt.Pn (Ar.plus m (suc n)) J = Wt.CatP[m, n, J].left j (Wt.meetC n J t i.1) ;
WresMR (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, WfMR m n J t j i].res)
      (WfMR m n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)) =
 L14.pnEq (Ar.plus m (suc n)) J' _ _ (\ k ->
  transH (Wt.catC-res m n J' J h j.1 (Wt.meetC n J t i.1) k)
    (Wt.catC-congR m n J' (Wt.resC m J' J h j.1) (Wt.resC n J' J h (Wt.meetC n J t i.1)) (Wt.meetC n J' (PB.compH J' J PFO.ivO t h) (Wt.resC n J' J h i.1))
       (\ k' -> Wt.meet-res n J' J h t i.1 k') k)) ;
WfaceLMR (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (WfMR (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
      (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[WfMR m n J t j i].face) =
 L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' -> symH (Wt.catFL m n J k hk j.1 (Wt.meetC n J t i.1) k')) ;
WfaceRMR (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
      (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfMR m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
      (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[WfMR m n J t j i].face) =
 L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' ->
  transH (substP-1 J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfMR m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)) k')
    (transH (apH (\ cc -> Wt.substC J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) cc k')
               (L14.coEq (Ar.plus m (suc (suc n))) J (Wt.catC m (suc n) J j.1 (Wt.meetC (suc n) J t (Wt.Face[n, J, k, hk].faceC i.1)))
                  (Wt.catC m (suc n) J j.1 (Wt.Face[n, J, k, hk].faceC (Wt.meetC n J t i.1)))
                  (Wt.catC-congR m (suc n) J j.1 (Wt.meetC (suc n) J t (Wt.Face[n, J, k, hk].faceC i.1)) (Wt.Face[n, J, k, hk].faceC (Wt.meetC n J t i.1))
                     (\ k2 -> symH (Wt.MeetFace[n, J, k, hk, t, i.1].coord k2)))))
      (symH (Wt.catFR m n J k hk j.1 (Wt.meetC n J t i.1) k')))) ;
-- the ends t = 0 of the lines: the weights (zeros on one block) and the
-- iterated faces of u

-- the top face of zeros is zeros
zerosTopB (n : Nat) (J : Ob) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : (b : Bool) -> (e : Id Bool (eqN k (suc n)) b)
 -> Id (Hom J PFO.ivO) (Wt.Face[n, J, suc n, Tr.leb-refl (suc n)].valB (Wt.zeros n J) k hk b e) (PB.ptH J PB.e0) = split {
 true -> \ e -> refl (PB.ptH J PB.e0) ;
 false -> \ e -> refl (PB.ptH J PB.e0) } ;
zerosTop (n : Nat) (J : Ob) (t : Ar.Fin (suc (suc n))) : Id (Hom J PFO.ivO) (Wt.Face[n, J, suc n, Tr.leb-refl (suc n)].faceC (Wt.zeros n J) t) (Wt.zeros (suc n) J t) =
 zerosTopB n J t.1 t.2 (eqN t.1 (suc n)) (refl (eqN t.1 (suc n))) ;

-- cat j (0) is the top face of j (with the arities m+1 = suc (m+0) and m = m+0 transported)
czB1 (J : Ob) (j : Wt.Coords zero J) : (k' : Nat) -> (h : Tr.IsT (Ar.ltb (suc k') (suc (suc zero))))
 -> Id (Hom J PFO.ivO) (Wt.consB zero J (j (zero, refl true)) (Wt.zeros zero J) (suc k') h)
      (Wt.Face[zero, J, suc zero, Tr.leb-refl (suc zero)].valB j (suc k') h (eqN (suc k') (suc zero)) (refl (eqN (suc k') (suc zero)))) = split {
 zero -> \ h -> refl (PB.ptH J PB.e0) ;
 suc k'' -> \ h -> absurd (Id (Hom J PFO.ivO) (Wt.consB zero J (j (zero, refl true)) (Wt.zeros zero J) (suc (suc k'')) h)
                      (Wt.Face[zero, J, suc zero, Tr.leb-refl (suc zero)].valB j (suc (suc k'')) h (eqN (suc (suc k'')) (suc zero)) (refl (eqN (suc (suc k'')) (suc zero)))))
                   (Tr.false-true h) } ;
czB (J : Ob) (j : Wt.Coords zero J) : (k : Nat) -> (h : Tr.IsT (Ar.ltb k (suc (suc zero))))
 -> Id (Hom J PFO.ivO) (Wt.consB zero J (j (zero, refl true)) (Wt.zeros zero J) k h)
      (Wt.Face[zero, J, suc zero, Tr.leb-refl (suc zero)].valB j k h (eqN k (suc zero)) (refl (eqN k (suc zero)))) = split {
 zero -> \ h -> apH j (Ar.fin-eq (suc zero) (zero, refl true) (Ar.dg zero (suc zero) zero, Ar.dg-range zero (suc zero) zero h) (refl zero)) ;
 suc k' -> czB1 J j k' } ;
catZeroTop : (m : Nat) -> (J : Ob) -> (j : Wt.Coords m J) -> (t : Ar.Fin (suc (suc (Ar.plus m zero))))
 -> Id (Hom J PFO.ivO) (Wt.substC J (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) (Wt.catC m zero J j (Wt.zeros zero J)) t)
      (Wt.Face[Ar.plus m zero, J, suc (Ar.plus m zero), Tr.leb-refl (suc (Ar.plus m zero))].faceC (Wt.substC J m (Ar.plus m zero) (pzm m) j) t) = split {
 zero -> \ J j t -> czB J j t.1 t.2 ;
 suc m' | ih -> \ J j t ->
  transH (Wt.substCons J (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) (j (zero, refl true)) (Wt.catC m' zero J (Wt.tailC m' J j) (Wt.zeros zero J)) t)
   (transH (Wt.consC-cong (suc (Ar.plus m' zero)) J (j (zero, refl true))
              (Wt.substC J (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) (Wt.catC m' zero J (Wt.tailC m' J j) (Wt.zeros zero J)))
              (Wt.Face[Ar.plus m' zero, J, suc (Ar.plus m' zero), Tr.leb-refl (suc (Ar.plus m' zero))].faceC (Wt.substC J m' (Ar.plus m' zero) (pzm m') (Wt.tailC m' J j)))
              (ih J (Wt.tailC m' J j)) t.1 t.2)
     (transH (symH (Wt.FaceCons[Ar.plus m' zero, J, suc (Ar.plus m' zero), Tr.leb-refl (suc (Ar.plus m' zero)), j (zero, refl true), Wt.substC J m' (Ar.plus m' zero) (pzm m') (Wt.tailC m' J j)].coord t))
       (transH (Wt.FaceIrr[suc (Ar.plus m' zero), J, suc (suc (Ar.plus m' zero)), Tr.leb-refl (suc (Ar.plus m' zero)), Tr.leb-refl (suc (suc (Ar.plus m' zero))),
                           Wt.consC (Ar.plus m' zero) J (j (zero, refl true)) (Wt.substC J m' (Ar.plus m' zero) (pzm m') (Wt.tailC m' J j))].coord t)
         (Wt.FaceCong[suc (Ar.plus m' zero), J, suc (suc (Ar.plus m' zero)), Tr.leb-refl (suc (suc (Ar.plus m' zero))),
                      Wt.consC (Ar.plus m' zero) J (j (zero, refl true)) (Wt.substC J m' (Ar.plus m' zero) (pzm m') (Wt.tailC m' J j)),
                      Wt.substC J (suc m') (suc (Ar.plus m' zero)) (Pa.ap Nat Nat (\ k -> suc k) m' (Ar.plus m' zero) (pzm m')) j,
                      \ k -> transH (symH (Wt.substCons J m' (Ar.plus m' zero) (pzm m') (j (zero, refl true)) (Wt.tailC m' J j) k))
                               (apH (\ cc -> Wt.substC J (suc m') (suc (Ar.plus m' zero)) (Pa.ap Nat Nat (\ k' -> suc k') m' (Ar.plus m' zero) (pzm m')) cc k)
                                  (L14.coEq (suc m') J (Wt.consC m' J (j (zero, refl true)) (Wt.tailC m' J j)) j (\ k2 -> symH (Wt.consC-eta m' J j k2.1 k2.2))))].coord t)))) } ;

