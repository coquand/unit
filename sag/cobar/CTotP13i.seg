-- CTotP13i.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part i: the lift back (bk), values.  Given a point w = (d, b') of
-- D G . D B and a D-element u of D Pt over its pairing:
--   a'      the D A element over d read off u (its equations are u's,
--           through fibB)
--   bfam    at (Wd, f, j) and an index q of Wd: the B part of u's path at
--           the moved index (c2's CTotPsi15 recovery for the constant line
--           at d), read at (id, j restricted), moved to lie over the
--           constant line (CTotP13c and the path's base condition)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13i (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PF = CTotP13f[a, vl, l].P13f[C, G, A, B, f] ;
 module PE = PF.PE ;
 module TR = PE.TR ;
 module TC = PE.TC ;
 module DO = PE.DO ;
 module DF = PE.DF ;
 module H = PE.H ;
 module HD = PE.HD ;
 module DS = PF.DS ;
 module CG = PE.CG ;
 module R15 = CTotPsi15[a, vl, l].Psi15[C, G] ;
 Obj (I : Ob) : U vl = PE.Obj I ;

 module BKd (X : TC.TOb) (w : HD.TA.EI X) (u : DS.TOb' X.1 X.2 (PE.PR.phi X w)) {
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  d : DF.D.Ob' I x = HD.TA.pr1 X w ;
  pt : DS.D.Ob' I x = PE.PR.phi X w ;
  ln : W0.Ix (PE.PO.FL.ob X) = CG.At[X, d].ln ;
  Yq (qq : DO.Idx I x) : TC.TOb = (qq.2.1, qq.2.2.2.1) ;
  lineE (qq : DO.Idx I x) (lq : DO.LandsI I x qq) : W0.Ix (PE.FTg.FE.ob (Yq qq)) = (u.1 qq lq).2.1 ;
  -- the D A element
  af : DF.DA.TA I x d = \ qq lq -> (u.1 qq lq).1 ;
  anatA : W0.Ix (DF.DA.anatEq I x d af) = \ r lq ->
   transH (symH (H.fibB-act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
                   (DS.prz r.1.2.1 r.1.2.2.2.1 (pt.1 r.1 lq) (u.1 r.1 lq))))
    (apH {H.TF.EI (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} {H.TB.EI (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
       (H.fibB (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (u.2.1 r lq)) ;
  afaceA : W0.Ix (DF.DA.afaceEq I x d af) = \ r lq ->
   apH {H.TF.EI (r.2.2.2.1, r.2.2.2.2.2.1)} {H.TB.EI (r.2.2.2.1, r.2.2.2.2.2.1)} (H.fibB (r.2.2.2.1, r.2.2.2.2.2.1)) (u.2.2.1 r lq) ;
  atopA : W0.Ix (DF.DA.atopEq I x d af) = \ r lq ->
   transH (apH {H.TF.EI (r.2.1, r.2.2.2.1)} {H.TB.EI (r.2.1, r.2.2.2.1)} (H.fibB (r.2.1, r.2.2.2.1)) (u.2.2.2 r lq))
    (H.fibB-act (r.2.1, r.2.2.2.1) (r.2.1, (DS.D.topD I x r).1) (idH r.2.1, (DS.D.topD I x r).2.2)
       (DS.prz r.2.1 (DS.D.topD I x r).1 (pt.1 (r.1, r.2.1, r.2.2.1, (DS.D.topD I x r).1, (DS.D.topD I x r).2.1, r.2.2.2.2.2) lq)
          (u.1 (r.1, r.2.1, r.2.2.1, (DS.D.topD I x r).1, (DS.D.topD I x r).2.1, r.2.2.2.2.2) lq))) ;
  a' : DF.DA.TOb' I x d = (af, anatA, afaceA, atopA) ;
  -- the B parts of the line
  module AB (Wd : TC.TOb) (g : TC.THm Wd X) (j : PB.IvP Wd.1) {
   dd : DF.D.Ob' Wd.1 Wd.2 = ln.1 Wd g j ;
   module RQ (q : DO.Idx Wd.1 Wd.2) (lq : DO.LandsI Wd.1 Wd.2 q) {
    module RC = R15.Rec[X, ln, Wd, g, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq), j] ;
    module CQ = CG.At[X, d].Q[q.1, q.2.1, RC.U0, q.2.2.2.1, RC.cc, (q.2.2.2.2.2, lq)] ;
    qq : DO.Idx I x = (q.1, q.2.1, RC.U0, q.2.2.2.1, RC.cc, q.2.2.2.2.2) ;
    Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
    te : H.TA.EI Y = (lineE qq lq).1 Y (TC.tid Y) RC.j0 ;
    pq : Id (W0.Ix (G.ob q.2.1 q.2.2.2.1)) te.1 (dd.1 q lq) =
     transH ((u.1 qq lq).2.2.1 Y (TC.tid Y) RC.j0)
      (transH (apH {W0.Ix (PE.FCg.ob Y)} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ M -> M.1 Y (TC.tid Y) RC.j0) (symH CQ.psiC)) (symH RC.law)) ;
    bf : W0.Ix (B.tob Y (dd.1 q lq)) = DF.DB.coeT q.2.1 q.2.2.2.1 te.1 (dd.1 q lq) pq te.2 ;
    beq : Id (DF.DB.Ez q.2.1 q.2.2.2.1) (DF.DB.prz q.2.1 q.2.2.2.1 (dd.1 q lq) bf) te = symH (DF.DB.pr-coe q.2.1 q.2.2.2.1 te.1 (dd.1 q lq) pq te.2) ;
   } ;
   bfam : DF.DB.TA Wd.1 Wd.2 dd = \ q lq -> RQ[q, lq].bf ;
  } ;
 } ;
} ;
