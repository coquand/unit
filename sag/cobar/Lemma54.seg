-- Lemma54.seg (canonicity-c2; jonas.pdf Lemma 54, COBAR.md "Plan: Lemma
-- 54"): U preserves Pi when the domain is constant along C.
--
-- A C-type A is CARTESIAN (Cart) when its C-action is a bijection on
-- fibres: every total of A_y over a point act f p is A.tE f of a unique
-- element of A_x over p.  This is the case of a base type K with the
-- identity C-action (Delta K), whatever the cubical structure of K.
--
-- LEMMA 54.  For A cartesian, the comparison map
--     cmp : (Pi_A B)_x -> Pi_{A_x} B_x        (base product at x)
-- which keeps the component at f = id_x (CPshPiLaws' restriction to
-- identities, curried) is a bijection on fibres, natural in the base:
-- Pi_A B is computed levelwise.
--
-- Proof.  Inverse: phi |-> the family whose value at (y , f , h , a) is
-- B.tE f (phi h a'), where a' is the element of A_x with A.tE f a' = a
-- (Cart).  It is natural in the base (phi is, and A.tE f, B.tE f are
-- maps of base presheaves) and in C (B.tE-o, A.tE-o, uniqueness of a').
-- cmp (inv phi) = phi by B.tE-id; inv (cmp u) = u because u is natural in
-- C: B.tE f (u at (id , h , a')) = u at (id f , h , a) (cnat-at).
-- Naturality in x: the C-action transported to the base products is the
-- formula of the inverse, phi |-> B.tE f . phi . back.
--
--   Cart            the hypothesis on A
--   AtK.mk          an element of the base product from its values and
--                   their naturality, as totals
--   cmpE , cmpT     the comparison map, on fibres and on totals
--   cmp-val         its values are the values at f = id
--   Inv.el          the inverse
--   cmp-inv , inv-cmp , lemma54 , cmp-B
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;

module L54Of (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 open P ;

 -- cartesian C-types
 record Cart (G : CCtx) (A : CTy[G]) {
  back (y x : CO) (f : CH y x) (Y : Ob) (w : SigT (G.ob y) (A.ty y) Y) (p : W0.Ix ((G.ob x).ob Y))
   (q : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) ((G.act y x f).nt Y p)) : W0.Ix ((A.ty x).tob Y p) ;
  back-tE (y x : CO) (f : CH y x) (Y : Ob) (w : SigT (G.ob y) (A.ty y) Y) (p : W0.Ix ((G.ob x).ob Y))
   (q : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) ((G.act y x f).nt Y p))
   : Id (SigT (G.ob y) (A.ty y) Y) ((A.tE y x f).nt Y (pairE (G.ob x) (A.ty x) Y p (back y x f Y w p q))) w ;
  tE-inj (y x : CO) (f : CH y x) (Y : Ob) (p : W0.Ix ((G.ob x).ob Y)) (a0 a1 : W0.Ix ((A.ty x).tob Y p))
   (e : Id (SigT (G.ob y) (A.ty y) Y) ((A.tE y x f).nt Y (pairE (G.ob x) (A.ty x) Y p a0)) ((A.tE y x f).nt Y (pairE (G.ob x) (A.ty x) Y p a1)))
   : Id (W0.Ix ((A.ty x).tob Y p)) a0 a1 ;
 } ;

 module M (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (ca : Cart[G, A]) {
  module PC = PO.PiC[G, A, B] ;
  E : CCtx = PC.E ;
  -- totals of the base product at x
  TK (x : CO) (X : Ob) : U l = SigT (G.ob x) (PC.PiB x) X ;

  ------------------------------------------------------------------
  -- the base product at x over gm: values, naturality, constructor

  module AtK (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) {
   pH (Y : Ob) (h : Hom Y X) : W0.Ix ((G.ob x).ob Y) = (G.ob x).act Y X h gm ;
   FAx (Y : Ob) (h : Hom Y X) : U l = W0.Ix ((A.ty x).tob Y (pH Y h)) ;
   PiK : U l = W0.Ix ((PC.PiB x).tob X gm) ;
   vT (phi : PiK) (Y : Ob) (h : Hom Y X) (a0 : FAx Y h) : PC.TB x Y = PC.prB x Y (PC.prA x Y (pH Y h) a0) (phi.1 Y h a0) ;
   aAct (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (a0 : FAx Y h) : FAx Y' (compH Y' Y X h j) =
    PP.PiCode[G.ob x, A.ty x, B.ty x].AactOf X (PP.PiCode[G.ob x, A.ty x, B.ty x].ptOf X gm)
      (PP.PiCode[G.ob x, A.ty x, B.ty x].cOf X gm) Y Y' h j a0 ;
   aAct-pr (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (a0 : FAx Y h)
    : Id (PC.TA x Y') ((E.ob x).act Y' Y j (PC.prA x Y (pH Y h) a0)) (PC.prA x Y' (pH Y' (compH Y' Y X h j)) (aAct Y' Y j h a0)) =
    PP.PiCode[G.ob x, A.ty x, B.ty x].eOf X gm Y Y' h j a0 ;
   -- naturality of phi, as totals
   phiNat (phi : PiK) (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (a0 : FAx Y h)
    : Id (PC.TB x Y') ((extP (E.ob x) (B.ty x)).act Y' Y j (vT phi Y h a0)) (vT phi Y' (compH Y' Y X h j) (aAct Y' Y j h a0)) =
    transH (GPR.TyL[E.ob x, B.ty x].pr-tact Y' Y j (PC.prA x Y (pH Y h) a0)
              (PC.prA x Y' (pH Y' (compH Y' Y X h j)) (aAct Y' Y j h a0)) (aAct-pr Y' Y j h a0) (phi.1 Y h a0))
     (apH (\ v -> PC.prB x Y' (PC.prA x Y' (pH Y' (compH Y' Y X h j)) (aAct Y' Y j h a0)) v) (phi.2 Y Y' h j a0)) ;
   -- an element from natural values
   VT : U l = (Y : Ob) (h : Hom Y X) (a0 : FAx Y h) -> W0.Ix ((B.ty x).tob Y (PC.prA x Y (pH Y h) a0)) ;
   VN (V : VT) : U l = (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (a0 : FAx Y h)
    -> Id (PC.TB x Y') ((extP (E.ob x) (B.ty x)).act Y' Y j (PC.prB x Y (PC.prA x Y (pH Y h) a0) (V Y h a0)))
         (PC.prB x Y' (PC.prA x Y' (pH Y' (compH Y' Y X h j)) (aAct Y' Y j h a0)) (V Y' (compH Y' Y X h j) (aAct Y' Y j h a0))) ;
   mk (V : VT) (n : VN V) : PiK =
    (V, \ Y Y' h j a0 ->
      GPR.TyL[E.ob x, B.ty x].pr-inj Y' (PC.prA x Y' (pH Y' (compH Y' Y X h j)) (aAct Y' Y j h a0))
       ((B.ty x).tact Y' Y j (PC.prA x Y (pH Y h) a0) (PC.prA x Y' (pH Y' (compH Y' Y X h j)) (aAct Y' Y j h a0)) (aAct-pr Y' Y j h a0) (V Y h a0))
       (V Y' (compH Y' Y X h j) (aAct Y' Y j h a0))
       (transH (symH (GPR.TyL[E.ob x, B.ty x].pr-tact Y' Y j (PC.prA x Y (pH Y h) a0)
                        (PC.prA x Y' (pH Y' (compH Y' Y X h j)) (aAct Y' Y j h a0)) (aAct-pr Y' Y j h a0) (V Y h a0)))
          (n Y' Y j h a0))) ;
   -- the point over h, at the identity of C
   rH (Y : Ob) (h : Hom Y X) : Id (W0.Ix ((G.ob x).ob Y)) (pH Y h) (PC.At[x, X, gm].ptH x (cid x) Y h) =
    apH (\ p -> (G.ob x).act Y X h p) (symH (G.act-id x X gm)) ;
  } ;

  ------------------------------------------------------------------
  -- the comparison map: the component at the identity of C

  cmpE (x : CO) (X : Ob) (wP : PC.TP x X) : AtK[x, X, fstE (G.ob x) (PC.piTy x) X wP].PiK =
   GPR.TyL[G.ob x, PC.PiB x].coeT X (PC.At[x, X, fstE (G.ob x) (PC.piTy x) X wP].ptC x (cid x)) (fstE (G.ob x) (PC.piTy x) X wP)
    (G.act-id x X (fstE (G.ob x) (PC.piTy x) X wP)) ((sndE (G.ob x) (PC.piTy x) X wP).1 x (cid x)) ;
  cmpT (x : CO) (X : Ob) (wP : PC.TP x X) : TK x X = pairE (G.ob x) (PC.PiB x) X (fstE (G.ob x) (PC.piTy x) X wP) (cmpE x X wP) ;
  -- the component at the identity, as a total, is cmpT
  cmpT-id (x : CO) (X : Ob) (wP : PC.TP x X)
   : Id (TK x X) (pairE (G.ob x) (PC.PiB x) X (PC.At[x, X, fstE (G.ob x) (PC.piTy x) X wP].ptC x (cid x)) ((sndE (G.ob x) (PC.piTy x) X wP).1 x (cid x)))
       (cmpT x X wP) =
   GPR.TyL[G.ob x, PC.PiB x].pr-coe X (PC.At[x, X, fstE (G.ob x) (PC.piTy x) X wP].ptC x (cid x)) (fstE (G.ob x) (PC.piTy x) X wP)
    (G.act-id x X (fstE (G.ob x) (PC.piTy x) X wP)) ((sndE (G.ob x) (PC.piTy x) X wP).1 x (cid x)) ;
  cmp-val (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (u : PC.At[x, X, gm].PiIx) (Y : Ob) (h : Hom Y X) (a0 : AtK[x, X, gm].FAx Y h)
   : Id (PC.TB x Y) (AtK[x, X, gm].vT (cmpE x X (PC.prP x X gm u)) Y h a0)
       (PC.At[x, X, gm].valAt u.1 x (cid x) Y h (PC.prA x Y (AtK[x, X, gm].pH Y h) a0) (AtK[x, X, gm].rH Y h)) =
   PC.coeVal x X (PC.At[x, X, gm].ptC x (cid x)) gm (G.act-id x X gm) (u.1 x (cid x)) Y h a0 (AtK[x, X, gm].rH Y h) ;

  -- cmpT is natural in the base
  cmp-B (x : CO) (X' X : Ob) (k : Hom X' X) (wP : PC.TP x X)
   : Id (TK x X') ((extP (G.ob x) (PC.PiB x)).act X' X k (cmpT x X wP)) (cmpT x X' ((extP (G.ob x) (PC.piTy x)).act X' X k wP)) =
   transH (apH (\ v -> (extP (G.ob x) (PC.PiB x)).act X' X k v) (symH (cmpT-id x X wP)))
    (transH (GPR.TyL[G.ob x, PC.PiB x].pr-tact X' X k (PC.At[x, X, fstE (G.ob x) (PC.piTy x) X wP].ptC x (cid x))
               (PC.At[x, X', (G.ob x).act X' X k (fstE (G.ob x) (PC.piTy x) X wP)].ptC x (cid x))
               (PC.Act[x, X', X, k, fstE (G.ob x) (PC.piTy x) X wP, (G.ob x).act X' X k (fstE (G.ob x) (PC.piTy x) X wP),
                       refl ((G.ob x).act X' X k (fstE (G.ob x) (PC.piTy x) X wP))].ePt x (cid x))
               ((sndE (G.ob x) (PC.piTy x) X wP).1 x (cid x)))
      (cmpT-id x X' ((extP (G.ob x) (PC.piTy x)).act X' X k wP))) ;

  ------------------------------------------------------------------
  -- the inverse

  module Inv (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (phi : AtK[x, X, gm].PiK) {
   module K = AtK[x, X, gm] ;
   module S = PC.At[x, X, gm] ;
   -- the value at (y , f , h , a0): B.tE f (phi h ab), ab the element of
   -- A_x with A.tE f ab = a0
   module Cmp (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a0 : S.FA y f Y h) {
    w : PC.TA y Y = PC.prA y Y (S.ptH y f Y h) a0 ;
    q : Id (W0.Ix ((G.ob y).ob Y)) (S.ptH y f Y h) ((G.act y x f).nt Y (K.pH Y h)) = symH ((G.act y x f).nt-nat Y X h gm) ;
    ab : K.FAx Y h = ca.back y x f Y w (K.pH Y h) q ;
    wx : PC.TA x Y = PC.prA x Y (K.pH Y h) ab ;
    wx-w : Id (PC.TA y Y) ((A.tE y x f).nt Y wx) w = ca.back-tE y x f Y w (K.pH Y h) q ;
    mT : PC.TB y Y = (B.tE y x f).nt Y (K.vT phi Y h ab) ;
    mT-pt : Id (PC.TA y Y) (fstE (E.ob y) (B.ty y) Y mT) w = transH (B.tE-pt y x f Y (K.vT phi Y h ab)) wx-w ;
    val : W0.Ix ((B.ty y).tob Y w) =
     GPR.TyL[E.ob y, B.ty y].coeT Y (fstE (E.ob y) (B.ty y) Y mT) w mT-pt (sndE (E.ob y) (B.ty y) Y mT) ;
    val-pr : Id (PC.TB y Y) mT (PC.prB y Y w val) =
     GPR.TyL[E.ob y, B.ty y].pr-coe Y (fstE (E.ob y) (B.ty y) Y mT) w mT-pt (sndE (E.ob y) (B.ty y) Y mT) ;
    -- ab is the only element of A_x over a0
    uniq (a1 : K.FAx Y h) (e : Id (PC.TA y Y) ((A.tE y x f).nt Y (PC.prA x Y (K.pH Y h) a1)) w) : Id (K.FAx Y h) a1 ab =
     ca.tE-inj y x f Y (K.pH Y h) a1 ab (transH e (symH wx-w)) ;
   } ;

   -- naturality in the base of the values at (y , f)
   module Nt (y : CO) (f : CH y x) (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (a0 : S.FA y f Y h) {
    module Ky = AtK[y, X, S.ptC y f] ;
    module C1 = Cmp[y, f, Y, h, a0] ;
    module C2 = Cmp[y, f, Y', compH Y' Y X h j, Ky.aAct Y' Y j h a0] ;
    e1 : Id (PC.TA y Y') ((A.tE y x f).nt Y' (PC.prA x Y' (K.pH Y' (compH Y' Y X h j)) (K.aAct Y' Y j h C1.ab))) C2.w =
     transH (apH (\ w1 -> (A.tE y x f).nt Y' w1) (symH (K.aAct-pr Y' Y j h C1.ab)))
      (transH ((A.tE y x f).nt-nat Y' Y j C1.wx)
        (transH (apH (\ w1 -> (E.ob y).act Y' Y j w1) C1.wx-w) (Ky.aAct-pr Y' Y j h a0))) ;
    eab : Id (K.FAx Y' (compH Y' Y X h j)) (K.aAct Y' Y j h C1.ab) C2.ab = C2.uniq (K.aAct Y' Y j h C1.ab) e1 ;
    e2 : Id (PC.TB y Y') ((extP (E.ob y) (B.ty y)).act Y' Y j C1.mT) C2.mT =
     transH (symH ((B.tE y x f).nt-nat Y' Y j (K.vT phi Y h C1.ab)))
      (apH (\ v -> (B.tE y x f).nt Y' v)
        (transH (K.phiNat phi Y' Y j h C1.ab) (apH (\ a1 -> K.vT phi Y' (compH Y' Y X h j) a1) eab))) ;
    res : Id (PC.TB y Y') ((extP (E.ob y) (B.ty y)).act Y' Y j (PC.prB y Y C1.w C1.val)) (PC.prB y Y' C2.w C2.val) =
     transH (apH (\ v -> (extP (E.ob y) (B.ty y)).act Y' Y j v) (symH C1.val-pr)) (transH e2 C2.val-pr) ;
   } ;
   comp : S.Comp = \ y f ->
    AtK[y, X, S.ptC y f].mk (\ Y h a0 -> Cmp[y, f, Y, h, a0].val) (\ Y' Y j h a0 -> Nt[y, f, Y', Y, j, h, a0].res) ;

   -- naturality in C
   module Cn (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a0 : S.FA y f Y h) {
    module C1 = Cmp[y, f, Y, h, a0] ;
    module C3 = Cmp[z, co z y x f g, Y, h, S.aM z y g f Y h a0] ;
    e1 : Id (PC.TA z Y) ((A.tE z x (co z y x f g)).nt Y C1.wx) C3.w =
     transH (A.tE-o z y x f g Y C1.wx)
      (transH (apH (\ w1 -> (A.tE z y g).nt Y w1) C1.wx-w) (S.aM-mv z y g f Y h a0)) ;
    eab : Id (K.FAx Y h) C1.ab C3.ab = C3.uniq C1.ab e1 ;
    e2 : Id (PC.TB z Y) ((B.tE z y g).nt Y C1.mT) C3.mT =
     transH (symH (B.tE-o z y x f g Y (K.vT phi Y h C1.ab)))
      (apH (\ a1 -> (B.tE z x (co z y x f g)).nt Y (K.vT phi Y h a1)) eab) ;
    res : S.CNatAt comp z y g f Y h a0 =
     transH (apH (\ v -> (B.tE z y g).nt Y v) (symH C1.val-pr)) (transH e2 C3.val-pr) ;
   } ;
   el : S.PiIx = (comp, \ z y g f Y h a0 -> Cn[z, y, g, f, Y, h, a0].res) ;
  } ;

  ------------------------------------------------------------------
  -- cmp (inv phi) = phi  (B.tE-id)

  module R1 (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (phi : AtK[x, X, gm].PiK) (Y : Ob) (h : Hom Y X) (a0 : AtK[x, X, gm].FAx Y h) {
   module K = AtK[x, X, gm] ;
   module S = PC.At[x, X, gm] ;
   module I = Inv[x, X, gm, phi] ;
   w0 : PC.TA x Y = PC.prA x Y (K.pH Y h) a0 ;
   a1 : S.FA x (cid x) Y h = S.coeA x (cid x) Y h w0 (K.rH Y h) ;
   module C1 = I.Cmp[x, cid x, Y, h, a1] ;
   eab : Id (K.FAx Y h) a0 C1.ab =
    C1.uniq a0 (transH (A.tE-id x Y w0) (S.coeA-pr x (cid x) Y h w0 (K.rH Y h))) ;
   e1 : Id (PC.TB x Y) (K.vT (cmpE x X (PC.prP x X gm I.el)) Y h a0) C1.mT =
    transH (cmp-val x X gm I.el Y h a0) (symH C1.val-pr) ;
   e2 : Id (PC.TB x Y) C1.mT (K.vT phi Y h a0) =
    transH (B.tE-id x Y (K.vT phi Y h C1.ab)) (apH (\ a2 -> K.vT phi Y h a2) (symH eab)) ;
   res : Id (W0.Ix ((B.ty x).tob Y w0)) ((cmpE x X (PC.prP x X gm I.el)).1 Y h a0) (phi.1 Y h a0) =
    GPR.TyL[E.ob x, B.ty x].pr-inj Y w0 ((cmpE x X (PC.prP x X gm I.el)).1 Y h a0) (phi.1 Y h a0) (transH e1 e2) ;
  } ;
  cmp-inv (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (phi : AtK[x, X, gm].PiK)
   : Id (AtK[x, X, gm].PiK) (cmpE x X (PC.prP x X gm Inv[x, X, gm, phi].el)) phi =
   PP.PiCode[G.ob x, A.ty x, B.ty x].piCode-eq X (PP.PiCode[G.ob x, A.ty x, B.ty x].ptOf X gm)
    (PP.PiCode[G.ob x, A.ty x, B.ty x].cOf X gm) (PP.PiCode[G.ob x, A.ty x, B.ty x].eOf X gm)
    (cmpE x X (PC.prP x X gm Inv[x, X, gm, phi].el)) phi (\ Y h a0 -> R1[x, X, gm, phi, Y, h, a0].res) ;

  ------------------------------------------------------------------
  -- inv (cmp u) = u  (u is natural in C)

  module R2 (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (u : PC.At[x, X, gm].PiIx)
   (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a0 : PC.At[x, X, gm].FA y f Y h) {
   module K = AtK[x, X, gm] ;
   module S = PC.At[x, X, gm] ;
   module I = Inv[x, X, gm, cmpE x X (PC.prP x X gm u)] ;
   module C1 = I.Cmp[y, f, Y, h, a0] ;
   rr : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y ((A.tE y x f).nt Y C1.wx)) (S.ptH y (co y x x (cid x) f) Y h) =
    transH (apH (\ w1 -> fstE (G.ob y) (A.ty y) Y w1) C1.wx-w) (apH (\ c -> S.ptH y c Y h) (symH (co-idl y x f))) ;
   e1 : Id (PC.TB y Y) C1.mT (S.valAt u.1 y (co y x x (cid x) f) Y h ((A.tE y x f).nt Y C1.wx) rr) =
    transH (apH (\ v -> (B.tE y x f).nt Y v) (cmp-val x X gm u Y h C1.ab))
     (S.cnat-at u y x f (cid x) Y h C1.wx (K.rH Y h) rr) ;
   e2 : Id (PC.TB y Y) (S.valAt u.1 y (co y x x (cid x) f) Y h ((A.tE y x f).nt Y C1.wx) rr) (S.valT u.1 y f Y h a0) =
    S.valAt-cong u.1 y (co y x x (cid x) f) f (co-idl y x f) Y h h (refl h) ((A.tE y x f).nt Y C1.wx) C1.w C1.wx-w rr (refl (S.ptH y f Y h)) ;
   res : Id (W0.Ix ((B.ty y).tob Y C1.w)) (S.val I.comp y f Y h a0) (S.val u.1 y f Y h a0) =
    GPR.TyL[E.ob y, B.ty y].pr-inj Y C1.w (S.val I.comp y f Y h a0) (S.val u.1 y f Y h a0)
     (transH (symH C1.val-pr) (transH e1 e2)) ;
  } ;
  inv-cmp (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (u : PC.At[x, X, gm].PiIx)
   : Id (PC.At[x, X, gm].PiIx) Inv[x, X, gm, cmpE x X (PC.prP x X gm u)].el u =
   PC.At[x, X, gm].pi-eq Inv[x, X, gm, cmpE x X (PC.prP x X gm u)].el u (\ y f Y h a0 -> R2[x, X, gm, u, y, f, Y, h, a0].res) ;

  ------------------------------------------------------------------
  -- LEMMA 54

  lemma54 (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) : Iso (PC.At[x, X, gm].PiIx) (AtK[x, X, gm].PiK) =
   new IsoData[PC.At[x, X, gm].PiIx, AtK[x, X, gm].PiK,
    \ u -> cmpE x X (PC.prP x X gm u), \ phi -> Inv[x, X, gm, phi].el,
    cmp-inv x X gm, inv-cmp x X gm] ;
 } ;

 ------------------------------------------------------------------
 -- cartesian C-types: constant ones, and substitution

 -- the constant C-context on a base context, and the constant C-type on
 -- a base type over it (identity C-actions)
 constCtx (G0 : PCtx) : CCtx = new CCtx[\ x -> G0, \ y x f -> idS G0, \ x X g -> refl g, \ z y x f h X g -> refl g] ;
 constTy (G0 : PCtx) (K : PTy[G0]) : CTy[constCtx G0] =
  new CTy[constCtx G0, \ x -> K, \ y x f -> idS (extP G0 K), \ y x f X w -> refl (fstE G0 K X w), \ x X w -> refl w, \ z y x f h X w -> refl w] ;
 cartConst (G0 : PCtx) (K : PTy[G0]) : Cart[constCtx G0, constTy G0 K] =
  new Cart[constCtx G0, constTy G0 K,
   \ y x f Y w p q -> GPR.TyL[G0, K].coeT Y (fstE G0 K Y w) p q (sndE G0 K Y w),
   \ y x f Y w p q -> symH (GPR.TyL[G0, K].pr-coe Y (fstE G0 K Y w) p q (sndE G0 K Y w)),
   \ y x f Y p a0 a1 e -> GPR.TyL[G0, K].pr-inj Y p a0 a1 e] ;

 -- a substituted cartesian C-type is cartesian
 module CartSub (D G : CCtx) (s : CSub[D, G]) (A : CTy[G]) (ca : Cart[G, A]) {
  module SC = LO.SC[D, G, s, A] ;
  qG (y x : CO) (f : CH y x) (Y : Ob) (w : SC.Tt y Y) (p : W0.Ix ((D.ob x).ob Y))
   (q : Id (W0.Ix ((D.ob y).ob Y)) (fstE (D.ob y) (SC.ST y) Y w) ((D.act y x f).nt Y p))
   : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y (SC.rB y Y w)) ((G.act y x f).nt Y ((s.sb x).nt Y p)) =
   transH (apH (\ d -> (s.sb y).nt Y d) q) (s.sb-nat y x f Y p) ;
  bk (y x : CO) (f : CH y x) (Y : Ob) (w : SC.Tt y Y) (p : W0.Ix ((D.ob x).ob Y))
   (q : Id (W0.Ix ((D.ob y).ob Y)) (fstE (D.ob y) (SC.ST y) Y w) ((D.act y x f).nt Y p)) : W0.Ix ((SC.ST x).tob Y p) =
   ca.back y x f Y (SC.rB y Y w) ((s.sb x).nt Y p) (qG y x f Y w p q) ;
  bk-tE (y x : CO) (f : CH y x) (Y : Ob) (w : SC.Tt y Y) (p : W0.Ix ((D.ob x).ob Y))
   (q : Id (W0.Ix ((D.ob y).ob Y)) (fstE (D.ob y) (SC.ST y) Y w) ((D.act y x f).nt Y p))
   : Id (SC.Tt y Y) (SC.tEs y x f Y (pairE (D.ob x) (SC.ST x) Y p (bk y x f Y w p q))) w =
   SC.sub-eq y Y (SC.tEs y x f Y (pairE (D.ob x) (SC.ST x) Y p (bk y x f Y w p q))) w (symH q)
    (transH (SC.rBtE y x f Y (pairE (D.ob x) (SC.ST x) Y p (bk y x f Y w p q)))
      (ca.back-tE y x f Y (SC.rB y Y w) ((s.sb x).nt Y p) (qG y x f Y w p q))) ;
  inj (y x : CO) (f : CH y x) (Y : Ob) (p : W0.Ix ((D.ob x).ob Y)) (a0 a1 : W0.Ix ((SC.ST x).tob Y p))
   (e : Id (SC.Tt y Y) (SC.tEs y x f Y (pairE (D.ob x) (SC.ST x) Y p a0)) (SC.tEs y x f Y (pairE (D.ob x) (SC.ST x) Y p a1)))
   : Id (W0.Ix ((SC.ST x).tob Y p)) a0 a1 =
   ca.tE-inj y x f Y ((s.sb x).nt Y p) a0 a1
    (transH (symH (SC.rBtE y x f Y (pairE (D.ob x) (SC.ST x) Y p a0)))
      (transH (apH (\ w1 -> SC.rB y Y w1) e) (SC.rBtE y x f Y (pairE (D.ob x) (SC.ST x) Y p a1)))) ;
  cart : Cart[D, LO.subCTy D G s A] = new Cart[D, LO.subCTy D G s A, bk, bk-tE, inj] ;
 } ;

 ------------------------------------------------------------------
 -- Delta K over a C-context G, for a base type K over a base context G0
 -- and a map s of G to the constant C-context on G0 (for K closed, G0 the
 -- empty context); Lemma 54 for it

 module Delta (G0 : PCtx) (K : PTy[G0]) (G : CCtx) (s : CSub[G, constCtx G0]) {
  DK : CTy[G] = LO.subCTy G (constCtx G0) s (constTy G0 K) ;
  cartDK : Cart[G, DK] = CartSub[G, constCtx G0, s, constTy G0 K, cartConst G0 K].cart ;
  lemma54K (B : CTy[LO.ExtC G DK]) (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X))
   : Iso (M[G, DK, B, cartDK].PC.At[x, X, gm].PiIx) (M[G, DK, B, cartDK].AtK[x, X, gm].PiK) =
   M[G, DK, B, cartDK].lemma54 x X gm ;
 } ;
} ;
