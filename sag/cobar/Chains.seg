-- Chains.seg (canonicity-45; COBAR.md): chains of composable maps of a
-- V-small category C, coded in V (for PiS over them), with their faces.
--
--   Ch n x z     chains f0 : x0 -> x, f1 : x1 -> x0, ..., fn : z -> x_(n-1)
--                (n+1 maps) from z to x; the LAST object z is an index, so
--                that composing two adjacent maps keeps it by typing.
--                Ch 0 x z = Hom z x ; Ch (n+1) x z = (y , f0 : y -> x , Ch n y z).
--                chV n x z is its V-code (Ch n x z = Ix (chV n x z)).
--   comp n k     Ch (n+1) x z -> Ch n x z, composing f_k f_(k+1) (k <= n;
--                at n = 0 every k is 0)
--   drop n       Ch (n+1) x z -> (z' : CO) * Ch n x z' * Hom z z': forget the
--                last map, returning it (last-map)
--   rx n g       reindexing along g : x' -> x: Ch n x' z -> Ch n x z, f0 |-> g f0
-- Semisimplicial identities (Unit paths; refl except where associativity
-- enters):
--   comp-comp    comp k . comp l = comp (l-1) . comp k      (k < l <= n+1)
--   comp-drop    drop . comp k   = comp k on the chain of drop, same map (k <= n)
--   drop-drop    drop . comp (n+1) = drop . drop, the maps composed
--   rx-id, rx-o, rx-comp, rx-drop   reindexing is functorial and commutes
--                with the faces
level a ;
open Base ;
open Prelude[a] ;
open Trees[a] ;
open Arith[a] ;
module VA = V[a] ;

module ChainsOf (C : SmallCat[a].SmallCat) {
 CO : U a = SmallCat[a].Objs[C.obV].Ob ;
 CH (y x : CO) : U a = SmallCat[a].Homs[C.obV, C.homV].Hom y x ;
 co (z y x : CO) (f : CH y x) (h : CH z y) : CH z x = C.oC z y x f h ;

 chV : Nat -> CO -> CO -> VA.V = split {
  zero -> \ x z -> C.homV z x ;
  suc n | r -> \ x z -> VA.SigV C.obV (\ y -> VA.SigV (C.homV y x) (\ f -> r y z)) } ;
 Ch (n : Nat) (x z : CO) : U a = VA.Ix (chV n x z) ;

 -- the result of dropping the last map
 DR (n : Nat) (x z : CO) : U a = (z' : CO) * Ch n x z' * CH z z' ;

 comp : (n : Nat) -> Nat -> (x z : CO) -> Ch (suc n) x z -> Ch n x z = split {
  zero -> \ k x z c -> co z c.1 x c.2.1 c.2.2 ;
  suc m | r -> split {
   zero -> \ x z c -> (c.2.2.1, co c.2.2.1 c.1 x c.2.1 c.2.2.2.1, c.2.2.2.2) ;
   suc k -> \ x z c -> (c.1, c.2.1, r k c.1 z c.2.2) } } ;

 drop : (n : Nat) -> (x z : CO) -> Ch (suc n) x z -> DR n x z = split {
  zero -> \ x z c -> (c.1, c.2.1, c.2.2) ;
  suc m | r -> \ x z c -> ((r c.1 z c.2.2).1, (c.1, c.2.1, (r c.1 z c.2.2).2.1), (r c.1 z c.2.2).2.2) } ;

 rx : (n : Nat) -> (x' x : CO) -> CH x' x -> (z : CO) -> Ch n x' z -> Ch n x z = split {
  zero -> \ x' x g z c -> co z x' x g c ;
  suc m -> \ x' x g z c -> (c.1, co c.1 x' x g c.2.1, c.2.2) } ;

 ------------------------------------------------------------------
 -- comp . comp

 CCTy (n : Nat) : U a = (k l : Nat) -> IsT (ltb k l) -> IsT (leb l (suc n)) -> (x z : CO) (c : Ch (suc (suc n)) x z)
  -> Id (Ch n x z) (comp n k x z (comp (suc n) l x z c)) (comp n (pred l) x z (comp (suc n) k x z c)) ;

 -- k >= 1 , k < l <= 1 is impossible
 nb1 : (l1 k1 : Nat) -> IsT (ltb (suc k1) (suc l1)) -> IsT (leb (suc l1) (suc zero)) -> Empty = split {
  zero -> \ k1 h1 h2 -> false-true h1 ;
  suc l2 -> \ k1 h1 h2 -> false-true h2 } ;
 nb : (l k1 : Nat) -> IsT (ltb (suc k1) l) -> IsT (leb l (suc zero)) -> Empty = split {
  zero -> \ k1 h1 h2 -> false-true h1 ;
  suc l1 -> nb1 l1 } ;

 -- n = 0 , k = 0 , l = 1: associativity
 ccA : (l1 : Nat) -> IsT (ltb zero (suc l1)) -> IsT (leb (suc l1) (suc zero)) -> (x z : CO) (c : Ch (suc (suc zero)) x z)
  -> Id (Ch zero x z) (comp zero zero x z (comp (suc zero) (suc l1) x z c)) (comp zero l1 x z (comp (suc zero) zero x z c)) = split {
  zero -> \ h1 h2 x z c ->
   sym (CH z x) (co z c.2.2.1 x (co c.2.2.1 c.1 x c.2.1 c.2.2.2.1) c.2.2.2.2) (co z c.1 x c.2.1 (co z c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2))
    (C.oC-assoc z c.2.2.1 c.1 x c.2.1 c.2.2.2.1 c.2.2.2.2) ;
  suc l2 -> \ h1 h2 x z c -> absurd _ (false-true h2) } ;

 -- n = m+1 , k = 0
 ccC (m : Nat) : (l1 : Nat) -> IsT (ltb zero (suc l1)) -> IsT (leb (suc l1) (suc (suc m))) -> (x z : CO) (c : Ch (suc (suc (suc m))) x z)
  -> Id (Ch (suc m) x z) (comp (suc m) zero x z (comp (suc (suc m)) (suc l1) x z c)) (comp (suc m) l1 x z (comp (suc (suc m)) zero x z c)) = split {
  zero -> \ h1 h2 x z c ->
   ap (CH c.2.2.2.2.1 x) (Ch (suc m) x z) (\ h -> (c.2.2.2.2.1, h, c.2.2.2.2.2.2))
    (co c.2.2.2.2.1 c.1 x c.2.1 (co c.2.2.2.2.1 c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2.2.1))
    (co c.2.2.2.2.1 c.2.2.1 x (co c.2.2.1 c.1 x c.2.1 c.2.2.2.1) c.2.2.2.2.2.1)
    (sym (CH c.2.2.2.2.1 x) (co c.2.2.2.2.1 c.2.2.1 x (co c.2.2.1 c.1 x c.2.1 c.2.2.2.1) c.2.2.2.2.2.1)
       (co c.2.2.2.2.1 c.1 x c.2.1 (co c.2.2.2.2.1 c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2.2.1))
       (C.oC-assoc c.2.2.2.2.1 c.2.2.1 c.1 x c.2.1 c.2.2.2.1 c.2.2.2.2.2.1)) ;
  suc l2 -> \ h1 h2 x z c -> refl (comp (suc m) zero x z (comp (suc (suc m)) (suc (suc l2)) x z c)) } ;

 -- n = m+1 , k = k1+1: under the first map, by induction
 ccD (m : Nat) (ih : CCTy m) (k1 : Nat) : (l1 : Nat) -> IsT (ltb (suc k1) (suc l1)) -> IsT (leb (suc l1) (suc (suc m)))
  -> (x z : CO) (c : Ch (suc (suc (suc m))) x z)
  -> Id (Ch (suc m) x z) (comp (suc m) (suc k1) x z (comp (suc (suc m)) (suc l1) x z c)) (comp (suc m) l1 x z (comp (suc (suc m)) (suc k1) x z c)) = split {
  zero -> \ h1 h2 x z c -> absurd _ (false-true h1) ;
  suc l2 -> \ h1 h2 x z c ->
   ap (Ch m c.1 z) (Ch (suc m) x z) (\ t -> (c.1, c.2.1, t))
    (comp m k1 c.1 z (comp (suc m) (suc l2) c.1 z c.2.2)) (comp m l2 c.1 z (comp (suc m) k1 c.1 z c.2.2))
    (ih k1 (suc l2) h1 h2 c.1 z c.2.2) } ;

 comp-comp : (n : Nat) -> CCTy n = split {
  zero -> split {
   zero -> split {
    zero -> \ h1 h2 x z c -> absurd _ (false-true h1) ;
    suc l1 -> ccA l1 } ;
   suc k1 -> \ l h1 h2 x z c -> absurd _ (nb l k1 h1 h2) } ;
  suc m | ih -> split {
   zero -> split {
    zero -> \ h1 h2 x z c -> absurd _ (false-true h1) ;
    suc l1 -> ccC m l1 } ;
   suc k1 -> split {
    zero -> \ h1 h2 x z c -> absurd _ (false-true h1) ;
    suc l1 -> ccD m ih k1 l1 } } } ;

 ------------------------------------------------------------------
 -- drop . comp

 -- the drop of a chain, with comp k applied to its chain
 dropComp (n k : Nat) (x z : CO) (c : Ch (suc (suc n)) x z) : DR n x z =
  ((drop (suc n) x z c).1, comp n k x (drop (suc n) x z c).1 (drop (suc n) x z c).2.1, (drop (suc n) x z c).2.2) ;

 comp-drop : (n k : Nat) -> IsT (leb k n) -> (x z : CO) (c : Ch (suc (suc n)) x z)
  -> Id (DR n x z) (drop n x z (comp (suc n) k x z c)) (dropComp n k x z c) = split {
  zero -> split {
   zero -> \ h x z c -> refl (drop zero x z (comp (suc zero) zero x z c)) ;
   suc k1 -> \ h x z c -> absurd _ (false-true h) } ;
  suc m | ih -> split {
   zero -> \ h x z c -> refl (drop (suc m) x z (comp (suc (suc m)) zero x z c)) ;
   suc k1 -> \ h x z c ->
    ap (DR m c.1 z) (DR (suc m) x z) (\ D -> (D.1, (c.1, c.2.1, D.2.1), D.2.2))
     (drop m c.1 z (comp (suc m) k1 c.1 z c.2.2)) (dropComp m k1 c.1 z c.2.2)
     (ih k1 h c.1 z c.2.2) } } ;

 -- drop . comp (n+1) = drop . drop, with the maps composed
 dropDrop (n : Nat) (x z : CO) (c : Ch (suc (suc n)) x z) : DR n x z =
  ((drop n x (drop (suc n) x z c).1 (drop (suc n) x z c).2.1).1,
   (drop n x (drop (suc n) x z c).1 (drop (suc n) x z c).2.1).2.1,
   co z (drop (suc n) x z c).1 (drop n x (drop (suc n) x z c).1 (drop (suc n) x z c).2.1).1
      (drop n x (drop (suc n) x z c).1 (drop (suc n) x z c).2.1).2.2 (drop (suc n) x z c).2.2) ;

 drop-drop : (n : Nat) -> (x z : CO) (c : Ch (suc (suc n)) x z)
  -> Id (DR n x z) (drop n x z (comp (suc n) (suc n) x z c)) (dropDrop n x z c) = split {
  zero -> \ x z c -> refl (drop zero x z (comp (suc zero) (suc zero) x z c)) ;
  suc m | ih -> \ x z c ->
   ap (DR m c.1 z) (DR (suc m) x z) (\ D -> (D.1, (c.1, c.2.1, D.2.1), D.2.2))
    (drop m c.1 z (comp (suc m) (suc m) c.1 z c.2.2)) (dropDrop m c.1 z c.2.2)
    (ih c.1 z c.2.2) } ;

 ------------------------------------------------------------------
 -- reindexing

 rx-id : (n : Nat) -> (x z : CO) (c : Ch n x z) -> Id (Ch n x z) (rx n x x (C.idC x) z c) c = split {
  zero -> \ x z c -> C.oC-idl z x c ;
  suc m -> \ x z c -> ap (CH c.1 x) (Ch (suc m) x z) (\ f -> (c.1, f, c.2.2)) (co c.1 x x (C.idC x) c.2.1) c.2.1 (C.oC-idl c.1 x c.2.1) } ;

 rx-o : (n : Nat) -> (x'' x' x : CO) (g : CH x' x) (g' : CH x'' x') (z : CO) (c : Ch n x'' z)
  -> Id (Ch n x z) (rx n x'' x (co x'' x' x g g') z c) (rx n x' x g z (rx n x'' x' g' z c)) = split {
  zero -> \ x'' x' x g g' z c -> C.oC-assoc z x'' x' x g g' c ;
  suc m -> \ x'' x' x g g' z c -> ap (CH c.1 x) (Ch (suc m) x z) (\ f -> (c.1, f, c.2.2))
    (co c.1 x'' x (co x'' x' x g g') c.2.1) (co c.1 x' x g (co c.1 x'' x' g' c.2.1)) (C.oC-assoc c.1 x'' x' x g g' c.2.1) } ;

 rx-comp : (n k : Nat) -> (x' x : CO) (g : CH x' x) (z : CO) (c : Ch (suc n) x' z)
  -> Id (Ch n x z) (comp n k x z (rx (suc n) x' x g z c)) (rx n x' x g z (comp n k x' z c)) = split {
  zero -> \ k x' x g z c -> C.oC-assoc z c.1 x' x g c.2.1 c.2.2 ;
  suc m -> split {
   zero -> \ x' x g z c -> ap (CH c.2.2.1 x) (Ch (suc m) x z) (\ f -> (c.2.2.1, f, c.2.2.2.2))
     (co c.2.2.1 c.1 x (co c.1 x' x g c.2.1) c.2.2.2.1) (co c.2.2.1 x' x g (co c.2.2.1 c.1 x' c.2.1 c.2.2.2.1))
     (C.oC-assoc c.2.2.1 c.1 x' x g c.2.1 c.2.2.2.1) ;
   suc k1 -> \ x' x g z c -> refl (comp (suc m) (suc k1) x z (rx (suc (suc m)) x' x g z c)) } } ;

 rx-drop : (n : Nat) -> (x' x : CO) (g : CH x' x) (z : CO) (c : Ch (suc n) x' z)
  -> Id (DR n x z) (drop n x z (rx (suc n) x' x g z c))
       ((drop n x' z c).1, rx n x' x g (drop n x' z c).1 (drop n x' z c).2.1, (drop n x' z c).2.2) = split {
  zero -> \ x' x g z c -> refl (drop zero x z (rx (suc zero) x' x g z c)) ;
  suc m -> \ x' x g z c -> refl (drop (suc m) x z (rx (suc (suc m)) x' x g z c)) } ;

 ------------------------------------------------------------------
 -- the total composite f0 f1 ... fn : z -> x

 tot : (n : Nat) -> (x z : CO) -> Ch n x z -> CH z x = split {
  zero -> \ x z c -> c ;
  suc m | r -> \ x z c -> co z c.1 x c.2.1 (r c.1 z c.2.2) } ;

 tot-comp : (n k : Nat) -> (x z : CO) (c : Ch (suc n) x z) -> Id (CH z x) (tot n x z (comp n k x z c)) (tot (suc n) x z c) = split {
  zero -> \ k x z c -> refl (co z c.1 x c.2.1 c.2.2) ;
  suc m | ih -> split {
   zero -> \ x z c -> C.oC-assoc z c.2.2.1 c.1 x c.2.1 c.2.2.2.1 (tot m c.2.2.1 z c.2.2.2.2) ;
   suc k1 -> \ x z c -> ap (CH z c.1) (CH z x) (\ h -> co z c.1 x c.2.1 h)
     (tot m c.1 z (comp m k1 c.1 z c.2.2)) (tot (suc m) c.1 z c.2.2) (ih k1 c.1 z c.2.2) } } ;

 tot-drop : (n : Nat) -> (x z : CO) (c : Ch (suc n) x z)
  -> Id (CH z x) (tot (suc n) x z c) (co z (drop n x z c).1 x (tot n x (drop n x z c).1 (drop n x z c).2.1) (drop n x z c).2.2) = split {
  zero -> \ x z c -> refl (co z c.1 x c.2.1 c.2.2) ;
  suc m | ih -> \ x z c ->
   trans (CH z x) (tot (suc (suc m)) x z c)
    (co z c.1 x c.2.1 (co z (drop m c.1 z c.2.2).1 c.1 (tot m c.1 (drop m c.1 z c.2.2).1 (drop m c.1 z c.2.2).2.1) (drop m c.1 z c.2.2).2.2))
    (co z (drop m c.1 z c.2.2).1 x (co (drop m c.1 z c.2.2).1 c.1 x c.2.1 (tot m c.1 (drop m c.1 z c.2.2).1 (drop m c.1 z c.2.2).2.1)) (drop m c.1 z c.2.2).2.2)
    (ap (CH z c.1) (CH z x) (\ h -> co z c.1 x c.2.1 h) (tot (suc m) c.1 z c.2.2)
       (co z (drop m c.1 z c.2.2).1 c.1 (tot m c.1 (drop m c.1 z c.2.2).1 (drop m c.1 z c.2.2).2.1) (drop m c.1 z c.2.2).2.2) (ih c.1 z c.2.2))
    (sym (CH z x)
       (co z (drop m c.1 z c.2.2).1 x (co (drop m c.1 z c.2.2).1 c.1 x c.2.1 (tot m c.1 (drop m c.1 z c.2.2).1 (drop m c.1 z c.2.2).2.1)) (drop m c.1 z c.2.2).2.2)
       (co z c.1 x c.2.1 (co z (drop m c.1 z c.2.2).1 c.1 (tot m c.1 (drop m c.1 z c.2.2).1 (drop m c.1 z c.2.2).2.1) (drop m c.1 z c.2.2).2.2))
       (C.oC-assoc z (drop m c.1 z c.2.2).1 c.1 x c.2.1 (tot m c.1 (drop m c.1 z c.2.2).1 (drop m c.1 z c.2.2).2.1) (drop m c.1 z c.2.2).2.2)) } ;

 tot-rx : (n : Nat) -> (x' x : CO) (g : CH x' x) (z : CO) (c : Ch n x' z)
  -> Id (CH z x) (tot n x z (rx n x' x g z c)) (co z x' x g (tot n x' z c)) = split {
  zero -> \ x' x g z c -> refl (co z x' x g c) ;
  suc m -> \ x' x g z c -> C.oC-assoc z c.1 x' x g c.2.1 (tot m c.1 z c.2.2) } ;

 ------------------------------------------------------------------
 -- uniform faces: fc n k is (z , comp k , id) for k <= n and drop for
 -- k = n+1; dd n k l = d_k after d_l, the maps composed

 liftD (n : Nat) (x y0 z : CO) (f0 : CH y0 x) (D : DR n y0 z) : DR (suc n) x z = (D.1, (y0, f0, D.2.1), D.2.2) ;

 fc : (n : Nat) -> Nat -> (x z : CO) -> Ch (suc n) x z -> DR n x z = split {
  zero -> split {
   zero -> \ x z c -> (z, comp zero zero x z c, C.idC z) ;
   suc k -> \ x z c -> drop zero x z c } ;
  suc m | r -> split {
   zero -> \ x z c -> (z, comp (suc m) zero x z c, C.idC z) ;
   suc k -> \ x z c -> liftD m x c.1 z c.2.1 (r k c.1 z c.2.2) } } ;

 dd (n k l : Nat) (x z : CO) (c : Ch (suc (suc n)) x z) : DR n x z =
  ((fc n k x (fc (suc n) l x z c).1 (fc (suc n) l x z c).2.1).1,
   (fc n k x (fc (suc n) l x z c).1 (fc (suc n) l x z c).2.1).2.1,
   co z (fc (suc n) l x z c).1 (fc n k x (fc (suc n) l x z c).1 (fc (suc n) l x z c).2.1).1
     (fc n k x (fc (suc n) l x z c).1 (fc (suc n) l x z c).2.1).2.2 (fc (suc n) l x z c).2.2) ;

 FFTy (n : Nat) : U a = (k l : Nat) -> IsT (ltb k l) -> IsT (leb l (suc (suc n))) -> (x z : CO) (c : Ch (suc (suc n)) x z)
  -> Id (DR n x z) (dd n k l x z c) (dd n (pred l) k x z c) ;

 -- a path of DR from paths of its chain and map, at the same last object
 drEq (n : Nat) (x z z' : CO) (c c' : Ch n x z') (m m' : CH z z') (p : Id (Ch n x z') c c') (q : Id (CH z z') m m')
  : Id (DR n x z) (z', c, m) (z', c', m') =
  trans (DR n x z) (z', c, m) (z', c', m) (z', c', m')
   (ap (Ch n x z') (DR n x z) (\ c2 -> (z', c2, m)) c c' p)
   (ap (CH z z') (DR n x z) (\ m2 -> (z', c', m2)) m m' q) ;

 -- the identity on either side of a map
 idlr (z y : CO) (m : CH z y) : Id (CH z y) (co z y y (C.idC y) m) (co z z y m (C.idC z)) =
  trans (CH z y) (co z y y (C.idC y) m) m (co z z y m (C.idC z)) (C.oC-idl z y m) (sym (CH z y) (co z z y m (C.idC z)) m (C.oC-idr z y m)) ;

 -- n = 0
 FT0 (k l : Nat) : U a = IsT (ltb k l) -> IsT (leb l (suc (suc zero))) -> (x z : CO) (c : Ch (suc (suc zero)) x z)
  -> Id (DR zero x z) (dd zero k l x z c) (dd zero (pred l) k x z c) ;

 ff0B : (l2 : Nat) -> FT0 zero (suc (suc l2)) = split {
  zero -> \ h1 h2 x z c -> drEq zero x z c.2.2.1 _ _ _ _ (refl (co c.2.2.1 c.1 x c.2.1 c.2.2.2.1)) (idlr z c.2.2.1 c.2.2.2.2) ;
  suc l3 -> \ h1 h2 x z c -> absurd _ (false-true h2) } ;
 ff0A : (l1 : Nat) -> FT0 zero (suc l1) = split {
  zero -> \ h1 h2 x z c ->
   drEq zero x z z _ _ _ _
    (sym (CH z x) (co z c.2.2.1 x (co c.2.2.1 c.1 x c.2.1 c.2.2.2.1) c.2.2.2.2) (co z c.1 x c.2.1 (co z c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2))
       (C.oC-assoc z c.2.2.1 c.1 x c.2.1 c.2.2.2.1 c.2.2.2.2))
    (refl (co z z z (C.idC z) (C.idC z))) ;
  suc l2 -> ff0B l2 } ;
 ff0E : (k1 : Nat) -> FT0 (suc k1) (suc (suc zero)) = split {
  zero -> \ h1 h2 x z c ->
   drEq zero x z c.1 _ _ _ _ (refl c.2.1)
    (sym (CH z c.1) (co z z c.1 (co z c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2) (C.idC z)) (co z c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2)
       (C.oC-idr z c.1 (co z c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2))) ;
  suc k2 -> \ h1 h2 x z c -> absurd _ (false-true h1) } ;
 ff0D : (l2 k1 : Nat) -> FT0 (suc k1) (suc (suc l2)) = split {
  zero -> \ k1 -> ff0E k1 ;
  suc l3 -> \ k1 h1 h2 x z c -> absurd _ (false-true h2) } ;
 ff0C1 : (l1 k1 : Nat) -> FT0 (suc k1) (suc l1) = split {
  zero -> \ k1 h1 h2 x z c -> absurd _ (false-true h1) ;
  suc l2 -> ff0D l2 } ;
 ff0C : (l k1 : Nat) -> FT0 (suc k1) l = split {
  zero -> \ k1 h1 h2 x z c -> absurd _ (false-true h1) ;
  suc l1 -> ff0C1 l1 } ;
 ff0 : (k l : Nat) -> FT0 k l = split {
  zero -> split {
   zero -> \ h1 h2 x z c -> absurd _ (false-true h1) ;
   suc l1 -> ff0A l1 } ;
  suc k1 -> \ l -> ff0C l k1 } ;

 -- n = m+1
 FTS (m k l : Nat) : U a = IsT (ltb k l) -> IsT (leb l (suc (suc (suc m)))) -> (x z : CO) (c : Ch (suc (suc (suc m))) x z)
  -> Id (DR (suc m) x z) (dd (suc m) k l x z c) (dd (suc m) (pred l) k x z c) ;

 ffSA (m : Nat) : (l1 : Nat) -> FTS m zero (suc l1) = split {
  zero -> \ h1 h2 x z c ->
   drEq (suc m) x z z _ _ _ _
    (ap (CH c.2.2.2.2.1 x) (Ch (suc m) x z) (\ h -> (c.2.2.2.2.1, h, c.2.2.2.2.2.2))
      (co c.2.2.2.2.1 c.1 x c.2.1 (co c.2.2.2.2.1 c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2.2.1))
      (co c.2.2.2.2.1 c.2.2.1 x (co c.2.2.1 c.1 x c.2.1 c.2.2.2.1) c.2.2.2.2.2.1)
      (sym (CH c.2.2.2.2.1 x) (co c.2.2.2.2.1 c.2.2.1 x (co c.2.2.1 c.1 x c.2.1 c.2.2.2.1) c.2.2.2.2.2.1)
         (co c.2.2.2.2.1 c.1 x c.2.1 (co c.2.2.2.2.1 c.2.2.1 c.1 c.2.2.2.1 c.2.2.2.2.2.1))
         (C.oC-assoc c.2.2.2.2.1 c.2.2.1 c.1 x c.2.1 c.2.2.2.1 c.2.2.2.2.2.1)))
    (refl (co z z z (C.idC z) (C.idC z))) ;
  suc l2 -> \ h1 h2 x z c ->
   drEq (suc m) x z (fc m l2 c.2.2.1 z c.2.2.2.2).1 _ _ _ _
    (refl (c.2.2.1, co c.2.2.1 c.1 x c.2.1 c.2.2.2.1, (fc m l2 c.2.2.1 z c.2.2.2.2).2.1))
    (idlr z (fc m l2 c.2.2.1 z c.2.2.2.2).1 (fc m l2 c.2.2.1 z c.2.2.2.2).2.2) } ;

 ffSB (m : Nat) (ih : FFTy m) (k1 : Nat) : (l1 : Nat) -> FTS m (suc k1) (suc l1) = split {
  zero -> \ h1 h2 x z c -> absurd _ (false-true h1) ;
  suc l2 -> \ h1 h2 x z c ->
   ap (DR m c.1 z) (DR (suc m) x z) (liftD m x c.1 z c.2.1)
    (dd m k1 (suc l2) c.1 z c.2.2) (dd m l2 k1 c.1 z c.2.2) (ih k1 (suc l2) h1 h2 c.1 z c.2.2) } ;

 ff-fc : (n : Nat) -> FFTy n = split {
  zero -> ff0 ;
  suc m | ih -> split {
   zero -> split {
    zero -> \ h1 h2 x z c -> absurd _ (false-true h1) ;
    suc l1 -> ffSA m l1 } ;
   suc k1 -> split {
    zero -> \ h1 h2 x z c -> absurd _ (false-true h1) ;
    suc l1 -> ffSB m ih k1 l1 } } } ;

 -- fc is comp (with the identity) below the top, and drop at the top
 fc-comp : (n k : Nat) -> IsT (leb k n) -> (x z : CO) (c : Ch (suc n) x z)
  -> Id (DR n x z) (fc n k x z c) (z, comp n k x z c, C.idC z) = split {
  zero -> split {
   zero -> \ h x z c -> refl (z, comp zero zero x z c, C.idC z) ;
   suc k1 -> \ h x z c -> absurd _ (false-true h) } ;
  suc m | ih -> split {
   zero -> \ h x z c -> refl (z, comp (suc m) zero x z c, C.idC z) ;
   suc k1 -> \ h x z c -> ap (DR m c.1 z) (DR (suc m) x z) (liftD m x c.1 z c.2.1) _ _ (ih k1 h c.1 z c.2.2) } } ;

 fc-top : (n : Nat) -> (x z : CO) (c : Ch (suc n) x z) -> Id (DR n x z) (fc n (suc n) x z c) (drop n x z c) = split {
  zero -> \ x z c -> refl (drop zero x z c) ;
  suc m | ih -> \ x z c -> ap (DR m c.1 z) (DR (suc m) x z) (liftD m x c.1 z c.2.1) _ _ (ih c.1 z c.2.2) } ;

 -- the uniform faces commute with reindexing
 rxD (n : Nat) (x' x : CO) (g : CH x' x) (z : CO) (D : DR n x' z) : DR n x z = (D.1, rx n x' x g D.1 D.2.1, D.2.2) ;

 rx-fc : (n k : Nat) -> (x' x : CO) (g : CH x' x) (z : CO) (c : Ch (suc n) x' z)
  -> Id (DR n x z) (fc n k x z (rx (suc n) x' x g z c)) (rxD n x' x g z (fc n k x' z c)) = split {
  zero -> split {
   zero -> \ x' x g z c -> drEq zero x z z _ _ _ _ (rx-comp zero zero x' x g z c) (refl (C.idC z)) ;
   suc k1 -> \ x' x g z c -> refl (drop zero x z (rx (suc zero) x' x g z c)) } ;
  suc m -> split {
   zero -> \ x' x g z c -> drEq (suc m) x z z _ _ _ _ (rx-comp (suc m) zero x' x g z c) (refl (C.idC z)) ;
   suc k1 -> \ x' x g z c -> refl (fc (suc m) (suc k1) x z (rx (suc (suc m)) x' x g z c)) } } ;

 ------------------------------------------------------------------
 -- concatenation (Lemma 16): cat m n c' c = f0 .. fm f'0 .. f'n, of
 -- arity plus m (suc n) by recursion on m (as Weights.catC).  The faces
 -- in the first block and at the junction are definitional in arity;
 -- the faces in the second block need the transport trCh along plus-suc.

 cat : (m : Nat) -> (n : Nat) -> (x y z : CO) -> Ch m x y -> Ch n y z -> Ch (plus m (suc n)) x z = split {
  zero -> \ n x y z f c -> (y, f, c) ;
  suc m' | r -> \ n x y z c' c -> (c'.1, c'.2.1, r n c'.1 y z c'.2.2 c) } ;

 tot-cat : (m : Nat) -> (n : Nat) (x y z : CO) (c' : Ch m x y) (c : Ch n y z)
  -> Id (CH z x) (tot (plus m (suc n)) x z (cat m n x y z c' c)) (co z y x (tot m x y c') (tot n y z c)) = split {
  zero -> \ n x y z f c -> refl (co z y x f (tot n y z c)) ;
  suc m' | ih -> \ n x y z c' c ->
   trans (CH z x) (co z c'.1 x c'.2.1 (tot (plus m' (suc n)) c'.1 z (cat m' n c'.1 y z c'.2.2 c)))
    (co z c'.1 x c'.2.1 (co z y c'.1 (tot m' c'.1 y c'.2.2) (tot n y z c)))
    (co z y x (co y c'.1 x c'.2.1 (tot m' c'.1 y c'.2.2)) (tot n y z c))
    (ap (CH z c'.1) (CH z x) (\ h -> co z c'.1 x c'.2.1 h) (tot (plus m' (suc n)) c'.1 z (cat m' n c'.1 y z c'.2.2 c))
       (co z y c'.1 (tot m' c'.1 y c'.2.2) (tot n y z c)) (ih n c'.1 y z c'.2.2 c))
    (sym (CH z x) (co z y x (co y c'.1 x c'.2.1 (tot m' c'.1 y c'.2.2)) (tot n y z c))
       (co z c'.1 x c'.2.1 (co z y c'.1 (tot m' c'.1 y c'.2.2) (tot n y z c)))
       (C.oC-assoc z y c'.1 x c'.2.1 (tot m' c'.1 y c'.2.2) (tot n y z c))) } ;

 rx-cat : (m : Nat) -> (n : Nat) (x' x y z : CO) (g : CH x' x) (c' : Ch m x' y) (c : Ch n y z)
  -> Id (Ch (plus m (suc n)) x z) (rx (plus m (suc n)) x' x g z (cat m n x' y z c' c)) (cat m n x y z (rx m x' x g y c') c) = split {
  zero -> \ n x' x y z g f c -> refl (y, co y x' x g f, c) ;
  suc m' -> \ n x' x y z g c' c -> refl (c'.1, co c'.1 x' x g c'.2.1, cat m' n c'.1 y z c'.2.2 c) } ;

 -- the face at 0 composes the first two maps
 front0 : (n : Nat) -> (x y z : CO) (f : CH y x) (c : Ch n y z) -> Id (Ch n x z) (comp n zero x z (y, f, c)) (rx n y x f z c) = split {
  zero -> \ x y z f c -> refl (co z y x f c) ;
  suc n' -> \ x y z f c -> refl (c.1, co c.1 y x f c.2.1, c.2.2) } ;

 -- the first m+1 faces at 0: the first block composed into the second
 compFront : (m : Nat) -> (n : Nat) (x z : CO) -> Ch (plus m (suc n)) x z -> Ch n x z = split {
  zero -> \ n x z c -> comp n zero x z c ;
  suc m' | r -> \ n x z c -> r n x z (comp (plus m' (suc n)) zero x z c) } ;

 cat-front : (m : Nat) -> (n : Nat) (x y z : CO) (c' : Ch m x y) (c : Ch n y z)
  -> Id (Ch n x z) (compFront m n x z (cat m n x y z c' c)) (rx n y x (tot m x y c') z c) = split {
  zero -> \ n x y z f c -> front0 n x y z f c ;
  suc m' | ih -> \ n x y z c' c ->
   trans (Ch n x z) (compFront m' n x z (comp (plus m' (suc n)) zero x z (c'.1, c'.2.1, cat m' n c'.1 y z c'.2.2 c)))
    (compFront m' n x z (cat m' n x y z (rx m' c'.1 x c'.2.1 y c'.2.2) c))
    (rx n y x (co y c'.1 x c'.2.1 (tot m' c'.1 y c'.2.2)) z c)
    (ap (Ch (plus m' (suc n)) x z) (Ch n x z) (compFront m' n x z)
       (comp (plus m' (suc n)) zero x z (c'.1, c'.2.1, cat m' n c'.1 y z c'.2.2 c))
       (cat m' n x y z (rx m' c'.1 x c'.2.1 y c'.2.2) c)
       (trans (Ch (plus m' (suc n)) x z) (comp (plus m' (suc n)) zero x z (c'.1, c'.2.1, cat m' n c'.1 y z c'.2.2 c))
          (rx (plus m' (suc n)) c'.1 x c'.2.1 z (cat m' n c'.1 y z c'.2.2 c))
          (cat m' n x y z (rx m' c'.1 x c'.2.1 y c'.2.2) c)
          (front0 (plus m' (suc n)) x c'.1 z c'.2.1 (cat m' n c'.1 y z c'.2.2 c))
          (rx-cat m' n c'.1 x y z c'.2.1 c'.2.2 c)))
    (trans (Ch n x z) (compFront m' n x z (cat m' n x y z (rx m' c'.1 x c'.2.1 y c'.2.2) c))
       (rx n y x (tot m' x y (rx m' c'.1 x c'.2.1 y c'.2.2)) z c)
       (rx n y x (co y c'.1 x c'.2.1 (tot m' c'.1 y c'.2.2)) z c)
       (ih n x y z (rx m' c'.1 x c'.2.1 y c'.2.2) c)
       (ap (CH y x) (Ch n x z) (\ h -> rx n y x h z c) (tot m' x y (rx m' c'.1 x c'.2.1 y c'.2.2))
          (co y c'.1 x c'.2.1 (tot m' c'.1 y c'.2.2)) (tot-rx m' c'.1 x c'.2.1 y c'.2.2))) } ;

 -- the face at the junction composes the last map of c' into c
 cat-junction : (m : Nat) -> (n : Nat) (x y z : CO) (c' : Ch (suc m) x y) (c : Ch n y z)
  -> Id (Ch (plus m (suc n)) x z) (comp (plus m (suc n)) (suc m) x z (cat (suc m) n x y z c' c))
       (cat m n x (drop m x y c').1 z (drop m x y c').2.1 (rx n y (drop m x y c').1 (drop m x y c').2.2 z c)) = split {
  zero -> \ n x y z c' c -> ap (Ch n c'.1 z) (Ch (suc n) x z) (\ r -> (c'.1, c'.2.1, r))
    (comp n zero c'.1 z (y, c'.2.2, c)) (rx n y c'.1 c'.2.2 z c) (front0 n c'.1 y z c'.2.2 c) ;
  suc m' | ih -> \ n x y z c' c -> ap (Ch (plus m' (suc n)) c'.1 z) (Ch (suc (plus m' (suc n))) x z) (\ r -> (c'.1, c'.2.1, r))
    (comp (plus m' (suc n)) (suc m') c'.1 z (cat (suc m') n c'.1 y z c'.2.2 c))
    (cat m' n c'.1 (drop m' c'.1 y c'.2.2).1 z (drop m' c'.1 y c'.2.2).2.1 (rx n y (drop m' c'.1 y c'.2.2).1 (drop m' c'.1 y c'.2.2).2.2 z c))
    (ih n c'.1 y z c'.2.2 c) } ;

 -- transport of chains along an equality of lengths
 trCh (n1 n2 : Nat) (e : Id Nat n1 n2) (x z : CO) (c : Ch n1 x z) : Ch n2 x z = subst Nat (\ k -> Ch k x z) n1 n2 e c ;

 trCh-suc (n1 n2 : Nat) (e : Id Nat n1 n2) (x y0 z : CO) (f0 : CH y0 x) (c : Ch n1 y0 z)
  : Id (Ch (suc n2) x z) (trCh (suc n1) (suc n2) (ap Nat Nat (\ k -> suc k) n1 n2 e) x z (y0, f0, c)) (y0, f0, trCh n1 n2 e y0 z c) =
  idJ Nat n1 (\ k e2 -> Id (Ch (suc k) x z) (trCh (suc n1) (suc k) (ap Nat Nat (\ k' -> suc k') n1 k e2) x z (y0, f0, c)) (y0, f0, trCh n1 k e2 y0 z c))
   (refl (y0, f0, c)) n2 e ;

 -- the chain cat m (suc n) c' c, with its arity in the form suc N
 catS (m n : Nat) (x y z : CO) (c' : Ch m x y) (c : Ch (suc n) y z) : Ch (suc (plus m (suc n))) x z =
  trCh (plus m (suc (suc n))) (suc (plus m (suc n))) (plus-suc m (suc n)) x z (cat m (suc n) x y z c' c) ;

 -- the top face of a concatenation is the top face of c
 drop-cat : (m : Nat) -> (n : Nat) (x y z : CO) (c' : Ch m x y) (c : Ch (suc n) y z)
  -> Id (DR (plus m (suc n)) x z) (drop (plus m (suc n)) x z (catS m n x y z c' c))
       ((drop n y z c).1, cat m n x y (drop n y z c).1 c' (drop n y z c).2.1, (drop n y z c).2.2) = split {
  zero -> \ n x y z f c -> refl (drop (suc n) x z (y, f, c)) ;
  suc m' | ih -> \ n x y z c' c ->
   trans (DR (suc (plus m' (suc n))) x z)
    (drop (suc (plus m' (suc n))) x z (catS (suc m') n x y z c' c))
    (drop (suc (plus m' (suc n))) x z (c'.1, c'.2.1, catS m' n c'.1 y z c'.2.2 c))
    ((drop n y z c).1, cat (suc m') n x y (drop n y z c).1 c' (drop n y z c).2.1, (drop n y z c).2.2)
    (ap (Ch (suc (suc (plus m' (suc n)))) x z) (DR (suc (plus m' (suc n))) x z) (drop (suc (plus m' (suc n))) x z)
       (catS (suc m') n x y z c' c) (c'.1, c'.2.1, catS m' n c'.1 y z c'.2.2 c)
       (trCh-suc (plus m' (suc (suc n))) (suc (plus m' (suc n))) (plus-suc m' (suc n)) x c'.1 z c'.2.1 (cat m' (suc n) c'.1 y z c'.2.2 c)))
    (ap (DR (plus m' (suc n)) c'.1 z) (DR (suc (plus m' (suc n))) x z) (liftD (plus m' (suc n)) x c'.1 z c'.2.1)
       (drop (plus m' (suc n)) c'.1 z (catS m' n c'.1 y z c'.2.2 c))
       ((drop n y z c).1, cat m' n c'.1 y (drop n y z c).1 c'.2.2 (drop n y z c).2.1, (drop n y z c).2.2)
       (ih n c'.1 y z c'.2.2 c)) } ;

 -- an inner face in the second block
 comp-back : (m : Nat) -> (n k : Nat) (x y z : CO) (c' : Ch m x y) (c : Ch (suc n) y z)
  -> Id (Ch (plus m (suc n)) x z) (comp (plus m (suc n)) (plus m (suc k)) x z (catS m n x y z c' c))
       (cat m n x y z c' (comp n k y z c)) = split {
  zero -> \ n k x y z f c -> refl (y, f, comp n k y z c) ;
  suc m' | ih -> \ n k x y z c' c ->
   trans (Ch (suc (plus m' (suc n))) x z)
    (comp (suc (plus m' (suc n))) (suc (plus m' (suc k))) x z (catS (suc m') n x y z c' c))
    (c'.1, c'.2.1, comp (plus m' (suc n)) (plus m' (suc k)) c'.1 z (catS m' n c'.1 y z c'.2.2 c))
    (c'.1, c'.2.1, cat m' n c'.1 y z c'.2.2 (comp n k y z c))
    (ap (Ch (suc (suc (plus m' (suc n)))) x z) (Ch (suc (plus m' (suc n))) x z) (comp (suc (plus m' (suc n))) (suc (plus m' (suc k))) x z)
       (catS (suc m') n x y z c' c) (c'.1, c'.2.1, catS m' n c'.1 y z c'.2.2 c)
       (trCh-suc (plus m' (suc (suc n))) (suc (plus m' (suc n))) (plus-suc m' (suc n)) x c'.1 z c'.2.1 (cat m' (suc n) c'.1 y z c'.2.2 c)))
    (ap (Ch (plus m' (suc n)) c'.1 z) (Ch (suc (plus m' (suc n))) x z) (\ r -> (c'.1, c'.2.1, r))
       (comp (plus m' (suc n)) (plus m' (suc k)) c'.1 z (catS m' n c'.1 y z c'.2.2 c))
       (cat m' n c'.1 y z c'.2.2 (comp n k y z c))
       (ih n k c'.1 y z c'.2.2 c)) } ;

 -- an inner face in the first block (k <= m): comp k (cat (m+1) c' c) = cat m (comp k c') c
 catL0 (n : Nat) : (k : Nat) -> (hk : IsT (leb k zero)) -> (x y z : CO) (c' : Ch (suc zero) x y) (c : Ch n y z)
  -> Id (Ch (suc n) x z) (comp (suc n) k x z (cat (suc zero) n x y z c' c)) (cat zero n x y z (comp zero k x y c') c) = split {
  zero -> \ hk x y z c' c -> refl (y, co y c'.1 x c'.2.1 c'.2.2, c) ;
  suc k' -> \ hk x y z c' c -> absurd (Id (Ch (suc n) x z) (comp (suc n) (suc k') x z (cat (suc zero) n x y z c' c)) (cat zero n x y z (comp zero (suc k') x y c') c)) (false-true hk) } ;
 catLs (m' : Nat)
  (ih : (n k : Nat) (hk : IsT (leb k m')) (x y z : CO) (c' : Ch (suc m') x y) (c : Ch n y z)
        -> Id (Ch (plus m' (suc n)) x z) (comp (plus m' (suc n)) k x z (cat (suc m') n x y z c' c)) (cat m' n x y z (comp m' k x y c') c))
  (n : Nat) : (k : Nat) -> (hk : IsT (leb k (suc m'))) -> (x y z : CO) (c' : Ch (suc (suc m')) x y) (c : Ch n y z)
  -> Id (Ch (suc (plus m' (suc n))) x z) (comp (suc (plus m' (suc n))) k x z (cat (suc (suc m')) n x y z c' c)) (cat (suc m') n x y z (comp (suc m') k x y c') c) = split {
  zero -> \ hk x y z c' c -> refl (c'.2.2.1, co c'.2.2.1 c'.1 x c'.2.1 c'.2.2.2.1, cat m' n c'.2.2.1 y z c'.2.2.2.2 c) ;
  suc k' -> \ hk x y z c' c -> ap (Ch (plus m' (suc n)) c'.1 z) (Ch (suc (plus m' (suc n))) x z) (\ r -> (c'.1, c'.2.1, r))
    (comp (plus m' (suc n)) k' c'.1 z (cat (suc m') n c'.1 y z c'.2.2 c)) (cat m' n c'.1 y z (comp m' k' c'.1 y c'.2.2) c)
    (ih n k' hk c'.1 y z c'.2.2 c) } ;
 cat-left : (m : Nat) -> (n k : Nat) (hk : IsT (leb k m)) (x y z : CO) (c' : Ch (suc m) x y) (c : Ch n y z)
  -> Id (Ch (plus m (suc n)) x z) (comp (plus m (suc n)) k x z (cat (suc m) n x y z c' c)) (cat m n x y z (comp m k x y c') c) = split {
  zero -> \ n k hk x y z c' c -> catL0 n k hk x y z c' c ;
  suc m' | ih -> \ n k hk x y z c' c -> catLs m' ih n k hk x y z c' c } ;

 -- the arity m = m + 0 (an equality whose suc clause is ap suc)
 pzm : (m : Nat) -> Id Nat m (plus m zero) = split {
  zero -> refl zero ;
  suc m' | ih -> ap Nat Nat (\ k -> suc k) m' (plus m' zero) ih } ;
 -- the top face of cat c' f (a single map on the right) is (c' , f)
 drop-cat0 : (m : Nat) -> (x y z : CO) (c' : Ch m x y) (f : CH z y)
  -> Id (DR (plus m zero) x z) (drop (plus m zero) x z (trCh (plus m (suc zero)) (suc (plus m zero)) (plus-suc m zero) x z (cat m zero x y z c' f)))
       (y, trCh m (plus m zero) (pzm m) x y c', f) = split {
  zero -> \ x y z c' f -> refl (y, c', f) ;
  suc m' | ih -> \ x y z c' f ->
   trans (DR (suc (plus m' zero)) x z)
    (drop (suc (plus m' zero)) x z (trCh (suc (plus m' (suc zero))) (suc (suc (plus m' zero))) (ap Nat Nat (\ k -> suc k) (plus m' (suc zero)) (suc (plus m' zero)) (plus-suc m' zero)) x z (c'.1, c'.2.1, cat m' zero c'.1 y z c'.2.2 f)))
    (drop (suc (plus m' zero)) x z (c'.1, c'.2.1, trCh (plus m' (suc zero)) (suc (plus m' zero)) (plus-suc m' zero) c'.1 z (cat m' zero c'.1 y z c'.2.2 f)))
    (y, trCh (suc m') (suc (plus m' zero)) (ap Nat Nat (\ k -> suc k) m' (plus m' zero) (pzm m')) x y (c'.1, c'.2.1, c'.2.2), f)
    (ap (Ch (suc (suc (plus m' zero))) x z) (DR (suc (plus m' zero)) x z) (drop (suc (plus m' zero)) x z)
       (trCh (suc (plus m' (suc zero))) (suc (suc (plus m' zero))) (ap Nat Nat (\ k -> suc k) (plus m' (suc zero)) (suc (plus m' zero)) (plus-suc m' zero)) x z (c'.1, c'.2.1, cat m' zero c'.1 y z c'.2.2 f))
       (c'.1, c'.2.1, trCh (plus m' (suc zero)) (suc (plus m' zero)) (plus-suc m' zero) c'.1 z (cat m' zero c'.1 y z c'.2.2 f))
       (trCh-suc (plus m' (suc zero)) (suc (plus m' zero)) (plus-suc m' zero) x c'.1 z c'.2.1 (cat m' zero c'.1 y z c'.2.2 f)))
    (trans (DR (suc (plus m' zero)) x z)
      (drop (suc (plus m' zero)) x z (c'.1, c'.2.1, trCh (plus m' (suc zero)) (suc (plus m' zero)) (plus-suc m' zero) c'.1 z (cat m' zero c'.1 y z c'.2.2 f)))
      (y, (c'.1, c'.2.1, trCh m' (plus m' zero) (pzm m') c'.1 y c'.2.2), f)
      (y, trCh (suc m') (suc (plus m' zero)) (ap Nat Nat (\ k -> suc k) m' (plus m' zero) (pzm m')) x y (c'.1, c'.2.1, c'.2.2), f)
      (ap (DR (plus m' zero) c'.1 z) (DR (suc (plus m' zero)) x z) (liftD (plus m' zero) x c'.1 z c'.2.1)
         (drop (plus m' zero) c'.1 z (trCh (plus m' (suc zero)) (suc (plus m' zero)) (plus-suc m' zero) c'.1 z (cat m' zero c'.1 y z c'.2.2 f)))
         (y, trCh m' (plus m' zero) (pzm m') c'.1 y c'.2.2, f)
         (ih c'.1 y z c'.2.2 f))
      (ap (Ch (suc (plus m' zero)) x y) (DR (suc (plus m' zero)) x z) (\ cc -> (y, cc, f))
         (c'.1, c'.2.1, trCh m' (plus m' zero) (pzm m') c'.1 y c'.2.2)
         (trCh (suc m') (suc (plus m' zero)) (ap Nat Nat (\ k -> suc k) m' (plus m' zero) (pzm m')) x y (c'.1, c'.2.1, c'.2.2))
         (sym (Ch (suc (plus m' zero)) x y)
            (trCh (suc m') (suc (plus m' zero)) (ap Nat Nat (\ k -> suc k) m' (plus m' zero) (pzm m')) x y (c'.1, c'.2.1, c'.2.2))
            (c'.1, c'.2.1, trCh m' (plus m' zero) (pzm m') c'.1 y c'.2.2)
            (trCh-suc m' (plus m' zero) (pzm m') x c'.1 y c'.2.1 c'.2.2)))) } ;
} ;
