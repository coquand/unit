-- A derivation between two terms of a presentation yields a homotopy
-- between their evaluations in G on the generic points of yo(t).
-- The path of classes is carried through CCodeH; E1 handles both terms.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;

module Rel (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation)
  (q q' : SX.Over[R].Der[t].Term) (d : SX.Over[R].Der[t].Proof q q') {
 module TA = CE1TotAll[a].TA[R, encK, pe, t] ;
 module A = TA.A ;
 module CM = A.CM ;
 module HO1 = A.HO1 ;
 module KA = A.KS[q] ;
 module KB = A.KS[q'] ;
 module GO = CCodeH[a].GenOf[R, encK, pe, t, KA.S.M.mor, KA.S.M.mor-nat, KB.S.M.mor, KB.S.M.mor-nat] ;
 Nl : FibCwF[a, a+].fibCwF.Ctx = FibCwF[a, a+].fibCwF.nil ;
 Q1 : FibCwF[a, a+].fibCwF.Ty Nl = CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt ;
 Qt : FibCwF[a, a+].fibCwF.Ty Nl = GO.QY ;
 cx : FibCwF[a, a+].fibCwF.El Nl Q1 = CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].AX.cls (var (inr tt)) ;
 Ea : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q1 Qt KA.S.SM.Phi cx ;
 Eb : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q1 Qt KB.S.SM.Phi cx ;
 module AT = CHomT3[a].HomP[R, encK, pe].Alg[t].AX ;
 E : FibCwF[a, a+].fibCwF.El Nl (IJ.IdT Nl Qt Ea Eb) =
   PT.transM Nl Qt Ea (AT.cls q) Eb (KA.S.SM.beta (var (inr tt)))
   (PT.transM Nl Qt (AT.cls q) (AT.cls q') Eb (AT.clsEq q q' d) (PT.symM Nl Qt Eb (AT.cls q') (KB.S.SM.beta (var (inr tt))))) ;
 ra (K : Ob) : Id (V1.Ix (Qt.1.tob K tt)) (Ea.eob K tt) (GO.fa K) = CAppRd[a].App0[Q1, Qt, KA.S.SM.Phi, cx].rd K tt ;
 rb (K : Ob) : Id (V1.Ix (Qt.1.tob K tt)) (Eb.eob K tt) (GO.fb K) = CAppRd[a].App0[Q1, Qt, KB.S.SM.Phi, cx].rd K tt ;
 module G = GO.At[Ea, Eb, E, ra, rb] ;
 module H2 = HO1.Ret[A.P1, A.XT, A.GT, HO1.compN A.P1 A.XT A.C6.Q1.Y1T A.GT G.H.PLm.mA G.H.tauN, HO1.compN A.P1 A.XT A.C6.Q1.Y1T A.GT G.H.PLm.mB G.H.tauN,
   A.Rs q, A.Rs q', \ I x c -> refl ((A.Rs q).nfun I x c), \ I x c -> refl ((A.Rs q').nfun I x c), G.H.res] ;
 module I0 = HO1.Inv[A.P1, A.XT, A.GT, TA.I.Lv q', A.Rs q', A.cB, TA.E1 q'] ;
 module C2 = HO1.Cat[A.P1, A.XT, A.GT, A.Rs q, A.Rs q', TA.I.Lv q', A.cB, H2.res, I0.res] ;
 module C1 = HO1.Cat[A.P1, A.XT, A.GT, TA.I.Lv q, A.Rs q, TA.I.Lv q', A.cB, TA.E1 q, C2.res] ;
 res : A.G1.GB.GPre[a+].PS.PEl[A.G1.GB.GPre[a+].PS.extP A.P1 A.XT, HO1.HT[A.P1, A.XT, A.GT, TA.I.Lv q, TA.I.Lv q'].PT.PathP] = C1.res ;
} ;
