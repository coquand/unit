-- CPshIdJb.seg (part 2 of CPshIdJa: the refl element and the centre at x) (canonicity-45; (B) stage 2(b), COBAR.md): the Id of the
-- CwF of fibrant C-types as the IdT of CwFId.SwanId, its derived context
-- and centre (SwanId.Der), and their comparison at each x with the base's
-- (FibIdCen.DR): the derived context is the base's on the nose (dxEq),
-- the centre is the base's as a presheaf map (cenEqC: both are the
-- extension by refl, and the two refl elements are rflY transported along
-- equal paths of types, FibIdRd.elTr with one path of codes).
--   IdTS, IdT-natS, rflS   the IdT / IdT-nat / rfl of the instance
--   DRC = SW2.Der[..]       Dx, cen, upS, ... of the C-level record
--   DRB = FibIdCen.DR       the same for the base at each x
--   cenEqC x : (DRC.cen G A a).sb x = DRB.cen (G.ob x) A_x a_x

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module FBC = FibCwF[a, l] ;
module FIC = FibIdCen[a, l] ;
module RD = FibIdRd[a, l] ;

module IdJbOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 open P ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;
 IdTS (G : CCtx) (A : STy G) (a0 b0 : CEl[G, A.1]) : STy G = JA.IdTS G A a0 b0 ;
 rflS (G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) : CEl[G, (IdTS G A a0 a0).1] = JA.rflS G A a0 ;
 module DRC = JA.DRC ;
 module DRB = JA.DRB ;
 As (G : CCtx) (A : STy G) (x : CO) : FBC.FC.STy (G.ob x) = JA.As G A x ;

 ------------------------------------------------------------------
 -- the refl element of the record at x is the base's

 module RE (G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (x : CO) {
  Gx : PCtx = G.ob x ;
  Ax : FBC.FC.STy Gx = As G A x ;
  ax : PEl[Gx, A.1.ty x] = a0.el x ;
  -- the types of refl, C-level and base, at x
  IKx : PTy[extP Gx (A.1.ty x)] = (DRB.IK Gx Ax ax).1 ;
  TsC : CTy[G] = (UF.FCC.subS G (LO.ExtC G A.1) (DRC.IK G A a0) (CW.secC G A.1 a0)).1 ;
  TsB : PTy[Gx] = (FBC.FC.subS Gx (extP Gx (A.1.ty x)) (DRB.IK Gx Ax ax) (secP Gx (A.1.ty x) ax)).1 ;
  -- the C-level refl element, as a transport over CTy
  PC : Id (CTy[G]) (IdTS G A a0 a0).1 TsC = apH (\ Z -> Z.1) (sym (STy G) TsC' (IdTS G A a0 a0) (DRC.reflT G A a0))
   where { TsC' : STy G = UF.FCC.subS G (LO.ExtC G A.1) (DRC.IK G A a0) (CW.secC G A.1 a0) ; } ;
  reC : Id (CEl[G, TsC]) (DRC.reflE G A a0)
         (subst (CTy[G]) (\ X -> CEl[G, X]) (IdTS G A a0 a0).1 TsC PC (rflS G A a0)) =
   subst-ap (STy G) (CTy[G]) (\ Z -> Z.1) (\ X -> CEl[G, X]) (IdTS G A a0 a0) (UF.FCC.subS G (LO.ExtC G A.1) (DRC.IK G A a0) (CW.secC G A.1 a0))
     (sym (STy G) (UF.FCC.subS G (LO.ExtC G A.1) (DRC.IK G A a0) (CW.secC G A.1 a0)) (IdTS G A a0 a0) (DRC.reflT G A a0)) (rflS G A a0) ;
  opaque reC ;
  -- the base's refl element, as a transport over PTy
  PB' : Id (PTy[Gx]) (FIC.idTy Gx Ax ax ax).1 TsB =
   apH (\ Z -> Z.1) (sym (FBC.FC.STy Gx) (FBC.FC.subS Gx (extP Gx (A.1.ty x)) (DRB.IK Gx Ax ax) (secP Gx (A.1.ty x) ax)) (FIC.idTy Gx Ax ax ax) (DRB.reflT Gx Ax ax)) ;
  reB : Id (PEl[Gx, TsB]) (DRB.reflE Gx Ax ax)
         (subst (PTy[Gx]) (\ T -> PEl[Gx, T]) (FIC.idTy Gx Ax ax ax).1 TsB PB' (FIC.rflE Gx Ax ax)) =
   subst-ap (FBC.FC.STy Gx) (PTy[Gx]) (\ Z -> Z.1) (\ T -> PEl[Gx, T]) (FIC.idTy Gx Ax ax ax) (FBC.FC.subS Gx (extP Gx (A.1.ty x)) (DRB.IK Gx Ax ax) (secP Gx (A.1.ty x) ax))
     (sym (FBC.FC.STy Gx) (FBC.FC.subS Gx (extP Gx (A.1.ty x)) (DRB.IK Gx Ax ax) (secP Gx (A.1.ty x) ax)) (FIC.idTy Gx Ax ax ax) (DRB.reflT Gx Ax ax)) (FIC.rflE Gx Ax ax) ;
  opaque reB ;
  -- the path of types at x, and its path of codes at a point
  PCx : Id (PTy[Gx]) ((IdTS G A a0 a0).1.ty x) (TsC.ty x) = apH (\ X -> X.ty x) PC ;
  cd (X : Ob) (g : W0.Ix (Gx.ob X)) : Id W0.V (((IdTS G A a0 a0).1.ty x).tob X g) ((TsC.ty x).tob X g) = apH (\ T -> T.tob X g) PCx ;
  -- at a point: both are the value of rflY transported along one path of codes
  valC (X : Ob) (g : W0.Ix (Gx.ob X))
   : Id (W0.Ix ((TsC.ty x).tob X g)) (((DRC.reflE G A a0).el x).eob X g)
       (subst W0.V (\ v -> W0.Ix v) (((IdTS G A a0 a0).1.ty x).tob X g) ((TsC.ty x).tob X g) (cd X g) (((rflS G A a0).el x).eob X g)) =
   transH (apH (\ e -> (e.el x).eob X g) reC)
    (transH (apH (\ e -> e.eob X g) (CW.elTrC G (IdTS G A a0 a0).1 TsC PC (rflS G A a0) x))
      (RD.elTr Gx (PTy[Gx]) (\ T -> T) ((IdTS G A a0 a0).1.ty x) (TsC.ty x) PCx ((rflS G A a0).el x) X g (cd X g))) ;
  opaque valC ;
  valB (X : Ob) (g : W0.Ix (Gx.ob X))
   : Id (W0.Ix (TsB.tob X g)) ((DRB.reflE Gx Ax ax).eob X g)
       (subst W0.V (\ v -> W0.Ix v) ((FIC.idTy Gx Ax ax ax).1.tob X g) (TsB.tob X g) (cd X g) ((FIC.rflE Gx Ax ax).eob X g)) =
   transH (apH (\ e -> e.eob X g) reB)
    (RD.elTr Gx (PTy[Gx]) (\ T -> T) (FIC.idTy Gx Ax ax ax).1 TsB PB' (FIC.rflE Gx Ax ax) X g (cd X g)) ;
  opaque valB ;
  val (X : Ob) (g : W0.Ix (Gx.ob X))
   : Id (W0.Ix (TsB.tob X g)) (((DRC.reflE G A a0).el x).eob X g) ((DRB.reflE Gx Ax ax).eob X g) =
   transH (valC X g) (symH (valB X g)) ;
  opaque val ;
 } ;

 -- the centre of the record at x is the base's
 cenEqC (G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (x : CO)
  : Id (PSub[G.ob x, DRB.Dx (G.ob x) (As G A x) (a0.el x)]) ((DRC.cen G A a0).sb x) (DRB.cen (G.ob x) (As G A x) (a0.el x)) =
  sub-ext (G.ob x) (DRB.Dx (G.ob x) (As G A x) (a0.el x)) ((DRC.cen G A a0).sb x) (DRB.cen (G.ob x) (As G A x) (a0.el x))
   (\ X g -> apH (pairE (extP (G.ob x) (A.1.ty x)) (DRB.IK (G.ob x) (As G A x) (a0.el x)).1 X (pairE (G.ob x) (A.1.ty x) X g ((a0.el x).eob X g)))
               (RE[G, A, a0, x].val X g)) ;
 opaque cenEqC ;
} ;
