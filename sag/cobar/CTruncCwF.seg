-- CTruncCwF.seg (canonicity-c2; SIMPLIFIED.md item 1): the base's
-- propositional truncation as a former of the CwF of fibrant types
-- FibCwF[a, l] (no strict stability under substitution: ruling 4e).
--   Tr0 G A      the truncation of a fibrant type, fibrant (CTruncFib)
--   incE         the unit, an element of (Tr0 A)[p] over G.A
--   rcTr         over G.Tr0 A, the weakened truncation has a relative
--                contractibility structure (the seeded extension)
--   contrTr      hence an element of the internal isContr there: the
--                truncation is a proposition (inhabited => contractible)
--   elim         elimination into a fibrant family of propositions over
--                G.Tr0 A (core's CTruncElimProp), with beta for inc
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
module W = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ;
module FCw = FibCwF[a, l] ;
module FC = FCw.FC ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;

module TrOf (G : PCtx) (A : FC.STy G) {
  module TT = CTrunc[a, l].Truncation[G, A.1] ;
  Ty : PTy[G] = TT.Ty ;
  Tr0 : FC.STy G = (Ty, CTruncFib[a, l].truncFib G A.1 A.2) ;
  GA : PCtx = extP G A.1 ;
  GT : PCtx = extP G Ty ;
  module TA = PR.TyL[G, A.1] ;

  -- the unit
  incV (X : Ob) (w : W.Ix (GA.ob X)) : W.Ix (Ty.tob X (TA.pr1 X w)) = TT.inclusion.nfun X (TA.pr1 X w) (TA.pr2 X w) ;
  incN (J I : Ob) (f : Hom J I) (x : W.Ix (GA.ob I)) (y : W.Ix (GA.ob J)) (e : Id (W.Ix (GA.ob J)) (GA.act J I f x) y)
    : Id (W.Ix (Ty.tob J (TA.pr1 J y)))
        (Ty.tact J I f (TA.pr1 I x) (TA.pr1 J y) (ntEq GA G (pP G A.1) J I f x y e) (incV I x)) (incV J y) =
    idJ (W.Ix (GA.ob J)) (GA.act J I f x)
      (\ y2 e2 -> Id (W.Ix (Ty.tob J (TA.pr1 J y2)))
                    (Ty.tact J I f (TA.pr1 I x) (TA.pr1 J y2) (ntEq GA G (pP G A.1) J I f x y2 e2) (incV I x)) (incV J y2))
      (transH (TT.inclusion.nnat J I f (TA.pr1 I x) (TA.pr1 J (GA.act J I f x))
                 (ntEq GA G (pP G A.1) J I f x (GA.act J I f x) (refl (GA.act J I f x))) (TA.pr2 I x))
         (apH (TT.inclusion.nfun J (TA.pr1 J (GA.act J I f x)))
            (tact-irr G A.1 J I f (TA.pr1 I x) (TA.pr1 J (GA.act J I f x))
               (ntEq GA G (pP G A.1) J I f x (GA.act J I f x) (refl (GA.act J I f x)))
               (refl (G.act J I f (TA.pr1 I x))) (TA.pr2 I x))))
      y e ;
  incE : PEl[GA, subTy GA G Ty (pP G A.1)] = mkPEl GA (subTy GA G Ty (pP G A.1)) incV incN ;

  -- proposition: contractible over itself
  opG : CTruncSeededBack[a, l].Seeded[G, Ty].Op = CTruncSeededBack[a, l].Seeded[G, Ty].RoundTrip[TT.algebra].op ;
  module RCo = CTruncFib[a, l].OpRC[G, Ty, opG] ;
  TrW : FC.STy GT = FC.subS GT G Tr0 (pP G Ty) ;
  rcTr : CP.ContrOp GT TrW.1 = RCo.rc ;
  contrTr : FCw.fibCwF.El GT (EQ.isContr GT TrW) = FibContr[a, l].contr GT TrW rcTr ;

  -- elimination into fibrant propositions
  module El (B : FC.STy GT) (p : CTruncHProp[a, l].Proposition[GT, B.1].isProp) {
    module E = CTruncElimProp[a, l].Elimination[G, A.1, B.1, B.2.1, p] ;
    elim (b : PEl[GA, E.atInc]) : PEl[GT, B.1] = E.eliminate b ;
    beta (b : PEl[GA, E.atInc]) (X : Ob) (x : W.Ix (G.ob X)) (v : W.Ix (A.1.tob X x))
      : Id (W.Ix (B.1.tob X (x, TT.inclusion.nfun X x v))) ((elim b).eob X (x, TT.inclusion.nfun X x v)) (b.eob X (x, v)) =
      E.beta-inc b X x v ;
  } ;
} ;
