-- The first coefficient of a variable finite cofactor vector.  The
-- cofactor type is substituted from G to its extension once, then the
-- Sigma projection is read in that same context.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Ring[a++] ;
module FT = CFinIntTy[a] ;
module IN = CwFInt.Int[a++, FT.C, FibCwF[a, a+].fibPi, FT.SS, FibId[a, a+].fibId] ;

module Derived (D : CwF.CwF[a++]) {
 pl (K G : D.Ctx) (A B : D.Ty G) (s : D.Sub K G)
  : Id (D.Ty (D.ext K (D.subT K G A s)))
      (D.subT (D.ext K (D.subT K G A s)) (D.ext G A)
        (D.subT (D.ext G A) G B (D.p G A)) (D.lift K G A s))
      (D.subT (D.ext K (D.subT K G A s)) K (D.subT K G B s)
        (D.p K (D.subT K G A s))) = D.p-lift-T K G A B s ;
 ps (G : D.Ctx) (A B : D.Ty G) (a : D.El G A)
  : Id (D.Ty G)
      (D.subT G (D.ext G A) (D.subT (D.ext G A) G B (D.p G A)) (D.sec G A a)) B =
   D.p-sec-T G A B a ;
} ;
module DF = Derived[FT.C] ;

module Head (G : FT.C.Ctx) (Rg : FT.PR.HRing[G])
 (f : FT.C.El G Rg.R) (fs : List (FT.C.El G Rg.R)) {
 module CO = FT.Cofactor[G, Rg] ;
 C : CwF.CwF[a++] = FT.C ;
 K : C.Ctx = CO.Ctx (cons f fs) ;
 p : C.Sub K G = C.p G (CO.CofT (cons f fs)) ;
 A : C.Ty K = C.subT K G Rg.R p ;
 B : C.Ty (C.ext K A) =
  C.subT (C.ext K A) (C.ext G Rg.R)
    (FT.OV.wkT G Rg.R (CO.CofT fs)) (C.lift K G Rg.R p) ;
 raw : C.El K (C.subT K G (CO.CofT (cons f fs)) p) = C.q G (CO.CofT (cons f fs)) ;
 pair : C.El K (FT.SS.Sig K A B) =
  FT.OV.trE K (C.subT K G (CO.CofT (cons f fs)) p) (FT.SS.Sig K A B)
    (FT.SS.Sig-nat K G Rg.R (FT.OV.wkT G Rg.R (CO.CofT fs)) p) raw ;
 head : C.El K A = IN.fst K A B pair ;
 tailT : C.Ty K = C.subT K G (CO.CofT fs) p ;
 tail0 : C.Ty K = C.subT K (C.ext K A) B (C.sec K A head) ;
 tailStep : Id (C.Ty (C.ext K A)) B (FT.OV.wkT K A tailT) =
  DF.pl K G Rg.R (CO.CofT fs) p ;
 tailPath : Id (C.Ty K) tail0 tailT =
  transH (apH {C.Ty (C.ext K A)} {C.Ty K}
      (\ T -> C.subT K (C.ext K A) T (C.sec K A head)) tailStep)
    (DF.ps K A tailT head) ;
 tail : C.El K tailT =
  FT.OV.trE K tail0 tailT tailPath (IN.snd K A B pair) ;
} ;
