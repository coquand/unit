-- CTotPsi16.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 16: mS is injective over equal points
-- (CMove.Mv's mTinj): equal images give equal lines of A at every index,
-- hence (CTotPsi15 at the context G.A) equal readings of the two lines of
-- D G . D A everywhere, hence equal lines and equal points.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi16 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P14 = CTotPsi14[a, vl, l].Psi14[C, G, A, e] ;
 module P13 = P14.P13 ;
 module P12 = P13.P12 ;
 module P6 = P12.P6 ;
 module PO = P6.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module DA = P6.DA ;
 module EKg = P6.EKg ;
 module EKd = P6.EKd ;
 module R15 = CTotPsi15[a, vl, l].Psi15[C, P12.ET] ;
 module LM = CTotL12m[a, vl, l].L12m[C, G, A] ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;

 module Inj (Xm : TC.TOb) (v v' : EKd.TS.EI Xm) (P : Id (EKd.TV.EI Xm) (EKd.TS.pr1 Xm v) (EKd.TS.pr1 Xm v'))
   (Q : Id (P14.Tot0 Xm) (P13.mS Xm v) (P13.mS Xm v')) {
  module M = P12.MS[Xm, v] ;
  module M' = P12.MS[Xm, v'] ;
  -- the lines of A of the two images agree at every index of Xm
  module LQ (qq : DO.Idx Xm.1 Xm.2) (lq : DO.LandsI Xm.1 Xm.2 qq) {
   Y : TC.TOb = (qq.2.1, qq.2.2.2.1) ;
   rdS (T : P14.Tot0 Xm) : EKg.TS.EI Y = EKg.TS.pr Y (T.1.1 qq lq) (T.2.1 qq lq) ;
   val (V2 : TC.TOb) (g' : TC.THm V2 Y) (j' : PB.IvP V2.1) : Id (EKg.TA.EI V2)
     (P12.FTg.lval Y (EKg.lineL Y (rdS (P13.mS Xm v))) V2 g' j') (P12.FTg.lval Y (EKg.lineL Y (rdS (P13.mS Xm v'))) V2 g' j') =
    apH {P14.Tot0 Xm} {EKg.TA.EI V2} (\ T -> P12.FTg.lval Y (EKg.lineL Y (rdS T)) V2 g' j') Q ;
  } ;
  -- the readings of the two lines of D G . D A agree everywhere
  module RD (Vb : TC.TOb) (g : TC.THm Vb Xm) (j : PB.IvP Vb.1) (q : DO.Idx Vb.1 Vb.2) (lq : DO.LandsI Vb.1 Vb.2 q) {
   module RA = R15.Rec[Xm, M.lE, Vb, g, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq), j] ;
   module RB = R15.Rec[Xm, M'.lE, Vb, g, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq), j] ;
   qq : DO.Idx Xm.1 Xm.2 = (q.1, q.2.1, RA.U0, q.2.2.2.1, RA.cc, q.2.2.2.2.2) ;
   law : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 ((M.L.1 Vb g j).1.1 q lq) ((M.L.1 Vb g j).2.1 q lq))
           (DA.prz q.2.1 q.2.2.2.1 ((M'.L.1 Vb g j).1.1 q lq) ((M'.L.1 Vb g j).2.1 q lq)) =
    transH RA.law (transH (LQ[qq, lq].val RA.Y (TC.tid RA.Y) RA.j0) (symH RB.law)) ;
  } ;
  Leq (Vb : TC.TOb) (g : TC.THm Vb Xm) (j : PB.IvP Vb.1) : Id (LM.Tot Vb) (M.L.1 Vb g j) (M'.L.1 Vb g j) =
   LM.totEq Vb (M.L.1 Vb g j) (M'.L.1 Vb g j)
    (D.ob-eq Vb.1 Vb.2 (M.L.1 Vb g j).1 (M'.L.1 Vb g j).1
       (\ q lq -> apH {DA.Ez q.2.1 q.2.2.2.1} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ t -> t.1) (RD[Vb, g, j, q, lq].law)))
    (\ q lq -> RD[Vb, g, j, q, lq].law) ;
  law : Id (EKd.TS.EI Xm) v v' =
   EKd.ts-ext Xm v v' P (\ Vb g j -> Leq Vb g j) ;
 } ;
} ;
