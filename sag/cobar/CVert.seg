-- CVert.seg (canonicity-45; SIMPLIFIED.md step 4): the vertical category
-- at a stage of an internal category IC (CIntCat), and the restriction of
-- vertical maps along base maps.
--   VMap J y x       maps over the identity of J (the fibre category C_J)
--   vid, vcomp       composition: IC's compD over compH J J J (idH J) (idH J),
--                    moved to the identity along the base's unit law
--                    (one transport of the hom code; Hom J J is a set)
--   vcomp-idl / idr / assoc   from IC's laws in the total hom, through
--                    the first component (THom-snd)
--   rmap u f         the restriction of f : y -> x at I along u : J -> I,
--                    a vertical map res u y -> res u x at J: the composite
--                    f . cart u y factored through cart u x
--   rmap-id, rmap-comp, rmap-o   restriction is functorial in f and in u
-- All equalities are Ids in V-coded sets; hom codes are moved only along
-- paths of base maps (trH), never along paths of objects.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module VertOf (C : CIntCat[a].IC) {
 Obj (I : Ob) : U a = VA.Ix (C.obD I) ;
 TH (J : Ob) (y : VA.Ix (C.obD J)) (I : Ob) (x : VA.Ix (C.obD I)) : U a = (u : Hom J I) * VA.Ix (C.homD J I u y x) ;
 HomD (J I : Ob) (u : Hom J I) (y : Obj J) (x : Obj I) : U a = VA.Ix (C.homD J I u y x) ;
 setHom (J I : Ob) : isSet (Hom J I) = VA.isSetIx (homV J I) ;

 -- moving a map along a path of base maps
 trH (J I : Ob) (u u' : Hom J I) (p : Id (Hom J I) u u') (y : Obj J) (x : Obj I) (f : HomD J I u y x) : HomD J I u' y x =
  subst (Hom J I) (\ w -> HomD J I w y x) u u' p f ;
 trH-refl (J I : Ob) (u : Hom J I) (p : Id (Hom J I) u u) (y : Obj J) (x : Obj I) (f : HomD J I u y x) : Id (HomD J I u y x) (trH J I u u p y x f) f =
  apH {Id (Hom J I) u u} {HomD J I u y x} (\ q -> trH J I u u q y x f) (setHom J I u u p (refl u)) ;
 -- an equality in the total hom gives an equality of the maps, moved along its first component
 THom-snd (J I : Ob) (y : Obj J) (x : Obj I) (w w' : TH J y I x) (e : Id (TH J y I x) w w')
  : Id (HomD J I w'.1 y x) (trH J I w.1 w'.1 (apH {TH J y I x} {Hom J I} (\ z -> z.1) e) y x w.2) w'.2 =
  idJ (TH J y I x) w (\ w2 e2 -> Id (HomD J I w2.1 y x) (trH J I w.1 w2.1 (apH {TH J y I x} {Hom J I} (\ z -> z.1) e2) y x w.2) w2.2) (refl w.2) w' e ;
 -- and conversely, any path of base maps will do (Hom is a set)
 THom-snd' (J I : Ob) (y : Obj J) (x : Obj I) (w w' : TH J y I x) (e : Id (TH J y I x) w w') (p : Id (Hom J I) w.1 w'.1)
  : Id (HomD J I w'.1 y x) (trH J I w.1 w'.1 p y x w.2) w'.2 =
  transH (apH {Id (Hom J I) w.1 w'.1} {HomD J I w'.1 y x} (\ q -> trH J I w.1 w'.1 q y x w.2) (setHom J I w.1 w'.1 p (apH {TH J y I x} {Hom J I} (\ z -> z.1) e)))
   (THom-snd J I y x w w' e) ;

 -- the vertical category at J
 VMap (J : Ob) (y x : Obj J) : U a = HomD J J (idH J) y x ;
 vid (J : Ob) (x : Obj J) : VMap J x x = C.idD J x ;
 vcomp (J : Ob) (z y x : Obj J) (f : VMap J y x) (g : VMap J z y) : VMap J z x =
  trH J J (compH J J J (idH J) (idH J)) (idH J) (comp-idl J J (idH J)) z x (C.compD J J J (idH J) (idH J) z y x f g) ;
 vcomp-idl (J : Ob) (y x : Obj J) (f : VMap J y x) : Id (VMap J y x) (vcomp J y x x (vid J x) f) f =
  THom-snd' J J y x (compH J J J (idH J) (idH J), C.compD J J J (idH J) (idH J) y x x (C.idD J x) f) (idH J, f) (C.idl J J (idH J) y x f) (comp-idl J J (idH J)) ;
 vcomp-idr (J : Ob) (y x : Obj J) (f : VMap J y x) : Id (VMap J y x) (vcomp J y y x f (vid J y)) f =
  THom-snd' J J y x (compH J J J (idH J) (idH J), C.compD J J J (idH J) (idH J) y y x f (C.idD J y)) (idH J, f) (C.idr J J (idH J) y x f) (comp-idl J J (idH J)) ;
 -- moving lemmas: transports compose; a moved factor moves out of a composite
 trH-trans (J I : Ob) (u u' u'' : Hom J I) (p : Id (Hom J I) u u') (q : Id (Hom J I) u' u'') (y : Obj J) (x : Obj I) (f : HomD J I u y x)
  : Id (HomD J I u'' y x) (trH J I u' u'' q y x (trH J I u u' p y x f)) (trH J I u u'' (transH p q) y x f) =
  idJ (Hom J I) u' (\ w q2 -> Id (HomD J I w y x) (trH J I u' w q2 y x (trH J I u u' p y x f)) (trH J I u w (transH p q2) y x f)) (refl (trH J I u u' p y x f)) u'' q ;
 mv-l (K J I : Ob) (u u' : Hom J I) (p : Id (Hom J I) u u') (v : Hom K J) (z : Obj K) (y : Obj J) (x : Obj I) (f : HomD J I u y x) (g : HomD K J v z y)
  : Id (HomD K I (compH K J I u' v) z x) (C.compD K J I u' v z y x (trH J I u u' p y x f) g)
      (trH K I (compH K J I u v) (compH K J I u' v) (apH {Hom J I} {Hom K I} (\ w -> compH K J I w v) p) z x (C.compD K J I u v z y x f g)) =
  idJ (Hom J I) u (\ w p2 -> Id (HomD K I (compH K J I w v) z x) (C.compD K J I w v z y x (trH J I u w p2 y x f) g)
                      (trH K I (compH K J I u v) (compH K J I w v) (apH {Hom J I} {Hom K I} (\ w' -> compH K J I w' v) p2) z x (C.compD K J I u v z y x f g)))
   (refl (C.compD K J I u v z y x f g)) u' p ;
 mv-r (K J I : Ob) (u : Hom J I) (v v' : Hom K J) (p : Id (Hom K J) v v') (z : Obj K) (y : Obj J) (x : Obj I) (f : HomD J I u y x) (g : HomD K J v z y)
  : Id (HomD K I (compH K J I u v') z x) (C.compD K J I u v' z y x f (trH K J v v' p z y g))
      (trH K I (compH K J I u v) (compH K J I u v') (apH {Hom K J} {Hom K I} (\ w -> compH K J I u w) p) z x (C.compD K J I u v z y x f g)) =
  idJ (Hom K J) v (\ w p2 -> Id (HomD K I (compH K J I u w) z x) (C.compD K J I u w z y x f (trH K J v w p2 z y g))
                      (trH K I (compH K J I u v) (compH K J I u w) (apH {Hom K J} {Hom K I} (\ w' -> compH K J I u w') p2) z x (C.compD K J I u v z y x f g)))
   (refl (C.compD K J I u v z y x f g)) v' p ;
 -- transports along any two paths agree (Hom is a set)
 trH-irr (J I : Ob) (u u' : Hom J I) (p q : Id (Hom J I) u u') (y : Obj J) (x : Obj I) (f : HomD J I u y x) : Id (HomD J I u' y x) (trH J I u u' p y x f) (trH J I u u' q y x f) =
  apH {Id (Hom J I) u u'} {HomD J I u' y x} (\ r -> trH J I u u' r y x f) (setHom J I u u' p q) ;

 -- a moved element is recovered by moving back
 trH-back (J I : Ob) (u u' : Hom J I) (p : Id (Hom J I) u u') (y : Obj J) (x : Obj I) (f : HomD J I u y x) (g : HomD J I u' y x)
  (e : Id (HomD J I u' y x) (trH J I u u' p y x f) g) : Id (HomD J I u y x) f (trH J I u' u (symH p) y x g) =
  transH (symH (trH-refl J I u (transH p (symH p)) y x f))
   (transH (symH (trH-trans J I u u' u p (symH p) y x f)) (apH {HomD J I u' y x} {HomD J I u y x} (\ w -> trH J I u' u (symH p) y x w) e)) ;

 -- associativity: both sides are the triple composite of IC moved to the identity
 module Assoc (J : Ob) (t z y x : Obj J) (f : VMap J y x) (g : VMap J z y) (h : VMap J t z) {
  i : Hom J J = idH J ;
  ii : Hom J J = compH J J J i i ;
  X : HomD J J (compH J J J ii i) t x = C.compD J J J ii i t z x (C.compD J J J i i z y x f g) h ;
  Y : HomD J J (compH J J J i ii) t x = C.compD J J J i ii t y x f (C.compD J J J i i t z y g h) ;
  pL : Id (Hom J J) (compH J J J ii i) i = transH (apH {Hom J J} {Hom J J} (\ w -> compH J J J w i) (comp-idl J J i)) (comp-idl J J i) ;
  pR : Id (Hom J J) (compH J J J i ii) i = transH (apH {Hom J J} {Hom J J} (\ w -> compH J J J i w) (comp-idl J J i)) (comp-idl J J i) ;
  pA : Id (Hom J J) (compH J J J ii i) (compH J J J i ii) = apH {TH J t J x} {Hom J J} (\ w -> w.1) (C.assoc J J J J i i i t z y x f g h) ;
  left : Id (VMap J t x) (vcomp J t z x (vcomp J z y x f g) h) (trH J J (compH J J J ii i) i pL t x X) =
   transH (apH {HomD J J ii t x} {VMap J t x} (\ e -> trH J J ii i (comp-idl J J i) t x e) (mv-l J J J ii i (comp-idl J J i) i t z x (C.compD J J J i i z y x f g) h))
    (trH-trans J J (compH J J J ii i) ii i (apH {Hom J J} {Hom J J} (\ w -> compH J J J w i) (comp-idl J J i)) (comp-idl J J i) t x X) ;
  right : Id (VMap J t x) (vcomp J t y x f (vcomp J t z y g h)) (trH J J (compH J J J i ii) i pR t x Y) =
   transH (apH {HomD J J ii t x} {VMap J t x} (\ e -> trH J J ii i (comp-idl J J i) t x e) (mv-r J J J i ii i (comp-idl J J i) t y x f (C.compD J J J i i t z y g h)))
    (trH-trans J J (compH J J J i ii) ii i (apH {Hom J J} {Hom J J} (\ w -> compH J J J i w) (comp-idl J J i)) (comp-idl J J i) t x Y) ;
  yx : Id (HomD J J (compH J J J i ii) t x) (trH J J (compH J J J ii i) (compH J J J i ii) pA t x X) Y =
   THom-snd J J t x (compH J J J ii i, X) (compH J J J i ii, Y) (C.assoc J J J J i i i t z y x f g h) ;
  law : Id (VMap J t x) (vcomp J t z x (vcomp J z y x f g) h) (vcomp J t y x f (vcomp J t z y g h)) =
   transH left
    (transH (trH-irr J J (compH J J J ii i) i pL (transH pA pR) t x X)
     (transH (symH (trH-trans J J (compH J J J ii i) (compH J J J i ii) i pA pR t x X))
      (transH (apH {HomD J J (compH J J J i ii) t x} {VMap J t x} (\ e -> trH J J (compH J J J i ii) i pR t x e) yx) (symH right)))) ;
 } ;
 vcomp-assoc (J : Ob) (t z y x : Obj J) (f : VMap J y x) (g : VMap J z y) (h : VMap J t z)
  : Id (VMap J t x) (vcomp J t z x (vcomp J z y x f g) h) (vcomp J t y x f (vcomp J t z y g h)) = Assoc[J, t, z, y, x, f, g, h].law ;
 ------------------------------------------------------------------
 -- restriction of vertical maps along base maps: f : y -> x at I and
 -- u : J -> I give res u y -> res u x at J, the composite f . cart u y
 -- (over (idH I) . u = u . (idH J)) factored through cart u x
 module Rm (J I : Ob) (u : Hom J I) (y x : Obj I) (f : VMap I y x) {
  ry : Obj J = C.res J I u y ;
  rx : Obj J = C.res J I u x ;
  -- the composite, over (idH I) . u
  cp : HomD J I (compH J I I (idH I) u) ry x = C.compD J I I (idH I) u ry y x f (C.cart J I u y) ;
  -- moved over u . (idH J)
  pu : Id (Hom J I) (compH J I I (idH I) u) (compH J J I u (idH J)) = transH (comp-idl J I u) (symH (comp-idr J I u)) ;
  cp' : HomD J I (compH J J I u (idH J)) ry x = trH J I (compH J I I (idH I) u) (compH J J I u (idH J)) pu ry x cp ;
  res : VMap J ry rx = C.fact J J I u (idH J) ry x cp' ;
  -- its characterisation: cart u x . res = cp'
  eq : Id (HomD J I (compH J J I u (idH J)) ry x) (C.compD J J I u (idH J) ry rx x (C.cart J I u x) res) cp' = C.fact-eq J J I u (idH J) ry x cp' ;
 } ;
 rmap (J I : Ob) (u : Hom J I) (y x : Obj I) (f : VMap I y x) : VMap J (C.res J I u y) (C.res J I u x) = Rm[J, I, u, y, x, f].res ;

 -- a vertical map at J with cart u x . g = cp' is the restriction (uniqueness of the factorisation)
 rmap-char (J I : Ob) (u : Hom J I) (y x : Obj I) (f : VMap I y x) (g : VMap J (C.res J I u y) (C.res J I u x))
  (e : Id (HomD J I (compH J J I u (idH J)) (C.res J I u y) x) (C.compD J J I u (idH J) (C.res J I u y) (C.res J I u x) x (C.cart J I u x) g) Rm[J, I, u, y, x, f].cp')
  : Id (VMap J (C.res J I u y) (C.res J I u x)) g (rmap J I u y x f) =
  C.fact-uniq J J I u (idH J) (C.res J I u y) x Rm[J, I, u, y, x, f].cp' g e ;

 -- restriction preserves identities: both sides are cart u x moved along
 -- the unit laws (IC's idr for the composite with the identity at J, IC's
 -- idl for the composite with the identity at I)
 module RmId (J I : Ob) (u : Hom J I) (x : Obj I) {
  rx : Obj J = C.res J I u x ;
  module M = Rm[J, I, u, x, x, vid I x] ;
  c : HomD J I u rx x = C.cart J I u x ;
  A : Id (HomD J I (compH J J I u (idH J)) rx x) (trH J I u (compH J J I u (idH J)) (symH (comp-idr J I u)) rx x c)
        (C.compD J J I u (idH J) rx rx x c (C.idD J rx)) =
   THom-snd' J I rx x (u, c) (compH J J I u (idH J), C.compD J J I u (idH J) rx rx x c (C.idD J rx)) (symH (C.idr J I u rx x c)) (symH (comp-idr J I u)) ;
  A' : Id (HomD J I (compH J I I (idH I) u) rx x) (trH J I u (compH J I I (idH I) u) (symH (comp-idl J I u)) rx x c) M.cp =
   THom-snd' J I rx x (u, c) (compH J I I (idH I) u, M.cp) (symH (C.idl J I u rx x c)) (symH (comp-idl J I u)) ;
  e : Id (HomD J I (compH J J I u (idH J)) rx x) (C.compD J J I u (idH J) rx rx x c (C.idD J rx)) M.cp' =
   transH (symH A)
    (transH (trH-irr J I u (compH J J I u (idH J)) (symH (comp-idr J I u)) (transH (symH (comp-idl J I u)) M.pu) rx x c)
     (transH (symH (trH-trans J I u (compH J I I (idH I) u) (compH J J I u (idH J)) (symH (comp-idl J I u)) M.pu rx x c))
      (apH {HomD J I (compH J I I (idH I) u) rx x} {HomD J I (compH J J I u (idH J)) rx x} (\ w -> trH J I (compH J I I (idH I) u) (compH J J I u (idH J)) M.pu rx x w) A'))) ;
  law : Id (VMap J rx rx) (vid J rx) (rmap J I u x x (vid I x)) = rmap-char J I u x x (vid I x) (vid J rx) e ;
 } ;
 rmap-id (J I : Ob) (u : Hom J I) (x : Obj I) : Id (VMap J (C.res J I u x) (C.res J I u x)) (vid J (C.res J I u x)) (rmap J I u x x (vid I x)) =
  RmId[J, I, u, x].law ;
 -- restriction preserves composition: cart u x . (rmap f . rmap g) and
 -- (f . g) . cart u z both move to (f . cart u y) . rmap g = f . (cart u y . rmap g) = f . (g . cart u z)
 module RmComp (J I : Ob) (u : Hom J I) (z y x : Obj I) (f : VMap I y x) (g : VMap I z y) {
  rz : Obj J = C.res J I u z ; ry : Obj J = C.res J I u y ; rx : Obj J = C.res J I u x ;
  i : Hom I I = idH I ; j : Hom J J = idH J ;
  module Mf = Rm[J, I, u, y, x, f] ; module Mg = Rm[J, I, u, z, y, g] ; module Mfg = Rm[J, I, u, z, x, vcomp I z y x f g] ;
  rf : VMap J ry rx = Mf.res ; rg : VMap J rz ry = Mg.res ;
  -- the composite cart u x . (rf . rg), over u . (j . j)
  L : HomD J I (compH J J I u (compH J J J j j)) rz x = C.compD J J I u (compH J J J j j) rz rx x (C.cart J I u x) (C.compD J J J j j rz ry rx rf rg) ;
  -- (cart u x . rf) . rg = cp'_f . rg, by IC's assoc and Mf.eq
  s1 : Id (TH J rz I x) (compH J J I u (compH J J J j j), L) (compH J J I (compH J J I u j) j, C.compD J J I (compH J J I u j) j rz ry x (C.compD J J I u j ry rx x (C.cart J I u x) rf) rg) =
   symH (C.assoc J J J I u j j rz ry rx x (C.cart J I u x) rf rg) ;
  s2 : Id (HomD J I (compH J J I (compH J J I u j) j) rz x) (C.compD J J I (compH J J I u j) j rz ry x (C.compD J J I u j ry rx x (C.cart J I u x) rf) rg)
         (C.compD J J I (compH J J I u j) j rz ry x Mf.cp' rg) =
   apH {HomD J I (compH J J I u j) ry x} {HomD J I (compH J J I (compH J J I u j) j) rz x} (\ w -> C.compD J J I (compH J J I u j) j rz ry x w rg) Mf.eq ;
  -- cp'_f . rg = (f . cart u y) . rg moved = f . (cart u y . rg) = f . cp'_g = f . (g . cart u z) moved
  s3 : Id (HomD J I (compH J J I (compH J J I u j) j) rz x) (C.compD J J I (compH J J I u j) j rz ry x Mf.cp' rg)
         (trH J I (compH J J I (compH J I I i u) j) (compH J J I (compH J J I u j) j) (apH {Hom J I} {Hom J I} (\ w -> compH J J I w j) Mf.pu) rz x
            (C.compD J J I (compH J I I i u) j rz ry x Mf.cp rg)) =
   mv-l J J I (compH J I I i u) (compH J J I u j) Mf.pu j rz ry x Mf.cp rg ;
  s4 : Id (TH J rz I x) (compH J J I (compH J I I i u) j, C.compD J J I (compH J I I i u) j rz ry x (C.compD J I I i u ry y x f (C.cart J I u y)) rg)
         (compH J I I i (compH J J I u j), C.compD J I I i (compH J J I u j) rz y x f (C.compD J J I u j rz ry y (C.cart J I u y) rg)) =
   C.assoc J J I I i u j rz ry y x f (C.cart J I u y) rg ;
  s5 : Id (HomD J I (compH J I I i (compH J J I u j)) rz x) (C.compD J I I i (compH J J I u j) rz y x f (C.compD J J I u j rz ry y (C.cart J I u y) rg))
         (C.compD J I I i (compH J J I u j) rz y x f Mg.cp') =
   apH {HomD J I (compH J J I u j) rz y} {HomD J I (compH J I I i (compH J J I u j)) rz x} (\ w -> C.compD J I I i (compH J J I u j) rz y x f w) Mg.eq ;
  s6 : Id (HomD J I (compH J I I i (compH J J I u j)) rz x) (C.compD J I I i (compH J J I u j) rz y x f Mg.cp')
         (trH J I (compH J I I i (compH J I I i u)) (compH J I I i (compH J J I u j)) (apH {Hom J I} {Hom J I} (\ w -> compH J I I i w) Mg.pu) rz x
            (C.compD J I I i (compH J I I i u) rz y x f (C.compD J I I i u rz z y g (C.cart J I u z)))) =
   mv-r J I I i (compH J I I i u) (compH J J I u j) Mg.pu rz y x f Mg.cp ;
  s7 : Id (TH J rz I x) (compH J I I i (compH J I I i u), C.compD J I I i (compH J I I i u) rz y x f (C.compD J I I i u rz z y g (C.cart J I u z)))
         (compH J I I (compH I I I i i) u, C.compD J I I (compH I I I i i) u rz z x (C.compD I I I i i z y x f g) (C.cart J I u z)) =
   symH (C.assoc J I I I i i u rz z y x f g (C.cart J I u z)) ;
  -- the right-hand side: (f . g) . cart u z with f . g the vertical composite (moved to i)
  s8 : Id (HomD J I (compH J I I i u) rz x) (C.compD J I I i u rz z x (vcomp I z y x f g) (C.cart J I u z))
         (trH J I (compH J I I (compH I I I i i) u) (compH J I I i u) (apH {Hom I I} {Hom J I} (\ w -> compH J I I w u) (comp-idl I I i)) rz x
            (C.compD J I I (compH I I I i i) u rz z x (C.compD I I I i i z y x f g) (C.cart J I u z))) =
   mv-l J I I (compH I I I i i) i (comp-idl I I i) u rz z x (C.compD I I I i i z y x f g) (C.cart J I u z) ;
  -- everything is X0 moved along paths of base maps
  X0 : HomD J I (compH J I I (compH I I I i i) u) rz x = C.compD J I I (compH I I I i i) u rz z x (C.compD I I I i i z y x f g) (C.cart J I u z) ;
  p1 : Id (Hom J I) (compH J J I u (compH J J J j j)) (compH J J I (compH J J I u j) j) = apH {TH J rz I x} {Hom J I} (\ w -> w.1) s1 ;
  p3 : Id (Hom J I) (compH J J I (compH J I I i u) j) (compH J J I (compH J J I u j) j) = apH {Hom J I} {Hom J I} (\ w -> compH J J I w j) Mf.pu ;
  p4 : Id (Hom J I) (compH J J I (compH J I I i u) j) (compH J I I i (compH J J I u j)) = apH {TH J rz I x} {Hom J I} (\ w -> w.1) s4 ;
  p6 : Id (Hom J I) (compH J I I i (compH J I I i u)) (compH J I I i (compH J J I u j)) = apH {Hom J I} {Hom J I} (\ w -> compH J I I i w) Mg.pu ;
  p7 : Id (Hom J I) (compH J I I i (compH J I I i u)) (compH J I I (compH I I I i i) u) = apH {TH J rz I x} {Hom J I} (\ w -> w.1) s7 ;
  p8 : Id (Hom J I) (compH J I I (compH I I I i i) u) (compH J I I i u) = apH {Hom I I} {Hom J I} (\ w -> compH J I I w u) (comp-idl I I i) ;
  pa : Id (Hom J I) (compH J J I u (compH J J J j j)) (compH J J I u j) = apH {Hom J J} {Hom J I} (\ w -> compH J J I u w) (comp-idl J J j) ;
  -- the right-hand side
  R : Id (HomD J I (compH J J I u j) rz x) Mfg.cp' (trH J I (compH J I I (compH I I I i i) u) (compH J J I u j) (transH p8 Mfg.pu) rz x X0) =
   transH (apH {HomD J I (compH J I I i u) rz x} {HomD J I (compH J J I u j) rz x} (\ w -> trH J I (compH J I I i u) (compH J J I u j) Mfg.pu rz x w) s8)
    (trH-trans J I (compH J I I (compH I I I i i) u) (compH J I I i u) (compH J J I u j) p8 Mfg.pu rz x X0) ;
  -- the left-hand side, step by step
  T7 : Id (HomD J I (compH J I I i (compH J I I i u)) rz x) (C.compD J I I i (compH J I I i u) rz y x f (C.compD J I I i u rz z y g (C.cart J I u z)))
         (trH J I (compH J I I (compH I I I i i) u) (compH J I I i (compH J I I i u)) (symH p7) rz x X0) =
   trH-back J I (compH J I I i (compH J I I i u)) (compH J I I (compH I I I i i) u) p7 rz x
    (C.compD J I I i (compH J I I i u) rz y x f (C.compD J I I i u rz z y g (C.cart J I u z))) X0
    (THom-snd J I rz x (compH J I I i (compH J I I i u), C.compD J I I i (compH J I I i u) rz y x f (C.compD J I I i u rz z y g (C.cart J I u z)))
       (compH J I I (compH I I I i i) u, X0) s7) ;
  T6 : Id (HomD J I (compH J I I i (compH J J I u j)) rz x) (C.compD J I I i (compH J J I u j) rz y x f Mg.cp')
         (trH J I (compH J I I (compH I I I i i) u) (compH J I I i (compH J J I u j)) (transH (symH p7) p6) rz x X0) =
   transH s6 (transH (apH {HomD J I (compH J I I i (compH J I I i u)) rz x} {HomD J I (compH J I I i (compH J J I u j)) rz x}
                        (\ w -> trH J I (compH J I I i (compH J I I i u)) (compH J I I i (compH J J I u j)) p6 rz x w) T7)
                (trH-trans J I (compH J I I (compH I I I i i) u) (compH J I I i (compH J I I i u)) (compH J I I i (compH J J I u j)) (symH p7) p6 rz x X0)) ;
  T4 : Id (HomD J I (compH J J I (compH J I I i u) j) rz x) (C.compD J J I (compH J I I i u) j rz ry x Mf.cp rg)
         (trH J I (compH J I I (compH I I I i i) u) (compH J J I (compH J I I i u) j) (transH (transH (symH p7) p6) (symH p4)) rz x X0) =
   transH (trH-back J I (compH J J I (compH J I I i u) j) (compH J I I i (compH J J I u j)) p4 rz x
             (C.compD J J I (compH J I I i u) j rz ry x Mf.cp rg) (C.compD J I I i (compH J J I u j) rz y x f (C.compD J J I u j rz ry y (C.cart J I u y) rg))
             (THom-snd J I rz x (compH J J I (compH J I I i u) j, C.compD J J I (compH J I I i u) j rz ry x Mf.cp rg)
                (compH J I I i (compH J J I u j), C.compD J I I i (compH J J I u j) rz y x f (C.compD J J I u j rz ry y (C.cart J I u y) rg)) s4))
    (transH (apH {HomD J I (compH J I I i (compH J J I u j)) rz x} {HomD J I (compH J J I (compH J I I i u) j) rz x}
               (\ w -> trH J I (compH J I I i (compH J J I u j)) (compH J J I (compH J I I i u) j) (symH p4) rz x w) (transH s5 T6))
      (trH-trans J I (compH J I I (compH I I I i i) u) (compH J I I i (compH J J I u j)) (compH J J I (compH J I I i u) j) (transH (symH p7) p6) (symH p4) rz x X0)) ;
  T1 : Id (HomD J I (compH J J I (compH J J I u j) j) rz x) (C.compD J J I (compH J J I u j) j rz ry x (C.compD J J I u j ry rx x (C.cart J I u x) rf) rg)
         (trH J I (compH J I I (compH I I I i i) u) (compH J J I (compH J J I u j) j) (transH (transH (transH (symH p7) p6) (symH p4)) p3) rz x X0) =
   transH s2 (transH s3
    (transH (apH {HomD J I (compH J J I (compH J I I i u) j) rz x} {HomD J I (compH J J I (compH J J I u j) j) rz x}
               (\ w -> trH J I (compH J J I (compH J I I i u) j) (compH J J I (compH J J I u j) j) p3 rz x w) T4)
      (trH-trans J I (compH J I I (compH I I I i i) u) (compH J J I (compH J I I i u) j) (compH J J I (compH J J I u j) j) (transH (transH (symH p7) p6) (symH p4)) p3 rz x X0))) ;
  TL : Id (HomD J I (compH J J I u (compH J J J j j)) rz x) L
         (trH J I (compH J I I (compH I I I i i) u) (compH J J I u (compH J J J j j)) (transH (transH (transH (transH (symH p7) p6) (symH p4)) p3) (symH p1)) rz x X0) =
   transH (trH-back J I (compH J J I u (compH J J J j j)) (compH J J I (compH J J I u j) j) p1 rz x L
             (C.compD J J I (compH J J I u j) j rz ry x (C.compD J J I u j ry rx x (C.cart J I u x) rf) rg)
             (THom-snd J I rz x (compH J J I u (compH J J J j j), L) (compH J J I (compH J J I u j) j, C.compD J J I (compH J J I u j) j rz ry x (C.compD J J I u j ry rx x (C.cart J I u x) rf) rg) s1))
    (transH (apH {HomD J I (compH J J I (compH J J I u j) j) rz x} {HomD J I (compH J J I u (compH J J J j j)) rz x}
               (\ w -> trH J I (compH J J I (compH J J I u j) j) (compH J J I u (compH J J J j j)) (symH p1) rz x w) T1)
      (trH-trans J I (compH J I I (compH I I I i i) u) (compH J J I (compH J J I u j) j) (compH J J I u (compH J J J j j)) (transH (transH (transH (symH p7) p6) (symH p4)) p3) (symH p1) rz x X0)) ;
  LHS : Id (HomD J I (compH J J I u j) rz x) (C.compD J J I u j rz rx x (C.cart J I u x) (vcomp J rz ry rx rf rg))
          (trH J I (compH J I I (compH I I I i i) u) (compH J J I u j) (transH (transH (transH (transH (transH (symH p7) p6) (symH p4)) p3) (symH p1)) pa) rz x X0) =
   transH (mv-r J J I u (compH J J J j j) j (comp-idl J J j) rz rx x (C.cart J I u x) (C.compD J J J j j rz ry rx rf rg))
    (transH (apH {HomD J I (compH J J I u (compH J J J j j)) rz x} {HomD J I (compH J J I u j) rz x} (\ w -> trH J I (compH J J I u (compH J J J j j)) (compH J J I u j) pa rz x w) TL)
      (trH-trans J I (compH J I I (compH I I I i i) u) (compH J J I u (compH J J J j j)) (compH J J I u j) (transH (transH (transH (transH (symH p7) p6) (symH p4)) p3) (symH p1)) pa rz x X0)) ;
  e : Id (HomD J I (compH J J I u j) rz x) (C.compD J J I u j rz rx x (C.cart J I u x) (vcomp J rz ry rx rf rg)) Mfg.cp' =
   transH LHS (transH (trH-irr J I (compH J I I (compH I I I i i) u) (compH J J I u j) (transH (transH (transH (transH (transH (symH p7) p6) (symH p4)) p3) (symH p1)) pa) (transH p8 Mfg.pu) rz x X0) (symH R)) ;
  law : Id (VMap J rz rx) (vcomp J rz ry rx rf rg) (rmap J I u z x (vcomp I z y x f g)) = rmap-char J I u z x (vcomp I z y x f g) (vcomp J rz ry rx rf rg) e ;
 } ;
 rmap-comp (J I : Ob) (u : Hom J I) (z y x : Obj I) (f : VMap I y x) (g : VMap I z y)
  : Id (VMap J (C.res J I u z) (C.res J I u x)) (vcomp J (C.res J I u z) (C.res J I u y) (C.res J I u x) (rmap J I u y x f) (rmap J I u z y g)) (rmap J I u z x (vcomp I z y x f g)) =
  RmComp[J, I, u, z, y, x, f, g].law ;
 ------------------------------------------------------------------
 -- the vertical category at a stage as a small category, and the
 -- restriction along u : J -> I as a functor between them (so that the
 -- chains at a stage are Chains.ChainsOf[VCat J] and their restriction
 -- is the chain map of a functor)
 VCat (J : Ob) : SmallCat[a].SmallCat =
  new SmallCat[a].SmallCat[C.obD J, \ y x -> C.homD J J (idH J) y x, vid J, \ z y x f g -> vcomp J z y x f g,
   vcomp-idl J, vcomp-idr J, vcomp-assoc J] ;
 rfun (J I : Ob) (u : Hom J I) : CChainsF[a].FunOf[VCat I, VCat J].SFun =
  new CChainsF[a].FunOf[VCat I, VCat J].SFun[C.res J I u, \ y x f -> rmap J I u y x f, \ x -> symH (rmap-id J I u x), \ z y x f g -> symH (rmap-comp J I u z y x f g)] ;
 ------------------------------------------------------------------
 -- transports along paths of OBJECTS (domain, codomain), and their
 -- commutation with composition and with the base-map transport
 trD (J I : Ob) (u : Hom J I) (y y' : Obj J) (p : Id (Obj J) y y') (x : Obj I) (f : HomD J I u y x) : HomD J I u y' x =
  subst (Obj J) (\ w -> HomD J I u w x) y y' p f ;
 trC (J I : Ob) (u : Hom J I) (y : Obj J) (x x' : Obj I) (q : Id (Obj I) x x') (f : HomD J I u y x) : HomD J I u y x' =
  subst (Obj I) (\ w -> HomD J I u y w) x x' q f ;
 trD-back (J I : Ob) (u : Hom J I) (y y' : Obj J) (p : Id (Obj J) y y') (x : Obj I) (f : HomD J I u y' x)
  : Id (HomD J I u y' x) (trD J I u y y' p x (trD J I u y' y (symH p) x f)) f =
  idJ (Obj J) y (\ w q -> (f2 : HomD J I u w x) -> Id (HomD J I u w x) (trD J I u y w q x (trD J I u w y (symH q) x f2)) f2) (\ f2 -> refl f2) y' p f ;
 trC-back (J I : Ob) (u : Hom J I) (y : Obj J) (x x' : Obj I) (q : Id (Obj I) x x') (f : HomD J I u y x')
  : Id (HomD J I u y x') (trC J I u y x x' q (trC J I u y x' x (symH q) f)) f =
  idJ (Obj I) x (\ w r -> (f2 : HomD J I u y w) -> Id (HomD J I u y w) (trC J I u y x w r (trC J I u y w x (symH r) f2)) f2) (\ f2 -> refl f2) x' q f ;
 -- a transported domain of the right factor transports the domain of the composite
 cmp-trD (K J I : Ob) (u : Hom J I) (v : Hom K J) (z z' : Obj K) (p : Id (Obj K) z z') (y : Obj J) (x : Obj I) (f : HomD J I u y x) (g : HomD K J v z y)
  : Id (HomD K I (compH K J I u v) z' x) (C.compD K J I u v z' y x f (trD K J v z z' p y g)) (trD K I (compH K J I u v) z z' p x (C.compD K J I u v z y x f g)) =
  idJ (Obj K) z (\ w q -> Id (HomD K I (compH K J I u v) w x) (C.compD K J I u v w y x f (trD K J v z w q y g)) (trD K I (compH K J I u v) z w q x (C.compD K J I u v z y x f g)))
   (refl (C.compD K J I u v z y x f g)) z' p ;
 -- moving the junction object on both sides does not change the composite
 cmp-trM (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : Obj K) (y y' : Obj J) (p : Id (Obj J) y y') (x : Obj I) (f : HomD J I u y x) (g : HomD K J v z y)
  : Id (HomD K I (compH K J I u v) z x) (C.compD K J I u v z y' x (trD J I u y y' p x f) (trC K J v z y y' p g)) (C.compD K J I u v z y x f g) =
  idJ (Obj J) y (\ w q -> Id (HomD K I (compH K J I u v) z x) (C.compD K J I u v z w x (trD J I u y w q x f) (trC K J v z y w q g)) (C.compD K J I u v z y x f g))
   (refl (C.compD K J I u v z y x f g)) y' p ;
 -- the base-map transport commutes with the domain transport
 trH-trD (J I : Ob) (u u' : Hom J I) (p : Id (Hom J I) u u') (y y' : Obj J) (q : Id (Obj J) y y') (x : Obj I) (f : HomD J I u y x)
  : Id (HomD J I u' y' x) (trH J I u u' p y' x (trD J I u y y' q x f)) (trD J I u' y y' q x (trH J I u u' p y x f)) =
  idJ (Hom J I) u (\ w r -> Id (HomD J I w y' x) (trH J I u w r y' x (trD J I u y y' q x f)) (trD J I w y y' q x (trH J I u w r y x f))) (refl (trD J I u y y' q x f)) u' p ;

 -- restriction is functorial in the base map, up to res-comp at both ends
 module RmO (K J I : Ob) (u : Hom J I) (v : Hom K J) (y x : Obj I) (f : VMap I y x) {
  A : Obj J = C.res J I u x ; B : Obj J = C.res J I u y ;
  A' : Obj K = C.res K J v A ; B' : Obj K = C.res K J v B ;
  uv : Hom K I = compH K J I u v ;
  A2 : Obj K = C.res K I uv x ; B2 : Obj K = C.res K I uv y ;
  pA : Id (Obj K) A2 A' = C.res-comp K J I u v x ;
  pB : Id (Obj K) B2 B' = C.res-comp K J I u v y ;
  i : Hom I I = idH I ; j : Hom J J = idH J ; k : Hom K K = idH K ;
  fu : VMap J B A = rmap J I u y x f ;
  g' : VMap K B' A' = rmap K J v B A fu ;
  g : VMap K B2 A2 = trD K K k B' B2 (symH pB) A2 (trC K K k B' A' A2 (symH pA) g') ;
  module Mu = Rm[J, I, u, y, x, f] ; module Mv = Rm[K, J, v, B, A, fu] ; module Muv = Rm[K, I, uv, y, x, f] ;
  cx : HomD K I uv A' x = trD K I uv A2 A' pA x (C.cart K I uv x) ;
  cy : HomD K I uv B' y = trD K I uv B2 B' pB y (C.cart K I uv y) ;
  ccx : Id (HomD K I uv A' x) (C.compD K J I u v A' A x (C.cart J I u x) (C.cart K J v A)) cx = C.cart-comp K J I u v x ;
  ccy : Id (HomD K I uv B' y) (C.compD K J I u v B' B y (C.cart J I u y) (C.cart K J v B)) cy = C.cart-comp K J I u v y ;
  -- the composite at the primed objects, as the composite of cartesian lifts
  X0 : HomD K I (compH K J I (compH J I I i u) v) B' x = C.compD K J I (compH J I I i u) v B' B x Mu.cp (C.cart K J v B) ;
  s1 : Id (HomD K I (compH K K I uv k) B' x) (C.compD K K I uv k B' A' x cx g') (C.compD K K I uv k B' A' x (C.compD K J I u v A' A x (C.cart J I u x) (C.cart K J v A)) g') =
   apH {HomD K I uv A' x} {HomD K I (compH K K I uv k) B' x} (\ w -> C.compD K K I uv k B' A' x w g') (symH ccx) ;
  s2 : Id (TH K B' I x) (compH K K I uv k, C.compD K K I uv k B' A' x (C.compD K J I u v A' A x (C.cart J I u x) (C.cart K J v A)) g')
         (compH K J I u (compH K K J v k), C.compD K J I u (compH K K J v k) B' A x (C.cart J I u x) (C.compD K K J v k B' A' A (C.cart K J v A) g')) =
   C.assoc K K J I u v k B' A' A x (C.cart J I u x) (C.cart K J v A) g' ;
  s3 : Id (HomD K I (compH K J I u (compH K K J v k)) B' x) (C.compD K J I u (compH K K J v k) B' A x (C.cart J I u x) (C.compD K K J v k B' A' A (C.cart K J v A) g'))
         (C.compD K J I u (compH K K J v k) B' A x (C.cart J I u x) Mv.cp') =
   apH {HomD K J (compH K K J v k) B' A} {HomD K I (compH K J I u (compH K K J v k)) B' x} (\ w -> C.compD K J I u (compH K K J v k) B' A x (C.cart J I u x) w) Mv.eq ;
  s4 : Id (HomD K I (compH K J I u (compH K K J v k)) B' x) (C.compD K J I u (compH K K J v k) B' A x (C.cart J I u x) Mv.cp')
         (trH K I (compH K J I u (compH K J J j v)) (compH K J I u (compH K K J v k)) (apH {Hom K J} {Hom K I} (\ w -> compH K J I u w) Mv.pu) B' x
            (C.compD K J I u (compH K J J j v) B' A x (C.cart J I u x) Mv.cp)) =
   mv-r K J I u (compH K J J j v) (compH K K J v k) Mv.pu B' A x (C.cart J I u x) Mv.cp ;
  s5 : Id (TH K B' I x) (compH K J I u (compH K J J j v), C.compD K J I u (compH K J J j v) B' A x (C.cart J I u x) (C.compD K J J j v B' B A fu (C.cart K J v B)))
         (compH K J I (compH J J I u j) v, C.compD K J I (compH J J I u j) v B' B x (C.compD J J I u j B A x (C.cart J I u x) fu) (C.cart K J v B)) =
   symH (C.assoc K J J I u j v B' B A x (C.cart J I u x) fu (C.cart K J v B)) ;
  s6 : Id (HomD K I (compH K J I (compH J J I u j) v) B' x) (C.compD K J I (compH J J I u j) v B' B x (C.compD J J I u j B A x (C.cart J I u x) fu) (C.cart K J v B))
         (C.compD K J I (compH J J I u j) v B' B x Mu.cp' (C.cart K J v B)) =
   apH {HomD J I (compH J J I u j) B x} {HomD K I (compH K J I (compH J J I u j) v) B' x} (\ w -> C.compD K J I (compH J J I u j) v B' B x w (C.cart K J v B)) Mu.eq ;
  s7 : Id (HomD K I (compH K J I (compH J J I u j) v) B' x) (C.compD K J I (compH J J I u j) v B' B x Mu.cp' (C.cart K J v B))
         (trH K I (compH K J I (compH J I I i u) v) (compH K J I (compH J J I u j) v) (apH {Hom J I} {Hom K I} (\ w -> compH K J I w v) Mu.pu) B' x X0) =
   mv-l K J I (compH J I I i u) (compH J J I u j) Mu.pu v B' B x Mu.cp (C.cart K J v B) ;
  s8 : Id (TH K B' I x) (compH K J I (compH J I I i u) v, X0) (compH K I I i uv, C.compD K I I i uv B' y x f (C.compD K J I u v B' B y (C.cart J I u y) (C.cart K J v B))) =
   C.assoc K J I I i u v B' B y x f (C.cart J I u y) (C.cart K J v B) ;
  s9 : Id (HomD K I (compH K I I i uv) B' x) (C.compD K I I i uv B' y x f (C.compD K J I u v B' B y (C.cart J I u y) (C.cart K J v B))) (C.compD K I I i uv B' y x f cy) =
   apH {HomD K I uv B' y} {HomD K I (compH K I I i uv) B' x} (\ w -> C.compD K I I i uv B' y x f w) ccy ;
 } ;
} ;
