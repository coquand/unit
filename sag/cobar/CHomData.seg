-- CHomData.seg (canonicity-45; SIMPLIFIED.md step 6): the Hoefer data of a
-- closed algebra map, internally, for CBridge.  Part 1: at three classes.
-- For global q1 q2 q3 : Q_s, over the hypothesis context
-- Del = nil.(q1 + q2 = q3) (the Id type of the operation at the section):
--   r       the semantic body of Phi (reads as Phi's family)
--   u       the hypothesis as an Id over Del between the substituted
--           terms x = (q1 + q2) and y = q3
--   apU     Phi applied to the hypothesis (CwFPth.apM)
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

-- a transported element equals an element reading alike (equal fibre codes)
elx (G : C.Ctx) (A A' : C.Ty G) (P : Id (C.Ty G) A A') (e1 : C.El G A) (e2 : C.El G A')
 (E2 : (K : Ob) (z : V1.Ix (G.ob K)) -> Id V1.V (A.1.tob K z) (A'.1.tob K z))
 (H : (K : Ob) (z : V1.Ix (G.ob K)) -> Id (V1.Ix (A'.1.tob K z)) (subst V1.V (\ c -> V1.Ix c) (A.1.tob K z) (A'.1.tob K z) (E2 K z) (e1.eob K z)) (e2.eob K z))
 : Id (C.El G A') (OV.trE G A A' P e1) e2 =
 L.el-ext G A'.1 (OV.trE G A A' P e1) e2 (\ K z ->
  transH (CAppRd[a].trE-rd G A A' P e1 K z) (transH (CAppRd[a].same-rd G A A' P K z (E2 K z) (e1.eob K z)) (H K z))) ;

-- the Id type of a binary operation over nil.Q^3 is a proposition
module PropOp (Qt : C.Ty C.nil) (op : C.El C.nil (OV.Fun C.nil Qt (OV.Fun C.nil Qt Qt))) (sq : CQCtx[a].G3Of[Qt].SetQiTy) {
 module Q3 = CQCtx[a].G3Of[Qt] ;
 module OT = Q3.OpTy[op] ;
  rnt (K : Ob) (x : V1.Ix (Q3.G3.ob K)) : V1.Ix (Q3.G2.ob K) = ((x.1.1.1, OT.o12.eob K x.1), x.2) ;
  rnat (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (Q3.G3.ob K)) : Id (V1.Ix (Q3.G2.ob L0)) (rnt L0 (Q3.G3.act L0 K g x)) (Q3.G2.act L0 K g (rnt K x)) =
   apH {V1.Ix (Qt.1.tob L0 x.1.1.1)} {V1.Ix (Q3.G2.ob L0)} (\ z -> ((x.1.1.1, z), (Q3.G3.act L0 K g x).2))
    (symH (OT.o12.enat L0 K g x.1 (Q3.G2.act L0 K g x.1) (refl (Q3.G2.act L0 K g x.1)))) ;
  rho : C.Sub Q3.G3 Q3.G2 = new L.PSub[Q3.G3, Q3.G2, rnt, rnat] ;
  -- Q3.Qw2 along rho is Q3.Qw3
  PQ : Id (C.Ty Q3.G3) (C.subT Q3.G3 Q3.G2 Q3.Qw2 rho) Q3.Qw3 =
   transH (symH (C.subT-o Q3.G3 Q3.G2 Q3.G1 Q3.Qw (C.p Q3.G1 Q3.Qw) rho))
    (transH (symH (C.subT-o Q3.G3 Q3.G1 Q3.Nl Qt (C.p Q3.Nl Qt) (C.o Q3.G3 Q3.G2 Q3.G1 (C.p Q3.G1 Q3.Qw) rho)))
      (transH (apH {C.Sub Q3.G3 Q3.Nl} {C.Ty Q3.G3} (\ z -> C.subT Q3.G3 Q3.Nl Qt z)
                 (L.sub-ext Q3.G3 Q3.Nl (C.o Q3.G3 Q3.G1 Q3.Nl (C.p Q3.Nl Qt) (C.o Q3.G3 Q3.G2 Q3.G1 (C.p Q3.G1 Q3.Qw) rho)) (C.o Q3.G3 Q3.G1 Q3.Nl (C.p Q3.Nl Qt) (C.o Q3.G3 Q3.G2 Q3.G1 (C.p Q3.G1 Q3.Qw) (C.p Q3.G2 Q3.Qw2)))
                    (\ K z -> refl z.1.1.1)))
        (transH (C.subT-o Q3.G3 Q3.G1 Q3.Nl Qt (C.p Q3.Nl Qt) (C.o Q3.G3 Q3.G2 Q3.G1 (C.p Q3.G1 Q3.Qw) (C.p Q3.G2 Q3.Qw2)))
          (C.subT-o Q3.G3 Q3.G2 Q3.G1 Q3.Qw (C.p Q3.G1 Q3.Qw) (C.p Q3.G2 Q3.Qw2))))) ;
  IdP : Id (C.Ty Q3.G3) (C.subT Q3.G3 Q3.G2 (IJ.IdT Q3.G2 Q3.Qw2 Q3.v1 Q3.v2) rho) OT.IdOp =
   OV.Id-ov Q3.G3 Q3.G2 Q3.Qw2 Q3.v1 Q3.v2 rho Q3.Qw3 PQ OT.o12w (C.q Q3.G2 Q3.Qw2)
    (elx Q3.G3 (C.subT Q3.G3 Q3.G2 Q3.Qw2 rho) Q3.Qw3 PQ (C.subt Q3.G3 Q3.G2 Q3.Qw2 Q3.v1 rho) OT.o12w (\ K z -> refl (Qt.1.tob K z.1.1.1)) (\ K z -> refl (OT.o12.eob K z.1)))
    (elx Q3.G3 (C.subT Q3.G3 Q3.G2 Q3.Qw2 rho) Q3.Qw3 PQ (C.subt Q3.G3 Q3.G2 Q3.Qw2 Q3.v2 rho) (C.q Q3.G2 Q3.Qw2) (\ K z -> refl (Qt.1.tob K z.1.1.1)) (\ K z -> refl z.2)) ;
  propOp : C.El Q3.G3 (PU.isProp Q3.G3 OT.IdOp) =
   OV.trE Q3.G3 (C.subT Q3.G3 Q3.G2 Q3.SP rho) (PU.isProp Q3.G3 OT.IdOp) (PU.isProp-ov Q3.G3 Q3.G2 (IJ.IdT Q3.G2 Q3.Qw2 Q3.v1 Q3.v2) rho OT.IdOp IdP) (C.subt Q3.G3 Q3.G2 Q3.SP (Q3.setV2 sq) rho) ;
 } ;


-- the Id type of a constant over nil.Q is a proposition
module PropCst (Qt : C.Ty C.nil) (c : C.El C.nil Qt) (sq : CQCtx[a].G3Of[Qt].SetQiTy) {
 module Q3 = CQCtx[a].G3Of[Qt] ;
 module CT = Q3.CTy[c] ;
 rnt (K : Ob) (x : V1.Ix (Q3.G1.ob K)) : V1.Ix (Q3.G2.ob K) = ((x.1, c.eob K x.1), x.2) ;
 rnat (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (Q3.G1.ob K)) : Id (V1.Ix (Q3.G2.ob L0)) (rnt L0 (Q3.G1.act L0 K g x)) (Q3.G2.act L0 K g (rnt K x)) =
  apH {V1.Ix (Qt.1.tob L0 x.1)} {V1.Ix (Q3.G2.ob L0)} (\ z -> ((x.1, z), (Q3.G1.act L0 K g x).2)) (symH (c.enat L0 K g x.1 x.1 (refl x.1))) ;
 rho : C.Sub Q3.G1 Q3.G2 = new L.PSub[Q3.G1, Q3.G2, rnt, rnat] ;
 PQ : Id (C.Ty Q3.G1) (C.subT Q3.G1 Q3.G2 Q3.Qw2 rho) Q3.Qw =
  transH (symH (C.subT-o Q3.G1 Q3.G2 Q3.G1 Q3.Qw (C.p Q3.G1 Q3.Qw) rho))
   (transH (symH (C.subT-o Q3.G1 Q3.G1 Q3.Nl Qt (C.p Q3.Nl Qt) (C.o Q3.G1 Q3.G2 Q3.G1 (C.p Q3.G1 Q3.Qw) rho)))
     (apH {C.Sub Q3.G1 Q3.Nl} {C.Ty Q3.G1} (\ z -> C.subT Q3.G1 Q3.Nl Qt z)
        (L.sub-ext Q3.G1 Q3.Nl (C.o Q3.G1 Q3.G1 Q3.Nl (C.p Q3.Nl Qt) (C.o Q3.G1 Q3.G2 Q3.G1 (C.p Q3.G1 Q3.Qw) rho)) (C.p Q3.Nl Qt) (\ K z -> refl z.1)))) ;
 IdP : Id (C.Ty Q3.G1) (C.subT Q3.G1 Q3.G2 (IJ.IdT Q3.G2 Q3.Qw2 Q3.v1 Q3.v2) rho) CT.IdCst =
  OV.Id-ov Q3.G1 Q3.G2 Q3.Qw2 Q3.v1 Q3.v2 rho Q3.Qw PQ CT.cw (C.q Q3.Nl Qt)
   (elx Q3.G1 (C.subT Q3.G1 Q3.G2 Q3.Qw2 rho) Q3.Qw PQ (C.subt Q3.G1 Q3.G2 Q3.Qw2 Q3.v1 rho) CT.cw (\ K z -> refl (Qt.1.tob K z.1)) (\ K z -> refl (c.eob K z.1)))
   (elx Q3.G1 (C.subT Q3.G1 Q3.G2 Q3.Qw2 rho) Q3.Qw PQ (C.subt Q3.G1 Q3.G2 Q3.Qw2 Q3.v2 rho) (C.q Q3.Nl Qt) (\ K z -> refl (Qt.1.tob K z.1)) (\ K z -> refl z.2)) ;
 propCst : C.El Q3.G1 (PU.isProp Q3.G1 CT.IdCst) =
  OV.trE Q3.G1 (C.subT Q3.G1 Q3.G2 Q3.SP rho) (PU.isProp Q3.G1 CT.IdCst) (PU.isProp-ov Q3.G1 Q3.G2 (IJ.IdT Q3.G2 Q3.Qw2 Q3.v1 Q3.v2) rho CT.IdCst IdP) (C.subt Q3.G1 Q3.G2 Q3.SP (Q3.setV2 sq) rho) ;
} ;

module HomOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (addO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (mulO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (s t : SX.Over[R].Presentation)
 (Phi : C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, s, pe].Qt CAlgX[a].AlgX[R, encK, t, pe].Qt)) {
 module SG = CBridge[a].Sig[R, encK, pe, addO, mulO, s, t, Phi] ;
 module S = SG.S ;
 module T = SG.T ;
 Nl : C.Ctx = C.nil ;
 NO (K : Ob) : U a+ = V1.Ix (Nl.ob K) ;

 -- the data for a binary operation (opS on A_s, opT on A_t)
 module Bin (opS : C.El Nl (OV.Fun Nl S.Qt (OV.Fun Nl S.Qt S.Qt))) (opT : C.El Nl (OV.Fun Nl T.Qt (OV.Fun Nl T.Qt T.Qt))) {
  IdS : C.Ty S.G3 = S.QC.OpTy[opS].IdOp ;
  IdT : C.Ty T.G3 = T.QC.OpTy[opT].IdOp ;
  -- the section of nil.Q^3 at three global elements (semantic)
  module Sec3 (q1 q2 q3 : C.El Nl S.Qt) {
   nt (K : Ob) (o : NO K) : V1.Ix (S.G3.ob K) = (((o, q1.eob K o), q2.eob K o), q3.eob K o) ;
   nat (L0 K : Ob) (g : Hom L0 K) (o : NO K) : Id (V1.Ix (S.G3.ob L0)) (nt L0 (Nl.act L0 K g o)) (S.G3.act L0 K g (nt K o)) =
    transH (apH {V1.Ix (S.Qt.1.tob L0 o)} {V1.Ix (S.G3.ob L0)} (\ z -> (((o, z), q2.eob L0 o), q3.eob L0 o)) (symH (q1.enat L0 K g o o (refl o))))
     (transH (apH {V1.Ix (S.Qt.1.tob L0 o)} {V1.Ix (S.G3.ob L0)} (\ z -> (((o, S.Qt.1.tact L0 K g o o (refl o) (q1.eob K o)), z), q3.eob L0 o)) (symH (q2.enat L0 K g o o (refl o))))
       (apH {V1.Ix (S.Qt.1.tob L0 o)} {V1.Ix (S.G3.ob L0)} (\ z -> (((o, S.Qt.1.tact L0 K g o o (refl o) (q1.eob K o)), S.Qt.1.tact L0 K g o o (refl o) (q2.eob K o)), z)) (symH (q3.enat L0 K g o o (refl o))))) ;
   sec3 : C.Sub Nl S.G3 = CQCtx[a].G3Of[S.Qt].Sec3[q1, q2, q3].sec3 ;
   Hy : C.Ty Nl = C.subT Nl S.G3 IdS sec3 ;
   Del : C.Ctx = C.ext Nl Hy ;
   -- the substitutions of Del into nil.Q_s^3 and nil.Q_t^3
   tau : C.Sub Del S.G3 = new L.PSub[Del, S.G3, \ K x -> nt K x.1, \ L0 K g x -> nat L0 K g x.1] ;
   -- the image under Phi of a global element, natural
   ph (K : Ob) (o : NO K) (q : C.El Nl S.Qt) : SG.TQ K o = SG.phiG K o (q.eob K o) ;
   phn (L0 K : Ob) (g : Hom L0 K) (o : NO K) (q : C.El Nl S.Qt) : Id (SG.TQ L0 o) (ph L0 o q) (SG.rsT K L0 g o (ph K o q)) =
    transH (apH {SG.SQ L0 o} {SG.TQ L0 o} (SG.phiG L0 o) (symH (q.enat L0 K g o o (refl o)))) (SG.phiG-nat K L0 g o (q.eob K o)) ;
   snt (K : Ob) (x : V1.Ix (Del.ob K)) : V1.Ix (T.G3.ob K) = (((x.1, ph K x.1 q1), ph K x.1 q2), ph K x.1 q3) ;
   snat (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (Del.ob K)) : Id (V1.Ix (T.G3.ob L0)) (snt L0 (Del.act L0 K g x)) (T.G3.act L0 K g (snt K x)) =
    transH (apH {SG.TQ L0 x.1} {V1.Ix (T.G3.ob L0)} (\ z -> (((x.1, z), ph L0 x.1 q2), ph L0 x.1 q3)) (phn L0 K g x.1 q1))
     (transH (apH {SG.TQ L0 x.1} {V1.Ix (T.G3.ob L0)} (\ z -> (((x.1, SG.rsT K L0 g x.1 (ph K x.1 q1)), z), ph L0 x.1 q3)) (phn L0 K g x.1 q2))
       (apH {SG.TQ L0 x.1} {V1.Ix (T.G3.ob L0)} (\ z -> (((x.1, SG.rsT K L0 g x.1 (ph K x.1 q1)), SG.rsT K L0 g x.1 (ph K x.1 q2)), z)) (phn L0 K g x.1 q3))) ;
   sigma : C.Sub Del T.G3 = new L.PSub[Del, T.G3, snt, snat] ;
  -- the types and terms over Del
   A : C.Ty Del = C.subT Del S.G3 S.Qw3 tau ;
   B : C.Ty Del = C.subT Del T.G3 T.Qw3 sigma ;
   x : C.El Del A = C.subt Del S.G3 S.Qw3 (OV.wkE S.G2 S.Qw2 S.Qw2 S.QC.OpTy[opS].o12) tau ;
   y : C.El Del A = C.subt Del S.G3 S.Qw3 (C.q S.G2 S.Qw2) tau ;
   -- the point equation of A's action, down to the terminal context
   eA (L0 K : Ob) (g : Hom L0 K) (d : V1.Ix (Del.ob K)) : Id (NO L0) (Nl.act L0 K g d.1) d.1 =
    L.ntEq S.G1 Nl (C.p Nl S.Qt) L0 K g (nt K d.1).1.1 (nt L0 (Del.act L0 K g d).1).1.1
     (L.ntEq S.G2 S.G1 (C.p S.G1 S.Qw) L0 K g (nt K d.1).1 (nt L0 (Del.act L0 K g d).1).1
       (L.ntEq S.G3 S.G2 (C.p S.G2 S.Qw2) L0 K g (nt K d.1) (nt L0 (Del.act L0 K g d).1)
         (L.ntEq Del S.G3 tau L0 K g d (Del.act L0 K g d) (refl (Del.act L0 K g d))))) ;
   -- Phi's semantic body over Del.A
   DA : C.Ctx = C.ext Del A ;
   rt (K : Ob) (w : V1.Ix (DA.ob K)) : V1.Ix ((OV.wkT Del A B).1.tob K w) = SG.phiG K w.1.1 w.2 ;
   lhsA (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K)) : SG.TQ L0 w.1.1 = (OV.wkT Del A B).1.tact L0 K g w (DA.act L0 K g w) (refl (DA.act L0 K g w)) (rt K w) ;
   rhsA (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K)) : SG.TQ L0 w.1.1 = SG.rsT K L0 g w.1.1 (SG.phiG K w.1.1 w.2) ;
   eB (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K)) : Id (NO L0) (Nl.act L0 K g w.1.1) w.1.1 =
    L.ntEq T.G1 Nl (C.p Nl T.Qt) L0 K g (snt K w.1).1.1 (snt L0 (DA.act L0 K g w).1).1.1
     (L.ntEq T.G2 T.G1 (C.p T.G1 T.Qw) L0 K g (snt K w.1).1 (snt L0 (DA.act L0 K g w).1).1
       (L.ntEq T.G3 T.G2 (C.p T.G2 T.Qw2) L0 K g (snt K w.1) (snt L0 (DA.act L0 K g w).1)
         (L.ntEq Del T.G3 sigma L0 K g w.1 (DA.act L0 K g w).1
           (L.ntEq DA Del (C.p Del A) L0 K g w (DA.act L0 K g w) (refl (DA.act L0 K g w)))))) ;
   -- the target side: B's action is Q_t's along some point equation
   rA (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K))
    : Id (SG.TQ L0 w.1.1) ((OV.wkT Del A B).1.tact L0 K g w (DA.act L0 K g w) (refl (DA.act L0 K g w)) (rt K w)) (SG.rsT K L0 g w.1.1 (SG.phiG K w.1.1 w.2)) =
    L.tact-irr Nl T.Qt.1 L0 K g w.1.1 w.1.1 (eB L0 K g w) (refl w.1.1) (SG.phiG K w.1.1 w.2) ;
   -- the source side
   rB (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K))
    : Id (SG.SQ L0 w.1.1) (SG.rsS K L0 g w.1.1 w.2) (DA.act L0 K g w).2 =
    symH (L.tact-irr Nl S.Qt.1 L0 K g w.1.1 w.1.1 (eA L0 K g w.1) (refl w.1.1) w.2) ;
   rn0 (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K))
    : Id (V1.Ix ((OV.wkT Del A B).1.tob L0 (DA.act L0 K g w))) ((OV.wkT Del A B).1.tact L0 K g w (DA.act L0 K g w) (refl (DA.act L0 K g w)) (rt K w)) (rt L0 (DA.act L0 K g w)) =
    transH (rA L0 K g w)
     (transH (symH (SG.phiG-nat K L0 g w.1.1 w.2))
       (apH {SG.SQ L0 w.1.1} {SG.TQ L0 w.1.1} (SG.phiG L0 w.1.1) (rB L0 K g w))) ;
   rn (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K)) (w' : V1.Ix (DA.ob L0)) (e : Id (V1.Ix (DA.ob L0)) (DA.act L0 K g w) w')
    : Id (V1.Ix ((OV.wkT Del A B).1.tob L0 w')) ((OV.wkT Del A B).1.tact L0 K g w w' e (rt K w)) (rt L0 w') =
    idJ (V1.Ix (DA.ob L0)) (DA.act L0 K g w) (\ w2 e2 -> Id (V1.Ix ((OV.wkT Del A B).1.tob L0 w2)) ((OV.wkT Del A B).1.tact L0 K g w w2 e2 (rt K w)) (rt L0 w2))
     (rn0 L0 K g w) w' e ;
   r : C.El DA (OV.wkT Del A B) = new L.PEl[DA, (OV.wkT Del A B).1, rt, rn] ;
   -- the hypothesis as an Id over Del between x and y
   tauEq : Id (C.Sub Del S.G3) (C.o Del Nl S.G3 sec3 (C.p Nl Hy)) tau =
    L.sub-ext Del S.G3 (C.o Del Nl S.G3 sec3 (C.p Nl Hy)) tau (\ K w -> refl (nt K w.1)) ;
   uP : Id (C.Ty Del) (C.subT Del Nl Hy (C.p Nl Hy)) (IJ.IdT Del A x y) =
    transH (symH (C.subT-o Del Nl S.G3 IdS sec3 (C.p Nl Hy)))
     (transH (apH {C.Sub Del S.G3} {C.Ty Del} (\ z -> C.subT Del S.G3 IdS z) tauEq)
       (IJ.IdT-nat Del S.G3 S.Qw3 (OV.wkE S.G2 S.Qw2 S.Qw2 S.QC.OpTy[opS].o12) (C.q S.G2 S.Qw2) tau)) ;
   u : C.El Del (IJ.IdT Del A x y) = OV.trE Del (C.subT Del Nl Hy (C.p Nl Hy)) (IJ.IdT Del A x y) uP (C.q Nl Hy) ;
   -- Phi applied to the hypothesis
   apU : C.El Del (IJ.IdT Del B (PT.atv Del A B r x) (PT.atv Del A B r y)) = PT.apM Del A B r x y u ;
   -- readings of the internal terms of the law
   module RT (X : SX.Over[R].Presentation) {
    module AX = CMorX[a].MorOf[R, encK, pe, addO, mulO].At[X] ;
    FQ : C.Ty Nl = OV.Fun Nl AX.Qt AX.Qt ;
    rdOp (op : C.El Nl (OV.Fun Nl AX.Qt FQ)) (a1 a2 : C.El Nl AX.Qt) (K : Ob) (o : NO K)
     : Id (V1.Ix (AX.Qt.1.tob K o)) ((OV.app Nl AX.Qt AX.Qt (OV.app Nl AX.Qt FQ op a1) a2).eob K o)
          (CSemOp[a].SemOp[AX.Qt, op].ev2 K o (a1.eob K o) (a2.eob K o)) =
     transH (CAppRd[a].App0[AX.Qt, AX.Qt, OV.app Nl AX.Qt FQ op a1, a2].rd K o)
      (apH {V1.Ix (FQ.1.tob K o)} {V1.Ix (AX.Qt.1.tob K o)} (\ m -> m.1 K (idH K) (a2.eob K o)) (CAppRd[a].App0[AX.Qt, FQ, op, a1].rd K o)) ;
   } ;
   rdPhi (q : C.El Nl S.Qt) (K : Ob) (o : NO K) : Id (SG.TQ K o) ((OV.app Nl S.Qt T.Qt Phi q).eob K o) (SG.phiG K o (q.eob K o)) =
    CAppRd[a].App0[S.Qt, T.Qt, Phi, q].rd K o ;
   -- B is Q_t weakened to Del
   PB0 : Id (C.Ty Del) B (C.subT Del Nl T.Qt (C.o Del T.G1 Nl (C.p Nl T.Qt) (C.o Del T.G2 T.G1 (C.p T.G1 T.Qw) (C.o Del T.G3 T.G2 (C.p T.G2 T.Qw2) sigma)))) =
    transH (symH (C.subT-o Del T.G3 T.G2 T.Qw2 (C.p T.G2 T.Qw2) sigma))
     (transH (symH (C.subT-o Del T.G2 T.G1 T.Qw (C.p T.G1 T.Qw) (C.o Del T.G3 T.G2 (C.p T.G2 T.Qw2) sigma)))
       (symH (C.subT-o Del T.G1 Nl T.Qt (C.p Nl T.Qt) (C.o Del T.G2 T.G1 (C.p T.G1 T.Qw) (C.o Del T.G3 T.G2 (C.p T.G2 T.Qw2) sigma))))) ;
   pEq : Id (C.Sub Del Nl) (C.o Del T.G1 Nl (C.p Nl T.Qt) (C.o Del T.G2 T.G1 (C.p T.G1 T.Qw) (C.o Del T.G3 T.G2 (C.p T.G2 T.Qw2) sigma))) (C.p Nl Hy) =
    L.sub-ext Del Nl (C.o Del T.G1 Nl (C.p Nl T.Qt) (C.o Del T.G2 T.G1 (C.p T.G1 T.Qw) (C.o Del T.G3 T.G2 (C.p T.G2 T.Qw2) sigma))) (C.p Nl Hy) (\ K z -> refl z.1) ;
   PA : Id (C.Ty Del) (C.subT Del Nl T.Qt (C.p Nl Hy)) B =
    symH (transH PB0 (apH {C.Sub Del Nl} {C.Ty Del} (\ z -> C.subT Del Nl T.Qt z) pEq)) ;
   atvRd (K : Ob) (z : V1.Ix (Del.ob K)) : Id (SG.TQ K z.1) ((PT.atv Del A B r x).eob K z) (SG.phiG K z.1 (x.eob K z)) =
    transH (CAppRd[a].trE-rd Del (C.subT Del DA (OV.wkT Del A B) (C.sec Del A x)) B (CAppRd[a].W.psT Del A B x) (C.subt Del DA (OV.wkT Del A B) r (C.sec Del A x)) K z)
     (CAppRd[a].same-rd Del (C.subT Del DA (OV.wkT Del A B) (C.sec Del A x)) B (CAppRd[a].W.psT Del A B x) K z (refl (B.1.tob K z)) (r.eob K (z, x.eob K z))) ;
   -- the law at the three global elements, over Del
   module LW (lawG : C.El Nl (IJ.IdT Nl T.Qt (OV.app Nl T.Qt T.Qt (OV.app Nl T.Qt (OV.Fun Nl T.Qt T.Qt) opT (OV.app Nl S.Qt T.Qt Phi q1)) (OV.app Nl S.Qt T.Qt Phi q2))
                                           (OV.app Nl S.Qt T.Qt Phi (OV.app Nl S.Qt S.Qt (OV.app Nl S.Qt (OV.Fun Nl S.Qt S.Qt) opS q1) q2)))) {
    L0 : C.El Nl T.Qt = OV.app Nl T.Qt T.Qt (OV.app Nl T.Qt (OV.Fun Nl T.Qt T.Qt) opT (OV.app Nl S.Qt T.Qt Phi q1)) (OV.app Nl S.Qt T.Qt Phi q2) ;
    R0 : C.El Nl T.Qt = OV.app Nl S.Qt T.Qt Phi (OV.app Nl S.Qt S.Qt (OV.app Nl S.Qt (OV.Fun Nl S.Qt S.Qt) opS q1) q2) ;
    oT : C.El Del B = C.subt Del T.G3 T.Qw3 (OV.wkE T.G2 T.Qw2 T.Qw2 T.QC.OpTy[opT].o12) sigma ;
    Pa : Id (C.El Del B) (OV.trE Del (C.subT Del Nl T.Qt (C.p Nl Hy)) B PA (C.subt Del Nl T.Qt L0 (C.p Nl Hy))) oT =
     elx Del (C.subT Del Nl T.Qt (C.p Nl Hy)) B PA (C.subt Del Nl T.Qt L0 (C.p Nl Hy)) oT (\ K z -> refl (T.Qt.1.tob K z.1)) (\ K z ->
      transH (RT[t].rdOp opT (OV.app Nl S.Qt T.Qt Phi q1) (OV.app Nl S.Qt T.Qt Phi q2) K z.1)
       (transH (apH {SG.TQ K z.1} {SG.TQ K z.1} (\ v -> CSemOp[a].SemOp[T.Qt, opT].ev2 K z.1 v ((OV.app Nl S.Qt T.Qt Phi q2).eob K z.1)) (rdPhi q1 K z.1))
         (apH {SG.TQ K z.1} {SG.TQ K z.1} (\ v -> CSemOp[a].SemOp[T.Qt, opT].ev2 K z.1 (SG.phiG K z.1 (q1.eob K z.1)) v) (rdPhi q2 K z.1)))) ;
    Pb : Id (C.El Del B) (OV.trE Del (C.subT Del Nl T.Qt (C.p Nl Hy)) B PA (C.subt Del Nl T.Qt R0 (C.p Nl Hy))) (PT.atv Del A B r x) =
     elx Del (C.subT Del Nl T.Qt (C.p Nl Hy)) B PA (C.subt Del Nl T.Qt R0 (C.p Nl Hy)) (PT.atv Del A B r x) (\ K z -> refl (T.Qt.1.tob K z.1)) (\ K z ->
      transH (rdPhi (OV.app Nl S.Qt S.Qt (OV.app Nl S.Qt (OV.Fun Nl S.Qt S.Qt) opS q1) q2) K z.1)
       (transH (apH {SG.SQ K z.1} {SG.TQ K z.1} (SG.phiG K z.1) (RT[s].rdOp opS q1 q2 K z.1))
         (symH (atvRd K z)))) ;
    Lw : C.El Del (IJ.IdT Del B oT (PT.atv Del A B r x)) =
     OV.trE Del (C.subT Del Nl (IJ.IdT Nl T.Qt L0 R0) (C.p Nl Hy)) (IJ.IdT Del B oT (PT.atv Del A B r x))
      (OV.Id-ov Del Nl T.Qt L0 R0 (C.p Nl Hy) B PA oT (PT.atv Del A B r x) Pa Pb)
      (C.subt Del Nl (IJ.IdT Nl T.Qt L0 R0) lawG (C.p Nl Hy)) ;
    -- the right end: Phi applied to y reads as the target's q
    qT : C.El Del B = C.subt Del T.G3 T.Qw3 (C.q T.G2 T.Qw2) sigma ;
    yEq : Id (C.El Del B) (PT.atv Del A B r y) qT =
     L.el-ext Del B.1 (PT.atv Del A B r y) qT (\ K z ->
      transH (CAppRd[a].trE-rd Del (C.subT Del DA (OV.wkT Del A B) (C.sec Del A y)) B (CAppRd[a].W.psT Del A B y) (C.subt Del DA (OV.wkT Del A B) r (C.sec Del A y)) K z)
       (CAppRd[a].same-rd Del (C.subT Del DA (OV.wkT Del A B) (C.sec Del A y)) B (CAppRd[a].W.psT Del A B y) K z (refl (B.1.tob K z)) (r.eob K (z, y.eob K z)))) ;
    -- the datum over Del, in the target's Id type along sigma
    body0 : C.El Del (IJ.IdT Del B oT (PT.atv Del A B r y)) = PT.transM Del B oT (PT.atv Del A B r x) (PT.atv Del A B r y) Lw apU ;
    body1 : C.El Del (IJ.IdT Del B oT qT) = subst (C.El Del B) (\ e -> C.El Del (IJ.IdT Del B oT e)) (PT.atv Del A B r y) qT yEq body0 ;
    body : C.El Del (C.subT Del T.G3 IdT sigma) =
     OV.trE Del (IJ.IdT Del B oT qT) (C.subT Del T.G3 IdT sigma)
      (symH (IJ.IdT-nat Del T.G3 T.Qw3 (OV.wkE T.G2 T.Qw2 T.Qw2 T.QC.OpTy[opT].o12) (C.q T.G2 T.Qw2) sigma)) body1 ;
   } ;
  } ;




  ------------------------------------------------------------------
  -- the datum dA for CBridge, by ElimP3 from the law at classes
  module DataA (elimP3 : CQCtx[a].G3Of[S.Qt].ElimP3Ty S.AX.Term S.AX.cls) (sq : CQCtx[a].G3Of[T.Qt].SetQiTy)
   (lawC : (t1 t2 : S.AX.Term) -> C.El Nl (IJ.IdT Nl T.Qt
      (OV.app Nl T.Qt T.Qt (OV.app Nl T.Qt (OV.Fun Nl T.Qt T.Qt) opT (OV.app Nl S.Qt T.Qt Phi (S.AX.cls t1))) (OV.app Nl S.Qt T.Qt Phi (S.AX.cls t2)))
      (OV.app Nl S.Qt T.Qt Phi (OV.app Nl S.Qt S.Qt (OV.app Nl S.Qt (OV.Fun Nl S.Qt S.Qt) opS (S.AX.cls t1)) (S.AX.cls t2))))) {
   GA : C.Ctx = C.ext S.G3 IdS ;
   Tp : C.Ty GA = C.subT GA T.G3 IdT (SG.sgE IdS) ;
   PTy3 : C.Ty S.G3 = FibCwF[a, a+].fibPi.Pi S.G3 IdS Tp ;
   module PO = PropOp[T.Qt, opT, sq] ;
   iA : C.El T.G3 (PU.isProp T.G3 IdT) = PO.propOp ;
   opaque iA ;
   iAs : C.El GA (C.subT GA T.G3 (PU.isProp T.G3 IdT) (SG.sgE IdS)) = C.subt GA T.G3 (PU.isProp T.G3 IdT) iA (SG.sgE IdS) ;
   pO : Id (C.Ty GA) (C.subT GA T.G3 (PU.isProp T.G3 IdT) (SG.sgE IdS)) (PU.isProp GA Tp) = PU.isProp-ov GA T.G3 IdT (SG.sgE IdS) Tp (refl Tp) ;
   opaque iAs ; opaque pO ;
   pTp : C.El GA (PU.isProp GA Tp) = OV.trE GA (C.subT GA T.G3 (PU.isProp T.G3 IdT) (SG.sgE IdS)) (PU.isProp GA Tp) pO iAs ;
   opaque pTp ;
   pPr : C.El S.G3 (PU.isProp S.G3 PTy3) = PPp.piProp S.G3 IdS Tp pTp ;
   opaque pPr ;
   -- at three classes
   module H (t1 t2 t3 : S.AX.Term) {
    module SC = Sec3[S.AX.cls t1, S.AX.cls t2, S.AX.cls t3] ;
    B' : C.Ty SC.Del = C.subT SC.Del GA Tp (C.lift Nl S.G3 IdS SC.sec3) ;
    sgEq : Id (C.Sub SC.Del T.G3) (C.o SC.Del GA T.G3 (SG.sgE IdS) (C.lift Nl S.G3 IdS SC.sec3)) SC.sigma =
     L.sub-ext SC.Del T.G3 (C.o SC.Del GA T.G3 (SG.sgE IdS) (C.lift Nl S.G3 IdS SC.sec3)) SC.sigma (\ K d -> refl (SC.snt K d)) ;
    BP : Id (C.Ty SC.Del) (C.subT SC.Del T.G3 IdT SC.sigma) B' =
     transH (apH {C.Sub SC.Del T.G3} {C.Ty SC.Del} (\ z -> C.subT SC.Del T.G3 IdT z) (symH sgEq))
      (C.subT-o SC.Del GA T.G3 IdT (SG.sgE IdS) (C.lift Nl S.G3 IdS SC.sec3)) ;
    bd : C.El SC.Del B' = OV.trE SC.Del (C.subT SC.Del T.G3 IdT SC.sigma) B' BP (SC.LW[lawC t1 t2].body) ;
    h : C.El Nl (C.subT Nl S.G3 PTy3 SC.sec3) =
     OV.trE Nl (FibCwF[a, a+].fibPi.Pi Nl SC.Hy B') (C.subT Nl S.G3 PTy3 SC.sec3)
      (symH (OV.Pi-ov Nl S.G3 IdS Tp SC.sec3 SC.Hy (refl SC.Hy) B' (refl B')))
      (OV.lam Nl SC.Hy B' bd) ;
   } ;
   dA : C.El GA Tp = OV.bod S.G3 IdS Tp (elimP3 PTy3 pPr (\ t1 t2 t3 -> H[t1, t2, t3].h)) ;
  } ;
 } ;
 -- the data for a constant (cS in A_s, cT in A_t)
 module Cst (cS : C.El Nl S.Qt) (cT : C.El Nl T.Qt) {
  IdS : C.Ty S.G1 = S.QC.CTy[cS].IdCst ;
  IdT : C.Ty T.G1 = T.QC.CTy[cT].IdCst ;
  module Sec1 (q1 : C.El Nl S.Qt) {
   sec1 : C.Sub Nl S.G1 = CQCtx[a].G3Of[S.Qt].Sec1[q1].sec1 ;
   Hy : C.Ty Nl = C.subT Nl S.G1 IdS sec1 ;
   Del : C.Ctx = C.ext Nl Hy ;
   tau : C.Sub Del S.G1 = new L.PSub[Del, S.G1, \ K x -> (x.1, q1.eob K x.1), \ L0 K g x -> CQCtx[a].G3Of[S.Qt].Sec1[q1].nat L0 K g x.1] ;
   ph (K : Ob) (o : NO K) (q : C.El Nl S.Qt) : SG.TQ K o = SG.phiG K o (q.eob K o) ;
   phn (L0 K : Ob) (g : Hom L0 K) (o : NO K) (q : C.El Nl S.Qt) : Id (SG.TQ L0 o) (ph L0 o q) (SG.rsT K L0 g o (ph K o q)) =
    transH (apH {SG.SQ L0 o} {SG.TQ L0 o} (SG.phiG L0 o) (symH (q.enat L0 K g o o (refl o)))) (SG.phiG-nat K L0 g o (q.eob K o)) ;
   snt (K : Ob) (x : V1.Ix (Del.ob K)) : V1.Ix (T.G1.ob K) = (x.1, ph K x.1 q1) ;
   sigma : C.Sub Del T.G1 = new L.PSub[Del, T.G1, snt, \ L0 K g x -> apH {SG.TQ L0 x.1} {V1.Ix (T.G1.ob L0)} (\ z -> (x.1, z)) (phn L0 K g x.1 q1)] ;
   A : C.Ty Del = C.subT Del S.G1 S.Qw tau ;
   B : C.Ty Del = C.subT Del T.G1 T.Qw sigma ;
   x : C.El Del A = C.subt Del S.G1 S.Qw (S.QC.CTy[cS].cw) tau ;
   y : C.El Del A = C.subt Del S.G1 S.Qw (C.q Nl S.Qt) tau ;
   DA : C.Ctx = C.ext Del A ;
   rt (K : Ob) (w : V1.Ix (DA.ob K)) : V1.Ix ((OV.wkT Del A B).1.tob K w) = SG.phiG K w.1.1 w.2 ;
   eA (L0 K : Ob) (g : Hom L0 K) (d : V1.Ix (Del.ob K)) : Id (NO L0) (Nl.act L0 K g d.1) d.1 =
    L.ntEq S.G1 Nl (C.p Nl S.Qt) L0 K g (d.1, q1.eob K d.1) (d.1, q1.eob L0 d.1) (L.ntEq Del S.G1 tau L0 K g d (Del.act L0 K g d) (refl (Del.act L0 K g d))) ;
   eB (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K)) : Id (NO L0) (Nl.act L0 K g w.1.1) w.1.1 =
    L.ntEq T.G1 Nl (C.p Nl T.Qt) L0 K g (snt K w.1) (snt L0 (DA.act L0 K g w).1)
     (L.ntEq Del T.G1 sigma L0 K g w.1 (DA.act L0 K g w).1 (L.ntEq DA Del (C.p Del A) L0 K g w (DA.act L0 K g w) (refl (DA.act L0 K g w)))) ;
   rA (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K))
    : Id (SG.TQ L0 w.1.1) ((OV.wkT Del A B).1.tact L0 K g w (DA.act L0 K g w) (refl (DA.act L0 K g w)) (rt K w)) (SG.rsT K L0 g w.1.1 (SG.phiG K w.1.1 w.2)) =
    L.tact-irr Nl T.Qt.1 L0 K g w.1.1 w.1.1 (eB L0 K g w) (refl w.1.1) (SG.phiG K w.1.1 w.2) ;
   rB (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K)) : Id (SG.SQ L0 w.1.1) (SG.rsS K L0 g w.1.1 w.2) (DA.act L0 K g w).2 =
    symH (L.tact-irr Nl S.Qt.1 L0 K g w.1.1 w.1.1 (eA L0 K g w.1) (refl w.1.1) w.2) ;
   rn0 (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K))
    : Id (V1.Ix ((OV.wkT Del A B).1.tob L0 (DA.act L0 K g w))) ((OV.wkT Del A B).1.tact L0 K g w (DA.act L0 K g w) (refl (DA.act L0 K g w)) (rt K w)) (rt L0 (DA.act L0 K g w)) =
    transH (rA L0 K g w) (transH (symH (SG.phiG-nat K L0 g w.1.1 w.2)) (apH {SG.SQ L0 w.1.1} {SG.TQ L0 w.1.1} (SG.phiG L0 w.1.1) (rB L0 K g w))) ;
   rn (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (DA.ob K)) (w' : V1.Ix (DA.ob L0)) (e : Id (V1.Ix (DA.ob L0)) (DA.act L0 K g w) w')
    : Id (V1.Ix ((OV.wkT Del A B).1.tob L0 w')) ((OV.wkT Del A B).1.tact L0 K g w w' e (rt K w)) (rt L0 w') =
    idJ (V1.Ix (DA.ob L0)) (DA.act L0 K g w) (\ w2 e2 -> Id (V1.Ix ((OV.wkT Del A B).1.tob L0 w2)) ((OV.wkT Del A B).1.tact L0 K g w w2 e2 (rt K w)) (rt L0 w2))
     (rn0 L0 K g w) w' e ;
   r : C.El DA (OV.wkT Del A B) = new L.PEl[DA, (OV.wkT Del A B).1, rt, rn] ;
   tauEq : Id (C.Sub Del S.G1) (C.o Del Nl S.G1 sec1 (C.p Nl Hy)) tau =
    L.sub-ext Del S.G1 (C.o Del Nl S.G1 sec1 (C.p Nl Hy)) tau (\ K w -> refl (w.1, q1.eob K w.1)) ;
   uP : Id (C.Ty Del) (C.subT Del Nl Hy (C.p Nl Hy)) (IJ.IdT Del A x y) =
    transH (symH (C.subT-o Del Nl S.G1 IdS sec1 (C.p Nl Hy)))
     (transH (apH {C.Sub Del S.G1} {C.Ty Del} (\ z -> C.subT Del S.G1 IdS z) tauEq)
       (IJ.IdT-nat Del S.G1 S.Qw (S.QC.CTy[cS].cw) (C.q Nl S.Qt) tau)) ;
   u : C.El Del (IJ.IdT Del A x y) = OV.trE Del (C.subT Del Nl Hy (C.p Nl Hy)) (IJ.IdT Del A x y) uP (C.q Nl Hy) ;
   apU : C.El Del (IJ.IdT Del B (PT.atv Del A B r x) (PT.atv Del A B r y)) = PT.apM Del A B r x y u ;
   PA : Id (C.Ty Del) (C.subT Del Nl T.Qt (C.p Nl Hy)) B =
    symH (transH (symH (C.subT-o Del T.G1 Nl T.Qt (C.p Nl T.Qt) sigma))
            (apH {C.Sub Del Nl} {C.Ty Del} (\ z -> C.subT Del Nl T.Qt z) (L.sub-ext Del Nl (C.o Del T.G1 Nl (C.p Nl T.Qt) sigma) (C.p Nl Hy) (\ K z -> refl z.1)))) ;
   atvRd (e0 : C.El Del A) (K : Ob) (z : V1.Ix (Del.ob K)) : Id (SG.TQ K z.1) ((PT.atv Del A B r e0).eob K z) (SG.phiG K z.1 (e0.eob K z)) =
    transH (CAppRd[a].trE-rd Del (C.subT Del DA (OV.wkT Del A B) (C.sec Del A e0)) B (CAppRd[a].W.psT Del A B e0) (C.subt Del DA (OV.wkT Del A B) r (C.sec Del A e0)) K z)
     (CAppRd[a].same-rd Del (C.subT Del DA (OV.wkT Del A B) (C.sec Del A e0)) B (CAppRd[a].W.psT Del A B e0) K z (refl (B.1.tob K z)) (r.eob K (z, e0.eob K z))) ;
   module LW (lawK : C.El Nl (IJ.IdT Nl T.Qt cT (OV.app Nl S.Qt T.Qt Phi cS))) {
    oT : C.El Del B = C.subt Del T.G1 T.Qw (T.QC.CTy[cT].cw) sigma ;
    Pa : Id (C.El Del B) (OV.trE Del (C.subT Del Nl T.Qt (C.p Nl Hy)) B PA (C.subt Del Nl T.Qt cT (C.p Nl Hy))) oT =
     elx Del (C.subT Del Nl T.Qt (C.p Nl Hy)) B PA (C.subt Del Nl T.Qt cT (C.p Nl Hy)) oT (\ K z -> refl (T.Qt.1.tob K z.1)) (\ K z -> refl (cT.eob K z.1)) ;
    Pb : Id (C.El Del B) (OV.trE Del (C.subT Del Nl T.Qt (C.p Nl Hy)) B PA (C.subt Del Nl T.Qt (OV.app Nl S.Qt T.Qt Phi cS) (C.p Nl Hy))) (PT.atv Del A B r x) =
     elx Del (C.subT Del Nl T.Qt (C.p Nl Hy)) B PA (C.subt Del Nl T.Qt (OV.app Nl S.Qt T.Qt Phi cS) (C.p Nl Hy)) (PT.atv Del A B r x) (\ K z -> refl (T.Qt.1.tob K z.1)) (\ K z ->
      transH (CAppRd[a].App0[S.Qt, T.Qt, Phi, cS].rd K z.1) (symH (atvRd x K z))) ;
    Lw : C.El Del (IJ.IdT Del B oT (PT.atv Del A B r x)) =
     OV.trE Del (C.subT Del Nl (IJ.IdT Nl T.Qt cT (OV.app Nl S.Qt T.Qt Phi cS)) (C.p Nl Hy)) (IJ.IdT Del B oT (PT.atv Del A B r x))
      (OV.Id-ov Del Nl T.Qt cT (OV.app Nl S.Qt T.Qt Phi cS) (C.p Nl Hy) B PA oT (PT.atv Del A B r x) Pa Pb)
      (C.subt Del Nl (IJ.IdT Nl T.Qt cT (OV.app Nl S.Qt T.Qt Phi cS)) lawK (C.p Nl Hy)) ;
    qT : C.El Del B = C.subt Del T.G1 T.Qw (C.q Nl T.Qt) sigma ;
    yEq : Id (C.El Del B) (PT.atv Del A B r y) qT = L.el-ext Del B.1 (PT.atv Del A B r y) qT (\ K z -> atvRd y K z) ;
    body0 : C.El Del (IJ.IdT Del B oT (PT.atv Del A B r y)) = PT.transM Del B oT (PT.atv Del A B r x) (PT.atv Del A B r y) Lw apU ;
    body1 : C.El Del (IJ.IdT Del B oT qT) = subst (C.El Del B) (\ e -> C.El Del (IJ.IdT Del B oT e)) (PT.atv Del A B r y) qT yEq body0 ;
    body : C.El Del (C.subT Del T.G1 IdT sigma) =
     OV.trE Del (IJ.IdT Del B oT qT) (C.subT Del T.G1 IdT sigma) (symH (IJ.IdT-nat Del T.G1 T.Qw (T.QC.CTy[cT].cw) (C.q Nl T.Qt) sigma)) body1 ;
   } ;
  } ;
  module DataC (elimP1 : CQCtx[a].G3Of[S.Qt].ElimP1Ty S.AX.Term S.AX.cls) (sq : CQCtx[a].G3Of[T.Qt].SetQiTy)
   (lawK : C.El Nl (IJ.IdT Nl T.Qt cT (OV.app Nl S.Qt T.Qt Phi cS))) {
   GA : C.Ctx = C.ext S.G1 IdS ;
   Tp : C.Ty GA = C.subT GA T.G1 IdT (SG.sg1 IdS) ;
   PTy1 : C.Ty S.G1 = FibCwF[a, a+].fibPi.Pi S.G1 IdS Tp ;
   module PO = PropCst[T.Qt, cT, sq] ;
   iC : C.El T.G1 (PU.isProp T.G1 IdT) = PO.propCst ;
   opaque iC ;
   pTp : C.El GA (PU.isProp GA Tp) =
    OV.trE GA (C.subT GA T.G1 (PU.isProp T.G1 IdT) (SG.sg1 IdS)) (PU.isProp GA Tp) (PU.isProp-ov GA T.G1 IdT (SG.sg1 IdS) Tp (refl Tp)) (C.subt GA T.G1 (PU.isProp T.G1 IdT) iC (SG.sg1 IdS)) ;
   opaque pTp ;
   pPr : C.El S.G1 (PU.isProp S.G1 PTy1) = PPp.piProp S.G1 IdS Tp pTp ;
   opaque pPr ;
   module H (t1 : S.AX.Term) {
    module SC = Sec1[S.AX.cls t1] ;
    B' : C.Ty SC.Del = C.subT SC.Del GA Tp (C.lift Nl S.G1 IdS SC.sec1) ;
    sgEq : Id (C.Sub SC.Del T.G1) (C.o SC.Del GA T.G1 (SG.sg1 IdS) (C.lift Nl S.G1 IdS SC.sec1)) SC.sigma =
     L.sub-ext SC.Del T.G1 (C.o SC.Del GA T.G1 (SG.sg1 IdS) (C.lift Nl S.G1 IdS SC.sec1)) SC.sigma (\ K d -> refl (SC.snt K d)) ;
    BP : Id (C.Ty SC.Del) (C.subT SC.Del T.G1 IdT SC.sigma) B' =
     transH (apH {C.Sub SC.Del T.G1} {C.Ty SC.Del} (\ z -> C.subT SC.Del T.G1 IdT z) (symH sgEq)) (C.subT-o SC.Del GA T.G1 IdT (SG.sg1 IdS) (C.lift Nl S.G1 IdS SC.sec1)) ;
    bd : C.El SC.Del B' = OV.trE SC.Del (C.subT SC.Del T.G1 IdT SC.sigma) B' BP (SC.LW[lawK].body) ;
    h : C.El Nl (C.subT Nl S.G1 PTy1 SC.sec1) =
     OV.trE Nl (FibCwF[a, a+].fibPi.Pi Nl SC.Hy B') (C.subT Nl S.G1 PTy1 SC.sec1) (symH (OV.Pi-ov Nl S.G1 IdS Tp SC.sec1 SC.Hy (refl SC.Hy) B' (refl B'))) (OV.lam Nl SC.Hy B' bd) ;
   } ;
   dC : C.El GA Tp = OV.bod S.G1 IdS Tp (elimP1 PTy1 pPr (\ t1 -> H[t1].h)) ;
  } ;
 } ;
} ;
