-- CHomT8.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 5: the map from HomT's
-- fibre at a stage I (at the nil point tt) to CMorX's map codes M I:
-- the families of CHomT4 with the naturality of CHomT6 (function part),
-- CHomT5 (+ and *) and CHomT7 (constants), packed (CMorX.pack).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module ToM (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module P = CHomT4[a].P3[R, encK, pe, s, t] ;
 module F = P.F ;
 module NA = CHomT5[a].DNOf[R, encK, pe, s, t, P.addO s, P.addO t, \ I z -> z.2.1] ;
 module NM = CHomT5[a].DNOf[R, encK, pe, s, t, P.mulO s, P.mulO t, \ I z -> z.2.2.1] ;
 module NP = CHomT6[a].NatOf[R, encK, pe, s, t] ;
 module NC (r : R.R) { module D = CHomT7[a].DNC[R, encK, pe, s, t, r] ; } ;
 beta (I : Ob) (z : P.Z I) : F.M I =
  F.pack I (P.fp I z) (NP.natId I z, (NA.dN I z, (NM.dN I z, \ r -> NC[r].D.dN I z))) ;
} ;
