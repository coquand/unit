-- CGen.seg (canonicity-45; SIMPLIFIED.md step 6): the generic algebra at
-- the real C (CMorXC.CatOf.IC, the presented k-algebras): the presheaf
-- yo(F1) on the total site and G := D(yo F1) (jonas.pdf Construction 45),
-- without its ring operations (those need Mod(F1, A) = A, i.e. the
-- universal map of A_F1).
--   F1       the presentation with one generator and no equation
--   yoF      yo(F1): at (I, x) the maps A_F1 -> A_x at the stage I (C is
--            the opposite of the algebras), acting by composition; its
--            laws are CMorXC's right unit and associativity (second
--            components, the hom codes not depending on the base map)
--   G        D(yo F1), a context at the total site
--   evG      evaluation at the generator Mod(F1, A_x) -> A_x, natural in the stage
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module GenOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (addO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (mulO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt))) {
 module CO = CMorXC[a].CatOf[R, encK, pe, addO, mulO] ;
 module MO = CO.MO ;
 IC : CIntCat[a, a+].IC = CO.IC ;
 module TP = CTPsh[a, a+, a+].TPshOf[IC] ;
 module DO = CobarI[a, a+, a+].DOfI[IC] ;
 Pres : U a = MO.Pres ;
 F1 : Pres = (suc zero, nil) ;

 -- yo(F1)
 yob (I : Ob) (x : Pres) : V1.V = CO.homV1 I x F1 ;
 yoa (J I : Ob) (u : Hom J I) (y x : Pres) (f : MO.Fn[x, y].M J) (g : MO.Fn[F1, x].M I) : MO.Fn[F1, y].M J =
  CO.cmpM J I I u y x F1 g f ;
 yo-id (I : Ob) (x : Pres) (g : MO.Fn[F1, x].M I) : Id (MO.Fn[F1, x].M I) (yoa I I (idH I) x x (CO.idM I x) g) g =
  apH {(w : Hom I I) * MO.Fn[F1, x].M I} {MO.Fn[F1, x].M I} (\ p -> p.2) (CO.idrL I I (idH I) x F1 g) ;
 yo-o (K J I : Ob) (u : Hom J I) (v : Hom K J) (z y x : Pres) (f : MO.Fn[x, y].M J) (f' : MO.Fn[y, z].M K) (g : MO.Fn[F1, x].M I)
  : Id (MO.Fn[F1, z].M K) (yoa K I (compH K J I u v) z x (CO.cmpM K J I v z y x f f') g) (yoa K J v z y f' (yoa J I u y x f g)) =
  symH (apH {(w : Hom K I) * MO.Fn[F1, z].M K} {MO.Fn[F1, z].M K} (\ p -> p.2) (CO.As[K, J, I, I, idH I, u, v, z, y, x, F1, g, f, f'].law)) ;
 yoF : TP.TCtx = new TP.TCtx[yob, yoa, yo-id, yo-o] ;

 -- the generic algebra's underlying context
 module DG = DO.DC[yoF] ;
 G : TP.TCtx = DG.DCtx ;
 -- evaluation at the generator: Mod(F1, A_x) -> A_x at every stage
 module AF = MO.At[F1] ;
 genQ : C.El C.nil AF.Qt = AF.AX.cls (var (inr tt)) ;
 gen (J : Ob) : AF.QK J = genQ.eob J tt ;
 evG (x : Pres) (J : Ob) (h : MO.Fn[F1, x].M J) : MO.At[x].QK J = MO.Fn[F1, x].ph J h J (idH J) (gen J) ;
 -- natural in the stage: evaluating the restriction is restricting the value
 evG-nat (x : Pres) (J K : Ob) (v : Hom K J) (h : MO.Fn[F1, x].M J)
  : Id (MO.At[x].QK K) (evG x K (MO.Fn[F1, x].res J K v h)) (MO.At[x].rs J K v (evG x J h)) =
  transH (apH {Hom K J} {MO.At[x].QK K} (\ w -> MO.Fn[F1, x].ph J h K w (gen K)) (transH (comp-idr K J v) (symH (comp-idl K J v))))
   (transH (apH {AF.QK K} {MO.At[x].QK K} (\ w -> MO.Fn[F1, x].ph J h K (compH K J J (idH J) v) w) (symH (genQ.enat K J v tt tt (refl tt))))
     (symH (MO.Fn[F1, x].nt J h J K (idH J) v (gen J)))) ;
} ;
