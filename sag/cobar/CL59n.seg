-- CL59n.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part n: the pointwise identity behind inv . ev ~ id.  For phi in
-- Pi_A Q at the copy y over Z.1 and n a point of yo(y.u) at Z,
--   ev(phi) restricted along (id, n)  =  ev''(phi, rho n)
-- (phi's naturality at the generic point rho(id) (CPiE.valE-act), rho's
-- naturality, rho's point equation for the change of map (CPiE.apW-f)).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module PL (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module DA0 = LA.Data[A, rho, rho1, Q] ;
  module OL = CL59l[a].Om[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module QC = CL59c[a].QCt[R, encK, pe, LA.yu, Q] ;
  module PE = DA0.PE ;
  module TA = PE.TA ;
  module TB = PE.TB ;
  -- transport in the constant family Q over yo(y).A
  substC (Z : CT.TC.TOb) (w1 w2 : TA.EI Z) (p : Id (TA.EI Z) w1 w2) (b : V1.Ix (Q.1.tob Z tt))
   : Id (V1.Ix (Q.1.tob Z tt)) (TB.coeT Z w1 w2 p b) b =
   idJ (TA.EI Z) w1 (\ w3 p3 -> Id (V1.Ix (Q.1.tob Z tt)) (TB.coeT Z w1 w3 p3 b) b) (refl b) w2 p ;
  module LP (Z : CT.TC.TOb) (phi : V1.Ix (DA0.piTob Z.1 tt)) (n : V1.Ix (LA.PYu.ob Z)) {
   J0 : CT.TC.TOb = (Z.1, LA.yu) ;
   I0 : CT.TC.TOb = (Z.1, y) ;
   hmZ : CT.TC.THm Z J0 = QC.hm Z n ;
   f1 : CT.TC.THm Z I0 = CT.TC.TotCat.oC Z J0 I0 (DA0.fW Z.1) hmZ ;
   e0 : TA.EI J0 = TA.pr J0 (DA0.ptW Z.1) (DA0.vW Z.1) ;
   v1 : V1.Ix (A.1.tob Z (LA.PYy.act Z I0 f1 (DA0.idy Z.1))) =
    A.1.tact Z J0 hmZ (DA0.ptW Z.1) (LA.PYy.act Z I0 f1 (DA0.idy Z.1)) (PE.PC.cOf I0 (DA0.idy Z.1) J0 Z (DA0.fW Z.1) hmZ) (DA0.vW Z.1) ;
   rn : TA.EI Z = rho.nt Z n ;
   idn : Id (V1.Ix (LA.PYu.ob Z)) (LA.PYu.act Z J0 hmZ (CM.CO.idM Z.1 LA.yu)) n =
    CM.MO.Fn[LA.yu, Z.2].mExt Z.1 (LA.PYu.act Z J0 hmZ (CM.CO.idM Z.1 LA.yu)) n (refl (CM.MO.Fn[LA.yu, Z.2].fpOf Z.1 n)) ;
   eAct : Id (TA.EI Z) (TA.E.act Z J0 hmZ e0) rn =
    transH (apH {TA.EI J0} {TA.EI Z} (TA.E.act Z J0 hmZ) (symH (TA.pr-coe J0 (TA.pr1 J0 (DA0.rW Z.1)) (DA0.ptW Z.1) (DA0.eqPt Z.1) (TA.pr2 J0 (DA0.rW Z.1)))))
     (transH (symH (rho.nt-nat Z J0 hmZ (CM.CO.idM Z.1 LA.yu))) (apH {V1.Ix (LA.PYu.ob Z)} {TA.EI Z} (rho.nt Z) idn)) ;
   R1 : Id (TA.EI Z) (TA.pr Z (LA.PYy.act Z I0 f1 (DA0.idy Z.1)) v1) rn =
    transH (symH (TA.pr-tact Z J0 hmZ (DA0.ptW Z.1) (LA.PYy.act Z I0 f1 (DA0.idy Z.1)) (PE.PC.cOf I0 (DA0.idy Z.1) J0 Z (DA0.fW Z.1) hmZ) (DA0.vW Z.1))) eAct ;
   F : Id (CT.TC.THm Z I0) (OL.fy Z (TA.pr1 Z rn)) f1 =
    CM.CO.pq Z.1 Z.1 Z.2 y (idH Z.1) (compH Z.1 Z.1 Z.1 (idH Z.1) (idH Z.1)) (symH (comp-idl Z.1 Z.1 (idH Z.1)))
     (TA.pr1 Z rn) f1.2
     (transH (rho1 Z n) (CM.MO.Fn[y, Z.2].mExt Z.1 (LA.PyoPu.nt Z n) f1.2 (refl (CM.MO.Fn[y, Z.2].fpOf Z.1 f1.2)))) ;
   p2 : Id (V1.Ix (LA.PYy.ob Z)) (LA.PYy.act Z I0 f1 (DA0.idy Z.1)) (TA.pr1 Z rn) = apH {TA.EI Z} {V1.Ix (LA.PYy.ob Z)} (TA.pr1 Z) R1 ;
   chain : Id (TB.EI Z) (TB.pr Z rn (OL.ev2 Z phi rn)) (TB.pr Z (TA.E.act Z J0 hmZ e0) (DA0.QA.1.tact Z J0 hmZ e0 (TA.E.act Z J0 hmZ e0) (refl (TA.E.act Z J0 hmZ e0)) (DA0.evV Z.1 phi))) =
    transH (PE.apW-f I0 (DA0.idy Z.1) phi Z (OL.fy Z (TA.pr1 Z rn)) f1 F rn (OL.pEq Z (TA.pr1 Z rn)) p2)
     (transH (PE.apW-E I0 (DA0.idy Z.1) phi Z f1 rn p2 v1 R1)
       (transH (symH (PE.valE-act I0 (DA0.idy Z.1) phi J0 Z (DA0.fW Z.1) hmZ (DA0.vW Z.1)))
         (TB.pr-tact Z J0 hmZ e0 (TA.E.act Z J0 hmZ e0) (refl (TA.E.act Z J0 hmZ e0)) (DA0.evV Z.1 phi)))) ;
   law : Id (V1.Ix (Q.1.tob Z tt)) (OL.ev2 Z phi rn) (QC.evq Z (DA0.evV Z.1 phi) n) =
    transH (symH (substC Z rn (TA.E.act Z J0 hmZ e0) (symH eAct) (OL.ev2 Z phi rn)))
     (transH (TB.pr-eq Z rn (TA.E.act Z J0 hmZ e0) (symH eAct) (OL.ev2 Z phi rn) (DA0.QA.1.tact Z J0 hmZ e0 (TA.E.act Z J0 hmZ e0) (refl (TA.E.act Z J0 hmZ e0)) (DA0.evV Z.1 phi)) chain)
       (G1.GB.GPre[a+].PS.tact-irr G1.fibCwF-T.nil Q.1 Z J0 hmZ tt tt
          (G1.GB.GPre[a+].PS.ntEq OL.E G1.fibCwF-T.nil (G1.fibCwF-T.eps OL.E) Z J0 hmZ e0 (TA.E.act Z J0 hmZ e0) (refl (TA.E.act Z J0 hmZ e0)))
          (refl tt) (DA0.evV Z.1 phi))) ;
  } ;
  -- D-functoriality: the two composites agree on (tau phi, D rho a)
  module CV = CL59d[a].Cv[R, encK, pe, LA.yu, Q] ;
  module CM2 = CL59m[a].CvO[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module IVd = CL59e[a].IV[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module RM = IVd.RM ;
  module OY = RM.OY ;
  module OZ = RM.OZ ;
  module P13m = RM.P13m ;
  module PNr = G1.FT.GEqQinv[a+].PN[P13m.DF.DG, P13m.DF.DA.DTy, P13m.DF.DB.DTy, P13m.DF.Df] ;
  module TYB = G1.GB.GPre[a+].TyL[P13m.DF.DG, P13m.DF.DB.DTy] ;
  module CA (X : CT.TC.TOb) (phi : V1.Ix (DA0.piTob X.1 tt)) (a0 : P13m.DF.DA.TOb' X.1 X.2 (OY.d1 X.1 X.2)) {
   psi' : V1.Ix (Q.1.tob (X.1, LA.yu) tt) = QC.qact X.1 X.1 (idH X.1) (DA0.evV X.1 phi) ;
   wq : CV.DQc.Ob' X.1 X.2 = CV.DQc.tau X.1 X.2 psi' ;
   wO : CM2.DOm.Ob' X.1 X.2 = CM2.DOm.tau X.1 X.2 phi ;
   dY : CV.DYu.Ob' X.1 X.2 = OY.fw X (OY.d1 X.1 X.2, a0) ;
   dZ : CM2.DE.Ob' X.1 X.2 = OZ.fw X (OY.d1 X.1 X.2, PNr.nf X (OY.d1 X.1 X.2) a0) ;
   module DM1 = QC.DF.DM[X.1, X.2, wq, CV.C1[X.1, X.2, wq, dY].res] ;
   module DM2 = CM2.DF2.DM[X.1, X.2, wO, CM2.C1[X.1, X.2, wO, dZ].res] ;
   module DMr = P13m.DF.DM[X.1, X.2, OY.d1 X.1 X.2, a0] ;
   nfEq : Id (P13m.DF.DB.TOb' X.1 X.2 (OY.d1 X.1 X.2)) (PNr.nf X (OY.d1 X.1 X.2) a0) DMr.res =
    TYB.pr-inj X (OY.d1 X.1 X.2) (PNr.nf X (OY.d1 X.1 X.2) a0) DMr.res (PNr.q X (OY.d1 X.1 X.2) a0) ;
   rEq (q : P13m.DF.DA.Idx X.1 X.2) (l : P13m.DF.DA.LandsI X.1 X.2 q)
    : Id (V1.Ix (OL.E.ob (q.2.1, q.2.2.2.1))) (dZ.1 q l) (rho.nt (q.2.1, q.2.2.2.1) (a0.1 q l)) =
    transH (apH {P13m.DF.DB.TOb' X.1 X.2 (OY.d1 X.1 X.2)} {V1.Ix (OL.E.ob (q.2.1, q.2.2.2.1))} (\ b0 -> b0.1 q l) nfEq)
     (P13m.DF.DB.pr-inj q.2.1 q.2.2.2.1 ((OY.d1 X.1 X.2).1 q l) (DMr.b q l) (rho.nt (q.2.1, q.2.2.2.1) (a0.1 q l)) (DMr.pc q l)) ;
   eqW (q : P13m.DF.DA.Idx X.1 X.2)
    : Id (V1.Ix (Q.1.tob (q.2.1, LA.yu) tt)) (QC.qact q.2.1 X.1 q.2.2.1 psi') (DA0.evV q.2.1 (DA0.piTact q.2.1 X.1 q.2.2.1 tt tt (refl tt) phi)) =
    transH (symH (QC.Qc.act-o q.2.1 X.1 X.1 (idH X.1) q.2.2.1 LA.yu LA.yu LA.yu (CM.IC.cart X.1 X.1 (idH X.1) LA.yu) (CM.IC.cart q.2.1 X.1 q.2.2.1 LA.yu) (DA0.evV X.1 phi)))
     (transH (apH {Hom q.2.1 X.1} {V1.Ix (Q.1.tob (q.2.1, LA.yu) tt)} (\ k -> QC.qact q.2.1 X.1 k (DA0.evV X.1 phi)) (comp-idl q.2.1 X.1 q.2.2.1))
       (DA0.EvN[q.2.1, X.1, q.2.2.1].At[phi].law)) ;
   pt (q : P13m.DF.DA.Idx X.1 X.2) (l : P13m.DF.DA.LandsI X.1 X.2 q) : Id (V1.Ix (Q.1.tob (q.2.1, q.2.2.2.1) tt)) (DM1.b q l) (DM2.b q l) =
    transH (QC.DF.DB.pr-inj q.2.1 q.2.2.2.1 (wq.1 q l) (DM1.b q l) (QC.evq (q.2.1, q.2.2.2.1) (wq.1 q l) (dY.1 q l)) (DM1.pc q l))
     (transH (apH {V1.Ix (Q.1.tob (q.2.1, LA.yu) tt)} {V1.Ix (Q.1.tob (q.2.1, q.2.2.2.1) tt)} (\ q0 -> QC.evq (q.2.1, q.2.2.2.1) q0 (a0.1 q l)) (eqW q))
       (transH (symH (LP[(q.2.1, q.2.2.2.1), wO.1 q l, a0.1 q l].law))
         (transH (apH {V1.Ix (OL.E.ob (q.2.1, q.2.2.2.1))} {V1.Ix (Q.1.tob (q.2.1, q.2.2.2.1) tt)} (OL.ev2 (q.2.1, q.2.2.2.1) (wO.1 q l)) (symH (rEq q l)))
           (symH (CM2.DF2.DB.pr-inj q.2.1 q.2.2.2.1 (wO.1 q l) (DM2.b q l) (OL.ev2 (q.2.1, q.2.2.2.1) (wO.1 q l) (dZ.1 q l)) (DM2.pc q l)))))) ;
   law : Id (CV.DQ.TOb' X.1 X.2 (CV.DT1.tau X.1 X.2 tt)) (CV.C2[X.1, X.2, wq, DM1.res].res) (CM2.C2[X.1, X.2, wO, DM2.res].res) =
    CV.DQ.tob-eq X.1 X.2 (CV.DT1.tau X.1 X.2 tt) (CV.C2[X.1, X.2, wq, DM1.res].res) (CM2.C2[X.1, X.2, wO, DM2.res].res) (\ q l -> pt q l) ;
  } ;
 } ;
} ;
