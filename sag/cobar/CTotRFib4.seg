-- CTotRFib4.seg (canonicity-c2; SIMPLIFIED.md item 5): the componentwise
-- composition for R B.  For a composition structure c0 of B from e to e'
-- at the levelwise site, the component at (Y , m) of the composite of a
-- partial line of R B is c0 applied to the projected side (CTotRFib3);
-- it is natural along the levelwise maps (KT.coreT: from c0's uniformity
-- and equality of the projected sides).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RFib4 (C : CIntCat[a].IC) {
 module R3 = CTotRFib3[a, l].RFib3[C] ;
 module TR = R3.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U a = RN.Ob0 ;
 Ob1 : U a = RN.Ob1 ;

 module Cp (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (e e' : G1.GB.IPt)
   (c0 : G0.GB.CLine[l].Lines[RS.rC G, B].CompK[e, e'].Comp) {
  module PR = R3.Pr[G, B, e] ;
  module TO = PR.TO ;
  module CT = PR.CT ;
  module L9 = PR.L9 ;
  module EK1 = PR.EK1 ;
  module EK0 = PR.EK0 ;
  UG : P0.PCtx = CT.UG ;
  K1 : P1.PCtx = PR.K1 ;
  K0 : P0.PCtx = PR.K0 ;
  module CK0 = G0.GB.CLine[l].Lines[UG, B].CompK[e, e'] ;
  module TT0 = CK0.SE.TS ;
  module SB0 = G0.GB.CSub[l].SubE[CT.RH.F0.GI, UG, CT.RH.F0.ev e', B] ;
  module RL0 = G0.GB.CPartial[l].Rel[K0, EK0.SFm.SF, CK0.Tend, CK0.endL] ;
  Tot0 (Y : Ob0) : U l = CT.Tot0 Y ;
  -- a total of the "other end" type, read as a total of B
  eps (Y : Ob0) (t : TT0.EI Y) : Tot0 Y = SB0.mV Y (CK0.SE.mV Y t) ;
  eps-nat (Z Y : Ob0) (h : RN.Hom0 Z Y) (t : TT0.EI Y) : Id (Tot0 Z) (L9.E0.act Z Y h (eps Y t)) (eps Z (TT0.E.act Z Y h t)) =
   trans (Tot0 Z) (L9.E0.act Z Y h (eps Y t)) (SB0.mV Z (SB0.TS.E.act Z Y h (CK0.SE.mV Y t))) (eps Z (TT0.E.act Z Y h t))
    (SB0.mV-nat Z Y h (CK0.SE.mV Y t))
    (ap (SB0.TS.EI Z) (Tot0 Z) (SB0.mV Z) (SB0.TS.E.act Z Y h (CK0.SE.mV Y t)) (CK0.SE.mV Z (TT0.E.act Z Y h t))
       (CK0.SE.mV-nat Z Y h t)) ;
  -- the point of B under a point of the levelwise context: the end e' of its line
  p0 (Y : Ob0) (z0 : EK0.TV.EI Y) : W0.Ix (UG.ob Y) = (CT.RH.F0.ev e').nt Y (EK0.TV.pr1 Y z0) ;
  eps-pr (Y : Ob0) (z0 : EK0.TV.EI Y) (b : W0.Ix (B.tob Y (p0 Y z0)))
   : Id (Tot0 Y) (eps Y (TT0.pr Y z0 b)) (P0.pairE UG B Y (p0 Y z0) b) = refl (P0.pairE UG B Y (p0 Y z0) b) ;

  -- the component of the composite at (Y , m)
  kv (X : Ob1) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) : W0.Ix (B.tob Y (p0 Y (PR.zc X z Y m))) =
   c0.kop Y (PR.zc X z Y m) PR.PS[X, z, s, Y, m].side ;

  -- naturality of the component along a levelwise map h : Z -> Y
  module KT (X : Ob1) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) (Z Y : Ob0) (h : RN.Hom0 Z Y) (m : RN.Hom1 (RN.o Y) X) {
   Fh : RN.Hom1 (RN.o Z) (RN.o Y) = TR.fn.onH Z Y h ;
   mZ : RN.Hom1 (RN.o Z) X = L9.mh X Y m Z h ;
   zY : EK0.TV.EI Y = PR.zc X z Y m ;
   zZ : EK0.TV.EI Z = PR.zc X z Z mZ ;
   module SY = PR.PS[X, z, s, Y, m] ;
   module SZ = PR.PS[X, z, s, Z, mZ] ;
   -- the restricted point is the point under (Z , m o F h)
   kn : Id (EK0.TV.EI Z) (K0.act Z Y h zY) zZ =
    sym (EK0.TV.EI Z) zZ (K0.act Z Y h zY)
     (trans (EK0.TV.EI Z) zZ (CT.kap Z (K1.act (RN.o Z) (RN.o Y) Fh (K1.act (RN.o Y) X m z))) (K0.act Z Y h zY)
        (ap (EK1.TV.EI (RN.o Z)) (EK0.TV.EI Z) (CT.kap Z) (K1.act (RN.o Z) X mZ z) (K1.act (RN.o Z) (RN.o Y) Fh (K1.act (RN.o Y) X m z))
           (K1.act-o (RN.o Z) (RN.o Y) X m Fh z))
        CT.KN[Z, Y, h, K1.act (RN.o Y) X m z].nat) ;
   rs : EK0.PT.Side[Z, K0.act Z Y h zY] = EK0.PT.rside Z Y h zY SY.side ;
   eQ : Id (G0.GB.Phi Z) rs.pQ SZ.side.pQ = G1.GB.pre-comp (RN.o Z) (RN.o Y) X Fh m s.pQ ;
   ev (W : Ob0) (k : RN.Hom0 W Z) (i : G0.GB.Lands W Z rs.pQ k) (i' : G0.GB.Lands W Z SZ.side.pQ k)
    : Id (EK0.TS.EI W) (rs.pv W k i) (SZ.side.pv W k i') =
    ap (EK1.TS.EI (RN.o W)) (EK0.TS.EI W) (TO.toTS W)
     (s.pv (RN.o W) (L9.mh X Y m W (G0.GB.BC.oC W Z Y h k)) (G0.GB.lands-pre W Z Y h SY.side.pQ k i))
     (s.pv (RN.o W) (L9.mh X Z mZ W k) i')
     (EK1.PT.pv-hom X z s (RN.o W) (L9.mh X Y m W (G0.GB.BC.oC W Z Y h k)) (L9.mh X Z mZ W k)
        (symH (L9.mhc X Y m W Z k h)) (G0.GB.lands-pre W Z Y h SY.side.pQ k i) i') ;
   sideEq : Id (EK0.PT.Side[Z, zZ]) (subst (EK0.TV.EI Z) (\ v -> EK0.PT.Side[Z, v]) (K0.act Z Y h zY) zZ kn rs) SZ.side =
    EK0.PT.side-extH Z (K0.act Z Y h zY) zZ kn rs SZ.side eQ ev ;
   kc : Id (TT0.EI Z) (TT0.pr Z (K0.act Z Y h zY) (c0.kop Z (K0.act Z Y h zY) rs)) (TT0.pr Z zZ (kv X z s Z mZ)) =
    RL0.kop-cong c0 Z (K0.act Z Y h zY) zZ kn rs SZ.side sideEq ;
   ku : Id (TT0.EI Z) (TT0.E.act Z Y h (TT0.pr Y zY (kv X z s Y m))) (TT0.pr Z (K0.act Z Y h zY) (c0.kop Z (K0.act Z Y h zY) rs)) =
    c0.kunif Z Y h zY SY.side ;
   coreT : Id (Tot0 Z) (L9.E0.act Z Y h (P0.pairE UG B Y (p0 Y zY) (kv X z s Y m))) (P0.pairE UG B Z (p0 Z zZ) (kv X z s Z mZ)) =
    trans (Tot0 Z) (L9.E0.act Z Y h (P0.pairE UG B Y (p0 Y zY) (kv X z s Y m))) (eps Z (TT0.E.act Z Y h (TT0.pr Y zY (kv X z s Y m))))
      (P0.pairE UG B Z (p0 Z zZ) (kv X z s Z mZ))
     (eps-nat Z Y h (TT0.pr Y zY (kv X z s Y m)))
     (ap (TT0.EI Z) (Tot0 Z) (eps Z) (TT0.E.act Z Y h (TT0.pr Y zY (kv X z s Y m))) (TT0.pr Z zZ (kv X z s Z mZ))
        (trans (TT0.EI Z) (TT0.E.act Z Y h (TT0.pr Y zY (kv X z s Y m))) (TT0.pr Z (K0.act Z Y h zY) (c0.kop Z (K0.act Z Y h zY) rs))
           (TT0.pr Z zZ (kv X z s Z mZ)) ku kc)) ;
  } ;
 } ;
} ;
