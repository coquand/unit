-- CTotSet11.seg (canonicity-c2; "D preserves h-sets", part 11): Hedberg
-- (CwFHed4) at D G . D A with x the variable, R, rho (CTotSet5) and f
-- (CTotSet10).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST11 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G))
  (pS : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.El (CTotSet1[a, vl, l].ST1[C, G, A].E1)
          (CTotSet1[a, vl, l].ST1[C, G, A].PN1.isProp (CTotSet1[a, vl, l].ST1[C, G, A].E1) (CTotSet1[a, vl, l].ST1[C, G, A].IdA))) {
 module S10 = CTotSet10[a, vl, l].ST10[C, G, A, pS] ;
 module S5 = S10.S5 ;
 module G1 = S10.G1 ;
 module OV = S10.S1.OV ;
 module H4 = CwFHed4.Hed4[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T] ;
 R : G1.fibCwF-T.Ty S5.K = S5.At[pS].R ;
 module S2 = S5.At[pS].S2 ;
 KR : G1.fibCwF-T.Ctx = G1.fibCwF-T.ext S5.K R ;
 IK : G1.fibCwF-T.Ty S5.K = S10.S9.JP.IK S5.Ext S5.SFT S5.xq ;
 TF : G1.fibCwF-T.Ty KR = G1.FT.GFibCwF[l].FC.subS KR S5.K IK (G1.fibCwF-T.p S5.K R) ;
 pth : Id (G1.fibCwF-T.Ty KR) (OV.wkT S5.K R IK) TF = refl TF ;
 module PSg = S10.F.PSg ;
 Rm : S10.P1.PTy[S5.K] = PSg.subTy S5.K S2.DGd S2.DTd.1 S10.S1.phi2 ;
 tq1 : Id (S10.P1.PTy[S5.K]) R.1 Rm = refl Rm ;
 tq2 : Id (S10.P1.PTy[S5.K]) Rm S10.F.R = refl Rm ;
 PT (X : S10.P1.PTy[S5.K]) : U (l+) = PSg.PEl[PSg.extP S5.K X, PSg.subTy (PSg.extP S5.K X) S5.K IK.1 (PSg.pP S5.K X)] ;
 fE2 : PT S10.F.R = S10.fE ;
 fE3 : PT R.1 = subst (S10.P1.PTy[S5.K]) PT S10.F.R R.1 (symH (transH tq1 tq2)) fE2 ;
 fE' : G1.fibCwF-T.El KR TF = fE3 ;
 fT : G1.fibCwF-T.El KR (OV.wkT S5.K R IK) = OV.trE KR TF (OV.wkT S5.K R IK) (symH pth) fE' ;
 module HH = H4.Hed[S5.Ext, S5.SFT, S5.xq, R, S5.At[pS].rho, fT] ;
} ;
