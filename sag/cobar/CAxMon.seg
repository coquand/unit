-- CAxMon.seg (canonicity-c2; the axioms' statements, duality part 1): the
-- monomials in n variables (exponent vectors), the index set MonI of pairs
-- (d, alpha) with |alpha| <= d, its projection to the degree bound, and the
-- finite list of the alpha with |alpha| <= d (metatheory, for evaluation).
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module MonOf (R : Ring[a].CRing) (n : Nat) {
 module V2 = V[a+] ;
 module RL = Ring[a] ;
 open RL ;
 -- exponent vectors (the last variable last), and their codes
 Exp : Nat -> U a = split { zero -> Top ; suc j | r -> r * Nat } ;
 ExpV : Nat -> V2.V = split { zero -> V2.unitV ; suc j | r -> V2.SigV r (\ _ -> V2.natV) } ;
 expIx : (j : Nat) -> Exp j -> V2.Ix (ExpV j) = split { zero -> \ e -> tt ; suc j | r -> \ e -> (r e.1, e.2) } ;
 deg : (j : Nat) -> Exp j -> Nat = split { zero -> \ _ -> zero ; suc j | r -> \ e -> Arith[a].plus (r e.1) e.2 } ;
 -- the exponent vectors of degree <= d (all vectors with entries <= d, filtered)
 range : Nat -> List Nat = split { zero -> cons zero nil ; suc m | r -> SX.appL Nat r (cons (suc m) nil) } ;
 concatMap (A B : U a) (f : A -> List B) : List A -> List B = split { nil -> nil ; cons x xs | r -> SX.appL B (f x) r } ;
 ifB (A : U a) (x y : A) : Bool -> A = split { true -> x ; false -> y } ;
 filt (A : U a) (p : A -> Bool) : List A -> List A = split { nil -> nil ; cons x xs | r -> ifB (List A) (cons x r) r (p x) } ;
 box (d : Nat) : (j : Nat) -> List (Exp j) = split {
  zero -> cons tt nil ;
  suc j | r -> concatMap (Exp j) (Exp (suc j)) (\ al -> SX.mapL Nat (Exp (suc j)) (\ e -> (al, e)) (range d)) r } ;
 mons (d : Nat) : List (Exp n) = filt (Exp n) (\ al -> leb (deg n al) d) (box d n) ;
 -- the polynomial of degree bound d: one coefficient variable per exponent vector
 Var : U a = Arith[a].Plus (Exp n) (SX.Fin n) ;
 module E = SX.Over[R] ;
 -- x^al over the point variables (the factor x_j^{al_j} for the last j last)
 pw (t : E.Expr Var) : Nat -> E.Expr Var = split { zero -> cst R.o ; suc m | r -> mulE r t } ;
 mono : (j : Nat) -> (SX.Fin j -> SX.Fin n) -> Exp j -> E.Expr Var = split {
  zero -> \ v al -> cst R.o ;
  suc j | r -> \ v al -> mulE (r (\ i -> v (inl i)) al.1) (pw (var (inr (v (inr tt)))) al.2) } ;
 sumL : List (Exp n) -> E.Expr Var = split {
  nil -> cst R.z ;
  cons al als | r -> sumE (mulE (var (inl al)) (mono n (\ i -> i) al)) r } ;
 poly (d : Nat) : E.Expr Var = sumL (mons d) ;
} ;
