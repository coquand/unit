-- CHomT11.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 8: the map back from
-- CMorX's map codes M I to HomT's fibre at I (at the nil point tt): the
-- function part on the nose, the data by CHomT9 (+, *) and CHomT10
-- (constants).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module FromM (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module P = CHomT4[a].P3[R, encK, pe, s, t] ;
 module F = P.F ;
 module RA = CHomT9[a].RevOf[R, encK, pe, s, t, P.addO s, P.addO t] ;
 module RM = CHomT9[a].RevOf[R, encK, pe, s, t, P.mulO s, P.mulO t] ;
 module RC = CHomT10[a].RevC[R, encK, pe, s, t] ;
 alpha (I : Ob) (m : F.M I) : P.Z I =
  (m.1,
   (RA.Back[I, m.1.1, m.1.2, m.2.1.1, m.2.1.2].piEl,
    (RM.Back[I, m.1.1, m.1.2, m.2.2.1.1, m.2.2.1.2].piEl,
     RC.Back[I, m.1.1, m.1.2, \ r -> (m.2.2.2 r).1, \ r -> (m.2.2.2 r).2].piEl))) ;
} ;
