-- CCmpK27.seg (canonicity-c2; (K) for cmpI, part 27): over Cb (stage 1),
-- the Ids e1 : cls t1 = q1 and h1 : ev g_1 = q1 as Ids in Q.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module K27 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K26m = CCmpK26[a].K26[R, encK, pe, y] ;
 module K19m = K26m.K19m ;
 module K12m = K19m.K12m ;
 module QS = K19m.QS ;
 Nl : C.Ctx = C.nil ;
 Q : C.Ty Nl = K19m.Q ;
 HTT : C.Ty Nl = K19m.HTT ;
 G1 : C.Ctx = K19m.G1 ;
 Cb : C.Ctx = K26m.Cb ;
 s0b : C.Sub Cb Nl = K26m.s0b ;
 QB : C.Ty Cb = C.subT Cb Nl Q s0b ;
 -- moving to closed types over Cb
 module Mv (A : C.Ty Nl) (Z : C.Ctx) (T : C.Ty Z) (sZ : C.Sub Z Nl) (PTy : Id (C.Ty Z) T (C.subT Z Nl A sZ)) (s : C.Sub Cb Z)
   (hp : (K : Ob) (w : V1.Ix (Cb.ob K)) -> Id (V1.Ix (Nl.ob K)) ((C.o Cb Z Nl sZ s).nt K w) (s0b.nt K w)) {
  AS0 : C.Ty Cb = C.subT Cb Nl A s0b ;
  P : Id (C.Ty Cb) (C.subT Cb Z T s) AS0 =
   transH (apH {C.Ty Z} {C.Ty Cb} (\ X -> C.subT Cb Z X s) PTy)
    (transH (symH (C.subT-o Cb Z Nl A sZ s)) (apH {C.Sub Cb Nl} {C.Ty Cb} (\ r -> C.subT Cb Nl A r) (L.sub-ext Cb Nl (C.o Cb Z Nl sZ s) s0b hp))) ;
  el (x : C.El Z T) : C.El Cb AS0 = OV.trE Cb (C.subT Cb Z T s) AS0 P (C.subt Cb Z T x s) ;
  idS (x x' : C.El Z T) (h : C.El Cb (C.subT Cb Z (IJ.IdT Z T x x') s)) : C.El Cb (IJ.IdT Cb AS0 (el x) (el x')) =
   CInjP[a].idFwdL Cb (C.subT Cb Z T s) AS0 P (C.subt Cb Z T x s) (C.subt Cb Z T x' s)
    (OV.trE Cb (C.subT Cb Z (IJ.IdT Z T x x') s) (IJ.IdT Cb (C.subT Cb Z T s) (C.subt Cb Z T x s) (C.subt Cb Z T x' s))
      (IJ.IdT-nat Cb Z T x x' s) h) ;
 } ;
 -- e2, through QSurj.E
 pibN (K : Ob) (w : V1.Ix (Cb.ob K)) : V1.Ix (QS.E.ob K) = (w.1.1.1, w.1.1.2.1) ;
 pib : C.Sub Cb QS.E = new L.PSub[Cb, QS.E, pibN, \ J I f w -> refl (pibN J (Cb.act J I f w))] ;
 IdEb : C.Ty Cb = C.subT Cb QS.E QS.IdE pib ;
 eNb (J I : Ob) (f : Hom J I) (w : V1.Ix (Cb.ob I))
   : Id (V1.Ix (IdEb.1.tob J (Cb.act J I f w))) (IdEb.1.tact J I f w (Cb.act J I f w) (refl (Cb.act J I f w)) w.1.1.2.2) (Cb.act J I f w).1.1.2.2 =
  L.tact-irr QS.E QS.IdE.1 J I f (pibN I w) (pibN J (Cb.act J I f w))
    (L.ntEq Cb QS.E pib J I f w (Cb.act J I f w) (refl (Cb.act J I f w)))
    (L.pair-act G1 QS.TmG.1 J I f w.1.1.1 (G1.act J I f w.1.1.1) (refl (G1.act J I f w.1.1.1)) w.1.1.2.1)
    w.1.1.2.2 ;
 eSb : C.El Cb IdEb = L.mkPEl Cb IdEb.1 (\ K w -> w.1.1.2.2) (\ J I f w w' e ->
  idJ (V1.Ix (Cb.ob J)) (Cb.act J I f w) (\ w2 e2 -> Id (V1.Ix (IdEb.1.tob J w2)) (IdEb.1.tact J I f w w2 e2 w.1.1.2.2) w2.1.1.2.2)
    (eNb J I f w) w' e) ;
 module ME = Mv[Q, QS.E, QS.T0, C.o QS.E QS.G1 Nl (C.p Nl Q) QS.pE, symH (C.subT-o QS.E QS.G1 Nl Q (C.p Nl Q) QS.pE), pib, \ K w -> refl (s0b.nt K w)] ;
 e0 : C.El Cb (IJ.IdT Cb QB (ME.el QS.clsE) (ME.el QS.qE)) = ME.idS QS.clsE QS.qE eSb ;
 module SEm = CSEl[a].SE[R, encK, pe, y] ;
 clsT : C.El Cb QB = SEm.clsS Cb s0b K26m.tEl ;
 ra (K : Ob) (w : V1.Ix (Cb.ob K)) : Id (V1.Ix (QB.1.tob K w)) ((ME.el QS.clsE).eob K w) (clsT.eob K w) =
  transH (CAppRd[a].trE-rd Cb (C.subT Cb QS.E QS.T0 pib) QB ME.P (C.subt Cb QS.E QS.T0 QS.clsE pib) K w)
   (transH (CAppRd[a].same-rd Cb (C.subT Cb QS.E QS.T0 pib) QB ME.P K w (refl (QB.1.tob K w)) (QS.clsE.eob K (pibN K w)))
     (transH (CAppRd[a].trE-rd QS.E (C.subT QS.E QS.D1 (OV.wkT Nl QS.Tm Q) QS.sg) QS.T0 QS.PC (C.subt QS.E QS.D1 (OV.wkT Nl QS.Tm Q) QS.QQ.cls QS.sg) K (pibN K w))
        (CAppRd[a].same-rd QS.E (C.subT QS.E QS.D1 (OV.wkT Nl QS.Tm Q) QS.sg) QS.T0 QS.PC K (pibN K w) (refl (QS.T0.1.tob K (pibN K w))) (QS.QQ.cls.eob K (QS.sgN K (pibN K w)))))) ;
 rb (K : Ob) (w : V1.Ix (Cb.ob K)) : Id (V1.Ix (QB.1.tob K w)) ((ME.el QS.qE).eob K w) (K26m.qEl.eob K w) =
  transH (CAppRd[a].trE-rd Cb (C.subT Cb QS.E QS.T0 pib) QB ME.P (C.subt Cb QS.E QS.T0 QS.qE pib) K w)
   (CAppRd[a].same-rd Cb (C.subT Cb QS.E QS.T0 pib) QB ME.P K w (refl (QB.1.tob K w)) (QS.qE.eob K (pibN K w))) ;
 e2b : C.El Cb (IJ.IdT Cb QB clsT K26m.qEl) = CCmpU14[a].rwId Cb QB (ME.el QS.clsE) clsT (ME.el QS.qE) K26m.qEl ra rb e0 ;
 -- h, the variable of H2
 piH : C.Sub Cb K19m.C1 = C.o Cb K26m.D1 K19m.C1 K26m.l1 (C.p K26m.D1 (C.subT K26m.D1 K19m.C1 K26m.K25m.H1 K26m.l1)) ;
 H2b : C.Ty Cb = C.subT Cb K19m.C1 K26m.K25m.H1 piH ;
 hN (J I : Ob) (f : Hom J I) (w : V1.Ix (Cb.ob I))
   : Id (V1.Ix (H2b.1.tob J (Cb.act J I f w))) (H2b.1.tact J I f w (Cb.act J I f w) (refl (Cb.act J I f w)) w.2) (Cb.act J I f w).2 =
  L.tact-irr K19m.C1 K26m.K25m.H1.1 J I f (piH.nt I w) (piH.nt J (Cb.act J I f w))
    (L.ntEq Cb K19m.C1 piH J I f w (Cb.act J I f w) (refl (Cb.act J I f w)))
    (L.ntEq K26m.D1 K19m.C1 K26m.l1 J I f w.1 (K26m.D1.act J I f w.1) (refl (K26m.D1.act J I f w.1)))
    w.2 ;
 hS : C.El Cb H2b = L.mkPEl Cb H2b.1 (\ K w -> w.2) (\ J I f w w' e ->
  idJ (V1.Ix (Cb.ob J)) (Cb.act J I f w) (\ w2 e2 -> Id (V1.Ix (H2b.1.tob J w2)) (H2b.1.tact J I f w w2 e2 w.2) w2.2)
    (hN J I f w) w' e) ;
 module MH = Mv[Q, K19m.C1, K19m.QC1, K19m.sC1, refl K19m.QC1, piH, \ K w -> refl (s0b.nt K w)] ;
 h0 : C.El Cb (IJ.IdT Cb QB (MH.el K26m.K25m.ev1C1) (MH.el K19m.q2C1)) = MH.idS K26m.K25m.ev1C1 K19m.q2C1 hS ;
} ;
