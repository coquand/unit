-- CDCg4.seg (canonicity-c2; (d), congruence part 4): the readings of the
-- sum of two values of ev as ev of the sum term, at both valuations.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module Cg4 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (s2 : C.Sub (C.ext C.nil (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT)) (CSolT[a].SolOf[R, encK, pe, s, (zero, nil), y].EV.Gk s.1)) {
 module C3 = CDCg3[a].Cg3[R, encK, pe, s, y, s2] ;
 module C1 = C3.C1 ;
 module DE5m = C1.DE5m ;
 module D = C1.D ;
 module EV = D.EV ;
 Nl : C.Ctx = C.nil ;
 n : Nat = D.n ;
 HS : C.Ty Nl = D.HS ;
 QY : C.Ty Nl = D.QY ;
 D1 : C.Ctx = D.D1 ;
 QYd : C.Ty D1 = D.QYd ;
 Tm : U a = C1.Tm ;
 module OA = DE5m.OA ;
 module OM = DE5m.OM ;
 rLA (p q : Tm) (K : Ob) : (o : Top) (z : V1.Ix (HS.1.tob K o)) -> Id (D.QK K (o, z)) ((OA.P2[D.evT p, D.evT q].val).eob K (o, z)) ((D.evT (sumE p q)).eob K (o, z)) =
  split { tt -> DE5m.rA p q K } ;
 rRA (p q : Tm) (K : Ob) : (o : Top) (z : V1.Ix (HS.1.tob K o)) -> Id (D.QK K (o, z)) ((OA.P2[C1.ev2T p, C1.ev2T q].val).eob K (o, z)) ((C1.ev2T (sumE p q)).eob K (o, z)) =
  split { tt -> \ z -> transH (OA.P2[C1.ev2T p, C1.ev2T q].rd K (tt, z))
   (transH (apH {D.QK K (tt, z)} {D.QK K (tt, z)} (\ u -> OA.SO.ev2 K tt u ((C1.ev2T q).eob K (tt, z))) (C1.ev2Tr p K z))
     (transH (apH {D.QK K (tt, z)} {D.QK K (tt, z)} (\ u -> OA.SO.ev2 K tt (EV.ev n p K (s2.nt K (tt, z))) u) (C1.ev2Tr q K z))
       (symH (C1.ev2Tr (sumE p q) K z)))) } ;
} ;
