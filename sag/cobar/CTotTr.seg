-- CTotTr.seg (canonicity-c2; SIMPLIFIED.md item 5): the propositional
-- truncation at the total site, Tr A := R (Tr0 (U A)), with Tr0 the
-- truncation of the levelwise site.
--   Tr        a fibrant type of the total site (fibU, then fibR)
--   contrTr   contractible over itself (the seeded extension operation of
--             Tr0 through R: CTotRSeed), i.e. a proposition
--   inc       the unit A -> Tr A (families of levelwise units)
--   sec       an element of Tr0 (U A) at the levelwise site is an element
--             of Tr A (the adjunction)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module TotTr (C : CIntCat[a, vl].IC) {
 module U4 = CTotUFib4[a, vl, l].UFib4[C] ;
 module R8 = CTotRFib8[a, vl, l].RFib8[C] ;
 module TR = U4.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;

 module Tr (G : G1.fibCwF-T.Ctx) (A : G1.fibCwF-T.Ty G) {
  UG : P0.PCtx = RS.rC G ;
  UA : G0.fibCwF-T.Ty UG = (RS.rT G A.1, U4.fibU G A.1 A.2) ;
  T0 : G0.fibCwF-T.Ty UG = G0.Tr0-T UG UA ;
  module RT = RN.Ty[G, T0.1] ;
  Tr : G1.fibCwF-T.Ty G = (RT.RB, R8.fibR G T0.1 T0.2) ;
  -- Tr A is a proposition: contractible over itself, from the seeded
  -- extension operation of the levelwise truncation moved through R
  module SR = CTotRSeed[a, vl, l].RSeed[C].SO[G, T0.1, G0.FT.GCTruncCwF[l].TrOf[UG, UA].opG] ;
  module RCo = G1.FT.GCTruncFib[l].OpRC[G, RT.RB, SR.opR] ;
  GT : G1.fibCwF-T.Ctx = G1.fibCwF-T.ext G Tr ;
  TrW : G1.fibCwF-T.Ty GT = G1.fibCwF-T.subT GT G Tr (G1.fibCwF-T.p G Tr) ;
  rcTr : G1.GB.CPartial[l].ContrOp GT TrW.1 = RCo.rc ;
  contrTr : G1.fibCwF-T.El GT (G1.EQT.isContr GT TrW) = G1.contr-T GT TrW rcTr ;

  -- the unit A -> Tr A: at (X, g, a) the family of the units of the
  -- levelwise truncation at the restrictions of a
  module I0 = G0.FT.GCTruncCwF[l].TrOf[UG, UA] ;
  A0 : P1.PTy[G] = A.1 ;
  Ta : P0.PTy[UG] = T0.1 ;
  GA1 : P1.PCtx = P1.extP G A0 ;
  Ob1 : U vl = RN.Ob1 ;
  Ob0 : U vl = RN.Ob0 ;
  Pt (X : Ob1) : U l = W0.Ix (G.ob X) ;
  cmp (X : Ob1) (g : Pt X) (v : W0.Ix (A0.tob X g)) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) (p : Pt (RN.o Y)) (e : Id (Pt (RN.o Y)) p (RT.at X g Y m))
   : W0.Ix (A0.tob (RN.o Y) p) = A0.tact (RN.o Y) X m g p (symH e) v ;
  ifam (X : Ob1) (g : Pt X) (v : W0.Ix (A0.tob X g)) : RT.Fam X g =
   \ Y m p e -> I0.incV Y (P0.pairE UG UA.1 Y p (cmp X g v Y m p e)) ;
  module IN (X : Ob1) (g : Pt X) (v : W0.Ix (A0.tob X g)) (Z Y : Ob0) (h : RN.Hom0 Z Y) (m : RN.Hom1 (RN.o Y) X) (p : Pt (RN.o Y))
    (e : Id (Pt (RN.o Y)) p (RT.at X g Y m)) (e3 : Id (Pt (RN.o Z)) (UG.act Z Y h p) (RT.at X g Z (G1.GB.BC.oC (RN.o Z) (RN.o Y) X m (TR.fn.onH Z Y h)))) {
   q0 : Pt (RN.o Z) = UG.act Z Y h p ;
   mz : RN.Hom1 (RN.o Z) X = G1.GB.BC.oC (RN.o Z) (RN.o Y) X m (TR.fn.onH Z Y h) ;
   x : W0.Ix (I0.GA.ob Y) = P0.pairE UG UA.1 Y p (cmp X g v Y m p e) ;
   y : W0.Ix (I0.GA.ob Z) = P0.pairE UG UA.1 Z q0 (cmp X g v Z mz q0 e3) ;
   exy : Id (W0.Ix (I0.GA.ob Z)) (I0.GA.act Z Y h x) y =
    ap (W0.Ix (A0.tob (RN.o Z) q0)) (W0.Ix (I0.GA.ob Z)) (\ c -> P0.pairE UG UA.1 Z q0 c)
     (A0.tact (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) p q0 (refl q0) (cmp X g v Y m p e)) (cmp X g v Z mz q0 e3)
     (symH (A0.tact-o (RN.o Z) (RN.o Y) X m (TR.fn.onH Z Y h) g p q0 (symH e) (refl q0) (symH e3) v)) ;
   base : Id (W0.Ix (Ta.tob Z q0)) (Ta.tact Z Y h p q0 (refl q0) (ifam X g v Y m p e)) (ifam X g v Z mz q0 e3) =
    trans (W0.Ix (Ta.tob Z q0)) (Ta.tact Z Y h p q0 (refl q0) (ifam X g v Y m p e))
      (Ta.tact Z Y h p q0 (P0.ntEq I0.GA UG (P0.pP UG UA.1) Z Y h x y exy) (ifam X g v Y m p e)) (ifam X g v Z mz q0 e3)
     (P0.tact-irr UG Ta Z Y h p q0 (refl q0) (P0.ntEq I0.GA UG (P0.pP UG UA.1) Z Y h x y exy) (ifam X g v Y m p e))
     (I0.incN Z Y h x y exy) ;
  } ;
  inat (X : Ob1) (g : Pt X) (v : W0.Ix (A0.tob X g)) : RT.NatTy X g (ifam X g v) =
   \ Z Y h m p e q e' e'' ->
    idJ (Pt (RN.o Z)) (UG.act Z Y h p)
     (\ q2 e2 -> (e3 : Id (Pt (RN.o Z)) q2 (RT.at X g Z (G1.GB.BC.oC (RN.o Z) (RN.o Y) X m (TR.fn.onH Z Y h))))
        -> Id (W0.Ix (Ta.tob Z q2)) (Ta.tact Z Y h p q2 e2 (ifam X g v Y m p e)) (ifam X g v Z (G1.GB.BC.oC (RN.o Z) (RN.o Y) X m (TR.fn.onH Z Y h)) q2 e3))
     (\ e3 -> IN[X, g, v, Z, Y, h, m, p, e, e3].base) q e'' e' ;
  incV (X : Ob1) (w : W0.Ix (GA1.ob X)) : RT.T X w.1 = RT.mk X w.1 (ifam X w.1 w.2) (inat X w.1 w.2) ;
  module IE (J I : Ob1) (f : RN.Hom1 J I) (x : W0.Ix (GA1.ob I)) {
   y : W0.Ix (GA1.ob J) = GA1.act J I f x ;
   pf : Id (Pt J) (G.act J I f x.1) y.1 = P1.ntEq GA1 G (P1.pP G A0) J I f x y (refl y) ;
   module AC = RT.Act[J, I, f, x.1, y.1, pf, incV I x] ;
   cmpEq (Y : Ob0) (m : RN.Hom1 (RN.o Y) J) (p : Pt (RN.o Y)) (e4 : Id (Pt (RN.o Y)) p (RT.at J y.1 Y m))
    : Id (W0.Ix (Ta.tob Y p)) (AC.res.1 Y m p e4) ((incV J y).1 Y m p e4) =
    ap (W0.Ix (A0.tob (RN.o Y) p)) (W0.Ix (Ta.tob Y p)) (\ c -> I0.incV Y (P0.pairE UG UA.1 Y p c))
     (cmp I x.1 x.2 Y (G1.GB.BC.oC (RN.o Y) J I f m) p (transH e4 (AC.ek Y m))) (cmp J y.1 y.2 Y m p e4)
     (A0.tact-o (RN.o Y) J I f m x.1 y.1 p (refl y.1) (symH e4) (symH (transH e4 (AC.ek Y m))) x.2) ;
   base : Id (RT.T J y.1) (RT.RB.tact J I f x.1 y.1 pf (incV I x)) (incV J y) =
    RT.famExt J y.1 (RT.RB.tact J I f x.1 y.1 pf (incV I x)) (incV J y) cmpEq ;
  } ;
  incE : P1.PEl[GA1, P1.subTy GA1 G RT.RB (P1.pP G A0)] =
   P1.mkPEl GA1 (P1.subTy GA1 G RT.RB (P1.pP G A0)) incV
    (\ J I f x y e ->
      idJ (W0.Ix (GA1.ob J)) (GA1.act J I f x)
       (\ y2 e2 -> Id (RT.T J y2.1) (RT.RB.tact J I f x.1 y2.1 (P1.ntEq GA1 G (P1.pP G A0) J I f x y2 e2) (incV I x)) (incV J y2))
       IE[J, I, f, x].base y e) ;
  inc : G1.fibCwF-T.El (G1.fibCwF-T.ext G A) (G1.fibCwF-T.subT (G1.fibCwF-T.ext G A) G Tr (G1.fibCwF-T.p G A)) = incE ;
  -- an element of the levelwise truncation of U A is an element of Tr A
  sec (t : G0.fibCwF-T.El UG T0) : G1.fibCwF-T.El G Tr = RT.toR t ;
 } ;
} ;
