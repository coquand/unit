-- CCmpK9.seg (canonicity-c2; (K) for cmpI, part 9): the fibres of cmpI are
-- propositions (CInjP3 with injectivity CCmpK8 and pairs of homs F1 -> y a
-- set, CProdSet2 over CHomSet).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module K9 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K8m = CCmpK8[a].K8[R, encK, pe, y] ;
 module K4m = K8m.K7m.K4m ;
 module U30m = K8m.U30m ;
 module CI = K4m.CI ;
 setHom : CQCtx[a].G3Of[CI.HT].SetQiTy = CHomSet[a].HomSet[R, encK, pe, K4m.K3m.E1m.F1, y].setHom ;
 sB : CQCtx[a].G3Of[CI.HTT].SetQiTy = CProdSet2[a].ProdSet2[CI.HT, CI.HT, setHom, setHom].setQi ;
 module PFm = CInjP3[a].PF[CI.HS, CI.HTT, CI.nmap, sB, U30m.zA, U30m.zB,
   \ K w -> refl (U30m.zA.eob K w), \ K w -> refl (U30m.zB.eob K w), K8m.inj] ;
 pF : C.El PFm.I.GB (PU.isProp PFm.I.GB PFm.I.Fib) = PFm.pF ;
} ;
