-- CL59a.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 (= jonas.pdf
-- Lemma 72) for our C at a FIXED presentation y and a fixed SYNTACTIC
-- relative presentation u (both metatheory parameters), non-dependent
-- (Q closed), as an internal equivalence of closed types of the copy y:
--   ev : U(Pi_A Q)|_y -> U(Q)|_{y.u},  phi |-> phi at (p_u, rho),
-- where A plays Sp(u) over yo(y) and rho : yo(y.u) -> yo(y).A is a fixed
-- levelwise equivalence over yo(p_u).  This is what the axioms consume:
-- their levelwise proofs are internal over the levelwise context; a
-- point's presentation has coefficients in G(y) = A_y, and inside a Tr0
-- goal one eliminates "merely it is the image of a syntactic u" (u an
-- element of a constant type, used through CConstLam.pack, so locally
-- constant along cube maps) and applies the equivalence at (y, u);
-- uniformity along cube maps is automatic (objects and u constant), and
-- no uniformity along C-maps is needed for levelwise statements (4e).
-- Part a: the data and the two closed types.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module L59 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module YF = CCopy6[a].YoF[R, encK, pe] ;
 module CC = YF.CC ;
 module CM = YF.CM ;
 module TR = YF.TR ;
 module CT = YF.CT ;
 module G1 = TR.G1 ;
 yu : SX.Over[R].Presentation = SX.Rel[R].concat y u ;
 Yy : CM.TP.TCtx = CM.Yo[y].yoT ;
 Yu : CM.TP.TCtx = CM.Yo[yu].yoT ;
 PYy : TR.P1.PCtx = CT.TC.toP Yy ;
 PYu : TR.P1.PCtx = CT.TC.toP Yu ;
 module PuM = CM.II.PuC[y, u].M ;
 yoPu : CM.TP.TSub[Yu, Yy] = CM.Pre[yu, y, PuM.mor, PuM.mor-nat].preS ;
 PyoPu : TR.P1.PSub[PYu, PYy] = CT.TC.toPS Yu Yy yoPu ;
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 -- the data: A plays Sp(u) over yo(y); rho : yo(y.u) -> yo(y).A over yo(p_u); Q closed
 module Data (A : G1.fibCwF-T.Ty PYy) (rho : TR.P1.PSub[PYu, TR.P1.extP PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (PYu.ob X)) -> Id (V1.Ix (PYy.ob X)) (TR.P1.fstE PYy A.1 X (rho.nt X w)) (PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  QA : G1.fibCwF-T.Ty (G1.fibCwF-T.ext PYy A) = G1.fibCwF-T.subT (G1.fibCwF-T.ext PYy A) G1.fibCwF-T.nil Q (G1.fibCwF-T.eps (G1.fibCwF-T.ext PYy A)) ;
  PiT : G1.fibCwF-T.Ty PYy = G1.fibPi-T.Pi PYy A QA ;
  module Cy = CC.Copy[y] ;
  module Cu = CC.Copy[yu] ;
  UPY : TR.P0.PCtx = TR.RS.rC PYy ;
  UPi : TR.P0.PTy[UPY] = TR.RS.rT PYy PiT.1 ;
  UQ : TR.P0.PTy[TR.RS.rC G1.fibCwF-T.nil] = TR.RS.rT G1.fibCwF-T.nil Q.1 ;
  -- the identity point of yo(y) at a stage, and its restriction
  idy (I : Ob) : V1.Ix (UPY.ob (Cy.o0 I)) = CM.CO.idM I y ;
  idyR (J I : Ob) (h : Hom J I) : Id (V1.Ix (UPY.ob (Cy.o0 J))) (UPY.act (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I h) (idy I)) (idy J) =
   CM.MO.Fn[y, y].mExt J (UPY.act (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I h) (idy I)) (idy J) (refl (CM.MO.Fn[y, y].fpOf J (idy J))) ;
  -- U(Pi_A Q)|_y at the identity point: a closed type of the poset base
  piTob (I : Ob) (o : V1.Ix (Nl.ob I)) : V1.V = UPi.tob (Cy.o0 I) (idy I) ;
  piTact (J I : Ob) (h : Hom J I) (o : V1.Ix (Nl.ob I)) (o' : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h o) o')
   (w : V1.Ix (piTob I o)) : V1.Ix (piTob J o') =
   UPi.tact (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I h) (idy I) (idy J) (idyR J I h) w ;
  PiC : L.PTy[Nl] = L.mkTy Nl piTob piTact
   (\ I o e w -> UPi.tact-id (Cy.o0 I) (idy I) (idyR I I (idH I)) w)
   (\ K J I f g o o' o'' e1 e2 e3 w -> UPi.tact-o (Cy.o0 K) (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I f) (Cy.h0 K J g) (idy I) (idy J) (idy K) (idyR J I f) (idyR K J g) (idyR K I (compH K J I f g)) w) ;
  -- U(Q)|_{y.u}: a closed type of the poset base
  qTob (I : Ob) (o : V1.Ix (Nl.ob I)) : V1.V = UQ.tob (Cu.o0 I) tt ;
  qTact (J I : Ob) (h : Hom J I) (o : V1.Ix (Nl.ob I)) (o' : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h o) o')
   (w : V1.Ix (qTob I o)) : V1.Ix (qTob J o') =
   UQ.tact (Cu.o0 J) (Cu.o0 I) (Cu.h0 J I h) tt tt (refl tt) w ;
  QC : L.PTy[Nl] = L.mkTy Nl qTob qTact
   (\ I o e w -> UQ.tact-id (Cu.o0 I) tt (refl tt) w)
   (\ K J I f g o o' o'' e1 e2 e3 w -> UQ.tact-o (Cu.o0 K) (Cu.o0 J) (Cu.o0 I) (Cu.h0 J I f) (Cu.h0 K J g) tt tt tt (refl tt) (refl tt) (refl tt) w) ;
  -- the evaluation: phi at (p_u, rho's A-element at the identity of y.u)
  module TAy = G1.GB.GPre[a+].TyL[PYy, A.1] ;
  fW (W : Ob) : CT.TC.THm (W, yu) (W, y) = (idH W, PuM.mor W) ;
  ptW (W : Ob) : V1.Ix (PYy.ob (W, yu)) = PYy.act (W, yu) (W, y) (fW W) (idy W) ;
  rW (W : Ob) : V1.Ix ((TR.P1.extP PYy A.1).ob (W, yu)) = rho.nt (W, yu) (CM.CO.idM W yu) ;
  eqPt (W : Ob) : Id (V1.Ix (PYy.ob (W, yu))) (TAy.pr1 (W, yu) (rW W)) (ptW W) =
   transH (rho1 (W, yu) (CM.CO.idM W yu))
    (transH (apH {(w : Hom W W) * CM.MO.Fn[y, yu].M W} {CM.MO.Fn[y, yu].M W} (\ p -> p.2) (CM.CO.idrL W W (idH W) yu y (PuM.mor W)))
      (symH (apH {(w : Hom W W) * CM.MO.Fn[y, yu].M W} {CM.MO.Fn[y, yu].M W} (\ p -> p.2) (CM.CO.idlL W W (idH W) yu y (PuM.mor W))))) ;
  vW (W : Ob) : V1.Ix (A.1.tob (W, yu) (ptW W)) = TAy.coeT (W, yu) (TAy.pr1 (W, yu) (rW W)) (ptW W) (eqPt W) (TAy.pr2 (W, yu) (rW W)) ;
  evV (W : Ob) (phi : V1.Ix (piTob W tt)) : V1.Ix (qTob W tt) = phi.1 (W, yu) (fW W) (vW W) ;
  module PE = G1.GB.CPiE[a+].PiE[PYy, A.1, QA.1] ;
  piEq : Id (TR.P1.PTy[PYy]) PiT.1 PE.P = refl PiT.1 ;
  -- naturality of the evaluation: the A-parts at (W', y.u) agree
  module EvN (W' W : Ob) (h : Hom W' W) {
   g' : CT.TC.THm (W', yu) (W, yu) = (h, CM.IC.cart W' W h yu) ;
   idyu (V : Ob) : V1.Ix (PYu.ob (V, yu)) = CM.CO.idM V yu ;
   idR : Id (V1.Ix (PYu.ob (W', yu))) (PYu.act (W', yu) (W, yu) g' (idyu W)) (idyu W') =
    CM.MO.Fn[yu, yu].mExt W' (PYu.act (W', yu) (W, yu) g' (idyu W)) (idyu W') (refl (CM.MO.Fn[yu, yu].fpOf W' (idyu W'))) ;
   rhoN : Id (TAy.EI (W', yu)) (TAy.E.act (W', yu) (W, yu) g' (rW W)) (rW W') =
    transH (symH (rho.nt-nat (W', yu) (W, yu) g' (idyu W))) (apH {V1.Ix (PYu.ob (W', yu))} {TAy.EI (W', yu)} (rho.nt (W', yu)) idR) ;
   -- the two total maps (W', y.u) -> (W, y) agree
   X1 : CM.MO.Fn[y, yu].M W' = CM.CO.cmpM W' W W h yu yu y (PuM.mor W) (CM.CO.idM W' yu) ;
   X2 : CM.MO.Fn[y, yu].M W' = CM.CO.cmpM W' W' W (idH W') yu y y (CM.CO.idM W' y) (PuM.mor W') ;
   e1 : Id (CM.MO.Fn[y, yu].M W') X1 (CM.MO.Fn[y, yu].res W W' h (PuM.mor W)) =
    CM.MO.Fn[y, yu].mExt W' X1 (CM.MO.Fn[y, yu].res W W' h (PuM.mor W)) (refl (CM.MO.Fn[y, yu].fpOf W' (CM.MO.Fn[y, yu].res W W' h (PuM.mor W)))) ;
   e2 : Id (CM.MO.Fn[y, yu].M W') X2 (PuM.mor W') =
    CM.MO.Fn[y, yu].mExt W' X2 (PuM.mor W') (refl (CM.MO.Fn[y, yu].fpOf W' (PuM.mor W'))) ;
   g0 : CT.TC.THm (W', y) (W, y) = (h, CM.IC.cart W' W h y) ;
   mEq : Id (CT.TC.THm (W', yu) (W, y)) (CT.TC.TotCat.oC (W', yu) (W, yu) (W, y) (fW W) g') (CT.TC.TotCat.oC (W', yu) (W', y) (W, y) g0 (fW W')) =
    CM.CO.pq W' W yu y (compH W' W W (idH W) h) (compH W' W' W h (idH W')) (transH (comp-idl W' W h) (symH (comp-idr W' W h)))
     X1 X2 (transH e1 (transH (PuM.mor-nat W W' h) (symH e2))) ;
   -- the pair at W', moved: E.act g' (ptW W, vW W) = (ptW W', vW W')
   pairN : Id (TAy.EI (W', yu)) (TAy.E.act (W', yu) (W, yu) g' (TAy.pr (W, yu) (ptW W) (vW W))) (TAy.pr (W', yu) (ptW W') (vW W')) =
    transH (apH {TAy.EI (W, yu)} {TAy.EI (W', yu)} (TAy.E.act (W', yu) (W, yu) g')
              (symH (TAy.pr-coe (W, yu) (TAy.pr1 (W, yu) (rW W)) (ptW W) (eqPt W) (TAy.pr2 (W, yu) (rW W)))))
     (transH rhoN (TAy.pr-coe (W', yu) (TAy.pr1 (W', yu) (rW W')) (ptW W') (eqPt W') (TAy.pr2 (W', yu) (rW W')))) ;
   -- assembling: phi's naturality, transport in a constant family, val-coh
   J0 : CT.TC.TOb = (W, yu) ;
   K : CT.TC.TOb = (W', yu) ;
   I0 : CT.TC.TOb = (W, y) ;
   Jy : CT.TC.TOb = (W', y) ;
   pt : PE.PC.Pt I0 = PE.PC.ptOf I0 (idy W) ;
   f1 : CT.TC.THm K I0 = CT.TC.TotCat.oC K J0 I0 (fW W) g' ;
   f2 : CT.TC.THm K I0 = CT.TC.TotCat.oC K Jy I0 g0 (fW W') ;
   a1 : PE.PC.FA K (pt K f1) = PE.PC.AactOf I0 pt (PE.PC.cOf I0 (idy W)) J0 K (fW W) g' (vW W) ;
   ppt : Id (V1.Ix (PYy.ob K)) (PYy.act K I0 f2 (idy W)) (PYy.act K Jy (fW W') (idy W')) = PE.PC.piPt Jy I0 g0 (idy W) (idy W') (idyR W' W h) K (fW W') ;
   a2 : PE.PC.FA K (pt K f2) = PE.bk K (PYy.act K I0 f2 (idy W)) (PYy.act K Jy (fW W') (idy W')) ppt (vW W') ;
   w : PE.PC.Pts K = TAy.pr K (ptW W') (vW W') ;
   Q1 : Id (PE.PC.Pts K) (TAy.pr K (pt K f1) a1) w = transH (symH (PE.PC.eOf I0 (idy W) J0 K (fW W) g' (vW W))) pairN ;
   Q2 : Id (PE.PC.Pts K) (TAy.pr K (pt K f2) a2) w = PE.pp K (PYy.act K I0 f2 (idy W)) (PYy.act K Jy (fW W') (idy W')) ppt (vW W') ;
   substC (w1 w2 : PE.PC.Pts K) (p : Id (PE.PC.Pts K) w1 w2) (b : V1.Ix (Q.1.tob K tt))
    : Id (V1.Ix (Q.1.tob K tt)) (subst (PE.PC.Pts K) (\ z -> PE.PC.FB K z) w1 w2 p b) b =
    idJ (PE.PC.Pts K) w1 (\ w3 p3 -> Id (V1.Ix (Q.1.tob K tt)) (subst (PE.PC.Pts K) (\ z -> PE.PC.FB K z) w1 w3 p3 b) b) (refl b) w2 p ;
   module At (phi : V1.Ix (piTob W tt)) {
    st1 : Id (V1.Ix (qTob W' tt)) (qTact W' W h tt tt (refl tt) (evV W phi))
            (PE.PC.BactOf I0 pt (PE.PC.cOf I0 (idy W)) (PE.PC.eOf I0 (idy W)) J0 K (fW W) g' (vW W) (phi.1 J0 (fW W) (vW W))) =
     G1.GB.GPre[a+].PS.tact-irr G1.fibCwF-T.nil Q.1 K J0 g' tt tt (refl tt)
      (G1.GB.GPre[a+].PS.ntEq (G1.fibCwF-T.ext PYy A) G1.fibCwF-T.nil (G1.fibCwF-T.eps (G1.fibCwF-T.ext PYy A)) K J0 g'
         (TAy.pr J0 (ptW W) (vW W)) (TAy.pr K (pt K f1) a1) (PE.PC.eOf I0 (idy W) J0 K (fW W) g' (vW W)))
      (phi.1 J0 (fW W) (vW W)) ;
    law : Id (V1.Ix (qTob W' tt)) (qTact W' W h tt tt (refl tt) (evV W phi)) (evV W' (piTact W' W h tt tt (refl tt) phi)) =
     transH st1
      (transH (phi.2 J0 K (fW W) g' (vW W))
        (transH (symH (substC (TAy.pr K (pt K f1) a1) w Q1 (phi.1 K f1 a1)))
          (PE.PC.val-coh K (CT.TC.THm K I0) (\ k -> PYy.act K I0 k (idy W)) (phi.1 K) f1 f2 mEq a1 a2 w Q1 Q2))) ;
   } ;
  } ;
  -- the evaluation as a map of closed types of the poset base
  evE (W : Ob) (w : L.SigT Nl PiC W) : L.SigT Nl QC W = (w.1, evV W w.2) ;
  ev : PB.CPartial[a+].PMap[Nl, PiC, QC] =
   PB.CPartial[a+].mkPMap Nl PiC QC evE (\ W w -> refl w.1)
    (\ Vv W g w -> apH {V1.Ix (qTob Vv tt)} {L.SigT Nl QC Vv} (\ q -> (Nl.act Vv W g w.1, q)) (symH (EvN[Vv, W, g].At[w.2].law))) ;
 } ;
} ;
