-- CCmpK8.seg (canonicity-c2; (K) for cmpI, part 8): injectivity of cmpI:
-- over nil.H the two homs F2 -> y are equal (the generic (U) at F2, CUG30,
-- with the generator cases of CCmpK7).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module K8 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K7m = CCmpK7[a].K7[R, encK, pe, y] ;
 module K4m = K7m.K4m ;
 module U20m = K4m.U20m ;
 module AS = U20m.HZ.AS ;
 GH : C.Ctx = K4m.GH ;
 IdZ (c : C.El C.nil U20m.QA) : C.Ty GH = U20m.IdZ c ;
 hv2 : (u : Top) -> C.El GH (IdZ (AS.AX.cls (var (inr u)))) = split { tt -> K7m.h2 } ;
 hv1 : (u : Top) -> C.El GH (IdZ (AS.AX.cls (var (inl (inr u))))) = split { tt -> K7m.h1 } ;
 hv0 : (v : SX.Fin (suc zero)) -> C.El GH (IdZ (AS.AX.cls (var (inl v)))) = split {
  inl e -> absurd (C.El GH (IdZ (AS.AX.cls (var (inl (inl e)))))) e ;
  inr u -> hv1 u } ;
 gen : (v : SX.Fin (suc (suc zero))) -> C.El GH (IdZ (AS.AX.cls (var v))) = split { inl v1 -> hv0 v1 ; inr u -> hv2 u } ;
 module U30m = CUG30[a].UG30[R, encK, pe, K4m.F2, y, K4m.H, K4m.pkA, K4m.pkB, K4m.pkAN, K4m.pkBN, gen] ;
 inj : C.El GH (IJ.IdT GH U30m.HSh U30m.zA U30m.zB) = U30m.res ;
} ;
