-- CDEv6.seg (canonicity-c2; (d), part 6): for a hom z : s -> y (variable of
-- nil.HomT(s, y)) and every term t over s's generators, z (cls t) = ev_t (z at
-- the generators), by recursion on t (CDEv1-5).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module DE6 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) {
 module DE5m = CDEv5[a].DE5[R, encK, pe, s, y] ;
 module DE4m = DE5m.DE4m ;
 module DE2m = DE4m.DE2m ;
 module D = DE2m.D ;
 module HZ = D.HZ ;
 module AS = HZ.AS ;
 module U20m = DE2m.U20m ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = D.HS ;
 QY : C.Ty Nl = D.QY ;
 D1 : C.Ctx = D.D1 ;
 Tm : U a = DE2m.Tm ;
 module OM = DE5m.OM ;
 rA (p q : Tm) (K : Ob) (z : V1.Ix (HS.1.tob K tt)) : Id (D.QK K (tt, z)) ((DE5m.OA.P2[D.evT p, D.evT q].val).eob K (tt, z)) ((D.evT (sumE p q)).eob K (tt, z)) = DE5m.rA p q K z ;
 rM (p q : Tm) (K : Ob) (z : V1.Ix (HS.1.tob K tt)) : Id (D.QK K (tt, z)) ((OM.P2[D.evT p, D.evT q].val).eob K (tt, z)) ((D.evT (mulE p q)).eob K (tt, z)) =
  transH (OM.P2[D.evT p, D.evT q].rd K (tt, z))
   (transH (apH {D.QK K (tt, z)} {D.QK K (tt, z)} (\ u -> OM.SO.ev2 K tt u ((D.evT q).eob K (tt, z))) (D.evTr p K z))
     (transH (apH {D.QK K (tt, z)} {D.QK K (tt, z)} (\ u -> OM.SO.ev2 K tt (D.EV.ev D.n p K (D.vT K tt z)) u) (D.evTr q K z))
       (symH (D.evTr (mulE p q) K z)))) ;
 h : (t : Tm) -> C.El D1 (DE2m.HE t) = split {
  var v -> D.hVar v ;
  cst r -> DE2m.hCst r ;
  sumE p q | hp hq -> DE4m.Bin[AS.O.addQ, HZ.AT.O.addQ, U20m.dkA, U20m.dkAN, p, q, sumE p q, AS.O.add-beta p q, hp, hq, rA p q].res ;
  mulE p q | hp hq -> DE4m.Bin[AS.O.mulQ, HZ.AT.O.mulQ, U20m.dkM, U20m.dkMN, p, q, mulE p q, AS.O.mul-beta p q, hp, hq, rM p q].res } ;
} ;
