-- CTotL16l.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, SPECIFIC TO OUR C: Lemma 16.  The lines p : tau_DAC ~ M and
-- q : (D tau_A)[tau_G] ~ M (CTotL16i.LP2 with the ends of CTotL16j / k), the
-- zig homotopy zig = q . p^-1 at the total site (CHtpyOps.Cat / Inv with the
-- composition of B2 = (D DAC)[tau_G], Lemma 12 at DAC), and
--   lemma16   tau_DAC : DAC -> B2 is a G1 EquivOp (CTotL16a.Main)
-- for A with a levelwise fibration structure of U A over U G.
-- No new axioms beyond the named premises (fe).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a+] ;
module VA = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, a+] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module RL (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module RK = CTotL16k[a].RK[R, encK, pe] ;
 IC : CIntCat[a, a+].IC = RK.IC ;
 module L16 (G : CTPsh[a, a+, a+].TPshOf[IC].TCtx) (A : Presheaf[a+, a+].Psh[CTotCat[a, a+, a+].TotOf[IC].TotCat].PTy[CTotCat[a, a+, a+].TotOf[IC].toP G]) {
  module KF = RK.F[G, A] ;
  module JF = KF.JF ;
  module L16a = JF.L16a ;
  module HO1 = L16a.HO1 ;
  module G1 = L16a.G1 ;
  GP : JF.LB.P.PCtx = JF.GP ;
  DAC : JF.LB.P.PTy[GP] = L16a.DAC ;
  B2 : JF.LB.P.PTy[GP] = L16a.B2 ;
  pH : G1.GB.GPre[a+].PS.PEl[G1.GB.GPre[a+].PS.extP GP DAC, HO1.HT[GP, DAC, B2, L16a.tauD, JF.mN2].PT.PathP] =
   JF.Lp.LP2[L16a.tauD, JF.mN2, \ X z -> KF.E0[X, z].p0, \ X z -> JF.E1[X, z].p1].res ;
  qH : G1.GB.GPre[a+].PS.PEl[G1.GB.GPre[a+].PS.extP GP DAC, HO1.HT[GP, DAC, B2, L16a.dTau, JF.mN2].PT.PathP] =
   JF.Lq.LP2[L16a.dTau, JF.mN2, \ X z -> KF.E0[X, z].q0, \ X z -> JF.E1[X, z].q1].res ;
  module Main (fb : L16a.TR.G0.GB.CLine[a+].Lines[L16a.LB.UG, L16a.LB.UA].Fib) {
   fbU : L16a.TR.G0.GB.CLine[a+].Lines[L16a.CD.LB.UG, L16a.CD.LB.UA].Fib = L16a.CA.LG.Out[L16a.CA.LF.lemma12F fb].fbU ;
   fB2 : G1.GB.CLine[a+].Lines[GP, B2].Fib = L16a.CD.LG.Out[L16a.CD.LF.lemma12F fbU].fbB ;
   cB : G1.GB.CLine[a+].Lines[GP, B2].CompK[PB.e0, PB.e1].Comp = fB2.1 ;
   -- the zig homotopy (D tau_A)[tau_G] ~ tau_DAC
   zig : G1.GB.GPre[a+].PS.PEl[G1.GB.GPre[a+].PS.extP GP DAC, HO1.HT[GP, DAC, B2, L16a.dTau, L16a.tauD].PT.PathP] =
    HO1.Cat[GP, DAC, B2, L16a.dTau, JF.mN2, L16a.tauD, cB, qH, HO1.Inv[GP, DAC, B2, L16a.tauD, JF.mN2, cB, pH].res].res ;
   -- Lemma 16: DAC = (D A)[tau_G] is D-modal
   lemma16 : G1.GB.CEquiv[a+].EquivOp GP DAC B2 (L16a.LRt.Map[GP, DAC, B2, L16a.tauD].pmap) = L16a.Main[fb, zig].lemma16 ;
  } ;
 } ;
} ;
