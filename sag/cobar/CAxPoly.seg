-- CAxPoly.seg (canonicity-c2; the axioms' statements, duality kernel part 1):
-- metatheory arithmetic of exponent vectors (zero, unit, sum, comparison,
-- difference, equality), the exponent vectors below a given one, and the
-- expansion of an equation q (a term over the k coefficients and the n points)
-- into monomials in the points with coefficients terms over the k coefficients;
-- coef q gamma is the coefficient of x^gamma in q.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module PolyOf (R : Ring[a].CRing) (k n : Nat) {
 module MN = CAxMon[a].MonOf[R, n] ;
 module RL = Ring[a] ;
 open RL ;
 module E = SX.Over[R] ;
 Exp : Nat -> U a = MN.Exp ;
 -- exponent arithmetic
 zeroX : (j : Nat) -> Exp j = split { zero -> tt ; suc j | r -> (r, zero) } ;
 unitX : (j : Nat) -> SX.Fin j -> Exp j = split {
  zero -> \ v -> tt ;
  suc j | r -> split { inl v -> (r v, zero) ; inr u -> (zeroX j, suc zero) } } ;
 addX : (j : Nat) -> Exp j -> Exp j -> Exp j = split { zero -> \ x1 x2 -> tt ; suc j | r -> \ x1 x2 -> (r x1.1 x2.1, Arith[a].plus x1.2 x2.2) } ;
 andB : Bool -> Bool -> Bool = split { true -> \ b -> b ; false -> \ b -> false } ;
 eqN : Nat -> Nat -> Bool = split { zero -> split { zero -> true ; suc m -> false } ; suc m | r -> split { zero -> false ; suc l -> r l } } ;
 leX : (j : Nat) -> Exp j -> Exp j -> Bool = split { zero -> \ x1 x2 -> true ; suc j | r -> \ x1 x2 -> andB (r x1.1 x2.1) (leb x1.2 x2.2) } ;
 eqX : (j : Nat) -> Exp j -> Exp j -> Bool = split { zero -> \ x1 x2 -> true ; suc j | r -> \ x1 x2 -> andB (r x1.1 x2.1) (eqN x1.2 x2.2) } ;
 monus : Nat -> Nat -> Nat = split { zero -> \ m -> zero ; suc l | r -> split { zero -> suc l ; suc m -> r m } } ;
 subX : (j : Nat) -> Exp j -> Exp j -> Exp j = split { zero -> \ x1 x2 -> tt ; suc j | r -> \ x1 x2 -> (r x1.1 x2.1, monus x1.2 x2.2) } ;
 -- the exponent vectors alpha <= gamma (componentwise)
 upto : Nat -> List Nat = split { zero -> cons zero nil ; suc m | r -> SX.appL Nat r (cons (suc m) nil) } ;
 below : (j : Nat) -> Exp j -> List (Exp j) = split {
  zero -> \ g -> cons tt nil ;
  suc j | r -> \ g -> MN.concatMap (Exp j) (Exp (suc j)) (\ al -> SX.mapL Nat (Exp (suc j)) (\ e -> (al, e)) (upto g.2)) (r g.1) } ;
 -- expansion of an equation into monomials
 CV : U a = SX.Fin k ;
 Mon : U a = Exp n * E.Expr CV ;
 TV : U a = Arith[a].Plus (SX.Fin k) (SX.Fin n) ;
 timesL (P Q : List Mon) : List Mon =
  MN.concatMap Mon Mon (\ m1 -> SX.mapL Mon Mon (\ m2 -> (addX n m1.1 m2.1, mulE m1.2 m2.2)) Q) P ;
 varM : TV -> List Mon = split { inl i -> cons (zeroX n, var i) nil ; inr j -> cons (unitX n j, cst R.o) nil } ;
 expand : E.Expr TV -> List Mon = split {
  var v -> varM v ;
  cst r -> cons (zeroX n, cst r) nil ;
  sumE p q | rp rq -> SX.appL Mon rp rq ;
  mulE p q | rp rq -> timesL rp rq } ;
 coefL (g : Exp n) : List Mon -> E.Expr CV = split {
  nil -> cst R.z ;
  cons m ms | r -> MN.ifB (E.Expr CV) (sumE m.2 r) r (eqX n m.1 g) } ;
 coef (q : E.Expr TV) (g : Exp n) : E.Expr CV = coefL g (expand q) ;
} ;
