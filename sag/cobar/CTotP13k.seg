-- CTotP13k.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part k: the face and top equations of the lift back's D B element,
-- as c2's CTotPsi19 (u's face / top equations through fibL, D's facePath,
-- the drop of a moved chain, the path's naturality).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;

module P13k (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PI = CTotP13i[a, vl, l].P13i[C, G, A, B, f] ;
 module PE = PI.PE ;
 module TR = PE.TR ;
 module G1 = TR.G1 ;
 module TC = PE.TC ;
 module DO = PE.DO ;
 module CT = DO.CT ;
 module DF = PE.DF ;
 module H = PE.H ;
 module HD = PE.HD ;
 module DS = PI.DS ;
 Obj (I : Ob) : U vl = PE.Obj I ;


 module FT (X : TC.TOb) (w : HD.TA.EI X) (u : DS.TOb' X.1 X.2 (PE.PR.phi X w)) (Wd : TC.TOb) (g : TC.THm Wd X) (j : PB.IvP Wd.1) {
  module BK = PI.BKd[X, w, u] ;
  module AB = BK.AB[Wd, g, j] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module AC = DF.D.Act[Wd.1, I, g.1, Wd.2, x, g.2, BK.d] ;
  -- the inner faces
  module FC (r : VA.Ix (DF.D.faceIdxV Wd.1 Wd.2)) (lq : DF.D.faceLd Wd.1 Wd.2 r) {
   n : Nat = r.1 ;
   k : Nat = r.2.1 ;
   J : Ob = r.2.2.2.1 ;
   u' : Hom J Wd.1 = r.2.2.2.2.1 ;
   z : Obj J = r.2.2.2.2.2.1 ;
   c' : CT.Ch J (suc n) (C.res J Wd.1 u' Wd.2) z = r.2.2.2.2.2.2.1 ;
   Y : TC.TOb = (J, z) ;
   fw : Wt.Pn (suc n) J = Wt.Face[n, J, k, Arith[a].leb-step k n r.2.2.1].Of[(r.2.2.2.2.2.2.2, lq)].face ;
   module RF = AB.RQ[(suc n, J, u', z, c', fw.1), fw.2] ;
   module RCm = AB.RQ[(n, J, u', z, DO.KJ[J].K.comp n k (C.res J Wd.1 u' Wd.2) z c', r.2.2.2.2.2.2.2), lq] ;
   U0 : Hom J I = RF.RC.U0 ;
   rr : VA.Ix (DF.D.faceIdxV I x) = (n, k, r.2.2.1, J, U0, z, RF.RC.cc, r.2.2.2.2.2.2.2) ;
   comp' : CT.Ch J n (C.res J I U0 x) z = DO.KJ[J].K.comp n k (C.res J I U0 x) z RF.RC.cc ;
   s1 : Id (H.TA.EI Y) RF.te ((BK.lineE (n, J, U0, z, comp', r.2.2.2.2.2.2.2) lq).1 Y (TC.tid Y) RF.RC.j0) =
    apH {H.TF.EI Y} {H.TA.EI Y} (\ T -> H.fibL Y T Y (TC.tid Y) RF.RC.j0) (u.2.2.1 rr lq) ;
   s2 : Id (H.TA.EI Y) ((BK.lineE (n, J, U0, z, comp', r.2.2.2.2.2.2.2) lq).1 Y (TC.tid Y) RF.RC.j0) RCm.te =
    apH {CT.Ch J n (C.res J I U0 x) z} {H.TA.EI Y} (\ cc -> (BK.lineE (n, J, U0, z, cc, r.2.2.2.2.2.2.2) lq).1 Y (TC.tid Y) RF.RC.j0)
     (AC.facePath r) ;
   law : Id (H.TA.EI Y) (DF.DB.prz J z (AB.dd.1 (suc n, J, u', z, c', fw.1) fw.2) (AB.bfam (suc n, J, u', z, c', fw.1) fw.2))
           (DF.DB.prz J z (AB.dd.1 (n, J, u', z, DO.KJ[J].K.comp n k (C.res J Wd.1 u' Wd.2) z c', r.2.2.2.2.2.2.2) lq)
                       (AB.bfam (n, J, u', z, DO.KJ[J].K.comp n k (C.res J Wd.1 u' Wd.2) z c', r.2.2.2.2.2.2.2) lq)) =
    transH RF.beq (transH s1 (transH s2 (symH RCm.beq))) ;
  } ;
  aface : W0.Ix (DF.DB.afaceEq Wd.1 Wd.2 AB.dd AB.bfam) = \ r lq -> FC[r, lq].law ;
  -- the top face
  module TP (r : VA.Ix (DF.D.topIdxV Wd.1 Wd.2)) (lq : DF.D.topLd Wd.1 Wd.2 r) {
   n : Nat = r.1 ;
   J : Ob = r.2.1 ;
   u' : Hom J Wd.1 = r.2.2.1 ;
   z : Obj J = r.2.2.2.1 ;
   c' : CT.Ch J (suc n) (C.res J Wd.1 u' Wd.2) z = r.2.2.2.2.1 ;
   Y : TC.TOb = (J, z) ;
   module K = DO.KJ[J].K ;
   ft : Wt.Pn (suc n) J = Wt.Face[n, J, suc n, Tr.leb-refl (suc n)].Of[(r.2.2.2.2.2, lq)].face ;
   DD : K.DR n (C.res J Wd.1 u' Wd.2) z = K.drop n (C.res J Wd.1 u' Wd.2) z c' ;
   module RT = AB.RQ[(suc n, J, u', z, c', ft.1), ft.2] ;
   module RD = AB.RQ[(n, J, u', DD.1, DD.2.1, r.2.2.2.2.2), lq] ;
   U0 : Hom J I = RT.RC.U0 ;
   j0 : PB.IvP J = RT.RC.j0 ;
   X0' : Obj J = C.res J Wd.1 u' (C.res Wd.1 I g.1 x) ;
   X1 : Obj J = C.res J I U0 x ;
   pX : Id (Obj J) X0' X1 = symH (C.res-comp J Wd.1 I g.1 u' x) ;
   hm : PE.PO.VT.VMap J (C.res J Wd.1 u' Wd.2) X0' = PE.PO.VT.rmap J Wd.1 u' Wd.2 (C.res Wd.1 I g.1 x) AC.g0 ;
   rr : VA.Ix (DF.D.topIdxV I x) = (n, J, U0, z, RT.RC.cc, r.2.2.2.2.2) ;
   DD' : K.DR n X1 z = K.drop n X1 z RT.RC.cc ;
   DP : Id (K.DR n X1 z) DD' (DD.1, CT.rxM J Wd.1 I u' g.1 Wd.2 x AC.g0 n DD.1 DD.2.1, DD.2.2) =
    transH (CT.trCh-drop J n X0' X1 pX z (K.rx (suc n) (C.res J Wd.1 u' Wd.2) X0' hm z c'))
     (apH {K.DR n X0' z} {K.DR n X1 z} (\ E2 -> (E2.1, CT.trCh J n X0' X1 pX E2.1 E2.2.1, E2.2.2))
        (K.rx-drop n (C.res J Wd.1 u' Wd.2) X0' hm z c')) ;
   val (E2 : K.DR n X1 z) : H.TA.EI Y =
    (BK.lineE (n, J, U0, E2.1, E2.2.1, r.2.2.2.2.2) lq).1 Y (TC.tcomp Y Y (J, E2.1) (idH J, E2.2.2) (TC.tid Y)) j0 ;
   s1 : Id (H.TA.EI Y) RT.te (val DD') =
    apH {H.TF.EI Y} {H.TA.EI Y} (\ T -> H.fibL Y T Y (TC.tid Y) j0) (u.2.2.2 rr lq) ;
   YD : TC.TOb = (J, DD.1) ;
   gv : TC.THm Y YD = (idH J, DD.2.2) ;
   lnD : W0.Ix (PE.FTg.FE.ob YD) = BK.lineE RD.qq lq ;
   s2 : Id (H.TA.EI Y) (val (DD.1, CT.rxM J Wd.1 I u' g.1 Wd.2 x AC.g0 n DD.1 DD.2.1, DD.2.2)) (lnD.1 Y gv j0) =
    apH {TC.THm Y YD} {H.TA.EI Y} (\ kk -> lnD.1 Y kk j0) (G1.GB.BC.oC-idr Y YD gv) ;
   s3 : Id (H.TA.EI Y) (DF.DB.E.act Y YD gv (DF.DB.prz J DD.1 (AB.dd.1 (n, J, u', DD.1, DD.2.1, r.2.2.2.2.2) lq) (AB.bfam (n, J, u', DD.1, DD.2.1, r.2.2.2.2.2) lq)))
          (lnD.1 Y gv j0) =
    transH (apH {H.TA.EI YD} {H.TA.EI Y} (\ t -> DF.DB.E.act Y YD gv t) RD.beq)
     (transH (lnD.2 Y YD gv (TC.tid YD) j0)
       (transH (apH {TC.THm Y YD} {H.TA.EI Y} (\ kk -> lnD.1 Y kk (PB.ivA J J (idH J) j0)) (G1.GB.BC.oC-idl Y YD gv))
         (apH {PB.IvP J} {H.TA.EI Y} (\ jj -> lnD.1 Y gv jj) (PB.ivA-id J j0)))) ;
   law : Id (H.TA.EI Y) (DF.DB.prz J z (AB.dd.1 (suc n, J, u', z, c', ft.1) ft.2) (AB.bfam (suc n, J, u', z, c', ft.1) ft.2))
           (DF.DB.E.act Y YD gv (DF.DB.prz J DD.1 (AB.dd.1 (n, J, u', DD.1, DD.2.1, r.2.2.2.2.2) lq) (AB.bfam (n, J, u', DD.1, DD.2.1, r.2.2.2.2.2) lq))) =
    transH RT.beq (transH s1 (transH (apH {K.DR n X1 z} {H.TA.EI Y} val DP) (transH s2 (symH s3)))) ;
  } ;
  atop : W0.Ix (DF.DB.atopEq Wd.1 Wd.2 AB.dd AB.bfam) = \ r lq -> TP[r, lq].law ;
 } ;
} ;
