-- CDIn5.seg (canonicity-c2; (d)(2), part 5): natural maps T0 -> Q_y: the
-- first component (a hom x -> y) evaluated at a closed class (as CEv1's nf/nn,
-- for any presentation), and the j-th new value of the second component.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
-- evaluation of homs s -> y at a closed class of A_s, as a natural map
module EvAt (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation)
  (c : C.El C.nil (CHomT3[a].HomP[R, encK, pe].Hom[s, y].AS.Qt)) {
 module HZ = CHomT3[a].HomP[R, encK, pe].Hom[s, y] ;
 module B0 = HZ.B0 ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = HZ.HomT ;
 QA : C.Ty Nl = HZ.AS.Qt ;
 QY : C.Ty Nl = HZ.AT.Qt ;
 nf (K : Ob) : (o : Top) -> V1.Ix (HT.1.tob K o) -> V1.Ix (QY.1.tob K o) = split { tt -> \ g -> B0.hv K tt g.1 (c.eob K tt) } ;
 nn (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o') (g : V1.Ix (HT.1.tob I o))
   -> Id (V1.Ix (QY.1.tob J o')) (QY.1.tact J I f o o' e (nf I o g)) (nf J o' (HT.1.tact J I f o o' e g)) =
  split { tt -> split { tt -> \ e g ->
   transH (L.tact-irr Nl QY.1 J I f tt tt e (refl tt) (B0.hv I tt g.1 (c.eob I tt)))
    (transH (symH (B0.NTh[I, J, f, tt, g.1, c.eob I tt].law))
      (transH (apH {V1.Ix (B0.MapT.1.tob J tt)} {V1.Ix (QY.1.tob J tt)} (\ mm -> B0.hv J tt mm (B0.rsS I J f tt (c.eob I tt)))
                 (L.tact-irr Nl B0.MapT.1 J I f tt tt (refl tt) e g.1))
        (apH {V1.Ix (QA.1.tob J tt)} {V1.Ix (QY.1.tob J tt)} (\ v -> B0.hv J tt (B0.MapT.1.tact J I f tt tt e g.1) v)
           (c.enat J I f tt tt (refl tt))))) } } ;
 nm : HO.NMap[Nl, HT.1, QY.1] = new HO.NMap[Nl, HT.1, QY.1, nf, nn] ;
} ;
module In5 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module I1m = CDIn1[a].In1[R, encK, pe, x, u, y] ;
 module F1 = I1m.F1 ;
 module S1 = F1.S1 ;
 Nl : C.Ctx = C.nil ;
 T0 : C.Ty Nl = I1m.T0 ;
 QY : C.Ty Nl = S1.Qy ;
 -- the first component at x's generator j
 module EJ (j : SX.Fin x.1) {
  module EA = EvAt[R, encK, pe, x, y, S1.AXx.AX.cls (var j)] ;
  m : HO.NMap[Nl, T0.1, QY.1] = new HO.NMap[Nl, T0.1, QY.1, \ K o t -> EA.nf K o t.1, \ J I f o o' e t -> EA.nn J I f o o' e t.1] ;
 } ;
 -- the j-th new value
 module S2 = F1.S2 ;
 lkP : (k : Nat) -> SX.Fin k -> (K : Ob) -> S1.PK k K -> S1.EV.QK K = split {
  zero -> \ j -> absurd ((K : Ob) -> S1.PK zero K -> S1.EV.QK K) j ;
  suc k | r -> split { inl j -> \ K v -> r j K v.1 ; inr t -> \ K v -> v.2 } } ;
 lkPNat : (k : Nat) (j : SX.Fin k) (K Lo : Ob) (g : Hom Lo K) (v : S1.PK k K) -> Id (S1.EV.QK Lo) (lkP k j Lo (S2.PmAct k K Lo g v)) (S1.rsQ K Lo g (lkP k j K v)) = split {
  zero -> \ j -> absurd ((K Lo : Ob) (g : Hom Lo K) (v : S1.PK zero K) -> Id (S1.EV.QK Lo) (lkP zero j Lo (S2.PmAct zero K Lo g v)) (S1.rsQ K Lo g (lkP zero j K v))) j ;
  suc k | r -> split {
   inl j -> \ K Lo g v -> r j K Lo g v.1 ;
   inr t -> \ K Lo g v -> L.tact-irr Nl QY.1 Lo K g tt tt
      (L.ntEq (C.ext Nl (S1.Pm k)) Nl (C.p Nl (S1.Pm k)) Lo K g (tt, v.1) (tt, S2.PmAct k K Lo g v.1) (L.pair-act Nl (S1.Pm k).1 Lo K g tt tt (refl tt) v.1))
      (refl tt) v.2 } } ;
 module NJ (j : SX.Fin F1.m) {
  nf (K : Ob) : (o : Top) -> V1.Ix (T0.1.tob K o) -> V1.Ix (QY.1.tob K o) = split { tt -> \ t -> lkP F1.m j K t.2.1 } ;
  nn (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o') (t : V1.Ix (T0.1.tob I o))
    -> Id (V1.Ix (QY.1.tob J o')) (QY.1.tact J I f o o' e (nf I o t)) (nf J o' (T0.1.tact J I f o o' e t)) =
   split { tt -> split { tt -> \ e t ->
    symH (transH (apH {S1.PK F1.m J} {S1.EV.QK J} (lkP F1.m j J)
                   (L.tact-irr Nl (S1.Pm F1.m).1 J I f tt tt
                     (L.ntEq S1.Gh Nl (C.eps S1.Gh) J I f (tt, t.1) (tt, S1.HXY.1.tact J I f tt tt e t.1)
                        (L.pair-act Nl S1.HXY.1 J I f tt tt e t.1))
                     (refl tt) t.2.1))
      (transH (lkPNat F1.m j I J f t.2.1) (L.tact-irr Nl QY.1 J I f tt tt (refl tt) e (lkP F1.m j I t.2.1)))) } } ;
  m : HO.NMap[Nl, T0.1, QY.1] = new HO.NMap[Nl, T0.1, QY.1, nf, nn] ;
 } ;
} ;
