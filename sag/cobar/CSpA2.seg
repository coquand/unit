-- CSpA2.seg (canonicity-45; COBAR.md "Prop 58"): the map gY : yo(y) -> G^k
-- (k = y.1) whose components are tau . pre_(x_i) (CE1Tot's Rs (var i)), built as
-- tuples matching c2's lookup (CAxEv.lk), with its naturality.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module GYo (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module T1 = CE1Tot[a].T1[R, encK, pe, y] ;
 module EG = CAxEv[a].EvG[R, encK, pe] ;
 module PW = EG.PW ;
 C : CwF.CwF[a++] = EG.C ;
 PYy : C.Ctx = T1.CT.TC.toP (T1.CM.Yo[y].yoT) ;
 -- tuples in G^j at X, and c2's lookup on them
 pt (X : EG.Ob) : (j : Nat) -> (SX.Fin j -> EG.GV X) -> V1.Ix ((EG.Gk j).ob X) = split {
  zero -> \ f -> tt ;
  suc j | r -> \ f -> (r (\ v -> f (inl v)), f (inr tt)) } ;
 gv (v : SX.Fin y.1) (X : EG.Ob) (c : V1.Ix (PYy.ob X)) : EG.GV X = (T1.Rs (var v)).nfun X tt c ;
 -- the action on tuples is componentwise
 ptN (J I : EG.Ob) (f : EG.Hm J I) : (j : Nat) (fI : SX.Fin j -> EG.GV I) (fJ : SX.Fin j -> EG.GV J)
   (h : (v : SX.Fin j) -> Id (EG.GV J) (EG.rsG J I f (fI v)) (fJ v))
   -> Id (V1.Ix ((EG.Gk j).ob J)) ((EG.Gk j).act J I f (pt I j fI)) (pt J j fJ) = split {
  zero -> \ fI fJ h -> isTop ((EG.Gk zero).act J I f tt) tt ;
  suc j | r -> \ fI fJ h ->
   transH (apH {V1.Ix ((EG.Gk j).ob J)} {V1.Ix ((EG.Gk (suc j)).ob J)}
             (\ x2 -> (x2, ((EG.Gk (suc j)).act J I f (pt I (suc j) fI)).2))
             (r (\ v -> fI (inl v)) (\ v -> fJ (inl v)) (\ v -> h (inl v))))
    (apH {EG.GV J} {V1.Ix ((EG.Gk (suc j)).ob J)} (\ a2 -> (pt J j (\ v -> fJ (inl v)), a2))
      (transH (EG.PS.tact-irr EG.Nl EG.GB.GT J I f tt tt (EG.PS.ntEq (EG.Gk j) EG.Nl (EG.C.eps (EG.Gk j)) J I f (pt I j (\ v -> fI (inl v))) ((EG.Gk j).act J I f (pt I j (\ v -> fI (inl v)))) (refl ((EG.Gk j).act J I f (pt I j (\ v -> fI (inl v)))))) (refl tt) (fI (inr tt))) (h (inr tt)))) } ;
 -- gY : yo(y) -> G^k, c |-> (tau . pre_(x_i) c)_i
 gYn (X : EG.Ob) (c : V1.Ix (PYy.ob X)) : V1.Ix ((EG.Gk y.1).ob X) = pt X y.1 (\ v -> gv v X c) ;
 gY : C.Sub PYy (EG.Gk y.1) = new EG.PS.PSub[PYy, EG.Gk y.1, gYn,
  \ J I f c -> symH (ptN J I f y.1 (\ v -> gv v I c) (\ v -> gv v J (PYy.act J I f c))
     (\ v -> (T1.Rs (var v)).nnat J I f tt tt (refl tt) c))] ;
} ;

-- A = Sp(u) along gY, for a relative presentation u over y
module AY (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module G = GYo[R, encK, pe, y] ;
 module SP = CSpA[a].SA[R, encK, pe, y.1, u.1] ;
 -- the generators of y.u as (old, new)
 lift (m : Nat) : Arith[a].Plus (SX.Fin y.1) (SX.Fin m) -> Arith[a].Plus (SX.Fin y.1) (SX.Fin (suc m)) = split { inl v -> inl v ; inr w -> inr (inl w) } ;
 spl : (m : Nat) -> SX.Fin (Arith[a].plus m y.1) -> Arith[a].Plus (SX.Fin y.1) (SX.Fin m) = split {
  zero -> \ v -> inl v ;
  suc m | ih -> split { inl v -> lift m (ih v) ; inr w -> inr (inr w) } } ;
 qs : SX.Over[R].Equations SP.SO.TW.Var = SX.mapL (SX.Over[R].Expr (SX.Fin (Arith[a].plus u.1 y.1))) (SX.Over[R].Expr SP.SO.TW.Var)
   (SX.Rel[R].rename (SX.Fin (Arith[a].plus u.1 y.1)) SP.SO.TW.Var (spl u.1)) u.2 ;
 A : G.C.Ty G.PYy = G.C.subT G.PYy SP.SO.Pr (SP.Sp qs) G.gY ;
} ;
