-- CTotL12j.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part j: two face pieces k < l+1 agree on
-- their overlap: both are level m-1 read through the double face (the
-- level's faces P3t, the vertical composition law vact-o, Chains'
-- ff-fc, Weights' W3); at level 1 they never meet.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;
module Ar = Arith[a] ;

module L12j (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LH = CTotL12h[a, vl, l].L12h[C, G, A] ;
 module LA = LH.LA ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 -- the action along two vertical maps is the action along their composite
 vact-o (W1 : Ob) (z y x' : Obj W1) (f : VT.VMap W1 y x') (g : VT.VMap W1 z y) (P : DA.Ez W1 x')
  : Id (DA.Ez W1 z) (DA.E.act (W1, z) (W1, y) (idH W1, g) (DA.E.act (W1, y) (W1, x') (idH W1, f) P))
      (DA.E.act (W1, z) (W1, x') (idH W1, VT.vcomp W1 z y x' f g) P) =
  transH (symH (DA.E.act-o (W1, z) (W1, y) (W1, x') (idH W1, f) (idH W1, g) P))
   (apH {TC.THm (W1, z) (W1, x')} {DA.Ez W1 z} (\ kk -> DA.E.act (W1, z) (W1, x') kk P)
      (symH (VT.TH-tr W1 W1 (compH W1 W1 W1 (idH W1) (idH W1)) (idH W1) (comp-idl W1 W1 (idH W1)) z x'
               (C.compD W1 W1 W1 (idH W1) (idH W1) z y x' f g)))) ;

 module Fj (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FH = LH.Fh[X, gm, s] ;
  module F = FH.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  module FFS (m1 : Nat) (p : F.Up (suc m1)) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc (suc m1)) J u z) (i : Wt.Pn (suc (suc m1)) J)
    (k k1 : Nat) (hk : Tr.IsT (Tr.leb k (suc (suc m1)))) (hk' : Tr.IsT (Tr.leb (suc k1) (suc (suc m1)))) (lt : Tr.IsT (Ar.ltb k (suc k1)))
    (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y)
    (lw : PB.Lands W1 J (FH.FP[suc m1, p, J, u, z, c, i, k, hk].Q) v) (lw' : PB.Lands W1 J (FH.FP[suc m1, p, J, u, z, c, i, suc k1, hk'].Q) v) {
   module Fk = FH.FP[suc m1, p, J, u, z, c, i, k, hk] ;
   module Fl = FH.FP[suc m1, p, J, u, z, c, i, suc k1, hk'] ;
   module K = DO.KJ[W1].K ;
   uv : Hom W1 I = compH W1 J I u v ;
   rux : Obj W1 = C.res W1 I uv x ;
   cc : CT.Ch W1 (suc (suc m1)) rux y = Fk.chT W1 v y e ;
   ih : Wt.Pn (suc (suc m1)) W1 = Fk.ih W1 v ;
   v' : F.Vt m1 = F.top m1 p.2.2.2.1 ;
   P3 : F.P3t m1 p.1 v' = p.2.2.2.2 ;
   hkb : Tr.IsT (Tr.leb k (suc m1)) = Tr.leb-trans k k1 (suc m1) lt hk' ;
   pk : Wt.Pn (suc m1) W1 = Fk.pw W1 v lw ;
   pl : Wt.Pn (suc m1) W1 = Fl.pw W1 v lw' ;
   z1 : PB.Lands W1 PFO.ivO (PFO.ptSO PB.e0) (pk.1 (k1, hk')) =
    subst (Ar.Fin (suc (suc (suc m1)))) (\ j -> PB.Lands W1 PFO.ivO (PFO.ptSO PB.e0) (ih.1 j))
     (suc k1, hk') (Wt.Face[suc m1, W1, k, hk].skipF (k1, hk'))
     (Wt.fin-eq (suc (suc (suc m1))) (suc k1, hk') (Wt.Face[suc m1, W1, k, hk].skipF (k1, hk')) (sym Nat (Ar.skip k k1) (suc k1) (Ar.skip-ge k k1 lt)))
     (Fl.zh W1 v lw') ;
   z2 : PB.Lands W1 PFO.ivO (PFO.ptSO PB.e0) (pl.1 (k, hkb)) =
    subst (Ar.Fin (suc (suc (suc m1)))) (\ j -> PB.Lands W1 PFO.ivO (PFO.ptSO PB.e0) (ih.1 j))
     (k, hk) (Wt.Face[suc m1, W1, suc k1, hk'].skipF (k, hkb))
     (Wt.fin-eq (suc (suc (suc m1))) (k, hk) (Wt.Face[suc m1, W1, suc k1, hk'].skipF (k, hkb)) (sym Nat (Ar.skip (suc k1) k) k (Ar.skip-lt (suc k1) k lt)))
     (Fk.zh W1 v lw) ;
   i2 : Wt.Pn m1 W1 = Wt.Unface[m1, W1, k1, hk', pk, z1].p' ;
   i3 : Wt.Pn m1 W1 = Wt.Unface[m1, W1, k, hkb, pl, z2].p' ;
   wp1 : Id (Wt.Pn (suc m1) W1) (Wt.Face[m1, W1, k1, hk'].Of[i2].face) pk =
    Sigma-eq (Wt.Coords (suc m1) W1) (\ cs -> PB.Lands W1 W1 (Wt.oneS (suc m1) W1 cs) (PB.idH W1))
     (Wt.Face[m1, W1, k1, hk'].Of[i2].face).1 pk.1 (Wt.Face[m1, W1, k1, hk'].Of[i2].face).2 pk.2
     (funext (Ar.Fin (suc (suc m1))) (\ j -> Hom W1 PFO.ivO) (Wt.Face[m1, W1, k1, hk'].Of[i2].face).1 pk.1
        (\ j -> Wt.Unface[m1, W1, k1, hk', pk, z1].face-eq j))
     (PB.isProp-Lands W1 W1 (Wt.oneS (suc m1) W1 pk.1) (PB.idH W1)) ;
   wp2 : Id (Wt.Pn (suc m1) W1) (Wt.Face[m1, W1, k, hkb].Of[i3].face) pl =
    Sigma-eq (Wt.Coords (suc m1) W1) (\ cs -> PB.Lands W1 W1 (Wt.oneS (suc m1) W1 cs) (PB.idH W1))
     (Wt.Face[m1, W1, k, hkb].Of[i3].face).1 pl.1 (Wt.Face[m1, W1, k, hkb].Of[i3].face).2 pl.2
     (funext (Ar.Fin (suc (suc m1))) (\ j -> Hom W1 PFO.ivO) (Wt.Face[m1, W1, k, hkb].Of[i3].face).1 pl.1
        (\ j -> Wt.Unface[m1, W1, k, hkb, pl, z2].face-eq j))
     (PB.isProp-Lands W1 W1 (Wt.oneS (suc m1) W1 pl.1) (PB.idH W1)) ;
   w23 : Id (Wt.Pn m1 W1) i2 i3 =
    Sigma-eq (Wt.Coords m1 W1) (\ cs -> PB.Lands W1 W1 (Wt.oneS m1 W1 cs) (PB.idH W1)) i2.1 i3.1 i2.2 i3.2
     (funext (Ar.Fin (suc m1)) (\ j -> Hom W1 PFO.ivO) i2.1 i3.1 (\ j -> Wt.W3[m1, W1, k, k1, lt, hk'].coord ih j))
     (PB.isProp-Lands W1 W1 (Wt.oneS m1 W1 i3.1) (PB.idH W1)) ;
   Xv (DD : K.DR m1 rux y) (w : Wt.Pn m1 W1) : DA.Ez W1 y =
    DA.E.act (W1, y) (W1, DD.1) (idH W1, DD.2.2) (F.pzv m1 v' W1 uv DD.1 DD.2.1 w) ;
   Dk : K.DR (suc m1) rux y = K.fc (suc m1) k rux y cc ;
   Dl : K.DR (suc m1) rux y = K.fc (suc m1) (suc k1) rux y cc ;
   D1 : K.DR m1 rux Dk.1 = K.fc m1 k1 rux Dk.1 Dk.2.1 ;
   D2 : K.DR m1 rux Dl.1 = K.fc m1 k rux Dl.1 Dl.2.1 ;
   sk : Id (DA.Ez W1 y) (Fk.vg W1 v y e lw) (Xv (K.dd m1 k1 k rux y cc) i2) =
    transH (ap (DA.Ez W1 Dk.1) (DA.Ez W1 y) (\ q -> DA.E.act (W1, y) (W1, Dk.1) (idH W1, Dk.2.2) q)
              (F.pzv (suc m1) p.1 W1 uv Dk.1 Dk.2.1 pk)
              (DA.E.act (W1, Dk.1) (W1, D1.1) (idH W1, D1.2.2) (F.pzv m1 v' W1 uv D1.1 D1.2.1 i2))
              (transH (apH {Wt.Pn (suc m1) W1} {DA.Ez W1 Dk.1} (\ q -> F.pzv (suc m1) p.1 W1 uv Dk.1 Dk.2.1 q) (symH wp1))
                 (P3 W1 uv Dk.1 Dk.2.1 i2 k1 hk')))
     (vact-o W1 y Dk.1 D1.1 D1.2.2 Dk.2.2 (F.pzv m1 v' W1 uv D1.1 D1.2.1 i2)) ;
   sl : Id (DA.Ez W1 y) (Fl.vg W1 v y e lw') (Xv (K.dd m1 k (suc k1) rux y cc) i3) =
    transH (ap (DA.Ez W1 Dl.1) (DA.Ez W1 y) (\ q -> DA.E.act (W1, y) (W1, Dl.1) (idH W1, Dl.2.2) q)
              (F.pzv (suc m1) p.1 W1 uv Dl.1 Dl.2.1 pl)
              (DA.E.act (W1, Dl.1) (W1, D2.1) (idH W1, D2.2.2) (F.pzv m1 v' W1 uv D2.1 D2.2.1 i3))
              (transH (apH {Wt.Pn (suc m1) W1} {DA.Ez W1 Dl.1} (\ q -> F.pzv (suc m1) p.1 W1 uv Dl.1 Dl.2.1 q) (symH wp2))
                 (P3 W1 uv Dl.1 Dl.2.1 i3 k hkb)))
     (vact-o W1 y Dl.1 D2.1 D2.2.2 Dl.2.2 (F.pzv m1 v' W1 uv D2.1 D2.2.1 i3)) ;
   res : Id (DA.Ez W1 y) (Fk.vg W1 v y e lw) (Fl.vg W1 v y e lw') =
    transH sk
     (transH (apH {K.DR m1 rux y} {DA.Ez W1 y} (\ DD -> Xv DD i2) (symH (K.ff-fc m1 k (suc k1) lt hk' rux y cc)))
       (transH (apH {Wt.Pn m1 W1} {DA.Ez W1 y} (\ w -> Xv (K.dd m1 k (suc k1) rux y cc) w) w23) (symH sl))) ;
  } ;

  module FF0 (p : F.Up zero) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc zero) J u z) (i : Wt.Pn (suc zero) J)
    (k k1 : Nat) (hk : Tr.IsT (Tr.leb k (suc zero))) (hk' : Tr.IsT (Tr.leb (suc k1) (suc zero))) (lt : Tr.IsT (Ar.ltb k (suc k1)))
    (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y)
    (lw : PB.Lands W1 J (FH.FP[zero, p, J, u, z, c, i, k, hk].Q) v) (lw' : PB.Lands W1 J (FH.FP[zero, p, J, u, z, c, i, suc k1, hk'].Q) v) {
   module Fk = FH.FP[zero, p, J, u, z, c, i, k, hk] ;
   module Fl = FH.FP[zero, p, J, u, z, c, i, suc k1, hk'] ;
   module Uk = Wt.Unface[zero, W1, k, hk, Fk.ih W1 v, Fk.zh W1 v lw] ;
   module Ul = Wt.Unface[zero, W1, suc k1, hk', Fl.ih W1 v, Fl.zh W1 v lw'] ;
   k10 : Id Nat k1 zero = Ar.leb-zero k1 hk' ;
   k0 : Id Nat k zero = Ar.leb-zero k (Tr.leb-trans k k1 zero lt hk') ;
   aux1 : (o1 : Nat) -> Tr.IsT (Ar.ltb (suc o1) (suc (suc zero))) -> (Id Nat (suc o1) (suc k1) -> Empty) -> Empty = split {
    zero -> \ h b -> b (ap Nat Nat (\ n -> suc n) zero k1 (sym Nat k1 zero k10)) ;
    suc o2 -> \ h b -> Tr.false-true h } ;
   aux : (o : Nat) -> Tr.IsT (Ar.ltb o (suc (suc zero))) -> (Id Nat o k -> Empty) -> (Id Nat o (suc k1) -> Empty) -> Empty = split {
    zero -> \ h a1 b -> a1 (sym Nat k zero k0) ;
    suc o1 -> \ h a1 b -> aux1 o1 h b } ;
   emp : Empty = aux Uk.out.1.1 Uk.out.1.2 (\ e2 -> Uk.notk e2) (\ e2 -> Ul.notk e2) ;
   res : Id (DA.Ez W1 y) (Fk.vg W1 v y e lw) (Fl.vg W1 v y e lw') = absurd _ emp ;
  } ;

  FFty (m : Nat) (p : F.Up m) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn (suc m) J) : U l =
   (k k1 : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (hk' : Tr.IsT (Tr.leb (suc k1) (suc m))) (lt : Tr.IsT (Ar.ltb k (suc k1)))
   (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y)
   (lw : PB.Lands W1 J (FH.FP[m, p, J, u, z, c, i, k, hk].Q) v) (lw' : PB.Lands W1 J (FH.FP[m, p, J, u, z, c, i, suc k1, hk'].Q) v)
   -> Id (DA.Ez W1 y) (FH.FP[m, p, J, u, z, c, i, k, hk].vg W1 v y e lw) (FH.FP[m, p, J, u, z, c, i, suc k1, hk'].vg W1 v y e lw') ;

  ffP : (m : Nat) -> (p : F.Up m) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn (suc m) J) -> FFty m p J u z c i = split {
   zero -> \ p J u z c i k k1 hk hk' lt W1 v y e lw lw' -> FF0[p, J, u, z, c, i, k, k1, hk, hk', lt, W1, v, y, e, lw, lw'].res ;
   suc m1 -> \ p J u z c i k k1 hk hk' lt W1 v y e lw lw' -> FFS[m1, p, J, u, z, c, i, k, k1, hk, hk', lt, W1, v, y, e, lw, lw'].res } ;
 } ;
} ;
