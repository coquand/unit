-- Pull the operations of a ring over G to a variable context D.
-- This is transport along the CwF's naturality paths for function types;
-- no strict preservation of operations is assumed.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Ring[a++] ;
module FT = CFinIntTy[a] ;

module Pull (G D : FT.C.Ctx) (Rg : FT.PR.HRing[G])
 (s : FT.C.Sub D G) {
 C : CwF.CwF[a++] = FT.C ;
 A : C.Ty D = C.subT D G Rg.R s ;
 F : C.Ty G = FT.OV.Fun G Rg.R Rg.R ;
 FA : C.Ty D = FT.OV.Fun D A A ;
 inner : Id (C.Ty D) (C.subT D G F s) FA =
  FT.OV.Fun-ov D G Rg.R Rg.R s A (refl A) A (refl A) ;
 outer : Id (C.Ty D)
   (C.subT D G (FT.OV.Fun G Rg.R F) s)
   (FT.OV.Fun D A FA) =
  FT.OV.Fun-ov D G Rg.R F s A (refl A) FA inner ;
 pull2 (u : C.El G (FT.OV.Fun G Rg.R F)) : C.El D (FT.OV.Fun D A FA) =
  FT.OV.trE D (C.subT D G (FT.OV.Fun G Rg.R F) s)
    (FT.OV.Fun D A FA) outer
    (C.subt D G (FT.OV.Fun G Rg.R F) u s) ;
 add : C.El D (FT.OV.Fun D A FA) = pull2 Rg.add ;
 mul : C.El D (FT.OV.Fun D A FA) = pull2 Rg.mul ;
 zero : C.El D A = C.subt D G Rg.R Rg.zero s ;
 one : C.El D A = C.subt D G Rg.R Rg.one s ;
 ap2 (u : C.El D (FT.OV.Fun D A FA)) (x y : C.El D A) : C.El D A =
  FT.OV.app D A A (FT.OV.app D A FA u x) y ;
} ;
