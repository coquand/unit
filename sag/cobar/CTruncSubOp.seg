-- CTruncSubOp.seg (canonicity-c2; SIMPLIFIED.md item 1): a seeded
-- extension operation is stable under substitution.
--
-- For s : D -> G and an operation k on B over G, the operation on B[s]
-- over D extends a partial element at d with seed u by k at s d, the
-- partial element being read in the totals of B (CSub.SubE.mV).  Its
-- boundary and uniformity are k's, transported back by the injectivity
-- of the reading over a point.
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;
module CP = PB.CPartial[l] ;

-- sides over two equal points with the same cofibration and values
side-tr (G : PCtx) (B : PTy[G]) (X : Ob) (x x' : W.Ix (G.ob X)) (p : Id (W.Ix (G.ob X)) x x')
  (sd : CP.Partials[G, B].Side[X, x]) (sd' : CP.Partials[G, B].Side[X, x'])
  (eQ : Id (PB.Phi X) sd.pQ sd'.pQ) (ev : CP.Partials[G, B].PvEq X sd.pQ sd'.pQ sd.pv sd'.pv)
  : Id (CP.Partials[G, B].Side[X, x']) (substH (\ y -> CP.Partials[G, B].Side[X, y]) p sd) sd' =
  idJ (W.Ix (G.ob X)) x
    (\ x2 p2 -> (s2 : CP.Partials[G, B].Side[X, x2]) (eq2 : Id (PB.Phi X) sd.pQ s2.pQ)
       -> CP.Partials[G, B].PvEq X sd.pQ s2.pQ sd.pv s2.pv
       -> Id (CP.Partials[G, B].Side[X, x2]) (substH (\ y -> CP.Partials[G, B].Side[X, y]) p2 sd) s2)
    (\ s2 eq2 ev2 -> CP.Partials[G, B].side-ext X x sd s2 eq2 ev2)
    x' p sd' eQ ev ;

module SubOp (D G : PCtx) (s : PSub[D, G]) (B : PTy[G]) (k : CTruncSeededBack[a, l].Seeded[G, B].Op) {
  Bs : PTy[D] = subTy D G B s ;
  module SE = PB.CSub[l].SubE[D, G, s, B] ;
  module TS = PR.TyL[D, Bs] ;
  module TC = PR.TyL[G, B] ;
  module PPd = CP.Partials[D, Bs] ;
  module PPg = CP.Partials[G, B] ;
  module LK = CTruncSeededBack[a, l].Seeded[G, B].Laws[k] ;

  -- a side of B[s] read in B
  sideG (X : Ob) (d : W.Ix (D.ob X)) (sd : PPd.Side[X, d]) : PPg.Side[X, s.nt X d] =
    PPg.mkSide X (s.nt X d) sd.pQ (\ Y f i -> SE.mV Y (sd.pv Y f i))
      (\ Y f i -> transH (apH (s.nt Y) (sd.ppt Y f i)) (s.nt-nat Y X f d))
      (\ Z Y chi f i i' -> transH (SE.mV-nat Z Y chi (sd.pv Y f i)) (apH (SE.mV Z) (sd.pnat Z Y chi f i i'))) ;

  kop (X : Ob) (d : W.Ix (D.ob X)) (u : W.Ix (Bs.tob X d)) (sd : PPd.Side[X, d]) : W.Ix (Bs.tob X d) =
    k.kop X (s.nt X d) u (sideG X d sd) ;

  kside (X : Ob) (d : W.Ix (D.ob X)) (u : W.Ix (Bs.tob X d)) (sd : PPd.Side[X, d]) (Y : Ob) (h : Hom Y X) (i : PB.Lands Y X sd.pQ h)
    : Id (TS.EI Y) (TS.E.act Y X h (TS.pr X d (kop X d u sd))) (sd.pv Y h i) =
    SE.mV-inj Y (TS.E.act Y X h (TS.pr X d (kop X d u sd))) (sd.pv Y h i) (symH (sd.ppt Y h i))
      (transH (symH (SE.mV-nat Y X h (TS.pr X d (kop X d u sd))))
        (k.kside X (s.nt X d) u (sideG X d sd) Y h i)) ;

  module Un (Y X : Ob) (h : Hom Y X) (d : W.Ix (D.ob X)) (u : W.Ix (Bs.tob X d)) (sd : PPd.Side[X, d]) {
    d' : W.Ix (D.ob Y) = D.act Y X h d ;
    g' : W.Ix (G.ob Y) = G.act Y X h (s.nt X d) ;
    pp : Id (W.Ix (G.ob Y)) g' (s.nt Y d') = symH (s.nt-nat Y X h d) ;
    u1 : W.Ix (B.tob Y g') = B.tact Y X h (s.nt X d) g' (refl g') u ;
    u2 : W.Ix (B.tob Y (s.nt Y d')) = Bs.tact Y X h d d' (refl d') u ;
    sides : Id (PPg.Side[Y, s.nt Y d']) (substH (\ y -> PPg.Side[Y, y]) pp (PPg.rside Y X h (s.nt X d) (sideG X d sd))) (sideG Y d' (PPd.rside Y X h d sd)) =
      side-tr G B Y g' (s.nt Y d') pp (PPg.rside Y X h (s.nt X d) (sideG X d sd)) (sideG Y d' (PPd.rside Y X h d sd))
        (refl (PB.pre Y X h sd.pQ)) (\ Z f i i' -> apH (\ j -> SE.mV Z (sd.pv Z (compH Z Y X h f) j)) (PB.isProp-Lands Z X sd.pQ (compH Z Y X h f) (PB.lands-pre Z Y X h sd.pQ f i) (PB.lands-pre Z Y X h sd.pQ f i'))) ;
    res : Id (TS.EI Y) (TS.E.act Y X h (TS.pr X d (kop X d u sd))) (TS.pr Y d' (kop Y d' u2 (PPd.rside Y X h d sd))) =
      SE.mV-inj Y (TS.E.act Y X h (TS.pr X d (kop X d u sd))) (TS.pr Y d' (kop Y d' u2 (PPd.rside Y X h d sd))) (refl d')
        (transH (symH (SE.mV-nat Y X h (TS.pr X d (kop X d u sd))))
          (transH (k.kunif Y X h (s.nt X d) u (sideG X d sd))
            (LK.cong Y g' (s.nt Y d') pp u1 u2
               (pair-act G B Y X h (s.nt X d) (s.nt Y d') (ntEq D G s Y X h d d' (refl d')) u)
               (PPg.rside Y X h (s.nt X d) (sideG X d sd)) (sideG Y d' (PPd.rside Y X h d sd)) sides))) ;
  } ;

  op : CTruncSeededBack[a, l].Seeded[D, Bs].Op =
    new CTruncSeededBack[a, l].Seeded[D, Bs].Op[kop, kside, \ Y X h d u sd -> Un[Y, X, h, d, u, sd].res] ;
} ;
