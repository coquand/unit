-- CRhoPt.seg (canonicity-45; COBAR.md "Prop 58"): rho's point of the
-- telescope's variable context at c : y.u -> x: gY (c . p_u) extended by the new
-- values tau . pre_(x_new) c; c2's evaluation (CAxEv.Two.ev) of a renamed
-- equation there is G's evaluation at rho's inputs (CRhoId), pointwise.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RP (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module RI = CRhoId[a].RI[R, encK, pe, y, u] ;
 module AYm = RI.AYm ;
 module SP = AYm.SP ;
 module TW = SP.SO.TW ;
 module EG = AYm.G.EG ;
 module Tu = RI.Tu ;
 k : Nat = y.1 ;
 n : Nat = u.1 ;
 module PU' = Tu.CM.II.PuC[y, u] ;
 preU : Tu.HO1.NMap[Tu.P1, Tu.XT, AYm.G.T1.XT] = Tu.PreN[RI.yu, y, PU'.M.mor, PU'.M.mor-nat].nm ;
 -- the point: gY (c . p_u), then the new values
 base (X : EG.Ob) (c : V1.Ix (Tu.XT.tob X tt)) : V1.Ix ((EG.Gk k).ob X) = AYm.G.gYn X (preU.nfun X tt c) ;
 nv (X : EG.Ob) (c : V1.Ix (Tu.XT.tob X tt)) (j : SX.Fin n) : EG.GV X = (Tu.Rs (var (RI.newpos n j))).nfun X tt c ;
 ptE (X : EG.Ob) (b : V1.Ix ((EG.Gk k).ob X)) : (j : Nat) -> (SX.Fin j -> EG.GV X) -> V1.Ix ((EG.PW.Ext (EG.Gk k) j).ob X) = split {
  zero -> \ f -> b ;
  suc j | r -> \ f -> (r (\ v -> f (inl v)), f (inr tt)) } ;
 xpt (X : EG.Ob) (c : V1.Ix (Tu.XT.tob X tt)) : V1.Ix (TW.Vc.ob X) = ptE X (base X c) n (nv X c) ;
 -- lookups on the point
 dropE (X : EG.Ob) (b : V1.Ix ((EG.Gk k).ob X)) : (j : Nat) (f : SX.Fin j -> EG.GV X) -> Id (V1.Ix ((EG.Gk k).ob X)) (TW.dropN j X (ptE X b j f)) b = split {
  zero -> \ f -> refl b ;
  suc j | r -> \ f -> r (\ v -> f (inl v)) } ;
 lkE (X : EG.Ob) (b : V1.Ix ((EG.Gk k).ob X)) : (j : Nat) (v : SX.Fin j) (f : SX.Fin j -> EG.GV X) -> Id (EG.GV X) (TW.lkX j v X (ptE X b j f)) (f v) = split {
  zero -> \ v -> absurd ((f : SX.Fin zero -> EG.GV X) -> Id (EG.GV X) (TW.lkX zero v X (ptE X b zero f)) (f v)) v ;
  suc j | r -> split {
   inl v -> \ f -> r v (\ w -> f (inl w)) ;
   inr w -> \ f -> apH {Top} {EG.GV X} (\ w2 -> f (inr w2)) (isTop tt w) } } ;
 lkP (X : EG.Ob) : (j : Nat) (v : SX.Fin j) (f : SX.Fin j -> EG.GV X) -> Id (EG.GV X) (TW.E1.lk j v X (AYm.G.pt X j f)) (f v) = split {
  zero -> \ v -> absurd ((f : SX.Fin zero -> EG.GV X) -> Id (EG.GV X) (TW.E1.lk zero v X (AYm.G.pt X zero f)) (f v)) v ;
  suc j | r -> split {
   inl v -> \ f -> r v (\ w -> f (inl w)) ;
   inr w -> \ f -> apH {Top} {EG.GV X} (\ w2 -> f (inr w2)) (isTop tt w) } } ;
 -- the variables
 lk2w (X : EG.Ob) (c : V1.Ix (Tu.XT.tob X tt)) : (w : TW.Var) -> Id (EG.GV X) (TW.lk2 w X (xpt X c)) ((RI.compF w).nfun X tt c) = split {
  inl i -> transH (apH {V1.Ix ((EG.Gk k).ob X)} {EG.GV X} (TW.E1.lk k i X) (dropE X (base X c) n (nv X c)))
    (lkP X k i (\ v -> AYm.G.gv v X (preU.nfun X tt c))) ;
  inr j -> lkE X (base X c) n j (nv X c) } ;
 -- c2's evaluation of a renamed equation at rho's point = G's evaluation at rho's inputs
 evEq (X : EG.Ob) (c : V1.Ix (Tu.XT.tob X tt)) : (q : SX.Over[R].Expr (SX.Fin RI.yu.1))
   -> Id (EG.GV X) (TW.ev (SX.Rel[R].rename (SX.Fin RI.yu.1) TW.Var (AYm.spl n) q) X (xpt X c)) ((RI.E.Lg RI.gIn q).nfun X tt c) = split {
  var v -> lk2w X c (AYm.spl n v) ;
  cst r -> refl (SP.cV r X) ;
  sumE p q | rp rq -> transH (apH {EG.GV X} {EG.GV X} (\ w -> SP.OP.addV X w (TW.ev (SX.Rel[R].rename (SX.Fin RI.yu.1) TW.Var (AYm.spl n) q) X (xpt X c))) rp)
    (apH {EG.GV X} {EG.GV X} (SP.OP.addV X ((RI.E.Lg RI.gIn p).nfun X tt c)) rq) ;
  mulE p q | rp rq -> transH (apH {EG.GV X} {EG.GV X} (\ w -> SP.OP.mulV X w (TW.ev (SX.Rel[R].rename (SX.Fin RI.yu.1) TW.Var (AYm.spl n) q) X (xpt X c))) rp)
    (apH {EG.GV X} {EG.GV X} (SP.OP.mulV X ((RI.E.Lg RI.gIn p).nfun X tt c)) rq) } ;
 -- naturality of the point
 ptEN (J I : EG.Ob) (f : EG.Hm J I) (bI : V1.Ix ((EG.Gk k).ob I)) (bJ : V1.Ix ((EG.Gk k).ob J)) (hb : Id (V1.Ix ((EG.Gk k).ob J)) ((EG.Gk k).act J I f bI) bJ)
  : (j : Nat) (fI : SX.Fin j -> EG.GV I) (fJ : SX.Fin j -> EG.GV J) (h : (v : SX.Fin j) -> Id (EG.GV J) (EG.rsG J I f (fI v)) (fJ v))
   -> Id (V1.Ix ((EG.PW.Ext (EG.Gk k) j).ob J)) ((EG.PW.Ext (EG.Gk k) j).act J I f (ptE I bI j fI)) (ptE J bJ j fJ) = split {
  zero -> \ fI fJ h -> hb ;
  suc j | r -> \ fI fJ h ->
   transH (apH {V1.Ix ((EG.PW.Ext (EG.Gk k) j).ob J)} {V1.Ix ((EG.PW.Ext (EG.Gk k) (suc j)).ob J)}
             (\ x2 -> (x2, ((EG.PW.Ext (EG.Gk k) (suc j)).act J I f (ptE I bI (suc j) fI)).2))
             (r (\ v -> fI (inl v)) (\ v -> fJ (inl v)) (\ v -> h (inl v))))
    (apH {EG.GV J} {V1.Ix ((EG.PW.Ext (EG.Gk k) (suc j)).ob J)} (\ a2 -> (ptE J bJ j (\ v -> fJ (inl v)), a2))
      (transH (EG.PS.tact-irr EG.Nl EG.GB.GT J I f tt tt
                 (EG.PS.ntEq (EG.PW.Ext (EG.Gk k) j) EG.Nl (EG.C.eps (EG.PW.Ext (EG.Gk k) j)) J I f (ptE I bI j (\ v -> fI (inl v))) ((EG.PW.Ext (EG.Gk k) j).act J I f (ptE I bI j (\ v -> fI (inl v)))) (refl ((EG.PW.Ext (EG.Gk k) j).act J I f (ptE I bI j (\ v -> fI (inl v))))))
                 (refl tt) (fI (inr tt)))
        (h (inr tt)))) } ;
 -- the point map yo(y.u) -> Vc (over the terminal context, as K = P1.XT)
 K : EG.C.Ctx = Tu.G1.GB.GPre[a+].PS.extP Tu.P1 Tu.XT ;
 sgN (X : EG.Ob) (z : V1.Ix (K.ob X)) : V1.Ix (TW.Vc.ob X) = xpt X z.2 ;
 sgNat (J I : EG.Ob) (f : EG.Hm J I) (z : V1.Ix (K.ob I)) : Id (V1.Ix (TW.Vc.ob J)) (sgN J (K.act J I f z)) (TW.Vc.act J I f (sgN I z)) =
  symH (ptEN J I f (base I z.2) (base J (K.act J I f z).2)
    (transH (symH (AYm.G.gY.nt-nat J I f (preU.nfun I tt z.2)))
      (apH {V1.Ix (AYm.G.PYy.ob J)} {V1.Ix ((EG.Gk k).ob J)} (AYm.G.gYn J) (preU.nnat J I f tt tt (refl tt) z.2)))
    n (nv I z.2) (nv J (K.act J I f z).2) (\ v -> (Tu.Rs (var (RI.newpos n v))).nnat J I f tt tt (refl tt) z.2)) ;
} ;
