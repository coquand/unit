-- Proposition 13 applied to the F3 comparison.  The sole premise is its
-- levelwise equivalence; no strict inverse of the Yoneda comparison is used.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module D3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module C3 = CF3P13[a].Cmp3[R, encK, pe] ;
  module P13 = CTotP13o[a, a+, a+].P13[C3.CM.IC, C3.CT.T1, C3.O3.Y1T, C3.O111.Y1T, C3.cmpF] ;
  LevelEq : U a++ = P13.G0.GB.CEquiv[a+].EquivOp P13.PD.UG P13.PD.UA P13.PD.UB P13.PD.Uf ;
  module At (eq : LevelEq) {
    dcmp : P13.G1.GB.CEquiv[a+].EquivOp P13.DF.DG P13.DF.DA.DTy P13.DF.DB.DTy P13.DF.Df =
      P13.prop13 eq ;
  } ;
} ;
