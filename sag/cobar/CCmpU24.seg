-- CCmpU24.seg (canonicity-c2; (K) for cmpI, part 24): (U) on classes, by
-- recursion on terms of F2, and extensionality over nil.H (ext1H).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module U24 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module U23m = CCmpU23[a].U23[R, encK, pe, y] ;
 module U20m = U23m.U20m ;
 module U15m = CCmpU15[a].U15[R, encK, pe, y] ;
 module U13m = U20m.U13m ;
 module HZ = U20m.HZ ;
 module AS = HZ.AS ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = U20m.GH ;
 QYh : C.Ty GH = U20m.QYh ;
 IdZ (c : C.El Nl U20m.QA) : C.Ty GH = U20m.IdZ c ;
 hv2 : (u : Top) -> C.El GH (IdZ (AS.AX.cls (var (inr u)))) = split { tt -> U15m.h2 } ;
 hv1 : (u : Top) -> C.El GH (IdZ (AS.AX.cls (var (inl (inr u))))) = split { tt -> U15m.h1 } ;
 hv0 : (v : SX.Fin (suc zero)) -> C.El GH (IdZ (AS.AX.cls (var (inl v)))) = split {
  inl e -> absurd (C.El GH (IdZ (AS.AX.cls (var (inl (inl e)))))) e ;
  inr u -> hv1 u } ;
 hv : (v : SX.Fin (suc (suc zero))) -> C.El GH (IdZ (AS.AX.cls (var v))) = split { inl v1 -> hv0 v1 ; inr u -> hv2 u } ;
 h : (t : AS.AX.Term) -> C.El GH (IdZ (AS.AX.cls t)) = split {
  var v -> hv v ;
  cst r -> U23m.At[r].res ;
  sumE p q | rp rq -> U20m.Bin[AS.O.addQ, HZ.AT.O.addQ, U20m.dkA, U20m.dkAN, AS.AX.cls p, AS.AX.cls q, AS.AX.cls (sumE p q), AS.O.add-beta p q, rp, rq].res ;
  mulE p q | rp rq -> U20m.Bin[AS.O.mulQ, HZ.AT.O.mulQ, U20m.dkM, U20m.dkMN, AS.AX.cls p, AS.AX.cls q, AS.AX.cls (mulE p q), AS.O.mul-beta p q, rp, rq].res } ;
} ;
