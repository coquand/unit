-- CTotL12n.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part n: uniformity along total maps, and the
-- lemma.
--   KU.kunif   the extension at the restricted point and restricted side
--              is the restriction of the extension: level by level, the
--              Joins at the moved index and at the index agree (piece 0
--              by part e's Ext and D's index laws RR / oPath; the face
--              pieces by the previous level, fc-rx and fc-trCh)
--   lemma12    D of a levelwise trivial fibration is a trivial fibration
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;
module Ar = Arith[a] ;

module L12n (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LM = CTotL12m[a, vl, l].L12m[C, G, A] ;
 module LE = CTotL12e[a, vl, l].L12e[C, G, A] ;
 module LC = CTotL12c[a, vl, l].L12c[C, G, A] ;
 module LL = LM.LL ;
 module LA = LM.LA ;
 module LB = LM.LB ;
 module CL = CTotL12ch[a, vl].ChL[C] ;
 module TR = LA.TR ;
 module G0 = TR.G0 ;
 module G1 = TR.G1 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LL.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;
 UG : TR.P0.PCtx = LL.UG ;
 UA : TR.P0.PTy[UG] = LL.UA ;

 module KU (al : G0.GB.CPartial[l].ContrOp UG UA) (X' X : TC.TOb) (g : TC.THm X' X) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  gm' : W0.Ix (LA.DG.ob X') = LA.DG.act X' X g gm ;
  s' : LA.PD.Side[X', gm'] = LA.PD.rside X' X g gm s ;
  module MX = LM.Fm[al, X, gm, s] ;
  module MY = LM.Fm[al, X', gm', s'] ;
  module FX = MX.FL ;
  module FY = MY.FL ;
  module EX = LE.Fe[X, gm, s] ;
  module FCX = LC.Fc[X, gm, s] ;
  module FCY = LC.Fc[X', gm', s'] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  J0 : Ob = X'.1 ;
  y : Obj J0 = X'.2 ;
  u0 : Hom J0 I = g.1 ;
  g0 : VT.VMap J0 y (C.res J0 I u0 x) = VT.vpart J0 I u0 y x g.2 ;
  rqS (n : Nat) (W1 : Ob) (t : Obj W1) (sw : D.S J0 y n W1 t) : D.S I x n W1 t =
   (compH W1 J0 I u0 sw.1, CT.rxM W1 J0 I sw.1 u0 y x g0 n t sw.2) ;
  -- restriction then the moved index, as slices
  natP (n : Nat) (J : Ob) (u : Hom J J0) (z : Obj J) (c : CT.Ch J n (C.res J J0 u y) z) (W1 : Ob) (v : Hom W1 J)
   : Id (D.S I x n W1 (C.res W1 J v z))
       (compH W1 J I (compH J J0 I u0 u) v, DO.rCh W1 J I v (compH J J0 I u0 u) x n z (CT.rxM J J0 I u u0 y x g0 n z c))
       (compH W1 J0 I u0 (compH W1 J J0 u v), CT.rxM W1 J0 I (compH W1 J J0 u v) u0 y x g0 n (C.res W1 J v z) (DO.rCh W1 J J0 v u y n z c)) =
   D.sEq I x n W1 (C.res W1 J v z) (compH W1 J I (compH J J0 I u0 u) v) (compH W1 J0 I u0 (compH W1 J J0 u v)) (comp-assoc W1 J J0 I u0 u v)
    (DO.rCh W1 J I v (compH J J0 I u0 u) x n z (CT.rxM J J0 I u u0 y x g0 n z c))
    (CT.rxM W1 J0 I (compH W1 J J0 u v) u0 y x g0 n (C.res W1 J v z) (DO.rCh W1 J J0 v u y n z c))
    (CT.RR[W1, J, J0, I, v, u, u0, y, x, g0, n, z, c].law) ;

  -- piece 0 at the moved index and at the index
  module P0 (n : Nat) (J : Ob) (u : Hom J J0) (z : Obj J) (c : CT.Ch J n (C.res J J0 u y) z) (i : Wt.Pn n J) (W1 : Ob) (v : Hom W1 J)
    (lvX : PB.Lands W1 J (FCX.Q0[n, J, compH J J0 I u0 u, z, CT.rxM J J0 I u u0 y x g0 n z c, i].Q) v)
    (lvY : PB.Lands W1 J (FCY.Q0[n, J, u, z, c, i].Q) v) {
   module QX = FCX.Q0[n, J, compH J J0 I u0 u, z, CT.rxM J J0 I u u0 y x g0 n z c, i] ;
   module QY = FCY.Q0[n, J, u, z, c, i] ;
   uv : Hom W1 J0 = compH W1 J J0 u v ;
   rz : Obj W1 = C.res W1 J v z ;
   R : Wt.Pn n W1 = Wt.Res[n, W1, J, v, i].res ;
   Wv : TC.TOb = (W1, C.res W1 J0 uv y) ;
   fk : TC.THm Wv X' = TC.cartT W1 X' uv ;
   f : TC.THm Wv X = TC.tcomp Wv X' X g fk ;
   lfY : PB.Lands W1 J0 s'.pQ uv = PB.lands-pre W1 J J0 u s'.pQ v lvY ;
   lf : PB.Lands W1 I s.pQ f.1 = PB.lands-pre W1 J0 I u0 s.pQ uv lfY ;
   module CAY = CL.Cart[W1, J0, uv, y, n, rz, DO.rCh W1 J J0 v u y n z c] ;
   module EXT = EX.Ext[Wv, f, lf, n, W1, idH W1, rz, CAY.ch, R] ;
   cartP : Id (D.S J0 y n W1 rz) (compH W1 W1 J0 uv (idH W1), CT.rxM W1 W1 J0 (idH W1) uv (C.res W1 J0 uv y) y CAY.g0 n rz CAY.ch)
             (uv, DO.rCh W1 J J0 v u y n z c) =
    D.sEq J0 y n W1 rz (compH W1 W1 J0 uv (idH W1)) uv (comp-idr W1 J0 uv)
     (CT.rxM W1 W1 J0 (idH W1) uv (C.res W1 J0 uv y) y CAY.g0 n rz CAY.ch) (DO.rCh W1 J J0 v u y n z c) CAY.law ;
   oP : Id (D.S I x n W1 rz) (rqS n W1 rz (compH W1 W1 J0 uv (idH W1), CT.rxM W1 W1 J0 (idH W1) uv (C.res W1 J0 uv y) y CAY.g0 n rz CAY.ch))
          (compH W1 W1 I f.1 (idH W1), EXT.cc) =
    D.oPath W1 J0 I u0 uv (C.res W1 J0 uv y) y x g.2 (C.cart W1 J0 uv y) (n, W1, idH W1, rz, CAY.ch, R.1) ;
   sP : Id (D.S I x n W1 rz)
          (compH W1 J I (compH J J0 I u0 u) v, DO.rCh W1 J I v (compH J J0 I u0 u) x n z (CT.rxM J J0 I u u0 y x g0 n z c))
          (compH W1 W1 I f.1 (idH W1), EXT.cc) =
    transH (natP n J u z c W1 v)
     (transH (apH {D.S J0 y n W1 rz} {D.S I x n W1 rz} (\ sw -> rqS n W1 rz sw) (symH cartP)) oP) ;
   base : Id (DA.Ez W1 rz) (QX.vg W1 v rz (refl rz) lvX) (QY.vg W1 v rz (refl rz) lvY) =
    transH (FCX.rdS-eq n W1 rz
              (compH W1 J I (compH J J0 I u0 u) v, DO.rCh W1 J I v (compH J J0 I u0 u) x n z (CT.rxM J J0 I u u0 y x g0 n z c))
              (compH W1 W1 I f.1 (idH W1), EXT.cc) sP
              (PB.lands-pre W1 J I (compH J J0 I u0 u) s.pQ v lvX) EXT.lU R R (refl R))
     EXT.ext ;
   gen (y1 : Obj W1) (e : Id (Obj W1) rz y1) : Id (DA.Ez W1 y1) (QX.vg W1 v y1 e lvX) (QY.vg W1 v y1 e lvY) =
    idJ (Obj W1) rz (\ y2 e2 -> Id (DA.Ez W1 y2) (QX.vg W1 v y2 e2 lvX) (QY.vg W1 v y2 e2 lvY)) base y1 e ;
  } ;

  EQt (n : Nat) : U l = (J : Ob) (u : Hom J J0) (z : Obj J) (c : CT.Ch J n (C.res J J0 u y) z) (i : Wt.Pn n J)
   -> Id (DA.Ez J z) (FX.F.pzv n (MX.lv n) J (compH J J0 I u0 u) z (CT.rxM J J0 I u u0 y x g0 n z c) i) (FY.F.pzv n (MY.lv n) J u z c i) ;

  EQ0 : EQt zero = \ J u z c i ->
   ap (Py.Side[(J, z), FY.F.gpt zero J u z c i]) (DA.Ez J z)
    (\ S2 -> DA.prz J z (FY.F.gpt zero J u z c i) (al.kop (J, z) (FY.F.gpt zero J u z c i) S2))
    (FCX.Q0[zero, J, compH J J0 I u0 u, z, CT.rxM J J0 I u u0 y x g0 zero z c, i].side) (FCY.Q0[zero, J, u, z, c, i].side)
    (Py.side-ext (J, z) (FY.F.gpt zero J u z c i)
       (FCX.Q0[zero, J, compH J J0 I u0 u, z, CT.rxM J J0 I u u0 y x g0 zero z c, i].side) (FCY.Q0[zero, J, u, z, c, i].side)
       (symH (PB.pre-comp J J0 I u u0 s.pQ))
       (\ W h lw lw' -> P0[zero, J, u, z, c, i, W.1, h.1, lw, lw'].gen W.2 (symH h.2))) ;

  module SS (m : Nat) (ih : EQt m) (J : Ob) (u : Hom J J0) (z : Obj J) (c : CT.Ch J (suc m) (C.res J J0 u y) z) (i : Wt.Pn (suc m) J) {
   cX : CT.Ch J (suc m) (C.res J I (compH J J0 I u0 u) x) z = CT.rxM J J0 I u u0 y x g0 (suc m) z c ;
   module PX = FX.FK.PC[m, FX.build m, J, compH J J0 I u0 u, z, cX, i] ;
   module PY = FY.FK.PC[m, FY.build m, J, u, z, c, i] ;
   Y0 : Ob0 = (J, z) ;
   gp : W0.Ix (G.ob J z) = FY.F.gpt (suc m) J u z c i ;
   r : Nat = suc (suc (suc m)) ;
   qEq : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) -> Id (PB.Phi J) (PX.Sj j hj).pQ (PY.Sj j hj).pQ = split {
    zero -> \ hj -> symH (PB.pre-comp J J0 I u u0 s.pQ) ;
    suc k -> \ hj -> refl (PB.pre J PFO.ivO (i.1 (k, hj)) (PFO.ptSO PB.e0)) } ;
   -- the face pieces at the moved index and at the index
   module FQ (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (W1 : Ob) (v : Hom W1 J)
     (lh : PB.Lands W1 J (FX.FH.FP[m, FX.build m, J, compH J J0 I u0 u, z, cX, i, k, hk].Q) v)
     (lh' : PB.Lands W1 J (FY.FH.FP[m, FY.build m, J, u, z, c, i, k, hk].Q) v) {
    module FPX = FX.FH.FP[m, FX.build m, J, compH J J0 I u0 u, z, cX, i, k, hk] ;
    module FPY = FY.FH.FP[m, FY.build m, J, u, z, c, i, k, hk] ;
    module K = DO.KJ[W1].K ;
    uv : Hom W1 J0 = compH W1 J J0 u v ;
    rz : Obj W1 = C.res W1 J v z ;
    cY : CT.Ch W1 (suc m) (C.res W1 J0 uv y) rz = DO.rCh W1 J J0 v u y (suc m) z c ;
    pw : Wt.Pn m W1 = FPY.pw W1 v lh' ;
    pwE : Id (Wt.Pn m W1) (FPX.pw W1 v lh) pw =
     Sigma-eq (Wt.Coords m W1) (\ cs -> PB.Lands W1 W1 (Wt.oneS m W1 cs) (PB.idH W1))
      (FPX.pw W1 v lh).1 pw.1 (FPX.pw W1 v lh).2 pw.2 (refl pw.1)
      (PB.isProp-Lands W1 W1 (Wt.oneS m W1 pw.1) (PB.idH W1)) ;
    X0' : Obj W1 = C.res W1 J0 uv (C.res J0 I u0 x) ;
    X1 : Obj W1 = C.res W1 I (compH W1 J0 I u0 uv) x ;
    pX : Id (Obj W1) X0' X1 = symH (C.res-comp W1 J0 I u0 uv x) ;
    hm : VT.VMap W1 (C.res W1 J0 uv y) X0' = VT.rmap W1 J0 uv y (C.res J0 I u0 x) g0 ;
    D0 : K.DR m (C.res W1 J0 uv y) rz = K.fc m k (C.res W1 J0 uv y) rz cY ;
    FcM : Id (K.DR m X1 rz) (K.fc m k X1 rz (CT.rxM W1 J0 I uv u0 y x g0 (suc m) rz cY))
            (D0.1, CT.rxM W1 J0 I uv u0 y x g0 m D0.1 D0.2.1, D0.2.2) =
     transH (CL.fc-trCh W1 m k X0' X1 pX rz (K.rx (suc m) (C.res W1 J0 uv y) X0' hm rz cY))
      (apH {K.DR m X0' rz} {K.DR m X1 rz} (\ E2 -> (E2.1, CT.trCh W1 m X0' X1 pX E2.1 E2.2.1, E2.2.2))
         (CTotL12ch[a, vl].CRx[VT.VCat W1].fc-rx m k (C.res W1 J0 uv y) X0' hm rz cY)) ;
    base : Id (DA.Ez W1 rz) (FPX.vg W1 v rz (refl rz) lh) (FPY.vg W1 v rz (refl rz) lh') =
     transH (apH {Wt.Pn m W1} {DA.Ez W1 rz}
               (\ q -> FPX.PH.phi W1 (compH W1 J I (compH J J0 I u0 u) v) rz (DO.rCh W1 J I v (compH J J0 I u0 u) x (suc m) z cX) q) pwE)
      (transH (apH {D.S I x (suc m) W1 rz} {DA.Ez W1 rz} (\ sw -> FPX.PH.phi W1 sw.1 rz sw.2 pw) (natP (suc m) J u z c W1 v))
        (transH (apH {K.DR m X1 rz} {DA.Ez W1 rz} (\ E2 -> FPX.PH.phiD W1 (compH W1 J0 I u0 uv) rz E2 pw) FcM)
          (ap (DA.Ez W1 D0.1) (DA.Ez W1 rz) (\ q -> DA.E.act (W1, rz) (W1, D0.1) (idH W1, D0.2.2) q)
             (FX.F.pzv m (MX.lv m) W1 (compH W1 J0 I u0 uv) D0.1 (CT.rxM W1 J0 I uv u0 y x g0 m D0.1 D0.2.1) pw)
             (FY.F.pzv m (MY.lv m) W1 uv D0.1 D0.2.1 pw)
             (ih W1 uv D0.1 D0.2.1 pw)))) ;
    gen (y1 : Obj W1) (e : Id (Obj W1) rz y1) : Id (DA.Ez W1 y1) (FPX.vg W1 v y1 e lh) (FPY.vg W1 v y1 e lh') =
     idJ (Obj W1) rz (\ y2 e2 -> Id (DA.Ez W1 y2) (FPX.vg W1 v y2 e2 lh) (FPY.vg W1 v y2 e2 lh')) base y1 e ;
   } ;
   ppv : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) (W : Ob0) (f : TR.RN.Hom0 W Y0)
    (L : PB.Lands W.1 J (PX.Sj j hj).pQ f.1) (L' : PB.Lands W.1 J (PY.Sj j hj).pQ f.1)
    -> Id (DA.Ez W.1 W.2) ((PX.Sj j hj).pv W f L) ((PY.Sj j hj).pv W f L') = split {
    zero -> \ hj W f L L' -> P0[suc m, J, u, z, c, i, W.1, f.1, L, L'].gen W.2 (symH f.2) ;
    suc k -> \ hj W f L L' -> FQ[k, hj, W.1, f.1, L, L'].gen W.2 (symH f.2) } ;
   eQ : Id (PB.Phi J) PX.JN.Q PY.JN.Q =
    apH {Ar.Fin r -> PB.Phi J} {PB.Phi J} (\ Qf -> PB.bigU J r Qf)
     (funext (Ar.Fin r) (\ j -> PB.Phi J) PX.JN.Qs PY.JN.Qs (\ j -> qEq j.1 j.2)) ;
   module EV (W : Ob0) (f : TR.RN.Hom0 W Y0) (lw : PB.Lands W.1 J PX.JN.Q f.1) (lw' : PB.Lands W.1 J PY.JN.Q f.1) {
    o : Ar.Fin r = (PB.bigU-out W.1 J r PY.JN.Qs f.1 lw').1 ;
    lo : PB.Lands W.1 J (PY.JN.Qs o) f.1 = (PB.bigU-out W.1 J r PY.JN.Qs f.1 lw').2 ;
    L : PB.Lands W.1 J (PX.JN.Qs o) f.1 = subst (PB.Phi J) (\ Q' -> PB.Lands W.1 J Q' f.1) (PY.JN.Qs o) (PX.JN.Qs o) (symH (qEq o.1 o.2)) lo ;
    res : Id (DA.Ez W.1 W.2) (PX.JN.side.pv W f lw) (PY.JN.side.pv W f lw') =
     transH (PX.JN.pv-in o W f L lw) (transH (ppv o.1 o.2 W f L lo) (symH (PY.JN.pv-in o W f lo lw'))) ;
   } ;
   res : Id (DA.Ez J z) (FX.F.pzv (suc m) (MX.lv (suc m)) J (compH J J0 I u0 u) z cX i) (FY.F.pzv (suc m) (MY.lv (suc m)) J u z c i) =
    ap (Py.Side[Y0, gp]) (DA.Ez J z) (\ S2 -> DA.prz J z gp (al.kop Y0 gp S2)) PX.JN.side PY.JN.side
     (Py.side-ext Y0 gp PX.JN.side PY.JN.side eQ (\ W f lw lw' -> EV[W, f, lw, lw'].res)) ;
  } ;

  EQ : (n : Nat) -> EQt n = split {
   zero -> EQ0 ;
   suc m | ih -> \ J u z c i -> SS[m, ih, J, u, z, c, i].res } ;

  kunif : Id (LM.Tot X') (LB.EE.act X' X g MX.t0) MY.t0 =
   LM.totEq X' (LB.EE.act X' X g MX.t0) MY.t0 (refl gm')
    (\ q lq -> transH (LB.actRd X' X g MX.t0 q lq) (EQ q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1 (q.2.2.2.2.2, lq))) ;
 } ;

 -- LEMMA 12 (trivial half) at the total site
 lemma12 (al : G0.GB.CPartial[l].ContrOp (TR.RS.rC (TC.toP G)) (TR.RS.rT (TC.toP G) A))
  : G1.GB.CPartial[l].ContrOp (TC.toP D.DCtx) DA.DTy =
  G1.GB.CPartial[l].Rel[LA.DG, DA.DTy, DA.DTy, G1.GB.CPartial[l].pmap-id LA.DG DA.DTy].mkRC
   (\ X gm s -> LM.Fm[al, X, gm, s].kop)
   (\ X gm s W f lf -> LM.Fm[al, X, gm, s].kside W f lf)
   (\ Y X h gm s -> KU[al, Y, X, h, gm, s].kunif) ;
} ;
