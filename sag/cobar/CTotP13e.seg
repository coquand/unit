-- CTotP13e.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part e: Psi on the homotopy fibre of D f, value by value.  For v =
-- ((d, b'), a', L) (a line L of D G . D B over the constant line at d from
-- D f a' to b') and an index q: the point of G.B is c2's pairing of (d, b')
-- at q, the element of A is a' at q, and the path is psi_q of the paired
-- line (Psi at the context G.B), with
--   tp   its base is the constant line at d_q (CTotP13c: Psi of the
--        constant line at d, the base of L being that line)
--   t0   its end at 0 is f (a'_q) (c2's end lemma at G.B, D f's values)
--   t1   its end at 1 is (d_q, b'_q) (the end lemma)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13e (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PB13 = CTotP13b[a, vl, l].P13b[C, G, A, B, f] ;
 module DF = PB13.DF ;
 module TR = PB13.TR ;
 module G1 = TR.G1 ;
 module TC = PB13.TC ;
 module DO = DF.DO ;
 module CT = DO.CT ;
 module H = PB13.H ;
 module HD = PB13.HD ;
 module CG = CTotP13c[a, vl, l].ConstL[C, G] ;
 module P2 = CG.P2 ;
 module PO = P2.PO ;
 module PR = CTotPsi11[a, vl, l].Psi11[C, G, G1.GB.e0].Pair[B] ;
 ET : CTPsh[a, vl, l].TPshOf[C].TCtx = PR.ET ;
 module Q2E = CTotPsi2[a, vl, l].Psi2[C, ET] ;
 module E0 = CTotPsi11[a, vl, l].Psi11[C, ET, G1.GB.e0] ;
 module E1 = CTotPsi11[a, vl, l].Psi11[C, ET, G1.GB.e1] ;
 module FTd = G1.GB.CLine[l].FT[PO.DG, DF.DB.DTy] ;
 module FTg = G1.GB.CLine[l].FT[PO.GP, B] ;
 module FCg = G1.GB.CLine[l].FC[PO.GP] ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;

 module MS (X : TC.TOb) (v : HD.TF.EI X) {
  w : HD.TA.EI X = HD.TF.pr1 X v ;
  d : DF.D.Ob' X.1 X.2 = HD.TA.pr1 X w ;
  a' : DF.DA.TOb' X.1 X.2 d = (HD.TF.pr2 X v).1 ;
  L : W0.Ix (FTd.FE.ob X) = (HD.TF.pr2 X v).2.1 ;
  lE : W0.Ix (PR.FDE.ob X) = PR.phiL X L ;
  pt : PR.DE.Ob' X.1 X.2 = PR.phi X w ;
  -- the base of L is the constant line at d
  baseL : Id (W0.Ix (PO.FL.ob X)) (FTd.piL X L) CG.At[X, d].ln =
   PO.FL.fam-eq X (FTd.piL X L) CG.At[X, d].ln (\ W k j -> HD.fibL-pt X v W k j) ;
  module PQ (n : Nat) (J : Ob) (u : Hom J X.1) (z : Obj J) (c : CT.Ch J n (C.res J X.1 u X.2) z) (i : Wt.Pn n J) {
   module QE = Q2E.PQ[X, lE, n, J, u, z, c, i] ;
   module CQ = CG.At[X, d].Q[n, J, u, z, c, i] ;
   Y : TC.TOb = (J, z) ;
   q : DO.Idx X.1 X.2 = (n, J, u, z, c, i.1) ;
   psiE : W0.Ix (FTg.FE.ob Y) = QE.psiq ;
   pq : W0.Ix (H.EA.ob Y) = pt.1 q i.2 ;
   aq : W0.Ix (A.tob Y (d.1 q i.2)) = a'.1 q i.2 ;
   -- the base
   lnEq : Id (W0.Ix (FCg.ob Y)) (FTg.piL Y psiE) CQ.cl =
    transH (FCg.fam-eq Y (FTg.piL Y psiE) (P2.PQ[X, FTd.piL X L, n, J, u, z, c, i].psiq) (\ W k j -> refl ((FTg.piL Y psiE).1 W k j)))
     (transH (apH {W0.Ix (PO.FL.ob X)} {W0.Ix (FCg.ob Y)} (\ ln' -> P2.PQ[X, ln', n, J, u, z, c, i].psiq) baseL) CQ.psiC) ;
   tp (W : TC.TOb) (k : TC.THm W Y) (j : PB.IvP W.1) : Id (W0.Ix (PO.GP.ob W)) (H.TA.pr1 W (psiE.1 W k j)) (PO.GP.act W Y k (d.1 q i.2)) =
    apH {W0.Ix (FCg.ob Y)} {W0.Ix (PO.GP.ob W)} (\ M -> M.1 W k j) lnEq ;
   -- the ends
   t0 : Id (H.TA.EI Y) (psiE.1 Y (TC.tid Y) (G1.GB.ptH Y G1.GB.e0)) (f.mE Y (H.TB.pr Y (d.1 q i.2) aq)) =
    transH (symH E0.EP[X, lE].EQ[n, J, u, z, c, i].Pq)
     (transH (apH {HD.TA.EI X} {H.TA.EI Y} (\ T -> (PR.phi X T).1 q i.2) (HD.fibL-0 X v))
       (DF.DM[X.1, X.2, d, a'].pc q i.2)) ;
   t1 : Id (H.TA.EI Y) (psiE.1 Y (TC.tid Y) (G1.GB.ptH Y G1.GB.e1)) pq =
    transH (symH E1.EP[X, lE].EQ[n, J, u, z, c, i].Pq)
     (apH {HD.TA.EI X} {H.TA.EI Y} (\ T -> (PR.phi X T).1 q i.2) (HD.fibL-1 X v)) ;
   path : W0.Ix (H.PE.tobP Y (H.TAB.pr Y pq aq)) =
    H.PE.mkPath Y (H.TAB.pr Y pq aq) (\ W k j -> psiE.1 W k j) (\ V W g k j -> psiE.2 V W g k j) tp t0 t1 ;
   fib : W0.Ix (PB13.Pt.tob Y pq) = (aq, path) ;
  } ;
 } ;
} ;
