-- CTotDProp1.seg (canonicity-c2; SIMPLIFIED.md, "D preserves
-- propositions", part 1): the type A weakened over the context G.A at the
-- total site (A1, over toP (ofP (G.A))), and the triple lemma: two pair
-- paths (g , a) = (g' , a') and (g , b) = (g' , b') give the triple path
-- ((g , a) , b) = ((g' , a') , b') (J on the first; pairE-inj at refl).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module DP1 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module P = Presheaf[vl, l].Psh[TC.TotCat] ;
 GP : P.PCtx = TC.toP G ;
 E : P.PCtx = P.extP GP A ;
 ET : CTPsh[a, vl, l].TPshOf[C].TCtx = TC.ofP E ;
 EP : P.PCtx = TC.toP ET ;
 -- A over G.A (its own variable is not used)
 fp (Z : TC.TOb) (v v' : W0.Ix (E.ob Z)) (e : Id (W0.Ix (E.ob Z)) v v') : Id (W0.Ix (GP.ob Z)) v.1 v'.1 =
  apH {W0.Ix (E.ob Z)} {W0.Ix (GP.ob Z)} (\ u -> u.1) e ;
 A1 : P.PTy[EP] = P.mkTy EP (\ X w -> A.tob X w.1)
   (\ Z X f w w' e b -> A.tact Z X f w.1 w'.1 (fp Z (E.act Z X f w) w' e) b)
   (\ X w e b -> A.tact-id X w.1 (fp X (E.act X X (TC.tid X) w) w e) b)
   (\ K J I f g x y z e1 e2 e3 b -> A.tact-o K J I f g x.1 y.1 z.1 (fp J (E.act J I f x) y e1) (fp K (E.act K J g y) z e2) (fp K (E.act K I (TC.tcomp K J I f g) x) z e3) b) ;
 E1 : P.PCtx = P.extP EP A1 ;
 -- the triple lemma
 triple (J : TC.TOb) (g g' : W0.Ix (GP.ob J)) (av : W0.Ix (A.tob J g)) (av' : W0.Ix (A.tob J g'))
   (b : W0.Ix (A.tob J g)) (b' : W0.Ix (A.tob J g'))
   (p : Id (P.SigT GP A J) (P.pairE GP A J g av) (P.pairE GP A J g' av')) (q : Id (P.SigT GP A J) (P.pairE GP A J g b) (P.pairE GP A J g' b'))
   : Id (P.SigT EP A1 J) (P.pairE EP A1 J (g, av) b) (P.pairE EP A1 J (g', av') b') =
  idJ (P.SigT GP A J) (P.pairE GP A J g av)
    (\ w2 p2 -> (b2 : W0.Ix (A.tob J w2.1)) -> Id (P.SigT GP A J) (P.pairE GP A J g b) (P.pairE GP A J w2.1 b2)
        -> Id (P.SigT EP A1 J) (P.pairE EP A1 J (g, av) b) (P.pairE EP A1 J w2 b2))
    (\ b2 q2 -> apH {W0.Ix (A.tob J g)} {P.SigT EP A1 J} (\ c -> P.pairE EP A1 J (g, av) c) (P.pairE-inj GP A J g b b2 q2))
    (g', av') p b' q ;
 tripleE (J : TC.TOb) (x y : P.SigT GP A J) (bx : W0.Ix (A.tob J x.1)) (by : W0.Ix (A.tob J y.1))
   (p : Id (P.SigT GP A J) x y) (q : Id (P.SigT GP A J) (P.pairE GP A J x.1 bx) (P.pairE GP A J y.1 by))
   : Id (P.SigT EP A1 J) (P.pairE EP A1 J x bx) (P.pairE EP A1 J y by) =
  idJ (P.SigT GP A J) x
    (\ w2 p2 -> (b2 : W0.Ix (A.tob J w2.1)) -> Id (P.SigT GP A J) (P.pairE GP A J x.1 bx) (P.pairE GP A J w2.1 b2)
        -> Id (P.SigT EP A1 J) (P.pairE EP A1 J x bx) (P.pairE EP A1 J w2 b2))
    (\ b2 q2 -> apH {W0.Ix (A.tob J x.1)} {P.SigT EP A1 J} (\ c -> P.pairE EP A1 J x c) (P.pairE-inj GP A J x.1 bx b2 q2))
    y p by q ;
 -- the D side
 module DA = CobarIT[a, vl, l].DTI[C, G, A] ;
 module D = DA.D ;
 module DA1 = CobarIT[a, vl, l].DTI[C, ET, A1] ;
 module PS = CTotPsi11[a, vl, l].Psi11[C, G, CTotR[a, vl, l].TotR[C].G1.GB.src true] ;
 module PR = PS.Pair[A] ;
 module MS (I : Ob) (x : DA.Obj I) (t : W0.Ix (PR.Ext.ob (I, x))) (s : DA.TOb' I x t.1) {
  d : DA1.D.Ob' I x = PR.phi (I, x) t ;
  anat' : W0.Ix (DA1.anatEq I x d s.1) = \ r lq ->
   tripleE (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (DA.anatL I x t.1 t.2.1 r lq) (DA.anatR I x t.1 t.2.1 r lq)
     (DA.anatL I x t.1 s.1 r lq).2 (DA.anatR I x t.1 s.1 r lq).2 (t.2.2.1 r lq) (s.2.1 r lq) ;
  aface' : W0.Ix (DA1.afaceEq I x d s.1) = \ r lq ->
   tripleE (r.2.2.2.1, r.2.2.2.2.2.1) (DA.afaceL I x t.1 t.2.1 r lq) (DA.afaceR I x t.1 t.2.1 r lq)
     (DA.afaceL I x t.1 s.1 r lq).2 (DA.afaceR I x t.1 s.1 r lq).2 (t.2.2.2.1 r lq) (s.2.2.1 r lq) ;
  atop' : W0.Ix (DA1.atopEq I x d s.1) = \ r lq ->
   tripleE (r.2.1, r.2.2.2.1) (DA.atopL I x t.1 t.2.1 r lq) (DA.atopR I x t.1 t.2.1 r lq)
     (DA.atopL I x t.1 s.1 r lq).2 (DA.atopR I x t.1 s.1 r lq).2 (t.2.2.2.2 r lq) (s.2.2.2 r lq) ;
  res : DA1.TOb' I x d = (s.1, anat', aface', atop') ;
 } ;
} ;
