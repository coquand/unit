-- CRhoOld.seg (canonicity-45; COBAR.md "Prop 58"): for an old generator i of
-- y, at the total site over yo(y.u): tau . pre_(x_i) . pre_(p_u) ~ tau . pre_(x_(emb i))
-- (associativity of codes, then CCodeH: p_u (x_i (cls x)) = cls (var (emb i))
-- by the betas of x_i and p_u).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;

module RO (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (i : SX.Fin y.1) {
 yu : SX.Over[R].Presentation = SX.Rel[R].concat y u ;
 module Ty = CE1Tot[a].T1[R, encK, pe, y] ;
 module Tu = CE1Tot[a].T1[R, encK, pe, yu] ;
 module CM = Tu.CM ;
 module HO1 = Tu.HO1 ;
 module PU' = CM.II.PuC[y, u] ;
 module KI = Ty.KS[var i] ;
 ei : SX.Fin yu.1 = SX.emb y.1 u.1 i ;
 module KB = Tu.KS[var ei] ;
 module KC = CCompC[a].CC2[R, encK, pe, y, CM.F1, yu, KI.S.M.mor, KI.S.M.mor-nat, PU'.M.mor, PU'.M.mor-nat] ;
 -- pre_(p_u) as a map yo(y.u) -> yo(y)
 preU : HO1.NMap[Tu.P1, Tu.XT, Ty.XT] = Tu.PreN[yu, y, PU'.M.mor, PU'.M.mor-nat].nm ;
 gOld : HO1.NMap[Tu.P1, Tu.XT, Tu.GT] = HO1.compN Tu.P1 Tu.XT Ty.XT Tu.GT preU (Ty.Rs (var i)) ;
 assoc (K : Ob) (x : SX.Over[R].Presentation) (c : CM.MO.Fn[yu, x].M K)
  : Id (CM.MO.Fn[CM.F1, x].M K) (CM.Pre[y, CM.F1, KI.S.M.mor, KI.S.M.mor-nat].pre K x (CM.Pre[yu, y, PU'.M.mor, PU'.M.mor-nat].pre K x c)) (CM.Pre[yu, CM.F1, KC.c, KC.cn].pre K x c) =
  symH (transH (apH {(w : Hom K K) * CM.MO.Fn[CM.F1, x].M K} {CM.MO.Fn[CM.F1, x].M K} (\ p -> p.2)
                  (CM.CO.As[K, K, K, K, idH K, idH K, idH K, x, yu, y, CM.F1, KI.S.M.mor K, PU'.M.mor K, c].law))
    (apH {Hom K K} {CM.MO.Fn[CM.F1, x].M K} (\ hh -> CM.CO.cmpM K K K hh x y CM.F1 (KI.S.M.mor K) (CM.CO.cmpM K K K (idH K) x yu y (PU'.M.mor K) c)) (comp-idl K K (idH K)))) ;
 aK : HO1.NMap[Tu.P1, Tu.XT, Tu.GT] = Tu.aC KC.c KC.cn ;
 -- gOld and tau . pre_(p_u . x_i) agree pointwise
 pa (X : Tu.CT.TC.TOb) (o : V1.Ix (Tu.P1.ob X)) (c : V1.Ix (Tu.XT.tob X o)) : Id (V1.Ix (Tu.GT.tob X o)) (gOld.nfun X o c) (aK.nfun X o c) =
  apH {CM.MO.Fn[CM.F1, X.2].M X.1} {Tu.C6.Q1.DY.Ob' X.1 X.2} (Tu.C6.Q1.DY.tau X.1 X.2) (assoc X.1 X.2 c) ;
 -- the code step
 module GO = CCodeH[a].GenOf[R, encK, pe, yu, KC.c, KC.cn, KB.S.M.mor, KB.S.M.mor-nat] ;
 Nl : FibCwF[a, a+].fibCwF.Ctx = FibCwF[a, a+].fibCwF.nil ;
 Q1 : FibCwF[a, a+].fibCwF.Ty Nl = CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt ;
 Qy : FibCwF[a, a+].fibCwF.Ty Nl = CHomT3[a].HomP[R, encK, pe].Alg[y].Qt ;
 Qt : FibCwF[a, a+].fibCwF.Ty Nl = GO.QY ;
 cx : FibCwF[a, a+].fibCwF.El Nl Q1 = CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].AX.cls (var (inr tt)) ;
 c0 : FibCwF[a, a+].fibCwF.El Nl Qy = OV.app Nl Q1 Qy KI.S.SM.Phi cx ;
 Ea : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Qy Qt PU'.PM.Phi c0 ;
 Eb : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q1 Qt KB.S.SM.Phi cx ;
 mid : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Qy Qt PU'.PM.Phi (CHomT3[a].HomP[R, encK, pe].Alg[y].AX.cls (var i)) ;
 cs : FibCwF[a, a+].fibCwF.El Nl Qt = CHomT3[a].HomP[R, encK, pe].Alg[yu].AX.cls (var ei) ;
 E : FibCwF[a, a+].fibCwF.El Nl (IJ.IdT Nl Qt Ea Eb) =
  PT.transM Nl Qt Ea mid Eb (PT.apM Nl Qy Qt (OV.bod Nl Qy (OV.wkT Nl Qy Qt) PU'.PM.Phi) c0 (CHomT3[a].HomP[R, encK, pe].Alg[y].AX.cls (var i)) (KI.S.SM.beta (var (inr tt))))
   (PT.transM Nl Qt mid cs Eb (PU'.PM.beta (var i)) (PT.symM Nl Qt Eb cs (KB.S.SM.beta (var (inr tt))))) ;
 ra (K : Ob) : Id (V1.Ix (Qt.1.tob K tt)) (Ea.eob K tt) (GO.fa K) =
  transH (CAppRd[a].App0[Qy, Qt, PU'.PM.Phi, c0].rd K tt)
   (apH {V1.Ix (Qy.1.tob K tt)} {V1.Ix (Qt.1.tob K tt)} (\ v -> (PU'.PM.Phi.eob K tt).1 K (idH K) v)
     (transH (CAppRd[a].App0[Q1, Qy, KI.S.SM.Phi, cx].rd K tt)
       (apH {Hom K K} {V1.Ix (Qy.1.tob K tt)} (\ f -> (KI.S.SM.Phi.eob K tt).1 K f (cx.eob K tt)) (symH (comp-idl K K (idH K)))))) ;
 rb (K : Ob) : Id (V1.Ix (Qt.1.tob K tt)) (Eb.eob K tt) (GO.fb K) = CAppRd[a].App0[Q1, Qt, KB.S.SM.Phi, cx].rd K tt ;
 module G = GO.At[Ea, Eb, E, ra, rb] ;
 module H1 = HO1.Ret[Tu.P1, Tu.XT, Tu.GT, HO1.compN Tu.P1 Tu.XT Tu.C6.Q1.Y1T Tu.GT G.H.PLm.mA G.H.tauN, HO1.compN Tu.P1 Tu.XT Tu.C6.Q1.Y1T Tu.GT G.H.PLm.mB G.H.tauN,
   gOld, Tu.Rs (var ei), pa, \ X o c -> refl ((Tu.Rs (var ei)).nfun X o c), G.H.res] ;
 -- tau . pre_(x_i) . pre_(p_u) ~ tau . pre_(x_(emb i))
 res : Tu.G1.GB.GPre[a+].PS.PEl[Tu.G1.GB.GPre[a+].PS.extP Tu.P1 Tu.XT, HO1.HT[Tu.P1, Tu.XT, Tu.GT, gOld, Tu.Rs (var ei)].PT.PathP] = H1.res ;
} ;
