-- CTotElim3.seg (canonicity-c2; towards (c), the eliminator of Tr): the
-- levelwise data. Over Delta = U (G.Tr A), the truncation T' of U A
-- pulled back to Delta, and the family B = U P weakened over Delta.T',
-- a proposition in the sense of the truncation's eliminator (its
-- contraction through GCLocBoundContr.Connect).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module EL3 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G))
  (P : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotR[a, vl, l].TotR[C].G1.fibCwF-T.ext (CTotCat[a, vl, l].TotOf[C].toP G) (CTotTr[a, vl, l].TotTr[C].Tr[CTotCat[a, vl, l].TotOf[C].toP G, A].Tr))) {
 module E2 = CTotElim2[a, vl, l].EL2[C, G, A] ;
 module TR = E2.TR ;
 module G0 = TR.G0 ;
 module G1 = TR.G1 ;
 module P0 = TR.P0 ;
 module TT = E2.TT ;
 module U4 = CTotUFib4[a, vl, l].UFib4[C] ;
 module UP3m = CTotUProp3[a, vl, l].UP3[C, E2.GT, P] ;
 module PN0 = UP3m.PN0 ;
 module PN1 = UP3m.PN1 ;
 Dl : G0.fibCwF-T.Ctx = UP3m.UG ;
 UPd : G0.fibCwF-T.Ty Dl = UP3m.UA ;
 pi : G0.fibCwF-T.Sub Dl TT.UG = TR.RS.rS E2.GT E2.GP (TR.P1.pP E2.GP E2.Tr.1) ;
 module CM = CTotElim1[a, vl, l].CmpOf[C, Dl, TT.UG, pi, TT.UA] ;
 Tp : G0.fibCwF-T.Ty Dl = CM.TO'.Tr0 ;
 DT : G0.fibCwF-T.Ctx = G0.fibCwF-T.ext Dl Tp ;
 B : G0.fibCwF-T.Ty DT = G0.fibCwF-T.subT DT Dl UPd (G0.fibCwF-T.p Dl Tp) ;
 module At (pP : G1.fibCwF-T.El E2.GT (PN1.isProp E2.GT P)) {
  pU : G0.fibCwF-T.El Dl (PN0.isProp Dl UPd) = UP3m.At[pP].isPropU ;
  pB : G0.fibCwF-T.El DT (PN0.isProp DT B) = PN0.wkProp Dl Tp UPd pU ;
  DB : G0.fibCwF-T.Ctx = G0.fibCwF-T.ext DT B ;
  BW : G0.fibCwF-T.Ty DB = G0.fibCwF-T.subT DB DT B (G0.fibCwF-T.p DT B) ;
  kB : G0.GB.CPartial[l].ContrOp DB BW.1 = G0.contrOp-T DB BW (PN0.selfContr DT B pB) ;
  pr : G0.FT.GCTruncHProp[l].Proposition[DT, B.1].isProp =
   G0.FT.GCLocBoundContr[l].Connect[DB, BW.1, BW.1, G0.FT.GCLocBoundContr[l].constant DB BW.1 (P0.qP DT B.1),
     G0.GB.CHtpyOps[l].idN DB BW.1, kB].homotopy ;
 } ;
} ;
