-- CHomSet.seg (canonicity-c2; for (K) and (d)): the internal Hom of
-- presented algebras is a set, for any presentations s, t: its map part
-- is a set (CwFFunSetB.FunSetQ) and its data are propositions (Pi of Id
-- types in the set Q_t: CSetProps.idPropC, CwFPropProp.piProp,
-- CSetProps.SigProp), so CSigSetC applies.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;

module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PP2 = CwFPropProp.PropProp[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;

module HomSet (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module HP = CHomT3[a].HomP[R, encK, pe] ;
 module H = HP.Hom[s, t] ;
 Nl : C.Ctx = C.nil ;
 QT : C.Ty Nl = H.AT.Qt ;
 sQT : CQCtx[a].G3Of[QT].SetQiTy = HP.Alg[t].Q1.setQi ;
 module BinP (opS : C.El Nl (OV.Fun Nl H.AS.Qt (OV.Fun Nl H.AS.Qt H.AS.Qt))) (opT : C.El Nl (OV.Fun Nl QT (OV.Fun Nl QT QT))) {
  module B = H.B0.BinOf[opS, opT] ;
  module GT = H.B0.GT ;
  Dw : C.Ctx = B.Dw ;
  Q3 : C.Ty Dw = C.subT Dw GT.G3 GT.Qw3 B.sigT ;
  b1 : C.El Dw Q3 = C.subt Dw GT.G3 GT.Qw3 (GT.OpTy[opT].o12w) B.sigT ;
  b2 : C.El Dw Q3 = C.subt Dw GT.G3 GT.Qw3 (C.q GT.G2 GT.Qw2) B.sigT ;
  PId : Id (C.Ty Dw) B.IdT3 (IJ.IdT Dw Q3 b1 b2) = IJ.IdT-nat Dw GT.G3 GT.Qw3 (GT.OpTy[opT].o12w) (C.q GT.G2 GT.Qw2) B.sigT ;
  QD : C.Ty Dw = C.subT Dw Nl QT (C.eps Dw) ;
  s12 : C.Sub GT.G2 Nl = C.o GT.G2 GT.G1 Nl (C.p Nl QT) (C.p GT.G1 GT.Qw) ;
  s123 : C.Sub GT.G3 Nl = C.o GT.G3 GT.G2 Nl s12 (C.p GT.G2 GT.Qw2) ;
  fa : Id (C.Ty GT.G2) GT.Qw2 (C.subT GT.G2 Nl QT s12) = symH (C.subT-o GT.G2 GT.G1 Nl QT (C.p Nl QT) (C.p GT.G1 GT.Qw)) ;
  fb : Id (C.Ty GT.G3) GT.Qw3 (C.subT GT.G3 Nl QT s123) =
   transH (apH {C.Ty GT.G2} {C.Ty GT.G3} (\ T -> C.subT GT.G3 GT.G2 T (C.p GT.G2 GT.Qw2)) fa) (symH (C.subT-o GT.G3 GT.G2 Nl QT s12 (C.p GT.G2 GT.Qw2))) ;
  PQ : Id (C.Ty Dw) Q3 QD =
   transH (apH {C.Ty GT.G3} {C.Ty Dw} (\ T -> C.subT Dw GT.G3 T B.sigT) fb)
    (transH (symH (C.subT-o Dw GT.G3 Nl QT s123 B.sigT))
       (apH {C.Sub Dw Nl} {C.Ty Dw} (\ s0 -> C.subT Dw Nl QT s0) (transH (C.eps-uniq Dw (C.o Dw GT.G3 Nl s123 B.sigT)) (refl (C.eps Dw))))) ;
  a1 : C.El Dw QD = OV.trE Dw Q3 QD PQ b1 ;
  a2 : C.El Dw QD = OV.trE Dw Q3 QD PQ b2 ;
  ip : C.El Dw (PU.isProp Dw (IJ.IdT Dw QD a1 a2)) = CSetProps[a].IdPropC[QT, sQT, Dw, a1, a2].idP ;
  cancel (b : C.El Dw Q3) : Id (C.El Dw Q3) (OV.trE Dw QD Q3 (symH PQ) (OV.trE Dw Q3 QD PQ b)) b =
   transH (OV.trE-tr Dw Q3 QD Q3 PQ (symH PQ) b) (OV.trE-irr Dw Q3 Q3 (transH PQ (symH PQ)) (refl Q3) b) ;
  ip3 : C.El Dw (PU.isProp Dw (IJ.IdT Dw Q3 b1 b2)) = CSetProps[a].moveIsProp Dw QD Q3 (symH PQ) a1 a2 b1 b2 (cancel b1) (cancel b2) ip ;
  pIdT3 : C.El Dw (PU.isProp Dw B.IdT3) =
   OV.trE Dw (PU.isProp Dw (IJ.IdT Dw Q3 b1 b2)) (PU.isProp Dw B.IdT3) (apH {C.Ty Dw} {C.Ty Dw} (\ T -> PU.isProp Dw T) (symH PId)) ip3 ;
  pDB : C.El H.Gh (PU.isProp H.Gh B.DataBin) = PP2.piProp H.Gh B.W4h B.IdT3 pIdT3 ;
 } ;
 -- the constant data: Q_t's Id pulled back twice
 module CS = H.CS ;
 pIdGT : C.El CS.GT2.G2 (PU.isProp CS.GT2.G2 CS.IdGT) = CS.GT2.setV2 sQT ;
 pCt : C.El CS.GPT (PU.isProp CS.GPT CS.IdCTt) =
  OV.trE CS.GPT (C.subT CS.GPT CS.GT2.G2 (PU.isProp CS.GT2.G2 CS.IdGT) CS.rT) (PU.isProp CS.GPT CS.IdCTt)
    (PU.isProp-ov CS.GPT CS.GT2.G2 CS.IdGT CS.rT CS.IdCTt (refl CS.IdCTt)) (C.subt CS.GPT CS.GT2.G2 (PU.isProp CS.GT2.G2 CS.IdGT) pIdGT CS.rT) ;
 pCT : C.El CS.Dc (PU.isProp CS.Dc CS.IdCT) =
  OV.trE CS.Dc (C.subT CS.Dc CS.GPT (PU.isProp CS.GPT CS.IdCTt) CS.sT) (PU.isProp CS.Dc CS.IdCT)
    (PU.isProp-ov CS.Dc CS.GPT CS.IdCTt CS.sT CS.IdCT (refl CS.IdCT)) (C.subt CS.Dc CS.GPT (PU.isProp CS.GPT CS.IdCTt) pCt CS.sT) ;
 pDC : C.El H.Gh (PU.isProp H.Gh CS.DataCst) = PP2.piProp H.Gh CS.Wch CS.IdCT pCT ;
 pDA : C.El H.Gh (PU.isProp H.Gh H.BA.DataBin) = BinP[H.AS.O.addQ, H.AT.O.addQ].pDB ;
 pDM : C.El H.Gh (PU.isProp H.Gh H.BM.DataBin) = BinP[H.AS.O.mulQ, H.AT.O.mulQ].pDB ;
 InT : C.Ty H.Gh = SS.Sig H.Gh H.BM.DataBin (OV.wkT H.Gh H.BM.DataBin CS.DataCst) ;
 pIn : C.El H.Gh (PU.isProp H.Gh InT) =
  CSetProps[a].SigProp[H.Gh, H.BM.DataBin, OV.wkT H.Gh H.BM.DataBin CS.DataCst, pDM, PU.wkProp H.Gh H.BM.DataBin CS.DataCst pDC].sigProp ;
 pData : C.El H.Gh (PU.isProp H.Gh H.DataT) =
  CSetProps[a].SigProp[H.Gh, H.BA.DataBin, OV.wkT H.Gh H.BA.DataBin InT, pDA, PU.wkProp H.Gh H.BA.DataBin InT pIn].sigProp ;
 setMap : CQCtx[a].G3Of[H.MapT].SetQiTy = CwFFunSetB[a].FunSetQ[H.AS.Qt, QT, sQT].setQi ;
 -- THE INTERNAL HOM IS A SET
 setHom : CQCtx[a].G3Of[H.HomT].SetQiTy = CSigSetC[a].SigSetC[H.MapT, H.DataT, setMap, pData].setQi ;
} ;
