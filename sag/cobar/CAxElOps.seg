-- CAxElOps.seg (canonicity-c2; the axioms' statements, duality part 2): G's
-- operations and constants on elements of G over any context (pointwise,
-- natural by the fibre operations' naturality), and the value of a
-- metatheory term under an assignment of its variables to such elements.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module ElOps (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (addV mulV : (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X)
  (addN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (addV I u v)) (addV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (mulN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (mulV I u v)) (mulV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (cV : R.R -> (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X)
  (cN : (r : R.R) (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (cV r I)) (cV r J))
  {
 module EG = CAxEv[a].EvG[R, encK, pe] ;
 module PW = EG.PW ;
 module PS = EG.PS ;
 C : CwF.CwF[a++] = PW.C ;
 Nl : C.Ctx = PW.Nl ;
 GA (G : C.Ctx) : C.Ty G = PW.Gat G ;
 -- the restriction of an element's value, as the fibre restriction
 rsN (G : C.Ctx) (x : C.El G (GA G)) (J I : EG.Ob) (f : EG.Hm J I) (w : V1.Ix (G.ob I)) (w' : V1.Ix (G.ob J)) (e : Id (V1.Ix (G.ob J)) (G.act J I f w) w')
   : Id (EG.GV J) (EG.rsG J I f (x.eob I w)) (x.eob J w') =
  transH (PS.tact-irr Nl PW.GB.GT J I f tt tt (refl tt) (PS.ntEq G Nl (C.eps G) J I f w w' e) (x.eob I w)) (x.enat J I f w w' e) ;
 toRs (G : C.Ctx) (J I : EG.Ob) (f : EG.Hm J I) (w : V1.Ix (G.ob I)) (w' : V1.Ix (G.ob J)) (e : Id (V1.Ix (G.ob J)) (G.act J I f w) w') (v : EG.GV I)
   : Id (EG.GV J) ((GA G).1.tact J I f w w' e v) (EG.rsG J I f v) =
  PS.tact-irr Nl PW.GB.GT J I f tt tt (PS.ntEq G Nl (C.eps G) J I f w w' e) (refl tt) v ;
 module Bin (op : (X : EG.Ob) -> EG.GV X -> EG.GV X -> EG.GV X)
   (opN : (J I : EG.Ob) (f : EG.Hm J I) (u v : EG.GV I) -> Id (EG.GV J) (EG.rsG J I f (op I u v)) (op J (EG.rsG J I f u) (EG.rsG J I f v))) {
  opE (G : C.Ctx) (x y : C.El G (GA G)) : C.El G (GA G) =
   PS.mkPEl G (GA G).1 (\ X w -> op X (x.eob X w) (y.eob X w)) (\ J I f w w' e ->
    transH (toRs G J I f w w' e (op I (x.eob I w) (y.eob I w)))
     (transH (opN J I f (x.eob I w) (y.eob I w))
       (transH (apH {EG.GV J} {EG.GV J} (\ u -> op J u (EG.rsG J I f (y.eob I w))) (rsN G x J I f w w' e))
          (apH {EG.GV J} {EG.GV J} (\ u -> op J (x.eob J w') u) (rsN G y J I f w w' e))))) ;
 } ;
 module AE = Bin[addV, addN] ;
 module ME = Bin[mulV, mulN] ;
 cstE (G : C.Ctx) (r : R.R) : C.El G (GA G) =
  PS.mkPEl G (GA G).1 (\ X w -> cV r X) (\ J I f w w' e -> transH (toRs G J I f w w' e (cV r I)) (cN r J I f)) ;
 -- the value of a term under an assignment
 evA (Vr : U a) (G : C.Ctx) (rho : Vr -> C.El G (GA G)) : SX.Over[R].Expr Vr -> C.El G (GA G) = split {
  var v -> rho v ;
  cst r -> cstE G r ;
  sumE p q | rp rq -> AE.opE G rp rq ;
  mulE p q | rp rq -> ME.opE G rp rq } ;
} ;
