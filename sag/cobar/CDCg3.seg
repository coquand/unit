-- CDCg3.seg (canonicity-c2; (d), congruence part 3): CDCg2's Id read as ev
-- of the compound term at both valuations.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module Cg3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (s2 : C.Sub (C.ext C.nil (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT)) (CSolT[a].SolOf[R, encK, pe, s, (zero, nil), y].EV.Gk s.1)) {
 module C2 = CDCg2[a].Cg2[R, encK, pe, s, y, s2] ;
 module C1 = C2.C1 ;
 module D = C1.D ;
 module EV = D.EV ;
 Nl : C.Ctx = C.nil ;
 n : Nat = D.n ;
 HS : C.Ty Nl = D.HS ;
 QY : C.Ty Nl = D.QY ;
 D1 : C.Ctx = D.D1 ;
 QYd : C.Ty D1 = D.QYd ;
 Tm : U a = C1.Tm ;
 module B (opT : C.El Nl (OV.Fun Nl QY (OV.Fun Nl QY QY))) (p q tpq : Tm) (hp : C.El D1 (C1.CE p)) (hq : C.El D1 (C1.CE q))
   (rL : (K : Ob) (o : Top) (z : V1.Ix (HS.1.tob K o)) -> Id (D.QK K (o, z)) ((CCmpU18[a].OpH[D1, QY, opT, C.p Nl HS].P2[D.evT p, D.evT q].val).eob K (o, z)) ((D.evT tpq).eob K (o, z)))
   (rR : (K : Ob) (o : Top) (z : V1.Ix (HS.1.tob K o)) -> Id (D.QK K (o, z)) ((CCmpU18[a].OpH[D1, QY, opT, C.p Nl HS].P2[C1.ev2T p, C1.ev2T q].val).eob K (o, z)) ((C1.ev2T tpq).eob K (o, z))) {
  module BB = C2.B1[opT, p, q, hp, hq] ;
  module A2 = BB.A2 ;
  res : C.El D1 (C1.CE tpq) =
   D.rwId D1 QYd (A2.O.P2[D.evT p, D.evT q].val) (D.evT tpq) (A2.O.P2[C1.ev2T p, C1.ev2T q].val) (C1.ev2T tpq)
    (\ K w -> rL K w.1 w.2) (\ K w -> rR K w.1 w.2) BB.a2 ;
 } ;
} ;
