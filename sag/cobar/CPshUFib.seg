-- CPshUFib.seg (canonicity-45; (B) stage 1(ii), COBAR.md): the uniform
-- fibrations (CPshL.UF.UFib: levelwise compositions commuting with the
-- C-action) as a classifier on the CwF of C-presheaves, so that the
-- fibrant C-types form a CwF (CwFCl.ClCwF), as FibCwF does at the base
-- with Lines.Fib.
--   UP        a uniform family of compositions of A pulled back along
--             s : D -> G is uniform: the moved composition (CFibSub,
--             CCart.MoveComp) is read through the cartesian map mT, which
--             commutes with the C-actions (sVC, mSC, mTC; msideC for the
--             sides), then the uniformity of A's family (Lemma12F.UFl)
--   clSubU    UFib along a C-substitution
--   isSet-UFib, clSubU-id, clSubU-o   the classifier laws (the base's
--             FibClL laws at each x; the uniformity halves are propositions)
--   CFibCwF   the CwF of fibrant C-types

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module UFibOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 open P ;

 ------------------------------------------------------------------
 -- a uniform family of compositions pulled back along s is uniform

 module UP (D G : CCtx) (s : CSub[D, G]) (A : CTy[G]) (e e' : PB.IPt)
  (kk : (x : CO) -> CL.Lines[G.ob x, A.ty x].CompK[e, e'].Comp) (cu : LO.UF[G, A].UComp e e' kk) {
  As : CTy[D] = LO.subCTy D G s A ;
  module SCs = LO.SC[D, G, s, A] ;
  module SFs = LO.SF[D, As, e] ;
  module SFa = LO.SF[G, A, e] ;
  module AEs = LO.AE[D, As, e] ;
  module AEa = LO.AE[G, A, e] ;
  module AEs' = LO.AE[D, As, e'] ;
  module AEa' = LO.AE[G, A, e'] ;
  -- the C-types of the other end, as substitutions of AevC e' along p
  module SCt-s = LO.SC[SFs.TVC, LO.LinC D, LO.pPC (LO.LinC D) AEs.AevC, AEs'.AevC] ;
  module SCt-a = LO.SC[SFa.TVC, LO.LinC G, LO.pPC (LO.LinC G) AEa.AevC, AEa'.AevC] ;

  -- the cartesian data at x
  module At (x : CO) {
   module FS = PB.CFibSub[l].FibSub[D.ob x, G.ob x, s.sb x, A.ty x] ;
   module Cx = FS.C ;
   module E = Cx.AtEnd[e] ;
   module E' = Cx.AtEnd[e'] ;
   module M = Cx.MoveComp[e, e'] ;
   module EKa = CL.EndKit[G.ob x, A.ty x, e] ;
   module EKs = CL.EndKit[D.ob x, As.ty x, e] ;
  } ;

  -- the point map sV commutes with the C-action (lines by sb-nat, ends by rBtE)
  sVC (y x : CO) (gC : CH y x) (X : Ob) (w : AEs.TVT x X)
   : Id (AEa.TVT y X) (At[y].E.sV X (AEs.tEv y x gC X w)) (AEa.tEv y x gC X (At[x].E.sV X w)) =
   At[y].EKa.tv-eq X (At[y].E.sV X (AEs.tEv y x gC X w)) (AEa.tEv y x gC X (At[x].E.sV X w))
    (CL.FC[G.ob y].fam-eq X _ _ (\ V g j -> s.sb-nat y x gC V ((fstE CL.FC[D.ob x].GI CL.FT[D.ob x, As.ty x].Ev[e].Aev X w).1 V g j)))
    (transH (At[y].E.sVE X (AEs.tEv y x gC X w))
      (transH (apH (At[y].FS.SE.mV X) (AEs.endEv y x gC X w))
        (transH (SCs.rBtE y x gC X (At[x].EKs.endE X w))
          (transH (apH ((A.tE y x gC).nt X) (symH (At[x].E.sVE X w)))
            (symH (AEa.endEv y x gC X (At[x].E.sV X w))))))) ;

  -- the map of strict-fibre elements mS commutes with the C-action
  mSC (y x : CO) (gC : CH y x) (W : Ob) (u : SFs.TST x W)
   : Id (SFa.TST y W) (At[y].E.mS W (SFs.tES y x gC W u)) (SFa.tES y x gC W (At[x].E.mS W u)) =
   At[y].EKa.ts-ext W (At[y].E.mS W (SFs.tES y x gC W u)) (SFa.tES y x gC W (At[x].E.mS W u))
    (transH (At[y].E.mSpt W (SFs.tES y x gC W u))
      (transH (sVC y x gC W u.1) (apH (AEa.tEv y x gC W) (symH (At[x].E.mSpt W u)))))
    (\ V g j -> transH (At[y].E.mS-val W (SFs.tES y x gC W u) V g j)
                 (transH (SCs.rBtE y x gC V (At[x].EKs.lv W u V g j))
                   (apH ((A.tE y x gC).nt V) (symH (At[x].E.mS-val W u V g j))))) ;

  -- (sVC at the other end)
  sVC' (y x : CO) (gC : CH y x) (X : Ob) (w : AEs'.TVT x X)
   : Id (AEa'.TVT y X) (At[y].E'.sV X (AEs'.tEv y x gC X w)) (AEa'.tEv y x gC X (At[x].E'.sV X w)) =
   CL.EndKit[G.ob y, A.ty y, e'].tv-eq X (At[y].E'.sV X (AEs'.tEv y x gC X w)) (AEa'.tEv y x gC X (At[x].E'.sV X w))
    (CL.FC[G.ob y].fam-eq X _ _ (\ V g j -> s.sb-nat y x gC V ((fstE CL.FC[D.ob x].GI CL.FT[D.ob x, As.ty x].Ev[e'].Aev X w).1 V g j)))
    (transH (At[y].E'.sVE X (AEs'.tEv y x gC X w))
      (transH (apH (At[y].FS.SE.mV X) (AEs'.endEv y x gC X w))
        (transH (SCs.rBtE y x gC X (CL.EndKit[D.ob x, As.ty x, e'].endE X w))
          (transH (apH ((A.tE y x gC).nt X) (symH (At[x].E'.sVE X w)))
            (symH (AEa'.endEv y x gC X (At[x].E'.sV X w))))))) ;

  -- the map of totals of the other end mT commutes with the C-action
  mTC (y x : CO) (gC : CH y x) (X : Ob) (v : At[x].M.TT'.EI X)
   : Id (At[y].M.TT.EI X) (At[y].M.mT X (SCt-s.tEs y x gC X v)) (SCt-a.tEs y x gC X (At[x].M.mT X v)) =
   At[y].M.CK.SE.mV-inj X (At[y].M.mT X (SCt-s.tEs y x gC X v)) (SCt-a.tEs y x gC X (At[x].M.mT X v))
    (sVC y x gC X (fstE (SFs.TVC.ob x) (SCt-s.ST x) X v))
    (transH (apH (At[y].E'.sV X) (SCt-s.rBtE y x gC X v))
      (transH (sVC' y x gC X (At[x].M.CK'.SE.mV X v))
        (symH (SCt-a.rBtE y x gC X (At[x].M.mT X v))))) ;
  -- the moved compositions at y, x
  module MV (x : CO) {
   module Mx = At[x].M ;
   k' : CL.Lines[D.ob x, As.ty x].CompK[e, e'].Comp = Mx.move (kk x) ;
  } ;

  -- the uniformity of the moved family (Lemma12F.UFl with mT in place of Psi)
  module Res (y x : CO) (gC : CH y x) (X : Ob) (w : AEs.TVT x X)
   (sd : CP.Partials[SFs.TVC.ob x, SFs.SFC.ty x].Side[X, w]) {
   module Mx = At[x].M ;
   module My = At[y].M ;
   w' : AEs.TVT y X = AEs.tEv y x gC X w ;
   sm : CP.Partials[SFs.TVC.ob y, SFs.SFC.ty y].Side[X, w'] = MapSide[SFs.TVC, SFs.SFC, y, x, gC].mapside X w sd ;
   -- the moved sides agree
   R : Id (CP.Partials[SFa.TVC.ob y, SFa.SFC.ty y].Side[X, At[y].E.sV X w'])
         (subst (AEa.TVT y X) (\ z -> CP.Partials[SFa.TVC.ob y, SFa.SFC.ty y].Side[X, z])
            (AEa.tEv y x gC X (At[x].E.sV X w)) (At[y].E.sV X w') (symH (sVC y x gC X w))
            (MapSide[SFa.TVC, SFa.SFC, y, x, gC].mapside X (At[x].E.sV X w) (Mx.mside (kk x) X w sd)))
         (My.mside (kk y) X w' sm) =
    CP.Partials[SFa.TVC.ob y, SFa.SFC.ty y].side-extH X (AEa.tEv y x gC X (At[x].E.sV X w)) (At[y].E.sV X w') (symH (sVC y x gC X w))
     (MapSide[SFa.TVC, SFa.SFC, y, x, gC].mapside X (At[x].E.sV X w) (Mx.mside (kk x) X w sd))
     (My.mside (kk y) X w' sm)
     (refl sd.pQ)
     (\ W h i i' -> transH (apH (\ v -> SFa.tES y x gC W (At[x].E.mS W v)) (CP.Partials[SFs.TVC.ob x, SFs.SFC.ty x].pv-irr X w sd W h i i'))
                    (symH (mSC y x gC W (sd.pv W h i')))) ;
   res : Id (SigT (SFs.TVC.ob y) (SCt-s.ST y) X)
           (SCt-s.tEs y x gC X (pairE (SFs.TVC.ob x) (SCt-s.ST x) X w (MV[x].k'.kop X w sd)))
           (pairE (SFs.TVC.ob y) (SCt-s.ST y) X w' (MV[y].k'.kop X w' sm)) =
    My.mTinj X (SCt-s.tEs y x gC X (pairE (SFs.TVC.ob x) (SCt-s.ST x) X w (MV[x].k'.kop X w sd))) (pairE (SFs.TVC.ob y) (SCt-s.ST y) X w' (MV[y].k'.kop X w' sm)) (refl w')
     (transH (mTC y x gC X (pairE (SFs.TVC.ob x) (SCt-s.ST x) X w (MV[x].k'.kop X w sd)))
       (transH (apH (SCt-a.tEs y x gC X) (Mx.kopMv (kk x) X w sd))
         (transH (cu y x gC X (At[x].E.sV X w) (Mx.mside (kk x) X w sd))
           (transH (CP.Rel[SFa.TVC.ob y, SFa.SFC.ty y, SCt-a.ST y, CL.Lines[G.ob y, A.ty y].CompK[e, e'].endL].kop-cong
                      (kk y) X (AEa.tEv y x gC X (At[x].E.sV X w)) (At[y].E.sV X w') (symH (sVC y x gC X w))
                      (MapSide[SFa.TVC, SFa.SFC, y, x, gC].mapside X (At[x].E.sV X w) (Mx.mside (kk x) X w sd))
                      (My.mside (kk y) X w' sm) R)
             (symH (My.kopMv (kk y) X w' sm)))))) ;
  } ;

  res : LO.UF[D, As].UComp e e' (\ x -> MV[x].k') = \ y x gC X w sd -> Res[y, x, gC, X, w, sd].res ;
 } ;

 ------------------------------------------------------------------
 -- UFib as a classifier: substitution, set-ness, the laws

 Cl (G : CCtx) (A : CTy[G]) : U l+ = LO.UF[G, A].UFib ;

 clSubU (D G : CCtx) (s : CSub[D, G]) (A : CTy[G]) (c : Cl G A) : Cl D (LO.subCTy D G s A) =
  (\ x -> PB.CFibSub[l].FibSub[D.ob x, G.ob x, s.sb x, A.ty x].sub (c.1 x),
   (UP[D, G, s, A, PB.e0, PB.e1, \ x -> (c.1 x).1, c.2.1].res,
    UP[D, G, s, A, PB.e1, PB.e0, \ x -> (c.1 x).2, c.2.2].res)) ;

 -- the uniformity halves are propositions
 ucomp-prop (G : CCtx) (A : CTy[G]) (e e' : PB.IPt) (kk : (x : CO) -> CL.Lines[G.ob x, A.ty x].CompK[e, e'].Comp)
  : isProp (LO.UF[G, A].UComp e e' kk) =
  isProp-Pi CO (\ y -> (x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((LO.SF[G, A, e].TVC.ob x).ob X)) (sd : CP.Partials[LO.SF[G, A, e].TVC.ob x, LO.SF[G, A, e].SFC.ty x].Side[X, g])
     -> Id (SigT (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X) (((LO.SF[G, A, e].TendC e').tE y x f).nt X (pairE (LO.SF[G, A, e].TVC.ob x) ((LO.SF[G, A, e].TendC e').ty x) X g ((kk x).kop X g sd))) (pairE (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X ((LO.SF[G, A, e].TVC.act y x f).nt X g) ((kk y).kop X ((LO.SF[G, A, e].TVC.act y x f).nt X g) (MapSide[LO.SF[G, A, e].TVC, LO.SF[G, A, e].SFC, y, x, f].mapside X g sd)))) (\ y ->
  isProp-Pi CO (\ x -> (f : CH y x) (X : Ob) (g : W0.Ix ((LO.SF[G, A, e].TVC.ob x).ob X)) (sd : CP.Partials[LO.SF[G, A, e].TVC.ob x, LO.SF[G, A, e].SFC.ty x].Side[X, g])
     -> Id (SigT (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X) (((LO.SF[G, A, e].TendC e').tE y x f).nt X (pairE (LO.SF[G, A, e].TVC.ob x) ((LO.SF[G, A, e].TendC e').ty x) X g ((kk x).kop X g sd))) (pairE (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X ((LO.SF[G, A, e].TVC.act y x f).nt X g) ((kk y).kop X ((LO.SF[G, A, e].TVC.act y x f).nt X g) (MapSide[LO.SF[G, A, e].TVC, LO.SF[G, A, e].SFC, y, x, f].mapside X g sd)))) (\ x ->
  isProp-Pi (CH y x) (\ f -> (X : Ob) (g : W0.Ix ((LO.SF[G, A, e].TVC.ob x).ob X)) (sd : CP.Partials[LO.SF[G, A, e].TVC.ob x, LO.SF[G, A, e].SFC.ty x].Side[X, g])
     -> Id (SigT (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X) (((LO.SF[G, A, e].TendC e').tE y x f).nt X (pairE (LO.SF[G, A, e].TVC.ob x) ((LO.SF[G, A, e].TendC e').ty x) X g ((kk x).kop X g sd))) (pairE (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X ((LO.SF[G, A, e].TVC.act y x f).nt X g) ((kk y).kop X ((LO.SF[G, A, e].TVC.act y x f).nt X g) (MapSide[LO.SF[G, A, e].TVC, LO.SF[G, A, e].SFC, y, x, f].mapside X g sd)))) (\ f ->
  isProp-Pi Ob (\ X -> (g : W0.Ix ((LO.SF[G, A, e].TVC.ob x).ob X)) (sd : CP.Partials[LO.SF[G, A, e].TVC.ob x, LO.SF[G, A, e].SFC.ty x].Side[X, g])
     -> Id (SigT (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X) (((LO.SF[G, A, e].TendC e').tE y x f).nt X (pairE (LO.SF[G, A, e].TVC.ob x) ((LO.SF[G, A, e].TendC e').ty x) X g ((kk x).kop X g sd))) (pairE (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X ((LO.SF[G, A, e].TVC.act y x f).nt X g) ((kk y).kop X ((LO.SF[G, A, e].TVC.act y x f).nt X g) (MapSide[LO.SF[G, A, e].TVC, LO.SF[G, A, e].SFC, y, x, f].mapside X g sd)))) (\ X ->
  isProp-Pi (W0.Ix ((LO.SF[G, A, e].TVC.ob x).ob X)) (\ g -> (sd : CP.Partials[LO.SF[G, A, e].TVC.ob x, LO.SF[G, A, e].SFC.ty x].Side[X, g])
     -> Id (SigT (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X) (((LO.SF[G, A, e].TendC e').tE y x f).nt X (pairE (LO.SF[G, A, e].TVC.ob x) ((LO.SF[G, A, e].TendC e').ty x) X g ((kk x).kop X g sd))) (pairE (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X ((LO.SF[G, A, e].TVC.act y x f).nt X g) ((kk y).kop X ((LO.SF[G, A, e].TVC.act y x f).nt X g) (MapSide[LO.SF[G, A, e].TVC, LO.SF[G, A, e].SFC, y, x, f].mapside X g sd)))) (\ g ->
  isProp-Pi (CP.Partials[LO.SF[G, A, e].TVC.ob x, LO.SF[G, A, e].SFC.ty x].Side[X, g]) (\ sd ->
     Id (SigT (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X) (((LO.SF[G, A, e].TendC e').tE y x f).nt X (pairE (LO.SF[G, A, e].TVC.ob x) ((LO.SF[G, A, e].TendC e').ty x) X g ((kk x).kop X g sd))) (pairE (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y) X ((LO.SF[G, A, e].TVC.act y x f).nt X g) ((kk y).kop X ((LO.SF[G, A, e].TVC.act y x f).nt X g) (MapSide[LO.SF[G, A, e].TVC, LO.SF[G, A, e].SFC, y, x, f].mapside X g sd)))) (\ sd ->
  W0.isSetIx (SigE (LO.SF[G, A, e].TVC.ob y) ((LO.SF[G, A, e].TendC e').ty y).tob X) _ _)))))) ;

 isSet-UFib (G : CCtx) (A : CTy[G]) : isSet (Cl G A) =
  isSet-Sigma (LFib G A) (\ c -> LO.UF[G, A].UComp PB.e0 PB.e1 (\ x -> (c x).1) * LO.UF[G, A].UComp PB.e1 PB.e0 (\ x -> (c x).2))
   (isSet-Pi CO (\ x -> CL.Lines[G.ob x, A.ty x].Fib) (\ x -> FibCwF[a, l].isSet-Fib (G.ob x) (A.ty x)))
   (\ c -> prop-to-set (LO.UF[G, A].UComp PB.e0 PB.e1 (\ x -> (c x).1) * LO.UF[G, A].UComp PB.e1 PB.e0 (\ x -> (c x).2))
      (isProp-Sigma (LO.UF[G, A].UComp PB.e0 PB.e1 (\ x -> (c x).1)) (\ u -> LO.UF[G, A].UComp PB.e1 PB.e0 (\ x -> (c x).2))
         (ucomp-prop G A PB.e0 PB.e1 (\ x -> (c x).1)) (\ u -> ucomp-prop G A PB.e1 PB.e0 (\ x -> (c x).2)))) ;

 -- the second component of a path of pairs
 sigSnd (X : U l+) (B : X -> U l+) (w w' : (u : X) * B u) (p : Id ((u : X) * B u) w w') : Id (B w'.1) (subst X B w.1 w'.1 (apH (\ u -> u.1) p) w.2) w'.2 =
  idJ ((u : X) * B u) w (\ w2 p2 -> Id (B w2.1) (subst X B w.1 w2.1 (apH (\ u -> u.1) p2) w.2) w2.2) (refl w.2) w' p ;

 -- a transport of a uniform fibration along a path of C-types is, at x,
 -- the transport of the fibration along the base path
 fibTrC (G : CCtx) (B B' : CTy[G]) (Pc : Id (CTy[G]) B B') (c : Cl G B) (x : CO)
  : Id (CL.Lines[G.ob x, B'.ty x].Fib) ((subst (CTy[G]) (Cl G) B B' Pc c).1 x)
       (subst (PTy[G.ob x]) (\ T -> CL.Lines[G.ob x, T].Fib) (B.ty x) (B'.ty x) (apH (\ X -> X.ty x) Pc) (c.1 x)) =
  idJ (CTy[G]) B (\ B2 P2 -> Id (CL.Lines[G.ob x, B2.ty x].Fib) ((subst (CTy[G]) (Cl G) B B2 P2 c).1 x)
                     (subst (PTy[G.ob x]) (\ T -> CL.Lines[G.ob x, T].Fib) (B.ty x) (B2.ty x) (apH (\ X -> X.ty x) P2) (c.1 x)))
   (refl (c.1 x)) B' Pc ;

 -- equality of uniform fibrations from equality of the fibrations at each x
 ufib-eq (G : CCtx) (A : CTy[G]) (c c' : Cl G A) (H : (x : CO) -> Id (CL.Lines[G.ob x, A.ty x].Fib) (c.1 x) (c'.1 x)) : Id (Cl G A) c c' =
  Sigma-eq (LFib G A) (\ k -> LO.UF[G, A].UComp PB.e0 PB.e1 (\ x -> (k x).1) * LO.UF[G, A].UComp PB.e1 PB.e0 (\ x -> (k x).2))
   c.1 c'.1 c.2 c'.2 (funext CO (\ x -> CL.Lines[G.ob x, A.ty x].Fib) c.1 c'.1 H)
   (isProp-Sigma (LO.UF[G, A].UComp PB.e0 PB.e1 (\ x -> (c'.1 x).1)) (\ u -> LO.UF[G, A].UComp PB.e1 PB.e0 (\ x -> (c'.1 x).2))
      (ucomp-prop G A PB.e0 PB.e1 (\ x -> (c'.1 x).1)) (\ u -> ucomp-prop G A PB.e1 PB.e0 (\ x -> (c'.1 x).2))) ;

 module FCL = FibClL[a, l] ;

 -- the laws: the base's clSub-id / clSub-o at each x
 clSubU-id (G : CCtx) (A : CTy[G]) (c : Cl G A)
  : Id ((A' : CTy[G]) * Cl G A') (A, c) (LO.subCTy G G (CW.cidC G) A, clSubU G G (CW.cidC G) A c) =
  Sigma-path (CTy[G]) (Cl G) A (LO.subCTy G G (CW.cidC G) A) c (clSubU G G (CW.cidC G) A c) (symH (CW.subT-idC G A))
   (ufib-eq G (LO.subCTy G G (CW.cidC G) A) (subst (CTy[G]) (Cl G) A (LO.subCTy G G (CW.cidC G) A) (symH (CW.subT-idC G A)) c) (clSubU G G (CW.cidC G) A c) (\ x ->
     transH (fibTrC G A (LO.subCTy G G (CW.cidC G) A) (symH (CW.subT-idC G A)) c x)
      (transH (apH (\ pp -> subst (PTy[G.ob x]) (\ T -> CL.Lines[G.ob x, T].Fib) (A.ty x) (subTy (G.ob x) (G.ob x) (A.ty x) (idS (G.ob x))) pp (c.1 x))
                 (isSet-PTy (G.ob x) (A.ty x) (subTy (G.ob x) (G.ob x) (A.ty x) (idS (G.ob x)))
                    (apH (\ X -> X.ty x) (symH (CW.subT-idC G A))) (apH (\ u -> u.1) (FCL.clSub-id (G.ob x) (A.ty x) (c.1 x)))))
        (sigSnd (PTy[G.ob x]) (\ T -> CL.Lines[G.ob x, T].Fib) (A.ty x, c.1 x) (subTy (G.ob x) (G.ob x) (A.ty x) (idS (G.ob x)), FCL.clSub (G.ob x) (G.ob x) (idS (G.ob x)) (A.ty x) (c.1 x))
           (FCL.clSub-id (G.ob x) (A.ty x) (c.1 x)))))) ;

 clSubU-o (T D G : CCtx) (s : CSub[D, G]) (s' : CSub[T, D]) (A : CTy[G]) (c : Cl G A)
  : Id ((A' : CTy[T]) * Cl T A') (LO.subCTy T G (CW.coC T D G s s') A, clSubU T G (CW.coC T D G s s') A c)
      (LO.subCTy T D s' (LO.subCTy D G s A), clSubU T D s' (LO.subCTy D G s A) (clSubU D G s A c)) =
  Sigma-path (CTy[T]) (Cl T) (LO.subCTy T G (CW.coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A))
   (clSubU T G (CW.coC T D G s s') A c) (clSubU T D s' (LO.subCTy D G s A) (clSubU D G s A c)) (CW.subT-oC T D G A s s')
   (ufib-eq T (LO.subCTy T D s' (LO.subCTy D G s A)) _ _ (\ x ->
     transH (fibTrC T (LO.subCTy T G (CW.coC T D G s s') A) (LO.subCTy T D s' (LO.subCTy D G s A)) (CW.subT-oC T D G A s s') (clSubU T G (CW.coC T D G s s') A c) x)
      (transH (apH (\ pp -> subst (PTy[T.ob x]) (\ Tt -> CL.Lines[T.ob x, Tt].Fib) (subTy (T.ob x) (G.ob x) (A.ty x) (oS (T.ob x) (D.ob x) (G.ob x) (s.sb x) (s'.sb x)))
                                 (subTy (T.ob x) (D.ob x) (subTy (D.ob x) (G.ob x) (A.ty x) (s.sb x)) (s'.sb x)) pp ((clSubU T G (CW.coC T D G s s') A c).1 x))
                 (isSet-PTy (T.ob x) (subTy (T.ob x) (G.ob x) (A.ty x) (oS (T.ob x) (D.ob x) (G.ob x) (s.sb x) (s'.sb x))) (subTy (T.ob x) (D.ob x) (subTy (D.ob x) (G.ob x) (A.ty x) (s.sb x)) (s'.sb x))
                    (apH (\ X -> X.ty x) (CW.subT-oC T D G A s s')) (apH (\ u -> u.1) (FCL.clSub-o (T.ob x) (D.ob x) (G.ob x) (s.sb x) (s'.sb x) (A.ty x) (c.1 x)))))
        (sigSnd (PTy[T.ob x]) (\ Tt -> CL.Lines[T.ob x, Tt].Fib)
           (subTy (T.ob x) (G.ob x) (A.ty x) (oS (T.ob x) (D.ob x) (G.ob x) (s.sb x) (s'.sb x)), FCL.clSub (T.ob x) (G.ob x) (oS (T.ob x) (D.ob x) (G.ob x) (s.sb x) (s'.sb x)) (A.ty x) (c.1 x))
           (subTy (T.ob x) (D.ob x) (subTy (D.ob x) (G.ob x) (A.ty x) (s.sb x)) (s'.sb x), FCL.clSub (T.ob x) (D.ob x) (s'.sb x) (subTy (D.ob x) (G.ob x) (A.ty x) (s.sb x)) (FCL.clSub (D.ob x) (G.ob x) (s.sb x) (A.ty x) (c.1 x)))
           (FCL.clSub-o (T.ob x) (D.ob x) (G.ob x) (s.sb x) (s'.sb x) (A.ty x) (c.1 x)))))) ;

 ------------------------------------------------------------------
 -- the CwF of fibrant C-types

 module FCC = CwFCl[l+].ClCwF[CW.CPCwF, Cl, isSet-UFib, clSubU, clSubU-id, clSubU-o] ;
 CFibCwF : CwF.CwF[l+] = FCC.SCwF ;
} ;

