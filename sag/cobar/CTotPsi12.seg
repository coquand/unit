-- CTotPsi12.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 12: Psi on the strict fibre of ev_e, value
-- by value.  For v = (ln, av, L, eqL, pthL) (a line L of D G . D A over
-- the line ln with end av), at an index q: psi_q of the paired line
-- (Psi at the context G.A), a line of A over psi_q ln (piLeq), ending at
-- the point of TVC_e that Psi gives (pthq).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi12 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P6 = CTotPsi6[a, vl, l].Psi6[C, G, A, e] ;
 module P2 = P6.P2 ;
 module PO = P6.PO ;
 module TR = PO.TR ;
 module G1 = TR.G1 ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module DA = P6.DA ;
 module EKg = P6.EKg ;
 module EKd = P6.EKd ;
 module PR = CTotPsi11[a, vl, l].Psi11[C, G, e].Pair[A] ;
 ET : CTPsh[a, vl, l].TPshOf[C].TCtx = PR.ET ;
 module Q2E = CTotPsi2[a, vl, l].Psi2[C, ET] ;
 module P11E = CTotPsi11[a, vl, l].Psi11[C, ET, e] ;
 module FTg = G1.GB.CLine[l].FT[PO.GP, A] ;
 module FTd = G1.GB.CLine[l].FT[PO.DG, DA.DTy] ;
 module FCg = G1.GB.CLine[l].FC[PO.GP] ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;

 module MS (X : TC.TOb) (v : EKd.TS.EI X) {
  w : EKd.TV.EI X = EKd.TS.pr1 X v ;
  module PP = P6.PP[X, w] ;
  sv : W0.Ix (EKd.SFm.sfOb X w) = EKd.TS.pr2 X v ;
  L : W0.Ix (FTd.FE.ob X) = sv.1.1 ;
  eqL : Id (W0.Ix (PO.FL.ob X)) (FTd.piL X L) PP.ln = sv.1.2 ;
  lE : W0.Ix (PR.FDE.ob X) = PR.phiL X L ;
  peX : PB.IvP X.1 = G1.GB.ptH X e ;
  -- the end of the line of D G . D A is (u0, av)
  endL : Id (FTd.TA.EI X) (L.1 X (TC.tid X) peX) (FTd.TA.pr X PP.u0 PP.av) =
   transH (symH (FTd.Ev[e].endB-E X (EKd.lineL X v))) (apH {EKd.TV.EI X} {FTd.TA.EI X} (EKd.endE X) sv.2) ;
  module PQ (n : Nat) (J : Ob) (u : Hom J X.1) (z : Obj J) (c : CT.Ch J n (C.res J X.1 u X.2) z) (i : Wt.Pn n J) {
   module QG = PP.PQ[n, J, u, z, c, i] ;
   module QE = Q2E.PQ[X, lE, n, J, u, z, c, i] ;
   Y : TC.TOb = (J, z) ;
   q : DO.Idx X.1 X.2 = (n, J, u, z, c, i.1) ;
   psiE : W0.Ix (FTg.FE.ob Y) = QE.psiq ;
   piLeq : Id (W0.Ix (FCg.ob Y)) (FTg.piL Y psiE) QG.Q.psiq =
    transH (FCg.fam-eq Y (FTg.piL Y psiE) (P2.PQ[X, FTd.piL X L, n, J, u, z, c, i].psiq) (\ W f j -> refl ((FTg.piL Y psiE).1 W f j)))
     (apH {W0.Ix (PO.FL.ob X)} {W0.Ix (FCg.ob Y)} (\ ln' -> P2.PQ[X, ln', n, J, u, z, c, i].psiq) eqL) ;
   lnA : W0.Ix (FTg.AI.tob Y QG.Q.psiq) = (psiE, piLeq) ;
   wl : EKg.TL.EI Y = EKg.TL.pr Y QG.Q.psiq lnA ;
   -- its end is the point Psi gives
   endE : Id (EKg.TA.EI Y) (EKg.endE Y (FTg.Ev[e].evA.mE Y wl)) (EKg.endE Y QG.pt) =
    transH (FTg.Ev[e].endB-E Y wl)
     (transH (symH (P11E.EP[X, lE].EQ[n, J, u, z, c, i].Pq))
       (transH (apH {FTd.TA.EI X} {EKg.TA.EI Y} (\ T -> DA.prz J z (T.1.1 q i.2) (T.2.1 q i.2)) endL)
         (symH QG.pc))) ;
   pthq : Id (EKg.TV.EI Y) (FTg.Ev[e].evA.mE Y wl) QG.pt =
    EKg.tv-eq Y (FTg.Ev[e].evA.mE Y wl) QG.pt (refl QG.Q.psiq) endE ;
   fib : W0.Ix (EKg.SFm.sfOb Y QG.pt) = (lnA, pthq) ;
  } ;
 } ;
} ;
