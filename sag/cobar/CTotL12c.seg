-- CTotL12c.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part c: piece 0 of the levelwise extension
-- problem at an index (n, J, u, z, c, i), a side of U A at (J, z) in the
-- levelwise site over gm's point: on the sieve pre u Q, at a levelwise
-- map (v, e) : (W, y) -> (J, z), the side s at cart (u . v) x read at the
-- identity index of the restricted chain (its tail moved along e).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module L12c (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LB = CTotL12b[a, vl, l].L12b[C, G, A] ;
 module LA = LB.LA ;
 module CL = LB.CL ;
 module TR = LA.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LB.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 UG : TR.P0.PCtx = LB.UG ;
 UA : TR.P0.PTy[UG] = LB.UA ;
 Ob0 : U vl = TR.RN.Ob0 ;

 module Fc (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FB = LB.Fb[X, gm, s] ;
  module F = FB.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  -- the reading at cartesian lifts respects slice paths and weights
  rdS (n : Nat) (W1 : Ob) (y : Obj W1) (sw : D.S I x n W1 y) (lU : PB.Lands W1 I s.pQ sw.1) (R : Wt.Pn n W1) : DA.Ez W1 y =
   FB.rdC n W1 y sw.1 sw.2 lU R ;
  rdS-eq (n : Nat) (W1 : Ob) (y : Obj W1) (sw sw' : D.S I x n W1 y) (P : Id (D.S I x n W1 y) sw sw')
   (lU : PB.Lands W1 I s.pQ sw.1) (lU' : PB.Lands W1 I s.pQ sw'.1) (R R' : Wt.Pn n W1) (PR : Id (Wt.Pn n W1) R R')
   : Id (DA.Ez W1 y) (rdS n W1 y sw lU R) (rdS n W1 y sw' lU' R') =
   idJ (D.S I x n W1 y) sw
    (\ sw2 P2 -> (l2 : PB.Lands W1 I s.pQ sw2.1) -> Id (DA.Ez W1 y) (rdS n W1 y sw lU R) (rdS n W1 y sw2 l2 R'))
    (\ l2 -> transH (apH {PB.Lands W1 I s.pQ sw.1} {DA.Ez W1 y} (\ t -> rdS n W1 y sw t R) (PB.isProp-Lands W1 I s.pQ sw.1 lU l2))
               (apH {Wt.Pn n W1} {DA.Ez W1 y} (\ t -> rdS n W1 y sw l2 t) PR))
    sw' P lU' ;

  module Q0 (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch n J u z) (i : Wt.Pn n J) {
   Y : Ob0 = (J, z) ;
   gp : W0.Ix (G.ob J z) = F.gpt n J u z c i ;
   Q : PB.Phi J = PB.pre J I u s.pQ ;
   cT (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) : CT.Ch W1 n (C.res W1 I (compH W1 J I u v) x) y =
    subst (Obj W1) (\ t -> CT.Ch W1 n (C.res W1 I (compH W1 J I u v) x) t) (C.res W1 J v z) y e (DO.rCh W1 J I v u x n z c) ;
   vg (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) (lv : PB.Lands W1 J Q v) : DA.Ez W1 y =
    FB.rdC n W1 y (compH W1 J I u v) (cT W1 v y e) (PB.lands-pre W1 J I u s.pQ v lv) (Wt.Res[n, W1, J, v, i].res) ;
   pv : Py.PvTy Y Q = \ W h lh -> vg W.1 h.1 W.2 (symH h.2) lh ;
   pptg (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) (lv : PB.Lands W1 J Q v)
    : Id (W0.Ix (G.ob W1 y)) (vg W1 v y e lv).1 (G.act W1 J v y z (VT.trD W1 J v (C.res W1 J v z) y e z (C.cart W1 J v z)) gp) =
    idJ (Obj W1) (C.res W1 J v z)
     (\ y2 e2 -> Id (W0.Ix (G.ob W1 y2)) (vg W1 v y2 e2 lv).1 (G.act W1 J v y2 z (VT.trD W1 J v (C.res W1 J v z) y2 e2 z (C.cart W1 J v z)) gp))
     (transH (FB.RC[n, W1, C.res W1 J v z, compH W1 J I u v, DO.rCh W1 J I v u x n z c, PB.lands-pre W1 J I u s.pQ v lv, Wt.Res[n, W1, J, v, i].res].pt)
        (symH (gm.2.1 ((n, J, u, z, c, i.1), (W1, v)) i.2)))
     y e ;
   ppt : Py.PptTy Y gp Q pv = \ W h lh -> pptg W.1 h.1 W.2 (symH h.2) lh ;
   -- naturality along the levelwise maps
   module NG (W1 : Ob) (v : Hom W1 J) (lv : PB.Lands W1 J Q v) (W2 : Ob) (w : Hom W2 W1) (lv' : PB.Lands W2 J Q (compH W2 W1 J v w)) {
    rz : Obj W1 = C.res W1 J v z ;
    T0 : Obj W2 = C.res W2 W1 w rz ;
    vw : Hom W2 J = compH W2 W1 J v w ;
    uv : Hom W1 I = compH W1 J I u v ;
    lU2 : PB.Lands W2 I s.pQ (compH W2 J I u vw) = PB.lands-pre W2 J I u s.pQ vw lv' ;
    lUw : PB.Lands W2 I s.pQ (compH W2 W1 I uv w) =
     PB.lands-eq W2 I s.pQ (compH W2 J I u vw) (compH W2 W1 I uv w) (symH (comp-assoc W2 W1 J I u v w)) lU2 ;
    module N = FB.NC[n, W1, rz, uv, DO.rCh W1 J I v u x n z c, PB.lands-pre W1 J I u s.pQ v lv, Wt.Res[n, W1, J, v, i].res, W2, w, lUw] ;
    module R2 = CL.RC2[W2, W1, J, I, w, v, u, x, n, z, c] ;
    SP (eT : Id (Obj W2) (C.res W2 J vw z) T0)
     : Id (D.S I x n W2 T0) (compH W2 W1 I uv w, DO.rCh W2 W1 I w uv x n rz (DO.rCh W1 J I v u x n z c)) (compH W2 J I u vw, cT W2 vw T0 eT) =
     D.sEq I x n W2 T0 (compH W2 W1 I uv w) (compH W2 J I u vw) (comp-assoc W2 W1 J I u v w)
      (DO.rCh W2 W1 I w uv x n rz (DO.rCh W1 J I v u x n z c)) (cT W2 vw T0 eT)
      (transH R2.law
         (apH {Id (Obj W2) (C.res W2 J vw z) T0} {CT.Ch W2 n (C.res W2 I (compH W2 J I u vw) x) T0} (\ e -> cT W2 vw T0 e)
            (CT.setObj W2 (C.res W2 J vw z) T0 R2.et eT))) ;
    base (eT : Id (Obj W2) (C.res W2 J vw z) T0)
     : Id (DA.Ez W2 T0) (DA.E.act (W2, T0) (W1, rz) (w, C.cart W2 W1 w rz) (vg W1 v rz (refl rz) lv)) (vg W2 vw T0 eT lv') =
     transH N.nat
      (rdS-eq n W2 T0 (compH W2 W1 I uv w, DO.rCh W2 W1 I w uv x n rz (DO.rCh W1 J I v u x n z c)) (compH W2 J I u vw, cT W2 vw T0 eT) (SP eT)
         lUw lU2 (Wt.Res[n, W2, W1, w, Wt.Res[n, W1, J, v, i].res].res) (Wt.Res[n, W2, J, vw, i].res) (LA.L1.resres n W2 W1 J v w i)) ;
    natg (y : Obj W1) (e : Id (Obj W1) rz y) (y2 : Obj W2) (e2 : Id (Obj W2) (C.res W2 W1 w y) y2) (eT : Id (Obj W2) (C.res W2 J vw z) y2)
     : Id (DA.Ez W2 y2) (DA.E.act (W2, y2) (W1, y) (w, VT.trD W2 W1 w (C.res W2 W1 w y) y2 e2 y (C.cart W2 W1 w y)) (vg W1 v y e lv))
         (vg W2 vw y2 eT lv') =
     idJ (Obj W1) rz
      (\ y' e' -> (y3 : Obj W2) (e3 : Id (Obj W2) (C.res W2 W1 w y') y3) (eT3 : Id (Obj W2) (C.res W2 J vw z) y3)
         -> Id (DA.Ez W2 y3) (DA.E.act (W2, y3) (W1, y') (w, VT.trD W2 W1 w (C.res W2 W1 w y') y3 e3 y' (C.cart W2 W1 w y')) (vg W1 v y' e' lv))
              (vg W2 vw y3 eT3 lv'))
      (\ y3 e3 -> idJ (Obj W2) T0
         (\ y4 e4 -> (eT4 : Id (Obj W2) (C.res W2 J vw z) y4)
            -> Id (DA.Ez W2 y4) (DA.E.act (W2, y4) (W1, rz) (w, VT.trD W2 W1 w T0 y4 e4 rz (C.cart W2 W1 w rz)) (vg W1 v rz (refl rz) lv))
                 (vg W2 vw y4 eT4 lv'))
         base y3 e3)
      y e y2 e2 eT ;
   } ;
   pnat : Py.PnTy Y Q pv = \ W' W chi h lh lh' ->
    NG[W.1, h.1, lh, W'.1, chi.1, lh'].natg W.2 (symH h.2) W'.2 (symH chi.2) (symH (G0.GB.BC.oC W' W Y h chi).2) ;
   side : Py.Side[Y, gp] = Py.mkSide Y gp Q pv ppt pnat ;
  } ;
 } ;
} ;
