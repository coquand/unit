-- CCopyH.seg (canonicity-45; COBAR.md "Prop 58"): natural maps and path
-- homotopies at the levelwise site G0 restrict to the copy of a
-- presentation y (CCopy.Copy: objects (I, y), maps (u, refl)): the values at
-- the copy's objects and maps, the laws at them.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RH (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module Cy = CC.Copy[y] ;
 module G0 = CC.G0 ;
 module HO0 = G0.GB.CHtpyOps[a+] ;
 module HO = PB.CHtpyOps[a+] ;
 module Of (G : CC.P0.PCtx) (A B : CC.P0.PTy[G]) {
  Gy : L.PCtx = Cy.rCy G ;
  Ay : L.PTy[Gy] = Cy.rTy G A ;
  By : L.PTy[Gy] = Cy.rTy G B ;
  rN (f : HO0.NMap[G, A, B]) : HO.NMap[Gy, Ay, By] =
   new HO.NMap[Gy, Ay, By, \ I x a0 -> f.nfun (Cy.o0 I) x a0, \ J I uu x x' e a0 -> f.nnat (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I uu) x x' e a0] ;
  module RHt (f g : HO0.NMap[G, A, B]) (H : G0.GB.GPre[a+].PS.PEl[G0.GB.GPre[a+].PS.extP G A, HO0.HT[G, A, B, f, g].PT.PathP]) {
   module T0 = HO0.HT[G, A, B, f, g] ;
   module T = HO.HT[Gy, Ay, By, rN f, rN g] ;
   path (I : Ob) (z : V1.Ix (T.GA.ob I)) : V1.Ix (T.PT.tobP I z) =
    T.PT.mkPath I z (\ Vv gg j -> T0.pv H (Cy.o0 I) z (Cy.o0 Vv) (Cy.h0 Vv I gg) j)
     (\ Vb Va g2 gg j -> (H.eob (Cy.o0 I) z).1.2 (Cy.o0 Vb) (Cy.o0 Va) (Cy.h0 Vb Va g2) (Cy.h0 Va I gg) j)
     (\ Vv gg j -> (H.eob (Cy.o0 I) z).2.1 (Cy.o0 Vv) (Cy.h0 Vv I gg) j)
     (H.eob (Cy.o0 I) z).2.2.1 (H.eob (Cy.o0 I) z).2.2.2 ;
   enat (J I : Ob) (h : Hom J I) (z : V1.Ix (T.GA.ob I)) (z' : V1.Ix (T.GA.ob J)) (e : Id (V1.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
    : Id (V1.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') (\ Vv ff i ->
     T0.pv-res H (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I h) z z' e (Cy.o0 Vv) (Cy.h0 Vv J ff) i) ;
   res : L.PEl[T.GA, T.PT.PathP] = new L.PEl[T.GA, T.PT.PathP, path, enat] ;
  } ;
 } ;
} ;
