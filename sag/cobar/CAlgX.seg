-- CAlgX.seg (canonicity-45; SIMPLIFIED.md step 2b): the ring operations of
-- the presented algebra A_x = Q(Delta Term_x, ~), against the quotient's
-- eliminator in two constant arguments (a module parameter with the
-- statement agreed with canonicity-c2, who builds it; its beta law as an
-- Id-element) and the set-ness of Qt.  The operations are the classes of
-- the syntactic operations, which respect the relation by the congruence
-- derivations (sumP, mulP) through CClsEqC.clsEqC; the ring laws hold at
-- constants (the law derivations), the lifting to all elements by the
-- eliminator into propositions is the next file.
--   addQ, mulQ, zeroQ, oneQ      the operations
--   add-beta, mul-beta           their values at classes of constants
--   lawC                         a derivation gives an Id between the
--                                classes of its two terms (clsEqC), e.g.
--                                add-assocC at three constants
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module FU = FibUniv[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module FB = FibCwF[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module MP = CwFMaps.Maps[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FB.fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module AlgX (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module CE = CClsEqC[a].ClsEqC[R, encK, x, pe] ;
 module RP = CE.RP ;
 module QQ = CE.QQ ;
 module Dx = CE.Dx ;
 Nl : C.Ctx = C.nil ;
 Term : U a = RP.Term ;
 Qt : C.Ty Nl = QQ.Qt ;
 Q : U a++ = C.El Nl Qt ;
 IdQ (q q' : Q) : C.Ty Nl = IJ.IdT Nl Qt q q' ;
 cls (t : Term) : Q = QQ.clsG (RP.ct t) ;
 RelC (t u : Term) : C.Ty Nl = RP.RelT (RP.ct t) (RP.ct u) ;
 -- the class of a term depends only on the term up to derivation
 clsEq (t t' : Term) (d : Dx.Proof t t') : C.El Nl (IdQ (cls t) (cls t')) = CE.clsEqC t t' d ;

 -- the eliminator in two constant arguments, the shape agreed with c2
 Elim2Ty : U a++ =
  (B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy)
  (f : Term -> Term -> C.El Nl B)
  (rs1 : (t t' u : Term) -> C.El Nl (RelC t t') -> C.El Nl (IJ.IdT Nl B (f t u) (f t' u)))
  (rs2 : (t u u' : Term) -> C.El Nl (RelC u u') -> C.El Nl (IJ.IdT Nl B (f t u) (f t u')))
  -> C.El Nl (OV.Fun Nl Qt (OV.Fun Nl Qt B)) ;
 ap2 (B : C.Ty Nl) (g : C.El Nl (OV.Fun Nl Qt (OV.Fun Nl Qt B))) (q q' : Q) : C.El Nl B =
  OV.app Nl Qt B (OV.app Nl Qt (OV.Fun Nl Qt B) g q) q' ;
 Elim2Beta (elim2 : Elim2Ty) : U a++ =
  (B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy)
  (f : Term -> Term -> C.El Nl B)
  (rs1 : (t t' u : Term) -> C.El Nl (RelC t t') -> C.El Nl (IJ.IdT Nl B (f t u) (f t' u)))
  (rs2 : (t u u' : Term) -> C.El Nl (RelC u u') -> C.El Nl (IJ.IdT Nl B (f t u) (f t u')))
  (t u : Term) -> C.El Nl (IJ.IdT Nl B (ap2 B (elim2 B sB f rs1 rs2) (cls t) (cls u)) (f t u)) ;

 -- from an element of Rel (ct t) (ct t') to a derivation-like Id of classes:
 -- Rel is a proposition, its elements give equal classes by eff's converse
 -- direction (cls-eq); here we use the derivations themselves, so the
 -- respect proofs take the relation element and produce the Id through
 -- the elimination of the decoded truncation into the proposition
 -- IdQ (cls (op t u)) (cls (op t' u)) (CRelResp.PackAp)
 module Resp (op : Term -> Term -> Term) (opP : (t t' u u' : Term) -> Dx.Proof t t' -> Dx.Proof u u' -> Dx.Proof (op t u) (op t' u'))
  (setQ : (q q' : Q) -> C.El Nl (PU.isProp Nl (IdQ q q'))) {
  f (t u : Term) : Q = cls (op t u) ;
  rs1 (t t' u : Term) (w : C.El Nl (RelC t t')) : C.El Nl (IdQ (f t u) (f t' u)) =
   CRelResp[a].PackAp[R, encK, x, t, t', IdQ (f t u) (f t' u), setQ (f t u) (f t' u), \ d -> clsEq (op t u) (op t' u) (opP t t' u u d (Dx.reflP u))].atRel w ;
  rs2 (t u u' : Term) (w : C.El Nl (RelC u u')) : C.El Nl (IdQ (f t u) (f t u')) =
   CRelResp[a].PackAp[R, encK, x, u, u', IdQ (f t u) (f t u'), setQ (f t u) (f t u'), \ d -> clsEq (op t u) (op t u') (opP t t u u' (Dx.reflP t) d)].atRel w ;
 } ;

 -- the operations
 module Ops (setQ : (q q' : Q) -> C.El Nl (PU.isProp Nl (IdQ q q'))) (sQi : CQCtx[a].G3Of[Qt].SetQiTy) (elim2 : Elim2Ty) (elim2-beta : Elim2Beta elim2) {
  module RA = Resp[\ t u -> sumE t u, \ t t' u u' d e -> Dx.sumP t t' u u' d e, setQ] ;
  module RM = Resp[\ t u -> mulE t u, \ t t' u u' d e -> Dx.mulP t t' u u' d e, setQ] ;
  addQ : C.El Nl (OV.Fun Nl Qt (OV.Fun Nl Qt Qt)) = elim2 Qt sQi RA.f RA.rs1 RA.rs2 ;
  mulQ : C.El Nl (OV.Fun Nl Qt (OV.Fun Nl Qt Qt)) = elim2 Qt sQi RM.f RM.rs1 RM.rs2 ;
  zeroQ : Q = cls Dx.zeroE ;
  oneQ : Q = cls Dx.oneE ;
  add (q q' : Q) : Q = ap2 Qt addQ q q' ;
  mul (q q' : Q) : Q = ap2 Qt mulQ q q' ;
  add-beta (t u : Term) : C.El Nl (IdQ (add (cls t) (cls u)) (cls (sumE t u))) = elim2-beta Qt sQi RA.f RA.rs1 RA.rs2 t u ;
  mul-beta (t u : Term) : C.El Nl (IdQ (mul (cls t) (cls u)) (cls (mulE t u))) = elim2-beta Qt sQi RM.f RM.rs1 RM.rs2 t u ;
  -- the laws at constants: through the betas and the law derivations
  tr (q1 q2 q3 : Q) (e : C.El Nl (IdQ q1 q2)) (e' : C.El Nl (IdQ q2 q3)) : C.El Nl (IdQ q1 q3) = PT.transM Nl Qt q1 q2 q3 e e' ;
  sy (q1 q2 : Q) (e : C.El Nl (IdQ q1 q2)) : C.El Nl (IdQ q2 q1) = PT.symM Nl Qt q1 q2 e ;
  -- congruence of add in each argument (apF; the left one through the
  -- evaluation map at the right argument, EvF)
  addR (q : Q) (q1 q2 : Q) (e : C.El Nl (IdQ q1 q2)) : C.El Nl (IdQ (add q q1) (add q q2)) =
   MP.apF Nl Qt Qt (OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q) q1 q2 e ;
  ofEq (q1 q2 : Q) (e : Id Q q1 q2) : C.El Nl (IdQ q1 q2) = IN.idOfEq Nl Qt q1 q2 e ;
  module EvAt (q' : Q) { module E = MP.EvF[Nl, Qt, Qt, q'] ; } ;
  addL (q1 q2 : Q) (q' : Q) (e : C.El Nl (IdQ q1 q2)) : C.El Nl (IdQ (add q1 q') (add q2 q')) =
   tr (add q1 q') (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q1)) (add q2 q')
    (ofEq (add q1 q') (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q1)) (symH EvAt[q'].E.At[OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q1].val))
    (tr (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q1)) (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q2)) (add q2 q')
      (MP.apF Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q1) (OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q2)
         (MP.apF Nl Qt (OV.Fun Nl Qt Qt) addQ q1 q2 e))
      (ofEq (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q2)) (add q2 q') EvAt[q'].E.At[OV.app Nl Qt (OV.Fun Nl Qt Qt) addQ q2].val)) ;
  -- the laws at constants: betas, congruences and the law derivations
  add-assocC (t u w : Term) : C.El Nl (IdQ (add (cls t) (add (cls u) (cls w))) (add (add (cls t) (cls u)) (cls w))) =
   tr (add (cls t) (add (cls u) (cls w))) (add (cls t) (cls (sumE u w))) (add (add (cls t) (cls u)) (cls w))
    (addR (cls t) (add (cls u) (cls w)) (cls (sumE u w)) (add-beta u w))
    (tr (add (cls t) (cls (sumE u w))) (cls (sumE t (sumE u w))) (add (add (cls t) (cls u)) (cls w))
      (add-beta t (sumE u w))
      (tr (cls (sumE t (sumE u w))) (cls (sumE (sumE t u) w)) (add (add (cls t) (cls u)) (cls w))
        (clsEq (sumE t (sumE u w)) (sumE (sumE t u) w) (Dx.addAssocP t u w))
        (sy (add (add (cls t) (cls u)) (cls w)) (cls (sumE (sumE t u) w))
          (tr (add (add (cls t) (cls u)) (cls w)) (add (cls (sumE t u)) (cls w)) (cls (sumE (sumE t u) w))
            (addL (add (cls t) (cls u)) (cls (sumE t u)) (cls w) (add-beta t u))
            (add-beta (sumE t u) w))))) ;
  add-commC (t u : Term) : C.El Nl (IdQ (add (cls t) (cls u)) (add (cls u) (cls t))) =
   tr (add (cls t) (cls u)) (cls (sumE t u)) (add (cls u) (cls t)) (add-beta t u)
    (tr (cls (sumE t u)) (cls (sumE u t)) (add (cls u) (cls t)) (clsEq (sumE t u) (sumE u t) (Dx.addCommP t u)) (sy (add (cls u) (cls t)) (cls (sumE u t)) (add-beta u t))) ;
  mulR (q : Q) (q1 q2 : Q) (e : C.El Nl (IdQ q1 q2)) : C.El Nl (IdQ (mul q q1) (mul q q2)) =
   MP.apF Nl Qt Qt (OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q) q1 q2 e ;
  mulL (q1 q2 : Q) (q' : Q) (e : C.El Nl (IdQ q1 q2)) : C.El Nl (IdQ (mul q1 q') (mul q2 q')) =
   tr (mul q1 q') (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q1)) (mul q2 q')
    (ofEq (mul q1 q') (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q1)) (symH EvAt[q'].E.At[OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q1].val))
    (tr (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q1)) (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q2)) (mul q2 q')
      (MP.apF Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q1) (OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q2)
         (MP.apF Nl Qt (OV.Fun Nl Qt Qt) mulQ q1 q2 e))
      (ofEq (OV.app Nl (OV.Fun Nl Qt Qt) Qt EvAt[q'].E.evF (OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q2)) (mul q2 q') EvAt[q'].E.At[OV.app Nl Qt (OV.Fun Nl Qt Qt) mulQ q2].val)) ;
  -- a derivation between two terms, read as an Id between the classes of
  -- composite terms: the general pattern of the laws at constants
  mul-assocC (t u w : Term) : C.El Nl (IdQ (mul (cls t) (mul (cls u) (cls w))) (mul (mul (cls t) (cls u)) (cls w))) =
   tr (mul (cls t) (mul (cls u) (cls w))) (mul (cls t) (cls (mulE u w))) (mul (mul (cls t) (cls u)) (cls w))
    (mulR (cls t) (mul (cls u) (cls w)) (cls (mulE u w)) (mul-beta u w))
    (tr (mul (cls t) (cls (mulE u w))) (cls (mulE t (mulE u w))) (mul (mul (cls t) (cls u)) (cls w))
      (mul-beta t (mulE u w))
      (tr (cls (mulE t (mulE u w))) (cls (mulE (mulE t u) w)) (mul (mul (cls t) (cls u)) (cls w))
        (clsEq (mulE t (mulE u w)) (mulE (mulE t u) w) (Dx.mulAssocP t u w))
        (sy (mul (mul (cls t) (cls u)) (cls w)) (cls (mulE (mulE t u) w))
          (tr (mul (mul (cls t) (cls u)) (cls w)) (mul (cls (mulE t u)) (cls w)) (cls (mulE (mulE t u) w))
            (mulL (mul (cls t) (cls u)) (cls (mulE t u)) (cls w) (mul-beta t u))
            (mul-beta (mulE t u) w))))) ;
  mul-commC (t u : Term) : C.El Nl (IdQ (mul (cls t) (cls u)) (mul (cls u) (cls t))) =
   tr (mul (cls t) (cls u)) (cls (mulE t u)) (mul (cls u) (cls t)) (mul-beta t u)
    (tr (cls (mulE t u)) (cls (mulE u t)) (mul (cls u) (cls t)) (clsEq (mulE t u) (mulE u t) (Dx.mulCommP t u)) (sy (mul (cls u) (cls t)) (cls (mulE u t)) (mul-beta u t))) ;
  mul-oneC (t : Term) : C.El Nl (IdQ (mul (cls t) oneQ) (cls t)) =
   tr (mul (cls t) oneQ) (cls (mulE t Dx.oneE)) (cls t) (mul-beta t Dx.oneE) (clsEq (mulE t Dx.oneE) t (Dx.mulOneP t)) ;
  distrC (t u w : Term) : C.El Nl (IdQ (mul (cls t) (add (cls u) (cls w))) (add (mul (cls t) (cls u)) (mul (cls t) (cls w)))) =
   tr (mul (cls t) (add (cls u) (cls w))) (mul (cls t) (cls (sumE u w))) (add (mul (cls t) (cls u)) (mul (cls t) (cls w)))
    (mulR (cls t) (add (cls u) (cls w)) (cls (sumE u w)) (add-beta u w))
    (tr (mul (cls t) (cls (sumE u w))) (cls (mulE t (sumE u w))) (add (mul (cls t) (cls u)) (mul (cls t) (cls w)))
      (mul-beta t (sumE u w))
      (tr (cls (mulE t (sumE u w))) (cls (sumE (mulE t u) (mulE t w))) (add (mul (cls t) (cls u)) (mul (cls t) (cls w)))
        (clsEq (mulE t (sumE u w)) (sumE (mulE t u) (mulE t w)) (Dx.distribP t u w))
        (sy (add (mul (cls t) (cls u)) (mul (cls t) (cls w))) (cls (sumE (mulE t u) (mulE t w)))
          (tr (add (mul (cls t) (cls u)) (mul (cls t) (cls w))) (add (cls (mulE t u)) (mul (cls t) (cls w))) (cls (sumE (mulE t u) (mulE t w)))
            (addL (mul (cls t) (cls u)) (cls (mulE t u)) (mul (cls t) (cls w)) (mul-beta t u))
            (tr (add (cls (mulE t u)) (mul (cls t) (cls w))) (add (cls (mulE t u)) (cls (mulE t w))) (cls (sumE (mulE t u) (mulE t w)))
              (addR (cls (mulE t u)) (mul (cls t) (cls w)) (cls (mulE t w)) (mul-beta t w))
              (add-beta (mulE t u) (mulE t w))))))) ;
  -- the negative: - q := mul (cls (cst (neg 1))) q, and add t (neg t) = 0 at constants
  negQ (q : Q) : Q = mul (cls (cst (R.neg R.o))) q ;
  add-negC (t : Term) : C.El Nl (IdQ (add (cls t) (negQ (cls t))) zeroQ) =
   tr (add (cls t) (negQ (cls t))) (add (cls t) (cls (Dx.negative t))) zeroQ
    (addR (cls t) (negQ (cls t)) (cls (Dx.negative t)) (mul-beta (cst (R.neg R.o)) t))
    (tr (add (cls t) (cls (Dx.negative t))) (cls (sumE t (Dx.negative t))) zeroQ (add-beta t (Dx.negative t)) (clsEq (sumE t (Dx.negative t)) Dx.zeroE (Dx.addNegP t))) ;
  -- the coefficient map and its laws at constants
  phiQ (r : R.R) : Q = cls (cst r) ;
  phi-addC (r r' : R.R) : C.El Nl (IdQ (phiQ (R.add r r')) (add (phiQ r) (phiQ r'))) =
   tr (phiQ (R.add r r')) (cls (sumE (cst r) (cst r'))) (add (phiQ r) (phiQ r'))
    (clsEq (cst (R.add r r')) (sumE (cst r) (cst r')) (Dx.symP (sumE (cst r) (cst r')) (cst (R.add r r')) (Dx.coeffAddP r r'))) (sy (add (phiQ r) (phiQ r')) (cls (sumE (cst r) (cst r'))) (add-beta (cst r) (cst r'))) ;
  phi-mulC (r r' : R.R) : C.El Nl (IdQ (phiQ (R.mul r r')) (mul (phiQ r) (phiQ r'))) =
   tr (phiQ (R.mul r r')) (cls (mulE (cst r) (cst r'))) (mul (phiQ r) (phiQ r'))
    (clsEq (cst (R.mul r r')) (mulE (cst r) (cst r')) (Dx.symP (mulE (cst r) (cst r')) (cst (R.mul r r')) (Dx.coeffMulP r r'))) (sy (mul (phiQ r) (phiQ r')) (cls (mulE (cst r) (cst r'))) (mul-beta (cst r) (cst r'))) ;
  -- the generators and the equations of x hold
  genQ (v : Dx.Vs) : Q = cls (var v) ;
  eqnC (p : Term) (m : Dx.Member p x.2) : C.El Nl (IdQ (cls p) zeroQ) = clsEq p Dx.zeroE (Dx.equationP p m) ;
  add-zeroC (t : Term) : C.El Nl (IdQ (add (cls t) zeroQ) (cls t)) =
   tr (add (cls t) zeroQ) (cls (sumE t Dx.zeroE)) (cls t) (add-beta t Dx.zeroE) (clsEq (sumE t Dx.zeroE) t (Dx.addZeroP t)) ;
 } ;
} ;
