-- CCmpK17.seg (canonicity-c2; (K) for cmpI, part 17): over GS, the Id
-- cmpI (z_t) = g in HTT (pairing CCmpK14.id1 and CCmpK16.id2 by CProdSet.PE),
-- read as the Id of the fibre of cmpI at (z_t, g).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module K17 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K14m = CCmpK14[a].K14[R, encK, pe, y] ;
 module K16m = CCmpK16[a].K16[R, encK, pe, y] ;
 module K12m = K14m.K12m ;
 module I = K12m.I ;
 Nl : C.Ctx = C.nil ;
 GS : C.Ctx = K12m.GS ;
 GB : C.Ctx = K12m.GB ;
 HS : C.Ty Nl = K12m.HS ;
 HT : C.Ty Nl = K12m.HT ;
 HTT : C.Ty Nl = K12m.HTT ;
 s0 : C.Sub GS Nl = K12m.s0 ;
 pp : C.Sub GS GB = K12m.pp ;
 HT0 : C.Ty GS = C.subT GS Nl HT s0 ;
 HS0 : C.Ty GS = C.subT GS Nl HS s0 ;
 HTT0 : C.Ty GS = C.subT GS Nl HTT s0 ;
 module PEm = CProdSet[a].PE[GS, HT0, HT0, K12m.c1, K12m.g1, K12m.c2, K12m.g2, K14m.id1, K16m.id2] ;
 SXY : C.Ty GS = PEm.SXY ;
 G0 : C.Ctx = C.ext GS HT0 ;
 Q2 : Id (C.Ty G0) (C.subT G0 (C.ext Nl HT) (OV.wkT Nl HT HT) (C.lift GS Nl HT s0)) (OV.wkT GS HT0 HT0) =
  transH (symH (C.subT-o G0 (C.ext Nl HT) Nl HT (C.p Nl HT) (C.lift GS Nl HT s0)))
   (transH (apH {C.Sub G0 Nl} {C.Ty G0} (\ s -> C.subT G0 Nl HT s)
             (L.sub-ext G0 Nl (C.o G0 (C.ext Nl HT) Nl (C.p Nl HT) (C.lift GS Nl HT s0)) (C.o G0 GS Nl s0 (C.p GS HT0)) (\ K w -> refl (s0.nt K w.1))))
     (C.subT-o G0 GS Nl HT s0 (C.p GS HT0))) ;
 PSig : Id (C.Ty GS) SXY HTT0 =
  transH (apH {C.Ty G0} {C.Ty GS} (\ B -> SS.Sig GS HT0 B) (symH Q2)) (symH (FibCwF[a, a+].fibSig.Sig-nat GS Nl HT (OV.wkT Nl HT HT) s0)) ;
 pc : C.El GS HTT0 = OV.trE GS SXY HTT0 PSig (PEm.P0.prN K12m.c1 K12m.c2) ;
 pg : C.El GS HTT0 = OV.trE GS SXY HTT0 PSig (PEm.P0.prN K12m.g1 K12m.g2) ;
 ip : C.El GS (IJ.IdT GS HTT0 pc pg) = CInjP[a].idFwdL GS SXY HTT0 PSig (PEm.P0.prN K12m.c1 K12m.c2) (PEm.P0.prN K12m.g1 K12m.g2) PEm.res ;
 pcr (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (HTT0.1.tob K w)) (pc.eob K w) (K12m.K9m.CI.nmap.nfun K w.1.1.1 (K12m.z.eob K w)) =
  transH (CAppRd[a].trE-rd GS SXY HTT0 PSig (PEm.P0.prN K12m.c1 K12m.c2) K w)
   (transH (CAppRd[a].same-rd GS SXY HTT0 PSig K w (refl (HTT0.1.tob K w)) ((PEm.P0.prN K12m.c1 K12m.c2).eob K w))
     (PEm.P0.prR K12m.c1 K12m.c2 K w)) ;
 pgr (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (HTT0.1.tob K w)) (pg.eob K w) w.1.1.2 =
  transH (CAppRd[a].trE-rd GS SXY HTT0 PSig (PEm.P0.prN K12m.g1 K12m.g2) K w)
   (transH (CAppRd[a].same-rd GS SXY HTT0 PSig K w (refl (HTT0.1.tob K w)) ((PEm.P0.prN K12m.g1 K12m.g2).eob K w))
     (PEm.P0.prR K12m.g1 K12m.g2 K w)) ;
} ;
