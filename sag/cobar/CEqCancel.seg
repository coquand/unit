-- CEqCancel.seg (canonicity-45; COBAR.md "Prop 58"): two out of three for
-- core's equivalence structures between fibrant types.  For natural maps
-- f : A -> B, g : B -> C with equivalence structures of g and of g . f,
-- f has one: with k the quasi-inverse of g . f and g' that of g (EqQinv),
-- f' = k . g, and
--   f' f = k (g f) ~ id                     (k's homotopy)
--   f f' ~ g' g f k g ~ g' g ~ id           (g's, then g f's, then g's)
-- composed by Kan composition in B (CHtpyOps Inv / WL / WR / Cat / Ret),
-- then QinvEq.QE.
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;
module FCw = FibCwF[a, l] ;
module FC = FCw.FC ;
module LR = CLocBoundRetr[a, l] ;
module OV = CwFOv.Ov[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module S4 = CwFS4.S4[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;
module RD = FibIdRd[a, l] ;
module QI = QinvEq[a, l] ;
module KI = CwFKrInv.KrInv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;

------------------------------------------------------------------------
-- a homotopy f ~ g as a pointwise identity of the bodies
module QP = CwFQP.QP[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module DR = CwFDer.Der[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;

-- an element of Fun P Q as a natural map
module EQ1 = EqQinv[a, l] ;
module QI2 = QinvEq[a, l] ;

module Cancel (G : PCtx) (A B C : FC.STy G) (f : HO.NMap[G, A.1, B.1]) (g : HO.NMap[G, B.1, C.1])
  (eg : CE.EquivOp G B.1 C.1 LR.Map[G, B.1, C.1, g].pmap)
  (egf : CE.EquivOp G A.1 C.1 LR.Map[G, A.1, C.1, HO.compN G A.1 B.1 C.1 f g].pmap) {
  gf : HO.NMap[G, A.1, C.1] = HO.compN G A.1 B.1 C.1 f g ;
  module Qg = EQ1.EQI[G, B, C, g, LR.Map[G, B.1, C.1, g].pmap, eg, \ W w -> refl (LR.Map[G, B.1, C.1, g].onE W w)] ;
  module Qgf = EQ1.EQI[G, A, C, gf, LR.Map[G, A.1, C.1, gf].pmap, egf, \ W w -> refl (LR.Map[G, A.1, C.1, gf].onE W w)] ;
  g' : HO.NMap[G, C.1, B.1] = Qg.gN ;
  k : HO.NMap[G, C.1, A.1] = Qgf.gN ;
  f' : HO.NMap[G, B.1, A.1] = HO.compN G B.1 C.1 A.1 g k ;
  cB : PB.CLine[l].Lines[G, B.1].CompK[PB.e0, PB.e1].Comp = B.2.1 ;
  -- f' f ~ id
  module E1 = HO.Ret[G, A.1, A.1, HO.compN G A.1 C.1 A.1 gf k, HO.idN G A.1, HO.compN G A.1 B.1 A.1 f f', HO.idN G A.1,
    \ I x a0 -> refl (k.nfun I x (g.nfun I x (f.nfun I x a0))), \ I x a0 -> refl a0, Qgf.eta] ;
  -- f f' ~ id
  ff : HO.NMap[G, B.1, B.1] = HO.compN G B.1 A.1 B.1 f' f ;
  gg : HO.NMap[G, B.1, B.1] = HO.compN G B.1 C.1 B.1 g g' ;
  M1 : HO.NMap[G, B.1, B.1] = HO.compN G B.1 B.1 B.1 ff gg ;
  module S1a = HO.WR[G, B.1, B.1, B.1, gg, HO.idN G B.1, ff, Qg.eta] ;
  module S1b = HO.Inv[G, B.1, B.1, HO.compN G B.1 B.1 B.1 ff gg, HO.compN G B.1 B.1 B.1 ff (HO.idN G B.1), cB, S1a.res] ;
  module S1 = HO.Ret[G, B.1, B.1, HO.compN G B.1 B.1 B.1 ff (HO.idN G B.1), HO.compN G B.1 B.1 B.1 ff gg, ff, M1,
    \ I x a0 -> refl (ff.nfun I x a0), \ I x a0 -> refl (M1.nfun I x a0), S1b.res] ;
  module S2a = HO.WL[G, C.1, C.1, B.1, HO.compN G C.1 A.1 C.1 k gf, HO.idN G C.1, g', Qgf.eps] ;
  module S2b = HO.WR[G, C.1, B.1, B.1, HO.compN G C.1 C.1 B.1 (HO.compN G C.1 A.1 C.1 k gf) g', HO.compN G C.1 C.1 B.1 (HO.idN G C.1) g', g, S2a.res] ;
  module S2 = HO.Ret[G, B.1, B.1, HO.compN G B.1 C.1 B.1 g (HO.compN G C.1 C.1 B.1 (HO.compN G C.1 A.1 C.1 k gf) g'),
    HO.compN G B.1 C.1 B.1 g (HO.compN G C.1 C.1 B.1 (HO.idN G C.1) g'), M1, gg,
    \ I x a0 -> refl (M1.nfun I x a0), \ I x a0 -> refl (gg.nfun I x a0), S2b.res] ;
  module C12 = HO.Cat[G, B.1, B.1, ff, M1, gg, cB, S1.res, S2.res] ;
  module C123 = HO.Cat[G, B.1, B.1, ff, gg, HO.idN G B.1, cB, C12.res, Qg.eta] ;
  -- the equivalence structure of f
  module QE = QI2.QE[G, A, B, f, f', E1.res, C123.res] ;
  eqf : CE.EquivOp G A.1 B.1 LR.Map[G, A.1, B.1, f].pmap = QE.qinvEq ;
} ;

-- an equivalence structure moves to a pointwise equal map
module RetEq (G : PCtx) (A B : PTy[G]) (al be : CP.PMap[G, A, B]) (e : CE.EquivOp G A B al)
  (sq : (W : Ob) (w : GPR.TyL[G, A].EI W) -> Id (GPR.TyL[G, B].EI W) (al.mE W w) (be.mE W w)) {
  module TA = GPR.TyL[G, A] ;
  module TB = GPR.TyL[G, B] ;
  module HC = PB.CHFibCart[l, l].HCart[G, A, B, be, G, A, B, al,
     \ W d -> d, \ V W g0 d -> refl (G.act V W g0 d),
     \ W v -> v, \ W v -> refl (TB.pr1 W v), \ V W g0 v -> refl (TB.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TB.pr X x u),
     \ W v -> v, \ W v -> refl (TA.pr1 W v), \ V W g0 v -> refl (TA.E.act V W g0 v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TA.pr X x u),
     \ W v -> symH (sq W v)] ;
  res : CE.EquivOp G A B be = HC.moveEq e ;
} ;
