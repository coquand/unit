-- CPshPathU.seg (canonicity-45; (B) stage 2(b), COBAR.md): the path type
-- Path A a b (CPathFib.PathT, paths valued in the total space) as a C-type,
-- and the C-uniformity of its compositions: mirror of CPathNat.PathNatC for
-- the C-action (not cartesian), with CPshFillU's maps for A.
--   PathC[G, A, a, b]   PathT : CTy[G], ty x = PathFib[G.ob x, A.ty x, a.el
--                       x, b.el x].PathT on the nose; the C-action maps the
--                       values of a path by A.tE (FMap.mapF), the point
--                       conditions by A.tE-pt and G.act's naturality, the
--                       ends by a.el-nat, b.el-nat; the laws by tp-ext
--   PU[G, A, a, b, d, kA, cuA].res   the compositions of Path at each x
--                       (CPathComp.PathC.comp from kA x) are C-uniform:
--                       the problem (CPathProb: the 3-sieve join) at the
--                       moved data is the moved problem (PM: pt, sd-eq,
--                       out by cuA and kop-cong), restriction commutes
--                       with the C-action of sides (inpEq), the composite
--                       paths agree value by value (H.val), hence as
--                       elements of the other end (H.res by readings)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module CPF = PB.CPathFib[l] ;

module PathUOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module FUm = CPshFillU[a, l].FillUOf[C] ;
 open P ;

 ------------------------------------------------------------------
 -- the path type of a C-type

 module PathC (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) {
  module PF (x : CO) { module F = CPF.PathFib[G.ob x, A.ty x, a0.el x, b0.el x] ; } ;
  module TA (x : CO) { module T = GPR.TyL[G.ob x, A.ty x] ; } ;
  ty (x : CO) : PTy[G.ob x] = PF[x].F.PathT ;

  -- the C-action on a path
  module TC (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (u : W0.Ix (PF[x].F.PT.tobP X g)) {
   gy : W0.Ix ((G.ob y).ob X) = (G.act y x f).nt X g ;
   L : W0.Ix (CL.FC[TA[y].T.E].ob X) = CL.FMap[TA[x].T.E, TA[y].T.E, A.tE y x f].mapF X u.1 ;
   res : W0.Ix (PF[y].F.PT.tobP X gy) =
    (L,
     (\ W h i -> transH (A.tE-pt y x f W (u.1.1 W h i)) (transH (apH ((G.act y x f).nt W) (u.2.1 W h i)) ((G.act y x f).nt-nat W X h g)),
      (transH (apH ((A.tE y x f).nt X) u.2.2.1) (a0.el-nat y x f X g),
       transH (apH ((A.tE y x f).nt X) u.2.2.2) (b0.el-nat y x f X g)))) ;
  } ;
  tEn (y x : CO) (f : CH y x) (X : Ob) (v : SigT (G.ob x) (ty x) X) : SigT (G.ob y) (ty y) X =
   pairE (G.ob y) (ty y) X ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v)) (TC[y, x, f, X, fstE (G.ob x) (ty x) X v, sndE (G.ob x) (ty x) X v].res) ;
  -- the values of a moved path are A.tE of the values
  val-C (y x : CO) (f : CH y x) (X : Ob) (v : SigT (G.ob x) (ty x) X) (W : Ob) (h : Hom W X) (i : Hom W Iv)
   : Id (TA[y].T.EI W) ((PF[y].F.PT.TP.pr2 X (tEn y x f X v)).1.1 W h i) ((A.tE y x f).nt W ((PF[x].F.PT.TP.pr2 X v).1.1 W h i)) =
   refl ((A.tE y x f).nt W ((PF[x].F.PT.TP.pr2 X v).1.1 W h i)) ;

  tEnP (y x : CO) (f : CH y x) : PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y)] =
   new PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y), tEn y x f,
    \ V X h v -> PF[y].F.PT.tp-ext V (tEn y x f V ((extP (G.ob x) (ty x)).act V X h v)) ((extP (G.ob y) (ty y)).act V X h (tEn y x f X v))
       ((G.act y x f).nt-nat V X h (fstE (G.ob x) (ty x) X v))
       (\ V' h' j -> refl ((A.tE y x f).nt V' ((PF[x].F.PT.TP.pr2 X v).1.1 V' (compH V' V X h h') j)))] ;
  PathT : CTy[G] =
   new CTy[G, ty, tEnP,
    \ y x f X v -> refl ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v)),
    \ x X v -> PF[x].F.PT.tp-ext X (tEn x x (cid x) X v) v (G.act-id x X (fstE (G.ob x) (ty x) X v))
       (\ V h j -> A.tE-id x V ((PF[x].F.PT.TP.pr2 X v).1.1 V h j)),
    \ z y x f h X v -> PF[z].F.PT.tp-ext X (tEn z x (co z y x f h) X v) (tEn z y h X (tEn y x f X v)) (G.act-o z y x f h X (fstE (G.ob x) (ty x) X v))
       (\ V h' j -> A.tE-o z y x f h V ((PF[x].F.PT.TP.pr2 X v).1.1 V h' j))] ;
 } ;

 ------------------------------------------------------------------
 -- the compositions of Path are C-uniform

 module PU (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) (d : Bool)
  (kA : (x : CO) -> CL.Lines[G.ob x, A.ty x].CompK[PB.src d, PB.tgt d].Comp) (cuA : LO.UF[G, A].UComp (PB.src d) (PB.tgt d) kA) {
  module PC = PathC[G, A, a0, b0] ;
  module FA = FUm.FU[G, A, d, kA, cuA] ;
  module Px (x : CO) {
   module F = PC.PF[x].F ;
   module Pm = F.C[PB.src d, PB.tgt d, kA x].PC ;
   module PR = Pm.PR ;
   module TA = GPR.TyL[G.ob x, A.ty x] ;
  } ;
  kP (x : CO) : CL.Lines[G.ob x, PC.ty x].CompK[PB.src d, PB.tgt d].Comp = Px[x].Pm.comp ;
  module SFP = LO.SF[G, PC.PathT, PB.src d] ;
  module AEP = SFP.AE' ;
  module AEP' = LO.AE[G, PC.PathT, PB.tgt d] ;
  module SCP = LO.SC[SFP.TVC, LO.LinC G, LO.pPC (LO.LinC G) AEP.AevC, AEP'.AevC] ;
  module MP (y x : CO) (f : CH y x) { module M = MapSide[SFP.TVC, SFP.SFC, y, x, f] ; } ;
  tvP (y x : CO) (f : CH y x) (X : Ob) (w : Px[x].PR.CP.TV.EI X) : Px[y].PR.CP.TV.EI X = AEP.tEv y x f X w ;
  tsP (y x : CO) (f : CH y x) (X : Ob) (u : Px[x].PR.CP.TS.EI X) : Px[y].PR.CP.TS.EI X = SFP.tES y x f X u ;
  tvP-nat (y x : CO) (f : CH y x) (V X : Ob) (g : Hom V X) (w : Px[x].PR.CP.TV.EI X)
   : Id (Px[y].PR.CP.TV.EI V) (tvP y x f V (Px[x].PR.CP.TV.E.act V X g w)) (Px[y].PR.CP.TV.E.act V X g (tvP y x f X w)) =
   (AEP.tEvP y x f).nt-nat V X g w ;

  ------------------------------------------------------------------
  -- the problem moves

  module PM (y x : CO) (f : CH y x) (V0 : Ob) (w : Px[x].PR.CP.TV.EI V0) (p : Px[x].PR.CP.PT.Side[V0, w]) (i : Hom V0 Iv) {
   module Xs = Px[x] ;
   module Ys = Px[y] ;
   msd : Ys.PR.CP.PT.Side[V0, tvP y x f V0 w] = MP[y, x, f].M.mapside V0 w p ;
   module Q' = Xs.PR.Prob[V0, w, p, i] ;
   module Q = Ys.PR.Prob[V0, tvP y x f V0 w, msd, i] ;

   pt : Id (Ys.PR.CA.TV.EI V0) (FA.tv y x f V0 Q'.x') Q.x' =
    Ys.PR.CA.tv-eq V0 (FA.tv y x f V0 Q'.x') Q.x'
     (Ys.PR.FG.fam-eq V0 (Ys.PR.CA.TV.pr1 V0 (FA.tv y x f V0 Q'.x')) (Ys.PR.CA.TV.pr1 V0 Q.x')
        (\ V' h j -> (G.act y x f).nt-nat V' V' (idH V') ((Xs.PR.CP.TV.pr1 V0 w).1 V' h j)))
     (calc (Ys.TA.EI V0) {
         Ys.PR.CA.endE V0 (FA.tv y x f V0 Q'.x')
       =< FA.AEe.endEv y x f V0 Q'.x' >
         FA.ta y x f V0 (Xs.PR.CA.endE V0 Q'.x')
       =< apH (FA.ta y x f V0) Q'.x'-E >
         FA.ta y x f V0 (Q'.p.1.1 V0 (idH V0) i)
       =< symH (apH (\ z -> (Ys.PR.TP.pr2 V0 z).1.1 V0 (idH V0) i) (AEP.endEv y x f V0 w)) >
         Q.p.1.1 V0 (idH V0) i
       =< symH Q.x'-E >
         Ys.PR.CA.endE V0 Q.x' }) ;

   Qe1 : (n : Nat) -> Id (PB.Phi V0) (Q'.pick1 n).pQ (Q.pick1 n).pQ = split {
    zero -> refl (PB.pre V0 Iv i (PFO.ptSO PB.e1)) ;
    suc m -> refl p.pQ } ;
   Qe : (n : Nat) -> Id (PB.Phi V0) (Q'.pick n).pQ (Q.pick n).pQ = split {
    zero -> refl (PB.pre V0 Iv i (PFO.ptSO PB.e0)) ;
    suc m -> Qe1 m } ;
   eQ : Id (PB.Phi V0) Q'.side.pQ Q.side.pQ =
    apH (\ F -> PB.bigU V0 (suc (suc (suc zero))) F)
     (funext (Arith[a].Fin (suc (suc (suc zero)))) (\ q -> PB.Phi V0) Q'.J.Qs Q.J.Qs (\ q -> Qe q.1)) ;

   -- the points of the sides
   ptG (S' : Xs.PR.CA.PT.Side[V0, Q'.x']) (S : Ys.PR.CA.PT.Side[V0, Q.x']) (V' : Ob) (h : Hom V' V0)
    (b'' : PB.Lands V' V0 S'.pQ h) (b' : PB.Lands V' V0 S.pQ h)
    : Id (Ys.PR.CA.TV.EI V') (Ys.PR.CA.TS.pr1 V' (FA.ts y x f V' (S'.pv V' h b''))) (Ys.PR.CA.TS.pr1 V' (S.pv V' h b')) =
    transH (apH (FA.tv y x f V') (S'.ppt V' h b''))
     (transH (FA.tv-nat y x f V' V0 h Q'.x')
       (transH (apH (Ys.PR.CA.TV.E.act V' V0 h) pt) (symH (S.ppt V' h b')))) ;

   -- a side whose lines are constant at a family of elements, moved
   vB (S' : Xs.PR.CA.PT.Side[V0, Q'.x']) (S : Ys.PR.CA.PT.Side[V0, Q.x']) (V' : Ob) (h : Hom V' V0)
    (b'' : PB.Lands V' V0 S'.pQ h) (b' : PB.Lands V' V0 S.pQ h)
    (cE' : (V2 : Ob) -> W0.Ix ((G.ob x).ob V2) -> Xs.TA.EI V2) (cE : (V2 : Ob) -> W0.Ix ((G.ob y).ob V2) -> Ys.TA.EI V2)
    (cM : (V2 : Ob) (y2 : W0.Ix ((G.ob x).ob V2)) -> Id (Ys.TA.EI V2) (FA.ta y x f V2 (cE' V2 y2)) (cE V2 ((G.act y x f).nt V2 y2)))
    (lv' : (V'' : Ob) (g' : Hom V'' V') (j : Hom V'' Iv)
       -> Id (Xs.TA.EI V'') (Xs.PR.FA.lval V' (Xs.PR.CA.lineL V' (S'.pv V' h b'')) V'' g' j) (cE' V'' (Q'.kL V'' (compH V'' V' V0 h g') j)))
    (lv : (V'' : Ob) (g' : Hom V'' V') (j : Hom V'' Iv)
       -> Id (Ys.TA.EI V'') (Ys.PR.FA.lval V' (Ys.PR.CA.lineL V' (S.pv V' h b')) V'' g' j) (cE V'' (Q.kL V'' (compH V'' V' V0 h g') j)))
    : Id (Ys.PR.CA.TS.EI V') (FA.ts y x f V' (S'.pv V' h b'')) (S.pv V' h b') =
    Ys.PR.CA.ts-ext V' (FA.ts y x f V' (S'.pv V' h b'')) (S.pv V' h b') (ptG S' S V' h b'' b')
     (\ V'' g' j ->
      transH (apH (FA.ta y x f V'') (lv' V'' g' j))
        (transH (cM V'' (Q'.kL V'' (compH V'' V' V0 h g') j)) (symH (lv V'' g' j)))) ;

   -- the side read along the given lines, moved
   vS (V' : Ob) (h : Hom V' V0) (b'' : PB.Lands V' V0 p.pQ h) (b' : PB.Lands V' V0 p.pQ h)
    : Id (Ys.PR.CA.TS.EI V') (FA.ts y x f V' (Q'.SL.pv V' h b'')) (Q.SL.pv V' h b') =
    Ys.PR.CA.ts-ext V' (FA.ts y x f V' (Q'.SL.pv V' h b'')) (Q.SL.pv V' h b') (ptG Q'.SL.side Q.SL.side V' h b'' b')
     (\ V'' g' j ->
      calc (Ys.TA.EI V'') {
          Ys.PR.FA.lval V' (Ys.PR.CA.lineL V' (FA.ts y x f V' (Q'.SL.pv V' h b''))) V'' g' j
        =< apH (FA.ta y x f V'') (Q'.SL.pv-lev V' h b'' V'' g' j) >
          FA.ta y x f V'' ((Xs.PR.TP.pr2 V'' (Xs.PR.lvP V' (p.pv V' h b'') V'' g' j)).1.1 V'' (idH V'') (Q'.ic V' h V'' g'))
        =< apH (\ u -> FA.ta y x f V'' ((Xs.PR.TP.pr2 V'' (Xs.PR.lvP V' u V'' g' j)).1.1 V'' (idH V'') (Q'.ic V' h V'' g'))) (Xs.PR.CP.PT.pv-irr V0 w p V' h b'' b') >
          FA.ta y x f V'' ((Xs.PR.TP.pr2 V'' (Xs.PR.lvP V' (p.pv V' h b') V'' g' j)).1.1 V'' (idH V'') (Q'.ic V' h V'' g'))
        =< symH (Q.SL.pv-lev V' h b' V'' g' j) >
          Ys.PR.FA.lval V' (Ys.PR.CA.lineL V' (Q.SL.pv V' h b')) V'' g' j }) ;

   vEq1 : (n : Nat) (V' : Ob) (h : Hom V' V0) (b1 : PB.Lands V' V0 (Q'.pick1 n).pQ h) (b' : PB.Lands V' V0 (Q.pick1 n).pQ h)
    -> Id (Ys.PR.CA.TS.EI V') (FA.ts y x f V' ((Q'.pick1 n).pv V' h b1)) ((Q.pick1 n).pv V' h b') = split {
    zero -> \ V' h bz b' ->
     vB Q'.B1.side Q.B1.side V' h bz b' Xs.PR.PT.bE Ys.PR.PT.bE (b0.el-nat y x f)
      (\ V'' g' j -> Q'.B1.pv-lev V' h bz V'' g' j) (\ V'' g' j -> Q.B1.pv-lev V' h b' V'' g' j) ;
    suc m -> \ V' h b'' b' -> vS V' h b'' b' } ;
   vEq : (n : Nat) (V' : Ob) (h : Hom V' V0) (b1 : PB.Lands V' V0 (Q'.pick n).pQ h) (b' : PB.Lands V' V0 (Q.pick n).pQ h)
    -> Id (Ys.PR.CA.TS.EI V') (FA.ts y x f V' ((Q'.pick n).pv V' h b1)) ((Q.pick n).pv V' h b') = split {
    zero -> \ V' h b'' b' ->
     vB Q'.B0.side Q.B0.side V' h b'' b' Xs.PR.PT.aE Ys.PR.PT.aE (a0.el-nat y x f)
      (\ V'' g' j -> Q'.B0.pv-lev V' h b'' V'' g' j) (\ V'' g' j -> Q.B0.pv-lev V' h b' V'' g' j) ;
    suc m -> vEq1 m } ;

   sd-eq : Id (Ys.PR.CA.PT.Side[V0, Q.x'])
            (subst (Ys.PR.CA.TV.EI V0) (\ z -> Ys.PR.CA.PT.Side[V0, z]) (FA.tv y x f V0 Q'.x') Q.x' pt (FA.MSd[y, x, f].M.mapside V0 Q'.x' Q'.side)) Q.side =
    Ys.PR.CA.PT.side-extH V0 (FA.tv y x f V0 Q'.x') Q.x' pt (FA.MSd[y, x, f].M.mapside V0 Q'.x' Q'.side) Q.side eQ
     (\ V' h h2 h' ->
      transH (vEq (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).1.1 V' h (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).2
                (PB.lands-sub V' V0 (Q'.pick (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).1.1).pQ
                   (Q.pick (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).1.1).pQ (Qe (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).1.1) h
                   (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).2))
        (symH (Q.J.pv-in (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).1 V' h
                (PB.lands-sub V' V0 (Q'.pick (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).1.1).pQ
                   (Q.pick (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).1.1).pQ (Qe (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).1.1) h
                   (PB.bigU-out V' V0 (suc (suc (suc zero))) Q'.J.Qs h h2).2) h'))) ;
   opaque pt ; opaque sd-eq ;

   -- the composites agree
   out : Id (Ys.TA.EI V0) (FA.ta y x f V0 (Xs.Pm.rd V0 (Xs.Pm.out V0 (w, p) i))) (Ys.Pm.rd V0 (Ys.Pm.out V0 (tvP y x f V0 w, msd) i)) =
    transH (symH (FA.rdC y x f V0 (Xs.Pm.out V0 (w, p) i)))
     (apH (Ys.Pm.rd V0)
       (transH (cuA y x f V0 Q'.x' Q'.side)
         (Ys.Pm.RCA.kop-cong (kA y) V0 (FA.tv y x f V0 Q'.x') Q.x' pt (FA.MSd[y, x, f].M.mapside V0 Q'.x' Q'.side) Q.side sd-eq))) ;
  } ;

  ------------------------------------------------------------------
  -- the composite paths agree

  inpEq (y x : CO) (f : CH y x) (X : Ob) (w : Px[x].PR.CP.TV.EI X) (sd : Px[x].PR.CP.PT.Side[X, w]) (V : Ob) (g : Hom V X)
   : Id (Px[y].Pm.In V)
      (tvP y x f V (Px[x].Pm.F[X, w, sd].inp V g).1, MP[y, x, f].M.mapside V (Px[x].Pm.F[X, w, sd].inp V g).1 (Px[x].Pm.F[X, w, sd].inp V g).2)
      (Px[y].Pm.F[X, tvP y x f X w, MP[y, x, f].M.mapside X w sd].inp V g) =
   Sigma-path (Px[y].PR.CP.TV.EI V) (\ z -> Px[y].PR.CP.PT.Side[V, z])
    (tvP y x f V (Px[x].PR.CP.TV.E.act V X g w)) (Px[y].PR.CP.TV.E.act V X g (tvP y x f X w))
    (MP[y, x, f].M.mapside V (Px[x].PR.CP.TV.E.act V X g w) (Px[x].PR.CP.PT.rside V X g w sd))
    (Px[y].PR.CP.PT.rside V X g (tvP y x f X w) (MP[y, x, f].M.mapside X w sd))
    (tvP-nat y x f V X g w)
    (Px[y].PR.CP.PT.side-extH V (tvP y x f V (Px[x].PR.CP.TV.E.act V X g w)) (Px[y].PR.CP.TV.E.act V X g (tvP y x f X w)) (tvP-nat y x f V X g w)
      (MP[y, x, f].M.mapside V (Px[x].PR.CP.TV.E.act V X g w) (Px[x].PR.CP.PT.rside V X g w sd))
      (Px[y].PR.CP.PT.rside V X g (tvP y x f X w) (MP[y, x, f].M.mapside X w sd))
      (refl (PB.pre V X g sd.pQ))
      (\ W h i i' -> apH (tsP y x f W) (Px[x].PR.CP.PT.pv-irr X w sd W (compH W V X g h) i i'))) ;
  opaque inpEq ;

  module H (y x : CO) (f : CH y x) (X : Ob) (w : Px[x].PR.CP.TV.EI X) (sd : Px[x].PR.CP.PT.Side[X, w]) {
   module Xs = Px[x] ;
   module Ys = Px[y] ;
   msd : Ys.PR.CP.PT.Side[X, tvP y x f X w] = MP[y, x, f].M.mapside X w sd ;
   val (V : Ob) (g : Hom V X) (j : Hom V Iv)
    : Id (Ys.TA.EI V) (FA.ta y x f V (Xs.Pm.F[X, w, sd].t V g j)) (Ys.Pm.F[X, tvP y x f X w, msd].t V g j) =
    transH (PM[y, x, f, V, (Xs.Pm.F[X, w, sd].inp V g).1, (Xs.Pm.F[X, w, sd].inp V g).2, j].out)
      (apH (\ z -> Ys.Pm.rd V (Ys.Pm.out V z j)) (inpEq y x f X w sd V g)) ;
   -- the moved composite, read at the other end, is the composite of the moved data
   res : Id (SigT (SFP.TVC.ob y) (SCP.ST y) X)
          (SCP.tEs y x f X (Xs.Pm.TT.pr X w (Xs.Pm.kop X w sd)))
          (Ys.Pm.TT.pr X (tvP y x f X w) (Ys.Pm.kop X (tvP y x f X w) msd)) =
    SCP.sub-eq y X (SCP.tEs y x f X (Xs.Pm.TT.pr X w (Xs.Pm.kop X w sd))) (Ys.Pm.TT.pr X (tvP y x f X w) (Ys.Pm.kop X (tvP y x f X w) msd))
     (refl ((SFP.TVC.act y x f).nt X w))
     (CL.EndKit[G.ob y, PC.ty y, PB.tgt d].tv-eq X
        (SCP.rB y X (SCP.tEs y x f X (Xs.Pm.TT.pr X w (Xs.Pm.kop X w sd))))
        (SCP.rB y X (Ys.Pm.TT.pr X (tvP y x f X w) (Ys.Pm.kop X (tvP y x f X w) msd)))
        (refl (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X (Xs.PR.CP.TV.pr1 X w)))
        (Ys.F.PT.tp-ext X
           (CL.EndKit[G.ob y, PC.ty y, PB.tgt d].endE X (SCP.rB y X (SCP.tEs y x f X (Xs.Pm.TT.pr X w (Xs.Pm.kop X w sd)))))
           (CL.EndKit[G.ob y, PC.ty y, PB.tgt d].endE X (SCP.rB y X (Ys.Pm.TT.pr X (tvP y x f X w) (Ys.Pm.kop X (tvP y x f X w) msd))))
           (refl ((Ys.PR.FK.ev (PB.tgt d)).nt X (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X (Xs.PR.CP.TV.pr1 X w))))
           (\ V g j ->
            transH (apH (\ z -> (Ys.PR.TP.pr2 X (CL.EndKit[G.ob y, PC.ty y, PB.tgt d].endE X z)).1.1 V g j) (SCP.rBtE y x f X (Xs.Pm.TT.pr X w (Xs.Pm.kop X w sd))))
              (transH (apH (\ z -> (Ys.PR.TP.pr2 X z).1.1 V g j) (AEP'.endEv y x f X (SCP.rB x X (Xs.Pm.TT.pr X w (Xs.Pm.kop X w sd)))))
                (val V g j))))) ;
  } ;

  res : LO.UF[G, PC.PathT].UComp (PB.src d) (PB.tgt d) kP = \ y x f X w sd -> H[y, x, f, X, w, sd].res ;
 } ;
} ;
