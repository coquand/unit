-- CDCg6.seg (canonicity-c2; (d), congruence part 6): ev_t at two valuations
-- of nil.HomT(s, y) that agree (by Ids) at the generators agree, for every
-- term t, by recursion on t (CDCg1-5).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module Cg6 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (s2 : C.Sub (C.ext C.nil (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT)) (CSolT[a].SolOf[R, encK, pe, s, (zero, nil), y].EV.Gk s.1)) {
 module C3 = CDCg3[a].Cg3[R, encK, pe, s, y, s2] ;
 module C1 = C3.C1 ;
 module DE5m = C1.DE5m ;
 module D = C1.D ;
 module EV = D.EV ;
 Nl : C.Ctx = C.nil ;
 n : Nat = D.n ;
 HS : C.Ty Nl = D.HS ;
 QY : C.Ty Nl = D.QY ;
 D1 : C.Ctx = D.D1 ;
 QYd : C.Ty D1 = D.QYd ;
 Tm : U a = C1.Tm ;
 module OA = DE5m.OA ;
 module OM = DE5m.OM ;
 module C4 = CDCg4[a].Cg4[R, encK, pe, s, y, s2] ;
 module C5 = CDCg5[a].Cg5[R, encK, pe, s, y, s2] ;
 module Rec (eqV : (i : SX.Fin n) -> C.El D1 (C1.CE (var i))) {
  cg : (t : Tm) -> C.El D1 (C1.CE t) = split {
   var v -> eqV v ;
   cst r -> C1.cgC r ;
   sumE p q | hp hq -> C3.B[D.HZ.AT.O.addQ, p, q, sumE p q, hp, hq, C4.rLA p q, C4.rRA p q].res ;
   mulE p q | hp hq -> C3.B[D.HZ.AT.O.mulQ, p, q, mulE p q, hp, hq, C5.rLM p q, C5.rRM p q].res } ;
 } ;
} ;
