-- CEv4.seg (canonicity-c2; HomT(F1, y) ~ Q_y, part 4): over GB.S (q, and t
-- with cls t = q), the fibre element (h_t, ev h_t = q) of the evaluation.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module E4 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module E2m = CEv2[a].E2[R, encK, pe, y] ;
 module E3m = CEv3[a].E3[R, encK, pe, y] ;
 module I = E2m.PFm.I ;
 module QS = CQSurj[a].QSurj[R, encK, pe, y] ;
 Nl : C.Ctx = C.nil ;
 GB : C.Ctx = I.GB ;
 S : C.Ty GB = QS.S ;
 GS : C.Ctx = C.ext GB S ;
 pS : C.Sub GS GB = C.p GB S ;
 -- the t of a point, and the Id component e : cls t = q, semantically
 piN (K : Ob) (w : V1.Ix (GS.ob K)) : V1.Ix (QS.E.ob K) = (w.1, w.2.1) ;
 pi : C.Sub GS QS.E = new L.PSub[GS, QS.E, piN, \ J I f w -> refl (piN J (GS.act J I f w))] ;
 IdEs : C.Ty GS = C.subT GS QS.E QS.IdE pi ;
 eN (J I : Ob) (f : Hom J I) (w : V1.Ix (GS.ob I))
   : Id (V1.Ix (IdEs.1.tob J (GS.act J I f w))) (IdEs.1.tact J I f w (GS.act J I f w) (refl (GS.act J I f w)) w.2.2) (GS.act J I f w).2.2 =
  L.tact-irr QS.E QS.IdE.1 J I f (piN I w) (piN J (GS.act J I f w))
    (L.ntEq GS QS.E pi J I f w (GS.act J I f w) (refl (GS.act J I f w)))
    (L.pair-act GB QS.TmG.1 J I f w.1 (GB.act J I f w.1) (refl (GB.act J I f w.1)) w.2.1)
    w.2.2 ;
 eS : C.El GS IdEs = L.mkPEl GS IdEs.1 (\ K w -> w.2.2) (\ J I f w w' e ->
  idJ (V1.Ix (GS.ob J)) (GS.act J I f w) (\ w2 e2 -> Id (V1.Ix (IdEs.1.tob J w2)) (IdEs.1.tact J I f w w2 e2 w.2.2) w2.2.2)
    (eN J I f w) w' e) ;
 -- moving elements of Q_y-types to one type over GS
 QY : C.Ty Nl = I.B ;
 s0 : C.Sub GS Nl = C.o GS GB Nl (C.p Nl QY) pS ;
 QS0 : C.Ty GS = C.subT GS Nl QY s0 ;
 toQ (Z : C.Ctx) (T : C.Ty Z) (sZ : C.Sub Z Nl) (PTy : Id (C.Ty Z) T (C.subT Z Nl QY sZ)) (s : C.Sub GS Z)
   (hp : (K : Ob) (w : V1.Ix (GS.ob K)) -> Id (V1.Ix (Nl.ob K)) ((C.o GS Z Nl sZ s).nt K w) (s0.nt K w)) : Id (C.Ty GS) (C.subT GS Z T s) QS0 =
  transH (apH {C.Ty Z} {C.Ty GS} (\ X -> C.subT GS Z X s) PTy)
   (transH (symH (C.subT-o GS Z Nl QY sZ s)) (apH {C.Sub GS Nl} {C.Ty GS} (\ r -> C.subT GS Nl QY r) (L.sub-ext GS Nl (C.o GS Z Nl sZ s) s0 hp))) ;
 module Mv (Z : C.Ctx) (T : C.Ty Z) (sZ : C.Sub Z Nl) (PTy : Id (C.Ty Z) T (C.subT Z Nl QY sZ)) (s : C.Sub GS Z)
   (hp : (K : Ob) (w : V1.Ix (GS.ob K)) -> Id (V1.Ix (Nl.ob K)) ((C.o GS Z Nl sZ s).nt K w) (s0.nt K w)) {
  P : Id (C.Ty GS) (C.subT GS Z T s) QS0 = toQ Z T sZ PTy s hp ;
  el (x : C.El Z T) : C.El GS QS0 = OV.trE GS (C.subT GS Z T s) QS0 P (C.subt GS Z T x s) ;
  idS (x x' : C.El Z T) (h : C.El GS (C.subT GS Z (IJ.IdT Z T x x') s)) : C.El GS (IJ.IdT GS QS0 (el x) (el x')) =
   CInjP[a].idFwdL GS (C.subT GS Z T s) QS0 P (C.subt GS Z T x s) (C.subt GS Z T x' s)
    (OV.trE GS (C.subT GS Z (IJ.IdT Z T x x') s) (IJ.IdT GS (C.subT GS Z T s) (C.subt GS Z T x s) (C.subt GS Z T x' s))
      (IJ.IdT-nat GS Z T x x' s) h) ;
  id (x x' : C.El Z T) (h : C.El Z (IJ.IdT Z T x x')) : C.El GS (IJ.IdT GS QS0 (el x) (el x')) =
   CInjP[a].idFwdL GS (C.subT GS Z T s) QS0 P (C.subt GS Z T x s) (C.subt GS Z T x' s)
    (OV.trE GS (C.subT GS Z (IJ.IdT Z T x x') s) (IJ.IdT GS (C.subT GS Z T s) (C.subt GS Z T x s) (C.subt GS Z T x' s))
      (IJ.IdT-nat GS Z T x x' s) (C.subt GS Z (IJ.IdT Z T x x') h s)) ;
 } ;
 -- the beta family and e, moved
 tauN (K : Ob) (w : V1.Ix (GS.ob K)) : V1.Ix (E3m.DT.ob K) = (w.1.1, w.2.1) ;
 tau : C.Sub GS E3m.DT = new L.PSub[GS, E3m.DT, tauN, \ J I f w -> refl (tauN J (GS.act J I f w))] ;
 module MB = Mv[E3m.DT, OV.wkT Nl E3m.Tm QY, C.p Nl E3m.Tm, refl (OV.wkT Nl E3m.Tm QY), tau, \ K w -> refl (s0.nt K w)] ;
 B1 : C.El GS (IJ.IdT GS QS0 (MB.el (E3m.Fam[QY, E3m.pA].el)) (MB.el (E3m.Fam[QY, E3m.cT].el))) =
  MB.id (E3m.Fam[QY, E3m.pA].el) (E3m.Fam[QY, E3m.cT].el) E3m.bfam ;
 module ME = Mv[QS.E, QS.T0, C.o QS.E QS.G1 Nl (C.p Nl QS.Qt) QS.pE, symH (C.subT-o QS.E QS.G1 Nl QS.Qt (C.p Nl QS.Qt) QS.pE), pi, \ K w -> refl (s0.nt K w)] ;
 B2 : C.El GS (IJ.IdT GS QS0 (ME.el QS.clsE) (ME.el QS.qE)) = ME.idS QS.clsE QS.qE eS ;
 -- cls t, two ways
 rC1 (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (QS0.1.tob K w)) ((MB.el (E3m.Fam[QY, E3m.cT].el)).eob K w) ((ME.el QS.clsE).eob K w) =
  transH (CAppRd[a].trE-rd GS (C.subT GS E3m.DT (OV.wkT Nl E3m.Tm QY) tau) QS0 MB.P (C.subt GS E3m.DT (OV.wkT Nl E3m.Tm QY) (E3m.Fam[QY, E3m.cT].el) tau) K w)
   (transH (CAppRd[a].same-rd GS (C.subT GS E3m.DT (OV.wkT Nl E3m.Tm QY) tau) QS0 MB.P K w (refl (QS0.1.tob K w)) ((E3m.Fam[QY, E3m.cT].el).eob K (tauN K w)))
     (transH (transH (CAppRd[a].trE-rd Nl (C.subT Nl QS.D1 (OV.wkT Nl QS.Tm QS.Qt) (C.sec Nl QS.Tm (QS.AX.RP.ct w.2.1))) QS.Qt (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl QS.Tm QS.Qt (QS.AX.RP.ct w.2.1))
                              (C.subt Nl QS.D1 (OV.wkT Nl QS.Tm QS.Qt) QS.QQ.cls (C.sec Nl QS.Tm (QS.AX.RP.ct w.2.1))) K w.1.1)
                    (CAppRd[a].same-rd Nl (C.subT Nl QS.D1 (OV.wkT Nl QS.Tm QS.Qt) (C.sec Nl QS.Tm (QS.AX.RP.ct w.2.1))) QS.Qt (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl QS.Tm QS.Qt (QS.AX.RP.ct w.2.1)) K w.1.1
                       (refl (QS.Qt.1.tob K w.1.1)) (QS.QQ.cls.eob K (w.1.1, (QS.AX.RP.ct w.2.1).eob K w.1.1))))
       (symH (transH (CAppRd[a].trE-rd GS (C.subT GS QS.E QS.T0 pi) QS0 ME.P (C.subt GS QS.E QS.T0 QS.clsE pi) K w)
          (transH (CAppRd[a].same-rd GS (C.subT GS QS.E QS.T0 pi) QS0 ME.P K w (refl (QS0.1.tob K w)) (QS.clsE.eob K (piN K w)))
            (transH (CAppRd[a].trE-rd QS.E (C.subT QS.E QS.D1 (OV.wkT Nl QS.Tm QS.Qt) QS.sg) QS.T0 QS.PC (C.subt QS.E QS.D1 (OV.wkT Nl QS.Tm QS.Qt) QS.QQ.cls QS.sg) K (piN K w))
               (CAppRd[a].same-rd QS.E (C.subT QS.E QS.D1 (OV.wkT Nl QS.Tm QS.Qt) QS.sg) QS.T0 QS.PC K (piN K w) (refl (QS.T0.1.tob K (piN K w))) (QS.QQ.cls.eob K (QS.sgN K (piN K w)))))))))) ;
 B12 : C.El GS (IJ.IdT GS QS0 (MB.el (E3m.Fam[QY, E3m.pA].el)) (ME.el QS.qE)) =
  PT.transM GS QS0 (MB.el (E3m.Fam[QY, E3m.pA].el)) (ME.el QS.clsE) (ME.el QS.qE)
   (CCmpU14[a].rwId GS QS0 (MB.el (E3m.Fam[QY, E3m.pA].el)) (MB.el (E3m.Fam[QY, E3m.pA].el)) (MB.el (E3m.Fam[QY, E3m.cT].el)) (ME.el QS.clsE)
      (\ K w -> refl ((MB.el (E3m.Fam[QY, E3m.pA].el)).eob K w)) rC1 B1)
   B2 ;
} ;
