-- CReadA.seg (canonicity-45; COBAR.md "comparison"): the reading of the
-- addition and multiplication on codes (CE1Copy.Fin's rdA / rdM): alpha
-- for codes out of any presentation, as a natural map into HomT.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;

module AN (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y' : SX.Over[R].Presentation) {
 module RH = CRestrHT[a].RHT[R, encK, pe, y'] ;
 module CM = RH.CM ;
 module HO = RH.HO ;
 Nl : L.PCtx = RH.Nl ;
 HT : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = CHomT3[a].HomP[R, encK, pe].Hom[s, y'].HomT ;
 Ac : L.PTy[Nl] = RH.ClT[CM.Yo[s].yoT].ty ;
 module FM = CHomT11[a].FromM[R, encK, pe, s, y'] ;
 module NN = CHomT16[a].Nat[R, encK, pe, s, y'] ;
 module FF = CM.MO.Fn[s, y'] ;
 resE (J I : Ob) (h : Hom J I) (m : FF.M I) : Id (FF.M J) (Ac.tact J I h tt tt (refl tt) m) (FF.res I J h m) =
  FF.mExt J (Ac.tact J I h tt tt (refl tt) m) (FF.res I J h m) (refl (FF.fpOf J (FF.res I J h m))) ;
 at (I : Ob) : (o : Top) -> V1.Ix (Ac.tob I o) -> V1.Ix (HT.1.tob I o) = split { tt -> \ m -> FM.alpha I m } ;
 anat (J I : Ob) (h : Hom J I) : (x : Top) (x' : Top) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h x) x') (m : V1.Ix (Ac.tob I x))
  -> Id (V1.Ix (HT.1.tob J x')) (HT.1.tact J I h x x' e (at I x m)) (at J x' (Ac.tact J I h x x' e m)) = split {
  tt -> split { tt -> \ e m -> transH (L.tact-irr Nl HT.1 J I h tt tt e (refl tt) (FM.alpha I m))
    (transH (symH (NN.aNat I J h m)) (apH {FF.M J} {V1.Ix (HT.1.tob J tt)} (FM.alpha J) (symH (resE J I h m)))) } } ;
 alphaN : HO.NMap[Nl, Ac, HT.1] = new HO.NMap[Nl, Ac, HT.1, at, \ J I h x x' e m -> anat J I h x x' e m] ;
} ;

-- the reading of one operation (io : F1 -> F2, its operation opA on Q_y'),
-- from the operation's reading on codes F2 -> y' (hOp) and cop's sections
module RA (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) (y' : SX.Over[R].Presentation) {
 module E = CE1Copy[a].E1C[R, encK, pe, al, eqal, commH, y'] ;
 module RD = CRead[a].RD[R, encK, pe, y'] ;
 module TP = CTrips[a].TR[R, encK, pe, y'] ;
 module HO = E.HO ;
 Nl : L.PCtx = E.Nl ;
 Qc : L.PTy[Nl] = E.Qc ;
 Ac : L.PTy[Nl] = E.Ac ;
 A2c : L.PTy[Nl] = E.A2c ;
 phi : HO.NMap[Nl, Qc, Ac] = RD.PH.phi ;
 cQ : PB.CLine[a+].Lines[Nl, Qc].CompK[PB.e0, PB.e1].Comp = RD.cQ ;
 -- evaluation of codes F1 -> y' at the generator
 evc : HO.NMap[Nl, Ac, Qc] = HO.compN Nl Ac RD.HT.1 Qc RD.alphaN RD.evN ;
 -- ev (phi q) ~ q
 module EP = HO.WR[Nl, Qc, Qc, Qc, HO.compN Nl Qc RD.HT.1 Qc RD.PH.invN RD.evN, HO.idN Nl Qc, HO.idN Nl Qc, TP.eps] ;
 pq (I : Ob) : (x : Top) (q : V1.Ix (Qc.tob I x)) -> Id (V1.Ix (Qc.tob I x)) (evc.nfun I x (phi.nfun I x q)) (RD.evN.nfun I x (RD.PH.invN.nfun I x q)) = split {
  tt -> \ q -> apH {V1.Ix (RD.HT.1.tob I tt)} {V1.Ix (Qc.tob I tt)} (RD.evN.nfun I tt) (RD.ab I tt (RD.PH.invN.nfun I tt q)) } ;
 module EPr = HO.Ret[Nl, Qc, Qc, HO.compN Nl Qc Qc Qc (HO.idN Nl Qc) (HO.compN Nl Qc RD.HT.1 Qc RD.PH.invN RD.evN), HO.compN Nl Qc Qc Qc (HO.idN Nl Qc) (HO.idN Nl Qc),
   HO.compN Nl Qc Ac Qc phi evc, HO.idN Nl Qc, pq, \ I x q -> refl q, EP.res] ;
 -- phi;evc ~ id on Q_y'
 phiev : L.PEl[L.extP Nl Qc, HO.HT[Nl, Qc, Qc, HO.compN Nl Qc Ac Qc phi evc, HO.idN Nl Qc].PT.PathP] = EPr.res ;
 -- the reading of an operation, from its reading on codes F2 -> y' (hOp) and cop's sections
 module Rd (cop : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, Ac]) -> HO.NMap[Nl, X, A2c])
   (sec1 : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, Ac]) -> L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, HO.compN Nl X A2c Ac (cop X f1 f2) E.p1c, f1].PT.PathP])
   (sec2 : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, Ac]) -> L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, HO.compN Nl X A2c Ac (cop X f1 f2) E.p2c, f2].PT.PathP]) {
  module OpR (io : (J : Ob) -> E.CM.MO.Fn[E.CM.F1, E.CM.F2].M J) (io-nat : (J K : Ob) (v : Hom K J) -> Id (E.CM.MO.Fn[E.CM.F1, E.CM.F2].M K) (E.CM.MO.Fn[E.CM.F1, E.CM.F2].res J K v (io J)) (io K))
    (opA : (I : Ob) (x : V1.Ix (Nl.ob I)) (a0 b0 : V1.Ix (Qc.tob I x)) -> V1.Ix (Qc.tob I x))
    (opAN : (J I : Ob) (f : Hom J I) (x : V1.Ix (Nl.ob I)) (y : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I f x) y) (a0 b0 : V1.Ix (Qc.tob I x))
       -> Id (V1.Ix (Qc.tob J y)) (Qc.tact J I f x y e (opA I x a0 b0)) (opA J y (Qc.tact J I f x y e a0) (Qc.tact J I f x y e b0)))
    (hOp : L.PEl[L.extP Nl A2c, HO.HT[Nl, A2c, Qc, HO.compN Nl A2c Ac Qc E.Op[io, io-nat].preC evc,
        CApOp2[a].AO[Nl, A2c, Qc, opA, opAN].OP (HO.compN Nl A2c Ac Qc E.p1c evc) (HO.compN Nl A2c Ac Qc E.p2c evc)].PT.PathP]) {
   preC : HO.NMap[Nl, A2c, Ac] = E.Op[io, io-nat].preC ;
   -- f' . evc ~ f, for f : X -> Q
   module Back (X : L.PTy[Nl]) (f : HO.NMap[Nl, X, Qc]) {
    module W = HO.WR[Nl, Qc, Qc, X, HO.compN Nl Qc Ac Qc phi evc, HO.idN Nl Qc, f, phiev] ;
    module RB = HO.Ret[Nl, X, Qc, HO.compN Nl X Qc Qc f (HO.compN Nl Qc Ac Qc phi evc), HO.compN Nl X Qc Qc f (HO.idN Nl Qc),
       HO.compN Nl X Ac Qc (HO.compN Nl X Qc Ac f phi) evc, f, \ I x a0 -> refl (evc.nfun I x (phi.nfun I x (f.nfun I x a0))), \ I x a0 -> refl (f.nfun I x a0), W.res] ;
    res : L.PEl[L.extP Nl X, HO.HT[Nl, X, Qc, HO.compN Nl X Ac Qc (HO.compN Nl X Qc Ac f phi) evc, f].PT.PathP] = RB.res ;
   } ;
   module At (X : L.PTy[Nl]) (f g : HO.NMap[Nl, X, Qc]) {
    module AOX = CApOp2[a].AO[Nl, X, Qc, opA, opAN] ;
    f' : HO.NMap[Nl, X, Ac] = HO.compN Nl X Qc Ac f phi ;
    g' : HO.NMap[Nl, X, Ac] = HO.compN Nl X Qc Ac g phi ;
    w : HO.NMap[Nl, X, A2c] = cop X f' g' ;
    e1 : HO.NMap[Nl, X, Qc] = HO.compN Nl X Ac Qc (HO.compN Nl X A2c Ac w E.p1c) evc ;
    e2 : HO.NMap[Nl, X, Qc] = HO.compN Nl X Ac Qc (HO.compN Nl X A2c Ac w E.p2c) evc ;
    lw : HO.NMap[Nl, X, Qc] = HO.compN Nl X Ac Qc (HO.compN Nl X A2c Ac w preC) evc ;
    sm : HO.NMap[Nl, X, Qc] = CApOp2[a].AO[Nl, X, Qc, opA, opAN].OP f g ;
    rw : HO.NMap[Nl, X, Qc] = HO.compN Nl X Ac Qc (HO.compN Nl X Qc Ac sm phi) evc ;
    -- the operation's reading at w
    module S1 = HO.WR[Nl, A2c, Qc, X, HO.compN Nl A2c Ac Qc preC evc,
       CApOp2[a].AO[Nl, A2c, Qc, opA, opAN].OP (HO.compN Nl A2c Ac Qc E.p1c evc) (HO.compN Nl A2c Ac Qc E.p2c evc), w, hOp] ;
    module R1 = HO.Ret[Nl, X, Qc, HO.compN Nl X A2c Qc w (HO.compN Nl A2c Ac Qc preC evc),
       HO.compN Nl X A2c Qc w (CApOp2[a].AO[Nl, A2c, Qc, opA, opAN].OP (HO.compN Nl A2c Ac Qc E.p1c evc) (HO.compN Nl A2c Ac Qc E.p2c evc)),
       lw, AOX.OP e1 e2, \ I x a0 -> refl (lw.nfun I x a0), \ I x a0 -> refl ((AOX.OP e1 e2).nfun I x a0), S1.res] ;
    -- the components: e1 ~ f, e2 ~ g
    module L1 = HO.WL[Nl, X, Ac, Qc, HO.compN Nl X A2c Ac w E.p1c, f', evc, sec1 X f' g'] ;
    module C1 = HO.Cat[Nl, X, Qc, e1, HO.compN Nl X Ac Qc f' evc, f, cQ, L1.res, Back[X, f].res] ;
    module L2 = HO.WL[Nl, X, Ac, Qc, HO.compN Nl X A2c Ac w E.p2c, g', evc, sec2 X f' g'] ;
    module C2 = HO.Cat[Nl, X, Qc, e2, HO.compN Nl X Ac Qc g' evc, g, cQ, L2.res, Back[X, g].res] ;
    module S2 = AOX.Ap[e1, f, e2, g, C1.res, C2.res] ;
    -- back to phi (f op g)
    module S3 = HO.Inv[Nl, X, Qc, rw, sm, cQ, Back[X, sm].res] ;
    module C3 = HO.Cat[Nl, X, Qc, lw, AOX.OP e1 e2, sm, cQ, R1.res, S2.res] ;
    module C4 = HO.Cat[Nl, X, Qc, lw, sm, rw, cQ, C3.res, S3.res] ;
    -- injectivity of the evaluation at the generator
    module R5 = HO.Ret[Nl, X, Qc, lw, rw,
       HO.compN Nl X RD.HT.1 Qc (HO.compN Nl X Ac RD.HT.1 (HO.compN Nl X A2c Ac w preC) RD.alphaN) RD.evN,
       HO.compN Nl X RD.HT.1 Qc (HO.compN Nl X Ac RD.HT.1 (HO.compN Nl X Qc Ac sm phi) RD.alphaN) RD.evN,
       \ I x a0 -> refl (lw.nfun I x a0), \ I x a0 -> refl (rw.nfun I x a0), C4.res] ;
    module AG = RD.Agree[TP.eta, X, HO.compN Nl X A2c Ac w preC, HO.compN Nl X Qc Ac sm phi, R5.res] ;
    res : L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, HO.compN Nl X A2c Ac w preC, HO.compN Nl X Qc Ac sm phi].PT.PathP] = AG.res ;
   } ;
  } ;
 } ;
 -- codes F2 -> y' as homs, and z : F2 -> y' at a closed class
 module A2 = AN[R, encK, pe, E.CM.F2, y'] ;
 module ZD = CReadOp[a].ZD[R, encK, pe, y'] ;
 module Z = ZD.Z ;
 cx : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil RD.E1v.QA = RD.E1v.cx ;
 -- evaluating the precomposition of m with a SubC code F1 -> F2 (map Ph)
 module PreRd (io : (J : Ob) -> E.CM.MO.Fn[E.CM.F1, E.CM.F2].M J) (io-nat : (J K : Ob) (v : Hom K J) -> Id (E.CM.MO.Fn[E.CM.F1, E.CM.F2].M K) (E.CM.MO.Fn[E.CM.F1, E.CM.F2].res J K v (io J)) (io K))
   (Ph : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (OV.Fun FibCwF[a, a+].fibCwF.nil RD.E1v.QA Z.QA))
   (ioE : (I : Ob) (f : Hom I I) (u : V1.Ix (RD.E1v.QA.1.tob I tt)) -> Id (V1.Ix (Z.QA.1.tob I tt)) ((io I).1.1 I f u) ((Ph.eob I tt).1 I f u)) {
  cp : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil Z.QA = OV.app FibCwF[a, a+].fibCwF.nil RD.E1v.QA Z.QA Ph cx ;
  fam (I : Ob) (m : V1.Ix (A2c.tob I tt)) (f : Hom I I) : V1.Ix (Qc.tob I tt) = m.1.1 I (idH I) ((Ph.eob I tt).1 I f (cx.eob I tt)) ;
  rdP (I : Ob) (m : V1.Ix (A2c.tob I tt)) : Id (V1.Ix (Qc.tob I tt)) (evc.nfun I tt (E.Op[io, io-nat].preC.nfun I tt m)) ((Z.ZA.apC cp).eob I (tt, A2.at I tt m)) =
   transH (apH {V1.Ix (Z.QA.1.tob I tt)} {V1.Ix (Qc.tob I tt)} (\ v -> m.1.1 I (idH I) v) (ioE I (compH I I I (idH I) (idH I)) (cx.eob I tt)))
   (transH (apH {Hom I I} {V1.Ix (Qc.tob I tt)} (fam I m) (comp-idl I I (idH I)))
    (transH (apH {V1.Ix (Z.QA.1.tob I tt)} {V1.Ix (Qc.tob I tt)} (\ v -> m.1.1 I (idH I) v) (symH (CAppRd[a].App0[RD.E1v.QA, Z.QA, Ph, cx].rd I tt)))
      (symH (Z.ZA.rdF cp I (tt, A2.at I tt m))))) ;
 } ;
 module PA = PreRd[E.CM.II.AddF.M.mor, E.CM.II.AddF.M.mor-nat, E.CM.II.AddF.SM.Phi, \ I f u -> refl ((E.CM.II.AddF.SM.Phi.eob I tt).1 I f u)] ;
 module P1 = PreRd[E.CM.II.I1.M.mor, E.CM.II.I1.M.mor-nat, E.CM.II.I1.SM.Phi, \ I f u -> refl ((E.CM.II.I1.SM.Phi.eob I tt).1 I f u)] ;
 module P2 = PreRd[E.CM.II.I2.M.mor, E.CM.II.I2.M.mor-nat, E.CM.II.I2.SM.Phi, \ I f u -> refl ((E.CM.II.I2.SM.Phi.eob I tt).1 I f u)] ;
 H1 : L.PTy[Nl] = Z.HS.1 ;
 -- z moved along the betas
 module MA = Z.Mv[PA.cp, ZD.AddD.q3, E.CM.II.AddF.SM.beta (var (inr tt))] ;
 module M1 = Z.Mv[P1.cp, ZD.q1, E.CM.II.I1.SM.beta (var (inr tt))] ;
 module M2 = Z.Mv[P2.cp, ZD.q2, E.CM.II.I2.SM.beta (var (inr tt))] ;
 module RA0 = Z.Rd[Z.ZA.apC PA.cp, Z.ZA.apC ZD.AddD.q3, MA.res] ;
 module RD0 = Z.Rd[ZD.AddD.DB.e1, ZD.AddD.DB.e3, ZD.AddD.res] ;
 module R10 = Z.Rd[Z.ZA.apC P1.cp, Z.ZA.apC ZD.q1, M1.res] ;
 module R20 = Z.Rd[Z.ZA.apC P2.cp, Z.ZA.apC ZD.q2, M2.res] ;
} ;
