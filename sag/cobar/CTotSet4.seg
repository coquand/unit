-- CTotSet4.seg (canonicity-c2; "D preserves h-sets", part 4): rho, the
-- element of D (IdA) at phi2 ((g , a) , a): at every index the
-- reflexivity of CTotSet3 at the diagonal point (as CobarIT's DEl, the
-- points of phi2 ((g , a) , a) being diagonal).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module ST4 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module S3 = CTotSet3[a, vl, l].ST3[C, G, A] ;
 module S1 = S3.S1 ;
 module P2 = S1.P2 ;
 module DI = CTotDProp3[a, vl, l].DP3[C, S1.GAA, S1.IdA].DA ;
 module D = DI.D ;
 pa1 (J : Ob) (z : DI.Obj J) (g : W0.Ix (S1.E1.ob (J, z))) : DI.Ez J z = S3.pa (J, z) g.1 ;
 module M (I : Ob) (x : DI.Obj I) (t : W0.Ix (P2.PR.Ext.ob (I, x))) {
  w : D.Ob' I x = S1.phi2.nt (I, x) (t, t.2) ;
  av : DI.TA I x w = \ q l -> S3.val (q.2.1, q.2.2.2.1) (w.1 q l).1 ;
  nat' : W0.Ix (DI.anatEq I x w av) = \ r l ->
   transH (S3.pa-act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (w.1 r.1 l).1)
    (apH {W0.Ix (S1.E1.ob (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} {DI.Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} (pa1 r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (w.2.1 r l)) ;
  face' : W0.Ix (DI.afaceEq I x w av) = \ r l ->
   apH {W0.Ix (S1.E1.ob (r.2.2.2.1, r.2.2.2.2.2.1))} {DI.Ez r.2.2.2.1 r.2.2.2.2.2.1} (pa1 r.2.2.2.1 r.2.2.2.2.2.1) (w.2.2.1 r l) ;
  top' : W0.Ix (DI.atopEq I x w av) = \ r l ->
   transH (apH {W0.Ix (S1.E1.ob (r.2.1, r.2.2.2.1))} {DI.Ez r.2.1 r.2.2.2.1} (pa1 r.2.1 r.2.2.2.1) (w.2.2.2 r l))
    (symH (S3.pa-act (r.2.1, r.2.2.2.1) (r.2.1, (D.topD I x r).1) (idH r.2.1, (D.topD I x r).2.2)
       (w.1 (r.1, r.2.1, r.2.2.1, (D.topD I x r).1, (D.topD I x r).2.1, r.2.2.2.2.2) l).1)) ;
  res : DI.TOb' I x w = (av, nat', face', top') ;
 } ;
 res (I : Ob) (x : DI.Obj I) (t : W0.Ix (P2.PR.Ext.ob (I, x))) : DI.TOb' I x M[I, x, t].w = M[I, x, t].res ;
 natAll (J0 I : Ob) (u0 : Hom J0 I) (y : DI.Obj J0) (x : DI.Obj I) (f0 : DI.VT.HomD J0 I u0 y x)
   (t : W0.Ix (P2.PR.Ext.ob (I, x))) (t' : W0.Ix (P2.PR.Ext.ob (J0, y)))
   (e : Id (D.Ob' J0 y) (D.act J0 I u0 y x f0 M[I, x, t].w) M[J0, y, t'].w)
   : Id (DI.TOb' J0 y M[J0, y, t'].w) (DI.TB[J0, I, u0, y, x, f0, M[I, x, t].w, M[J0, y, t'].w, e, res I x t].res) (res J0 y t') =
  DI.tob-eq J0 y M[J0, y, t'].w (DI.TB[J0, I, u0, y, x, f0, M[I, x, t].w, M[J0, y, t'].w, e, res I x t].res) (res J0 y t') (\ q l ->
   DI.pr-inj q.2.1 q.2.2.2.1 (M[J0, y, t'].w.1 q l) (DI.TB[J0, I, u0, y, x, f0, M[I, x, t].w, M[J0, y, t'].w, e, res I x t].a' q l)
     (M[J0, y, t'].av q l)
     (transH (DI.TB[J0, I, u0, y, x, f0, M[I, x, t].w, M[J0, y, t'].w, e, res I x t].pc q l)
        (apH {W0.Ix (S1.E1.ob (q.2.1, q.2.2.2.1))} {DI.Ez q.2.1 q.2.2.2.1} (pa1 q.2.1 q.2.2.2.1)
           (DI.TB[J0, I, u0, y, x, f0, M[I, x, t].w, M[J0, y, t'].w, e, res I x t].pe q l)))) ;
} ;
