-- CTotDProp4.seg (canonicity-c2; "D preserves propositions", the
-- statement): if U A is a proposition at the levelwise site (internally),
-- then D A is a proposition over D G at the total site (internally).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module DP4 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module P3 = CTotDProp3[a, vl, l].DP3[C, G, A] ;
 module TR = P3.TR ;
 module G0 = TR.G0 ;
 module PN0 = CwFPropNoU.PropNoU[l+, G0.fibCwF-T, G0.fibPi-T, G0.fibSig-T, G0.fibId-T, G0.nf-T] ;
 UG : G0.fibCwF-T.Ctx = TR.RS.rC P3.P1m.GP ;
 UA : G0.fibCwF-T.Ty UG = (TR.RS.rT P3.P1m.GP A.1, P3.U4.fibU P3.P1m.GP A.1 A.2) ;
 UGA : G0.fibCwF-T.Ctx = G0.fibCwF-T.ext UG UA ;
 UAW : G0.fibCwF-T.Ty UGA = G0.fibCwF-T.subT UGA UG UA (G0.fibCwF-T.p UG UA) ;
 D1 : TR.P0.PCtx = TR.RS.rC P3.P1m.EP ;
 S1 : TR.P0.PTy[D1] = TR.RS.rT P3.P1m.EP P3.P1m.A1 ;
 module TS0 = G0.GB.GPre[l].TyL[UGA, UAW.1] ;
 module At (pU : G0.fibCwF-T.El UG (PN0.isProp UG UA)) {
  k0 : G0.GB.CPartial[l].ContrOp UGA UAW.1 = G0.contrOp-T UGA UAW (PN0.selfContr UG UA pU) ;
  -- U (G.A) and U G . U A have the same points and actions (their law
  -- fields differ): move k0 along the identity
  module M = G0.GB.CMove[l, l].Mv[D1, S1, S1, G0.GB.CPartial[l].pmap-id D1 S1,
    UGA, UAW.1, UAW.1, G0.GB.CPartial[l].pmap-id UGA UAW.1,
    \ Wb x -> x, \ Vb Wb g x -> refl (UGA.act Vb Wb g x),
    \ Wb v -> v, \ Wb v -> refl v.1, \ Vb Wb g v -> refl (TS0.E.act Vb Wb g v),
    \ Wb v -> v, \ Wb v -> refl v.1, \ Vb Wb g v -> refl (TS0.E.act Vb Wb g v),
    \ Wb v v' Pp Q -> Q,
    \ X x u -> u, \ X x u -> refl (TS0.pr X x u), \ Wb v -> refl v, k0] ;
  al0 : G0.GB.CPartial[l].ContrOp D1 S1 = M.rc ;
  isPropD : P3.G1.fibCwF-T.El P3.DG (P3.At[al0].PN.isProp P3.DG P3.DAT) = P3.At[al0].isPropD ;
 } ;
} ;
