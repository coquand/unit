-- CCmpU18.seg (canonicity-c2; (K) for cmpI, part 18): a closed binary
-- operation applied over any context G (along e : G -> nil), its reading.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module OpH (G : C.Ctx) (Q : C.Ty C.nil) (op : C.El C.nil (OV.Fun C.nil Q (OV.Fun C.nil Q Q))) (e : C.Sub G C.nil) {
 module GS = CQCtx[a].G3Of[Q] ;
 module OS = GS.OpTy[op] ;
 module SO = CSemOp[a].SemOp[Q, op] ;
 Nl : C.Ctx = C.nil ;
 QG : C.Ty G = C.subT G Nl Q e ;
 module P2 (x y : C.El G QG) {
  n1 (K : Ob) (w : V1.Ix (G.ob K)) : V1.Ix (GS.G1.ob K) = (e.nt K w, x.eob K w) ;
  t1 (J I : Ob) (f : Hom J I) (w : V1.Ix (G.ob I)) : Id (V1.Ix (GS.G1.ob J)) (n1 J (G.act J I f w)) (GS.G1.act J I f (n1 I w)) =
   symH (transH (L.pair-act Nl Q.1 J I f (e.nt I w) (e.nt J (G.act J I f w)) (L.ntEq G Nl e J I f w (G.act J I f w) (refl (G.act J I f w))) (x.eob I w))
     (apH {V1.Ix (Q.1.tob J (e.nt J (G.act J I f w)))} {V1.Ix (GS.G1.ob J)} (\ v -> (e.nt J (G.act J I f w), v)) (x.enat J I f w (G.act J I f w) (refl (G.act J I f w))))) ;
  s1 : C.Sub G GS.G1 = new L.PSub[G, GS.G1, n1, t1] ;
  n2 (K : Ob) (w : V1.Ix (G.ob K)) : V1.Ix (GS.G2.ob K) = (n1 K w, y.eob K w) ;
  t2 (J I : Ob) (f : Hom J I) (w : V1.Ix (G.ob I)) : Id (V1.Ix (GS.G2.ob J)) (n2 J (G.act J I f w)) (GS.G2.act J I f (n2 I w)) =
   symH (transH (L.pair-act GS.G1 GS.Qw.1 J I f (n1 I w) (n1 J (G.act J I f w)) (L.ntEq G GS.G1 s1 J I f w (G.act J I f w) (refl (G.act J I f w))) (y.eob I w))
     (apH {V1.Ix (Q.1.tob J (e.nt J (G.act J I f w)))} {V1.Ix (GS.G2.ob J)} (\ v -> (n1 J (G.act J I f w), v))
        (transH (L.tact-irr Nl Q.1 J I f (e.nt I w) (e.nt J (G.act J I f w))
                   (L.ntEq GS.G1 Nl (L.pP Nl Q.1) J I f (n1 I w) (n1 J (G.act J I f w)) (L.ntEq G GS.G1 s1 J I f w (G.act J I f w) (refl (G.act J I f w))))
                   (L.ntEq G Nl e J I f w (G.act J I f w) (refl (G.act J I f w))) (y.eob I w))
          (y.enat J I f w (G.act J I f w) (refl (G.act J I f w)))))) ;
  s2 : C.Sub G GS.G2 = new L.PSub[G, GS.G2, n2, t2] ;
  s12 : C.Sub GS.G2 Nl = C.o GS.G2 GS.G1 Nl (C.p Nl Q) (C.p GS.G1 GS.Qw) ;
  PT2 : Id (C.Ty G) (C.subT G GS.G2 GS.Qw2 s2) QG =
   transH (apH {C.Ty GS.G2} {C.Ty G} (\ T -> C.subT G GS.G2 T s2) (symH (C.subT-o GS.G2 GS.G1 Nl Q (C.p Nl Q) (C.p GS.G1 GS.Qw))))
    (transH (symH (C.subT-o G GS.G2 Nl Q s12 s2))
      (apH {C.Sub G Nl} {C.Ty G} (\ s -> C.subT G Nl Q s) (transH (C.eps-uniq G (C.o G GS.G2 Nl s12 s2)) (symH (C.eps-uniq G e))))) ;
  val : C.El G QG = OV.trE G (C.subT G GS.G2 GS.Qw2 s2) QG PT2 (C.subt G GS.G2 GS.Qw2 OS.o12 s2) ;
  rd (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (QG.1.tob K w)) (val.eob K w) (SO.ev2 K (e.nt K w) (x.eob K w) (y.eob K w)) =
   transH (CAppRd[a].trE-rd G (C.subT G GS.G2 GS.Qw2 s2) QG PT2 (C.subt G GS.G2 GS.Qw2 OS.o12 s2) K w)
    (CAppRd[a].same-rd G (C.subT G GS.G2 GS.Qw2 s2) QG PT2 K w (refl (QG.1.tob K w)) ((C.subt G GS.G2 GS.Qw2 OS.o12 s2).eob K w)) ;
 } ;
} ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
-- the value of a map at a point, read
atvRd (G : C.Ctx) (A B : C.Ty G) (r : C.El (C.ext G A) (OV.wkT G A B)) (x : C.El G A) (K : Ob) (w : V1.Ix (G.ob K))
  : Id (V1.Ix (B.1.tob K w)) ((PT.atv G A B r x).eob K w) (r.eob K (w, x.eob K w)) =
 transH (CAppRd[a].trE-rd G (C.subT G (C.ext G A) (OV.wkT G A B) (C.sec G A x)) B
          (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst G A B x) (C.subt G (C.ext G A) (OV.wkT G A B) r (C.sec G A x)) K w)
  (CAppRd[a].same-rd G (C.subT G (C.ext G A) (OV.wkT G A B) (C.sec G A x)) B
     (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst G A B x) K w (refl (B.1.tob K w)) (r.eob K (w, x.eob K w))) ;
-- congruence of the operation in both arguments
module Ap2 (G : C.Ctx) (Q : C.Ty C.nil) (op : C.El C.nil (OV.Fun C.nil Q (OV.Fun C.nil Q Q))) (e : C.Sub G C.nil) {
 module O = OpH[G, Q, op, e] ;
 Nl : C.Ctx = C.nil ;
 QG : C.Ty G = O.QG ;
 E1 : C.Ctx = C.ext G QG ;
 e1 : C.Sub E1 Nl = C.o E1 G Nl e (C.p G QG) ;
 module O1 = OpH[E1, Q, op, e1] ;
 PW1 : Id (C.Ty E1) O1.QG (OV.wkT G QG QG) = C.subT-o E1 G Nl Q e (C.p G QG) ;
 qv : C.El E1 O1.QG = OV.trE E1 (OV.wkT G QG QG) O1.QG (symH PW1) (C.q G QG) ;
 wk (y : C.El G QG) : C.El E1 O1.QG = OV.trE E1 (OV.wkT G QG QG) O1.QG (symH PW1) (OV.wkE G QG QG y) ;
 qvR (K : Ob) (w : V1.Ix (E1.ob K)) : Id (V1.Ix (Q.1.tob K (e.nt K w.1))) (qv.eob K w) w.2 =
  transH (CAppRd[a].trE-rd E1 (OV.wkT G QG QG) O1.QG (symH PW1) (C.q G QG) K w)
   (CAppRd[a].same-rd E1 (OV.wkT G QG QG) O1.QG (symH PW1) K w (refl ((OV.wkT G QG QG).1.tob K w)) w.2) ;
 wkR (y : C.El G QG) (K : Ob) (w : V1.Ix (E1.ob K)) : Id (V1.Ix (Q.1.tob K (e.nt K w.1))) ((wk y).eob K w) (y.eob K w.1) =
  transH (CAppRd[a].trE-rd E1 (OV.wkT G QG QG) O1.QG (symH PW1) (OV.wkE G QG QG y) K w)
   (CAppRd[a].same-rd E1 (OV.wkT G QG QG) O1.QG (symH PW1) K w (refl ((OV.wkT G QG QG).1.tob K w)) (y.eob K w.1)) ;
 -- in the first argument
 module L1 (y : C.El G QG) {
  r : C.El E1 (OV.wkT G QG QG) = OV.trE E1 O1.QG (OV.wkT G QG QG) PW1 O1.P2[qv, wk y].val ;
  rR (K : Ob) (w : V1.Ix (E1.ob K)) : Id (V1.Ix (Q.1.tob K (e.nt K w.1))) (r.eob K w) (O.SO.ev2 K (e.nt K w.1) w.2 (y.eob K w.1)) =
   transH (CAppRd[a].trE-rd E1 O1.QG (OV.wkT G QG QG) PW1 O1.P2[qv, wk y].val K w)
    (transH (CAppRd[a].same-rd E1 O1.QG (OV.wkT G QG QG) PW1 K w (refl (O1.QG.1.tob K w)) (O1.P2[qv, wk y].val.eob K w))
      (transH (O1.P2[qv, wk y].rd K w)
        (transH (apH {V1.Ix (Q.1.tob K (e.nt K w.1))} {V1.Ix (Q.1.tob K (e.nt K w.1))} (\ v -> O.SO.ev2 K (e.nt K w.1) v ((wk y).eob K w)) (qvR K w))
          (apH {V1.Ix (Q.1.tob K (e.nt K w.1))} {V1.Ix (Q.1.tob K (e.nt K w.1))} (\ v -> O.SO.ev2 K (e.nt K w.1) w.2 v) (wkR y K w))))) ;
  ap (x x' : C.El G QG) (u : C.El G (IJ.IdT G QG x x')) : C.El G (IJ.IdT G QG O.P2[x, y].val O.P2[x', y].val) =
   CCmpU14[a].rwId G QG (PT.atv G QG QG r x) O.P2[x, y].val (PT.atv G QG QG r x') O.P2[x', y].val
    (\ K w -> transH (atvRd G QG QG r x K w) (transH (rR K (w, x.eob K w)) (symH (O.P2[x, y].rd K w))))
    (\ K w -> transH (atvRd G QG QG r x' K w) (transH (rR K (w, x'.eob K w)) (symH (O.P2[x', y].rd K w))))
    (PT.apM G QG QG r x x' u) ;
 } ;
 -- in the second argument
 module L2 (x : C.El G QG) {
  r : C.El E1 (OV.wkT G QG QG) = OV.trE E1 O1.QG (OV.wkT G QG QG) PW1 O1.P2[wk x, qv].val ;
  rR (K : Ob) (w : V1.Ix (E1.ob K)) : Id (V1.Ix (Q.1.tob K (e.nt K w.1))) (r.eob K w) (O.SO.ev2 K (e.nt K w.1) (x.eob K w.1) w.2) =
   transH (CAppRd[a].trE-rd E1 O1.QG (OV.wkT G QG QG) PW1 O1.P2[wk x, qv].val K w)
    (transH (CAppRd[a].same-rd E1 O1.QG (OV.wkT G QG QG) PW1 K w (refl (O1.QG.1.tob K w)) (O1.P2[wk x, qv].val.eob K w))
      (transH (O1.P2[wk x, qv].rd K w)
        (transH (apH {V1.Ix (Q.1.tob K (e.nt K w.1))} {V1.Ix (Q.1.tob K (e.nt K w.1))} (\ v -> O.SO.ev2 K (e.nt K w.1) v (qv.eob K w)) (wkR x K w))
          (apH {V1.Ix (Q.1.tob K (e.nt K w.1))} {V1.Ix (Q.1.tob K (e.nt K w.1))} (\ v -> O.SO.ev2 K (e.nt K w.1) (x.eob K w.1) v) (qvR K w))))) ;
  ap (y y' : C.El G QG) (u : C.El G (IJ.IdT G QG y y')) : C.El G (IJ.IdT G QG O.P2[x, y].val O.P2[x, y'].val) =
   CCmpU14[a].rwId G QG (PT.atv G QG QG r y) O.P2[x, y].val (PT.atv G QG QG r y') O.P2[x, y'].val
    (\ K w -> transH (atvRd G QG QG r y K w) (transH (rR K (w, y.eob K w)) (symH (O.P2[x, y].rd K w))))
    (\ K w -> transH (atvRd G QG QG r y' K w) (transH (rR K (w, y'.eob K w)) (symH (O.P2[x, y'].rd K w))))
    (PT.apM G QG QG r y y' u) ;
 } ;
 ap2 (x x' y y' : C.El G QG) (u : C.El G (IJ.IdT G QG x x')) (v : C.El G (IJ.IdT G QG y y'))
   : C.El G (IJ.IdT G QG O.P2[x, y].val O.P2[x', y'].val) =
  PT.transM G QG O.P2[x, y].val O.P2[x', y].val O.P2[x', y'].val (L1[y].ap x x' u) (L2[x'].ap y y' v) ;
} ;
