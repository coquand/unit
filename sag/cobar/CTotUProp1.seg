-- CTotUProp1.seg (canonicity-c2; towards "U preserves propositions"):
-- a side of U A at Y in the levelwise site (values at the levelwise maps
-- into Y landing in Q) extends to a side of A at o Y in the total site,
-- through canonicity-45's factorisation k = (cl k) . (vp k):
--   value at k = (vp k)^* (value at cl k)
-- (Lands depends on the base map only, and (cl k).1 = k.1).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module UP1 (C : CIntCat[a, vl].IC) {
 module UX = CTotUExt[a, vl, l].UExt[C] ;
 module TR = UX.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;
 vp (Y : Ob0) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) : RN.Hom1 Z (RN.o (UX.lf Y Z k)) = TR.DS.Fact[Y, Z, k].vp ;
 module SX (D : P1.PCtx) (A : P1.PTy[D]) {
  UD : P0.PCtx = RS.rC D ;
  UA : P0.PTy[UD] = RS.rT D A ;
  E : P1.PCtx = P1.extP D A ;
  module CP0 = G0.GB.CPartial[l].Partials[UD, UA] ;
  module CP1 = G1.GB.CPartial[l].Partials[D, A] ;
  module S (Y : Ob0) (x : W0.Ix (D.ob (RN.o Y))) (s : CP0.Side[Y, x]) {
   pv1 (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) (i : G1.GB.Lands Z (RN.o Y) s.pQ k) : W0.Ix (E.ob Z) =
    E.act Z (RN.o (UX.lf Y Z k)) (vp Y Z k) (s.pv (UX.lf Y Z k) (UX.cl Y Z k) i) ;
   ppt1 (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) (i : G1.GB.Lands Z (RN.o Y) s.pQ k)
     : Id (W0.Ix (D.ob Z)) (pv1 Z k i).1 (D.act Z (RN.o Y) k x) =
    transH (apH {W0.Ix (D.ob (RN.o (UX.lf Y Z k)))} {W0.Ix (D.ob Z)} (\ w -> D.act Z (RN.o (UX.lf Y Z k)) (vp Y Z k) w)
              (s.ppt (UX.lf Y Z k) (UX.cl Y Z k) i))
     (transH (symH (D.act-o Z (RN.o (UX.lf Y Z k)) (RN.o Y) (TR.fn.onH (UX.lf Y Z k) Y (UX.cl Y Z k)) (vp Y Z k) x))
        (ap (RN.Hom1 Z (RN.o Y)) (W0.Ix (D.ob Z)) (\ w -> D.act Z (RN.o Y) w x)
           (G1.GB.BC.oC Z (RN.o (UX.lf Y Z k)) (RN.o Y) (TR.fn.onH (UX.lf Y Z k) Y (UX.cl Y Z k)) (vp Y Z k)) k
           (TR.DS.Fact[Y, Z, k].vp-eq))) ;
   module EN (Wp Wb : Ob1) (chi : RN.Hom1 Wp Wb) (k : RN.Hom1 Wb (RN.o Y)) (i : G1.GB.Lands Wb (RN.o Y) s.pQ k)
     (i' : G1.GB.Lands Wp (RN.o Y) s.pQ (G1.GB.BC.oC Wp Wb (RN.o Y) k chi)) {
    module N = UX.FI.Nt[Y, Wb, Wp, chi, k] ;
    a0 : W0.Ix (E.ob (RN.o N.L)) = s.pv N.L (UX.cl Y Wb k) i ;
    i2 : G0.GB.Lands N.L' Y s.pQ (G0.GB.BC.oC N.L' N.L Y (UX.cl Y Wb k) N.d) =
     G0.GB.lands-eq N.L' Y s.pQ (UX.cl Y Wp N.kg) (G0.GB.BC.oC N.L' N.L Y (UX.cl Y Wb k) N.d) (symH N.d-cl) i' ;
    nat : Id (W0.Ix (E.ob Wp)) (E.act Wp Wb chi (pv1 Wb k i)) (pv1 Wp N.kg i') =
     transH (symH (E.act-o Wp Wb (RN.o N.L) (vp Y Wb k) chi a0))
      (transH (ap (RN.Hom1 Wp (RN.o N.L)) (W0.Ix (E.ob Wp)) (\ w -> E.act Wp (RN.o N.L) w a0) N.v
                 (G1.GB.BC.oC Wp (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) (vp Y Wp N.kg)) (symH N.d-vp))
       (transH (E.act-o Wp (RN.o N.L') (RN.o N.L) (TR.fn.onH N.L' N.L N.d) (vp Y Wp N.kg) a0)
          (apH {W0.Ix (E.ob (RN.o N.L'))} {W0.Ix (E.ob Wp)} (\ w -> E.act Wp (RN.o N.L') (vp Y Wp N.kg) w)
             (transH (s.pnat N.L' N.L N.d (UX.cl Y Wb k) i i2)
                (CP0.pv-hom Y x s N.L' (G0.GB.BC.oC N.L' N.L Y (UX.cl Y Wb k) N.d) (UX.cl Y Wp N.kg) N.d-cl i2 i'))))) ;
   } ;
   side1 : CP1.Side[RN.o Y, x] =
    new CP1.Side[RN.o Y, x, s.pQ, \ Z k i -> pv1 Z k i, \ Z k i -> ppt1 Z k i, \ Wp Wb chi k i i' -> EN[Wp, Wb, chi, k, i, i'].nat] ;
  } ;
 } ;
} ;
