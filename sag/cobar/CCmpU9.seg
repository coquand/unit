-- CCmpU9.seg (canonicity-c2; (K) for cmpI, part 9, (U) setup): the closed
-- type H = Sigma (z z' : HS) Id (cmpI z , cmpI z') of (U), and its context.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module U9 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module PO = CPreI[a].PreOf[R, encK, pe] ;
 module CI = PO.CmpI[y] ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = CI.HS ;
 HTT : C.Ty Nl = CI.HTT ;
 D1 : C.Ctx = C.ext Nl HS ;
 HSw : C.Ty D1 = OV.wkT Nl HS HS ;
 HTTw : C.Ty D1 = OV.wkT Nl HS HTT ;
 D2 : C.Ctx = C.ext D1 HSw ;
 module L0 = PosFull[a].PB.GPre[a+].PS ;
 module HO = PosFull[a].PB.CHtpyOps[a+] ;
 -- cmpI's natural map, weakened to D1
 nmapD1 : HO.NMap[D1, HSw.1, HTTw.1] =
  new HO.NMap[D1, HSw.1, HTTw.1, \ K w v -> CI.nmap.nfun K w.1 v,
   \ J I f w w' e v -> CI.nmap.nnat J I f w.1 w'.1 (L0.ntEq D1 Nl (L0.pP Nl HS.1) J I f w w' e) v] ;
 z1 : C.El D2 (OV.wkT D1 HSw HSw) = OV.wkE D1 HSw HSw (C.q Nl HS) ;
 z2 : C.El D2 (OV.wkT D1 HSw HSw) = C.q D1 HSw ;
 module A1 = CCmpU5[a].AF[D1, HSw, HSw, HTTw, nmapD1, z1] ;
 module A2 = CCmpU5[a].AF[D1, HSw, HSw, HTTw, nmapD1, z2] ;
 i1 : C.El D2 (OV.wkT D1 HSw HTTw) = A1.t ;
 i2 : C.El D2 (OV.wkT D1 HSw HTTw) = A2.t ;
 IdZ : C.Ty D2 = IJ.IdT D2 (OV.wkT D1 HSw HTTw) i1 i2 ;
 H : C.Ty Nl = SS.Sig Nl HS (SS.Sig D1 HSw IdZ) ;
 -- the context of (U) and its semantic map to D2
 GH : C.Ctx = C.ext Nl H ;
 module L = PosFull[a].PB.GPre[a+].PS ;
 sgN (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (D2.ob K) = ((w.1, w.2.1), w.2.2.1) ;
 sg : C.Sub GH D2 = new L.PSub[GH, D2, sgN, \ J I f w -> refl (sgN J (GH.act J I f w))] ;
 IdZs : C.Ty GH = C.subT GH D2 IdZ sg ;
 pIdN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I))
   : Id (V1.Ix (IdZs.1.tob J (GH.act J I f w))) (IdZs.1.tact J I f w (GH.act J I f w) (refl (GH.act J I f w)) w.2.2.2) (GH.act J I f w).2.2.2 =
  L.tact-irr D2 IdZ.1 J I f (sgN I w) (sgN J (GH.act J I f w))
    (L.ntEq GH D2 sg J I f w (GH.act J I f w) (refl (GH.act J I f w)))
    (L.pair-act D1 HSw.1 J I f (w.1, w.2.1) (Nl.act J I f w.1, HS.1.tact J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1)
       (L.pair-act Nl HS.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1) w.2.2.1)
    w.2.2.2 ;
 pId : C.El GH IdZs = L.mkPEl GH IdZs.1 (\ I w -> w.2.2.2) (\ J I f w w' e ->
  idJ (V1.Ix (GH.ob J)) (GH.act J I f w) (\ w2 e2 -> Id (V1.Ix (IdZs.1.tob J w2)) (IdZs.1.tact J I f w w2 e2 w.2.2.2) w2.2.2.2)
    (pIdN J I f w) w' e) ;
} ;
