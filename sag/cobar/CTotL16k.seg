-- CTotL16k.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, SPECIFIC TO OUR C: the ends t = 0 of the lines.
--   Front   zeros on the first block: u read at catA c2 c is u read at c
--           with tot c2 composed into its head (faces 0, front0, rx-cat)
--   Back    zeros on the second block: u read at catA c2 c is the vertical
--           action of A along tot c on u read at c2 (top faces, drop-cat)
--   p0      the line p at 0 is tau_DAC (Lemma 14's tau: D A's action along
--           (g0, tmap c'), vpart (tmap c') = tot c')
--   q0      the line q at 0 is D tau_A pulled back (u's base naturality,
--           E's composition, tmap-eq)
-- No new axioms beyond the named premises (fe).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a+] ;
module VA = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, a+] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module L14 = CTotL14f[a, a+, a+] ;
module WB = CTotL16b[a, a+, a+] ;

module RK (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module RJ = CTotL16j[a].RJ[R, encK, pe] ;
 IC : CIntCat[a, a+].IC = RJ.IC ;
 module VT = RJ.VT ;
 module DO = RJ.RG.DO ;
 Obj (I : Ob) : U a+ = VT.Obj I ;
 module F (G : CTPsh[a, a+, a+].TPshOf[IC].TCtx) (A : Presheaf[a+, a+].Psh[CTotCat[a, a+, a+].TotOf[IC].TotCat].PTy[CTotCat[a, a+, a+].TotOf[IC].toP G]) {
  module JF = RJ.F[G, A] ;
  module Oc = JF.Oc ;
  module LE = Oc.LE ;
  module LB = JF.LB ;
  module DA = JF.DA ;
  module D = JF.D ;
  module D2 = JF.D2 ;
  E : LB.P.PCtx = LE.E ;
  -- the vertical part of tmap c' is tot c'
  vpTmap (I : Ob) (x : Obj I) (m : Nat) (J : Ob) (g0 : Hom J I) (y : Obj J) (c' : DO.KJ[J].K.Ch m (IC.res J I g0 x) y)
   : Id (VT.VMap J y (IC.res J I g0 x)) (VT.vpart J I g0 y x (D.tmap I x m J g0 y c')) (DO.KJ[J].K.tot m (IC.res J I g0 x) y c') =
   transH (IC.fact-uniq J J I g0 (idH J) y x
             (IC.compD J J I g0 (idH J) y (IC.res J I g0 x) x (IC.cart J I g0 x) (DO.KJ[J].K.tot m (IC.res J I g0 x) y c'))
             (VT.vpart J I g0 y x (D.tmap I x m J g0 y c'))
             (VT.THom-snd' J I y x
                (compH J J I g0 (idH J), IC.compD J J I g0 (idH J) y (IC.res J I g0 x) x (IC.cart J I g0 x) (VT.vpart J I g0 y x (D.tmap I x m J g0 y c')))
                (compH J J I g0 (idH J), IC.compD J J I g0 (idH J) y (IC.res J I g0 x) x (IC.cart J I g0 x) (DO.KJ[J].K.tot m (IC.res J I g0 x) y c'))
                (transH (VT.vpart-eq J I g0 y x (D.tmap I x m J g0 y c')) (D.tmap-eq I x m J g0 y c'))
                (refl (compH J J I g0 (idH J)))))
    (symH (IC.fact-uniq J J I g0 (idH J) y x
             (IC.compD J J I g0 (idH J) y (IC.res J I g0 x) x (IC.cart J I g0 x) (DO.KJ[J].K.tot m (IC.res J I g0 x) y c'))
             (DO.KJ[J].K.tot m (IC.res J I g0 x) y c')
             (refl (IC.compD J J I g0 (idH J) y (IC.res J I g0 x) x (IC.cart J I g0 x) (DO.KJ[J].K.tot m (IC.res J I g0 x) y c'))))) ;
  module En (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) (J' : Ob) (kh : Hom J' I) {
   module RDm = LE.RD[I, x, g, u] ;
   module K = DO.KJ[J'].K ;
   module CA = CTotL16c[a, a+, a+].CA[IC, J'] ;
   X' : Obj J' = IC.res J' I kh x ;
   rd (N : Nat) (z : Obj J') (ch : K.Ch N X' z) (w : Wt.Pn N J') : DA.Ez J' z = RDm.rd N J' kh z ch w ;
   -- the front: m+1 faces at 0 compose c2 into c
   Front : (m : Nat) -> (Y' z : Obj J') (c2 : K.Ch m X' Y') (n : Nat) (c : K.Ch n Y' z) (i : Wt.Pn n J')
    -> Id (DA.Ez J' z) (rd (Ar.plus m (suc n)) z (CA.catA m n X' Y' z c2 c) (Wt.CatP[m, n, J'].right (Wt.zeros m J') i))
         (rd n z (K.rx n Y' X' (K.tot m X' Y' c2) z c) i) = split {
    zero -> \ Y' z f n c i ->
     transH (apH (rd (suc n) z (Y', f, c))
               (transH (L14.pnEq (suc n) J' (Wt.CatP[zero, n, J'].right (Wt.zeros zero J') i) (Wt.Face[n, J', zero, refl true].Of[i].face) (\ kk -> Wt.ConsZero[n, J', i.1].coord kk))
                  (LE.U12.faceW-irr n J' zero (refl true) (Ar.leb-step zero n (refl true)) i)))
      (transH (u.2.2.1 (n, zero, refl true, J', kh, z, (Y', f, c), i.1) i.2)
        (apH (\ ch -> rd n z ch i) (K.front0 n X' Y' z f c))) ;
    suc m' | ih -> \ Y' z c2 n c i ->
     transH (apH (rd (suc (Ar.plus m' (suc n))) z (c2.1, c2.2.1, CA.catA m' n c2.1 Y' z c2.2.2 c))
               (transH (L14.pnEq (suc (Ar.plus m' (suc n))) J' (Wt.CatP[suc m', n, J'].right (Wt.zeros (suc m') J') i)
                          (Wt.Face[Ar.plus m' (suc n), J', zero, refl true].Of[Wt.CatP[m', n, J'].right (Wt.zeros m' J') i].face)
                          (\ kk -> Wt.ConsZero[Ar.plus m' (suc n), J', Wt.catC m' n J' (Wt.zeros m' J') i.1].coord kk))
                  (LE.U12.faceW-irr (Ar.plus m' (suc n)) J' zero (refl true) (Ar.leb-step zero (Ar.plus m' (suc n)) (refl true)) (Wt.CatP[m', n, J'].right (Wt.zeros m' J') i))))
      (transH (u.2.2.1 (Ar.plus m' (suc n), zero, refl true, J', kh, z, (c2.1, c2.2.1, CA.catA m' n c2.1 Y' z c2.2.2 c), (Wt.CatP[m', n, J'].right (Wt.zeros m' J') i).1)
                 (Wt.CatP[m', n, J'].right (Wt.zeros m' J') i).2)
        (transH (apH (\ ch -> rd (Ar.plus m' (suc n)) z ch (Wt.CatP[m', n, J'].right (Wt.zeros m' J') i))
                   (transH (K.front0 (Ar.plus m' (suc n)) X' c2.1 z c2.2.1 (CA.catA m' n c2.1 Y' z c2.2.2 c))
                      (CA.rx-cat m' n c2.1 X' Y' z c2.2.1 c2.2.2 c)))
          (transH (ih Y' z (K.rx m' c2.1 X' c2.2.1 Y' c2.2.2) n c i)
            (apH (\ hh -> rd n z (K.rx n Y' X' hh z c) i) (K.tot-rx m' c2.1 X' c2.2.1 Y' c2.2.2))))) } ;

   -- the back: n+1 top faces move c out of the concatenation as E's vertical action
   module BK (m : Nat) (Y' : Obj J') (c2 : K.Ch m X' Y') (jr : Wt.Pn m J') {
    Wb0 : Id (Wt.Pn (suc (Ar.plus m zero)) J')
           (WB.substP J' (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) (Wt.CatP[m, zero, J'].left jr (Wt.zeros zero J')))
           (Wt.Face[Ar.plus m zero, J', suc (Ar.plus m zero), Tr.leb-refl (suc (Ar.plus m zero))].Of[WB.substP J' m (Ar.plus m zero) (WB.pzm m) jr].face) =
     L14.pnEq (suc (Ar.plus m zero)) J' _ _ (\ kk ->
      transH (WB.substP-1 J' (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) (Wt.CatP[m, zero, J'].left jr (Wt.zeros zero J')) kk)
       (transH (WB.catZeroTop m J' jr.1 kk)
         (apH (\ cc -> Wt.Face[Ar.plus m zero, J', suc (Ar.plus m zero), Tr.leb-refl (suc (Ar.plus m zero))].faceC cc kk)
            (L14.coEq (Ar.plus m zero) J' (Wt.substC J' m (Ar.plus m zero) (WB.pzm m) jr.1) (WB.substP J' m (Ar.plus m zero) (WB.pzm m) jr).1
               (\ k2 -> symH (WB.substP-1 J' m (Ar.plus m zero) (WB.pzm m) jr k2)))))) ;
    WS (n' : Nat) : Id (Wt.Pn (suc (Ar.plus m (suc n'))) J')
           (WB.substP J' (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n')) (Wt.CatP[m, suc n', J'].left jr (Wt.zeros (suc n') J')))
           (Wt.Face[Ar.plus m (suc n'), J', suc (Ar.plus m (suc n')), Tr.leb-refl (suc (Ar.plus m (suc n')))].Of[Wt.CatP[m, n', J'].left jr (Wt.zeros n' J')].face) =
     transH (L14.pnEq (suc (Ar.plus m (suc n'))) J' _ _ (\ kk ->
       transH (WB.substP-1 J' (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n')) (Wt.CatP[m, suc n', J'].left jr (Wt.zeros (suc n') J')) kk)
        (transH (apH (\ cc -> Wt.substC J' (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n')) cc kk)
                   (L14.coEq (Ar.plus m (suc (suc n'))) J' (Wt.catC m (suc n') J' jr.1 (Wt.zeros (suc n') J'))
                      (Wt.catC m (suc n') J' jr.1 (Wt.Face[n', J', suc n', Tr.leb-refl (suc n')].faceC (Wt.zeros n' J')))
                      (\ k2 -> Wt.catC-congR m (suc n') J' jr.1 (Wt.zeros (suc n') J') (Wt.Face[n', J', suc n', Tr.leb-refl (suc n')].faceC (Wt.zeros n' J'))
                                  (\ k3 -> symH (WB.zerosTop n' J' k3)) k2)))
          (symH (Wt.catFR m n' J' (suc n') (Tr.leb-refl (suc n')) jr.1 (Wt.zeros n' J') kk)))))
      (LE.facePos (Ar.plus m (suc n')) J' (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n'))
         (Wt.hRB m n' (suc n') (Tr.leb-refl (suc n'))) (Tr.leb-refl (suc (Ar.plus m (suc n')))) (Wt.CatP[m, n', J'].left jr (Wt.zeros n' J'))) ;
    vact (z y' : Obj J') (f : VT.VMap J' z y') (v : DA.Ez J' y') : DA.Ez J' z = E.act (J', z) (J', y') (idH J', f) v ;
    Back : (n : Nat) -> (z : Obj J') (c : K.Ch n Y' z)
     -> Id (DA.Ez J' z) (rd (Ar.plus m (suc n)) z (CA.catA m n X' Y' z c2 c) (Wt.CatP[m, n, J'].left jr (Wt.zeros n J')))
          (vact z Y' (K.tot n Y' z c) (rd m Y' c2 jr)) = split {
     zero -> \ z f ->
      transH (RDm.rdTr (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) J' kh z (CA.catA m zero X' Y' z c2 f) (Wt.CatP[m, zero, J'].left jr (Wt.zeros zero J')))
       (transH (apH (rd (suc (Ar.plus m zero)) z (CA.trCh (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) X' z (CA.catA m zero X' Y' z c2 f))) Wb0)
         (transH (u.2.2.2 (Ar.plus m zero, J', kh, z, CA.trCh (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) X' z (CA.catA m zero X' Y' z c2 f), (WB.substP J' m (Ar.plus m zero) (WB.pzm m) jr).1)
                    (WB.substP J' m (Ar.plus m zero) (WB.pzm m) jr).2)
           (transH (apH {K.DR (Ar.plus m zero) X' z} {DA.Ez J' z} (\ Dd -> vact z Dd.1 Dd.2.2 (rd (Ar.plus m zero) Dd.1 Dd.2.1 (WB.substP J' m (Ar.plus m zero) (WB.pzm m) jr))) (CA.drop-cat0 m X' Y' z c2 f))
             (apH (vact z Y' f) (symH (RDm.rdTr m (Ar.plus m zero) (WB.pzm m) J' kh Y' c2 jr)))))) ;
     suc n' | ih -> \ z c ->
      transH (RDm.rdTr (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n')) J' kh z (CA.catA m (suc n') X' Y' z c2 c) (Wt.CatP[m, suc n', J'].left jr (Wt.zeros (suc n') J')))
       (transH (apH (rd (suc (Ar.plus m (suc n'))) z (CA.catS m n' X' Y' z c2 c)) (WS n'))
         (transH (u.2.2.2 (Ar.plus m (suc n'), J', kh, z, CA.catS m n' X' Y' z c2 c, (Wt.CatP[m, n', J'].left jr (Wt.zeros n' J')).1) (Wt.CatP[m, n', J'].left jr (Wt.zeros n' J')).2)
           (transH (apH {K.DR (Ar.plus m (suc n')) X' z} {DA.Ez J' z} (\ Dd -> vact z Dd.1 Dd.2.2 (rd (Ar.plus m (suc n')) Dd.1 Dd.2.1 (Wt.CatP[m, n', J'].left jr (Wt.zeros n' J')))) (CA.drop-cat m n' X' Y' z c2 c))
             (transH (apH (vact z (K.drop n' Y' z c).1 (K.drop n' Y' z c).2.2) (ih (K.drop n' Y' z c).1 (K.drop n' Y' z c).2.1))
               (transH (symH (E.act-o (J', z) (J', (K.drop n' Y' z c).1) (J', Y') (idH J', K.tot n' Y' (K.drop n' Y' z c).1 (K.drop n' Y' z c).2.1) (idH J', (K.drop n' Y' z c).2.2) (rd m Y' c2 jr)))
                 (transH (apH {VT.TH J' z J' Y'} {DA.Ez J' z} (\ hh -> E.act (J', z) (J', Y') hh (rd m Y' c2 jr))
                            (symH (VT.vcomp-eq J' z (K.drop n' Y' z c).1 Y' (K.tot n' Y' (K.drop n' Y' z c).1 (K.drop n' Y' z c).2.1) (K.drop n' Y' z c).2.2)))
                   (apH (\ hh -> vact z Y' hh (rd m Y' c2 jr)) (symH (K.tot-drop n' Y' z c))))))))) } ;
   } ;
  } ;
  module Op = RJ.RG.Out[G, A, WB.WfML, WB.WresML, WB.WfaceRML, WB.WfaceLML] ;
  module Oq = RJ.RG.Out[G, A, WB.WfMR, WB.WresMR, WB.WfaceRMR, WB.WfaceLMR] ;
  module L16a = JF.L16a ;
  GP : LB.P.PCtx = JF.GP ;
  module TZ = JF.TZ ;
  module TX = JF.TX ;
  module E0 (X : LB.TC.TOb) (z : TZ.EI X) {
   gm : W0.Ix (G.ob X.1 X.2) = TZ.pr1 X z ;
   u : DA.TOb' X.1 X.2 (D.tau X.1 X.2 (TZ.pr1 X z)) = TZ.pr2 X z ;
   tg : D.Ob' X.1 X.2 = D.tau X.1 X.2 gm ;
   module Mp = Op.MW[X.1, X.2, gm, u, PB.ptH X.1 PB.e0] ;
   module Mq = Oq.MW[X.1, X.2, gm, u, PB.ptH X.1 PB.e0] ;
   tD : W0.Ix (L16a.B2.tob X gm) = L16a.CD.LB.TA.tauA X.1 X.2 gm u ;
   -- p at 0 is tau_DAC
   module PA (q' : DA.Idx X.1 X.2) (l' : DA.LandsI X.1 X.2 q') {
    module O = Mp.InO[q', l'].M ;
    module TBu = DA.TB[q'.2.1, X.1, q'.2.2.1, q'.2.2.2.1, X.2, D.tmap X.1 X.2 q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1, tg, D.tau q'.2.1 q'.2.2.2.1 (tg.1 q' l'),
                       LB.P.ntEq GP L16a.DGc.DG L16a.tauS (q'.2.1, q'.2.2.2.1) X (q'.2.2.1, D.tmap X.1 X.2 q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) gm (tg.1 q' l') (refl (tg.1 q' l')), u] ;
    module HQ (q : DA.Idx q'.2.1 q'.2.2.2.1) (li : DA.LandsI q'.2.1 q'.2.2.2.1 q) {
     module Sa = Op.LD.Inner[X.1, X.2, gm, u, PB.ptH X.1 PB.e0, q', l', q, li] ;
     module En1 = En[X.1, X.2, gm, u, q.2.1, Sa.gg] ;
     jrc : Wt.Coords q'.1 q.2.1 = Wt.resC q'.1 q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.2.2 ;
     wE : Id (Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.1) Sa.w (Wt.CatP[q'.1, q.1, q.2.1].right (Wt.zeros q'.1 q.2.1) (q.2.2.2.2.2, li)) =
      L14.pnEq (Ar.plus q'.1 (suc q.1)) q.2.1 Sa.w (Wt.CatP[q'.1, q.1, q.2.1].right (Wt.zeros q'.1 q.2.1) (q.2.2.2.2.2, li)) (\ kk ->
       transH (apH (\ jj -> Wt.catC q'.1 q.1 q.2.1 jj q.2.2.2.2.2 kk)
                 (L14.coEq q'.1 q.2.1 (Wt.meetC q'.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e0) Sa.gg) jrc) (Wt.meetC q'.1 q.2.1 (PB.ptH q.2.1 PB.e0) jrc)
                    (\ k2 -> apH (\ jj -> Wt.meetC q'.1 q.2.1 jj jrc k2) (PB.ptH-nat q.2.1 X.1 Sa.gg PB.e0))))
        (Wt.catMeet0L q'.1 q.1 q.2.1 jrc q.2.2.2.2.2 kk)) ;
     chE : Id (DO.KJ[q.2.1].K.Ch q.1 Sa.X' q.2.2.2.1) (DO.KJ[q.2.1].K.rx q.1 Sa.Y' Sa.X' (DO.KJ[q.2.1].K.tot q'.1 Sa.X' Sa.Y' Sa.c2) q.2.2.2.1 q.2.2.2.2.1)
             (DO.KJ[q.2.1].K.rx q.1 Sa.Y' Sa.X' (VT.rmap q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1 X.2 (VT.vpart q'.2.1 X.1 q'.2.2.1 q'.2.2.2.1 X.2 (D.tmap X.1 X.2 q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1))) q.2.2.2.1 q.2.2.2.2.1) =
      transH (apH {VT.VMap q.2.1 Sa.Y' Sa.X'} {DO.KJ[q.2.1].K.Ch q.1 Sa.X' q.2.2.2.1} (\ hh -> DO.KJ[q.2.1].K.rx q.1 Sa.Y' Sa.X' hh q.2.2.2.1 q.2.2.2.2.1)
                (DO.CT.tot-rCh q.2.1 q'.2.1 X.1 q.2.2.1 q'.2.2.1 X.2 q'.1 q'.2.2.2.1 q'.2.2.2.2.1))
       (apH {VT.VMap q'.2.1 q'.2.2.2.1 X.2} {DO.KJ[q.2.1].K.Ch q.1 Sa.X' q.2.2.2.1}
          (\ hh -> DO.KJ[q.2.1].K.rx q.1 Sa.Y' Sa.X' (VT.rmap q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1 X.2 hh) q.2.2.2.1 q.2.2.2.2.1)
          (symH (vpTmap X.1 X.2 q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1))) ;
     eq : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (O.OFm.tgy.1 q li) (O.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (O.OFm.tgy.1 q li) (TBu.a' q li)) =
      transH Sa.pc
       (transH (apH (En1.rd (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 Sa.cc) wE)
        (transH (En1.Front q'.1 Sa.Y' q.2.2.2.1 Sa.c2 q.1 q.2.2.2.2.1 (q.2.2.2.2.2, li))
         (transH (apH (\ ch -> En1.rd q.1 q.2.2.2.1 ch (q.2.2.2.2.2, li)) chE)
          (symH (TBu.pc q li))))) ;
    } ;
    eq : Id (DA.TOb' q'.2.1 q'.2.2.2.1 O.OFm.tgy) O.ires TBu.res =
     DA.tob-eq q'.2.1 q'.2.2.2.1 O.OFm.tgy O.ires TBu.res (\ q li -> DA.pr-inj q.2.1 q.2.2.2.1 (O.OFm.tgy.1 q li) (O.ires.1 q li) (TBu.a' q li) HQ[q, li].eq) ;
   } ;
   p0 : Id (TX.EI X) (JF.Lp.mwe X z (PB.ptH X.1 PB.e0)) (L16a.HO1.HT[GP, L16a.DAC, L16a.B2, L16a.tauD, JF.mN2].aE X z) =
    apH (TX.pr X gm) (D2.tob-eq X.1 X.2 tg Mp.res tD (\ q' l' ->
      D2.pr-inj q'.2.1 q'.2.2.2.1 (tg.1 q' l') (Mp.ov q' l') (tD.1 q' l') (apH (D2.prz q'.2.1 q'.2.2.2.1 (tg.1 q' l')) PA[q', l'].eq))) ;
   -- q at 0 is D tau_A pulled back along tau_G
   module DMm = L16a.DGc.DM[X.1, X.2, tg, u] ;
   module QA (q' : DA.Idx X.1 X.2) (l' : DA.LandsI X.1 X.2 q') {
    module O = Mq.InO[q', l'].M ;
    gmy : W0.Ix (G.ob q'.2.1 q'.2.2.2.1) = tg.1 q' l' ;
    tA : DA.TOb' q'.2.1 q'.2.2.2.1 (D.tau q'.2.1 q'.2.2.2.1 gmy) = L16a.CA.LB.TA.tauA q'.2.1 q'.2.2.2.1 gmy (u.1 q' l') ;
    module HQ (q : DA.Idx q'.2.1 q'.2.2.2.1) (li : DA.LandsI q'.2.1 q'.2.2.2.1 q) {
     module Sa = Oq.LD.Inner[X.1, X.2, gm, u, PB.ptH X.1 PB.e0, q', l', q, li] ;
     module En1 = En[X.1, X.2, gm, u, q.2.1, Sa.gg] ;
     jrc : Wt.Coords q'.1 q.2.1 = Wt.resC q'.1 q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.2.2 ;
     wE : Id (Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.1) Sa.w (Wt.CatP[q'.1, q.1, q.2.1].left Sa.jr (Wt.zeros q.1 q.2.1)) =
      L14.pnEq (Ar.plus q'.1 (suc q.1)) q.2.1 Sa.w (Wt.CatP[q'.1, q.1, q.2.1].left Sa.jr (Wt.zeros q.1 q.2.1)) (\ kk ->
       transH (apH (\ ii -> Wt.catC q'.1 q.1 q.2.1 jrc ii kk)
                 (L14.coEq q.1 q.2.1 (Wt.meetC q.1 q.2.1 (PB.compH q.2.1 X.1 PFO.ivO (PB.ptH X.1 PB.e0) Sa.gg) q.2.2.2.2.2) (Wt.meetC q.1 q.2.1 (PB.ptH q.2.1 PB.e0) q.2.2.2.2.2)
                    (\ k2 -> apH (\ jj -> Wt.meetC q.1 q.2.1 jj q.2.2.2.2.2 k2) (PB.ptH-nat q.2.1 X.1 Sa.gg PB.e0))))
        (Wt.catMeet0R q'.1 q.1 q.2.1 jrc q.2.2.2.2.2 kk)) ;
     pu : DA.Ez q'.2.1 q'.2.2.2.1 = DA.prz q'.2.1 q'.2.2.2.1 gmy (u.1 q' l') ;
     eq : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 (O.OFm.tgy.1 q li) (O.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (O.OFm.tgy.1 q li) (tA.1 q li)) =
      transH Sa.pc
       (transH (apH (En1.rd (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 Sa.cc) wE)
        (transH (En1.BK[q'.1, Sa.Y', Sa.c2, Sa.jr].Back q.1 q.2.2.2.1 q.2.2.2.2.1)
         (transH (apH (En1.BK[q'.1, Sa.Y', Sa.c2, Sa.jr].vact q.2.2.2.1 Sa.Y' (DO.KJ[q.2.1].K.tot q.1 Sa.Y' q.2.2.2.1 q.2.2.2.2.1)) (symH (u.2.1 (q', (q.2.1, q.2.2.1)) l')))
          (transH (symH (E.act-o (q.2.1, q.2.2.2.1) (q.2.1, Sa.Y') (q'.2.1, q'.2.2.2.1) (q.2.2.1, IC.cart q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1)
                           (idH q.2.1, DO.KJ[q.2.1].K.tot q.1 Sa.Y' q.2.2.2.1 q.2.2.2.2.1) pu))
           (apH {VT.TH q.2.1 q.2.2.2.1 q'.2.1 q'.2.2.2.1} {DA.Ez q.2.1 q.2.2.2.1} (\ hh -> E.act (q.2.1, q.2.2.2.1) (q'.2.1, q'.2.2.2.1) hh pu)
              (symH (D.tmap-eq q'.2.1 q'.2.2.2.1 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1))))))) ;
    } ;
    eqA : Id (DA.TOb' q'.2.1 q'.2.2.2.1 O.OFm.tgy) O.ires tA =
     DA.tob-eq q'.2.1 q'.2.2.2.1 O.OFm.tgy O.ires tA (\ q li -> DA.pr-inj q.2.1 q.2.2.2.1 (O.OFm.tgy.1 q li) (O.ires.1 q li) (tA.1 q li) HQ[q, li].eq) ;
    eq : Id (DA.TOb' q'.2.1 q'.2.2.2.1 O.OFm.tgy) O.ires (DMm.b q' l') =
     transH eqA (symH (D2.pr-inj q'.2.1 q'.2.2.2.1 gmy (DMm.b q' l') tA (DMm.pc q' l'))) ;
   } ;
   q0 : Id (TX.EI X) (JF.Lq.mwe X z (PB.ptH X.1 PB.e0)) (L16a.HO1.HT[GP, L16a.DAC, L16a.B2, L16a.dTau, JF.mN2].aE X z) =
    apH (TX.pr X gm) (D2.tob-eq X.1 X.2 tg Mq.res DMm.res (\ q' l' ->
      D2.pr-inj q'.2.1 q'.2.2.2.1 (tg.1 q' l') (Mq.ov q' l') (DMm.res.1 q' l') (apH (D2.prz q'.2.1 q'.2.2.2.1 (tg.1 q' l')) QA[q', l'].eq))) ;
  } ;
 } ;
} ;
