-- CCmpU17.seg (canonicity-c2; (K) for cmpI, part 17): closed points of
-- W4 = Sigma u1 u2 v (op u1 u2 = v) from three closed elements and an Id.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
-- the Id of a closed operation's value, as an element of IdOp at the section
module PrOf (Q : C.Ty C.nil) (op : C.El C.nil (OV.Fun C.nil Q (OV.Fun C.nil Q Q))) (q1 q2 q3 : C.El C.nil Q)
  (b : C.El C.nil (IJ.IdT C.nil Q (OV.app C.nil Q Q (OV.app C.nil Q (OV.Fun C.nil Q Q) op q1) q2) q3)) {
 module GS = CQCtx[a].G3Of[Q] ;
 module OS = GS.OpTy[op] ;
 Nl : C.Ctx = C.nil ;
 s3 : C.Sub Nl GS.G3 = GS.Sec3[q1, q2, q3].sec3 ;
 a12 : C.El Nl Q = OV.app Nl Q Q (OV.app Nl Q (OV.Fun Nl Q Q) op q1) q2 ;
 s12 : C.Sub GS.G2 Nl = C.o GS.G2 GS.G1 Nl (C.p Nl Q) (C.p GS.G1 GS.Qw) ;
 pi3 : C.Sub GS.G3 Nl = C.o GS.G3 GS.G2 Nl s12 (C.p GS.G2 GS.Qw2) ;
 QW3 : Id (C.Ty GS.G3) GS.Qw3 (C.subT GS.G3 Nl Q pi3) =
  transH (apH {C.Ty GS.G2} {C.Ty GS.G3} (\ T -> C.subT GS.G3 GS.G2 T (C.p GS.G2 GS.Qw2)) (symH (C.subT-o GS.G2 GS.G1 Nl Q (C.p Nl Q) (C.p GS.G1 GS.Qw))))
   (symH (C.subT-o GS.G3 GS.G2 Nl Q s12 (C.p GS.G2 GS.Qw2))) ;
 Q3s : C.Ty Nl = C.subT Nl GS.G3 GS.Qw3 s3 ;
 PQ : Id (C.Ty Nl) Q Q3s =
  symH (transH (apH {C.Ty GS.G3} {C.Ty Nl} (\ T -> C.subT Nl GS.G3 T s3) QW3)
   (transH (symH (C.subT-o Nl GS.G3 Nl Q pi3 s3))
     (transH (apH {C.Sub Nl Nl} {C.Ty Nl} (\ s -> C.subT Nl Nl Q s) (transH (C.eps-uniq Nl (C.o Nl GS.G3 Nl pi3 s3)) (symH (C.eps-uniq Nl (C.id Nl)))))
        (C.subT-id Nl Q)))) ;
 idFwd (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (u : C.El G (IJ.IdT G X x y))
   : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)) =
  idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y))) u X' P ;
 b1 : C.El Nl (IJ.IdT Nl Q3s (OV.trE Nl Q Q3s PQ a12) (OV.trE Nl Q Q3s PQ q3)) = idFwd Nl Q Q3s PQ a12 q3 b ;
 x12 : C.El Nl Q3s = C.subt Nl GS.G3 GS.Qw3 OS.o12w s3 ;
 x3 : C.El Nl Q3s = C.subt Nl GS.G3 GS.Qw3 (C.q GS.G2 GS.Qw2) s3 ;
 module A1 = CAppRd[a].App0[Q, OV.Fun Nl Q Q, op, q1] ;
 module A2 = CAppRd[a].App0[Q, Q, OV.app Nl Q (OV.Fun Nl Q Q) op q1, q2] ;
 r12 (K : Ob) (o : V1.Ix (Nl.ob K)) : Id (V1.Ix (Q3s.1.tob K o)) ((OV.trE Nl Q Q3s PQ a12).eob K o) (x12.eob K o) =
  transH (CAppRd[a].trE-rd Nl Q Q3s PQ a12 K o)
   (transH (CAppRd[a].same-rd Nl Q Q3s PQ K o (refl (Q.1.tob K o)) (a12.eob K o))
     (transH (A2.rd K o) (apH {V1.Ix ((OV.Fun Nl Q Q).1.tob K o)} {V1.Ix (Q.1.tob K o)} (\ m -> m.1 K (idH K) (q2.eob K o)) (A1.rd K o)))) ;
 r3 (K : Ob) (o : V1.Ix (Nl.ob K)) : Id (V1.Ix (Q3s.1.tob K o)) ((OV.trE Nl Q Q3s PQ q3).eob K o) (x3.eob K o) =
  transH (CAppRd[a].trE-rd Nl Q Q3s PQ q3 K o)
   (CAppRd[a].same-rd Nl Q Q3s PQ K o (refl (Q.1.tob K o)) (q3.eob K o)) ;
 b2 : C.El Nl (IJ.IdT Nl Q3s x12 x3) = CCmpU14[a].rwId Nl Q3s (OV.trE Nl Q Q3s PQ a12) x12 (OV.trE Nl Q Q3s PQ q3) x3 r12 r3 b1 ;
 pr : C.El Nl (C.subT Nl GS.G3 OS.IdOp s3) =
  OV.trE Nl (IJ.IdT Nl Q3s x12 x3) (C.subT Nl GS.G3 OS.IdOp s3) (symH (IJ.IdT-nat Nl GS.G3 GS.Qw3 OS.o12w (C.q GS.G2 GS.Qw2) s3)) b2 ;
} ;
module WP (Q : C.Ty C.nil) (op : C.El C.nil (OV.Fun C.nil Q (OV.Fun C.nil Q Q))) (q1 q2 q3 : C.El C.nil Q)
  (pr : C.El C.nil (C.subT C.nil CQCtx[a].G3Of[Q].G3 (CQCtx[a].G3Of[Q].OpTy[op].IdOp) (CQCtx[a].G3Of[Q].Sec3[q1, q2, q3].sec3))) {
 module GS = CQCtx[a].G3Of[Q] ;
 module OS = GS.OpTy[op] ;
 Nl : C.Ctx = C.nil ;
 W4 : C.Ty Nl = SS.Sig Nl Q (SS.Sig GS.G1 GS.Qw (SS.Sig GS.G2 GS.Qw2 OS.IdOp)) ;
 s3 : C.Sub Nl GS.G3 = GS.Sec3[q1, q2, q3].sec3 ;
 tup (K : Ob) (P : V1.Ix (GS.G3.ob K)) (p : V1.Ix (OS.IdOp.1.tob K P)) : V1.Ix (W4.1.tob K P.1.1.1) = (P.1.1.2, (P.1.2, (P.2, p))) ;
 prb (J I : Ob) (f : Hom J I) (P : V1.Ix (GS.G3.ob I)) (p : V1.Ix (OS.IdOp.1.tob I P))
   : Id (V1.Ix (W4.1.tob J P.1.1.1)) (W4.1.tact J I f P.1.1.1 P.1.1.1 (refl P.1.1.1) (tup I P p))
        (tup J (GS.G3.act J I f P) (OS.IdOp.1.tact J I f P (GS.G3.act J I f P) (refl (GS.G3.act J I f P)) p)) =
  refl (W4.1.tact J I f P.1.1.1 P.1.1.1 (refl P.1.1.1) (tup I P p)) ;
 -- the generic tuple over G3.IdOp
 Ex : C.Ctx = C.ext GS.G3 OS.IdOp ;
 piN (K : Ob) (x : V1.Ix (Ex.ob K)) : V1.Ix (Nl.ob K) = x.1.1.1.1 ;
 pi : C.Sub Ex Nl = new L.PSub[Ex, Nl, piN, \ J I f x -> refl (piN J (Ex.act J I f x))] ;
 W4w : C.Ty Ex = C.subT Ex Nl W4 pi ;
 tupB (J I : Ob) (f : Hom J I) (x : V1.Ix (Ex.ob I))
   : Id (V1.Ix (W4w.1.tob J (Ex.act J I f x))) (W4w.1.tact J I f x (Ex.act J I f x) (refl (Ex.act J I f x)) (tup I x.1 x.2)) (tup J (Ex.act J I f x).1 (Ex.act J I f x).2) =
  L.tact-irr Nl W4.1 J I f x.1.1.1.1 x.1.1.1.1 (L.ntEq Ex Nl pi J I f x (Ex.act J I f x) (refl (Ex.act J I f x))) (refl x.1.1.1.1) (tup I x.1 x.2) ;
 tupE : C.El Ex W4w = L.mkPEl Ex W4w.1 (\ K x -> tup K x.1 x.2) (\ J I f x x' e ->
  idJ (V1.Ix (Ex.ob J)) (Ex.act J I f x) (\ x2 e2 -> Id (V1.Ix (W4w.1.tob J x2)) (W4w.1.tact J I f x x2 e2 (tup I x.1 x.2)) (tup J x2.1 x2.2))
    (tupB J I f x) x' e) ;
 -- the point (q1, q2, q3, pr)
 spN (K : Ob) (o : V1.Ix (Nl.ob K)) : V1.Ix (Ex.ob K) = (s3.nt K o, pr.eob K o) ;
 spT (J I : Ob) (f : Hom J I) (o : V1.Ix (Nl.ob I)) : Id (V1.Ix (Ex.ob J)) (spN J (Nl.act J I f o)) (Ex.act J I f (spN I o)) =
  symH (transH (L.pair-act GS.G3 OS.IdOp.1 J I f (s3.nt I o) (s3.nt J o) (L.ntEq Nl GS.G3 s3 J I f o o (refl o)) (pr.eob I o))
    (apH {V1.Ix (OS.IdOp.1.tob J (s3.nt J o))} {V1.Ix (Ex.ob J)} (\ v -> (s3.nt J o, v)) (pr.enat J I f o o (refl o)))) ;
 sp : C.Sub Nl Ex = new L.PSub[Nl, Ex, spN, spT] ;
 PE : Id (C.Ty Nl) (C.subT Nl Ex W4w sp) W4 =
  transH (symH (C.subT-o Nl Ex Nl W4 pi sp))
   (transH (apH {C.Sub Nl Nl} {C.Ty Nl} (\ s -> C.subT Nl Nl W4 s) (transH (C.eps-uniq Nl (C.o Nl Ex Nl pi sp)) (symH (C.eps-uniq Nl (C.id Nl)))))
     (C.subT-id Nl W4)) ;
 wt : C.El Nl W4 = OV.trE Nl (C.subT Nl Ex W4w sp) W4 PE (C.subt Nl Ex W4w tupE sp) ;
 wtrd (K : Ob) (o : V1.Ix (Nl.ob K)) : Id (V1.Ix (W4.1.tob K o)) (wt.eob K o) (tup K (s3.nt K o) (pr.eob K o)) =
  transH (CAppRd[a].trE-rd Nl (C.subT Nl Ex W4w sp) W4 PE (C.subt Nl Ex W4w tupE sp) K o)
   (CAppRd[a].same-rd Nl (C.subT Nl Ex W4w sp) W4 PE K o (refl (W4.1.tob K o)) (tup K (s3.nt K o) (pr.eob K o))) ;
} ;
