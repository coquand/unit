-- CHtpyAlgG.seg (canonicity-45; COBAR.md "comparison"): CHtpyAlg (the
-- evaluations of terms in two algebras A, T over a context and E1, by
-- induction on terms) over the total site G1 of an integral category C,
-- for E1 at the total site (rho's Id part, Prop 58).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
module SX = CSyntax[a] ;

module On (C : CIntCat[a, vl].IC) {
 module GB = CTotR[a, vl, l].TotR[C].G1.GB ;
 module L = GB.GPre[l].PS ;
 module HO = GB.CHtpyOps[l] ;
 module PF = PresheafFormers[vl, l].PFormers[GB.BC] ;
 TO : U vl = CTotCat[a, vl, l].TotOf[C].TOb ;
 TH (Y X : TO) : U vl = CTotCat[a, vl, l].TotOf[C].THm Y X ;
 module Alg (R : Ring[a].CRing) (G : L.PCtx) (A T : L.PTy[G])
   (addA : (I : TO) (x : W0.Ix (G.ob I)) (a0 b0 : W0.Ix (A.tob I x)) -> W0.Ix (A.tob I x))
   (addAN : (J I : TO) (f : TH J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y) (a0 b0 : W0.Ix (A.tob I x))
      -> Id (W0.Ix (A.tob J y)) (A.tact J I f x y e (addA I x a0 b0)) (addA J y (A.tact J I f x y e a0) (A.tact J I f x y e b0)))
   (mulA : (I : TO) (x : W0.Ix (G.ob I)) (a0 b0 : W0.Ix (A.tob I x)) -> W0.Ix (A.tob I x))
   (mulAN : (J I : TO) (f : TH J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y) (a0 b0 : W0.Ix (A.tob I x))
      -> Id (W0.Ix (A.tob J y)) (A.tact J I f x y e (mulA I x a0 b0)) (mulA J y (A.tact J I f x y e a0) (A.tact J I f x y e b0)))
   (cA : R.R -> (I : TO) (x : W0.Ix (G.ob I)) -> W0.Ix (A.tob I x))
   (cAN : (r : R.R) (J I : TO) (f : TH J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y)
      -> Id (W0.Ix (A.tob J y)) (A.tact J I f x y e (cA r I x)) (cA r J y))
   (addT : (I : TO) (x : W0.Ix (G.ob I)) (a0 b0 : W0.Ix (T.tob I x)) -> W0.Ix (T.tob I x))
   (addTN : (J I : TO) (f : TH J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y) (a0 b0 : W0.Ix (T.tob I x))
      -> Id (W0.Ix (T.tob J y)) (T.tact J I f x y e (addT I x a0 b0)) (addT J y (T.tact J I f x y e a0) (T.tact J I f x y e b0)))
   (mulT : (I : TO) (x : W0.Ix (G.ob I)) (a0 b0 : W0.Ix (T.tob I x)) -> W0.Ix (T.tob I x))
   (mulTN : (J I : TO) (f : TH J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y) (a0 b0 : W0.Ix (T.tob I x))
      -> Id (W0.Ix (T.tob J y)) (T.tact J I f x y e (mulT I x a0 b0)) (mulT J y (T.tact J I f x y e a0) (T.tact J I f x y e b0)))
   (cT : R.R -> (I : TO) (x : W0.Ix (G.ob I)) -> W0.Ix (T.tob I x))
   (cTN : (r : R.R) (J I : TO) (f : TH J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y)
      -> Id (W0.Ix (T.tob J y)) (T.tact J I f x y e (cT r I x)) (cT r J y))
   (tau : HO.NMap[G, A, T]) {
  module OA = CApOp2G[a, vl, l].On[C].AO[G, A, A, addA, addAN] ;
  module OM = CApOp2G[a, vl, l].On[C].AO[G, A, A, mulA, mulAN] ;
  -- the valuations: Pm 0 the unit type, Pm (k + 1) = Pm k x A
  U0 : L.PTy[G] = L.mkTy G (\ I x -> W0.unitV) (\ J I f x y e u -> u) (\ I x e u -> refl u) (\ K J I f g x x' x'' e1 e2 e3 u -> refl u) ;
  Pm : Nat -> L.PTy[G] = split {
   zero -> U0 ;
   suc k | r -> PF.SigAB[G, r, L.subTy (L.extP G r) G A (L.pP G r)].SigP } ;
  -- projections
  fstN (k : Nat) : HO.NMap[G, Pm (suc k), Pm k] =
   new HO.NMap[G, Pm (suc k), Pm k, \ I x pp -> pp.1, \ J I f x y e pp -> refl ((Pm k).tact J I f x y e pp.1)] ;
  sndN (k : Nat) : HO.NMap[G, Pm (suc k), A] =
   new HO.NMap[G, Pm (suc k), A, \ I x pp -> pp.2,
    \ J I f x y e pp -> L.tact-irr G A J I f x y e
       (L.ntEq (L.extP G (Pm k)) G (L.pP G (Pm k)) J I f (x, pp.1) (y, (Pm k).tact J I f x y e pp.1) (L.pair-act G (Pm k) J I f x y e pp.1)) pp.2] ;
  proj : (k : Nat) -> SX.Fin k -> HO.NMap[G, Pm k, A] = split {
   zero -> \ v -> absurd (HO.NMap[G, Pm zero, A]) v ;
   suc k | r -> split { inl v -> HO.compN G (Pm (suc k)) (Pm k) A (fstN k) (r v) ; inr w -> sndN k } } ;
  -- constants
  constN (X : L.PTy[G]) (B : L.PTy[G]) (c : (I : TO) (x : W0.Ix (G.ob I)) -> W0.Ix (B.tob I x))
    (cN : (J I : TO) (f : TH J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y) -> Id (W0.Ix (B.tob J y)) (B.tact J I f x y e (c I x)) (c J y))
    : HO.NMap[G, X, B] = new HO.NMap[G, X, B, \ I x u -> c I x, \ J I f x y e u -> cN J I f x y e] ;
  -- the two evaluations
  evA (k : Nat) : SX.Over[R].Expr (SX.Fin k) -> HO.NMap[G, Pm k, A] = split {
   var v -> proj k v ;
   cst r -> constN (Pm k) A (cA r) (cAN r) ;
   sumE p q | rp rq -> CApOp2G[a, vl, l].On[C].AO[G, Pm k, A, addA, addAN].OP rp rq ;
   mulE p q | rp rq -> CApOp2G[a, vl, l].On[C].AO[G, Pm k, A, mulA, mulAN].OP rp rq } ;
  evGt (k : Nat) : SX.Over[R].Expr (SX.Fin k) -> HO.NMap[G, Pm k, T] = split {
   var v -> HO.compN G (Pm k) A T (proj k v) tau ;
   cst r -> constN (Pm k) T (cT r) (cTN r) ;
   sumE p q | rp rq -> CApOp2G[a, vl, l].On[C].AO[G, Pm k, T, addT, addTN].OP rp rq ;
   mulE p q | rp rq -> CApOp2G[a, vl, l].On[C].AO[G, Pm k, T, mulT, mulTN].OP rp rq } ;
  -- E1: given the compatibilities of tau, evGt_t ~ tau . evA_t
  module E1M (cTp : GB.CLine[l].Lines[G, T].CompK[GB.e0, GB.e1].Comp)
    (addC : (X : L.PTy[G]) (f g : HO.NMap[G, X, A])
      -> L.PEl[L.extP G X, HO.HT[G, X, T, CApOp2G[a, vl, l].On[C].AO[G, X, T, addT, addTN].OP (HO.compN G X A T f tau) (HO.compN G X A T g tau),
           HO.compN G X A T (CApOp2G[a, vl, l].On[C].AO[G, X, A, addA, addAN].OP f g) tau].PT.PathP])
    (mulC : (X : L.PTy[G]) (f g : HO.NMap[G, X, A])
      -> L.PEl[L.extP G X, HO.HT[G, X, T, CApOp2G[a, vl, l].On[C].AO[G, X, T, mulT, mulTN].OP (HO.compN G X A T f tau) (HO.compN G X A T g tau),
           HO.compN G X A T (CApOp2G[a, vl, l].On[C].AO[G, X, A, mulA, mulAN].OP f g) tau].PT.PathP])
    (cC : (r : R.R) (X : L.PTy[G])
      -> L.PEl[L.extP G X, HO.HT[G, X, T, constN X T (cT r) (cTN r), HO.compN G X A T (constN X A (cA r) (cAN r)) tau].PT.PathP]) {
   E1 (k : Nat) : (t : SX.Over[R].Expr (SX.Fin k))
     -> L.PEl[L.extP G (Pm k), HO.HT[G, Pm k, T, evGt k t, HO.compN G (Pm k) A T (evA k t) tau].PT.PathP] = split {
    var v -> HO.Rf[G, Pm k, T, HO.compN G (Pm k) A T (proj k v) tau].res ;
    cst r -> cC r (Pm k) ;
    sumE p q | rp rq -> HO.Cat[G, Pm k, T,
       CApOp2G[a, vl, l].On[C].AO[G, Pm k, T, addT, addTN].OP (evGt k p) (evGt k q),
       CApOp2G[a, vl, l].On[C].AO[G, Pm k, T, addT, addTN].OP (HO.compN G (Pm k) A T (evA k p) tau) (HO.compN G (Pm k) A T (evA k q) tau),
       HO.compN G (Pm k) A T (CApOp2G[a, vl, l].On[C].AO[G, Pm k, A, addA, addAN].OP (evA k p) (evA k q)) tau, cTp,
       CApOp2G[a, vl, l].On[C].AO[G, Pm k, T, addT, addTN].Ap[evGt k p, HO.compN G (Pm k) A T (evA k p) tau, evGt k q, HO.compN G (Pm k) A T (evA k q) tau, rp, rq].res,
       addC (Pm k) (evA k p) (evA k q)].res ;
    mulE p q | rp rq -> HO.Cat[G, Pm k, T,
       CApOp2G[a, vl, l].On[C].AO[G, Pm k, T, mulT, mulTN].OP (evGt k p) (evGt k q),
       CApOp2G[a, vl, l].On[C].AO[G, Pm k, T, mulT, mulTN].OP (HO.compN G (Pm k) A T (evA k p) tau) (HO.compN G (Pm k) A T (evA k q) tau),
       HO.compN G (Pm k) A T (CApOp2G[a, vl, l].On[C].AO[G, Pm k, A, mulA, mulAN].OP (evA k p) (evA k q)) tau, cTp,
       CApOp2G[a, vl, l].On[C].AO[G, Pm k, T, mulT, mulTN].Ap[evGt k p, HO.compN G (Pm k) A T (evA k p) tau, evGt k q, HO.compN G (Pm k) A T (evA k q) tau, rp, rq].res,
       mulC (Pm k) (evA k p) (evA k q)].res } ;
  } ;
 } ;
} ;
