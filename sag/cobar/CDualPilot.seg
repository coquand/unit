-- Fixed-presentation duality pilot: instantiate Lemma 59 with the concrete
-- spectrum and G.  Proposition 58's local equivalence remains a premise.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Fixed (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module RS = CRhoSig[a].RS[R, encK, pe, y, u] ;
 module L59 = CL59r[a].L59[R, encK, pe, y, u] ;
 Q : L59.G1.fibCwF-T.Ty L59.G1.fibCwF-T.nil = CAxPow[a].PowOf[R, encK, pe].GTy ;
 module P = L59.Data[RS.A, RS.rho, RS.rho1, Q] ;
 module Hyp (ef : L59.TR.G0.GB.CEquiv[a+].EquivOp P.K1.JD.RM.PD.UG P.K1.JD.RM.PD.UA P.K1.JD.RM.PD.UB P.K1.JD.RM.PD.Uf)
  (mQ : L59.G1.GB.CEquiv[a+].EquivOp L59.CT.P1 Q.1 P.K1.IVd.B2Q P.K1.IVd.C15Q.tauM) {
  module H = P.Hyp[ef, mQ] ;
  ev : H.HO0.NMap[L59.LA.Nl, P.DA0.PiC, P.DA0.QC] = H.ev ;
  inv : H.HO0.NMap[L59.LA.Nl, P.DA0.QC, P.DA0.PiC] = H.inv ;
  -- H.h1 and H.h2 certify the two inverse laws at this copy.
 } ;
} ;
