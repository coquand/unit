-- CSubCong.seg (canonicity-45; SIMPLIFIED.md step 6): substitution
-- respects derivations in the substituted terms.  For terms of a free
-- presentation s (no equations) and two substitutions sg, sg' of terms of
-- t for its generators, pointwise provably equal over t, the substituted
-- terms are provably equal over t (induction on the term: the variable
-- case is the given proof, the constant case reflP, the operations sumP /
-- mulP).  With the valuation of the two generators of F2 by a pair of
-- terms (val2) and of the one generator of F1 (val1).
-- No new axioms.

level l ;
open Base ;
open Prelude[l] ;
open Paths[l] ;
open Ring[l] ;
module SX = CSyntax[l] ;

module Cong (R : CRing) (n : Nat) (t : SX.Over[R].Presentation) {
 module Dt = SX.Over[R].Der[t] ;
 Vn : U l = SX.Fin n ;
 sb (sg : Vn -> Dt.Term) : SX.Over[R].Expr Vn -> Dt.Term = CSubst[l].SE[R].subE Vn (SX.Fin t.1) sg ;
 cong (sg sg' : Vn -> Dt.Term) (P : (v : Vn) -> Dt.Proof (sg v) (sg' v)) : (e : SX.Over[R].Expr Vn) -> Dt.Proof (sb sg e) (sb sg' e) = split {
  var v -> P v ;
  cst r -> Dt.reflP (cst r) ;
  sumE p q | rp rq -> Dt.sumP (sb sg p) (sb sg' p) (sb sg q) (sb sg' q) rp rq ;
  mulE p q | rp rq -> Dt.mulP (sb sg p) (sb sg' p) (sb sg q) (sb sg' q) rp rq } ;
} ;

-- valuations of the generators of F1 and F2 by terms
module Val (R : CRing) (t : SX.Over[R].Presentation) {
 module Dt = SX.Over[R].Der[t] ;
 val1 (s1 : Dt.Term) : SX.Fin (suc zero) -> Dt.Term = \ v -> s1 ;
 val2 (s1 s2 : Dt.Term) : SX.Fin (suc (suc zero)) -> Dt.Term = split {
  inl v -> s1 ;
  inr u -> s2 } ;
 -- pointwise proofs from proofs of the two components
 pv2 (s1 s1' s2 s2' : Dt.Term) (w1 : Dt.Proof s1 s1') (w2 : Dt.Proof s2 s2')
  : (v : SX.Fin (suc (suc zero))) -> Dt.Proof (val2 s1 s2 v) (val2 s1' s2' v) = split {
  inl v -> w1 ;
  inr u -> w2 } ;
} ;
