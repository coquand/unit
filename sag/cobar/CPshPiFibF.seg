-- CPshPiFibF.seg (canonicity-c2; COBAR.md (B) stage 2(c), M3): Pi of
-- uniformly fibrant C-types is uniformly fibrant.
--
-- piUFib uA uB : UFib (Pi_A B), from uA : UFib A and uB : UFib B.  Each
-- direction d composes B and fills A backwards: the filler of A at the
-- end tgt d is CFill.FillC of the composition of A in the other
-- direction, uniform in C by CPshFillU.FU.res; then CPshPiFibN (the
-- compositions at each x) and CPshPiFibU (their uniformity).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module PFOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module UU = CPshPiFibU[a, l].UOf[C] ;
 module FL = CPshFillU[a, l].FillUOf[C] ;
 open P ;

 module PF (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (uA : LO.UF[G, A].UFib) (uB : LO.UF[LO.ExtC G A, B].UFib) {
  PiT : CTy[G] = PO.PiC[G, A, B].PiT ;
  -- from e0 to e1: fill A backwards from the composition e1 -> e0
  module FA1 = FL.FU[G, A, false, \ y -> (uA.1 y).2, uA.2.2] ;
  module U1 = UU.Ud[G, A, B, true, \ y -> PB.CFill[l].FillC[G.ob y, A.ty y, false, (uA.1 y).2].fill, \ y -> (uB.1 y).1, FA1.res, uB.2.1] ;
  -- from e1 to e0: fill A backwards from the composition e0 -> e1
  module FA0 = FL.FU[G, A, true, \ y -> (uA.1 y).1, uA.2.1] ;
  module U0 = UU.Ud[G, A, B, false, \ y -> PB.CFill[l].FillC[G.ob y, A.ty y, true, (uA.1 y).1].fill, \ y -> (uB.1 y).2, FA0.res, uB.2.2] ;

  lfib : LFib G PiT = \ x -> (U1.comp x, U0.comp x) ;
  piUFib : LO.UF[G, PiT].UFib = (lfib, U1.ucomp, U0.ucomp) ;
 } ;
} ;
