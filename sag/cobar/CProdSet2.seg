-- CProdSet2.seg (canonicity-c2): CProdSet, the conclusion by Hedberg: A x A'
-- is a set.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;

module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
idFwdL (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (u : C.El G (IJ.IdT G X x y))
  : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)) =
 idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y))) u X' P ;
idBackL (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (u : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)))
  : C.El G (IJ.IdT G X x y) =
 idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y)) -> C.El G (IJ.IdT G X x y)) (\ v -> v) X' P u ;
module ProdSet2 (A A' : C.Ty C.nil) (sA : CQCtx[a].G3Of[A].SetQiTy) (sA' : CQCtx[a].G3Of[A'].SetQiTy) {
 module P = CProdSet[a].ProdSet[A, A', sA, sA'] ;
 Nl : C.Ctx = C.nil ;
 S : C.Ty Nl = P.S ;
 module GS = P.GS ;
 G1 : C.Ctx = P.G1 ;
 G2 : C.Ctx = P.G2 ;
 R : C.Ty G2 = P.R ;
 GR : C.Ctx = P.GR ;
 SR : C.Ty GR = P.SR ;
 pRp : C.Sub GR G2 = P.pRp ;
 x0 : C.El G1 GS.Qw = P.x0 ;
  module H6 = CwFHed6.Hed6[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibNF[a, a+].nf] ;
 fH : C.El GR (OV.wkT G2 R (H6.JP.IK G1 GS.Qw x0)) =
  OV.trE GR (IJ.IdT GR (OV.wkT G2 R GS.Qw2) (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2)) (OV.wkT G2 R (H6.JP.IK G1 GS.Qw x0))
   (symH (IJ.IdT-nat GR G2 GS.Qw2 GS.v1 GS.v2 pRp)) P.fB ;
 module HS6 = H6.S[G1, GS.Qw, x0, R, P.rho, fH, P.pR] ;
 -- A x A' IS A SET
 setQi : GS.SetQiTy = OV.lam Nl S (FibCwF[a, a+].fibPi.Pi G1 GS.Qw GS.SP) (OV.lam G1 GS.Qw GS.SP HS6.propIK) ;
} ;
