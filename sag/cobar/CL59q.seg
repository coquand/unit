-- CL59q.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part q: inv . ev ~ id at the copy y.  The homotopy M1 ~ ev'' over
-- Om (CL59p) read back as a path in U(Pi_A Q)|_y: at (W, phi), stage
-- (V, g, j), the Pi-element whose value at (K, f, v) is the line at the
-- point (phi restricted along g f, (f . id_y, v)) of Om.E, at K itself,
-- at the interval point j f.  Its ends: ev''(phi|f, (f . id, v)) = phi(f, v)
-- (lemma B: CPiE.apW-tact / apW-f / apW-E).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RB (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module HC = CL59p[a].H2c[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module HD = HC.HD ;
  module OL = HC.OL ;
  module DA0 = HD.DA0 ;
  module PE = DA0.PE ;
  module PC = PE.PC ;
  -- lemma B: the restricted code at the diagonal point
  module LB (W : Ob) (phi : V1.Ix (DA0.piTob W tt)) (K : CT.TC.TOb) (f : CT.TC.THm K (W, y)) (av : V1.Ix (A.1.tob K (LA.PYy.act K (W, y) f (DA0.idy W)))) {
   I0 : CT.TC.TOb = (W, y) ;
   J0 : CT.TC.TOb = (K.1, y) ;
   hJ : CT.TC.THm J0 I0 = (f.1, CM.IC.cart K.1 W f.1 y) ;
   e : V1.Ix (OL.E.ob K) = (LA.PYy.act K I0 f (DA0.idy W), av) ;
   m1 : CT.TC.THm K I0 = CT.TC.TotCat.oC K J0 I0 hJ (OL.fy K e.1) ;
   p1 : Id (V1.Ix (LA.PYy.ob K)) (LA.PYy.act K I0 m1 (DA0.idy W)) e.1 =
    CM.MO.Fn[y, K.2].mExt K.1 (LA.PYy.act K I0 m1 (DA0.idy W)) e.1 (refl (CM.MO.Fn[y, K.2].fpOf K.1 e.1)) ;
   F : Id (CT.TC.THm K I0) m1 f =
    CM.CO.pq K.1 W K.2 y (compH K.1 K.1 W f.1 (idH K.1)) f.1 (comp-idr K.1 W f.1) m1.2 f.2
     (CM.MO.Fn[y, K.2].mExt K.1 m1.2 f.2 (refl (CM.MO.Fn[y, K.2].fpOf K.1 f.2))) ;
   chain : Id (PE.TB.EI K) (PE.TB.pr K e (OL.ev2 K (DA0.piTact K.1 W f.1 tt tt (refl tt) phi) e)) (PE.TB.pr K e (phi.1 K f av)) =
    transH (PE.apW-tact J0 I0 hJ (DA0.idy W) (DA0.idy K.1) (DA0.idyR K.1 W f.1) phi K (OL.fy K e.1) e (OL.pEq K e.1) p1)
     (transH (PE.apW-f I0 (DA0.idy W) phi K m1 f F e p1 (refl e.1))
       (PE.apW-E I0 (DA0.idy W) phi K f e (refl e.1) av (refl e))) ;
   law : Id (V1.Ix (Q.1.tob K tt)) (OL.ev2 K (DA0.piTact K.1 W f.1 tt tt (refl tt) phi) e) (phi.1 K f av) =
    PE.TB.pr-inj K e (OL.ev2 K (DA0.piTact K.1 W f.1 tt tt (refl tt) phi) e) (phi.1 K f av) chain ;
  } ;
  module Hyp (ef : TR.G0.GB.CEquiv[a+].EquivOp HD.JD.RM.PD.UG HD.JD.RM.PD.UA HD.JD.RM.PD.UB HD.JD.RM.PD.Uf)
   (mQ : G1.GB.CEquiv[a+].EquivOp CT.P1 Q.1 HD.JD.IVd.B2Q HD.JD.IVd.C15Q.tauM) {
   module CP = HC.Hyp[ef, mQ] ;
   module TT = CP.CA2.T ;
   module TQw = CP.TQw ;
   module PS1 = HC.PS1 ;
   Lval (K : CT.TC.TOb) (ph : V1.Ix (OL.POm.ob K)) (e : V1.Ix (OL.E.ob K)) (jj : Hom K.1 Iv) : V1.Ix (Q.1.tob K tt) =
    TQw.pr2 K (TT.pv CP.h2g K (ph, e) K (CT.TC.tid K) jj) ;
   -- the Pi-element at the stage (V, g, j)
   module Cd (W : Ob) (phi : V1.Ix (DA0.piTob W tt)) (Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv) {
    I0 : CT.TC.TOb = (Vv, y) ;
    pt : PC.Pt I0 = PC.ptOf I0 (DA0.idy Vv) ;
    phK (K : CT.TC.TOb) (f : CT.TC.THm K I0) : V1.Ix (OL.POm.ob K) = DA0.piTact K.1 W (compH K.1 Vv W g f.1) tt tt (refl tt) phi ;
    eK (K : CT.TC.TOb) (f : CT.TC.THm K I0) (av : V1.Ix (A.1.tob K (pt K f))) : V1.Ix (OL.E.ob K) = (pt K f, av) ;
    fun (K : CT.TC.TOb) (f : CT.TC.THm K I0) (av : V1.Ix (A.1.tob K (pt K f))) : V1.Ix (Q.1.tob K tt) =
     Lval K (phK K f) (eK K f av) (compH K.1 Vv Iv j f.1) ;
    module NT (J K : CT.TC.TOb) (f : CT.TC.THm J I0) (g' : CT.TC.THm K J) (av : V1.Ix (A.1.tob J (pt J f))) {
     fg : CT.TC.THm K I0 = CT.TC.TotCat.oC K J I0 f g' ;
     a' : V1.Ix (A.1.tob K (pt K fg)) = PC.AactOf I0 pt (PC.cOf I0 (DA0.idy Vv)) J K f g' av ;
     zJ : V1.Ix (TT.GA.ob J) = (phK J f, eK J f av) ;
     zK : V1.Ix (TT.GA.ob K) = (phK K fg, eK K fg a') ;
     jJ : Hom J.1 Iv = compH J.1 Vv Iv j f.1 ;
     jj' : Hom K.1 Iv = compH K.1 J.1 Iv jJ g'.1 ;
     w : TQw.EI J = TT.pv CP.h2g J zJ J (CT.TC.tid J) jJ ;
     phiEq : Id (V1.Ix (OL.POm.ob K)) (DA0.piTact K.1 J.1 g'.1 tt tt (refl tt) (phK J f)) (phK K fg) =
      transH (symH (DA0.PiC.tact-o K.1 J.1 W (compH J.1 Vv W g f.1) g'.1 tt tt tt (refl tt) (refl tt) (refl tt) phi))
       (apH {Hom K.1 W} {V1.Ix (OL.POm.ob K)} (\ k -> DA0.piTact K.1 W k tt tt (refl tt) phi) (comp-assoc K.1 J.1 Vv W g f.1 g'.1)) ;
     zEq : Id (V1.Ix (TT.GA.ob K)) (TT.GA.act K J g' zJ) zK =
      transH (apH {V1.Ix (OL.POm.ob K)} {V1.Ix (TT.GA.ob K)} (\ p -> (p, OL.E.act K J g' (eK J f av))) phiEq)
       (apH {V1.Ix (OL.E.ob K)} {V1.Ix (TT.GA.ob K)} (\ e2 -> (phK K fg, e2)) (PC.eOf I0 (DA0.idy Vv) J K f g' av)) ;
     lawE : Id (TQw.EI K) (TQw.E.act K J g' w) (TT.pv CP.h2g K zK K (CT.TC.tid K) (compH K.1 Vv Iv j fg.1)) =
      transH ((CP.h2g.eob J zJ).1.2 K J g' (CT.TC.tid J) jJ)
       (transH (apH {CT.TC.THm K J} {TQw.EI K} (\ k -> TT.pv CP.h2g J zJ K k jj') (transH (CT.TC.TotCat.oC-idl K J g') (symH (CT.TC.TotCat.oC-idr K J g'))))
         (transH (TT.pv-res CP.h2g K J g' zJ (TT.GA.act K J g' zJ) (refl (TT.GA.act K J g' zJ)) K (CT.TC.tid K) jj')
           (transH (apH {V1.Ix (TT.GA.ob K)} {TQw.EI K} (\ z2 -> TT.pv CP.h2g K z2 K (CT.TC.tid K) jj') zEq)
             (apH {Hom K.1 Iv} {TQw.EI K} (\ jx -> TT.pv CP.h2g K zK K (CT.TC.tid K) jx) (comp-assoc K.1 J.1 Vv Iv j f.1 g'.1))))) ;
     law : Id (V1.Ix (Q.1.tob K tt)) (PC.BactOf I0 pt (PC.cOf I0 (DA0.idy Vv)) (PC.eOf I0 (DA0.idy Vv)) J K f g' av (fun J f av)) (fun K fg a') =
      transH (PS1.tact-irr G1.fibCwF-T.nil Q.1 K J g' tt tt
                (PS1.ntEq OL.E G1.fibCwF-T.nil (G1.fibCwF-T.eps OL.E) K J g' (eK J f av) (eK K fg a') (PC.eOf I0 (DA0.idy Vv) J K f g' av))
                (PS1.ntEq OL.POm G1.fibCwF-T.nil (G1.fibCwF-T.eps OL.POm) K J g' (TQw.pr1 J w) (OL.POm.act K J g' (TQw.pr1 J w)) (refl (OL.POm.act K J g' (TQw.pr1 J w))))
                (fun J f av))
       (apH {TQw.EI K} {V1.Ix (Q.1.tob K tt)} (TQw.pr2 K) lawE) ;
    } ;
    code : V1.Ix (DA0.piTob Vv tt) = (fun, \ J K f g' av -> NT[J, K, f, g', av].law) ;
   } ;
   LvC (K : CT.TC.TOb) (ph ph' : V1.Ix (OL.POm.ob K)) (pE : Id (V1.Ix (OL.POm.ob K)) ph ph') (e e' : V1.Ix (OL.E.ob K)) (eE : Id (V1.Ix (OL.E.ob K)) e e')
    (jj jj' : Hom K.1 Iv) (jE : Id (Hom K.1 Iv) jj jj') : Id (V1.Ix (Q.1.tob K tt)) (Lval K ph e jj) (Lval K ph' e' jj') =
    transH (apH {V1.Ix (OL.POm.ob K)} {V1.Ix (Q.1.tob K tt)} (\ p0 -> Lval K p0 e jj) pE)
     (transH (apH {V1.Ix (OL.E.ob K)} {V1.Ix (Q.1.tob K tt)} (\ e0 -> Lval K ph' e0 jj) eE)
       (apH {Hom K.1 Iv} {V1.Ix (Q.1.tob K tt)} (\ j0 -> Lval K ph' e' j0) jE)) ;
   module J1 = CP.H.J1 ;
   module HO0 = J1.HO0 ;
   compo2 : HO0.NMap[LA.Nl, DA0.PiC, DA0.PiC] = HO0.compN LA.Nl DA0.PiC DA0.QC DA0.PiC J1.evNM J1.invNM ;
   module HC3 = HO0.HT[LA.Nl, DA0.PiC, DA0.PiC, compo2, HO0.idN LA.Nl DA0.PiC] ;
   module TYP = PB.GPre[a+].TyL[LA.Nl, DA0.PiC] ;
   tvr (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (phi : V1.Ix (DA0.piTob W tt)) (Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv) : TYP.EI Vv = TYP.pr Vv o (Cd[W, phi, Vv, g, j].code) ;
   -- naturality in the stage
   module CN (W : Ob) (phi : V1.Ix (DA0.piTob W tt)) (V2 Vv : Ob) (g2 : Hom V2 Vv) (g : Hom Vv W) (j : Hom Vv Iv) {
    module C1 = Cd[W, phi, Vv, g, j] ;
    module C2 = Cd[W, phi, V2, compH V2 Vv W g g2, compH V2 Vv Iv j g2] ;
    g0 : CT.TC.THm C2.I0 C1.I0 = (g2, CM.IC.cart V2 Vv g2 y) ;
    module At (K : CT.TC.TOb) (f : CT.TC.THm K C2.I0) (av : V1.Ix (A.1.tob K (C2.pt K f))) {
     hf : CT.TC.THm K C1.I0 = CT.TC.TotCat.oC K C2.I0 C1.I0 g0 f ;
     ppt : Id (V1.Ix (LA.PYy.ob K)) (LA.PYy.act K C1.I0 hf (DA0.idy Vv)) (LA.PYy.act K C2.I0 f (DA0.idy V2)) = PC.piPt C2.I0 C1.I0 g0 (DA0.idy Vv) (DA0.idy V2) (DA0.idyR V2 Vv g2) K f ;
     bv : V1.Ix (A.1.tob K (C1.pt K hf)) = PE.bk K (LA.PYy.act K C1.I0 hf (DA0.idy Vv)) (LA.PYy.act K C2.I0 f (DA0.idy V2)) ppt av ;
     pq0 : Id (PC.Pts K) (C1.pt K hf, bv) (C2.pt K f, av) = PE.pp K (LA.PYy.act K C1.I0 hf (DA0.idy Vv)) (LA.PYy.act K C2.I0 f (DA0.idy V2)) ppt av ;
     law : Id (V1.Ix (Q.1.tob K tt)) (subst (PC.Pts K) (\ z0 -> PC.FB K z0) (C1.pt K hf, bv) (C2.pt K f, av) pq0 (C1.fun K hf bv)) (C2.fun K f av) =
      transH (HC.HD.PLd.substC K (C1.pt K hf, bv) (C2.pt K f, av) pq0 (C1.fun K hf bv))
       (LvC K (C1.phK K hf) (C2.phK K f)
          (apH {Hom K.1 W} {V1.Ix (OL.POm.ob K)} (\ k -> DA0.piTact K.1 W k tt tt (refl tt) phi) (symH (comp-assoc K.1 V2 Vv W g g2 f.1)))
          (C1.eK K hf bv) (C2.eK K f av) pq0
          (compH K.1 Vv Iv j hf.1) (compH K.1 V2 Iv (compH V2 Vv Iv j g2) f.1) (symH (comp-assoc K.1 V2 Vv Iv j g2 f.1))) ;
    } ;
    codeEq : Id (V1.Ix (DA0.piTob V2 tt)) (DA0.piTact V2 Vv g2 tt tt (refl tt) C1.code) C2.code =
     PC.piCode-eq C2.I0 C2.pt (PC.cOf C2.I0 (DA0.idy V2)) (PC.eOf C2.I0 (DA0.idy V2)) (DA0.piTact V2 Vv g2 tt tt (refl tt) C1.code) C2.code
      (\ K f av -> At[K, f, av].law) ;
   } ;
   tnr (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (phi : V1.Ix (DA0.piTob W tt)) (V2 Vv : Ob) (g2 : Hom V2 Vv) (g : Hom Vv W) (j : Hom Vv Iv)
    : Id (TYP.EI V2) (TYP.E.act V2 Vv g2 (tvr W o phi Vv g j)) (tvr W o phi V2 (compH V2 Vv W g g2) (compH V2 Vv Iv j g2)) =
    transH (TYP.pr-tact V2 Vv g2 o o (refl o) (Cd[W, phi, Vv, g, j].code))
     (apH {V1.Ix (DA0.piTob V2 tt)} {TYP.EI V2} (TYP.pr V2 o) CN[W, phi, V2, Vv, g2, g, j].codeEq) ;
   -- the ends
   module PNe = G1.FT.GEqQinv[a+].PN[OL.POm, OL.Ew, OL.Qw, OL.ev''] ;
   N2b (K : CT.TC.TOb) (ph : V1.Ix (OL.POm.ob K)) (e : V1.Ix (OL.E.ob K)) : Id (V1.Ix (Q.1.tob K tt)) (HD.N2.nfun K ph e) (OL.ev2 K ph e) =
    TQw.pr-inj K ph (HD.N2.nfun K ph e) (OL.ev2 K ph e) (PNe.q K ph e) ;
   module En (W : Ob) (phi : V1.Ix (DA0.piTob W tt)) {
    module C0 = Cd[W, phi, W, idH W, PB.ptH W PB.e0] ;
    module C1 = Cd[W, phi, W, idH W, PB.ptH W PB.e1] ;
    s0 : V1.Ix (DA0.piTob W tt) = CP.H.sgm (W, y) phi ;
    phK (K : CT.TC.TOb) (f : CT.TC.THm K (W, y)) : V1.Ix (OL.POm.ob K) = DA0.piTact K.1 W f.1 tt tt (refl tt) phi ;
    adj (K : CT.TC.TOb) (f : CT.TC.THm K (W, y)) (av : V1.Ix (A.1.tob K (C0.pt K f))) (ep : PB.IPt)
     : Id (V1.Ix (Q.1.tob K tt)) (Lval K (C0.phK K f) (C0.eK K f av) (compH K.1 W Iv (PB.ptH W ep) f.1)) (Lval K (phK K f) (C0.eK K f av) (PB.ptH K.1 ep)) =
     LvC K (C0.phK K f) (phK K f) (apH {Hom K.1 W} {V1.Ix (OL.POm.ob K)} (\ k -> DA0.piTact K.1 W k tt tt (refl tt) phi) (comp-idl K.1 W f.1))
      (C0.eK K f av) (C0.eK K f av) (refl (C0.eK K f av)) (compH K.1 W Iv (PB.ptH W ep) f.1) (PB.ptH K.1 ep) (PB.ptH-nat K.1 W f.1 ep) ;
    at0 (K : CT.TC.TOb) (f : CT.TC.THm K (W, y)) (av : V1.Ix (A.1.tob K (C0.pt K f))) : Id (V1.Ix (Q.1.tob K tt)) (C0.fun K f av) (s0.1 K f av) =
     transH (adj K f av PB.e0)
      (transH (apH {TQw.EI K} {V1.Ix (Q.1.tob K tt)} (TQw.pr2 K) (CP.h2g.eob K (phK K f, C0.eK K f av)).2.2.1)
        (transH (apH {V1.Ix (OL.POm.ob K)} {V1.Ix (Q.1.tob K tt)} (\ p0 -> HD.N2.nfun K p0 (C0.eK K f av)) (symH (CP.H.sigN K (W, y) f phi)))
          (transH (N2b K (DA0.piTact K.1 W f.1 tt tt (refl tt) s0) (C0.eK K f av))
            (LB[W, s0, K, f, av].law)))) ;
    at1 (K : CT.TC.TOb) (f : CT.TC.THm K (W, y)) (av : V1.Ix (A.1.tob K (C0.pt K f))) : Id (V1.Ix (Q.1.tob K tt)) (C1.fun K f av) (phi.1 K f av) =
     transH (adj K f av PB.e1)
      (transH (apH {TQw.EI K} {V1.Ix (Q.1.tob K tt)} (TQw.pr2 K) (CP.h2g.eob K (phK K f, C0.eK K f av)).2.2.2)
        (transH (N2b K (phK K f) (C0.eK K f av)) (LB[W, phi, K, f, av].law))) ;
    codeE0 : Id (V1.Ix (DA0.piTob W tt)) C0.code s0 =
     PC.piCode-eq C0.I0 C0.pt (PC.cOf C0.I0 (DA0.idy W)) (PC.eOf C0.I0 (DA0.idy W)) C0.code s0 (\ K f av -> at0 K f av) ;
    codeE1 : Id (V1.Ix (DA0.piTob W tt)) C1.code phi =
     PC.piCode-eq C0.I0 C0.pt (PC.cOf C0.I0 (DA0.idy W)) (PC.eOf C0.I0 (DA0.idy W)) C1.code phi (\ K f av -> at1 K f av) ;
   } ;
   pathr (W : Ob) (zz : V1.Ix (HC3.GA.ob W)) : V1.Ix (HC3.PT.tobP W zz) =
    HC3.PT.mkPath W zz (\ Vv g j -> tvr W (TYP.pr1 W zz) (TYP.pr2 W zz) Vv g j)
     (\ V2 Vv g2 g j -> tnr W (TYP.pr1 W zz) (TYP.pr2 W zz) V2 Vv g2 g j)
     (\ Vv g j -> refl (TYP.pr1 W zz))
     (apH {V1.Ix (DA0.piTob W tt)} {TYP.EI W} (TYP.pr W (TYP.pr1 W zz)) En[W, TYP.pr2 W zz].codeE0)
     (apH {V1.Ix (DA0.piTob W tt)} {TYP.EI W} (TYP.pr W (TYP.pr1 W zz)) En[W, TYP.pr2 W zz].codeE1) ;
   -- naturality in the point
   module RN (J I : Ob) (h : Hom J I) (phi : V1.Ix (DA0.piTob I tt)) (Vv : Ob) (f : Hom Vv J) (i : Hom Vv Iv) {
    module Ca = Cd[I, phi, Vv, compH Vv J I h f, i] ;
    module Cb = Cd[J, DA0.piTact J I h tt tt (refl tt) phi, Vv, f, i] ;
    codeEq : Id (V1.Ix (DA0.piTob Vv tt)) Ca.code Cb.code =
     PC.piCode-eq Ca.I0 Ca.pt (PC.cOf Ca.I0 (DA0.idy Vv)) (PC.eOf Ca.I0 (DA0.idy Vv)) Ca.code Cb.code (\ K f' av ->
      LvC K (Ca.phK K f') (Cb.phK K f')
       (transH (apH {Hom K.1 I} {V1.Ix (OL.POm.ob K)} (\ k -> DA0.piTact K.1 I k tt tt (refl tt) phi) (comp-assoc K.1 Vv J I h f f'.1))
         (DA0.PiC.tact-o K.1 J I h (compH K.1 Vv J f f'.1) tt tt tt (refl tt) (refl tt) (refl tt) phi))
       (Ca.eK K f' av) (Cb.eK K f' av) (refl (Ca.eK K f' av))
       (compH K.1 Vv Iv i f'.1) (compH K.1 Vv Iv i f'.1) (refl (compH K.1 Vv Iv i f'.1))) ;
   } ;
   enatr (J I : Ob) (h : Hom J I) (zz : V1.Ix (HC3.GA.ob I)) (zz' : V1.Ix (HC3.GA.ob J)) (ee : Id (V1.Ix (HC3.GA.ob J)) (HC3.GA.act J I h zz) zz')
    : Id (V1.Ix (HC3.PT.tobP J zz')) (HC3.PT.PathP.tact J I h zz zz' ee (pathr I zz)) (pathr J zz') =
    HC3.PT.path-eq J zz' (HC3.PT.PathP.tact J I h zz zz' ee (pathr I zz)) (pathr J zz') (\ Vv f i ->
     transH (apH {V1.Ix (DA0.piTob Vv tt)} {TYP.EI Vv} (TYP.pr Vv (TYP.pr1 I zz)) RN[J, I, h, TYP.pr2 I zz, Vv, f, i].codeEq)
      (apH {V1.Ix (HC3.GA.ob J)} {TYP.EI Vv} (\ z2 -> tvr J (TYP.pr1 J z2) (TYP.pr2 J z2) Vv f i) ee)) ;
   -- H2 : inv . ev ~ id at the copy
   h2 : L.PEl[HC3.GA, HC3.PT.PathP] = new L.PEl[HC3.GA, HC3.PT.PathP, pathr, enatr] ;
  } ;
 } ;
} ;
