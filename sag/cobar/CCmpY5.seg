-- CCmpY5.seg (canonicity-45; COBAR.md "Prop 58"): G's operations with the
-- inverse of D of the comparison taken from EqQinv's quasi-inverse (4e's
-- ruling (i)): it carries the paths inv . D cmp ~ id and D cmp . inv ~ id,
-- which tau's compatibility with the operations needs.  D(yo F2) and
-- D(yo F1 x yo F1) are fibrant by Lemma 12F: yo F2 levelwise by CCopy9,
-- yo F1 x yo F1 levelwise as a Sigma of two copies of CCopy6's (the second
-- pulled back along the projection), as CL59g.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module FC = FibCwF[a, a+].FC ;

-- yo F1 x yo F1 is levelwise fibrant
module F11 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module BS = CCmpY[a].CmpBase[R, encK, pe] ;
 module YF = CCopy6[a].YoF[R, encK, pe] ;
 module TR = BS.TR ;
 UA11 : TR.P0.PTy[BS.UG] = TR.RS.rT BS.GP BS.O11.Y1T ;
 module Cp (y' : SX.Over[R].Presentation) {
  module C6 = YF.Cp[y'] ;
  module Cy = C6.Cy ;
  D : L.PCtx = C6.D ;
  T1 : L.PTy[D] = C6.A' ;
  K : L.PCtx = L.extP D T1 ;
  pK : L.PSub[K, D] = L.pP D T1 ;
  T2 : L.PTy[K] = L.subTy K D T1 pK ;
  fb2 : PB.CLine[a+].Lines[K, T2].Fib = PB.CFibSub[a+].FibSub[K, D, pK, T1].sub C6.fib ;
  SgP : L.PTy[D] = PresheafFormers[a, a+].PFormers[PB.BC].SigAB[D, T1, T2].SigP ;
  fbS : PB.CLine[a+].Lines[D, SgP].Fib = PB.CSig[a+].SigFib[D, T1, T2, C6.fib, fb2].fib ;
  A' : L.PTy[D] = Cy.rTy BS.UG UA11 ;
  module TA' = PB.GPre[a+].TyL[D, A'] ;
  module TS = PB.GPre[a+].TyL[D, SgP] ;
  ta (W : Ob) (v : TA'.EI W) : TS.EI W = TS.pr W (TA'.pr1 W v) (TA'.pr2 W v) ;
  tanat (Vv W : Ob) (g : Hom Vv W) (v : TA'.EI W) : Id (TS.EI Vv) (TS.E.act Vv W g (ta W v)) (ta Vv (TA'.E.act Vv W g v)) =
   refl (ta Vv (TA'.E.act Vv W g v)) ;
  tainj (W : Ob) (v v' : TA'.EI W) (Pp : Id (V1.Ix (D.ob W)) (TA'.pr1 W v) (TA'.pr1 W v')) (Q0 : Id (TS.EI W) (ta W v) (ta W v')) : Id (TA'.EI W) v v' = Q0 ;
  module CRT = PB.CCart[a+, a+].Cart[D, A', D, SgP, \ W o -> o, \ Vv W g d -> refl (D.act Vv W g d), ta, \ W v -> refl (TA'.pr1 W v),
    tanat, tainj, \ X x uu -> uu, \ X x uu -> refl (TS.pr X x uu)] ;
  fib : PB.CLine[a+].Lines[D, A'].Fib = CRT.moveFib fbS ;
 } ;
 fibG0 : TR.G0.GB.CLine[a+].Lines[BS.UG, UA11].Fib = CCopy5[a].FibC[R, encK, pe, BS.UG, UA11, \ y' -> Cp[y'].fib].fib ;
} ;

-- G's operations with EqQinv's quasi-inverse of D cmp
module Ops2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) {
 module FN = CCmpY3[a].Fin[R, encK, pe, al, eqal, commH] ;
 module BS = FN.BS ;
 module P13 = FN.P13 ;
 module TR = BS.TR ;
 module P = TR.P1 ;
 module G1 = TR.G1 ;
 module Q2 = BS.O2 ;
 module Q11 = BS.O11 ;
 module LF2 = CTotL12Fib2[a, a+, a+].L12F[BS.CM.IC, BS.CT.T1, Q2.Y1T] ;
 module LF11 = CTotL12Fib2[a, a+, a+].L12F[BS.CM.IC, BS.CT.T1, Q11.Y1T] ;
 fbD2 : G1.GB.CLine[a+].Lines[BS.CT.TC.toP LF2.D.DCtx, LF2.DA.DTy].Fib = LF2.lemma12F CCopy9[a].YoFF[R, encK, pe, BS.FR.F2].fibG0 ;
 fbD11 : G1.GB.CLine[a+].Lines[BS.CT.TC.toP LF11.D.DCtx, LF11.DA.DTy].Fib = LF11.lemma12F F11[R, encK, pe].fibG0 ;
 -- the quasi-inverse of D cmp, with its two homotopies (EQ.EI.eta, EQ.EI.eps)
 module EQ = G1.FT.GEqQinv[a+].EQP[P13.DF.DG, (P13.DF.DA.DTy, fbD2), (P13.DF.DB.DTy, fbD11), P13.DF.Df, FN.dcmp] ;
 ip : G1.GB.CPartial[a+].PMap[P13.DF.DG, P13.DF.DB.DTy, P13.DF.DA.DTy] = G1.FT.GCLocBoundRetr[a+].Map[P13.DF.DG, P13.DF.DB.DTy, P13.DF.DA.DTy, EQ.EI.gN].pmap ;
 invE : P.PSub[Q11.PR.Ext, Q2.PR.Ext] =
  new P.PSub[Q11.PR.Ext, Q2.PR.Ext, \ X w -> ip.mE X w, \ Y X h w -> ip.mnat Y X h w] ;
 invP : P.PSub[Q11.DYP, Q2.DYP] =
  new P.PSub[Q11.DYP, Q2.DYP, \ X d -> Q2.fwS.nt X (invE.nt X (Q11.bkS.nt X d)),
   \ Y X h d -> transH (apH {V1.Ix (Q2.PR.Ext.ob Y)} {V1.Ix (Q2.DYP.ob Y)} (Q2.fwS.nt Y)
                         (transH (apH {V1.Ix (Q11.PR.Ext.ob Y)} {V1.Ix (Q2.PR.Ext.ob Y)} (invE.nt Y) (Q11.bkS.nt-nat Y X h d)) (invE.nt-nat Y X h (Q11.bkS.nt X d))))
                 (Q2.fwS.nt-nat Y X h (invE.nt X (Q11.bkS.nt X d)))] ;
 inv : BS.CM.TP.TSub[Q11.DY.DCtx, Q2.DY.DCtx] =
  new BS.CM.TP.TSub[Q11.DY.DCtx, Q2.DY.DCtx, \ I x d -> invP.nt (I, x) d, \ J I u y x f d -> invP.nt-nat (J, y) (I, x) (u, f) d] ;
 -- G's operations
 module GO = CGops[a].GopsOf[R, encK, pe,
   \ x -> CwFQuotElim2[a].QE2[R, encK, x, pe].elim1, \ x -> CwFQuotElim2[a].QE2[R, encK, x, pe].elim1-beta,
   \ x -> CwFQuotElim1[a].QE1[R, encK, x, pe].setQ,
   \ x -> CwFQuotElim3[a].QE3[R, encK, x, pe].elim2, \ x -> CwFQuotElim3[a].QE3[R, encK, x, pe].elim2-beta,
   \ x -> CwFQuotElim1[a].QE1[R, encK, x, pe].elimP1, \ x -> CwFQuotElim5[a].QE5[R, encK, x, pe].elimP3,
   \ x -> CwFQuotElim1[a].QE1[R, encK, x, pe].setQi, inv] ;
} ;
