-- GPosIdY.seg: GENERATED from PosIdY.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change PosIdY.seg or the generator.
-- PosIdY.seg (M1, step 3): Swan's identity type in Yoneda form, on the base
-- PosFull.  Core's Id (CId.IdOver over CPath.PathOverE) has paths valued in
-- the total space G.A, so its fibre codes mention G and Id(a , b)[r] is
-- Id(a[r] , b[r]) only up to a cart (M1.md, Obstacle).  Here a path at x
-- has values in the fibres of A at the points x f:
--
--   u W f j : A(W , x f)                     for f : W -> X, j : W -> I
--   natural:   u W f j . g = u V (f g) (j g)
--   ends:      u W f e0 = a (x f),  u W f e1 = b (x f)    at every (W , f)
--   a sieve q with u W f j = a (x f) for f landing in q.
--
-- The fibre code is codeY X p pn, a function of the point family
-- p W f = x f (and of its naturality pn, a proposition).  Over G' with
-- A[r], a[r], b[r] the code at x' is literally codeY at W f |-> r (x' f), so
-- the substituted type and the type of the substituted data have codes
-- equal by funext (r is natural): IdT-nat holds as an equality of types.
--
-- Informal text.
-- (1) Codes: valV (values), natV, endV, the constancy ConstC (a
--     proposition, coded by encProp), codeY.
-- (2) Reading a value in the total space, rd w W f j = (x f , u W f j); two
--     elements with the same readings and the same sieve are equal (the
--     other components are propositions): idY-eq.
-- (3) Restriction along h with x h = y: values u (h f) coerced along
--     x (h f) = y f; its readings are those of u at h f, which gives its
--     naturality, ends and constancy; the two laws are idY-eq.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module EP = Encode[l, l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;

module IdY (G : PCtx) (A : PTy[G]) (a0 b0 : PEl[G, A]) {
  module TA = GPR.TyL[G, A] ;

  ----------------------------------------------------------------------
  -- (1) the codes, for a point family p over X

  valV (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W)) : W0.V =
    CL.piO (\ W -> CL.piH W X (\ f -> CL.piI W (\ j -> A.tob W (p W f)))) ;

  natV (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W))
    (pn : (V W : Ob) (g : Hom V W) (f : Hom W X) -> Id (W0.Ix (G.ob V)) (G.act V W g (p W f)) (p V (compH V W X f g)))
    (u : W0.Ix (valV X p)) : W0.V =
    CL.piO (\ V -> CL.piO (\ W -> CL.piH V W (\ g -> CL.piH W X (\ f -> CL.piI W (\ j ->
      W0.IdV (A.tob V (p V (compH V W X f g)))
        (A.tact V W g (p W f) (p V (compH V W X f g)) (pn V W g f) (u W f j))
        (u V (compH V W X f g) (ivA V W g j))))))) ;

  endV (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W)) (c : PEl[G, A]) (e : PB.IPt) (u : W0.Ix (valV X p)) : W0.V =
    CL.piO (\ W -> CL.piH W X (\ f -> W0.IdV (A.tob W (p W f)) (u W f (PB.ptH W e)) (c.eob W (p W f)))) ;

  pathV (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W))
    (pn : (V W : Ob) (g : Hom V W) (f : Hom W X) -> Id (W0.Ix (G.ob V)) (G.act V W g (p W f)) (p V (compH V W X f g))) : W0.V =
    W0.SigV (valV X p) (\ u -> W0.SigV (natV X p pn u) (\ z -> W0.SigV (endV X p a0 e0 u) (\ z' -> endV X p b0 e1 u))) ;

  ConstC (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W)) (u : W0.Ix (valV X p)) (q : PB.Phi X) : U l =
    (W : Ob) (f : Hom W X) (i : PB.Lands W X q f) (j : IvP W) -> Id (W0.Ix (A.tob W (p W f))) (u W f j) (a0.eob W (p W f)) ;

  constC-prop (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W)) (u : W0.Ix (valV X p)) (q : PB.Phi X) : isProp (ConstC X p u q) =
    isProp-Pi Ob (\ W -> (f : Hom W X) (i : PB.Lands W X q f) (j : IvP W) -> Id (W0.Ix (A.tob W (p W f))) (u W f j) (a0.eob W (p W f))) (\ W ->
    isProp-Pi (Hom W X) (\ f -> (i : PB.Lands W X q f) (j : IvP W) -> Id (W0.Ix (A.tob W (p W f))) (u W f j) (a0.eob W (p W f))) (\ f ->
    isProp-Pi (PB.Lands W X q f) (\ i -> (j : IvP W) -> Id (W0.Ix (A.tob W (p W f))) (u W f j) (a0.eob W (p W f))) (\ i ->
    isProp-Pi (IvP W) (\ j -> Id (W0.Ix (A.tob W (p W f))) (u W f j) (a0.eob W (p W f))) (\ j ->
      W0.isSetIx (A.tob W (p W f)) (u W f j) (a0.eob W (p W f)))))) ;

  constV (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W)) (u : W0.Ix (valV X p)) (q : PB.Phi X) : W0.V =
    EP.codeOf (ConstC X p u q) (EP.encProp (ConstC X p u q) (constC-prop X p u q)) ;

  codeY (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W))
    (pn : (V W : Ob) (g : Hom V W) (f : Hom W X) -> Id (W0.Ix (G.ob V)) (G.act V W g (p W f)) (p V (compH V W X f g))) : W0.V =
    W0.SigV (pathV X p pn) (\ w -> W0.SigV (PB.CId[l].phiV X) (\ q -> constV X p w.1 q)) ;

  -- the point family of x
  pt (X : Ob) (x : W0.Ix (G.ob X)) (W : Ob) (f : Hom W X) : W0.Ix (G.ob W) = G.act W X f x ;
  ptn (X : Ob) (x : W0.Ix (G.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X)
    : Id (W0.Ix (G.ob V)) (G.act V W g (pt X x W f)) (pt X x V (compH V W X f g)) = symH (G.act-o V W X f g x) ;

  tob (X : Ob) (x : W0.Ix (G.ob X)) : W0.V = codeY X (pt X x) (ptn X x) ;

  ----------------------------------------------------------------------
  -- (2) readings in the total space; equality of elements

  rd (X : Ob) (x : W0.Ix (G.ob X)) (w : W0.Ix (tob X x)) (W : Ob) (f : Hom W X) (j : IvP W) : TA.EI W =
    TA.pr W (pt X x W f) (w.1.1 W f j) ;

  endC-prop (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W)) (c : PEl[G, A]) (e : PB.IPt) (u : W0.Ix (valV X p))
    : isProp (W0.Ix (endV X p c e u)) =
    isProp-Pi Ob (\ W -> W0.Ix (CL.piH W X (\ f -> W0.IdV (A.tob W (p W f)) (u W f (PB.ptH W e)) (c.eob W (p W f))))) (\ W ->
    isProp-Pi (Hom W X) (\ f -> Id (W0.Ix (A.tob W (p W f))) (u W f (PB.ptH W e)) (c.eob W (p W f))) (\ f ->
      W0.isSetIx (A.tob W (p W f)) (u W f (PB.ptH W e)) (c.eob W (p W f)))) ;

  natC-prop (X : Ob) (p : (W : Ob) -> Hom W X -> W0.Ix (G.ob W))
    (pn : (V W : Ob) (g : Hom V W) (f : Hom W X) -> Id (W0.Ix (G.ob V)) (G.act V W g (p W f)) (p V (compH V W X f g)))
    (u : W0.Ix (valV X p)) : isProp (W0.Ix (W0.SigV (natV X p pn u) (\ z -> W0.SigV (endV X p a0 e0 u) (\ z' -> endV X p b0 e1 u)))) =
    isProp-Sigma (W0.Ix (natV X p pn u)) (\ z -> W0.Ix (W0.SigV (endV X p a0 e0 u) (\ z' -> endV X p b0 e1 u)))
      (isProp-Pi Ob (\ V -> W0.Ix (CL.piO (\ W -> CL.piH V W (\ g -> CL.piH W X (\ f -> CL.piI W (\ j ->
          W0.IdV (A.tob V (p V (compH V W X f g))) (A.tact V W g (p W f) (p V (compH V W X f g)) (pn V W g f) (u W f j))
            (u V (compH V W X f g) (ivA V W g j)))))))) (\ V ->
       isProp-Pi Ob (\ W -> W0.Ix (CL.piH V W (\ g -> CL.piH W X (\ f -> CL.piI W (\ j ->
          W0.IdV (A.tob V (p V (compH V W X f g))) (A.tact V W g (p W f) (p V (compH V W X f g)) (pn V W g f) (u W f j))
            (u V (compH V W X f g) (ivA V W g j))))))) (\ W ->
       isProp-Pi (Hom V W) (\ g -> W0.Ix (CL.piH W X (\ f -> CL.piI W (\ j ->
          W0.IdV (A.tob V (p V (compH V W X f g))) (A.tact V W g (p W f) (p V (compH V W X f g)) (pn V W g f) (u W f j))
            (u V (compH V W X f g) (ivA V W g j)))))) (\ g ->
       isProp-Pi (Hom W X) (\ f -> W0.Ix (CL.piI W (\ j ->
          W0.IdV (A.tob V (p V (compH V W X f g))) (A.tact V W g (p W f) (p V (compH V W X f g)) (pn V W g f) (u W f j))
            (u V (compH V W X f g) (ivA V W g j))))) (\ f ->
       isProp-Pi (IvP W) (\ j -> Id (W0.Ix (A.tob V (p V (compH V W X f g))))
            (A.tact V W g (p W f) (p V (compH V W X f g)) (pn V W g f) (u W f j)) (u V (compH V W X f g) (ivA V W g j))) (\ j ->
         W0.isSetIx (A.tob V (p V (compH V W X f g)))
            (A.tact V W g (p W f) (p V (compH V W X f g)) (pn V W g f) (u W f j)) (u V (compH V W X f g) (ivA V W g j))))))))
      (\ z -> isProp-Sigma (W0.Ix (endV X p a0 e0 u)) (\ z' -> W0.Ix (endV X p b0 e1 u))
         (endC-prop X p a0 e0 u) (\ z' -> endC-prop X p b0 e1 u)) ;
  -- the readings are natural
  rd-nat (X : Ob) (x : W0.Ix (G.ob X)) (w : W0.Ix (tob X x)) (V W : Ob) (g : Hom V W) (f : Hom W X) (j : IvP W)
    : Id (TA.EI V) (TA.E.act V W g (rd X x w W f j)) (rd X x w V (compH V W X f g) (ivA V W g j)) =
    transH (TA.pr-tact V W g (pt X x W f) (pt X x V (compH V W X f g)) (ptn X x V W g f) (w.1.1 W f j))
      (apH (TA.pr V (pt X x V (compH V W X f g))) (w.1.2.1 V W g f j)) ;

  -- two elements with the same readings and the same sieve are equal
  idY-eq (X : Ob) (x : W0.Ix (G.ob X)) (w w' : W0.Ix (tob X x))
    (q : (W : Ob) (f : Hom W X) (j : IvP W) -> Id (TA.EI W) (rd X x w W f j) (rd X x w' W f j))
    (Q : Id (PB.Phi X) w.2.1 w'.2.1) : Id (W0.Ix (tob X x)) w w' =
    idJ (W0.Ix (pathV X (pt X x) (ptn X x))) w.1
      (\ u2 P2 -> (r2 : W0.Ix (W0.SigV (PB.CId[l].phiV X) (\ q2 -> constV X (pt X x) u2.1 q2))) -> Id (PB.Phi X) w.2.1 r2.1
         -> Id (W0.Ix (tob X x)) w (u2, r2))
      (\ r2 Q2 -> apH {W0.Ix (W0.SigV (PB.CId[l].phiV X) (\ q2 -> constV X (pt X x) w.1.1 q2))} {W0.Ix (tob X x)} (\ r -> (w.1, r))
         (Sigma-eq (PB.Phi X) (\ q2 -> ConstC X (pt X x) w.1.1 q2) w.2.1 r2.1 w.2.2 r2.2 Q2 (constC-prop X (pt X x) w.1.1 r2.1)))
      w'.1 pathEq w'.2 Q
   where {
    uEq : Id (W0.Ix (valV X (pt X x))) w.1.1 w'.1.1 =
      funext Ob (\ W -> (f : Hom W X) (j : IvP W) -> W0.Ix (A.tob W (pt X x W f))) w.1.1 w'.1.1 (\ W ->
        funext (Hom W X) (\ f -> (j : IvP W) -> W0.Ix (A.tob W (pt X x W f))) (w.1.1 W) (w'.1.1 W) (\ f ->
          funext (IvP W) (\ j -> W0.Ix (A.tob W (pt X x W f))) (w.1.1 W f) (w'.1.1 W f) (\ j ->
            TA.pr-inj W (pt X x W f) (w.1.1 W f j) (w'.1.1 W f j) (q W f j)))) ;
    pathEq : Id (W0.Ix (pathV X (pt X x) (ptn X x))) w.1 w'.1 =
      Sigma-path (W0.Ix (valV X (pt X x)))
        (\ u -> W0.Ix (W0.SigV (natV X (pt X x) (ptn X x) u) (\ z -> W0.SigV (endV X (pt X x) a0 e0 u) (\ z' -> endV X (pt X x) b0 e1 u))))
        w.1.1 w'.1.1 w.1.2 w'.1.2 uEq (natC-prop X (pt X x) (ptn X x) w'.1.1 _ w'.1.2) ;
   } ;

  ----------------------------------------------------------------------
  -- (3) restriction

  module Tact (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
    (w : W0.Ix (tob I x)) {
    pi (W : Ob) (f : Hom W J) : Id (W0.Ix (G.ob W)) (pt I x W (compH W J I h f)) (pt J y W f) =
      transH (G.act-o W J I h f x) (apH (G.act W J f) e) ;

    uY (W : Ob) (f : Hom W J) (j : IvP W) : W0.Ix (A.tob W (pt J y W f)) =
      TA.coeT W (pt I x W (compH W J I h f)) (pt J y W f) (pi W f) (w.1.1 W (compH W J I h f) j) ;

    -- its readings are those of w at h f
    rdc (W : Ob) (f : Hom W J) (j : IvP W) : Id (TA.EI W) (TA.pr W (pt J y W f) (uY W f j)) (rd I x w W (compH W J I h f) j) =
      symH (TA.pr-coe W (pt I x W (compH W J I h f)) (pt J y W f) (pi W f) (w.1.1 W (compH W J I h f) j)) ;

    natY (V W : Ob) (g : Hom V W) (f : Hom W J) (j : IvP W)
      : Id (W0.Ix (A.tob V (pt J y V (compH V W J f g))))
           (A.tact V W g (pt J y W f) (pt J y V (compH V W J f g)) (ptn J y V W g f) (uY W f j))
           (uY V (compH V W J f g) (ivA V W g j)) =
      TA.pr-inj V (pt J y V (compH V W J f g))
        (A.tact V W g (pt J y W f) (pt J y V (compH V W J f g)) (ptn J y V W g f) (uY W f j))
        (uY V (compH V W J f g) (ivA V W g j))
        (calc (TA.EI V) {
            TA.pr V (pt J y V (compH V W J f g)) (A.tact V W g (pt J y W f) (pt J y V (compH V W J f g)) (ptn J y V W g f) (uY W f j))
          =< symH (TA.pr-tact V W g (pt J y W f) (pt J y V (compH V W J f g)) (ptn J y V W g f) (uY W f j)) >
            TA.E.act V W g (TA.pr W (pt J y W f) (uY W f j))
          =< apH (TA.E.act V W g) (rdc W f j) >
            TA.E.act V W g (rd I x w W (compH W J I h f) j)
          =< TA.pr-tact V W g (pt I x W (compH W J I h f)) (pt I x V (compH V W I (compH W J I h f) g)) (ptn I x V W g (compH W J I h f))
               (w.1.1 W (compH W J I h f) j) >
            TA.pr V (pt I x V (compH V W I (compH W J I h f) g))
              (A.tact V W g (pt I x W (compH W J I h f)) (pt I x V (compH V W I (compH W J I h f) g)) (ptn I x V W g (compH W J I h f))
                 (w.1.1 W (compH W J I h f) j))
          =< apH (TA.pr V (pt I x V (compH V W I (compH W J I h f) g))) (w.1.2.1 V W g (compH W J I h f) j) >
            rd I x w V (compH V W I (compH W J I h f) g) (ivA V W g j)
          =< apH (\ k -> rd I x w V k (ivA V W g j)) (comp-assoc V W J I h f g) >
            rd I x w V (compH V J I h (compH V W J f g)) (ivA V W g j)
          =< symH (rdc V (compH V W J f g) (ivA V W g j)) >
            TA.pr V (pt J y V (compH V W J f g)) (uY V (compH V W J f g) (ivA V W g j)) }) ;

    -- a condition u W f j = c (x f), moved
    mv (c : PEl[G, A]) (W : Ob) (f : Hom W J) (j : IvP W)
      (E : Id (W0.Ix (A.tob W (pt I x W (compH W J I h f)))) (w.1.1 W (compH W J I h f) j) (c.eob W (pt I x W (compH W J I h f))))
      : Id (W0.Ix (A.tob W (pt J y W f))) (uY W f j) (c.eob W (pt J y W f)) =
      TA.pr-inj W (pt J y W f) (uY W f j) (c.eob W (pt J y W f))
        (transH (rdc W f j)
          (transH (apH (TA.pr W (pt I x W (compH W J I h f))) E)
            (apH (\ y1 -> TA.pr W y1 (c.eob W y1)) (pi W f)))) ;

    res : W0.Ix (tob J y) =
      ((uY,
        (natY,
         (\ W f -> mv a0 W f (PB.ptH W e0) (w.1.2.2.1 W (compH W J I h f)),
          \ W f -> mv b0 W f (PB.ptH W e1) (w.1.2.2.2 W (compH W J I h f))))),
       (PB.pre J I h w.2.1,
        \ W f i j -> mv a0 W f j (w.2.2 W (compH W J I h f) (PB.lands-pre W J I h w.2.1 f i) j))) ;
  } ;

  tactY : TactTy G tob = \ J I h x y e w -> Tact[J, I, h, x, y, e, w].res ;

  tactY-id : IdLaw G tob tactY = \ I x e w ->
    idY-eq I x (tactY I I (idH I) x x e w) w
      (\ W f j -> transH (Tact[I, I, idH I, x, x, e, w].rdc W f j) (apH (\ k -> rd I x w W k j) (comp-idl W I f)))
      (PB.pre-id I w.2.1) ;

  tactY-o : OLaw G tob tactY = \ K' J I f g x y z e1' e2 e3 w ->
    idY-eq K' z (tactY K' I (compH K' J I f g) x z e3 w) (tactY K' J g y z e2 (tactY J I f x y e1' w))
      (\ W f'' j -> transH (Tact[K', I, compH K' J I f g, x, z, e3, w].rdc W f'' j)
         (transH (apH (\ k -> rd I x w W k j) (comp-assoc W K' J I f g f''))
           (symH (transH (Tact[K', J, g, y, z, e2, tactY J I f x y e1' w].rdc W f'' j)
                    (Tact[J, I, f, x, y, e1', w].rdc W (compH W K' J g f'') j)))))
      (symH (PB.pre-comp K' J I g f w.2.1)) ;

  IdYT : PTy[G] = mkTy G tob tactY tactY-id tactY-o ;
  module TY = GPR.TyL[G, IdYT] ;

  -- an element of the total space is determined by its point, its readings
  -- and its sieve
  tpY-ext (W : Ob) (z z' : TY.EI W) (P : Id (W0.Ix (G.ob W)) (TY.pr1 W z) (TY.pr1 W z'))
    (q : (V : Ob) (g : Hom V W) (j : IvP V) -> Id (TA.EI V) (rd W (TY.pr1 W z) (TY.pr2 W z) V g j) (rd W (TY.pr1 W z') (TY.pr2 W z') V g j))
    (Q : Id (PB.Phi W) (TY.pr2 W z).2.1 (TY.pr2 W z').2.1) : Id (TY.EI W) z z' =
    idJ (W0.Ix (G.ob W)) (TY.pr1 W z)
      (\ y2 P2 -> (w2 : W0.Ix (tob W y2)) -> ((V : Ob) (g : Hom V W) (j : IvP V) -> Id (TA.EI V) (rd W (TY.pr1 W z) (TY.pr2 W z) V g j) (rd W y2 w2 V g j))
         -> Id (PB.Phi W) (TY.pr2 W z).2.1 w2.2.1 -> Id (TY.EI W) z (TY.pr W y2 w2))
      (\ w2 q2 Q2 -> apH {W0.Ix (tob W (TY.pr1 W z))} {TY.EI W} (\ w -> TY.pr W (TY.pr1 W z) w) (idY-eq W (TY.pr1 W z) (TY.pr2 W z) w2 q2 Q2))
      (TY.pr1 W z') P (TY.pr2 W z') q Q ;

  ----------------------------------------------------------------------
  -- (4) the iso with core's Id (CIdFib.IdFib): the identity on points, a
  -- path goes to its readings.  Fibrancy moves along it.

  module PF = PB.CPathFib[l].PathFib[G, A, a0, b0] ;
  module IO = PB.CId[l].IdOver[G, G, A, PF.s, PF.sN, PF.PE.aE, PF.PE.bE, PF.PE.aE-act, PF.PE.bE-act] ;
  module TI = IO.TI ;

  toC (X : Ob) (x : W0.Ix (G.ob X)) (w : W0.Ix (tob X x)) : W0.Ix (IO.tobI X x) =
    (((\ W f j -> rd X x w W f j,
       rd-nat X x w),
      (\ W f j -> refl (G.act W X f x),
       (transH (apH (TA.pr X (pt X x X (idH X))) (w.1.2.2.1 X (idH X))) (apH (PF.PE.aE X) (G.act-id X x)),
        transH (apH (TA.pr X (pt X x X (idH X))) (w.1.2.2.2 X (idH X))) (apH (PF.PE.bE X) (G.act-id X x))))),
     (w.2.1, \ W f i j -> apH (TA.pr W (pt X x W f)) (w.2.2 W f i j))) ;

  module FromC (X : Ob) (x : W0.Ix (G.ob X)) (v : W0.Ix (IO.tobI X x)) {
    L (W : Ob) (f : Hom W X) (j : IvP W) : TA.EI W = v.1.1.1 W f j ;

    uC (W : Ob) (f : Hom W X) (j : IvP W) : W0.Ix (A.tob W (pt X x W f)) = TA.fromE W (pt X x W f) (L W f j) (v.1.2.1 W f j) ;

    uC-E (W : Ob) (f : Hom W X) (j : IvP W) : Id (TA.EI W) (TA.pr W (pt X x W f) (uC W f j)) (L W f j) =
      TA.fromE-eq W (pt X x W f) (L W f j) (v.1.2.1 W f j) ;

    -- a condition L W f j = cE (x f), read as one on the values
    atE (c : PEl[G, A]) (W : Ob) (f : Hom W X) (j : IvP W) (E : Id (TA.EI W) (L W f j) (TA.pr W (pt X x W f) (c.eob W (pt X x W f))))
      : Id (W0.Ix (A.tob W (pt X x W f))) (uC W f j) (c.eob W (pt X x W f)) =
      TA.pr-inj W (pt X x W f) (uC W f j) (c.eob W (pt X x W f)) (transH (uC-E W f j) E) ;

    natC (V W : Ob) (g : Hom V W) (f : Hom W X) (j : IvP W)
      : Id (W0.Ix (A.tob V (pt X x V (compH V W X f g))))
           (A.tact V W g (pt X x W f) (pt X x V (compH V W X f g)) (ptn X x V W g f) (uC W f j))
           (uC V (compH V W X f g) (ivA V W g j)) =
      TA.pr-inj V (pt X x V (compH V W X f g))
        (A.tact V W g (pt X x W f) (pt X x V (compH V W X f g)) (ptn X x V W g f) (uC W f j))
        (uC V (compH V W X f g) (ivA V W g j))
        (transH (symH (TA.pr-tact V W g (pt X x W f) (pt X x V (compH V W X f g)) (ptn X x V W g f) (uC W f j)))
          (transH (apH (TA.E.act V W g) (uC-E W f j))
            (transH (v.1.1.2 V W g f j) (symH (uC-E V (compH V W X f g) (ivA V W g j)))))) ;

    res : W0.Ix (tob X x) =
      ((uC,
        (natC,
         (\ W f -> atE a0 W f (PB.ptH W e0) (IO.PT.end0g X x v.1 W f),
          \ W f -> atE b0 W f (PB.ptH W e1) (IO.PT.end1g X x v.1 W f)))),
       (v.2.1, \ W f i j -> atE a0 W f j (v.2.2 W f i j))) ;
  } ;

  ta (W : Ob) (v : TY.EI W) : TI.EI W = TI.pr W (TY.pr1 W v) (toC W (TY.pr1 W v) (TY.pr2 W v)) ;

  tanat (V W : Ob) (g : Hom V W) (v : TY.EI W) : Id (TI.EI V) (TI.E.act V W g (ta W v)) (ta V (TY.E.act V W g v)) =
    IO.tpI-ext V (TI.E.act V W g (ta W v)) (ta V (TY.E.act V W g v)) (refl (G.act V W g (TY.pr1 W v)))
      (\ V' g' j -> symH (Tact[V, W, g, TY.pr1 W v, G.act V W g (TY.pr1 W v), refl (G.act V W g (TY.pr1 W v)), TY.pr2 W v].rdc V' g' j))
      (refl (PB.pre V W g (TY.pr2 W v).2.1)) ;

  tainj (W : Ob) (v v' : TY.EI W) (P : Id (W0.Ix (G.ob W)) (TY.pr1 W v) (TY.pr1 W v')) (Q : Id (TI.EI W) (ta W v) (ta W v')) : Id (TY.EI W) v v' =
    tpY-ext W v v' P (\ V g j -> apH (\ z -> (TI.pr2 W z).1.1.1 V g j) Q) (apH (\ z -> (TI.pr2 W z).2.1) Q) ;

  bk (X : Ob) (x : W0.Ix (G.ob X)) (u : W0.Ix (IO.tobI X x)) : W0.Ix (tob X x) = FromC[X, x, u].res ;

  bkta (X : Ob) (x : W0.Ix (G.ob X)) (u : W0.Ix (IO.tobI X x)) : Id (TI.EI X) (ta X (TY.pr X x (bk X x u))) (TI.pr X x u) =
    IO.tpI-ext X (ta X (TY.pr X x (bk X x u))) (TI.pr X x u) (refl x) (\ V g j -> FromC[X, x, u].uC-E V g j) (refl u.2.1) ;

  opaque tainj ; opaque bkta ;

  module C = PB.CCart[l, l].Cart[G, IdYT, G, IO.IdT, \ W x -> x, \ V W g x -> refl (G.act V W g x), ta, \ W v -> refl (TY.pr1 W v),
    tanat, tainj, bk, bkta] ;

  -- Id(a , b) is fibrant
  fib (fA : CL.Lines[G, A].Fib) : CL.Lines[G, IdYT].Fib = C.moveFib (PB.CIdFib[l].IdFib[G, A, a0, b0].fib fA GPosId[l].dc) ;
} ;

------------------------------------------------------------------------
-- (5) Id(a , b)[s] = Id(a[s] , b[s]) as types

module IdYNat (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (a0 b0 : PEl[G, A]) {
  module YG = IdY[G, A, a0, b0] ;
  module YD = IdY[D, subTy D G A s, subEl D G A a0 s, subEl D G A b0 s] ;
  module TA = YG.TA ;

  -- point data over D, and the codes as a function of them
  PD : U l+ = (I : Ob) (x : W0.Ix (D.ob I)) (W : Ob) -> Hom W I -> W0.Ix (G.ob W) ;
  PDN (rho : PD) : U l+ = (I : Ob) (x : W0.Ix (D.ob I)) (V W : Ob) (g : Hom V W) (f : Hom W I)
    -> Id (W0.Ix (G.ob V)) (G.act V W g (rho I x W f)) (rho I x V (compH V W I f g)) ;
  PS : U l+ = (rho : PD) * PDN rho ;

  ob (z : PS) : TOb D = \ I x -> YG.codeY I (z.1 I x) (z.2 I x) ;

  -- the substituted type, and the type of the substituted data
  z1 : PS = (\ I x W f -> G.act W I f (s.nt I x), \ I x -> YG.ptn I (s.nt I x)) ;
  z2 : PS = (\ I x W f -> s.nt W (D.act W I f x),
             \ I x V W g f -> ntEq D G s V W g (D.act W I f x) (D.act V I (compH V W I f g) x) (YD.ptn I x V W g f)) ;

  ob1 : Id (TOb D) (subTy D G YG.IdYT s).tob (ob z1) = refl (ob z1) ;
  ob2 : Id (TOb D) YD.IdYT.tob (ob z2) = refl (ob z2) ;

  -- the two point data are equal (s is natural; the naturality proofs
  -- form a proposition)
  isProp-PDN (rho : PD) : isProp (PDN rho) =
    isProp-Pi Ob (\ I -> (x : W0.Ix (D.ob I)) (V W : Ob) (g : Hom V W) (f : Hom W I) -> Id (W0.Ix (G.ob V)) (G.act V W g (rho I x W f)) (rho I x V (compH V W I f g))) (\ I ->
    isProp-Pi (W0.Ix (D.ob I)) (\ x -> (V W : Ob) (g : Hom V W) (f : Hom W I) -> Id (W0.Ix (G.ob V)) (G.act V W g (rho I x W f)) (rho I x V (compH V W I f g))) (\ x ->
    isProp-Pi Ob (\ V -> (W : Ob) (g : Hom V W) (f : Hom W I) -> Id (W0.Ix (G.ob V)) (G.act V W g (rho I x W f)) (rho I x V (compH V W I f g))) (\ V ->
    isProp-Pi Ob (\ W -> (g : Hom V W) (f : Hom W I) -> Id (W0.Ix (G.ob V)) (G.act V W g (rho I x W f)) (rho I x V (compH V W I f g))) (\ W ->
    isProp-Pi (Hom V W) (\ g -> (f : Hom W I) -> Id (W0.Ix (G.ob V)) (G.act V W g (rho I x W f)) (rho I x V (compH V W I f g))) (\ g ->
    isProp-Pi (Hom W I) (\ f -> Id (W0.Ix (G.ob V)) (G.act V W g (rho I x W f)) (rho I x V (compH V W I f g))) (\ f ->
      W0.isSetIx (G.ob V) (G.act V W g (rho I x W f)) (rho I x V (compH V W I f g)))))))) ;

  rhoEq : Id PD z1.1 z2.1 =
    funext Ob (\ I -> (x : W0.Ix (D.ob I)) (W : Ob) -> Hom W I -> W0.Ix (G.ob W)) z1.1 z2.1 (\ I ->
      funext (W0.Ix (D.ob I)) (\ x -> (W : Ob) -> Hom W I -> W0.Ix (G.ob W)) (z1.1 I) (z2.1 I) (\ x ->
        funext Ob (\ W -> Hom W I -> W0.Ix (G.ob W)) (z1.1 I x) (z2.1 I x) (\ W ->
          funext (Hom W I) (\ f -> W0.Ix (G.ob W)) (z1.1 I x W) (z2.1 I x W) (\ f -> symH (s.nt-nat W I f x))))) ;

  Z : Id PS z1 z2 = Sigma-path PD PDN z1.1 z2.1 z1.2 z2.2 rhoEq (isProp-PDN z2.1 _ z2.2) ;

  P : Id (TOb D) (ob z1) (ob z2) = ap PS (TOb D) ob z1 z2 Z ;

  -- transport along P keeps the readings and the sieve
  rdS (J : Ob) (y : W0.Ix (D.ob J)) (w : W0.Ix (ob z1 J y)) (z' : PS) (Z' : Id PS z1 z')
    : (V : Ob) (g : Hom V J) (j : IvP V)
      -> Id (TA.EI V) (TA.pr V (z'.1 J y V g) ((subst (TOb D) (\ o -> W0.Ix (o J y)) (ob z1) (ob z') (ap PS (TOb D) ob z1 z' Z') w).1.1 V g j))
                      (TA.pr V (z1.1 J y V g) (w.1.1 V g j)) =
    idJ PS z1
      (\ z2' Z2 -> (V : Ob) (g : Hom V J) (j : IvP V)
         -> Id (TA.EI V) (TA.pr V (z2'.1 J y V g) ((subst (TOb D) (\ o -> W0.Ix (o J y)) (ob z1) (ob z2') (ap PS (TOb D) ob z1 z2' Z2) w).1.1 V g j))
                         (TA.pr V (z1.1 J y V g) (w.1.1 V g j)))
      (\ V g j -> refl (TA.pr V (z1.1 J y V g) (w.1.1 V g j))) z' Z' ;

  sqS (J : Ob) (y : W0.Ix (D.ob J)) (w : W0.Ix (ob z1 J y)) (z' : PS) (Z' : Id PS z1 z')
    : Id (PB.Phi J) (subst (TOb D) (\ o -> W0.Ix (o J y)) (ob z1) (ob z') (ap PS (TOb D) ob z1 z' Z') w).2.1 w.2.1 =
    idJ PS z1
      (\ z2' Z2 -> Id (PB.Phi J) (subst (TOb D) (\ o -> W0.Ix (o J y)) (ob z1) (ob z2') (ap PS (TOb D) ob z1 z2' Z2) w).2.1 w.2.1)
      (refl w.2.1) z' Z' ;

  module SEA = PB.CSub[l].SubE[D, G, s, A] ;

  -- the same, stated at the two types (the codes are compared once, here)
  P' : Id (TOb D) (subTy D G YG.IdYT s).tob YD.IdYT.tob = P ;

  tr (J : Ob) (y : W0.Ix (D.ob J)) (w : W0.Ix (YG.tob J (s.nt J y))) : W0.Ix (YD.tob J y) =
    subst (TOb D) (\ o -> W0.Ix (o J y)) (subTy D G YG.IdYT s).tob YD.IdYT.tob P' w ;

  tr-rd (J : Ob) (y : W0.Ix (D.ob J)) (w : W0.Ix (YG.tob J (s.nt J y))) (V : Ob) (g : Hom V J) (j : IvP V)
    : Id (TA.EI V) (SEA.mV V (YD.rd J y (tr J y w) V g j)) (YG.rd J (s.nt J y) w V g j) =
    rdS J y w z2 Z V g j ;

  tr-sq (J : Ob) (y : W0.Ix (D.ob J)) (w : W0.Ix (YG.tob J (s.nt J y))) : Id (PB.Phi J) (tr J y w).2.1 w.2.1 =
    sqS J y w z2 Z ;

  -- transport back, fibre by fibre: readings and sieve
  rdV (J : Ob) (y : W0.Ix (D.ob J)) (z z' : PS) (Z' : Id PS z z') (w : W0.Ix (ob z J y))
    : (V : Ob) (g : Hom V J) (j : IvP V)
      -> Id (TA.EI V) (TA.pr V (z'.1 J y V g) ((subst W0.V (\ c -> W0.Ix c) (ob z J y) (ob z' J y) (ap PS W0.V (\ u -> ob u J y) z z' Z') w).1.1 V g j))
                      (TA.pr V (z.1 J y V g) (w.1.1 V g j)) =
    idJ PS z
      (\ z3 Z3 -> (V : Ob) (g : Hom V J) (j : IvP V)
         -> Id (TA.EI V) (TA.pr V (z3.1 J y V g) ((subst W0.V (\ c -> W0.Ix c) (ob z J y) (ob z3 J y) (ap PS W0.V (\ u -> ob u J y) z z3 Z3) w).1.1 V g j))
                         (TA.pr V (z.1 J y V g) (w.1.1 V g j)))
      (\ V g j -> refl (TA.pr V (z.1 J y V g) (w.1.1 V g j))) z' Z' ;

  sqV (J : Ob) (y : W0.Ix (D.ob J)) (z z' : PS) (Z' : Id PS z z') (w : W0.Ix (ob z J y))
    : Id (PB.Phi J) (subst W0.V (\ c -> W0.Ix c) (ob z J y) (ob z' J y) (ap PS W0.V (\ u -> ob u J y) z z' Z') w).2.1 w.2.1 =
    idJ PS z
      (\ z3 Z3 -> Id (PB.Phi J) (subst W0.V (\ c -> W0.Ix c) (ob z J y) (ob z3 J y) (ap PS W0.V (\ u -> ob u J y) z z3 Z3) w).2.1 w.2.1)
      (refl w.2.1) z' Z' ;

  Q0 (J : Ob) (y : W0.Ix (D.ob J)) : Id W0.V (YD.tob J y) (YG.tob J (s.nt J y)) = ap PS W0.V (\ u -> ob u J y) z2 z1 (sym PS z1 z2 Z) ;

  bk-rd (J : Ob) (y : W0.Ix (D.ob J)) (w : W0.Ix (YD.tob J y)) (V : Ob) (g : Hom V J) (j : IvP V)
    : Id (TA.EI V) (YG.rd J (s.nt J y) (subst W0.V (\ c -> W0.Ix c) (YD.tob J y) (YG.tob J (s.nt J y)) (Q0 J y) w) V g j)
                   (SEA.mV V (YD.rd J y w V g j)) =
    rdV J y z2 z1 (sym PS z1 z2 Z) w V g j ;

  bk-sq (J : Ob) (y : W0.Ix (D.ob J)) (w : W0.Ix (YD.tob J y))
    : Id (PB.Phi J) (subst W0.V (\ c -> W0.Ix c) (YD.tob J y) (YG.tob J (s.nt J y)) (Q0 J y) w).2.1 w.2.1 =
    sqV J y z2 z1 (sym PS z1 z2 Z) w ;

  -- the restrictions agree after the transport
  module Pt (J I : Ob) (f : Hom J I) (x : W0.Ix (D.ob I)) (y : W0.Ix (D.ob J)) (e : Id (W0.Ix (D.ob J)) (D.act J I f x) y)
    (w : W0.Ix (YG.tob I (s.nt I x))) {
    e' : Id (W0.Ix (G.ob J)) (G.act J I f (s.nt I x)) (s.nt J y) = ntEq D G s J I f x y e ;
    w1 : W0.Ix (YG.tob J (s.nt J y)) = YG.tactY J I f (s.nt I x) (s.nt J y) e' w ;
    lhs : W0.Ix (YD.tob J y) = tr J y w1 ;
    rhs : W0.Ix (YD.tob J y) = YD.tactY J I f x y e (tr I x w) ;

    geq (V : Ob) (g : Hom V J) (j : IvP V) : Id (TA.EI V) (SEA.mV V (YD.rd J y lhs V g j)) (SEA.mV V (YD.rd J y rhs V g j)) =
      calc (TA.EI V) {
          SEA.mV V (YD.rd J y lhs V g j)
        =< tr-rd J y w1 V g j >
          YG.rd J (s.nt J y) w1 V g j
        =< YG.Tact[J, I, f, s.nt I x, s.nt J y, e', w].rdc V g j >
          YG.rd I (s.nt I x) w V (compH V J I f g) j
        =< symH (tr-rd I x w V (compH V J I f g) j) >
          SEA.mV V (YD.rd I x (tr I x w) V (compH V J I f g) j)
        =< symH (apH (SEA.mV V) (YD.Tact[J, I, f, x, y, e, tr I x w].rdc V g j)) >
          SEA.mV V (YD.rd J y rhs V g j) } ;

    eq : Id (W0.Ix (YD.tob J y)) lhs rhs =
      YD.idY-eq J y lhs rhs
        (\ V g j -> SEA.mV-inj V (YD.rd J y lhs V g j) (YD.rd J y rhs V g j) (refl (D.act V J g y)) (geq V g j))
        (transH (tr-sq J y w1) (apH (PB.pre J I f) (symH (tr-sq I x w)))) ;
  } ;

  nat : Id (PTy[D]) (subTy D G YG.IdYT s) YD.IdYT =
    ty-ext2 D (subTy D G YG.IdYT s) YD.IdYT P' (\ J I f x y e w -> Pt[J, I, f, x, y, e, w].eq) ;
} ;
