-- CwFQuotEq.seg (canonicity-c2; SIMPLIFIED.md item 3): related elements
-- have equal classes in the Voevodsky quotient (CwFQuot), from
-- propositional extensionality (a module parameter, CwFPropU.PropExtTy).
--
-- Informal text.  Let a , b be global elements of A.  Over G.A (variable
-- c) write relV a for the proposition r a c, an element mV a of PropU.
-- Hypothesis: maps both ways between relV a and relV b over G.A.
-- (1) Propositional extensionality joins the codes of mV a and mV b; the
--     second components are in a proposition (CwFPropProp), so mV a and
--     mV b are joined in PropU (CwFPropPair).
-- (2) By function extensionality r a and r b are joined in A -> PropU.
-- (3) These are the first components of the classes (fst-cls); the second
--     components are in a truncation, a proposition: the classes are
--     joined (CwFPropPair).
open Base ;

module QuotEq (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g))
  (tr : CwFTrunc.Trunc[l, C, PS, SS, IJ, Un].TruncAt)
  (pe : CwFPropU.PropU[l, C, PS, SS, IJ, Un].PropExtTy) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module QT = CwFQuot.Quot[l, C, PS, SS, IJ, Un, NF, tr] ;
  module PPr = CwFPropPair.PropPair[l, C, PS, SS, IJ, Un] ;
  module SVm = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module PPp = CwFPropProp.PropProp[l, C, PS, SS, IJ, Un, NF] ;

  -- an Id between transported elements, read before the transport
  idBack (G : Ctx) (X X' : Ty G) (P : Id (Ty G) X X') (x y : El G X)
    (u : El G (IJ.IdT G X' (trE G X X' P x) (trE G X X' P y))) : El G (IJ.IdT G X x y) =
    idJ (Ty G) X (\ Z PZ -> El G (IJ.IdT G Z (trE G X Z PZ x) (trE G X Z PZ y)) -> El G (IJ.IdT G X x y)) (\ v -> v) X' P u ;

  module E (G : Ctx) (A : Ty G) (r : El G (Fun G A (Fun G A (PU.PropU G)))) {
    module QQ = QT.Q[G, A, r] ;
    D : Ctx = ext G A ;
    W : Ty D = wkT G A (PU.PropU G) ;
    PW : Id (Ty D) W (PU.PropU D) = PU.PropU-ov D G (p G A) ;
    -- r a c, for c the variable: an element of PropU over G.A, and its type
    mV (a : El G A) : El D (PU.PropU D) = trE D W (PU.PropU D) PW (bod G A W (QQ.rAt a)) ;
    relV (a : El G A) : Ty D = PU.DecP D (mV a) ;

    -- relV a at a global element b is Rel a b
    module RelPt (a b : El G A) {
      sb : Sub G D = sec G A b ;
      PWx : Id (Ty G) (subT G D (PU.PropU D) sb) (PU.PropU G) = PU.PropU-ov G D sb ;
      Pw : Ov G D (PU.PropU D) sb (PU.PropU G) PWx (mV a) (QQ.relP a b) =
        IN.teAny G (subT G D (PU.PropU D) sb) (PU.PropU G) (subt G D (PU.PropU D) (mV a) sb) (QQ.relP a b)
          (IN.teT G (subT G D (PU.PropU D) sb) (subT G D W sb) (PU.PropU G)
             (subt G D (PU.PropU D) (mV a) sb) (subt G D W (bod G A W (QQ.rAt a)) sb) (QQ.relP a b)
             (SVm.teSub G D (PU.PropU D) W (mV a) (bod G A W (QQ.rAt a))
                (IN.teS D W (PU.PropU D) (bod G A W (QQ.rAt a)) (mV a) (IN.teTr D W (PU.PropU D) PW (bod G A W (QQ.rAt a)))) sb)
             (IN.teTr G (subT G D W sb) (PU.PropU G) (p-sec-T G A (PU.PropU G) b) (subt G D W (bod G A W (QQ.rAt a)) sb)))
          PWx ;
      cd : Ov G D (Un.Cod D) sb (Un.Cod G) (Un.Cod-nat G D sb) (PU.codeOf D (mV a)) (PU.codeOf G (QQ.relP a b)) =
        IN.fst-ov G D (Un.Cod D) (PU.PropFam D) sb (Un.Cod G) (Un.Cod-nat G D sb) (PU.PropFam G) (PU.PropFam-ov G D sb) PWx
          (mV a) (QQ.relP a b) Pw ;
      relV-pt : Id (Ty G) (subT G D (relV a) sb) (QQ.Rel a b) =
        trans (Ty G) (subT G D (relV a) sb) (Un.Dec G (PU.UU.DU.subU G D (PU.codeOf D (mV a)) sb)) (QQ.Rel a b)
          (Un.Dec-nat G D (PU.codeOf D (mV a)) sb)
          (ap (El G (Un.Cod G)) (Ty G) (\ c2 -> Un.Dec G c2) (PU.UU.DU.subU G D (PU.codeOf D (mV a)) sb) (PU.codeOf G (QQ.relP a b)) cd) ;
    } ;
    relV-pt (a b : El G A) : Id (Ty G) (subT G D (relV a) (sec G A b)) (QQ.Rel a b) = RelPt[a, b].relV-pt ;

    module Eq (a b : El G A)
      (f : El (ext D (relV a)) (wkT D (relV a) (relV b)))
      (g : El (ext D (relV b)) (wkT D (relV b) (relV a))) {
      KD : Ctx = ext D (Un.Cod D) ;
      ec : El D (IJ.IdT D (Un.Cod D) (PU.codeOf D (mV a)) (PU.codeOf D (mV b))) =
        pe D (PU.codeOf D (mV a)) (PU.codeOf D (mV b)) (PU.decProp D (mV a)) (PU.decProp D (mV b)) f g ;
      em : El D (IJ.IdT D (PU.PropU D) (mV a) (mV b)) =
        PPr.At[D, Un.Cod D, PU.PropFam D].pairPath (PPp.propProp KD (Un.Dec KD (PU.UU.qc D))) (mV a) (mV b) ec ;
      hD : El D (IJ.IdT D W (bod G A W (QQ.rAt a)) (bod G A W (QQ.rAt b))) =
        idBack D W (PU.PropU D) PW (bod G A W (QQ.rAt a)) (bod G A W (QQ.rAt b)) em ;
      e0 : El G (IJ.IdT G QQ.PA (QQ.rAt a) (QQ.rAt b)) =
        NF G A W (QQ.rAt a) (QQ.rAt b) (lam G A (IJ.IdT D W (bod G A W (QQ.rAt a)) (bod G A W (QQ.rAt b))) hD) ;
      e1 : El G (IJ.IdT G QQ.PA (IN.fst G QQ.PA QQ.TrS (QQ.clsG a)) (IN.fst G QQ.PA QQ.TrS (QQ.clsG b))) =
        QT.idTr G QQ.PA (QQ.rAt a) (IN.fst G QQ.PA QQ.TrS (QQ.clsG a)) (QQ.rAt b) (IN.fst G QQ.PA QQ.TrS (QQ.clsG b))
          (sym (El G QQ.PA) (IN.fst G QQ.PA QQ.TrS (QQ.clsG a)) (QQ.rAt a) (QQ.fst-cls a))
          (sym (El G QQ.PA) (IN.fst G QQ.PA QQ.TrS (QQ.clsG b)) (QQ.rAt b) (QQ.fst-cls b)) e0 ;
      cls-eq : El G (IJ.IdT G QQ.Qt (QQ.clsG a) (QQ.clsG b)) =
        PPr.At[G, QQ.PA, QQ.TrS].pairPath (tr.trProp QQ.K QQ.S) (QQ.clsG a) (QQ.clsG b) e1 ;
    } ;
    cls-eq (a b : El G A)
      (f : El (ext D (relV a)) (wkT D (relV a) (relV b)))
      (g : El (ext D (relV b)) (wkT D (relV b) (relV a)))
      : El G (IJ.IdT G QQ.Qt (QQ.clsG a) (QQ.clsG b)) = Eq[a, b, f, g].cls-eq ;
  } ;
} ;
