-- CCeId.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', over
-- Gamma = nil.Ec (the closed copy of yo(y).A): the point map into c2's
-- valuation context Dv (the hom alpha(d), the values psi(v)), and each
-- equation p of y.u as an element of c2's IdEv p at that point: CCeEq3's
-- homotopy read as an internal Id (CHtIdP), its type and endpoints moved by
-- rwId / idFwd, then IdT-nat and subT-o.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
CP : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
-- transports of internal Ids (poset forms of CRhoTel's readings, c2's idFwd / rwId)
trERd (G : CP.Ctx) (A A' : CP.Ty G) (P : Id (CP.Ty G) A A') (e : CP.El G A) (I : Ob) (x : V1.Ix (G.ob I))
 : Id (V1.Ix (A'.1.tob I x)) ((OV.trE G A A' P e).eob I x) (subst (CP.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A' P (e.eob I x)) =
 idJ (CP.Ty G) A (\ A2 P2 -> Id (V1.Ix (A2.1.tob I x)) ((OV.trE G A A2 P2 e).eob I x) (subst (CP.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A2 P2 (e.eob I x)))
  (refl (e.eob I x)) A' P ;
sameRd (G : CP.Ctx) (A A' : CP.Ty G) (P : Id (CP.Ty G) A A') (I : Ob) (x : V1.Ix (G.ob I)) (E2 : Id V1.V (A.1.tob I x) (A'.1.tob I x)) (v : V1.Ix (A.1.tob I x))
 : Id (V1.Ix (A'.1.tob I x)) (subst (CP.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A' P v) (subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A'.1.tob I x) E2 v) =
 transH (idJ (CP.Ty G) A (\ A2 P2 -> Id (V1.Ix (A2.1.tob I x)) (subst (CP.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A2 P2 v)
                                      (subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A2.1.tob I x) (apH {CP.Ty G} {V1.V} (\ T -> T.1.tob I x) P2) v))
         (refl v) A' P)
  (apH {Id V1.V (A.1.tob I x) (A'.1.tob I x)} {V1.Ix (A'.1.tob I x)} (\ q -> subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A'.1.tob I x) q v)
    (V1.isSetV (A.1.tob I x) (A'.1.tob I x) (apH {CP.Ty G} {V1.V} (\ T -> T.1.tob I x) P) E2)) ;
idFwd (G : CP.Ctx) (X X' : CP.Ty G) (P : Id (CP.Ty G) X X') (x y : CP.El G X) (u : CP.El G (IJ.IdT G X x y))
 : CP.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)) =
 idJ (CP.Ty G) X (\ Z PZ -> CP.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y))) u X' P ;
rwId (G : CP.Ctx) (T : CP.Ty G) (x x' y y' : CP.El G T)
 (px : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (x.eob K w) (x'.eob K w))
 (py : (K : Ob) (w : V1.Ix (G.ob K)) -> Id (V1.Ix (T.1.tob K w)) (y.eob K w) (y'.eob K w))
 (p : CP.El G (IJ.IdT G T x y)) : CP.El G (IJ.IdT G T x' y') =
 subst (CP.El G T) (\ u -> CP.El G (IJ.IdT G T x' u)) y y' (L.el-ext G T.1 y y' py)
  (subst (CP.El G T) (\ u -> CP.El G (IJ.IdT G T u y)) x x' (L.el-ext G T.1 x x' px) p) ;

module CI (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module E3 = CCeEq3[a].E3[R, encK, pe, y, u, y'] ;
 module TU = E3.TU ;
 module CV = TU.CV ;
 module S1 = TU.S1 ;
 module S2 = TU.S2 ;
 module UP0 = E3.UP ;
 module HO = TU.HO ;
 C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
 Nl : C.Ctx = C.nil ;
 Ec : L.PTy[Nl] = TU.Ec ;
 K : C.Ctx = L.extP Nl Ec ;
 -- the point map into Dv
 ptT (I : Ob) : (o : Top) (w : V1.Ix (Ec.tob I o)) -> V1.Ix (S1.Dv.ob I) = split { tt -> \ w -> ((tt, CV.CB.hN.nfun I tt w), CV.vN.nfun I tt w) } ;
 pairD (J : Ob) (h1 h2 : V1.Ix (S1.HXY.1.tob J tt)) (ph : Id (V1.Ix (S1.HXY.1.tob J tt)) h1 h2) (v1 v2 : S1.PK u.1 J) (pv : Id (S1.PK u.1 J) v1 v2)
  : Id (V1.Ix (S1.Dv.ob J)) ((tt, h1), v1) ((tt, h2), v2) =
  transH (apH {V1.Ix (S1.HXY.1.tob J tt)} {V1.Ix (S1.Dv.ob J)} (\ x -> ((tt, x), v1)) ph) (apH {S1.PK u.1 J} {V1.Ix (S1.Dv.ob J)} (\ x -> ((tt, h2), x)) pv) ;
 ptNT (J I : Ob) (h : Hom J I) : (o : Top) (w : V1.Ix (Ec.tob I o))
  -> Id (V1.Ix (S1.Dv.ob J)) (S1.Dv.act J I h (ptT I o w)) (ptT J (Nl.act J I h o) (Ec.tact J I h o (Nl.act J I h o) (refl (Nl.act J I h o)) w)) = split {
  tt -> \ w -> pairD J (S1.HXY.1.tact J I h tt tt (refl tt) (CV.CB.hN.nfun I tt w)) (CV.CB.hN.nfun J tt (Ec.tact J I h tt tt (refl tt) w)) (CV.CB.hN.nnat J I h tt tt (refl tt) w)
     ((S1.Pm u.1).1.tact J I h tt tt (L.ntEq S1.Gh Nl (C.eps S1.Gh) J I h (tt, CV.CB.hN.nfun I tt w) (S1.Gh.act J I h (tt, CV.CB.hN.nfun I tt w)) (refl (S1.Gh.act J I h (tt, CV.CB.hN.nfun I tt w)))) (CV.vN.nfun I tt w))
     (CV.vN.nfun J tt (Ec.tact J I h tt tt (refl tt) w))
     (transH (L.tact-irr Nl (S1.Pm u.1).1 J I h tt tt (L.ntEq S1.Gh Nl (C.eps S1.Gh) J I h (tt, CV.CB.hN.nfun I tt w) (S1.Gh.act J I h (tt, CV.CB.hN.nfun I tt w)) (refl (S1.Gh.act J I h (tt, CV.CB.hN.nfun I tt w)))) (refl tt) (CV.vN.nfun I tt w))
       (CV.vN.nnat J I h tt tt (refl tt) w)) } ;
 ptD : C.Sub K S1.Dv = new L.PSub[K, S1.Dv, \ I z -> ptT I z.1 z.2, \ J I h z -> symH (ptNT J I h z.1 z.2)] ;
 -- each equation as an element of c2's IdEv at the point
 module EQm = E3.EQ ;
 module EV = S1.EV ;
 kk : Nat = TU.kk ;
 GT : C.Ctx = S2.GT ;
 sgK : C.Sub K GT = C.o K S1.Dv GT S2.sigma ptD ;
 Qk : C.Ty GT = EV.Qk kk ;
 module Eq (p : E3.Exs) (ps : SX.Over[R].Equations (SX.Fin kk)) (s : UP0.C.Sub UP0.E (UP0.SO.HS (cons (EQm.RN p) (E3.Lqs ps))).1)
   (J : (X : E3.E2.TOb) (w : V1.Ix (UP0.E.ob X)) -> Id (V1.Ix (UP0.SO.Xc.ob X)) ((UP0.SO.HS (cons (EQm.RN p) (E3.Lqs ps))).2.nt X (s.nt X w)) ((CV.XS.nt X w).1)) {
  module Qe = E3.Q[p, ps, s, J] ;
  module HI = CHtIdP[a].At[Nl, Ec, S1.Qy, EQm.LQ p, Qe.CC0.cAX, Qe.res] ;
  e1' : C.El GT Qk = EV.evE kk p ;
  e0' : C.El GT Qk = EV.evE kk (cst R.z) ;
  Ty2 : C.Ty K = C.subT K GT Qk sgK ;
  A' : C.El K Ty2 = C.subt K GT Qk e1' sgK ;
  B' : C.El K Ty2 = C.subt K GT Qk e0' sgK ;
  P2 : Id (C.Ty K) HI.YY Ty2 =
   transH (apH {C.Sub K Nl} {C.Ty K} (\ t -> C.subT K Nl S1.Qy t) (transH (C.eps-uniq K (L.pP Nl Ec)) (symH (C.eps-uniq K (C.o K GT Nl (C.eps GT) sgK)))))
    (C.subT-o K GT Nl S1.Qy (C.eps GT) sgK) ;
  pxT (X : Ob) : (o : Top) (w : V1.Ix (Ec.tob X o)) -> Id (V1.Ix (Ty2.1.tob X (o, w))) ((OV.trE K HI.YY Ty2 P2 HI.a0).eob X (o, w)) (A'.eob X (o, w)) = split {
   tt -> \ w -> transH (transH (trERd K HI.YY Ty2 P2 HI.a0 X (tt, w)) (sameRd K HI.YY Ty2 P2 X (tt, w) (refl (Ty2.1.tob X (tt, w))) (HI.a0.eob X (tt, w))))
      (EQm.evIdQ p X (S1.sgT X tt (TU.zz X w) (TU.vv X w))) } ;
  pyT (X : Ob) : (o : Top) (w : V1.Ix (Ec.tob X o)) -> Id (V1.Ix (Ty2.1.tob X (o, w))) ((OV.trE K HI.YY Ty2 P2 HI.b0).eob X (o, w)) (B'.eob X (o, w)) = split {
   tt -> \ w -> transH (trERd K HI.YY Ty2 P2 HI.b0 X (tt, w)) (sameRd K HI.YY Ty2 P2 X (tt, w) (refl (Ty2.1.tob X (tt, w))) (HI.b0.eob X (tt, w))) } ;
  e2 : C.El K (IJ.IdT K Ty2 A' B') =
   rwId K Ty2 (OV.trE K HI.YY Ty2 P2 HI.a0) A' (OV.trE K HI.YY Ty2 P2 HI.b0) B' (\ X z -> pxT X z.1 z.2) (\ X z -> pyT X z.1 z.2)
    (idFwd K HI.YY Ty2 P2 HI.a0 HI.b0 HI.el) ;
  X0 : C.Ty GT = IJ.IdT GT Qk e1' e0' ;
  h1 : C.El K (C.subT K GT X0 sgK) = OV.trE K (IJ.IdT K Ty2 A' B') (C.subT K GT X0 sgK) (symH (IJ.IdT-nat K GT Qk e1' e0' sgK)) e2 ;
  -- p = 0 at the point, in c2's IdEv
  res : C.El K (C.subT K S1.Dv (S2.IdEv p) ptD) = OV.trE K (C.subT K GT X0 sgK) (C.subT K S1.Dv (S2.IdEv p) ptD) (C.subT-o K S1.Dv GT X0 S2.sigma ptD) h1 ;
 } ;
} ;
