-- CCmpU21.seg (canonicity-c2; (K) for cmpI, part 21): the closed point
-- (r, cls (cst r), refl) of the constants' type Wc.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module U21 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module HZ = CPreI[a].PreOf[R, encK, pe].CmpI[y].Q1.TM.P.H ;
 module CS = HZ.CS ;
 Nl : C.Ctx = C.nil ;
 DR : C.Ty Nl = CPreI[a].PreOf[R, encK, pe].CmpI[y].Q1.TM.P.HP.DR ;
 QS : C.Ty Nl = HZ.AS.Qt ;
 module GS2 = CS.GS2 ;
 GP : C.Ctx = CS.GP ;
 GPS : C.Ctx = CS.GPS ;
 Ex : C.Ctx = C.ext GPS CS.IdCSt ;
 Wc : C.Ty Nl = CS.Wc ;
 -- the generic tuple over GPS.IdCSt
 tup (K : Ob) (x : V1.Ix (Ex.ob K)) : V1.Ix (Wc.1.tob K x.1.1.1) = (x.1.1.2, (x.1.2, x.2)) ;
 piN (K : Ob) (x : V1.Ix (Ex.ob K)) : V1.Ix (Nl.ob K) = x.1.1.1 ;
 pi : C.Sub Ex Nl = new L.PSub[Ex, Nl, piN, \ J I f x -> refl (piN J (Ex.act J I f x))] ;
 Wcw : C.Ty Ex = C.subT Ex Nl Wc pi ;
 tupB (J I : Ob) (f : Hom J I) (x : V1.Ix (Ex.ob I))
   : Id (V1.Ix (Wcw.1.tob J (Ex.act J I f x))) (Wcw.1.tact J I f x (Ex.act J I f x) (refl (Ex.act J I f x)) (tup I x)) (tup J (Ex.act J I f x)) =
  L.tact-irr Nl Wc.1 J I f x.1.1.1 x.1.1.1 (L.ntEq Ex Nl pi J I f x (Ex.act J I f x) (refl (Ex.act J I f x))) (refl x.1.1.1) (tup I x) ;
 tupE : C.El Ex Wcw = L.mkPEl Ex Wcw.1 tup (\ J I f x x' e ->
  idJ (V1.Ix (Ex.ob J)) (Ex.act J I f x) (\ x2 e2 -> Id (V1.Ix (Wcw.1.tob J x2)) (Wcw.1.tact J I f x x2 e2 (tup I x)) (tup J x2))
    (tupB J I f x) x' e) ;
 -- the point at r
 module At (r : R.R) {
  c : C.El Nl QS = HZ.AS.AX.cls (cst r) ;
  s2N (K : Ob) (o : V1.Ix (Nl.ob K)) : V1.Ix (GPS.ob K) = ((o, r), c.eob K o) ;
  s2 : C.Sub Nl GPS = new L.PSub[Nl, GPS, s2N, \ J I f o ->
   apH {V1.Ix (QS.1.tob J o)} {V1.Ix (GPS.ob J)} (\ v -> ((o, r), v))
    (symH (transH (L.tact-irr Nl QS.1 J I f o o (L.ntEq GP Nl (L.pP Nl DR.1) J I f (o, r) (o, r) (refl (o, r))) (refl o) (c.eob I o))
              (c.enat J I f o o (refl o))))] ;
  sg : C.Sub Nl GS2.G2 = C.o Nl GPS GS2.G2 CS.rS s2 ;
  s12 : C.Sub GS2.G2 Nl = C.o GS2.G2 GS2.G1 Nl (C.p Nl QS) (C.p GS2.G1 GS2.Qw) ;
  Q2s : C.Ty Nl = C.subT Nl GS2.G2 GS2.Qw2 sg ;
  PQ : Id (C.Ty Nl) QS Q2s =
   symH (transH (apH {C.Ty GS2.G2} {C.Ty Nl} (\ T -> C.subT Nl GS2.G2 T sg) (symH (C.subT-o GS2.G2 GS2.G1 Nl QS (C.p Nl QS) (C.p GS2.G1 GS2.Qw))))
    (transH (symH (C.subT-o Nl GS2.G2 Nl QS s12 sg))
      (transH (apH {C.Sub Nl Nl} {C.Ty Nl} (\ s -> C.subT Nl Nl QS s) (transH (C.eps-uniq Nl (C.o Nl GS2.G2 Nl s12 sg)) (symH (C.eps-uniq Nl (C.id Nl)))))
         (C.subT-id Nl QS)))) ;
  x1 : C.El Nl Q2s = C.subt Nl GS2.G2 GS2.Qw2 GS2.v1 sg ;
  x2 : C.El Nl Q2s = C.subt Nl GS2.G2 GS2.Qw2 GS2.v2 sg ;
  cr (K : Ob) (o : V1.Ix (Nl.ob K)) : Id (V1.Ix (Q2s.1.tob K o)) ((OV.trE Nl QS Q2s PQ c).eob K o) (c.eob K o) =
   transH (CAppRd[a].trE-rd Nl QS Q2s PQ c K o) (CAppRd[a].same-rd Nl QS Q2s PQ K o (refl (QS.1.tob K o)) (c.eob K o)) ;
  b2 : C.El Nl (IJ.IdT Nl Q2s x1 x2) =
   CCmpU14[a].rwId Nl Q2s (OV.trE Nl QS Q2s PQ c) x1 (OV.trE Nl QS Q2s PQ c) x2 cr cr
    (CCmpU16[a].U16[R, encK, pe, y].idFwd Nl QS Q2s PQ c c (IJ.rfl Nl QS c)) ;
  T0 : C.Ty Nl = C.subT Nl GPS CS.IdCSt s2 ;
  PT0 : Id (C.Ty Nl) (IJ.IdT Nl Q2s x1 x2) T0 =
   symH (transH (symH (C.subT-o Nl GPS GS2.G2 CS.IdGS CS.rS s2)) (IJ.IdT-nat Nl GS2.G2 GS2.Qw2 GS2.v1 GS2.v2 sg)) ;
  pf : C.El Nl T0 = OV.trE Nl (IJ.IdT Nl Q2s x1 x2) T0 PT0 b2 ;
  spN (K : Ob) (o : V1.Ix (Nl.ob K)) : V1.Ix (Ex.ob K) = (s2N K o, pf.eob K o) ;
  spT (J I : Ob) (f : Hom J I) (o : V1.Ix (Nl.ob I)) : Id (V1.Ix (Ex.ob J)) (spN J (Nl.act J I f o)) (Ex.act J I f (spN I o)) =
   symH (transH (L.pair-act GPS CS.IdCSt.1 J I f (s2N I o) (s2N J o) (L.ntEq Nl GPS s2 J I f o o (refl o)) (pf.eob I o))
     (apH {V1.Ix (CS.IdCSt.1.tob J (s2N J o))} {V1.Ix (Ex.ob J)} (\ v -> (s2N J o, v)) (pf.enat J I f o o (refl o)))) ;
  sp : C.Sub Nl Ex = new L.PSub[Nl, Ex, spN, spT] ;
  PE : Id (C.Ty Nl) (C.subT Nl Ex Wcw sp) Wc =
   transH (symH (C.subT-o Nl Ex Nl Wc pi sp))
    (transH (apH {C.Sub Nl Nl} {C.Ty Nl} (\ s -> C.subT Nl Nl Wc s) (transH (C.eps-uniq Nl (C.o Nl Ex Nl pi sp)) (symH (C.eps-uniq Nl (C.id Nl)))))
      (C.subT-id Nl Wc)) ;
  wc : C.El Nl Wc = OV.trE Nl (C.subT Nl Ex Wcw sp) Wc PE (C.subt Nl Ex Wcw tupE sp) ;
  wcrd (K : Ob) (o : V1.Ix (Nl.ob K)) : Id (V1.Ix (Wc.1.tob K o)) (wc.eob K o) (tup K (spN K o)) =
   transH (CAppRd[a].trE-rd Nl (C.subT Nl Ex Wcw sp) Wc PE (C.subt Nl Ex Wcw tupE sp) K o)
    (CAppRd[a].same-rd Nl (C.subT Nl Ex Wcw sp) Wc PE K o (refl (Wc.1.tob K o)) (tup K (spN K o))) ;
 } ;
} ;
