-- CGBr.seg (canonicity-45; COBAR.md "Prop 58"): the two readings of G as a
-- type over the terminal context: c2's GT (the context D(yo F1) as a type,
-- CtxTy) and Cor 15's Bt (D(Y1T F1) at tau of the terminal point).  At each
-- point, w |-> its back reading (over the trivial point d1) moved along
-- d1 = tau(tt) (D1's families are all tt); tau goes to tau_A.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module GBr (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module LC = CL14C[a].L14C[R, encK, pe] ;
 module YF = LC.YF ;
 module CT = YF.CT ;
 module O1 = YF.O1 ;
 module LB = LC.LB ;
 module DA = LB.DA ;
 Y1 : YF.CM.TP.TCtx = YF.CM.Yo[YF.FR.F1].yoT ;
 dEq (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) : Id (O1.D1.Ob' I x) (O1.d1 I x) (O1.D1.tau I x tt) =
  O1.D1.ob-eq I x (O1.d1 I x) (O1.D1.tau I x tt) (\ q l -> refl tt) ;
 cv (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (w : O1.DY.Ob' I x) : DA.TOb' I x (O1.D1.tau I x tt) =
  subst (O1.D1.Ob' I x) (\ d -> DA.TOb' I x d) (O1.d1 I x) (O1.D1.tau I x tt) (dEq I x) (O1.Bk[I, x, w].res) ;
 -- transport along a path of points of D1 does not change the family
 famSub (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (d d' : O1.D1.Ob' I x) (p : Id (O1.D1.Ob' I x) d d') (b : DA.TOb' I x d)
  (q : DA.Idx I x) (l : DA.LandsI I x q)
  : Id (V1.Ix (Y1.ob q.2.1 q.2.2.2.1)) ((subst (O1.D1.Ob' I x) (\ d0 -> DA.TOb' I x d0) d d' p b).1 q l) (b.1 q l) =
  idJ (O1.D1.Ob' I x) d (\ d2 p2 -> Id (V1.Ix (Y1.ob q.2.1 q.2.2.2.1)) ((subst (O1.D1.Ob' I x) (\ d0 -> DA.TOb' I x d0) d d2 p2 b).1 q l) (b.1 q l))
   (refl (b.1 q l)) d' p ;
 cvTau (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (a0 : V1.Ix (Y1.ob I x)) : Id (DA.TOb' I x (O1.D1.tau I x tt)) (cv I x (O1.DY.tau I x a0)) (LB.TA.tauA I x tt a0) =
  DA.tob-eq I x (O1.D1.tau I x tt) (cv I x (O1.DY.tau I x a0)) (LB.TA.tauA I x tt a0) (\ q l ->
   famSub I x (O1.d1 I x) (O1.D1.tau I x tt) (dEq I x) (O1.Bk[I, x, O1.DY.tau I x a0].res) q l) ;
 -- coercion in the constant family Y1 over D1's points
 coeC (J : Ob) (z : V1.Ix (YF.CM.IC.obD J)) (g g' : V1.Ix (YF.CT.T1.ob J z)) (e : Id (V1.Ix (YF.CT.T1.ob J z)) g g') (b : V1.Ix (Y1.ob J z))
  : Id (V1.Ix (Y1.ob J z)) (DA.coeT J z g g' e b) b =
  idJ (V1.Ix (YF.CT.T1.ob J z)) g (\ g2 e2 -> Id (V1.Ix (Y1.ob J z)) (DA.coeT J z g g2 e2 b) b) (refl b) g' e ;
 -- cv is natural along total maps
 module CN (J I : Ob) (u0 : Hom J I) (yy : V1.Ix (YF.CM.IC.obD J)) (x : V1.Ix (YF.CM.IC.obD I)) (f0 : YF.CM.TP.HomD J I u0 yy x) (w : O1.DY.Ob' I x) {
  eT : Id (O1.D1.Ob' J yy) (O1.D1.act J I u0 yy x f0 (O1.D1.tau I x tt)) (O1.D1.tau J yy tt) = symH (O1.D1.tau-nat J I u0 yy x f0 tt) ;
  module TB = DA.TB[J, I, u0, yy, x, f0, O1.D1.tau I x tt, O1.D1.tau J yy tt, eT, cv I x w] ;
  law : Id (DA.TOb' J yy (O1.D1.tau J yy tt)) (cv J yy (O1.DY.act J I u0 yy x f0 w)) TB.res =
   DA.tob-eq J yy (O1.D1.tau J yy tt) (cv J yy (O1.DY.act J I u0 yy x f0 w)) TB.res (\ q l ->
    transH (famSub J yy (O1.d1 J yy) (O1.D1.tau J yy tt) (dEq J yy) (O1.Bk[J, yy, O1.DY.act J I u0 yy x f0 w].res) q l)
     (symH (transH (coeC q.2.1 q.2.2.2.1 ((O1.D1.tau I x tt).1 (TB.sh q) l) ((O1.D1.tau J yy tt).1 q l) (TB.pe q l) ((cv I x w).1 (TB.sh q) l))
              (famSub I x (O1.d1 I x) (O1.D1.tau I x tt) (dEq I x) (O1.Bk[I, x, w].res) (TB.sh q) l)))) ;
 } ;
 -- the way back, and the two round trips
 cvInv (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (b : DA.TOb' I x (O1.D1.tau I x tt)) : O1.DY.Ob' I x =
  O1.fw (I, x) (O1.d1 I x, subst (O1.D1.Ob' I x) (\ d -> DA.TOb' I x d) (O1.D1.tau I x tt) (O1.d1 I x) (symH (dEq I x)) b) ;
 substBack (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (d d' : O1.D1.Ob' I x) (p : Id (O1.D1.Ob' I x) d d') (b : DA.TOb' I x d)
  : Id (DA.TOb' I x d) (subst (O1.D1.Ob' I x) (\ d0 -> DA.TOb' I x d0) d' d (symH p) (subst (O1.D1.Ob' I x) (\ d0 -> DA.TOb' I x d0) d d' p b)) b =
  idJ (O1.D1.Ob' I x) d (\ d2 p2 -> Id (DA.TOb' I x d) (subst (O1.D1.Ob' I x) (\ d0 -> DA.TOb' I x d0) d2 d (symH p2) (subst (O1.D1.Ob' I x) (\ d0 -> DA.TOb' I x d0) d d2 p2 b)) b)
   (refl b) d' p ;
 rt1 (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (w : O1.DY.Ob' I x) : Id (O1.DY.Ob' I x) (cvInv I x (cv I x w)) w =
  transH (apH {DA.TOb' I x (O1.d1 I x)} {O1.DY.Ob' I x} (\ b -> O1.fw (I, x) (O1.d1 I x, b))
            (substBack I x (O1.d1 I x) (O1.D1.tau I x tt) (dEq I x) (O1.Bk[I, x, w].res)))
   (O1.fb I x w) ;
 rt2 (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (b : DA.TOb' I x (O1.D1.tau I x tt)) : Id (DA.TOb' I x (O1.D1.tau I x tt)) (cv I x (cvInv I x b)) b =
  DA.tob-eq I x (O1.D1.tau I x tt) (cv I x (cvInv I x b)) b (\ q l ->
   transH (famSub I x (O1.d1 I x) (O1.D1.tau I x tt) (dEq I x) (O1.Bk[I, x, cvInv I x b].res) q l)
    (famSub I x (O1.D1.tau I x tt) (O1.d1 I x) (symH (dEq I x)) b q l)) ;
 -- over any point g of the terminal context (Top: isTop)
 dEqg (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (g : V1.Ix (YF.CT.T1.ob I x)) : Id (O1.D1.Ob' I x) (O1.d1 I x) (O1.D1.tau I x g) =
  O1.D1.ob-eq I x (O1.d1 I x) (O1.D1.tau I x g) (\ q l -> isTop tt ((O1.D1.tau I x g).1 q l)) ;
 cvg (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (g : V1.Ix (YF.CT.T1.ob I x)) (w : O1.DY.Ob' I x) : DA.TOb' I x (O1.D1.tau I x g) =
  subst (O1.D1.Ob' I x) (\ d -> DA.TOb' I x d) (O1.d1 I x) (O1.D1.tau I x g) (dEqg I x g) (O1.Bk[I, x, w].res) ;
 cvgInv (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (g : V1.Ix (YF.CT.T1.ob I x)) (b : DA.TOb' I x (O1.D1.tau I x g)) : O1.DY.Ob' I x =
  O1.fw (I, x) (O1.d1 I x, subst (O1.D1.Ob' I x) (\ d -> DA.TOb' I x d) (O1.D1.tau I x g) (O1.d1 I x) (symH (dEqg I x g)) b) ;
 rt1g (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (g : V1.Ix (YF.CT.T1.ob I x)) (w : O1.DY.Ob' I x) : Id (O1.DY.Ob' I x) (cvgInv I x g (cvg I x g w)) w =
  transH (apH {DA.TOb' I x (O1.d1 I x)} {O1.DY.Ob' I x} (\ b -> O1.fw (I, x) (O1.d1 I x, b))
            (substBack I x (O1.d1 I x) (O1.D1.tau I x g) (dEqg I x g) (O1.Bk[I, x, w].res)))
   (O1.fb I x w) ;
 rt2g (I : Ob) (x : V1.Ix (YF.CM.IC.obD I)) (g : V1.Ix (YF.CT.T1.ob I x)) (b : DA.TOb' I x (O1.D1.tau I x g)) : Id (DA.TOb' I x (O1.D1.tau I x g)) (cvg I x g (cvgInv I x g b)) b =
  DA.tob-eq I x (O1.D1.tau I x g) (cvg I x g (cvgInv I x g b)) b (\ q l ->
   transH (famSub I x (O1.d1 I x) (O1.D1.tau I x g) (dEqg I x g) (O1.Bk[I, x, cvgInv I x g b].res) q l)
    (famSub I x (O1.D1.tau I x g) (O1.d1 I x) (symH (dEqg I x g)) b q l)) ;
 module CNg (J I : Ob) (u0 : Hom J I) (yy : V1.Ix (YF.CM.IC.obD J)) (x : V1.Ix (YF.CM.IC.obD I)) (f0 : YF.CM.TP.HomD J I u0 yy x)
   (g : V1.Ix (YF.CT.T1.ob I x)) (g' : V1.Ix (YF.CT.T1.ob J yy)) (e : Id (O1.D1.Ob' J yy) (O1.D1.act J I u0 yy x f0 (O1.D1.tau I x g)) (O1.D1.tau J yy g'))
   (w : O1.DY.Ob' I x) {
  module TB = DA.TB[J, I, u0, yy, x, f0, O1.D1.tau I x g, O1.D1.tau J yy g', e, cvg I x g w] ;
  law : Id (DA.TOb' J yy (O1.D1.tau J yy g')) (cvg J yy g' (O1.DY.act J I u0 yy x f0 w)) TB.res =
   DA.tob-eq J yy (O1.D1.tau J yy g') (cvg J yy g' (O1.DY.act J I u0 yy x f0 w)) TB.res (\ q l ->
    transH (famSub J yy (O1.d1 J yy) (O1.D1.tau J yy g') (dEqg J yy g') (O1.Bk[J, yy, O1.DY.act J I u0 yy x f0 w].res) q l)
     (symH (transH (coeC q.2.1 q.2.2.2.1 ((O1.D1.tau I x g).1 (TB.sh q) l) ((O1.D1.tau J yy g').1 q l) (TB.pe q l) ((cvg I x g w).1 (TB.sh q) l))
              (famSub I x (O1.d1 I x) (O1.D1.tau I x g) (dEqg I x g) (O1.Bk[I, x, w].res) (TB.sh q) l)))) ;
 } ;
 -- GT is fibrant at the total site: Bt's structure (Cor 15) moved along cv
 GT : LB.P.PTy[CT.P1] = CT.Of[O1.DY.DCtx].Y1T ;
 module TGT = LB.TR.G1.GB.GPre[a+].TyL[CT.P1, GT] ;
 module TBt = LB.TR.G1.GB.GPre[a+].TyL[CT.P1, LB.Bt] ;
 ta (X : YF.CT.TC.TOb) (v : TGT.EI X) : TBt.EI X = TBt.pr X v.1 (cvg X.1 X.2 v.1 v.2) ;
 tanat (Vv X : YF.CT.TC.TOb) (h : YF.CT.TC.THm Vv X) (v : TGT.EI X) : Id (TBt.EI Vv) (TBt.E.act Vv X h (ta X v)) (ta Vv (TGT.E.act Vv X h v)) =
  apH {DA.TOb' Vv.1 Vv.2 (O1.D1.tau Vv.1 Vv.2 (CT.P1.act Vv X h v.1))} {TBt.EI Vv} (TBt.pr Vv (CT.P1.act Vv X h v.1))
   (symH (CNg[Vv.1, X.1, h.1, Vv.2, X.2, h.2, v.1, CT.P1.act Vv X h v.1,
            LB.P.ntEq CT.P1 (CT.TC.toP O1.D1.DCtx) (CT.TC.toPS CT.T1 O1.D1.DCtx O1.D1.tauS) Vv X h v.1 (CT.P1.act Vv X h v.1) (refl (CT.P1.act Vv X h v.1)), v.2].law)) ;
 tainj (X : YF.CT.TC.TOb) (v v' : TGT.EI X) (Pp : Id (V1.Ix (CT.P1.ob X)) v.1 v'.1) (Q : Id (TBt.EI X) (ta X v) (ta X v')) : Id (TGT.EI X) v v' =
  idJ (V1.Ix (CT.P1.ob X)) v.1 (\ o2 P2 -> (w2 : O1.DY.Ob' X.1 X.2) -> Id (TBt.EI X) (ta X v) (TBt.pr X o2 (cvg X.1 X.2 o2 w2)) -> Id (TGT.EI X) v (o2, w2))
   (\ w2 Q2 -> apH {O1.DY.Ob' X.1 X.2} {TGT.EI X} (\ w3 -> (v.1, w3))
      (transH (symH (rt1g X.1 X.2 v.1 v.2))
        (transH (apH {DA.TOb' X.1 X.2 (O1.D1.tau X.1 X.2 v.1)} {O1.DY.Ob' X.1 X.2} (cvgInv X.1 X.2 v.1) (TBt.pr-inj X v.1 (cvg X.1 X.2 v.1 v.2) (cvg X.1 X.2 v.1 w2) Q2))
          (rt1g X.1 X.2 v.1 w2))))
   v'.1 Pp v'.2 Q ;
 module CRT = LB.TR.G1.GB.CCart[a+, a+].Cart[CT.P1, GT, CT.P1, LB.Bt, \ X o -> o, \ Vv X h o -> refl (CT.P1.act Vv X h o), ta, \ X v -> refl v.1,
   tanat, tainj, \ X o b -> cvgInv X.1 X.2 o b, \ X o b -> apH {DA.TOb' X.1 X.2 (O1.D1.tau X.1 X.2 o)} {TBt.EI X} (TBt.pr X o) (rt2g X.1 X.2 o b)] ;
 fbGT : LB.TR.G1.GB.CLine[a+].Lines[CT.P1, GT].Fib = CRT.moveFib (LC.C15.LG.Out[LC.C15.LF.lemma12F YF.fibG0].fbB) ;
} ;
