-- CTermEval.seg (canonicity-45; SIMPLIFIED.md step 2b): evaluation of the
-- terms of a presentation x into an h-set ring of the base (CPilotRing's
-- HRing) given a coefficient map phi from the metatheory ring (a ring
-- homomorphism, as Id-elements) and a valuation of the generators
-- satisfying the equations of x; a derivation of t ~ u evaluates to an
-- Id-element ev t = ev u (resp, by induction on the derivation tree,
-- through the pilot's congruence toolkit).  This is the core of the
-- universal property of A_x: with the quotient's eliminator (c2's elim,
-- elimP) it gives the unique map A_x -> R.
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module FBC = FibCwF[a, l] ;
module FID = FibId[a, l] ;
module PR = CPilotRing[a, l] ;
module SX = CSyntax[a] ;
C : CwF.CwF[l+] = FBC.fibCwF ;
IJ : CwFId.SwanId[l+, FBC.fibCwF].IdJStr = FID.fibId ;

module Eval (R : Ring[a].CRing) (x : SX.Over[R].Presentation) (G : C.Ctx) (Rg : PR.HRing[G])
 (phi : R.R -> C.El G Rg.R)
 (phi-add : (a1 b1 : R.R) -> C.El G (IJ.IdT G Rg.R (phi (R.add a1 b1)) (PR.ap2 G Rg.R Rg.add (phi a1) (phi b1))))
 (phi-mul : (a1 b1 : R.R) -> C.El G (IJ.IdT G Rg.R (phi (R.mul a1 b1)) (PR.ap2 G Rg.R Rg.mul (phi a1) (phi b1))))
 (phi-one : C.El G (IJ.IdT G Rg.R (phi R.o) Rg.one))
 (phi-zero : C.El G (IJ.IdT G Rg.R (phi R.z) Rg.zero))
 (val : SX.Over[R].Der[x].Vs -> C.El G Rg.R) {
 module Dx = SX.Over[R].Der[x] ;
 module CG = PR.Cong[G, Rg] ;
 Rt : C.Ty G = Rg.R ;
 E : U l+ = C.El G Rt ;
 add (u v : E) : E = PR.ap2 G Rt Rg.add u v ;
 mul (u v : E) : E = PR.ap2 G Rt Rg.mul u v ;
 Idr (u v : E) : U l+ = C.El G (CG.Idr u v) ;

 -- evaluation of terms
 ev : Dx.Term -> E = split {
  var v -> val v ;
  cst r -> phi r ;
  sumE p q | ip iq -> add ip iq ;
  mulE p q | ip iq -> mul ip iq } ;

 -- the congruence toolkit, completed
 mul2 (u u' v v' : E) (p : Idr u u') (q : Idr v v') : Idr (mul u v) (mul u' v') =
  CG.tr (mul u v) (mul u' v) (mul u' v') (CG.mulL u u' v p) (CG.mulR u' v v' q) ;
 -- x + phi(-1) x = 0
 negOne : Idr (add (phi R.o) (phi (R.neg R.o))) Rg.zero =
  CG.tr (add (phi R.o) (phi (R.neg R.o))) (phi (R.add R.o (R.neg R.o))) Rg.zero
   (CG.sy (phi (R.add R.o (R.neg R.o))) (add (phi R.o) (phi (R.neg R.o))) (phi-add R.o (R.neg R.o)))
   (CG.tr (phi (R.add R.o (R.neg R.o))) (phi R.z) Rg.zero (CG.ofEq (phi (R.add R.o (R.neg R.o))) (phi R.z) (apH {R.R} {E} phi (R.addN R.o))) phi-zero) ;
 addNegL (u : E) : Idr (add u (mul (phi (R.neg R.o)) u)) Rg.zero =
  CG.tr (add u (mul (phi (R.neg R.o)) u)) (add (mul u Rg.one) (mul (phi (R.neg R.o)) u)) Rg.zero
   (CG.addL u (mul u Rg.one) (mul (phi (R.neg R.o)) u) (CG.sy (mul u Rg.one) u (Rg.mul-one u)))
   (CG.tr (add (mul u Rg.one) (mul (phi (R.neg R.o)) u)) (add (mul u Rg.one) (mul u (phi (R.neg R.o)))) Rg.zero
     (CG.addR (mul u Rg.one) (mul (phi (R.neg R.o)) u) (mul u (phi (R.neg R.o))) (Rg.mul-comm (phi (R.neg R.o)) u))
     (CG.tr (add (mul u Rg.one) (mul u (phi (R.neg R.o)))) (mul u (add Rg.one (phi (R.neg R.o)))) Rg.zero
       (CG.sy (mul u (add Rg.one (phi (R.neg R.o)))) (add (mul u Rg.one) (mul u (phi (R.neg R.o)))) (Rg.distr u Rg.one (phi (R.neg R.o))))
       (CG.tr (mul u (add Rg.one (phi (R.neg R.o)))) (mul u Rg.zero) Rg.zero
         (CG.mulR u (add Rg.one (phi (R.neg R.o))) Rg.zero
           (CG.tr (add Rg.one (phi (R.neg R.o))) (add (phi R.o) (phi (R.neg R.o))) Rg.zero
             (CG.addL Rg.one (phi R.o) (phi (R.neg R.o)) (CG.sy (phi R.o) Rg.one phi-one)) negOne))
         (CG.tr (mul u Rg.zero) (mul Rg.zero u) Rg.zero (Rg.mul-comm u Rg.zero) (Rg.mul-zero u))))) ;

 -- derivations evaluate to Id-elements, given the equations of x
 module Resp (hyp : (p : Dx.Term) -> Dx.Member p x.2 -> Idr (ev p) Rg.zero) {
  resp : (d : Dx.Tree) -> Dx.Valid d -> Idr (ev (Dx.ends d).1) (ev (Dx.ends d).2) = split {
   reflD p -> \ v -> CG.rf (ev p) ;
   symD d | r -> \ v -> CG.sy (ev (Dx.ends d).1) (ev (Dx.ends d).2) (r v) ;
   transD d e | rd re -> \ v ->
    CG.tr (ev (Dx.ends d).1) (ev (Dx.ends d).2) (ev (Dx.ends e).2) (rd v.1)
     (CG.tr (ev (Dx.ends d).2) (ev (Dx.ends e).1) (ev (Dx.ends e).2) (CG.ofEq (ev (Dx.ends d).2) (ev (Dx.ends e).1) (apH {Dx.Term} {E} ev v.2.2)) (re v.2.1)) ;
   sumD d e | rd re -> \ v -> CG.add2 (ev (Dx.ends d).1) (ev (Dx.ends d).2) (ev (Dx.ends e).1) (ev (Dx.ends e).2) (rd v.1) (re v.2) ;
   mulD d e | rd re -> \ v -> mul2 (ev (Dx.ends d).1) (ev (Dx.ends d).2) (ev (Dx.ends e).1) (ev (Dx.ends e).2) (rd v.1) (re v.2) ;
   addAssoc p q r -> \ v -> CG.sy (add (add (ev p) (ev q)) (ev r)) (add (ev p) (add (ev q) (ev r))) (Rg.add-assoc (ev p) (ev q) (ev r)) ;
   addComm p q -> \ v -> Rg.add-comm (ev p) (ev q) ;
   addZero p -> \ v -> CG.tr (add (ev p) (phi R.z)) (add (ev p) Rg.zero) (ev p) (CG.addR (ev p) (phi R.z) Rg.zero phi-zero) (Rg.add-zero (ev p)) ;
   addNeg p -> \ v -> CG.tr (add (ev p) (mul (phi (R.neg R.o)) (ev p))) Rg.zero (phi R.z) (addNegL (ev p)) (CG.sy (phi R.z) Rg.zero phi-zero) ;
   mulAssoc p q r -> \ v -> CG.sy (mul (mul (ev p) (ev q)) (ev r)) (mul (ev p) (mul (ev q) (ev r))) (Rg.mul-assoc (ev p) (ev q) (ev r)) ;
   mulComm p q -> \ v -> Rg.mul-comm (ev p) (ev q) ;
   mulOne p -> \ v -> CG.tr (mul (ev p) (phi R.o)) (mul (ev p) Rg.one) (ev p) (CG.mulR (ev p) (phi R.o) Rg.one phi-one) (Rg.mul-one (ev p)) ;
   distrib p q r -> \ v -> Rg.distr (ev p) (ev q) (ev r) ;
   coeffAdd a1 b1 -> \ v -> CG.sy (phi (R.add a1 b1)) (add (phi a1) (phi b1)) (phi-add a1 b1) ;
   coeffMul a1 b1 -> \ v -> CG.sy (phi (R.mul a1 b1)) (mul (phi a1) (phi b1)) (phi-mul a1 b1) ;
   equation p member -> \ v -> CG.tr (ev p) Rg.zero (phi R.z) (hyp p member) (CG.sy (phi R.z) Rg.zero phi-zero) } ;
  evP (t u : Dx.Term) (w : Dx.Proof t u) : Idr (ev t) (ev u) =
   CG.tr (ev t) (ev (Dx.ends w.1).1) (ev u) (CG.ofEq (ev t) (ev (Dx.ends w.1).1) (symH (apH {Dx.Term} {E} ev w.2.2.1)))
    (CG.tr (ev (Dx.ends w.1).1) (ev (Dx.ends w.1).2) (ev u) (resp w.1 w.2.1) (CG.ofEq (ev (Dx.ends w.1).2) (ev u) (apH {Dx.Term} {E} ev w.2.2.2))) ;
 } ;
} ;
