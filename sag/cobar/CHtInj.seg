-- CHtInj.seg (canonicity-45; COBAR.md "comparison"): a map ev : A -> B with
-- a retraction inv (eta : inv . ev ~ id, a path homotopy) is injective on
-- homotopies: from u . ev ~ v . ev get u ~ v, for any domain X (Kan
-- composition in A).  Used for the readings of E1's operations on codes,
-- with ev = evaluation at the generator (c2's CEv6).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module HI (G : L.PCtx) (A B : L.PTy[G]) (ev : PB.CHtpyOps[a+].NMap[G, A, B]) (inv : PB.CHtpyOps[a+].NMap[G, B, A])
  (cA : PB.CLine[a+].Lines[G, A].CompK[PB.e0, PB.e1].Comp)
  (eta : L.PEl[L.extP G A, PB.CHtpyOps[a+].HT[G, A, A, PB.CHtpyOps[a+].compN G A B A ev inv, PB.CHtpyOps[a+].idN G A].PT.PathP]) {
 module HO = PB.CHtpyOps[a+] ;
 module At (X : L.PTy[G]) (u v : HO.NMap[G, X, A])
   (h : L.PEl[L.extP G X, HO.HT[G, X, B, HO.compN G X A B u ev, HO.compN G X A B v ev].PT.PathP]) {
  ue : HO.NMap[G, X, A] = HO.compN G X B A (HO.compN G X A B u ev) inv ;
  ve : HO.NMap[G, X, A] = HO.compN G X B A (HO.compN G X A B v ev) inv ;
  -- u ~ inv (ev u)
  module W1 = HO.WR[G, A, A, X, HO.compN G A B A ev inv, HO.idN G A, u, eta] ;
  module R1 = HO.Ret[G, X, A, HO.compN G X A A u (HO.compN G A B A ev inv), HO.compN G X A A u (HO.idN G A), ue, u,
     \ I x a0 -> refl (ue.nfun I x a0), \ I x a0 -> refl (u.nfun I x a0), W1.res] ;
  module I1 = HO.Inv[G, X, A, ue, u, cA, R1.res] ;
  -- inv (ev u) ~ inv (ev v)
  module W2 = HO.WL[G, X, B, A, HO.compN G X A B u ev, HO.compN G X A B v ev, inv, h] ;
  -- inv (ev v) ~ v
  module W3 = HO.WR[G, A, A, X, HO.compN G A B A ev inv, HO.idN G A, v, eta] ;
  module R3 = HO.Ret[G, X, A, HO.compN G X A A v (HO.compN G A B A ev inv), HO.compN G X A A v (HO.idN G A), ve, v,
     \ I x a0 -> refl (ve.nfun I x a0), \ I x a0 -> refl (v.nfun I x a0), W3.res] ;
  module C1 = HO.Cat[G, X, A, u, ue, ve, cA, I1.res, W2.res] ;
  module C2 = HO.Cat[G, X, A, u, ve, v, cA, C1.res, R3.res] ;
  res : L.PEl[L.extP G X, HO.HT[G, X, A, u, v].PT.PathP] = C2.res ;
 } ;
} ;
