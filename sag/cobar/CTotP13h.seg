-- CTotP13h.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part h: mS is injective over equal points (CMove.Mv's mTinj).
-- Equal images give, at every index, equal elements of A (so equal a',
-- totEq for (G, A)) and equal paths; by c2's recovery of a line of D G
-- from Psi (CTotPsi15 at the context G.B) the two lines of D G . D B have
-- equal readings everywhere (totEq for (G, B)), so v = v' (fibE-eq).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13h (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PG = CTotP13g[a, vl, l].P13g[C, G, A, B, f] ;
 module PF = PG.PF ;
 module PE = PG.PE ;
 module TR = PE.TR ;
 module TC = PE.TC ;
 module DO = PE.DO ;
 module DF = PE.DF ;
 module H = PE.H ;
 module HD = PE.HD ;
 module R15 = CTotPsi15[a, vl, l].Psi15[C, PE.ET] ;
 module LMA = CTotL12m[a, vl, l].L12m[C, G, A] ;
 module LMB = CTotL12m[a, vl, l].L12m[C, G, B] ;

 module Inj (Xm : TC.TOb) (v v' : HD.TF.EI Xm) (P : Id (HD.TA.EI Xm) (HD.TF.pr1 Xm v) (HD.TF.pr1 Xm v'))
   (Q : Id (PG.Tot0 Xm) (PF.mS Xm v) (PF.mS Xm v')) {
  module M = PE.MS[Xm, v] ;
  module M' = PE.MS[Xm, v'] ;
  rdS (T : PG.Tot0 Xm) (qq : DO.Idx Xm.1 Xm.2) (lq : DO.LandsI Xm.1 Xm.2 qq) : H.TF.EI (qq.2.1, qq.2.2.2.1) =
   PF.DS.prz qq.2.1 qq.2.2.2.1 (T.1.1 qq lq) (T.2.1 qq lq) ;
  -- the elements of A
  qb : Id (HD.TB.EI Xm) (HD.fibB Xm v) (HD.fibB Xm v') =
   LMA.totEq Xm (HD.fibB Xm v) (HD.fibB Xm v') (apH {HD.TA.EI Xm} {W0.Ix (PE.PO.DG.ob Xm)} (HD.TA.pr1 Xm) P)
    (\ qq lq -> apH {PG.Tot0 Xm} {H.TB.EI (qq.2.1, qq.2.2.2.1)} (\ T -> H.fibB (qq.2.1, qq.2.2.2.1) (rdS T qq lq)) Q) ;
  -- the lines
  module RD (Vb : TC.TOb) (g : TC.THm Vb Xm) (j : PB.IvP Vb.1) (q : DO.Idx Vb.1 Vb.2) (lq : DO.LandsI Vb.1 Vb.2 q) {
   module RA = R15.Rec[Xm, M.lE, Vb, g, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq), j] ;
   module RB = R15.Rec[Xm, M'.lE, Vb, g, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq), j] ;
   qq : DO.Idx Xm.1 Xm.2 = (q.1, q.2.1, RA.U0, q.2.2.2.1, RA.cc, q.2.2.2.2.2) ;
   val : Id (H.TA.EI RA.Y) (H.fibL RA.Y (rdS (PF.mS Xm v) qq lq) RA.Y (TC.tid RA.Y) RA.j0) (H.fibL RA.Y (rdS (PF.mS Xm v') qq lq) RA.Y (TC.tid RA.Y) RA.j0) =
    apH {PG.Tot0 Xm} {H.TA.EI RA.Y} (\ T -> H.fibL RA.Y (rdS T qq lq) RA.Y (TC.tid RA.Y) RA.j0) Q ;
   law : Id (DF.DB.Ez q.2.1 q.2.2.2.1) (DF.DB.prz q.2.1 q.2.2.2.1 ((M.L.1 Vb g j).1.1 q lq) ((M.L.1 Vb g j).2.1 q lq))
           (DF.DB.prz q.2.1 q.2.2.2.1 ((M'.L.1 Vb g j).1.1 q lq) ((M'.L.1 Vb g j).2.1 q lq)) =
    transH RA.law (transH val (symH RB.law)) ;
  } ;
  Leq (Vb : TC.TOb) (g : TC.THm Vb Xm) (j : PB.IvP Vb.1) : Id (LMB.Tot Vb) (M.L.1 Vb g j) (M'.L.1 Vb g j) =
   LMB.totEq Vb (M.L.1 Vb g j) (M'.L.1 Vb g j)
    (DF.D.ob-eq Vb.1 Vb.2 (M.L.1 Vb g j).1 (M'.L.1 Vb g j).1
       (\ q lq -> apH {DF.DB.Ez q.2.1 q.2.2.2.1} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ t -> t.1) (RD[Vb, g, j, q, lq].law)))
    (\ q lq -> RD[Vb, g, j, q, lq].law) ;
  law : Id (HD.TF.EI Xm) v v' = HD.fibE-eq Xm v v' P qb (\ Vb g j -> Leq Vb g j) ;
 } ;
} ;
