-- A triple of terms in a presented algebra gives a natural C-morphism
-- from F3; its values on the three generators are the three classes.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Codes (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (y : SX.Over[R].Presentation) {
  module F = CFree3Assoc[a].Free3[R] ;
  module CM = CCopy[a].ConcC[R, encK, pe].CM ;
  module AY = CAlgX[a].AlgX[R, encK, y, pe] ;
  module A3 = CAlgX[a].AlgX[R, encK, F.F3, pe] ;
  module Triple (t1 t2 t3 : AY.Term) {
    sg : SX.Fin F.F3.1 -> AY.Term = split {
      inl v -> CSubCong[a].Val[R, y].val2 t1 t2 v ;
      inr w -> t3 } ;
    module S = CM.II.SubC[F.F3, y, sg,
      \ p m -> absurd (AY.Dx.Proof (CSubst[a].SE[R].subE (SX.Fin F.F3.1) (SX.Fin y.1) sg p) AY.Dx.zeroE) m] ;
    phi : C.El C.nil (OV.Fun C.nil A3.Qt AY.Qt) = S.SM.Phi ;
    beta1 : C.El C.nil (IJ.IdT C.nil AY.Qt (OV.app C.nil A3.Qt AY.Qt phi (A3.cls F.x1)) (AY.cls t1)) =
      S.SM.beta F.x1 ;
    beta2 : C.El C.nil (IJ.IdT C.nil AY.Qt (OV.app C.nil A3.Qt AY.Qt phi (A3.cls F.x2)) (AY.cls t2)) =
      S.SM.beta F.x2 ;
    beta3 : C.El C.nil (IJ.IdT C.nil AY.Qt (OV.app C.nil A3.Qt AY.Qt phi (A3.cls F.x3)) (AY.cls t3)) =
      S.SM.beta F.x3 ;
    module FM = CHomT11[a].FromM[R, encK, pe, F.F3, y] ;
    module NT = CHomT16[a].Nat[R, encK, pe, F.F3, y] ;
    HS : C.Ty C.nil = FM.P.H.HomT ;
    zob (K : Ob) : (o : Top) -> V1.Ix (HS.1.tob K o) =
      split { tt -> FM.alpha K (S.M.mor K) } ;
    znat (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (C.nil.act J I f o) o')
      -> Id (V1.Ix (HS.1.tob J o')) (HS.1.tact J I f o o' e (zob I o)) (zob J o') =
      split { tt -> split { tt -> \ e ->
        transH (L.tact-irr C.nil HS.1 J I f tt tt e (refl tt) (FM.alpha I (S.M.mor I)))
          (transH (symH (NT.aNat I J f (S.M.mor I)))
            (apH {CM.MO.Fn[F.F3, y].M J} {V1.Ix (HS.1.tob J tt)} (FM.alpha J) (S.M.mor-nat I J f))) } } ;
    zc : C.El C.nil HS = L.mkPEl C.nil HS.1 zob znat ;
  } ;
} ;
