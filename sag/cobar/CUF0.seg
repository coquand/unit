-- CUF0.seg (canonicity-c2; the nullary case of (U)/(E)): Hom(F0, y) is
-- contractible, F0 = (zero, nil) (45's CCst2.F0): a proposition by the generic
-- (U) (CUG30, no generators), with the centre the hom of the code-level map
-- F0 -> y (CMapsI.SubC, read through CHomT11.alpha, natural by CHomT16).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module F0Of (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K2 = CCst2[a].Cst[R, encK, pe] ;
 F0 : SX.Over[R].Presentation = K2.F0 ;
 module HZ = CHomT3[a].HomP[R, encK, pe].Hom[F0, y] ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = HZ.HomT ;
 D1 : C.Ctx = C.ext Nl HS ;
 H0 : C.Ty Nl = SS.Sig Nl HS (OV.wkT Nl HS HS) ;
 GH : C.Ctx = C.ext Nl H0 ;
 pkA (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HS.1.tob K w.1) = w.2.1 ;
 pkB (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HS.1.tob K w.1) = w.2.2 ;
 pkAN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J (GH.act J I f w)) =
  refl (HS.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) ;
 pkBN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J (GH.act J I f w)) =
  L.tact-irr Nl HS.1 J I f w.1 w.1 (refl w.1)
   (L.ntEq D1 Nl (L.pP Nl HS.1) J I f (w.1, w.2.1) (Nl.act J I f w.1, HS.1.tact J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1)
      (L.pair-act Nl HS.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1))
   w.2.2 ;
 module U20m = CUG20[a].UG20[R, encK, pe, F0, y, H0, pkA, pkB, pkAN, pkBN] ;
 gen (v : SX.Fin F0.1) : C.El GH (U20m.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[F0].AX.cls (var v))) =
  absurd (C.El GH (U20m.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[F0].AX.cls (var v)))) v ;
 module U30m = CUG30[a].UG30[R, encK, pe, F0, y, H0, pkA, pkB, pkAN, pkBN, gen] ;
 -- Hom(F0, y) is a proposition
 HSw : C.Ty D1 = OV.wkT Nl HS HS ;
 E2 : C.Ctx = C.ext D1 HSw ;
 sgN (K : Ob) (w : V1.Ix (E2.ob K)) : V1.Ix (GH.ob K) = (w.1.1, (w.1.2, w.2)) ;
 sg : C.Sub E2 GH = new L.PSub[E2, GH, sgN, \ J I f w -> refl (sgN J (E2.act J I f w))] ;
 HSh : C.Ty GH = U30m.HSh ;
 r1 : C.El E2 (IJ.IdT E2 (C.subT E2 GH HSh sg) (C.subt E2 GH HSh U30m.zA sg) (C.subt E2 GH HSh U30m.zB sg)) =
  OV.trE E2 (C.subT E2 GH (IJ.IdT GH HSh U30m.zA U30m.zB) sg) (IJ.IdT E2 (C.subT E2 GH HSh sg) (C.subt E2 GH HSh U30m.zA sg) (C.subt E2 GH HSh U30m.zB sg))
   (IJ.IdT-nat E2 GH HSh U30m.zA U30m.zB sg) (C.subt E2 GH (IJ.IdT GH HSh U30m.zA U30m.zB) U30m.res sg) ;
 W2 : C.Ty E2 = OV.wkT D1 HSw HSw ;
 PT : Id (C.Ty E2) (C.subT E2 GH HSh sg) W2 =
  transH (symH (C.subT-o E2 GH Nl HS (C.p Nl H0) sg))
   (transH (CCmpU16[a].U16[R, encK, pe, y].clT E2 HS (C.o E2 GH Nl (C.p Nl H0) sg) (C.o E2 D1 Nl (C.p Nl HS) (C.p D1 HSw)))
     (C.subT-o E2 D1 Nl HS (C.p Nl HS) (C.p D1 HSw))) ;
 r2 : C.El E2 (IJ.IdT E2 W2 (OV.trE E2 (C.subT E2 GH HSh sg) W2 PT (C.subt E2 GH HSh U30m.zA sg)) (OV.trE E2 (C.subT E2 GH HSh sg) W2 PT (C.subt E2 GH HSh U30m.zB sg))) =
  CCmpU16[a].U16[R, encK, pe, y].idFwd E2 (C.subT E2 GH HSh sg) W2 PT (C.subt E2 GH HSh U30m.zA sg) (C.subt E2 GH HSh U30m.zB sg) r1 ;
 rdT (z : C.El GH HSh) (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (W2.1.tob K w)) ((OV.trE E2 (C.subT E2 GH HSh sg) W2 PT (C.subt E2 GH HSh z sg)).eob K w) (z.eob K (sgN K w)) =
  transH (CAppRd[a].trE-rd E2 (C.subT E2 GH HSh sg) W2 PT (C.subt E2 GH HSh z sg) K w)
   (CAppRd[a].same-rd E2 (C.subT E2 GH HSh sg) W2 PT K w (refl (W2.1.tob K w)) (z.eob K (sgN K w))) ;
 r3 : C.El E2 (EQ.Id2 Nl HS) =
  CCmpU14[a].rwId E2 W2 (OV.trE E2 (C.subT E2 GH HSh sg) W2 PT (C.subt E2 GH HSh U30m.zA sg)) (OV.wkE D1 HSw HSw (C.q Nl HS))
   (OV.trE E2 (C.subT E2 GH HSh sg) W2 PT (C.subt E2 GH HSh U30m.zB sg)) (C.q D1 HSw) (rdT U30m.zA) (rdT U30m.zB) r2 ;
 pF : C.El Nl (PU.isProp Nl HS) =
  OV.lam Nl HS (FibCwF[a, a+].fibPi.Pi D1 HSw (EQ.Id2 Nl HS)) (OV.lam D1 HSw (EQ.Id2 Nl HS) r3) ;
 -- the centre: the hom of the code-level map F0 -> y
 module CM = CCopy[a].ConcC[R, encK, pe].CM ;
 module SC = CM.II.SubC[F0, y, \ v -> absurd (SX.Over[R].Der[y].Term) v,
   \ p m -> absurd (SX.Over[R].Der[y].Proof (CSubst[a].SE[R].subE (SX.Fin F0.1) (SX.Fin y.1) (\ v -> absurd (SX.Over[R].Der[y].Term) v) p) SX.Over[R].Der[y].zeroE) m] ;
 module FM = CHomT11[a].FromM[R, encK, pe, F0, y] ;
 module NT = CHomT16[a].Nat[R, encK, pe, F0, y] ;
 ceob (K : Ob) : (o : Top) -> V1.Ix (HS.1.tob K o) = split { tt -> FM.alpha K (SC.M.mor K) } ;
 cnat (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o') -> Id (V1.Ix (HS.1.tob J o')) (HS.1.tact J I f o o' e (ceob I o)) (ceob J o') =
  split { tt -> split { tt -> \ e ->
   transH (L.tact-irr Nl HS.1 J I f tt tt e (refl tt) (FM.alpha I (SC.M.mor I)))
    (transH (symH (NT.aNat I J f (SC.M.mor I))) (apH {CM.MO.Fn[F0, y].M J} {V1.Ix (HS.1.tob J tt)} (FM.alpha J) (SC.M.mor-nat I J f))) } } ;
 centre : C.El Nl HS = L.mkPEl Nl HS.1 ceob cnat ;
 module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
 -- Hom(F0, y) is contractible
 cF0 : C.El C.nil (EQ.isContr C.nil (CHomT3[a].HomP[R, encK, pe].Hom[F0, y].HomT)) = PPp.contrOfProp Nl HS pF centre ;
} ;
-- in 45's parameter form
cF0 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation)
  : C.El C.nil (EQ.isContr C.nil (CHomT3[a].HomP[R, encK, pe].Hom[CCst2[a].Cst[R, encK, pe].F0, y].HomT)) = F0Of[R, encK, pe, y].cF0 ;
module Plug (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module K3 = CCst3[a].Cst3[R, encK, pe].Fin[cF0 R encK pe] ;
 zero0 (X : CCst3[a].Cst3[R, encK, pe].CT.TC.TOb) : K3.KR[R.z].DSr.DG.Ob' X.1 X.2 = K3.KR[R.z].cstD X ;
} ;
