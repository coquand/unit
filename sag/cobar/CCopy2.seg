-- CCopy2.seg (canonicity-45; SIMPLIFIED.md step 6): a contraction
-- operation on the levelwise site G0 from one on each copy of the poset
-- site (CCopy), for C with constant objects.  A side at (I, y) restricts
-- to a side at I of the copy y (resS); the extension at (I, y) is the
-- copy's; its agreement with the side and its uniformity reduce, by path
-- induction on the presentation equation e : y' = y of a G0 map, to the
-- copy's (and Obj's set-ness for the double inverse of e).
-- Specific to this C (constant objects).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module Comp (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (G : CCopy[a].ConcC[R, encK, pe].P0.PCtx) (T : CCopy[a].ConcC[R, encK, pe].P0.PTy[G])
  (k : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].ContrOp (CCopy[a].ConcC[R, encK, pe].Copy[y].rCy G) (CCopy[a].ConcC[R, encK, pe].Copy[y].rTy G T)) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module G0 = CC.G0 ;
 module CP0 = G0.GB.CPartial[a+] ;
 module RL0 = CP0.Rel[G, T, T, CP0.pmap-id G T] ;
 module PS0 = RL0.PS' ;
 module TT0 = RL0.TT ;
 module Y (y : SX.Over[R].Presentation) {
  module Cy = CC.Copy[y] ;
  Gy : L.PCtx = Cy.rCy G ;
  Ty : L.PTy[Gy] = Cy.rTy G T ;
  module RLy = PB.CPartial[a+].Rel[Gy, Ty, Ty, PB.CPartial[a+].pmap-id Gy Ty] ;
  module PSy = RLy.PS' ;
  -- a G0 side at (I, y) restricted to the copy
  resS (I : Ob) (x : V1.Ix (G.ob (Cy.o0 I))) (s : PS0.Side[Cy.o0 I, x]) : PSy.Side[I, x] =
   PSy.mkSide I x s.pQ (\ J u i -> s.pv (Cy.o0 J) (Cy.h0 J I u) i) (\ J u i -> s.ppt (Cy.o0 J) (Cy.h0 J I u) i)
    (\ J' J chi u i i' -> s.pnat (Cy.o0 J') (Cy.o0 J) (Cy.h0 J' J chi) (Cy.h0 J I u) i i') ;
 } ;
 kop (X : G0.TOb) (x : V1.Ix (G.ob X)) (s : PS0.Side[X, x]) : V1.Ix (T.tob X x) = (k X.2).kop X.1 x (Y[X.2].resS X.1 x s) ;
 ObjT (J : Ob) : U a+ = V1.Ix (CC.CM.IC.obD J) ;
 module KS (X : G0.TOb) (x : V1.Ix (G.ob X)) (s : PS0.Side[X, x]) (W : G0.TOb) (f : G0.THm W X) (i : G0.GB.Lands W X s.pQ f) {
  Mot (y2 : ObjT W.1) (q : Id (ObjT W.1) X.2 y2) : U a++ =
   (i2 : G0.GB.Lands (W.1, y2) X s.pQ (f.1, symH q))
   -> Id (TT0.EI (W.1, y2)) (TT0.E.act (W.1, y2) X (f.1, symH q) (G0.GB.GPre[a+].PS.pairE G T X x (kop X x s))) (s.pv (W.1, y2) (f.1, symH q) i2) ;
  base : Mot X.2 (refl X.2) = \ i2 -> (k X.2).kside X.1 x (Y[X.2].resS X.1 x s) W.1 f.1 i2 ;
  gen : Mot W.2 (symH f.2) = idJ (ObjT W.1) X.2 Mot base W.2 (symH f.2) ;
  ss : Id (Id (ObjT W.1) W.2 X.2) (symH (symH f.2)) f.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 X.2 (symH (symH f.2)) f.2 ;
  law : Id (TT0.EI W) (TT0.E.act W X f (G0.GB.GPre[a+].PS.pairE G T X x (kop X x s))) (s.pv W f i) =
   subst (Id (ObjT W.1) W.2 X.2)
    (\ e2 -> (i2 : G0.GB.Lands W X s.pQ (f.1, e2)) -> Id (TT0.EI W) (TT0.E.act W X (f.1, e2) (G0.GB.GPre[a+].PS.pairE G T X x (kop X x s))) (s.pv W (f.1, e2) i2))
    (symH (symH f.2)) f.2 ss gen i ;
 } ;
 module KU (X : G0.TOb) (x : V1.Ix (G.ob X)) (s : PS0.Side[X, x]) (W : G0.TOb) (h : G0.THm W X) {
  module YY = Y[X.2] ;
  pr0 (Z : G0.TOb) (z : V1.Ix (G.ob Z)) (t : V1.Ix (T.tob Z z)) : TT0.EI Z = G0.GB.GPre[a+].PS.pairE G T Z z t ;
  -- at the copy: the restricted side of the restricted side
  module B (J : Ob) (u : Hom J X.1) {
   x' : V1.Ix (G.ob (YY.Cy.o0 J)) = G.act (YY.Cy.o0 J) X (YY.Cy.h0 J X.1 u) x ;
   s1 : YY.PSy.Side[J, x'] = YY.PSy.rside J X.1 u x (YY.resS X.1 x s) ;
   s2 : YY.PSy.Side[J, x'] = YY.resS J x' (PS0.rside (YY.Cy.o0 J) X (YY.Cy.h0 J X.1 u) x s) ;
   sEq : Id (YY.PSy.Side[J, x']) s1 s2 =
    YY.PSy.side-ext J x' s1 s2 (refl s1.pQ)
     (\ V g i i' -> PS0.pv-irr X x s (YY.Cy.o0 V) (YY.Cy.h0 V X.1 (compH V J X.1 u g))
        (PB.lands-pre V J X.1 u s.pQ g i) (G0.GB.lands-pre (YY.Cy.o0 V) (YY.Cy.o0 J) X (YY.Cy.h0 J X.1 u) s.pQ (YY.Cy.h0 V J g) i')) ;
   law : Id (TT0.EI (YY.Cy.o0 J)) (TT0.E.act (YY.Cy.o0 J) X (YY.Cy.h0 J X.1 u) (pr0 X x (kop X x s)))
          (pr0 (YY.Cy.o0 J) x' (kop (YY.Cy.o0 J) x' (PS0.rside (YY.Cy.o0 J) X (YY.Cy.h0 J X.1 u) x s))) =
    transH ((k X.2).kunif J X.1 u x (YY.resS X.1 x s))
     (YY.RLy.kop-cong (k X.2) J x' x' (refl x') s1 s2 sEq) ;
  } ;
  Mot (y2 : ObjT W.1) (q : Id (ObjT W.1) X.2 y2) : U a++ =
   Id (TT0.EI (W.1, y2)) (TT0.E.act (W.1, y2) X (h.1, symH q) (pr0 X x (kop X x s)))
    (pr0 (W.1, y2) (G.act (W.1, y2) X (h.1, symH q) x) (kop (W.1, y2) (G.act (W.1, y2) X (h.1, symH q) x) (PS0.rside (W.1, y2) X (h.1, symH q) x s))) ;
  gen : Mot W.2 (symH h.2) = idJ (ObjT W.1) X.2 Mot B[W.1, h.1].law W.2 (symH h.2) ;
  ss : Id (Id (ObjT W.1) W.2 X.2) (symH (symH h.2)) h.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 X.2 (symH (symH h.2)) h.2 ;
  law : Id (TT0.EI W) (TT0.E.act W X h (pr0 X x (kop X x s))) (pr0 W (G.act W X h x) (kop W (G.act W X h x) (PS0.rside W X h x s))) =
   subst (Id (ObjT W.1) W.2 X.2)
    (\ e2 -> Id (TT0.EI W) (TT0.E.act W X (h.1, e2) (pr0 X x (kop X x s)))
               (pr0 W (G.act W X (h.1, e2) x) (kop W (G.act W X (h.1, e2) x) (PS0.rside W X (h.1, e2) x s))))
    (symH (symH h.2)) h.2 ss gen ;
 } ;
 contr : CP0.ContrOp G T = RL0.mkRC kop (\ X x s W f i -> KS[X, x, s, W, f, i].law) (\ W X h x s -> KU[X, x, s, W, h].law) ;
} ;
