-- CCst3.seg (canonicity-45; COBAR.md "constants"): G's constants (4e's
-- ruling: Höfer's Construction 44/45 at arity 0).  D(yo F0) and D(1) are
-- fibrant (Lemma 12F at CCopy9[F0] and at a constant unit, levelwise), so
-- D(yo F0 -> 1)'s equivalence (CCst2) has a quasi-inverse (EqQinv); its
-- value p0 at tau of the terminal point is the point of D(yo F0).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module FC = FibCwF[a, a+].FC ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Cst3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module K2 = CCst2[a].Cst[R, encK, pe] ;
 module CC = K2.CC ;
 module CT = K2.CT ;
 module TR = K2.TR ;
 GP : TR.P1.PCtx = CT.P1 ;
 UG : TR.P0.PCtx = TR.RS.rC GP ;
 U1 : TR.P0.PTy[UG] = TR.RS.rT GP K2.OT.Y1T ;
 Nl : L.PCtx = C.nil ;
 -- U(1) is levelwise fibrant
 module Cp (y : SX.Over[R].Presentation) {
  module Cy = CC.Copy[y] ;
  D : L.PCtx = Cy.rCy UG ;
  A' : L.PTy[D] = Cy.rTy UG U1 ;
  module TA' = PB.GPre[a+].TyL[D, A'] ;
  module TA = PB.GPre[a+].TyL[Nl, K2.Ut.1] ;
  ta (W : Ob) (v : TA'.EI W) : TA.EI W = TA.pr W tt (TA'.pr2 W v) ;
  tainj (W : Ob) (v v' : TA'.EI W) (Pp : Id (V1.Ix (D.ob W)) (TA'.pr1 W v) (TA'.pr1 W v')) (Q : Id (TA.EI W) (ta W v) (ta W v')) : Id (TA'.EI W) v v' =
   transH (apH {V1.Ix (D.ob W)} {TA'.EI W} (\ o2 -> (o2, v.2)) Pp) (apH {V1.Ix (A'.tob W v'.1)} {TA'.EI W} (\ b -> (v'.1, b)) (isTop v.2 v'.2)) ;
  module CRT = PB.CCart[a+, a+].Cart[D, A', Nl, K2.Ut.1, \ W x -> tt, \ Vv W g d -> refl tt, ta, \ W v -> refl tt,
    \ Vv W g v -> refl (ta Vv (TA'.E.act Vv W g v)), tainj, \ X x u -> u, \ X x u -> refl (TA.pr X tt u)] ;
  fib : PB.CLine[a+].Lines[D, A'].Fib = CRT.moveFib K2.Ut.2 ;
 } ;
 fibG01 : TR.G0.GB.CLine[a+].Lines[UG, U1].Fib = CCopy5[a].FibC[R, encK, pe, UG, U1, \ y -> Cp[y].fib].fib ;
 module LF0 = CTotL12Fib2[a, a+, a+].L12F[K2.CM.IC, CT.T1, K2.O0.Y1T] ;
 module LF1 = CTotL12Fib2[a, a+, a+].L12F[K2.CM.IC, CT.T1, K2.OT.Y1T] ;
 fbD0 : TR.G1.GB.CLine[a+].Lines[CT.TC.toP LF0.D.DCtx, LF0.DA.DTy].Fib = LF0.lemma12F CCopy9[a].YoFF[R, encK, pe, K2.F0].fibG0 ;
 fbD1 : TR.G1.GB.CLine[a+].Lines[CT.TC.toP LF1.D.DCtx, LF1.DA.DTy].Fib = LF1.lemma12F fibG01 ;
 -- the quasi-inverse of D(yo F0 -> 1), and the point of D(yo F0)
 module Fin (cF0 : (y' : SX.Over[R].Presentation) -> C.El C.nil (EQ.isContr C.nil (K2.HP.Hom[K2.F0, y'].HomT))) {
  module F2 = K2.Fin[cF0] ;
  module P13 = F2.P13 ;
  module EQd = TR.G1.FT.GEqQinv[a+].EQP[P13.DF.DG, (P13.DF.DA.DTy, fbD0), (P13.DF.DB.DTy, fbD1), P13.DF.Df, F2.dF] ;
  module TA1 = CTotL14a[a, a+, a+].TauA[K2.CM.IC, CT.T1, K2.OT.Y1T] ;
  p0 (X : CT.TC.TOb) : P13.DF.DA.TOb' X.1 X.2 (P13.DF.D.tau X.1 X.2 tt) = EQd.EI.gN.nfun X (P13.DF.D.tau X.1 X.2 tt) (TA1.tauA X.1 X.2 tt tt) ;
  -- the constant r: D of yo(F1 -> F0, generator |-> cst r) at p0, read in D(yo F1)
  module FR = CSubst[a].Free[R] ;
  Y1 : K2.CM.TP.TCtx = K2.CM.Yo[FR.F1].yoT ;
  module DO = CobarI[a, a+, a+].DOfI[K2.CM.IC] ;
  module KR (r : R.R) {
   module SC = K2.CM.II.SubC[FR.F1, K2.F0, \ v -> cst r, \ pp m -> FR.noEq pp m _] ;
   module PRe = K2.CM.Pre[K2.F0, FR.F1, SC.M.mor, SC.M.mor-nat] ;
   module DSr = DO.DS[K2.Y0, Y1, PRe.preS] ;
   pt0 (X : CT.TC.TOb) : DSr.DD.Ob' X.1 X.2 = K2.O0.fw X (P13.DF.D.tau X.1 X.2 tt, p0 X) ;
   cstD (X : CT.TC.TOb) : DSr.DG.Ob' X.1 X.2 = DSr.dmap X.1 X.2 (pt0 X) ;
   -- naturality along total maps
   module NT (X' X : CT.TC.TOb) (h : CT.TC.THm X' X) {
    e1 : Id (P13.DF.D.Ob' X'.1 X'.2) (P13.DF.D.act X'.1 X.1 h.1 X'.2 X.2 h.2 (P13.DF.D.tau X.1 X.2 tt)) (P13.DF.D.tau X'.1 X'.2 tt) =
     symH (P13.DF.D.tau-nat X'.1 X.1 h.1 X'.2 X.2 h.2 tt) ;
    module TN = TA1.Nat[X'.1, X.1, h.1, X'.2, X.2, h.2, tt, tt] ;
    p0N : Id (P13.DF.DA.TOb' X'.1 X'.2 (P13.DF.D.tau X'.1 X'.2 tt))
           (P13.DF.DA.TB[X'.1, X.1, h.1, X'.2, X.2, h.2, P13.DF.D.tau X.1 X.2 tt, P13.DF.D.tau X'.1 X'.2 tt, e1, p0 X].res) (p0 X') =
     transH (EQd.EI.gN.nnat X' X h (P13.DF.D.tau X.1 X.2 tt) (P13.DF.D.tau X'.1 X'.2 tt) e1 (TA1.tauA X.1 X.2 tt tt))
      (apH {P13.DF.DB.TOb' X'.1 X'.2 (P13.DF.D.tau X'.1 X'.2 tt)} {P13.DF.DA.TOb' X'.1 X'.2 (P13.DF.D.tau X'.1 X'.2 tt)}
         (EQd.EI.gN.nfun X' (P13.DF.D.tau X'.1 X'.2 tt)) TN.law) ;
    module TYA = TR.G1.GB.GPre[a+].TyL[P13.DF.DG, P13.DF.DA.DTy] ;
    extN : Id (V1.Ix (TYA.E.ob X')) (TYA.E.act X' X h (P13.DF.D.tau X.1 X.2 tt, p0 X)) (P13.DF.D.tau X'.1 X'.2 tt, p0 X') =
     transH (TYA.pr-tact X' X h (P13.DF.D.tau X.1 X.2 tt) (P13.DF.D.tau X'.1 X'.2 tt) e1 (p0 X))
      (apH {P13.DF.DA.TOb' X'.1 X'.2 (P13.DF.D.tau X'.1 X'.2 tt)} {TYA.EI X'} (TYA.pr X' (P13.DF.D.tau X'.1 X'.2 tt)) p0N) ;
    ptN : Id (DSr.DD.Ob' X'.1 X'.2) (DSr.DD.act X'.1 X.1 h.1 X'.2 X.2 h.2 (pt0 X)) (pt0 X') =
     transH (symH (K2.O0.fwN X' X h (P13.DF.D.tau X.1 X.2 tt, p0 X)))
      (apH {V1.Ix (TYA.E.ob X')} {DSr.DD.Ob' X'.1 X'.2} (K2.O0.fw X') extN) ;
    law : Id (DSr.DG.Ob' X'.1 X'.2) (DSr.DG.act X'.1 X.1 h.1 X'.2 X.2 h.2 (cstD X)) (cstD X') =
     transH (symH (DSr.dmap-nat X'.1 X.1 h.1 X'.2 X.2 h.2 (pt0 X)))
      (apH {DSr.DD.Ob' X'.1 X'.2} {DSr.DG.Ob' X'.1 X'.2} (DSr.dmap X'.1 X'.2) ptN) ;
   } ;
  } ;
 } ;
} ;
