-- CUG26.seg (canonicity-c2; the generic (U), part 26 of CCmpU26's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU26 with
-- F2 replaced by s and the generator cases a hypothesis gen.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module UG26 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) (gen : (v : SX.Fin s.1) -> C.El (C.ext C.nil H) (CUG20[a].UG20[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN].IdZ (CHomT3[a].HomP[R, encK, pe].Alg[s].AX.cls (var v)))) {
 module U25m = CUG25[a].UG25[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN, gen] ;
 module T6 = U25m.T6 ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = U25m.GH ;
 QA : C.Ty Nl = U25m.QA ;
 QY : C.Ty Nl = U25m.QY ;
 QH : C.Ty GH = U25m.QH ;
 QYh : C.Ty GH = U25m.QYh ;
 E1 : C.Ctx = U25m.E1 ;
 FunT : C.Ty GH = U25m.FunT ;
 module Z (e : C.El GH U25m.MTh) {
  E : C.El GH T6.PiT = T6.TRd[e].E ;
  f : C.El GH FunT = OV.trE GH T6.PiT FunT U25m.Ppi E ;
  bE : C.El E1 T6.B' = OV.bod GH QH T6.B' E ;
  rd0 (c : C.El Nl QA) (K : Ob) (h : V1.Ix (H.1.tob K tt))
    : Id (V1.Ix (QY.1.tob K tt)) ((OV.app GH QH QYh f (OV.wkE Nl H QA c)).eob K (tt, h)) ((e.eob K (tt, h)).1 K (idH K) (c.eob K tt)) =
   transH (CCmpU1[a].AppG[GH, QH, QYh, f, OV.wkE Nl H QA c].rd K (tt, h))
    (transH (apH {C.El E1 (OV.wkT GH QH QYh)} {V1.Ix (QY.1.tob K tt)} (\ X -> X.eob K ((tt, h), c.eob K tt)) (CCmpU25[a].bodTr GH QH T6.B' (OV.wkT GH QH QYh) U25m.PB E))
      (transH (CAppRd[a].trE-rd E1 T6.B' (OV.wkT GH QH QYh) U25m.PB bE K ((tt, h), c.eob K tt))
        (transH (CAppRd[a].same-rd E1 T6.B' (OV.wkT GH QH QYh) U25m.PB K ((tt, h), c.eob K tt) (refl (QY.1.tob K tt)) (bE.eob K ((tt, h), c.eob K tt)))
          (transH (T6.BDP[E, K, h, c.eob K tt].bdR) (T6.TRd[e].R[K, h, c.eob K tt].rdE))))) ;
 } ;
} ;
