-- CCmpU1.seg (canonicity-c2; (K) for cmpI, part 1): reading test.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module U1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation)
 (io : (J : Ob) -> CPreI[a].PreOf[R, encK, pe].MO.Fn[CPreI[a].PreOf[R, encK, pe].CM.F1, CPreI[a].PreOf[R, encK, pe].CM.F2].M J)
  (io-nat : (J K : Ob) (v : Hom K J) -> Id (CPreI[a].PreOf[R, encK, pe].MO.Fn[CPreI[a].PreOf[R, encK, pe].CM.F1, CPreI[a].PreOf[R, encK, pe].CM.F2].M K) (CPreI[a].PreOf[R, encK, pe].MO.Fn[CPreI[a].PreOf[R, encK, pe].CM.F1, CPreI[a].PreOf[R, encK, pe].CM.F2].res J K v (io J)) (io K))
  (Phi : C.El C.nil (OV.Fun C.nil CPreI[a].PreOf[R, encK, pe].PI[CPreI[a].PreOf[R, encK, pe].CM.F2, CPreI[a].PreOf[R, encK, pe].CM.F1, io, io-nat, y].FM.P.H.AS.Qt CPreI[a].PreOf[R, encK, pe].PI[CPreI[a].PreOf[R, encK, pe].CM.F2, CPreI[a].PreOf[R, encK, pe].CM.F1, io, io-nat, y].TM.P.H.AS.Qt))
  (hP : (K : Ob) (v : V1.Ix (CPreI[a].PreOf[R, encK, pe].PI[CPreI[a].PreOf[R, encK, pe].CM.F2, CPreI[a].PreOf[R, encK, pe].CM.F1, io, io-nat, y].HS.1.tob K tt)) (u : V1.Ix (CPreI[a].PreOf[R, encK, pe].PI[CPreI[a].PreOf[R, encK, pe].CM.F2, CPreI[a].PreOf[R, encK, pe].CM.F1, io, io-nat, y].FM.P.H.AS.Qt.1.tob K tt))
     -> Id (V1.Ix (CPreI[a].PreOf[R, encK, pe].PI[CPreI[a].PreOf[R, encK, pe].CM.F2, CPreI[a].PreOf[R, encK, pe].CM.F1, io, io-nat, y].FM.P.H.AT.Qt.1.tob K tt)) ((CPreI[a].PreOf[R, encK, pe].PI[CPreI[a].PreOf[R, encK, pe].CM.F2, CPreI[a].PreOf[R, encK, pe].CM.F1, io, io-nat, y].nf K tt v).1.1 K (idH K) u) (v.1.1 K (idH K) ((Phi.eob K tt).1 K (idH K) u))) {
 module PO = CPreI[a].PreOf[R, encK, pe] ;
 module Q1 = PO.PI[PO.CM.F2, PO.CM.F1, io, io-nat, y] ;
 module CI = Q1 ;
 module HS1 = Q1.TM.P.H ;
 module HT1 = Q1.FM.P.H ;
 Nl : C.Ctx = C.nil ;
 Phi1 : C.El Nl (OV.Fun Nl HT1.AS.Qt HS1.AS.Qt) = Phi ;
 P1 (K : Ob) (v : V1.Ix (CI.HS.1.tob K tt)) : Id (V1.Ix (CI.HT.1.tob K tt)) ((Q1.preI.eob K tt).1 K (idH K) v) (Q1.nf K tt v) = refl (Q1.nf K tt v) ;
 P2 (K : Ob) (v : V1.Ix (CI.HS.1.tob K tt)) (u : V1.Ix (HT1.AS.Qt.1.tob K tt))
   : Id (V1.Ix (HT1.AT.Qt.1.tob K tt)) ((Q1.nf K tt v).1.1 K (idH K) u) (v.1.1 K (idH K) ((Phi1.eob K tt).1 K (idH K) u)) = hP K v u ;
 module At (z : C.El Nl CI.HS) (q : C.El Nl HT1.AS.Qt) {
  zp : C.El Nl CI.HT = OV.app Nl CI.HS CI.HT Q1.preI z ;
  lhs : C.El Nl HT1.AT.Qt = OV.app Nl HT1.AS.Qt HT1.AT.Qt (IN.fst Nl HT1.MapT HT1.DataT zp) q ;
  rhs : C.El Nl HT1.AT.Qt = OV.app Nl HS1.AS.Qt HS1.AT.Qt (IN.fst Nl HS1.MapT HS1.DataT z) (OV.app Nl HT1.AS.Qt HS1.AS.Qt Phi1 q) ;
  fz : C.El Nl HS1.MapT = IN.fst Nl HS1.MapT HS1.DataT z ;
  fzp : C.El Nl HT1.MapT = IN.fst Nl HT1.MapT HT1.DataT zp ;
  pq : C.El Nl HS1.AS.Qt = OV.app Nl HT1.AS.Qt HS1.AS.Qt Phi1 q ;
  L1 (K : Ob) : Id (V1.Ix (HT1.AT.Qt.1.tob K tt)) (lhs.eob K tt) ((fzp.eob K tt).1 K (idH K) (q.eob K tt)) =
   CAppRd[a].App0[HT1.AS.Qt, HT1.AT.Qt, fzp, q].rd K tt ;
  R1 (K : Ob) : Id (V1.Ix (HT1.AT.Qt.1.tob K tt)) (rhs.eob K tt) ((fz.eob K tt).1 K (idH K) (pq.eob K tt)) =
   CAppRd[a].App0[HS1.AS.Qt, HS1.AT.Qt, fz, pq].rd K tt ;
  R2 (K : Ob) : Id (V1.Ix (HS1.AS.Qt.1.tob K tt)) (pq.eob K tt) ((Phi1.eob K tt).1 K (idH K) (q.eob K tt)) =
   CAppRd[a].App0[HT1.AS.Qt, HS1.AS.Qt, Phi1, q].rd K tt ;
  F1 (K : Ob) : Id (V1.Ix (HT1.MapT.1.tob K tt)) (fzp.eob K tt) (zp.eob K tt).1 = refl (fzp.eob K tt) ;
  F2 (K : Ob) : Id (V1.Ix (HS1.MapT.1.tob K tt)) (fz.eob K tt) (z.eob K tt).1 = refl (fz.eob K tt) ;
  Z1 (K : Ob) : Id (V1.Ix (CI.HT.1.tob K tt)) (zp.eob K tt) ((Q1.preI.eob K tt).1 K (idH K) (z.eob K tt)) =
   CAppRd[a].App0[CI.HS, CI.HT, Q1.preI, z].rd K tt ;
  pt (K : Ob) : Id (V1.Ix (HT1.AT.Qt.1.tob K tt)) (lhs.eob K tt) (rhs.eob K tt) =
   transH (L1 K)
    (transH (apH {V1.Ix (CI.HT.1.tob K tt)} {V1.Ix (HT1.AT.Qt.1.tob K tt)} (\ w -> w.1.1 K (idH K) (q.eob K tt)) (Z1 K))
     (transH (P2 K (z.eob K tt) (q.eob K tt))
       (transH (apH {V1.Ix (HS1.AS.Qt.1.tob K tt)} {V1.Ix (HT1.AT.Qt.1.tob K tt)} (\ w -> (fz.eob K tt).1 K (idH K) w) (symH (R2 K)))
          (symH (R1 K))))) ;
  ptG (K : Ob) : (o : Top) -> Id (V1.Ix (HT1.AT.Qt.1.tob K o)) (lhs.eob K o) (rhs.eob K o) = split { tt -> pt K } ;
  -- THE READING LEMMA (closed): app (map (preI z)) q = app (map z) (Phi_1 q)
  read : Id (C.El Nl HT1.AT.Qt) lhs rhs = PosFull[a].PB.GPre[a+].PS.el-ext Nl HT1.AT.Qt.1 lhs rhs (\ K o -> ptG K o) ;
 } ;
} ;

-- the reading of an application over any context: bod f at (x , a x)
module AppG (G : C.Ctx) (A B : C.Ty G) (f : C.El G (OV.Fun G A B)) (e0 : C.El G A) {
 G1 : C.Ctx = C.ext G A ;
 Bw : C.Ty G1 = OV.wkT G A B ;
 sa : C.Sub G G1 = C.sec G A e0 ;
 rd (K : Ob) (x : V1.Ix (G.ob K)) : Id (V1.Ix (B.1.tob K x)) ((OV.app G A B f e0).eob K x) ((OV.bod G A Bw f).eob K (x, e0.eob K x)) =
  transH (CAppRd[a].trE-rd G (C.subT G G1 Bw sa) B (CAppRd[a].W.psT G A B e0) (C.subt G G1 Bw (OV.bod G A Bw f) sa) K x)
   (CAppRd[a].same-rd G (C.subT G G1 Bw sa) B (CAppRd[a].W.psT G A B e0) K x (refl (B.1.tob K x)) ((OV.bod G A Bw f).eob K (x, e0.eob K x))) ;
} ;
