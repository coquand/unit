-- CDIn7.seg (canonicity-c2; (d)(2), part 7): over nil.H, at a new generator
-- j of x.u: the j-th new values of the fwd images agree (CDIn4 with
-- CDIn5.NJ), read as the two homs at x.u's generator newI j (CDFw10.rdV).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module In7 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module K4 = CDIn4[a].In4[R, encK, pe, x, u, y] ;
 module K2 = K4.K4m ;
 module I5 = CDIn5[a].In5[R, encK, pe, x, u, y] ;
 module I1m = K4.I1m ;
 module F1 = I1m.F1 ;
 module F2m = CDFw2[a].Fw2[R, encK, pe, x, u, y] ;
 module F10 = CDFw10[a].Fw10[R, encK, pe, x, u, y] ;
 module U13m = K4.U13m ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = K4.GH ;
 QA : C.Ty Nl = K4.QA ;
 QYh : C.Ty GH = K4.QYh ;
 HU : C.Ty Nl = I1m.HU ;
 m : Nat = F1.m ;
 lkPv : (k : Nat) (K : Ob) (g : F2m.Fk k -> F1.EV.QK K) (j : SX.Fin k) -> Id (F1.EV.QK K) (I5.lkP k j K (F1.vt k K g)) (g (F2m.newI k j)) = split {
  zero -> \ K g j -> absurd (Id (F1.EV.QK K) (I5.lkP zero j K (F1.vt zero K g)) (g (F2m.newI zero j))) j ;
  suc k | r -> \ K g -> split {
   inl j -> r K (\ v -> g (inl v)) j ;
   inr t -> F1.DE.lkTT (Arith[a].plus k F2m.n) K g t } } ;
 cn (j : SX.Fin m) : C.El Nl QA = F1.DE.HZ.AS.AX.cls (var (F2m.newI m j)) ;
 lAt (j : SX.Fin m) (K : Ob) (z : V1.Ix (HU.1.tob K tt)) : Id (V1.Ix (K4.QY.1.tob K tt)) ((I5.NJ[j].m).nfun K tt (I1m.fwdN.nfun K tt z)) (U13m.BZ.hv K tt z.1 ((cn j).eob K tt)) =
  transH (apH {F1.S1.PK m K} {V1.Ix (K4.QY.1.tob K tt)} (\ v -> I5.lkP m j K v) (F10.rdV K z)) (lkPv m K (F1.DE.SO1.hval K z) j) ;
 lA (j : SX.Fin m) (K : Ob) : (o : Top) (h : V1.Ix (K2.H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) ((I5.NJ[j].m).nfun K o (I1m.fwdN.nfun K o (K2.pkA K (o, h)))) ((U13m.ZA.apC (cn j)).eob K (o, h)) =
  split { tt -> \ h -> transH (lAt j K h.1) (symH (U13m.ZA.rdF (cn j) K (tt, h))) } ;
 lB (j : SX.Fin m) (K : Ob) : (o : Top) (h : V1.Ix (K2.H.1.tob K o)) -> Id (V1.Ix (QYh.1.tob K (o, h))) ((I5.NJ[j].m).nfun K o (I1m.fwdN.nfun K o (K2.pkB K (o, h)))) ((U13m.ZB.apC (cn j)).eob K (o, h)) =
  split { tt -> \ h -> transH (lAt j K h.2.1) (symH (U13m.ZB.rdF (cn j) K (tt, h))) } ;
 newG (j : SX.Fin m) : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC (cn j)) (U13m.ZB.apC (cn j))) =
  K4.Cmp[I5.NJ[j].m, cn j, \ K w -> lA j K w.1 w.2, \ K w -> lB j K w.1 w.2].res ;
} ;
