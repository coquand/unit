-- CRestr.seg (canonicity-c2; SIMPLIFIED.md item 5): restriction of
-- presheaves along a functor F : Cs -> Ds of small categories, on the
-- contexts, substitutions, types and elements of the presheaf CwF
-- (Presheaf.Psh).  Everything is F's action precomposed; the laws use
-- F.onId and F.onComp, which are equalities of maps, through tact-cong.
-- Used with F the functor from the total category of the discrete
-- category on the objects of an internal category C to that of C (CDisc):
-- the "levelwise" reading U of a context or type.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module Restr (Cs Ds : SmallCat[a].SmallCat) (F : CChainsF[a].FunOf[Cs, Ds].SFun) {
 module P0 = Presheaf[a, l].Psh[Cs] ;
 module P1 = Presheaf[a, l].Psh[Ds] ;
 Ob0 : U a = SmallCat[a].Objs[Cs.obV].Ob ;
 Hom0 (J I : Ob0) : U a = SmallCat[a].Homs[Cs.obV, Cs.homV].Hom J I ;
 Ob1 : U a = SmallCat[a].Objs[Ds.obV].Ob ;
 Hom1 (J I : Ob1) : U a = SmallCat[a].Homs[Ds.obV, Ds.homV].Hom J I ;

 -- contexts
 rC (G : P1.PCtx) : P0.PCtx =
  new P0.PCtx[\ I -> G.ob (F.onO I), \ J I f x -> G.act (F.onO J) (F.onO I) (F.onH J I f) x,
   \ I x -> transH (apH {Hom1 (F.onO I) (F.onO I)} {W0.Ix (G.ob (F.onO I))} (\ m -> G.act (F.onO I) (F.onO I) m x) (F.onId I)) (G.act-id (F.onO I) x),
   \ K J I f g x -> transH (apH {Hom1 (F.onO K) (F.onO I)} {W0.Ix (G.ob (F.onO K))} (\ m -> G.act (F.onO K) (F.onO I) m x) (F.onComp K J I f g))
                      (G.act-o (F.onO K) (F.onO J) (F.onO I) (F.onH J I f) (F.onH K J g) x)] ;

 -- substitutions
 rS (D G : P1.PCtx) (s : P1.PSub[D, G]) : P0.PSub[rC D, rC G] =
  new P0.PSub[rC D, rC G, \ I x -> s.nt (F.onO I) x, \ J I f x -> s.nt-nat (F.onO J) (F.onO I) (F.onH J I f) x] ;

 -- the action of a type along equal maps
 tact-cong (G : P1.PCtx) (A : P1.PTy[G]) (J I : Ob1) (m m' : Hom1 J I) (p : Id (Hom1 J I) m m')
  (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I m x) y) (e' : Id (W0.Ix (G.ob J)) (G.act J I m' x) y)
  (v : W0.Ix (A.tob I x)) : Id (W0.Ix (A.tob J y)) (A.tact J I m x y e v) (A.tact J I m' x y e' v) =
  idJ (Hom1 J I) m
   (\ m2 p2 -> (e2 : Id (W0.Ix (G.ob J)) (G.act J I m2 x) y) -> Id (W0.Ix (A.tob J y)) (A.tact J I m x y e v) (A.tact J I m2 x y e2 v))
   (\ e2 -> P1.tact-irr G A J I m x y e e2 v) m' p e' ;

 -- types
 rT (G : P1.PCtx) (A : P1.PTy[G]) : P0.PTy[rC G] =
  new P0.PTy[rC G, \ I x -> A.tob (F.onO I) x,
   \ J I f x y e v -> A.tact (F.onO J) (F.onO I) (F.onH J I f) x y e v,
   \ I x e v -> transH (tact-cong G A (F.onO I) (F.onO I) (F.onH I I (Cs.idC I)) (Ds.idC (F.onO I)) (F.onId I) x x e
                          (transH (symH (apH {Hom1 (F.onO I) (F.onO I)} {W0.Ix (G.ob (F.onO I))} (\ m -> G.act (F.onO I) (F.onO I) m x) (F.onId I))) e) v)
                (A.tact-id (F.onO I) x (transH (symH (apH {Hom1 (F.onO I) (F.onO I)} {W0.Ix (G.ob (F.onO I))} (\ m -> G.act (F.onO I) (F.onO I) m x) (F.onId I))) e) v),
   \ K J I f g x y z e1 e2 e3 v ->
     transH (tact-cong G A (F.onO K) (F.onO I) (F.onH K I (Cs.oC K J I f g)) (Ds.oC (F.onO K) (F.onO J) (F.onO I) (F.onH J I f) (F.onH K J g)) (F.onComp K J I f g) x z e3
               (transH (symH (apH {Hom1 (F.onO K) (F.onO I)} {W0.Ix (G.ob (F.onO K))} (\ m -> G.act (F.onO K) (F.onO I) m x) (F.onComp K J I f g))) e3) v)
       (A.tact-o (F.onO K) (F.onO J) (F.onO I) (F.onH J I f) (F.onH K J g) x y z e1 e2
          (transH (symH (apH {Hom1 (F.onO K) (F.onO I)} {W0.Ix (G.ob (F.onO K))} (\ m -> G.act (F.onO K) (F.onO I) m x) (F.onComp K J I f g))) e3) v)] ;

 -- elements
 rE (G : P1.PCtx) (A : P1.PTy[G]) (t : P1.PEl[G, A]) : P0.PEl[rC G, rT G A] =
  P0.mkPEl (rC G) (rT G A) (\ I x -> t.eob (F.onO I) x) (\ J I f x y e -> t.enat (F.onO J) (F.onO I) (F.onH J I f) x y e) ;
} ;
