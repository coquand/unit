-- CEvCong.seg (canonicity-45; COBAR.md "Prop 58"): at the total site, G's
-- evaluation of a term s over variables V at input maps g_v : X -> G (over the
-- terminal context), and its congruence: homotopic inputs give homotopic values
-- (CApOp2G.Ap by recursion on s).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module EC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation) (Vr : U a) {
 module T1 = CE1Tot[a].T1[R, encK, pe, t] ;
 module HO1 = T1.HO1 ;
 module PS1 = T1.G1.GB.GPre[a+].PS ;
 P1 : PS1.PCtx = T1.P1 ;
 XT : PS1.PTy[P1] = T1.XT ;
 GT : PS1.PTy[P1] = T1.GT ;
 cT (r : R.R) : HO1.NMap[P1, XT, GT] = CE1Cst[a].CS[R, encK, pe, t, r].cT ;
 -- evaluation at input maps g
 Lg (g : Vr -> HO1.NMap[P1, XT, GT]) : SX.Over[R].Expr Vr -> HO1.NMap[P1, XT, GT] = split {
  var v -> g v ;
  cst r -> cT r ;
  sumE p q | lp lq -> T1.AddG.AO.OP lp lq ;
  mulE p q | lp lq -> T1.MulG.AO.OP lp lq } ;
 -- congruence
 module Cg (g g' : Vr -> HO1.NMap[P1, XT, GT])
   (H : (v : Vr) -> PS1.PEl[PS1.extP P1 XT, HO1.HT[P1, XT, GT, g v, g' v].PT.PathP]) {
  cg : (s : SX.Over[R].Expr Vr) -> PS1.PEl[PS1.extP P1 XT, HO1.HT[P1, XT, GT, Lg g s, Lg g' s].PT.PathP] = split {
   var v -> H v ;
   cst r -> HO1.Rf[P1, XT, GT, cT r].res ;
   sumE p q | rp rq -> T1.AddG.AO.Ap[Lg g p, Lg g' p, Lg g q, Lg g' q, rp, rq].res ;
   mulE p q | rp rq -> T1.MulG.AO.Ap[Lg g p, Lg g' p, Lg g q, Lg g' q, rp, rq].res } ;
 } ;
} ;

-- at the generators of t, Lg agrees pointwise with CE1TotAll's Lv
module EV (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation) {
 module E = EC[R, encK, pe, t, SX.Fin t.1] ;
 module TA = CE1TotAll[a].TA[R, encK, pe, t] ;
 g0 (v : SX.Fin t.1) : E.HO1.NMap[E.P1, E.XT, E.GT] = E.T1.Rs (var v) ;
 eq : (s : SX.Over[R].Der[t].Term) (X : E.T1.CT.TC.TOb) (o : V1.Ix (E.P1.ob X)) (c : V1.Ix (E.XT.tob X o))
   -> Id (V1.Ix (E.GT.tob X o)) ((TA.I.Lv s).nfun X o c) ((E.Lg g0 s).nfun X o c) = split {
  var v -> \ X o c -> refl ((g0 v).nfun X o c) ;
  cst r -> \ X o c -> refl ((E.cT r).nfun X o c) ;
  sumE p q | rp rq -> \ X o c -> transH (apH {V1.Ix (E.GT.tob X o)} {V1.Ix (E.GT.tob X o)} (\ w -> E.T1.AddG.opT X o w ((TA.I.Lv q).nfun X o c)) (rp X o c))
    (apH {V1.Ix (E.GT.tob X o)} {V1.Ix (E.GT.tob X o)} (E.T1.AddG.opT X o ((E.Lg g0 p).nfun X o c)) (rq X o c)) ;
  mulE p q | rp rq -> \ X o c -> transH (apH {V1.Ix (E.GT.tob X o)} {V1.Ix (E.GT.tob X o)} (\ w -> E.T1.MulG.opT X o w ((TA.I.Lv q).nfun X o c)) (rp X o c))
    (apH {V1.Ix (E.GT.tob X o)} {V1.Ix (E.GT.tob X o)} (E.T1.MulG.opT X o ((E.Lg g0 p).nfun X o c)) (rq X o c)) } ;
} ;
