-- CDIn2.seg (canonicity-c2; (d)(2), part 2): over nil.H, H the pairs of homs
-- x.u -> y with the same fwd image (CInjP at CDIn1.fwdN), the Id of the
-- images, and the hom projections for the generic (U) at x.u (as CCmpK4).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module L = PosFull[a].PB.GPre[a+].PS ;
module In2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module I1m = CDIn1[a].In1[R, encK, pe, x, u, y] ;
 F2 : SX.Over[R].Presentation = I1m.F1.xu ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = I1m.HU ;
 HTT : C.Ty Nl = I1m.T0 ;
 -- the pairs of homs with the same value at the generator (CInjP at nm)
 module IPm = CInjP[a].IP[HS, HTT, I1m.fwdN] ;
 evS (D : C.Ctx) (s0 : C.Sub D Nl) (g : C.El D (C.subT D Nl HS s0)) : C.El D (C.subT D Nl HTT s0) = IPm.evS D s0 g ;
 D1 : C.Ctx = IPm.D1 ;
 HSw : C.Ty D1 = IPm.Aw ;
 D2 : C.Ctx = IPm.D2 ;
 s2 : C.Sub D2 Nl = IPm.s2 ;
 PH2 : Id (C.Ty D2) (OV.wkT D1 HSw HSw) (C.subT D2 Nl HS s2) = IPm.PH2 ;
 u1 : C.El D2 (C.subT D2 Nl HS s2) = IPm.u1 ;
 u2 : C.El D2 (C.subT D2 Nl HS s2) = IPm.u2 ;
 IdZ : C.Ty D2 = IPm.IdZ ;
 H : C.Ty Nl = IPm.H ;
 GH : C.Ctx = IPm.GH ;
 -- the two homs of a point of nil.H
 pkA (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HS.1.tob K w.1) = w.2.1 ;
 pkB (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HS.1.tob K w.1) = w.2.2.1 ;
 pkAN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J (GH.act J I f w)) =
  refl (HS.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) ;
 pkBN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J (GH.act J I f w)) =
  L.tact-irr Nl HS.1 J I f w.1 w.1 (refl w.1)
   (L.ntEq D1 Nl (L.pP Nl HS.1) J I f (w.1, w.2.1) (Nl.act J I f w.1, HS.1.tact J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1)
      (L.pair-act Nl HS.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1))
   w.2.2.1 ;
 module U20m = CUG20[a].UG20[R, encK, pe, F2, y, H, pkA, pkB, pkAN, pkBN] ;
 module U13m = U20m.U13m ;
 -- the Id component as an Id between the evaluations
 sgN (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (D2.ob K) = ((w.1, w.2.1), w.2.2.1) ;
 sg : C.Sub GH D2 = new L.PSub[GH, D2, sgN, \ J I f w -> refl (sgN J (GH.act J I f w))] ;
 IdZs : C.Ty GH = C.subT GH D2 IdZ sg ;
 pIdN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I))
   : Id (V1.Ix (IdZs.1.tob J (GH.act J I f w))) (IdZs.1.tact J I f w (GH.act J I f w) (refl (GH.act J I f w)) w.2.2.2) (GH.act J I f w).2.2.2 =
  L.tact-irr D2 IdZ.1 J I f (sgN I w) (sgN J (GH.act J I f w))
    (L.ntEq GH D2 sg J I f w (GH.act J I f w) (refl (GH.act J I f w)))
    (L.pair-act D1 HSw.1 J I f (w.1, w.2.1) (Nl.act J I f w.1, HS.1.tact J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1)
       (L.pair-act Nl HS.1 J I f w.1 (Nl.act J I f w.1) (refl (Nl.act J I f w.1)) w.2.1) w.2.2.1)
    w.2.2.2 ;
 pId : C.El GH IdZs = L.mkPEl GH IdZs.1 (\ I w -> w.2.2.2) (\ J I f w w' e ->
  idJ (V1.Ix (GH.ob J)) (GH.act J I f w) (\ w2 e2 -> Id (V1.Ix (IdZs.1.tob J w2)) (IdZs.1.tact J I f w w2 e2 w.2.2.2) w2.2.2.2)
    (pIdN J I f w) w' e) ;
 HTTh : C.Ty GH = OV.wkT Nl H HTT ;
 QD2 : C.Ty D2 = C.subT D2 Nl HTT s2 ;
 PQ : Id (C.Ty GH) (C.subT GH D2 QD2 sg) HTTh =
  transH (symH (C.subT-o GH D2 Nl HTT s2 sg))
   (apH {C.Sub GH Nl} {C.Ty GH} (\ s -> C.subT GH Nl HTT s) (L.sub-ext GH Nl (C.o GH D2 Nl s2 sg) (C.p Nl H) (\ K w -> refl w.1))) ;
 i1 : C.El GH (IJ.IdT GH (C.subT GH D2 QD2 sg) (C.subt GH D2 QD2 (evS D2 s2 u1) sg) (C.subt GH D2 QD2 (evS D2 s2 u2) sg)) =
  OV.trE GH IdZs (IJ.IdT GH (C.subT GH D2 QD2 sg) (C.subt GH D2 QD2 (evS D2 s2 u1) sg) (C.subt GH D2 QD2 (evS D2 s2 u2) sg))
   (IJ.IdT-nat GH D2 QD2 (evS D2 s2 u1) (evS D2 s2 u2) sg) pId ;
 iA : C.El GH HTTh = OV.trE GH (C.subT GH D2 QD2 sg) HTTh PQ (C.subt GH D2 QD2 (evS D2 s2 u1) sg) ;
 iB : C.El GH HTTh = OV.trE GH (C.subT GH D2 QD2 sg) HTTh PQ (C.subt GH D2 QD2 (evS D2 s2 u2) sg) ;
 i2 : C.El GH (IJ.IdT GH HTTh iA iB) = CInjP[a].idFwdL GH (C.subT GH D2 QD2 sg) HTTh PQ (C.subt GH D2 QD2 (evS D2 s2 u1) sg) (C.subt GH D2 QD2 (evS D2 s2 u2) sg) i1 ;
} ;
