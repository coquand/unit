-- Ring laws for the concrete presented algebra A_x, with quotient
-- eliminators and set-ness supplied by the checked quotient package.
level a ;
open Base ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Laws (R : Ring[a].CRing) (encK : EN.Enc R.R)
  (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
  module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
  module Q3 = CwFQuotElim3[a].QE3[R, encK, x, pe] ;
  module L = CAlgLaws3[a].Laws3[R, encK, x, pe,
    Q1.setQ, Q1.setQi, Q3.elim2, Q3.elim2-beta, Q1.setW] ;
} ;
