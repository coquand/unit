-- CCodeH.seg (canonicity-45; COBAR.md "Prop 58"): two global codes a, b :
-- F1 -> t agreeing at the generator (an Id over nil.HomT, c2's (U) form)
-- give a path homotopy at the total site between tau . pre_a and tau . pre_b,
-- maps yo(t) -> G read over the terminal context: the line of codes (CLineC),
-- the homotopy of precompositions (CLinePre), whiskered with tau (CGRing).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module CH (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation)
  (ma : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mna : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (ma J)) (ma K))
  (mb : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mnb : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (mb J)) (mb K))
  (gen : FibCwF[a, a+].fibCwF.El (CLineC[a].EqC[R, encK, pe, t, ma, mna, mb, mnb].GH) (CLineC[a].EqC[R, encK, pe, t, ma, mna, mb, mnb].U20.IdZ CLineC[a].EqC[R, encK, pe, t, ma, mna, mb, mnb].cx)) {
 module EQ = CLineC[a].EqC[R, encK, pe, t, ma, mna, mb, mnb].At[gen] ;
 module PLm = CLinePre[a].PL[R, encK, pe, t, ma, mna, mb, mnb, EQ.lc, \ V W g j -> EQ.lcN V W g j, EQ.lc0, EQ.lc1] ;
 module GR = CGRing[a].GR[R, encK, pe] ;
 module C6 = GR.C6 ;
 module HO1 = PLm.HO1 ;
 tauN : HO1.NMap[PLm.CT.P1, PLm.Q1.Y1T, C6.GT] = C6.TN[C6.Y1, C6.Q1.DY.tauS].nm ;
 module W = HO1.WL[PLm.CT.P1, PLm.QT.Y1T, PLm.Q1.Y1T, C6.GT, PLm.mA, PLm.mB, tauN, PLm.res] ;
 -- tau . pre_a ~ tau . pre_b
 res : PLm.G1.GB.GPre[a+].PS.PEl[W.T'.GA, W.T'.PT.PathP] = W.res ;
} ;

-- the generator hypothesis of CH from a closed Id Ea = Eb in Q_t and the readings of
-- a's and b's families at the generator (at the terminal point)
module GenOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation)
  (ma : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mna : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (ma J)) (ma K))
  (mb : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mnb : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (mb J)) (mb K)) {
 module EQ0 = CLineC[a].EqC[R, encK, pe, t, ma, mna, mb, mnb] ;
 module U13 = EQ0.U20.U13m ;
 C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
 Nl : C.Ctx = C.nil ;
 QY : C.Ty Nl = U13.QY ;
 GH : C.Ctx = EQ0.GH ;
 module FF = CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t] ;
 -- a's family at the generator, at stage K
 fa (K : Ob) : V1.Ix (QY.1.tob K tt) = (ma K).1.1 K (idH K) (EQ0.cx.eob K tt) ;
 fb (K : Ob) : V1.Ix (QY.1.tob K tt) = (mb K).1.1 K (idH K) (EQ0.cx.eob K tt) ;
 module At (Ea Eb : C.El Nl QY) (E : C.El Nl (IJ.IdT Nl QY Ea Eb))
   (ra : (K : Ob) -> Id (V1.Ix (QY.1.tob K tt)) (Ea.eob K tt) (fa K)) (rb : (K : Ob) -> Id (V1.Ix (QY.1.tob K tt)) (Eb.eob K tt) (fb K)) {
  wid : C.El GH (IJ.IdT GH U13.QYh (OV.wkE Nl EQ0.HT QY Ea) (OV.wkE Nl EQ0.HT QY Eb)) =
   OV.trE GH (C.subT GH Nl (IJ.IdT Nl QY Ea Eb) (C.p Nl EQ0.HT)) (IJ.IdT GH U13.QYh (OV.wkE Nl EQ0.HT QY Ea) (OV.wkE Nl EQ0.HT QY Eb))
     (IJ.IdT-nat GH Nl QY Ea Eb (C.p Nl EQ0.HT)) (C.subt GH Nl (IJ.IdT Nl QY Ea Eb) E (C.p Nl EQ0.HT)) ;
  pxA (K : Ob) : (o : Top) (h : V1.Ix (EQ0.HT.1.tob K o)) -> Id (V1.Ix (U13.QYh.1.tob K (o, h))) ((OV.wkE Nl EQ0.HT QY Ea).eob K (o, h)) ((U13.ZA.apC EQ0.cx).eob K (o, h)) = split {
   tt -> \ h -> transH (ra K) (symH (U13.ZA.rdF EQ0.cx K (tt, h))) } ;
  pxB (K : Ob) : (o : Top) (h : V1.Ix (EQ0.HT.1.tob K o)) -> Id (V1.Ix (U13.QYh.1.tob K (o, h))) ((OV.wkE Nl EQ0.HT QY Eb).eob K (o, h)) ((U13.ZB.apC EQ0.cx).eob K (o, h)) = split {
   tt -> \ h -> transH (rb K) (symH (U13.ZB.rdF EQ0.cx K (tt, h))) } ;
  gen : C.El GH (EQ0.U20.IdZ EQ0.cx) =
   CCmpU14[a].rwId GH U13.QYh (OV.wkE Nl EQ0.HT QY Ea) (U13.ZA.apC EQ0.cx) (OV.wkE Nl EQ0.HT QY Eb) (U13.ZB.apC EQ0.cx)
    (\ K w -> pxA K w.1 w.2) (\ K w -> pxB K w.1 w.2) wid ;
  module H = CH[R, encK, pe, t, ma, mna, mb, mnb, gen] ;
 } ;
} ;
