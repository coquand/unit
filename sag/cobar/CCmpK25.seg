-- CCmpK25.seg (canonicity-c2; (K) for cmpI, part 25): the stage-1 motive
-- at the native base nil.Q_y (variable q1): B1 = Pi (g : HTT) (h1 : ev g_1
-- = q1). Fib (g), a proposition.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module K25 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K19m = CCmpK19[a].K19[R, encK, pe, y] ;
 module K12m = K19m.K12m ;
 module I = K12m.I ;
 Nl : C.Ctx = C.nil ;
 Q : C.Ty Nl = K19m.Q ;
 HTT : C.Ty Nl = K19m.HTT ;
 GB : C.Ctx = K12m.GB ;
 G1 : C.Ctx = K19m.G1 ;
 C1 : C.Ctx = K19m.C1 ;
 ev1C1 : C.El C1 K19m.QC1 = CInjP[a].IP[HTT, Q, K19m.K3m.m1].evS C1 K19m.sC1 K19m.gC1 ;
 H1 : C.Ty C1 = IJ.IdT C1 K19m.QC1 ev1C1 K19m.q2C1 ;
 Cc : C.Ctx = C.ext C1 H1 ;
 tgN (K : Ob) (w : V1.Ix (Cc.ob K)) : V1.Ix (GB.ob K) = (w.1.1.1, w.1.2) ;
 tgNat (J I : Ob) (f : Hom J I) (w : V1.Ix (Cc.ob I)) : Id (V1.Ix (GB.ob J)) (tgN J (Cc.act J I f w)) (GB.act J I f (tgN I w)) =
  apH {V1.Ix (HTT.1.tob J w.1.1.1)} {V1.Ix (GB.ob J)} (\ g -> (w.1.1.1, g))
   (L.tact-irr Nl HTT.1 J I f w.1.1.1 w.1.1.1 (L.ntEq G1 Nl K19m.s1G J I f w.1.1 (G1.act J I f w.1.1) (refl (G1.act J I f w.1.1))) (refl w.1.1.1) w.1.2) ;
 tg : C.Sub Cc GB = new L.PSub[Cc, GB, tgN, tgNat] ;
 F1 : C.Ty Cc = C.subT Cc GB I.Fib tg ;
 pF1 : C.El Cc (PU.isProp Cc F1) =
  OV.trE Cc (C.subT Cc GB (PU.isProp GB I.Fib) tg) (PU.isProp Cc F1) (PU.isProp-ov Cc GB I.Fib tg F1 (refl F1)) (C.subt Cc GB (PU.isProp GB I.Fib) K12m.K9m.pF tg) ;
 PiH1 : C.Ty C1 = FibCwF[a, a+].fibPi.Pi C1 H1 F1 ;
 B1 : C.Ty G1 = FibCwF[a, a+].fibPi.Pi G1 K19m.X2 PiH1 ;
 pB1 : C.El G1 (PU.isProp G1 B1) = PPp.piProp G1 K19m.X2 PiH1 (PPp.piProp C1 H1 F1 pF1) ;
} ;
