-- CAlgFun.seg (canonicity-45; SIMPLIFIED.md step 2b): the function
-- calculus over the terminal context used by the laws of A_x (CAlgLaw).  For
-- F1, F2 : Fun Qt Qt with Id (app F1 (cls t)) (app F2 (cls t)) for every
-- term t, Law1 gives Id (app F1 q) (app F2 q) for every q : El nil Qt, by
-- c2's elimination into propositions (CwFQuotElimP.elimP, elimP-el): the
-- predicate P over nil.Qt is the Id of the two sides at the variable, its
-- propositionality is the set-ness of Qt (weakened, a parameter), and its
-- proof at the classes is the law at constants packaged over the constant
-- Tm (CConstLam.pack), read along incS composed with a section (c2's
-- IS.atCls).  The laws in several variables follow
-- by iterating Law1 one variable at a time (CAlgX).
-- No new axioms beyond the named premises and the module parameters.

--   CW        the derived members of the CwF record, nameable (extS, p-sec-T, q-sec)
--   Comp      composition of function elements with its beta law
--   Ov1       the Ov calculus along the section of a global element
--   Fun1      the function with a given body and its beta law
-- No new axioms.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module FB = FibCwF[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FB.fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

-- the derived members of the CwF record that the statements need
module CW (C0 : CwF.CwF[a++]) {
 open C0 ;
 exS (D G : C0.Ctx) (A : C0.Ty G) (s : C0.Sub D G) (a : C0.El D (C0.subT D G A s)) : C0.Sub D (C0.ext G A) = extS D G A s a ;
 pst (G : C0.Ctx) (A B : C0.Ty G) (a : C0.El G A) : Id (C0.Ty G) (C0.subT G (C0.ext G A) (C0.subT (C0.ext G A) G B (C0.p G A)) (C0.sec G A a)) B = p-sec-T G A B a ;
 qsec (G : C0.Ctx) (A : C0.Ty G) (a : C0.El G A)
  : Id (C0.El G A) (subst (C0.Ty G) (C0.El G) (C0.subT G (C0.ext G A) (C0.subT (C0.ext G A) G A (C0.p G A)) (C0.sec G A a)) A (p-sec-T G A A a) (C0.subt G (C0.ext G A) (C0.subT (C0.ext G A) G A (C0.p G A)) (C0.q G A) (C0.sec G A a))) a =
  q-sec G A a ;
} ;
module W = CW[FibCwF[a, a+].fibCwF] ;

-- composition of function elements over the terminal context, with its
-- beta law (the body is app (wkF f) (app (wkF g) q); its value at x is read
-- through app-lam and the Ov calculus along the section of x)
module Comp (A B Cc : C.Ty C.nil) (f : C.El C.nil (OV.Fun C.nil B Cc)) (g : C.El C.nil (OV.Fun C.nil A B)) {
 Nl : C.Ctx = C.nil ;
 GA : C.Ctx = C.ext Nl A ;
 Aw : C.Ty GA = OV.wkT Nl A A ;
 Bw : C.Ty GA = OV.wkT Nl A B ;
 Cw : C.Ty GA = OV.wkT Nl A Cc ;
 body : C.El GA Cw = OV.app GA Bw Cw (EQ.wkF Nl A B Cc f) (OV.app GA Aw Bw (EQ.wkF Nl A A B g) (C.q Nl A)) ;
 compF : C.El Nl (OV.Fun Nl A Cc) = OV.lam Nl A Cw body ;
 -- the Ov facts along the section of x
 PFg (x : C.El Nl A) : Id (C.Ty Nl) (C.subT Nl GA (OV.Fun GA Aw Bw) (C.sec Nl A x)) (OV.Fun Nl A B) =
  OV.Fun-ov Nl GA Aw Bw (C.sec Nl A x) A (W.pst Nl A A x) B (W.pst Nl A B x) ;
 PFf (x : C.El Nl A) : Id (C.Ty Nl) (C.subT Nl GA (OV.Fun GA Bw Cw) (C.sec Nl A x)) (OV.Fun Nl B Cc) =
  OV.Fun-ov Nl GA Bw Cw (C.sec Nl A x) B (W.pst Nl A B x) Cc (W.pst Nl A Cc x) ;
 ovg (x : C.El Nl A) : OV.Ov Nl GA (OV.Fun GA Aw Bw) (C.sec Nl A x) (OV.Fun Nl A B) (PFg x) (EQ.wkF Nl A A B g) g =
  OV.ovTr Nl GA (OV.wkT Nl A (OV.Fun Nl A B)) (OV.Fun GA Aw Bw) (EQ.wkFP Nl A A B) (C.sec Nl A x) (OV.Fun Nl A B) (OV.Fun Nl A B) (refl (OV.Fun Nl A B))
   (W.pst Nl A (OV.Fun Nl A B) x) (PFg x) (OV.wkE Nl A (OV.Fun Nl A B) g) g (IN.wkE-sec Nl A (OV.Fun Nl A B) x g (W.pst Nl A (OV.Fun Nl A B) x)) ;
 ovf (x : C.El Nl A) : OV.Ov Nl GA (OV.Fun GA Bw Cw) (C.sec Nl A x) (OV.Fun Nl B Cc) (PFf x) (EQ.wkF Nl A B Cc f) f =
  OV.ovTr Nl GA (OV.wkT Nl A (OV.Fun Nl B Cc)) (OV.Fun GA Bw Cw) (EQ.wkFP Nl A B Cc) (C.sec Nl A x) (OV.Fun Nl B Cc) (OV.Fun Nl B Cc) (refl (OV.Fun Nl B Cc))
   (W.pst Nl A (OV.Fun Nl B Cc) x) (PFf x) (OV.wkE Nl A (OV.Fun Nl B Cc) f) f (IN.wkE-sec Nl A (OV.Fun Nl B Cc) x f (W.pst Nl A (OV.Fun Nl B Cc) x)) ;
 ovq (x : C.El Nl A) : OV.Ov Nl GA Aw (C.sec Nl A x) A (W.pst Nl A A x) (C.q Nl A) x = W.qsec Nl A x ;
 ovgx (x : C.El Nl A) : OV.Ov Nl GA Bw (C.sec Nl A x) B (W.pst Nl A B x) (OV.app GA Aw Bw (EQ.wkF Nl A A B g) (C.q Nl A)) (OV.app Nl A B g x) =
  OV.app-ov Nl GA Aw Bw (C.sec Nl A x) A (W.pst Nl A A x) B (W.pst Nl A B x) (PFg x) (EQ.wkF Nl A A B g) g (ovg x) (C.q Nl A) x (ovq x) ;
 ovbody (x : C.El Nl A) : OV.Ov Nl GA Cw (C.sec Nl A x) Cc (W.pst Nl A Cc x) body (OV.app Nl B Cc f (OV.app Nl A B g x)) =
  OV.app-ov Nl GA Bw Cw (C.sec Nl A x) B (W.pst Nl A B x) Cc (W.pst Nl A Cc x) (PFf x) (EQ.wkF Nl A B Cc f) f (ovf x) (OV.app GA Aw Bw (EQ.wkF Nl A A B g) (C.q Nl A)) (OV.app Nl A B g x) (ovgx x) ;
 app-compF (x : C.El Nl A) : Id (C.El Nl Cc) (OV.app Nl A Cc compF x) (OV.app Nl B Cc f (OV.app Nl A B g x)) =
  transH (IN.app-lam Nl A Cc body x) (ovbody x) ;
} ;

-- the Ov calculus along the section of a global element x : El nil A,
-- for bodies over nil.A built from weakened globals, the variable and
-- applications; and the function with such a body, with its beta law
-- a body of a weakened function type over nil.A, read as a function of the
-- weakened types (along Fun-ov, EQ.wkFP)
toFun (A B1 B2 : C.Ty C.nil) (g : C.El (C.ext C.nil A) (OV.wkT C.nil A (OV.Fun C.nil B1 B2))) : C.El (C.ext C.nil A) (OV.Fun (C.ext C.nil A) (OV.wkT C.nil A B1) (OV.wkT C.nil A B2)) =
 OV.trE (C.ext C.nil A) (OV.wkT C.nil A (OV.Fun C.nil B1 B2)) (OV.Fun (C.ext C.nil A) (OV.wkT C.nil A B1) (OV.wkT C.nil A B2)) (EQ.wkFP C.nil A B1 B2) g ;

module Ov1 (A : C.Ty C.nil) (x : C.El C.nil A) {
 Nl : C.Ctx = C.nil ;
 GA : C.Ctx = C.ext Nl A ;
 sx : C.Sub Nl GA = C.sec Nl A x ;
 W1 (B : C.Ty Nl) : C.Ty GA = OV.wkT Nl A B ;
 PT (B : C.Ty Nl) : Id (C.Ty Nl) (C.subT Nl GA (W1 B) sx) B = W.pst Nl A B x ;
 OvB (B : C.Ty Nl) (b : C.El GA (W1 B)) (b0 : C.El Nl B) : U a++ = OV.Ov Nl GA (W1 B) sx B (PT B) b b0 ;
 -- a weakened global element
 ovGl (B : C.Ty Nl) (e : C.El Nl B) : OvB B (OV.wkE Nl A B e) e = IN.wkE-sec Nl A B x e (PT B) ;
 opaque ovGl ;
 -- the variable
 ovVar : OvB A (C.q Nl A) x = W.qsec Nl A x ;
 opaque ovVar ;
 -- a weakened global function (wkF), read as a function of the weakened types
 PF (B1 B2 : C.Ty Nl) : Id (C.Ty Nl) (C.subT Nl GA (OV.Fun GA (W1 B1) (W1 B2)) sx) (OV.Fun Nl B1 B2) = OV.Fun-ov Nl GA (W1 B1) (W1 B2) sx B1 (PT B1) B2 (PT B2) ;
 ovFun (B1 B2 : C.Ty Nl) (F : C.El Nl (OV.Fun Nl B1 B2)) : OV.Ov Nl GA (OV.Fun GA (W1 B1) (W1 B2)) sx (OV.Fun Nl B1 B2) (PF B1 B2) (EQ.wkF Nl A B1 B2 F) F =
  OV.ovTr Nl GA (OV.wkT Nl A (OV.Fun Nl B1 B2)) (OV.Fun GA (W1 B1) (W1 B2)) (EQ.wkFP Nl A B1 B2) sx (OV.Fun Nl B1 B2) (OV.Fun Nl B1 B2) (refl (OV.Fun Nl B1 B2))
   (PT (OV.Fun Nl B1 B2)) (PF B1 B2) (OV.wkE Nl A (OV.Fun Nl B1 B2) F) F (IN.wkE-sec Nl A (OV.Fun Nl B1 B2) x F (PT (OV.Fun Nl B1 B2))) ;
 opaque ovFun ;
 -- an application
 ovApp (B1 B2 : C.Ty Nl) (f : C.El GA (OV.Fun GA (W1 B1) (W1 B2))) (f0 : C.El Nl (OV.Fun Nl B1 B2)) (of : OV.Ov Nl GA (OV.Fun GA (W1 B1) (W1 B2)) sx (OV.Fun Nl B1 B2) (PF B1 B2) f f0)
  (b : C.El GA (W1 B1)) (b0 : C.El Nl B1) (ob : OvB B1 b b0) : OvB B2 (OV.app GA (W1 B1) (W1 B2) f b) (OV.app Nl B1 B2 f0 b0) =
  OV.app-ov Nl GA (W1 B1) (W1 B2) sx B1 (PT B1) B2 (PT B2) (PF B1 B2) f f0 of b b0 ob ;
 opaque ovApp ;
 -- a body of a weakened function type, read as a function of the weakened types (toFun)
 ovToFun (B1 B2 : C.Ty Nl) (g : C.El GA (W1 (OV.Fun Nl B1 B2))) (g0 : C.El Nl (OV.Fun Nl B1 B2)) (og : OvB (OV.Fun Nl B1 B2) g g0)
  : OV.Ov Nl GA (OV.Fun GA (W1 B1) (W1 B2)) sx (OV.Fun Nl B1 B2) (PF B1 B2) (toFun A B1 B2 g) g0 =
  OV.ovTr Nl GA (W1 (OV.Fun Nl B1 B2)) (OV.Fun GA (W1 B1) (W1 B2)) (EQ.wkFP Nl A B1 B2) sx (OV.Fun Nl B1 B2) (OV.Fun Nl B1 B2) (refl (OV.Fun Nl B1 B2))
   (PT (OV.Fun Nl B1 B2)) (PF B1 B2) g g0 og ;
 opaque ovToFun ;
 -- a global function applied to a body
 ovAp (B1 B2 : C.Ty Nl) (F : C.El Nl (OV.Fun Nl B1 B2)) (b : C.El GA (W1 B1)) (b0 : C.El Nl B1) (ob : OvB B1 b b0)
  : OvB B2 (OV.app GA (W1 B1) (W1 B2) (EQ.wkF Nl A B1 B2 F) b) (OV.app Nl B1 B2 F b0) =
  ovApp B1 B2 (EQ.wkF Nl A B1 B2 F) F (ovFun B1 B2 F) b b0 ob ;
 opaque ovAp ;
} ;
-- the function with a given body over nil.A, and its beta law from the
-- Ov of the body at every global element
module Fun1 (A B : C.Ty C.nil) (body : C.El (C.ext C.nil A) (OV.wkT C.nil A B)) (val : C.El C.nil A -> C.El C.nil B)
 (ovB : (x : C.El C.nil A) -> Ov1[A, x].OvB B body (val x)) {
 Nl : C.Ctx = C.nil ;
 F : C.El Nl (OV.Fun Nl A B) = OV.lam Nl A (OV.wkT Nl A B) body ;
 beta (x : C.El Nl A) : Id (C.El Nl B) (OV.app Nl A B F x) (val x) = transH (IN.app-lam Nl A B body x) (ovB x) ;
} ;

