-- CEvT.seg (canonicity-45; SIMPLIFIED.md step 6, (d)): evaluation of a
-- metatheory term in k variables in a closed algebra Qt (operations addO,
-- mulO, constants cO), as a semantic element over the valuation context
-- Gk = nil.Qt^k (by recursion on k, Qt weakened along eps, so every fibre
-- is Qt's at tt): ev t is defined by metatheory recursion on t (variables
-- are projections, the operations are CSemOp's two-variable readings at
-- the identity), natural by induction on t.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module EvOf (R : Ring[a].CRing) (Qt : C.Ty C.nil) (addO mulO : C.El C.nil (OV.Fun C.nil Qt (OV.Fun C.nil Qt Qt))) (cO : R.R -> C.El C.nil Qt) {
 Nl : C.Ctx = C.nil ;
 QK (K : Ob) : U a+ = V1.Ix (Qt.1.tob K tt) ;
 module SA = CSemOp[a].SemOp[Qt, addO] ;
 module SM = CSemOp[a].SemOp[Qt, mulO] ;
 -- the valuation contexts
 Gk : Nat -> C.Ctx = split { zero -> Nl ; suc k | r -> C.ext r (C.subT r Nl Qt (C.eps r)) } ;
 -- the variables
 lk : (k : Nat) -> SX.Fin k -> (K : Ob) -> V1.Ix ((Gk k).ob K) -> QK K = split {
  zero -> \ v -> absurd ((K : Ob) -> V1.Ix ((Gk zero).ob K) -> QK K) v ;
  suc k | r -> split { inl v -> \ K x -> r v K x.1 ; inr w -> \ K x -> x.2 } } ;
 -- the value of a term at a point
 ev (k : Nat) : SX.Over[R].Expr (SX.Fin k) -> (K : Ob) -> V1.Ix ((Gk k).ob K) -> QK K = split {
  var v -> \ K x -> lk k v K x ;
  cst r -> \ K x -> (cO r).eob K tt ;
  sumE p q | rp rq -> \ K x -> SA.ev2 K tt (rp K x) (rq K x) ;
  mulE p q | rp rq -> \ K x -> SM.ev2 K tt (rp K x) (rq K x) } ;
 -- naturality (restriction at the canonical point equation)
 rsQ (J I : Ob) (f : Hom J I) (v : QK I) : QK J = Qt.1.tact J I f tt tt (refl tt) v ;
 Qk (k : Nat) : C.Ty (Gk k) = C.subT (Gk k) Nl Qt (C.eps (Gk k)) ;
 lkNat : (k : Nat) (v : SX.Fin k) (J I : Ob) (f : Hom J I) (x : V1.Ix ((Gk k).ob I)) -> Id (QK J) (rsQ J I f (lk k v I x)) (lk k v J ((Gk k).act J I f x)) = split {
  zero -> \ v -> absurd ((J I : Ob) (f : Hom J I) (x : V1.Ix ((Gk zero).ob I)) -> Id (QK J) (rsQ J I f (lk zero v I x)) (lk zero v J ((Gk zero).act J I f x))) v ;
  suc k | r -> split {
   inl v -> \ J I f x -> r v J I f x.1 ;
   inr w -> \ J I f x -> L.tact-irr Nl Qt.1 J I f tt tt (refl tt) (L.ntEq (Gk k) Nl (C.eps (Gk k)) J I f x.1 ((Gk k).act J I f x.1) (refl ((Gk k).act J I f x.1))) x.2 } } ;
 evNat (k : Nat) : (t : SX.Over[R].Expr (SX.Fin k)) (J I : Ob) (f : Hom J I) (x : V1.Ix ((Gk k).ob I)) -> Id (QK J) (rsQ J I f (ev k t I x)) (ev k t J ((Gk k).act J I f x)) = split {
  var v -> \ J I f x -> lkNat k v J I f x ;
  cst r -> \ J I f x -> (cO r).enat J I f tt tt (refl tt) ;
  sumE p q | rp rq -> \ J I f x -> transH (SA.NT[I, J, f, tt, ev k p I x, ev k q I x].law)
    (transH (apH {QK J} {QK J} (\ z -> SA.ev2 J tt z (rsQ J I f (ev k q I x))) (rp J I f x))
       (apH {QK J} {QK J} (\ z -> SA.ev2 J tt (ev k p J ((Gk k).act J I f x)) z) (rq J I f x))) ;
  mulE p q | rp rq -> \ J I f x -> transH (SM.NT[I, J, f, tt, ev k p I x, ev k q I x].law)
    (transH (apH {QK J} {QK J} (\ z -> SM.ev2 J tt z (rsQ J I f (ev k q I x))) (rp J I f x))
       (apH {QK J} {QK J} (\ z -> SM.ev2 J tt (ev k p J ((Gk k).act J I f x)) z) (rq J I f x))) } ;
 enat (k : Nat) (t : SX.Over[R].Expr (SX.Fin k)) (J I : Ob) (f : Hom J I) (x : V1.Ix ((Gk k).ob I)) (y : V1.Ix ((Gk k).ob J))
   (e : Id (V1.Ix ((Gk k).ob J)) ((Gk k).act J I f x) y) : Id (QK J) ((Qk k).1.tact J I f x y e (ev k t I x)) (ev k t J y) =
  transH (L.tact-irr Nl Qt.1 J I f tt tt (L.ntEq (Gk k) Nl (C.eps (Gk k)) J I f x y e) (refl tt) (ev k t I x))
   (transH (evNat k t J I f x) (apH {V1.Ix ((Gk k).ob J)} {QK J} (ev k t J) e)) ;
 evE (k : Nat) (t : SX.Over[R].Expr (SX.Fin k)) : C.El (Gk k) (Qk k) = new L.PEl[Gk k, (Qk k).1, ev k t, enat k t] ;
} ;
