-- The homotopy inverse of D applied to the F3 comparison, conditional on
-- its levelwise equivalence.  Fibrancy uses the discrete levelwise site.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Inv (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (eq : CF3DComp[a].D3[R, encK, pe].LevelEq) {
  module B = CF3DComp[a].D3[R, encK, pe] ;
  module C3 = B.C3 ;
  module P13 = B.P13 ;
  module G1 = P13.G1 ;
  module P = C3.TR.P1 ;
  module O3 = C3.O3 ;
  module O111 = C3.O111 ;
  module LF3 = CTotL12Fib2[a, a+, a+].L12F[C3.CM.IC, C3.CT.T1, O3.Y1T] ;
  module LF111 = CTotL12Fib2[a, a+, a+].L12F[C3.CM.IC, C3.CT.T1, O111.Y1T] ;
  fbD3 : G1.GB.CLine[a+].Lines[C3.CT.TC.toP LF3.D.DCtx, LF3.DA.DTy].Fib =
    LF3.lemma12F CCopy9[a].YoFF[R, encK, pe, C3.FC.F.F3].fibG0 ;
  fbD111 : G1.GB.CLine[a+].Lines[C3.CT.TC.toP LF111.D.DCtx, LF111.DA.DTy].Fib =
    LF111.lemma12F CF3Fib[a].F111[R, encK, pe].fibG0 ;
  module EQ = G1.FT.GEqQinv[a+].EQP[P13.DF.DG,
    (P13.DF.DA.DTy, fbD3), (P13.DF.DB.DTy, fbD111), P13.DF.Df, B.At[eq].dcmp] ;
  ip : G1.GB.CPartial[a+].PMap[P13.DF.DG, P13.DF.DB.DTy, P13.DF.DA.DTy] =
    G1.FT.GCLocBoundRetr[a+].Map[P13.DF.DG, P13.DF.DB.DTy, P13.DF.DA.DTy, EQ.EI.gN].pmap ;
  invE : P.PSub[O111.PR.Ext, O3.PR.Ext] =
    new P.PSub[O111.PR.Ext, O3.PR.Ext, \ X w -> ip.mE X w, \ Y X h w -> ip.mnat Y X h w] ;
  invP : P.PSub[O111.DYP, O3.DYP] =
    new P.PSub[O111.DYP, O3.DYP, \ X d -> O3.fwS.nt X (invE.nt X (O111.bkS.nt X d)),
      \ Y X h d -> transH (apH {V1.Ix (O3.PR.Ext.ob Y)} {V1.Ix (O3.DYP.ob Y)} (O3.fwS.nt Y)
        (transH (apH {V1.Ix (O111.PR.Ext.ob Y)} {V1.Ix (O3.PR.Ext.ob Y)} (invE.nt Y) (O111.bkS.nt-nat Y X h d))
          (invE.nt-nat Y X h (O111.bkS.nt X d))))
        (O3.fwS.nt-nat Y X h (invE.nt X (O111.bkS.nt X d)))] ;
  inv : C3.CM.TP.TSub[O111.DY.DCtx, O3.DY.DCtx] =
    new C3.CM.TP.TSub[O111.DY.DCtx, O3.DY.DCtx,
      \ I x d -> invP.nt (I, x) d,
      \ J I u y x f d -> invP.nt-nat (J, y) (I, x) (u, f) d] ;
} ;
