-- CTotL14h.seg (canonicity-45; SIMPLIFIED.md step 4): Lemma 14 at the
-- total site: for A with a levelwise fibration structure of U A over U G
-- (at GrothOf[disc]), U tau_A has a quasi-inverse at the levelwise site.
-- The fibration structure of D A over D G at the total site that
-- CTotL14g.lemma14 takes is c2's Lemma 12, fibration half
-- (CTotL12Fib2.L12F.lemma12F).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;

module L14 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LG = CTotL14g[a, vl, l].L14g[C, G, A] ;
 module LF = CTotL12Fib2[a, vl, l].L12F[C, G, A] ;
 lemma14 (fb : LG.TR.G0.GB.CLine[l].Lines[LG.TR.RS.rC (LG.TC.toP G), LG.TR.RS.rT (LG.TC.toP G) A].Fib) : LG.QInv =
  LG.lemma14 (LF.lemma12F fb) ;
} ;
