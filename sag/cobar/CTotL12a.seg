-- CTotL12a.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half: D of a levelwise trivial fibration is a
-- trivial fibration.  A port of canonicity-45's Lemma12.seg (poset base,
-- external C) to the total site of an internal category.
-- Part a: the fixed data (a point gm of D G at X = (I, x) and a side s of
-- D A over it) and the statement of the levels:
--   Vt n    values v J u z c i in A at (J, z) over gm's point at the index
--   P1t     naturality along the base maps (cartesian restriction)
--   P2t     extension of s: at the index moved along a total map f in
--           s's sieve, the value is s's
--   P3t     faces
--   Up n    the levels up to n
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module L12T (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module P = Presheaf[vl, l].Psh[TC.TotCat] ;
 module VT = CVert[a, vl].VertOf[C] ;
 module DO = CobarI[a, vl, l].DOfI[C] ;
 module D = DO.DC[G] ;
 module DA = CobarIT[a, vl, l].DTI[C, G, A] ;
 module L1 = Lemma12I[a, vl, l].L12I[C, G, A] ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 DG : P.PCtx = TC.toP D.DCtx ;
 module CP1 = G1.GB.CPartial[l] ;
 module PD = CP1.Partials[DG, DA.DTy] ;

 module Fx (X : TC.TOb) (gm : W0.Ix (DG.ob X)) (s : PD.Side[X, gm]) {
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  Ch (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) : U vl = DO.KJ[J].K.Ch n (C.res J I u x) z ;
  -- s along f, and its point
  sv (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) : P.SigT DG DA.DTy W = s.pv W f lf ;
  sp (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) : Id (W0.Ix (DG.ob W)) (sv W f lf).1 (DG.act W X f gm) = s.ppt W f lf ;
  -- the reading of s at an index, in the total space of A
  rd (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) (q : DO.Idx W.1 W.2) (lq : DO.LandsI W.1 W.2 q) : DA.Ez q.2.1 q.2.2.2.1 =
   DA.prz q.2.1 q.2.2.2.1 ((sv W f lf).1.1 q lq) ((sv W f lf).2.1 q lq) ;
  -- a point of gm
  gpt (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : Ch n J u z) (i : Wt.Pn n J) : W0.Ix (G.ob J z) = gm.1 (n, J, u, z, c, i.1) i.2 ;

  Vt (n : Nat) : U l = (J : Ob) (u : Hom J I) (z : Obj J) (c : Ch n J u z) (i : Wt.Pn n J) -> W0.Ix (A.tob (J, z) (gpt n J u z c i)) ;
  pzv (n : Nat) (v : Vt n) (J : Ob) (u : Hom J I) (z : Obj J) (c : Ch n J u z) (i : Wt.Pn n J) : DA.Ez J z =
   DA.prz J z (gpt n J u z c i) (v J u z c i) ;
  P1t (n : Nat) (v : Vt n) : U l =
   (J : Ob) (u : Hom J I) (z : Obj J) (c : Ch n J u z) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J)
   -> Id (DA.Ez J' (C.res J' J h z)) (DA.E.act (J', C.res J' J h z) (J, z) (h, C.cart J' J h z) (pzv n v J u z c i))
         (pzv n v J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res)) ;
  P2t (n : Nat) (v : Vt n) : U l =
   (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) (J : Ob) (u' : Hom J W.1) (z : Obj J)
   (c : DO.KJ[J].K.Ch n (C.res J W.1 u' W.2) z) (i : Wt.Pn n J)
   -> Id (DA.Ez J z)
        (pzv n v J (D.Act[W.1, I, f.1, W.2, x, f.2, gm].rq (n, J, u', z, c, i.1)).2.2.1 z
           (D.Act[W.1, I, f.1, W.2, x, f.2, gm].rq (n, J, u', z, c, i.1)).2.2.2.2.1 i)
        (rd W f lf (n, J, u', z, c, i.1) i.2) ;
  P3t (m : Nat) (v' : Vt (suc m)) (v : Vt m) : U l =
   (J : Ob) (u : Hom J I) (z : Obj J) (c : Ch (suc m) J u z) (i : Wt.Pn m J) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m)))
   -> Id (DA.Ez J z) (pzv (suc m) v' J u z c (Wt.Face[m, J, k, hk].Of[i].face))
        (DA.E.act (J, z) (J, (DO.KJ[J].K.fc m k (C.res J I u x) z c).1) (idH J, (DO.KJ[J].K.fc m k (C.res J I u x) z c).2.2)
           (pzv m v J u (DO.KJ[J].K.fc m k (C.res J I u x) z c).1 (DO.KJ[J].K.fc m k (C.res J I u x) z c).2.1 i)) ;

  -- the levels up to n, with the top projection
  Lv : (n : Nat) -> (T : U l) * (T -> Vt n) = split {
   zero -> ((v : Vt zero) * P1t zero v * P2t zero v, \ p -> p.1) ;
   suc m | r -> ((v : Vt (suc m)) * P1t (suc m) v * P2t (suc m) v * (p : r.1) * P3t m v (r.2 p), \ p -> p.1) } ;
  Up (n : Nat) : U l = (Lv n).1 ;
  top (n : Nat) (p : Up n) : Vt n = (Lv n).2 p ;
 } ;
} ;
