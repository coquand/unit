-- CCopy8.seg (canonicity-45; COBAR.md "Lemma 59", item (1)): a fibration
-- structure on the levelwise site G0 restricts to each copy of the poset
-- site, for C with constant objects (the converse of CCopy5.FibC): each
-- composition, a relative contraction over the G0 line kit, restricts to
-- the copy (CCopy7.RRes) and moves to the poset line kit of the
-- restriction (CMove.Mv) along the extension of poset lines to G0 lines
-- by transport along the presentation equation (EXT).
-- Specific to this C (constant objects).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

-- poset lines of the copy extended to G0 lines, generic in the G0 context
module EXT (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (H : CCopy[a].ConcC[R, encK, pe].P0.PCtx) (y : SX.Over[R].Presentation) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module G0 = CC.G0 ;
 module Cy = CC.Copy[y] ;
 module FC0 = G0.GB.CLine[a+].FC[H] ;
 module FCp = PB.CLine[a+].FC[Cy.rCy H] ;
 ObjT (J : Ob) : U a+ = V1.Ix (CC.CM.IC.obD J) ;
 tq (I : Ob) (g : V1.Ix (FCp.ob I)) (W1 : Ob) (z : ObjT W1) (q : Id (ObjT W1) y z) (u : Hom W1 I) (i : PB.IvP W1) : V1.Ix (H.ob (W1, z)) =
  subst (ObjT W1) (\ z2 -> V1.Ix (H.ob (W1, z2))) y z q (g.1 W1 u i) ;
 module N (I : Ob) (g : V1.Ix (FCp.ob I)) (Vo W : G0.TOb) (chi : G0.THm Vo W) (f : G0.THm W (Cy.o0 I)) (i : PB.IvP W.1) {
  St (y2 : ObjT W.1) (ek : Id (ObjT W.1) y2 y) (y3 : ObjT Vo.1) (eg : Id (ObjT Vo.1) y3 y2) : U a++ =
   Id (V1.Ix (H.ob (Vo.1, y3))) (H.act (Vo.1, y3) (W.1, y2) (chi.1, eg) (tq I g W.1 y2 (symH ek) f.1 i))
     (tq I g Vo.1 y3 (symH (G0.tcomp (Vo.1, y3) (W.1, y2) (Cy.o0 I) (f.1, ek) (chi.1, eg)).2) (G0.tcomp (Vo.1, y3) (W.1, y2) (Cy.o0 I) (f.1, ek) (chi.1, eg)).1 (PB.ivA Vo.1 W.1 chi.1 i)) ;
  base : St y (refl y) y (refl y) = g.2 Vo.1 W.1 chi.1 f.1 i ;
  gen : (y2 : ObjT W.1) (q : Id (ObjT W.1) y y2) (y3 : ObjT Vo.1) (q' : Id (ObjT Vo.1) y2 y3) -> St y2 (symH q) y3 (symH q') =
   \ y2 q -> idJ (ObjT W.1) y (\ y4 q4 -> (y3 : ObjT Vo.1) (q' : Id (ObjT Vo.1) y4 y3) -> St y4 (symH q4) y3 (symH q'))
    (\ y3 q' -> idJ (ObjT Vo.1) y (\ y5 q5 -> St y (refl y) y5 (symH q5)) base y3 q') y2 q ;
  g0 : St W.2 (symH (symH f.2)) Vo.2 (symH (symH chi.2)) = gen W.2 (symH f.2) Vo.2 (symH chi.2) ;
  sk : Id (Id (ObjT W.1) W.2 y) (symH (symH f.2)) f.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 y (symH (symH f.2)) f.2 ;
  sg : Id (Id (ObjT Vo.1) Vo.2 W.2) (symH (symH chi.2)) chi.2 = V1.isSetIx (CC.CM.IC.obD Vo.1) Vo.2 W.2 (symH (symH chi.2)) chi.2 ;
  g1 : St W.2 (symH (symH f.2)) Vo.2 chi.2 = subst (Id (ObjT Vo.1) Vo.2 W.2) (\ e2 -> St W.2 (symH (symH f.2)) Vo.2 e2) (symH (symH chi.2)) chi.2 sg g0 ;
  law : St W.2 f.2 Vo.2 chi.2 = subst (Id (ObjT W.1) W.2 y) (\ e2 -> St W.2 e2 Vo.2 chi.2) (symH (symH f.2)) f.2 sk g1 ;
 } ;
 ext (I : Ob) (g : V1.Ix (FCp.ob I)) : V1.Ix (FC0.ob (Cy.o0 I)) =
  (\ W f i -> tq I g W.1 W.2 (symH f.2) f.1 i, \ Vo W chi f i -> N[I, g, Vo, W, chi, f, i].law) ;
} ;

-- per copy: the poset line kit of the restriction maps to the restriction of the G0 line kit
module LK2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (G : CCopy[a].ConcC[R, encK, pe].P0.PCtx) (A : CCopy[a].ConcC[R, encK, pe].P0.PTy[G]) (y : SX.Over[R].Presentation) (e e' : PB.IPt) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module G0 = CC.G0 ;
 module Cy = CC.Copy[y] ;
 Gy : L.PCtx = Cy.rCy G ;
 Ay : L.PTy[Gy] = Cy.rTy G A ;
 module L0 = G0.GB.CLine[a+].Lines[G, A] ;
 module K0 = L0.CompK[e, e'] ;
 module Lp = PB.CLine[a+].Lines[Gy, Ay] ;
 module Kp = Lp.CompK[e, e'] ;
 module FC0 = G0.GB.CLine[a+].FC[G] ;
 module FCp = PB.CLine[a+].FC[Gy] ;
 module EX = EXT[R, encK, pe, G, y] ;
 ObjT (J : Ob) : U a+ = V1.Ix (CC.CM.IC.obD J) ;
 D : L.PCtx = Kp.EK.TV.E ;
 D0 : L.PCtx = Cy.rCy K0.EK.TV.E ;
 s (W : Ob) (d : V1.Ix (D.ob W)) : V1.Ix (D0.ob W) = (EX.ext W d.1, d.2) ;
 -- extension commutes with the action
 extN (Vv W : Ob) (g : Hom Vv W) (d : V1.Ix (FCp.ob W))
  : Id (V1.Ix (FC0.ob (Cy.o0 Vv))) (EX.ext Vv (FCp.GI.act Vv W g d)) (FC0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d)) =
  FC0.fam-eq (Cy.o0 Vv) (EX.ext Vv (FCp.GI.act Vv W g d)) (FC0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d)) (\ Wo f i ->
   apH {Id (ObjT Wo.1) Wo.2 y} {V1.Ix (G.ob Wo)} (\ e2 -> EX.tq W d Wo.1 Wo.2 (symH e2) (compH Wo.1 Vv W g f.1) i)
    (V1.isSetIx (CC.CM.IC.obD Wo.1) Wo.2 y f.2 (G0.tcomp Wo (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) f).2)) ;
 -- the pair naturality (the value part: transport along extN, a loop, tact-irr)
 ev0 (Vv : Ob) (g : V1.Ix (FC0.ob (Cy.o0 Vv))) : V1.Ix (Gy.ob Vv) = g.1 (Cy.o0 Vv) (Cy.h0 Vv Vv (idH Vv)) (PB.ptH Vv e) ;
 substEv (Vv : Ob) (g1 g2 : V1.Ix (FC0.ob (Cy.o0 Vv))) (Pg : Id (V1.Ix (FC0.ob (Cy.o0 Vv))) g1 g2) (b : V1.Ix (Ay.tob Vv (ev0 Vv g1)))
  : Id (V1.Ix (Ay.tob Vv (ev0 Vv g2))) (subst (V1.Ix (FC0.ob (Cy.o0 Vv))) (\ gg -> V1.Ix (Ay.tob Vv (ev0 Vv gg))) g1 g2 Pg b)
       (subst (V1.Ix (Gy.ob Vv)) (\ xx -> V1.Ix (Ay.tob Vv xx)) (ev0 Vv g1) (ev0 Vv g2) (apH (ev0 Vv) Pg) b) =
  idJ (V1.Ix (FC0.ob (Cy.o0 Vv))) g1 (\ g3 P3 -> Id (V1.Ix (Ay.tob Vv (ev0 Vv g3))) (subst (V1.Ix (FC0.ob (Cy.o0 Vv))) (\ gg -> V1.Ix (Ay.tob Vv (ev0 Vv gg))) g1 g3 P3 b)
       (subst (V1.Ix (Gy.ob Vv)) (\ xx -> V1.Ix (Ay.tob Vv xx)) (ev0 Vv g1) (ev0 Vv g3) (apH (ev0 Vv) P3) b)) (refl b) g2 Pg ;
 substLoop (Vv : Ob) (xx : V1.Ix (Gy.ob Vv)) (p : Id (V1.Ix (Gy.ob Vv)) xx xx) (b : V1.Ix (Ay.tob Vv xx))
  : Id (V1.Ix (Ay.tob Vv xx)) (subst (V1.Ix (Gy.ob Vv)) (\ x2 -> V1.Ix (Ay.tob Vv x2)) xx xx p b) b =
  apH {Id (V1.Ix (Gy.ob Vv)) xx xx} {V1.Ix (Ay.tob Vv xx)} (\ q -> subst (V1.Ix (Gy.ob Vv)) (\ x2 -> V1.Ix (Ay.tob Vv x2)) xx xx q b)
   (V1.isSetIx (Gy.ob Vv) xx xx p (refl xx)) ;
 snat (Vv W : Ob) (g : Hom Vv W) (d : V1.Ix (D.ob W)) : Id (V1.Ix (D0.ob Vv)) (s Vv (D.act Vv W g d)) (D0.act Vv W g (s W d)) =
  Sigma-path (V1.Ix (FC0.ob (Cy.o0 Vv))) (\ gg -> V1.Ix (Ay.tob Vv (ev0 Vv gg)))
   (EX.ext Vv (FCp.GI.act Vv W g d.1)) (FC0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d.1)) (s Vv (D.act Vv W g d)).2 (D0.act Vv W g (s W d)).2
   (extN Vv W g d.1)
   (transH (substEv Vv (EX.ext Vv (FCp.GI.act Vv W g d.1)) (FC0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d.1)) (extN Vv W g d.1) (s Vv (D.act Vv W g d)).2)
     (transH (substLoop Vv (ev0 Vv (FC0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d.1))) (apH (ev0 Vv) (extN Vv W g d.1)) (s Vv (D.act Vv W g d)).2)
       (L.tact-irr Gy Ay Vv W g (ev0 W (EX.ext W d.1)) (ev0 Vv (FC0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d.1)))
          (L.ntEq FCp.GI Gy (FCp.ev e) Vv W g d.1 (FCp.GI.act Vv W g d.1) (refl (FCp.GI.act Vv W g d.1)))
          (G0.GB.GPre[a+].PS.ntEq FC0.GI G (FC0.ev e) (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d.1) (FC0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d.1)) (refl (FC0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EX.ext W d.1))))
          d.2))) ;
 -- the end types: same fibres
 T : L.PTy[D] = Kp.Tend ;
 T0 : L.PTy[D0] = Cy.rTy K0.EK.TV.E K0.Tend ;
 module TT = PB.GPre[a+].TyL[D, T] ;
 module TT0 = PB.GPre[a+].TyL[D0, T0] ;
 evq (Vv : Ob) (g : V1.Ix (FCp.ob Vv)) : V1.Ix (Gy.ob Vv) = g.1 Vv (idH Vv) (PB.ptH Vv e') ;
 mT (W : Ob) (v : TT.EI W) : TT0.EI W = TT0.pr W (s W (TT.pr1 W v)) (TT.pr2 W v) ;
 mTpt (W : Ob) (v : TT.EI W) : Id (V1.Ix (D0.ob W)) (TT0.pr1 W (mT W v)) (s W (TT.pr1 W v)) = refl (s W (TT.pr1 W v)) ;
 bk (X : Ob) (x : V1.Ix (D.ob X)) (u : V1.Ix (T0.tob X (s X x))) : V1.Ix (T.tob X x) = u ;
 bkMv (X : Ob) (x : V1.Ix (D.ob X)) (u : V1.Ix (T0.tob X (s X x))) : Id (TT0.EI X) (mT X (TT.pr X x (bk X x u))) (TT0.pr X (s X x) u) = refl (TT0.pr X (s X x) u) ;
 mTinj (W : Ob) (v v' : TT.EI W) (Pp : Id (V1.Ix (D.ob W)) (TT.pr1 W v) (TT.pr1 W v')) (Q : Id (TT0.EI W) (mT W v) (mT W v')) : Id (TT.EI W) v v' =
  idJ (V1.Ix (D.ob W)) (TT.pr1 W v)
   (\ x2 P2 -> (b2 : V1.Ix (T.tob W x2)) -> Id (TT0.EI W) (mT W v) (TT0.pr W (s W x2) b2) -> Id (TT.EI W) (TT.pr W (TT.pr1 W v) (TT.pr2 W v)) (TT.pr W x2 b2))
   (\ b2 Q2 -> apH (TT.pr W (TT.pr1 W v)) (TT0.pr-inj W (s W (TT.pr1 W v)) (TT.pr2 W v) b2 Q2))
   (TT.pr1 W v') Pp (TT.pr2 W v') Q ;
 module MTN (Vv W : Ob) (g : Hom Vv W) (v : TT.EI W) {
  x : V1.Ix (D.ob W) = TT.pr1 W v ;
  b : V1.Ix (T.tob W x) = TT.pr2 W v ;
  x' : V1.Ix (D.ob Vv) = D.act Vv W g x ;
  e0 : Id (V1.Ix (Gy.ob Vv)) (Gy.act Vv W g (evq W x.1)) (evq Vv x'.1) =
   G0.GB.GPre[a+].PS.ntEq FC0.GI G (FC0.ev e') (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (s W x).1 (s Vv x').1
    (G0.GB.GPre[a+].PS.ntEq K0.EK.TV.E FC0.GI (G0.GB.GPre[a+].PS.pP FC0.GI L0.FA.Ev[e].Aev) (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (s W x) (s Vv x') (symH (snat Vv W g x))) ;
  ep : Id (V1.Ix (Gy.ob Vv)) (Gy.act Vv W g (evq W x.1)) (evq Vv x'.1) =
   L.ntEq FCp.GI Gy (FCp.ev e') Vv W g x.1 x'.1 (L.ntEq D FCp.GI (L.pP FCp.GI Lp.FA.Ev[e].Aev) Vv W g x x' (refl x')) ;
  law : Id (TT0.EI Vv) (TT0.E.act Vv W g (mT W v)) (mT Vv (TT.E.act Vv W g v)) =
   transH (TT0.pr-tact Vv W g (s W x) (s Vv x') (symH (snat Vv W g x)) b)
    (apH (TT0.pr Vv (s Vv x')) (L.tact-irr Gy Ay Vv W g (evq W x.1) (evq Vv x'.1) e0 ep b)) ;
 } ;
 -- the fibre types: lines in A extended
 module TA0 = G0.GB.GPre[a+].TyL[G, A] ;
 module TAy = PB.GPre[a+].TyL[Gy, Ay] ;
 module FE0 = G0.GB.CLine[a+].FC[TA0.E] ;
 module FEp = PB.CLine[a+].FC[TAy.E] ;
 module EXE = EXT[R, encK, pe, TA0.E, y] ;
 Sx : L.PTy[D] = Kp.EK.SFm.SF ;
 S0 : L.PTy[D0] = Cy.rTy K0.EK.TV.E K0.EK.SFm.SF ;
 module TS = PB.GPre[a+].TyL[D, Sx] ;
 module TS0 = PB.GPre[a+].TyL[D0, S0] ;
 -- the first projection commutes with the transport
 substPr1 (W1 : Ob) (z : ObjT W1) (q : Id (ObjT W1) y z) (w : TA0.EI (W1, y))
  : Id (V1.Ix (G.ob (W1, z))) (TA0.pr1 (W1, z) (subst (ObjT W1) (\ z2 -> TA0.EI (W1, z2)) y z q w)) (subst (ObjT W1) (\ z2 -> V1.Ix (G.ob (W1, z2))) y z q (TA0.pr1 (W1, y) w)) =
  idJ (ObjT W1) y (\ z3 q3 -> Id (V1.Ix (G.ob (W1, z3))) (TA0.pr1 (W1, z3) (subst (ObjT W1) (\ z2 -> TA0.EI (W1, z2)) y z3 q3 w)) (subst (ObjT W1) (\ z2 -> V1.Ix (G.ob (W1, z2))) y z3 q3 (TA0.pr1 (W1, y) w)))
   (refl (TA0.pr1 (W1, y) w)) z q ;
 module MS (W : Ob) (u : TS.EI W) {
  gm : V1.Ix (FCp.ob W) = (TS.pr1 W u).1 ;
  bA : V1.Ix (Lp.FA.AI.tob W (TS.pr1 W u).1) = (TS.pr2 W u).1 ;
  prfA : Id (V1.Ix (FC0.ob (Cy.o0 W))) (L0.FA.piL (Cy.o0 W) (EXE.ext W bA.1)) (EX.ext W gm) =
   transH (FC0.fam-eq (Cy.o0 W) (L0.FA.piL (Cy.o0 W) (EXE.ext W bA.1)) (EX.ext W (Lp.FA.piL W bA.1))
             (\ Vo f i -> substPr1 Vo.1 Vo.2 (symH f.2) (bA.1.1 Vo.1 f.1 i)))
    (apH {V1.Ix (FCp.ob W)} {V1.Ix (FC0.ob (Cy.o0 W))} (EX.ext W) bA.2) ;
  bA' : V1.Ix (L0.FA.AI.tob (Cy.o0 W) (EX.ext W gm)) = (EXE.ext W bA.1, prfA) ;
  xv : V1.Ix (Gy.ob W) = (bA.1.1 W (idH W) (PB.ptH W e)).1 ;
  yv : V1.Ix (Gy.ob W) = gm.1 W (idH W) (PB.ptH W e) ;
  bv : V1.Ix (Ay.tob W xv) = (bA.1.1 W (idH W) (PB.ptH W e)).2 ;
  pp : Id (V1.Ix (Gy.ob W)) xv yv = apH {V1.Ix (FCp.ob W)} {V1.Ix (Gy.ob W)} (\ z -> z.1 W (idH W) (PB.ptH W e)) bA.2 ;
  p0 : Id (V1.Ix (Gy.ob W)) xv yv = apH {V1.Ix (FC0.ob (Cy.o0 W))} {V1.Ix (Gy.ob W)} (\ z -> z.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e)) prfA ;
  endEq : Id (V1.Ix (Ay.tob W yv)) (subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv p0 bv) (subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv pp bv) =
   apH {Id (V1.Ix (Gy.ob W)) xv yv} {V1.Ix (Ay.tob W yv)} (\ q -> subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv q bv) (V1.isSetIx (Gy.ob W) xv yv p0 pp) ;
  prf : Id (V1.Ix (D0.ob W)) (K0.EK.TV.pr (Cy.o0 W) (EX.ext W gm) (subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv p0 bv)) (s W (TS.pr1 W u)) =
   transH (apH {V1.Ix (Ay.tob W yv)} {V1.Ix (D0.ob W)} (K0.EK.TV.pr (Cy.o0 W) (EX.ext W gm)) endEq) (apH {V1.Ix (D.ob W)} {V1.Ix (D0.ob W)} (s W) (TS.pr2 W u).2) ;
 } ;
 mS (W : Ob) (u : TS.EI W) : TS0.EI W = TS0.pr W (s W (TS.pr1 W u)) (MS[W, u].bA', MS[W, u].prf) ;
 mSpt (W : Ob) (u : TS.EI W) : Id (V1.Ix (D0.ob W)) (TS0.pr1 W (mS W u)) (s W (TS.pr1 W u)) = refl (s W (TS.pr1 W u)) ;
 fgtInj (W : Ob) (u : TS0.EI W) : (x2 : V1.Ix (D0.ob W)) (P1 : Id (V1.Ix (D0.ob W)) (TS0.pr1 W u) x2) (b2 : V1.Ix (S0.tob W x2))
   (P2 : Id (V1.Ix (FE0.ob (Cy.o0 W))) (TS0.pr2 W u).1.1 b2.1.1) -> Id (TS0.EI W) u (TS0.pr W x2 b2) =
  \ x2 P1 -> idJ (V1.Ix (D0.ob W)) (TS0.pr1 W u)
   (\ x3 P3 -> (b3 : V1.Ix (S0.tob W x3)) (P2 : Id (V1.Ix (FE0.ob (Cy.o0 W))) (TS0.pr2 W u).1.1 b3.1.1) -> Id (TS0.EI W) u (TS0.pr W x3 b3))
   (\ b3 P2 -> apH {V1.Ix (S0.tob W (TS0.pr1 W u))} {TS0.EI W} (TS0.pr W (TS0.pr1 W u))
      (K0.EK.SFm.sf-eq (Cy.o0 W) (TS0.pr1 W u) (TS0.pr2 W u) b3 (L0.FA.tob-eq (Cy.o0 W) (TS0.pr1 W u).1 (TS0.pr2 W u).1 b3.1 P2)))
   x2 P1 ;
 extEN (Vv W : Ob) (g : Hom Vv W) (d : V1.Ix (FEp.ob W))
  : Id (V1.Ix (FE0.ob (Cy.o0 Vv))) (FE0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EXE.ext W d)) (EXE.ext Vv (FEp.GI.act Vv W g d)) =
  symH (FE0.fam-eq (Cy.o0 Vv) (EXE.ext Vv (FEp.GI.act Vv W g d)) (FE0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) (EXE.ext W d)) (\ Wo f i ->
   apH {Id (ObjT Wo.1) Wo.2 y} {TA0.EI Wo} (\ e2 -> EXE.tq W d Wo.1 Wo.2 (symH e2) (compH Wo.1 Vv W g f.1) i)
    (V1.isSetIx (CC.CM.IC.obD Wo.1) Wo.2 y f.2 (G0.tcomp Wo (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) f).2))) ;
 mSnat (Vv W : Ob) (g : Hom Vv W) (u : TS.EI W) : Id (TS0.EI Vv) (TS0.E.act Vv W g (mS W u)) (mS Vv (TS.E.act Vv W g u)) =
  fgtInj Vv (TS0.E.act Vv W g (mS W u)) (s Vv (TS.pr1 Vv (TS.E.act Vv W g u))) (symH (snat Vv W g (TS.pr1 W u)))
   (TS0.pr2 Vv (mS Vv (TS.E.act Vv W g u))) (extEN Vv W g (TS.pr2 W u).1.1) ;
 -- the end maps commute with the moves
 m1 : PB.CPartial[a+].PMap[D0, S0, T0] = Cy.rMy K0.EK.TV.E K0.EK.SFm.SF K0.Tend K0.endL ;
 module SQ (W : Ob) (v : TS.EI W) {
  bA : V1.Ix (Lp.FA.AI.tob W (TS.pr1 W v).1) = (TS.pr2 W v).1 ;
  xv : V1.Ix (Gy.ob W) = (bA.1.1 W (idH W) (PB.ptH W e')).1 ;
  yv : V1.Ix (Gy.ob W) = (TS.pr1 W v).1.1 W (idH W) (PB.ptH W e') ;
  bv : V1.Ix (Ay.tob W xv) = (bA.1.1 W (idH W) (PB.ptH W e')).2 ;
  pp : Id (V1.Ix (Gy.ob W)) xv yv = apH {V1.Ix (FCp.ob W)} {V1.Ix (Gy.ob W)} (\ z -> z.1 W (idH W) (PB.ptH W e')) bA.2 ;
  p0 : Id (V1.Ix (Gy.ob W)) xv yv = apH {V1.Ix (FC0.ob (Cy.o0 W))} {V1.Ix (Gy.ob W)} (\ z -> z.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e')) MS[W, v].prfA ;
  law : Id (TT0.EI W) (mT W (Kp.endL.mE W v)) (m1.mE W (mS W v)) =
   apH {V1.Ix (Ay.tob W yv)} {TT0.EI W} (TT0.pr W (s W (TS.pr1 W v)))
    (apH {Id (V1.Ix (Gy.ob W)) xv yv} {V1.Ix (Ay.tob W yv)} (\ q -> subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv q bv) (V1.isSetIx (Gy.ob W) xv yv pp p0)) ;
 } ;
 -- the restricted G0 composition, moved to the poset kit
 move (k0 : PB.CPartial[a+].Rel[D0, S0, T0, m1].RC) : Kp.Comp =
  PB.CMove[a+, a+].Mv[D, Sx, T, Kp.endL, D0, S0, T0, m1, s, snat, mS, mSpt, mSnat, mT, mTpt, \ Vv W g v -> MTN[Vv, W, g, v].law,
    mTinj, bk, bkMv, \ W v -> SQ[W, v].law, k0].rc ;
} ;

-- a G0 fibration structure restricted to the copy y
module FibR (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (G : CCopy[a].ConcC[R, encK, pe].P0.PCtx) (A : CCopy[a].ConcC[R, encK, pe].P0.PTy[G])
  (fb : CCopy[a].ConcC[R, encK, pe].G0.GB.CLine[a+].Lines[G, A].Fib) (y : SX.Over[R].Presentation) {
 module K01 = LK2[R, encK, pe, G, A, y, PB.e0, PB.e1] ;
 module K10 = LK2[R, encK, pe, G, A, y, PB.e1, PB.e0] ;
 c01 : K01.Kp.Comp = K01.move CCopy7[a].RRes[R, encK, pe, K01.K0.EK.TV.E, K01.K0.EK.SFm.SF, K01.K0.Tend, K01.K0.endL, fb.1, y].rc ;
 c10 : K10.Kp.Comp = K10.move CCopy7[a].RRes[R, encK, pe, K10.K0.EK.TV.E, K10.K0.EK.SFm.SF, K10.K0.Tend, K10.K0.endL, fb.2, y].rc ;
 fib : K01.Lp.Fib = (c01, c10) ;
} ;
