-- CSigSetC.seg (canonicity-c2; for (K) and (d)): a closed Sigma type
-- S = Sigma A B with A a set and B a family of propositions is a set, in
-- the poset fibrant CwF over nil (CQCtx's SetQiTy form).  Hedberg
-- (CwFHed6) at nil.S with R(y) = Id_A(fst x , fst y), read from A's
-- set-ness along the semantic substitution sigma (the two first
-- components), rho by el-ext and rfl, f by CwFPropPair.pairPath.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;

module SigSetC (A : C.Ty C.nil) (B : C.Ty (C.ext C.nil A)) (sA : CQCtx[a].G3Of[A].SetQiTy)
  (pB : C.El (C.ext C.nil A) (PU.isProp (C.ext C.nil A) B)) {
 Nl : C.Ctx = C.nil ;
 S : C.Ty Nl = SS.Sig Nl A B ;
 module GA = CQCtx[a].G3Of[A] ;
 module GS = CQCtx[a].G3Of[S] ;
 -- the two first components: GS.G2 -> GA.G2
 sgN (K : Ob) (w : V1.Ix (GS.G2.ob K)) : V1.Ix (GA.G2.ob K) = ((w.1.1, w.1.2.1), w.2.1) ;
 sg : C.Sub GS.G2 GA.G2 = new L.PSub[GS.G2, GA.G2, sgN, \ L0 K g w -> refl (sgN L0 (GS.G2.act L0 K g w))] ;
 IA : C.Ty GA.G2 = IJ.IdT GA.G2 GA.Qw2 GA.v1 GA.v2 ;
 R : C.Ty GS.G2 = C.subT GS.G2 GA.G2 IA sg ;
 pR : C.El GS.G2 (PU.isProp GS.G2 R) =
  OV.trE GS.G2 (C.subT GS.G2 GA.G2 (PU.isProp GA.G2 IA) sg) (PU.isProp GS.G2 R) (PU.isProp-ov GS.G2 GA.G2 IA sg R (refl R))
    (C.subt GS.G2 GA.G2 (PU.isProp GA.G2 IA) (GA.setV2 sA) sg) ;
 -- rho : R at (x , x) is reflexivity
 x0 : C.El GS.G1 GS.Qw = C.q Nl S ;
 s0 : C.Sub GS.G1 GA.G2 = C.o GS.G1 GS.G2 GA.G2 sg (C.sec GS.G1 GS.Qw x0) ;
 Q2s : C.Ty GS.G1 = C.subT GS.G1 GA.G2 GA.Qw2 s0 ;
 a1 : C.El GS.G1 Q2s = C.subt GS.G1 GA.G2 GA.Qw2 GA.v1 s0 ;
 a2 : C.El GS.G1 Q2s = C.subt GS.G1 GA.G2 GA.Qw2 GA.v2 s0 ;
 e12 : Id (C.El GS.G1 Q2s) a1 a2 = L.el-ext GS.G1 Q2s.1 a1 a2 (\ K w -> refl (a1.eob K w)) ;
 rf : C.El GS.G1 (IJ.IdT GS.G1 Q2s a1 a2) = subst (C.El GS.G1 Q2s) (\ r -> C.El GS.G1 (IJ.IdT GS.G1 Q2s a1 r)) a1 a2 e12 (IJ.rfl GS.G1 Q2s a1) ;
 P1 : Id (C.Ty GS.G1) (C.subT GS.G1 GA.G2 IA s0) (C.subT GS.G1 GS.G2 R (C.sec GS.G1 GS.Qw x0)) = C.subT-o GS.G1 GS.G2 GA.G2 IA sg (C.sec GS.G1 GS.Qw x0) ;
 P2 : Id (C.Ty GS.G1) (C.subT GS.G1 GA.G2 IA s0) (IJ.IdT GS.G1 Q2s a1 a2) = IJ.IdT-nat GS.G1 GA.G2 GA.Qw2 GA.v1 GA.v2 s0 ;
 rho : C.El GS.G1 (C.subT GS.G1 GS.G2 R (C.sec GS.G1 GS.Qw x0)) =
  OV.trE GS.G1 (IJ.IdT GS.G1 Q2s a1 a2) (C.subT GS.G1 GS.G2 R (C.sec GS.G1 GS.Qw x0))
    (transH (symH P2) P1) rf ;
 -- f : over G2.R, pairPath of the two variables
 G2 : C.Ctx = GS.G2 ;
 GR : C.Ctx = C.ext G2 R ;
 pR' : C.Sub GR G2 = C.p G2 R ;
 -- closed types pulled back along any two substitutions agree
 clT (D : C.Ctx) (T : C.Ty Nl) (s1 s2 : C.Sub D Nl) : Id (C.Ty D) (C.subT D Nl T s1) (C.subT D Nl T s2) =
  apH {C.Sub D Nl} {C.Ty D} (\ s -> C.subT D Nl T s) (transH (C.eps-uniq D s1) (symH (C.eps-uniq D s2))) ;
 XA : C.Ty GR = C.subT GR Nl A (C.eps GR) ;
 Y : C.Ty (C.ext GR XA) = C.subT (C.ext GR XA) (C.ext Nl A) B (C.lift GR Nl A (C.eps GR)) ;
 SR : C.Ty GR = SS.Sig GR XA Y ;
 -- S twice weakened, weakened again by R, is S at eps, i.e. SR
 pp3 : C.Sub GR Nl = C.o GR G2 Nl (C.o G2 GS.G1 Nl (C.p Nl S) (C.p GS.G1 GS.Qw)) pR' ;
 TP0 : Id (C.Ty GR) (OV.wkT G2 R GS.Qw2) (C.subT GR Nl S pp3) =
  transH (apH {C.Ty G2} {C.Ty GR} (\ T -> C.subT GR G2 T pR') (symH (C.subT-o G2 GS.G1 Nl S (C.p Nl S) (C.p GS.G1 GS.Qw))))
   (symH (C.subT-o GR G2 Nl S (C.o G2 GS.G1 Nl (C.p Nl S) (C.p GS.G1 GS.Qw)) pR')) ;
 TP : Id (C.Ty GR) (OV.wkT G2 R GS.Qw2) SR =
  transH TP0 (transH (clT GR S pp3 (C.eps GR)) (SS.Sig-nat GR Nl A B (C.eps GR))) ;
 w1 : C.El GR SR = OV.trE GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 GS.v1) ;
 w2 : C.El GR SR = OV.trE GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 GS.v2) ;
 -- the variable of R as an Id between the first components of w1, w2
 idFwd (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (u : C.El G (IJ.IdT G X x y))
   : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)) =
  idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y))) u X' P ;
 tR : C.Sub GR GA.G2 = C.o GR G2 GA.G2 sg pR' ;
 QA2 : C.Ty GR = C.subT GR GA.G2 GA.Qw2 tR ;
 b1 : C.El GR QA2 = C.subt GR GA.G2 GA.Qw2 GA.v1 tR ;
 b2 : C.El GR QA2 = C.subt GR GA.G2 GA.Qw2 GA.v2 tR ;
 PRq : Id (C.Ty GR) (OV.wkT G2 R R) (IJ.IdT GR QA2 b1 b2) =
  transH (symH (C.subT-o GR G2 GA.G2 IA sg pR')) (IJ.IdT-nat GR GA.G2 GA.Qw2 GA.v1 GA.v2 tR) ;
 u0 : C.El GR (IJ.IdT GR QA2 b1 b2) = OV.trE GR (OV.wkT G2 R R) (IJ.IdT GR QA2 b1 b2) PRq (C.q G2 R) ;
 pA2 : C.Sub GR Nl = C.o GR GA.G2 Nl (C.o GA.G2 GA.G1 Nl (C.p Nl A) (C.p GA.G1 GA.Qw)) tR ;
 TPA : Id (C.Ty GR) QA2 XA =
  transH (apH {C.Ty GA.G2} {C.Ty GR} (\ T -> C.subT GR GA.G2 T tR) (symH (C.subT-o GA.G2 GA.G1 Nl A (C.p Nl A) (C.p GA.G1 GA.Qw))))
   (transH (symH (C.subT-o GR GA.G2 Nl A (C.o GA.G2 GA.G1 Nl (C.p Nl A) (C.p GA.G1 GA.Qw)) tR)) (clT GR A pA2 (C.eps GR))) ;
 u1 : C.El GR (IJ.IdT GR XA (OV.trE GR QA2 XA TPA b1) (OV.trE GR QA2 XA TPA b2)) = idFwd GR QA2 XA TPA b1 b2 u0 ;
 f1 : C.El GR XA = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ].fst GR XA Y w1 ;
 f2 : C.El GR XA = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ].fst GR XA Y w2 ;
 hb1 (K : Ob) : (o : Top) (s1 s2 : V1.Ix (S.1.tob K o)) (r : V1.Ix (R.1.tob K ((o, s1), s2)))
   -> Id (V1.Ix (XA.1.tob K (((o, s1), s2), r))) ((OV.trE GR QA2 XA TPA b1).eob K (((o, s1), s2), r)) (f1.eob K (((o, s1), s2), r)) =
  split { tt -> \ s1 s2 r ->
   transH (CAppRd[a].trE-rd GR QA2 XA TPA b1 K (((tt, s1), s2), r))
    (transH (CAppRd[a].same-rd GR QA2 XA TPA K (((tt, s1), s2), r) (refl (XA.1.tob K (((tt, s1), s2), r))) (b1.eob K (((tt, s1), s2), r)))
      (symH (apH {V1.Ix (SR.1.tob K (((tt, s1), s2), r))} {V1.Ix (XA.1.tob K (((tt, s1), s2), r))} (\ z -> z.1)
         (transH (CAppRd[a].trE-rd GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 GS.v1) K (((tt, s1), s2), r))
            (CAppRd[a].same-rd GR (OV.wkT G2 R GS.Qw2) SR TP K (((tt, s1), s2), r) (refl (S.1.tob K tt)) (s1)))))) } ;
 E1 : Id (C.El GR XA) (OV.trE GR QA2 XA TPA b1) f1 = L.el-ext GR XA.1 (OV.trE GR QA2 XA TPA b1) f1 (\ K w -> hb1 K w.1.1.1 w.1.1.2 w.1.2 w.2) ;
 hb2 (K : Ob) : (o : Top) (s1 s2 : V1.Ix (S.1.tob K o)) (r : V1.Ix (R.1.tob K ((o, s1), s2)))
   -> Id (V1.Ix (XA.1.tob K (((o, s1), s2), r))) ((OV.trE GR QA2 XA TPA b2).eob K (((o, s1), s2), r)) (f2.eob K (((o, s1), s2), r)) =
  split { tt -> \ s1 s2 r ->
   transH (CAppRd[a].trE-rd GR QA2 XA TPA b2 K (((tt, s1), s2), r))
    (transH (CAppRd[a].same-rd GR QA2 XA TPA K (((tt, s1), s2), r) (refl (XA.1.tob K (((tt, s1), s2), r))) (b2.eob K (((tt, s1), s2), r)))
      (symH (apH {V1.Ix (SR.1.tob K (((tt, s1), s2), r))} {V1.Ix (XA.1.tob K (((tt, s1), s2), r))} (\ z -> z.1)
         (transH (CAppRd[a].trE-rd GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 GS.v2) K (((tt, s1), s2), r))
            (CAppRd[a].same-rd GR (OV.wkT G2 R GS.Qw2) SR TP K (((tt, s1), s2), r) (refl (S.1.tob K tt)) (s2)))))) } ;
 E2 : Id (C.El GR XA) (OV.trE GR QA2 XA TPA b2) f2 = L.el-ext GR XA.1 (OV.trE GR QA2 XA TPA b2) f2 (\ K w -> hb2 K w.1.1.1 w.1.1.2 w.1.2 w.2) ;
 ee : C.El GR (IJ.IdT GR XA f1 f2) =
  subst (C.El GR XA) (\ c -> C.El GR (IJ.IdT GR XA f1 c)) (OV.trE GR QA2 XA TPA b2) f2 E2
   (subst (C.El GR XA) (\ c -> C.El GR (IJ.IdT GR XA c (OV.trE GR QA2 XA TPA b2))) (OV.trE GR QA2 XA TPA b1) f1 E1 u1) ;
 pY : C.El (C.ext GR XA) (PU.isProp (C.ext GR XA) Y) =
  OV.trE (C.ext GR XA) (C.subT (C.ext GR XA) (C.ext Nl A) (PU.isProp (C.ext Nl A) B) (C.lift GR Nl A (C.eps GR))) (PU.isProp (C.ext GR XA) Y)
    (PU.isProp-ov (C.ext GR XA) (C.ext Nl A) B (C.lift GR Nl A (C.eps GR)) Y (refl Y))
    (C.subt (C.ext GR XA) (C.ext Nl A) (PU.isProp (C.ext Nl A) B) pB (C.lift GR Nl A (C.eps GR))) ;
 module PPr = CwFPropPair.PropPair[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibUniv[a].fibUniv] ;
 pp : C.El GR (IJ.IdT GR SR w1 w2) = PPr.At[GR, XA, Y].pairPath pY w1 w2 ee ;
 module H6 = CwFHed6.Hed6[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibNF[a, a+].nf] ;
 fB : C.El GR (IJ.IdT GR (OV.wkT G2 R GS.Qw2) (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2)) =
  H6.idBack GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2) pp ;
 fH : C.El GR (OV.wkT G2 R (H6.JP.IK GS.G1 GS.Qw x0)) =
  OV.trE GR (IJ.IdT GR (OV.wkT G2 R GS.Qw2) (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2)) (OV.wkT G2 R (H6.JP.IK GS.G1 GS.Qw x0))
    (symH (IJ.IdT-nat GR G2 GS.Qw2 GS.v1 GS.v2 pR')) fB ;
 module HS6 = H6.S[GS.G1, GS.Qw, x0, R, rho, fH, pR] ;
 -- S IS A SET
 setQi : GS.SetQiTy =
  OV.lam Nl S (FibCwF[a, a+].fibPi.Pi GS.G1 GS.Qw GS.SP) (OV.lam GS.G1 GS.Qw GS.SP HS6.propIK) ;
} ;
