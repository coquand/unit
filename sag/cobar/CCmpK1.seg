-- CCmpK1.seg (canonicity-c2; (K) for cmpI, part 1 of the existence by mere
-- surjectivity): for terms s1, s2 of y the closed hom z_s : F2 -> y of the
-- substitution x_i |-> s_i (CM.II.SubC read through alpha, as CUF0), and
-- the family of them over Delta Term_y ^2 (pointwise; Delta acts trivially).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
-- Id types along an Id of types and Ids of endpoints
idTEq (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (a b : C.El G X) (a' b' : C.El G X')
  (pa : Id (C.El G X') (OV.trE G X X' P a) a') (pb : Id (C.El G X') (OV.trE G X X' P b) b')
  : Id (C.Ty G) (IJ.IdT G X a b) (IJ.IdT G X' a' b') =
 idJ (C.Ty G) X (\ X2 P2 -> (a2 b2 : C.El G X2) -> Id (C.El G X2) (OV.trE G X X2 P2 a) a2 -> Id (C.El G X2) (OV.trE G X X2 P2 b) b2
     -> Id (C.Ty G) (IJ.IdT G X a b) (IJ.IdT G X2 a2 b2))
  (\ a2 b2 qa qb -> idJ (C.El G X) a (\ a3 q3 -> Id (C.Ty G) (IJ.IdT G X a b) (IJ.IdT G X a3 b2))
      (idJ (C.El G X) b (\ b3 q4 -> Id (C.Ty G) (IJ.IdT G X a b) (IJ.IdT G X a b3)) (refl (IJ.IdT G X a b)) b2 qb) a2 qa)
  X' P a' b' pa pb ;
module K1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module CM = CCopy[a].ConcC[R, encK, pe].CM ;
 F2 : SX.Over[R].Presentation = CM.F2 ;
 module HZ = CHomT3[a].HomP[R, encK, pe].Hom[F2, y] ;
 module AY = CAlgX[a].AlgX[R, encK, y, pe] ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = HZ.HomT ;
 Tm : C.Ty Nl = AY.RP.Tm ;
 TmY : U a = SX.Over[R].Der[y].Term ;
 -- the substitution x1 |-> s1, x2 |-> s2
 sg1 (s1 : TmY) : SX.Fin (suc zero) -> TmY = split { inl e -> absurd TmY e ; inr u -> s1 } ;
 sg (s1 s2 : TmY) : SX.Fin (suc (suc zero)) -> TmY = split { inl v -> sg1 s1 v ; inr u -> s2 } ;
 module SC (s1 s2 : TmY) {
  module S0 = CM.II.SubC[F2, y, sg s1 s2,
   \ p m -> absurd (SX.Over[R].Der[y].Proof (CSubst[a].SE[R].subE (SX.Fin F2.1) (SX.Fin y.1) (sg s1 s2) p) SX.Over[R].Der[y].zeroE) m] ;
 } ;
 module FM = CHomT11[a].FromM[R, encK, pe, F2, y] ;
 module NT = CHomT16[a].Nat[R, encK, pe, F2, y] ;
 zob (s1 s2 : TmY) (K : Ob) : (o : Top) -> V1.Ix (HS.1.tob K o) = split { tt -> FM.alpha K (SC[s1, s2].S0.M.mor K) } ;
 znat (s1 s2 : TmY) (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o') -> Id (V1.Ix (HS.1.tob J o')) (HS.1.tact J I f o o' e (zob s1 s2 I o)) (zob s1 s2 J o') =
  split { tt -> split { tt -> \ e ->
   transH (L.tact-irr Nl HS.1 J I f tt tt e (refl tt) (FM.alpha I (SC[s1, s2].S0.M.mor I)))
    (transH (symH (NT.aNat I J f (SC[s1, s2].S0.M.mor I))) (apH {CM.MO.Fn[F2, y].M J} {V1.Ix (HS.1.tob J tt)} (FM.alpha J) (SC[s1, s2].S0.M.mor-nat I J f))) } } ;
 zc (s1 s2 : TmY) : C.El Nl HS = L.mkPEl Nl HS.1 (zob s1 s2) (znat s1 s2) ;
 -- the constant type of pairs of terms of y, and families over it
 module V1b = V[a+] ;
 PV : V1b.V = V1b.SigV AY.RP.TmV (\ _ -> AY.RP.TmV) ;
 module LP = CConstLam[a, a+].LamC[CCyl[a].PosCyl.posCyl, PV] ;
 module LO = CConstLam[a, a+].LamOf[CCyl[a].PosCyl.posCyl, PV] ;
 DP : C.Ctx = C.ext Nl (LP.TE Nl) ;
 TP : C.Ty Nl = LP.TE Nl ;
 module Fam (A : C.Ty Nl) (cl : TmY -> TmY -> C.El Nl A) {
  Aw : C.Ty DP = OV.wkT Nl TP A ;
  fB (J I : Ob) (f : Hom J I) (w : V1.Ix (DP.ob I))
    : Id (V1.Ix (Aw.1.tob J (DP.act J I f w))) (Aw.1.tact J I f w (DP.act J I f w) (refl (DP.act J I f w)) ((cl w.2.1 w.2.2).eob I w.1)) ((cl w.2.1 w.2.2).eob J (DP.act J I f w).1) =
   transH (L.tact-irr Nl A.1 J I f w.1 w.1 (L.ntEq DP Nl (L.pP Nl TP.1) J I f w (DP.act J I f w) (refl (DP.act J I f w))) (refl w.1) ((cl w.2.1 w.2.2).eob I w.1))
    ((cl w.2.1 w.2.2).enat J I f w.1 w.1 (refl w.1)) ;
  el : C.El DP Aw = L.mkPEl DP Aw.1 (\ K w -> (cl w.2.1 w.2.2).eob K w.1) (\ J I f w w' e ->
   idJ (V1.Ix (DP.ob J)) (DP.act J I f w) (\ w2 e2 -> Id (V1.Ix (Aw.1.tob J w2)) (Aw.1.tact J I f w w2 e2 ((cl w.2.1 w.2.2).eob I w.1)) ((cl w2.2.1 w2.2.2).eob J w2.1))
    (fB J I f w) w' e) ;
 } ;
 -- the homs z_s as a family
 zfam : C.El DP (OV.wkT Nl TP HS) = Fam[HS, zc].el ;
 -- a family of Ids between two families, by pack
 module IdFam (A : C.Ty Nl) (c1 c2 : TmY -> TmY -> C.El Nl A) (ee : (s1 s2 : TmY) -> C.El Nl (IJ.IdT Nl A (c1 s1 s2) (c2 s1 s2))) {
  Aw : C.Ty DP = OV.wkT Nl TP A ;
  e1 : C.El DP Aw = Fam[A, c1].el ;
  e2 : C.El DP Aw = Fam[A, c2].el ;
  B : C.Ty DP = IJ.IdT DP Aw e1 e2 ;
  module At (e : V1b.Ix PV) {
   sc : C.Sub Nl DP = C.sec Nl TP (LP.cE Nl e) ;
   PA : Id (C.Ty Nl) (C.subT Nl DP Aw sc) A = CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl TP A (LP.cE Nl e) ;
   rd (c : TmY -> TmY -> C.El Nl A) (K : Ob) (o : V1.Ix (Nl.ob K))
     : Id (V1.Ix (A.1.tob K o)) ((OV.trE Nl (C.subT Nl DP Aw sc) A PA (C.subt Nl DP Aw Fam[A, c].el sc)).eob K o) ((c e.1 e.2).eob K o) =
    transH (CAppRd[a].trE-rd Nl (C.subT Nl DP Aw sc) A PA (C.subt Nl DP Aw Fam[A, c].el sc) K o)
     (CAppRd[a].same-rd Nl (C.subT Nl DP Aw sc) A PA K o (refl (A.1.tob K o)) ((c e.1 e.2).eob K o)) ;
   PId : Id (C.Ty Nl) (IJ.IdT Nl A (c1 e.1 e.2) (c2 e.1 e.2)) (C.subT Nl DP B sc) =
    symH (transH (IJ.IdT-nat Nl DP Aw e1 e2 sc)
      (idTEq Nl (C.subT Nl DP Aw sc) A PA (C.subt Nl DP Aw e1 sc) (C.subt Nl DP Aw e2 sc) (c1 e.1 e.2) (c2 e.1 e.2)
        (L.el-ext Nl A.1 (OV.trE Nl (C.subT Nl DP Aw sc) A PA (C.subt Nl DP Aw e1 sc)) (c1 e.1 e.2) (rd c1))
        (L.el-ext Nl A.1 (OV.trE Nl (C.subT Nl DP Aw sc) A PA (C.subt Nl DP Aw e2 sc)) (c2 e.1 e.2) (rd c2)))) ;
   fEl : C.El Nl (C.subT Nl DP B sc) = OV.trE Nl (IJ.IdT Nl A (c1 e.1 e.2) (c2 e.1 e.2)) (C.subT Nl DP B sc) PId (ee e.1 e.2) ;
  } ;
  res : C.El DP B = LO.pack Nl B.1 (\ e -> At[e].fEl) ;
 } ;
} ;
