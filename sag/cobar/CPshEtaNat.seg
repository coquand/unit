-- CPshEtaNat.seg (canonicity-c2; COBAR.md, Theorem 29, M3): the unit
-- tau_A : A -> D A (Lemma 14 / Cor15.tauA) is natural in the
-- C-substitution.
--
-- For s : De -> G and A over G write A' = A[s].  At x and a point
-- w = (d , a) of the total of A'_x, tau_{A'} w is a family over the
-- indices q; read in the totals of A through rB (CPshL.SC) it is the
-- family of tau_A (s d , a):
--     rB (tau_{A'} w at q) = tau_A (rB w) at q            (core)
-- since both are the C-action of A along the composite of the chain of
-- q, applied to the restriction of the point (Lemma14.TA'.pc), and rB
-- commutes with both actions.
-- Premises: fe.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module VC = VCode[l] ;
module PN = CPshPiNat[a, l] ;

module EtaNatOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module DTm = CPshDSubT[a, l].DSubTOf[C] ;
 CO : U a = P.CO ;

 module P13 = Prop13[a, l].P13Of[C] ;
 module MSm = CPshMapSub[a, l].MapSubOf[C] ;
 module MC = CPshMapC[a, l].MapCOf[C] ;

 -- a C-map transported along a path of codomain C-types, read at x
 cmapTr (G : P.CCtx) (A B B' : P.CTy[G]) (Pc : Id (P.CTy[G]) B B') (f : P13.CMap[G, A, B]) (x : CO) (W : Ob) (w : SigT (G.ob x) (A.ty x) W)
  : Id (SigT (G.ob x) (B'.ty x) W) (((subst (P.CTy[G]) (\ Z -> P13.CMap[G, A, Z]) B B' Pc f).mp x).mE W w)
       (subst (PTy[G.ob x]) (\ T1 -> SigT (G.ob x) T1 W) (B.ty x) (B'.ty x) (apH (\ Z -> Z.ty x) Pc) ((f.mp x).mE W w)) =
  idJ (P.CTy[G]) B
   (\ B2 P2 -> Id (SigT (G.ob x) (B2.ty x) W) (((subst (P.CTy[G]) (\ Z -> P13.CMap[G, A, Z]) B B2 P2 f).mp x).mE W w)
                 (subst (PTy[G.ob x]) (\ T1 -> SigT (G.ob x) T1 W) (B.ty x) (B2.ty x) (apH (\ Z -> Z.ty x) P2) ((f.mp x).mE W w)))
   (refl ((f.mp x).mE W w)) B' Pc ;

 module E (De G : P.CCtx) (s : P.CSub[De, G]) (A : P.CTy[G]) {
  module T = DTm.T[De, G, s, A] ;
  module LG = Lemma14[a, l].L14[C, G, A] ;
  module LD = Lemma14[a, l].L14[C, De, T.A'] ;

  module Cx (x : CO) (X : Ob) (w : SigT (De.ob x) (T.A'.ty x) X) {
   module Tw' = LD.TA'[x, X, w.1, w.2] ;
   module Tw = LG.TA'[x, X, (s.sb x).nt X w.1, w.2] ;
   veE (q : DD.Idx x X) : Id (SigT (G.ob q.2.1) (A.ty q.2.1) q.2.2.2.1) (T.SCA.rB q.2.1 q.2.2.2.1 (Tw'.ve q)) (Tw.ve q) =
    transH (T.SCA.rBtE q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1) q.2.2.2.1 (Tw'.ae q.2.2.2.1 q.2.2.2.2.1))
     (apH ((A.tE q.2.1 x (K.tot q.1 x q.2.1 q.2.2.1)).nt q.2.2.2.1) (T.SCA.rBact x q.2.2.2.1 X q.2.2.2.2.1 w)) ;
   core (q : DD.Idx x X) (l : DD.LandsI x X q)
    : Id (W0.Ix (T.DA.Ez q.2.1 q.2.2.2.1))
       (T.SCA.rB q.2.1 q.2.2.2.1 (T.DA'.prz q.2.1 q.2.2.2.1 (Tw'.tauP.1 q l) (Tw'.t q l)))
       (T.DA.prz q.2.1 q.2.2.2.1 (Tw.tauP.1 q l) (Tw.t q l)) =
    transH (apH (T.SCA.rB q.2.1 q.2.2.2.1) (Tw'.pc q l)) (transH (veE q) (symH (Tw.pc q l))) ;
  } ;

  -- the value of tau_A at (s d , a), moved along the path of types
  -- DAC-sub, is the value of tau_{A'} at (d , a)
  module Vx (x : CO) (X : Ob) (w : SigT (De.ob x) (T.A'.ty x) X) {
   module C0 = Cx[x, X, w] ;
   pG : T.DG.Ob' x X = C0.Tw.tauP ;
   pD : T.DE.Ob' x X = C0.Tw'.tauP ;
   pS : T.DG.Ob' x X = T.Ss.Sn[x, X, pD].res ;
   ptE : Id (T.DG.Ob' x X) pS pG = apH (\ t -> (t.sb x).nt X w.1) T.Ss.tau-nat ;
   vG : T.DA.TOb' x X pG = C0.Tw.res ;
   vD : T.DA'.TOb' x X pD = C0.Tw'.res ;
   R1 : Id W0.V (T.DA.tobV x X pG) (T.DA.tobV x X pS) = apH (T.DA.tobV x X) (symH ptE) ;
   R2 : Id W0.V (T.DA.tobV x X pS) (T.DA'.tobV x X pD) = T.Fb[x, X, pD].Pobj ;
   v1 : T.DA.TOb' x X pS = GPR.TyL[T.DG.obD x, T.DA.DTy x].coeT X pG pS (symH ptE) vG ;
   v2 : T.DA'.TOb' x X pD = VC.substIx (T.DA.tobV x X pS) (T.DA'.tobV x X pD) R2 v1 ;
   lhs : T.DA'.TOb' x X pD =
    PN.tyTr (De.ob x) ((LO.subCTy De G s T.DAG).ty x) (T.DAD.ty x) (apH (\ B -> B.ty x) T.DAC-sub) X w.1 vG ;
   e0 : Id (T.DA'.TOb' x X pD) lhs (VC.substIx (T.DA.tobV x X pG) (T.DA'.tobV x X pD) (transH R1 R2) vG) =
    PN.tyTr-ob (De.ob x) ((LO.subCTy De G s T.DAG).ty x) (T.DAD.ty x) (apH (\ B -> B.ty x) T.DAC-sub) X w.1 (transH R1 R2) vG ;
   e1 : Id (T.DA'.TOb' x X pD) (VC.substIx (T.DA.tobV x X pG) (T.DA'.tobV x X pD) (transH R1 R2) vG) v2 =
    transH (symH (PN.substIx-trans (T.DA.tobV x X pG) (T.DA.tobV x X pS) (T.DA'.tobV x X pD) R1 R2 (transH R1 R2) vG))
     (apH (VC.substIx (T.DA.tobV x X pS) (T.DA'.tobV x X pD) R2)
        (symH (PN.coeT-ob (T.DG.obD x) (T.DA.DTy x) X pG pS (symH ptE) R1 vG))) ;
   e2 : Id (T.DA'.TA x X pD) v2.1 v1.1 = T.Fb[x, X, pD].trO R2 v1 ;
   rd (q : DD.Idx x X) (l : DD.LandsI x X q) (t : T.DA.TotD x X) : W0.Ix (T.DA.Ez q.2.1 q.2.2.2.1) =
    T.DA.prz q.2.1 q.2.2.2.1 (t.1.1 q l) (t.2.1 q l) ;
   e3 (q : DD.Idx x X) (l : DD.LandsI x X q)
    : Id (W0.Ix (T.DA.Ez q.2.1 q.2.2.2.1)) (T.DA.prz q.2.1 q.2.2.2.1 (pS.1 q l) (v1.1 q l)) (T.DA.prz q.2.1 q.2.2.2.1 (pG.1 q l) (vG.1 q l)) =
    symH (apH (rd q l) (GPR.TyL[T.DG.obD x, T.DA.DTy x].pr-coe X pG pS (symH ptE) vG)) ;
   val (q : DD.Idx x X) (l : DD.LandsI x X q)
    : Id (W0.Ix ((A.ty q.2.1).tob q.2.2.2.1 (pS.1 q l))) (lhs.1 q l) (C0.Tw'.t q l) =
    GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-inj q.2.2.2.1 (pS.1 q l) (lhs.1 q l) (C0.Tw'.t q l)
     (transH (apH (\ b -> T.DA.prz q.2.1 q.2.2.2.1 (pS.1 q l) (b q l)) (transH (apH (\ u -> u.1) (transH e0 e1)) e2))
       (transH (e3 q l) (symH (C0.core q l)))) ;
   res : Id (T.DA'.TOb' x X pD) lhs vD = T.DA'.tob-eq x X pD lhs vD val ;
  } ;

  ------------------------------------------------------------------
  -- eta-nat: tau_A pulled back along s (CPshMapSub.subCMap) and moved
  -- along the path of types DAC-sub is tau_{A'}

  module CG = Cor15[a, l].C15[C, G, A] ;
  module CD = Cor15[a, l].C15[C, De, T.A'] ;
  module MSt = MSm.MS[De, G, s, A, T.DAG, CG.tauA] ;
  SDAG : P.CTy[De] = LO.subCTy De G s T.DAG ;
  sT : P13.CMap[De, T.A', SDAG] = MSt.res ;
  lhs : P13.CMap[De, T.A', T.DAD] = subst (P.CTy[De]) (\ Z -> P13.CMap[De, T.A', Z]) SDAG T.DAD T.DAC-sub sT ;

  module Px (x : CO) (W : Ob) (w : SigT (De.ob x) (T.A'.ty x) W) {
   module V0 = Vx[x, W, w] ;
   u : SigT (De.ob x) (SDAG.ty x) W = (MSt.mp x).mE W w ;
   uG : SigT (De.ob x) (SDAG.ty x) W = pairE (De.ob x) (SDAG.ty x) W w.1 V0.vG ;
   uE : Id (SigT (De.ob x) (SDAG.ty x) W) u uG = MSt.SCB.sub-eq x W u uG ((MSt.mp x).mpt W w) (MSt.rd x W w) ;
   Px0 : Id (PTy[De.ob x]) (SDAG.ty x) (T.DAD.ty x) = apH (\ B -> B.ty x) T.DAC-sub ;
   t1 : Id (SigT (De.ob x) (T.DAD.ty x) W) ((lhs.mp x).mE W w)
         (subst (PTy[De.ob x]) (\ T1 -> SigT (De.ob x) T1 W) (SDAG.ty x) (T.DAD.ty x) Px0 u) =
    cmapTr De T.A' SDAG T.DAD T.DAC-sub sT x W w ;
   t2 : Id (SigT (De.ob x) (T.DAD.ty x) W)
         (subst (PTy[De.ob x]) (\ T1 -> SigT (De.ob x) T1 W) (SDAG.ty x) (T.DAD.ty x) Px0 u)
         (subst (PTy[De.ob x]) (\ T1 -> SigT (De.ob x) T1 W) (SDAG.ty x) (T.DAD.ty x) Px0 uG) =
    apH (\ v -> subst (PTy[De.ob x]) (\ T1 -> SigT (De.ob x) T1 W) (SDAG.ty x) (T.DAD.ty x) Px0 v) uE ;
   t3 : Id (SigT (De.ob x) (T.DAD.ty x) W)
         (subst (PTy[De.ob x]) (\ T1 -> SigT (De.ob x) T1 W) (SDAG.ty x) (T.DAD.ty x) Px0 uG)
         (pairE (De.ob x) (T.DAD.ty x) W w.1 V0.lhs) =
    PN.totTr (De.ob x) (SDAG.ty x) (T.DAD.ty x) Px0 W uG ;
   t4 : Id (SigT (De.ob x) (T.DAD.ty x) W) (pairE (De.ob x) (T.DAD.ty x) W w.1 V0.lhs) ((CD.tauA.mp x).mE W w) =
    apH (\ v -> pairE (De.ob x) (T.DAD.ty x) W w.1 v) V0.res ;
   res : Id (SigT (De.ob x) (T.DAD.ty x) W) ((lhs.mp x).mE W w) ((CD.tauA.mp x).mE W w) =
    transH t1 (transH t2 (transH t3 t4)) ;
  } ;

  eta-nat : Id (P13.CMap[De, T.A', T.DAD]) lhs CD.tauA =
   MC.M[De, T.A', T.DAD].cmap-ext lhs CD.tauA (\ x ->
    CPshMapC[a, l].pmap-ext (De.ob x) (T.A'.ty x) (T.DAD.ty x) (lhs.mp x) (CD.tauA.mp x) (\ W w -> Px[x, W, w].res)) ;
 } ;
} ;
