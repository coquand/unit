-- CPshPiAp.seg (canonicity-c2; COBAR.md (B) stage 2(c), M2 L1): the
-- bridge between CPiE's application apW and CPshPi's values valAt, and
-- the naturality in C of application.
--
--   apW-valAt   (w , apW (b y f) h w) = valAt b y f h w
--   apC         B.tE g (w , apW (b y f) h w) = (A.tE g w , apW (b z (f g)) h (A.tE g w))
--               for b natural in C (cnat-at)
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;

module ApOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 open P ;

 module L (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) {
  module PC = PO.PiC[G, A, B] ;

  module At (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (u : PC.At[x, X, gm].PiIx) {
   module S = PC.At[x, X, gm] ;
   apW-valAt (y : CO) (f : CH y x) (K : Ob) (h : Hom K X) (wa : PC.TA y K)
    (q : Id (W0.Ix ((G.ob y).ob K)) (S.ptH y f K h) (fstE (G.ob y) (A.ty y) K wa))
    : Id (PC.TB y K) (PC.prB y K wa (PB.CPiE[l].PiE[G.ob y, A.ty y, B.ty y].apW X (S.ptC y f) (u.1 y f) K h wa q))
        (S.valAt u.1 y f K h wa (symH q)) =
    PB.CPiE[l].PiE[G.ob y, A.ty y, B.ty y].apW-E' X (S.ptC y f) (u.1 y f) K h wa q ;
   apC (z y : CO) (g : CH z y) (f : CH y x) (K : Ob) (h : Hom K X) (wa : PC.TA y K)
    (q : Id (W0.Ix ((G.ob y).ob K)) (S.ptH y f K h) (fstE (G.ob y) (A.ty y) K wa))
    (q' : Id (W0.Ix ((G.ob z).ob K)) (S.ptH z (co z y x f g) K h) (fstE (G.ob z) (A.ty z) K ((A.tE z y g).nt K wa)))
    : Id (PC.TB z K)
        ((B.tE z y g).nt K (PC.prB y K wa (PB.CPiE[l].PiE[G.ob y, A.ty y, B.ty y].apW X (S.ptC y f) (u.1 y f) K h wa q)))
        (PC.prB z K ((A.tE z y g).nt K wa)
           (PB.CPiE[l].PiE[G.ob z, A.ty z, B.ty z].apW X (S.ptC z (co z y x f g)) (u.1 z (co z y x f g)) K h ((A.tE z y g).nt K wa) q')) =
    transH (apH (\ t -> (B.tE z y g).nt K t) (apW-valAt y f K h wa q))
     (transH (S.cnat-at u z y g f K h wa (symH q) (symH q'))
       (symH (apW-valAt z (co z y x f g) K h ((A.tE z y g).nt K wa) q'))) ;
  } ;
 } ;
} ;
