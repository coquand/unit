-- CE1Tot3.seg (canonicity-45; COBAR.md "Prop 58"): total E1 by induction on
-- terms s of a presentation t: G's evaluation of s at the maps
-- g_i = tau . pre_(x_i) : yo(t) -> G is homotopic to tau . pre_(k_s) at the total
-- site (CE1Tot, CE1Tot2); the constants' case is a parameter here.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module T3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation) {
 module B = CE1Tot2[a].T2[R, encK, pe, t] ;
 module A = B.A ;
 module CM = A.CM ;
 module HO1 = A.HO1 ;
 module PS1 = A.G1.GB.GPre[a+].PS ;
 module Ind (cT : R.R -> HO1.NMap[A.P1, A.XT, A.GT])
   (cC : (r : R.R) -> PS1.PEl[PS1.extP A.P1 A.XT, HO1.HT[A.P1, A.XT, A.GT, cT r, A.Rs (cst r)].PT.PathP]) {
  Lv : A.TmT -> HO1.NMap[A.P1, A.XT, A.GT] = split {
   var v -> A.Rs (var v) ;
   cst r -> cT r ;
   sumE p q | lp lq -> A.AddG.AO.OP lp lq ;
   mulE p q | lp lq -> A.MulG.AO.OP lp lq } ;
  E1 : (s : A.TmT) -> PS1.PEl[PS1.extP A.P1 A.XT, HO1.HT[A.P1, A.XT, A.GT, Lv s, A.Rs s].PT.PathP] = split {
   var v -> HO1.Rf[A.P1, A.XT, A.GT, A.Rs (var v)].res ;
   cst r -> cC r ;
   sumE p q | rp rq -> B.OpS[CM.II.AddF.M.mor, CM.II.AddF.M.mor-nat, CM.II.AddF.SM.Phi, \ I f u -> refl ((CM.II.AddF.SM.Phi.eob I tt).1 I f u),
     sumE A.FR.x1 A.FR.x2, CM.II.AddF.SM.beta (var (inr tt)), p, q, Lv p, Lv q, rp, rq].res ;
   mulE p q | rp rq -> B.OpS[CM.II.MulF.M.mor, CM.II.MulF.M.mor-nat, CM.II.MulF.SM.Phi, \ I f u -> refl ((CM.II.MulF.SM.Phi.eob I tt).1 I f u),
     mulE A.FR.x1 A.FR.x2, CM.II.MulF.SM.beta (var (inr tt)), p, q, Lv p, Lv q, rp, rq].res } ;
 } ;
} ;
