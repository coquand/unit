-- CTotSet8.seg (canonicity-c2; "D preserves h-sets", part 8): the element
-- of CTotSet7 is natural: acting on it along a total map is building it
-- from the acted point, the acted element of R and the restricted
-- interval point (equal readings: D's TB.pc on both sides, ivA-comp).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module ST8 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module S7 = CTotSet7[a, vl, l].ST7[C, G, A] ;
 module S6 = S7.S6 ;
 module S1 = S7.S1 ;
 module G1 = S1.G1 ;
 module DI = S7.DI ;
 module DAm = S7.DAm ;
 module TR0 = S1.TR ;
 module VN (J0 I : Ob) (u0 : Hom J0 I) (y : DAm.Obj J0) (x : DAm.Obj I) (f0 : DAm.VT.HomD J0 I u0 y x)
   (k : W0.Ix (S1.K.ob (I, x))) (k' : W0.Ix (S1.K.ob (J0, y)))
   (rv : DI.TOb' I x (S1.phi2.nt (I, x) k))
   (ephi : Id (DI.D.Ob' J0 y) (DI.D.act J0 I u0 y x f0 (S1.phi2.nt (I, x) k)) (S1.phi2.nt (J0, y) k'))
   (jj : G1.GB.IvP (I, x))
   (egp : Id (DAm.D.Ob' J0 y) (DAm.D.act J0 I u0 y x f0 k.1.1) k'.1.1) {
  module VW = S7.VE[I, x, k, rv, jj] ;
  module RB = DI.TB[J0, I, u0, y, x, f0, S1.phi2.nt (I, x) k, S1.phi2.nt (J0, y) k', ephi, rv] ;
  module VV = S7.VE[J0, y, k', RB.res, G1.PB.ivA J0 I u0 jj] ;
  module AB = DAm.TB[J0, I, u0, y, x, f0, VW.gp, VV.gp, egp, VW.res] ;
  law : Id (DAm.TOb' J0 y VV.gp) AB.res VV.res =
   DAm.tob-eq J0 y VV.gp AB.res VV.res (\ q l ->
    DAm.pr-inj q.2.1 q.2.2.2.1 (VV.gp.1 q l) (AB.a' q l) (VV.av q l)
     (transH (AB.pc q l)
      (transH (VW.eqq (AB.sh q) l)
       (transH (apH {G1.GB.IvP (q.2.1, q.2.2.2.1)} {DAm.Ez q.2.1 q.2.2.2.1} (\ j -> S6.psi (q.2.1, q.2.2.2.1) j (VW.Xq (AB.sh q) l))
                  (symH (G1.PB.ivA-comp q.2.1 J0 I u0 q.2.2.1 jj)))
        (transH (apH {W0.Ix (S6.EI.ob (q.2.1, q.2.2.2.1))} {DAm.Ez q.2.1 q.2.2.2.1} (S6.psi (q.2.1, q.2.2.2.1) (VV.jq q))
                   (symH (RB.pc q l)))
          (symH (VV.eqq q l))))))) ;
 } ;
 -- the ends: at e0 the element is the first point of D A, at e1 the second
 module EN (I : Ob) (x : DAm.Obj I) (k : W0.Ix (S1.K.ob (I, x))) (rv : DI.TOb' I x (S1.phi2.nt (I, x) k)) {
  module V0 = S7.VE[I, x, k, rv, G1.PB.ptH I G1.GB.e0] ;
  module V1 = S7.VE[I, x, k, rv, G1.PB.ptH I G1.GB.e1] ;
  end0 : Id (DAm.TOb' I x V0.gp) V0.res k.1.2 =
   DAm.tob-eq I x V0.gp V0.res k.1.2 (\ q l ->
    DAm.pr-inj q.2.1 q.2.2.2.1 (V0.gp.1 q l) (V0.av q l) (k.1.2.1 q l)
     (transH (V0.eqq q l)
      (transH (apH {G1.GB.IvP (q.2.1, q.2.2.2.1)} {DAm.Ez q.2.1 q.2.2.2.1} (\ j -> S6.psi (q.2.1, q.2.2.2.1) j (V0.Xq q l))
                 (G1.PB.ptH-nat q.2.1 I q.2.2.1 G1.GB.e0))
       (transH (apH {W0.Ix (S1.A2.1.tob (q.2.1, q.2.2.2.1) (S6.Y.pt (q.2.1, q.2.2.2.1) (V0.zq q l) (q.2.1, q.2.2.2.1) (G1.GB.BC.idC (q.2.1, q.2.2.2.1))))}
                  {DAm.Ez q.2.1 q.2.2.2.1}
                  (\ c -> TR0.P1.pairE S6.GP A.1 (q.2.1, q.2.2.2.1) (S6.Y.pt (q.2.1, q.2.2.2.1) (V0.zq q l) (q.2.1, q.2.2.2.1) (G1.GB.BC.idC (q.2.1, q.2.2.2.1))).1.1 c)
                  ((rv.1 q l).1.2.2.1 (q.2.1, q.2.2.2.1) (G1.GB.BC.idC (q.2.1, q.2.2.2.1))))
         (apH {W0.Ix (S6.E1.ob (q.2.1, q.2.2.2.1))} {DAm.Ez q.2.1 q.2.2.2.1} (\ v -> TR0.P1.pairE S6.GP A.1 (q.2.1, q.2.2.2.1) v.1.1 v.1.2)
            (S6.E1.act-id (q.2.1, q.2.2.2.1) (V0.zq q l))))))) ;
  end1 : Id (DAm.TOb' I x V1.gp) V1.res k.2 =
   DAm.tob-eq I x V1.gp V1.res k.2 (\ q l ->
    DAm.pr-inj q.2.1 q.2.2.2.1 (V1.gp.1 q l) (V1.av q l) (k.2.1 q l)
     (transH (V1.eqq q l)
      (transH (apH {G1.GB.IvP (q.2.1, q.2.2.2.1)} {DAm.Ez q.2.1 q.2.2.2.1} (\ j -> S6.psi (q.2.1, q.2.2.2.1) j (V1.Xq q l))
                 (G1.PB.ptH-nat q.2.1 I q.2.2.1 G1.GB.e1))
       (transH (apH {W0.Ix (S1.A2.1.tob (q.2.1, q.2.2.2.1) (S6.Y.pt (q.2.1, q.2.2.2.1) (V1.zq q l) (q.2.1, q.2.2.2.1) (G1.GB.BC.idC (q.2.1, q.2.2.2.1))))}
                  {DAm.Ez q.2.1 q.2.2.2.1}
                  (\ c -> TR0.P1.pairE S6.GP A.1 (q.2.1, q.2.2.2.1) (S6.Y.pt (q.2.1, q.2.2.2.1) (V1.zq q l) (q.2.1, q.2.2.2.1) (G1.GB.BC.idC (q.2.1, q.2.2.2.1))).1.1 c)
                  ((rv.1 q l).1.2.2.2 (q.2.1, q.2.2.2.1) (G1.GB.BC.idC (q.2.1, q.2.2.2.1))))
         (apH {W0.Ix (S6.E1.ob (q.2.1, q.2.2.2.1))} {DAm.Ez q.2.1 q.2.2.2.1} (\ v -> TR0.P1.pairE S6.GP A.1 (q.2.1, q.2.2.2.1) v.1.1 v.2)
            (S6.E1.act-id (q.2.1, q.2.2.2.1) (V1.zq q l))))))) ;
 } ;
} ;
