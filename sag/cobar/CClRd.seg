-- CClRd.seg (canonicity-45; COBAR.md "comparison"): a closed internal Id
-- e : a = b (a, b elements over G) read as a path homotopy between the two
-- constant maps X -> Y, for any X (as CContrEq.IdRd, constant endpoints).
-- No new axioms beyond the named premises (fe).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;
module FCw = FibCwF[a, l] ;
module FC = FCw.FC ;
module LR = CLocBoundRetr[a, l] ;
module OV = CwFOv.Ov[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module S4 = CwFS4.S4[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;
module RD = FibIdRd[a, l] ;
module QI = QinvEq[a, l] ;
module KI = CwFKrInv.KrInv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;

module QP = CwFQP.QP[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module DR = CwFDer.Der[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;


module ClRd (G : PCtx) (Y : FC.STy G) (a0 b0 : FCw.fibCwF.El G Y)
  (e : FCw.fibCwF.El G (FibId[a, l].fibId.IdT G Y a0 b0)) (X : PTy[G]) {
  cA : HO.NMap[G, X, Y.1] = new HO.NMap[G, X, Y.1, \ I x w -> a0.eob I x, \ J I f x y e1 w -> a0.enat J I f x y e1] ;
  cB : HO.NMap[G, X, Y.1] = new HO.NMap[G, X, Y.1, \ I x w -> b0.eob I x, \ J I f x y e1 w -> b0.enat J I f x y e1] ;
  module T = HO.HT[G, X, Y.1, cA, cB] ;
  module TY = GPR.TyL[G, Y.1] ;
  module IY = PosIdY[a, l].IdY[G, Y.1, a0, b0] ;
  K : PCtx = extP G X ;
  tv (W : Ob) (z : W0.Ix (K.ob W)) (V : Ob) (g : Hom V W) (j : Hom V Iv) : TY.EI V = IY.rd W z.1 (e.eob W z.1) V g j ;
  tn (W : Ob) (z : W0.Ix (K.ob W)) (V' V : Ob) (g' : Hom V' V) (g : Hom V W) (j : Hom V Iv)
    : Id (TY.EI V') (TY.E.act V' V g' (tv W z V g j)) (tv W z V' (compH V' V W g g') (compH V' V Iv j g')) =
    transH (TY.pr-tact V' V g' (G.act V W g z.1) (G.act V' W (compH V' V W g g') z.1) (IY.ptn W z.1 V' V g' g) ((e.eob W z.1).1.1 V g j))
      (apH (TY.pr V' (G.act V' W (compH V' V W g g') z.1)) ((e.eob W z.1).1.2.1 V' V g' g j)) ;
  e0E (W : Ob) (z : W0.Ix (K.ob W)) : Id (TY.EI W) (tv W z W (idH W) (PB.ptH W PB.e0)) (T.aE W z) =
    transH (apH (TY.pr W (G.act W W (idH W) z.1)) ((e.eob W z.1).1.2.2.1 W (idH W)))
      (apH {W0.Ix (G.ob W)} {TY.EI W} (\ x2 -> TY.pr W x2 (a0.eob W x2)) (G.act-id W z.1)) ;
  e1E (W : Ob) (z : W0.Ix (K.ob W)) : Id (TY.EI W) (tv W z W (idH W) (PB.ptH W PB.e1)) (T.bE W z) =
    transH (apH (TY.pr W (G.act W W (idH W) z.1)) ((e.eob W z.1).1.2.2.2 W (idH W)))
      (apH {W0.Ix (G.ob W)} {TY.EI W} (\ x2 -> TY.pr W x2 (b0.eob W x2)) (G.act-id W z.1)) ;
  path (W : Ob) (z : W0.Ix (K.ob W)) : W0.Ix (T.PT.tobP W z) =
    T.PT.mkPath W z (tv W z) (\ V' V g' g j -> tn W z V' V g' g j) (\ V g j -> refl (G.act V W g z.1)) (e0E W z) (e1E W z) ;
  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (K.ob I)) (z' : W0.Ix (K.ob J)) (ee : Id (W0.Ix (K.ob J)) (K.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z') =
    T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z')
      (\ V f i -> transH (symH (IY.Tact[J, I, h, z.1, z'.1, apH {W0.Ix (K.ob J)} {W0.Ix (G.ob J)} (\ p -> p.1) ee, e.eob I z.1].rdc V f i))
         (apH (\ w2 -> IY.rd J z'.1 w2 V f i) (e.enat J I h z.1 z'.1 (apH {W0.Ix (K.ob J)} {W0.Ix (G.ob J)} (\ p -> p.1) ee)))) ;
  res : PEl[K, T.PT.PathP] = new PEl[K, T.PT.PathP, path, enat] ;
} ;

-- the same over the points of X: two elements a0, b0 of Y over G.X and an
-- Id between them give a homotopy between the two maps X -> Y they define
module PRd (G : PCtx) (X : PTy[G]) (Y : FC.STy G)
  (a0 b0 : FCw.fibCwF.El (extP G X) (FCw.fibCwF.subT (extP G X) G Y (pP G X)))
  (e : FCw.fibCwF.El (extP G X) (FibId[a, l].fibId.IdT (extP G X) (FCw.fibCwF.subT (extP G X) G Y (pP G X)) a0 b0)) {
  K : PCtx = extP G X ;
  YY : FC.STy K = FCw.fibCwF.subT K G Y (pP G X) ;
  mA : HO.NMap[G, X, Y.1] = new HO.NMap[G, X, Y.1, \ I x w -> a0.eob I (x, w),
    \ J I f x y e1 w -> transH (tact-irr G Y.1 J I f x y e1 (ntEq (extP G X) G (pP G X) J I f (x, w) (y, X.tact J I f x y e1 w) (pair-act G X J I f x y e1 w)) (a0.eob I (x, w)))
      (a0.enat J I f (x, w) (y, X.tact J I f x y e1 w) (pair-act G X J I f x y e1 w))] ;
  mB : HO.NMap[G, X, Y.1] = new HO.NMap[G, X, Y.1, \ I x w -> b0.eob I (x, w),
    \ J I f x y e1 w -> transH (tact-irr G Y.1 J I f x y e1 (ntEq (extP G X) G (pP G X) J I f (x, w) (y, X.tact J I f x y e1 w) (pair-act G X J I f x y e1 w)) (b0.eob I (x, w)))
      (b0.enat J I f (x, w) (y, X.tact J I f x y e1 w) (pair-act G X J I f x y e1 w))] ;
  module T = HO.HT[G, X, Y.1, mA, mB] ;
  module TY = GPR.TyL[G, Y.1] ;
  module IY = PosIdY[a, l].IdY[K, YY.1, a0, b0] ;
  mp (V : Ob) (q : IY.TA.EI V) : TY.EI V = TY.pr V (IY.TA.pr1 V q).1 (IY.TA.pr2 V q) ;
  tv (W : Ob) (z : W0.Ix (K.ob W)) (V : Ob) (g : Hom V W) (j : Hom V Iv) : TY.EI V = mp V (IY.rd W z (e.eob W z) V g j) ;
  tn (W : Ob) (z : W0.Ix (K.ob W)) (V' V : Ob) (g' : Hom V' V) (g : Hom V W) (j : Hom V Iv)
    : Id (TY.EI V') (TY.E.act V' V g' (tv W z V g j)) (tv W z V' (compH V' V W g g') (compH V' V Iv j g')) =
    transH (TY.pr-tact V' V g' (K.act V W g z).1 (K.act V' W (compH V' V W g g') z).1
              (ntEq K G (pP G X) V' V g' (K.act V W g z) (K.act V' W (compH V' V W g g') z) (IY.ptn W z V' V g' g)) ((e.eob W z).1.1 V g j))
      (apH (TY.pr V' (K.act V' W (compH V' V W g g') z).1) ((e.eob W z).1.2.1 V' V g' g j)) ;
  e0E (W : Ob) (z : W0.Ix (K.ob W)) : Id (TY.EI W) (tv W z W (idH W) (PB.ptH W PB.e0)) (T.aE W z) =
    transH (apH (TY.pr W (K.act W W (idH W) z).1) ((e.eob W z).1.2.2.1 W (idH W)))
      (apH {W0.Ix (K.ob W)} {TY.EI W} (\ z2 -> TY.pr W z2.1 (a0.eob W z2)) (K.act-id W z)) ;
  e1E (W : Ob) (z : W0.Ix (K.ob W)) : Id (TY.EI W) (tv W z W (idH W) (PB.ptH W PB.e1)) (T.bE W z) =
    transH (apH (TY.pr W (K.act W W (idH W) z).1) ((e.eob W z).1.2.2.2 W (idH W)))
      (apH {W0.Ix (K.ob W)} {TY.EI W} (\ z2 -> TY.pr W z2.1 (b0.eob W z2)) (K.act-id W z)) ;
  path (W : Ob) (z : W0.Ix (K.ob W)) : W0.Ix (T.PT.tobP W z) =
    T.PT.mkPath W z (tv W z) (\ V' V g' g j -> tn W z V' V g' g j) (\ V g j -> refl (G.act V W g z.1)) (e0E W z) (e1E W z) ;
  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (K.ob I)) (z' : W0.Ix (K.ob J)) (ee : Id (W0.Ix (K.ob J)) (K.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z') =
    T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z')
      (\ V f i -> transH (symH (apH (mp V) (IY.Tact[J, I, h, z, z', ee, e.eob I z].rdc V f i)))
         (apH (\ w2 -> mp V (IY.rd J z' w2 V f i)) (e.enat J I h z z' ee))) ;
  res : PEl[K, T.PT.PathP] = new PEl[K, T.PT.PathP, path, enat] ;
} ;
