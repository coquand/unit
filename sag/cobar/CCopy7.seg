-- CCopy7.seg (canonicity-45; COBAR.md "Lemma 59", item (1)): a relative
-- contraction on the levelwise site G0 restricts to each copy of the poset
-- site, for C with constant objects (the converse of CCopy4): a poset side
-- at (I, x) extends to a G0 side at (I, y) by transport along the
-- presentation equation of a G0 map (CCopy3's BK pattern); the copy's
-- extension is the G0 one at the extended side.
-- Specific to this C (constant objects).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RRes (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (G : CCopy[a].ConcC[R, encK, pe].P0.PCtx) (S T : CCopy[a].ConcC[R, encK, pe].P0.PTy[G])
  (m : CCopy[a].ConcC[R, encK, pe].G0.GB.CPartial[a+].PMap[G, S, T])
  (k0 : CCopy[a].ConcC[R, encK, pe].G0.GB.CPartial[a+].Rel[G, S, T, m].RC) (y : SX.Over[R].Presentation) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module G0 = CC.G0 ;
 module Cy = CC.Copy[y] ;
 module RL0 = G0.GB.CPartial[a+].Rel[G, S, T, m] ;
 module PS0 = RL0.PS' ;
 module TS0 = RL0.TS ;
 module TT0 = RL0.TT ;
 Gy : L.PCtx = Cy.rCy G ;
 Sy : L.PTy[Gy] = Cy.rTy G S ;
 Ty : L.PTy[Gy] = Cy.rTy G T ;
 my : PB.CPartial[a+].PMap[Gy, Sy, Ty] = Cy.rMy G S T m ;
 module RLy = PB.CPartial[a+].Rel[Gy, Sy, Ty, my] ;
 module PSy = RLy.PS' ;
 ObjT (J : Ob) : U a+ = V1.Ix (CC.CM.IC.obD J) ;
 module ES (I : Ob) (x : V1.Ix (G.ob (Cy.o0 I))) (sd : PSy.Side[I, x]) {
  pvq (W1 : Ob) (z : ObjT W1) (q : Id (ObjT W1) y z) (u : Hom W1 I) (i : PB.Lands W1 I sd.pQ u) : TS0.EI (W1, z) =
   subst (ObjT W1) (\ z2 -> TS0.EI (W1, z2)) y z q (sd.pv W1 u i) ;
  pv (W : G0.TOb) (f : G0.THm W (Cy.o0 I)) (i : G0.GB.Lands W (Cy.o0 I) sd.pQ f) : TS0.EI W = pvq W.1 W.2 (symH f.2) f.1 i ;
  -- the point condition, by induction on the presentation equation
  module PP (W : G0.TOb) (f : G0.THm W (Cy.o0 I)) (i : G0.GB.Lands W (Cy.o0 I) sd.pQ f) {
   Mot (y2 : ObjT W.1) (q : Id (ObjT W.1) y y2) : U a++ =
    Id (V1.Ix (G.ob (W.1, y2))) (TS0.pr1 (W.1, y2) (pvq W.1 y2 q f.1 i)) (G.act (W.1, y2) (Cy.o0 I) (f.1, symH q) x) ;
   gen : Mot W.2 (symH f.2) = idJ (ObjT W.1) y Mot (sd.ppt W.1 f.1 i) W.2 (symH f.2) ;
   ss : Id (Id (ObjT W.1) W.2 y) (symH (symH f.2)) f.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 y (symH (symH f.2)) f.2 ;
   law : Id (V1.Ix (G.ob W)) (TS0.pr1 W (pv W f i)) (G.act W (Cy.o0 I) f x) =
    subst (Id (ObjT W.1) W.2 y) (\ e2 -> Id (V1.Ix (G.ob W)) (TS0.pr1 W (pvq W.1 W.2 (symH f.2) f.1 i)) (G.act W (Cy.o0 I) (f.1, e2) x)) (symH (symH f.2)) f.2 ss gen ;
  } ;
  -- naturality, by induction on both presentation equations
  module PN (Vo W : G0.TOb) (g : G0.THm Vo W) (f : G0.THm W (Cy.o0 I)) (i : G0.GB.Lands W (Cy.o0 I) sd.pQ f)
    (i' : G0.GB.Lands Vo (Cy.o0 I) sd.pQ (G0.tcomp Vo W (Cy.o0 I) f g)) {
   St (y2 : ObjT W.1) (ek : Id (ObjT W.1) y2 y) (y3 : ObjT Vo.1) (eg : Id (ObjT Vo.1) y3 y2) : U a++ =
    (i2 : G0.GB.Lands (W.1, y2) (Cy.o0 I) sd.pQ (f.1, ek)) (i2' : G0.GB.Lands (Vo.1, y3) (Cy.o0 I) sd.pQ (G0.tcomp (Vo.1, y3) (W.1, y2) (Cy.o0 I) (f.1, ek) (g.1, eg)))
    -> Id (TS0.EI (Vo.1, y3)) (TS0.E.act (Vo.1, y3) (W.1, y2) (g.1, eg) (pvq W.1 y2 (symH ek) f.1 i2))
          (pvq Vo.1 y3 (symH (G0.tcomp (Vo.1, y3) (W.1, y2) (Cy.o0 I) (f.1, ek) (g.1, eg)).2) (G0.tcomp (Vo.1, y3) (W.1, y2) (Cy.o0 I) (f.1, ek) (g.1, eg)).1 i2') ;
   base : St y (refl y) y (refl y) = \ i2 i2' -> sd.pnat Vo.1 W.1 g.1 f.1 i2 i2' ;
   gen : (y2 : ObjT W.1) (q : Id (ObjT W.1) y y2) (y3 : ObjT Vo.1) (q' : Id (ObjT Vo.1) y2 y3) -> St y2 (symH q) y3 (symH q') =
    \ y2 q -> idJ (ObjT W.1) y (\ y4 q4 -> (y3 : ObjT Vo.1) (q' : Id (ObjT Vo.1) y4 y3) -> St y4 (symH q4) y3 (symH q'))
     (\ y3 q' -> idJ (ObjT Vo.1) y (\ y5 q5 -> St y (refl y) y5 (symH q5)) base y3 q') y2 q ;
   g0 : St W.2 (symH (symH f.2)) Vo.2 (symH (symH g.2)) = gen W.2 (symH f.2) Vo.2 (symH g.2) ;
   sk : Id (Id (ObjT W.1) W.2 y) (symH (symH f.2)) f.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 y (symH (symH f.2)) f.2 ;
   sg : Id (Id (ObjT Vo.1) Vo.2 W.2) (symH (symH g.2)) g.2 = V1.isSetIx (CC.CM.IC.obD Vo.1) Vo.2 W.2 (symH (symH g.2)) g.2 ;
   g1 : St W.2 (symH (symH f.2)) Vo.2 g.2 = subst (Id (ObjT Vo.1) Vo.2 W.2) (\ e2 -> St W.2 (symH (symH f.2)) Vo.2 e2) (symH (symH g.2)) g.2 sg g0 ;
   law : Id (TS0.EI Vo) (TS0.E.act Vo W g (pv W f i)) (pv Vo (G0.tcomp Vo W (Cy.o0 I) f g) i') =
    subst (Id (ObjT W.1) W.2 y) (\ e2 -> St W.2 e2 Vo.2 g.2) (symH (symH f.2)) f.2 sk g1 i i' ;
  } ;
  side : PS0.Side[Cy.o0 I, x] = PS0.mkSide (Cy.o0 I) x sd.pQ pv (\ W f i -> PP[W, f, i].law) (\ Vo W g f i i' -> PN[Vo, W, g, f, i, i'].law) ;
 } ;
 -- the restricted relative contraction
 kop (I : Ob) (x : V1.Ix (Gy.ob I)) (sd : PSy.Side[I, x]) : V1.Ix (Ty.tob I x) = k0.kop (Cy.o0 I) x ES[I, x, sd].side ;
 module KU (J I : Ob) (u : Hom J I) (x : V1.Ix (Gy.ob I)) (sd : PSy.Side[I, x]) {
  x' : V1.Ix (Gy.ob J) = Gy.act J I u x ;
  s0 : PS0.Side[Cy.o0 J, x'] = PS0.rside (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I u) x ES[I, x, sd].side ;
  s1 : PS0.Side[Cy.o0 J, x'] = ES[J, x', PSy.rside J I u x sd].side ;
  module PE (W : G0.TOb) (f : G0.THm W (Cy.o0 J)) (i : G0.GB.Lands W (Cy.o0 J) s0.pQ f) (i' : G0.GB.Lands W (Cy.o0 J) s1.pQ f) {
   fc : G0.THm W (Cy.o0 I) = G0.tcomp W (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I u) f ;
   eS : Id (Id (ObjT W.1) W.2 y) fc.2 f.2 = V1.isSetIx (CC.CM.IC.obD W.1) W.2 y fc.2 f.2 ;
   law : Id (TS0.EI W) (s0.pv W f i) (s1.pv W f i') =
    transH (apH {Id (ObjT W.1) W.2 y} {TS0.EI W} (\ e2 -> ES[I, x, sd].pvq W.1 W.2 (symH e2) fc.1 (G0.GB.lands-pre W (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I u) sd.pQ f i)) eS)
     (apH {PB.Lands W.1 I sd.pQ fc.1} {TS0.EI W} (\ j -> ES[I, x, sd].pvq W.1 W.2 (symH f.2) fc.1 j)
        (PB.isProp-Lands W.1 I sd.pQ fc.1 (G0.GB.lands-pre W (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I u) sd.pQ f i) (PB.lands-pre W.1 J I u sd.pQ f.1 i'))) ;
  } ;
  sEq : Id (PS0.Side[Cy.o0 J, x']) s0 s1 = PS0.side-ext (Cy.o0 J) x' s0 s1 (refl s0.pQ) (\ W f i i' -> PE[W, f, i, i'].law) ;
  law : Id (RL0.TT.EI (Cy.o0 J)) (RL0.TT.E.act (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I u) (G0.GB.GPre[a+].PS.pairE G T (Cy.o0 I) x (kop I x sd)))
         (G0.GB.GPre[a+].PS.pairE G T (Cy.o0 J) x' (kop J x' (PSy.rside J I u x sd))) =
   transH (k0.kunif (Cy.o0 J) (Cy.o0 I) (Cy.h0 J I u) x ES[I, x, sd].side)
    (RL0.kop-cong k0 (Cy.o0 J) x' x' (refl x') s0 s1 sEq) ;
 } ;
 rc : RLy.RC = RLy.mkRC kop (\ I x sd J u i -> k0.kside (Cy.o0 I) x ES[I, x, sd].side (Cy.o0 J) (Cy.h0 J I u) i) (\ J I u x sd -> KU[J, I, u, x, sd].law) ;
} ;
