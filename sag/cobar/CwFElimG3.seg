-- CwFElimG3.seg (canonicity-c2; SIMPLIFIED.md item 3, the quotient's
-- eliminator into sets): the recipe of CwFElimG2 over G.Z, with all data
-- weakened from G except the predicate, read at the section of z : Z, is
-- the recipe over G with the predicate read at z (RNs).
open Base ;

module ElimG3 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module X1 = CwFSetX1.SetX1[l, C, PS, SS, IJ, Un, NF] ;
  module G1 = CwFElimG1.ElimG1[l, C, PS, SS, IJ, Un, NF] ;
  module G2 = CwFElimG2.ElimG2[l, C, PS, SS, IJ, Un, NF] ;
  module H2 = CwFHed2.Hed2[l, C, PS, SS, IJ] ;

  -- p after upT
  p-upT (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    : Id (Sub (ext D A') G) (o (ext D A') (ext G A) G (p G A) (upT D G A s A' PA)) (o (ext D A') D G s (p D A')) =
    idJ (Ty D) (subT D G A s)
      (\ X PX -> Id (Sub (ext D X) G) (o (ext D X) (ext G A) G (p G A) (upT D G A s X PX)) (o (ext D X) D G s (p D X)))
      (p-lift D G A s) A' PA ;

  -- the family over G.Z: data weakened from G except the predicate
  module Fam (G : Ctx) (Z : Ty G) (B T0 : Ty G) (fD : El G (Fun G T0 B)) (PZ : El (ext G Z) (X1.FunU (ext G Z) (wkT G Z T0))) {
    GZ : Ctx = ext G Z ;
    Bw : Ty GZ = wkT G Z B ;
    T0w : Ty GZ = wkT G Z T0 ;
    PFw : Id (Ty GZ) (wkT G Z (Fun G T0 B)) (Fun GZ T0w Bw) = Fun-ov GZ G T0 B (p G Z) T0w (refl T0w) Bw (refl Bw) ;
    fw : El GZ (Fun GZ T0w Bw) = trE GZ (wkT G Z (Fun G T0 B)) (Fun GZ T0w Bw) PFw (wkE G Z (Fun G T0 B) fD) ;
    module RZ = G2.R[GZ, Bw, T0w, PZ, fw] ;
  } ;

  module RNs (G : Ctx) (Z : Ty G) (z : El G Z) (B T0 : Ty G) (fD : El G (Fun G T0 B))
    (PZ : El (ext G Z) (X1.FunU (ext G Z) (wkT G Z T0))) (Pz : El G (X1.FunU G T0))
    (oP : Ov G (ext G Z) (X1.FunU (ext G Z) (wkT G Z T0)) (sec G Z z) (X1.FunU G T0)
            (X1.PF G (ext G Z) (sec G Z z) (wkT G Z T0) T0 (p-sec-T G Z T0 z)) PZ Pz) {
    module FM = Fam[G, Z, B, T0, fD, PZ] ;
    GZ : Ctx = FM.GZ ;
    s : Sub G GZ = sec G Z z ;
    Bw : Ty GZ = FM.Bw ;
    T0w : Ty GZ = FM.T0w ;
    PFw : Id (Ty GZ) (wkT G Z (Fun G T0 B)) (Fun GZ T0w Bw) = FM.PFw ;
    fw : El GZ (Fun GZ T0w Bw) = FM.fw ;
    module RZ = FM.RZ ;
    module Rz = G2.R[G, B, T0, Pz, fD] ;
    PB : Id (Ty G) (subT G GZ Bw s) B = p-sec-T G Z B z ;
    PT0 : Id (Ty G) (subT G GZ T0w s) T0 = p-sec-T G Z T0 z ;
    u1 : Sub (ext G B) RZ.DB = upT G GZ Bw s B PB ;
    PT : Id (Ty (ext G B)) (subT (ext G B) RZ.DB RZ.T u1) Rz.T = wkT-ov G GZ Bw T0w s B PB T0 PT0 ;
    u2 : Sub Rz.E RZ.E = upT (ext G B) RZ.DB RZ.T u1 Rz.T PT ;
    -- the predicate
    PFu : Id (Ty (ext G B)) (subT (ext G B) RZ.DB (X1.FunU RZ.DB RZ.T) u1) (X1.FunU (ext G B) Rz.T) = X1.PF (ext G B) RZ.DB u1 RZ.T Rz.T PT ;
    PWu : Id (Ty (ext G B)) (subT (ext G B) RZ.DB (wkT GZ Bw (X1.FunU GZ T0w)) u1) (wkT G B (X1.FunU G T0)) =
      wkT-ov G GZ Bw (X1.FunU GZ T0w) s B PB (X1.FunU G T0) (X1.PF G GZ s T0w T0 PT0) ;
    oPw : Ov (ext G B) RZ.DB (X1.FunU RZ.DB RZ.T) u1 (X1.FunU (ext G B) Rz.T) PFu RZ.Pw Rz.Pw =
      ovTr (ext G B) RZ.DB (wkT GZ Bw (X1.FunU GZ T0w)) (X1.FunU RZ.DB RZ.T) RZ.PFw u1 (wkT G B (X1.FunU G T0)) (X1.FunU (ext G B) Rz.T) Rz.PFw
        PWu PFu (wkE GZ Bw (X1.FunU GZ T0w) PZ) (wkE G B (X1.FunU G T0) Pz)
        (wkE-ov G GZ Bw (X1.FunU GZ T0w) PZ s B PB (X1.FunU G T0) (X1.PF G GZ s T0w T0 PT0) Pz oP PWu) ;
    module RW = X1.RelOf[RZ.DB, RZ.T, RZ.Pw, RZ.Pw] ;
    module RW' = X1.RelOf[Rz.DB, Rz.T, Rz.Pw, Rz.Pw] ;
    PWB : Id (Ty Rz.E) (subT Rz.E RZ.E RW.WU u2) RW'.WU = wkT-ov (ext G B) RZ.DB RZ.T (PU.PropU RZ.DB) u1 Rz.T PT (PU.PropU (ext G B)) (PU.PropU-ov (ext G B) RZ.DB u1) ;
    ob : Ov Rz.E RZ.E RW.WU u2 RW'.WU PWB (bod RZ.DB RZ.T RW.WU RZ.Pw) (bod Rz.DB Rz.T RW'.WU Rz.Pw) =
      G2.bodOv (ext G B) RZ.DB RZ.T RW.WU u1 Rz.T PT RW'.WU PWB PFu RZ.Pw Rz.Pw oPw ;
    om : Ov Rz.E RZ.E (PU.PropU RZ.E) u2 (PU.PropU Rz.E) (PU.PropU-ov Rz.E RZ.E u2) RW.mP RW'.mP =
      ovTr Rz.E RZ.E RW.WU (PU.PropU RZ.E) RW.PWU u2 RW'.WU (PU.PropU Rz.E) RW'.PWU PWB (PU.PropU-ov Rz.E RZ.E u2)
        (bod RZ.DB RZ.T RW.WU RZ.Pw) (bod Rz.DB Rz.T RW'.WU Rz.Pw) ob ;
    PTP : Id (Ty Rz.E) (subT Rz.E RZ.E RZ.K.TP u2) Rz.K.TP = G1.decN Rz.E RZ.E u2 RW.mP RW'.mP om ;
    -- the value b
    PB2 : Id (Ty (ext G B)) (subT (ext G B) RZ.DB (wkT GZ Bw Bw) u1) (wkT G B B) = wkT-ov G GZ Bw Bw s B PB B PB ;
    PBE : Id (Ty Rz.E) (subT Rz.E RZ.E RZ.K.BE u2) Rz.K.BE = wkT-ov (ext G B) RZ.DB RZ.T (wkT GZ Bw Bw) u1 Rz.T PT (wkT G B B) PB2 ;
    obE : Ov Rz.E RZ.E RZ.K.BE u2 Rz.K.BE PBE RZ.K.bE Rz.K.bE =
      wkE-ov (ext G B) RZ.DB RZ.T (wkT GZ Bw Bw) (q GZ Bw) u1 Rz.T PT (wkT G B B) PB2 (q G B) (q-ov G GZ Bw s B PB PB2) PBE ;
    -- f at the variable a
    u3 : Sub (ext G T0) (ext GZ T0w) = upT G GZ T0w s T0 PT0 ;
    WBZ : Ty (ext GZ T0w) = wkT GZ T0w Bw ;
    PWB3 : Id (Ty (ext G T0)) (subT (ext G T0) (ext GZ T0w) WBZ u3) (wkT G T0 B) = wkT-ov G GZ T0w Bw s T0 PT0 B PB ;
    PFf : Id (Ty G) (subT G GZ (Fun GZ T0w Bw) s) (Fun G T0 B) = Fun-ov G GZ T0w Bw s T0 PT0 B PB ;
    ofw : Ov G GZ (Fun GZ T0w Bw) s (Fun G T0 B) PFf fw fD =
      ovTr G GZ (wkT G Z (Fun G T0 B)) (Fun GZ T0w Bw) PFw s (Fun G T0 B) (Fun G T0 B) (refl (Fun G T0 B)) (p-sec-T G Z (Fun G T0 B) z) PFf
        (wkE G Z (Fun G T0 B) fD) fD (IN.wkE-sec G Z (Fun G T0 B) z fD (p-sec-T G Z (Fun G T0 B) z)) ;
    ob3 : Ov (ext G T0) (ext GZ T0w) WBZ u3 (wkT G T0 B) PWB3 RZ.bodf Rz.bodf = G2.bodOv G GZ T0w WBZ s T0 PT0 (wkT G T0 B) PWB3 PFf fw fD ofw ;
    s1 : Sub Rz.E (ext GZ T0w) = o Rz.E RZ.E (ext GZ T0w) RZ.lf u2 ;
    s2 : Sub Rz.E (ext GZ T0w) = o Rz.E (ext G T0) (ext GZ T0w) u3 Rz.lf ;
    pB : Sub Rz.E G = o Rz.E (ext G B) G (p G B) (p (ext G B) Rz.T) ;
    pe1 : Id (Sub Rz.E GZ) (o Rz.E (ext GZ T0w) GZ (p GZ T0w) s1) (o Rz.E G GZ s pB) =
      calc (Sub Rz.E GZ) {
          o Rz.E (ext GZ T0w) GZ (p GZ T0w) s1
        =< sym (Sub Rz.E GZ) (o Rz.E RZ.E GZ (o RZ.E (ext GZ T0w) GZ (p GZ T0w) RZ.lf) u2) (o Rz.E (ext GZ T0w) GZ (p GZ T0w) s1)
             (o-assoc Rz.E RZ.E (ext GZ T0w) GZ (p GZ T0w) RZ.lf u2) >
          o Rz.E RZ.E GZ (o RZ.E (ext GZ T0w) GZ (p GZ T0w) RZ.lf) u2
        =< ap (Sub RZ.E GZ) (Sub Rz.E GZ) (\ r -> o Rz.E RZ.E GZ r u2) (o RZ.E (ext GZ T0w) GZ (p GZ T0w) RZ.lf)
             (o RZ.E RZ.DB GZ (p GZ Bw) (p RZ.DB RZ.T)) (p-lift RZ.DB GZ T0w (p GZ Bw)) >
          o Rz.E RZ.E GZ (o RZ.E RZ.DB GZ (p GZ Bw) (p RZ.DB RZ.T)) u2
        =< o-assoc Rz.E RZ.E RZ.DB GZ (p GZ Bw) (p RZ.DB RZ.T) u2 >
          o Rz.E RZ.DB GZ (p GZ Bw) (o Rz.E RZ.E RZ.DB (p RZ.DB RZ.T) u2)
        =< ap (Sub Rz.E RZ.DB) (Sub Rz.E GZ) (\ r -> o Rz.E RZ.DB GZ (p GZ Bw) r) (o Rz.E RZ.E RZ.DB (p RZ.DB RZ.T) u2)
             (o Rz.E (ext G B) RZ.DB u1 (p (ext G B) Rz.T)) (p-upT (ext G B) RZ.DB RZ.T u1 Rz.T PT) >
          o Rz.E RZ.DB GZ (p GZ Bw) (o Rz.E (ext G B) RZ.DB u1 (p (ext G B) Rz.T))
        =< sym (Sub Rz.E GZ) (o Rz.E (ext G B) GZ (o (ext G B) RZ.DB GZ (p GZ Bw) u1) (p (ext G B) Rz.T))
             (o Rz.E RZ.DB GZ (p GZ Bw) (o Rz.E (ext G B) RZ.DB u1 (p (ext G B) Rz.T)))
             (o-assoc Rz.E (ext G B) RZ.DB GZ (p GZ Bw) u1 (p (ext G B) Rz.T)) >
          o Rz.E (ext G B) GZ (o (ext G B) RZ.DB GZ (p GZ Bw) u1) (p (ext G B) Rz.T)
        =< ap (Sub (ext G B) GZ) (Sub Rz.E GZ) (\ r -> o Rz.E (ext G B) GZ r (p (ext G B) Rz.T)) (o (ext G B) RZ.DB GZ (p GZ Bw) u1)
             (o (ext G B) G GZ s (p G B)) (p-upT G GZ Bw s B PB) >
          o Rz.E (ext G B) GZ (o (ext G B) G GZ s (p G B)) (p (ext G B) Rz.T)
        =< o-assoc Rz.E (ext G B) G GZ s (p G B) (p (ext G B) Rz.T) >
          o Rz.E G GZ s pB } ;
    pe2 : Id (Sub Rz.E GZ) (o Rz.E (ext GZ T0w) GZ (p GZ T0w) s2) (o Rz.E G GZ s pB) =
      calc (Sub Rz.E GZ) {
          o Rz.E (ext GZ T0w) GZ (p GZ T0w) s2
        =< sym (Sub Rz.E GZ) (o Rz.E (ext G T0) GZ (o (ext G T0) (ext GZ T0w) GZ (p GZ T0w) u3) Rz.lf) (o Rz.E (ext GZ T0w) GZ (p GZ T0w) s2)
             (o-assoc Rz.E (ext G T0) (ext GZ T0w) GZ (p GZ T0w) u3 Rz.lf) >
          o Rz.E (ext G T0) GZ (o (ext G T0) (ext GZ T0w) GZ (p GZ T0w) u3) Rz.lf
        =< ap (Sub (ext G T0) GZ) (Sub Rz.E GZ) (\ r -> o Rz.E (ext G T0) GZ r Rz.lf) (o (ext G T0) (ext GZ T0w) GZ (p GZ T0w) u3)
             (o (ext G T0) G GZ s (p G T0)) (p-upT G GZ T0w s T0 PT0) >
          o Rz.E (ext G T0) GZ (o (ext G T0) G GZ s (p G T0)) Rz.lf
        =< o-assoc Rz.E (ext G T0) G GZ s (p G T0) Rz.lf >
          o Rz.E G GZ s (o Rz.E (ext G T0) G (p G T0) Rz.lf)
        =< ap (Sub Rz.E G) (Sub Rz.E GZ) (\ r -> o Rz.E G GZ s r) (o Rz.E (ext G T0) G (p G T0) Rz.lf) pB (p-lift (ext G B) G T0 (p G B)) >
          o Rz.E G GZ s pB } ;
    WT : Ty Rz.E = wkT Rz.DB Rz.T Rz.T ;
    PW1 : Id (Ty RZ.E) (subT RZ.E (ext GZ T0w) (wkT GZ T0w T0w) RZ.lf) (wkT RZ.DB RZ.T RZ.T) =
      wkT-ov RZ.DB GZ T0w T0w (p GZ Bw) RZ.T (refl RZ.T) RZ.T (refl RZ.T) ;
    PW2 : Id (Ty Rz.E) (subT Rz.E RZ.E (wkT RZ.DB RZ.T RZ.T) u2) WT = wkT-ov (ext G B) RZ.DB RZ.T RZ.T u1 Rz.T PT Rz.T PT ;
    q1 : Ov Rz.E (ext GZ T0w) (wkT GZ T0w T0w) s1 WT (H2.comp3 Rz.E RZ.E (ext GZ T0w) (wkT GZ T0w T0w) RZ.lf u2 (wkT RZ.DB RZ.T RZ.T) PW1 WT PW2) (q GZ T0w) (q Rz.DB Rz.T) =
      H2.ovC Rz.E RZ.E (ext GZ T0w) (wkT GZ T0w T0w) RZ.lf u2 (wkT RZ.DB RZ.T RZ.T) PW1 WT PW2 (q GZ T0w) (q RZ.DB RZ.T) (q Rz.DB Rz.T)
        (q-ov RZ.DB GZ T0w (p GZ Bw) RZ.T (refl RZ.T) PW1) (q-ov (ext G B) RZ.DB RZ.T u1 Rz.T PT PW2) ;
    PW3 : Id (Ty (ext G T0)) (subT (ext G T0) (ext GZ T0w) (wkT GZ T0w T0w) u3) (wkT G T0 T0) = wkT-ov G GZ T0w T0w s T0 PT0 T0 PT0 ;
    PW4 : Id (Ty Rz.E) (subT Rz.E (ext G T0) (wkT G T0 T0) Rz.lf) WT = wkT-ov (ext G B) G T0 T0 (p G B) Rz.T (refl Rz.T) Rz.T (refl Rz.T) ;
    q2 : Ov Rz.E (ext GZ T0w) (wkT GZ T0w T0w) s2 WT (H2.comp3 Rz.E (ext G T0) (ext GZ T0w) (wkT GZ T0w T0w) u3 Rz.lf (wkT G T0 T0) PW3 WT PW4) (q GZ T0w) (q Rz.DB Rz.T) =
      H2.ovC Rz.E (ext G T0) (ext GZ T0w) (wkT GZ T0w T0w) u3 Rz.lf (wkT G T0 T0) PW3 WT PW4 (q GZ T0w) (q G T0) (q Rz.DB Rz.T)
        (q-ov G GZ T0w s T0 PT0 PW3) (q-ov (ext G B) G T0 (p G B) Rz.T (refl Rz.T) PW4) ;
    eL : Id (Sub Rz.E (ext GZ T0w)) s1 s2 =
      IN.ext-eq Rz.E GZ T0w s1 s2 (trans (Sub Rz.E GZ) (o Rz.E (ext GZ T0w) GZ (p GZ T0w) s1) (o Rz.E G GZ s pB) (o Rz.E (ext GZ T0w) GZ (p GZ T0w) s2) pe1
          (sym (Sub Rz.E GZ) (o Rz.E (ext GZ T0w) GZ (p GZ T0w) s2) (o Rz.E G GZ s pB) pe2))
        WT (q Rz.DB Rz.T)
        (H2.comp3 Rz.E RZ.E (ext GZ T0w) (wkT GZ T0w T0w) RZ.lf u2 (wkT RZ.DB RZ.T RZ.T) PW1 WT PW2) q1
        (H2.comp3 Rz.E (ext G T0) (ext GZ T0w) (wkT GZ T0w T0w) u3 Rz.lf (wkT G T0 T0) PW3 WT PW4) q2 ;
    t2 : El Rz.E Rz.K.BE = trE Rz.E (subT Rz.E RZ.E RZ.K.BE u2) Rz.K.BE PBE (subt Rz.E RZ.E RZ.K.BE RZ.fa u2) ;
    oA : Ov Rz.E (ext GZ T0w) WBZ s1 Rz.K.BE (H2.comp3 Rz.E RZ.E (ext GZ T0w) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE) RZ.bodf t2 =
      H2.ovC Rz.E RZ.E (ext GZ T0w) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE RZ.bodf RZ.fa t2 (refl RZ.fa) (refl t2) ;
    oB : Ov Rz.E (ext GZ T0w) WBZ s2 Rz.K.BE (H2.comp3 Rz.E (ext G T0) (ext GZ T0w) WBZ u3 Rz.lf (wkT G T0 B) PWB3 Rz.K.BE Rz.PLF) RZ.bodf Rz.fa =
      H2.ovC Rz.E (ext G T0) (ext GZ T0w) WBZ u3 Rz.lf (wkT G T0 B) PWB3 Rz.K.BE Rz.PLF RZ.bodf Rz.bodf Rz.fa ob3 (refl Rz.fa) ;
    ofa : Ov Rz.E RZ.E RZ.K.BE u2 Rz.K.BE PBE RZ.fa Rz.fa =
      trans (El Rz.E Rz.K.BE) t2
        (trE Rz.E (subT Rz.E (ext GZ T0w) WBZ s1) Rz.K.BE (H2.comp3 Rz.E RZ.E (ext GZ T0w) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE) (subt Rz.E (ext GZ T0w) WBZ RZ.bodf s1))
        Rz.fa
        (sym (El Rz.E Rz.K.BE) (trE Rz.E (subT Rz.E (ext GZ T0w) WBZ s1) Rz.K.BE (H2.comp3 Rz.E RZ.E (ext GZ T0w) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE) (subt Rz.E (ext GZ T0w) WBZ RZ.bodf s1)) t2 oA)
        (trans (El Rz.E Rz.K.BE)
           (trE Rz.E (subT Rz.E (ext GZ T0w) WBZ s1) Rz.K.BE (H2.comp3 Rz.E RZ.E (ext GZ T0w) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE) (subt Rz.E (ext GZ T0w) WBZ RZ.bodf s1))
           (trE Rz.E (subT Rz.E (ext GZ T0w) WBZ s2) Rz.K.BE (H2.comp3 Rz.E (ext G T0) (ext GZ T0w) WBZ u3 Rz.lf (wkT G T0 B) PWB3 Rz.K.BE Rz.PLF) (subt Rz.E (ext GZ T0w) WBZ RZ.bodf s2))
           Rz.fa
           (SJ.subtEq Rz.E (ext GZ T0w) WBZ RZ.bodf s1 s2 eL Rz.K.BE (H2.comp3 Rz.E RZ.E (ext GZ T0w) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE)
              (H2.comp3 Rz.E (ext G T0) (ext GZ T0w) WBZ u3 Rz.lf (wkT G T0 B) PWB3 Rz.K.BE Rz.PLF))
           oB) ;
    -- the family
    Fo : Id (Ty Rz.E) (subT Rz.E RZ.E RZ.K.F u2) Rz.K.F =
      G1.FN Rz.E RZ.E u2 RZ.K.TP Rz.K.TP PTP RZ.K.BE Rz.K.BE PBE RZ.fa RZ.K.bE Rz.fa Rz.K.bE ofa obE ;
    Ho : Id (Ty (ext G B)) (subT (ext G B) RZ.DB RZ.K.H u1) Rz.K.H = Pi-ov (ext G B) RZ.DB RZ.T RZ.K.F u1 Rz.T PT Rz.K.F Fo ;
    law : Id (Ty G) (subT G GZ RZ.K.CF s) Rz.K.CF = Sig-ov G GZ Bw RZ.K.H s B PB Rz.K.H Ho ;
  } ;
  -- the same along any substitution s, with the data substituted (RNg)
  module RNg (D' D : Ctx) (s : Sub D' D) (B T0 : Ty D) (fD : El D (Fun D T0 B)) (P0 : El D (X1.FunU D T0))
    (P0' : El D' (X1.FunU D' (subT D' D T0 s)))
    (oP : Ov D' D (X1.FunU D T0) s (X1.FunU D' (subT D' D T0 s)) (X1.PF D' D s T0 (subT D' D T0 s) (refl (subT D' D T0 s))) P0 P0')
    (fD' : El D' (Fun D' (subT D' D T0 s) (subT D' D B s)))
    (ofD : Ov D' D (Fun D T0 B) s (Fun D' (subT D' D T0 s) (subT D' D B s))
             (Fun-ov D' D T0 B s (subT D' D T0 s) (refl (subT D' D T0 s)) (subT D' D B s) (refl (subT D' D B s))) fD fD') {
    Bs : Ty D' = subT D' D B s ;
    T0s : Ty D' = subT D' D T0 s ;
    PB : Id (Ty D') (subT D' D B s) Bs = refl Bs ;
    PT0 : Id (Ty D') (subT D' D T0 s) T0s = refl T0s ;
    PFf : Id (Ty D') (subT D' D (Fun D T0 B) s) (Fun D' T0s Bs) = Fun-ov D' D T0 B s T0s PT0 Bs PB ;
    module RZ = G2.R[D, B, T0, P0, fD] ;
    module Rz = G2.R[D', Bs, T0s, P0', fD'] ;
    u1 : Sub (ext D' Bs) RZ.DB = upT D' D B s Bs PB ;
    PT : Id (Ty (ext D' Bs)) (subT (ext D' Bs) RZ.DB RZ.T u1) Rz.T = wkT-ov D' D B T0 s Bs PB T0s PT0 ;
    u2 : Sub Rz.E RZ.E = upT (ext D' Bs) RZ.DB RZ.T u1 Rz.T PT ;
    -- the predicate
    PFu : Id (Ty (ext D' Bs)) (subT (ext D' Bs) RZ.DB (X1.FunU RZ.DB RZ.T) u1) (X1.FunU (ext D' Bs) Rz.T) = X1.PF (ext D' Bs) RZ.DB u1 RZ.T Rz.T PT ;
    PWu : Id (Ty (ext D' Bs)) (subT (ext D' Bs) RZ.DB (wkT D B (X1.FunU D T0)) u1) (wkT D' Bs (X1.FunU D' T0s)) =
      wkT-ov D' D B (X1.FunU D T0) s Bs PB (X1.FunU D' T0s) (X1.PF D' D s T0 T0s PT0) ;
    oPw : Ov (ext D' Bs) RZ.DB (X1.FunU RZ.DB RZ.T) u1 (X1.FunU (ext D' Bs) Rz.T) PFu RZ.Pw Rz.Pw =
      ovTr (ext D' Bs) RZ.DB (wkT D B (X1.FunU D T0)) (X1.FunU RZ.DB RZ.T) RZ.PFw u1 (wkT D' Bs (X1.FunU D' T0s)) (X1.FunU (ext D' Bs) Rz.T) Rz.PFw
        PWu PFu (wkE D B (X1.FunU D T0) P0) (wkE D' Bs (X1.FunU D' T0s) P0')
        (wkE-ov D' D B (X1.FunU D T0) P0 s Bs PB (X1.FunU D' T0s) (X1.PF D' D s T0 T0s PT0) P0' oP PWu) ;
    module RW = X1.RelOf[RZ.DB, RZ.T, RZ.Pw, RZ.Pw] ;
    module RW' = X1.RelOf[Rz.DB, Rz.T, Rz.Pw, Rz.Pw] ;
    PWB : Id (Ty Rz.E) (subT Rz.E RZ.E RW.WU u2) RW'.WU = wkT-ov (ext D' Bs) RZ.DB RZ.T (PU.PropU RZ.DB) u1 Rz.T PT (PU.PropU (ext D' Bs)) (PU.PropU-ov (ext D' Bs) RZ.DB u1) ;
    ob : Ov Rz.E RZ.E RW.WU u2 RW'.WU PWB (bod RZ.DB RZ.T RW.WU RZ.Pw) (bod Rz.DB Rz.T RW'.WU Rz.Pw) =
      G2.bodOv (ext D' Bs) RZ.DB RZ.T RW.WU u1 Rz.T PT RW'.WU PWB PFu RZ.Pw Rz.Pw oPw ;
    om : Ov Rz.E RZ.E (PU.PropU RZ.E) u2 (PU.PropU Rz.E) (PU.PropU-ov Rz.E RZ.E u2) RW.mP RW'.mP =
      ovTr Rz.E RZ.E RW.WU (PU.PropU RZ.E) RW.PWU u2 RW'.WU (PU.PropU Rz.E) RW'.PWU PWB (PU.PropU-ov Rz.E RZ.E u2)
        (bod RZ.DB RZ.T RW.WU RZ.Pw) (bod Rz.DB Rz.T RW'.WU Rz.Pw) ob ;
    PTP : Id (Ty Rz.E) (subT Rz.E RZ.E RZ.K.TP u2) Rz.K.TP = G1.decN Rz.E RZ.E u2 RW.mP RW'.mP om ;
    -- the value b
    PB2 : Id (Ty (ext D' Bs)) (subT (ext D' Bs) RZ.DB (wkT D B B) u1) (wkT D' Bs Bs) = wkT-ov D' D B B s Bs PB Bs PB ;
    PBE : Id (Ty Rz.E) (subT Rz.E RZ.E RZ.K.BE u2) Rz.K.BE = wkT-ov (ext D' Bs) RZ.DB RZ.T (wkT D B B) u1 Rz.T PT (wkT D' Bs Bs) PB2 ;
    obE : Ov Rz.E RZ.E RZ.K.BE u2 Rz.K.BE PBE RZ.K.bE Rz.K.bE =
      wkE-ov (ext D' Bs) RZ.DB RZ.T (wkT D B B) (q D B) u1 Rz.T PT (wkT D' Bs Bs) PB2 (q D' Bs) (q-ov D' D B s Bs PB PB2) PBE ;
    -- f at the variable a
    u3 : Sub (ext D' T0s) (ext D T0) = upT D' D T0 s T0s PT0 ;
    WBZ : Ty (ext D T0) = wkT D T0 B ;
    PWB3 : Id (Ty (ext D' T0s)) (subT (ext D' T0s) (ext D T0) WBZ u3) (wkT D' T0s Bs) = wkT-ov D' D T0 B s T0s PT0 Bs PB ;
    ob3 : Ov (ext D' T0s) (ext D T0) WBZ u3 (wkT D' T0s Bs) PWB3 RZ.bodf Rz.bodf = G2.bodOv D' D T0 WBZ s T0s PT0 (wkT D' T0s Bs) PWB3 PFf fD fD' ofD ;
    s1 : Sub Rz.E (ext D T0) = o Rz.E RZ.E (ext D T0) RZ.lf u2 ;
    s2 : Sub Rz.E (ext D T0) = o Rz.E (ext D' T0s) (ext D T0) u3 Rz.lf ;
    pB : Sub Rz.E D' = o Rz.E (ext D' Bs) D' (p D' Bs) (p (ext D' Bs) Rz.T) ;
    pe1 : Id (Sub Rz.E D) (o Rz.E (ext D T0) D (p D T0) s1) (o Rz.E D' D s pB) =
      calc (Sub Rz.E D) {
          o Rz.E (ext D T0) D (p D T0) s1
        =< sym (Sub Rz.E D) (o Rz.E RZ.E D (o RZ.E (ext D T0) D (p D T0) RZ.lf) u2) (o Rz.E (ext D T0) D (p D T0) s1)
             (o-assoc Rz.E RZ.E (ext D T0) D (p D T0) RZ.lf u2) >
          o Rz.E RZ.E D (o RZ.E (ext D T0) D (p D T0) RZ.lf) u2
        =< ap (Sub RZ.E D) (Sub Rz.E D) (\ r -> o Rz.E RZ.E D r u2) (o RZ.E (ext D T0) D (p D T0) RZ.lf)
             (o RZ.E RZ.DB D (p D B) (p RZ.DB RZ.T)) (p-lift RZ.DB D T0 (p D B)) >
          o Rz.E RZ.E D (o RZ.E RZ.DB D (p D B) (p RZ.DB RZ.T)) u2
        =< o-assoc Rz.E RZ.E RZ.DB D (p D B) (p RZ.DB RZ.T) u2 >
          o Rz.E RZ.DB D (p D B) (o Rz.E RZ.E RZ.DB (p RZ.DB RZ.T) u2)
        =< ap (Sub Rz.E RZ.DB) (Sub Rz.E D) (\ r -> o Rz.E RZ.DB D (p D B) r) (o Rz.E RZ.E RZ.DB (p RZ.DB RZ.T) u2)
             (o Rz.E (ext D' Bs) RZ.DB u1 (p (ext D' Bs) Rz.T)) (p-upT (ext D' Bs) RZ.DB RZ.T u1 Rz.T PT) >
          o Rz.E RZ.DB D (p D B) (o Rz.E (ext D' Bs) RZ.DB u1 (p (ext D' Bs) Rz.T))
        =< sym (Sub Rz.E D) (o Rz.E (ext D' Bs) D (o (ext D' Bs) RZ.DB D (p D B) u1) (p (ext D' Bs) Rz.T))
             (o Rz.E RZ.DB D (p D B) (o Rz.E (ext D' Bs) RZ.DB u1 (p (ext D' Bs) Rz.T)))
             (o-assoc Rz.E (ext D' Bs) RZ.DB D (p D B) u1 (p (ext D' Bs) Rz.T)) >
          o Rz.E (ext D' Bs) D (o (ext D' Bs) RZ.DB D (p D B) u1) (p (ext D' Bs) Rz.T)
        =< ap (Sub (ext D' Bs) D) (Sub Rz.E D) (\ r -> o Rz.E (ext D' Bs) D r (p (ext D' Bs) Rz.T)) (o (ext D' Bs) RZ.DB D (p D B) u1)
             (o (ext D' Bs) D' D s (p D' Bs)) (p-upT D' D B s Bs PB) >
          o Rz.E (ext D' Bs) D (o (ext D' Bs) D' D s (p D' Bs)) (p (ext D' Bs) Rz.T)
        =< o-assoc Rz.E (ext D' Bs) D' D s (p D' Bs) (p (ext D' Bs) Rz.T) >
          o Rz.E D' D s pB } ;
    pe2 : Id (Sub Rz.E D) (o Rz.E (ext D T0) D (p D T0) s2) (o Rz.E D' D s pB) =
      calc (Sub Rz.E D) {
          o Rz.E (ext D T0) D (p D T0) s2
        =< sym (Sub Rz.E D) (o Rz.E (ext D' T0s) D (o (ext D' T0s) (ext D T0) D (p D T0) u3) Rz.lf) (o Rz.E (ext D T0) D (p D T0) s2)
             (o-assoc Rz.E (ext D' T0s) (ext D T0) D (p D T0) u3 Rz.lf) >
          o Rz.E (ext D' T0s) D (o (ext D' T0s) (ext D T0) D (p D T0) u3) Rz.lf
        =< ap (Sub (ext D' T0s) D) (Sub Rz.E D) (\ r -> o Rz.E (ext D' T0s) D r Rz.lf) (o (ext D' T0s) (ext D T0) D (p D T0) u3)
             (o (ext D' T0s) D' D s (p D' T0s)) (p-upT D' D T0 s T0s PT0) >
          o Rz.E (ext D' T0s) D (o (ext D' T0s) D' D s (p D' T0s)) Rz.lf
        =< o-assoc Rz.E (ext D' T0s) D' D s (p D' T0s) Rz.lf >
          o Rz.E D' D s (o Rz.E (ext D' T0s) D' (p D' T0s) Rz.lf)
        =< ap (Sub Rz.E D') (Sub Rz.E D) (\ r -> o Rz.E D' D s r) (o Rz.E (ext D' T0s) D' (p D' T0s) Rz.lf) pB (p-lift (ext D' Bs) D' T0s (p D' Bs)) >
          o Rz.E D' D s pB } ;
    WT : Ty Rz.E = wkT Rz.DB Rz.T Rz.T ;
    PW1 : Id (Ty RZ.E) (subT RZ.E (ext D T0) (wkT D T0 T0) RZ.lf) (wkT RZ.DB RZ.T RZ.T) =
      wkT-ov RZ.DB D T0 T0 (p D B) RZ.T (refl RZ.T) RZ.T (refl RZ.T) ;
    PW2 : Id (Ty Rz.E) (subT Rz.E RZ.E (wkT RZ.DB RZ.T RZ.T) u2) WT = wkT-ov (ext D' Bs) RZ.DB RZ.T RZ.T u1 Rz.T PT Rz.T PT ;
    q1 : Ov Rz.E (ext D T0) (wkT D T0 T0) s1 WT (H2.comp3 Rz.E RZ.E (ext D T0) (wkT D T0 T0) RZ.lf u2 (wkT RZ.DB RZ.T RZ.T) PW1 WT PW2) (q D T0) (q Rz.DB Rz.T) =
      H2.ovC Rz.E RZ.E (ext D T0) (wkT D T0 T0) RZ.lf u2 (wkT RZ.DB RZ.T RZ.T) PW1 WT PW2 (q D T0) (q RZ.DB RZ.T) (q Rz.DB Rz.T)
        (q-ov RZ.DB D T0 (p D B) RZ.T (refl RZ.T) PW1) (q-ov (ext D' Bs) RZ.DB RZ.T u1 Rz.T PT PW2) ;
    PW3 : Id (Ty (ext D' T0s)) (subT (ext D' T0s) (ext D T0) (wkT D T0 T0) u3) (wkT D' T0s T0s) = wkT-ov D' D T0 T0 s T0s PT0 T0s PT0 ;
    PW4 : Id (Ty Rz.E) (subT Rz.E (ext D' T0s) (wkT D' T0s T0s) Rz.lf) WT = wkT-ov (ext D' Bs) D' T0s T0s (p D' Bs) Rz.T (refl Rz.T) Rz.T (refl Rz.T) ;
    q2 : Ov Rz.E (ext D T0) (wkT D T0 T0) s2 WT (H2.comp3 Rz.E (ext D' T0s) (ext D T0) (wkT D T0 T0) u3 Rz.lf (wkT D' T0s T0s) PW3 WT PW4) (q D T0) (q Rz.DB Rz.T) =
      H2.ovC Rz.E (ext D' T0s) (ext D T0) (wkT D T0 T0) u3 Rz.lf (wkT D' T0s T0s) PW3 WT PW4 (q D T0) (q D' T0s) (q Rz.DB Rz.T)
        (q-ov D' D T0 s T0s PT0 PW3) (q-ov (ext D' Bs) D' T0s (p D' Bs) Rz.T (refl Rz.T) PW4) ;
    eL : Id (Sub Rz.E (ext D T0)) s1 s2 =
      IN.ext-eq Rz.E D T0 s1 s2 (trans (Sub Rz.E D) (o Rz.E (ext D T0) D (p D T0) s1) (o Rz.E D' D s pB) (o Rz.E (ext D T0) D (p D T0) s2) pe1
          (sym (Sub Rz.E D) (o Rz.E (ext D T0) D (p D T0) s2) (o Rz.E D' D s pB) pe2))
        WT (q Rz.DB Rz.T)
        (H2.comp3 Rz.E RZ.E (ext D T0) (wkT D T0 T0) RZ.lf u2 (wkT RZ.DB RZ.T RZ.T) PW1 WT PW2) q1
        (H2.comp3 Rz.E (ext D' T0s) (ext D T0) (wkT D T0 T0) u3 Rz.lf (wkT D' T0s T0s) PW3 WT PW4) q2 ;
    t2 : El Rz.E Rz.K.BE = trE Rz.E (subT Rz.E RZ.E RZ.K.BE u2) Rz.K.BE PBE (subt Rz.E RZ.E RZ.K.BE RZ.fa u2) ;
    oA : Ov Rz.E (ext D T0) WBZ s1 Rz.K.BE (H2.comp3 Rz.E RZ.E (ext D T0) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE) RZ.bodf t2 =
      H2.ovC Rz.E RZ.E (ext D T0) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE RZ.bodf RZ.fa t2 (refl RZ.fa) (refl t2) ;
    oB : Ov Rz.E (ext D T0) WBZ s2 Rz.K.BE (H2.comp3 Rz.E (ext D' T0s) (ext D T0) WBZ u3 Rz.lf (wkT D' T0s Bs) PWB3 Rz.K.BE Rz.PLF) RZ.bodf Rz.fa =
      H2.ovC Rz.E (ext D' T0s) (ext D T0) WBZ u3 Rz.lf (wkT D' T0s Bs) PWB3 Rz.K.BE Rz.PLF RZ.bodf Rz.bodf Rz.fa ob3 (refl Rz.fa) ;
    ofa : Ov Rz.E RZ.E RZ.K.BE u2 Rz.K.BE PBE RZ.fa Rz.fa =
      trans (El Rz.E Rz.K.BE) t2
        (trE Rz.E (subT Rz.E (ext D T0) WBZ s1) Rz.K.BE (H2.comp3 Rz.E RZ.E (ext D T0) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE) (subt Rz.E (ext D T0) WBZ RZ.bodf s1))
        Rz.fa
        (sym (El Rz.E Rz.K.BE) (trE Rz.E (subT Rz.E (ext D T0) WBZ s1) Rz.K.BE (H2.comp3 Rz.E RZ.E (ext D T0) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE) (subt Rz.E (ext D T0) WBZ RZ.bodf s1)) t2 oA)
        (trans (El Rz.E Rz.K.BE)
           (trE Rz.E (subT Rz.E (ext D T0) WBZ s1) Rz.K.BE (H2.comp3 Rz.E RZ.E (ext D T0) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE) (subt Rz.E (ext D T0) WBZ RZ.bodf s1))
           (trE Rz.E (subT Rz.E (ext D T0) WBZ s2) Rz.K.BE (H2.comp3 Rz.E (ext D' T0s) (ext D T0) WBZ u3 Rz.lf (wkT D' T0s Bs) PWB3 Rz.K.BE Rz.PLF) (subt Rz.E (ext D T0) WBZ RZ.bodf s2))
           Rz.fa
           (SJ.subtEq Rz.E (ext D T0) WBZ RZ.bodf s1 s2 eL Rz.K.BE (H2.comp3 Rz.E RZ.E (ext D T0) WBZ RZ.lf u2 RZ.K.BE RZ.PLF Rz.K.BE PBE)
              (H2.comp3 Rz.E (ext D' T0s) (ext D T0) WBZ u3 Rz.lf (wkT D' T0s Bs) PWB3 Rz.K.BE Rz.PLF))
           oB) ;
    -- the family
    Fo : Id (Ty Rz.E) (subT Rz.E RZ.E RZ.K.F u2) Rz.K.F =
      G1.FN Rz.E RZ.E u2 RZ.K.TP Rz.K.TP PTP RZ.K.BE Rz.K.BE PBE RZ.fa RZ.K.bE Rz.fa Rz.K.bE ofa obE ;
    Ho : Id (Ty (ext D' Bs)) (subT (ext D' Bs) RZ.DB RZ.K.H u1) Rz.K.H = Pi-ov (ext D' Bs) RZ.DB RZ.T RZ.K.F u1 Rz.T PT Rz.K.F Fo ;
    law : Id (Ty D') (subT D' D RZ.K.CF s) Rz.K.CF = Sig-ov D' D B RZ.K.H s Bs PB Rz.K.H Ho ;
  } ;
} ;
