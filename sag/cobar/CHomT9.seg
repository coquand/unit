-- CHomT9.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 6: the way back for the
-- datum of a binary operation.  From CMorX's datum d with its naturality
-- dn: the Pi family phiF (d moved back along comp-idr) and its Pi
-- naturality natF (CHomT5's chain run backwards: E3 for the point
-- equation, dn, the Sigma action read back by apdS).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
module PB = PosFull[a].PB ;
module LP = PB.GPre[a+].PS ;

module RevOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation)
  (opS : C.El C.nil (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[s].Qt (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[s].Qt CHomT3[a].HomP[R, encK, pe].Alg[s].Qt)))
  (opT : C.El C.nil (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[t].Qt (OV.Fun C.nil CHomT3[a].HomP[R, encK, pe].Alg[t].Qt CHomT3[a].HomP[R, encK, pe].Alg[t].Qt))) {
 module P = CHomT4[a].P3[R, encK, pe, s, t] ;
 module F = P.F ;
 module H = P.H ;
 module HB = H.B0.BinOf[opS, opT] ;
 module BB = F.Bin[F.S.Op[opS].IdB, F.T.Op[opT].IdB] ;
 W4K (K : Ob) : U a+ = V1.Ix (HB.W4.1.tob K tt) ;
 act (K L : Ob) (g : Hom L K) (wp : W4K K) : W4K L = HB.W4.1.tact L K g tt tt (refl tt) wp ;
 module G3 = F.T.QC ;
 IT : C.Ty F.T.G3 = F.T.Op[opT].IdB ;
 P3 (K : Ob) : U a+ = V1.Ix (F.T.G3.ob K) ;
 -- the action of a transported element
 tactSrc (K L : Ob) (g : Hom L K) (x0' x0 : P3 K) (q : Id (P3 K) x0' x0) (X : V1.Ix (IT.1.tob K x0')) (y : P3 L)
   (e : Id (P3 L) (F.T.G3.act L K g x0) y) (e' : Id (P3 L) (F.T.G3.act L K g x0') y)
  : Id (V1.Ix (IT.1.tob L y)) (IT.1.tact L K g x0 y e (subst (P3 K) (\ x -> V1.Ix (IT.1.tob K x)) x0' x0 q X)) (IT.1.tact L K g x0' y e' X) =
  idJ (P3 K) x0' (\ x1 q1 -> (e1 : Id (P3 L) (F.T.G3.act L K g x1) y) -> Id (V1.Ix (IT.1.tob L y)) (IT.1.tact L K g x1 y e1 (subst (P3 K) (\ x -> V1.Ix (IT.1.tob K x)) x0' x1 q1 X)) (IT.1.tact L K g x0' y e' X))
   (\ e1 -> LP.tact-irr F.T.G3 IT.1 L K g x0' y e1 e' X) x0 q e ;
 -- transport along a composite
 substTr (L : Ob) (x y z : P3 L) (p : Id (P3 L) x y) (q : Id (P3 L) y z) (u : V1.Ix (IT.1.tob L x))
  : Id (V1.Ix (IT.1.tob L z)) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x z (transH p q) u) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y z q (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x y p u)) =
  idJ (P3 L) y (\ z2 q2 -> Id (V1.Ix (IT.1.tob L z2)) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x z2 (transH p q2) u) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y z2 q2 (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x y p u)))
   (refl (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) x y p u)) z q ;
 module PC = PresheafPi[a, a+].PPi[PB.BC].PiCode[H.B0.Gh, HB.W4h.1, HB.IdT3.1] ;
 module Back (I : Ob) (ph : F.Fam I) (nt : F.Nat I ph) (d : BB.DT I ph) (dn : BB.DN I ph d) {
  x : V1.Ix (H.B0.Gh.ob I) = (tt, (ph, nt)) ;
  phiF : PC.FunT I (PC.ptOf I x) = \ K f wp ->
   subst (Hom K I) (\ k -> V1.Ix (IT.1.tob K (F.T.mk3 K (F.mp3 I ph K k (wp.1, (wp.2.1, wp.2.2.1)))))) f (compH K K I f (idH K)) (symH (comp-idr K I f))
    (d K f (wp.1, (wp.2.1, wp.2.2.1)) wp.2.2.2) ;
  module NB (K L : Ob) (f : Hom K I) (g : Hom L K) (wp : W4K K) {
   w : F.S.T3 K = (wp.1, (wp.2.1, wp.2.2.1)) ;
   p : V1.Ix (BB.FS K w) = wp.2.2.2 ;
   fg : Hom L I = compH L K I f g ;
   x0 : P3 K = F.T.mk3 K (F.mp3 I ph K f w) ;
   x0' : P3 K = F.T.mk3 K (F.mp3 I ph K (compH K K I f (idH K)) w) ;
   qR : Id (P3 K) x0 x0' = ap (Hom K I) (P3 K) (\ k -> F.T.mk3 K (F.mp3 I ph K k w)) f (compH K K I f (idH K)) (symH (comp-idr K I f)) ;
   D : V1.Ix (IT.1.tob K x0) = d K f w p ;
   aw : W4K L = PC.AactOf I (PC.ptOf I x) (PC.cOf I x) K L f g wp ;
   wp1 : W4K L = act K L g wp ;
   sigL (wq : W4K L) : P3 L = HB.sigN L (PC.ptOf I x L fg, wq) ;
   yB : P3 L = sigL aw ;
   eB : Id (P3 L) (F.T.G3.act L K g x0') yB =
    LP.ntEq HB.Dw F.T.G3 HB.sigT L K g (PC.ptOf I x K f, wp) (PC.ptOf I x L fg, aw) (PC.eOf I x K L f g wp) ;
   piw : Id (W4K L) aw wp1 =
    LP.tact-irr C.nil HB.W4.1 L K g tt tt (LP.ntEq H.B0.Gh C.nil H.B0.pG L K g (PC.ptOf I x K f) (PC.ptOf I x L fg) (PC.cOf I x K L f g)) (refl tt) wp ;
   w2 : F.T.T3 L = F.mp3 I ph L fg (F.S.rs3 K L g w) ;
   y2 : P3 L = F.T.mk3 L w2 ;
   qY : Id (P3 L) y2 (sigL wp1) = ap (Hom L I) (P3 L) (\ k -> F.T.mk3 L (F.mp3 I ph L k (F.S.rs3 K L g w))) fg (compH L L I fg (idH L)) (symH (comp-idr L I fg)) ;
   pib : Id (P3 L) (sigL wp1) yB = ap (W4K L) (P3 L) sigL wp1 aw (symH piw) ;
   qX : Id (P3 L) y2 yB = transH qY pib ;
   eDN : Id (P3 L) (F.T.G3.act L K g x0) y2 = apH {F.T.T3 L} {P3 L} (F.T.mk3 L) (F.E3 I ph nt K L f g w) ;
   D1 : V1.Ix (IT.1.tob L y2) = d L fg (F.S.rs3 K L g w) (BB.acS K L g w p) ;
   TB : U a+ = V1.Ix (IT.1.tob L yB) ;
   t1 : Id TB (IT.1.tact L K g x0' yB eB (phiF K f wp)) (IT.1.tact L K g x0' yB eB (subst (P3 K) (\ v -> V1.Ix (IT.1.tob K v)) x0 x0' qR D)) =
    apH {V1.Ix (IT.1.tob K x0')} {TB} (\ v -> IT.1.tact L K g x0' yB eB v)
     (subst-ap (Hom K I) (P3 K) (\ k -> F.T.mk3 K (F.mp3 I ph K k w)) (\ v -> V1.Ix (IT.1.tob K v)) f (compH K K I f (idH K)) (symH (comp-idr K I f)) D) ;
   t2 : Id TB (IT.1.tact L K g x0' yB eB (subst (P3 K) (\ v -> V1.Ix (IT.1.tob K v)) x0 x0' qR D)) (IT.1.tact L K g x0 yB (transH eDN qX) D) =
    tactSrc K L g x0 x0' qR D yB eB (transH eDN qX) ;
   t3 : Id TB (IT.1.tact L K g x0 yB (transH eDN qX) D) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y2 yB qX (IT.1.tact L K g x0 y2 eDN D)) =
    CMorX[a].tactTr F.T.G3 IT L K g x0 y2 yB eDN qX D ;
   t4 : Id TB (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y2 yB qX (IT.1.tact L K g x0 y2 eDN D)) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y2 yB qX D1) =
    apH {V1.Ix (IT.1.tob L y2)} {TB} (\ v -> subst (P3 L) (\ v2 -> V1.Ix (IT.1.tob L v2)) y2 yB qX v) (dn K L f g w eDN p) ;
   t5 : Id TB (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y2 yB qX D1) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) (sigL wp1) yB pib (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y2 (sigL wp1) qY D1)) =
    substTr L y2 (sigL wp1) yB qY pib D1 ;
   t6 : Id (V1.Ix (IT.1.tob L (sigL wp1))) (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) y2 (sigL wp1) qY D1) (phiF L fg wp1) =
    symH (subst-ap (Hom L I) (P3 L) (\ k -> F.T.mk3 L (F.mp3 I ph L k (F.S.rs3 K L g w))) (\ v -> V1.Ix (IT.1.tob L v)) fg (compH L L I fg (idH L)) (symH (comp-idr L I fg)) D1) ;
   t7 : Id TB (subst (P3 L) (\ v -> V1.Ix (IT.1.tob L v)) (sigL wp1) yB pib (phiF L fg wp1)) (phiF L fg aw) =
    transH (symH (subst-ap (W4K L) (P3 L) sigL (\ v -> V1.Ix (IT.1.tob L v)) wp1 aw (symH piw) (phiF L fg wp1)))
     (CMorX[a].apdS (W4K L) (\ wq -> V1.Ix (IT.1.tob L (sigL wq))) (\ wq -> phiF L fg wq) wp1 aw (symH piw)) ;
   law : Id TB (IT.1.tact L K g x0' yB eB (phiF K f wp)) (phiF L fg aw) =
    transH t1 (transH t2 (transH t3 (transH t4 (transH t5
     (transH (apH {V1.Ix (IT.1.tob L (sigL wp1))} {TB} (\ v -> subst (P3 L) (\ v2 -> V1.Ix (IT.1.tob L v2)) (sigL wp1) yB pib v) t6) t7))))) ;
  } ;
  natF : PC.NatT I (PC.ptOf I x) (PC.cOf I x) (PC.eOf I x) phiF = \ K L f g wp -> NB[K, L, f, g, wp].law ;
  piEl : V1.Ix (HB.DataBin.1.tob I x) = (phiF, natF) ;
 } ;
} ;
