-- CRho2.seg (canonicity-45; COBAR.md "Prop 58"): the h side of CRho1 from
-- c2's (d)(1)-(3).  At the copy y': HU = HomT(y.u, y'), T0 = Sigma HX Sol
-- (CSolT), fwd : Fun HU T0 and Kd : Kr T0 HU fwd (module parameters until
-- c2's land); h = fwd . alpha on C's codes of yo(y.u), and its equivalence
-- structure is fwd's (FibS3 S3b from Kd) moved along alpha (CHFibCart, as
-- CCmpY2: beta . alpha = id, alpha . beta = id, alpha natural).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module LR = CLocBoundRetr[a, a+] ;
module FC = FibCwF[a, a+].FC ;
module HO = PB.CHtpyOps[a+] ;
module CE = PB.CEquiv[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module QP = CwFQP.QP[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

module HSide (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module TR = LA.TR ;
 module HP = CHomT3[a].HomP[R, encK, pe] ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w)) {
  module RD = CRho1[a].RhoC[R, encK, pe, y, u].Data[A, rho, rho1] ;
  module Cp (y' : SX.Over[R].Presentation) {
   module C1 = RD.Cp[y'] ;
   D : L.PCtx = C1.D ;
   By : L.PTy[D] = C1.Yy.By ;
   module S2 = CSolT[a].SolOf2[R, encK, pe, y, u, y'] ;
   T0 : C.Ty C.nil = SS.Sig C.nil S2.S1.HXY S2.Sol ;
   HU : C.Ty C.nil = HP.Hom[LA.yu, y'].HomT ;
   sD : L.PSub[D, C.nil] = new L.PSub[D, C.nil, \ W x -> tt, \ V W g x -> refl tt] ;
   Tw : FC.STy D = FC.subS D C.nil T0 sD ;
   module P = CHomT4[a].P3[R, encK, pe, LA.yu, y'] ;
   module FM = CHomT11[a].FromM[R, encK, pe, LA.yu, y'] ;
   module TM = CHomT8[a].ToM[R, encK, pe, LA.yu, y'] ;
   module NA = CHomT16[a].Nat[R, encK, pe, LA.yu, y'] ;
   probe (I : Ob) (o : V1.Ix (D.ob I)) (m : V1.Ix (By.tob I o)) : P.F.M I = m ;
   resEq (J I : Ob) (uu : Hom J I) (o : V1.Ix (D.ob I)) (o' : V1.Ix (D.ob J)) (e : Id (V1.Ix (D.ob J)) (D.act J I uu o) o') (m : V1.Ix (By.tob I o))
    : Id (P.F.M J) (By.tact J I uu o o' e m) (P.F.res I J uu m) =
    P.F.mExt J (By.tact J I uu o o' e m) (P.F.res I J uu m) (refl (P.F.fpOf J (P.F.res I J uu m))) ;
   module TBp = PB.GPre[a+].TyL[D, By] ;
   module TB0 = PB.GPre[a+].TyL[C.nil, HU.1] ;
   module TAp = PB.GPre[a+].TyL[D, Tw.1] ;
   module TA0 = PB.GPre[a+].TyL[C.nil, T0.1] ;
   Z (W : Ob) : U a+ = V1.Ix (HU.1.tob W tt) ;
   -- the cart on yo(y.u): alpha
   tB (W : Ob) (v : TBp.EI W) : TB0.EI W = (tt, FM.alpha W v.2) ;
   aR (V W : Ob) (g : Hom V W) (v : TBp.EI W) : Id (Z V) (HU.1.tact V W g tt tt (refl tt) (FM.alpha W v.2)) (FM.alpha V (TBp.E.act V W g v).2) =
    transH (symH (NA.aNat W V g v.2))
     (apH {P.F.M V} {Z V} (FM.alpha V) (symH (resEq V W g v.1 (D.act V W g v.1) (refl (D.act V W g v.1)) v.2))) ;
   tBnat (V W : Ob) (g : Hom V W) (v : TBp.EI W) : Id (TB0.EI V) (TB0.E.act V W g (tB W v)) (tB V (TBp.E.act V W g v)) =
    apH {Z V} {TB0.EI V} (\ z -> (tt, z)) (aR V W g v) ;
   snd2 (W : Ob) (z z' : Z W) (Q : Id (TB0.EI W) (tt, z) (tt, z')) : Id (Z W) z z' =
    apH {TB0.EI W} {Z W} (\ pp -> subst Top (\ o -> V1.Ix (HU.1.tob W o)) pp.1 tt (isTop pp.1 tt) pp.2) Q ;
   tBinj (W : Ob) (v v' : TBp.EI W) (Pe : Id (V1.Ix (D.ob W)) v.1 v'.1) (Q : Id (TB0.EI W) (tB W v) (tB W v')) : Id (TBp.EI W) v v' =
    transH (apH {V1.Ix (D.ob W)} {TBp.EI W} (\ o2 -> (o2, v.2)) Pe)
     (apH {P.F.M W} {TBp.EI W} (\ m2 -> (v'.1, m2))
       (transH (symH (CHomT12[a].RT1[R, encK, pe, LA.yu, y'].At[W, v.2].rt))
         (transH (apH {Z W} {P.F.M W} (TM.beta W) (snd2 W (FM.alpha W v.2) (FM.alpha W v'.2) Q))
           (CHomT12[a].RT1[R, encK, pe, LA.yu, y'].At[W, v'.2].rt)))) ;
   bkB (X : Ob) (x : V1.Ix (D.ob X)) (z : Z X) : V1.Ix (By.tob X x) = TM.beta X z ;
   bkBta (X : Ob) (x : V1.Ix (D.ob X)) (z : Z X) : Id (TB0.EI X) (tB X (TBp.pr X x (bkB X x z))) (TB0.pr X tt z) =
    apH {Z X} {TB0.EI X} (\ z0 -> (tt, z0)) (CHomT13[a].RT2[R, encK, pe, LA.yu, y'].At[X, z].rt) ;
   -- the cart on T: the identity on fibres
   ZT (W : Ob) : U a+ = V1.Ix (T0.1.tob W tt) ;
   tA (W : Ob) (v : TAp.EI W) : TA0.EI W = (tt, v.2) ;
   eD (V W : Ob) (g : Hom V W) (o : V1.Ix (D.ob W)) : Id (V1.Ix (C.nil.ob V)) (C.nil.act V W g tt) tt =
    L.ntEq D C.nil sD V W g o (D.act V W g o) (refl (D.act V W g o)) ;
   tAnat (V W : Ob) (g : Hom V W) (v : TAp.EI W) : Id (TA0.EI V) (TA0.E.act V W g (tA W v)) (tA V (TAp.E.act V W g v)) =
    apH {ZT V} {TA0.EI V} (\ z -> (tt, z)) (L.tact-irr C.nil T0.1 V W g tt tt (refl tt) (eD V W g v.1) v.2) ;
   sndT (W : Ob) (z z' : ZT W) (Q : Id (TA0.EI W) (tt, z) (tt, z')) : Id (ZT W) z z' =
    apH {TA0.EI W} {ZT W} (\ pp -> subst Top (\ o -> V1.Ix (T0.1.tob W o)) pp.1 tt (isTop pp.1 tt) pp.2) Q ;
   tAinj (W : Ob) (v v' : TAp.EI W) (Pe : Id (V1.Ix (D.ob W)) v.1 v'.1) (Q : Id (TA0.EI W) (tA W v) (tA W v')) : Id (TAp.EI W) v v' =
    transH (apH {V1.Ix (D.ob W)} {TAp.EI W} (\ o2 -> (o2, v.2)) Pe) (apH {ZT W} {TAp.EI W} (\ b -> (v'.1, b)) (sndT W v.2 v'.2 Q)) ;
   -- h = fwd . alpha, and its equivalence structure
   module Fw (fwd : C.El C.nil (OV.Fun C.nil HU T0)) (Kd : C.El C.nil (QP.Kr C.nil T0 HU fwd)) {
    module NMf = EqQinv[a, a+].NM[C.nil, HU, T0, fwd] ;
    h : HO.NMap[D, By, Tw.1] =
     new HO.NMap[D, By, Tw.1, \ I x b -> NMf.nf I tt (FM.alpha I b),
      \ J I f x x' e b -> transH (L.tact-irr C.nil T0.1 J I f tt tt (L.ntEq D C.nil sD J I f x x' e) (refl tt) (NMf.nf I tt (FM.alpha I b)))
        (transH (NMf.nn J I f tt tt (refl tt) (FM.alpha I b))
          (apH {Z J} {ZT J} (NMf.nf J tt)
            (transH (symH (NA.aNat I J f b)) (apH {P.F.M J} {Z J} (FM.alpha J) (symH (resEq J I f x x' e b))))))] ;
    module S3 = FibS3[a, a+].S3[C.nil, T0, HU, fwd] ;
    module H = PB.CHFibCart[a+, a+].HCart[D, By, Tw.1, LR.Map[D, By, Tw.1, h].pmap, C.nil, HU.1, T0.1, S3.al, \ W x -> tt, \ V W g d -> refl tt,
      tA, \ W v -> refl tt, tAnat, tAinj, \ X x z -> z, \ X x z -> refl (TA0.pr X tt z),
      tB, \ W v -> refl tt, tBnat, tBinj, bkB, bkBta, \ W v -> refl (tA W (LR.Map[D, By, Tw.1, h].onE W v))] ;
    eh : CE.EquivOp D By Tw.1 LR.Map[D, By, Tw.1, h].pmap = H.moveEq (S3.B[Kd].eop) ;
   } ;
  } ;
  -- the levelwise equivalence of rho, from c2's fwd / Kd and the comparison cE
  module Fin2 (fwd : (y' : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil Cp[y'].HU Cp[y'].T0))
    (Kd : (y' : SX.Over[R].Presentation) -> C.El C.nil (QP.Kr C.nil Cp[y'].T0 Cp[y'].HU (fwd y')))
    (cE : (y' : SX.Over[R].Presentation) -> HO.NMap[Cp[y'].D, Cp[y'].C1.Yy.Ay, Cp[y'].Tw.1])
    (ecE : (y' : SX.Over[R].Presentation) -> CE.EquivOp Cp[y'].D Cp[y'].C1.Yy.Ay Cp[y'].Tw.1 LR.Map[Cp[y'].D, Cp[y'].C1.Yy.Ay, Cp[y'].Tw.1, cE y'].pmap)
    (commH : (y' : SX.Over[R].Presentation) -> L.PEl[L.extP Cp[y'].D Cp[y'].By, HO.HT[Cp[y'].D, Cp[y'].By, Cp[y'].Tw.1, Cp[y'].Fw[fwd y', Kd y'].h, HO.compN Cp[y'].D Cp[y'].By Cp[y'].C1.Yy.Ay Cp[y'].Tw.1 Cp[y'].C1.fN (cE y')].PT.PathP]) {
   module F = RD.Fin[\ y' -> Cp[y'].Tw, cE, ecE, \ y' -> Cp[y'].Fw[fwd y', Kd y'].h, \ y' -> Cp[y'].Fw[fwd y', Kd y'].eh, commH] ;
   ef : TR.G0.GB.CEquiv[a+].EquivOp RD.RM.PD.UG RD.RM.PD.UA RD.RM.PD.UB RD.RM.PD.Uf = F.ef ;
  } ;
 } ;
} ;
