-- CTotUFib.seg (canonicity-c2; SIMPLIFIED.md item 5): towards "U of a
-- fibration of the total site is a levelwise fibration".
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module UFib (C : CIntCat[a, vl].IC) {
 module UX = CTotUExt[a, vl, l].UExt[C] ;
 module TR = UX.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;

 module Ln (G : P1.PCtx) (A : P1.PTy[G]) {
  UG : P0.PCtx = RS.rC G ;
  UA : P0.PTy[UG] = RS.rT G A ;
  E1 : P1.PCtx = P1.extP G A ;
  module XE = UX.FI.XG[E1] ;
  module XB = UX.FI.XG[G] ;
  module FT1 = G1.GB.CLine[l].FT[G, A] ;
  module FT0 = G0.GB.CLine[l].FT[UG, UA] ;
  Tot1 (X : Ob1) : U l = P1.SigT G A X ;
  Tot0 (Y : Ob0) : U l = P0.SigT UG UA Y ;
  Pt1 (X : Ob1) : U l = W0.Ix (G.ob X) ;
  vp (Y : Ob0) (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) : RN.Hom1 Z (RN.o (UX.lf Y Z k)) = TR.DS.Fact[Y, Z, k].vp ;

  -- (1) the extension of a line of U A: the extension of its line in the
  -- context G.A, over the extension of its line in G
  module XL (Y : Ob0) (w : FT0.TL.EI Y) {
   x0 : W0.Ix (XB.RH.F0.ob Y) = FT0.TL.pr1 Y w ;
   le : W0.Ix (XE.RH.F0.ob Y) = FT0.lline Y w ;
   x1 : W0.Ix (XB.RH.F1.ob (RN.o Y)) = XB.extV Y x0 ;
   t (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) (i : G1.GB.IvP Z) : Tot1 Z = XE.efam Y le Z k i ;
   tp (Z : Ob1) (k : RN.Hom1 Z (RN.o Y)) (i : G1.GB.IvP Z) : Id (Pt1 Z) (FT1.TA.pr1 Z (t Z k i)) (x1.1 Z k i) =
    ap (Pt1 (RN.o (UX.lf Y Z k))) (Pt1 Z) (\ p -> G.act Z (RN.o (UX.lf Y Z k)) (vp Y Z k) p)
     (FT1.TA.pr1 (RN.o (UX.lf Y Z k)) (le.1 (UX.lf Y Z k) (UX.cl Y Z k) i)) (x0.1 (UX.lf Y Z k) (UX.cl Y Z k) i)
     (apH {W0.Ix (XB.RH.F0.ob Y)} {Pt1 (RN.o (UX.lf Y Z k))} (\ y -> y.1 (UX.lf Y Z k) (UX.cl Y Z k) i) (FT0.lover Y w)) ;
   line : FT1.TL.EI (RN.o Y) =
    FT1.TL.pr (RN.o Y) x1 (FT1.lamA (RN.o Y) x1 t tp (\ Vt W g f i -> XE.EN[Y, le, Vt, W, g, f, i].nat)) ;
   -- its values on the levelwise maps are those of w
   lv-ret (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.IvP Z)
    : Id (Tot1 (RN.o Z)) (FT1.lval (RN.o Y) line (RN.o Z) (TR.fn.onH Z Y h) i) (FT0.lval Y w Z h i) = XE.RE[Y, le, Z, h, i].ret ;
  } ;
 } ;

 ----------------------------------------------------------------------
 -- lines with an element at the end e, and lines with that end fixed
 module Ek (G : P1.PCtx) (A : P1.PTy[G]) (e : G1.GB.IPt) {
  module LN = Ln[G, A] ;
  UG : P0.PCtx = LN.UG ;
  UA : P0.PTy[UG] = LN.UA ;
  module XB = LN.XB ;
  module FT1 = LN.FT1 ;
  module FT0 = LN.FT0 ;
  module EK1 = G1.GB.CLine[l].EndKit[G, A, e] ;
  module EK0 = G0.GB.CLine[l].EndKit[UG, UA, e] ;
  Tot1 (X : Ob1) : U l = LN.Tot1 X ;
  Pt1 (X : Ob1) : U l = LN.Pt1 X ;
  id0 (Y : Ob0) : RN.Hom0 Y Y = G0.GB.BC.idC Y ;
  id1 (Y : Ob0) : RN.Hom1 (RN.o Y) (RN.o Y) = G1.GB.BC.idC (RN.o Y) ;
  pe (Y : Ob0) : G1.GB.IvP (RN.o Y) = G1.GB.ptH (RN.o Y) e ;

  -- (2) the point
  module XZ (Y : Ob0) (z0 : EK0.TV.EI Y) {
   x0 : W0.Ix (XB.RH.F0.ob Y) = EK0.TV.pr1 Y z0 ;
   x1 : W0.Ix (XB.RH.F1.ob (RN.o Y)) = XB.extV Y x0 ;
   p0 : Pt1 (RN.o Y) = (XB.RH.F0.ev e).nt Y x0 ;
   p1 : Pt1 (RN.o Y) = (XB.RH.F1.ev e).nt (RN.o Y) x1 ;
   q : Id (Pt1 (RN.o Y)) p1 p0 =
    trans (Pt1 (RN.o Y)) p1 (x1.1 (RN.o Y) (TR.fn.onH Y Y (id0 Y)) (pe Y)) p0
     (ap (RN.Hom1 (RN.o Y) (RN.o Y)) (Pt1 (RN.o Y)) (\ k -> x1.1 (RN.o Y) k (pe Y)) (id1 Y) (TR.fn.onH Y Y (id0 Y)) (symH (TR.fn.onId Y)))
     XB.RE[Y, x0, Y, id0 Y, pe Y].ret ;
   z1 : EK1.TV.EI (RN.o Y) = EK1.TV.pr (RN.o Y) x1 (EK1.TA.coeT (RN.o Y) p0 p1 (symH q) (EK0.TV.pr2 Y z0)) ;
   endEq : Id (Tot1 (RN.o Y)) (EK1.endE (RN.o Y) z1) (EK0.endE Y z0) =
    symH (EK1.TA.pr-coe (RN.o Y) p0 p1 (symH q) (EK0.TV.pr2 Y z0)) ;
  } ;

  -- (3) the line with its end fixed
  module XS (Y : Ob0) (u0 : EK0.TS.EI Y) {
   z0 : EK0.TV.EI Y = EK0.TS.pr1 Y u0 ;
   L0 : EK0.TL.EI Y = EK0.lineL Y u0 ;
   module Z = XZ[Y, z0] ;
   module L = LN.XL[Y, L0] ;
   q : Id (Tot1 (RN.o Y)) (EK1.endE (RN.o Y) (FT1.Ev[e].evA.mE (RN.o Y) L.line)) (EK1.endE (RN.o Y) Z.z1) =
    trans (Tot1 (RN.o Y)) (EK1.endE (RN.o Y) (FT1.Ev[e].evA.mE (RN.o Y) L.line)) (FT1.lval (RN.o Y) L.line (RN.o Y) (id1 Y) (pe Y)) (EK1.endE (RN.o Y) Z.z1)
     (FT1.Ev[e].endB-E (RN.o Y) L.line)
     (trans (Tot1 (RN.o Y)) (FT1.lval (RN.o Y) L.line (RN.o Y) (id1 Y) (pe Y)) (FT0.lval Y L0 Y (id0 Y) (pe Y)) (EK1.endE (RN.o Y) Z.z1)
        (trans (Tot1 (RN.o Y)) (FT1.lval (RN.o Y) L.line (RN.o Y) (id1 Y) (pe Y)) (FT1.lval (RN.o Y) L.line (RN.o Y) (TR.fn.onH Y Y (id0 Y)) (pe Y))
           (FT0.lval Y L0 Y (id0 Y) (pe Y))
           (ap (RN.Hom1 (RN.o Y) (RN.o Y)) (Tot1 (RN.o Y)) (\ k -> FT1.lval (RN.o Y) L.line (RN.o Y) k (pe Y)) (id1 Y) (TR.fn.onH Y Y (id0 Y)) (symH (TR.fn.onId Y)))
           (L.lv-ret Y (id0 Y) (pe Y)))
        (trans (Tot1 (RN.o Y)) (FT0.lval Y L0 Y (id0 Y) (pe Y)) (EK0.endE Y z0) (EK1.endE (RN.o Y) Z.z1)
           (trans (Tot1 (RN.o Y)) (FT0.lval Y L0 Y (id0 Y) (pe Y)) (EK0.endE Y (FT0.Ev[e].evA.mE Y L0)) (EK0.endE Y z0)
              (symH (FT0.Ev[e].endB-E Y L0))
              (ap (EK0.TV.EI Y) (Tot1 (RN.o Y)) (EK0.endE Y) (FT0.Ev[e].evA.mE Y L0) z0 (EK0.TS.pr2 Y u0).2))
           (symH Z.endEq))) ;
   u1 : EK1.TS.EI (RN.o Y) = EK1.mkTS (RN.o Y) Z.z1 L.line (refl Z.x1) q ;
  } ;

  -- (4) naturality along the levelwise maps
  module ZN (Z Y : Ob0) (h : RN.Hom0 Z Y) (z0 : EK0.TV.EI Y) {
   module A0 = XZ[Y, z0] ;
   z0' : EK0.TV.EI Z = EK0.TV.E.act Z Y h z0 ;
   module A1 = XZ[Z, z0'] ;
   lhs : EK1.TV.EI (RN.o Z) = EK1.TV.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) A0.z1 ;
   q : Id (Tot1 (RN.o Z)) (EK1.endE (RN.o Z) lhs) (EK1.endE (RN.o Z) A1.z1) =
    trans (Tot1 (RN.o Z)) (EK1.endE (RN.o Z) lhs) (EK1.TA.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (EK1.endE (RN.o Y) A0.z1)) (EK1.endE (RN.o Z) A1.z1)
     (EK1.endE-act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) A0.z1)
     (trans (Tot1 (RN.o Z)) (EK1.TA.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (EK1.endE (RN.o Y) A0.z1))
        (EK1.TA.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (EK0.endE Y z0)) (EK1.endE (RN.o Z) A1.z1)
        (ap (Tot1 (RN.o Y)) (Tot1 (RN.o Z)) (\ w -> EK1.TA.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) w) (EK1.endE (RN.o Y) A0.z1) (EK0.endE Y z0) A0.endEq)
        (trans (Tot1 (RN.o Z)) (EK1.TA.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (EK0.endE Y z0)) (EK0.endE Z z0') (EK1.endE (RN.o Z) A1.z1)
           (symH (EK0.endE-act Z Y h z0)) (symH A1.endEq))) ;
   nat : Id (EK1.TV.EI (RN.o Z)) lhs A1.z1 = EK1.tv-eq (RN.o Z) lhs A1.z1 (XB.ext-nat Z Y h A0.x0) q ;
  } ;
  module SN (Z Y : Ob0) (h : RN.Hom0 Z Y) (u0 : EK0.TS.EI Y) {
   module S0 = XS[Y, u0] ;
   u0' : EK0.TS.EI Z = EK0.TS.E.act Z Y h u0 ;
   module S1 = XS[Z, u0'] ;
   lv (W : Ob1) (f : RN.Hom1 W (RN.o Z)) (j : G1.GB.IvP W)
    : Id (Tot1 W) (FT1.lval (RN.o Y) S0.L.line W (G1.GB.BC.oC W (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) f) j) (FT1.lval (RN.o Z) S1.L.line W f j) =
    trans (Tot1 W) (FT1.lval (RN.o Y) S0.L.line W (G1.GB.BC.oC W (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) f) j)
      (LN.XE.efam Z (LN.XE.RH.F0.actF Z Y h S0.L.le) W f j) (FT1.lval (RN.o Z) S1.L.line W f j)
     (apH {W0.Ix (LN.XE.RH.F1.ob (RN.o Z))} {Tot1 W} (\ y -> y.1 W f j) (LN.XE.ext-nat Z Y h S0.L.le))
     (ap (EK0.TL.EI Z) (Tot1 W) (\ M -> LN.XE.efam Z (FT0.lline Z M) W f j) (EK0.TL.E.act Z Y h S0.L0) S1.L0
        (symH (EK0.lineL-act Z Y h u0))) ;
   nat : Id (EK1.TS.EI (RN.o Z)) (EK1.TS.E.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) S0.u1) S1.u1 =
    EK1.mkTS-act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) S0.Z.z1 S0.L.line (refl S0.Z.x1) S0.q
     S1.Z.z1 S1.L.line (refl S1.Z.x1) S1.q ZN[Z, Y, h, S0.z0].nat lv ;
  } ;
 } ;
} ;
