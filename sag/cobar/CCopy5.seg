
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

-- per copy: the G0 line kit restricted to the copy maps to the poset line kit of the restriction
module LK (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (G : CCopy[a].ConcC[R, encK, pe].P0.PCtx) (A : CCopy[a].ConcC[R, encK, pe].P0.PTy[G]) (y : SX.Over[R].Presentation) (e e' : PB.IPt) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module G0 = CC.G0 ;
 module Cy = CC.Copy[y] ;
 Gy : L.PCtx = Cy.rCy G ;
 Ay : L.PTy[Gy] = Cy.rTy G A ;
 module L0 = G0.GB.CLine[a+].Lines[G, A] ;
 module K0 = L0.CompK[e, e'] ;
 module Lp = PB.CLine[a+].Lines[Gy, Ay] ;
 module Kp = Lp.CompK[e, e'] ;
 module FC0 = G0.GB.CLine[a+].FC[G] ;
 module FCp = PB.CLine[a+].FC[Gy] ;
 D : L.PCtx = Cy.rCy K0.EK.TV.E ;
 D0 : L.PCtx = Kp.EK.TV.E ;
 rl (I : Ob) (g : V1.Ix (FC0.ob (Cy.o0 I))) : V1.Ix (FCp.ob I) =
  (\ J u i -> g.1 (Cy.o0 J) (Cy.h0 J I u) i, \ V J h u i -> g.2 (Cy.o0 V) (Cy.o0 J) (Cy.h0 V J h) (Cy.h0 J I u) i) ;
 s (W : Ob) (d : V1.Ix (D.ob W)) : V1.Ix (D0.ob W) = (rl W d.1, d.2) ;
 rlN (V W : Ob) (g : Hom V W) (d : V1.Ix (FC0.ob (Cy.o0 W)))
  : Id (V1.Ix (FCp.ob V)) (rl V (FC0.GI.act (Cy.o0 V) (Cy.o0 W) (Cy.h0 V W g) d)) (FCp.GI.act V W g (rl W d)) =
  FCp.fam-eq V (rl V (FC0.GI.act (Cy.o0 V) (Cy.o0 W) (Cy.h0 V W g) d)) (FCp.GI.act V W g (rl W d)) (\ J u i -> refl (d.1 (Cy.o0 J) (Cy.h0 J W (compH J V W g u)) i)) ;
 -- transport of a value along an equality of lines
 evp (V : Ob) (g : V1.Ix (FCp.ob V)) : V1.Ix (Gy.ob V) = g.1 V (idH V) (PB.ptH V e) ;
 substEv (V : Ob) (g1 g2 : V1.Ix (FCp.ob V)) (Pg : Id (V1.Ix (FCp.ob V)) g1 g2) (b : V1.Ix (Ay.tob V (evp V g1)))
  : Id (V1.Ix (Ay.tob V (evp V g2))) (subst (V1.Ix (FCp.ob V)) (\ gg -> V1.Ix (Ay.tob V (evp V gg))) g1 g2 Pg b)
       (subst (V1.Ix (Gy.ob V)) (\ xx -> V1.Ix (Ay.tob V xx)) (evp V g1) (evp V g2) (apH (evp V) Pg) b) =
  idJ (V1.Ix (FCp.ob V)) g1 (\ g3 P3 -> Id (V1.Ix (Ay.tob V (evp V g3))) (subst (V1.Ix (FCp.ob V)) (\ gg -> V1.Ix (Ay.tob V (evp V gg))) g1 g3 P3 b)
       (subst (V1.Ix (Gy.ob V)) (\ xx -> V1.Ix (Ay.tob V xx)) (evp V g1) (evp V g3) (apH (evp V) P3) b)) (refl b) g2 Pg ;
 substLoop (V : Ob) (xx : V1.Ix (Gy.ob V)) (p : Id (V1.Ix (Gy.ob V)) xx xx) (b : V1.Ix (Ay.tob V xx))
  : Id (V1.Ix (Ay.tob V xx)) (subst (V1.Ix (Gy.ob V)) (\ x2 -> V1.Ix (Ay.tob V x2)) xx xx p b) b =
  apH {Id (V1.Ix (Gy.ob V)) xx xx} {V1.Ix (Ay.tob V xx)} (\ q -> subst (V1.Ix (Gy.ob V)) (\ x2 -> V1.Ix (Ay.tob V x2)) xx xx q b)
   (V1.isSetIx (Gy.ob V) xx xx p (refl xx)) ;
 snat (V W : Ob) (g : Hom V W) (d : V1.Ix (D.ob W)) : Id (V1.Ix (D0.ob V)) (s V (D.act V W g d)) (D0.act V W g (s W d)) =
  Sigma-path (V1.Ix (FCp.ob V)) (\ gg -> V1.Ix (Ay.tob V (evp V gg)))
   (rl V (FC0.GI.act (Cy.o0 V) (Cy.o0 W) (Cy.h0 V W g) d.1)) (FCp.GI.act V W g (rl W d.1)) (s V (D.act V W g d)).2 (D0.act V W g (s W d)).2
   (rlN V W g d.1)
   (transH (substEv V (rl V (FC0.GI.act (Cy.o0 V) (Cy.o0 W) (Cy.h0 V W g) d.1)) (FCp.GI.act V W g (rl W d.1)) (rlN V W g d.1) (s V (D.act V W g d)).2)
     (transH (substLoop V (evp V (FCp.GI.act V W g (rl W d.1))) (apH (evp V) (rlN V W g d.1)) (s V (D.act V W g d)).2)
       (L.tact-irr Gy Ay V W g (evp W (rl W d.1)) (evp V (FCp.GI.act V W g (rl W d.1)))
          (G0.GB.GPre[a+].PS.ntEq FC0.GI G (FC0.ev e) (Cy.o0 V) (Cy.o0 W) (Cy.h0 V W g) d.1 (FC0.GI.act (Cy.o0 V) (Cy.o0 W) (Cy.h0 V W g) d.1) (refl (FC0.GI.act (Cy.o0 V) (Cy.o0 W) (Cy.h0 V W g) d.1)))
          (L.ntEq FCp.GI Gy (FCp.ev e) V W g (rl W d.1) (FCp.GI.act V W g (rl W d.1)) (refl (FCp.GI.act V W g (rl W d.1)))) d.2))) ;
 -- the end types: same fibres
 T : L.PTy[D] = Cy.rTy K0.EK.TV.E K0.Tend ;
 T0 : L.PTy[D0] = Kp.Tend ;
 module TT = PB.GPre[a+].TyL[D, T] ;
 module TT0 = PB.GPre[a+].TyL[D0, T0] ;
 evq (V : Ob) (g : V1.Ix (FCp.ob V)) : V1.Ix (Gy.ob V) = g.1 V (idH V) (PB.ptH V e') ;
 mT (W : Ob) (v : TT.EI W) : TT0.EI W = TT0.pr W (s W (TT.pr1 W v)) (TT.pr2 W v) ;
 mTpt (W : Ob) (v : TT.EI W) : Id (V1.Ix (D0.ob W)) (TT0.pr1 W (mT W v)) (s W (TT.pr1 W v)) = refl (s W (TT.pr1 W v)) ;
 bk (X : Ob) (x : V1.Ix (D.ob X)) (u : V1.Ix (T0.tob X (s X x))) : V1.Ix (T.tob X x) = u ;
 bkMv (X : Ob) (x : V1.Ix (D.ob X)) (u : V1.Ix (T0.tob X (s X x))) : Id (TT0.EI X) (mT X (TT.pr X x (bk X x u))) (TT0.pr X (s X x) u) = refl (TT0.pr X (s X x) u) ;
 mTinj (W : Ob) (v v' : TT.EI W) (Pp : Id (V1.Ix (D.ob W)) (TT.pr1 W v) (TT.pr1 W v')) (Q : Id (TT0.EI W) (mT W v) (mT W v')) : Id (TT.EI W) v v' =
  transH (refl v)
   (transH (idJ (V1.Ix (D.ob W)) (TT.pr1 W v)
             (\ x2 P2 -> (b2 : V1.Ix (T.tob W x2)) -> Id (TT0.EI W) (mT W v) (TT0.pr W (s W x2) b2) -> Id (TT.EI W) (TT.pr W (TT.pr1 W v) (TT.pr2 W v)) (TT.pr W x2 b2))
             (\ b2 Q2 -> apH (TT.pr W (TT.pr1 W v)) (TT0.pr-inj W (s W (TT.pr1 W v)) (TT.pr2 W v) b2 Q2))
             (TT.pr1 W v') Pp (TT.pr2 W v') (transH Q (apH (mT W) (refl v'))))
     (symH (refl v'))) ;
 module MTN (Vv W : Ob) (g : Hom Vv W) (v : TT.EI W) {
  x : V1.Ix (D.ob W) = TT.pr1 W v ;
  b : V1.Ix (T.tob W x) = TT.pr2 W v ;
  x' : V1.Ix (D.ob Vv) = D.act Vv W g x ;
  ep : Id (V1.Ix (Gy.ob Vv)) (Gy.act Vv W g (evq W (s W x).1)) (evq Vv (s Vv x').1) =
   L.ntEq FCp.GI Gy (FCp.ev e') Vv W g (s W x).1 (s Vv x').1
    (L.ntEq D0 FCp.GI (L.pP FCp.GI Lp.FA.Ev[e].Aev) Vv W g (s W x) (s Vv x') (symH (snat Vv W g x))) ;
  e0 : Id (V1.Ix (Gy.ob Vv)) (Gy.act Vv W g (evq W (s W x).1)) (evq Vv (s Vv x').1) =
   G0.GB.GPre[a+].PS.ntEq FC0.GI G (FC0.ev e') (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) x.1 x'.1
    (G0.GB.GPre[a+].PS.ntEq K0.EK.TV.E FC0.GI (G0.GB.GPre[a+].PS.pP FC0.GI L0.FA.Ev[e].Aev) (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) x x' (refl x')) ;
  law : Id (TT0.EI Vv) (TT0.E.act Vv W g (mT W v)) (mT Vv (TT.E.act Vv W g v)) =
   transH (TT0.pr-tact Vv W g (s W x) (s Vv x') (symH (snat Vv W g x)) b)
    (apH (TT0.pr Vv (s Vv x')) (L.tact-irr Gy Ay Vv W g (evq W (s W x).1) (evq Vv (s Vv x').1) ep e0 b)) ;
 } ;
 -- the fibre types: lines in A restricted
 module TA0 = G0.GB.GPre[a+].TyL[G, A] ;
 module TAy = PB.GPre[a+].TyL[Gy, Ay] ;
 module FE0 = G0.GB.CLine[a+].FC[TA0.E] ;
 module FEp = PB.CLine[a+].FC[TAy.E] ;
 rlE (I : Ob) (g : V1.Ix (FE0.ob (Cy.o0 I))) : V1.Ix (FEp.ob I) =
  (\ J u i -> g.1 (Cy.o0 J) (Cy.h0 J I u) i, \ Vv J h u i -> g.2 (Cy.o0 Vv) (Cy.o0 J) (Cy.h0 Vv J h) (Cy.h0 J I u) i) ;
 Sx : L.PTy[D] = Cy.rTy K0.EK.TV.E K0.EK.SFm.SF ;
 S0 : L.PTy[D0] = Kp.EK.SFm.SF ;
 module TS = PB.GPre[a+].TyL[D, Sx] ;
 module TS0 = PB.GPre[a+].TyL[D0, S0] ;
 module MS (W : Ob) (u : TS.EI W) {
  gm : V1.Ix (FC0.ob (Cy.o0 W)) = (TS.pr1 W u).1 ;
  bA : V1.Ix (L0.FA.AI.tob (Cy.o0 W) (TS.pr1 W u).1) = (TS.pr2 W u).1 ;
  bA' : V1.Ix (Lp.FA.AI.tob W (rl W (TS.pr1 W u).1)) = (rlE W bA.1, apH {V1.Ix (FC0.ob (Cy.o0 W))} {V1.Ix (FCp.ob W)} (rl W) bA.2) ;
  xv : V1.Ix (Gy.ob W) = (bA.1.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e)).1 ;
  yv : V1.Ix (Gy.ob W) = gm.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e) ;
  bv : V1.Ix (Ay.tob W xv) = (bA.1.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e)).2 ;
  pp : Id (V1.Ix (Gy.ob W)) xv yv = apH {V1.Ix (FCp.ob W)} {V1.Ix (Gy.ob W)} (\ z -> z.1 W (idH W) (PB.ptH W e)) (apH {V1.Ix (FC0.ob (Cy.o0 W))} {V1.Ix (FCp.ob W)} (rl W) bA.2) ;
  p0 : Id (V1.Ix (Gy.ob W)) xv yv = apH {V1.Ix (FC0.ob (Cy.o0 W))} {V1.Ix (Gy.ob W)} (\ z -> z.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e)) bA.2 ;
  endEq : Id (V1.Ix (Ay.tob W yv)) (subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv pp bv) (subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv p0 bv) =
   apH {Id (V1.Ix (Gy.ob W)) xv yv} {V1.Ix (Ay.tob W yv)} (\ q -> subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv q bv) (V1.isSetIx (Gy.ob W) xv yv pp p0) ;
  prf : Id (V1.Ix (D0.ob W)) (Kp.EK.TV.pr W (rl W gm) (subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv pp bv)) (s W (TS.pr1 W u)) =
   transH (apH {V1.Ix (Ay.tob W yv)} {V1.Ix (D0.ob W)} (Kp.EK.TV.pr W (rl W gm)) endEq) (apH {V1.Ix (D.ob W)} {V1.Ix (D0.ob W)} (s W) (TS.pr2 W u).2) ;
 } ;
 mS (W : Ob) (u : TS.EI W) : TS0.EI W = TS0.pr W (s W (TS.pr1 W u)) (MS[W, u].bA', MS[W, u].prf) ;
 mSpt (W : Ob) (u : TS.EI W) : Id (V1.Ix (D0.ob W)) (TS0.pr1 W (mS W u)) (s W (TS.pr1 W u)) = refl (s W (TS.pr1 W u)) ;
 -- an element of the fibre type is determined by its point and its line in E
 fgtInj (W : Ob) (u : TS0.EI W) : (x2 : V1.Ix (D0.ob W)) (P1 : Id (V1.Ix (D0.ob W)) (TS0.pr1 W u) x2) (b2 : V1.Ix (S0.tob W x2))
   (P2 : Id (V1.Ix (FEp.ob W)) (TS0.pr2 W u).1.1 b2.1.1) -> Id (TS0.EI W) u (TS0.pr W x2 b2) =
  \ x2 P1 -> idJ (V1.Ix (D0.ob W)) (TS0.pr1 W u)
   (\ x3 P3 -> (b3 : V1.Ix (S0.tob W x3)) (P2 : Id (V1.Ix (FEp.ob W)) (TS0.pr2 W u).1.1 b3.1.1) -> Id (TS0.EI W) u (TS0.pr W x3 b3))
   (\ b3 P2 -> apH {V1.Ix (S0.tob W (TS0.pr1 W u))} {TS0.EI W} (TS0.pr W (TS0.pr1 W u))
      (Kp.EK.SFm.sf-eq W (TS0.pr1 W u) (TS0.pr2 W u) b3 (Lp.FA.tob-eq W (TS0.pr1 W u).1 (TS0.pr2 W u).1 b3.1 P2)))
   x2 P1 ;
 rlEN (Vv W : Ob) (g : Hom Vv W) (d : V1.Ix (FE0.ob (Cy.o0 W)))
  : Id (V1.Ix (FEp.ob Vv)) (FEp.GI.act Vv W g (rlE W d)) (rlE Vv (FE0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) d)) =
  FEp.fam-eq Vv (FEp.GI.act Vv W g (rlE W d)) (rlE Vv (FE0.GI.act (Cy.o0 Vv) (Cy.o0 W) (Cy.h0 Vv W g) d)) (\ J u i -> refl (d.1 (Cy.o0 J) (Cy.h0 J W (compH J Vv W g u)) i)) ;
 mSnat (Vv W : Ob) (g : Hom Vv W) (u : TS.EI W) : Id (TS0.EI Vv) (TS0.E.act Vv W g (mS W u)) (mS Vv (TS.E.act Vv W g u)) =
  fgtInj Vv (TS0.E.act Vv W g (mS W u)) (s Vv (TS.pr1 Vv (TS.E.act Vv W g u))) (symH (snat Vv W g (TS.pr1 W u)))
   (TS0.pr2 Vv (mS Vv (TS.E.act Vv W g u))) (rlEN Vv W g (TS.pr2 W u).1.1) ;
 -- the end maps commute with the moves (coe along two proofs of one equation)
 m1 : PB.CPartial[a+].PMap[D, Sx, T] = Cy.rMy K0.EK.TV.E K0.EK.SFm.SF K0.Tend K0.endL ;
 module SQ (W : Ob) (v : TS.EI W) {
  bA : V1.Ix (L0.FA.AI.tob (Cy.o0 W) (TS.pr1 W v).1) = (TS.pr2 W v).1 ;
  xv : V1.Ix (Gy.ob W) = (bA.1.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e')).1 ;
  yv : V1.Ix (Gy.ob W) = (TS.pr1 W v).1.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e') ;
  bv : V1.Ix (Ay.tob W xv) = (bA.1.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e')).2 ;
  p0 : Id (V1.Ix (Gy.ob W)) xv yv = apH {V1.Ix (FC0.ob (Cy.o0 W))} {V1.Ix (Gy.ob W)} (\ z -> z.1 (Cy.o0 W) (Cy.h0 W W (idH W)) (PB.ptH W e')) bA.2 ;
  pp : Id (V1.Ix (Gy.ob W)) xv yv = apH {V1.Ix (FCp.ob W)} {V1.Ix (Gy.ob W)} (\ z -> z.1 W (idH W) (PB.ptH W e')) (apH {V1.Ix (FC0.ob (Cy.o0 W))} {V1.Ix (FCp.ob W)} (rl W) bA.2) ;
  law : Id (TT0.EI W) (mT W (m1.mE W v)) (Kp.endL.mE W (mS W v)) =
   apH {V1.Ix (Ay.tob W yv)} {TT0.EI W} (TT0.pr W (s W (TS.pr1 W v)))
    (apH {Id (V1.Ix (Gy.ob W)) xv yv} {V1.Ix (Ay.tob W yv)} (\ q -> subst (V1.Ix (Gy.ob W)) (\ z -> V1.Ix (Ay.tob W z)) xv yv q bv) (V1.isSetIx (Gy.ob W) xv yv p0 pp)) ;
 } ;
 -- the copy's composition, moved to the restriction of the G0 line kit
 move (k0 : Kp.Comp) : PB.CPartial[a+].Rel[D, Sx, T, m1].RC =
  PB.CMove[a+, a+].Mv[D, Sx, T, m1, D0, S0, T0, Kp.endL, s, snat, mS, mSpt, mSnat, mT, mTpt, \ Vv W g v -> MTN[Vv, W, g, v].law,
    mTinj, bk, bkMv, \ W v -> SQ[W, v].law, k0].rc ;
} ;

-- a fibration structure on G0 from one on each copy
module FibC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (G : CCopy[a].ConcC[R, encK, pe].P0.PCtx) (A : CCopy[a].ConcC[R, encK, pe].P0.PTy[G])
  (f : (y : SX.Over[R].Presentation) -> PB.CLine[a+].Lines[CCopy[a].ConcC[R, encK, pe].Copy[y].rCy G, CCopy[a].ConcC[R, encK, pe].Copy[y].rTy G A].Fib) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module LG = CC.G0.GB.CLine[a+].Lines[G, A] ;
 module K01 = LG.CompK[PB.e0, PB.e1] ;
 module K10 = LG.CompK[PB.e1, PB.e0] ;
 c01 : K01.Comp = CCopy4[a].RComp[R, encK, pe, K01.EK.TV.E, K01.EK.SFm.SF, K01.Tend, K01.endL, \ y -> LK[R, encK, pe, G, A, y, PB.e0, PB.e1].move (f y).1].rc ;
 c10 : K10.Comp = CCopy4[a].RComp[R, encK, pe, K10.EK.TV.E, K10.EK.SFm.SF, K10.Tend, K10.endL, \ y -> LK[R, encK, pe, G, A, y, PB.e1, PB.e0].move (f y).2].rc ;
 fib : LG.Fib = (c01, c10) ;
} ;
