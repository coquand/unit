-- CCmpK29.seg (canonicity-c2; (K) for cmpI, part 29): over the stage-1 body
-- context, R2 (K24) at q2 := ev g_2, applied to g, refl and the element of
-- S[ev g_1] (K28): an element of Fib (g).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module K29 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K28m = CCmpK28[a].K28[R, encK, pe, y] ;
 module K24m = CCmpK24[a].K24[R, encK, pe, y] ;
 module K26m = K28m.K26m ;
 module K19m = K24m.K19m ;
 Nl : C.Ctx = C.nil ;
 Q : C.Ty Nl = K19m.Q ;
 HTT : C.Ty Nl = K19m.HTT ;
 G1 : C.Ctx = K19m.G1 ;
 Cb : C.Ctx = K26m.Cb ;
 s0b : C.Sub Cb Nl = K26m.s0b ;
 ev2 : C.El Cb (C.subT Cb Nl Q s0b) = CInjP[a].IP[HTT, Q, K19m.K3m.m2].evS Cb s0b K26m.gEl ;
 sg : C.Sub Cb G1 = CQSurj[a].Ex[C].exS Cb Nl Q s0b ev2 ;
 X2s : C.Ty Cb = C.subT Cb G1 K19m.X2 sg ;
 gN (J I : Ob) (f : Hom J I) (w : V1.Ix (Cb.ob I))
   : Id (V1.Ix (X2s.1.tob J (Cb.act J I f w))) (X2s.1.tact J I f w (Cb.act J I f w) (refl (Cb.act J I f w)) w.1.2) (Cb.act J I f w).1.2 =
  L.tact-irr Nl HTT.1 J I f w.1.1.1.1 w.1.1.1.1
   (L.ntEq G1 Nl K19m.s1G J I f (sg.nt I w) (sg.nt J (Cb.act J I f w)) (L.ntEq Cb G1 sg J I f w (Cb.act J I f w) (refl (Cb.act J I f w)))) (refl w.1.1.1.1) w.1.2 ;
 gS : C.El Cb X2s = L.mkPEl Cb X2s.1 (\ K w -> w.1.2) (\ J I f w w' e ->
  idJ (V1.Ix (Cb.ob J)) (Cb.act J I f w) (\ w2 e2 -> Id (V1.Ix (X2s.1.tob J w2)) (X2s.1.tact J I f w w2 e2 w.1.2) w2.1.2) (gN J I f w) w' e) ;
 module Ex = CQSurj[a].Ex[C] ;
 C1 : C.Ctx = K19m.C1 ;
 C2 : C.Ctx = K19m.C2 ;
 C3 : C.Ctx = K19m.C3 ;
 nu1 : C.Sub Cb C1 = Ex.exS Cb G1 K19m.X2 sg gS ;
 QC1n : C.Ty Cb = C.subT Cb C1 K19m.QC1 nu1 ;
 r0 : C.El Cb (IJ.IdT Cb QC1n (C.subt Cb C1 K19m.QC1 K19m.ev2C1 nu1) (C.subt Cb C1 K19m.QC1 K19m.q2C1 nu1)) =
  CCmpU14[a].rwId Cb QC1n (C.subt Cb C1 K19m.QC1 K19m.ev2C1 nu1) (C.subt Cb C1 K19m.QC1 K19m.ev2C1 nu1) (C.subt Cb C1 K19m.QC1 K19m.ev2C1 nu1) (C.subt Cb C1 K19m.QC1 K19m.q2C1 nu1)
   (\ K w -> refl ((C.subt Cb C1 K19m.QC1 K19m.ev2C1 nu1).eob K w)) (\ K w -> refl ((C.subt Cb C1 K19m.QC1 K19m.ev2C1 nu1).eob K w))
   (IJ.rfl Cb QC1n (C.subt Cb C1 K19m.QC1 K19m.ev2C1 nu1)) ;
 rEl : C.El Cb (C.subT Cb C1 K19m.H2 nu1) =
  OV.trE Cb (IJ.IdT Cb QC1n (C.subt Cb C1 K19m.QC1 K19m.ev2C1 nu1) (C.subt Cb C1 K19m.QC1 K19m.q2C1 nu1)) (C.subT Cb C1 K19m.H2 nu1)
   (symH (IJ.IdT-nat Cb C1 K19m.QC1 K19m.ev2C1 K19m.q2C1 nu1)) r0 ;
 nu2 : C.Sub Cb C2 = Ex.exS Cb C1 K19m.H2 nu1 rEl ;
 PS : Id (C.Ty Cb) (C.subT Cb G1 K19m.QS.S K28m.SA.sg) (C.subT Cb C2 K19m.S1' nu2) =
  transH (apH {C.Sub Cb G1} {C.Ty Cb} (\ s -> C.subT Cb G1 K19m.QS.S s)
           (L.sub-ext Cb G1 K28m.SA.sg (C.o Cb C2 G1 K19m.sgS1 nu2) (\ K w -> refl (K28m.SA.sg.nt K w))))
   (C.subT-o Cb C2 G1 K19m.QS.S K19m.sgS1 nu2) ;
 sEl : C.El Cb (C.subT Cb C2 K19m.S1' nu2) = OV.trE Cb (C.subT Cb G1 K19m.QS.S K28m.SA.sg) (C.subT Cb C2 K19m.S1' nu2) PS K28m.s2 ;
 nu3 : C.Sub Cb C3 = Ex.exS Cb C2 K19m.S1' nu2 sEl ;
 -- the body of R2, at nu3
 b1 : C.El C1 K19m.PiH = OV.bod G1 K19m.X2 K19m.PiH K24m.R2 ;
 b2 : C.El C2 K19m.PiS = OV.bod C1 K19m.H2 K19m.PiS b1 ;
 b3 : C.El C3 K19m.F2 = OV.bod C2 K19m.S1' K19m.F2 b2 ;
 F1l : C.Ty Cb = C.subT Cb K26m.K25m.Cc K26m.K25m.F1 K26m.l2 ;
 PF : Id (C.Ty Cb) (C.subT Cb C3 K19m.F2 nu3) F1l =
  transH (symH (C.subT-o Cb C3 K19m.K12m.GB K19m.I.Fib K19m.tg nu3))
   (transH (apH {C.Sub Cb K19m.K12m.GB} {C.Ty Cb} (\ s -> C.subT Cb K19m.K12m.GB K19m.I.Fib s)
             (L.sub-ext Cb K19m.K12m.GB (C.o Cb C3 K19m.K12m.GB K19m.tg nu3) (C.o Cb K26m.K25m.Cc K19m.K12m.GB K26m.K25m.tg K26m.l2) (\ K w -> refl (w.1.1.1.1, w.1.2))))
     (C.subT-o Cb K26m.K25m.Cc K19m.K12m.GB K19m.I.Fib K26m.K25m.tg K26m.l2)) ;
 body : C.El Cb F1l = OV.trE Cb (C.subT Cb C3 K19m.F2 nu3) F1l PF (C.subt Cb C3 K19m.F2 b3 nu3) ;
} ;
