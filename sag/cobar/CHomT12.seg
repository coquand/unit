-- CHomT12.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 9: the codes come back,
-- beta (alpha m) = m (CMorX.mExt: the families agree, each datum by
-- cancelling the transports along comp-idr and across CHomData's type
-- equations).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

-- transport along a path after its inverse
sInvR (A : U a++) (Pf : A -> U a++) (x y : A) (p : Id A x y) (v : Pf y) : Id (Pf y) (subst A Pf x y p (subst A Pf y x (symH p) v)) v =
 idJ A x (\ y2 p2 -> (v2 : Pf y2) -> Id (Pf y2) (subst A Pf x y2 p2 (subst A Pf y2 x (symH p2) v2)) v2) (\ v2 -> refl v2) y p v ;
sInvL (A : U a++) (Pf : A -> U a++) (x y : A) (p : Id A x y) (v : Pf x) : Id (Pf x) (subst A Pf y x (symH p) (subst A Pf x y p v)) v =
 idJ A x (\ y2 p2 -> Id (Pf x) (subst A Pf y2 x (symH p2) (subst A Pf x y2 p2 v)) v) (refl v) y p ;

module RT1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module TM = CHomT8[a].ToM[R, encK, pe, s, t] ;
 module FM = CHomT11[a].FromM[R, encK, pe, s, t] ;
 module P = TM.P ;
 module F = P.F ;
 module At (I : Ob) (m : F.M I) {
  z : P.Z I = FM.alpha I m ;
  ph : F.Fam I = m.1.1 ;
  daEq : Id (F.BA.DT I ph) (P.da I z) m.2.1.1 =
   funext Ob (\ K -> (f : Hom K I) (w : F.S.T3 K) (p : V1.Ix (F.BA.FS K w)) -> V1.Ix (F.BA.FT K (F.mp3 I ph K f w))) (P.da I z) m.2.1.1 (\ K ->
   funext (Hom K I) (\ f -> (w : F.S.T3 K) (p : V1.Ix (F.BA.FS K w)) -> V1.Ix (F.BA.FT K (F.mp3 I ph K f w))) (P.da I z K) (m.2.1.1 K) (\ f ->
   funext (F.S.T3 K) (\ w -> (p : V1.Ix (F.BA.FS K w)) -> V1.Ix (F.BA.FT K (F.mp3 I ph K f w))) (P.da I z K f) (m.2.1.1 K f) (\ w ->
   funext (V1.Ix (F.BA.FS K w)) (\ p -> V1.Ix (F.BA.FT K (F.mp3 I ph K f w))) (P.da I z K f w) (m.2.1.1 K f w) (\ p ->
    sInvR (Hom K I) (\ k -> V1.Ix (F.BA.FT K (F.mp3 I ph K k w))) (compH K K I f (idH K)) f (comp-idr K I f) (m.2.1.1 K f w p))))) ;
  dmEq : Id (F.BM.DT I ph) (P.dm I z) m.2.2.1.1 =
   funext Ob (\ K -> (f : Hom K I) (w : F.S.T3 K) (p : V1.Ix (F.BM.FS K w)) -> V1.Ix (F.BM.FT K (F.mp3 I ph K f w))) (P.dm I z) m.2.2.1.1 (\ K ->
   funext (Hom K I) (\ f -> (w : F.S.T3 K) (p : V1.Ix (F.BM.FS K w)) -> V1.Ix (F.BM.FT K (F.mp3 I ph K f w))) (P.dm I z K) (m.2.2.1.1 K) (\ f ->
   funext (F.S.T3 K) (\ w -> (p : V1.Ix (F.BM.FS K w)) -> V1.Ix (F.BM.FT K (F.mp3 I ph K f w))) (P.dm I z K f) (m.2.2.1.1 K f) (\ w ->
   funext (V1.Ix (F.BM.FS K w)) (\ p -> V1.Ix (F.BM.FT K (F.mp3 I ph K f w))) (P.dm I z K f w) (m.2.2.1.1 K f w) (\ p ->
    sInvR (Hom K I) (\ k -> V1.Ix (F.BM.FT K (F.mp3 I ph K k w))) (compH K K I f (idH K)) f (comp-idr K I f) (m.2.2.1.1 K f w p))))) ;
  module CC (r : R.R) (K : Ob) (f : Hom K I) (u : F.S.QK K) (p : V1.Ix (F.NC[r].N.FS K u)) {
   module CR = P.CR[r] ;
   module Q = FM.RC.RR[r] ;
   dcm : V1.Ix (F.NC[r].N.FT K (ph K f u)) = (m.2.2.2 r).1 K f u p ;
   inner : V1.Ix (Q.AT.1.tob K (tt, ph K f u)) =
    subst (C.Ty CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, ph K f u))) CR.PT.CT.IdCst Q.AT (symH CR.PT.IdP)
     ((m.2.2.2 r).1 K f u (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) Q.AS CR.PS.CT.IdCst CR.PS.IdP
                            (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) CR.PS.CT.IdCst Q.AS (symH CR.PS.IdP) p))) ;
   s1 : Id (V1.Ix (Q.AT.1.tob K (tt, ph K f u)))
          (subst (Hom K I) (\ k -> V1.Ix (Q.AT.1.tob K (tt, ph K k u))) (compH K K I f (idH K)) f (comp-idr K I f)
            (subst (Hom K I) (\ k -> V1.Ix (Q.AT.1.tob K (tt, ph K k u))) f (compH K K I f (idH K)) (symH (comp-idr K I f)) inner)) inner =
    sInvR (Hom K I) (\ k -> V1.Ix (Q.AT.1.tob K (tt, ph K k u))) (compH K K I f (idH K)) f (comp-idr K I f) inner ;
   s2 : Id (V1.Ix (F.NC[r].N.FT K (ph K f u)))
          (subst (C.Ty CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, ph K f u))) Q.AT CR.PT.CT.IdCst CR.PT.IdP inner)
          ((m.2.2.2 r).1 K f u (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) Q.AS CR.PS.CT.IdCst CR.PS.IdP
                            (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) CR.PS.CT.IdCst Q.AS (symH CR.PS.IdP) p))) =
    CHomT10[a].trInvR CR.PT.Q3.G1 Q.AT CR.PT.CT.IdCst CR.PT.IdP K (tt, ph K f u)
     ((m.2.2.2 r).1 K f u (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) Q.AS CR.PS.CT.IdCst CR.PS.IdP
                            (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) CR.PS.CT.IdCst Q.AS (symH CR.PS.IdP) p))) ;
   s3 : Id (V1.Ix (F.NC[r].N.FT K (ph K f u)))
          ((m.2.2.2 r).1 K f u (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) Q.AS CR.PS.CT.IdCst CR.PS.IdP
                            (subst (C.Ty CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, u))) CR.PS.CT.IdCst Q.AS (symH CR.PS.IdP) p))) dcm =
    apH {V1.Ix (F.NC[r].N.FS K u)} {V1.Ix (F.NC[r].N.FT K (ph K f u))} (\ q -> (m.2.2.2 r).1 K f u q)
     (CHomT10[a].trInvR CR.PS.Q3.G1 Q.AS CR.PS.CT.IdCst CR.PS.IdP K (tt, u) p) ;
   law : Id (V1.Ix (F.NC[r].N.FT K (ph K f u))) (CR.dc I z K f u p) dcm =
    transH (apH {V1.Ix (Q.AT.1.tob K (tt, ph K f u))} {V1.Ix (F.NC[r].N.FT K (ph K f u))}
              (\ v -> subst (C.Ty CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, ph K f u))) Q.AT CR.PT.CT.IdCst CR.PT.IdP v) s1)
     (transH s2 s3) ;
  } ;
  dcEq : Id ((r : R.R) -> F.NC[r].N.DT I ph) (\ r -> P.CR[r].dc I z) (\ r -> (m.2.2.2 r).1) =
   funext R.R (\ r -> F.NC[r].N.DT I ph) (\ r -> P.CR[r].dc I z) (\ r -> (m.2.2.2 r).1) (\ r ->
   funext Ob (\ K -> (f : Hom K I) (u : F.S.QK K) (p : V1.Ix (F.NC[r].N.FS K u)) -> V1.Ix (F.NC[r].N.FT K (ph K f u))) (P.CR[r].dc I z) ((m.2.2.2 r).1) (\ K ->
   funext (Hom K I) (\ f -> (u : F.S.QK K) (p : V1.Ix (F.NC[r].N.FS K u)) -> V1.Ix (F.NC[r].N.FT K (ph K f u))) (P.CR[r].dc I z K) ((m.2.2.2 r).1 K) (\ f ->
   funext (F.S.QK K) (\ u -> (p : V1.Ix (F.NC[r].N.FS K u)) -> V1.Ix (F.NC[r].N.FT K (ph K f u))) (P.CR[r].dc I z K f) ((m.2.2.2 r).1 K f) (\ u ->
   funext (V1.Ix (F.NC[r].N.FS K u)) (\ p -> V1.Ix (F.NC[r].N.FT K (ph K f u))) (P.CR[r].dc I z K f u) ((m.2.2.2 r).1 K f u) (\ p ->
    CC[r, K, f, u, p].law))))) ;
  fpEq : Id (F.FP I) (P.fp I z) (F.fpOf I m) =
   transH (apH {F.BA.DT I ph} {F.FP I} (\ x -> (ph, (x, (P.dm I z, \ r -> P.CR[r].dc I z)))) daEq)
    (transH (apH {F.BM.DT I ph} {F.FP I} (\ x -> (ph, (m.2.1.1, (x, \ r -> P.CR[r].dc I z)))) dmEq)
      (apH {(r : R.R) -> F.NC[r].N.DT I ph} {F.FP I} (\ x -> (ph, (m.2.1.1, (m.2.2.1.1, x)))) dcEq)) ;
  rt : Id (F.M I) (TM.beta I z) m = F.mExt I (TM.beta I z) m fpEq ;
 } ;
} ;
