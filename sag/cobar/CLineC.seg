-- CLineC.seg (canonicity-45; COBAR.md "Prop 58", 4e's ruling on code paths):
-- a closed internal Id e : a = b in a closed fibrant type A gives a global
-- line in A from a to b (its value at every stage W and interval point j,
-- natural in W, with the two ends), read off ClRd's homotopy between the
-- constant maps from the unit type.  The map part of a line of codes.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module LF (A : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil) (Pa Pb : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil A)
  (e : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (FibId[a, a+].fibId.IdT FibCwF[a, a+].fibCwF.nil A Pa Pb)) {
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 U0 : L.PTy[Nl] = L.mkTy Nl (\ I x -> V1.unitV) (\ J I f x y e1 u -> u) (\ I x e1 u -> refl u) (\ K J I f g x x' x'' e1 e2 e3 u -> refl u) ;
 module CR = CClRd[a, a+].ClRd[Nl, A, Pa, Pb, e, U0] ;
 module T = CR.T ;
 module TY = CR.TY ;
 K : L.PCtx = L.extP Nl U0 ;
 z0 (W : Ob) : V1.Ix (K.ob W) = (tt, tt) ;
 -- the line: value at (W, j)
 lv (W : Ob) (j : Hom W Iv) : TY.EI W = T.pv CR.res W (z0 W) W (idH W) j ;
 -- its ends
 l0 (W : Ob) : Id (TY.EI W) (lv W (PB.ptH W PB.e0)) (TY.pr W tt (Pa.eob W tt)) = (CR.res.eob W (z0 W)).2.2.1 ;
 l1 (W : Ob) : Id (TY.EI W) (lv W (PB.ptH W PB.e1)) (TY.pr W tt (Pb.eob W tt)) = (CR.res.eob W (z0 W)).2.2.2 ;
 -- naturality: restricting the value at (W, j) along g is the value at (V, j g)
 ln (V W : Ob) (g : Hom V W) (j : Hom W Iv) : Id (TY.EI V) (TY.E.act V W g (lv W j)) (lv V (compH V W Iv j g)) =
  transH ((CR.res.eob W (z0 W)).1.2 V W g (idH W) j)
   (transH (apH {Hom V W} {TY.EI V} (\ h -> T.pv CR.res W (z0 W) V h (compH V W Iv j g)) (transH (comp-idl V W g) (symH (comp-idr V W g))))
     (T.pv-res CR.res V W g (z0 W) (z0 V) (refl (z0 V)) V (idH V) (compH V W Iv j g))) ;
} ;

-- a global code F1 -> t (a code at every stage, natural) as a closed element of HomT(F1, t)
module GC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation)
  (m : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mn : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (m J)) (m K)) {
 module CM = CCopy[a].ConcC[R, encK, pe].CM ;
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 HT : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = CHomT3[a].HomP[R, encK, pe].Hom[CM.F1, t].HomT ;
 module FM = CHomT11[a].FromM[R, encK, pe, CM.F1, t] ;
 module NT = CHomT16[a].Nat[R, encK, pe, CM.F1, t] ;
 hob (K : Ob) : (o : Top) -> V1.Ix (HT.1.tob K o) = split { tt -> FM.alpha K (m K) } ;
 hnat (J I : Ob) (f : Hom J I) : (o o' : Top) (e : Id Top (Nl.act J I f o) o') -> Id (V1.Ix (HT.1.tob J o')) (HT.1.tact J I f o o' e (hob I o)) (hob J o') =
  split { tt -> split { tt -> \ e ->
   transH (L.tact-irr Nl HT.1 J I f tt tt e (refl tt) (FM.alpha I (m I)))
    (transH (symH (NT.aNat I J f (m I))) (apH {CM.MO.Fn[CM.F1, t].M J} {V1.Ix (HT.1.tob J tt)} (FM.alpha J) (mn I J f))) } } ;
 hc : FibCwF[a, a+].fibCwF.El Nl HT = L.mkPEl Nl HT.1 hob hnat ;
} ;

-- two global codes F1 -> t agreeing at the generator (an Id over nil.HomT, the
-- form of c2's (U)) are internally equal as closed homs (UG30 at s = F1)
module EqC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation)
  (ma : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mna : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (ma J)) (ma K))
  (mb : (K : Ob) -> CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
  (mnb : (J K : Ob) (v : Hom K J) -> Id (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].M K)
          (CCopy[a].ConcC[R, encK, pe].CM.MO.Fn[CCopy[a].ConcC[R, encK, pe].CM.F1, t].res J K v (mb J)) (mb K)) {
 module GA = GC[R, encK, pe, t, ma, mna] ;
 module GB' = GC[R, encK, pe, t, mb, mnb] ;
 C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
 Nl : C.Ctx = C.nil ;
 HT : C.Ty Nl = GA.HT ;
 GH : C.Ctx = C.ext Nl HT ;
 pkA (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HT.1.tob K w.1) = GA.hob K w.1 ;
 pkB (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (HT.1.tob K w.1) = GB'.hob K w.1 ;
 pkAN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HT.1.tob J w.1)) (HT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J (GH.act J I f w)) =
  GA.hnat J I f w.1 w.1 (refl w.1) ;
 pkBN (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I)) : Id (V1.Ix (HT.1.tob J w.1)) (HT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J (GH.act J I f w)) =
  GB'.hnat J I f w.1 w.1 (refl w.1) ;
 module U20 = CUG20[a].UG20[R, encK, pe, GA.CM.F1, t, HT, pkA, pkB, pkAN, pkBN] ;
 cx : C.El Nl U20.U13m.QA = CHomT3[a].HomP[R, encK, pe].Alg[GA.CM.F1].AX.cls (var (inr tt)) ;
 module At (gen : C.El GH (U20.IdZ cx)) {
  genU : (u : Top) -> C.El GH (U20.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[GA.CM.F1].AX.cls (var (inr u)))) = split { tt -> gen } ;
  genF : (v : SX.Fin GA.CM.F1.1) -> C.El GH (U20.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[GA.CM.F1].AX.cls (var v))) = split {
   inl e -> absurd (C.El GH (U20.IdZ (CHomT3[a].HomP[R, encK, pe].Alg[GA.CM.F1].AX.cls (var (inl e))))) e ;
   inr u -> genU u } ;
  module U30 = CUG30[a].UG30[R, encK, pe, GA.CM.F1, t, HT, pkA, pkB, pkAN, pkBN, genF] ;
  -- at the point alpha(a) of HomT
  sc : C.Sub Nl GH = C.sec Nl HT GA.hc ;
  A' : C.Ty Nl = C.subT Nl GH U30.HSh sc ;
  e1 : C.El Nl (C.subT Nl GH (IJ.IdT GH U30.HSh U30.zA U30.zB) sc) = C.subt Nl GH (IJ.IdT GH U30.HSh U30.zA U30.zB) U30.res sc ;
  e2 : C.El Nl (IJ.IdT Nl A' (C.subt Nl GH U30.HSh U30.zA sc) (C.subt Nl GH U30.HSh U30.zB sc)) =
   OV.trE Nl (C.subT Nl GH (IJ.IdT GH U30.HSh U30.zA U30.zB) sc) (IJ.IdT Nl A' (C.subt Nl GH U30.HSh U30.zA sc) (C.subt Nl GH U30.HSh U30.zB sc))
    (IJ.IdT-nat Nl GH U30.HSh U30.zA U30.zB sc) e1 ;
  P2 : Id (C.Ty Nl) A' HT = CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl HT HT GA.hc ;
  e3 : C.El Nl (IJ.IdT Nl HT (OV.trE Nl A' HT P2 (C.subt Nl GH U30.HSh U30.zA sc)) (OV.trE Nl A' HT P2 (C.subt Nl GH U30.HSh U30.zB sc))) =
   CCmpU16[a].U16[R, encK, pe, t].idFwd Nl A' HT P2 (C.subt Nl GH U30.HSh U30.zA sc) (C.subt Nl GH U30.HSh U30.zB sc) e2 ;
  rdP (x : C.El Nl A') (K : Ob) (o : V1.Ix (Nl.ob K)) : Id (V1.Ix (HT.1.tob K o)) ((OV.trE Nl A' HT P2 x).eob K o) (x.eob K o) =
   transH (CAppRd[a].trE-rd Nl A' HT P2 x K o) (CAppRd[a].same-rd Nl A' HT P2 K o (refl (HT.1.tob K o)) (x.eob K o)) ;
  -- the closed Id alpha(a) = alpha(b) in HomT(F1, t)
  eq : C.El Nl (IJ.IdT Nl HT GA.hc GB'.hc) =
   CCmpU14[a].rwId Nl HT (OV.trE Nl A' HT P2 (C.subt Nl GH U30.HSh U30.zA sc)) GA.hc (OV.trE Nl A' HT P2 (C.subt Nl GH U30.HSh U30.zB sc)) GB'.hc
    (rdP (C.subt Nl GH U30.HSh U30.zA sc)) (rdP (C.subt Nl GH U30.HSh U30.zB sc)) e3 ;
  -- the line of codes: beta of the line in HomT
  module LN = LF[HT, GA.hc, GB'.hc, eq] ;
  module FF = GA.CM.MO.Fn[GA.CM.F1, t] ;
  module TM = CHomT8[a].ToM[R, encK, pe, GA.CM.F1, t] ;
  bt (W : Ob) : (o : Top) -> V1.Ix (HT.1.tob W o) -> FF.M W = split { tt -> \ z -> TM.beta W z } ;
  lc (W : Ob) (j : Hom W Iv) : FF.M W = bt W (LN.lv W j).1 (LN.lv W j).2 ;
  -- the ends
  btE (W : Ob) (v v' : LN.TY.EI W) (q : Id (LN.TY.EI W) v v') : Id (FF.M W) (bt W v.1 v.2) (bt W v'.1 v'.2) =
   apH {LN.TY.EI W} {FF.M W} (\ v2 -> bt W v2.1 v2.2) q ;
  lc0 (W : Ob) : Id (FF.M W) (lc W (PB.ptH W PB.e0)) (ma W) =
   transH (btE W (LN.lv W (PB.ptH W PB.e0)) (LN.TY.pr W tt (GA.hc.eob W tt)) (LN.l0 W)) (CHomT12[a].RT1[R, encK, pe, GA.CM.F1, t].At[W, ma W].rt) ;
  lc1 (W : Ob) : Id (FF.M W) (lc W (PB.ptH W PB.e1)) (mb W) =
   transH (btE W (LN.lv W (PB.ptH W PB.e1)) (LN.TY.pr W tt (GB'.hc.eob W tt)) (LN.l1 W)) (CHomT12[a].RT1[R, encK, pe, GA.CM.F1, t].At[W, mb W].rt) ;
  -- naturality: restricting the code at (W, j) along g is the code at (V, j g)
  btN (W V : Ob) (g : Hom V W) : (o : Top) (z : V1.Ix (HT.1.tob W o))
   -> Id (FF.M V) (FF.res W V g (bt W o z)) (bt V (Nl.act V W g o) (HT.1.tact V W g o (Nl.act V W g o) (refl (Nl.act V W g o)) z)) = split {
   tt -> \ z -> transH (symH (CHomT12[a].RT1[R, encK, pe, GA.CM.F1, t].At[V, FF.res W V g (TM.beta W z)].rt))
     (apH {V1.Ix (HT.1.tob V tt)} {FF.M V} (TM.beta V)
       (transH (GA.NT.aNat W V g (TM.beta W z))
         (apH {V1.Ix (HT.1.tob W tt)} {V1.Ix (HT.1.tob V tt)} (\ u -> HT.1.tact V W g tt tt (refl tt) u) (CHomT13[a].RT2[R, encK, pe, GA.CM.F1, t].At[W, z].rt)))) } ;
  lcN (V W : Ob) (g : Hom V W) (j : Hom W Iv) : Id (FF.M V) (FF.res W V g (lc W j)) (lc V (compH V W Iv j g)) =
   transH (btN W V g (LN.lv W j).1 (LN.lv W j).2)
    (btE V (LN.TY.E.act V W g (LN.lv W j)) (LN.lv V (compH V W Iv j g)) (LN.ln V W g j)) ;
 } ;
} ;
