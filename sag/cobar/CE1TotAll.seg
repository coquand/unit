-- CE1TotAll.seg (canonicity-45; COBAR.md "Prop 58"): total-site E1 with the
-- constants supplied (CE1Cst): for every term s of a presentation t, G's
-- evaluation of s at the maps g_i = tau . pre_(x_i) : yo(t) -> G is homotopic to
-- tau . pre_(k_s), a path homotopy at the total site.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module TA (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation) {
 module T = CE1Tot3[a].T3[R, encK, pe, t] ;
 module A = T.A ;
 module I = T.Ind[\ r -> CE1Cst[a].CS[R, encK, pe, t, r].cT, \ r -> CE1Cst[a].CS[R, encK, pe, t, r].cC] ;
 E1 : (s : A.TmT) -> A.G1.GB.GPre[a+].PS.PEl[A.G1.GB.GPre[a+].PS.extP A.P1 A.XT, A.HO1.HT[A.P1, A.XT, A.GT, I.Lv s, A.Rs s].PT.PathP] = I.E1 ;
} ;
