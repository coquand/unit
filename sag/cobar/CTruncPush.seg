-- CTruncPush.seg (canonicity-c2; SIMPLIFIED.md item 1): the pushforward
-- of a type along a map of contexts s : D -> G of the base.
--
-- (s_* P)(X , x) is the set of families phi assigning to every map
-- h : W -> X and every point d of D at W over x.h (s d = x.h) an element
-- phi W h d e of P(W , d), natural in W: restricting phi W h d e along
-- k : W' -> W gives phi W' (h k) (d.k) (the canonical proof).  The
-- restriction of s_* P along k : Y -> X reindexes: (phi.k) W h d e =
-- phi W (k h) d e'.  The proofs e are irrelevant (points form a set).
--   Push.pushTy : PTy[G]
--   Push.push-eq   families with the same values are equal
-- Used for the base truncation: the recursor into s_* of an extension
-- algebra compares truncations along s (CTruncPushAlg, next).
level a l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ; module VL = VLift[a, l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[l] ; open PR.PS ;

-- the code of a proposition
prV (Q : U l) (pq : isProp Q) : W.V = W.mkV Q (\ p -> W.emptyV) (\ p p' r -> pq p p') ;
piOb (B : Ob -> W.V) : W.V = VL.PiS Ob (VL.encIx obV) (VL.encIx-inj obV) B ;
piHom (Y X : Ob) (B : Hom Y X -> W.V) : W.V = VL.PiS (Hom Y X) (VL.encIx (homV Y X)) (VL.encIx-inj (homV Y X)) B ;

module Push (D G : PCtx) (s : PSub[D, G]) (P : PTy[D]) {
  GP (X : Ob) : U l = W.Ix (G.ob X) ;
  DP (X : Ob) : U l = W.Ix (D.ob X) ;
  Ov (X : Ob) (x : GP X) (Y : Ob) (h : Hom Y X) (d : DP Y) : U l = Id (GP Y) (s.nt Y d) (G.act Y X h x) ;
  -- the canonical proof for a restricted point
  ovK (X : Ob) (x : GP X) (Z Y : Ob) (k : Hom Z Y) (h : Hom Y X) (d : DP Y) (e : Ov X x Y h d)
    : Ov X x Z (compH Z Y X h k) (D.act Z Y k d) =
    transH (s.nt-nat Z Y k d) (transH (apH (G.act Z Y k) e) (symH (G.act-o Z Y X h k x))) ;

  famV (X : Ob) (x : GP X) : W.V =
    piOb (\ Y -> piHom Y X (\ h -> W.PiV (D.ob Y) (\ d ->
      W.PiV (prV (Ov X x Y h d) (W.isSetIx (G.ob Y) (s.nt Y d) (G.act Y X h x))) (\ e -> P.tob Y d)))) ;
  Fam (X : Ob) (x : GP X) : U l = W.Ix (famV X x) ;
  NatF (X : Ob) (x : GP X) (phi : Fam X x) : U l =
    (Z Y : Ob) (k : Hom Z Y) (h : Hom Y X) (d : DP Y) (e : Ov X x Y h d)
    -> Id (W.Ix (P.tob Z (D.act Z Y k d)))
         (P.tact Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)) (phi Y h d e))
         (phi Z (compH Z Y X h k) (D.act Z Y k d) (ovK X x Z Y k h d e)) ;
  natF-prop (X : Ob) (x : GP X) (phi : Fam X x) : isProp (NatF X x phi) =
    isProp-Pi Ob (\ Z -> (Y : Ob) (k : Hom Z Y) (h : Hom Y X) (d : DP Y) (e : Ov X x Y h d) -> Id (W.Ix (P.tob Z (D.act Z Y k d))) (P.tact Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)) (phi Y h d e)) (phi Z (compH Z Y X h k) (D.act Z Y k d) (ovK X x Z Y k h d e))) (\ Z ->
    isProp-Pi Ob (\ Y -> (k : Hom Z Y) (h : Hom Y X) (d : DP Y) (e : Ov X x Y h d) -> Id (W.Ix (P.tob Z (D.act Z Y k d))) (P.tact Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)) (phi Y h d e)) (phi Z (compH Z Y X h k) (D.act Z Y k d) (ovK X x Z Y k h d e))) (\ Y ->
    isProp-Pi (Hom Z Y) (\ k -> (h : Hom Y X) (d : DP Y) (e : Ov X x Y h d) -> Id (W.Ix (P.tob Z (D.act Z Y k d))) (P.tact Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)) (phi Y h d e)) (phi Z (compH Z Y X h k) (D.act Z Y k d) (ovK X x Z Y k h d e))) (\ k ->
    isProp-Pi (Hom Y X) (\ h -> (d : DP Y) (e : Ov X x Y h d) -> Id (W.Ix (P.tob Z (D.act Z Y k d))) (P.tact Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)) (phi Y h d e)) (phi Z (compH Z Y X h k) (D.act Z Y k d) (ovK X x Z Y k h d e))) (\ h ->
    isProp-Pi (DP Y) (\ d -> (e : Ov X x Y h d) -> Id (W.Ix (P.tob Z (D.act Z Y k d))) (P.tact Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)) (phi Y h d e)) (phi Z (compH Z Y X h k) (D.act Z Y k d) (ovK X x Z Y k h d e))) (\ d ->
    isProp-Pi (Ov X x Y h d) (\ e -> Id (W.Ix (P.tob Z (D.act Z Y k d))) (P.tact Z Y k d (D.act Z Y k d) (refl (D.act Z Y k d)) (phi Y h d e)) (phi Z (compH Z Y X h k) (D.act Z Y k d) (ovK X x Z Y k h d e))) (\ e ->
    W.isSetIx (P.tob Z (D.act Z Y k d)) _ _)))))) ;
  tobV (X : Ob) (x : GP X) : W.V = W.SigV (famV X x) (\ phi -> prV (NatF X x phi) (natF-prop X x phi)) ;
  El (X : Ob) (x : GP X) : U l = W.Ix (tobV X x) ;

  -- families with the same values are equal
  push-eq (X : Ob) (x : GP X) (u v : El X x)
    (H : (Y : Ob) (h : Hom Y X) (d : DP Y) (e : Ov X x Y h d) -> Id (W.Ix (P.tob Y d)) (u.1 Y h d e) (v.1 Y h d e))
    : Id (El X x) u v =
    Sigma-eq (Fam X x) (\ phi -> NatF X x phi) u.1 v.1 u.2 v.2
      (funext Ob (\ Y -> (h : Hom Y X) (d : DP Y) (e : Ov X x Y h d) -> W.Ix (P.tob Y d)) u.1 v.1 (\ Y ->
       funext (Hom Y X) (\ h -> (d : DP Y) (e : Ov X x Y h d) -> W.Ix (P.tob Y d)) (u.1 Y) (v.1 Y) (\ h ->
       funext (DP Y) (\ d -> (e : Ov X x Y h d) -> W.Ix (P.tob Y d)) (u.1 Y h) (v.1 Y h) (\ d ->
       funext (Ov X x Y h d) (\ e -> W.Ix (P.tob Y d)) (u.1 Y h d) (v.1 Y h d) (\ e -> H Y h d e)))))
      (natF-prop X x v.1) ;
  -- the proof of "over" is irrelevant
  ov-irr (X : Ob) (x : GP X) (phi : Fam X x) (Y : Ob) (h h' : Hom Y X) (p : Id (Hom Y X) h h') (d : DP Y) (e : Ov X x Y h d) (e' : Ov X x Y h' d)
    : Id (W.Ix (P.tob Y d)) (phi Y h d e) (phi Y h' d e') =
    idJ (Hom Y X) h (\ h2 p2 -> (e2 : Ov X x Y h2 d) -> Id (W.Ix (P.tob Y d)) (phi Y h d e) (phi Y h2 d e2))
      (\ e2 -> apH (phi Y h d) (W.isSetIx (G.ob Y) (s.nt Y d) (G.act Y X h x) e e2)) h' p e' ;

  -- restriction along k : Y -> X reindexes
  module Res (Y X : Ob) (k : Hom Y X) (x : GP X) (y : GP Y) (ey : Id (GP Y) (G.act Y X k x) y) (u : El X x) {
    eC (W : Ob) (h : Hom W Y) (d : DP W) (e : Ov Y y W h d) : Ov X x W (compH W Y X k h) d =
      transH e (transH (apH (G.act W Y h) (symH ey)) (symH (G.act-o W Y X k h x))) ;
    fam : Fam Y y = \ W h d e -> u.1 W (compH W Y X k h) d (eC W h d e) ;
    nat : NatF Y y fam = \ Z W kk h d e ->
      transH (u.2 Z W kk (compH W Y X k h) d (eC W h d e))
        (ov-irr X x u.1 Z (compH Z W X (compH W Y X k h) kk) (compH Z Y X k (compH Z W Y h kk))
           (comp-assoc Z W Y X k h kk) (D.act Z W kk d)
           (ovK X x Z W kk (compH W Y X k h) d (eC W h d e))
           (eC Z (compH Z W Y h kk) (D.act Z W kk d) (ovK Y y Z W kk h d e))) ;
    res : El Y y = (fam, nat) ;
  } ;
  tact (Y X : Ob) (k : Hom Y X) (x : GP X) (y : GP Y) (ey : Id (GP Y) (G.act Y X k x) y) (u : El X x) : El Y y =
    Res[Y, X, k, x, y, ey, u].res ;
  tid (X : Ob) (x : GP X) (e : Id (GP X) (G.act X X (idH X) x) x) (u : El X x) : Id (El X x) (tact X X (idH X) x x e u) u =
    push-eq X x (tact X X (idH X) x x e u) u (\ W h d e' ->
      ov-irr X x u.1 W (compH W X X (idH X) h) h (comp-idl W X h) d (Res[X, X, idH X, x, x, e, u].eC W h d e') e') ;
  to (Z Y X : Ob) (f : Hom Y X) (g : Hom Z Y) (x : GP X) (y : GP Y) (z : GP Z)
    (e1 : Id (GP Y) (G.act Y X f x) y) (e2 : Id (GP Z) (G.act Z Y g y) z)
    (e3 : Id (GP Z) (G.act Z X (compH Z Y X f g) x) z) (u : El X x)
    : Id (El Z z) (tact Z X (compH Z Y X f g) x z e3 u) (tact Z Y g y z e2 (tact Y X f x y e1 u)) =
    push-eq Z z (tact Z X (compH Z Y X f g) x z e3 u) (tact Z Y g y z e2 (tact Y X f x y e1 u)) (\ W h d e' ->
      ov-irr X x u.1 W (compH W Z X (compH Z Y X f g) h) (compH W Y X f (compH W Z Y g h)) (comp-assoc W Z Y X f g h) d
        (Res[Z, X, compH Z Y X f g, x, z, e3, u].eC W h d e')
        (Res[Y, X, f, x, y, e1, u].eC W (compH W Z Y g h) d (Res[Z, Y, g, y, z, e2, tact Y X f x y e1 u].eC W h d e'))) ;
  opaque tid ; opaque to ;
  pushTy : PTy[G] = mkTy G tobV tact tid to ;

  -- reading a family at a point of D: the counit (s_* P)[s] -> P
  at (X : Ob) (d : DP X) (u : El X (s.nt X d)) : W.Ix (P.tob X d) =
    u.1 X (idH X) d (symH (G.act-id X (s.nt X d))) ;
} ;
