-- CTotKL2.seg (canonicity-c2; SIMPLIFIED.md, KL from a levelwise
-- element): if U P is a proposition at the levelwise site (internally)
-- with an element there, and r : (D P)[tau] -> P, then P has a section
-- at the total site. (KL with its contraction from contrOfProp.)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module KL2 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (P : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module K = CTotKL[a, vl, l].KL[C, G, P.1] ;
 module TR = K.TR ;
 module G0 = TR.G0 ;
 module U4 = CTotUFib4[a, vl, l].UFib4[C] ;
 module PN0 = CwFPropNoU.PropNoU[l+, G0.fibCwF-T, G0.fibPi-T, G0.fibSig-T, G0.fibId-T, G0.nf-T] ;
 UG : G0.fibCwF-T.Ctx = TR.RS.rC K.GP ;
 UP : G0.fibCwF-T.Ty UG = (TR.RS.rT K.GP P.1, U4.fibU K.GP P.1 P.2) ;
 module At (rP : K.HO.NMap[K.GP, K.Bt, P.1]) (pU : G0.fibCwF-T.El UG (PN0.isProp UG UP)) (e : G0.fibCwF-T.El UG UP) {
  al : G0.GB.CPartial[l].ContrOp (TR.RS.rC K.GP) (TR.RS.rT K.GP P.1) = G0.contrOp-T UG UP (PN0.contrOfProp UG UP pU e) ;
  sec : K.P1.PEl[K.GP, P.1] = K.At[rP, al].sec ;
 } ;
} ;
