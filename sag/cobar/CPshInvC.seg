-- CPshInvC.seg (canonicity-c2; COBAR.md, Lemma 16's invariance): a
-- uniform equivalence structure is invariant under an internal
-- homotopy, in the CwF of uniformly fibrant C-types.
--
-- For X , Y fibrant over G, r , r' : Y -> X and H an element of
-- Id(r y , r' y) over G.Y (an internal homotopy: C-natural by being an
-- element), a uniform ContrOp of the homotopy fibre of al r over G.X
-- (EquivOp at each x, commuting with the C-action: Prop13U's shape)
-- gives one for al r'.  By the bridge (CPshS3C.S3a / S3b) this is the
-- invariance of Kr under homotopy, CwFKrInv.krHt.
-- Premises: those of CPshS3C.  No new axioms.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module InvCOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module FvM = CPshFvC[a, l].FvCOf[C] ;
 module S3m = CPshS3C[a, l].S3COf[C] ;
 module PCl = CPshPiFibC[a, l].PiClOf[C] ;
 module SCl = CPshSigFib[a, l].SigFibOf[C] ;
 module IJ = CPshIdJ4[a, l].IdJOf[C] ;
 module NFc = CPshNFC[a, l].NFCOf[C] ;
 module MC = CPshMapC[a, l].MapCOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module IDm = CPshId[a, l].IdOf[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 CF : CwF.CwF[l+] = UF.CFibCwF ;
 module KI = CwFKrInv.KrInv[l+, CF, PCl.FPiC.SPi, SCl.FSigC.SSig, IJ.PIdJ, NFc.nf] ;
 module PT = CwFPth.Pth[l+, CF, PCl.FPiC.SPi, SCl.FSigC.SSig, IJ.PIdJ] ;

 module Inv (G : P.CCtx) (X Y : UF.FCC.STy G) (r r' : CF.El G (FvM.OV.Fun G Y X))
  (H : CF.El (CF.ext G Y) (IJ.PIdJ.IdT (CF.ext G Y) (FvM.OV.wkT G Y X)
          (FvM.OV.bod G Y (FvM.OV.wkT G Y X) r) (FvM.OV.bod G Y (FvM.OV.wkT G Y X) r'))) {
  module Sr = S3m.S3[G, X, Y, r] ;
  module Sr' = S3m.S3[G, X, Y, r'] ;
  h : CF.El G (PCl.FPiC.SPi.Pi G Y (IJ.PIdJ.IdT (CF.ext G Y) (FvM.OV.wkT G Y X)
          (FvM.OV.bod G Y (FvM.OV.wkT G Y X) r) (FvM.OV.bod G Y (FvM.OV.wkT G Y X) r'))) =
   FvM.OV.lam G Y (IJ.PIdJ.IdT (CF.ext G Y) (FvM.OV.wkT G Y X)
          (FvM.OV.bod G Y (FvM.OV.wkT G Y X) r) (FvM.OV.bod G Y (FvM.OV.wkT G Y X) r')) H ;
  inv (ut : P.UTriv Sr.Dc Sr.F1.Fb.HPc.PC) : P.UTriv Sr.Dc Sr'.F1.Fb.HPc.PC =
   Sr'.S3b (KI.krHt G X Y r r' h (Sr.S3a ut)) ;
 } ;

 ------------------------------------------------------------------
 -- the same for maps in Prop13's sense (CMap), the homotopy being an
 -- element of Id(toEl f , toEl g) over G.Y (CPshMapC)

 module InvM (G : P.CCtx) (X Y : UF.FCC.STy G) (f g : P13.CMap[G, Y.1, X.1]) {
  module MY = MC.M[G, Y.1, X.1] ;
  Dc : P.CCtx = LO.ExtC G X.1 ;
  -- internal homotopies between elements of X[p] over G.Y
  Ht (e e' : P.CEl[MY.GY, MY.XY]) : U l+ = P.CEl[MY.GY, IDm.IdC[MY.GY, MY.XY, e, e'].IdT] ;
  -- a map as an element of the function type; its body and its map
  rOf (m : P13.CMap[G, Y.1, X.1]) : CF.El G (FvM.OV.Fun G Y X) = FvM.OV.lam G Y (FvM.OV.wkT G Y X) (MY.toEl m) ;
  bodE (m : P13.CMap[G, Y.1, X.1]) : Id (P.CEl[MY.GY, MY.XY]) (FvM.OV.bod G Y (FvM.OV.wkT G Y X) (rOf m)) (MY.toEl m) =
   (PCl.FPiC.SPi.Pi-iso G Y (FvM.OV.wkT G Y X)).fun-inv (MY.toEl m) ;
  alE (m : P13.CMap[G, Y.1, X.1]) : Id (P13.CMap[G, Y.1, X.1]) FvM.Fv[G, X, Y, rOf m].al m =
   transH (apH MY.ofEl (bodE m)) (MY.of-to m) ;
  UT (m : P13.CMap[G, Y.1, X.1]) : U l+ = P.UTriv Dc P13.HP[G, Y.1, X.1, m].PC ;

  module W (H : Ht (MY.toEl f) (MY.toEl g)) {
   H1 : Ht (FvM.OV.bod G Y (FvM.OV.wkT G Y X) (rOf f)) (MY.toEl g) =
    substH {P.CEl[MY.GY, MY.XY]} (\ e -> Ht e (MY.toEl g)) (symH (bodE f)) H ;
   H2 : Ht (FvM.OV.bod G Y (FvM.OV.wkT G Y X) (rOf f)) (FvM.OV.bod G Y (FvM.OV.wkT G Y X) (rOf g)) =
    substH {P.CEl[MY.GY, MY.XY]} (\ e -> Ht (FvM.OV.bod G Y (FvM.OV.wkT G Y X) (rOf f)) e) (symH (bodE g)) H1 ;
   module I0 = Inv[G, X, Y, rOf f, rOf g, H2] ;
   u1 (ut : UT f) : UT FvM.Fv[G, X, Y, rOf f].al = substH {P13.CMap[G, Y.1, X.1]} UT (symH (alE f)) ut ;
   u2 (ut : UT f) : UT FvM.Fv[G, X, Y, rOf g].al = I0.inv (u1 ut) ;
   inv (ut : UT f) : UT g = substH {P13.CMap[G, Y.1, X.1]} UT (alE g) (u2 ut) ;
  } ;
  inv (H : Ht (MY.toEl f) (MY.toEl g)) (ut : UT f) : UT g = W[H].inv ut ;
 } ;

 -- the zig-zag form (Lemma 16): homotopies f ~ m and g ~ m
 module Zig (G : P.CCtx) (X Y : UF.FCC.STy G) (f m g : P13.CMap[G, Y.1, X.1]) {
  module IM = InvM[G, X, Y, f, g] ;
  module MY = MC.M[G, Y.1, X.1] ;
  module W (Hq : IM.Ht (MY.toEl f) (MY.toEl m)) (Hp : IM.Ht (MY.toEl g) (MY.toEl m)) {
   Hs : IM.Ht (MY.toEl m) (MY.toEl g) = PT.symM (CF.ext G Y) (FvM.OV.wkT G Y X) (MY.toEl g) (MY.toEl m) Hp ;
   H : IM.Ht (MY.toEl f) (MY.toEl g) = PT.transM (CF.ext G Y) (FvM.OV.wkT G Y X) (MY.toEl f) (MY.toEl m) (MY.toEl g) Hq Hs ;
   inv (ut : IM.UT f) : IM.UT g = IM.inv H ut ;
  } ;
  inv (Hq : IM.Ht (MY.toEl f) (MY.toEl m)) (Hp : IM.Ht (MY.toEl g) (MY.toEl m)) (ut : IM.UT f) : IM.UT g = W[Hq, Hp].inv ut ;
 } ;
} ;
