-- CTotL16f.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, the double reading MW2, part 3, SPECIFIC TO OUR C (CCopy.ConcC:
-- constant objects, res u x = x and res-comp by refl, so DO.rCh is the
-- chain map of the restriction functor on the nose): the inner naturality
-- along stage maps and the inner element.
--   rChrCh   restricting along g' then h is restricting along g' . h
--            (rmap-o at refl transports)
--   inat     u's naturality at the concatenated index, moved along the
--            index equality (comp-assoc, chF-catA, rChrCh, Wres, resRes)
-- The generic version (any internal C) is recorded as optional (4e).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a+] ;
module VA = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, a+] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module RR (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 IC : CIntCat[a, a+].IC = CCopy[a].ConcC[R, encK, pe].CM.IC ;
 module VT = CVert[a, a+].VertOf[IC] ;
 module DO = CobarI[a, a+, a+].DOfI[IC] ;
 Obj (I : Ob) : U a+ = VT.Obj I ;
 module RC (J'' J' J : Ob) (h : Hom J'' J') (g' : Hom J' J) {
  module CF1 = CChainsF[a+].CF[VT.VCat J, VT.VCat J', VT.rfun J' J g'] ;
  module CF2 = CChainsF[a+].CF[VT.VCat J', VT.VCat J'', VT.rfun J'' J' h] ;
  module CF3 = CChainsF[a+].CF[VT.VCat J, VT.VCat J'', VT.rfun J'' J (compH J'' J' J g' h)] ;
  rChrCh : (n : Nat) -> (x z : Obj J) (c : DO.KJ[J].K.Ch n x z)
   -> Id (DO.KJ[J''].K.Ch n x z) (CF2.chF n x z (CF1.chF n x z c)) (CF3.chF n x z c) = split {
   zero -> \ x z f -> symH (VT.rmap-o J'' J' J g' h z x f) ;
   suc m | ih -> \ x z c ->
    transH (apH {DO.KJ[J''].K.Ch m c.1 z} {DO.KJ[J''].K.Ch (suc m) x z} (\ w -> (c.1, VT.rmap J'' J' h c.1 x (VT.rmap J' J g' c.1 x c.2.1), w)) (ih c.1 z c.2.2))
     (apH {VT.VMap J'' c.1 x} {DO.KJ[J''].K.Ch (suc m) x z} (\ f -> (c.1, f, CF3.chF m c.1 z c.2.2)) (symH (VT.rmap-o J'' J' J g' h c.1 x c.2.1))) } ;
 } ;
 resRes (n : Nat) (J'' J' J : Ob) (h : Hom J'' J') (g' : Hom J' J) (p : Wt.Pn n J)
  : Id (Wt.Pn n J'') (Wt.Res[n, J'', J', h, Wt.Res[n, J', J, g', p].res].res) (Wt.Res[n, J'', J, PB.compH J'' J' J g' h, p].res) =
  CTotL14f[a, a+, a+].pnEq n J'' _ _ (\ k -> PB.comp-assoc J'' J' J PFO.ivO (p.1 k) g' h) ;

 module In (G : CTPsh[a, a+, a+].TPshOf[IC].TCtx) (A : Presheaf[a+, a+].Psh[CTotCat[a, a+, a+].TotOf[IC].TotCat].PTy[CTotCat[a, a+, a+].TotOf[IC].toP G])
  (Wf : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (CTotL16b[a, a+, a+].substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : CTotL16e[a, a+, a+].L16e[IC, G, A, Wf, WfaceR].DA.TOb' I x (CTotL16e[a, a+, a+].L16e[IC, G, A, Wf, WfaceR].D.tau I x g))
  (t : Hom I PFO.ivO) (q' : CTotL16e[a, a+, a+].L16e[IC, G, A, Wf, WfaceR].DA.Idx I x) (l' : CTotL16e[a, a+, a+].L16e[IC, G, A, Wf, WfaceR].DA.LandsI I x q') {
  module LE = CTotL16e[a, a+, a+].L16e[IC, G, A, Wf, WfaceR] ;
  module LD = LE.LD ;
  module DA = LE.DA ;
  module D = LE.D ;
  module OFm = LE.OF[I, x, g, u, t, q', l'] ;
  module RDm = OFm.R ;
  E : LE.LB.P.PCtx = LE.E ;
  module NA (r : VA.Ix (D.natIdxV q'.2.1 q'.2.2.2.1)) (li : DA.LandsI q'.2.1 q'.2.2.2.1 r.1) {
   module Iq = LD.Inner[I, x, g, u, t, q', l', r.1, li] ;
   module Ih = LD.Inner[I, x, g, u, t, q', l',
     (r.1.1, r.2.1, compH r.2.1 r.1.2.1 q'.2.1 r.1.2.2.1 r.2.2, r.1.2.2.2.1, DO.rCh r.2.1 r.1.2.1 q'.2.1 r.2.2 r.1.2.2.1 q'.2.2.2.1 r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1,
      (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res).1),
     (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res).2] ;
   module RCm = RC[r.2.1, r.1.2.1, q'.2.1, r.2.2, r.1.2.2.1] ;
   module CFA = CTotL16c[a, a+, a+].CFA[IC, r.1.2.1, r.2.1, VT.rfun r.2.1 r.1.2.1 r.2.2] ;
   m : Nat = q'.1 ;
   n : Nat = r.1.1 ;
   N : Nat = Ar.plus q'.1 (suc r.1.1) ;
   J'' : Ob = r.2.1 ;
   z : Obj r.1.2.1 = r.1.2.2.2.1 ;
   kk : Hom r.2.1 I = compH r.2.1 q'.2.1 I q'.2.2.1 (compH r.2.1 r.1.2.1 q'.2.1 r.1.2.2.1 r.2.2) ;
   ch0 : DO.KJ[r.2.1].K.Ch (Ar.plus q'.1 (suc r.1.1)) x r.1.2.2.2.1 = DO.rCh r.2.1 r.1.2.1 I r.2.2 Iq.gg x (Ar.plus q'.1 (suc r.1.1)) r.1.2.2.2.1 Iq.cc ;
   chE : Id (DO.KJ[r.2.1].K.Ch (Ar.plus q'.1 (suc r.1.1)) x r.1.2.2.2.1) ch0 Ih.cc =
    transH (CFA.chF-catA q'.1 r.1.1 x q'.2.2.2.1 r.1.2.2.2.1 Iq.c2 r.1.2.2.2.2.1)
     (apH {DO.KJ[r.2.1].K.Ch q'.1 x q'.2.2.2.1} {DO.KJ[r.2.1].K.Ch (Ar.plus q'.1 (suc r.1.1)) x r.1.2.2.2.1}
        (\ c2 -> CTotL16c[a, a+, a+].CA[IC, r.2.1].catA q'.1 r.1.1 x q'.2.2.2.1 r.1.2.2.2.1 c2 (CFA.CF.chF r.1.1 q'.2.2.2.1 r.1.2.2.2.1 r.1.2.2.2.2.1))
        (RCm.rChrCh q'.1 x q'.2.2.2.1 q'.2.2.2.2.1)) ;
   w0 : Wt.Pn (Ar.plus q'.1 (suc r.1.1)) r.2.1 = Wt.Res[Ar.plus q'.1 (suc r.1.1), r.2.1, r.1.2.1, r.2.2, Iq.w].res ;
   wE : Id (Wt.Pn (Ar.plus q'.1 (suc r.1.1)) r.2.1) w0 Ih.w =
    transH (Wres q'.1 r.1.1 r.2.1 r.1.2.1 r.2.2 (PB.compH r.1.2.1 I PFO.ivO t Iq.gg) Iq.jr Iq.iP)
    (transH (apH {Hom r.2.1 PFO.ivO} {Wt.Pn (Ar.plus q'.1 (suc r.1.1)) r.2.1}
               (\ t' -> Wf q'.1 r.1.1 r.2.1 t' (Wt.Res[q'.1, r.2.1, r.1.2.1, r.2.2, Iq.jr].res) (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, Iq.iP].res))
               (PB.comp-assoc r.2.1 r.1.2.1 I PFO.ivO t Iq.gg r.2.2))
    (transH (apH {Hom r.2.1 I} {Wt.Pn (Ar.plus q'.1 (suc r.1.1)) r.2.1}
               (\ k -> Wf q'.1 r.1.1 r.2.1 (PB.compH r.2.1 I PFO.ivO t k) (Wt.Res[q'.1, r.2.1, r.1.2.1, r.2.2, Iq.jr].res) (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, Iq.iP].res))
               (PB.comp-assoc r.2.1 r.1.2.1 q'.2.1 I q'.2.2.1 r.1.2.2.1 r.2.2))
      (apH {Wt.Pn q'.1 r.2.1} {Wt.Pn (Ar.plus q'.1 (suc r.1.1)) r.2.1}
         (\ jj -> Wf q'.1 r.1.1 r.2.1 (PB.compH r.2.1 I PFO.ivO t kk) jj (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, Iq.iP].res))
         (resRes q'.1 r.2.1 r.1.2.1 q'.2.1 r.2.2 r.1.2.2.1 (q'.2.2.2.2.2, l'))))) ;
   eq : Id (DA.Ez r.2.1 r.1.2.2.2.1) (DA.anatL q'.2.1 q'.2.2.2.1 OFm.tgy OFm.iv r li) (DA.anatR q'.2.1 q'.2.2.2.1 OFm.tgy OFm.iv r li) =
    transH (apH {DA.Ez r.1.2.1 r.1.2.2.2.1} {DA.Ez r.2.1 r.1.2.2.2.1} (E.act (r.2.1, r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, IC.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) Iq.pc)
    (transH (u.2.1 (Iq.idx, (r.2.1, r.2.2)) Iq.ldx)
    (transH (apH {Hom r.2.1 I} {DA.Ez r.2.1 r.1.2.2.2.1} (\ k -> RDm.rd (Ar.plus q'.1 (suc r.1.1)) r.2.1 k r.1.2.2.2.1 ch0 w0) (PB.comp-assoc r.2.1 r.1.2.1 q'.2.1 I q'.2.2.1 r.1.2.2.1 r.2.2))
    (transH (apH {DO.KJ[r.2.1].K.Ch (Ar.plus q'.1 (suc r.1.1)) x r.1.2.2.2.1} {DA.Ez r.2.1 r.1.2.2.2.1} (\ ch -> RDm.rd (Ar.plus q'.1 (suc r.1.1)) r.2.1 kk r.1.2.2.2.1 ch w0) chE)
    (transH (apH {Wt.Pn (Ar.plus q'.1 (suc r.1.1)) r.2.1} {DA.Ez r.2.1 r.1.2.2.2.1} (\ ww -> RDm.rd (Ar.plus q'.1 (suc r.1.1)) r.2.1 kk r.1.2.2.2.1 Ih.cc ww) wE)
      (symH Ih.pc))))) ;
  } ;
  inat : W0.Ix (DA.anatEq q'.2.1 q'.2.2.2.1 OFm.tgy OFm.iv) = \ r li -> NA[r, li].eq ;
  ires : DA.TOb' q'.2.1 q'.2.2.2.1 OFm.tgy = (OFm.iv, (inat, (OFm.iface, OFm.itop))) ;
 } ;
} ;
