-- CCmpK28.seg (canonicity-c2; (K) for cmpI, part 28): over Cb (stage 1),
-- h1 read as ev g_1 = q1, the composite cls t1 = ev g_1, and the element of
-- S[ev g_1].
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module K28 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K27m = CCmpK27[a].K27[R, encK, pe, y] ;
 module K26m = K27m.K26m ;
 module K19m = K27m.K19m ;
 module MH = K27m.MH ;
 Nl : C.Ctx = C.nil ;
 Q : C.Ty Nl = K19m.Q ;
 HTT : C.Ty Nl = K19m.HTT ;
 Cb : C.Ctx = K27m.K26m.Cb ;
 s0b : C.Sub Cb Nl = K27m.K26m.s0b ;
 QB : C.Ty Cb = K27m.QB ;
 G1 : C.Ctx = K19m.G1 ;
 C1 : C.Ctx = K19m.C1 ;
 ev1 : C.El Cb QB = CInjP[a].IP[HTT, Q, K19m.K3m.m1].evS Cb s0b K27m.K26m.gEl ;
 gr (K : Ob) (x : V1.Ix (C1.ob K)) : Id (V1.Ix (HTT.1.tob K x.1.1)) (K19m.gC1.eob K x) x.2 = refl x.2 ;
 ha (K : Ob) (w : V1.Ix (Cb.ob K)) : Id (V1.Ix (QB.1.tob K w)) ((MH.el K27m.K26m.K25m.ev1C1).eob K w) (ev1.eob K w) =
  transH (CAppRd[a].trE-rd Cb (C.subT Cb C1 K19m.QC1 K27m.piH) QB MH.P (C.subt Cb C1 K19m.QC1 K27m.K26m.K25m.ev1C1 K27m.piH) K w)
   (transH (CAppRd[a].same-rd Cb (C.subT Cb C1 K19m.QC1 K27m.piH) QB MH.P K w (refl (QB.1.tob K w)) (K27m.K26m.K25m.ev1C1.eob K (K27m.piH.nt K w)))
     (apH {V1.Ix (HTT.1.tob K (s0b.nt K w))} {V1.Ix (QB.1.tob K w)} (K19m.K3m.m1.nfun K (s0b.nt K w)) (gr K (K27m.piH.nt K w)))) ;
 hb (K : Ob) (w : V1.Ix (Cb.ob K)) : Id (V1.Ix (QB.1.tob K w)) ((MH.el K19m.q2C1).eob K w) (K27m.K26m.qEl.eob K w) =
  transH (CAppRd[a].trE-rd Cb (C.subT Cb C1 K19m.QC1 K27m.piH) QB MH.P (C.subt Cb C1 K19m.QC1 K19m.q2C1 K27m.piH) K w)
   (transH (CAppRd[a].same-rd Cb (C.subT Cb C1 K19m.QC1 K27m.piH) QB MH.P K w (refl (QB.1.tob K w)) (K19m.q2C1.eob K (K27m.piH.nt K w)))
     (refl (K27m.K26m.qEl.eob K w))) ;
 hId : C.El Cb (IJ.IdT Cb QB ev1 K27m.K26m.qEl) = CCmpU14[a].rwId Cb QB (MH.el K27m.K26m.K25m.ev1C1) ev1 (MH.el K19m.q2C1) K27m.K26m.qEl ha hb K27m.h0 ;
 e2' : C.El Cb (IJ.IdT Cb QB K27m.clsT ev1) =
  PT.transM Cb QB K27m.clsT K27m.K26m.qEl ev1 K27m.e2b (PT.symM Cb QB ev1 K27m.K26m.qEl hId) ;
 module SA = K27m.SEm.At[Cb, s0b, K27m.K26m.tEl, ev1, e2'] ;
 s2 : C.El Cb (C.subT Cb K19m.QS.G1 K19m.QS.S SA.sg) = SA.sp ;
} ;
