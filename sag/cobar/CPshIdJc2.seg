-- CPshIdJc2.seg (part 3b: the base's upS as the same transport; upSEqC) (part 3 of the Id instance, canonicity-45): the map of
-- motive contexts upS of the record (SwanId.Der.upS, a transport of the
-- lift along IKnat) at x is the base's (FibIdCen.DR.upS): both are the
-- base's lift with the second component coerced along one path of codes
-- (FibIdRd.subTr on both sides with the same path), after the transport
-- of a C-substitution along a path of C-types is read at x (subTrC).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module FBC = FibCwF[a, l] ;
module FIC = FibIdCen[a, l] ;
module RD = FibIdRd[a, l] ;

module IdJc2Of (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 module JC = CPshIdJc[a, l].IdJcOf[C] ;
 open P ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;
 module DRC = JA.DRC ;
 module DRB = JA.DRB ;
 As (G : CCtx) (A : STy G) (x : CO) : FBC.FC.STy (G.ob x) = JA.As G A x ;

 module UpE2 (D G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (s : CSub[D, G]) (x : CO) {
  module Ue = JC.UpE[D, G, A, a0, s, x] ;
  -- the base's upS, as a transport over PTy
  PBx : Id (PTy[Ue.Ex]) Ue.IKlB.1 Ue.IKdB.1 = apH (\ Z -> Z.1) (DRB.IKnat Ue.Dx' Ue.Gx Ue.Ax Ue.ax Ue.sx) ;
  upB : Id (PSub[extP Ue.Ex Ue.IKdB.1, Ue.Zx]) (DRB.upS Ue.Dx' Ue.Gx Ue.Ax Ue.ax Ue.sx)
         (subst (PTy[Ue.Ex]) (\ T -> PSub[extP Ue.Ex T, Ue.Zx]) Ue.IKlB.1 Ue.IKdB.1 PBx Ue.lB) =
   subst-ap (FBC.FC.STy Ue.Ex) (PTy[Ue.Ex]) (\ Z -> Z.1) (\ T -> PSub[extP Ue.Ex T, Ue.Zx]) Ue.IKlB Ue.IKdB (DRB.IKnat Ue.Dx' Ue.Gx Ue.Ax Ue.ax Ue.sx) Ue.lB ;
  opaque upB ;
  -- one path of codes at a point
  cdB (I : Ob) (w : W0.Ix ((extP Ue.Ex Ue.IKdB.1).ob I)) : Id W0.V (Ue.IKdB.1.tob I (fstE Ue.Ex Ue.IKdB.1 I w)) (Ue.IKlB.1.tob I (fstE Ue.Ex Ue.IKdB.1 I w)) =
   apH (\ T -> T.tob I (fstE Ue.Ex Ue.IKdB.1 I w)) (symH PBx) ;
  mid (I : Ob) (w : W0.Ix ((extP Ue.Ex Ue.IKdB.1).ob I)) : W0.Ix (Ue.Zx.ob I) =
   Ue.lB.nt I (pairE Ue.Ex Ue.IKlB.1 I (fstE Ue.Ex Ue.IKdB.1 I w)
                (subst W0.V (\ v -> W0.Ix v) (Ue.IKdB.1.tob I (fstE Ue.Ex Ue.IKdB.1 I w)) (Ue.IKlB.1.tob I (fstE Ue.Ex Ue.IKdB.1 I w)) (cdB I w) (sndE Ue.Ex Ue.IKdB.1 I w))) ;
  -- both are the lift at the coerced second component (subTr with the same path of codes)
  ptC (I : Ob) (w : W0.Ix ((extP Ue.Ex Ue.IKdB.1).ob I)) : Id (W0.Ix (Ue.Zx.ob I)) (Ue.upCY.nt I w) (mid I w) =
   transH (apH (\ t -> t.nt I w) Ue.upC')
    (RD.subTr Ue.Ex Ue.Zx (PTy[Ue.Ex]) (\ T -> T) Ue.IKlB.1 Ue.IKdB.1 Ue.PCxB Ue.lCB I w (cdB I w)) ;
  opaque ptC ;
  ptB (I : Ob) (w : W0.Ix ((extP Ue.Ex Ue.IKdB.1).ob I)) : Id (W0.Ix (Ue.Zx.ob I)) ((DRB.upS Ue.Dx' Ue.Gx Ue.Ax Ue.ax Ue.sx).nt I w) (mid I w) =
   transH (apH (\ t -> t.nt I w) upB)
    (RD.subTr Ue.Ex Ue.Zx (PTy[Ue.Ex]) (\ T -> T) Ue.IKlB.1 Ue.IKdB.1 PBx Ue.lB I w (cdB I w)) ;
  opaque ptB ;
  eq : Id (PSub[extP Ue.Ex Ue.IKdB.1, Ue.Zx]) Ue.upCY (DRB.upS Ue.Dx' Ue.Gx Ue.Ax Ue.ax Ue.sx) =
   sub-ext (extP Ue.Ex Ue.IKdB.1) Ue.Zx Ue.upCY (DRB.upS Ue.Dx' Ue.Gx Ue.Ax Ue.ax Ue.sx)
    (\ I w -> transH (ptC I w) (symH (ptB I w))) ;
  opaque eq ;
 } ;
 upSEqC (D G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (s : CSub[D, G]) (x : CO)
  : Id (PSub[(DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x, DRB.Dx (G.ob x) (As G A x) (a0.el x)])
      ((DRC.upS D G A a0 s).sb x) (DRB.upS (D.ob x) (G.ob x) (As G A x) (a0.el x) (s.sb x)) = UpE2[D, G, A, a0, s, x].eq ;
} ;
