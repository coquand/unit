-- F3 as the free one-generator extension of F2, using the relative
-- comparison's already checked uniqueness half.
level a ;
open Base ;
open Prelude[a] ;
open Paths[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module OneMore (R : Ring[a].CRing) {
  module F = CFree3Assoc[a].Free3[R] ;
  u1 : SX.Rel[R].RelPres F.F.F2 = (suc zero, nil) ;
  F3eq : Id SX.Over[R].Presentation (SX.Rel[R].concat F.F.F2 u1) F.F3 = refl F.F3 ;
} ;

module Compare (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (y : SX.Over[R].Presentation) {
  module E = OneMore[R] ;
  module M = CDFwD4[a].Move[R, encK, pe, E.F.F.F2, E.u1, y] ;
  -- This is the only missing input to the already checked relative
  -- equivalence: mere inhabitation of each fibre of the comparison.
  MereSurj : U a++ = M.D.MereSurj ;
  module IfSurj (ms : MereSurj) {
    Kd : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil
      (CwFQP.QP[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf].Kr
        FibCwF[a, a+].fibCwF.nil M.D.F.T0 M.D.F.HU M.D.F.fwd) = M.Conditional[ms].Kd ;
  } ;
} ;
