-- CRho1.seg (canonicity-45; COBAR.md "Prop 58"): the levelwise
-- equivalence ef of rho : yo(y.u) -> yo(y).A (Lemma 59's hypothesis), from
-- per-copy data.  At each copy y' the restricted map fy of rho is between
-- fibrant types (CCopy9, CL59g); given a type T at the copy, an equivalence
-- cE : U(yo(y).A)|_{y'} -> T and an equivalence h : U(yo(y.u))|_{y'} -> T
-- with cE . fy = h pointwise, fy is an equivalence (CEqCancel); the copies
-- assemble (CCopy3.eqG0).  T, cE, h and their structures are module
-- parameters (the comparison Sp(u) vs Sol gives cE, c2's (d)(1)-(3) give h).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module LR = CLocBoundRetr[a, a+] ;
module FC = FibCwF[a, a+].FC ;
module HO = PB.CHtpyOps[a+] ;
module CE = PB.CEquiv[a+] ;

module RhoC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module DRr = CL59b[a].DR[R, encK, pe] ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w)) {
  E : TR.P1.PCtx = TR.P1.extP LA.PYy A.1 ;
  rhoT : CM.TP.TSub[LA.Yu, CT.TC.ofP E] =
   new CM.TP.TSub[LA.Yu, CT.TC.ofP E, \ I x d -> rho.nt (I, x) d, \ J I uu yy x f d -> rho.nt-nat (J, yy) (I, x) (uu, f) d] ;
  module RM = DRr.Map[LA.Yu, CT.TC.ofP E, rhoT] ;
  module EQ = CCopy3[a].EqC[R, encK, pe, RM.PD.UG, RM.PD.UA, RM.PD.UB, RM.PD.Uf] ;
  module YU = CCopy9[a].YoFF[R, encK, pe, LA.yu] ;
  module EFy = CL59g[a].EF[R, encK, pe, y, A] ;
  module Cp (y' : SX.Over[R].Presentation) {
   module Yy = EQ.Y[y'] ;
   D : L.PCtx = Yy.Gy ;
   fbB : PB.CLine[a+].Lines[D, Yy.By].Fib = YU.Cp[y'].fib ;
   fbA : PB.CLine[a+].Lines[D, Yy.Ay].Fib = EFy.Cp[y'].fib ;
   Bs : FC.STy D = (Yy.By, fbB) ;
   As : FC.STy D = (Yy.Ay, fbA) ;
   module PNf = EqQinv[a, a+].PN[D, Yy.By, Yy.Ay, Yy.fy] ;
   fN : HO.NMap[D, Yy.By, Yy.Ay] = PNf.nm ;
   module TB = PB.GPre[a+].TyL[D, Yy.By] ;
   module Move (T : FC.STy D) (cE : HO.NMap[D, Yy.Ay, T.1]) (ecE : CE.EquivOp D Yy.Ay T.1 LR.Map[D, Yy.Ay, T.1, cE].pmap)
     (h : HO.NMap[D, Yy.By, T.1]) (eh : CE.EquivOp D Yy.By T.1 LR.Map[D, Yy.By, T.1, h].pmap)
     (commH : (I : Ob) (x : V1.Ix (D.ob I)) (b : V1.Ix (Yy.By.tob I x)) -> Id (V1.Ix (T.1.tob I x)) (cE.nfun I x (fN.nfun I x b)) (h.nfun I x b)) {
    module TT = PB.GPre[a+].TyL[D, T.1] ;
    gf : HO.NMap[D, Yy.By, T.1] = HO.compN D Yy.By Yy.Ay T.1 fN cE ;
    module R1 = CEqCancel[a, a+].RetEq[D, Yy.By, T.1, LR.Map[D, Yy.By, T.1, h].pmap, LR.Map[D, Yy.By, T.1, gf].pmap, eh,
      \ W w -> apH {V1.Ix (T.1.tob W (TB.pr1 W w))} {TT.EI W} (TT.pr W (TB.pr1 W w)) (symH (commH W (TB.pr1 W w) (TB.pr2 W w)))] ;
    module CN = CEqCancel[a, a+].Cancel[D, Bs, As, T, fN, cE, ecE, R1.res] ;
    module R2 = CEqCancel[a, a+].RetEq[D, Yy.By, Yy.Ay, LR.Map[D, Yy.By, Yy.Ay, fN].pmap, Yy.fy, CN.eqf,
      \ W w -> PNf.q W (TB.pr1 W w) (TB.pr2 W w)] ;
    eqy : CE.EquivOp D Yy.By Yy.Ay Yy.fy = R2.res ;
   } ;
  } ;
  -- the levelwise equivalence, from the per-copy data
  module Fin (T : (y' : SX.Over[R].Presentation) -> FC.STy Cp[y'].D)
    (cE : (y' : SX.Over[R].Presentation) -> HO.NMap[Cp[y'].D, Cp[y'].Yy.Ay, (T y').1])
    (ecE : (y' : SX.Over[R].Presentation) -> CE.EquivOp Cp[y'].D Cp[y'].Yy.Ay (T y').1 LR.Map[Cp[y'].D, Cp[y'].Yy.Ay, (T y').1, cE y'].pmap)
    (h : (y' : SX.Over[R].Presentation) -> HO.NMap[Cp[y'].D, Cp[y'].Yy.By, (T y').1])
    (eh : (y' : SX.Over[R].Presentation) -> CE.EquivOp Cp[y'].D Cp[y'].Yy.By (T y').1 LR.Map[Cp[y'].D, Cp[y'].Yy.By, (T y').1, h y'].pmap)
    (commH : (y' : SX.Over[R].Presentation) (I : Ob) (x : V1.Ix (Cp[y'].D.ob I)) (b : V1.Ix (Cp[y'].Yy.By.tob I x))
       -> Id (V1.Ix ((T y').1.tob I x)) ((cE y').nfun I x (Cp[y'].fN.nfun I x b)) ((h y').nfun I x b)) {
   ef : TR.G0.GB.CEquiv[a+].EquivOp RM.PD.UG RM.PD.UA RM.PD.UB RM.PD.Uf =
    EQ.eqG0 (\ y' -> Cp[y'].Move[T y', cE y', ecE y', h y', eh y', commH y'].eqy) ;
  } ;
 } ;
} ;
