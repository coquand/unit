-- CRhoSig.seg (canonicity-45; COBAR.md "Prop 58"): the Sigma-collapse of rho's
-- telescope map: an element of Sp(u) over yo(y.u) (Sig-nat, Sig-iso, pairing
-- one factor at a time), moved to PYu, and rho : yo(y.u) -> yo(y).A with
-- rho1 (its first component is yo(p_u)).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RS (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module T3 = CRhoTel3[a].RT3[R, encK, pe, y, u] ;
 module T = T3.T ;
 module SO = T.SO ;
 module EG = T.EG ;
 C : CwF.CwF[a++] = T.C ;
 SS : CwF.Formers[a++, C].SigStr = T.G1.fibSig-T ;
 K : C.Ctx = T.K ;
 -- one factor: pair along a map into an extension built as (lift s) . (sec a)
 Col1 (E : C.Ctx) (A : C.Ty E) (B : C.Ty (C.ext E A)) (s : C.Sub K E) (a0 : C.El K (C.subT K E A s))
   (b : C.El K (C.subT K (C.ext E A) B (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0))))
   : C.El K (C.subT K E (SS.Sig E A B) s) =
  T.OVG.trE K (SS.Sig K (C.subT K E A s) (C.subT (C.ext K (C.subT K E A s)) (C.ext E A) B (C.lift K E A s))) (C.subT K E (SS.Sig E A B) s)
   (symH (SS.Sig-nat K E A B s))
   ((SS.Sig-iso K (C.subT K E A s) (C.subT (C.ext K (C.subT K E A s)) (C.ext E A) B (C.lift K E A s))).inv
     (a0, T.OVG.trE K (C.subT K (C.ext E A) B (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0)))
            (C.subT K (C.ext K (C.subT K E A s)) (C.subT (C.ext K (C.subT K E A s)) (C.ext E A) B (C.lift K E A s)) (C.sec K (C.subT K E A s) a0))
            (C.subT-o K (C.ext K (C.subT K E A s)) (C.ext E A) B (C.lift K E A s) (C.sec K (C.subT K E A s) a0)) b)) ;
 -- the equations' part: along the telescope map, onto the point map
 MM (L : SX.Over[R].Equations (SX.Fin T.yu.1)) : U a = (p : T.TmU) -> T3.D.Member p L -> T3.D.Member p T.yu.2 ;
 ColH : (L : SX.Over[R].Equations (SX.Fin T.yu.1)) (mm : MM L) (B : C.Ty (SO.HS (T3.rnL L)).1) (b : C.El K (C.subT K (SO.HS (T3.rnL L)).1 B (T3.St L mm).1))
   -> C.El K (C.subT K SO.Xc (CSpA[a].SA[R, encK, pe, y.1, u.1].SigH (T3.rnL L) B) T3.sg0) = split {
  nil -> \ mm B b -> b ;
  cons q L' | r -> \ mm B b ->
   r (\ p m -> mm p (inr m))
     (SS.Sig (SO.HS (T3.rnL L')).1 T3.Ext[q, L', (T3.St L' (\ p m -> mm p (inr m))).1, (T3.St L' (\ p m -> mm p (inr m))).2, mm q (inl (refl q))].Cm.EqTy B)
     (Col1 (SO.HS (T3.rnL L')).1 T3.Ext[q, L', (T3.St L' (\ p m -> mm p (inr m))).1, (T3.St L' (\ p m -> mm p (inr m))).2, mm q (inl (refl q))].Cm.EqTy B
        (T3.St L' (\ p m -> mm p (inr m))).1 T3.Ext[q, L', (T3.St L' (\ p m -> mm p (inr m))).1, (T3.St L' (\ p m -> mm p (inr m))).2, mm q (inl (refl q))].Cm.hq b) } ;
 -- one factor along any map s into an extension (eta for substitutions)
 module C1' (E : C.Ctx) (A : C.Ty E) (B : C.Ty (C.ext E A)) (s : C.Sub K (C.ext E A)) (b : C.El K (C.subT K (C.ext E A) B s)) {
  ps : C.Sub K E = C.o K (C.ext E A) E (C.p E A) s ;
  PA : Id (C.Ty K) (C.subT K (C.ext E A) (C.subT (C.ext E A) E A (C.p E A)) s) (C.subT K E A ps) = symH (C.subT-o K (C.ext E A) E A (C.p E A) s) ;
  qs : C.El K (C.subT K (C.ext E A) (C.subT (C.ext E A) E A (C.p E A)) s) = C.subt K (C.ext E A) (C.subT (C.ext E A) E A (C.p E A)) (C.q E A) s ;
  a0 : C.El K (C.subT K E A ps) = T.OVG.trE K (C.subT K (C.ext E A) (C.subT (C.ext E A) E A (C.p E A)) s) (C.subT K E A ps) PA qs ;
  a0rd (X : EG.Ob) (z : V1.Ix (K.ob X)) : Id (V1.Ix ((C.subT K E A ps).1.tob X z)) (a0.eob X z) (qs.eob X z) =
   transH (T.trERd K (C.subT K (C.ext E A) (C.subT (C.ext E A) E A (C.p E A)) s) (C.subT K E A ps) PA qs X z)
    (T.sameRd K (C.subT K (C.ext E A) (C.subT (C.ext E A) E A (C.p E A)) s) (C.subT K E A ps) PA X z (refl ((C.subT K E A ps).1.tob X z)) (qs.eob X z)) ;
  ls : C.Sub K (C.ext E A) = C.o K (C.ext K (C.subT K E A ps)) (C.ext E A) (C.lift K E A ps) (C.sec K (C.subT K E A ps) a0) ;
  eta : Id (C.Sub K (C.ext E A)) ls s =
   T.G1.GB.GPre[a+].PS.sub-ext K (C.ext E A) ls s (\ X z ->
    apH {V1.Ix ((C.subT K E A ps).1.tob X z)} {V1.Ix ((C.ext E A).ob X)} (\ v -> ((s.nt X z).1, v)) (a0rd X z)) ;
  b' : C.El K (C.subT K (C.ext E A) B ls) = subst (C.Sub K (C.ext E A)) (\ t -> C.El K (C.subT K (C.ext E A) B t)) s ls (symH eta) b ;
  res : C.El K (C.subT K E (SS.Sig E A B) ps) = Col1 E A B ps a0 b' ;
 } ;
 -- the points' part
 module SA = CSpA[a].SA[R, encK, pe, y.1, u.1] ;
 Ex (j : Nat) : C.Ctx = SO.PW.Ext SO.Pr j ;
 dropS : (j : Nat) -> C.Sub K (Ex j) -> C.Sub K SO.Pr = split {
  zero -> \ s0 -> s0 ;
  suc j | r -> \ s0 -> r (C.o K (Ex (suc j)) (Ex j) (C.p (Ex j) (SO.PW.Gat (Ex j))) s0) } ;
 ColX : (j : Nat) (B : C.Ty (Ex j)) (s0 : C.Sub K (Ex j)) (b : C.El K (C.subT K (Ex j) B s0)) -> C.El K (C.subT K SO.Pr (SA.SigX j B) (dropS j s0)) = split {
  zero -> \ B s0 b -> b ;
  suc j | r -> \ B s0 b -> r (SS.Sig (Ex j) (SO.PW.Gat (Ex j)) B) (C.o K (Ex (suc j)) (Ex j) (C.p (Ex j) (SO.PW.Gat (Ex j))) s0)
     (C1'[Ex j, SO.PW.Gat (Ex j), B, s0, b].res) } ;
 -- the whole: an element of Sp(u) over yo(y.u) (as K)
 qs : SX.Over[R].Equations SO.TW.Var = T3.rnL u.2 ;
 mm0 : MM u.2 = T3.memR (SX.mapL (SX.Over[R].Expr (SX.Fin y.1)) (SX.Over[R].Expr (SX.Fin T.yu.1)) (SX.Rel[R].rename (SX.Fin y.1) (SX.Fin T.yu.1) (SX.emb y.1 u.1)) y.2) ;
 sF : C.Sub K (SO.HS qs).1 = (T3.St u.2 mm0).1 ;
 utEl : C.El K (C.subT K (SO.HS qs).1 (SA.Ut (SO.HS qs).1) sF) =
  T.G1.GB.GPre[a+].PS.mkPEl K (C.subT K (SO.HS qs).1 (SA.Ut (SO.HS qs).1) sF).1 (\ X z -> tt) (\ J I f z z' e -> refl tt) ;
 hEl : C.El K (C.subT K SO.Xc (SA.SigH qs (SA.Ut (SO.HS qs).1)) T3.sg0) = ColH u.2 mm0 (SA.Ut (SO.HS qs).1) utEl ;
 xEl : C.El K (C.subT K SO.Pr (SA.Sp qs) (dropS u.1 T3.sg0)) = ColX u.1 (SA.SigH qs (SA.Ut (SO.HS qs).1)) T3.sg0 hEl ;
 -- to PYu, and rho
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module PS = T.G1.GB.GPre[a+].PS ;
 iN (X : EG.Ob) (c : V1.Ix (LA.PYu.ob X)) : V1.Ix (K.ob X) = (tt, c) ;
 iota : C.Sub LA.PYu K = new PS.PSub[LA.PYu, K, iN, \ J I f c ->
   apH {Top} {V1.Ix (K.ob J)} (\ o -> (o, LA.PYu.act J I f c)) (isTop tt (T.RP.RI.Tu.P1.act J I f tt))] ;
 dropSnt : (j : Nat) (s0 : C.Sub K (Ex j)) (X : EG.Ob) (z : V1.Ix (K.ob X)) -> Id (V1.Ix (SO.Pr.ob X)) ((dropS j s0).nt X z) (SO.TW.dropN j X (s0.nt X z)) = split {
  zero -> \ s0 X z -> refl (s0.nt X z) ;
  suc j | r -> \ s0 X z -> r (C.o K (Ex (suc j)) (Ex j) (C.p (Ex j) (SO.PW.Gat (Ex j))) s0) X z } ;
 subEq : Id (C.Sub LA.PYu SO.Pr) (C.o LA.PYu K SO.Pr (dropS u.1 T3.sg0) iota) (C.o LA.PYu LA.PYy SO.Pr T.RP.AYm.G.gY LA.PyoPu) =
  PS.sub-ext LA.PYu SO.Pr (C.o LA.PYu K SO.Pr (dropS u.1 T3.sg0) iota) (C.o LA.PYu LA.PYy SO.Pr T.RP.AYm.G.gY LA.PyoPu) (\ X c ->
   transH (dropSnt u.1 T3.sg0 X (iN X c)) (T.RP.dropE X (T.RP.base X c) u.1 (T.RP.nv X c))) ;
 A : C.Ty LA.PYy = T.RP.AYm.A ;
 AP : C.Ty LA.PYu = C.subT LA.PYu LA.PYy A LA.PyoPu ;
 e1 : C.El LA.PYu (C.subT LA.PYu K (C.subT K SO.Pr (SA.Sp qs) (dropS u.1 T3.sg0)) iota) = C.subt LA.PYu K (C.subT K SO.Pr (SA.Sp qs) (dropS u.1 T3.sg0)) xEl iota ;
 PT : Id (C.Ty LA.PYu) (C.subT LA.PYu K (C.subT K SO.Pr (SA.Sp qs) (dropS u.1 T3.sg0)) iota) AP =
  transH (symH (C.subT-o LA.PYu K SO.Pr (SA.Sp qs) (dropS u.1 T3.sg0) iota))
   (transH (apH {C.Sub LA.PYu SO.Pr} {C.Ty LA.PYu} (\ t -> C.subT LA.PYu SO.Pr (SA.Sp qs) t) subEq)
     (C.subT-o LA.PYu LA.PYy SO.Pr (SA.Sp qs) T.RP.AYm.G.gY LA.PyoPu)) ;
 aEl : C.El LA.PYu AP = T.OVG.trE LA.PYu (C.subT LA.PYu K (C.subT K SO.Pr (SA.Sp qs) (dropS u.1 T3.sg0)) iota) AP PT e1 ;
 -- rho : yo(y.u) -> yo(y).A, and rho1
 rho : C.Sub LA.PYu (C.ext LA.PYy A) = C.o LA.PYu (C.ext LA.PYu AP) (C.ext LA.PYy A) (C.lift LA.PYu LA.PYy A LA.PyoPu) (C.sec LA.PYu AP aEl) ;
 rho1 (X : EG.Ob) (w : V1.Ix (LA.PYu.ob X)) : Id (V1.Ix (LA.PYy.ob X)) (LA.TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w) = refl (LA.PyoPu.nt X w) ;
 -- Prop 58's data, instantiated
 module RD = CRho1[a].RhoC[R, encK, pe, y, u].Data[A, rho, rho1] ;
 fNy (y' : SX.Over[R].Presentation) : PB.CHtpyOps[a+].NMap[RD.Cp[y'].D, RD.Cp[y'].Yy.By, RD.Cp[y'].Yy.Ay] = RD.Cp[y'].fN ;
} ;
