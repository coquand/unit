-- CTotLvl4.seg (canonicity-c2; SIMPLIFIED.md step 4): the levelwise input
-- of the fibration half of Lemma 12, part 4: al, the levelwise filler of
-- U A (from its fibration structure) moved by CMove.Mv to a contraction
-- of U of the strict fibre at the total site.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module Lvl4 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (d : Bool) {
 module L3 = CTotLvl3[a, vl, l].Lvl3[C, G, A, d] ;
 module TR = L3.TR ;
 module L2 = L3.L2 ;
 module L1 = L3.L1 ;
 module G0 = TR.G0 ;
 module EK0 = L3.EK0 ;
 e : TR.G1.GB.IPt = L3.e ;
 Ob0 : U vl = TR.RN.Ob0 ;
 UG : TR.P0.PCtx = L3.UG ;
 UA : TR.P0.PTy[UG] = L3.UA ;
 srcEq : (d2 : Bool) -> Id G0.GB.IPt (G0.GB.src d2) (TR.G1.GB.src d2) = L3.srcEq ;
 module BK2 (Y : Ob0) (x : W0.Ix (L1.DU.ob Y)) (u0 : W0.Ix (EK0.SFm.sfOb Y (L1.s Y x))) {
  module B = L3.BK[Y, x, u0] ;
  module XS = B.XS ;
  module EK1 = L3.EK1 ;
  bk : W0.Ix (EK1.SFm.sfOb (TR.RN.o Y) x) = B.bk ;
  pU : Id (EK1.TV.EI (TR.RN.o Y)) (EK1.TS.pr1 (TR.RN.o Y) XS.u1) x = B.pU ;
  -- read back, it is the given element
  lineEq : Id (EK1.TL.EI (TR.RN.o Y)) (EK1.lineL (TR.RN.o Y) (EK1.TS.pr (TR.RN.o Y) x bk)) XS.L.line =
   transH (apH {EK1.TS.EI (TR.RN.o Y)} {EK1.TL.EI (TR.RN.o Y)} (EK1.lineL (TR.RN.o Y))
             (symH (EK1.TS.pr-coe (TR.RN.o Y) (EK1.TS.pr1 (TR.RN.o Y) XS.u1) x pU (EK1.TS.pr2 (TR.RN.o Y) XS.u1))))
    (EK1.mkTS-line (TR.RN.o Y) XS.Z.z1 XS.L.line (refl XS.Z.x1) XS.q) ;
  bkMv : Id (EK0.TS.EI Y) (L2.mS Y (EK1.TS.pr (TR.RN.o Y) x bk)) (EK0.TS.pr Y (L1.s Y x) u0) =
   EK0.ts-ext Y (L2.mS Y (EK1.TS.pr (TR.RN.o Y) x bk)) (EK0.TS.pr Y (L1.s Y x) u0) (refl (L1.s Y x))
    (\ Vb h j -> transH (apH {EK1.TL.EI (TR.RN.o Y)} {EK1.TA.EI (TR.RN.o Vb)}
                           (\ MM -> L2.FT1.lval (TR.RN.o Y) MM (TR.RN.o Vb) (TR.fn.onH Vb Y h) j) lineEq)
       (XS.L.lv-ret Vb h j)) ;
 } ;
 module AL (comp : G0.GB.CLine[l].Lines[UG, UA].CompK[G0.GB.src d, G0.GB.tgt d].Comp) {
  k00 : G0.GB.CLine[l].Lines[UG, UA].Fill (G0.GB.src d) = G0.GB.CFill[l].FillC[UG, UA, d, comp].fill ;
  k0 : G0.GB.CLine[l].Lines[UG, UA].Fill e =
   subst G0.GB.IPt (\ e2 -> G0.GB.CLine[l].Lines[UG, UA].Fill e2) (G0.GB.src d) e (srcEq d) k00 ;
  module M = G0.GB.CMove[l, l].Mv[L1.DU, L1.SU, L1.SU, G0.GB.CPartial[l].pmap-id L1.DU L1.SU,
    EK0.TV.E, EK0.SFm.SF, EK0.SFm.SF, G0.GB.CPartial[l].pmap-id EK0.TV.E EK0.SFm.SF,
    \ W x -> L1.s W x, \ Vb W g x -> L1.sNat Vb W g x,
    \ W v -> L2.mS W v, \ W v -> refl (L1.s W (L2.TSU.pr1 W v)), \ Vb W g v -> L2.mSnat Vb W g v,
    \ W v -> L2.mS W v, \ W v -> refl (L1.s W (L2.TSU.pr1 W v)), \ Vb W g v -> L2.mSnat Vb W g v,
    \ W v v' P Q -> L2.Inj[W, v, v', P, Q].law,
    \ Y x u0 -> L3.BK[Y, x, u0].bk, \ Y x u0 -> BK2[Y, x, u0].bkMv,
    \ W v -> refl (L2.mS W v), k0] ;
  al : G0.GB.CPartial[l].ContrOp L1.DU L1.SU = M.rc ;
 } ;
} ;