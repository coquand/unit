-- CPshIdJ4.seg (part 8 of the Id instance, canonicity-45): the instance
-- PIdJ : CwFId.SwanId[l+, CFibCwF].IdJStr, from CPshIdJa (IdT, IdT-nat,
-- rfl), CPshIdJ1 (J, J-beta), CPshIdJ2 (rfl-nat, cen-nat), CPshIdJ3 (J-nat).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;

module IdJOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 module J1 = CPshIdJ1[a, l].IdJ1Of[C] ;
 module J2 = CPshIdJ2[a, l].IdJ2Of[C] ;
 module J3 = CPshIdJ3c[a, l].IdJ3cOf[C] ;
 open P ;
 module SW2 = JA.SW2 ;

 PIdJ : SW2.IdJStr = new SW2.IdJStr[
  IdT     := JA.IdTS,
  IdT-nat := JA.IdT-natS,
  rfl     := JA.rflS,
  rfl-nat := \ D G A a0 s -> J2.RN[D, G, A, a0, s].law,
  J       := \ G A a0 CM d -> J1.JEl[G, A, a0, CM, d].J,
  J-beta  := \ G A a0 CM d -> J1.JEl[G, A, a0, CM, d].beta,
  cen-nat := J2.cenNat,
  J-nat   := \ D G A a0 s CM d -> J3.JN[D, G, A, a0, s, CM, d].law ] ;
} ;
