-- CUnpack.seg (canonicity-45; COBAR.md "Prop 58"): at the total site, the
-- context maps unpacking A's nested Sigma types into the telescope:
--   un      G.(Sigma A B) -> G.A.B    (re-pairing; B's action by tact-irr)
--   UX j    Pr.(SigX j B) -> Ex_j.B   (the G-values)
--   UH qs   Xc.(SigH qs B) -> HS_qs.B (the equations' Ids)
-- composites of un, so that their points compute to the components.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module UP (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module RS = CRhoSig[a].RS[R, encK, pe, y, u] ;
 module SO = RS.SO ;
 module SA = RS.SA ;
 module G1 = RS.T.G1 ;
 module PS1 = G1.GB.GPre[a+].PS ;
 C : CwF.CwF[a++] = RS.C ;
 SS : CwF.Formers[a++, C].SigStr = RS.SS ;
 un (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) : C.Sub (C.ext G (SS.Sig G A B)) (C.ext (C.ext G A) B) =
  new PS1.PSub[C.ext G (SS.Sig G A B), C.ext (C.ext G A) B, \ X w -> ((w.1, w.2.1), w.2.2),
   \ Y X f w -> apH {V1.Ix (B.1.tob Y (G.act Y X f w.1, A.1.tact Y X f w.1 (G.act Y X f w.1) (refl (G.act Y X f w.1)) w.2.1))}
       {V1.Ix ((C.ext (C.ext G A) B).ob Y)}
       (\ b -> ((G.act Y X f w.1, A.1.tact Y X f w.1 (G.act Y X f w.1) (refl (G.act Y X f w.1)) w.2.1), b))
       (PS1.tact-irr (C.ext G A) B.1 Y X f (w.1, w.2.1) (G.act Y X f w.1, A.1.tact Y X f w.1 (G.act Y X f w.1) (refl (G.act Y X f w.1)) w.2.1)
          (refl (G.act Y X f w.1, A.1.tact Y X f w.1 (G.act Y X f w.1) (refl (G.act Y X f w.1)) w.2.1))
          (PS1.pair-act G A.1 Y X f w.1 (G.act Y X f w.1) (refl (G.act Y X f w.1)) w.2.1) w.2.2)] ;
 Ex (j : Nat) : C.Ctx = RS.Ex j ;
 Gat (D : C.Ctx) : C.Ty D = SO.PW.Gat D ;
 UX : (j : Nat) (B : C.Ty (Ex j)) -> C.Sub (C.ext SO.Pr (SA.SigX j B)) (C.ext (Ex j) B) = split {
  zero -> \ B -> C.id (C.ext SO.Pr B) ;
  suc j | r -> \ B -> C.o (C.ext SO.Pr (SA.SigX j (SS.Sig (Ex j) (Gat (Ex j)) B))) (C.ext (Ex j) (SS.Sig (Ex j) (Gat (Ex j)) B)) (C.ext (Ex (suc j)) B)
     (un (Ex j) (Gat (Ex j)) B) (r (SS.Sig (Ex j) (Gat (Ex j)) B)) } ;
 UH : (qs : SX.Over[R].Equations SO.TW.Var) (B : C.Ty (SO.HS qs).1) -> C.Sub (C.ext SO.Xc (SA.SigH qs B)) (C.ext (SO.HS qs).1 B) = split {
  nil -> \ B -> C.id (C.ext SO.Xc B) ;
  cons q qs | r -> \ B -> C.o (C.ext SO.Xc (SA.SigH qs (SS.Sig (SO.HS qs).1 (SO.EqT (SO.HS qs).1 (SO.HS qs).2 q) B))) (C.ext (SO.HS qs).1 (SS.Sig (SO.HS qs).1 (SO.EqT (SO.HS qs).1 (SO.HS qs).2 q) B))
     (C.ext (SO.HS (cons q qs)).1 B) (un (SO.HS qs).1 (SO.EqT (SO.HS qs).1 (SO.HS qs).2 q) B) (r (SS.Sig (SO.HS qs).1 (SO.EqT (SO.HS qs).1 (SO.HS qs).2 q) B)) } ;
 -- from yo(y).A to the whole telescope
 module AYm = RS.T.RP.AYm ;
 qs : SX.Over[R].Equations SO.TW.Var = AYm.qs ;
 HSq : C.Ctx = (SO.HS qs).1 ;
 Ut : C.Ty HSq = SA.Ut HSq ;
 E : C.Ctx = C.ext RS.LA.PYy RS.A ;
 sAll : C.Sub E (C.ext HSq Ut) =
  C.o E (C.ext SO.Xc (SA.SigH qs Ut)) (C.ext HSq Ut) (UH qs Ut)
   (C.o E (C.ext SO.Pr (SA.Sp qs)) (C.ext SO.Xc (SA.SigH qs Ut)) (UX u.1 (SA.SigH qs Ut)) (C.lift RS.LA.PYy SO.Pr (SA.Sp qs) AYm.G.gY)) ;
 sH : C.Sub E HSq = C.o E (C.ext HSq Ut) HSq (C.p HSq Ut) sAll ;
 -- the prefix of the telescope ending at each equation
 PreT (L : SX.Over[R].Equations SO.TW.Var) : U a++ = C.Sub E (SO.HS L).1 ;
} ;
