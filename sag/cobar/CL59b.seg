-- CL59b.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part b: D of a levelwise equivalence of contexts has an inverse.
--   DInv[Y, Z, s, ef]   for s : Y -> Z (TCtx) with U of s an equivalence
--                       levelwise (ef, a G0 EquivOp read through c2's
--                       CtxTy), D s is an equivalence (Prop 13) and its
--                       centre map (CEqCen) gives inv : D Z -> D Y
--                       (CCmpY3/4's pattern, generic in the map)
--   to1 / fr1           a presheaf context and toP (ofP) of it, pointwise
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module DR (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module YF = CCopy6[a].YoF[R, encK, pe] ;
 module TR = YF.TR ;
 module CT = YF.CT ;
 module CM = YF.CM ;
 P : TR.P1.PCtx = CT.P1 ;
 to1 (E : TR.P1.PCtx) : TR.P1.PSub[E, CT.TC.toP (CT.TC.ofP E)] = new TR.P1.PSub[E, CT.TC.toP (CT.TC.ofP E), \ X w -> w, \ Y X h w -> refl (E.act Y X h w)] ;
 fr1 (E : TR.P1.PCtx) : TR.P1.PSub[CT.TC.toP (CT.TC.ofP E), E] = new TR.P1.PSub[CT.TC.toP (CT.TC.ofP E), E, \ X w -> w, \ Y X h w -> refl (E.act Y X h w)] ;
 module Map (Y Z : CM.TP.TCtx) (s : CM.TP.TSub[Y, Z]) {
  module OY = CT.Of[Y] ;
  module OZ = CT.Of[Z] ;
  sS : TR.P1.PSub[CT.TC.toP Y, CT.TC.toP Z] = CT.TC.toPS Y Z s ;
  sF : TR.G1.GB.CPartial[a+].PMap[CT.P1, OY.Y1T, OZ.Y1T] =
   TR.G1.GB.CPartial[a+].mkPMap CT.P1 OY.Y1T OZ.Y1T (\ X w -> (w.1, sS.nt X w.2)) (\ X w -> refl w.1)
    (\ Zz X h w -> apH {V1.Ix ((CT.TC.toP Z).ob Zz)} {V1.Ix ((TR.P1.extP CT.P1 OZ.Y1T).ob Zz)} (\ g -> ((CT.P1.act Zz X h w.1), g)) (sS.nt-nat Zz X h w.2)) ;
  module PD = CTotP13d[a, a+, a+].P13d[CM.IC, CT.T1, OY.Y1T, OZ.Y1T, sF] ;
  module P13m = CTotP13o[a, a+, a+].P13[CM.IC, CT.T1, OY.Y1T, OZ.Y1T, sF] ;
  -- D s^-1 : D Z -> D Y, as presheaf contexts, from any map of D-types back
  module DInvP (ip : TR.G1.GB.CPartial[a+].PMap[P13m.DF.DG, P13m.DF.DB.DTy, P13m.DF.DA.DTy]) {
   invE : TR.P1.PSub[OZ.PR.Ext, OY.PR.Ext] =
    new TR.P1.PSub[OZ.PR.Ext, OY.PR.Ext, \ X w -> ip.mE X w, \ Yy X h w -> ip.mnat Yy X h w] ;
   invP : TR.P1.PSub[OZ.DYP, OY.DYP] =
    new TR.P1.PSub[OZ.DYP, OY.DYP, \ X d -> OY.fwS.nt X (invE.nt X (OZ.bkS.nt X d)),
     \ Yy X h d -> transH (apH {V1.Ix (OY.PR.Ext.ob Yy)} {V1.Ix (OY.DYP.ob Yy)} (OY.fwS.nt Yy)
                           (transH (apH {V1.Ix (OZ.PR.Ext.ob Yy)} {V1.Ix (OY.PR.Ext.ob Yy)} (invE.nt Yy) (OZ.bkS.nt-nat Yy X h d)) (invE.nt-nat Yy X h (OZ.bkS.nt X d))))
                   (OY.fwS.nt-nat Yy X h (invE.nt X (OZ.bkS.nt X d)))] ;
  } ;
  -- the inverse given by the centres of Prop 13's equivalence structure
  module DInv (ef : TR.G0.GB.CEquiv[a+].EquivOp PD.UG PD.UA PD.UB PD.Uf) {
   module P13 = P13m ;
   dS : TR.G1.GB.CEquiv[a+].EquivOp P13.DF.DG P13.DF.DA.DTy P13.DF.DB.DTy P13.DF.Df = P13.prop13 ef ;
   module CE = CEqCen[a, a+, a+].Cen[CM.IC, P13.DF.DG, P13.DF.DA.DTy, P13.DF.DB.DTy, P13.DF.Df, dS] ;
   module DP = DInvP[CE.inv] ;
   invP : TR.P1.PSub[OZ.DYP, OY.DYP] = DP.invP ;
  } ;
 } ;
} ;
