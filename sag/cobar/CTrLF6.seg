-- CTrLF6.seg (canonicity-c2; SAG 8.3, location-free truncation, part 6):
-- rebasing along the identity substitution (identity family map) is the
-- identity on good trees: relocation along a root equality, then recursion.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[a+] ; open PR.PS ;
module W = V[a+] ;
module L = PR.PS ;
module Idn (G : PCtx) (A : PTy[G]) {
 psiN (J I : Ob) (f : Hom J I) (d : W.Ix (G.ob I)) (d' : W.Ix (G.ob J)) (e : Id (W.Ix (G.ob J)) (G.act J I f d) d') (v : W.Ix (A.tob I d))
   : Id (W.Ix (A.tob J d')) (A.tact J I f d d' e v) (A.tact J I f d d' (ntEq G G (idS G) J I f d d' e) v) =
  L.tact-irr G A J I f d d' e (ntEq G G (idS G) J I f d d' e) v ;
 module Gi = CTrLF4[a].G4[G, G, idS G, A, A, \ X d v -> v, psiN] ;
 module RB = Gi.RB ;
 module BG = RB.BG ;
 etaT (x : BG.Loc) : Id BG.Loc x (RB.sl x) = refl x ;
 module LA = CTruncLaws[a, a+].Laws[G, A] ;
 -- relocating a node along a root equality
 relN (z : BG.Loc) (Q : PB.Phi z.1) (u : (q : BG.Loc) -> BG.Arr q z -> BG.Raw) (w : (q : BG.Loc) (h : BG.Arr q z) -> PB.Lands q.1 z.1 Q h.1 -> BG.Raw)
   (d : BG.Loc) (e : Id BG.Loc z d)
   : Id BG.Raw (node d (RB.tQ z d e Q) (\ r h -> u r (RB.tA r d z (symH e) h)) (\ r h i -> w r (RB.tA r d z (symH e) h) (RB.tL r z d e Q h i))) (node z Q u w) =
  idJ BG.Loc z (\ d2 e2 -> Id BG.Raw (node d2 (RB.tQ z d2 e2 Q) (\ r h -> u r (RB.tA r d2 z (symH e2) h)) (\ r h i -> w r (RB.tA r d2 z (symH e2) h) (RB.tL r z d2 e2 Q h i))) (node z Q u w))
   (refl (node z Q u w)) d e ;
 aS (r d : BG.Loc) (h : BG.Arr r d) : Id (BG.Arr r d) (RB.arrS r d h) h = BG.arr-eq r d (RB.arrS r d h) h (refl h.1) ;
 idRb : (t : BG.Raw) (good : BG.Good t) (d : BG.Loc) (e : Id BG.Loc (BG.root t) d) -> Id BG.Raw (RB.rb t good d e) t = split {
  leaf z v -> \ good d e -> idJ BG.Loc z (\ d2 e2 -> Id BG.Raw (leaf d2 (RB.tV z d2 e2 v)) (leaf z v)) (refl (leaf z v)) d e ;
  node z Q u w | cu cw -> \ good d e ->
   transH
    (LA.node-cong d (RB.tQ z d e Q) (RB.tQ z d e Q) (refl (RB.tQ z d e Q))
      (\ r h -> RB.rb (u r (RB.tA r d z (symH e) (RB.arrS r d h))) (good.2.1 r (RB.tA r d z (symH e) (RB.arrS r d h))).1 r (good.2.1 r (RB.tA r d z (symH e) (RB.arrS r d h))).2)
      (\ r h -> u r (RB.tA r d z (symH e) h))
      (\ r h i -> RB.rb (w r (RB.tA r d z (symH e) (RB.arrS r d h)) (RB.tL r z d e Q (RB.arrS r d h) i))
                     (good.2.2.1 r (RB.tA r d z (symH e) (RB.arrS r d h)) (RB.tL r z d e Q (RB.arrS r d h) i)).1 r
                     (good.2.2.1 r (RB.tA r d z (symH e) (RB.arrS r d h)) (RB.tL r z d e Q (RB.arrS r d h) i)).2)
      (\ r h i -> w r (RB.tA r d z (symH e) h) (RB.tL r z d e Q h i))
      (\ r h -> transH (cu r (RB.tA r d z (symH e) (RB.arrS r d h)) (good.2.1 r (RB.tA r d z (symH e) (RB.arrS r d h))).1 r (good.2.1 r (RB.tA r d z (symH e) (RB.arrS r d h))).2)
                  (apH {BG.Arr r d} {BG.Raw} (\ c -> u r (RB.tA r d z (symH e) c)) (aS r d h)))
      (\ r h i j -> transH (cw r (RB.tA r d z (symH e) (RB.arrS r d h)) (RB.tL r z d e Q (RB.arrS r d h) i)
                              (good.2.2.1 r (RB.tA r d z (symH e) (RB.arrS r d h)) (RB.tL r z d e Q (RB.arrS r d h) i)).1 r
                              (good.2.2.1 r (RB.tA r d z (symH e) (RB.arrS r d h)) (RB.tL r z d e Q (RB.arrS r d h) i)).2)
                     (BG.boundary-cong z Q w r (RB.tA r d z (symH e) (RB.arrS r d h)) (RB.tA r d z (symH e) h)
                        (apH {BG.Arr r d} {BG.Arr r z} (\ c -> RB.tA r d z (symH e) c) (aS r d h))
                        (RB.tL r z d e Q (RB.arrS r d h) i) (RB.tL r z d e Q h j))))
    (relN z Q u w d e) } ;
} ;
