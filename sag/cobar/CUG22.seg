-- CUG22.seg (canonicity-c2; the generic (U), part 22 of CCmpU22's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU22 with
-- F2 replaced by s.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module UG22 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) {
 module U16m = CUG16[a].UG16[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN] ;
 module U20m = CUG20[a].UG20[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN] ;
 module U21m = CUG21[a].UG21[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN] ;
 module HZ = U16m.HZ ;
 module CS = HZ.CS ;
 module BZ = U16m.BZ ;
 Nl : C.Ctx = C.nil ;
 HS : C.Ty Nl = U16m.HS ;
 D1 : C.Ctx = U16m.D1 ;
 Gh : C.Ctx = U16m.Gh ;
 QA : C.Ty Nl = U16m.QA ;
 QY : C.Ty Nl = U16m.QY ;
 QYd : C.Ty D1 = U16m.QYd ;
 sA : C.Sub D1 Gh = U16m.sA ;
 sAn (K : Ob) (w : V1.Ix (D1.ob K)) : V1.Ix (Gh.ob K) = U16m.sAn K w ;
 EM (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I)) : Id (V1.Ix (Gh.ob J)) (Gh.act J I f (sAn I w)) (sAn J (D1.act J I f w)) =
  L.ntEq (L.extP Gh U20m.BA.DataBin.1) Gh (L.pP Gh U20m.BA.DataBin.1) J I f (sAn I w, w.2.2.1)
    (sAn J (D1.act J I f w), U20m.BA.DataBin.1.tact J I f (sAn I w) (sAn J (D1.act J I f w)) (U20m.E0 J I f w) w.2.2.1)
    (L.pair-act Gh U20m.BA.DataBin.1 J I f (sAn I w) (sAn J (D1.act J I f w)) (U20m.E0 J I f w) w.2.2.1) ;
 DS : C.Ty D1 = C.subT D1 Gh CS.DataCst sA ;
 dkN (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I))
   : Id (V1.Ix (CS.DataCst.1.tob J (sAn J (D1.act J I f w)))) (DS.1.tact J I f w (D1.act J I f w) (refl (D1.act J I f w)) w.2.2.2.2) (D1.act J I f w).2.2.2.2 =
  L.tact-irr Gh CS.DataCst.1 J I f (sAn I w) (sAn J (D1.act J I f w))
    (L.ntEq D1 Gh sA J I f w (D1.act J I f w) (refl (D1.act J I f w)))
    (L.ntEq (L.extP Gh U20m.BM.DataBin.1) Gh (L.pP Gh U20m.BM.DataBin.1) J I f (sAn I w, w.2.2.2.1)
       (sAn J (D1.act J I f w), U20m.BM.DataBin.1.tact J I f (sAn I w) (sAn J (D1.act J I f w)) (EM J I f w) w.2.2.2.1)
       (L.pair-act Gh U20m.BM.DataBin.1 J I f (sAn I w) (sAn J (D1.act J I f w)) (EM J I f w) w.2.2.2.1))
    w.2.2.2.2 ;
 dE : C.El D1 DS = L.mkPEl D1 DS.1 (\ K w -> w.2.2.2.2) (\ J I f w w' e ->
  idJ (V1.Ix (D1.ob J)) (D1.act J I f w) (\ w2 e2 -> Id (V1.Ix (DS.1.tob J w2)) (DS.1.tact J I f w w2 e2 w.2.2.2.2) w2.2.2.2.2)
    (dkN J I f w) w' e) ;
 Wch : C.Ty Gh = CS.Wch ;
 Wcs : C.Ty D1 = C.subT D1 Gh Wch sA ;
 E : C.Ctx = C.ext D1 Wcs ;
 lf : C.Sub E CS.Dc = C.lift D1 Gh Wch sA ;
 IdCs : C.Ty E = C.subT E CS.Dc CS.IdCT lf ;
 PiS : C.Ty D1 = FibCwF[a, a+].fibPi.Pi D1 Wcs IdCs ;
 PN : Id (C.Ty D1) DS PiS = FibCwF[a, a+].fibPi.Pi-nat D1 Gh Wch CS.IdCT sA ;
 dP : C.El D1 PiS = OV.trE D1 DS PiS PN dE ;
 PW : Id (C.Ty D1) (OV.wkT Nl HS CS.Wc) Wcs =
  symH (transH (symH (C.subT-o D1 Gh Nl CS.Wc CS.pG sA)) (U16m.clT D1 CS.Wc (C.o D1 Gh Nl CS.pG sA) (C.p Nl HS))) ;
 module GT2 = CS.GT2 ;
 s12 : C.Sub GT2.G2 Nl = C.o GT2.G2 GT2.G1 Nl (C.p Nl QY) (C.p GT2.G1 GT2.Qw) ;
 module At (r : R.R) {
  module WC = U21m.At[r] ;
  wh : C.El D1 Wcs = OV.trE D1 (OV.wkT Nl HS CS.Wc) Wcs PW (OV.wkE Nl HS CS.Wc WC.wc) ;
  rr : C.El D1 (C.subT D1 E IdCs (C.sec D1 Wcs wh)) = C.subt D1 E IdCs (OV.bod D1 Wcs IdCs dP) (C.sec D1 Wcs wh) ;
  ta : C.Sub D1 CS.GPT = C.o D1 E CS.GPT (C.o E CS.Dc CS.GPT CS.sT lf) (C.sec D1 Wcs wh) ;
  tb : C.Sub D1 GT2.G2 = C.o D1 CS.GPT GT2.G2 CS.rT ta ;
  TE1 : Id (C.Ty D1) (C.subT D1 E IdCs (C.sec D1 Wcs wh)) (C.subT D1 GT2.G2 CS.IdGT tb) =
   transH (apH {C.Ty E} {C.Ty D1} (\ T -> C.subT D1 E T (C.sec D1 Wcs wh)) (symH (C.subT-o E CS.Dc CS.GPT CS.IdCTt CS.sT lf)))
    (transH (symH (C.subT-o D1 E CS.GPT CS.IdCTt (C.o E CS.Dc CS.GPT CS.sT lf) (C.sec D1 Wcs wh)))
      (symH (C.subT-o D1 CS.GPT GT2.G2 CS.IdGT CS.rT ta))) ;
  Q2 : C.Ty D1 = C.subT D1 GT2.G2 GT2.Qw2 tb ;
  r1 : C.El D1 (IJ.IdT D1 Q2 (C.subt D1 GT2.G2 GT2.Qw2 GT2.v1 tb) (C.subt D1 GT2.G2 GT2.Qw2 GT2.v2 tb)) =
   OV.trE D1 (C.subT D1 E IdCs (C.sec D1 Wcs wh)) (IJ.IdT D1 Q2 (C.subt D1 GT2.G2 GT2.Qw2 GT2.v1 tb) (C.subt D1 GT2.G2 GT2.Qw2 GT2.v2 tb))
    (transH TE1 (IJ.IdT-nat D1 GT2.G2 GT2.Qw2 GT2.v1 GT2.v2 tb)) rr ;
  PQ : Id (C.Ty D1) Q2 QYd =
   transH (apH {C.Ty GT2.G2} {C.Ty D1} (\ T -> C.subT D1 GT2.G2 T tb) (symH (C.subT-o GT2.G2 GT2.G1 Nl QY (C.p Nl QY) (C.p GT2.G1 GT2.Qw))))
    (transH (symH (C.subT-o D1 GT2.G2 Nl QY s12 tb)) (U16m.clT D1 QY (C.o D1 GT2.G2 Nl s12 tb) (C.p Nl HS))) ;
  e1 : C.El D1 QYd = OV.trE D1 Q2 QYd PQ (C.subt D1 GT2.G2 GT2.Qw2 GT2.v1 tb) ;
  e3 : C.El D1 QYd = OV.trE D1 Q2 QYd PQ (C.subt D1 GT2.G2 GT2.Qw2 GT2.v2 tb) ;
  res : C.El D1 (IJ.IdT D1 QYd e1 e3) = U16m.idFwd D1 Q2 QYd PQ (C.subt D1 GT2.G2 GT2.Qw2 GT2.v1 tb) (C.subt D1 GT2.G2 GT2.Qw2 GT2.v2 tb) r1 ;
  -- readings
  WK (K : Ob) (o : V1.Ix (Nl.ob K)) : U a+ = V1.Ix (CS.Wc.1.tob K o) ;
  whrd (K : Ob) (w : V1.Ix (D1.ob K)) : Id (WK K w.1) (wh.eob K w) (WC.wc.eob K w.1) =
   transH (CAppRd[a].trE-rd D1 (OV.wkT Nl HS CS.Wc) Wcs PW (OV.wkE Nl HS CS.Wc WC.wc) K w)
    (CAppRd[a].same-rd D1 (OV.wkT Nl HS CS.Wc) Wcs PW K w (refl ((OV.wkT Nl HS CS.Wc).1.tob K w)) (WC.wc.eob K w.1)) ;
  wr (K : Ob) (o : V1.Ix (Nl.ob K)) : Id (WK K o) (WC.wc.eob K o) (r, (WC.c.eob K o, WC.pf.eob K o)) = WC.wcrd K o ;
  QK (K : Ob) (w : V1.Ix (D1.ob K)) : U a+ = V1.Ix (QY.1.tob K w.1) ;
  e1rd (K : Ob) (w : V1.Ix (D1.ob K)) : Id (QK K w) (e1.eob K w) ((HZ.AT.AX.cls (cst r)).eob K w.1) =
   transH (CAppRd[a].trE-rd D1 Q2 QYd PQ (C.subt D1 GT2.G2 GT2.Qw2 GT2.v1 tb) K w)
    (transH (CAppRd[a].same-rd D1 Q2 QYd PQ K w (refl (QYd.1.tob K w)) ((C.subt D1 GT2.G2 GT2.Qw2 GT2.v1 tb).eob K w))
      (apH {WK K w.1} {QK K w} (\ u -> (HZ.AT.AX.cls (cst u.1)).eob K w.1) (transH (whrd K w) (wr K w.1)))) ;
  e3rd (K : Ob) (w : V1.Ix (D1.ob K)) : Id (QK K w) (e3.eob K w) (BZ.hv K w.1 w.2.1 (WC.c.eob K w.1)) =
   transH (CAppRd[a].trE-rd D1 Q2 QYd PQ (C.subt D1 GT2.G2 GT2.Qw2 GT2.v2 tb) K w)
    (transH (CAppRd[a].same-rd D1 Q2 QYd PQ K w (refl (QYd.1.tob K w)) ((C.subt D1 GT2.G2 GT2.Qw2 GT2.v2 tb).eob K w))
      (apH {WK K w.1} {QK K w} (\ u -> BZ.hv K w.1 w.2.1 u.2.1) (transH (whrd K w) (wr K w.1)))) ;
 } ;
} ;
