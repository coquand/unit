-- CTotElim4.seg (canonicity-c2; towards (c), the eliminator of Tr): the
-- element of B on the inclusion: at ((g , t) , a) the transport of
-- b (g , a) from inc a to t (CTotElim2.move); natural by
-- GCTruncTransport.Natural.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module EL4 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G))
  (P : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotR[a, vl, l].TotR[C].G1.fibCwF-T.ext (CTotCat[a, vl, l].TotOf[C].toP G) (CTotTr[a, vl, l].TotTr[C].Tr[CTotCat[a, vl, l].TotOf[C].toP G, A].Tr)))
  (b : CTotR[a, vl, l].TotR[C].P1.PEl[CTotElim2[a, vl, l].EL2[C, G, A].GA,
         CTotR[a, vl, l].TotR[C].P1.subTy (CTotElim2[a, vl, l].EL2[C, G, A].GA) (CTotElim2[a, vl, l].EL2[C, G, A].GT) P.1 (CTotElim2[a, vl, l].EL2[C, G, A].incS)]) {
 module E3 = CTotElim3[a, vl, l].EL3[C, G, A, P] ;
 module E2 = E3.E2 ;
 module TR = E3.TR ;
 module P1 = TR.P1 ;
 module RN = TR.RN ;
 module MV = E2.At[P] ;
 Tr1 : P1.PTy[E2.GP] = E2.Tr.1 ;
 bbV (Y : RN.Ob0) (w : W0.Ix ((TR.P0.extP E3.Dl E3.CM.As.1).ob Y)) : W0.Ix (P.1.tob (RN.o Y) w.1) =
  MV.move (RN.o Y) w.1.1 (E2.incV (RN.o Y) (w.1.1, w.2)) w.1.2 (b.eob (RN.o Y) (w.1.1, w.2)) ;
 -- naturality at the canonical acted point
 module NB (J I : RN.Ob0) (f : RN.Hom0 J I) (w : W0.Ix ((TR.P0.extP E3.Dl E3.CM.As.1).ob I))
 {
  oJ : TR.RN.Ob1 = RN.o J ;
  oI : TR.RN.Ob1 = RN.o I ;
  h : RN.Hom1 oJ oI = TR.fn.onH J I f ;
  g : W0.Ix (E2.GP.ob oI) = w.1.1 ;
  t : W0.Ix (Tr1.tob oI g) = w.1.2 ;
  wa : W0.Ix (E2.GA.ob oI) = (g, w.2) ;
  wa' : W0.Ix (E2.GA.ob oJ) = E2.GA.act oJ oI h wa ;
  ea : Id (W0.Ix (E2.GA.ob oJ)) (E2.GA.act oJ oI h wa) wa' = refl wa' ;
  g' : W0.Ix (E2.GP.ob oJ) = E2.GP.act oJ oI h g ;
  t' : W0.Ix (Tr1.tob oJ g') = Tr1.tact oJ oI h g g' (refl g') t ;
  u : W0.Ix (Tr1.tob oI g) = E2.incV oI wa ;
  bw : W0.Ix (P.1.tob oI (g, u)) = b.eob oI wa ;
  bw' : W0.Ix (P.1.tob oJ (wa'.1, E2.incV oJ wa')) = b.eob oJ wa' ;
  -- the image of the point under incS, moved
  eu : Id (W0.Ix (E2.GT.ob oJ)) (E2.GT.act oJ oI h (g, u)) (E2.incS.nt oJ wa') =
   transH (symH (E2.incS.nt-nat oJ oI h wa)) (apH {W0.Ix (E2.GA.ob oJ)} {W0.Ix (E2.GT.ob oJ)} (\ z -> E2.incS.nt oJ z) ea) ;
  q : Id (P1.SigT E2.GT P.1 oJ) (P1.pairE E2.GT P.1 oJ (E2.GT.act oJ oI h (g, u)) (P.1.tact oJ oI h (g, u) (E2.GT.act oJ oI h (g, u)) (refl (E2.GT.act oJ oI h (g, u))) bw))
        (P1.pairE E2.GT P.1 oJ (E2.incS.nt oJ wa') bw') =
   transH (P1.pair-act E2.GT P.1 oJ oI h (g, u) (E2.incS.nt oJ wa') eu bw)
     (apH {W0.Ix (P.1.tob oJ (E2.incS.nt oJ wa'))} {P1.SigT E2.GT P.1 oJ} (\ c -> P1.pairE E2.GT P.1 oJ (E2.incS.nt oJ wa') c)
        (transH (P1.tact-irr E2.GT P.1 oJ oI h (g, u) (E2.incS.nt oJ wa') eu (P1.ntEq E2.GA E2.GT E2.incS oJ oI h wa wa' ea) bw)
           (b.enat oJ oI h wa wa' ea))) ;
  u' : W0.Ix (Tr1.tob oJ g') = E2.incV oJ wa' ;
  un : Id (W0.Ix (Tr1.tob oJ g')) (Tr1.tact oJ oI h g g' (refl g') u) u' =
   transH (P1.tact-irr E2.GP Tr1 oJ oI h g g' (refl g') (P1.ntEq E2.GA E2.GP (P1.pP E2.GP A.1) oJ oI h wa wa' ea) u)
     (E2.TT.incE.enat oJ oI h wa wa' ea) ;
  pp : Id (W0.Ix (MV.TP.P.Pth.GA.ob oJ)) (MV.TP.P.Pth.GA.act oJ oI h (g, (u, t))) (g', (u', t')) =
   apH {W0.Ix (Tr1.tob oJ g')} {W0.Ix (MV.TP.P.Pth.GA.ob oJ)} (\ c -> (g', (c, t'))) un ;
  module NT = MV.TP.Natural[oJ, oI, h, g, g', u, t, u', t', pp, bw, bw', q] ;
  m : W0.Ix (P.1.tob oI (g, t)) = MV.move oI g u t bw ;
  law0 : Id (W0.Ix (P.1.tob oJ (g', t'))) (P.1.tact oJ oI h (g, t) (g', t') (refl (g', t')) m) (MV.move oJ g' u' t' bw') =
   P1.pairE-inj E2.GT P.1 oJ (g', t') (P.1.tact oJ oI h (g, t) (g', t') (refl (g', t')) m) (MV.move oJ g' u' t' bw') NT.result ;
 } ;
 module P0 = TR.P0 ;
 EA : P0.PCtx = P0.extP E3.Dl E3.CM.As.1 ;
 module BB (pP : E3.G1.fibCwF-T.El E2.GT (E3.PN1.isProp E2.GT P)) {
  module EM = E3.CM.TO'.El[E3.B, E3.At[pP].pr] ;
  AI : P0.PTy[EA] = EM.E.atInc ;
  module BS (J I : RN.Ob0) (f : RN.Hom0 J I) (w : W0.Ix (EA.ob I)) {
   module N = NB[J, I, f, w] ;
   y : W0.Ix (EA.ob J) = EA.act J I f w ;
   Ty0 : U l = W0.Ix (P.1.tob (RN.o J) (N.g', N.t')) ;
   lhs : Ty0 = AI.tact J I f w y (refl y) (bbV I w) ;
   mid : Ty0 = P.1.tact (RN.o J) (RN.o I) N.h w.1 (N.g', N.t') (refl (N.g', N.t')) N.m ;
   s1 : Id Ty0 lhs mid = P1.tact-irr E2.GT P.1 (RN.o J) (RN.o I) N.h w.1 (N.g', N.t')
     (P0.ntEq E3.DT E3.Dl (P0.pP E3.Dl E3.Tp.1) J I f (EM.E.E.inclusion.nt I w) (EM.E.E.inclusion.nt J y) (P0.ntEq EA E3.DT EM.E.E.inclusion J I f w y (refl y)))
     (refl (N.g', N.t')) N.m ;
   a2 : W0.Ix (A.1.tob (RN.o J) N.g') = y.2 ;
   ea : Id (W0.Ix (A.1.tob (RN.o J) N.g')) (A.1.tact (RN.o J) (RN.o I) N.h w.1.1 N.g' (refl N.g') w.2) a2 =
    P1.tact-irr E2.GP A.1 (RN.o J) (RN.o I) N.h w.1.1 N.g' (refl N.g') (P0.ntEq E3.Dl E3.TT.UG E3.pi J I f w.1 (E3.Dl.act J I f w.1) (refl (E3.Dl.act J I f w.1))) w.2 ;
   s3 : Id Ty0 (MV.move (RN.o J) N.g' N.u' N.t' N.bw') (bbV J y) =
    ap (W0.Ix (A.1.tob (RN.o J) N.g')) Ty0
      (\ c -> MV.move (RN.o J) N.g' (E2.incV (RN.o J) (N.g', c)) N.t' (b.eob (RN.o J) (N.g', c)))
      (A.1.tact (RN.o J) (RN.o I) N.h w.1.1 N.g' (refl N.g') w.2) a2 ea ;
   res : Id Ty0 lhs (bbV J y) = transH s1 (transH N.law0 s3) ;
  } ;
  base (J I : RN.Ob0) (f : RN.Hom0 J I) (w : W0.Ix (EA.ob I))
    : Id (W0.Ix (AI.tob J (EA.act J I f w))) (AI.tact J I f w (EA.act J I f w) (refl (EA.act J I f w)) (bbV I w)) (bbV J (EA.act J I f w)) =
   BS[J, I, f, w].res ;
  bb : P0.PEl[EA, AI] = P0.mkPEl EA AI (\ Y w -> bbV Y w) (\ J I f w y e ->
   idJ (W0.Ix (EA.ob J)) (EA.act J I f w) (\ y2 e2 -> Id (W0.Ix (AI.tob J y2)) (AI.tact J I f w y2 e2 (bbV I w)) (bbV J y2))
     (base J I f w) y e) ;
 } ;
} ;
