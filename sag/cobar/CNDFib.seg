-- CNDFib.seg (canonicity-45; COBAR.md "N axiom"): N_D = D(Delta N) read as a
-- type over the terminal context of the total site (Cor 15's Bt for
-- A = Delta N) is fibrant: Lemma 12F at NMod's levelwise fibration
-- structure of Delta N (CTotL16m), through CTotL14g.Out.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module NDF (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module NM = CTotL16m[a].NMod[R, encK, pe] ;
 module CT = NM.CT ;
 module C15 = CTotC15[a, a+, a+].C15[NM.YF.CM.IC, CT.T1, NM.DeltaN] ;
 ND : NM.TR.P1.PTy[CT.P1] = C15.LB.Bt ;
 fbND : NM.TR.G1.GB.CLine[a+].Lines[CT.P1, ND].Fib = C15.LG.Out[C15.LF.lemma12F NM.fibG0].fbB ;
 NDs : NM.TR.G1.fibCwF-T.Ty NM.TR.G1.fibCwF-T.nil = (ND, fbND) ;
} ;
