-- CPshSigFib.seg (canonicity-45; (B) stage 2(a), COBAR.md): Sigma of
-- uniformly fibrant C-types is uniformly fibrant, and the SigStr of the
-- CwF of fibrant C-types.
--   SU       the composite of Sigma A B (CSig.SigC at each x, from the
--            derived filler of A and the composition of B) is C-uniform
--            when those of A and B are: mirror of CSigNat.SigNatC.H for the
--            C-action, with CPshFillU for the A fillers (LAeq), the
--            uniformity of B for the B composites (kE-eq), and the
--            readings for the Sigma composites (res)
--   sigCl    the UFib of Sigma: CSig.SigFib at each x, SU in both directions
--   sigCl-nat the law of CwFCl.ClSig: the base's FibCwF.SigN.law at each x
--   FSigC    the ClSig instance on CFibCwF

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module CS = PB.CSig[l] ;
module CFl = PB.CFill[l] ;
module FBC = FibCwF[a, l] ;

module SigFibOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module SGm = CPshSig[a, l].SigOf[C] ;
 module FUm = CPshFillU[a, l].FillUOf[C] ;
 open P ;

 ------------------------------------------------------------------
 -- the composite of Sigma is C-uniform

 module SU (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (d : Bool)
  (kA : (x : CO) -> CL.Lines[G.ob x, A.ty x].CompK[PB.src d, PB.tgt d].Comp) (cuA : LO.UF[G, A].UComp (PB.src d) (PB.tgt d) kA)
  (kB : (x : CO) -> CL.Lines[(LO.ExtC G A).ob x, B.ty x].CompK[PB.src d, PB.tgt d].Comp) (cuB : LO.UF[LO.ExtC G A, B].UComp (PB.src d) (PB.tgt d) kB) {
  module SG = SGm.SG[G, A, B] ;
  module FA = FUm.FU[G, A, d, kA, cuA] ;
  module FB = FUm.FU[LO.ExtC G A, B, d, kB, cuB] ;
  module AES = LO.AE[G, SG.SigC, PB.src d] ;
  module AES' = LO.AE[G, SG.SigC, PB.tgt d] ;
  module SFS = LO.SF[G, SG.SigC, PB.src d] ;
  module SCS = LO.SC[SFS.TVC, LO.LinC G, LO.pPC (LO.LinC G) AES.AevC, AES'.AevC] ;
  module Sx (x : CO) {
   module S = CS.SigC[G.ob x, A.ty x, B.ty x, d, CFl.FillC[G.ob x, A.ty x, d, kA x].fill, kB x] ;
  } ;
  kS (x : CO) : CL.Lines[G.ob x, SG.Sx x].CompK[PB.src d, PB.tgt d].Comp = Sx[x].S.comp ;
  module MS (y x : CO) (f : CH y x) { module M = MapSide[SFS.TVC, SFS.SFC, y, x, f] ; } ;

  -- the C-actions on the Sigma end data and on Sigma elements
  tvS (y x : CO) (f : CH y x) (X : Ob) (w : Sx[x].S.KS.TV.EI X) : Sx[y].S.KS.TV.EI X = AES.tEv y x f X w ;
  tsS (y x : CO) (f : CH y x) (X : Ob) (u : Sx[x].S.KS.TS.EI X) : Sx[y].S.KS.TS.EI X = SFS.tES y x f X u ;
  taS (y x : CO) (f : CH y x) (W : Ob) (v : Sx[x].S.TSg.EI W) : Sx[y].S.TSg.EI W = (SG.SigC.tE y x f).nt W v ;

  -- the parts of a moved Sigma element are the moved parts
  pAC (y x : CO) (f : CH y x) (W : Ob) (v : Sx[x].S.TSg.EI W)
   : Id (Sx[y].S.TA.EI W) (Sx[y].S.pA.nt W (taS y x f W v)) (FA.ta y x f W (Sx[x].S.pA.nt W v)) =
   B.tE-pt y x f W (SG.flat x W v) ;
  pBC (y x : CO) (f : CH y x) (W : Ob) (v : Sx[x].S.TSg.EI W)
   : Id (Sx[y].S.TB.EI W) (Sx[y].S.pB.nt W (taS y x f W v)) (FB.ta y x f W (Sx[x].S.pB.nt W v)) =
   refl (FB.ta y x f W (Sx[x].S.pB.nt W v)) ;

  -- a Sigma composite, moved and read in E, is the composite read in E
  mVrB (x : CO) (V : Ob) (u : Sx[x].S.TTS.EI V) : Id (AES'.TVT x V) (Sx[x].S.CS.SE.mV V u) (SCS.rB x V u) = refl (SCS.rB x V u) ;
  opaque mVrB ;
  r1 (y x : CO) (f : CH y x) (V : Ob) (v : Sx[x].S.TTS.EI V)
   : Id (AES'.TVT y V) (SCS.rB y V (SCS.tEs y x f V v)) (AES'.tEv y x f V (SCS.rB x V v)) = SCS.rBtE y x f V v ;
  opaque r1 ;
  r2 (y x : CO) (f : CH y x) (V : Ob) (v : Sx[x].S.TTS.EI V)
   : Id (Sx[y].S.TSg.EI V) (Sx[y].S.KS'.endE V (AES'.tEv y x f V (SCS.rB x V v))) (taS y x f V (Sx[x].S.KS'.endE V (SCS.rB x V v))) =
   AES'.endEv y x f V (SCS.rB x V v) ;
  opaque r2 ;
  rdCS (y x : CO) (f : CH y x) (V : Ob) (v : Sx[x].S.TTS.EI V)
   : Id (Sx[y].S.TSg.EI V) (Sx[y].S.rdS V (SCS.tEs y x f V v)) (taS y x f V (Sx[x].S.rdS V v)) =
   transH {Sx[y].S.TSg.EI V} {Sx[y].S.KS'.endE V (Sx[y].S.CS.SE.mV V (SCS.tEs y x f V v))} {Sx[y].S.KS'.endE V (SCS.rB y V (SCS.tEs y x f V v))} {taS y x f V (Sx[x].S.rdS V v)}
    (apH (Sx[y].S.KS'.endE V) (mVrB y V (SCS.tEs y x f V v)))
    (transH {Sx[y].S.TSg.EI V} {Sx[y].S.KS'.endE V (SCS.rB y V (SCS.tEs y x f V v))} {Sx[y].S.KS'.endE V (AES'.tEv y x f V (SCS.rB x V v))} {taS y x f V (Sx[x].S.rdS V v)}
      (apH (Sx[y].S.KS'.endE V) (r1 y x f V v))
      (transH {Sx[y].S.TSg.EI V} {Sx[y].S.KS'.endE V (AES'.tEv y x f V (SCS.rB x V v))} {taS y x f V (Sx[x].S.KS'.endE V (SCS.rB x V v))} {taS y x f V (Sx[x].S.rdS V v)}
        (r2 y x f V v)
        (apH (taS y x f V) (apH (Sx[x].S.KS'.endE V) (symH (mVrB x V v)))))) ;
  opaque rdCS ;

  module H (y x : CO) (f : CH y x) (X : Ob) (w : Sx[x].S.KS.TV.EI X) (sd : Sx[x].S.KS.PT.Side[X, w]) {
   module Xs = Sx[x].S ;
   module Ys = Sx[y].S ;
   module Cx = Xs.Cm[X, w, sd] ;
   msd : Ys.KS.PT.Side[X, tvS y x f X w] = MS[y, x, f].M.mapside X w sd ;
   module Cy = Ys.Cm[X, tvS y x f X w, msd] ;
   fillY : CL.Lines[G.ob y, A.ty y].Fill (PB.src d) = CFl.FillC[G.ob y, A.ty y, d, kA y].fill ;

   --------------------------------------------------------------
   -- the A part of the moved data is the moved A part

   ptA (V : Ob) (z : Xs.KS.TV.EI V) : Id (Ys.KA.TV.EI V) (FA.tv y x f V (Xs.tvA V z)) (Ys.tvA V (tvS y x f V z)) =
    Ys.KA.tv-eq V (FA.tv y x f V (Xs.tvA V z)) (Ys.tvA V (tvS y x f V z))
     (refl (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF V (Xs.KS.TV.pr1 V z)))
     (calc (Ys.TA.EI V) {
         Ys.KA.endE V (FA.tv y x f V (Xs.tvA V z))
       =< FA.AEe.endEv y x f V (Xs.tvA V z) >
         FA.ta y x f V (Xs.KA.endE V (Xs.tvA V z))
       =< symH (pAC y x f V (Xs.KS.endE V z)) >
         Ys.pA.nt V (taS y x f V (Xs.KS.endE V z))
       =< apH (Ys.pA.nt V) (symH (AES.endEv y x f V z)) >
         Ys.KA.endE V (Ys.tvA V (tvS y x f V z)) }) ;

   sideEq : Id (Ys.KA.PT.Side[X, Ys.tvA X (tvS y x f X w)])
             (subst (Ys.KA.TV.EI X) (\ z -> Ys.KA.PT.Side[X, z]) (FA.tv y x f X (Xs.tvA X w)) (Ys.tvA X (tvS y x f X w)) (ptA X w)
                (FA.MSd[y, x, f].M.mapside X (Xs.tvA X w) (Xs.sideA X w sd)))
             (Ys.sideA X (tvS y x f X w) msd) =
    Ys.KA.PT.side-extH X (FA.tv y x f X (Xs.tvA X w)) (Ys.tvA X (tvS y x f X w)) (ptA X w)
     (FA.MSd[y, x, f].M.mapside X (Xs.tvA X w) (Xs.sideA X w sd)) (Ys.sideA X (tvS y x f X w) msd)
     (refl sd.pQ)
     (\ V g h h' ->
      Ys.KA.ts-ext V (FA.ts y x f V (Xs.tsA V (sd.pv V g h))) (Ys.tsA V (tsS y x f V (sd.pv V g h')))
       (transH (ptA V (Xs.KS.TS.pr1 V (sd.pv V g h)))
          (apH (\ z -> Ys.tvA V (tvS y x f V (Xs.KS.TS.pr1 V z))) (Xs.KS.PT.pv-irr X w sd V g h h')))
       (\ V' g' j ->
        transH (symH (pAC y x f V' (Xs.KS.lv V (sd.pv V g h) V' g' j)))
          (apH (\ u -> Ys.pA.nt V' (taS y x f V' (Xs.KS.lv V u V' g' j))) (Xs.KS.PT.pv-irr X w sd V g h h')))) ;
   opaque ptA ; opaque sideEq ;

   -- the A fillers
   LAeq : Id (Ys.KA.TS.EI X) (FA.ts y x f X (Xs.KA.TS.pr X (Xs.tvA X w) Cx.LA)) (Ys.KA.TS.pr X (Ys.tvA X (tvS y x f X w)) Cy.LA) =
    transH (FA.fill-C y x f X (Xs.tvA X w) (Xs.sideA X w sd))
     (Ys.RCA.kop-cong fillY X (FA.tv y x f X (Xs.tvA X w)) (Ys.tvA X (tvS y x f X w)) (ptA X w)
        (FA.MSd[y, x, f].M.mapside X (Xs.tvA X w) (Xs.sideA X w sd)) (Ys.sideA X (tvS y x f X w) msd) sideEq) ;
   LAv (V : Ob) (g : Hom V X) (j : Hom V Iv) : Id (Ys.TA.EI V) (FA.ta y x f V (Cx.LA.1.1.1 V g j)) (Cy.LA.1.1.1 V g j) =
    apH (\ z -> (Ys.KA.TS.pr2 X z).1.1.1 V g j) LAeq ;
   opaque LAeq ;

   --------------------------------------------------------------
   -- the start and the side of the B part move

   PW : Id (Ys.KB.TV.EI X) (FB.tv y x f X Cx.wB) Cy.wB =
    Ys.KB.tv-eq X (FB.tv y x f X Cx.wB) Cy.wB (Ys.FB.FG.fam-eq X (Ys.KB.TV.pr1 X (FB.tv y x f X Cx.wB)) (Ys.KB.TV.pr1 X Cy.wB) LAv)
     (calc (Ys.TB.EI X) {
         Ys.KB.endE X (FB.tv y x f X Cx.wB)
       =< FB.AEe.endEv y x f X Cx.wB >
         FB.ta y x f X (Xs.KB.endE X Cx.wB)
       =< apH (FB.ta y x f X) Cx.wB-E >
         FB.ta y x f X (Xs.pB.nt X (Xs.KS.endE X w))
       =< symH (pBC y x f X (Xs.KS.endE X w)) >
         Ys.pB.nt X (taS y x f X (Xs.KS.endE X w))
       =< apH (Ys.pB.nt X) (symH (AES.endEv y x f X w)) >
         Ys.pB.nt X (Ys.KS.endE X (tvS y x f X w))
       =< symH Cy.wB-E >
         Ys.KB.endE X Cy.wB }) ;

   vB (V : Ob) (g : Hom V X) (h : PB.Lands V X sd.pQ g) (h' : PB.Lands V X sd.pQ g)
    : Id (Ys.KB.TS.EI V) (FB.ts y x f V (Cx.pvB V g h)) (Cy.pvB V g h') =
    Ys.KB.ts-ext V (FB.ts y x f V (Cx.pvB V g h)) (Cy.pvB V g h')
     (transH (apH (FB.tv y x f V) (Cx.pvB-pt V g h))
       (transH (FB.tv-nat y x f V X g Cx.wB)
         (transH (apH (Ys.KB.TV.E.act V X g) PW) (symH (Cy.pvB-pt V g h')))))
     (\ W' g' j ->
      calc (Ys.TB.EI W') {
          Ys.KB.lv V (FB.ts y x f V (Cx.pvB V g h)) W' g' j
        =< apH (FB.ta y x f W') (Cx.pv-lev V g h W' g' j) >
          FB.ta y x f W' (Xs.pB.nt W' ((Xs.KS.TS.pr2 V (sd.pv V g h)).1.1.1 W' g' j))
        =< symH (pBC y x f W' ((Xs.KS.TS.pr2 V (sd.pv V g h)).1.1.1 W' g' j)) >
          Ys.pB.nt W' (taS y x f W' ((Xs.KS.TS.pr2 V (sd.pv V g h)).1.1.1 W' g' j))
        =< apH (\ u -> Ys.pB.nt W' (taS y x f W' ((Xs.KS.TS.pr2 V u).1.1.1 W' g' j))) (Xs.KS.PT.pv-irr X w sd V g h h') >
          Ys.pB.nt W' (taS y x f W' ((Xs.KS.TS.pr2 V (sd.pv V g h')).1.1.1 W' g' j))
        =< symH (Cy.pv-lev V g h' W' g' j) >
          Ys.KB.lv V (Cy.pvB V g h') W' g' j }) ;

   PS : Id (Ys.KB.PT.Side[X, Cy.wB])
          (subst (Ys.KB.TV.EI X) (\ z -> Ys.KB.PT.Side[X, z]) (FB.tv y x f X Cx.wB) Cy.wB PW (FB.MSd[y, x, f].M.mapside X Cx.wB Cx.sideB)) Cy.sideB =
    Ys.KB.PT.side-extH X (FB.tv y x f X Cx.wB) Cy.wB PW (FB.MSd[y, x, f].M.mapside X Cx.wB Cx.sideB) Cy.sideB (refl sd.pQ) vB ;
   opaque PW ; opaque PS ;

   --------------------------------------------------------------
   -- the composites agree

   kE-eq : Id (Ys.TSg.EI X) (taS y x f X Cx.kE) Cy.kE =
    apH (Ys.jn.nt X)
     (transH (symH (FB.rdC y x f X (Xs.TTB.pr X Cx.wB Cx.bB)))
       (apH (Ys.rdB X)
         (transH (cuB y x f X Cx.wB Cx.sideB)
           (Ys.RCB.kop-cong (kB y) X (FB.tv y x f X Cx.wB) Cy.wB PW (FB.MSd[y, x, f].M.mapside X Cx.wB Cx.sideB) Cy.sideB PS)))) ;
   opaque kE-eq ;

   res : Id (Ys.TTS.EI X) (SCS.tEs y x f X (Xs.TTS.pr X w (Xs.kop X w sd)))
                          (Ys.TTS.pr X (tvS y x f X w) (Ys.kop X (tvS y x f X w) msd)) =
    Ys.tt-ext X (SCS.tEs y x f X (Xs.TTS.pr X w (Xs.kop X w sd))) (Ys.TTS.pr X (tvS y x f X w) (Ys.kop X (tvS y x f X w) msd))
     (refl (tvS y x f X w))
     (calc (Ys.TSg.EI X) {
         Ys.rdS X (SCS.tEs y x f X (Xs.TTS.pr X w (Xs.kop X w sd)))
       =< rdCS y x f X (Xs.TTS.pr X w (Xs.kop X w sd)) >
         taS y x f X (Xs.rdS X (Xs.TTS.pr X w (Xs.kop X w sd)))
       =< apH (taS y x f X) Cx.rdK >
         taS y x f X Cx.kE
       =< kE-eq >
         Cy.kE
       =< symH Cy.rdK >
         Ys.rdS X (Ys.TTS.pr X (tvS y x f X w) (Ys.kop X (tvS y x f X w) msd)) }) ;
  } ;

  res : LO.UF[G, SG.SigC].UComp (PB.src d) (PB.tgt d) kS = \ y x f X w sd -> H[y, x, f, X, w, sd].res ;
 } ;

 ------------------------------------------------------------------
 -- Sigma of uniformly fibrant C-types

 sigCl (G : CCtx) (A : UF.FCC.STy G) (B : UF.FCC.STy (LO.ExtC G A.1)) : UF.Cl G (SGm.SG[G, A.1, B.1].SigC) =
  (\ x -> CS.SigFib[G.ob x, A.1.ty x, B.1.ty x, A.2.1 x, B.2.1 x].fib,
   (SU[G, A.1, B.1, true, \ x -> (A.2.1 x).1, A.2.2.1, \ x -> (B.2.1 x).1, B.2.2.1].res,
    SU[G, A.1, B.1, false, \ x -> (A.2.1 x).2, A.2.2.2, \ x -> (B.2.1 x).2, B.2.2.2].res)) ;

 -- the law: the base's SigN.law at each x
 module SNat (D G : CCtx) (A : UF.FCC.STy G) (B : UF.FCC.STy (LO.ExtC G A.1)) (s : CSub[D, G]) {
  module SN = SGm.SigNatC[D, G, s, A.1, B.1] ;
  A' : UF.FCC.STy D = UF.FCC.subS D G A s ;
  B' : UF.FCC.STy (LO.ExtC D A'.1) = UF.FCC.subS (LO.ExtC D A'.1) (LO.ExtC G A.1) B (CW.liftC D G A.1 s) ;
  Sg : CTy[D] = LO.subCTy D G s SN.SGg.SigC ;
  base (x : CO) : Id (FBC.FC.STy (D.ob x))
    (FBC.FC.subS (D.ob x) (G.ob x) (SN.SGg.Sx x, CS.SigFib[G.ob x, A.1.ty x, B.1.ty x, A.2.1 x, B.2.1 x].fib) (s.sb x))
    (SN.SGd.Sx x, CS.SigFib[D.ob x, A'.1.ty x, B'.1.ty x, A'.2.1 x, B'.2.1 x].fib) =
   FBC.SigN[D.ob x, G.ob x, s.sb x, (A.1.ty x, A.2.1 x), (B.1.ty x, B.2.1 x)].law ;
  opaque base ;
  law : Id (UF.FCC.STy D) (UF.FCC.subS D G (SN.SGg.SigC, sigCl G A B) s) (SN.SGd.SigC, sigCl D A' B') =
   Sigma-path (CTy[D]) (UF.Cl D) Sg SN.SGd.SigC (UF.clSubU D G s SN.SGg.SigC (sigCl G A B)) (sigCl D A' B') SN.nat
    (UF.ufib-eq D SN.SGd.SigC (subst (CTy[D]) (UF.Cl D) Sg SN.SGd.SigC SN.nat (UF.clSubU D G s SN.SGg.SigC (sigCl G A B))) (sigCl D A' B')
      (\ x ->
       transH (UF.fibTrC D Sg SN.SGd.SigC SN.nat (UF.clSubU D G s SN.SGg.SigC (sigCl G A B)) x)
        (transH (apH (\ pp -> subst (PTy[D.ob x]) (\ T -> CL.Lines[D.ob x, T].Fib) (Sg.ty x) (SN.SGd.Sx x) pp
                               (PB.CFibSub[l].FibSub[D.ob x, G.ob x, s.sb x, SN.SGg.Sx x].sub (CS.SigFib[G.ob x, A.1.ty x, B.1.ty x, A.2.1 x, B.2.1 x].fib)))
                   (isSet-PTy (D.ob x) (Sg.ty x) (SN.SGd.Sx x) (apH (\ X -> X.ty x) SN.nat) (apH (\ u -> u.1) (base x))))
          (UF.sigSnd (PTy[D.ob x]) (UF.FCL.Cl (D.ob x))
             (FBC.FC.subS (D.ob x) (G.ob x) (SN.SGg.Sx x, CS.SigFib[G.ob x, A.1.ty x, B.1.ty x, A.2.1 x, B.2.1 x].fib) (s.sb x))
             (SN.SGd.Sx x, CS.SigFib[D.ob x, A'.1.ty x, B'.1.ty x, A'.2.1 x, B'.2.1 x].fib) (base x))))) ;
 } ;

 module FSigC = UF.FCC.ClSig[SGm.PSigC, sigCl, \ D G A B s -> SNat[D, G, A, B, s].law] ;
} ;
