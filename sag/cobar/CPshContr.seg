-- CPshContr.seg (canonicity-c2; COBAR.md (B), the S3 bridge, part (I)):
-- contractibility of a C-type, in the two forms.
--
--   UTriv G T   a ContrOp of T_x at each x, uniform in C (CPshC)
--   raw internal contractibility: a centre c : CEl[G, T] and a
--   contraction ctr : CEl[G.T, Id(c[p] , q)] (CPshId's IdC)
--
-- C1 (UTriv => centre and contraction), the base's FibContr.CO at the
-- C-level.  The centre at x is the extension of the empty side; it is
-- natural in C by uniformity, the moved empty side being empty (emp).
-- The contraction is the line field Lf x W z j = the extension of the
-- side {j = 0 |-> c , j = 1 |-> t} (CLocBoundContr.Connect); natural in
-- the base and with ends c[p], q by FibContr.CO at x; natural in C by
-- uniformity, the moved Connect side being the Connect side of the moved
-- point (sdE: same sieve, values by vE); then CPshNF.LineYC.
--
-- C2 (centre and contraction => UTriv, T uniformly fibrant), the base's
-- FibHt.CF at the C-level.  At x: the extension by c relative to the
-- constant map, corrected by T's composition along the homotopy read
-- from the contraction (FibHt.YH, CLocBoundRetr.Correct).  Uniform in C:
-- the homotopy's values move (tC: CPshId.rd-C, ctr natural in C), so the
-- composition problem of Correct moves (wpC its point, sdC its side),
-- then T's UComp, and the reading lemma RdG.rdC.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;
module LB = CLocBoundContr[a, l] ;
module FCo = FibContr[a, l] ;
module HO = PB.CHtpyOps[l] ;
module CL = PB.CLine[l] ;
module LR = CLocBoundRetr[a, l] ;
module FHt = FibHt[a, l] ;

module CtrOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module IDm = CPshId[a, l].IdOf[C] ;
 module NFm = CPshNF[a, l].NFOf[C] ;
 module UUm = CPshPiFibU[a, l].UOf[C] ;
 open P ;

 module C1 (G : CCtx) (T : UF.FCC.STy G) (ut : UTriv G T.1) {
  Tt : CTy[G] = T.1 ;
  module Kx (x : CO) {
   module CT = LB.Contract[G.ob x, Tt.ty x, ut.1 x] ;
   module Cb = FCo.CO[G.ob x, (Tt.ty x, T.2.1 x), ut.1 x] ;
   module PT = CP.Partials[G.ob x, Tt.ty x] ;
   module RC = CP.Rel[G.ob x, Tt.ty x, Tt.ty x, CP.pmap-id (G.ob x) (Tt.ty x)] ;
  } ;
  -- the centre
  emp (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X))
   : Id (Kx[y].PT.Side[X, (G.act y x f).nt X g]) (MapSide[G, Tt, y, x, f].mapside X g (Kx[x].CT.empty X g)) (Kx[y].CT.empty X ((G.act y x f).nt X g)) =
   Kx[y].PT.side-ext X ((G.act y x f).nt X g) (MapSide[G, Tt, y, x, f].mapside X g (Kx[x].CT.empty X g)) (Kx[y].CT.empty X ((G.act y x f).nt X g))
    (refl (PB.emptyS X)) (\ W h i i' -> absurd _ (PB.empty-lands W X h i)) ;
  cnat (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X))
   : Id (SigT (G.ob y) (Tt.ty y) X) ((Tt.tE y x f).nt X (pairE (G.ob x) (Tt.ty x) X g (Kx[x].CT.value X g)))
       (pairE (G.ob y) (Tt.ty y) X ((G.act y x f).nt X g) (Kx[y].CT.value X ((G.act y x f).nt X g))) =
   transH (ut.2 y x f X g (Kx[x].CT.empty X g))
    (apH (\ s -> pairE (G.ob y) (Tt.ty y) X ((G.act y x f).nt X g) ((ut.1 y).kop X ((G.act y x f).nt X g) s)) (emp y x f X g)) ;
  c : CEl[G, Tt] = new CEl[G, Tt, \ x -> Kx[x].CT.centre, cnat] ;

  ------------------------------------------------------------------
  -- the contraction

  GT : CCtx = LO.ExtC G Tt ;
  module SC1 = LO.SC[GT, G, LO.pPC G Tt, Tt] ;
  T1 : CTy[GT] = SC1.subCTy ;
  cp : CEl[GT, T1] = CW.subCEl GT G Tt c (LO.pPC G Tt) ;
  qq : CEl[GT, T1] = CW.qC G Tt ;
  Lf (x : CO) (W : Ob) (z : W0.Ix ((GT.ob x).ob W)) (j : Hom W Iv) : W0.Ix ((T1.ty x).tob W z) = Kx[x].Cb.Lf W z j ;

  -- natural in C
  module UCm (y x : CO) (f : CH y x) (W : Ob) (z : W0.Ix ((GT.ob x).ob W)) (j : Hom W Iv) {
   z' : W0.Ix ((GT.ob y).ob W) = (Tt.tE y x f).nt W z ;
   module Ex = Kx[x].Cb.CN.Ends[W, z, j] ;
   module Ey = Kx[y].Cb.CN.Ends[W, z', j] ;
   pz : Id (W0.Ix ((G.ob y).ob W)) ((G.act y x f).nt W z.1) z'.1 = symH (Tt.tE-pt y x f W z) ;
   ms : Kx[y].PT.Side[W, (G.act y x f).nt W z.1] = MapSide[G, Tt, y, x, f].mapside W z.1 Ex.J.side ;
   -- the values of the two sides, moved
   vE : (n : Nat) -> Id (SigT (G.ob y) (Tt.ty y) W) ((Tt.tE y x f).nt W (Kx[x].Cb.CN.val W z n)) (Kx[y].Cb.CN.val W z' n) = split {
    zero -> transH (cnat y x f W z.1) (apH (\ p -> pairE (G.ob y) (Tt.ty y) W p (Kx[y].CT.value W p)) pz) ;
    suc m -> refl z' } ;
   ev (W' : Ob) (h : Hom W' W) (i : PB.Lands W' W ms.pQ h) (i' : PB.Lands W' W Ey.J.side.pQ h)
    : Id (SigT (G.ob y) (Tt.ty y) W') (ms.pv W' h i) (Ey.J.side.pv W' h i') =
    transH (apH (\ t -> (Tt.tE y x f).nt W' t)
              (Ex.J.pv-in (PB.bigU-out W' W LB.two Ey.J.Qs h i').1 W' h (PB.bigU-out W' W LB.two Ey.J.Qs h i').2 i))
     (transH ((Tt.tE y x f).nt-nat W' W h (Kx[x].Cb.CN.val W z (PB.bigU-out W' W LB.two Ey.J.Qs h i').1.1))
       (transH (apH (\ t -> (extP (G.ob y) (Tt.ty y)).act W' W h t) (vE (PB.bigU-out W' W LB.two Ey.J.Qs h i').1.1))
         (symH (Ey.J.pv-in (PB.bigU-out W' W LB.two Ey.J.Qs h i').1 W' h (PB.bigU-out W' W LB.two Ey.J.Qs h i').2 i')))) ;
   sdE : Id (Kx[y].PT.Side[W, z'.1]) (subst (W0.Ix ((G.ob y).ob W)) (\ t -> Kx[y].PT.Side[W, t]) ((G.act y x f).nt W z.1) z'.1 pz ms) Ey.J.side =
    Kx[y].PT.side-extH W ((G.act y x f).nt W z.1) z'.1 pz ms Ey.J.side (refl Ex.J.side.pQ) ev ;
   valC : Id (SigT (G.ob y) (Tt.ty y) W) ((Tt.tE y x f).nt W Ex.value) Ey.value =
    transH (ut.2 y x f W z.1 Ex.J.side)
     (Kx[y].RC.kop-cong (ut.1 y) W ((G.act y x f).nt W z.1) z'.1 pz ms Ey.J.side sdE) ;
   res : Id (SigT (GT.ob y) (T1.ty y) W) ((T1.tE y x f).nt W (pairE (GT.ob x) (T1.ty x) W z (Lf x W z j)))
          (pairE (GT.ob y) (T1.ty y) W z' (Lf y W z' j)) =
    SC1.sub-eq y W ((T1.tE y x f).nt W (pairE (GT.ob x) (T1.ty x) W z (Lf x W z j))) (pairE (GT.ob y) (T1.ty y) W z' (Lf y W z' j))
     (refl z') (transH (SC1.rBtE y x f W (pairE (GT.ob x) (T1.ty x) W z (Lf x W z j))) valC) ;
  } ;
  module LY = NFm.LineYC[GT, T1, cp, qq, Lf,
    \ x -> Kx[x].Cb.Unat, \ x -> Kx[x].Cb.U0, \ x -> Kx[x].Cb.U1,
    \ y x f W z j -> UCm[y, x, f, W, z, j].res] ;
  ctr : CEl[GT, IDm.IdC[GT, T1, cp, qq].IdT] = LY.el ;
 } ;

 module C2 (G : CCtx) (T : UF.FCC.STy G) (c : CEl[G, T.1])
  (ctr : CEl[LO.ExtC G T.1, IDm.IdC[LO.ExtC G T.1, LO.subCTy (LO.ExtC G T.1) G (LO.pPC G T.1) T.1,
                                    CW.subCEl (LO.ExtC G T.1) G T.1 c (LO.pPC G T.1), CW.qC G T.1].IdT]) {
  Tt : CTy[G] = T.1 ;
  GT : CCtx = LO.ExtC G Tt ;
  module SC1 = LO.SC[GT, G, LO.pPC G Tt, Tt] ;
  T1 : CTy[GT] = SC1.subCTy ;
  cp : CEl[GT, T1] = CW.subCEl GT G Tt c (LO.pPC G Tt) ;
  qq : CEl[GT, T1] = CW.qC G Tt ;
  module IC = IDm.IdC[GT, T1, cp, qq] ;

  module Kx (x : CO) {
   module TTx = GPR.TyL[G.ob x, Tt.ty x] ;
   cst : HO.NMap[G.ob x, Tt.ty x, Tt.ty x] = LB.constant (G.ob x) (Tt.ty x) (c.el x) ;
   cE-act (Y X : Ob) (h : Hom Y X) (p : TTx.Pt X)
    : Id (TTx.EI Y) (TTx.E.act Y X h (TTx.pr X p ((c.el x).eob X p))) (TTx.pr Y ((G.ob x).act Y X h p) ((c.el x).eob Y ((G.ob x).act Y X h p))) =
    transH (TTx.pr-tact Y X h p ((G.ob x).act Y X h p) (refl ((G.ob x).act Y X h p)) ((c.el x).eob X p))
     (apH (\ v -> TTx.pr Y ((G.ob x).act Y X h p) v) ((c.el x).enat Y X h p ((G.ob x).act Y X h p) (refl ((G.ob x).act Y X h p)))) ;
   module R = CP.Rel[G.ob x, Tt.ty x, Tt.ty x, LR.Map[G.ob x, Tt.ty x, Tt.ty x, cst].pmap] ;
   kR : R.RC = new R.RC[
     \ X p s -> (c.el x).eob X p,
     \ X p s Y h i -> transH (cE-act Y X h p) (apH (\ p1 -> TTx.pr Y p1 ((c.el x).eob Y p1)) (symH (s.ppt Y h i))),
     \ Y X h p s -> cE-act Y X h p] ;
   module Yh = FHt.YH[G.ob x, Tt.ty x, Tt.ty x, cst, HO.idN (G.ob x) (Tt.ty x), cp.el x, qq.el x,
     \ X z -> refl ((c.el x).eob X (fstE (G.ob x) (Tt.ty x) X z)), \ X z -> refl (sndE (G.ob x) (Tt.ty x) X z), ctr.el x] ;
   module Cr = LR.Correct[G.ob x, Tt.ty x, cst, kR, Yh.H, (T.2.1 x).1] ;
   kop : CP.ContrOp (G.ob x) (Tt.ty x) = Cr.extension ;
   module PT = CP.Partials[G.ob x, Tt.ty x] ;
  } ;

  -- the values of the homotopy move
  tC (y x : CO) (f : CH y x) (Z : Ob) (z : W0.Ix ((GT.ob x).ob Z)) (V1 : Ob) (g' : Hom V1 Z) (j : Hom V1 Iv)
   : Id (SigT (G.ob y) (Tt.ty y) V1) ((Tt.tE y x f).nt V1 (Kx[x].Yh.t Z z V1 g' j)) (Kx[y].Yh.t Z ((Tt.tE y x f).nt Z z) V1 g' j) =
   transH (symH (SC1.rBtE y x f V1 (Kx[x].Yh.Y.rd Z z ((ctr.el x).eob Z z) V1 g' j)))
    (transH (apH (\ t -> SC1.rB y V1 t) (symH (IC.rd-C y x f Z z ((ctr.el x).eob Z z) V1 g' j)))
      (apH (\ w -> SC1.rB y V1 (Kx[y].Yh.Y.rd Z ((Tt.tE y x f).nt Z z) w V1 g' j))
        (GPR.TyL[GT.ob y, IC.ty y].pr-inj Z ((Tt.tE y x f).nt Z z) (IC.TC[y, x, f, Z, z, (ctr.el x).eob Z z].res) ((ctr.el y).eob Z ((Tt.tE y x f).nt Z z))
           (ctr.el-nat y x f Z z)))) ;

  module SFt = LO.SF[G, Tt, PB.e0] ;
  module Um (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (s : Kx[x].PT.Side[X, g]) {
   gy : W0.Ix ((G.ob y).ob X) = (G.act y x f).nt X g ;
   ms : Kx[y].PT.Side[X, gy] = MapSide[G, Tt, y, x, f].mapside X g s ;
   module Px = Kx[x].Cr.Problem[X, g, s] ;
   module Py = Kx[y].Cr.Problem[X, gy, ms] ;
   tv (W : Ob) (u : Kx[x].Cr.EK.TV.EI W) : Kx[y].Cr.EK.TV.EI W = SFt.AE'.tEv y x f W u ;
   wpC : Id (Kx[y].Cr.EK.TV.EI X) (tv X Px.w) Py.w =
    Kx[y].Cr.EK.tv-eq X (tv X Px.w) Py.w
     (CL.FC[G.ob y].fam-eq X (Kx[y].Cr.EK.TV.pr1 X (tv X Px.w)) (Kx[y].Cr.EK.TV.pr1 X Py.w) (\ Z k j -> (G.act y x f).nt-nat Z X k g))
     (transH (SFt.AE'.endEv y x f X Px.w)
       (transH (apH (\ t -> (Tt.tE y x f).nt X t) Px.w-E)
         (transH (c.el-nat y x f X g) (symH Py.w-E)))) ;
   msL : Kx[y].Cr.EK.PT.Side[X, tv X Px.w] = MapSide[SFt.TVC, SFt.SFC, y, x, f].mapside X Px.w Px.LS.side ;
   module Sv (Y : Ob) (k : Hom Y X) (i i' : PB.Lands Y X s.pQ k) {
    ptS : Id (Kx[y].Cr.EK.TV.EI Y) (Kx[y].Cr.EK.TS.pr1 Y (SFt.tES y x f Y (Px.LS.sv Y k i))) (Kx[y].Cr.EK.TS.pr1 Y (Py.LS.sv Y k i')) =
     transH (apH (\ t -> tv Y t) (Px.LS.sv-pt Y k i))
      (transH ((SFt.AE'.tEvP y x f).nt-nat Y X k Px.w)
        (transH (apH (\ t -> Kx[y].Cr.EK.TV.E.act Y X k t) wpC) (symH (Py.LS.sv-pt Y k i')))) ;
    lvS (V1 : Ob) (g' : Hom V1 Y) (r : Hom V1 Iv)
     : Id (SigT (G.ob y) (Tt.ty y) V1) (Kx[y].Cr.EK.lv Y (SFt.tES y x f Y (Px.LS.sv Y k i)) V1 g' r) (Kx[y].Cr.EK.lv Y (Py.LS.sv Y k i') V1 g' r) =
     transH (apH (\ t -> (Tt.tE y x f).nt V1 t) (Px.LS.sv-val Y k i V1 g' r))
      (transH (tC y x f Y (s.pv Y k i) V1 g' r)
        (transH (apH (\ t -> Kx[y].Yh.t Y ((Tt.tE y x f).nt Y t) V1 g' r) (Kx[x].PT.pv-irr X g s Y k i i'))
          (symH (Py.LS.sv-val Y k i' V1 g' r)))) ;
    res : Id (Kx[y].Cr.EK.TS.EI Y) (SFt.tES y x f Y (Px.LS.sv Y k i)) (Py.LS.sv Y k i') =
     Kx[y].Cr.EK.ts-ext Y (SFt.tES y x f Y (Px.LS.sv Y k i)) (Py.LS.sv Y k i') ptS lvS ;
   } ;
   sdC : Id (Kx[y].Cr.EK.PT.Side[X, Py.w]) (subst (Kx[y].Cr.EK.TV.EI X) (\ t -> Kx[y].Cr.EK.PT.Side[X, t]) (tv X Px.w) Py.w wpC msL) Py.LS.side =
    Kx[y].Cr.EK.PT.side-extH X (tv X Px.w) Py.w wpC msL Py.LS.side (refl s.pQ) (\ Y k i i' -> Sv[Y, k, i, i'].res) ;
   outC : Id (Kx[y].Cr.TT.EI X) (UUm.RdG[G, Tt, PB.e0, PB.e1, y, x, f].SCt.tEs y x f X Px.out) Py.out =
    transH (T.2.2.1 y x f X Px.w Px.LS.side)
     (Kx[y].Cr.RC.kop-cong (T.2.1 y).1 X (tv X Px.w) Py.w wpC msL Py.LS.side sdC) ;
   res : Id (SigT (G.ob y) (Tt.ty y) X) ((Tt.tE y x f).nt X (pairE (G.ob x) (Tt.ty x) X g (Kx[x].kop.kop X g s)))
          (pairE (G.ob y) (Tt.ty y) X gy (Kx[y].kop.kop X gy ms)) =
    transH (apH (\ t -> (Tt.tE y x f).nt X t) (Kx[x].Cr.kop-E X g s))
     (transH (symH (UUm.RdG[G, Tt, PB.e0, PB.e1, y, x, f].rdC X Px.out))
       (transH (apH (\ t -> Kx[y].Cr.rd X t) outC) (symH (Kx[y].Cr.kop-E X gy ms)))) ;
  } ;
  ut : UTriv G Tt = (\ x -> Kx[x].kop, \ y x f X g s -> Um[y, x, f, X, g, s].res) ;
 } ;
} ;
