-- The relative finite-ideal certificate as an actual type over G.
-- Its witness is a cofactor vector in the Sigma extension, followed
-- by an internal identity x = y + sum f_i c_i in that same context.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Ring[a++] ;
module FT = CFinIntTy[a] ;

module Certificate (G : FT.C.Ctx) (Rg : FT.PR.HRing[G])
 (fs : List (FT.C.El G Rg.R))
 (x y : FT.C.El G Rg.R) {
 C : CwF.CwF[a++] = FT.C ;
 module CO = FT.Cofactor[G, Rg] ;
 K : C.Ctx = CO.Ctx fs ;
 p : C.Sub K G = C.p G (CO.CofT fs) ;
 A : C.Ty K = C.subT K G Rg.R p ;
 q : C.El K (C.subT K G (CO.CofT fs) p) = C.q G (CO.CofT fs) ;
 L : C.El K A = CFinIntEval[a].Eval[G, Rg].lin fs K p q ;
 module P = CFinIntPull[a].Pull[G, K, Rg, p] ;
 rhs : C.El K A = P.ap2 P.add (C.subt K G Rg.R y p) L ;
 Eq : C.Ty K = FT.PR.IJ.IdT K A (C.subt K G Rg.R x p) rhs ;
 CertT : C.Ty G = FT.SS.Sig G (CO.CofT fs) Eq ;
} ;
