-- CTotL12f.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part f: values from a family of levelwise
-- sides (KS: naturality from al's uniformity, extension from al's law on
-- a full sieve) and level 0 (piece 0 alone).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module L12f (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LE = CTotL12e[a, vl, l].L12e[C, G, A] ;
 module LD = LE.LD ;
 module LC = LE.LC ;
 module LB = LE.LB ;
 module LA = LE.LA ;
 module TR = LA.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LB.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 UG : TR.P0.PCtx = LB.UG ;
 UA : TR.P0.PTy[UG] = LB.UA ;
 Ob0 : U vl = TR.RN.Ob0 ;
 E0 : TR.P0.PCtx = TR.P0.extP UG UA ;
 module RL = G0.GB.CPartial[l].Rel[UG, UA, UA, G0.GB.CPartial[l].pmap-id UG UA] ;
 -- the image of a canonical levelwise map is the cartesian lift
 fnCart (J' J : Ob) (h : Hom J' J) (z : Obj J)
  : Id (TC.THm (J', C.res J' J h z) (J, z)) (TR.fn.onH (J', C.res J' J h z) (J, z) (h, refl (C.res J' J h z))) (h, C.cart J' J h z) =
  refl (h, C.cart J' J h z) ;

 module Ff (al : G0.GB.CPartial[l].ContrOp UG UA) (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FE = LE.Fe[X, gm, s] ;
  module FD = FE.FD ;
  module FC = FE.FC ;
  module FB = FE.FB ;
  module F = FE.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  module KS (n : Nat) (S : (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch n J u z) (i : Wt.Pn n J) -> Py.Side[(J, z), F.gpt n J u z c i]) {
   v : F.Vt n = \ J u z c i -> al.kop (J, z) (F.gpt n J u z c i) (S J u z c i) ;
   module P1 (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch n J u z) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J)
     (coh : Id (Py.Side[(J', C.res J' J h z), F.gpt n J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res)])
              (subst (W0.Ix (G.ob J' (C.res J' J h z))) (\ p -> Py.Side[(J', C.res J' J h z), p])
                 (UG.act (J', C.res J' J h z) (J, z) (h, refl (C.res J' J h z)) (F.gpt n J u z c i))
                 (F.gpt n J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res))
                 (gm.2.1 ((n, J, u, z, c, i.1), (J', h)) i.2)
                 (Py.rside (J', C.res J' J h z) (J, z) (h, refl (C.res J' J h z)) (F.gpt n J u z c i) (S J u z c i)))
              (S J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res))) {
    Y : Ob0 = (J, z) ;
    Y' : Ob0 = (J', C.res J' J h z) ;
    hh : TR.RN.Hom0 Y' Y = (h, refl (C.res J' J h z)) ;
    gp : W0.Ix (G.ob J z) = F.gpt n J u z c i ;
    gp' : W0.Ix (G.ob J' (C.res J' J h z)) = F.gpt n J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res) ;
    law : Id (DA.Ez J' (C.res J' J h z)) (DA.E.act Y' Y (h, C.cart J' J h z) (F.pzv n v J u z c i))
            (F.pzv n v J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res)) =
     transH (al.kunif Y' Y hh gp (S J u z c i))
      (RL.kop-cong al Y' (UG.act Y' Y hh gp) gp' (gm.2.1 ((n, J, u, z, c, i.1), (J', h)) i.2)
         (Py.rside Y' Y hh gp (S J u z c i))
         (S J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res)) coh) ;
   } ;
   p1 (coh : (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch n J u z) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J)
     -> Id (Py.Side[(J', C.res J' J h z), F.gpt n J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res)])
              (subst (W0.Ix (G.ob J' (C.res J' J h z))) (\ p -> Py.Side[(J', C.res J' J h z), p])
                 (UG.act (J', C.res J' J h z) (J, z) (h, refl (C.res J' J h z)) (F.gpt n J u z c i))
                 (F.gpt n J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res))
                 (gm.2.1 ((n, J, u, z, c, i.1), (J', h)) i.2)
                 (Py.rside (J', C.res J' J h z) (J, z) (h, refl (C.res J' J h z)) (F.gpt n J u z c i) (S J u z c i)))
              (S J' (compH J' J I u h) (C.res J' J h z) (DO.rCh J' J I h u x n z c) (Wt.Res[n, J', J, h, i].res)))
    : F.P1t n v = \ J u z c i J' h -> P1[J, u, z, c, i, J', h, coh J u z c i J' h].law ;
   -- extension: at an index moved along f, the side's value at the identity
   p2 (lidS : (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) (J : Ob) (u' : Hom J W.1) (z : Obj J)
        (c' : CT.Ch J n (C.res J W.1 u' W.2) z) (i : Wt.Pn n J)
        -> G0.GB.Lands (J, z) (J, z) (S J (compH J W.1 I f.1 u') z FE.Ext[W, f, lf, n, J, u', z, c', i].cc i).pQ (G0.GB.BC.idC (J, z)))
      (extS : (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) (J : Ob) (u' : Hom J W.1) (z : Obj J)
        (c' : CT.Ch J n (C.res J W.1 u' W.2) z) (i : Wt.Pn n J)
        -> Id (DA.Ez J z) ((S J (compH J W.1 I f.1 u') z FE.Ext[W, f, lf, n, J, u', z, c', i].cc i).pv (J, z) (G0.GB.BC.idC (J, z)) (lidS W f lf J u' z c' i))
             (F.rd W f lf (n, J, u', z, c', i.1) i.2))
    : F.P2t n v = \ W f lf J u' z c' i ->
    transH (RL.kfull al (J, z) (F.gpt n J (compH J W.1 I f.1 u') z FE.Ext[W, f, lf, n, J, u', z, c', i].cc i)
              (S J (compH J W.1 I f.1 u') z FE.Ext[W, f, lf, n, J, u', z, c', i].cc i) (lidS W f lf J u' z c' i))
     (extS W f lf J u' z c' i) ;
  } ;

  -- level 0: piece 0 alone
  S0 (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch zero J u z) (i : Wt.Pn zero J) : Py.Side[(J, z), F.gpt zero J u z c i] =
   FC.Q0[zero, J, u, z, c, i].side ;
  module K0 = KS[zero, S0] ;
  lid (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) (J : Ob) (u' : Hom J W.1) (n : Nat)
   : PB.Lands J J (PB.pre J I (compH J W.1 I f.1 u') s.pQ) (idH J) =
   PB.pre-lands J J I (compH J W.1 I f.1 u') s.pQ (idH J)
    (PB.lands-eq J I s.pQ (compH J W.1 I f.1 u') (compH J J I (compH J W.1 I f.1 u') (idH J))
       (symH (comp-idr J I (compH J W.1 I f.1 u'))) (PB.lands-comp J W.1 I s.pQ f.1 u' lf)) ;
  ext0 (n : Nat) (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) (J : Ob) (u' : Hom J W.1) (z : Obj J)
   (c' : CT.Ch J n (C.res J W.1 u' W.2) z) (i : Wt.Pn n J)
   : Id (DA.Ez J z)
       (FC.Q0[n, J, compH J W.1 I f.1 u', z, FE.Ext[W, f, lf, n, J, u', z, c', i].cc, i].pv (J, z) (G0.GB.BC.idC (J, z)) (lid W f lf J u' n))
       (F.rd W f lf (n, J, u', z, c', i.1) i.2) =
   transH (FE.IdV[n, J, compH J W.1 I f.1 u', z, FE.Ext[W, f, lf, n, J, u', z, c', i].cc, FE.Ext[W, f, lf, n, J, u', z, c', i].lU, i,
                  symH (G0.GB.BC.idC (J, z)).2, lid W f lf J u' n].idv)
    FE.Ext[W, f, lf, n, J, u', z, c', i].ext ;
  lev0 : F.Up zero =
   (K0.v,
    K0.p1 (\ J u z c i J' h -> FD.Coh[zero, J, u, z, c, i, J', h].coh),
    K0.p2 (\ W f lf J u' z c' i -> lid W f lf J u' zero) (\ W f lf J u' z c' i -> ext0 zero W f lf J u' z c' i)) ;
 } ;
} ;
