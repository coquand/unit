-- CTotL12k.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part k: the pieces of level m+1 joined.
--   PNg       CTotL12g's naturality with the tail of the chain moved
--   FCoh      the face piece under restriction along a base map
--   PC.JN     the Join of piece 0 and the face pieces 0 .. m+1 (their
--             compatibility from parts i and j)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;
module Ar = Arith[a] ;

module L12k (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LJ = CTotL12j[a, vl, l].L12j[C, G, A] ;
 module LI = CTotL12i[a, vl, l].L12i[C, G, A] ;
 module LH = LJ.LH ;
 module LC = LI.LC ;
 module LA = LH.LA ;
 module CL = LH.CL ;
 module TR = LA.TR ;
 module G0 = TR.G0 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LH.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;
 UG : TR.P0.PCtx = LH.LB.UG ;
 UA : TR.P0.PTy[UG] = LH.LB.UA ;

 module Fk (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FJ = LJ.Fj[X, gm, s] ;
  module FI = LI.Fi[X, gm, s] ;
  module FH = FJ.FH ;
  module FG = FH.FG ;
  module FC = FI.FC ;
  module F = FH.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  PNg (m : Nat) (p : F.Up m) (k : Nat) (W1 : Ob) (U0 : Hom W1 I) (t : Obj W1) (cc : CT.Ch W1 (suc m) (C.res W1 I U0 x) t) (pw : Wt.Pn m W1)
   (W2 : Ob) (w : Hom W2 W1) (y2 : Obj W2) (e2 : Id (Obj W2) (C.res W2 W1 w t) y2)
   : Id (DA.Ez W2 y2)
       (DA.E.act (W2, y2) (W1, t) (w, VT.trD W2 W1 w (C.res W2 W1 w t) y2 e2 t (C.cart W2 W1 w t)) (FG.Ph[m, p, k].phi W1 U0 t cc pw))
       (FG.Ph[m, p, k].phi W2 (compH W2 W1 I U0 w) y2
          (subst (Obj W2) (\ t2 -> CT.Ch W2 (suc m) (C.res W2 I (compH W2 W1 I U0 w) x) t2) (C.res W2 W1 w t) y2 e2 (DO.rCh W2 W1 I w U0 x (suc m) t cc))
          (Wt.Res[m, W2, W1, w, pw].res)) =
   idJ (Obj W2) (C.res W2 W1 w t)
    (\ y3 e3 -> Id (DA.Ez W2 y3)
       (DA.E.act (W2, y3) (W1, t) (w, VT.trD W2 W1 w (C.res W2 W1 w t) y3 e3 t (C.cart W2 W1 w t)) (FG.Ph[m, p, k].phi W1 U0 t cc pw))
       (FG.Ph[m, p, k].phi W2 (compH W2 W1 I U0 w) y3
          (subst (Obj W2) (\ t2 -> CT.Ch W2 (suc m) (C.res W2 I (compH W2 W1 I U0 w) x) t2) (C.res W2 W1 w t) y3 e3 (DO.rCh W2 W1 I w U0 x (suc m) t cc))
          (Wt.Res[m, W2, W1, w, pw].res)))
    FG.Ph[m, p, k].PN[W1, U0, t, cc, pw, W2, w].law y2 e2 ;

  -- the face piece under restriction along a base map h
  module FCoh (m : Nat) (p : F.Up m) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn (suc m) J)
    (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (J' : Ob) (h : Hom J' J) {
   module Fq = FH.FP[m, p, J, u, z, c, i, k, hk] ;
   uh : Hom J' I = compH J' J I u h ;
   rzh : Obj J' = C.res J' J h z ;
   c' : F.Ch (suc m) J' uh rzh = DO.rCh J' J I h u x (suc m) z c ;
   i' : Wt.Pn (suc m) J' = Wt.Res[suc m, J', J, h, i].res ;
   module Fq' = FH.FP[m, p, J', uh, rzh, c', i', k, hk] ;
   module EV (W1 : Ob) (f1 : Hom W1 J') (la : PB.Lands W1 J Fq.Q (compH W1 J' J h f1)) (lb : PB.Lands W1 J' Fq'.Q f1) {
    T0 : Obj W1 = C.res W1 J' f1 rzh ;
    hf : Hom W1 J = compH W1 J' J h f1 ;
    module R2 = CL.RC2[W1, J', J, I, f1, h, u, x, suc m, z, c] ;
    SP (eT : Id (Obj W1) (C.res W1 J hf z) T0)
     : Id (D.S I x (suc m) W1 T0) (compH W1 J' I uh f1, DO.rCh W1 J' I f1 uh x (suc m) rzh c') (compH W1 J I u hf, Fq.chT W1 hf T0 eT) =
     D.sEq I x (suc m) W1 T0 (compH W1 J' I uh f1) (compH W1 J I u hf) (comp-assoc W1 J' J I u h f1)
      (DO.rCh W1 J' I f1 uh x (suc m) rzh c') (Fq.chT W1 hf T0 eT)
      (transH R2.law
         (apH {Id (Obj W1) (C.res W1 J hf z) T0} {CT.Ch W1 (suc m) (C.res W1 I (compH W1 J I u hf) x) T0} (\ e -> Fq.chT W1 hf T0 e)
            (CT.setObj W1 (C.res W1 J hf z) T0 R2.et eT))) ;
    wP : Id (Wt.Pn m W1) (Fq'.pw W1 f1 lb) (Fq.pw W1 hf la) =
     Sigma-eq (Wt.Coords m W1) (\ cs -> PB.Lands W1 W1 (Wt.oneS m W1 cs) (PB.idH W1))
      (Fq'.pw W1 f1 lb).1 (Fq.pw W1 hf la).1 (Fq'.pw W1 f1 lb).2 (Fq.pw W1 hf la).2
      (funext (Ar.Fin (suc m)) (\ j -> Hom W1 PFO.ivO) (Fq'.pw W1 f1 lb).1 (Fq.pw W1 hf la).1
         (\ j -> PB.comp-assoc W1 J' J PFO.ivO (i.1 (Wt.Face[m, W1, k, hk].skipF j)) h f1))
      (PB.isProp-Lands W1 W1 (Wt.oneS m W1 (Fq.pw W1 hf la).1) (PB.idH W1)) ;
    base (eT : Id (Obj W1) (C.res W1 J hf z) T0) : Id (DA.Ez W1 T0) (Fq.vg W1 hf T0 eT la) (Fq'.vg W1 f1 T0 (refl T0) lb) =
     symH (transH (apH {D.S I x (suc m) W1 T0} {DA.Ez W1 T0} (\ sw -> Fq.PH.phi W1 sw.1 T0 sw.2 (Fq'.pw W1 f1 lb)) (SP eT))
             (apH {Wt.Pn m W1} {DA.Ez W1 T0} (\ q -> Fq.PH.phi W1 (compH W1 J I u hf) T0 (Fq.chT W1 hf T0 eT) q) wP)) ;
    evg (y : Obj W1) (e' : Id (Obj W1) T0 y) (eT : Id (Obj W1) (C.res W1 J hf z) y)
     : Id (DA.Ez W1 y) (Fq.vg W1 hf y eT la) (Fq'.vg W1 f1 y e' lb) =
     idJ (Obj W1) T0
      (\ y2 e2 -> (eT2 : Id (Obj W1) (C.res W1 J hf z) y2) -> Id (DA.Ez W1 y2) (Fq.vg W1 hf y2 eT2 la) (Fq'.vg W1 f1 y2 e2 lb))
      base y e' eT ;
   } ;
  } ;

  ----------------------------------------------------------------
  -- the pieces of level m+1 and their Join
  module PC (m : Nat) (p : F.Up m) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn (suc m) J) {
   module Q0 = FC.Q0[suc m, J, u, z, c, i] ;
   Y : Ob0 = (J, z) ;
   gp : W0.Ix (G.ob J z) = F.gpt (suc m) J u z c i ;
   Sj : (j : Nat) -> Tr.IsT (Ar.ltb j (suc (suc (suc m)))) -> Py.Side[Y, gp] = split {
    zero -> \ hh -> Q0.side ;
    suc k -> \ hh -> FH.FP[m, p, J, u, z, c, i, k, hh].side } ;
   sameK (k : Nat) (hk h2 : Tr.IsT (Tr.leb k (suc m))) (W : Ob0) (f : TR.RN.Hom0 W Y)
    (lw : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k, hk].Q) f.1) (l2 : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k, h2].Q) f.1)
    : Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k, h2].pv W f l2) =
    idJ (Tr.IsT (Tr.leb k (suc m))) hk
     (\ h3 e3 -> (l3 : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k, h3].Q) f.1)
        -> Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k, h3].pv W f l3))
     (\ l3 -> Py.pv-irr Y gp (FH.FP[m, p, J, u, z, c, i, k, hk].side) W f lw l3)
     h2 (Ar.isProp-IsT' (Tr.leb k (suc m)) hk h2) l2 ;
   eqK (k k' : Nat) (e : Id Nat k k') (hk : Tr.IsT (Tr.leb k (suc m))) (hk' : Tr.IsT (Tr.leb k' (suc m))) (W : Ob0) (f : TR.RN.Hom0 W Y)
    (lw : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k, hk].Q) f.1) (lw' : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k', hk'].Q) f.1)
    : Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k', hk'].pv W f lw') =
    idJ Nat k
     (\ k2 e2 -> (h2 : Tr.IsT (Tr.leb k2 (suc m))) (l2 : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k2, h2].Q) f.1)
        -> Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k2, h2].pv W f l2))
     (\ h2 l2 -> sameK k hk h2 W f lw l2) k' e hk' lw' ;
   ltA : (k' k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (hk' : Tr.IsT (Tr.leb k' (suc m))) (lt : Tr.IsT (Ar.ltb k k')) (W : Ob0) (f : TR.RN.Hom0 W Y)
    (lw : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k, hk].Q) f.1) (lw' : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k', hk'].Q) f.1)
    -> Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k', hk'].pv W f lw') = split {
    zero -> \ k hk hk' lt W f lw lw' -> absurd _ (Tr.false-true lt) ;
    suc k1 -> \ k hk hk' lt W f lw lw' -> FJ.ffP m p J u z c i k k1 hk hk' lt W.1 f.1 W.2 (symH f.2) lw lw' } ;
   ffd (k k' : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (hk' : Tr.IsT (Tr.leb k' (suc m))) (W : Ob0) (f : TR.RN.Hom0 W Y)
    (lw : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k, hk].Q) f.1) (lw' : PB.Lands W.1 J (FH.FP[m, p, J, u, z, c, i, k', hk'].Q) f.1)
    : Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k', hk'].pv W f lw') =
    Arith[l].eqN-dec (Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k', hk'].pv W f lw')) k k'
     (\ e -> eqK k k' e hk hk' W f lw lw')
     (\ ne -> Arith[l].ltb-dec (Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k', hk'].pv W f lw')) k k'
        (\ lt -> ltA k' k hk hk' lt W f lw lw')
        (\ le -> Arith[l].eqN-dec (Id (DA.Ez W.1 W.2) (FH.FP[m, p, J, u, z, c, i, k, hk].pv W f lw) (FH.FP[m, p, J, u, z, c, i, k', hk'].pv W f lw')) k' k
           (\ e' -> eqK k k' (sym Nat k' k e') hk hk' W f lw lw')
           (\ ne' -> symH (ltA k k' hk' hk (Ar.leb-neq k' k le ne') W f lw' lw)))) ;
   cmp : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) (j' : Nat) (hj' : Tr.IsT (Ar.ltb j' (suc (suc (suc m))))) (W : Ob0) (f : TR.RN.Hom0 W Y)
    (lw : PB.Lands W.1 J (Sj j hj).pQ f.1) (lw' : PB.Lands W.1 J (Sj j' hj').pQ f.1)
    -> Id (DA.Ez W.1 W.2) ((Sj j hj).pv W f lw) ((Sj j' hj').pv W f lw') = split {
    zero -> \ hj -> split {
     zero -> \ hj' W f lw lw' -> Py.pv-irr Y gp Q0.side W f lw lw' ;
     suc k' -> \ hj' W f lw lw' -> FI.QF[m, p, J, u, z, c, i, k', hj'].qf W f lw lw' } ;
    suc k -> \ hj -> split {
     zero -> \ hj' W f lw lw' -> symH (FI.QF[m, p, J, u, z, c, i, k, hj].qf W f lw' lw) ;
     suc k' -> \ hj' W f lw lw' -> ffd k k' hj hj' W f lw lw' } } ;
   module JN = G0.GB.CPartial[l].Join[UG, UA, Y, gp, suc (suc (suc m)), \ j -> Sj j.1 j.2,
     \ j j' W f lw lw' -> cmp j.1 j.2 j'.1 j'.2 W f lw lw'] ;
  } ;
 } ;
} ;
