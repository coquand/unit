-- CRetSet.seg (canonicity-c2; for (d)): a closed type T with natural maps
-- s : T -> T' and r : T' -> T, r (s t) = t pointwise, and T' a set, is a set:
-- Hedberg (CwFHed6) at nil.T with R(x, y) = Id_T' (s x, s y), a proposition
-- by T''s set-ness; rho by rfl; f by r applied to the Id (CCmpK3.ApN) and the
-- pointwise retraction. No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;

module HO = PosFull[a].PB.CHtpyOps[a+] ;
module RetSet (T T' : C.Ty C.nil) (sT' : CQCtx[a].G3Of[T'].SetQiTy) (sN : HO.NMap[C.nil, T.1, T'.1]) (rN : HO.NMap[C.nil, T'.1, T.1])
  (rs : (K : Ob) (o : Top) (t : V1.Ix (T.1.tob K o)) -> Id (V1.Ix (T.1.tob K o)) (rN.nfun K o (sN.nfun K o t)) t) {
 Nl : C.Ctx = C.nil ;
 module GA = CQCtx[a].G3Of[T'] ;
 module GS = CQCtx[a].G3Of[T] ;
 module EX = CQSurj[a].Ex[C] ;
 clT (D : C.Ctx) (X : C.Ty Nl) (s1 s2 : C.Sub D Nl) : Id (C.Ty D) (C.subT D Nl X s1) (C.subT D Nl X s2) =
  apH {C.Sub D Nl} {C.Ty D} (\ s -> C.subT D Nl X s) (transH (C.eps-uniq D s1) (symH (C.eps-uniq D s2))) ;
 G2 : C.Ctx = GS.G2 ;
 -- the two variables of nil.T.T as elements of T[eps], and their images
 p21 : C.Sub G2 Nl = C.o G2 GS.G1 Nl (C.p Nl T) (C.p GS.G1 GS.Qw) ;
 P1 : Id (C.Ty G2) GS.Qw2 (C.subT G2 Nl T (C.eps G2)) =
  transH (apH {C.Ty GS.G1} {C.Ty G2} (\ X -> C.subT G2 GS.G1 X (C.p GS.G1 GS.Qw)) (refl GS.Qw))
   (transH (symH (C.subT-o G2 GS.G1 Nl T (C.p Nl T) (C.p GS.G1 GS.Qw))) (clT G2 T p21 (C.eps G2))) ;
 xa : C.El G2 (C.subT G2 Nl T (C.eps G2)) = OV.trE G2 GS.Qw2 (C.subT G2 Nl T (C.eps G2)) P1 GS.v1 ;
 xb : C.El G2 (C.subT G2 Nl T (C.eps G2)) = OV.trE G2 GS.Qw2 (C.subT G2 Nl T (C.eps G2)) P1 GS.v2 ;
 module IS = CInjP[a].IP[T, T', sN] ;
 ya : C.El G2 (C.subT G2 Nl T' (C.eps G2)) = IS.evS G2 (C.eps G2) xa ;
 yb : C.El G2 (C.subT G2 Nl T' (C.eps G2)) = IS.evS G2 (C.eps G2) xb ;
 sa : C.Sub G2 GA.G1 = EX.exS G2 Nl T' (C.eps G2) ya ;
 PB : Id (C.Ty G2) (C.subT G2 Nl T' (C.eps G2)) (C.subT G2 GA.G1 GA.Qw sa) =
  transH (clT G2 T' (C.eps G2) (C.o G2 GA.G1 Nl (C.p Nl T') sa)) (C.subT-o G2 GA.G1 Nl T' (C.p Nl T') sa) ;
 sg : C.Sub G2 GA.G2 = EX.exS G2 GA.G1 GA.Qw sa (OV.trE G2 (C.subT G2 Nl T' (C.eps G2)) (C.subT G2 GA.G1 GA.Qw sa) PB yb) ;
 IA : C.Ty GA.G2 = IJ.IdT GA.G2 GA.Qw2 GA.v1 GA.v2 ;
 R : C.Ty G2 = C.subT G2 GA.G2 IA sg ;
 pR : C.El G2 (PU.isProp G2 R) =
  OV.trE G2 (C.subT G2 GA.G2 (PU.isProp GA.G2 IA) sg) (PU.isProp G2 R) (PU.isProp-ov G2 GA.G2 IA sg R (refl R))
    (C.subt G2 GA.G2 (PU.isProp GA.G2 IA) (GA.setV2 sT') sg) ;
 -- readings of the two variables and their images
 TK (K : Ob) (w : V1.Ix (G2.ob K)) : U a+ = V1.Ix ((C.subT G2 Nl T (C.eps G2)).1.tob K w) ;
 xar (K : Ob) (x y : V1.Ix (T.1.tob K tt)) : Id (TK K ((tt, x), y)) (xa.eob K ((tt, x), y)) x =
  transH (CAppRd[a].trE-rd G2 GS.Qw2 (C.subT G2 Nl T (C.eps G2)) P1 GS.v1 K ((tt, x), y)) (CAppRd[a].same-rd G2 GS.Qw2 (C.subT G2 Nl T (C.eps G2)) P1 K ((tt, x), y) (refl (GS.Qw2.1.tob K ((tt, x), y))) x) ;
 xbr (K : Ob) (x y : V1.Ix (T.1.tob K tt)) : Id (TK K ((tt, x), y)) (xb.eob K ((tt, x), y)) y =
  transH (CAppRd[a].trE-rd G2 GS.Qw2 (C.subT G2 Nl T (C.eps G2)) P1 GS.v2 K ((tt, x), y)) (CAppRd[a].same-rd G2 GS.Qw2 (C.subT G2 Nl T (C.eps G2)) P1 K ((tt, x), y) (refl (GS.Qw2.1.tob K ((tt, x), y))) y) ;
 ybr (K : Ob) (w : V1.Ix (G2.ob K)) : Id (V1.Ix ((C.subT G2 GA.G1 GA.Qw sa).1.tob K w)) ((OV.trE G2 (C.subT G2 Nl T' (C.eps G2)) (C.subT G2 GA.G1 GA.Qw sa) PB yb).eob K w) (yb.eob K w) =
  transH (CAppRd[a].trE-rd G2 (C.subT G2 Nl T' (C.eps G2)) (C.subT G2 GA.G1 GA.Qw sa) PB yb K w)
   (CAppRd[a].same-rd G2 (C.subT G2 Nl T' (C.eps G2)) (C.subT G2 GA.G1 GA.Qw sa) PB K w (refl ((C.subT G2 Nl T' (C.eps G2)).1.tob K w)) (yb.eob K w)) ;
 -- rho : R on the diagonal is reflexivity
 x0 : C.El GS.G1 GS.Qw = C.q Nl T ;
 s0 : C.Sub GS.G1 GA.G2 = C.o GS.G1 G2 GA.G2 sg (C.sec GS.G1 GS.Qw x0) ;
 Q2s : C.Ty GS.G1 = C.subT GS.G1 GA.G2 GA.Qw2 s0 ;
 a1 : C.El GS.G1 Q2s = C.subt GS.G1 GA.G2 GA.Qw2 GA.v1 s0 ;
 a2 : C.El GS.G1 Q2s = C.subt GS.G1 GA.G2 GA.Qw2 GA.v2 s0 ;
 e12p (K : Ob) : (o : Top) (x : V1.Ix (T.1.tob K o)) -> Id (V1.Ix (Q2s.1.tob K (o, x))) (a1.eob K (o, x)) (a2.eob K (o, x)) = split {
  tt -> \ x -> transH (apH {TK K ((tt, x), x)} {V1.Ix (T'.1.tob K tt)} (sN.nfun K tt) (transH (xar K x x) (symH (xbr K x x))))
   (symH (ybr K ((tt, x), x))) } ;
 e12 : Id (C.El GS.G1 Q2s) a1 a2 = L.el-ext GS.G1 Q2s.1 a1 a2 (\ K w -> e12p K w.1 w.2) ;
 rf : C.El GS.G1 (IJ.IdT GS.G1 Q2s a1 a2) = subst (C.El GS.G1 Q2s) (\ r -> C.El GS.G1 (IJ.IdT GS.G1 Q2s a1 r)) a1 a2 e12 (IJ.rfl GS.G1 Q2s a1) ;
 Pr1 : Id (C.Ty GS.G1) (C.subT GS.G1 GA.G2 IA s0) (C.subT GS.G1 G2 R (C.sec GS.G1 GS.Qw x0)) = C.subT-o GS.G1 G2 GA.G2 IA sg (C.sec GS.G1 GS.Qw x0) ;
 Pr2 : Id (C.Ty GS.G1) (C.subT GS.G1 GA.G2 IA s0) (IJ.IdT GS.G1 Q2s a1 a2) = IJ.IdT-nat GS.G1 GA.G2 GA.Qw2 GA.v1 GA.v2 s0 ;
 rho : C.El GS.G1 (C.subT GS.G1 G2 R (C.sec GS.G1 GS.Qw x0)) = OV.trE GS.G1 (IJ.IdT GS.G1 Q2s a1 a2) (C.subT GS.G1 G2 R (C.sec GS.G1 GS.Qw x0)) (transH (symH Pr2) Pr1) rf ;
 -- f : over G2.R, r applied to the variable of R
 GR : C.Ctx = C.ext G2 R ;
 pR' : C.Sub GR G2 = C.p G2 R ;
 tR : C.Sub GR GA.G2 = C.o GR G2 GA.G2 sg pR' ;
 QA2 : C.Ty GR = C.subT GR GA.G2 GA.Qw2 tR ;
 b1 : C.El GR QA2 = C.subt GR GA.G2 GA.Qw2 GA.v1 tR ;
 b2 : C.El GR QA2 = C.subt GR GA.G2 GA.Qw2 GA.v2 tR ;
 PRq : Id (C.Ty GR) (OV.wkT G2 R R) (IJ.IdT GR QA2 b1 b2) =
  transH (symH (C.subT-o GR G2 GA.G2 IA sg pR')) (IJ.IdT-nat GR GA.G2 GA.Qw2 GA.v1 GA.v2 tR) ;
 u0 : C.El GR (IJ.IdT GR QA2 b1 b2) = OV.trE GR (OV.wkT G2 R R) (IJ.IdT GR QA2 b1 b2) PRq (C.q G2 R) ;
 pA2 : C.Sub GR Nl = C.o GR GA.G2 Nl (C.o GA.G2 GA.G1 Nl (C.p Nl T') (C.p GA.G1 GA.Qw)) tR ;
 TPA : Id (C.Ty GR) QA2 (C.subT GR Nl T' (C.eps GR)) =
  transH (apH {C.Ty GA.G2} {C.Ty GR} (\ X -> C.subT GR GA.G2 X tR) (symH (C.subT-o GA.G2 GA.G1 Nl T' (C.p Nl T') (C.p GA.G1 GA.Qw))))
   (transH (symH (C.subT-o GR GA.G2 Nl T' (C.o GA.G2 GA.G1 Nl (C.p Nl T') (C.p GA.G1 GA.Qw)) tR)) (clT GR T' pA2 (C.eps GR))) ;
 b1' : C.El GR (C.subT GR Nl T' (C.eps GR)) = OV.trE GR QA2 (C.subT GR Nl T' (C.eps GR)) TPA b1 ;
 b2' : C.El GR (C.subT GR Nl T' (C.eps GR)) = OV.trE GR QA2 (C.subT GR Nl T' (C.eps GR)) TPA b2 ;
 u1 : C.El GR (IJ.IdT GR (C.subT GR Nl T' (C.eps GR)) b1' b2') = CInjP[a].idFwdL GR QA2 (C.subT GR Nl T' (C.eps GR)) TPA b1 b2 u0 ;
 module AP = CCmpK3[a].ApN[T', T, rN, GR, C.eps GR] ;
 ap : C.El GR (IJ.IdT GR AP.YG (AP.IPm.evS GR (C.eps GR) b1') (AP.IPm.evS GR (C.eps GR) b2')) = AP.ap b1' b2' u1 ;
 pp3 : C.Sub GR Nl = C.o GR G2 Nl p21 pR' ;
 TP : Id (C.Ty GR) (OV.wkT G2 R GS.Qw2) (C.subT GR Nl T (C.eps GR)) =
  transH (apH {C.Ty G2} {C.Ty GR} (\ X -> C.subT GR G2 X pR') (transH (refl GS.Qw2) (symH (C.subT-o G2 GS.G1 Nl T (C.p Nl T) (C.p GS.G1 GS.Qw)))))
   (transH (symH (C.subT-o GR G2 Nl T p21 pR')) (clT GR T pp3 (C.eps GR))) ;
 w1 : C.El GR (C.subT GR Nl T (C.eps GR)) = OV.trE GR (OV.wkT G2 R GS.Qw2) (C.subT GR Nl T (C.eps GR)) TP (OV.wkE G2 R GS.Qw2 GS.v1) ;
 w2 : C.El GR (C.subT GR Nl T (C.eps GR)) = OV.trE GR (OV.wkT G2 R GS.Qw2) (C.subT GR Nl T (C.eps GR)) TP (OV.wkE G2 R GS.Qw2 GS.v2) ;
 -- readings at the points of GR
 YK (K : Ob) (w : V1.Ix (GR.ob K)) : U a+ = V1.Ix ((C.subT GR Nl T (C.eps GR)).1.tob K w) ;
 b1r (K : Ob) (x y : V1.Ix (T.1.tob K tt)) (r : V1.Ix (R.1.tob K ((tt, x), y))) : Id (V1.Ix (T'.1.tob K tt)) (b1'.eob K (((tt, x), y), r)) (sN.nfun K tt x) =
  transH (CAppRd[a].trE-rd GR QA2 (C.subT GR Nl T' (C.eps GR)) TPA b1 K (((tt, x), y), r))
   (transH (CAppRd[a].same-rd GR QA2 (C.subT GR Nl T' (C.eps GR)) TPA K (((tt, x), y), r) (refl (QA2.1.tob K (((tt, x), y), r))) (b1.eob K (((tt, x), y), r)))
     (apH {TK K ((tt, x), y)} {V1.Ix (T'.1.tob K tt)} (sN.nfun K tt) (xar K x y))) ;
 b2r (K : Ob) (x y : V1.Ix (T.1.tob K tt)) (r : V1.Ix (R.1.tob K ((tt, x), y))) : Id (V1.Ix (T'.1.tob K tt)) (b2'.eob K (((tt, x), y), r)) (sN.nfun K tt y) =
  transH (CAppRd[a].trE-rd GR QA2 (C.subT GR Nl T' (C.eps GR)) TPA b2 K (((tt, x), y), r))
   (transH (CAppRd[a].same-rd GR QA2 (C.subT GR Nl T' (C.eps GR)) TPA K (((tt, x), y), r) (refl (QA2.1.tob K (((tt, x), y), r))) (b2.eob K (((tt, x), y), r)))
     (transH (ybr K ((tt, x), y)) (apH {TK K ((tt, x), y)} {V1.Ix (T'.1.tob K tt)} (sN.nfun K tt) (xbr K x y)))) ;
 w1r (K : Ob) (x y : V1.Ix (T.1.tob K tt)) (r : V1.Ix (R.1.tob K ((tt, x), y))) : Id (YK K (((tt, x), y), r)) (w1.eob K (((tt, x), y), r)) x =
  transH (CAppRd[a].trE-rd GR (OV.wkT G2 R GS.Qw2) (C.subT GR Nl T (C.eps GR)) TP (OV.wkE G2 R GS.Qw2 GS.v1) K (((tt, x), y), r))
   (CAppRd[a].same-rd GR (OV.wkT G2 R GS.Qw2) (C.subT GR Nl T (C.eps GR)) TP K (((tt, x), y), r) (refl ((OV.wkT G2 R GS.Qw2).1.tob K (((tt, x), y), r))) x) ;
 w2r (K : Ob) (x y : V1.Ix (T.1.tob K tt)) (r : V1.Ix (R.1.tob K ((tt, x), y))) : Id (YK K (((tt, x), y), r)) (w2.eob K (((tt, x), y), r)) y =
  transH (CAppRd[a].trE-rd GR (OV.wkT G2 R GS.Qw2) (C.subT GR Nl T (C.eps GR)) TP (OV.wkE G2 R GS.Qw2 GS.v2) K (((tt, x), y), r))
   (CAppRd[a].same-rd GR (OV.wkT G2 R GS.Qw2) (C.subT GR Nl T (C.eps GR)) TP K (((tt, x), y), r) (refl ((OV.wkT G2 R GS.Qw2).1.tob K (((tt, x), y), r))) y) ;
 px (K : Ob) : (o : Top) (x y : V1.Ix (T.1.tob K o)) (r : V1.Ix (R.1.tob K ((o, x), y)))
   -> Id (YK K (((o, x), y), r)) ((AP.IPm.evS GR (C.eps GR) b1').eob K (((o, x), y), r)) (w1.eob K (((o, x), y), r)) = split {
  tt -> \ x y r -> transH (apH {V1.Ix (T'.1.tob K tt)} {V1.Ix (T.1.tob K tt)} (rN.nfun K tt) (b1r K x y r)) (transH (rs K tt x) (symH (w1r K x y r))) } ;
 py (K : Ob) : (o : Top) (x y : V1.Ix (T.1.tob K o)) (r : V1.Ix (R.1.tob K ((o, x), y)))
   -> Id (YK K (((o, x), y), r)) ((AP.IPm.evS GR (C.eps GR) b2').eob K (((o, x), y), r)) (w2.eob K (((o, x), y), r)) = split {
  tt -> \ x y r -> transH (apH {V1.Ix (T'.1.tob K tt)} {V1.Ix (T.1.tob K tt)} (rN.nfun K tt) (b2r K x y r)) (transH (rs K tt y) (symH (w2r K x y r))) } ;
 pp : C.El GR (IJ.IdT GR (C.subT GR Nl T (C.eps GR)) w1 w2) =
  CCmpU14[a].rwId GR (C.subT GR Nl T (C.eps GR)) (AP.IPm.evS GR (C.eps GR) b1') w1 (AP.IPm.evS GR (C.eps GR) b2') w2
   (\ K w -> px K w.1.1.1 w.1.1.2 w.1.2 w.2) (\ K w -> py K w.1.1.1 w.1.1.2 w.1.2 w.2) ap ;
 fB : C.El GR (IJ.IdT GR (OV.wkT G2 R GS.Qw2) (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2)) =
  CProdSet[a].idBackL GR (OV.wkT G2 R GS.Qw2) (C.subT GR Nl T (C.eps GR)) TP (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2) pp ;
 module H6 = CwFHed6.Hed6[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibNF[a, a+].nf] ;
 fH : C.El GR (OV.wkT G2 R (H6.JP.IK GS.G1 GS.Qw x0)) =
  OV.trE GR (IJ.IdT GR (OV.wkT G2 R GS.Qw2) (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2)) (OV.wkT G2 R (H6.JP.IK GS.G1 GS.Qw x0))
    (symH (IJ.IdT-nat GR G2 GS.Qw2 GS.v1 GS.v2 pR')) fB ;
 module HS6 = H6.S[GS.G1, GS.Qw, x0, R, rho, fH, pR] ;
 -- T IS A SET
 setQi : GS.SetQiTy = OV.lam Nl T (FibCwF[a, a+].fibPi.Pi GS.G1 GS.Qw GS.SP) (OV.lam GS.G1 GS.Qw GS.SP HS6.propIK) ;
} ;
