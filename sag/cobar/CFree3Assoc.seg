-- The two bracketings of a binary free-algebra operation in F3.
-- This is the algebraic equation used by Construction 44 before Yoneda and D.
level a ;
open Base ;
open Prelude[a] ;
open Paths[a] ;
module SX = CSyntax[a] ;
module FR = CSubst[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Free3 (R : Ring[a].CRing) {
  module F = FR.Free[R] ;
  F3 : SX.Over[R].Presentation = (suc (suc (suc zero)), nil) ;
  module D3 = SX.Over[R].Der[F3] ;
  x1 : D3.Term = var (inl (inl (inr tt))) ;
  x2 : D3.Term = var (inl (inr tt)) ;
  x3 : D3.Term = var (inr tt) ;

  -- Substitutions F2 -> F3, read as two choices of images of its generators.
  module Pair (u v : D3.Term) {
    sg : SX.Fin F.F2.1 -> D3.Term = CSubCong[a].Val[R, F3].val2 u v ;
    noEq (p : SX.Over[R].Der[F.F2].Term)
      (m : SX.Over[R].Der[F.F2].Member p F.F2.2) (Z : U a) : Z = absurd Z m ;
    module SB = FR.SubOf[R, F.F2, F3, sg, \ p m -> noEq p m _] ;
    at (t : SX.Over[R].Der[F.F2].Term) : D3.Term = SB.sbT t ;
  } ;
  module AddL = Pair[x1, sumE x2 x3] ;
  module AddR = Pair[sumE x1 x2, x3] ;
  module MulL = Pair[x1, mulE x2 x3] ;
  module MulR = Pair[mulE x1 x2, x3] ;

  addLeft : D3.Term = sumE x1 (sumE x2 x3) ;
  addRight : D3.Term = sumE (sumE x1 x2) x3 ;
  addLeftAt : Id D3.Term (AddL.at (sumE F.x1 F.x2)) addLeft = refl addLeft ;
  addRightAt : Id D3.Term (AddR.at (sumE F.x1 F.x2)) addRight = refl addRight ;
  addAssoc : D3.Proof addLeft addRight = D3.addAssocP x1 x2 x3 ;
  mulLeft : D3.Term = mulE x1 (mulE x2 x3) ;
  mulRight : D3.Term = mulE (mulE x1 x2) x3 ;
  mulLeftAt : Id D3.Term (MulL.at (mulE F.x1 F.x2)) mulLeft = refl mulLeft ;
  mulRightAt : Id D3.Term (MulR.at (mulE F.x1 F.x2)) mulRight = refl mulRight ;
  mulAssoc : D3.Proof mulLeft mulRight = D3.mulAssocP x1 x2 x3 ;
} ;

-- The equations hold as paths in the presented algebra on three generators.
module Free3Classes (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module F = Free3[R] ;
  module AX = CAlgX[a].AlgX[R, encK, F.F3, pe] ;
  addAssoc : FibCwF[a, a+].fibCwF.El AX.Nl (AX.IdQ (AX.cls F.addLeft) (AX.cls F.addRight)) =
    AX.clsEq F.addLeft F.addRight F.addAssoc ;
  mulAssoc : FibCwF[a, a+].fibCwF.El AX.Nl (AX.IdQ (AX.cls F.mulLeft) (AX.cls F.mulRight)) =
    AX.clsEq F.mulLeft F.mulRight F.mulAssoc ;
} ;

-- Associativity on the generic triple of G-elements represented by yo(F3).
-- CE1Rel combines term evaluation (E1) with the path between the classes.
module Generic3Assoc (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module F = Free3[R] ;
  module Add = CE1Rel[a].Rel[R, encK, pe, F.F3, F.addLeft, F.addRight, F.addAssoc] ;
  module Mul = CE1Rel[a].Rel[R, encK, pe, F.F3, F.mulLeft, F.mulRight, F.mulAssoc] ;
  addPath : Add.A.G1.GB.GPre[a+].PS.PEl[Add.A.G1.GB.GPre[a+].PS.extP Add.A.P1 Add.A.XT,
    Add.HO1.HT[Add.A.P1, Add.A.XT, Add.A.GT, Add.TA.I.Lv F.addLeft, Add.TA.I.Lv F.addRight].PT.PathP] = Add.res ;
  mulPath : Mul.A.G1.GB.GPre[a+].PS.PEl[Mul.A.G1.GB.GPre[a+].PS.extP Mul.A.P1 Mul.A.XT,
    Mul.HO1.HT[Mul.A.P1, Mul.A.XT, Mul.A.GT, Mul.TA.I.Lv F.mulLeft, Mul.TA.I.Lv F.mulRight].PT.PathP] = Mul.res ;
} ;

-- The comparison induced by the three coprojections F1 -> F3.
-- Its being a levelwise equivalence is a separate homotopical claim.
module Free3Comparison (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module F = Free3[R] ;
  module CM = CCopy[a].ConcC[R, encK, pe].CM ;
  module TP = CM.TP ;
  module PD = CM.PD ;
  module K1 = CM.II.SubC[CM.F1, F.F3, \ v -> F.x1, \ p m -> F.F.noEq p m _] ;
  module K2 = CM.II.SubC[CM.F1, F.F3, \ v -> F.x2, \ p m -> F.F.noEq p m _] ;
  module K3 = CM.II.SubC[CM.F1, F.F3, \ v -> F.x3, \ p m -> F.F.noEq p m _] ;
  module P1 = CM.Pre[F.F3, CM.F1, K1.M.mor, K1.M.mor-nat] ;
  module P2 = CM.Pre[F.F3, CM.F1, K2.M.mor, K2.M.mor-nat] ;
  module P3 = CM.Pre[F.F3, CM.F1, K3.M.mor, K3.M.mor-nat] ;
  Y3 : TP.TCtx = CM.Yo[F.F3].yoT ;
  Y1 : TP.TCtx = CM.Yo[CM.F1].yoT ;
  Y111 : TP.TCtx = PD.prodT (PD.prodT Y1 Y1) Y1 ;
  cmpS : TP.TSub[Y3, Y111] =
    new TP.TSub[Y3, Y111,
      \ I x h -> ((P1.pre I x h, P2.pre I x h), P3.pre I x h),
      \ J I u y x f h ->
        PD.pairE2 (CM.MO.Fn[CM.F1, y].M J * CM.MO.Fn[CM.F1, y].M J) (CM.MO.Fn[CM.F1, y].M J) _ _ _ _
          (PD.pairE2 (CM.MO.Fn[CM.F1, y].M J) (CM.MO.Fn[CM.F1, y].M J) _ _ _ _
            (P1.pre-nat J I u y x f h) (P2.pre-nat J I u y x f h))
          (P3.pre-nat J I u y x f h)] ;
} ;
