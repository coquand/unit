-- CTotDProp3.seg (canonicity-c2; SIMPLIFIED.md, "D preserves
-- propositions", part 3): if A over G is levelwise a proposition (the
-- levelwise contraction al0 of A weakened over G.A), then D A over D G is
-- contractible over itself (Lemma 12's trivial half at G.A, moved along
-- Pair.phi : D G . D A -> D (G.A)), hence a proposition (internally, in
-- the fibrant CwF of the total site).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module DP3 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module U4 = CTotUFib4[a, vl, l].UFib4[C] ;
 module P2 = CTotDProp2[a, vl, l].DP2[C, G, A.1] ;
 module P1m = P2.P1m ;
 module DA = P2.DA ;
 module DA1 = P2.DA1 ;
 module PR = P2.PR ;
 -- D A as a fibrant type over D G (Lemma 12, fibrancy half)
 DG : G1.fibCwF-T.Ctx = P2.DG ;
 DAT : G1.fibCwF-T.Ty DG = (DA.DTy, CTotL12Fib2[a, vl, l].L12F[C, G, A.1].lemma12F (U4.fibU (P1m.GP) A.1 A.2)) ;
 GT : G1.fibCwF-T.Ctx = G1.fibCwF-T.ext DG DAT ;
 AW : G1.fibCwF-T.Ty GT = G1.fibCwF-T.subT GT DG DAT (G1.fibCwF-T.p DG DAT) ;
 module At (al0 : G0.GB.CPartial[l].ContrOp (TR.RS.rC P1m.EP) (TR.RS.rT P1m.EP P1m.A1)) {
  k0 : G1.GB.CPartial[l].ContrOp PR.DEP DA1.DTy = CTotL12n[a, vl, l].L12n[C, P1m.ET, P1m.A1].lemma12 al0 ;
  module M = G1.GB.CMove[l, l].Mv[PR.Ext, P2.SF, P2.SF, G1.GB.CPartial[l].pmap-id PR.Ext P2.SF,
    PR.DEP, DA1.DTy, DA1.DTy, G1.GB.CPartial[l].pmap-id PR.DEP DA1.DTy,
    \ W x -> PR.phi W x, \ Vb Wb g x -> PR.phiN Vb Wb g x,
    \ Wb v -> P2.mS Wb v, \ Wb v -> refl (PR.phi Wb (P2.TS.pr1 Wb v)), \ Vb Wb g v -> P2.NS[Vb, Wb, g, v].law,
    \ Wb v -> P2.mS Wb v, \ Wb v -> refl (PR.phi Wb (P2.TS.pr1 Wb v)), \ Vb Wb g v -> P2.NS[Vb, Wb, g, v].law,
    \ Wb v v' Pp Q -> P2.mTinj Wb v v' Pp Q,
    \ X x u -> P2.bk X x u, \ X x u -> P2.bkMv X x u, \ Wb v -> refl (P2.mS Wb v), k0] ;
  rc : G1.GB.CPartial[l].ContrOp GT AW.1 = M.rc ;
  contr : G1.fibCwF-T.El GT (G1.EQT.isContr GT AW) = G1.contr-T GT AW rc ;
  module PN = CwFPropNoU.PropNoU[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T, G1.nf-T] ;
  isPropD : G1.fibCwF-T.El DG (PN.isProp DG DAT) = PN.propOver DG DAT contr ;
 } ;
} ;
