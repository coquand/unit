-- CPshFillU.seg (canonicity-45; (B) stage 2, COBAR.md): the derived filler
-- (CFill.FillC) of a C-uniform composition is C-uniform.  Mirror of
-- CFillMove (filling commutes with a cartesian map) for the C-action,
-- which is a map of types over G.act but not cartesian: the problem at
-- a point is formed from the data at that point only (PMC: its point and
-- its side move to those of the moved data), so the composites agree by
-- the uniformity cu, and the values of the fillers are such composites at
-- restricted data (inpEq: restriction commutes with the C-action of sides).
--   FU[G, A, d, kk, cu].res : the fillers (x |-> FillC[G.ob x, A.ty x, d, kk x].fill)
--                              are uniform (P.Unif ... CUnif) for the C-action

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module FillUOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 open P ;

 module FU (G : CCtx) (A : CTy[G]) (d : Bool)
  (kk : (x : CO) -> CL.Lines[G.ob x, A.ty x].CompK[PB.src d, PB.tgt d].Comp)
  (cu : LO.UF[G, A].UComp (PB.src d) (PB.tgt d) kk) {
  module SFe = LO.SF[G, A, PB.src d] ;
  module AEe = SFe.AE' ;
  module AEt = LO.AE[G, A, PB.tgt d] ;
  module SCe = LO.SC[SFe.TVC, LO.LinC G, LO.pPC (LO.LinC G) AEe.AevC, AEt.AevC] ;
  module Fx (x : CO) {
   module FC = PB.CFill[l].FillC[G.ob x, A.ty x, d, kk x] ;
   module FP = FC.FP ;
   module K = FP.K ;
   module EK = FP.EK ;
   module EK' = CL.EndKit[G.ob x, A.ty x, PB.tgt d] ;
   module FA = FP.FA ;
   module FG = FP.FG ;
   module TA = FP.TA ;
   module TV = FP.TV ;
   module TS = FP.TS ;
   module PT = FP.PT ;
   module CK = FC.CK ;
   module RC = CP.Rel[TV.E, EK.SFm.SF, CK.Tend, CK.endL] ;
  } ;
  module MSd (y x : CO) (f : CH y x) { module M = MapSide[SFe.TVC, SFe.SFC, y, x, f] ; } ;

  -- the C-action on the end data, on the strict fibres, and on the lines
  tv (y x : CO) (f : CH y x) (X : Ob) (w : Fx[x].TV.EI X) : Fx[y].TV.EI X = AEe.tEv y x f X w ;
  ts (y x : CO) (f : CH y x) (X : Ob) (u : Fx[x].TS.EI X) : Fx[y].TS.EI X = SFe.tES y x f X u ;
  ta (y x : CO) (f : CH y x) (X : Ob) (u : Fx[x].TA.EI X) : Fx[y].TA.EI X = (A.tE y x f).nt X u ;
  tv-nat (y x : CO) (f : CH y x) (V X : Ob) (g : Hom V X) (w : Fx[x].TV.EI X)
   : Id (Fx[y].TV.EI V) (tv y x f V (Fx[x].TV.E.act V X g w)) (Fx[y].TV.E.act V X g (tv y x f X w)) =
   (AEe.tEvP y x f).nt-nat V X g w ;
  ta-nat (y x : CO) (f : CH y x) (V X : Ob) (g : Hom V X) (u : Fx[x].TA.EI X)
   : Id (Fx[y].TA.EI V) (ta y x f V (Fx[x].TA.E.act V X g u)) (Fx[y].TA.E.act V X g (ta y x f X u)) =
   (A.tE y x f).nt-nat V X g u ;

  -- a composite of the other end, moved and read in A, is the composite read in A
  rdC (y x : CO) (f : CH y x) (V : Ob) (v : Fx[x].FC.TT.EI V)
   : Id (Fx[y].TA.EI V) (Fx[y].FC.rd V (SCe.tEs y x f V v)) (ta y x f V (Fx[x].FC.rd V v)) =
   transH (apH (Fx[y].EK'.endE V) (SCe.rBtE y x f V v)) (AEt.endEv y x f V (Fx[x].CK.SE.mV V v)) ;
  opaque rdC ;

  ------------------------------------------------------------------
  -- the problem moves

  module PMC (y x : CO) (f : CH y x) (V0 : Ob) (w : Fx[x].TV.EI V0) (sd : Fx[x].PT.Side[V0, w]) (j : Hom V0 Iv) {
   module X = Fx[x] ;
   module Y = Fx[y] ;
   module Pa = X.FP.Prob[V0, w, sd, j] ;
   module Pb = Y.FP.Prob[V0, tv y x f V0 w, MSd[y, x, f].M.mapside V0 w sd, j] ;
   msd : Y.PT.Side[V0, tv y x f V0 w] = MSd[y, x, f].M.mapside V0 w sd ;

   pt : Id (Y.TV.EI V0) (tv y x f V0 Pa.w') Pb.w' =
    Y.EK.tv-eq V0 (tv y x f V0 Pa.w') Pb.w'
     (Y.FG.fam-eq V0 (Y.TV.pr1 V0 (tv y x f V0 Pa.w')) (Y.TV.pr1 V0 Pb.w')
        (\ V' g i -> refl ((G.act y x f).nt V' ((X.TV.pr1 V0 w).1 V' g (PB.cI d V' (compH V' V0 Iv j g) i)))))
     (calc (Y.TA.EI V0) {
         Y.EK.endE V0 (tv y x f V0 Pa.w')
       =< AEe.endEv y x f V0 Pa.w' >
         ta y x f V0 (X.EK.endE V0 Pa.w')
       =< apH (ta y x f V0) Pa.w'-E >
         ta y x f V0 (X.EK.endE V0 w)
       =< symH (AEe.endEv y x f V0 w) >
         Y.EK.endE V0 (tv y x f V0 w)
       =< symH Pb.w'-E >
         Y.EK.endE V0 Pb.w' }) ;

   -- the sieves, side by side
   Qe : (n : Nat) -> Id (PB.Phi V0) (Pa.pick n).pQ (Pb.pick n).pQ = split {
    zero -> refl (PB.pre V0 Iv j (PB.ptS (PB.src d))) ;
    suc m -> refl sd.pQ } ;
   eQ : Id (PB.Phi V0) Pa.side.pQ Pb.side.pQ =
    apH (\ F -> PB.bigU V0 (suc (suc zero)) F)
     (funext (Arith[a].Fin (suc (suc zero))) (\ q -> PB.Phi V0) Pa.J.Qs Pb.J.Qs (\ q -> Qe q.1)) ;

   -- the points of the sides
   ptG (n : Nat) (V' : Ob) (g : Hom V' V0) (b : PB.Lands V' V0 (Pa.pick n).pQ g) (b' : PB.Lands V' V0 (Pb.pick n).pQ g)
    : Id (Y.TV.EI V') (Y.TS.pr1 V' (ts y x f V' ((Pa.pick n).pv V' g b))) (Y.TS.pr1 V' ((Pb.pick n).pv V' g b')) =
    transH (apH (tv y x f V') ((Pa.pick n).ppt V' g b))
     (transH (tv-nat y x f V' V0 g Pa.w')
       (transH (apH (Y.TV.E.act V' V0 g) pt) (symH ((Pb.pick n).ppt V' g b')))) ;

   -- the start, restricted, moved
   z0E (V' : Ob) (g : Hom V' V0) : Id (Y.TA.EI V') (ta y x f V' (Pa.z0 V' g)) (Pb.z0 V' g) =
    transH (symH (AEe.endEv y x f V' (X.TV.E.act V' V0 g Pa.w')))
     (apH (Y.EK.endE V') (transH (tv-nat y x f V' V0 g Pa.w') (apH (Y.TV.E.act V' V0 g) pt))) ;

   vEq : (n : Nat) (V' : Ob) (g : Hom V' V0) (b : PB.Lands V' V0 (Pa.pick n).pQ g) (b' : PB.Lands V' V0 (Pb.pick n).pQ g)
    -> Id (Y.TS.EI V') (ts y x f V' ((Pa.pick n).pv V' g b)) ((Pb.pick n).pv V' g b') = split {
    zero -> \ V' g b b' ->
     Y.EK.ts-ext V' (ts y x f V' (Pa.v0 V' g b)) (Pb.v0 V' g b') (ptG zero V' g b b')
      (\ V'' h i ->
       calc (Y.TA.EI V'') {
           Y.EK.lv V' (ts y x f V' (Pa.v0 V' g b)) V'' h i
         =< apH (ta y x f V'') (apH (\ M -> X.FA.lval V' M V'' h i)
              (X.EK.mkTS-line V' (X.TV.E.act V' V0 g Pa.w') (X.K.constA V' (Pa.z0 V' g)) (Pa.p0 V' g b) (Pa.q0 V' g))) >
           ta y x f V'' (X.TA.E.act V'' V' h (Pa.z0 V' g))
         =< ta-nat y x f V'' V' h (Pa.z0 V' g) >
           Y.TA.E.act V'' V' h (ta y x f V' (Pa.z0 V' g))
         =< apH (Y.TA.E.act V'' V' h) (z0E V' g) >
           Y.TA.E.act V'' V' h (Pb.z0 V' g)
         =< symH (apH (\ M -> Y.FA.lval V' M V'' h i)
              (Y.EK.mkTS-line V' (Y.TV.E.act V' V0 g Pb.w') (Y.K.constA V' (Pb.z0 V' g)) (Pb.p0 V' g b') (Pb.q0 V' g))) >
           Y.EK.lv V' (Pb.v0 V' g b') V'' h i }) ;
    suc m -> \ V' g b b' ->
     Y.EK.ts-ext V' (ts y x f V' (Pa.v1 V' g b)) (Pb.v1 V' g b') (ptG (suc m) V' g b b')
      (\ V'' h i ->
       calc (Y.TA.EI V'') {
           Y.EK.lv V' (ts y x f V' (Pa.v1 V' g b)) V'' h i
         =< apH (ta y x f V'') (apH (\ M -> X.FA.lval V' M V'' h i)
              (X.EK.mkTS-line V' (X.TV.E.act V' V0 g Pa.w') (X.K.connA V' (X.EK.lineL V' (sd.pv V' g b)) (compH V' V0 Iv j g)) (Pa.p1 V' g b) (Pa.q1 V' g b))) >
           ta y x f V'' (X.FA.lval V' (X.EK.lineL V' (sd.pv V' g b)) V'' h (PB.cI d V'' (compH V'' V' Iv (compH V' V0 Iv j g) h) i))
         =< apH (\ u -> ta y x f V'' (X.FA.lval V' (X.EK.lineL V' u) V'' h (PB.cI d V'' (compH V'' V' Iv (compH V' V0 Iv j g) h) i)))
              (X.PT.pv-irr V0 w sd V' g b b') >
           ta y x f V'' (X.FA.lval V' (X.EK.lineL V' (sd.pv V' g b')) V'' h (PB.cI d V'' (compH V'' V' Iv (compH V' V0 Iv j g) h) i))
         =< symH (apH (\ M -> Y.FA.lval V' M V'' h i)
              (Y.EK.mkTS-line V' (Y.TV.E.act V' V0 g Pb.w') (Y.K.connA V' (Y.EK.lineL V' (msd.pv V' g b')) (compH V' V0 Iv j g)) (Pb.p1 V' g b') (Pb.q1 V' g b'))) >
           Y.EK.lv V' (Pb.v1 V' g b') V'' h i }) } ;

   sd-eq : Id (Y.PT.Side[V0, Pb.w'])
            (subst (Y.TV.EI V0) (\ z -> Y.PT.Side[V0, z]) (tv y x f V0 Pa.w') Pb.w' pt (MSd[y, x, f].M.mapside V0 Pa.w' Pa.side)) Pb.side =
    Y.PT.side-extH V0 (tv y x f V0 Pa.w') Pb.w' pt (MSd[y, x, f].M.mapside V0 Pa.w' Pa.side) Pb.side eQ
     (\ V' g h h' ->
      transH (vEq (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).1.1 V' g (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).2
                (PB.lands-sub V' V0 (Pa.pick (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).1.1).pQ
                   (Pb.pick (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).1.1).pQ (Qe (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).1.1) g
                   (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).2))
        (symH (Pb.J.pv-in (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).1 V' g
                (PB.lands-sub V' V0 (Pa.pick (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).1.1).pQ
                   (Pb.pick (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).1.1).pQ (Qe (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).1.1) g
                   (PB.bigU-out V' V0 (suc (suc zero)) Pa.J.Qs g h).2) h'))) ;
   opaque pt ; opaque sd-eq ;

   -- the composites agree
   out : Id (Y.TA.EI V0) (ta y x f V0 (X.FC.rd V0 (X.FC.out V0 (w, sd) j))) (Y.FC.rd V0 (Y.FC.out V0 (tv y x f V0 w, msd) j)) =
    transH (symH (rdC y x f V0 (X.FC.out V0 (w, sd) j)))
     (apH (Y.FC.rd V0)
       (transH (cu y x f V0 Pa.w' Pa.side)
         (Y.RC.kop-cong (kk y) V0 (tv y x f V0 Pa.w') Pb.w' pt (MSd[y, x, f].M.mapside V0 Pa.w' Pa.side) Pb.side sd-eq))) ;
  } ;

  ------------------------------------------------------------------
  -- the fillers agree

  -- the restricted data, moved, are the restricted moved data
  inpEq (y x : CO) (f : CH y x) (X : Ob) (w : Fx[x].TV.EI X) (sd : Fx[x].PT.Side[X, w]) (V : Ob) (g : Hom V X)
   : Id (Fx[y].FC.In V) (tv y x f V (Fx[x].FC.F[X, w, sd].inp V g).1, MSd[y, x, f].M.mapside V (Fx[x].FC.F[X, w, sd].inp V g).1 (Fx[x].FC.F[X, w, sd].inp V g).2)
                        (Fx[y].FC.F[X, tv y x f X w, MSd[y, x, f].M.mapside X w sd].inp V g) =
   Sigma-path (Fx[y].TV.EI V) (\ z -> Fx[y].PT.Side[V, z])
    (tv y x f V (Fx[x].TV.E.act V X g w)) (Fx[y].TV.E.act V X g (tv y x f X w))
    (MSd[y, x, f].M.mapside V (Fx[x].TV.E.act V X g w) (Fx[x].PT.rside V X g w sd))
    (Fx[y].PT.rside V X g (tv y x f X w) (MSd[y, x, f].M.mapside X w sd))
    (tv-nat y x f V X g w)
    (Fx[y].PT.side-extH V (tv y x f V (Fx[x].TV.E.act V X g w)) (Fx[y].TV.E.act V X g (tv y x f X w)) (tv-nat y x f V X g w)
      (MSd[y, x, f].M.mapside V (Fx[x].TV.E.act V X g w) (Fx[x].PT.rside V X g w sd))
      (Fx[y].PT.rside V X g (tv y x f X w) (MSd[y, x, f].M.mapside X w sd))
      (refl (PB.pre V X g sd.pQ))
      (\ W h i i' -> apH (ts y x f W) (Fx[x].PT.pv-irr X w sd W (compH W V X g h) i i'))) ;
  opaque inpEq ;

  fill-C (y x : CO) (f : CH y x) (X : Ob) (w : Fx[x].TV.EI X) (sd : Fx[x].PT.Side[X, w])
   : Id (Fx[y].TS.EI X) (ts y x f X (Fx[x].TS.pr X w (Fx[x].FC.fill.kop X w sd)))
       (Fx[y].TS.pr X (tv y x f X w) (Fx[y].FC.fill.kop X (tv y x f X w) (MSd[y, x, f].M.mapside X w sd))) =
   Fx[y].EK.ts-ext X (ts y x f X (Fx[x].TS.pr X w (Fx[x].FC.fill.kop X w sd)))
     (Fx[y].TS.pr X (tv y x f X w) (Fx[y].FC.fill.kop X (tv y x f X w) (MSd[y, x, f].M.mapside X w sd)))
     (refl (tv y x f X w))
     (\ V g j ->
      transH (PMC[y, x, f, V, (Fx[x].FC.F[X, w, sd].inp V g).1, (Fx[x].FC.F[X, w, sd].inp V g).2, j].out)
        (apH (\ z -> Fx[y].FC.rd V (Fx[y].FC.out V z j)) (inpEq y x f X w sd V g))) ;
  opaque fill-C ;

  res : P.Unif[SFe.TVC, SFe.SFC, SFe.SFC, \ x -> CP.pmap-id (SFe.TVC.ob x) (SFe.SFC.ty x), \ x -> Fx[x].FC.fill].CUnif =
   \ y x f X w sd -> fill-C y x f X w sd ;
 } ;
} ;
