-- CCyl.seg (canonicity-45; SIMPLIFIED.md step 1, INTERNAL-C.md §5): the
-- cylinder of a site.  Generic over a small category BC with an object Iv:
-- a record Cyl giving, for every X, an object cyl X with projections to X
-- and Iv, pairing, the two projection laws and the eta law.  The poset
-- site has it from CPosC's binary products (posCyl).  Used by the constant
-- types (CConst): every line is the restriction of one line over the
-- cylinder.  The total site (GrothCB) and the slices export their own
-- instances (canonicity-c2).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
module VB = V[a] ;

module CylOf (BC : SmallCat[a].SmallCat) (Iv : SmallCat[a].Objs[BC.obV].Ob) {
 open SmallCat[a].Objs[BC.obV] ; open SmallCat[a].Homs[BC.obV, BC.homV] ;
 record Cyl {
  cyl (X : Ob) : Ob ;
  cpr1 (X : Ob) : Hom (cyl X) X ;
  cpr2 (X : Ob) : Hom (cyl X) Iv ;
  cpair (X Z : Ob) (f : Hom Z X) (j : Hom Z Iv) : Hom Z (cyl X) ;
  cpr1-pair (X Z : Ob) (f : Hom Z X) (j : Hom Z Iv) : Id (Hom Z X) (BC.oC Z (cyl X) X (cpr1 X) (cpair X Z f j)) f ;
  cpr2-pair (X Z : Ob) (f : Hom Z X) (j : Hom Z Iv) : Id (Hom Z Iv) (BC.oC Z (cyl X) Iv (cpr2 X) (cpair X Z f j)) j ;
  cpair-eta (X Z : Ob) (h : Hom Z (cyl X))
   : Id (Hom Z (cyl X)) (cpair X Z (BC.oC Z (cyl X) X (cpr1 X) h) (BC.oC Z (cyl X) Iv (cpr2 X) h)) h ;
 } ;
} ;

-- the poset instance: the binary product with the interval
module PosCyl {
 open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
 open CPosC[a] ;
 module PB = PosFull[a].PB ;
 posCyl : CylOf[PB.BC, PB.Iv].Cyl =
  new CylOf[PB.BC, PB.Iv].Cyl[\ X -> prodP X Iv, \ X -> pr1 X Iv, \ X -> pr2 X Iv, \ X Z f j -> pairH X Iv Z f j,
   \ X Z f j -> pr1-pair X Iv Z f j, \ X Z f j -> pr2-pair X Iv Z f j, \ X Z h -> pair-eta X Iv Z h] ;
} ;
