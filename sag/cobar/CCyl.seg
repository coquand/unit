-- CCyl.seg (canonicity-45; SIMPLIFIED.md step 1, INTERNAL-C.md §5): the
-- cylinder of a site.  Generic over a small category BC with an interval
-- PRESHEAF (ivV : the V-code of the interval at every object, ivA : its
-- action along maps, as in CBase.CB after the interval-presheaf rewrite):
-- a record Cyl giving, for every X, an object cyl X with a projection to
-- X and an element of the interval at cyl X, pairing, the two projection
-- laws and the eta law (cyl X represents yo X x IvP).  The poset site has
-- it from CPosC's binary products (PosCyl.posCyl, the interval being
-- represented by ivO there).  Used by the constant types (CConst): every
-- line is the restriction of one line over the cylinder.  The total site
-- (CGrothBase) exports its own instance (canonicity-c2).

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
open Cat[a] ;
module VB = V[a] ;

module CylOf (BC : SmallCat[a].SmallCat) (ivV : SmallCat[a].Objs[BC.obV].Ob -> VB.V)
 (ivA : (Y X : SmallCat[a].Objs[BC.obV].Ob) -> SmallCat[a].Homs[BC.obV, BC.homV].Hom Y X -> VB.Ix (ivV X) -> VB.Ix (ivV Y)) {
 open SmallCat[a].Objs[BC.obV] ; open SmallCat[a].Homs[BC.obV, BC.homV] ;
 IvP (X : Ob) : U a = VB.Ix (ivV X) ;
 record Cyl {
  cyl (X : Ob) : Ob ;
  cpr1 (X : Ob) : Hom (cyl X) X ;
  cpr2 (X : Ob) : IvP (cyl X) ;
  cpair (X Z : Ob) (f : Hom Z X) (j : IvP Z) : Hom Z (cyl X) ;
  cpr1-pair (X Z : Ob) (f : Hom Z X) (j : IvP Z) : Id (Hom Z X) (BC.oC Z (cyl X) X (cpr1 X) (cpair X Z f j)) f ;
  cpr2-pair (X Z : Ob) (f : Hom Z X) (j : IvP Z) : Id (IvP Z) (ivA Z (cyl X) (cpair X Z f j) (cpr2 X)) j ;
  cpair-eta (X Z : Ob) (h : Hom Z (cyl X))
   : Id (Hom Z (cyl X)) (cpair X Z (BC.oC Z (cyl X) X (cpr1 X) h) (ivA Z (cyl X) h (cpr2 X))) h ;
 } ;
} ;

-- the poset instance: the interval presheaf is represented by ivO, and the
-- cylinder is the binary product with it
module PosCyl {
 open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
 open CPosC[a] ;
 module PB = PosFull[a].PB ;
 module PFO = PosFull[a] ;
 pivV (W : Ob) : VB.V = homV W PFO.ivO ;
 pivA (V W : Ob) (g : Hom V W) (i : VB.Ix (pivV W)) : VB.Ix (pivV V) = compH V W PFO.ivO i g ;
 posCyl : CylOf[PB.BC, pivV, pivA].Cyl =
  new CylOf[PB.BC, pivV, pivA].Cyl[\ X -> prodP X Iv, \ X -> pr1 X Iv, \ X -> pr2 X Iv, \ X Z f j -> pairH X Iv Z f j,
   \ X Z f j -> pr1-pair X Iv Z f j, \ X Z f j -> pr2-pair X Iv Z f j, \ X Z h -> pair-eta X Iv Z h] ;
} ;
