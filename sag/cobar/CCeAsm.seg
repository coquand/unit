-- CCeAsm.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', over
-- Gamma = nil.Ec: the elements of c2's RelProd (the equations of y.u, by
-- recursion on the list, each from CCeId) and of T0 = Sigma Hom(y, y') Sol
-- at the point, by pairing (CRhoSig's Col1 at the poset base).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
-- one factor: pair along a map into an extension built as (lift s) . (sec a)
Col1 (K E : C.Ctx) (A : C.Ty E) (B : C.Ty (C.ext E A)) (s : C.Sub K E) (a0 : C.El K (C.subT K E A s))
  (b : C.El K (C.subT K (C.ext E A) B (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0))))
  : C.El K (C.subT K E (SS.Sig E A B) s) =
 OV.trE K (SS.Sig K (C.subT K E A s) (C.subT (C.ext K (C.subT K E A s)) (C.ext E A) B (C.lift K E A s))) (C.subT K E (SS.Sig E A B) s)
  (symH (SS.Sig-nat K E A B s))
  ((SS.Sig-iso K (C.subT K E A s) (C.subT (C.ext K (C.subT K E A s)) (C.ext E A) B (C.lift K E A s))).inv
    (a0, OV.trE K (C.subT K (C.ext E A) B (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0)))
           (C.subT K (C.ext K (C.subT K E A s)) (C.subT (C.ext K (C.subT K E A s)) (C.ext E A) B (C.lift K E A s)) (C.sec K (C.subT K E A s) a0))
           (C.subT-o K (C.ext K (C.subT K E A s)) (C.ext E A) B (C.lift K E A s) (C.sec K (C.subT K E A s) a0)) b)) ;
-- moving an element along a map that agrees pointwise with another
moveS (K E : C.Ctx) (B : C.Ty E) (s t : C.Sub K E) (q : (I : Ob) (z : V1.Ix (K.ob I)) -> Id (V1.Ix (E.ob I)) (s.nt I z) (t.nt I z)) (b : C.El K (C.subT K E B s))
  : C.El K (C.subT K E B t) = subst (C.Sub K E) (\ u -> C.El K (C.subT K E B u)) s t (L.sub-ext K E s t q) b ;
-- an element over a weakening along (lift s) . (sec a) from one along s
wkMove (K E : C.Ctx) (A B : C.Ty E) (s : C.Sub K E) (a0 : C.El K (C.subT K E A s)) (b : C.El K (C.subT K E B s))
  : C.El K (C.subT K (C.ext E A) (C.subT (C.ext E A) E B (C.p E A)) (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0))) =
 OV.trE K (C.subT K E B (C.o K (C.ext E A) E (C.p E A) (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0))))
   (C.subT K (C.ext E A) (C.subT (C.ext E A) E B (C.p E A)) (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0)))
   (C.subT-o K (C.ext E A) E B (C.p E A) (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0)))
   (moveS K E B s (C.o K (C.ext E A) E (C.p E A) (C.o K (C.ext K (C.subT K E A s)) (C.ext E A) (C.lift K E A s) (C.sec K (C.subT K E A s) a0)))
     (\ I z -> refl (s.nt I z)) b) ;

module AS (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module CI = CCeId[a].CI[R, encK, pe, y, u, y'] ;
 module E3 = CI.E3 ;
 module S1 = CI.S1 ;
 module S2 = CI.S2 ;
 module UP0 = CI.UP0 ;
 module SO = UP0.SO ;
 K : C.Ctx = CI.K ;
 Dv : C.Ctx = S1.Dv ;
 kk : Nat = CI.kk ;
 Inv (ps : SX.Over[R].Equations (SX.Fin kk)) (s : UP0.C.Sub UP0.E (SO.HS (E3.Lqs ps)).1) : U a++ =
  (X : E3.E2.TOb) (w : V1.Ix (UP0.E.ob X)) -> Id (V1.Ix (SO.Xc.ob X)) ((SO.HS (E3.Lqs ps)).2.nt X (s.nt X w)) ((CI.CV.XS.nt X w).1) ;
 RP : (ps : SX.Over[R].Equations (SX.Fin kk)) (s : UP0.C.Sub UP0.E (SO.HS (E3.Lqs ps)).1) (J : Inv ps s)
  -> C.El K (C.subT K Dv (S2.RelProd ps) CI.ptD) = split {
  nil -> \ s J -> L.mkPEl K (C.subT K Dv (S2.RelProd nil) CI.ptD).1 (\ I z -> tt) (\ J0 I h z z' e -> refl tt) ;
  cons p ps | r -> \ s J ->
   Col1 K Dv (S2.IdEv p) (OV.wkT Dv (S2.IdEv p) (S2.RelProd ps)) CI.ptD (CI.Eq[p, ps, s, J].res)
    (wkMove K Dv (S2.IdEv p) (S2.RelProd ps) CI.ptD (CI.Eq[p, ps, s, J].res)
      (r (UP0.C.o UP0.E (SO.HS (cons (CI.EQm.RN p) (E3.Lqs ps))).1 (SO.HS (E3.Lqs ps)).1
            (UP0.C.p (SO.HS (E3.Lqs ps)).1 (SO.EqT (SO.HS (E3.Lqs ps)).1 (SO.HS (E3.Lqs ps)).2 (CI.EQm.RN p))) s) J)) } ;
 -- all the equations, from the whole telescope
 J0 : Inv u.2 UP0.sH = \ X w -> E3.E2.dUH UP0.qs UP0.Ut X (CI.CV.XS.nt X w) ;
 relEl : C.El K (C.subT K Dv (S2.RelProd u.2) CI.ptD) = RP u.2 UP0.sH J0 ;
 -- the components read off the point map
 Gh : C.Ctx = S1.Gh ;
 Pm' : C.Ty Gh = S1.Pm' ;
 HXY : C.Ty C.nil = S1.HXY ;
 ptGh : C.Sub K Gh = C.o K Dv Gh (C.p Gh Pm') CI.ptD ;
 vEl : C.El K (C.subT K Gh Pm' ptGh) =
  OV.trE K (C.subT K Dv (C.subT Dv Gh Pm' (C.p Gh Pm')) CI.ptD) (C.subT K Gh Pm' ptGh) (symH (C.subT-o K Dv Gh Pm' (C.p Gh Pm') CI.ptD))
   (C.subt K Dv (C.subT Dv Gh Pm' (C.p Gh Pm')) (C.q Gh Pm') CI.ptD) ;
 vRd (I : Ob) (z : V1.Ix (K.ob I)) : Id (V1.Ix (Pm'.1.tob I (ptGh.nt I z))) (vEl.eob I z) (CI.ptD.nt I z).2 =
  transH (CCeId[a].trERd K (C.subT K Dv (C.subT Dv Gh Pm' (C.p Gh Pm')) CI.ptD) (C.subT K Gh Pm' ptGh) (symH (C.subT-o K Dv Gh Pm' (C.p Gh Pm') CI.ptD))
     (C.subt K Dv (C.subT Dv Gh Pm' (C.p Gh Pm')) (C.q Gh Pm') CI.ptD) I z)
   (CCeId[a].sameRd K (C.subT K Dv (C.subT Dv Gh Pm' (C.p Gh Pm')) CI.ptD) (C.subT K Gh Pm' ptGh) (symH (C.subT-o K Dv Gh Pm' (C.p Gh Pm') CI.ptD)) I z
     (refl ((C.subT K Gh Pm' ptGh).1.tob I z)) (CI.ptD.nt I z).2) ;
 s0 : C.Sub K C.nil = C.o K Gh C.nil (C.p C.nil HXY) ptGh ;
 hEl : C.El K (C.subT K C.nil HXY s0) =
  OV.trE K (C.subT K Gh (C.subT Gh C.nil HXY (C.p C.nil HXY)) ptGh) (C.subT K C.nil HXY s0) (symH (C.subT-o K Gh C.nil HXY (C.p C.nil HXY) ptGh))
   (C.subt K Gh (C.subT Gh C.nil HXY (C.p C.nil HXY)) (C.q C.nil HXY) ptGh) ;
 hRd (I : Ob) (z : V1.Ix (K.ob I)) : Id (V1.Ix (HXY.1.tob I (s0.nt I z))) (hEl.eob I z) (ptGh.nt I z).2 =
  transH (CCeId[a].trERd K (C.subT K Gh (C.subT Gh C.nil HXY (C.p C.nil HXY)) ptGh) (C.subT K C.nil HXY s0) (symH (C.subT-o K Gh C.nil HXY (C.p C.nil HXY) ptGh))
     (C.subt K Gh (C.subT Gh C.nil HXY (C.p C.nil HXY)) (C.q C.nil HXY) ptGh) I z)
   (CCeId[a].sameRd K (C.subT K Gh (C.subT Gh C.nil HXY (C.p C.nil HXY)) ptGh) (C.subT K C.nil HXY s0) (symH (C.subT-o K Gh C.nil HXY (C.p C.nil HXY) ptGh)) I z
     (refl ((C.subT K C.nil HXY s0).1.tob I z)) (ptGh.nt I z).2) ;
 -- Sol at the point, then T0
 ls1 : C.Sub K Dv = C.o K (C.ext K (C.subT K Gh Pm' ptGh)) Dv (C.lift K Gh Pm' ptGh) (C.sec K (C.subT K Gh Pm' ptGh) vEl) ;
 elSol : C.El K (C.subT K Gh S2.Sol ptGh) =
  Col1 K Gh Pm' (S2.RelProd u.2) ptGh vEl
   (moveS K Dv (S2.RelProd u.2) CI.ptD ls1 (\ I z -> apH {V1.Ix (Pm'.1.tob I (ptGh.nt I z))} {V1.Ix (Dv.ob I)} (\ v -> (ptGh.nt I z, v)) (symH (vRd I z))) relEl) ;
 ls2 : C.Sub K Gh = C.o K (C.ext K (C.subT K C.nil HXY s0)) Gh (C.lift K C.nil HXY s0) (C.sec K (C.subT K C.nil HXY s0) hEl) ;
 T0 : C.Ty C.nil = SS.Sig C.nil HXY S2.Sol ;
 elT0 : C.El K (C.subT K C.nil T0 s0) =
  Col1 K C.nil HXY S2.Sol s0 hEl
   (moveS K Gh S2.Sol ptGh ls2 (\ I z -> apH {V1.Ix (HXY.1.tob I (s0.nt I z))} {V1.Ix (Gh.ob I)} (\ v -> (s0.nt I z, v)) (symH (hRd I z))) elSol) ;
 -- cE over the empty context, then over D
 module CB = CI.CV.CB ;
 Nl : C.Ctx = C.nil ;
 Ec : L.PTy[Nl] = CI.Ec ;
 fE (I : Ob) : (o : Top) (w : V1.Ix (Ec.tob I o)) -> V1.Ix (T0.1.tob I o) = split { tt -> \ w -> elT0.eob I (tt, w) } ;
 fEn (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (T0.1.tob J tt)) (T0.1.tact J I h tt tt e (elT0.eob I (tt, w))) (elT0.eob J (tt, Ec.tact J I h tt tt e w)) =
  transH (L.tact-irr Nl T0.1 J I h tt tt e (L.ntEq K Nl s0 J I h (tt, w) (K.act J I h (tt, w)) (refl (K.act J I h (tt, w)))) (elT0.eob I (tt, w)))
   (elT0.enat J I h (tt, w) (K.act J I h (tt, w)) (refl (K.act J I h (tt, w)))) ;
 cE0 : PB.CHtpyOps[a+].NMap[Nl, Ec, T0.1] = CB.TopN[T0.1, fE, fEn].nm ;
 -- over D (Prop 58's Yy.Ay has Ec's fibres and action)
 module C1 = CI.CV.UP.RS.RD.Cp[y'] ;
 module C2 = CRho2[a].HSide[R, encK, pe, y, u].Data[CI.CV.UP.RS.A, CI.CV.UP.RS.rho, CI.CV.UP.RS.rho1].Cp[y'] ;
 cEn (J I : Ob) (h : Hom J I) (o : V1.Ix (C1.D.ob I)) (o' : V1.Ix (C1.D.ob J)) (e : Id (V1.Ix (C1.D.ob J)) (C1.D.act J I h o) o') (w : V1.Ix (C1.Yy.Ay.tob I o))
  : Id (V1.Ix (C2.Tw.1.tob J o')) (C2.Tw.1.tact J I h o o' e (cE0.nfun I tt w)) (cE0.nfun J tt (C1.Yy.Ay.tact J I h o o' e w)) =
  cE0.nnat J I h tt tt (L.ntEq C1.D Nl C2.sD J I h o o' e) w ;
 cE : PB.CHtpyOps[a+].NMap[C1.D, C1.Yy.Ay, C2.Tw.1] = new PB.CHtpyOps[a+].NMap[C1.D, C1.Yy.Ay, C2.Tw.1, \ I o w -> cE0.nfun I tt w, cEn] ;
} ;
