-- CobarI.seg (canonicity-45; SIMPLIFIED.md step 4): the cobar construction
-- D over the total category of an internal category IC (jonas.pdf
-- Definition 10, internal C), on presheaves over the total site (CTPsh).
--
-- An element of (D G) at (I, x) is a family t over the indices
--   q = (n, J, u : J -> I, z : Obj J, c : Ch_J n (res u x) z, i : coord n J)
-- with i landing in the weight (LandsI), of elements of G at (J, z): the
-- chain lives at the stage J of the weight, ending at the restriction of x.
-- Three equations (propositions):
--   nat   along v : J' -> J: the cartesian restriction of t q is t at
--         (n, J', u . v, res v z, the chain restricted (CChainsF at the
--         restriction functor, head moved along res-comp), Res i)
--   face  composing adjacent maps of the chain against the face of the weight
--   top   dropping the last map against the top face: G's vertical action
-- Part 1: the families, the equations, the fibre Ob'.  (Part 2: the
-- action along total maps and its laws, DCtx : TCtx.)
-- No new axioms beyond the named premises (fe through ob-eq, later).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
module VB = V[a] ;
module EM = Encode[a, vl] ;
module VL = VLift[vl, l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module DOfI (C : CIntCat[a, vl].IC) {
 module VT = CVert[a, vl].VertOf[C] ;
 module TP = CTPsh[a, vl, l].TPshOf[C] ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 module KJ (J : Ob) { module K = Chains[vl].ChainsOf[VT.VCat J] ; } ;
 module CT = CChainsT[a, vl].ChT[C] ;
 rCh (J' J I : Ob) (v : Hom J' J) (u : Hom J I) (x : Obj I) (n : Nat) (z : Obj J) (c : KJ[J].K.Ch n (C.res J I u x) z)
  : KJ[J'].K.Ch n (C.res J' I (compH J' J I u v) x) (C.res J' J v z) = CT.rCh J' J I v u x n z c ;

 -- codes of the indices
 -- the base's codes, embedded at the vertical level (Ix on the nose)
 embV (c : VB.V) : VA.V = EM.codeOf (VB.Ix c) (EM.encIx0 c) ;
 obVe : VA.V = embV obV ;
 homVe (J I : Ob) : VA.V = embV (homV J I) ;
 finV (r : Nat) : VA.V = VA.SigV VA.natV (\ j -> VA.IsTV (Ar.ltb j r)) ;
 coordV (n : Nat) (J : Ob) : VA.V = VA.PiV (finV (suc n)) (\ k -> homVe J PFO.ivO) ;
 idxV (I : Ob) (x : Obj I) : VA.V =
  VA.SigV VA.natV (\ n -> VA.SigV obVe (\ J -> VA.SigV (homVe J I) (\ u -> VA.SigV (C.obD J) (\ z ->
   VA.SigV (KJ[J].K.chV n (C.res J I u x) z) (\ c -> coordV n J))))) ;
 Idx (I : Ob) (x : Obj I) : U vl = VA.Ix (idxV I x) ;
 -- the weight condition of an index, a proposition
 LandsI (I : Ob) (x : Obj I) (q : Idx I x) : U a = PB.Lands q.2.1 q.2.1 (Wt.oneS q.1 q.2.1 q.2.2.2.2.2) (PB.idH q.2.1) ;
 isPropL (I : Ob) (x : Obj I) (q : Idx I x) : isProp (LandsI I x q) = PB.isProp-Lands q.2.1 q.2.1 (Wt.oneS q.1 q.2.1 q.2.2.2.2.2) (PB.idH q.2.1) ;
 -- Pi codes over an index code, and over a proposition
 piI (A : VA.V) (B : VA.Ix A -> W0.V) : W0.V = VL.PiS (VA.Ix A) (VL.encIx A) (VL.encIx-inj A) B ;
 piP (A : U a) (pA : isProp A) (B : A -> W0.V) : W0.V = VL.PiS A (\ u -> W0.emptyV) (\ u u' h -> pA u u') B ;
 piIP (A : VA.V) (B : VA.Ix A -> W0.V) (h : (q : VA.Ix A) -> isProp (W0.Ix (B q))) : isProp (W0.Ix (piI A B)) =
  isProp-Pi (VA.Ix A) (\ q -> W0.Ix (B q)) h ;
 piPP (A : U a) (pA : isProp A) (B : A -> W0.V) (h : (u : A) -> isProp (W0.Ix (B u))) : isProp (W0.Ix (piP A pA B)) =
  isProp-Pi A (\ u -> W0.Ix (B u)) h ;
 idProp (A : W0.V) (u v : W0.Ix A) : isProp (W0.Ix (W0.IdV A u v)) = W0.isSetIx A u v ;

 module DC (G : TP.TCtx) {
  -- the families
  tV (I : Ob) (x : Obj I) : W0.V = piI (idxV I x) (\ q -> piP (LandsI I x q) (isPropL I x q) (\ l -> G.ob q.2.1 q.2.2.2.1)) ;
  T (I : Ob) (x : Obj I) : U l = W0.Ix (tV I x) ;
  -- reading at a weight
  at (I : Ob) (x : Obj I) (t : T I x) (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : KJ[J].K.Ch n (C.res J I u x) z) (i : Wt.Pn n J)
   : W0.Ix (G.ob J z) = t (n, J, u, z, c, i.1) i.2 ;

  -- naturality in the base: index (q , J' , v : J' -> J)
  natIdxV (I : Ob) (x : Obj I) : VA.V = VA.SigV (idxV I x) (\ q -> VA.SigV obVe (\ J' -> homVe J' q.2.1)) ;
  natA (I : Ob) (x : Obj I) (r : VA.Ix (natIdxV I x)) : W0.V = G.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) ;
  natL (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (natIdxV I x)) (l : LandsI I x r.1) : W0.Ix (natA I x r) =
   TP.cartAct G r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1 (t r.1 l) ;
  natR (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (natIdxV I x)) (l : LandsI I x r.1) : W0.Ix (natA I x r) =
   at I x t r.1.1 r.2.1 (compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2) (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
    (rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1)
    (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res) ;
  natB (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (natIdxV I x)) : W0.V =
   piP (LandsI I x r.1) (isPropL I x r.1) (\ l -> W0.IdV (natA I x r) (natL I x t r l) (natR I x t r l)) ;
  natEq (I : Ob) (x : Obj I) (t : T I x) : W0.V = piI (natIdxV I x) (natB I x t) ;
  natP (I : Ob) (x : Obj I) (t : T I x) : isProp (W0.Ix (natEq I x t)) =
   piIP (natIdxV I x) (natB I x t) (\ r -> piPP (LandsI I x r.1) (isPropL I x r.1)
    (\ l -> W0.IdV (natA I x r) (natL I x t r l) (natR I x t r l)) (\ l -> idProp (natA I x r) (natL I x t r l) (natR I x t r l))) ;

  -- inner faces: index (n , k , k <= n , J , u , z , c : Ch (n+1) (res u x) z , i)
  faceIdxV (I : Ob) (x : Obj I) : VA.V =
   VA.SigV VA.natV (\ n -> VA.SigV VA.natV (\ k -> VA.SigV (VA.IsTV (Tr.leb k n)) (\ hk ->
    VA.SigV obVe (\ J -> VA.SigV (homVe J I) (\ u -> VA.SigV (C.obD J) (\ z ->
     VA.SigV (KJ[J].K.chV (suc n) (C.res J I u x) z) (\ c -> coordV n J))))))) ;
  faceLd (I : Ob) (x : Obj I) (r : VA.Ix (faceIdxV I x)) : U a =
   PB.Lands r.2.2.2.1 r.2.2.2.1 (Wt.oneS r.1 r.2.2.2.1 r.2.2.2.2.2.2.2) (PB.idH r.2.2.2.1) ;
  facePL (I : Ob) (x : Obj I) (r : VA.Ix (faceIdxV I x)) : isProp (faceLd I x r) =
   PB.isProp-Lands r.2.2.2.1 r.2.2.2.1 (Wt.oneS r.1 r.2.2.2.1 r.2.2.2.2.2.2.2) (PB.idH r.2.2.2.1) ;
  faceA (I : Ob) (x : Obj I) (r : VA.Ix (faceIdxV I x)) : W0.V = G.ob r.2.2.2.1 r.2.2.2.2.2.1 ;
  faceL (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (faceIdxV I x)) (l : faceLd I x r) : W0.Ix (faceA I x r) =
   at I x t (suc r.1) r.2.2.2.1 r.2.2.2.2.1 r.2.2.2.2.2.1 r.2.2.2.2.2.2.1
    (Wt.Face[r.1, r.2.2.2.1, r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1].Of[(r.2.2.2.2.2.2.2, l)].face) ;
  faceR (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (faceIdxV I x)) (l : faceLd I x r) : W0.Ix (faceA I x r) =
   t (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l ;
  faceB (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (faceIdxV I x)) : W0.V =
   piP (faceLd I x r) (facePL I x r) (\ l -> W0.IdV (faceA I x r) (faceL I x t r l) (faceR I x t r l)) ;
  faceEq (I : Ob) (x : Obj I) (t : T I x) : W0.V = piI (faceIdxV I x) (faceB I x t) ;
  faceP (I : Ob) (x : Obj I) (t : T I x) : isProp (W0.Ix (faceEq I x t)) =
   piIP (faceIdxV I x) (faceB I x t) (\ r -> piPP (faceLd I x r) (facePL I x r)
    (\ l -> W0.IdV (faceA I x r) (faceL I x t r l) (faceR I x t r l)) (\ l -> idProp (faceA I x r) (faceL I x t r l) (faceR I x t r l))) ;

  -- the top face: index (n , J , u , z , c : Ch (n+1) (res u x) z , i); G's vertical action along the last map
  topIdxV (I : Ob) (x : Obj I) : VA.V =
   VA.SigV VA.natV (\ n -> VA.SigV obVe (\ J -> VA.SigV (homVe J I) (\ u -> VA.SigV (C.obD J) (\ z ->
    VA.SigV (KJ[J].K.chV (suc n) (C.res J I u x) z) (\ c -> coordV n J))))) ;
  topLd (I : Ob) (x : Obj I) (r : VA.Ix (topIdxV I x)) : U a =
   PB.Lands r.2.1 r.2.1 (Wt.oneS r.1 r.2.1 r.2.2.2.2.2) (PB.idH r.2.1) ;
  topPL (I : Ob) (x : Obj I) (r : VA.Ix (topIdxV I x)) : isProp (topLd I x r) =
   PB.isProp-Lands r.2.1 r.2.1 (Wt.oneS r.1 r.2.1 r.2.2.2.2.2) (PB.idH r.2.1) ;
  topA (I : Ob) (x : Obj I) (r : VA.Ix (topIdxV I x)) : W0.V = G.ob r.2.1 r.2.2.2.1 ;
  topD (I : Ob) (x : Obj I) (r : VA.Ix (topIdxV I x)) : KJ[r.2.1].K.DR r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 =
   KJ[r.2.1].K.drop r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1 ;
  topL (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (topIdxV I x)) (l : topLd I x r) : W0.Ix (topA I x r) =
   at I x t (suc r.1) r.2.1 r.2.2.1 r.2.2.2.1 r.2.2.2.2.1
    (Wt.Face[r.1, r.2.1, suc r.1, Tr.leb-refl (suc r.1)].Of[(r.2.2.2.2.2, l)].face) ;
  topR (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (topIdxV I x)) (l : topLd I x r) : W0.Ix (topA I x r) =
   TP.vertAct G r.2.1 r.2.2.2.1 (topD I x r).1 (topD I x r).2.2
    (t (r.1, r.2.1, r.2.2.1, (topD I x r).1, (topD I x r).2.1, r.2.2.2.2.2) l) ;
  topB (I : Ob) (x : Obj I) (t : T I x) (r : VA.Ix (topIdxV I x)) : W0.V =
   piP (topLd I x r) (topPL I x r) (\ l -> W0.IdV (topA I x r) (topL I x t r l) (topR I x t r l)) ;
  topEq (I : Ob) (x : Obj I) (t : T I x) : W0.V = piI (topIdxV I x) (topB I x t) ;
  topP (I : Ob) (x : Obj I) (t : T I x) : isProp (W0.Ix (topEq I x t)) =
   piIP (topIdxV I x) (topB I x t) (\ r -> piPP (topLd I x r) (topPL I x r)
    (\ l -> W0.IdV (topA I x r) (topL I x t r l) (topR I x t r l)) (\ l -> idProp (topA I x r) (topL I x t r l) (topR I x t r l))) ;

  -- the equations form a proposition; the fibre of D G at (I, x)
  EqsV (I : Ob) (x : Obj I) (t : T I x) : W0.V = W0.SigV (natEq I x t) (\ p -> W0.SigV (faceEq I x t) (\ p' -> topEq I x t)) ;
  eqs-prop (I : Ob) (x : Obj I) (t : T I x) : isProp (W0.Ix (EqsV I x t)) =
   isProp-Sigma (W0.Ix (natEq I x t)) (\ p -> W0.Ix (W0.SigV (faceEq I x t) (\ p' -> topEq I x t))) (natP I x t)
    (\ p -> isProp-Sigma (W0.Ix (faceEq I x t)) (\ p' -> W0.Ix (topEq I x t)) (faceP I x t) (\ p' -> topP I x t)) ;
  obV' (I : Ob) (x : Obj I) : W0.V = W0.SigV (tV I x) (\ t -> EqsV I x t) ;
  Ob' (I : Ob) (x : Obj I) : U l = W0.Ix (obV' I x) ;
  -- elements are equal when their families are
  ob-eq (I : Ob) (x : Obj I) (w w' : Ob' I x) (H : (q : Idx I x) (l : LandsI I x q) -> Id (W0.Ix (G.ob q.2.1 q.2.2.2.1)) (w.1 q l) (w'.1 q l))
   : Id (Ob' I x) w w' =
   Sigma-path (T I x) (\ t -> W0.Ix (EqsV I x t)) w.1 w'.1 w.2 w'.2
    (funext (Idx I x) (\ q -> (l : LandsI I x q) -> W0.Ix (G.ob q.2.1 q.2.2.2.1)) w.1 w'.1 (\ q ->
      funext (LandsI I x q) (\ l -> W0.Ix (G.ob q.2.1 q.2.2.2.1)) (w.1 q) (w'.1 q) (H q)))
    (eqs-prop I x w'.1 _ w'.2) ;

  -- the slice of the indices at fixed (n, J, z, i): pairs (u, chain ending at res u x)
  S (I : Ob) (x : Obj I) (n : Nat) (J : Ob) (z : Obj J) : U vl = (u : Hom J I) * KJ[J].K.Ch n (C.res J I u x) z ;
  sEq (I : Ob) (x : Obj I) (n : Nat) (J : Ob) (z : Obj J) (u u' : Hom J I) (p : Id (Hom J I) u u') (c : KJ[J].K.Ch n (C.res J I u x) z) (c' : KJ[J].K.Ch n (C.res J I u' x) z)
   (e : Id (KJ[J].K.Ch n (C.res J I u' x) z) (CT.trCh J n (C.res J I u x) (C.res J I u' x) (apH {Hom J I} {Obj J} (\ w -> C.res J I w x) p) z c) c')
   : Id (S I x n J z) (u, c) (u', c') =
   idJ (Hom J I) u (\ w q -> (c2 : KJ[J].K.Ch n (C.res J I w x) z) -> Id (KJ[J].K.Ch n (C.res J I w x) z) (CT.trCh J n (C.res J I u x) (C.res J I w x) (apH {Hom J I} {Obj J} (\ w' -> C.res J I w' x) q) z c) c2 -> Id (S I x n J z) (u, c) (w, c2))
    (\ c2 e2 -> apH {KJ[J].K.Ch n (C.res J I u x) z} {S I x n J z} (\ w -> (u, w)) e2) u' p c' e ;
  -- the reading of a family on the slice
  rd (I : Ob) (x : Obj I) (t : T I x) (n : Nat) (J : Ob) (z : Obj J) (i : VA.Ix (coordV n J)) (w : S I x n J z) (l : LandsI I x (n, J, w.1, z, w.2, i)) : W0.Ix (G.ob J z) =
   t (n, J, w.1, z, w.2, i) l ;

  ------------------------------------------------------------------
  -- the action along a total map (u0 : J0 -> I, f0 : homD u0 y x):
  -- precompose the base map, reindex the chains along the restriction of
  -- the vertical part of f0 (rxM)
  module Act (J0 I : Ob) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y x) (w : Ob' I x) {
   g0 : VT.VMap J0 y (C.res J0 I u0 x) = VT.vpart J0 I u0 y x f0 ;
   rq (q : Idx J0 y) : Idx I x = (q.1, q.2.1, compH q.2.1 J0 I u0 q.2.2.1, q.2.2.2.1, CT.rxM q.2.1 J0 I q.2.2.1 u0 y x g0 q.1 q.2.2.2.1 q.2.2.2.2.1, q.2.2.2.2.2) ;
   t' : T J0 y = \ q l -> w.1 (rq q) l ;
   -- naturality in the base: the key lemma, through the slice
   natPath (r : VA.Ix (natIdxV J0 y)) (l : LandsI J0 y r.1)
    : Id (S I x r.1.1 r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))
        (compH r.2.1 r.1.2.1 I (compH r.1.2.1 J0 I u0 r.1.2.2.1) r.2.2, CT.rCh r.2.1 r.1.2.1 I r.2.2 (compH r.1.2.1 J0 I u0 r.1.2.2.1) x r.1.1 r.1.2.2.2.1 (CT.rxM r.1.2.1 J0 I r.1.2.2.1 u0 y x g0 r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1))
        (compH r.2.1 J0 I u0 (compH r.2.1 r.1.2.1 J0 r.1.2.2.1 r.2.2), CT.rxM r.2.1 J0 I (compH r.2.1 r.1.2.1 J0 r.1.2.2.1 r.2.2) u0 y x g0 r.1.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (CT.rCh r.2.1 r.1.2.1 J0 r.2.2 r.1.2.2.1 y r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1)) =
    sEq I x r.1.1 r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
     (compH r.2.1 r.1.2.1 I (compH r.1.2.1 J0 I u0 r.1.2.2.1) r.2.2) (compH r.2.1 J0 I u0 (compH r.2.1 r.1.2.1 J0 r.1.2.2.1 r.2.2))
     (comp-assoc r.2.1 r.1.2.1 J0 I u0 r.1.2.2.1 r.2.2)
     (CT.rCh r.2.1 r.1.2.1 I r.2.2 (compH r.1.2.1 J0 I u0 r.1.2.2.1) x r.1.1 r.1.2.2.2.1 (CT.rxM r.1.2.1 J0 I r.1.2.2.1 u0 y x g0 r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1))
     (CT.rxM r.2.1 J0 I (compH r.2.1 r.1.2.1 J0 r.1.2.2.1 r.2.2) u0 y x g0 r.1.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (CT.rCh r.2.1 r.1.2.1 J0 r.2.2 r.1.2.2.1 y r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1))
     (CT.RR[r.2.1, r.1.2.1, J0, I, r.2.2, r.1.2.2.1, u0, y, x, g0, r.1.1, r.1.2.2.2.1, r.1.2.2.2.2.1].law) ;
   nat' : W0.Ix (natEq J0 y t') = \ r l ->
    transH (w.2.1 (rq r.1, r.2) l)
     (apH {S I x r.1.1 r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} {W0.Ix (G.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))}
        (\ sw -> rd I x w.1 r.1.1 r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1 sw (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)
        (natPath r l)) ;
   -- the inner faces: the reindexing commutes with composing adjacent maps
   facePath (r : VA.Ix (faceIdxV J0 y))
    : Id (KJ[r.2.2.2.1].K.Ch r.1 (C.res r.2.2.2.1 I (compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1) x) r.2.2.2.2.2.1)
        (KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I (compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1) x) r.2.2.2.2.2.1 (CT.rxM r.2.2.2.1 J0 I r.2.2.2.2.1 u0 y x g0 (suc r.1) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1))
        (CT.rxM r.2.2.2.1 J0 I r.2.2.2.2.1 u0 y x g0 r.1 r.2.2.2.2.2.1 (KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 J0 r.2.2.2.2.1 y) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1)) =
    transH (CT.trCh-comp r.2.2.2.1 r.1 r.2.1 (C.res r.2.2.2.1 J0 r.2.2.2.2.1 (C.res J0 I u0 x)) (C.res r.2.2.2.1 I (compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1) x) (symH (C.res-comp r.2.2.2.1 J0 I u0 r.2.2.2.2.1 x)) r.2.2.2.2.2.1
              (KJ[r.2.2.2.1].K.rx (suc r.1) (C.res r.2.2.2.1 J0 r.2.2.2.2.1 y) (C.res r.2.2.2.1 J0 r.2.2.2.2.1 (C.res J0 I u0 x)) (VT.rmap r.2.2.2.1 J0 r.2.2.2.2.1 y (C.res J0 I u0 x) g0) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1))
     (apH {KJ[r.2.2.2.1].K.Ch r.1 (C.res r.2.2.2.1 J0 r.2.2.2.2.1 (C.res J0 I u0 x)) r.2.2.2.2.2.1} {KJ[r.2.2.2.1].K.Ch r.1 (C.res r.2.2.2.1 I (compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1) x) r.2.2.2.2.2.1}
        (\ cc -> CT.trCh r.2.2.2.1 r.1 (C.res r.2.2.2.1 J0 r.2.2.2.2.1 (C.res J0 I u0 x)) (C.res r.2.2.2.1 I (compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1) x) (symH (C.res-comp r.2.2.2.1 J0 I u0 r.2.2.2.2.1 x)) r.2.2.2.2.2.1 cc)
        (KJ[r.2.2.2.1].K.rx-comp r.1 r.2.1 (C.res r.2.2.2.1 J0 r.2.2.2.2.1 y) (C.res r.2.2.2.1 J0 r.2.2.2.2.1 (C.res J0 I u0 x)) (VT.rmap r.2.2.2.1 J0 r.2.2.2.2.1 y (C.res J0 I u0 x) g0) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1)) ;
   face' : W0.Ix (faceEq J0 y t') = \ r l ->
    transH (w.2.2.1 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1, r.2.2.2.2.2.1,
                      CT.rxM r.2.2.2.1 J0 I r.2.2.2.2.1 u0 y x g0 (suc r.1) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)
     (apH {KJ[r.2.2.2.1].K.Ch r.1 (C.res r.2.2.2.1 I (compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1) x) r.2.2.2.2.2.1} {W0.Ix (G.ob r.2.2.2.1 r.2.2.2.2.2.1)}
        (\ cc -> w.1 (r.1, r.2.2.2.1, compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1, r.2.2.2.2.2.1, cc, r.2.2.2.2.2.2.2) l) (facePath r)) ;
   -- the top face: dropping the last map commutes with the reindexing
   module Top (n : Nat) (J : Ob) (u : Hom J J0) (z : Obj J) (c : KJ[J].K.Ch (suc n) (C.res J J0 u y) z) (i : VA.Ix (coordV n J)) (lt : topLd J0 y (n, J, u, z, c, i)) {
    uu : Hom J I = compH J J0 I u0 u ;
    X0 : Obj J0 = C.res J0 I u0 x ;
    Y' : Obj J = C.res J J0 u X0 ;
    X' : Obj J = C.res J I uu x ;
    p : Id (Obj J) Y' X' = symH (C.res-comp J J0 I u0 u x) ;
    h : VT.VMap J (C.res J J0 u y) Y' = VT.rmap J J0 u y X0 g0 ;
    c' : KJ[J].K.Ch (suc n) X' z = CT.rxM J J0 I u u0 y x g0 (suc n) z c ;
    dc : KJ[J].K.DR n (C.res J J0 u y) z = KJ[J].K.drop n (C.res J J0 u y) z c ;
    dEq : Id (KJ[J].K.DR n X' z) (KJ[J].K.drop n X' z c') (dc.1, CT.rxM J J0 I u u0 y x g0 n dc.1 dc.2.1, dc.2.2) =
     transH (CT.trCh-drop J n Y' X' p z (KJ[J].K.rx (suc n) (C.res J J0 u y) Y' h z c))
      (apH {KJ[J].K.DR n Y' z} {KJ[J].K.DR n X' z} (\ D -> (D.1, CT.trCh J n Y' X' p D.1 D.2.1, D.2.2)) (KJ[J].K.rx-drop n (C.res J J0 u y) Y' h z c)) ;
    eq : Id (W0.Ix (G.ob J z)) (topL J0 y t' (n, J, u, z, c, i) lt) (topR J0 y t' (n, J, u, z, c, i) lt) =
     transH (w.2.2.2 (n, J, uu, z, c', i) lt)
      (apH {KJ[J].K.DR n X' z} {W0.Ix (G.ob J z)} (\ D -> TP.vertAct G J z D.1 D.2.2 (w.1 (n, J, uu, D.1, D.2.1, i) lt)) dEq) ;
   } ;
   top' : W0.Ix (topEq J0 y t') = \ r lt -> Top[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2, lt].eq ;
   res : Ob' J0 y = (t', nat', face', top') ;
  } ;
  act (J0 I : Ob) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y x) (w : Ob' I x) : Ob' J0 y = Act[J0, I, u0, y, x, f0, w].res ;

  -- the laws of the action, through the slice and the chain laws
  -- the slice paths of the two laws
  idPath (I : Ob) (x : Obj I) (q : Idx I x)
   : Id (S I x q.1 q.2.1 q.2.2.2.1) (compH q.2.1 I I (idH I) q.2.2.1, CT.rxM q.2.1 I I q.2.2.1 (idH I) x x (VT.vpart I I (idH I) x x (C.idD I x)) q.1 q.2.2.2.1 q.2.2.2.2.1) (q.2.2.1, q.2.2.2.2.1) =
   sEq I x q.1 q.2.1 q.2.2.2.1 (compH q.2.1 I I (idH I) q.2.2.1) q.2.2.1 (comp-idl q.2.1 I q.2.2.1)
    (CT.rxM q.2.1 I I q.2.2.1 (idH I) x x (VT.vpart I I (idH I) x x (C.idD I x)) q.1 q.2.2.2.1 q.2.2.2.2.1) q.2.2.2.2.1
    CT.RxId[q.2.1, I, q.2.2.1, x, q.1, q.2.2.2.1, q.2.2.2.2.1].law ;
  oPath (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : Obj K) (y : Obj J) (x : Obj I) (f : VT.HomD J I u y x) (f' : VT.HomD K J v z y) (q : Idx K z)
   : Id (S I x q.1 q.2.1 q.2.2.2.1)
       (compH q.2.1 J I u (compH q.2.1 K J v q.2.2.1), CT.rxM q.2.1 J I (compH q.2.1 K J v q.2.2.1) u y x (VT.vpart J I u y x f) q.1 q.2.2.2.1 (CT.rxM q.2.1 K J q.2.2.1 v z y (VT.vpart K J v z y f') q.1 q.2.2.2.1 q.2.2.2.2.1))
       (compH q.2.1 K I (compH K J I u v) q.2.2.1, CT.rxM q.2.1 K I q.2.2.1 (compH K J I u v) z x (VT.vpart K I (compH K J I u v) z x (C.compD K J I u v z y x f f')) q.1 q.2.2.2.1 q.2.2.2.2.1) =
   sEq I x q.1 q.2.1 q.2.2.2.1 (compH q.2.1 J I u (compH q.2.1 K J v q.2.2.1)) (compH q.2.1 K I (compH K J I u v) q.2.2.1) (symH (comp-assoc q.2.1 K J I u v q.2.2.1))
    (CT.rxM q.2.1 J I (compH q.2.1 K J v q.2.2.1) u y x (VT.vpart J I u y x f) q.1 q.2.2.2.1 (CT.rxM q.2.1 K J q.2.2.1 v z y (VT.vpart K J v z y f') q.1 q.2.2.2.1 q.2.2.2.2.1))
    (CT.rxM q.2.1 K I q.2.2.1 (compH K J I u v) z x (VT.vpart K I (compH K J I u v) z x (C.compD K J I u v z y x f f')) q.1 q.2.2.2.1 q.2.2.2.2.1)
    CT.RxO[q.2.1, K, J, I, q.2.2.1, v, u, z, y, x, f, f', q.1, q.2.2.2.1, q.2.2.2.2.1].law ;
  act-id (I : Ob) (x : Obj I) (w : Ob' I x) : Id (Ob' I x) (act I I (idH I) x x (C.idD I x) w) w =
   ob-eq I x (act I I (idH I) x x (C.idD I x) w) w (\ q l ->
    apH {S I x q.1 q.2.1 q.2.2.2.1} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ sw -> rd I x w.1 q.1 q.2.1 q.2.2.2.1 q.2.2.2.2.2 sw l) (idPath I x q)) ;
  act-o (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : Obj K) (y : Obj J) (x : Obj I) (f : VT.HomD J I u y x) (f' : VT.HomD K J v z y) (w : Ob' I x)
   : Id (Ob' K z) (act K I (compH K J I u v) z x (C.compD K J I u v z y x f f') w) (act K J v z y f' (act J I u y x f w)) =
   ob-eq K z (act K I (compH K J I u v) z x (C.compD K J I u v z y x f f') w) (act K J v z y f' (act J I u y x f w)) (\ q l ->
    symH (apH {S I x q.1 q.2.1 q.2.2.2.1} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ sw -> rd I x w.1 q.1 q.2.1 q.2.2.2.1 q.2.2.2.2.2 sw l) (oPath K J I u v z y x f f' q))) ;

  -- D G as a presheaf over the total site
  DCtx : TP.TCtx = new TP.TCtx[\ I x -> obV' I x, \ J I u y x f w -> act J I u y x f w, act-id, act-o] ;

  ------------------------------------------------------------------
  -- the unit tau : G -> D G: (tau g) at (n, J, u, z, c, i) is g acted on
  -- along the total map (u, cart u x . tot c) : (J, z) -> (I, x)
  tmap (I : Ob) (x : Obj I) (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : KJ[J].K.Ch n (C.res J I u x) z) : VT.HomD J I u z x =
   VT.trH J I (compH J J I u (idH J)) u (comp-idr J I u) z x
    (C.compD J J I u (idH J) z (C.res J I u x) x (C.cart J I u x) (KJ[J].K.tot n (C.res J I u x) z c)) ;
  -- as a total map: (u, tmap) = (u . id, cart u x . tot c)
  tmap-eq (I : Ob) (x : Obj I) (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : KJ[J].K.Ch n (C.res J I u x) z)
   : Id (VT.TH J z I x) (u, tmap I x n J u z c) (compH J J I u (idH J), C.compD J J I u (idH J) z (C.res J I u x) x (C.cart J I u x) (KJ[J].K.tot n (C.res J I u x) z c)) =
   VT.TH-tr J I (compH J J I u (idH J)) u (comp-idr J I u) z x (C.compD J J I u (idH J) z (C.res J I u x) x (C.cart J I u x) (KJ[J].K.tot n (C.res J I u x) z c)) ;
  -- the action of G along a total map, read in the total hom
  actT (I : Ob) (x : Obj I) (J : Ob) (z : Obj J) (h : VT.TH J z I x) (g : W0.Ix (G.ob I x)) : W0.Ix (G.ob J z) = G.act J I h.1 z x h.2 g ;

  module Tau (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) {
   t' : T I x = \ q l -> actT I x q.2.1 q.2.2.2.1 (q.2.2.1, tmap I x q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) g ;
   -- naturality: cart v z . (cart u x . tot c) = cart (u . v) x . tot (rCh c), as total maps
   module TNat (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : KJ[J].K.Ch n (C.res J I u x) z) (J' : Ob) (v : Hom J' J) {
    rz : Obj J' = C.res J' J v z ;
    rux : Obj J = C.res J I u x ;
    tc : VT.VMap J z rux = KJ[J].K.tot n rux z c ;
    uv : Hom J' I = compH J' J I u v ;
    rc : Id (Obj J') (C.res J' I uv x) (C.res J' J v rux) = C.res-comp J' J I u v x ;
    cvz : VT.HomD J' J v rz z = C.cart J' J v z ;
    tr : VT.VMap J' rz (C.res J' I uv x) = KJ[J'].K.tot n (C.res J' I uv x) rz (rCh J' J I v u x n z c) ;
    -- the left-hand side: (u . v, (cart u x . tot c) . cart v z)
    e1 : Id (VT.TH J' rz I x) (compH J' J I u v, C.compD J' J I u v rz z x (tmap I x n J u z c) cvz)
           (compH J' J I (compH J J I u (idH J)) v, C.compD J' J I (compH J J I u (idH J)) v rz z x (C.compD J J I u (idH J) z rux x (C.cart J I u x) tc) cvz) =
     VT.cmpR J' J I v rz z x cvz (u, tmap I x n J u z c) (compH J J I u (idH J), C.compD J J I u (idH J) z rux x (C.cart J I u x) tc) (tmap-eq I x n J u z c) ;
    e2 : Id (VT.TH J' rz I x) (compH J' J I (compH J J I u (idH J)) v, C.compD J' J I (compH J J I u (idH J)) v rz z x (C.compD J J I u (idH J) z rux x (C.cart J I u x) tc) cvz)
           (compH J' J I u (compH J' J J (idH J) v), C.compD J' J I u (compH J' J J (idH J) v) rz rux x (C.cart J I u x) (C.compD J' J J (idH J) v rz z rux tc cvz)) =
     C.assoc J' J J I u (idH J) v rz z rux x (C.cart J I u x) tc cvz ;
    -- tot c . cart v z = cart v rux . rmap v (tot c)
    e3 : Id (VT.TH J' rz J rux) (compH J' J J (idH J) v, C.compD J' J J (idH J) v rz z rux tc cvz)
           (compH J' J' J v (idH J'), C.compD J' J' J v (idH J') rz (C.res J' J v rux) rux (C.cart J' J v rux) (VT.rmap J' J v z rux tc)) =
     symH (VT.rmap-eq J' J v z rux tc) ;
    e4 : Id (VT.TH J' rz I x) (compH J' J I u (compH J' J J (idH J) v), C.compD J' J I u (compH J' J J (idH J) v) rz rux x (C.cart J I u x) (C.compD J' J J (idH J) v rz z rux tc cvz))
           (compH J' J I u (compH J' J' J v (idH J')), C.compD J' J I u (compH J' J' J v (idH J')) rz rux x (C.cart J I u x) (C.compD J' J' J v (idH J') rz (C.res J' J v rux) rux (C.cart J' J v rux) (VT.rmap J' J v z rux tc))) =
     VT.cmpL J' J I u rz rux x (C.cart J I u x) (compH J' J J (idH J) v, C.compD J' J J (idH J) v rz z rux tc cvz)
       (compH J' J' J v (idH J'), C.compD J' J' J v (idH J') rz (C.res J' J v rux) rux (C.cart J' J v rux) (VT.rmap J' J v z rux tc)) e3 ;
    -- = cart (u . v) x . (rmap v (tot c) moved) = cart (u . v) x . tot (rCh c)
    e5 : Id (VT.TH J' rz I x) (compH J' J' I uv (idH J'), C.compD J' J' I uv (idH J') rz (C.res J' I uv x) x (C.cart J' I uv x) (VT.trC J' J' (idH J') rz (C.res J' J v rux) (C.res J' I uv x) (symH rc) (VT.rmap J' J v z rux tc)))
           (compH J' J I u (compH J' J' J v (idH J')), C.compD J' J I u (compH J' J' J v (idH J')) rz rux x (C.cart J I u x) (C.compD J' J' J v (idH J') rz (C.res J' J v rux) rux (C.cart J' J v rux) (VT.rmap J' J v z rux tc))) =
     VT.cc-tr J' J I u v rz x (VT.rmap J' J v z rux tc) ;
    e6 : Id (VT.TH J' rz I x) (uv, tmap I x n J' uv rz (rCh J' J I v u x n z c))
           (compH J' J' I uv (idH J'), C.compD J' J' I uv (idH J') rz (C.res J' I uv x) x (C.cart J' I uv x) (VT.trC J' J' (idH J') rz (C.res J' J v rux) (C.res J' I uv x) (symH rc) (VT.rmap J' J v z rux tc))) =
     transH (tmap-eq I x n J' uv rz (rCh J' J I v u x n z c))
      (VT.cmpL J' J' I uv rz (C.res J' I uv x) x (C.cart J' I uv x) (idH J', tr) (idH J', VT.trC J' J' (idH J') rz (C.res J' J v rux) (C.res J' I uv x) (symH rc) (VT.rmap J' J v z rux tc))
        (VT.pairL J' J' (idH J') rz (C.res J' I uv x) tr (VT.trC J' J' (idH J') rz (C.res J' J v rux) (C.res J' I uv x) (symH rc) (VT.rmap J' J v z rux tc)) (CT.tot-rCh J' J I v u x n z c))) ;
    law : Id (VT.TH J' rz I x) (compH J' J I u v, C.compD J' J I u v rz z x (tmap I x n J u z c) cvz) (uv, tmap I x n J' uv rz (rCh J' J I v u x n z c)) =
     transH e1 (transH e2 (transH e4 (symH (transH e6 e5)))) ;
   } ;
   nat' : W0.Ix (natEq I x t') = \ r l ->
    transH (symH (G.act-o r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) r.1.2.2.2.1 x (tmap I x r.1.1 r.1.2.1 r.1.2.2.1 r.1.2.2.2.1 r.1.2.2.2.2.1) (C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) g))
     (apH {VT.TH r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) I x} {W0.Ix (G.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} (\ h -> actT I x r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) h g)
        TNat[r.1.1, r.1.2.1, r.1.2.2.1, r.1.2.2.2.1, r.1.2.2.2.2.1, r.2.1, r.2.2].law) ;
   -- faces: the composite of a chain is unchanged by composing adjacent maps
   face' : W0.Ix (faceEq I x t') = \ r l ->
    apH {KJ[r.2.2.2.1].K.CH r.2.2.2.2.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x)} {W0.Ix (G.ob r.2.2.2.1 r.2.2.2.2.2.1)}
     (\ k' -> actT I x r.2.2.2.1 r.2.2.2.2.2.1 (r.2.2.2.2.1, VT.trH r.2.2.2.1 I (compH r.2.2.2.1 r.2.2.2.1 I r.2.2.2.2.1 (idH r.2.2.2.1)) r.2.2.2.2.1 (comp-idr r.2.2.2.1 I r.2.2.2.2.1) r.2.2.2.2.2.1 x
                 (C.compD r.2.2.2.1 r.2.2.2.1 I r.2.2.2.2.1 (idH r.2.2.2.1) r.2.2.2.2.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) x (C.cart r.2.2.2.1 I r.2.2.2.2.1 x) k')) g)
     (symH (KJ[r.2.2.2.1].K.tot-comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1)) ;
   -- the top face: tot c = tot (drop c) . last map, then associativity
   module Top (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : KJ[J].K.Ch (suc n) (C.res J I u x) z) {
    rux : Obj J = C.res J I u x ;
    dc : KJ[J].K.DR n rux z = KJ[J].K.drop n rux z c ;
    e1 : Id (VT.TH J z I x) (u, tmap I x (suc n) J u z c)
           (compH J J I u (idH J), C.compD J J I u (idH J) z rux x (C.cart J I u x) (VT.vcomp J z dc.1 rux (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2)) =
     transH (tmap-eq I x (suc n) J u z c)
      (VT.pairL J I (compH J J I u (idH J)) z x (C.compD J J I u (idH J) z rux x (C.cart J I u x) (KJ[J].K.tot (suc n) rux z c))
         (C.compD J J I u (idH J) z rux x (C.cart J I u x) (VT.vcomp J z dc.1 rux (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2))
         (apH {VT.VMap J z rux} {VT.HomD J I (compH J J I u (idH J)) z x} (\ w -> C.compD J J I u (idH J) z rux x (C.cart J I u x) w) (KJ[J].K.tot-drop n rux z c))) ;
    e2 : Id (VT.TH J z I x) (compH J J I u (idH J), C.compD J J I u (idH J) z rux x (C.cart J I u x) (VT.vcomp J z dc.1 rux (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2))
           (compH J J I u (compH J J J (idH J) (idH J)), C.compD J J I u (compH J J J (idH J) (idH J)) z rux x (C.cart J I u x) (C.compD J J J (idH J) (idH J) z dc.1 rux (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2)) =
     VT.cmpL J J I u z rux x (C.cart J I u x) (idH J, VT.vcomp J z dc.1 rux (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2)
       (compH J J J (idH J) (idH J), C.compD J J J (idH J) (idH J) z dc.1 rux (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2) (VT.vcomp-eq J z dc.1 rux (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2) ;
    e3 : Id (VT.TH J z I x) (compH J J I u (compH J J J (idH J) (idH J)), C.compD J J I u (compH J J J (idH J) (idH J)) z rux x (C.cart J I u x) (C.compD J J J (idH J) (idH J) z dc.1 rux (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2))
           (compH J J I (compH J J I u (idH J)) (idH J), C.compD J J I (compH J J I u (idH J)) (idH J) z dc.1 x (C.compD J J I u (idH J) dc.1 rux x (C.cart J I u x) (KJ[J].K.tot n rux dc.1 dc.2.1)) dc.2.2) =
     symH (C.assoc J J J I u (idH J) (idH J) z dc.1 rux x (C.cart J I u x) (KJ[J].K.tot n rux dc.1 dc.2.1) dc.2.2) ;
    e4 : Id (VT.TH J z I x) (compH J J I (compH J J I u (idH J)) (idH J), C.compD J J I (compH J J I u (idH J)) (idH J) z dc.1 x (C.compD J J I u (idH J) dc.1 rux x (C.cart J I u x) (KJ[J].K.tot n rux dc.1 dc.2.1)) dc.2.2)
           (compH J J I u (idH J), C.compD J J I u (idH J) z dc.1 x (tmap I x n J u dc.1 dc.2.1) dc.2.2) =
     VT.cmpR J J I (idH J) z dc.1 x dc.2.2 (compH J J I u (idH J), C.compD J J I u (idH J) dc.1 rux x (C.cart J I u x) (KJ[J].K.tot n rux dc.1 dc.2.1)) (u, tmap I x n J u dc.1 dc.2.1) (symH (tmap-eq I x n J u dc.1 dc.2.1)) ;
    law : Id (VT.TH J z I x) (u, tmap I x (suc n) J u z c) (compH J J I u (idH J), C.compD J J I u (idH J) z dc.1 x (tmap I x n J u dc.1 dc.2.1) dc.2.2) =
     transH e1 (transH e2 (transH e3 e4)) ;
   } ;
   top' : W0.Ix (topEq I x t') = \ r l ->
    transH (apH {VT.TH r.2.1 r.2.2.2.1 I x} {W0.Ix (G.ob r.2.1 r.2.2.2.1)} (\ h -> actT I x r.2.1 r.2.2.2.1 h g) Top[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1].law)
     (G.act-o r.2.1 r.2.1 I r.2.2.1 (idH r.2.1) r.2.2.2.1 (topD I x r).1 x (tmap I x r.1 r.2.1 r.2.2.1 (topD I x r).1 (topD I x r).2.1) (topD I x r).2.2 g) ;
   res : Ob' I x = (t', nat', face', top') ;
  } ;
  tau (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) : Ob' I x = Tau[I, x, g].res ;

  -- naturality of tau along a total map (u0, f0) : (J0, y) -> (I, x):
  -- f0 . (cart u y . tot c) = cart (u0 . u) x . tot (rxM c), as total maps
  module TauNat (J0 I : Ob) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y x) (n : Nat) (J : Ob) (u : Hom J J0) (z : Obj J) (c : KJ[J].K.Ch n (C.res J J0 u y) z) {
   g0 : VT.VMap J0 y (C.res J0 I u0 x) = VT.vpart J0 I u0 y x f0 ;
   ruy : Obj J = C.res J J0 u y ;
   rx0 : Obj J0 = C.res J0 I u0 x ;
   u0u : Hom J I = compH J J0 I u0 u ;
   rc : Id (Obj J) (C.res J I u0u x) (C.res J J0 u rx0) = C.res-comp J J0 I u0 u x ;
   tc : VT.VMap J z ruy = KJ[J].K.tot n ruy z c ;
   rg : VT.VMap J ruy (C.res J J0 u rx0) = VT.rmap J J0 u y rx0 g0 ;
   e1 : Id (VT.TH J z I x) (compH J J0 I u0 u, C.compD J J0 I u0 u z y x f0 (tmap J0 y n J u z c))
          (compH J J0 I u0 (compH J J J0 u (idH J)), C.compD J J0 I u0 (compH J J J0 u (idH J)) z y x f0 (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc)) =
    VT.cmpL J J0 I u0 z y x f0 (u, tmap J0 y n J u z c) (compH J J J0 u (idH J), C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc) (tmap-eq J0 y n J u z c) ;
   e2 : Id (VT.TH J z I x) (compH J J0 I u0 (compH J J J0 u (idH J)), C.compD J J0 I u0 (compH J J J0 u (idH J)) z y x f0 (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc))
          (compH J J0 I (compH J0 J0 I u0 (idH J0)) (compH J J J0 u (idH J)), C.compD J J0 I (compH J0 J0 I u0 (idH J0)) (compH J J J0 u (idH J)) z y x (C.compD J0 J0 I u0 (idH J0) y rx0 x (C.cart J0 I u0 x) g0) (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc)) =
    VT.cmpR J J0 I (compH J J J0 u (idH J)) z y x (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc) (u0, f0) (compH J0 J0 I u0 (idH J0), C.compD J0 J0 I u0 (idH J0) y rx0 x (C.cart J0 I u0 x) g0) (symH (VT.vpart-eq J0 I u0 y x f0)) ;
   e3 : Id (VT.TH J z I x) (compH J J0 I (compH J0 J0 I u0 (idH J0)) (compH J J J0 u (idH J)), C.compD J J0 I (compH J0 J0 I u0 (idH J0)) (compH J J J0 u (idH J)) z y x (C.compD J0 J0 I u0 (idH J0) y rx0 x (C.cart J0 I u0 x) g0) (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc))
          (compH J J0 I u0 (compH J J0 J0 (idH J0) (compH J J J0 u (idH J))), C.compD J J0 I u0 (compH J J0 J0 (idH J0) (compH J J J0 u (idH J))) z rx0 x (C.cart J0 I u0 x) (C.compD J J0 J0 (idH J0) (compH J J J0 u (idH J)) z y rx0 g0 (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc))) =
    C.assoc J J0 J0 I u0 (idH J0) (compH J J J0 u (idH J)) z y rx0 x (C.cart J0 I u0 x) g0 (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc) ;
   -- the inner part g0 . (cart u y . tot c) = cart u rx0 . (rmap u g0 . tot c)
   i1 : Id (VT.TH J z J0 rx0) (compH J J0 J0 (idH J0) (compH J J J0 u (idH J)), C.compD J J0 J0 (idH J0) (compH J J J0 u (idH J)) z y rx0 g0 (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc))
          (compH J J J0 (compH J J0 J0 (idH J0) u) (idH J), C.compD J J J0 (compH J J0 J0 (idH J0) u) (idH J) z ruy rx0 (C.compD J J0 J0 (idH J0) u ruy y rx0 g0 (C.cart J J0 u y)) tc) =
    symH (C.assoc J J J0 J0 (idH J0) u (idH J) z ruy y rx0 g0 (C.cart J J0 u y) tc) ;
   i2 : Id (VT.TH J z J0 rx0) (compH J J J0 (compH J J0 J0 (idH J0) u) (idH J), C.compD J J J0 (compH J J0 J0 (idH J0) u) (idH J) z ruy rx0 (C.compD J J0 J0 (idH J0) u ruy y rx0 g0 (C.cart J J0 u y)) tc)
          (compH J J J0 (compH J J J0 u (idH J)) (idH J), C.compD J J J0 (compH J J J0 u (idH J)) (idH J) z ruy rx0 (C.compD J J J0 u (idH J) ruy (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) rg) tc) =
    VT.cmpR J J J0 (idH J) z ruy rx0 tc (compH J J0 J0 (idH J0) u, C.compD J J0 J0 (idH J0) u ruy y rx0 g0 (C.cart J J0 u y)) (compH J J J0 u (idH J), C.compD J J J0 u (idH J) ruy (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) rg) (symH (VT.rmap-eq J J0 u y rx0 g0)) ;
   i3 : Id (VT.TH J z J0 rx0) (compH J J J0 (compH J J J0 u (idH J)) (idH J), C.compD J J J0 (compH J J J0 u (idH J)) (idH J) z ruy rx0 (C.compD J J J0 u (idH J) ruy (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) rg) tc)
          (compH J J J0 u (compH J J J (idH J) (idH J)), C.compD J J J0 u (compH J J J (idH J) (idH J)) z (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) (C.compD J J J (idH J) (idH J) z ruy (C.res J J0 u rx0) rg tc)) =
    C.assoc J J J J0 u (idH J) (idH J) z ruy (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) rg tc ;
   i4 : Id (VT.TH J z J0 rx0) (compH J J J0 u (compH J J J (idH J) (idH J)), C.compD J J J0 u (compH J J J (idH J) (idH J)) z (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) (C.compD J J J (idH J) (idH J) z ruy (C.res J J0 u rx0) rg tc))
          (compH J J J0 u (idH J), C.compD J J J0 u (idH J) z (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc)) =
    VT.cmpL J J J0 u z (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) (compH J J J (idH J) (idH J), C.compD J J J (idH J) (idH J) z ruy (C.res J J0 u rx0) rg tc) (idH J, VT.vcomp J z ruy (C.res J J0 u rx0) rg tc) (symH (VT.vcomp-eq J z ruy (C.res J J0 u rx0) rg tc)) ;
   e4 : Id (VT.TH J z I x) (compH J J0 I u0 (compH J J0 J0 (idH J0) (compH J J J0 u (idH J))), C.compD J J0 I u0 (compH J J0 J0 (idH J0) (compH J J J0 u (idH J))) z rx0 x (C.cart J0 I u0 x) (C.compD J J0 J0 (idH J0) (compH J J J0 u (idH J)) z y rx0 g0 (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc)))
          (compH J J0 I u0 (compH J J J0 u (idH J)), C.compD J J0 I u0 (compH J J J0 u (idH J)) z rx0 x (C.cart J0 I u0 x) (C.compD J J J0 u (idH J) z (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc))) =
    VT.cmpL J J0 I u0 z rx0 x (C.cart J0 I u0 x)
      (compH J J0 J0 (idH J0) (compH J J J0 u (idH J)), C.compD J J0 J0 (idH J0) (compH J J J0 u (idH J)) z y rx0 g0 (C.compD J J J0 u (idH J) z ruy y (C.cart J J0 u y) tc))
      (compH J J J0 u (idH J), C.compD J J J0 u (idH J) z (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc))
      (transH i1 (transH i2 (transH i3 i4))) ;
   e5 : Id (VT.TH J z I x) (compH J J I u0u (idH J), C.compD J J I u0u (idH J) z (C.res J I u0u x) x (C.cart J I u0u x) (VT.trC J J (idH J) z (C.res J J0 u rx0) (C.res J I u0u x) (symH rc) (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc)))
          (compH J J0 I u0 (compH J J J0 u (idH J)), C.compD J J0 I u0 (compH J J J0 u (idH J)) z rx0 x (C.cart J0 I u0 x) (C.compD J J J0 u (idH J) z (C.res J J0 u rx0) rx0 (C.cart J J0 u rx0) (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc))) =
    VT.cc-tr J J0 I u0 u z x (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc) ;
   e6 : Id (VT.TH J z I x) (u0u, tmap I x n J u0u z (CT.rxM J J0 I u u0 y x g0 n z c))
          (compH J J I u0u (idH J), C.compD J J I u0u (idH J) z (C.res J I u0u x) x (C.cart J I u0u x) (VT.trC J J (idH J) z (C.res J J0 u rx0) (C.res J I u0u x) (symH rc) (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc))) =
    transH (tmap-eq I x n J u0u z (CT.rxM J J0 I u u0 y x g0 n z c))
     (VT.cmpL J J I u0u z (C.res J I u0u x) x (C.cart J I u0u x) (idH J, KJ[J].K.tot n (C.res J I u0u x) z (CT.rxM J J0 I u u0 y x g0 n z c))
        (idH J, VT.trC J J (idH J) z (C.res J J0 u rx0) (C.res J I u0u x) (symH rc) (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc))
        (VT.pairL J J (idH J) z (C.res J I u0u x) (KJ[J].K.tot n (C.res J I u0u x) z (CT.rxM J J0 I u u0 y x g0 n z c)) (VT.trC J J (idH J) z (C.res J J0 u rx0) (C.res J I u0u x) (symH rc) (VT.vcomp J z ruy (C.res J J0 u rx0) rg tc))
           (CT.tot-rxM J J0 I u u0 y x g0 n z c))) ;
   law : Id (VT.TH J z I x) (compH J J0 I u0 u, C.compD J J0 I u0 u z y x f0 (tmap J0 y n J u z c)) (u0u, tmap I x n J u0u z (CT.rxM J J0 I u u0 y x g0 n z c)) =
    transH e1 (transH e2 (transH e3 (transH e4 (symH (transH e6 e5))))) ;
  } ;
  tau-nat (J0 I : Ob) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y x) (g : W0.Ix (G.ob I x))
   : Id (Ob' J0 y) (tau J0 y (G.act J0 I u0 y x f0 g)) (act J0 I u0 y x f0 (tau I x g)) =
   ob-eq J0 y (tau J0 y (G.act J0 I u0 y x f0 g)) (act J0 I u0 y x f0 (tau I x g)) (\ q l ->
    transH (symH (G.act-o q.2.1 J0 I u0 q.2.2.1 q.2.2.2.1 y x f0 (tmap J0 y q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) g))
     (apH {VT.TH q.2.1 q.2.2.2.1 I x} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ h -> actT I x q.2.1 q.2.2.2.1 h g)
        TauNat[J0, I, u0, y, x, f0, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1].law)) ;
  tauS : TP.TSub[G, DCtx] = new TP.TSub[G, DCtx, \ I x g -> tau I x g, \ J0 I u0 y x f0 g -> tau-nat J0 I u0 y x f0 g] ;
 } ;

 ------------------------------------------------------------------
 -- D on maps of presheaves: post-composition on the families
 module DS (Dc G : TP.TCtx) (s : TP.TSub[Dc, G]) {
  module DD = DC[Dc] ;
  module DG = DC[G] ;
  module M (I : Ob) (x : Obj I) (w : DD.Ob' I x) {
   t' : DG.T I x = \ q l -> s.nt q.2.1 q.2.2.2.1 (w.1 q l) ;
   nat' : W0.Ix (DG.natEq I x t') = \ r l ->
    transH (symH (s.nt-nat r.2.1 r.1.2.1 r.2.2 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) r.1.2.2.2.1 (C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (w.1 r.1 l)))
     (apH {W0.Ix (Dc.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} {W0.Ix (G.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} (s.nt r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (w.2.1 r l)) ;
   face' : W0.Ix (DG.faceEq I x t') = \ r l ->
    apH {W0.Ix (Dc.ob r.2.2.2.1 r.2.2.2.2.2.1)} {W0.Ix (G.ob r.2.2.2.1 r.2.2.2.2.2.1)} (s.nt r.2.2.2.1 r.2.2.2.2.2.1) (w.2.2.1 r l) ;
   top' : W0.Ix (DG.topEq I x t') = \ r l ->
    transH (apH {W0.Ix (Dc.ob r.2.1 r.2.2.2.1)} {W0.Ix (G.ob r.2.1 r.2.2.2.1)} (s.nt r.2.1 r.2.2.2.1) (w.2.2.2 r l))
     (s.nt-nat r.2.1 r.2.1 (idH r.2.1) r.2.2.2.1 (DD.topD I x r).1 (DD.topD I x r).2.2 (w.1 (r.1, r.2.1, r.2.2.1, (DD.topD I x r).1, (DD.topD I x r).2.1, r.2.2.2.2.2) l)) ;
   res : DG.Ob' I x = (t', nat', face', top') ;
  } ;
  dmap (I : Ob) (x : Obj I) (w : DD.Ob' I x) : DG.Ob' I x = M[I, x, w].res ;
  dmap-nat (J0 I : Ob) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y x) (w : DD.Ob' I x)
   : Id (DG.Ob' J0 y) (dmap J0 y (DD.act J0 I u0 y x f0 w)) (DG.act J0 I u0 y x f0 (dmap I x w)) =
   DG.ob-eq J0 y (dmap J0 y (DD.act J0 I u0 y x f0 w)) (DG.act J0 I u0 y x f0 (dmap I x w)) (\ q l -> refl (s.nt q.2.1 q.2.2.2.1 (w.1 (DD.Act[J0, I, u0, y, x, f0, w].rq q) l))) ;
  DSub : TP.TSub[DD.DCtx, DG.DCtx] = new TP.TSub[DD.DCtx, DG.DCtx, \ I x w -> dmap I x w, \ J0 I u0 y x f0 w -> dmap-nat J0 I u0 y x f0 w] ;
 } ;
} ;
