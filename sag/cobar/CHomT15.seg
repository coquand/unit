-- CHomT15.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 12: the constants' data
-- of beta are natural in the stage (CHomT14's comparison inside the shared
-- transport across CHomData's type equation).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module CstN (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) (r : R.R) {
 module BN0 = CHomT14[a].BNat[R, encK, pe, s, t] ;
 module P = BN0.P ;
 module F = BN0.F ;
 module H = BN0.H ;
 module CS = H.CS ;
 module CR = P.CR[r] ;
 module NN = F.NC[r].N ;
 module PCc = PresheafPi[a, a+].PPi[PosFull[a].PB.BC].PiCode[H.B0.Gh, CS.Wch.1, CS.IdCT.1] ;
 G2 : C.Ctx = CS.GT2.G2 ;
 IG : C.Ty G2 = CS.IdGT ;
 P2 (K : Ob) : U a+ = V1.Ix (G2.ob K) ;
 WcK (K : Ob) : U a+ = V1.Ix (CS.Wc.1.tob K tt) ;
 AT : C.Ty CR.PT.Q3.G1 = C.subT CR.PT.Q3.G1 CR.PT.Q3.G2 (IJ.IdT CR.PT.Q3.G2 CR.PT.Q3.Qw2 CR.PT.Q3.v1 CR.PT.Q3.v2) CR.PT.rho ;
 substTr (L : Ob) (x y z : P2 L) (p : Id (P2 L) x y) (q : Id (P2 L) y z) (u : V1.Ix (IG.1.tob L x))
  : Id (V1.Ix (IG.1.tob L z)) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x z (transH p q) u) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y z q (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)) =
  idJ (P2 L) y (\ z2 q2 -> Id (V1.Ix (IG.1.tob L z2)) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x z2 (transH p q2) u) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y z2 q2 (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)))
   (refl (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)) z q ;
 module DE (I J : Ob) (v : Hom J I) (z : P.Z I) (K : Ob) (f : Hom K J) (u : F.S.QK K) (p : V1.Ix (NN.FS K u)) {
  z' : P.Z J = BN0.tactZ I J v z ;
  ph : F.Fam I = P.ph I z ;
  x : V1.Ix (H.B0.Gh.ob I) = (tt, z.1) ;
  x' : V1.Ix (H.B0.Gh.ob J) = (tt, z'.1) ;
  vf : Hom K I = compH K J I v f ;
  pS' : V1.Ix (CS.IdCSt.1.tob K ((tt, r), u)) =
   subst (C.Ty CR.PS.Q3.G1) (CR.tyS K u) CR.PS.CT.IdCst (C.subT CR.PS.Q3.G1 CR.PS.Q3.G2 (IJ.IdT CR.PS.Q3.G2 CR.PS.Q3.Qw2 CR.PS.Q3.v1 CR.PS.Q3.v2) CR.PS.rho) (symH CR.PS.IdP) p ;
  wq : WcK K = (r, (u, pS')) ;
  y : V1.Ix (H.B0.Gh.ob K) = H.B0.Gh.act K I vf x ;
  y' : V1.Ix (H.B0.Gh.ob K) = H.B0.Gh.act K J f x' ;
  qy : Id (V1.Ix (H.B0.Gh.ob K)) y y' = PCc.piPt J I v x x' (refl x') K f ;
  a0 : WcK K = PresheafPi[a, a+].PPi[PosFull[a].PB.BC].bk H.B0.Gh CS.Wch.1 K y y' qy wq ;
  pia : Id (WcK K) a0 wq =
   transH (subst-ap (V1.Ix (H.B0.Gh.ob K)) (V1.Ix (C.nil.ob K)) (\ y1 -> y1.1) (\ o -> V1.Ix (CS.Wc.1.tob K o)) y' y (symH qy) wq)
    (apH {Id (V1.Ix (C.nil.ob K)) tt tt} {WcK K} (\ rr -> subst (V1.Ix (C.nil.ob K)) (\ o -> V1.Ix (CS.Wc.1.tob K o)) tt tt rr wq)
       (V1.isSetIx (C.nil.ob K) tt tt (ap (V1.Ix (H.B0.Gh.ob K)) (V1.Ix (C.nil.ob K)) (\ y1 -> y1.1) y' y (symH qy)) (refl tt))) ;
  phi : PCc.FunT I (PCc.ptOf I x) = z.2.2.2.1 ;
  sgY (aa : WcK K) : P2 K = CS.rTN K (CS.sTN K (y, aa)) ;
  sgD (dd : V1.Ix (CS.Dc.ob K)) : P2 K = CS.rTN K (CS.sTN K dd) ;
  X' : V1.Ix (IG.1.tob K (sgY a0)) = phi K vf a0 ;
  X : V1.Ix (IG.1.tob K (sgY wq)) = phi K vf wq ;
  eX : Id (V1.Ix (IG.1.tob K (sgY wq))) (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY a0) (sgY wq) (ap (WcK K) (P2 K) sgY a0 wq pia) X') X =
   transH (symH (subst-ap (WcK K) (P2 K) sgY (\ v2 -> V1.Ix (IG.1.tob K v2)) a0 wq pia X'))
    (CMorX[a].apdS (WcK K) (\ aa -> V1.Ix (IG.1.tob K (sgY aa))) (\ aa -> phi K vf aa) a0 wq pia) ;
  pp : Id (V1.Ix (CS.Dc.ob K)) (y, a0) (y', wq) = PresheafPi[a, a+].PPi[PosFull[a].PB.BC].pairpath H.B0.Gh CS.Wch.1 K y y' qy wq ;
  cTK : F.T.QK K = (P.HP.Alg[t].AX.cls (cst r)).eob K tt ;
  tgt : P2 K = ((tt, cTK), ph K vf u) ;
  qL : Id (P2 K) (sgY wq) tgt = ap (Hom K I) (P2 K) (\ k -> ((tt, cTK), ph K k u)) (compH K K I vf (idH K)) vf (comp-idr K I vf) ;
  qR : Id (P2 K) (sgD (y', wq)) tgt = ap (Hom K J) (P2 K) (\ k -> ((tt, cTK), F.resF I J v ph K k u)) (compH K K J f (idH K)) f (comp-idr K J f) ;
  path1 : Id (P2 K) (sgY a0) tgt = transH (ap (WcK K) (P2 K) sgY a0 wq pia) qL ;
  path2 : Id (P2 K) (sgY a0) tgt = transH (ap (V1.Ix (CS.Dc.ob K)) (P2 K) sgD (y, a0) (y', wq) pp) qR ;
  Tt : U a+ = V1.Ix (IG.1.tob K tgt) ;
  innerL : Tt = subst (Hom K I) (\ k -> V1.Ix (IG.1.tob K ((tt, cTK), ph K k u))) (compH K K I vf (idH K)) vf (comp-idr K I vf) X ;
  innerR : Tt = subst (Hom K J) (\ k -> V1.Ix (IG.1.tob K ((tt, cTK), F.resF I J v ph K k u))) (compH K K J f (idH K)) f (comp-idr K J f) (z'.2.2.2.1 K f wq) ;
  L1 : Id Tt innerL (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY wq) tgt qL X) =
   subst-ap (Hom K I) (P2 K) (\ k -> ((tt, cTK), ph K k u)) (\ v2 -> V1.Ix (IG.1.tob K v2)) (compH K K I vf (idH K)) vf (comp-idr K I vf) X ;
  L2 : Id Tt (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY wq) tgt qL X) (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY a0) tgt path1 X') =
   transH (apH {V1.Ix (IG.1.tob K (sgY wq))} {Tt} (\ w2 -> subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY wq) tgt qL w2) (symH eX))
    (symH (substTr K (sgY a0) (sgY wq) tgt (ap (WcK K) (P2 K) sgY a0 wq pia) qL X')) ;
  M : Id Tt (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY a0) tgt path1 X') (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY a0) tgt path2 X') =
   apH {Id (P2 K) (sgY a0) tgt} {Tt} (\ rr -> subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY a0) tgt rr X') (V1.isSetIx (G2.ob K) (sgY a0) tgt path1 path2) ;
  R1 : Id Tt innerR (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgD (y', wq)) tgt qR (z'.2.2.2.1 K f wq)) =
   subst-ap (Hom K J) (P2 K) (\ k -> ((tt, cTK), F.resF I J v ph K k u)) (\ v2 -> V1.Ix (IG.1.tob K v2)) (compH K K J f (idH K)) f (comp-idr K J f) (z'.2.2.2.1 K f wq) ;
  R2 : Id (V1.Ix (IG.1.tob K (sgD (y', wq)))) (z'.2.2.2.1 K f wq) (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY a0) (sgD (y', wq)) (ap (V1.Ix (CS.Dc.ob K)) (P2 K) sgD (y, a0) (y', wq) pp) X') =
   subst-ap (V1.Ix (CS.Dc.ob K)) (P2 K) sgD (\ v2 -> V1.Ix (IG.1.tob K v2)) (y, a0) (y', wq) pp X' ;
  R3 : Id Tt (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgD (y', wq)) tgt qR (z'.2.2.2.1 K f wq)) (subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgY a0) tgt path2 X') =
   transH (apH {V1.Ix (IG.1.tob K (sgD (y', wq)))} {Tt} (\ w2 -> subst (P2 K) (\ v2 -> V1.Ix (IG.1.tob K v2)) (sgD (y', wq)) tgt qR w2) R2)
    (symH (substTr K (sgY a0) (sgD (y', wq)) tgt (ap (V1.Ix (CS.Dc.ob K)) (P2 K) sgD (y, a0) (y', wq) pp) qR X')) ;
  innerEq : Id Tt innerL innerR = transH L1 (transH L2 (transH M (symH (transH R1 R3)))) ;
  law : Id (V1.Ix (NN.FT K (ph K vf u))) (CR.dc I z K vf u p) (CR.dc J z' K f u p) =
   apH {Tt} {V1.Ix (NN.FT K (ph K vf u))} (\ w2 -> subst (C.Ty CR.PT.Q3.G1) (CR.tyT K (ph K vf u)) AT CR.PT.CT.IdCst CR.PT.IdP w2) innerEq ;
 } ;
} ;
