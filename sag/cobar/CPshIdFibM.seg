-- CPshIdFibM.seg (part 1 of CPshIdFib) (canonicity-45; (B) stage 2(b), COBAR.md): the Yoneda Id
-- of a uniformly fibrant C-type is uniformly fibrant, and the law of its
-- substitution.
--   YU[G, A, a, b, d, dc, kI, cuI]   the fibrations of the Yoneda Id at each
--            x are core's moved along the Yoneda iso (PosIdY (4), a cart
--            C_x : IdYT -> core IdT over the identity); the iso commutes
--            with the C-actions on readings (taC), hence on end data (sVC),
--            strict fibres (mSC) and totals of the other end (mTC); the
--            moved family is C-uniform when core's is (Res, as
--            CPshUFib.UP.Res with the iso in place of the pull-back cart)
--   idCl     the UFib of Id(a , b): PosIdY.fib at each x, YU in both
--            directions from CPshPathU.PU and CPshCoreIdU.IU
--   INat.law the law of substitution for (IdT , idCl): CPshId.IdNatC.nat
--            and the base's FibIdCen.idTy-nat at each x

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module CIm = PB.CId[l] ;
module PY = PosIdY[a, l] ;
module FIC = FibIdCen[a, l] ;

module IdFibMOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module IdM = CPshId[a, l].IdOf[C] ;
 module CUm = CPshCoreIdU[a, l].CoreIdUOf[C] ;
 open P ;

 module YU1 (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) (e e' : PB.IPt)
  (kI : (x : CO) -> CL.Lines[G.ob x, CUm.CoreIdC[G, A, a0, b0].ty x].CompK[e, e'].Comp)
  (cuI : LO.UF[G, CUm.CoreIdC[G, A, a0, b0].IdT].UComp e e' kI) {
  module IC = IdM.IdC[G, A, a0, b0] ;
  module CI = CUm.CoreIdC[G, A, a0, b0] ;
  Yt : CTy[G] = IC.IdT ;
  Ct : CTy[G] = CI.IdT ;
  module SFy = LO.SF[G, Yt, e] ;
  module SFc = LO.SF[G, Ct, e] ;
  module AEy = LO.AE[G, Yt, e] ;
  module AEc = LO.AE[G, Ct, e] ;
  module AEy' = LO.AE[G, Yt, e'] ;
  module AEc' = LO.AE[G, Ct, e'] ;
  module SCt-y = LO.SC[SFy.TVC, LO.LinC G, LO.pPC (LO.LinC G) AEy.AevC, AEy'.AevC] ;
  module SCt-c = LO.SC[SFc.TVC, LO.LinC G, LO.pPC (LO.LinC G) AEc.AevC, AEc'.AevC] ;

  -- the iso and its cart at x
  module At (x : CO) {
   module Y = IC.Y[x].I ;
   module Cx = Y.C ;
   module E = Cx.AtEnd[e] ;
   module E' = Cx.AtEnd[e'] ;
   module M = Cx.MoveComp[e, e'] ;
   module EKc = CL.EndKit[G.ob x, Ct.ty x, e] ;
   module EKy = CL.EndKit[G.ob x, Yt.ty x, e] ;
  } ;

  -- the iso commutes with the C-action (on readings)
  taC (y x : CO) (f : CH y x) (W : Ob) (z : SigT (G.ob x) (Yt.ty x) W)
   : Id (SigT (G.ob y) (Ct.ty y) W) (At[y].Y.ta W ((Yt.tE y x f).nt W z)) ((Ct.tE y x f).nt W (At[x].Y.ta W z)) =
   At[y].Y.IO.tpI-ext W (At[y].Y.ta W ((Yt.tE y x f).nt W z)) ((Ct.tE y x f).nt W (At[x].Y.ta W z))
    (refl ((G.act y x f).nt W (fstE (G.ob x) (Yt.ty x) W z)))
    (\ V g j -> IC.rd-C y x f W (fstE (G.ob x) (Yt.ty x) W z) (sndE (G.ob x) (Yt.ty x) W z) V g j)
    (refl (sndE (G.ob x) (Yt.ty x) W z).2.1) ;
  opaque taC ;

  -- the point map sV commutes with the C-action
  sVC (y x : CO) (f : CH y x) (X : Ob) (w : AEy.TVT x X)
   : Id (AEc.TVT y X) (At[y].E.sV X (AEy.tEv y x f X w)) (AEc.tEv y x f X (At[x].E.sV X w)) =
   At[y].EKc.tv-eq X (At[y].E.sV X (AEy.tEv y x f X w)) (AEc.tEv y x f X (At[x].E.sV X w))
    (CL.FC[G.ob y].fam-eq X _ _ (\ V g j -> refl ((G.act y x f).nt V ((fstE CL.FC[G.ob x].GI CL.FT[G.ob x, Yt.ty x].Ev[e].Aev X w).1 V g j))))
    (transH (At[y].E.sVE X (AEy.tEv y x f X w))
      (transH (apH (At[y].Y.ta X) (AEy.endEv y x f X w))
        (transH (taC y x f X (At[x].EKy.endE X w))
          (transH (apH ((Ct.tE y x f).nt X) (symH (At[x].E.sVE X w)))
            (symH (AEc.endEv y x f X (At[x].E.sV X w))))))) ;
  -- the map of strict-fibre elements mS commutes with the C-action
  mSC (y x : CO) (f : CH y x) (W : Ob) (u : SFy.TST x W)
   : Id (SFc.TST y W) (At[y].E.mS W (SFy.tES y x f W u)) (SFc.tES y x f W (At[x].E.mS W u)) =
   At[y].EKc.ts-ext W (At[y].E.mS W (SFy.tES y x f W u)) (SFc.tES y x f W (At[x].E.mS W u))
    (transH (At[y].E.mSpt W (SFy.tES y x f W u))
      (transH (sVC y x f W u.1) (apH (AEc.tEv y x f W) (symH (At[x].E.mSpt W u)))))
    (\ V g j -> transH (At[y].E.mS-val W (SFy.tES y x f W u) V g j)
                 (transH (taC y x f V (At[x].EKy.lv W u V g j))
                   (apH ((Ct.tE y x f).nt V) (symH (At[x].E.mS-val W u V g j))))) ;
  -- (sVC at the other end)
  sVC' (y x : CO) (f : CH y x) (X : Ob) (w : AEy'.TVT x X)
   : Id (AEc'.TVT y X) (At[y].E'.sV X (AEy'.tEv y x f X w)) (AEc'.tEv y x f X (At[x].E'.sV X w)) =
   CL.EndKit[G.ob y, Ct.ty y, e'].tv-eq X (At[y].E'.sV X (AEy'.tEv y x f X w)) (AEc'.tEv y x f X (At[x].E'.sV X w))
    (CL.FC[G.ob y].fam-eq X _ _ (\ V g j -> refl ((G.act y x f).nt V ((fstE CL.FC[G.ob x].GI CL.FT[G.ob x, Yt.ty x].Ev[e'].Aev X w).1 V g j))))
    (transH (At[y].E'.sVE X (AEy'.tEv y x f X w))
      (transH (apH (At[y].Y.ta X) (AEy'.endEv y x f X w))
        (transH (taC y x f X (CL.EndKit[G.ob x, Yt.ty x, e'].endE X w))
          (transH (apH ((Ct.tE y x f).nt X) (symH (At[x].E'.sVE X w)))
            (symH (AEc'.endEv y x f X (At[x].E'.sV X w))))))) ;
  opaque sVC ; opaque mSC ; opaque sVC' ;
 } ;
} ;
