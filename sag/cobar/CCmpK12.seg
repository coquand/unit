-- CCmpK12.seg (canonicity-c2; (K) for cmpI, part 12): over nil.HTT (a pair
-- g of homs F1 -> y) the two quotient fibres S_k over a_k = ev g_k, the
-- context GS = nil.HTT.S_1.S_2, its maps to Delta Term_y^2 and to QSurj.E,
-- the Id components cls t_k = a_k, and moving to closed types over GS.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module K12 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K9m = CCmpK9[a].K9[R, encK, pe, y] ;
 module K3m = CCmpK3[a].K3[R, encK, pe, y] ;
 module K1m = CCmpK1[a].K1[R, encK, pe, y] ;
 module I = K9m.PFm.I ;
 module QS = CQSurj[a].QSurj[R, encK, pe, y] ;
 Nl : C.Ctx = C.nil ;
 HTT : C.Ty Nl = K3m.HTT ;
 QY : C.Ty Nl = K3m.QY ;
 GB : C.Ctx = I.GB ;
 gq : C.El GB (C.subT GB Nl HTT (C.p Nl HTT)) = C.q Nl HTT ;
 a1 : C.El GB (C.subT GB Nl QY (C.p Nl HTT)) = CInjP[a].IP[HTT, QY, K3m.m1].evS GB (C.p Nl HTT) gq ;
 a2 : C.El GB (C.subT GB Nl QY (C.p Nl HTT)) = CInjP[a].IP[HTT, QY, K3m.m2].evS GB (C.p Nl HTT) gq ;
 sg1 : C.Sub GB QS.G1 = CQSurj[a].Ex[C].exS GB Nl QY (C.p Nl HTT) a1 ;
 sg2 : C.Sub GB QS.G1 = CQSurj[a].Ex[C].exS GB Nl QY (C.p Nl HTT) a2 ;
 S1 : C.Ty GB = C.subT GB QS.G1 QS.S sg1 ;
 GS1 : C.Ctx = C.ext GB S1 ;
 sg2' : C.Sub GS1 QS.G1 = C.o GS1 GB QS.G1 sg2 (C.p GB S1) ;
 S2 : C.Ty GS1 = C.subT GS1 QS.G1 QS.S sg2' ;
 GS : C.Ctx = C.ext GS1 S2 ;
 pp : C.Sub GS GB = C.o GS GS1 GB (C.p GB S1) (C.p GS1 S2) ;
 s0 : C.Sub GS Nl = C.o GS GB Nl (C.p Nl HTT) pp ;
 -- the terms
 tauN (K : Ob) (w : V1.Ix (GS.ob K)) : V1.Ix (K1m.DP.ob K) = (w.1.1.1, (w.1.2.1, w.2.1)) ;
 tau : C.Sub GS K1m.DP = new L.PSub[GS, K1m.DP, tauN, \ J I f w -> refl (tauN J (GS.act J I f w))] ;
 -- the points of QSurj.E, and the Id components
 pi1N (K : Ob) (w : V1.Ix (GS.ob K)) : V1.Ix (QS.E.ob K) = (sg1.nt K w.1.1, w.1.2.1) ;
 pi1 : C.Sub GS QS.E = new L.PSub[GS, QS.E, pi1N, \ J I f w -> apH {V1.Ix (QS.G1.ob J)} {V1.Ix (QS.E.ob J)} (\ x -> (x, (GS.act J I f w).1.2.1)) (sg1.nt-nat J I f w.1.1)] ;
 pi2N (K : Ob) (w : V1.Ix (GS.ob K)) : V1.Ix (QS.E.ob K) = (sg2.nt K w.1.1, w.2.1) ;
 pi2 : C.Sub GS QS.E = new L.PSub[GS, QS.E, pi2N, \ J I f w -> apH {V1.Ix (QS.G1.ob J)} {V1.Ix (QS.E.ob J)} (\ x -> (x, (GS.act J I f w).2.1)) (sg2.nt-nat J I f w.1.1)] ;
 IdE1 : C.Ty GS = C.subT GS QS.E QS.IdE pi1 ;
 eN1 (J I : Ob) (f : Hom J I) (w : V1.Ix (GS.ob I))
   : Id (V1.Ix (IdE1.1.tob J (GS.act J I f w))) (IdE1.1.tact J I f w (GS.act J I f w) (refl (GS.act J I f w)) w.1.2.2) (GS.act J I f w).1.2.2 =
  L.tact-irr QS.E QS.IdE.1 J I f (pi1N I w) (pi1N J (GS.act J I f w))
    (L.ntEq GS QS.E pi1 J I f w (GS.act J I f w) (refl (GS.act J I f w)))
    (L.pair-act QS.G1 QS.TmG.1 J I f (sg1.nt I w.1.1) (sg1.nt J (GB.act J I f w.1.1)) (L.ntEq GB QS.G1 sg1 J I f w.1.1 (GB.act J I f w.1.1) (refl (GB.act J I f w.1.1))) w.1.2.1)
    w.1.2.2 ;
 eS1 : C.El GS IdE1 = L.mkPEl GS IdE1.1 (\ K w -> w.1.2.2) (\ J I f w w' e ->
  idJ (V1.Ix (GS.ob J)) (GS.act J I f w) (\ w2 e2 -> Id (V1.Ix (IdE1.1.tob J w2)) (IdE1.1.tact J I f w w2 e2 w.1.2.2) w2.1.2.2)
    (eN1 J I f w) w' e) ;
 IdE2 : C.Ty GS = C.subT GS QS.E QS.IdE pi2 ;
 eN2 (J I : Ob) (f : Hom J I) (w : V1.Ix (GS.ob I))
   : Id (V1.Ix (IdE2.1.tob J (GS.act J I f w))) (IdE2.1.tact J I f w (GS.act J I f w) (refl (GS.act J I f w)) w.2.2) (GS.act J I f w).2.2 =
  L.tact-irr QS.E QS.IdE.1 J I f (pi2N I w) (pi2N J (GS.act J I f w))
    (L.ntEq GS QS.E pi2 J I f w (GS.act J I f w) (refl (GS.act J I f w)))
    (L.pair-act QS.G1 QS.TmG.1 J I f (sg2.nt I w.1.1) (sg2.nt J (GB.act J I f w.1.1)) (L.ntEq GS1 QS.G1 sg2' J I f w.1 (GS1.act J I f w.1) (refl (GS1.act J I f w.1))) w.2.1)
    w.2.2 ;
 eS2 : C.El GS IdE2 = L.mkPEl GS IdE2.1 (\ K w -> w.2.2) (\ J I f w w' e ->
  idJ (V1.Ix (GS.ob J)) (GS.act J I f w) (\ w2 e2 -> Id (V1.Ix (IdE2.1.tob J w2)) (IdE2.1.tact J I f w w2 e2 w.2.2) w2.2.2)
    (eN2 J I f w) w' e) ;
 -- moving elements of closed types to one type over GS
 module Mv (A : C.Ty Nl) (Z : C.Ctx) (T : C.Ty Z) (sZ : C.Sub Z Nl) (PTy : Id (C.Ty Z) T (C.subT Z Nl A sZ)) (s : C.Sub GS Z)
   (hp : (K : Ob) (w : V1.Ix (GS.ob K)) -> Id (V1.Ix (Nl.ob K)) ((C.o GS Z Nl sZ s).nt K w) (s0.nt K w)) {
  AS0 : C.Ty GS = C.subT GS Nl A s0 ;
  P : Id (C.Ty GS) (C.subT GS Z T s) AS0 =
   transH (apH {C.Ty Z} {C.Ty GS} (\ X -> C.subT GS Z X s) PTy)
    (transH (symH (C.subT-o GS Z Nl A sZ s)) (apH {C.Sub GS Nl} {C.Ty GS} (\ r -> C.subT GS Nl A r) (L.sub-ext GS Nl (C.o GS Z Nl sZ s) s0 hp))) ;
  el (x : C.El Z T) : C.El GS AS0 = OV.trE GS (C.subT GS Z T s) AS0 P (C.subt GS Z T x s) ;
  idS (x x' : C.El Z T) (h : C.El GS (C.subT GS Z (IJ.IdT Z T x x') s)) : C.El GS (IJ.IdT GS AS0 (el x) (el x')) =
   CInjP[a].idFwdL GS (C.subT GS Z T s) AS0 P (C.subt GS Z T x s) (C.subt GS Z T x' s)
    (OV.trE GS (C.subT GS Z (IJ.IdT Z T x x') s) (IJ.IdT GS (C.subT GS Z T s) (C.subt GS Z T x s) (C.subt GS Z T x' s))
      (IJ.IdT-nat GS Z T x x' s) h) ;
  id (x x' : C.El Z T) (h : C.El Z (IJ.IdT Z T x x')) : C.El GS (IJ.IdT GS AS0 (el x) (el x')) = idS x x' (C.subt GS Z (IJ.IdT Z T x x') h s) ;
 } ;
 -- the hom z_t (t the two terms) and the pair g, over GS
 HS : C.Ty Nl = K9m.CI.HS ;
 HT : C.Ty Nl = K9m.CI.HT ;
 module MZ = Mv[HS, K1m.DP, OV.wkT Nl K1m.TP HS, C.p Nl K1m.TP, refl (OV.wkT Nl K1m.TP HS), tau, \ K w -> refl (s0.nt K w)] ;
 z : C.El GS (C.subT GS Nl HS s0) = MZ.el K1m.zfam ;
 HTT0 : C.Ty GS = C.subT GS Nl HTT s0 ;
 gvN (J I : Ob) (f : Hom J I) (w : V1.Ix (GS.ob I))
   : Id (V1.Ix (HTT0.1.tob J (GS.act J I f w))) (HTT0.1.tact J I f w (GS.act J I f w) (refl (GS.act J I f w)) w.1.1.2) (GS.act J I f w).1.1.2 =
  L.tact-irr Nl HTT.1 J I f w.1.1.1 w.1.1.1 (L.ntEq GS Nl s0 J I f w (GS.act J I f w) (refl (GS.act J I f w))) (refl w.1.1.1) w.1.1.2 ;
 gv : C.El GS HTT0 = L.mkPEl GS HTT0.1 (\ K w -> w.1.1.2) (\ J I f w w' e ->
  idJ (V1.Ix (GS.ob J)) (GS.act J I f w) (\ w2 e2 -> Id (V1.Ix (HTT0.1.tob J w2)) (HTT0.1.tact J I f w w2 e2 w.1.1.2) w2.1.1.2)
    (gvN J I f w) w' e) ;
 -- the components
 e2 (J I : Ob) (f : Hom J I) (x x' : Top) (e : Id Top (Nl.act J I f x) x') (p : V1.Ix (HTT.1.tob I x)) : Id Top (Nl.act J I f x) x' =
  L.ntEq (L.extP Nl HT.1) Nl (L.pP Nl HT.1) J I f (x, p.1) (x', HT.1.tact J I f x x' e p.1) (L.pair-act Nl HT.1 J I f x x' e p.1) ;
 pr1 : HO.NMap[Nl, HTT.1, HT.1] = new HO.NMap[Nl, HTT.1, HT.1, \ K o p -> p.1, \ J I f x x' e p -> refl (HT.1.tact J I f x x' e p.1)] ;
 pr2 : HO.NMap[Nl, HTT.1, HT.1] = new HO.NMap[Nl, HTT.1, HT.1, \ K o p -> p.2, \ J I f x x' e p -> L.tact-irr Nl HT.1 J I f x x' e (e2 J I f x x' e p) p.2] ;
 c1 : C.El GS (C.subT GS Nl HT s0) = CInjP[a].IP[HS, HT, K9m.CI.Q1.nmap].evS GS s0 z ;
 c2 : C.El GS (C.subT GS Nl HT s0) = CInjP[a].IP[HS, HT, K9m.CI.Q2.nmap].evS GS s0 z ;
 g1 : C.El GS (C.subT GS Nl HT s0) = CInjP[a].IP[HTT, HT, pr1].evS GS s0 gv ;
 g2 : C.El GS (C.subT GS Nl HT s0) = CInjP[a].IP[HTT, HT, pr2].evS GS s0 gv ;
} ;
