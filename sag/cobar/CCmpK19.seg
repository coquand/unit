-- CCmpK19.seg (canonicity-c2; (K) for cmpI, part 19): the stage-2 motive
-- at the native base nil.Q_y (variable q2): B2 = Pi (g : HTT) (h : ev g_2 =
-- q2) (s1 : S[ev g_1]). Fib (g), a proposition (iterated piProp).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module K19 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K12m = CCmpK12[a].K12[R, encK, pe, y] ;
 module K3m = K12m.K3m ;
 module I = K12m.I ;
 module QS = K12m.QS ;
 Nl : C.Ctx = C.nil ;
 Q : C.Ty Nl = QS.Qt ;
 HTT : C.Ty Nl = K12m.HTT ;
 GB : C.Ctx = K12m.GB ;
 G1 : C.Ctx = QS.G1 ;
 s1G : C.Sub G1 Nl = C.p Nl Q ;
 X2 : C.Ty G1 = C.subT G1 Nl HTT s1G ;
 C1 : C.Ctx = C.ext G1 X2 ;
 sC1 : C.Sub C1 Nl = C.o C1 G1 Nl s1G (C.p G1 X2) ;
 module CE (A : C.Ty Nl) (v : (K : Ob) (x : V1.Ix (C1.ob K)) -> V1.Ix (A.1.tob K x.1.1))
   (vn : (J I : Ob) (f : Hom J I) (x : V1.Ix (C1.ob I)) -> Id (V1.Ix (A.1.tob J x.1.1)) (A.1.tact J I f x.1.1 x.1.1 (refl x.1.1) (v I x)) (v J (C1.act J I f x))) {
  AT : C.Ty C1 = C.subT C1 Nl A sC1 ;
  nB (J I : Ob) (f : Hom J I) (x : V1.Ix (C1.ob I)) : Id (V1.Ix (AT.1.tob J (C1.act J I f x))) (AT.1.tact J I f x (C1.act J I f x) (refl (C1.act J I f x)) (v I x)) (v J (C1.act J I f x)) =
   transH (L.tact-irr Nl A.1 J I f x.1.1 x.1.1 (L.ntEq C1 Nl sC1 J I f x (C1.act J I f x) (refl (C1.act J I f x))) (refl x.1.1) (v I x)) (vn J I f x) ;
  el : C.El C1 AT = L.mkPEl C1 AT.1 v (\ J I f x x' e ->
   idJ (V1.Ix (C1.ob J)) (C1.act J I f x) (\ x2 e2 -> Id (V1.Ix (AT.1.tob J x2)) (AT.1.tact J I f x x2 e2 (v I x)) (v J x2)) (nB J I f x) x' e) ;
 } ;
 gC1 : C.El C1 (C.subT C1 Nl HTT sC1) = CE[HTT, \ K x -> x.2, \ J I f x -> refl (HTT.1.tact J I f x.1.1 x.1.1 (refl x.1.1) x.2)].el ;
 QC1 : C.Ty C1 = C.subT C1 Nl Q sC1 ;
 ev2C1 : C.El C1 QC1 = CInjP[a].IP[HTT, Q, K3m.m2].evS C1 sC1 gC1 ;
 q2C1 : C.El C1 QC1 = CE[Q, \ K x -> x.1.2, \ J I f x -> refl (Q.1.tact J I f x.1.1 x.1.1 (refl x.1.1) x.1.2)].el ;
 H2 : C.Ty C1 = IJ.IdT C1 QC1 ev2C1 q2C1 ;
 C2 : C.Ctx = C.ext C1 H2 ;
 sC2 : C.Sub C2 Nl = C.o C2 C1 Nl sC1 (C.p C1 H2) ;
 gN2 (J I : Ob) (f : Hom J I) (x : V1.Ix (C2.ob I))
   : Id (V1.Ix ((C.subT C2 Nl HTT sC2).1.tob J (C2.act J I f x))) ((C.subT C2 Nl HTT sC2).1.tact J I f x (C2.act J I f x) (refl (C2.act J I f x)) x.1.2) (C2.act J I f x).1.2 =
  L.tact-irr Nl HTT.1 J I f x.1.1.1 x.1.1.1 (L.ntEq C2 Nl sC2 J I f x (C2.act J I f x) (refl (C2.act J I f x))) (refl x.1.1.1) x.1.2 ;
 gC2 : C.El C2 (C.subT C2 Nl HTT sC2) = L.mkPEl C2 (C.subT C2 Nl HTT sC2).1 (\ K x -> x.1.2) (\ J I f x x' e ->
  idJ (V1.Ix (C2.ob J)) (C2.act J I f x) (\ x2 e2 -> Id (V1.Ix ((C.subT C2 Nl HTT sC2).1.tob J x2)) ((C.subT C2 Nl HTT sC2).1.tact J I f x x2 e2 x.1.2) x2.1.2) (gN2 J I f x) x' e) ;
 ev1C2 : C.El C2 (C.subT C2 Nl Q sC2) = CInjP[a].IP[HTT, Q, K3m.m1].evS C2 sC2 gC2 ;
 sgS1 : C.Sub C2 G1 = CQSurj[a].Ex[C].exS C2 Nl Q sC2 ev1C2 ;
 S1' : C.Ty C2 = C.subT C2 G1 QS.S sgS1 ;
 C3 : C.Ctx = C.ext C2 S1' ;
 -- the g of a point, as a substitution to nil.HTT
 tgN (K : Ob) (w : V1.Ix (C3.ob K)) : V1.Ix (GB.ob K) = (w.1.1.1.1, w.1.1.2) ;
 tgNat (J I : Ob) (f : Hom J I) (w : V1.Ix (C3.ob I)) : Id (V1.Ix (GB.ob J)) (tgN J (C3.act J I f w)) (GB.act J I f (tgN I w)) =
  apH {V1.Ix (HTT.1.tob J w.1.1.1.1)} {V1.Ix (GB.ob J)} (\ g -> (w.1.1.1.1, g))
   (L.tact-irr Nl HTT.1 J I f w.1.1.1.1 w.1.1.1.1 (L.ntEq G1 Nl s1G J I f w.1.1.1 (G1.act J I f w.1.1.1) (refl (G1.act J I f w.1.1.1))) (refl w.1.1.1.1) w.1.1.2) ;
 tg : C.Sub C3 GB = new L.PSub[C3, GB, tgN, tgNat] ;
 F2 : C.Ty C3 = C.subT C3 GB I.Fib tg ;
 pF2 : C.El C3 (PU.isProp C3 F2) =
  OV.trE C3 (C.subT C3 GB (PU.isProp GB I.Fib) tg) (PU.isProp C3 F2) (PU.isProp-ov C3 GB I.Fib tg F2 (refl F2)) (C.subt C3 GB (PU.isProp GB I.Fib) K12m.K9m.pF tg) ;
 PiS : C.Ty C2 = FibCwF[a, a+].fibPi.Pi C2 S1' F2 ;
 PiH : C.Ty C1 = FibCwF[a, a+].fibPi.Pi C1 H2 PiS ;
 B2 : C.Ty G1 = FibCwF[a, a+].fibPi.Pi G1 X2 PiH ;
 pB2 : C.El G1 (PU.isProp G1 B2) = PPp.piProp G1 X2 PiH (PPp.piProp C1 H2 PiS (PPp.piProp C2 S1' F2 pF2)) ;
} ;
