-- CTotPsi22.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 22: bkMv assembled from CTotPsi21 (the
-- two lines of A agree by rho-inj at the context G.A; ts-ext; totEq).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi22 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P21 = CTotPsi21[a, vl, l].Psi21[C, G, A, e] ;
 module P14 = P21.P14 ;
 module P13 = P21.P13 ;
 module P10 = P21.P10 ;
 module PO = P21.PO ;
 module D = PO.D ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module CT = PO.CT ;
 module EKg = P21.EKg ;
 module EKd = P21.EKd ;
 module FTg = P21.FTg ;
 module XBE = P21.XBE ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;

 module BM (X : TC.TOb) (w : EKd.TV.EI X) (u : P13.DS.TOb' X.1 X.2 (P10.psi X w)) {
  module BM1 = P21.BM[X, w, u] ;
  vt : EKd.TS.EI X = EKd.TS.pr X w P21.P20.BK[X, w, u].bk ;
  module M = P21.P12.MS[X, vt] ;
  module BK = P21.P20.BK[X, w, u] ;
  module B = BM1.B ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module PQ (n : Nat) (J : Ob) (Ub : Hom J I) (z : Obj J) (cc : CT.Ch J n (C.res J I Ub x) z) (i : Wt.Pn n J) {
   module P1 = BM1.PQ[n, J, Ub, z, cc, i] ;
   qq : DO.Idx I x = P1.qq ;
   Y : TC.TOb = P1.Y ;
   module MQ = M.PQ[n, J, Ub, z, cc, i] ;
   module QE = MQ.QE ;
   lnq : W0.Ix (FTg.FE.ob Y) = P1.lnq ;
    -- the lift back read at the cartesian lift
   module RV (W1 : Ob) (vv : Hom W1 J) (j : PB.IvP W1) (y : Obj W1) (e1 : Id (Obj W1) (C.res W1 J vv z) y) {
    module LV = P1.LV[W1, vv, j] ;
    R : Wt.Pn n W1 = LV.R ;
    Uv : Hom W1 I = LV.Uv ;
     module RC = PO.PL[X, BK.ln].RC[n, W1, y, Uv, P1.cT W1 vv y e1, R, j] ;
     module RQ = B.AB[RC.Xv, RC.f, j].RQ[RC.q0, R.2] ;
     law : Id (EKg.TA.EI (W1, y)) (QE.vg W1 vv y e1 j) ((LV.lineAt y e1).1 (W1, y) (TC.tid (W1, y)) j) =
      transH RQ.aeq
       (transH (apH {D.S I x n W1 y} {EKg.TA.EI (W1, y)}
                  (\ sw -> (B.lineE (n, W1, sw.1, y, sw.2, R.1) R.2).1 (W1, y) (TC.tid (W1, y)) RQ.RC.j0)
                  (D.sEq I x n W1 y (compH W1 W1 I Uv (idH W1)) Uv (comp-idr W1 I Uv)
                     (CT.rxM W1 W1 I (idH W1) Uv RC.ry x RC.CA.g0 n y RC.CA.ch) (P1.cT W1 vv y e1) RC.CA.law))
         (apH {PB.IvP W1} {EKg.TA.EI (W1, y)} (\ jj -> (LV.lineAt y e1).1 (W1, y) (TC.tid (W1, y)) jj) (PB.ivA-id W1 j))) ;
    } ;
   Leq : Id (W0.Ix (XBE.RH.F0.ob Y)) QE.L0 (XBE.RH.rhoV Y lnq) =
    XBE.RH.F0.fam-eq Y QE.L0 (XBE.RH.rhoV Y lnq)
     (\ W h j -> transH (RV[W.1, h.1, j, W.2, symH h.2].law) (P1.LV[W.1, h.1, j].gen W.2 (symH h.2))) ;
   lineEq : Id (W0.Ix (FTg.FE.ob Y)) MQ.psiE lnq =
    transH (apH {W0.Ix (XBE.RH.F0.ob Y)} {W0.Ix (FTg.FE.ob Y)} (XBE.extV Y) Leq) (XBE.ext-rho Y lnq) ;
   law : Id (EKg.TS.EI Y) (EKg.TS.pr Y ((P10.psi X w).1 qq i.2) MQ.fib) (EKg.TS.pr Y ((P10.psi X w).1 qq i.2) (u.1 qq i.2)) =
    EKg.ts-ext Y (EKg.TS.pr Y ((P10.psi X w).1 qq i.2) MQ.fib) (EKg.TS.pr Y ((P10.psi X w).1 qq i.2) (u.1 qq i.2))
     (refl ((P10.psi X w).1 qq i.2))
     (\ Vb g j -> apH {W0.Ix (FTg.FE.ob Y)} {EKg.TA.EI Vb} (\ MM -> MM.1 Vb g j) lineEq) ;
  } ;
  bkMv : Id (P14.Tot0 X) (P13.mS X vt) (P10.psi X w, u) =
   P14.totEq X (P13.mS X vt) (P10.psi X w, u) (refl (P10.psi X w))
    (\ q lq -> PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].law) ;
 } ;
} ;
