-- CTotL12i.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part i: piece 0 and the face piece k agree on
-- their overlap (the side is an element of D A, so its value at the face
-- k of a weight is its value through the face k of the chain: Lemma12I's
-- uniform faces; then level m's extension of the side, P2t).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;

module L12i (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LH = CTotL12h[a, vl, l].L12h[C, G, A] ;
 module LC = CTotL12c[a, vl, l].L12c[C, G, A] ;
 module LA = LH.LA ;
 module CL = LH.CL ;
 module TR = LA.TR ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LH.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;

 module Fi (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FH = LH.Fh[X, gm, s] ;
  module FG = FH.FG ;
  module FC = LC.Fc[X, gm, s] ;
  module FB = FC.FB ;
  module F = FH.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  module QF (m : Nat) (p : F.Up m) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn (suc m) J)
    (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) {
   module Q0 = FC.Q0[suc m, J, u, z, c, i] ;
   module FP = FH.FP[m, p, J, u, z, c, i, k, hk] ;
   module G2 (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) (lv : PB.Lands W1 J Q0.Q v) (lh : PB.Lands W1 J FP.Q v) {
    uv : Hom W1 I = compH W1 J I u v ;
    cc : CT.Ch W1 (suc m) (C.res W1 I uv x) y = FP.chT W1 v y e ;
    lU : PB.Lands W1 I s.pQ uv = PB.lands-pre W1 J I u s.pQ v lv ;
    module R1 = FB.RC[suc m, W1, y, uv, cc, lU, Wt.Res[suc m, W1, J, v, i].res] ;
    ry : Obj W1 = R1.ry ;
    pwk : Wt.Pn m W1 = FP.pw W1 v lh ;
    module UAm = LA.L1.UA[W1, ry, R1.t.1, R1.t.2, m, W1, idH W1, y, R1.CA.ch, pwk] ;
    D0 : DO.KJ[W1].K.DR m ry y = DO.KJ[W1].K.fc m k ry y cc ;
    qh : Id (Obj W1) ry (C.res W1 W1 (idH W1) ry) = symH (C.res-id W1 ry) ;
    c2 : CT.Ch W1 m (C.res W1 W1 (idH W1) ry) D0.1 = CT.trCh W1 m ry (C.res W1 W1 (idH W1) ry) qh D0.1 D0.2.1 ;
    module CA2 = CL.Cart[W1, I, uv, x, m, D0.1, D0.2.1] ;
    s1 : Id (DA.Ez W1 y) (Q0.vg W1 v y e lv) (UAm.lhs k hk) =
     symH (apH {Wt.Pn (suc m) W1} {DA.Ez W1 y} (\ q -> LH.LB.rdT R1.Xv R1.t (suc m, W1, idH W1, y, R1.CA.ch, q.1) q.2) (FP.wpU W1 v lh)) ;
    s3 : Id (DA.Ez W1 y) (UAm.rhs k) (UAm.rd (D0.1, c2, D0.2.2)) =
     apH {DO.KJ[W1].K.DR m (C.res W1 W1 (idH W1) ry) y} {DA.Ez W1 y} UAm.rd (CL.fc-trCh W1 m k ry (C.res W1 W1 (idH W1) ry) qh y cc) ;
    s4 : Id (DA.Ez W1 D0.1) (FB.F.rd R1.Xv R1.f lU (m, W1, idH W1, D0.1, c2, pwk.1) pwk.2) (F.pzv m (F.top m p) W1 uv D0.1 D0.2.1 pwk) =
     transH (symH (FG.p2of m p R1.Xv R1.f lU W1 (idH W1) D0.1 c2 pwk))
      (apH {D.S I x m W1 D0.1} {DA.Ez W1 D0.1} (\ sw -> F.pzv m (F.top m p) W1 sw.1 D0.1 sw.2 pwk)
         (D.sEq I x m W1 D0.1 (compH W1 W1 I uv (idH W1)) uv (comp-idr W1 I uv)
            (CT.rxM W1 W1 I (idH W1) uv ry x CA2.g0 m D0.1 c2) D0.2.1 CA2.law)) ;
    law : Id (DA.Ez W1 y) (Q0.vg W1 v y e lv) (FP.vg W1 v y e lh) =
     transH s1 (transH (UAm.uf k hk) (transH s3
      (ap (DA.Ez W1 D0.1) (DA.Ez W1 y) (\ q -> DA.E.act (W1, y) (W1, D0.1) (idH W1, D0.2.2) q)
         (FB.F.rd R1.Xv R1.f lU (m, W1, idH W1, D0.1, c2, pwk.1) pwk.2) (F.pzv m (F.top m p) W1 uv D0.1 D0.2.1 pwk) s4))) ;
   } ;
   qf (W : Ob0) (h : TR.RN.Hom0 W Q0.Y) (lw : PB.Lands W.1 J Q0.Q h.1) (lw' : PB.Lands W.1 J FP.Q h.1)
    : Id (DA.Ez W.1 W.2) (Q0.pv W h lw) (FP.pv W h lw') = G2[W.1, h.1, W.2, symH h.2, lw, lw'].law ;
  } ;
 } ;
} ;
