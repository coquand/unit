-- CwFQuotElim4.seg (canonicity-c2; SIMPLIFIED.md item 3): extensionality
-- on classes, for a closed set B (asked by canonicity-45):
--   ext1  two maps Qt -> B equal at every class are equal (pointwise by
--         elimP1, then funext NF)
--   ext2  the same for Qt -> Qt -> B (ext1 into Fun Qt B, over ext1)
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module MP = CwFMaps.Maps[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module QE4 (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
 module AX = Q1.AX ;
 Nl : C.Ctx = C.nil ;
 Qt : C.Ty Nl = AX.Qt ;
 G1 : C.Ctx = C.ext Nl Qt ;
 module X1m (B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy) (f g : C.El Nl (OV.Fun Nl Qt B))
   (h : (t : AX.Term) -> C.El Nl (IJ.IdT Nl B (OV.app Nl Qt B f (AX.cls t)) (OV.app Nl Qt B g (AX.cls t)))) {
  module SBm = CwFFunSetB[a].SetB[B, sB] ;
  WB : C.Ty G1 = OV.wkT Nl Qt B ;
  Pw : C.Ty G1 = IJ.IdT G1 WB (OV.bod Nl Qt WB f) (OV.bod Nl Qt WB g) ;
  pPw : C.El G1 (PU.isProp G1 Pw) = SBm.idPB G1 (C.p Nl Qt) (OV.bod Nl Qt WB f) (OV.bod Nl Qt WB g) ;
  module H (u : AX.Term) {
   c : C.El Nl Qt = AX.cls u ;
   PI : Id (C.Ty Nl) (C.subT Nl G1 Pw (C.sec Nl Qt c)) (IJ.IdT Nl B (OV.app Nl Qt B f c) (OV.app Nl Qt B g c)) =
    OV.Id-ov Nl G1 WB (OV.bod Nl Qt WB f) (OV.bod Nl Qt WB g) (C.sec Nl Qt c) B
      (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Qt B c) (OV.app Nl Qt B f c) (OV.app Nl Qt B g c)
      (refl (OV.app Nl Qt B f c)) (refl (OV.app Nl Qt B g c)) ;
   hh : C.El Nl (C.subT Nl G1 Pw (Q1.GQ.Sec1[c].sec1)) =
    OV.trE Nl (C.subT Nl G1 Pw (C.sec Nl Qt c)) (C.subT Nl G1 Pw (Q1.GQ.Sec1[c].sec1))
      (apH {C.Sub Nl G1} {C.Ty Nl} (\ s -> C.subT Nl G1 Pw s) (Q1.sS1 u))
      (OV.trE Nl (IJ.IdT Nl B (OV.app Nl Qt B f c) (OV.app Nl Qt B g c)) (C.subT Nl G1 Pw (C.sec Nl Qt c)) (symH PI) (h u)) ;
  } ;
  pw : C.El G1 Pw = Q1.elimP1 Pw pPw (\ u -> H[u].hh) ;
  res : C.El Nl (IJ.IdT Nl (OV.Fun Nl Qt B) f g) = FibNF[a, a+].nf Nl Qt WB f g (OV.lam Nl Qt Pw pw) ;
 } ;
 ext1 (B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy) (f g : C.El Nl (OV.Fun Nl Qt B))
   (h : (t : AX.Term) -> C.El Nl (IJ.IdT Nl B (OV.app Nl Qt B f (AX.cls t)) (OV.app Nl Qt B g (AX.cls t))))
   : C.El Nl (IJ.IdT Nl (OV.Fun Nl Qt B) f g) = X1m[B, sB, f, g, h].res ;
 ext2 (B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy) (f g : C.El Nl (OV.Fun Nl Qt (OV.Fun Nl Qt B)))
   (h : (t u : AX.Term) -> C.El Nl (IJ.IdT Nl B (AX.ap2 B f (AX.cls t) (AX.cls u)) (AX.ap2 B g (AX.cls t) (AX.cls u))))
   : C.El Nl (IJ.IdT Nl (OV.Fun Nl Qt (OV.Fun Nl Qt B)) f g) =
  ext1 (OV.Fun Nl Qt B) (CwFFunSetB[a].FunSetQ[Qt, B, sB].setQi) f g
    (\ t -> ext1 B sB (OV.app Nl Qt (OV.Fun Nl Qt B) f (AX.cls t)) (OV.app Nl Qt (OV.Fun Nl Qt B) g (AX.cls t)) (\ u -> h t u)) ;
} ;
