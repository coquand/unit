-- Read generator evaluation of the term-coded F3 homomorphism.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, C].IdJStr = FibId[a, a+].fibId ;

module Beta (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (y : SX.Over[R].Presentation) (t1 t2 t3 : CAlgX[a].AlgX[R, encK, y, pe].Term) {
 module E = CF3Eval[a].Eval3[R, encK, pe, y] ;
 module CT = CF3TermCodes[a].Codes[R, encK, pe, y] ;
 module T = CT.Triple[t1, t2, t3] ;
 module One (i : SX.Fin CT.F.F3.1) (t : CT.AY.Term)
  (b : C.El C.nil (IJ.IdT C.nil E.QY
    (OV.app C.nil CT.A3.Qt E.QY T.phi (CT.A3.cls (var i))) (CT.AY.cls t))) {
  module Ev = E.At[i] ;
  ev : C.El C.nil (OV.Fun C.nil E.HS E.QY) =
   QinvEq[a, a+].FunOf[C.nil, E.HS, E.QY, Ev.nmap].fC ;
  rd (K : Ob) : Id (V1.Ix (E.QY.1.tob K tt))
   (Ev.nmap.nfun K tt (T.zc.eob K tt))
   ((OV.app C.nil CT.A3.Qt E.QY T.phi (CT.A3.cls (var i))).eob K tt) =
   symH (CAppRd[a].App0[CT.A3.Qt, E.QY, T.phi, CT.A3.cls (var i)].rd K tt) ;
  px (K : Ob) : Id (V1.Ix (E.QY.1.tob K tt))
   ((OV.app C.nil E.HS E.QY ev T.zc).eob K tt)
   ((OV.app C.nil CT.A3.Qt E.QY T.phi (CT.A3.cls (var i))).eob K tt) =
   transH (CAppRd[a].App0[E.HS, E.QY, ev, T.zc].rd K tt) (rd K) ;
  pxg (K : Ob) : (w : Top) -> Id (V1.Ix (E.QY.1.tob K w))
   ((OV.app C.nil CT.A3.Qt E.QY T.phi (CT.A3.cls (var i))).eob K w)
   ((OV.app C.nil E.HS E.QY ev T.zc).eob K w) =
   split { tt -> symH (px K) } ;
  e : C.El C.nil (IJ.IdT C.nil E.QY (OV.app C.nil E.HS E.QY ev T.zc) (CT.AY.cls t)) =
   CCmpU14[a].rwId C.nil E.QY
    (OV.app C.nil CT.A3.Qt E.QY T.phi (CT.A3.cls (var i)))
    (OV.app C.nil E.HS E.QY ev T.zc)
    (CT.AY.cls t) (CT.AY.cls t)
    pxg (\ K w -> refl ((CT.AY.cls t).eob K w)) b ;
 } ;
 module O1 = One[inl (inl (inr tt)), t1, T.beta1] ;
 module O2 = One[inl (inr tt), t2, T.beta2] ;
 module O3 = One[inr tt, t3, T.beta3] ;
 module P12 = CProdSet[a].PairId[C.nil, E.QY, E.QY] ;
 a1 : C.El C.nil E.QY = OV.app C.nil E.HS E.QY O1.ev T.zc ;
 a2 : C.El C.nil E.QY = OV.app C.nil E.HS E.QY O2.ev T.zc ;
 a3 : C.El C.nil E.QY = OV.app C.nil E.HS E.QY O3.ev T.zc ;
 b1 : C.El C.nil E.QY = CT.AY.cls t1 ;
 b2 : C.El C.nil E.QY = CT.AY.cls t2 ;
 b3 : C.El C.nil E.QY = CT.AY.cls t3 ;
 A12 : C.El C.nil E.P12.YZ = P12.prN a1 a2 ;
 B12 : C.El C.nil E.P12.YZ = P12.prN b1 b2 ;
 p12 : C.El C.nil (IJ.IdT C.nil E.P12.YZ A12 B12) =
  CProdSet[a].PE[C.nil, E.QY, E.QY, a1, b1, a2, b2, O1.e, O2.e].res ;
 module P123 = CProdSet[a].PairId[C.nil, E.P12.YZ, E.QY] ;
 A123 : C.El C.nil E.QYYY = P123.prN A12 a3 ;
 B123 : C.El C.nil E.QYYY = P123.prN B12 b3 ;
 p123 : C.El C.nil (IJ.IdT C.nil E.QYYY A123 B123) =
  CProdSet[a].PE[C.nil, E.P12.YZ, E.QY, A12, B12, a3, b3, p12, O3.e].res ;
 r12 (K : Ob) : Id (V1.Ix (E.P12.YZ.1.tob K tt))
  (A12.eob K tt) (E.P12.nmap.nfun K tt (T.zc.eob K tt)) =
  transH (P12.prR a1 a2 K tt)
   (transH
    (apH {V1.Ix (E.QY.1.tob K tt)} {V1.Ix (E.P12.YZ.1.tob K tt)}
      (\ v -> (v, a2.eob K tt))
      (CAppRd[a].App0[E.HS, E.QY, O1.ev, T.zc].rd K tt))
    (apH {V1.Ix (E.QY.1.tob K tt)} {V1.Ix (E.P12.YZ.1.tob K tt)}
      (\ v -> (E.E1.nmap.nfun K tt (T.zc.eob K tt), v))
      (CAppRd[a].App0[E.HS, E.QY, O2.ev, T.zc].rd K tt))) ;
 r123 (K : Ob) : Id (V1.Ix (E.QYYY.1.tob K tt))
  (A123.eob K tt) (E.P123.nmap.nfun K tt (T.zc.eob K tt)) =
  transH (P123.prR A12 a3 K tt)
   (transH
    (apH {V1.Ix (E.P12.YZ.1.tob K tt)} {V1.Ix (E.QYYY.1.tob K tt)}
      (\ v -> (v, a3.eob K tt)) (r12 K))
    (apH {V1.Ix (E.QY.1.tob K tt)} {V1.Ix (E.QYYY.1.tob K tt)}
      (\ v -> (E.P12.nmap.nfun K tt (T.zc.eob K tt), v))
      (CAppRd[a].App0[E.HS, E.QY, O3.ev, T.zc].rd K tt))) ;
 rdEv (K : Ob) : Id (V1.Ix (E.QYYY.1.tob K tt))
  ((OV.app C.nil E.HS E.QYYY E.ev3 T.zc).eob K tt)
  (E.P123.nmap.nfun K tt (T.zc.eob K tt)) =
  CAppRd[a].App0[E.HS, E.QYYY, E.ev3, T.zc].rd K tt ;
 rEv (K : Ob) : Id (V1.Ix (E.QYYY.1.tob K tt))
  (A123.eob K tt) ((OV.app C.nil E.HS E.QYYY E.ev3 T.zc).eob K tt) =
  transH (r123 K) (symH (rdEv K)) ;
 rEvg (K : Ob) : (w : Top) -> Id (V1.Ix (E.QYYY.1.tob K w))
  (A123.eob K w) ((OV.app C.nil E.HS E.QYYY E.ev3 T.zc).eob K w) =
  split { tt -> rEv K } ;
 witness : C.El C.nil (IJ.IdT C.nil E.QYYY
  (OV.app C.nil E.HS E.QYYY E.ev3 T.zc) B123) =
  CCmpU14[a].rwId C.nil E.QYYY A123
   (OV.app C.nil E.HS E.QYYY E.ev3 T.zc) B123 B123
   rEvg (\ K w -> refl (B123.eob K w)) p123 ;
} ;
