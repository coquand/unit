-- CHomT1.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- algebras, part 1.  For closed sets QS, QT and the closed type of maps
-- MapT = Fun QS QT, over Gh = nil.MapT (the variable map h), fibres at the
-- point o of nil (no unit eta):
--   hv, NTh   h read at the identity of the stage, and its naturality
--             (CSemOp's step C on the Fun fibre)
--   BinOf[opS, opT]: the data type of a binary operation,
--   W4        the closed type Sigma u1 u2 v (opS u1 u2 = v) (one Pi level
--             over it, so its fibres are indexed as CMorX's data)
--   sigT      Gh.W4 -> nil.QT^3, (h u1, h u2, h v) (semantic)
--   DataBin   Pi (w : W4). opT (h u1) (h u2) = h v
-- Built with the CwF's formers along semantic substitutions, so fibrant.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
PS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].PiStr = FibCwF[a, a+].fibPi ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module BaseOf (QS QT : C.Ty C.nil) {
 Nl : C.Ctx = C.nil ;
 module GS = CQCtx[a].G3Of[QS] ;
 module GT = CQCtx[a].G3Of[QT] ;
 MapT : C.Ty Nl = OV.Fun Nl QS QT ;
 Gh : C.Ctx = C.ext Nl MapT ;
 pG : C.Sub Gh Nl = C.p Nl MapT ;
 NO (K : Ob) : U a+ = V1.Ix (Nl.ob K) ;
 SK (K : Ob) (o : NO K) : U a+ = V1.Ix (QS.1.tob K o) ;
 TK (K : Ob) (o : NO K) : U a+ = V1.Ix (QT.1.tob K o) ;
 -- reading the variable map at the identity, and its naturality
 MK (K : Ob) (o : NO K) : U a+ = V1.Ix (MapT.1.tob K o) ;
 rsS (K L0 : Ob) (g : Hom L0 K) (o : NO K) (u : SK K o) : SK L0 o = QS.1.tact L0 K g o o (refl o) u ;
 rsT (K L0 : Ob) (g : Hom L0 K) (o : NO K) (b : TK K o) : TK L0 o = QT.1.tact L0 K g o o (refl o) b ;
 rsM (K L0 : Ob) (g : Hom L0 K) (o : NO K) (h : MK K o) : MK L0 o = MapT.1.tact L0 K g o o (refl o) h ;
 hv (K : Ob) (o : NO K) (h : MK K o) (u : SK K o) : TK K o = h.1 K (idH K) u ;
 module NTh (K L0 : Ob) (g : Hom L0 K) (o : NO K) (h : MK K o) (u : SK K o) {
  module PC = PresheafPi[a, a+].PPi[PB.BC].PiCode[Nl, QS.1, (OV.wkT Nl QS QT).1] ;
  mC : TK L0 o = PC.BactOf K (PC.ptOf K o) (PC.cOf K o) (PC.eOf K o) K L0 (idH K) g u (h.1 K (idH K) u) ;
  aC : SK L0 o = PC.AactOf K (PC.ptOf K o) (PC.cOf K o) K L0 (idH K) g u ;
  sC : Id (TK L0 o) (rsT K L0 g o (hv K o h u)) (h.1 L0 (compH L0 K K (idH K) g) (rsS K L0 g o u)) =
   transH {TK L0 o} {rsT K L0 g o (hv K o h u)} {mC} {h.1 L0 (compH L0 K K (idH K) g) (rsS K L0 g o u)}
    (L.tact-irr Nl QT.1 L0 K g o o (refl o) (L.ntEq (C.ext Nl QS) Nl (C.p Nl QS) L0 K g (L.pairE Nl QS.1 K o u) (L.pairE Nl QS.1 L0 o aC) (PC.eOf K o K L0 (idH K) g u)) (hv K o h u))
    (transH {TK L0 o} {mC} {h.1 L0 (compH L0 K K (idH K) g) aC} {h.1 L0 (compH L0 K K (idH K) g) (rsS K L0 g o u)}
      (h.2 K L0 (idH K) g u)
      (apH {SK L0 o} {TK L0 o} (\ b -> h.1 L0 (compH L0 K K (idH K) g) b) (L.tact-irr Nl QS.1 L0 K g o o (PC.cOf K o K L0 (idH K) g) (refl o) u))) ;
  law : Id (TK L0 o) (hv L0 o (rsM K L0 g o h) (rsS K L0 g o u)) (rsT K L0 g o (hv K o h u)) =
   transH {TK L0 o} {hv L0 o (rsM K L0 g o h) (rsS K L0 g o u)} {h.1 L0 (compH L0 K K (idH K) g) (rsS K L0 g o u)} {rsT K L0 g o (hv K o h u)}
    (apH {Hom L0 K} {TK L0 o} (\ k -> h.1 L0 k (rsS K L0 g o u)) (transH (comp-idr L0 K g) (symH (comp-idl L0 K g))))
    (symH sC) ;
 } ;
 module BinOf (opS : C.El C.nil (OV.Fun C.nil QS (OV.Fun C.nil QS QS))) (opT : C.El C.nil (OV.Fun C.nil QT (OV.Fun C.nil QT QT))) {
  W4 : C.Ty Nl = SS.Sig Nl QS (SS.Sig GS.G1 GS.Qw (SS.Sig GS.G2 GS.Qw2 (GS.OpTy[opS].IdOp))) ;
  W4h : C.Ty Gh = C.subT Gh Nl W4 pG ;
  Dw : C.Ctx = C.ext Gh W4h ;
  sigN (K : Ob) (x : V1.Ix (Dw.ob K)) : V1.Ix (GT.G3.ob K) =
   (((x.1.1, hv K x.1.1 x.1.2 x.2.1), hv K x.1.1 x.1.2 x.2.2.1), hv K x.1.1 x.1.2 x.2.2.2.1) ;
  module SN (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (Dw.ob K)) {
   o : NO K = x.1.1 ;
   h : MK K o = x.1.2 ;
   PT3 : U a+ = V1.Ix (GT.G3.ob L0) ;
   y : V1.Ix (Dw.ob L0) = Dw.act L0 K g x ;
   b1 : TK L0 o = rsT K L0 g o (hv K o h x.2.1) ;
   b2 : TK L0 o = rsT K L0 g o (hv K o h x.2.2.1) ;
   b3 : TK L0 o = rsT K L0 g o (hv K o h x.2.2.2.1) ;
   law : Id PT3 (sigN L0 y) (((o, b1), b2), b3) =
    transH {PT3} {sigN L0 y} {(((o, b1), hv L0 o y.1.2 y.2.2.1), hv L0 o y.1.2 y.2.2.2.1)} {(((o, b1), b2), b3)}
     (apH {TK L0 o} {PT3} (\ z -> (((o, z), hv L0 o y.1.2 y.2.2.1), hv L0 o y.1.2 y.2.2.2.1)) NTh[K, L0, g, o, h, x.2.1].law)
     (transH {PT3} {(((o, b1), hv L0 o y.1.2 y.2.2.1), hv L0 o y.1.2 y.2.2.2.1)} {(((o, b1), b2), hv L0 o y.1.2 y.2.2.2.1)} {(((o, b1), b2), b3)}
       (apH {TK L0 o} {PT3} (\ z -> (((o, b1), z), hv L0 o y.1.2 y.2.2.2.1)) NTh[K, L0, g, o, h, x.2.2.1].law)
       (apH {TK L0 o} {PT3} (\ z -> (((o, b1), b2), z)) NTh[K, L0, g, o, h, x.2.2.2.1].law)) ;
  } ;
  sigNat (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (Dw.ob K)) : Id (V1.Ix (GT.G3.ob L0)) (sigN L0 (Dw.act L0 K g x)) (GT.G3.act L0 K g (sigN K x)) =
   SN[L0, K, g, x].law ;
  sigT : C.Sub Dw GT.G3 = new L.PSub[Dw, GT.G3, sigN, sigNat] ;
  IdT3 : C.Ty Dw = C.subT Dw GT.G3 (GT.OpTy[opT].IdOp) sigT ;
  DataBin : C.Ty Gh = PS.Pi Gh W4h IdT3 ;
 } ;
} ;
