-- CAppRd.seg (canonicity-45; SIMPLIFIED.md step 6): reading an internal
-- application at a stage.  For a closed function f : Fun A B over the
-- terminal context, the application of its weakening to the variable,
-- app (wkF f) q over nil.A, reads at (tt, u) at the stage K as the value
-- of f's fibre family at the identity of K:
--   appRd f K u : (app (wkF f) q).eob K (tt, u) = (f.eob K tt).1 K id u
-- (bod f reads so on the nose; app (wkF f) q is bod f up to bodNat and
-- type transports between equal fibre codes).  The bridge from closed
-- algebra maps to morphisms of C reads all its terms through this.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

-- the reading of a transported element is the transported reading
trE-rd (G : C.Ctx) (A A' : C.Ty G) (P : Id (C.Ty G) A A') (e : C.El G A) (I : Ob) (x : V1.Ix (G.ob I))
 : Id (V1.Ix (A'.1.tob I x)) ((OV.trE G A A' P e).eob I x) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A' P (e.eob I x)) =
 idJ (C.Ty G) A (\ A2 P2 -> Id (V1.Ix (A2.1.tob I x)) ((OV.trE G A A2 P2 e).eob I x) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A2 P2 (e.eob I x)))
  (refl (e.eob I x)) A' P ;
-- a transport between types with the same fibre code at x is trivial there
same-rd (G : C.Ctx) (A A' : C.Ty G) (P : Id (C.Ty G) A A') (I : Ob) (x : V1.Ix (G.ob I)) (E2 : Id V1.V (A.1.tob I x) (A'.1.tob I x)) (v : V1.Ix (A.1.tob I x))
 : Id (V1.Ix (A'.1.tob I x)) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A' P v) (subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A'.1.tob I x) E2 v) =
 transH (idJ (C.Ty G) A (\ A2 P2 -> Id (V1.Ix (A2.1.tob I x)) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A2 P2 v)
                                       (subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A2.1.tob I x) (apH {C.Ty G} {V1.V} (\ T -> T.1.tob I x) P2) v))
          (refl v) A' P)
  (apH {Id V1.V (A.1.tob I x) (A'.1.tob I x)} {V1.Ix (A'.1.tob I x)} (\ r -> subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A'.1.tob I x) r v)
     (V1.isSetV (A.1.tob I x) (A'.1.tob I x) (apH {C.Ty G} {V1.V} (\ T -> T.1.tob I x) P) E2)) ;

-- derived CwF members, named through an open
module CWh (C0 : CwF.CwF[a++]) {
 open C0 ;
 plT (D G : Ctx) (A B : Ty G) (s : Sub D G)
  : Id (Ty (ext D (subT D G A s))) (subT (ext D (subT D G A s)) (ext G A) (subT (ext G A) G B (p G A)) (lift D G A s)) (subT (ext D (subT D G A s)) D (subT D G B s) (p D (subT D G A s))) =
  p-lift-T D G A B s ;
 psT (G : Ctx) (A B : Ty G) (a : C0.El G A) : Id (Ty G) (subT G (ext G A) (subT (ext G A) G B (p G A)) (sec G A a)) B = p-sec-T G A B a ;
} ;
module W = CWh[FibCwF[a, a+].fibCwF] ;

module AppRd (A B : C.Ty C.nil) (f : C.El C.nil (OV.Fun C.nil A B)) {
 Nl : C.Ctx = C.nil ;
 G1 : C.Ctx = C.ext Nl A ;
 Aw : C.Ty G1 = OV.wkT Nl A A ;
 Bw : C.Ty G1 = OV.wkT Nl A B ;
 G2 : C.Ctx = C.ext G1 Aw ;
 B2 : C.Ty G2 = OV.wkT G1 Aw Bw ;
 fw : C.El G1 (OV.Fun G1 Aw Bw) = EQ.wkF Nl A A B f ;
 sc : C.Sub G1 G2 = C.sec G1 Aw (C.q Nl A) ;
 -- bod (wkF f) is bod f along lift p
 bN : Id (C.El G2 B2) (OV.bod G1 Aw B2 fw)
         (OV.trE G2 (C.subT G2 (C.ext Nl A) (OV.wkT Nl A B) (C.lift G1 Nl A (C.p Nl A))) B2 (W.plT G1 Nl A B (C.p Nl A))
            (C.subt G2 (C.ext Nl A) (OV.wkT Nl A B) (OV.bod Nl A (OV.wkT Nl A B) f) (C.lift G1 Nl A (C.p Nl A)))) =
  OV.bodNat G1 Nl A (OV.wkT Nl A B) (C.p Nl A) B2 (W.plT G1 Nl A B (C.p Nl A)) (EQ.wkFP Nl A A B) f ;
 QK (K : Ob) : U a+ = V1.Ix (A.1.tob K tt) ;
 QB (K : Ob) : U a+ = V1.Ix (B.1.tob K tt) ;
 appRd (K : Ob) (u : QK K) : Id (QB K) ((OV.app G1 Aw Bw fw (C.q Nl A)).eob K (tt, u)) ((f.eob K tt).1 K (idH K) u) =
  transH (trE-rd G1 (C.subT G1 G2 B2 sc) Bw (W.psT G1 Aw Bw (C.q Nl A)) (C.subt G1 G2 B2 (OV.bod G1 Aw B2 fw) sc) K (tt, u))
   (transH (same-rd G1 (C.subT G1 G2 B2 sc) Bw (W.psT G1 Aw Bw (C.q Nl A)) K (tt, u) (refl (B.1.tob K tt)) ((OV.bod G1 Aw B2 fw).eob K ((tt, u), u)))
     (transH (apH {C.El G2 B2} {QB K} (\ e -> e.eob K ((tt, u), u)) bN)
       (transH (trE-rd G2 (C.subT G2 (C.ext Nl A) (OV.wkT Nl A B) (C.lift G1 Nl A (C.p Nl A))) B2 (W.plT G1 Nl A B (C.p Nl A))
                  (C.subt G2 (C.ext Nl A) (OV.wkT Nl A B) (OV.bod Nl A (OV.wkT Nl A B) f) (C.lift G1 Nl A (C.p Nl A))) K ((tt, u), u))
         (same-rd G2 (C.subT G2 (C.ext Nl A) (OV.wkT Nl A B) (C.lift G1 Nl A (C.p Nl A))) B2 (W.plT G1 Nl A B (C.p Nl A)) K ((tt, u), u)
            (refl (B.1.tob K tt)) ((OV.bod Nl A (OV.wkT Nl A B) f).eob K (tt, u)))))) ;
} ;
