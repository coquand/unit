-- CTotRSeed.seg (canonicity-c2; SIMPLIFIED.md item 5): R transfers the
-- seeded extension operation (extend a partial element, given a total
-- seed): the form in which a type is a proposition.  The proof is
-- CTotR's transfer of contractions (L9.KO) with the seed carried along:
-- at (Y, m, p) the seed is the component of the given seed.
--   opR   a seeded operation of B at the levelwise site gives one of R B
--         at the total site
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RSeed (C : CIntCat[a, vl].IC) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;

 module SO (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (op : G0.FT.GCTruncSeededBack[l].Seeded[RS.rC G, B].Op) {
  module L9 = TR.L9[G, B] ;
  module RT = L9.RT ;
  module Px = L9.Px ;
  module Py = L9.Py ;
  UG : P0.PCtx = L9.UG ;
  Ob1 : U vl = RN.Ob1 ;
  Ob0 : U vl = RN.Ob0 ;
  Pt (X : Ob1) : U l = L9.Pt X ;
  Tot1 (X : Ob1) : U l = L9.Tot1 X ;
  Tot0 (Y : Ob0) : U l = L9.Tot0 Y ;
  E1 : P1.PCtx = L9.E1 ;
  E0 : P0.PCtx = L9.E0 ;
  prI (Z : Ob0) (t : Tot1 (RN.o Z)) : Tot0 Z = L9.prI Z t ;
  mh (X : Ob1) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) (Z : Ob0) (h : RN.Hom0 Z Y) : RN.Hom1 (RN.o Z) X = L9.mh X Y m Z h ;
  mhc (X : Ob1) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) (Z' Z : Ob0) (chi : RN.Hom0 Z' Z) (h : RN.Hom0 Z Y)
   : Id (RN.Hom1 (RN.o Z') X) (G1.GB.BC.oC (RN.o Z') (RN.o Z) X (mh X Y m Z h) (TR.fn.onH Z' Z chi)) (mh X Y m Z' (G0.GB.BC.oC Z' Z Y h chi)) =
   L9.mhc X Y m Z' Z chi h ;
  module TL0 = G0.GB.GPre[l].TyL[UG, B] ;
  kfam (X : Ob1) (g : Pt X) (u : RT.T X g) (s : Px.Side[X, g]) : RT.Fam X g = \ Y m p e -> op.kop Y p (u.1 Y m p e) L9.PS[X, g, s, Y, m, p, e].side ;
  module KN (X : Ob1) (g : Pt X) (u : RT.T X g) (s : Px.Side[X, g]) (Z Y : Ob0) (h : RN.Hom0 Z Y) (m : RN.Hom1 (RN.o Y) X) (p : Pt (RN.o Y))
    (e : Id (Pt (RN.o Y)) p (G.act (RN.o Y) X m g)) {
   q0 : Pt (RN.o Z) = UG.act Z Y h p ;
   e0' : Id (Pt (RN.o Z)) q0 (G.act (RN.o Z) X (mh X Y m Z h) g) =
    transH (apH {Pt (RN.o Y)} {Pt (RN.o Z)} (\ z -> G.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) z) e)
     (symH (G.act-o (RN.o Z) (RN.o Y) X m (TR.fn.onH Z Y h) g)) ;
   module S = L9.PS[X, g, s, Y, m, p, e] ;
   module S' = L9.PS[X, g, s, Z, mh X Y m Z h, q0, e0'] ;
   rs : Py.Side[Z, q0] = Py.rside Z Y h p S.side ;
   eQ : Id (G0.GB.Phi Z) rs.pQ S'.side.pQ = G1.GB.pre-comp (RN.o Z) (RN.o Y) X (TR.fn.onH Z Y h) m s.pQ ;
   ev (W : Ob0) (k : RN.Hom0 W Z) (i : G0.GB.Lands W Z rs.pQ k) (i' : G0.GB.Lands W Z S'.side.pQ k)
    : Id (Tot0 W) (rs.pv W k i) (S'.side.pv W k i') =
    ap (Tot1 (RN.o W)) (Tot0 W) (prI W)
     (s.pv (RN.o W) (mh X Y m W (G0.GB.BC.oC W Z Y h k)) (G0.GB.lands-pre W Z Y h S.side.pQ k i))
     (s.pv (RN.o W) (mh X Z (mh X Y m Z h) W k) i')
     (Px.pv-hom X g s (RN.o W) (mh X Y m W (G0.GB.BC.oC W Z Y h k)) (mh X Z (mh X Y m Z h) W k)
        (symH (mhc X Y m W Z k h)) (G0.GB.lands-pre W Z Y h S.side.pQ k i) i') ;
   sideEq : Id (Py.Side[Z, q0]) rs S'.side = Py.side-ext Z q0 rs S'.side eQ ev ;
   sd : W0.Ix (B.tob Y p) = u.1 Y m p e ;
   sd' : W0.Ix (B.tob Z q0) = u.1 Z (mh X Y m Z h) q0 e0' ;
   sdr : W0.Ix (B.tob Z q0) = B.tact Z Y h p q0 (refl q0) sd ;
   core : Id (W0.Ix (B.tob Z q0)) (B.tact Z Y h p q0 (refl q0) (op.kop Y p sd S.side)) (op.kop Z q0 sd' S'.side) =
    TL0.pr-inj Z q0 (B.tact Z Y h p q0 (refl q0) (op.kop Y p sd S.side)) (op.kop Z q0 sd' S'.side)
     (trans (Tot0 Z) (E0.act Z Y h (P0.pairE UG B Y p (op.kop Y p sd S.side))) (P0.pairE UG B Z q0 (op.kop Z q0 sdr rs)) (P0.pairE UG B Z q0 (op.kop Z q0 sd' S'.side))
        (op.kunif Z Y h p sd S.side)
        (trans (Tot0 Z) (P0.pairE UG B Z q0 (op.kop Z q0 sdr rs)) (P0.pairE UG B Z q0 (op.kop Z q0 sd' rs)) (P0.pairE UG B Z q0 (op.kop Z q0 sd' S'.side))
           (ap (W0.Ix (B.tob Z q0)) (Tot0 Z) (\ w -> P0.pairE UG B Z q0 (op.kop Z q0 w rs)) sdr sd' (u.2 Z Y h m p e q0 e0' (refl q0)))
           (ap (Py.Side[Z, q0]) (Tot0 Z) (\ z -> P0.pairE UG B Z q0 (op.kop Z q0 sd' z)) rs S'.side sideEq))) ;
  } ;
  knat (X : Ob1) (g : Pt X) (u : RT.T X g) (s : Px.Side[X, g]) : RT.NatTy X g (kfam X g u s) =
   \ Z Y h m p e q e' e'' ->
    idJ (Pt (RN.o Z)) (UG.act Z Y h p)
     (\ q2 e2 -> (e3 : Id (Pt (RN.o Z)) q2 (RT.at X g Z (mh X Y m Z h)))
         -> Id (W0.Ix (B.tob Z q2)) (B.tact Z Y h p q2 e2 (kfam X g u s Y m p e)) (kfam X g u s Z (mh X Y m Z h) q2 e3))
     (\ e3 -> trans (W0.Ix (B.tob Z (UG.act Z Y h p))) (B.tact Z Y h p (UG.act Z Y h p) (refl (UG.act Z Y h p)) (kfam X g u s Y m p e))
                (kfam X g u s Z (mh X Y m Z h) (UG.act Z Y h p) KN[X, g, u, s, Z, Y, h, m, p, e].e0')
                (kfam X g u s Z (mh X Y m Z h) (UG.act Z Y h p) e3)
                KN[X, g, u, s, Z, Y, h, m, p, e].core
                (ap (Id (Pt (RN.o Z)) (UG.act Z Y h p) (RT.at X g Z (mh X Y m Z h))) (W0.Ix (B.tob Z (UG.act Z Y h p)))
                   (\ z -> kfam X g u s Z (mh X Y m Z h) (UG.act Z Y h p) z) KN[X, g, u, s, Z, Y, h, m, p, e].e0' e3
                   (W0.isSetIx (G.ob (RN.o Z)) (UG.act Z Y h p) (RT.at X g Z (mh X Y m Z h)) KN[X, g, u, s, Z, Y, h, m, p, e].e0' e3)))
     q e'' e' ;
  kop (X : Ob1) (g : Pt X) (u : RT.T X g) (s : Px.Side[X, g]) : W0.Ix (RT.RB.tob X g) = RT.mk X g (kfam X g u s) (knat X g u s) ;

  -- uniformity: the action of R B is reindexing, and the projected sides agree
  module KU (Y X : Ob1) (h : RN.Hom1 Y X) (g : Pt X) (u : RT.T X g) (s : Px.Side[X, g]) (Y0 : Ob0) (m : RN.Hom1 (RN.o Y0) Y) (p : Pt (RN.o Y0))
    (e : Id (Pt (RN.o Y0)) p (G.act (RN.o Y0) Y m (G.act Y X h g))) {
   g' : Pt Y = G.act Y X h g ;
   module A = RT.Act[Y, X, h, g, g', refl g', kop X g u s] ;
   hm : RN.Hom1 (RN.o Y0) X = G1.GB.BC.oC (RN.o Y0) Y X h m ;
   module S1 = L9.PS[X, g, s, Y0, hm, p, transH e (A.ek Y0 m)] ;
   rs : Px.Side[Y, g'] = Px.rside Y X h g s ;
   module S2 = L9.PS[Y, g', rs, Y0, m, p, e] ;
   eQ : Id (G0.GB.Phi Y0) S1.side.pQ S2.side.pQ = symH (G1.GB.pre-comp (RN.o Y0) Y X m h s.pQ) ;
   as (Z : Ob0) (k : RN.Hom0 Z Y0)
    : Id (RN.Hom1 (RN.o Z) X) (mh X Y0 hm Z k) (G1.GB.BC.oC (RN.o Z) Y X h (mh Y Y0 m Z k)) =
    G1.GB.BC.oC-assoc (RN.o Z) (RN.o Y0) Y X h m (TR.fn.onH Z Y0 k) ;
   ev (Z : Ob0) (k : RN.Hom0 Z Y0) (i : G0.GB.Lands Z Y0 S1.side.pQ k) (i' : G0.GB.Lands Z Y0 S2.side.pQ k)
    : Id (Tot0 Z) (S1.side.pv Z k i) (S2.side.pv Z k i') =
    ap (Tot1 (RN.o Z)) (Tot0 Z) (prI Z)
     (s.pv (RN.o Z) (mh X Y0 hm Z k) i)
     (s.pv (RN.o Z) (G1.GB.BC.oC (RN.o Z) Y X h (mh Y Y0 m Z k)) (G1.GB.lands-pre (RN.o Z) Y X h s.pQ (mh Y Y0 m Z k) i'))
     (Px.pv-hom X g s (RN.o Z) (mh X Y0 hm Z k) (G1.GB.BC.oC (RN.o Z) Y X h (mh Y Y0 m Z k)) (as Z k) i
        (G1.GB.lands-pre (RN.o Z) Y X h s.pQ (mh Y Y0 m Z k) i')) ;
   eq : Id (W0.Ix (B.tob Y0 p)) (A.b' Y0 m p e) (kfam Y g' RT.Act[Y, X, h, g, g', refl g', u].res rs Y0 m p e) =
    ap (Py.Side[Y0, p]) (W0.Ix (B.tob Y0 p)) (\ z -> op.kop Y0 p (u.1 Y0 hm p (transH e (A.ek Y0 m))) z) S1.side S2.side (Py.side-ext Y0 p S1.side S2.side eQ ev) ;
  } ;
  kunif (Y X : Ob1) (h : RN.Hom1 Y X) (g : Pt X) (u : RT.T X g) (s : Px.Side[X, g])
   : Id (Tot1 Y) (E1.act Y X h (P1.pairE G RT.RB X g (kop X g u s)))
       (P1.pairE G RT.RB Y (G.act Y X h g) (kop Y (G.act Y X h g) RT.Act[Y, X, h, g, G.act Y X h g, refl (G.act Y X h g), u].res (Px.rside Y X h g s))) =
   ap (W0.Ix (RT.RB.tob Y (G.act Y X h g))) (Tot1 Y) (\ v -> P1.pairE G RT.RB Y (G.act Y X h g) v)
    (RT.Act[Y, X, h, g, G.act Y X h g, refl (G.act Y X h g), kop X g u s].res)
    (kop Y (G.act Y X h g) RT.Act[Y, X, h, g, G.act Y X h g, refl (G.act Y X h g), u].res (Px.rside Y X h g s))
    (RT.famExt Y (G.act Y X h g) (RT.Act[Y, X, h, g, G.act Y X h g, refl (G.act Y X h g), kop X g u s].res)
       (kop Y (G.act Y X h g) RT.Act[Y, X, h, g, G.act Y X h g, refl (G.act Y X h g), u].res (Px.rside Y X h g s)) (\ Y0 m p e -> KU[Y, X, h, g, u, s, Y0, m, p, e].eq)) ;

  -- a family at equal maps and equal points
  famPt (X : Ob1) (g : Pt X) (b : RT.Fam X g) (Y : Ob0) (m m' : RN.Hom1 (RN.o Y) X) (pm : Id (RN.Hom1 (RN.o Y) X) m m')
   (p p' : Pt (RN.o Y)) (ep : Id (Pt (RN.o Y)) p p') (e : Id (Pt (RN.o Y)) p (RT.at X g Y m)) (e' : Id (Pt (RN.o Y)) p' (RT.at X g Y m'))
   : Id (W0.Ix (B.tob Y p')) (TL0.coeT Y p p' ep (b Y m p e)) (b Y m' p' e') =
   idJ (Pt (RN.o Y)) p (\ p2 ep2 -> (e2 : Id (Pt (RN.o Y)) p2 (RT.at X g Y m')) -> Id (W0.Ix (B.tob Y p2)) (TL0.coeT Y p p2 ep2 (b Y m p e)) (b Y m' p2 e2))
    (\ e2 -> RT.famCong X g b Y m m' pm p e e2) p' ep e' ;
  -- two totals of R B with equal points and the same families are equal
  totExt (W : Ob1) (t t' : Tot1 W) (e1 : Id (Pt W) t.1 t'.1)
   (q : (Y : Ob0) (m : RN.Hom1 (RN.o Y) W) (p : Pt (RN.o Y)) (e : Id (Pt (RN.o Y)) p (RT.at W t.1 Y m)) (e' : Id (Pt (RN.o Y)) p (RT.at W t'.1 Y m))
        -> Id (W0.Ix (B.tob Y p)) (t.2.1 Y m p e) (t'.2.1 Y m p e'))
   : Id (Tot1 W) t t' =
   idJ (Pt W) t.1
    (\ g2 e2 -> (w2 : RT.T W g2)
       -> ((Y : Ob0) (m : RN.Hom1 (RN.o Y) W) (p : Pt (RN.o Y)) (e : Id (Pt (RN.o Y)) p (RT.at W t.1 Y m)) (e' : Id (Pt (RN.o Y)) p (RT.at W g2 Y m))
             -> Id (W0.Ix (B.tob Y p)) (t.2.1 Y m p e) (w2.1 Y m p e'))
       -> Id (Tot1 W) t (P1.pairE G RT.RB W g2 w2))
    (\ w2 q2 -> ap (RT.T W t.1) (Tot1 W) (\ v -> P1.pairE G RT.RB W t.1 v) t.2 w2 (RT.famExt W t.1 t.2 w2 (\ Y m p e -> q2 Y m p e e)))
    t'.1 e1 t'.2 q ;

  -- the extension agrees with the side on its sieve
  module KS (X : Ob1) (g : Pt X) (u : RT.T X g) (s : Px.Side[X, g]) (W : Ob1) (f : RN.Hom1 W X) (i : G1.GB.Lands W X s.pQ f)
    (Y : Ob0) (m : RN.Hom1 (RN.o Y) W) (p : Pt (RN.o Y))
    (e : Id (Pt (RN.o Y)) p (RT.at W (G.act W X f g) Y m)) (e' : Id (Pt (RN.o Y)) p (RT.at W (s.pv W f i).1 Y m)) {
   R : Tot1 W = s.pv W f i ;
   module A = RT.Act[W, X, f, g, G.act W X f g, refl (G.act W X f g), kop X g u s] ;
   fm : RN.Hom1 (RN.o Y) X = G1.GB.BC.oC (RN.o Y) W X f m ;
   module S = L9.PS[X, g, s, Y, fm, p, transH e (A.ek Y m)] ;
   sk : W0.Ix (B.tob Y p) = u.1 Y fm p (transH e (A.ek Y m)) ;
   kv : W0.Ix (B.tob Y p) = op.kop Y p sk S.side ;
   i1 : G1.GB.Lands (RN.o Y) X s.pQ fm = G1.GB.lands-comp (RN.o Y) W X s.pQ f m i ;
   kI : RN.Hom1 (RN.o Y) X = mh X Y fm Y (G0.GB.BC.idC Y) ;
   eqI : Id (RN.Hom1 (RN.o Y) X) kI fm =
    transH (apH {RN.Hom1 (RN.o Y) (RN.o Y)} {RN.Hom1 (RN.o Y) X} (\ k -> G1.GB.BC.oC (RN.o Y) (RN.o Y) X fm k) (TR.fn.onId Y))
     (G1.GB.BC.oC-idr (RN.o Y) X fm) ;
   i0 : G0.GB.Lands Y Y S.Q (G0.GB.BC.idC Y) = G1.GB.lands-eq (RN.o Y) X s.pQ fm kI (symH eqI) i1 ;
   c1 : Id (Tot0 Y) (E0.act Y Y (G0.GB.BC.idC Y) (P0.pairE UG B Y p kv)) (S.side.pv Y (G0.GB.BC.idC Y) i0) =
    op.kside Y p sk S.side Y (G0.GB.BC.idC Y) i0 ;
   c0 : Id (Tot0 Y) (E0.act Y Y (G0.GB.BC.idC Y) (P0.pairE UG B Y p kv)) (P0.pairE UG B Y p kv) = E0.act-id Y (P0.pairE UG B Y p kv) ;
   gR : Pt (RN.o Y) = G.act (RN.o Y) W m R.1 ;
   c2 : Id (Tot1 (RN.o Y)) (s.pv (RN.o Y) kI i0) (E1.act (RN.o Y) W m R) =
    trans (Tot1 (RN.o Y)) (s.pv (RN.o Y) kI i0) (s.pv (RN.o Y) fm i1) (E1.act (RN.o Y) W m R)
     (Px.pv-hom X g s (RN.o Y) kI fm eqI i0 i1)
     (symH (s.pnat (RN.o Y) W m f i i1)) ;
   module AR = RT.Act[RN.o Y, W, m, R.1, gR, refl gR, R.2] ;
   EE : Id (Pt (RN.o Y)) gR (RT.at W R.1 Y (G1.GB.BC.oC (RN.o Y) (RN.o Y) W m (G1.GB.BC.idC (RN.o Y)))) =
    transH (symH (G.act-id (RN.o Y) gR)) (AR.ek Y (G1.GB.BC.idC (RN.o Y))) ;
   rv : W0.Ix (B.tob Y gR) = R.2.1 Y (G1.GB.BC.oC (RN.o Y) (RN.o Y) W m (G1.GB.BC.idC (RN.o Y))) gR EE ;
   c3 : Id (Tot0 Y) (P0.pairE UG B Y gR rv) (P0.pairE UG B Y p kv) =
    symH (trans (Tot0 Y) (P0.pairE UG B Y p kv) (E0.act Y Y (G0.GB.BC.idC Y) (P0.pairE UG B Y p kv)) (P0.pairE UG B Y gR rv)
            (symH c0)
            (trans (Tot0 Y) (E0.act Y Y (G0.GB.BC.idC Y) (P0.pairE UG B Y p kv)) (prI Y (s.pv (RN.o Y) kI i0)) (P0.pairE UG B Y gR rv)
               c1
               (ap (Tot1 (RN.o Y)) (Tot0 Y) (prI Y) (s.pv (RN.o Y) kI i0) (E1.act (RN.o Y) W m R) c2))) ;
   c4 : Id (W0.Ix (B.tob Y p)) (TL0.coeT Y gR p (symH e') rv) kv = TL0.pr-eq Y gR p (symH e') rv kv c3 ;
   c5 : Id (W0.Ix (B.tob Y p)) (TL0.coeT Y gR p (symH e') rv) (R.2.1 Y m p e') =
    famPt W R.1 R.2.1 Y (G1.GB.BC.oC (RN.o Y) (RN.o Y) W m (G1.GB.BC.idC (RN.o Y))) m (G1.GB.BC.oC-idr (RN.o Y) W m) gR p (symH e') EE e' ;
   res : Id (W0.Ix (B.tob Y p)) kv (R.2.1 Y m p e') = transH (symH c4) c5 ;
  } ;
  kside (X : Ob1) (g : Pt X) (u : RT.T X g) (s : Px.Side[X, g]) (W : Ob1) (f : RN.Hom1 W X) (i : G1.GB.Lands W X s.pQ f)
   : Id (Tot1 W) (E1.act W X f (P1.pairE G RT.RB X g (kop X g u s))) (s.pv W f i) =
   totExt W (E1.act W X f (P1.pairE G RT.RB X g (kop X g u s))) (s.pv W f i) (symH (s.ppt W f i))
    (\ Y m p e e' -> KS[X, g, u, s, W, f, i, Y, m, p, e, e'].res) ;

  -- R B has a seeded extension operation
  opR : G1.FT.GCTruncSeededBack[l].Seeded[G, RT.RB].Op =
   new G1.FT.GCTruncSeededBack[l].Seeded[G, RT.RB].Op[kop, kside, kunif] ;
 } ;
} ;
