-- CCmpY2.seg (canonicity-45; SIMPLIFIED.md step 6): the equivalence
-- structure of the comparison restricted to the copy of a presentation y,
-- moved from the internal Hom side (CHFibCart.moveEq).  The cartesian maps
-- are alpha (C's map codes to HomT's fibres) on each factor, the context
-- map sends every point to tt; naturality by alpha's (CHomT16) and the
-- restriction equations (CCmpY); injectivity by beta . alpha = id; the way
-- back beta with alpha . beta = id.  The Hom-side map al, its equivalence
-- structure and its agreement with C's comparison (commH) are module
-- parameters (c2's internal comparison discharges them).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module Sides (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module CY = CCmpY[a].CmpY[R, encK, pe, y] ;
 module FR = CY.FR ;
 module HP = CHomT3[a].HomP[R, encK, pe] ;
 HS : C.Ty C.nil = HP.Hom[FR.F2, y].HomT ;
 HT : C.Ty C.nil = HP.Hom[FR.F1, y].HomT ;
 HTT : C.Ty C.nil = SS.Sig C.nil HT (OV.wkT C.nil HT HT) ;
 module FM2 = CHomT11[a].FromM[R, encK, pe, FR.F2, y] ;
 module FM1 = CHomT11[a].FromM[R, encK, pe, FR.F1, y] ;
 module TB' = PB.GPre[a+].TyL[CY.D, CY.B'] ;
 module TA' = PB.GPre[a+].TyL[CY.D, CY.A'] ;
 module TB = PB.GPre[a+].TyL[C.nil, HS.1] ;
 module TA = PB.GPre[a+].TyL[C.nil, HTT.1] ;
 tB (W : Ob) (v : TB'.EI W) : TB.EI W = (tt, FM2.alpha W v.2) ;
 tA (W : Ob) (v : TA'.EI W) : TA.EI W = (tt, (FM1.alpha W v.2.1, FM1.alpha W v.2.2)) ;
 module N2 = CHomT16[a].Nat[R, encK, pe, FR.F2, y] ;
 module N1 = CHomT16[a].Nat[R, encK, pe, FR.F1, y] ;
 module TM2 = CHomT8[a].ToM[R, encK, pe, FR.F2, y] ;
 module TM1 = CHomT8[a].ToM[R, encK, pe, FR.F1, y] ;
 Z2 (W : Ob) : U a+ = V1.Ix (HS.1.tob W tt) ;
 Z1 (W : Ob) : U a+ = V1.Ix (HT.1.tob W tt) ;
 tBnat (V W : Ob) (g : Hom V W) (v : TB'.EI W) : Id (TB.EI V) (TB.E.act V W g (tB W v)) (tB V (TB'.E.act V W g v)) =
  apH {Z2 V} {TB.EI V} (\ z -> (tt, z))
   (transH (symH (N2.aNat W V g v.2))
     (apH {CY.P.F.M V} {Z2 V} (FM2.alpha V) (symH (CY.resEq V W g v.1 (CY.D.act V W g v.1) (refl (CY.D.act V W g v.1)) v.2)))) ;
 tAnat (V W : Ob) (g : Hom V W) (v : TA'.EI W) : Id (TA.EI V) (TA.E.act V W g (tA W v)) (tA V (TA'.E.act V W g v)) =
  apH {Z1 V * Z1 V} {TA.EI V} (\ zz -> (tt, zz))
   (transH (CY.CM.PD.pairE2 (Z1 V) (Z1 V) (N1.BN0.tactZ W V g (FM1.alpha W v.2.1)) (FM1.alpha V (CY.P1F.F.res W V g v.2.1))
              (N1.BN0.tactZ W V g (FM1.alpha W v.2.2)) (FM1.alpha V (CY.P1F.F.res W V g v.2.2))
              (symH (N1.aNat W V g v.2.1)) (symH (N1.aNat W V g v.2.2)))
     (apH {CY.P1F.F.M V * CY.P1F.F.M V} {Z1 V * Z1 V} (\ mm -> (FM1.alpha V mm.1, FM1.alpha V mm.2))
        (symH (CY.resEqA V W g v.1 (CY.D.act V W g v.1) (refl (CY.D.act V W g v.1)) v.2)))) ;
 -- the second component of an Id of totals over the terminal context
 snd2 (W : Ob) (z z' : Z2 W) (Q : Id (TB.EI W) (tt, z) (tt, z')) : Id (Z2 W) z z' =
  apH {TB.EI W} {Z2 W} (\ pp -> subst Top (\ o -> V1.Ix (HS.1.tob W o)) pp.1 tt (isTop pp.1 tt) pp.2) Q ;
 snd1 (W : Ob) (z z' : Z1 W * Z1 W) (Q : Id (TA.EI W) (tt, z) (tt, z')) : Id (Z1 W * Z1 W) z z' =
  apH {TA.EI W} {Z1 W * Z1 W} (\ pp -> subst Top (\ o -> V1.Ix (HTT.1.tob W o)) pp.1 tt (isTop pp.1 tt) pp.2) Q ;
 tBinj (W : Ob) (v v' : TB'.EI W) (Pe : Id (V1.Ix (CY.D.ob W)) v.1 v'.1) (Q : Id (TB.EI W) (tB W v) (tB W v')) : Id (TB'.EI W) v v' =
  transH (apH {V1.Ix (CY.D.ob W)} {TB'.EI W} (\ o2 -> (o2, v.2)) Pe)
   (apH {CY.P.F.M W} {TB'.EI W} (\ m2 -> (v'.1, m2))
     (transH (symH (CHomT12[a].RT1[R, encK, pe, FR.F2, y].At[W, v.2].rt))
       (transH (apH {Z2 W} {CY.P.F.M W} (TM2.beta W) (snd2 W (FM2.alpha W v.2) (FM2.alpha W v'.2) Q))
         (CHomT12[a].RT1[R, encK, pe, FR.F2, y].At[W, v'.2].rt)))) ;
 inj1 (W : Ob) (m m' : CY.P1F.F.M W) (q : Id (Z1 W) (FM1.alpha W m) (FM1.alpha W m')) : Id (CY.P1F.F.M W) m m' =
  transH (symH (CHomT12[a].RT1[R, encK, pe, FR.F1, y].At[W, m].rt))
   (transH (apH {Z1 W} {CY.P1F.F.M W} (TM1.beta W) q) (CHomT12[a].RT1[R, encK, pe, FR.F1, y].At[W, m'].rt)) ;
 tAinj (W : Ob) (v v' : TA'.EI W) (Pe : Id (V1.Ix (CY.D.ob W)) v.1 v'.1) (Q : Id (TA.EI W) (tA W v) (tA W v')) : Id (TA'.EI W) v v' =
  transH (apH {V1.Ix (CY.D.ob W)} {TA'.EI W} (\ o2 -> (o2, v.2)) Pe)
   (apH {CY.P1F.F.M W * CY.P1F.F.M W} {TA'.EI W} (\ mm -> (v'.1, mm))
     (CY.CM.PD.pairE2 (CY.P1F.F.M W) (CY.P1F.F.M W) v.2.1 v'.2.1 v.2.2 v'.2.2
        (inj1 W v.2.1 v'.2.1 (apH {Z1 W * Z1 W} {Z1 W} (\ zz -> zz.1) (snd1 W (tA W v).2 (tA W v').2 Q)))
        (inj1 W v.2.2 v'.2.2 (apH {Z1 W * Z1 W} {Z1 W} (\ zz -> zz.2) (snd1 W (tA W v).2 (tA W v').2 Q))))) ;
 bkB (X : Ob) (x : V1.Ix (CY.D.ob X)) (u : Z2 X) : V1.Ix (CY.B'.tob X x) = TM2.beta X u ;
 bkBta (X : Ob) (x : V1.Ix (CY.D.ob X)) (u : Z2 X) : Id (TB.EI X) (tB X (TB'.pr X x (bkB X x u))) (TB.pr X tt u) =
  apH {Z2 X} {TB.EI X} (\ z -> (tt, z)) (CHomT13[a].RT2[R, encK, pe, FR.F2, y].At[X, u].rt) ;
 bkA (X : Ob) (x : V1.Ix (CY.D.ob X)) (u : Z1 X * Z1 X) : V1.Ix (CY.A'.tob X x) = (TM1.beta X u.1, TM1.beta X u.2) ;
 bkAta (X : Ob) (x : V1.Ix (CY.D.ob X)) (u : Z1 X * Z1 X) : Id (TA.EI X) (tA X (TA'.pr X x (bkA X x u))) (TA.pr X tt u) =
  apH {Z1 X * Z1 X} {TA.EI X} (\ zz -> (tt, zz))
   (CY.CM.PD.pairE2 (Z1 X) (Z1 X) (FM1.alpha X (TM1.beta X u.1)) u.1 (FM1.alpha X (TM1.beta X u.2)) u.2
      (CHomT13[a].RT2[R, encK, pe, FR.F1, y].At[X, u.1].rt) (CHomT13[a].RT2[R, encK, pe, FR.F1, y].At[X, u.2].rt)) ;
 module Move (al : PB.CPartial[a+].PMap[C.nil, HS.1, HTT.1]) (eqal : PB.CEquiv[a+].EquivOp C.nil HS.1 HTT.1 al)
   (commH : (W : Ob) (v : TB'.EI W) -> Id (TA.EI W) (tA W (CY.al'.mE W v)) (al.mE W (tB W v))) {
  module H = PB.CHFibCart[a+, a+].HCart[CY.D, CY.B', CY.A', CY.al', C.nil, HS.1, HTT.1, al, \ W x -> tt, \ V W g d -> refl tt,
    tA, \ W v -> refl tt, tAnat, tAinj, bkA, bkAta, tB, \ W v -> refl tt, tBnat, tBinj, bkB, bkBta, commH] ;
  eqy : PB.CEquiv[a+].EquivOp CY.D CY.B' CY.A' CY.al' = H.moveEq eqal ;
 } ;
} ;
