-- CwFQuotElim5.seg (canonicity-c2; SIMPLIFIED.md item 3): QE1 part 5,
-- elimination into a family of propositions in three variables
-- (G3Of[Qt].ElimP3Ty), by currying: P1 = Pi Pi P over nil.Qt, elimP1 at
-- the classes, three times.  The lifted section of a class is the
-- semantic insertion of it (i1, i2), pointwise: upT's points are lift's
-- up to the transport in the fibre (ntU, by J), which is trivial since
-- the fibres coincide (CConstLam.same-fib).
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

-- the points of upT: those of lift, up to the transport in the fibre
ntU (D G : C.Ctx) (A : C.Ty G) (s : C.Sub D G) (A' : C.Ty D) (PA : Id (C.Ty D) (C.subT D G A s) A') (K : Ob) (x : V1.Ix (D.ob K))
  (a' : V1.Ix (A'.1.tob K x))
  : Id (V1.Ix ((C.ext G A).ob K)) ((OV.upT D G A s A' PA).nt K (x, a'))
       (s.nt K x, subst (C.Ty D) (\ T -> V1.Ix (T.1.tob K x)) A' (C.subT D G A s) (symH PA) a') =
  idJ (C.Ty D) (C.subT D G A s)
    (\ A2 P2 -> (a2 : V1.Ix (A2.1.tob K x)) -> Id (V1.Ix ((C.ext G A).ob K)) ((OV.upT D G A s A2 P2).nt K (x, a2))
        (s.nt K x, subst (C.Ty D) (\ T -> V1.Ix (T.1.tob K x)) A2 (C.subT D G A s) (symH P2) a2))
    (\ a2 -> refl ((C.lift D G A s).nt K (x, a2))) A' PA a' ;

module QE5 (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
 module AX = Q1.AX ;
 module GQ = Q1.GQ ;
 module LM = AX.RP.LM ;
 Nl : C.Ctx = C.nil ;
 Qt : C.Ty Nl = AX.Qt ;
 -- the insertions of c (and c1 , c2) as first variables
 module I1 (c : C.El Nl Qt) {
  nt (K : Ob) (w : V1.Ix (GQ.G1.ob K)) : V1.Ix (GQ.G2.ob K) = ((w.1, c.eob K w.1), w.2) ;
  nat (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (GQ.G1.ob K)) : Id (V1.Ix (GQ.G2.ob L0)) (nt L0 (GQ.G1.act L0 K g w)) (GQ.G2.act L0 K g (nt K w)) =
   apH {V1.Ix (Qt.1.tob L0 (Nl.act L0 K g w.1))} {V1.Ix (GQ.G2.ob L0)} (\ z -> ((Nl.act L0 K g w.1, z), (GQ.G1.act L0 K g w).2))
     (symH (c.enat L0 K g w.1 (Nl.act L0 K g w.1) (refl (Nl.act L0 K g w.1)))) ;
  i : C.Sub GQ.G1 GQ.G2 = new L.PSub[GQ.G1, GQ.G2, nt, nat] ;
  -- the lifted Sec1 of c is i
  s1 : C.Sub Nl GQ.G1 = GQ.Sec1[c].sec1 ;
  e1 : Id (C.Sub Nl Nl) (C.o Nl GQ.G1 Nl (C.p Nl Qt) s1) (C.id Nl) = L.sub-ext Nl Nl (C.o Nl GQ.G1 Nl (C.p Nl Qt) s1) (C.id Nl) (\ K o -> refl o) ;
  PA : Id (C.Ty Nl) (C.subT Nl GQ.G1 GQ.Qw s1) Qt =
   transH (symH (C.subT-o Nl GQ.G1 Nl Qt (C.p Nl Qt) s1))
     (transH (apH {C.Sub Nl Nl} {C.Ty Nl} (\ s -> C.subT Nl Nl Qt s) e1) (C.subT-id Nl Qt)) ;
  E : Id (C.Sub GQ.G1 GQ.G2) (OV.upT Nl GQ.G1 GQ.Qw s1 Qt PA) i =
   L.sub-ext GQ.G1 GQ.G2 (OV.upT Nl GQ.G1 GQ.Qw s1 Qt PA) i
     (\ K w -> transH (ntU Nl GQ.G1 GQ.Qw s1 Qt PA K w.1 w.2)
        (apH {V1.Ix (Qt.1.tob K w.1)} {V1.Ix (GQ.G2.ob K)} (\ z -> ((w.1, c.eob K w.1), z))
           (LM.same-fib Nl K w.1 Qt (C.subT Nl GQ.G1 GQ.Qw s1) (symH PA) w.2 (refl (Qt.1.tob K w.1))))) ;
 } ;
 module I2 (c1 c2 : C.El Nl Qt) {
  nt (K : Ob) (w : V1.Ix (GQ.G1.ob K)) : V1.Ix (GQ.G3.ob K) = (((w.1, c1.eob K w.1), c2.eob K w.1), w.2) ;
  nat (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (GQ.G1.ob K)) : Id (V1.Ix (GQ.G3.ob L0)) (nt L0 (GQ.G1.act L0 K g w)) (GQ.G3.act L0 K g (nt K w)) =
   transH (apH {V1.Ix (Qt.1.tob L0 (Nl.act L0 K g w.1))} {V1.Ix (GQ.G3.ob L0)} (\ z -> (((Nl.act L0 K g w.1, z), c2.eob L0 (Nl.act L0 K g w.1)), (GQ.G1.act L0 K g w).2))
             (symH (c1.enat L0 K g w.1 (Nl.act L0 K g w.1) (refl (Nl.act L0 K g w.1)))))
     (apH {V1.Ix (Qt.1.tob L0 (Nl.act L0 K g w.1))} {V1.Ix (GQ.G3.ob L0)}
        (\ z -> (((Nl.act L0 K g w.1, Qt.1.tact L0 K g w.1 (Nl.act L0 K g w.1) (refl (Nl.act L0 K g w.1)) (c1.eob K w.1)), z), (GQ.G1.act L0 K g w).2))
        (symH (c2.enat L0 K g w.1 (Nl.act L0 K g w.1) (refl (Nl.act L0 K g w.1))))) ;
  i : C.Sub GQ.G1 GQ.G3 = new L.PSub[GQ.G1, GQ.G3, nt, nat] ;
  sg : C.Sub Nl GQ.G2 = C.o Nl GQ.G1 GQ.G2 I1[c1].i (GQ.Sec1[c2].sec1) ;
  pp : C.Sub GQ.G2 Nl = C.o GQ.G2 GQ.G1 Nl (C.p Nl Qt) (C.p GQ.G1 GQ.Qw) ;
  e1 : Id (C.Sub Nl Nl) (C.o Nl GQ.G2 Nl pp sg) (C.id Nl) = L.sub-ext Nl Nl (C.o Nl GQ.G2 Nl pp sg) (C.id Nl) (\ K o -> refl o) ;
  PA : Id (C.Ty Nl) (C.subT Nl GQ.G2 GQ.Qw2 sg) Qt =
   transH (apH {C.Ty GQ.G2} {C.Ty Nl} (\ X -> C.subT Nl GQ.G2 X sg) (symH (C.subT-o GQ.G2 GQ.G1 Nl Qt (C.p Nl Qt) (C.p GQ.G1 GQ.Qw))))
     (transH (symH (C.subT-o Nl GQ.G2 Nl Qt pp sg))
        (transH (apH {C.Sub Nl Nl} {C.Ty Nl} (\ s -> C.subT Nl Nl Qt s) e1) (C.subT-id Nl Qt))) ;
  E : Id (C.Sub GQ.G1 GQ.G3) (OV.upT Nl GQ.G2 GQ.Qw2 sg Qt PA) i =
   L.sub-ext GQ.G1 GQ.G3 (OV.upT Nl GQ.G2 GQ.Qw2 sg Qt PA) i
     (\ K w -> transH (ntU Nl GQ.G2 GQ.Qw2 sg Qt PA K w.1 w.2)
        (apH {V1.Ix (Qt.1.tob K w.1)} {V1.Ix (GQ.G3.ob K)} (\ z -> (((w.1, c1.eob K w.1), c2.eob K w.1), z))
           (LM.same-fib Nl K w.1 Qt (C.subT Nl GQ.G2 GQ.Qw2 sg) (symH PA) w.2 (refl (Qt.1.tob K w.1))))) ;
  e3 (c3 : C.El Nl Qt) : Id (C.Sub Nl GQ.G3) (C.o Nl GQ.G1 GQ.G3 i (GQ.Sec1[c3].sec1)) (GQ.Sec3[c1, c2, c3].sec3) =
   L.sub-ext Nl GQ.G3 (C.o Nl GQ.G1 GQ.G3 i (GQ.Sec1[c3].sec1)) (GQ.Sec3[c1, c2, c3].sec3) (\ K o -> refl (((o, c1.eob K o), c2.eob K o), c3.eob K o)) ;
 } ;
 -- propositions along substitutions
 pOv (D G : C.Ctx) (X : C.Ty G) (s : C.Sub D G) (pX : C.El G (PU.isProp G X)) : C.El D (PU.isProp D (C.subT D G X s)) =
  OV.trE D (C.subT D G (PU.isProp G X) s) (PU.isProp D (C.subT D G X s)) (PU.isProp-ov D G X s (C.subT D G X s) (refl (C.subT D G X s))) (C.subt D G (PU.isProp G X) pX s) ;
 module EP3 (P : C.Ty GQ.G3) (pPr : C.El GQ.G3 (PU.isProp GQ.G3 P))
   (h : (t1 t2 t3 : AX.Term) -> C.El Nl (C.subT Nl GQ.G3 P (GQ.Sec3[AX.cls t1, AX.cls t2, AX.cls t3].sec3))) {
  P2 : C.Ty GQ.G2 = FibCwF[a, a+].fibPi.Pi GQ.G2 GQ.Qw2 P ;
  P1 : C.Ty GQ.G1 = FibCwF[a, a+].fibPi.Pi GQ.G1 GQ.Qw P2 ;
  pP2 : C.El GQ.G2 (PU.isProp GQ.G2 P2) = PPp.piProp GQ.G2 GQ.Qw2 P pPr ;
  pP1 : C.El GQ.G1 (PU.isProp GQ.G1 P1) = PPp.piProp GQ.G1 GQ.Qw P2 pP2 ;
  module L2 (t1 t2 : AX.Term) {
   module J = I2[AX.cls t1, AX.cls t2] ;
   P3 : C.Ty GQ.G1 = C.subT GQ.G1 GQ.G3 P J.i ;
   h3 (t3 : AX.Term) : C.El Nl (C.subT Nl GQ.G1 P3 (GQ.Sec1[AX.cls t3].sec1)) =
    OV.trE Nl (C.subT Nl GQ.G3 P (GQ.Sec3[AX.cls t1, AX.cls t2, AX.cls t3].sec3)) (C.subT Nl GQ.G1 P3 (GQ.Sec1[AX.cls t3].sec1))
      (transH (apH {C.Sub Nl GQ.G3} {C.Ty Nl} (\ s -> C.subT Nl GQ.G3 P s) (symH (J.e3 (AX.cls t3))))
         (C.subT-o Nl GQ.G1 GQ.G3 P J.i (GQ.Sec1[AX.cls t3].sec1)))
      (h t1 t2 t3) ;
   k3 : C.El GQ.G1 P3 = Q1.elimP1 P3 (pOv GQ.G1 GQ.G3 P J.i pPr) h3 ;
   PP : Id (C.Ty Nl) (C.subT Nl GQ.G2 P2 J.sg) (FibCwF[a, a+].fibPi.Pi Nl Qt P3) =
    OV.Pi-ov Nl GQ.G2 GQ.Qw2 P J.sg Qt J.PA P3 (apH {C.Sub GQ.G1 GQ.G3} {C.Ty GQ.G1} (\ u -> C.subT GQ.G1 GQ.G3 P u) J.E) ;
   el : C.El Nl (C.subT Nl GQ.G2 P2 J.sg) =
    OV.trE Nl (FibCwF[a, a+].fibPi.Pi Nl Qt P3) (C.subT Nl GQ.G2 P2 J.sg) (symH PP) (OV.lam Nl Qt P3 k3) ;
  } ;
  module L1 (t1 : AX.Term) {
   module J = I1[AX.cls t1] ;
   P2' : C.Ty GQ.G1 = C.subT GQ.G1 GQ.G2 P2 J.i ;
   h2 (t2 : AX.Term) : C.El Nl (C.subT Nl GQ.G1 P2' (GQ.Sec1[AX.cls t2].sec1)) =
    OV.trE Nl (C.subT Nl GQ.G2 P2 L2[t1, t2].J.sg) (C.subT Nl GQ.G1 P2' (GQ.Sec1[AX.cls t2].sec1))
      (C.subT-o Nl GQ.G1 GQ.G2 P2 J.i (GQ.Sec1[AX.cls t2].sec1)) L2[t1, t2].el ;
   k2 : C.El GQ.G1 P2' = Q1.elimP1 P2' (pOv GQ.G1 GQ.G2 P2 J.i pP2) h2 ;
   PP : Id (C.Ty Nl) (C.subT Nl GQ.G1 P1 J.s1) (FibCwF[a, a+].fibPi.Pi Nl Qt P2') =
    OV.Pi-ov Nl GQ.G1 GQ.Qw P2 J.s1 Qt J.PA P2' (apH {C.Sub GQ.G1 GQ.G2} {C.Ty GQ.G1} (\ u -> C.subT GQ.G1 GQ.G2 P2 u) J.E) ;
   h1 : C.El Nl (C.subT Nl GQ.G1 P1 J.s1) =
    OV.trE Nl (FibCwF[a, a+].fibPi.Pi Nl Qt P2') (C.subT Nl GQ.G1 P1 J.s1) (symH PP) (OV.lam Nl Qt P2' k2) ;
  } ;
  k1 : C.El GQ.G1 P1 = Q1.elimP1 P1 pP1 (\ t1 -> L1[t1].h1) ;
  res : C.El GQ.G3 P = OV.bod GQ.G2 GQ.Qw2 P (OV.bod GQ.G1 GQ.Qw P2 k1) ;
 } ;
 elimP3 : GQ.ElimP3Ty AX.Term AX.cls = \ P pPr h -> EP3[P, pPr, h].res ;
} ;
