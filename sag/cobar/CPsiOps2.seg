-- CPsiOps2.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', psi : G -> Q
-- (CPsiQ) and the constants (from tau''s, CE1Fin, and psi tau' ~ id), and E1
-- for psi: for every term t in k variables, Q's evaluation of t at psi of the
-- variables is homotopic to psi of G's evaluation (CHtpyAlg at A = G, T = Q,
-- tau = psi, with CPsiOps's + and x).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module PO2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module PO = CPsiOps[a].PO[R, encK, pe, y'] ;
 module PQ = PO.PQ ;
 module E = PO.E ;
 module H = PO.H ;
 module HO = PO.HO ;
 Nl : L.PCtx = PO.Nl ;
 Qc : L.PTy[Nl] = PO.Qc ;
 Tc : L.PTy[Nl] = PO.Tc ;
 psi : HO.NMap[Nl, Tc, Qc] = PO.psi ;
 tau' : HO.NMap[Nl, Qc, Tc] = PO.tau' ;
 module AP = CHtpyAlg[a].Alg[R, Nl, Tc, Qc, E.AddO.opT, E.AddO.opTN, E.MulO.opT, E.MulO.opTN, H.cT, H.cTN, E.addA, E.addAN, E.mulA, E.mulAN, H.cA, H.cAN, psi] ;
 -- the constants
 module CC (r : R.R) (X : L.PTy[Nl]) {
  cAX : HO.NMap[Nl, X, Qc] = AP.constN X Qc (H.cA r) (H.cAN r) ;
  cTX : HO.NMap[Nl, X, Tc] = AP.constN X Tc (H.cT r) (H.cTN r) ;
  module We = HO.WL[Nl, X, Tc, Qc, cTX, HO.compN Nl X Qc Tc cAX tau', psi, PO.D.PR.FN.CC[r, X].res] ;
  module Wq = HO.WR[Nl, Qc, Qc, X, HO.compN Nl Qc Tc Qc tau' psi, HO.idN Nl Qc, cAX, PQ.epsQ] ;
  module Rq = HO.Ret[Nl, X, Qc, HO.compN Nl X Qc Qc cAX (HO.compN Nl Qc Tc Qc tau' psi), HO.compN Nl X Qc Qc cAX (HO.idN Nl Qc),
    HO.compN Nl X Tc Qc (HO.compN Nl X Qc Tc cAX tau') psi, cAX,
    \ I x a0 -> refl ((HO.compN Nl X Tc Qc (HO.compN Nl X Qc Tc cAX tau') psi).nfun I x a0), \ I x a0 -> refl (cAX.nfun I x a0), Wq.res] ;
  module Cr = HO.Cat[Nl, X, Qc, HO.compN Nl X Tc Qc cTX psi, HO.compN Nl X Tc Qc (HO.compN Nl X Qc Tc cAX tau') psi, cAX, PQ.RD.cQ, We.res, Rq.res] ;
  module Ir = HO.Inv[Nl, X, Qc, HO.compN Nl X Tc Qc cTX psi, cAX, PQ.RD.cQ, Cr.res] ;
  res : L.PEl[L.extP Nl X, HO.HT[Nl, X, Qc, cAX, HO.compN Nl X Tc Qc cTX psi].PT.PathP] = Ir.res ;
 } ;
 module EM = AP.E1M[PQ.RD.cQ, \ X f g -> PO.AddP.At[X, f, g].res, \ X f g -> PO.MulP.At[X, f, g].res, \ r X -> CC[r, X].res] ;
 -- Q's evaluation at psi of the variables ~ psi of G's evaluation
 E1 (k : Nat) (t : SX.Over[R].Expr (SX.Fin k))
  : L.PEl[L.extP Nl (AP.Pm k), HO.HT[Nl, AP.Pm k, Qc, AP.evGt k t, HO.compN Nl (AP.Pm k) Tc Qc (AP.evA k t) psi].PT.PathP] = EM.E1 k t ;
} ;
