-- Split a substituted finite cofactor type in an arbitrary context.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Ring[a++] ;
module FT = CFinIntTy[a] ;
module IN = CwFInt.Int[a++, FT.C, FibCwF[a, a+].fibPi, FT.SS, FibId[a, a+].fibId] ;
module DF = CFinIntHead[a].Derived[FT.C] ;

module Split (G D : FT.C.Ctx) (Rg : FT.PR.HRing[G])
 (f : FT.C.El G Rg.R) (fs : List (FT.C.El G Rg.R))
 (s : FT.C.Sub D G)
 (c : FT.C.El D (FT.C.subT D G (FT.Cofactor[G, Rg].CofT (cons f fs)) s)) {
 module CO = FT.Cofactor[G, Rg] ;
 C : CwF.CwF[a++] = FT.C ;
 A : C.Ty D = C.subT D G Rg.R s ;
 B : C.Ty (C.ext D A) =
  C.subT (C.ext D A) (C.ext G Rg.R)
    (FT.OV.wkT G Rg.R (CO.CofT fs)) (C.lift D G Rg.R s) ;
 pair : C.El D (FT.SS.Sig D A B) =
  FT.OV.trE D (C.subT D G (CO.CofT (cons f fs)) s) (FT.SS.Sig D A B)
    (FT.SS.Sig-nat D G Rg.R (FT.OV.wkT G Rg.R (CO.CofT fs)) s) c ;
 head : C.El D A = IN.fst D A B pair ;
 tailT : C.Ty D = C.subT D G (CO.CofT fs) s ;
 tail0 : C.Ty D = C.subT D (C.ext D A) B (C.sec D A head) ;
 tailStep : Id (C.Ty (C.ext D A)) B (FT.OV.wkT D A tailT) =
  DF.pl D G Rg.R (CO.CofT fs) s ;
 tailPath : Id (C.Ty D) tail0 tailT =
  transH (apH {C.Ty (C.ext D A)} {C.Ty D}
      (\ T -> C.subT D (C.ext D A) T (C.sec D A head)) tailStep)
    (DF.ps D A tailT head) ;
 tail : C.El D tailT =
  FT.OV.trE D tail0 tailT tailPath (IN.snd D A B pair) ;
} ;
