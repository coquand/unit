-- CTotRFib7.seg (canonicity-c2; SIMPLIFIED.md item 5): the componentwise
-- composite of CTotRFib5 agrees with the other end of the lines of the
-- side.  At (Y0 , m) the component is c0 of the projected side; c0's own
-- side law at the identity says it is the other end of the component
-- line, which is the component of the other end (the values of the
-- component line are components of the values of the line).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RFib7 (C : CIntCat[a, vl].IC) {
 module R6 = CTotRFib6[a, vl, l].RFib6[C] ;
 module TR = R6.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;

 module Ks (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (e e' : G1.GB.IPt)
   (c0 : G0.GB.CLine[l].Lines[RS.rC G, B].CompK[e, e'].Comp) {
  module KU = R6.Ku[G, B, e, e', c0] ;
  module KO = KU.KO ;
  module CP = KU.CP ;
  module PR = KU.PR ;
  module TO = PR.TO ;
  module CT = KU.CT ;
  module L9 = KU.L9 ;
  module RT = KU.RT ;
  module EK1 = KU.EK1 ;
  module EK0 = KU.EK0 ;
  module TL0 = KU.TL0 ;
  module CK1 = KU.CK1 ;
  module TT1 = KU.TT1 ;
  module CK0 = CP.CK0 ;
  module TT0 = CP.TT0 ;
  UG : P0.PCtx = KU.UG ;
  K1 : P1.PCtx = KU.K1 ;
  Tot0 (Y : Ob0) : U l = KU.Tot0 Y ;
  Tot1 (X : Ob1) : U l = L9.Tot1 X ;
  Pt0 (Y : Ob0) : U l = KU.Pt0 Y ;

  module KC (X : Ob1) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) (W : Ob1) (f : RN.Hom1 W X) (i : G1.GB.Lands W X s.pQ f)
    (Y0 : Ob0) (m : RN.Hom1 (RN.o Y0) W) {
   u : EK1.TS.EI W = s.pv W f i ;
   fm : RN.Hom1 (RN.o Y0) X = G1.GB.BC.oC (RN.o Y0) W X f m ;
   zA : EK0.TV.EI Y0 = PR.zc X z Y0 fm ;
   module SA = PR.PS[X, z, s, Y0, fm] ;
   kv : W0.Ix (B.tob Y0 (CP.p0 Y0 zA)) = CP.kv X z s Y0 fm ;
   id0 : RN.Hom0 Y0 Y0 = G0.GB.BC.idC Y0 ;
   id1 : RN.Hom1 (RN.o Y0) (RN.o Y0) = G1.GB.BC.idC (RN.o Y0) ;
   i1 : G1.GB.Lands (RN.o Y0) X s.pQ fm = G1.GB.lands-comp (RN.o Y0) W X s.pQ f m i ;
   kI : RN.Hom1 (RN.o Y0) X = L9.mh X Y0 fm Y0 id0 ;
   eqI : Id (RN.Hom1 (RN.o Y0) X) kI fm =
    transH (apH {RN.Hom1 (RN.o Y0) (RN.o Y0)} {RN.Hom1 (RN.o Y0) X} (\ k -> G1.GB.BC.oC (RN.o Y0) (RN.o Y0) X fm k) (TR.fn.onId Y0))
     (G1.GB.BC.oC-idr (RN.o Y0) X fm) ;
   i0 : G0.GB.Lands Y0 Y0 SA.Q id0 = G1.GB.lands-eq (RN.o Y0) X s.pQ fm kI (symH eqI) i1 ;
   uI : EK1.TS.EI (RN.o Y0) = s.pv (RN.o Y0) kI i0 ;
   v : EK0.TS.EI Y0 = TO.toTS Y0 uI ;
   -- c0's side law at the identity
   c1 : Id (TT0.EI Y0) (TT0.E.act Y0 Y0 id0 (TT0.pr Y0 zA kv)) (CK0.endM Y0 v) = c0.kside Y0 zA SA.side Y0 id0 i0 ;
   d1 : Id (TT0.EI Y0) (TT0.pr Y0 zA kv) (CK0.endM Y0 v) =
    trans (TT0.EI Y0) (TT0.pr Y0 zA kv) (TT0.E.act Y0 Y0 id0 (TT0.pr Y0 zA kv)) (CK0.endM Y0 v)
     (sym (TT0.EI Y0) (TT0.E.act Y0 Y0 id0 (TT0.pr Y0 zA kv)) (TT0.pr Y0 zA kv) (TT0.E.act-id Y0 (TT0.pr Y0 zA kv)))
     c1 ;
   pe0 : G0.GB.IvP Y0 = G0.GB.ptH Y0 e' ;
   -- the other end of the component line is a value of the component line
   d3 : Id (Tot0 Y0) (CP.eps Y0 (CK0.endM Y0 v)) (TO.FT0.lval Y0 (EK0.lineL Y0 v) Y0 id0 pe0) =
    TO.FT0.Ev[e'].endB-E Y0 (EK0.lineL Y0 v) ;
   module SI = TO.TS[Y0, uI] ;
   d4 : Id (Tot0 Y0) (TO.FT0.lval Y0 (EK0.lineL Y0 v) Y0 id0 pe0) (L9.prI Y0 (EK1.lv (RN.o Y0) uI (RN.o Y0) (TR.fn.onH Y0 Y0 id0) pe0)) =
    ap (EK0.TL.EI Y0) (Tot0 Y0) (\ M -> TO.FT0.lval Y0 M Y0 id0 pe0) (EK0.lineL Y0 v) SI.L0
     (EK0.mkTS-line Y0 (CT.kap Y0 SI.z) SI.L0 (refl (CT.RH.rhoV Y0 SI.x)) SI.q) ;
   star : Id (Tot0 Y0) (P0.pairE UG B Y0 (CP.p0 Y0 zA) kv) (L9.prI Y0 (EK1.lv (RN.o Y0) uI (RN.o Y0) (TR.fn.onH Y0 Y0 id0) pe0)) =
    trans (Tot0 Y0) (P0.pairE UG B Y0 (CP.p0 Y0 zA) kv) (CP.eps Y0 (CK0.endM Y0 v)) (L9.prI Y0 (EK1.lv (RN.o Y0) uI (RN.o Y0) (TR.fn.onH Y0 Y0 id0) pe0))
     (ap (TT0.EI Y0) (Tot0 Y0) (CP.eps Y0) (TT0.pr Y0 zA kv) (CK0.endM Y0 v) d1)
     (trans (Tot0 Y0) (CP.eps Y0 (CK0.endM Y0 v)) (TO.FT0.lval Y0 (EK0.lineL Y0 v) Y0 id0 pe0)
        (L9.prI Y0 (EK1.lv (RN.o Y0) uI (RN.o Y0) (TR.fn.onH Y0 Y0 id0) pe0)) d3 d4) ;
   -- the same value, read from the line of u
   Fid : RN.Hom1 (RN.o Y0) (RN.o Y0) = TR.fn.onH Y0 Y0 id0 ;
   uM : EK1.TS.EI (RN.o Y0) = EK1.TS.E.act (RN.o Y0) W m u ;
   r1 : Id (EK1.TS.EI (RN.o Y0)) uI uM =
    trans (EK1.TS.EI (RN.o Y0)) uI (s.pv (RN.o Y0) fm i1) uM
     (EK1.PT.pv-hom X z s (RN.o Y0) kI fm eqI i0 i1)
     (sym (EK1.TS.EI (RN.o Y0)) uM (s.pv (RN.o Y0) fm i1) (s.pnat (RN.o Y0) W m f i i1)) ;
   a1 : Id (Tot1 (RN.o Y0)) (EK1.lv (RN.o Y0) uI (RN.o Y0) Fid pe0) (EK1.lv (RN.o Y0) uM (RN.o Y0) Fid pe0) =
    ap (EK1.TS.EI (RN.o Y0)) (Tot1 (RN.o Y0)) (\ w -> EK1.lv (RN.o Y0) w (RN.o Y0) Fid pe0) uI uM r1 ;
   k2 : RN.Hom1 (RN.o Y0) W = G1.GB.BC.oC (RN.o Y0) (RN.o Y0) W m Fid ;
   a2 : Id (Tot1 (RN.o Y0)) (EK1.lv (RN.o Y0) uM (RN.o Y0) Fid pe0) (EK1.lv W u (RN.o Y0) k2 pe0) =
    ap (EK1.TL.EI (RN.o Y0)) (Tot1 (RN.o Y0)) (\ M -> TO.FT1.lval (RN.o Y0) M (RN.o Y0) Fid pe0) (EK1.lineL (RN.o Y0) uM)
     (EK1.TL.E.act (RN.o Y0) W m (EK1.lineL W u)) (EK1.lineL-act (RN.o Y0) W m u) ;
   a3 : Id (Tot1 (RN.o Y0)) (EK1.lv W u (RN.o Y0) k2 pe0) (EK1.lv W u (RN.o Y0) m pe0) =
    ap (RN.Hom1 (RN.o Y0) W) (Tot1 (RN.o Y0)) (\ k -> EK1.lv W u (RN.o Y0) k pe0) k2 m
     (transH (apH {RN.Hom1 (RN.o Y0) (RN.o Y0)} {RN.Hom1 (RN.o Y0) W} (\ k -> G1.GB.BC.oC (RN.o Y0) (RN.o Y0) W m k) (TR.fn.onId Y0))
        (G1.GB.BC.oC-idr (RN.o Y0) W m)) ;
   id1W : RN.Hom1 W W = G1.GB.BC.idC W ;
   peW : G1.GB.IvP W = G1.GB.ptH W e' ;
   tE : Tot1 W = EK1.lv W u W id1W peW ;
   k4 : RN.Hom1 (RN.o Y0) W = G1.GB.BC.oC (RN.o Y0) W W id1W m ;
   b1 : Id (Tot1 (RN.o Y0)) (L9.E1.act (RN.o Y0) W m tE) (EK1.lv W u (RN.o Y0) k4 (G1.GB.ivA (RN.o Y0) W m peW)) =
    TO.FT1.lnat W (EK1.lineL W u) (RN.o Y0) W m id1W peW ;
   b2 : Id (Tot1 (RN.o Y0)) (EK1.lv W u (RN.o Y0) k4 (G1.GB.ivA (RN.o Y0) W m peW)) (EK1.lv W u (RN.o Y0) m pe0) =
    trans (Tot1 (RN.o Y0)) (EK1.lv W u (RN.o Y0) k4 (G1.GB.ivA (RN.o Y0) W m peW)) (EK1.lv W u (RN.o Y0) m (G1.GB.ivA (RN.o Y0) W m peW))
      (EK1.lv W u (RN.o Y0) m pe0)
     (ap (RN.Hom1 (RN.o Y0) W) (Tot1 (RN.o Y0)) (\ k -> EK1.lv W u (RN.o Y0) k (G1.GB.ivA (RN.o Y0) W m peW)) k4 m (G1.GB.BC.oC-idl (RN.o Y0) W m))
     (ap (G1.GB.IvP (RN.o Y0)) (Tot1 (RN.o Y0)) (\ j -> EK1.lv W u (RN.o Y0) m j) (G1.GB.ivA (RN.o Y0) W m peW) pe0 (G1.GB.ptH-nat (RN.o Y0) W m e')) ;
   gzu : W0.Ix (G.ob W) = KO.gE W (EK1.TS.pr1 W u) ;
   eb : RT.T W gzu = TO.FT1.Ev[e'].endB W (EK1.lineL W u) ;
   b0 : Id (Tot1 W) (P1.pairE G RT.RB W gzu eb) tE = TO.FT1.Ev[e'].endB-E W (EK1.lineL W u) ;
   c2 : Id (Tot1 (RN.o Y0)) (EK1.lv (RN.o Y0) uI (RN.o Y0) Fid pe0) (L9.E1.act (RN.o Y0) W m (P1.pairE G RT.RB W gzu eb)) =
    trans (Tot1 (RN.o Y0)) (EK1.lv (RN.o Y0) uI (RN.o Y0) Fid pe0) (EK1.lv W u (RN.o Y0) m pe0) (L9.E1.act (RN.o Y0) W m (P1.pairE G RT.RB W gzu eb))
     (trans (Tot1 (RN.o Y0)) (EK1.lv (RN.o Y0) uI (RN.o Y0) Fid pe0) (EK1.lv (RN.o Y0) uM (RN.o Y0) Fid pe0) (EK1.lv W u (RN.o Y0) m pe0)
        a1 (trans (Tot1 (RN.o Y0)) (EK1.lv (RN.o Y0) uM (RN.o Y0) Fid pe0) (EK1.lv W u (RN.o Y0) k2 pe0) (EK1.lv W u (RN.o Y0) m pe0) a2 a3))
     (sym (Tot1 (RN.o Y0)) (L9.E1.act (RN.o Y0) W m (P1.pairE G RT.RB W gzu eb)) (EK1.lv W u (RN.o Y0) m pe0)
        (trans (Tot1 (RN.o Y0)) (L9.E1.act (RN.o Y0) W m (P1.pairE G RT.RB W gzu eb)) (L9.E1.act (RN.o Y0) W m tE) (EK1.lv W u (RN.o Y0) m pe0)
           (ap (Tot1 W) (Tot1 (RN.o Y0)) (\ w -> L9.E1.act (RN.o Y0) W m w) (P1.pairE G RT.RB W gzu eb) tE b0)
           (trans (Tot1 (RN.o Y0)) (L9.E1.act (RN.o Y0) W m tE) (EK1.lv W u (RN.o Y0) k4 (G1.GB.ivA (RN.o Y0) W m peW)) (EK1.lv W u (RN.o Y0) m pe0) b1 b2))) ;
   -- so the component, as a total of B, is the component of the other end
   gR : Pt0 Y0 = G.act (RN.o Y0) W m gzu ;
   module AR = RT.Act[RN.o Y0, W, m, gzu, gR, refl gR, eb] ;
   EE : Id (Pt0 Y0) gR (RT.at W gzu Y0 (G1.GB.BC.oC (RN.o Y0) (RN.o Y0) W m id1)) =
    transH (symH (G.act-id (RN.o Y0) gR)) (AR.ek Y0 id1) ;
   rv : W0.Ix (B.tob Y0 gR) = eb.1 Y0 (G1.GB.BC.oC (RN.o Y0) (RN.o Y0) W m id1) gR EE ;
   c3 : Id (Tot0 Y0) (P0.pairE UG B Y0 (CP.p0 Y0 zA) kv) (P0.pairE UG B Y0 gR rv) =
    trans (Tot0 Y0) (P0.pairE UG B Y0 (CP.p0 Y0 zA) kv) (L9.prI Y0 (EK1.lv (RN.o Y0) uI (RN.o Y0) Fid pe0)) (P0.pairE UG B Y0 gR rv)
     star
     (ap (Tot1 (RN.o Y0)) (Tot0 Y0) (L9.prI Y0) (EK1.lv (RN.o Y0) uI (RN.o Y0) Fid pe0) (L9.E1.act (RN.o Y0) W m (P1.pairE G RT.RB W gzu eb)) c2) ;
  } ;
 } ;
} ;
