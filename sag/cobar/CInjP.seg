-- CInjP.seg (canonicity-c2): for a natural map n : A -> B of closed types
-- (B a set), the type H of pairs with equal image, and: injectivity over
-- nil.H gives propositional fibres of FunOf n (as CInjSurj.ContrFib needs).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module EQm = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
idFwdL (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (u : C.El G (IJ.IdT G X x y))
  : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)) =
 idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y))) u X' P ;
trInv (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x : C.El G X) : Id (C.El G X) (OV.trE G X' X (symH P) (OV.trE G X X' P x)) x =
 idJ (C.Ty G) X (\ Z PZ -> Id (C.El G X) (OV.trE G Z X (symH PZ) (OV.trE G X Z PZ x)) x) (refl x) X' P ;
-- the body of a weakened function reads as the body of the function
module RdWk (G : C.Ctx) (Y P Q : C.Ty G) (w : C.El G (OV.Fun G P Q)) {
 D : C.Ctx = C.ext G Y ;
 P' : C.Ty D = OV.wkT G Y P ;
 B' : C.Ty (C.ext D P') = OV.wkT D P' (OV.wkT G Y Q) ;
 lf : C.Sub (C.ext D P') (C.ext G P) = C.lift D G P (C.p G Y) ;
 Bl : C.Ty (C.ext D P') = C.subT (C.ext D P') (C.ext G P) (OV.wkT G P Q) lf ;
 bl : C.El (C.ext D P') Bl = C.subt (C.ext D P') (C.ext G P) (OV.wkT G P Q) (OV.bod G P (OV.wkT G P Q) w) lf ;
 PB : Id (C.Ty (C.ext D P')) Bl B' = CAppRd[a].W.plT D G P Q (C.p G Y) ;
 rd (W : Ob) (z : V1.Ix ((C.ext D P').ob W)) : Id (V1.Ix (B'.1.tob W z))
   ((OV.bod D P' B' (EQm.wkF G Y P Q w)).eob W z) ((OV.bod G P (OV.wkT G P Q) w).eob W (z.1.1, z.2)) =
  transH (apH {C.El (C.ext D P') B'} {V1.Ix (B'.1.tob W z)} (\ X -> X.eob W z)
           (OV.bodNat D G P (OV.wkT G P Q) (C.p G Y) B' PB (EQm.wkFP G Y P Q) w))
   (transH (CAppRd[a].trE-rd (C.ext D P') Bl B' PB bl W z)
     (CAppRd[a].same-rd (C.ext D P') Bl B' PB W z (refl (B'.1.tob W z)) (bl.eob W z))) ;
} ;
module IP (A B : C.Ty C.nil) (n : HO.NMap[C.nil, A.1, B.1]) {
 Nl : C.Ctx = C.nil ;
 fC : C.El Nl (OV.Fun Nl A B) = QinvEq[a, a+].FunOf[Nl, A, B, n].fC ;
 -- n applied to an element over any context
 evS (D : C.Ctx) (s0 : C.Sub D Nl) (g : C.El D (C.subT D Nl A s0)) : C.El D (C.subT D Nl B s0) =
  L.mkPEl D (C.subT D Nl B s0).1 (\ K w -> n.nfun K (s0.nt K w) (g.eob K w)) (\ J I f w w' e ->
   transH (n.nnat J I f (s0.nt I w) (s0.nt J w') (L.ntEq D Nl s0 J I f w w' e) (g.eob I w))
    (apH {V1.Ix (A.1.tob J (s0.nt J w'))} {V1.Ix (B.1.tob J (s0.nt J w'))} (n.nfun J (s0.nt J w')) (g.enat J I f w w' e))) ;
 D1 : C.Ctx = C.ext Nl A ;
 Aw : C.Ty D1 = OV.wkT Nl A A ;
 D2 : C.Ctx = C.ext D1 Aw ;
 s2 : C.Sub D2 Nl = C.o D2 D1 Nl (C.p Nl A) (C.p D1 Aw) ;
 PH2 : Id (C.Ty D2) (OV.wkT D1 Aw Aw) (C.subT D2 Nl A s2) = symH (C.subT-o D2 D1 Nl A (C.p Nl A) (C.p D1 Aw)) ;
 u1 : C.El D2 (C.subT D2 Nl A s2) = OV.trE D2 (OV.wkT D1 Aw Aw) (C.subT D2 Nl A s2) PH2 (OV.wkE D1 Aw Aw (C.q Nl A)) ;
 u2 : C.El D2 (C.subT D2 Nl A s2) = OV.trE D2 (OV.wkT D1 Aw Aw) (C.subT D2 Nl A s2) PH2 (C.q D1 Aw) ;
 IdZ : C.Ty D2 = IJ.IdT D2 (C.subT D2 Nl B s2) (evS D2 s2 u1) (evS D2 s2 u2) ;
 H : C.Ty Nl = SS.Sig Nl A (SS.Sig D1 Aw IdZ) ;
 GH : C.Ctx = C.ext Nl H ;
 -- the fibre of fC over nil.B, and the reading of its application
 GB : C.Ctx = C.ext Nl B ;
 Xb : C.Ty GB = OV.wkT Nl B A ;
 Bb : C.Ty GB = OV.wkT Nl B B ;
 f1 : C.El GB (OV.Fun GB Xb Bb) = EQm.wkF Nl B A B fC ;
 GX : C.Ctx = C.ext GB Xb ;
 f2 : C.El GX (OV.Fun GX (OV.wkT GB Xb Xb) (OV.wkT GB Xb Bb)) = EQm.wkF GB Xb Xb Bb f1 ;
 apX : C.El GX (OV.wkT GB Xb Bb) = OV.app GX (OV.wkT GB Xb Xb) (OV.wkT GB Xb Bb) f2 (C.q GB Xb) ;
 appR (W : Ob) (z : V1.Ix (GX.ob W)) : Id (V1.Ix (B.1.tob W z.1.1)) (apX.eob W z) (n.nfun W z.1.1 z.2) =
  transH (CCmpU1[a].AppG[GX, OV.wkT GB Xb Xb, OV.wkT GB Xb Bb, f2, C.q GB Xb].rd W z)
   (transH (RdWk[GB, Xb, Xb, Bb, f1].rd W (z, z.2))
     (transH (RdWk[Nl, B, A, B, fC].rd W z)
       (QinvEq[a, a+].FunOf[Nl, A, B, n].bod-eq W (z.1.1, z.2)))) ;
 -- two points of the fibre, over E2 = GB.Fib.Fib
 Fm : C.Ty GX = IJ.IdT GX (OV.wkT GB Xb Bb) apX (OV.wkE GB Xb Bb (C.q Nl B)) ;
 Fib : C.Ty GB = SS.Sig GB Xb Fm ;
 E1 : C.Ctx = C.ext GB Fib ;
 Wf : C.Ty E1 = OV.wkT GB Fib Fib ;
 E2 : C.Ctx = C.ext E1 Wf ;
 pp : C.Sub E2 GB = C.o E2 E1 GB (C.p GB Fib) (C.p E1 Wf) ;
 X2 : C.Ty E2 = C.subT E2 GB Xb pp ;
 Y2 : C.Ty (C.ext E2 X2) = C.subT (C.ext E2 X2) GX Fm (C.lift E2 GB Xb pp) ;
 S2 : C.Ty E2 = SS.Sig E2 X2 Y2 ;
 PS2 : Id (C.Ty E2) (OV.wkT E1 Wf Wf) S2 =
  transH (symH (C.subT-o E2 E1 GB Fib (C.p GB Fib) (C.p E1 Wf))) (FibCwF[a, a+].fibSig.Sig-nat E2 GB Xb Fm pp) ;
 x1 : C.El E2 (OV.wkT E1 Wf Wf) = OV.wkE E1 Wf Wf (C.q GB Fib) ;
 x2 : C.El E2 (OV.wkT E1 Wf Wf) = C.q E1 Wf ;
 y1 : C.El E2 S2 = OV.trE E2 (OV.wkT E1 Wf Wf) S2 PS2 x1 ;
 y2 : C.El E2 S2 = OV.trE E2 (OV.wkT E1 Wf Wf) S2 PS2 x2 ;
 yr (x : C.El E2 (OV.wkT E1 Wf Wf)) (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (S2.1.tob K w)) ((OV.trE E2 (OV.wkT E1 Wf Wf) S2 PS2 x).eob K w) (x.eob K w) =
  transH (CAppRd[a].trE-rd E2 (OV.wkT E1 Wf Wf) S2 PS2 x K w) (CAppRd[a].same-rd E2 (OV.wkT E1 Wf Wf) S2 PS2 K w (refl (S2.1.tob K w)) (x.eob K w)) ;
 a1 : C.El E2 X2 = INm.fst E2 X2 Y2 y1 ;
 a2 : C.El E2 X2 = INm.fst E2 X2 Y2 y2 ;
 -- the substitution E2 -> D2, (a1, a2)
 s0 : C.Sub E2 Nl = C.o E2 GB Nl (C.p Nl B) pp ;
 PA2 : Id (C.Ty E2) X2 (C.subT E2 Nl A s0) = symH (C.subT-o E2 GB Nl A (C.p Nl B) pp) ;
 b1 : C.El E2 (C.subT E2 Nl A s0) = OV.trE E2 X2 (C.subT E2 Nl A s0) PA2 a1 ;
 b2 : C.El E2 (C.subT E2 Nl A s0) = OV.trE E2 X2 (C.subT E2 Nl A s0) PA2 a2 ;
 t1 : C.Sub E2 D1 = CQSurj[a].Ex[C].exS E2 Nl A s0 b1 ;
 PT1 : Id (C.Ty E2) (C.subT E2 Nl A s0) (C.subT E2 D1 Aw t1) =
  symH (transH (symH (C.subT-o E2 D1 Nl A (C.p Nl A) t1)) (apH {C.Sub E2 Nl} {C.Ty E2} (\ s -> C.subT E2 Nl A s) (INm.p-extS E2 Nl A s0 b1))) ;
 t0 : C.Sub E2 D2 = CQSurj[a].Ex[C].exS E2 D1 Aw t1 (OV.trE E2 (C.subT E2 Nl A s0) (C.subT E2 D1 Aw t1) PT1 b2) ;
 -- B over E2, and moving elements of B pulled back along any substitution to it
 BE : C.Ty E2 = C.subT E2 Nl B s0 ;
 HP (W : C.Ctx) (s1 : C.Sub W Nl) (s : C.Sub E2 W) : U a+ = (K : Ob) (w : V1.Ix (E2.ob K)) -> Id (V1.Ix (Nl.ob K)) ((C.o E2 W Nl s1 s).nt K w) (s0.nt K w) ;
 bS (W : C.Ctx) (s1 : C.Sub W Nl) (s : C.Sub E2 W) (hp : HP W s1 s) : Id (C.Ty E2) (C.subT E2 W (C.subT W Nl B s1) s) BE =
  transH (symH (C.subT-o E2 W Nl B s1 s)) (apH {C.Sub E2 Nl} {C.Ty E2} (\ r -> C.subT E2 Nl B r) (L.sub-ext E2 Nl (C.o E2 W Nl s1 s) s0 hp)) ;
 mvB (W : C.Ctx) (s1 : C.Sub W Nl) (s : C.Sub E2 W) (hp : HP W s1 s) (e : C.El W (C.subT W Nl B s1)) : C.El E2 BE =
  OV.trE E2 (C.subT E2 W (C.subT W Nl B s1) s) BE (bS W s1 s hp) (C.subt E2 W (C.subT W Nl B s1) e s) ;
 -- an Id over E2 along s, moved to BE
 mvId (W : C.Ctx) (s1 : C.Sub W Nl) (s : C.Sub E2 W) (hp : HP W s1 s) (u v : C.El W (C.subT W Nl B s1)) (h : C.El E2 (C.subT E2 W (IJ.IdT W (C.subT W Nl B s1) u v) s))
   : C.El E2 (IJ.IdT E2 BE (mvB W s1 s hp u) (mvB W s1 s hp v)) =
  idFwdL E2 (C.subT E2 W (C.subT W Nl B s1) s) BE (bS W s1 s hp) (C.subt E2 W (C.subT W Nl B s1) u s) (C.subt E2 W (C.subT W Nl B s1) v s)
   (OV.trE E2 (C.subT E2 W (IJ.IdT W (C.subT W Nl B s1) u v) s) (IJ.IdT E2 (C.subT E2 W (C.subT W Nl B s1) s) (C.subt E2 W (C.subT W Nl B s1) u s) (C.subt E2 W (C.subT W Nl B s1) v s))
     (IJ.IdT-nat E2 W (C.subT W Nl B s1) u v s) h) ;
 -- the witnesses of the two points, in BE
 pX : C.Sub GX GB = C.p GB Xb ;
 module Wit (ai : C.El E2 X2) (yi : C.El E2 S2) (sn : C.El E2 (C.subT E2 (C.ext E2 X2) Y2 (C.sec E2 X2 ai))) {
  rho : C.Sub E2 GX = C.o E2 (C.ext E2 X2) GX (C.lift E2 GB Xb pp) (C.sec E2 X2 ai) ;
  Ti : C.Ty E2 = C.subT E2 GX (OV.wkT GB Xb Bb) rho ;
  PB : Id (C.Ty E2) Ti BE =
   transH (symH (C.subT-o E2 GX GB Bb pX rho)) (bS GB (C.p Nl B) (C.o E2 GX GB pX rho) (\ K w -> refl (s0.nt K w))) ;
  h0 : C.El E2 (C.subT E2 GX Fm rho) =
   OV.trE E2 (C.subT E2 (C.ext E2 X2) Y2 (C.sec E2 X2 ai)) (C.subT E2 GX Fm rho) (symH (C.subT-o E2 (C.ext E2 X2) GX Fm (C.lift E2 GB Xb pp) (C.sec E2 X2 ai))) sn ;
  h1 : C.El E2 (IJ.IdT E2 Ti (C.subt E2 GX (OV.wkT GB Xb Bb) apX rho) (C.subt E2 GX (OV.wkT GB Xb Bb) (OV.wkE GB Xb Bb (C.q Nl B)) rho)) =
   OV.trE E2 (C.subT E2 GX Fm rho) (IJ.IdT E2 Ti (C.subt E2 GX (OV.wkT GB Xb Bb) apX rho) (C.subt E2 GX (OV.wkT GB Xb Bb) (OV.wkE GB Xb Bb (C.q Nl B)) rho))
    (IJ.IdT-nat E2 GX (OV.wkT GB Xb Bb) apX (OV.wkE GB Xb Bb (C.q Nl B)) rho) h0 ;
  lhs : C.El E2 BE = OV.trE E2 Ti BE PB (C.subt E2 GX (OV.wkT GB Xb Bb) apX rho) ;
  rhs : C.El E2 BE = OV.trE E2 Ti BE PB (C.subt E2 GX (OV.wkT GB Xb Bb) (OV.wkE GB Xb Bb (C.q Nl B)) rho) ;
  h2 : C.El E2 (IJ.IdT E2 BE lhs rhs) = idFwdL E2 Ti BE PB (C.subt E2 GX (OV.wkT GB Xb Bb) apX rho) (C.subt E2 GX (OV.wkT GB Xb Bb) (OV.wkE GB Xb Bb (C.q Nl B)) rho) h1 ;
  rdL (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (BE.1.tob K w)) (lhs.eob K w) (n.nfun K w.1.1.1 (ai.eob K w)) =
   transH (CAppRd[a].trE-rd E2 Ti BE PB (C.subt E2 GX (OV.wkT GB Xb Bb) apX rho) K w)
    (transH (CAppRd[a].same-rd E2 Ti BE PB K w (refl (BE.1.tob K w)) (apX.eob K (rho.nt K w))) (appR K (rho.nt K w))) ;
  rdR (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (BE.1.tob K w)) (rhs.eob K w) w.1.1.2 =
   transH (CAppRd[a].trE-rd E2 Ti BE PB (C.subt E2 GX (OV.wkT GB Xb Bb) (OV.wkE GB Xb Bb (C.q Nl B)) rho) K w)
    (CAppRd[a].same-rd E2 Ti BE PB K w (refl (BE.1.tob K w)) w.1.1.2) ;
 } ;
 module W1 = Wit[a1, y1, INm.snd E2 X2 Y2 y1] ;
 module W2 = Wit[a2, y2, INm.snd E2 X2 Y2 y2] ;
 -- the Id of the two images, as an element of IdZ along t0
 r2 : C.El E2 (IJ.IdT E2 BE W2.lhs W1.rhs) =
  CCmpU14[a].rwId E2 BE W2.lhs W2.lhs W2.rhs W1.rhs (\ K w -> refl (W2.lhs.eob K w)) (\ K w -> transH (W2.rdR K w) (symH (W1.rdR K w))) W2.h2 ;
 iz0 : C.El E2 (IJ.IdT E2 BE W1.lhs W2.lhs) = PT.transM E2 BE W1.lhs W1.rhs W2.lhs W1.h2 (PT.symM E2 BE W2.lhs W1.rhs r2) ;
 hp0 : HP D2 s2 t0 = \ K w -> refl (s0.nt K w) ;
 m1 : C.El E2 BE = mvB D2 s2 t0 hp0 (evS D2 s2 u1) ;
 m2 : C.El E2 BE = mvB D2 s2 t0 hp0 (evS D2 s2 u2) ;
 ur (u : C.El D2 (C.subT D2 Nl A s2)) (x0 : C.El D2 (OV.wkT D1 Aw Aw)) (Pu : Id (C.El D2 (C.subT D2 Nl A s2)) u (OV.trE D2 (OV.wkT D1 Aw Aw) (C.subT D2 Nl A s2) PH2 x0))
   (K : Ob) (x : V1.Ix (D2.ob K)) : Id (V1.Ix (A.1.tob K x.1.1)) (u.eob K x) (x0.eob K x) =
  transH (apH {C.El D2 (C.subT D2 Nl A s2)} {V1.Ix (A.1.tob K x.1.1)} (\ v -> v.eob K x) Pu)
   (transH (CAppRd[a].trE-rd D2 (OV.wkT D1 Aw Aw) (C.subT D2 Nl A s2) PH2 x0 K x)
     (CAppRd[a].same-rd D2 (OV.wkT D1 Aw Aw) (C.subT D2 Nl A s2) PH2 K x (refl (A.1.tob K x.1.1)) (x0.eob K x))) ;
 mr (u : C.El D2 (C.subT D2 Nl A s2)) (K : Ob) (w : V1.Ix (E2.ob K))
   : Id (V1.Ix (BE.1.tob K w)) ((mvB D2 s2 t0 hp0 (evS D2 s2 u)).eob K w) (n.nfun K w.1.1.1 (u.eob K (t0.nt K w))) =
  transH (CAppRd[a].trE-rd E2 (C.subT E2 D2 (C.subT D2 Nl B s2) t0) BE (bS D2 s2 t0 hp0) (C.subt E2 D2 (C.subT D2 Nl B s2) (evS D2 s2 u) t0) K w)
   (CAppRd[a].same-rd E2 (C.subT E2 D2 (C.subT D2 Nl B s2) t0) BE (bS D2 s2 t0 hp0) K w (refl (BE.1.tob K w)) ((evS D2 s2 u).eob K (t0.nt K w))) ;
 br (ai : C.El E2 X2) (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (A.1.tob K (s0.nt K w))) ((OV.trE E2 X2 (C.subT E2 Nl A s0) PA2 ai).eob K w) (ai.eob K w) =
  transH (CAppRd[a].trE-rd E2 X2 (C.subT E2 Nl A s0) PA2 ai K w) (CAppRd[a].same-rd E2 X2 (C.subT E2 Nl A s0) PA2 K w (refl (A.1.tob K (s0.nt K w))) (ai.eob K w)) ;
 px (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (BE.1.tob K w)) (W1.lhs.eob K w) (m1.eob K w) =
  transH (W1.rdL K w)
   (symH (transH (mr u1 K w) (apH {V1.Ix (A.1.tob K (s0.nt K w))} {V1.Ix (B.1.tob K (s0.nt K w))} (n.nfun K w.1.1.1)
      (transH (ur u1 (OV.wkE D1 Aw Aw (C.q Nl A)) (refl u1) K (t0.nt K w)) (br a1 K w))))) ;
 py (K : Ob) (w : V1.Ix (E2.ob K)) : Id (V1.Ix (BE.1.tob K w)) (W2.lhs.eob K w) (m2.eob K w) =
  transH (W2.rdL K w)
   (symH (transH (mr u2 K w) (apH {V1.Ix (A.1.tob K (s0.nt K w))} {V1.Ix (B.1.tob K (s0.nt K w))} (n.nfun K w.1.1.1)
      (transH (ur u2 (C.q D1 Aw) (refl u2) K (t0.nt K w))
        (transH (transH (CAppRd[a].trE-rd E2 (C.subT E2 Nl A s0) (C.subT E2 D1 Aw t1) PT1 b2 K w)
                   (CAppRd[a].same-rd E2 (C.subT E2 Nl A s0) (C.subT E2 D1 Aw t1) PT1 K w (refl (A.1.tob K (s0.nt K w))) (b2.eob K w)))
          (br a2 K w)))))) ;
 izB : C.El E2 (IJ.IdT E2 BE m1 m2) = CCmpU14[a].rwId E2 BE W1.lhs m1 W2.lhs m2 px py iz0 ;
 TD : C.Ty E2 = C.subT E2 D2 (C.subT D2 Nl B s2) t0 ;
 i1 : C.El E2 (IJ.IdT E2 TD (OV.trE E2 BE TD (symH (bS D2 s2 t0 hp0)) m1) (OV.trE E2 BE TD (symH (bS D2 s2 t0 hp0)) m2)) =
  idFwdL E2 BE TD (symH (bS D2 s2 t0 hp0)) m1 m2 izB ;
 e1 : C.El E2 TD = C.subt E2 D2 (C.subT D2 Nl B s2) (evS D2 s2 u1) t0 ;
 e2 : C.El E2 TD = C.subt E2 D2 (C.subT D2 Nl B s2) (evS D2 s2 u2) t0 ;
 i2 : C.El E2 (IJ.IdT E2 TD e1 e2) =
  subst (C.El E2 TD) (\ v -> C.El E2 (IJ.IdT E2 TD e1 v)) (OV.trE E2 BE TD (symH (bS D2 s2 t0 hp0)) m2) e2 (trInv E2 TD BE (bS D2 s2 t0 hp0) e2)
   (subst (C.El E2 TD) (\ v -> C.El E2 (IJ.IdT E2 TD v (OV.trE E2 BE TD (symH (bS D2 s2 t0 hp0)) m2))) (OV.trE E2 BE TD (symH (bS D2 s2 t0 hp0)) m1) e1
     (trInv E2 TD BE (bS D2 s2 t0 hp0) e1) i1) ;
 iz : C.El E2 (C.subT E2 D2 IdZ t0) = OV.trE E2 (IJ.IdT E2 TD e1 e2) (C.subT E2 D2 IdZ t0) (symH (IJ.IdT-nat E2 D2 (C.subT D2 Nl B s2) (evS D2 s2 u1) (evS D2 s2 u2) t0)) i2 ;
 -- the regrouping D2.IdZ -> nil.H and the substitution E2 -> nil.H
 DZ : C.Ctx = C.ext D2 IdZ ;
 rgN (K : Ob) (w : V1.Ix (DZ.ob K)) : V1.Ix (GH.ob K) = (w.1.1.1, (w.1.1.2, (w.1.2, w.2))) ;
 rg : C.Sub DZ GH = new L.PSub[DZ, GH, rgN, \ J I f w -> refl (rgN J (DZ.act J I f w))] ;
 tau : C.Sub E2 GH = C.o E2 DZ GH rg (CQSurj[a].Ex[C].exS E2 D2 IdZ t0 iz) ;
} ;
