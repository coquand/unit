-- CwFPropNoU.seg (canonicity-c2; for "D preserves propositions"):
-- CwFPropProp's propOver and contrOfProp without a universe (isProp is
-- Pi (x y : X) Id(x , y), no code needed), for the fibrant CwFs of the
-- total and levelwise sites.
open Base ;

module PropNoU (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;
  module CK = CwFCC.CC[l, C, PS, SS, IJ, NF] ;
  module JPm = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module INm = CwFInt.Int[l, C, PS, SS, IJ] ;
  isProp (G : Ctx) (A : Ty G) : Ty G = PS.Pi G A (PS.Pi (ext G A) (wkT G A A) (EQ.Id2 G A)) ;
  module PO (G : Ctx) (X : Ty G) (k : El (ext G X) (EQ.isContr (ext G X) (wkT G X X))) {
    Gx : Ctx = ext G X ;
    X1 : Ty Gx = wkT G X X ;
    E : Ctx = ext Gx X1 ;
    kE : El E (EQ.isContr E (wkT Gx X1 X1)) =
      trE E (wkT Gx X1 (EQ.isContr Gx X1)) (EQ.isContr E (wkT Gx X1 X1))
        (EQ.isContr-ov E Gx X1 (p Gx X1) (wkT Gx X1 X1) (refl (wkT Gx X1 X1))) (wkE Gx X1 (EQ.isContr Gx X1) k) ;
    bd : El E (EQ.Id2 G X) = CK.eqC E (wkT Gx X1 X1) kE (wkE Gx X1 X1 (q G X)) (q Gx X1) ;
    propOver : El G (isProp G X) = lam G X (PS.Pi Gx X1 (EQ.Id2 G X)) (lam Gx X1 (EQ.Id2 G X) bd) ;
  } ;
  propOver (G : Ctx) (X : Ty G) (k : El (ext G X) (EQ.isContr (ext G X) (wkT G X X))) : El G (isProp G X) = PO[G, X, k].propOver ;
  contrOfProp (G : Ctx) (X : Ty G) (pX : El G (isProp G X)) (c : El G X) : El G (EQ.isContr G X) =
    SG.mkContr G X c
      (bod G X (JPm.IK G X c)
         (trE G (subT G (ext G X) (SG.CP G X) (sec G X c)) (PS.Pi G X (JPm.IK G X c)) (SG.PCP G X c)
            (INm.appD G X (SG.CP G X) pX c))) ;
  isProp-ov (D G : Ctx) (A : Ty G) (s : Sub D G) (A' : Ty D) (PA : Id (Ty D) (subT D G A s) A')
    : Id (Ty D) (subT D G (isProp G A) s) (isProp D A') =
    Pi-ov D G A (PS.Pi K Ap (EQ.Id2 G A)) s A' PA (PS.Pi K' Ap' (EQ.Id2 D A'))
      (Pi-ov K' K Ap (EQ.Id2 G A) s1 Ap' PAp (EQ.Id2 D A')
         (Id-ov (ext K' Ap') (ext K Ap) App (wkE K Ap Ap (q G A)) (q K Ap) s2 App' PApp
            (wkE K' Ap' Ap' (q D A')) (q K' Ap')
            (wkE-ov K' K Ap Ap (q G A) s1 Ap' PAp Ap' PAp (q D A') (q-ov D G A s A' PA PAp) PApp)
            (q-ov K' K Ap s1 Ap' PAp PApp)))
   where {
    K : Ctx = ext G A ;
    K' : Ctx = ext D A' ;
    Ap : Ty K = wkT G A A ;
    Ap' : Ty K' = wkT D A' A' ;
    App : Ty (ext K Ap) = wkT K Ap Ap ;
    App' : Ty (ext K' Ap') = wkT K' Ap' Ap' ;
    s1 : Sub K' K = upT D G A s A' PA ;
    PAp : Id (Ty K') (subT K' K Ap s1) Ap' = wkT-ov D G A A s A' PA A' PA ;
    s2 : Sub (ext K' Ap') (ext K Ap) = upT K' K Ap s1 Ap' PAp ;
    PApp : Id (Ty (ext K' Ap')) (subT (ext K' Ap') (ext K Ap) App s2) App' = wkT-ov K' K Ap Ap s1 Ap' PAp Ap' PAp ;
   } ;
  wkProp (G : Ctx) (Z A : Ty G) (pa : El G (isProp G A)) : El (ext G Z) (isProp (ext G Z) (wkT G Z A)) =
    trE (ext G Z) (wkT G Z (isProp G A)) (isProp (ext G Z) (wkT G Z A))
      (isProp-ov (ext G Z) G A (p G Z) (wkT G Z A) (refl (wkT G Z A)))
      (wkE G Z (isProp G A) pa) ;
  -- the converse of propOver: a proposition is contractible over itself
  selfContr (G : Ctx) (X : Ty G) (pX : El G (isProp G X)) : El (ext G X) (EQ.isContr (ext G X) (wkT G X X)) =
    contrOfProp (ext G X) (wkT G X X) (wkProp G X X pX) (q G X) ;
  -- two elements of a proposition are joined
  propPath (G : Ctx) (A : Ty G) (pa : El G (isProp G A)) (x y : El G A) : El G (IJ.IdT G A x y) =
    trE G (subT G (ext G A) (JPm.IK G A x) (sec G A y)) (IJ.IdT G A x y) (JPm.IKpt G A x y)
      (INm.appD G A (JPm.IK G A x)
         (trE G (subT G (ext G A) (SG.CP G A) (sec G A x)) (PS.Pi G A (JPm.IK G A x)) (SG.PCP G A x)
            (INm.appD G A (SG.CP G A) pa x))
         y) ;
  module EPm = CwFEqP.EqP[l, C, PS, SS, IJ] ;
  -- a homotopy u v ~ id when the codomain is a proposition
  htpyP (G : Ctx) (X Y : Ty G) (pY : El G (isProp G Y)) (u : El G (Fun G X Y)) (v : El G (Fun G Y X))
    : El G (EQ.Htpy G X Y u v) =
    lam G Y
      (IJ.IdT (ext G Y) (wkT G Y Y)
         (app (ext G Y) (wkT G Y X) (wkT G Y Y) (EQ.wkF G Y X Y u)
            (app (ext G Y) (wkT G Y Y) (wkT G Y X) (EQ.wkF G Y Y X v) (q G Y)))
         (q G Y))
      (propPath (ext G Y) (wkT G Y Y) (wkProp G Y Y pY)
         (app (ext G Y) (wkT G Y X) (wkT G Y Y) (EQ.wkF G Y X Y u)
            (app (ext G Y) (wkT G Y Y) (wkT G Y X) (EQ.wkF G Y Y X v) (q G Y)))
         (q G Y)) ;
  -- maps both ways between propositions: an equivalence
  eqvP (G : Ctx) (A B : Ty G) (pa : El G (isProp G A)) (pb : El G (isProp G B))
    (f : El G (Fun G A B)) (g : El G (Fun G B A)) : El G (EQ.Equiv G A B) =
    EPm.mkE G A B f g (htpyP G A B pb f g) g (htpyP G B A pa g f) ;
} ;
