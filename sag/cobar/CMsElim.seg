-- CMsElim.seg (canonicity-c2): eliminating a mere-existence witness at its
-- native base. TA.Tr is not stable under substitution, so a witness
-- ms : Tr G S is eliminated at G itself into a motive B over G that is a
-- proposition (in practice a Pi over the remaining data, CwFPropProp.piProp),
-- giving an element of B over G; that element (not the truncation) is then
-- substituted to any context. No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
TA : CwFTrunc.Trunc[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv].TruncAt = CQSurj[a].TA ;
module ME (G : C.Ctx) (S : C.Ty G) (ms : C.El G (TA.Tr G S)) (B : C.Ty G) (pB : C.El G (PU.isProp G B))
  (b : C.El (C.ext G S) (C.subT (C.ext G S) G B (C.p G S))) {
 TrS : C.Ty G = TA.Tr G S ;
 GT : C.Ctx = C.ext G TrS ;
 Bm : C.Ty GT = OV.wkT G TrS B ;
 pBm : C.El GT (PU.isProp GT Bm) =
  OV.trE GT (C.subT GT G (PU.isProp G B) (C.p G TrS)) (PU.isProp GT Bm) (PU.isProp-ov GT G B (C.p G TrS) Bm (refl Bm))
   (C.subt GT G (PU.isProp G B) pB (C.p G TrS)) ;
 bm : C.El (C.ext G S) (C.subT (C.ext G S) GT Bm (TA.incS G S)) =
  OV.trE (C.ext G S) (C.subT (C.ext G S) G B (C.p G S)) (C.subT (C.ext G S) GT Bm (TA.incS G S))
   (transH (apH {C.Sub (C.ext G S) G} {C.Ty (C.ext G S)} (\ s -> C.subT (C.ext G S) G B s) (symH (INm.p-extS (C.ext G S) G TrS (C.p G S) (TA.inc G S))))
     (C.subT-o (C.ext G S) GT G B (C.p G TrS) (TA.incS G S))) b ;
 elT : C.El GT Bm = TA.elim G S Bm pBm bm ;
 res : C.El G B = OV.trE G (C.subT G GT Bm (C.sec G TrS ms)) B (CAppRd[a].W.psT G TrS B ms) (C.subt G GT Bm elT (C.sec G TrS ms)) ;
} ;
