-- CClosedProp.seg (canonicity-c2; SIMPLIFIED.md item 2): the decoding
-- of the code of a closed proposition is a proposition, one level up.
--
-- Let T be a closed level-a fibrant type whose weakening over 1.T has a
-- relative contractibility structure k0 (T is a proposition: e.g. a
-- truncation, CTruncFib.OpRC).  Over any context G (level a+) the
-- decoding Dec of T's constant code has the same elements and action
-- (CClosedCode), so the structure moves (CMove.Mv, across the two
-- levels) to Dec[p] over G.Dec.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GS = PB.GPre[a].PS ;
module L = PB.GPre[a+].PS ;

module ClosedProp (T0 : GS.PTy[GS.nilP]) (c : PB.CFibCl.Cl GS.nilP T0)
  (k0 : PB.CPartial[a].ContrOp (GS.extP GS.nilP T0) (GS.subTy (GS.extP GS.nilP T0) GS.nilP T0 (GS.pP GS.nilP T0)))
  (G : L.PCtx) {
  module CC = CClosedCode[a].Closed[T0, c] ;
  D0 : GS.PCtx = GS.extP GS.nilP T0 ;
  T0w : GS.PTy[D0] = GS.subTy D0 GS.nilP T0 (GS.pP GS.nilP T0) ;
  Dt : L.PTy[G] = (CC.DecT G).1 ;
  Dx : L.PCtx = L.extP G Dt ;
  Tw : L.PTy[Dx] = L.subTy Dx G Dt (L.pP G Dt) ;
  module TW = PB.GPre[a+].TyL[Dx, Tw] ;
  module T0L = PB.GPre[a].TyL[D0, T0w] ;
  module TD = PB.GPre[a+].TyL[G, Dt] ;
  module TZ = PB.GPre[a].TyL[GS.nilP, T0] ;

  sF (X : Ob) (z : V1.Ix (Dx.ob X)) : W0.Ix (D0.ob X) = TZ.pr X tt (TD.pr2 X z) ;
  s-nat (Y X : Ob) (g : Hom Y X) (z : V1.Ix (Dx.ob X)) : Id (W0.Ix (D0.ob Y)) (sF Y (Dx.act Y X g z)) (D0.act Y X g (sF X z)) =
    apH (TZ.pr Y tt) (CC.dec-nat G Y X g (TD.pr1 X z) (G.act Y X g (TD.pr1 X z)) (refl (G.act Y X g (TD.pr1 X z))) (TD.pr2 X z)) ;
  mT (X : Ob) (w : TW.EI X) : T0L.EI X = T0L.pr X (sF X (TW.pr1 X w)) (TW.pr2 X w) ;
  module SE = PB.CSub[a].SubE[D0, GS.nilP, GS.pP GS.nilP T0, T0] ;
  module Nt (Y X : Ob) (g : Hom Y X) (w : TW.EI X) {
    z : V1.Ix (Dx.ob X) = TW.pr1 X w ;
    z' : V1.Ix (Dx.ob Y) = Dx.act Y X g z ;
    b : V1.Ix (Tw.tob X z) = TW.pr2 X w ;
    b' : V1.Ix (Tw.tob Y z') = Tw.tact Y X g z z' (refl z') b ;
    rhs : T0L.EI Y = mT Y (TW.pr Y z' b') ;
    q : Id (TZ.EI Y) (SE.mV Y (T0L.E.act Y X g (mT X w))) (SE.mV Y rhs) =
      transH (symH (SE.mV-nat Y X g (mT X w)))
        (transH (TZ.pr-tact Y X g tt tt (refl tt) b)
          (apH (TZ.pr Y tt)
            (symH (CC.dec-nat G Y X g (TD.pr1 X z) (TD.pr1 Y z')
                     (L.ntEq Dx G (L.pP G Dt) Y X g z z' (refl z')) b)))) ;
    res : Id (T0L.EI Y) (T0L.E.act Y X g (mT X w)) (mT Y (TW.E.act Y X g w)) =
      transH (SE.mV-inj Y (T0L.E.act Y X g (mT X w)) rhs (symH (s-nat Y X g z)) q)
        (apH (mT Y) (symH (TW.pr-tact Y X g z z' (refl z') b))) ;
  } ;
  mTinj (X : Ob) (v v' : TW.EI X) (P : Id (V1.Ix (Dx.ob X)) (TW.pr1 X v) (TW.pr1 X v')) (Q : Id (T0L.EI X) (mT X v) (mT X v'))
    : Id (TW.EI X) v v' =
    idJ (V1.Ix (Dx.ob X)) (TW.pr1 X v)
      (\ z2 P2 -> (b2 : TW.T X z2) -> Id (T0L.EI X) (mT X v) (T0L.pr X (sF X z2) b2) -> Id (TW.EI X) v (TW.pr X z2 b2))
      (\ b2 Q2 -> apH (TW.pr X (TW.pr1 X v)) (T0L.pr-inj X (sF X (TW.pr1 X v)) (TW.pr2 X v) b2 Q2))
      (TW.pr1 X v') P (TW.pr2 X v') Q ;

  module M = PB.CMove[a, a+].Mv[Dx, Tw, Tw, PB.CPartial[a+].pmap-id Dx Tw, D0, T0w, T0w, PB.CPartial[a].pmap-id D0 T0w,
    sF, s-nat, mT, \ X v -> refl (sF X (TW.pr1 X v)), \ Y X g v -> Nt[Y, X, g, v].res,
    mT, \ X v -> refl (sF X (TW.pr1 X v)), \ Y X g v -> Nt[Y, X, g, v].res, mTinj,
    \ X x u -> u, \ X x u -> refl (T0L.pr X (sF X x) u), \ X v -> refl (mT X v), k0] ;

  -- the decoding is a proposition: contractible over itself
  rc : PB.CPartial[a+].ContrOp Dx Tw = M.rc ;
  -- as an element of the internal isContr (with the fibrant CwF's Id)
  TwS : FibCwF[a, a+].FC.STy Dx = FibCwF[a, a+].FC.subS Dx G (CC.DecT G) (L.pP G Dt) ;
  contr : FibCwF[a, a+].fibCwF.El Dx
            (CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId].isContr Dx TwS) =
    FibContr[a, a+].contr Dx TwS rc ;
} ;
