-- CCeVar.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', the
-- components of the Q- and G-tuples (CCeTup) at each variable v of y.u, read
-- by cases on CSpA2's spl: an old generator x_i (Q: the value of alpha(d) at
-- x_i; G: tau(pre_{k_i} d)) or a new variable j (Q: psi of the j-th new
-- value; G: that value).  By recursion on the number of new variables.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module VA (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module TU = CCeTup[a].TU[R, encK, pe, y, u, y'] ;
 module CV = TU.CV ;
 module S1 = TU.S1 ;
 module AQ = TU.AQ ;
 module AP = TU.AP ;
 module AYm = CV.UP.AYm ;
 n : Nat = TU.n ;
 m : Nat = TU.m ;
 FinN : U a = SX.Fin n ;
 QK (I : Ob) : U a+ = V1.Ix (TU.Qc.tob I tt) ;
 GK (I : Ob) : U a+ = V1.Ix (TU.PO2.Tc.tob I tt) ;
 -- cases on (old, new)
 csQ (j : Nat) (I : Ob) (f : FinN -> QK I) (g : SX.Fin j -> QK I) : Arith[a].Plus FinN (SX.Fin j) -> QK I = split { inl i -> f i ; inr k -> g k } ;
 csG (j : Nat) (I : Ob) (f : FinN -> GK I) (g : SX.Fin j -> GK I) : Arith[a].Plus FinN (SX.Fin j) -> GK I = split { inl i -> f i ; inr k -> g k } ;
 -- lookups of new values
 lkQ : (j : Nat) -> SX.Fin j -> (I : Ob) -> S1.PK j I -> QK I = split {
  zero -> \ v -> absurd ((I : Ob) -> S1.PK zero I -> QK I) v ;
  suc j | r -> split { inl v -> \ I vv -> r v I vv.1 ; inr w -> \ I vv -> vv.2 } } ;
 -- the old part of the Q-tuple: tup then cQ then proj
 QC0 : (j : Nat) (i : SX.Fin j) (I : Ob) (f : SX.Fin j -> QK I) -> Id (QK I) ((AQ.proj j i).nfun I tt (TU.cQ j I (S1.tup j I f))) (f i) = split {
  zero -> \ i -> absurd ((I : Ob) (f : SX.Fin zero -> QK I) -> Id (QK I) ((AQ.proj zero i).nfun I tt (TU.cQ zero I (S1.tup zero I f))) (f i)) i ;
  suc j | r -> split {
   inl v -> \ I f -> r v I (\ v2 -> f (inl v2)) ;
   inr w -> \ I f -> apH {Top} {QK I} (\ t -> f (inr t)) (isTop tt w) } } ;
 -- the Q-tuple at a variable, by cases on spl
 csLiftQ (j : Nat) (I : Ob) (f : FinN -> QK I) (vv : S1.PK (suc j) I) : (c : Arith[a].Plus FinN (SX.Fin j))
  -> Id (QK I) (csQ (suc j) I f (\ k -> lkQ (suc j) k I vv) (AYm.lift j c)) (csQ j I f (\ k -> lkQ j k I vv.1) c) = split {
  inl i -> refl (f i) ;
  inr k -> refl (lkQ j k I vv.1) } ;
 QC : (j : Nat) (v : SX.Fin (Arith[a].plus j n)) (I : Ob) (xp : V1.Ix ((S1.EV.Gk n).ob I)) (vv : S1.PK j I)
  -> Id (QK I) ((AQ.proj (Arith[a].plus j n) v).nfun I tt (TU.cQ (Arith[a].plus j n) I (S1.app j I xp vv)))
             (csQ j I (\ i -> (AQ.proj n i).nfun I tt (TU.cQ n I xp)) (\ k -> lkQ j k I vv) (AYm.spl j v)) = split {
  zero -> \ v I xp vv -> refl ((AQ.proj n v).nfun I tt (TU.cQ n I xp)) ;
  suc j | r -> split {
   inl v -> \ I xp vv -> transH (r v I xp vv.1) (symH (csLiftQ j I (\ i -> (AQ.proj n i).nfun I tt (TU.cQ n I xp)) vv (AYm.spl j v))) ;
   inr w -> \ I xp vv -> refl vv.2 } } ;
 -- the G side
 module TW = CV.UP.SO.TW ;
 module GYo = AYm.G ;
 GC0 : (j : Nat) (i : SX.Fin j) (I : Ob) (f : SX.Fin j -> GK I) -> Id (GK I) ((AP.proj j i).nfun I tt (TU.cG0 j I (GYo.pt (CV.K0 I) j f))) (f i) = split {
  zero -> \ i -> absurd ((I : Ob) (f : SX.Fin zero -> GK I) -> Id (GK I) ((AP.proj zero i).nfun I tt (TU.cG0 zero I (GYo.pt (CV.K0 I) zero f))) (f i)) i ;
  suc j | r -> split {
   inl v -> \ I f -> r v I (\ v2 -> f (inl v2)) ;
   inr w -> \ I f -> apH {Top} {GK I} (\ t -> f (inr t)) (isTop tt w) } } ;
 csLiftG (j : Nat) (I : Ob) (f : FinN -> GK I) (x : V1.Ix ((CV.UP.Ex (suc j)).ob (CV.K0 I))) : (c : Arith[a].Plus FinN (SX.Fin j))
  -> Id (GK I) (csG (suc j) I f (\ k -> TW.lkX (suc j) k (CV.K0 I) x) (AYm.lift j c)) (csG j I f (\ k -> TW.lkX j k (CV.K0 I) x.1) c) = split {
  inl i -> refl (f i) ;
  inr k -> refl (TW.lkX j k (CV.K0 I) x.1) } ;
 GC : (j : Nat) (v : SX.Fin (Arith[a].plus j n)) (I : Ob) (x : V1.Ix ((CV.UP.Ex j).ob (CV.K0 I)))
  -> Id (GK I) ((AP.proj (Arith[a].plus j n) v).nfun I tt (TU.cG j I x))
             (csG j I (\ i -> (AP.proj n i).nfun I tt (TU.cG0 n I (TW.dropN j (CV.K0 I) x))) (\ k -> TW.lkX j k (CV.K0 I) x) (AYm.spl j v)) = split {
  zero -> \ v I x -> refl ((AP.proj n v).nfun I tt (TU.cG0 n I x)) ;
  suc j | r -> split {
   inl v -> \ I x -> transH (r v I x.1) (symH (csLiftG j I (\ i -> (AP.proj n i).nfun I tt (TU.cG0 n I (TW.dropN j (CV.K0 I) x.1))) x (AYm.spl j v))) ;
   inr w -> \ I x -> refl x.2 } } ;
 -- psi on the new values commutes with the lookups
 lkPsi : (j : Nat) (k : SX.Fin j) (I : Ob) (x : V1.Ix ((CV.UP.Ex j).ob (CV.K0 I)))
  -> Id (QK I) (lkQ j k I (CV.mapP j I x)) (TU.PO2.psi.nfun I tt (TW.lkX j k (CV.K0 I) x)) = split {
  zero -> \ k -> absurd ((I : Ob) (x : V1.Ix ((CV.UP.Ex zero).ob (CV.K0 I))) -> Id (QK I) (lkQ zero k I (CV.mapP zero I x)) (TU.PO2.psi.nfun I tt (TW.lkX zero k (CV.K0 I) x))) k ;
  suc j | r -> split {
   inl v -> \ I x -> r v I x.1 ;
   inr w -> \ I x -> refl (TU.PO2.psi.nfun I tt x.2) } } ;
 csQc (j : Nat) (I : Ob) (f1 f2 : FinN -> QK I) (g : SX.Fin j -> QK I) (P : (i : FinN) -> Id (QK I) (f1 i) (f2 i))
  : (c : Arith[a].Plus FinN (SX.Fin j)) -> Id (QK I) (csQ j I f1 g c) (csQ j I f2 g c) = split { inl i -> P i ; inr k -> refl (g k) } ;
 csGc (j : Nat) (I : Ob) (f1 f2 : FinN -> GK I) (g : SX.Fin j -> GK I) (P : (i : FinN) -> Id (GK I) (f1 i) (f2 i))
  : (c : Arith[a].Plus FinN (SX.Fin j)) -> Id (GK I) (csG j I f1 g c) (csG j I f2 g c) = split { inl i -> P i ; inr k -> refl (g k) } ;
 -- the two components at a variable v, as maps Ec -> Q
 module HO = TU.HO ;
 Nl : L.PCtx = TU.Nl ;
 Ec : L.PTy[Nl] = TU.Ec ;
 Qc : L.PTy[Nl] = TU.Qc ;
 Av (v : SX.Fin TU.kk) : HO.NMap[Nl, Ec, Qc] = HO.compN Nl Ec TU.PQt Qc TU.tupQ (AQ.proj TU.kk v) ;
 Bv (v : SX.Fin TU.kk) : HO.NMap[Nl, Ec, Qc] = HO.compN Nl Ec TU.PO2.Tc Qc (HO.compN Nl Ec TU.PG TU.PO2.Tc TU.tupG (AP.proj TU.kk v)) TU.PO2.psi ;
 -- their readings
 rdA (v : SX.Fin TU.kk) (I : Ob) (w : V1.Ix (Ec.tob I tt))
  : Id (QK I) ((Av v).nfun I tt w) (csQ m I (\ i -> S1.hval I (TU.zz I w) i) (\ k -> lkQ m k I (TU.vv I w)) (AYm.spl m v)) =
  transH (QC m v I (S1.tup n I (S1.hval I (TU.zz I w))) (TU.vv I w))
   (csQc m I (\ i -> (AQ.proj n i).nfun I tt (TU.cQ n I (S1.tup n I (S1.hval I (TU.zz I w))))) (\ i -> S1.hval I (TU.zz I w) i)
      (\ k -> lkQ m k I (TU.vv I w)) (\ i -> QC0 n i I (S1.hval I (TU.zz I w))) (AYm.spl m v)) ;
 -- dropping the new values of the unpacked point gives back the old point
 module UP = CV.UP ;
 Cg : CwF.CwF[a++] = UP.C ;
 dUX : (j : Nat) (B : Cg.Ty (UP.Ex j)) (X : CV.CB.RH.CT.TC.TOb) (z : V1.Ix ((Cg.ext UP.SO.Pr (UP.SA.SigX j B)).ob X))
  -> Id (V1.Ix (UP.SO.Pr.ob X)) (TW.dropN j X ((UP.UX j B).nt X z).1) z.1 = split {
  zero -> \ B X z -> refl z.1 ;
  suc j | r -> \ B X z -> r (UP.SS.Sig (UP.Ex j) (UP.Gat (UP.Ex j)) B) X z } ;
 rdB (v : SX.Fin TU.kk) (I : Ob) (w : V1.Ix (Ec.tob I tt))
  : Id (QK I) ((Bv v).nfun I tt w) (TU.PO2.psi.nfun I tt (csG m I (\ i -> GYo.gv i (CV.K0 I) (CV.CB.dOf I w)) (\ k -> TW.lkX m k (CV.K0 I) (CV.xi I w)) (AYm.spl m v))) =
  apH {GK I} {QK I} (TU.PO2.psi.nfun I tt)
   (transH (GC m v I (CV.xi I w))
     (csGc m I (\ i -> (AP.proj n i).nfun I tt (TU.cG0 n I (TW.dropN m (CV.K0 I) (CV.xi I w)))) (\ i -> GYo.gv i (CV.K0 I) (CV.CB.dOf I w))
        (\ k -> TW.lkX m k (CV.K0 I) (CV.xi I w))
        (\ i -> transH (apH {V1.Ix (UP.SO.Pr.ob (CV.K0 I))} {GK I} (\ x0 -> (AP.proj n i).nfun I tt (TU.cG0 n I x0))
                  (dUX m (UP.SA.SigH UP.qs UP.Ut) (CV.K0 I) ((Cg.lift UP.RS.LA.PYy UP.SO.Pr (UP.SA.Sp UP.qs) UP.AYm.G.gY).nt (CV.K0 I) w)))
                 (GC0 n i I (\ i2 -> GYo.gv i2 (CV.K0 I) (CV.CB.dOf I w)))) (AYm.spl m v))) ;
 -- the homotopy at a variable: by cases on spl
 module CO = CCeOld[a].CO[R, encK, pe, y, u, y'] ;
 PlusNM : U a = Arith[a].Plus FinN (SX.Fin m) ;
 module VH (v : SX.Fin TU.kk) {
  hf (I : Ob) (w : V1.Ix (Ec.tob I tt)) (i : FinN) : QK I = S1.hval I (TU.zz I w) i ;
  lq (I : Ob) (w : V1.Ix (Ec.tob I tt)) (k : SX.Fin m) : QK I = lkQ m k I (TU.vv I w) ;
  gf (I : Ob) (w : V1.Ix (Ec.tob I tt)) (i : FinN) : GK I = GYo.gv i (CV.K0 I) (CV.CB.dOf I w) ;
  lg (I : Ob) (w : V1.Ix (Ec.tob I tt)) (k : SX.Fin m) : GK I = TW.lkX m k (CV.K0 I) (CV.xi I w) ;
  paO (i : FinN) (ee : Id PlusNM (inl i) (AYm.spl m v)) (I : Ob) : (o : Top) (w : V1.Ix (Ec.tob I o)) -> Id (V1.Ix (Qc.tob I o)) ((Av v).nfun I o w) (CO.Gi[i].b0N.nfun I o w) = split {
   tt -> \ w -> transH (rdA v I w) (apH {PlusNM} {QK I} (csQ m I (hf I w) (lq I w)) (symH ee)) } ;
  pbO (i : FinN) (ee : Id PlusNM (inl i) (AYm.spl m v)) (I : Ob) : (o : Top) (w : V1.Ix (Ec.tob I o)) -> Id (V1.Ix (Qc.tob I o)) ((Bv v).nfun I o w) (CO.Gi[i].lhs.nfun I o w) = split {
   tt -> \ w -> transH (rdB v I w) (apH {PlusNM} {QK I} (\ c -> TU.PO2.psi.nfun I tt (csG m I (gf I w) (lg I w) c)) (symH ee)) } ;
  paN (k : SX.Fin m) (ee : Id PlusNM (inr k) (AYm.spl m v)) (I : Ob) : (o : Top) (w : V1.Ix (Ec.tob I o)) -> Id (V1.Ix (Qc.tob I o)) ((Av v).nfun I o w) ((Bv v).nfun I o w) = split {
   tt -> \ w -> transH (rdA v I w) (transH (apH {PlusNM} {QK I} (csQ m I (hf I w) (lq I w)) (symH ee))
     (transH (lkPsi m k I (CV.xi I w)) (symH (transH (rdB v I w) (apH {PlusNM} {QK I} (\ c -> TU.PO2.psi.nfun I tt (csG m I (gf I w) (lg I w) c)) (symH ee)))))) } ;
  Hv : (c : PlusNM) (ee : Id PlusNM c (AYm.spl m v)) -> L.PEl[L.extP Nl Ec, HO.HT[Nl, Ec, Qc, Av v, Bv v].PT.PathP] = split {
   inl i -> \ ee -> HO.Ret[Nl, Ec, Qc, CO.Gi[i].b0N, CO.Gi[i].lhs, Av v, Bv v, paO i ee, pbO i ee,
      HO.Inv[Nl, Ec, Qc, CO.Gi[i].lhs, CO.Gi[i].b0N, TU.PO2.PQ.RD.cQ, CO.Gi[i].res].res].res ;
   inr k -> \ ee -> HO.Ret[Nl, Ec, Qc, Bv v, Bv v, Av v, Bv v, paN k ee, \ I o w -> refl ((Bv v).nfun I o w), HO.Rf[Nl, Ec, Qc, Bv v].res].res } ;
  res : L.PEl[L.extP Nl Ec, HO.HT[Nl, Ec, Qc, Av v, Bv v].PT.PathP] = Hv (AYm.spl m v) (refl (AYm.spl m v)) ;
 } ;
} ;
