-- CHomT10.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 7: the way back for the
-- constants.  From CMorX's family r |-> (dc r, dn r): the Pi family over
-- the closed Sigma (r', u, p') (dc r' moved back across CHomData's type
-- equations IdP and along comp-idr) and its Pi naturality (CHomT7's chain
-- run backwards; trInv: transport along a type equation and back).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PB = PosFull[a].PB ;
module LP = PB.GPre[a+].PS ;

-- transport along a type equation and back
trInvL (G : C.Ctx) (A B : C.Ty G) (Pt : Id (C.Ty G) A B) (K : Ob) (x : V1.Ix (G.ob K)) (v : V1.Ix (A.1.tob K x))
 : Id (V1.Ix (A.1.tob K x)) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) B A (symH Pt) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) A B Pt v)) v =
 idJ (C.Ty G) A (\ B2 P2 -> Id (V1.Ix (A.1.tob K x)) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) B2 A (symH P2) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) A B2 P2 v)) v)
  (refl v) B Pt ;
trInvR (G : C.Ctx) (A B : C.Ty G) (Pt : Id (C.Ty G) A B) (K : Ob) (x : V1.Ix (G.ob K)) (v : V1.Ix (B.1.tob K x))
 : Id (V1.Ix (B.1.tob K x)) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) A B Pt (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) B A (symH Pt) v)) v =
 idJ (C.Ty G) A (\ B2 P2 -> (v2 : V1.Ix (B2.1.tob K x)) -> Id (V1.Ix (B2.1.tob K x)) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) A B2 P2 (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) B2 A (symH P2) v2)) v2)
  (\ v2 -> refl v2) B Pt v ;

module RevC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module P = CHomT4[a].P3[R, encK, pe, s, t] ;
 module F = P.F ;
 module H = P.H ;
 module CS = H.CS ;
 module RR (r : R.R) {
  module CR = P.CR[r] ;
  module NN = F.NC[r].N ;
  AS : C.Ty CR.PS.Q3.G1 = C.subT CR.PS.Q3.G1 CR.PS.Q3.G2 (IJ.IdT CR.PS.Q3.G2 CR.PS.Q3.Qw2 CR.PS.Q3.v1 CR.PS.Q3.v2) CR.PS.rho ;
  AT : C.Ty CR.PT.Q3.G1 = C.subT CR.PT.Q3.G1 CR.PT.Q3.G2 (IJ.IdT CR.PT.Q3.G2 CR.PT.Q3.Qw2 CR.PT.Q3.v1 CR.PT.Q3.v2) CR.PT.rho ;
 } ;
 module PCc = PresheafPi[a, a+].PPi[PB.BC].PiCode[H.B0.Gh, CS.Wch.1, CS.IdCT.1] ;
 G2 : C.Ctx = CS.GT2.G2 ;
 IG : C.Ty G2 = CS.IdGT ;
 P2 (K : Ob) : U a+ = V1.Ix (G2.ob K) ;
 tactSrc (K L : Ob) (g : Hom L K) (x0' x0 : P2 K) (q : Id (P2 K) x0' x0) (X : V1.Ix (IG.1.tob K x0')) (y : P2 L)
   (e : Id (P2 L) (G2.act L K g x0) y) (e' : Id (P2 L) (G2.act L K g x0') y)
  : Id (V1.Ix (IG.1.tob L y)) (IG.1.tact L K g x0 y e (subst (P2 K) (\ v -> V1.Ix (IG.1.tob K v)) x0' x0 q X)) (IG.1.tact L K g x0' y e' X) =
  idJ (P2 K) x0' (\ x1 q1 -> (e1 : Id (P2 L) (G2.act L K g x1) y) -> Id (V1.Ix (IG.1.tob L y)) (IG.1.tact L K g x1 y e1 (subst (P2 K) (\ v -> V1.Ix (IG.1.tob K v)) x0' x1 q1 X)) (IG.1.tact L K g x0' y e' X))
   (\ e1 -> LP.tact-irr G2 IG.1 L K g x0' y e1 e' X) x0 q e ;
 substTr (L : Ob) (x y z : P2 L) (p : Id (P2 L) x y) (q : Id (P2 L) y z) (u : V1.Ix (IG.1.tob L x))
  : Id (V1.Ix (IG.1.tob L z)) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x z (transH p q) u) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y z q (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)) =
  idJ (P2 L) y (\ z2 q2 -> Id (V1.Ix (IG.1.tob L z2)) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x z2 (transH p q2) u) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y z2 q2 (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)))
   (refl (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)) z q ;
 module Back (I : Ob) (ph : F.Fam I) (nt : F.Nat I ph)
   (dc : (r : R.R) -> F.NC[r].N.DT I ph) (dn : (r : R.R) -> F.NC[r].N.DN I ph (dc r)) {
  x : V1.Ix (H.B0.Gh.ob I) = (tt, (ph, nt)) ;
  cT (r : R.R) (K2 : Ob) : F.T.QK K2 = (P.HP.Alg[t].AX.cls (cst r)).eob K2 tt ;
  WcK (K : Ob) : U a+ = V1.Ix (CS.Wc.1.tob K tt) ;
  pB (K : Ob) (wq : WcK K) : V1.Ix (F.NC[wq.1].N.FS K wq.2.1) =
   subst (C.Ty RR[wq.1].CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, wq.2.1))) RR[wq.1].AS RR[wq.1].CR.PS.CT.IdCst RR[wq.1].CR.PS.IdP wq.2.2 ;
  DA (K : Ob) (f : Hom K I) (wq : WcK K) : V1.Ix (IG.1.tob K ((tt, cT wq.1 K), ph K f wq.2.1)) =
   subst (C.Ty RR[wq.1].CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob K (tt, ph K f wq.2.1))) RR[wq.1].CR.PT.CT.IdCst RR[wq.1].AT (symH RR[wq.1].CR.PT.IdP)
    (dc wq.1 K f wq.2.1 (pB K wq)) ;
  phiC : PCc.FunT I (PCc.ptOf I x) = \ K f wq ->
   subst (Hom K I) (\ k -> V1.Ix (IG.1.tob K ((tt, cT wq.1 K), ph K k wq.2.1))) f (compH K K I f (idH K)) (symH (comp-idr K I f)) (DA K f wq) ;
  module NB (K L : Ob) (f : Hom K I) (g : Hom L K) (wq : WcK K) {
   r : R.R = wq.1 ;
   u : F.S.QK K = wq.2.1 ;
   module Q = RR[r] ;
   module NN = F.NC[r].N ;
   fg : Hom L I = compH L K I f g ;
   rsu : F.S.QK L = F.S.rs K L g u ;
   x0 : P2 K = ((tt, cT r K), ph K f u) ;
   x0' : P2 K = ((tt, cT r K), ph K (compH K K I f (idH K)) u) ;
   qR : Id (P2 K) x0 x0' = ap (Hom K I) (P2 K) (\ k -> ((tt, cT r K), ph K k u)) f (compH K K I f (idH K)) (symH (comp-idr K I f)) ;
   aw : WcK L = PCc.AactOf I (PCc.ptOf I x) (PCc.cOf I x) K L f g wq ;
   sigL (wq' : WcK L) : P2 L = CS.rTN L (CS.sTN L (PCc.ptOf I x L fg, wq')) ;
   yB : P2 L = sigL aw ;
   eB : Id (P2 L) (G2.act L K g x0') yB =
    LP.ntEq CS.GPT G2 CS.rT L K g (CS.sTN K (PCc.ptOf I x K f, wq)) (CS.sTN L (PCc.ptOf I x L fg, aw))
     (LP.ntEq CS.Dc CS.GPT CS.sT L K g (PCc.ptOf I x K f, wq) (PCc.ptOf I x L fg, aw) (PCc.eOf I x K L f g wq)) ;
   e1 : NN.EqT K L g (ph K f u) (ph L fg rsu) = apH {F.T.QK L} {F.T.P1 L} (F.T.mk1 L) (nt K L f g u) ;
   y2 : P2 L = ((tt, cT r L), ph L fg rsu) ;
   eA : Id (P2 L) (G2.act L K g x0) y2 = LP.ntEq Q.CR.PT.Q3.G1 Q.CR.PT.Q3.G2 Q.CR.PT.rho L K g (tt, ph K f u) (tt, ph L fg rsu) e1 ;
   pBq : V1.Ix (NN.FS K u) = pB K wq ;
   DAk : V1.Ix (IG.1.tob K x0) = DA K f wq ;
   D : V1.Ix (NN.FT K (ph K f u)) = dc r K f u pBq ;
   D1 : V1.Ix (NN.FT L (ph L fg rsu)) = dc r L fg rsu (NN.acS K L g u pBq) ;
   DA1 : V1.Ix (IG.1.tob L y2) = subst (C.Ty Q.CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob L (tt, ph L fg rsu))) Q.CR.PT.CT.IdCst Q.AT (symH Q.CR.PT.IdP) D1 ;
   p1' : V1.Ix (Q.AS.1.tob L (tt, rsu)) = subst (C.Ty Q.CR.PS.Q3.G1) (\ T -> V1.Ix (T.1.tob L (tt, rsu))) Q.CR.PS.CT.IdCst Q.AS (symH Q.CR.PS.IdP) (NN.acS K L g u pBq) ;
   wq1 : WcK L = (r, (rsu, p1')) ;
   pa : V1.Ix (CS.GPS.ob K) = ((tt, r), u) ;
   pb : V1.Ix (CS.GPS.ob L) = ((tt, r), rsu) ;
   pX : Id (V1.Ix (Q.AS.1.tob L (tt, rsu))) (CS.IdCSt.1.tact L K g pa pb (refl pb) wq.2.2) p1' =
    transH (LP.tact-irr CS.GS2.G2 CS.IdGS.1 L K g (CS.rSN K pa) (CS.rSN L pb) (LP.ntEq CS.GPS CS.GS2.G2 CS.rS L K g pa pb (refl pb))
              (LP.ntEq Q.CR.PS.Q3.G1 Q.CR.PS.Q3.G2 Q.CR.PS.rho L K g (tt, u) (tt, rsu) (refl (tt, rsu))) wq.2.2)
     (transH (apH {V1.Ix (Q.AS.1.tob K (tt, u))} {V1.Ix (Q.AS.1.tob L (tt, rsu))} (\ v -> Q.AS.1.tact L K g (tt, u) (tt, rsu) (refl (tt, rsu)) v)
                (symH (trInvL Q.CR.PS.Q3.G1 Q.AS Q.CR.PS.CT.IdCst Q.CR.PS.IdP K (tt, u) wq.2.2)))
       (CHomT7[a].tyTr Q.CR.PS.Q3.G1 Q.CR.PS.CT.IdCst Q.AS (symH Q.CR.PS.IdP) L K g (tt, u) (tt, rsu) (refl (tt, rsu)) pBq)) ;
   piw : Id (WcK L) aw wq1 =
    transH (LP.tact-irr C.nil CS.Wc.1 L K g tt tt (LP.ntEq H.B0.Gh C.nil H.B0.pG L K g (PCc.ptOf I x K f) (PCc.ptOf I x L fg) (PCc.cOf I x K L f g)) (refl tt) wq)
     (apH {V1.Ix (Q.AS.1.tob L (tt, rsu))} {WcK L} (\ q -> (r, (rsu, q))) pX) ;
   pib : Id (P2 L) (sigL wq1) yB = ap (WcK L) (P2 L) sigL wq1 aw (symH piw) ;
   qY : Id (P2 L) y2 (sigL wq1) = ap (Hom L I) (P2 L) (\ k -> ((tt, cT r L), ph L k rsu)) fg (compH L L I fg (idH L)) (symH (comp-idr L I fg)) ;
   qX : Id (P2 L) y2 yB = transH qY pib ;
   TB : U a+ = V1.Ix (IG.1.tob L yB) ;
   DAeq : Id (V1.Ix (IG.1.tob L y2)) (DA L fg wq1) DA1 =
    apH {V1.Ix (NN.FS L rsu)} {V1.Ix (IG.1.tob L y2)}
     (\ q -> subst (C.Ty Q.CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob L (tt, ph L fg rsu))) Q.CR.PT.CT.IdCst Q.AT (symH Q.CR.PT.IdP) (dc r L fg rsu q))
     (trInvR Q.CR.PS.Q3.G1 Q.AS Q.CR.PS.CT.IdCst Q.CR.PS.IdP L (tt, rsu) (NN.acS K L g u pBq)) ;
   core : Id (V1.Ix (IG.1.tob L y2)) (IG.1.tact L K g x0 y2 eA DAk) DA1 =
    transH (CHomT7[a].tyTr Q.CR.PT.Q3.G1 Q.CR.PT.CT.IdCst Q.AT (symH Q.CR.PT.IdP) L K g (tt, ph K f u) (tt, ph L fg rsu) e1 D)
     (apH {V1.Ix (NN.FT L (ph L fg rsu))} {V1.Ix (IG.1.tob L y2)} (\ v -> subst (C.Ty Q.CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob L (tt, ph L fg rsu))) Q.CR.PT.CT.IdCst Q.AT (symH Q.CR.PT.IdP) v)
        (dn r K L f g u e1 pBq)) ;
   t1 : Id TB (IG.1.tact L K g x0' yB eB (phiC K f wq)) (IG.1.tact L K g x0' yB eB (subst (P2 K) (\ v -> V1.Ix (IG.1.tob K v)) x0 x0' qR DAk)) =
    apH {V1.Ix (IG.1.tob K x0')} {TB} (\ v -> IG.1.tact L K g x0' yB eB v)
     (subst-ap (Hom K I) (P2 K) (\ k -> ((tt, cT r K), ph K k u)) (\ v -> V1.Ix (IG.1.tob K v)) f (compH K K I f (idH K)) (symH (comp-idr K I f)) DAk) ;
   t2 : Id TB (IG.1.tact L K g x0' yB eB (subst (P2 K) (\ v -> V1.Ix (IG.1.tob K v)) x0 x0' qR DAk)) (IG.1.tact L K g x0 yB (transH eA qX) DAk) =
    tactSrc K L g x0 x0' qR DAk yB eB (transH eA qX) ;
   t3 : Id TB (IG.1.tact L K g x0 yB (transH eA qX) DAk) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y2 yB qX (IG.1.tact L K g x0 y2 eA DAk)) =
    CMorX[a].tactTr G2 IG L K g x0 y2 yB eA qX DAk ;
   t4 : Id TB (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y2 yB qX (IG.1.tact L K g x0 y2 eA DAk)) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y2 yB qX DA1) =
    apH {V1.Ix (IG.1.tob L y2)} {TB} (\ v -> subst (P2 L) (\ v2 -> V1.Ix (IG.1.tob L v2)) y2 yB qX v) core ;
   t5 : Id TB (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y2 yB qX DA1) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) (sigL wq1) yB pib (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y2 (sigL wq1) qY DA1)) =
    substTr L y2 (sigL wq1) yB qY pib DA1 ;
   t6 : Id (V1.Ix (IG.1.tob L (sigL wq1))) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y2 (sigL wq1) qY DA1) (phiC L fg wq1) =
    transH (symH (subst-ap (Hom L I) (P2 L) (\ k -> ((tt, cT r L), ph L k rsu)) (\ v -> V1.Ix (IG.1.tob L v)) fg (compH L L I fg (idH L)) (symH (comp-idr L I fg)) DA1))
     (apH {V1.Ix (IG.1.tob L y2)} {V1.Ix (IG.1.tob L (sigL wq1))}
        (\ v -> subst (Hom L I) (\ k -> V1.Ix (IG.1.tob L ((tt, cT r L), ph L k rsu))) fg (compH L L I fg (idH L)) (symH (comp-idr L I fg)) v) (symH DAeq)) ;
   t7 : Id TB (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) (sigL wq1) yB pib (phiC L fg wq1)) (phiC L fg aw) =
    transH (symH (subst-ap (WcK L) (P2 L) sigL (\ v -> V1.Ix (IG.1.tob L v)) wq1 aw (symH piw) (phiC L fg wq1)))
     (CMorX[a].apdS (WcK L) (\ wq' -> V1.Ix (IG.1.tob L (sigL wq'))) (\ wq' -> phiC L fg wq') wq1 aw (symH piw)) ;
   law : Id TB (IG.1.tact L K g x0' yB eB (phiC K f wq)) (phiC L fg aw) =
    transH t1 (transH t2 (transH t3 (transH t4 (transH t5
     (transH (apH {V1.Ix (IG.1.tob L (sigL wq1))} {TB} (\ v -> subst (P2 L) (\ v2 -> V1.Ix (IG.1.tob L v2)) (sigL wq1) yB pib v) t6) t7))))) ;
  } ;
  natC : PCc.NatT I (PCc.ptOf I x) (PCc.cOf I x) (PCc.eOf I x) phiC = \ K L f g wq -> NB[K, L, f, g, wq].law ;
  piEl : V1.Ix (CS.DataCst.1.tob I x) = (phiC, natC) ;
 } ;
} ;
