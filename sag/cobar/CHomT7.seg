-- CHomT7.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 4: the constants' data
-- moved to CMorX (CHomT4's CR.dc) satisfy CMorX's naturality.  Both Id
-- types are read as the generic Id over nil.Q.Q (CHomData.PropCst's
-- type equation IdP; tyTr: transport along a type equation commutes with
-- the action), then CHomT5's chain at the points of nil.Q.Q.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PB = PosFull[a].PB ;
module LP = PB.GPre[a+].PS ;

-- transport along a type equation commutes with the action
tyTr (G : C.Ctx) (A B : C.Ty G) (Pt : Id (C.Ty G) A B) (L K : Ob) (g : Hom L K) (x : V1.Ix (G.ob K)) (y : V1.Ix (G.ob L))
  (e : Id (V1.Ix (G.ob L)) (G.act L K g x) y) (v : V1.Ix (A.1.tob K x))
 : Id (V1.Ix (B.1.tob L y)) (B.1.tact L K g x y e (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) A B Pt v))
     (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob L y)) A B Pt (A.1.tact L K g x y e v)) =
 idJ (C.Ty G) A (\ B2 P2 -> Id (V1.Ix (B2.1.tob L y)) (B2.1.tact L K g x y e (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob K x)) A B2 P2 v))
     (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob L y)) A B2 P2 (A.1.tact L K g x y e v)))
  (refl (A.1.tact L K g x y e v)) B Pt ;

module DNC (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) (r : R.R) {
 module P = CHomT4[a].P3[R, encK, pe, s, t] ;
 module F = P.F ;
 module H = P.H ;
 module CS = H.CS ;
 module CR = P.CR[r] ;
 module NN = F.NC[r].N ;
 module PCc = PresheafPi[a, a+].PPi[PB.BC].PiCode[H.B0.Gh, CS.Wch.1, CS.IdCT.1] ;
 G2 : C.Ctx = CS.GT2.G2 ;
 IG : C.Ty G2 = CS.IdGT ;
 P2 (K : Ob) : U a+ = V1.Ix (G2.ob K) ;
 AS : C.Ty CR.PS.Q3.G1 = C.subT CR.PS.Q3.G1 CR.PS.Q3.G2 (IJ.IdT CR.PS.Q3.G2 CR.PS.Q3.Qw2 CR.PS.Q3.v1 CR.PS.Q3.v2) CR.PS.rho ;
 AT : C.Ty CR.PT.Q3.G1 = C.subT CR.PT.Q3.G1 CR.PT.Q3.G2 (IJ.IdT CR.PT.Q3.G2 CR.PT.Q3.Qw2 CR.PT.Q3.v1 CR.PT.Q3.v2) CR.PT.rho ;
 tactSrc (K L : Ob) (g : Hom L K) (x0' x0 : P2 K) (q : Id (P2 K) x0' x0) (X : V1.Ix (IG.1.tob K x0')) (y : P2 L)
   (e : Id (P2 L) (G2.act L K g x0) y) (e' : Id (P2 L) (G2.act L K g x0') y)
  : Id (V1.Ix (IG.1.tob L y)) (IG.1.tact L K g x0 y e (subst (P2 K) (\ v -> V1.Ix (IG.1.tob K v)) x0' x0 q X)) (IG.1.tact L K g x0' y e' X) =
  idJ (P2 K) x0' (\ x1 q1 -> (e1 : Id (P2 L) (G2.act L K g x1) y) -> Id (V1.Ix (IG.1.tob L y)) (IG.1.tact L K g x1 y e1 (subst (P2 K) (\ v -> V1.Ix (IG.1.tob K v)) x0' x1 q1 X)) (IG.1.tact L K g x0' y e' X))
   (\ e1 -> LP.tact-irr G2 IG.1 L K g x0' y e1 e' X) x0 q e ;
 substTr (L : Ob) (x y z : P2 L) (p : Id (P2 L) x y) (q : Id (P2 L) y z) (u : V1.Ix (IG.1.tob L x))
  : Id (V1.Ix (IG.1.tob L z)) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x z (transH p q) u) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y z q (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)) =
  idJ (P2 L) y (\ z2 q2 -> Id (V1.Ix (IG.1.tob L z2)) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x z2 (transH p q2) u) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) y z2 q2 (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)))
   (refl (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) x y p u)) z q ;
 module DN (I : Ob) (z : P.Z I) (K L : Ob) (f : Hom K I) (g : Hom L K) (u : F.S.QK K)
   (e : NN.EqT K L g (P.ph I z K f u) (P.ph I z L (compH L K I f g) (F.S.rs K L g u))) (p : V1.Ix (NN.FS K u)) {
  ph : F.Fam I = P.ph I z ;
  x : V1.Ix (H.B0.Gh.ob I) = (tt, z.1) ;
  phi : PCc.FunT I (PCc.ptOf I x) = z.2.2.2.1 ;
  fg : Hom L I = compH L K I f g ;
  cT (K2 : Ob) : F.T.QK K2 = (P.HP.Alg[t].AX.cls (cst r)).eob K2 tt ;
  pS' : V1.Ix (AS.1.tob K (tt, u)) = subst (C.Ty CR.PS.Q3.G1) (CR.tyS K u) CR.PS.CT.IdCst AS (symH CR.PS.IdP) p ;
  wq0 : V1.Ix (CS.Wc.1.tob K tt) = (r, (u, pS')) ;
  Y0 : V1.Ix (IG.1.tob K ((tt, cT K), ph K (compH K K I f (idH K)) u)) = phi K f wq0 ;
  x0' : P2 K = ((tt, cT K), ph K (compH K K I f (idH K)) u) ;
  x0 : P2 K = ((tt, cT K), ph K f u) ;
  qA : Id (P2 K) x0' x0 = ap (Hom K I) (P2 K) (\ k -> ((tt, cT K), ph K k u)) (compH K K I f (idH K)) f (comp-idr K I f) ;
  y2 : P2 L = ((tt, cT L), ph L fg (F.S.rs K L g u)) ;
  eA : Id (P2 L) (G2.act L K g x0) y2 = LP.ntEq CR.PT.Q3.G1 CR.PT.Q3.G2 CR.PT.rho L K g (tt, ph K f u) (tt, ph L fg (F.S.rs K L g u)) e ;
  aw : V1.Ix (CS.Wc.1.tob L tt) = PCc.AactOf I (PCc.ptOf I x) (PCc.cOf I x) K L f g wq0 ;
  sigL (wq : V1.Ix (CS.Wc.1.tob L tt)) : P2 L = CS.rTN L (CS.sTN L (PCc.ptOf I x L fg, wq)) ;
  yB : P2 L = sigL aw ;
  eB : Id (P2 L) (G2.act L K g x0') yB =
   LP.ntEq CS.GPT G2 CS.rT L K g (CS.sTN K (PCc.ptOf I x K f, wq0)) (CS.sTN L (PCc.ptOf I x L fg, aw))
    (LP.ntEq CS.Dc CS.GPT CS.sT L K g (PCc.ptOf I x K f, wq0) (PCc.ptOf I x L fg, aw) (PCc.eOf I x K L f g wq0)) ;
  nat : Id (V1.Ix (IG.1.tob L yB)) (IG.1.tact L K g x0' yB eB Y0) (phi L fg aw) = z.2.2.2.2 K L f g wq0 ;
  wR : V1.Ix (CS.Wc.1.tob L tt) = CS.Wc.1.tact L K g tt tt (refl tt) wq0 ;
  rsu : F.S.QK L = F.S.rs K L g u ;
  pa : V1.Ix (CS.GPS.ob K) = ((tt, r), u) ;
  pb : V1.Ix (CS.GPS.ob L) = ((tt, r), rsu) ;
  p1 : V1.Ix (AS.1.tob L (tt, rsu)) = subst (C.Ty CR.PS.Q3.G1) (CR.tyS L rsu) CR.PS.CT.IdCst AS (symH CR.PS.IdP) (NN.acS K L g u p) ;
  wq1 : V1.Ix (CS.Wc.1.tob L tt) = (r, (rsu, p1)) ;
  pX : Id (V1.Ix (AS.1.tob L (tt, rsu))) (CS.IdCSt.1.tact L K g pa pb (refl pb) pS') p1 =
   transH (LP.tact-irr CS.GS2.G2 CS.IdGS.1 L K g (CS.rSN K pa) (CS.rSN L pb) (LP.ntEq CS.GPS CS.GS2.G2 CS.rS L K g pa pb (refl pb))
             (LP.ntEq CR.PS.Q3.G1 CR.PS.Q3.G2 CR.PS.rho L K g (tt, u) (tt, rsu) (refl (tt, rsu))) pS')
    (tyTr CR.PS.Q3.G1 CR.PS.CT.IdCst AS (symH CR.PS.IdP) L K g (tt, u) (tt, rsu) (refl (tt, rsu)) p) ;
  piw : Id (V1.Ix (CS.Wc.1.tob L tt)) aw wq1 =
   transH (LP.tact-irr C.nil CS.Wc.1 L K g tt tt (LP.ntEq H.B0.Gh C.nil H.B0.pG L K g (PCc.ptOf I x K f) (PCc.ptOf I x L fg) (PCc.cOf I x K L f g)) (refl tt) wq0)
    (apH {V1.Ix (AS.1.tob L (tt, rsu))} {V1.Ix (CS.Wc.1.tob L tt)} (\ q -> (r, (rsu, q))) pX) ;
  pip : Id (P2 L) yB (sigL wq1) = ap (V1.Ix (CS.Wc.1.tob L tt)) (P2 L) sigL aw wq1 piw ;
  qD : Id (P2 L) (sigL wq1) y2 = ap (Hom L I) (P2 L) (\ k -> ((tt, cT L), ph L k rsu)) (compH L L I fg (idH L)) fg (comp-idr L I fg) ;
  qC : Id (P2 L) yB y2 = transH pip qD ;
  X1' : V1.Ix (IG.1.tob L yB) = phi L fg aw ;
  X1 : V1.Ix (IG.1.tob L (sigL wq1)) = phi L fg wq1 ;
  Wk : V1.Ix (IG.1.tob K x0) = subst (Hom K I) (\ k -> V1.Ix (IG.1.tob K ((tt, cT K), ph K k u))) (compH K K I f (idH K)) f (comp-idr K I f) Y0 ;
  Wl : V1.Ix (IG.1.tob L y2) = subst (Hom L I) (\ k -> V1.Ix (IG.1.tob L ((tt, cT L), ph L k rsu))) (compH L L I fg (idH L)) fg (comp-idr L I fg) X1 ;
  T2 : U a+ = V1.Ix (IG.1.tob L y2) ;
  s1 : Id T2 (IG.1.tact L K g x0 y2 eA Wk) (IG.1.tact L K g x0 y2 eA (subst (P2 K) (\ v -> V1.Ix (IG.1.tob K v)) x0' x0 qA Y0)) =
   apH {V1.Ix (IG.1.tob K x0)} {T2} (\ w -> IG.1.tact L K g x0 y2 eA w)
    (subst-ap (Hom K I) (P2 K) (\ k -> ((tt, cT K), ph K k u)) (\ v -> V1.Ix (IG.1.tob K v)) (compH K K I f (idH K)) f (comp-idr K I f) Y0) ;
  s2 : Id T2 (IG.1.tact L K g x0 y2 eA (subst (P2 K) (\ v -> V1.Ix (IG.1.tob K v)) x0' x0 qA Y0)) (IG.1.tact L K g x0' y2 (transH eB qC) Y0) =
   tactSrc K L g x0' x0 qA Y0 y2 eA (transH eB qC) ;
  s3 : Id T2 (IG.1.tact L K g x0' y2 (transH eB qC) Y0) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) yB y2 qC (IG.1.tact L K g x0' yB eB Y0)) =
   CMorX[a].tactTr G2 IG L K g x0' yB y2 eB qC Y0 ;
  s4 : Id T2 (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) yB y2 qC (IG.1.tact L K g x0' yB eB Y0)) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) yB y2 qC X1') =
   apH {V1.Ix (IG.1.tob L yB)} {T2} (\ w -> subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) yB y2 qC w) nat ;
  s5 : Id T2 (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) yB y2 qC X1') (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) (sigL wq1) y2 qD (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) yB (sigL wq1) pip X1')) =
   substTr L yB (sigL wq1) y2 pip qD X1' ;
  s6 : Id (V1.Ix (IG.1.tob L (sigL wq1))) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) yB (sigL wq1) pip X1') X1 =
   transH (symH (subst-ap (V1.Ix (CS.Wc.1.tob L tt)) (P2 L) sigL (\ v -> V1.Ix (IG.1.tob L v)) aw wq1 piw X1'))
    (CMorX[a].apdS (V1.Ix (CS.Wc.1.tob L tt)) (\ wq -> V1.Ix (IG.1.tob L (sigL wq))) (\ wq -> phi L fg wq) aw wq1 piw) ;
  s7 : Id T2 (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) (sigL wq1) y2 qD (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) yB (sigL wq1) pip X1')) (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) (sigL wq1) y2 qD X1) =
   apH {V1.Ix (IG.1.tob L (sigL wq1))} {T2} (\ w -> subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) (sigL wq1) y2 qD w) s6 ;
  s8 : Id T2 (subst (P2 L) (\ v -> V1.Ix (IG.1.tob L v)) (sigL wq1) y2 qD X1) Wl =
   symH (subst-ap (Hom L I) (P2 L) (\ k -> ((tt, cT L), ph L k rsu)) (\ v -> V1.Ix (IG.1.tob L v)) (compH L L I fg (idH L)) fg (comp-idr L I fg) X1) ;
  chain : Id T2 (IG.1.tact L K g x0 y2 eA Wk) Wl = transH s1 (transH s2 (transH s3 (transH s4 (transH s5 (transH s7 s8))))) ;
  law : Id (V1.Ix (NN.FT L (ph L fg rsu))) (NN.acT K L g (ph K f u) (ph L fg rsu) e (CR.dc I z K f u p)) (CR.dc I z L fg rsu (NN.acS K L g u p)) =
   transH (tyTr CR.PT.Q3.G1 AT CR.PT.CT.IdCst CR.PT.IdP L K g (tt, ph K f u) (tt, ph L fg rsu) e Wk)
    (apH {T2} {V1.Ix (NN.FT L (ph L fg rsu))} (\ w -> subst (C.Ty CR.PT.Q3.G1) (\ T -> V1.Ix (T.1.tob L (tt, ph L fg rsu))) AT CR.PT.CT.IdCst CR.PT.IdP w) chain) ;
 } ;
 dN (I : Ob) (z : P.Z I) : NN.DN I (P.ph I z) (CR.dc I z) = \ K L f g u e p -> DN[I, z, K, L, f, g, u, e, p].law ;
} ;
