-- CPshR.seg (canonicity-45; COBAR.md): the right adjoint R of
-- U : PSh(C) -> PSh(C0), and Lemma 9 (jonas.pdf) for trivial fibrancy.
--
--   (R G)_x = the product over (y , f : y -> x) of G_y, on contexts (Rctx)
--   and types (Rty); the base action is pointwise, the C-action along
--   g : x' -> x is reindexing u_(y , f) := u_(y , g f).
--   prE y f      the projection of totals of R A at x onto those of A_y
--   tot-ext      a total of R A is determined by its projections (eta)
--   projside     a side of R A, projected at (y , f)
--   lemma9       a levelwise ContrOp of the components gives a ContrOp of
--                R A at every x, uniform in C (UTriv): fill componentwise
-- Informal proof of lemma9.  Extend a side of R A at x componentwise:
-- (y , f) |-> alpha_y applied to the projected side.  kside and kunif hold
-- componentwise (alpha's), and uniformity in C holds because the C-action
-- of R is reindexing: the projection at (y , f) of the moved side is the
-- projection at (y , g f) of the side.  Sides with the same sieve and
-- values are equal (side-ext), which absorbs the proofs.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;
module VL = VLift[a, l] ;

module RR (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 CO : U a = P.CO ;
 CH (y x : CO) : U a = P.CH y x ;

 -- families over C0 (the image of U)
 Fam : U l+ = CO -> PCtx ;
 TFam (G : Fam) : U l+ = (y : CO) -> PTy[G y] ;

 -- products over (y , f : y -> x)
 piC (B : CO -> W0.V) : W0.V = VL.PiS CO (VL.encIx C.obV) (VL.encIx-inj C.obV) B ;
 piCH (y x : CO) (B : CH y x -> W0.V) : W0.V = VL.PiS (CH y x) (VL.encIx (C.homV y x)) (VL.encIx-inj (C.homV y x)) B ;
 Prod (x : CO) (B : (y : CO) -> CH y x -> W0.V) : W0.V = piC (\ y -> piCH y x (B y)) ;

 funext2 (x : CO) (Q : (y : CO) -> CH y x -> U l) (u v : (y : CO) (f : CH y x) -> Q y f)
  (h : (y : CO) (f : CH y x) -> Id (Q y f) (u y f) (v y f)) : Id ((y : CO) (f : CH y x) -> Q y f) u v =
  funext CO (\ y -> (f : CH y x) -> Q y f) u v (\ y -> funext (CH y x) (\ f -> Q y f) (u y) (v y) (h y)) ;

 ------------------------------------------------------------------
 -- R on contexts

 module RC (G : Fam) {
  obR (x : CO) : PCtx =
   new PCtx[\ X -> Prod x (\ y f -> (G y).ob X),
            \ Y X h u -> \ y f -> (G y).act Y X h (u y f),
            \ X u -> funext2 x (\ y f -> W0.Ix ((G y).ob X)) (\ y f -> (G y).act X X (idH X) (u y f)) u
                       (\ y f -> (G y).act-id X (u y f)),
            \ Z Y X h k u -> funext2 x (\ y f -> W0.Ix ((G y).ob Z))
                       (\ y f -> (G y).act Z X (compH Z Y X h k) (u y f)) (\ y f -> (G y).act Z Y k ((G y).act Y X h (u y f)))
                       (\ y f -> (G y).act-o Z Y X h k (u y f))] ;
  -- reindexing along a family of maps
  rix (x' x : CO) (kk : (y : CO) -> CH y x' -> CH y x) (X : Ob) (u : W0.Ix ((obR x).ob X)) : W0.Ix ((obR x').ob X) =
   \ y f -> u y (kk y f) ;
  actR (x' x : CO) (g : CH x' x) : PSub[obR x, obR x'] =
   new PSub[obR x, obR x', \ X u -> rix x' x (\ y f -> P.co y x' x g f) X u, \ Y X h u -> refl (\ y f -> (G y).act Y X h (u y (P.co y x' x g f)))] ;
  Rctx : P.CCtx =
   new P.CCtx[obR, actR,
    \ x X u -> apH (\ kk -> rix x x kk X u)
                 (funext2 x (\ y f -> CH y x) (\ y f -> P.co y x x (P.cid x) f) (\ y f -> f) (\ y f -> P.co-idl y x f)),
    \ z y x f h X u -> apH (\ kk -> rix z x kk X u)
                 (funext2 z (\ w k -> CH w x) (\ w k -> P.co w z x (P.co z y x f h) k) (\ w k -> P.co w y x f (P.co w z y h k))
                    (\ w k -> P.co-assoc w z y x f h k))] ;
 } ;

 ------------------------------------------------------------------
 -- R on types

 module RT (G : Fam) (A : TFam G) {
  module Rg = RC[G] ;
  tyR (x : CO) : PTy[Rg.obR x] =
   new PTy[Rg.obR x,
    \ X u -> Prod x (\ y f -> (A y).tob X (u y f)),
    \ J I h u v e a -> \ y f -> (A y).tact J I h (u y f) (v y f) (apH (\ w -> w y f) e) (a y f),
    \ I u e a -> funext2 x (\ y f -> W0.Ix ((A y).tob I (u y f)))
                   (\ y f -> (A y).tact I I (idH I) (u y f) (u y f) (apH (\ w -> w y f) e) (a y f)) a
                   (\ y f -> (A y).tact-id I (u y f) (apH (\ w -> w y f) e) (a y f)),
    \ K J I h k u v w e1 e2 e3 a -> funext2 x (\ y f -> W0.Ix ((A y).tob K (w y f)))
                   (\ y f -> (A y).tact K I (compH K J I h k) (u y f) (w y f) (apH (\ z -> z y f) e3) (a y f))
                   (\ y f -> (A y).tact K J k (v y f) (w y f) (apH (\ z -> z y f) e2)
                               ((A y).tact J I h (u y f) (v y f) (apH (\ z -> z y f) e1) (a y f)))
                   (\ y f -> (A y).tact-o K J I h k (u y f) (v y f) (w y f) (apH (\ z -> z y f) e1) (apH (\ z -> z y f) e2)
                               (apH (\ z -> z y f) e3) (a y f))] ;
  -- totals
  TotR (x : CO) (X : Ob) : U l = SigT (Rg.obR x) (tyR x) X ;
  -- reindexing of totals along a family of maps
  rixE (x' x : CO) (kk : (y : CO) -> CH y x' -> CH y x) (X : Ob) (w : TotR x X) : TotR x' X =
   pairE (Rg.obR x') (tyR x') X (\ y f -> w.1 y (kk y f)) (\ y f -> w.2 y (kk y f)) ;
  tER (x' x : CO) (g : CH x' x) : PSub[extP (Rg.obR x) (tyR x), extP (Rg.obR x') (tyR x')] =
   new PSub[extP (Rg.obR x) (tyR x), extP (Rg.obR x') (tyR x'),
    \ X w -> rixE x' x (\ y f -> P.co y x' x g f) X w,
    \ Y X h w -> refl ((extP (Rg.obR x') (tyR x')).act Y X h (rixE x' x (\ y f -> P.co y x' x g f) X w))] ;
  Rty : P.CTy[Rg.Rctx] =
   new P.CTy[Rg.Rctx, tyR, tER,
    \ x' x g X w -> refl (\ y f -> w.1 y (P.co y x' x g f)),
    \ x X w -> apH (\ kk -> rixE x x kk X w)
                 (funext2 x (\ y f -> CH y x) (\ y f -> P.co y x x (P.cid x) f) (\ y f -> f) (\ y f -> P.co-idl y x f)),
    \ z y x f h X w -> apH (\ kk -> rixE z x kk X w)
                 (funext2 z (\ v k -> CH v x) (\ v k -> P.co v z x (P.co z y x f h) k) (\ v k -> P.co v y x f (P.co v z y h k))
                    (\ v k -> P.co-assoc v z y x f h k))] ;

  -- projections of totals, and extensionality
  prE (x : CO) (y : CO) (f : CH y x) (X : Ob) (w : TotR x X) : SigT (G y) (A y) X =
   pairE (G y) (A y) X (w.1 y f) (w.2 y f) ;
  tot-ext (x : CO) (X : Ob) (w w' : TotR x X) (H : (y : CO) (f : CH y x) -> Id (SigT (G y) (A y) X) (prE x y f X w) (prE x y f X w'))
   : Id (TotR x X) w w' =
   apH (\ p -> pairE (Rg.obR x) (tyR x) X (\ y f -> (p y f).1) (\ y f -> (p y f).2))
    (funext2 x (\ y f -> SigT (G y) (A y) X) (\ y f -> prE x y f X w) (\ y f -> prE x y f X w') H) ;

  -- sides, projected
  module PR (x : CO) (y : CO) (f : CH y x) {
   module Px = CP.Partials[Rg.obR x, tyR x] ;
   module Py = CP.Partials[G y, A y] ;
   projside (X : Ob) (u : W0.Ix ((Rg.obR x).ob X)) (s : Px.Side[X, u]) : Py.Side[X, u y f] =
    new Py.Side[X, u y f, s.pQ, \ W h i -> prE x y f W (s.pv W h i),
     \ W h i -> apH (\ v -> v y f) (s.ppt W h i),
     \ W' W chi h i i' -> apH (prE x y f W') (s.pnat W' W chi h i i')] ;
  } ;

  ------------------------------------------------------------------
  -- LEMMA 9 (trivial fibrancy)

  module L9 (al : (y : CO) -> CP.ContrOp (G y) (A y)) {
   -- the extension at two sides with the same sieve and values
   kcong (y : CO) (X : Ob) (v : W0.Ix ((G y).ob X)) (s1 s2 : CP.Partials[G y, A y].Side[X, v])
    (eQ : Id (PB.Phi X) s1.pQ s2.pQ) (ev : CP.Partials[G y, A y].PvEq X s1.pQ s2.pQ s1.pv s2.pv)
    : Id (SigT (G y) (A y) X) (pairE (G y) (A y) X v ((al y).kop X v s1)) (pairE (G y) (A y) X v ((al y).kop X v s2)) =
    apH (\ s -> pairE (G y) (A y) X v ((al y).kop X v s)) (CP.Partials[G y, A y].side-ext X v s1 s2 eQ ev) ;

   kop (x : CO) (X : Ob) (u : W0.Ix ((Rg.obR x).ob X)) (s : PR[x,x,P.cid x].Px.Side[X, u]) : W0.Ix ((tyR x).tob X u) =
    \ y f -> (al y).kop X (u y f) (PR[x,y,f].projside X u s) ;

   kside (x : CO) (X : Ob) (u : W0.Ix ((Rg.obR x).ob X)) (s : PR[x,x,P.cid x].Px.Side[X, u]) (W : Ob) (h : Hom W X)
    (i : PB.Lands W X s.pQ h)
    : Id (TotR x W) ((extP (Rg.obR x) (tyR x)).act W X h (pairE (Rg.obR x) (tyR x) X u (kop x X u s))) (s.pv W h i) =
    tot-ext x W _ (s.pv W h i) (\ y f -> (al y).kside X (u y f) (PR[x,y,f].projside X u s) W h i) ;

   kunif (x : CO) (Y X : Ob) (h : Hom Y X) (u : W0.Ix ((Rg.obR x).ob X)) (s : PR[x,x,P.cid x].Px.Side[X, u])
    : Id (TotR x Y) ((extP (Rg.obR x) (tyR x)).act Y X h (pairE (Rg.obR x) (tyR x) X u (kop x X u s)))
       (pairE (Rg.obR x) (tyR x) Y ((Rg.obR x).act Y X h u)
          (kop x Y ((Rg.obR x).act Y X h u) (PR[x,x,P.cid x].Px.rside Y X h u s))) =
    tot-ext x Y _ _ (\ y f ->
     transH ((al y).kunif Y X h (u y f) (PR[x,y,f].projside X u s))
      (kcong y Y ((G y).act Y X h (u y f))
         (CP.Partials[G y, A y].rside Y X h (u y f) (PR[x,y,f].projside X u s))
         (PR[x,y,f].projside Y ((Rg.obR x).act Y X h u) (PR[x,x,P.cid x].Px.rside Y X h u s))
         (refl (PB.pre Y X h s.pQ))
         (\ W g i i' -> apH (prE x y f W) (PR[x,x,P.cid x].Px.pv-irr Y ((Rg.obR x).act Y X h u)
                           (PR[x,x,P.cid x].Px.rside Y X h u s) W g i i')))) ;

   co9 (x : CO) : CP.ContrOp (Rg.obR x) (tyR x) =
    CP.Rel[Rg.obR x, tyR x, tyR x, CP.pmap-id (Rg.obR x) (tyR x)].mkRC (kop x) (kside x) (kunif x) ;

   -- uniformity in C: the C-action of R is reindexing
   unif9 : P.Unif[Rg.Rctx, Rty, Rty, \ x -> CP.pmap-id (Rg.obR x) (tyR x), co9].CUnif =
    \ x' x g X u s -> tot-ext x' X _ _ (\ y f ->
      kcong y X (u y (P.co y x' x g f))
        (PR[x,y,P.co y x' x g f].projside X u s)
        (PR[x',y,f].projside X ((Rg.actR x' x g).nt X u) (P.MapSide[Rg.Rctx, Rty, x', x, g].mapside X u s))
        (refl s.pQ)
        (\ W h i i' -> apH (prE x y (P.co y x' x g f) W) (PR[x,x,P.cid x].Px.pv-irr X u s W h i i'))) ;

   lemma9 : P.UTriv Rg.Rctx Rty = (co9, unif9) ;
  } ;
 } ;
 ------------------------------------------------------------------
 -- E = R U on contexts, and the unit eta : G -> E G

 module EU (G : P.CCtx) {
  module Rg = RC[G.ob] ;
  Ectx : P.CCtx = Rg.Rctx ;
  etaN (x : CO) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) : W0.Ix ((Rg.obR x).ob X) =
   \ y f -> (G.act y x f).nt X g ;
  etaX (x : CO) : PSub[G.ob x, Rg.obR x] =
   new PSub[G.ob x, Rg.obR x, etaN x,
    \ Y X h g -> funext2 x (\ y f -> W0.Ix ((G.ob y).ob Y)) (\ y f -> (G.act y x f).nt Y ((G.ob x).act Y X h g))
                   (\ y f -> (G.ob y).act Y X h ((G.act y x f).nt X g)) (\ y f -> (G.act y x f).nt-nat Y X h g)] ;
  eta : P.CSub[G, Ectx] =
   new P.CSub[G, Ectx, etaX,
    \ x' x g X u -> funext2 x' (\ y f -> W0.Ix ((G.ob y).ob X))
                     (\ y f -> (G.act y x' f).nt X ((G.act x' x g).nt X u)) (\ y f -> (G.act y x (P.co y x' x g f)).nt X u)
                     (\ y f -> symH (G.act-o y x' x g f X u))] ;
 } ;
} ;
