-- CPshDesc.seg (canonicity-45; COBAR.md "Plan: Theorem 29", M4 / M5 /
-- M7): D-bar on maps of types, and the first descent condition.
--   Dm G A B f   D-bar f := (D f)[tau_G], CPshMapSub of Prop13U.DfOf
--   D1[G, A, c].res   D-bar tau_A is an equivalence (UTriv of its homotopy
--                fibres over G.D-bar D-bar A): Corollary 15 in its uniform
--                form (Cor15.cor15U, over D G) pulled back along tau_G
--                (CPshEqSub)
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;

module DescOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module DT = CPshDT[a, l].DTOf[C] ;
 module MSB = CPshMapSub[a, l].MapSubOf[C] ;
 module EQS = CPshEqSub[a, l].EqSubOf[C] ;
 open P ;

 -- D-bar on maps of types
 Dm (G : CCtx) (A B : CTy[G]) (f : P13.CMap[G, A, B]) : P13.CMap[G, DT.Dbar G A, DT.Dbar G B] =
  MSB.subCMap G DD.DC[G].DCtx DD.DC[G].tau DD.DT[G, A].DCTy DD.DT[G, B].DCTy (Prop13U[a, l].DfOf[C, G, A, B, f].DfC) ;

 -- desc1: D-bar tau_A is an equivalence, for A uniformly fibrant
 module D1 (G : CCtx) (A : CTy[G]) (c : UF.Cl G A) {
  module C15 = Cor15[a, l].C15[C, G, A] ;
  module M = C15.Main[c.1] ;
  -- Corollary 15, uniform, over D G
  utD : UTriv M.PU.HPD.GB M.PU.HPD.PC = (M.PM.prop13, M.cor15U) ;
  res : UTriv (LO.ExtC G (DT.Dbar G (DT.Dbar G A))) (P13.HP[G, DT.Dbar G A, DT.Dbar G (DT.Dbar G A), Dm G A (DT.Dbar G A) (DT.eta G A)].PC) =
   EQS.ES[G, DD.DC[G].DCtx, DD.DC[G].tau, DD.DT[G, A].DCTy, DD.DT[G, C15.DAC].DCTy, Prop13U[a, l].DfOf[C, G, A, C15.DAC, C15.tauA].DfC, utD].res ;
 } ;
 desc1 (G : CCtx) (A : CTy[G]) (c : UF.Cl G A)
  : UTriv (LO.ExtC G (DT.Dbar G (DT.Dbar G A))) (P13.HP[G, DT.Dbar G A, DT.Dbar G (DT.Dbar G A), Dm G A (DT.Dbar G A) (DT.eta G A)].PC) =
  D1[G, A, c].res ;
} ;
