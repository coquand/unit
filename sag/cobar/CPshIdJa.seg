-- CPshIdJa.seg (canonicity-45; (B) stage 2(b), COBAR.md): the Id of the
-- CwF of fibrant C-types as the IdT of CwFId.SwanId, its derived context
-- and centre (SwanId.Der), and their comparison at each x with the base's
-- (FibIdCen.DR): the derived context is the base's on the nose (dxEq),
-- the centre is the base's as a presheaf map (cenEqC: both are the
-- extension by refl, and the two refl elements are rflY transported along
-- equal paths of types, FibIdRd.elTr with one path of codes).
--   IdTS, IdT-natS, rflS   the IdT / IdT-nat / rfl of the instance
--   DRC = SW2.Der[..]       Dx, cen, upS, ... of the C-level record
--   DRB = FibIdCen.DR       the same for the base at each x
--   cenEqC x : (DRC.cen G A a).sb x = DRB.cen (G.ob x) A_x a_x

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module FBC = FibCwF[a, l] ;
module FIC = FibIdCen[a, l] ;
module RD = FibIdRd[a, l] ;

module IdJaOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module IdM = CPshId[a, l].IdOf[C] ;
 module IFm = CPshIdFib[a, l].IdFibOf[C] ;
 open P ;

 module SW2 = CwFId.SwanId[l+, UF.CFibCwF] ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;

 IdTS (G : CCtx) (A : STy G) (a0 b0 : CEl[G, A.1]) : STy G = (IdM.IdC[G, A.1, a0, b0].IdT, IFm.idCl G A a0 b0) ;
 IdT-natS (D G : CCtx) (A : STy G) (a0 b0 : CEl[G, A.1]) (s : CSub[D, G])
  : Id (STy D) (UF.FCC.subS D G (IdTS G A a0 b0) s)
      (IdTS D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s) (CW.subCEl D G A.1 b0 s)) =
  IFm.INat[D, G, A, a0, b0, s].law ;
 rflS (G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) : CEl[G, (IdTS G A a0 a0).1] = IdM.ReflC[G, A.1, a0].reflC ;

 module DRC = SW2.Der[IdTS, IdT-natS, rflS] ;
 module DRB = FIC.DR ;

 -- the base's structured type at x
 As (G : CCtx) (A : STy G) (x : CO) : FBC.FC.STy (G.ob x) = (A.1.ty x, A.2.1 x) ;

 -- the derived context at x is the base's on the nose
 dxEq (G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (x : CO)
  : Id PCtx ((DRC.Dx G A a0).ob x) (DRB.Dx (G.ob x) (As G A x) (a0.el x)) = refl (DRB.Dx (G.ob x) (As G A x) (a0.el x)) ;
 opaque dxEq ;
} ;
