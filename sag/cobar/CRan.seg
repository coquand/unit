-- CRan.seg (canonicity-c2; SIMPLIFIED.md item 5): the right adjoint R of
-- the restriction of presheaves along a functor F : Cs -> Ds (CRestr), on
-- types: for G a context over Ds and B a type over the restricted context,
-- R B is the type over G whose elements at (X , g) are the families
--     b Y m p e : B(Y , p)     for Y in Cs, m : F Y -> X, p in G(F Y),
--                              e : p = g restricted along m,
-- natural along the maps of Cs.  (The point p with its equation, instead
-- of the restricted point itself, makes the action along k : X' -> X a
-- reindexing m |-> k m with no transport.)
-- Here: the family, its naturality, the code, and equality of elements
-- (famExt: naturality is a proposition; famCong: equal m).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VL = VLift[a, l] ;

module Ran (Cs Ds : SmallCat[a].SmallCat) (F : CChainsF[a].FunOf[Cs, Ds].SFun) {
 module RS = CRestr[a, l].Restr[Cs, Ds, F] ;
 module P0 = RS.P0 ;
 module P1 = RS.P1 ;
 Ob0 : U a = RS.Ob0 ;
 Hom0 (J I : Ob0) : U a = RS.Hom0 J I ;
 Ob1 : U a = RS.Ob1 ;
 Hom1 (J I : Ob1) : U a = RS.Hom1 J I ;
 o (Y : Ob0) : Ob1 = F.onO Y ;
 -- Pi codes over the objects and maps (level a), at level l
 pi0O (Bf : Ob0 -> W0.V) : W0.V = VL.PiS Ob0 (VL.encIx Cs.obV) (VL.encIx-inj Cs.obV) Bf ;
 pi0H (Z Y : Ob0) (Bf : Hom0 Z Y -> W0.V) : W0.V = VL.PiS (Hom0 Z Y) (VL.encIx (Cs.homV Z Y)) (VL.encIx-inj (Cs.homV Z Y)) Bf ;
 pi1H (W X : Ob1) (Bf : Hom1 W X -> W0.V) : W0.V = VL.PiS (Hom1 W X) (VL.encIx (Ds.homV W X)) (VL.encIx-inj (Ds.homV W X)) Bf ;

 module Ty (G : P1.PCtx) (B : P0.PTy[RS.rC G]) {
  Pt (X : Ob1) : U l = W0.Ix (G.ob X) ;
  -- the point of G at F Y along m
  at (X : Ob1) (g : Pt X) (Y : Ob0) (m : Hom1 (o Y) X) : Pt (o Y) = G.act (o Y) X m g ;
  FamV (X : Ob1) (g : Pt X) : W0.V =
   pi0O (\ Y -> pi1H (o Y) X (\ m -> W0.PiV (G.ob (o Y)) (\ p -> W0.PiV (W0.IdV (G.ob (o Y)) p (at X g Y m)) (\ e -> B.tob Y p)))) ;
  Fam (X : Ob1) (g : Pt X) : U l = W0.Ix (FamV X g) ;
  NatV (X : Ob1) (g : Pt X) (b : Fam X g) : W0.V =
   pi0O (\ Z -> pi0O (\ Y -> pi0H Z Y (\ h -> pi1H (o Y) X (\ m ->
    W0.PiV (G.ob (o Y)) (\ p -> W0.PiV (W0.IdV (G.ob (o Y)) p (at X g Y m)) (\ e ->
    W0.PiV (G.ob (o Z)) (\ q -> W0.PiV (W0.IdV (G.ob (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)))) (\ e' ->
    W0.PiV (W0.IdV (G.ob (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q) (\ e'' ->
     W0.IdV (B.tob Z q) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')))))))))) ;
  tobV (X : Ob1) (g : Pt X) : W0.V = W0.SigV (FamV X g) (\ b -> NatV X g b) ;
  T (X : Ob1) (g : Pt X) : U l = W0.Ix (tobV X g) ;
  -- the components
  fam (X : Ob1) (g : Pt X) (w : T X g) (Y : Ob0) (m : Hom1 (o Y) X) (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m))
   : W0.Ix (B.tob Y p) = w.1 Y m p e ;
  NatTy (X : Ob1) (g : Pt X) (b : Fam X g) : U l =
   (Z Y : Ob0) (h : Hom0 Z Y) (m : Hom1 (o Y) X) (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m))
   (q : Pt (o Z)) (e' : Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h))))
   (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
   -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e') ;
  nat (X : Ob1) (g : Pt X) (w : T X g) : NatTy X g w.1 = w.2 ;
  mk (X : Ob1) (g : Pt X) (b : Fam X g) (n : NatTy X g b) : T X g = (b, n) ;
  -- naturality is a proposition
  natProp (X : Ob1) (g : Pt X) (b : Fam X g) : isProp (NatTy X g b) =
   isProp-Pi Ob0 (\ Z -> (Y : Ob0) (h : Hom0 Z Y) (m : Hom1 (o Y) X) (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m))
      (q : Pt (o Z)) (e' : Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h))))
      (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
      -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ Z ->
   isProp-Pi Ob0 (\ Y -> (h : Hom0 Z Y) (m : Hom1 (o Y) X) (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m))
      (q : Pt (o Z)) (e' : Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h))))
      (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
      -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ Y ->
   isProp-Pi (Hom0 Z Y) (\ h -> (m : Hom1 (o Y) X) (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m))
      (q : Pt (o Z)) (e' : Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h))))
      (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
      -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ h ->
   isProp-Pi (Hom1 (o Y) X) (\ m -> (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m))
      (q : Pt (o Z)) (e' : Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h))))
      (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
      -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ m ->
   isProp-Pi (Pt (o Y)) (\ p -> (e : Id (Pt (o Y)) p (at X g Y m))
      (q : Pt (o Z)) (e' : Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h))))
      (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
      -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ p ->
   isProp-Pi (Id (Pt (o Y)) p (at X g Y m)) (\ e ->
      (q : Pt (o Z)) (e' : Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h))))
      (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
      -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ e ->
   isProp-Pi (Pt (o Z)) (\ q -> (e' : Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h))))
      (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
      -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ q ->
   isProp-Pi (Id (Pt (o Z)) q (at X g Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)))) (\ e' ->
      (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q)
      -> Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ e' ->
   isProp-Pi (Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q) (\ e'' ->
      Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')) (\ e'' ->
   W0.isSetIx (B.tob Z q) (B.tact Z Y h p q e'' (b Y m p e)) (b Z (Ds.oC (o Z) (o Y) X m (F.onH Z Y h)) q e')))))))))) ;
  -- two elements with the same family are equal
  famExt (X : Ob1) (g : Pt X) (w w' : T X g)
   (q : (Y : Ob0) (m : Hom1 (o Y) X) (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m)) -> Id (W0.Ix (B.tob Y p)) (w.1 Y m p e) (w'.1 Y m p e))
   : Id (T X g) w w' =
   Sigma-eq (Fam X g) (\ b -> NatTy X g b) w.1 w'.1 w.2 w'.2
    (funext Ob0 (\ Y -> (m : Hom1 (o Y) X) (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m)) -> W0.Ix (B.tob Y p)) w.1 w'.1 (\ Y ->
     funext (Hom1 (o Y) X) (\ m -> (p : Pt (o Y)) (e : Id (Pt (o Y)) p (at X g Y m)) -> W0.Ix (B.tob Y p)) (w.1 Y) (w'.1 Y) (\ m ->
     funext (Pt (o Y)) (\ p -> (e : Id (Pt (o Y)) p (at X g Y m)) -> W0.Ix (B.tob Y p)) (w.1 Y m) (w'.1 Y m) (\ p ->
     funext (Id (Pt (o Y)) p (at X g Y m)) (\ e -> W0.Ix (B.tob Y p)) (w.1 Y m p) (w'.1 Y m p) (\ e -> q Y m p e)))))
    (natProp X g w'.1) ;
  -- a family at equal maps
  famCong (X : Ob1) (g : Pt X) (b : Fam X g) (Y : Ob0) (m m' : Hom1 (o Y) X) (pm : Id (Hom1 (o Y) X) m m') (p : Pt (o Y))
   (e : Id (Pt (o Y)) p (at X g Y m)) (e' : Id (Pt (o Y)) p (at X g Y m')) : Id (W0.Ix (B.tob Y p)) (b Y m p e) (b Y m' p e') =
   idJ (Hom1 (o Y) X) m (\ m2 p2 -> (e2 : Id (Pt (o Y)) p (at X g Y m2)) -> Id (W0.Ix (B.tob Y p)) (b Y m p e) (b Y m2 p e2))
    (\ e2 -> apH {Id (Pt (o Y)) p (at X g Y m)} {W0.Ix (B.tob Y p)} (\ z -> b Y m p z) (W0.isSetIx (G.ob (o Y)) p (at X g Y m) e e2)) m' pm e' ;

  --------------------------------------------------------------------
  -- the action along k : X' -> X is reindexing m |-> k m
  module Act (X' X : Ob1) (k : Hom1 X' X) (g : Pt X) (g' : Pt X') (eg : Id (Pt X') (G.act X' X k g) g') (w : T X g) {
   ek (Y : Ob0) (m : Hom1 (o Y) X') : Id (Pt (o Y)) (at X' g' Y m) (at X g Y (Ds.oC (o Y) X' X k m)) =
    transH (apH {Pt X'} {Pt (o Y)} (\ z -> G.act (o Y) X' m z) (symH eg)) (symH (G.act-o (o Y) X' X k m g)) ;
   b' : Fam X' g' = \ Y m p e -> w.1 Y (Ds.oC (o Y) X' X k m) p (transH e (ek Y m)) ;
   as (Z Y : Ob0) (h : Hom0 Z Y) (m : Hom1 (o Y) X')
    : Id (Hom1 (o Z) X) (Ds.oC (o Z) (o Y) X (Ds.oC (o Y) X' X k m) (F.onH Z Y h)) (Ds.oC (o Z) X' X k (Ds.oC (o Z) (o Y) X' m (F.onH Z Y h))) =
    Ds.oC-assoc (o Z) (o Y) X' X k m (F.onH Z Y h) ;
   n' : NatTy X' g' b' = \ Z Y h m p e q e' e'' ->
    transH (w.2 Z Y h (Ds.oC (o Y) X' X k m) p (transH e (ek Y m)) q
              (transH (transH e' (ek Z (Ds.oC (o Z) (o Y) X' m (F.onH Z Y h))))
                 (apH {Hom1 (o Z) X} {Pt (o Z)} (\ mm -> G.act (o Z) X mm g) (symH (as Z Y h m)))) e'')
     (famCong X g w.1 Z (Ds.oC (o Z) (o Y) X (Ds.oC (o Y) X' X k m) (F.onH Z Y h)) (Ds.oC (o Z) X' X k (Ds.oC (o Z) (o Y) X' m (F.onH Z Y h)))
        (as Z Y h m) q
        (transH (transH e' (ek Z (Ds.oC (o Z) (o Y) X' m (F.onH Z Y h))))
           (apH {Hom1 (o Z) X} {Pt (o Z)} (\ mm -> G.act (o Z) X mm g) (symH (as Z Y h m))))
        (transH e' (ek Z (Ds.oC (o Z) (o Y) X' m (F.onH Z Y h))))) ;
   res : T X' g' = mk X' g' b' n' ;
  } ;

  -- R B as a type over G
  RB : P1.PTy[G] =
   new P1.PTy[G, tobV, \ J I f x y e w -> Act[J, I, f, x, y, e, w].res,
    \ I x e w -> famExt I x Act[I, I, Ds.idC I, x, x, e, w].res w (\ Y m p e2 ->
       famCong I x w.1 Y (Ds.oC (o Y) I I (Ds.idC I) m) m (Ds.oC-idl (o Y) I m) p
         (transH e2 (Act[I, I, Ds.idC I, x, x, e, w].ek Y m)) e2),
    \ K J I f g x y z e1 e2 e3 w ->
      famExt K z Act[K, I, Ds.oC K J I f g, x, z, e3, w].res Act[K, J, g, y, z, e2, Act[J, I, f, x, y, e1, w].res].res (\ Y m p e ->
       famCong I x w.1 Y (Ds.oC (o Y) K I (Ds.oC K J I f g) m) (Ds.oC (o Y) J I f (Ds.oC (o Y) K J g m))
         (Ds.oC-assoc (o Y) K J I f g m) p
         (transH e (Act[K, I, Ds.oC K J I f g, x, z, e3, w].ek Y m))
         (transH (transH e (Act[K, J, g, y, z, e2, Act[J, I, f, x, y, e1, w].res].ek Y m))
            (Act[J, I, f, x, y, e1, w].ek Y (Ds.oC (o Y) K J g m))))] ;

  --------------------------------------------------------------------
  -- the adjunction on elements: El(rC G , B) = El(G , R B)
  toR (t : P0.PEl[RS.rC G, B]) : P1.PEl[G, RB] =
   P1.mkPEl G RB
    (\ X g -> mk X g (\ Y m p e -> t.eob Y p) (\ Z Y h m p e q e' e'' -> t.enat Z Y h p q e''))
    (\ J I f x y e -> famExt J y _ _ (\ Y m p e2 -> refl (t.eob Y p))) ;

  module OfR (s : P1.PEl[G, RB]) {
   e0 (Y : Ob0) (p : Pt (o Y)) : Id (Pt (o Y)) p (at (o Y) p Y (Ds.idC (o Y))) = symH (G.act-id (o Y) p) ;
   ev (Y : Ob0) (p : Pt (o Y)) : W0.Ix (B.tob Y p) = (s.eob (o Y) p).1 Y (Ds.idC (o Y)) p (e0 Y p) ;
   module N (Z Y : Ob0) (h : Hom0 Z Y) (p : Pt (o Y)) (q : Pt (o Z)) (e'' : Id (Pt (o Z)) (G.act (o Z) (o Y) (F.onH Z Y h) p) q) {
    m1 : Hom1 (o Z) (o Y) = Ds.oC (o Z) (o Y) (o Y) (Ds.idC (o Y)) (F.onH Z Y h) ;
    m2 : Hom1 (o Z) (o Y) = Ds.oC (o Z) (o Z) (o Y) (F.onH Z Y h) (Ds.idC (o Z)) ;
    pm : Id (Hom1 (o Z) (o Y)) m1 m2 = transH (Ds.oC-idl (o Z) (o Y) (F.onH Z Y h)) (symH (Ds.oC-idr (o Z) (o Y) (F.onH Z Y h))) ;
    E1 : Id (Pt (o Z)) q (at (o Y) p Z m1) =
     transH (symH e'') (apH {Hom1 (o Z) (o Y)} {Pt (o Z)} (\ mm -> G.act (o Z) (o Y) mm p) (symH (Ds.oC-idl (o Z) (o Y) (F.onH Z Y h)))) ;
    module A = Act[o Z, o Y, F.onH Z Y h, p, q, e'', s.eob (o Y) p] ;
    en : Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e'' (ev Y p)) (ev Z q) =
     transH ((s.eob (o Y) p).2 Z Y h (Ds.idC (o Y)) p (e0 Y p) q E1 e'')
      (transH (famCong (o Y) p (s.eob (o Y) p).1 Z m1 m2 pm q E1 (transH (e0 Z q) (A.ek Z (Ds.idC (o Z)))))
         (apH {T (o Z) q} {W0.Ix (B.tob Z q)} (\ w -> w.1 Z (Ds.idC (o Z)) q (e0 Z q)) (s.enat (o Z) (o Y) (F.onH Z Y h) p q e''))) ;
   } ;
   ofR : P0.PEl[RS.rC G, B] = P0.mkPEl (RS.rC G) B ev (\ Z Y h p q e'' -> N[Z, Y, h, p, q, e''].en) ;
  } ;
  ofR (s : P1.PEl[G, RB]) : P0.PEl[RS.rC G, B] = OfR[s].ofR ;

  -- the two round trips
  of-to (t : P0.PEl[RS.rC G, B]) : Id (P0.PEl[RS.rC G, B]) (ofR (toR t)) t =
   P0.el-ext (RS.rC G) B (ofR (toR t)) t (\ Y p -> refl (t.eob Y p)) ;
  to-of (s : P1.PEl[G, RB]) : Id (P1.PEl[G, RB]) (toR (ofR s)) s =
   P1.el-ext G RB (toR (ofR s)) s (\ X g -> famExt X g ((toR (ofR s)).eob X g) (s.eob X g) (\ Y m p e ->
    transH (apH {T (o Y) p} {W0.Ix (B.tob Y p)} (\ w -> w.1 Y (Ds.idC (o Y)) p (OfR[s].e0 Y p))
              (symH (s.enat (o Y) X m g p (symH e))))
     (famCong X g (s.eob X g).1 Y (Ds.oC (o Y) (o Y) X m (Ds.idC (o Y))) m (Ds.oC-idr (o Y) X m) p
        (transH (OfR[s].e0 Y p) (Act[o Y, X, m, g, p, symH e, s.eob X g].ek Y (Ds.idC (o Y)))) e))) ;
 } ;
} ;
