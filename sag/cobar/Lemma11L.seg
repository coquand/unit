-- Lemma11L.seg (canonicity-45; COBAR.md, Lemma 12 fibrancy half, step (c)):
-- lemma11-lines, the map Psi from the lines of (D G , D A) to D of the
-- lines of (G , A), on points and on the strict fibres, natural, with a
-- fibrewise inverse: what CMove.Mv needs to move the trivial fibrancy of
-- D (lines) (lemma12U) to the fillers of D A.
--
-- Part 1: resFace (restriction commutes with faces of weights) and Psi on
-- lines: a line l in (D G)_x at X gives the D-element of lines of G whose
-- line at q = (n , z , c , J , g , i) has values
--   (V , f' , j') |-> (l (V , g f' , j')).1 (n , z , c , V , id , res f' i)
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

-- restriction commutes with the faces of weights
module RF (n : Nat) (J Yv : Ob) (f' : Hom Yv J) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J) {
 vr (jn : Nat) (hj : Tr.IsT (Tr.leb jn (suc n)))
  : (b : Bool) -> (e : Id Bool (eqN jn k) b)
    -> Id (Hom Yv PB.Iv) (PB.compH Yv J PB.Iv (Wt.Face[n, J, k, hk].valB i.1 jn hj b e) f')
                       (Wt.Face[n, Yv, k, hk].valB (Wt.resC n Yv J f' i.1) jn hj b e) = split {
  true -> \ e -> PB.ptH-nat Yv J f' PB.e0 ;
  false -> \ e -> refl (PB.compH Yv J PB.Iv (i.1 (Ar.dg n k jn, Ar.dg-range n k jn hj)) f') } ;
 resFace : Id (Wt.Pn (suc n) Yv) (Wt.Res[suc n, Yv, J, f', Wt.Face[n, J, k, hk].Of[i].face].res) (Wt.Face[n, Yv, k, hk].Of[Wt.Res[n, Yv, J, f', i].res].face) =
  Sigma-eq (Wt.Coords (suc n) Yv) (\ cs -> PB.Lands Yv Yv (Wt.oneS (suc n) Yv cs) (PB.idH Yv))
   (Wt.Res[suc n, Yv, J, f', Wt.Face[n, J, k, hk].Of[i].face].res).1 (Wt.Face[n, Yv, k, hk].Of[Wt.Res[n, Yv, J, f', i].res].face).1
   (Wt.Res[suc n, Yv, J, f', Wt.Face[n, J, k, hk].Of[i].face].res).2 (Wt.Face[n, Yv, k, hk].Of[Wt.Res[n, Yv, J, f', i].res].face).2
   (funext (Ar.Fin (suc (suc n))) (\ j -> Hom Yv PB.Iv)
      (Wt.Res[suc n, Yv, J, f', Wt.Face[n, J, k, hk].Of[i].face].res).1 (Wt.Face[n, Yv, k, hk].Of[Wt.Res[n, Yv, J, f', i].res].face).1
      (\ j -> vr j.1 j.2 (eqN j.1 k) (refl (eqN j.1 k))))
   (PB.isProp-Lands Yv Yv (Wt.oneS (suc n) Yv (Wt.Face[n, Yv, k, hk].Of[Wt.Res[n, Yv, J, f', i].res].face).1) (PB.idH Yv)) ;
} ;

module PsiOf (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module D = DD.DC[G] ;
 module DL = DD.DC[LO.LinC G] ;
 CO : U a = P.CO ;

 resres (n : Nat) (W2 W1 W : Ob) (h : Hom W1 W) (chi : Hom W2 W1) (i : Wt.Pn n W)
  : Id (Wt.Pn n W2) (Wt.Res[n, W2, W1, chi, Wt.Res[n, W1, W, h, i].res].res) (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res) =
  Sigma-eq (Wt.Coords n W2) (\ cs -> PB.Lands W2 W2 (Wt.oneS n W2 cs) (PB.idH W2))
   (Wt.Res[n, W2, W1, chi, Wt.Res[n, W1, W, h, i].res].res).1 (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res).1
   (Wt.Res[n, W2, W1, chi, Wt.Res[n, W1, W, h, i].res].res).2 (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res).2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W2 PB.Iv)
      (Wt.Res[n, W2, W1, chi, Wt.Res[n, W1, W, h, i].res].res).1 (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res).1
      (\ k -> PB.comp-assoc W2 W1 W PB.Iv (i.1 k) h chi))
   (PB.isProp-Lands W2 W2 (Wt.oneS n W2 (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res).1) (PB.idH W2)) ;

 ------------------------------------------------------------------
 -- Psi on lines

 module PL (x : CO) (X : Ob) (ln : W0.Ix (CL.FC[D.obD x].GI.ob X)) {
  -- the value of the line at q, at (W , f' , j')
  val (q : DD.Idx x X) (l : DD.LandsI x X q) (W : Ob) (f' : Hom W q.2.2.2.1) (j' : Hom W PB.Iv) : W0.Ix ((G.ob q.2.1).ob W) =
   (ln.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1
    (q.1, q.2.1, q.2.2.1, W, PB.idH W, (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1) (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2 ;
  lnat (q : DD.Idx x X) (l : DD.LandsI x X q) (V' W : Ob) (g' : Hom V' W) (f' : Hom W q.2.2.2.1) (j' : Hom W PB.Iv)
   : Id (W0.Ix ((G.ob q.2.1).ob V')) ((G.ob q.2.1).act V' W g' (val q l W f' j')) (val q l V' (PB.compH V' W q.2.2.2.1 f' g') (PB.compH V' W PB.Iv j' g')) =
   transH ((ln.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').2.1
             ((q.1, q.2.1, q.2.2.1, W, PB.idH W, (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1), (V', g'))
             (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2)
    (transH (apH (\ k -> (ln.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1
                          (q.1, q.2.1, q.2.2.1, V', k, (Wt.Res[q.1, V', W, g', Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res].res).1)
                          (Wt.Res[q.1, V', W, g', Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res].res).2)
               (transH (PB.comp-idl V' W g') (symH (PB.comp-idr V' W g'))))
      (transH (apH (\ p -> (ln.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1 (q.1, q.2.1, q.2.2.1, V', PB.compH V' V' W g' (PB.idH V'), p.1) p.2)
                 (resres q.1 V' W q.2.2.2.1 f' g' (q.2.2.2.2.2, l)))
        (transH (apH (\ w -> w.1 (q.1, q.2.1, q.2.2.1, V', PB.idH V', (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).1)
                              (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).2)
                   (ln.2 V' W g' (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j'))
          (apH (\ k -> (ln.1 V' k (PB.compH V' W PB.Iv j' g')).1
                         (q.1, q.2.1, q.2.2.1, V', PB.idH V', (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).1)
                         (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).2)
             (PB.comp-assoc V' W q.2.2.2.1 X q.2.2.2.2.1 f' g'))))) ;
  Lq (q : DD.Idx x X) (l : DD.LandsI x X q) : W0.Ix (CL.FC[G.ob q.2.1].ob q.2.2.2.1) =
   (\ W f' j' -> val q l W f' j', \ V' W g' f' j' -> lnat q l V' W g' f' j') ;
  tP : DL.T x X = \ q l -> Lq q l ;
  natP : W0.Ix (DL.natEq x X tP) = \ r l ->
   CL.FC[G.ob r.1.2.1].fam-eq r.2.1 _ _ (\ W f' j' ->
    transH (apH (\ k -> (ln.1 W k j').1
                   (r.1.1, r.1.2.1, r.1.2.2.1, W, PB.idH W, (Wt.Res[r.1.1, W, r.1.2.2.2.1, PB.compH W r.2.1 r.1.2.2.2.1 r.2.2 f', (r.1.2.2.2.2.2, l)].res).1)
                   (Wt.Res[r.1.1, W, r.1.2.2.2.1, PB.compH W r.2.1 r.1.2.2.2.1 r.2.2 f', (r.1.2.2.2.2.2, l)].res).2)
              (symH (PB.comp-assoc W r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2 f')))
     (apH (\ p -> (ln.1 W (PB.compH W r.2.1 X (PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2) f') j').1 (r.1.1, r.1.2.1, r.1.2.2.1, W, PB.idH W, p.1) p.2)
        (symH (resres r.1.1 W r.2.1 r.1.2.2.2.1 r.2.2 f' (r.1.2.2.2.2.2, l))))) ;
  faceP : W0.Ix (DL.faceEq x X tP) = \ r l ->
   CL.FC[G.ob r.2.2.2.1].fam-eq r.2.2.2.2.2.1 _ _ (\ W f' j' ->
    transH (apH (\ p -> (ln.1 W (PB.compH W r.2.2.2.2.2.1 X r.2.2.2.2.2.2.1 f') j').1 (suc r.1, r.2.2.2.1, r.2.2.2.2.1, W, PB.idH W, p.1) p.2)
              (RF[r.1, r.2.2.2.2.2.1, W, f', r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1, (r.2.2.2.2.2.2.2, l)].resFace))
     ((ln.1 W (PB.compH W r.2.2.2.2.2.1 X r.2.2.2.2.2.2.1 f') j').2.2.1
        (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, W, PB.idH W, (Wt.Res[r.1, W, r.2.2.2.2.2.1, f', (r.2.2.2.2.2.2.2, l)].res).1)
        (Wt.Res[r.1, W, r.2.2.2.2.2.1, f', (r.2.2.2.2.2.2.2, l)].res).2)) ;
  topP : W0.Ix (DL.topEq x X tP) = \ r l ->
   CL.FC[G.ob r.2.1].fam-eq r.2.2.2.1 _ _ (\ W f' j' ->
    transH (apH (\ p -> (ln.1 W (PB.compH W r.2.2.2.1 X r.2.2.2.2.1 f') j').1 (suc r.1, r.2.1, r.2.2.1, W, PB.idH W, p.1) p.2)
              (RF[r.1, r.2.2.2.1, W, f', suc r.1, Tr.leb-refl (suc r.1), (r.2.2.2.2.2, l)].resFace))
     ((ln.1 W (PB.compH W r.2.2.2.1 X r.2.2.2.2.1 f') j').2.2.2
        (r.1, r.2.1, r.2.2.1, W, PB.idH W, (Wt.Res[r.1, W, r.2.2.2.1, f', (r.2.2.2.2.2, l)].res).1)
        (Wt.Res[r.1, W, r.2.2.2.1, f', (r.2.2.2.2.2, l)].res).2)) ;
  PsiL : DL.Ob' x X = (tP, natP, faceP, topP) ;
 } ;

 resid (n : Nat) (W : Ob) (i : Wt.Pn n W) : Id (Wt.Pn n W) (Wt.Res[n, W, W, PB.idH W, i].res) i =
  Sigma-eq (Wt.Coords n W) (\ cs -> PB.Lands W W (Wt.oneS n W cs) (PB.idH W))
   (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (Wt.Res[n, W, W, PB.idH W, i].res).2 i.2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W PB.Iv) (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (\ k -> PB.comp-idr W PB.Iv (i.1 k)))
   (PB.isProp-Lands W W (Wt.oneS n W i.1) (PB.idH W)) ;

 ------------------------------------------------------------------
 -- Psi on the points of TVC_e: a line with a point of D A at its end

 module PP (A : P.CTy[G]) (e : PB.IPt) (x : CO) (X : Ob) (ln : W0.Ix (CL.FC[D.obD x].GI.ob X))
  (av : DD.DT[G, A].TOb' x X (ln.1 X (PB.idH X) (PB.ptH X e))) {
  module DA = DD.DT[G, A] ;
  module SFe = LO.SF[G, A, e] ;
  module DV = DD.DC[SFe.TVC] ;
  module Lx = PL[x, X, ln] ;
  u0 : D.Ob' x X = ln.1 X (PB.idH X) (PB.ptH X e) ;
  -- the end of the line at q is the point of u0 at q
  Pq (q : DD.Idx x X) (l : DD.LandsI x X q)
   : Id (W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (u0.1 q l) (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) =
   transH (apH (\ k -> u0.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l) (symH (PB.comp-idr q.2.2.2.1 X q.2.2.2.2.1)))
    (transH (apH (\ w -> w.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l) (ln.2 q.2.2.2.1 X q.2.2.2.2.1 (PB.idH X) (PB.ptH X e)))
      (transH (apH (\ k -> (ln.1 q.2.2.2.1 k (PB.compH q.2.2.2.1 X PB.Iv (PB.ptH X e) q.2.2.2.2.1)).1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
                 (transH (PB.comp-idl q.2.2.2.1 X q.2.2.2.2.1) (symH (PB.comp-idr q.2.2.2.1 X q.2.2.2.2.1))))
        (transH (apH (\ j -> (ln.1 q.2.2.2.1 (PB.compH q.2.2.2.1 q.2.2.2.1 X q.2.2.2.2.1 (PB.idH q.2.2.2.1)) j).1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
                   (PB.ptH-nat q.2.2.2.1 X q.2.2.2.2.1 e))
          (apH (\ p -> (ln.1 q.2.2.2.1 (PB.compH q.2.2.2.1 q.2.2.2.1 X q.2.2.2.2.1 (PB.idH q.2.2.2.1)) (PB.ptH q.2.2.2.1 e)).1
                         (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, p.1) p.2)
             (symH (resid q.1 q.2.2.2.1 (q.2.2.2.2.2, l))))))) ;
  b (q : DD.Idx x X) (l : DD.LandsI x X q) : W0.Ix ((A.ty q.2.1).tob q.2.2.2.1 (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e))) =
   GPR.TyL[G.ob q.2.1, A.ty q.2.1].coeT q.2.2.2.1 (u0.1 q l) (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) (Pq q l) (av.1 q l) ;
  pc (q : DD.Idx x X) (l : DD.LandsI x X q)
   : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) (b q l))
        (DA.prz q.2.1 q.2.2.2.1 (u0.1 q l) (av.1 q l)) =
   symH (GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-coe q.2.2.2.1 (u0.1 q l) (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) (Pq q l) (av.1 q l)) ;
  tPt : DV.T x X = \ q l -> pairE CL.FC[G.ob q.2.1].GI CL.FT[G.ob q.2.1, A.ty q.2.1].Ev[e].Aev q.2.2.2.1 (Lx.Lq q l) (b q l) ;
  natPt : W0.Ix (DV.natEq x X tPt) = \ r l ->
   CL.EndKit[G.ob r.1.2.1, A.ty r.1.2.1, e].tv-eq r.2.1 _ _ (Lx.natP r l)
    (transH (CL.EndKit[G.ob r.1.2.1, A.ty r.1.2.1, e].endE-act r.2.1 r.1.2.2.2.1 r.2.2 (tPt r.1 l))
      (transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pc r.1 l))
        (transH (av.2.1 r l)
          (symH (pc (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2,
                     (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                    (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2))))) ;
  facePt : W0.Ix (DV.faceEq x X tPt) = \ r l ->
   CL.EndKit[G.ob r.2.2.2.1, A.ty r.2.2.2.1, e].tv-eq r.2.2.2.2.2.1 _ _ (Lx.faceP r l)
    (transH (pc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF x X r l).1) (DA.afaceF x X r l).2)
      (transH (av.2.2.1 r l)
        (symH (pc (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)))) ;
  topPt : W0.Ix (DV.topEq x X tPt) = \ r l ->
   CL.EndKit[G.ob r.2.1, A.ty r.2.1, e].tv-eq r.2.2.2.1 _ _ (Lx.topP r l)
    (transH (pc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF x X r l).1) (DA.atopF x X r l).2)
      (transH (av.2.2.2 r l)
        (symH (transH (SFe.AE'.endEv r.2.1 (D.topD x X r).1 (D.topD x X r).2.2 r.2.2.2.1
                         (tPt (r.1, (D.topD x X r).1, (D.topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))
                 (apH ((A.tE r.2.1 (D.topD x X r).1 (D.topD x X r).2.2).nt r.2.2.2.1)
                    (pc (r.1, (D.topD x X r).1, (D.topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l)))))) ;
  PsiPt : DV.Ob' x X = (tPt, natPt, facePt, topPt) ;
 } ;
} ;
