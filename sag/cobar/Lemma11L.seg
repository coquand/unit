-- Lemma11L.seg (canonicity-45; COBAR.md, Lemma 12 fibrancy half, step (c)):
-- lemma11-lines, the map Psi from the lines of (D G , D A) to D of the
-- lines of (G , A), on points and on the strict fibres, natural, with a
-- fibrewise inverse: what CMove.Mv needs to move the trivial fibrancy of
-- D (lines) (lemma12U) to the fillers of D A.
--
-- Part 1 (resFace is Weights.RF): Psi on
-- lines: a line l in (D G)_x at X gives the D-element of lines of G whose
-- line at q = (n , z , c , J , g , i) has values
--   (V , f' , j') |-> (l (V , g f' , j')).1 (n , z , c , V , id , res f' i)
-- Status / plan.  Done: PL.PsiL (lines), PP.PsiPt (points), PN.psi /
-- psi-nat (Mv's s , s-nat), PS (a line of D A over the line gives
-- LA_q , bl , Pend , endq , pthq , PsiSF), MS.mS / mSpt / mSnat.
-- Remaining (iii): mTinj (Psi injective over equal points: a reading of
-- L at q' = (n,z,c,J',g'',i'') is recovered as the value of LA at
-- q* = (n,z,c,J', f g'', i'') at (J', id, j g''), by L's naturality and
-- TB.pc), bk (the converse: L (V , f , j) = (ln (V , f , j) , a) with a at
-- q' the value of LA_(q*) at (J', id, j g''), coerced along ln's
-- naturality; its D-equations from u's anatS / afaceS / atopS read on line
-- values; its line naturality by totD-eq), bkMv; then (d): Fill e of
-- D A = CMove.Mv[..].rc of lemma12U on (TVC_e , SFC_e), Comp by fromFill.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module PsiOf (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module D = DD.DC[G] ;
 module DL = DD.DC[LO.LinC G] ;
 CO : U a = P.CO ;

 resres (n : Nat) (W2 W1 W : Ob) (h : Hom W1 W) (chi : Hom W2 W1) (i : Wt.Pn n W)
  : Id (Wt.Pn n W2) (Wt.Res[n, W2, W1, chi, Wt.Res[n, W1, W, h, i].res].res) (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res) =
  Sigma-eq (Wt.Coords n W2) (\ cs -> PB.Lands W2 W2 (Wt.oneS n W2 cs) (PB.idH W2))
   (Wt.Res[n, W2, W1, chi, Wt.Res[n, W1, W, h, i].res].res).1 (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res).1
   (Wt.Res[n, W2, W1, chi, Wt.Res[n, W1, W, h, i].res].res).2 (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res).2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W2 PB.Iv)
      (Wt.Res[n, W2, W1, chi, Wt.Res[n, W1, W, h, i].res].res).1 (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res).1
      (\ k -> PB.comp-assoc W2 W1 W PB.Iv (i.1 k) h chi))
   (PB.isProp-Lands W2 W2 (Wt.oneS n W2 (Wt.Res[n, W2, W, PB.compH W2 W1 W h chi, i].res).1) (PB.idH W2)) ;

 ------------------------------------------------------------------
 -- Psi on lines

 module PL (x : CO) (X : Ob) (ln : W0.Ix (CL.FC[D.obD x].GI.ob X)) {
  -- the value of the line at q, at (W , f' , j')
  val (q : DD.Idx x X) (l : DD.LandsI x X q) (W : Ob) (f' : Hom W q.2.2.2.1) (j' : Hom W PB.Iv) : W0.Ix ((G.ob q.2.1).ob W) =
   (ln.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1
    (q.1, q.2.1, q.2.2.1, W, PB.idH W, (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1) (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2 ;
  lnat (q : DD.Idx x X) (l : DD.LandsI x X q) (V' W : Ob) (g' : Hom V' W) (f' : Hom W q.2.2.2.1) (j' : Hom W PB.Iv)
   : Id (W0.Ix ((G.ob q.2.1).ob V')) ((G.ob q.2.1).act V' W g' (val q l W f' j')) (val q l V' (PB.compH V' W q.2.2.2.1 f' g') (PB.compH V' W PB.Iv j' g')) =
   transH ((ln.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').2.1
             ((q.1, q.2.1, q.2.2.1, W, PB.idH W, (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1), (V', g'))
             (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2)
    (transH (apH (\ k -> (ln.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1
                          (q.1, q.2.1, q.2.2.1, V', k, (Wt.Res[q.1, V', W, g', Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res].res).1)
                          (Wt.Res[q.1, V', W, g', Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res].res).2)
               (transH (PB.comp-idl V' W g') (symH (PB.comp-idr V' W g'))))
      (transH (apH (\ p -> (ln.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1 (q.1, q.2.1, q.2.2.1, V', PB.compH V' V' W g' (PB.idH V'), p.1) p.2)
                 (resres q.1 V' W q.2.2.2.1 f' g' (q.2.2.2.2.2, l)))
        (transH (apH (\ w -> w.1 (q.1, q.2.1, q.2.2.1, V', PB.idH V', (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).1)
                              (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).2)
                   (ln.2 V' W g' (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j'))
          (apH (\ k -> (ln.1 V' k (PB.compH V' W PB.Iv j' g')).1
                         (q.1, q.2.1, q.2.2.1, V', PB.idH V', (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).1)
                         (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).2)
             (PB.comp-assoc V' W q.2.2.2.1 X q.2.2.2.2.1 f' g'))))) ;
  Lq (q : DD.Idx x X) (l : DD.LandsI x X q) : W0.Ix (CL.FC[G.ob q.2.1].ob q.2.2.2.1) =
   (\ W f' j' -> val q l W f' j', \ V' W g' f' j' -> lnat q l V' W g' f' j') ;
  tP : DL.T x X = \ q l -> Lq q l ;
  natP : W0.Ix (DL.natEq x X tP) = \ r l ->
   CL.FC[G.ob r.1.2.1].fam-eq r.2.1 _ _ (\ W f' j' ->
    transH (apH (\ k -> (ln.1 W k j').1
                   (r.1.1, r.1.2.1, r.1.2.2.1, W, PB.idH W, (Wt.Res[r.1.1, W, r.1.2.2.2.1, PB.compH W r.2.1 r.1.2.2.2.1 r.2.2 f', (r.1.2.2.2.2.2, l)].res).1)
                   (Wt.Res[r.1.1, W, r.1.2.2.2.1, PB.compH W r.2.1 r.1.2.2.2.1 r.2.2 f', (r.1.2.2.2.2.2, l)].res).2)
              (symH (PB.comp-assoc W r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2 f')))
     (apH (\ p -> (ln.1 W (PB.compH W r.2.1 X (PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2) f') j').1 (r.1.1, r.1.2.1, r.1.2.2.1, W, PB.idH W, p.1) p.2)
        (symH (resres r.1.1 W r.2.1 r.1.2.2.2.1 r.2.2 f' (r.1.2.2.2.2.2, l))))) ;
  faceP : W0.Ix (DL.faceEq x X tP) = \ r l ->
   CL.FC[G.ob r.2.2.2.1].fam-eq r.2.2.2.2.2.1 _ _ (\ W f' j' ->
    transH (apH (\ p -> (ln.1 W (PB.compH W r.2.2.2.2.2.1 X r.2.2.2.2.2.2.1 f') j').1 (suc r.1, r.2.2.2.1, r.2.2.2.2.1, W, PB.idH W, p.1) p.2)
              (Wt.RF[r.1, r.2.2.2.2.2.1, W, f', r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1, (r.2.2.2.2.2.2.2, l)].resFace))
     ((ln.1 W (PB.compH W r.2.2.2.2.2.1 X r.2.2.2.2.2.2.1 f') j').2.2.1
        (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, W, PB.idH W, (Wt.Res[r.1, W, r.2.2.2.2.2.1, f', (r.2.2.2.2.2.2.2, l)].res).1)
        (Wt.Res[r.1, W, r.2.2.2.2.2.1, f', (r.2.2.2.2.2.2.2, l)].res).2)) ;
  topP : W0.Ix (DL.topEq x X tP) = \ r l ->
   CL.FC[G.ob r.2.1].fam-eq r.2.2.2.1 _ _ (\ W f' j' ->
    transH (apH (\ p -> (ln.1 W (PB.compH W r.2.2.2.1 X r.2.2.2.2.1 f') j').1 (suc r.1, r.2.1, r.2.2.1, W, PB.idH W, p.1) p.2)
              (Wt.RF[r.1, r.2.2.2.1, W, f', suc r.1, Tr.leb-refl (suc r.1), (r.2.2.2.2.2, l)].resFace))
     ((ln.1 W (PB.compH W r.2.2.2.1 X r.2.2.2.2.1 f') j').2.2.2
        (r.1, r.2.1, r.2.2.1, W, PB.idH W, (Wt.Res[r.1, W, r.2.2.2.1, f', (r.2.2.2.2.2, l)].res).1)
        (Wt.Res[r.1, W, r.2.2.2.1, f', (r.2.2.2.2.2, l)].res).2)) ;
  PsiL : DL.Ob' x X = (tP, natP, faceP, topP) ;
 } ;

 resid (n : Nat) (W : Ob) (i : Wt.Pn n W) : Id (Wt.Pn n W) (Wt.Res[n, W, W, PB.idH W, i].res) i =
  Sigma-eq (Wt.Coords n W) (\ cs -> PB.Lands W W (Wt.oneS n W cs) (PB.idH W))
   (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (Wt.Res[n, W, W, PB.idH W, i].res).2 i.2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W PB.Iv) (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (\ k -> PB.comp-idr W PB.Iv (i.1 k)))
   (PB.isProp-Lands W W (Wt.oneS n W i.1) (PB.idH W)) ;

 ------------------------------------------------------------------
 -- Psi on the points of TVC_e: a line with a point of D A at its end

 module PP (A : P.CTy[G]) (e : PB.IPt) (x : CO) (X : Ob) (ln : W0.Ix (CL.FC[D.obD x].GI.ob X))
  (av : DD.DT[G, A].TOb' x X (ln.1 X (PB.idH X) (PB.ptH X e))) {
  module DA = DD.DT[G, A] ;
  module SFe = LO.SF[G, A, e] ;
  module DV = DD.DC[SFe.TVC] ;
  module Lx = PL[x, X, ln] ;
  u0 : D.Ob' x X = ln.1 X (PB.idH X) (PB.ptH X e) ;
  -- the end of the line at q is the point of u0 at q
  Pq (q : DD.Idx x X) (l : DD.LandsI x X q)
   : Id (W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (u0.1 q l) (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) =
   transH (apH (\ k -> u0.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l) (symH (PB.comp-idr q.2.2.2.1 X q.2.2.2.2.1)))
    (transH (apH (\ w -> w.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l) (ln.2 q.2.2.2.1 X q.2.2.2.2.1 (PB.idH X) (PB.ptH X e)))
      (transH (apH (\ k -> (ln.1 q.2.2.2.1 k (PB.compH q.2.2.2.1 X PB.Iv (PB.ptH X e) q.2.2.2.2.1)).1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
                 (transH (PB.comp-idl q.2.2.2.1 X q.2.2.2.2.1) (symH (PB.comp-idr q.2.2.2.1 X q.2.2.2.2.1))))
        (transH (apH (\ j -> (ln.1 q.2.2.2.1 (PB.compH q.2.2.2.1 q.2.2.2.1 X q.2.2.2.2.1 (PB.idH q.2.2.2.1)) j).1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
                   (PB.ptH-nat q.2.2.2.1 X q.2.2.2.2.1 e))
          (apH (\ p -> (ln.1 q.2.2.2.1 (PB.compH q.2.2.2.1 q.2.2.2.1 X q.2.2.2.2.1 (PB.idH q.2.2.2.1)) (PB.ptH q.2.2.2.1 e)).1
                         (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, p.1) p.2)
             (symH (resid q.1 q.2.2.2.1 (q.2.2.2.2.2, l))))))) ;
  b (q : DD.Idx x X) (l : DD.LandsI x X q) : W0.Ix ((A.ty q.2.1).tob q.2.2.2.1 (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e))) =
   GPR.TyL[G.ob q.2.1, A.ty q.2.1].coeT q.2.2.2.1 (u0.1 q l) (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) (Pq q l) (av.1 q l) ;
  pc (q : DD.Idx x X) (l : DD.LandsI x X q)
   : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) (b q l))
        (DA.prz q.2.1 q.2.2.2.1 (u0.1 q l) (av.1 q l)) =
   symH (GPR.TyL[G.ob q.2.1, A.ty q.2.1].pr-coe q.2.2.2.1 (u0.1 q l) (Lx.val q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) (Pq q l) (av.1 q l)) ;
  tPt : DV.T x X = \ q l -> pairE CL.FC[G.ob q.2.1].GI CL.FT[G.ob q.2.1, A.ty q.2.1].Ev[e].Aev q.2.2.2.1 (Lx.Lq q l) (b q l) ;
  natPt : W0.Ix (DV.natEq x X tPt) = \ r l ->
   CL.EndKit[G.ob r.1.2.1, A.ty r.1.2.1, e].tv-eq r.2.1 _ _ (Lx.natP r l)
    (transH (CL.EndKit[G.ob r.1.2.1, A.ty r.1.2.1, e].endE-act r.2.1 r.1.2.2.2.1 r.2.2 (tPt r.1 l))
      (transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pc r.1 l))
        (transH (av.2.1 r l)
          (symH (pc (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2,
                     (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                    (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2))))) ;
  facePt : W0.Ix (DV.faceEq x X tPt) = \ r l ->
   CL.EndKit[G.ob r.2.2.2.1, A.ty r.2.2.2.1, e].tv-eq r.2.2.2.2.2.1 _ _ (Lx.faceP r l)
    (transH (pc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF x X r l).1) (DA.afaceF x X r l).2)
      (transH (av.2.2.1 r l)
        (symH (pc (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)))) ;
  topPt : W0.Ix (DV.topEq x X tPt) = \ r l ->
   CL.EndKit[G.ob r.2.1, A.ty r.2.1, e].tv-eq r.2.2.2.1 _ _ (Lx.topP r l)
    (transH (pc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF x X r l).1) (DA.atopF x X r l).2)
      (transH (av.2.2.2 r l)
        (symH (transH (SFe.AE'.endEv r.2.1 (D.topD x X r).1 (D.topD x X r).2.2 r.2.2.2.1
                         (tPt (r.1, (D.topD x X r).1, (D.topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l))
                 (apH ((A.tE r.2.1 (D.topD x X r).1 (D.topD x X r).2.2).nt r.2.2.2.1)
                    (pc (r.1, (D.topD x X r).1, (D.topD x X r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l)))))) ;
  PsiPt : DV.Ob' x X = (tPt, natPt, facePt, topPt) ;
 } ;

 ------------------------------------------------------------------
 -- Psi on points is natural in the base

 module PN (A : P.CTy[G]) (e : PB.IPt) (x : CO) {
  module DA = DD.DT[G, A] ;
  module DV = DD.DC[LO.SF[G, A, e].TVC] ;
  -- the points of TVC_e of (D G , D A)
  Pts (W : Ob) : U l = W0.Ix ((extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev).ob W) ;
  psi (W : Ob) (w : Pts W) : DV.Ob' x W = PP[A, e, x, W, w.1, w.2].PsiPt ;
  psi-nat (Vv W : Ob) (g : Hom Vv W) (w : Pts W)
   : Id (DV.Ob' x Vv) (psi Vv ((extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev).act Vv W g w)) (DV.BA[x, Vv, W, g, psi W w].res) =
   DV.ob-eq x Vv _ _ (\ q l ->
    CL.EndKit[G.ob q.2.1, A.ty q.2.1, e].tv-eq q.2.2.2.1 _ _
     (CL.FC[G.ob q.2.1].fam-eq q.2.2.2.1 _ _ (\ W' f' j' ->
        apH (\ k -> (w.1.1 W' k j').1 (q.1, q.2.1, q.2.2.1, W', PB.idH W', (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1)
                                   (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2)
          (symH (PB.comp-assoc W' q.2.2.2.1 Vv W g q.2.2.2.2.1 f'))))
     (transH (PP[A, e, x, Vv, ((extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev).act Vv W g w).1, ((extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev).act Vv W g w).2].pc q l)
       (transH (DA.TB[x, Vv, W, g, PP[A, e, x, W, w.1, w.2].u0, PP[A, e, x, Vv, ((extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev).act Vv W g w).1, ((extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev).act Vv W g w).2].u0,
                      ntEq CL.FC[D.obD x].GI (D.obD x) (CL.FC[D.obD x].ev e) Vv W g w.1 (CL.FC[D.obD x].GI.act Vv W g w.1)
                        (refl (CL.FC[D.obD x].GI.act Vv W g w.1)),
                      w.2].pc q l)
         (symH (PP[A, e, x, W, w.1, w.2].pc (DV.BA[x, Vv, W, g, psi W w].sh q) l))))) ;
 } ;

 ------------------------------------------------------------------
 -- Psi on the strict fibre: a line of D A over the line gives, at each
 -- q, a line of A over the line of Psi

 module PS (A : P.CTy[G]) (e : PB.IPt) (x : CO) (X : Ob) (ln : W0.Ix (CL.FC[D.obD x].GI.ob X))
  (av : DD.DT[G, A].TOb' x X (ln.1 X (PB.idH X) (PB.ptH X e)))
  (L : W0.Ix (CL.FC[extP (D.obD x) (DD.DT[G, A].DTy x)].ob X))
  (eqL : Id (W0.Ix (CL.FC[D.obD x].ob X)) (CL.FT[D.obD x, DD.DT[G, A].DTy x].piL X L) ln)
  (pthL : Id (W0.Ix ((extP CL.FC[D.obD x].GI CL.FT[D.obD x, DD.DT[G, A].DTy x].Ev[e].Aev).ob X))
            (CL.FT[D.obD x, DD.DT[G, A].DTy x].Ev[e].evA.mE X (pairE CL.FC[D.obD x].GI CL.FT[D.obD x, DD.DT[G, A].DTy x].AI X ln (L, eqL)))
            (pairE CL.FC[D.obD x].GI CL.FT[D.obD x, DD.DT[G, A].DTy x].Ev[e].Aev X ln av)) {
  module DA = DD.DT[G, A] ;
  module Lx = PL[x, X, ln] ;
  -- the reading of a total of D A at an index
  rdT (W : Ob) (T : DA.TotD x W) (q : DD.Idx x W) (l : DD.LandsI x W q) : W0.Ix (DA.Ez q.2.1 q.2.2.2.1) =
   DA.prz q.2.1 q.2.2.2.1 (T.1.1 q l) (T.2.1 q l) ;
  valA (q : DD.Idx x X) (l : DD.LandsI x X q) (W : Ob) (f' : Hom W q.2.2.2.1) (j' : Hom W PB.Iv) : W0.Ix (DA.Ez q.2.1 W) =
   rdT W (L.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j')
    (q.1, q.2.1, q.2.2.1, W, PB.idH W, (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1) (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2 ;
  natA (q : DD.Idx x X) (l : DD.LandsI x X q) (V' W : Ob) (g' : Hom V' W) (f' : Hom W q.2.2.2.1) (j' : Hom W PB.Iv)
   : Id (W0.Ix (DA.Ez q.2.1 V')) ((extP (G.ob q.2.1) (A.ty q.2.1)).act V' W g' (valA q l W f' j'))
        (valA q l V' (PB.compH V' W q.2.2.2.1 f' g') (PB.compH V' W PB.Iv j' g')) =
   transH ((L.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').2.2.1
             ((q.1, q.2.1, q.2.2.1, W, PB.idH W, (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1), (V', g'))
             (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2)
    (transH (apH (\ k -> rdT W (L.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j')
                          (q.1, q.2.1, q.2.2.1, V', k, (Wt.Res[q.1, V', W, g', Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res].res).1)
                          (Wt.Res[q.1, V', W, g', Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res].res).2)
               (transH (PB.comp-idl V' W g') (symH (PB.comp-idr V' W g'))))
      (transH (apH (\ p -> rdT W (L.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j') (q.1, q.2.1, q.2.2.1, V', PB.compH V' V' W g' (PB.idH V'), p.1) p.2)
                 (resres q.1 V' W q.2.2.2.1 f' g' (q.2.2.2.2.2, l)))
        (transH (symH (DA.TB[x, V', W, g', (L.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1,
                               D.BA[x, V', W, g', (L.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1].res,
                               refl (D.BA[x, V', W, g', (L.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1].res),
                               (L.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').2].pc
                   (q.1, q.2.1, q.2.2.1, V', PB.idH V', (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).1)
                   (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).2))
          (transH (apH (\ T -> rdT V' T (q.1, q.2.1, q.2.2.1, V', PB.idH V', (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).1)
                                     (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).2)
                     (L.2 V' W g' (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j'))
            (apH (\ k -> rdT V' (L.1 V' k (PB.compH V' W PB.Iv j' g'))
                           (q.1, q.2.1, q.2.2.1, V', PB.idH V', (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).1)
                           (Wt.Res[q.1, V', q.2.2.2.1, PB.compH V' W q.2.2.2.1 f' g', (q.2.2.2.2.2, l)].res).2)
               (PB.comp-assoc V' W q.2.2.2.1 X q.2.2.2.2.1 f' g')))))) ;
  LA (q : DD.Idx x X) (l : DD.LandsI x X q) : W0.Ix (CL.FC[extP (G.ob q.2.1) (A.ty q.2.1)].ob q.2.2.2.1) =
   (\ W f' j' -> valA q l W f' j', \ V' W g' f' j' -> natA q l V' W g' f' j') ;
  piLeq (q : DD.Idx x X) (l : DD.LandsI x X q)
   : Id (W0.Ix (CL.FC[G.ob q.2.1].ob q.2.2.2.1)) (CL.FT[G.ob q.2.1, A.ty q.2.1].piL q.2.2.2.1 (LA q l)) (Lx.Lq q l) =
   CL.FC[G.ob q.2.1].fam-eq q.2.2.2.1 _ _ (\ W f' j' ->
    apH (\ m -> (m.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1
                 (q.1, q.2.1, q.2.2.1, W, PB.idH W, (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1) (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2)
      eqL) ;
  bl (q : DD.Idx x X) (l : DD.LandsI x X q) : W0.Ix (CL.FT[G.ob q.2.1, A.ty q.2.1].AI.tob q.2.2.2.1 (Lx.Lq q l)) = (LA q l, piLeq q l) ;

  module PPx = PP[A, e, x, X, ln, av] ;
  u0 : D.Ob' x X = ln.1 X (PB.idH X) (PB.ptH X e) ;
  -- the line of D A ends at the point av
  Pend : Id (DA.TotD x X) (L.1 X (PB.idH X) (PB.ptH X e)) (pairE (D.obD x) (DA.DTy x) X u0 av) =
   transH (symH (CL.FT[D.obD x, DA.DTy x].Ev[e].endB-E X (pairE CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].AI X ln (L, eqL))))
    (apH (\ b' -> pairE (D.obD x) (DA.DTy x) X u0 b')
       (GPR.TyL[CL.FC[D.obD x].GI, CL.FT[D.obD x, DA.DTy x].Ev[e].Aev].pr-inj X ln
          (CL.FT[D.obD x, DA.DTy x].Ev[e].endB X (pairE CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].AI X ln (L, eqL))) av pthL)) ;
  -- the end of the line of A at q is the reading of av at q
  endq (q : DD.Idx x X) (l : DD.LandsI x X q)
   : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (valA q l q.2.2.2.1 (PB.idH q.2.2.2.1) (PB.ptH q.2.2.2.1 e)) (DA.prz q.2.1 q.2.2.2.1 (u0.1 q l) (av.1 q l)) =
   transH (apH (\ p -> rdT q.2.2.2.1 (L.1 q.2.2.2.1 (PB.compH q.2.2.2.1 q.2.2.2.1 X q.2.2.2.2.1 (PB.idH q.2.2.2.1)) (PB.ptH q.2.2.2.1 e))
                         (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, p.1) p.2)
             (resid q.1 q.2.2.2.1 (q.2.2.2.2.2, l)))
    (transH (apH (\ k -> rdT q.2.2.2.1 (L.1 q.2.2.2.1 k (PB.ptH q.2.2.2.1 e)) (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
               (transH (PB.comp-idr q.2.2.2.1 X q.2.2.2.2.1) (symH (PB.comp-idl q.2.2.2.1 X q.2.2.2.2.1))))
      (transH (apH (\ j -> rdT q.2.2.2.1 (L.1 q.2.2.2.1 (PB.compH q.2.2.2.1 X X (PB.idH X) q.2.2.2.2.1) j) (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
                 (symH (PB.ptH-nat q.2.2.2.1 X q.2.2.2.2.1 e)))
        (transH (apH (\ T -> rdT q.2.2.2.1 T (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
                   (symH (L.2 q.2.2.2.1 X q.2.2.2.2.1 (PB.idH X) (PB.ptH X e))))
          (transH (apH (\ T -> rdT q.2.2.2.1 ((extP (D.obD x) (DA.DTy x)).act q.2.2.2.1 X q.2.2.2.2.1 T) (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
                     Pend)
            (transH (DA.TB[x, q.2.2.2.1, X, q.2.2.2.2.1, u0, D.BA[x, q.2.2.2.1, X, q.2.2.2.2.1, u0].res, refl (D.BA[x, q.2.2.2.1, X, q.2.2.2.2.1, u0].res), av].pc
                       (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.idH q.2.2.2.1, q.2.2.2.2.2) l)
              (apH (\ k -> DA.prz q.2.1 q.2.2.2.1 (u0.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l) (av.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l))
                 (PB.comp-idr q.2.2.2.1 X q.2.2.2.2.1))))))) ;
  -- the line of A ends at the point Psi gives at q
  pthq (q : DD.Idx x X) (l : DD.LandsI x X q)
   : Id (W0.Ix ((extP CL.FC[G.ob q.2.1].GI CL.FT[G.ob q.2.1, A.ty q.2.1].Ev[e].Aev).ob q.2.2.2.1))
        (CL.FT[G.ob q.2.1, A.ty q.2.1].Ev[e].evA.mE q.2.2.2.1 (pairE CL.FC[G.ob q.2.1].GI CL.FT[G.ob q.2.1, A.ty q.2.1].AI q.2.2.2.1 (Lx.Lq q l) (bl q l)))
        (PPx.tPt q l) =
   CL.EndKit[G.ob q.2.1, A.ty q.2.1, e].tv-eq q.2.2.2.1 _ _ (refl (Lx.Lq q l))
    (transH (CL.FT[G.ob q.2.1, A.ty q.2.1].Ev[e].endB-E q.2.2.2.1 (pairE CL.FC[G.ob q.2.1].GI CL.FT[G.ob q.2.1, A.ty q.2.1].AI q.2.2.2.1 (Lx.Lq q l) (bl q l)))
      (transH (endq q l) (symH (PPx.pc q l)))) ;

  -- the D(SF) element over Psi's point
  module DS = DD.DT[LO.SF[G, A, e].TVC, LO.SF[G, A, e].SFC] ;
  tS : DS.TA x X PPx.PsiPt = \ q l -> (bl q l, pthq q l) ;
  anatS : W0.Ix (DS.anatEq x X PPx.PsiPt tS) = \ r l ->
   CL.EndKit[G.ob r.1.2.1, A.ty r.1.2.1, e].ts-ext r.2.1 _ _ (PPx.natPt r l)
    (\ V g j ->
      transH (apH (\ k -> rdT V (L.1 V k j)
                    (r.1.1, r.1.2.1, r.1.2.2.1, V, PB.idH V, (Wt.Res[r.1.1, V, r.1.2.2.2.1, PB.compH V r.2.1 r.1.2.2.2.1 r.2.2 g, (r.1.2.2.2.2.2, l)].res).1)
                    (Wt.Res[r.1.1, V, r.1.2.2.2.1, PB.compH V r.2.1 r.1.2.2.2.1 r.2.2 g, (r.1.2.2.2.2.2, l)].res).2)
                (symH (PB.comp-assoc V r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2 g)))
       (apH (\ p -> rdT V (L.1 V (PB.compH V r.2.1 X (PB.compH r.2.1 r.1.2.2.2.1 X r.1.2.2.2.2.1 r.2.2) g) j) (r.1.1, r.1.2.1, r.1.2.2.1, V, PB.idH V, p.1) p.2)
          (symH (resres r.1.1 V r.2.1 r.1.2.2.2.1 r.2.2 g (r.1.2.2.2.2.2, l))))) ;
  afaceS : W0.Ix (DS.afaceEq x X PPx.PsiPt tS) = \ r l ->
   CL.EndKit[G.ob r.2.2.2.1, A.ty r.2.2.2.1, e].ts-ext r.2.2.2.2.2.1 _ _ (PPx.facePt r l)
    (\ V g j ->
      transH (apH (\ p -> rdT V (L.1 V (PB.compH V r.2.2.2.2.2.1 X r.2.2.2.2.2.2.1 g) j) (suc r.1, r.2.2.2.1, r.2.2.2.2.1, V, PB.idH V, p.1) p.2)
                (Wt.RF[r.1, r.2.2.2.2.2.1, V, g, r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1, (r.2.2.2.2.2.2.2, l)].resFace))
       ((L.1 V (PB.compH V r.2.2.2.2.2.1 X r.2.2.2.2.2.2.1 g) j).2.2.2.1
          (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, V, PB.idH V, (Wt.Res[r.1, V, r.2.2.2.2.2.1, g, (r.2.2.2.2.2.2.2, l)].res).1)
          (Wt.Res[r.1, V, r.2.2.2.2.2.1, g, (r.2.2.2.2.2.2.2, l)].res).2)) ;
  atopS : W0.Ix (DS.atopEq x X PPx.PsiPt tS) = \ r l ->
   CL.EndKit[G.ob r.2.1, A.ty r.2.1, e].ts-ext r.2.2.2.1 _ _ (PPx.topPt r l)
    (\ V g j ->
      transH (apH (\ p -> rdT V (L.1 V (PB.compH V r.2.2.2.1 X r.2.2.2.2.1 g) j) (suc r.1, r.2.1, r.2.2.1, V, PB.idH V, p.1) p.2)
                (Wt.RF[r.1, r.2.2.2.1, V, g, suc r.1, Tr.leb-refl (suc r.1), (r.2.2.2.2.2, l)].resFace))
       ((L.1 V (PB.compH V r.2.2.2.1 X r.2.2.2.2.1 g) j).2.2.2.2
          (r.1, r.2.1, r.2.2.1, V, PB.idH V, (Wt.Res[r.1, V, r.2.2.2.1, g, (r.2.2.2.2.2, l)].res).1)
          (Wt.Res[r.1, V, r.2.2.2.1, g, (r.2.2.2.2.2, l)].res).2)) ;
  PsiSF : DS.TOb' x X PPx.PsiPt = (tS, anatS, afaceS, atopS) ;

  -- a reading of L at (V , f , j) is a value of LA at the composite index
  rec (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) (q' : DD.Idx x V) (l' : DD.LandsI x V q')
   : Id (W0.Ix (DA.Ez q'.2.1 q'.2.2.2.1)) (rdT V (L.1 V f j) q' l')
        (valA (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.compH q'.2.2.2.1 V X f q'.2.2.2.2.1, q'.2.2.2.2.2) l'
           q'.2.2.2.1 (PB.idH q'.2.2.2.1) (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1)) =
   transH (apH (\ k -> rdT V (L.1 V f j) (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, k, q'.2.2.2.2.2) l') (symH (PB.comp-idr q'.2.2.2.1 V q'.2.2.2.2.1)))
    (transH (symH (DA.TB[x, q'.2.2.2.1, V, q'.2.2.2.2.1, (L.1 V f j).1, D.BA[x, q'.2.2.2.1, V, q'.2.2.2.2.1, (L.1 V f j).1].res,
                         refl (D.BA[x, q'.2.2.2.1, V, q'.2.2.2.2.1, (L.1 V f j).1].res), (L.1 V f j).2].pc
                   (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.idH q'.2.2.2.1, q'.2.2.2.2.2) l'))
      (transH (apH (\ T -> rdT q'.2.2.2.1 T (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.idH q'.2.2.2.1, q'.2.2.2.2.2) l') (L.2 q'.2.2.2.1 V q'.2.2.2.2.1 f j))
        (transH (apH (\ k -> rdT q'.2.2.2.1 (L.1 q'.2.2.2.1 k (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1))
                              (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.idH q'.2.2.2.1, q'.2.2.2.2.2) l')
                   (symH (PB.comp-idr q'.2.2.2.1 X (PB.compH q'.2.2.2.1 V X f q'.2.2.2.2.1))))
          (apH (\ p -> rdT q'.2.2.2.1 (L.1 q'.2.2.2.1 (PB.compH q'.2.2.2.1 q'.2.2.2.1 X (PB.compH q'.2.2.2.1 V X f q'.2.2.2.2.1) (PB.idH q'.2.2.2.1))
                                          (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1))
                         (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.idH q'.2.2.2.1, p.1) p.2)
             (symH (resid q'.1 q'.2.2.2.1 (q'.2.2.2.2.2, l'))))))) ;
 } ;

 ------------------------------------------------------------------
 -- Psi on the totals of SF, natural in the base (Mv's mS , mSpt , mSnat)

 module MS (A : P.CTy[G]) (e : PB.IPt) (x : CO) {
  module DA = DD.DT[G, A] ;
  module SFe = LO.SF[G, A, e] ;
  module DV = DD.DC[SFe.TVC] ;
  module DS = DD.DT[SFe.TVC, SFe.SFC] ;
  module PNx = PN[A, e, x] ;
  module SFD = CL.SFib[CL.FC[D.obD x].GI, CL.FT[D.obD x, DA.DTy x].AI, CL.FT[D.obD x, DA.DTy x].Ev[e].Aev, CL.FT[D.obD x, DA.DTy x].Ev[e].evA] ;
  TSD (W : Ob) : U l = SigT (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF W ;
  mS (W : Ob) (v : TSD W) : DS.TotD x W =
   pairE (DV.obD x) (DS.DTy x) W (PNx.psi W v.1) PS[A, e, x, W, v.1.1, v.1.2, v.2.1.1, v.2.1.2, v.2.2].PsiSF ;
  mSpt (W : Ob) (v : TSD W) : Id (DV.Ob' x W) (mS W v).1 (PNx.psi W v.1) = refl (PNx.psi W v.1) ;
  mSnat (Vv W : Ob) (g : Hom Vv W) (v : TSD W)
   : Id (DS.TotD x Vv) ((extP (DV.obD x) (DS.DTy x)).act Vv W g (mS W v)) (mS Vv ((extP (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF).act Vv W g v)) =
   DS.totD-eq x Vv _ _ (symH (PNx.psi-nat Vv W g v.1))
    (\ q l -> transH (DS.TB[x, Vv, W, g, PNx.psi W v.1, DV.BA[x, Vv, W, g, PNx.psi W v.1].res, refl (DV.BA[x, Vv, W, g, PNx.psi W v.1].res),
                            PS[A, e, x, W, v.1.1, v.1.2, v.2.1.1, v.2.1.2, v.2.2].PsiSF].pc q l)
      (CL.EndKit[G.ob q.2.1, A.ty q.2.1, e].ts-ext q.2.2.2.1 _ _
         (symH (apH (\ o -> o.1 q l) (PNx.psi-nat Vv W g v.1)))
         (\ V' g' j -> apH (\ k -> PS[A, e, x, W, v.1.1, v.1.2, v.2.1.1, v.2.1.2, v.2.2].rdT V' (v.2.1.1.1 V' k j)
                                    (q.1, q.2.1, q.2.2.1, V', PB.idH V', (Wt.Res[q.1, V', q.2.2.2.1, g', (q.2.2.2.2.2, l)].res).1)
                                    (Wt.Res[q.1, V', q.2.2.2.1, g', (q.2.2.2.2.2, l)].res).2)
                        (PB.comp-assoc V' q.2.2.2.1 Vv W g q.2.2.2.2.1 g')))) ;

  -- Psi on SF is injective over equal points (Mv's mTinj)
  fib (W : Ob) (w : PNx.Pts W) (s1 s2 : W0.Ix (SFD.SF.tob W w))
   (Q : Id (DS.TotD x W) (mS W (pairE (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF W w s1))
                         (mS W (pairE (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF W w s2)))
   : Id (TSD W) (pairE (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF W w s1)
               (pairE (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF W w s2) =
   apH (\ s3 -> pairE (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF W w s3)
    (SFD.sf-eq W w s1 s2
      (CL.FT[D.obD x, DA.DTy x].tob-eq W w.1 s1.1 s2.1
        (CL.FC[extP (D.obD x) (DA.DTy x)].fam-eq W s1.1.1 s2.1.1 (\ V f j ->
          DA.totD-eq x V (s1.1.1.1 V f j) (s2.1.1.1 V f j)
           (transH (apH (\ m -> m.1 V f j) s1.1.2) (symH (apH (\ m -> m.1 V f j) s2.1.2)))
           (\ q' l' ->
             transH (PS[A, e, x, W, w.1, w.2, s1.1.1, s1.1.2, s1.2].rec V f j q' l')
              (transH (apH (\ T -> ((T.2.1 (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.compH q'.2.2.2.1 V W f q'.2.2.2.2.1, q'.2.2.2.2.2) l').1.1).1
                                     q'.2.2.2.1 (PB.idH q'.2.2.2.1) (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1)) Q)
                (symH (PS[A, e, x, W, w.1, w.2, s2.1.1, s2.1.2, s2.2].rec V f j q' l')))))))) ;
  mTinj (W : Ob) (v v' : TSD W) (P : Id (PNx.Pts W) v.1 v'.1) (Q : Id (DS.TotD x W) (mS W v) (mS W v')) : Id (TSD W) v v' =
   idJ (PNx.Pts W) v.1
    (\ w2 P2 -> (s2 : W0.Ix (SFD.SF.tob W w2))
       -> Id (DS.TotD x W) (mS W v) (mS W (pairE (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF W w2 s2))
       -> Id (TSD W) v (pairE (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF W w2 s2))
    (\ s2 Q2 -> fib W v.1 v.2 s2 Q2) v'.1 P v'.2 Q ;

  -- the fibrewise inverse (Mv's bk): a D(SF) element over Psi's point
  -- gives a line of D A over the line
  module BK (X : Ob) (w : PNx.Pts X) (u : DS.TOb' x X (PNx.psi X w)) {
   module PPw = PP[A, e, x, X, w.1, w.2] ;
   module Lx = PL[x, X, w.1] ;
   -- the value of the line of A at q
   lva (q : DD.Idx x X) (l : DD.LandsI x X q) (W : Ob) (f : Hom W q.2.2.2.1) (j : Hom W PB.Iv) : W0.Ix (DA.Ez q.2.1 W) =
    (u.1 q l).1.1.1 W f j ;
   qs (V : Ob) (f : Hom V X) (q' : DD.Idx x V) : DD.Idx x X =
    (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.compH q'.2.2.2.1 V X f q'.2.2.2.2.1, q'.2.2.2.2.2) ;
   w0 (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) (q' : DD.Idx x V) (l' : DD.LandsI x V q') : W0.Ix (DA.Ez q'.2.1 q'.2.2.2.1) =
    lva (qs V f q') l' q'.2.2.2.1 (PB.idH q'.2.2.2.1) (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1) ;
   -- its point is the point of the line of D G at (V , f , j) , at q'
   P0 (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) (q' : DD.Idx x V) (l' : DD.LandsI x V q')
    : Id (W0.Ix ((G.ob q'.2.1).ob q'.2.2.2.1)) (fstE (G.ob q'.2.1) (A.ty q'.2.1) q'.2.2.2.1 (w0 V f j q' l')) ((w.1.1 V f j).1 q' l') =
    transH (apH (\ m -> m.1 q'.2.2.2.1 (PB.idH q'.2.2.2.1) (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1)) (u.1 (qs V f q') l').1.2)
     (transH (apH (\ p -> (w.1.1 q'.2.2.2.1 (PB.compH q'.2.2.2.1 q'.2.2.2.1 X (PB.compH q'.2.2.2.1 V X f q'.2.2.2.2.1) (PB.idH q'.2.2.2.1))
                              (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1)).1 (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.idH q'.2.2.2.1, p.1) p.2)
                (resid q'.1 q'.2.2.2.1 (q'.2.2.2.2.2, l')))
       (transH (apH (\ k -> (w.1.1 q'.2.2.2.1 k (PB.compH q'.2.2.2.1 V PB.Iv j q'.2.2.2.2.1)).1 (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.idH q'.2.2.2.1, q'.2.2.2.2.2) l')
                  (PB.comp-idr q'.2.2.2.1 X (PB.compH q'.2.2.2.1 V X f q'.2.2.2.2.1)))
         (transH (apH (\ m -> m.1 (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, PB.idH q'.2.2.2.1, q'.2.2.2.2.2) l') (symH (w.1.2 q'.2.2.2.1 V q'.2.2.2.2.1 f j)))
           (apH (\ k -> (w.1.1 V f j).1 (q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, k, q'.2.2.2.2.2) l') (PB.comp-idr q'.2.2.2.1 V q'.2.2.2.2.1))))) ;
   aa (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) : DA.TA x V (w.1.1 V f j) = \ q' l' ->
    GPR.TyL[G.ob q'.2.1, A.ty q'.2.1].coeT q'.2.2.2.1 (fstE (G.ob q'.2.1) (A.ty q'.2.1) q'.2.2.2.1 (w0 V f j q' l')) ((w.1.1 V f j).1 q' l') (P0 V f j q' l')
     (sndE (G.ob q'.2.1) (A.ty q'.2.1) q'.2.2.2.1 (w0 V f j q' l')) ;
   pa (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) (q' : DD.Idx x V) (l' : DD.LandsI x V q')
    : Id (W0.Ix (DA.Ez q'.2.1 q'.2.2.2.1)) (DA.prz q'.2.1 q'.2.2.2.1 ((w.1.1 V f j).1 q' l') (aa V f j q' l')) (w0 V f j q' l') =
    symH (GPR.TyL[G.ob q'.2.1, A.ty q'.2.1].pr-coe q'.2.2.2.1 (fstE (G.ob q'.2.1) (A.ty q'.2.1) q'.2.2.2.1 (w0 V f j q' l')) ((w.1.1 V f j).1 q' l') (P0 V f j q' l')
           (sndE (G.ob q'.2.1) (A.ty q'.2.1) q'.2.2.2.1 (w0 V f j q' l'))) ;
   -- the D-equations of aa, from those of u, read on line values
   aanat (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) : W0.Ix (DA.anatEq x V (w.1.1 V f j) (aa V f j)) = \ r l' ->
    transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pa V f j r.1 l'))
     (transH ((u.1 (qs V f r.1) l').1.1.2 r.2.1 r.1.2.2.2.1 r.2.2 (PB.idH r.1.2.2.2.1) (PB.compH r.1.2.2.2.1 V PB.Iv j r.1.2.2.2.2.1))
       (transH (apH (\ k -> lva (qs V f r.1) l' r.2.1 k (PB.compH r.2.1 r.1.2.2.2.1 PB.Iv (PB.compH r.1.2.2.2.1 V PB.Iv j r.1.2.2.2.2.1) r.2.2))
                  (transH (PB.comp-idl r.2.1 r.1.2.2.2.1 r.2.2) (symH (PB.comp-idr r.2.1 r.1.2.2.2.1 r.2.2))))
         (transH (apH (\ T -> CL.EndKit[G.ob r.1.2.1, A.ty r.1.2.1, e].lv r.2.1 T r.2.1 (PB.idH r.2.1)
                                (PB.compH r.2.1 r.1.2.2.2.1 PB.Iv (PB.compH r.1.2.2.2.1 V PB.Iv j r.1.2.2.2.2.1) r.2.2))
                    (u.2.1 ((qs V f r.1), (r.2.1, r.2.2)) l'))
           (transH (apH (\ k -> lva (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, k, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).1)
                                   (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).2 r.2.1 (PB.idH r.2.1)
                                   (PB.compH r.2.1 r.1.2.2.2.1 PB.Iv (PB.compH r.1.2.2.2.1 V PB.Iv j r.1.2.2.2.2.1) r.2.2))
                      (PB.comp-assoc r.2.1 r.1.2.2.2.1 V X f r.1.2.2.2.2.1 r.2.2))
             (transH (apH (\ jj -> lva (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 V X f (PB.compH r.2.1 r.1.2.2.2.1 V r.1.2.2.2.2.1 r.2.2),
                                        (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).1)
                                    (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).2 r.2.1 (PB.idH r.2.1) jj)
                        (PB.comp-assoc r.2.1 r.1.2.2.2.1 V PB.Iv j r.1.2.2.2.2.1 r.2.2))
               (symH (pa V f j (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 V r.1.2.2.2.2.1 r.2.2,
                                (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).1)
                        (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).2))))))) ;
   aface (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) : W0.Ix (DA.afaceEq x V (w.1.1 V f j) (aa V f j)) = \ r l' ->
    transH (pa V f j (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF x V r l').1) (DA.afaceF x V r l').2)
     (transH (apH (\ T -> CL.EndKit[G.ob r.2.2.2.1, A.ty r.2.2.2.1, e].lv r.2.2.2.2.2.1 T r.2.2.2.2.2.1 (PB.idH r.2.2.2.2.2.1)
                            (PB.compH r.2.2.2.2.2.1 V PB.Iv j r.2.2.2.2.2.2.1))
                (u.2.2.1 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, PB.compH r.2.2.2.2.2.1 V X f r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l'))
       (symH (pa V f j (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l'))) ;
   atop (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) : W0.Ix (DA.atopEq x V (w.1.1 V f j) (aa V f j)) = \ r l' ->
    transH (pa V f j (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF x V r l').1) (DA.atopF x V r l').2)
     (transH (apH (\ T -> CL.EndKit[G.ob r.2.1, A.ty r.2.1, e].lv r.2.2.2.1 T r.2.2.2.1 (PB.idH r.2.2.2.1) (PB.compH r.2.2.2.1 V PB.Iv j r.2.2.2.2.1))
                (u.2.2.2 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, PB.compH r.2.2.2.1 V X f r.2.2.2.2.1, r.2.2.2.2.2) l'))
       (apH ((A.tE r.2.1 (D.topD x V r).1 (D.topD x V r).2.2).nt r.2.2.2.1)
          (symH (pa V f j (r.1, (D.topD x V r).1, (D.topD x V r).2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) l')))) ;
   aaE (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) : DA.TOb' x V (w.1.1 V f j) = (aa V f j, aanat V f j, aface V f j, atop V f j) ;
   -- the line of D A
   Lv (V : Ob) (f : Hom V X) (j : Hom V PB.Iv) : DA.TotD x V = pairE (D.obD x) (DA.DTy x) V (w.1.1 V f j) (aaE V f j) ;
   Lnat (V' V : Ob) (g' : Hom V' V) (f : Hom V X) (j : Hom V PB.Iv)
    : Id (DA.TotD x V') ((extP (D.obD x) (DA.DTy x)).act V' V g' (Lv V f j)) (Lv V' (PB.compH V' V X f g') (PB.compH V' V PB.Iv j g')) =
    DA.totD-eq x V' _ _ (w.1.2 V' V g' f j) (\ q l ->
     transH (DA.TB[x, V', V, g', w.1.1 V f j, D.BA[x, V', V, g', w.1.1 V f j].res, refl (D.BA[x, V', V, g', w.1.1 V f j].res), aaE V f j].pc q l)
      (transH (pa V f j (D.BA[x, V', V, g', w.1.1 V f j].sh q) l)
        (transH (apH (\ k -> lva (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l q.2.2.2.1 (PB.idH q.2.2.2.1)
                                (PB.compH q.2.2.2.1 V PB.Iv j (PB.compH q.2.2.2.1 V' V g' q.2.2.2.2.1)))
                   (symH (PB.comp-assoc q.2.2.2.1 V' V X f g' q.2.2.2.2.1)))
          (transH (apH (\ jj -> lva (q.1, q.2.1, q.2.2.1, q.2.2.2.1, PB.compH q.2.2.2.1 V' X (PB.compH V' V X f g') q.2.2.2.2.1, q.2.2.2.2.2) l
                                  q.2.2.2.1 (PB.idH q.2.2.2.1) jj)
                     (symH (PB.comp-assoc q.2.2.2.1 V' V PB.Iv j g' q.2.2.2.2.1)))
            (symH (pa V' (PB.compH V' V X f g') (PB.compH V' V PB.Iv j g') q l)))))) ;
   L : W0.Ix (CL.FC[extP (D.obD x) (DA.DTy x)].ob X) = (\ V f j -> Lv V f j, \ V' V g' f j -> Lnat V' V g' f j) ;
   eqL : Id (W0.Ix (CL.FC[D.obD x].ob X)) (CL.FT[D.obD x, DA.DTy x].piL X L) w.1 =
    CL.FC[D.obD x].fam-eq X _ _ (\ V f j -> refl (w.1.1 V f j)) ;
   -- its end is the point w.2
   endR (q : DD.Idx x X) (l : DD.LandsI x X q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (PPw.u0.1 q l) (aa X (PB.idH X) (PB.ptH X e) q l)) (DA.prz q.2.1 q.2.2.2.1 (PPw.u0.1 q l) (w.2.1 q l)) =
    transH (pa X (PB.idH X) (PB.ptH X e) q l)
     (transH (apH (\ jj -> lva (qs X (PB.idH X) q) l q.2.2.2.1 (PB.idH q.2.2.2.1) jj) (PB.ptH-nat q.2.2.2.1 X q.2.2.2.2.1 e))
       (transH (symH (CL.FT[G.ob q.2.1, A.ty q.2.1].Ev[e].endB-E q.2.2.2.1
                       (pairE CL.FC[G.ob q.2.1].GI CL.FT[G.ob q.2.1, A.ty q.2.1].AI q.2.2.2.1 (Lx.Lq (qs X (PB.idH X) q) l) (u.1 (qs X (PB.idH X) q) l).1)))
         (transH (apH (CL.EndKit[G.ob q.2.1, A.ty q.2.1, e].endE q.2.2.2.1) (u.1 (qs X (PB.idH X) q) l).2)
           (transH (PPw.pc (qs X (PB.idH X) q) l)
             (apH (\ k -> DA.prz q.2.1 q.2.2.2.1 (PPw.u0.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l) (w.2.1 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, k, q.2.2.2.2.2) l))
                (PB.comp-idl q.2.2.2.1 X q.2.2.2.2.1)))))) ;
   pthL : Id (W0.Ix ((extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev).ob X))
            (CL.FT[D.obD x, DA.DTy x].Ev[e].evA.mE X (pairE CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].AI X w.1 (L, eqL))) w =
    CL.EndKit[D.obD x, DA.DTy x, e].tv-eq X _ _ (refl w.1)
     (transH (CL.FT[D.obD x, DA.DTy x].Ev[e].endB-E X (pairE CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].AI X w.1 (L, eqL)))
       (DA.totD-eq x X (Lv X (PB.idH X) (PB.ptH X e)) (pairE (D.obD x) (DA.DTy x) X PPw.u0 w.2) (refl PPw.u0) (\ q l -> endR q l))) ;
   bkv : W0.Ix (SFD.SF.tob X w) = ((L, eqL), pthL) ;
   -- Psi of the inverse is the given element (Mv's bkMv)
   bkMv : Id (DS.TotD x X) (mS X (pairE (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[e].Aev) SFD.SF X w bkv))
            (pairE (DV.obD x) (DS.DTy x) X (PNx.psi X w) u) =
    DS.totD-eq x X _ _ (refl (PNx.psi X w)) (\ q l ->
     CL.EndKit[G.ob q.2.1, A.ty q.2.1, e].ts-ext q.2.2.2.1 _ _ (refl (PPw.tPt q l)) (\ W' f' j' ->
      transH (pa W' (PB.compH W' q.2.2.2.1 X q.2.2.2.2.1 f') j' (q.1, q.2.1, q.2.2.1, W', PB.idH W', (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1)
                (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2)
       (transH (apH (\ k -> lva (q.1, q.2.1, q.2.2.1, W', k, (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1) (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2
                               W' (PB.idH W') (PB.compH W' W' PB.Iv j' (PB.idH W')))
                  (PB.comp-idr W' X (PB.compH W' q.2.2.2.1 X q.2.2.2.2.1 f')))
         (transH (apH (\ jj -> lva (q.1, q.2.1, q.2.2.1, W', PB.compH W' q.2.2.2.1 X q.2.2.2.2.1 f', (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1)
                                 (Wt.Res[q.1, W', q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2 W' (PB.idH W') jj)
                    (PB.comp-idr W' PB.Iv j'))
           (transH (symH (apH (\ T -> CL.EndKit[G.ob q.2.1, A.ty q.2.1, e].lv W' T W' (PB.idH W') j') (u.2.1 (q, (W', f')) l)))
             (apH (\ k -> lva q l W' k j') (PB.comp-idr W' q.2.2.2.1 f'))))))) ;
  } ;
 } ;

 ------------------------------------------------------------------
 -- Psi commutes with the C-actions (for UFib)

 module PC (A : P.CTy[G]) (e : PB.IPt) (x' x : CO) (gC : P.CH x' x) {
  module DA = DD.DT[G, A] ;
  module AEd = LO.AE[D.DCtx, DA.DCTy, e] ;
  module DV = DD.DC[LO.SF[G, A, e].TVC] ;
  psiC (X : Ob) (w : PN[A, e, x].Pts X)
   : Id (DV.Ob' x' X) (PN[A, e, x'].psi X (AEd.tEv x' x gC X w)) (DV.CA[x', x, gC, X, PN[A, e, x].psi X w].res) =
   DV.ob-eq x' X _ _ (\ q l ->
    CL.EndKit[G.ob q.2.1, A.ty q.2.1, e].tv-eq q.2.2.2.1 _ _
     (CL.FC[G.ob q.2.1].fam-eq q.2.2.2.1 _ _ (\ W f' j' ->
        refl ((w.1.1 W (PB.compH W q.2.2.2.1 X q.2.2.2.2.1 f') j').1
               (q.1, q.2.1, K.rx q.1 x' x gC q.2.1 q.2.2.1, W, PB.idH W, (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).1)
               (Wt.Res[q.1, W, q.2.2.2.1, f', (q.2.2.2.2.2, l)].res).2)))
     (transH (PP[A, e, x', X, (AEd.tEv x' x gC X w).1, (AEd.tEv x' x gC X w).2].pc q l)
       (symH (PP[A, e, x, X, w.1, w.2].pc (DV.CA[x', x, gC, X, PN[A, e, x].psi X w].rq q) l)))) ;
  module SFd = LO.SF[D.DCtx, DA.DCTy, e] ;
  module DS = DD.DT[LO.SF[G, A, e].TVC, LO.SF[G, A, e].SFC] ;
  mSC (X : Ob) (v : MS[A, e, x].TSD X)
   : Id (DS.TotD x' X) (MS[A, e, x'].mS X (SFd.tES x' x gC X v)) ((DS.tEC x' x gC).nt X (MS[A, e, x].mS X v)) =
   DS.totD-eq x' X _ _ (psiC X v.1) (\ q l ->
    CL.EndKit[G.ob q.2.1, A.ty q.2.1, e].ts-ext q.2.2.2.1 _ _ (apH (\ o -> o.1 q l) (psiC X v.1))
     (\ W' f' j' -> refl (PS[A, e, x, X, v.1.1, v.1.2, v.2.1.1, v.2.1.2, v.2.2].valA (DV.CA[x', x, gC, X, PN[A, e, x].psi X v.1].rq q) l W' f' j'))) ;
 } ;
} ;
