-- CPsiOps.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', psi : G -> Q
-- (CPsiQ) is compatible with + and x and the constants up to path homotopy,
-- for any two maps into G: op(psi f, psi g) ~ psi (op (f, g)) from
-- f ~ tau' psi f (CPsiQ's etaT), tau''s compatibility (CE1Copy's OpC at the
-- readings of CE1Fin) and psi tau' ~ id (epsQ); so CHtpyAlg's E1 holds for
-- psi: Q's evaluation at psi of the variables ~ psi of G's evaluation.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module PO (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module PQ = CPsiQ[a].PQ[R, encK, pe, y'] ;
 module GR = PQ.GR ;
 module D = GR.E1[y'].D ;
 module E = D.FI.E ;
 module H = D.PR.H ;
 module HO = PQ.HO ;
 Nl : L.PCtx = PQ.Nl ;
 Qc : L.PTy[Nl] = PQ.Qc ;
 Tc : L.PTy[Nl] = PQ.Tc ;
 psi : HO.NMap[Nl, Tc, Qc] = PQ.psi ;
 tau' : HO.NMap[Nl, Qc, Tc] = PQ.tau' ;
 module One (io : (J : Ob) -> E.CM.MO.Fn[E.CM.F1, E.CM.F2].M J) (io-nat : (J K : Ob) (v : Hom K J) -> Id (E.CM.MO.Fn[E.CM.F1, E.CM.F2].M K) (E.CM.MO.Fn[E.CM.F1, E.CM.F2].res J K v (io J)) (io K))
   (opA : (I : Ob) (x : V1.Ix (Nl.ob I)) (a0 b0 : V1.Ix (Qc.tob I x)) -> V1.Ix (Qc.tob I x))
   (opAN : (J I : Ob) (f : Hom J I) (x : V1.Ix (Nl.ob I)) (y : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I f x) y) (a0 b0 : V1.Ix (Qc.tob I x))
      -> Id (V1.Ix (Qc.tob J y)) (Qc.tact J I f x y e (opA I x a0 b0)) (opA J y (Qc.tact J I f x y e a0) (Qc.tact J I f x y e b0)))
   (rd : (X : L.PTy[Nl]) (f g : HO.NMap[Nl, X, Qc])
      -> L.PEl[L.extP Nl X, HO.HT[Nl, X, E.Ac, HO.compN Nl X E.A2c E.Ac (D.CP.SC.PP[X, HO.compN Nl X Qc E.Ac f D.FI.PH.phi, HO.compN Nl X Qc E.Ac g D.FI.PH.phi].cop) E.Op[io, io-nat].preC,
           HO.compN Nl X Qc E.Ac (CApOp2[a].AO[Nl, X, Qc, opA, opAN].OP f g) D.FI.PH.phi].PT.PathP]) {
  module OC = H.OpC[io, io-nat, opA, opAN, rd] ;
  module At (X : L.PTy[Nl]) (f g : HO.NMap[Nl, X, Tc]) {
   module AOT = CApOp2[a].AO[Nl, X, Tc, OC.OO.opT, OC.OO.opTN] ;
   module AOQ = CApOp2[a].AO[Nl, X, Qc, opA, opAN] ;
   fp : HO.NMap[Nl, X, Qc] = HO.compN Nl X Tc Qc f psi ;
   gp : HO.NMap[Nl, X, Qc] = HO.compN Nl X Tc Qc g psi ;
   ftp : HO.NMap[Nl, X, Tc] = HO.compN Nl X Qc Tc fp tau' ;
   gtp : HO.NMap[Nl, X, Tc] = HO.compN Nl X Qc Tc gp tau' ;
   -- f ~ tau' psi f
   module Wf = HO.WR[Nl, Tc, Tc, X, HO.compN Nl Tc Qc Tc psi tau', HO.idN Nl Tc, f, PQ.etaT] ;
   module Rf = HO.Ret[Nl, X, Tc, HO.compN Nl X Tc Tc f (HO.compN Nl Tc Qc Tc psi tau'), HO.compN Nl X Tc Tc f (HO.idN Nl Tc), ftp, f,
     \ I x a0 -> refl (ftp.nfun I x a0), \ I x a0 -> refl (f.nfun I x a0), Wf.res] ;
   module Wg = HO.WR[Nl, Tc, Tc, X, HO.compN Nl Tc Qc Tc psi tau', HO.idN Nl Tc, g, PQ.etaT] ;
   module Rg = HO.Ret[Nl, X, Tc, HO.compN Nl X Tc Tc g (HO.compN Nl Tc Qc Tc psi tau'), HO.compN Nl X Tc Tc g (HO.idN Nl Tc), gtp, g,
     \ I x a0 -> refl (gtp.nfun I x a0), \ I x a0 -> refl (g.nfun I x a0), Wg.res] ;
   module B = AOT.Ap[ftp, f, gtp, g, Rf.res, Rg.res] ;
   -- tau''s compatibility at psi f, psi g
   module Cc = OC.At[X, fp, gp] ;
   module Ic = HO.Inv[Nl, X, Tc, AOT.OP ftp gtp, HO.compN Nl X Qc Tc (AOQ.OP fp gp) tau', PQ.FTp.cTp, Cc.res] ;
   module Cd = HO.Cat[Nl, X, Tc, HO.compN Nl X Qc Tc (AOQ.OP fp gp) tau', AOT.OP ftp gtp, AOT.OP f g, PQ.FTp.cTp, Ic.res, B.res] ;
   -- psi of it, and psi tau' ~ id
   module We = HO.WL[Nl, X, Tc, Qc, HO.compN Nl X Qc Tc (AOQ.OP fp gp) tau', AOT.OP f g, psi, Cd.res] ;
   module Wq = HO.WR[Nl, Qc, Qc, X, HO.compN Nl Qc Tc Qc tau' psi, HO.idN Nl Qc, AOQ.OP fp gp, PQ.epsQ] ;
   module Rq = HO.Ret[Nl, X, Qc, HO.compN Nl X Qc Qc (AOQ.OP fp gp) (HO.compN Nl Qc Tc Qc tau' psi), HO.compN Nl X Qc Qc (AOQ.OP fp gp) (HO.idN Nl Qc),
     HO.compN Nl X Tc Qc (HO.compN Nl X Qc Tc (AOQ.OP fp gp) tau') psi, AOQ.OP fp gp,
     \ I x a0 -> refl ((HO.compN Nl X Tc Qc (HO.compN Nl X Qc Tc (AOQ.OP fp gp) tau') psi).nfun I x a0), \ I x a0 -> refl ((AOQ.OP fp gp).nfun I x a0), Wq.res] ;
   module Iq = HO.Inv[Nl, X, Qc, HO.compN Nl X Tc Qc (HO.compN Nl X Qc Tc (AOQ.OP fp gp) tau') psi, AOQ.OP fp gp, PQ.RD.cQ, Rq.res] ;
   module Cr = HO.Cat[Nl, X, Qc, AOQ.OP fp gp, HO.compN Nl X Tc Qc (HO.compN Nl X Qc Tc (AOQ.OP fp gp) tau') psi, HO.compN Nl X Tc Qc (AOT.OP f g) psi, PQ.RD.cQ, Iq.res, We.res] ;
   res : L.PEl[L.extP Nl X, HO.HT[Nl, X, Qc, AOQ.OP fp gp, HO.compN Nl X Tc Qc (AOT.OP f g) psi].PT.PathP] = Cr.res ;
  } ;
 } ;
 module AddP = One[E.CM.II.AddF.M.mor, E.CM.II.AddF.M.mor-nat, E.addA, E.addAN,
   \ X f g -> D.PR.RR.OpR[E.CM.II.AddF.M.mor, E.CM.II.AddF.M.mor-nat, E.addA, E.addAN, D.FI.RA2.hAdd].At[X, f, g].res] ;
 module MulP = One[E.CM.II.MulF.M.mor, E.CM.II.MulF.M.mor-nat, E.mulA, E.mulAN,
   \ X f g -> D.PR.RR.OpR[E.CM.II.MulF.M.mor, E.CM.II.MulF.M.mor-nat, E.mulA, E.mulAN, D.FI.RMm.hMul].At[X, f, g].res] ;
} ;
