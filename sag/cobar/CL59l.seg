-- CL59l.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part l: the setting of inv . ev ~ id.  The context Om of the
-- elements of Pi_A Q at the copy y (Om(K) = U(Pi_A Q)|_y at K.1 over the
-- identity point, constant along C), the types E and Q over it, and the
-- evaluation ev'' (phi, e) = phi(e) (CPiE.apW at (idH, e.1)) as a map of
-- types over Om.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module Om (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module DA0 = LA.Data[A, rho, rho1, Q] ;
  E : TR.P1.PCtx = TR.P1.extP LA.PYy A.1 ;
  -- the context of the Pi-elements at the copy y
  OmT : CM.TP.TCtx = new CM.TP.TCtx[\ I x -> DA0.piTob I tt, \ J I uu y0 x f d -> DA0.piTact J I uu tt tt (refl tt) d,
    \ I x d -> DA0.PiC.tact-id I tt (refl tt) d,
    \ K J I uu v z y0 x f f' d -> DA0.PiC.tact-o K J I uu v tt tt tt (refl tt) (refl tt) (refl tt) d] ;
  POm : TR.P1.PCtx = CT.TC.toP OmT ;
  Ew : TR.P1.PTy[POm] = TR.P1.mkTy POm (\ X o -> E.ob X) (\ Yy X h o o' e w -> E.act Yy X h w) (\ X o e w -> E.act-id X w)
   (\ Kk Jj Ii f g o o' o'' e1 e2 e3 w -> E.act-o Kk Jj Ii f g w) ;
  Qw : TR.P1.PTy[POm] = TR.P1.subTy POm G1.fibCwF-T.nil Q.1 (G1.fibCwF-T.eps POm) ;
  -- the evaluation at a point e of yo(y).A
  fy (X : CT.TC.TOb) (g : V1.Ix (LA.PYy.ob X)) : CT.TC.THm X (X.1, y) = (idH X.1, g) ;
  pEq (X : CT.TC.TOb) (g : V1.Ix (LA.PYy.ob X)) : Id (V1.Ix (LA.PYy.ob X)) (LA.PYy.act X (X.1, y) (fy X g) (DA0.idy X.1)) g =
   CM.MO.Fn[y, X.2].mExt X.1 (LA.PYy.act X (X.1, y) (fy X g) (DA0.idy X.1)) g (refl (CM.MO.Fn[y, X.2].fpOf X.1 g)) ;
  ev2 (X : CT.TC.TOb) (phi : V1.Ix (DA0.piTob X.1 tt)) (e : V1.Ix (E.ob X)) : V1.Ix (Q.1.tob X tt) =
   DA0.PE.apW (X.1, y) (DA0.idy X.1) phi X (fy X e.1) e (pEq X e.1) ;
  -- naturality of the evaluation
  module EvNat (Yy X : CT.TC.TOb) (h : CT.TC.THm Yy X) (phi : V1.Ix (DA0.piTob X.1 tt)) (e : V1.Ix (E.ob X)) {
   I0 : CT.TC.TOb = (X.1, y) ;
   J0 : CT.TC.TOb = (Yy.1, y) ;
   hJ : CT.TC.THm J0 I0 = (h.1, CM.IC.cart Yy.1 X.1 h.1 y) ;
   phi' : V1.Ix (DA0.piTob Yy.1 tt) = DA0.piTact Yy.1 X.1 h.1 tt tt (refl tt) phi ;
   e' : V1.Ix (E.ob Yy) = E.act Yy X h e ;
   m1 : CT.TC.THm Yy I0 = CT.TC.TotCat.oC Yy J0 I0 hJ (fy Yy e'.1) ;
   m2 : CT.TC.THm Yy I0 = CT.TC.TotCat.oC Yy X I0 (fy X e.1) h ;
   p1 : Id (V1.Ix (LA.PYy.ob Yy)) (LA.PYy.act Yy I0 m1 (DA0.idy X.1)) e'.1 =
    CM.MO.Fn[y, Yy.2].mExt Yy.1 (LA.PYy.act Yy I0 m1 (DA0.idy X.1)) e'.1 (refl (CM.MO.Fn[y, Yy.2].fpOf Yy.1 e'.1)) ;
   p2 : Id (V1.Ix (LA.PYy.ob Yy)) (LA.PYy.act Yy I0 m2 (DA0.idy X.1)) e'.1 =
    CM.MO.Fn[y, Yy.2].mExt Yy.1 (LA.PYy.act Yy I0 m2 (DA0.idy X.1)) e'.1 (refl (CM.MO.Fn[y, Yy.2].fpOf Yy.1 e'.1)) ;
   F : Id (CT.TC.THm Yy I0) m1 m2 =
    CM.CO.pq Yy.1 X.1 Yy.2 y (compH Yy.1 Yy.1 X.1 h.1 (idH Yy.1)) (compH Yy.1 X.1 X.1 (idH X.1) h.1) (transH (comp-idr Yy.1 X.1 h.1) (symH (comp-idl Yy.1 X.1 h.1)))
     m1.2 m2.2 (CM.MO.Fn[y, Yy.2].mExt Yy.1 m1.2 m2.2 (refl (CM.MO.Fn[y, Yy.2].fpOf Yy.1 m2.2))) ;
   module TB = DA0.PE.TB ;
   chain : Id (TB.EI Yy) (TB.pr Yy e' (ev2 Yy phi' e')) (TB.pr Yy e' (DA0.QA.1.tact Yy X h e e' (refl e') (ev2 X phi e))) =
    transH (DA0.PE.apW-tact J0 I0 hJ (DA0.idy X.1) (DA0.idy Yy.1) (DA0.idyR Yy.1 X.1 h.1) phi Yy (fy Yy e'.1) e' (pEq Yy e'.1) p1)
     (transH (DA0.PE.apW-f I0 (DA0.idy X.1) phi Yy m1 m2 F e' p1 p2)
       (transH (symH (DA0.PE.apW-act I0 (DA0.idy X.1) phi X (fy X e.1) e (pEq X e.1) Yy h e' p2 (refl e')))
         (TB.pr-tact Yy X h e e' (refl e') (ev2 X phi e)))) ;
   eQ : Id (V1.Ix (G1.fibCwF-T.nil.ob Yy)) (G1.fibCwF-T.nil.act Yy X h tt) tt =
    G1.GB.GPre[a+].PS.ntEq POm G1.fibCwF-T.nil (G1.fibCwF-T.eps POm) Yy X h phi (POm.act Yy X h phi) (refl (POm.act Yy X h phi)) ;
   law : Id (V1.Ix (Q.1.tob Yy tt)) (ev2 Yy phi' e') (Q.1.tact Yy X h tt tt eQ (ev2 X phi e)) =
    transH (TB.pr-inj Yy e' (ev2 Yy phi' e') (DA0.QA.1.tact Yy X h e e' (refl e') (ev2 X phi e)) chain)
     (G1.GB.GPre[a+].PS.tact-irr G1.fibCwF-T.nil Q.1 Yy X h tt tt (G1.GB.GPre[a+].PS.ntEq E G1.fibCwF-T.nil (G1.fibCwF-T.eps E) Yy X h e e' (refl e')) eQ (ev2 X phi e)) ;
  } ;
  ev'' : TR.G1.GB.CPartial[a+].PMap[POm, Ew, Qw] =
   TR.G1.GB.CPartial[a+].mkPMap POm Ew Qw (\ X w -> (w.1, ev2 X w.1 w.2)) (\ X w -> refl w.1)
    (\ Yy X h w -> apH {V1.Ix (Q.1.tob Yy tt)} {V1.Ix ((TR.P1.extP POm Qw).ob Yy)} (\ b -> (POm.act Yy X h w.1, b)) EvNat[Yy, X, h, w.1, w.2].law) ;
 } ;
} ;
