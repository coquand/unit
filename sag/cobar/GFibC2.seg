-- GFibC2.seg: GENERATED from FibC2.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change FibC2.seg or the generator.
-- FibC2.seg (M1 step 3, S4, S3 toolkit): over G with B over G and I , P
-- over G.B, a ContrOp on Sigma B P and an equivalence structure on a map
-- pj : I -> P (CEquiv.EquivOp: a ContrOp on its homotopy fibres) give a
-- ContrOp on Sigma B I.
--
-- Informal text.  Let s be a partial element of Sigma B I at x (sieve q).
-- (1) Its image under Sigma B pj is extended in Sigma B P: (b* , p*) at x.
-- (2) Over the point w0 = ((x , b*) , p*) of G.B.P, the side of the
--     homotopy fibre of pj: on q, the element of I given by s, with the
--     constant path at its image (its point is w0 restricted, by (1) on q).
--     It is extended: v* in I at (x , b*), with a path.
-- (3) The extension is (b* , v*).  On q it is s (the B part of the
--     extension of (2) on q, read in Sigma B I).  Uniformity: (1) is
--     uniform and commutes with restriction of sides (Map.side-res), so
--     w0 restricts to w0 at the restricted side; the side of (2) restricts
--     to the side of (2) there (values: by definition, pv-irr), so (2) is
--     uniform (kunif, kop-cong).
-- The reassociations Sigma (x : G) Sigma B I = Sigma ((x , b) : G.B) I
-- are natural up to tact-irr (asi , isa , asc).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module PFm = PresheafFormers[a, l].PFormers[PB.BC] ;
module LR = GCLocBoundRetr[l] ;
module YCm = GFibYC[l] ;

module C2 (G : PCtx) (B : PTy[G]) (I P : PTy[extP G B]) (pn : HO.NMap[extP G B, I, P]) (pj : CP.PMap[extP G B, I, P])
  (pjQ : (X : Ob) (w : SigT (extP G B) I X)
     -> Id (SigT (extP G B) P X) (pj.mE X w) (pairE (extP G B) P X (fstE (extP G B) I X w) (pn.nfun X (fstE (extP G B) I X w) (sndE (extP G B) I X w))))
  (k1 : CP.ContrOp G (PFm.SigAB[G, B, P].SigP))
  (k2 : PB.CEquiv[l].EquivOp (extP G B) I P pj) {
  K : PCtx = extP G B ;
  module SI = PFm.SigAB[G, B, I] ;
  module SP = PFm.SigAB[G, B, P] ;
  module TSI = GPR.TyL[G, SI.SigP] ;
  module TSP = GPR.TyL[G, SP.SigP] ;
  module TKP = GPR.TyL[K, P] ;
  module TKI = GPR.TyL[K, I] ;
  module HP = PB.CEquiv[l].HFib[K, I, P, pj] ;
  module MS = LR.Map[G, SI.SigP, SP.SigP, YCm.SigN[G, B, I, P, pn].map] ;
  module PSI = CP.Partials[G, SI.SigP] ;
  module PH = CP.Partials[HP.EA, HP.FibT] ;
  module RH = CP.Rel[HP.EA, HP.FibT, HP.FibT, CP.pmap-id HP.EA HP.FibT] ;

  ----------------------------------------------------------------------
  -- reassociation

  kpt (Y : Ob) (x : W0.Ix (G.ob Y)) (b : W0.Ix (B.tob Y x)) : W0.Ix (K.ob Y) = pairE G B Y x b ;

  asc (Y : Ob) (u : TSP.EI Y) : TKP.EI Y = TKP.pr Y (kpt Y (TSP.pr1 Y u) (TSP.pr2 Y u).1) (TSP.pr2 Y u).2 ;
  asi (Y : Ob) (u : TSI.EI Y) : TKI.EI Y = TKI.pr Y (kpt Y (TSI.pr1 Y u) (TSI.pr2 Y u).1) (TSI.pr2 Y u).2 ;
  isa (Y : Ob) (w : TKI.EI Y) : TSI.EI Y = TSI.pr Y (fstE G B Y (TKI.pr1 Y w)) (sndE G B Y (TKI.pr1 Y w), TKI.pr2 Y w) ;

  asc-act (Z Y : Ob) (g : Hom Z Y) (u : TSP.EI Y) : Id (TKP.EI Z) (asc Z (TSP.E.act Z Y g u)) (TKP.E.act Z Y g (asc Y u)) =
    apH (TKP.pr Z (K.act Z Y g (kpt Y (TSP.pr1 Y u) (TSP.pr2 Y u).1)))
      (tact-irr K P Z Y g (kpt Y (TSP.pr1 Y u) (TSP.pr2 Y u).1) (K.act Z Y g (kpt Y (TSP.pr1 Y u) (TSP.pr2 Y u).1))
         (pair-act G B Z Y g (TSP.pr1 Y u) (G.act Z Y g (TSP.pr1 Y u)) (refl (G.act Z Y g (TSP.pr1 Y u))) (TSP.pr2 Y u).1)
         (refl (K.act Z Y g (kpt Y (TSP.pr1 Y u) (TSP.pr2 Y u).1))) (TSP.pr2 Y u).2) ;

  asi-act (Z Y : Ob) (g : Hom Z Y) (u : TSI.EI Y) : Id (TKI.EI Z) (asi Z (TSI.E.act Z Y g u)) (TKI.E.act Z Y g (asi Y u)) =
    apH (TKI.pr Z (K.act Z Y g (kpt Y (TSI.pr1 Y u) (TSI.pr2 Y u).1)))
      (tact-irr K I Z Y g (kpt Y (TSI.pr1 Y u) (TSI.pr2 Y u).1) (K.act Z Y g (kpt Y (TSI.pr1 Y u) (TSI.pr2 Y u).1))
         (pair-act G B Z Y g (TSI.pr1 Y u) (G.act Z Y g (TSI.pr1 Y u)) (refl (G.act Z Y g (TSI.pr1 Y u))) (TSI.pr2 Y u).1)
         (refl (K.act Z Y g (kpt Y (TSI.pr1 Y u) (TSI.pr2 Y u).1))) (TSI.pr2 Y u).2) ;

  isa-act (Z Y : Ob) (g : Hom Z Y) (w : TKI.EI Y) : Id (TSI.EI Z) (isa Z (TKI.E.act Z Y g w)) (TSI.E.act Z Y g (isa Y w)) =
    apH (isa Z) (symH (asi-act Z Y g (isa Y w))) ;

  ----------------------------------------------------------------------
  -- the element of the homotopy fibre given by a point of Sigma B I

  wOf (Y : Ob) (u : TSI.EI Y) : TKP.EI Y = asc Y (MS.onE Y u) ;

  fibOf (Y : Ob) (u : TSI.EI Y) : HP.TF.EI Y =
    HP.mkFib Y (wOf Y u) (TSI.pr2 Y u).2 (\ W g j -> TKP.E.act W Y g (wOf Y u))
      (\ V W g' g j -> TKP.PE.actC V W Y g g' (wOf Y u))
      (\ W g j -> refl (K.act W Y g (kpt Y (TSI.pr1 Y u) (TSI.pr2 Y u).1)))
      (transH (TKP.E.act-id Y (wOf Y u)) (symH (pjQ Y (asi Y u))))
      (TKP.E.act-id Y (wOf Y u)) ;

  fibOf-act (Z Y : Ob) (g : Hom Z Y) (u : TSI.EI Y) : Id (HP.TF.EI Z) (HP.TF.E.act Z Y g (fibOf Y u)) (fibOf Z (TSI.E.act Z Y g u)) =
    HP.fibE-eq Z (HP.TF.E.act Z Y g (fibOf Y u)) (fibOf Z (TSI.E.act Z Y g u)) Pw
      (transH (HP.fibB-act Z Y g (fibOf Y u)) (symH (asi-act Z Y g u)))
      (\ W h j -> symH (transH (apH (TKP.E.act W Z h) (symH Pw)) (TKP.PE.actC W Z Y g h (wOf Y u))))
   where {
    Pw : Id (TKP.EI Z) (TKP.E.act Z Y g (wOf Y u)) (wOf Z (TSI.E.act Z Y g u)) =
      transH (symH (asc-act Z Y g (MS.onE Y u))) (apH (asc Z) (MS.act Z Y g u)) ;
   } ;

  ----------------------------------------------------------------------
  -- the extension

  module Ext (X : Ob) (x : W0.Ix (G.ob X)) (s : PSI.Side[X, x]) {
    s1 : CP.Partials[G, SP.SigP].Side[X, x] = MS.side X x s ;
    t1 : W0.Ix (SP.SigP.tob X x) = k1.kop X x s1 ;
    w0 : TKP.EI X = asc X (TSP.pr X x t1) ;

    ppt2 (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X s.pQ f) : Id (TKP.EI Y) (HP.TF.pr1 Y (fibOf Y (s.pv Y f i))) (HP.EA.act Y X f w0) =
      symH (transH (symH (asc-act Y X f (TSP.pr X x t1))) (apH (asc Y) (k1.kside X x s1 Y f i))) ;

    pnat2 (W' W : Ob) (chi : Hom W' W) (f : Hom W X) (i : PB.Lands W X s.pQ f) (i' : PB.Lands W' X s.pQ (compH W' W X f chi))
      : Id (HP.TF.EI W') (HP.TF.E.act W' W chi (fibOf W (s.pv W f i))) (fibOf W' (s.pv W' (compH W' W X f chi) i')) =
      transH (fibOf-act W' W chi (s.pv W f i)) (apH (fibOf W') (s.pnat W' W chi f i i')) ;

    s2 : PH.Side[X, w0] = PH.mkSide X w0 s.pQ (\ Y f i -> fibOf Y (s.pv Y f i)) ppt2 pnat2 ;

    t2 : W0.Ix (HP.FibT.tob X w0) = k2.kop X w0 s2 ;

    res : W0.Ix (SI.SigP.tob X x) = (t1.1, t2.1) ;
  } ;

  kside (X : Ob) (x : W0.Ix (G.ob X)) (s : PSI.Side[X, x]) (Y : Ob) (f : Hom Y X) (i : PB.Lands Y X s.pQ f)
    : Id (TSI.EI Y) (TSI.E.act Y X f (TSI.pr X x Ext[X, x, s].res)) (s.pv Y f i) =
    transH (symH (isa-act Y X f (asi X (TSI.pr X x Ext[X, x, s].res))))
      (apH (isa Y) (transH (symH (HP.fibB-act Y X f (HP.TF.pr X Ext[X, x, s].w0 Ext[X, x, s].t2)))
                     (apH (HP.fibB Y) (k2.kside X Ext[X, x, s].w0 Ext[X, x, s].s2 Y f i)))) ;

  module Un (Y X : Ob) (h : Hom Y X) (x : W0.Ix (G.ob X)) (s : PSI.Side[X, x]) {
    module E0 = Ext[X, x, s] ;
    module E1 = Ext[Y, G.act Y X h x, PSI.rside Y X h x s] ;

    uP : Id (TSP.EI Y) (TSP.E.act Y X h (TSP.pr X x E0.t1)) (TSP.pr Y (G.act Y X h x) E1.t1) =
      transH (k1.kunif Y X h x E0.s1)
        (apH (\ z -> TSP.pr Y (G.act Y X h x) (k1.kop Y (G.act Y X h x) z)) (MS.side-res Y X h x s)) ;

    Pw : Id (TKP.EI Y) (HP.EA.act Y X h E0.w0) E1.w0 =
      transH (symH (asc-act Y X h (TSP.pr X x E0.t1))) (apH (asc Y) uP) ;

    sd : Id (PH.Side[Y, E1.w0]) (subst (TKP.EI Y) (\ z -> PH.Side[Y, z]) (HP.EA.act Y X h E0.w0) E1.w0 Pw (PH.rside Y X h E0.w0 E0.s2)) E1.s2 =
      PH.side-extH Y (HP.EA.act Y X h E0.w0) E1.w0 Pw (PH.rside Y X h E0.w0 E0.s2) E1.s2 (refl (PB.pre Y X h s.pQ))
        (\ Z f i i' -> apH (fibOf Z) (PSI.pv-irr X x s Z (compH Z Y X h f) (PB.lands-pre Z Y X h s.pQ f i) (PB.lands-pre Z Y X h s.pQ f i'))) ;

    vP : Id (HP.TF.EI Y) (HP.TF.E.act Y X h (HP.TF.pr X E0.w0 E0.t2)) (HP.TF.pr Y E1.w0 E1.t2) =
      transH (k2.kunif Y X h E0.w0 E0.s2)
        (RH.kop-cong k2 Y (HP.EA.act Y X h E0.w0) E1.w0 Pw (PH.rside Y X h E0.w0 E0.s2) E1.s2 sd) ;

    unif : Id (TSI.EI Y) (TSI.E.act Y X h (TSI.pr X x E0.res)) (TSI.pr Y (G.act Y X h x) E1.res) =
      transH (symH (isa-act Y X h (asi X (TSI.pr X x E0.res))))
        (apH (isa Y) (transH (symH (HP.fibB-act Y X h (HP.TF.pr X E0.w0 E0.t2))) (apH (HP.fibB Y) vP))) ;
  } ;

  contrOp : CP.ContrOp G SI.SigP = new CP.Rel[G, SI.SigP, SI.SigP, CP.pmap-id G SI.SigP].RC[
    \ X x s -> Ext[X, x, s].res, kside, \ Y X h x s -> Un[Y, X, h, x, s].unif] ;
} ;
