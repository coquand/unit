-- CCmpK24.seg (canonicity-c2; (K) for cmpI, part 24): R2, the stage-2
-- result over nil.Q: lambdas over s1, h, g of the body (K23), then
-- CMsElim at the native base of msurj.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module K24 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K23m = CCmpK23[a].K23[R, encK, pe, y] ;
 module K20m = K23m.K20m ;
 module K19m = K23m.K19m ;
 module QS = K19m.QS ;

 G1 : C.Ctx = K19m.G1 ;
 E2 : C.Ctx = K20m.E2 ;
 D1 : C.Ctx = K20m.D1 ;
 D2 : C.Ctx = K20m.D2 ;
 S1p : C.Ty D2 = K23m.S1p ;
 x3 : C.El D2 (FibCwF[a, a+].fibPi.Pi D2 S1p K23m.FC3) = OV.lam D2 S1p K23m.FC3 K23m.body ;
 x3' : C.El D2 (C.subT D2 K19m.C2 K19m.PiS K20m.l2) =
  OV.trE D2 (FibCwF[a, a+].fibPi.Pi D2 S1p K23m.FC3) (C.subT D2 K19m.C2 K19m.PiS K20m.l2) (symH (FibCwF[a, a+].fibPi.Pi-nat D2 K19m.C2 K19m.S1' K19m.F2 K20m.l2)) x3 ;
 H2p : C.Ty D1 = C.subT D1 K19m.C1 K19m.H2 K20m.l1 ;
 x2 : C.El D1 (C.subT D1 K19m.C1 K19m.PiH K20m.l1) =
  OV.trE D1 (FibCwF[a, a+].fibPi.Pi D1 H2p (C.subT D2 K19m.C2 K19m.PiS K20m.l2)) (C.subT D1 K19m.C1 K19m.PiH K20m.l1) (symH (FibCwF[a, a+].fibPi.Pi-nat D1 K19m.C1 K19m.H2 K19m.PiS K20m.l1))
   (OV.lam D1 H2p (C.subT D2 K19m.C2 K19m.PiS K20m.l2) x3') ;
 X2p : C.Ty E2 = C.subT E2 G1 K19m.X2 K20m.pE2 ;
 b2 : C.El E2 (C.subT E2 G1 K19m.B2 K20m.pE2) =
  OV.trE E2 (FibCwF[a, a+].fibPi.Pi E2 X2p (C.subT D1 K19m.C1 K19m.PiH K20m.l1)) (C.subT E2 G1 K19m.B2 K20m.pE2) (symH (FibCwF[a, a+].fibPi.Pi-nat E2 G1 K19m.X2 K19m.PiH K20m.pE2))
   (OV.lam E2 X2p (C.subT D1 K19m.C1 K19m.PiH K20m.l1) x2) ;
 R2 : C.El G1 K19m.B2 = CMsElim[a].ME[G1, QS.S, QS.msurj, K19m.B2, K19m.pB2, b2].res ;
} ;
