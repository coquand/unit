-- CPshPiFibU.seg (canonicity-c2; COBAR.md (B) stage 2(c), M2): the
-- compositions of Pi_A B (CPshPiFibN) are uniform in C.
--
-- For g : x' -> x the C-action of Pi is reindexing, so the component
-- (y , f') of the moved composite at x is its component (y , g f'), moved
-- along G.act-o (prC).  Both this and the component (y , f') of the
-- composite at x' are moves of ONE base composition, that of Pi_y, along
-- act (g f') and along act f'; read in Pi_y (compE) they are its
-- composites at the data moved from x and from x', which agree: the
-- points by eWg (G.act-o on the lines, prC at the ends), the sides by
-- tsEg (prC on the values of the lines).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module UOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module NN = CPshPiFibN[a, l].NOf[C] ;
 open P ;

 -- for any C-type T: the reading of a moved element over the other end
 -- is the moved reading (as CPshFillU.rdC, without a composition)
 module RdG (G : CCtx) (T : CTy[G]) (e e' : PB.IPt) (x' x : CO) (g : CH x' x) {
  module SFt = LO.SF[G, T, e] ;
  module AEt' = LO.AE[G, T, e'] ;
  module SCt = LO.SC[SFt.TVC, LO.LinC G, LO.pPC (LO.LinC G) SFt.AE'.AevC, AEt'.AevC] ;
  rdC (W : Ob) (v : SCt.Tt x W)
   : Id (SigT (G.ob x') (T.ty x') W)
       (CL.EndKit[G.ob x', T.ty x', e'].endE W (CL.Lines[G.ob x', T.ty x'].CompK[e, e'].SE.mV W (SCt.tEs x' x g W v)))
       ((T.tE x' x g).nt W (CL.EndKit[G.ob x, T.ty x, e'].endE W (CL.Lines[G.ob x, T.ty x].CompK[e, e'].SE.mV W v))) =
   transH (apH (\ t -> CL.EndKit[G.ob x', T.ty x', e'].endE W t) (SCt.rBtE x' x g W v))
    (AEt'.endEv x' x g W (CL.Lines[G.ob x, T.ty x].CompK[e, e'].SE.mV W v)) ;
  opaque rdC ;
 } ;

 module Ud (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (d : Bool)
  (kA : (y : CO) -> CL.Lines[G.ob y, A.ty y].Fill (PB.tgt d))
  (cB : (y : CO) -> CL.Lines[extP (G.ob y) (A.ty y), B.ty y].CompK[PB.src d, PB.tgt d].Comp)
  (kAU : P.Unif[LO.SF[G, A, PB.tgt d].TVC, LO.SF[G, A, PB.tgt d].SFC, LO.SF[G, A, PB.tgt d].SFC,
                \ y -> CP.pmap-id (LO.SF[G, A, PB.tgt d].TVC.ob y) (LO.SF[G, A, PB.tgt d].SFC.ty y), kA].CUnif)
  (cBU : LO.UF[LO.ExtC G A, B].UComp (PB.src d) (PB.tgt d) cB) {
  module PC = PO.PiC[G, A, B] ;
  PiT : CTy[G] = PC.PiT ;
  -- the compositions
  comp (x : CO) : CL.Lines[G.ob x, PiT.ty x].CompK[PB.src d, PB.tgt d].Comp = NN.Nd[G, A, B, x, d, kA, cB].NC[kAU, cBU].comp ;

  module SFp = LO.SF[G, PiT, PB.src d] ;
  module AEe = SFp.AE' ;
  module AEt = LO.AE[G, PiT, PB.tgt d] ;
  module SCe = LO.SC[SFp.TVC, LO.LinC G, LO.pPC (LO.LinC G) AEe.AevC, AEt.AevC] ;

  module Ug (x' x : CO) (g : CH x' x) {
   module Nx = NN.Nd[G, A, B, x, d, kA, cB] ;
   module Nx' = NN.Nd[G, A, B, x', d, kA, cB] ;
   module Fx = Nx.F ;
   module Fx' = Nx'.F ;
   tvP (W : Ob) (u : Fx.CKP.EK.TV.EI W) : Fx'.CKP.EK.TV.EI W = AEe.tEv x' x g W u ;
   tsP (W : Ob) (u : Fx.CKP.EK.TS.EI W) : Fx'.CKP.EK.TS.EI W = SFp.tES x' x g W u ;
   tP (W : Ob) (t : Fx.TP.EI W) : Fx'.TP.EI W = (PiT.tE x' x g).nt W t ;

   -- at the component (y , f') of x', i.e. (y , g f') of x
   module Cy (y : CO) (f' : CH y x') {
    gf : CH y x = co y x' x g f' ;
    module PiK = PB.CPi[l].PiC[G.ob y, A.ty y, B.ty y, d, kA y, cB y] ;
    module Ax = Nx.AtY[y, gf] ;
    module Ax' = Nx'.AtY[y, f'] ;
    module Cmx = Fx.Cm[y, gf] ;
    module Cmx' = Fx'.Cm[y, f'] ;
    module SEx = PB.CSub[l].SubE[Fx.Gx, G.ob y, G.act y x gf, PC.PiB y] ;
    module SEx' = PB.CSub[l].SubE[Fx'.Gx, G.ob y, G.act y x' f', PC.PiB y] ;
    -- the projection of a moved total, read in Pi_y
    prC (W : Ob) (t : Fx.TP.EI W) : Id (PiK.TP.EI W) (SEx.mV W (Fx.prM y gf W t)) (SEx'.mV W (Fx'.prM y f' W (tP W t))) =
     GPR.TyL[G.ob y, PC.PiB y].pr-coe W ((G.act y x gf).nt W (fstE Fx.Gx Fx.PiX W t)) ((G.act y x' f').nt W ((G.act x' x g).nt W (fstE Fx.Gx Fx.PiX W t)))
      (G.act-o y x' x g f' W (fstE Fx.Gx Fx.PiX W t)) ((sndE Fx.Gx Fx.PiX W t).1 y gf) ;
    -- the moved points agree
    lnW (W : Ob) (wp : Fx.CKP.EK.TV.EI W)
     : Id (W0.Ix (CL.FC[G.ob y].ob W)) (PiK.KP.TV.pr1 W (Ax.FS.E.sV W (Cmx.M.tvM W wp))) (PiK.KP.TV.pr1 W (Ax'.FS.E.sV W (Cmx'.M.tvM W (tvP W wp)))) =
     CL.FC[G.ob y].fam-eq W (PiK.KP.TV.pr1 W (Ax.FS.E.sV W (Cmx.M.tvM W wp))) (PiK.KP.TV.pr1 W (Ax'.FS.E.sV W (Cmx'.M.tvM W (tvP W wp))))
      (\ V k j -> G.act-o y x' x g f' V ((Fx.CKP.EK.TV.pr1 W wp).1 V k j)) ;
    endW1 (W : Ob) (wp : Fx.CKP.EK.TV.EI W)
     : Id (PiK.TP.EI W) (PiK.KP.endE W (Ax.FS.E.sV W (Cmx.M.tvM W wp))) (SEx.mV W (Fx.prM y gf W (Fx.CKP.EK.endE W wp))) =
     transH (Ax.FS.E.sVE W (Cmx.M.tvM W wp)) (apH (\ t -> SEx.mV W t) (Cmx.M.tvM-E W wp)) ;
    endW2 (W : Ob) (wp : Fx.CKP.EK.TV.EI W)
     : Id (PiK.TP.EI W) (PiK.KP.endE W (Ax'.FS.E.sV W (Cmx'.M.tvM W (tvP W wp)))) (SEx'.mV W (Fx'.prM y f' W (tP W (Fx.CKP.EK.endE W wp)))) =
     transH (Ax'.FS.E.sVE W (Cmx'.M.tvM W (tvP W wp)))
      (transH (apH (\ t -> SEx'.mV W t) (Cmx'.M.tvM-E W (tvP W wp)))
        (apH (\ t -> SEx'.mV W (Fx'.prM y f' W t)) (AEe.endEv x' x g W wp))) ;
    eWg (W : Ob) (wp : Fx.CKP.EK.TV.EI W)
     : Id (PiK.KP.TV.EI W) (Ax.FS.E.sV W (Cmx.M.tvM W wp)) (Ax'.FS.E.sV W (Cmx'.M.tvM W (tvP W wp))) =
     PiK.KP.tv-eq W (Ax.FS.E.sV W (Cmx.M.tvM W wp)) (Ax'.FS.E.sV W (Cmx'.M.tvM W (tvP W wp))) (lnW W wp)
      (transH (endW1 W wp) (transH (prC W (Fx.CKP.EK.endE W wp)) (symH (endW2 W wp)))) ;
    -- the moved elements of the fibres agree
    tsPt (W : Ob) (u : Fx.CKP.EK.TS.EI W)
     : Id (PiK.KP.TV.EI W) (PiK.KP.TS.pr1 W (Ax.FS.E.mS W (Cmx.M.tsM W u))) (PiK.KP.TS.pr1 W (Ax'.FS.E.mS W (Cmx'.M.tsM W (tsP W u)))) =
     transH (Ax.FS.E.mSpt W (Cmx.M.tsM W u))
      (transH (apH (\ t -> Ax.FS.E.sV W t) (Cmx.M.tsM-pt W u))
        (transH (eWg W (Fx.CKP.EK.TS.pr1 W u))
          (symH (transH (Ax'.FS.E.mSpt W (Cmx'.M.tsM W (tsP W u))) (apH (\ t -> Ax'.FS.E.sV W t) (Cmx'.M.tsM-pt W (tsP W u))))))) ;
    tsLv (W : Ob) (u : Fx.CKP.EK.TS.EI W) (V : Ob) (k : Hom V W) (j : Hom V Iv)
     : Id (PiK.TP.EI V) (PiK.KP.lv W (Ax.FS.E.mS W (Cmx.M.tsM W u)) V k j) (PiK.KP.lv W (Ax'.FS.E.mS W (Cmx'.M.tsM W (tsP W u))) V k j) =
     transH (Ax.FS.E.mS-val W (Cmx.M.tsM W u) V k j)
      (transH (apH (\ t -> SEx.mV V t) (Cmx.M.tsM-val W u V k j))
        (transH (prC V (Fx.CKP.EK.lv W u V k j))
          (symH (transH (Ax'.FS.E.mS-val W (Cmx'.M.tsM W (tsP W u)) V k j)
                   (apH (\ t -> SEx'.mV V t) (Cmx'.M.tsM-val W (tsP W u) V k j)))))) ;
    tsEg (W : Ob) (u : Fx.CKP.EK.TS.EI W)
     : Id (PiK.KP.TS.EI W) (Ax.FS.E.mS W (Cmx.M.tsM W u)) (Ax'.FS.E.mS W (Cmx'.M.tsM W (tsP W u))) =
     PiK.KP.ts-ext W (Ax.FS.E.mS W (Cmx.M.tsM W u)) (Ax'.FS.E.mS W (Cmx'.M.tsM W (tsP W u))) (tsPt W u) (tsLv W u) ;
   } ;

   -- the reading of a moved element over the other end is the moved reading
   rdC (W : Ob) (v : Fx.TTP.EI W) : Id (Fx'.TP.EI W) (Fx'.rdP W (SCe.tEs x' x g W v)) (tP W (Fx.rdP W v)) =
    RdG[G, PiT, PB.src d, PB.tgt d, x', x, g].rdC W v ;
   opaque rdC ;

   -- at a point w over the end src d and a side s
   module Uw (X : Ob) (w : Fx.CKP.EK.TV.EI X) (s : Fx.CKP.EK.PT.Side[X, w]) {
    ms : Fx'.CKP.EK.PT.Side[X, tvP X w] = MapSide[SFp.TVC, SFp.SFC, x', x, g].mapside X w s ;
    lt : Fx.TTP.EI X = Fx.TTP.pr X w ((comp x).kop X w s) ;
    rt : Fx'.TTP.EI X = Fx'.TTP.pr X (tvP X w) ((comp x').kop X (tvP X w) ms) ;
    lm : Fx'.TTP.EI X = SCe.tEs x' x g X lt ;
    -- the reading of the moved composite is the moved reading
    rdL : Id (Fx'.TP.EI X) (Fx'.rdP X lm) (tP X (Fx.rdP X lt)) = rdC X lt ;

    module Wy (y : CO) (f' : CH y x') {
     module K = Cy[y, f'] ;
     module Vx = Nx.Val[X, w, s, y, K.gf] ;
     module Vx' = Nx'.Val[X, tvP X w, ms, y, f'] ;
     -- the moved sides agree
     eS : Id (K.PiK.KP.PT.Side[X, Vx'.wY]) (subst (K.PiK.KP.TV.EI X) (\ t -> K.PiK.KP.PT.Side[X, t]) Vx.wY Vx'.wY (K.eWg X w) Vx.pY) Vx'.pY =
      K.PiK.KP.PT.side-extH X Vx.wY Vx'.wY (K.eWg X w) Vx.pY Vx'.pY (refl s.pQ)
       (\ W k i i' -> transH (K.tsEg W (s.pv W k i))
          (apH (\ t -> K.Ax'.FS.E.mS W (K.Cmx'.M.tsM W (tsP W t))) (Fx.CKP.EK.PT.pv-irr X w s W k i i'))) ;
     copE : Id (K.PiK.TTP.EI X) (K.PiK.TTP.pr X Vx.wY Vx.CX.cop) (K.PiK.TTP.pr X Vx'.wY Vx'.CX.cop) =
      K.PiK.RCP.kop-cong K.PiK.comp X Vx.wY Vx'.wY (K.eWg X w) Vx.pY Vx'.pY eS ;
     -- the two components, read in Pi_y
     compC : Id (K.PiK.TP.EI X) (K.SEx.mV X (Fx.prM y K.gf X (Fx.rdP X lt))) (K.SEx'.mV X (Fx'.prM y f' X (Fx'.rdP X rt))) =
      transH Vx.compE (transH (apH (\ t -> K.PiK.rdP X t) copE) (symH Vx'.compE)) ;
     q1 : Id (K.PiK.TP.EI X) (K.SEx'.mV X (Fx'.prM y f' X (Fx'.rdP X lm))) (K.SEx'.mV X (Fx'.prM y f' X (Fx'.rdP X rt))) =
      transH (apH (\ t -> K.SEx'.mV X (Fx'.prM y f' X t)) rdL)
       (transH (symH (K.prC X (Fx.rdP X lt))) compC) ;
     res : Id (SigT Fx'.Gx (Fx'.TT y f') X) (Fx'.prM y f' X (Fx'.rdP X lm)) (Fx'.prM y f' X (Fx'.rdP X rt)) =
      K.SEx'.mV-inj X (Fx'.prM y f' X (Fx'.rdP X lm)) (Fx'.prM y f' X (Fx'.rdP X rt))
       (apH (\ t -> fstE Fx'.Gx Fx'.PiX X t) rdL) q1 ;
    } ;
    res : Id (Fx'.TTP.EI X) lm rt =
     Fx'.tt-ext X lm rt (refl (tvP X w)) (Fx'.tot-extC X (Fx'.rdP X lm) (Fx'.rdP X rt) (\ y f' -> Wy[y, f'].res)) ;
   } ;
  } ;

  -- the compositions of Pi_A B from src d to tgt d are uniform in C
  ucomp : LO.UF[G, PiT].UComp (PB.src d) (PB.tgt d) comp = \ x' x g X w s -> Ug[x', x, g].Uw[X, w, s].res ;
 } ;
} ;
