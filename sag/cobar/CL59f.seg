-- CL59f.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part f: the two closed types of the copy are fibrant.
--   fibQC    U(Q)|_{y.u}: Q's structure at G0 (CTotUFib4.fibU), restricted
--            to the copy y.u (CCopy8.FibR), moved to the closed type
--            (CCart, the fibres agree)
--   fibPiC   U(Pi_A Q)|_y at the identity point: the same for Pi, pulled
--            back along the identity point (CFibSub), then moved (CCart)
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module FF (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module U4 = CTotUFib4[a, a+, a+].UFib4[CM.IC] ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module DA0 = LA.Data[A, rho, rho1, Q] ;
  Nl : L.PCtx = LA.Nl ;
  -- U(Q) at the copy y.u
  UN : TR.P0.PCtx = TR.RS.rC G1.fibCwF-T.nil ;
  fbQ0 : TR.G0.GB.CLine[a+].Lines[UN, DA0.UQ].Fib = U4.fibU G1.fibCwF-T.nil Q.1 Q.2 ;
  fbQy : PB.CLine[a+].Lines[DA0.Cu.rCy UN, DA0.Cu.rTy UN DA0.UQ].Fib = CCopy8[a].FibR[R, encK, pe, UN, DA0.UQ, fbQ0, LA.yu].fib ;
  module QM {
   Dq : L.PCtx = DA0.Cu.rCy UN ;
   Aq : L.PTy[Dq] = DA0.Cu.rTy UN DA0.UQ ;
   module TA' = PB.GPre[a+].TyL[Nl, DA0.QC] ;
   module TA = PB.GPre[a+].TyL[Dq, Aq] ;
   s (W : Ob) (o : V1.Ix (Nl.ob W)) : V1.Ix (Dq.ob W) = tt ;
   ta (W : Ob) (v : TA'.EI W) : TA.EI W = TA.pr W tt (TA'.pr2 W v) ;
   tainj (W : Ob) (v v' : TA'.EI W) (Pp : Id (V1.Ix (Nl.ob W)) (TA'.pr1 W v) (TA'.pr1 W v')) (Q0 : Id (TA.EI W) (ta W v) (ta W v')) : Id (TA'.EI W) v v' =
    idJ (V1.Ix (Nl.ob W)) (TA'.pr1 W v)
     (\ o2 P2 -> (m2 : V1.Ix (DA0.QC.tob W o2)) -> Id (V1.Ix (DA0.qTob W tt)) (TA'.pr2 W v) m2 -> Id (TA'.EI W) v (TA'.pr W o2 m2))
     (\ m2 Q2 -> apH {V1.Ix (DA0.QC.tob W (TA'.pr1 W v))} {TA'.EI W} (TA'.pr W (TA'.pr1 W v)) Q2)
     (TA'.pr1 W v') Pp (TA'.pr2 W v') (TA.pr-inj W tt (TA'.pr2 W v) (TA'.pr2 W v') Q0) ;
   module CRT = PB.CCart[a+, a+].Cart[Nl, DA0.QC, Dq, Aq, s, \ Vv W g d -> refl tt, ta, \ W v -> refl tt,
     \ Vv W g v -> refl (ta Vv (TA'.E.act Vv W g v)), tainj, \ X x uu -> uu, \ X x uu -> refl (TA.pr X tt uu)] ;
   fib : PB.CLine[a+].Lines[Nl, DA0.QC].Fib = CRT.moveFib fbQy ;
  } ;
  fibQC : PB.CLine[a+].Lines[Nl, DA0.QC].Fib = QM.fib ;
  -- U(Pi_A Q) at the copy y, at the identity point
  fbPi0 : TR.G0.GB.CLine[a+].Lines[DA0.UPY, DA0.UPi].Fib = U4.fibU LA.PYy DA0.PiT.1 DA0.PiT.2 ;
  fbPiy : PB.CLine[a+].Lines[DA0.Cy.rCy DA0.UPY, DA0.Cy.rTy DA0.UPY DA0.UPi].Fib = CCopy8[a].FibR[R, encK, pe, DA0.UPY, DA0.UPi, fbPi0, y].fib ;
  idS : L.PSub[Nl, DA0.Cy.rCy DA0.UPY] = new L.PSub[Nl, DA0.Cy.rCy DA0.UPY, \ W o -> DA0.idy W, \ Vv W g o -> symH (DA0.idyR Vv W g)] ;
  PiS : L.PTy[Nl] = L.subTy Nl (DA0.Cy.rCy DA0.UPY) (DA0.Cy.rTy DA0.UPY DA0.UPi) idS ;
  fbPiS : PB.CLine[a+].Lines[Nl, PiS].Fib = PB.CFibSub[a+].FibSub[Nl, DA0.Cy.rCy DA0.UPY, idS, DA0.Cy.rTy DA0.UPY DA0.UPi].sub fbPiy ;
  module PM {
   module TA' = PB.GPre[a+].TyL[Nl, DA0.PiC] ;
   module TA = PB.GPre[a+].TyL[Nl, PiS] ;
   ta (W : Ob) (v : TA'.EI W) : TA.EI W = TA.pr W (TA'.pr1 W v) (TA'.pr2 W v) ;
   tanat (Vv W : Ob) (g : Hom Vv W) (v : TA'.EI W) : Id (TA.EI Vv) (TA.E.act Vv W g (ta W v)) (ta Vv (TA'.E.act Vv W g v)) =
    apH {V1.Ix (DA0.piTob Vv tt)} {TA.EI Vv} (TA.pr Vv (Nl.act Vv W g (TA'.pr1 W v)))
     (TR.G0.GB.GPre[a+].PS.tact-irr DA0.UPY DA0.UPi (DA0.Cy.o0 Vv) (DA0.Cy.o0 W) (DA0.Cy.h0 Vv W g) (DA0.idy W) (DA0.idy Vv)
        (L.ntEq Nl (DA0.Cy.rCy DA0.UPY) idS Vv W g (TA'.pr1 W v) (Nl.act Vv W g (TA'.pr1 W v)) (refl (Nl.act Vv W g (TA'.pr1 W v))))
        (DA0.idyR Vv W g) (TA'.pr2 W v)) ;
   tainj (W : Ob) (v v' : TA'.EI W) (Pp : Id (V1.Ix (Nl.ob W)) (TA'.pr1 W v) (TA'.pr1 W v')) (Q0 : Id (TA.EI W) (ta W v) (ta W v')) : Id (TA'.EI W) v v' = Q0 ;
   module CRT = PB.CCart[a+, a+].Cart[Nl, DA0.PiC, Nl, PiS, \ W o -> o, \ Vv W g d -> refl (Nl.act Vv W g d), ta, \ W v -> refl (TA'.pr1 W v),
     tanat, tainj, \ X x uu -> uu, \ X x uu -> refl (TA.pr X x uu)] ;
   fib : PB.CLine[a+].Lines[Nl, DA0.PiC].Fib = CRT.moveFib fbPiS ;
  } ;
  fibPiC : PB.CLine[a+].Lines[Nl, DA0.PiC].Fib = PM.fib ;
 } ;
} ;
