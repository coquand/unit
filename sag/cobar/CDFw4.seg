-- CDFw4.seg (canonicity-c2; (d)(1), part 4): the two valuations of
-- nil.Q_y^(m+n) over nil.HomT(x.u, y) (z at x.u's generators; fwd's (z . p_u,
-- new values)) agree at every generator (old: CDFw3, new: by reading), so ev_t
-- agrees at both for every term t (CDCg6).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module Fw4 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F3m = CDFw3[a].Fw3[R, encK, pe, x, u, y] ;
 module F2m = F3m.F2m ;
 module F1 = F3m.F1 ;
 module DE = F1.DE ;
 module C1 = F3m.C1 ;
 module S1 = F1.S1 ;
 module EV = S1.EV ;
 Nl : C.Ctx = C.nil ;
 n : Nat = F2m.n ;
 m : Nat = F1.m ;
 HU : C.Ty Nl = F1.HU ;
 D1 : C.Ctx = F1.D1 ;
 QYd : C.Ty D1 = DE.QYd ;
 lkTupS : (k : Nat) (i : SX.Fin k) (K : Ob) (g : SX.Fin k -> EV.QK K) -> Id (EV.QK K) (EV.lk k i K (S1.tup k K g)) (g i) = split {
  zero -> \ i K g -> absurd (Id (EV.QK K) (EV.lk zero i K (S1.tup zero K g)) (g i)) i ;
  suc k | r -> split {
   inl v -> \ K g -> r v K (\ v2 -> g (inl v2)) ;
   inr w -> \ K g -> DE.lkTT k K g w } } ;
 ok (j : SX.Fin n) (K : Ob) : (o : Top) (z : V1.Ix (HU.1.tob K o)) -> Id (DE.QK K (o, z)) ((F3m.U13m.ZA.apC (F3m.cv j)).eob K (o, z)) ((DE.evT (var (F2m.emb m j))).eob K (o, z)) =
  split { tt -> \ z -> transH (F3m.U13m.ZA.rdF (F3m.cv j) K (tt, z)) (symH (transH (DE.evTr (var (F2m.emb m j)) K z) (DE.lkTup (Arith[a].plus m n) (F2m.emb m j) K (DE.SO1.hval K z)))) } ;
 ok2 (j : SX.Fin n) (K : Ob) : (o : Top) (z : V1.Ix (HU.1.tob K o)) -> Id (DE.QK K (o, z)) ((F3m.U13m.ZA.apC (F3m.cp j)).eob K (o, z)) ((C1.ev2T (var (F2m.emb m j))).eob K (o, z)) =
  split { tt -> \ z ->
   transH (F3m.U13m.ZA.rdF (F3m.cp j) K (tt, z))
    (transH (apH {V1.Ix (F3m.QA.1.tob K tt)} {DE.QK K (tt, z)} (\ c -> DE.BZ.hv K tt z.1 c) (CAppRd[a].App0[F3m.AXx.Qt, F3m.QA, F3m.PM.Phi, F3m.AXx.cls (var j)].rd K tt))
      (symH (transH (C1.ev2Tr (var (F2m.emb m j)) K z)
         (transH (F2m.lkOld m K (S1.tup n K (S1.hval K ((F1.hX).eob K (tt, z)))) (F1.vvT K tt z) j)
            (lkTupS n j K (S1.hval K ((F1.hX).eob K (tt, z)))))))) } ;
 eqOld (j : SX.Fin n) : C.El D1 (C1.CE (var (F2m.emb m j))) =
  DE.rwId D1 QYd (F3m.U13m.ZA.apC (F3m.cv j)) (DE.evT (var (F2m.emb m j))) (F3m.U13m.ZA.apC (F3m.cp j)) (C1.ev2T (var (F2m.emb m j)))
   (\ K w -> ok j K w.1 w.2) (\ K w -> ok2 j K w.1 w.2)
   (PT.symM D1 QYd (F3m.U13m.ZA.apC (F3m.cp j)) (F3m.U13m.ZA.apC (F3m.cv j)) (F3m.aA j)) ;
 -- new generators: both valuations read z at the generator
 nk (j : SX.Fin m) (K : Ob) : (o : Top) (z : V1.Ix (HU.1.tob K o)) -> Id (DE.QK K (o, z)) ((DE.evT (var (F2m.newI m j))).eob K (o, z)) ((C1.ev2T (var (F2m.newI m j))).eob K (o, z)) =
  split { tt -> \ z ->
   transH (DE.evTr (var (F2m.newI m j)) K z)
    (transH (DE.lkTup (Arith[a].plus m n) (F2m.newI m j) K (DE.SO1.hval K z))
      (symH (transH (C1.ev2Tr (var (F2m.newI m j)) K z)
         (F2m.lkNew m K (S1.tup n K (S1.hval K ((F1.hX).eob K (tt, z)))) (DE.SO1.hval K z) j)))) } ;
 eqNew (j : SX.Fin m) : C.El D1 (C1.CE (var (F2m.newI m j))) =
  DE.rwId D1 QYd (DE.evT (var (F2m.newI m j))) (DE.evT (var (F2m.newI m j))) (DE.evT (var (F2m.newI m j))) (C1.ev2T (var (F2m.newI m j)))
   (\ K w -> refl ((DE.evT (var (F2m.newI m j))).eob K w)) (\ K w -> nk j K w.1 w.2) (IJ.rfl D1 QYd (DE.evT (var (F2m.newI m j)))) ;
 -- every generator
 eqC (i : F2m.Fk m) : F2m.Cls m i -> C.El D1 (C1.CE (var i)) = split {
  inl c -> subst (F2m.Fk m) (\ v -> C.El D1 (C1.CE (var v))) (F2m.emb m c.1) i (symH c.2) (eqOld c.1) ;
  inr c -> subst (F2m.Fk m) (\ v -> C.El D1 (C1.CE (var v))) (F2m.newI m c.1) i (symH c.2) (eqNew c.1) } ;
 eqV (i : F2m.Fk m) : C.El D1 (C1.CE (var i)) = eqC i (F2m.cls m i) ;
 module CG = CDCg6[a].Cg6[R, encK, pe, F1.xu, y, F1.s2].Rec[eqV] ;
 cg (t : SX.Over[R].Expr (F2m.Fk m)) : C.El D1 (C1.CE t) = CG.cg t ;
} ;
