-- CTotP13d.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part d: the levelwise input.  From an equivalence structure ef of
-- U f (f restricted to the levelwise site) to a contraction al of U of the
-- homotopy fibre Pt of f (CTotP13b), the input of c2's Lemma 12:
--   Uf      f restricted
--   mS      a point of U Pt restricted to one of Uf's homotopy fibre (the
--           path restricted by rho), natural (mSnat), injective over equal
--           points (mTinj: rho-inj on lines of G.B)
--   BK      the way back: the path extended (extV), its conditions from
--           rho-ext and, for the base, rho-inj on lines of G
--   al      ef moved by CMove.Mv; k = Lemma 12 at al
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module P13d (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PB13 = CTotP13b[a, vl, l].P13b[C, G, A, B, f] ;
 module TR = PB13.TR ;
 module G0 = TR.G0 ;
 module G1 = TR.G1 ;
 module TC = PB13.TC ;
 module RN = TR.RN ;
 Ob0 : U vl = RN.Ob0 ;
 GP : TR.P1.PCtx = PB13.GP ;
 UG : TR.P0.PCtx = TR.RS.rC GP ;
 UA : TR.P0.PTy[UG] = TR.RS.rT GP A ;
 UB : TR.P0.PTy[UG] = TR.RS.rT GP B ;
 Uf : G0.GB.CPartial[l].PMap[UG, UA, UB] =
  G0.GB.CPartial[l].mkPMap UG UA UB (\ Y w -> f.mE (RN.o Y) w) (\ Y w -> f.mpt (RN.o Y) w)
   (\ Z Y h w -> f.mnat (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) w) ;
 module H = PB13.H ;
 module H0 = G0.GB.CEquiv[l].HFib[UG, UA, UB, Uf] ;
 EB : TR.P1.PCtx = H.EA ;
 module XE = CTotUExt[a, vl, l].UExt[C].FI.XG[EB] ;
 module XG = CTotUExt[a, vl, l].UExt[C].FI.XG[GP] ;
 DU : TR.P0.PCtx = TR.RS.rC (TC.toP PB13.G') ;
 SU : TR.P0.PTy[DU] = TR.RS.rT (TC.toP PB13.G') PB13.Pt ;
 module TSU = G0.GB.GPre[l].TyL[DU, SU] ;

 module MS (W : Ob0) (v : TSU.EI W) {
  w : H.TA.EI (RN.o W) = H.TF.pr1 (RN.o W) v ;
  b : W0.Ix (A.tob (RN.o W) (H.TA.pr1 (RN.o W) w)) = (H.TF.pr2 (RN.o W) v).1 ;
  Lt : W0.Ix (XE.RH.F1.ob (RN.o W)) = (H.TF.pr2 (RN.o W) v).2.1 ;
  L0 : W0.Ix (XE.RH.F0.ob W) = XE.RH.rhoV W Lt ;
  res : H0.TF.EI W = H0.mkFib W w b (\ Z h i -> L0.1 Z h i) (\ V Z g h i -> L0.2 V Z g h i)
    (\ Z h i -> H.fibL-pt (RN.o W) v (RN.o Z) (TR.fn.onH Z W h) i)
    (transH (apH {RN.Hom1 (RN.o W) (RN.o W)} {H.TA.EI (RN.o W)} (\ k -> Lt.1 (RN.o W) k (G0.GB.ptH W G0.GB.e0)) (TR.fn.onId W)) (H.fibL-0 (RN.o W) v))
    (transH (apH {RN.Hom1 (RN.o W) (RN.o W)} {H.TA.EI (RN.o W)} (\ k -> Lt.1 (RN.o W) k (G0.GB.ptH W G0.GB.e1)) (TR.fn.onId W)) (H.fibL-1 (RN.o W) v)) ;
 } ;
 mS (W : Ob0) (v : TSU.EI W) : H0.TF.EI W = MS[W, v].res ;
 mSnat (V W : Ob0) (g : RN.Hom0 V W) (v : TSU.EI W) : Id (H0.TF.EI V) (H0.TF.E.act V W g (mS W v)) (mS V (TSU.E.act V W g v)) =
  H0.fibE-eq V (H0.TF.E.act V W g (mS W v)) (mS V (TSU.E.act V W g v)) (refl (H0.TF.pr1 V (H0.TF.E.act V W g (mS W v))))
   (transH (H0.fibB-act V W g (mS W v)) (symH (H.fibB-act (RN.o V) (RN.o W) (TR.fn.onH V W g) v)))
   (\ Z h i -> transH (H0.fibL-act V W g (mS W v) Z h i)
      (apH {RN.Hom1 (RN.o Z) (RN.o W)} {H.TA.EI (RN.o Z)} (\ k -> MS[W, v].Lt.1 (RN.o Z) k i) (TR.fn.onComp Z V W g h))) ;
 module Inj (W : Ob0) (v v' : TSU.EI W) (P : Id (W0.Ix (DU.ob W)) (TSU.pr1 W v) (TSU.pr1 W v')) (Q : Id (H0.TF.EI W) (mS W v) (mS W v')) {
  L0eq : Id (W0.Ix (XE.RH.F0.ob W)) MS[W, v].L0 MS[W, v'].L0 =
   XE.RH.F0.fam-eq W MS[W, v].L0 MS[W, v'].L0 (\ Z h i -> apH {H0.TF.EI W} {H0.TA.EI Z} (\ T -> H0.fibL W T Z h i) Q) ;
  Lteq : Id (W0.Ix (XE.RH.F1.ob (RN.o W))) MS[W, v].Lt MS[W, v'].Lt = XE.rho-inj W MS[W, v].Lt MS[W, v'].Lt L0eq ;
  law : Id (TSU.EI W) v v' =
   H.fibE-eq (RN.o W) v v' P (apH {H0.TF.EI W} {H0.TB.EI W} (H0.fibB W) Q)
    (\ Z k i -> apH {W0.Ix (XE.RH.F1.ob (RN.o W))} {H.TA.EI Z} (\ M -> M.1 Z k i) Lteq) ;
 } ;
 module BK (X : Ob0) (x : W0.Ix (DU.ob X)) (u : W0.Ix (H0.FibT.tob X x)) {
  b : W0.Ix (A.tob (RN.o X) (H.TA.pr1 (RN.o X) x)) = u.1 ;
  L0 : W0.Ix (XE.RH.F0.ob X) = u.2.1 ;
  L1 : W0.Ix (XE.RH.F1.ob (RN.o X)) = XE.extV X L0 ;
  rr : Id (W0.Ix (XE.RH.F0.ob X)) (XE.RH.rhoV X L1) L0 = XE.rho-ext X L0 ;
  -- the base of the extended path is the constant line
  p1 : W0.Ix (XG.RH.F1.ob (RN.o X)) =
   (\ W k i -> H.TA.pr1 W (L1.1 W k i), \ V W g k i -> apH {H.TA.EI V} {W0.Ix (GP.ob V)} (H.TA.pr1 V) (L1.2 V W g k i)) ;
  c1 : W0.Ix (XG.RH.F1.ob (RN.o X)) = XG.RH.F1.constF (RN.o X) (H.TA.pr1 (RN.o X) x) ;
  pv (Z : Ob0) (k : RN.Hom0 Z X) (i : G0.GB.IvP Z) : Id (W0.Ix (UG.ob Z)) ((XG.RH.rhoV X p1).1 Z k i) ((XG.RH.rhoV X c1).1 Z k i) =
   transH (apH {W0.Ix (XE.RH.F0.ob X)} {W0.Ix (GP.ob (RN.o Z))} (\ M -> H.TA.pr1 (RN.o Z) (M.1 Z k i)) rr) (u.2.2.1 Z k i) ;
  peq : Id (W0.Ix (XG.RH.F1.ob (RN.o X))) p1 c1 = XG.rho-inj X p1 c1 (XG.RH.F0.fam-eq X (XG.RH.rhoV X p1) (XG.RH.rhoV X c1) pv) ;
  tp (W : RN.Ob1) (k : RN.Hom1 W (RN.o X)) (i : G1.GB.IvP W) : Id (W0.Ix (GP.ob W)) (H.TA.pr1 W (L1.1 W k i)) (GP.act W (RN.o X) k (H.TA.pr1 (RN.o X) x)) =
   apH {W0.Ix (XG.RH.F1.ob (RN.o X))} {W0.Ix (GP.ob W)} (\ M -> M.1 W k i) peq ;
  -- the ends
  t0 : Id (H.TA.EI (RN.o X)) (L1.1 (RN.o X) (G1.GB.BC.idC (RN.o X)) (G1.GB.ptH (RN.o X) G1.GB.e0)) (f.mE (RN.o X) (H.TB.pr (RN.o X) (H.TA.pr1 (RN.o X) x) b)) =
   transH (apH {RN.Hom1 (RN.o X) (RN.o X)} {H.TA.EI (RN.o X)} (\ k -> L1.1 (RN.o X) k (G1.GB.ptH (RN.o X) G1.GB.e0)) (symH (TR.fn.onId X)))
    (transH (apH {W0.Ix (XE.RH.F0.ob X)} {H.TA.EI (RN.o X)} (\ M -> M.1 X (G0.GB.BC.idC X) (G0.GB.ptH X G0.GB.e0)) rr) u.2.2.2.1) ;
  t1 : Id (H.TA.EI (RN.o X)) (L1.1 (RN.o X) (G1.GB.BC.idC (RN.o X)) (G1.GB.ptH (RN.o X) G1.GB.e1)) x =
   transH (apH {RN.Hom1 (RN.o X) (RN.o X)} {H.TA.EI (RN.o X)} (\ k -> L1.1 (RN.o X) k (G1.GB.ptH (RN.o X) G1.GB.e1)) (symH (TR.fn.onId X)))
    (transH (apH {W0.Ix (XE.RH.F0.ob X)} {H.TA.EI (RN.o X)} (\ M -> M.1 X (G0.GB.BC.idC X) (G0.GB.ptH X G0.GB.e1)) rr) u.2.2.2.2) ;
  path : W0.Ix (H.PE.tobP (RN.o X) (H.TAB.pr (RN.o X) x b)) =
   H.PE.mkPath (RN.o X) (H.TAB.pr (RN.o X) x b) (\ W k i -> L1.1 W k i) (\ V W g k i -> L1.2 V W g k i) tp t0 t1 ;
  res : W0.Ix (H.FibT.tob (RN.o X) x) = (b, path) ;
  -- moved, it is u
  mv : Id (H0.TF.EI X) (mS X (TSU.pr X x res)) (H0.TF.pr X x u) =
   H0.fibE-eq X (mS X (TSU.pr X x res)) (H0.TF.pr X x u) (refl x) (refl (H0.fibB X (H0.TF.pr X x u)))
    (\ Z h i -> apH {W0.Ix (XE.RH.F0.ob X)} {H0.TA.EI Z} (\ M -> M.1 Z h i) rr) ;
 } ;
 module AL (ef : G0.GB.CEquiv[l].EquivOp UG UA UB Uf) {
  module M = G0.GB.CMove[l, l].Mv[DU, SU, SU, G0.GB.CPartial[l].pmap-id DU SU,
    H0.EA, H0.FibT, H0.FibT, G0.GB.CPartial[l].pmap-id H0.EA H0.FibT,
    \ W x -> x, \ V W g x -> refl (H0.EA.act V W g x),
    \ W v -> mS W v, \ W v -> refl (TSU.pr1 W v), \ V W g v -> mSnat V W g v,
    \ W v -> mS W v, \ W v -> refl (TSU.pr1 W v), \ V W g v -> mSnat V W g v,
    \ W v v' P Q -> Inj[W, v, v', P, Q].law,
    \ X x u -> BK[X, x, u].res, \ X x u -> BK[X, x, u].mv,
    \ W v -> refl (mS W v), ef] ;
  al : G0.GB.CPartial[l].ContrOp DU SU = M.rc ;
  k : G1.GB.CPartial[l].ContrOp (TC.toP PB13.LZ.D.DCtx) PB13.LZ.DA.DTy = PB13.LZ.lemma12 al ;
 } ;
} ;
