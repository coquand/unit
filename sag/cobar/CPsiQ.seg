-- CPsiQ.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', over the empty
-- context, tau' = tau . phi : Q_y' -> G's fibres (E1's map, CE1Copy) has the
-- quasi-inverse psi = eval . eps_T (CPsiC): psi . tau' ~ id on Q (CPsiC's
-- eps . tau ~ id, then phi . eval ~ id, CReadA) and tau' . psi ~ id on G
-- (eval . phi ~ id on codes from c2's eta and beta . alpha = id, then CPsiC's
-- tau . eps ~ id).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module PQ (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module GR = CGRing[a].GR[R, encK, pe] ;
 module RA = CReadA[a].RA[R, encK, pe, GR.al, \ y -> GR.AE[y].A.eqal, \ y -> GR.AE[y].A.commH, y'] ;
 module FTp = CFibTc[a].Plug[R, encK, pe, GR.al, \ y -> GR.AE[y].A.eqal, \ y -> GR.AE[y].A.commH, y'] ;
 module PC = CPsiC[a].PC[R, encK, pe, y'] ;
 module RD = RA.RD ;
 module TP = RA.TP ;
 module HO = PB.CHtpyOps[a+] ;
 Nl : L.PCtx = PC.Nl ;
 Qc : L.PTy[Nl] = RA.Qc ;
 Ac : L.PTy[Nl] = PC.Ac ;
 Tc : L.PTy[Nl] = PC.Tc ;
 phi : HO.NMap[Nl, Qc, Ac] = RA.phi ;
 evc : HO.NMap[Nl, Ac, Qc] = RA.evc ;
 tau' : HO.NMap[Nl, Qc, Tc] = HO.compN Nl Qc Ac Tc phi PC.tauT ;
 psi : HO.NMap[Nl, Tc, Qc] = HO.compN Nl Tc Ac Qc PC.epsT evc ;
 -- psi . tau' ~ id on Q
 module A1 = HO.WR[Nl, Ac, Ac, Qc, HO.compN Nl Ac Tc Ac PC.tauT PC.epsT, HO.idN Nl Ac, phi, PC.et] ;
 module A2 = HO.WL[Nl, Qc, Ac, Qc, HO.compN Nl Qc Ac Ac phi (HO.compN Nl Ac Tc Ac PC.tauT PC.epsT), HO.compN Nl Qc Ac Ac phi (HO.idN Nl Ac), evc, A1.res] ;
 module A3 = HO.Ret[Nl, Qc, Qc, HO.compN Nl Qc Ac Qc (HO.compN Nl Qc Ac Ac phi (HO.compN Nl Ac Tc Ac PC.tauT PC.epsT)) evc, HO.compN Nl Qc Ac Qc (HO.compN Nl Qc Ac Ac phi (HO.idN Nl Ac)) evc,
   HO.compN Nl Qc Tc Qc tau' psi, HO.compN Nl Qc Ac Qc phi evc, \ I o q -> refl ((HO.compN Nl Qc Tc Qc tau' psi).nfun I o q), \ I o q -> refl ((HO.compN Nl Qc Ac Qc phi evc).nfun I o q), A2.res] ;
 module A4 = HO.Cat[Nl, Qc, Qc, HO.compN Nl Qc Tc Qc tau' psi, HO.compN Nl Qc Ac Qc phi evc, HO.idN Nl Qc, RD.cQ, A3.res, RA.phiev] ;
 epsQ : L.PEl[L.extP Nl Qc, HO.HT[Nl, Qc, Qc, HO.compN Nl Qc Tc Qc tau' psi, HO.idN Nl Qc].PT.PathP] = A4.res ;
 -- eval . phi ~ id on codes (c2's eta, beta . alpha = id)
 HT1 : L.PTy[Nl] = RD.HT.1 ;
 module B1 = HO.WR[Nl, HT1, HT1, Ac, HO.compN Nl HT1 Qc HT1 RD.evN RD.PH.invN, HO.idN Nl HT1, RD.alphaN, TP.eta] ;
 module B2 = HO.WL[Nl, Ac, HT1, Ac, HO.compN Nl Ac HT1 HT1 RD.alphaN (HO.compN Nl HT1 Qc HT1 RD.evN RD.PH.invN), HO.compN Nl Ac HT1 HT1 RD.alphaN (HO.idN Nl HT1), RD.PH.betaN, B1.res] ;
 module B3 = HO.Ret[Nl, Ac, Ac, HO.compN Nl Ac HT1 Ac (HO.compN Nl Ac HT1 HT1 RD.alphaN (HO.compN Nl HT1 Qc HT1 RD.evN RD.PH.invN)) RD.PH.betaN,
   HO.compN Nl Ac HT1 Ac (HO.compN Nl Ac HT1 HT1 RD.alphaN (HO.idN Nl HT1)) RD.PH.betaN,
   HO.compN Nl Ac Qc Ac evc phi, HO.idN Nl Ac, \ I o c -> refl ((HO.compN Nl Ac Qc Ac evc phi).nfun I o c), \ I o c -> RD.ba I o c, B2.res] ;
 -- tau' . psi ~ id on G's fibres
 module B4 = HO.WR[Nl, Ac, Ac, Tc, HO.compN Nl Ac Qc Ac evc phi, HO.idN Nl Ac, PC.epsT, B3.res] ;
 module B5 = HO.WL[Nl, Tc, Ac, Tc, HO.compN Nl Tc Ac Ac PC.epsT (HO.compN Nl Ac Qc Ac evc phi), HO.compN Nl Tc Ac Ac PC.epsT (HO.idN Nl Ac), PC.tauT, B4.res] ;
 module B6 = HO.Ret[Nl, Tc, Tc, HO.compN Nl Tc Ac Tc (HO.compN Nl Tc Ac Ac PC.epsT (HO.compN Nl Ac Qc Ac evc phi)) PC.tauT, HO.compN Nl Tc Ac Tc (HO.compN Nl Tc Ac Ac PC.epsT (HO.idN Nl Ac)) PC.tauT,
   HO.compN Nl Tc Qc Tc psi tau', HO.compN Nl Tc Ac Tc PC.epsT PC.tauT,
   \ I o w -> refl ((HO.compN Nl Tc Qc Tc psi tau').nfun I o w), \ I o w -> refl ((HO.compN Nl Tc Ac Tc PC.epsT PC.tauT).nfun I o w), B5.res] ;
 module B7 = HO.Cat[Nl, Tc, Tc, HO.compN Nl Tc Qc Tc psi tau', HO.compN Nl Tc Ac Tc PC.epsT PC.tauT, HO.idN Nl Tc, FTp.cTp, B6.res, PC.te] ;
 etaT : L.PEl[L.extP Nl Tc, HO.HT[Nl, Tc, Tc, HO.compN Nl Tc Qc Tc psi tau', HO.idN Nl Tc].PT.PathP] = B7.res ;
} ;
