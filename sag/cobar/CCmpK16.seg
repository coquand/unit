-- CCmpK16.seg (canonicity-c2; (K) for cmpI, part 16): as CCmpK14 for the
-- second components (CCmpK15.B12), and the Id c_2 = g_2
-- over GS by injectivity of ev (CCmpK10).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module K16 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K15m = CCmpK15[a].K15[R, encK, pe, y] ;
 module K12m = K15m.K12m ;
 module K1m = K12m.K1m ;
 module QS = K12m.QS ;
 module E1m = K15m.E1m ;
 module G = K15m.G ;
 module MB = K15m.MB ;
 module ME = K15m.ME ;
 module MZ = K12m.MZ ;
 Nl : C.Ctx = C.nil ;
 GS : C.Ctx = K12m.GS ;
 QY : C.Ty Nl = K12m.QY ;
 HS : C.Ty Nl = K12m.HS ;
 HTT : C.Ty Nl = K12m.HTT ;
 s0 : C.Sub GS Nl = K12m.s0 ;
 QS0 : C.Ty GS = K15m.QS0 ;
 HS0 : C.Ty GS = C.subT GS Nl HS s0 ;
 HTT0 : C.Ty GS = C.subT GS Nl HTT s0 ;
 zr (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (HS0.1.tob K w)) (K12m.z.eob K w) (K1m.zob w.1.2.1 w.2.1 K w.1.1.1) =
  transH (CAppRd[a].trE-rd GS (C.subT GS K1m.DP (OV.wkT Nl K1m.TP HS) K12m.tau) HS0 MZ.P (C.subt GS K1m.DP (OV.wkT Nl K1m.TP HS) K1m.zfam K12m.tau) K w)
   (CAppRd[a].same-rd GS (C.subT GS K1m.DP (OV.wkT Nl K1m.TP HS) K12m.tau) HS0 MZ.P K w (refl (HS0.1.tob K w)) (K1m.zfam.eob K (K12m.tauN K w))) ;
 gr (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (HTT0.1.tob K w)) (K12m.gv.eob K w) w.1.1.2 = refl w.1.1.2 ;
 -- the left end: z_t (Phi_1 cx)
 lA0 (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (QS0.1.tob K w)) ((MB.el K1m.Fam[QY, G.c1].el).eob K w) ((G.c1 w.1.2.1 w.2.1).eob K w.1.1.1) =
  transH (CAppRd[a].trE-rd GS (C.subT GS K1m.DP (OV.wkT Nl K1m.TP QY) K12m.tau) QS0 MB.P (C.subt GS K1m.DP (OV.wkT Nl K1m.TP QY) (K1m.Fam[QY, G.c1].el) K12m.tau) K w)
   (CAppRd[a].same-rd GS (C.subT GS K1m.DP (OV.wkT Nl K1m.TP QY) K12m.tau) QS0 MB.P K w (refl (QS0.1.tob K w)) ((K1m.Fam[QY, G.c1].el).eob K (K12m.tauN K w))) ;
 lA1 (K : Ob) : (o : Top) (s1 s2 : K1m.TmY) -> Id (V1.Ix (QY.1.tob K o)) ((G.c1 s1 s2).eob K o) (E1m.nf K o (K12m.K9m.CI.Q2.nf K o (K1m.zob s1 s2 K o))) =
  split { tt -> \ s1 s2 ->
   transH (CAppRd[a].App0[K15m.K11m.QA, QY, K15m.K11m.Phi s1 s2, G.cP].rd K tt)
    (apH {V1.Ix (K15m.K11m.QA.1.tob K tt)} {V1.Ix (QY.1.tob K tt)} (\ u -> ((K15m.K11m.Phi s1 s2).eob K tt).1 K (idH K) u)
      (CAppRd[a].App0[E1m.QA, K15m.K11m.QA, K15m.K11m.SM2.Phi, K15m.K11m.cx].rd K tt)) } ;
 lA (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (QS0.1.tob K w)) ((MB.el K1m.Fam[QY, G.c1].el).eob K w) ((E1m.evS GS s0 K12m.c2).eob K w) =
  transH (lA0 K w) (transH (lA1 K w.1.1.1 w.1.2.1 w.2.1)
   (apH {V1.Ix (HS0.1.tob K w)} {V1.Ix (QS0.1.tob K w)} (\ v -> E1m.nf K w.1.1.1 (K12m.K9m.CI.Q2.nf K w.1.1.1 v)) (symH (zr K w)))) ;
 -- the right end: a_1 = ev g_1
 lB (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (QS0.1.tob K w)) ((ME.el QS.qE).eob K w) ((E1m.evS GS s0 K12m.g2).eob K w) =
  transH (CAppRd[a].trE-rd GS (C.subT GS QS.E QS.T0 K12m.pi2) QS0 ME.P (C.subt GS QS.E QS.T0 QS.qE K12m.pi2) K w)
   (transH (CAppRd[a].same-rd GS (C.subT GS QS.E QS.T0 K12m.pi2) QS0 ME.P K w (refl (QS0.1.tob K w)) (QS.qE.eob K (K12m.pi2N K w)))
     (apH {V1.Ix (HTT0.1.tob K w)} {V1.Ix (QS0.1.tob K w)} (\ v -> E1m.nf K w.1.1.1 v.2) (symH (gr K w)))) ;
 e2 : C.El GS (IJ.IdT GS QS0 (E1m.evS GS s0 K12m.c2) (E1m.evS GS s0 K12m.g2)) =
  CCmpU14[a].rwId GS QS0 (MB.el K1m.Fam[QY, G.c1].el) (E1m.evS GS s0 K12m.c2) (ME.el QS.qE) (E1m.evS GS s0 K12m.g2) lA lB K15m.B12 ;
 id2 : C.El GS (IJ.IdT GS (C.subT GS Nl K12m.HT s0) K12m.c2 K12m.g2) = K15m.K10m.At[GS, s0, K12m.c2, K12m.g2, e2].res ;
} ;
