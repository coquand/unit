-- CTotP13c.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part c: Psi of a constant line is the constant line.  For d a point
-- of D G at X and the constant line at d, Psi at an index q (CTotPsi2's
-- psi_q) is the constant line of G at d's value at q:
--   rd      the reading of the constant line at a cartesian lift is d at
--           the index of the chain (D's action at the moved index, c2's
--           CTotL12ch.Cart.law through sEq)
--   L0eq    Psi's levelwise line is the restriction of the constant line
--           (D's naturality equation, after path induction on the
--           levelwise map's equation)
--   psiC    psi_q = the constant line (CTotUExt's ext-rho)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module ConstL (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) {
 module P2 = CTotPsi2[a, vl, l].Psi2[C, G] ;
 module PO = P2.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module D = PO.D ;
 module DO = PO.DO ;
 module CT = PO.CT ;
 module CL = PO.CL ;
 module XB = P2.XB ;
 module RH = XB.RH ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;
 module At (X : TC.TOb) (d : D.Ob' X.1 X.2) {
  ln : W0.Ix (PO.FL.ob X) = PO.FL.constF X d ;
  -- the reading at a cartesian lift
  rd (n : Nat) (W1 : Ob) (y : Obj W1) (U0 : Hom W1 X.1) (cc : CT.Ch W1 n (C.res W1 X.1 U0 X.2) y) (R : Wt.Pn n W1) (j : PB.IvP W1)
   : Id (W0.Ix (G.ob W1 y)) (PO.PL[X, ln].rdC n W1 y U0 cc R j) (d.1 (n, W1, U0, y, cc, R.1) R.2) =
   apH {D.S X.1 X.2 n W1 y} {W0.Ix (G.ob W1 y)} (\ sw -> D.rd X.1 X.2 d.1 n W1 y R.1 sw R.2)
    (D.sEq X.1 X.2 n W1 y (compH W1 W1 X.1 U0 (idH W1)) U0 (comp-idr W1 X.1 U0)
       (CT.rxM W1 W1 X.1 (idH W1) U0 (C.res W1 X.1 U0 X.2) X.2 (CL.Cart[W1, X.1, U0, X.2, n, y, cc].g0) n y (CL.Cart[W1, X.1, U0, X.2, n, y, cc].ch)) cc
       (CL.Cart[W1, X.1, U0, X.2, n, y, cc].law)) ;
  module Q (n : Nat) (J : Ob) (u : Hom J X.1) (z : Obj J) (c : CT.Ch J n (C.res J X.1 u X.2) z) (i : Wt.Pn n J) {
   module PQ = P2.PQ[X, ln, n, J, u, z, c, i] ;
   q : DO.Idx X.1 X.2 = (n, J, u, z, c, i.1) ;
   dq : W0.Ix (G.ob J z) = d.1 q i.2 ;
   Y : TR.RN.Ob0 = (J, z) ;
   cl : W0.Ix (RH.F1.ob (TR.RN.o Y)) = RH.F1.constF (TR.RN.o Y) dq ;
   -- d at a restricted index is G's cartesian action on dq, along any equation of the object
   M (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y)
    : Id (W0.Ix (G.ob W1 y)) (d.1 (n, W1, compH W1 J X.1 u v, y, PQ.cT W1 v y e, (Wt.Res[n, W1, J, v, i].res).1) (Wt.Res[n, W1, J, v, i].res).2)
         (G.act W1 J v y z (PO.VT.trD W1 J v (C.res W1 J v z) y e z (C.cart W1 J v z)) dq) =
    idJ (Obj W1) (C.res W1 J v z)
     (\ y2 e2 -> Id (W0.Ix (G.ob W1 y2)) (d.1 (n, W1, compH W1 J X.1 u v, y2, PQ.cT W1 v y2 e2, (Wt.Res[n, W1, J, v, i].res).1) (Wt.Res[n, W1, J, v, i].res).2)
                   (G.act W1 J v y2 z (PO.VT.trD W1 J v (C.res W1 J v z) y2 e2 z (C.cart W1 J v z)) dq))
     (symH (d.2.1 (q, (W1, v)) i.2)) y e ;
   valEq (W : TR.RN.Ob0) (h : TR.RN.Hom0 W Y) (j : PB.IvP W.1)
    : Id (W0.Ix (G.ob W.1 W.2)) (PQ.L0.1 W h j) ((RH.rhoV Y cl).1 W h j) =
    transH (rd n W.1 W.2 (compH W.1 J X.1 u h.1) (PQ.cT W.1 h.1 W.2 (symH h.2)) (Wt.Res[n, W.1, J, h.1, i].res) j)
     (M W.1 h.1 W.2 (symH h.2)) ;
   L0eq : Id (W0.Ix (RH.F0.ob Y)) PQ.L0 (RH.rhoV Y cl) = RH.F0.fam-eq Y PQ.L0 (RH.rhoV Y cl) valEq ;
   psiC : Id (W0.Ix (RH.F1.ob (TR.RN.o Y))) PQ.psiq cl =
    transH (apH {W0.Ix (RH.F0.ob Y)} {W0.Ix (RH.F1.ob (TR.RN.o Y))} (XB.extV Y) L0eq) (XB.ext-rho Y cl) ;
  } ;
 } ;
} ;
