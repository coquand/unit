-- CPshPi.seg (canonicity-c2; COBAR.md "Plan: Lemma 54", (B) stage 2(c)):
-- dependent products of C-types, PSh(C) over the cubical base.
--
-- For A : CTy[G] and B : CTy[G.A], write Pi_y for the base product of
-- A_y and B_y (PresheafPi).  An element of (Pi_A B)_x at stage X over
-- gm is a family
--
--   b y f : Pi_y (X , act f gm)            (y in C , f : y -> x)
--
-- which is natural in C (CNat): for g : z -> y, a stage h : Y -> X and a
-- in A_y over (act f gm) h, the action of B along g sends the value of
-- b y f at (h , a) to the value of b z (f g) at (h , a'), where a' is a
-- moved along g.  The base direction (h and its naturality) is inside
-- Pi_y; only the C-direction is new.  So Pi_A B is the part of
-- eta^* R (Pi_y)_y cut out by CNat.
--
--   ptC , ptH      the points act f gm and (act f gm) h
--   Comp , val     the families b and their values b y f (h , a)
--   mvA , aM       the total (pt , a) moved along g, and a' over the point
--                  (act (f g) gm) h
--   CNat           naturality in C, an equation between totals of B_z
--   PiIx , piO     the fibre and its code: the code of the families with
--                  the truth value of CNat (propV)
--   pi-eq          elements are determined by their values
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module VL = VLift[a, l] ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;

module PiOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module RR = CPshR[a, l].RR[C] ;
 open P ;

 -- the truth value of a proposition, as a code; equivalent propositions
 -- have the same truth value (extensionality of iterative sets)
 propV (Q : U l) (pq : isProp Q) : W0.V = W0.mkV Q (\ p -> W0.emptyV) (\ p p' r -> pq p p') ;
 propV-ext (Q Q' : U l) (pq : isProp Q) (pq' : isProp Q') (to : Q -> Q') (from : Q' -> Q) : Id W0.V (propV Q pq) (propV Q' pq') =
  Sigma-eq W0.M W0.isIt (propV Q pq).1 (propV Q' pq').1 (propV Q pq).2 (propV Q' pq').2
   (W0.ext (propV Q pq).1 (propV Q' pq').1 (propV Q pq).2 (propV Q' pq').2
      (\ z -> (\ m -> (to m.1, m.2), \ m -> (from m.1, m.2))))
   (W0.isProp-isIt (propV Q' pq').1) ;

 module PiC (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) {
  E : CCtx = LO.ExtC G A ;
  -- the base product at y
  PiB (y : CO) : PTy[G.ob y] = PP.PiCode[G.ob y, A.ty y, B.ty y].PiP ;

  -- totals of A and of B
  TA (y : CO) (Y : Ob) : U l = SigT (G.ob y) (A.ty y) Y ;
  TB (y : CO) (Y : Ob) : U l = SigT (E.ob y) (B.ty y) Y ;
  prA (y : CO) (Y : Ob) (p : W0.Ix ((G.ob y).ob Y)) (a : W0.Ix ((A.ty y).tob Y p)) : TA y Y = pairE (G.ob y) (A.ty y) Y p a ;
  prB (y : CO) (Y : Ob) (w : TA y Y) (v : W0.Ix ((B.ty y).tob Y w)) : TB y Y = pairE (E.ob y) (B.ty y) Y w v ;

  -- an element of Pi_y moved along a path of points: its values
  coeVal (y : CO) (X : Ob) (p p' : W0.Ix ((G.ob y).ob X)) (q : Id (W0.Ix ((G.ob y).ob X)) p p')
   (u : W0.Ix ((PiB y).tob X p)) (Y : Ob) (h : Hom Y X) (a : W0.Ix ((A.ty y).tob Y ((G.ob y).act Y X h p')))
   (r : Id (W0.Ix ((G.ob y).ob Y)) ((G.ob y).act Y X h p') ((G.ob y).act Y X h p))
   : Id (TB y Y)
       (prB y Y (prA y Y ((G.ob y).act Y X h p') a) ((GPR.TyL[G.ob y, PiB y].coeT X p p' q u).1 Y h a))
       (prB y Y (prA y Y ((G.ob y).act Y X h p) (GPR.TyL[G.ob y, A.ty y].coeT Y ((G.ob y).act Y X h p') ((G.ob y).act Y X h p) r a))
          (u.1 Y h (GPR.TyL[G.ob y, A.ty y].coeT Y ((G.ob y).act Y X h p') ((G.ob y).act Y X h p) r a))) =
   idJ (W0.Ix ((G.ob y).ob X)) p
    (\ p1 q1 -> (a1 : W0.Ix ((A.ty y).tob Y ((G.ob y).act Y X h p1)))
       (r1 : Id (W0.Ix ((G.ob y).ob Y)) ((G.ob y).act Y X h p1) ((G.ob y).act Y X h p))
       -> Id (TB y Y)
           (prB y Y (prA y Y ((G.ob y).act Y X h p1) a1) ((GPR.TyL[G.ob y, PiB y].coeT X p p1 q1 u).1 Y h a1))
           (prB y Y (prA y Y ((G.ob y).act Y X h p) (GPR.TyL[G.ob y, A.ty y].coeT Y ((G.ob y).act Y X h p1) ((G.ob y).act Y X h p) r1 a1))
              (u.1 Y h (GPR.TyL[G.ob y, A.ty y].coeT Y ((G.ob y).act Y X h p1) ((G.ob y).act Y X h p) r1 a1))))
    (\ a1 r1 -> apH (\ r0 -> prB y Y (prA y Y ((G.ob y).act Y X h p) (GPR.TyL[G.ob y, A.ty y].coeT Y ((G.ob y).act Y X h p) ((G.ob y).act Y X h p) r0 a1))
                              (u.1 Y h (GPR.TyL[G.ob y, A.ty y].coeT Y ((G.ob y).act Y X h p) ((G.ob y).act Y X h p) r0 a1)))
                 (W0.isSetIx ((G.ob y).ob Y) ((G.ob y).act Y X h p) ((G.ob y).act Y X h p) (refl ((G.ob y).act Y X h p)) r1))
    p' q a r ;

  module At (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) {
   ptC (y : CO) (f : CH y x) : W0.Ix ((G.ob y).ob X) = (G.act y x f).nt X gm ;
   ptH (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) : W0.Ix ((G.ob y).ob Y) = (G.ob y).act Y X h (ptC y f) ;
   FA (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) : U l = W0.Ix ((A.ty y).tob Y (ptH y f Y h)) ;

   Comp : U l = (y : CO) (f : CH y x) -> W0.Ix ((PiB y).tob X (ptC y f)) ;
   val (b : Comp) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h)
    : W0.Ix ((B.ty y).tob Y (prA y Y (ptH y f Y h) a)) = (b y f).1 Y h a ;
   valT (b : Comp) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h) : TB y Y =
    prB y Y (prA y Y (ptH y f Y h) a) (val b y f Y h a) ;

   -- the value of b y f at (h , w), for a total w of A_y over the point
   -- (act f gm) h; it depends only on f, h and w
   coeA (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h)) : FA y f Y h =
    GPR.TyL[G.ob y, A.ty y].coeT Y (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h) r (sndE (G.ob y) (A.ty y) Y w) ;
   coeA-pr (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h))
    : Id (TA y Y) w (prA y Y (ptH y f Y h) (coeA y f Y h w r)) =
    GPR.TyL[G.ob y, A.ty y].pr-coe Y (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h) r (sndE (G.ob y) (A.ty y) Y w) ;
   valAt (b : Comp) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h)) : TB y Y =
    valT b y f Y h (coeA y f Y h w r) ;
   valAt-cong (b : Comp) (y : CO) (f f' : CH y x) (ef : Id (CH y x) f f') (Y : Ob) (h h' : Hom Y X) (eh : Id (Hom Y X) h h')
    (w w' : TA y Y) (ew : Id (TA y Y) w w')
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h))
    (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w') (ptH y f' Y h'))
    : Id (TB y Y) (valAt b y f Y h w r) (valAt b y f' Y h' w' r') =
    idJ (CH y x) f
     (\ f1 e1 -> (h1 : Hom Y X) (eh1 : Id (Hom Y X) h h1) (w1 : TA y Y) (ew1 : Id (TA y Y) w w1)
        (r1 : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w1) (ptH y f1 Y h1))
        -> Id (TB y Y) (valAt b y f Y h w r) (valAt b y f1 Y h1 w1 r1))
     (\ h1 eh1 -> idJ (Hom Y X) h
        (\ h2 e2 -> (w1 : TA y Y) (ew1 : Id (TA y Y) w w1)
           (r1 : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w1) (ptH y f Y h2))
           -> Id (TB y Y) (valAt b y f Y h w r) (valAt b y f Y h2 w1 r1))
        (\ w1 ew1 -> idJ (TA y Y) w
           (\ w2 e3 -> (r1 : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w2) (ptH y f Y h))
              -> Id (TB y Y) (valAt b y f Y h w r) (valAt b y f Y h w2 r1))
           (\ r1 -> apH (\ q -> valAt b y f Y h w q)
                     (W0.isSetIx ((G.ob y).ob Y) (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h) r r1))
           w1 ew1)
        h1 eh1)
     f' ef h' eh w' ew r' ;
   -- the value at a pair (pt , a) is the value at a
   valAt-pr (b : Comp) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h)
    : Id (TB y Y) (valAt b y f Y h (prA y Y (ptH y f Y h) a) (refl (ptH y f Y h))) (valT b y f Y h a) =
    refl (valT b y f Y h a) ;
   -- the value at w is a value at a pair
   valAt-co (b : Comp) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h))
    (r' : Id (W0.Ix ((G.ob y).ob Y)) (ptH y f Y h) (ptH y f Y h))
    : Id (TB y Y) (valAt b y f Y h w r) (valAt b y f Y h (prA y Y (ptH y f Y h) (coeA y f Y h w r)) r') =
    valAt-cong b y f f (refl f) Y h h (refl h) w (prA y Y (ptH y f Y h) (coeA y f Y h w r)) (coeA-pr y f Y h w r) r r' ;

   -- (pt , a) moved along g : z -> y, and its second component over the
   -- point (act (f g) gm) h
   mvA (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h) : TA z Y =
    (A.tE z y g).nt Y (prA y Y (ptH y f Y h) a) ;
   mvPt (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h)
    : Id (W0.Ix ((G.ob z).ob Y)) (fstE (G.ob z) (A.ty z) Y (mvA z y g f Y h a)) (ptH z (co z y x f g) Y h) =
    transH (A.tE-pt z y g Y (prA y Y (ptH y f Y h) a))
     (transH ((G.act z y g).nt-nat Y X h (ptC y f))
       (apH (\ p -> (G.ob z).act Y X h p) (symH (G.act-o z y x f g X gm)))) ;
   aM (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h) : FA z (co z y x f g) Y h =
    coeA z (co z y x f g) Y h (mvA z y g f Y h a) (mvPt z y g f Y h a) ;
   -- by definition of aM (pr-coe)
   aM-mv (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h)
    : Id (TA z Y) (mvA z y g f Y h a) (prA z Y (ptH z (co z y x f g) Y h) (aM z y g f Y h a)) =
    coeA-pr z (co z y x f g) Y h (mvA z y g f Y h a) (mvPt z y g f Y h a) ;

   -- naturality in C
   CNatAt (b : Comp) (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h) : U l =
    Id (TB z Y) ((B.tE z y g).nt Y (valT b y f Y h a)) (valT b z (co z y x f g) Y h (aM z y g f Y h a)) ;
   CNat (b : Comp) : U l =
    (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h) -> CNatAt b z y g f Y h a ;

   PiIx : U l = (b : Comp) * CNat b ;

   isProp-CNat (b : Comp) : isProp (CNat b) =
    isProp-Pi CO (\ z -> (y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h) -> CNatAt b z y g f Y h a) (\ z ->
    isProp-Pi CO (\ y -> (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h) -> CNatAt b z y g f Y h a) (\ y ->
    isProp-Pi (CH z y) (\ g -> (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h) -> CNatAt b z y g f Y h a) (\ g ->
    isProp-Pi (CH y x) (\ f -> (Y : Ob) (h : Hom Y X) (a : FA y f Y h) -> CNatAt b z y g f Y h a) (\ f ->
    isProp-Pi Ob (\ Y -> (h : Hom Y X) (a : FA y f Y h) -> CNatAt b z y g f Y h a) (\ Y ->
    isProp-Pi (Hom Y X) (\ h -> (a : FA y f Y h) -> CNatAt b z y g f Y h a) (\ h ->
    isProp-Pi (FA y f Y h) (\ a -> CNatAt b z y g f Y h a) (\ a ->
     W0.isSetIx ((extP (E.ob z) (B.ty z)).ob Y) ((B.tE z y g).nt Y (valT b y f Y h a))
       (valT b z (co z y x f g) Y h (aM z y g f Y h a))))))))) ;

   -- the code: the families, with the truth value of CNat
   compCode : W0.V = RR.Prod x (\ y f -> (PiB y).tob X (ptC y f)) ;
   natCode (b : Comp) : W0.V = propV (CNat b) (isProp-CNat b) ;
   piO : W0.V = W0.SigV compCode natCode ;

   -- elements are determined by their components, hence by their values
   pi-eqC (u v : PiIx) (H : (y : CO) (f : CH y x) -> Id (W0.Ix ((PiB y).tob X (ptC y f))) (u.1 y f) (v.1 y f)) : Id PiIx u v =
    Sigma-eq Comp (\ b -> CNat b) u.1 v.1 u.2 v.2
     (RR.funext2 x (\ y f -> W0.Ix ((PiB y).tob X (ptC y f))) u.1 v.1 H) (isProp-CNat v.1) ;
   pi-eq (u v : PiIx)
    (H : (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : FA y f Y h)
         -> Id (W0.Ix ((B.ty y).tob Y (prA y Y (ptH y f Y h) a))) (val u.1 y f Y h a) (val v.1 y f Y h a)) : Id PiIx u v =
    pi-eqC u v (\ y f -> PP.PiCode[G.ob y, A.ty y, B.ty y].piCode-eq X
      (PP.PiCode[G.ob y, A.ty y, B.ty y].ptOf X (ptC y f)) (PP.PiCode[G.ob y, A.ty y, B.ty y].cOf X (ptC y f))
      (PP.PiCode[G.ob y, A.ty y, B.ty y].eOf X (ptC y f)) (u.1 y f) (v.1 y f) (H y f)) ;

   -- naturality in C at a total: B's action along g sends the value at
   -- (f , h , w) to the value at (f g , h , w moved along g)
   cnat-at (u : PiIx) (z y : CO) (g : CH z y) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (ptH y f Y h))
    (r' : Id (W0.Ix ((G.ob z).ob Y)) (fstE (G.ob z) (A.ty z) Y ((A.tE z y g).nt Y w)) (ptH z (co z y x f g) Y h))
    : Id (TB z Y) ((B.tE z y g).nt Y (valAt u.1 y f Y h w r)) (valAt u.1 z (co z y x f g) Y h ((A.tE z y g).nt Y w) r') =
    transH (u.2 z y g f Y h (coeA y f Y h w r))
     (valAt-cong u.1 z (co z y x f g) (co z y x f g) (refl (co z y x f g)) Y h h (refl h)
       (mvA z y g f Y h (coeA y f Y h w r)) ((A.tE z y g).nt Y w)
       (apH (\ w1 -> (A.tE z y g).nt Y w1) (symH (coeA-pr y f Y h w r)))
       (mvPt z y g f Y h (coeA y f Y h w r)) r') ;
  } ;

  ------------------------------------------------------------------
  -- the base action: Pi_y's action on each component.  The value of the
  -- moved family at (h , w) is the value of the family at (k h , w).

  module Act (x : CO) (X' X : Ob) (k : Hom X' X) (gm : W0.Ix ((G.ob x).ob X)) (gm' : W0.Ix ((G.ob x).ob X'))
   (e : Id (W0.Ix ((G.ob x).ob X')) ((G.ob x).act X' X k gm) gm') {
   module S = At[x, X, gm] ;
   module T = At[x, X', gm'] ;
   ePt (y : CO) (f : CH y x) : Id (W0.Ix ((G.ob y).ob X')) ((G.ob y).act X' X k (S.ptC y f)) (T.ptC y f) =
    transH (symH ((G.act y x f).nt-nat X' X k gm)) (apH (\ p -> (G.act y x f).nt X' p) e) ;
   actC (b : S.Comp) : T.Comp = \ y f -> (PiB y).tact X' X k (S.ptC y f) (T.ptC y f) (ePt y f) (b y f) ;
   pP (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X') : Id (W0.Ix ((G.ob y).ob Y)) (S.ptH y f Y (compH Y X' X k h)) (T.ptH y f Y h) =
    PP.PiCode[G.ob y, A.ty y, B.ty y].piPt X' X k (S.ptC y f) (T.ptC y f) (ePt y f) Y h ;
   rS (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X') (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (T.ptH y f Y h))
    : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (S.ptH y f Y (compH Y X' X k h)) = transH r (symH (pP y f Y h)) ;
   -- by definition of Pi_y's action (piFun)
   valAct (b : S.Comp) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X') (a : T.FA y f Y h)
    : Id (TB y Y) (T.valT (actC b) y f Y h a)
        (S.valAt b y f Y (compH Y X' X k h) (prA y Y (T.ptH y f Y h) a) (symH (pP y f Y h))) =
    symH (GPR.TyL[E.ob y, B.ty y].pr-coe Y
      (prA y Y (S.ptH y f Y (compH Y X' X k h)) (S.coeA y f Y (compH Y X' X k h) (prA y Y (T.ptH y f Y h) a) (symH (pP y f Y h))))
      (prA y Y (T.ptH y f Y h) a)
      (PP.pairpath (G.ob y) (A.ty y) Y (S.ptH y f Y (compH Y X' X k h)) (T.ptH y f Y h) (pP y f Y h) a)
      (S.val b y f Y (compH Y X' X k h) (S.coeA y f Y (compH Y X' X k h) (prA y Y (T.ptH y f Y h) a) (symH (pP y f Y h))))) ;
   valAct-at (b : S.Comp) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X') (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (T.ptH y f Y h))
    (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (S.ptH y f Y (compH Y X' X k h)))
    : Id (TB y Y) (T.valAt (actC b) y f Y h w r) (S.valAt b y f Y (compH Y X' X k h) w r') =
    transH (valAct b y f Y h (T.coeA y f Y h w r))
     (S.valAt-cong b y f f (refl f) Y (compH Y X' X k h) (compH Y X' X k h) (refl (compH Y X' X k h))
       (prA y Y (T.ptH y f Y h) (T.coeA y f Y h w r)) w (symH (T.coeA-pr y f Y h w r))
       (symH (pP y f Y h)) r') ;
   -- the moved family is natural in C
   actN (u : S.PiIx) : T.CNat (actC u.1) = \ z y g f Y h a ->
    transH (apH (\ t -> (B.tE z y g).nt Y t) (valAct u.1 y f Y h a))
     (transH (S.cnat-at u z y g f Y (compH Y X' X k h) (prA y Y (T.ptH y f Y h) a) (symH (pP y f Y h))
               (transH (T.mvPt z y g f Y h a) (symH (pP z (co z y x f g) Y h))))
       (symH (valAct-at u.1 z (co z y x f g) Y h (T.mvA z y g f Y h a) (T.mvPt z y g f Y h a)
               (transH (T.mvPt z y g f Y h a) (symH (pP z (co z y x f g) Y h)))))) ;
   act (u : S.PiIx) : T.PiIx = (actC u.1, actN u) ;
  } ;

  ------------------------------------------------------------------
  -- the base type at x

  piTy (x : CO) : PTy[G.ob x] =
   mkTy (G.ob x) (\ X gm -> At[x, X, gm].piO)
    (\ J I h g g' e u -> Act[x, J, I, h, g, g', e].act u)
    (\ I g e u -> At[x, I, g].pi-eqC (Act[x, I, I, idH I, g, g, e].act u) u
       (\ y f -> (PiB y).tact-id I (At[x, I, g].ptC y f) (Act[x, I, I, idH I, g, g, e].ePt y f) (u.1 y f)))
    (\ K J I f g p q r e1 e2 e3 u -> At[x, K, r].pi-eqC
       (Act[x, K, I, compH K J I f g, p, r, e3].act u)
       (Act[x, K, J, g, q, r, e2].act (Act[x, J, I, f, p, q, e1].act u))
       (\ y f' -> (PiB y).tact-o K J I f g (At[x, I, p].ptC y f') (At[x, J, q].ptC y f') (At[x, K, r].ptC y f')
          (Act[x, J, I, f, p, q, e1].ePt y f') (Act[x, K, J, g, q, r, e2].ePt y f') (Act[x, K, I, compH K J I f g, p, r, e3].ePt y f') (u.1 y f'))) ;

  ------------------------------------------------------------------
  -- the C-action along g : x' -> x: reindexing, b y f := b y (g f).  The
  -- value of the reindexed family at (f , h , w) is the value of the
  -- family at (g f , h , w).

  module CAct (x' x : CO) (g : CH x' x) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) {
   module S = At[x, X, gm] ;
   module T = At[x', X, (G.act x' x g).nt X gm] ;
   qP (y : CO) (f : CH y x') : Id (W0.Ix ((G.ob y).ob X)) (S.ptC y (co y x' x g f)) (T.ptC y f) = G.act-o y x' x g f X gm ;
   qH (y : CO) (f : CH y x') (Y : Ob) (h : Hom Y X) : Id (W0.Ix ((G.ob y).ob Y)) (T.ptH y f Y h) (S.ptH y (co y x' x g f) Y h) =
    apH (\ p -> (G.ob y).act Y X h p) (symH (qP y f)) ;
   rixC (b : S.Comp) : T.Comp = \ y f ->
    GPR.TyL[G.ob y, PiB y].coeT X (S.ptC y (co y x' x g f)) (T.ptC y f) (qP y f) (b y (co y x' x g f)) ;
   rS (y : CO) (f : CH y x') (Y : Ob) (h : Hom Y X) (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (T.ptH y f Y h))
    : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (S.ptH y (co y x' x g f) Y h) = transH r (qH y f Y h) ;
   valRix (b : S.Comp) (y : CO) (f : CH y x') (Y : Ob) (h : Hom Y X) (a : T.FA y f Y h)
    : Id (TB y Y) (T.valT (rixC b) y f Y h a)
        (S.valAt b y (co y x' x g f) Y h (prA y Y (T.ptH y f Y h) a) (qH y f Y h)) =
    coeVal y X (S.ptC y (co y x' x g f)) (T.ptC y f) (qP y f) (b y (co y x' x g f)) Y h a (qH y f Y h) ;
   valRix-at (b : S.Comp) (y : CO) (f : CH y x') (Y : Ob) (h : Hom Y X) (w : TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (T.ptH y f Y h))
    (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (S.ptH y (co y x' x g f) Y h))
    : Id (TB y Y) (T.valAt (rixC b) y f Y h w r) (S.valAt b y (co y x' x g f) Y h w r') =
    transH (valRix b y f Y h (T.coeA y f Y h w r))
     (S.valAt-cong b y (co y x' x g f) (co y x' x g f) (refl (co y x' x g f)) Y h h (refl h)
       (prA y Y (T.ptH y f Y h) (T.coeA y f Y h w r)) w (symH (T.coeA-pr y f Y h w r))
       (qH y f Y h) r') ;
   -- the reindexed family is natural in C (associativity of C)
   rixN (u : S.PiIx) : T.CNat (rixC u.1) = \ z y k f Y h a ->
    transH (apH (\ t -> (B.tE z y k).nt Y t) (valRix u.1 y f Y h a))
     (transH (S.cnat-at u z y k (co y x' x g f) Y h (prA y Y (T.ptH y f Y h) a) (qH y f Y h)
               (transH (rS z (co z y x' f k) Y h (T.mvA z y k f Y h a) (T.mvPt z y k f Y h a))
                  (apH (\ c -> S.ptH z c Y h) (symH (co-assoc z y x' x g f k)))))
      (transH (S.valAt-cong u.1 z (co z y x (co y x' x g f) k) (co z x' x g (co z y x' f k)) (co-assoc z y x' x g f k)
                 Y h h (refl h) (T.mvA z y k f Y h a) (T.mvA z y k f Y h a) (refl (T.mvA z y k f Y h a))
                 (transH (rS z (co z y x' f k) Y h (T.mvA z y k f Y h a) (T.mvPt z y k f Y h a))
                    (apH (\ c -> S.ptH z c Y h) (symH (co-assoc z y x' x g f k))))
                 (rS z (co z y x' f k) Y h (T.mvA z y k f Y h a) (T.mvPt z y k f Y h a)))
        (symH (valRix-at u.1 z (co z y x' f k) Y h (T.mvA z y k f Y h a) (T.mvPt z y k f Y h a)
                 (rS z (co z y x' f k) Y h (T.mvA z y k f Y h a) (T.mvPt z y k f Y h a)))))) ;
   rix (u : S.PiIx) : T.PiIx = (rixC u.1, rixN u) ;
  } ;

  ------------------------------------------------------------------
  -- totals of Pi at x, and their extensionality: equal points and equal
  -- values at every (f , h , w)

  TP (x : CO) (X : Ob) : U l = SigT (G.ob x) (piTy x) X ;
  prP (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (u : At[x, X, gm].PiIx) : TP x X = pairE (G.ob x) (piTy x) X gm u ;
  ValEq (x : CO) (X : Ob) (gm gm' : W0.Ix ((G.ob x).ob X)) (u : At[x, X, gm].PiIx) (u' : At[x, X, gm'].PiIx) : U l =
   (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : TA y Y)
   (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (At[x, X, gm].ptH y f Y h))
   (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (At[x, X, gm'].ptH y f Y h))
   -> Id (TB y Y) (At[x, X, gm].valAt u.1 y f Y h w r) (At[x, X, gm'].valAt u'.1 y f Y h w r') ;
  tot-ext (x : CO) (X : Ob) (gm gm' : W0.Ix ((G.ob x).ob X)) (p : Id (W0.Ix ((G.ob x).ob X)) gm gm')
   (u : At[x, X, gm].PiIx) (u' : At[x, X, gm'].PiIx) (H : ValEq x X gm gm' u u') : Id (TP x X) (prP x X gm u) (prP x X gm' u') =
   idJ (W0.Ix ((G.ob x).ob X)) gm
    (\ gm1 p1 -> (u1 : At[x, X, gm1].PiIx) -> ValEq x X gm gm1 u u1 -> Id (TP x X) (prP x X gm u) (prP x X gm1 u1))
    (\ u1 H1 -> apH (\ v -> prP x X gm v)
       (At[x, X, gm].pi-eq u u1 (\ y f Y h a ->
          GPR.TyL[E.ob y, B.ty y].pr-inj Y (prA y Y (At[x, X, gm].ptH y f Y h) a)
            (At[x, X, gm].val u.1 y f Y h a) (At[x, X, gm].val u1.1 y f Y h a)
            (H1 y f Y h (prA y Y (At[x, X, gm].ptH y f Y h) a) (refl (At[x, X, gm].ptH y f Y h)) (refl (At[x, X, gm].ptH y f Y h))))))
    gm' p u' H ;

  ------------------------------------------------------------------
  -- the C-action on totals, and the C-type Pi_A B

  tEn (x' x : CO) (g : CH x' x) (X : Ob) (w : TP x X) : TP x' X =
   prP x' X ((G.act x' x g).nt X (fstE (G.ob x) (piTy x) X w))
    (CAct[x', x, g, X, fstE (G.ob x) (piTy x) X w].rix (sndE (G.ob x) (piTy x) X w)) ;

  -- it commutes with the base action: both sides have the value of w at
  -- (g f , h h' , wA)
  module TEN (x' x : CO) (g : CH x' x) (Y X : Ob) (h : Hom Y X) (w : TP x X) {
   g0 : W0.Ix ((G.ob x).ob X) = fstE (G.ob x) (piTy x) X w ;
   u : At[x, X, g0].PiIx = sndE (G.ob x) (piTy x) X w ;
   gS : W0.Ix ((G.ob x).ob Y) = (G.ob x).act Y X h g0 ;
   gT : W0.Ix ((G.ob x').ob X) = (G.act x' x g).nt X g0 ;
   gR : W0.Ix ((G.ob x').ob Y) = (G.ob x').act Y X h gT ;
   module CY = CAct[x', x, g, Y, gS] ;
   module AS = Act[x, Y, X, h, g0, gS, refl gS] ;
   module CX = CAct[x', x, g, X, g0] ;
   module AT = Act[x', Y, X, h, gT, gR, refl gR] ;
   vals : ValEq x' Y ((G.act x' x g).nt Y gS) gR (CY.rix (AS.act u)) (AT.act (CX.rix u)) =
    \ y f Y' h' wA r r' ->
     transH (CY.valRix-at (AS.actC u.1) y f Y' h' wA r (CY.rS y f Y' h' wA r))
      (transH (AS.valAct-at u.1 y (co y x' x g f) Y' h' wA (CY.rS y f Y' h' wA r)
                 (CX.rS y f Y' (compH Y' Y X h h') wA (AT.rS y f Y' h' wA r')))
        (symH (transH (AT.valAct-at (CX.rixC u.1) y f Y' h' wA r' (AT.rS y f Y' h' wA r'))
                 (CX.valRix-at u.1 y f Y' (compH Y' Y X h h') wA (AT.rS y f Y' h' wA r')
                    (CX.rS y f Y' (compH Y' Y X h h') wA (AT.rS y f Y' h' wA r')))))) ;
   res : Id (TP x' Y) (tEn x' x g Y ((extP (G.ob x) (piTy x)).act Y X h w)) ((extP (G.ob x') (piTy x')).act Y X h (tEn x' x g X w)) =
    tot-ext x' Y ((G.act x' x g).nt Y gS) gR ((G.act x' x g).nt-nat Y X h g0) (CY.rix (AS.act u)) (AT.act (CX.rix u)) vals ;
  } ;
  tEP (x' x : CO) (g : CH x' x) : PSub[extP (G.ob x) (piTy x), extP (G.ob x') (piTy x')] =
   new PSub[extP (G.ob x) (piTy x), extP (G.ob x') (piTy x'), tEn x' x g, \ Y X h w -> TEN[x', x, g, Y, X, h, w].res] ;

  -- identity (co-idl)
  module TEI (x : CO) (X : Ob) (w : TP x X) {
   g0 : W0.Ix ((G.ob x).ob X) = fstE (G.ob x) (piTy x) X w ;
   u : At[x, X, g0].PiIx = sndE (G.ob x) (piTy x) X w ;
   module Cc = CAct[x, x, cid x, X, g0] ;
   vals : ValEq x X ((G.act x x (cid x)).nt X g0) g0 (Cc.rix u) u =
    \ y f Y h wA r r' ->
     transH (Cc.valRix-at u.1 y f Y h wA r (Cc.rS y f Y h wA r))
      (At[x, X, g0].valAt-cong u.1 y (co y x x (cid x) f) f (co-idl y x f) Y h h (refl h) wA wA (refl wA) (Cc.rS y f Y h wA r) r') ;
   res : Id (TP x X) (tEn x x (cid x) X w) w =
    tot-ext x X ((G.act x x (cid x)).nt X g0) g0 (G.act-id x X g0) (Cc.rix u) u vals ;
  } ;

  -- composition (co-assoc)
  module TEO (z y x : CO) (f : CH y x) (h : CH z y) (X : Ob) (w : TP x X) {
   g0 : W0.Ix ((G.ob x).ob X) = fstE (G.ob x) (piTy x) X w ;
   u : At[x, X, g0].PiIx = sndE (G.ob x) (piTy x) X w ;
   module C1 = CAct[z, x, co z y x f h, X, g0] ;
   module C2 = CAct[y, x, f, X, g0] ;
   module C3 = CAct[z, y, h, X, (G.act y x f).nt X g0] ;
   vals : ValEq z X ((G.act z x (co z y x f h)).nt X g0) ((G.act z y h).nt X ((G.act y x f).nt X g0)) (C1.rix u) (C3.rix (C2.rix u)) =
    \ y' f' Y h' wA r r' ->
     transH (C1.valRix-at u.1 y' f' Y h' wA r (C1.rS y' f' Y h' wA r))
      (transH (At[x, X, g0].valAt-cong u.1 y' (co y' z x (co z y x f h) f') (co y' y x f (co y' z y h f')) (co-assoc y' z y x f h f')
                 Y h' h' (refl h') wA wA (refl wA) (C1.rS y' f' Y h' wA r)
                 (C2.rS y' (co y' z y h f') Y h' wA (C3.rS y' f' Y h' wA r')))
        (symH (transH (C3.valRix-at (C2.rixC u.1) y' f' Y h' wA r' (C3.rS y' f' Y h' wA r'))
                 (C2.valRix-at u.1 y' (co y' z y h f') Y h' wA (C3.rS y' f' Y h' wA r')
                    (C2.rS y' (co y' z y h f') Y h' wA (C3.rS y' f' Y h' wA r')))))) ;
   res : Id (TP z X) (tEn z x (co z y x f h) X w) (tEn z y h X (tEn y x f X w)) =
    tot-ext z X ((G.act z x (co z y x f h)).nt X g0) ((G.act z y h).nt X ((G.act y x f).nt X g0)) (G.act-o z y x f h X g0)
     (C1.rix u) (C3.rix (C2.rix u)) vals ;
  } ;

  -- Pi_A B
  PiT : CTy[G] =
   new CTy[G, piTy, tEP,
    \ y x f X w -> refl ((G.act y x f).nt X (fstE (G.ob x) (piTy x) X w)),
    \ x X w -> TEI[x, X, w].res,
    \ z y x f h X w -> TEO[z, y, x, f, h, X, w].res] ;
 } ;
} ;
