-- CTotL12m.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part m: the extension as an element of D A.
--   kop     the values of all the levels, with D A's three equations
--           (naturality from P1t; inner faces from P3t and fc-comp; top
--           face from P3t and fc-top)
--   kside   it extends s (the action reads at the moved index; P2t)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;
module Ar = Arith[a] ;

module L12m (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LL = CTotL12l[a, vl, l].L12l[C, G, A] ;
 module LA = LL.LA ;
 module LB = CTotL12b[a, vl, l].L12b[C, G, A] ;
 module TR = LA.TR ;
 module G0 = TR.G0 ;
 module G1 = TR.G1 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 UG : TR.P0.PCtx = LL.UG ;
 UA : TR.P0.PTy[UG] = LL.UA ;
 Tot (W : TC.TOb) : U l = LA.P.SigT LA.DG DA.DTy W ;
 -- two totals of D A with equal points and equal readings are equal
 totEq (W : TC.TOb) (t t' : Tot W) (pP : Id (W0.Ix (LA.DG.ob W)) t.1 t'.1)
  (H : (q : DO.Idx W.1 W.2) (lq : DO.LandsI W.1 W.2 q) -> Id (DA.Ez q.2.1 q.2.2.2.1) (LB.rdT W t q lq) (LB.rdT W t' q lq))
  : Id (Tot W) t t' =
  idJ (W0.Ix (LA.DG.ob W)) t.1
   (\ w2 P2 -> (b : DA.TOb' W.1 W.2 w2)
      -> ((q : DO.Idx W.1 W.2) (lq : DO.LandsI W.1 W.2 q) -> Id (DA.Ez q.2.1 q.2.2.2.1) (LB.rdT W t q lq) (DA.prz q.2.1 q.2.2.2.1 (w2.1 q lq) (b.1 q lq)))
      -> Id (Tot W) t (w2, b))
   (\ b H2 -> apH {DA.TOb' W.1 W.2 t.1} {Tot W} (\ b2 -> (t.1, b2))
      (DA.tob-eq W.1 W.2 t.1 t.2 b (\ q lq -> DA.pr-inj q.2.1 q.2.2.2.1 (t.1.1 q lq) (t.2.1 q lq) (b.1 q lq) (H2 q lq))))
   t'.1 pP t'.2 H ;

 module Fm (al : G0.GB.CPartial[l].ContrOp UG UA) (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FL = LL.Fl[al, X, gm, s] ;
  module FG = FL.FG ;
  module F = FL.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  lv (n : Nat) : F.Vt n = F.top n (FL.build n) ;
  uX : DA.TA I x gm = \ q lq -> lv q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1 (q.2.2.2.2.2, lq) ;
  anat' : W0.Ix (DA.anatEq I x gm uX) = \ r lq ->
   FG.p1of r.1.1 (FL.build r.1.1) r.1.2.1 r.1.2.2.1 r.1.2.2.2.1 r.1.2.2.2.2.1 (r.1.2.2.2.2.2, lq) r.2.1 r.2.2 ;
  p3b (n : Nat) : F.P3t n (lv (suc n)) (lv n) = (FL.build (suc n)).2.2.2.2 ;
  aface' : W0.Ix (DA.afaceEq I x gm uX) = \ r lq ->
   transH (p3b r.1 r.2.2.2.1 r.2.2.2.2.1 r.2.2.2.2.2.1 r.2.2.2.2.2.2.1 (r.2.2.2.2.2.2.2, lq) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1))
    (transH (apH {DO.KJ[r.2.2.2.1].K.DR r.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1} {DA.Ez r.2.2.2.1 r.2.2.2.2.2.1}
               (\ DR' -> DA.E.act (r.2.2.2.1, r.2.2.2.2.2.1) (r.2.2.2.1, DR'.1) (idH r.2.2.2.1, DR'.2.2)
                          (F.pzv r.1 (lv r.1) r.2.2.2.1 r.2.2.2.2.1 DR'.1 DR'.2.1 (r.2.2.2.2.2.2.2, lq)))
               (DO.KJ[r.2.2.2.1].K.fc-comp r.1 r.2.1 r.2.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1))
      (DA.E.act-id (r.2.2.2.1, r.2.2.2.2.2.1)
         (F.pzv r.1 (lv r.1) r.2.2.2.1 r.2.2.2.2.1 r.2.2.2.2.2.1
            (DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1) (r.2.2.2.2.2.2.2, lq)))) ;
  atop' : W0.Ix (DA.atopEq I x gm uX) = \ r lq ->
   transH (p3b r.1 r.2.1 r.2.2.1 r.2.2.2.1 r.2.2.2.2.1 (r.2.2.2.2.2, lq) (suc r.1) (Tr.leb-refl (suc r.1)))
    (apH {DO.KJ[r.2.1].K.DR r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1} {DA.Ez r.2.1 r.2.2.2.1}
       (\ DR' -> DA.E.act (r.2.1, r.2.2.2.1) (r.2.1, DR'.1) (idH r.2.1, DR'.2.2)
                  (F.pzv r.1 (lv r.1) r.2.1 r.2.2.1 DR'.1 DR'.2.1 (r.2.2.2.2.2, lq)))
       (DO.KJ[r.2.1].K.fc-top r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1 r.2.2.2.2.1)) ;
  kop : DA.TOb' I x gm = (uX, anat', aface', atop') ;
  t0 : Tot X = (gm, kop) ;

  -- it extends s
  kside (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) : Id (Tot W) (LB.EE.act W X f t0) (s.pv W f lf) =
   totEq W (LB.EE.act W X f t0) (s.pv W f lf) (symH (s.ppt W f lf))
    (\ q lq -> transH (LB.actRd W X f t0 q lq) (FG.p2of q.1 (FL.build q.1) W f lf q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1 (q.2.2.2.2.2, lq))) ;
 } ;
} ;
