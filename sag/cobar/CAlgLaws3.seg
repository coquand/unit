-- CAlgLaws3.seg (canonicity-45; SIMPLIFIED.md step 2b): the ring laws of
-- the presented algebra A_x in three variables at ALL elements, from the laws at the classes
-- of constants (CAlgX) by Law1 (CAlgLaw) one variable at a time: for each
-- variable the two sides are functions of it given by a body over nil.Qt
-- (Fun1, with its beta law from the Ov calculus Ov1), the other variables
-- being external elements; the law at constants of the innermost
-- variable is the law at constants of CAlgX read through the betas.
--   addAssoc, mulAssoc, distr: three nested applications of CAlgLaws.Unary
--   (the inner variables at constants first).  Split from CAlgLaws for
--   the ten-second cap.  Against the parameters of CAlgLaws.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module FB = FibCwF[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FB.fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module CF = CAlgFun[a] ;

module Laws3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy)
 (setQ : (q q' : C.El C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) -> C.El C.nil (PU.isProp C.nil (IJ.IdT C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt q q')))
 (elim2 : CAlgX[a].AlgX[R, encK, x, pe].Elim2Ty) (elim2-beta : CAlgX[a].AlgX[R, encK, x, pe].Elim2Beta elim2)
 (setW : (a1 b1 : C.El (C.ext C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) (OV.wkT C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt))
   -> C.El (C.ext C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) (PU.isProp (C.ext C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) (IJ.IdT (C.ext C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) (OV.wkT C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt) a1 b1))) {
 module LW = CAlgLaws[a].Laws[R, encK, x, pe, setQ, elim2, elim2-beta, setW] ;
 module OP = LW.OP ;
 Nl : C.Ctx = C.nil ;
 Term : U a = LW.Term ;
 Qt : C.Ty Nl = LW.Qt ;
 Q : U a++ = C.El Nl Qt ;
 IdQ (q q' : Q) : C.Ty Nl = LW.IdQ q q' ;
 cls (t : Term) : Q = LW.cls t ;
 add (q q' : Q) : Q = LW.add q q' ;
 mul (q q' : Q) : Q = LW.mul q q' ;
 G1 : C.Ctx = LW.G1 ;
 Qw : C.Ty G1 = LW.Qw ;
 q0 : C.El G1 Qw = LW.q0 ;
 FQ : C.Ty Nl = LW.FQ ;
 ap1 (f : C.El G1 (OV.Fun G1 Qw Qw)) (b : C.El G1 Qw) : C.El G1 Qw = LW.ap1 f b ;
 ap2 (f : C.El G1 (OV.Fun G1 Qw (OV.wkT Nl Qt FQ))) (b : C.El G1 Qw) : C.El G1 (OV.Fun G1 Qw Qw) = LW.ap2 f b ;
 wG (F : C.El Nl (OV.Fun Nl Qt FQ)) : C.El G1 (OV.Fun G1 Qw (OV.wkT Nl Qt FQ)) = LW.wG F ;
 wE (q : Q) : C.El G1 Qw = LW.wE q ;
 module BA = LW.BA ;
 module BM = LW.BM ;


 -- the three-variable laws, innermost variable first (z, then y, then x),
 -- the bodies built by Bin.bB with their Ov by Bin.oB (no new proofs)
 oGl (c : Q) (q : Q) : CF.Ov1[Qt, q].OvB Qt (wE c) c = LW.oGl c q ;
 oId (q : Q) : CF.Ov1[Qt, q].OvB Qt q0 q = LW.oId q ;
 -- add-assoc
 addAssocX (u w : Term) (x1 : Q) : C.El Nl (IdQ (add x1 (add (cls u) (cls w))) (add (add x1 (cls u)) (cls w))) =
  LW.Unary[BA.bR (add (cls u) (cls w)), BA.bB (BA.bR (cls u)) (wE (cls w)), \ q -> add q (add (cls u) (cls w)), \ q -> add (add q (cls u)) (cls w),
           BA.oR (add (cls u) (cls w)), BA.oB (BA.bR (cls u)) (wE (cls w)) (\ q -> add q (cls u)) (\ q -> cls w) (BA.oR (cls u)) (oGl (cls w)), \ t -> OP.add-assocC t u w].at x1 ;
 addAssocY (x1 : Q) (w : Term) (y1 : Q) : C.El Nl (IdQ (add x1 (add y1 (cls w))) (add (add x1 y1) (cls w))) =
  LW.Unary[BA.bB (wE x1) (BA.bR (cls w)), BA.bB (BA.bL x1) (wE (cls w)), \ q -> add x1 (add q (cls w)), \ q -> add (add x1 q) (cls w),
           BA.oB (wE x1) (BA.bR (cls w)) (\ q -> x1) (\ q -> add q (cls w)) (oGl x1) (BA.oR (cls w)),
           BA.oB (BA.bL x1) (wE (cls w)) (\ q -> add x1 q) (\ q -> cls w) (BA.oL x1) (oGl (cls w)), \ u -> addAssocX u w x1].at y1 ;
 addAssoc (x1 y1 z : Q) : C.El Nl (IdQ (add x1 (add y1 z)) (add (add x1 y1) z)) =
  LW.Unary[BA.bB (wE x1) (BA.bL y1), BA.bL (add x1 y1), \ q -> add x1 (add y1 q), \ q -> add (add x1 y1) q,
           BA.oB (wE x1) (BA.bL y1) (\ q -> x1) (\ q -> add y1 q) (oGl x1) (BA.oL y1), BA.oL (add x1 y1), \ w -> addAssocY x1 w y1].at z ;
 -- mul-assoc
 mulAssocX (u w : Term) (x1 : Q) : C.El Nl (IdQ (mul x1 (mul (cls u) (cls w))) (mul (mul x1 (cls u)) (cls w))) =
  LW.Unary[BM.bR (mul (cls u) (cls w)), BM.bB (BM.bR (cls u)) (wE (cls w)), \ q -> mul q (mul (cls u) (cls w)), \ q -> mul (mul q (cls u)) (cls w),
           BM.oR (mul (cls u) (cls w)), BM.oB (BM.bR (cls u)) (wE (cls w)) (\ q -> mul q (cls u)) (\ q -> cls w) (BM.oR (cls u)) (oGl (cls w)), \ t -> OP.mul-assocC t u w].at x1 ;
 mulAssocY (x1 : Q) (w : Term) (y1 : Q) : C.El Nl (IdQ (mul x1 (mul y1 (cls w))) (mul (mul x1 y1) (cls w))) =
  LW.Unary[BM.bB (wE x1) (BM.bR (cls w)), BM.bB (BM.bL x1) (wE (cls w)), \ q -> mul x1 (mul q (cls w)), \ q -> mul (mul x1 q) (cls w),
           BM.oB (wE x1) (BM.bR (cls w)) (\ q -> x1) (\ q -> mul q (cls w)) (oGl x1) (BM.oR (cls w)),
           BM.oB (BM.bL x1) (wE (cls w)) (\ q -> mul x1 q) (\ q -> cls w) (BM.oL x1) (oGl (cls w)), \ u -> mulAssocX u w x1].at y1 ;
 mulAssoc (x1 y1 z : Q) : C.El Nl (IdQ (mul x1 (mul y1 z)) (mul (mul x1 y1) z)) =
  LW.Unary[BM.bB (wE x1) (BM.bL y1), BM.bL (mul x1 y1), \ q -> mul x1 (mul y1 q), \ q -> mul (mul x1 y1) q,
           BM.oB (wE x1) (BM.bL y1) (\ q -> x1) (\ q -> mul y1 q) (oGl x1) (BM.oL y1), BM.oL (mul x1 y1), \ w -> mulAssocY x1 w y1].at z ;
 -- distributivity: x * (y + z) = x * y + x * z
 distrX (u w : Term) (x1 : Q) : C.El Nl (IdQ (mul x1 (add (cls u) (cls w))) (add (mul x1 (cls u)) (mul x1 (cls w)))) =
  LW.Unary[BM.bR (add (cls u) (cls w)), BA.bB (BM.bR (cls u)) (BM.bR (cls w)), \ q -> mul q (add (cls u) (cls w)), \ q -> add (mul q (cls u)) (mul q (cls w)),
           BM.oR (add (cls u) (cls w)), BA.oB (BM.bR (cls u)) (BM.bR (cls w)) (\ q -> mul q (cls u)) (\ q -> mul q (cls w)) (BM.oR (cls u)) (BM.oR (cls w)), \ t -> OP.distrC t u w].at x1 ;
 distrY (x1 : Q) (w : Term) (y1 : Q) : C.El Nl (IdQ (mul x1 (add y1 (cls w))) (add (mul x1 y1) (mul x1 (cls w)))) =
  LW.Unary[BM.bB (wE x1) (BA.bR (cls w)), BA.bB (BM.bL x1) (wE (mul x1 (cls w))), \ q -> mul x1 (add q (cls w)), \ q -> add (mul x1 q) (mul x1 (cls w)),
           BM.oB (wE x1) (BA.bR (cls w)) (\ q -> x1) (\ q -> add q (cls w)) (oGl x1) (BA.oR (cls w)),
           BA.oB (BM.bL x1) (wE (mul x1 (cls w))) (\ q -> mul x1 q) (\ q -> mul x1 (cls w)) (BM.oL x1) (oGl (mul x1 (cls w))), \ u -> distrX u w x1].at y1 ;
 distr (x1 y1 z : Q) : C.El Nl (IdQ (mul x1 (add y1 z)) (add (mul x1 y1) (mul x1 z))) =
  LW.Unary[BM.bB (wE x1) (BA.bL y1), BA.bB (wE (mul x1 y1)) (BM.bL x1), \ q -> mul x1 (add y1 q), \ q -> add (mul x1 y1) (mul x1 q),
           BM.oB (wE x1) (BA.bL y1) (\ q -> x1) (\ q -> add y1 q) (oGl x1) (BA.oL y1),
           BA.oB (wE (mul x1 y1)) (BM.bL x1) (\ q -> mul x1 y1) (\ q -> mul x1 q) (oGl (mul x1 y1)) (BM.oL x1), \ w -> distrY x1 w y1].at z ;
} ;
