-- CInjSurj.seg (canonicity-45; SIMPLIFIED.md step 6): an injective, merely
-- surjective map between sets is an equivalence (contractible fibres),
-- internally in the fibrant CwF, generically in the context.
--   contrFib   propositional fibres + mere inhabitation (Tr0 of the fibre,
--              eliminated into the fibre, a proposition) => contractible
-- (Part 2, injectivity => propositional fibres, follows.)
-- No new axioms beyond the named premises.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
module QB = CwFQinv.Qinv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
TA : CwFTrunc.Trunc[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv].TruncAt = CTruncAtBase[a].truncAt ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module ContrFib (G : C.Ctx) (A B : C.Ty G) (f : C.El G (OV.Fun G A B)) {
 GB : C.Ctx = C.ext G B ;
 -- the fibre at the variable of B
 Fib : C.Ty GB = QB.FibE GB (OV.wkT G B A) (OV.wkT G B B) (EQ.wkF G B A B f) (C.q G B) ;
 T : C.Ty GB = TA.Tr GB Fib ;
 GT : C.Ctx = C.ext GB T ;
 GF : C.Ctx = C.ext GB Fib ;
 module PF (pF : C.El GB (PU.isProp GB Fib)) (ms : C.El GB T) {
  pB : C.El GT (PU.isProp GT (OV.wkT GB T Fib)) =
   OV.trE GT (C.subT GT GB (PU.isProp GB Fib) (C.p GB T)) (PU.isProp GT (OV.wkT GB T Fib))
    (PU.isProp-ov GT GB Fib (C.p GB T) (OV.wkT GB T Fib) (refl (OV.wkT GB T Fib))) (C.subt GT GB (PU.isProp GB Fib) pF (C.p GB T)) ;
  pEq : Id (C.Sub GF GB) (C.o GF GT GB (C.p GB T) (TA.incS GB Fib)) (C.p GB Fib) =
   L.sub-ext GF GB (C.o GF GT GB (C.p GB T) (TA.incS GB Fib)) (C.p GB Fib) (\ K z -> refl z.1) ;
  Pth : Id (C.Ty GF) (OV.wkT GB Fib Fib) (C.subT GF GT (OV.wkT GB T Fib) (TA.incS GB Fib)) =
   transH (apH {C.Sub GF GB} {C.Ty GF} (\ z -> C.subT GF GB Fib z) (symH pEq)) (C.subT-o GF GT GB Fib (C.p GB T) (TA.incS GB Fib)) ;
  bq : C.El GF (C.subT GF GT (OV.wkT GB T Fib) (TA.incS GB Fib)) =
   OV.trE GF (OV.wkT GB Fib Fib) (C.subT GF GT (OV.wkT GB T Fib) (TA.incS GB Fib)) Pth (C.q GB Fib) ;
  el : C.El GT (OV.wkT GB T Fib) = TA.elim GB Fib (OV.wkT GB T Fib) pB bq ;
  c : C.El GB Fib =
   OV.trE GB (C.subT GB GT (OV.wkT GB T Fib) (C.sec GB T ms)) Fib (CAppRd[a].W.psT GB T Fib ms) (C.subt GB GT (OV.wkT GB T Fib) el (C.sec GB T ms)) ;
  contrFib : C.El GB (EQ.isContr GB Fib) = PPp.contrOfProp GB Fib pF c ;
 } ;
} ;
