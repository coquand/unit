-- CTotCat.seg (canonicity-45; SIMPLIFIED.md step 4): the total category
-- of an internal category IC as a small category (objects (I, x), maps
-- (u, f) : (J, y) -> (I, x), identities, composition and laws = IC's own
-- fields, verbatim), so that core/Presheaf.seg's generic CwF Psh[TotCat]
-- is the CwF of presheaves over the total site; and the conversions
-- between the displayed presheaves of CTPsh (TCtx, TSub) and Psh's PCtx,
-- PSub (two lines each way).
-- No new axioms.

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
module VB = V[a] ;
module EM = Encode[a, vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module TotOf (C : CIntCat[a, vl].IC) {
 module VT = CVert[a, vl].VertOf[C] ;
 -- the base's codes, embedded at the vertical level (Ix on the nose)
 embV (c : VB.V) : VA.V = EM.codeOf (VB.Ix c) (EM.encIx0 c) ;
 tobV : VA.V = VA.SigV (embV obV) (\ I -> C.obD I) ;
 TOb : U vl = VA.Ix tobV ;
 thomV (Y X : TOb) : VA.V = VA.SigV (embV (homV Y.1 X.1)) (\ u -> C.homD Y.1 X.1 u Y.2 X.2) ;
 THm (Y X : TOb) : U vl = VA.Ix (thomV Y X) ;
 tid (X : TOb) : THm X X = (idH X.1, C.idD X.1 X.2) ;
 tcomp (Z Y X : TOb) (f : THm Y X) (g : THm Z Y) : THm Z X = (compH Z.1 Y.1 X.1 f.1 g.1, C.compD Z.1 Y.1 X.1 f.1 g.1 Z.2 Y.2 X.2 f.2 g.2) ;
 TotCat : SmallCat[vl].SmallCat =
  new SmallCat[vl].SmallCat[tobV, \ Y X -> thomV Y X, \ X -> tid X, \ Z Y X f g -> tcomp Z Y X f g,
   \ Y X f -> C.idl Y.1 X.1 f.1 Y.2 X.2 f.2,
   \ Y X f -> C.idr Y.1 X.1 f.1 Y.2 X.2 f.2,
   \ T Z Y X f g h -> C.assoc T.1 Z.1 Y.1 X.1 f.1 g.1 h.1 T.2 Z.2 Y.2 X.2 f.2 g.2 h.2] ;

 -- the projection to the base (a functor), with its laws by refl
 pO (X : TOb) : Ob = X.1 ;
 pH (Y X : TOb) (f : THm Y X) : Hom Y.1 X.1 = f.1 ;
 pH-id (X : TOb) : Id (Hom X.1 X.1) (pH X X (tid X)) (idH X.1) = refl (idH X.1) ;
 pH-comp (Z Y X : TOb) (f : THm Y X) (g : THm Z Y) : Id (Hom Z.1 X.1) (pH Z X (tcomp Z Y X f g)) (compH Z.1 Y.1 X.1 (pH Y X f) (pH Z Y g)) =
  refl (compH Z.1 Y.1 X.1 f.1 g.1) ;
 -- the cartesian lift of a base map u : J -> I at (I, x), as a map of
 -- TotCat over u, with its universal property restated for TotCat's homs:
 -- every total map (K, z) -> (I, x) over u . v factors uniquely through it
 cartT (J : Ob) (X : TOb) (u : Hom J X.1) : THm (J, C.res J X.1 u X.2) X = (u, C.cart J X.1 u X.2) ;
 factT (J : Ob) (Z X : TOb) (u : Hom J X.1) (v : Hom Z.1 J) (h : THm Z X) (e : Id (Hom Z.1 X.1) h.1 (compH Z.1 J X.1 u v))
  : THm Z (J, C.res J X.1 u X.2) =
  (v, C.fact Z.1 J X.1 u v Z.2 X.2 (VT.trH Z.1 X.1 h.1 (compH Z.1 J X.1 u v) e Z.2 X.2 h.2)) ;
 factT-eq (J : Ob) (Z X : TOb) (u : Hom J X.1) (v : Hom Z.1 J) (h : THm Z X) (e : Id (Hom Z.1 X.1) h.1 (compH Z.1 J X.1 u v))
  : Id (THm Z X) (tcomp Z (J, C.res J X.1 u X.2) X (cartT J X u) (factT J Z X u v h e)) h =
  transH (VT.pairL Z.1 X.1 (compH Z.1 J X.1 u v) Z.2 X.2
            (C.compD Z.1 J X.1 u v Z.2 (C.res J X.1 u X.2) X.2 (C.cart J X.1 u X.2) (factT J Z X u v h e).2)
            (VT.trH Z.1 X.1 h.1 (compH Z.1 J X.1 u v) e Z.2 X.2 h.2)
            (C.fact-eq Z.1 J X.1 u v Z.2 X.2 (VT.trH Z.1 X.1 h.1 (compH Z.1 J X.1 u v) e Z.2 X.2 h.2)))
   (VT.TH-tr Z.1 X.1 h.1 (compH Z.1 J X.1 u v) e Z.2 X.2 h.2) ;
 factT-uniq (J : Ob) (Z X : TOb) (u : Hom J X.1) (v : Hom Z.1 J) (h : THm Z X) (e : Id (Hom Z.1 X.1) h.1 (compH Z.1 J X.1 u v))
  (g : VA.Ix (C.homD Z.1 J v Z.2 (C.res J X.1 u X.2)))
  (eg : Id (THm Z X) (tcomp Z (J, C.res J X.1 u X.2) X (cartT J X u) (v, g)) h)
  : Id (VA.Ix (C.homD Z.1 J v Z.2 (C.res J X.1 u X.2))) g (factT J Z X u v h e).2 =
  C.fact-uniq Z.1 J X.1 u v Z.2 X.2 (VT.trH Z.1 X.1 h.1 (compH Z.1 J X.1 u v) e Z.2 X.2 h.2) g
   (symH (VT.THom-snd' Z.1 X.1 Z.2 X.2 h (compH Z.1 J X.1 u v, C.compD Z.1 J X.1 u v Z.2 (C.res J X.1 u X.2) X.2 (C.cart J X.1 u X.2) g) (symH eg) e)) ;

 -- presheaves over the total site, generically
 module P = Presheaf[vl, l].Psh[TotCat] ;
 module TP = CTPsh[a, vl, l].TPshOf[C] ;

 -- displayed presheaves are presheaves over the total category
 toP (G : TP.TCtx) : P.PCtx =
  new P.PCtx[\ X -> G.ob X.1 X.2, \ Y X f -> G.act Y.1 X.1 f.1 Y.2 X.2 f.2, \ X g -> G.act-id X.1 X.2 g,
   \ Z Y X f g e -> G.act-o Z.1 Y.1 X.1 f.1 g.1 Z.2 Y.2 X.2 f.2 g.2 e] ;
 toPS (D G : TP.TCtx) (s : TP.TSub[D, G]) : P.PSub[toP D, toP G] =
  new P.PSub[toP D, toP G, \ X d -> s.nt X.1 X.2 d, \ Y X f d -> s.nt-nat Y.1 X.1 f.1 Y.2 X.2 f.2 d] ;
 -- and conversely
 ofP (G : P.PCtx) : TP.TCtx =
  new TP.TCtx[\ I x -> G.ob (I, x), \ J I u y x f -> G.act (J, y) (I, x) (u, f), \ I x g -> G.act-id (I, x) g,
   \ K J I u v z y x f f' g -> G.act-o (K, z) (J, y) (I, x) (u, f) (v, f') g] ;
} ;
