-- CRelCode.seg (canonicity-45; SIMPLIFIED.md step 2a / c2's item 2): the
-- congruence of a presented algebra, in the form the Voevodsky quotient
-- takes it.  For a metatheory presentation x and metatheory terms t, u,
-- Proof_x t u is a closed metatheory set (CDerCode.proofV); its constant
-- type over the terminal context is a closed small fibrant type (CConst at
-- level a), its truncation there (CTruncCwF.Tr0 over nilP) is a closed
-- proposition, hence has a code in the universe over EVERY context
-- (CClosedCode) whose decoding is a proposition (CClosedProp).  This is
-- R t u, handed to canonicity-c2's Q as a function of the metatheory pair.
--   RelCode[R, encK, x].PT[t, u].code G       : element of Cod G
--   RelCode[R, encK, x].PT[t, u].Prop[G].M.contr : its decoding is contractible
--                                                  once inhabited (a proposition)
-- No new axioms.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module W0 = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GS = PB.GPre[a].PS ;
module L = PB.GPre[a+].PS ;
module FU = FibUniv[a] ;
open Ring[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;

module RelCode (R : CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) {
 module DC = CDerCode[a].DerCode[R, encK, x] ;
 module Dx = SX.Over[R].Der[x] ;
 module PT (t u : Dx.Term) {
  -- the constant type of proofs of t ~ u over the terminal context
  module K = CConst[a, a].ConstOf[CCyl[a].PosCyl.posCyl, DC.proofV t u] ;
  P0 : FibCwF[a, a].FC.STy GS.nilP = K.constS GS.nilP ;
  -- its truncation over the terminal context: a closed proposition
  module T = CTruncCwF[a, a].TrOf[GS.nilP, P0] ;
  -- the code over any context
  code (G : L.PCtx) : L.PEl[G, (FU.Cod G).1] = CClosedCode[a].Closed[T.Tr0.1, T.Tr0.2].code G ;
  -- its decoding is a proposition
  module Prop (G : L.PCtx) { module M = CClosedProp[a].ClosedProp[T.Tr0.1, T.Tr0.2, T.rcTr, G] ; } ;
 } ;
} ;
