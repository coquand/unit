-- CCmpU5.seg (canonicity-c2; (K) for cmpI, part 5): reading an
-- application of a weakened closed FunOf (QinvEq.AppW then FunOf.bod-eq):
--   (app (wkF (FunOf n)) aa).eob W z = n.nfun W z.1 (aa.eob W z)
-- over any extension G.Y of a context.  All the internal functions of (U)
-- are built this way, so that no Pi code is read after a transport.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module AF (G : C.Ctx) (Y P Q : C.Ty G) (n : HO.NMap[G, P.1, Q.1]) (aa : C.El (C.ext G Y) (OV.wkT G Y P)) {
 module FO = QinvEq[a, a+].FunOf[G, P, Q, n] ;
 module AW = QinvEq[a, a+].AppW[G, Y, P, Q, FO.fC, aa] ;
 t : C.El (C.ext G Y) (OV.wkT G Y Q) = AW.t ;
 rd (W : Ob) (z : V1.Ix ((C.ext G Y).ob W)) : Id (V1.Ix (Q.1.tob W z.1)) (t.eob W z) (n.nfun W z.1 (aa.eob W z)) =
  transH (AW.val W z) (FO.bod-eq W (L.pairE G P.1 W z.1 (aa.eob W z))) ;
} ;
