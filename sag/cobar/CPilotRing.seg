-- CPilotRing.seg (canonicity-45; SIMPLIFIED.md step 2, the pilot): F_1 =
-- polynomials in one variable over a metatheory ring k, as the quotient of
-- the constant type of coefficient lists by the coefficientwise congruence
-- (zero-padded), with its universal property into an h-set ring R of the
-- base: given r : R and a map phi from k into R sending 0 to 0, the
-- evaluation ev p = sum phi(p_i) r^i respects the congruence, so it
-- factors through the quotient.  The quotient enters through its
-- interface (module parameters: Q, inc, the eliminator into h-sets for a
-- constant domain and a constant relation, its computation rule), to be
-- replaced by canonicity-c2's generic Voevodsky quotient.
--
-- What is measured: the cost of ring algebra "up to paths" in the base's
-- CwF (fibCwF with fibPi, fibId), with laws as Id-elements chained by
-- CwFPth.transM / symM and congruences by apM, and metatheory recursion
-- over the constant domain (no internal induction).
--   HRing G          an h-set ring over G: carrier, operations as elements
--                    of function types, laws as Id-elements for all
--                    elements over G, Id a proposition
--   Poly, sim        coefficient lists (n , c) and the congruence
--   Ev[G, Rg, r, phi] ev, respects : sim p q -> Id (ev p) (ev q)
--   Univ[..]         the map out of the quotient and its computation rule
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module FBC = FibCwF[a, l] ;
module FID = FibId[a, l] ;
module PT = CwFPth.Pth[l+, FBC.fibCwF, FBC.fibPi, FBC.fibSig, FID.fibId] ;
module IN = CwFInt.Int[l+, FBC.fibCwF, FBC.fibPi, FBC.fibSig, FID.fibId] ;
open CwFOv.Ov[l+, FBC.fibCwF, FBC.fibPi, FBC.fibSig, FID.fibId] ;
C : CwF.CwF[l+] = FBC.fibCwF ;
IJ : CwFId.SwanId[l+, FBC.fibCwF].IdJStr = FID.fibId ;

------------------------------------------------------------------
-- an h-set ring over a context, laws up to paths

ap2 (G : C.Ctx) (R : C.Ty G) (f : C.El G (Fun G R (Fun G R R))) (x y : C.El G R) : C.El G R =
 app G R R (app G R (Fun G R R) f x) y ;

record HRing (G : C.Ctx) {
 R : C.Ty G ;
 add : C.El G (Fun G R (Fun G R R)) ;
 mul : C.El G (Fun G R (Fun G R R)) ;
 zero : C.El G R ;
 one : C.El G R ;
 add-assoc (x y z : C.El G R) : C.El G (IJ.IdT G R (ap2 G R add (ap2 G R add x y) z) (ap2 G R add x (ap2 G R add y z))) ;
 add-comm (x y : C.El G R) : C.El G (IJ.IdT G R (ap2 G R add x y) (ap2 G R add y x)) ;
 add-zero (x : C.El G R) : C.El G (IJ.IdT G R (ap2 G R add x zero) x) ;
 mul-assoc (x y z : C.El G R) : C.El G (IJ.IdT G R (ap2 G R mul (ap2 G R mul x y) z) (ap2 G R mul x (ap2 G R mul y z))) ;
 mul-comm (x y : C.El G R) : C.El G (IJ.IdT G R (ap2 G R mul x y) (ap2 G R mul y x)) ;
 mul-one (x : C.El G R) : C.El G (IJ.IdT G R (ap2 G R mul x one) x) ;
 mul-zero (x : C.El G R) : C.El G (IJ.IdT G R (ap2 G R mul zero x) zero) ;
 distr (x y z : C.El G R) : C.El G (IJ.IdT G R (ap2 G R mul x (ap2 G R add y z)) (ap2 G R add (ap2 G R mul x y) (ap2 G R mul x z))) ;
 set (x y : C.El G R) (p q : C.El G (IJ.IdT G R x y)) : Id (C.El G (IJ.IdT G R x y)) p q ;
} ;

-- congruences of the operations: in the second argument by apM on the
-- body of the partial application, in the first through commutativity
module Cong (G : C.Ctx) (Rg : HRing[G]) {
 R : C.Ty G = Rg.R ;
 Idr (x y : C.El G R) : C.Ty G = IJ.IdT G R x y ;
 tr (x y z : C.El G R) (u : C.El G (Idr x y)) (w : C.El G (Idr y z)) : C.El G (Idr x z) = PT.transM G R x y z u w ;
 sy (x y : C.El G R) (u : C.El G (Idr x y)) : C.El G (Idr y x) = PT.symM G R x y u ;
 rf (x : C.El G R) : C.El G (Idr x x) = IJ.rfl G R x ;
 addR (x y y' : C.El G R) (v : C.El G (Idr y y')) : C.El G (Idr (ap2 G R Rg.add x y) (ap2 G R Rg.add x y')) =
  PT.apM G R R (bod G R (wkT G R R) (app G R (Fun G R R) Rg.add x)) y y' v ;
 mulR (x y y' : C.El G R) (v : C.El G (Idr y y')) : C.El G (Idr (ap2 G R Rg.mul x y) (ap2 G R Rg.mul x y')) =
  PT.apM G R R (bod G R (wkT G R R) (app G R (Fun G R R) Rg.mul x)) y y' v ;
 addL (x x' y : C.El G R) (u : C.El G (Idr x x')) : C.El G (Idr (ap2 G R Rg.add x y) (ap2 G R Rg.add x' y)) =
  tr (ap2 G R Rg.add x y) (ap2 G R Rg.add y x) (ap2 G R Rg.add x' y) (Rg.add-comm x y)
   (tr (ap2 G R Rg.add y x) (ap2 G R Rg.add y x') (ap2 G R Rg.add x' y) (addR y x x' u) (Rg.add-comm y x')) ;
 mulL (x x' y : C.El G R) (u : C.El G (Idr x x')) : C.El G (Idr (ap2 G R Rg.mul x y) (ap2 G R Rg.mul x' y)) =
  tr (ap2 G R Rg.mul x y) (ap2 G R Rg.mul y x) (ap2 G R Rg.mul x' y) (Rg.mul-comm x y)
   (tr (ap2 G R Rg.mul y x) (ap2 G R Rg.mul y x') (ap2 G R Rg.mul x' y) (mulR y x x' u) (Rg.mul-comm y x')) ;
 add2 (x x' y y' : C.El G R) (u : C.El G (Idr x x')) (v : C.El G (Idr y y')) : C.El G (Idr (ap2 G R Rg.add x y) (ap2 G R Rg.add x' y')) =
  tr _ _ _ (addL x x' y u) (addR x' y y' v) ;
 -- an external equality of elements is an Id-element
 ofEq (x y : C.El G R) (e : Id (C.El G R) x y) : C.El G (Idr x y) = IN.idOfEq G R x y e ;
} ;

------------------------------------------------------------------
-- coefficient lists over a metatheory ring k (only its carrier and zero
-- are used here), and the zero-padded coefficientwise congruence

-- natural-number lemmas not in Arith
module NatL {
 absurd-ft (A : U l) (h : Id Bool false true) : A = absurd A (Prelude[a].subst Bool Tr.FT false true h tt) ;
 leb-flip : (n j : Nat) -> Tr.IsT (Tr.leb n j) -> Id Bool (Tr.leb (suc j) n) false = split {
  zero -> \ j h -> refl false ;
  suc n | ih -> split { zero -> \ h -> absurd-ft (Id Bool (Tr.leb (suc zero) (suc n)) false) h ; suc j -> \ h -> ih j h } } ;
 plus-comm : (m n : Nat) -> Id Nat (Ar.plus m n) (Ar.plus n m) = split {
  zero -> \ n -> symH (Ar.plus-zero n) ;
  suc m | ih -> \ n -> transH (apH {Nat} {Nat} (\ k -> suc k) (ih n)) (symH (Ar.plus-suc n m)) } ;
 ltb-suc (i n : Nat) (h : Tr.IsT (Ar.ltb i n)) : Tr.IsT (Ar.ltb i (suc n)) = Tr.leb-trans (suc i) n (suc n) h (Ar.leb-suc n) ;
 ltb-refl (n : Nat) : Tr.IsT (Ar.ltb n (suc n)) = Tr.leb-refl (suc n) ;
} ;

module Lists (kV : W0.V) (k0 : W0.Ix kV) {
 K : U l = W0.Ix kV ;
 Poly : U l = (n : Nat) * (Nat -> K) ;
 cond : Bool -> K -> K -> K = split { true -> \ x y -> x ; false -> \ x y -> y } ;
 coef (p : Poly) (i : Nat) : K = cond (Ar.ltb i p.1) (p.2 i) k0 ;
 sim (p q : Poly) : U l = (i : Nat) -> Id K (coef p i) (coef q i) ;
 -- beyond the length the coefficients are zero
 coef-beyond (p : Poly) (j : Nat) (h : Tr.IsT (Tr.leb p.1 j)) : Id K (coef p j) k0 =
  apH {Bool} {K} (\ b -> cond b (p.2 j) k0) (NatL.leb-flip p.1 j h) ;
 -- within the length they are the list's
 coef-within (p : Poly) (i : Nat) (h : Tr.IsT (Ar.ltb i p.1)) : Id K (coef p i) (p.2 i) =
  apH {Bool} {K} (\ b -> cond b (p.2 i) k0) h ;
} ;

------------------------------------------------------------------
-- evaluation into an h-set ring, and its respect for the congruence

module Ev (G : C.Ctx) (Rg : HRing[G]) (kV : W0.V) (k0 : W0.Ix kV)
 (r : C.El G Rg.R) (phi : W0.Ix kV -> C.El G Rg.R) (phi0 : C.El G (IJ.IdT G Rg.R (phi k0) Rg.zero)) {
 module L = Lists[kV, k0] ;
 module CG = Cong[G, Rg] ;
 R : C.Ty G = Rg.R ;
 add (x y : C.El G R) : C.El G R = ap2 G R Rg.add x y ;
 mul (x y : C.El G R) : C.El G R = ap2 G R Rg.mul x y ;
 pow : Nat -> C.El G R = split { zero -> Rg.one ; suc n | ih -> mul ih r } ;
 evN (c : Nat -> L.K) : Nat -> C.El G R = split { zero -> Rg.zero ; suc n | ih -> add ih (mul (phi (c n)) (pow n)) } ;
 ev (p : L.Poly) : C.El G R = evN p.2 p.1 ;

 -- (A) a zero coefficient at n does not change the value
 padOne (c : Nat -> L.K) (n : Nat) (hz : Id L.K (c n) k0) : C.El G (CG.Idr (evN c (suc n)) (evN c n)) =
  CG.tr _ _ _ (CG.addR (evN c n) (mul (phi (c n)) (pow n)) (mul Rg.zero (pow n))
                 (CG.mulL (phi (c n)) Rg.zero (pow n) (CG.tr _ _ _ (CG.ofEq (phi (c n)) (phi k0) (apH {L.K} {C.El G R} phi hz)) phi0)))
   (CG.tr _ _ _ (CG.addR (evN c n) (mul Rg.zero (pow n)) Rg.zero (Rg.mul-zero (pow n))) (Rg.add-zero (evN c n))) ;

 -- (B) equal coefficients below n give equal values
 agree (c d : Nat -> L.K) : (n : Nat) -> ((i : Nat) -> Tr.IsT (Ar.ltb i n) -> Id L.K (c i) (d i)) -> C.El G (CG.Idr (evN c n) (evN d n)) = split {
  zero -> \ h -> CG.rf Rg.zero ;
  suc n | ih -> \ h ->
   CG.add2 (evN c n) (evN d n) (mul (phi (c n)) (pow n)) (mul (phi (d n)) (pow n))
    (ih (\ i hi -> h i (NatL.ltb-suc i n hi)))
    (CG.mulL (phi (c n)) (phi (d n)) (pow n) (CG.ofEq (phi (c n)) (phi (d n)) (apH {L.K} {C.El G R} phi (h n (NatL.ltb-refl n))))) } ;

 -- (A') zero coefficients from n on: the value at plus n m is the value at n
 pad (c : Nat -> L.K) (n : Nat) (hz : (j : Nat) -> Tr.IsT (Tr.leb n j) -> Id L.K (c j) k0)
  : (m : Nat) -> C.El G (CG.Idr (evN c (Ar.plus n m)) (evN c n)) = split {
  zero -> CG.ofEq (evN c (Ar.plus n zero)) (evN c n) (apH {Nat} {C.El G R} (evN c) (Ar.plus-zero n)) ;
  suc m | ih -> CG.tr _ _ _ (CG.ofEq (evN c (Ar.plus n (suc m))) (evN c (suc (Ar.plus n m))) (apH {Nat} {C.El G R} (evN c) (Ar.plus-suc n m)))
                 (CG.tr _ _ _ (padOne c (Ar.plus n m) (hz (Ar.plus n m) (Ar.leb-plus n m))) ih) } ;

 -- the congruence is respected
 respects (p q : L.Poly) (h : L.sim p q) : C.El G (CG.Idr (ev p) (ev q)) =
  CG.tr _ _ _ (agree p.2 (L.coef p) p.1 (\ i hi -> symH (L.coef-within p i hi)))
   (CG.tr _ _ _ (CG.sy _ _ (pad (L.coef p) p.1 (L.coef-beyond p) q.1))
     (CG.tr _ _ _ (agree (L.coef p) (L.coef q) (Ar.plus p.1 q.1) (\ i hi -> h i))
       (CG.tr _ _ _ (CG.ofEq (evN (L.coef q) (Ar.plus p.1 q.1)) (evN (L.coef q) (Ar.plus q.1 p.1))
                       (apH {Nat} {C.El G R} (evN (L.coef q)) (NatL.plus-comm p.1 q.1)))
         (CG.tr _ _ _ (pad (L.coef q) q.1 (L.coef-beyond q) p.1)
           (agree (L.coef q) q.2 q.1 (\ i hi -> L.coef-within q i hi)))))) ;
} ;

------------------------------------------------------------------
-- the universal map out of the quotient (interface of the quotient of a
-- constant type by a constant relation, to be instantiated by the
-- generic Voevodsky quotient)

module Univ (G : C.Ctx) (Rg : HRing[G]) (kV : W0.V) (k0 : W0.Ix kV)
 (r : C.El G Rg.R) (phi : W0.Ix kV -> C.El G Rg.R) (phi0 : C.El G (IJ.IdT G Rg.R (phi k0) Rg.zero))
 (Q : C.Ty G) (inc : Lists[kV, k0].Poly -> C.El G Q)
 (elim : (B : C.Ty G) -> ((x y : C.El G B) (u v : C.El G (IJ.IdT G B x y)) -> Id (C.El G (IJ.IdT G B x y)) u v)
         -> (f : Lists[kV, k0].Poly -> C.El G B)
         -> ((p q : Lists[kV, k0].Poly) -> Lists[kV, k0].sim p q -> C.El G (IJ.IdT G B (f p) (f q)))
         -> C.El G (Fun G Q B))
 (elim-beta : (B : C.Ty G) (sB : (x y : C.El G B) (u v : C.El G (IJ.IdT G B x y)) -> Id (C.El G (IJ.IdT G B x y)) u v)
         (f : Lists[kV, k0].Poly -> C.El G B)
         (rs : (p q : Lists[kV, k0].Poly) -> Lists[kV, k0].sim p q -> C.El G (IJ.IdT G B (f p) (f q)))
         (p : Lists[kV, k0].Poly) -> C.El G (IJ.IdT G B (app G Q B (elim B sB f rs) (inc p)) (f p))) {
 module E = Ev[G, Rg, kV, k0, r, phi, phi0] ;
 umap : C.El G (Fun G Q Rg.R) = elim Rg.R Rg.set E.ev E.respects ;
 umap-beta (p : Lists[kV, k0].Poly) : C.El G (IJ.IdT G Rg.R (app G Q Rg.R umap (inc p)) (E.ev p)) =
  elim-beta Rg.R Rg.set E.ev E.respects p ;
} ;
