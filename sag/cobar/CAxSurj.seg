-- CAxSurj.seg (canonicity-c2; the axioms' statements, duality: surjectivity).
-- For u (k coefficients, n points, equations qs; a metatheory schema), over
-- Pr_u.(f : G^{Sp u}):
--     || Sigma (c : Delta(Exp_n) -> G). Sigma (d : Delta N). ev_u (d, c) = f ||
-- G[X_n] = Sigma d. (Delta(Exp_n) -> G): a degree bound d and the
-- coefficients of all monomials (those of degree > d are not used);
-- ev_u (d, c) = \ x h. Sum_{deg al <= d} c(al) x^al, defined for each
-- metatheory d and packed over Delta N.  The shapes are indexed by Delta N
-- as a device; the model's naturals are N_D, and tau : Delta N -> N_D
-- (D's unit) relates the two.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module SurjOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (addV mulV : (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X)
  (addN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (addV I u v)) (addV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (mulN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (mulV I u v)) (mulV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (cV : R.R -> (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X)
  (cN : (r : R.R) (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (cV r I)) (cV r J))
  (k n : Nat) {
 module PJ = CAxProj[a].ProjOf[R, encK, pe, addV, mulV, addN, mulN, cV, cN, k, n] ;
 module S = PJ.S ;
 module PW = S.PW ;
 C : CwF.CwF[a++] = S.C ;
 module OV = S.OV ;
 Nl : C.Ctx = S.Nl ;
 Pr : C.Ctx = S.Pr ;
 Eqs : U a = PJ.Eqs ;
 GA (E : C.Ctx) : C.Ty E = PW.Gat E ;
 -- G along any substitution
 gatSub (E Z : C.Ctx) (s : C.Sub E Z) : Id (C.Ty E) (C.subT E Z (GA Z) s) (GA E) =
  transH (symH (C.subT-o E Z Nl PW.GTy (C.eps Z) s))
   (apH {C.Sub E Nl} {C.Ty E} (\ t -> C.subT E Nl PW.GTy t) (transH (C.eps-uniq E (C.o E Z Nl (C.eps Z) s)) (symH (C.eps-uniq E (C.eps E))))) ;
 gs (E Z : C.Ctx) (s : C.Sub E Z) (g : C.El Z (GA Z)) : C.El E (GA E) = OV.trE E (C.subT E Z (GA Z) s) (GA E) (gatSub E Z s) (C.subt E Z (GA Z) g s) ;
 module At (D : C.Ctx) (s : C.Sub D Pr) (qs : Eqs) {
  XDj (j : Nat) : C.Ctx = (PJ.XD D s j).1 ;
  -- projections of the telescope
  prX : (j : Nat) -> C.Sub (XDj j) D = split {
   zero -> C.id D ;
   suc j | r -> C.o (XDj (suc j)) (XDj j) D r (C.p (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2)) } ;
  HDq (D1 : C.Ctx) (s1 : C.Sub D1 S.Xc) (q2 : Eqs) : C.Ctx = (PJ.HD D1 s1 q2).1 ;
  prH (D1 : C.Ctx) (s1 : C.Sub D1 S.Xc) : (q2 : Eqs) -> C.Sub (HDq D1 s1 q2) D1 = split {
   nil -> C.id D1 ;
   cons q q2 | r -> C.o (HDq D1 s1 (cons q q2)) (HDq D1 s1 q2) D1 r
     (C.p (HDq D1 s1 q2) (C.subT (HDq D1 s1 q2) (S.HS q2).1 (S.EqT (S.HS q2).1 (S.HS q2).2 q) (PJ.HD D1 s1 q2).2)) } ;
  Xn : C.Ctx = XDj n ;
  Sc : C.Ctx = PJ.SpC D s qs ;
  prS : C.Sub Sc Xn = prH Xn (PJ.XD D s n).2 qs ;
  -- the point variables
  xv : (j : Nat) -> SX.Fin j -> C.El (XDj j) (GA (XDj j)) = split {
   zero -> \ v -> absurd (C.El D (GA D)) v ;
   suc j | r -> split {
    inl v -> gs (XDj (suc j)) (XDj j) (C.p (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2)) (r v) ;
    inr u -> OV.trE (XDj (suc j)) (C.subT (XDj (suc j)) (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2) (C.p (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2)))
               (GA (XDj (suc j)))
               (transH (apH {C.Ty (XDj j)} {C.Ty (XDj (suc j))} (\ T -> C.subT (XDj (suc j)) (XDj j) T (C.p (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2)))
                          (gatSub (XDj j) (PW.Ext Pr j) (PJ.XD D s j).2))
                  (gatSub (XDj (suc j)) (XDj j) (C.p (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2))))
               (C.q (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2)) } } ;
  -- lambda over the telescope
  lamH (D1 : C.Ctx) (s1 : C.Sub D1 S.Xc) : (q2 : Eqs) (B : C.Ty (HDq D1 s1 q2)) -> C.El (HDq D1 s1 q2) B -> C.El D1 (PJ.PiHD D1 s1 q2 B) = split {
   nil -> \ B b -> b ;
   cons q q2 | r -> \ B b -> r (S.Pi (HDq D1 s1 q2) (C.subT (HDq D1 s1 q2) (S.HS q2).1 (S.EqT (S.HS q2).1 (S.HS q2).2 q) (PJ.HD D1 s1 q2).2) B)
       (OV.lam (HDq D1 s1 q2) (C.subT (HDq D1 s1 q2) (S.HS q2).1 (S.EqT (S.HS q2).1 (S.HS q2).2 q) (PJ.HD D1 s1 q2).2) B b) } ;
  lamX : (j : Nat) (B : C.Ty (XDj j)) -> C.El (XDj j) B -> C.El D (PJ.PiXD D s j B) = split {
   zero -> \ B b -> b ;
   suc j | r -> \ B b -> r (S.Pi (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2) B)
       (OV.lam (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2) B b) } ;
  lamSp (b : C.El Sc (GA Sc)) : C.El D (PJ.PiSp D s qs (GA Sc)) = lamX n (PJ.PiHD Xn (PJ.XD D s n).2 qs (GA Sc)) (lamH Xn (PJ.XD D s n).2 qs (GA Sc) b) ;
  -- G^{Sp u} substituted along s is the Pi over the substituted telescope
  stX : (j : Nat) (B : C.Ty (PW.Ext Pr j)) (B' : C.Ty (XDj j)) (PB : Id (C.Ty (XDj j)) (C.subT (XDj j) (PW.Ext Pr j) B (PJ.XD D s j).2) B')
     -> Id (C.Ty D) (C.subT D Pr (S.PiX j B) s) (PJ.PiXD D s j B') = split {
   zero -> \ B B' PB -> PB ;
   suc j | r -> \ B B' PB -> r (S.Pi (PW.Ext Pr j) (GA (PW.Ext Pr j)) B) (S.Pi (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2) B')
      (transH (PW.G1.fibPi-T.Pi-nat (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) B (PJ.XD D s j).2)
        (apH {C.Ty (XDj (suc j))} {C.Ty (XDj j)} (\ T -> S.Pi (XDj j) (C.subT (XDj j) (PW.Ext Pr j) (GA (PW.Ext Pr j)) (PJ.XD D s j).2) T) PB)) } ;
  stH (D1 : C.Ctx) (s1 : C.Sub D1 S.Xc) : (q2 : Eqs) (B : C.Ty (S.HS q2).1) (B' : C.Ty (HDq D1 s1 q2))
     (PB : Id (C.Ty (HDq D1 s1 q2)) (C.subT (HDq D1 s1 q2) (S.HS q2).1 B (PJ.HD D1 s1 q2).2) B')
     -> Id (C.Ty D1) (C.subT D1 S.Xc (S.PiH q2 B) s1) (PJ.PiHD D1 s1 q2 B') = split {
   nil -> \ B B' PB -> PB ;
   cons q q2 | r -> \ B B' PB -> r (S.Pi (S.HS q2).1 (S.EqT (S.HS q2).1 (S.HS q2).2 q) B)
      (S.Pi (HDq D1 s1 q2) (C.subT (HDq D1 s1 q2) (S.HS q2).1 (S.EqT (S.HS q2).1 (S.HS q2).2 q) (PJ.HD D1 s1 q2).2) B')
      (transH (PW.G1.fibPi-T.Pi-nat (HDq D1 s1 q2) (S.HS q2).1 (S.EqT (S.HS q2).1 (S.HS q2).2 q) B (PJ.HD D1 s1 q2).2)
        (apH {C.Ty (HDq D1 s1 (cons q q2))} {C.Ty (HDq D1 s1 q2)}
           (\ T -> S.Pi (HDq D1 s1 q2) (C.subT (HDq D1 s1 q2) (S.HS q2).1 (S.EqT (S.HS q2).1 (S.HS q2).2 q) (PJ.HD D1 s1 q2).2) T) PB)) } ;
  stab : Id (C.Ty D) (C.subT D Pr (S.Exp PW.GTy qs) s) (PJ.PiSp D s qs (GA Sc)) =
   stX n (S.PiH qs (GA (S.HS qs).1)) (PJ.PiHD Xn (PJ.XD D s n).2 qs (GA Sc))
    (stH Xn (PJ.XD D s n).2 qs (GA (S.HS qs).1) (GA Sc) (gatSub Sc (S.HS qs).1 (PJ.HD Xn (PJ.XD D s n).2 qs).2)) ;
 } ;
 -- the statement
 module Main (qs : Eqs) {
  module DL = CAxDelta[a].DeltaOf[R, encK, pe] ;
  module MN = CAxMon[a].MonOf[R, n] ;
  module EO = CAxElOps[a].ElOps[R, encK, pe, addV, mulV, addN, mulN, cV, cN] ;
  module LC = PW.G1.FT.GCConstLam[a+].LamC[DL.CY.cylG, MN.ExpV n] ;
  module LN = PW.G1.FT.GCConstLam[a+].LamOf[DL.CY.cylG, V1.natV] ;
  DE0 : C.Ty Nl = DL.D (MN.ExpV n) Nl ;
  DEx (E : C.Ctx) : C.Ty E = C.subT E Nl DE0 (C.eps E) ;
  dSub (E Z : C.Ctx) (s : C.Sub E Z) : Id (C.Ty E) (C.subT E Z (DEx Z) s) (DEx E) =
   transH (symH (C.subT-o E Z Nl DE0 (C.eps Z) s))
    (apH {C.Sub E Nl} {C.Ty E} (\ t -> C.subT E Nl DE0 t) (transH (C.eps-uniq E (C.o E Z Nl (C.eps Z) s)) (symH (C.eps-uniq E (C.eps E))))) ;
  cEx (E : C.Ctx) (al : MN.Exp n) : C.El E (DEx E) = C.subt E Nl DE0 (LC.cE Nl (MN.expIx n al)) (C.eps E) ;
  -- the coefficient vectors
  Cf (E : C.Ctx) : C.Ty E = OV.Fun E (DEx E) (GA E) ;
  ExpG : C.Ty Pr = S.Exp PW.GTy qs ;
  Gm : C.Ctx = C.ext Pr ExpG ;
  p1 : C.Sub Gm Pr = C.p Pr ExpG ;
  Gc : C.Ctx = C.ext Gm (Cf Gm) ;
  p2 : C.Sub Gc Gm = C.p Gm (Cf Gm) ;
  sc : C.Sub Gc Pr = C.o Gc Gm Pr p1 p2 ;
  cF : C.El Gc (Cf Gc) =
   OV.trE Gc (C.subT Gc Gm (Cf Gm) p2) (Cf Gc) (OV.Fun-ov Gc Gm (DEx Gm) (GA Gm) p2 (DEx Gc) (dSub Gc Gm p2) (GA Gc) (gatSub Gc Gm p2)) (C.q Gm (Cf Gm)) ;
  module AC = At[Gc, sc, qs] ;
  prSc : C.Sub AC.Sc Gc = C.o AC.Sc AC.Xn Gc (AC.prX n) AC.prS ;
  -- ev (d, c) at a metatheory degree bound d
  rho : MN.Var -> C.El AC.Sc (GA AC.Sc) = split {
   inl al -> gs AC.Sc Gc prSc (OV.app Gc (DEx Gc) (GA Gc) cF (cEx Gc al)) ;
   inr i -> gs AC.Sc AC.Xn AC.prS (AC.xv n i) } ;
  T : C.Ty Gc = C.subT Gc Pr ExpG sc ;
  evd (dv : Nat) : C.El Gc T = OV.trE Gc (PJ.PiSp Gc sc qs (GA AC.Sc)) T (symH AC.stab) (AC.lamSp (EO.evA MN.Var AC.Sc rho (MN.poly dv))) ;
  -- packed over Delta N
  Gd : C.Ctx = C.ext Gc (DL.DN Gc) ;
  pd : C.Sub Gd Gc = C.p Gc (DL.DN Gc) ;
  Td : C.Ty Gd = C.subT Gd Gc T pd ;
  evE : C.El Gd Td = LN.packN Gc T.1 evd ;
  f1 : C.El Gc T = OV.trE Gc (C.subT Gc Gm (C.subT Gm Pr ExpG p1) p2) T (symH (C.subT-o Gc Gm Pr ExpG p1 p2)) (C.subt Gc Gm (C.subT Gm Pr ExpG p1) (C.q Pr ExpG) p2) ;
  fd : C.El Gd Td = C.subt Gd Gc T f1 pd ;
  P : C.Ty Gm = PJ.NO.Tr Gm (PW.G1.fibSig-T.Sig Gm (Cf Gm) (PW.G1.fibSig-T.Sig Gc (DL.DN Gc) (S.IdT Gd Td evE fd))) ;
 } ;
} ;
