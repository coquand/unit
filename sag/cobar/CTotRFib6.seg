-- CTotRFib6.seg (canonicity-c2; SIMPLIFIED.md item 5): uniformity of the
-- componentwise composite of CTotRFib5: restricting the composite along a
-- total map h is the composite of the restricted side, because the
-- action of R B is reindexing and the projected sides agree over the
-- path of points given by the functoriality of the context.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RFib6 (C : CIntCat[a].IC) {
 module R5 = CTotRFib5[a, l].RFib5[C] ;
 module TR = R5.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U a = RN.Ob0 ;
 Ob1 : U a = RN.Ob1 ;

 module Ku (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (e e' : G1.GB.IPt)
   (c0 : G0.GB.CLine[l].Lines[RS.rC G, B].CompK[e, e'].Comp) {
  module KO = R5.Ko[G, B, e, e', c0] ;
  module CP = KO.CP ;
  module PR = KO.PR ;
  module CT = KO.CT ;
  module L9 = KO.L9 ;
  module RT = KO.RT ;
  module EK1 = KO.EK1 ;
  module EK0 = KO.EK0 ;
  module TL0 = KO.TL0 ;
  UG : P0.PCtx = KO.UG ;
  K1 : P1.PCtx = KO.K1 ;
  K0 : P0.PCtx = CP.K0 ;
  Tot0 (Y : Ob0) : U l = KO.Tot0 Y ;
  Pt0 (Y : Ob0) : U l = KO.Pt0 Y ;

  -- two transported elements with equal totals are equal
  coeEq (Y : Ob0) (pa pb p : Pt0 Y) (ppA : Id (Pt0 Y) pa p) (ppB : Id (Pt0 Y) pb p)
   (a0 : W0.Ix (B.tob Y pa)) (b0 : W0.Ix (B.tob Y pb)) (Q : Id (Tot0 Y) (P0.pairE UG B Y pa a0) (P0.pairE UG B Y pb b0))
   : Id (W0.Ix (B.tob Y p)) (TL0.coeT Y pa p ppA a0) (TL0.coeT Y pb p ppB b0) =
   idJ (Pt0 Y) pb (\ p2 ppB2 -> (ppA2 : Id (Pt0 Y) pa p2) -> Id (W0.Ix (B.tob Y p2)) (TL0.coeT Y pa p2 ppA2 a0) (TL0.coeT Y pb p2 ppB2 b0))
    (\ ppA2 -> TL0.pr-eq Y pa pb ppA2 a0 b0 Q) p ppB ppA ;

  module KU (Y X : Ob1) (h : RN.Hom1 Y X) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) (Y0 : Ob0) (m : RN.Hom1 (RN.o Y0) Y) {
   z' : EK1.TV.EI Y = K1.act Y X h z ;
   hm : RN.Hom1 (RN.o Y0) X = G1.GB.BC.oC (RN.o Y0) Y X h m ;
   rs : EK1.PT.Side[Y, z'] = EK1.PT.rside Y X h z s ;
   zA : EK0.TV.EI Y0 = PR.zc X z Y0 hm ;
   zB : EK0.TV.EI Y0 = PR.zc Y z' Y0 m ;
   module SA = PR.PS[X, z, s, Y0, hm] ;
   module SB = PR.PS[Y, z', rs, Y0, m] ;
   kz : Id (EK0.TV.EI Y0) zA zB =
    ap (EK1.TV.EI (RN.o Y0)) (EK0.TV.EI Y0) (CT.kap Y0) (K1.act (RN.o Y0) X hm z) (K1.act (RN.o Y0) Y m z') (K1.act-o (RN.o Y0) Y X h m z) ;
   eQ : Id (G0.GB.Phi Y0) SA.side.pQ SB.side.pQ = symH (G1.GB.pre-comp (RN.o Y0) Y X m h s.pQ) ;
   as (Z : Ob0) (k : RN.Hom0 Z Y0)
    : Id (RN.Hom1 (RN.o Z) X) (L9.mh X Y0 hm Z k) (G1.GB.BC.oC (RN.o Z) Y X h (L9.mh Y Y0 m Z k)) =
    G1.GB.BC.oC-assoc (RN.o Z) (RN.o Y0) Y X h m (TR.fn.onH Z Y0 k) ;
   ev (Z : Ob0) (k : RN.Hom0 Z Y0) (i : G0.GB.Lands Z Y0 SA.side.pQ k) (i' : G0.GB.Lands Z Y0 SB.side.pQ k)
    : Id (EK0.TS.EI Z) (SA.side.pv Z k i) (SB.side.pv Z k i') =
    ap (EK1.TS.EI (RN.o Z)) (EK0.TS.EI Z) (PR.TO.toTS Z)
     (s.pv (RN.o Z) (L9.mh X Y0 hm Z k) i)
     (s.pv (RN.o Z) (G1.GB.BC.oC (RN.o Z) Y X h (L9.mh Y Y0 m Z k)) (G1.GB.lands-pre (RN.o Z) Y X h s.pQ (L9.mh Y Y0 m Z k) i'))
     (EK1.PT.pv-hom X z s (RN.o Z) (L9.mh X Y0 hm Z k) (G1.GB.BC.oC (RN.o Z) Y X h (L9.mh Y Y0 m Z k)) (as Z k) i
        (G1.GB.lands-pre (RN.o Z) Y X h s.pQ (L9.mh Y Y0 m Z k) i')) ;
   sideEq : Id (EK0.PT.Side[Y0, zB]) (subst (EK0.TV.EI Y0) (\ v -> EK0.PT.Side[Y0, v]) zA zB kz SA.side) SB.side =
    EK0.PT.side-extH Y0 zA zB kz SA.side SB.side eQ ev ;
   kc : Id (CP.TT0.EI Y0) (CP.TT0.pr Y0 zA (CP.kv X z s Y0 hm)) (CP.TT0.pr Y0 zB (CP.kv Y z' rs Y0 m)) =
    CP.RL0.kop-cong c0 Y0 zA zB kz SA.side SB.side sideEq ;
   tq : Id (Tot0 Y0) (P0.pairE UG B Y0 (CP.p0 Y0 zA) (CP.kv X z s Y0 hm)) (P0.pairE UG B Y0 (CP.p0 Y0 zB) (CP.kv Y z' rs Y0 m)) =
    ap (CP.TT0.EI Y0) (Tot0 Y0) (CP.eps Y0) (CP.TT0.pr Y0 zA (CP.kv X z s Y0 hm)) (CP.TT0.pr Y0 zB (CP.kv Y z' rs Y0 m)) kc ;
  } ;

  module CK1 = G1.GB.CLine[l].Lines[G, RT.RB].CompK[e, e'] ;
  module TT1 = CK1.SE.TS ;
  -- the restricted composite is the composite of the restricted side
  module UN (Y X : Ob1) (h : RN.Hom1 Y X) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) {
   z' : EK1.TV.EI Y = K1.act Y X h z ;
   rs : EK1.PT.Side[Y, z'] = EK1.PT.rside Y X h z s ;
   E : Id (W0.Ix (G.ob Y)) (G.act Y X h (KO.gE X z)) (KO.gE Y z') =
    P1.ntEq CT.RH.F1.GI G (CT.RH.F1.ev e') Y X h (EK1.TV.pr1 X z) (EK1.TV.pr1 Y z')
     (P1.ntEq K1 CT.RH.F1.GI (P1.pP CT.RH.F1.GI EK1.TV.B) Y X h z z' (refl z')) ;
   module A = RT.Act[Y, X, h, KO.gE X z, KO.gE Y z', E, KO.kop X z s] ;
   dU : Id (RT.T Y (KO.gE Y z')) (CK1.Tend.tact Y X h z z' (refl z') (KO.kop X z s)) A.res = refl A.res ;
   feq (Y0 : Ob0) (m : RN.Hom1 (RN.o Y0) Y) (p : Pt0 Y0) (eq : Id (Pt0 Y0) p (RT.at Y (KO.gE Y z') Y0 m))
    : Id (W0.Ix (B.tob Y0 p)) (A.res.1 Y0 m p eq) ((KO.kop Y z' rs).1 Y0 m p eq) =
    coeEq Y0 (CP.p0 Y0 KU[Y, X, h, z, s, Y0, m].zA) (CP.p0 Y0 KU[Y, X, h, z, s, Y0, m].zB) p
     (KO.pth X z Y0 (G1.GB.BC.oC (RN.o Y0) Y X h m) p (transH eq (A.ek Y0 m)))
     (KO.pth Y z' Y0 m p eq)
     (CP.kv X z s Y0 (G1.GB.BC.oC (RN.o Y0) Y X h m)) (CP.kv Y z' rs Y0 m) KU[Y, X, h, z, s, Y0, m].tq ;
   kunif : Id (TT1.EI Y) (TT1.E.act Y X h (TT1.pr X z (KO.kop X z s))) (TT1.pr Y z' (KO.kop Y z' rs)) =
    ap (RT.T Y (KO.gE Y z')) (TT1.EI Y) (\ v -> TT1.pr Y z' v) A.res (KO.kop Y z' rs)
     (RT.famExt Y (KO.gE Y z') A.res (KO.kop Y z' rs) feq) ;
  } ;
 } ;
} ;
