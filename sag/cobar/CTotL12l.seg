-- CTotL12l.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part l: the step and all the levels.
--   ST.step   level m+1 from the levels up to m: values by al.kop on the
--             Join of the pieces; naturality (the Join restricts to the
--             Join at the restricted index), extension (piece 0), faces
--             (the face piece at a face weight)
--   build     the levels up to any n
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;
module Ar = Arith[a] ;

module L12l (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LK = CTotL12k[a, vl, l].L12k[C, G, A] ;
 module LF = CTotL12f[a, vl, l].L12f[C, G, A] ;
 module LD = CTotL12d[a, vl, l].L12d[C, G, A] ;
 module LA = LK.LA ;
 module TR = LA.TR ;
 module G0 = TR.G0 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LK.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;
 UG : TR.P0.PCtx = LK.UG ;
 UA : TR.P0.PTy[UG] = LK.UA ;
 module RL = LF.RL ;

 module Fl (al : G0.GB.CPartial[l].ContrOp UG UA) (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FF = LF.Ff[al, X, gm, s] ;
  module FK = LK.Fk[X, gm, s] ;
  module FD = LD.Fd[X, gm, s] ;
  module FH = FK.FH ;
  module FG = FK.FG ;
  module F = FK.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  module ST (m : Nat) (p : F.Up m) {
   Sfam (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn (suc m) J) : Py.Side[(J, z), F.gpt (suc m) J u z c i] =
    FK.PC[m, p, J, u, z, c, i].JN.side ;
   module KK = FF.KS[suc m, Sfam] ;
   vN : F.Vt (suc m) = KK.v ;

   -- naturality: the Join restricts to the Join at the restricted index
   module CO' (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn (suc m) J) (J' : Ob) (h : Hom J' J) {
    module P0 = FK.PC[m, p, J, u, z, c, i] ;
    uh : Hom J' I = compH J' J I u h ;
    rzh : Obj J' = C.res J' J h z ;
    c' : F.Ch (suc m) J' uh rzh = DO.rCh J' J I h u x (suc m) z c ;
    i' : Wt.Pn (suc m) J' = Wt.Res[suc m, J', J, h, i].res ;
    module P1' = FK.PC[m, p, J', uh, rzh, c', i'] ;
    Y : Ob0 = (J, z) ;
    Y' : Ob0 = (J', rzh) ;
    hh : TR.RN.Hom0 Y' Y = (h, refl rzh) ;
    r : Nat = suc (suc (suc m)) ;
    sEq : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m)))))
     -> Id (PB.Phi J') (PB.pre J' J h (P0.Sj j hj).pQ) (P1'.Sj j hj).pQ = split {
     zero -> \ hj -> PB.pre-comp J' J I h u s.pQ ;
     suc k -> \ hj -> PB.pre-comp J' J PFO.ivO h (i.1 (k, hj)) (PFO.ptSO PB.e0) } ;
    pco : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) (W : Ob0) (f : TR.RN.Hom0 W Y')
     (L : PB.Lands W.1 J (P0.Sj j hj).pQ (compH W.1 J' J h f.1)) (L' : PB.Lands W.1 J' (P1'.Sj j hj).pQ f.1)
     -> Id (DA.Ez W.1 W.2) ((P0.Sj j hj).pv W (G0.GB.BC.oC W Y' Y hh f) L) ((P1'.Sj j hj).pv W f L') = split {
     zero -> \ hj W f L L' -> FD.Coh[suc m, J, u, z, c, i, J', h].EV[W.1, f.1, L, L'].evg W.2 (symH f.2) (symH (G0.GB.BC.oC W Y' Y hh f).2) ;
     suc k -> \ hj W f L L' -> FK.FCoh[m, p, J, u, z, c, i, k, hj, J', h].EV[W.1, f.1, L, L'].evg W.2 (symH f.2) (symH (G0.GB.BC.oC W Y' Y hh f).2) } ;
    eQ : Id (PB.Phi J') (PB.pre J' J h P0.JN.Q) P1'.JN.Q =
     transH (PB.pre-bigU J' J h r P0.JN.Qs)
      (apH {Ar.Fin r -> PB.Phi J'} {PB.Phi J'} (\ Qf -> PB.bigU J' r Qf)
         (funext (Ar.Fin r) (\ j -> PB.Phi J') (\ j -> PB.pre J' J h (P0.JN.Qs j)) P1'.JN.Qs (\ j -> sEq j.1 j.2))) ;
    module EV (W : Ob0) (f : TR.RN.Hom0 W Y') (lw : PB.Lands W.1 J' (PB.pre J' J h P0.JN.Q) f.1) (lw' : PB.Lands W.1 J' P1'.JN.Q f.1) {
     o : Ar.Fin r = (PB.bigU-out W.1 J' r P1'.JN.Qs f.1 lw').1 ;
     lo : PB.Lands W.1 J' (P1'.JN.Qs o) f.1 = (PB.bigU-out W.1 J' r P1'.JN.Qs f.1 lw').2 ;
     L : PB.Lands W.1 J (P0.JN.Qs o) (compH W.1 J' J h f.1) =
      PB.lands-pre W.1 J' J h (P0.JN.Qs o) f.1
       (subst (PB.Phi J') (\ Q' -> PB.Lands W.1 J' Q' f.1) (P1'.JN.Qs o) (PB.pre J' J h (P0.JN.Qs o)) (symH (sEq o.1 o.2)) lo) ;
     res : Id (DA.Ez W.1 W.2) (P0.JN.side.pv W (G0.GB.BC.oC W Y' Y hh f) (PB.lands-pre W.1 J' J h P0.JN.Q f.1 lw)) (P1'.JN.side.pv W f lw') =
      transH (P0.JN.pv-in o W (G0.GB.BC.oC W Y' Y hh f) L (PB.lands-pre W.1 J' J h P0.JN.Q f.1 lw))
       (transH (pco o.1 o.2 W f L lo) (symH (P1'.JN.pv-in o W f lo lw'))) ;
    } ;
    coh : Id (Py.Side[Y', F.gpt (suc m) J' uh rzh c' i'])
           (subst (W0.Ix (G.ob J' rzh)) (\ q -> Py.Side[Y', q]) (UG.act Y' Y hh (F.gpt (suc m) J u z c i)) (F.gpt (suc m) J' uh rzh c' i')
              (gm.2.1 ((suc m, J, u, z, c, i.1), (J', h)) i.2)
              (Py.rside Y' Y hh (F.gpt (suc m) J u z c i) P0.JN.side))
           P1'.JN.side =
     Py.side-extH Y' (UG.act Y' Y hh (F.gpt (suc m) J u z c i)) (F.gpt (suc m) J' uh rzh c' i') (gm.2.1 ((suc m, J, u, z, c, i.1), (J', h)) i.2)
      (Py.rside Y' Y hh (F.gpt (suc m) J u z c i) P0.JN.side) P1'.JN.side eQ (\ W f lw lw' -> EV[W, f, lw, lw'].res) ;
   } ;
   p1N : F.P1t (suc m) vN = KK.p1 (\ J u z c i J' h -> CO'[J, u, z, c, i, J', h].coh) ;

   -- extension of s: kfull on piece 0
   p2N : F.P2t (suc m) vN =
    KK.p2 (\ W f lf J u' z c' i -> FK.PC[m, p, J, compH J W.1 I f.1 u', z, FF.FE.Ext[W, f, lf, suc m, J, u', z, c', i].cc, i].JN.inS (zero, refl true)
                                     (J, z) (G0.GB.BC.idC (J, z)) (FF.lid W f lf J u' (suc m)))
     (\ W f lf J u' z c' i ->
       transH (FK.PC[m, p, J, compH J W.1 I f.1 u', z, FF.FE.Ext[W, f, lf, suc m, J, u', z, c', i].cc, i].JN.pv-in (zero, refl true)
                 (J, z) (G0.GB.BC.idC (J, z)) (FF.lid W f lf J u' (suc m))
                 (FK.PC[m, p, J, compH J W.1 I f.1 u', z, FF.FE.Ext[W, f, lf, suc m, J, u', z, c', i].cc, i].JN.inS (zero, refl true)
                    (J, z) (G0.GB.BC.idC (J, z)) (FF.lid W f lf J u' (suc m))))
        (FF.ext0 (suc m) W f lf J u' z c' i)) ;

   -- faces: kfull on the face piece k at a face weight
   module FC' (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch (suc m) J u z) (i : Wt.Pn m J) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) {
    Fw : Wt.Pn (suc m) J = Wt.Face[m, J, k, hk].Of[i].face ;
    Y : Ob0 = (J, z) ;
    idY : TR.RN.Hom0 Y Y = G0.GB.BC.idC Y ;
    module P = FK.PC[m, p, J, u, z, c, Fw] ;
    module Fq = FH.FP[m, p, J, u, z, c, Fw, k, hk] ;
    cp : Id (Hom J PFO.ivO) (Fw.1 (k, hk)) (PB.ptH J PB.e0) = Wt.Face[m, J, k, hk].valB-path i.1 k hk true (Tr.eqN-refl k) ;
    lk : PB.Lands J J Fq.Q (PB.idH J) =
     PB.pre-lands J J PFO.ivO (Fw.1 (k, hk)) (PFO.ptSO PB.e0) (PB.idH J)
      (PB.lands-eq J PFO.ivO (PFO.ptSO PB.e0) (PB.ptH J PB.e0) (PB.compH J J PFO.ivO (Fw.1 (k, hk)) (PB.idH J))
         (symH (transH (PB.comp-idr J PFO.ivO (Fw.1 (k, hk))) cp)) (PFO.pt-landsO J PB.e0)) ;
    liN : PB.Lands J J P.JN.Q (PB.idH J) = P.JN.inS (suc k, hk) Y idY lk ;
    e0 : Id (Obj J) (C.res J J (idH J) z) z = symH idY.2 ;
    wpI : Id (Wt.Pn m J) (Fq.pw J (idH J) lk) (Wt.Res[m, J, J, idH J, i].res) =
     Sigma-eq (Wt.Coords m J) (\ cs -> PB.Lands J J (Wt.oneS m J cs) (PB.idH J))
      (Fq.pw J (idH J) lk).1 (Wt.Res[m, J, J, idH J, i].res).1 (Fq.pw J (idH J) lk).2 (Wt.Res[m, J, J, idH J, i].res).2
      (funext (Ar.Fin (suc m)) (\ j -> Hom J PFO.ivO) (Fq.pw J (idH J) lk).1 (Wt.Res[m, J, J, idH J, i].res).1
         (\ j -> apH {Hom J PFO.ivO} {Hom J PFO.ivO} (\ hh -> PB.compH J J PFO.ivO hh (PB.idH J)) (Wt.Face[m, J, k, hk].face-skip i.1 j)))
      (PB.isProp-Lands J J (Wt.oneS m J (Wt.Res[m, J, J, idH J, i].res).1) (PB.idH J)) ;
    ph : DA.Ez J z = FG.Ph[m, p, k].phi J u z c i ;
    res : Id (DA.Ez J z) (F.pzv (suc m) vN J u z c Fw)
            (DA.E.act (J, z) (J, (DO.KJ[J].K.fc m k (C.res J I u x) z c).1) (idH J, (DO.KJ[J].K.fc m k (C.res J I u x) z c).2.2)
               (F.pzv m (F.top m p) J u (DO.KJ[J].K.fc m k (C.res J I u x) z c).1 (DO.KJ[J].K.fc m k (C.res J I u x) z c).2.1 i)) =
     transH (RL.kfull al Y (F.gpt (suc m) J u z c Fw) (Sfam J u z c Fw) liN)
      (transH (P.JN.pv-in (suc k, hk) Y idY lk liN)
        (transH (apH {Wt.Pn m J} {DA.Ez J z} (\ q -> FG.Ph[m, p, k].phi J (compH J J I u (idH J)) z (Fq.chT J (idH J) z e0) q) wpI)
          (transH (symH (FK.PNg m p k J u z c i J (idH J) z e0))
            (transH (apH {TC.THm Y Y} {DA.Ez J z} (\ kk -> DA.E.act Y Y kk ph) (TR.fn.onId Y))
              (DA.E.act-id Y ph))))) ;
   } ;
   p3N : F.P3t m vN (F.top m p) = \ J u z c i k hk -> FC'[J, u, z, c, i, k, hk].res ;

   step : F.Up (suc m) = (vN, p1N, p2N, p, p3N) ;
  } ;

  -- all the levels
  build : (n : Nat) -> F.Up n = split {
   zero -> FF.lev0 ;
   suc m | r -> ST[m, r].step } ;
 } ;
} ;
