-- CTotRFib.seg (canonicity-c2; SIMPLIFIED.md item 5): towards "R of a
-- levelwise fibration is a fibration".
--   rho    the restriction of lines: a line of G at F Y in the total site
--          (a family over all total maps into F Y) restricts to a line of
--          U G at Y in the levelwise site (a family over the levelwise
--          maps).  It is natural, and not an isomorphism: R commutes with
--          the type of lines only up to the currying of the next section.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RFib (C : CIntCat[a, vl].IC) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;

 module Rho (G : P1.PCtx) {
  UG : P0.PCtx = RS.rC G ;
  module F1 = G1.GB.CLine[l].FC[G] ;
  module F0 = G0.GB.CLine[l].FC[UG] ;
  fam (Y : Ob0) (x : W0.Ix (F1.ob (RN.o Y))) (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.IvP Z) : W0.Ix (UG.ob Z) =
   x.1 (RN.o Z) (TR.fn.onH Z Y h) i ;
  nat (Y : Ob0) (x : W0.Ix (F1.ob (RN.o Y))) (Vt W : Ob0) (g : RN.Hom0 Vt W) (f : RN.Hom0 W Y) (i : G0.GB.IvP W)
   : Id (W0.Ix (UG.ob Vt)) (UG.act Vt W g (fam Y x W f i)) (fam Y x Vt (G0.GB.BC.oC Vt W Y f g) (G0.GB.ivA Vt W g i)) =
   transH (x.2 (RN.o Vt) (RN.o W) (TR.fn.onH Vt W g) (TR.fn.onH W Y f) i)
    (apH {RN.Hom1 (RN.o Vt) (RN.o Y)} {W0.Ix (G.ob (RN.o Vt))} (\ k -> x.1 (RN.o Vt) k (G0.GB.ivA Vt W g i)) (symH (TR.fn.onComp Vt W Y f g))) ;
  rhoV (Y : Ob0) (x : W0.Ix (F1.ob (RN.o Y))) : W0.Ix (F0.ob Y) = (fam Y x, nat Y x) ;
  rho : P0.PSub[RS.rC F1.GI, F0.GI] =
   new P0.PSub[RS.rC F1.GI, F0.GI, rhoV,
    \ J I h x -> F0.fam-eq J (rhoV J (F1.actF (RN.o J) (RN.o I) (TR.fn.onH J I h) x)) (F0.actF J I h (rhoV I x))
       (\ W f i -> apH {RN.Hom1 (RN.o W) (RN.o I)} {W0.Ix (G.ob (RN.o W))} (\ k -> x.1 (RN.o W) k i) (symH (TR.fn.onComp W J I h f)))] ;
 } ;

 ----------------------------------------------------------------------
 -- the context of "a line of G with an element at the end e", from the
 -- total site (for R B) to the levelwise site (for B)
 module CT (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (e : G1.GB.IPt) {
  module RT = RN.Ty[G, B] ;
  module RH = Rho[G] ;
  UG : P0.PCtx = RS.rC G ;
  module EK1 = G1.GB.CLine[l].EndKit[G, RT.RB, e] ;
  module EK0 = G0.GB.CLine[l].EndKit[UG, B, e] ;
  -- the end of a line of G at F Y, read through rho and directly
  e1 (Y : Ob0) (x : W0.Ix (RH.F1.ob (RN.o Y))) : W0.Ix (G.ob (RN.o Y)) = (RH.F1.ev e).nt (RN.o Y) x ;
  e0 (Y : Ob0) (x : W0.Ix (RH.F1.ob (RN.o Y))) : W0.Ix (G.ob (RN.o Y)) = (RH.F0.ev e).nt Y (RH.rhoV Y x) ;
  e01 (Y : Ob0) (x : W0.Ix (RH.F1.ob (RN.o Y))) : Id (W0.Ix (G.ob (RN.o Y))) (e0 Y x) (e1 Y x) =
   apH {RN.Hom1 (RN.o Y) (RN.o Y)} {W0.Ix (G.ob (RN.o Y))} (\ k -> x.1 (RN.o Y) k (G1.GB.ptH (RN.o Y) e)) (TR.fn.onId Y) ;
  eqk (Y : Ob0) (x : W0.Ix (RH.F1.ob (RN.o Y))) : Id (W0.Ix (G.ob (RN.o Y))) (e0 Y x) (RT.at (RN.o Y) (e1 Y x) Y (G1.GB.BC.idC (RN.o Y))) =
   transH (e01 Y x) (symH (G.act-id (RN.o Y) (e1 Y x))) ;
  -- kappa on points
  kap (Y : Ob0) (z : EK1.TV.EI (RN.o Y)) : EK0.TV.EI Y =
   EK0.TV.pr Y (RH.rhoV Y (EK1.TV.pr1 (RN.o Y) z))
    ((EK1.TV.pr2 (RN.o Y) z).1 Y (G1.GB.BC.idC (RN.o Y)) (e0 Y (EK1.TV.pr1 (RN.o Y) z)) (eqk Y (EK1.TV.pr1 (RN.o Y) z))) ;

  -- a component of a family, as a total of B; at equal maps and equal points
  Tot0 (Y : Ob0) : U l = P0.SigT UG B Y ;
  tf (X : Ob1) (g : W0.Ix (G.ob X)) (b : RT.Fam X g) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) (p : W0.Ix (G.ob (RN.o Y)))
   (eq : Id (W0.Ix (G.ob (RN.o Y))) p (RT.at X g Y m)) : Tot0 Y = P0.pairE UG B Y p (b Y m p eq) ;
  tfc (X : Ob1) (g : W0.Ix (G.ob X)) (b : RT.Fam X g) (Y : Ob0) (m m' : RN.Hom1 (RN.o Y) X) (pm : Id (RN.Hom1 (RN.o Y) X) m m')
   (p p' : W0.Ix (G.ob (RN.o Y))) (ep : Id (W0.Ix (G.ob (RN.o Y))) p p')
   (eq : Id (W0.Ix (G.ob (RN.o Y))) p (RT.at X g Y m)) (eq' : Id (W0.Ix (G.ob (RN.o Y))) p' (RT.at X g Y m'))
   : Id (Tot0 Y) (tf X g b Y m p eq) (tf X g b Y m' p' eq') =
   idJ (W0.Ix (G.ob (RN.o Y))) p
    (\ p2 ep2 -> (eq2 : Id (W0.Ix (G.ob (RN.o Y))) p2 (RT.at X g Y m')) -> Id (Tot0 Y) (tf X g b Y m p eq) (tf X g b Y m' p2 eq2))
    (\ eq2 -> ap (W0.Ix (B.tob Y p)) (Tot0 Y) (\ v -> P0.pairE UG B Y p v) (b Y m p eq) (b Y m' p eq2) (RT.famCong X g b Y m m' pm p eq eq2))
    p' ep eq' ;

  -- kappa is natural
  module KN (Z Y : Ob0) (h : RN.Hom0 Z Y) (z : EK1.TV.EI (RN.o Y)) {
   x : W0.Ix (RH.F1.ob (RN.o Y)) = EK1.TV.pr1 (RN.o Y) z ;
   w : RT.T (RN.o Y) (e1 Y x) = EK1.TV.pr2 (RN.o Y) z ;
   Fh : RN.Hom1 (RN.o Z) (RN.o Y) = TR.fn.onH Z Y h ;
   x' : W0.Ix (RH.F1.ob (RN.o Z)) = RH.F1.actF (RN.o Z) (RN.o Y) Fh x ;
   lhs : EK0.TV.EI Z = kap Z (EK1.TV.E.act (RN.o Z) (RN.o Y) Fh z) ;
   rhs : EK0.TV.EI Z = EK0.TV.E.act Z Y h (kap Y z) ;
   pl : Id (W0.Ix (RH.F0.ob Z)) (EK0.TV.pr1 Z lhs) (EK0.TV.pr1 Z rhs) = RH.rho.nt-nat Z Y h x ;
   id1Z : RN.Hom1 (RN.o Z) (RN.o Z) = G1.GB.BC.idC (RN.o Z) ;
   id1Y : RN.Hom1 (RN.o Y) (RN.o Y) = G1.GB.BC.idC (RN.o Y) ;
   E0 : Id (W0.Ix (G.ob (RN.o Z))) (G.act (RN.o Z) (RN.o Y) Fh (e1 Y x)) (e1 Z x') =
    P1.ntEq RH.F1.GI G (RH.F1.ev e) (RN.o Z) (RN.o Y) Fh x x' (refl x') ;
   module A = RT.Act[RN.o Z, RN.o Y, Fh, e1 Y x, e1 Z x', E0, w] ;
   mL : RN.Hom1 (RN.o Z) (RN.o Y) = G1.GB.BC.oC (RN.o Z) (RN.o Z) (RN.o Y) Fh id1Z ;
   mR : RN.Hom1 (RN.o Z) (RN.o Y) = G1.GB.BC.oC (RN.o Z) (RN.o Y) (RN.o Y) id1Y Fh ;
   pm : Id (RN.Hom1 (RN.o Z) (RN.o Y)) mL mR =
    transH (G1.GB.BC.oC-idr (RN.o Z) (RN.o Y) Fh) (symH (G1.GB.BC.oC-idl (RN.o Z) (RN.o Y) Fh)) ;
   eL : Id (W0.Ix (G.ob (RN.o Z))) (e0 Z x') (RT.at (RN.o Y) (e1 Y x) Z mL) = transH (eqk Z x') (A.ek Z id1Z) ;
   dl : Id (Tot0 Z) (EK0.endE Z lhs) (tf (RN.o Y) (e1 Y x) w.1 Z mL (e0 Z x') eL) = refl (EK0.endE Z lhs) ;
   q0 : W0.Ix (G.ob (RN.o Z)) = UG.act Z Y h (e0 Y x) ;
   ep : Id (W0.Ix (G.ob (RN.o Z))) (e0 Z x') q0 =
    transH (apH {W0.Ix (RH.F0.ob Z)} {W0.Ix (G.ob (RN.o Z))} (\ y -> (RH.F0.ev e).nt Z y) pl)
     ((RH.F0.ev e).nt-nat Z Y h (RH.rhoV Y x)) ;
   eR : Id (W0.Ix (G.ob (RN.o Z))) q0 (RT.at (RN.o Y) (e1 Y x) Z mR) =
    transH (apH {W0.Ix (G.ob (RN.o Y))} {W0.Ix (G.ob (RN.o Z))} (\ v -> G.act (RN.o Z) (RN.o Y) Fh v) (e01 Y x))
     (apH {RN.Hom1 (RN.o Z) (RN.o Y)} {W0.Ix (G.ob (RN.o Z))} (\ k -> G.act (RN.o Z) (RN.o Y) k (e1 Y x)) (symH (G1.GB.BC.oC-idl (RN.o Z) (RN.o Y) Fh))) ;
   -- the end of the restricted point, by the naturality of the family
   dr : Id (Tot0 Z) (P0.actE UG B Z Y h (EK0.endE Y (kap Y z))) (tf (RN.o Y) (e1 Y x) w.1 Z mR q0 eR) =
    ap (W0.Ix (B.tob Z q0)) (Tot0 Z) (\ v -> P0.pairE UG B Z q0 v)
     (B.tact Z Y h (e0 Y x) q0 (refl q0) (w.1 Y id1Y (e0 Y x) (eqk Y x)))
     (w.1 Z mR q0 eR)
     (w.2 Z Y h id1Y (e0 Y x) (eqk Y x) q0 eR (refl q0)) ;
   ql : Id (Tot0 Z) (EK0.endE Z lhs) (EK0.endE Z rhs) =
    trans (Tot0 Z) (EK0.endE Z lhs) (tf (RN.o Y) (e1 Y x) w.1 Z mR q0 eR) (EK0.endE Z rhs)
     (trans (Tot0 Z) (EK0.endE Z lhs) (tf (RN.o Y) (e1 Y x) w.1 Z mL (e0 Z x') eL) (tf (RN.o Y) (e1 Y x) w.1 Z mR q0 eR)
        dl (tfc (RN.o Y) (e1 Y x) w.1 Z mL mR pm (e0 Z x') q0 ep eL eR))
     (trans (Tot0 Z) (tf (RN.o Y) (e1 Y x) w.1 Z mR q0 eR) (P0.actE UG B Z Y h (EK0.endE Y (kap Y z))) (EK0.endE Z rhs)
        (sym (Tot0 Z) (P0.actE UG B Z Y h (EK0.endE Y (kap Y z))) (tf (RN.o Y) (e1 Y x) w.1 Z mR q0 eR) dr)
        (sym (Tot0 Z) (EK0.endE Z rhs) (P0.actE UG B Z Y h (EK0.endE Y (kap Y z))) (EK0.endE-act Z Y h (kap Y z)))) ;
   nat : Id (EK0.TV.EI Z) lhs rhs = EK0.tv-eq Z lhs rhs pl ql ;
  } ;
  -- kappa as a map of contexts, from U of the total-site context
  kappa : P0.PSub[RS.rC EK1.TV.E, EK0.TV.E] =
   new P0.PSub[RS.rC EK1.TV.E, EK0.TV.E, kap, \ J I h z -> KN[J, I, h, z].nat] ;
 } ;
} ;
