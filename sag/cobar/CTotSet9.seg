-- CTotSet9.seg (canonicity-c2; "D preserves h-sets", part 9): the map
-- f : R(y) -> Id_{D A}(x , y) over D G . D A . D A: at (k , rv) the path
-- (W , f , j) |-> CTotSet7's element at (k f , rv f , j), with the empty
-- sieve; its naturality and ends by CTotSet8.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST9 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module S8 = CTotSet8[a, vl, l].ST8[C, G, A] ;
 module S5 = CTotSet5[a, vl, l].ST5[C, G, A] ;
 module S7 = S8.S7 ;
 module S1 = S8.S1 ;
 module G1 = S1.G1 ;
 module P1 = S1.P1 ;
 module TC = S1.TC ;
 module DI = S8.DI ;
 module DAm = S8.DAm ;
 module JP = CwFJ.JPt[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T] ;
 K : P1.PCtx = S5.K ;
 IK : G1.fibCwF-T.Ty S5.K = JP.IK S5.Ext S5.SFT S5.xq ;
 module Yk = G1.FT.GPosIdY[l].IdY[S5.K, (JP.DJ.Ap S5.Ext S5.SFT).1, JP.DJ.ap' S5.Ext S5.SFT S5.xq, G1.fibCwF-T.q S5.Ext S5.SFT] ;
 t0 : Id (P1.PTy[S5.K]) IK.1 Yk.IdYT = refl IK.1 ;
 RT (pS : G1.fibCwF-T.El S1.E1 (S1.PN1.isProp S1.E1 S1.IdA)) : P1.PTy[S5.K] = S5.At[pS].R.1 ;
 module At (pS : G1.fibCwF-T.El S1.E1 (S1.PN1.isProp S1.E1 S1.IdA)) {
  DGp : P1.PCtx = CTotDProp3[a, vl, l].DP3[C, S1.GAA, S1.IdA].DG ;
  module PSg = G1.FT.PB.GPre[l].PS ;
  R : P1.PTy[S5.K] = PSg.subTy S5.K DGp DI.DTy S1.phi2 ;
  KR : P1.PCtx = PSg.extP S5.K R ;
  kW (X : TC.TOb) (k : W0.Ix (S5.K.ob X)) (W : TC.TOb) (f : TC.THm W X) : W0.Ix (S5.K.ob W) = Yk.pt X k W f ;
  rW (X : TC.TOb) (kp : W0.Ix (KR.ob X)) (W : TC.TOb) (f : TC.THm W X) : W0.Ix (R.tob W (kW X kp.1 W f)) =
   R.tact W X f kp.1 (kW X kp.1 W f) (refl (kW X kp.1 W f)) kp.2 ;
  u (X : TC.TOb) (kp : W0.Ix (KR.ob X)) (W : TC.TOb) (f : TC.THm W X) (j : G1.GB.IvP W) : DAm.TOb' W.1 W.2 (kW X kp.1 W f).1.1 =
   S7.VE[W.1, W.2, kW X kp.1 W f, rW X kp W f, j].res ;
  egp (V W : TC.TOb) (g : TC.THm V W) (k1 : W0.Ix (S5.K.ob W)) (k2 : W0.Ix (S5.K.ob V)) (e : Id (W0.Ix (S5.K.ob V)) (S5.K.act V W g k1) k2)
    : Id (DAm.D.Ob' V.1 V.2) (DAm.D.act V.1 W.1 g.1 V.2 W.2 g.2 k1.1.1) k2.1.1 =
   P1.ntEq S5.Ext S5.DG (P1.pP S5.DG S5.DAT.1) V W g k1.1 k2.1 (P1.ntEq S5.K S5.Ext (P1.pP S5.Ext S5.SFT.1) V W g k1 k2 e) ;
  module UN (X : TC.TOb) (kp : W0.Ix (KR.ob X)) (Vb W : TC.TOb) (g : TC.THm Vb W) (f : TC.THm W X) (j : G1.GB.IvP W) {
   k1 : W0.Ix (S5.K.ob W) = kW X kp.1 W f ;
   k2 : W0.Ix (S5.K.ob Vb) = kW X kp.1 Vb (G1.GB.BC.oC Vb W X f g) ;
   ek : Id (W0.Ix (S5.K.ob Vb)) (S5.K.act Vb W g k1) k2 = Yk.ptn X kp.1 Vb W g f ;
   ephi : Id (DI.D.Ob' Vb.1 Vb.2) (DI.D.act Vb.1 W.1 g.1 Vb.2 W.2 g.2 (S1.phi2.nt W k1)) (S1.phi2.nt Vb k2) =
    PSg.ntEq S5.K DGp S1.phi2 Vb W g k1 k2 ek ;
   rv1 : DI.TOb' W.1 W.2 (S1.phi2.nt W k1) = rW X kp W f ;
   eg' : Id (DAm.D.Ob' Vb.1 Vb.2) (DAm.D.act Vb.1 W.1 g.1 Vb.2 W.2 g.2 k1.1.1) k2.1.1 = egp Vb W g k1 k2 ek ;
   module N = S8.VN[Vb.1, W.1, g.1, Vb.2, W.2, g.2, k1, k2, rv1, ephi, j, eg'] ;
   r2 : W0.Ix (R.tob Vb k2) = R.tact Vb W g k1 k2 ek (rW X kp W f) ;
   n2 : Id (W0.Ix (R.tob Vb k2)) r2 (rW X kp Vb (G1.GB.BC.oC Vb W X f g)) =
    symH (R.tact-o Vb W X f g kp.1 k1 k2 (refl k1) ek (refl k2) kp.2) ;
   n0 : Id (W0.Ix (R.tob Vb k2)) N.RB.res r2 = refl r2 ;
   law : Id (DAm.TOb' Vb.1 Vb.2 k2.1.1)
          ((JP.DJ.Ap S5.Ext S5.SFT).1.tact Vb W g k1 k2 ek (u X kp W f j))
          (u X kp Vb (G1.GB.BC.oC Vb W X f g) (G1.GB.ivA Vb W g j)) =
    transH N.law
     (apH {W0.Ix (R.tob Vb k2)} {DAm.TOb' Vb.1 Vb.2 k2.1.1} (\ r -> S7.VE[Vb.1, Vb.2, k2, r, G1.GB.ivA Vb W g j].res) n2) ;
  } ;
 } ;
} ;
