-- CPshFvC2.seg (canonicity-c2; COBAR.md, the S3 bridge, part (III), P2,
-- second file; split from CPshFvC for the 10 s cap): the interface's
-- fibre FVr is the fibre FVc of CPshFibC, as C-types over G.X (fvEq).
-- FVr is Sigma Yd Id(e1 , e2) by the generic CwFFv.E.fvDef; e1 is the
-- end a0C by CPshFvC's e1eq; the rest is unfolding, done in named steps
-- written with the names of CwFFv.E (the names of CPshFibC enter once,
-- in idK and fv1: comparing the two vocabularies is slow).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;

module FvC2Of (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module IDm = CPshId[a, l].IdOf[C] ;
 module SGm = CPshSig[a, l].SigOf[C] ;
 module FvM = CPshFvC[a, l].FvCOf[C] ;
 open P ;

 module Fv (G : CCtx) (X Y : UF.FCC.STy G) (r : FvM.CF.El G (FvM.OV.Fun G Y X)) {
  module F1 = FvM.Fv[G, X, Y, r] ;

  -- FVr and FVc
  idE : Id (CTy[F1.FE.K']) (IDm.IdC[F1.FE.K', F1.FE.B1.1, F1.FE.e1, F1.FE.e2].IdT) (IDm.IdC[F1.FE.K', F1.FE.B1.1, F1.a0E, F1.FE.e2].IdT) =
   apH (\ e -> IDm.IdC[F1.FE.K', F1.FE.B1.1, e, F1.FE.e2].IdT) F1.e1eq ;
  idK : Id (CTy[F1.FE.K']) (IDm.IdC[F1.FE.K', F1.FE.B1.1, F1.a0E, F1.FE.e2].IdT) F1.Fb.IdK.IdT = refl F1.Fb.IdK.IdT ;
  idR : Id (CTy[F1.Fb.Kc]) F1.Fb.IdK.IdT F1.Fb.IdR = refl F1.Fb.IdR ;
  mkS (I : CTy[F1.FE.K']) : CTy[F1.FE.D] = SGm.SG[F1.FE.D, F1.FE.Yd.1, I].SigC ;
  fv0 : Id (CTy[F1.FE.D]) F1.FE.FVd.1 (mkS (IDm.IdC[F1.FE.K', F1.FE.B1.1, F1.FE.e1, F1.FE.e2].IdT)) = refl F1.FE.FVd.1 ;
  fv1 : Id (CTy[F1.FE.D]) (mkS F1.Fb.IdR) F1.Fb.FVc = refl F1.Fb.FVc ;
  s1 : Id (CTy[F1.FE.K']) (IDm.IdC[F1.FE.K', F1.FE.B1.1, F1.FE.e1, F1.FE.e2].IdT) F1.Fb.IdR = transH idE (transH idK idR) ;
  s2 : Id (CTy[F1.FE.D]) (mkS (IDm.IdC[F1.FE.K', F1.FE.B1.1, F1.FE.e1, F1.FE.e2].IdT)) (mkS F1.Fb.IdR) = apH mkS s1 ;
  s3 : Id (CTy[F1.FE.D]) F1.FE.FVd.1 F1.Fb.FVc = transH fv0 (transH s2 fv1) ;
  -- FVr is FVd by the generic fvDef (not by unfolding at this instance)
  s4 : Id (CTy[F1.FE.D]) (FvM.QP.FVr G X Y r).1 F1.FE.FVd.1 = apH {UF.FCC.STy F1.FE.D} {CTy[F1.FE.D]} (\ Z -> Z.1) F1.FE.fvDef ;
  fvEq : Id (CTy[F1.FE.D]) (FvM.QP.FVr G X Y r).1 F1.Fb.FVc = transH s4 s3 ;
 } ;
} ;
