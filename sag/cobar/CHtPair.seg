-- CHtPair.seg (canonicity-45; COBAR.md "Prop 58"): two path homotopies
-- f1 ~ g1 : X -> A and f2 ~ g2 : X -> B over G pair to a path homotopy
-- (f1, f2) ~ (g1, g2) : X -> A x B (the Sigma of A and B weakened): values
-- the pairs of the two paths coerced to the common point, equalities by
-- the two projections, injective over a fixed point.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module FCP = FibCwF[a, a+] ;
module OVp = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;

module HP (G : L.PCtx) (X : L.PTy[G]) (A B : FCP.fibCwF.Ty G) (f1 g1 : PB.CHtpyOps[a+].NMap[G, X, A.1]) (f2 g2 : PB.CHtpyOps[a+].NMap[G, X, B.1])
  (H1 : L.PEl[L.extP G X, PB.CHtpyOps[a+].HT[G, X, A.1, f1, g1].PT.PathP])
  (H2 : L.PEl[L.extP G X, PB.CHtpyOps[a+].HT[G, X, B.1, f2, g2].PT.PathP]) {
 module HO = PB.CHtpyOps[a+] ;
 C : CwF.CwF[a++] = FCP.fibCwF ;
 Bw : C.Ty (C.ext G A) = OVp.wkT G A B ;
 S : C.Ty G = FCP.fibSig.Sig G A Bw ;
 module TA = PB.GPre[a+].TyL[G, A.1] ;
 module TB = PB.GPre[a+].TyL[G, B.1] ;
 module TS = PB.GPre[a+].TyL[G, S.1] ;
 pairN (u1 : HO.NMap[G, X, A.1]) (u2 : HO.NMap[G, X, B.1]) : HO.NMap[G, X, S.1] = new HO.NMap[G, X, S.1, \ I x v -> (u1.nfun I x v, u2.nfun I x v),
  \ J I h x x' e v -> transH (apH {V1.Ix (A.1.tob J x')} {V1.Ix (S.1.tob J x')} (\ a1 -> (a1, B.1.tact J I h x x' (L.ntEq (C.ext G A) G (C.p G A) J I h (x, u1.nfun I x v) (x', A.1.tact J I h x x' e (u1.nfun I x v)) (L.pair-act G A.1 J I h x x' e (u1.nfun I x v))) (u2.nfun I x v))) (u1.nnat J I h x x' e v))
     (apH {V1.Ix (B.1.tob J x')} {V1.Ix (S.1.tob J x')} (\ b1 -> (u1.nfun J x' (X.tact J I h x x' e v), b1))
       (transH (L.tact-irr G B.1 J I h x x' (L.ntEq (C.ext G A) G (C.p G A) J I h (x, u1.nfun I x v) (x', A.1.tact J I h x x' e (u1.nfun I x v)) (L.pair-act G A.1 J I h x x' e (u1.nfun I x v))) e (u2.nfun I x v))
          (u2.nnat J I h x x' e v)))] ;
 module T1 = HO.HT[G, X, A.1, f1, g1] ;
 module T2 = HO.HT[G, X, B.1, f2, g2] ;
 module T = HO.HT[G, X, S.1, pairN f1 f2, pairN g1 g2] ;
 M1 (V : Ob) (q : TS.EI V) : TA.EI V = TA.pr V q.1 q.2.1 ;
 M2 (V : Ob) (q : TS.EI V) : TB.EI V = TB.pr V q.1 q.2.2 ;
 Minj (V : Ob) (q q' : TS.EI V) (P : Id (V1.Ix (G.ob V)) q.1 q'.1) (Q1 : Id (TA.EI V) (M1 V q) (M1 V q')) (Q2 : Id (TB.EI V) (M2 V q) (M2 V q')) : Id (TS.EI V) q q' =
  idJ (V1.Ix (G.ob V)) q.1 (\ d2 P2 -> (v2 : V1.Ix (S.1.tob V d2)) -> Id (TA.EI V) (M1 V q) (TA.pr V d2 v2.1) -> Id (TB.EI V) (M2 V q) (TB.pr V d2 v2.2) -> Id (TS.EI V) q (d2, v2))
   (\ v2 R1 R2 -> transH (apH {V1.Ix (A.1.tob V q.1)} {TS.EI V} (\ a3 -> (q.1, (a3, q.2.2))) (TA.pr-inj V q.1 q.2.1 v2.1 R1))
       (apH {V1.Ix (B.1.tob V q.1)} {TS.EI V} (\ b3 -> (q.1, (v2.1, b3))) (TB.pr-inj V q.1 q.2.2 v2.2 R2))) q'.1 P q'.2 Q1 Q2 ;
 M1act (V' V : Ob) (g0 : Hom V' V) (q : TS.EI V) : Id (TA.EI V') (M1 V' (TS.E.act V' V g0 q)) (TA.E.act V' V g0 (M1 V q)) =
  symH (TA.pr-tact V' V g0 q.1 (G.act V' V g0 q.1) (refl (G.act V' V g0 q.1)) q.2.1) ;
 M2act (V' V : Ob) (g0 : Hom V' V) (q : TS.EI V) : Id (TB.EI V') (M2 V' (TS.E.act V' V g0 q)) (TB.E.act V' V g0 (M2 V q)) =
  transH (apH {V1.Ix (B.1.tob V' (G.act V' V g0 q.1))} {TB.EI V'} (TB.pr V' (G.act V' V g0 q.1))
     (L.tact-irr G B.1 V' V g0 q.1 (G.act V' V g0 q.1) (L.ntEq (C.ext G A) G (C.p G A) V' V g0 (q.1, q.2.1) (G.act V' V g0 q.1, A.1.tact V' V g0 q.1 (G.act V' V g0 q.1) (refl (G.act V' V g0 q.1)) q.2.1)
         (L.pair-act G A.1 V' V g0 q.1 (G.act V' V g0 q.1) (refl (G.act V' V g0 q.1)) q.2.1)) (refl (G.act V' V g0 q.1)) q.2.2))
   (symH (TB.pr-tact V' V g0 q.1 (G.act V' V g0 q.1) (refl (G.act V' V g0 q.1)) q.2.2)) ;
 -- the values
 p1 (W : Ob) (z : V1.Ix (T.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : TA.EI V = T1.pv H1 W z V k j ;
 p2 (W : Ob) (z : V1.Ix (T.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : TB.EI V = T2.pv H2 W z V k j ;
 tv (W : Ob) (z : V1.Ix (T.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : TS.EI V =
  (G.act V W k z.1,
   (TA.coeT V (TA.pr1 V (p1 W z V k j)) (G.act V W k z.1) ((H1.eob W z).2.1 V k j) (TA.pr2 V (p1 W z V k j)),
    TB.coeT V (TB.pr1 V (p2 W z V k j)) (G.act V W k z.1) ((H2.eob W z).2.1 V k j) (TB.pr2 V (p2 W z V k j)))) ;
 M1tv (W : Ob) (z : V1.Ix (T.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : Id (TA.EI V) (M1 V (tv W z V k j)) (p1 W z V k j) =
  symH (TA.pr-coe V (TA.pr1 V (p1 W z V k j)) (G.act V W k z.1) ((H1.eob W z).2.1 V k j) (TA.pr2 V (p1 W z V k j))) ;
 M2tv (W : Ob) (z : V1.Ix (T.GA.ob W)) (V : Ob) (k : Hom V W) (j : Hom V Iv) : Id (TB.EI V) (M2 V (tv W z V k j)) (p2 W z V k j) =
  symH (TB.pr-coe V (TB.pr1 V (p2 W z V k j)) (G.act V W k z.1) ((H2.eob W z).2.1 V k j) (TB.pr2 V (p2 W z V k j))) ;
 path (W : Ob) (z : V1.Ix (T.GA.ob W)) : V1.Ix (T.PT.tobP W z) =
  T.PT.mkPath W z (tv W z)
   (\ V' V g0 k j -> Minj V' (TS.E.act V' V g0 (tv W z V k j)) (tv W z V' (compH V' V W k g0) (compH V' V Iv j g0)) (symH (G.act-o V' V W k g0 z.1))
      (transH (M1act V' V g0 (tv W z V k j)) (transH (apH {TA.EI V} {TA.EI V'} (TA.E.act V' V g0) (M1tv W z V k j))
        (transH ((H1.eob W z).1.2 V' V g0 k j) (symH (M1tv W z V' (compH V' V W k g0) (compH V' V Iv j g0))))))
      (transH (M2act V' V g0 (tv W z V k j)) (transH (apH {TB.EI V} {TB.EI V'} (TB.E.act V' V g0) (M2tv W z V k j))
        (transH ((H2.eob W z).1.2 V' V g0 k j) (symH (M2tv W z V' (compH V' V W k g0) (compH V' V Iv j g0)))))))
   (\ V k j -> refl (G.act V W k z.1))
   (Minj W (tv W z W (idH W) (PB.ptH W PB.e0)) (T.aE W z) (G.act-id W z.1)
     (transH (M1tv W z W (idH W) (PB.ptH W PB.e0)) (H1.eob W z).2.2.1) (transH (M2tv W z W (idH W) (PB.ptH W PB.e0)) (H2.eob W z).2.2.1))
   (Minj W (tv W z W (idH W) (PB.ptH W PB.e1)) (T.bE W z) (G.act-id W z.1)
     (transH (M1tv W z W (idH W) (PB.ptH W PB.e1)) (H1.eob W z).2.2.2) (transH (M2tv W z W (idH W) (PB.ptH W PB.e1)) (H2.eob W z).2.2.2)) ;
 enat (J I : Ob) (h : Hom J I) (z : V1.Ix (T.GA.ob I)) (z' : V1.Ix (T.GA.ob J)) (ee : Id (V1.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
  : Id (V1.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z') =
  T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' ee (path I z)) (path J z') (\ V f i ->
   Minj V (tv I z V (compH V J I h f) i) (tv J z' V f i)
    (transH (G.act-o V J I h f z.1) (apH {V1.Ix (G.ob J)} {V1.Ix (G.ob V)} (G.act V J f) (apH {V1.Ix (T.GA.ob J)} {V1.Ix (G.ob J)} (\ w -> w.1) ee)))
    (transH (M1tv I z V (compH V J I h f) i) (transH (T1.pv-res H1 J I h z z' ee V f i) (symH (M1tv J z' V f i))))
    (transH (M2tv I z V (compH V J I h f) i) (transH (T2.pv-res H2 J I h z z' ee V f i) (symH (M2tv J z' V f i))))) ;
 res : L.PEl[T.GA, T.PT.PathP] = new L.PEl[T.GA, T.PT.PathP, path, enat] ;
} ;
