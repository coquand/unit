-- CCmpU12.seg (canonicity-c2; (K) for cmpI, part 12): Ev_1 applied to both
-- sides of the Id component, over nil.H (apM), and its readings.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module U12 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation)
  (c : C.El C.nil CPreI[a].PreOf[R, encK, pe].CmpI[y].Q1.FM.P.H.AS.Qt) {
 module U11m = CCmpU11[a].U11[R, encK, pe, y, c] ;
 module U10m = U11m.U10m ;
 module L = PosFull[a].PB.GPre[a+].PS ;
 module HO = PosFull[a].PB.CHtpyOps[a+] ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = U11m.GH ;
 HTh : C.Ty GH = U11m.HTh ;
 QYh : C.Ty GH = U11m.QYh ;
 n1h : HO.NMap[GH, HTh.1, QYh.1] =
  new HO.NMap[GH, HTh.1, QYh.1, \ K w v -> U10m.n1.nfun K w.1 v,
   \ J I f w w' e v -> U10m.n1.nnat J I f w.1 w'.1 (L.ntEq GH Nl (L.pP Nl U11m.H.1) J I f w w' e) v] ;
 module B1 = CCmpU5[a].AF[GH, HTh, HTh, QYh, n1h, C.q GH HTh] ;
 ev1 : C.El GH (IJ.IdT GH QYh (PT.atv GH HTh QYh B1.t U11m.x1) (PT.atv GH HTh QYh B1.t U11m.x2)) =
  PT.apM GH HTh QYh B1.t U11m.x1 U11m.x2 U11m.eX ;
 -- reading of atv B1.t x
 rdA (x : C.El GH HTh) (K : Ob) (w : V1.Ix (GH.ob K))
   : Id (V1.Ix (QYh.1.tob K w)) ((PT.atv GH HTh QYh B1.t x).eob K w) (U10m.n1.nfun K w.1 (x.eob K w)) =
  transH (CAppRd[a].trE-rd GH (C.subT GH (C.ext GH HTh) (OV.wkT GH HTh QYh) (C.sec GH HTh x)) QYh
            (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH HTh QYh x)
            (C.subt GH (C.ext GH HTh) (OV.wkT GH HTh QYh) B1.t (C.sec GH HTh x)) K w)
   (transH (CAppRd[a].same-rd GH (C.subT GH (C.ext GH HTh) (OV.wkT GH HTh QYh) (C.sec GH HTh x)) QYh
              (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH HTh QYh x) K w (refl (QYh.1.tob K w)) (B1.t.eob K (w, x.eob K w)))
      (B1.rd K (w, x.eob K w))) ;
 n2h : HO.NMap[GH, HTh.1, QYh.1] =
  new HO.NMap[GH, HTh.1, QYh.1, \ K w v -> U10m.n2.nfun K w.1 v,
   \ J I f w w' e v -> U10m.n2.nnat J I f w.1 w'.1 (L.ntEq GH Nl (L.pP Nl U11m.H.1) J I f w w' e) v] ;
 module B2 = CCmpU5[a].AF[GH, HTh, HTh, QYh, n2h, C.q GH HTh] ;
 ev2 : C.El GH (IJ.IdT GH QYh (PT.atv GH HTh QYh B2.t U11m.x1) (PT.atv GH HTh QYh B2.t U11m.x2)) =
  PT.apM GH HTh QYh B2.t U11m.x1 U11m.x2 U11m.eX ;
 -- reading of atv B2.t x
 rdA2 (x : C.El GH HTh) (K : Ob) (w : V1.Ix (GH.ob K))
   : Id (V1.Ix (QYh.1.tob K w)) ((PT.atv GH HTh QYh B2.t x).eob K w) (U10m.n2.nfun K w.1 (x.eob K w)) =
  transH (CAppRd[a].trE-rd GH (C.subT GH (C.ext GH HTh) (OV.wkT GH HTh QYh) (C.sec GH HTh x)) QYh
            (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH HTh QYh x)
            (C.subt GH (C.ext GH HTh) (OV.wkT GH HTh QYh) B2.t (C.sec GH HTh x)) K w)
   (transH (CAppRd[a].same-rd GH (C.subT GH (C.ext GH HTh) (OV.wkT GH HTh QYh) (C.sec GH HTh x)) QYh
              (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst GH HTh QYh x) K w (refl (QYh.1.tob K w)) (B2.t.eob K (w, x.eob K w)))
      (B2.rd K (w, x.eob K w))) ;
} ;
