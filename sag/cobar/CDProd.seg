-- CDProd.seg (canonicity-45; SIMPLIFIED.md step 6): D preserves binary
-- products of contexts at the total site, as an isomorphism of contexts:
--   prodT G H         the product context (fibres pairs, acting pairwise)
--   toP / fromP       D(G x H) <-> D G x D H (families by projection and
--                     pairing; the equations componentwise)
--   to-from / from-to inverse both ways (ob-eq: equal readings)
--   toS / fromS       the two maps as substitutions (natural on the nose
--                     in the readings)
--   deltaN, ND        the constant context N and N_D := D(Delta N)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module ProdOf (C : CIntCat[a, vl].IC) {
 module TP = CTPsh[a, vl, l].TPshOf[C] ;
 module VT = TP.VT ;
 module DO = CobarI[a, vl, l].DOfI[C] ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 pairE2 (A B : U l) (a a' : A) (b b' : B) (e1 : Id A a a') (e2 : Id B b b') : Id (A * B) (a, b) (a', b') =
  transH (apH {A} {A * B} (\ z -> (z, b)) e1) (apH {B} {A * B} (\ z -> (a', z)) e2) ;

 prodT (G H : TP.TCtx) : TP.TCtx =
  new TP.TCtx[\ I x -> W0.SigV (G.ob I x) (\ p -> H.ob I x),
   \ J I u y x f p -> (G.act J I u y x f p.1, H.act J I u y x f p.2),
   \ I x p -> pairE2 (W0.Ix (G.ob I x)) (W0.Ix (H.ob I x)) (G.act I I (idH I) x x (C.idD I x) p.1) p.1 (H.act I I (idH I) x x (C.idD I x) p.2) p.2 (G.act-id I x p.1) (H.act-id I x p.2),
   \ K J I u v z y x f f' p -> pairE2 (W0.Ix (G.ob K z)) (W0.Ix (H.ob K z)) _ _ _ _ (G.act-o K J I u v z y x f f' p.1) (H.act-o K J I u v z y x f f' p.2)] ;

 module PD (G H : TP.TCtx) {
  module DGH = DO.DC[prodT G H] ;
  module DG = DO.DC[G] ;
  module DH = DO.DC[H] ;
  GH : TP.TCtx = prodT G H ;
  toG (I : Ob) (x : Obj I) (w : DGH.Ob' I x) : DG.Ob' I x =
   (\ q l -> (w.1 q l).1,
    (\ r l -> apH {W0.Ix (GH.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} {W0.Ix (G.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} (\ p -> p.1) (w.2.1 r l),
     (\ r l -> apH {W0.Ix (GH.ob r.2.2.2.1 r.2.2.2.2.2.1)} {W0.Ix (G.ob r.2.2.2.1 r.2.2.2.2.2.1)} (\ p -> p.1) (w.2.2.1 r l),
      \ r l -> apH {W0.Ix (GH.ob r.2.1 r.2.2.2.1)} {W0.Ix (G.ob r.2.1 r.2.2.2.1)} (\ p -> p.1) (w.2.2.2 r l)))) ;
  toH (I : Ob) (x : Obj I) (w : DGH.Ob' I x) : DH.Ob' I x =
   (\ q l -> (w.1 q l).2,
    (\ r l -> apH {W0.Ix (GH.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} {W0.Ix (H.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} (\ p -> p.2) (w.2.1 r l),
     (\ r l -> apH {W0.Ix (GH.ob r.2.2.2.1 r.2.2.2.2.2.1)} {W0.Ix (H.ob r.2.2.2.1 r.2.2.2.2.2.1)} (\ p -> p.2) (w.2.2.1 r l),
      \ r l -> apH {W0.Ix (GH.ob r.2.1 r.2.2.2.1)} {W0.Ix (H.ob r.2.1 r.2.2.2.1)} (\ p -> p.2) (w.2.2.2 r l)))) ;
  fromP (I : Ob) (x : Obj I) (w1 : DG.Ob' I x) (w2 : DH.Ob' I x) : DGH.Ob' I x =
   (\ q l -> (w1.1 q l, w2.1 q l),
    (\ r l -> pairE2 (W0.Ix (G.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))) (W0.Ix (H.ob r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))) _ _ _ _ (w1.2.1 r l) (w2.2.1 r l),
     (\ r l -> pairE2 (W0.Ix (G.ob r.2.2.2.1 r.2.2.2.2.2.1)) (W0.Ix (H.ob r.2.2.2.1 r.2.2.2.2.2.1)) _ _ _ _ (w1.2.2.1 r l) (w2.2.2.1 r l),
      \ r l -> pairE2 (W0.Ix (G.ob r.2.1 r.2.2.2.1)) (W0.Ix (H.ob r.2.1 r.2.2.2.1)) _ _ _ _ (w1.2.2.2 r l) (w2.2.2.2 r l)))) ;
  -- inverse both ways
  to-fromG (I : Ob) (x : Obj I) (w1 : DG.Ob' I x) (w2 : DH.Ob' I x) : Id (DG.Ob' I x) (toG I x (fromP I x w1 w2)) w1 =
   DG.ob-eq I x (toG I x (fromP I x w1 w2)) w1 (\ q l -> refl (w1.1 q l)) ;
  to-fromH (I : Ob) (x : Obj I) (w1 : DG.Ob' I x) (w2 : DH.Ob' I x) : Id (DH.Ob' I x) (toH I x (fromP I x w1 w2)) w2 =
   DH.ob-eq I x (toH I x (fromP I x w1 w2)) w2 (\ q l -> refl (w2.1 q l)) ;
  from-to (I : Ob) (x : Obj I) (w : DGH.Ob' I x) : Id (DGH.Ob' I x) (fromP I x (toG I x w) (toH I x w)) w =
   DGH.ob-eq I x (fromP I x (toG I x w) (toH I x w)) w (\ q l -> refl (w.1 q l)) ;
  -- as maps of contexts
  toS : TP.TSub[DGH.DCtx, prodT DG.DCtx DH.DCtx] =
   new TP.TSub[DGH.DCtx, prodT DG.DCtx DH.DCtx, \ I x w -> (toG I x w, toH I x w),
    \ J I u y x f w -> pairE2 (DG.Ob' J y) (DH.Ob' J y) _ _ _ _
       (DG.ob-eq J y (toG J y (DGH.act J I u y x f w)) (DG.act J I u y x f (toG I x w)) (\ q l -> refl ((DGH.act J I u y x f w).1 q l).1))
       (DH.ob-eq J y (toH J y (DGH.act J I u y x f w)) (DH.act J I u y x f (toH I x w)) (\ q l -> refl ((DGH.act J I u y x f w).1 q l).2))] ;
  fromS : TP.TSub[prodT DG.DCtx DH.DCtx, DGH.DCtx] =
   new TP.TSub[prodT DG.DCtx DH.DCtx, DGH.DCtx, \ I x p -> fromP I x p.1 p.2,
    \ J I u y x f p -> DGH.ob-eq J y (fromP J y (DG.act J I u y x f p.1) (DH.act J I u y x f p.2)) (DGH.act J I u y x f (fromP I x p.1 p.2))
       (\ q l -> refl ((DGH.act J I u y x f (fromP I x p.1 p.2)).1 q l))] ;
 } ;
 -- the constant context of natural numbers and N_D := D(Delta N)
 deltaN : TP.TCtx = new TP.TCtx[\ I x -> W0.natV, \ J I u y x f n -> n, \ I x n -> refl n, \ K J I u v z y x f f' n -> refl n] ;
 module DN = DO.DC[deltaN] ;
 ND : TP.TCtx = DN.DCtx ;
} ;
