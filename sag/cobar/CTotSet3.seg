-- CTotSet3.seg (canonicity-c2; "D preserves h-sets", part 3): the
-- reflexivity of Id_A at diagonal points ((g , a) , a) of G.A.A, as an
-- element of the Yoneda Id (constant path, total sieve), natural in the
-- point (g , a) of G.A.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST3 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module S1 = CTotSet1[a, vl, l].ST1[C, G, A] ;
 module G1 = S1.G1 ;
 module P1 = S1.P1 ;
 module TC = S1.TC ;
 EP : P1.PCtx = S1.EP ;
 E1 : P1.PCtx = S1.E1 ;
 a0' : P1.PEl[E1, S1.A2.1] = S1.OV.wkE S1.EP S1.A1F S1.A1F (G1.fibCwF-T.q S1.GP A) ;
 b0' : P1.PEl[E1, S1.A2.1] = G1.fibCwF-T.q S1.EP S1.A1F ;
 module Y = G1.FT.GPosIdY[l].IdY[E1, S1.A2.1, a0', b0'] ;
 diag (X : TC.TOb) (z : W0.Ix (EP.ob X)) : W0.Ix (E1.ob X) = (z, z.2) ;
 e01 (X : TC.TOb) (z : W0.Ix (EP.ob X)) (W : TC.TOb) (f : TC.THm W X)
   : Id (W0.Ix (S1.A2.1.tob W (Y.pt X (diag X z) W f))) (a0'.eob W (Y.pt X (diag X z) W f)) (b0'.eob W (Y.pt X (diag X z) W f)) =
  P1.tact-irr S1.GP A.1 W X f z.1 (S1.GP.act W X f z.1) (refl (S1.GP.act W X f z.1))
    (P1.ntEq EP S1.GP (P1.pP S1.GP A.1) W X f z (EP.act W X f z) (refl (EP.act W X f z))) z.2 ;
 IdYT : P1.PTy[E1] = Y.IdYT ;
 val (X : TC.TOb) (z : W0.Ix (EP.ob X)) : W0.Ix (Y.tob X (diag X z)) =
  ((\ W f j -> a0'.eob W (Y.pt X (diag X z) W f),
    (\ V W g f j -> a0'.enat V W g (Y.pt X (diag X z) W f) (Y.pt X (diag X z) V (G1.GB.BC.oC V W X f g)) (Y.ptn X (diag X z) V W g f),
     (\ W f -> refl (a0'.eob W (Y.pt X (diag X z) W f)), \ W f -> e01 X z W f))),
   (G1.GB.topS X, \ W f i j -> refl (a0'.eob W (Y.pt X (diag X z) W f)))) ;
 module RF = G1.FT.GFibIdRd[l].ReflY[E1, S1.A2.1, a0'] ;
 valN (J I : TC.TOb) (h : TC.THm J I) (z : W0.Ix (EP.ob I)) (z' : W0.Ix (EP.ob J))
   (e : Id (W0.Ix (E1.ob J)) (E1.act J I h (diag I z)) (diag J z'))
   : Id (W0.Ix (Y.tob J (diag J z'))) (Y.tactY J I h (diag I z) (diag J z') e (val I z)) (val J z') =
  Y.idY-eq J (diag J z') (Y.tactY J I h (diag I z) (diag J z') e (val I z)) (val J z')
    (\ V g j -> transH (Y.Tact[J, I, h, diag I z, diag J z', e, val I z].rdc V g j)
                  (apH {W0.Ix (E1.ob V)} {Y.TA.EI V} (\ v -> Y.TA.pr V v (a0'.eob V v)) (Y.Tact[J, I, h, diag I z, diag J z', e, val I z].pi V g)))
    (RF.pre-top J I h) ;
 -- the action of E1 on a diagonal point
 dE (J I : TC.TOb) (h : TC.THm J I) (z : W0.Ix (EP.ob I)) : Id (W0.Ix (E1.ob J)) (E1.act J I h (diag I z)) (diag J (EP.act J I h z)) =
  apH {W0.Ix (A.1.tob J (EP.act J I h z).1)} {W0.Ix (E1.ob J)} (\ c -> (EP.act J I h z, c))
    (symH (P1.tact-irr S1.GP A.1 J I h z.1 (S1.GP.act J I h z.1) (refl (S1.GP.act J I h z.1))
             (P1.ntEq EP S1.GP (P1.pP S1.GP A.1) J I h z (EP.act J I h z) (refl (EP.act J I h z))) z.2)) ;
 pa (X : TC.TOb) (z : W0.Ix (EP.ob X)) : P1.SigT E1 IdYT X = P1.pairE E1 IdYT X (diag X z) (val X z) ;
 pa-act (J I : TC.TOb) (h : TC.THm J I) (z : W0.Ix (EP.ob I))
   : Id (P1.SigT E1 IdYT J) ((P1.extP E1 IdYT).act J I h (pa I z)) (pa J (EP.act J I h z)) =
  transH (P1.pair-act E1 IdYT J I h (diag I z) (diag J (EP.act J I h z)) (dE J I h z) (val I z))
    (apH {W0.Ix (Y.tob J (diag J (EP.act J I h z)))} {P1.SigT E1 IdYT J} (\ c -> P1.pairE E1 IdYT J (diag J (EP.act J I h z)) c)
       (valN J I h z (EP.act J I h z) (dE J I h z))) ;
} ;
