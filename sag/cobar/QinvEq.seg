-- QinvEq.seg (canonicity-45; COBAR.md "Corollary 15"): a quasi-inverse in
-- core's sense between fibrant types gives core's equivalence structure.
--   Input: f : A -> B, g : B -> A natural maps (CHtpyOps.NMap), with
--   homotopies eta : g f ~ id and eps : f g ~ id (CHtpyOps.HT), A and B
--   fibrant (FC.STy).  Output: CEquiv.EquivOp of f (as LR.Map's PMap).
-- Through the CwF of fibrant types:
--   FunOf    an NMap as an element of Fun (lam of its reading in B[p])
--   AppW     the value at a point of app (wkF w) a: bod w at (y , a y)
--            (CwFOv.bodNat, then FibIdRd.elTr: the transports are along
--            type equalities with the same fibre codes)
--   HtpyOf   a homotopy u v ~ id as an element of EQ.Htpy: its line field
--            (the readings at (id , j), moved into the fibre by the point
--            condition) through FibNF.LineY, with the ends by AppW
--   QE       CwFS4.kOf (Escardo: contractible fibres), FibS3 S3b
--            (Kr -> EquivOp), and the retargeting from bod (lam fP) to f
--            (app-lam) by CHFibCart.moveEq along identities.
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;
module FCw = FibCwF[a, l] ;
module FC = FCw.FC ;
module LR = CLocBoundRetr[a, l] ;
module OV = CwFOv.Ov[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId] ;
module S4 = CwFS4.S4[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, FibId[a, l].fibId, FibNF[a, l].nf] ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;
module RD = FibIdRd[a, l] ;

-- the derived members of a CwF, named
module Der (k : Level) (C : CwF.CwF[k]) {
  pst (G : C.Ctx) (A B : C.Ty G) (a : C.El G A)
    : Id (C.Ty G) (C.subT G (C.ext G A) (C.subT (C.ext G A) G B (C.p G A)) (C.sec G A a)) B = C.p-sec-T G A B a ;
} ;
module DF = Der[l+, FCw.fibCwF] ;

------------------------------------------------------------------------
-- a natural map as an element of Fun

module FunOf (G : PCtx) (Y X : FC.STy G) (f : HO.NMap[G, Y.1, X.1]) {
  module TY = GPR.TyL[G, Y.1] ;
  GY : PCtx = extP G Y.1 ;
  XY : PTy[GY] = subTy GY G X.1 (pP G Y.1) ;

  fnat (J I : Ob) (h : Hom J I) (z : W0.Ix (GY.ob I)) (z' : W0.Ix (GY.ob J)) (e : Id (W0.Ix (GY.ob J)) (GY.act J I h z) z')
    : Id (W0.Ix (XY.tob J z')) (XY.tact J I h z z' e (f.nfun I (TY.pr1 I z) (TY.pr2 I z))) (f.nfun J (TY.pr1 J z') (TY.pr2 J z')) =
    idJ (W0.Ix (GY.ob J)) (GY.act J I h z)
      (\ z2 e2 -> Id (W0.Ix (XY.tob J z2)) (XY.tact J I h z z2 e2 (f.nfun I (TY.pr1 I z) (TY.pr2 I z))) (f.nfun J (TY.pr1 J z2) (TY.pr2 J z2)))
      (transH (f.nnat J I h (TY.pr1 I z) (G.act J I h (TY.pr1 I z)) (ntEq GY G (pP G Y.1) J I h z (GY.act J I h z) (refl (GY.act J I h z))) (TY.pr2 I z))
        (apH (f.nfun J (G.act J I h (TY.pr1 I z)))
          (tact-irr G Y.1 J I h (TY.pr1 I z) (G.act J I h (TY.pr1 I z))
             (ntEq GY G (pP G Y.1) J I h z (GY.act J I h z) (refl (GY.act J I h z))) (refl (G.act J I h (TY.pr1 I z))) (TY.pr2 I z))))
      z' e ;

  fP : PEl[GY, XY] = mkPEl GY XY (\ I z -> f.nfun I (TY.pr1 I z) (TY.pr2 I z)) fnat ;

  fC : FCw.fibCwF.El G (OV.Fun G Y X) = OV.lam G Y (OV.wkT G Y X) fP ;

  -- the body of fC is the reading of f
  bod-eq (W : Ob) (z : W0.Ix (GY.ob W)) : Id (W0.Ix (X.1.tob W (TY.pr1 W z))) ((OV.bod G Y (OV.wkT G Y X) fC).eob W z) (f.nfun W (TY.pr1 W z) (TY.pr2 W z)) =
    apH (\ r -> r.eob W z) (PP.PiCode[G, Y.1, (OV.wkT G Y X).1].app-lam fP) ;
} ;

------------------------------------------------------------------------
-- the value at a point of app (wkF w) a

module AppW (G : PCtx) (Y P Q : FC.STy G) (w : FCw.fibCwF.El G (OV.Fun G P Q))
  (aa : FCw.fibCwF.El (extP G Y.1) (OV.wkT G Y P)) {
  K : PCtx = extP G Y.1 ;
  P' : FC.STy K = OV.wkT G Y P ;
  Q' : FC.STy K = OV.wkT G Y Q ;
  module TY = GPR.TyL[G, Y.1] ;
  wk : FCw.fibCwF.El K (OV.Fun K P' Q') = EQ.wkF G Y P Q w ;
  t : FCw.fibCwF.El K Q' = OV.app K P' Q' wk aa ;
  bw : FCw.fibCwF.El (extP G P.1) (OV.wkT G P Q) = OV.bod G P (OV.wkT G P Q) w ;

  KP : PCtx = extP K P'.1 ;
  lf : PSub[KP, extP G P.1] = liftP K G P.1 (pP G Y.1) ;

  -- the body of the weakening is the weakening of the body (bodNat)
  QL : Id (FC.STy KP) (FCw.fibCwF.subT KP (extP G P.1) (OV.wkT G P Q) lf) (OV.wkT K P' Q') =
    OV.wkT-ov K G P Q (pP G Y.1) P' (refl P') Q' (refl Q') ;
  bhE : Id (FCw.fibCwF.El KP (OV.wkT K P' Q')) (OV.bod K P' (OV.wkT K P' Q') wk)
          (OV.trE KP (FCw.fibCwF.subT KP (extP G P.1) (OV.wkT G P Q) lf) (OV.wkT K P' Q') QL
             (FCw.fibCwF.subt KP (extP G P.1) (OV.wkT G P Q) bw lf)) =
    OV.bodNat K G P (OV.wkT G P Q) (pP G Y.1) (OV.wkT K P' Q') QL (EQ.wkFP G Y P Q) w ;

  val (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (Q.1.tob W (TY.pr1 W z))) (t.eob W z) (bw.eob W (pairE G P.1 W (TY.pr1 W z) (aa.eob W z))) =
    transH (RD.elTr K (FC.STy K) (\ Z -> Z.1) (FCw.fibCwF.subT K KP (OV.wkT K P' Q') (secP K P'.1 aa)) Q' (DF.pst K P' Q' aa)
              (FCw.fibCwF.subt K KP (OV.wkT K P' Q') (OV.bod K P' (OV.wkT K P' Q') wk) (secP K P'.1 aa)) W z
              (refl (Q.1.tob W (TY.pr1 W z))))
      (transH (apH (\ v -> v.eob W (pairE K P'.1 W z (aa.eob W z))) bhE)
         (RD.elTr KP (FC.STy KP) (\ Z -> Z.1) (FCw.fibCwF.subT KP (extP G P.1) (OV.wkT G P Q) lf) (OV.wkT K P' Q') QL
              (FCw.fibCwF.subt KP (extP G P.1) (OV.wkT G P Q) bw lf) W (pairE K P'.1 W z (aa.eob W z))
              (refl (Q.1.tob W (TY.pr1 W z))))) ;
} ;

------------------------------------------------------------------------
-- a homotopy u v ~ id as an element of Htpy

module HtpyOf (G : PCtx) (X Y : FC.STy G) (u : HO.NMap[G, X.1, Y.1]) (v : HO.NMap[G, Y.1, X.1])
  (H : PEl[extP G Y.1, HO.HT[G, Y.1, Y.1, HO.compN G Y.1 X.1 Y.1 v u, HO.idN G Y.1].PT.PathP]) {
  module T = HO.HT[G, Y.1, Y.1, HO.compN G Y.1 X.1 Y.1 v u, HO.idN G Y.1] ;
  module TY = GPR.TyL[G, Y.1] ;
  K : PCtx = extP G Y.1 ;
  module FU = FunOf[G, X, Y, u] ;
  module FV = FunOf[G, Y, X, v] ;
  uC : FCw.fibCwF.El G (OV.Fun G X Y) = FU.fC ;
  vC : FCw.fibCwF.El G (OV.Fun G Y X) = FV.fC ;
  YY : FC.STy K = OV.wkT G Y Y ;
  YX : FC.STy K = OV.wkT G Y X ;
  t0 : FCw.fibCwF.El K YX = OV.app K YY YX (EQ.wkF G Y Y X vC) (qP G Y.1) ;
  t1 : FCw.fibCwF.El K YY = OV.app K YX YY (EQ.wkF G Y X Y uC) t0 ;
  module A0 = AppW[G, Y, Y, X, vC, qP G Y.1] ;
  module A1 = AppW[G, Y, X, Y, uC, t0] ;

  t0v (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (X.1.tob W (TY.pr1 W z))) (t0.eob W z) (v.nfun W (TY.pr1 W z) (TY.pr2 W z)) =
    transH (A0.val W z) (FV.bod-eq W (pairE G Y.1 W (TY.pr1 W z) (TY.pr2 W z))) ;

  t1v (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (Y.1.tob W (TY.pr1 W z))) (t1.eob W z) (u.nfun W (TY.pr1 W z) (v.nfun W (TY.pr1 W z) (TY.pr2 W z))) =
    transH (A1.val W z)
      (transH (FU.bod-eq W (pairE G X.1 W (TY.pr1 W z) (t0.eob W z)))
         (apH (u.nfun W (TY.pr1 W z)) (t0v W z))) ;

  -- the line field: the readings of H at (id , j), in the fibre
  pvz (W : Ob) (z : W0.Ix (K.ob W)) (j : Hom W Iv) : TY.EI W = T.pv H W z W (idH W) j ;
  pteq (W : Ob) (z : W0.Ix (K.ob W)) (j : Hom W Iv) : Id (W0.Ix (G.ob W)) (TY.pr1 W (pvz W z j)) (TY.pr1 W z) =
    transH ((H.eob W z).2.1 W (idH W) j) (G.act-id W (TY.pr1 W z)) ;
  Lf (W : Ob) (z : W0.Ix (K.ob W)) (j : Hom W Iv) : W0.Ix (Y.1.tob W (TY.pr1 W z)) =
    TY.coeT W (TY.pr1 W (pvz W z j)) (TY.pr1 W z) (pteq W z j) (TY.pr2 W (pvz W z j)) ;
  Lf-rd (W : Ob) (z : W0.Ix (K.ob W)) (j : Hom W Iv) : Id (TY.EI W) (TY.pr W (TY.pr1 W z) (Lf W z j)) (pvz W z j) =
    symH (TY.pr-coe W (TY.pr1 W (pvz W z j)) (TY.pr1 W z) (pteq W z j) (TY.pr2 W (pvz W z j))) ;

  Unat (V W : Ob) (g : Hom V W) (z : W0.Ix (K.ob W)) (z' : W0.Ix (K.ob V)) (E : Id (W0.Ix (K.ob V)) (K.act V W g z) z') (j : Hom W Iv)
    : Id (W0.Ix (YY.1.tob V z')) (YY.1.tact V W g z z' E (Lf W z j)) (Lf V z' (compH V W Iv j g)) =
    TY.pr-inj V (TY.pr1 V z') (YY.1.tact V W g z z' E (Lf W z j)) (Lf V z' (compH V W Iv j g))
      (calc (TY.EI V) {
          TY.pr V (TY.pr1 V z') (YY.1.tact V W g z z' E (Lf W z j))
        =< symH (TY.pr-tact V W g (TY.pr1 W z) (TY.pr1 V z') (ntEq K G (pP G Y.1) V W g z z' E) (Lf W z j)) >
          TY.E.act V W g (TY.pr W (TY.pr1 W z) (Lf W z j))
        =< apH (TY.E.act V W g) (Lf-rd W z j) >
          TY.E.act V W g (pvz W z j)
        =< (H.eob W z).1.2 V W g (idH W) j >
          T.pv H W z V (compH V W W (idH W) g) (compH V W Iv j g)
        =< apH (\ k -> T.pv H W z V k (compH V W Iv j g)) (transH (PB.comp-idl V W g) (symH (PB.comp-idr V W g))) >
          T.pv H W z V (compH V V W g (idH V)) (compH V W Iv j g)
        =< T.pv-res H V W g z z' E V (idH V) (compH V W Iv j g) >
          pvz V z' (compH V W Iv j g)
        =< symH (Lf-rd V z' (compH V W Iv j g)) >
          TY.pr V (TY.pr1 V z') (Lf V z' (compH V W Iv j g)) }) ;

  U0 (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (Y.1.tob W (TY.pr1 W z))) (Lf W z (PB.ptH W PB.e0)) (t1.eob W z) =
    TY.pr-inj W (TY.pr1 W z) (Lf W z (PB.ptH W PB.e0)) (t1.eob W z)
      (transH (Lf-rd W z (PB.ptH W PB.e0))
        (transH (H.eob W z).2.2.1
          (apH (TY.pr W (TY.pr1 W z)) (symH (t1v W z))))) ;

  U1 (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (Y.1.tob W (TY.pr1 W z))) (Lf W z (PB.ptH W PB.e1)) ((qP G Y.1).eob W z) =
    TY.pr-inj W (TY.pr1 W z) (Lf W z (PB.ptH W PB.e1)) ((qP G Y.1).eob W z)
      (transH (Lf-rd W z (PB.ptH W PB.e1)) (H.eob W z).2.2.2) ;

  module LY = FibNF[a, l].LineY[K, YY.1, t1, qP G Y.1, Lf, Unat, U0, U1] ;

  htpy : FCw.fibCwF.El G (EQ.Htpy G X Y uC vC) = OV.lam G Y (FibId[a, l].fibId.IdT K YY t1 (qP G Y.1)) LY.el ;
} ;

------------------------------------------------------------------------
-- the theorem

module QE (G : PCtx) (A B : FC.STy G) (f : HO.NMap[G, A.1, B.1]) (g : HO.NMap[G, B.1, A.1])
  (eta : PEl[extP G A.1, HO.HT[G, A.1, A.1, HO.compN G A.1 B.1 A.1 f g, HO.idN G A.1].PT.PathP])
  (eps : PEl[extP G B.1, HO.HT[G, B.1, B.1, HO.compN G B.1 A.1 B.1 g f, HO.idN G B.1].PT.PathP]) {
  module TA = GPR.TyL[G, A.1] ;
  module TB = GPR.TyL[G, B.1] ;
  module FF = FunOf[G, A, B, f] ;
  module HE = HtpyOf[G, B, A, g, f, eta] ;
  module HP = HtpyOf[G, A, B, f, g, eps] ;
  fC : FCw.fibCwF.El G (OV.Fun G A B) = FF.fC ;
  gC : FCw.fibCwF.El G (OV.Fun G B A) = FunOf[G, B, A, g].fC ;

  -- Escardo: the fibres of fC are contractible
  k : FCw.fibCwF.El G (S4.QP.Kr G B A fC) = S4.kOf G B A gC fC HE.htpy fC HP.htpy ;

  -- S3b: an equivalence structure on the body of fC
  module S3 = FibS3[a, l].S3[G, B, A, fC] ;
  eop0 : CE.EquivOp G A.1 B.1 S3.al = S3.B[k].eop ;

  -- retargeted to f
  fM : CP.PMap[G, A.1, B.1] = LR.Map[G, A.1, B.1, f].pmap ;
  al-eq (W : Ob) (w : TA.EI W) : Id (TB.EI W) (S3.al.mE W w) (fM.mE W w) =
    apH (TB.pr W (TA.pr1 W w)) (FF.bod-eq W w) ;

  module HC = PB.CHFibCart[l, l].HCart[G, A.1, B.1, fM, G, A.1, B.1, S3.al,
     \ W d -> d, \ V W g d -> refl (G.act V W g d),
     \ W v -> v, \ W v -> refl (TB.pr1 W v), \ V W g v -> refl (TB.E.act V W g v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TB.pr X x u),
     \ W v -> v, \ W v -> refl (TA.pr1 W v), \ V W g v -> refl (TA.E.act V W g v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TA.pr X x u),
     \ W v -> symH (al-eq W v)] ;

  qinvEq : CE.EquivOp G A.1 B.1 fM = HC.moveEq eop0 ;
} ;
