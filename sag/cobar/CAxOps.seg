-- CAxOps.seg (canonicity-c2; the axioms' statements, part 3): G's addition and
-- multiplication (45's CCmpY5.Ops2.GO, maps of D-contexts) read on the fibres
-- of G, with their naturality, for CAxEv.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PB = PosFull[a].PB ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module OpsOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) {
 module O = CCmpY5[a].Ops2[R, encK, pe, al, eqal, commH] ;
 module EG = CAxEv[a].EvG[R, encK, pe] ;
 addV (X : EG.Ob) (u v : EG.GV X) : EG.GV X = O.GO.add.nt X.1 X.2 (u, v) ;
 mulV (X : EG.Ob) (u v : EG.GV X) : EG.GV X = O.GO.mul.nt X.1 X.2 (u, v) ;
 addN (J I : EG.Ob) (f : EG.Hm J I) (u v : EG.GV I) : Id (EG.GV J) (EG.rsG J I f (addV I u v)) (addV J (EG.rsG J I f u) (EG.rsG J I f v)) =
  symH (O.GO.add.nt-nat J.1 I.1 f.1 J.2 I.2 f.2 (u, v)) ;
 mulN (J I : EG.Ob) (f : EG.Hm J I) (u v : EG.GV I) : Id (EG.GV J) (EG.rsG J I f (mulV I u v)) (mulV J (EG.rsG J I f u) (EG.rsG J I f v)) =
  symH (O.GO.mul.nt-nat J.1 I.1 f.1 J.2 I.2 f.2 (u, v)) ;
} ;
