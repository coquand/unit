-- CTotP13m.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part m: bkMv, first half, as c2's CTotPsi21: u's path at an index,
-- restricted along a map of the base, is u's path at the restricted index
-- (u's naturality through fibL, ABS), for any equation of the object
-- (GenL, path induction).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13m (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PI = CTotP13i[a, vl, l].P13i[C, G, A, B, f] ;
 module PE = PI.PE ;
 module PB13 = PE.PB13 ;
 module TR = PE.TR ;
 module G1 = TR.G1 ;
 module TC = PE.TC ;
 module DO = PE.DO ;
 module CT = DO.CT ;
 module H = PE.H ;
 module HD = PE.HD ;
 module DS = PI.DS ;
 Obj (I : Ob) : U vl = PE.Obj I ;

 -- abstract forms of the two steps (checked once, then instantiated)
 module ABS (Y' Y : TC.TOb) (cv : TC.THm Y' Y) (p1 : W0.Ix (H.EA.ob Y)) (f1 : W0.Ix (PB13.Pt.tob Y p1))
   (p2 : W0.Ix (H.EA.ob Y')) (f2 : W0.Ix (PB13.Pt.tob Y' p2))
   (uN : Id (H.TF.EI Y') (H.TF.E.act Y' Y cv (DS.prz Y.1 Y.2 p1 f1)) (DS.prz Y'.1 Y'.2 p2 f2)) (j : PB.IvP Y'.1) {
  mid : H.TA.EI Y' = f1.2.1.1 Y' (TC.tcomp Y' Y' Y cv (TC.tid Y')) j ;
  l1 : Id (H.TA.EI Y') mid (f2.2.1.1 Y' (TC.tid Y') j) =
   ap (H.TF.EI Y') (H.TA.EI Y') (\ T -> H.fibL Y' T Y' (TC.tid Y') j)
    (H.TF.E.act Y' Y cv (DS.prz Y.1 Y.2 p1 f1)) (DS.prz Y'.1 Y'.2 p2 f2) uN ;
  l2 : Id (H.TA.EI Y') mid (f1.2.1.1 Y' cv j) =
   ap (TC.THm Y' Y) (H.TA.EI Y') (\ k -> f1.2.1.1 Y' k j) (TC.tcomp Y' Y' Y cv (TC.tid Y')) cv (G1.GB.BC.oC-idr Y' Y cv) ;
  law : Id (H.TA.EI Y') (f2.2.1.1 Y' (TC.tid Y') j) (f1.2.1.1 Y' cv j) =
   trans (H.TA.EI Y') (f2.2.1.1 Y' (TC.tid Y') j) mid (f1.2.1.1 Y' cv j) (symH l1) l2 ;
 } ;
 module GenL (W1 J : Ob) (vv : Hom W1 J) (z : Obj J) (lnq : W0.Ix (PE.FTg.FE.ob (J, z)))
   (L : (y : Obj W1) (e1 : Id (Obj W1) (C.res W1 J vv z) y) -> W0.Ix (PE.FTg.FE.ob (W1, y))) (j : PB.IvP W1)
   (base : Id (H.TA.EI (W1, C.res W1 J vv z)) ((L (C.res W1 J vv z) (refl (C.res W1 J vv z))).1 (W1, C.res W1 J vv z) (TC.tid (W1, C.res W1 J vv z)) j)
             (lnq.1 (W1, C.res W1 J vv z) (vv, C.cart W1 J vv z) j)) {
  gen (y : Obj W1) (e1 : Id (Obj W1) (C.res W1 J vv z) y)
   : Id (H.TA.EI (W1, y)) ((L y e1).1 (W1, y) (TC.tid (W1, y)) j)
       (lnq.1 (W1, y) (vv, PE.PO.VT.trD W1 J vv (C.res W1 J vv z) y e1 z (C.cart W1 J vv z)) j) =
   idJ (Obj W1) (C.res W1 J vv z)
    (\ y2 e2 -> Id (H.TA.EI (W1, y2)) ((L y2 e2).1 (W1, y2) (TC.tid (W1, y2)) j)
       (lnq.1 (W1, y2) (vv, PE.PO.VT.trD W1 J vv (C.res W1 J vv z) y2 e2 z (C.cart W1 J vv z)) j))
    base y e1 ;
 } ;

 module BM (X : TC.TOb) (w : HD.TA.EI X) (u : DS.TOb' X.1 X.2 (PE.PR.phi X w)) {
  module BD = PI.BKd[X, w, u] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module PQ (n : Nat) (J : Ob) (Ub : Hom J I) (z : Obj J) (cc : CT.Ch J n (C.res J I Ub x) z) (i : Wt.Pn n J) {
   qq : DO.Idx I x = (n, J, Ub, z, cc, i.1) ;
   Y : TC.TOb = (J, z) ;
   lnq : W0.Ix (PE.FTg.FE.ob Y) = BD.lineE qq i.2 ;
   cT (W1 : Ob) (vv : Hom W1 J) (y : Obj W1) (e1 : Id (Obj W1) (C.res W1 J vv z) y) : CT.Ch W1 n (C.res W1 I (compH W1 J I Ub vv) x) y =
    subst (Obj W1) (\ t -> CT.Ch W1 n (C.res W1 I (compH W1 J I Ub vv) x) t) (C.res W1 J vv z) y e1 (DO.rCh W1 J I vv Ub x n z cc) ;
   module LV (W1 : Ob) (vv : Hom W1 J) (j : PB.IvP W1) {
    rz : Obj W1 = C.res W1 J vv z ;
    R : Wt.Pn n W1 = Wt.Res[n, W1, J, vv, i].res ;
    Uv : Hom W1 I = compH W1 J I Ub vv ;
    cv : TC.THm (W1, rz) Y = (vv, C.cart W1 J vv z) ;
    lineAt (y : Obj W1) (e1 : Id (Obj W1) rz y) : W0.Ix (PE.FTg.FE.ob (W1, y)) =
     BD.lineE (n, W1, Uv, y, cT W1 vv y e1, R.1) R.2 ;
    -- u's naturality: the restricted line is the line at the restricted index
    uN : Id (H.TF.EI (W1, rz)) (DS.anatL I x (PE.PR.phi X w) u.1 (qq, (W1, vv)) i.2) (DS.anatR I x (PE.PR.phi X w) u.1 (qq, (W1, vv)) i.2) =
     u.2.1 (qq, (W1, vv)) i.2 ;
    module AB0 = ABS[(W1, rz), Y, cv, (PE.PR.phi X w).1 qq i.2, u.1 qq i.2,
       (PE.PR.phi X w).1 (n, W1, Uv, rz, DO.rCh W1 J I vv Ub x n z cc, R.1) R.2, u.1 (n, W1, Uv, rz, DO.rCh W1 J I vv Ub x n z cc, R.1) R.2,
       uN, j] ;
    base : Id (H.TA.EI (W1, rz)) ((lineAt rz (refl rz)).1 (W1, rz) (TC.tid (W1, rz)) j) (lnq.1 (W1, rz) cv j) = AB0.law ;
    gen (y : Obj W1) (e1 : Id (Obj W1) rz y)
     : Id (H.TA.EI (W1, y)) ((lineAt y e1).1 (W1, y) (TC.tid (W1, y)) j)
         (lnq.1 (W1, y) (vv, PE.PO.VT.trD W1 J vv rz y e1 z (C.cart W1 J vv z)) j) =
     GenL[W1, J, vv, z, lnq, lineAt, j, base].gen y e1 ;
   } ;
  } ;
 } ;
} ;
