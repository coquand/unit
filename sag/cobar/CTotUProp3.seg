-- CTotUProp3.seg (canonicity-c2): U PRESERVES PROPOSITIONS. If A is a
-- proposition over G at the total site (internally), U A is a proposition
-- over U G at the levelwise site (internally): the contraction of A over
-- G.A restricts (CTotUProp2) and is moved from U (G.A) to U G . U A along
-- the identity (same points and actions).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module UP3 (C : CIntCat[a, vl].IC) (G : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ctx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty G) {
 module U2 = CTotUProp2[a, vl, l].UP2[C] ;
 module TR = U2.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module U4 = CTotUFib4[a, vl, l].UFib4[C] ;
 module PN1 = CwFPropNoU.PropNoU[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T, G1.nf-T] ;
 module PN0 = CwFPropNoU.PropNoU[l+, G0.fibCwF-T, G0.fibPi-T, G0.fibSig-T, G0.fibId-T, G0.nf-T] ;
 GA : G1.fibCwF-T.Ctx = G1.fibCwF-T.ext G A ;
 AW : G1.fibCwF-T.Ty GA = G1.fibCwF-T.subT GA G A (G1.fibCwF-T.p G A) ;
 UG : G0.fibCwF-T.Ctx = TR.RS.rC G ;
 UA : G0.fibCwF-T.Ty UG = (TR.RS.rT G A.1, U4.fibU G A.1 A.2) ;
 UGA : G0.fibCwF-T.Ctx = G0.fibCwF-T.ext UG UA ;
 UAW : G0.fibCwF-T.Ty UGA = G0.fibCwF-T.subT UGA UG UA (G0.fibCwF-T.p UG UA) ;
 D0 : TR.P0.PCtx = TR.RS.rC GA ;
 S0 : TR.P0.PTy[D0] = TR.RS.rT GA AW.1 ;
 module TS0 = G0.GB.GPre[l].TyL[D0, S0] ;
 module At (pA : G1.fibCwF-T.El G (PN1.isProp G A)) {
  k1 : G1.GB.CPartial[l].ContrOp GA AW.1 = G1.contrOp-T GA AW (PN1.selfContr G A pA) ;
  kL : G0.GB.CPartial[l].ContrOp D0 S0 = U2.KO[GA, AW.1, k1].k0 ;
  module M = G0.GB.CMove[l, l].Mv[UGA, UAW.1, UAW.1, G0.GB.CPartial[l].pmap-id UGA UAW.1,
    D0, S0, S0, G0.GB.CPartial[l].pmap-id D0 S0,
    \ Wb x -> x, \ Vb Wb g x -> refl (D0.act Vb Wb g x),
    \ Wb v -> v, \ Wb v -> refl v.1, \ Vb Wb g v -> refl (TS0.E.act Vb Wb g v),
    \ Wb v -> v, \ Wb v -> refl v.1, \ Vb Wb g v -> refl (TS0.E.act Vb Wb g v),
    \ Wb v v' Pp Q -> Q,
    \ X x u -> u, \ X x u -> refl (TS0.pr X x u), \ Wb v -> refl v, kL] ;
  contr0 : G0.fibCwF-T.El UGA (G0.EQT.isContr UGA UAW) = G0.contr-T UGA UAW M.rc ;
  isPropU : G0.fibCwF-T.El UG (PN0.isProp UG UA) = PN0.propOver UG UA contr0 ;
 } ;
} ;
