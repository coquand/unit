-- CChainsF.seg (canonicity-45; SIMPLIFIED.md step 4): the chain map of
-- a functor F : C -> D between small categories (CVert.SFun), on the
-- chains of Chains.ChainsOf: objects by onO, maps by onH; it commutes
-- with the faces (comp, drop), with the reindexing rx along a map, and
-- with the identity and composite functors.  Used for the restriction of
-- the chains at a stage along a base map (CVert.rfun).
--   CF[C, D, F].chF n x z : Ch_C n x z -> Ch_D n (onO x) (onO z)
--   chF-comp, chF-drop, chF-rx
-- No new axioms.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module Tr = Trees[a] ;
module Ar = Arith[a] ;

-- functors between small categories
module FunOf (Cs Ds : SmallCat[a].SmallCat) {
 record SFun {
  onO : SmallCat[a].Objs[Cs.obV].Ob -> SmallCat[a].Objs[Ds.obV].Ob ;
  onH (y x : SmallCat[a].Objs[Cs.obV].Ob) : SmallCat[a].Homs[Cs.obV, Cs.homV].Hom y x -> SmallCat[a].Homs[Ds.obV, Ds.homV].Hom (onO y) (onO x) ;
  onId (x : SmallCat[a].Objs[Cs.obV].Ob) : Id (SmallCat[a].Homs[Ds.obV, Ds.homV].Hom (onO x) (onO x)) (onH x x (Cs.idC x)) (Ds.idC (onO x)) ;
  onComp (z y x : SmallCat[a].Objs[Cs.obV].Ob) (f : SmallCat[a].Homs[Cs.obV, Cs.homV].Hom y x) (g : SmallCat[a].Homs[Cs.obV, Cs.homV].Hom z y)
   : Id (SmallCat[a].Homs[Ds.obV, Ds.homV].Hom (onO z) (onO x)) (onH z x (Cs.oC z y x f g)) (Ds.oC (onO z) (onO y) (onO x) (onH y x f) (onH z y g)) ;
 } ;
} ;

module CF (Cs Ds : SmallCat[a].SmallCat) (F : FunOf[Cs, Ds].SFun) {
 module KC = Chains[a].ChainsOf[Cs] ;
 module KD = Chains[a].ChainsOf[Ds] ;
 CO : U a = KC.CO ;
 DO : U a = KD.CO ;
 o : CO -> DO = F.onO ;
 h (y x : CO) : KC.CH y x -> KD.CH (o y) (o x) = F.onH y x ;

 chF : (n : Nat) -> (x z : CO) -> KC.Ch n x z -> KD.Ch n (o x) (o z) = split {
  zero -> \ x z f -> h z x f ;
  suc m | r -> \ x z c -> (o c.1, h c.1 x c.2.1, r c.1 z c.2.2) } ;

 -- the chain map commutes with composing adjacent maps
 chF-comp : (n : Nat) -> (k : Nat) -> (x z : CO) (c : KC.Ch (suc n) x z)
  -> Id (KD.Ch n (o x) (o z)) (chF n x z (KC.comp n k x z c)) (KD.comp n k (o x) (o z) (chF (suc n) x z c)) = split {
  zero -> \ k x z c -> F.onComp z c.1 x c.2.1 c.2.2 ;
  suc m | r -> split {
   zero -> \ x z c -> apH {KD.CH (o c.2.2.1) (o x)} {KD.Ch (suc m) (o x) (o z)} (\ w -> (o c.2.2.1, w, chF m c.2.2.1 z c.2.2.2.2)) (F.onComp c.2.2.1 c.1 x c.2.1 c.2.2.2.1) ;
   suc k -> \ x z c -> apH {KD.Ch m (o c.1) (o z)} {KD.Ch (suc m) (o x) (o z)} (\ w -> (o c.1, h c.1 x c.2.1, w)) (r k c.1 z c.2.2) } } ;

 -- the chain map commutes with dropping the last map
 DRF (n : Nat) (x z : CO) (d : KC.DR n x z) : KD.DR n (o x) (o z) = (o d.1, chF n x d.1 d.2.1, h z d.1 d.2.2) ;
 chF-drop : (n : Nat) -> (x z : CO) (c : KC.Ch (suc n) x z) -> Id (KD.DR n (o x) (o z)) (DRF n x z (KC.drop n x z c)) (KD.drop n (o x) (o z) (chF (suc n) x z c)) = split {
  zero -> \ x z c -> refl (o c.1, h c.1 x c.2.1, h z c.1 c.2.2) ;
  suc m | r -> \ x z c -> apH {KD.DR m (o c.1) (o z)} {KD.DR (suc m) (o x) (o z)} (\ D -> (D.1, (o c.1, h c.1 x c.2.1, D.2.1), D.2.2)) (r c.1 z c.2.2) } ;

 -- the chain map commutes with reindexing along a map g : x' -> x
 chF-rx : (n : Nat) -> (x' x : CO) (g : KC.CH x' x) (z : CO) (c : KC.Ch n x' z)
  -> Id (KD.Ch n (o x) (o z)) (chF n x z (KC.rx n x' x g z c)) (KD.rx n (o x') (o x) (h x' x g) (o z) (chF n x' z c)) = split {
  zero -> \ x' x g z c -> F.onComp z x' x g c ;
  suc m -> \ x' x g z c -> apH {KD.CH (o c.1) (o x)} {KD.Ch (suc m) (o x) (o z)} (\ w -> (o c.1, w, chF m c.1 z c.2.2)) (F.onComp c.1 x' x g c.2.1) } ;
} ;

-- the identity functor and composite functors, and the chain map of them
module FunLaws (Cs : SmallCat[a].SmallCat) {
 idF : FunOf[Cs, Cs].SFun =
  new FunOf[Cs, Cs].SFun[\ x -> x, \ y x f -> f, \ x -> refl (Cs.idC x), \ z y x f g -> refl (Cs.oC z y x f g)] ;
 module K = Chains[a].ChainsOf[Cs] ;
 chF-id : (n : Nat) -> (x z : K.CO) (c : K.Ch n x z) -> Id (K.Ch n x z) (CF[Cs, Cs, idF].chF n x z c) c = split {
  zero -> \ x z f -> refl f ;
  suc m | r -> \ x z c -> apH {K.Ch m c.1 z} {K.Ch (suc m) x z} (\ w -> (c.1, c.2.1, w)) (r c.1 z c.2.2) } ;
} ;
module FunComp (Cs Ds Es : SmallCat[a].SmallCat) (F : FunOf[Cs, Ds].SFun) (G : FunOf[Ds, Es].SFun) {
 compF : FunOf[Cs, Es].SFun =
  new FunOf[Cs, Es].SFun[\ x -> G.onO (F.onO x), \ y x f -> G.onH (F.onO y) (F.onO x) (F.onH y x f),
   \ x -> transH (apH {SmallCat[a].Homs[Ds.obV, Ds.homV].Hom (F.onO x) (F.onO x)} {SmallCat[a].Homs[Es.obV, Es.homV].Hom (G.onO (F.onO x)) (G.onO (F.onO x))}
                     (G.onH (F.onO x) (F.onO x)) (F.onId x)) (G.onId (F.onO x)),
   \ z y x f g -> transH (apH {SmallCat[a].Homs[Ds.obV, Ds.homV].Hom (F.onO z) (F.onO x)} {SmallCat[a].Homs[Es.obV, Es.homV].Hom (G.onO (F.onO z)) (G.onO (F.onO x))}
                             (G.onH (F.onO z) (F.onO x)) (F.onComp z y x f g))
                    (G.onComp (F.onO z) (F.onO y) (F.onO x) (F.onH y x f) (F.onH z y g))] ;
 module KC = Chains[a].ChainsOf[Cs] ;
 module KE = Chains[a].ChainsOf[Es] ;
 chF-o : (n : Nat) -> (x z : KC.CO) (c : KC.Ch n x z)
  -> Id (KE.Ch n (G.onO (F.onO x)) (G.onO (F.onO z))) (CF[Cs, Es, compF].chF n x z c) (CF[Ds, Es, G].chF n (F.onO x) (F.onO z) (CF[Cs, Ds, F].chF n x z c)) = split {
  zero -> \ x z f -> refl (G.onH (F.onO z) (F.onO x) (F.onH z x f)) ;
  suc m | r -> \ x z c -> apH {KE.Ch m (G.onO (F.onO c.1)) (G.onO (F.onO z))} {KE.Ch (suc m) (G.onO (F.onO x)) (G.onO (F.onO z))}
                             (\ w -> (G.onO (F.onO c.1), G.onH (F.onO c.1) (F.onO x) (F.onH c.1 x c.2.1), w)) (r c.1 z c.2.2) } ;
} ;
