-- Evaluate a finite cofactor vector in every context over G.  The
-- recursion is on the fixed external list of generators.  Coefficients
-- are genuine elements of the substituted cofactor type, and the ring
-- operations are pulled back along the same substitution.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Ring[a++] ;
module FT = CFinIntTy[a] ;

module Eval (G : FT.C.Ctx) (Rg : FT.PR.HRing[G]) {
 C : CwF.CwF[a++] = FT.C ;
 E : U a++ = C.El G Rg.R ;
 module CO = FT.Cofactor[G, Rg] ;
 lin : (fs : List E) (D : C.Ctx) (s : C.Sub D G)
   -> C.El D (C.subT D G (CO.CofT fs) s)
   -> C.El D (C.subT D G Rg.R s) = split {
   nil -> \ D s c -> CFinIntPull[a].Pull[G, D, Rg, s].zero ;
   cons f fs | ih -> \ D s c ->
     CFinIntPull[a].Pull[G, D, Rg, s].ap2
       CFinIntPull[a].Pull[G, D, Rg, s].add
       (CFinIntPull[a].Pull[G, D, Rg, s].ap2
         CFinIntPull[a].Pull[G, D, Rg, s].mul
         (C.subt D G Rg.R f s)
         CFinIntSplit[a].Split[G, D, Rg, f, fs, s, c].head)
       (ih D s CFinIntSplit[a].Split[G, D, Rg, f, fs, s, c].tail)
 } ;
} ;
