-- CTotL12ch.seg (canonicity-c2; SIMPLIFIED.md step 4): chain lemmas for
-- Lemma 12 at the total site, next to canonicity-45's CChainsT (frozen).
--   vpartCart   the vertical part of a cartesian lift is the identity
--   Cart.law    the action's reindexing along cart u x, at the chain c
--               with its head moved along res-id, is c (the analogue of
--               CChainsT.RxId for cartesian maps): the index (n, J, u, z,
--               c) of a stage (I, x) is the image of the identity index
--               (n, J, id, z, c^) of the stage (J, res u x)
level a vl ;
constraint a <= vl ;
open Base ;
open Prelude[vl+] ;
open Paths[vl+] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module ChL (C : CIntCat[a, vl].IC) {
 module VT = CVert[a, vl].VertOf[C] ;
 module CT = CChainsT[a, vl].ChT[C] ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 -- the head transport is injective
 trCh-inj (J : Ob) (n : Nat) (x x' : Obj J) (p : Id (Obj J) x x') (z : Obj J) (c c' : CT.Ch J n x z)
  (e : Id (CT.Ch J n x' z) (CT.trCh J n x x' p z c) (CT.trCh J n x x' p z c')) : Id (CT.Ch J n x z) c c' =
  transH (symH (transH (CT.trCh-trans J n x x' x p (symH p) z c) (CT.trCh-refl J n x (transH p (symH p)) z c)))
   (transH (apH {CT.Ch J n x' z} {CT.Ch J n x z} (\ w -> CT.trCh J n x' x (symH p) z w) e)
     (transH (CT.trCh-trans J n x x' x p (symH p) z c') (CT.trCh-refl J n x (transH p (symH p)) z c'))) ;

 module VpCart (J I : Ob) (u : Hom J I) (x : Obj I) {
  rux : Obj J = C.res J I u x ;
  i : Hom J J = idH J ;
  ct : VT.HomD J I u rux x = C.cart J I u x ;
  e : Id (VT.HomD J I (compH J J I u i) rux x) (C.compD J J I u i rux rux x ct (C.idD J rux))
        (VT.trH J I u (compH J J I u i) (symH (comp-idr J I u)) rux x ct) =
   symH (VT.THom-snd' J I rux x (u, ct) (compH J J I u i, C.compD J J I u i rux rux x ct (C.idD J rux))
           (symH (C.idr J I u rux x ct)) (symH (comp-idr J I u))) ;
  law : Id (VT.VMap J rux rux) (C.idD J rux) (VT.vpart J I u rux x ct) =
   C.fact-uniq J J I u i rux x (VT.trH J I u (compH J J I u i) (symH (comp-idr J I u)) rux x ct) (C.idD J rux) e ;
 } ;
 vpartCart (J I : Ob) (u : Hom J I) (x : Obj I)
  : Id (VT.VMap J (C.res J I u x) (C.res J I u x)) (VT.vpart J I u (C.res J I u x) x (C.cart J I u x)) (VT.vid J (C.res J I u x)) =
  symH VpCart[J, I, u, x].law ;

 module Cart (J I : Ob) (u : Hom J I) (x : Obj I) (n : Nat) (z : Obj J) (c : CT.Ch J n (C.res J I u x) z) {
  rux : Obj J = C.res J I u x ;
  i : Hom J J = idH J ;
  rr : Obj J = C.res J J i rux ;
  g0 : VT.VMap J rux rux = VT.vpart J I u rux x (C.cart J I u x) ;
  q : Id (Obj J) rux rr = symH (C.res-id J rux) ;
  ch : CT.Ch J n rr z = CT.trCh J n rux rr q z c ;
  p1 : Id (Obj J) rr (C.res J I (compH J J I u i) x) = symH (C.res-comp J J I u i x) ;
  p0 : Id (Obj J) (C.res J I (compH J J I u i) x) rux = apH {Hom J I} {Obj J} (\ w -> C.res J I w x) (comp-idr J I u) ;
  h : VT.VMap J rr rr = VT.rmap J J i rux rux g0 ;
  hEq : Id (VT.VMap J rr rr) h (VT.vid J rr) =
   transH (apH {VT.VMap J rux rux} {VT.VMap J rr rr} (\ w -> VT.rmap J J i rux rux w) (vpartCart J I u x))
    (symH (VT.rmap-id J J i rux)) ;
  inner : Id (CT.Ch J n rr z) (CT.KJ[J].K.rx n rr rr h z ch) ch =
   transH (apH {VT.VMap J rr rr} {CT.Ch J n rr z} (\ w -> CT.KJ[J].K.rx n rr rr w z ch) hEq)
    (CT.KJ[J].K.rx-id n rr z ch) ;
  -- on any chain from rr, the reindexing along cart u x is the head move
  phi (c2 : CT.Ch J n rr z) : Id (CT.Ch J n (C.res J I (compH J J I u i) x) z) (CT.rxM J J I i u rux x g0 n z c2) (CT.trCh J n rr (C.res J I (compH J J I u i) x) p1 z c2) =
   apH {CT.Ch J n rr z} {CT.Ch J n (C.res J I (compH J J I u i) x) z} (\ w -> CT.trCh J n rr (C.res J I (compH J J I u i) x) p1 z w)
    (transH (apH {VT.VMap J rr rr} {CT.Ch J n rr z} (\ w -> CT.KJ[J].K.rx n rr rr w z c2) hEq) (CT.KJ[J].K.rx-id n rr z c2)) ;
  -- hence it is injective
  phi-inj (c2 c3 : CT.Ch J n rr z)
   (e : Id (CT.Ch J n (C.res J I (compH J J I u i) x) z) (CT.rxM J J I i u rux x g0 n z c2) (CT.rxM J J I i u rux x g0 n z c3))
   : Id (CT.Ch J n rr z) c2 c3 =
   trCh-inj J n rr (C.res J I (compH J J I u i) x) p1 z c2 c3 (transH (symH (phi c2)) (transH e (phi c3))) ;
  law : Id (CT.Ch J n rux z) (CT.trCh J n (C.res J I (compH J J I u i) x) rux p0 z (CT.rxM J J I i u rux x g0 n z ch)) c =
   transH (apH {CT.Ch J n rr z} {CT.Ch J n rux z}
             (\ w -> CT.trCh J n (C.res J I (compH J J I u i) x) rux p0 z (CT.trCh J n rr (C.res J I (compH J J I u i) x) p1 z w)) inner)
    (transH (apH {CT.Ch J n (C.res J I (compH J J I u i) x) z} {CT.Ch J n rux z} (\ w -> CT.trCh J n (C.res J I (compH J J I u i) x) rux p0 z w)
               (CT.trCh-trans J n rux rr (C.res J I (compH J J I u i) x) q p1 z c))
      (transH (CT.trCh-trans J n rux (C.res J I (compH J J I u i) x) rux (transH q p1) p0 z c)
        (CT.trCh-refl J n rux (transH (transH q p1) p0) z c))) ;
 } ;

 -- two indices of the stage (W1, ry), ry = res U x, at the base W2 -w-> W1,
 -- both obtained from a chain c1 : res U x <- rz at W1:
 --   A  the restriction along w of the identity index of c1
 --   B  the image, along the cartesian map (W2, res (U w) x) -> (W1, ry)
 --      over w, of the identity index of the restricted chain
 -- Both are the chain map F of the restriction functor at c1, with its
 -- head moved.
 module Rk (W2 W1 I : Ob) (w : Hom W2 W1) (U0 : Hom W1 I) (x : Obj I) (n : Nat) (rz : Obj W1) (c1 : CT.Ch W1 n (C.res W1 I U0 x) rz) {
  ry : Obj W1 = C.res W1 I U0 x ;
  Uw : Hom W2 I = compH W2 W1 I U0 w ;
  ry' : Obj W2 = C.res W2 I Uw x ;
  rw : Obj W2 = C.res W2 W1 w ry ;
  tz : Obj W2 = C.res W2 W1 w rz ;
  ek : Id (Obj W2) rw ry' = symH (C.res-comp W2 W1 I U0 w x) ;
  F : CT.Ch W2 n rw tz = CChainsF[vl].CF[VT.VCat W1, VT.VCat W2, VT.rfun W2 W1 w].chF n ry rz c1 ;
  -- A
  qA : Id (Obj W1) ry (C.res W1 W1 (idH W1) ry) = symH (C.res-id W1 ry) ;
  qA' : Id (Obj W2) rw (C.res W2 W1 w (C.res W1 W1 (idH W1) ry)) = apH {Obj W1} {Obj W2} (\ t -> C.res W2 W1 w t) qA ;
  pA1 : Id (Obj W2) (C.res W2 W1 w (C.res W1 W1 (idH W1) ry)) (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) = symH (C.res-comp W2 W1 W1 (idH W1) w ry) ;
  pA0 : Id (Obj W2) (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) rw = apH {Hom W2 W1} {Obj W2} (\ k -> C.res W2 W1 k ry) (comp-idl W2 W1 w) ;
  cA : CT.Ch W2 n (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) tz =
   CT.rCh W2 W1 W1 w (idH W1) ry n rz (CT.trCh W1 n ry (C.res W1 W1 (idH W1) ry) qA rz c1) ;
  lawA : Id (CT.Ch W2 n rw tz) (CT.trCh W2 n (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) rw pA0 tz cA) F =
   transH (apH {CT.Ch W2 n (C.res W2 W1 w (C.res W1 W1 (idH W1) ry)) tz} {CT.Ch W2 n rw tz}
             (\ t -> CT.trCh W2 n (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) rw pA0 tz
                       (CT.trCh W2 n (C.res W2 W1 w (C.res W1 W1 (idH W1) ry)) (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) pA1 tz t))
             (CT.chF-trCh W1 W2 (VT.rfun W2 W1 w) n ry (C.res W1 W1 (idH W1) ry) qA rz c1))
    (transH (apH {CT.Ch W2 n (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) tz} {CT.Ch W2 n rw tz}
               (\ t -> CT.trCh W2 n (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) rw pA0 tz t)
               (CT.trCh-trans W2 n rw (C.res W2 W1 w (C.res W1 W1 (idH W1) ry)) (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) qA' pA1 tz F))
      (transH (CT.trCh-trans W2 n rw (C.res W2 W1 (compH W2 W1 W1 (idH W1) w) ry) rw (transH qA' pA1) pA0 tz F)
        (CT.trCh-refl W2 n rw (transH (transH qA' pA1) pA0) tz F))) ;
  -- B, at any object y equal to rw (for y = res (U w) x along res-comp)
  pB0 : Id (Obj W2) (C.res W2 W1 (compH W2 W2 W1 w (idH W2)) ry) rw = apH {Hom W2 W1} {Obj W2} (\ k -> C.res W2 W1 k ry) (comp-idr W2 W1 w) ;
  kk (y : Obj W2) (p : Id (Obj W2) rw y) : VT.HomD W2 W1 w y ry = VT.trD W2 W1 w rw y p ry (C.cart W2 W1 w ry) ;
  cB (y : Obj W2) (p : Id (Obj W2) rw y) : CT.Ch W2 n (C.res W2 W1 (compH W2 W2 W1 w (idH W2)) ry) tz =
   CT.rxM W2 W2 W1 (idH W2) w y ry (VT.vpart W2 W1 w y ry (kk y p)) n tz
    (CT.trCh W2 n y (C.res W2 W2 (idH W2) y) (symH (C.res-id W2 y)) tz (CT.trCh W2 n rw y p tz F)) ;
  lawB (y : Obj W2) (p : Id (Obj W2) rw y)
   : Id (CT.Ch W2 n rw tz) (CT.trCh W2 n (C.res W2 W1 (compH W2 W2 W1 w (idH W2)) ry) rw pB0 tz (cB y p)) F =
   idJ (Obj W2) rw (\ y2 p2 -> Id (CT.Ch W2 n rw tz) (CT.trCh W2 n (C.res W2 W1 (compH W2 W2 W1 w (idH W2)) ry) rw pB0 tz (cB y2 p2)) F)
    Cart[W2, W1, w, ry, n, tz, F].law y p ;
 } ;

 ----------------------------------------------------------------------
 -- chains under two functors that agree up to paths of objects
 -- transport of a map at both ends, of a chain at both ends
 trM (K : Ob) (y y' x x' : Obj K) (py : Id (Obj K) y y') (px : Id (Obj K) x x') (f : VT.VMap K y x) : VT.VMap K y' x' =
  VT.trD K K (idH K) y y' py x' (VT.trC K K (idH K) y x x' px f) ;
 tr2 (K : Ob) (n : Nat) (x x' z z' : Obj K) (px : Id (Obj K) x x') (pz : Id (Obj K) z z') (c : CT.Ch K n x z) : CT.Ch K n x' z' =
  subst (Obj K) (\ t -> CT.Ch K n x' t) z z' pz (CT.trCh K n x x' px z c) ;
 tr2-zero (K : Ob) (x x' z z' : Obj K) (px : Id (Obj K) x x') (pz : Id (Obj K) z z') (f : VT.VMap K z x)
  : Id (VT.VMap K z' x') (tr2 K zero x x' z z' px pz f) (trM K z z' x x' pz px f) =
  idJ (Obj K) x (\ x2 p2 -> Id (VT.VMap K z' x2) (tr2 K zero x x2 z z' p2 pz f) (trM K z z' x x2 pz p2 f))
   (idJ (Obj K) z (\ z2 q2 -> Id (VT.VMap K z2 x) (tr2 K zero x x z z2 (refl x) q2 f) (trM K z z2 x x q2 (refl x) f)) (refl f) z' pz)
   x' px ;
 tr2-suc (K : Ob) (m : Nat) (x x' z z' y y' : Obj K) (px : Id (Obj K) x x') (pz : Id (Obj K) z z') (py : Id (Obj K) y y')
  (g : VT.VMap K y x) (c' : CT.Ch K m y z)
  : Id (CT.Ch K (suc m) x' z') (tr2 K (suc m) x x' z z' px pz (y, g, c')) (y', trM K y y' x x' py px g, tr2 K m y y' z z' py pz c') =
  idJ (Obj K) x
   (\ x2 p2 -> Id (CT.Ch K (suc m) x2 z') (tr2 K (suc m) x x2 z z' p2 pz (y, g, c')) (y', trM K y y' x x2 py p2 g, tr2 K m y y' z z' py pz c'))
   (idJ (Obj K) z
     (\ z2 q2 -> Id (CT.Ch K (suc m) x z2) (tr2 K (suc m) x x z z2 (refl x) q2 (y, g, c')) (y', trM K y y' x x py (refl x) g, tr2 K m y y' z z2 py q2 c'))
     (idJ (Obj K) y
       (\ y2 r2 -> Id (CT.Ch K (suc m) x z) (y, g, c') (y2, trM K y y2 x x r2 (refl x) g, tr2 K m y y2 z z r2 (refl z) c'))
       (refl (y, g, c')) y' py)
     z' pz)
   x' px ;

 module FF (J M K : Ob) (Fa : CChainsF[vl].FunOf[VT.VCat J, VT.VCat M].SFun) (Fb : CChainsF[vl].FunOf[VT.VCat M, VT.VCat K].SFun)
   (Fc : CChainsF[vl].FunOf[VT.VCat J, VT.VCat K].SFun)
   (th : (t : Obj J) -> Id (Obj K) (Fb.onO (Fa.onO t)) (Fc.onO t))
   (thH : (y x : Obj J) (f : VT.VMap J y x)
      -> Id (VT.VMap K (Fc.onO y) (Fc.onO x)) (Fc.onH y x f)
           (trM K (Fb.onO (Fa.onO y)) (Fc.onO y) (Fb.onO (Fa.onO x)) (Fc.onO x) (th y) (th x) (Fb.onH (Fa.onO y) (Fa.onO x) (Fa.onH y x f)))) {
  module Ca = CChainsF[vl].CF[VT.VCat J, VT.VCat M, Fa] ;
  module Cb = CChainsF[vl].CF[VT.VCat M, VT.VCat K, Fb] ;
  module Cc = CChainsF[vl].CF[VT.VCat J, VT.VCat K, Fc] ;
  ab (n : Nat) (x z : Obj J) (c : CT.Ch J n x z) : CT.Ch K n (Fb.onO (Fa.onO x)) (Fb.onO (Fa.onO z)) =
   Cb.chF n (Fa.onO x) (Fa.onO z) (Ca.chF n x z c) ;
  law : (n : Nat) -> (x z : Obj J) (c : CT.Ch J n x z)
   -> Id (CT.Ch K n (Fc.onO x) (Fc.onO z)) (Cc.chF n x z c)
        (tr2 K n (Fb.onO (Fa.onO x)) (Fc.onO x) (Fb.onO (Fa.onO z)) (Fc.onO z) (th x) (th z) (ab n x z c)) = split {
   zero -> \ x z f ->
    transH (thH z x f)
     (symH (tr2-zero K (Fb.onO (Fa.onO x)) (Fc.onO x) (Fb.onO (Fa.onO z)) (Fc.onO z) (th x) (th z) (Fb.onH (Fa.onO z) (Fa.onO x) (Fa.onH z x f)))) ;
   suc m | ih -> \ x z c ->
    transH (apH {VT.VMap K (Fc.onO c.1) (Fc.onO x)} {CT.Ch K (suc m) (Fc.onO x) (Fc.onO z)} (\ g -> (Fc.onO c.1, g, Cc.chF m c.1 z c.2.2))
              (thH c.1 x c.2.1))
     (transH (apH {CT.Ch K m (Fc.onO c.1) (Fc.onO z)} {CT.Ch K (suc m) (Fc.onO x) (Fc.onO z)}
                (\ c2 -> (Fc.onO c.1,
                          trM K (Fb.onO (Fa.onO c.1)) (Fc.onO c.1) (Fb.onO (Fa.onO x)) (Fc.onO x) (th c.1) (th x) (Fb.onH (Fa.onO c.1) (Fa.onO x) (Fa.onH c.1 x c.2.1)),
                          c2))
                (ih c.1 z c.2.2))
       (symH (tr2-suc K m (Fb.onO (Fa.onO x)) (Fc.onO x) (Fb.onO (Fa.onO z)) (Fc.onO z) (Fb.onO (Fa.onO c.1)) (Fc.onO c.1) (th x) (th z) (th c.1)
                (Fb.onH (Fa.onO c.1) (Fa.onO x) (Fa.onH c.1 x c.2.1)) (ab m c.1 z c.2.2)))) } ;
 } ;

 -- restriction along a composite of base maps: the two restriction
 -- functors agree up to res-comp
 module RO (K M J : Ob) (v : Hom M J) (w : Hom K M) {
  module FFi = FF[J, M, K, VT.rfun M J v, VT.rfun K M w, VT.rfun K J (compH K M J v w),
    \ t -> symH (C.res-comp K M J v w t), \ y x f -> VT.rmap-o K M J v w y x f] ;
 } ;

 ----------------------------------------------------------------------
 -- calculus of the double transport (objects at a stage form a set)
 tr2-irr (K : Ob) (n : Nat) (x x' z z' : Obj K) (px px' : Id (Obj K) x x') (pz pz' : Id (Obj K) z z') (c : CT.Ch K n x z)
  : Id (CT.Ch K n x' z') (tr2 K n x x' z z' px pz c) (tr2 K n x x' z z' px' pz' c) =
  transH (apH {Id (Obj K) x x'} {CT.Ch K n x' z'} (\ r -> tr2 K n x x' z z' r pz c) (CT.setObj K x x' px px'))
   (apH {Id (Obj K) z z'} {CT.Ch K n x' z'} (\ r -> tr2 K n x x' z z' px' r c) (CT.setObj K z z' pz pz')) ;
 tr2-head (K : Ob) (n : Nat) (x x' x'' z z' : Obj K) (px : Id (Obj K) x x') (pz : Id (Obj K) z z') (q : Id (Obj K) x' x'') (c : CT.Ch K n x z)
  : Id (CT.Ch K n x'' z') (CT.trCh K n x' x'' q z' (tr2 K n x x' z z' px pz c)) (tr2 K n x x'' z z' (transH px q) pz c) =
  idJ (Obj K) x'
   (\ x2 q2 -> Id (CT.Ch K n x2 z') (CT.trCh K n x' x2 q2 z' (tr2 K n x x' z z' px pz c)) (tr2 K n x x2 z z' (transH px q2) pz c))
   (tr2-irr K n x x' z z' px (transH px (refl x')) pz pz c) x'' q ;
 tr2-tail (K : Ob) (n : Nat) (x x' z z' z'' : Obj K) (px : Id (Obj K) x x') (pz : Id (Obj K) z z') (q : Id (Obj K) z' z'') (c : CT.Ch K n x z)
  : Id (CT.Ch K n x' z'') (subst (Obj K) (\ t -> CT.Ch K n x' t) z' z'' q (tr2 K n x x' z z' px pz c)) (tr2 K n x x' z z'' px (transH pz q) c) =
  idJ (Obj K) z'
   (\ z2 q2 -> Id (CT.Ch K n x' z2) (subst (Obj K) (\ t -> CT.Ch K n x' t) z' z2 q2 (tr2 K n x x' z z' px pz c)) (tr2 K n x x' z z2 px (transH pz q2) c))
   (tr2-irr K n x x' z z' px px pz (transH pz (refl z')) c) z'' q ;

 -- restricting twice is restricting along the composite, up to the
 -- associativity of the base on the head and res-comp on the tail
 module RC2 (W2 W1 J I : Ob) (w : Hom W2 W1) (v : Hom W1 J) (u : Hom J I) (x : Obj I) (n : Nat) (z : Obj J) (c : CT.Ch J n (C.res J I u x) z) {
  module RF = RO[W2, W1, J, v, w] ;
  uv : Hom W1 I = compH W1 J I u v ;
  vw : Hom W2 J = compH W2 W1 J v w ;
  rux : Obj J = C.res J I u x ;
  rz : Obj W1 = C.res W1 J v z ;
  H0 : Obj W2 = C.res W2 W1 w (C.res W1 J v rux) ;
  T0 : Obj W2 = C.res W2 W1 w rz ;
  X0 : CT.Ch W2 n H0 T0 = RF.FFi.ab n rux z c ;
  hL : Obj W2 = C.res W2 I (compH W2 W1 I uv w) x ;
  hR : Obj W2 = C.res W2 I (compH W2 J I u vw) x ;
  tR : Obj W2 = C.res W2 J vw z ;
  p1 : Id (Obj W1) (C.res W1 J v rux) (C.res W1 I uv x) = symH (C.res-comp W1 J I u v x) ;
  p1' : Id (Obj W2) H0 (C.res W2 W1 w (C.res W1 I uv x)) = apH {Obj W1} {Obj W2} (\ t -> C.res W2 W1 w t) p1 ;
  p2 : Id (Obj W2) (C.res W2 W1 w (C.res W1 I uv x)) hL = symH (C.res-comp W2 W1 I uv w x) ;
  pa : Id (Obj W2) hL hR = apH {Hom W2 I} {Obj W2} (\ k -> C.res W2 I k x) (comp-assoc W2 W1 J I u v w) ;
  p3 : Id (Obj W2) (C.res W2 J vw rux) hR = symH (C.res-comp W2 J I u vw x) ;
  et : Id (Obj W2) tR T0 = C.res-comp W2 W1 J v w z ;
  lhs : CT.Ch W2 n hR T0 = CT.trCh W2 n hL hR pa T0 (CT.rCh W2 W1 I w uv x n rz (CT.rCh W1 J I v u x n z c)) ;
  rhs : CT.Ch W2 n hR T0 = subst (Obj W2) (\ t -> CT.Ch W2 n hR t) tR T0 et (CT.rCh W2 J I vw u x n z c) ;
  eL : Id (CT.Ch W2 n hR T0) lhs (tr2 W2 n H0 hR T0 T0 (transH (transH p1' p2) pa) (refl T0) X0) =
   transH (apH {CT.Ch W2 n (C.res W2 W1 w (C.res W1 I uv x)) T0} {CT.Ch W2 n hR T0}
             (\ t -> CT.trCh W2 n hL hR pa T0 (CT.trCh W2 n (C.res W2 W1 w (C.res W1 I uv x)) hL p2 T0 t))
             (CT.chF-trCh W1 W2 (VT.rfun W2 W1 w) n (C.res W1 J v rux) (C.res W1 I uv x) p1 rz
                (CChainsF[vl].CF[VT.VCat J, VT.VCat W1, VT.rfun W1 J v].chF n rux z c)))
    (transH (apH {CT.Ch W2 n hL T0} {CT.Ch W2 n hR T0} (\ t -> CT.trCh W2 n hL hR pa T0 t)
               (tr2-head W2 n H0 (C.res W2 W1 w (C.res W1 I uv x)) hL T0 T0 p1' (refl T0) p2 X0))
      (tr2-head W2 n H0 hL hR T0 T0 (transH p1' p2) (refl T0) pa X0)) ;
  eR : Id (CT.Ch W2 n hR T0) rhs
        (tr2 W2 n H0 hR T0 T0 (transH (symH (C.res-comp W2 W1 J v w rux)) p3) (transH (symH (C.res-comp W2 W1 J v w z)) et) X0) =
   transH (apH {CT.Ch W2 n (C.res W2 J vw rux) tR} {CT.Ch W2 n hR T0}
             (\ t -> subst (Obj W2) (\ t2 -> CT.Ch W2 n hR t2) tR T0 et (CT.trCh W2 n (C.res W2 J vw rux) hR p3 tR t))
             (RF.FFi.law n rux z c))
    (transH (apH {CT.Ch W2 n hR tR} {CT.Ch W2 n hR T0} (\ t -> subst (Obj W2) (\ t2 -> CT.Ch W2 n hR t2) tR T0 et t)
               (tr2-head W2 n H0 (C.res W2 J vw rux) hR T0 tR (symH (C.res-comp W2 W1 J v w rux)) (symH (C.res-comp W2 W1 J v w z)) p3 X0))
      (tr2-tail W2 n H0 hR T0 tR T0 (transH (symH (C.res-comp W2 W1 J v w rux)) p3) (symH (C.res-comp W2 W1 J v w z)) et X0)) ;
  law : Id (CT.Ch W2 n hR T0) lhs rhs =
   transH eL
    (transH (tr2-irr W2 n H0 hR T0 T0 (transH (transH p1' p2) pa) (transH (symH (C.res-comp W2 W1 J v w rux)) p3)
               (refl T0) (transH (symH (C.res-comp W2 W1 J v w z)) et) X0)
       (symH eR)) ;
 } ;

 -- the face of a chain with its head moved
 fc-trCh (J : Ob) (n k : Nat) (x x' : Obj J) (p : Id (Obj J) x x') (z : Obj J) (c : CT.Ch J (suc n) x z)
  : Id (CT.KJ[J].K.DR n x' z) (CT.KJ[J].K.fc n k x' z (CT.trCh J (suc n) x x' p z c))
      ((CT.KJ[J].K.fc n k x z c).1, CT.trCh J n x x' p (CT.KJ[J].K.fc n k x z c).1 (CT.KJ[J].K.fc n k x z c).2.1, (CT.KJ[J].K.fc n k x z c).2.2) =
  idJ (Obj J) x
   (\ x2 p2 -> Id (CT.KJ[J].K.DR n x2 z) (CT.KJ[J].K.fc n k x2 z (CT.trCh J (suc n) x x2 p2 z c))
      ((CT.KJ[J].K.fc n k x z c).1, CT.trCh J n x x2 p2 (CT.KJ[J].K.fc n k x z c).1 (CT.KJ[J].K.fc n k x z c).2.1, (CT.KJ[J].K.fc n k x z c).2.2))
   (refl (CT.KJ[J].K.fc n k x z c)) x' p ;
} ;

-- the chain map of a functor commutes with the uniform faces
module CFc (Cs Ds : SmallCat[vl].SmallCat) (F : CChainsF[vl].FunOf[Cs, Ds].SFun) {
 module CF = CChainsF[vl].CF[Cs, Ds, F] ;
 module KC = CF.KC ;
 module KD = CF.KD ;
 chF-fc : (n : Nat) -> (k : Nat) -> (x z : KC.CO) (c : KC.Ch (suc n) x z)
  -> Id (KD.DR n (F.onO x) (F.onO z)) (CF.DRF n x z (KC.fc n k x z c)) (KD.fc n k (F.onO x) (F.onO z) (CF.chF (suc n) x z c)) = split {
  zero -> split {
   zero -> \ x z c -> KD.drEq zero (F.onO x) (F.onO z) (F.onO z)
     (CF.chF zero x z (KC.comp zero zero x z c)) (KD.comp zero zero (F.onO x) (F.onO z) (CF.chF (suc zero) x z c))
     (F.onH z z (Cs.idC z)) (Ds.idC (F.onO z)) (CF.chF-comp zero zero x z c) (F.onId z) ;
   suc k -> \ x z c -> CF.chF-drop zero x z c } ;
  suc m | r -> split {
   zero -> \ x z c -> KD.drEq (suc m) (F.onO x) (F.onO z) (F.onO z)
     (CF.chF (suc m) x z (KC.comp (suc m) zero x z c)) (KD.comp (suc m) zero (F.onO x) (F.onO z) (CF.chF (suc (suc m)) x z c))
     (F.onH z z (Cs.idC z)) (Ds.idC (F.onO z)) (CF.chF-comp (suc m) zero x z c) (F.onId z) ;
   suc k -> \ x z c -> apH {KD.DR m (F.onO c.1) (F.onO z)} {KD.DR (suc m) (F.onO x) (F.onO z)}
     (\ D -> KD.liftD m (F.onO x) (F.onO c.1) (F.onO z) (F.onH c.1 x c.2.1) D) (r k c.1 z c.2.2) } } ;
} ;
