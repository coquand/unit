-- CSEl.seg (canonicity-c2): elements of the quotient fibre S (CQSurj: over
-- nil.Q, S = Sigma t. cls t = q) at any context: from q, t and an Id
-- cls t = q over C, an element of S[q] over C (the pattern of CQSurj.sp).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module SE (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module QS = CQSurj[a].QSurj[R, encK, pe, y] ;
 Nl : C.Ctx = C.nil ;
 Q : C.Ty Nl = QS.Qt ;
 Tm : C.Ty Nl = QS.Tm ;
 -- cls as a natural map
 cv (K : Ob) (o : Top) (t : V1.Ix (Tm.1.tob K o)) : V1.Ix (Q.1.tob K o) = QS.QQ.cls.eob K (o, t) ;
 cvN (J I : Ob) (f : Hom J I) (x x' : Top) (e : Id Top (Nl.act J I f x) x') (t : V1.Ix (Tm.1.tob I x))
   : Id (V1.Ix (Q.1.tob J x')) (Q.1.tact J I f x x' e (cv I x t)) (cv J x' (Tm.1.tact J I f x x' e t)) =
  transH (L.tact-irr Nl Q.1 J I f x x' e
           (L.ntEq QS.D1 Nl (L.pP Nl Tm.1) J I f (x, t) (x', Tm.1.tact J I f x x' e t) (L.pair-act Nl Tm.1 J I f x x' e t)) (cv I x t))
   (QS.QQ.cls.enat J I f (x, t) (x', Tm.1.tact J I f x x' e t) (L.pair-act Nl Tm.1 J I f x x' e t)) ;
 clsN : HO.NMap[Nl, Tm.1, Q.1] = new HO.NMap[Nl, Tm.1, Q.1, cv, cvN] ;
 clsS (G : C.Ctx) (s0 : C.Sub G Nl) (tv : C.El G (C.subT G Nl Tm s0)) : C.El G (C.subT G Nl Q s0) = CInjP[a].IP[Tm, Q, clsN].evS G s0 tv ;
 module At (G : C.Ctx) (s0 : C.Sub G Nl) (tv : C.El G (C.subT G Nl Tm s0)) (qv : C.El G (C.subT G Nl Q s0))
   (e : C.El G (IJ.IdT G (C.subT G Nl Q s0) (clsS G s0 tv) qv)) {
  QG : C.Ty G = C.subT G Nl Q s0 ;
  sg : C.Sub G QS.G1 = CQSurj[a].Ex[C].exS G Nl Q s0 qv ;
  X' : C.Ty G = C.subT G QS.G1 QS.TmG sg ;
  PX : Id (C.Ty G) (C.subT G Nl Tm s0) X' =
   transH (apH {C.Sub G Nl} {C.Ty G} (\ s -> C.subT G Nl Tm s) (symH (INm.p-extS G Nl Q s0 qv))) (C.subT-o G QS.G1 Nl Tm (C.p Nl Q) sg) ;
  xv : C.El G X' = OV.trE G (C.subT G Nl Tm s0) X' PX tv ;
  xvrd (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (X'.1.tob K w)) (xv.eob K w) (tv.eob K w) =
   transH (CAppRd[a].trE-rd G (C.subT G Nl Tm s0) X' PX tv K w) (CAppRd[a].same-rd G (C.subT G Nl Tm s0) X' PX K w (refl (X'.1.tob K w)) (tv.eob K w)) ;
  lf : C.Sub (C.ext G X') QS.E = C.lift G QS.G1 QS.TmG sg ;
  rho : C.Sub G QS.E = C.o G (C.ext G X') QS.E lf (C.sec G X' xv) ;
  Y' : C.Ty (C.ext G X') = C.subT (C.ext G X') QS.E QS.IdE lf ;
  Tr0 : C.Ty G = C.subT G QS.E QS.T0 rho ;
  PT0 : Id (C.Ty G) Tr0 QG =
   transH (apH {C.Ty QS.E} {C.Ty G} (\ X -> C.subT G QS.E X rho) (symH (C.subT-o QS.E QS.G1 Nl Q (C.p Nl Q) QS.pE))) (transH (symH (C.subT-o G QS.E Nl Q (C.o QS.E QS.G1 Nl (C.p Nl Q) QS.pE) rho))
    (apH {C.Sub G Nl} {C.Ty G} (\ s -> C.subT G Nl Q s) (L.sub-ext G Nl (C.o G QS.E Nl (C.o QS.E QS.G1 Nl (C.p Nl Q) QS.pE) rho) s0 (\ K w -> refl (s0.nt K w))))) ;
  ca (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (Tr0.1.tob K w)) ((OV.trE G QG Tr0 (symH PT0) (clsS G s0 tv)).eob K w) ((C.subt G QS.E QS.T0 QS.clsE rho).eob K w) =
   transH (CAppRd[a].trE-rd G QG Tr0 (symH PT0) (clsS G s0 tv) K w)
    (transH (CAppRd[a].same-rd G QG Tr0 (symH PT0) K w (refl (Tr0.1.tob K w)) ((clsS G s0 tv).eob K w))
      (symH (transH (CAppRd[a].trE-rd QS.E (C.subT QS.E QS.D1 (OV.wkT Nl Tm Q) QS.sg) QS.T0 QS.PC (C.subt QS.E QS.D1 (OV.wkT Nl Tm Q) QS.QQ.cls QS.sg) K (rho.nt K w))
         (transH (CAppRd[a].same-rd QS.E (C.subT QS.E QS.D1 (OV.wkT Nl Tm Q) QS.sg) QS.T0 QS.PC K (rho.nt K w) (refl (QS.T0.1.tob K (rho.nt K w))) (QS.QQ.cls.eob K (QS.sgN K (rho.nt K w))))
           (apH {V1.Ix (Tm.1.tob K (s0.nt K w))} {V1.Ix (Q.1.tob K (s0.nt K w))} (\ s -> QS.QQ.cls.eob K (s0.nt K w, s)) (xvrd K w)))))) ;
  cb (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (Tr0.1.tob K w)) ((OV.trE G QG Tr0 (symH PT0) qv).eob K w) ((C.subt G QS.E QS.T0 QS.qE rho).eob K w) =
   transH (CAppRd[a].trE-rd G QG Tr0 (symH PT0) qv K w) (CAppRd[a].same-rd G QG Tr0 (symH PT0) K w (refl (Tr0.1.tob K w)) (qv.eob K w)) ;
  r1 : C.El G (IJ.IdT G Tr0 (C.subt G QS.E QS.T0 QS.clsE rho) (C.subt G QS.E QS.T0 QS.qE rho)) =
   CCmpU14[a].rwId G Tr0 (OV.trE G QG Tr0 (symH PT0) (clsS G s0 tv)) (C.subt G QS.E QS.T0 QS.clsE rho) (OV.trE G QG Tr0 (symH PT0) qv) (C.subt G QS.E QS.T0 QS.qE rho) ca cb
    (CInjP[a].idFwdL G QG Tr0 (symH PT0) (clsS G s0 tv) qv e) ;
  yv : C.El G (C.subT G (C.ext G X') Y' (C.sec G X' xv)) =
   OV.trE G (C.subT G QS.E QS.IdE rho) (C.subT G (C.ext G X') Y' (C.sec G X' xv)) (C.subT-o G (C.ext G X') QS.E QS.IdE lf (C.sec G X' xv))
    (OV.trE G (IJ.IdT G Tr0 (C.subt G QS.E QS.T0 QS.clsE rho) (C.subt G QS.E QS.T0 QS.qE rho)) (C.subT G QS.E QS.IdE rho) (symH (IJ.IdT-nat G QS.E QS.T0 QS.clsE QS.qE rho)) r1) ;
  sp : C.El G (C.subT G QS.G1 QS.S sg) =
   OV.trE G (SS.Sig G X' Y') (C.subT G QS.G1 QS.S sg) (symH (FibCwF[a, a+].fibSig.Sig-nat G QS.G1 QS.TmG QS.IdE sg)) (INm.pr G X' Y' xv yv) ;
 } ;
} ;
