-- CPshPiFibN.seg (canonicity-c2; COBAR.md (B) stage 2(c), M2): the
-- components of the composition of (Pi_A B)_x are the base's compositions
-- of the products Pi_y (CPi.PiC), moved along act f (CFibSub); the family
-- of composites is natural in C (NatComp) and uniform in C.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module NOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module FB = CPshPiFib[a, l].FibOf[C] ;
 open P ;

 module Nd (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (x : CO) (d : Bool)
  (kA : (y : CO) -> CL.Lines[G.ob y, A.ty y].Fill (PB.tgt d))
  (cB : (y : CO) -> CL.Lines[extP (G.ob y) (A.ty y), B.ty y].CompK[PB.src d, PB.tgt d].Comp) {
  module F = FB.Fr[G, A, B, x, PB.src d, PB.tgt d] ;
  module PC = F.PC ;

  -- the component compositions
  module AtY (y : CO) (f : CH y x) {
   module PiK = PB.CPi[l].PiC[G.ob y, A.ty y, B.ty y, d, kA y, cB y] ;
   module FS = PB.CFibSub[l].FibSub[F.Gx, G.ob y, G.act y x f, PC.PiB y].C.MoveComp[PB.src d, PB.tgt d] ;
   cT : F.Cm[y, f].CKT.Comp = FS.move PiK.comp ;
  } ;
  cT (y : CO) (f : CH y x) : F.Cm[y, f].CKT.Comp = AtY[y, f].cT ;
  module Cq = F.Cp[cT] ;

  -- the component (y , f) of the composite is the base composite at the
  -- moved data
  module Val (X : Ob) (w : F.CKP.EK.TV.EI X) (p : F.CKP.EK.PT.Side[X, w]) (y : CO) (f : CH y x) {
   module Ay = AtY[y, f] ;
   module Cm = F.Cm[y, f] ;
   wT : Cm.CKT.EK.TV.EI X = Cm.M.tvM X w ;
   pT : Cm.CKT.EK.PT.Side[X, wT] = Cm.M.mapS X w p ;
   u : W0.Ix ((F.TT y f).tob X (F.gE X w)) = Cq.kcomp X w p y f ;
   wY : Ay.PiK.KP.TV.EI X = Ay.FS.E.sV X wT ;
   pY : Ay.PiK.KP.PT.Side[X, wY] = Ay.FS.mside Ay.PiK.comp X wT pT ;
   module CX = Ay.PiK.CopX[X, wY, pY] ;
   mv : Id (Ay.FS.TT.EI X) (Ay.FS.mT X (Ay.FS.TT'.pr X wT u)) (Ay.FS.TT.pr X wY CX.cop) = Ay.FS.kopMv Ay.PiK.comp X wT pT ;
   compE : Id (Ay.PiK.TP.EI X) (Ay.PiK.TP.pr X ((G.act y x f).nt X (F.gE X w)) u) (Ay.PiK.TP.pr X CX.xT CX.cop) =
    transH (symH (Ay.FS.E'.sVE X (Ay.FS.CK'.SE.mV X (Ay.FS.TT'.pr X wT u)))) (apH (\ t -> Ay.PiK.rdP X t) mv) ;

   -- its value at (h , a0): the reading of the composite of the
   -- B-problem (CPi.Prob) at the restricted data
   module VK (K : Ob) (h : Hom K X) (a0 : PC.At[x, X, F.gE X w].FA y f K h) {
    module S = PC.At[x, X, F.gE X w] ;
    pX : Id (W0.Ix ((G.ob y).ob X)) ((G.act y x f).nt X (F.gE X w)) CX.xT = apH (\ t -> Ay.PiK.TP.pr1 X t) compE ;
    a1 : W0.Ix ((A.ty y).tob K ((G.ob y).act K X h CX.xT)) =
     GPR.TyL[G.ob y, A.ty y].coeT K (S.ptH y f K h) ((G.ob y).act K X h CX.xT) (apH (\ q -> (G.ob y).act K X h q) pX) a0 ;
    a1-pr : Id (PC.TA y K) (PC.prA y K (S.ptH y f K h) a0) (PC.prA y K ((G.ob y).act K X h CX.xT) a1) =
     GPR.TyL[G.ob y, A.ty y].pr-coe K (S.ptH y f K h) ((G.ob y).act K X h CX.xT) (apH (\ q -> (G.ob y).act K X h q) pX) a0 ;
    wK : Ay.PiK.KP.TV.EI K = Ay.PiK.KP.TV.E.act K X h wY ;
    pK : Ay.PiK.KP.PT.Side[K, wK] = Ay.PiK.KP.PT.rside K X h wY pY ;
    module Pr = Ay.PiK.Prob[K, wK, pK, CX.vK K h a1] ;
    -- the start of the restricted Pi-line is the projection of the start
    -- tK of the restricted line of (Pi_A B)_x
    wr : F.CKP.EK.TV.EI K = F.CKP.EK.TV.E.act K X h w ;
    tK : F.TP.EI K = F.CKP.EK.endE K wr ;
    wKe : Id (Ay.PiK.KP.TV.EI K) wK (Ay.FS.E.sV K (Cm.M.tvM K wr)) =
     transH (symH (Ay.FS.E.sV-nat K X h wT)) (apH (\ t -> Ay.FS.E.sV K t) (symH (Cm.M.tvM-act K X h w))) ;
    x0 : W0.Ix ((G.ob y).ob K) = (CL.FC[G.ob y].ev (PB.src d)).nt K (Ay.PiK.KP.TV.pr1 K wK) ;
    Q0 : Id (Ay.PiK.TP.EI K) (Ay.PiK.TP.pr K x0 (Ay.PiK.KP.TV.pr2 K wK))
          (Ay.PiK.TP.pr K ((G.act y x f).nt K (fstE F.Gx F.PiX K tK)) ((sndE F.Gx F.PiX K tK).1 y f)) =
     transH (apH (\ t -> Ay.PiK.KP.endE K t) wKe)
      (transH (Ay.FS.E.sVE K (Cm.M.tvM K wr))
        (apH (\ t -> PB.CSub[l].SubE[F.Gx, G.ob y, G.act y x f, PC.PiB y].mV K t) (Cm.M.tvM-E K wr))) ;
    v1 : Id (PC.TB y K) (S.valT (Cq.kcomp X w p) y f K h a0) (Ay.PiK.PE.valE X CX.xT CX.cop K h a1) =
     Ay.PiK.PE.valE-PiE X ((G.act y x f).nt X (F.gE X w)) CX.xT u CX.cop compE K h a0 a1 a1-pr ;
    res : Id (PC.TB y K) (S.valT (Cq.kcomp X w p) y f K h a0) (Ay.PiK.rdB K (Ay.PiK.TTB.pr K Pr.wB Pr.bB)) =
     transH v1 (transH (CX.cop-val K h a1) Pr.value-E) ;
   } ;
  } ;

  ------------------------------------------------------------------
  -- naturality in C of the composites, from the uniformity of the
  -- compositions of B once the B-problem moves (its point: ptB, its
  -- side: sdB)

  module SFa = LO.SF[G, A, PB.tgt d] ;
  module NC
   (kAU : P.Unif[SFa.TVC, SFa.SFC, SFa.SFC, \ y -> CP.pmap-id (SFa.TVC.ob y) (SFa.SFC.ty y), kA].CUnif)
   (cBU : LO.UF[LO.ExtC G A, B].UComp (PB.src d) (PB.tgt d) cB) {
   module FUB = CPshFillU[a, l].FillUOf[C].FU[LO.ExtC G A, B, d, cB, cBU] ;

   module At2 (X : Ob) (w : F.CKP.EK.TV.EI X) (p : F.CKP.EK.PT.Side[X, w])
    (z y : CO) (g : CH z y) (f : CH y x) (K : Ob) (h : Hom K X) (a0 : PC.At[x, X, F.gE X w].FA y f K h) {
    module S = PC.At[x, X, F.gE X w] ;
    module Vy = Val[X, w, p, y, f].VK[K, h, a0] ;
    module Vz = Val[X, w, p, z, co z y x f g].VK[K, h, S.aM z y g f K h a0] ;
    module Ky = AtY[y, f].PiK ;
    module Kz = AtY[z, co z y x f g].PiK ;
    tvB (u : Ky.KB.TV.EI K) : Kz.KB.TV.EI K = FUB.tv z y g K u ;
    msB : Kz.KB.PT.Side[K, tvB Vy.Pr.wB] = FUB.MSd[z, y, g].M.mapside K Vy.Pr.wB Vy.Pr.pB ;

    ----------------------------------------------------------------
    -- L2: the reverse A-filler moves (uniformity of kA at the empty side)
    module VY = Val[X, w, p, y, f] ;
    module VZ = Val[X, w, p, z, co z y x f g] ;
    tvA (u : Ky.KAe.TV.EI K) : Kz.KAe.TV.EI K = LO.AE[G, A, PB.tgt d].tEv z y g K u ;
    lnE : Id (W0.Ix (CL.FC[G.ob z].ob K)) (Kz.KAe.TV.pr1 K (tvA Vy.Pr.xA)) (Kz.KAe.TV.pr1 K Vz.Pr.xA) =
     CL.FC[G.ob z].fam-eq K (Kz.KAe.TV.pr1 K (tvA Vy.Pr.xA)) (Kz.KAe.TV.pr1 K Vz.Pr.xA)
      (\ W g' i -> symH (G.act-o z y x f g W ((F.CKP.EK.TV.pr1 X w).1 W (compH W K X h g') i))) ;
    endA : Id (PC.TA z K) (Kz.KAe.endE K (tvA Vy.Pr.xA)) (Kz.KAe.endE K Vz.Pr.xA) =
     transH (LO.AE[G, A, PB.tgt d].endEv z y g K Vy.Pr.xA)
      (transH (apH (\ t -> (A.tE z y g).nt K t) (transH (symH (VY.CX.vK-E K h Vy.a1)) (symH Vy.a1-pr)))
        (transH (S.aM-mv z y g f K h a0) (transH Vz.a1-pr (VZ.CX.vK-E K h Vz.a1)))) ;
    ptA : Id (Kz.KAe.TV.EI K) (tvA Vy.Pr.xA) Vz.Pr.xA = Kz.KAe.tv-eq K (tvA Vy.Pr.xA) Vz.Pr.xA lnE endA ;
    msA : Kz.KAe.PT.Side[K, tvA Vy.Pr.xA] = MapSide[SFa.TVC, SFa.SFC, z, y, g].mapside K Vy.Pr.xA (Ky.emptyP K Vy.Pr.xA) ;
    sdA : Id (Kz.KAe.PT.Side[K, Vz.Pr.xA]) (subst (Kz.KAe.TV.EI K) (\ t -> Kz.KAe.PT.Side[K, t]) (tvA Vy.Pr.xA) Vz.Pr.xA ptA msA) (Kz.emptyP K Vz.Pr.xA) =
     Kz.KAe.PT.side-extH K (tvA Vy.Pr.xA) Vz.Pr.xA ptA msA (Kz.emptyP K Vz.Pr.xA) (refl (PB.emptyS K))
      (\ W f' i i' -> absurd _ (PB.empty-lands W K f' i)) ;
    eLa : Id (Kz.KAe.TS.EI K)
           (SFa.tES z y g K (Ky.KAe.TS.pr K Vy.Pr.xA ((kA y).kop K Vy.Pr.xA (Ky.emptyP K Vy.Pr.xA))))
           (Kz.KAe.TS.pr K Vz.Pr.xA ((kA z).kop K Vz.Pr.xA (Kz.emptyP K Vz.Pr.xA))) =
     transH (kAU z y g K Vy.Pr.xA (Ky.emptyP K Vy.Pr.xA))
      (Kz.RCA.kop-cong (kA z) K (tvA Vy.Pr.xA) Vz.Pr.xA ptA msA (Kz.emptyP K Vz.Pr.xA) sdA) ;
    -- the values of the A-line at z are those at y, moved
    LaC (W : Ob) (g' : Hom W K) (i : Hom W Iv)
     : Id (PC.TA z W) ((A.tE z y g).nt W (Vy.Pr.La.1.1 W g' i)) (Vz.Pr.La.1.1 W g' i) =
     apH (\ t -> Kz.KAe.lv K t W g' i) eLa ;

    ----------------------------------------------------------------
    -- L3: the point of the B-problem moves
    gK : W0.Ix (F.Gx.ob K) = fstE F.Gx F.PiX K Vy.tK ;
    uK : PC.At[x, K, gK].PiIx = sndE F.Gx F.PiX K Vy.tK ;
    module Ap = CPshPiAp[a, l].ApOf[C].L[G, A, B].At[x, K, gK, uK] ;
    way : PC.TA y K = Vy.Pr.La.1.1 K (idH K) (PB.ptH K (PB.src d)) ;
    waz : PC.TA z K = Vz.Pr.La.1.1 K (idH K) (PB.ptH K (PB.src d)) ;
    q1y : Id (W0.Ix ((G.ob y).ob K)) ((G.ob y).act K K (idH K) ((G.act y x f).nt K gK)) (fstE (G.ob y) (A.ty y) K way) =
     transH (apH (\ t -> (G.ob y).act K K (idH K) (Ky.TP.pr1 K t)) (symH Vy.Q0)) Vy.Pr.ps ;
    q1z : Id (W0.Ix ((G.ob z).ob K)) ((G.ob z).act K K (idH K) ((G.act z x (co z y x f g)).nt K gK)) (fstE (G.ob z) (A.ty z) K waz) =
     transH (apH (\ t -> (G.ob z).act K K (idH K) (Kz.TP.pr1 K t)) (symH Vz.Q0)) Vz.Pr.ps ;
    qz' : Id (W0.Ix ((G.ob z).ob K)) ((G.ob z).act K K (idH K) ((G.act z x (co z y x f g)).nt K gK))
           (fstE (G.ob z) (A.ty z) K ((A.tE z y g).nt K way)) =
     transH q1z (apH (\ t -> fstE (G.ob z) (A.ty z) K t) (symH (LaC K (idH K) (PB.ptH K (PB.src d))))) ;
    a1y : Id (PC.TB y K) (Ky.KB.endE K Vy.Pr.wB)
           (Ky.TB.pr K way (Ky.PE.apW K ((G.act y x f).nt K gK) (uK.1 y f) K (idH K) way q1y)) =
     Ky.PE.apW-gen K Vy.x0 ((G.act y x f).nt K gK) (Ky.KP.TV.pr2 K Vy.wK) (uK.1 y f) Vy.Q0 K (idH K) way way (refl way) Vy.Pr.ps q1y ;
    a1z : Id (PC.TB z K) (Kz.KB.endE K Vz.Pr.wB)
           (Kz.TB.pr K waz (Kz.PE.apW K ((G.act z x (co z y x f g)).nt K gK) (uK.1 z (co z y x f g)) K (idH K) waz q1z)) =
     Kz.PE.apW-gen K Vz.x0 ((G.act z x (co z y x f g)).nt K gK) (Kz.KP.TV.pr2 K Vz.wK) (uK.1 z (co z y x f g)) Vz.Q0 K (idH K) waz waz (refl waz) Vz.Pr.ps q1z ;
    a2 : Id (PC.TB z K)
          ((B.tE z y g).nt K (Ky.TB.pr K way (Ky.PE.apW K ((G.act y x f).nt K gK) (uK.1 y f) K (idH K) way q1y)))
          (Kz.TB.pr K ((A.tE z y g).nt K way)
             (Kz.PE.apW K ((G.act z x (co z y x f g)).nt K gK) (uK.1 z (co z y x f g)) K (idH K) ((A.tE z y g).nt K way) qz')) =
     Ap.apC z y g f K (idH K) way q1y qz' ;
    a3 : Id (PC.TB z K)
          (Kz.TB.pr K ((A.tE z y g).nt K way)
             (Kz.PE.apW K ((G.act z x (co z y x f g)).nt K gK) (uK.1 z (co z y x f g)) K (idH K) ((A.tE z y g).nt K way) qz'))
          (Kz.TB.pr K waz (Kz.PE.apW K ((G.act z x (co z y x f g)).nt K gK) (uK.1 z (co z y x f g)) K (idH K) waz q1z)) =
     Kz.PE.apW-gen K ((G.act z x (co z y x f g)).nt K gK) ((G.act z x (co z y x f g)).nt K gK) (uK.1 z (co z y x f g)) (uK.1 z (co z y x f g))
      (refl (Kz.TP.pr K ((G.act z x (co z y x f g)).nt K gK) (uK.1 z (co z y x f g))))
      K (idH K) ((A.tE z y g).nt K way) waz (LaC K (idH K) (PB.ptH K (PB.src d))) qz' q1z ;
    lnB : Id (W0.Ix (CL.FC[extP (G.ob z) (A.ty z)].ob K)) (Kz.KB.TV.pr1 K (tvB Vy.Pr.wB)) (Kz.KB.TV.pr1 K Vz.Pr.wB) =
     CL.FC[extP (G.ob z) (A.ty z)].fam-eq K (Kz.KB.TV.pr1 K (tvB Vy.Pr.wB)) (Kz.KB.TV.pr1 K Vz.Pr.wB) (\ W g' i -> LaC W g' i) ;
    endB : Id (PC.TB z K) (Kz.KB.endE K (tvB Vy.Pr.wB)) (Kz.KB.endE K Vz.Pr.wB) =
     transH (FUB.AEe.endEv z y g K Vy.Pr.wB)
      (transH (apH (\ t -> (B.tE z y g).nt K t) a1y) (transH a2 (transH a3 (symH a1z)))) ;
    ptB : Id (Kz.KB.TV.EI K) (tvB Vy.Pr.wB) Vz.Pr.wB = Kz.KB.tv-eq K (tvB Vy.Pr.wB) Vz.Pr.wB lnB endB ;

    module Core (pB0 : Id (Kz.KB.TV.EI K) (tvB Vy.Pr.wB) Vz.Pr.wB)
     (sB0 : Id (Kz.KB.PT.Side[K, Vz.Pr.wB]) (subst (Kz.KB.TV.EI K) (\ t -> Kz.KB.PT.Side[K, t]) (tvB Vy.Pr.wB) Vz.Pr.wB pB0 msB) Vz.Pr.pB) {
     c1 : Id (PC.TB z K) ((B.tE z y g).nt K (Ky.rdB K (Ky.TTB.pr K Vy.Pr.wB Vy.Pr.bB)))
           (Kz.rdB K (FUB.SCe.tEs z y g K (Ky.TTB.pr K Vy.Pr.wB Vy.Pr.bB))) =
      symH (FUB.rdC z y g K (Ky.TTB.pr K Vy.Pr.wB Vy.Pr.bB)) ;
     c2 : Id (Kz.TTB.EI K) (FUB.SCe.tEs z y g K (Ky.TTB.pr K Vy.Pr.wB Vy.Pr.bB)) (Kz.TTB.pr K Vz.Pr.wB Vz.Pr.bB) =
      transH (cBU z y g K Vy.Pr.wB Vy.Pr.pB)
       (Kz.RCB.kop-cong (cB z) K (tvB Vy.Pr.wB) Vz.Pr.wB pB0 msB Vz.Pr.pB sB0) ;
     res : S.CNatAt (Cq.kcomp X w p) z y g f K h a0 =
      transH (apH (\ t -> (B.tE z y g).nt K t) Vy.res)
       (transH c1 (transH (apH (\ t -> Kz.rdB K t) c2) (symH Vz.res))) ;
    } ;
   } ;
  } ;
 } ;
} ;
