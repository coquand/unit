-- CPshPiFibN.seg (canonicity-c2; COBAR.md (B) stage 2(c), M2): the
-- components of the composition of (Pi_A B)_x are the base's compositions
-- of the products Pi_y (CPi.PiC), moved along act f (CFibSub); the family
-- of composites is natural in C (NatComp) and uniform in C.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module NOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module FB = CPshPiFib[a, l].FibOf[C] ;
 open P ;

 module Nd (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (x : CO) (d : Bool)
  (kA : (y : CO) -> CL.Lines[G.ob y, A.ty y].Fill (PB.tgt d))
  (cB : (y : CO) -> CL.Lines[extP (G.ob y) (A.ty y), B.ty y].CompK[PB.src d, PB.tgt d].Comp) {
  module F = FB.Fr[G, A, B, x, PB.src d, PB.tgt d] ;
  module PC = F.PC ;

  -- the component compositions
  module AtY (y : CO) (f : CH y x) {
   module PiK = PB.CPi[l].PiC[G.ob y, A.ty y, B.ty y, d, kA y, cB y] ;
   module FS = PB.CFibSub[l].FibSub[F.Gx, G.ob y, G.act y x f, PC.PiB y].C.MoveComp[PB.src d, PB.tgt d] ;
   cT : F.Cm[y, f].CKT.Comp = FS.move PiK.comp ;
  } ;
  cT (y : CO) (f : CH y x) : F.Cm[y, f].CKT.Comp = AtY[y, f].cT ;
  module Cq = F.Cp[cT] ;

  -- the component (y , f) of the composite is the base composite at the
  -- moved data
  module Val (X : Ob) (w : F.CKP.EK.TV.EI X) (p : F.CKP.EK.PT.Side[X, w]) (y : CO) (f : CH y x) {
   module Ay = AtY[y, f] ;
   module Cm = F.Cm[y, f] ;
   wT : Cm.CKT.EK.TV.EI X = Cm.M.tvM X w ;
   pT : Cm.CKT.EK.PT.Side[X, wT] = Cm.M.mapS X w p ;
   u : W0.Ix ((F.TT y f).tob X (F.gE X w)) = Cq.kcomp X w p y f ;
   wY : Ay.PiK.KP.TV.EI X = Ay.FS.E.sV X wT ;
   pY : Ay.PiK.KP.PT.Side[X, wY] = Ay.FS.mside Ay.PiK.comp X wT pT ;
   module CX = Ay.PiK.CopX[X, wY, pY] ;
   mv : Id (Ay.FS.TT.EI X) (Ay.FS.mT X (Ay.FS.TT'.pr X wT u)) (Ay.FS.TT.pr X wY CX.cop) = Ay.FS.kopMv Ay.PiK.comp X wT pT ;
   compE : Id (Ay.PiK.TP.EI X) (Ay.PiK.TP.pr X ((G.act y x f).nt X (F.gE X w)) u) (Ay.PiK.TP.pr X CX.xT CX.cop) =
    transH (symH (Ay.FS.E'.sVE X (Ay.FS.CK'.SE.mV X (Ay.FS.TT'.pr X wT u)))) (apH (\ t -> Ay.PiK.rdP X t) mv) ;

   -- its value at (h , a0): the reading of the composite of the
   -- B-problem (CPi.Prob) at the restricted data
   module VK (K : Ob) (h : Hom K X) (a0 : PC.At[x, X, F.gE X w].FA y f K h) {
    module S = PC.At[x, X, F.gE X w] ;
    pX : Id (W0.Ix ((G.ob y).ob X)) ((G.act y x f).nt X (F.gE X w)) CX.xT = apH (\ t -> Ay.PiK.TP.pr1 X t) compE ;
    a1 : W0.Ix ((A.ty y).tob K ((G.ob y).act K X h CX.xT)) =
     GPR.TyL[G.ob y, A.ty y].coeT K (S.ptH y f K h) ((G.ob y).act K X h CX.xT) (apH (\ q -> (G.ob y).act K X h q) pX) a0 ;
    a1-pr : Id (PC.TA y K) (PC.prA y K (S.ptH y f K h) a0) (PC.prA y K ((G.ob y).act K X h CX.xT) a1) =
     GPR.TyL[G.ob y, A.ty y].pr-coe K (S.ptH y f K h) ((G.ob y).act K X h CX.xT) (apH (\ q -> (G.ob y).act K X h q) pX) a0 ;
    wK : Ay.PiK.KP.TV.EI K = Ay.PiK.KP.TV.E.act K X h wY ;
    pK : Ay.PiK.KP.PT.Side[K, wK] = Ay.PiK.KP.PT.rside K X h wY pY ;
    module Pr = Ay.PiK.Prob[K, wK, pK, CX.vK K h a1] ;
    v1 : Id (PC.TB y K) (S.valT (Cq.kcomp X w p) y f K h a0) (Ay.PiK.PE.valE X CX.xT CX.cop K h a1) =
     Ay.PiK.PE.valE-PiE X ((G.act y x f).nt X (F.gE X w)) CX.xT u CX.cop compE K h a0 a1 a1-pr ;
    res : Id (PC.TB y K) (S.valT (Cq.kcomp X w p) y f K h a0) (Ay.PiK.rdB K (Ay.PiK.TTB.pr K Pr.wB Pr.bB)) =
     transH v1 (transH (CX.cop-val K h a1) Pr.value-E) ;
   } ;
  } ;

  ------------------------------------------------------------------
  -- naturality in C of the composites, from the uniformity of the
  -- compositions of B once the B-problem moves (its point: ptB, its
  -- side: sdB)

  module NC (cBU : LO.UF[LO.ExtC G A, B].UComp (PB.src d) (PB.tgt d) cB) {
   module FUB = CPshFillU[a, l].FillUOf[C].FU[LO.ExtC G A, B, d, cB, cBU] ;

   module At2 (X : Ob) (w : F.CKP.EK.TV.EI X) (p : F.CKP.EK.PT.Side[X, w])
    (z y : CO) (g : CH z y) (f : CH y x) (K : Ob) (h : Hom K X) (a0 : PC.At[x, X, F.gE X w].FA y f K h) {
    module S = PC.At[x, X, F.gE X w] ;
    module Vy = Val[X, w, p, y, f].VK[K, h, a0] ;
    module Vz = Val[X, w, p, z, co z y x f g].VK[K, h, S.aM z y g f K h a0] ;
    module Ky = AtY[y, f].PiK ;
    module Kz = AtY[z, co z y x f g].PiK ;
    tvB (u : Ky.KB.TV.EI K) : Kz.KB.TV.EI K = FUB.tv z y g K u ;
    msB : Kz.KB.PT.Side[K, tvB Vy.Pr.wB] = FUB.MSd[z, y, g].M.mapside K Vy.Pr.wB Vy.Pr.pB ;

    module Core (ptB : Id (Kz.KB.TV.EI K) (tvB Vy.Pr.wB) Vz.Pr.wB)
     (sdB : Id (Kz.KB.PT.Side[K, Vz.Pr.wB]) (subst (Kz.KB.TV.EI K) (\ t -> Kz.KB.PT.Side[K, t]) (tvB Vy.Pr.wB) Vz.Pr.wB ptB msB) Vz.Pr.pB) {
     c1 : Id (PC.TB z K) ((B.tE z y g).nt K (Ky.rdB K (Ky.TTB.pr K Vy.Pr.wB Vy.Pr.bB)))
           (Kz.rdB K (FUB.SCe.tEs z y g K (Ky.TTB.pr K Vy.Pr.wB Vy.Pr.bB))) =
      symH (FUB.rdC z y g K (Ky.TTB.pr K Vy.Pr.wB Vy.Pr.bB)) ;
     c2 : Id (Kz.TTB.EI K) (FUB.SCe.tEs z y g K (Ky.TTB.pr K Vy.Pr.wB Vy.Pr.bB)) (Kz.TTB.pr K Vz.Pr.wB Vz.Pr.bB) =
      transH (cBU z y g K Vy.Pr.wB Vy.Pr.pB)
       (Kz.RCB.kop-cong (cB z) K (tvB Vy.Pr.wB) Vz.Pr.wB ptB msB Vz.Pr.pB sdB) ;
     res : S.CNatAt (Cq.kcomp X w p) z y g f K h a0 =
      transH (apH (\ t -> (B.tE z y g).nt K t) Vy.res)
       (transH c1 (transH (apH (\ t -> Kz.rdB K t) c2) (symH Vz.res))) ;
    } ;
   } ;
  } ;
 } ;
} ;
