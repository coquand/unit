-- CPshPiFibN.seg (canonicity-c2; COBAR.md (B) stage 2(c), M2): the
-- components of the composition of (Pi_A B)_x are the base's compositions
-- of the products Pi_y (CPi.PiC), moved along act f (CFibSub); the family
-- of composites is natural in C (NatComp) and uniform in C.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module NOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 module FB = CPshPiFib[a, l].FibOf[C] ;
 open P ;

 module Nd (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) (x : CO) (d : Bool)
  (kA : (y : CO) -> CL.Lines[G.ob y, A.ty y].Fill (PB.tgt d))
  (cB : (y : CO) -> CL.Lines[extP (G.ob y) (A.ty y), B.ty y].CompK[PB.src d, PB.tgt d].Comp) {
  module F = FB.Fr[G, A, B, x, PB.src d, PB.tgt d] ;
  module PC = F.PC ;

  -- the component compositions
  module AtY (y : CO) (f : CH y x) {
   module PiK = PB.CPi[l].PiC[G.ob y, A.ty y, B.ty y, d, kA y, cB y] ;
   module FS = PB.CFibSub[l].FibSub[F.Gx, G.ob y, G.act y x f, PC.PiB y].C.MoveComp[PB.src d, PB.tgt d] ;
   cT : F.Cm[y, f].CKT.Comp = FS.move PiK.comp ;
  } ;
  cT (y : CO) (f : CH y x) : F.Cm[y, f].CKT.Comp = AtY[y, f].cT ;
  module Cq = F.Cp[cT] ;

  -- the component (y , f) of the composite is the base composite at the
  -- moved data
  module Val (X : Ob) (w : F.CKP.EK.TV.EI X) (p : F.CKP.EK.PT.Side[X, w]) (y : CO) (f : CH y x) {
   module Ay = AtY[y, f] ;
   module Cm = F.Cm[y, f] ;
   wT : Cm.CKT.EK.TV.EI X = Cm.M.tvM X w ;
   pT : Cm.CKT.EK.PT.Side[X, wT] = Cm.M.mapS X w p ;
   u : W0.Ix ((F.TT y f).tob X (F.gE X w)) = Cq.kcomp X w p y f ;
   wY : Ay.PiK.KP.TV.EI X = Ay.FS.E.sV X wT ;
   pY : Ay.PiK.KP.PT.Side[X, wY] = Ay.FS.mside Ay.PiK.comp X wT pT ;
   module CX = Ay.PiK.CopX[X, wY, pY] ;
   mv : Id (Ay.FS.TT.EI X) (Ay.FS.mT X (Ay.FS.TT'.pr X wT u)) (Ay.FS.TT.pr X wY CX.cop) = Ay.FS.kopMv Ay.PiK.comp X wT pT ;
   compE : Id (Ay.PiK.TP.EI X) (Ay.PiK.TP.pr X ((G.act y x f).nt X (F.gE X w)) u) (Ay.PiK.TP.pr X CX.xT CX.cop) =
    transH (symH (Ay.FS.E'.sVE X (Ay.FS.CK'.SE.mV X (Ay.FS.TT'.pr X wT u)))) (apH (\ t -> Ay.PiK.rdP X t) mv) ;
  } ;
 } ;
} ;
