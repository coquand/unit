-- CRestrHT.seg (canonicity-45; COBAR.md "comparison"): a path homotopy at
-- the total site between maps of contexts read as types over the terminal
-- context (CtxTy's Y1T) restricts to the copy of a presentation y' as a
-- path homotopy between the closed copy types (values at (V, y') along
-- (g, cart); the fibres do not depend on the terminal point).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RHT (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module CM = CC.CM ;
 module TR = CC.TR ;
 module CT = CTotCtxTy[a, a+, a+].CtxTy[CM.IC] ;
 module G1 = TR.G1 ;
 module HO1 = G1.GB.CHtpyOps[a+] ;
 module HO = PB.CHtpyOps[a+] ;
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 K0 (W : Ob) : CT.TC.TOb = (W, y') ;
 qm (Vv W : Ob) (g : Hom Vv W) : CT.TC.THm (Vv, y') (W, y') = (g, CM.IC.cart Vv W g y') ;
 cartId (I : Ob) : Id (CM.TP.HomD I I (idH I) y' y') (CM.IC.cart I I (idH I) y') (CM.IC.idD I y') =
  CM.MO.Fn[y', y'].mExt I (CM.IC.cart I I (idH I) y') (CM.IC.idD I y') (refl (CM.MO.Fn[y', y'].fpOf I (CM.IC.idD I y'))) ;
 cartO (K J I : Ob) (uu : Hom J I) (v : Hom K J) : Id (CM.TP.HomD K I (compH K J I uu v) y' y') (CM.IC.cart K I (compH K J I uu v) y') (CM.IC.compD K J I uu v y' y' y' (CM.IC.cart J I uu y') (CM.IC.cart K J v y')) =
  CM.MO.Fn[y', y'].mExt K (CM.IC.cart K I (compH K J I uu v) y') (CM.IC.compD K J I uu v y' y' y' (CM.IC.cart J I uu y') (CM.IC.cart K J v y'))
   (refl (CM.MO.Fn[y', y'].fpOf K (CM.IC.cart K I (compH K J I uu v) y'))) ;
 cmpEq (K J I : Ob) (uu : Hom J I) (v : Hom K J)
  : Id (CT.TC.THm (K, y') (I, y')) (CT.TC.TotCat.oC (K, y') (J, y') (I, y') (qm J I uu) (qm K J v)) (qm K I (compH K J I uu v)) =
  CM.CO.pq K I y' y' (compH K J I uu v) (compH K J I uu v) (refl (compH K J I uu v))
   (CM.CO.cmpM K J I v y' y' y' (CM.IC.cart J I uu y') (CM.IC.cart K J v y')) (CM.IC.cart K I (compH K J I uu v) y')
   (CM.MO.Fn[y', y'].mExt K (CM.CO.cmpM K J I v y' y' y' (CM.IC.cart J I uu y') (CM.IC.cart K J v y')) (CM.IC.cart K I (compH K J I uu v) y')
      (refl (CM.MO.Fn[y', y'].fpOf K (CM.IC.cart K I (compH K J I uu v) y')))) ;
 -- the closed copy type of a context
 module ClT (Z : CM.TP.TCtx) {
  tob (I : Ob) (o : V1.Ix (Nl.ob I)) : V1.V = Z.ob I y' ;
  tact (J I : Ob) (h : Hom J I) (o : V1.Ix (Nl.ob I)) (o' : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h o) o') (w : V1.Ix (tob I o)) : V1.Ix (tob J o') =
   Z.act J I h y' y' (CM.IC.cart J I h y') w ;
  ty : L.PTy[Nl] = L.mkTy Nl tob tact
   (\ I o e w -> transH (apH {CM.TP.HomD I I (idH I) y' y'} {V1.Ix (Z.ob I y')} (\ f -> Z.act I I (idH I) y' y' f w) (cartId I)) (Z.act-id I y' w))
   (\ K J I f g o o' o'' e1 e2 e3 w -> transH (apH {CM.TP.HomD K I (compH K J I f g) y' y'} {V1.Ix (Z.ob K y')} (\ f0 -> Z.act K I (compH K J I f g) y' y' f0 w) (cartO K J I f g))
      (Z.act-o K J I f g y' y' y' (CM.IC.cart J I f y') (CM.IC.cart K J g y') w)) ;
 } ;
 module Of (Ya Yb : CM.TP.TCtx) {
  module QA = CT.Of[Ya] ;
  module QB = CT.Of[Yb] ;
  Ac : L.PTy[Nl] = ClT[Ya].ty ;
  Bc : L.PTy[Nl] = ClT[Yb].ty ;
  rN (f : HO1.NMap[CT.P1, QA.Y1T, QB.Y1T]) : HO.NMap[Nl, Ac, Bc] =
   new HO.NMap[Nl, Ac, Bc, \ I o a0 -> f.nfun (K0 I) tt a0, \ J I h x x' e a0 -> f.nnat (K0 J) (K0 I) (qm J I h) tt tt (refl tt) a0] ;
  -- a homotopy f ~ g at the total site restricts to rN f ~ rN g
  module RHt (f g : HO1.NMap[CT.P1, QA.Y1T, QB.Y1T]) (H : G1.GB.GPre[a+].PS.PEl[HO1.HT[CT.P1, QA.Y1T, QB.Y1T, f, g].GA, HO1.HT[CT.P1, QA.Y1T, QB.Y1T, f, g].PT.PathP]) {
   module T = HO1.HT[CT.P1, QA.Y1T, QB.Y1T, f, g] ;
   module CH = HO.HT[Nl, Ac, Bc, rN f, rN g] ;
   module TBc = PB.GPre[a+].TyL[Nl, Bc] ;
   zt (W : Ob) (a0 : V1.Ix (Ya.ob W y')) : V1.Ix (T.GA.ob (K0 W)) = (tt, a0) ;
   lv (W Vv : Ob) (gg : Hom Vv W) (j : Hom Vv Iv) (a0 : V1.Ix (Ya.ob W y')) : V1.Ix (Yb.ob Vv y') =
    (T.pv H (K0 W) (zt W a0) (Vv, y') (qm Vv W gg) j).2 ;
   path (W : Ob) (zz : V1.Ix (CH.GA.ob W)) : V1.Ix (CH.PT.tobP W zz) =
    CH.PT.mkPath W zz (\ Vv gg j -> TBc.pr Vv (CH.TA.pr1 W zz) (lv W Vv gg j (CH.TA.pr2 W zz)))
     (\ Vb Va g2 gg j -> transH (TBc.pr-tact Vb Va g2 (CH.TA.pr1 W zz) (CH.TA.pr1 W zz) (refl (CH.TA.pr1 W zz)) (lv W Va gg j (CH.TA.pr2 W zz)))
        (apH {V1.Ix (Yb.ob Vb y')} {TBc.EI Vb} (TBc.pr Vb (CH.TA.pr1 W zz))
          (transH (apH {T.TB.EI (Vb, y')} {V1.Ix (Yb.ob Vb y')} (\ q -> q.2)
             ((H.eob (K0 W) (zt W (CH.TA.pr2 W zz))).1.2 (Vb, y') (Va, y') (qm Vb Va g2) (qm Va W gg) j))
            (apH {CT.TC.THm (Vb, y') (K0 W)} {V1.Ix (Yb.ob Vb y')} (\ kk -> (T.pv H (K0 W) (zt W (CH.TA.pr2 W zz)) (Vb, y') kk (compH Vb Va Iv j g2)).2) (cmpEq Vb Va W gg g2)))))
     (\ Vv gg j -> refl (CH.TA.pr1 W zz))
     (apH {T.TB.EI (K0 W)} {TBc.EI W} (\ q -> TBc.pr W (CH.TA.pr1 W zz) q.2) ((H.eob (K0 W) (zt W (CH.TA.pr2 W zz))).2.2.1))
     (apH {T.TB.EI (K0 W)} {TBc.EI W} (\ q -> TBc.pr W (CH.TA.pr1 W zz) q.2) ((H.eob (K0 W) (zt W (CH.TA.pr2 W zz))).2.2.2)) ;
   enat (J I : Ob) (h : Hom J I) (zz : V1.Ix (CH.GA.ob I)) (zz' : V1.Ix (CH.GA.ob J)) (ee : Id (V1.Ix (CH.GA.ob J)) (CH.GA.act J I h zz) zz')
    : Id (V1.Ix (CH.PT.tobP J zz')) (CH.PT.PathP.tact J I h zz zz' ee (path I zz)) (path J zz') =
    CH.PT.path-eq J zz' (CH.PT.PathP.tact J I h zz zz' ee (path I zz)) (path J zz') (\ Vv ff i ->
     transH (apH {V1.Ix (Yb.ob Vv y')} {TBc.EI Vv} (TBc.pr Vv (CH.TA.pr1 I zz))
       (transH (apH {CT.TC.THm (Vv, y') (K0 I)} {V1.Ix (Yb.ob Vv y')} (\ kk -> (T.pv H (K0 I) (zt I (CH.TA.pr2 I zz)) (Vv, y') kk i).2) (symH (cmpEq Vv J I h ff)))
         (apH {T.TB.EI (Vv, y')} {V1.Ix (Yb.ob Vv y')} (\ q -> q.2)
           (T.pv-res H (K0 J) (K0 I) (qm J I h) (zt I (CH.TA.pr2 I zz)) (zt J (CH.TA.pr2 J zz'))
             (apH {V1.Ix (Ya.ob J y')} {V1.Ix (T.GA.ob (K0 J))} (zt J) (apH {V1.Ix (CH.GA.ob J)} {V1.Ix (Ya.ob J y')} (CH.TA.pr2 J) ee)) (Vv, y') (qm Vv J ff) i))))
      (apH {V1.Ix (CH.GA.ob J)} {TBc.EI Vv} (\ z2 -> TBc.pr Vv (CH.TA.pr1 J z2) (lv J Vv ff i (CH.TA.pr2 J zz'))) ee)) ;
   res : L.PEl[CH.GA, CH.PT.PathP] = new L.PEl[CH.GA, CH.PT.PathP, path, enat] ;
  } ;
 } ;
} ;
