-- CRhoTel3.seg (canonicity-45; COBAR.md "Prop 58"): rho's map from yo(y.u)
-- (over the terminal context) into c2's telescope context (HS of u's renamed
-- equations), equation by equation, with its point projection.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RT3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module B = CRhoTel2[a].RT2[R, encK, pe, y, u] ;
 module T = B.T ;
 module RP = T.RP ;
 module SO = T.SO ;
 module EG = T.EG ;
 C : CwF.CwF[a++] = T.C ;
 K : C.Ctx = T.K ;
 module D = SX.Over[R].Der[T.yu] ;
 rnL (L : SX.Over[R].Equations (SX.Fin T.yu.1)) : SX.Over[R].Equations SO.TW.Var = SX.mapL (SX.Over[R].Expr (SX.Fin T.yu.1)) (SX.Over[R].Expr SO.TW.Var) T.rn L ;
 -- u's equations are among y.u's
 memR : (xs : SX.Over[R].Equations (SX.Fin T.yu.1)) (p : T.TmU) -> D.Member p u.2 -> D.Member p (SX.appL (SX.Over[R].Expr (SX.Fin T.yu.1)) xs u.2) = split {
  nil -> \ p m -> m ;
  cons x xs | ih -> \ p m -> inr (ih p m) } ;
 -- the point map into the variable context
 sg0 : C.Sub K SO.Xc = new EG.PS.PSub[K, SO.Xc, RP.sgN, RP.sgNat] ;
 -- one step: extend by the Id component of q
 module Ext (q : T.TmU) (L' : SX.Over[R].Equations (SX.Fin T.yu.1)) (sg' : C.Sub K (SO.HS (rnL L')).1)
   (pf' : (X : EG.Ob) (z : V1.Ix (K.ob X)) -> Id (V1.Ix (SO.Xc.ob X)) ((SO.HS (rnL L')).2.nt X (sg'.nt X z)) (RP.sgN X z))
   (m : D.Member q T.yu.2) {
  d : D.Proof q D.zeroE = (equation q m, (tt, (refl q, refl D.zeroE))) ;
  module Cm = B.Cmp[rnL L', sg', q, d, pf'] ;
  E : C.Ctx = (SO.HS (rnL L')).1 ;
  sg : C.Sub K (C.ext E Cm.EqTy) = C.o K (C.ext K (C.subT K E Cm.EqTy sg')) (C.ext E Cm.EqTy) (C.lift K E Cm.EqTy sg') (C.sec K (C.subT K E Cm.EqTy sg') Cm.hq) ;
  res : (sg2 : C.Sub K (SO.HS (rnL (cons q L'))).1) * ((X : EG.Ob) (z : V1.Ix (K.ob X)) -> Id (V1.Ix (SO.Xc.ob X)) ((SO.HS (rnL (cons q L'))).2.nt X (sg2.nt X z)) (RP.sgN X z)) =
   (sg, pf') ;
 } ;
 St : (L : SX.Over[R].Equations (SX.Fin T.yu.1)) (mm : (p : T.TmU) -> D.Member p L -> D.Member p T.yu.2)
   -> (sg : C.Sub K (SO.HS (rnL L)).1) * ((X : EG.Ob) (z : V1.Ix (K.ob X)) -> Id (V1.Ix (SO.Xc.ob X)) ((SO.HS (rnL L)).2.nt X (sg.nt X z)) (RP.sgN X z)) = split {
  nil -> \ mm -> (sg0, \ X z -> refl (RP.sgN X z)) ;
  cons q L' | r -> \ mm -> Ext[q, L', (r (\ p m -> mm p (inr m))).1, (r (\ p m -> mm p (inr m))).2, mm q (inl (refl q))].res } ;
} ;
