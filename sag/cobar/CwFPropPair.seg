-- CwFPropPair.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit): in a
-- Sigma type whose second component is a proposition, two elements with
-- joined first components are joined.
--
-- Informal text.  Let Y be a type over G.X with pY : isProp Y, w an element
-- of S = Sigma X Y, x' : X with e : Id(fst w , x'), and y' : Y(x').
-- Over E2 = G.X.Y let IdE = Id(w , pv), pv the pair of the variables
-- (CwFSig).  At the point (x , y) of E2 it is Id(w , (x , y)) (IdAt: the
-- value of pv there by CwFSig's pv-gen, read in S through the identity
-- substitution).
-- (1) P = Sigma (y : Y) IdE is a family over G.X.  At fst w it has the
--     element (snd w , refl) (eta).  Its transport along e (CwFTr) is some
--     y'' : Y(x') with Id(w , (x' , y'')).
-- (2) IdE along (x' , -) is a family over G.Y(x').  y'' and y' are joined
--     since Y(x') is a proposition; the transport along that path gives
--     Id(w , (x' , y')).
-- pairPath is the case x' = fst w', y' = snd w', with eta for w'.
open Base ;

module PropPair (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module PR = CwFPair.PairAt[l, C, PS, SS, IJ] ;

  module At (G : Ctx) (X : Ty G) (Y : Ty (ext G X)) {
    module VS = SV.At[G, X, Y] ;
    K : Ctx = ext G X ;
    E2 : Ctx = VS.E2 ;
    S : Ty G = SS.Sig G X Y ;
    Yat (x : El G X) : Ty G = subT G K Y (sec G X x) ;
    pt (x : El G X) (y : El G (Yat x)) : Sub G E2 = extS G K Y (sec G X x) y ;

    -- the value of the pair of the variables at (x , y)
    module Pv (x : El G X) (y : El G (Yat x)) {
      Xi : Ty G = subT G G X (id G) ;
      Yi : Ty (ext G Xi) = subT (ext G Xi) K Y (lift G G X (id G)) ;
      xi : El G Xi = trE G X Xi (sym (Ty G) Xi X (subT-id G X)) x ;
      es : Id (Sub G G) (o G K G (p G X) (sec G X x)) (id G) = p-sec G X x ;
      PWa : Id (Ty G) (subT G K VS.Ap (sec G X x)) Xi =
        trans (Ty G) (subT G K VS.Ap (sec G X x)) X Xi (p-sec-T G X X x) (sym (Ty G) Xi X (subT-id G X)) ;
      qa : Ov G K VS.Ap (sec G X x) Xi PWa (q G X) xi =
        IN.teAny G (subT G K VS.Ap (sec G X x)) Xi (subt G K VS.Ap (q G X) (sec G X x)) xi
          (IN.teT G (subT G K VS.Ap (sec G X x)) X Xi (subt G K VS.Ap (q G X) (sec G X x)) x xi
             (IN.teOv G K VS.Ap (sec G X x) X (p-sec-T G X X x) (q G X) x (IN.q-secO G X x (p-sec-T G X X x)))
             (IN.teTr G X Xi (sym (Ty G) Xi X (subT-id G X)) x))
          PWa ;
      ppPt : Id (Sub G G) (o G E2 G VS.pp (pt x y)) (id G) =
        trans (Sub G G) (o G E2 G VS.pp (pt x y)) (o G K G (p G X) (o G E2 K VS.p2 (pt x y))) (id G)
          (o-assoc G E2 K G (p G X) VS.p2 (pt x y))
          (trans (Sub G G) (o G K G (p G X) (o G E2 K VS.p2 (pt x y))) (o G K G (p G X) (sec G X x)) (id G)
             (ap (Sub G K) (Sub G G) (\ t -> o G K G (p G X) t) (o G E2 K VS.p2 (pt x y)) (sec G X x) (IN.p-extS G K Y (sec G X x) y))
             es) ;
      SgI : Ty G = SS.Sig G Xi Yi ;
      PSg : Id (Ty G) (subT G E2 VS.SW (pt x y)) SgI =
        trans (Ty G) (subT G E2 VS.SW (pt x y)) (subT G G S (o G E2 G VS.pp (pt x y))) SgI
          (sym (Ty G) (subT G G S (o G E2 G VS.pp (pt x y))) (subT G E2 VS.SW (pt x y)) (subT-o G E2 G S VS.pp (pt x y)))
          (trans (Ty G) (subT G G S (o G E2 G VS.pp (pt x y))) (subT G G S (id G)) SgI
             (ap (Sub G G) (Ty G) (\ t -> subT G G S t) (o G E2 G VS.pp (pt x y)) (id G) ppPt)
             (SS.Sig-nat G G X Y (id G))) ;
      y1 : El G (subT G K Y (extS G G X (id G) xi)) =
        trE G (subT G K Y (sec G X x)) (subT G K Y (extS G G X (id G) xi))
          (ap (Sub G K) (Ty G) (\ u -> subT G K Y u) (sec G X x) (extS G G X (id G) xi) (VS.etPt G (sec G X x) (id G) es xi PWa qa)) y ;
      y2 : El G (subT G (ext G Xi) Yi (sec G Xi xi)) =
        trE G (subT G K Y (extS G G X (id G) xi)) (subT G (ext G Xi) Yi (sec G Xi xi))
          (subT-o G (ext G Xi) K Y (lift G G X (id G)) (sec G Xi xi)) y1 ;
      r1 : Ov G E2 VS.SW (pt x y) SgI PSg VS.pv (IN.pr G Xi Yi xi y2) =
        VS.pv-gen G (sec G X x) (id G) es xi PWa qa y PSg ;
      -- the pair (x , y), read along the identity substitution
      teX : IN.TE G (subT G G X (id G)) Xi (subt G G X x (id G)) xi =
        IN.teT G (subT G G X (id G)) X Xi (subt G G X x (id G)) x xi
          (subT-id G X, subt-id G X x)
          (IN.teTr G X Xi (sym (Ty G) Xi X (subT-id G X)) x) ;
      teY : IN.TE G (subT G G (Yat x) (id G)) (subT G (ext G Xi) Yi (sec G Xi xi)) (subt G G (Yat x) y (id G)) y2 =
        IN.teT G (subT G G (Yat x) (id G)) (Yat x) (subT G (ext G Xi) Yi (sec G Xi xi)) (subt G G (Yat x) y (id G)) y y2
          (subT-id G (Yat x), subt-id G (Yat x) y)
          (IN.teT G (Yat x) (subT G K Y (extS G G X (id G) xi)) (subT G (ext G Xi) Yi (sec G Xi xi)) y y1 y2
             (IN.teTr G (subT G K Y (sec G X x)) (subT G K Y (extS G G X (id G) xi))
                (ap (Sub G K) (Ty G) (\ u -> subT G K Y u) (sec G X x) (extS G G X (id G) xi) (VS.etPt G (sec G X x) (id G) es xi PWa qa)) y)
             (IN.teTr G (subT G K Y (extS G G X (id G) xi)) (subT G (ext G Xi) Yi (sec G Xi xi))
                (subT-o G (ext G Xi) K Y (lift G G X (id G)) (sec G Xi xi)) y1)) ;
      r2 : Ov G G S (id G) SgI (SS.Sig-nat G G X Y (id G)) (IN.pr G X Y x y) (IN.pr G Xi Yi xi y2) =
        IN.pr-ov G G X Y (id G) Xi (refl Xi) Yi (refl Yi) (SS.Sig-nat G G X Y (id G))
          x xi (IN.teAny G (subT G G X (id G)) Xi (subt G G X x (id G)) xi teX (refl Xi))
          y y2 teY.1 teY.2 ;
      pvTE : IN.TE G (subT G E2 VS.SW (pt x y)) S (subt G E2 VS.SW VS.pv (pt x y)) (IN.pr G X Y x y) =
        IN.teT G (subT G E2 VS.SW (pt x y)) SgI S (subt G E2 VS.SW VS.pv (pt x y)) (IN.pr G Xi Yi xi y2) (IN.pr G X Y x y)
          (IN.teOv G E2 VS.SW (pt x y) SgI PSg VS.pv (IN.pr G Xi Yi xi y2) r1)
          (IN.teT G SgI (subT G G S (id G)) S (IN.pr G Xi Yi xi y2) (subt G G S (IN.pr G X Y x y) (id G)) (IN.pr G X Y x y)
             (IN.teS G (subT G G S (id G)) SgI (subt G G S (IN.pr G X Y x y) (id G)) (IN.pr G Xi Yi xi y2)
                (IN.teOv G G S (id G) SgI (SS.Sig-nat G G X Y (id G)) (IN.pr G X Y x y) (IN.pr G Xi Yi xi y2) r2))
             (subT-id G S, subt-id G S (IN.pr G X Y x y))) ;
    } ;

    -- over E2: Id(w , pv), and its value at (x , y)
    module W (w : El G S) {
      ww : El E2 VS.SW = subt E2 G S w VS.pp ;
      IdE : Ty E2 = IJ.IdT E2 VS.SW ww VS.pv ;
      wwTE (x : El G X) (y : El G (Yat x)) : IN.TE G (subT G E2 VS.SW (pt x y)) S (subt G E2 VS.SW ww (pt x y)) w =
        IN.teT G (subT G E2 VS.SW (pt x y)) (subT G G S (o G E2 G VS.pp (pt x y))) S
          (subt G E2 VS.SW ww (pt x y)) (subt G G S w (o G E2 G VS.pp (pt x y))) w
          (IN.teS G (subT G G S (o G E2 G VS.pp (pt x y))) (subT G E2 VS.SW (pt x y))
             (subt G G S w (o G E2 G VS.pp (pt x y))) (subt G E2 VS.SW ww (pt x y))
             (IN.teSubtO G E2 G S w VS.pp (pt x y)))
          (IN.teT G (subT G G S (o G E2 G VS.pp (pt x y))) (subT G G S (id G)) S
             (subt G G S w (o G E2 G VS.pp (pt x y))) (subt G G S w (id G)) w
             (IN.teSubEq G G S w (o G E2 G VS.pp (pt x y)) (id G) Pv[x, y].ppPt)
             (subT-id G S, subt-id G S w)) ;
      IdAt (x : El G X) (y : El G (Yat x)) : Id (Ty G) (subT G E2 IdE (pt x y)) (IJ.IdT G S w (IN.pr G X Y x y)) =
        Id-ov G E2 VS.SW ww VS.pv (pt x y) S Pv[x, y].pvTE.1 w (IN.pr G X Y x y)
          (IN.teAny G (subT G E2 VS.SW (pt x y)) S (subt G E2 VS.SW ww (pt x y)) w (wwTE x y) Pv[x, y].pvTE.1)
          Pv[x, y].pvTE.2 ;
    } ;

    -- (1), (2)
    module Join (pY : El K (PU.isProp K Y)) (w : El G S) (x' : El G X)
      (e : El G (IJ.IdT G X (IN.fst G X Y w) x')) (y' : El G (Yat x')) {
      module WW = W[w] ;
      module PP = PR.At[K, Y, WW.IdE] ;
      x0 : El G X = IN.fst G X Y w ;
      y0 : El G (Yat x0) = IN.snd G X Y w ;
      eta : Id (El G S) w (IN.pr G X Y x0 y0) = sym (El G S) (IN.pr G X Y x0 y0) w ((SS.Sig-iso G X Y).inv-fun w) ;
      b0 : El G (subT G E2 WW.IdE (pt x0 y0)) =
        trE G (IJ.IdT G S w (IN.pr G X Y x0 y0)) (subT G E2 WW.IdE (pt x0 y0))
          (sym (Ty G) (subT G E2 WW.IdE (pt x0 y0)) (IJ.IdT G S w (IN.pr G X Y x0 y0)) (WW.IdAt x0 y0))
          (IN.idOfEq G S w (IN.pr G X Y x0 y0) eta) ;
      v0 : El G (subT G K PP.S (sec G X x0)) = PP.pSt G (sec G X x0) y0 b0 ;
      z : El G (subT G K PP.S (sec G X x')) = TR.trP G X PP.S x0 x' e v0 ;
      y2 : El G (Yat x') = PP.fstS G (sec G X x') z ;
      s2 : El G (subT G E2 WW.IdE (pt x' y2)) = PP.sndS G (sec G X x') z ;
      Yx : Ty G = Yat x' ;
      P2 : Ty (ext G Yx) = subT (ext G Yx) E2 WW.IdE (lift G K Y (sec G X x')) ;
      at2 (y : El G Yx) : Id (Ty G) (subT G E2 WW.IdE (pt x' y)) (subT G (ext G Yx) P2 (sec G Yx y)) =
        subT-o G (ext G Yx) E2 WW.IdE (lift G K Y (sec G X x')) (sec G Yx y) ;
      pYx : El G (PU.isProp G Yx) =
        trE G (subT G K (PU.isProp K Y) (sec G X x')) (PU.isProp G Yx) (PU.isProp-ov G K Y (sec G X x') Yx (refl Yx))
          (subt G K (PU.isProp K Y) pY (sec G X x')) ;
      u : El G (IJ.IdT G Yx y2 y') = PU.propPath G Yx pYx y2 y' ;
      h : El G (subT G (ext G Yx) P2 (sec G Yx y')) =
        TR.trP G Yx P2 y2 y' u (trE G (subT G E2 WW.IdE (pt x' y2)) (subT G (ext G Yx) P2 (sec G Yx y2)) (at2 y2) s2) ;
      res : El G (IJ.IdT G S w (IN.pr G X Y x' y')) =
        trE G (subT G E2 WW.IdE (pt x' y')) (IJ.IdT G S w (IN.pr G X Y x' y')) (WW.IdAt x' y')
          (trE G (subT G (ext G Yx) P2 (sec G Yx y')) (subT G E2 WW.IdE (pt x' y'))
             (sym (Ty G) (subT G E2 WW.IdE (pt x' y')) (subT G (ext G Yx) P2 (sec G Yx y')) (at2 y')) h) ;
    } ;

    -- two elements of Sigma X Y with joined first components are joined
    pairPath (pY : El K (PU.isProp K Y)) (w w' : El G S) (e : El G (IJ.IdT G X (IN.fst G X Y w) (IN.fst G X Y w')))
      : El G (IJ.IdT G S w w') =
      subst (El G S) (\ v -> El G (IJ.IdT G S w v)) (IN.pr G X Y (IN.fst G X Y w') (IN.snd G X Y w')) w'
        ((SS.Sig-iso G X Y).inv-fun w')
        Join[pY, w, IN.fst G X Y w', e, IN.snd G X Y w'].res ;
  } ;
} ;
