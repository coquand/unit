-- CTotPsi4.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for lines
-- at the total site, part 4: the inner face equation of Psi (faceP): at a
-- face weight Psi is Psi at the composed chain (restriction commutes with
-- composing adjacent maps; the D-element's face equation; resFace).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;
module Tr = Trees[a] ;
module Ar = Arith[a] ;

module Psi4 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) {
 module P3 = CTotPsi3[a, vl, l].Psi3[C, G] ;
 module P2 = P3.P2 ;
 module PO = P3.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module VT = PO.VT ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module XB = P3.XB ;
 module DL = P3.DL ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;

 -- composing adjacent maps commutes with restriction
 compR (J' J I : Ob) (v : Hom J' J) (u : Hom J I) (x : Obj I) (n k : Nat) (z : Obj J) (c : CT.Ch J (suc n) (C.res J I u x) z)
  : Id (CT.Ch J' n (C.res J' I (compH J' J I u v) x) (C.res J' J v z))
      (CT.KJ[J'].K.comp n k (C.res J' I (compH J' J I u v) x) (C.res J' J v z) (DO.rCh J' J I v u x (suc n) z c))
      (DO.rCh J' J I v u x n z (CT.KJ[J].K.comp n k (C.res J I u x) z c)) =
  transH (CT.trCh-comp J' n k (C.res J' J v (C.res J I u x)) (C.res J' I (compH J' J I u v) x) (symH (C.res-comp J' J I u v x)) (C.res J' J v z)
            (CChainsF[vl].CF[VT.VCat J, VT.VCat J', VT.rfun J' J v].chF (suc n) (C.res J I u x) z c))
   (apH {CT.Ch J' n (C.res J' J v (C.res J I u x)) (C.res J' J v z)} {CT.Ch J' n (C.res J' I (compH J' J I u v) x) (C.res J' J v z)}
      (\ d -> CT.trCh J' n (C.res J' J v (C.res J I u x)) (C.res J' I (compH J' J I u v) x) (symH (C.res-comp J' J I u v x)) (C.res J' J v z) d)
      (symH (CChainsF[vl].CF[VT.VCat J, VT.VCat J', VT.rfun J' J v].chF-comp n k (C.res J I u x) z c))) ;

 module PF (X : TC.TOb) (ln : W0.Ix (PO.FL.ob X)) {
  module PN = P3.PN[X, ln] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module FE (n k : Nat) (hk : Tr.IsT (Tr.leb k n)) (J : Ob) (u : Hom J I) (z : Obj J) (c : CT.Ch J (suc n) (C.res J I u x) z) (i : Wt.Pn n J) {
   hk' : Tr.IsT (Tr.leb k (suc n)) = Ar.leb-step k n hk ;
   fi : Wt.Pn (suc n) J = Wt.Face[n, J, k, hk'].Of[i].face ;
   cc : CT.Ch J n (C.res J I u x) z = CT.KJ[J].K.comp n k (C.res J I u x) z c ;
   module QF = P2.PQ[X, ln, suc n, J, u, z, c, fi] ;
   module QC = P2.PQ[X, ln, n, J, u, z, cc, i] ;
   module V0 (W1 : Ob) (v : Hom W1 J) (y : Obj W1) (e : Id (Obj W1) (C.res W1 J v z) y) (j : PB.IvP W1) {
    uv : Hom W1 I = compH W1 J I u v ;
    ry : Obj W1 = C.res W1 I uv x ;
    Ri : Wt.Pn n W1 = Wt.Res[n, W1, J, v, i].res ;
    module A1 = PO.PL[X, ln].RC[suc n, W1, y, uv, QF.cT W1 v y e, Wt.Res[suc n, W1, J, v, fi].res, j] ;
    module A2 = PO.PL[X, ln].RC[n, W1, y, uv, QC.cT W1 v y e, Ri, j] ;
    t : W0.Ix (PO.DG.ob A1.Xv) = A1.t ;
    rr : Obj W1 = C.res W1 W1 (idH W1) ry ;
    qh : Id (Obj W1) ry rr = symH (C.res-id W1 ry) ;
    cT2 (y2 : Obj W1) (e2 : Id (Obj W1) (C.res W1 J v z) y2)
     : Id (CT.Ch W1 n ry y2) (CT.KJ[W1].K.comp n k ry y2 (QF.cT W1 v y2 e2)) (QC.cT W1 v y2 e2) =
     idJ (Obj W1) (C.res W1 J v z)
      (\ y3 e3 -> Id (CT.Ch W1 n ry y3) (CT.KJ[W1].K.comp n k ry y3 (QF.cT W1 v y3 e3)) (QC.cT W1 v y3 e3))
      (compR W1 J I v u x n k z c) y2 e2 ;
    chP : Id (CT.Ch W1 n rr y) (CT.KJ[W1].K.comp n k rr y A1.CA.ch) A2.CA.ch =
     transH (CT.trCh-comp W1 n k ry rr qh y (QF.cT W1 v y e))
      (apH {CT.Ch W1 n ry y} {CT.Ch W1 n rr y} (\ d -> CT.trCh W1 n ry rr qh y d) (cT2 y e)) ;
    law : Id (W0.Ix (G.ob W1 y)) (QF.vg W1 v y e j) (QC.vg W1 v y e j) =
     transH (apH {Wt.Pn (suc n) W1} {W0.Ix (G.ob W1 y)} (\ p -> t.1 (suc n, W1, idH W1, y, A1.CA.ch, p.1) p.2)
               (Wt.RF[n, J, W1, v, k, hk', i].resFace))
      (transH (t.2.2.1 (n, k, hk, W1, idH W1, y, A1.CA.ch, Ri.1) Ri.2)
        (apH {CT.Ch W1 n rr y} {W0.Ix (G.ob W1 y)} (\ d -> t.1 (n, W1, idH W1, y, d, Ri.1) Ri.2) chP)) ;
   } ;
   Leq : Id (W0.Ix (XB.RH.F0.ob (J, z))) QF.L0 QC.L0 =
    XB.RH.F0.fam-eq (J, z) QF.L0 QC.L0 (\ W h j -> V0[W.1, h.1, W.2, symH h.2, j].law) ;
   law : Id (W0.Ix (XB.RH.F1.ob (TR.RN.o (J, z)))) QF.psiq QC.psiq =
    apH {W0.Ix (XB.RH.F0.ob (J, z))} {W0.Ix (XB.RH.F1.ob (TR.RN.o (J, z)))} (XB.extV (J, z)) Leq ;
  } ;
  faceP : W0.Ix (DL.faceEq I x PN.tP) = \ r lq ->
   FE[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (r.2.2.2.2.2.2.2, lq)].law ;
 } ;
} ;
