-- The finite cofactor vector as an actual type over a variable base
-- context.  Each equation contributes one copy of the ring carrier;
-- the empty list contributes the fibrant unit type.  The list is fixed
-- in the metatheory, while the coefficients vary over the context.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Ring[a++] ;
module V1 = V[a+] ;
module PR = CPilotRing[a, a+] ;
C : CwF.CwF[a++] = PR.C ;
SS : CwF.Formers[a++, C].SigStr = FibCwF[a, a+].fibSig ;
module OV = CwFOv.Ov[a++, C, FibCwF[a, a+].fibPi, SS, FibId[a, a+].fibId] ;

module Cofactor (G : C.Ctx) (Rg : PR.HRing[G]) {
 E : U a++ = C.El G Rg.R ;
 UnitT : C.Ty G = CConst[a, a+].ConstOf[CCyl[a].PosCyl.posCyl, V1.unitV].constS G ;
 CofT : List E -> C.Ty G = split {
  nil -> UnitT ;
  cons f fs | ih -> SS.Sig G Rg.R (OV.wkT G Rg.R ih) } ;
 Ctx (fs : List E) : C.Ctx = C.ext G (CofT fs) ;
} ;
