-- CTotLvl.seg (canonicity-c2; SIMPLIFIED.md step 4): the levelwise input
-- of the fibration half of Lemma 12, part 1.  U of the base of the strict
-- fibre of ev_e at the total site against the levelwise one: a line of G
-- at (J, z) with an element of A at its end restricts (rho) to a levelwise
-- line of U G with an element of U A at its end (s), naturally (s-nat).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;

module Lvl (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P13 = CTotPsi13[a, vl, l].Psi13[C, G, A, e] ;
 module PO = P13.PO ;
 module TR = PO.TR ;
 module G0 = TR.G0 ;
 module G1 = TR.G1 ;
 module TC = PO.TC ;
 module UF = CTotUFib[a, vl, l].UFib[C] ;
 module EKm = UF.Ek[PO.GP, A, e] ;
 module EK1 = EKm.EK1 ;
 module EK0 = EKm.EK0 ;
 module RH = EKm.XB.RH ;
 Ob0 : U vl = TR.RN.Ob0 ;
 DU : TR.P0.PCtx = TR.RS.rC (TC.toP P13.TVT) ;
 SU : TR.P0.PTy[DU] = TR.RS.rT (TC.toP P13.TVT) P13.SF' ;
 module PT (Y : Ob0) (x : W0.Ix (DU.ob Y)) {
  x1 : W0.Ix (RH.F1.ob (TR.RN.o Y)) = EK1.TV.pr1 (TR.RN.o Y) x ;
  b1 : W0.Ix (A.tob (TR.RN.o Y) ((RH.F1.ev e).nt (TR.RN.o Y) x1)) = EK1.TV.pr2 (TR.RN.o Y) x ;
  x0 : W0.Ix (RH.F0.ob Y) = RH.rhoV Y x1 ;
  pe : PB.IvP Y.1 = G1.GB.ptH (TR.RN.o Y) e ;
  end1 : W0.Ix (G.ob Y.1 Y.2) = (RH.F1.ev e).nt (TR.RN.o Y) x1 ;
  end0 : W0.Ix (G.ob Y.1 Y.2) = (RH.F0.ev e).nt Y x0 ;
  pth : Id (W0.Ix (G.ob Y.1 Y.2)) end1 end0 =
   apH {TC.THm (TR.RN.o Y) (TR.RN.o Y)} {W0.Ix (G.ob Y.1 Y.2)} (\ k -> x1.1 (TR.RN.o Y) k pe) (symH (TR.fn.onId Y)) ;
  b0 : W0.Ix (A.tob (TR.RN.o Y) end0) = EK1.TA.coeT (TR.RN.o Y) end1 end0 pth b1 ;
  sv : EK0.TV.EI Y = EK0.TV.pr Y x0 b0 ;
  pc : Id (EK1.TA.EI (TR.RN.o Y)) (EK0.endE Y sv) (EK1.endE (TR.RN.o Y) x) = symH (EK1.TA.pr-coe (TR.RN.o Y) end1 end0 pth b1) ;
 } ;
 s (Y : Ob0) (x : W0.Ix (DU.ob Y)) : EK0.TV.EI Y = PT[Y, x].sv ;
 sNat (Z Y : Ob0) (h : TR.RN.Hom0 Z Y) (x : W0.Ix (DU.ob Y))
  : Id (EK0.TV.EI Z) (s Z (DU.act Z Y h x)) (EK0.TV.E.act Z Y h (s Y x)) =
  EK0.tv-eq Z (s Z (DU.act Z Y h x)) (EK0.TV.E.act Z Y h (s Y x)) (RH.rho.nt-nat Z Y h PT[Y, x].x1)
   (transH PT[Z, DU.act Z Y h x].pc
     (transH (EK1.endE-act (TR.RN.o Z) (TR.RN.o Y) (TR.fn.onH Z Y h) x)
       (transH (apH {EK1.TA.EI (TR.RN.o Y)} {EK1.TA.EI (TR.RN.o Z)} (\ t -> EK1.TA.E.act (TR.RN.o Z) (TR.RN.o Y) (TR.fn.onH Z Y h) t) (symH PT[Y, x].pc))
         (symH (EK0.endE-act Z Y h (s Y x)))))) ;
} ;
