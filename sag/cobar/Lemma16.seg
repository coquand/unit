-- Lemma16.seg (canonicity-45; jonas.pdf Lemma 16, COBAR.md "Lemma 16"):
-- the zig-zag homotopy K : (D tau_A)[tau_G] ~ tau_DAC at every x, from the
-- D^2 A lines p, q of the paper (meets on the two blocks of a concatenated
-- weight), composed with the fibrancy of (D DAC)[tau_G] (Lemma 12 at DAC).
--   DAC, D2     D A over G (Cor15) and D of it over D G; B2 x = (D DAC)[tau_G]
--   dTau        D tau_A pulled back along tau_G, as an NMap DAC_x -> B2_x
--   MW2         the double reading of u : DAC_x at (cat c' c , Wf (j' , i))
--               for a weight family Wf with its restriction and face laws:
--               an element of B2_x (inner equations in (c , i), outer in
--               (c' , j')), the Lemma 14 MW pattern nested once
-- Part 1: dTau, the reading and its point equation.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module HO = PB.CHtpyOps[l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;
module Pa = Prelude[a] ;

module L16 (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A : CPshC[a, l].CPsh[C].CTy[G]) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module D = DD.DC[G] ;
 module DA = DD.DT[G, A] ;
 module C15 = Cor15[a, l].C15[C, G, A] ;
 DAC : P.CTy[G] = C15.DAC ;
 module D2 = DD.DT[G, DAC] ;
 module L14 = Lemma14[a, l].L14[C, G, A] ;
 module L14D = Lemma14[a, l].L14[C, G, DAC] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module DF = P13.DF[G, A, DAC, C15.tauA] ;
 open P ;

 -- (D DAC)[tau_G] at x
 B2 (x : CO) : PTy[G.ob x] = L14D.B x ;

 ------------------------------------------------------------------
 -- D tau_A pulled back along tau_G: u |-> D tau_A at the point tau gm

 module DTm (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((DAC.ty x).tob I gm)) {
  module M = DF.DM[x, I, (D.tauX x).nt I gm, u] ;
  res : W0.Ix ((B2 x).tob I gm) = M.res ;
 } ;

 -- naturality in the base (DF.DN.eqv at the points tau gm, tau gm')
 module DTN (x : CO) (J I : Ob) (f : Hom J I) (gm : W0.Ix ((G.ob x).ob I)) (gm' : W0.Ix ((G.ob x).ob J))
  (e : Id (W0.Ix ((G.ob x).ob J)) ((G.ob x).act J I f gm) gm') (u : W0.Ix ((DAC.ty x).tob I gm)) {
  d : D.Ob' x I = (D.tauX x).nt I gm ;
  d' : D.Ob' x J = (D.tauX x).nt J gm' ;
  ed : Id (D.Ob' x J) (D.BA[x, J, I, f, d].res) d' = ntEq (G.ob x) (D.obD x) (D.tauX x) J I f gm gm' e ;
  module M1 = DF.DM[x, I, d, u] ;
  module TBb = D2.TB[x, J, I, f, d, d', ed, M1.res] ;
  module TBa = DA.TB[x, J, I, f, d, d', ed, u] ;
  module M2 = DF.DM[x, J, d', TBa.res] ;
  nat : Id (W0.Ix ((B2 x).tob J gm')) ((B2 x).tact J I f gm gm' e DTm[x, I, gm, u].res) DTm[x, J, gm', (DAC.ty x).tact J I f gm gm' e u].res =
   D2.tob-eq x J d' TBb.res M2.res (\ q l ->
    GPR.TyL[G.ob q.2.1, DAC.ty q.2.1].pr-inj q.2.2.2.1 (d'.1 q l) (TBb.res.1 q l) (M2.res.1 q l)
     (transH (TBb.pc q l)
       (transH (M1.pc (TBb.sh q) l)
         (transH (apH ((C15.tauA.mp q.2.1).mE q.2.2.2.1) (symH (TBa.pc q l)))
           (symH (M2.pc q l)))))) ;
 } ;

 dTau (x : CO) : HO.NMap[G.ob x, DAC.ty x, B2 x] =
  new HO.NMap[G.ob x, DAC.ty x, B2 x, \ I gm u -> DTm[x, I, gm, u].res, \ J I f gm gm' e u -> DTN[x, J, I, f, gm, gm', e, u].nat] ;

 -- tau on DAC
 tauD (x : CO) : HO.NMap[G.ob x, DAC.ty x, B2 x] = L14D.tauN x ;

 ------------------------------------------------------------------
 -- weights transported along an equality of arities, and the reading of
 -- u at a transported index

 substP (J : Ob) (N N' : Nat) (p : Id Nat N N') (w : Wt.Pn N J) : Wt.Pn N' J = subst Nat (\ M -> Wt.Pn M J) N N' p w ;

 module RD (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((DAC.ty x).tob I gm)) {
  tg : D.Ob' x I = (D.tauX x).nt I gm ;
  -- the reading of u at (N , z , c , J' , g , w), in E_z
  rd (N : Nat) (z : CO) (c : K.Ch N x z) (J' : Ob) (g : Hom J' I) (w : Wt.Pn N J') : W0.Ix (DA.Ez z J') =
   DA.prz z J' (tg.1 (N, z, c, J', g, w.1) w.2) (u.1 (N, z, c, J', g, w.1) w.2) ;
  -- at a transported index
  rdTr (N N' : Nat) (e : Id Nat N N') (z : CO) (c : K.Ch N x z) (J' : Ob) (g : Hom J' I) (w : Wt.Pn N J')
   : Id (W0.Ix (DA.Ez z J')) (rd N z c J' g w) (rd N' z (K.trCh N N' e x z c) J' g (substP J' N N' e w)) =
   idJ Nat N (\ N2 e2 -> Id (W0.Ix (DA.Ez z J')) (rd N z c J' g w) (rd N2 z (K.trCh N N2 e2 x z c) J' g (substP J' N N2 e2 w)))
    (refl (rd N z c J' g w)) N' e ;
 } ;

 ------------------------------------------------------------------
 -- the double reading: at the outer index (m , y , c' , J , g , j') and
 -- the inner index (n , z , c , J' , g' , i), u at (cat c' c , J' , g g' ,
 -- Wf (j'|g') i), as an element of A_z over the point of tau at y

 -- helpers: the weights' arities, restriction twice, faces at equal positions
 plusLe : (m : Nat) -> (k n : Nat) (hk : Tr.IsT (Tr.leb k n)) -> Tr.IsT (Tr.leb (Ar.plus m (suc k)) (Ar.plus m (suc n))) = split {
  zero -> \ k n hk -> hk ;
  suc m' | ih -> \ k n hk -> ih k n hk } ;
 module U12 = Lemma12[a, l].L12[C, G, A] ;
 resRes (n : Nat) (J'' J' J : Ob) (h : Hom J'' J') (g' : Hom J' J) (p : Wt.Pn n J)
  : Id (Wt.Pn n J'') (Wt.Res[n, J'', J', h, Wt.Res[n, J', J, g', p].res].res) (Wt.Res[n, J'', J, PB.compH J'' J' J g' h, p].res) =
  L14.pnEq n J'' _ _ (\ k -> PB.comp-assoc J'' J' J PB.Iv (p.1 k) g' h) ;
 facePos (n : Nat) (J : Ob) (y y' : Nat) (e : Id Nat y y') (hy : Tr.IsT (Tr.leb y (suc n))) (hy' : Tr.IsT (Tr.leb y' (suc n))) (p : Wt.Pn n J)
  : Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[p].face) (Wt.Face[n, J, y', hy'].Of[p].face) =
  idJ Nat y (\ y2 e2 -> (hy2 : Tr.IsT (Tr.leb y2 (suc n))) -> Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[p].face) (Wt.Face[n, J, y2, hy2].Of[p].face))
   (\ hy2 -> U12.faceW-irr n J y hy hy2 p) y' e hy' ;

 module MW2 (Wf : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((DAC.ty x).tob I gm)) (t : Hom I PB.Iv) {
  module R = RD[x, I, gm, u] ;
  tg : D.Ob' x I = R.tg ;

  -- the outer index: the point gm_y of G_y and the point of tau at y
  module Outer (q' : DD.Idx x I) (l' : DD.LandsI x I q') {
   m : Nat = q'.1 ;
   y : CO = q'.2.1 ;
   c' : K.Ch q'.1 x q'.2.1 = q'.2.2.1 ;
   J : Ob = q'.2.2.2.1 ;
   g : Hom q'.2.2.2.1 I = q'.2.2.2.2.1 ;
   jP : Wt.Pn q'.1 q'.2.2.2.1 = (q'.2.2.2.2.2, l') ;
   gmy : W0.Ix ((G.ob q'.2.1).ob q'.2.2.2.1) = tg.1 q' l' ;
   tgy : D.Ob' q'.2.1 q'.2.2.2.1 = (D.tauX q'.2.1).nt q'.2.2.2.1 gmy ;

   -- the inner index
   module Inner (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) {
    n : Nat = q.1 ;
    z : CO = q.2.1 ;
    c : K.Ch q.1 q'.2.1 q.2.1 = q.2.2.1 ;
    J' : Ob = q.2.2.2.1 ;
    g' : Hom q.2.2.2.1 q'.2.2.2.1 = q.2.2.2.2.1 ;
    iP : Wt.Pn q.1 q.2.2.2.1 = (q.2.2.2.2.2, li) ;
    N : Nat = Ar.plus q'.1 (suc q.1) ;
    cc : K.Ch (Ar.plus q'.1 (suc q.1)) x q.2.1 = K.cat q'.1 q.1 x q'.2.1 q.2.1 c' c ;
    gg : Hom q.2.2.2.1 I = PB.compH q.2.2.2.1 q'.2.2.2.1 I g g' ;
    jr : Wt.Pn q'.1 q.2.2.2.1 = Wt.Res[q'.1, q.2.2.2.1, q'.2.2.2.1, g', jP].res ;
    w : Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 = Wf q'.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t gg) jr iP ;
    idx : DD.Idx x I = (N, z, cc, J', gg, w.1) ;
    ldx : DD.LandsI x I idx = w.2 ;
    -- the point of tau at x at idx is the point of tau at y at q
    Pm : Id (W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (tg.1 idx ldx) (tgy.1 q li) =
     transH (apH (\ k -> (G.act z x k).nt J' ((G.ob x).act J' I gg gm)) (K.tot-cat m n x y z c' c))
      (transH (G.act-o z y x (K.tot m x y c') (K.tot n y z c) J' ((G.ob x).act J' I gg gm))
        (apH ((G.act z y (K.tot n y z c)).nt J')
          (transH (apH ((G.act y x (K.tot m x y c')).nt J') ((G.ob x).act-o J' J I g g' gm))
            ((G.act y x (K.tot m x y c')).nt-nat J' J g' ((G.ob x).act J I g gm))))) ;
    -- the value, and its reading in E_z
    val : W0.Ix ((A.ty q.2.1).tob q.2.2.2.1 (tgy.1 q li)) =
     GPR.TyL[G.ob z, A.ty z].coeT J' (tg.1 idx ldx) (tgy.1 q li) Pm (u.1 idx ldx) ;
    pc : Id (W0.Ix (DA.Ez z J')) (DA.prz z J' (tgy.1 q li) val) (R.rd N z cc J' gg w) =
     symH (GPR.TyL[G.ob z, A.ty z].pr-coe J' (tg.1 idx ldx) (tgy.1 q li) Pm (u.1 idx ldx)) ;
   } ;

   -- the inner family, and the data of Inner as functions (for the lambdas)
   iv : DA.TA q'.2.1 q'.2.2.2.1 tgy = \ q li -> (Inner[q, li].val) ;
   pcOf (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (tgy.1 q li) (iv q li)) (R.rd (Inner[q, li].N) q.2.1 (Inner[q, li].cc) q.2.2.2.1 (Inner[q, li].gg) (Inner[q, li].w)) = (Inner[q, li].pc) ;
   idxOf (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : DD.Idx x I = (Inner[q, li].idx) ;
   ldxOf (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : DD.LandsI x I (idxOf q li) = (Inner[q, li].ldx) ;
   ccOf (q : DD.Idx q'.2.1 q'.2.2.2.1) : K.Ch (Ar.plus q'.1 (suc q.1)) x q.2.1 = K.cat q'.1 q.1 x q'.2.1 q.2.1 c' q.2.2.1 ;
   ggOf (q : DD.Idx q'.2.1 q'.2.2.2.1) : Hom q.2.2.2.1 I = PB.compH q.2.2.2.1 q'.2.2.2.1 I g q.2.2.2.2.1 ;
   jrOf (q : DD.Idx q'.2.1 q'.2.2.2.1) : Wt.Pn q'.1 q.2.2.2.1 = Wt.Res[q'.1, q.2.2.2.1, q'.2.2.2.1, q.2.2.2.2.1, jP].res ;
   wOf (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 =
    Wf q'.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (ggOf q)) (jrOf q) (q.2.2.2.2.2, li) ;

   -- naturality in the base: restrict along h : J'' -> J'
   inat : W0.Ix (DA.anatEq q'.2.1 q'.2.2.2.1 tgy iv) = \ r li ->
    transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pcOf r.1 li))
     (transH (u.2.1 (idxOf r.1 li, r.2) (ldxOf r.1 li))
       (transH (apH (R.rd (Ar.plus m (suc r.1.1)) r.1.2.1 (ccOf r.1) r.2.1 (PB.compH r.2.1 r.1.2.2.2.1 I (ggOf r.1) r.2.2))
                  (Wres m r.1.1 r.2.1 r.1.2.2.2.1 r.2.2 (PB.compH r.1.2.2.2.1 I PB.Iv t (ggOf r.1)) (jrOf r.1) (r.1.2.2.2.2.2, li)))
         (transH (apH (\ t' -> R.rd (Ar.plus m (suc r.1.1)) r.1.2.1 (ccOf r.1) r.2.1 (PB.compH r.2.1 r.1.2.2.2.1 I (ggOf r.1) r.2.2)
                               (Wf m r.1.1 r.2.1 t' (Wt.Res[m, r.2.1, r.1.2.2.2.1, r.2.2, jrOf r.1].res) (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res)))
                    (PB.comp-assoc r.2.1 r.1.2.2.2.1 I PB.Iv t (ggOf r.1) r.2.2))
           (transH (apH (\ k -> R.rd (Ar.plus m (suc r.1.1)) r.1.2.1 (ccOf r.1) r.2.1 k
                                 (Wf m r.1.1 r.2.1 (PB.compH r.2.1 I PB.Iv t k) (Wt.Res[m, r.2.1, r.1.2.2.2.1, r.2.2, jrOf r.1].res) (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res)))
                      (PB.comp-assoc r.2.1 r.1.2.2.2.1 J I g r.1.2.2.2.2.1 r.2.2))
             (transH (apH (\ jj -> R.rd (Ar.plus m (suc r.1.1)) r.1.2.1 (ccOf r.1) r.2.1 (PB.compH r.2.1 J I g (PB.compH r.2.1 r.1.2.2.2.1 J r.1.2.2.2.2.1 r.2.2))
                                   (Wf m r.1.1 r.2.1 (PB.compH r.2.1 I PB.Iv t (PB.compH r.2.1 J I g (PB.compH r.2.1 r.1.2.2.2.1 J r.1.2.2.2.2.1 r.2.2))) jj
                                      (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res)))
                        (resRes m r.2.1 r.1.2.2.2.1 J r.2.2 r.1.2.2.2.2.1 jP))
               (symH (pcOf (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 J r.1.2.2.2.2.1 r.2.2, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res).1)
                           (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res).2))))))) ;

   -- the inner faces: the face k of c is the face m+1+k of cat c' c (comp-back)
   module IF (r : VA.Ix (D.faceIdxV q'.2.1 q'.2.2.2.1)) (li : D.faceLd q'.2.1 q'.2.2.2.1 r) {
    module Ia = Inner[(suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF q'.2.1 q'.2.2.2.1 r li).1), (DA.afaceF q'.2.1 q'.2.2.2.1 r li).2] ;
    module Ib = Inner[(r.1, r.2.2.2.1, K.comp r.1 r.2.1 q'.2.1 r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2), li] ;
    N' : Nat = Ar.plus m (suc r.1) ;
    z : CO = r.2.2.2.1 ;
    J' : Ob = r.2.2.2.2.2.1 ;
    cS : K.Ch (suc (Ar.plus m (suc r.1))) x r.2.2.2.1 = K.catS m r.1 x y r.2.2.2.1 c' r.2.2.2.2.1 ;
    hkU : Tr.IsT (Tr.leb (Ar.plus m (suc r.2.1)) (Ar.plus m (suc r.1))) = plusLe m r.2.1 r.1 r.2.2.1 ;
    eq : Id (W0.Ix (DA.Ez r.2.2.2.1 r.2.2.2.2.2.1)) (DA.afaceL q'.2.1 q'.2.2.2.1 tgy iv r li) (DA.afaceR q'.2.1 q'.2.2.2.1 tgy iv r li) =
     transH Ia.pc
      (transH (R.rdTr (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1)) z Ia.cc J' Ia.gg Ia.w)
        (transH (apH (R.rd (suc N') z cS J' Ia.gg) (WfaceR m r.1 J' (PB.compH J' I PB.Iv t Ia.gg) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1) Ib.jr Ib.iP))
          (transH (apH (R.rd (suc N') z cS J' Ia.gg)
                     (U12.faceW-irr N' J' (Ar.plus m (suc r.2.1)) (Wt.hRB m r.1 r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1)) (Ar.leb-step (Ar.plus m (suc r.2.1)) N' hkU) Ib.w))
            (transH (u.2.2.1 (N', Ar.plus m (suc r.2.1), hkU, z, cS, J', Ia.gg, Ib.w.1) Ib.w.2)
              (transH (apH (\ ch -> R.rd N' z ch J' Ia.gg Ib.w) (K.comp-back m r.1 r.2.1 x y z c' r.2.2.2.2.1))
                (symH Ib.pc)))))) ;
   } ;
   iface : W0.Ix (DA.afaceEq q'.2.1 q'.2.2.2.1 tgy iv) = \ r li -> IF[r, li].eq ;

   -- the top face: the top face of cat c' c is the top face of c (drop-cat)
   module IT (r : VA.Ix (D.topIdxV q'.2.1 q'.2.2.2.1)) (li : D.topLd q'.2.1 q'.2.2.2.1 r) {
    module Ia = Inner[(suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF q'.2.1 q'.2.2.2.1 r li).1), (DA.atopF q'.2.1 q'.2.2.2.1 r li).2] ;
    dr : K.DR r.1 q'.2.1 r.2.1 = K.drop r.1 q'.2.1 r.2.1 r.2.2.1 ;
    module Ib = Inner[(r.1, dr.1, dr.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2), li] ;
    N' : Nat = Ar.plus m (suc r.1) ;
    z : CO = r.2.1 ;
    J' : Ob = r.2.2.2.1 ;
    cS : K.Ch (suc (Ar.plus m (suc r.1))) x r.2.1 = K.catS m r.1 x y r.2.1 c' r.2.2.1 ;
    eq : Id (W0.Ix (DA.Ez r.2.1 r.2.2.2.1)) (DA.atopL q'.2.1 q'.2.2.2.1 tgy iv r li) (DA.atopR q'.2.1 q'.2.2.2.1 tgy iv r li) =
     transH Ia.pc
      (transH (R.rdTr (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1)) z Ia.cc J' Ia.gg Ia.w)
        (transH (apH (R.rd (suc N') z cS J' Ia.gg) (WfaceR m r.1 J' (PB.compH J' I PB.Iv t Ia.gg) (suc r.1) (Tr.leb-refl (suc r.1)) Ib.jr Ib.iP))
          (transH (apH (R.rd (suc N') z cS J' Ia.gg)
                     (facePos N' J' (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1))
                        (Wt.hRB m r.1 (suc r.1) (Tr.leb-refl (suc r.1))) (Tr.leb-refl (suc N')) Ib.w))
            (transH (u.2.2.2 (N', z, cS, J', Ia.gg, Ib.w.1) Ib.w.2)
              (transH (apH (\ Dd -> (A.tE z Dd.1 Dd.2.2).nt J' (R.rd N' Dd.1 Dd.2.1 J' Ia.gg Ib.w)) (K.drop-cat m r.1 x y z c' r.2.2.1))
                (apH ((A.tE z dr.1 dr.2.2).nt J') (symH Ib.pc))))))) ;
   } ;
   itop : W0.Ix (DA.atopEq q'.2.1 q'.2.2.2.1 tgy iv) = \ r li -> IT[r, li].eq ;

   -- the inner element: the value of the D^2 element at (c' , j')
   ires : DA.TOb' q'.2.1 q'.2.2.2.1 tgy = (iv, inat, iface, itop) ;
  } ;

  -- the outer family: at (c' , j') the inner element
  ov : D2.TA x I tg = \ q' l' -> Outer[q', l'].ires ;
  module SCm = C15.SCm ;
  -- the readings of the outer values at an inner index, as functions
  rdO (q' : DD.Idx x I) (l' : DD.LandsI x I q') (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : W0.Ix (DA.Ez q.2.1 q.2.2.2.1) =
   R.rd (Ar.plus q'.1 (suc q.1)) q.2.1 (Outer[q', l'].ccOf q) q.2.2.2.1 (Outer[q', l'].ggOf q) (Outer[q', l'].wOf q li) ;
  pcO (q' : DD.Idx x I) (l' : DD.LandsI x I q') (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q)
   : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 ((Outer[q', l'].tgy).1 q li) ((Outer[q', l'].ires).1 q li)) (rdO q' l' q li) =
   Outer[q', l'].pcOf q li ;

  -- outer naturality: restrict the outer index along h : J2 -> J
  module ON (r : VA.Ix (D.natIdxV x I)) (l' : DD.LandsI x I r.1) {
   module Oa = Outer[r.1, l'] ;
   q'h : DD.Idx x I = (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 I r.1.2.2.2.2.1 r.2.2, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).1) ;
   l'h : DD.LandsI x I q'h = (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).2 ;
   module OB = Outer[q'h, l'h] ;
   y : CO = r.1.2.1 ;
   J2 : Ob = r.2.1 ;
   pp : Id (W0.Ix ((G.ob r.1.2.1).ob r.2.1)) ((G.ob r.1.2.1).act r.2.1 r.1.2.2.2.1 r.2.2 Oa.gmy) OB.gmy = tg.2.1 r l' ;
   gmh : W0.Ix ((G.ob r.1.2.1).ob r.2.1) = (G.ob r.1.2.1).act r.2.1 r.1.2.2.2.1 r.2.2 Oa.gmy ;
   module TB = DA.TB[r.1.2.1, r.2.1, r.1.2.2.2.1, r.2.2, Oa.tgy, (D.tauX r.1.2.1).nt r.2.1 gmh,
                     ntEq (G.ob r.1.2.1) (D.obD r.1.2.1) (D.tauX r.1.2.1) r.2.1 r.1.2.2.2.1 r.2.2 Oa.gmy gmh (refl gmh), Oa.ires] ;
   H (q : DD.Idx r.1.2.1 r.2.1) (li : DD.LandsI r.1.2.1 r.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (((D.tauX r.1.2.1).nt r.2.1 gmh).1 q li) (TB.res.1 q li))
         (DA.prz q.2.1 q.2.2.2.1 (OB.tgy.1 q li) (OB.ires.1 q li)) =
    transH (TB.pc q li)
     (transH (pcO r.1 l' (TB.sh q) li)
       (transH (apH (\ k -> R.rd (Ar.plus r.1.1 (suc q.1)) q.2.1 (OB.ccOf q) q.2.2.2.1 k
                             (Wf r.1.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t k) (Wt.Res[r.1.1, q.2.2.2.1, r.1.2.2.2.1, PB.compH q.2.2.2.1 r.2.1 r.1.2.2.2.1 r.2.2 q.2.2.2.2.1, Oa.jP].res) (q.2.2.2.2.2, li)))
                  (symH (PB.comp-assoc q.2.2.2.1 r.2.1 r.1.2.2.2.1 I r.1.2.2.2.2.1 r.2.2 q.2.2.2.2.1)))
         (transH (apH (\ jj -> R.rd (Ar.plus r.1.1 (suc q.1)) q.2.1 (OB.ccOf q) q.2.2.2.1 (OB.ggOf q)
                               (Wf r.1.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (OB.ggOf q)) jj (q.2.2.2.2.2, li)))
                    (symH (resRes r.1.1 q.2.2.2.1 r.2.1 r.1.2.2.2.1 q.2.2.2.2.1 r.2.2 Oa.jP)))
           (symH (pcO q'h l'h q li))))) ;
   eq : Id (W0.Ix (D2.Ez r.1.2.1 r.2.1)) (D2.anatL x I tg ov r l') (D2.anatR x I tg ov r l') =
    SCm.sub-eq r.1.2.1 r.2.1 (D2.anatL x I tg ov r l') (D2.anatR x I tg ov r l') pp
     (DA.totD-eq r.1.2.1 r.2.1 _ _ (apH ((D.tauX r.1.2.1).nt r.2.1) pp) H) ;
  } ;
  onat : W0.Ix (D2.anatEq x I tg ov) = \ r l' -> ON[r, l'].eq ;

  -- the bounds of the outer face positions inside the concatenation
  leZ (n : Nat) : (k : Nat) -> (hk : Tr.IsT (Tr.leb k zero)) -> Tr.IsT (Tr.leb k (suc n)) = split {
   zero -> \ hk -> refl true ;
   suc k -> \ hk -> absurd (Tr.IsT (Tr.leb (suc k) (suc n))) (Tr.false-true hk) } ;
  leS (m' : Nat) (ih : (n k : Nat) (hk : Tr.IsT (Tr.leb k m')) -> Tr.IsT (Tr.leb k (Ar.plus m' (suc n)))) (n : Nat)
   : (k : Nat) -> (hk : Tr.IsT (Tr.leb k (suc m'))) -> Tr.IsT (Tr.leb k (suc (Ar.plus m' (suc n)))) = split {
   zero -> \ hk -> refl true ;
   suc k -> \ hk -> ih n k hk } ;
  leCat : (m : Nat) -> (n k : Nat) (hk : Tr.IsT (Tr.leb k m)) -> Tr.IsT (Tr.leb k (Ar.plus m (suc n))) = split {
   zero -> \ n k hk -> leZ n k hk ;
   suc m' | ih -> \ n k hk -> leS m' ih n k hk } ;
  leSuc : (m : Nat) -> (n : Nat) -> Tr.IsT (Tr.leb (suc m) (Ar.plus m (suc n))) = split {
   zero -> \ n -> refl true ;
   suc m' | ih -> \ n -> ih n } ;

  -- outer faces in the first block (cat-left)
  module OF (r : VA.Ix (D.faceIdxV x I)) (l' : D.faceLd x I r) {
   q'a : DD.Idx x I = (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (D2.afaceF x I r l').1) ;
   l'a : DD.LandsI x I q'a = (D2.afaceF x I r l').2 ;
   q'b : DD.Idx x I = (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) ;
   module Oa = Outer[q'a, l'a] ;
   module OB = Outer[q'b, l'] ;
   y : CO = r.2.2.2.1 ;
   J : Ob = r.2.2.2.2.2.1 ;
   pp : Id (W0.Ix ((G.ob r.2.2.2.1).ob r.2.2.2.2.2.1)) Oa.gmy OB.gmy = tg.2.2.1 r l' ;
   H (q : DD.Idx r.2.2.2.1 r.2.2.2.2.2.1) (li : DD.LandsI r.2.2.2.1 r.2.2.2.2.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (Oa.tgy.1 q li) (Oa.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (OB.tgy.1 q li) (OB.ires.1 q li)) =
    transH (pcO q'a l'a q li)
     (transH (apH (\ jj -> R.rd (Ar.plus (suc r.1) (suc q.1)) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q) (Wf (suc r.1) q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (Oa.ggOf q)) jj (q.2.2.2.2.2, li)))
                (Wt.RF[r.1, r.2.2.2.2.2.1, q.2.2.2.1, q.2.2.2.2.1, r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1, (r.2.2.2.2.2.2.2, l')].resFace))
       (transH (apH (R.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q))
                  (WfaceL r.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (Oa.ggOf q)) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1) (OB.jrOf q) (q.2.2.2.2.2, li)))
         (transH (apH (R.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q))
                    (U12.faceW-irr (Ar.plus r.1 (suc q.1)) q.2.2.2.1 r.2.1 (Wt.hkB r.1 q.1 r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1))
                       (Ar.leb-step r.2.1 (Ar.plus r.1 (suc q.1)) (leCat r.1 q.1 r.2.1 r.2.2.1)) (OB.wOf q li)))
           (transH (u.2.2.1 (Ar.plus r.1 (suc q.1), r.2.1, leCat r.1 q.1 r.2.1 r.2.2.1, q.2.1, Oa.ccOf q, q.2.2.2.1, Oa.ggOf q, (OB.wOf q li).1) (OB.wOf q li).2)
             (transH (apH (\ ch -> R.rd (Ar.plus r.1 (suc q.1)) q.2.1 ch q.2.2.2.1 (Oa.ggOf q) (OB.wOf q li))
                        (K.cat-left r.1 q.1 r.2.1 r.2.2.1 x r.2.2.2.1 q.2.1 r.2.2.2.2.1 q.2.2.1))
               (symH (pcO q'b l' q li))))))) ;
   eq : Id (W0.Ix (D2.Ez r.2.2.2.1 r.2.2.2.2.2.1)) (D2.afaceL x I tg ov r l') (D2.afaceR x I tg ov r l') =
    SCm.sub-eq r.2.2.2.1 r.2.2.2.2.2.1 (D2.afaceL x I tg ov r l') (D2.afaceR x I tg ov r l') pp
     (DA.totD-eq r.2.2.2.1 r.2.2.2.2.2.1 _ _ (apH ((D.tauX r.2.2.2.1).nt r.2.2.2.2.2.1) pp) H) ;
  } ;
  oface : W0.Ix (D2.afaceEq x I tg ov) = \ r l' -> OF[r, l'].eq ;

  -- the outer top face: the C-action of DAC along the last map of c' (cat-junction)
  module OT (r : VA.Ix (D.topIdxV x I)) (l' : D.topLd x I r) {
   q'a : DD.Idx x I = (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (D2.atopF x I r l').1) ;
   l'a : DD.LandsI x I q'a = (D2.atopF x I r l').2 ;
   dr : K.DR r.1 x r.2.1 = K.drop r.1 x r.2.1 r.2.2.1 ;
   q'b : DD.Idx x I = (r.1, dr.1, dr.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) ;
   module Oa = Outer[q'a, l'a] ;
   module OB = Outer[q'b, l'] ;
   y : CO = r.2.1 ;
   y' : CO = dr.1 ;
   f : CH r.2.1 dr.1 = dr.2.2 ;
   J : Ob = r.2.2.2.1 ;
   pp : Id (W0.Ix ((G.ob r.2.1).ob r.2.2.2.1)) Oa.gmy ((G.act r.2.1 dr.1 dr.2.2).nt r.2.2.2.1 OB.gmy) = tg.2.2.2 r l' ;
   -- the point of tau at y, moved: tau's naturality in C
   P' : Id (D.Ob' r.2.1 r.2.2.2.1) Oa.tgy (D.CA[r.2.1, dr.1, dr.2.2, r.2.2.2.1, OB.tgy].res) =
    transH (apH ((D.tauX r.2.1).nt r.2.2.2.1) pp) (D.tau.sb-nat r.2.1 dr.1 dr.2.2 r.2.2.2.1 OB.gmy) ;
   module CT = DA.CT[r.2.1, dr.1, dr.2.2, r.2.2.2.1, OB.tgy, OB.ires] ;
   H (q : DD.Idx r.2.1 r.2.2.2.1) (li : DD.LandsI r.2.1 r.2.2.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (Oa.tgy.1 q li) (Oa.ires.1 q li))
         (DA.prz q.2.1 q.2.2.2.1 ((D.CA[r.2.1, dr.1, dr.2.2, r.2.2.2.1, OB.tgy].res).1 q li) (CT.res.1 q li)) =
    transH (pcO q'a l'a q li)
     (transH (apH (\ jj -> R.rd (Ar.plus (suc r.1) (suc q.1)) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q) (Wf (suc r.1) q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (Oa.ggOf q)) jj (q.2.2.2.2.2, li)))
                (Wt.RF[r.1, r.2.2.2.1, q.2.2.2.1, q.2.2.2.2.1, suc r.1, Tr.leb-refl (suc r.1), (r.2.2.2.2.2, l')].resFace))
       (transH (apH (R.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q))
                  (WfaceL r.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (Oa.ggOf q)) (suc r.1) (Tr.leb-refl (suc r.1)) (OB.jrOf (CT.rq q)) (q.2.2.2.2.2, li)))
         (transH (apH (R.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q))
                    (U12.faceW-irr (Ar.plus r.1 (suc q.1)) q.2.2.2.1 (suc r.1) (Wt.hkB r.1 q.1 (suc r.1) (Tr.leb-refl (suc r.1)))
                       (Ar.leb-step (suc r.1) (Ar.plus r.1 (suc q.1)) (leSuc r.1 q.1)) (OB.wOf (CT.rq q) li)))
           (transH (u.2.2.1 (Ar.plus r.1 (suc q.1), suc r.1, leSuc r.1 q.1, q.2.1, Oa.ccOf q, q.2.2.2.1, Oa.ggOf q, (OB.wOf (CT.rq q) li).1) (OB.wOf (CT.rq q) li).2)
             (transH (apH (\ ch -> R.rd (Ar.plus r.1 (suc q.1)) q.2.1 ch q.2.2.2.1 (Oa.ggOf q) (OB.wOf (CT.rq q) li))
                        (K.cat-junction r.1 q.1 x r.2.1 q.2.1 r.2.2.1 q.2.2.1))
               (symH (pcO q'b l' (CT.rq q) li))))))) ;
   eq : Id (W0.Ix (D2.Ez r.2.1 r.2.2.2.1)) (D2.atopL x I tg ov r l') (D2.atopR x I tg ov r l') =
    SCm.sub-eq r.2.1 r.2.2.2.1 (D2.atopL x I tg ov r l') (D2.atopR x I tg ov r l') pp
     (transH (DA.totD-eq r.2.1 r.2.2.2.1 _ _ P' H) (symH (SCm.rBtE r.2.1 dr.1 dr.2.2 r.2.2.2.1 (D2.prz dr.1 r.2.2.2.1 OB.gmy OB.ires)))) ;
  } ;
  otop : W0.Ix (D2.atopEq x I tg ov) = \ r l' -> OT[r, l'].eq ;

  -- the element of (D DAC)[tau] at (I , gm)
  res : W0.Ix ((B2 x).tob I gm) = (ov, onat, oface, otop) ;
 } ;
} ;
