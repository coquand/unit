-- Lemma16.seg (canonicity-45; jonas.pdf Lemma 16, COBAR.md "Lemma 16"):
-- the zig-zag homotopy K : (D tau_A)[tau_G] ~ tau_DAC at every x, from the
-- D^2 A lines p, q of the paper (meets on the two blocks of a concatenated
-- weight), composed with the fibrancy of (D DAC)[tau_G] (Lemma 12 at DAC).
--   DAC, D2     D A over G (Cor15) and D of it over D G; B2 x = (D DAC)[tau_G]
--   dTau        D tau_A pulled back along tau_G, as an NMap DAC_x -> B2_x
--   MW2         the double reading of u : DAC_x at (cat c' c , Wf (j' , i))
--               for a weight family Wf with its restriction and face laws:
--               an element of B2_x (inner equations in (c , i), outer in
--               (c' , j')), the Lemma 14 MW pattern nested once
-- Part 1: dTau, the reading and its point equation.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module HO = PB.CHtpyOps[l] ;
module CE = PB.CEquiv[l] ;
module LR = CLocBoundRetr[a, l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;
module Pa = Prelude[a] ;

module L16 (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A : CPshC[a, l].CPsh[C].CTy[G]) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module D = DD.DC[G] ;
 module DA = DD.DT[G, A] ;
 module C15 = Cor15[a, l].C15[C, G, A] ;
 DAC : P.CTy[G] = C15.DAC ;
 module D2 = DD.DT[G, DAC] ;
 module L14 = Lemma14[a, l].L14[C, G, A] ;
 module L14D = Lemma14[a, l].L14[C, G, DAC] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module DF = P13.DF[G, A, DAC, C15.tauA] ;
 open P ;

 -- (D DAC)[tau_G] at x
 B2 (x : CO) : PTy[G.ob x] = L14D.B x ;

 ------------------------------------------------------------------
 -- D tau_A pulled back along tau_G: u |-> D tau_A at the point tau gm

 module DTm (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((DAC.ty x).tob I gm)) {
  module M = DF.DM[x, I, (D.tauX x).nt I gm, u] ;
  res : W0.Ix ((B2 x).tob I gm) = M.res ;
 } ;

 -- naturality in the base (DF.DN.eqv at the points tau gm, tau gm')
 module DTN (x : CO) (J I : Ob) (f : Hom J I) (gm : W0.Ix ((G.ob x).ob I)) (gm' : W0.Ix ((G.ob x).ob J))
  (e : Id (W0.Ix ((G.ob x).ob J)) ((G.ob x).act J I f gm) gm') (u : W0.Ix ((DAC.ty x).tob I gm)) {
  d : D.Ob' x I = (D.tauX x).nt I gm ;
  d' : D.Ob' x J = (D.tauX x).nt J gm' ;
  ed : Id (D.Ob' x J) (D.BA[x, J, I, f, d].res) d' = ntEq (G.ob x) (D.obD x) (D.tauX x) J I f gm gm' e ;
  module M1 = DF.DM[x, I, d, u] ;
  module TBb = D2.TB[x, J, I, f, d, d', ed, M1.res] ;
  module TBa = DA.TB[x, J, I, f, d, d', ed, u] ;
  module M2 = DF.DM[x, J, d', TBa.res] ;
  nat : Id (W0.Ix ((B2 x).tob J gm')) ((B2 x).tact J I f gm gm' e DTm[x, I, gm, u].res) DTm[x, J, gm', (DAC.ty x).tact J I f gm gm' e u].res =
   D2.tob-eq x J d' TBb.res M2.res (\ q l ->
    GPR.TyL[G.ob q.2.1, DAC.ty q.2.1].pr-inj q.2.2.2.1 (d'.1 q l) (TBb.res.1 q l) (M2.res.1 q l)
     (transH (TBb.pc q l)
       (transH (M1.pc (TBb.sh q) l)
         (transH (apH ((C15.tauA.mp q.2.1).mE q.2.2.2.1) (symH (TBa.pc q l)))
           (symH (M2.pc q l)))))) ;
 } ;

 dTau (x : CO) : HO.NMap[G.ob x, DAC.ty x, B2 x] =
  new HO.NMap[G.ob x, DAC.ty x, B2 x, \ I gm u -> DTm[x, I, gm, u].res, \ J I f gm gm' e u -> DTN[x, J, I, f, gm, gm', e, u].nat] ;

 -- tau on DAC
 tauD (x : CO) : HO.NMap[G.ob x, DAC.ty x, B2 x] = L14D.tauN x ;

 ------------------------------------------------------------------
 -- weights transported along an equality of arities, and the reading of
 -- u at a transported index

 substP (J : Ob) (N N' : Nat) (p : Id Nat N N') (w : Wt.Pn N J) : Wt.Pn N' J = subst Nat (\ M -> Wt.Pn M J) N N' p w ;

 module RD (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((DAC.ty x).tob I gm)) {
  tg : D.Ob' x I = (D.tauX x).nt I gm ;
  -- the reading of u at (N , z , c , J' , g , w), in E_z
  rd (N : Nat) (z : CO) (c : K.Ch N x z) (J' : Ob) (g : Hom J' I) (w : Wt.Pn N J') : W0.Ix (DA.Ez z J') =
   DA.prz z J' (tg.1 (N, z, c, J', g, w.1) w.2) (u.1 (N, z, c, J', g, w.1) w.2) ;
  -- at a transported index
  rdTr (N N' : Nat) (e : Id Nat N N') (z : CO) (c : K.Ch N x z) (J' : Ob) (g : Hom J' I) (w : Wt.Pn N J')
   : Id (W0.Ix (DA.Ez z J')) (rd N z c J' g w) (rd N' z (K.trCh N N' e x z c) J' g (substP J' N N' e w)) =
   idJ Nat N (\ N2 e2 -> Id (W0.Ix (DA.Ez z J')) (rd N z c J' g w) (rd N2 z (K.trCh N N2 e2 x z c) J' g (substP J' N N2 e2 w)))
    (refl (rd N z c J' g w)) N' e ;
 } ;

 ------------------------------------------------------------------
 -- the double reading: at the outer index (m , y , c' , J , g , j') and
 -- the inner index (n , z , c , J' , g' , i), u at (cat c' c , J' , g g' ,
 -- Wf (j'|g') i), as an element of A_z over the point of tau at y

 -- helpers: the weights' arities, restriction twice, faces at equal positions
 plusLe : (m : Nat) -> (k n : Nat) (hk : Tr.IsT (Tr.leb k n)) -> Tr.IsT (Tr.leb (Ar.plus m (suc k)) (Ar.plus m (suc n))) = split {
  zero -> \ k n hk -> hk ;
  suc m' | ih -> \ k n hk -> ih k n hk } ;
 module U12 = Lemma12[a, l].L12[C, G, A] ;
 resRes (n : Nat) (J'' J' J : Ob) (h : Hom J'' J') (g' : Hom J' J) (p : Wt.Pn n J)
  : Id (Wt.Pn n J'') (Wt.Res[n, J'', J', h, Wt.Res[n, J', J, g', p].res].res) (Wt.Res[n, J'', J, PB.compH J'' J' J g' h, p].res) =
  L14.pnEq n J'' _ _ (\ k -> PB.comp-assoc J'' J' J PB.Iv (p.1 k) g' h) ;
 facePos (n : Nat) (J : Ob) (y y' : Nat) (e : Id Nat y y') (hy : Tr.IsT (Tr.leb y (suc n))) (hy' : Tr.IsT (Tr.leb y' (suc n))) (p : Wt.Pn n J)
  : Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[p].face) (Wt.Face[n, J, y', hy'].Of[p].face) =
  idJ Nat y (\ y2 e2 -> (hy2 : Tr.IsT (Tr.leb y2 (suc n))) -> Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[p].face) (Wt.Face[n, J, y2, hy2].Of[p].face))
   (\ hy2 -> U12.faceW-irr n J y hy hy2 p) y' e hy' ;

 module MW2 (Wf : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((DAC.ty x).tob I gm)) (t : Hom I PB.Iv) {
  module R = RD[x, I, gm, u] ;
  tg : D.Ob' x I = R.tg ;

  -- the outer index: the point gm_y of G_y and the point of tau at y
  module Outer (q' : DD.Idx x I) (l' : DD.LandsI x I q') {
   m : Nat = q'.1 ;
   y : CO = q'.2.1 ;
   c' : K.Ch q'.1 x q'.2.1 = q'.2.2.1 ;
   J : Ob = q'.2.2.2.1 ;
   g : Hom q'.2.2.2.1 I = q'.2.2.2.2.1 ;
   jP : Wt.Pn q'.1 q'.2.2.2.1 = (q'.2.2.2.2.2, l') ;
   gmy : W0.Ix ((G.ob q'.2.1).ob q'.2.2.2.1) = tg.1 q' l' ;
   tgy : D.Ob' q'.2.1 q'.2.2.2.1 = (D.tauX q'.2.1).nt q'.2.2.2.1 gmy ;

   -- the inner index
   module Inner (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) {
    n : Nat = q.1 ;
    z : CO = q.2.1 ;
    c : K.Ch q.1 q'.2.1 q.2.1 = q.2.2.1 ;
    J' : Ob = q.2.2.2.1 ;
    g' : Hom q.2.2.2.1 q'.2.2.2.1 = q.2.2.2.2.1 ;
    iP : Wt.Pn q.1 q.2.2.2.1 = (q.2.2.2.2.2, li) ;
    N : Nat = Ar.plus q'.1 (suc q.1) ;
    cc : K.Ch (Ar.plus q'.1 (suc q.1)) x q.2.1 = K.cat q'.1 q.1 x q'.2.1 q.2.1 c' c ;
    gg : Hom q.2.2.2.1 I = PB.compH q.2.2.2.1 q'.2.2.2.1 I g g' ;
    jr : Wt.Pn q'.1 q.2.2.2.1 = Wt.Res[q'.1, q.2.2.2.1, q'.2.2.2.1, g', jP].res ;
    w : Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 = Wf q'.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t gg) jr iP ;
    idx : DD.Idx x I = (N, z, cc, J', gg, w.1) ;
    ldx : DD.LandsI x I idx = w.2 ;
    -- the point of tau at x at idx is the point of tau at y at q
    Pm : Id (W0.Ix ((G.ob q.2.1).ob q.2.2.2.1)) (tg.1 idx ldx) (tgy.1 q li) =
     transH (apH (\ k -> (G.act z x k).nt J' ((G.ob x).act J' I gg gm)) (K.tot-cat m n x y z c' c))
      (transH (G.act-o z y x (K.tot m x y c') (K.tot n y z c) J' ((G.ob x).act J' I gg gm))
        (apH ((G.act z y (K.tot n y z c)).nt J')
          (transH (apH ((G.act y x (K.tot m x y c')).nt J') ((G.ob x).act-o J' J I g g' gm))
            ((G.act y x (K.tot m x y c')).nt-nat J' J g' ((G.ob x).act J I g gm))))) ;
    -- the value, and its reading in E_z
    val : W0.Ix ((A.ty q.2.1).tob q.2.2.2.1 (tgy.1 q li)) =
     GPR.TyL[G.ob z, A.ty z].coeT J' (tg.1 idx ldx) (tgy.1 q li) Pm (u.1 idx ldx) ;
    pc : Id (W0.Ix (DA.Ez z J')) (DA.prz z J' (tgy.1 q li) val) (R.rd N z cc J' gg w) =
     symH (GPR.TyL[G.ob z, A.ty z].pr-coe J' (tg.1 idx ldx) (tgy.1 q li) Pm (u.1 idx ldx)) ;
   } ;

   -- the inner family, and the data of Inner as functions (for the lambdas)
   iv : DA.TA q'.2.1 q'.2.2.2.1 tgy = \ q li -> (Inner[q, li].val) ;
   pcOf (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (tgy.1 q li) (iv q li)) (R.rd (Inner[q, li].N) q.2.1 (Inner[q, li].cc) q.2.2.2.1 (Inner[q, li].gg) (Inner[q, li].w)) = (Inner[q, li].pc) ;
   idxOf (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : DD.Idx x I = (Inner[q, li].idx) ;
   ldxOf (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : DD.LandsI x I (idxOf q li) = (Inner[q, li].ldx) ;
   ccOf (q : DD.Idx q'.2.1 q'.2.2.2.1) : K.Ch (Ar.plus q'.1 (suc q.1)) x q.2.1 = K.cat q'.1 q.1 x q'.2.1 q.2.1 c' q.2.2.1 ;
   ggOf (q : DD.Idx q'.2.1 q'.2.2.2.1) : Hom q.2.2.2.1 I = PB.compH q.2.2.2.1 q'.2.2.2.1 I g q.2.2.2.2.1 ;
   jrOf (q : DD.Idx q'.2.1 q'.2.2.2.1) : Wt.Pn q'.1 q.2.2.2.1 = Wt.Res[q'.1, q.2.2.2.1, q'.2.2.2.1, q.2.2.2.2.1, jP].res ;
   wOf (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 =
    Wf q'.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (ggOf q)) (jrOf q) (q.2.2.2.2.2, li) ;

   -- naturality in the base: restrict along h : J'' -> J'
   inat : W0.Ix (DA.anatEq q'.2.1 q'.2.2.2.1 tgy iv) = \ r li ->
    transH (apH ((extP (G.ob r.1.2.1) (A.ty r.1.2.1)).act r.2.1 r.1.2.2.2.1 r.2.2) (pcOf r.1 li))
     (transH (u.2.1 (idxOf r.1 li, r.2) (ldxOf r.1 li))
       (transH (apH (R.rd (Ar.plus m (suc r.1.1)) r.1.2.1 (ccOf r.1) r.2.1 (PB.compH r.2.1 r.1.2.2.2.1 I (ggOf r.1) r.2.2))
                  (Wres m r.1.1 r.2.1 r.1.2.2.2.1 r.2.2 (PB.compH r.1.2.2.2.1 I PB.Iv t (ggOf r.1)) (jrOf r.1) (r.1.2.2.2.2.2, li)))
         (transH (apH (\ t' -> R.rd (Ar.plus m (suc r.1.1)) r.1.2.1 (ccOf r.1) r.2.1 (PB.compH r.2.1 r.1.2.2.2.1 I (ggOf r.1) r.2.2)
                               (Wf m r.1.1 r.2.1 t' (Wt.Res[m, r.2.1, r.1.2.2.2.1, r.2.2, jrOf r.1].res) (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res)))
                    (PB.comp-assoc r.2.1 r.1.2.2.2.1 I PB.Iv t (ggOf r.1) r.2.2))
           (transH (apH (\ k -> R.rd (Ar.plus m (suc r.1.1)) r.1.2.1 (ccOf r.1) r.2.1 k
                                 (Wf m r.1.1 r.2.1 (PB.compH r.2.1 I PB.Iv t k) (Wt.Res[m, r.2.1, r.1.2.2.2.1, r.2.2, jrOf r.1].res) (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res)))
                      (PB.comp-assoc r.2.1 r.1.2.2.2.1 J I g r.1.2.2.2.2.1 r.2.2))
             (transH (apH (\ jj -> R.rd (Ar.plus m (suc r.1.1)) r.1.2.1 (ccOf r.1) r.2.1 (PB.compH r.2.1 J I g (PB.compH r.2.1 r.1.2.2.2.1 J r.1.2.2.2.2.1 r.2.2))
                                   (Wf m r.1.1 r.2.1 (PB.compH r.2.1 I PB.Iv t (PB.compH r.2.1 J I g (PB.compH r.2.1 r.1.2.2.2.1 J r.1.2.2.2.2.1 r.2.2))) jj
                                      (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res)))
                        (resRes m r.2.1 r.1.2.2.2.1 J r.2.2 r.1.2.2.2.2.1 jP))
               (symH (pcOf (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 J r.1.2.2.2.2.1 r.2.2, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res).1)
                           (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, li)].res).2))))))) ;

   -- the inner faces: the face k of c is the face m+1+k of cat c' c (comp-back)
   module IF (r : VA.Ix (D.faceIdxV q'.2.1 q'.2.2.2.1)) (li : D.faceLd q'.2.1 q'.2.2.2.1 r) {
    module Ia = Inner[(suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (DA.afaceF q'.2.1 q'.2.2.2.1 r li).1), (DA.afaceF q'.2.1 q'.2.2.2.1 r li).2] ;
    module Ib = Inner[(r.1, r.2.2.2.1, K.comp r.1 r.2.1 q'.2.1 r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2), li] ;
    N' : Nat = Ar.plus m (suc r.1) ;
    z : CO = r.2.2.2.1 ;
    J' : Ob = r.2.2.2.2.2.1 ;
    cS : K.Ch (suc (Ar.plus m (suc r.1))) x r.2.2.2.1 = K.catS m r.1 x y r.2.2.2.1 c' r.2.2.2.2.1 ;
    hkU : Tr.IsT (Tr.leb (Ar.plus m (suc r.2.1)) (Ar.plus m (suc r.1))) = plusLe m r.2.1 r.1 r.2.2.1 ;
    eq : Id (W0.Ix (DA.Ez r.2.2.2.1 r.2.2.2.2.2.1)) (DA.afaceL q'.2.1 q'.2.2.2.1 tgy iv r li) (DA.afaceR q'.2.1 q'.2.2.2.1 tgy iv r li) =
     transH Ia.pc
      (transH (R.rdTr (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1)) z Ia.cc J' Ia.gg Ia.w)
        (transH (apH (R.rd (suc N') z cS J' Ia.gg) (WfaceR m r.1 J' (PB.compH J' I PB.Iv t Ia.gg) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1) Ib.jr Ib.iP))
          (transH (apH (R.rd (suc N') z cS J' Ia.gg)
                     (U12.faceW-irr N' J' (Ar.plus m (suc r.2.1)) (Wt.hRB m r.1 r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1)) (Ar.leb-step (Ar.plus m (suc r.2.1)) N' hkU) Ib.w))
            (transH (u.2.2.1 (N', Ar.plus m (suc r.2.1), hkU, z, cS, J', Ia.gg, Ib.w.1) Ib.w.2)
              (transH (apH (\ ch -> R.rd N' z ch J' Ia.gg Ib.w) (K.comp-back m r.1 r.2.1 x y z c' r.2.2.2.2.1))
                (symH Ib.pc)))))) ;
   } ;
   iface : W0.Ix (DA.afaceEq q'.2.1 q'.2.2.2.1 tgy iv) = \ r li -> IF[r, li].eq ;

   -- the top face: the top face of cat c' c is the top face of c (drop-cat)
   module IT (r : VA.Ix (D.topIdxV q'.2.1 q'.2.2.2.1)) (li : D.topLd q'.2.1 q'.2.2.2.1 r) {
    module Ia = Inner[(suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (DA.atopF q'.2.1 q'.2.2.2.1 r li).1), (DA.atopF q'.2.1 q'.2.2.2.1 r li).2] ;
    dr : K.DR r.1 q'.2.1 r.2.1 = K.drop r.1 q'.2.1 r.2.1 r.2.2.1 ;
    module Ib = Inner[(r.1, dr.1, dr.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2), li] ;
    N' : Nat = Ar.plus m (suc r.1) ;
    z : CO = r.2.1 ;
    J' : Ob = r.2.2.2.1 ;
    cS : K.Ch (suc (Ar.plus m (suc r.1))) x r.2.1 = K.catS m r.1 x y r.2.1 c' r.2.2.1 ;
    eq : Id (W0.Ix (DA.Ez r.2.1 r.2.2.2.1)) (DA.atopL q'.2.1 q'.2.2.2.1 tgy iv r li) (DA.atopR q'.2.1 q'.2.2.2.1 tgy iv r li) =
     transH Ia.pc
      (transH (R.rdTr (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1)) z Ia.cc J' Ia.gg Ia.w)
        (transH (apH (R.rd (suc N') z cS J' Ia.gg) (WfaceR m r.1 J' (PB.compH J' I PB.Iv t Ia.gg) (suc r.1) (Tr.leb-refl (suc r.1)) Ib.jr Ib.iP))
          (transH (apH (R.rd (suc N') z cS J' Ia.gg)
                     (facePos N' J' (Ar.plus m (suc (suc r.1))) (suc N') (Ar.plus-suc m (suc r.1))
                        (Wt.hRB m r.1 (suc r.1) (Tr.leb-refl (suc r.1))) (Tr.leb-refl (suc N')) Ib.w))
            (transH (u.2.2.2 (N', z, cS, J', Ia.gg, Ib.w.1) Ib.w.2)
              (transH (apH (\ Dd -> (A.tE z Dd.1 Dd.2.2).nt J' (R.rd N' Dd.1 Dd.2.1 J' Ia.gg Ib.w)) (K.drop-cat m r.1 x y z c' r.2.2.1))
                (apH ((A.tE z dr.1 dr.2.2).nt J') (symH Ib.pc))))))) ;
   } ;
   itop : W0.Ix (DA.atopEq q'.2.1 q'.2.2.2.1 tgy iv) = \ r li -> IT[r, li].eq ;

   -- the inner element: the value of the D^2 element at (c' , j')
   ires : DA.TOb' q'.2.1 q'.2.2.2.1 tgy = (iv, inat, iface, itop) ;
  } ;

  -- the outer family: at (c' , j') the inner element
  ov : D2.TA x I tg = \ q' l' -> Outer[q', l'].ires ;
  module SCm = C15.SCm ;
  -- the readings of the outer values at an inner index, as functions
  rdO (q' : DD.Idx x I) (l' : DD.LandsI x I q') (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q) : W0.Ix (DA.Ez q.2.1 q.2.2.2.1) =
   R.rd (Ar.plus q'.1 (suc q.1)) q.2.1 (Outer[q', l'].ccOf q) q.2.2.2.1 (Outer[q', l'].ggOf q) (Outer[q', l'].wOf q li) ;
  pcO (q' : DD.Idx x I) (l' : DD.LandsI x I q') (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q)
   : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 ((Outer[q', l'].tgy).1 q li) ((Outer[q', l'].ires).1 q li)) (rdO q' l' q li) =
   Outer[q', l'].pcOf q li ;

  -- outer naturality: restrict the outer index along h : J2 -> J
  module ON (r : VA.Ix (D.natIdxV x I)) (l' : DD.LandsI x I r.1) {
   module Oa = Outer[r.1, l'] ;
   q'h : DD.Idx x I = (r.1.1, r.1.2.1, r.1.2.2.1, r.2.1, PB.compH r.2.1 r.1.2.2.2.1 I r.1.2.2.2.2.1 r.2.2, (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).1) ;
   l'h : DD.LandsI x I q'h = (Wt.Res[r.1.1, r.2.1, r.1.2.2.2.1, r.2.2, (r.1.2.2.2.2.2, l')].res).2 ;
   module OB = Outer[q'h, l'h] ;
   y : CO = r.1.2.1 ;
   J2 : Ob = r.2.1 ;
   pp : Id (W0.Ix ((G.ob r.1.2.1).ob r.2.1)) ((G.ob r.1.2.1).act r.2.1 r.1.2.2.2.1 r.2.2 Oa.gmy) OB.gmy = tg.2.1 r l' ;
   gmh : W0.Ix ((G.ob r.1.2.1).ob r.2.1) = (G.ob r.1.2.1).act r.2.1 r.1.2.2.2.1 r.2.2 Oa.gmy ;
   module TB = DA.TB[r.1.2.1, r.2.1, r.1.2.2.2.1, r.2.2, Oa.tgy, (D.tauX r.1.2.1).nt r.2.1 gmh,
                     ntEq (G.ob r.1.2.1) (D.obD r.1.2.1) (D.tauX r.1.2.1) r.2.1 r.1.2.2.2.1 r.2.2 Oa.gmy gmh (refl gmh), Oa.ires] ;
   H (q : DD.Idx r.1.2.1 r.2.1) (li : DD.LandsI r.1.2.1 r.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (((D.tauX r.1.2.1).nt r.2.1 gmh).1 q li) (TB.res.1 q li))
         (DA.prz q.2.1 q.2.2.2.1 (OB.tgy.1 q li) (OB.ires.1 q li)) =
    transH (TB.pc q li)
     (transH (pcO r.1 l' (TB.sh q) li)
       (transH (apH (\ k -> R.rd (Ar.plus r.1.1 (suc q.1)) q.2.1 (OB.ccOf q) q.2.2.2.1 k
                             (Wf r.1.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t k) (Wt.Res[r.1.1, q.2.2.2.1, r.1.2.2.2.1, PB.compH q.2.2.2.1 r.2.1 r.1.2.2.2.1 r.2.2 q.2.2.2.2.1, Oa.jP].res) (q.2.2.2.2.2, li)))
                  (symH (PB.comp-assoc q.2.2.2.1 r.2.1 r.1.2.2.2.1 I r.1.2.2.2.2.1 r.2.2 q.2.2.2.2.1)))
         (transH (apH (\ jj -> R.rd (Ar.plus r.1.1 (suc q.1)) q.2.1 (OB.ccOf q) q.2.2.2.1 (OB.ggOf q)
                               (Wf r.1.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (OB.ggOf q)) jj (q.2.2.2.2.2, li)))
                    (symH (resRes r.1.1 q.2.2.2.1 r.2.1 r.1.2.2.2.1 q.2.2.2.2.1 r.2.2 Oa.jP)))
           (symH (pcO q'h l'h q li))))) ;
   eq : Id (W0.Ix (D2.Ez r.1.2.1 r.2.1)) (D2.anatL x I tg ov r l') (D2.anatR x I tg ov r l') =
    SCm.sub-eq r.1.2.1 r.2.1 (D2.anatL x I tg ov r l') (D2.anatR x I tg ov r l') pp
     (DA.totD-eq r.1.2.1 r.2.1 _ _ (apH ((D.tauX r.1.2.1).nt r.2.1) pp) H) ;
  } ;
  onat : W0.Ix (D2.anatEq x I tg ov) = \ r l' -> ON[r, l'].eq ;

  -- the bounds of the outer face positions inside the concatenation
  leZ (n : Nat) : (k : Nat) -> (hk : Tr.IsT (Tr.leb k zero)) -> Tr.IsT (Tr.leb k (suc n)) = split {
   zero -> \ hk -> refl true ;
   suc k -> \ hk -> absurd (Tr.IsT (Tr.leb (suc k) (suc n))) (Tr.false-true hk) } ;
  leS (m' : Nat) (ih : (n k : Nat) (hk : Tr.IsT (Tr.leb k m')) -> Tr.IsT (Tr.leb k (Ar.plus m' (suc n)))) (n : Nat)
   : (k : Nat) -> (hk : Tr.IsT (Tr.leb k (suc m'))) -> Tr.IsT (Tr.leb k (suc (Ar.plus m' (suc n)))) = split {
   zero -> \ hk -> refl true ;
   suc k -> \ hk -> ih n k hk } ;
  leCat : (m : Nat) -> (n k : Nat) (hk : Tr.IsT (Tr.leb k m)) -> Tr.IsT (Tr.leb k (Ar.plus m (suc n))) = split {
   zero -> \ n k hk -> leZ n k hk ;
   suc m' | ih -> \ n k hk -> leS m' ih n k hk } ;
  leSuc : (m : Nat) -> (n : Nat) -> Tr.IsT (Tr.leb (suc m) (Ar.plus m (suc n))) = split {
   zero -> \ n -> refl true ;
   suc m' | ih -> \ n -> ih n } ;

  -- outer faces in the first block (cat-left)
  module OF (r : VA.Ix (D.faceIdxV x I)) (l' : D.faceLd x I r) {
   q'a : DD.Idx x I = (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (D2.afaceF x I r l').1) ;
   l'a : DD.LandsI x I q'a = (D2.afaceF x I r l').2 ;
   q'b : DD.Idx x I = (r.1, r.2.2.2.1, K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) ;
   module Oa = Outer[q'a, l'a] ;
   module OB = Outer[q'b, l'] ;
   y : CO = r.2.2.2.1 ;
   J : Ob = r.2.2.2.2.2.1 ;
   pp : Id (W0.Ix ((G.ob r.2.2.2.1).ob r.2.2.2.2.2.1)) Oa.gmy OB.gmy = tg.2.2.1 r l' ;
   H (q : DD.Idx r.2.2.2.1 r.2.2.2.2.2.1) (li : DD.LandsI r.2.2.2.1 r.2.2.2.2.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (Oa.tgy.1 q li) (Oa.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (OB.tgy.1 q li) (OB.ires.1 q li)) =
    transH (pcO q'a l'a q li)
     (transH (apH (\ jj -> R.rd (Ar.plus (suc r.1) (suc q.1)) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q) (Wf (suc r.1) q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (Oa.ggOf q)) jj (q.2.2.2.2.2, li)))
                (Wt.RF[r.1, r.2.2.2.2.2.1, q.2.2.2.1, q.2.2.2.2.1, r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1, (r.2.2.2.2.2.2.2, l')].resFace))
       (transH (apH (R.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q))
                  (WfaceL r.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (Oa.ggOf q)) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1) (OB.jrOf q) (q.2.2.2.2.2, li)))
         (transH (apH (R.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q))
                    (U12.faceW-irr (Ar.plus r.1 (suc q.1)) q.2.2.2.1 r.2.1 (Wt.hkB r.1 q.1 r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1))
                       (Ar.leb-step r.2.1 (Ar.plus r.1 (suc q.1)) (leCat r.1 q.1 r.2.1 r.2.2.1)) (OB.wOf q li)))
           (transH (u.2.2.1 (Ar.plus r.1 (suc q.1), r.2.1, leCat r.1 q.1 r.2.1 r.2.2.1, q.2.1, Oa.ccOf q, q.2.2.2.1, Oa.ggOf q, (OB.wOf q li).1) (OB.wOf q li).2)
             (transH (apH (\ ch -> R.rd (Ar.plus r.1 (suc q.1)) q.2.1 ch q.2.2.2.1 (Oa.ggOf q) (OB.wOf q li))
                        (K.cat-left r.1 q.1 r.2.1 r.2.2.1 x r.2.2.2.1 q.2.1 r.2.2.2.2.1 q.2.2.1))
               (symH (pcO q'b l' q li))))))) ;
   eq : Id (W0.Ix (D2.Ez r.2.2.2.1 r.2.2.2.2.2.1)) (D2.afaceL x I tg ov r l') (D2.afaceR x I tg ov r l') =
    SCm.sub-eq r.2.2.2.1 r.2.2.2.2.2.1 (D2.afaceL x I tg ov r l') (D2.afaceR x I tg ov r l') pp
     (DA.totD-eq r.2.2.2.1 r.2.2.2.2.2.1 _ _ (apH ((D.tauX r.2.2.2.1).nt r.2.2.2.2.2.1) pp) H) ;
  } ;
  oface : W0.Ix (D2.afaceEq x I tg ov) = \ r l' -> OF[r, l'].eq ;

  -- the outer top face: the C-action of DAC along the last map of c' (cat-junction)
  module OT (r : VA.Ix (D.topIdxV x I)) (l' : D.topLd x I r) {
   q'a : DD.Idx x I = (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (D2.atopF x I r l').1) ;
   l'a : DD.LandsI x I q'a = (D2.atopF x I r l').2 ;
   dr : K.DR r.1 x r.2.1 = K.drop r.1 x r.2.1 r.2.2.1 ;
   q'b : DD.Idx x I = (r.1, dr.1, dr.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2) ;
   module Oa = Outer[q'a, l'a] ;
   module OB = Outer[q'b, l'] ;
   y : CO = r.2.1 ;
   y' : CO = dr.1 ;
   f : CH r.2.1 dr.1 = dr.2.2 ;
   J : Ob = r.2.2.2.1 ;
   pp : Id (W0.Ix ((G.ob r.2.1).ob r.2.2.2.1)) Oa.gmy ((G.act r.2.1 dr.1 dr.2.2).nt r.2.2.2.1 OB.gmy) = tg.2.2.2 r l' ;
   -- the point of tau at y, moved: tau's naturality in C
   P' : Id (D.Ob' r.2.1 r.2.2.2.1) Oa.tgy (D.CA[r.2.1, dr.1, dr.2.2, r.2.2.2.1, OB.tgy].res) =
    transH (apH ((D.tauX r.2.1).nt r.2.2.2.1) pp) (D.tau.sb-nat r.2.1 dr.1 dr.2.2 r.2.2.2.1 OB.gmy) ;
   module CT = DA.CT[r.2.1, dr.1, dr.2.2, r.2.2.2.1, OB.tgy, OB.ires] ;
   H (q : DD.Idx r.2.1 r.2.2.2.1) (li : DD.LandsI r.2.1 r.2.2.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (Oa.tgy.1 q li) (Oa.ires.1 q li))
         (DA.prz q.2.1 q.2.2.2.1 ((D.CA[r.2.1, dr.1, dr.2.2, r.2.2.2.1, OB.tgy].res).1 q li) (CT.res.1 q li)) =
    transH (pcO q'a l'a q li)
     (transH (apH (\ jj -> R.rd (Ar.plus (suc r.1) (suc q.1)) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q) (Wf (suc r.1) q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (Oa.ggOf q)) jj (q.2.2.2.2.2, li)))
                (Wt.RF[r.1, r.2.2.2.1, q.2.2.2.1, q.2.2.2.2.1, suc r.1, Tr.leb-refl (suc r.1), (r.2.2.2.2.2, l')].resFace))
       (transH (apH (R.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q))
                  (WfaceL r.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (Oa.ggOf q)) (suc r.1) (Tr.leb-refl (suc r.1)) (OB.jrOf (CT.rq q)) (q.2.2.2.2.2, li)))
         (transH (apH (R.rd (suc (Ar.plus r.1 (suc q.1))) q.2.1 (Oa.ccOf q) q.2.2.2.1 (Oa.ggOf q))
                    (U12.faceW-irr (Ar.plus r.1 (suc q.1)) q.2.2.2.1 (suc r.1) (Wt.hkB r.1 q.1 (suc r.1) (Tr.leb-refl (suc r.1)))
                       (Ar.leb-step (suc r.1) (Ar.plus r.1 (suc q.1)) (leSuc r.1 q.1)) (OB.wOf (CT.rq q) li)))
           (transH (u.2.2.1 (Ar.plus r.1 (suc q.1), suc r.1, leSuc r.1 q.1, q.2.1, Oa.ccOf q, q.2.2.2.1, Oa.ggOf q, (OB.wOf (CT.rq q) li).1) (OB.wOf (CT.rq q) li).2)
             (transH (apH (\ ch -> R.rd (Ar.plus r.1 (suc q.1)) q.2.1 ch q.2.2.2.1 (Oa.ggOf q) (OB.wOf (CT.rq q) li))
                        (K.cat-junction r.1 q.1 x r.2.1 q.2.1 r.2.2.1 q.2.2.1))
               (symH (pcO q'b l' (CT.rq q) li))))))) ;
   eq : Id (W0.Ix (D2.Ez r.2.1 r.2.2.2.1)) (D2.atopL x I tg ov r l') (D2.atopR x I tg ov r l') =
    SCm.sub-eq r.2.1 r.2.2.2.1 (D2.atopL x I tg ov r l') (D2.atopR x I tg ov r l') pp
     (transH (DA.totD-eq r.2.1 r.2.2.2.1 _ _ P' H) (symH (SCm.rBtE r.2.1 dr.1 dr.2.2 r.2.2.2.1 (D2.prz dr.1 r.2.2.2.1 OB.gmy OB.ires)))) ;
  } ;
  otop : W0.Ix (D2.atopEq x I tg ov) = \ r l' -> OT[r, l'].eq ;

  -- the element of (D DAC)[tau] at (I , gm)
  res : W0.Ix ((B2 x).tob I gm) = (ov, onat, oface, otop) ;
 } ;

 ------------------------------------------------------------------
 -- the weight families of the bridge M and of the lines p, q:
 -- cat j i, cat (meet t j) i, cat j (meet t i), with their laws

 substP-1 (J : Ob) (N N' : Nat) (e : Id Nat N N') (w : Wt.Pn N J) (k : Ar.Fin (suc N'))
  : Id (Hom J PB.Iv) ((substP J N N' e w).1 k) (Wt.substC J N N' e w.1 k) =
  idJ Nat N (\ N2 e2 -> (k2 : Ar.Fin (suc N2)) -> Id (Hom J PB.Iv) ((substP J N N2 e2 w).1 k2) (Wt.substC J N N2 e2 w.1 k2))
   (\ k2 -> refl (w.1 k2)) N' e k ;

 -- (M) concatenation
 WfCat (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) : Wt.Pn (Ar.plus m (suc n)) J = Wt.CatP[m, n, J].left j i.1 ;
 WresCat (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, WfCat m n J t j i].res)
       (WfCat m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)) =
  L14.pnEq (Ar.plus m (suc n)) J' _ _ (\ k -> Wt.catC-res m n J' J h j.1 i.1 k) ;
 WfaceLCat (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (WfCat (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
       (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[WfCat m n J t j i].face) =
  L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' -> symH (Wt.catFL m n J k hk j.1 i.1 k')) ;
 WfaceRCat (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
       (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfCat m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
       (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[WfCat m n J t j i].face) =
  L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' ->
   transH (substP-1 J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfCat m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)) k')
     (symH (Wt.catFR m n J k hk j.1 i.1 k'))) ;

 -- (p) the meet with t on the left block
 WfML (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) : Wt.Pn (Ar.plus m (suc n)) J = Wt.CatP[m, n, J].right (Wt.meetC m J t j.1) i ;
 WresML (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, WfML m n J t j i].res)
       (WfML m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)) =
  L14.pnEq (Ar.plus m (suc n)) J' _ _ (\ k ->
   transH (Wt.catC-res m n J' J h (Wt.meetC m J t j.1) i.1 k)
     (Wt.catC-congL m n J' (Wt.resC m J' J h (Wt.meetC m J t j.1)) (Wt.meetC m J' (PB.compH J' J PB.Iv t h) (Wt.resC m J' J h j.1)) (Wt.resC n J' J h i.1)
        (\ k' -> Wt.meet-res m J' J h t j.1 k') k)) ;
 WfaceLML (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (WfML (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
       (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[WfML m n J t j i].face) =
  L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' ->
   transH (Wt.catC-congL (suc m) n J (Wt.meetC (suc m) J t (Wt.Face[m, J, k, hk].faceC j.1)) (Wt.Face[m, J, k, hk].faceC (Wt.meetC m J t j.1)) i.1
             (\ k2 -> symH (Wt.MeetFace[m, J, k, hk, t, j.1].coord k2)) k')
     (symH (Wt.catFL m n J k hk (Wt.meetC m J t j.1) i.1 k'))) ;
 WfaceRML (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
       (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfML m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
       (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[WfML m n J t j i].face) =
  L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' ->
   transH (substP-1 J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfML m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)) k')
     (symH (Wt.catFR m n J k hk (Wt.meetC m J t j.1) i.1 k'))) ;

 -- (q) the meet with t on the right block
 WfMR (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) : Wt.Pn (Ar.plus m (suc n)) J = Wt.CatP[m, n, J].left j (Wt.meetC n J t i.1) ;
 WresMR (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, WfMR m n J t j i].res)
       (WfMR m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)) =
  L14.pnEq (Ar.plus m (suc n)) J' _ _ (\ k ->
   transH (Wt.catC-res m n J' J h j.1 (Wt.meetC n J t i.1) k)
     (Wt.catC-congR m n J' (Wt.resC m J' J h j.1) (Wt.resC n J' J h (Wt.meetC n J t i.1)) (Wt.meetC n J' (PB.compH J' J PB.Iv t h) (Wt.resC n J' J h i.1))
        (\ k' -> Wt.meet-res n J' J h t i.1 k') k)) ;
 WfaceLMR (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (WfMR (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
       (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[WfMR m n J t j i].face) =
  L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' -> symH (Wt.catFL m n J k hk j.1 (Wt.meetC n J t i.1) k')) ;
 WfaceRMR (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
       (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfMR m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
       (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[WfMR m n J t j i].face) =
  L14.pnEq (suc (Ar.plus m (suc n))) J _ _ (\ k' ->
   transH (substP-1 J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (WfMR m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)) k')
     (transH (apH (\ cc -> Wt.substC J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) cc k')
                (L14.coEq (Ar.plus m (suc (suc n))) J (Wt.catC m (suc n) J j.1 (Wt.meetC (suc n) J t (Wt.Face[n, J, k, hk].faceC i.1)))
                   (Wt.catC m (suc n) J j.1 (Wt.Face[n, J, k, hk].faceC (Wt.meetC n J t i.1)))
                   (Wt.catC-congR m (suc n) J j.1 (Wt.meetC (suc n) J t (Wt.Face[n, J, k, hk].faceC i.1)) (Wt.Face[n, J, k, hk].faceC (Wt.meetC n J t i.1))
                      (\ k2 -> symH (Wt.MeetFace[n, J, k, hk, t, i.1].coord k2)))))
       (symH (Wt.catFR m n J k hk j.1 (Wt.meetC n J t i.1) k')))) ;

 ------------------------------------------------------------------
 -- MW2 is natural in (I , t): the Lemma 14 MWN pattern, two levels

 module MWN2 (Wf : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (x : CO) (I' I : Ob) (h : Hom I' I) (gm : W0.Ix ((G.ob x).ob I)) (gm' : W0.Ix ((G.ob x).ob I'))
  (e : Id (W0.Ix ((G.ob x).ob I')) ((G.ob x).act I' I h gm) gm') (u : W0.Ix ((DAC.ty x).tob I gm)) (t : Hom I PB.Iv) {
  module M = MW2[Wf, Wres, WfaceL, WfaceR, x, I, gm, u, t] ;
  u' : W0.Ix ((DAC.ty x).tob I' gm') = (DAC.ty x).tact I' I h gm gm' e u ;
  module M' = MW2[Wf, Wres, WfaceL, WfaceR, x, I', gm', u', PB.compH I' I PB.Iv t h] ;
  ed : Id (D.Ob' x I') (D.BA[x, I', I, h, M.tg].res) M'.tg = ntEq (G.ob x) (D.obD x) (D.tauX x) I' I h gm gm' e ;
  module TBm = D2.TB[x, I', I, h, M.tg, M'.tg, ed, M.res] ;
  module TBu = DA.TB[x, I', I, h, M.tg, M'.tg, ed, u] ;
  -- at an outer index q' over I'
  module At (q' : DD.Idx x I') (l' : DD.LandsI x I' q') {
   module Oa = M.Outer[TBm.sh q', l'] ;
   module OB = M'.Outer[q', l'] ;
   pp : Id (W0.Ix ((G.ob q'.2.1).ob q'.2.2.2.1)) Oa.gmy OB.gmy = TBm.pe q' l' ;
   H (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (Oa.tgy.1 q li) (Oa.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (OB.tgy.1 q li) (OB.ires.1 q li)) =
    transH (M.pcO (TBm.sh q') l' q li)
       (transH (apH (\ k -> M.R.rd (Ar.plus q'.1 (suc q.1)) q.2.1 (OB.ccOf q) q.2.2.2.1 k (Wf q'.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t k) (OB.jrOf q) (q.2.2.2.2.2, li)))
                  (PB.comp-assoc q.2.2.2.1 q'.2.2.2.1 I' I h q'.2.2.2.2.1 q.2.2.2.2.1))
         (transH (apH (\ t' -> M.R.rd (Ar.plus q'.1 (suc q.1)) q.2.1 (OB.ccOf q) q.2.2.2.1 (PB.compH q.2.2.2.1 I' I h (OB.ggOf q)) (Wf q'.1 q.1 q.2.2.2.1 t' (OB.jrOf q) (q.2.2.2.2.2, li)))
                    (symH (PB.comp-assoc q.2.2.2.1 I' I PB.Iv t h (OB.ggOf q))))
           (transH (symH (TBu.pc (OB.idxOf q li) (OB.ldxOf q li)))
             (symH (M'.pcO q' l' q li))))) ;
   eq : Id (W0.Ix (D2.Ez q'.2.1 q'.2.2.2.1)) (D2.prz q'.2.1 q'.2.2.2.1 (M'.tg.1 q' l') (TBm.a' q' l')) (D2.prz q'.2.1 q'.2.2.2.1 (M'.tg.1 q' l') (M'.ov q' l')) =
    transH (TBm.pc q' l')
     (M.SCm.sub-eq q'.2.1 q'.2.2.2.1 (D2.prz q'.2.1 q'.2.2.2.1 (M.tg.1 (TBm.sh q') l') (M.ov (TBm.sh q') l')) (D2.prz q'.2.1 q'.2.2.2.1 (M'.tg.1 q' l') (M'.ov q' l')) pp
       (DA.totD-eq q'.2.1 q'.2.2.2.1 _ _ (apH ((D.tauX q'.2.1).nt q'.2.2.2.1) pp) H)) ;
  } ;
  nat : Id (W0.Ix ((B2 x).tob I' gm')) ((B2 x).tact I' I h gm gm' e M.res) M'.res =
   D2.tob-eq x I' M'.tg TBm.res M'.res (\ q' l' ->
    GPR.TyL[G.ob q'.2.1, DAC.ty q'.2.1].pr-inj q'.2.2.2.1 (M'.tg.1 q' l') (TBm.a' q' l') (M'.ov q' l') (At[q', l'].eq)) ;
 } ;

 ------------------------------------------------------------------
 -- the lines of MW2 read in the totals of B2, and the homotopy they form
 -- (Lemma 14's LN / LP)

 module LN2 (Wf : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (x : CO) {
  module TZ = GPR.TyL[G.ob x, DAC.ty x] ;
  module TX = GPR.TyL[G.ob x, B2 x] ;
  mwe (W : Ob) (z : TZ.EI W) (j : Hom W PB.Iv) : TX.EI W =
   TX.pr W (TZ.pr1 W z) (MW2[Wf, Wres, WfaceL, WfaceR, x, W, TZ.pr1 W z, TZ.pr2 W z, j].res) ;
  mwe-act (V W : Ob) (g : Hom V W) (z : TZ.EI W) (j : Hom W PB.Iv)
   : Id (TX.EI V) (TX.E.act V W g (mwe W z j)) (mwe V (TZ.E.act V W g z) (PB.compH V W PB.Iv j g)) =
   transH (TX.pr-tact V W g (TZ.pr1 W z) ((G.ob x).act V W g (TZ.pr1 W z)) (refl ((G.ob x).act V W g (TZ.pr1 W z)))
             (MW2[Wf, Wres, WfaceL, WfaceR, x, W, TZ.pr1 W z, TZ.pr2 W z, j].res))
    (apH (TX.pr V ((G.ob x).act V W g (TZ.pr1 W z)))
       (MWN2[Wf, Wres, WfaceL, WfaceR, x, V, W, g, TZ.pr1 W z, (G.ob x).act V W g (TZ.pr1 W z), refl ((G.ob x).act V W g (TZ.pr1 W z)), TZ.pr2 W z, j].nat)) ;
 } ;

 module LP2 (Wf : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (x : CO) (al be : HO.NMap[G.ob x, DAC.ty x, B2 x])
  (en0 : (X : Ob) (z : W0.Ix ((extP (G.ob x) (DAC.ty x)).ob X))
     -> Id (GPR.TyL[G.ob x, B2 x].EI X) (LN2[Wf, Wres, WfaceL, WfaceR, x].mwe X z (PB.ptH X PB.e0)) (HO.HT[G.ob x, DAC.ty x, B2 x, al, be].aE X z))
  (en1 : (X : Ob) (z : W0.Ix ((extP (G.ob x) (DAC.ty x)).ob X))
     -> Id (GPR.TyL[G.ob x, B2 x].EI X) (LN2[Wf, Wres, WfaceL, WfaceR, x].mwe X z (PB.ptH X PB.e1)) (HO.HT[G.ob x, DAC.ty x, B2 x, al, be].bE X z)) {
  module H = HO.HT[G.ob x, DAC.ty x, B2 x, al, be] ;
  module LNx = LN2[Wf, Wres, WfaceL, WfaceR, x] ;
  module TZ = LNx.TZ ;
  module TX = LNx.TX ;
  module EL = GPR.PshL[TZ.E] ;
  val (X : Ob) (z : W0.Ix (H.GA.ob X)) (W : Ob) (f : Hom W X) (j : Hom W PB.Iv) : TX.EI W = LNx.mwe W (TZ.E.act W X f z) j ;
  path (X : Ob) (z : W0.Ix (H.GA.ob X)) : W0.Ix (H.PT.tobP X z) =
   H.PT.mkPath X z (val X z)
    (\ V W g f j -> transH (LNx.mwe-act V W g (TZ.E.act W X f z) j) (apH (\ w -> LNx.mwe V w (PB.compH V W PB.Iv j g)) (EL.actC V W X f g z)))
    (\ W f j -> refl ((G.ob x).act W X f (TZ.pr1 X z)))
    (transH (apH (\ w -> LNx.mwe X w (PB.ptH X PB.e0)) (EL.actId X (PB.idH X) (refl (PB.idH X)) z)) (en0 X z))
    (transH (apH (\ w -> LNx.mwe X w (PB.ptH X PB.e1)) (EL.actId X (PB.idH X) (refl (PB.idH X)) z)) (en1 X z)) ;
  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (H.GA.ob I)) (z' : W0.Ix (H.GA.ob J)) (e : Id (W0.Ix (H.GA.ob J)) (H.GA.act J I h z) z')
   : Id (W0.Ix (H.PT.tobP J z')) (H.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
   H.PT.path-eq J z' (H.PT.PathP.tact J I h z z' e (path I z)) (path J z')
    (\ V f j -> apH (\ w -> LNx.mwe V w j) (transH (symH (EL.actC V J I h f z)) (apH (TZ.E.act V J f) e))) ;
  res : PEl[H.GA, H.PT.PathP] = new PEl[H.GA, H.PT.PathP, path, enat] ;
 } ;

 -- MW2 only depends on the weights it reads
 module MWEq2 (Wf : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (Vf : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Vres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PB.Iv) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Vf m n J t j i].res)
          (Vf m n J' (PB.compH J' J PB.Iv t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (VfaceL : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Vf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Vf m n J t j i].face))
  (VfaceR : (m n : Nat) (J : Ob) (t : Hom J PB.Iv) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Vf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Vf m n J t j i].face))
  (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((DAC.ty x).tob I gm)) (t t' : Hom I PB.Iv)
  (Hw : (q' : DD.Idx x I) (l' : DD.LandsI x I q') (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q)
     -> Id (Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.2.2.1)
          (Wf q'.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t (PB.compH q.2.2.2.1 q'.2.2.2.1 I q'.2.2.2.2.1 q.2.2.2.2.1)) (Wt.Res[q'.1, q.2.2.2.1, q'.2.2.2.1, q.2.2.2.2.1, (q'.2.2.2.2.2, l')].res) (q.2.2.2.2.2, li))
          (Vf q'.1 q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 I PB.Iv t' (PB.compH q.2.2.2.1 q'.2.2.2.1 I q'.2.2.2.2.1 q.2.2.2.2.1)) (Wt.Res[q'.1, q.2.2.2.1, q'.2.2.2.1, q.2.2.2.2.1, (q'.2.2.2.2.2, l')].res) (q.2.2.2.2.2, li))) {
  module M = MW2[Wf, Wres, WfaceL, WfaceR, x, I, gm, u, t] ;
  module M' = MW2[Vf, Vres, VfaceL, VfaceR, x, I, gm, u, t'] ;
  eq : Id (W0.Ix ((B2 x).tob I gm)) M.res M'.res =
   D2.tob-eq x I M.tg M.res M'.res (\ q' l' ->
    GPR.TyL[G.ob q'.2.1, DAC.ty q'.2.1].pr-inj q'.2.2.2.1 (M.tg.1 q' l') (M.ov q' l') (M'.ov q' l')
     (M.SCm.sub-eq q'.2.1 q'.2.2.2.1 (D2.prz q'.2.1 q'.2.2.2.1 (M.tg.1 q' l') (M.ov q' l')) (D2.prz q'.2.1 q'.2.2.2.1 (M.tg.1 q' l') (M'.ov q' l')) (refl (M.tg.1 q' l'))
       (DA.totD-eq q'.2.1 q'.2.2.2.1 _ _ (refl ((D.tauX q'.2.1).nt q'.2.2.2.1 (M.tg.1 q' l'))) (\ q li ->
         transH (M.pcO q' l' q li)
          (transH (apH (M.R.rd (Ar.plus q'.1 (suc q.1)) q.2.1 (M.Outer[q', l'].ccOf q) q.2.2.2.1 (M.Outer[q', l'].ggOf q)) (Hw q' l' q li))
            (symH (M'.pcO q' l' q li))))))) ;
 } ;

 ------------------------------------------------------------------
 -- the ends t = 0 of the lines: the weights (zeros on one block) and the
 -- iterated faces of u

 -- the top face of zeros is zeros
 zerosTopB (n : Nat) (J : Ob) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : (b : Bool) -> (e : Id Bool (eqN k (suc n)) b)
  -> Id (Hom J PB.Iv) (Wt.Face[n, J, suc n, Tr.leb-refl (suc n)].valB (Wt.zeros n J) k hk b e) (PB.ptH J PB.e0) = split {
  true -> \ e -> refl (PB.ptH J PB.e0) ;
  false -> \ e -> refl (PB.ptH J PB.e0) } ;
 zerosTop (n : Nat) (J : Ob) (t : Ar.Fin (suc (suc n))) : Id (Hom J PB.Iv) (Wt.Face[n, J, suc n, Tr.leb-refl (suc n)].faceC (Wt.zeros n J) t) (Wt.zeros (suc n) J t) =
  zerosTopB n J t.1 t.2 (eqN t.1 (suc n)) (refl (eqN t.1 (suc n))) ;

 -- cat j (0) is the top face of j (with the arities m+1 = suc (m+0) and m = m+0 transported)
 czB1 (J : Ob) (j : Wt.Coords zero J) : (k' : Nat) -> (h : Tr.IsT (Ar.ltb (suc k') (suc (suc zero))))
  -> Id (Hom J PB.Iv) (Wt.consB zero J (j (zero, refl true)) (Wt.zeros zero J) (suc k') h)
       (Wt.Face[zero, J, suc zero, Tr.leb-refl (suc zero)].valB j (suc k') h (eqN (suc k') (suc zero)) (refl (eqN (suc k') (suc zero)))) = split {
  zero -> \ h -> refl (PB.ptH J PB.e0) ;
  suc k'' -> \ h -> absurd (Id (Hom J PB.Iv) (Wt.consB zero J (j (zero, refl true)) (Wt.zeros zero J) (suc (suc k'')) h)
                       (Wt.Face[zero, J, suc zero, Tr.leb-refl (suc zero)].valB j (suc (suc k'')) h (eqN (suc (suc k'')) (suc zero)) (refl (eqN (suc (suc k'')) (suc zero)))))
                    (Tr.false-true h) } ;
 czB (J : Ob) (j : Wt.Coords zero J) : (k : Nat) -> (h : Tr.IsT (Ar.ltb k (suc (suc zero))))
  -> Id (Hom J PB.Iv) (Wt.consB zero J (j (zero, refl true)) (Wt.zeros zero J) k h)
       (Wt.Face[zero, J, suc zero, Tr.leb-refl (suc zero)].valB j k h (eqN k (suc zero)) (refl (eqN k (suc zero)))) = split {
  zero -> \ h -> apH j (Ar.fin-eq (suc zero) (zero, refl true) (Ar.dg zero (suc zero) zero, Ar.dg-range zero (suc zero) zero h) (refl zero)) ;
  suc k' -> czB1 J j k' } ;
 catZeroTop : (m : Nat) -> (J : Ob) -> (j : Wt.Coords m J) -> (t : Ar.Fin (suc (suc (Ar.plus m zero))))
  -> Id (Hom J PB.Iv) (Wt.substC J (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) (Wt.catC m zero J j (Wt.zeros zero J)) t)
       (Wt.Face[Ar.plus m zero, J, suc (Ar.plus m zero), Tr.leb-refl (suc (Ar.plus m zero))].faceC (Wt.substC J m (Ar.plus m zero) (K.pzm m) j) t) = split {
  zero -> \ J j t -> czB J j t.1 t.2 ;
  suc m' | ih -> \ J j t ->
   transH (Wt.substCons J (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) (j (zero, refl true)) (Wt.catC m' zero J (Wt.tailC m' J j) (Wt.zeros zero J)) t)
    (transH (Wt.consC-cong (suc (Ar.plus m' zero)) J (j (zero, refl true))
               (Wt.substC J (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) (Wt.catC m' zero J (Wt.tailC m' J j) (Wt.zeros zero J)))
               (Wt.Face[Ar.plus m' zero, J, suc (Ar.plus m' zero), Tr.leb-refl (suc (Ar.plus m' zero))].faceC (Wt.substC J m' (Ar.plus m' zero) (K.pzm m') (Wt.tailC m' J j)))
               (ih J (Wt.tailC m' J j)) t.1 t.2)
      (transH (symH (Wt.FaceCons[Ar.plus m' zero, J, suc (Ar.plus m' zero), Tr.leb-refl (suc (Ar.plus m' zero)), j (zero, refl true), Wt.substC J m' (Ar.plus m' zero) (K.pzm m') (Wt.tailC m' J j)].coord t))
        (transH (Wt.FaceIrr[suc (Ar.plus m' zero), J, suc (suc (Ar.plus m' zero)), Tr.leb-refl (suc (Ar.plus m' zero)), Tr.leb-refl (suc (suc (Ar.plus m' zero))),
                            Wt.consC (Ar.plus m' zero) J (j (zero, refl true)) (Wt.substC J m' (Ar.plus m' zero) (K.pzm m') (Wt.tailC m' J j))].coord t)
          (Wt.FaceCong[suc (Ar.plus m' zero), J, suc (suc (Ar.plus m' zero)), Tr.leb-refl (suc (suc (Ar.plus m' zero))),
                       Wt.consC (Ar.plus m' zero) J (j (zero, refl true)) (Wt.substC J m' (Ar.plus m' zero) (K.pzm m') (Wt.tailC m' J j)),
                       Wt.substC J (suc m') (suc (Ar.plus m' zero)) (Pa.ap Nat Nat (\ k -> suc k) m' (Ar.plus m' zero) (K.pzm m')) j,
                       \ k -> transH (symH (Wt.substCons J m' (Ar.plus m' zero) (K.pzm m') (j (zero, refl true)) (Wt.tailC m' J j) k))
                                (apH (\ cc -> Wt.substC J (suc m') (suc (Ar.plus m' zero)) (Pa.ap Nat Nat (\ k' -> suc k') m' (Ar.plus m' zero) (K.pzm m')) cc k)
                                   (L14.coEq (suc m') J (Wt.consC m' J (j (zero, refl true)) (Wt.tailC m' J j)) j (\ k2 -> symH (Wt.consC-eta m' J j k2.1 k2.2))))].coord t)))) } ;

 -- the readings of u at the front-zeros and back-zeros concatenations
 module Ends (x : CO) (I : Ob) (gm : W0.Ix ((G.ob x).ob I)) (u : W0.Ix ((DAC.ty x).tob I gm)) (J' : Ob) (g : Hom J' I) {
  module R = RD[x, I, gm, u] ;
  -- the front: m+1 faces at 0 compose c' into c
  Front : (m : Nat) -> (y z : CO) (c' : K.Ch m x y) (n : Nat) (c : K.Ch n y z) (i : Wt.Pn n J')
   -> Id (W0.Ix (DA.Ez z J')) (R.rd (Ar.plus m (suc n)) z (K.cat m n x y z c' c) J' g (Wt.CatP[m, n, J'].right (Wt.zeros m J') i))
        (R.rd n z (K.rx n y x (K.tot m x y c') z c) J' g i) = split {
   zero -> \ y z f n c i ->
    transH (apH (R.rd (suc n) z (y, f, c) J' g)
              (transH (L14.pnEq (suc n) J' (Wt.CatP[zero, n, J'].right (Wt.zeros zero J') i) (Wt.Face[n, J', zero, refl true].Of[i].face) (\ k -> Wt.ConsZero[n, J', i.1].coord k))
                 (U12.faceW-irr n J' zero (refl true) (Ar.leb-step zero n (refl true)) i)))
     (transH (u.2.2.1 (n, zero, refl true, z, (y, f, c), J', g, i.1) i.2)
       (apH (\ ch -> R.rd n z ch J' g i) (K.front0 n x y z f c))) ;
   suc m' | ih -> \ y z c' n c i ->
    transH (apH (R.rd (suc (Ar.plus m' (suc n))) z (c'.1, c'.2.1, K.cat m' n c'.1 y z c'.2.2 c) J' g)
              (transH (L14.pnEq (suc (Ar.plus m' (suc n))) J' (Wt.CatP[suc m', n, J'].right (Wt.zeros (suc m') J') i)
                         (Wt.Face[Ar.plus m' (suc n), J', zero, refl true].Of[Wt.CatP[m', n, J'].right (Wt.zeros m' J') i].face)
                         (\ k -> Wt.ConsZero[Ar.plus m' (suc n), J', Wt.catC m' n J' (Wt.zeros m' J') i.1].coord k))
                 (U12.faceW-irr (Ar.plus m' (suc n)) J' zero (refl true) (Ar.leb-step zero (Ar.plus m' (suc n)) (refl true)) (Wt.CatP[m', n, J'].right (Wt.zeros m' J') i))))
     (transH (u.2.2.1 (Ar.plus m' (suc n), zero, refl true, z, (c'.1, c'.2.1, K.cat m' n c'.1 y z c'.2.2 c), J', g, (Wt.CatP[m', n, J'].right (Wt.zeros m' J') i).1)
                (Wt.CatP[m', n, J'].right (Wt.zeros m' J') i).2)
       (transH (apH (\ ch -> R.rd (Ar.plus m' (suc n)) z ch J' g (Wt.CatP[m', n, J'].right (Wt.zeros m' J') i))
                  (transH (K.front0 (Ar.plus m' (suc n)) x c'.1 z c'.2.1 (K.cat m' n c'.1 y z c'.2.2 c))
                     (K.rx-cat m' n c'.1 x y z c'.2.1 c'.2.2 c)))
         (transH (ih y z (K.rx m' c'.1 x c'.2.1 y c'.2.2) n c i)
           (apH (\ hh -> R.rd n z (K.rx n y x hh z c) J' g i) (K.tot-rx m' c'.1 x c'.2.1 y c'.2.2))))) } ;

  -- the back: n+1 top faces move c out of the concatenation as the action of A
  module BK (m : Nat) (y : CO) (c' : K.Ch m x y) (jr : Wt.Pn m J') {
   -- the weight of the base case: cat jr (0) is the top face of jr, arities transported
   Wb0 : Id (Wt.Pn (suc (Ar.plus m zero)) J')
          (substP J' (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) (Wt.CatP[m, zero, J'].left jr (Wt.zeros zero J')))
          (Wt.Face[Ar.plus m zero, J', suc (Ar.plus m zero), Tr.leb-refl (suc (Ar.plus m zero))].Of[substP J' m (Ar.plus m zero) (K.pzm m) jr].face) =
    L14.pnEq (suc (Ar.plus m zero)) J' _ _ (\ k ->
     transH (substP-1 J' (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) (Wt.CatP[m, zero, J'].left jr (Wt.zeros zero J')) k)
      (transH (catZeroTop m J' jr.1 k)
        (apH (\ cc -> Wt.Face[Ar.plus m zero, J', suc (Ar.plus m zero), Tr.leb-refl (suc (Ar.plus m zero))].faceC cc k)
           (L14.coEq (Ar.plus m zero) J' (Wt.substC J' m (Ar.plus m zero) (K.pzm m) jr.1) (substP J' m (Ar.plus m zero) (K.pzm m) jr).1
              (\ k2 -> symH (substP-1 J' m (Ar.plus m zero) (K.pzm m) jr k2)))))) ;
   -- the weight of the step: cat jr (0 .. 0) is the top face of cat jr (0 .. 0) one level down
   WS (n' : Nat) : Id (Wt.Pn (suc (Ar.plus m (suc n'))) J')
          (substP J' (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n')) (Wt.CatP[m, suc n', J'].left jr (Wt.zeros (suc n') J')))
          (Wt.Face[Ar.plus m (suc n'), J', suc (Ar.plus m (suc n')), Tr.leb-refl (suc (Ar.plus m (suc n')))].Of[Wt.CatP[m, n', J'].left jr (Wt.zeros n' J')].face) =
    transH (L14.pnEq (suc (Ar.plus m (suc n'))) J' _ _ (\ k ->
      transH (substP-1 J' (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n')) (Wt.CatP[m, suc n', J'].left jr (Wt.zeros (suc n') J')) k)
       (transH (apH (\ cc -> Wt.substC J' (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n')) cc k)
                  (L14.coEq (Ar.plus m (suc (suc n'))) J' (Wt.catC m (suc n') J' jr.1 (Wt.zeros (suc n') J'))
                     (Wt.catC m (suc n') J' jr.1 (Wt.Face[n', J', suc n', Tr.leb-refl (suc n')].faceC (Wt.zeros n' J')))
                     (\ k2 -> Wt.catC-congR m (suc n') J' jr.1 (Wt.zeros (suc n') J') (Wt.Face[n', J', suc n', Tr.leb-refl (suc n')].faceC (Wt.zeros n' J'))
                                 (\ k3 -> symH (zerosTop n' J' k3)) k2)))
         (symH (Wt.catFR m n' J' (suc n') (Tr.leb-refl (suc n')) jr.1 (Wt.zeros n' J') k)))))
     (facePos (Ar.plus m (suc n')) J' (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n'))
        (Wt.hRB m n' (suc n') (Tr.leb-refl (suc n'))) (Tr.leb-refl (suc (Ar.plus m (suc n')))) (Wt.CatP[m, n', J'].left jr (Wt.zeros n' J'))) ;
   Back : (n : Nat) -> (z : CO) (c : K.Ch n y z)
    -> Id (W0.Ix (DA.Ez z J')) (R.rd (Ar.plus m (suc n)) z (K.cat m n x y z c' c) J' g (Wt.CatP[m, n, J'].left jr (Wt.zeros n J')))
         ((A.tE z y (K.tot n y z c)).nt J' (R.rd m y c' J' g jr)) = split {
    zero -> \ z f ->
     transH (R.rdTr (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) z (K.cat m zero x y z c' f) J' g (Wt.CatP[m, zero, J'].left jr (Wt.zeros zero J')))
      (transH (apH (R.rd (suc (Ar.plus m zero)) z (K.trCh (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) x z (K.cat m zero x y z c' f)) J' g) Wb0)
        (transH (u.2.2.2 (Ar.plus m zero, z, K.trCh (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) x z (K.cat m zero x y z c' f), J', g, (substP J' m (Ar.plus m zero) (K.pzm m) jr).1)
                   (substP J' m (Ar.plus m zero) (K.pzm m) jr).2)
          (transH (apH (\ Dd -> (A.tE z Dd.1 Dd.2.2).nt J' (R.rd (Ar.plus m zero) Dd.1 Dd.2.1 J' g (substP J' m (Ar.plus m zero) (K.pzm m) jr))) (K.drop-cat0 m x y z c' f))
            (apH ((A.tE z y f).nt J') (symH (R.rdTr m (Ar.plus m zero) (K.pzm m) y c' J' g jr)))))) ;
    suc n' | ih -> \ z c ->
     transH (R.rdTr (Ar.plus m (suc (suc n'))) (suc (Ar.plus m (suc n'))) (Ar.plus-suc m (suc n')) z (K.cat m (suc n') x y z c' c) J' g (Wt.CatP[m, suc n', J'].left jr (Wt.zeros (suc n') J')))
      (transH (apH (R.rd (suc (Ar.plus m (suc n'))) z (K.catS m n' x y z c' c) J' g) (WS n'))
        (transH (u.2.2.2 (Ar.plus m (suc n'), z, K.catS m n' x y z c' c, J', g, (Wt.CatP[m, n', J'].left jr (Wt.zeros n' J')).1) (Wt.CatP[m, n', J'].left jr (Wt.zeros n' J')).2)
          (transH (apH (\ Dd -> (A.tE z Dd.1 Dd.2.2).nt J' (R.rd (Ar.plus m (suc n')) Dd.1 Dd.2.1 J' g (Wt.CatP[m, n', J'].left jr (Wt.zeros n' J')))) (K.drop-cat m n' x y z c' c))
            (transH (apH ((A.tE z (K.drop n' y z c).1 (K.drop n' y z c).2.2).nt J') (ih (K.drop n' y z c).1 (K.drop n' y z c).2.1))
              (transH (symH (A.tE-o z (K.drop n' y z c).1 y (K.tot n' y (K.drop n' y z c).1 (K.drop n' y z c).2.1) (K.drop n' y z c).2.2 J' (R.rd m y c' J' g jr)))
                (apH (\ hh -> (A.tE z y hh).nt J' (R.rd m y c' J' g jr)) (symH (K.tot-drop n' y z c)))))))) } ;
  } ;
 } ;

 ------------------------------------------------------------------
 -- the bridge M (cat j' i) as a natural map, and the ends of p, q

 mN2 (x : CO) : HO.NMap[G.ob x, DAC.ty x, B2 x] =
  new HO.NMap[G.ob x, DAC.ty x, B2 x, \ I gm u -> MW2[WfCat, WresCat, WfaceLCat, WfaceRCat, x, I, gm, u, PB.ptH I PB.e1].res,
   \ J I f gm gm' e u ->
    transH (MWN2[WfCat, WresCat, WfaceLCat, WfaceRCat, x, J, I, f, gm, gm', e, u, PB.ptH I PB.e1].nat)
      (MWEq2[WfCat, WresCat, WfaceLCat, WfaceRCat, WfCat, WresCat, WfaceLCat, WfaceRCat, x, J, gm', (DAC.ty x).tact J I f gm gm' e u,
             PB.compH J I PB.Iv (PB.ptH I PB.e1) f, PB.ptH J PB.e1,
             \ q' l' q li -> refl (Wt.CatP[q'.1, q.1, q.2.2.2.1].left (Wt.Res[q'.1, q.2.2.2.1, q'.2.2.2.1, q.2.2.2.2.1, (q'.2.2.2.2.2, l')].res) q.2.2.2.2.2)].eq)] ;

 -- the ends t = 1: both lines end at M
 module E1 (x : CO) (X : Ob) (z : W0.Ix ((extP (G.ob x) (DAC.ty x)).ob X)) {
  module TZ = GPR.TyL[G.ob x, DAC.ty x] ;
  module TX = GPR.TyL[G.ob x, B2 x] ;
  gm : W0.Ix ((G.ob x).ob X) = TZ.pr1 X z ;
  u : W0.Ix ((DAC.ty x).tob X gm) = TZ.pr2 X z ;
  p1 : Id (TX.EI X) (LN2[WfML, WresML, WfaceLML, WfaceRML, x].mwe X z (PB.ptH X PB.e1)) (HO.HT[G.ob x, DAC.ty x, B2 x, tauD x, mN2 x].bE X z) =
   apH (TX.pr X gm)
    (MWEq2[WfML, WresML, WfaceLML, WfaceRML, WfCat, WresCat, WfaceLCat, WfaceRCat, x, X, gm, u, PB.ptH X PB.e1, PB.ptH X PB.e1,
      \ q' l' q li -> L14.pnEq (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 _ _ (\ k ->
        transH (apH (\ jj -> Wt.catC q'.1 q.1 q.2.2.2.1 jj q.2.2.2.2.2 k)
                  (L14.coEq q'.1 q.2.2.2.1 (Wt.meetC q'.1 q.2.2.2.1 (PB.compH q.2.2.2.1 X PB.Iv (PB.ptH X PB.e1) (PB.compH q.2.2.2.1 q'.2.2.2.1 X q'.2.2.2.2.1 q.2.2.2.2.1)) (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2))
                     (Wt.meetC q'.1 q.2.2.2.1 (PB.ptH q.2.2.2.1 PB.e1) (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2))
                     (\ k2 -> apH (\ jj -> Wt.meetC q'.1 q.2.2.2.1 jj (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2) k2)
                                 (PB.ptH-nat q.2.2.2.1 X (PB.compH q.2.2.2.1 q'.2.2.2.1 X q'.2.2.2.2.1 q.2.2.2.2.1) PB.e1))))
          (Wt.catMeet1L q'.1 q.1 q.2.2.2.1 (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2) q.2.2.2.2.2 k))].eq) ;
  q1 : Id (TX.EI X) (LN2[WfMR, WresMR, WfaceLMR, WfaceRMR, x].mwe X z (PB.ptH X PB.e1)) (HO.HT[G.ob x, DAC.ty x, B2 x, dTau x, mN2 x].bE X z) =
   apH (TX.pr X gm)
    (MWEq2[WfMR, WresMR, WfaceLMR, WfaceRMR, WfCat, WresCat, WfaceLCat, WfaceRCat, x, X, gm, u, PB.ptH X PB.e1, PB.ptH X PB.e1,
      \ q' l' q li -> L14.pnEq (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 _ _ (\ k ->
        transH (apH (\ ii -> Wt.catC q'.1 q.1 q.2.2.2.1 (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2) ii k)
                  (L14.coEq q.1 q.2.2.2.1 (Wt.meetC q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 X PB.Iv (PB.ptH X PB.e1) (PB.compH q.2.2.2.1 q'.2.2.2.1 X q'.2.2.2.2.1 q.2.2.2.2.1)) q.2.2.2.2.2)
                     (Wt.meetC q.1 q.2.2.2.1 (PB.ptH q.2.2.2.1 PB.e1) q.2.2.2.2.2)
                     (\ k2 -> apH (\ jj -> Wt.meetC q.1 q.2.2.2.1 jj q.2.2.2.2.2 k2)
                                 (PB.ptH-nat q.2.2.2.1 X (PB.compH q.2.2.2.1 q'.2.2.2.1 X q'.2.2.2.2.1 q.2.2.2.2.1) PB.e1))))
          (Wt.catMeet1R q'.1 q.1 q.2.2.2.1 (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2) q.2.2.2.2.2 k))].eq) ;
 } ;

 -- the ends t = 0: p starts at tau_DAC, q at (D tau_A)[tau_G]
 module E0 (x : CO) (X : Ob) (z : W0.Ix ((extP (G.ob x) (DAC.ty x)).ob X)) {
  module TZ = GPR.TyL[G.ob x, DAC.ty x] ;
  module TX = GPR.TyL[G.ob x, B2 x] ;
  gm : W0.Ix ((G.ob x).ob X) = TZ.pr1 X z ;
  u : W0.Ix ((DAC.ty x).tob X gm) = TZ.pr2 X z ;
  module Mp = MW2[WfML, WresML, WfaceLML, WfaceRML, x, X, gm, u, PB.ptH X PB.e0] ;
  module Mq = MW2[WfMR, WresMR, WfaceLMR, WfaceRMR, x, X, gm, u, PB.ptH X PB.e0] ;
  module SCm = C15.SCm ;
  tg : D.Ob' x X = (D.tauX x).nt X gm ;
  -- tau_DAC u, read at (q' , q): the C-action of DA along tot c' on u restricted along g
  module TD = L14D.TA'[x, X, gm, u] ;
  module PA (q' : DD.Idx x X) (l' : DD.LandsI x X q') {
   module O = Mp.Outer[q', l'] ;
   y : CO = q'.2.1 ;
   J : Ob = q'.2.2.2.1 ;
   g : Hom q'.2.2.2.1 X = q'.2.2.2.2.1 ;
   ae : SigT (G.ob x) (DAC.ty x) q'.2.2.2.1 = (extP (G.ob x) (DAC.ty x)).act q'.2.2.2.1 X q'.2.2.2.2.1 (pairE (G.ob x) (DAC.ty x) X gm u) ;
   module TBu = DA.TB[x, q'.2.2.2.1, X, q'.2.2.2.2.1, tg, (D.tauX x).nt q'.2.2.2.1 ((G.ob x).act q'.2.2.2.1 X q'.2.2.2.2.1 gm),
                      ntEq (G.ob x) (D.obD x) (D.tauX x) q'.2.2.2.1 X q'.2.2.2.2.1 gm ((G.ob x).act q'.2.2.2.1 X q'.2.2.2.2.1 gm) (refl ((G.ob x).act q'.2.2.2.1 X q'.2.2.2.2.1 gm)), u] ;
   rq (q : DD.Idx q'.2.1 q'.2.2.2.1) : DD.Idx x q'.2.2.2.1 = (q.1, q.2.1, K.rx q.1 q'.2.1 x (K.tot q'.1 x q'.2.1 q'.2.2.1) q.2.1 q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, q.2.2.2.2.2) ;
   -- the total of tau_DAC u at q', read in the D-totals: the moved total of u
   tot-eq : Id (SigT (D.obD q'.2.1) (DA.DTy q'.2.1) q'.2.2.2.1)
              (SCm.rB q'.2.1 q'.2.2.2.1 (D2.prz q'.2.1 q'.2.2.2.1 (tg.1 q' l') (TD.t q' l')))
              ((DA.tEC q'.2.1 x (K.tot q'.1 x q'.2.1 q'.2.2.1)).nt q'.2.2.2.1 (SCm.rB x q'.2.2.2.1 ae)) =
    transH (apH (SCm.rB q'.2.1 q'.2.2.2.1) (TD.pc q' l')) (SCm.rBtE q'.2.1 x (K.tot q'.1 x q'.2.1 q'.2.2.1) q'.2.2.2.1 ae) ;
   H (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (O.tgy.1 q li) (O.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (O.tgy.1 q li) ((TD.t q' l').1 q li)) =
    transH (Mp.pcO q' l' q li)
     (transH (apH (Mp.R.rd (Ar.plus q'.1 (suc q.1)) q.2.1 (O.ccOf q) q.2.2.2.1 (O.ggOf q))
                (L14.pnEq (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 (O.wOf q li) (Wt.CatP[q'.1, q.1, q.2.2.2.1].right (Wt.zeros q'.1 q.2.2.2.1) (q.2.2.2.2.2, li)) (\ k ->
                  transH (apH (\ jj -> Wt.catC q'.1 q.1 q.2.2.2.1 jj q.2.2.2.2.2 k)
                            (L14.coEq q'.1 q.2.2.2.1 (Wt.meetC q'.1 q.2.2.2.1 (PB.compH q.2.2.2.1 X PB.Iv (PB.ptH X PB.e0) (O.ggOf q)) (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2))
                               (Wt.meetC q'.1 q.2.2.2.1 (PB.ptH q.2.2.2.1 PB.e0) (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2))
                               (\ k2 -> apH (\ jj -> Wt.meetC q'.1 q.2.2.2.1 jj (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2) k2)
                                           (PB.ptH-nat q.2.2.2.1 X (O.ggOf q) PB.e0))))
                    (Wt.catMeet0L q'.1 q.1 q.2.2.2.1 (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2) q.2.2.2.2.2 k))))
       (transH (Ends[x, X, gm, u, q.2.2.2.1, O.ggOf q].Front q'.1 q'.2.1 q.2.1 q'.2.2.1 q.1 q.2.2.1 (q.2.2.2.2.2, li))
         (transH (symH (TBu.pc (rq q) li))
           (symH (apH (\ T -> DA.prz q.2.1 q.2.2.2.1 (T.1.1 q li) (T.2.1 q li)) tot-eq))))) ;
   eq : Id (W0.Ix ((DAC.ty q'.2.1).tob q'.2.2.2.1 (tg.1 q' l'))) (Mp.ov q' l') (TD.t q' l') =
    GPR.TyL[G.ob q'.2.1, DAC.ty q'.2.1].pr-inj q'.2.2.2.1 (tg.1 q' l') (Mp.ov q' l') (TD.t q' l')
     (SCm.sub-eq q'.2.1 q'.2.2.2.1 (D2.prz q'.2.1 q'.2.2.2.1 (tg.1 q' l') (Mp.ov q' l')) (D2.prz q'.2.1 q'.2.2.2.1 (tg.1 q' l') (TD.t q' l')) (refl (tg.1 q' l'))
       (DA.totD-eq q'.2.1 q'.2.2.2.1 _ _ (refl ((D.tauX q'.2.1).nt q'.2.2.2.1 (tg.1 q' l'))) H)) ;
  } ;
  p0 : Id (TX.EI X) (LN2[WfML, WresML, WfaceLML, WfaceRML, x].mwe X z (PB.ptH X PB.e0)) (HO.HT[G.ob x, DAC.ty x, B2 x, tauD x, mN2 x].aE X z) =
   apH (TX.pr X gm) (D2.tob-eq x X tg Mp.res TD.res (\ q' l' -> PA[q', l'].eq)) ;

  -- (D tau_A)[tau_G] u, read at (q' , q): tau_A at y of the A-element u_(c')(j'), moved by tot c
  module DMm = DF.DM[x, X, tg, u] ;
  module QA (q' : DD.Idx x X) (l' : DD.LandsI x X q') {
   module O = Mq.Outer[q', l'] ;
   gmy : W0.Ix ((G.ob q'.2.1).ob q'.2.2.2.1) = tg.1 q' l' ;
   module TA = L14.TA'[q'.2.1, q'.2.2.2.1, gmy, u.1 q' l'] ;
   tot-eq : Id (SigT (D.obD q'.2.1) (DA.DTy q'.2.1) q'.2.2.2.1)
              (SCm.rB q'.2.1 q'.2.2.2.1 (D2.prz q'.2.1 q'.2.2.2.1 gmy (DMm.b q' l')))
              (SCm.rB q'.2.1 q'.2.2.2.1 (D2.prz q'.2.1 q'.2.2.2.1 gmy TA.res)) =
    apH (SCm.rB q'.2.1 q'.2.2.2.1) (DMm.pc q' l') ;
   H (q : DD.Idx q'.2.1 q'.2.2.2.1) (li : DD.LandsI q'.2.1 q'.2.2.2.1 q)
    : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (DA.prz q.2.1 q.2.2.2.1 (O.tgy.1 q li) (O.ires.1 q li)) (DA.prz q.2.1 q.2.2.2.1 (O.tgy.1 q li) ((DMm.b q' l').1 q li)) =
    transH (Mq.pcO q' l' q li)
     (transH (apH (Mq.R.rd (Ar.plus q'.1 (suc q.1)) q.2.1 (O.ccOf q) q.2.2.2.1 (O.ggOf q))
                (L14.pnEq (Ar.plus q'.1 (suc q.1)) q.2.2.2.1 (O.wOf q li) (Wt.CatP[q'.1, q.1, q.2.2.2.1].left (O.jrOf q) (Wt.zeros q.1 q.2.2.2.1)) (\ k ->
                  transH (apH (\ ii -> Wt.catC q'.1 q.1 q.2.2.2.1 (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2) ii k)
                            (L14.coEq q.1 q.2.2.2.1 (Wt.meetC q.1 q.2.2.2.1 (PB.compH q.2.2.2.1 X PB.Iv (PB.ptH X PB.e0) (O.ggOf q)) q.2.2.2.2.2)
                               (Wt.meetC q.1 q.2.2.2.1 (PB.ptH q.2.2.2.1 PB.e0) q.2.2.2.2.2)
                               (\ k2 -> apH (\ jj -> Wt.meetC q.1 q.2.2.2.1 jj q.2.2.2.2.2 k2) (PB.ptH-nat q.2.2.2.1 X (O.ggOf q) PB.e0))))
                    (Wt.catMeet0R q'.1 q.1 q.2.2.2.1 (Wt.resC q'.1 q.2.2.2.1 q'.2.2.2.1 q.2.2.2.2.1 q'.2.2.2.2.2) q.2.2.2.2.2 k))))
       (transH (Ends[x, X, gm, u, q.2.2.2.1, O.ggOf q].BK[q'.1, q'.2.1, q'.2.2.1, O.jrOf q].Back q.1 q.2.1 q.2.2.1)
         (transH (apH ((A.tE q.2.1 q'.2.1 (K.tot q.1 q'.2.1 q.2.1 q.2.2.1)).nt q.2.2.2.1) (symH (u.2.1 (q', (q.2.2.2.1, q.2.2.2.2.1)) l')))
           (transH (symH (TA.pc q li))
             (symH (apH (\ T -> DA.prz q.2.1 q.2.2.2.1 (T.1.1 q li) (T.2.1 q li)) tot-eq)))))) ;
   eq : Id (W0.Ix ((DAC.ty q'.2.1).tob q'.2.2.2.1 (tg.1 q' l'))) (Mq.ov q' l') (DMm.b q' l') =
    GPR.TyL[G.ob q'.2.1, DAC.ty q'.2.1].pr-inj q'.2.2.2.1 (tg.1 q' l') (Mq.ov q' l') (DMm.b q' l')
     (SCm.sub-eq q'.2.1 q'.2.2.2.1 (D2.prz q'.2.1 q'.2.2.2.1 (tg.1 q' l') (Mq.ov q' l')) (D2.prz q'.2.1 q'.2.2.2.1 (tg.1 q' l') (DMm.b q' l')) (refl (tg.1 q' l'))
       (DA.totD-eq q'.2.1 q'.2.2.2.1 _ _ (refl ((D.tauX q'.2.1).nt q'.2.2.2.1 (tg.1 q' l'))) H)) ;
  } ;
  q0 : Id (TX.EI X) (LN2[WfMR, WresMR, WfaceLMR, WfaceRMR, x].mwe X z (PB.ptH X PB.e0)) (HO.HT[G.ob x, DAC.ty x, B2 x, dTau x, mN2 x].aE X z) =
   apH (TX.pr X gm) (D2.tob-eq x X tg Mq.res DMm.res (\ q' l' -> QA[q', l'].eq)) ;
 } ;

 -- the two lines as homotopies
 pH (x : CO) : PEl[extP (G.ob x) (DAC.ty x), HO.HT[G.ob x, DAC.ty x, B2 x, tauD x, mN2 x].PT.PathP] =
  LP2[WfML, WresML, WfaceLML, WfaceRML, x, tauD x, mN2 x, \ X z -> E0[x, X, z].p0, \ X z -> E1[x, X, z].p1].res ;
 qH (x : CO) : PEl[extP (G.ob x) (DAC.ty x), HO.HT[G.ob x, DAC.ty x, B2 x, dTau x, mN2 x].PT.PathP] =
  LP2[WfMR, WresMR, WfaceLMR, WfaceRMR, x, dTau x, mN2 x, \ X z -> E0[x, X, z].q0, \ X z -> E1[x, X, z].q1].res ;

 ------------------------------------------------------------------
 -- LEMMA 16: K = q . p^-1 : (D tau_A)[tau_G] ~ tau_DAC, composed with the
 -- fibrancy of (D DAC)[tau_G] (Lemma 12 at DAC along tau); and, levelwise,
 -- tau_DAC is an equivalence (Lemma 14 at DAC through QinvEq)

 module Main (al : P.LFib G A) {
  module CM = C15.Main[al] ;
  module F12 = Lemma12F[a, l].F12[C, G, DAC, CM.fB] ;
  fB2 (x : CO) : CL.Lines[G.ob x, B2 x].Fib = PB.CFibSub[l].FibSub[G.ob x, D.obD x, D.tauX x, D2.DTy x].sub (F12.fibD x) ;
  cB2 (x : CO) : CL.Lines[G.ob x, B2 x].CompK[PB.e0, PB.e1].Comp = (fB2 x).1 ;

  zig (x : CO) : PEl[extP (G.ob x) (DAC.ty x), HO.HT[G.ob x, DAC.ty x, B2 x, dTau x, tauD x].PT.PathP] =
   HO.Cat[G.ob x, DAC.ty x, B2 x, dTau x, mN2 x, tauD x, cB2 x, qH x,
          HO.Inv[G.ob x, DAC.ty x, B2 x, tauD x, mN2 x, cB2 x, pH x].res].res ;

  lemma16 (x : CO) : CE.EquivOp (G.ob x) (DAC.ty x) (B2 x) (LR.Map[G.ob x, DAC.ty x, B2 x, tauD x].pmap) =
   QinvEq[a, l].QE[G.ob x, (DAC.ty x, CM.fB x), (B2 x, fB2 x), tauD x,
                   (L14D.lemma14 CM.fB x).1, (L14D.lemma14 CM.fB x).2.1, (L14D.lemma14 CM.fB x).2.2].qinvEq ;
 } ;
} ;





