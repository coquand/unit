-- CDSet1.seg (canonicity-c2; (d), T0 a set, part 1): the constant unit type
-- is a proposition (its points are tt), and CSolT's RelProd over
-- nil.HomT(x, y).Q_y^m is a family of propositions (Sigma of Id types in the
-- set Q_y, CSetProps).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module Set1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module S2 = CSolT[a].SolOf2[R, encK, pe, x, u, y] ;
 module S1 = S2.S1 ;
 Nl : C.Ctx = C.nil ;
 -- the unit is a proposition
 module UnitP (G : C.Ctx) {
  Ut : C.Ty G = C.subT G Nl S1.UnitT (C.eps G) ;
  G1 : C.Ctx = C.ext G Ut ;
  W : C.Ty G1 = OV.wkT G Ut Ut ;
  G2 : C.Ctx = C.ext G1 W ;
  X : C.Ty G2 = OV.wkT G1 W W ;
  x1 : C.El G2 X = OV.wkE G1 W W (C.q G Ut) ;
  x2 : C.El G2 X = C.q G1 W ;
  e : Id (C.El G2 X) x1 x2 = L.el-ext G2 X.1 x1 x2 (\ K w -> isTop (x1.eob K w) (x2.eob K w)) ;
  r : C.El G2 (IJ.IdT G2 X x1 x2) = subst (C.El G2 X) (\ v -> C.El G2 (IJ.IdT G2 X x1 v)) x1 x2 e (IJ.rfl G2 X x1) ;
  pU : C.El G (PU.isProp G Ut) = OV.lam G Ut (FibCwF[a, a+].fibPi.Pi G1 W (CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId].Id2 G Ut))
    (OV.lam G1 W (CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId].Id2 G Ut) r) ;
 } ;
 -- the equations form a family of propositions
 Dv : C.Ctx = S1.Dv ;
 GT : C.Ctx = S2.GT ;
 m : Nat = S1.m ;
 n : Nat = S1.n ;
 sQy : CQCtx[a].G3Of[S1.Qy].SetQiTy = CwFQuotElim1[a].QE1[R, encK, y, pe].setQi ;
 Tm : U a = SX.Over[R].Expr (SX.Fin (Arith[a].plus m n)) ;
 pIdEv (p : Tm) : C.El Dv (PU.isProp Dv (S2.IdEv p)) =
  OV.trE Dv (C.subT Dv GT (PU.isProp GT (IJ.IdT GT (S1.EV.Qk (Arith[a].plus m n)) (S1.EV.evE (Arith[a].plus m n) p) (S1.EV.evE (Arith[a].plus m n) (cst R.z)))) S2.sigma)
   (PU.isProp Dv (S2.IdEv p))
   (PU.isProp-ov Dv GT (IJ.IdT GT (S1.EV.Qk (Arith[a].plus m n)) (S1.EV.evE (Arith[a].plus m n) p) (S1.EV.evE (Arith[a].plus m n) (cst R.z))) S2.sigma (S2.IdEv p) (refl (S2.IdEv p)))
   (C.subt Dv GT (PU.isProp GT (IJ.IdT GT (S1.EV.Qk (Arith[a].plus m n)) (S1.EV.evE (Arith[a].plus m n) p) (S1.EV.evE (Arith[a].plus m n) (cst R.z))))
     (CSetProps[a].IdPropC[S1.Qy, sQy, GT, S1.EV.evE (Arith[a].plus m n) p, S1.EV.evE (Arith[a].plus m n) (cst R.z)].idP) S2.sigma) ;
 pRel : (qs : SX.Over[R].Equations (SX.Fin (Arith[a].plus m n))) -> C.El Dv (PU.isProp Dv (S2.RelProd qs)) = split {
  nil -> UnitP[Dv].pU ;
  cons p ps | r -> CSetProps[a].SigProp[Dv, S2.IdEv p, OV.wkT Dv (S2.IdEv p) (S2.RelProd ps), pIdEv p, PU.wkProp Dv (S2.IdEv p) (S2.RelProd ps) r].sigProp } ;
} ;
