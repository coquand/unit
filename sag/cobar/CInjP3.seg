-- CInjP3.seg (canonicity-c2): CInjP, the conclusion: the fibres of FunOf n
-- over nil.B are propositions (pF, in CInjSurj.ContrFib's form).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module PF (A B : C.Ty C.nil) (n : HO.NMap[C.nil, A.1, B.1]) (sB : CQCtx[a].G3Of[B].SetQiTy)
  (zA zB : C.El (CInjP[a].IP[A, B, n].GH) (OV.wkT C.nil (CInjP[a].IP[A, B, n].H) A))
  (zAr : (K : Ob) (w : V1.Ix ((CInjP[a].IP[A, B, n].GH).ob K)) -> Id (V1.Ix (A.1.tob K w.1)) (zA.eob K w) w.2.1)
  (zBr : (K : Ob) (w : V1.Ix ((CInjP[a].IP[A, B, n].GH).ob K)) -> Id (V1.Ix (A.1.tob K w.1)) (zB.eob K w) w.2.2.1)
  (inj : C.El (CInjP[a].IP[A, B, n].GH) (IJ.IdT (CInjP[a].IP[A, B, n].GH) (OV.wkT C.nil (CInjP[a].IP[A, B, n].H) A) zA zB)) {
 module I = CInjP[a].IP[A, B, n] ;
 module U2 = CInjP2[a].Use[A, B, n, sB, zA, zB, zAr, zBr, inj] ;
 Nl : C.Ctx = C.nil ;
 EX : C.Ctx = C.ext I.E2 I.X2 ;
 lf : C.Sub EX I.GX = C.lift I.E2 I.GB I.Xb I.pp ;
 T0 : C.Ty I.GX = OV.wkT I.GB I.Xb I.Bb ;
 T0l : C.Ty EX = C.subT EX I.GX T0 lf ;
 qw : C.El I.GX T0 = OV.wkE I.GB I.Xb I.Bb (C.q Nl B) ;
 Y2' : C.Ty EX = IJ.IdT EX T0l (C.subt EX I.GX T0 I.apX lf) (C.subt EX I.GX T0 qw lf) ;
 PY : Id (C.Ty EX) I.Y2 Y2' = IJ.IdT-nat EX I.GX T0 I.apX qw lf ;
 sL : C.Sub EX Nl = C.o EX I.GX Nl (C.o I.GX I.GB Nl (C.p Nl B) I.pX) lf ;
 PT0 : Id (C.Ty EX) (C.subT EX Nl B sL) T0l =
  symH (transH (apH {C.Ty I.GX} {C.Ty EX} (\ T -> C.subT EX I.GX T lf) (symH (C.subT-o I.GX I.GB Nl B (C.p Nl B) I.pX)))
         (symH (C.subT-o EX I.GX Nl B (C.o I.GX I.GB Nl (C.p Nl B) I.pX) lf))) ;
 idPropT (E : C.Ctx) (T : C.Ty E) (s : C.Sub E Nl) (P : Id (C.Ty E) (C.subT E Nl B s) T) (u v : C.El E T) : C.El E (PU.isProp E (IJ.IdT E T u v)) =
  idJ (C.Ty E) (C.subT E Nl B s) (\ T2 P2 -> (u2 v2 : C.El E T2) -> C.El E (PU.isProp E (IJ.IdT E T2 u2 v2)))
   (\ u2 v2 -> CwFFunSetB[a].SetB[B, sB].idPB E s u2 v2) T P u v ;
 pY : C.El EX (PU.isProp EX I.Y2) =
  OV.trE EX (PU.isProp EX Y2') (PU.isProp EX I.Y2) (apH {C.Ty EX} {C.Ty EX} (\ Z -> PU.isProp EX Z) (symH PY))
   (idPropT EX T0l sL PT0 (C.subt EX I.GX T0 I.apX lf) (C.subt EX I.GX T0 qw lf)) ;
 sAB : C.El I.E2 (IJ.IdT I.E2 I.S2 I.y1 I.y2) =
  CwFPropPair.PropPair[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibUniv[a].fibUniv].At[I.E2, I.X2, I.Y2].pairPath pY I.y1 I.y2 U2.e ;
 W2 : C.Ty I.E2 = OV.wkT I.E1 I.Wf I.Wf ;
 b1 : C.El I.E2 (IJ.IdT I.E2 W2 (OV.trE I.E2 I.S2 W2 (symH I.PS2) I.y1) (OV.trE I.E2 I.S2 W2 (symH I.PS2) I.y2)) =
  CInjP[a].idFwdL I.E2 I.S2 W2 (symH I.PS2) I.y1 I.y2 sAB ;
 r : C.El I.E2 (IJ.IdT I.E2 W2 I.x1 I.x2) =
  subst (C.El I.E2 W2) (\ v -> C.El I.E2 (IJ.IdT I.E2 W2 I.x1 v)) (OV.trE I.E2 I.S2 W2 (symH I.PS2) I.y2) I.x2 (CInjP[a].trInv I.E2 W2 I.S2 I.PS2 I.x2)
   (subst (C.El I.E2 W2) (\ v -> C.El I.E2 (IJ.IdT I.E2 W2 v (OV.trE I.E2 I.S2 W2 (symH I.PS2) I.y2))) (OV.trE I.E2 I.S2 W2 (symH I.PS2) I.y1) I.x1
      (CInjP[a].trInv I.E2 W2 I.S2 I.PS2 I.x1) b1) ;
 pF : C.El I.GB (PU.isProp I.GB I.Fib) =
  OV.lam I.GB I.Fib (FibCwF[a, a+].fibPi.Pi I.E1 I.Wf (EQ.Id2 I.GB I.Fib)) (OV.lam I.E1 I.Wf (EQ.Id2 I.GB I.Fib) r) ;
} ;
