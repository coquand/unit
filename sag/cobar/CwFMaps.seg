-- CwFMaps.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit): functions
-- of a CwF with Pi, Sigma, Swan Id and their values, for the quotient.
--   upSecId    the lift of p_Z, after the lift of the section of z, is
--              the identity of G.X
--   apF        ap of a function: Id(x , y) -> Id(F x , F y)  (CwFPth.apM)
--   fstF       the first projection of Sigma X Y as a function, with
--              its value: fstF w = fst w
--   evF b      evaluation at b as a function (X -> Y) -> Y, with its
--              value: evF b f = f b
open Base ;

module Maps (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module PT = CwFPth.Pth[l, C, PS, SS, IJ] ;

  module USI (G : Ctx) (Z X : Ty G) (z : El G Z) {
    D : Ctx = ext G Z ;
    Xd : Ty D = wkT G Z X ;
    sa : Sub G D = sec G Z z ;
    up0 : Sub (ext D Xd) (ext G X) = lift D G X (p G Z) ;
    PX : Id (Ty G) (subT G D Xd sa) X = p-sec-T G Z X z ;
    upS : Sub (ext G X) (ext D Xd) = upT G D Xd sa X PX ;
    PXi : Id (Ty G) (subT G D Xd sa) (subT G G X (id G)) =
      trans (Ty G) (subT G D Xd sa) X (subT G G X (id G)) PX (sym (Ty G) (subT G G X (id G)) X (subT-id G X)) ;
    F (Y : Ty G) : U l = Sub (ext G Y) (ext D Xd) ;
    L0 : F (subT G D Xd sa) = lift G D Xd sa ;
    PXt : Id (Ty G) (subT G D Xd sa) X = trans (Ty G) (subT G D Xd sa) (subT G G X (id G)) X PXi (subT-id G X) ;
    e1 : Id (Sub (ext G X) (ext D Xd)) upS
           (subst (Ty G) F (subT G G X (id G)) X (subT-id G X) (upT G D Xd sa (subT G G X (id G)) PXi)) =
      trans (Sub (ext G X) (ext D Xd)) upS (subst (Ty G) F (subT G D Xd sa) X PXt L0)
        (subst (Ty G) F (subT G G X (id G)) X (subT-id G X) (upT G D Xd sa (subT G G X (id G)) PXi))
        (ap (Id (Ty G) (subT G D Xd sa) X) (Sub (ext G X) (ext D Xd)) (\ P -> subst (Ty G) F (subT G D Xd sa) X P L0) PX PXt
           (isSetTy G (subT G D Xd sa) X PX PXt))
        (idJ (Ty G) (subT G G X (id G))
           (\ Y Qx -> Id (F Y)
                (subst (Ty G) F (subT G D Xd sa) Y (trans (Ty G) (subT G D Xd sa) (subT G G X (id G)) Y PXi Qx) L0)
                (subst (Ty G) F (subT G G X (id G)) Y Qx (subst (Ty G) F (subT G D Xd sa) (subT G G X (id G)) PXi L0)))
           (refl (subst (Ty G) F (subT G D Xd sa) (subT G G X (id G)) PXi L0))
           X (subT-id G X)) ;
    upId : Id (Sub (ext G X) (ext G X)) (o (ext G X) (ext D Xd) (ext G X) up0 upS) (id (ext G X)) =
      trans (Sub (ext G X) (ext G X)) (o (ext G X) (ext D Xd) (ext G X) up0 upS)
        (o (ext G X) (ext D Xd) (ext G X) up0 (subst (Ty G) F (subT G G X (id G)) X (subT-id G X) (upT G D Xd sa (subT G G X (id G)) PXi)))
        (id (ext G X))
        (ap (Sub (ext G X) (ext D Xd)) (Sub (ext G X) (ext G X)) (\ t -> o (ext G X) (ext D Xd) (ext G X) up0 t) upS
           (subst (Ty G) F (subT G G X (id G)) X (subT-id G X) (upT G D Xd sa (subT G G X (id G)) PXi)) e1)
        (trans (Sub (ext G X) (ext G X))
           (o (ext G X) (ext D Xd) (ext G X) up0 (subst (Ty G) F (subT G G X (id G)) X (subT-id G X) (upT G D Xd sa (subT G G X (id G)) PXi)))
           (subst (Ty G) (\ Y -> Sub (ext G Y) (ext G X)) (subT G G X (id G)) X (subT-id G X)
              (o (ext G (subT G G X (id G))) (ext D Xd) (ext G X) up0 (upT G D Xd sa (subT G G X (id G)) PXi)))
           (id (ext G X))
           (SV.substPost G D G Xd X (subT G G X (id G)) X (subT-id G X) up0 (upT G D Xd sa (subT G G X (id G)) PXi))
           (trans (Sub (ext G X) (ext G X))
              (subst (Ty G) (\ Y -> Sub (ext G Y) (ext G X)) (subT G G X (id G)) X (subT-id G X)
                 (o (ext G (subT G G X (id G))) (ext D Xd) (ext G X) up0 (upT G D Xd sa (subT G G X (id G)) PXi)))
              (subst (Ty G) (\ Y -> Sub (ext G Y) (ext G X)) (subT G G X (id G)) X (subT-id G X) (lift G G X (id G)))
              (id (ext G X))
              (ap (Sub (ext G (subT G G X (id G))) (ext G X)) (Sub (ext G X) (ext G X))
                 (\ t -> subst (Ty G) (\ Y -> Sub (ext G Y) (ext G X)) (subT G G X (id G)) X (subT-id G X) t)
                 (o (ext G (subT G G X (id G))) (ext D Xd) (ext G X) up0 (upT G D Xd sa (subT G G X (id G)) PXi))
                 (lift G G X (id G))
                 (SV.liftComp G D G X (p G Z) sa (id G) (p-sec G Z z) PXi))
              (lift-id G X))) ;
    -- a type over G.X, weakened along the lift and read at z, is itself
    fam (Y : Ty (ext G X)) : Id (Ty (ext G X)) (subT (ext G X) (ext D Xd) (subT (ext D Xd) (ext G X) Y up0) upS) Y =
      trans (Ty (ext G X)) (subT (ext G X) (ext D Xd) (subT (ext D Xd) (ext G X) Y up0) upS)
        (subT (ext G X) (ext G X) Y (o (ext G X) (ext D Xd) (ext G X) up0 upS)) Y
        (sym (Ty (ext G X)) (subT (ext G X) (ext G X) Y (o (ext G X) (ext D Xd) (ext G X) up0 upS))
           (subT (ext G X) (ext D Xd) (subT (ext D Xd) (ext G X) Y up0) upS)
           (subT-o (ext G X) (ext D Xd) (ext G X) Y up0 upS))
        (trans (Ty (ext G X)) (subT (ext G X) (ext G X) Y (o (ext G X) (ext D Xd) (ext G X) up0 upS)) (subT (ext G X) (ext G X) Y (id (ext G X))) Y
           (ap (Sub (ext G X) (ext G X)) (Ty (ext G X)) (\ t -> subT (ext G X) (ext G X) Y t) (o (ext G X) (ext D Xd) (ext G X) up0 upS) (id (ext G X)) upId)
           (subT-id (ext G X) Y)) ;
  } ;

  -- ap of a function
  apF (G : Ctx) (X Y : Ty G) (F : El G (Fun G X Y)) (x y : El G X) (u : El G (IJ.IdT G X x y))
    : El G (IJ.IdT G Y (app G X Y F x) (app G X Y F y)) =
    PT.apM G X Y (bod G X (wkT G X Y) F) x y u ;

  -- the first projection as a function, and its value
  module FstF (G : Ctx) (X : Ty G) (Y : Ty (ext G X)) {
    S : Ty G = SS.Sig G X Y ;
    D : Ctx = ext G S ;
    Xd : Ty D = wkT G S X ;
    up0 : Sub (ext D Xd) (ext G X) = lift D G X (p G S) ;
    Yd : Ty (ext D Xd) = subT (ext D Xd) (ext G X) Y up0 ;
    SW : Id (Ty D) (wkT G S S) (SS.Sig D Xd Yd) = Sig-ov D G X Y (p G S) Xd (refl Xd) Yd (refl Yd) ;
    qS : El D (SS.Sig D Xd Yd) = trE D (wkT G S S) (SS.Sig D Xd Yd) SW (q G S) ;
    m : El D Xd = IN.fst D Xd Yd qS ;
    fstF : El G (Fun G S X) = lam G S Xd m ;
    module At (w : El G S) {
      module US = USI[G, S, X, w] ;
      PX : Id (Ty G) (subT G D Xd (sec G S w)) X = p-sec-T G S X w ;
      PW : Id (Ty G) (subT G D (SS.Sig D Xd Yd) (sec G S w)) S = Sig-ov G D Xd Yd (sec G S w) X PX Y (US.fam Y) ;
      Pw : Ov G D (SS.Sig D Xd Yd) (sec G S w) S PW qS w =
        IN.teAny G (subT G D (SS.Sig D Xd Yd) (sec G S w)) S (subt G D (SS.Sig D Xd Yd) qS (sec G S w)) w
          (IN.teT G (subT G D (SS.Sig D Xd Yd) (sec G S w)) (subT G D (wkT G S S) (sec G S w)) S
             (subt G D (SS.Sig D Xd Yd) qS (sec G S w)) (subt G D (wkT G S S) (q G S) (sec G S w)) w
             (IN.teS G (subT G D (wkT G S S) (sec G S w)) (subT G D (SS.Sig D Xd Yd) (sec G S w))
                (subt G D (wkT G S S) (q G S) (sec G S w)) (subt G D (SS.Sig D Xd Yd) qS (sec G S w))
                (SV.teSub G D (wkT G S S) (SS.Sig D Xd Yd) (q G S) qS (IN.teTr D (wkT G S S) (SS.Sig D Xd Yd) SW (q G S)) (sec G S w)))
             (p-sec-T G S S w, IN.q-secO G S w (p-sec-T G S S w)))
          PW ;
      val : Id (El G X) (app G S X fstF w) (IN.fst G X Y w) =
        trans (El G X) (app G S X fstF w) (PT.atv G S X m w) (IN.fst G X Y w)
          (ap (El D Xd) (El G X) (\ b -> PT.atv G S X b w) (bod G S Xd fstF) m ((PS.Pi-iso G S Xd).fun-inv m))
          (IN.fst-ov G D Xd Yd (sec G S w) X PX Y (US.fam Y) PW qS w Pw) ;
    } ;
  } ;

  -- evaluation at b as a function, and its value
  module EvF (G : Ctx) (X Y : Ty G) (b : El G X) {
    FXY : Ty G = Fun G X Y ;
    D : Ctx = ext G FXY ;
    m : El D (wkT G FXY Y) = app D (wkT G FXY X) (wkT G FXY Y) (EQ.qF G X Y) (wkE G FXY X b) ;
    evF : El G (Fun G FXY Y) = lam G FXY (wkT G FXY Y) m ;
    module At (f : El G FXY) {
      PXa : Id (Ty G) (subT G D (wkT G FXY X) (sec G FXY f)) X = p-sec-T G FXY X f ;
      PYa : Id (Ty G) (subT G D (wkT G FXY Y) (sec G FXY f)) Y = p-sec-T G FXY Y f ;
      PF : Id (Ty G) (subT G D (Fun D (wkT G FXY X) (wkT G FXY Y)) (sec G FXY f)) FXY =
        Fun-ov G D (wkT G FXY X) (wkT G FXY Y) (sec G FXY f) X PXa Y PYa ;
      val : Id (El G Y) (app G FXY Y evF f) (app G X Y f b) =
        trans (El G Y) (app G FXY Y evF f) (PT.atv G FXY Y m f) (app G X Y f b)
          (ap (El D (wkT G FXY Y)) (El G Y) (\ c -> PT.atv G FXY Y c f) (bod G FXY (wkT G FXY Y) evF) m
             ((PS.Pi-iso G FXY (wkT G FXY Y)).fun-inv m))
          (app-ov G D (wkT G FXY X) (wkT G FXY Y) (sec G FXY f) X PXa Y PYa PF (EQ.qF G X Y) f (IN.qF-sec G X Y f PF)
             (wkE G FXY X b) b (IN.wkE-sec G FXY X f b PXa)) ;
    } ;
  } ;
} ;
