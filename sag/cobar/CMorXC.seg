-- CMorXC.seg (canonicity-45; SIMPLIFIED.md step 3): the internal category C
-- of presented k-algebras (jonas.pdf Construction 39), part 2: the laws
-- and the CIntCat.IC instance, from CMorX's hom codes.
--   objects     the presentations (constant: obD I = the code of
--               CPresCode's presentations at level a+, members on the nose)
--   maps        homD J I u y x = maps of algebras A_x -> A_y at the stage J
--               (C is the opposite of the category of algebras)
--   res u x = x, cart = the identity, fact h = h, res-id / res-comp by refl
-- Every law is CMorX.Fn.mExt (maps with the same families are equal) at
-- families that agree on the nose, except where the base category's laws
-- enter the slice argument (idr: comp-idl; assoc: comp-assoc), which are
-- moved by CMorX.Fn.rxEq (funext).  The first components of the total
-- maps by the base's comp-idl / comp-idr / comp-assoc.
-- Negative test: idr with the families claimed equal on the nose fails.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module EM = Encode[a, a+] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module CatOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (addO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (mulO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt))) {
 module MO = CMorX[a].MorOf[R, encK, pe, addO, mulO] ;
 Pres : U a = MO.Pres ;
 presV : W0.V = CPresCode[a].PresCode[R, encK].presV ;
 obV1 : V1.V = EM.codeOf (W0.Ix presV) (EM.encIx0 presV) ;
 -- the operations of the category
 homV1 (J : Ob) (y x : Pres) : V1.V = MO.Fn[x, y].MorV J ;
 idM (I : Ob) (x : Pres) : MO.Fn[x, x].M I = MO.Idn[x].idM' I ;
 cmpM (K J I : Ob) (v : Hom K J) (z y x : Pres) (f : MO.Fn[x, y].M J) (g : MO.Fn[y, z].M K) : MO.Fn[x, z].M K =
  MO.Cmp[x, y, z, K, MO.Fn[x, y].res J K v f, g].cmp ;
 pq (J I : Ob) (y x : Pres) (u u' : Hom J I) (eu : Id (Hom J I) u u') (m m' : MO.Fn[x, y].M J) (em : Id (MO.Fn[x, y].M J) m m')
  : Id ((w : Hom J I) * MO.Fn[x, y].M J) (u, m) (u', m') =
  transH (apH {Hom J I} {(w : Hom J I) * MO.Fn[x, y].M J} (\ h -> (h, m)) eu) (apH {MO.Fn[x, y].M J} {(w : Hom J I) * MO.Fn[x, y].M J} (\ n -> (u', n)) em) ;
 -- the laws
 idlL (J I : Ob) (u : Hom J I) (y x : Pres) (f : MO.Fn[x, y].M J)
  : Id ((w : Hom J I) * MO.Fn[x, y].M J) (compH J I I (idH I) u, cmpM J I I u y x x (idM I x) f) (u, f) =
  pq J I y x (compH J I I (idH I) u) u (comp-idl J I u) (cmpM J I I u y x x (idM I x) f) f
   (MO.Fn[x, y].mExt J (cmpM J I I u y x x (idM I x) f) f (refl (MO.Fn[x, y].fpOf J f))) ;
 idrL (J I : Ob) (u : Hom J I) (y x : Pres) (f : MO.Fn[x, y].M J)
  : Id ((w : Hom J I) * MO.Fn[x, y].M J) (compH J J I u (idH J), cmpM J J I (idH J) y y x f (idM J y)) (u, f) =
  pq J I y x (compH J J I u (idH J)) u (comp-idr J I u) (cmpM J J I (idH J) y y x f (idM J y)) f
   (MO.Fn[x, y].mExt J (cmpM J J I (idH J) y y x f (idM J y)) f
     (MO.Fn[x, y].rxEq J J (\ K' k -> compH K' J J (idH J) k) (\ K' k -> k) (\ K' k -> comp-idl K' J k) (MO.Fn[x, y].fpOf J f))) ;
 module As (L K J I : Ob) (u : Hom J I) (v : Hom K J) (w : Hom L K) (t z y x : Pres)
  (f : MO.Fn[x, y].M J) (g : MO.Fn[y, z].M K) (h : MO.Fn[z, t].M L) {
  lhs : MO.Fn[x, t].M L = cmpM L K I w t z x (cmpM K J I v z y x f g) h ;
  rhs : MO.Fn[x, t].M L = cmpM L J I (compH L K J v w) t y x f (cmpM L K J w t z y g h) ;
  rr : Id (MO.Fn[x, y].FP L) (MO.Fn[x, y].rx J L (\ K' k -> compH K' K J v (compH K' L K w k)) (MO.Fn[x, y].fpOf J f))
                             (MO.Fn[x, y].rx J L (\ K' k -> compH K' L J (compH L K J v w) k) (MO.Fn[x, y].fpOf J f)) =
   MO.Fn[x, y].rxEq J L (\ K' k -> compH K' K J v (compH K' L K w k)) (\ K' k -> compH K' L J (compH L K J v w) k)
    (\ K' k -> symH (comp-assoc K' L K J v w k)) (MO.Fn[x, y].fpOf J f) ;
  eFP : Id (MO.Fn[x, t].FP L) (MO.Fn[x, t].fpOf L lhs) (MO.Fn[x, t].fpOf L rhs) =
   apH {MO.Fn[x, y].FP L} {MO.Fn[x, t].FP L} (\ a0 -> MO.CmpF[x, y, t].cmpFP L a0 (MO.CmpF[y, z, t].cmpFP L (MO.Fn[y, z].rx K L (\ K' k -> compH K' L K w k) (MO.Fn[y, z].fpOf K g)) (MO.Fn[z, t].fpOf L h))) rr ;
  law : Id ((w2 : Hom L I) * MO.Fn[x, t].M L) (compH L K I (compH K J I u v) w, lhs) (compH L J I u (compH L K J v w), rhs) =
   pq L I t x (compH L K I (compH K J I u v) w) (compH L J I u (compH L K J v w)) (comp-assoc L K J I u v w) lhs rhs (MO.Fn[x, t].mExt L lhs rhs eFP) ;
 } ;

 IC : CIntCat[a, a+].IC = new CIntCat[a, a+].IC[
  \ I -> obV1,
  \ J I u y x -> homV1 J y x,
  \ I x -> idM I x,
  \ K J I u v z y x f g -> cmpM K J I v z y x f g,
  \ J I u y x f -> idlL J I u y x f,
  \ J I u y x f -> idrL J I u y x f,
  \ L K J I u v w t z y x f g h -> As[L, K, J, I, u, v, w, t, z, y, x, f, g, h].law,
  \ J I u x -> x,
  \ J I u x -> idM J x,
  \ K J I u v z x h -> h,
  \ K J I u v z x h -> MO.Fn[x, z].mExt K (cmpM K J I v z x x (idM J x) h) h (refl (MO.Fn[x, z].fpOf K h)),
  \ K J I u v z x h g e -> MO.Fn[x, z].mExt K g h (apH {MO.Fn[x, z].M K} {MO.Fn[x, z].FP K} (MO.Fn[x, z].fpOf K) e),
  \ I x -> refl x,
  \ K J I u v x -> refl x,
  \ I x -> refl (idM I x),
  \ K J I u v x -> MO.Fn[x, x].mExt K (cmpM K J I v x x x (idM J x) (idM K x)) (idM K x) (refl (MO.Fn[x, x].fpOf K (idM K x)))] ;
} ;
