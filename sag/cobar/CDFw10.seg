-- CDFw10.seg (canonicity-c2; (d)(1), part 10): fwd's body t0 at (K, (tt, z)):
-- the second component's first is the values of z at the new generators
-- (CDFw1.vt of the valuation of z at x.u's generators).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module Fw10 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F9 = CDFw9[a].Fw9[R, encK, pe, x, u, y] ;
 module F8 = F9.F8 ;
 module F1 = F8.F1 ;
 module S1 = F1.S1 ;
 Nl : C.Ctx = C.nil ;
 HU : C.Ty Nl = F8.HU ;
 D1 : C.Ctx = F8.D1 ;
 SolD : C.Ty D1 = C.subT D1 F8.Gh F1.S2.Sol F8.sg1 ;
 SolD' : C.Ty D1 = C.subT D1 (C.ext D1 F8.HXD) (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0) (C.sec D1 F8.HXD F1.hX) ;
 SK (K : Ob) (z : V1.Ix (HU.1.tob K tt)) : U a+ = V1.Ix (SolD.1.tob K (tt, z)) ;
 rs1 (K : Ob) (z : V1.Ix (HU.1.tob K tt)) : Id (SK K z) ((OV.trE D1 SolD SolD' F8.PS0 F8.sol).eob K (tt, z)) (F8.sol.eob K (tt, z)) =
  transH (CAppRd[a].trE-rd D1 SolD SolD' F8.PS0 F8.sol K (tt, z)) (CAppRd[a].same-rd D1 SolD SolD' F8.PS0 K (tt, z) (refl (SolD.1.tob K (tt, z))) (F8.sol.eob K (tt, z))) ;
 SP (K : Ob) (z : V1.Ix (HU.1.tob K tt)) : Id (V1.Ix (SolD.1.tob K (tt, z))) (F8.sol.eob K (tt, z))
   ((INm.pr D1 F8.PmD (C.subT (C.ext D1 F8.PmD) S1.Dv F8.RP F8.lf1) F1.vv
      (OV.trE D1 (C.subT D1 S1.Dv F8.RP F1.sg2) (C.subT D1 (C.ext D1 F8.PmD) (C.subT (C.ext D1 F8.PmD) S1.Dv F8.RP F8.lf1) (C.sec D1 F8.PmD F1.vv)) F8.PS1 (F8.F7m.relEl u.2 (\ p mm -> mm)))).eob K (tt, z)) =
  transH (CAppRd[a].trE-rd D1 (SS.Sig D1 F8.PmD (C.subT (C.ext D1 F8.PmD) S1.Dv F8.RP F8.lf1)) SolD (symH (FibCwF[a, a+].fibSig.Sig-nat D1 F8.Gh F8.Pm' F8.RP F8.sg1))
           (INm.pr D1 F8.PmD (C.subT (C.ext D1 F8.PmD) S1.Dv F8.RP F8.lf1) F1.vv
              (OV.trE D1 (C.subT D1 S1.Dv F8.RP F1.sg2) (C.subT D1 (C.ext D1 F8.PmD) (C.subT (C.ext D1 F8.PmD) S1.Dv F8.RP F8.lf1) (C.sec D1 F8.PmD F1.vv)) F8.PS1 (F8.F7m.relEl u.2 (\ p mm -> mm)))) K (tt, z))
   (CAppRd[a].same-rd D1 (SS.Sig D1 F8.PmD (C.subT (C.ext D1 F8.PmD) S1.Dv F8.RP F8.lf1)) SolD (symH (FibCwF[a, a+].fibSig.Sig-nat D1 F8.Gh F8.Pm' F8.RP F8.sg1)) K (tt, z) (refl (SolD.1.tob K (tt, z)))
      ((INm.pr D1 F8.PmD (C.subT (C.ext D1 F8.PmD) S1.Dv F8.RP F8.lf1) F1.vv
         (OV.trE D1 (C.subT D1 S1.Dv F8.RP F1.sg2) (C.subT D1 (C.ext D1 F8.PmD) (C.subT (C.ext D1 F8.PmD) S1.Dv F8.RP F8.lf1) (C.sec D1 F8.PmD F1.vv)) F8.PS1 (F8.F7m.relEl u.2 (\ p mm -> mm)))).eob K (tt, z))) ;
 rdV (K : Ob) (z : V1.Ix (HU.1.tob K tt)) : Id (S1.PK F1.m K) (F8.t0.eob K (tt, z)).2.1 (F1.vt F1.m K (F1.DE.SO1.hval K z)) =
  transH (apH {V1.Ix (F8.T0.1.tob K tt)} {S1.PK F1.m K} (\ v -> v.2.1) (F9.rd0 K z))
   (apH {SK K z} {S1.PK F1.m K} (\ v -> v.1) (transH (rs1 K z) (SP K z))) ;
} ;
