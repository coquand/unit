-- CEv5.seg (canonicity-c2; HomT(F1, y) ~ Q_y, part 5): the fibre element
-- (h_t, ev h_t = q) over GB.S, in the type of the fibre.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module E5 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module E4m = CEv4[a].E4[R, encK, pe, y] ;
 module E3m = E4m.E3m ;
 module I = E4m.I ;
 Nl : C.Ctx = C.nil ;
 GS : C.Ctx = E4m.GS ;
 GB : C.Ctx = E4m.GB ;
 pS : C.Sub GS GB = E4m.pS ;
 HT : C.Ty Nl = E3m.HT ;
 Xs : C.Ty GS = C.subT GS GB I.Xb pS ;
 PXs : Id (C.Ty GS) (C.subT GS E3m.DT (OV.wkT Nl E3m.Tm HT) E4m.tau) Xs =
  transH (symH (C.subT-o GS E3m.DT Nl HT (C.p Nl E3m.Tm) E4m.tau))
   (transH (apH {C.Sub GS Nl} {C.Ty GS} (\ s -> C.subT GS Nl HT s) (L.sub-ext GS Nl (C.o GS E3m.DT Nl (C.p Nl E3m.Tm) E4m.tau) (C.o GS GB Nl (C.p Nl I.B) pS) (\ K w -> refl w.1.1)))
     (C.subT-o GS GB Nl HT (C.p Nl I.B) pS)) ;
 hv : C.El GS Xs = OV.trE GS (C.subT GS E3m.DT (OV.wkT Nl E3m.Tm HT) E4m.tau) Xs PXs (C.subt GS E3m.DT (OV.wkT Nl E3m.Tm HT) E3m.hfam E4m.tau) ;
 hvr (K : Ob) (w : V1.Ix (GS.ob K)) : Id (V1.Ix (Xs.1.tob K w)) (hv.eob K w) (E3m.hob w.2.1 K w.1.1) =
  transH (CAppRd[a].trE-rd GS (C.subT GS E3m.DT (OV.wkT Nl E3m.Tm HT) E4m.tau) Xs PXs (C.subt GS E3m.DT (OV.wkT Nl E3m.Tm HT) E3m.hfam E4m.tau) K w)
   (CAppRd[a].same-rd GS (C.subT GS E3m.DT (OV.wkT Nl E3m.Tm HT) E4m.tau) Xs PXs K w (refl (Xs.1.tob K w)) (E3m.hob w.2.1 K w.1.1)) ;
 lf : C.Sub (C.ext GS Xs) I.GX = C.lift GS GB I.Xb pS ;
 Ys : C.Ty (C.ext GS Xs) = C.subT (C.ext GS Xs) I.GX I.Fm lf ;
 rho : C.Sub GS I.GX = C.o GS (C.ext GS Xs) I.GX lf (C.sec GS Xs hv) ;
 T0x : C.Ty I.GX = OV.wkT I.GB I.Xb I.Bb ;
 qw : C.El I.GX T0x = OV.wkE I.GB I.Xb I.Bb (C.q Nl I.B) ;
 module MX = E4m.Mv[I.GX, T0x, C.o I.GX I.GB Nl (C.p Nl I.B) I.pX, symH (C.subT-o I.GX I.GB Nl I.B (C.p Nl I.B) I.pX), rho, \ K w -> refl (E4m.s0.nt K w)] ;
 QS0 : C.Ty GS = E4m.QS0 ;
 QK (K : Ob) (w : V1.Ix (GS.ob K)) : U a+ = V1.Ix (QS0.1.tob K w) ;
 -- readings of the moved elements
 pAt (K : Ob) : (o : Top) (t : E3m.TmY) -> Id (V1.Ix (I.B.1.tob K o)) ((E3m.pA t).eob K o) (I.n.nfun K o (E3m.hob t K o)) =
  split { tt -> \ t -> CAppRd[a].App0[E3m.E1m.QA, E3m.QY, E3m.SC[t].S0.SM.Phi, E3m.cx].rd K tt } ;
 px (K : Ob) (w : V1.Ix (GS.ob K)) : Id (QK K w) ((E4m.MB.el (E3m.Fam[E4m.QY, E3m.pA].el)).eob K w) ((MX.el I.apX).eob K w) =
  transH (CAppRd[a].trE-rd GS (C.subT GS E3m.DT (OV.wkT Nl E3m.Tm E4m.QY) E4m.tau) QS0 E4m.MB.P (C.subt GS E3m.DT (OV.wkT Nl E3m.Tm E4m.QY) (E3m.Fam[E4m.QY, E3m.pA].el) E4m.tau) K w)
   (transH (CAppRd[a].same-rd GS (C.subT GS E3m.DT (OV.wkT Nl E3m.Tm E4m.QY) E4m.tau) QS0 E4m.MB.P K w (refl (QS0.1.tob K w)) ((E3m.pA w.2.1).eob K w.1.1))
     (transH (pAt K w.1.1 w.2.1)
       (symH (transH (CAppRd[a].trE-rd GS (C.subT GS I.GX T0x rho) QS0 MX.P (C.subt GS I.GX T0x I.apX rho) K w)
          (transH (CAppRd[a].same-rd GS (C.subT GS I.GX T0x rho) QS0 MX.P K w (refl (QS0.1.tob K w)) (I.apX.eob K (rho.nt K w)))
            (transH (I.appR K (rho.nt K w)) (apH {V1.Ix (HT.1.tob K w.1.1)} {QK K w} (I.n.nfun K w.1.1) (hvr K w)))))))) ;
 py (K : Ob) (w : V1.Ix (GS.ob K)) : Id (QK K w) ((E4m.ME.el E4m.QS.qE).eob K w) ((MX.el qw).eob K w) =
  transH (CAppRd[a].trE-rd GS (C.subT GS E4m.QS.E E4m.QS.T0 E4m.pi) QS0 E4m.ME.P (C.subt GS E4m.QS.E E4m.QS.T0 E4m.QS.qE E4m.pi) K w)
   (transH (CAppRd[a].same-rd GS (C.subT GS E4m.QS.E E4m.QS.T0 E4m.pi) QS0 E4m.ME.P K w (refl (QS0.1.tob K w)) (E4m.QS.qE.eob K (E4m.piN K w)))
     (symH (transH (CAppRd[a].trE-rd GS (C.subT GS I.GX T0x rho) QS0 MX.P (C.subt GS I.GX T0x qw rho) K w)
        (CAppRd[a].same-rd GS (C.subT GS I.GX T0x rho) QS0 MX.P K w (refl (QS0.1.tob K w)) (qw.eob K (rho.nt K w)))))) ;
 iv0 : C.El GS (IJ.IdT GS QS0 (MX.el I.apX) (MX.el qw)) =
  CCmpU14[a].rwId GS QS0 (E4m.MB.el (E3m.Fam[E4m.QY, E3m.pA].el)) (MX.el I.apX) (E4m.ME.el E4m.QS.qE) (MX.el qw) px py E4m.B12 ;
 -- back to the fibre's types
 T0r : C.Ty GS = C.subT GS I.GX T0x rho ;
 iv1a : C.El GS (IJ.IdT GS T0r (OV.trE GS QS0 T0r (symH MX.P) (MX.el I.apX)) (OV.trE GS QS0 T0r (symH MX.P) (MX.el qw))) =
  CInjP[a].idFwdL GS QS0 T0r (symH MX.P) (MX.el I.apX) (MX.el qw) iv0 ;
 iv1 : C.El GS (IJ.IdT GS T0r (C.subt GS I.GX T0x I.apX rho) (C.subt GS I.GX T0x qw rho)) =
  subst (C.El GS T0r) (\ v -> C.El GS (IJ.IdT GS T0r (C.subt GS I.GX T0x I.apX rho) v)) (OV.trE GS QS0 T0r (symH MX.P) (MX.el qw)) (C.subt GS I.GX T0x qw rho)
   (CInjP[a].trInv GS T0r QS0 MX.P (C.subt GS I.GX T0x qw rho))
   (subst (C.El GS T0r) (\ v -> C.El GS (IJ.IdT GS T0r v (OV.trE GS QS0 T0r (symH MX.P) (MX.el qw)))) (OV.trE GS QS0 T0r (symH MX.P) (MX.el I.apX)) (C.subt GS I.GX T0x I.apX rho)
      (CInjP[a].trInv GS T0r QS0 MX.P (C.subt GS I.GX T0x I.apX rho)) iv1a) ;
 iv2 : C.El GS (C.subT GS I.GX I.Fm rho) =
  OV.trE GS (IJ.IdT GS T0r (C.subt GS I.GX T0x I.apX rho) (C.subt GS I.GX T0x qw rho)) (C.subT GS I.GX I.Fm rho) (symH (IJ.IdT-nat GS I.GX T0x I.apX qw rho)) iv1 ;
 iv : C.El GS (C.subT GS (C.ext GS Xs) Ys (C.sec GS Xs hv)) =
  OV.trE GS (C.subT GS I.GX I.Fm rho) (C.subT GS (C.ext GS Xs) Ys (C.sec GS Xs hv)) (C.subT-o GS (C.ext GS Xs) I.GX I.Fm lf (C.sec GS Xs hv)) iv2 ;
 fEl : C.El GS (C.subT GS GB I.Fib pS) =
  OV.trE GS (SS.Sig GS Xs Ys) (C.subT GS GB I.Fib pS) (symH (FibCwF[a, a+].fibSig.Sig-nat GS GB I.Xb I.Fm pS)) (INm.pr GS Xs Ys hv iv) ;
 -- into the truncation, and the elimination of mere surjectivity
 TA : CwFTrunc.Trunc[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv].TruncAt = CQSurj[a].TA ;
 TrF : C.Ty GB = TA.Tr GB I.Fib ;
 xS : C.Sub GS (C.ext GB I.Fib) = CQSurj[a].Ex[C].exS GS GB I.Fib pS fEl ;
 incF : C.El GS (C.subT GS GB TrF pS) =
  OV.trE GS (C.subT GS (C.ext GB I.Fib) (OV.wkT GB I.Fib TrF) xS) (C.subT GS GB TrF pS)
   (transH (symH (C.subT-o GS (C.ext GB I.Fib) GB TrF (C.p GB I.Fib) xS)) (apH {C.Sub GS GB} {C.Ty GS} (\ s -> C.subT GS GB TrF s) (INm.p-extS GS GB I.Fib pS fEl)))
   (C.subt GS (C.ext GB I.Fib) (OV.wkT GB I.Fib TrF) (TA.inc GB I.Fib) xS) ;
 TrS : C.Ty GB = TA.Tr GB E4m.S ;
 GT : C.Ctx = C.ext GB TrS ;
 Bm : C.Ty GT = OV.wkT GB TrS TrF ;
 pBm : C.El GT (PU.isProp GT Bm) =
  OV.trE GT (C.subT GT GB (PU.isProp GB TrF) (C.p GB TrS)) (PU.isProp GT Bm) (PU.isProp-ov GT GB TrF (C.p GB TrS) Bm (refl Bm))
   (C.subt GT GB (PU.isProp GB TrF) (TA.trProp GB I.Fib) (C.p GB TrS)) ;
 bm : C.El GS (C.subT GS GT Bm (TA.incS GB E4m.S)) =
  OV.trE GS (C.subT GS GB TrF pS) (C.subT GS GT Bm (TA.incS GB E4m.S))
   (transH (apH {C.Sub GS GB} {C.Ty GS} (\ s -> C.subT GS GB TrF s) (symH (INm.p-extS GS GB TrS pS (TA.inc GB E4m.S))))
     (C.subT-o GS GT GB TrF (C.p GB TrS) (TA.incS GB E4m.S))) incF ;
 elT : C.El GT Bm = TA.elim GB E4m.S Bm pBm bm ;
 ms : C.El GB TrF = OV.trE GB (C.subT GB GT Bm (C.sec GB TrS E4m.QS.msurj)) TrF (CAppRd[a].W.psT GB TrS TrF E4m.QS.msurj) (C.subt GB GT Bm elT (C.sec GB TrS E4m.QS.msurj)) ;
} ;
