-- CUG23.seg (canonicity-c2; the generic (U), part 23 of CCmpU23's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU23 with
-- F2 replaced by s.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module UG23 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) {
 module U22m = CUG22[a].UG22[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN] ;
 module U20m = CUG20[a].UG20[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN] ;
 module U16m = U22m.U16m ;
 module U13m = U20m.U13m ;
 module HZ = U16m.HZ ;
 module BZ = U16m.BZ ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = U20m.GH ;
 HS : C.Ty Nl = U16m.HS ;
 D1 : C.Ctx = U16m.D1 ;
 QA : C.Ty Nl = U16m.QA ;
 QY : C.Ty Nl = U16m.QY ;
 QYd : C.Ty D1 = U16m.QYd ;
 QYh : C.Ty GH = OV.wkT Nl H QY ;
 module At (r : R.R) {
  module A0 = U22m.At[r] ;
  c : C.El Nl QA = A0.WC.c ;
  kT : C.El GH QYh = OV.wkE Nl H QY (HZ.AT.AX.cls (cst r)) ;
  module Pb (pk : (K : Ob) (w : V1.Ix (GH.ob K)) -> V1.Ix (HS.1.tob K w.1))
    (pkN : (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I))
      -> Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pk I w)) (pk J (GH.act J I f w)))
    (apZ : C.El Nl QA -> C.El GH QYh)
    (zr : (c0 : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) -> Id (V1.Ix (QYh.1.tob K w)) ((apZ c0).eob K w) (BZ.hv K w.1 (pk K w).1 (c0.eob K w.1))) {
   sgN (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (D1.ob K) = (w.1, pk K w) ;
   sg : C.Sub GH D1 = new L.PSub[GH, D1, sgN, \ J I f w -> apH {V1.Ix (HS.1.tob J w.1)} {V1.Ix (D1.ob J)} (\ v -> (w.1, v)) (symH (pkN J I f w))] ;
   pl : C.El GH (IJ.IdT GH (C.subT GH D1 QYd sg) (C.subt GH D1 QYd A0.e1 sg) (C.subt GH D1 QYd A0.e3 sg)) =
    OV.trE GH (C.subT GH D1 (IJ.IdT D1 QYd A0.e1 A0.e3) sg) (IJ.IdT GH (C.subT GH D1 QYd sg) (C.subt GH D1 QYd A0.e1 sg) (C.subt GH D1 QYd A0.e3 sg))
     (IJ.IdT-nat GH D1 QYd A0.e1 A0.e3 sg) (C.subt GH D1 (IJ.IdT D1 QYd A0.e1 A0.e3) A0.res sg) ;
   PY : Id (C.Ty GH) (C.subT GH D1 QYd sg) QYh =
    transH (symH (C.subT-o GH D1 Nl QY (C.p Nl HS) sg)) (U16m.clT GH QY (C.o GH D1 Nl (C.p Nl HS) sg) (C.p Nl H)) ;
   y1 : C.El GH QYh = OV.trE GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd A0.e1 sg) ;
   y3 : C.El GH QYh = OV.trE GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd A0.e3 sg) ;
   p2 : C.El GH (IJ.IdT GH QYh y1 y3) = U16m.idFwd GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd A0.e1 sg) (C.subt GH D1 QYd A0.e3 sg) pl ;
   y1r (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) (y1.eob K w) (kT.eob K w) =
    transH (CAppRd[a].trE-rd GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd A0.e1 sg) K w)
     (transH (CAppRd[a].same-rd GH (C.subT GH D1 QYd sg) QYh PY K w (refl (QYh.1.tob K w)) (A0.e1.eob K (sgN K w)))
       (A0.e1rd K (sgN K w))) ;
   y3r (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (QYh.1.tob K w)) (y3.eob K w) ((apZ c).eob K w) =
    transH (CAppRd[a].trE-rd GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd A0.e3 sg) K w)
     (transH (CAppRd[a].same-rd GH (C.subT GH D1 QYd sg) QYh PY K w (refl (QYh.1.tob K w)) (A0.e3.eob K (sgN K w)))
       (transH (A0.e3rd K (sgN K w)) (symH (zr c K w)))) ;
   res : C.El GH (IJ.IdT GH QYh kT (apZ c)) = CCmpU14[a].rwId GH QYh y1 kT y3 (apZ c) y1r y3r p2 ;
  } ;
  module PA = Pb[pkA, pkAN, U13m.ZA.apC, U13m.ZA.rdF] ;
  module PB = Pb[pkB, pkBN, U13m.ZB.apC, U13m.ZB.rdF] ;
  res : C.El GH (IJ.IdT GH QYh (U13m.ZA.apC c) (U13m.ZB.apC c)) =
   PT.transM GH QYh (U13m.ZA.apC c) kT (U13m.ZB.apC c) (PT.symM GH QYh kT (U13m.ZA.apC c) PA.res) PB.res ;
 } ;
} ;
