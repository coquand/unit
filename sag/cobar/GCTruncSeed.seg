-- GCTruncSeed.seg: GENERATED from CTruncSeed.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change CTruncSeed.seg or the generator.
-- CTruncSeed.seg (canonicity-c2; SIMPLIFIED.md item 1): transport of
-- the base truncation along lines.
--
-- Over the context L of lines of G, with ends s = ev (src d) and
-- t = ev (tgt d): the transport of A (CTr) followed by inc is a natural
-- map A[s] -> ||A||[t] over L.  Its transpose A -> s_* (||A||[t])
-- (CTruncPushAdj.Tp) goes into a seeded extension algebra (CTruncSubOp,
-- CTruncPushAlg), so the truncation's recursor gives ||A|| -> s_* (||A||[t]),
-- and untransposing (Ut) the map
--     seed : ||A||[s] -> ||A||[t]   over L, natural.
level l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;
module CL = PB.CLine[l] ;

module Seed (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CL.Lines[G, A].CompK[PB.src d, PB.tgt d].Comp) {
  module TT = GCTrunc[l].Truncation[G, A] ;
  module FG = CL.FC[G] ;
  L : PCtx = FG.GI ;
  evs : PSub[L, G] = FG.ev (PB.src d) ;
  evt : PSub[L, G] = FG.ev (PB.tgt d) ;
  module TR = PB.CTr[l].Tr[G, A, d, ca] ;
  opG : GCTruncSeededBack[l].Seeded[G, TT.Ty].Op = GCTruncSeededBack[l].Seeded[G, TT.Ty].RoundTrip[TT.algebra].op ;
  module SO = GCTruncSubOp[l].SubOp[L, G, evt, TT.Ty, opG] ;
  Tt : PTy[L] = SO.Bs ;
  As : PTy[L] = subTy L G A evs ;

  -- the transported value
  trv (X : Ob) (ln : W.Ix (L.ob X)) (b : W.Ix (As.tob X ln)) : W.Ix (A.tob X (evt.nt X ln)) =
    TR.TA'.pr2 X (TR.trE X (TR.TB.pr X ln b)) ;
  trv-nat (J I : Ob) (f : Hom J I) (ln : W.Ix (L.ob I)) (b : W.Ix (As.tob I ln))
    : Id (W.Ix (A.tob J (evt.nt J (L.act J I f ln))))
        (TR.SA.tact J I f ln (L.act J I f ln) (refl (L.act J I f ln)) (trv I ln b))
        (trv J (L.act J I f ln) (As.tact J I f ln (L.act J I f ln) (refl (L.act J I f ln)) b)) =
    TR.TA'.pr-inj J (L.act J I f ln) _ _
      (transH (symH (TR.TA'.pr-tact J I f ln (L.act J I f ln) (refl (L.act J I f ln)) (trv I ln b)))
        (transH (symH (TR.trNat J I f (TR.TB.pr I ln b)))
          (apH (TR.trE J) (TR.TB.pr-tact J I f ln (L.act J I f ln) (refl (L.act J I f ln)) b)))) ;

  mfun (X : Ob) (ln : W.Ix (L.ob X)) (b : W.Ix (As.tob X ln)) : W.Ix (Tt.tob X ln) =
    TT.inclusion.nfun X (evt.nt X ln) (trv X ln b) ;
  mnat0 (J I : Ob) (f : Hom J I) (ln : W.Ix (L.ob I)) (b : W.Ix (As.tob I ln))
    : Id (W.Ix (Tt.tob J (L.act J I f ln)))
        (Tt.tact J I f ln (L.act J I f ln) (refl (L.act J I f ln)) (mfun I ln b))
        (mfun J (L.act J I f ln) (As.tact J I f ln (L.act J I f ln) (refl (L.act J I f ln)) b)) =
    transH (TT.inclusion.nnat J I f (evt.nt I ln) (evt.nt J (L.act J I f ln))
              (ntEq L G evt J I f ln (L.act J I f ln) (refl (L.act J I f ln))) (trv I ln b))
      (apH (TT.inclusion.nfun J (evt.nt J (L.act J I f ln))) (trv-nat J I f ln b)) ;
  mnat (J I : Ob) (f : Hom J I) (ln : W.Ix (L.ob I)) (ln' : W.Ix (L.ob J)) (e : Id (W.Ix (L.ob J)) (L.act J I f ln) ln') (b : W.Ix (As.tob I ln))
    : Id (W.Ix (Tt.tob J ln')) (Tt.tact J I f ln ln' e (mfun I ln b)) (mfun J ln' (As.tact J I f ln ln' e b)) =
    idJ (W.Ix (L.ob J)) (L.act J I f ln)
      (\ l2 e2 -> Id (W.Ix (Tt.tob J l2)) (Tt.tact J I f ln l2 e2 (mfun I ln b)) (mfun J l2 (As.tact J I f ln l2 e2 b)))
      (mnat0 J I f ln b) ln' e ;
  m : HO.NMap[L, As, Tt] = new HO.NMap[L, As, Tt, mfun, mnat] ;

  module TPm = GCTruncPushAdj[l].Tp[L, G, evs, A, Tt, m] ;
  module PA = GCTruncPushAlg[l].PushAlg[L, G, evs, Tt, SO.op] ;
  module RC = TT.Recursor[TPm.Pu.pushTy, PA.algebra, TPm.map] ;
  module UTm = GCTruncPushAdj[l].Ut[L, G, evs, TT.Ty, Tt, RC.map] ;
  -- the transport of the truncation along lines
  seed : HO.NMap[L, subTy L G TT.Ty evs, Tt] = UTm.map ;
} ;
