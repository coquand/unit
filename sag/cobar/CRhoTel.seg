-- CRhoTel.seg (canonicity-45; COBAR.md "Prop 58"): rho's map into c2's
-- telescope context: for each equation q of u, the internal Id of CRhoId
-- retyped into c2's EqT at the telescope point (Gat's substitution, the
-- readings of c2's evaluation at rho's point, IdT-nat), and the telescope
-- map built equation by equation.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module RT (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module RP = CRhoPt[a].RP[R, encK, pe, y, u] ;
 module RI = RP.RI ;
 module SO = RP.SP.SO ;
 module EG = RP.EG ;
 C : CwF.CwF[a++] = EG.C ;
 module G1 = RI.Tu.G1 ;
 module OVG = CwFOv.Ov[a++, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T] ;
 IJG : CwFId.SwanId[a++, G1.fibCwF-T].IdJStr = G1.fibId-T ;
 idFwd (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (w : C.El G (IJG.IdT G X x y))
   : C.El G (IJG.IdT G X' (OVG.trE G X X' P x) (OVG.trE G X X' P y)) =
  idJ (C.Ty G) X (\ Z PZ -> C.El G (IJG.IdT G Z (OVG.trE G X Z PZ x) (OVG.trE G X Z PZ y))) w X' P ;
 K : C.Ctx = RP.K ;
 yu : SX.Over[R].Presentation = RI.yu ;
 TmU : U a = SX.Over[R].Der[yu].Term ;
 rn (q : TmU) : SX.Over[R].Expr SO.TW.Var = SX.Rel[R].rename (SX.Fin yu.1) SO.TW.Var (RP.AYm.spl RP.n) q ;
 -- readings of transports at G1 (as CAppRd)
 trERd (G : C.Ctx) (A A' : C.Ty G) (P : Id (C.Ty G) A A') (e : C.El G A) (I : EG.Ob) (x : V1.Ix (G.ob I))
  : Id (V1.Ix (A'.1.tob I x)) ((OVG.trE G A A' P e).eob I x) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A' P (e.eob I x)) =
  idJ (C.Ty G) A (\ A2 P2 -> Id (V1.Ix (A2.1.tob I x)) ((OVG.trE G A A2 P2 e).eob I x) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A2 P2 (e.eob I x)))
   (refl (e.eob I x)) A' P ;
 sameRd (G : C.Ctx) (A A' : C.Ty G) (P : Id (C.Ty G) A A') (I : EG.Ob) (x : V1.Ix (G.ob I)) (E2 : Id V1.V (A.1.tob I x) (A'.1.tob I x)) (v : V1.Ix (A.1.tob I x))
  : Id (V1.Ix (A'.1.tob I x)) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A' P v) (subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A'.1.tob I x) E2 v) =
  transH (idJ (C.Ty G) A (\ A2 P2 -> Id (V1.Ix (A2.1.tob I x)) (subst (C.Ty G) (\ T -> V1.Ix (T.1.tob I x)) A A2 P2 v)
                                       (subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A2.1.tob I x) (apH {C.Ty G} {V1.V} (\ T -> T.1.tob I x) P2) v))
          (refl v) A' P)
   (apH {Id V1.V (A.1.tob I x) (A'.1.tob I x)} {V1.Ix (A'.1.tob I x)} (\ r -> subst V1.V (\ c -> V1.Ix c) (A.1.tob I x) (A'.1.tob I x) r v)
     (V1.isSetV (A.1.tob I x) (A'.1.tob I x) (apH {C.Ty G} {V1.V} (\ T -> T.1.tob I x) P) E2)) ;
 -- c2's gsub read pointwise
 gP (E : C.Ctx) (s0 : C.Sub E SO.Xc) : Id (C.Ty E) (C.subT E SO.Xc (SO.PW.Gat SO.Xc) s0) (SO.PW.Gat E) =
  transH (symH (C.subT-o E SO.Xc EG.Nl SO.PW.GTy (C.eps SO.Xc) s0))
   (apH {C.Sub E EG.Nl} {C.Ty E} (\ t -> C.subT E EG.Nl SO.PW.GTy t) (transH (C.eps-uniq E (C.o E SO.Xc EG.Nl (C.eps SO.Xc) s0)) (symH (C.eps-uniq E (C.eps E))))) ;
 gsubRd (E : C.Ctx) (s0 : C.Sub E SO.Xc) (g : C.El SO.Xc (SO.PW.Gat SO.Xc)) (I : EG.Ob) (x : V1.Ix (E.ob I))
  : Id (V1.Ix ((SO.PW.Gat E).1.tob I x)) ((SO.gsub E s0 g).eob I x) (g.eob I (s0.nt I x)) =
  transH (trERd E (C.subT E SO.Xc (SO.PW.Gat SO.Xc) s0) (SO.PW.Gat E) (gP E s0) (C.subt E SO.Xc (SO.PW.Gat SO.Xc) g s0) I x)
   (sameRd E (C.subT E SO.Xc (SO.PW.Gat SO.Xc) s0) (SO.PW.Gat E) (gP E s0) I x (refl ((SO.PW.Gat E).1.tob I x)) (g.eob I (s0.nt I x))) ;
 -- the type of G at K, two ways
 module HStep (Lq : SX.Over[R].Equations SO.TW.Var) (sg : C.Sub K (SO.HS Lq).1) {
  E : C.Ctx = (SO.HS Lq).1 ;
  GsK : Id (C.Ty K) (C.subT K E (SO.PW.Gat E) sg) (SO.PW.Gat K) =
   transH (symH (C.subT-o K E EG.Nl SO.PW.GTy (C.eps E) sg))
    (apH {C.Sub K EG.Nl} {C.Ty K} (\ t -> C.subT K EG.Nl SO.PW.GTy t) (transH (C.eps-uniq K (C.o K E EG.Nl (C.eps E) sg)) (symH (C.eps-uniq K (C.eps K))))) ;
  sD : C.Sub E SO.Xc = (SO.HS Lq).2 ;
  module Eq (q : TmU) (d : SX.Over[R].Der[yu].Proof q SX.Over[R].Der[yu].zeroE)
    (pf : (X : EG.Ob) (z : V1.Ix (K.ob X)) -> Id (V1.Ix (SO.Xc.ob X)) (sD.nt X (sg.nt X z)) (RP.sgN X z)) {
   module EQ = RI.Eq[q, d] ;
   YYeq : Id (C.Ty K) EQ.HI.YY (SO.PW.Gat K) =
    apH {C.Sub K EG.Nl} {C.Ty K} (\ t -> C.subT K EG.Nl SO.PW.GTy t) (C.eps-uniq K (RI.Tu.G1.GB.GPre[a+].PS.pP RI.Tu.P1 RI.Tu.XT)) ;
   P2 : Id (C.Ty K) EQ.HI.YY (C.subT K E (SO.PW.Gat E) sg) = transH YYeq (symH GsK) ;
   Ty2 : C.Ty K = C.subT K E (SO.PW.Gat E) sg ;
   e1 : C.El K (IJG.IdT K Ty2 (OVG.trE K EQ.HI.YY Ty2 P2 EQ.HI.a0) (OVG.trE K EQ.HI.YY Ty2 P2 EQ.HI.b0)) =
    idFwd K EQ.HI.YY Ty2 P2 EQ.HI.a0 EQ.HI.b0 EQ.elq ;
   A' : C.El K Ty2 = C.subt K E (SO.PW.Gat E) (SO.gsub E sD (SO.TW.evE (rn q))) sg ;
   B' : C.El K Ty2 = C.subt K E (SO.PW.Gat E) (SO.gsub E sD SO.zE) sg ;
  } ;
 } ;
} ;
