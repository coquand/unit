-- CDFw1.seg (canonicity-c2; (d)(1), part 1): for a relative presentation u
-- over x, over D1 = nil.HomT(x.u, y) (variable z): h = z . p_u (CPreI.PI at
-- CMapsI.PuC), the values of z at the m new generators (semantic, in Q_y^m),
-- and the resulting point of CSolT's nil.HomT(x, y).Q_y^m with its valuation.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module Fw1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 xu : SX.Over[R].Presentation = SX.Rel[R].concat x u ;
 module PO = CPreI[a].PreOf[R, encK, pe] ;
 module PC = PO.CM.II.PuC[x, u] ;
 module PIu = PO.PI[xu, x, PC.M.mor, PC.M.mor-nat, y] ;
 module S2 = CSolT[a].SolOf2[R, encK, pe, x, u, y] ;
 module S1 = S2.S1 ;
 module DE = CDEv1[a].DE1[R, encK, pe, xu, y] ;
 module EV = S1.EV ;
 Nl : C.Ctx = C.nil ;
 n : Nat = S1.n ;
 m : Nat = S1.m ;
 HU : C.Ty Nl = DE.HS ;
 HXY : C.Ty Nl = S1.HXY ;
 D1 : C.Ctx = DE.D1 ;
 zv : C.El D1 (C.subT D1 Nl HU (C.p Nl HU)) = C.q Nl HU ;
 hX : C.El D1 (C.subT D1 Nl HXY (C.p Nl HU)) = CInjP[a].IP[HU, HXY, PIu.nmap].evS D1 (C.p Nl HU) zv ;
 sg1 : C.Sub D1 S1.Gh = CQSurj[a].Ex[C].exS D1 Nl HXY (C.p Nl HU) hX ;
 -- the new values, as a point of Q_y^m
 vt : (k : Nat) (K : Ob) -> (SX.Fin (Arith[a].plus k n) -> EV.QK K) -> S1.PK k K = split {
  zero -> \ K g -> tt ;
  suc k | r -> \ K g -> (r K (\ v -> g (inl v)), g (inr tt)) } ;
 vtNat : (k : Nat) (K Lo : Ob) (g : Hom Lo K) (f : SX.Fin (Arith[a].plus k n) -> EV.QK K)
   -> Id (S1.PK k Lo) (S2.PmAct k K Lo g (vt k K f)) (vt k Lo (\ i -> S1.rsQ K Lo g (f i))) = split {
  zero -> \ K Lo g f -> refl tt ;
  suc k | r -> \ K Lo g f ->
   transH (apH {S1.PK k Lo} {S1.PK (suc k) Lo}
             (\ w -> (w, (OV.wkT Nl (S1.Pm k) S1.Qy).1.tact Lo K g (tt, vt k K (\ v -> f (inl v))) (tt, S2.PmAct k K Lo g (vt k K (\ v -> f (inl v))))
                      (L.pair-act Nl (S1.Pm k).1 Lo K g tt tt (refl tt) (vt k K (\ v -> f (inl v)))) (f (inr tt))))
             (r K Lo g (\ v -> f (inl v))))
    (apH {EV.QK Lo} {S1.PK (suc k) Lo} (\ q -> (vt k Lo (\ i -> S1.rsQ K Lo g (f (inl i))), q))
       (L.tact-irr Nl S1.Qy.1 Lo K g tt tt
          (L.ntEq (C.ext Nl (S1.Pm k)) Nl (C.p Nl (S1.Pm k)) Lo K g (tt, vt k K (\ v -> f (inl v))) (tt, S2.PmAct k K Lo g (vt k K (\ v -> f (inl v))))
             (L.pair-act Nl (S1.Pm k).1 Lo K g tt tt (refl tt) (vt k K (\ v -> f (inl v)))))
          (refl tt) (f (inr tt)))) } ;
 PmD : C.Ty D1 = C.subT D1 S1.Gh S1.Pm' sg1 ;
 vvT (K : Ob) : (o : Top) -> V1.Ix (HU.1.tob K o) -> S1.PK m K = split { tt -> \ z -> vt m K (DE.SO1.hval K z) } ;
 vvB (J I : Ob) (f : Hom J I) : (o : Top) (z : V1.Ix (HU.1.tob I o))
   -> Id (V1.Ix (PmD.1.tob J (D1.act J I f (o, z)))) (PmD.1.tact J I f (o, z) (D1.act J I f (o, z)) (refl (D1.act J I f (o, z))) (vvT I o z)) (vvT J o (HU.1.tact J I f o o (refl o) z)) = split {
  tt -> \ z ->
   transH (L.tact-irr Nl (S1.Pm m).1 J I f tt tt (L.ntEq S1.Gh Nl (C.eps S1.Gh) J I f (sg1.nt I (tt, z)) (sg1.nt J (D1.act J I f (tt, z))) (L.ntEq D1 S1.Gh sg1 J I f (tt, z) (D1.act J I f (tt, z)) (refl (D1.act J I f (tt, z))))) (refl tt) (vvT I tt z))
    (transH (vtNat m I J f (DE.SO1.hval I z))
      (apH {SX.Fin (Arith[a].plus m n) -> EV.QK J} {S1.PK m J} (\ ff -> vt m J ff)
         (funext (SX.Fin (Arith[a].plus m n)) (\ i -> EV.QK J) (\ i -> S1.rsQ I J f (DE.SO1.hval I z i)) (DE.SO1.hval J (DE.S2.tactH I J f z)) (DE.S2.hvalNat I J f z)))) } ;
 vv : C.El D1 PmD = L.mkPEl D1 PmD.1 (\ K w -> vvT K w.1 w.2) (\ J I f w w' e ->
  idJ (V1.Ix (D1.ob J)) (D1.act J I f w) (\ w2 e2 -> Id (V1.Ix (PmD.1.tob J w2)) (PmD.1.tact J I f w w2 e2 (vvT I w.1 w.2)) (vvT J w2.1 w2.2))
    (vvB J I f w.1 w.2) w' e) ;
 -- the point of nil.HomT(x, y).Q_y^m and the valuation of nil.Q_y^(m+n)
 sg2 : C.Sub D1 S1.Dv = CQSurj[a].Ex[C].exS D1 S1.Gh S1.Pm' sg1 vv ;
 s2 : C.Sub D1 S2.GT = C.o D1 S1.Dv S2.GT S2.sigma sg2 ;
} ;
