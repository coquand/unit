-- CTotL16d.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, the double reading MW2, part 1 (inner index): for u in DAC over
-- tau g at (I, x), an outer index q' = (m, J, g0, y, c', j') and an inner
-- index q = (n, J', g', z, c, i) at (J, y), u is read at the concatenated
-- index (m+1+n, J', g0 . g', z, catA (rCh c') c, Wf (j'|g') i).
--   Pm   the point of tau at the concatenated index is the point of tau at
--        y at q: the total maps (g0 g', tmap (catA (rCh c') c)) and
--        (g0, tmap c') . (g', tmap c) agree (tmap-eq, tot-cat, vcomp-eq,
--        assoc, Tau.TNat for rCh), then G.act-o
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Ar = Arith[a] ;

module L16d (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (Wf : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J) {
 module LB = CTotL14b[a, vl, l].L14b[C, G, A] ;
 module D = LB.D ;
 module DO = LB.TA.DO ;
 module DA = LB.DA ;
 module VT = LB.VT ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 module Inner (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) (t : Hom I PFO.ivO)
  (q' : DA.Idx I x) (l' : DA.LandsI I x q') (q : DA.Idx q'.2.1 q'.2.2.2.1) (li : DA.LandsI q'.2.1 q'.2.2.2.1 q) {
  m : Nat = q'.1 ;
  J : Ob = q'.2.1 ;
  g0 : Hom q'.2.1 I = q'.2.2.1 ;
  y : Obj q'.2.1 = q'.2.2.2.1 ;
  c' : DO.KJ[q'.2.1].K.Ch q'.1 (C.res q'.2.1 I q'.2.2.1 x) q'.2.2.2.1 = q'.2.2.2.2.1 ;
  jP : Wt.Pn q'.1 q'.2.1 = (q'.2.2.2.2.2, l') ;
  gmy : W0.Ix (G.ob q'.2.1 q'.2.2.2.1) = (D.tau I x g).1 q' l' ;
  n : Nat = q.1 ;
  J' : Ob = q.2.1 ;
  g' : Hom q.2.1 q'.2.1 = q.2.2.1 ;
  z : Obj q.2.1 = q.2.2.2.1 ;
  c : DO.KJ[q.2.1].K.Ch q.1 (C.res q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1) q.2.2.2.1 = q.2.2.2.2.1 ;
  iP : Wt.Pn q.1 q.2.1 = (q.2.2.2.2.2, li) ;
  gg : Hom q.2.1 I = compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1 ;
  X' : Obj q.2.1 = C.res q.2.1 I (compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1) x ;
  Y' : Obj q.2.1 = C.res q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1 ;
  module CA = CTotL16c[a, vl, l].CA[C, q.2.1] ;
  c2 : DO.KJ[q.2.1].K.Ch q'.1 X' Y' = DO.rCh q.2.1 q'.2.1 I q.2.2.1 q'.2.2.1 x q'.1 q'.2.2.2.1 q'.2.2.2.2.1 ;
  N : Nat = Ar.plus q'.1 (suc q.1) ;
  cc : DO.KJ[q.2.1].K.Ch (Ar.plus q'.1 (suc q.1)) X' q.2.2.2.1 = CA.catA q'.1 q.1 X' Y' q.2.2.2.1 c2 q.2.2.2.2.1 ;
  jr : Wt.Pn q'.1 q.2.1 = Wt.Res[q'.1, q.2.1, q'.2.1, q.2.2.1, (q'.2.2.2.2.2, l')].res ;
  w : Wt.Pn (Ar.plus q'.1 (suc q.1)) q.2.1 = Wf q'.1 q.1 q.2.1 (PB.compH q.2.1 I PFO.ivO t gg) jr iP ;
  idx : DA.Idx I x = (Ar.plus q'.1 (suc q.1), q.2.1, gg, q.2.2.2.1, cc, w.1) ;
  ldx : DA.LandsI I x idx = w.2 ;
  tc : VT.VMap q.2.1 q.2.2.2.1 Y' = DO.KJ[q.2.1].K.tot q.1 Y' q.2.2.2.1 q.2.2.2.2.1 ;
  t2 : VT.VMap q.2.1 Y' X' = DO.KJ[q.2.1].K.tot q'.1 X' Y' c2 ;
  module TN = D.Tau[I, x, g].TNat[q'.1, q'.2.1, q'.2.2.1, q'.2.2.2.1, q'.2.2.2.2.1, q.2.1, q.2.2.1] ;
  s1 : Id (VT.TH q.2.1 q.2.2.2.1 I x) (gg, D.tmap I x (Ar.plus q'.1 (suc q.1)) q.2.1 gg q.2.2.2.1 cc) (compH q.2.1 q.2.1 I gg (idH q.2.1), C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (DO.KJ[q.2.1].K.tot (Ar.plus q'.1 (suc q.1)) X' q.2.2.2.1 cc)) =
   D.tmap-eq I x (Ar.plus q'.1 (suc q.1)) q.2.1 gg q.2.2.2.1 cc ;
  s2 : Id (VT.TH q.2.1 q.2.2.2.1 I x) (compH q.2.1 q.2.1 I gg (idH q.2.1), C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (DO.KJ[q.2.1].K.tot (Ar.plus q'.1 (suc q.1)) X' q.2.2.2.1 cc)) (compH q.2.1 q.2.1 I gg (idH q.2.1), C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (VT.vcomp q.2.1 q.2.2.2.1 Y' X' t2 tc)) =
   VT.pairL q.2.1 I (compH q.2.1 q.2.1 I gg (idH q.2.1)) q.2.2.2.1 x (C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (DO.KJ[q.2.1].K.tot (Ar.plus q'.1 (suc q.1)) X' q.2.2.2.1 cc)) (C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (VT.vcomp q.2.1 q.2.2.2.1 Y' X' t2 tc))
    (apH {VT.VMap q.2.1 q.2.2.2.1 X'} {VT.HomD q.2.1 I (compH q.2.1 q.2.1 I gg (idH q.2.1)) q.2.2.2.1 x} (\ v -> C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) v) (CA.tot-cat q'.1 q.1 X' Y' q.2.2.2.1 c2 q.2.2.2.2.1)) ;
  s3 : Id (VT.TH q.2.1 q.2.2.2.1 I x) (compH q.2.1 q.2.1 I gg (idH q.2.1), C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (VT.vcomp q.2.1 q.2.2.2.1 Y' X' t2 tc)) (compH q.2.1 q.2.1 I gg (compH q.2.1 q.2.1 q.2.1 (idH q.2.1) (idH q.2.1)), C.compD q.2.1 q.2.1 I gg (compH q.2.1 q.2.1 q.2.1 (idH q.2.1) (idH q.2.1)) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (C.compD q.2.1 q.2.1 q.2.1 (idH q.2.1) (idH q.2.1) q.2.2.2.1 Y' X' t2 tc)) =
   VT.cmpL q.2.1 q.2.1 I gg q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (idH q.2.1, VT.vcomp q.2.1 q.2.2.2.1 Y' X' t2 tc) (compH q.2.1 q.2.1 q.2.1 (idH q.2.1) (idH q.2.1), C.compD q.2.1 q.2.1 q.2.1 (idH q.2.1) (idH q.2.1) q.2.2.2.1 Y' X' t2 tc) (VT.vcomp-eq q.2.1 q.2.2.2.1 Y' X' t2 tc) ;
  s4 : Id (VT.TH q.2.1 q.2.2.2.1 I x) (compH q.2.1 q.2.1 I gg (compH q.2.1 q.2.1 q.2.1 (idH q.2.1) (idH q.2.1)), C.compD q.2.1 q.2.1 I gg (compH q.2.1 q.2.1 q.2.1 (idH q.2.1) (idH q.2.1)) q.2.2.2.1 X' x (C.cart q.2.1 I gg x) (C.compD q.2.1 q.2.1 q.2.1 (idH q.2.1) (idH q.2.1) q.2.2.2.1 Y' X' t2 tc)) (compH q.2.1 q.2.1 I (compH q.2.1 q.2.1 I gg (idH q.2.1)) (idH q.2.1), C.compD q.2.1 q.2.1 I (compH q.2.1 q.2.1 I gg (idH q.2.1)) (idH q.2.1) q.2.2.2.1 Y' x (C.compD q.2.1 q.2.1 I gg (idH q.2.1) Y' X' x (C.cart q.2.1 I gg x) t2) tc) =
   symH (C.assoc q.2.1 q.2.1 q.2.1 I gg (idH q.2.1) (idH q.2.1) q.2.2.2.1 Y' X' x (C.cart q.2.1 I gg x) t2 tc) ;
  s5 : Id (VT.TH q.2.1 q.2.2.2.1 I x) (compH q.2.1 q.2.1 I (compH q.2.1 q.2.1 I gg (idH q.2.1)) (idH q.2.1), C.compD q.2.1 q.2.1 I (compH q.2.1 q.2.1 I gg (idH q.2.1)) (idH q.2.1) q.2.2.2.1 Y' x (C.compD q.2.1 q.2.1 I gg (idH q.2.1) Y' X' x (C.cart q.2.1 I gg x) t2) tc) (compH q.2.1 q.2.1 I gg (idH q.2.1), C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 Y' x (D.tmap I x q'.1 q.2.1 gg Y' c2) tc) =
   VT.cmpR q.2.1 q.2.1 I (idH q.2.1) q.2.2.2.1 Y' x tc (compH q.2.1 q.2.1 I gg (idH q.2.1), C.compD q.2.1 q.2.1 I gg (idH q.2.1) Y' X' x (C.cart q.2.1 I gg x) t2) (gg, D.tmap I x q'.1 q.2.1 gg Y' c2) (symH (D.tmap-eq I x q'.1 q.2.1 gg Y' c2)) ;
  s6 : Id (VT.TH q.2.1 q.2.2.2.1 I x) (compH q.2.1 q.2.1 I gg (idH q.2.1), C.compD q.2.1 q.2.1 I gg (idH q.2.1) q.2.2.2.1 Y' x (D.tmap I x q'.1 q.2.1 gg Y' c2) tc) (compH q.2.1 q.2.1 I (compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1) (idH q.2.1), C.compD q.2.1 q.2.1 I (compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1) (idH q.2.1) q.2.2.2.1 Y' x (C.compD q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1 Y' q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (C.cart q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1)) tc) =
   VT.cmpR q.2.1 q.2.1 I (idH q.2.1) q.2.2.2.1 Y' x tc (gg, D.tmap I x q'.1 q.2.1 gg Y' c2) (compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1, C.compD q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1 Y' q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (C.cart q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1)) (symH TN.law) ;
  s7 : Id (VT.TH q.2.1 q.2.2.2.1 I x) (compH q.2.1 q.2.1 I (compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1) (idH q.2.1), C.compD q.2.1 q.2.1 I (compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1) (idH q.2.1) q.2.2.2.1 Y' x (C.compD q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1 Y' q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (C.cart q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1)) tc) (compH q.2.1 q'.2.1 I q'.2.2.1 (compH q.2.1 q.2.1 q'.2.1 q.2.2.1 (idH q.2.1)), C.compD q.2.1 q'.2.1 I q'.2.2.1 (compH q.2.1 q.2.1 q'.2.1 q.2.2.1 (idH q.2.1)) q.2.2.2.1 q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (C.compD q.2.1 q.2.1 q'.2.1 q.2.2.1 (idH q.2.1) q.2.2.2.1 Y' q'.2.2.2.1 (C.cart q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1) tc)) =
   C.assoc q.2.1 q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1 (idH q.2.1) q.2.2.2.1 Y' q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (C.cart q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1) tc ;
  s8 : Id (VT.TH q.2.1 q.2.2.2.1 I x) (compH q.2.1 q'.2.1 I q'.2.2.1 (compH q.2.1 q.2.1 q'.2.1 q.2.2.1 (idH q.2.1)), C.compD q.2.1 q'.2.1 I q'.2.2.1 (compH q.2.1 q.2.1 q'.2.1 q.2.2.1 (idH q.2.1)) q.2.2.2.1 q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (C.compD q.2.1 q.2.1 q'.2.1 q.2.2.1 (idH q.2.1) q.2.2.2.1 Y' q'.2.2.2.1 (C.cart q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1) tc)) (compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1, C.compD q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1 q.2.2.2.1 q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (D.tmap q'.2.1 q'.2.2.2.1 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1)) =
   VT.cmpL q.2.1 q'.2.1 I q'.2.2.1 q.2.2.2.1 q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (compH q.2.1 q.2.1 q'.2.1 q.2.2.1 (idH q.2.1), C.compD q.2.1 q.2.1 q'.2.1 q.2.2.1 (idH q.2.1) q.2.2.2.1 Y' q'.2.2.2.1 (C.cart q.2.1 q'.2.1 q.2.2.1 q'.2.2.2.1) tc) (q.2.2.1, D.tmap q'.2.1 q'.2.2.2.1 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) (symH (D.tmap-eq q'.2.1 q'.2.2.2.1 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1)) ;
  TM : Id (VT.TH q.2.1 q.2.2.2.1 I x) (gg, D.tmap I x (Ar.plus q'.1 (suc q.1)) q.2.1 gg q.2.2.2.1 cc) (compH q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1, C.compD q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1 q.2.2.2.1 q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (D.tmap q'.2.1 q'.2.2.2.1 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1)) =
   transH s1 (transH s2 (transH s3 (transH s4 (transH s5 (transH s6 (transH s7 s8)))))) ;
  Pm : Id (W0.Ix (G.ob q.2.1 q.2.2.2.1)) ((D.tau I x g).1 idx ldx) ((D.tau q'.2.1 q'.2.2.2.1 gmy).1 q li) =
   transH (apH {VT.TH q.2.1 q.2.2.2.1 I x} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ h -> D.actT I x q.2.1 q.2.2.2.1 h g) TM)
    (G.act-o q.2.1 q'.2.1 I q'.2.2.1 q.2.2.1 q.2.2.2.1 q'.2.2.2.1 x (D.tmap I x q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) (D.tmap q'.2.1 q'.2.2.2.1 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) g) ;
  -- the value, and its reading in E_z
  val : W0.Ix (A.tob (q.2.1, q.2.2.2.1) ((D.tau q'.2.1 q'.2.2.2.1 gmy).1 q li)) =
   DA.coeT q.2.1 q.2.2.2.1 ((D.tau I x g).1 idx ldx) ((D.tau q'.2.1 q'.2.2.2.1 gmy).1 q li) Pm (u.1 idx ldx) ;
  pc : Id (DA.Ez q.2.1 q.2.2.2.1) (DA.prz q.2.1 q.2.2.2.1 ((D.tau q'.2.1 q'.2.2.2.1 gmy).1 q li) val) (DA.prz q.2.1 q.2.2.2.1 ((D.tau I x g).1 idx ldx) (u.1 idx ldx)) =
   symH (DA.pr-coe q.2.1 q.2.2.2.1 ((D.tau I x g).1 idx ldx) ((D.tau q'.2.1 q'.2.2.2.1 gmy).1 q li) Pm (u.1 idx ldx)) ;
 } ;
} ;
