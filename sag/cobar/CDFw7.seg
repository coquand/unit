-- CDFw7.seg (canonicity-c2; (d)(1), part 7): fwd : HomT(x.u, y) -> T0 =
-- Sigma (h : HomT(x, y)). Sol_h(u) (CSolT): z |-> (z . p_u, (z at the new
-- generators, the equations of u)), the equations by recursion on u's list.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module Fw7 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F6m = CDFw6[a].Fw6[R, encK, pe, x, u, y] ;
 module F1 = F6m.F1 ;
 module S2 = F1.S2 ;
 module S1 = F1.S1 ;
 module Dc = F6m.Dc ;
 open Ring[a] ;
 Nl : C.Ctx = C.nil ;
 D1 : C.Ctx = F1.D1 ;
 Dv : C.Ctx = S1.Dv ;
 Gh : C.Ctx = S1.Gh ;
 sg1 : C.Sub D1 Gh = F1.sg1 ;
 sg2 : C.Sub D1 Dv = F1.sg2 ;
 Tm : U a = F6m.Tm ;
 HU : C.Ty Nl = F1.HU ;
 HXY : C.Ty Nl = S1.HXY ;
 -- the unit
 ue : C.El Nl S1.UnitT = CConstLam[a, a+].LamC[CCyl[a].PosCyl.posCyl, V1.unitV].cE Nl tt ;
 unitEl : C.El D1 (C.subT D1 Dv S2.UnitD sg2) = C.subt D1 Dv S2.UnitD (C.subt Dv Nl S1.UnitT ue (C.eps Dv)) sg2 ;
 -- the equations
 PR (A : C.Ty Dv) (B : C.Ty Dv) (e : C.El D1 (C.subT D1 Dv A sg2))
   : Id (C.Ty D1) (C.subT D1 Dv B sg2) (C.subT D1 (C.ext D1 (C.subT D1 Dv A sg2)) (C.subT (C.ext D1 (C.subT D1 Dv A sg2)) (C.ext Dv A) (OV.wkT Dv A B) (C.lift D1 Dv A sg2)) (C.sec D1 (C.subT D1 Dv A sg2) e)) =
  transH (apH {C.Sub D1 Dv} {C.Ty D1} (\ s -> C.subT D1 Dv B s)
           (L.sub-ext D1 Dv sg2 (C.o D1 (C.ext D1 (C.subT D1 Dv A sg2)) Dv (C.o (C.ext D1 (C.subT D1 Dv A sg2)) (C.ext Dv A) Dv (C.p Dv A) (C.lift D1 Dv A sg2)) (C.sec D1 (C.subT D1 Dv A sg2) e))
              (\ K w -> refl (sg2.nt K w))))
   (transH (C.subT-o D1 (C.ext D1 (C.subT D1 Dv A sg2)) Dv B (C.o (C.ext D1 (C.subT D1 Dv A sg2)) (C.ext Dv A) Dv (C.p Dv A) (C.lift D1 Dv A sg2)) (C.sec D1 (C.subT D1 Dv A sg2) e))
     (apH {C.Ty (C.ext D1 (C.subT D1 Dv A sg2))} {C.Ty D1} (\ T -> C.subT D1 (C.ext D1 (C.subT D1 Dv A sg2)) T (C.sec D1 (C.subT D1 Dv A sg2) e))
        (C.subT-o (C.ext D1 (C.subT D1 Dv A sg2)) (C.ext Dv A) Dv B (C.p Dv A) (C.lift D1 Dv A sg2)))) ;
 relEl : (qs : SX.Over[R].Equations (F6m.F5m.F2m.Fk F1.m)) -> ((p : Tm) -> Dc.Member p qs -> Dc.Member p u.2) -> C.El D1 (C.subT D1 Dv (S2.RelProd qs) sg2) = split {
  nil -> \ inj -> unitEl ;
  cons p ps | r -> \ inj ->
   OV.trE D1 (SS.Sig D1 (C.subT D1 Dv (S2.IdEv p) sg2) (C.subT (C.ext D1 (C.subT D1 Dv (S2.IdEv p) sg2)) (C.ext Dv (S2.IdEv p)) (OV.wkT Dv (S2.IdEv p) (S2.RelProd ps)) (C.lift D1 Dv (S2.IdEv p) sg2)))
    (C.subT D1 Dv (S2.RelProd (cons p ps)) sg2) (symH (FibCwF[a, a+].fibSig.Sig-nat D1 Dv (S2.IdEv p) (OV.wkT Dv (S2.IdEv p) (S2.RelProd ps)) sg2))
    (INm.pr D1 (C.subT D1 Dv (S2.IdEv p) sg2) (C.subT (C.ext D1 (C.subT D1 Dv (S2.IdEv p) sg2)) (C.ext Dv (S2.IdEv p)) (OV.wkT Dv (S2.IdEv p) (S2.RelProd ps)) (C.lift D1 Dv (S2.IdEv p) sg2))
      (F6m.eqP p (inj p (inl (refl p))))
      (OV.trE D1 (C.subT D1 Dv (S2.RelProd ps) sg2) (C.subT D1 (C.ext D1 (C.subT D1 Dv (S2.IdEv p) sg2)) (C.subT (C.ext D1 (C.subT D1 Dv (S2.IdEv p) sg2)) (C.ext Dv (S2.IdEv p)) (OV.wkT Dv (S2.IdEv p) (S2.RelProd ps)) (C.lift D1 Dv (S2.IdEv p) sg2)) (C.sec D1 (C.subT D1 Dv (S2.IdEv p) sg2) (F6m.eqP p (inj p (inl (refl p))))))
        (PR (S2.IdEv p) (S2.RelProd ps) (F6m.eqP p (inj p (inl (refl p)))))
        (r (\ q mq -> inj q (inr mq))))) } ;
} ;
