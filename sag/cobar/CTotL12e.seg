-- CTotL12e.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part e: piece 0 at the identity.
--   NCg    NC with the tail of the restricted chain moved along a path
--   idv    piece 0 at an index (n, J, U, z, cc, i), at the identity of
--          (J, z), is the side at cart U x read at the identity index of cc
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module L12e (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LD = CTotL12d[a, vl, l].L12d[C, G, A] ;
 module LC = LD.LC ;
 module LB = LC.LB ;
 module LA = LC.LA ;
 module CL = LC.CL ;
 module TR = LA.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LB.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;

 module Fe (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FD = LD.Fd[X, gm, s] ;
  module FC = FD.FC ;
  module FB = FC.FB ;
  module F = FC.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  NCg (n : Nat) (W1 : Ob) (y : Obj W1) (U0 : Hom W1 I) (cc : CT.Ch W1 n (C.res W1 I U0 x) y) (lU : PB.Lands W1 I s.pQ U0) (R : Wt.Pn n W1)
   (W2 : Ob) (w : Hom W2 W1) (lU' : PB.Lands W2 I s.pQ (compH W2 W1 I U0 w)) (y2 : Obj W2) (e2 : Id (Obj W2) (C.res W2 W1 w y) y2)
   : Id (DA.Ez W2 y2)
       (DA.E.act (W2, y2) (W1, y) (w, VT.trD W2 W1 w (C.res W2 W1 w y) y2 e2 y (C.cart W2 W1 w y)) (FB.rdC n W1 y U0 cc lU R))
       (FB.rdC n W2 y2 (compH W2 W1 I U0 w)
          (subst (Obj W2) (\ t -> CT.Ch W2 n (C.res W2 I (compH W2 W1 I U0 w) x) t) (C.res W2 W1 w y) y2 e2 (DO.rCh W2 W1 I w U0 x n y cc))
          lU' (Wt.Res[n, W2, W1, w, R].res)) =
   idJ (Obj W2) (C.res W2 W1 w y)
    (\ y3 e3 -> Id (DA.Ez W2 y3)
       (DA.E.act (W2, y3) (W1, y) (w, VT.trD W2 W1 w (C.res W2 W1 w y) y3 e3 y (C.cart W2 W1 w y)) (FB.rdC n W1 y U0 cc lU R))
       (FB.rdC n W2 y3 (compH W2 W1 I U0 w)
          (subst (Obj W2) (\ t -> CT.Ch W2 n (C.res W2 I (compH W2 W1 I U0 w) x) t) (C.res W2 W1 w y) y3 e3 (DO.rCh W2 W1 I w U0 x n y cc))
          lU' (Wt.Res[n, W2, W1, w, R].res)))
    FB.NC[n, W1, y, U0, cc, lU, R, W2, w, lU'].nat y2 e2 ;

  module IdV (n : Nat) (J : Ob) (U0 : Hom J I) (z : Obj J) (cc : CT.Ch J n (C.res J I U0 x) z) (lU : PB.Lands J I s.pQ U0) (i : Wt.Pn n J)
    (e : Id (Obj J) (C.res J J (idH J) z) z) (li : PB.Lands J J (PB.pre J I U0 s.pQ) (idH J)) {
   module Q = FC.Q0[n, J, U0, z, cc, i] ;
   Y : Ob0 = (J, z) ;
   v0 : DA.Ez J z = FB.rdC n J z U0 cc lU i ;
   km (e' : Id (Obj J) (C.res J J (idH J) z) z) : TC.THm Y Y = (idH J, VT.trD J J (idH J) (C.res J J (idH J) z) z e' z (C.cart J J (idH J) z)) ;
   kid : Id (TC.THm Y Y) (km e) (TC.tid Y) =
    transH (apH {Id (Obj J) (C.res J J (idH J) z) z} {TC.THm Y Y} km
              (CT.setObj J (C.res J J (idH J) z) z e (symH (G0.GB.BC.idC Y).2)))
     (TR.fn.onId Y) ;
   a1 : Id (DA.Ez J z) (DA.E.act Y Y (km e) v0) (Q.vg J (idH J) z e li) =
    transH (NCg n J z U0 cc lU i J (idH J) (PB.lands-pre J J I U0 s.pQ (idH J) li) z e)
     (apH {Wt.Pn n J} {DA.Ez J z} (\ r -> FB.rdC n J z (compH J J I U0 (idH J)) (Q.cT J (idH J) z e) (PB.lands-pre J J I U0 s.pQ (idH J) li) r)
        (refl (Wt.Res[n, J, J, idH J, i].res))) ;
   a2 : Id (DA.Ez J z) (DA.E.act Y Y (km e) v0) v0 =
    transH (apH {TC.THm Y Y} {DA.Ez J z} (\ k -> DA.E.act Y Y k v0) kid) (DA.E.act-id Y v0) ;
   idv : Id (DA.Ez J z) (Q.vg J (idH J) z e li) v0 = transH (symH a1) a2 ;
  } ;

  -- a slice path between pairs with the same base map: the chains agree
  sGen (I1 : Ob) (x1 : Obj I1) (n : Nat) (J : Ob) (z : Obj J) (u : Hom J I1) (c : CT.Ch J n (C.res J I1 u x1) z)
   (w : LA.DO.DC[G].S I1 x1 n J z) (P : Id (D.S I1 x1 n J z) (u, c) w)
   : Id (CT.Ch J n (C.res J I1 w.1 x1) z)
       (CT.trCh J n (C.res J I1 u x1) (C.res J I1 w.1 x1)
          (apH {Hom J I1} {Obj J} (\ k -> C.res J I1 k x1) (apH {D.S I1 x1 n J z} {Hom J I1} (\ w' -> w'.1) P)) z c) w.2 =
   idJ (D.S I1 x1 n J z) (u, c)
    (\ w2 P2 -> Id (CT.Ch J n (C.res J I1 w2.1 x1) z)
       (CT.trCh J n (C.res J I1 u x1) (C.res J I1 w2.1 x1)
          (apH {Hom J I1} {Obj J} (\ k -> C.res J I1 k x1) (apH {D.S I1 x1 n J z} {Hom J I1} (\ w' -> w'.1) P2)) z c) w2.2)
    (refl c) w P ;
  sSnd (I1 : Ob) (x1 : Obj I1) (n : Nat) (J : Ob) (z : Obj J) (u : Hom J I1) (c c2 : CT.Ch J n (C.res J I1 u x1) z)
   (P : Id (D.S I1 x1 n J z) (u, c) (u, c2)) : Id (CT.Ch J n (C.res J I1 u x1) z) c c2 =
   transH (symH (CT.trCh-refl J n (C.res J I1 u x1)
                   (apH {Hom J I1} {Obj J} (\ k -> C.res J I1 k x1) (apH {D.S I1 x1 n J z} {Hom J I1} (\ w' -> w'.1) P)) z c))
    (sGen I1 x1 n J z u c (u, c2) P) ;

  -- the side at cart U x, read at the identity index of the moved chain,
  -- is the side at f read at the index itself
  module Ext (W : TC.TOb) (f : TC.THm W X) (lf : G1.GB.Lands W X s.pQ f) (n : Nat) (J : Ob) (u' : Hom J W.1) (z : Obj J)
    (c' : CT.Ch J n (C.res J W.1 u' W.2) z) (i : Wt.Pn n J) {
   W1 : Ob = W.1 ;
   yW : Obj W1 = W.2 ;
   U0 : Hom J I = compH J W1 I f.1 u' ;
   g0 : VT.VMap W1 yW (C.res W1 I f.1 x) = VT.vpart W1 I f.1 yW x f.2 ;
   cc : CT.Ch J n (C.res J I U0 x) z = CT.rxM J W1 I u' f.1 yW x g0 n z c' ;
   lU : PB.Lands J I s.pQ U0 = PB.lands-comp J W1 I s.pQ f.1 u' lf ;
   yj : Obj J = C.res J W1 u' yW ;
   Wj : TC.TOb = (J, yj) ;
   k1 : TC.THm Wj W = TC.cartT J W u' ;
   fk : TC.THm Wj X = TC.tcomp Wj W X f k1 ;
   module FA = TR.DS.Fact[X, Wj, fk] ;
   module RU = FB.RC[n, J, z, U0, cc, lU, i] ;
   XU : TC.TOb = RU.Xv ;
   X' : Obj J = RU.ry ;
   vp : TC.THm Wj XU = FA.vp ;
   tf : LA.P.SigT LA.DG DA.DTy W = F.sv W f lf ;
   lUi : PB.Lands J I s.pQ (compH J J I U0 (idH J)) = PB.lands-eq J I s.pQ U0 (compH J J I U0 (idH J)) (symH (comp-idr J I U0)) lU ;
   P1 : Id (LA.P.SigT LA.DG DA.DTy Wj) (LB.EE.act Wj XU vp RU.t) (LB.EE.act Wj W k1 tf) =
    transH (s.pnat Wj XU vp RU.f lU lUi)
     (transH (LA.PD.pv-hom X gm s Wj (TC.tcomp Wj XU X RU.f vp) fk FA.vp-eq lUi lU)
        (symH (s.pnat Wj W k1 f lf lU))) ;
   module CW = CL.Cart[J, W1, u', yW, n, z, c'] ;
   q0j : DO.Idx J yj = (n, J, idH J, z, CW.ch, i.1) ;
   cwP : Id (D.S W1 yW n J z) (compH J J W1 u' (idH J), CT.rxM J J W1 (idH J) u' yj yW CW.g0 n z CW.ch) (u', c') =
    D.sEq W1 yW n J z (compH J J W1 u' (idH J)) u' (comp-idr J W1 u') (CT.rxM J J W1 (idH J) u' yj yW CW.g0 n z CW.ch) c' CW.law ;
   r1 : Id (DA.Ez J z) (LB.rdT Wj (LB.EE.act Wj W k1 tf) q0j i.2) (F.rd W f lf (n, J, u', z, c', i.1) i.2) =
    transH (LB.actRd Wj W k1 tf q0j i.2)
     (apH {D.S W1 yW n J z} {DA.Ez J z} (\ sw -> DA.rdP W1 yW tf.1 tf.2.1 n J z i.1 sw i.2) cwP) ;
   -- the two indices of the stage XU
   v1 : Hom J J = compH J J J (idH J) (idH J) ;
   ch1 : CT.Ch J n (C.res J J v1 X') z = CT.rxM J J J (idH J) (idH J) yj X' (VT.vpart J J (idH J) yj X' vp.2) n z CW.ch ;
   pv1 : Id (Hom J J) v1 (idH J) = comp-idl J J (idH J) ;
   ch1' : CT.Ch J n (C.res J J (idH J) X') z =
    CT.trCh J n (C.res J J v1 X') (C.res J J (idH J) X') (apH {Hom J J} {Obj J} (\ k -> C.res J J k X') pv1) z ch1 ;
   eA : Id (D.S J X' n J z) (v1, ch1) (idH J, ch1') = D.sEq J X' n J z v1 (idH J) pv1 ch1 ch1' (refl ch1') ;
   rqU (sw : D.S J X' n J z) : D.S I x n J z = (compH J J I U0 sw.1, CT.rxM J J I sw.1 U0 X' x RU.CA.g0 n z sw.2) ;
   rqT (k : TC.THm Wj X) : D.S I x n J z = (compH J J I k.1 (idH J), CT.rxM J J I (idH J) k.1 yj x (VT.vpart J I k.1 yj x k.2) n z CW.ch) ;
   rqF (sw : D.S W1 yW n J z) : D.S I x n J z = (compH J W1 I f.1 sw.1, CT.rxM J W1 I sw.1 f.1 yW x g0 n z sw.2) ;
   iA : Id (D.S I x n J z) (rqU (v1, ch1)) (U0, cc) =
    transH (D.oPath J J I U0 (idH J) yj X' x (C.cart J I U0 x) vp.2 q0j)
     (transH (apH {TC.THm Wj X} {D.S I x n J z} rqT FA.vp-eq)
       (transH (symH (D.oPath J W1 I f.1 u' yj yW x f.2 (C.cart J W1 u' yW) q0j))
         (apH {D.S W1 yW n J z} {D.S I x n J z} rqF cwP))) ;
   iB : Id (D.S I x n J z) (rqU (idH J, RU.CA.ch)) (U0, cc) =
    D.sEq I x n J z (compH J J I U0 (idH J)) U0 (comp-idr J I U0) (CT.rxM J J I (idH J) U0 X' x RU.CA.g0 n z RU.CA.ch) cc RU.CA.law ;
   pAB : Id (D.S I x n J z) (rqU (idH J, ch1')) (rqU (idH J, RU.CA.ch)) =
    transH (symH (apH {D.S J X' n J z} {D.S I x n J z} rqU eA)) (transH iA (symH iB)) ;
   eCh : Id (CT.Ch J n (C.res J J (idH J) X') z) ch1' RU.CA.ch =
    RU.CA.phi-inj ch1' RU.CA.ch
     (sSnd I x n J z (compH J J I U0 (idH J)) (CT.rxM J J I (idH J) U0 X' x RU.CA.g0 n z ch1') (CT.rxM J J I (idH J) U0 X' x RU.CA.g0 n z RU.CA.ch) pAB) ;
   eAB : Id (D.S J X' n J z) (v1, ch1) (idH J, RU.CA.ch) =
    transH eA (apH {CT.Ch J n (C.res J J (idH J) X') z} {D.S J X' n J z} (\ w -> (idH J, w)) eCh) ;
   l1 : Id (DA.Ez J z) (LB.rdT Wj (LB.EE.act Wj XU vp RU.t) q0j i.2) RU.val =
    transH (LB.actRd Wj XU vp RU.t q0j i.2)
     (apH {D.S J X' n J z} {DA.Ez J z} (\ sw -> DA.rdP J X' RU.t.1 RU.t.2.1 n J z i.1 sw i.2) eAB) ;
   ext : Id (DA.Ez J z) (FB.rdC n J z U0 cc lU i) (F.rd W f lf (n, J, u', z, c', i.1) i.2) =
    transH (symH l1)
     (transH (apH {LA.P.SigT LA.DG DA.DTy Wj} {DA.Ez J z} (\ tt -> LB.rdT Wj tt q0j i.2) P1) r1) ;
  } ;
 } ;
} ;
