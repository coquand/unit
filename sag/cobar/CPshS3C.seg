-- CPshS3C.seg (canonicity-c2; COBAR.md, the S3 bridge, part (III), P3):
-- the S3 bridge in the CwF of uniformly fibrant C-types.  For X , Y
-- fibrant over G and r : Y -> X, with al the map of r (CPshFvC):
--   S3b  an element of Kr r (contractible fibres, internally) gives a
--        uniform ContrOp of the homotopy fibre of al over G.X, i.e. an
--        EquivOp of al at each x, commuting with the C-action
--        (Prop13U's shape);
--   S3a  conversely.
-- Kr r is Pi x isContr (FVr); bod / lam pass to G.X, CPshContrC passes
-- between isContr and uniform ContrOps, CPshFvC2.fvEq between FVr and
-- the raw fibre FVc, and CPshFibC (utHP, SA.utFV) between FVc and the
-- homotopy fibre.
-- Premises: those of the files used (fe, univ).  No new axioms.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module S3COf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module FvM = CPshFvC[a, l].FvCOf[C] ;
 module Fv2 = CPshFvC2[a, l].FvC2Of[C] ;
 module CC = CPshContrC[a, l].ContrCOf[C] ;
 CF : CwF.CwF[l+] = UF.CFibCwF ;

 module S3 (G : P.CCtx) (X Y : UF.FCC.STy G) (r : CF.El G (FvM.OV.Fun G Y X)) {
  module F2 = Fv2.Fv[G, X, Y, r] ;
  module F1 = FvM.Fv[G, X, Y, r] ;
  Dc : P.CCtx = F1.Fb.Dc ;
  FVrS : UF.FCC.STy Dc = FvM.QP.FVr G X Y r ;

  module B (k : CF.El G (FvM.QP.Kr G X Y r)) {
   kx : CF.El Dc (CC.EQ.isContr Dc FVrS) = FvM.OV.bod G X (CC.EQ.isContr Dc FVrS) k ;
   u1 : P.UTriv Dc FVrS.1 = CC.toUT Dc FVrS kx ;
   u2 : P.UTriv Dc F1.Fb.FVc = substH {P.CTy[Dc]} (\ T -> P.UTriv Dc T) F2.fvEq u1 ;
   ut : P.UTriv Dc F1.Fb.HPc.PC = F1.Fb.utHP u2 ;
  } ;
  S3b (k : CF.El G (FvM.QP.Kr G X Y r)) : P.UTriv Dc F1.Fb.HPc.PC = B[k].ut ;

  module A (ut : P.UTriv Dc F1.Fb.HPc.PC) {
   v1 : P.UTriv Dc F1.Fb.FVc = F1.Fb.SA[ut].utFV ;
   v2 : P.UTriv Dc FVrS.1 = substH {P.CTy[Dc]} (\ T -> P.UTriv Dc T) (symH F2.fvEq) v1 ;
   kx : CF.El Dc (CC.EQ.isContr Dc FVrS) = CC.fromUT Dc FVrS v2 ;
   k : CF.El G (FvM.QP.Kr G X Y r) = FvM.OV.lam G X (CC.EQ.isContr Dc FVrS) kx ;
  } ;
  S3a (ut : P.UTriv Dc F1.Fb.HPc.PC) : CF.El G (FvM.QP.Kr G X Y r) = A[ut].k ;
 } ;
} ;
