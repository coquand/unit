-- CL59o.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part o: inv . ev ~ id at the total site, first leg.  Over Om
-- (CL59l) with E: M1(phi, e) = ev''(inv (ev phi), e) and N2 = ev''; the
-- value of M1 is the composite of CL59e at (tau psi, (D rho)^-1 (tau e))
-- (apW-E'), which by D-functoriality (CL59n.CA) is the composite over Om at
-- (tau phi, D rho (D rho)^-1 (tau e)); the path of D rho's quasi-inverse
-- (f g ~ id, CL59h) goes to Psi2(phi, e) = that composite at (tau phi, tau e).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module H2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module JD = CL59j[a].H1[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module PLd = CL59n[a].PL[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module OL = PLd.OL ;
  module CM2 = PLd.CM2 ;
  module DA0 = JD.DA0 ;
  module HO1 = G1.GB.CHtpyOps[a+] ;
  module PS1 = G1.GB.GPre[a+].PS ;
  N2 : HO1.NMap[OL.POm, OL.Ew, OL.Qw] = G1.FT.GEqQinv[a+].PN[OL.POm, OL.Ew, OL.Qw, OL.ev''].nm ;
  module Hyp (ef : TR.G0.GB.CEquiv[a+].EquivOp JD.RM.PD.UG JD.RM.PD.UA JD.RM.PD.UB JD.RM.PD.Uf)
   (mQ : G1.GB.CEquiv[a+].EquivOp CT.P1 Q.1 JD.IVd.B2Q JD.IVd.C15Q.tauM) {
   module J1 = JD.Hyp[ef, mQ] ;
   module HI = J1.HI ;
   module DW = CM2.Down[J1.HH.EQt.EI.gN] ;
   module CV2 = PLd.CV ;
   -- sigma = inv . ev on Om, and M1 = N2 . sigma
   sgm (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) : V1.Ix (OL.POm.ob X) = HI.PI[X.1, DA0.evV X.1 phi].elt ;
   sigN (Yy X : CT.TC.TOb) (h : CT.TC.THm Yy X) (phi : V1.Ix (OL.POm.ob X)) : Id (V1.Ix (OL.POm.ob Yy)) (OL.POm.act Yy X h (sgm X phi)) (sgm Yy (OL.POm.act Yy X h phi)) =
    (J1.HO0.compN LA.Nl DA0.PiC DA0.QC DA0.PiC J1.evNM J1.invNM).nnat Yy.1 X.1 h.1 tt tt (refl tt) phi ;
   eps0 (J I : CT.TC.TOb) (f : CT.TC.THm J I) (x : V1.Ix (OL.POm.ob I)) (x' : V1.Ix (OL.POm.ob J)) (ee : Id (V1.Ix (OL.POm.ob J)) (OL.POm.act J I f x) x')
    : Id (V1.Ix (G1.fibCwF-T.nil.ob J)) (G1.fibCwF-T.nil.act J I f tt) tt = PS1.ntEq OL.POm G1.fibCwF-T.nil (G1.fibCwF-T.eps OL.POm) J I f x x' ee ;
   sgE (J I : CT.TC.TOb) (f : CT.TC.THm J I) (x : V1.Ix (OL.POm.ob I)) (x' : V1.Ix (OL.POm.ob J)) (ee : Id (V1.Ix (OL.POm.ob J)) (OL.POm.act J I f x) x')
    : Id (V1.Ix (OL.POm.ob J)) (OL.POm.act J I f (sgm I x)) (sgm J x') = transH (sigN J I f x) (apH {V1.Ix (OL.POm.ob J)} {V1.Ix (OL.POm.ob J)} (sgm J) ee) ;
   M1 : HO1.NMap[OL.POm, OL.Ew, OL.Qw] =
    new HO1.NMap[OL.POm, OL.Ew, OL.Qw, \ X phi e -> N2.nfun X (sgm X phi) e,
     \ J I f x x' ee a0 -> transH (PS1.tact-irr G1.fibCwF-T.nil Q.1 J I f tt tt (eps0 J I f x x' ee) (eps0 J I f (sgm I x) (sgm J x') (sgE J I f x x' ee)) (N2.nfun I (sgm I x) a0))
       (N2.nnat J I f (sgm I x) (sgm J x') (sgE J I f x x' ee) a0)] ;
   Psi2V (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X)) : V1.Ix (Q.1.tob X tt) =
    DW.Gf2 X (CM2.DOm.tau X.1 X.2 phi) (CM2.DE.tau X.1 X.2 e) ;
   wTau (J I : CT.TC.TOb) (f : CT.TC.THm J I) (x : V1.Ix (OL.POm.ob I)) (x' : V1.Ix (OL.POm.ob J)) (ee : Id (V1.Ix (OL.POm.ob J)) (OL.POm.act J I f x) x')
    : Id (CM2.DOm.Ob' J.1 J.2) (CM2.DOm.act J.1 I.1 f.1 J.2 I.2 f.2 (CM2.DOm.tau I.1 I.2 x)) (CM2.DOm.tau J.1 J.2 x') =
    transH (symH (CM2.DOm.tau-nat J.1 I.1 f.1 J.2 I.2 f.2 x)) (apH {V1.Ix (OL.POm.ob J)} {CM2.DOm.Ob' J.1 J.2} (CM2.DOm.tau J.1 J.2) ee) ;
   Psi2N : HO1.NMap[OL.POm, OL.Ew, OL.Qw] =
    new HO1.NMap[OL.POm, OL.Ew, OL.Qw, \ X phi e -> Psi2V X phi e,
     \ J I f x x' ee a0 -> transH (DW.GN2[I, J, f, CM2.DOm.tau I.1 I.2 x, CM2.DE.tau I.1 I.2 a0].law (eps0 J I f x x' ee))
       (transH (apH {CM2.DOm.Ob' J.1 J.2} {V1.Ix (Q.1.tob J tt)} (\ w0 -> DW.Gf2 J w0 (CM2.DE.act J.1 I.1 f.1 J.2 I.2 f.2 (CM2.DE.tau I.1 I.2 a0))) (wTau J I f x x' ee))
         (apH {CM2.DE.Ob' J.1 J.2} {V1.Ix (Q.1.tob J tt)} (DW.Gf2 J (CM2.DOm.tau J.1 J.2 x')) (symH (CM2.DE.tau-nat J.1 I.1 f.1 J.2 I.2 f.2 a0))))] ;
   -- the value of M1: the composite of CL59e at ((D rho)^-1 (tau e))
   module TQw = G1.GB.GPre[a+].TyL[OL.POm, OL.Qw] ;
   module M1v (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X)) {
    s0 : V1.Ix (OL.POm.ob X) = sgm X phi ;
    I0 : CT.TC.TOb = (X.1, y) ;
    f0 : CT.TC.THm X I0 = OL.fy X e.1 ;
    pt0 : V1.Ix (LA.PYy.ob X) = LA.PYy.act X I0 f0 (DA0.idy X.1) ;
    v0 : V1.Ix (A.1.tob X pt0) = DA0.PE.bk X pt0 e.1 (OL.pEq X e.1) e.2 ;
    ppE : Id (PLd.TA.EI X) (PLd.TA.pr X pt0 v0) e = DA0.PE.pp X pt0 e.1 (OL.pEq X e.1) e.2 ;
    st2 : Id (V1.Ix (Q.1.tob X tt)) (OL.ev2 X s0 e) (s0.1 X f0 v0) =
     transH (symH (PLd.substC X e (PLd.TA.pr X pt0 v0) (symH ppE) (OL.ev2 X s0 e)))
      (PLd.TB.pr-eq X e (PLd.TA.pr X pt0 v0) (symH ppE) (OL.ev2 X s0 e) (s0.1 X f0 v0) (DA0.PE.apW-E' I0 (DA0.idy X.1) s0 X f0 e (OL.pEq X e.1))) ;
    module PNe = G1.FT.GEqQinv[a+].PN[OL.POm, OL.Ew, OL.Qw, OL.ev''] ;
    nf2 : Id (V1.Ix (Q.1.tob X tt)) (N2.nfun X s0 e) (OL.ev2 X s0 e) =
     TQw.pr-inj X s0 (N2.nfun X s0 e) (OL.ev2 X s0 e) (PNe.q X s0 e) ;
    module CAe = PLd.CA[X, phi, J1.EQd.EI.gN.nfun X (PLd.OY.d1 X.1 X.2) (PLd.OZ.Bk[X.1, X.2, CM2.DE.tau X.1 X.2 e].res)] ;
    law : Id (V1.Ix (Q.1.tob X tt)) (M1.nfun X phi e) (DW.Gf2 X CAe.wO CAe.dZ) =
     transH nf2 (transH st2
      (transH (apH {PLd.TA.EI X} {V1.Ix (Q.1.tob X tt)} (\ e1 -> HI.Gf X CAe.wq (HI.DI.invP.nt X (CM2.DE.tau X.1 X.2 e1))) ppE)
        (apH {CV2.DQ.TOb' X.1 X.2 (CV2.DT1.tau X.1 X.2 tt)} {V1.Ix (Q.1.tob X tt)} (J1.HH.EQt.EI.gN.nfun X tt) CAe.law))) ;
   } ;
   -- the line: D rho's f g ~ id at bk(tau e), through the composite over Om
   module EQd = J1.EQd ;
   DG : TR.P1.PCtx = J1.DG ;
   module TE = HO1.HT[DG, J1.DBt, J1.DBt, HO1.compN DG J1.DBt J1.DAt J1.DBt EQd.EI.gN EQd.PNa.nm, HO1.idN DG J1.DBt] ;
   zE (X : CT.TC.TOb) (e : V1.Ix (OL.E.ob X)) : V1.Ix (TE.GA.ob X) = PLd.OZ.bk X.1 X.2 (CM2.DE.tau X.1 X.2 e) ;
   lineE (X : CT.TC.TOb) (e : V1.Ix (OL.E.ob X)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv) : CM2.DE.Ob' Vv.1 Vv.2 =
    PLd.OZ.fw Vv (TE.pv EQd.EI.eps X (zE X e) Vv g j) ;
   gv (X : CT.TC.TOb) (ph : V1.Ix (OL.POm.ob X)) (d : CM2.DE.Ob' X.1 X.2) : TQw.EI X = TQw.pr X ph (DW.Gf2 X (CM2.DOm.tau X.1 X.2 ph) d) ;
   tvo (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv) : TQw.EI Vv =
    gv Vv (OL.POm.act Vv X g phi) (lineE X e Vv g j) ;
   module TNo (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X)) (Vb Va : CT.TC.TOb) (g2 : CT.TC.THm Vb Va) (g : CT.TC.THm Va X) (j : Hom Va.1 Iv) {
    xa : V1.Ix (OL.POm.ob Va) = OL.POm.act Va X g phi ;
    xb : V1.Ix (OL.POm.ob Vb) = OL.POm.act Vb X (CT.TC.TotCat.oC Vb Va X g g2) phi ;
    ee : Id (V1.Ix (OL.POm.ob Vb)) (OL.POm.act Vb Va g2 xa) xb = symH (OL.POm.act-o Vb Va X g g2 phi) ;
    da : CM2.DE.Ob' Va.1 Va.2 = lineE X e Va g j ;
    module GNa = DW.GN2[Va, Vb, g2, CM2.DOm.tau Va.1 Va.2 xa, da] ;
    pvA : V1.Ix (TE.GA.ob Va) = TE.pv EQd.EI.eps X (zE X e) Va g j ;
    dEq : Id (CM2.DE.Ob' Vb.1 Vb.2) GNa.d' (lineE X e Vb (CT.TC.TotCat.oC Vb Va X g g2) (compH Vb.1 Va.1 Iv j g2.1)) =
     transH (symH (PLd.OZ.fwN Vb Va g2 pvA))
      (apH {V1.Ix (TE.GA.ob Vb)} {CM2.DE.Ob' Vb.1 Vb.2} (PLd.OZ.fw Vb) ((EQd.EI.eps.eob X (zE X e)).1.2 Vb Va g2 g j)) ;
    law : Id (TQw.EI Vb) (TQw.E.act Vb Va g2 (tvo X phi e Va g j)) (tvo X phi e Vb (CT.TC.TotCat.oC Vb Va X g g2) (compH Vb.1 Va.1 Iv j g2.1)) =
     transH (TQw.pr-tact Vb Va g2 xa xb ee (DW.Gf2 Va (CM2.DOm.tau Va.1 Va.2 xa) da))
      (apH {V1.Ix (Q.1.tob Vb tt)} {TQw.EI Vb} (TQw.pr Vb xb)
        (transH (GNa.law (eps0 Vb Va g2 xa xb ee))
          (transH (apH {CM2.DOm.Ob' Vb.1 Vb.2} {V1.Ix (Q.1.tob Vb tt)} (\ w0 -> DW.Gf2 Vb w0 GNa.d') (wTau Vb Va g2 xa xb ee))
            (apH {CM2.DE.Ob' Vb.1 Vb.2} {V1.Ix (Q.1.tob Vb tt)} (DW.Gf2 Vb (CM2.DOm.tau Vb.1 Vb.2 xb)) dEq)))) ;
   } ;
   -- the homotopy M1 ~ Psi2 at the total site
   module HT2a = HO1.HT[OL.POm, OL.Ew, OL.Qw, M1, Psi2N] ;
   end0 (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X))
    : Id (TQw.EI X) (tvo X phi e X (CT.TC.tid X) (PB.ptH X.1 PB.e0)) (TQw.pr X phi (M1.nfun X phi e)) =
    transH (apH {V1.Ix (OL.POm.ob X)} {TQw.EI X} (\ ph -> gv X ph (lineE X e X (CT.TC.tid X) (PB.ptH X.1 PB.e0))) (OL.POm.act-id X phi))
     (apH {V1.Ix (Q.1.tob X tt)} {TQw.EI X} (TQw.pr X phi)
       (transH (apH {CM2.DE.Ob' X.1 X.2} {V1.Ix (Q.1.tob X tt)} (DW.Gf2 X (CM2.DOm.tau X.1 X.2 phi))
                  (apH {V1.Ix (TE.GA.ob X)} {CM2.DE.Ob' X.1 X.2} (PLd.OZ.fw X) (EQd.EI.eps.eob X (zE X e)).2.2.1))
         (symH M1v[X, phi, e].law))) ;
   end1 (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X))
    : Id (TQw.EI X) (tvo X phi e X (CT.TC.tid X) (PB.ptH X.1 PB.e1)) (TQw.pr X phi (Psi2N.nfun X phi e)) =
    transH (apH {V1.Ix (OL.POm.ob X)} {TQw.EI X} (\ ph -> gv X ph (lineE X e X (CT.TC.tid X) (PB.ptH X.1 PB.e1))) (OL.POm.act-id X phi))
     (apH {CM2.DE.Ob' X.1 X.2} {TQw.EI X} (gv X phi)
       (transH (apH {V1.Ix (TE.GA.ob X)} {CM2.DE.Ob' X.1 X.2} (PLd.OZ.fw X) (EQd.EI.eps.eob X (zE X e)).2.2.2)
         (PLd.OZ.fb X.1 X.2 (CM2.DE.tau X.1 X.2 e)))) ;
   patho (X : CT.TC.TOb) (zz : V1.Ix (HT2a.GA.ob X)) : V1.Ix (HT2a.PT.tobP X zz) =
    HT2a.PT.mkPath X zz (\ Vv g j -> tvo X (HT2a.TA.pr1 X zz) (HT2a.TA.pr2 X zz) Vv g j)
     (\ Vb Va g2 g j -> TNo[X, HT2a.TA.pr1 X zz, HT2a.TA.pr2 X zz, Vb, Va, g2, g, j].law)
     (\ Vv g j -> refl (OL.POm.act Vv X g (HT2a.TA.pr1 X zz)))
     (end0 X (HT2a.TA.pr1 X zz) (HT2a.TA.pr2 X zz)) (end1 X (HT2a.TA.pr1 X zz) (HT2a.TA.pr2 X zz)) ;
   zEN (J I : CT.TC.TOb) (h : CT.TC.THm J I) (e : V1.Ix (OL.E.ob I)) : Id (V1.Ix (TE.GA.ob J)) (TE.GA.act J I h (zE I e)) (zE J (OL.E.act J I h e)) =
    transH (symH (PLd.OZ.bkS.nt-nat J I h (CM2.DE.tau I.1 I.2 e)))
     (apH {CM2.DE.Ob' J.1 J.2} {V1.Ix (TE.GA.ob J)} (PLd.OZ.bkS.nt J) (symH (CM2.DE.tau-nat J.1 I.1 h.1 J.2 I.2 h.2 e))) ;
   ENo (J I : CT.TC.TOb) (h : CT.TC.THm J I) (phi : V1.Ix (OL.POm.ob I)) (e : V1.Ix (OL.E.ob I)) (Vv : CT.TC.TOb) (f : CT.TC.THm Vv J) (i : Hom Vv.1 Iv)
    : Id (TQw.EI Vv) (tvo I phi e Vv (CT.TC.TotCat.oC Vv J I h f) i) (tvo J (OL.POm.act J I h phi) (OL.E.act J I h e) Vv f i) =
    transH (apH {V1.Ix (OL.POm.ob Vv)} {TQw.EI Vv} (\ ph -> gv Vv ph (lineE I e Vv (CT.TC.TotCat.oC Vv J I h f) i)) (OL.POm.act-o Vv J I h f phi))
     (apH {CM2.DE.Ob' Vv.1 Vv.2} {TQw.EI Vv} (gv Vv (OL.POm.act Vv J f (OL.POm.act J I h phi)))
       (apH {V1.Ix (TE.GA.ob Vv)} {CM2.DE.Ob' Vv.1 Vv.2} (PLd.OZ.fw Vv)
         (transH (TE.pv-res EQd.EI.eps J I h (zE I e) (TE.GA.act J I h (zE I e)) (refl (TE.GA.act J I h (zE I e))) Vv f i)
           (apH {V1.Ix (TE.GA.ob J)} {V1.Ix (TE.GA.ob Vv)} (\ z2 -> TE.pv EQd.EI.eps J z2 Vv f i) (zEN J I h e))))) ;
   enato (J I : CT.TC.TOb) (h : CT.TC.THm J I) (zz : V1.Ix (HT2a.GA.ob I)) (zz' : V1.Ix (HT2a.GA.ob J)) (ee : Id (V1.Ix (HT2a.GA.ob J)) (HT2a.GA.act J I h zz) zz')
    : Id (V1.Ix (HT2a.PT.tobP J zz')) (HT2a.PT.PathP.tact J I h zz zz' ee (patho I zz)) (patho J zz') =
    HT2a.PT.path-eq J zz' (HT2a.PT.PathP.tact J I h zz zz' ee (patho I zz)) (patho J zz') (\ Vv f i ->
     transH (ENo J I h (HT2a.TA.pr1 I zz) (HT2a.TA.pr2 I zz) Vv f i)
      (apH {V1.Ix (HT2a.GA.ob J)} {TQw.EI Vv} (\ z2 -> tvo J (HT2a.TA.pr1 J z2) (HT2a.TA.pr2 J z2) Vv f i) ee)) ;
   h2a : PS1.PEl[HT2a.GA, HT2a.PT.PathP] = new PS1.PEl[HT2a.GA, HT2a.PT.PathP, patho, enato] ;
  } ;
 } ;
} ;
