-- CHomT16.seg (canonicity-45; SIMPLIFIED.md step 6): the internal Hom of
-- presented algebras against C's map codes, part 13: beta is natural in
-- the stage, res (beta z) = beta (tact z) (CMorX.mExt on the families:
-- the function part on the nose, the data by CHomT14 / CHomT15); hence
-- alpha is natural (through the two round trips).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Nat (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s t : SX.Over[R].Presentation) {
 module BN0 = CHomT14[a].BNat[R, encK, pe, s, t] ;
 module TM = BN0.TM ;
 module P = BN0.P ;
 module F = BN0.F ;
 module NA = CHomT14[a].BinN[R, encK, pe, s, t, P.addO s, P.addO t, \ I z -> z.2.1, \ I J v z -> refl (BN0.tactZ I J v z).2.1.1] ;
 module NM = CHomT14[a].BinN[R, encK, pe, s, t, P.mulO s, P.mulO t, \ I z -> z.2.2.1, \ I J v z -> refl (BN0.tactZ I J v z).2.2.1.1] ;
 module NC (r : R.R) { module D = CHomT15[a].CstN[R, encK, pe, s, t, r] ; } ;
 module At (I J : Ob) (v : Hom J I) (z : P.Z I) {
  z' : P.Z J = BN0.tactZ I J v z ;
  ph : F.Fam I = P.ph I z ;
  daEq : Id (F.BA.DT J (F.resF I J v ph)) (F.BA.resD I J v ph (P.da I z)) (P.da J z') =
   funext Ob (\ K -> (f : Hom K J) (w : F.S.T3 K) (p : V1.Ix (F.BA.FS K w)) -> V1.Ix (F.BA.FT K (F.mp3 J (F.resF I J v ph) K f w))) (F.BA.resD I J v ph (P.da I z)) (P.da J z') (\ K ->
   funext (Hom K J) (\ f -> (w : F.S.T3 K) (p : V1.Ix (F.BA.FS K w)) -> V1.Ix (F.BA.FT K (F.mp3 J (F.resF I J v ph) K f w))) (F.BA.resD I J v ph (P.da I z) K) (P.da J z' K) (\ f ->
   funext (F.S.T3 K) (\ w -> (p : V1.Ix (F.BA.FS K w)) -> V1.Ix (F.BA.FT K (F.mp3 J (F.resF I J v ph) K f w))) (F.BA.resD I J v ph (P.da I z) K f) (P.da J z' K f) (\ w ->
   funext (V1.Ix (F.BA.FS K w)) (\ p -> V1.Ix (F.BA.FT K (F.mp3 J (F.resF I J v ph) K f w))) (F.BA.resD I J v ph (P.da I z) K f w) (P.da J z' K f w) (\ p ->
    NA.DE[I, J, v, z, K, f, w, p].law)))) ;
  dmEq : Id (F.BM.DT J (F.resF I J v ph)) (F.BM.resD I J v ph (P.dm I z)) (P.dm J z') =
   funext Ob (\ K -> (f : Hom K J) (w : F.S.T3 K) (p : V1.Ix (F.BM.FS K w)) -> V1.Ix (F.BM.FT K (F.mp3 J (F.resF I J v ph) K f w))) (F.BM.resD I J v ph (P.dm I z)) (P.dm J z') (\ K ->
   funext (Hom K J) (\ f -> (w : F.S.T3 K) (p : V1.Ix (F.BM.FS K w)) -> V1.Ix (F.BM.FT K (F.mp3 J (F.resF I J v ph) K f w))) (F.BM.resD I J v ph (P.dm I z) K) (P.dm J z' K) (\ f ->
   funext (F.S.T3 K) (\ w -> (p : V1.Ix (F.BM.FS K w)) -> V1.Ix (F.BM.FT K (F.mp3 J (F.resF I J v ph) K f w))) (F.BM.resD I J v ph (P.dm I z) K f) (P.dm J z' K f) (\ w ->
   funext (V1.Ix (F.BM.FS K w)) (\ p -> V1.Ix (F.BM.FT K (F.mp3 J (F.resF I J v ph) K f w))) (F.BM.resD I J v ph (P.dm I z) K f w) (P.dm J z' K f w) (\ p ->
    NM.DE[I, J, v, z, K, f, w, p].law)))) ;
  dcEq : Id ((r : R.R) -> F.NC[r].N.DT J (F.resF I J v ph)) (\ r -> F.NC[r].N.resD I J v ph (P.CR[r].dc I z)) (\ r -> P.CR[r].dc J z') =
   funext R.R (\ r -> F.NC[r].N.DT J (F.resF I J v ph)) (\ r -> F.NC[r].N.resD I J v ph (P.CR[r].dc I z)) (\ r -> P.CR[r].dc J z') (\ r ->
   funext Ob (\ K -> (f : Hom K J) (u : F.S.QK K) (p : V1.Ix (F.NC[r].N.FS K u)) -> V1.Ix (F.NC[r].N.FT K (F.resF I J v ph K f u))) (F.NC[r].N.resD I J v ph (P.CR[r].dc I z)) (P.CR[r].dc J z') (\ K ->
   funext (Hom K J) (\ f -> (u : F.S.QK K) (p : V1.Ix (F.NC[r].N.FS K u)) -> V1.Ix (F.NC[r].N.FT K (F.resF I J v ph K f u))) (F.NC[r].N.resD I J v ph (P.CR[r].dc I z) K) (P.CR[r].dc J z' K) (\ f ->
   funext (F.S.QK K) (\ u -> (p : V1.Ix (F.NC[r].N.FS K u)) -> V1.Ix (F.NC[r].N.FT K (F.resF I J v ph K f u))) (F.NC[r].N.resD I J v ph (P.CR[r].dc I z) K f) (P.CR[r].dc J z' K f) (\ u ->
   funext (V1.Ix (F.NC[r].N.FS K u)) (\ p -> V1.Ix (F.NC[r].N.FT K (F.resF I J v ph K f u))) (F.NC[r].N.resD I J v ph (P.CR[r].dc I z) K f u) (P.CR[r].dc J z' K f u) (\ p ->
    NC[r].D.DE[I, J, v, z, K, f, u, p].law))))) ;
  fpEq : Id (F.FP J) (F.fpOf J (F.res I J v (TM.beta I z))) (P.fp J z') =
   transH (apH {F.BA.DT J (F.resF I J v ph)} {F.FP J} (\ x1 -> (F.resF I J v ph, (x1, (F.BM.resD I J v ph (P.dm I z), \ r -> F.NC[r].N.resD I J v ph (P.CR[r].dc I z))))) daEq)
    (transH (apH {F.BM.DT J (F.resF I J v ph)} {F.FP J} (\ x1 -> (F.resF I J v ph, (P.da J z', (x1, \ r -> F.NC[r].N.resD I J v ph (P.CR[r].dc I z))))) dmEq)
      (apH {(r : R.R) -> F.NC[r].N.DT J (F.resF I J v ph)} {F.FP J} (\ x1 -> (F.resF I J v ph, (P.da J z', (P.dm J z', x1)))) dcEq)) ;
  bNat : Id (F.M J) (F.res I J v (TM.beta I z)) (TM.beta J z') = F.mExt J (F.res I J v (TM.beta I z)) (TM.beta J z') fpEq ;
 } ;
 module FM = CHomT11[a].FromM[R, encK, pe, s, t] ;
 aNat (I J : Ob) (v : Hom J I) (m : F.M I) : Id (P.Z J) (FM.alpha J (F.res I J v m)) (BN0.tactZ I J v (FM.alpha I m)) =
  transH (apH {F.M I} {P.Z J} (\ m2 -> FM.alpha J (F.res I J v m2)) (symH (CHomT12[a].RT1[R, encK, pe, s, t].At[I, m].rt)))
   (transH (apH {F.M J} {P.Z J} (\ m2 -> FM.alpha J m2) At[I, J, v, FM.alpha I m].bNat)
     (CHomT13[a].RT2[R, encK, pe, s, t].At[J, BN0.tactZ I J v (FM.alpha I m)].rt)) ;
} ;
