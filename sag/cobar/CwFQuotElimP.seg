-- CwFQuotElimP.seg (canonicity-c2; SIMPLIFIED.md item 3): elimination of
-- the Voevodsky quotient (CwFQuot) into a family of propositions.
--
-- Informal text.  Let P be a type over G.Qt, a proposition, with an
-- element h over G.A at the class map.
-- (1) G.Qt is a retract of EQ2 = G.PA.TrS (CwFUnpk), so a section of P
--     along pk over EQ2 is enough; by the truncation's eliminator, one
--     over KS = G.PA.S along the unit; and KS is a retract of
--     E3 = G.PA.A.Id(r a , P) (CwFUnpk again), with honest variables
--     P , a , u.  Call s3 : E3 -> G.Qt the composite.
-- (2) Over E3 there are two elements of Qt: e2, the last component of s3
--     (the pair (P , |a , u|)), and e1, the class of a.  Their first
--     components are P and r a, joined by u; so e1 and e2 are joined
--     (CwFPropPair).
-- (3) h at a is an element of P at e1; its transport along (2) (CwFTr)
--     is an element of P at e2, i.e. of P along s3.
open Base ;

module QuotElimP (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g))
  (tr : CwFTrunc.Trunc[l, C, PS, SS, IJ, Un].TruncAt) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module QT = CwFQuot.Quot[l, C, PS, SS, IJ, Un, NF, tr] ;
  module UK = CwFUnpk.Unpk[l, C, PS, SS, IJ] ;
  module SV = CwFSig.SigV[l, C, PS, SS, IJ] ;
  module QC = CwFQinvC.QinvC[l, C, PS, SS, IJ, NF] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module PPr = CwFPropPair.PropPair[l, C, PS, SS, IJ, Un] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;

  -- an Id between transported elements, read before the transport
  idBack (G : Ctx) (X X' : Ty G) (P : Id (Ty G) X X') (x y : El G X)
    (u : El G (IJ.IdT G X' (trE G X X' P x) (trE G X X' P y))) : El G (IJ.IdT G X x y) =
    idJ (Ty G) X (\ Z PZ -> El G (IJ.IdT G Z (trE G X Z PZ x) (trE G X Z PZ y)) -> El G (IJ.IdT G X x y)) (\ v -> v) X' P u ;

  -- the class map at a point (g , a) of G.A over any context E: its first
  -- component is r a
  module ClsAt (G : Ctx) (A : Ty G) (r : El G (Fun G A (Fun G A (PU.PropU G)))) (E : Ctx) (g : Sub E G) (a : El E (subT E G A g)) {
    module QQ = QT.Q[G, A, r] ;
    D : Ctx = ext G A ;
    m : Sub E D = extS E G A g a ;
    QtE : Ty E = subT E G QQ.Qt g ;
    PAE : Ty E = subT E G QQ.PA g ;
    AE : Ty E = subT E G A g ;
    TrSE : Ty (ext E PAE) = subT (ext E PAE) QQ.K QQ.TrS (lift E G QQ.PA g) ;
    SgE : Ty E = SS.Sig E PAE TrSE ;
    PSg : Id (Ty E) QtE SgE = SS.Sig-nat E G QQ.PA QQ.TrS g ;
    cE : El E QtE = trE E (subT E D (wkT G A QQ.Qt) m) QtE (IN.wkT-extS E G A QQ.Qt g a) (subt E D (wkT G A QQ.Qt) QQ.cls m) ;
    w' : El E SgE = trE E QtE SgE PSg cE ;
    PXm : Id (Ty E) (subT E D QQ.PAd m) PAE = IN.wkT-extS E G A QQ.PA g a ;
    lc : Id (Sub (ext E PAE) QQ.K) (o (ext E PAE) (ext D QQ.PAd) QQ.K QQ.up0 (upT E D QQ.PAd m PAE PXm)) (lift E G QQ.PA g) =
      SV.liftComp E D G QQ.PA (p G A) m g (IN.p-extS E G A g a) PXm ;
    PBm : Id (Ty (ext E PAE)) (subT (ext E PAE) (ext D QQ.PAd) QQ.TrS' (upT E D QQ.PAd m PAE PXm)) TrSE =
      trans (Ty (ext E PAE)) (subT (ext E PAE) (ext D QQ.PAd) QQ.TrS' (upT E D QQ.PAd m PAE PXm))
        (subT (ext E PAE) QQ.K QQ.TrS (o (ext E PAE) (ext D QQ.PAd) QQ.K QQ.up0 (upT E D QQ.PAd m PAE PXm))) TrSE
        (sym (Ty (ext E PAE)) (subT (ext E PAE) QQ.K QQ.TrS (o (ext E PAE) (ext D QQ.PAd) QQ.K QQ.up0 (upT E D QQ.PAd m PAE PXm)))
           (subT (ext E PAE) (ext D QQ.PAd) QQ.TrS' (upT E D QQ.PAd m PAE PXm))
           (subT-o (ext E PAE) (ext D QQ.PAd) QQ.K QQ.TrS QQ.up0 (upT E D QQ.PAd m PAE PXm)))
        (ap (Sub (ext E PAE) QQ.K) (Ty (ext E PAE)) (\ t -> subT (ext E PAE) QQ.K QQ.TrS t)
           (o (ext E PAE) (ext D QQ.PAd) QQ.K QQ.up0 (upT E D QQ.PAd m PAE PXm)) (lift E G QQ.PA g) lc) ;
    SD : Ty D = SS.Sig D QQ.PAd QQ.TrS' ;
    wD : El D SD = IN.pr D QQ.PAd QQ.TrS' QQ.ra0 QQ.yT ;
    PWm : Id (Ty E) (subT E D SD m) SgE = Sig-ov E D QQ.PAd QQ.TrS' m PAE PXm TrSE PBm ;
    Pw : Ov E D SD m SgE PWm wD w' =
      IN.teAny E (subT E D SD m) SgE (subt E D SD wD m) w'
        (IN.teT E (subT E D SD m) (subT E D (wkT G A QQ.Qt) m) SgE (subt E D SD wD m) (subt E D (wkT G A QQ.Qt) QQ.cls m) w'
           (SV.teSub E D SD (wkT G A QQ.Qt) wD QQ.cls
              (IN.teTr D SD (wkT G A QQ.Qt) (sym (Ty D) (wkT G A QQ.Qt) SD QQ.QW) wD) m)
           (IN.teT E (subT E D (wkT G A QQ.Qt) m) QtE SgE (subt E D (wkT G A QQ.Qt) QQ.cls m) cE w'
              (IN.teTr E (subT E D (wkT G A QQ.Qt) m) QtE (IN.wkT-extS E G A QQ.Qt g a) (subt E D (wkT G A QQ.Qt) QQ.cls m))
              (IN.teTr E QtE SgE PSg cE)))
        PWm ;
    rE : El E (Fun E AE PAE) = QC.fAl E G g A QQ.PA r ;
    fstAt : Id (El E PAE) (IN.fst E PAE TrSE w') (app E AE PAE rE a) =
      trans (El E PAE) (IN.fst E PAE TrSE w') (trE E (subT E D QQ.PAd m) PAE PXm (subt E D QQ.PAd (IN.fst D QQ.PAd QQ.TrS' wD) m)) (app E AE PAE rE a)
        (sym (El E PAE) (trE E (subT E D QQ.PAd m) PAE PXm (subt E D QQ.PAd (IN.fst D QQ.PAd QQ.TrS' wD) m)) (IN.fst E PAE TrSE w')
           (IN.fst-ov E D QQ.PAd QQ.TrS' m PAE PXm TrSE PBm PWm wD w' Pw))
        (trans (El E PAE) (trE E (subT E D QQ.PAd m) PAE PXm (subt E D QQ.PAd (IN.fst D QQ.PAd QQ.TrS' wD) m))
           (trE E (subT E D QQ.PAd m) PAE PXm (subt E D QQ.PAd QQ.ra0 m)) (app E AE PAE rE a)
           (ap (El D QQ.PAd) (El E PAE) (\ v -> trE E (subT E D QQ.PAd m) PAE PXm (subt E D QQ.PAd v m)) (IN.fst D QQ.PAd QQ.TrS' wD) QQ.ra0
              (IN.fst-pr D QQ.PAd QQ.TrS' QQ.ra0 QQ.yT))
           (QC.appVar E G A QQ.PA r g a)) ;
  } ;

  module Ctxs (G : Ctx) (A : Ty G) (r : El G (Fun G A (Fun G A (PU.PropU G)))) {
    module QQ = QT.Q[G, A, r] ;
    PA : Ty G = QQ.PA ;
    K : Ctx = QQ.K ;
    Qt : Ty G = QQ.Qt ;
    module UQ = UK.At[G, PA, QQ.TrS] ;
    module U3 = UK.At[K, QQ.AK, QQ.FamT] ;
    ESq : Ctx = ext G Qt ;
    EQ2 : Ctx = ext K QQ.TrS ;
    KS : Ctx = ext K QQ.S ;
    E3 : Ctx = U3.E2 ;
    incS : Sub KS EQ2 = tr.incS K QQ.S ;
    sK : Sub KS ESq = o KS EQ2 ESq UQ.pk incS ;
    s3 : Sub E3 ESq = o E3 KS ESq sK U3.pk ;
    -- the base parts
    eK : Id (Sub KS G) (o KS ESq G (p G Qt) sK) (o KS K G (p G PA) (p K QQ.S)) =
      trans (Sub KS G) (o KS ESq G (p G Qt) sK) (o KS EQ2 G (o EQ2 ESq G (p G Qt) UQ.pk) incS) (o KS K G (p G PA) (p K QQ.S))
        (sym (Sub KS G) (o KS EQ2 G (o EQ2 ESq G (p G Qt) UQ.pk) incS) (o KS ESq G (p G Qt) sK) (o-assoc KS EQ2 ESq G (p G Qt) UQ.pk incS))
        (trans (Sub KS G) (o KS EQ2 G (o EQ2 ESq G (p G Qt) UQ.pk) incS) (o KS EQ2 G UQ.VS.pp incS) (o KS K G (p G PA) (p K QQ.S))
           (ap (Sub EQ2 G) (Sub KS G) (\ t -> o KS EQ2 G t incS) (o EQ2 ESq G (p G Qt) UQ.pk) UQ.VS.pp (IN.p-extS EQ2 G Qt UQ.VS.pp UQ.VS.pv))
           (trans (Sub KS G) (o KS EQ2 G UQ.VS.pp incS) (o KS K G (p G PA) (o KS EQ2 K UQ.VS.p2 incS)) (o KS K G (p G PA) (p K QQ.S))
              (o-assoc KS EQ2 K G (p G PA) UQ.VS.p2 incS)
              (ap (Sub KS K) (Sub KS G) (\ t -> o KS K G (p G PA) t) (o KS EQ2 K UQ.VS.p2 incS) (p K QQ.S)
                 (IN.p-extS KS K QQ.TrS (p K QQ.S) (tr.inc K QQ.S))))) ;
    pG3 : Sub E3 G = o E3 K G (p G PA) U3.VS.pp ;
    e3 : Id (Sub E3 G) (o E3 ESq G (p G Qt) s3) pG3 =
      trans (Sub E3 G) (o E3 ESq G (p G Qt) s3) (o E3 KS G (o KS ESq G (p G Qt) sK) U3.pk) pG3
        (sym (Sub E3 G) (o E3 KS G (o KS ESq G (p G Qt) sK) U3.pk) (o E3 ESq G (p G Qt) s3) (o-assoc E3 KS ESq G (p G Qt) sK U3.pk))
        (trans (Sub E3 G) (o E3 KS G (o KS ESq G (p G Qt) sK) U3.pk) (o E3 KS G (o KS K G (p G PA) (p K QQ.S)) U3.pk) pG3
           (ap (Sub KS G) (Sub E3 G) (\ t -> o E3 KS G t U3.pk) (o KS ESq G (p G Qt) sK) (o KS K G (p G PA) (p K QQ.S)) eK)
           (trans (Sub E3 G) (o E3 KS G (o KS K G (p G PA) (p K QQ.S)) U3.pk) (o E3 K G (p G PA) (o E3 KS K (p K QQ.S) U3.pk)) pG3
              (o-assoc E3 KS K G (p G PA) (p K QQ.S) U3.pk)
              (ap (Sub E3 K) (Sub E3 G) (\ t -> o E3 K G (p G PA) t) (o E3 KS K (p K QQ.S) U3.pk) U3.VS.pp
                 (IN.p-extS E3 K QQ.S U3.VS.pp U3.VS.pv)))) ;

    ----------------------------------------------------------------
    -- (2) the two elements of Qt over E3
    Qt3 : Ty E3 = subT E3 G Qt pG3 ;
    D : Ctx = ext G A ;
    -- e2: the last component of s3
    q3 : El E3 (subT E3 G Qt (o E3 ESq G (p G Qt) s3)) = IN.qOf E3 G Qt s3 ;
    e2 : El E3 Qt3 =
      trE E3 (subT E3 G Qt (o E3 ESq G (p G Qt) s3)) Qt3
        (ap (Sub E3 G) (Ty E3) (\ t -> subT E3 G Qt t) (o E3 ESq G (p G Qt) s3) pG3 e3) q3 ;
    s3eq : Id (Sub E3 ESq) s3 (extS E3 G Qt pG3 e2) =
      trans (Sub E3 ESq) s3 (extS E3 G Qt (o E3 ESq G (p G Qt) s3) q3) (extS E3 G Qt pG3 e2)
        (IN.sub-eta E3 G Qt s3)
        (IN.extS-cong E3 G Qt (o E3 ESq G (p G Qt) s3) pG3 e3 q3 e2 (refl e2)) ;
    -- the variable a, and the class of a
    a3 : El E3 (subT E3 G A pG3) =
      trE E3 (subT E3 K QQ.AK U3.VS.pp) (subT E3 G A pG3)
        (sym (Ty E3) (subT E3 G A pG3) (subT E3 K QQ.AK U3.VS.pp) (subT-o E3 K G A (p G PA) U3.VS.pp)) U3.VS.zA ;
    m3 : Sub E3 D = extS E3 G A pG3 a3 ;
    c3 : El E3 (subT E3 D (wkT G A Qt) m3) = subt E3 D (wkT G A Qt) QQ.cls m3 ;
    e1 : El E3 Qt3 = trE E3 (subT E3 D (wkT G A Qt) m3) Qt3 (IN.wkT-extS E3 G A Qt pG3 a3) c3 ;
    clsS : Sub D ESq = extS D G Qt (p G A) QQ.cls ;
    c3' : El E3 (subT E3 G Qt (o E3 D G (p G A) m3)) =
      trE E3 (subT E3 D (wkT G A Qt) m3) (subT E3 G Qt (o E3 D G (p G A) m3))
        (sym (Ty E3) (subT E3 G Qt (o E3 D G (p G A) m3)) (subT E3 D (wkT G A Qt) m3) (subT-o E3 D G Qt (p G A) m3)) c3 ;
    clsEq : Id (Sub E3 ESq) (o E3 D ESq clsS m3) (extS E3 G Qt pG3 e1) =
      trans (Sub E3 ESq) (o E3 D ESq clsS m3) (extS E3 G Qt (o E3 D G (p G A) m3) c3') (extS E3 G Qt pG3 e1)
        (SV.extS-o E3 D G Qt (p G A) QQ.cls m3)
        (IN.extS-cong E3 G Qt (o E3 D G (p G A) m3) pG3 (IN.p-extS E3 G A pG3 a3) c3' e1
           (IN.teAny E3 (subT E3 G Qt (o E3 D G (p G A) m3)) Qt3 c3' e1
              (IN.teT E3 (subT E3 G Qt (o E3 D G (p G A) m3)) (subT E3 D (wkT G A Qt) m3) Qt3 c3' c3 e1
                 (IN.teS E3 (subT E3 D (wkT G A Qt) m3) (subT E3 G Qt (o E3 D G (p G A) m3)) c3 c3'
                    (IN.teTr E3 (subT E3 D (wkT G A Qt) m3) (subT E3 G Qt (o E3 D G (p G A) m3))
                       (sym (Ty E3) (subT E3 G Qt (o E3 D G (p G A) m3)) (subT E3 D (wkT G A Qt) m3) (subT-o E3 D G Qt (p G A) m3)) c3))
                 (IN.teTr E3 (subT E3 D (wkT G A Qt) m3) Qt3 (IN.wkT-extS E3 G A Qt pG3 a3) c3))
              (ap (Sub E3 G) (Ty E3) (\ t -> subT E3 G Qt t) (o E3 D G (p G A) m3) pG3 (IN.p-extS E3 G A pG3 a3)))) ;

    ----------------------------------------------------------------
    -- the variables P and u over E3: u joins r a and P
    pp3 : Sub E3 K = U3.VS.pp ;
    KA : Ctx = ext K QQ.AK ;
    pF : Sub E3 KA = p KA QQ.FamT ;
    A3 : Ty E3 = subT E3 G A pG3 ;
    PA3 : Ty E3 = subT E3 G PA pG3 ;
    Pv3 : El E3 PA3 = IN.qOf E3 G PA pp3 ;
    rE : El E3 (Fun E3 A3 PA3) = QC.fAl E3 G pG3 A PA r ;
    ra3 : El E3 PA3 = app E3 A3 PA3 rE a3 ;
    X3 : Ty E3 = subT E3 K QQ.AK pp3 ;
    Y3 : Ty E3 = subT E3 K QQ.PAK pp3 ;
    PX3 : Id (Ty E3) X3 A3 = sym (Ty E3) A3 X3 (subT-o E3 K G A (p G PA) pp3) ;
    PY3 : Id (Ty E3) Y3 PA3 = sym (Ty E3) PA3 Y3 (subT-o E3 K G PA (p G PA) pp3) ;
    fK : El E3 (Fun E3 X3 Y3) = QC.fAl E3 K pp3 QQ.AK QQ.PAK QQ.rK ;
    eta3 : Id (Sub E3 K) pp3 (extS E3 G PA pG3 Pv3) = IN.sub-eta E3 G PA pp3 ;
    tf3 : IN.TE E3 (Fun E3 X3 Y3) (Fun E3 A3 PA3) fK rE =
      IN.teT E3 (Fun E3 X3 Y3) (subT E3 K (Fun K QQ.AK QQ.PAK) pp3) (Fun E3 A3 PA3) fK (subt E3 K (Fun K QQ.AK QQ.PAK) QQ.rK pp3) rE
        (IN.teS E3 (subT E3 K (Fun K QQ.AK QQ.PAK) pp3) (Fun E3 X3 Y3) (subt E3 K (Fun K QQ.AK QQ.PAK) QQ.rK pp3) fK
           (IN.teTr E3 (subT E3 K (Fun K QQ.AK QQ.PAK) pp3) (Fun E3 X3 Y3)
              (Fun-ov E3 K QQ.AK QQ.PAK pp3 X3 (refl X3) Y3 (refl Y3)) (subt E3 K (Fun K QQ.AK QQ.PAK) QQ.rK pp3)))
        (IN.teT E3 (subT E3 K (Fun K QQ.AK QQ.PAK) pp3) (subT E3 K (Fun K QQ.AK QQ.PAK) (extS E3 G PA pG3 Pv3)) (Fun E3 A3 PA3)
           (subt E3 K (Fun K QQ.AK QQ.PAK) QQ.rK pp3) (subt E3 K (Fun K QQ.AK QQ.PAK) QQ.rK (extS E3 G PA pG3 Pv3)) rE
           (IN.teSubEq E3 K (Fun K QQ.AK QQ.PAK) QQ.rK pp3 (extS E3 G PA pG3 Pv3) eta3)
           (QC.PFs E3 G PA A PA pG3 Pv3, QC.wkFAt E3 G PA A PA r pG3 Pv3)) ;
    appEq : IN.TE E3 Y3 PA3 (app E3 X3 Y3 fK U3.VS.zA) ra3 =
      QT.teApp E3 X3 Y3 fK U3.VS.zA A3 PX3 PA3 PY3 rE a3 tf3 (refl a3) ;
    teA : IN.TE E3 (subT E3 KA QQ.PA2 pF) PA3 (subt E3 KA QQ.PA2 QQ.raK pF) ra3 =
      IN.teT E3 (subT E3 KA QQ.PA2 pF) (subT E3 KA QQ.PA2 (extS E3 K QQ.AK pp3 U3.VS.zA)) PA3
        (subt E3 KA QQ.PA2 QQ.raK pF) (subt E3 KA QQ.PA2 QQ.raK (extS E3 K QQ.AK pp3 U3.VS.zA)) ra3
        (IN.teSubEq E3 KA QQ.PA2 QQ.raK pF (extS E3 K QQ.AK pp3 U3.VS.zA) U3.VS.eta2)
        (IN.teT E3 (subT E3 KA QQ.PA2 (extS E3 K QQ.AK pp3 U3.VS.zA)) Y3 PA3
           (subt E3 KA QQ.PA2 QQ.raK (extS E3 K QQ.AK pp3 U3.VS.zA)) (app E3 X3 Y3 fK U3.VS.zA) ra3
           (IN.wkT-extS E3 K QQ.AK QQ.PAK pp3 U3.VS.zA, QC.appVar E3 K QQ.AK QQ.PAK QQ.rK pp3 U3.VS.zA)
           appEq) ;
    teB : IN.TE E3 (subT E3 KA QQ.PA2 pF) PA3 (subt E3 KA QQ.PA2 QQ.Pv pF) Pv3 =
      IN.teT E3 (subT E3 KA QQ.PA2 pF) Y3 PA3 (subt E3 KA QQ.PA2 QQ.Pv pF) (subt E3 K QQ.PAK (q G PA) pp3) Pv3
        (IN.teS E3 Y3 (subT E3 KA QQ.PA2 pF) (subt E3 K QQ.PAK (q G PA) pp3) (subt E3 KA QQ.PA2 QQ.Pv pF)
           (IN.teSubtO E3 KA K QQ.PAK (q G PA) (p K QQ.AK) pF))
        (IN.teTr E3 Y3 PA3 PY3 (subt E3 K QQ.PAK (q G PA) pp3)) ;
    idT3 : Id (Ty E3) (wkT KA QQ.FamT QQ.FamT) (IJ.IdT E3 PA3 ra3 Pv3) =
      Id-ov E3 KA QQ.PA2 QQ.raK QQ.Pv pF PA3 teA.1 ra3 Pv3 teA.2
        (IN.teAny E3 (subT E3 KA QQ.PA2 pF) PA3 (subt E3 KA QQ.PA2 QQ.Pv pF) Pv3 teB teA.1) ;
    u3 : El E3 (IJ.IdT E3 PA3 ra3 Pv3) = trE E3 (wkT KA QQ.FamT QQ.FamT) (IJ.IdT E3 PA3 ra3 Pv3) idT3 (q KA QQ.FamT) ;

    ----------------------------------------------------------------
    -- the first component of e2 is the variable P
    module VQ = UQ.VS ;
    tau : Sub E3 EQ2 = o E3 KS EQ2 incS U3.pk ;
    TrS3 : Ty (ext E3 PA3) = subT (ext E3 PA3) K QQ.TrS (lift E3 G PA pG3) ;
    Sg3 : Ty E3 = SS.Sig E3 PA3 TrS3 ;
    PS3 : Id (Ty E3) Qt3 Sg3 = SS.Sig-nat E3 G PA QQ.TrS pG3 ;
    w2 : El E3 Sg3 = trE E3 Qt3 Sg3 PS3 e2 ;
    e2t : Id (Sub E3 K) (o E3 EQ2 K VQ.p2 tau) pp3 =
      trans (Sub E3 K) (o E3 EQ2 K VQ.p2 tau) (o E3 KS K (o KS EQ2 K VQ.p2 incS) U3.pk) pp3
        (sym (Sub E3 K) (o E3 KS K (o KS EQ2 K VQ.p2 incS) U3.pk) (o E3 EQ2 K VQ.p2 tau) (o-assoc E3 KS EQ2 K VQ.p2 incS U3.pk))
        (trans (Sub E3 K) (o E3 KS K (o KS EQ2 K VQ.p2 incS) U3.pk) (o E3 KS K (p K QQ.S) U3.pk) pp3
           (ap (Sub KS K) (Sub E3 K) (\ t -> o E3 KS K t U3.pk) (o KS EQ2 K VQ.p2 incS) (p K QQ.S)
              (IN.p-extS KS K QQ.TrS (p K QQ.S) (tr.inc K QQ.S)))
           (IN.p-extS E3 K QQ.S U3.VS.pp U3.VS.pv)) ;
    et : Id (Sub E3 G) (o E3 EQ2 G VQ.pp tau) pG3 =
      trans (Sub E3 G) (o E3 EQ2 G VQ.pp tau) (o E3 K G (p G PA) (o E3 EQ2 K VQ.p2 tau)) pG3
        (o-assoc E3 EQ2 K G (p G PA) VQ.p2 tau)
        (ap (Sub E3 K) (Sub E3 G) (\ t -> o E3 K G (p G PA) t) (o E3 EQ2 K VQ.p2 tau) pp3 e2t) ;
    PAt : Id (Ty E3) (subT E3 EQ2 VQ.App tau) PA3 =
      trans (Ty E3) (subT E3 EQ2 VQ.App tau) (subT E3 G PA (o E3 EQ2 G VQ.pp tau)) PA3
        (sym (Ty E3) (subT E3 G PA (o E3 EQ2 G VQ.pp tau)) (subT E3 EQ2 VQ.App tau) (subT-o E3 EQ2 G PA VQ.pp tau))
        (ap (Sub E3 G) (Ty E3) (\ t -> subT E3 G PA t) (o E3 EQ2 G VQ.pp tau) pG3 et) ;
    lct : Id (Sub (ext E3 PA3) K) (o (ext E3 PA3) VQ.E3 K (lift EQ2 G PA VQ.pp) (upT E3 EQ2 VQ.App tau PA3 PAt)) (lift E3 G PA pG3) =
      SV.liftComp E3 EQ2 G PA VQ.pp tau pG3 et PAt ;
    PBt : Id (Ty (ext E3 PA3)) (subT (ext E3 PA3) VQ.E3 VQ.Bl (upT E3 EQ2 VQ.App tau PA3 PAt)) TrS3 =
      trans (Ty (ext E3 PA3)) (subT (ext E3 PA3) VQ.E3 VQ.Bl (upT E3 EQ2 VQ.App tau PA3 PAt))
        (subT (ext E3 PA3) K QQ.TrS (o (ext E3 PA3) VQ.E3 K (lift EQ2 G PA VQ.pp) (upT E3 EQ2 VQ.App tau PA3 PAt))) TrS3
        (sym (Ty (ext E3 PA3)) (subT (ext E3 PA3) K QQ.TrS (o (ext E3 PA3) VQ.E3 K (lift EQ2 G PA VQ.pp) (upT E3 EQ2 VQ.App tau PA3 PAt)))
           (subT (ext E3 PA3) VQ.E3 VQ.Bl (upT E3 EQ2 VQ.App tau PA3 PAt))
           (subT-o (ext E3 PA3) VQ.E3 K QQ.TrS (lift EQ2 G PA VQ.pp) (upT E3 EQ2 VQ.App tau PA3 PAt)))
        (ap (Sub (ext E3 PA3) K) (Ty (ext E3 PA3)) (\ t -> subT (ext E3 PA3) K QQ.TrS t)
           (o (ext E3 PA3) VQ.E3 K (lift EQ2 G PA VQ.pp) (upT E3 EQ2 VQ.App tau PA3 PAt)) (lift E3 G PA pG3) lct) ;
    SQ : Ty EQ2 = SS.Sig EQ2 VQ.App VQ.Bl ;
    PWt : Id (Ty E3) (subT E3 EQ2 SQ tau) Sg3 = Sig-ov E3 EQ2 VQ.App VQ.Bl tau PA3 PAt TrS3 PBt ;
    WQ : Ty ESq = wkT G Qt Qt ;
    s3t : Id (Sub E3 ESq) (o E3 EQ2 ESq UQ.pk tau) s3 =
      sym (Sub E3 ESq) s3 (o E3 EQ2 ESq UQ.pk tau) (o-assoc E3 KS EQ2 ESq UQ.pk incS U3.pk) ;
    tePv : IN.TE E3 (subT E3 EQ2 SQ tau) Sg3 (subt E3 EQ2 SQ VQ.pv0 tau) w2 =
      IN.teT E3 (subT E3 EQ2 SQ tau) (subT E3 EQ2 VQ.SW tau) Sg3 (subt E3 EQ2 SQ VQ.pv0 tau) (subt E3 EQ2 VQ.SW VQ.pv tau) w2
        (SV.teSub E3 EQ2 SQ VQ.SW VQ.pv0 VQ.pv (IN.teTr EQ2 SQ VQ.SW (sym (Ty EQ2) VQ.SW SQ VQ.SN) VQ.pv0) tau)
        (IN.teT E3 (subT E3 EQ2 VQ.SW tau) (subT E3 EQ2 (subT EQ2 ESq WQ UQ.pk) tau) Sg3
           (subt E3 EQ2 VQ.SW VQ.pv tau) (subt E3 EQ2 (subT EQ2 ESq WQ UQ.pk) (subt EQ2 ESq WQ (q G Qt) UQ.pk) tau) w2
           (SV.teSub E3 EQ2 VQ.SW (subT EQ2 ESq WQ UQ.pk) VQ.pv (subt EQ2 ESq WQ (q G Qt) UQ.pk)
              (IN.teS EQ2 (subT EQ2 ESq WQ UQ.pk) VQ.SW (subt EQ2 ESq WQ (q G Qt) UQ.pk) VQ.pv
                 (IN.teOv EQ2 ESq WQ UQ.pk VQ.SW UQ.PWq (q G Qt) VQ.pv (JP.q-extS EQ2 G Qt VQ.pp VQ.pv UQ.PWq))) tau)
           (IN.teT E3 (subT E3 EQ2 (subT EQ2 ESq WQ UQ.pk) tau) (subT E3 ESq WQ (o E3 EQ2 ESq UQ.pk tau)) Sg3
              (subt E3 EQ2 (subT EQ2 ESq WQ UQ.pk) (subt EQ2 ESq WQ (q G Qt) UQ.pk) tau) (subt E3 ESq WQ (q G Qt) (o E3 EQ2 ESq UQ.pk tau)) w2
              (IN.teS E3 (subT E3 ESq WQ (o E3 EQ2 ESq UQ.pk tau)) (subT E3 EQ2 (subT EQ2 ESq WQ UQ.pk) tau)
                 (subt E3 ESq WQ (q G Qt) (o E3 EQ2 ESq UQ.pk tau)) (subt E3 EQ2 (subT EQ2 ESq WQ UQ.pk) (subt EQ2 ESq WQ (q G Qt) UQ.pk) tau)
                 (IN.teSubtO E3 EQ2 ESq WQ (q G Qt) UQ.pk tau))
              (IN.teT E3 (subT E3 ESq WQ (o E3 EQ2 ESq UQ.pk tau)) (subT E3 ESq WQ s3) Sg3
                 (subt E3 ESq WQ (q G Qt) (o E3 EQ2 ESq UQ.pk tau)) (subt E3 ESq WQ (q G Qt) s3) w2
                 (IN.teSubEq E3 ESq WQ (q G Qt) (o E3 EQ2 ESq UQ.pk tau) s3 s3t)
                 (IN.teT E3 (subT E3 ESq WQ s3) (subT E3 G Qt (o E3 ESq G (p G Qt) s3)) Sg3 (subt E3 ESq WQ (q G Qt) s3) q3 w2
                    (IN.teTr E3 (subT E3 ESq WQ s3) (subT E3 G Qt (o E3 ESq G (p G Qt) s3))
                       (sym (Ty E3) (subT E3 G Qt (o E3 ESq G (p G Qt) s3)) (subT E3 ESq WQ s3) (subT-o E3 ESq G Qt (p G Qt) s3))
                       (subt E3 ESq WQ (q G Qt) s3))
                    (IN.teT E3 (subT E3 G Qt (o E3 ESq G (p G Qt) s3)) Qt3 Sg3 q3 e2 w2
                       (IN.teTr E3 (subT E3 G Qt (o E3 ESq G (p G Qt) s3)) Qt3
                          (ap (Sub E3 G) (Ty E3) (\ t -> subT E3 G Qt t) (o E3 ESq G (p G Qt) s3) pG3 e3) q3)
                       (IN.teTr E3 Qt3 Sg3 PS3 e2)))))) ;
    fo2 : Ov E3 EQ2 VQ.App tau PA3 PAt (IN.fst EQ2 VQ.App VQ.Bl VQ.pv0) (IN.fst E3 PA3 TrS3 w2) =
      IN.fst-ov E3 EQ2 VQ.App VQ.Bl tau PA3 PAt TrS3 PBt PWt VQ.pv0 w2
        (IN.teAny E3 (subT E3 EQ2 SQ tau) Sg3 (subt E3 EQ2 SQ VQ.pv0 tau) w2 tePv PWt) ;
    WP : Ty K = wkT G PA PA ;
    zAt : Id (El E3 PA3) (trE E3 (subT E3 EQ2 VQ.App tau) PA3 PAt (subt E3 EQ2 VQ.App VQ.zA tau)) Pv3 =
      IN.teAny E3 (subT E3 EQ2 VQ.App tau) PA3 (subt E3 EQ2 VQ.App VQ.zA tau) Pv3
        (IN.teT E3 (subT E3 EQ2 VQ.App tau) (subT E3 EQ2 (subT EQ2 K WP VQ.p2) tau) PA3
           (subt E3 EQ2 VQ.App VQ.zA tau) (subt E3 EQ2 (subT EQ2 K WP VQ.p2) (subt EQ2 K WP (q G PA) VQ.p2) tau) Pv3
           (SV.teSub E3 EQ2 VQ.App (subT EQ2 K WP VQ.p2) VQ.zA (subt EQ2 K WP (q G PA) VQ.p2)
              (IN.teS EQ2 (subT EQ2 K WP VQ.p2) VQ.App (subt EQ2 K WP (q G PA) VQ.p2) VQ.zA
                 (IN.teTr EQ2 (subT EQ2 K WP VQ.p2) VQ.App
                    (sym (Ty EQ2) VQ.App (subT EQ2 K WP VQ.p2) (subT-o EQ2 K G PA (p G PA) VQ.p2))
                    (subt EQ2 K WP (q G PA) VQ.p2))) tau)
           (IN.teT E3 (subT E3 EQ2 (subT EQ2 K WP VQ.p2) tau) (subT E3 K WP (o E3 EQ2 K VQ.p2 tau)) PA3
              (subt E3 EQ2 (subT EQ2 K WP VQ.p2) (subt EQ2 K WP (q G PA) VQ.p2) tau) (subt E3 K WP (q G PA) (o E3 EQ2 K VQ.p2 tau)) Pv3
              (IN.teS E3 (subT E3 K WP (o E3 EQ2 K VQ.p2 tau)) (subT E3 EQ2 (subT EQ2 K WP VQ.p2) tau)
                 (subt E3 K WP (q G PA) (o E3 EQ2 K VQ.p2 tau)) (subt E3 EQ2 (subT EQ2 K WP VQ.p2) (subt EQ2 K WP (q G PA) VQ.p2) tau)
                 (IN.teSubtO E3 EQ2 K WP (q G PA) VQ.p2 tau))
              (IN.teT E3 (subT E3 K WP (o E3 EQ2 K VQ.p2 tau)) Y3 PA3
                 (subt E3 K WP (q G PA) (o E3 EQ2 K VQ.p2 tau)) (subt E3 K WP (q G PA) pp3) Pv3
                 (IN.teSubEq E3 K WP (q G PA) (o E3 EQ2 K VQ.p2 tau) pp3 e2t)
                 (IN.teTr E3 Y3 PA3 PY3 (subt E3 K WP (q G PA) pp3)))))
        PAt ;
    f2 : Id (El E3 PA3) (IN.fst E3 PA3 TrS3 w2) Pv3 =
      trans (El E3 PA3) (IN.fst E3 PA3 TrS3 w2)
        (trE E3 (subT E3 EQ2 VQ.App tau) PA3 PAt (subt E3 EQ2 VQ.App (IN.fst EQ2 VQ.App VQ.Bl VQ.pv0) tau)) Pv3
        (sym (El E3 PA3) (trE E3 (subT E3 EQ2 VQ.App tau) PA3 PAt (subt E3 EQ2 VQ.App (IN.fst EQ2 VQ.App VQ.Bl VQ.pv0) tau)) (IN.fst E3 PA3 TrS3 w2) fo2)
        (trans (El E3 PA3) (trE E3 (subT E3 EQ2 VQ.App tau) PA3 PAt (subt E3 EQ2 VQ.App (IN.fst EQ2 VQ.App VQ.Bl VQ.pv0) tau))
           (trE E3 (subT E3 EQ2 VQ.App tau) PA3 PAt (subt E3 EQ2 VQ.App VQ.zA tau)) Pv3
           (ap (El EQ2 VQ.App) (El E3 PA3) (\ v -> trE E3 (subT E3 EQ2 VQ.App tau) PA3 PAt (subt E3 EQ2 VQ.App v tau))
              (IN.fst EQ2 VQ.App VQ.Bl VQ.pv0) VQ.zA (IN.fst-pr EQ2 VQ.App VQ.Bl VQ.zA VQ.bB))
           zAt) ;
    -- the two elements are joined
    module CA = ClsAt[G, A, r, E3, pG3, a3] ;
    ef : El E3 (IJ.IdT E3 PA3 (IN.fst E3 PA3 TrS3 CA.w') (IN.fst E3 PA3 TrS3 w2)) =
      QT.idTr E3 PA3 ra3 (IN.fst E3 PA3 TrS3 CA.w') Pv3 (IN.fst E3 PA3 TrS3 w2)
        (sym (El E3 PA3) (IN.fst E3 PA3 TrS3 CA.w') ra3 CA.fstAt)
        (sym (El E3 PA3) (IN.fst E3 PA3 TrS3 w2) Pv3 f2) u3 ;
    pY3 : El (ext E3 PA3) (PU.isProp (ext E3 PA3) TrS3) =
      trE (ext E3 PA3) (subT (ext E3 PA3) K (PU.isProp K QQ.TrS) (lift E3 G PA pG3)) (PU.isProp (ext E3 PA3) TrS3)
        (PU.isProp-ov (ext E3 PA3) K QQ.TrS (lift E3 G PA pG3) TrS3 (refl TrS3))
        (subt (ext E3 PA3) K (PU.isProp K QQ.TrS) (tr.trProp K QQ.S) (lift E3 G PA pG3)) ;
    pS : El E3 (IJ.IdT E3 Sg3 CA.w' w2) = PPr.At[E3, PA3, TrS3].pairPath pY3 CA.w' w2 ef ;
    pth : El E3 (IJ.IdT E3 Qt3 e1 e2) = idBack E3 Qt3 Sg3 PS3 e1 e2 pS ;

    ----------------------------------------------------------------
    -- (3) and the assembly
    module Elim (P : Ty ESq) (pPr : El ESq (PU.isProp ESq P)) (h : El D (subT D ESq P clsS)) {
      Pf : Ty (ext E3 Qt3) = subT (ext E3 Qt3) ESq P (lift E3 G Qt pG3) ;
      at (e : El E3 Qt3) : Id (Ty E3) (subT E3 ESq P (extS E3 G Qt pG3 e)) (subT E3 (ext E3 Qt3) Pf (sec E3 Qt3 e)) =
        subT-o E3 (ext E3 Qt3) ESq P (lift E3 G Qt pG3) (sec E3 Qt3 e) ;
      h3 : El E3 (subT E3 ESq P (extS E3 G Qt pG3 e1)) =
        trE E3 (subT E3 D (subT D ESq P clsS) m3) (subT E3 ESq P (extS E3 G Qt pG3 e1))
          (trans (Ty E3) (subT E3 D (subT D ESq P clsS) m3) (subT E3 ESq P (o E3 D ESq clsS m3)) (subT E3 ESq P (extS E3 G Qt pG3 e1))
             (sym (Ty E3) (subT E3 ESq P (o E3 D ESq clsS m3)) (subT E3 D (subT D ESq P clsS) m3) (subT-o E3 D ESq P clsS m3))
             (ap (Sub E3 ESq) (Ty E3) (\ t -> subT E3 ESq P t) (o E3 D ESq clsS m3) (extS E3 G Qt pG3 e1) clsEq))
          (subt E3 D (subT D ESq P clsS) h m3) ;
      t3 : El E3 (subT E3 (ext E3 Qt3) Pf (sec E3 Qt3 e2)) =
        TR.trP E3 Qt3 Pf e1 e2 pth
          (trE E3 (subT E3 ESq P (extS E3 G Qt pG3 e1)) (subT E3 (ext E3 Qt3) Pf (sec E3 Qt3 e1)) (at e1) h3) ;
      b3 : El E3 (subT E3 ESq P s3) =
        trE E3 (subT E3 (ext E3 Qt3) Pf (sec E3 Qt3 e2)) (subT E3 ESq P s3)
          (trans (Ty E3) (subT E3 (ext E3 Qt3) Pf (sec E3 Qt3 e2)) (subT E3 ESq P (extS E3 G Qt pG3 e2)) (subT E3 ESq P s3)
             (sym (Ty E3) (subT E3 ESq P (extS E3 G Qt pG3 e2)) (subT E3 (ext E3 Qt3) Pf (sec E3 Qt3 e2)) (at e2))
             (ap (Sub E3 ESq) (Ty E3) (\ t -> subT E3 ESq P t) (extS E3 G Qt pG3 e2) s3
                (sym (Sub E3 ESq) s3 (extS E3 G Qt pG3 e2) s3eq)))
          t3 ;
      -- over G.PA.TrS
      P2 : Ty EQ2 = subT EQ2 ESq P UQ.pk ;
      XK : Ty KS = subT KS EQ2 P2 incS ;
      bK : El KS XK =
        U3.sect XK
          (trE E3 (subT E3 ESq P s3) (subT E3 KS XK U3.pk)
             (trans (Ty E3) (subT E3 ESq P s3) (subT E3 KS (subT KS ESq P sK) U3.pk) (subT E3 KS XK U3.pk)
                (subT-o E3 KS ESq P sK U3.pk)
                (ap (Ty KS) (Ty E3) (\ X -> subT E3 KS X U3.pk) (subT KS ESq P sK) XK (subT-o KS EQ2 ESq P UQ.pk incS)))
             b3) ;
      pP2 : El EQ2 (PU.isProp EQ2 P2) =
        trE EQ2 (subT EQ2 ESq (PU.isProp ESq P) UQ.pk) (PU.isProp EQ2 P2) (PU.isProp-ov EQ2 ESq P UQ.pk P2 (refl P2))
          (subt EQ2 ESq (PU.isProp ESq P) pPr UQ.pk) ;
      sec2 : El EQ2 P2 = tr.elim K QQ.S P2 pP2 bK ;
      elimP : El ESq P = UQ.sect P sec2 ;
    } ;
  } ;

  -- elimination of the quotient into a family of propositions
  elimP (G : Ctx) (A : Ty G) (r : El G (Fun G A (Fun G A (PU.PropU G))))
    (P : Ty (ext G QT.Q[G, A, r].Qt)) (pPr : El (ext G QT.Q[G, A, r].Qt) (PU.isProp (ext G QT.Q[G, A, r].Qt) P))
    (h : El (ext G A) (subT (ext G A) (ext G QT.Q[G, A, r].Qt) P (extS (ext G A) G QT.Q[G, A, r].Qt (p G A) QT.Q[G, A, r].cls)))
    : El (ext G QT.Q[G, A, r].Qt) P = Ctxs[G, A, r].Elim[P, pPr, h].elimP ;
} ;
