-- CPshUTrivSub.seg (canonicity-45; COBAR.md "Plan: Theorem 29", M5): a
-- uniform trivial fibrancy (CPshC.UTriv) pulled back along a
-- C-substitution t : De -> G.  At x the base's CFibSub (CCart.Cart with
-- the substitution as the cartesian map) moves the ContrOp of T_x to
-- T_x[t_x]: the extension of a side is the extension in T of the side
-- read in T (kopMv).  Uniform in C: the moved extension read in T is the
-- extension of the moved side, which is the side read in T moved by T's
-- action (the two readings agree by CPshL.SC.rBtE, over t's naturality);
-- then T's own uniformity.
--   subUTriv De G t T ut : UTriv De T[t]
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;

module UTrivSubOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 open P ;

 module US (De G : CCtx) (t : CSub[De, G]) (T : CTy[G]) (ut : UTriv G T) {
  module SCT = LO.SC[De, G, t, T] ;
  T' : CTy[De] = LO.subCTy De G t T ;
  module FSx (x : CO) { module F = PB.CFibSub[l].FibSub[De.ob x, G.ob x, t.sb x, T.ty x] ; } ;
  -- the moved contractibility structure at x
  c (x : CO) : CP.ContrOp (De.ob x) (T'.ty x) = FSx[x].F.C.moveContr (ut.1 x) ;

  module At (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((De.ob x).ob X)) (s : CP.Partials[De.ob x, T'.ty x].Side[X, g]) {
   gy : W0.Ix ((De.ob y).ob X) = (De.act y x f).nt X g ;
   sy : CP.Partials[De.ob y, T'.ty y].Side[X, gy] = MapSide[De, T', y, x, f].mapside X g s ;
   -- the sides read in T, at x and at y
   sG : CP.Partials[G.ob x, T.ty x].Side[X, (t.sb x).nt X g] = FSx[x].F.C.mside (ut.1 x) X g s ;
   sGy : CP.Partials[G.ob y, T.ty y].Side[X, (t.sb y).nt X gy] = FSx[y].F.C.mside (ut.1 y) X gy sy ;
   -- the side read in T at x, moved by T's action
   sGm : CP.Partials[G.ob y, T.ty y].Side[X, (G.act y x f).nt X ((t.sb x).nt X g)] = MapSide[G, T, y, x, f].mapside X ((t.sb x).nt X g) sG ;
   pe : Id (W0.Ix ((G.ob y).ob X)) ((G.act y x f).nt X ((t.sb x).nt X g)) ((t.sb y).nt X gy) = symH (t.sb-nat y x f X g) ;
   -- the moved reading is the reading of the moved side
   sEq : Id (CP.Partials[G.ob y, T.ty y].Side[X, (t.sb y).nt X gy])
           (subst (W0.Ix ((G.ob y).ob X)) (\ z -> CP.Partials[G.ob y, T.ty y].Side[X, z]) ((G.act y x f).nt X ((t.sb x).nt X g)) ((t.sb y).nt X gy) pe sGm) sGy =
    CP.Partials[G.ob y, T.ty y].side-extH X ((G.act y x f).nt X ((t.sb x).nt X g)) ((t.sb y).nt X gy) pe sGm sGy (refl s.pQ)
     (\ W h i i' -> transH (apH (\ v -> (T.tE y x f).nt W (FSx[x].F.SE.mV W v)) (CP.Partials[De.ob x, T'.ty x].pv-irr X g s W h i i'))
                     (symH (SCT.rBtE y x f W (s.pv W h i')))) ;
   opaque sEq ;
   -- the extension in T at a point and a side
   Kp (z : W0.Ix ((G.ob y).ob X)) (sd : CP.Partials[G.ob y, T.ty y].Side[X, z]) : SigT (G.ob y) (T.ty y) X =
    pairE (G.ob y) (T.ty y) X z ((ut.1 y).kop X z sd) ;
   kpEq : Id (SigT (G.ob y) (T.ty y) X) (Kp ((G.act y x f).nt X ((t.sb x).nt X g)) sGm) (Kp ((t.sb y).nt X gy) sGy) =
    idJ (W0.Ix ((G.ob y).ob X)) ((G.act y x f).nt X ((t.sb x).nt X g))
     (\ z2 P2 -> (sd2 : CP.Partials[G.ob y, T.ty y].Side[X, z2])
        -> Id (CP.Partials[G.ob y, T.ty y].Side[X, z2]) (subst (W0.Ix ((G.ob y).ob X)) (\ z -> CP.Partials[G.ob y, T.ty y].Side[X, z]) ((G.act y x f).nt X ((t.sb x).nt X g)) z2 P2 sGm) sd2
        -> Id (SigT (G.ob y) (T.ty y) X) (Kp ((G.act y x f).nt X ((t.sb x).nt X g)) sGm) (Kp z2 sd2))
     (\ sd2 E2 -> apH (Kp ((G.act y x f).nt X ((t.sb x).nt X g))) E2)
     ((t.sb y).nt X gy) pe sGy sEq ;
   opaque kpEq ;
   -- the uniformity equation, by the point and the reading in T
   res : Id (SigT (De.ob y) (T'.ty y) X)
           ((T'.tE y x f).nt X (pairE (De.ob x) (T'.ty x) X g ((c x).kop X g s)))
           (pairE (De.ob y) (T'.ty y) X gy ((c y).kop X gy sy)) =
    SCT.sub-eq y X ((T'.tE y x f).nt X (pairE (De.ob x) (T'.ty x) X g ((c x).kop X g s))) (pairE (De.ob y) (T'.ty y) X gy ((c y).kop X gy sy))
     (refl gy)
     (transH (SCT.rBtE y x f X (pairE (De.ob x) (T'.ty x) X g ((c x).kop X g s)))
      (transH (apH ((T.tE y x f).nt X) (FSx[x].F.C.kopMv (ut.1 x) X g s))
       (transH (ut.2 y x f X ((t.sb x).nt X g) sG)
        (transH kpEq (symH (FSx[y].F.C.kopMv (ut.1 y) X gy sy)))))) ;
   opaque res ;
  } ;
  res : UTriv De T' = (c, \ y x f X g s -> At[y, x, f, X, g, s].res) ;
 } ;

 subUTriv (De G : CCtx) (t : CSub[De, G]) (T : CTy[G]) (ut : UTriv G T) : UTriv De (LO.subCTy De G t T) = US[De, G, t, T, ut].res ;
} ;
