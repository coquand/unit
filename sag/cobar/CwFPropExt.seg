-- CwFPropExt.seg (canonicity-c2; SIMPLIFIED.md item 2c): propositional
-- extensionality from the universe's univalence, in a CwF with Pi,
-- Sigma, Swan Id and a universe with UaContr.
--
-- Informal text.  Let a , b be codes whose decodings A , B are
-- propositions, with maps f : A -> B and g : B -> A.
-- (1) propPath: two elements of a proposition are joined (the two
--     applications of the element of isProp, read at the points).
-- (2) isProp is stable under weakening (wkProp), so over G.B the
--     elements f (g y) and y of B are joined: a homotopy f g ~ id
--     (htpyP), and likewise g f ~ id.
-- (3) So (f , g , g) is an element e of Equiv(A , B) (CwFEqP.mkE).
-- (4) CwFUaEq's inverse of idtoeqv, read at (b , e), is an element of
--     Id(a , b).
open Base ;

module PropExt (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (UA : CwFU.UnivUa[l, C, PS, SS, IJ, Un].UaStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module EQ = CwFEq.Eqv[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module SG = CwFSing.Sing[l, C, PS, SS, IJ] ;
  module EP = CwFEqP.EqP[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module UE = CwFUaEq.UaEq[l, C, PS, SS, IJ, Un, UA] ;

  -- a homotopy u v ~ id when the codomain is a proposition
  htpyP (G : Ctx) (X Y : Ty G) (pY : El G (PU.isProp G Y)) (u : El G (Fun G X Y)) (v : El G (Fun G Y X))
    : El G (EQ.Htpy G X Y u v) =
    lam G Y
      (IJ.IdT (ext G Y) (wkT G Y Y)
         (app (ext G Y) (wkT G Y X) (wkT G Y Y) (EQ.wkF G Y X Y u)
            (app (ext G Y) (wkT G Y Y) (wkT G Y X) (EQ.wkF G Y Y X v) (q G Y)))
         (q G Y))
      (PU.propPath (ext G Y) (wkT G Y Y) (PU.wkProp G Y Y pY)
         (app (ext G Y) (wkT G Y X) (wkT G Y Y) (EQ.wkF G Y X Y u)
            (app (ext G Y) (wkT G Y Y) (wkT G Y X) (EQ.wkF G Y Y X v) (q G Y)))
         (q G Y)) ;

  -- (3) maps both ways between propositions: an equivalence
  eqvP (G : Ctx) (A B : Ty G) (pa : El G (PU.isProp G A)) (pb : El G (PU.isProp G B))
    (f : El G (Fun G A B)) (g : El G (Fun G B A)) : El G (EQ.Equiv G A B) =
    EP.mkE G A B f g (htpyP G A B pb f g) g (htpyP G B A pa g f) ;

  -- (4) propositional extensionality
  module Ext (G : Ctx) (a b : El G (Un.Cod G)) (pa : El G (PU.isProp G (Un.Dec G a))) (pb : El G (PU.isProp G (Un.Dec G b)))
    (f : El (ext G (Un.Dec G a)) (wkT G (Un.Dec G a) (Un.Dec G b)))
    (g : El (ext G (Un.Dec G b)) (wkT G (Un.Dec G b) (Un.Dec G a))) {
    module Ata = UE.At[G, a] ;
    A : Ty G = Un.Dec G a ;
    B : Ty G = Un.Dec G b ;
    e : El G (EQ.Equiv G A B) = eqvP G A B pa pb (lam G A (wkT G A B) f) (lam G B (wkT G B A) g) ;
    gb : El G (Fun G (EQ.Equiv G A B) (IJ.IdT G (Un.Cod G) a b)) =
      trE G (subT G Ata.K (Fun Ata.K Ata.P Ata.IKa) (sec G (Un.Cod G) b)) (Fun G (EQ.Equiv G A B) (IJ.IdT G (Un.Cod G) a b))
        (Fun-ov G Ata.K Ata.P Ata.IKa (sec G (Un.Cod G) b) (EQ.Equiv G A B) (UE.PB-pt G a b)
           (IJ.IdT G (Un.Cod G) a b) (JP.IKpt G (Un.Cod G) a b))
        (subt G Ata.K (Fun Ata.K Ata.P Ata.IKa) Ata.g (sec G (Un.Cod G) b)) ;
    res : El G (IJ.IdT G (Un.Cod G) a b) = app G (EQ.Equiv G A B) (IJ.IdT G (Un.Cod G) a b) gb e ;
  } ;
  propExt : PU.PropExtTy = \ G a b pa pb f g -> Ext[G, a, b, pa, pb, f, g].res ;
} ;
