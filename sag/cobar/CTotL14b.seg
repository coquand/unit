-- CTotL14b.seg (canonicity-45; SIMPLIFIED.md step 4): Lemma 14 at the
-- total site, part b: at the levelwise site (GrothOf[disc], through the
-- restriction U along CDisc's functor), the unit U tau_A : U A -> U B and
-- the inverse eps : U B -> U A, where B is D A pulled back along tau_G.
--   tauN       an NMap over U G (naturality: TauA's, for any point equation)
--   q0, l0     the index (0, I, id, x, vpart id, (1)) at (I, x)
--   pth        tau g read at q0 is g (tmap-eq, vpart-eq, act-id)
--   ev         eps: read at q0, moved along pth
--   et-pt      eps (tau av) = av (E's act-id at the identity total map)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;

-- the weight (1) at n = 0, and its restriction
one0 (W : Ob) : Wt.Pn zero W =
 (\ k -> PB.ptH W PB.e1,
  PB.bigU-in W W (suc zero) (\ k -> PB.pre W PFO.ivO (PB.ptH W PB.e1) (PFO.ptSO PB.e1)) (PB.idH W) (zero, refl true)
   (PB.pre-lands W W PFO.ivO (PB.ptH W PB.e1) (PFO.ptSO PB.e1) (PB.idH W)
     (PB.lands-eq W PFO.ivO (PFO.ptSO PB.e1) (PB.ptH W PB.e1) (PB.compH W W PFO.ivO (PB.ptH W PB.e1) (PB.idH W))
        (symH (PB.comp-idr W PFO.ivO (PB.ptH W PB.e1))) (PFO.pt-landsO W PB.e1)))) ;

module L14b (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module TA = CTotL14a[a, vl, l].TauA[C, G, A] ;
 module TC = TA.TC ;
 module P = TA.P ;
 module VT = TA.VT ;
 module DA = TA.DA ;
 module D = TA.D ;
 module DE = TA.DE ;
 E : P.PCtx = TA.E ;
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G0 = TR.G0 ;
 module RS = TR.RS ;
 module HO = G0.GB.CHtpyOps[l] ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 GP : P.PCtx = TC.toP G ;
 Bt : P.PTy[GP] = P.subTy GP (TC.toP D.DCtx) DA.DTy (TC.toPS G D.DCtx D.tauS) ;
 UG : RS.P0.PCtx = RS.rC GP ;
 UA : RS.P0.PTy[UG] = RS.rT GP A ;
 UB : RS.P0.PTy[UG] = RS.rT GP Bt ;

 ------------------------------------------------------------------
 -- the unit, for any point equation
 module NatE (J0 I : Ob) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y x) (g : W0.Ix (G.ob I x)) (av : W0.Ix (A.tob (I, x) g)) {
  pr : W0.Ix (E.ob (I, x)) = P.pairE GP A (I, x) g av ;
  law (g' : W0.Ix (G.ob J0 y)) (e : Id (W0.Ix (G.ob J0 y)) (G.act J0 I u0 y x f0 g) g') (e0 : Id (D.Ob' J0 y) (D.act J0 I u0 y x f0 (D.tau I x g)) (D.tau J0 y g'))
   : Id (DA.TOb' J0 y (D.tau J0 y g')) (DA.TB[J0, I, u0, y, x, f0, D.tau I x g, D.tau J0 y g', e0, TA.tauA I x g av].res)
        (TA.tauA J0 y g' (A.tact (J0, y) (I, x) (u0, f0) g g' e av)) =
   idJ (W0.Ix (G.ob J0 y)) (G.act J0 I u0 y x f0 g)
    (\ g2 e2 -> (e3 : Id (D.Ob' J0 y) (D.act J0 I u0 y x f0 (D.tau I x g)) (D.tau J0 y g2))
       -> Id (DA.TOb' J0 y (D.tau J0 y g2)) (DA.TB[J0, I, u0, y, x, f0, D.tau I x g, D.tau J0 y g2, e3, TA.tauA I x g av].res)
             (TA.tauA J0 y g2 (A.tact (J0, y) (I, x) (u0, f0) g g2 e2 av)))
    (\ e3 -> DA.tob-eq J0 y (D.tau J0 y (G.act J0 I u0 y x f0 g)) (DA.TB[J0, I, u0, y, x, f0, D.tau I x g, D.tau J0 y (G.act J0 I u0 y x f0 g), e3, TA.tauA I x g av].res)
              (TA.tauA J0 y (G.act J0 I u0 y x f0 g) (A.tact (J0, y) (I, x) (u0, f0) g (G.act J0 I u0 y x f0 g) (refl (G.act J0 I u0 y x f0 g)) av)) (\ q l ->
       DA.pr-inj q.2.1 q.2.2.2.1 ((D.tau J0 y (G.act J0 I u0 y x f0 g)).1 q l)
        (DA.TB[J0, I, u0, y, x, f0, D.tau I x g, D.tau J0 y (G.act J0 I u0 y x f0 g), e3, TA.tauA I x g av].a' q l)
        (TA.tv J0 y (G.act J0 I u0 y x f0 g) (A.tact (J0, y) (I, x) (u0, f0) g (G.act J0 I u0 y x f0 g) (refl (G.act J0 I u0 y x f0 g)) av) q l)
        (transH (DA.TB[J0, I, u0, y, x, f0, D.tau I x g, D.tau J0 y (G.act J0 I u0 y x f0 g), e3, TA.tauA I x g av].pc q l)
          (apH {DE.Ob' J0 y} {DA.Ez q.2.1 q.2.2.2.1} (\ d -> d.1 q l) (symH (DE.tau-nat J0 I u0 y x f0 pr))))))
    g' e e0 ;
 } ;
 tauN : HO.NMap[UG, UA, UB] =
  new HO.NMap[UG, UA, UB, \ X g av -> TA.tauA X.1 X.2 g av,
   \ Y X h g g' e av -> NatE[Y.1, X.1, (TR.DS.fnH Y X h).1, Y.2, X.2, (TR.DS.fnH Y X h).2, g, av].law g' e
     (P.ntEq GP (TC.toP D.DCtx) (TC.toPS G D.DCtx D.tauS) Y X (TR.DS.fnH Y X h) g g' e)] ;

 ------------------------------------------------------------------
 -- eps: read at the identity chain with the weight (1)
 module EP (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) {
  c0 : VT.VMap I x (C.res I I (idH I) x) = VT.vpart I I (idH I) x x (C.idD I x) ;
  q0 : DA.Idx I x = (zero, I, idH I, x, c0, (one0 I).1) ;
  l0 : DA.LandsI I x q0 = (one0 I).2 ;
  -- the total map of q0 is the identity
  tm : Id (VT.TH I x I x) (idH I, D.tmap I x zero I (idH I) x c0) (idH I, C.idD I x) =
   transH (D.tmap-eq I x zero I (idH I) x c0) (VT.vpart-eq I I (idH I) x x (C.idD I x)) ;
  pth : Id (W0.Ix (G.ob I x)) ((D.tau I x g).1 q0 l0) g =
   transH (apH {VT.TH I x I x} {W0.Ix (G.ob I x)} (\ h -> D.actT I x I x h g) tm) (G.act-id I x g) ;
  ev (u : DA.TOb' I x (D.tau I x g)) : W0.Ix (A.tob (I, x) g) =
   DA.coeT I x ((D.tau I x g).1 q0 l0) g pth (u.1 q0 l0) ;
  epc (u : DA.TOb' I x (D.tau I x g))
   : Id (DA.Ez I x) (DA.prz I x g (ev u)) (DA.prz I x ((D.tau I x g).1 q0 l0) (u.1 q0 l0)) =
   symH (DA.pr-coe I x ((D.tau I x g).1 q0 l0) g pth (u.1 q0 l0)) ;
  -- eps tau = id
  et (av : W0.Ix (A.tob (I, x) g)) : Id (W0.Ix (A.tob (I, x) g)) (ev (TA.tauA I x g av)) av =
   DA.pr-inj I x g (ev (TA.tauA I x g av)) av
    (transH (epc (TA.tauA I x g av))
      (transH (apH {VT.TH I x I x} {DA.Ez I x} (\ h -> E.act (I, x) (I, x) h (P.pairE GP A (I, x) g av)) tm)
        (E.act-id (I, x) (P.pairE GP A (I, x) g av)))) ;
 } ;
} ;
