-- CCmpK20.seg (canonicity-c2; (K) for cmpI, part 20): the body context of
-- stage 2, Cb = nil.Q.S.X2.H2.S1' (q2, (t2, e2), g, h, s1) as the lift of
-- K19's C3 along nil.Q.S -> nil.Q, and its components as elements.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module K20 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module K19m = CCmpK19[a].K19[R, encK, pe, y] ;
 module K12m = K19m.K12m ;
 module QS = K19m.QS ;
 Nl : C.Ctx = C.nil ;
 Q : C.Ty Nl = K19m.Q ;
 HTT : C.Ty Nl = K19m.HTT ;
 Tm : C.Ty Nl = QS.Tm ;
 G1 : C.Ctx = K19m.G1 ;
 E2 : C.Ctx = C.ext G1 QS.S ;
 pE2 : C.Sub E2 G1 = C.p G1 QS.S ;
 D1 : C.Ctx = C.ext E2 (C.subT E2 G1 K19m.X2 pE2) ;
 l1 : C.Sub D1 K19m.C1 = C.lift E2 G1 K19m.X2 pE2 ;
 D2 : C.Ctx = C.ext D1 (C.subT D1 K19m.C1 K19m.H2 l1) ;
 l2 : C.Sub D2 K19m.C2 = C.lift D1 K19m.C1 K19m.H2 l1 ;
 Cb : C.Ctx = C.ext D2 (C.subT D2 K19m.C2 K19m.S1' l2) ;
 l3 : C.Sub Cb K19m.C3 = C.lift D2 K19m.C2 K19m.S1' l2 ;
 s0bN (K : Ob) (w : V1.Ix (Cb.ob K)) : V1.Ix (Nl.ob K) = w.1.1.1.1.1 ;
 s0b : C.Sub Cb Nl = new L.PSub[Cb, Nl, s0bN, \ J I f w -> refl (s0bN J (Cb.act J I f w))] ;
 module CE (A : C.Ty Nl) (v : (K : Ob) (w : V1.Ix (Cb.ob K)) -> V1.Ix (A.1.tob K w.1.1.1.1.1))
   (vn : (J I : Ob) (f : Hom J I) (w : V1.Ix (Cb.ob I)) -> Id (V1.Ix (A.1.tob J w.1.1.1.1.1)) (A.1.tact J I f w.1.1.1.1.1 w.1.1.1.1.1 (refl w.1.1.1.1.1) (v I w)) (v J (Cb.act J I f w))) {
  AT : C.Ty Cb = C.subT Cb Nl A s0b ;
  nB (J I : Ob) (f : Hom J I) (w : V1.Ix (Cb.ob I)) : Id (V1.Ix (AT.1.tob J (Cb.act J I f w))) (AT.1.tact J I f w (Cb.act J I f w) (refl (Cb.act J I f w)) (v I w)) (v J (Cb.act J I f w)) =
   transH (L.tact-irr Nl A.1 J I f w.1.1.1.1.1 w.1.1.1.1.1 (L.ntEq Cb Nl s0b J I f w (Cb.act J I f w) (refl (Cb.act J I f w))) (refl w.1.1.1.1.1) (v I w)) (vn J I f w) ;
  el : C.El Cb AT = L.mkPEl Cb AT.1 v (\ J I f w w' e ->
   idJ (V1.Ix (Cb.ob J)) (Cb.act J I f w) (\ w2 e2 -> Id (V1.Ix (AT.1.tob J w2)) (AT.1.tact J I f w w2 e2 (v I w)) (v J w2)) (nB J I f w) w' e) ;
 } ;
 module CG = CE[HTT, \ K w -> w.1.1.2, \ J I f w -> refl (HTT.1.tact J I f w.1.1.1.1.1 w.1.1.1.1.1 (refl w.1.1.1.1.1) w.1.1.2)] ;
 module CT = CE[Tm, \ K w -> w.1.1.1.2.1, \ J I f w -> refl (Tm.1.tact J I f w.1.1.1.1.1 w.1.1.1.1.1 (refl w.1.1.1.1.1) w.1.1.1.2.1)] ;
 module CQ = CE[Q, \ K w -> w.1.1.1.1.2, \ J I f w -> refl (Q.1.tact J I f w.1.1.1.1.1 w.1.1.1.1.1 (refl w.1.1.1.1.1) w.1.1.1.1.2)] ;
 gEl : C.El Cb (C.subT Cb Nl HTT s0b) = CG.el ;
 tEl : C.El Cb (C.subT Cb Nl Tm s0b) = CT.el ;
 qEl : C.El Cb (C.subT Cb Nl Q s0b) = CQ.el ;
} ;
