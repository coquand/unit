-- CPshId.seg (canonicity-45; (B) stage 2(b), COBAR.md): Swan's identity
-- type in Yoneda form (PosIdY) as a C-type, with its C-action, its
-- naturality in C-substitutions and refl.
--   IdC[G, A, a, b]   IdT : CTy[G] with IdT.ty x = PosIdY.IdY[G.ob x, A.ty x,
--                     a.el x, b.el x].IdYT on the nose.  The C-action along
--                     f : y -> x sends an element w at (X, g) to the element
--                     at (X, g f) whose readings are A.tE of the readings of
--                     w (TC: uY by fromE along A.tE-pt and G.act's
--                     naturality; natY, mv as in PosIdY.Tact) and whose
--                     sieve is that of w.  rd-C, sieve-C, idC-eq (= tpY-ext)
--                     describe it completely.
--   IdNatC            Id(a , b)[s] = Id(a[s] , b[s]) as C-types: the base's
--                     IdYNat.nat at each x; the actions agree on readings
--                     (IdYNat.tr-rd) and sieves (tr-sq)
--   reflC             the constant path with the full sieve (FibIdRd.ReflY)
--                     at each x; C-natural by readings

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module PY = PosIdY[a, l] ;
module RD = FibIdRd[a, l] ;

module IdOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 open P ;

 -- a transport of a total along an equality of base types acts on the
 -- fibre by the equality of codes
 totTr (G0 : PCtx) (T T' : PTy[G0]) (Pf : Id (PTy[G0]) T T') (X : Ob) (w : SigT G0 T X)
  : Id (SigT G0 T' X) (subst (PTy[G0]) (\ T2 -> SigT G0 T2 X) T T' Pf w)
      (pairE G0 T' X (fstE G0 T X w) (subst W0.V (\ v -> W0.Ix v) (T.tob X (fstE G0 T X w)) (T'.tob X (fstE G0 T X w)) (apH (\ T2 -> T2.tob X (fstE G0 T X w)) Pf) (sndE G0 T X w))) =
  idJ (PTy[G0]) T (\ T2 P2 -> Id (SigT G0 T2 X) (subst (PTy[G0]) (\ T3 -> SigT G0 T3 X) T T2 P2 w)
                     (pairE G0 T2 X (fstE G0 T X w) (subst W0.V (\ v -> W0.Ix v) (T.tob X (fstE G0 T X w)) (T2.tob X (fstE G0 T X w)) (apH (\ T3 -> T3.tob X (fstE G0 T X w)) P2) (sndE G0 T X w))))
   (refl w) T' Pf ;

 ------------------------------------------------------------------
 -- the identity type of a C-type

 module IdC (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) {
  module Y (x : CO) { module I = PY.IdY[G.ob x, A.ty x, a0.el x, b0.el x] ; } ;
  module TA (x : CO) { module T = GPR.TyL[G.ob x, A.ty x] ; } ;
  ty (x : CO) : PTy[G.ob x] = Y[x].I.IdYT ;

  -- the C-action on an element
  module TC (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (w : W0.Ix (Y[x].I.tob X g)) {
   gy : W0.Ix ((G.ob y).ob X) = (G.act y x f).nt X g ;
   ptx (W : Ob) (h : Hom W X) : W0.Ix ((G.ob x).ob W) = Y[x].I.pt X g W h ;
   pty (W : Ob) (h : Hom W X) : W0.Ix ((G.ob y).ob W) = Y[y].I.pt X gy W h ;
   pi (W : Ob) (h : Hom W X) : Id (W0.Ix ((G.ob y).ob W)) ((G.act y x f).nt W (ptx W h)) (pty W h) = (G.act y x f).nt-nat W X h g ;
   -- the moved reading, and its point
   mr (W : Ob) (h : Hom W X) (j : Hom W Iv) : TA[y].T.EI W = (A.tE y x f).nt W (Y[x].I.rd X g w W h j) ;
   mr-pt (W : Ob) (h : Hom W X) (j : Hom W Iv) : Id (W0.Ix ((G.ob y).ob W)) (TA[y].T.pr1 W (mr W h j)) (pty W h) =
    transH (A.tE-pt y x f W (Y[x].I.rd X g w W h j)) (pi W h) ;
   uY (W : Ob) (h : Hom W X) (j : Hom W Iv) : W0.Ix ((A.ty y).tob W (pty W h)) = TA[y].T.fromE W (pty W h) (mr W h j) (mr-pt W h j) ;
   rdc (W : Ob) (h : Hom W X) (j : Hom W Iv) : Id (TA[y].T.EI W) (TA[y].T.pr W (pty W h) (uY W h j)) (mr W h j) =
    TA[y].T.fromE-eq W (pty W h) (mr W h j) (mr-pt W h j) ;
   natY (V W : Ob) (g' : Hom V W) (h : Hom W X) (j : Hom W Iv)
    : Id (W0.Ix ((A.ty y).tob V (pty V (compH V W X h g'))))
        ((A.ty y).tact V W g' (pty W h) (pty V (compH V W X h g')) (Y[y].I.ptn X gy V W g' h) (uY W h j))
        (uY V (compH V W X h g') (compH V W Iv j g')) =
    TA[y].T.pr-inj V (pty V (compH V W X h g'))
     ((A.ty y).tact V W g' (pty W h) (pty V (compH V W X h g')) (Y[y].I.ptn X gy V W g' h) (uY W h j))
     (uY V (compH V W X h g') (compH V W Iv j g'))
     (calc (TA[y].T.EI V) {
         TA[y].T.pr V (pty V (compH V W X h g')) ((A.ty y).tact V W g' (pty W h) (pty V (compH V W X h g')) (Y[y].I.ptn X gy V W g' h) (uY W h j))
       =< symH (TA[y].T.pr-tact V W g' (pty W h) (pty V (compH V W X h g')) (Y[y].I.ptn X gy V W g' h) (uY W h j)) >
         TA[y].T.E.act V W g' (TA[y].T.pr W (pty W h) (uY W h j))
       =< apH (TA[y].T.E.act V W g') (rdc W h j) >
         TA[y].T.E.act V W g' ((A.tE y x f).nt W (Y[x].I.rd X g w W h j))
       =< symH ((A.tE y x f).nt-nat V W g' (Y[x].I.rd X g w W h j)) >
         (A.tE y x f).nt V (TA[x].T.E.act V W g' (Y[x].I.rd X g w W h j))
       =< apH ((A.tE y x f).nt V) (Y[x].I.rd-nat X g w V W g' h j) >
         mr V (compH V W X h g') (compH V W Iv j g')
       =< symH (rdc V (compH V W X h g') (compH V W Iv j g')) >
         TA[y].T.pr V (pty V (compH V W X h g')) (uY V (compH V W X h g') (compH V W Iv j g')) }) ;
   -- a condition u W h j = c (g h), moved
   mv (c : CEl[G, A]) (W : Ob) (h : Hom W X) (j : Hom W Iv)
    (E : Id (W0.Ix ((A.ty x).tob W (ptx W h))) (w.1.1 W h j) ((c.el x).eob W (ptx W h)))
    : Id (W0.Ix ((A.ty y).tob W (pty W h))) (uY W h j) ((c.el y).eob W (pty W h)) =
    TA[y].T.pr-inj W (pty W h) (uY W h j) ((c.el y).eob W (pty W h))
     (transH (rdc W h j)
       (transH (apH ((A.tE y x f).nt W) (apH (TA[x].T.pr W (ptx W h)) E))
         (transH (c.el-nat y x f W (ptx W h))
           (apH (\ y1 -> TA[y].T.pr W y1 ((c.el y).eob W y1)) (pi W h))))) ;
   res : W0.Ix (Y[y].I.tob X gy) =
    ((uY, (natY, (\ W h -> mv a0 W h (PB.ptH W e0) (w.1.2.2.1 W h), \ W h -> mv b0 W h (PB.ptH W e1) (w.1.2.2.2 W h)))),
     (w.2.1, \ W h i j -> mv a0 W h j (w.2.2 W h i j))) ;
   -- its readings are the moved readings of w
   rd-res (W : Ob) (h : Hom W X) (j : Hom W Iv) : Id (TA[y].T.EI W) (Y[y].I.rd X gy res W h j) (mr W h j) = rdc W h j ;
  } ;
  tEn (y x : CO) (f : CH y x) (X : Ob) (v : SigT (G.ob x) (ty x) X) : SigT (G.ob y) (ty y) X =
   pairE (G.ob y) (ty y) X ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v)) (TC[y, x, f, X, fstE (G.ob x) (ty x) X v, sndE (G.ob x) (ty x) X v].res) ;

  -- the readings and the sieve of a moved element
  rd-C (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (w : W0.Ix (Y[x].I.tob X g)) (W : Ob) (h : Hom W X) (j : Hom W Iv)
   : Id (TA[y].T.EI W) (Y[y].I.rd X ((G.act y x f).nt X g) (TC[y, x, f, X, g, w].res) W h j) ((A.tE y x f).nt W (Y[x].I.rd X g w W h j)) =
   TC[y, x, f, X, g, w].rdc W h j ;
  sieve-C (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (w : W0.Ix (Y[x].I.tob X g))
   : Id (PB.Phi X) (TC[y, x, f, X, g, w].res).2.1 w.2.1 = refl w.2.1 ;
  -- two elements at x with the same point, the same readings and the same sieve are equal
  idC-eq (x : CO) (X : Ob) (z z' : SigT (G.ob x) (ty x) X) (Pt : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (ty x) X z) (fstE (G.ob x) (ty x) X z'))
   (q : (V : Ob) (h : Hom V X) (j : Hom V Iv) -> Id (TA[x].T.EI V) (Y[x].I.rd X (fstE (G.ob x) (ty x) X z) (sndE (G.ob x) (ty x) X z) V h j) (Y[x].I.rd X (fstE (G.ob x) (ty x) X z') (sndE (G.ob x) (ty x) X z') V h j))
   (Q : Id (PB.Phi X) (sndE (G.ob x) (ty x) X z).2.1 (sndE (G.ob x) (ty x) X z').2.1) : Id (SigT (G.ob x) (ty x) X) z z' =
   Y[x].I.tpY-ext X z z' Pt q Q ;

  -- the C-action is natural in X
  tEnP (y x : CO) (f : CH y x) : PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y)] =
   new PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y), tEn y x f,
    \ V X h v -> idC-eq y V (tEn y x f V ((extP (G.ob x) (ty x)).act V X h v)) ((extP (G.ob y) (ty y)).act V X h (tEn y x f X v))
       ((G.act y x f).nt-nat V X h (fstE (G.ob x) (ty x) X v))
       (\ V' h' j ->
        transH (rd-C y x f V (fstE (G.ob x) (ty x) V ((extP (G.ob x) (ty x)).act V X h v)) (sndE (G.ob x) (ty x) V ((extP (G.ob x) (ty x)).act V X h v)) V' h' j)
         (transH (apH ((A.tE y x f).nt V')
                    (Y[x].I.Tact[V, X, h, fstE (G.ob x) (ty x) X v, (G.ob x).act V X h (fstE (G.ob x) (ty x) X v), refl ((G.ob x).act V X h (fstE (G.ob x) (ty x) X v)), sndE (G.ob x) (ty x) X v].rdc V' h' j))
           (transH (symH (rd-C y x f X (fstE (G.ob x) (ty x) X v) (sndE (G.ob x) (ty x) X v) V' (compH V' V X h h') j))
             (symH (Y[y].I.Tact[V, X, h, (G.act y x f).nt X (fstE (G.ob x) (ty x) X v), (G.ob y).act V X h ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v)), refl ((G.ob y).act V X h ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v))), TC[y, x, f, X, fstE (G.ob x) (ty x) X v, sndE (G.ob x) (ty x) X v].res].rdc V' h' j)))))
       (refl (PB.pre V X h (sndE (G.ob x) (ty x) X v).2.1))] ;

  IdT : CTy[G] =
   new CTy[G, ty, tEnP,
    \ y x f X v -> refl ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v)),
    \ x X v -> idC-eq x X (tEn x x (cid x) X v) v (G.act-id x X (fstE (G.ob x) (ty x) X v))
       (\ V h j -> transH (rd-C x x (cid x) X (fstE (G.ob x) (ty x) X v) (sndE (G.ob x) (ty x) X v) V h j)
                    (A.tE-id x V (Y[x].I.rd X (fstE (G.ob x) (ty x) X v) (sndE (G.ob x) (ty x) X v) V h j)))
       (refl (sndE (G.ob x) (ty x) X v).2.1),
    \ z y x f h X v -> idC-eq z X (tEn z x (co z y x f h) X v) (tEn z y h X (tEn y x f X v)) (G.act-o z y x f h X (fstE (G.ob x) (ty x) X v))
       (\ V h' j -> transH (rd-C z x (co z y x f h) X (fstE (G.ob x) (ty x) X v) (sndE (G.ob x) (ty x) X v) V h' j)
                     (transH (A.tE-o z y x f h V (Y[x].I.rd X (fstE (G.ob x) (ty x) X v) (sndE (G.ob x) (ty x) X v) V h' j))
                       (transH (apH ((A.tE z y h).nt V) (symH (rd-C y x f X (fstE (G.ob x) (ty x) X v) (sndE (G.ob x) (ty x) X v) V h' j)))
                         (symH (rd-C z y h X ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v)) (TC[y, x, f, X, fstE (G.ob x) (ty x) X v, sndE (G.ob x) (ty x) X v].res) V h' j)))))
       (refl (sndE (G.ob x) (ty x) X v).2.1)] ;
 } ;

 ------------------------------------------------------------------
 -- transports along equalities of codes

 trV-irr (v v' : W0.V) (c c' : Id W0.V v v') (u : W0.Ix v) : Id (W0.Ix v') (subst W0.V (\ z -> W0.Ix z) v v' c u) (subst W0.V (\ z -> W0.Ix z) v v' c' u) =
  apH (\ q -> subst W0.V (\ z -> W0.Ix z) v v' q u) (W0.isSetV v v' c c') ;

 ------------------------------------------------------------------
 -- Id(a , b)[s] = Id(a[s] , b[s]) as C-types

 module IdNatC (D G : CCtx) (s : CSub[D, G]) (A : CTy[G]) (a0 b0 : CEl[G, A]) {
  module IG = IdC[G, A, a0, b0] ;
  -- the Id at D is instantiated at the CwF record's own spelling of A[s], a[s], b[s]
  module ID = IdC[D, CW.CPCwF.subT D G A s, CW.CPCwF.subt D G A a0 s, CW.CPCwF.subt D G A b0 s] ;
  module SCI = LO.SC[D, G, s, IG.IdT] ;
  module SCA = LO.SC[D, G, s, A] ;
  module SE (x : CO) { module M = PB.CSub[l].SubE[D.ob x, G.ob x, s.sb x, A.ty x] ; } ;
  -- a moved element of A[s], read in A, is the moved reading
  rBm (y x : CO) (f : CH y x) (W : Ob) (v : SigT (D.ob x) (SCA.ST x) W)
   : Id (SigT (G.ob y) (A.ty y) W) (SE[y].M.mV W (SCA.tEs y x f W v)) ((A.tE y x f).nt W (SE[x].M.mV W v)) = SCA.rBtE y x f W v ;
  opaque rBm ;
  module N (x : CO) {
   module M = PY.IdYNat[D.ob x, G.ob x, s.sb x, A.ty x, a0.el x, b0.el x] ;
  } ;
  Pf (x : CO) : Id (PTy[D.ob x]) (SCI.ST x) (ID.ty x) = N[x].M.nat ;
  opaque Pf ;

  -- the transport along Pf x of a fibre element is IdYNat's tr
  trEq (x : CO) (X : Ob) (g : W0.Ix ((D.ob x).ob X)) (u : W0.Ix ((SCI.ST x).tob X g))
   : Id (W0.Ix ((ID.ty x).tob X g))
      (subst W0.V (\ v -> W0.Ix v) ((SCI.ST x).tob X g) ((ID.ty x).tob X g) (apH (\ T2 -> T2.tob X g) (Pf x)) u)
      (N[x].M.tr X g u) =
   transH (trV-irr ((SCI.ST x).tob X g) ((ID.ty x).tob X g) (apH (\ T2 -> T2.tob X g) (Pf x)) (apH (\ o -> o X g) N[x].M.P') u)
     (symH (subst-ap (TOb (D.ob x)) W0.V (\ o -> o X g) (\ v -> W0.Ix v) (SCI.ST x).tob (ID.ty x).tob N[x].M.P' u)) ;
  opaque trEq ;
  -- the transported total
  trT (x : CO) (X : Ob) (w : SigT (D.ob x) (SCI.ST x) X)
   : Id (SigT (D.ob x) (ID.ty x) X) (subst (PTy[D.ob x]) (\ T2 -> SigT (D.ob x) T2 X) (SCI.ST x) (ID.ty x) (Pf x) w)
       (pairE (D.ob x) (ID.ty x) X (fstE (D.ob x) (SCI.ST x) X w) (N[x].M.tr X (fstE (D.ob x) (SCI.ST x) X w) (sndE (D.ob x) (SCI.ST x) X w))) =
   transH (totTr (D.ob x) (SCI.ST x) (ID.ty x) (Pf x) X w)
    (apH (pairE (D.ob x) (ID.ty x) X (fstE (D.ob x) (SCI.ST x) X w)) (trEq x X (fstE (D.ob x) (SCI.ST x) X w) (sndE (D.ob x) (SCI.ST x) X w))) ;
  opaque trT ;

  -- readings of a total of Id(a , b) at G, as a function of the total
  rdG (x : CO) (X : Ob) (z : SigT (G.ob x) (IG.ty x) X) (W : Ob) (h : Hom W X) (j : Hom W Iv) : IG.TA[x].T.EI W =
   IG.Y[x].I.rd X (fstE (G.ob x) (IG.ty x) X z) (sndE (G.ob x) (IG.ty x) X z) W h j ;
  sqG (x : CO) (X : Ob) (z : SigT (G.ob x) (IG.ty x) X) : PB.Phi X = (sndE (G.ob x) (IG.ty x) X z).2.1 ;

  module Q (y x : CO) (f : CH y x) (X : Ob) (w : SigT (D.ob x) (SCI.ST x) X) {
   g : W0.Ix ((D.ob x).ob X) = fstE (D.ob x) (SCI.ST x) X w ;
   u : W0.Ix ((SCI.ST x).tob X g) = sndE (D.ob x) (SCI.ST x) X w ;
   gy : W0.Ix ((D.ob y).ob X) = (D.act y x f).nt X g ;
   -- the left side: the moved transported element
   L : SigT (D.ob y) (ID.ty y) X = ID.tEn y x f X (pairE (D.ob x) (ID.ty x) X g (N[x].M.tr X g u)) ;
   -- the right side: the transported moved element
   w' : SigT (D.ob y) (SCI.ST y) X = SCI.tEs y x f X w ;
   R : SigT (D.ob y) (ID.ty y) X = pairE (D.ob y) (ID.ty y) X gy (N[y].M.tr X gy (sndE (D.ob y) (SCI.ST y) X w')) ;
   -- the moved total at G
   mG : Id (SigT (G.ob y) (IG.ty y) X) (SCI.rB y X w') (IG.tEn y x f X (SCI.rB x X w)) = SCI.rBtE y x f X w ;
   -- readings, read in A at G
   rdL (W : Ob) (h : Hom W X) (j : Hom W Iv)
    : Id (IG.TA[y].T.EI W) (SE[y].M.mV W (ID.Y[y].I.rd X gy (sndE (D.ob y) (ID.ty y) X L) W h j)) ((A.tE y x f).nt W (rdG x X (SCI.rB x X w) W h j)) =
    transH (apH (SE[y].M.mV W) (ID.rd-C y x f X g (N[x].M.tr X g u) W h j))
     (transH (rBm y x f W (ID.Y[x].I.rd X g (N[x].M.tr X g u) W h j))
       (apH ((A.tE y x f).nt W) (N[x].M.tr-rd X g u W h j))) ;
   rdR (W : Ob) (h : Hom W X) (j : Hom W Iv)
    : Id (IG.TA[y].T.EI W) (SE[y].M.mV W (ID.Y[y].I.rd X gy (sndE (D.ob y) (ID.ty y) X R) W h j)) ((A.tE y x f).nt W (rdG x X (SCI.rB x X w) W h j)) =
    transH (N[y].M.tr-rd X gy (sndE (D.ob y) (SCI.ST y) X w') W h j)
     (transH (apH (\ z -> rdG y X z W h j) mG)
       (IG.rd-C y x f X (fstE (G.ob x) (IG.ty x) X (SCI.rB x X w)) (sndE (G.ob x) (IG.ty x) X (SCI.rB x X w)) W h j)) ;
   sqL : Id (PB.Phi X) (sndE (D.ob y) (ID.ty y) X L).2.1 (sqG x X (SCI.rB x X w)) =
    transH (ID.sieve-C y x f X g (N[x].M.tr X g u)) (N[x].M.tr-sq X g u) ;
   sqR : Id (PB.Phi X) (sndE (D.ob y) (ID.ty y) X R).2.1 (sqG x X (SCI.rB x X w)) =
    transH (N[y].M.tr-sq X gy (sndE (D.ob y) (SCI.ST y) X w'))
     (transH (apH (sqG y X) mG) (IG.sieve-C y x f X (fstE (G.ob x) (IG.ty x) X (SCI.rB x X w)) (sndE (G.ob x) (IG.ty x) X (SCI.rB x X w)))) ;
   eq : Id (SigT (D.ob y) (ID.ty y) X) L R =
    ID.idC-eq y X L R (refl gy)
     (\ W h j -> SE[y].M.mV-inj W (ID.Y[y].I.rd X gy (sndE (D.ob y) (ID.ty y) X L) W h j) (ID.Y[y].I.rd X gy (sndE (D.ob y) (ID.ty y) X R) W h j)
                   (refl (ID.Y[y].I.pt X gy W h)) (transH (rdL W h j) (symH (rdR W h j))))
     (transH sqL (symH sqR)) ;
   res : Id (SigT (D.ob y) (ID.ty y) X)
          ((ID.IdT.tE y x f).nt X (subst (PTy[D.ob x]) (\ T2 -> SigT (D.ob x) T2 X) (SCI.ST x) (ID.ty x) (Pf x) w))
          (subst (PTy[D.ob y]) (\ T2 -> SigT (D.ob y) T2 X) (SCI.ST y) (ID.ty y) (Pf y) ((SCI.subCTy.tE y x f).nt X w)) =
    transH (apH (ID.tEn y x f X) (trT x X w)) (transH eq (symH (trT y X w'))) ;
  } ;
  nat : Id (CTy[D]) (LO.subCTy D G s IG.IdT) ID.IdT = EX.cty-ext2 D (LO.subCTy D G s IG.IdT) ID.IdT Pf (\ y x f X w -> Q[y, x, f, X, w].res) ;
  opaque nat ;
 } ;

 ------------------------------------------------------------------
 -- refl

 module ReflC (G : CCtx) (A : CTy[G]) (a0 : CEl[G, A]) {
  module IG = IdC[G, A, a0, a0] ;
  module RY (x : CO) { module R = RD.ReflY[G.ob x, A.ty x, a0.el x] ; } ;
  val (x : CO) : PEl[G.ob x, IG.ty x] = RY[x].R.rflY ;
  nat (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X))
   : Id (SigT (G.ob y) (IG.ty y) X) (IG.tEn y x f X (pairE (G.ob x) (IG.ty x) X g (RY[x].R.val X g)))
       (pairE (G.ob y) (IG.ty y) X ((G.act y x f).nt X g) (RY[y].R.val X ((G.act y x f).nt X g))) =
   IG.idC-eq y X (IG.tEn y x f X (pairE (G.ob x) (IG.ty x) X g (RY[x].R.val X g)))
     (pairE (G.ob y) (IG.ty y) X ((G.act y x f).nt X g) (RY[y].R.val X ((G.act y x f).nt X g)))
     (refl ((G.act y x f).nt X g))
     (\ W h j ->
      transH (IG.rd-C y x f X g (RY[x].R.val X g) W h j)
        (transH (a0.el-nat y x f W (IG.Y[x].I.pt X g W h))
          (apH (\ y1 -> IG.TA[y].T.pr W y1 ((a0.el y).eob W y1)) (IG.TC[y, x, f, X, g, RY[x].R.val X g].pi W h))))
     (refl (PB.topS X)) ;
  reflC : CEl[G, IG.IdT] = new CEl[G, IG.IdT, val, nat] ;
 } ;
} ;
