-- CCeVals.seg (canonicity-45; COBAR.md "Prop 58"): at a copy y', over the
-- empty context, on the closed copy Ec of yo(y).A: the values part of cE,
-- psi (CPsiQ) applied to the n new G-values of a point (read off the
-- telescope point, CUnpack), as an element of Q_y'^n (c2's Pm n).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module CV (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) (y' : SX.Over[R].Presentation) {
 module CB = CCeBase[a].CB[R, encK, pe, y, u, y'] ;
 module UP = CB.EH.UP ;
 module PQ = CPsiQ[a].PQ[R, encK, pe, y'] ;
 module S1 = CSolT[a].SolOf[R, encK, pe, y, u, y'] ;
 module HO = CB.HO ;
 C : CwF.CwF[a++] = UP.C ;
 CP : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
 Nl : L.PCtx = CB.Nl ;
 Ec : L.PTy[Nl] = CB.Ec ;
 K0 (I : Ob) : CB.RH.CT.TC.TOb = (I, y') ;
 XS : C.Sub UP.E (C.ext UP.SO.Xc (UP.SA.SigH UP.qs UP.Ut)) =
  C.o UP.E (C.ext UP.SO.Pr (UP.SA.Sp UP.qs)) (C.ext UP.SO.Xc (UP.SA.SigH UP.qs UP.Ut)) (UP.UX u.1 (UP.SA.SigH UP.qs UP.Ut)) (C.lift UP.RS.LA.PYy UP.SO.Pr (UP.SA.Sp UP.qs) UP.AYm.G.gY) ;
 xi (I : Ob) (w : V1.Ix (Ec.tob I tt)) : V1.Ix ((UP.Ex u.1).ob (K0 I)) = (XS.nt (K0 I) w).1 ;
 mapP : (j : Nat) (I : Ob) -> V1.Ix ((UP.Ex j).ob (K0 I)) -> S1.PK j I = split {
  zero -> \ I x -> tt ;
  suc j | r -> \ I x -> (r I x.1, PQ.psi.nfun I tt x.2) } ;
 qm (J I : Ob) (h : Hom J I) : CB.RH.CT.TC.THm (K0 J) (K0 I) = CB.RH.qm J I h ;
 -- the telescope point is natural
 xiN (J I : Ob) (h : Hom J I) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix ((UP.Ex u.1).ob (K0 J))) ((UP.Ex u.1).act (K0 J) (K0 I) (qm J I h) (xi I w)) (xi J (Ec.tact J I h tt tt (refl tt) w)) =
  apH {V1.Ix ((C.ext UP.SO.Xc (UP.SA.SigH UP.qs UP.Ut)).ob (K0 J))} {V1.Ix ((UP.Ex u.1).ob (K0 J))} (\ z -> z.1) (symH (XS.nt-nat (K0 J) (K0 I) (qm J I h) w)) ;
 -- psi on the values is natural
 mapPN : (j : Nat) (J I : Ob) (h : Hom J I) (x : V1.Ix ((UP.Ex j).ob (K0 I)))
  -> Id (S1.PK j J) ((S1.Pm j).1.tact J I h tt tt (refl tt) (mapP j I x)) (mapP j J ((UP.Ex j).act (K0 J) (K0 I) (qm J I h) x)) = split {
  zero -> \ J I h x -> refl tt ;
  suc j | r -> \ J I h x ->
   transH (apH {S1.PK j J} {S1.PK (suc j) J} (\ a0 -> (a0, S1.Qy.1.tact J I h tt tt (L.ntEq (CP.ext Nl (S1.Pm j)) Nl (CP.p Nl (S1.Pm j)) J I h (tt, mapP j I x.1) (tt, (S1.Pm j).1.tact J I h tt tt (refl tt) (mapP j I x.1)) (refl (tt, (S1.Pm j).1.tact J I h tt tt (refl tt) (mapP j I x.1)))) (PQ.psi.nfun I tt x.2)))
     (r J I h x.1))
    (apH {V1.Ix (S1.Qy.1.tob J tt)} {S1.PK (suc j) J} (\ b0 -> (mapP j J ((UP.Ex j).act (K0 J) (K0 I) (qm J I h) x.1), b0))
      (transH (L.tact-irr Nl S1.Qy.1 J I h tt tt (L.ntEq (CP.ext Nl (S1.Pm j)) Nl (CP.p Nl (S1.Pm j)) J I h (tt, mapP j I x.1) (tt, (S1.Pm j).1.tact J I h tt tt (refl tt) (mapP j I x.1)) (refl (tt, (S1.Pm j).1.tact J I h tt tt (refl tt) (mapP j I x.1)))) (refl tt) (PQ.psi.nfun I tt x.2))
        (PQ.psi.nnat J I h tt tt (refl tt) x.2))) } ;
 -- the values map
 PmT : L.PTy[Nl] = (S1.Pm u.1).1 ;
 fV (I : Ob) : (x : Top) -> V1.Ix (Ec.tob I x) -> V1.Ix (PmT.tob I x) = split { tt -> \ w -> mapP u.1 I (xi I w) } ;
 fVn (J I : Ob) (h : Hom J I) (e : Id Top (Nl.act J I h tt) tt) (w : V1.Ix (Ec.tob I tt))
  : Id (V1.Ix (PmT.tob J tt)) (PmT.tact J I h tt tt e (mapP u.1 I (xi I w))) (mapP u.1 J (xi J (Ec.tact J I h tt tt e w))) =
  transH (L.tact-irr Nl PmT J I h tt tt e (refl tt) (mapP u.1 I (xi I w)))
   (transH (mapPN u.1 J I h (xi I w)) (apH {V1.Ix ((UP.Ex u.1).ob (K0 J))} {V1.Ix (PmT.tob J tt)} (mapP u.1 J) (xiN J I h w))) ;
 vN : HO.NMap[Nl, Ec, PmT] = CB.TopN[PmT, fV, fVn].nm ;
} ;
