-- CTotP13g.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part g: mS is natural along total maps (CMove.Mv's mSnat).  At
-- each index by the homotopy fibre's extensionality: the points by the
-- pairing's naturality (phiN), the elements of A by D A's action (TB.pc),
-- the paths by Psi's naturality at the context G.B (c2's CTotPsi9) after
-- the pairing commutes with the action on lines.
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13g (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PF = CTotP13f[a, vl, l].P13f[C, G, A, B, f] ;
 module PE = PF.PE ;
 module PB13 = PE.PB13 ;
 module TR = PE.TR ;
 module TC = PE.TC ;
 module DO = PE.DO ;
 module DF = PE.DF ;
 module H = PE.H ;
 module HD = PE.HD ;
 module DS = PF.DS ;
 module PR = PE.PR ;
 module P9E = CTotPsi9[a, vl, l].Psi9[C, PE.ET] ;
 D0 : TR.P1.PCtx = TC.toP DS.D.DCtx ;
 Tot0 (W : TC.TOb) : U l = TR.P1.SigT D0 DS.DTy W ;
 E0 : TR.P1.PCtx = TR.P1.extP D0 DS.DTy ;

 module NS (Vb W : TC.TOb) (g : TC.THm Vb W) (v : HD.TF.EI W) {
  v' : HD.TF.EI Vb = HD.TF.E.act Vb W g v ;
  module MW = PE.MS[W, v] ;
  module MV = PE.MS[Vb, v'] ;
  T : Tot0 W = PF.mS W v ;
  phiLA : Id (W0.Ix (PR.FDE.ob Vb)) MV.lE (PR.FDE.actF Vb W g MW.lE) =
   PR.FDE.fam-eq Vb MV.lE (PR.FDE.actF Vb W g MW.lE) (\ W' k j -> refl (MV.lE.1 W' k j)) ;
  module RQ (q : DO.Idx Vb.1 Vb.2) (lq : DO.LandsI Vb.1 Vb.2 q) {
   rq : DO.Idx W.1 W.2 = DS.TB[Vb.1, W.1, g.1, Vb.2, W.2, g.2, T.1, D0.act Vb W g T.1, refl (D0.act Vb W g T.1), T.2].sh q ;
   Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
   module PN = P9E.PNat[Vb, W, g, MW.lE] ;
   module QW = MW.PQ[rq.1, rq.2.1, rq.2.2.1, rq.2.2.2.1, rq.2.2.2.2.1, (rq.2.2.2.2.2, lq)] ;
   module QV = MV.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)] ;
   lineEq : Id (W0.Ix (PE.FTg.FE.ob Y)) QV.psiE QW.psiE =
    transH (apH {W0.Ix (PR.FDE.ob Vb)} {W0.Ix (PE.FTg.FE.ob Y)} (\ ln' -> PE.Q2E.PQ[Vb, ln', q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].psiq) phiLA)
     (PN.PQe[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].law) ;
   law : Id (H.TF.EI Y) (DS.prz Y.1 Y.2 QW.pq QW.fib) (DS.prz Y.1 Y.2 QV.pq QV.fib) =
    H.fibE-eq Y (DS.prz Y.1 Y.2 QW.pq QW.fib) (DS.prz Y.1 Y.2 QV.pq QV.fib)
     (apH {PR.DE.Ob' Vb.1 Vb.2} {W0.Ix (H.EA.ob Y)} (\ T2 -> T2.1 q lq) (symH (PR.phiN Vb W g MW.w)))
     (symH (DF.DA.TB[Vb.1, W.1, g.1, Vb.2, W.2, g.2, MW.d, DF.D.act Vb.1 W.1 g.1 Vb.2 W.2 g.2 MW.d, refl (DF.D.act Vb.1 W.1 g.1 Vb.2 W.2 g.2 MW.d), MW.a'].pc q lq))
     (\ V2 g' j -> apH {W0.Ix (PE.FTg.FE.ob Y)} {H.TA.EI V2} (\ MM -> MM.1 V2 g' j) (symH lineEq)) ;
  } ;
  law : Id (Tot0 Vb) (E0.act Vb W g T) (PF.mS Vb v') =
   PB13.LZ.LM.totEq Vb (E0.act Vb W g T) (PF.mS Vb v') (symH (PR.phiN Vb W g MW.w))
    (\ q lq -> transH (DS.TB[Vb.1, W.1, g.1, Vb.2, W.2, g.2, T.1, D0.act Vb W g T.1, refl (D0.act Vb W g T.1), T.2].pc q lq) (RQ[q, lq].law)) ;
 } ;
} ;
