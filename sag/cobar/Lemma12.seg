-- Lemma12.seg (canonicity-45; COBAR.md "Lemma 12, detailed proof"): D
-- sends a levelwise trivial fibration to a trivial fibration.
--
-- Part 1 (this part): the uniform face equations.  For an element of D G
-- (resp. of D A over it), the value at the face d_k i of a weight, k <=
-- n+1, is the value at i on the chain d_k c = fc n k c, moved along its
-- map (the identity for k <= n, the last map for k = n+1):
--   ufD : t (n+1 , c , d_k i) = act fm (t (n , c' , i))
--   ufA : the same in the totals E_z, with A.tE fm
-- PLAN of the remaining parts (x , X , gamma : D.Ob' x X and a side s of
-- DA at gamma fixed; all comparisons of weights through coordinates, a set):
--  V n      values v z c J g i : (A z) J (gamma (n , z , c , J , g , i))
--  P1 n     naturality in the base, in E_z (the form of anat)
--  P2 n     extension of s: prz (gamma (.. J (f g') i)) (v .. (f g') i)
--           = s.pv W f lf read at (.. J g' i)  (through TB.pc)
--  P3 (m+1) faces: prz at (m+1 , c , d_k i) = A.tE (fc m k c) (prz at level m)
--  Up 0 = V 0 * P1 * P2 ;  Up (m+1) = (p : Up m) * V (m+1) * P1 * P2 * P3,
--  step by split on m (two face pieces cannot meet at level 1: P_0 has
--  i_0 = 1).  Level m+1 at (z , c , J , g , i): kop of al z on the Join of
--   piece 0     s on pre g Q, read at (m+1 , z , c , W , id , res h i);
--   piece k+1   [i_k = 0] (k <= m+1): A.tE (fc m k c) (level m at
--               Unface_k (res h i)).
--  Join compatibility: (0 , k+1) by P2 at level m and UA.uf for s;
--  (k+1 , l+1) by P3 at level m twice, A.tE-o, K.ff-fc and Weights.W3.
--  P1 by kunif and kop-cong; P2 by kfull on piece 0; P3 by kfull on piece
--  k+1 at a face weight (Unface of a face = face-skip).  Then lemma12 x :
--  ContrOp (obD x) (DTy x) (kside from P2, kunif by induction on levels
--  with kop-cong), and UTriv by reindexing (as Lemma 9).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module L12 (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A : CPshC[a, l].CPsh[C].CTy[G]) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module D = DD.DC[G] ;
 module DA = DD.DT[G, A] ;
 CO : U a = P.CO ;

 ------------------------------------------------------------------
 -- the face of a weight does not depend on the bound proof

 valIrr (n : Nat) (J : Ob) (y : Nat) (hy hy' : Tr.IsT (Tr.leb y (suc n))) (i : Wt.Coords n J) (jn : Nat) (hj : Tr.IsT (Tr.leb jn (suc n)))
  : (b : Bool) -> (e : Id Bool (eqN jn y) b)
    -> Id (Hom J PFO.ivO) (Wt.Face[n, J, y, hy].valB i jn hj b e) (Wt.Face[n, J, y, hy'].valB i jn hj b e) = split {
  true -> \ e -> refl (PB.ptH J PB.e0) ;
  false -> \ e -> refl (i (Ar.dg n y jn, Ar.dg-range n y jn hj)) } ;

 faceW-irr (n : Nat) (J : Ob) (y : Nat) (hy hy' : Tr.IsT (Tr.leb y (suc n))) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[i].face) (Wt.Face[n, J, y, hy'].Of[i].face) =
  Sigma-eq (Wt.Coords (suc n) J) (\ cs -> PB.Lands J J (Wt.oneS (suc n) J cs) (PB.idH J))
   (Wt.Face[n, J, y, hy].Of[i].face).1 (Wt.Face[n, J, y, hy'].Of[i].face).1
   (Wt.Face[n, J, y, hy].Of[i].face).2 (Wt.Face[n, J, y, hy'].Of[i].face).2
   (funext (Ar.Fin (suc (suc n))) (\ j -> Hom J PFO.ivO) (Wt.Face[n, J, y, hy].Of[i].face).1 (Wt.Face[n, J, y, hy'].Of[i].face).1
      (\ j -> valIrr n J y hy hy' i.1 j.1 j.2 (eqN j.1 y) (refl (eqN j.1 y))))
   (PB.isProp-Lands J J (Wt.oneS (suc n) J (Wt.Face[n, J, y, hy'].Of[i].face).1) (PB.idH J)) ;

 ------------------------------------------------------------------
 -- uniform faces of an element of D G

 module UD (x : CO) (X : Ob) (u : D.Ob' x X) (n : Nat) (z : CO) (c : K.Ch (suc n) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) {
  fcD (k : Nat) : K.DR n x z = K.fc n k x z c ;
  rhs (k : Nat) : W0.Ix ((G.ob z).ob J) =
   (G.act z (fcD k).1 (fcD k).2.2).nt J (u.1 (n, (fcD k).1, (fcD k).2.1, J, g, i.1) i.2) ;
  lhs (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : W0.Ix ((G.ob z).ob J) =
   D.at x X u.1 (suc n) z c J g (Wt.Face[n, J, k, hk].Of[i].face) ;
  -- the value at a face does not depend on the bound proof
  lhs-irr (k : Nat) (hk hk' : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix ((G.ob z).ob J)) (lhs k hk) (lhs k hk') =
   apH (\ p -> u.1 (suc n, z, c, J, g, p.1) p.2) (faceW-irr n J k hk hk' i) ;
  low (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (hk' : Tr.IsT (Tr.leb k n)) : Id (W0.Ix ((G.ob z).ob J)) (lhs k hk) (rhs k) =
   transH (lhs-irr k hk (Ar.leb-step k n hk'))
    (transH (u.2.2.1 (n, k, hk', z, c, J, g, i.1) i.2)
      (transH (symH (G.act-id z J (u.1 (n, z, K.comp n k x z c, J, g, i.1) i.2)))
        (apH (\ DR' -> (G.act z DR'.1 DR'.2.2).nt J (u.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2))
           (symH (K.fc-comp n k hk' x z c))))) ;
  top (hk : Tr.IsT (Tr.leb (suc n) (suc n))) : Id (W0.Ix ((G.ob z).ob J)) (lhs (suc n) hk) (rhs (suc n)) =
   transH (lhs-irr (suc n) hk (Tr.leb-refl (suc n)))
    (transH (u.2.2.2 (n, z, c, J, g, i.1) i.2)
      (apH (\ DR' -> (G.act z DR'.1 DR'.2.2).nt J (u.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2))
         (symH (K.fc-top n x z c)))) ;
  uf (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix ((G.ob z).ob J)) (lhs k hk) (rhs k) =
   Arith[l].eqN-dec (Id (W0.Ix ((G.ob z).ob J)) (lhs k hk) (rhs k)) k (suc n)
    (\ e -> idJ Nat (suc n) (\ k2 e2 -> (h2 : Tr.IsT (Tr.leb k2 (suc n))) -> Id (W0.Ix ((G.ob z).ob J)) (lhs k2 h2) (rhs k2))
              (\ h2 -> top h2) k (sym Nat k (suc n) e) hk)
    (\ ne -> low k hk (Ar.leb-suc-neq k n hk ne)) ;
 } ;

 ------------------------------------------------------------------
 -- uniform faces of an element of D A over u, in the totals

 module UA (x : CO) (X : Ob) (u : D.Ob' x X) (av : DA.TOb' x X u) (n : Nat) (z : CO) (c : K.Ch (suc n) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) {
  fcD (k : Nat) : K.DR n x z = K.fc n k x z c ;
  rhs (k : Nat) : W0.Ix (DA.Ez z J) =
   (A.tE z (fcD k).1 (fcD k).2.2).nt J
    (DA.prz (fcD k).1 J (u.1 (n, (fcD k).1, (fcD k).2.1, J, g, i.1) i.2) (av.1 (n, (fcD k).1, (fcD k).2.1, J, g, i.1) i.2)) ;
  lhs (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : W0.Ix (DA.Ez z J) =
   DA.prz z J (u.1 (suc n, z, c, J, g, (Wt.Face[n, J, k, hk].Of[i].face).1) (Wt.Face[n, J, k, hk].Of[i].face).2)
              (av.1 (suc n, z, c, J, g, (Wt.Face[n, J, k, hk].Of[i].face).1) (Wt.Face[n, J, k, hk].Of[i].face).2) ;
  lhs-irr (k : Nat) (hk hk' : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix (DA.Ez z J)) (lhs k hk) (lhs k hk') =
   apH (\ p -> DA.prz z J (u.1 (suc n, z, c, J, g, p.1) p.2) (av.1 (suc n, z, c, J, g, p.1) p.2)) (faceW-irr n J k hk hk' i) ;
  low (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (hk' : Tr.IsT (Tr.leb k n)) : Id (W0.Ix (DA.Ez z J)) (lhs k hk) (rhs k) =
   transH (lhs-irr k hk (Ar.leb-step k n hk'))
    (transH (av.2.2.1 (n, k, hk', z, c, J, g, i.1) i.2)
      (transH (symH (A.tE-id z J (DA.prz z J (u.1 (n, z, K.comp n k x z c, J, g, i.1) i.2) (av.1 (n, z, K.comp n k x z c, J, g, i.1) i.2))))
        (apH (\ DR' -> (A.tE z DR'.1 DR'.2.2).nt J
                        (DA.prz DR'.1 J (u.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2) (av.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2)))
           (symH (K.fc-comp n k hk' x z c))))) ;
  top (hk : Tr.IsT (Tr.leb (suc n) (suc n))) : Id (W0.Ix (DA.Ez z J)) (lhs (suc n) hk) (rhs (suc n)) =
   transH (lhs-irr (suc n) hk (Tr.leb-refl (suc n)))
    (transH (av.2.2.2 (n, z, c, J, g, i.1) i.2)
      (apH (\ DR' -> (A.tE z DR'.1 DR'.2.2).nt J
                      (DA.prz DR'.1 J (u.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2) (av.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2)))
         (symH (K.fc-top n x z c)))) ;
  uf (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix (DA.Ez z J)) (lhs k hk) (rhs k) =
   Arith[l].eqN-dec (Id (W0.Ix (DA.Ez z J)) (lhs k hk) (rhs k)) k (suc n)
    (\ e -> idJ Nat (suc n) (\ k2 e2 -> (h2 : Tr.IsT (Tr.leb k2 (suc n))) -> Id (W0.Ix (DA.Ez z J)) (lhs k2 h2) (rhs k2))
              (\ h2 -> top h2) k (sym Nat k (suc n) e) hk)
    (\ ne -> low k hk (Ar.leb-suc-neq k n hk ne)) ;
 } ;

 ------------------------------------------------------------------
 -- weights restricted twice, and along the identity

 resres (n : Nat) (W'' W' W : Ob) (h : Hom W' W) (chi : Hom W'' W') (i : Wt.Pn n W)
  : Id (Wt.Pn n W'') (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res) (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res) =
  Sigma-eq (Wt.Coords n W'') (\ cs -> PB.Lands W'' W'' (Wt.oneS n W'' cs) (PB.idH W''))
   (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).1 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1
   (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).2 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W'' PFO.ivO)
      (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).1 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1
      (\ k -> PB.comp-assoc W'' W' W PFO.ivO (i.1 k) h chi))
   (PB.isProp-Lands W'' W'' (Wt.oneS n W'' (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1) (PB.idH W'')) ;

 resid (n : Nat) (W : Ob) (i : Wt.Pn n W) : Id (Wt.Pn n W) (Wt.Res[n, W, W, PB.idH W, i].res) i =
  Sigma-eq (Wt.Coords n W) (\ cs -> PB.Lands W W (Wt.oneS n W cs) (PB.idH W))
   (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (Wt.Res[n, W, W, PB.idH W, i].res).2 i.2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W PFO.ivO) (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (\ k -> PB.comp-idr W PFO.ivO (i.1 k)))
   (PB.isProp-Lands W W (Wt.oneS n W i.1) (PB.idH W)) ;

 ------------------------------------------------------------------
 -- the fixed data: a point gamma of D G at x , X and a side s of D A

 module Fx (al : (z : CO) -> CP.ContrOp (G.ob z) (A.ty z)) (x : CO) (X : Ob) (gm : D.Ob' x X) (s : CP.Partials[D.obD x, DA.DTy x].Side[X, gm]) {
  module PD = CP.Partials[D.obD x, DA.DTy x] ;
  -- s along f, and its point
  sv (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) : SigT (D.obD x) (DA.DTy x) W = s.pv W f lf ;
  sp (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) : Id (D.Ob' x W) (sv W f lf).1 (D.BA[x, W, X, f, gm].res) = s.ppt W f lf ;
  -- the reading of s at an index, in E_z
  rd (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) (q : DD.Idx x W) (l : DD.LandsI x W q) : W0.Ix (DA.Ez q.2.1 q.2.2.2.1) =
   DA.prz q.2.1 q.2.2.2.1 ((sv W f lf).1.1 q l) ((sv W f lf).2.1 q l) ;
  -- a point of gamma, read at the index of a reading
  gpt (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) : W0.Ix ((G.ob z).ob J) = gm.1 (n, z, c, J, g, i.1) i.2 ;

  -- readings along equal maps are equal
  rdHom (W : Ob) (f f' : Hom W X) (P : Id (Hom W X) f f') (lf : PB.Lands W X s.pQ f) (lf' : PB.Lands W X s.pQ f')
   (q : DD.Idx x W) (l : DD.LandsI x W q) : Id (W0.Ix (DA.Ez q.2.1 q.2.2.2.1)) (rd W f lf q l) (rd W f' lf' q l) =
   apH (\ w -> DA.prz q.2.1 q.2.2.2.1 (w.1.1 q l) (w.2.1 q l)) (PD.pv-hom X gm s W f f' P lf lf') ;
  -- a reading of s restricted along g' : J -> W
  rdRes (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) (J : Ob) (g' : Hom J W) (n : Nat) (z : CO) (c : K.Ch n x z) (i : Wt.Pn n J)
   : Id (W0.Ix (DA.Ez z J)) (rd J (PB.compH J W X f g') (PB.lands-comp J W X s.pQ f g' lf) (n, z, c, J, PB.idH J, i.1) i.2)
        (rd W f lf (n, z, c, J, g', i.1) i.2) =
   transH (apH (\ w -> DA.prz z J (w.1.1 (n, z, c, J, PB.idH J, i.1) i.2) (w.2.1 (n, z, c, J, PB.idH J, i.1) i.2))
             (symH (s.pnat J W g' f lf (PB.lands-comp J W X s.pQ f g' lf))))
    (transH (DA.TB[x, J, W, g', (sv W f lf).1, D.BA[x, J, W, g', (sv W f lf).1].res, refl (D.BA[x, J, W, g', (sv W f lf).1].res), (sv W f lf).2].pc
               (n, z, c, J, PB.idH J, i.1) i.2)
      (apH (\ k -> DA.prz z J ((sv W f lf).1.1 (n, z, c, J, k, i.1) i.2) ((sv W f lf).2.1 (n, z, c, J, k, i.1) i.2))
         (PB.comp-idr J W g'))) ;

  ----------------------------------------------------------------
  -- the levels: values, naturality, extension of s, faces

  Vt (n : Nat) : U l = (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) -> W0.Ix ((A.ty z).tob J (gpt n z c J g i)) ;
  pzv (n : Nat) (v : Vt n) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) : W0.Ix (DA.Ez z J) =
   DA.prz z J (gpt n z c J g i) (v z c J g i) ;
  P1t (n : Nat) (v : Vt n) : U l =
   (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J)
   -> Id (W0.Ix (DA.Ez z J')) ((extP (G.ob z) (A.ty z)).act J' J h (pzv n v z c J g i))
         (pzv n v z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res)) ;
  P2t (n : Nat) (v : Vt n) : U l =
   (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) (z : CO) (c : K.Ch n x z) (J : Ob) (g' : Hom J W) (i : Wt.Pn n J)
   -> Id (W0.Ix (DA.Ez z J)) (pzv n v z c J (PB.compH J W X f g') i) (rd W f lf (n, z, c, J, g', i.1) i.2) ;
  P3t (m : Nat) (v' : Vt (suc m)) (v : Vt m) : U l =
   (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn m J) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m)))
   -> Id (W0.Ix (DA.Ez z J)) (pzv (suc m) v' z c J g (Wt.Face[m, J, k, hk].Of[i].face))
         ((A.tE z (K.fc m k x z c).1 (K.fc m k x z c).2.2).nt J (pzv m v (K.fc m k x z c).1 (K.fc m k x z c).2.1 J g i)) ;

  -- the levels up to n, with the top projection
  Lv : (n : Nat) -> (T : U l) * (T -> Vt n) = split {
   zero -> ((v : Vt zero) * P1t zero v * P2t zero v, \ p -> p.1) ;
   suc m | r -> ((v : Vt (suc m)) * P1t (suc m) v * P2t (suc m) v * (p : r.1) * P3t m v (r.2 p), \ p -> p.1) } ;
  Up (n : Nat) : U l = (Lv n).1 ;
  top (n : Nat) (p : Up n) : Vt n = (Lv n).2 p ;

  ----------------------------------------------------------------
  -- piece 0 at level n: s on pre g Q, read at (n , z , c , W , id , res h i)

  module Q0 (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) {
   module Pz = CP.Partials[G.ob z, A.ty z] ;
   Q : PB.Phi J = PB.pre J X g s.pQ ;
   R (W : Ob) (h : Hom W J) : Wt.Pn n W = Wt.Res[n, W, J, h, i].res ;
   lfh (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h) : PB.Lands W X s.pQ (PB.compH W J X g h) = PB.lands-pre W J X g s.pQ h lh ;
   pv (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h) : W0.Ix (DA.Ez z W) =
    rd W (PB.compH W J X g h) (lfh W h lh) (n, z, c, W, PB.idH W, (R W h).1) (R W h).2 ;
   ppt (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h)
    : Id (W0.Ix ((G.ob z).ob W)) (fstE (G.ob z) (A.ty z) W (pv W h lh)) ((G.ob z).act W J h (gpt n z c J g i)) =
    transH (apH (\ w -> w.1 (n, z, c, W, PB.idH W, (R W h).1) (R W h).2) (sp W (PB.compH W J X g h) (lfh W h lh)))
     (transH (apH (\ k -> gm.1 (n, z, c, W, k, (R W h).1) (R W h).2) (PB.comp-idr W X (PB.compH W J X g h)))
       (symH (gm.2.1 ((n, z, c, J, g, i.1), (W, h)) i.2))) ;
   pnat (W' W : Ob) (chi : Hom W' W) (h : Hom W J) (lh : PB.Lands W J Q h) (lh' : PB.Lands W' J Q (PB.compH W' W J h chi))
    : Id (W0.Ix (DA.Ez z W')) ((extP (G.ob z) (A.ty z)).act W' W chi (pv W h lh)) (pv W' (PB.compH W' W J h chi) lh') =
    transH ((sv W (PB.compH W J X g h) (lfh W h lh)).2.2.1 ((n, z, c, W, PB.idH W, (R W h).1), (W', chi)) (R W h).2)
     (transH (apH (\ k -> DA.prz z W' ((sv W (PB.compH W J X g h) (lfh W h lh)).1.1 (n, z, c, W', k, (Wt.Res[n, W', W, chi, R W h].res).1) (Wt.Res[n, W', W, chi, R W h].res).2)
                               ((sv W (PB.compH W J X g h) (lfh W h lh)).2.1 (n, z, c, W', k, (Wt.Res[n, W', W, chi, R W h].res).1) (Wt.Res[n, W', W, chi, R W h].res).2))
                (transH (PB.comp-idl W' W chi) (symH (PB.comp-idr W' W chi))))
      (transH (apH (\ p -> DA.prz z W' ((sv W (PB.compH W J X g h) (lfh W h lh)).1.1 (n, z, c, W', PB.compH W' W' W chi (PB.idH W'), p.1) p.2)
                                ((sv W (PB.compH W J X g h) (lfh W h lh)).2.1 (n, z, c, W', PB.compH W' W' W chi (PB.idH W'), p.1) p.2))
                 (resres n W' W J h chi i))
       (transH (symH (DA.TB[x, W', W, chi, (sv W (PB.compH W J X g h) (lfh W h lh)).1,
                      D.BA[x, W', W, chi, (sv W (PB.compH W J X g h) (lfh W h lh)).1].res,
                      refl (D.BA[x, W', W, chi, (sv W (PB.compH W J X g h) (lfh W h lh)).1].res),
                      (sv W (PB.compH W J X g h) (lfh W h lh)).2].pc (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2))
        (transH (apH (\ w -> DA.prz z W' (w.1.1 (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2)
                                       (w.2.1 (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2))
                   (s.pnat W' W chi (PB.compH W J X g h) (lfh W h lh) (PB.lands-comp W' W X s.pQ (PB.compH W J X g h) chi (lfh W h lh))))
          (apH (\ w -> DA.prz z W' (w.1.1 (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2)
                                 (w.2.1 (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2))
             (PD.pv-hom X gm s W' (PB.compH W' W X (PB.compH W J X g h) chi) (PB.compH W' J X g (PB.compH W' W J h chi))
                (PB.comp-assoc W' W J X g h chi)
                (PB.lands-comp W' W X s.pQ (PB.compH W J X g h) chi (lfh W h lh)) (lfh W' (PB.compH W' W J h chi) lh'))))))) ;
   side : Pz.Side[J, gpt n z c J g i] = new Pz.Side[J, gpt n z c J g i, Q, pv, ppt, pnat] ;
  } ;

  ----------------------------------------------------------------
  -- piece 0: restriction coherence and the value at the identity

  gnat (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J)
   : Id (W0.Ix ((G.ob z).ob J')) ((G.ob z).act J' J h (gpt n z c J g i)) (gpt n z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res)) =
   gm.2.1 ((n, z, c, J, g, i.1), (J', h)) i.2 ;

  Q0coh (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J)
   : Id (CP.Partials[G.ob z, A.ty z].Side[J', gpt n z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res)])
        (subst (W0.Ix ((G.ob z).ob J')) (\ y -> CP.Partials[G.ob z, A.ty z].Side[J', y])
           ((G.ob z).act J' J h (gpt n z c J g i)) (gpt n z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res)) (gnat n z c J g i J' h)
           (CP.Partials[G.ob z, A.ty z].rside J' J h (gpt n z c J g i) Q0[n, z, c, J, g, i].side))
        Q0[n, z, c, J', PB.compH J' J X g h, Wt.Res[n, J', J, h, i].res].side =
   CP.Partials[G.ob z, A.ty z].side-extH J' ((G.ob z).act J' J h (gpt n z c J g i)) (gpt n z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res))
    (gnat n z c J g i J' h)
    (CP.Partials[G.ob z, A.ty z].rside J' J h (gpt n z c J g i) Q0[n, z, c, J, g, i].side)
    Q0[n, z, c, J', PB.compH J' J X g h, Wt.Res[n, J', J, h, i].res].side
    (PB.pre-comp J' J X h g s.pQ)
    (\ W f lw lw' ->
      transH (rdHom W (PB.compH W J X g (PB.compH W J' J h f)) (PB.compH W J' X (PB.compH J' J X g h) f)
                (symH (PB.comp-assoc W J' J X g h f))
                (PB.lands-pre W J X g s.pQ (PB.compH W J' J h f) (PB.lands-pre W J' J h (PB.pre J X g s.pQ) f lw))
                (PB.lands-pre W J' X (PB.compH J' J X g h) s.pQ f lw')
                (n, z, c, W, PB.idH W, (Wt.Res[n, W, J, PB.compH W J' J h f, i].res).1) (Wt.Res[n, W, J, PB.compH W J' J h f, i].res).2)
       (apH (\ p -> rd W (PB.compH W J' X (PB.compH J' J X g h) f) (PB.lands-pre W J' X (PB.compH J' J X g h) s.pQ f lw') (n, z, c, W, PB.idH W, p.1) p.2)
          (symH (resres n W J' J h f i)))) ;

  -- the identity lands in piece 0's sieve when f lands in s's
  lid (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) (J : Ob) (g' : Hom J W)
   : PB.Lands J J (PB.pre J X (PB.compH J W X f g') s.pQ) (PB.idH J) =
   PB.pre-lands J J X (PB.compH J W X f g') s.pQ (PB.idH J)
    (PB.lands-eq J X s.pQ (PB.compH J W X f g') (PB.compH J J X (PB.compH J W X f g') (PB.idH J))
       (symH (PB.comp-idr J X (PB.compH J W X f g'))) (PB.lands-comp J W X s.pQ f g' lf)) ;

  Q0ext (n : Nat) (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) (z : CO) (c : K.Ch n x z) (J : Ob) (g' : Hom J W) (i : Wt.Pn n J)
   (li : PB.Lands J J (PB.pre J X (PB.compH J W X f g') s.pQ) (PB.idH J))
   : Id (W0.Ix (DA.Ez z J)) (Q0[n, z, c, J, PB.compH J W X f g', i].pv J (PB.idH J) li) (rd W f lf (n, z, c, J, g', i.1) i.2) =
   transH (rdHom J (PB.compH J J X (PB.compH J W X f g') (PB.idH J)) (PB.compH J W X f g') (PB.comp-idr J X (PB.compH J W X f g'))
             (PB.lands-pre J J X (PB.compH J W X f g') s.pQ (PB.idH J) li) (PB.lands-comp J W X s.pQ f g' lf)
             (n, z, c, J, PB.idH J, (Wt.Res[n, J, J, PB.idH J, i].res).1) (Wt.Res[n, J, J, PB.idH J, i].res).2)
    (transH (apH (\ p -> rd J (PB.compH J W X f g') (PB.lands-comp J W X s.pQ f g' lf) (n, z, c, J, PB.idH J, p.1) p.2) (resid n J i))
      (rdRes W f lf J g' n z c i)) ;

  ----------------------------------------------------------------
  -- values from a family of sides: naturality and extension

  module KS (n : Nat) (S : (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) -> CP.Partials[G.ob z, A.ty z].Side[J, gpt n z c J g i]) {
   v : Vt n = \ z c J g i -> (al z).kop J (gpt n z c J g i) (S z c J g i) ;
   p1 (coh : (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J)
     -> Id (CP.Partials[G.ob z, A.ty z].Side[J', gpt n z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res)])
          (subst (W0.Ix ((G.ob z).ob J')) (\ y -> CP.Partials[G.ob z, A.ty z].Side[J', y])
             ((G.ob z).act J' J h (gpt n z c J g i)) (gpt n z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res)) (gnat n z c J g i J' h)
             (CP.Partials[G.ob z, A.ty z].rside J' J h (gpt n z c J g i) (S z c J g i)))
          (S z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res)))
    : P1t n v = \ z c J g i J' h ->
    transH ((al z).kunif J' J h (gpt n z c J g i) (S z c J g i))
     (CP.Rel[G.ob z, A.ty z, A.ty z, CP.pmap-id (G.ob z) (A.ty z)].kop-cong (al z) J'
        ((G.ob z).act J' J h (gpt n z c J g i)) (gpt n z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res)) (gnat n z c J g i J' h)
        (CP.Partials[G.ob z, A.ty z].rside J' J h (gpt n z c J g i) (S z c J g i))
        (S z c J' (PB.compH J' J X g h) (Wt.Res[n, J', J, h, i].res))
        (coh z c J g i J' h)) ;
   p2 (lidS : (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) (z : CO) (c : K.Ch n x z) (J : Ob) (g' : Hom J W) (i : Wt.Pn n J)
       -> PB.Lands J J (S z c J (PB.compH J W X f g') i).pQ (PB.idH J))
      (extS : (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) (z : CO) (c : K.Ch n x z) (J : Ob) (g' : Hom J W) (i : Wt.Pn n J)
       -> Id (W0.Ix (DA.Ez z J)) ((S z c J (PB.compH J W X f g') i).pv J (PB.idH J) (lidS W f lf z c J g' i)) (rd W f lf (n, z, c, J, g', i.1) i.2))
    : P2t n v = \ W f lf z c J g' i ->
    transH (CP.Rel[G.ob z, A.ty z, A.ty z, CP.pmap-id (G.ob z) (A.ty z)].kfull (al z) J (gpt n z c J (PB.compH J W X f g') i)
              (S z c J (PB.compH J W X f g') i) (lidS W f lf z c J g' i))
     (extS W f lf z c J g' i) ;
  } ;

  -- level 0: piece 0 alone
  module K0 = KS[zero, \ z c J g i -> Q0[zero, z, c, J, g, i].side] ;
  lev0 : Up zero =
   (K0.v, K0.p1 (\ z c J g i J' h -> Q0coh zero z c J g i J' h),
    K0.p2 (\ W f lf z c J g' i -> lid W f lf J g') (\ W f lf z c J g' i -> Q0ext zero W f lf z c J g' i (lid W f lf J g'))) ;

  ----------------------------------------------------------------
  -- accessors of the levels

  p1of : (m : Nat) -> (p : Up m) -> P1t m (top m p) = split {
   zero -> \ p -> p.2.1 ;
   suc m1 -> \ p -> p.2.1 } ;
  p2of : (m : Nat) -> (p : Up m) -> P2t m (top m p) = split {
   zero -> \ p -> p.2.2 ;
   suc m1 -> \ p -> p.2.2.1 } ;

  ----------------------------------------------------------------
  -- the face piece k of level m+1: on [i_k = 0], A.tE along fc m k c of
  -- level m at Unface_k

  module FP (m : Nat) (p : Up m) (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc m) J)
   (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) {
   module Pz = CP.Partials[G.ob z, A.ty z] ;
   vm : Vt m = top m p ;
   kF : Ar.Fin (suc (suc m)) = (k, hk) ;
   Q : PB.Phi J = PB.pre J PFO.ivO (i.1 kF) (PFO.ptSO PB.e0) ;
   ih (W : Ob) (h : Hom W J) : Wt.Pn (suc m) W = Wt.Res[suc m, W, J, h, i].res ;
   zh (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h) : PB.Lands W PFO.ivO (PFO.ptSO PB.e0) ((ih W h).1 kF) =
    PB.lands-pre W J PFO.ivO (i.1 kF) (PFO.ptSO PB.e0) h lh ;
   pw (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h) : Wt.Pn m W = Wt.Unface[m, W, k, hk, ih W h, zh W h lh].p' ;
   Dk : K.DR m x z = K.fc m k x z c ;
   pv (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h) : W0.Ix (DA.Ez z W) =
    (A.tE z Dk.1 Dk.2.2).nt W (pzv m vm Dk.1 Dk.2.1 W (PB.compH W J X g h) (pw W h lh)) ;
   -- the face of the unfaced weight is the weight
   wpU (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h) : Id (Wt.Pn (suc m) W) (Wt.Face[m, W, k, hk].Of[pw W h lh].face) (ih W h) =
    Sigma-eq (Wt.Coords (suc m) W) (\ cs -> PB.Lands W W (Wt.oneS (suc m) W cs) (PB.idH W))
     (Wt.Face[m, W, k, hk].Of[pw W h lh].face).1 (ih W h).1 (Wt.Face[m, W, k, hk].Of[pw W h lh].face).2 (ih W h).2
     (funext (Ar.Fin (suc (suc m))) (\ j -> Hom W PFO.ivO) (Wt.Face[m, W, k, hk].Of[pw W h lh].face).1 (ih W h).1
        (\ j -> Wt.Unface[m, W, k, hk, ih W h, zh W h lh].face-eq j))
     (PB.isProp-Lands W W (Wt.oneS (suc m) W (ih W h).1) (PB.idH W)) ;
   ppt (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h)
    : Id (W0.Ix ((G.ob z).ob W)) (fstE (G.ob z) (A.ty z) W (pv W h lh)) ((G.ob z).act W J h (gpt (suc m) z c J g i)) =
    transH (A.tE-pt z Dk.1 Dk.2.2 W (pzv m vm Dk.1 Dk.2.1 W (PB.compH W J X g h) (pw W h lh)))
     (transH (symH (UD[x, X, gm, m, z, c, W, PB.compH W J X g h, pw W h lh].uf k hk))
       (transH (apH (\ q -> gm.1 (suc m, z, c, W, PB.compH W J X g h, q.1) q.2) (wpU W h lh))
         (symH (gnat (suc m) z c J g i W h)))) ;
   pnat (W' W : Ob) (chi : Hom W' W) (h : Hom W J) (lh : PB.Lands W J Q h) (lh' : PB.Lands W' J Q (PB.compH W' W J h chi))
    : Id (W0.Ix (DA.Ez z W')) ((extP (G.ob z) (A.ty z)).act W' W chi (pv W h lh)) (pv W' (PB.compH W' W J h chi) lh') =
    transH (symH ((A.tE z Dk.1 Dk.2.2).nt-nat W' W chi (pzv m vm Dk.1 Dk.2.1 W (PB.compH W J X g h) (pw W h lh))))
     (apH ((A.tE z Dk.1 Dk.2.2).nt W')
       (transH (p1of m p Dk.1 Dk.2.1 W (PB.compH W J X g h) (pw W h lh) W' chi)
         (transH (apH (\ k' -> pzv m vm Dk.1 Dk.2.1 W' k' (Wt.Res[m, W', W, chi, pw W h lh].res)) (PB.comp-assoc W' W J X g h chi))
           (apH (\ q -> pzv m vm Dk.1 Dk.2.1 W' (PB.compH W' J X g (PB.compH W' W J h chi)) q)
              (Sigma-eq (Wt.Coords m W') (\ cs -> PB.Lands W' W' (Wt.oneS m W' cs) (PB.idH W'))
                 (Wt.Res[m, W', W, chi, pw W h lh].res).1 (pw W' (PB.compH W' W J h chi) lh').1
                 (Wt.Res[m, W', W, chi, pw W h lh].res).2 (pw W' (PB.compH W' W J h chi) lh').2
                 (funext (Ar.Fin (suc m)) (\ j -> Hom W' PFO.ivO) (Wt.Res[m, W', W, chi, pw W h lh].res).1 (pw W' (PB.compH W' W J h chi) lh').1
                    (\ j -> PB.comp-assoc W' W J PFO.ivO (i.1 (Wt.Face[m, W, k, hk].skipF j)) h chi))
                 (PB.isProp-Lands W' W' (Wt.oneS m W' (pw W' (PB.compH W' W J h chi) lh').1) (PB.idH W'))))))) ;
   side : Pz.Side[J, gpt (suc m) z c J g i] = new Pz.Side[J, gpt (suc m) z c J g i, Q, pv, ppt, pnat] ;
  } ;

  ----------------------------------------------------------------
  -- compatibility of piece 0 with the face piece k

  QF (m : Nat) (p : Up m) (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc m) J)
   (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (W : Ob) (f : Hom W J)
   (lw : PB.Lands W J (Q0[suc m, z, c, J, g, i].Q) f) (lw' : PB.Lands W J (FP[m, p, z, c, J, g, i, k, hk].Q) f)
   : Id (W0.Ix (DA.Ez z W)) (Q0[suc m, z, c, J, g, i].pv W f lw) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw') =
   transH (symH (apH (\ q -> rd W (PB.compH W J X g f) (Q0[suc m, z, c, J, g, i].lfh W f lw) (suc m, z, c, W, PB.idH W, q.1) q.2)
                  (FP[m, p, z, c, J, g, i, k, hk].wpU W f lw')))
    (transH (UA[x, W, (sv W (PB.compH W J X g f) (Q0[suc m, z, c, J, g, i].lfh W f lw)).1,
                (sv W (PB.compH W J X g f) (Q0[suc m, z, c, J, g, i].lfh W f lw)).2,
                m, z, c, W, PB.idH W, FP[m, p, z, c, J, g, i, k, hk].pw W f lw'].uf k hk)
      (apH ((A.tE z (K.fc m k x z c).1 (K.fc m k x z c).2.2).nt W)
         (transH (symH (p2of m p W (PB.compH W J X g f) (Q0[suc m, z, c, J, g, i].lfh W f lw)
                          (K.fc m k x z c).1 (K.fc m k x z c).2.1 W (PB.idH W) (FP[m, p, z, c, J, g, i, k, hk].pw W f lw')))
            (apH (\ k' -> pzv m (top m p) (K.fc m k x z c).1 (K.fc m k x z c).2.1 W k' (FP[m, p, z, c, J, g, i, k, hk].pw W f lw'))
               (PB.comp-idr W X (PB.compH W J X g f)))))) ;

  ----------------------------------------------------------------
  -- compatibility of the face pieces k < k1+1, at levels m1+2

  module FFS (m1 : Nat) (p : Up (suc m1)) (z : CO) (c : K.Ch (suc (suc m1)) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc (suc m1)) J)
   (k k1 : Nat) (hk : Tr.IsT (Tr.leb k (suc (suc m1)))) (hk' : Tr.IsT (Tr.leb (suc k1) (suc (suc m1)))) (lt : Tr.IsT (Ar.ltb k (suc k1)))
   (W : Ob) (f : Hom W J)
   (lw : PB.Lands W J (FP[suc m1, p, z, c, J, g, i, k, hk].Q) f) (lw' : PB.Lands W J (FP[suc m1, p, z, c, J, g, i, suc k1, hk'].Q) f) {
   module Fk = FP[suc m1, p, z, c, J, g, i, k, hk] ;
   module Fl = FP[suc m1, p, z, c, J, g, i, suc k1, hk'] ;
   F : Hom W X = PB.compH W J X g f ;
   ih : Wt.Pn (suc (suc m1)) W = Fk.ih W f ;
   v' : Vt m1 = top m1 p.2.2.2.1 ;
   P3 : P3t m1 p.1 v' = p.2.2.2.2 ;
   hkb : Tr.IsT (Tr.leb k (suc m1)) = Tr.leb-trans k k1 (suc m1) lt hk' ;
   pk : Wt.Pn (suc m1) W = Fk.pw W f lw ;
   pl : Wt.Pn (suc m1) W = Fl.pw W f lw' ;
   -- coordinate k1 of pk , and coordinate k of pl , are 0
   z1 : PB.Lands W PFO.ivO (PFO.ptSO PB.e0) (pk.1 (k1, hk')) =
    subst (Ar.Fin (suc (suc (suc m1)))) (\ j -> PB.Lands W PFO.ivO (PFO.ptSO PB.e0) (ih.1 j))
     (suc k1, hk') (Wt.Face[suc m1, W, k, hk].skipF (k1, hk'))
     (Wt.fin-eq (suc (suc (suc m1))) (suc k1, hk') (Wt.Face[suc m1, W, k, hk].skipF (k1, hk')) (sym Nat (Ar.skip k k1) (suc k1) (Ar.skip-ge k k1 lt)))
     (Fl.zh W f lw') ;
   z2 : PB.Lands W PFO.ivO (PFO.ptSO PB.e0) (pl.1 (k, hkb)) =
    subst (Ar.Fin (suc (suc (suc m1)))) (\ j -> PB.Lands W PFO.ivO (PFO.ptSO PB.e0) (ih.1 j))
     (k, hk) (Wt.Face[suc m1, W, suc k1, hk'].skipF (k, hkb))
     (Wt.fin-eq (suc (suc (suc m1))) (k, hk) (Wt.Face[suc m1, W, suc k1, hk'].skipF (k, hkb)) (sym Nat (Ar.skip (suc k1) k) k (Ar.skip-lt (suc k1) k lt)))
     (Fk.zh W f lw) ;
   i2 : Wt.Pn m1 W = Wt.Unface[m1, W, k1, hk', pk, z1].p' ;
   i3 : Wt.Pn m1 W = Wt.Unface[m1, W, k, hkb, pl, z2].p' ;
   wp1 : Id (Wt.Pn (suc m1) W) (Wt.Face[m1, W, k1, hk'].Of[i2].face) pk =
    Sigma-eq (Wt.Coords (suc m1) W) (\ cs -> PB.Lands W W (Wt.oneS (suc m1) W cs) (PB.idH W))
     (Wt.Face[m1, W, k1, hk'].Of[i2].face).1 pk.1 (Wt.Face[m1, W, k1, hk'].Of[i2].face).2 pk.2
     (funext (Ar.Fin (suc (suc m1))) (\ j -> Hom W PFO.ivO) (Wt.Face[m1, W, k1, hk'].Of[i2].face).1 pk.1
        (\ j -> Wt.Unface[m1, W, k1, hk', pk, z1].face-eq j))
     (PB.isProp-Lands W W (Wt.oneS (suc m1) W pk.1) (PB.idH W)) ;
   wp2 : Id (Wt.Pn (suc m1) W) (Wt.Face[m1, W, k, hkb].Of[i3].face) pl =
    Sigma-eq (Wt.Coords (suc m1) W) (\ cs -> PB.Lands W W (Wt.oneS (suc m1) W cs) (PB.idH W))
     (Wt.Face[m1, W, k, hkb].Of[i3].face).1 pl.1 (Wt.Face[m1, W, k, hkb].Of[i3].face).2 pl.2
     (funext (Ar.Fin (suc (suc m1))) (\ j -> Hom W PFO.ivO) (Wt.Face[m1, W, k, hkb].Of[i3].face).1 pl.1
        (\ j -> Wt.Unface[m1, W, k, hkb, pl, z2].face-eq j))
     (PB.isProp-Lands W W (Wt.oneS (suc m1) W pl.1) (PB.idH W)) ;
   -- the two double unfacings agree (W3)
   w23 : Id (Wt.Pn m1 W) i2 i3 =
    Sigma-eq (Wt.Coords m1 W) (\ cs -> PB.Lands W W (Wt.oneS m1 W cs) (PB.idH W)) i2.1 i3.1 i2.2 i3.2
     (funext (Ar.Fin (suc m1)) (\ j -> Hom W PFO.ivO) i2.1 i3.1 (\ j -> Wt.W3[m1, W, k, k1, lt, hk'].coord ih j))
     (PB.isProp-Lands W W (Wt.oneS m1 W i3.1) (PB.idH W)) ;
   -- the value on the double face, along a composite of faces
   Xv (DD : K.DR m1 x z) (w : Wt.Pn m1 W) : W0.Ix (DA.Ez z W) = (A.tE z DD.1 DD.2.2).nt W (pzv m1 v' DD.1 DD.2.1 W F w) ;
   -- a face piece is the value on the double face
   sk : Id (W0.Ix (DA.Ez z W)) (Fk.pv W f lw) (Xv (K.dd m1 k1 k x z c) i2) =
    transH (apH ((A.tE z Fk.Dk.1 Fk.Dk.2.2).nt W)
              (transH (apH (\ q -> pzv (suc m1) p.1 Fk.Dk.1 Fk.Dk.2.1 W F q) (symH wp1))
                 (P3 Fk.Dk.1 Fk.Dk.2.1 W F i2 k1 hk')))
     (symH (A.tE-o z Fk.Dk.1 (K.fc m1 k1 x Fk.Dk.1 Fk.Dk.2.1).1 (K.fc m1 k1 x Fk.Dk.1 Fk.Dk.2.1).2.2 Fk.Dk.2.2 W
              (pzv m1 v' (K.fc m1 k1 x Fk.Dk.1 Fk.Dk.2.1).1 (K.fc m1 k1 x Fk.Dk.1 Fk.Dk.2.1).2.1 W F i2))) ;
   sl : Id (W0.Ix (DA.Ez z W)) (Fl.pv W f lw') (Xv (K.dd m1 k (suc k1) x z c) i3) =
    transH (apH ((A.tE z Fl.Dk.1 Fl.Dk.2.2).nt W)
              (transH (apH (\ q -> pzv (suc m1) p.1 Fl.Dk.1 Fl.Dk.2.1 W F q) (symH wp2))
                 (P3 Fl.Dk.1 Fl.Dk.2.1 W F i3 k hkb)))
     (symH (A.tE-o z Fl.Dk.1 (K.fc m1 k x Fl.Dk.1 Fl.Dk.2.1).1 (K.fc m1 k x Fl.Dk.1 Fl.Dk.2.1).2.2 Fl.Dk.2.2 W
              (pzv m1 v' (K.fc m1 k x Fl.Dk.1 Fl.Dk.2.1).1 (K.fc m1 k x Fl.Dk.1 Fl.Dk.2.1).2.1 W F i3))) ;
   res : Id (W0.Ix (DA.Ez z W)) (Fk.pv W f lw) (Fl.pv W f lw') =
    transH sk
     (transH (apH (\ DD -> Xv DD i2) (symH (K.ff-fc m1 k (suc k1) lt hk' x z c)))
       (transH (apH (\ w -> Xv (K.dd m1 k (suc k1) x z c) w) w23) (symH sl))) ;
  } ;

  -- at level 1 two face pieces never meet: P_0 has its coordinate 1
  module FF0 (p : Up zero) (z : CO) (c : K.Ch (suc zero) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc zero) J)
   (k k1 : Nat) (hk : Tr.IsT (Tr.leb k (suc zero))) (hk' : Tr.IsT (Tr.leb (suc k1) (suc zero))) (lt : Tr.IsT (Ar.ltb k (suc k1)))
   (W : Ob) (f : Hom W J)
   (lw : PB.Lands W J (FP[zero, p, z, c, J, g, i, k, hk].Q) f) (lw' : PB.Lands W J (FP[zero, p, z, c, J, g, i, suc k1, hk'].Q) f) {
   module Fk = FP[zero, p, z, c, J, g, i, k, hk] ;
   module Fl = FP[zero, p, z, c, J, g, i, suc k1, hk'] ;
   module Uk = Wt.Unface[zero, W, k, hk, Fk.ih W f, Fk.zh W f lw] ;
   module Ul = Wt.Unface[zero, W, suc k1, hk', Fl.ih W f, Fl.zh W f lw'] ;
   k10 : Id Nat k1 zero = Ar.leb-zero k1 hk' ;
   k0 : Id Nat k zero = Ar.leb-zero k (Tr.leb-trans k k1 zero lt hk') ;
   aux1 : (o1 : Nat) -> Tr.IsT (Ar.ltb (suc o1) (suc (suc zero))) -> (Id Nat (suc o1) (suc k1) -> Empty) -> Empty = split {
    zero -> \ h b -> b (ap Nat Nat (\ n -> suc n) zero k1 (sym Nat k1 zero k10)) ;
    suc o2 -> \ h b -> Tr.false-true h } ;
   aux : (o : Nat) -> Tr.IsT (Ar.ltb o (suc (suc zero))) -> (Id Nat o k -> Empty) -> (Id Nat o (suc k1) -> Empty) -> Empty = split {
    zero -> \ h a b -> a (sym Nat k zero k0) ;
    suc o1 -> \ h a b -> aux1 o1 h b } ;
   emp : Empty = aux Uk.out.1.1 Uk.out.1.2 (\ e -> Uk.notk e) (\ e -> Ul.notk e) ;
   res : Id (W0.Ix (DA.Ez z W)) (Fk.pv W f lw) (Fl.pv W f lw') = absurd _ emp ;
  } ;

  FFty (m : Nat) (p : Up m) (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc m) J) : U l =
   (k k1 : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (hk' : Tr.IsT (Tr.leb (suc k1) (suc m))) (lt : Tr.IsT (Ar.ltb k (suc k1)))
   (W : Ob) (f : Hom W J) (lw : PB.Lands W J (FP[m, p, z, c, J, g, i, k, hk].Q) f) (lw' : PB.Lands W J (FP[m, p, z, c, J, g, i, suc k1, hk'].Q) f)
   -> Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, suc k1, hk'].pv W f lw') ;

  ffP : (m : Nat) -> (p : Up m) (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc m) J) -> FFty m p z c J g i = split {
   zero -> \ p z c J g i k k1 hk hk' lt W f lw lw' -> FF0[p, z, c, J, g, i, k, k1, hk, hk', lt, W, f, lw, lw'].res ;
   suc m1 -> \ p z c J g i k k1 hk hk' lt W f lw lw' -> FFS[m1, p, z, c, J, g, i, k, k1, hk, hk', lt, W, f, lw, lw'].res } ;

  ----------------------------------------------------------------
  -- the pieces of level m+1 and their compatibility

  module PC (m : Nat) (p : Up m) (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc m) J) {
   module Pz = CP.Partials[G.ob z, A.ty z] ;
   r : Nat = suc (suc (suc m)) ;
   Sj : (j : Nat) -> Tr.IsT (Ar.ltb j (suc (suc (suc m)))) -> Pz.Side[J, gpt (suc m) z c J g i] = split {
    zero -> \ h -> Q0[suc m, z, c, J, g, i].side ;
    suc k -> \ h -> FP[m, p, z, c, J, g, i, k, h].side } ;
   -- the same face piece for two bound proofs
   sameK (k : Nat) (hk h2 : Tr.IsT (Tr.leb k (suc m))) (W : Ob) (f : Hom W J)
    (lw : PB.Lands W J (FP[m, p, z, c, J, g, i, k, hk].Q) f) (l2 : PB.Lands W J (FP[m, p, z, c, J, g, i, k, h2].Q) f)
    : Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k, h2].pv W f l2) =
    idJ (Tr.IsT (Tr.leb k (suc m))) hk
     (\ h3 e3 -> (l3 : PB.Lands W J (FP[m, p, z, c, J, g, i, k, h3].Q) f)
        -> Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k, h3].pv W f l3))
     (\ l3 -> Pz.pv-irr J (gpt (suc m) z c J g i) (FP[m, p, z, c, J, g, i, k, hk].side) W f lw l3)
     h2 (Ar.isProp-IsT' (Tr.leb k (suc m)) hk h2) l2 ;
   eqK (k k' : Nat) (e : Id Nat k k') (hk : Tr.IsT (Tr.leb k (suc m))) (hk' : Tr.IsT (Tr.leb k' (suc m))) (W : Ob) (f : Hom W J)
    (lw : PB.Lands W J (FP[m, p, z, c, J, g, i, k, hk].Q) f) (lw' : PB.Lands W J (FP[m, p, z, c, J, g, i, k', hk'].Q) f)
    : Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k', hk'].pv W f lw') =
    idJ Nat k
     (\ k2 e2 -> (h2 : Tr.IsT (Tr.leb k2 (suc m))) (l2 : PB.Lands W J (FP[m, p, z, c, J, g, i, k2, h2].Q) f)
        -> Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k2, h2].pv W f l2))
     (\ h2 l2 -> sameK k hk h2 W f lw l2) k' e hk' lw' ;
   ltA : (k' k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (hk' : Tr.IsT (Tr.leb k' (suc m))) (lt : Tr.IsT (Ar.ltb k k')) (W : Ob) (f : Hom W J)
    (lw : PB.Lands W J (FP[m, p, z, c, J, g, i, k, hk].Q) f) (lw' : PB.Lands W J (FP[m, p, z, c, J, g, i, k', hk'].Q) f)
    -> Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k', hk'].pv W f lw') = split {
    zero -> \ k hk hk' lt W f lw lw' -> absurd _ (Tr.false-true lt) ;
    suc k1 -> \ k hk hk' lt W f lw lw' -> ffP m p z c J g i k k1 hk hk' lt W f lw lw' } ;
   ffd (k k' : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (hk' : Tr.IsT (Tr.leb k' (suc m))) (W : Ob) (f : Hom W J)
    (lw : PB.Lands W J (FP[m, p, z, c, J, g, i, k, hk].Q) f) (lw' : PB.Lands W J (FP[m, p, z, c, J, g, i, k', hk'].Q) f)
    : Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k', hk'].pv W f lw') =
    Arith[l].eqN-dec (Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k', hk'].pv W f lw')) k k'
     (\ e -> eqK k k' e hk hk' W f lw lw')
     (\ ne -> Arith[l].ltb-dec (Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k', hk'].pv W f lw')) k k'
        (\ lt -> ltA k' k hk hk' lt W f lw lw')
        (\ le -> Arith[l].eqN-dec (Id (W0.Ix (DA.Ez z W)) (FP[m, p, z, c, J, g, i, k, hk].pv W f lw) (FP[m, p, z, c, J, g, i, k', hk'].pv W f lw')) k' k
           (\ e' -> eqK k k' (sym Nat k' k e') hk hk' W f lw lw')
           (\ ne' -> symH (ltA k k' hk' hk (Ar.leb-neq k' k le ne') W f lw' lw)))) ;
   cmp : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) (j' : Nat) (hj' : Tr.IsT (Ar.ltb j' (suc (suc (suc m))))) (W : Ob) (f : Hom W J)
    (lw : PB.Lands W J (Sj j hj).pQ f) (lw' : PB.Lands W J (Sj j' hj').pQ f)
    -> Id (W0.Ix (DA.Ez z W)) ((Sj j hj).pv W f lw) ((Sj j' hj').pv W f lw') = split {
    zero -> \ hj -> split {
     zero -> \ hj' W f lw lw' -> Pz.pv-irr J (gpt (suc m) z c J g i) Q0[suc m, z, c, J, g, i].side W f lw lw' ;
     suc k' -> \ hj' W f lw lw' -> QF m p z c J g i k' hj' W f lw lw' } ;
    suc k -> \ hj -> split {
     zero -> \ hj' W f lw lw' -> symH (QF m p z c J g i k hj W f lw' lw) ;
     suc k' -> \ hj' W f lw lw' -> ffd k k' hj hj' W f lw lw' } } ;
   module JN = CP.Join[G.ob z, A.ty z, J, gpt (suc m) z c J g i, suc (suc (suc m)), \ j -> Sj j.1 j.2,
     \ j j' W f lw lw' -> cmp j.1 j.2 j'.1 j'.2 W f lw lw'] ;
  } ;

  ----------------------------------------------------------------
  -- the step: level m+1 from the levels up to m

  module ST (m : Nat) (p : Up m) {
   Sfam (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc m) J)
    : CP.Partials[G.ob z, A.ty z].Side[J, gpt (suc m) z c J g i] = PC[m, p, z, c, J, g, i].JN.side ;
   module KK = KS[suc m, Sfam] ;
   vN : Vt (suc m) = KK.v ;

   -- naturality: the Join restricts to the Join at the restricted index
   module CO' (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc m) J) (J' : Ob) (h : Hom J' J) {
    module P0 = PC[m, p, z, c, J, g, i] ;
    module P1' = PC[m, p, z, c, J', PB.compH J' J X g h, Wt.Res[suc m, J', J, h, i].res] ;
    sEq : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m)))))
     -> Id (PB.Phi J') (PB.pre J' J h (P0.Sj j hj).pQ) (P1'.Sj j hj).pQ = split {
     zero -> \ hj -> PB.pre-comp J' J X h g s.pQ ;
     suc k -> \ hj -> PB.pre-comp J' J PFO.ivO h (i.1 (k, hj)) (PFO.ptSO PB.e0) } ;
    pco : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) (W : Ob) (f : Hom W J')
     (L : PB.Lands W J (P0.Sj j hj).pQ (PB.compH W J' J h f)) (L' : PB.Lands W J' (P1'.Sj j hj).pQ f)
     -> Id (W0.Ix (DA.Ez z W)) ((P0.Sj j hj).pv W (PB.compH W J' J h f) L) ((P1'.Sj j hj).pv W f L') = split {
     zero -> \ hj W f L L' ->
      transH (rdHom W (PB.compH W J X g (PB.compH W J' J h f)) (PB.compH W J' X (PB.compH J' J X g h) f)
                (symH (PB.comp-assoc W J' J X g h f))
                (Q0[suc m, z, c, J, g, i].lfh W (PB.compH W J' J h f) L)
                (Q0[suc m, z, c, J', PB.compH J' J X g h, Wt.Res[suc m, J', J, h, i].res].lfh W f L')
                (suc m, z, c, W, PB.idH W, (Wt.Res[suc m, W, J, PB.compH W J' J h f, i].res).1) (Wt.Res[suc m, W, J, PB.compH W J' J h f, i].res).2)
       (apH (\ q -> rd W (PB.compH W J' X (PB.compH J' J X g h) f)
                     (Q0[suc m, z, c, J', PB.compH J' J X g h, Wt.Res[suc m, J', J, h, i].res].lfh W f L') (suc m, z, c, W, PB.idH W, q.1) q.2)
          (symH (resres (suc m) W J' J h f i))) ;
     suc k -> \ hj W f L L' ->
      apH ((A.tE z (K.fc m k x z c).1 (K.fc m k x z c).2.2).nt W)
       (transH (apH (\ k' -> pzv m (top m p) (K.fc m k x z c).1 (K.fc m k x z c).2.1 W k' (FP[m, p, z, c, J, g, i, k, hj].pw W (PB.compH W J' J h f) L))
                  (symH (PB.comp-assoc W J' J X g h f)))
         (apH (\ q -> pzv m (top m p) (K.fc m k x z c).1 (K.fc m k x z c).2.1 W (PB.compH W J' X (PB.compH J' J X g h) f) q)
            (Sigma-eq (Wt.Coords m W) (\ cs -> PB.Lands W W (Wt.oneS m W cs) (PB.idH W))
               (FP[m, p, z, c, J, g, i, k, hj].pw W (PB.compH W J' J h f) L).1
               (FP[m, p, z, c, J', PB.compH J' J X g h, Wt.Res[suc m, J', J, h, i].res, k, hj].pw W f L').1
               (FP[m, p, z, c, J, g, i, k, hj].pw W (PB.compH W J' J h f) L).2
               (FP[m, p, z, c, J', PB.compH J' J X g h, Wt.Res[suc m, J', J, h, i].res, k, hj].pw W f L').2
               (funext (Ar.Fin (suc m)) (\ j -> Hom W PFO.ivO)
                  (FP[m, p, z, c, J, g, i, k, hj].pw W (PB.compH W J' J h f) L).1
                  (FP[m, p, z, c, J', PB.compH J' J X g h, Wt.Res[suc m, J', J, h, i].res, k, hj].pw W f L').1
                  (\ j -> symH (PB.comp-assoc W J' J PFO.ivO (i.1 (Wt.Face[m, W, k, hj].skipF j)) h f)))
               (PB.isProp-Lands W W (Wt.oneS m W (FP[m, p, z, c, J', PB.compH J' J X g h, Wt.Res[suc m, J', J, h, i].res, k, hj].pw W f L').1) (PB.idH W))))) } ;
    eQ : Id (PB.Phi J') (PB.pre J' J h P0.JN.Q) P1'.JN.Q =
     transH (PB.pre-bigU J' J h (suc (suc (suc m))) P0.JN.Qs)
      (apH (\ Qf -> PB.bigU J' (suc (suc (suc m))) Qf)
         (funext (Ar.Fin (suc (suc (suc m)))) (\ j -> PB.Phi J') (\ j -> PB.pre J' J h (P0.JN.Qs j)) P1'.JN.Qs (\ j -> sEq j.1 j.2))) ;
    ev (W : Ob) (f : Hom W J') (lw : PB.Lands W J' (PB.pre J' J h P0.JN.Q) f) (lw' : PB.Lands W J' P1'.JN.Q f)
     : Id (W0.Ix (DA.Ez z W)) (P0.JN.side.pv W (PB.compH W J' J h f) (PB.lands-pre W J' J h P0.JN.Q f lw)) (P1'.JN.side.pv W f lw') =
     transH (P0.JN.pv-in (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1 W (PB.compH W J' J h f)
               (PB.lands-pre W J' J h (P0.JN.Qs (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1) f
                  (subst (PB.Phi J') (\ Q' -> PB.Lands W J' Q' f)
                     (P1'.JN.Qs (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1)
                     (PB.pre J' J h (P0.JN.Qs (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1))
                     (symH (sEq (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1.1 (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1.2))
                     (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').2))
               (PB.lands-pre W J' J h P0.JN.Q f lw))
      (transH (pco (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1.1 (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1.2 W f
                 (PB.lands-pre W J' J h (P0.JN.Qs (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1) f
                    (subst (PB.Phi J') (\ Q' -> PB.Lands W J' Q' f)
                       (P1'.JN.Qs (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1)
                       (PB.pre J' J h (P0.JN.Qs (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1))
                       (symH (sEq (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1.1 (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1.2))
                       (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').2))
                 (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').2)
        (symH (P1'.JN.pv-in (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').1 W f (PB.bigU-out W J' (suc (suc (suc m))) P1'.JN.Qs f lw').2 lw'))) ;
    coh : Id (CP.Partials[G.ob z, A.ty z].Side[J', gpt (suc m) z c J' (PB.compH J' J X g h) (Wt.Res[suc m, J', J, h, i].res)])
          (subst (W0.Ix ((G.ob z).ob J')) (\ y -> CP.Partials[G.ob z, A.ty z].Side[J', y])
             ((G.ob z).act J' J h (gpt (suc m) z c J g i)) (gpt (suc m) z c J' (PB.compH J' J X g h) (Wt.Res[suc m, J', J, h, i].res))
             (gnat (suc m) z c J g i J' h)
             (CP.Partials[G.ob z, A.ty z].rside J' J h (gpt (suc m) z c J g i) P0.JN.side))
          P1'.JN.side =
     CP.Partials[G.ob z, A.ty z].side-extH J' ((G.ob z).act J' J h (gpt (suc m) z c J g i))
      (gpt (suc m) z c J' (PB.compH J' J X g h) (Wt.Res[suc m, J', J, h, i].res)) (gnat (suc m) z c J g i J' h)
      (CP.Partials[G.ob z, A.ty z].rside J' J h (gpt (suc m) z c J g i) P0.JN.side) P1'.JN.side eQ ev ;
   } ;
   p1N : P1t (suc m) vN = KK.p1 (\ z c J g i J' h -> CO'[z, c, J, g, i, J', h].coh) ;

   -- extension of s: kfull on piece 0
   p2N : P2t (suc m) vN =
    KK.p2 (\ W f lf z c J g' i -> PC[m, p, z, c, J, PB.compH J W X f g', i].JN.inS (zero, refl true) J (PB.idH J) (lid W f lf J g'))
     (\ W f lf z c J g' i ->
       transH (PC[m, p, z, c, J, PB.compH J W X f g', i].JN.pv-in (zero, refl true) J (PB.idH J) (lid W f lf J g')
                 (PC[m, p, z, c, J, PB.compH J W X f g', i].JN.inS (zero, refl true) J (PB.idH J) (lid W f lf J g')))
        (Q0ext (suc m) W f lf z c J g' i (lid W f lf J g'))) ;

   -- faces: kfull on the face piece k at a face weight
   module FC' (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn m J) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) {
    F : Wt.Pn (suc m) J = Wt.Face[m, J, k, hk].Of[i].face ;
    cp : Id (Hom J PFO.ivO) (F.1 (k, hk)) (PB.ptH J PB.e0) = Wt.Face[m, J, k, hk].valB-path i.1 k hk true (Tr.eqN-refl k) ;
    lk : PB.Lands J J (FP[m, p, z, c, J, g, F, k, hk].Q) (PB.idH J) =
     PB.pre-lands J J PFO.ivO (F.1 (k, hk)) (PFO.ptSO PB.e0) (PB.idH J)
      (PB.lands-eq J PFO.ivO (PFO.ptSO PB.e0) (PB.ptH J PB.e0) (PB.compH J J PFO.ivO (F.1 (k, hk)) (PB.idH J))
         (symH (transH (PB.comp-idr J PFO.ivO (F.1 (k, hk))) cp)) (PFO.pt-landsO J PB.e0)) ;
    liN : PB.Lands J J PC[m, p, z, c, J, g, F].JN.Q (PB.idH J) = PC[m, p, z, c, J, g, F].JN.inS (suc k, hk) J (PB.idH J) lk ;
    wpI : Id (Wt.Pn m J) (FP[m, p, z, c, J, g, F, k, hk].pw J (PB.idH J) lk) i =
     Sigma-eq (Wt.Coords m J) (\ cs -> PB.Lands J J (Wt.oneS m J cs) (PB.idH J))
      (FP[m, p, z, c, J, g, F, k, hk].pw J (PB.idH J) lk).1 i.1 (FP[m, p, z, c, J, g, F, k, hk].pw J (PB.idH J) lk).2 i.2
      (funext (Ar.Fin (suc m)) (\ j -> Hom J PFO.ivO) (FP[m, p, z, c, J, g, F, k, hk].pw J (PB.idH J) lk).1 i.1
         (\ j -> transH (PB.comp-idr J PFO.ivO (F.1 (Wt.Face[m, J, k, hk].skipF j))) (Wt.Face[m, J, k, hk].face-skip i.1 j)))
      (PB.isProp-Lands J J (Wt.oneS m J i.1) (PB.idH J)) ;
    res : Id (W0.Ix (DA.Ez z J)) (pzv (suc m) vN z c J g F)
            ((A.tE z (K.fc m k x z c).1 (K.fc m k x z c).2.2).nt J (pzv m (top m p) (K.fc m k x z c).1 (K.fc m k x z c).2.1 J g i)) =
     transH (CP.Rel[G.ob z, A.ty z, A.ty z, CP.pmap-id (G.ob z) (A.ty z)].kfull (al z) J (gpt (suc m) z c J g F) (Sfam z c J g F) liN)
      (transH (PC[m, p, z, c, J, g, F].JN.pv-in (suc k, hk) J (PB.idH J) lk liN)
        (apH ((A.tE z (K.fc m k x z c).1 (K.fc m k x z c).2.2).nt J)
           (transH (apH (\ k' -> pzv m (top m p) (K.fc m k x z c).1 (K.fc m k x z c).2.1 J k' (FP[m, p, z, c, J, g, F, k, hk].pw J (PB.idH J) lk))
                      (PB.comp-idr J X g))
              (apH (\ q -> pzv m (top m p) (K.fc m k x z c).1 (K.fc m k x z c).2.1 J g q) wpI)))) ;
   } ;
   p3N : P3t m vN (top m p) = \ z c J g i k hk -> FC'[z, c, J, g, i, k, hk].res ;

   step : Up (suc m) = (vN, p1N, p2N, p, p3N) ;
  } ;

  -- all the levels
  build : (n : Nat) -> Up n = split {
   zero -> lev0 ;
   suc m | r -> ST[m, r].step } ;

  ----------------------------------------------------------------
  -- the extension: the family of all levels, and its equations

  lv (n : Nat) : Vt n = top n (build n) ;
  uX : DA.TA x X gm = \ q l -> lv q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1 (q.2.2.2.2.2, l) ;
  anat' : W0.Ix (DA.anatEq x X gm uX) = \ r l ->
   p1of r.1.1 (build r.1.1) r.1.2.1 r.1.2.2.1 r.1.2.2.2.1 r.1.2.2.2.2.1 (r.1.2.2.2.2.2, l) r.2.1 r.2.2 ;
  -- the faces of level n+1 relative to level n
  p3b (n : Nat) : P3t n (lv (suc n)) (lv n) = (build (suc n)).2.2.2.2 ;
  aface' : W0.Ix (DA.afaceEq x X gm uX) = \ r l ->
   transH (p3b r.1 r.2.2.2.1 r.2.2.2.2.1 r.2.2.2.2.2.1 r.2.2.2.2.2.2.1 (r.2.2.2.2.2.2.2, l) r.2.1 (Ar.leb-step r.2.1 r.1 r.2.2.1))
    (transH (apH (\ DR' -> (A.tE r.2.2.2.1 DR'.1 DR'.2.2).nt r.2.2.2.2.2.1
                            (pzv r.1 (lv r.1) DR'.1 DR'.2.1 r.2.2.2.2.2.1 r.2.2.2.2.2.2.1 (r.2.2.2.2.2.2.2, l)))
               (K.fc-comp r.1 r.2.1 r.2.2.1 x r.2.2.2.1 r.2.2.2.2.1))
      (A.tE-id r.2.2.2.1 r.2.2.2.2.2.1
         (pzv r.1 (lv r.1) r.2.2.2.1 (K.comp r.1 r.2.1 x r.2.2.2.1 r.2.2.2.2.1) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1 (r.2.2.2.2.2.2.2, l)))) ;
  atop' : W0.Ix (DA.atopEq x X gm uX) = \ r l ->
   transH (p3b r.1 r.2.1 r.2.2.1 r.2.2.2.1 r.2.2.2.2.1 (r.2.2.2.2.2, l) (suc r.1) (Tr.leb-refl (suc r.1)))
    (apH (\ DR' -> (A.tE r.2.1 DR'.1 DR'.2.2).nt r.2.2.2.1
                    (pzv r.1 (lv r.1) DR'.1 DR'.2.1 r.2.2.2.1 r.2.2.2.2.1 (r.2.2.2.2.2, l)))
       (K.fc-top r.1 x r.2.1 r.2.2.1)) ;
  kop : DA.TOb' x X gm = (uX, anat', aface', atop') ;

  -- it extends s
  kside (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f)
   : Id (DA.TotD x W) ((extP (D.obD x) (DA.DTy x)).act W X f (pairE (D.obD x) (DA.DTy x) X gm kop)) (s.pv W f lf) =
   DA.totD-eq x W ((extP (D.obD x) (DA.DTy x)).act W X f (pairE (D.obD x) (DA.DTy x) X gm kop)) (s.pv W f lf)
    (symH (s.ppt W f lf))
    (\ q l -> transH (DA.TB[x, W, X, f, gm, D.BA[x, W, X, f, gm].res, refl (D.BA[x, W, X, f, gm].res), kop].pc q l)
                (p2of q.1 (build q.1) W f lf q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1 (q.2.2.2.2.2, l))) ;
 } ;

 ------------------------------------------------------------------
 -- uniformity in the base: the extension at the restricted point and
 -- side is the restriction of the extension (by induction on levels)

 module KU (al : (z : CO) -> CP.ContrOp (G.ob z) (A.ty z)) (x : CO) (Y X : Ob) (h : Hom Y X) (gm : D.Ob' x X)
  (s : CP.Partials[D.obD x, DA.DTy x].Side[X, gm]) {
  module FX = Fx[al, x, X, gm, s] ;
  gmY : D.Ob' x Y = D.BA[x, Y, X, h, gm].res ;
  sY : CP.Partials[D.obD x, DA.DTy x].Side[Y, gmY] = CP.Partials[D.obD x, DA.DTy x].rside Y X h gm s ;
  module FY = Fx[al, x, Y, gmY, sY] ;

  EQt (n : Nat) : U l = (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J Y) (i : Wt.Pn n J)
   -> Id (W0.Ix (DA.Ez z J)) (FX.pzv n (FX.lv n) z c J (PB.compH J Y X h g) i) (FY.pzv n (FY.lv n) z c J g i) ;

  -- piece 0 at the two problems
  p0 (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J Y) (i : Wt.Pn n J) (W : Ob) (f : Hom W J)
   (lw : PB.Lands W J (FX.Q0[n, z, c, J, PB.compH J Y X h g, i].Q) f) (lw' : PB.Lands W J (FY.Q0[n, z, c, J, g, i].Q) f)
   : Id (W0.Ix (DA.Ez z W)) (FX.Q0[n, z, c, J, PB.compH J Y X h g, i].pv W f lw) (FY.Q0[n, z, c, J, g, i].pv W f lw') =
   FX.rdHom W (PB.compH W J X (PB.compH J Y X h g) f) (PB.compH W Y X h (PB.compH W J Y g f)) (PB.comp-assoc W J Y X h g f)
    (FX.Q0[n, z, c, J, PB.compH J Y X h g, i].lfh W f lw)
    (PB.lands-pre W Y X h s.pQ (PB.compH W J Y g f) (FY.Q0[n, z, c, J, g, i].lfh W f lw'))
    (n, z, c, W, PB.idH W, (Wt.Res[n, W, J, f, i].res).1) (Wt.Res[n, W, J, f, i].res).2 ;

  EQ0 : EQt zero = \ z c J g i ->
   apH (\ S2 -> DA.prz z J (FY.gpt zero z c J g i) ((al z).kop J (FY.gpt zero z c J g i) S2))
    (CP.Partials[G.ob z, A.ty z].side-ext J (FY.gpt zero z c J g i)
       FX.Q0[zero, z, c, J, PB.compH J Y X h g, i].side FY.Q0[zero, z, c, J, g, i].side
       (symH (PB.pre-comp J Y X g h s.pQ)) (\ W f lw lw' -> p0 zero z c J g i W f lw lw')) ;

  module SS (m : Nat) (ih : EQt m) (z : CO) (c : K.Ch (suc m) x z) (J : Ob) (g : Hom J Y) (i : Wt.Pn (suc m) J) {
   module PX = FX.PC[m, FX.build m, z, c, J, PB.compH J Y X h g, i] ;
   module PY = FY.PC[m, FY.build m, z, c, J, g, i] ;
   qEq : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) -> Id (PB.Phi J) (PX.Sj j hj).pQ (PY.Sj j hj).pQ = split {
    zero -> \ hj -> symH (PB.pre-comp J Y X g h s.pQ) ;
    suc k -> \ hj -> refl (PB.pre J PFO.ivO (i.1 (k, hj)) (PFO.ptSO PB.e0)) } ;
   ppv : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) (W : Ob) (f : Hom W J)
    (L : PB.Lands W J (PX.Sj j hj).pQ f) (L' : PB.Lands W J (PY.Sj j hj).pQ f)
    -> Id (W0.Ix (DA.Ez z W)) ((PX.Sj j hj).pv W f L) ((PY.Sj j hj).pv W f L') = split {
    zero -> \ hj W f L L' -> p0 (suc m) z c J g i W f L L' ;
    suc k -> \ hj W f L L' ->
     apH ((A.tE z (K.fc m k x z c).1 (K.fc m k x z c).2.2).nt W)
      (transH (apH (\ k' -> FX.pzv m (FX.lv m) (K.fc m k x z c).1 (K.fc m k x z c).2.1 W k'
                            (FX.FP[m, FX.build m, z, c, J, PB.compH J Y X h g, i, k, hj].pw W f L))
                 (PB.comp-assoc W J Y X h g f))
        (transH (apH (\ q -> FX.pzv m (FX.lv m) (K.fc m k x z c).1 (K.fc m k x z c).2.1 W (PB.compH W Y X h (PB.compH W J Y g f)) q)
                   (Sigma-eq (Wt.Coords m W) (\ cs -> PB.Lands W W (Wt.oneS m W cs) (PB.idH W))
                      (FX.FP[m, FX.build m, z, c, J, PB.compH J Y X h g, i, k, hj].pw W f L).1
                      (FY.FP[m, FY.build m, z, c, J, g, i, k, hj].pw W f L').1
                      (FX.FP[m, FX.build m, z, c, J, PB.compH J Y X h g, i, k, hj].pw W f L).2
                      (FY.FP[m, FY.build m, z, c, J, g, i, k, hj].pw W f L').2
                      (refl (FY.FP[m, FY.build m, z, c, J, g, i, k, hj].pw W f L').1)
                      (PB.isProp-Lands W W (Wt.oneS m W (FY.FP[m, FY.build m, z, c, J, g, i, k, hj].pw W f L').1) (PB.idH W))))
          (ih (K.fc m k x z c).1 (K.fc m k x z c).2.1 W (PB.compH W J Y g f) (FY.FP[m, FY.build m, z, c, J, g, i, k, hj].pw W f L')))) } ;
   eQ : Id (PB.Phi J) PX.JN.Q PY.JN.Q =
    apH (\ Qf -> PB.bigU J (suc (suc (suc m))) Qf)
     (funext (Ar.Fin (suc (suc (suc m)))) (\ j -> PB.Phi J) PX.JN.Qs PY.JN.Qs (\ j -> qEq j.1 j.2)) ;
   ev (W : Ob) (f : Hom W J) (lw : PB.Lands W J PX.JN.Q f) (lw' : PB.Lands W J PY.JN.Q f)
    : Id (W0.Ix (DA.Ez z W)) (PX.JN.side.pv W f lw) (PY.JN.side.pv W f lw') =
    transH (PX.JN.pv-in (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1 W f
              (subst (PB.Phi J) (\ Q' -> PB.Lands W J Q' f)
                 (PY.JN.Qs (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1) (PX.JN.Qs (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1)
                 (symH (qEq (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.1 (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.2))
                 (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').2)
              lw)
     (transH (ppv (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.1 (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.2 W f
                (subst (PB.Phi J) (\ Q' -> PB.Lands W J Q' f)
                   (PY.JN.Qs (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1) (PX.JN.Qs (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1)
                   (symH (qEq (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.1 (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.2))
                   (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').2)
                (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').2)
       (symH (PY.JN.pv-in (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1 W f (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').2 lw'))) ;
   res : Id (W0.Ix (DA.Ez z J)) (FX.pzv (suc m) (FX.lv (suc m)) z c J (PB.compH J Y X h g) i) (FY.pzv (suc m) (FY.lv (suc m)) z c J g i) =
    apH (\ S2 -> DA.prz z J (FY.gpt (suc m) z c J g i) ((al z).kop J (FY.gpt (suc m) z c J g i) S2))
     (CP.Partials[G.ob z, A.ty z].side-ext J (FY.gpt (suc m) z c J g i) PX.JN.side PY.JN.side eQ ev) ;
  } ;

  EQ : (n : Nat) -> EQt n = split {
   zero -> EQ0 ;
   suc m | ih -> \ z c J g i -> SS[m, ih, z, c, J, g, i].res } ;

  kunif : Id (DA.TotD x Y) ((extP (D.obD x) (DA.DTy x)).act Y X h (pairE (D.obD x) (DA.DTy x) X gm FX.kop))
            (pairE (D.obD x) (DA.DTy x) Y gmY FY.kop) =
   DA.totD-eq x Y ((extP (D.obD x) (DA.DTy x)).act Y X h (pairE (D.obD x) (DA.DTy x) X gm FX.kop)) (pairE (D.obD x) (DA.DTy x) Y gmY FY.kop)
    (refl gmY)
    (\ q l -> transH (DA.TB[x, Y, X, h, gm, gmY, refl gmY, FX.kop].pc q l) (EQ q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1 (q.2.2.2.2.2, l))) ;
 } ;

 ------------------------------------------------------------------
 -- LEMMA 12 (levelwise): D sends a levelwise trivial fibration to a
 -- trivial fibration at every x

 lemma12 (al : (z : CO) -> CP.ContrOp (G.ob z) (A.ty z)) (x : CO) : CP.ContrOp (D.obD x) (DA.DTy x) =
  CP.Rel[D.obD x, DA.DTy x, DA.DTy x, CP.pmap-id (D.obD x) (DA.DTy x)].mkRC
   (\ X gm s -> Fx[al, x, X, gm, s].kop)
   (\ X gm s W f lf -> Fx[al, x, X, gm, s].kside W f lf)
   (\ Y X h gm s -> KU[al, x, Y, X, h, gm, s].kunif) ;

 ------------------------------------------------------------------
 -- uniformity in C: the extension at x' for the moved point and side is
 -- the C-action of the extension at x (by induction on levels)

 module KC (al : (z : CO) -> CP.ContrOp (G.ob z) (A.ty z)) (x' x : CO) (gC : P.CH x' x) (X : Ob) (gm : D.Ob' x X)
  (s : CP.Partials[D.obD x, DA.DTy x].Side[X, gm]) {
  module FXx = Fx[al, x, X, gm, s] ;
  gmy : D.Ob' x' X = D.CA[x', x, gC, X, gm].res ;
  sy : CP.Partials[D.obD x', DA.DTy x'].Side[X, gmy] = P.MapSide[D.DCtx, DA.DCTy, x', x, gC].mapside X gm s ;
  module FXy = Fx[al, x', X, gmy, sy] ;

  EQt (n : Nat) : U l = (z : CO) (c : K.Ch n x' z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J)
   -> Id (W0.Ix (DA.Ez z J)) (FXx.pzv n (FXx.lv n) z (K.rx n x' x gC z c) J g i) (FXy.pzv n (FXy.lv n) z c J g i) ;

  p0 (n : Nat) (z : CO) (c : K.Ch n x' z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) (W : Ob) (f : Hom W J)
   (lw : PB.Lands W J (FXx.Q0[n, z, K.rx n x' x gC z c, J, g, i].Q) f) (lw' : PB.Lands W J (FXy.Q0[n, z, c, J, g, i].Q) f)
   : Id (W0.Ix (DA.Ez z W)) (FXx.Q0[n, z, K.rx n x' x gC z c, J, g, i].pv W f lw) (FXy.Q0[n, z, c, J, g, i].pv W f lw') =
   FXx.rdHom W (PB.compH W J X g f) (PB.compH W J X g f) (refl (PB.compH W J X g f))
    (FXx.Q0[n, z, K.rx n x' x gC z c, J, g, i].lfh W f lw) (FXy.Q0[n, z, c, J, g, i].lfh W f lw')
    (n, z, K.rx n x' x gC z c, W, PB.idH W, (Wt.Res[n, W, J, f, i].res).1) (Wt.Res[n, W, J, f, i].res).2 ;

  EQ0 : EQt zero = \ z c J g i ->
   apH (\ S2 -> DA.prz z J (FXy.gpt zero z c J g i) ((al z).kop J (FXy.gpt zero z c J g i) S2))
    (CP.Partials[G.ob z, A.ty z].side-ext J (FXy.gpt zero z c J g i)
       FXx.Q0[zero, z, K.rx zero x' x gC z c, J, g, i].side FXy.Q0[zero, z, c, J, g, i].side
       (refl (PB.pre J X g s.pQ)) (\ W f lw lw' -> p0 zero z c J g i W f lw lw')) ;

  module SS (m : Nat) (ih : EQt m) (z : CO) (c : K.Ch (suc m) x' z) (J : Ob) (g : Hom J X) (i : Wt.Pn (suc m) J) {
   module PX = FXx.PC[m, FXx.build m, z, K.rx (suc m) x' x gC z c, J, g, i] ;
   module PY = FXy.PC[m, FXy.build m, z, c, J, g, i] ;
   qEq : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) -> Id (PB.Phi J) (PX.Sj j hj).pQ (PY.Sj j hj).pQ = split {
    zero -> \ hj -> refl (PB.pre J X g s.pQ) ;
    suc k -> \ hj -> refl (PB.pre J PFO.ivO (i.1 (k, hj)) (PFO.ptSO PB.e0)) } ;
   ppv : (j : Nat) (hj : Tr.IsT (Ar.ltb j (suc (suc (suc m))))) (W : Ob) (f : Hom W J)
    (L : PB.Lands W J (PX.Sj j hj).pQ f) (L' : PB.Lands W J (PY.Sj j hj).pQ f)
    -> Id (W0.Ix (DA.Ez z W)) ((PX.Sj j hj).pv W f L) ((PY.Sj j hj).pv W f L') = split {
    zero -> \ hj W f L L' -> p0 (suc m) z c J g i W f L L' ;
    suc k -> \ hj W f L L' ->
     transH (apH (\ DR' -> (A.tE z DR'.1 DR'.2.2).nt W
                    (FXx.pzv m (FXx.lv m) DR'.1 DR'.2.1 W (PB.compH W J X g f)
                       (FXx.FP[m, FXx.build m, z, K.rx (suc m) x' x gC z c, J, g, i, k, hj].pw W f L)))
               (K.rx-fc m k x' x gC z c))
      (apH ((A.tE z (K.fc m k x' z c).1 (K.fc m k x' z c).2.2).nt W)
        (transH (apH (\ q -> FXx.pzv m (FXx.lv m) (K.fc m k x' z c).1 (K.rx m x' x gC (K.fc m k x' z c).1 (K.fc m k x' z c).2.1) W (PB.compH W J X g f) q)
                   (Sigma-eq (Wt.Coords m W) (\ cs -> PB.Lands W W (Wt.oneS m W cs) (PB.idH W))
                      (FXx.FP[m, FXx.build m, z, K.rx (suc m) x' x gC z c, J, g, i, k, hj].pw W f L).1
                      (FXy.FP[m, FXy.build m, z, c, J, g, i, k, hj].pw W f L').1
                      (FXx.FP[m, FXx.build m, z, K.rx (suc m) x' x gC z c, J, g, i, k, hj].pw W f L).2
                      (FXy.FP[m, FXy.build m, z, c, J, g, i, k, hj].pw W f L').2
                      (refl (FXy.FP[m, FXy.build m, z, c, J, g, i, k, hj].pw W f L').1)
                      (PB.isProp-Lands W W (Wt.oneS m W (FXy.FP[m, FXy.build m, z, c, J, g, i, k, hj].pw W f L').1) (PB.idH W))))
          (ih (K.fc m k x' z c).1 (K.fc m k x' z c).2.1 W (PB.compH W J X g f) (FXy.FP[m, FXy.build m, z, c, J, g, i, k, hj].pw W f L')))) } ;
   eQ : Id (PB.Phi J) PX.JN.Q PY.JN.Q =
    apH (\ Qf -> PB.bigU J (suc (suc (suc m))) Qf)
     (funext (Ar.Fin (suc (suc (suc m)))) (\ j -> PB.Phi J) PX.JN.Qs PY.JN.Qs (\ j -> qEq j.1 j.2)) ;
   ev (W : Ob) (f : Hom W J) (lw : PB.Lands W J PX.JN.Q f) (lw' : PB.Lands W J PY.JN.Q f)
    : Id (W0.Ix (DA.Ez z W)) (PX.JN.side.pv W f lw) (PY.JN.side.pv W f lw') =
    transH (PX.JN.pv-in (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1 W f
              (subst (PB.Phi J) (\ Q' -> PB.Lands W J Q' f)
                 (PY.JN.Qs (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1) (PX.JN.Qs (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1)
                 (symH (qEq (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.1 (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.2))
                 (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').2)
              lw)
     (transH (ppv (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.1 (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.2 W f
                (subst (PB.Phi J) (\ Q' -> PB.Lands W J Q' f)
                   (PY.JN.Qs (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1) (PX.JN.Qs (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1)
                   (symH (qEq (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.1 (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1.2))
                   (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').2)
                (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').2)
       (symH (PY.JN.pv-in (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').1 W f (PB.bigU-out W J (suc (suc (suc m))) PY.JN.Qs f lw').2 lw'))) ;
   res : Id (W0.Ix (DA.Ez z J)) (FXx.pzv (suc m) (FXx.lv (suc m)) z (K.rx (suc m) x' x gC z c) J g i) (FXy.pzv (suc m) (FXy.lv (suc m)) z c J g i) =
    apH (\ S2 -> DA.prz z J (FXy.gpt (suc m) z c J g i) ((al z).kop J (FXy.gpt (suc m) z c J g i) S2))
     (CP.Partials[G.ob z, A.ty z].side-ext J (FXy.gpt (suc m) z c J g i) PX.JN.side PY.JN.side eQ ev) ;
  } ;

  EQ : (n : Nat) -> EQt n = split {
   zero -> EQ0 ;
   suc m | ih -> \ z c J g i -> SS[m, ih, z, c, J, g, i].res } ;

  res : Id (DA.TotD x' X) ((DA.tEC x' x gC).nt X (pairE (D.obD x) (DA.DTy x) X gm FXx.kop)) (pairE (D.obD x') (DA.DTy x') X gmy FXy.kop) =
   DA.totD-eq x' X ((DA.tEC x' x gC).nt X (pairE (D.obD x) (DA.DTy x) X gm FXx.kop)) (pairE (D.obD x') (DA.DTy x') X gmy FXy.kop)
    (refl gmy)
    (\ q l -> EQ q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1 (q.2.2.2.2.2, l)) ;
 } ;

 ------------------------------------------------------------------
 -- LEMMA 12: D sends a levelwise trivial fibration to one uniform in C

 lemma12U (al : (z : CO) -> CP.ContrOp (G.ob z) (A.ty z)) : P.UTriv D.DCtx DA.DCTy =
  (\ x -> lemma12 al x, \ x' x gC X gm s -> KC[al, x', x, gC, X, gm, s].res) ;
} ;
