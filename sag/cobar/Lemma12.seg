-- Lemma12.seg (canonicity-45; COBAR.md "Lemma 12, detailed proof"): D
-- sends a levelwise trivial fibration to a trivial fibration.
--
-- Part 1 (this part): the uniform face equations.  For an element of D G
-- (resp. of D A over it), the value at the face d_k i of a weight, k <=
-- n+1, is the value at i on the chain d_k c = fc n k c, moved along its
-- map (the identity for k <= n, the last map for k = n+1):
--   ufD : t (n+1 , c , d_k i) = act fm (t (n , c' , i))
--   ufA : the same in the totals E_z, with A.tE fm
-- PLAN of the remaining parts (x , X , gamma : D.Ob' x X and a side s of
-- DA at gamma fixed; all comparisons of weights through coordinates, a set):
--  V n      values v z c J g i : (A z) J (gamma (n , z , c , J , g , i))
--  P1 n     naturality in the base, in E_z (the form of anat)
--  P2 n     extension of s: prz (gamma (.. J (f g') i)) (v .. (f g') i)
--           = s.pv W f lf read at (.. J g' i)  (through TB.pc)
--  P3 (m+1) faces: prz at (m+1 , c , d_k i) = A.tE (fc m k c) (prz at level m)
--  Up 0 = V 0 * P1 * P2 ;  Up (m+1) = (p : Up m) * V (m+1) * P1 * P2 * P3,
--  step by split on m (two face pieces cannot meet at level 1: P_0 has
--  i_0 = 1).  Level m+1 at (z , c , J , g , i): kop of al z on the Join of
--   piece 0     s on pre g Q, read at (m+1 , z , c , W , id , res h i);
--   piece k+1   [i_k = 0] (k <= m+1): A.tE (fc m k c) (level m at
--               Unface_k (res h i)).
--  Join compatibility: (0 , k+1) by P2 at level m and UA.uf for s;
--  (k+1 , l+1) by P3 at level m twice, A.tE-o, K.ff-fc and Weights.W3.
--  P1 by kunif and kop-cong; P2 by kfull on piece 0; P3 by kfull on piece
--  k+1 at a face weight (Unface of a face = face-skip).  Then lemma12 x :
--  ContrOp (obD x) (DTy x) (kside from P2, kunif by induction on levels
--  with kop-cong), and UTriv by reindexing (as Lemma 9).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module L12 (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A : CPshC[a, l].CPsh[C].CTy[G]) {
 module P = CPshC[a, l].CPsh[C] ;
 module K = Chains[a].ChainsOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module D = DD.DC[G] ;
 module DA = DD.DT[G, A] ;
 CO : U a = P.CO ;

 ------------------------------------------------------------------
 -- the face of a weight does not depend on the bound proof

 valIrr (n : Nat) (J : Ob) (y : Nat) (hy hy' : Tr.IsT (Tr.leb y (suc n))) (i : Wt.Coords n J) (jn : Nat) (hj : Tr.IsT (Tr.leb jn (suc n)))
  : (b : Bool) -> (e : Id Bool (eqN jn y) b)
    -> Id (Hom J PB.Iv) (Wt.Face[n, J, y, hy].valB i jn hj b e) (Wt.Face[n, J, y, hy'].valB i jn hj b e) = split {
  true -> \ e -> refl (PB.ptH J PB.e0) ;
  false -> \ e -> refl (i (Ar.dg n y jn, Ar.dg-range n y jn hj)) } ;

 faceW-irr (n : Nat) (J : Ob) (y : Nat) (hy hy' : Tr.IsT (Tr.leb y (suc n))) (i : Wt.Pn n J)
  : Id (Wt.Pn (suc n) J) (Wt.Face[n, J, y, hy].Of[i].face) (Wt.Face[n, J, y, hy'].Of[i].face) =
  Sigma-eq (Wt.Coords (suc n) J) (\ cs -> PB.Lands J J (Wt.oneS (suc n) J cs) (PB.idH J))
   (Wt.Face[n, J, y, hy].Of[i].face).1 (Wt.Face[n, J, y, hy'].Of[i].face).1
   (Wt.Face[n, J, y, hy].Of[i].face).2 (Wt.Face[n, J, y, hy'].Of[i].face).2
   (funext (Ar.Fin (suc (suc n))) (\ j -> Hom J PB.Iv) (Wt.Face[n, J, y, hy].Of[i].face).1 (Wt.Face[n, J, y, hy'].Of[i].face).1
      (\ j -> valIrr n J y hy hy' i.1 j.1 j.2 (eqN j.1 y) (refl (eqN j.1 y))))
   (PB.isProp-Lands J J (Wt.oneS (suc n) J (Wt.Face[n, J, y, hy'].Of[i].face).1) (PB.idH J)) ;

 ------------------------------------------------------------------
 -- uniform faces of an element of D G

 module UD (x : CO) (X : Ob) (u : D.Ob' x X) (n : Nat) (z : CO) (c : K.Ch (suc n) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) {
  fcD (k : Nat) : K.DR n x z = K.fc n k x z c ;
  rhs (k : Nat) : W0.Ix ((G.ob z).ob J) =
   (G.act z (fcD k).1 (fcD k).2.2).nt J (u.1 (n, (fcD k).1, (fcD k).2.1, J, g, i.1) i.2) ;
  lhs (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : W0.Ix ((G.ob z).ob J) =
   D.at x X u.1 (suc n) z c J g (Wt.Face[n, J, k, hk].Of[i].face) ;
  -- the value at a face does not depend on the bound proof
  lhs-irr (k : Nat) (hk hk' : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix ((G.ob z).ob J)) (lhs k hk) (lhs k hk') =
   apH (\ p -> u.1 (suc n, z, c, J, g, p.1) p.2) (faceW-irr n J k hk hk' i) ;
  low (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (hk' : Tr.IsT (Tr.leb k n)) : Id (W0.Ix ((G.ob z).ob J)) (lhs k hk) (rhs k) =
   transH (lhs-irr k hk (Ar.leb-step k n hk'))
    (transH (u.2.2.1 (n, k, hk', z, c, J, g, i.1) i.2)
      (transH (symH (G.act-id z J (u.1 (n, z, K.comp n k x z c, J, g, i.1) i.2)))
        (apH (\ DR' -> (G.act z DR'.1 DR'.2.2).nt J (u.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2))
           (symH (K.fc-comp n k hk' x z c))))) ;
  top (hk : Tr.IsT (Tr.leb (suc n) (suc n))) : Id (W0.Ix ((G.ob z).ob J)) (lhs (suc n) hk) (rhs (suc n)) =
   transH (lhs-irr (suc n) hk (Tr.leb-refl (suc n)))
    (transH (u.2.2.2 (n, z, c, J, g, i.1) i.2)
      (apH (\ DR' -> (G.act z DR'.1 DR'.2.2).nt J (u.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2))
         (symH (K.fc-top n x z c)))) ;
  uf (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix ((G.ob z).ob J)) (lhs k hk) (rhs k) =
   Arith[l].eqN-dec (Id (W0.Ix ((G.ob z).ob J)) (lhs k hk) (rhs k)) k (suc n)
    (\ e -> idJ Nat (suc n) (\ k2 e2 -> (h2 : Tr.IsT (Tr.leb k2 (suc n))) -> Id (W0.Ix ((G.ob z).ob J)) (lhs k2 h2) (rhs k2))
              (\ h2 -> top h2) k (sym Nat k (suc n) e) hk)
    (\ ne -> low k hk (Ar.leb-suc-neq k n hk ne)) ;
 } ;

 ------------------------------------------------------------------
 -- uniform faces of an element of D A over u, in the totals

 module UA (x : CO) (X : Ob) (u : D.Ob' x X) (av : DA.TOb' x X u) (n : Nat) (z : CO) (c : K.Ch (suc n) x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) {
  fcD (k : Nat) : K.DR n x z = K.fc n k x z c ;
  rhs (k : Nat) : W0.Ix (DA.Ez z J) =
   (A.tE z (fcD k).1 (fcD k).2.2).nt J
    (DA.prz (fcD k).1 J (u.1 (n, (fcD k).1, (fcD k).2.1, J, g, i.1) i.2) (av.1 (n, (fcD k).1, (fcD k).2.1, J, g, i.1) i.2)) ;
  lhs (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : W0.Ix (DA.Ez z J) =
   DA.prz z J (u.1 (suc n, z, c, J, g, (Wt.Face[n, J, k, hk].Of[i].face).1) (Wt.Face[n, J, k, hk].Of[i].face).2)
              (av.1 (suc n, z, c, J, g, (Wt.Face[n, J, k, hk].Of[i].face).1) (Wt.Face[n, J, k, hk].Of[i].face).2) ;
  lhs-irr (k : Nat) (hk hk' : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix (DA.Ez z J)) (lhs k hk) (lhs k hk') =
   apH (\ p -> DA.prz z J (u.1 (suc n, z, c, J, g, p.1) p.2) (av.1 (suc n, z, c, J, g, p.1) p.2)) (faceW-irr n J k hk hk' i) ;
  low (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (hk' : Tr.IsT (Tr.leb k n)) : Id (W0.Ix (DA.Ez z J)) (lhs k hk) (rhs k) =
   transH (lhs-irr k hk (Ar.leb-step k n hk'))
    (transH (av.2.2.1 (n, k, hk', z, c, J, g, i.1) i.2)
      (transH (symH (A.tE-id z J (DA.prz z J (u.1 (n, z, K.comp n k x z c, J, g, i.1) i.2) (av.1 (n, z, K.comp n k x z c, J, g, i.1) i.2))))
        (apH (\ DR' -> (A.tE z DR'.1 DR'.2.2).nt J
                        (DA.prz DR'.1 J (u.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2) (av.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2)))
           (symH (K.fc-comp n k hk' x z c))))) ;
  top (hk : Tr.IsT (Tr.leb (suc n) (suc n))) : Id (W0.Ix (DA.Ez z J)) (lhs (suc n) hk) (rhs (suc n)) =
   transH (lhs-irr (suc n) hk (Tr.leb-refl (suc n)))
    (transH (av.2.2.2 (n, z, c, J, g, i.1) i.2)
      (apH (\ DR' -> (A.tE z DR'.1 DR'.2.2).nt J
                      (DA.prz DR'.1 J (u.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2) (av.1 (n, DR'.1, DR'.2.1, J, g, i.1) i.2)))
         (symH (K.fc-top n x z c)))) ;
  uf (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) : Id (W0.Ix (DA.Ez z J)) (lhs k hk) (rhs k) =
   Arith[l].eqN-dec (Id (W0.Ix (DA.Ez z J)) (lhs k hk) (rhs k)) k (suc n)
    (\ e -> idJ Nat (suc n) (\ k2 e2 -> (h2 : Tr.IsT (Tr.leb k2 (suc n))) -> Id (W0.Ix (DA.Ez z J)) (lhs k2 h2) (rhs k2))
              (\ h2 -> top h2) k (sym Nat k (suc n) e) hk)
    (\ ne -> low k hk (Ar.leb-suc-neq k n hk ne)) ;
 } ;

 ------------------------------------------------------------------
 -- weights restricted twice, and along the identity

 resres (n : Nat) (W'' W' W : Ob) (h : Hom W' W) (chi : Hom W'' W') (i : Wt.Pn n W)
  : Id (Wt.Pn n W'') (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res) (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res) =
  Sigma-eq (Wt.Coords n W'') (\ cs -> PB.Lands W'' W'' (Wt.oneS n W'' cs) (PB.idH W''))
   (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).1 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1
   (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).2 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W'' PB.Iv)
      (Wt.Res[n, W'', W', chi, Wt.Res[n, W', W, h, i].res].res).1 (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1
      (\ k -> PB.comp-assoc W'' W' W PB.Iv (i.1 k) h chi))
   (PB.isProp-Lands W'' W'' (Wt.oneS n W'' (Wt.Res[n, W'', W, PB.compH W'' W' W h chi, i].res).1) (PB.idH W'')) ;

 resid (n : Nat) (W : Ob) (i : Wt.Pn n W) : Id (Wt.Pn n W) (Wt.Res[n, W, W, PB.idH W, i].res) i =
  Sigma-eq (Wt.Coords n W) (\ cs -> PB.Lands W W (Wt.oneS n W cs) (PB.idH W))
   (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (Wt.Res[n, W, W, PB.idH W, i].res).2 i.2
   (funext (Ar.Fin (suc n)) (\ k -> Hom W PB.Iv) (Wt.Res[n, W, W, PB.idH W, i].res).1 i.1 (\ k -> PB.comp-idr W PB.Iv (i.1 k)))
   (PB.isProp-Lands W W (Wt.oneS n W i.1) (PB.idH W)) ;

 ------------------------------------------------------------------
 -- the fixed data: a point gamma of D G at x , X and a side s of D A

 module Fx (x : CO) (X : Ob) (gm : D.Ob' x X) (s : CP.Partials[D.obD x, DA.DTy x].Side[X, gm]) {
  module PD = CP.Partials[D.obD x, DA.DTy x] ;
  -- s along f, and its point
  sv (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) : SigT (D.obD x) (DA.DTy x) W = s.pv W f lf ;
  sp (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) : Id (D.Ob' x W) (sv W f lf).1 (D.BA[x, W, X, f, gm].res) = s.ppt W f lf ;
  -- the reading of s at an index, in E_z
  rd (W : Ob) (f : Hom W X) (lf : PB.Lands W X s.pQ f) (q : DD.Idx x W) (l : DD.LandsI x W q) : W0.Ix (DA.Ez q.2.1 q.2.2.2.1) =
   DA.prz q.2.1 q.2.2.2.1 ((sv W f lf).1.1 q l) ((sv W f lf).2.1 q l) ;
  -- a point of gamma, read at the index of a reading
  gpt (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) : W0.Ix ((G.ob z).ob J) = gm.1 (n, z, c, J, g, i.1) i.2 ;

  ----------------------------------------------------------------
  -- piece 0 at level n: s on pre g Q, read at (n , z , c , W , id , res h i)

  module Q0 (n : Nat) (z : CO) (c : K.Ch n x z) (J : Ob) (g : Hom J X) (i : Wt.Pn n J) {
   module Pz = CP.Partials[G.ob z, A.ty z] ;
   Q : PB.Phi J = PB.pre J X g s.pQ ;
   R (W : Ob) (h : Hom W J) : Wt.Pn n W = Wt.Res[n, W, J, h, i].res ;
   lfh (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h) : PB.Lands W X s.pQ (PB.compH W J X g h) = PB.lands-pre W J X g s.pQ h lh ;
   pv (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h) : W0.Ix (DA.Ez z W) =
    rd W (PB.compH W J X g h) (lfh W h lh) (n, z, c, W, PB.idH W, (R W h).1) (R W h).2 ;
   ppt (W : Ob) (h : Hom W J) (lh : PB.Lands W J Q h)
    : Id (W0.Ix ((G.ob z).ob W)) (fstE (G.ob z) (A.ty z) W (pv W h lh)) ((G.ob z).act W J h (gpt n z c J g i)) =
    transH (apH (\ w -> w.1 (n, z, c, W, PB.idH W, (R W h).1) (R W h).2) (sp W (PB.compH W J X g h) (lfh W h lh)))
     (transH (apH (\ k -> gm.1 (n, z, c, W, k, (R W h).1) (R W h).2) (PB.comp-idr W X (PB.compH W J X g h)))
       (symH (gm.2.1 ((n, z, c, J, g, i.1), (W, h)) i.2))) ;
   pnat (W' W : Ob) (chi : Hom W' W) (h : Hom W J) (lh : PB.Lands W J Q h) (lh' : PB.Lands W' J Q (PB.compH W' W J h chi))
    : Id (W0.Ix (DA.Ez z W')) ((extP (G.ob z) (A.ty z)).act W' W chi (pv W h lh)) (pv W' (PB.compH W' W J h chi) lh') =
    transH ((sv W (PB.compH W J X g h) (lfh W h lh)).2.2.1 ((n, z, c, W, PB.idH W, (R W h).1), (W', chi)) (R W h).2)
     (transH (apH (\ k -> DA.prz z W' ((sv W (PB.compH W J X g h) (lfh W h lh)).1.1 (n, z, c, W', k, (Wt.Res[n, W', W, chi, R W h].res).1) (Wt.Res[n, W', W, chi, R W h].res).2)
                               ((sv W (PB.compH W J X g h) (lfh W h lh)).2.1 (n, z, c, W', k, (Wt.Res[n, W', W, chi, R W h].res).1) (Wt.Res[n, W', W, chi, R W h].res).2))
                (transH (PB.comp-idl W' W chi) (symH (PB.comp-idr W' W chi))))
      (transH (apH (\ p -> DA.prz z W' ((sv W (PB.compH W J X g h) (lfh W h lh)).1.1 (n, z, c, W', PB.compH W' W' W chi (PB.idH W'), p.1) p.2)
                                ((sv W (PB.compH W J X g h) (lfh W h lh)).2.1 (n, z, c, W', PB.compH W' W' W chi (PB.idH W'), p.1) p.2))
                 (resres n W' W J h chi i))
       (transH (symH (DA.TB[x, W', W, chi, (sv W (PB.compH W J X g h) (lfh W h lh)).1,
                      D.BA[x, W', W, chi, (sv W (PB.compH W J X g h) (lfh W h lh)).1].res,
                      refl (D.BA[x, W', W, chi, (sv W (PB.compH W J X g h) (lfh W h lh)).1].res),
                      (sv W (PB.compH W J X g h) (lfh W h lh)).2].pc (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2))
        (transH (apH (\ w -> DA.prz z W' (w.1.1 (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2)
                                       (w.2.1 (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2))
                   (s.pnat W' W chi (PB.compH W J X g h) (lfh W h lh) (PB.lands-comp W' W X s.pQ (PB.compH W J X g h) chi (lfh W h lh))))
          (apH (\ w -> DA.prz z W' (w.1.1 (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2)
                                 (w.2.1 (n, z, c, W', PB.idH W', (R W' (PB.compH W' W J h chi)).1) (R W' (PB.compH W' W J h chi)).2))
             (PD.pv-hom X gm s W' (PB.compH W' W X (PB.compH W J X g h) chi) (PB.compH W' J X g (PB.compH W' W J h chi))
                (PB.comp-assoc W' W J X g h chi)
                (PB.lands-comp W' W X s.pQ (PB.compH W J X g h) chi (lfh W h lh)) (lfh W' (PB.compH W' W J h chi) lh'))))))) ;
   side : Pz.Side[J, gpt n z c J g i] = new Pz.Side[J, gpt n z c J g i, Q, pv, ppt, pnat] ;
  } ;
 } ;
} ;
