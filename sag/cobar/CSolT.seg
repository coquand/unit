-- CSolT.seg (canonicity-45; SIMPLIFIED.md step 6, (d)): the solution type
-- Sol_h(u) over nil.HomT(x, y) for a relative presentation u over x
-- (m new generators): the values of the new generators in the closed
-- iterated product Q_y^m (Pm), and the equations of u evaluated (CEvT) at
-- the valuation (h at x's generators, the new values) of nil.Q_y^(m+n)
-- (sigma, semantic; the nil point split to tt).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module SolOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x)
  (y : SX.Over[R].Presentation) {
 module HP = CHomT3[a].HomP[R, encK, pe] ;
 module AY = HP.Alg[y] ;
 module AXx = HP.Alg[x] ;
 module EV = CEvT[a].EvOf[R, AY.Qt, AY.O.addQ, AY.O.mulQ, \ r -> AY.AX.cls (cst r)] ;
 Nl : C.Ctx = C.nil ;
 Qy : C.Ty Nl = AY.Qt ;
 n : Nat = x.1 ;
 m : Nat = u.1 ;
 UnitT : C.Ty Nl = CConst[a, a+].ConstOf[CCyl[a].PosCyl.posCyl, V1.unitV].constS Nl ;
 -- the closed iterated product Q_y^k
 Pm : Nat -> C.Ty Nl = split { zero -> UnitT ; suc k | r -> SS.Sig Nl r (OV.wkT Nl r Qy) } ;
 PK (k : Nat) (K : Ob) : U a+ = V1.Ix ((Pm k).1.tob K tt) ;
 -- a valuation from a function on the generators, and the concatenation with the new values
 tup : (k : Nat) (K : Ob) -> (SX.Fin k -> EV.QK K) -> V1.Ix ((EV.Gk k).ob K) = split {
  zero -> \ K g -> tt ;
  suc k | r -> \ K g -> (r K (\ v -> g (inl v)), g (inr tt)) } ;
 app : (k : Nat) (K : Ob) -> V1.Ix ((EV.Gk n).ob K) -> PK k K -> V1.Ix ((EV.Gk (Arith[a].plus k n)).ob K) = split {
  zero -> \ K xp vv -> xp ;
  suc k | r -> \ K xp vv -> (r K xp vv.1, vv.2) } ;
 -- the context nil.HomT(x, y).Q_y^m and the valuation at its points
 HXY : C.Ty Nl = HP.Hom[x, y].HomT ;
 Gh : C.Ctx = C.ext Nl HXY ;
 Pm' : C.Ty Gh = C.subT Gh Nl (Pm m) (C.eps Gh) ;
 Dv : C.Ctx = C.ext Gh Pm' ;
 gen (K : Ob) (i : SX.Fin n) : V1.Ix (AXx.Qt.1.tob K tt) = (AXx.AX.cls (var i)).eob K tt ;
 hval (K : Ob) (z : V1.Ix (HXY.1.tob K tt)) (i : SX.Fin n) : EV.QK K = z.1.1 K (idH K) (gen K i) ;
 sgT (K : Ob) : (o : Top) -> V1.Ix (HXY.1.tob K o) -> PK m K -> V1.Ix ((EV.Gk (Arith[a].plus m n)).ob K) = split {
  tt -> \ z vv -> app m K (tup n K (hval K z)) vv } ;
 sgN (K : Ob) (pt : V1.Ix (Dv.ob K)) : V1.Ix ((EV.Gk (Arith[a].plus m n)).ob K) = sgT K pt.1.1 pt.1.2 pt.2 ;
 -- naturality of the valuation
 rsQ (K Lo : Ob) (g : Hom Lo K) (v : EV.QK K) : EV.QK Lo = EV.rsQ Lo K g v ;
 tupNat : (k : Nat) (K Lo : Ob) (g : Hom Lo K) (f : SX.Fin k -> EV.QK K)
   -> Id (V1.Ix ((EV.Gk k).ob Lo)) ((EV.Gk k).act Lo K g (tup k K f)) (tup k Lo (\ i -> rsQ K Lo g (f i))) = split {
  zero -> \ K Lo g f -> refl tt ;
  suc k | r -> \ K Lo g f ->
   transH (apH {V1.Ix ((EV.Gk k).ob Lo)} {V1.Ix ((EV.Gk (suc k)).ob Lo)}
             (\ w -> (w, (EV.Qk k).1.tact Lo K g (tup k K (\ v -> f (inl v))) ((EV.Gk k).act Lo K g (tup k K (\ v -> f (inl v)))) (refl ((EV.Gk k).act Lo K g (tup k K (\ v -> f (inl v))))) (f (inr tt))))
             (r K Lo g (\ v -> f (inl v))))
    (apH {EV.QK Lo} {V1.Ix ((EV.Gk (suc k)).ob Lo)} (\ q -> (tup k Lo (\ i -> rsQ K Lo g (f (inl i))), q))
       (L.tact-irr Nl Qy.1 Lo K g tt tt (L.ntEq (EV.Gk k) Nl (C.eps (EV.Gk k)) Lo K g (tup k K (\ v -> f (inl v))) ((EV.Gk k).act Lo K g (tup k K (\ v -> f (inl v)))) (refl ((EV.Gk k).act Lo K g (tup k K (\ v -> f (inl v)))))) (refl tt) (f (inr tt)))) } ;
} ;

module SolOf2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x)
  (y : SX.Over[R].Presentation) {
 module S1 = SolOf[R, encK, pe, x, u, y] ;
 module EV = S1.EV ;
 Nl : C.Ctx = C.nil ;
 n : Nat = S1.n ;
 m : Nat = S1.m ;
 PmAct (k : Nat) (K Lo : Ob) (g : Hom Lo K) (vv : S1.PK k K) : S1.PK k Lo = (S1.Pm k).1.tact Lo K g tt tt (refl tt) vv ;
 appNat : (k : Nat) (K Lo : Ob) (g : Hom Lo K) (xp : V1.Ix ((EV.Gk n).ob K)) (vv : S1.PK k K)
   -> Id (V1.Ix ((EV.Gk (Arith[a].plus k n)).ob Lo)) ((EV.Gk (Arith[a].plus k n)).act Lo K g (S1.app k K xp vv)) (S1.app k Lo ((EV.Gk n).act Lo K g xp) (PmAct k K Lo g vv)) = split {
  zero -> \ K Lo g xp vv -> refl ((EV.Gk n).act Lo K g xp) ;
  suc k | r -> \ K Lo g xp vv ->
   transH (apH {V1.Ix ((EV.Gk (Arith[a].plus k n)).ob Lo)} {V1.Ix ((EV.Gk (suc (Arith[a].plus k n))).ob Lo)}
             (\ w -> (w, (EV.Qk (Arith[a].plus k n)).1.tact Lo K g (S1.app k K xp vv.1) ((EV.Gk (Arith[a].plus k n)).act Lo K g (S1.app k K xp vv.1)) (refl ((EV.Gk (Arith[a].plus k n)).act Lo K g (S1.app k K xp vv.1))) vv.2))
             (r K Lo g xp vv.1))
    (apH {EV.QK Lo} {V1.Ix ((EV.Gk (suc (Arith[a].plus k n))).ob Lo)} (\ q -> (S1.app k Lo ((EV.Gk n).act Lo K g xp) (PmAct k K Lo g vv.1), q))
       (L.tact-irr Nl S1.Qy.1 Lo K g tt tt (L.ntEq (EV.Gk (Arith[a].plus k n)) Nl (C.eps (EV.Gk (Arith[a].plus k n))) Lo K g (S1.app k K xp vv.1) ((EV.Gk (Arith[a].plus k n)).act Lo K g (S1.app k K xp vv.1)) (refl ((EV.Gk (Arith[a].plus k n)).act Lo K g (S1.app k K xp vv.1)))) (refl tt) vv.2)) } ;
 module B0 = S1.HP.Hom[x, y].B0 ;
 tactH (K Lo : Ob) (g : Hom Lo K) (z : V1.Ix (S1.HXY.1.tob K tt)) : V1.Ix (S1.HXY.1.tob Lo tt) = S1.HXY.1.tact Lo K g tt tt (refl tt) z ;
 hvalNat (K Lo : Ob) (g : Hom Lo K) (z : V1.Ix (S1.HXY.1.tob K tt)) (i : SX.Fin n) : Id (EV.QK Lo) (S1.rsQ K Lo g (S1.hval K z i)) (S1.hval Lo (tactH K Lo g z) i) =
  transH (symH B0.NTh[K, Lo, g, tt, z.1, S1.gen K i].law)
   (apH {V1.Ix (S1.AXx.Qt.1.tob Lo tt)} {EV.QK Lo} (\ q -> B0.hv Lo tt (B0.rsM K Lo g tt z.1) q) ((S1.AXx.AX.cls (var i)).enat Lo K g tt tt (refl tt))) ;
 GT : C.Ctx = EV.Gk (Arith[a].plus m n) ;
 PT (K : Ob) : U a+ = V1.Ix (GT.ob K) ;
 PmA' (K Lo : Ob) (g : Hom Lo K) (o : Top) (z : V1.Ix (S1.HXY.1.tob K o)) (vv : S1.PK m K) : S1.PK m Lo =
  S1.Pm'.1.tact Lo K g (o, z) (S1.Gh.act Lo K g (o, z)) (refl (S1.Gh.act Lo K g (o, z))) vv ;
 sgNatT (K Lo : Ob) (g : Hom Lo K) : (o : Top) (z : V1.Ix (S1.HXY.1.tob K o)) (vv : S1.PK m K)
   -> Id (PT Lo) (S1.sgT Lo o (S1.HXY.1.tact Lo K g o o (refl o) z) (PmA' K Lo g o z vv)) (GT.act Lo K g (S1.sgT K o z vv)) = split {
  tt -> \ z vv ->
   symH (transH (appNat m K Lo g (S1.tup n K (S1.hval K z)) vv)
     (transH (apH {V1.Ix ((EV.Gk n).ob Lo)} {PT Lo} (\ w -> S1.app m Lo w (PmAct m K Lo g vv)) (S1.tupNat n K Lo g (S1.hval K z)))
       (transH (apH {SX.Fin n -> EV.QK Lo} {PT Lo} (\ ff -> S1.app m Lo (S1.tup n Lo ff) (PmAct m K Lo g vv))
                  (funext (SX.Fin n) (\ i -> EV.QK Lo) (\ i -> S1.rsQ K Lo g (S1.hval K z i)) (S1.hval Lo (tactH K Lo g z)) (hvalNat K Lo g z)))
         (apH {S1.PK m Lo} {PT Lo} (\ ww -> S1.app m Lo (S1.tup n Lo (S1.hval Lo (tactH K Lo g z))) ww)
            (L.tact-irr Nl (S1.Pm m).1 Lo K g tt tt (refl tt) (L.ntEq S1.Gh Nl (C.eps S1.Gh) Lo K g (tt, z) (S1.Gh.act Lo K g (tt, z)) (refl (S1.Gh.act Lo K g (tt, z)))) vv))))) } ;
 sgNat (Lo K : Ob) (g : Hom Lo K) (pt : V1.Ix (S1.Dv.ob K)) : Id (PT Lo) (S1.sgN Lo (S1.Dv.act Lo K g pt)) (GT.act Lo K g (S1.sgN K pt)) =
  sgNatT K Lo g pt.1.1 pt.1.2 pt.2 ;
 sigma : C.Sub S1.Dv GT = new L.PSub[S1.Dv, GT, S1.sgN, sgNat] ;
 -- the equations: t = 0 at the valuation, and their iterated product over u's list
 IdEv (t : SX.Over[R].Expr (SX.Fin (Arith[a].plus m n))) : C.Ty S1.Dv =
  C.subT S1.Dv GT (IJ.IdT GT (EV.Qk (Arith[a].plus m n)) (EV.evE (Arith[a].plus m n) t) (EV.evE (Arith[a].plus m n) (cst R.z))) sigma ;
 UnitD : C.Ty S1.Dv = C.subT S1.Dv Nl S1.UnitT (C.eps S1.Dv) ;
 RelProd : SX.Over[R].Equations (SX.Fin (Arith[a].plus m n)) -> C.Ty S1.Dv = split {
  nil -> UnitD ;
  cons p ps | r -> SS.Sig S1.Dv (IdEv p) (OV.wkT S1.Dv (IdEv p) r) } ;
 Sol : C.Ty S1.Gh = SS.Sig S1.Gh S1.Pm' (RelProd u.2) ;
} ;
