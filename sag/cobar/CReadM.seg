-- CReadM.seg (canonicity-45; COBAR.md "comparison"): the reading of the
-- multiplication on codes F2 -> y' (CReadA's hOp): over HomT(F2, y'),
-- z (Phi_MulF cx) ~ z (cls (x1 x2)) ~ z (cls x1) z (cls x2) ~ z (Phi_I1 cx) z (Phi_I2 cx)
-- (c2's datum at the closed point, the SubC betas), then along alpha.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RM (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) (y' : SX.Over[R].Presentation) {
 module A = CReadA[a].RA[R, encK, pe, al, eqal, commH, y'] ;
 module E = A.E ;
 module HO = A.HO ;
 Nl : L.PCtx = A.Nl ;
 Qc : L.PTy[Nl] = A.Qc ;
 H1 : L.PTy[Nl] = A.H1 ;
 cQ : PB.CLine[a+].Lines[Nl, Qc].CompK[PB.e0, PB.e1].Comp = A.cQ ;
 module AOH = CApOp2[a].AO[Nl, H1, Qc, E.mulA, E.mulAN] ;
 module PM = A.PreRd[E.CM.II.MulF.M.mor, E.CM.II.MulF.M.mor-nat, E.CM.II.MulF.SM.Phi, \ I f u -> refl ((E.CM.II.MulF.SM.Phi.eob I tt).1 I f u)] ;
 module MM = A.Z.Mv[PM.cp, A.ZD.MulD.q3, E.CM.II.MulF.SM.beta (var (inr tt))] ;
 module RM0 = A.Z.Rd[A.Z.ZA.apC PM.cp, A.Z.ZA.apC A.ZD.MulD.q3, MM.res] ;
 module RDM0 = A.Z.Rd[A.ZD.MulD.DB.e1, A.ZD.MulD.DB.e3, A.ZD.MulD.res] ;
 zL : HO.NMap[Nl, H1, Qc] = RM0.PR.mA ;
 zq3 : HO.NMap[Nl, H1, Qc] = RM0.PR.mB ;
 e1m : HO.NMap[Nl, H1, Qc] = RDM0.PR.mA ;
 e3m : HO.NMap[Nl, H1, Qc] = RDM0.PR.mB ;
 z1 : HO.NMap[Nl, H1, Qc] = A.R10.PR.mA ;
 zq1 : HO.NMap[Nl, H1, Qc] = A.R10.PR.mB ;
 z2 : HO.NMap[Nl, H1, Qc] = A.R20.PR.mA ;
 zq2 : HO.NMap[Nl, H1, Qc] = A.R20.PR.mB ;
 module DB = A.ZD.MulD.DB ;
 module WQ = A.ZD.MulD.WQ ;
 module ZA = A.Z.ZA ;
 pa3 (I : Ob) : (x : Top) (z : V1.Ix (H1.tob I x)) -> Id (V1.Ix (Qc.tob I x)) (zq3.nfun I x z) (e3m.nfun I x z) = split {
  tt -> \ z -> transH (ZA.rdF A.ZD.MulD.q3 I (tt, z))
    (symH (transH (DB.e3rd I (tt, z)) (apH {V1.Ix (WQ.W4.1.tob I tt)} {V1.Ix (Qc.tob I tt)} (DB.v3 I (tt, z)) (WQ.wtrd I tt)))) } ;
 pb1 (I : Ob) : (x : Top) (z : V1.Ix (H1.tob I x)) -> Id (V1.Ix (Qc.tob I x)) ((AOH.OP zq1 zq2).nfun I x z) (e1m.nfun I x z) = split {
  tt -> \ z -> transH (transH (apH {V1.Ix (Qc.tob I tt)} {V1.Ix (Qc.tob I tt)} (\ v -> E.mulA I tt v (zq2.nfun I tt z)) (ZA.rdF A.ZD.q1 I (tt, z)))
       (apH {V1.Ix (Qc.tob I tt)} {V1.Ix (Qc.tob I tt)} (E.mulA I tt (ZA.nf I (tt, z) (A.ZD.q1.eob I tt))) (ZA.rdF A.ZD.q2 I (tt, z))))
    (symH (transH (DB.e1rd I (tt, z)) (apH {V1.Ix (WQ.W4.1.tob I tt)} {V1.Ix (Qc.tob I tt)} (DB.v1 I (tt, z)) (WQ.wtrd I tt)))) } ;
 -- over HomT(F2, y'): z (Phi_MulF cx) ~ z (Phi_I1 cx) z (Phi_I2 cx)
 module ID = HO.Inv[Nl, H1, Qc, e1m, e3m, cQ, RDM0.PR.res] ;
 module RD1 = HO.Ret[Nl, H1, Qc, e3m, e1m, zq3, AOH.OP zq1 zq2, pa3, pb1, ID.res] ;
 module I1 = HO.Inv[Nl, H1, Qc, z1, zq1, cQ, A.R10.PR.res] ;
 module I2 = HO.Inv[Nl, H1, Qc, z2, zq2, cQ, A.R20.PR.res] ;
 module AP = AOH.Ap[zq1, z1, zq2, z2, I1.res, I2.res] ;
 module C1 = HO.Cat[Nl, H1, Qc, zL, zq3, AOH.OP zq1 zq2, cQ, RM0.PR.res, RD1.res] ;
 module C2 = HO.Cat[Nl, H1, Qc, zL, AOH.OP zq1 zq2, AOH.OP z1 z2, cQ, C1.res, AP.res] ;
 -- along alpha, to codes F2 -> y'
 module W = HO.WR[Nl, H1, Qc, A.A2c, zL, AOH.OP z1 z2, A.A2.alphaN, C2.res] ;
 preC : HO.NMap[Nl, A.A2c, A.Ac] = E.Op[E.CM.II.MulF.M.mor, E.CM.II.MulF.M.mor-nat].preC ;
 module AO2 = CApOp2[a].AO[Nl, A.A2c, Qc, E.mulA, E.mulAN] ;
 paF (I : Ob) : (x : Top) (m : V1.Ix (A.A2c.tob I x)) -> Id (V1.Ix (Qc.tob I x)) ((HO.compN Nl A.A2c A.Ac Qc preC A.evc).nfun I x m) ((HO.compN Nl A.A2c H1 Qc A.A2.alphaN zL).nfun I x m) = split {
  tt -> \ m -> PM.rdP I m } ;
 pbF (I : Ob) : (x : Top) (m : V1.Ix (A.A2c.tob I x))
  -> Id (V1.Ix (Qc.tob I x)) ((AO2.OP (HO.compN Nl A.A2c A.Ac Qc E.p1c A.evc) (HO.compN Nl A.A2c A.Ac Qc E.p2c A.evc)).nfun I x m) ((HO.compN Nl A.A2c H1 Qc A.A2.alphaN (AOH.OP z1 z2)).nfun I x m) = split {
  tt -> \ m -> transH (apH {V1.Ix (Qc.tob I tt)} {V1.Ix (Qc.tob I tt)} (\ v -> E.mulA I tt v (A.evc.nfun I tt (E.p2c.nfun I tt m))) (A.P1.rdP I m))
    (apH {V1.Ix (Qc.tob I tt)} {V1.Ix (Qc.tob I tt)} (E.mulA I tt (z1.nfun I tt (A.A2.at I tt m))) (A.P2.rdP I m)) } ;
 module HR = HO.Ret[Nl, A.A2c, Qc, HO.compN Nl A.A2c H1 Qc A.A2.alphaN zL, HO.compN Nl A.A2c H1 Qc A.A2.alphaN (AOH.OP z1 z2),
   HO.compN Nl A.A2c A.Ac Qc preC A.evc, AO2.OP (HO.compN Nl A.A2c A.Ac Qc E.p1c A.evc) (HO.compN Nl A.A2c A.Ac Qc E.p2c A.evc), paF, pbF, W.res] ;
 -- CReadA's hOp for the multiplication
 hMul : L.PEl[L.extP Nl A.A2c, HO.HT[Nl, A.A2c, Qc, HO.compN Nl A.A2c A.Ac Qc preC A.evc,
    AO2.OP (HO.compN Nl A.A2c A.Ac Qc E.p1c A.evc) (HO.compN Nl A.A2c A.Ac Qc E.p2c A.evc)].PT.PathP] = HR.res ;
} ;
