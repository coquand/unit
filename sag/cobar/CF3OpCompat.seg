-- The generic F3 addition equation uses the operation already chosen for G.
level a ;
open Base ;
open Prelude[a] ;
open Paths[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Compat (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module T = CFree3Assoc[a].Generic3Assoc[R, encK, pe] ;
  module F = T.F ;
  module Add = T.Add ;
  addOpPath : Add.A.G1.GB.GPre[a+].PS.PEl[Add.A.G1.GB.GPre[a+].PS.extP Add.A.P1 Add.A.XT,
    Add.HO1.HT[Add.A.P1, Add.A.XT, Add.A.GT,
      Add.A.AddG.AO.OP (Add.A.Rs F.x1) (Add.A.AddG.AO.OP (Add.A.Rs F.x2) (Add.A.Rs F.x3)),
      Add.A.AddG.AO.OP (Add.A.AddG.AO.OP (Add.A.Rs F.x1) (Add.A.Rs F.x2)) (Add.A.Rs F.x3)].PT.PathP] = T.addPath ;
} ;
