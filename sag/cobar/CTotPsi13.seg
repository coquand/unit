-- CTotPsi13.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 13: Psi on the strict fibre of ev_e as a
-- D-element (PsiSF) and mS (CMove.Mv's map of totals).  Its equations by
-- ts-ext: the points by CTotPsi7, the lines of A by Psi at the context G.A
-- (CTotPsi3 / 4 / 5 at ET).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi13 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P12 = CTotPsi12[a, vl, l].Psi12[C, G, A, e] ;
 module P7 = CTotPsi7[a, vl, l].Psi7[C, G, A, e] ;
 module P6 = P12.P6 ;
 module PO = P6.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module EKg = P6.EKg ;
 module EKd = P6.EKd ;
 module DV = P6.DV ;
 module FTg = P12.FTg ;
 ET : CTPsh[a, vl, l].TPshOf[C].TCtx = P12.ET ;
 module P3E = CTotPsi3[a, vl, l].Psi3[C, ET] ;
 module P4E = CTotPsi4[a, vl, l].Psi4[C, ET] ;
 module P5E = CTotPsi5[a, vl, l].Psi5[C, ET] ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;
 TVT : CTPsh[a, vl, l].TPshOf[C].TCtx = TC.ofP P6.TVC ;
 SF' : TR.P1.PTy[TC.toP TVT] = TR.P1.mkTy (TC.toP TVT) EKg.SFm.SF.tob EKg.SFm.SF.tact EKg.SFm.SF.tact-id EKg.SFm.SF.tact-o ;
 module DS = CobarIT[a, vl, l].DTI[C, TVT, SF'] ;

 module SE (X : TC.TOb) (v : EKd.TS.EI X) {
  module M = P12.MS[X, v] ;
  module PE = P7.PE[X, M.w] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  tS : DS.TA I x PE.PsiPt = \ q lq -> M.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].fib ;
  -- the restricted index of a naturality index, the face and composed indices of a face index
  rW (r : VA.Ix (DS.D.natIdxV I x)) (lq : DO.LandsI I x r.1) : Wt.Pn r.1.1 r.2.1 =
   Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, lq)].res ;
  rI (r : VA.Ix (DS.D.natIdxV I x)) (lq : DO.LandsI I x r.1) : DO.Idx I x =
   (r.1.1, r.2.1, compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1,
    DO.rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1, (rW r lq).1) ;
  fW (r : VA.Ix (DS.D.faceIdxV I x)) (lq : DS.D.faceLd I x r) : Wt.Pn (suc r.1) r.2.2.2.1 =
   Wt.Face[r.1, r.2.2.2.1, r.2.1, Arith[a].leb-step r.2.1 r.1 r.2.2.1].Of[(r.2.2.2.2.2.2.2, lq)].face ;
  fI (r : VA.Ix (DS.D.faceIdxV I x)) (lq : DS.D.faceLd I x r) : DO.Idx I x =
   (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (fW r lq).1) ;
  cI (r : VA.Ix (DS.D.faceIdxV I x)) : DO.Idx I x =
   (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) ;
  anatS : W0.Ix (DS.anatEq I x PE.PsiPt tS) = \ r lq ->
   EKg.ts-ext (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
    (EKg.TS.E.act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
       (EKg.TS.pr (r.1.2.1, r.1.2.2.2.1) (PE.PsiPt.1 r.1 lq) (tS r.1 lq)))
    (EKg.TS.pr (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (PE.PsiPt.1 (rI r lq) (rW r lq).2) (tS (rI r lq) (rW r lq).2))
    (PE.natPt r lq)
    (\ V g j -> transH (apH {EKg.TL.EI (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} {EKg.TA.EI V}
                          (\ MM -> FTg.lval (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) MM V g j)
                          (EKg.lineL-act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)
                             (EKg.TS.pr (r.1.2.1, r.1.2.2.2.1) (PE.PsiPt.1 r.1 lq) (tS r.1 lq))))
       (apH {W0.Ix (FTg.FE.ob (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} {EKg.TA.EI V} (\ MM -> MM.1 V g j)
          (P3E.PN[X, M.lE].NT[r.1.1, r.1.2.1, r.1.2.2.1, r.1.2.2.2.1, r.1.2.2.2.2.1, (r.1.2.2.2.2.2, lq), r.2.1, r.2.2].law))) ;
  afaceS : W0.Ix (DS.afaceEq I x PE.PsiPt tS) = \ r lq ->
   EKg.ts-ext (r.2.2.2.1, r.2.2.2.2.2.1)
    (EKg.TS.pr (r.2.2.2.1, r.2.2.2.2.2.1) (PE.PsiPt.1 (fI r lq) (fW r lq).2) (tS (fI r lq) (fW r lq).2))
    (EKg.TS.pr (r.2.2.2.1, r.2.2.2.2.2.1) (PE.PsiPt.1 (cI r) lq) (tS (cI r) lq))
    (PE.facePt r lq)
    (\ V g j -> apH {W0.Ix (FTg.FE.ob (r.2.2.2.1, r.2.2.2.2.2.1))} {EKg.TA.EI V} (\ MM -> MM.1 V g j)
       (P4E.PF[X, M.lE].FE[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (r.2.2.2.2.2.2.2, lq)].law)) ;
  module TP3 (r : VA.Ix (DS.D.topIdxV I x)) (lq : DS.D.topLd I x r) {
   module TT = P5E.PT[X, M.lE].TT[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (r.2.2.2.2.2, lq)] ;
   module TG = PE.TP2[r, lq] ;
   Y : TC.TOb = (r.2.1, r.2.2.2.1) ;
   uA : EKg.TS.EI Y = EKg.TS.pr Y TG.QA.pt (tS (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, TT.ft.1) TT.ft.2) ;
   uB : EKg.TS.EI TT.Y' = EKg.TS.pr TT.Y' TG.QB.pt (tS (r.1, r.2.1, r.2.2.1, TT.z', TT.c', r.2.2.2.2.2) lq) ;
   law : Id (EKg.TS.EI Y) uA (EKg.TS.E.act Y TT.Y' TT.gv uB) =
    EKg.ts-ext Y uA (EKg.TS.E.act Y TT.Y' TT.gv uB) TG.law
     (\ V g j -> transH (apH {W0.Ix (FTg.FE.ob Y)} {EKg.TA.EI V} (\ MM -> MM.1 V g j) TT.law)
        (symH (apH {EKg.TL.EI Y} {EKg.TA.EI V} (\ MM -> FTg.lval Y MM V g j) (EKg.lineL-act Y TT.Y' TT.gv uB)))) ;
  } ;
  atopS : W0.Ix (DS.atopEq I x PE.PsiPt tS) = \ r lq -> TP3[r, lq].law ;
  PsiSF : DS.TOb' I x PE.PsiPt = (tS, anatS, afaceS, atopS) ;
 } ;
 -- the map of totals for CMove.Mv
 mS (W : TC.TOb) (v : EKd.TS.EI W) : TR.P1.SigT (TC.toP DS.D.DCtx) DS.DTy W = (P7.PE[W, EKd.TS.pr1 W v].PsiPt, SE[W, v].PsiSF) ;
} ;
