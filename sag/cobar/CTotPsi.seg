-- CTotPsi.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for lines
-- at the total site (towards the fibration half of Lemma 12), part 1.
-- For a line ln of D G at a total stage X = (I, x):
--   rdC   the value of ln at the cartesian lift cart U x (U : W1 -> I),
--         read at the identity index of a chain cc to res U x
--   NC    its naturality along a base map: the line's naturality, the
--         D-element's naturality, Rk's slice paths
-- Generic in the context G (the same core serves canonicity-45's Prop 13).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module PsiOf (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module TP = CTPsh[a, vl, l].TPshOf[C] ;
 module VT = CVert[a, vl].VertOf[C] ;
 module DO = CobarI[a, vl, l].DOfI[C] ;
 module D = DO.DC[G] ;
 module CT = DO.CT ;
 module CL = CTotL12ch[a, vl].ChL[C] ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 DG : TR.P1.PCtx = TC.toP D.DCtx ;
 GP : TR.P1.PCtx = TC.toP G ;
 module FL = G1.GB.CLine[l].FC[DG] ;

 module PL (X : TC.TOb) (ln : W0.Ix (FL.ob X)) {
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module RC (n : Nat) (W1 : Ob) (y : Obj W1) (U0 : Hom W1 I) (cc : CT.Ch W1 n (C.res W1 I U0 x) y) (R : Wt.Pn n W1) (j : PB.IvP W1) {
   ry : Obj W1 = C.res W1 I U0 x ;
   Xv : TC.TOb = (W1, ry) ;
   f : TC.THm Xv X = TC.cartT W1 X U0 ;
   module CA = CL.Cart[W1, I, U0, x, n, y, cc] ;
   q0 : DO.Idx W1 ry = (n, W1, idH W1, y, CA.ch, R.1) ;
   t : W0.Ix (DG.ob Xv) = ln.1 Xv f j ;
   val : W0.Ix (G.ob W1 y) = t.1 q0 R.2 ;
  } ;
  rdC (n : Nat) (W1 : Ob) (y : Obj W1) (U0 : Hom W1 I) (cc : CT.Ch W1 n (C.res W1 I U0 x) y) (R : Wt.Pn n W1) (j : PB.IvP W1)
   : W0.Ix (G.ob W1 y) = RC[n, W1, y, U0, cc, R, j].val ;

  module NC (n : Nat) (W1 : Ob) (y : Obj W1) (U0 : Hom W1 I) (cc : CT.Ch W1 n (C.res W1 I U0 x) y) (R : Wt.Pn n W1) (j : PB.IvP W1)
    (W2 : Ob) (w : Hom W2 W1) {
   module A1 = RC[n, W1, y, U0, cc, R, j] ;
   module K = CL.Rk[W2, W1, I, w, U0, x, n, y, cc] ;
   R' : Wt.Pn n W2 = Wt.Res[n, W2, W1, w, R].res ;
   j' : PB.IvP W2 = PB.ivA W2 W1 w j ;
   module A2 = RC[n, W2, K.tz, K.Uw, DO.rCh W2 W1 I w U0 x n y cc, R', j'] ;
   Xv' : TC.TOb = A2.Xv ;
   k0 : TR.RN.Hom0 Xv' A1.Xv = (w, C.res-comp W2 W1 I U0 w x) ;
   k : TC.THm Xv' A1.Xv = TR.fn.onH Xv' A1.Xv k0 ;
   f0 : TR.RN.Hom0 A1.Xv X = (U0, refl A1.ry) ;
   Efk : Id (TC.THm Xv' X) (TC.tcomp Xv' A1.Xv X A1.f k) A2.f =
    transH (symH (TR.fn.onComp Xv' A1.Xv X f0 k0))
     (apH {TR.RN.Hom0 Xv' X} {TC.THm Xv' X} (TR.fn.onH Xv' X)
        (TR.DS.pairEq W2 K.ry' I x K.Uw K.Uw (refl K.Uw) (G0.GB.BC.oC Xv' A1.Xv X f0 k0).2 (refl K.ry'))) ;
   qA : DO.Idx W1 A1.ry = (n, W2, compH W2 W1 W1 (idH W1) w, K.tz, K.cA, R'.1) ;
   qB : DO.Idx W1 A1.ry = (n, W2, compH W2 W2 W1 w (idH W2), K.tz, K.cB K.ry' K.ek, R'.1) ;
   s1 : Id (W0.Ix (G.ob W2 K.tz)) (TP.cartAct G W2 W1 w y A1.val) (A1.t.1 qA R'.2) =
    A1.t.2.1 (A1.q0, (W2, w)) R.2 ;
   s2 : Id (W0.Ix (G.ob W2 K.tz)) (A1.t.1 qA R'.2) (A1.t.1 qB R'.2) =
    apH {D.S W1 A1.ry n W2 K.tz} {W0.Ix (G.ob W2 K.tz)} (\ sw -> D.rd W1 A1.ry A1.t.1 n W2 K.tz R'.1 sw R'.2)
     (transH (D.sEq W1 A1.ry n W2 K.tz (compH W2 W1 W1 (idH W1) w) w (comp-idl W2 W1 w) K.cA K.F K.lawA)
        (symH (D.sEq W1 A1.ry n W2 K.tz (compH W2 W2 W1 w (idH W2)) w (comp-idr W2 W1 w) (K.cB K.ry' K.ek) K.F (K.lawB K.ry' K.ek)))) ;
   s4 : Id (W0.Ix (DG.ob Xv')) (DG.act Xv' A1.Xv k A1.t) A2.t =
    transH (ln.2 Xv' A1.Xv k A1.f j)
     (apH {TC.THm Xv' X} {W0.Ix (DG.ob Xv')} (\ kk -> ln.1 Xv' kk j') Efk) ;
   nat : Id (W0.Ix (G.ob W2 K.tz)) (TP.cartAct G W2 W1 w y A1.val) A2.val =
    transH s1 (transH s2 (apH {W0.Ix (DG.ob Xv')} {W0.Ix (G.ob W2 K.tz)} (\ w' -> w'.1 A2.q0 R'.2) s4)) ;
  } ;
 } ;
} ;
