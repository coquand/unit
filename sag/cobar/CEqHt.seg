-- CEqHt.seg (canonicity-45; COBAR.md "Prop 58"): at the total site, each
-- equation q of A's telescope read on yo(y).A as a path homotopy between
-- G's evaluation of q at the point and 0 (CIdPull at the telescope prefix
-- ending at q, along CUnpack's map), over the closed form of yo(y).A.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module EH (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module UP = CUnpack[a].UP[R, encK, pe, y, u] ;
 module SO = UP.SO ;
 module IPm = CIdPull[a].IP[R, encK, pe] ;
 module GBr = CGBr[a].GBr[R, encK, pe] ;
 module CT = IPm.CT ;
 module PS1 = UP.PS1 ;
 C : CwF.CwF[a++] = UP.C ;
 Ez : IPm.CC.CM.TP.TCtx = CT.TC.ofP UP.E ;
 A1 : PS1.PTy[CT.P1] = CT.Of[Ez].Y1T ;
 EY : PS1.PCtx = PS1.extP CT.P1 A1 ;
 jE : PS1.PSub[EY, UP.E] = new PS1.PSub[EY, UP.E, \ X w -> w.2, \ Z X f w -> refl (UP.E.act Z X f w.2)] ;
 module Eq (q : SO.Term) (Lq : SX.Over[R].Equations SO.TW.Var) (s : C.Sub UP.E (SO.HS (cons q Lq)).1) {
  Gm : C.Ctx = (SO.HS Lq).1 ;
  aq : C.El Gm (SO.PW.Gat Gm) = SO.gsub Gm (SO.HS Lq).2 (SO.TW.evE q) ;
  bq : C.El Gm (SO.PW.Gat Gm) = SO.gsub Gm (SO.HS Lq).2 SO.zE ;
  module I = IPm.At[GBr.O1.DY.DCtx, GBr.fbGT, Gm, aq, bq, A1, C.o EY UP.E (SO.HS (cons q Lq)).1 s jE] ;
  -- at a copy y': a path homotopy over the closed copy of yo(y).A, into G's fibres
  module Cp (y' : SX.Over[R].Presentation) {
   module RH = CRestrHT[a].RHT[R, encK, pe, y'] ;
   module RO = RH.Of[Ez, GBr.O1.DY.DCtx] ;
   module RT = RO.RHt[I.mA, I.mB, I.res] ;
   res : L.PEl[L.extP RH.Nl RO.Ac, RH.HO.HT[RH.Nl, RO.Ac, RO.Bc, RO.rN I.mA, RO.rN I.mB].PT.PathP] = RT.res ;
  } ;
 } ;
} ;
