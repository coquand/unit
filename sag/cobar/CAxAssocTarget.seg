-- The internal associativity identity type over three variable elements
-- of the concrete presented quotient A_x.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module V1 = V[a+] ;
module PB = PosFull[a].PB ;
module PS = PB.GPre[a+].PS ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module L = PB.GPre[a+].PS ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, C].IdJStr = FibId[a, a+].fibId ;

module Target (R : Ring[a].CRing) (encK : EN.Enc R.R)
  (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
  module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
  module Q3 = CwFQuotElim3[a].QE3[R, encK, x, pe] ;
  module AX = Q1.AX ;
  module OP = AX.Ops[Q1.setQ, Q1.setQi, Q3.elim2, Q3.elim2-beta] ;
  module GQ = Q1.GQ ;
  module For (op : C.El C.nil (OV.Fun C.nil AX.Qt (OV.Fun C.nil AX.Qt AX.Qt)))
    (lawC : (t1 t2 t3 : AX.Term) -> C.El C.nil
      (IJ.IdT C.nil AX.Qt
        (AX.ap2 AX.Qt op (AX.cls t1) (AX.ap2 AX.Qt op (AX.cls t2) (AX.cls t3)))
        (AX.ap2 AX.Qt op (AX.ap2 AX.Qt op (AX.cls t1) (AX.cls t2)) (AX.cls t3)))) {
  module SO = CSemOp[a].SemOp[AX.Qt, op] ;
  FQ : C.Ty C.nil = OV.Fun C.nil AX.Qt AX.Qt ;
  module Read (q1 q2 : AX.Q) {
    inner : C.El C.nil FQ = OV.app C.nil AX.Qt FQ op q1 ;
    module O = CAppRd[a].App0[AX.Qt, FQ, op, q1] ;
    module I = CAppRd[a].App0[AX.Qt, AX.Qt, inner, q2] ;
    rd (K : Ob) (o : V1.Ix (C.nil.ob K))
      : Id (V1.Ix (AX.Qt.1.tob K o))
          ((AX.ap2 AX.Qt op q1 q2).eob K o)
          (SO.ev2 K o (q1.eob K o) (q2.eob K o)) =
      transH (I.rd K o)
        (apH {V1.Ix (FQ.1.tob K o)} {V1.Ix (AX.Qt.1.tob K o)}
          (\ f -> f.1 K (idH K) (q2.eob K o)) (O.rd K o)) ;
  } ;
  G3 : C.Ctx = GQ.G3 ;
  Qw3 : C.Ty G3 = GQ.Qw3 ;
  rdL (K : Ob) (z : V1.Ix (G3.ob K)) : V1.Ix (Qw3.1.tob K z) =
    SO.ev2 K z.1.1.1 z.1.1.2 (SO.ev2 K z.1.1.1 z.1.2 z.2) ;
  rdR (K : Ob) (z : V1.Ix (G3.ob K)) : V1.Ix (Qw3.1.tob K z) =
    SO.ev2 K z.1.1.1 (SO.ev2 K z.1.1.1 z.1.1.2 z.1.2) z.2 ;
  natL (J K : Ob) (f : Hom J K) (z : V1.Ix (G3.ob K))
    : Id (V1.Ix (Qw3.1.tob J (G3.act J K f z)))
      (Qw3.1.tact J K f z (G3.act J K f z) (refl (G3.act J K f z)) (rdL K z))
      (rdL J (G3.act J K f z)) =
    transH (SO.NT[K, J, f, z.1.1.1, z.1.1.2, SO.ev2 K z.1.1.1 z.1.2 z.2].law)
      (apH {V1.Ix (AX.Qt.1.tob J z.1.1.1)} {V1.Ix (AX.Qt.1.tob J z.1.1.1)}
        (SO.ev2 J z.1.1.1 (SO.rsQ K J f z.1.1.1 z.1.1.2))
        (SO.NT[K, J, f, z.1.1.1, z.1.2, z.2].law)) ;
  natR (J K : Ob) (f : Hom J K) (z : V1.Ix (G3.ob K))
    : Id (V1.Ix (Qw3.1.tob J (G3.act J K f z)))
      (Qw3.1.tact J K f z (G3.act J K f z) (refl (G3.act J K f z)) (rdR K z))
      (rdR J (G3.act J K f z)) =
    transH (SO.NT[K, J, f, z.1.1.1, SO.ev2 K z.1.1.1 z.1.1.2 z.1.2, z.2].law)
      (apH {V1.Ix (AX.Qt.1.tob J z.1.1.1)} {V1.Ix (AX.Qt.1.tob J z.1.1.1)}
        (\ v -> SO.ev2 J z.1.1.1 v (SO.rsQ K J f z.1.1.1 z.2))
        (SO.NT[K, J, f, z.1.1.1, z.1.1.2, z.1.2].law)) ;
  lhs : C.El G3 Qw3 = PS.mkPEl G3 Qw3.1 rdL (\ J K f z z' e ->
    idJ (V1.Ix (G3.ob J)) (G3.act J K f z)
      (\ z2 e2 -> Id (V1.Ix (Qw3.1.tob J z2)) (Qw3.1.tact J K f z z2 e2 (rdL K z)) (rdL J z2))
      (natL J K f z) z' e) ;
  rhs : C.El G3 Qw3 = PS.mkPEl G3 Qw3.1 rdR (\ J K f z z' e ->
    idJ (V1.Ix (G3.ob J)) (G3.act J K f z)
      (\ z2 e2 -> Id (V1.Ix (Qw3.1.tob J z2)) (Qw3.1.tact J K f z z2 e2 (rdR K z)) (rdR J z2))
      (natR J K f z) z' e) ;
  P : C.Ty G3 = IJ.IdT G3 Qw3 lhs rhs ;
  s2 : C.Sub GQ.G2 C.nil =
    C.o GQ.G2 GQ.G1 C.nil (C.p C.nil AX.Qt) (C.p GQ.G1 GQ.Qw) ;
  s3 : C.Sub G3 C.nil = C.o G3 GQ.G2 C.nil s2 (C.p GQ.G2 GQ.Qw2) ;
  p2 : Id (C.Ty GQ.G2) (C.subT GQ.G2 C.nil AX.Qt s2) GQ.Qw2 =
    C.subT-o GQ.G2 GQ.G1 C.nil AX.Qt (C.p C.nil AX.Qt) (C.p GQ.G1 GQ.Qw) ;
  p3 : Id (C.Ty G3) (C.subT G3 C.nil AX.Qt s3) Qw3 =
    transH (C.subT-o G3 GQ.G2 C.nil AX.Qt s2 (C.p GQ.G2 GQ.Qw2))
      (apH {C.Ty GQ.G2} {C.Ty G3}
        (\ T -> C.subT G3 GQ.G2 T (C.p GQ.G2 GQ.Qw2)) p2) ;
  propP : C.El G3 (PU.isProp G3 P) = Q1.S3.At[G3, s3, Qw3, p3, lhs, rhs].law ;
  module AtTerms (t1 t2 t3 : AX.Term) {
    q1 : AX.Q = AX.cls t1 ;
    q2 : AX.Q = AX.cls t2 ;
    q3 : AX.Q = AX.cls t3 ;
    sc : C.Sub C.nil G3 = GQ.Sec3[q1, q2, q3].sec3 ;
    e0 : Id (C.Sub C.nil C.nil) (C.o C.nil G3 C.nil s3 sc) (C.id C.nil) =
      L.sub-ext C.nil C.nil (C.o C.nil G3 C.nil s3 sc) (C.id C.nil) (\ K o -> refl o) ;
    pS : Id (C.Ty C.nil) (C.subT C.nil G3 Qw3 sc) AX.Qt =
      transH (apH {C.Ty G3} {C.Ty C.nil} (\ T -> C.subT C.nil G3 T sc) (symH p3))
        (transH (symH (C.subT-o C.nil G3 C.nil AX.Qt s3 sc))
          (transH (apH {C.Sub C.nil C.nil} {C.Ty C.nil}
                    (\ s -> C.subT C.nil C.nil AX.Qt s) e0)
            (C.subT-id C.nil AX.Qt))) ;
    gl : AX.Q = AX.ap2 AX.Qt op q1 (AX.ap2 AX.Qt op q2 q3) ;
    gr : AX.Q = AX.ap2 AX.Qt op (AX.ap2 AX.Qt op q1 q2) q3 ;
    readL (K : Ob) (o : V1.Ix (C.nil.ob K))
      : Id (V1.Ix (AX.Qt.1.tob K o)) (gl.eob K o) (rdL K (sc.nt K o)) =
      transH (Read[q1, AX.ap2 AX.Qt op q2 q3].rd K o)
        (apH {V1.Ix (AX.Qt.1.tob K o)} {V1.Ix (AX.Qt.1.tob K o)}
          (SO.ev2 K o (q1.eob K o)) (Read[q2, q3].rd K o)) ;
    readR (K : Ob) (o : V1.Ix (C.nil.ob K))
      : Id (V1.Ix (AX.Qt.1.tob K o)) (gr.eob K o) (rdR K (sc.nt K o)) =
      transH (Read[AX.ap2 AX.Qt op q1 q2, q3].rd K o)
        (apH {V1.Ix (AX.Qt.1.tob K o)} {V1.Ix (AX.Qt.1.tob K o)}
          (\ v -> SO.ev2 K o v (q3.eob K o)) (Read[q1, q2].rd K o)) ;
    ovL : OV.Ov C.nil G3 Qw3 sc AX.Qt pS lhs gl =
      L.el-ext C.nil AX.Qt.1 (OV.trE C.nil (C.subT C.nil G3 Qw3 sc) AX.Qt pS (C.subt C.nil G3 Qw3 lhs sc)) gl (\ K o ->
        transH (CAppRd[a].trE-rd C.nil (C.subT C.nil G3 Qw3 sc) AX.Qt pS (C.subt C.nil G3 Qw3 lhs sc) K o)
          (transH (CAppRd[a].same-rd C.nil (C.subT C.nil G3 Qw3 sc) AX.Qt pS K o
                    (refl (AX.Qt.1.tob K o)) ((C.subt C.nil G3 Qw3 lhs sc).eob K o))
            (symH (readL K o)))) ;
    ovR : OV.Ov C.nil G3 Qw3 sc AX.Qt pS rhs gr =
      L.el-ext C.nil AX.Qt.1 (OV.trE C.nil (C.subT C.nil G3 Qw3 sc) AX.Qt pS (C.subt C.nil G3 Qw3 rhs sc)) gr (\ K o ->
        transH (CAppRd[a].trE-rd C.nil (C.subT C.nil G3 Qw3 sc) AX.Qt pS (C.subt C.nil G3 Qw3 rhs sc) K o)
          (transH (CAppRd[a].same-rd C.nil (C.subT C.nil G3 Qw3 sc) AX.Qt pS K o
                    (refl (AX.Qt.1.tob K o)) ((C.subt C.nil G3 Qw3 rhs sc).eob K o))
            (symH (readR K o)))) ;
    pId : Id (C.Ty C.nil) (C.subT C.nil G3 P sc) (IJ.IdT C.nil AX.Qt gl gr) =
      OV.Id-ov C.nil G3 Qw3 lhs rhs sc AX.Qt pS gl gr ovL ovR ;
    h : C.El C.nil (C.subT C.nil G3 P sc) =
      OV.trE C.nil (IJ.IdT C.nil AX.Qt gl gr) (C.subT C.nil G3 P sc) (symH pId)
        (lawC t1 t2 t3) ;
  } ;
  assoc : C.El G3 P = CwFQuotElim5[a].QE5[R, encK, x, pe].elimP3 P propP
    (\ t1 t2 t3 -> AtTerms[t1, t2, t3].h) ;
  } ;
  module Add = For[OP.addQ, OP.add-assocC] ;
  module Mul = For[OP.mulQ, OP.mul-assocC] ;
} ;
