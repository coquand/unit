-- CL59h.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part h: the two equivalences used by the inverse (D rho at the
-- total site, Prop 13; tau_Q, Cor 15) have natural quasi-inverses with
-- path homotopies (GEqQinv.EQP), their types being fibrant:
--   D(yo(y.u)), D(yo(y).A)  Lemma 12F from U(yo(y.u)) (CCopy9) and
--                           U(yo(y).A) (CL59g) levelwise fibrant
--   Q, B2Q                  Q given; B2Q by Cor 15's Lemma 14 (fibU Q)
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module QH (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module U4 = CTotUFib4[a, a+, a+].UFib4[CM.IC] ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module IVd = CL59e[a].IV[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module RM = IVd.RM ;
  module YU = CCopy9[a].YoFF[R, encK, pe, LA.yu] ;
  module EFy = CL59g[a].EF[R, encK, pe, y, A] ;
  module LFu = CTotL12Fib2[a, a+, a+].L12F[CM.IC, CT.T1, RM.OY.Y1T] ;
  module LFe = CTotL12Fib2[a, a+, a+].L12F[CM.IC, CT.T1, RM.OZ.Y1T] ;
  fbDu : G1.GB.CLine[a+].Lines[CT.TC.toP LFu.D.DCtx, LFu.DA.DTy].Fib = LFu.lemma12F YU.fibG0 ;
  fbDe : G1.GB.CLine[a+].Lines[CT.TC.toP LFe.D.DCtx, LFe.DA.DTy].Fib = LFe.lemma12F EFy.fibG0 ;
  -- tau_Q
  fbQ0 : TR.G0.GB.CLine[a+].Lines[IVd.C15Q.LB.UG, IVd.C15Q.LB.UA].Fib = U4.fibU G1.fibCwF-T.nil Q.1 Q.2 ;
  fbB2 : G1.GB.CLine[a+].Lines[CT.P1, IVd.B2Q].Fib = IVd.C15Q.LG.Out[IVd.C15Q.LF.lemma12F fbQ0].fbB ;
  module Hyp (ef : TR.G0.GB.CEquiv[a+].EquivOp RM.PD.UG RM.PD.UA RM.PD.UB RM.PD.Uf)
   (mQ : G1.GB.CEquiv[a+].EquivOp CT.P1 Q.1 IVd.B2Q IVd.C15Q.tauM) {
   module DI = RM.DInv[ef] ;
   module EQd = G1.FT.GEqQinv[a+].EQP[DI.P13.DF.DG, (DI.P13.DF.DA.DTy, fbDu), (DI.P13.DF.DB.DTy, fbDe), DI.P13.DF.Df, DI.dS] ;
   module EQt = G1.FT.GEqQinv[a+].EQP[CT.P1, Q, (IVd.B2Q, fbB2), IVd.C15Q.tauM, mQ] ;
   -- the inverse of Lemma 59 from these quasi-inverses
   module DP = RM.DInvP[G1.FT.GCLocBoundRetr[a+].Map[DI.P13.DF.DG, DI.P13.DF.DB.DTy, DI.P13.DF.DA.DTy, EQd.EI.gN].pmap] ;
   module HI = IVd.HypI[DP.invP, EQt.EI.gN] ;
  } ;
 } ;
} ;
