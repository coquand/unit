-- CFibSeg.seg (canonicity-c2; SIMPLIFIED.md item 4): the interface files
-- of the fibrant CwF (Pi, Sigma, Swan Id, NF, contractibility, homotopies)
-- over ANY base: a segment FB whose fields are those of CBase.CB together
-- with the dependent conjunction of sieves (the hypothesis of Swan's Id,
-- core CId.DConj).  Inside, B is CB at the fields.  The member files are
-- the generic forms of sag-model's FibClL, FibCwF, ... (which stay as
-- they are, at the poset base).  The members G<Name>.seg are generated
-- from <Name>.seg by tools/mkseg.py: headers (the base comes from the
-- segment), the interval as a presheaf (tools/ivrw.py), El Iv as IPt, and
-- in GCLocBoundContr / GCLocBoundRetr four uses of lands-pre where the
-- poset files use that landing in a restricted sieve is landing of the
-- composite by computation.  No proof is otherwise changed.
-- The truncation layer (37 files CTrunc*) is generated in the same way:
-- 26 such uses of lands-pre (tools/patches.json), and a local variable
-- e0 / e1 renamed in three files.
level a ;
open Base ;
module VB = V[a] ;

module FB {
  obV  : VB.V ;
  homV : SmallCat[a].Objs[obV].Ob -> SmallCat[a].Objs[obV].Ob -> VB.V ;
  open SmallCat[a].Objs[obV] ;
  open SmallCat[a].Homs[obV, homV] ;
  idH (X : Ob) : Hom X X ;
  compH (X Y Z : Ob) (g : Hom Y Z) (f : Hom X Y) : Hom X Z ;
  comp-idl (J I : Ob) (f : Hom J I) : Id (Hom J I) (compH J I I (idH I) f) f ;
  comp-idr (J I : Ob) (f : Hom J I) : Id (Hom J I) (compH J J I f (idH J)) f ;
  comp-assoc (L K J I : Ob) (f : Hom J I) (g : Hom K J) (h : Hom L K)
    : Id (Hom L I) (compH L K I (compH K J I f g) h) (compH L J I f (compH L K J g h)) ;
  ivV (X : Ob) : VB.V ;
  IvP (X : Ob) : U a = VB.Ix (ivV X) ;
  ivA (Y X : Ob) (g : Hom Y X) (i : IvP X) : IvP Y ;
  ivA-id (X : Ob) (i : IvP X) : Id (IvP X) (ivA X X (idH X) i) i ;
  ivA-comp (L K J : Ob) (g : Hom K J) (h : Hom L K) (i : IvP J)
    : Id (IvP L) (ivA L K h (ivA K J g i)) (ivA L J (compH L K J g h) i) ;
  IPt : U a ;
  e0 : IPt ;
  e1 : IPt ;
  ptH (X : Ob) (e : IPt) : IvP X ;
  ptH-nat (Y X : Ob) (f : Hom Y X) (e : IPt) : Id (IvP Y) (ivA Y X f (ptH X e)) (ptH Y e) ;
  Phi (X : Ob) : U a ;
  pre (Y X : Ob) (f : Hom Y X) (Q : Phi X) : Phi Y ;
  Lands (W X : Ob) (Q : Phi X) (f : Hom W X) : U a ;
  isProp-Lands (W X : Ob) (Q : Phi X) (f : Hom W X) : Prelude[a+].isProp (Lands W X Q f) ;
  lands-comp (W' W X : Ob) (Q : Phi X) (f : Hom W X) (chi : Hom W' W) (i : Lands W X Q f)
    : Lands W' X Q (compH W' W X f chi) ;
  lands-pre (W Y X : Ob) (h : Hom Y X) (Q : Phi X) (g : Hom W Y) (i : Lands W Y (pre Y X h Q) g)
    : Lands W X Q (compH W Y X h g) ;
  pre-lands (W Y X : Ob) (h : Hom Y X) (Q : Phi X) (g : Hom W Y) (i : Lands W X Q (compH W Y X h g))
    : Lands W Y (pre Y X h Q) g ;
  phi-ext (X : Ob) (Q Q' : Phi X) (p : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Lands W X Q' f)
    (q : (W : Ob) (f : Hom W X) -> Lands W X Q' f -> Lands W X Q f) : Id (Phi X) Q Q' ;
  emptyS (X : Ob) : Phi X ;
  empty-lands (W X : Ob) (f : Hom W X) (i : Lands W X (emptyS X) f) : Empty ;
  topS (X : Ob) : Phi X ;
  top-lands (W X : Ob) (f : Hom W X) : Lands W X (topS X) f ;
  endS (W : Ob) (i : IvP W) (e : IPt) : Phi W ;
  end-pre (Y X : Ob) (g : Hom Y X) (i : IvP X) (e : IPt) : Id (Phi Y) (pre Y X g (endS X i e)) (endS Y (ivA Y X g i) e) ;
  lands-pt (W : Ob) (e : IPt) (g : IvP W) (i : Lands W W (endS W g e) (idH W)) : Id (IvP W) g (ptH W e) ;
  pt-lands (W : Ob) (e : IPt) : Lands W W (endS W (ptH W e) e) (idH W) ;
  pt-disj (W : Ob) (g : IvP W) (i : Lands W W (endS W g e0) (idH W)) (i' : Lands W W (endS W g e1) (idH W)) : Empty ;
  allS (X : Ob) (Q : Phi X) : Bool ;
  allS-sound (X : Ob) (Q : Phi X) (h : Id Bool (allS X Q) true) : Lands X X Q (idH X) ;
  allS-complete (X : Ob) (Q : Phi X) (i : Lands X X Q (idH X)) : Id Bool (allS X Q) true ;
  PhiL (X : Ob) : U a =
    (L : (W : Ob) -> Hom W X -> IvP W -> Phi W)
    * ((V W : Ob) (g : Hom V W) (f : Hom W X) (j : IvP W)
       -> Id (Phi V) (pre V W g (L W f j)) (L V (compH V W X f g) (ivA V W g j))) ;
  HoldsL (X : Ob) (L : PhiL X) (W : Ob) (f : Hom W X) : U a =
    (V : Ob) (g : Hom V W) (j : IvP V) -> Lands V V (L.1 V (compH V W X f g) j) (idH V) ;
  bigU (X : Ob) (r : Nat) (Q : Arith[a].Fin r -> Phi X) : Phi X ;
  bigU-in (W X : Ob) (r : Nat) (Q : Arith[a].Fin r -> Phi X) (f : Hom W X) (k : Arith[a].Fin r) (i : Lands W X (Q k) f)
    : Lands W X (bigU X r Q) f ;
  bigU-out (W X : Ob) (r : Nat) (Q : Arith[a].Fin r -> Phi X) (f : Hom W X) (i : Lands W X (bigU X r Q) f)
    : (k : Arith[a].Fin r) * Lands W X (Q k) f ;
  forallS (X : Ob) (L : PhiL X) : Phi X ;
  lands-forall (W X : Ob) (L : PhiL X) (f : Hom W X) (i : Lands W X (forallS X L) f) : HoldsL X L W f ;
  forall-lands (W X : Ob) (L : PhiL X) (f : Hom W X) (h : HoldsL X L W f) : Lands W X (forallS X L) f ;
  cI (d : Bool) (W : Ob) (i j : IvP W) : IvP W ;
  cI-nat (d : Bool) (V W : Ob) (g : Hom V W) (i j : IvP W)
    : Id (IvP V) (ivA V W g (cI d W i j)) (cI d V (ivA V W g i) (ivA V W g j)) ;
  cI-jsrc-t (W : Ob) (i : IvP W) : Id (IvP W) (cI true W i (ptH W e0)) (ptH W e0) ;
  cI-jsrc-f (W : Ob) (i : IvP W) : Id (IvP W) (cI false W i (ptH W e1)) (ptH W e1) ;
  cI-jtgt-t (W : Ob) (i : IvP W) : Id (IvP W) (cI true W i (ptH W e1)) i ;
  cI-jtgt-f (W : Ob) (i : IvP W) : Id (IvP W) (cI false W i (ptH W e0)) i ;
  cI-isrc-t (W : Ob) (j : IvP W) : Id (IvP W) (cI true W (ptH W e0) j) (ptH W e0) ;
  cI-isrc-f (W : Ob) (j : IvP W) : Id (IvP W) (cI false W (ptH W e1) j) (ptH W e1) ;
  cI-itgt-t (W : Ob) (j : IvP W) : Id (IvP W) (cI true W (ptH W e1) j) j ;
  cI-itgt-f (W : Ob) (j : IvP W) : Id (IvP W) (cI false W (ptH W e0) j) j ;

  -- the dependent conjunction of sieves (core CId.DConj)
  dconj (X : Ob) (Q : Phi X) (F : (W : Ob) (f : Hom W X) -> Lands W X Q f -> Phi W)
    (Fn : (V W : Ob) (g : Hom V W) (f : Hom W X) (i : Lands W X Q f) (i' : Lands V X Q (compH V W X f g))
          -> Id (Phi V) (pre V W g (F W f i)) (F V (compH V W X f g) i')) : Phi X ;
  dc-in (W X : Ob) (Q : Phi X) (F : (W'' : Ob) (f : Hom W'' X) -> Lands W'' X Q f -> Phi W'')
    (Fn : (V W' : Ob) (g : Hom V W') (f : Hom W' X) (i : Lands W' X Q f) (i' : Lands V X Q (compH V W' X f g))
          -> Id (Phi V) (pre V W' g (F W' f i)) (F V (compH V W' X f g) i'))
    (f : Hom W X) (i : Lands W X Q f) (j : Lands W W (F W f i) (idH W)) : Lands W X (dconj X Q F Fn) f ;
  dc-out (W X : Ob) (Q : Phi X) (F : (W'' : Ob) (f : Hom W'' X) -> Lands W'' X Q f -> Phi W'')
    (Fn : (V W' : Ob) (g : Hom V W') (f : Hom W' X) (i : Lands W' X Q f) (i' : Lands V X Q (compH V W' X f g))
          -> Id (Phi V) (pre V W' g (F W' f i)) (F V (compH V W' X f g) i'))
    (f : Hom W X) (i : Lands W X (dconj X Q F Fn) f) : (i' : Lands W X Q f) * Lands W W (F W f i') (idH W) ;

  module PB = CBase[a].CB[obV, homV, idH, compH, comp-idl, comp-idr, comp-assoc, ivV, ivA, ivA-id, ivA-comp, IPt, e0, e1, ptH, ptH-nat, Phi, pre, Lands, isProp-Lands, lands-comp, lands-pre, pre-lands, phi-ext, emptyS, empty-lands, topS, top-lands, endS, end-pre, lands-pt, pt-lands, pt-disj, allS, allS-sound, allS-complete, bigU, bigU-in, bigU-out, forallS, lands-forall, forall-lands, cI, cI-nat, cI-jsrc-t, cI-jsrc-f, cI-jtgt-t, cI-jtgt-f, cI-isrc-t, cI-isrc-f, cI-itgt-t, cI-itgt-f] ;

  import GPosId ;
  import GFibClL ;
  import GFibCwF ;
  import GPosJNat ;
  import GPosIdY ;
  import GPosIdYFib ;
  import GPosIdYJ ;
  import GFibIdRd ;
  import GFibIdCen ;
  import GFibId ;
  import GFibNF ;
  import GCLocBoundContr ;
  import GCLocBoundRetr ;
  import GFibContr ;
  import GFibHt ;
  import GFibYC ;
  import GFibC2 ;
  import GFibS3 ;
  import GQinvEq ;
  import GHtpyEq ;
  import GEqQinv ;
  -- the propositional truncation (SAG 8.3), generated from CTrunc*.seg
  import GCTruncRaw ;
  import GCTruncCode ;
  import GCTruncGood ;
  import GCTruncLaws ;
  import GCTruncType ;
  import GCTruncExt ;
  import GCTruncNat ;
  import GCTruncAlg ;
  import GCTruncGraph ;
  import GCTruncGraphNat ;
  import GCTruncRec ;
  import GCTruncRecExt ;
  import GCTrunc ;
  import GCTruncSeeded ;
  import GCTruncIsProp ;
  import GCTruncFinal ;
  import GCTruncEmpty ;
  import GCTruncEta ;
  import GCTruncHom ;
  import GCTruncUnique ;
  import GCTruncMorphism ;
  import GCTruncSection ;
  import GCTruncInd ;
  import GCTruncTransport ;
  import GCTruncSeededBack ;
  import GCTruncLift ;
  import GCTruncElim ;
  import GCTruncHProp ;
  import GCTruncFromProp ;
  import GCTruncElimProp ;
  import GCTruncPush ;
  import GCTruncPushAlg ;
  import GCTruncSubOp ;
  import GCTruncPushAdj ;
  import GCTruncSeed ;
  import GCTruncFib ;
  import GCTruncCwF ;
} ;
