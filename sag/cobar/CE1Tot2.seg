-- CE1Tot2.seg (canonicity-45; COBAR.md "Prop 58"): the operation step of
-- total E1 (CE1Tot): from op (L p, L q) ~ op (tau pre_(k_p), tau pre_(k_q)),
-- through the code W = (p, q) (CCodeH paths W . I_i ~ k, CCmpY6's
-- compatibility precomposed with W, associativity of codes) to
-- tau pre_(k_(p op q)).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module T2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation) {
 module A = CE1Tot[a].T1[R, encK, pe, t] ;
 module CM = A.CM ;
 module HO1 = A.HO1 ;
 module C6 = A.C6 ;
 P1 : A.G1.GB.GPre[a+].PS.PCtx = A.P1 ;
 XT : A.G1.GB.GPre[a+].PS.PTy[P1] = A.XT ;
 GT : A.G1.GB.GPre[a+].PS.PTy[P1] = A.GT ;
 module OpS (io : (J : Ob) -> CM.MO.Fn[CM.F1, CM.F2].M J) (ion : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[CM.F1, CM.F2].M K) (CM.MO.Fn[CM.F1, CM.F2].res J K v (io J)) (io K))
   (Phi : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (OV.Fun FibCwF[a, a+].fibCwF.nil (CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt) (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt)))
   (ioE : (I : Ob) (f : Hom I I) (u : V1.Ix ((CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt).1.tob I tt)) -> Id (V1.Ix ((CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt).1.tob I tt)) ((io I).1.1 I f u) ((Phi.eob I tt).1 I f u))
   (u0 : SX.Over[R].Der[CM.F2].Term)
   (bt : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (IJ.IdT FibCwF[a, a+].fibCwF.nil (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt)
           (OV.app FibCwF[a, a+].fibCwF.nil (CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt) (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].Qt) Phi (CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].AX.cls (var (inr tt))))
           (CHomT3[a].HomP[R, encK, pe].Alg[CM.F2].AX.cls u0)))
   (p q : A.TmT) (Lp Lq : HO1.NMap[P1, XT, GT])
   (rp : A.G1.GB.GPre[a+].PS.PEl[A.G1.GB.GPre[a+].PS.extP P1 XT, HO1.HT[P1, XT, GT, Lp, A.Rs p].PT.PathP])
   (rq : A.G1.GB.GPre[a+].PS.PEl[A.G1.GB.GPre[a+].PS.extP P1 XT, HO1.HT[P1, XT, GT, Lq, A.Rs q].PT.PathP]) {
  module GO = A.GOp[io, ion] ;
  module WQ = A.WC[p, q] ;
  module S1 = WQ.Step[CM.II.I1.M.mor, CM.II.I1.M.mor-nat, CM.II.I1.SM.Phi, \ I f u -> refl ((CM.II.I1.SM.Phi.eob I tt).1 I f u), A.FR.x1, CM.II.I1.SM.beta (var (inr tt))] ;
  module S2 = WQ.Step[CM.II.I2.M.mor, CM.II.I2.M.mor-nat, CM.II.I2.SM.Phi, \ I f u -> refl ((CM.II.I2.SM.Phi.eob I tt).1 I f u), A.FR.x2, CM.II.I2.SM.beta (var (inr tt))] ;
  module S3 = WQ.Step[io, ion, Phi, ioE, u0, bt] ;
  aI1 : HO1.NMap[P1, XT, GT] = A.aC S1.WI.c S1.WI.cn ;
  aI2 : HO1.NMap[P1, XT, GT] = A.aC S2.WI.c S2.WI.cn ;
  aOp : HO1.NMap[P1, XT, GT] = A.aC S3.WI.c S3.WI.cn ;
  -- the Step homotopies, retyped on CE1Tot's maps
  module H1 = HO1.Ret[P1, XT, GT, HO1.compN P1 XT C6.Q1.Y1T GT S1.G.H.PLm.mA S1.G.H.tauN, HO1.compN P1 XT C6.Q1.Y1T GT S1.G.H.PLm.mB S1.G.H.tauN,
    aI1, A.Rs p, \ I x c -> refl (aI1.nfun I x c), \ I x c -> refl ((A.Rs p).nfun I x c), S1.G.H.res] ;
  module H2 = HO1.Ret[P1, XT, GT, HO1.compN P1 XT C6.Q1.Y1T GT S2.G.H.PLm.mA S2.G.H.tauN, HO1.compN P1 XT C6.Q1.Y1T GT S2.G.H.PLm.mB S2.G.H.tauN,
    aI2, A.Rs q, \ I x c -> refl (aI2.nfun I x c), \ I x c -> refl ((A.Rs q).nfun I x c), S2.G.H.res] ;
  module H3 = HO1.Ret[P1, XT, GT, HO1.compN P1 XT C6.Q1.Y1T GT S3.G.H.PLm.mA S3.G.H.tauN, HO1.compN P1 XT C6.Q1.Y1T GT S3.G.H.PLm.mB S3.G.H.tauN,
    aOp, A.Rs S3.s', \ I x c -> refl (aOp.nfun I x c), \ I x c -> refl ((A.Rs S3.s').nfun I x c), S3.G.H.res] ;
  module I1 = HO1.Inv[P1, XT, GT, aI1, A.Rs p, A.cB, H1.res] ;
  module I2 = HO1.Inv[P1, XT, GT, aI2, A.Rs q, A.cB, H2.res] ;
  module A1 = GO.AO.Ap[Lp, A.Rs p, Lq, A.Rs q, rp, rq] ;
  module A2 = GO.AO.Ap[A.Rs p, aI1, A.Rs q, aI2, I1.res, I2.res] ;
  -- CCmpY6's compatibility at W (precomposition with W), retyped by associativity of codes
  preW : HO1.NMap[P1, XT, C6.Q2.Y1T] = A.PreN[t, CM.F2, WQ.S.M.mor, WQ.S.M.mor-nat].nm ;
  module Cw = HO1.WR[P1, C6.Q2.Y1T, GT, XT, GO.OC.l, GO.OC.r, preW, GO.OC.compat] ;
  tq (I : A.CT.TC.TOb) (g : CM.MO.Fn[CM.F1, I.2].M I.1) : C6.Q1.DY.Ob' I.1 I.2 = C6.Q1.DY.tau I.1 I.2 g ;
  pa (I : A.CT.TC.TOb) (x : V1.Ix (P1.ob I)) (c : V1.Ix (XT.tob I x))
   : Id (V1.Ix (GT.tob I x)) ((GO.AO.OP aI1 aI2).nfun I x c) ((HO1.compN P1 XT C6.Q2.Y1T GT preW GO.OC.l).nfun I x c) =
   transH (apH {CM.MO.Fn[CM.F1, I.2].M I.1} {V1.Ix (GT.tob I x)} (\ g -> GO.OC.OP.op.nt I.1 I.2 (tq I g, aI2.nfun I x c)) (symH (S1.assoc I.1 I.2 c)))
    (apH {CM.MO.Fn[CM.F1, I.2].M I.1} {V1.Ix (GT.tob I x)} (\ g -> GO.OC.OP.op.nt I.1 I.2 (tq I (CM.Pre[CM.F2, CM.F1, CM.II.I1.M.mor, CM.II.I1.M.mor-nat].pre I.1 I.2 (preW.nfun I x c)), tq I g)) (symH (S2.assoc I.1 I.2 c))) ;
  pb (I : A.CT.TC.TOb) (x : V1.Ix (P1.ob I)) (c : V1.Ix (XT.tob I x))
   : Id (V1.Ix (GT.tob I x)) (aOp.nfun I x c) ((HO1.compN P1 XT C6.Q2.Y1T GT preW GO.OC.r).nfun I x c) =
   apH {CM.MO.Fn[CM.F1, I.2].M I.1} {V1.Ix (GT.tob I x)} (tq I) (symH (S3.assoc I.1 I.2 c)) ;
  module Rw = HO1.Ret[P1, XT, GT, HO1.compN P1 XT C6.Q2.Y1T GT preW GO.OC.l, HO1.compN P1 XT C6.Q2.Y1T GT preW GO.OC.r, GO.AO.OP aI1 aI2, aOp, pa, pb, Cw.res] ;
  -- op (L p, L q) ~ tau . pre_(k_(p op q))
  module C3 = HO1.Cat[P1, XT, GT, GO.AO.OP aI1 aI2, aOp, A.Rs S3.s', A.cB, Rw.res, H3.res] ;
  module C2 = HO1.Cat[P1, XT, GT, GO.AO.OP (A.Rs p) (A.Rs q), GO.AO.OP aI1 aI2, A.Rs S3.s', A.cB, A2.res, C3.res] ;
  module C1 = HO1.Cat[P1, XT, GT, GO.AO.OP Lp Lq, GO.AO.OP (A.Rs p) (A.Rs q), A.Rs S3.s', A.cB, A1.res, C2.res] ;
  res : A.G1.GB.GPre[a+].PS.PEl[A.G1.GB.GPre[a+].PS.extP P1 XT, HO1.HT[P1, XT, GT, GO.AO.OP Lp Lq, A.Rs S3.s'].PT.PathP] = C1.res ;
 } ;
} ;
