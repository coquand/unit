-- CGops.seg (canonicity-45; SIMPLIFIED.md step 6): the ring operations of
-- G = D(yo F1) (jonas.pdf Construction 45): addition (multiplication) is
--   G x G -> D(yo F1 x yo F1) -> D(yo F2) -> D(yo F1) = G
-- (D on products; the inverse inv of D applied to the comparison, Prop 13's
-- conclusion, a module parameter; D of precomposition with AddF (MulF)).
-- Based on the comparison map
-- yo(F2) -> yo(F1) x yo(F1), h |-> (h . iota1, h . iota2), strict (C's
-- composition), natural by C's associativity and the stage-naturality of
-- the coprojections (Lemma 43's comparison; G's operations go through its
-- image under D, inverted by Prop 13).
--   Yo[F]      the presheaf yo(F) on the total site (as CGen's yoF)
--   cmpS       the comparison as a substitution of contexts
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module V1 = V[a+] ;

module GopsOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (elim1 : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Ty)
 (elim1-beta : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Beta (elim1 x))
 (setQ : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].SetQ)
 (elim2 : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Ty)
 (elim2-beta : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Beta (elim2 x))
 (elimP1 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP1Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (elimP3 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP3Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (setQi : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].SetQiTy)
 (inv : CTPsh[a, a+, a+].TPshOf[CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].IC].TSub[CobarI[a, a+, a+].DOfI[CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].IC].DC[CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].PD.prodT CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].Yo[CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].F1].yoT CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].Yo[CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].F1].yoT].DCtx, CobarI[a, a+, a+].DOfI[CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].IC].DC[CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].Yo[CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi].F2].yoT].DCtx]) {
 module CM = CCmp[a].CmpOf[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi] ;
 module TP = CM.TP ;
 module DO = CobarI[a, a+, a+].DOfI[CM.IC] ;
 Y1 : TP.TCtx = CM.Yo[CM.F1].yoT ;
 Y2 : TP.TCtx = CM.Yo[CM.F2].yoT ;
 G : TP.TCtx = DO.DC[Y1].DCtx ;
 -- composition of substitutions of displayed contexts
 compS (D1 D2 D3 : TP.TCtx) (s : TP.TSub[D2, D3]) (t : TP.TSub[D1, D2]) : TP.TSub[D1, D3] =
  new TP.TSub[D1, D3, \ I x d -> s.nt I x (t.nt I x d),
   \ J I u y x f d -> transH (apH {V1.Ix (D2.ob J y)} {V1.Ix (D3.ob J y)} (s.nt J y) (t.nt-nat J I u y x f d)) (s.nt-nat J I u y x f (t.nt I x d))] ;
 module PP = CM.PD.PD[Y1, Y1] ;
 -- an operation from a structure map F1 -> F2
 module Op (io : (J : Ob) -> CM.MO.Fn[CM.F1, CM.F2].M J) (io-nat : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[CM.F1, CM.F2].M K) (CM.MO.Fn[CM.F1, CM.F2].res J K v (io J)) (io K)) {
  module PR = CM.Pre[CM.F2, CM.F1, io, io-nat] ;
  dY : TP.TSub[DO.DC[Y2].DCtx, G] = DO.DS[Y2, Y1, PR.preS].DSub ;
  op : TP.TSub[CM.PD.prodT G G, G] =
   compS (CM.PD.prodT G G) (DO.DC[Y2].DCtx) G dY (compS (CM.PD.prodT G G) PP.DGH.DCtx (DO.DC[Y2].DCtx) inv PP.fromS) ;
 } ;
 module Add = Op[CM.II.AddF.M.mor, CM.II.AddF.M.mor-nat] ;
 module Mul = Op[CM.II.MulF.M.mor, CM.II.MulF.M.mor-nat] ;
 add : TP.TSub[CM.PD.prodT G G, G] = Add.op ;
 mul : TP.TSub[CM.PD.prodT G G, G] = Mul.op ;
} ;
