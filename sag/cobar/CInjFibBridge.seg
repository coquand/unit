-- CInjP's displayed fibre is the generic contractible-fibre predicate's
-- fibre.  Prove this once with abstract domain, codomain, and natural map.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module PB = PosFull[a].PB ;
module HO = PB.CHtpyOps[a+] ;
module QP = CwFQP.QP[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf] ;
module QB = CwFQinv.Qinv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, C].IdJStr = FibId[a, a+].fibId ;
SS : CwF.Formers[a++, C].SigStr = FibCwF[a, a+].fibSig ;

module Bridge (A B : C.Ty C.nil) (n : HO.NMap[C.nil, A.1, B.1]) {
 module I = CInjP[a].IP[A, B, n] ;
 f2' : C.El I.GX (OV.Fun I.GX (OV.wkT I.GB I.Xb I.Xb) (OV.wkT I.GB I.Xb I.Bb)) =
  EQ.wkF I.GB I.Xb I.Xb I.Bb I.f1 ;
 f2Eq : Id (C.El I.GX (OV.Fun I.GX (OV.wkT I.GB I.Xb I.Xb) (OV.wkT I.GB I.Xb I.Bb))) I.f2 f2' = refl I.f2 ;
 app' : C.El I.GX (OV.wkT I.GB I.Xb I.Bb) =
  OV.app I.GX (OV.wkT I.GB I.Xb I.Xb) (OV.wkT I.GB I.Xb I.Bb) f2' (C.q I.GB I.Xb) ;
 appEq : Id (C.El I.GX (OV.wkT I.GB I.Xb I.Bb)) I.apX app' =
  apH {C.El I.GX (OV.Fun I.GX (OV.wkT I.GB I.Xb I.Xb) (OV.wkT I.GB I.Xb I.Bb))}
      {C.El I.GX (OV.wkT I.GB I.Xb I.Bb)}
      (\ f -> OV.app I.GX (OV.wkT I.GB I.Xb I.Xb) (OV.wkT I.GB I.Xb I.Bb) f (C.q I.GB I.Xb)) f2Eq ;
 Fam1 : C.Ty I.GX = IJ.IdT I.GX (OV.wkT I.GB I.Xb I.Bb) I.apX (OV.wkE I.GB I.Xb I.Bb (C.q C.nil B)) ;
 fam1Eq : Id (C.Ty I.GX) I.Fm Fam1 = refl Fam1 ;
 Fam2 : C.Ty I.GX = IJ.IdT I.GX (OV.wkT I.GB I.Xb I.Bb) app' (OV.wkE I.GB I.Xb I.Bb (C.q C.nil B)) ;
 fam2Eq : Id (C.Ty I.GX) Fam1 Fam2 =
  apH {C.El I.GX (OV.wkT I.GB I.Xb I.Bb)} {C.Ty I.GX}
    (\ v -> IJ.IdT I.GX (OV.wkT I.GB I.Xb I.Bb) v (OV.wkE I.GB I.Xb I.Bb (C.q C.nil B))) appEq ;
 Fam3 : C.Ty I.GX = QB.FamE I.GB I.Xb I.Bb I.f1 (C.q C.nil B) ;
 fam3Eq : Id (C.Ty I.GX) Fam2 Fam3 = refl Fam3 ;
 source : C.Ty I.GB = QB.FibE I.GB I.Xb I.Bb I.f1 (C.q C.nil B) ;
 sourceEq : Id (C.Ty I.GB) I.Fib source =
  apH {C.Ty I.GX} {C.Ty I.GB} (\ T -> SS.Sig I.GB I.Xb T)
    (transH fam1Eq (transH fam2Eq fam3Eq)) ;
 Fv : C.Ty I.GB = QP.FVr C.nil B A I.fC ;
 fvEq : Id (C.Ty I.GB) source Fv = refl Fv ;
 fibreEq : Id (C.Ty I.GB) I.Fib Fv = transH sourceEq fvEq ;
} ;
