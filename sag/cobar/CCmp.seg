-- CCmp.seg (canonicity-45; SIMPLIFIED.md step 6): the comparison map
-- yo(F2) -> yo(F1) x yo(F1), h |-> (h . iota1, h . iota2), strict (C's
-- composition), natural by C's associativity and the stage-naturality of
-- the coprojections (Lemma 43's comparison; G's operations go through its
-- image under D, inverted by Prop 13).
--   Yo[F]      the presheaf yo(F) on the total site (as CGen's yoF)
--   cmpS       the comparison as a substitution of contexts
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module V1 = V[a+] ;

module CmpOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (elim1 : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Ty)
 (elim1-beta : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Beta (elim1 x))
 (setQ : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].SetQ)
 (elim2 : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Ty)
 (elim2-beta : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Beta (elim2 x))
 (elimP1 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP1Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (elimP3 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP3Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (setQi : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].SetQiTy) {
 module II = CMapsI[a].InstI[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi] ;
 module CO = CMorXC[a].CatOf[R, encK, pe, II.IN.addO, II.IN.mulO] ;
 module MO = CO.MO ;
 IC : CIntCat[a, a+].IC = CO.IC ;
 module TP = CTPsh[a, a+, a+].TPshOf[IC] ;
 module PD = CDProd[a, a+, a+].ProdOf[IC] ;
 Pres : U a = MO.Pres ;
 F1 : Pres = II.FR.F1 ;
 F2 : Pres = II.FR.F2 ;
 -- yo(F)
 module Yo (F : Pres) {
  yob (I : Ob) (x : Pres) : V1.V = CO.homV1 I x F ;
  yoa (J I : Ob) (u : Hom J I) (y x : Pres) (f : MO.Fn[x, y].M J) (g : MO.Fn[F, x].M I) : MO.Fn[F, y].M J = CO.cmpM J I I u y x F g f ;
  yo-id (I : Ob) (x : Pres) (g : MO.Fn[F, x].M I) : Id (MO.Fn[F, x].M I) (yoa I I (idH I) x x (CO.idM I x) g) g =
   apH {(w : Hom I I) * MO.Fn[F, x].M I} {MO.Fn[F, x].M I} (\ p -> p.2) (CO.idrL I I (idH I) x F g) ;
  yo-o (K J I : Ob) (u : Hom J I) (v : Hom K J) (z y x : Pres) (f : MO.Fn[x, y].M J) (f' : MO.Fn[y, z].M K) (g : MO.Fn[F, x].M I)
   : Id (MO.Fn[F, z].M K) (yoa K I (compH K J I u v) z x (CO.cmpM K J I v z y x f f') g) (yoa K J v z y f' (yoa J I u y x f g)) =
   symH (apH {(w : Hom K I) * MO.Fn[F, z].M K} {MO.Fn[F, z].M K} (\ p -> p.2) (CO.As[K, J, I, I, idH I, u, v, z, y, x, F, g, f, f'].law)) ;
  yoT : TP.TCtx = new TP.TCtx[yob, yoa, yo-id, yo-o] ;
 } ;
 -- precomposition with a morphism F' -> F given at every stage, natural
 module Pre (F F' : Pres) (io : (J : Ob) -> MO.Fn[F', F].M J)
  (io-nat : (J K : Ob) (v : Hom K J) -> Id (MO.Fn[F', F].M K) (MO.Fn[F', F].res J K v (io J)) (io K)) {
  cw (I : Ob) (x : Pres) (f0 : MO.Fn[F', F].M I) (h : MO.Fn[F, x].M I) : MO.Fn[F', x].M I = MO.Cmp[F', F, x, I, f0, h].cmp ;
  pre (I : Ob) (x : Pres) (h : MO.Fn[F, x].M I) : MO.Fn[F', x].M I = CO.cmpM I I I (idH I) x F F' (io I) h ;
  pre-nat (J I : Ob) (u : Hom J I) (y x : Pres) (f : MO.Fn[x, y].M J) (h : MO.Fn[F, x].M I)
   : Id (MO.Fn[F', y].M J) (pre J y (Yo[F].yoa J I u y x f h)) (Yo[F'].yoa J I u y x f (pre I x h)) =
   transH (apH {MO.Fn[F', F].M J} {MO.Fn[F', y].M J} (\ f0 -> cw J y f0 (Yo[F].yoa J I u y x f h)) (io-nat J J (idH J)))
    (transH (symH (apH {MO.Fn[F', F].M J} {MO.Fn[F', y].M J} (\ f0 -> cw J y f0 (Yo[F].yoa J I u y x f h)) (io-nat I J (compH J I I (idH I) u))))
      (symH (apH {(w : Hom J I) * MO.Fn[F', y].M J} {MO.Fn[F', y].M J} (\ p -> p.2) (CO.As[J, I, I, I, idH I, idH I, u, y, x, F, F', io I, h, f].law)))) ;
  preS : TP.TSub[Yo[F].yoT, Yo[F'].yoT] = new TP.TSub[Yo[F].yoT, Yo[F'].yoT, pre, pre-nat] ;
 } ;
 module P1 = Pre[F2, F1, II.I1.M.mor, II.I1.M.mor-nat] ;
 module P2 = Pre[F2, F1, II.I2.M.mor, II.I2.M.mor-nat] ;
 -- the comparison
 cmpS : TP.TSub[Yo[F2].yoT, PD.prodT Yo[F1].yoT Yo[F1].yoT] =
  new TP.TSub[Yo[F2].yoT, PD.prodT Yo[F1].yoT Yo[F1].yoT, \ I x h -> (P1.pre I x h, P2.pre I x h),
   \ J I u y x f h -> PD.pairE2 (MO.Fn[F1, y].M J) (MO.Fn[F1, y].M J) _ _ _ _ (P1.pre-nat J I u y x f h) (P2.pre-nat J I u y x f h)] ;
} ;
