-- CClsEqC.seg (canonicity-45; SIMPLIFIED.md step 2b): equal classes from
-- a derivation.  For two terms t, t' of a presentation x and a derivation
-- d of t ~ t', the classes of the constants t, t' in the quotient A_x are
-- Id-equal: c2's cls-eq needs maps both ways between the relations
-- "t ~ c" and "t' ~ c" at the variable c over nil.Tm; by the packaging
-- over the constant type Tm (CConstLam.packX) such a map is a metatheory
-- family over u0 : Term of maps over nil from Rel (ct t) (ct u0) to
-- Rel (ct t') (ct u0), i.e. (relV-pt, relT-ct) from the decoded
-- truncation of Proof t u0 to that of Proof t' u0, which is the
-- elimination of the former into the latter (a proposition) at the
-- family w |-> the unit at transP (symP d) w (CRelResp.PackAp).
--   clsEqC t t' d : El nil (Id Qt (clsG (ct t)) (clsG (ct t')))
-- pe (propositional extensionality) is a module parameter, as in c2's
-- CwFQuotEq.  No new axioms beyond the named premises.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module GS = PB.GPre[a].PS ;
module L = PB.GPre[a+].PS ;
module FU = FibUniv[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module FB = FibCwF[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FB.fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module ClsEqC (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module RP = CRelPack[a].Rel[R, encK, x] ;
 module Dx = SX.Over[R].Der[x] ;
 module QE = CwFQuotEq.QuotEq[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf, CTruncAtBase[a].truncAt, pe].E[C.nil, RP.Tm, RP.r] ;
 module QQ = QE.QQ ;
 Nl : C.Ctx = C.nil ;
 Term : U a = RP.Term ;
 D : C.Ctx = C.ext Nl RP.Tm ;

 -- the unit of the truncation of Proof t u at a given proof, as a global
 -- element of the truncation type over the terminal context (level a)
 module UnitP (t u : Term) (w : Dx.Proof t u) {
  module T = RP.RC.PT[t, u].T ;
  T0 : GS.PTy[GS.nilP] = T.Tr0.1 ;
  ob (I : Ob) (z : W0.Ix (GS.nilP.ob I)) : W0.Ix (T0.tob I z) = T.incV I (z, w) ;
  nat (J I : Ob) (f : Hom J I) (z : W0.Ix (GS.nilP.ob I)) (z' : W0.Ix (GS.nilP.ob J)) (e : Id (W0.Ix (GS.nilP.ob J)) (GS.nilP.act J I f z) z')
   : Id (W0.Ix (T0.tob J z')) (T0.tact J I f z z' e (ob I z)) (ob J z') =
   transH (apH {Id (W0.Ix (GS.nilP.ob J)) (GS.nilP.act J I f z) z'} {W0.Ix (T0.tob J z')} (\ q -> T0.tact J I f z z' q (ob I z))
             (W0.isSetIx (GS.nilP.ob J) (GS.nilP.act J I f z) z' e
                (GS.ntEq T.GA GS.nilP (GS.pP GS.nilP RP.RC.PT[t, u].P0.1) J I f (z, w) (z', w) (apH {W0.Ix (GS.nilP.ob J)} {W0.Ix (T.GA.ob J)} (\ w2 -> (w2, w)) e))))
    (T.incN J I f (z, w) (z', w) (apH {W0.Ix (GS.nilP.ob J)} {W0.Ix (T.GA.ob J)} (\ w2 -> (w2, w)) e)) ;
  el : GS.PEl[GS.nilP, T0] = GS.mkPEl GS.nilP T0 ob nat ;
  -- decoded, at level a+
  dec : C.El Nl (RP.Dc t u) = CClosedCode[a].Closed[RP.RC.PT[t, u].T.Tr0.1, RP.RC.PT[t, u].T.Tr0.2].elUp L.nilP el ;
 } ;

 -- from a derivation d : t ~ t', for every u0 the map over nil from the
 -- decoded truncation of Proof t u0 to that of Proof t' u0
 module Mv (t t' : Term) (d : Dx.Proof t t') (u0 : Term) {
  pf (w : Dx.Proof t u0) : Dx.Proof t' u0 = Dx.transP t' t u0 (Dx.symP t t' d) w ;
  module PA = CRelResp[a].PackAp[R, encK, x, t, u0, RP.Dc t' u0, RP.prop t' u0, \ w -> UnitP[t', u0, pf w].dec] ;
  m : C.El (C.ext Nl (RP.Dc t u0)) (OV.wkT Nl (RP.Dc t u0) (RP.Dc t' u0)) = PA.O.elim ;
 } ;

 -- the relation at the variable, at a constant, is the decoded truncation
 relV-c (t u0 : Term) : Id (C.Ty Nl) (C.subT Nl D (QE.relV (RP.ct t)) (C.sec Nl RP.Tm (RP.ct u0))) (RP.Dc t u0) =
  transH (QE.relV-pt (RP.ct t) (RP.ct u0)) (RP.relT-ct t u0) ;

 -- an element over nil.A' of A' -> B' (A' the decoded truncation), read as
 -- an element over nil.(relV a)[sec] of (relV a -> relV b)[lift]
 module Fam (t t' : Term) (d : Dx.Proof t t') (u0 : Term) {
  Xs : C.Ty Nl = C.subT Nl D (QE.relV (RP.ct t)) (C.sec Nl RP.Tm (RP.ct u0)) ;
  Ys : C.Ty Nl = C.subT Nl D (QE.relV (RP.ct t')) (C.sec Nl RP.Tm (RP.ct u0)) ;
  Wt : C.Ty (C.ext D (QE.relV (RP.ct t))) = OV.wkT D (QE.relV (RP.ct t)) (QE.relV (RP.ct t')) ;
  Tgt (A' : C.Ty Nl) (PA : Id (C.Ty Nl) Xs A') : U a++ =
   C.El (C.ext Nl Xs) (C.subT (C.ext Nl Xs) (C.ext D (QE.relV (RP.ct t))) Wt (C.lift Nl D (QE.relV (RP.ct t)) (C.sec Nl RP.Tm (RP.ct u0)))) ;
  -- at PA = refl, upT is lift and wkT-ov reads the weakening of B' as Wt[lift]
  back (A' : C.Ty Nl) (PA : Id (C.Ty Nl) Xs A') (e : C.El (C.ext Nl A') (OV.wkT Nl A' (RP.Dc t' u0))) : Tgt A' PA =
   idJ (C.Ty Nl) Xs (\ A2 PA2 -> C.El (C.ext Nl A2) (OV.wkT Nl A2 (RP.Dc t' u0)) -> Tgt A2 PA2)
    (\ e2 -> OV.trE (C.ext Nl Xs) (OV.wkT Nl Xs (RP.Dc t' u0))
               (C.subT (C.ext Nl Xs) (C.ext D (QE.relV (RP.ct t))) Wt (C.lift Nl D (QE.relV (RP.ct t)) (C.sec Nl RP.Tm (RP.ct u0))))
               (symH (OV.wkT-ov Nl D (QE.relV (RP.ct t)) (QE.relV (RP.ct t')) (C.sec Nl RP.Tm (RP.ct u0)) Xs (refl Xs) (RP.Dc t' u0) (relV-c t' u0)))
               e2)
    A' PA e ;
  res : Tgt (RP.Dc t u0) (relV-c t u0) = back (RP.Dc t u0) (relV-c t u0) Mv[t, t', d, u0].m ;
 } ;

 -- the two maps of cls-eq, packaged over the constant type
 F (t t' : Term) (d : Dx.Proof t t') : C.El (C.ext D (QE.relV (RP.ct t))) (OV.wkT D (QE.relV (RP.ct t)) (QE.relV (RP.ct t'))) =
  RP.LM.L.packX L.nilP (QE.relV (RP.ct t)).1 (OV.wkT D (QE.relV (RP.ct t)) (QE.relV (RP.ct t'))).1 (\ u0 -> Fam[t, t', d, u0].res) ;
 clsEqC (t t' : Term) (d : Dx.Proof t t') : C.El Nl (IJ.IdT Nl QQ.Qt (QQ.clsG (RP.ct t)) (QQ.clsG (RP.ct t'))) =
  QE.cls-eq (RP.ct t) (RP.ct t') (F t t' d) (F t' t (Dx.symP t t' d)) ;
} ;
