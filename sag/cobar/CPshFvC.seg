-- CPshFvC.seg (canonicity-c2; COBAR.md, the S3 bridge, part (III), P2):
-- in the CwF of uniformly fibrant C-types, for X , Y over G and
-- r : Y -> X, the interface's fibre FVr (Sigma y Id(r y , x), CwFFv) is,
-- as a C-type over G.X, the fibre FVc of CPshFibC for the map al of r.
--
-- (1) al is the map of the element bod r of X[p] over G.Y (CPshMapC.ofEl):
--     al (g , y) = (g , r y).
-- (2) The end e1 of FVr is, at each x and each point, bod r at (g , y):
--     CwFFv.E.end says that e1 is a transport of (bod r)[tau] along a
--     path of fibrant types, and such a transport does not change the
--     values (celTr: the codes of the fibres form a set).  So e1 is the
--     end a0C of CPshFibC (e1v), and FVr.1 = FVc (fvEq).
-- Premises: those of CPshFibC, CPshPiFibC, CPshSigFib, CPshIdJ4, CPshNFC.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;

module FvCOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module MC = CPshMapC[a, l].MapCOf[C] ;
 module FBm = CPshFibC[a, l].FibCOf[C] ;
 module PCl = CPshPiFibC[a, l].PiClOf[C] ;
 module SCl = CPshSigFib[a, l].SigFibOf[C] ;
 module IJ = CPshIdJ4[a, l].IdJOf[C] ;
 module NFc = CPshNFC[a, l].NFCOf[C] ;
 module IDm = CPshId[a, l].IdOf[C] ;
 module SGm = CPshSig[a, l].SigOf[C] ;
 CF : CwF.CwF[l+] = UF.CFibCwF ;
 module OV = CwFOv.Ov[l+, CF, PCl.FPiC.SPi, SCl.FSigC.SSig, IJ.PIdJ] ;
 module QP = CwFQP.QP[l+, CF, PCl.FPiC.SPi, SCl.FSigC.SSig, IJ.PIdJ, NFc.nf] ;
 module FV = CwFFv.Fv[l+, CF, PCl.FPiC.SPi, SCl.FSigC.SSig, IJ.PIdJ, NFc.nf] ;
 open P ;

 -- a transport of a C-element along a path of fibrant types keeps the values
 celTr (G : CCtx) (B B' : UF.FCC.STy G) (Pq : Id (UF.FCC.STy G) B B') (u : CEl[G, B.1]) (x : CO) (I : Ob) (g : W0.Ix ((G.ob x).ob I))
  (c : Id W0.V ((B.1.ty x).tob I g) ((B'.1.ty x).tob I g))
  : Id (W0.Ix ((B'.1.ty x).tob I g)) (((subst (UF.FCC.STy G) (\ Z -> CEl[G, Z.1]) B B' Pq u).el x).eob I g)
       (subst W0.V (\ v -> W0.Ix v) ((B.1.ty x).tob I g) ((B'.1.ty x).tob I g) c ((u.el x).eob I g)) =
  idJ (UF.FCC.STy G) B
   (\ B2 P2 -> (c2 : Id W0.V ((B.1.ty x).tob I g) ((B2.1.ty x).tob I g))
      -> Id (W0.Ix ((B2.1.ty x).tob I g)) (((subst (UF.FCC.STy G) (\ Z -> CEl[G, Z.1]) B B2 P2 u).el x).eob I g)
            (subst W0.V (\ v -> W0.Ix v) ((B.1.ty x).tob I g) ((B2.1.ty x).tob I g) c2 ((u.el x).eob I g)))
   (\ c2 -> apH (\ q -> subst W0.V (\ v -> W0.Ix v) ((B.1.ty x).tob I g) ((B.1.ty x).tob I g) q ((u.el x).eob I g))
              (W0.isSetV ((B.1.ty x).tob I g) ((B.1.ty x).tob I g) (refl ((B.1.ty x).tob I g)) c2))
   B' Pq c ;

 module Fv (G : CCtx) (X Y : UF.FCC.STy G) (r : CF.El G (OV.Fun G Y X)) {
  module MY = MC.M[G, Y.1, X.1] ;
  rb : CEl[MY.GY, MY.XY] = OV.bod G Y (OV.wkT G Y X) r ;
  al : P13.CMap[G, Y.1, X.1] = MY.ofEl rb ;
  module FE = FV.E[G, X, Y, r] ;
  module Fb = FBm.Fb[G, Y.1, X.1, al] ;

  -- (2) the end of FVr is the end of FVc
  e1v (x : CO) (W : Ob) (z : W0.Ix ((Fb.Kc.ob x).ob W)) : Id (W0.Ix ((Fb.XKc.ty x).tob W z)) ((FE.e1.el x).eob W z) (Fb.Rm[x].R.a0v W z) =
   GPR.TyL[G.ob x, X.1.ty x].pr-inj W (Fb.Rm[x].R.HF.sx W z) ((FE.e1.el x).eob W z) (Fb.Rm[x].R.a0v W z)
    (transH (apH (GPR.TyL[G.ob x, X.1.ty x].pr W (Fb.Rm[x].R.HF.sx W z))
              (transH (apH (\ v -> (v.el x).eob W z) (symH FE.end.2))
                (celTr FE.K' (CF.subT FE.K' (CF.ext G Y) (OV.wkT G Y X) FE.tau) FE.B1 FE.end.1 FE.rt x W z
                   (refl ((X.1.ty x).tob W (Fb.Rm[x].R.HF.sx W z))))))
      (symH (Fb.Rm[x].R.aQ W z))) ;
  -- stated with the names of CwFFv.E; the names of CPshFibC enter once (a0E, idK)
  a0E : CEl[FE.K', FE.B1.1] = Fb.a0C ;
  e1eq : Id (CEl[FE.K', FE.B1.1]) FE.e1 a0E = EX.cel-ext FE.K' FE.B1.1 FE.e1 a0E e1v ;

 } ;
} ;
