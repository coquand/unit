-- CTauOps.seg (canonicity-45; COBAR.md "Prop 58"): the unit tau of D
-- commutes with D of context maps and with D's pairing on products, on the
-- nose (D-points are equal when their families are, DC.ob-eq):
--   DS.dmap (tau g) = tau (s g)        (s's naturality at each index)
--   fromS (tau g, tau h) = tau (g, h)  (the families agree by definition)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module TauOps (C : CIntCat[a, vl].IC) {
 module TP = CTPsh[a, vl, l].TPshOf[C] ;
 module DO = CobarI[a, vl, l].DOfI[C] ;
 module PR = CDProd[a, vl, l].ProdOf[C] ;
 Obj (I : Ob) : U vl = DO.Obj I ;
 module TauS (Dc G : TP.TCtx) (s : TP.TSub[Dc, G]) {
  module DSs = DO.DS[Dc, G, s] ;
  law (I : Ob) (x : Obj I) (g : W0.Ix (Dc.ob I x)) : Id (DSs.DG.Ob' I x) (DSs.dmap I x (DSs.DD.tau I x g)) (DSs.DG.tau I x (s.nt I x g)) =
   DSs.DG.ob-eq I x (DSs.dmap I x (DSs.DD.tau I x g)) (DSs.DG.tau I x (s.nt I x g)) (\ q l ->
    s.nt-nat q.2.1 I q.2.2.1 q.2.2.2.1 x (DSs.DD.tmap I x q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) g) ;
 } ;
 module TauP (G H : TP.TCtx) {
  module PP = PR.PD[G, H] ;
  law (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (h : W0.Ix (H.ob I x))
   : Id (PP.DGH.Ob' I x) (PP.fromS.nt I x (PP.DG.tau I x g, PP.DH.tau I x h)) (PP.DGH.tau I x (g, h)) =
   PP.DGH.ob-eq I x (PP.fromS.nt I x (PP.DG.tau I x g, PP.DH.tau I x h)) (PP.DGH.tau I x (g, h)) (\ q l ->
    refl ((PP.DGH.tau I x (g, h)).1 q l)) ;
 } ;
 -- D's total maps of indices do not depend on the context
 tmapEq (G H : TP.TCtx) (I : Ob) (x : Obj I) (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : DO.KJ[J].K.Ch n (C.res J I u x) z)
  : Id (DO.VT.HomD J I u z x) (DO.DC[G].tmap I x n J u z c) (DO.DC[H].tmap I x n J u z c) = refl (DO.DC[G].tmap I x n J u z c) ;
} ;
