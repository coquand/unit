-- CTotL12Fib.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, fibration half, assembled: at each end e the filler of D A
-- is the contraction of D of the strict fibre of ev_e over the lines of
-- (G, A) (lemma12), moved along Psi (CMove.Mv: CTotPsi10, 13, 14, 16);
-- the compositions are fromFill.  The lift back (bk, bkMv) and the
-- levelwise contraction of U of the strict fibre are parameters here.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module L12Fp (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module TR = CTotR[a, vl, l].TotR[C] ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module LIN = G1.GB.CLine[l] ;
 module DA = CobarIT[a, vl, l].DTI[C, G, A] ;
 DG : TR.P1.PCtx = TC.toP CobarI[a, vl, l].DOfI[C].DC[G].DCtx ;

 module End (d : Bool) {
  e : G1.GB.IPt = G1.GB.src d ;
  module P10 = CTotPsi10[a, vl, l].Psi10[C, G, A, e] ;
  module P13 = CTotPsi13[a, vl, l].Psi13[C, G, A, e] ;
  module P14 = CTotPsi14[a, vl, l].Psi14[C, G, A, e] ;
  module P16 = CTotPsi16[a, vl, l].Psi16[C, G, A, e] ;
  module EKd = P13.EKd ;
  module DS = P13.DS ;
  D : TR.P1.PCtx = EKd.TV.E ;
  SF : TR.P1.PTy[D] = EKd.SFm.SF ;
  D0 : TR.P1.PCtx = P14.D0 ;
  module TS = G1.GB.GPre[l].TyL[D, SF] ;
  module TS0 = G1.GB.GPre[l].TyL[D0, DS.DTy] ;
  BkTy : U (l+) = (X : TC.TOb) (x : W0.Ix (D.ob X)) (u : W0.Ix (DS.DTy.tob X (P10.psi X x))) -> W0.Ix (SF.tob X x) ;
  BkMvTy (bk : BkTy) : U (l+) = (X : TC.TOb) (x : W0.Ix (D.ob X)) (u : W0.Ix (DS.DTy.tob X (P10.psi X x)))
   -> Id (TS0.EI X) (P13.mS X (TS.pr X x (bk X x u))) (TS0.pr X (P10.psi X x) u) ;
  module MV (bk : BkTy) (bkMv : BkMvTy bk)
    (al : G0.GB.CPartial[l].ContrOp (TR.RS.rC (TC.toP P13.TVT)) (TR.RS.rT (TC.toP P13.TVT) P13.SF')) {
   k0 : G1.GB.CPartial[l].ContrOp D0 DS.DTy = CTotL12n[a, vl, l].L12n[C, P13.TVT, P13.SF'].lemma12 al ;
   module M = G1.GB.CMove[l, l].Mv[D, SF, SF, G1.GB.CPartial[l].pmap-id D SF,
     D0, DS.DTy, DS.DTy, G1.GB.CPartial[l].pmap-id D0 DS.DTy,
     \ W x -> P10.psi W x, \ Vb W g x -> P10.SN[Vb, W, g, x].law,
     \ W v -> P13.mS W v, \ W v -> refl (P10.psi W (TS.pr1 W v)), \ Vb W g v -> P14.NS[Vb, W, g, v].law,
     \ W v -> P13.mS W v, \ W v -> refl (P10.psi W (TS.pr1 W v)), \ Vb W g v -> P14.NS[Vb, W, g, v].law,
     \ W v v' P Q -> P16.Inj[W, v, v', P, Q].law,
     bk, bkMv, \ W v -> refl (P13.mS W v), k0] ;
   fill : LIN.Lines[DG, DA.DTy].Fill e = M.rc ;
   comp : LIN.Lines[DG, DA.DTy].CompK[G1.GB.src d, G1.GB.tgt d].Comp = LIN.Lines[DG, DA.DTy].CompK[G1.GB.src d, G1.GB.tgt d].fromFill fill ;
  } ;
 } ;
} ;
