-- CDFw6.seg (canonicity-c2; (d)(1), part 6): the equations of u at fwd's
-- point as an element of CSolT's RelProd (iterated Sigma of the IdEv's) over
-- nil.HomT(x.u, y), by recursion on the list of equations.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module Fw6 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F5m = CDFw5[a].Fw5[R, encK, pe, x, u, y] ;
 module F1 = F5m.F1 ;
 module C1 = F5m.C1 ;
 module S2 = F1.S2 ;
 module S1 = F1.S1 ;
 module EV = S1.EV ;
 module Dc = F5m.Dc ;
 open Ring[a] ;
 Nl : C.Ctx = C.nil ;
 m : Nat = F1.m ;
 n : Nat = S1.n ;
 D1 : C.Ctx = F1.D1 ;
 Dv : C.Ctx = S1.Dv ;
 GT : C.Ctx = S2.GT ;
 sg2 : C.Sub D1 Dv = F1.sg2 ;
 s2 : C.Sub D1 GT = F1.s2 ;
 Tm : U a = F5m.Tm ;
 QT : C.Ty GT = EV.Qk (Arith[a].plus m n) ;
 -- one equation, as an element of IdEv p at fwd's point
 PI0 (p : Tm) : Id (C.Ty D1) (C.subT D1 Dv (S2.IdEv p) sg2) (IJ.IdT D1 (C.subT D1 GT QT s2) (C.subt D1 GT QT (EV.evE (Arith[a].plus m n) p) s2) (C.subt D1 GT QT (EV.evE (Arith[a].plus m n) (cst R.z)) s2)) =
  transH (symH (C.subT-o D1 Dv GT (IJ.IdT GT QT (EV.evE (Arith[a].plus m n) p) (EV.evE (Arith[a].plus m n) (cst R.z))) S2.sigma sg2))
   (IJ.IdT-nat D1 GT QT (EV.evE (Arith[a].plus m n) p) (EV.evE (Arith[a].plus m n) (cst R.z)) s2) ;
 eqP (p : Tm) (mm : Dc.Member p u.2) : C.El D1 (C.subT D1 Dv (S2.IdEv p) sg2) =
  OV.trE D1 (IJ.IdT D1 (C.subT D1 GT QT s2) (C.subt D1 GT QT (EV.evE (Arith[a].plus m n) p) s2) (C.subt D1 GT QT (EV.evE (Arith[a].plus m n) (cst R.z)) s2))
   (C.subT D1 Dv (S2.IdEv p) sg2) (symH (PI0 p))
   (CProdSet[a].idBackL D1 (C.subT D1 GT QT s2) C1.QYd C1.PQ2 (C.subt D1 GT QT (EV.evE (Arith[a].plus m n) p) s2) (C.subt D1 GT QT (EV.evE (Arith[a].plus m n) (cst R.z)) s2) (F5m.rel p mm)) ;
} ;
