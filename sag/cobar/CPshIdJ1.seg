-- CPshIdJ1.seg (part 5 of the Id instance, canonicity-45): J and its
-- computation rule for the CwF of fibrant C-types.  J is FibId.jY at each
-- x (the base's J for the record's data, with the start moved to the
-- base's centre by cenEqC); it is C-natural by CPshJNatT.JNatT at the
-- J-data of PosIdYJ (CPshIdJd), the start's C-naturality read through the
-- centres (dEq).  J-beta is FibId.jY-beta at each x, read back along
-- cenEqC (FibId.betaTr).
--   JEl[G, A, a, CM, d].J : CEl[DRC.Dx G A a, CM.1]
--   JEl[..].beta : subCEl J cen = d

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module FBC = FibCwF[a, l] ;
module FIC = FibIdCen[a, l] ;
module FID = FibId[a, l] ;
module PJ = PosJNat[a, l] ;
module PYJ = PosIdYJ[a, l] ;

module IdJ1Of (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 module JB = CPshIdJb[a, l].IdJbOf[C] ;
 module JD = CPshIdJd[a, l].IdJdOf[C] ;
 module JT = CPshJNatT[a, l].JNatTOf[C] ;
 open P ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;
 module DRC = JA.DRC ;
 module DRB = JA.DRB ;
 As (G : CCtx) (A : STy G) (x : CO) : FBC.FC.STy (G.ob x) = JA.As G A x ;

 module JEl (G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (CM : STy (DRC.Dx G A a0))
  (d : CEl[G, (UF.FCC.subS G (DRC.Dx G A a0) CM (DRC.cen G A a0)).1]) {
  Dc : CCtx = DRC.Dx G A a0 ;
  cenC : CSub[G, Dc] = DRC.cen G A a0 ;
  -- the Yoneda J-data at x (its DY is the derived context at x)
  module Y (x : CO) { module J = PYJ.YJ[G.ob x, A.1.ty x, a0.el x] ; } ;
  module TC (x : CO) { module T = GPR.TyL[(DRC.Dx G A a0).ob x, CM.1.ty x] ; } ;
  -- the centre of PosIdYJ, and the record's centre at x is it (through the base's centre)
  cY (x : CO) : PSub[G.ob x, (DRC.Dx G A a0).ob x] = Y[x].J.cY ;
  cenEqY (x : CO) : Id (PSub[G.ob x, (DRC.Dx G A a0).ob x]) (cenC.sb x) (cY x) =
   transH (JB.cenEqC G A a0 x) FIC.Cen[G.ob x, As G A x, a0.el x].cenEq ;
  opaque cenEqY ;
  -- the start, over the centre of PosIdYJ
  dY (x : CO) : PEl[G.ob x, subTy (G.ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) (cY x)] =
   subst (PSub[G.ob x, (DRC.Dx G A a0).ob x]) (\ t -> PEl[G.ob x, subTy (G.ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) t]) (cenC.sb x) (cY x) (cenEqY x) (d.el x) ;
  -- J at x: PosJNat's J for the Yoneda data at the record's context
  module JJx (x : CO) { module J0 = PJ.JJ[G.ob x, (DRC.Dx G A a0).ob x, Y[x].J.yjD, CM.1.ty x, (CM.2.1 x).1, dY x].J0 ; } ;
  jx (x : CO) : PEl[(DRC.Dx G A a0).ob x, CM.1.ty x] = JJx[x].J0.J ;

  -- the start is C-natural, read at the centres of PosIdYJ
  module SCM = LO.SC[G, Dc, cenC, CM.1] ;
  e1 (x : CO) (X : Ob) (x0 : W0.Ix ((G.ob x).ob X))
   : Id (TC[x].T.EI X) (TC[x].T.pr X ((cY x).nt X x0) ((dY x).eob X x0)) (TC[x].T.pr X ((cenC.sb x).nt X x0) ((d.el x).eob X x0)) =
   FID.trS (G.ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) (cenC.sb x) (cY x) (cenEqY x) (d.el x) X x0 ;
  opaque e1 ;
  e3 (y x : CO) (f : CH y x) (X : Ob) (x0 : W0.Ix ((G.ob x).ob X))
   : Id (TC[y].T.EI X) ((CM.1.tE y x f).nt X (TC[x].T.pr X ((cenC.sb x).nt X x0) ((d.el x).eob X x0)))
       (TC[y].T.pr X ((cenC.sb y).nt X ((G.act y x f).nt X x0)) ((d.el y).eob X ((G.act y x f).nt X x0))) =
   transH (symH (SCM.rBtE y x f X (pairE (G.ob x) (SCM.ST x) X x0 ((d.el x).eob X x0)))) (apH (SCM.rB y X) (d.el-nat y x f X x0)) ;
  opaque e3 ;
  dEq (y x : CO) (f : CH y x) (X : Ob) (x0 : W0.Ix ((G.ob x).ob X))
   : Id (TC[y].T.EI X) ((CM.1.tE y x f).nt X (TC[x].T.pr X ((cY x).nt X x0) ((dY x).eob X x0)))
       (TC[y].T.pr X ((cY y).nt X ((G.act y x f).nt X x0)) ((dY y).eob X ((G.act y x f).nt X x0))) =
   transH (apH ((CM.1.tE y x f).nt X) (e1 x X x0)) (transH (e3 y x f X x0) (symH (e1 y X ((G.act y x f).nt X x0)))) ;
  opaque dEq ;

  -- J is C-natural
  jnat (y x : CO) (f : CH y x) (X : Ob) (z : W0.Ix ((Dc.ob x).ob X))
   : Id (SigT (Dc.ob y) (CM.1.ty y) X) ((CM.1.tE y x f).nt X (pairE (Dc.ob x) (CM.1.ty x) X z ((jx x).eob X z)))
       (pairE (Dc.ob y) (CM.1.ty y) X ((Dc.act y x f).nt X z) ((jx y).eob X ((Dc.act y x f).nt X z))) =
   JT.JNatT[G, DRC.Dx G A a0, CM.1, y, x, f, Y[x].J.yjD, Y[y].J.yjD, JD.JDC[G, A, a0, y, x, f].prEq, JD.JDC[G, A, a0, y, x, f].lamEq, JD.JDC[G, A, a0, y, x, f].psiEq,
            (CM.2.1 x).1, (CM.2.1 y).1, CM.2.2.1 y x f, dY x, dY y, dEq y x f].jnat X z ;
  opaque jnat ;
  J : CEl[Dc, CM.1] = new CEl[Dc, CM.1, jx, jnat] ;

  -- the computation rule: PosJNat's beta at the centre of PosIdYJ, read back along cenEqY
  betaY (x : CO) : Id (PEl[G.ob x, subTy (G.ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) (cY x)])
                    (subEl (G.ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) (jx x) (cY x)) (dY x) =
   el-ext (G.ob x) (subTy (G.ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) (cY x)) (subEl (G.ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) (jx x) (cY x)) (dY x)
    (\ X x0 -> JJx[x].J0.beta X x0) ;
  opaque betaY ;
  beta : Id (CEl[G, (UF.FCC.subS G Dc CM cenC).1]) (CW.subCEl G Dc CM.1 J cenC) d =
   EX.cel-ext G (UF.FCC.subS G Dc CM cenC).1 (CW.subCEl G Dc CM.1 J cenC) d
    (\ x X x0 -> apH (\ e -> e.eob X x0)
       (FID.betaTr (G.ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) (cenC.sb x) (cY x) (cenEqY x) (jx x) (d.el x) (betaY x))) ;
  opaque beta ;
 } ;
} ;
