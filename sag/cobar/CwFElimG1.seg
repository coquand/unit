-- CwFElimG1.seg (canonicity-c2; SIMPLIFIED.md item 3, the quotient's
-- eliminator into sets): the family of "values compatible with a
-- predicate", in a CwF with Pi, Sigma, Swan Id, a universe and NF:
--     CF(P) = Sigma (b : B) Pi (a : T) (Dec (P a) -> Id(f a , b))
-- over a context D, with T and P over D.B and f a over D.B.T, and its
-- stability under substitution along lifts (CFN0) and along any paths of
-- B and T (CFN, by J on the paths).
open Base ;

module ElimG1 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module X1 = CwFSetX1.SetX1[l, C, PS, SS, IJ, Un, NF] ;

  module CFof (D : Ctx) (B : Ty D) (T : Ty (ext D B)) (P : El (ext D B) (X1.FunU (ext D B) T))
    (fa : El (ext (ext D B) T) (wkT (ext D B) T (wkT D B B))) {
    DB : Ctx = ext D B ;
    E : Ctx = ext DB T ;
    TP : Ty E = X1.RelOf[DB, T, P, P].TP ;
    BE : Ty E = wkT DB T (wkT D B B) ;
    bE : El E BE = wkE DB T (wkT D B B) (q D B) ;
    Y : Ty E = IJ.IdT E BE fa bE ;
    F : Ty E = Fun E TP Y ;
    H : Ty DB = PS.Pi DB T F ;
    CF : Ty D = SS.Sig D B H ;
  } ;

  -- stability along a lift
  module CFN0 (D' D : Ctx) (s : Sub D' D) (B : Ty D) (T : Ty (ext D B)) (P : El (ext D B) (X1.FunU (ext D B) T))
    (fa : El (ext (ext D B) T) (wkT (ext D B) T (wkT D B B)))
    (P' : El (ext D' (subT D' D B s)) (X1.FunU (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s))))
    (oP : Ov (ext D' (subT D' D B s)) (ext D B) (X1.FunU (ext D B) T) (lift D' D B s)
            (X1.FunU (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s)))
            (X1.PF (ext D' (subT D' D B s)) (ext D B) (lift D' D B s) T (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s)) (refl (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s))))
            P P')
    (fa' : El (ext (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s)))
              (wkT (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s)) (wkT D' (subT D' D B s) (subT D' D B s))))
    (PBE : Id (Ty (ext (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s))))
              (subT (ext (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s))) (ext (ext D B) T)
                 (wkT (ext D B) T (wkT D B B)) (lift (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s)))
              (wkT (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s)) (wkT D' (subT D' D B s) (subT D' D B s))))
    (ofa : Ov (ext (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s))) (ext (ext D B) T)
             (wkT (ext D B) T (wkT D B B)) (lift (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s))
             (wkT (ext D' (subT D' D B s)) (subT (ext D' (subT D' D B s)) (ext D B) T (lift D' D B s)) (wkT D' (subT D' D B s) (subT D' D B s)))
             PBE fa fa') {
    Bs : Ty D' = subT D' D B s ;
    u1 : Sub (ext D' Bs) (ext D B) = lift D' D B s ;
    Ts : Ty (ext D' Bs) = subT (ext D' Bs) (ext D B) T u1 ;
    u2 : Sub (ext (ext D' Bs) Ts) (ext (ext D B) T) = lift (ext D' Bs) (ext D B) T u1 ;
    module K = CFof[D, B, T, P, fa] ;
    module K' = CFof[D', Bs, Ts, P', fa'] ;
    E' : Ctx = ext (ext D' Bs) Ts ;
    TPo : Id (Ty E') (subT E' K.E K.TP u2) K'.TP = X1.N0[ext D' Bs, ext D B, u1, T, P, P, P', P', oP, oP].TPo ;
    -- b weakened: over u2 it is b weakened
    PB1 : Id (Ty (ext D' Bs)) (subT (ext D' Bs) (ext D B) (wkT D B B) u1) (wkT D' Bs Bs) = wkT-ov D' D B B s Bs (refl Bs) Bs (refl Bs) ;
    ob1 : Ov (ext D' Bs) (ext D B) (wkT D B B) u1 (wkT D' Bs Bs) PB1 (q D B) (q D' Bs) = q-ov D' D B s Bs (refl Bs) PB1 ;
    obE : Ov E' K.E K.BE u2 K'.BE PBE K.bE K'.bE =
      wkE-ov (ext D' Bs) (ext D B) T (wkT D B B) (q D B) u1 Ts (refl Ts) (wkT D' Bs Bs) PB1 (q D' Bs) ob1 PBE ;
    Yo : Id (Ty E') (subT E' K.E K.Y u2) K'.Y = Id-ov E' K.E K.BE fa K.bE u2 K'.BE PBE fa' K'.bE ofa obE ;
    Fo : Id (Ty E') (subT E' K.E K.F u2) K'.F = Fun-ov E' K.E K.TP K.Y u2 K'.TP TPo K'.Y Yo ;
    Ho : Id (Ty (ext D' Bs)) (subT (ext D' Bs) K.DB K.H u1) K'.H = Pi-ov (ext D' Bs) K.DB T K.F u1 Ts (refl Ts) K'.F Fo ;
    law : Id (Ty D') (subT D' D K.CF s) K'.CF = Sig-ov D' D B K.H s Bs (refl Bs) K'.H Ho ;
  } ;

  -- Dec of a proposition, along any substitution
  decN (E' E : Ctx) (u : Sub E' E) (m : El E (PU.PropU E)) (m' : El E' (PU.PropU E'))
    (o : Ov E' E (PU.PropU E) u (PU.PropU E') (PU.PropU-ov E' E u) m m')
    : Id (Ty E') (subT E' E (PU.DecP E m) u) (PU.DecP E' m') =
    trans (Ty E') (subT E' E (PU.DecP E m) u) (Un.Dec E' (PU.UU.DU.subU E' E (PU.codeOf E m) u)) (PU.DecP E' m')
      (Un.Dec-nat E' E (PU.codeOf E m) u)
      (ap (El E' (Un.Cod E')) (Ty E') (\ c2 -> Un.Dec E' c2) (PU.UU.DU.subU E' E (PU.codeOf E m) u) (PU.codeOf E' m')
         (IN.fst-ov E' E (Un.Cod E) (PU.PropFam E) u (Un.Cod E') (Un.Cod-nat E' E u) (PU.PropFam E') (PU.PropFam-ov E' E u) (PU.PropU-ov E' E u)
            m m' o)) ;
  -- the inner Fun (Dec -> Id), along any substitution
  FN (E' E : Ctx) (u : Sub E' E) (TP : Ty E) (TP' : Ty E') (PTP : Id (Ty E') (subT E' E TP u) TP')
    (BE : Ty E) (BE' : Ty E') (PBE : Id (Ty E') (subT E' E BE u) BE')
    (fa bE : El E BE) (fa' bE' : El E' BE') (ofa : Ov E' E BE u BE' PBE fa fa') (obE : Ov E' E BE u BE' PBE bE bE')
    : Id (Ty E') (subT E' E (Fun E TP (IJ.IdT E BE fa bE)) u) (Fun E' TP' (IJ.IdT E' BE' fa' bE')) =
    Fun-ov E' E TP (IJ.IdT E BE fa bE) u TP' PTP (IJ.IdT E' BE' fa' bE') (Id-ov E' E BE fa bE u BE' PBE fa' bE' ofa obE) ;
} ;
