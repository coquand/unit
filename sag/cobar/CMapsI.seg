-- CMapsI.seg (canonicity-45; SIMPLIFIED.md step 6): the structure maps of
-- the generic algebra and p_u as morphisms of C at every stage:
--   I1, I2, AddF, MulF : F1 -> F2 (the generator to x1, x2, x1 + x2, x1 x2;
--   in C, maps A_F1 -> A_F2), Pu x u : A_x -> A_{x.u}
-- each a CMapsC.Inst.MapOf at a CFreeMaps closed map (the substituted
-- term commutes with the term formers by definition).
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;


module InstI (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (elim1 : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Ty)
 (elim1-beta : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].Elim1Beta (elim1 x))
 (setQ : (x : SX.Over[R].Presentation) -> CFreeMaps[a].ElimTy[R, encK, x, pe].SetQ)
 (elim2 : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Ty)
 (elim2-beta : (x : SX.Over[R].Presentation) -> CAlgX[a].AlgX[R, encK, x, pe].Elim2Beta (elim2 x))
 (elimP1 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP1Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (elimP3 : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].ElimP3Ty CAlgX[a].AlgX[R, encK, x, pe].Term CAlgX[a].AlgX[R, encK, x, pe].cls)
 (setQi : (x : SX.Over[R].Presentation) -> CQCtx[a].G3Of[CAlgX[a].AlgX[R, encK, x, pe].Qt].SetQiTy) {
 module IN0 = CMapsC[a].Inst[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi] ;
 module IN = CMapsC2[a].Inst2[R, encK, pe, elim1, elim1-beta, setQ, elim2, elim2-beta, elimP1, elimP3, setQi] ;
 module MF = IN0.MF ;
 module FR = MF.FR ;
 module SubC (s t : SX.Over[R].Presentation) (sg : SX.Fin s.1 -> SX.Over[R].Der[t].Term)
  (eqP : (p : SX.Over[R].Der[s].Term) -> SX.Over[R].Der[s].Member p s.2
     -> SX.Over[R].Der[t].Proof (CSubst[a].SE[R].subE (SX.Fin s.1) (SX.Fin t.1) sg p) SX.Over[R].Der[t].zeroE) {
  module SM = MF.Sub[s, t, sg, eqP] ;
  module M = IN.MapOf[s, t, SM.Phi, SM.SB.sbT, SM.beta, \ u v -> refl (SM.SB.sbT (sumE u v)), \ u v -> refl (SM.SB.sbT (mulE u v)), \ c -> refl (cst c)] ;
 } ;
 module I1 = SubC[FR.F1, FR.F2, FR.I1.sg, \ p m -> FR.noEq p m _] ;
 module I2 = SubC[FR.F1, FR.F2, FR.I2.sg, \ p m -> FR.noEq p m _] ;
 module AddF = SubC[FR.F1, FR.F2, FR.AddF.sg, \ p m -> FR.noEq p m _] ;
 module MulF = SubC[FR.F1, FR.F2, FR.MulF.sg, \ p m -> FR.noEq p m _] ;
 module PuC (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) {
  module PM = MF.Pu[x, u] ;
  module M = IN.MapOf[x, SX.Rel[R].concat x u, PM.Phi, PM.RN.rn, PM.beta, \ s1 s2 -> refl (PM.RN.rn (sumE s1 s2)), \ s1 s2 -> refl (PM.RN.rn (mulE s1 s2)), \ c -> refl (cst c)] ;
 } ;
} ;
