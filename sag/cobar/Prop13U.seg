-- Prop13U.seg (canonicity-45; jonas.pdf Proposition 13, internal form):
-- the equivalence structures of D f at the objects x of C are uniform in
-- C, i.e. the output of Prop 13 is an element of is-equiv(D f) in PSh(C).
--   DfC      D f as a CMap over D G (its naturality in C: the value at
--            a reindexed chain is the value at the chain, DM.pc both ways)
--   HPD      the homotopy fibres of D f as a C-type over E_(D B)
--   PU       Psi commutes with the C-action: sPC (on points, refl), mSC
--            (on fibre elements, by HPD.rb for the A part)
--   PU2.res  the Lemma12F.UFl argument: the moved extension is the
--            extension of the moved side, by mTinj, kopMv, lemma12U's
--            uniformity (UT.2), kop-cong along the side equality R
--   prop13U  the CUnif field of P.Unif for prop13
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;

-- D f as a CMap over D G, for any map f of C-types (no fibrancy
-- hypotheses; the naturality in C: the value at a reindexed chain is the
-- value at the chain, DM.pc both ways)
module DfOf (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A B : CPshC[a, l].CPsh[C].CTy[G])
 (f : Prop13[a, l].P13Of[C].CMap[G, A, B]) {
 module P = CPshC[a, l].CPsh[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module DFf = P13.DF[G, A, B, f] ;
 module D = DFf.D ;
 module DA = DFf.DA ;
 module DB = DFf.DB ;
 open P ;

 module DfN (y x : CO) (h : CH y x) (X : Ob) (w : SigT (D.obD x) (DA.DTy x) X) {
  d : D.Ob' x X = fstE (D.obD x) (DA.DTy x) X w ;
  av : DA.TOb' x X d = sndE (D.obD x) (DA.DTy x) X w ;
  module Mx = DFf.DM[x, X, d, av] ;
  module My = DFf.DM[y, X, D.CA[y, x, h, X, d].res, DA.CT[y, x, h, X, d, av].res] ;
  nat : Id (SigT (D.obD y) (DB.DTy y) X) ((DB.tEC y x h).nt X (DFf.mE x X w)) (DFf.mE y X ((DA.tEC y x h).nt X w)) =
   DB.totD-eq y X ((DB.tEC y x h).nt X (DFf.mE x X w)) (DFf.mE y X ((DA.tEC y x h).nt X w)) (refl (D.CA[y, x, h, X, d].res))
    (\ q l -> transH (Mx.pc (D.CA[y, x, h, X, d].rq q) l) (symH (My.pc q l))) ;
 } ;

 DfC : P13.CMap[D.DCtx, DA.DCTy, DB.DCTy] = new P13.CMap[D.DCtx, DA.DCTy, DB.DCTy, DFf.Df, \ y x h X w -> DfN[y, x, h, X, w].nat] ;
} ;

module P13U (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A B : CPshC[a, l].CPsh[C].CTy[G])
 (f : Prop13[a, l].P13Of[C].CMap[G, A, B]) (fA : CPshC[a, l].CPsh[C].LFib G A) (fB : CPshC[a, l].CPsh[C].LFib G B)
 (ef : (x : SmallCat[a].Objs[C.obV].Ob) -> PB.CEquiv[l].EquivOp (G.ob x) (A.ty x) (B.ty x) (f.mp x)) {
 module P = CPshC[a, l].CPsh[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module DFf = P13.DF[G, A, B, f] ;
 module D = DFf.D ;
 module DA = DFf.DA ;
 module DB = DFf.DB ;
 module HPf = P13.HP[G, A, B, f] ;
 module DGB = DD.DC[HPf.GB] ;
 module DPC = DD.DT[HPf.GB, HPf.PC] ;
 module PM = P13.Main[G, A, B, f, fA, fB, ef] ;
 open P ;

 -- D f as a CMap over D G (DfOf, for any f)
 DfC : P13.CMap[D.DCtx, DA.DCTy, DB.DCTy] = DfOf[C, G, A, B, f].DfC ;

 -- the homotopy fibres of D f, as a C-type over E_(D B)
 module HPD = P13.HP[D.DCtx, DA.DCTy, DB.DCTy, DfC] ;

 ------------------------------------------------------------------
 -- Psi commutes with the C-action

 module PU (y x : CO) (gC : CH y x) {
  module Sx = P13.PSI[G, A, B, f, x] ;
  module Sy = P13.PSI[G, A, B, f, y] ;

  sPC (X : Ob) (w : Sx.Hd.TA.EI X) : Id (DGB.Ob' y X) (Sy.sP X ((DB.tEC y x gC).nt X w)) (DGB.CA[y, x, gC, X, Sx.sP X w].res) =
   DGB.ob-eq y X (Sy.sP X ((DB.tEC y x gC).nt X w)) (DGB.CA[y, x, gC, X, Sx.sP X w].res) (\ q l -> refl ((Sx.sP X w).1 (DGB.CA[y, x, gC, X, Sx.sP X w].rq q) l)) ;

  mSC (X : Ob) (v : Sx.Hd.TF.EI X)
   : Id (DPC.TotD y X) (Sy.mS X (HPD.res y x gC X v)) ((DPC.tEC y x gC).nt X (Sx.mS X v)) =
   DPC.totD-eq y X (Sy.mS X (HPD.res y x gC X v)) ((DPC.tEC y x gC).nt X (Sx.mS X v)) (sPC X (Sx.Hd.TF.pr1 X v)) (\ q l ->
    CE.HFib[G.ob q.2.1, A.ty q.2.1, B.ty q.2.1, f.mp q.2.1].fibE-eq q.2.2.2.1
     (DPC.prz q.2.1 q.2.2.2.1 ((Sy.sP X (Sy.Hd.TF.pr1 X (HPD.res y x gC X v))).1 q l) (Sy.PF[X, HPD.res y x gC X v].psi.1 q l))
     (DPC.prz q.2.1 q.2.2.2.1 ((DGB.CA[y, x, gC, X, Sx.sP X (Sx.Hd.TF.pr1 X v)].res).1 q l) (DPC.CT[y, x, gC, X, Sx.sP X (Sx.Hd.TF.pr1 X v), Sx.PF[X, v].psi].res.1 q l))
     (refl (Sy.PF[X, HPD.res y x gC X v].PQ[q, l].wq))
     (apH (\ T -> DA.prz q.2.1 q.2.2.2.1 (T.1.1 q l) (T.2.1 q l)) (HPD.rb y x gC X v))
     (\ W' f' i' -> refl (Sy.PF[X, HPD.res y x gC X v].Lx.val q l W' f' i'))) ;
 } ;

 ------------------------------------------------------------------
 -- the extension of a moved side is the moved extension

 module PU2 (y x : CO) (gC : CH y x) (X : Ob) (w : P13.PSI[G, A, B, f, x].Hd.TA.EI X)
  (s : CP.Partials[P13.PSI[G, A, B, f, x].Hd.EA, P13.PSI[G, A, B, f, x].Hd.FibT].Side[X, w]) {
  module Uc = PU[y, x, gC] ;
  module Sx = Uc.Sx ;
  module Sy = Uc.Sy ;
  module Mx = PM.MV[x].Mv ;
  module My = PM.MV[y].Mv ;
  w' : Sy.Hd.TA.EI X = (DB.tEC y x gC).nt X w ;
  sm : CP.Partials[Sy.Hd.EA, Sy.Hd.FibT].Side[X, w'] = MapSide[HPD.GB, HPD.PC, y, x, gC].mapside X w s ;

  -- the moved sides agree
  R : Id (CP.Partials[DGB.obD y, DPC.DTy y].Side[X, Sy.sP X w'])
        (subst (W0.Ix ((DGB.obD y).ob X)) (\ z -> CP.Partials[DGB.obD y, DPC.DTy y].Side[X, z])
           (DGB.CA[y, x, gC, X, Sx.sP X w].res) (Sy.sP X w') (symH (Uc.sPC X w))
           (MapSide[DGB.DCtx, DPC.DCTy, y, x, gC].mapside X (Sx.sP X w) (Mx.mside X w s)))
        (My.mside X w' sm) =
   CP.Partials[DGB.obD y, DPC.DTy y].side-extH X (DGB.CA[y, x, gC, X, Sx.sP X w].res) (Sy.sP X w') (symH (Uc.sPC X w))
    (MapSide[DGB.DCtx, DPC.DCTy, y, x, gC].mapside X (Sx.sP X w) (Mx.mside X w s))
    (My.mside X w' sm)
    (refl s.pQ)
    (\ W h i i' -> transH (apH (\ v -> (DPC.tEC y x gC).nt W (Sx.mS W v))
                           (CP.Partials[Sx.Hd.EA, Sx.Hd.FibT].pv-irr X w s W h i i'))
                   (symH (Uc.mSC W (s.pv W h i')))) ;

  res : Id (SigT Sy.Hd.EA Sy.Hd.FibT X)
          ((HPD.PC.tE y x gC).nt X (pairE Sx.Hd.EA Sx.Hd.FibT X w (Mx.kop X w s)))
          (pairE Sy.Hd.EA Sy.Hd.FibT X w' (My.kop X w' sm)) =
   Sy.mTinj X ((HPD.PC.tE y x gC).nt X (pairE Sx.Hd.EA Sx.Hd.FibT X w (Mx.kop X w s))) (pairE Sy.Hd.EA Sy.Hd.FibT X w' (My.kop X w' sm)) (refl w')
    (transH (Uc.mSC X (pairE Sx.Hd.EA Sx.Hd.FibT X w (Mx.kop X w s)))
      (transH (apH ((DPC.tEC y x gC).nt X) (Mx.kopMv X w s))
        (transH (PM.UT.2 y x gC X (Sx.sP X w) (Mx.mside X w s))
          (transH (CP.Rel[DGB.obD y, DPC.DTy y, DPC.DTy y, CP.pmap-id (DGB.obD y) (DPC.DTy y)].kop-cong
                     (PM.UT.1 y) X (DGB.CA[y, x, gC, X, Sx.sP X w].res) (Sy.sP X w') (symH (Uc.sPC X w))
                     (MapSide[DGB.DCtx, DPC.DCTy, y, x, gC].mapside X (Sx.sP X w) (Mx.mside X w s))
                     (My.mside X w' sm) R)
            (symH (My.kopMv X w' sm)))))) ;
 } ;

 -- PROP 13 (internal form): the equivalence structures of D f are uniform in C
 prop13U : Unif[HPD.GB, HPD.PC, HPD.PC, \ x -> CP.pmap-id (HPD.GB.ob x) (HPD.PC.ty x), PM.prop13].CUnif =
  \ y x gC X w s -> PU2[y, x, gC, X, w, s].res ;
} ;
