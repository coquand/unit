-- CCmpU30.seg (canonicity-c2; (K) for cmpI, part 30): (U): over nil.H, the
-- two homs are equal (their maps are, and the data form a proposition).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module U30 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module U29m = CCmpU29[a].U29[R, encK, pe, y] ;
 module U20m = CCmpU20[a].U20[R, encK, pe, y] ;
 module HZ = U20m.HZ ;
 module HSt = CHomSet[a].HomSet[R, encK, pe, U20m.U13m.U9m.PO.CM.F2, y] ;
 Nl : C.Ctx = C.nil ;
 H : C.Ty Nl = U20m.H ;
 GH : C.Ctx = U20m.GH ;
 HS : C.Ty Nl = U20m.HS ;
 MapT : C.Ty Nl = HZ.MapT ;
 MTh : C.Ty GH = U29m.MTh ;
 HSh : C.Ty GH = OV.wkT Nl H HS ;
 zA : C.El GH HSh = L.mkPEl GH HSh.1 U20m.pkA (\ J I f w w' e ->
  idJ (V1.Ix (GH.ob J)) (GH.act J I f w) (\ w2 e2 -> Id (V1.Ix (HSh.1.tob J w2)) (HSh.1.tact J I f w w2 e2 (U20m.pkA I w)) (U20m.pkA J w2))
   (transH (L.tact-irr Nl HS.1 J I f w.1 w.1 (L.ntEq GH Nl (L.pP Nl H.1) J I f w (GH.act J I f w) (refl (GH.act J I f w))) (refl w.1) (U20m.pkA I w)) (U20m.pkAN J I f w)) w' e) ;
 zB : C.El GH HSh = L.mkPEl GH HSh.1 U20m.pkB (\ J I f w w' e ->
  idJ (V1.Ix (GH.ob J)) (GH.act J I f w) (\ w2 e2 -> Id (V1.Ix (HSh.1.tob J w2)) (HSh.1.tact J I f w w2 e2 (U20m.pkB I w)) (U20m.pkB J w2))
   (transH (L.tact-irr Nl HS.1 J I f w.1 w.1 (L.ntEq GH Nl (L.pP Nl H.1) J I f w (GH.act J I f w) (refl (GH.act J I f w))) (refl w.1) (U20m.pkB I w)) (U20m.pkBN J I f w)) w' e) ;
 -- HS weakened, as a Sigma over GH
 Gh : C.Ctx = HZ.Gh ;
 X : C.Ty GH = C.subT GH Nl MapT (C.p Nl H) ;
 K : C.Ctx = C.ext GH X ;
 lf : C.Sub K Gh = C.lift GH Nl MapT (C.p Nl H) ;
 Y : C.Ty K = C.subT K Gh HZ.DataT lf ;
 SZ : C.Ty GH = SS.Sig GH X Y ;
 PS : Id (C.Ty GH) HSh SZ = FibCwF[a, a+].fibSig.Sig-nat GH Nl MapT HZ.DataT (C.p Nl H) ;
 pY : C.El K (PU.isProp K Y) =
  OV.trE K (C.subT K Gh (PU.isProp Gh HZ.DataT) lf) (PU.isProp K Y) (PU.isProp-ov K Gh HZ.DataT lf Y (refl Y))
   (C.subt K Gh (PU.isProp Gh HZ.DataT) HSt.pData lf) ;
 module PPr = CwFPropPair.PropPair[a++, C, FibCwF[a, a+].fibPi, SS, IJ, FibUniv[a].fibUniv].At[GH, X, Y] ;
 sA : C.El GH SZ = OV.trE GH HSh SZ PS zA ;
 sB : C.El GH SZ = OV.trE GH HSh SZ PS zB ;
 module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
 sRd (z : C.El GH HSh) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (SZ.1.tob K w)) ((OV.trE GH HSh SZ PS z).eob K w) (z.eob K w) =
  transH (CAppRd[a].trE-rd GH HSh SZ PS z K w) (CAppRd[a].same-rd GH HSh SZ PS K w (refl (HSh.1.tob K w)) (z.eob K w)) ;
 fR (s : C.El GH SZ) (K : Ob) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (X.1.tob K w)) ((INm.fst GH X Y s).eob K w) (s.eob K w).1 =
  refl ((INm.fst GH X Y s).eob K w) ;
 eF : C.El GH (IJ.IdT GH X (INm.fst GH X Y sA) (INm.fst GH X Y sB)) =
  CCmpU14[a].rwId GH X U29m.eA (INm.fst GH X Y sA) U29m.eB (INm.fst GH X Y sB)
   (\ K w -> symH (transH (fR sA K w) (apH {V1.Ix (SZ.1.tob K w)} {V1.Ix (X.1.tob K w)} (\ v -> v.1) (sRd zA K w))))
   (\ K w -> symH (transH (fR sB K w) (apH {V1.Ix (SZ.1.tob K w)} {V1.Ix (X.1.tob K w)} (\ v -> v.1) (sRd zB K w))))
   U29m.res ;
 sAB : C.El GH (IJ.IdT GH SZ sA sB) = PPr.pairPath pY sA sB eF ;
 -- back to HS weakened
 bk (z : C.El GH HSh) : Id (C.El GH HSh) (OV.trE GH SZ HSh (symH PS) (OV.trE GH HSh SZ PS z)) z =
  idJ (C.Ty GH) HSh (\ Z2 P2 -> Id (C.El GH HSh) (OV.trE GH Z2 HSh (symH P2) (OV.trE GH HSh Z2 P2 z)) z) (refl z) SZ PS ;
 u1 : C.El GH (IJ.IdT GH HSh (OV.trE GH SZ HSh (symH PS) sA) (OV.trE GH SZ HSh (symH PS) sB)) =
  CCmpU16[a].U16[R, encK, pe, y].idFwd GH SZ HSh (symH PS) sA sB sAB ;
 res : C.El GH (IJ.IdT GH HSh zA zB) =
  subst (C.El GH HSh) (\ x -> C.El GH (IJ.IdT GH HSh zA x)) (OV.trE GH SZ HSh (symH PS) sB) zB (bk zB)
   (subst (C.El GH HSh) (\ x -> C.El GH (IJ.IdT GH HSh x (OV.trE GH SZ HSh (symH PS) sB))) (OV.trE GH SZ HSh (symH PS) sA) zA (bk zA) u1) ;
} ;
