-- CPshMapSub.seg (canonicity-45; COBAR.md "Plan: Theorem 29", M4): a map
-- of C-types (Prop13's CMap) pulled back along a C-substitution t : De -> G.
-- At x it is the base's CSub.SubMap (the map on the substituted totals,
-- read in the totals of G it is f); natural in C because readings of
-- substituted totals move by the action of the base type (CPshL.SC.rBtE)
-- and f is natural.
--   subCMap De G t A B f : CMap[De, A[t], B[t]]
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;

module MapSubOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 open P ;

 module MS (De G : CCtx) (t : CSub[De, G]) (A B : CTy[G]) (f : P13.CMap[G, A, B]) {
  module SCA = LO.SC[De, G, t, A] ;
  module SCB = LO.SC[De, G, t, B] ;
  A' : CTy[De] = LO.subCTy De G t A ;
  B' : CTy[De] = LO.subCTy De G t B ;
  module SMx (x : CO) { module M = PB.CSub[l].SubMap[De.ob x, G.ob x, t.sb x, A.ty x, B.ty x, f.mp x] ; } ;
  mp (x : CO) : CP.PMap[De.ob x, A'.ty x, B'.ty x] = SMx[x].M.subMap ;
  -- natural in C: by the point and the reading in the totals of B
  nat (y x : CO) (h : CH y x) (X : Ob) (w : SigT (De.ob x) (A'.ty x) X)
   : Id (SigT (De.ob y) (B'.ty y) X) ((B'.tE y x h).nt X ((mp x).mE X w)) ((mp y).mE X ((A'.tE y x h).nt X w)) =
   SCB.sub-eq y X ((B'.tE y x h).nt X ((mp x).mE X w)) ((mp y).mE X ((A'.tE y x h).nt X w))
    (refl ((De.act y x h).nt X (fstE (De.ob x) (A'.ty x) X w)))
    (transH (SCB.rBtE y x h X ((mp x).mE X w))
     (transH (apH ((B.tE y x h).nt X) (SMx[x].M.mE-V X w))
      (transH (f.mp-nat y x h X (SCA.rB x X w))
       (transH (apH ((f.mp y).mE X) (symH (SCA.rBtE y x h X w)))
        (symH (SMx[y].M.mE-V X (SCA.tEs y x h X w))))))) ;
  opaque nat ;
  res : P13.CMap[De, A', B'] = new P13.CMap[De, A', B', mp, nat] ;
  -- the reading lemma: the map on substituted totals, read in the totals of B, is f of the reading
  rd (x : CO) (X : Ob) (w : SigT (De.ob x) (A'.ty x) X)
   : Id (SigT (G.ob x) (B.ty x) X) (SCB.rB x X ((mp x).mE X w)) ((f.mp x).mE X (SCA.rB x X w)) = SMx[x].M.mE-V X w ;
 } ;

 subCMap (De G : CCtx) (t : CSub[De, G]) (A B : CTy[G]) (f : P13.CMap[G, A, B])
  : P13.CMap[De, LO.subCTy De G t A, LO.subCTy De G t B] = MS[De, G, t, A, B, f].res ;
} ;
