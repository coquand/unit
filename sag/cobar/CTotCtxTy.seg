-- CTotCtxTy.seg (canonicity-c2; SIMPLIFIED.md, item (C) for canonicity-45):
-- contexts as types over the terminal context at the total site, part 1.
--   T1        the terminal context (ofP nilP)
--   Y1T       a context Y read as a type over T1 (same fibres, same action)
--   i / j     toP Y -> T1.Y1T and back, both composites pointwise identity
--   fwS / bkS D 1 . D Y1T -> D Y (CTotPsi11's pairing, then D of the
--             projection) and back (the trivial point of D 1, the same
--             values); fb, bf: both composites pointwise identity
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module CtxTy (C : CIntCat[a, vl].IC) {
 module TC = CTotCat[a, vl, l].TotOf[C] ;
 module P = Presheaf[vl, l].Psh[TC.TotCat] ;
 module TP = CTPsh[a, vl, l].TPshOf[C] ;
 T1 : TP.TCtx = TC.ofP P.nilP ;
 P1 : P.PCtx = TC.toP T1 ;
 module Of (Y : TP.TCtx) {
  GP : P.PCtx = TC.toP Y ;
  Y1T : P.PTy[P1] = P.mkTy P1 (\ X u -> GP.ob X) (\ Z X f u v e b -> GP.act Z X f b) (\ X u e b -> GP.act-id X b)
    (\ K J I f g x y z e1 e2 e3 b -> GP.act-o K J I f g b) ;
  EY : P.PCtx = P.extP P1 Y1T ;
  i : P.PSub[GP, EY] = new P.PSub[GP, EY, \ X g -> (tt, g), \ Z X f g -> refl (tt, GP.act Z X f g)] ;
  j : P.PSub[EY, GP] = new P.PSub[EY, GP, \ X w -> w.2, \ Z X f w -> refl (GP.act Z X f w.2)] ;
  ji (X : TC.TOb) (g : W0.Ix (GP.ob X)) : Id (W0.Ix (GP.ob X)) (j.nt X (i.nt X g)) g = refl g ;
  ij (X : TC.TOb) (w : W0.Ix (EY.ob X)) : Id (W0.Ix (EY.ob X)) (i.nt X (j.nt X w)) w =
   apH {Top} {W0.Ix (EY.ob X)} (\ u -> (u, w.2)) (isTop tt w.1) ;
  -- the D side
  module DO = CobarI[a, vl, l].DOfI[C] ;
  module D1 = DO.DC[T1] ;
  module DY = DO.DC[Y] ;
  module DA = CobarIT[a, vl, l].DTI[C, T1, Y1T] ;
  -- the trivial point of D 1
  d1 (I : Ob) (x : DO.Obj I) : D1.Ob' I x =
   (\ q lq -> tt, \ r lq -> isTop _ _, \ r lq -> isTop _ _, \ r lq -> isTop _ _) ;
  -- from D Y to D 1 . D Y1T: the same values
  module Bk (I : Ob) (x : DO.Obj I) (w : DY.Ob' I x) {
   av : DA.TA I x (d1 I x) = \ q lq -> w.1 q lq ;
   nat' : W0.Ix (DA.anatEq I x (d1 I x) av) = \ r lq ->
    apH {W0.Ix (GP.ob (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1))} {DA.Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
      (\ b -> DA.prz r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) tt b) (w.2.1 r lq) ;
   face' : W0.Ix (DA.afaceEq I x (d1 I x) av) = \ r lq ->
    apH {W0.Ix (GP.ob (r.2.2.2.1, r.2.2.2.2.2.1))} {DA.Ez r.2.2.2.1 r.2.2.2.2.2.1}
      (\ b -> DA.prz r.2.2.2.1 r.2.2.2.2.2.1 tt b) (w.2.2.1 r lq) ;
   top' : W0.Ix (DA.atopEq I x (d1 I x) av) = \ r lq ->
    apH {W0.Ix (GP.ob (r.2.1, r.2.2.2.1))} {DA.Ez r.2.1 r.2.2.2.1}
      (\ b -> DA.prz r.2.1 r.2.2.2.1 tt b) (w.2.2.2 r lq) ;
   res : DA.TOb' I x (d1 I x) = (av, nat', face', top') ;
  } ;
  -- from D 1 . D Y1T to D Y: CTotPsi11's pairing, then D of the projection
  module PS = CTotPsi11[a, vl, l].Psi11[C, T1, CTotR[a, vl, l].TotR[C].G1.GB.src true] ;
  module PR = PS.Pair[Y1T] ;
  js : TP.TSub[PR.ET, Y] = new TP.TSub[PR.ET, Y, \ I x w -> w.2, \ J I u y x f d -> refl (Y.act J I u y x f d.2)] ;
  module DSj = DO.DS[PR.ET, Y, js] ;
  fw (W : TC.TOb) (t : W0.Ix (PR.Ext.ob W)) : DY.Ob' W.1 W.2 = DSj.dmap W.1 W.2 (PR.phi W t) ;
  bk (I : Ob) (x : DO.Obj I) (w : DY.Ob' I x) : W0.Ix (PR.Ext.ob (I, x)) = (d1 I x, Bk[I, x, w].res) ;
  -- fw after bk is the identity
  fb (I : Ob) (x : DO.Obj I) (w : DY.Ob' I x) : Id (DY.Ob' I x) (fw (I, x) (bk I x w)) w =
   DY.ob-eq I x (fw (I, x) (bk I x w)) w (\ q lq -> refl (w.1 q lq)) ;
  -- bk after fw is the identity: first components by isTop, second pointwise
  bfGen (I : Ob) (x : DO.Obj I) (b : DA.TOb' I x (d1 I x)) (d' : D1.Ob' I x) (p : Id (D1.Ob' I x) (d1 I x) d') (a' : DA.TOb' I x d')
    (H : (q : DO.Idx I x) (lq : DO.LandsI I x q) -> Id (W0.Ix (GP.ob (q.2.1, q.2.2.2.1))) (b.1 q lq) (a'.1 q lq))
    : Id (W0.Ix (PR.Ext.ob (I, x))) (d1 I x, b) (d', a') =
   idJ (D1.Ob' I x) (d1 I x)
     (\ d2 p2 -> (a2 : DA.TOb' I x d2) -> ((q : DO.Idx I x) (lq : DO.LandsI I x q) -> Id (W0.Ix (GP.ob (q.2.1, q.2.2.2.1))) (b.1 q lq) (a2.1 q lq))
        -> Id (W0.Ix (PR.Ext.ob (I, x))) (d1 I x, b) (d2, a2))
     (\ a2 H2 -> apH {DA.TOb' I x (d1 I x)} {W0.Ix (PR.Ext.ob (I, x))} (\ c -> (d1 I x, c)) (DA.tob-eq I x (d1 I x) b a2 H2))
     d' p a' H ;
  bf (W : TC.TOb) (t : W0.Ix (PR.Ext.ob W)) : Id (W0.Ix (PR.Ext.ob W)) (bk W.1 W.2 (fw W t)) t =
   bfGen W.1 W.2 (Bk[W.1, W.2, fw W t].res) t.1 (D1.ob-eq W.1 W.2 (d1 W.1 W.2) t.1 (\ q lq -> isTop tt (t.1.1 q lq))) t.2
     (\ q lq -> refl (t.2.1 q lq)) ;
  -- naturality, and the two maps of presheaves
  DYP : P.PCtx = TC.toP DY.DCtx ;
  fwN (V W : TC.TOb) (g : TC.THm V W) (t : W0.Ix (PR.Ext.ob W)) : Id (DY.Ob' V.1 V.2) (fw V (PR.Ext.act V W g t)) (DYP.act V W g (fw W t)) =
   transH (apH {PR.DE.Ob' V.1 V.2} {DY.Ob' V.1 V.2} (DSj.dmap V.1 V.2) (PR.phiN V W g t))
     (DSj.dmap-nat V.1 W.1 g.1 V.2 W.2 g.2 (PR.phi W t)) ;
  bkN (V W : TC.TOb) (g : TC.THm V W) (w : DY.Ob' W.1 W.2) : Id (W0.Ix (PR.Ext.ob V)) (bk V.1 V.2 (DYP.act V W g w)) (PR.Ext.act V W g (bk W.1 W.2 w)) =
   symH (transH (symH (bf V (PR.Ext.act V W g (bk W.1 W.2 w))))
     (apH {DY.Ob' V.1 V.2} {W0.Ix (PR.Ext.ob V)} (bk V.1 V.2)
        (transH (fwN V W g (bk W.1 W.2 w)) (apH {DY.Ob' W.1 W.2} {DY.Ob' V.1 V.2} (DYP.act V W g) (fb W.1 W.2 w))))) ;
  fwS : P.PSub[PR.Ext, DYP] = new P.PSub[PR.Ext, DYP, \ W t -> fw W t, \ V W g t -> fwN V W g t] ;
  bkS : P.PSub[DYP, PR.Ext] = new P.PSub[DYP, PR.Ext, \ W w -> bk W.1 W.2 w, \ V W g w -> bkN V W g w] ;
 } ;
} ;
