-- CTotPsi17.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 17: the lift back (bk), values.  Given a
-- point w = (ln, av) and a D-element u of the strict fibre of (G, A) over
-- Psi's point, the line of D A over ln: at (W, f, j) and an index q of W,
-- the line of A that u gives at the moved index, read at (id, j
-- restricted), moved along CTotPsi15's recovery to lie over ln at q.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi17 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P13 = CTotPsi13[a, vl, l].Psi13[C, G, A, e] ;
 module P10 = CTotPsi10[a, vl, l].Psi10[C, G, A, e] ;
 module P12 = P13.P12 ;
 module P6 = P12.P6 ;
 module PO = P6.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module DA = P6.DA ;
 module EKg = P6.EKg ;
 module EKd = P6.EKd ;
 module FTg = P12.FTg ;
 module R15 = CTotPsi15[a, vl, l].Psi15[C, G] ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;

 module BKd (X : TC.TOb) (w : EKd.TV.EI X) (u : P13.DS.TOb' X.1 X.2 (P10.psi X w)) {
  module PP = P6.PP[X, w] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  Yq (qq : DO.Idx I x) : TC.TOb = (qq.2.1, qq.2.2.2.1) ;
  lineE (qq : DO.Idx I x) (lq : DO.LandsI I x qq) : W0.Ix (FTg.FE.ob (Yq qq)) = (u.1 qq lq).1.1 ;
  module AB (Wd : TC.TOb) (f : TC.THm Wd X) (j : PB.IvP Wd.1) {
   dd : D.Ob' Wd.1 Wd.2 = PP.ln.1 Wd f j ;
   module RQ (q : DO.Idx Wd.1 Wd.2) (lq : DO.LandsI Wd.1 Wd.2 q) {
    module RC = R15.Rec[X, PP.ln, Wd, f, q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq), j] ;
    qq : DO.Idx I x = (q.1, q.2.1, RC.U0, q.2.2.2.1, RC.cc, q.2.2.2.2.2) ;
    Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
    te : EKg.TA.EI Y = (lineE qq lq).1 Y (TC.tid Y) RC.j0 ;
    pq : Id (W0.Ix (G.ob q.2.1 q.2.2.2.1)) te.1 (dd.1 q lq) =
     transH (apH {W0.Ix (P12.FCg.ob Y)} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ M -> M.1 Y (TC.tid Y) RC.j0) (u.1 qq lq).1.2)
      (symH RC.law) ;
    abf : W0.Ix (A.tob Y (dd.1 q lq)) = EKg.TA.coeT Y te.1 (dd.1 q lq) pq te.2 ;
    aeq : Id (EKg.TA.EI Y) (EKg.TA.pr Y (dd.1 q lq) abf) te = symH (EKg.TA.pr-coe Y te.1 (dd.1 q lq) pq te.2) ;
   } ;
   abfam : DA.TA Wd.1 Wd.2 dd = \ q lq -> RQ[q, lq].abf ;
  } ;
 } ;
} ;
