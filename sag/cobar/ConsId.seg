-- ConsId.seg: prepending the identity to a chain (Lemma 14: the lines p, q
-- read u at (id , f0 , ... , fn)).  consId c = (x , id_x , c).
--   consId-face0 : face 0 of consId c is (z , c , id) (oC-idl)
--   consId-tot   : the total composite is unchanged
--   higher faces: fc (suc m) (suc k) (consId c) = liftD of fc m k c, by
--   the definition of fc (no lemma needed)
level a ;
open Base ;
open Prelude[a] ;
open Trees[a] ;
open Arith[a] ;
module ConsOf (C : SmallCat[a].SmallCat) {
 module K = Chains[a].ChainsOf[C] ;
 consId (n : Nat) (x z : K.CO) (c : K.Ch n x z) : K.Ch (suc n) x z = (x,C.idC x,c) ;
 -- the face (z , d , id)
 trip (n : Nat) (x z : K.CO) (d : K.Ch n x z) : K.DR n x z = (z,d,C.idC z) ;
 -- comp at 0 of consId c is c
 comp0 : (n : Nat) -> (x z : K.CO) (c : K.Ch n x z) -> Id (K.Ch n x z) (K.comp n zero x z (consId n x z c)) c = split {
  zero -> \ x z c -> C.oC-idl z x c ;
  suc m -> \ x z c -> ap (K.CH c.1 x) (K.Ch (suc m) x z) (\ h -> (c.1,h,c.2.2)) (K.co c.1 x x (C.idC x) c.2.1) c.2.1 (C.oC-idl c.1 x c.2.1) } ;
 fc0B : (n : Nat) -> (x z : K.CO) (c : K.Ch n x z) -> Id (K.DR n x z) (K.fc n zero x z (consId n x z c)) (trip n x z c) = split {
  zero -> \ x z c -> ap (K.Ch zero x z) (K.DR zero x z) (trip zero x z) (K.comp zero zero x z (consId zero x z c)) c (comp0 zero x z c) ;
  suc m -> \ x z c -> ap (K.Ch (suc m) x z) (K.DR (suc m) x z) (trip (suc m) x z) (K.comp (suc m) zero x z (consId (suc m) x z c)) c (comp0 (suc m) x z c) } ;
 consId-face0 (n : Nat) (x z : K.CO) (c : K.Ch n x z) :
  Id (K.DR n x z) (K.fc n zero x z (consId n x z c)) (trip n x z c) = fc0B n x z c ;
 consId-tot (n : Nat) (x z : K.CO) (c : K.Ch n x z) : Id (K.CH z x) (K.tot (suc n) x z (consId n x z c)) (K.tot n x z c) =
  C.oC-idl z x (K.tot n x z c) ;
} ;
