-- CwFElimG2.seg (canonicity-c2; SIMPLIFIED.md item 3, the quotient's
-- eliminator into sets): the recipe of CwFElimG1's family from data over a
-- context D, a predicate P0 : T0 -> PropU and a function fD : T0 -> B,
--     R.CF = Sigma (b : B) Pi (a : T0) (Dec (P0 a) -> Id(fD a , b)),
-- and its values:
--   bodOv   bodies of functions along upT (bodNat, by J on the type path)
--   AtB b0  the Pi part at b0 is Pi (a : T0) (Dec (P0 a) -> Id(fD a , b0))
--           (H0), read through CwFMaps.USI (lift of p after the lifted
--           section is the identity); mk: a pair from an element of H0
--   App     H0 applied at a0 and rho : Dec (P0 a0) gives Id(fD a0 , b0)
open Base ;

module ElimG2 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) (Un : CwFU.Univ[l, C].UnivStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module PU = CwFPropU.PropU[l, C, PS, SS, IJ, Un] ;
  module MP = CwFMaps.Maps[l, C, PS, SS, IJ] ;
  module X1 = CwFSetX1.SetX1[l, C, PS, SS, IJ, Un, NF] ;
  module G1 = CwFElimG1.ElimG1[l, C, PS, SS, IJ, Un, NF] ;

  -- bodies along upT
  bodOv (D' D : Ctx) (A : Ty D) (B : Ty (ext D A)) (s : Sub D' D) (A' : Ty D') (PA : Id (Ty D') (subT D' D A s) A')
    (B' : Ty (ext D' A')) (PB : Id (Ty (ext D' A')) (subT (ext D' A') (ext D A) B (upT D' D A s A' PA)) B')
    (PF : Id (Ty D') (subT D' D (PS.Pi D A B) s) (PS.Pi D' A' B'))
    (f : El D (PS.Pi D A B)) (f' : El D' (PS.Pi D' A' B')) (Pf : Ov D' D (PS.Pi D A B) s (PS.Pi D' A' B') PF f f')
    : Ov (ext D' A') (ext D A) B (upT D' D A s A' PA) B' PB (bod D A B f) (bod D' A' B' f') =
    idJ (Ty D') (subT D' D A s)
      (\ X PX -> (B2 : Ty (ext D' X)) (PB2 : Id (Ty (ext D' X)) (subT (ext D' X) (ext D A) B (upT D' D A s X PX)) B2)
         (PF2 : Id (Ty D') (subT D' D (PS.Pi D A B) s) (PS.Pi D' X B2)) (f2 : El D' (PS.Pi D' X B2))
         -> Ov D' D (PS.Pi D A B) s (PS.Pi D' X B2) PF2 f f2 -> Ov (ext D' X) (ext D A) B (upT D' D A s X PX) B2 PB2 (bod D A B f) (bod D' X B2 f2))
      (\ B2 PB2 PF2 f2 o2 ->
         trans (El (ext D' (subT D' D A s)) B2)
           (trE (ext D' (subT D' D A s)) (subT (ext D' (subT D' D A s)) (ext D A) B (lift D' D A s)) B2 PB2
              (subt (ext D' (subT D' D A s)) (ext D A) B (bod D A B f) (lift D' D A s)))
           (bod D' (subT D' D A s) B2 (trE D' (subT D' D (PS.Pi D A B) s) (PS.Pi D' (subT D' D A s) B2) PF2 (subt D' D (PS.Pi D A B) f s)))
           (bod D' (subT D' D A s) B2 f2)
           (sym (El (ext D' (subT D' D A s)) B2)
              (bod D' (subT D' D A s) B2 (trE D' (subT D' D (PS.Pi D A B) s) (PS.Pi D' (subT D' D A s) B2) PF2 (subt D' D (PS.Pi D A B) f s)))
              (trE (ext D' (subT D' D A s)) (subT (ext D' (subT D' D A s)) (ext D A) B (lift D' D A s)) B2 PB2
                 (subt (ext D' (subT D' D A s)) (ext D A) B (bod D A B f) (lift D' D A s)))
              (bodNat D' D A B s B2 PB2 PF2 f))
           (ap (El D' (PS.Pi D' (subT D' D A s) B2)) (El (ext D' (subT D' D A s)) B2) (\ g -> bod D' (subT D' D A s) B2 g)
              (trE D' (subT D' D (PS.Pi D A B) s) (PS.Pi D' (subT D' D A s) B2) PF2 (subt D' D (PS.Pi D A B) f s)) f2 o2))
      A' PA B' PB PF f' Pf ;

  module R (D : Ctx) (B T0 : Ty D) (P0 : El D (X1.FunU D T0)) (fD : El D (Fun D T0 B)) {
    DB : Ctx = ext D B ;
    T : Ty DB = wkT D B T0 ;
    PFw : Id (Ty DB) (wkT D B (X1.FunU D T0)) (X1.FunU DB T) = X1.PF DB D (p D B) T0 T (refl T) ;
    Pw : El DB (X1.FunU DB T) = trE DB (wkT D B (X1.FunU D T0)) (X1.FunU DB T) PFw (wkE D B (X1.FunU D T0) P0) ;
    E : Ctx = ext DB T ;
    lf : Sub E (ext D T0) = lift DB D T0 (p D B) ;
    WB : Ty (ext D T0) = wkT D T0 B ;
    bodf : El (ext D T0) WB = bod D T0 WB fD ;
    PLF : Id (Ty E) (subT E (ext D T0) WB lf) (wkT DB T (wkT D B B)) = p-lift-T DB D T0 B (p D B) ;
    fa : El E (wkT DB T (wkT D B B)) = trE E (subT E (ext D T0) WB lf) (wkT DB T (wkT D B B)) PLF (subt E (ext D T0) WB bodf lf) ;
    module K = G1.CFof[D, B, T, Pw, fa] ;
    -- the family at the reflexive predicate of T0 (for H0)
    module R0 = X1.RelOf[D, T0, P0, P0] ;
    TP0 : Ty (ext D T0) = R0.TP ;

    module AtB (b0 : El D B) {
      module US = MP.USI[D, B, T0, b0] ;
      sb : Sub D DB = sec D B b0 ;
      PA : Id (Ty D) (subT D DB T sb) T0 = p-sec-T D B T0 b0 ;
      up : Sub (ext D T0) E = US.upS ;
      -- the predicate
      PFs : Id (Ty D) (subT D DB (X1.FunU DB T) sb) (X1.FunU D T0) = X1.PF D DB sb T T0 PA ;
      oPw : Ov D DB (X1.FunU DB T) sb (X1.FunU D T0) PFs Pw P0 =
        ovTr D DB (wkT D B (X1.FunU D T0)) (X1.FunU DB T) PFw sb (X1.FunU D T0) (X1.FunU D T0) (refl (X1.FunU D T0))
          (p-sec-T D B (X1.FunU D T0) b0) PFs (wkE D B (X1.FunU D T0) P0) P0 (IN.wkE-sec D B (X1.FunU D T0) b0 P0 (p-sec-T D B (X1.FunU D T0) b0)) ;
      module RW = X1.RelOf[DB, T, Pw, Pw] ;
      PWB : Id (Ty (ext D T0)) (subT (ext D T0) E RW.WU up) R0.WU = wkT-ov D DB T (PU.PropU DB) sb T0 PA (PU.PropU D) (PU.PropU-ov D DB sb) ;
      ob : Ov (ext D T0) E RW.WU up R0.WU PWB (bod DB T RW.WU Pw) (bod D T0 R0.WU P0) =
        bodOv D DB T RW.WU sb T0 PA R0.WU PWB PFs Pw P0 oPw ;
      om : Ov (ext D T0) E (PU.PropU E) up (PU.PropU (ext D T0)) (PU.PropU-ov (ext D T0) E up) RW.mP R0.mP =
        ovTr (ext D T0) E RW.WU (PU.PropU E) RW.PWU up R0.WU (PU.PropU (ext D T0)) R0.PWU PWB (PU.PropU-ov (ext D T0) E up)
          (bod DB T RW.WU Pw) (bod D T0 R0.WU P0) ob ;
      PTP : Id (Ty (ext D T0)) (subT (ext D T0) E K.TP up) TP0 = G1.decN (ext D T0) E up RW.mP R0.mP om ;
      -- the values
      PBE : Id (Ty (ext D T0)) (subT (ext D T0) E K.BE up) WB = wkT-ov D DB T (wkT D B B) sb T0 PA B (p-sec-T D B B b0) ;
      PLu : Id (Ty (ext D T0)) (subT (ext D T0) E (subT E (ext D T0) WB lf) up) WB =
        trans (Ty (ext D T0)) (subT (ext D T0) E (subT E (ext D T0) WB lf) up) (subT (ext D T0) E K.BE up) WB
          (ap (Ty E) (Ty (ext D T0)) (\ X -> subT (ext D T0) E X up) (subT E (ext D T0) WB lf) K.BE PLF) PBE ;
      ofa : Ov (ext D T0) E K.BE up WB PBE fa bodf =
        calc (El (ext D T0) WB) {
            trE (ext D T0) (subT (ext D T0) E K.BE up) WB PBE (subt (ext D T0) E K.BE fa up)
          =< ap (El (ext D T0) (subT (ext D T0) E K.BE up)) (El (ext D T0) WB) (\ v -> trE (ext D T0) (subT (ext D T0) E K.BE up) WB PBE v)
               (subt (ext D T0) E K.BE fa up)
               (trE (ext D T0) (subT (ext D T0) E (subT E (ext D T0) WB lf) up) (subT (ext D T0) E K.BE up)
                  (ap (Ty E) (Ty (ext D T0)) (\ X -> subT (ext D T0) E X up) (subT E (ext D T0) WB lf) K.BE PLF)
                  (subt (ext D T0) E (subT E (ext D T0) WB lf) (subt E (ext D T0) WB bodf lf) up))
               (subt-tr (ext D T0) E (subT E (ext D T0) WB lf) K.BE PLF (subt E (ext D T0) WB bodf lf) up) >
            trE (ext D T0) (subT (ext D T0) E K.BE up) WB PBE
              (trE (ext D T0) (subT (ext D T0) E (subT E (ext D T0) WB lf) up) (subT (ext D T0) E K.BE up)
                 (ap (Ty E) (Ty (ext D T0)) (\ X -> subT (ext D T0) E X up) (subT E (ext D T0) WB lf) K.BE PLF)
                 (subt (ext D T0) E (subT E (ext D T0) WB lf) (subt E (ext D T0) WB bodf lf) up))
          =< trE-tr (ext D T0) (subT (ext D T0) E (subT E (ext D T0) WB lf) up) (subT (ext D T0) E K.BE up) WB
               (ap (Ty E) (Ty (ext D T0)) (\ X -> subT (ext D T0) E X up) (subT E (ext D T0) WB lf) K.BE PLF) PBE
               (subt (ext D T0) E (subT E (ext D T0) WB lf) (subt E (ext D T0) WB bodf lf) up) >
            trE (ext D T0) (subT (ext D T0) E (subT E (ext D T0) WB lf) up) WB PLu
              (subt (ext D T0) E (subT E (ext D T0) WB lf) (subt E (ext D T0) WB bodf lf) up)
          =< sq (ext D T0) (ext D T0) E (ext D T0) WB bodf lf up (id (ext D T0)) (id (ext D T0))
               (trans (Sub (ext D T0) (ext D T0)) (o (ext D T0) E (ext D T0) lf up) (id (ext D T0)) (o (ext D T0) (ext D T0) (ext D T0) (id (ext D T0)) (id (ext D T0)))
                  US.upId (sym (Sub (ext D T0) (ext D T0)) (o (ext D T0) (ext D T0) (ext D T0) (id (ext D T0)) (id (ext D T0))) (id (ext D T0)) (o-idl (ext D T0) (ext D T0) (id (ext D T0)))))
               WB PLu
               (trans (Ty (ext D T0)) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) WB
                  (subT-id (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0)))) (subT-id (ext D T0) WB)) >
            trE (ext D T0) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) WB
              (trans (Ty (ext D T0)) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) WB
                 (subT-id (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0)))) (subT-id (ext D T0) WB))
              (subt (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0))) (id (ext D T0)))
          =< sym (El (ext D T0) WB)
               (trE (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) WB (subT-id (ext D T0) WB)
                  (trE (ext D T0) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) (subT (ext D T0) (ext D T0) WB (id (ext D T0)))
                     (subT-id (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))))
                     (subt (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0))) (id (ext D T0)))))
               (trE (ext D T0) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) WB
                  (trans (Ty (ext D T0)) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) WB
                     (subT-id (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0)))) (subT-id (ext D T0) WB))
                  (subt (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0))) (id (ext D T0))))
               (trE-tr (ext D T0) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) WB
                  (subT-id (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0)))) (subT-id (ext D T0) WB)
                  (subt (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0))) (id (ext D T0)))) >
            trE (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) WB (subT-id (ext D T0) WB)
              (trE (ext D T0) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) (subT (ext D T0) (ext D T0) WB (id (ext D T0)))
                 (subT-id (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))))
                 (subt (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0))) (id (ext D T0))))
          =< ap (El (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0)))) (El (ext D T0) WB)
               (\ v -> trE (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) WB (subT-id (ext D T0) WB) v)
               (trE (ext D T0) (subT (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (id (ext D T0))) (subT (ext D T0) (ext D T0) WB (id (ext D T0)))
                  (subT-id (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))))
                  (subt (ext D T0) (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0))) (id (ext D T0))))
               (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0)))
               (subt-id (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0)))) >
            trE (ext D T0) (subT (ext D T0) (ext D T0) WB (id (ext D T0))) WB (subT-id (ext D T0) WB) (subt (ext D T0) (ext D T0) WB bodf (id (ext D T0)))
          =< subt-id (ext D T0) WB bodf >
            bodf } ;
      obE : Ov (ext D T0) E K.BE up WB PBE K.bE (wkE D T0 B b0) =
        wkE-ov D DB T (wkT D B B) (q D B) sb T0 PA B (p-sec-T D B B b0) b0 (IN.q-secO D B b0 (p-sec-T D B B b0)) PBE ;
      Y0 : Ty (ext D T0) = IJ.IdT (ext D T0) WB bodf (wkE D T0 B b0) ;
      F0 : Ty (ext D T0) = Fun (ext D T0) TP0 Y0 ;
      Fo : Id (Ty (ext D T0)) (subT (ext D T0) E K.F up) F0 =
        G1.FN (ext D T0) E up K.TP TP0 PTP K.BE WB PBE fa K.bE bodf (wkE D T0 B b0) ofa obE ;
      H0 : Ty D = PS.Pi D T0 F0 ;
      Ho : Id (Ty D) (subT D DB K.H sb) H0 = Pi-ov D DB T K.F sb T0 PA F0 Fo ;
      mk (g : El D H0) : El D K.CF = IN.pr D B K.H b0 (trE D H0 (subT D DB K.H sb) (sym (Ty D) (subT D DB K.H sb) H0 Ho) g) ;
      -- application at a0
      module App (g : El D H0) (a0 : El D T0) (rho : El D (subT D (ext D T0) TP0 (sec D T0 a0))) {
        sa : Sub D (ext D T0) = sec D T0 a0 ;
        r1 : El D (subT D (ext D T0) F0 sa) = IN.appD D T0 F0 g a0 ;
        PFa : Id (Ty D) (subT D (ext D T0) F0 sa) (Fun D (subT D (ext D T0) TP0 sa) (subT D (ext D T0) Y0 sa)) =
          Fun-ov D (ext D T0) TP0 Y0 sa (subT D (ext D T0) TP0 sa) (refl (subT D (ext D T0) TP0 sa)) (subT D (ext D T0) Y0 sa) (refl (subT D (ext D T0) Y0 sa)) ;
        r2 : El D (subT D (ext D T0) Y0 sa) =
          app D (subT D (ext D T0) TP0 sa) (subT D (ext D T0) Y0 sa) (trE D (subT D (ext D T0) F0 sa) (Fun D (subT D (ext D T0) TP0 sa) (subT D (ext D T0) Y0 sa)) PFa r1) rho ;
        PY : Id (Ty D) (subT D (ext D T0) Y0 sa) (IJ.IdT D B (app D T0 B fD a0) b0) =
          Id-ov D (ext D T0) WB bodf (wkE D T0 B b0) sa B (p-sec-T D T0 B a0) (app D T0 B fD a0) b0
            (refl (app D T0 B fD a0)) (IN.wkE-sec D T0 B a0 b0 (p-sec-T D T0 B a0)) ;
        res : El D (IJ.IdT D B (app D T0 B fD a0) b0) = trE D (subT D (ext D T0) Y0 sa) (IJ.IdT D B (app D T0 B fD a0) b0) PY r2 ;
      } ;
    } ;
  } ;
} ;
