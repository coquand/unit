-- CTotL16c.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, chains: concatenation at a stage J with the arities of the weights
-- (Arith[a].plus; the stage chains are Chains[vl], whose own cat has
-- Arith[vl].plus arities, which do not convert).  catA is cat's recursion
-- at those arities; the lemmas are Chains.seg's proofs, copied.
-- Generic in the internal category.
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[vl] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;

module CA (C : CIntCat[a, vl].IC) (J : Ob) {
 module K = CTotL14d[a, vl, l].L14d[C].KJ[J].K ;
 catA : (m : Nat) -> (n : Nat) -> (x y z : K.CO) -> K.Ch m x y -> K.Ch n y z -> K.Ch (Ar.plus m (suc n)) x z = split {
  zero -> \ n x y z f c -> (y, f, c) ;
  suc m' | r -> \ n x y z c' c -> (c'.1, c'.2.1, r n c'.1 y z c'.2.2 c) } ;

 tot-cat : (m : Nat) -> (n : Nat) (x y z : K.CO) (c' : K.Ch m x y) (c : K.Ch n y z)
  -> Id (K.CH z x) (K.tot (Ar.plus m (suc n)) x z (catA m n x y z c' c)) (K.co z y x (K.tot m x y c') (K.tot n y z c)) = split {
  zero -> \ n x y z f c -> refl (K.co z y x f (K.tot n y z c)) ;
  suc m' | ih -> \ n x y z c' c ->
   trans (K.CH z x) (K.co z c'.1 x c'.2.1 (K.tot (Ar.plus m' (suc n)) c'.1 z (catA m' n c'.1 y z c'.2.2 c)))
    (K.co z c'.1 x c'.2.1 (K.co z y c'.1 (K.tot m' c'.1 y c'.2.2) (K.tot n y z c)))
    (K.co z y x (K.co y c'.1 x c'.2.1 (K.tot m' c'.1 y c'.2.2)) (K.tot n y z c))
    (ap (K.CH z c'.1) (K.CH z x) (\ h -> K.co z c'.1 x c'.2.1 h) (K.tot (Ar.plus m' (suc n)) c'.1 z (catA m' n c'.1 y z c'.2.2 c))
       (K.co z y c'.1 (K.tot m' c'.1 y c'.2.2) (K.tot n y z c)) (ih n c'.1 y z c'.2.2 c))
    (sym (K.CH z x) (K.co z y x (K.co y c'.1 x c'.2.1 (K.tot m' c'.1 y c'.2.2)) (K.tot n y z c))
       (K.co z c'.1 x c'.2.1 (K.co z y c'.1 (K.tot m' c'.1 y c'.2.2) (K.tot n y z c)))
       (K.C.oC-assoc z y c'.1 x c'.2.1 (K.tot m' c'.1 y c'.2.2) (K.tot n y z c))) } ;

 rx-cat : (m : Nat) -> (n : Nat) (x' x y z : K.CO) (g : K.CH x' x) (c' : K.Ch m x' y) (c : K.Ch n y z)
  -> Id (K.Ch (Ar.plus m (suc n)) x z) (K.rx (Ar.plus m (suc n)) x' x g z (catA m n x' y z c' c)) (catA m n x y z (K.rx m x' x g y c') c) = split {
  zero -> \ n x' x y z g f c -> refl (y, K.co y x' x g f, c) ;
  suc m' -> \ n x' x y z g c' c -> refl (c'.1, K.co c'.1 x' x g c'.2.1, catA m' n c'.1 y z c'.2.2 c) } ;

 -- the face at 0 composes the first two maps
 front0 : (n : Nat) -> (x y z : K.CO) (f : K.CH y x) (c : K.Ch n y z) -> Id (K.Ch n x z) (K.comp n zero x z (y, f, c)) (K.rx n y x f z c) = split {
  zero -> \ x y z f c -> refl (K.co z y x f c) ;
  suc n' -> \ x y z f c -> refl (c.1, K.co c.1 y x f c.2.1, c.2.2) } ;

 -- the first m+1 faces at 0: the first block composed into the second
 compFront : (m : Nat) -> (n : Nat) (x z : K.CO) -> K.Ch (Ar.plus m (suc n)) x z -> K.Ch n x z = split {
  zero -> \ n x z c -> K.comp n zero x z c ;
  suc m' | r -> \ n x z c -> r n x z (K.comp (Ar.plus m' (suc n)) zero x z c) } ;

 cat-front : (m : Nat) -> (n : Nat) (x y z : K.CO) (c' : K.Ch m x y) (c : K.Ch n y z)
  -> Id (K.Ch n x z) (compFront m n x z (catA m n x y z c' c)) (K.rx n y x (K.tot m x y c') z c) = split {
  zero -> \ n x y z f c -> front0 n x y z f c ;
  suc m' | ih -> \ n x y z c' c ->
   trans (K.Ch n x z) (compFront m' n x z (K.comp (Ar.plus m' (suc n)) zero x z (c'.1, c'.2.1, catA m' n c'.1 y z c'.2.2 c)))
    (compFront m' n x z (catA m' n x y z (K.rx m' c'.1 x c'.2.1 y c'.2.2) c))
    (K.rx n y x (K.co y c'.1 x c'.2.1 (K.tot m' c'.1 y c'.2.2)) z c)
    (ap (K.Ch (Ar.plus m' (suc n)) x z) (K.Ch n x z) (compFront m' n x z)
       (K.comp (Ar.plus m' (suc n)) zero x z (c'.1, c'.2.1, catA m' n c'.1 y z c'.2.2 c))
       (catA m' n x y z (K.rx m' c'.1 x c'.2.1 y c'.2.2) c)
       (trans (K.Ch (Ar.plus m' (suc n)) x z) (K.comp (Ar.plus m' (suc n)) zero x z (c'.1, c'.2.1, catA m' n c'.1 y z c'.2.2 c))
          (K.rx (Ar.plus m' (suc n)) c'.1 x c'.2.1 z (catA m' n c'.1 y z c'.2.2 c))
          (catA m' n x y z (K.rx m' c'.1 x c'.2.1 y c'.2.2) c)
          (front0 (Ar.plus m' (suc n)) x c'.1 z c'.2.1 (catA m' n c'.1 y z c'.2.2 c))
          (rx-cat m' n c'.1 x y z c'.2.1 c'.2.2 c)))
    (trans (K.Ch n x z) (compFront m' n x z (catA m' n x y z (K.rx m' c'.1 x c'.2.1 y c'.2.2) c))
       (K.rx n y x (K.tot m' x y (K.rx m' c'.1 x c'.2.1 y c'.2.2)) z c)
       (K.rx n y x (K.co y c'.1 x c'.2.1 (K.tot m' c'.1 y c'.2.2)) z c)
       (ih n x y z (K.rx m' c'.1 x c'.2.1 y c'.2.2) c)
       (ap (K.CH y x) (K.Ch n x z) (\ h -> K.rx n y x h z c) (K.tot m' x y (K.rx m' c'.1 x c'.2.1 y c'.2.2))
          (K.co y c'.1 x c'.2.1 (K.tot m' c'.1 y c'.2.2)) (K.tot-rx m' c'.1 x c'.2.1 y c'.2.2))) } ;

 -- the face at the junction composes the last map of c' into c
 cat-junction : (m : Nat) -> (n : Nat) (x y z : K.CO) (c' : K.Ch (suc m) x y) (c : K.Ch n y z)
  -> Id (K.Ch (Ar.plus m (suc n)) x z) (K.comp (Ar.plus m (suc n)) (suc m) x z (catA (suc m) n x y z c' c))
       (catA m n x (K.drop m x y c').1 z (K.drop m x y c').2.1 (K.rx n y (K.drop m x y c').1 (K.drop m x y c').2.2 z c)) = split {
  zero -> \ n x y z c' c -> ap (K.Ch n c'.1 z) (K.Ch (suc n) x z) (\ r -> (c'.1, c'.2.1, r))
    (K.comp n zero c'.1 z (y, c'.2.2, c)) (K.rx n y c'.1 c'.2.2 z c) (front0 n c'.1 y z c'.2.2 c) ;
  suc m' | ih -> \ n x y z c' c -> ap (K.Ch (Ar.plus m' (suc n)) c'.1 z) (K.Ch (suc (Ar.plus m' (suc n))) x z) (\ r -> (c'.1, c'.2.1, r))
    (K.comp (Ar.plus m' (suc n)) (suc m') c'.1 z (catA (suc m') n c'.1 y z c'.2.2 c))
    (catA m' n c'.1 (K.drop m' c'.1 y c'.2.2).1 z (K.drop m' c'.1 y c'.2.2).2.1 (K.rx n y (K.drop m' c'.1 y c'.2.2).1 (K.drop m' c'.1 y c'.2.2).2.2 z c))
    (ih n c'.1 y z c'.2.2 c) } ;

 -- transport of chains along an equality of lengths
 trCh (n1 n2 : Nat) (e : Id Nat n1 n2) (x z : K.CO) (c : K.Ch n1 x z) : K.Ch n2 x z = subst Nat (\ k -> K.Ch k x z) n1 n2 e c ;

 trCh-suc (n1 n2 : Nat) (e : Id Nat n1 n2) (x y0 z : K.CO) (f0 : K.CH y0 x) (c : K.Ch n1 y0 z)
  : Id (K.Ch (suc n2) x z) (trCh (suc n1) (suc n2) (ap Nat Nat (\ k -> suc k) n1 n2 e) x z (y0, f0, c)) (y0, f0, trCh n1 n2 e y0 z c) =
  idJ Nat n1 (\ k e2 -> Id (K.Ch (suc k) x z) (trCh (suc n1) (suc k) (ap Nat Nat (\ k' -> suc k') n1 k e2) x z (y0, f0, c)) (y0, f0, trCh n1 k e2 y0 z c))
   (refl (y0, f0, c)) n2 e ;

 -- the chain catA m (suc n) c' c, with its arity in the form suc N
 catS (m n : Nat) (x y z : K.CO) (c' : K.Ch m x y) (c : K.Ch (suc n) y z) : K.Ch (suc (Ar.plus m (suc n))) x z =
  trCh (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) x z (catA m (suc n) x y z c' c) ;

 -- the top face of a concatenation is the top face of c
 drop-cat : (m : Nat) -> (n : Nat) (x y z : K.CO) (c' : K.Ch m x y) (c : K.Ch (suc n) y z)
  -> Id (K.DR (Ar.plus m (suc n)) x z) (K.drop (Ar.plus m (suc n)) x z (catS m n x y z c' c))
       ((K.drop n y z c).1, catA m n x y (K.drop n y z c).1 c' (K.drop n y z c).2.1, (K.drop n y z c).2.2) = split {
  zero -> \ n x y z f c -> refl (K.drop (suc n) x z (y, f, c)) ;
  suc m' | ih -> \ n x y z c' c ->
   trans (K.DR (suc (Ar.plus m' (suc n))) x z)
    (K.drop (suc (Ar.plus m' (suc n))) x z (catS (suc m') n x y z c' c))
    (K.drop (suc (Ar.plus m' (suc n))) x z (c'.1, c'.2.1, catS m' n c'.1 y z c'.2.2 c))
    ((K.drop n y z c).1, catA (suc m') n x y (K.drop n y z c).1 c' (K.drop n y z c).2.1, (K.drop n y z c).2.2)
    (ap (K.Ch (suc (suc (Ar.plus m' (suc n)))) x z) (K.DR (suc (Ar.plus m' (suc n))) x z) (K.drop (suc (Ar.plus m' (suc n))) x z)
       (catS (suc m') n x y z c' c) (c'.1, c'.2.1, catS m' n c'.1 y z c'.2.2 c)
       (trCh-suc (Ar.plus m' (suc (suc n))) (suc (Ar.plus m' (suc n))) (Ar.plus-suc m' (suc n)) x c'.1 z c'.2.1 (catA m' (suc n) c'.1 y z c'.2.2 c)))
    (ap (K.DR (Ar.plus m' (suc n)) c'.1 z) (K.DR (suc (Ar.plus m' (suc n))) x z) (K.liftD (Ar.plus m' (suc n)) x c'.1 z c'.2.1)
       (K.drop (Ar.plus m' (suc n)) c'.1 z (catS m' n c'.1 y z c'.2.2 c))
       ((K.drop n y z c).1, catA m' n c'.1 y (K.drop n y z c).1 c'.2.2 (K.drop n y z c).2.1, (K.drop n y z c).2.2)
       (ih n c'.1 y z c'.2.2 c)) } ;

 -- an inner face in the second block
 comp-back : (m : Nat) -> (n k : Nat) (x y z : K.CO) (c' : K.Ch m x y) (c : K.Ch (suc n) y z)
  -> Id (K.Ch (Ar.plus m (suc n)) x z) (K.comp (Ar.plus m (suc n)) (Ar.plus m (suc k)) x z (catS m n x y z c' c))
       (catA m n x y z c' (K.comp n k y z c)) = split {
  zero -> \ n k x y z f c -> refl (y, f, K.comp n k y z c) ;
  suc m' | ih -> \ n k x y z c' c ->
   trans (K.Ch (suc (Ar.plus m' (suc n))) x z)
    (K.comp (suc (Ar.plus m' (suc n))) (suc (Ar.plus m' (suc k))) x z (catS (suc m') n x y z c' c))
    (c'.1, c'.2.1, K.comp (Ar.plus m' (suc n)) (Ar.plus m' (suc k)) c'.1 z (catS m' n c'.1 y z c'.2.2 c))
    (c'.1, c'.2.1, catA m' n c'.1 y z c'.2.2 (K.comp n k y z c))
    (ap (K.Ch (suc (suc (Ar.plus m' (suc n)))) x z) (K.Ch (suc (Ar.plus m' (suc n))) x z) (K.comp (suc (Ar.plus m' (suc n))) (suc (Ar.plus m' (suc k))) x z)
       (catS (suc m') n x y z c' c) (c'.1, c'.2.1, catS m' n c'.1 y z c'.2.2 c)
       (trCh-suc (Ar.plus m' (suc (suc n))) (suc (Ar.plus m' (suc n))) (Ar.plus-suc m' (suc n)) x c'.1 z c'.2.1 (catA m' (suc n) c'.1 y z c'.2.2 c)))
    (ap (K.Ch (Ar.plus m' (suc n)) c'.1 z) (K.Ch (suc (Ar.plus m' (suc n))) x z) (\ r -> (c'.1, c'.2.1, r))
       (K.comp (Ar.plus m' (suc n)) (Ar.plus m' (suc k)) c'.1 z (catS m' n c'.1 y z c'.2.2 c))
       (catA m' n c'.1 y z c'.2.2 (K.comp n k y z c))
       (ih n k c'.1 y z c'.2.2 c)) } ;

 -- an inner face in the first block (k <= m): K.comp k (catA (m+1) c' c) = catA m (K.comp k c') c
 catL0 (n : Nat) : (k : Nat) -> (hk : Tr.IsT (Tr.leb k zero)) -> (x y z : K.CO) (c' : K.Ch (suc zero) x y) (c : K.Ch n y z)
  -> Id (K.Ch (suc n) x z) (K.comp (suc n) k x z (catA (suc zero) n x y z c' c)) (catA zero n x y z (K.comp zero k x y c') c) = split {
  zero -> \ hk x y z c' c -> refl (y, K.co y c'.1 x c'.2.1 c'.2.2, c) ;
  suc k' -> \ hk x y z c' c -> absurd (Id (K.Ch (suc n) x z) (K.comp (suc n) (suc k') x z (catA (suc zero) n x y z c' c)) (catA zero n x y z (K.comp zero (suc k') x y c') c)) (Tr.false-true hk) } ;
 catLs (m' : Nat)
  (ih : (n k : Nat) (hk : Tr.IsT (Tr.leb k m')) (x y z : K.CO) (c' : K.Ch (suc m') x y) (c : K.Ch n y z)
        -> Id (K.Ch (Ar.plus m' (suc n)) x z) (K.comp (Ar.plus m' (suc n)) k x z (catA (suc m') n x y z c' c)) (catA m' n x y z (K.comp m' k x y c') c))
  (n : Nat) : (k : Nat) -> (hk : Tr.IsT (Tr.leb k (suc m'))) -> (x y z : K.CO) (c' : K.Ch (suc (suc m')) x y) (c : K.Ch n y z)
  -> Id (K.Ch (suc (Ar.plus m' (suc n))) x z) (K.comp (suc (Ar.plus m' (suc n))) k x z (catA (suc (suc m')) n x y z c' c)) (catA (suc m') n x y z (K.comp (suc m') k x y c') c) = split {
  zero -> \ hk x y z c' c -> refl (c'.2.2.1, K.co c'.2.2.1 c'.1 x c'.2.1 c'.2.2.2.1, catA m' n c'.2.2.1 y z c'.2.2.2.2 c) ;
  suc k' -> \ hk x y z c' c -> ap (K.Ch (Ar.plus m' (suc n)) c'.1 z) (K.Ch (suc (Ar.plus m' (suc n))) x z) (\ r -> (c'.1, c'.2.1, r))
    (K.comp (Ar.plus m' (suc n)) k' c'.1 z (catA (suc m') n c'.1 y z c'.2.2 c)) (catA m' n c'.1 y z (K.comp m' k' c'.1 y c'.2.2) c)
    (ih n k' hk c'.1 y z c'.2.2 c) } ;
 cat-left : (m : Nat) -> (n k : Nat) (hk : Tr.IsT (Tr.leb k m)) (x y z : K.CO) (c' : K.Ch (suc m) x y) (c : K.Ch n y z)
  -> Id (K.Ch (Ar.plus m (suc n)) x z) (K.comp (Ar.plus m (suc n)) k x z (catA (suc m) n x y z c' c)) (catA m n x y z (K.comp m k x y c') c) = split {
  zero -> \ n k hk x y z c' c -> catL0 n k hk x y z c' c ;
  suc m' | ih -> \ n k hk x y z c' c -> catLs m' ih n k hk x y z c' c } ;

 -- the arity m = m + 0 (an equality whose suc clause is ap suc)
 pzm (m : Nat) : Id Nat m (Ar.plus m zero) = CTotL16b[a, vl, l].pzm m ;
 -- the top face of catA c' f (a single map on the right) is (c' , f)
 drop-cat0 : (m : Nat) -> (x y z : K.CO) (c' : K.Ch m x y) (f : K.CH z y)
  -> Id (K.DR (Ar.plus m zero) x z) (K.drop (Ar.plus m zero) x z (trCh (Ar.plus m (suc zero)) (suc (Ar.plus m zero)) (Ar.plus-suc m zero) x z (catA m zero x y z c' f)))
       (y, trCh m (Ar.plus m zero) (pzm m) x y c', f) = split {
  zero -> \ x y z c' f -> refl (y, c', f) ;
  suc m' | ih -> \ x y z c' f ->
   trans (K.DR (suc (Ar.plus m' zero)) x z)
    (K.drop (suc (Ar.plus m' zero)) x z (trCh (suc (Ar.plus m' (suc zero))) (suc (suc (Ar.plus m' zero))) (ap Nat Nat (\ k -> suc k) (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero)) x z (c'.1, c'.2.1, catA m' zero c'.1 y z c'.2.2 f)))
    (K.drop (suc (Ar.plus m' zero)) x z (c'.1, c'.2.1, trCh (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) c'.1 z (catA m' zero c'.1 y z c'.2.2 f)))
    (y, trCh (suc m') (suc (Ar.plus m' zero)) (ap Nat Nat (\ k -> suc k) m' (Ar.plus m' zero) (pzm m')) x y (c'.1, c'.2.1, c'.2.2), f)
    (ap (K.Ch (suc (suc (Ar.plus m' zero))) x z) (K.DR (suc (Ar.plus m' zero)) x z) (K.drop (suc (Ar.plus m' zero)) x z)
       (trCh (suc (Ar.plus m' (suc zero))) (suc (suc (Ar.plus m' zero))) (ap Nat Nat (\ k -> suc k) (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero)) x z (c'.1, c'.2.1, catA m' zero c'.1 y z c'.2.2 f))
       (c'.1, c'.2.1, trCh (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) c'.1 z (catA m' zero c'.1 y z c'.2.2 f))
       (trCh-suc (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) x c'.1 z c'.2.1 (catA m' zero c'.1 y z c'.2.2 f)))
    (trans (K.DR (suc (Ar.plus m' zero)) x z)
      (K.drop (suc (Ar.plus m' zero)) x z (c'.1, c'.2.1, trCh (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) c'.1 z (catA m' zero c'.1 y z c'.2.2 f)))
      (y, (c'.1, c'.2.1, trCh m' (Ar.plus m' zero) (pzm m') c'.1 y c'.2.2), f)
      (y, trCh (suc m') (suc (Ar.plus m' zero)) (ap Nat Nat (\ k -> suc k) m' (Ar.plus m' zero) (pzm m')) x y (c'.1, c'.2.1, c'.2.2), f)
      (ap (K.DR (Ar.plus m' zero) c'.1 z) (K.DR (suc (Ar.plus m' zero)) x z) (K.liftD (Ar.plus m' zero) x c'.1 z c'.2.1)
         (K.drop (Ar.plus m' zero) c'.1 z (trCh (Ar.plus m' (suc zero)) (suc (Ar.plus m' zero)) (Ar.plus-suc m' zero) c'.1 z (catA m' zero c'.1 y z c'.2.2 f)))
         (y, trCh m' (Ar.plus m' zero) (pzm m') c'.1 y c'.2.2, f)
         (ih c'.1 y z c'.2.2 f))
      (ap (K.Ch (suc (Ar.plus m' zero)) x y) (K.DR (suc (Ar.plus m' zero)) x z) (\ cc -> (y, cc, f))
         (c'.1, c'.2.1, trCh m' (Ar.plus m' zero) (pzm m') c'.1 y c'.2.2)
         (trCh (suc m') (suc (Ar.plus m' zero)) (ap Nat Nat (\ k -> suc k) m' (Ar.plus m' zero) (pzm m')) x y (c'.1, c'.2.1, c'.2.2))
         (sym (K.Ch (suc (Ar.plus m' zero)) x y)
            (trCh (suc m') (suc (Ar.plus m' zero)) (ap Nat Nat (\ k -> suc k) m' (Ar.plus m' zero) (pzm m')) x y (c'.1, c'.2.1, c'.2.2))
            (c'.1, c'.2.1, trCh m' (Ar.plus m' zero) (pzm m') c'.1 y c'.2.2)
            (trCh-suc m' (Ar.plus m' zero) (pzm m') x c'.1 y c'.2.1 c'.2.2)))) } ;
} ;

-- the chain map of a functor between stage categories commutes with catA
module CFA (C : CIntCat[a, vl].IC) (J J' : Ob) (F : CChainsF[vl].FunOf[CVert[a, vl].VertOf[C].VCat J, CVert[a, vl].VertOf[C].VCat J'].SFun) {
 module A1 = CA[C, J] ;
 module A2 = CA[C, J'] ;
 module CF = CChainsF[vl].CF[CVert[a, vl].VertOf[C].VCat J, CVert[a, vl].VertOf[C].VCat J', F] ;
 chF-catA : (m : Nat) -> (n : Nat) (x y z : A1.K.CO) (c' : A1.K.Ch m x y) (c : A1.K.Ch n y z)
  -> Id (A2.K.Ch (Ar.plus m (suc n)) (F.onO x) (F.onO z)) (CF.chF (Ar.plus m (suc n)) x z (A1.catA m n x y z c' c))
       (A2.catA m n (F.onO x) (F.onO y) (F.onO z) (CF.chF m x y c') (CF.chF n y z c)) = split {
  zero -> \ n x y z f c -> refl (CF.chF (suc n) x z (y, f, c)) ;
  suc m' | ih -> \ n x y z c' c ->
   ap (A2.K.Ch (Ar.plus m' (suc n)) (F.onO c'.1) (F.onO z)) (A2.K.Ch (suc (Ar.plus m' (suc n))) (F.onO x) (F.onO z))
    (\ w -> (F.onO c'.1, F.onH c'.1 x c'.2.1, w))
    (CF.chF (Ar.plus m' (suc n)) c'.1 z (A1.catA m' n c'.1 y z c'.2.2 c))
    (A2.catA m' n (F.onO c'.1) (F.onO y) (F.onO z) (CF.chF m' c'.1 y c'.2.2) (CF.chF n y z c))
    (ih n c'.1 y z c'.2.2 c) } ;
} ;
