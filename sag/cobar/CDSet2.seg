-- CDSet2.seg (canonicity-c2; (d), T0 a set, part 2): the unit is a set (a
-- retract of Q_y, CRetSet), Q_y^m is a set (CProdSet2), and the closed type
-- T2 = Sigma (HomT(x, y) x Q_y^m). RelProd is a set (CSigSetC).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module HO = PosFull[a].PB.CHtpyOps[a+] ;
module Set2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module S1m = CDSet1[a].Set1[R, encK, pe, x, u, y] ;
 module S2 = S1m.S2 ;
 module S1 = S2.S1 ;
 Nl : C.Ctx = C.nil ;
 Qy : C.Ty Nl = S1.Qy ;
 UnitT : C.Ty Nl = S1.UnitT ;
 c0 : C.El Nl Qy = S1.AY.AX.cls (cst R.z) ;
 sN0 : HO.NMap[Nl, UnitT.1, Qy.1] = new HO.NMap[Nl, UnitT.1, Qy.1, \ K o t -> c0.eob K o, \ J I f o o' e t -> c0.enat J I f o o' e] ;
 rN0 : HO.NMap[Nl, Qy.1, UnitT.1] = new HO.NMap[Nl, Qy.1, UnitT.1, \ K o v -> tt, \ J I f o o' e v -> isTop (UnitT.1.tact J I f o o' e tt) tt] ;
 setU : CQCtx[a].G3Of[UnitT].SetQiTy = CRetSet[a].RetSet[UnitT, Qy, S1m.sQy, sN0, rN0, \ K o t -> isTop tt t].setQi ;
 setPm : (k : Nat) -> CQCtx[a].G3Of[S1.Pm k].SetQiTy = split {
  zero -> setU ;
  suc k | r -> CProdSet2[a].ProdSet2[S1.Pm k, Qy, r, S1m.sQy].setQi } ;
 HXY : C.Ty Nl = S1.HXY ;
 m : Nat = S1.m ;
 A2 : C.Ty Nl = SS.Sig Nl HXY (OV.wkT Nl HXY (S1.Pm m)) ;
 setHX : CQCtx[a].G3Of[HXY].SetQiTy = CHomSet[a].HomSet[R, encK, pe, x, y].setHom ;
 sA2 : CQCtx[a].G3Of[A2].SetQiTy = CProdSet2[a].ProdSet2[HXY, S1.Pm m, setHX, setPm m].setQi ;
 -- reindexing RelProd along nil.A2 -> nil.HomT(x, y).Q_y^m
 GA2 : C.Ctx = C.ext Nl A2 ;
 tN (K : Ob) : (o : Top) -> V1.Ix (A2.1.tob K o) -> V1.Ix (S1.Dv.ob K) = split { tt -> \ v -> ((tt, v.1), v.2) } ;
 tauN (K : Ob) (w : V1.Ix (GA2.ob K)) : V1.Ix (S1.Dv.ob K) = tN K w.1 w.2 ;
 tNat (J I : Ob) (f : Hom J I) : (o : Top) (v : V1.Ix (A2.1.tob I o)) -> Id (V1.Ix (S1.Dv.ob J)) (tauN J (GA2.act J I f (o, v))) (S1.Dv.act J I f (tN I o v)) = split {
  tt -> \ v -> apH {V1.Ix ((S1.Pm m).1.tob J tt)} {V1.Ix (S1.Dv.ob J)} (\ vv -> ((tt, HXY.1.tact J I f tt tt (refl tt) v.1), vv))
   (L.tact-irr Nl (S1.Pm m).1 J I f tt tt
     (L.ntEq (C.ext Nl HXY) Nl (C.p Nl HXY) J I f (tt, v.1) (tt, HXY.1.tact J I f tt tt (refl tt) v.1) (L.pair-act Nl HXY.1 J I f tt tt (refl tt) v.1))
     (L.ntEq S1.Gh Nl (C.eps S1.Gh) J I f (tt, v.1) (S1.Gh.act J I f (tt, v.1)) (refl (S1.Gh.act J I f (tt, v.1))))
     v.2) } ;
 tauNat (J I : Ob) (f : Hom J I) (w : V1.Ix (GA2.ob I)) : Id (V1.Ix (S1.Dv.ob J)) (tauN J (GA2.act J I f w)) (S1.Dv.act J I f (tauN I w)) = tNat J I f w.1 w.2 ;
 tau : C.Sub GA2 S1.Dv = new L.PSub[GA2, S1.Dv, tauN, tauNat] ;
 C2 : C.Ty GA2 = C.subT GA2 S1.Dv (S2.RelProd u.2) tau ;
 pC2 : C.El GA2 (PU.isProp GA2 C2) =
  OV.trE GA2 (C.subT GA2 S1.Dv (PU.isProp S1.Dv (S2.RelProd u.2)) tau) (PU.isProp GA2 C2) (PU.isProp-ov GA2 S1.Dv (S2.RelProd u.2) tau C2 (refl C2))
   (C.subt GA2 S1.Dv (PU.isProp S1.Dv (S2.RelProd u.2)) (S1m.pRel u.2) tau) ;
 T2 : C.Ty Nl = SS.Sig Nl A2 C2 ;
 sT2 : CQCtx[a].G3Of[T2].SetQiTy = CSigSetC[a].SigSetC[A2, C2, sA2, pC2].setQi ;
} ;
