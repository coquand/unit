-- The generic F3 multiplication equation uses the operation chosen for G.
level a ;
open Base ;
open Prelude[a] ;
open Paths[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Compat (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module T = CFree3Assoc[a].Generic3Assoc[R, encK, pe] ;
  module F = T.F ;
  module Mul = T.Mul ;
  mulOpPath : Mul.A.G1.GB.GPre[a+].PS.PEl[Mul.A.G1.GB.GPre[a+].PS.extP Mul.A.P1 Mul.A.XT,
    Mul.HO1.HT[Mul.A.P1, Mul.A.XT, Mul.A.GT,
      Mul.A.MulG.AO.OP (Mul.A.Rs F.x1) (Mul.A.MulG.AO.OP (Mul.A.Rs F.x2) (Mul.A.Rs F.x3)),
      Mul.A.MulG.AO.OP (Mul.A.MulG.AO.OP (Mul.A.Rs F.x1) (Mul.A.Rs F.x2)) (Mul.A.Rs F.x3)].PT.PathP] = T.mulPath ;
} ;
