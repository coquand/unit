-- CPshL16U.seg (canonicity-45; COBAR.md "Plan: Theorem 29", M6): Lemma 16
-- in the uniform form, and desc2.  Lemma16's two lines p : tau_DAC ~ M and
-- q : D-bar tau_A ~ M (the double readings LN2.mwe at the weights ML / MR)
-- are made internal homotopies of the CwF of fibrant C-types by
-- CPshNF.LineYC: their values are the fibre parts of mwe, natural in the
-- base by mwe-act, with the ends E0 / E1 and natural in C by MWC (the
-- moved double reading is the double reading of the moved element).
-- Then canonicity-c2's CPshInvC.Zig moves desc1 (D-bar tau_A an
-- equivalence) along q . p^-1 to tau_{D-bar A}.
--   L16I[G, A, c].Hq, Hp     the internal homotopies
--   L16I[G, A, c].desc2      tau_{D-bar A} is an equivalence (UTriv of
--                            its homotopy fibres), for A uniformly fibrant
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module LR = CLocBoundRetr[a, l] ;

module L16UOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module IDm = CPshId[a, l].IdOf[C] ;
 module NF = CPshNF[a, l].NFOf[C] ;
 module MC = CPshMapC[a, l].MapCOf[C] ;
 module IV = CPshInvC[a, l].InvCOf[C] ;
 module DT = CPshDT[a, l].DTOf[C] ;
 module DS = CPshDesc[a, l].DescOf[C] ;
 module MSB = CPshMapSub[a, l].MapSubOf[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 open P ;

 module L16I (G : CCtx) (A : CTy[G]) (c : UF.Cl G A) {
  module L16 = Lemma16[a, l].L16[C, G, A] ;
  DACc : CTy[G] = DT.Dbar G A ;
  B2c : CTy[G] = DT.Dbar G (DT.Dbar G A) ;
  Xs : UF.FCC.STy G = (B2c, DT.Dbar-fib G (DT.Dbar G A) (DT.Dbar-fib G A c)) ;
  Ys : UF.FCC.STy G = (DACc, DT.Dbar-fib G A c) ;
  -- the three maps as CMaps: D-bar tau_A, M, tau_{D-bar A}
  fC : P13.CMap[G, DACc, B2c] = DS.Dm G A (DT.Dbar G A) (DT.eta G A) ;
  gC : P13.CMap[G, DACc, B2c] = DT.eta G (DT.Dbar G A) ;
  mC : P13.CMap[G, DACc, B2c] =
   new P13.CMap[G, DACc, B2c, \ x -> LR.Map[G.ob x, DACc.ty x, B2c.ty x, L16.mN2 x].pmap,
    \ y x h X w -> L16.MWC[L16.WfCat, L16.WresCat, L16.WfaceLCat, L16.WfaceRCat, y, x, h, X, w, PB.ptH X PB.e1].eq] ;
  module MY = MC.M[G, DACc, B2c] ;
  -- D-bar tau_A at x is Lemma16's dTau x: both are D tau_A at the point tau_G (g)
  module SCB2 = LO.SC[G, DD.DC[G].DCtx, DD.DC[G].tau, DD.DT[G, DT.Dbar G A].DCTy] ;
  module MSD = MSB.MS[G, DD.DC[G].DCtx, DD.DC[G].tau, DD.DT[G, A].DCTy, DD.DT[G, DT.Dbar G A].DCTy, Prop13U[a, l].DfOf[C, G, A, DT.Dbar G A, DT.eta G A].DfC] ;
  alEq (x : CO) (W : Ob) (z : SigT (G.ob x) (DACc.ty x) W)
   : Id (SigT (G.ob x) (B2c.ty x) W) ((fC.mp x).mE W z) (LR.Map[G.ob x, DACc.ty x, B2c.ty x, L16.dTau x].pmap.mE W z) =
   SCB2.sub-eq x W ((fC.mp x).mE W z) (LR.Map[G.ob x, DACc.ty x, B2c.ty x, L16.dTau x].pmap.mE W z)
    (transH ((fC.mp x).mpt W z) (symH (LR.Map[G.ob x, DACc.ty x, B2c.ty x, L16.dTau x].pmap.mpt W z)))
    (transH (MSD.rd x W z) (refl (SCB2.rB x W (LR.Map[G.ob x, DACc.ty x, B2c.ty x, L16.dTau x].pmap.mE W z)))) ;
  opaque alEq ;
  module SCX = LO.SC[MY.GY, G, LO.pPC G DACc, B2c] ;

  -- one line: a family of fibre values mres over the points of G.DAC
  -- (the double reading), natural in the base (mact), the ends al, be
  -- (en0, en1), natural in C (mwc); al, be given as CMaps alC, beC with
  -- the same values (alE, beE)
  module Ln (mres : (x : CO) (W : Ob) (z : SigT (G.ob x) (DACc.ty x) W) (j : Hom W Iv) -> W0.Ix ((B2c.ty x).tob W (fstE (G.ob x) (DACc.ty x) W z)))
   (mact : (x : CO) (V W : Ob) (g : Hom V W) (z : SigT (G.ob x) (DACc.ty x) W) (j : Hom W Iv)
      -> Id (SigT (G.ob x) (B2c.ty x) V)
          ((extP (G.ob x) (B2c.ty x)).act V W g (pairE (G.ob x) (B2c.ty x) W (fstE (G.ob x) (DACc.ty x) W z) (mres x W z j)))
          (pairE (G.ob x) (B2c.ty x) V (fstE (G.ob x) (DACc.ty x) V ((extP (G.ob x) (DACc.ty x)).act V W g z))
             (mres x V ((extP (G.ob x) (DACc.ty x)).act V W g z) (compH V W Iv j g))))
   (mwc : (y x : CO) (f : CH y x) (W : Ob) (g : SigT (G.ob x) (DACc.ty x) W) (j : Hom W Iv)
      -> Id (SigT (G.ob y) (B2c.ty y) W)
          ((B2c.tE y x f).nt W (pairE (G.ob x) (B2c.ty x) W (fstE (G.ob x) (DACc.ty x) W g) (mres x W g j)))
          (pairE (G.ob y) (B2c.ty y) W (fstE (G.ob y) (DACc.ty y) W ((DACc.tE y x f).nt W g)) (mres y W ((DACc.tE y x f).nt W g) j)))
   (al be : (x : CO) -> HO.NMap[G.ob x, DACc.ty x, B2c.ty x])
   (alC beC : P13.CMap[G, DACc, B2c])
   (alE : (x : CO) (W : Ob) (z : SigT (G.ob x) (DACc.ty x) W)
      -> Id (SigT (G.ob x) (B2c.ty x) W) ((alC.mp x).mE W z) (LR.Map[G.ob x, DACc.ty x, B2c.ty x, al x].pmap.mE W z))
   (beE : (x : CO) (W : Ob) (z : SigT (G.ob x) (DACc.ty x) W)
      -> Id (SigT (G.ob x) (B2c.ty x) W) ((beC.mp x).mE W z) (LR.Map[G.ob x, DACc.ty x, B2c.ty x, be x].pmap.mE W z))
   (en0 : (x : CO) (X : Ob) (z : SigT (G.ob x) (DACc.ty x) X)
      -> Id (SigT (G.ob x) (B2c.ty x) X) (pairE (G.ob x) (B2c.ty x) X (fstE (G.ob x) (DACc.ty x) X z) (mres x X z (PB.ptH X PB.e0)))
           (HO.HT[G.ob x, DACc.ty x, B2c.ty x, al x, be x].aE X z))
   (en1 : (x : CO) (X : Ob) (z : SigT (G.ob x) (DACc.ty x) X)
      -> Id (SigT (G.ob x) (B2c.ty x) X) (pairE (G.ob x) (B2c.ty x) X (fstE (G.ob x) (DACc.ty x) X z) (mres x X z (PB.ptH X PB.e1)))
           (HO.HT[G.ob x, DACc.ty x, B2c.ty x, al x, be x].bE X z)) {
   module TX (x : CO) { module T = GPR.TyL[G.ob x, B2c.ty x] ; } ;
   a0 : CEl[MY.GY, MY.XY] = MY.toEl alC ;
   b0 : CEl[MY.GY, MY.XY] = MY.toEl beC ;
   -- the line field
   Lf (x : CO) (W : Ob) (z : W0.Ix ((MY.GY.ob x).ob W)) (j : Hom W Iv) : W0.Ix ((MY.XY.ty x).tob W z) = mres x W z j ;
   -- natural in the base
   Unat (x : CO) (V W : Ob) (g : Hom V W) (y : W0.Ix ((MY.GY.ob x).ob W)) (y' : W0.Ix ((MY.GY.ob x).ob V))
    (E : Id (W0.Ix ((MY.GY.ob x).ob V)) ((MY.GY.ob x).act V W g y) y') (j : Hom W Iv)
    : Id (W0.Ix ((MY.XY.ty x).tob V y')) ((MY.XY.ty x).tact V W g y y' E (Lf x W y j)) (Lf x V y' (compH V W Iv j g)) =
    TX[x].T.pr-inj V (fstE (G.ob x) (DACc.ty x) V y') ((MY.XY.ty x).tact V W g y y' E (Lf x W y j)) (Lf x V y' (compH V W Iv j g))
     (transH (symH (TX[x].T.pr-tact V W g (fstE (G.ob x) (DACc.ty x) W y) (fstE (G.ob x) (DACc.ty x) V y')
                      (ntEq (MY.GY.ob x) (G.ob x) (pP (G.ob x) (DACc.ty x)) V W g y y' E) (Lf x W y j)))
      (transH (mact x V W g y j)
        (apH (\ w -> pairE (G.ob x) (B2c.ty x) V (fstE (G.ob x) (DACc.ty x) V w) (mres x V w (compH V W Iv j g))) E))) ;
   opaque Unat ;
   -- the ends
   U0 (x : CO) (W : Ob) (z : W0.Ix ((MY.GY.ob x).ob W)) : Id (W0.Ix ((MY.XY.ty x).tob W z)) (Lf x W z (PB.ptH W PB.e0)) ((a0.el x).eob W z) =
    TX[x].T.pr-inj W (fstE (G.ob x) (DACc.ty x) W z) (Lf x W z (PB.ptH W PB.e0)) ((a0.el x).eob W z)
     (transH (en0 x W z) (transH (symH (alE x W z)) (symH (MY.To[alC].Ex[x].E.eQ W z)))) ;
   opaque U0 ;
   U1 (x : CO) (W : Ob) (z : W0.Ix ((MY.GY.ob x).ob W)) : Id (W0.Ix ((MY.XY.ty x).tob W z)) (Lf x W z (PB.ptH W PB.e1)) ((b0.el x).eob W z) =
    TX[x].T.pr-inj W (fstE (G.ob x) (DACc.ty x) W z) (Lf x W z (PB.ptH W PB.e1)) ((b0.el x).eob W z)
     (transH (en1 x W z) (transH (symH (beE x W z)) (symH (MY.To[beC].Ex[x].E.eQ W z)))) ;
   opaque U1 ;
   -- natural in C
   UC (y x : CO) (f : CH y x) (W : Ob) (g : W0.Ix ((MY.GY.ob x).ob W)) (j : Hom W Iv)
    : Id (SigT (MY.GY.ob y) (MY.XY.ty y) W) ((MY.XY.tE y x f).nt W (pairE (MY.GY.ob x) (MY.XY.ty x) W g (Lf x W g j)))
        (pairE (MY.GY.ob y) (MY.XY.ty y) W ((MY.GY.act y x f).nt W g) (Lf y W ((MY.GY.act y x f).nt W g) j)) =
    SCX.sub-eq y W ((MY.XY.tE y x f).nt W (pairE (MY.GY.ob x) (MY.XY.ty x) W g (Lf x W g j)))
      (pairE (MY.GY.ob y) (MY.XY.ty y) W ((MY.GY.act y x f).nt W g) (Lf y W ((MY.GY.act y x f).nt W g) j))
      (refl ((MY.GY.act y x f).nt W g))
      (transH (SCX.rBtE y x f W (pairE (MY.GY.ob x) (MY.XY.ty x) W g (Lf x W g j))) (mwc y x f W g j)) ;
   opaque UC ;
   el : CEl[MY.GY, IDm.IdC[MY.GY, MY.XY, a0, b0].IdT] = NF.LineYC[MY.GY, MY.XY, a0, b0, Lf, Unat, U0, U1, UC].el ;
  } ;

  -- q : D-bar tau_A ~ M, the double reading at the weights MR
  Hq : IV.InvM[G, Xs, Ys, fC, gC].Ht (MY.toEl fC) (MY.toEl mC) =
   Ln[\ x W z j -> L16.MW2[L16.WfMR, L16.WresMR, L16.WfaceLMR, L16.WfaceRMR, x, W, fstE (G.ob x) (DACc.ty x) W z, sndE (G.ob x) (DACc.ty x) W z, j].res,
      \ x V W g z j -> L16.LN2[L16.WfMR, L16.WresMR, L16.WfaceLMR, L16.WfaceRMR, x].mwe-act V W g z j,
      \ y x f W g j -> L16.MWC[L16.WfMR, L16.WresMR, L16.WfaceLMR, L16.WfaceRMR, y, x, f, W, g, j].eq,
      L16.dTau, L16.mN2, fC, mC,
      alEq, \ x W z -> refl ((mC.mp x).mE W z),
      \ x X z -> L16.E0[x, X, z].q0, \ x X z -> L16.E1[x, X, z].q1].el ;
  -- p : tau_{D-bar A} ~ M, the double reading at the weights ML
  Hp : IV.InvM[G, Xs, Ys, fC, gC].Ht (MY.toEl gC) (MY.toEl mC) =
   Ln[\ x W z j -> L16.MW2[L16.WfML, L16.WresML, L16.WfaceLML, L16.WfaceRML, x, W, fstE (G.ob x) (DACc.ty x) W z, sndE (G.ob x) (DACc.ty x) W z, j].res,
      \ x V W g z j -> L16.LN2[L16.WfML, L16.WresML, L16.WfaceLML, L16.WfaceRML, x].mwe-act V W g z j,
      \ y x f W g j -> L16.MWC[L16.WfML, L16.WresML, L16.WfaceLML, L16.WfaceRML, y, x, f, W, g, j].eq,
      L16.tauD, L16.mN2, gC, mC,
      \ x W z -> refl ((gC.mp x).mE W z), \ x W z -> refl ((mC.mp x).mE W z),
      \ x X z -> L16.E0[x, X, z].p0, \ x X z -> L16.E1[x, X, z].p1].el ;

  -- LEMMA 16, uniform: tau_{D-bar A} is an equivalence
  desc2 : UTriv (LO.ExtC G B2c) (P13.HP[G, DACc, B2c, gC].PC) =
   IV.Zig[G, Xs, Ys, fC, mC, gC].inv Hq Hp (DS.desc1 G A c) ;
 } ;

 ------------------------------------------------------------------
 -- THEOREM 29 (T = id): D-bar is a descent data operation
 PDesc : DT.DescentOp =
  new DT.DescentOp[DT.Dbar, DT.Dbar-sub, DT.Dbar-fib, DT.eta, DS.Dm, DS.desc1, \ G A c -> L16I[G, A, c].desc2] ;
} ;
