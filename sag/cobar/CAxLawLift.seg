-- A stagewise addition law gives an internal path over every context.
-- This only transfers the law; the law for the concrete cobar operation
-- must be proved separately.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module AddAssoc (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (addV mulV : (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X)
 (addN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
    -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (addV I u v)) (addV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
 (mulN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
    -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (mulV I u v)) (mulV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
 (cV : R.R -> (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X)
 (cN : (r : R.R) (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I)
    -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (cV r I)) (cV r J))
 (law : (X : CAxEv[a].EvG[R, encK, pe].Ob) (u v w : CAxEv[a].EvG[R, encK, pe].GV X)
    -> Id (CAxEv[a].EvG[R, encK, pe].GV X)
       (addV X (addV X u v) w) (addV X u (addV X v w))) {
 module E = CAxElOps[a].ElOps[R, encK, pe, addV, mulV, addN, mulN, cV, cN] ;
 module IN = CwFInt.Int[a++, E.C, E.PW.G1.fibPi-T, E.PW.G1.fibSig-T, E.PW.G1.fibId-T] ;
 C : CwF.CwF[a++] = E.C ;
 add (G : C.Ctx) (x y : C.El G (E.GA G)) : C.El G (E.GA G) = E.AE.opE G x y ;
 assocEq (G : C.Ctx) (x y z : C.El G (E.GA G))
  : Id (C.El G (E.GA G)) (add G (add G x y) z) (add G x (add G y z)) =
  E.PS.el-ext G (E.GA G).1 (add G (add G x y) z) (add G x (add G y z))
    (\ X w -> law X (x.eob X w) (y.eob X w) (z.eob X w)) ;
 assoc (G : C.Ctx) (x y z : C.El G (E.GA G))
  : C.El G (E.PW.G1.fibId-T.IdT G (E.GA G) (add G (add G x y) z) (add G x (add G y z))) =
  IN.idOfEq G (E.GA G) (add G (add G x y) z) (add G x (add G y z)) (assocEq G x y z) ;
} ;
