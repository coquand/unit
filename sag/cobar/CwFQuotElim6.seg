-- CwFQuotElim6.seg (canonicity-c2; SIMPLIFIED.md item 3, for
-- canonicity-45): elimination into propositions over nil.H.Qt for a
-- closed type H (elimPH), and extensionality on classes there (ext1H).
-- By exchange: nil.Qt.H and nil.H.Qt are isomorphic (ex , ex'), so
-- P' = Pi (d : H) P(d , q) over nil.Qt, eliminated by elimP1 at the
-- classes (the lifted Sec1 of a class is the insertion of it, pointwise,
-- CwFQuotElim5.ntU), and read back through ex'.
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PPp = CwFPropProp.PropProp[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv, FibNF[a, a+].nf] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module QE6 (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
 module Q5 = CwFQuotElim5[a].QE5[R, encK, x, pe] ;
 module AX = Q1.AX ;
 module GQ = Q1.GQ ;
 module LM = AX.RP.LM ;
 Nl : C.Ctx = C.nil ;
 Qt : C.Ty Nl = AX.Qt ;
 module EPH (H : C.Ty Nl) {
  GH : C.Ctx = C.ext Nl H ;
  QH : C.Ty GH = OV.wkT Nl H Qt ;
  GHQ : C.Ctx = C.ext GH QH ;
  Hw : C.Ty GQ.G1 = OV.wkT Nl Qt H ;
  GQH : C.Ctx = C.ext GQ.G1 Hw ;
  ex : C.Sub GQH GHQ = new L.PSub[GQH, GHQ, \ K w -> ((w.1.1, w.2), w.1.2), \ L0 K g w -> refl (((GQH.act L0 K g w).1.1, (GQH.act L0 K g w).2), (GQH.act L0 K g w).1.2)] ;
  ex' : C.Sub GHQ GQH = new L.PSub[GHQ, GQH, \ K w -> ((w.1.1, w.2), w.1.2), \ L0 K g w -> refl (((GHQ.act L0 K g w).1.1, (GHQ.act L0 K g w).2), (GHQ.act L0 K g w).1.2)] ;
  exex : Id (C.Sub GHQ GHQ) (C.o GHQ GQH GHQ ex ex') (C.id GHQ) = L.sub-ext GHQ GHQ (C.o GHQ GQH GHQ ex ex') (C.id GHQ) (\ K w -> refl w) ;
  -- the insertion of a class c as the last variable
  module Ins (c : C.El Nl Qt) {
   nt (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (GHQ.ob K) = (w, c.eob K w.1) ;
   nat (L0 K : Ob) (g : Hom L0 K) (w : V1.Ix (GH.ob K)) : Id (V1.Ix (GHQ.ob L0)) (nt L0 (GH.act L0 K g w)) (GHQ.act L0 K g (nt K w)) =
    apH {V1.Ix (Qt.1.tob L0 (Nl.act L0 K g w.1))} {V1.Ix (GHQ.ob L0)} (\ z -> (GH.act L0 K g w, z))
      (symH (c.enat L0 K g w.1 (Nl.act L0 K g w.1) (refl (Nl.act L0 K g w.1)))) ;
   ins : C.Sub GH GHQ = new L.PSub[GH, GHQ, nt, nat] ;
   s1 : C.Sub Nl GQ.G1 = GQ.Sec1[c].sec1 ;
   e1 : Id (C.Sub Nl Nl) (C.o Nl GQ.G1 Nl (C.p Nl Qt) s1) (C.id Nl) = L.sub-ext Nl Nl (C.o Nl GQ.G1 Nl (C.p Nl Qt) s1) (C.id Nl) (\ K o -> refl o) ;
   PA : Id (C.Ty Nl) (C.subT Nl GQ.G1 Hw s1) H =
    transH (symH (C.subT-o Nl GQ.G1 Nl H (C.p Nl Qt) s1))
      (transH (apH {C.Sub Nl Nl} {C.Ty Nl} (\ s -> C.subT Nl Nl H s) e1) (C.subT-id Nl H)) ;
   up : C.Sub GH GQH = OV.upT Nl GQ.G1 Hw s1 H PA ;
   E : Id (C.Sub GH GHQ) (C.o GH GQH GHQ ex up) ins =
    L.sub-ext GH GHQ (C.o GH GQH GHQ ex up) ins
      (\ K w -> transH (apH {V1.Ix (GQH.ob K)} {V1.Ix (GHQ.ob K)} (\ v -> ex.nt K v) (CwFQuotElim5[a].ntU Nl GQ.G1 Hw s1 H PA K w.1 w.2))
         (apH {V1.Ix (H.1.tob K w.1)} {V1.Ix (GHQ.ob K)} (\ z -> ((w.1, z), c.eob K w.1))
            (LM.same-fib Nl K w.1 H (C.subT Nl GQ.G1 Hw s1) (symH PA) w.2 (refl (H.1.tob K w.1))))) ;
   eS : Id (C.Sub GH GHQ) (C.sec GH QH (OV.wkE Nl H Qt c)) ins = L.sub-ext GH GHQ (C.sec GH QH (OV.wkE Nl H Qt c)) ins (\ K w -> refl (w, c.eob K w.1)) ;
  } ;
  module EP (P : C.Ty GHQ) (pPr : C.El GHQ (PU.isProp GHQ P))
    (h : (t : AX.Term) -> C.El GH (C.subT GH GHQ P (C.sec GH QH (OV.wkE Nl H Qt (AX.cls t))))) {
   Pex : C.Ty GQH = C.subT GQH GHQ P ex ;
   P' : C.Ty GQ.G1 = FibCwF[a, a+].fibPi.Pi GQ.G1 Hw Pex ;
   pP' : C.El GQ.G1 (PU.isProp GQ.G1 P') = PPp.piProp GQ.G1 Hw Pex (Q5.pOv GQH GHQ P ex pPr) ;
   module T (t : AX.Term) {
    module J = Ins[AX.cls t] ;
    PI : C.Ty GH = C.subT GH GHQ P J.ins ;
    PBi : Id (C.Ty GH) (C.subT GH GQH Pex J.up) PI =
     transH (symH (C.subT-o GH GQH GHQ P ex J.up)) (apH {C.Sub GH GHQ} {C.Ty GH} (\ u -> C.subT GH GHQ P u) J.E) ;
    PP : Id (C.Ty Nl) (C.subT Nl GQ.G1 P' J.s1) (FibCwF[a, a+].fibPi.Pi Nl H PI) = OV.Pi-ov Nl GQ.G1 Hw Pex J.s1 H J.PA PI PBi ;
    hh : C.El GH PI =
     OV.trE GH (C.subT GH GHQ P (C.sec GH QH (OV.wkE Nl H Qt (AX.cls t)))) PI (apH {C.Sub GH GHQ} {C.Ty GH} (\ s -> C.subT GH GHQ P s) J.eS) (h t) ;
    h' : C.El Nl (C.subT Nl GQ.G1 P' J.s1) = OV.trE Nl (FibCwF[a, a+].fibPi.Pi Nl H PI) (C.subT Nl GQ.G1 P' J.s1) (symH PP) (OV.lam Nl H PI hh) ;
   } ;
   k : C.El GQ.G1 P' = Q1.elimP1 P' pP' (\ t -> T[t].h') ;
   kb : C.El GQH Pex = OV.bod GQ.G1 Hw Pex k ;
   PR : Id (C.Ty GHQ) (C.subT GHQ GQH Pex ex') P =
    transH (symH (C.subT-o GHQ GQH GHQ P ex ex'))
      (transH (apH {C.Sub GHQ GHQ} {C.Ty GHQ} (\ s -> C.subT GHQ GHQ P s) exex) (C.subT-id GHQ P)) ;
   res : C.El GHQ P = OV.trE GHQ (C.subT GHQ GQH Pex ex') P PR (C.subt GHQ GQH Pex kb ex') ;
  } ;
 } ;
 elimPH (H : C.Ty Nl) (P : C.Ty EPH[H].GHQ) (pPr : C.El EPH[H].GHQ (PU.isProp EPH[H].GHQ P))
   (h : (t : AX.Term) -> C.El EPH[H].GH (C.subT EPH[H].GH EPH[H].GHQ P (C.sec EPH[H].GH EPH[H].QH (OV.wkE Nl H Qt (AX.cls t)))))
   : C.El EPH[H].GHQ P = EPH[H].EP[P, pPr, h].res ;
 -- extensionality on classes over nil.H
 module X1H (H B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy) (f g : C.El EPH[H].GH (OV.Fun EPH[H].GH EPH[H].QH (OV.wkT Nl H B)))
   (h : (t : AX.Term) -> C.El EPH[H].GH (IJ.IdT EPH[H].GH (OV.wkT Nl H B)
          (OV.app EPH[H].GH EPH[H].QH (OV.wkT Nl H B) f (OV.wkE Nl H Qt (AX.cls t))) (OV.app EPH[H].GH EPH[H].QH (OV.wkT Nl H B) g (OV.wkE Nl H Qt (AX.cls t))))) {
  module M = EPH[H] ;
  BH : C.Ty M.GH = OV.wkT Nl H B ;
  WB : C.Ty M.GHQ = OV.wkT M.GH M.QH BH ;
  Pw : C.Ty M.GHQ = IJ.IdT M.GHQ WB (OV.bod M.GH M.QH WB f) (OV.bod M.GH M.QH WB g) ;
  sE : C.Sub M.GHQ Nl = C.o M.GHQ M.GH Nl (C.p Nl H) (C.p M.GH M.QH) ;
  PWB : Id (C.Ty M.GHQ) (C.subT M.GHQ Nl B sE) WB = C.subT-o M.GHQ M.GH Nl B (C.p Nl H) (C.p M.GH M.QH) ;
  pPw : C.El M.GHQ (PU.isProp M.GHQ Pw) =
   idJ (C.Ty M.GHQ) (C.subT M.GHQ Nl B sE)
     (\ Y2 P2 -> (u v : C.El M.GHQ Y2) -> C.El M.GHQ (PU.isProp M.GHQ (IJ.IdT M.GHQ Y2 u v)))
     (\ u v -> CwFFunSetB[a].SetB[B, sB].idPB M.GHQ sE u v) WB PWB (OV.bod M.GH M.QH WB f) (OV.bod M.GH M.QH WB g) ;
  module T (t : AX.Term) {
   ct : C.El M.GH M.QH = OV.wkE Nl H Qt (AX.cls t) ;
   PI : Id (C.Ty M.GH) (C.subT M.GH M.GHQ Pw (C.sec M.GH M.QH ct)) (IJ.IdT M.GH BH (OV.app M.GH M.QH BH f ct) (OV.app M.GH M.QH BH g ct)) =
    OV.Id-ov M.GH M.GHQ WB (OV.bod M.GH M.QH WB f) (OV.bod M.GH M.QH WB g) (C.sec M.GH M.QH ct) BH
      (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst M.GH M.QH BH ct) (OV.app M.GH M.QH BH f ct) (OV.app M.GH M.QH BH g ct)
      (refl (OV.app M.GH M.QH BH f ct)) (refl (OV.app M.GH M.QH BH g ct)) ;
   hh : C.El M.GH (C.subT M.GH M.GHQ Pw (C.sec M.GH M.QH ct)) =
    OV.trE M.GH (IJ.IdT M.GH BH (OV.app M.GH M.QH BH f ct) (OV.app M.GH M.QH BH g ct)) (C.subT M.GH M.GHQ Pw (C.sec M.GH M.QH ct)) (symH PI) (h t) ;
  } ;
  pw : C.El M.GHQ Pw = elimPH H Pw pPw (\ t -> T[t].hh) ;
  res : C.El M.GH (IJ.IdT M.GH (OV.Fun M.GH M.QH BH) f g) = FibNF[a, a+].nf M.GH M.QH WB f g (OV.lam M.GH M.QH Pw pw) ;
 } ;
 ext1H (H B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy) (f g : C.El EPH[H].GH (OV.Fun EPH[H].GH EPH[H].QH (OV.wkT Nl H B)))
   (h : (t : AX.Term) -> C.El EPH[H].GH (IJ.IdT EPH[H].GH (OV.wkT Nl H B)
          (OV.app EPH[H].GH EPH[H].QH (OV.wkT Nl H B) f (OV.wkE Nl H Qt (AX.cls t))) (OV.app EPH[H].GH EPH[H].QH (OV.wkT Nl H B) g (OV.wkE Nl H Qt (AX.cls t)))))
   : C.El EPH[H].GH (IJ.IdT EPH[H].GH (OV.Fun EPH[H].GH EPH[H].QH (OV.wkT Nl H B)) f g) = X1H[H, B, sB, f, g, h].res ;
} ;
