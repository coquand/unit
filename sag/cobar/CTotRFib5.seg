-- CTotRFib5.seg (canonicity-c2; SIMPLIFIED.md item 5): the composite of
-- a partial line of R B as an element of R B at the other end: the
-- family of the components of CTotRFib4, read at the points (coeT along
-- pth), is natural (coeNat on KT.coreT).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RFib5 (C : CIntCat[a, vl].IC) {
 module R4 = CTotRFib4[a, vl, l].RFib4[C] ;
 module TR = R4.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;

 module Ko (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (e e' : G1.GB.IPt)
   (c0 : G0.GB.CLine[l].Lines[RS.rC G, B].CompK[e, e'].Comp) {
  module CP = R4.Cp[G, B, e, e', c0] ;
  module PR = CP.PR ;
  module CT = CP.CT ;
  module L9 = CP.L9 ;
  module RT = CT.RT ;
  module EK1 = CP.EK1 ;
  module EK0 = CP.EK0 ;
  module CTp = R4.R3.RF.CT[G, B, e'] ;
  UG : P0.PCtx = CP.UG ;
  K1 : P1.PCtx = CP.K1 ;
  module TL0 = G0.GB.GPre[l].TyL[UG, B] ;
  Tot0 (Y : Ob0) : U l = CP.Tot0 Y ;
  Pt0 (Y : Ob0) : U l = W0.Ix (UG.ob Y) ;

  -- the action of B on transported elements, from an equality of totals
  tact-coe (Z Y : Ob0) (h : RN.Hom0 Z Y) (pa : Pt0 Y) (y y' : Pt0 Z) (e1 : Id (Pt0 Z) (UG.act Z Y h pa) y) (e2 : Id (Pt0 Z) y y')
   (a0 : W0.Ix (B.tob Y pa))
   : Id (W0.Ix (B.tob Z y')) (TL0.coeT Z y y' e2 (B.tact Z Y h pa y e1 a0)) (B.tact Z Y h pa y' (transH e1 e2) a0) =
   idJ (Pt0 Z) y (\ y2 e3 -> Id (W0.Ix (B.tob Z y2)) (TL0.coeT Z y y2 e3 (B.tact Z Y h pa y e1 a0)) (B.tact Z Y h pa y2 (transH e1 e3) a0))
    (P0.tact-irr UG B Z Y h pa y e1 (transH e1 (refl y)) a0) y' e2 ;
  coeNat (Z Y : Ob0) (h : RN.Hom0 Z Y) (pa : Pt0 Y) (qa : Pt0 Z) (a0 : W0.Ix (B.tob Y pa)) (a1 : W0.Ix (B.tob Z qa))
   (Q : Id (Tot0 Z) (L9.E0.act Z Y h (P0.pairE UG B Y pa a0)) (P0.pairE UG B Z qa a1))
   (p : Pt0 Y) (q : Pt0 Z) (pp : Id (Pt0 Y) pa p) (pq : Id (Pt0 Z) qa q) (e2 : Id (Pt0 Z) (UG.act Z Y h p) q)
   : Id (W0.Ix (B.tob Z q)) (B.tact Z Y h p q e2 (TL0.coeT Y pa p pp a0)) (TL0.coeT Z qa q pq a1) =
   idJ (Pt0 Y) pa
    (\ p2 pp2 -> (q2 : Pt0 Z) (pq2 : Id (Pt0 Z) qa q2) (e3 : Id (Pt0 Z) (UG.act Z Y h p2) q2)
        -> Id (W0.Ix (B.tob Z q2)) (B.tact Z Y h p2 q2 e3 (TL0.coeT Y pa p2 pp2 a0)) (TL0.coeT Z qa q2 pq2 a1))
    (\ q2 pq2 ->
       idJ (Pt0 Z) qa
        (\ q3 pq3 -> (e3 : Id (Pt0 Z) (UG.act Z Y h pa) q3) -> Id (W0.Ix (B.tob Z q3)) (B.tact Z Y h pa q3 e3 a0) (TL0.coeT Z qa q3 pq3 a1))
        (\ e3 -> trans (W0.Ix (B.tob Z qa)) (B.tact Z Y h pa qa e3 a0)
                   (TL0.coeT Z (UG.act Z Y h pa) qa e3 (B.tact Z Y h pa (UG.act Z Y h pa) (refl (UG.act Z Y h pa)) a0)) a1
                   (trans (W0.Ix (B.tob Z qa)) (B.tact Z Y h pa qa e3 a0)
                      (B.tact Z Y h pa qa (transH (refl (UG.act Z Y h pa)) e3) a0)
                      (TL0.coeT Z (UG.act Z Y h pa) qa e3 (B.tact Z Y h pa (UG.act Z Y h pa) (refl (UG.act Z Y h pa)) a0))
                      (P0.tact-irr UG B Z Y h pa qa e3 (transH (refl (UG.act Z Y h pa)) e3) a0)
                      (sym (W0.Ix (B.tob Z qa)) (TL0.coeT Z (UG.act Z Y h pa) qa e3 (B.tact Z Y h pa (UG.act Z Y h pa) (refl (UG.act Z Y h pa)) a0))
                         (B.tact Z Y h pa qa (transH (refl (UG.act Z Y h pa)) e3) a0)
                         (tact-coe Z Y h pa (UG.act Z Y h pa) qa (refl (UG.act Z Y h pa)) e3 a0)))
                   (TL0.pr-eq Z (UG.act Z Y h pa) qa e3 (B.tact Z Y h pa (UG.act Z Y h pa) (refl (UG.act Z Y h pa)) a0) a1 Q))
        q2 pq2)
    p pp q pq e2 ;

  -- the point of R B at the other end, and the point of the component
  gE (X : Ob1) (z : EK1.TV.EI X) : W0.Ix (G.ob X) = (CT.RH.F1.ev e').nt X (EK1.TV.pr1 X z) ;
  pth0 (X : Ob1) (z : EK1.TV.EI X) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X)
   : Id (Pt0 Y) (CP.p0 Y (PR.zc X z Y m)) (RT.at X (gE X z) Y m) =
   transH (CTp.e01 Y (CT.RH.F1.actF (RN.o Y) X m (EK1.TV.pr1 X z)))
    ((CT.RH.F1.ev e').nt-nat (RN.o Y) X m (EK1.TV.pr1 X z)) ;
  pth (X : Ob1) (z : EK1.TV.EI X) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) (p : Pt0 Y) (eq : Id (Pt0 Y) p (RT.at X (gE X z) Y m))
   : Id (Pt0 Y) (CP.p0 Y (PR.zc X z Y m)) p = transH (pth0 X z Y m) (symH eq) ;
  -- the family of the components, and its naturality
  kfam (X : Ob1) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) : RT.Fam X (gE X z) =
   \ Y m p eq -> TL0.coeT Y (CP.p0 Y (PR.zc X z Y m)) p (pth X z Y m p eq) (CP.kv X z s Y m) ;
  knat (X : Ob1) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) : RT.NatTy X (gE X z) (kfam X z s) =
   \ Z Y h m p eq q e1 e2 ->
    coeNat Z Y h (CP.p0 Y (PR.zc X z Y m)) (CP.p0 Z (PR.zc X z Z (L9.mh X Y m Z h)))
     (CP.kv X z s Y m) (CP.kv X z s Z (L9.mh X Y m Z h)) CP.KT[X, z, s, Z, Y, h, m].coreT
     p q (pth X z Y m p eq) (pth X z Z (L9.mh X Y m Z h) q e1) e2 ;
  -- the composite, an element of R B at the other end of the line
  kop (X : Ob1) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) : RT.T X (gE X z) = RT.mk X (gE X z) (kfam X z s) (knat X z s) ;
 } ;
} ;
