-- CRhoTel2.seg (canonicity-45; COBAR.md "Prop 58"): rho's Id component for an
-- equation q of u in c2's EqT at the telescope point (endpoints rewritten by
-- the readings of CRhoPt / CRhoTel, then IdT-nat).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RT2 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module T = CRhoTel[a].RT[R, encK, pe, y, u] ;
 module RP = T.RP ;
 module SO = T.SO ;
 module EG = T.EG ;
 C : CwF.CwF[a++] = T.C ;
 K : C.Ctx = T.K ;
 -- CCmpU14.rwId at G1
 rwId (G : C.Ctx) (Ty : C.Ty G) (x x' y' y'' : C.El G Ty)
  (px : (Kk : EG.Ob) (w : V1.Ix (G.ob Kk)) -> Id (V1.Ix (Ty.1.tob Kk w)) (x.eob Kk w) (x'.eob Kk w))
  (py : (Kk : EG.Ob) (w : V1.Ix (G.ob Kk)) -> Id (V1.Ix (Ty.1.tob Kk w)) (y'.eob Kk w) (y''.eob Kk w))
  (p : C.El G (T.IJG.IdT G Ty x y')) : C.El G (T.IJG.IdT G Ty x' y'') =
  subst (C.El G Ty) (\ w -> C.El G (T.IJG.IdT G Ty x' w)) y' y'' (T.G1.GB.GPre[a+].PS.el-ext G Ty.1 y' y'' py)
   (subst (C.El G Ty) (\ w -> C.El G (T.IJG.IdT G Ty w y')) x x' (T.G1.GB.GPre[a+].PS.el-ext G Ty.1 x x' px) p) ;
 module Cmp (Lq : SX.Over[R].Equations SO.TW.Var) (sg : C.Sub K (SO.HS Lq).1)
   (q : T.TmU) (d : SX.Over[R].Der[T.yu].Proof q SX.Over[R].Der[T.yu].zeroE)
   (pf : (X : EG.Ob) (z : V1.Ix (K.ob X)) -> Id (V1.Ix (SO.Xc.ob X)) ((SO.HS Lq).2.nt X (sg.nt X z)) (RP.sgN X z)) {
  module H = T.HStep[Lq, sg] ;
  module Q = H.Eq[q, d, pf] ;
  E : C.Ctx = H.E ;
  -- the left endpoint: G's evaluation of q at rho's inputs, read three ways
  px (X : EG.Ob) (z : V1.Ix (K.ob X)) : Id (V1.Ix (Q.Ty2.1.tob X z)) ((T.OVG.trE K Q.EQ.HI.YY Q.Ty2 Q.P2 Q.EQ.HI.a0).eob X z) (Q.A'.eob X z) =
   transH (transH (T.trERd K Q.EQ.HI.YY Q.Ty2 Q.P2 Q.EQ.HI.a0 X z) (T.sameRd K Q.EQ.HI.YY Q.Ty2 Q.P2 X z (refl (Q.Ty2.1.tob X z)) (Q.EQ.HI.a0.eob X z)))
    (transH (apH {Top} {V1.Ix (Q.Ty2.1.tob X z)} (\ o -> (RP.RI.E.Lg RP.RI.gIn q).nfun X o z.2) (isTop z.1 tt))
      (symH (transH (T.gsubRd E H.sD (SO.TW.evE (T.rn q)) X (H.sg.nt X z))
        (transH (apH {V1.Ix (SO.Xc.ob X)} {V1.Ix (Q.Ty2.1.tob X z)} (SO.TW.ev (T.rn q) X) (pf X z))
          (RP.evEq X z.2 q))))) ;
  -- the right endpoint: G's zero both ways
  py (X : EG.Ob) (z : V1.Ix (K.ob X)) : Id (V1.Ix (Q.Ty2.1.tob X z)) ((T.OVG.trE K Q.EQ.HI.YY Q.Ty2 Q.P2 Q.EQ.HI.b0).eob X z) (Q.B'.eob X z) =
   transH (transH (T.trERd K Q.EQ.HI.YY Q.Ty2 Q.P2 Q.EQ.HI.b0 X z) (T.sameRd K Q.EQ.HI.YY Q.Ty2 Q.P2 X z (refl (Q.Ty2.1.tob X z)) (Q.EQ.HI.b0.eob X z)))
    (symH (T.gsubRd E H.sD SO.zE X (H.sg.nt X z))) ;
  e2 : C.El K (T.IJG.IdT K Q.Ty2 Q.A' Q.B') =
   rwId K Q.Ty2 (T.OVG.trE K Q.EQ.HI.YY Q.Ty2 Q.P2 Q.EQ.HI.a0) Q.A' (T.OVG.trE K Q.EQ.HI.YY Q.Ty2 Q.P2 Q.EQ.HI.b0) Q.B' px py Q.e1 ;
  -- in c2's EqT at the telescope point
  EqTy : C.Ty E = SO.EqT E H.sD (T.rn q) ;
  hq : C.El K (C.subT K E EqTy H.sg) =
   T.OVG.trE K (T.IJG.IdT K Q.Ty2 Q.A' Q.B') (C.subT K E EqTy H.sg)
    (symH (T.IJG.IdT-nat K E (SO.PW.Gat E) (SO.gsub E H.sD (SO.TW.evE (T.rn q))) (SO.gsub E H.sD SO.zE) H.sg)) e2 ;
 } ;
} ;
