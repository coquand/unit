-- CwFHed3.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit for the
-- quotient's set-ness): for a loop c : Id(x , x), the map
-- chi_t : Id(x , t) -> Id(x , t), w |-> kap (t , w , x , c) (CwFHed2.K), and
-- chi_x (c) = refl, internally: at (t , w) = (x , c) the point of kap is
-- the diagonal's (E2), where kap is refl (CwFHed2's Lk).
open Base ;

module Hed3 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;
  module H2 = CwFHed2.Hed2[l, C, PS, SS, IJ] ;

  module Chi (G : Ctx) (A : Ty G) (x : El G A) (c : El G (IJ.IdT G A x x)) {
    module KK = H2.K[G, A, x] ;
    GA : Ctx = ext G A ;
    IK : Ty GA = KK.IK ;
    H : Ctx = KK.H ;
    A' : Ty H = KK.A' ;
    x' : El H A' = KK.x' ;
    t' : El H A' = KK.t' ;
    IK' : Ty (ext H A') = KK.IK' ;
    Dx' : Ctx = KK.Dx' ;
    HA : Ctx = ext H A' ;
    Ixx : Ty G = IJ.IdT G A x x ;
    Ixx' : Ty H = IJ.IdT H A' x' x' ;
    Ixt : Ty H = KK.Ixt ;
    -- the point sg = (x , c) of H
    sg : Sub G H = TR.ptY G A x x c ;
    PKx : Id (Ty G) (subT G GA IK (sec G A x)) Ixx = JP.IKpt G A x x ;
    PAs : Id (Ty G) (subT G H A' sg) A = JP.wwT-inst G A IK x Ixx PKx c A ;
    ts : Ov G H A' sg A PAs t' x = JP.zv-inst G A IK x Ixx PKx c PAs ;
    xs : Ov G H A' sg A PAs x' x = JP.wwE-inst G A IK x Ixx PKx c A x PAs ;
    PW1 : Id (Ty H) (subT H HA (wkT H A' A') (sec H A' t')) A' = p-sec-T H A' A' t' ;
    PW2 : Id (Ty H) (subT H HA (wkT H A' A') (sec H A' x')) A' = p-sec-T H A' A' x' ;
    st : Sub G HA = o G H HA (sec H A' t') sg ;
    sx : Sub G HA = o G H HA (sec H A' x') sg ;
    pSec (y' : El H A') : Id (Sub G H) (o G HA H (p H A') (o G H HA (sec H A' y') sg)) sg =
      trans (Sub G H) (o G HA H (p H A') (o G H HA (sec H A' y') sg)) (o G H H (o H HA H (p H A') (sec H A' y')) sg) sg
        (sym (Sub G H) (o G H H (o H HA H (p H A') (sec H A' y')) sg) (o G HA H (p H A') (o G H HA (sec H A' y') sg)) (o-assoc G H HA H (p H A') (sec H A' y') sg))
        (trans (Sub G H) (o G H H (o H HA H (p H A') (sec H A' y')) sg) (o G H H (id H) sg) sg
           (ap (Sub H H) (Sub G H) (\ r -> o G H H r sg) (o H HA H (p H A') (sec H A' y')) (id H) (p-sec H A' y'))
           (o-idl G H sg)) ;
    eSec : Id (Sub G HA) sx st =
      IN.ext-eq G H A' sx st
        (trans (Sub G H) (o G HA H (p H A') sx) sg (o G HA H (p H A') st) (pSec x') (sym (Sub G H) (o G HA H (p H A') st) sg (pSec t')))
        A x
        (H2.comp3 G H HA (wkT H A' A') (sec H A' x') sg A' PW2 A PAs)
        (H2.ovC G H HA (wkT H A' A') (sec H A' x') sg A' PW2 A PAs (q H A') x' x (IN.q-secO H A' x' PW2) xs)
        (H2.comp3 G H HA (wkT H A' A') (sec H A' t') sg A' PW1 A PAs)
        (H2.ovC G H HA (wkT H A' A') (sec H A' t') sg A' PW1 A PAs (q H A') t' x (IN.q-secO H A' t' PW1) ts) ;
    -- c weakened to H, as an element of Id(x' , x')
    pA : Sub GA G = p G A ;
    pK : Sub H GA = p GA IK ;
    WA : Ty GA = wkT G A A ;
    xA : El GA WA = wkE G A A x ;
    W1 : Id (Ty GA) (subT GA G Ixx pA) (IJ.IdT GA WA xA xA) = Id-ov GA G A x x pA WA (refl WA) xA xA (refl xA) (refl xA) ;
    W2 : Id (Ty H) (subT H GA (IJ.IdT GA WA xA xA) pK) Ixx' = Id-ov H GA WA xA xA pK A' (refl A') x' x' (refl x') (refl x') ;
    WI2 : Id (Ty H) (JP.wwT G A IK Ixx) Ixx' =
      trans (Ty H) (JP.wwT G A IK Ixx) (subT H GA (IJ.IdT GA WA xA xA) pK) Ixx'
        (ap (Ty GA) (Ty H) (\ X -> subT H GA X pK) (subT GA G Ixx pA) (IJ.IdT GA WA xA xA) W1) W2 ;
    cc : El H Ixx' = trE H (JP.wwT G A IK Ixx) Ixx' WI2 (JP.wwE G A IK Ixx c) ;
    PBc : Id (Ty G) (subT G H (JP.wwT G A IK Ixx) sg) Ixx = JP.wwT-inst G A IK x Ixx PKx c Ixx ;
    PBc2 : Id (Ty G) (subT G H Ixx' sg) Ixx = Id-ov G H A' x' x' sg A PAs x x xs xs ;
    ccs : Ov G H Ixx' sg Ixx PBc2 cc c =
      ovTr G H (JP.wwT G A IK Ixx) Ixx' WI2 sg Ixx Ixx (refl Ixx) PBc PBc2 (JP.wwE G A IK Ixx c) c
        (JP.wwE-inst G A IK x Ixx PKx c Ixx c PBc) ;
    -- the point pt2 = (t , w , x , c) of Dx'
    pt2 : Sub H Dx' = JP.instG H A' IK' x' Ixx' (JP.IKpt H A' x' x') cc ;
    WI : Ty Dx' = wkT HA IK' IK' ;
    s1 : Sub G Dx' = o G H Dx' pt2 sg ;
    s2 : Sub G Dx' = o G H Dx' KK.diag sg ;
    QT2 : Id (Ty H) (subT H Dx' WI pt2) Ixx' = JP.qT-inst H A' IK' x' Ixx' (JP.IKpt H A' x' x') cc ;
    q1 : Ov G Dx' WI s1 Ixx (H2.comp3 G H Dx' WI pt2 sg Ixx' QT2 Ixx PBc2) (q HA IK') c =
      H2.ovC G H Dx' WI pt2 sg Ixx' QT2 Ixx PBc2 (q HA IK') cc c (JP.q-inst H A' IK' x' Ixx' (JP.IKpt H A' x' x') cc QT2) ccs ;
    PB3 : Id (Ty G) (subT G H Ixt sg) Ixx = Id-ov G H A' x' t' sg A PAs x x xs ts ;
    QTd : Id (Ty H) (subT H Dx' WI KK.diag) Ixt = KK.QTd ;
    q2 : Ov G Dx' WI s2 Ixx (H2.comp3 G H Dx' WI KK.diag sg Ixt QTd Ixx PB3) (q HA IK') c =
      H2.ovC G H Dx' WI KK.diag sg Ixt QTd Ixx PB3 (q HA IK') (JP.uv G A x) c
        (JP.q-inst H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x) QTd) (JP.uv-inst G A x x c PB3) ;
    pp1 : Id (Sub G HA) (o G Dx' HA (p HA IK') s1) sx =
      trans (Sub G HA) (o G Dx' HA (p HA IK') s1) (o G H HA (o H Dx' HA (p HA IK') pt2) sg) sx
        (sym (Sub G HA) (o G H HA (o H Dx' HA (p HA IK') pt2) sg) (o G Dx' HA (p HA IK') s1) (o-assoc G H Dx' HA (p HA IK') pt2 sg))
        (ap (Sub H HA) (Sub G HA) (\ r -> o G H HA r sg) (o H Dx' HA (p HA IK') pt2) (sec H A' x')
           (JP.p-inst H A' IK' x' Ixx' (JP.IKpt H A' x' x') cc)) ;
    pp2 : Id (Sub G HA) (o G Dx' HA (p HA IK') s2) st =
      trans (Sub G HA) (o G Dx' HA (p HA IK') s2) (o G H HA (o H Dx' HA (p HA IK') KK.diag) sg) st
        (sym (Sub G HA) (o G H HA (o H Dx' HA (p HA IK') KK.diag) sg) (o G Dx' HA (p HA IK') s2) (o-assoc G H Dx' HA (p HA IK') KK.diag sg))
        (ap (Sub H HA) (Sub G HA) (\ r -> o G H HA r sg) (o H Dx' HA (p HA IK') KK.diag) (sec H A' t')
           (JP.p-inst H A' IK' t' Ixt (JP.IKpt H A' x' t') (JP.uv G A x))) ;
    E2 : Id (Sub G Dx') s1 s2 =
      IN.ext-eq G HA IK' s1 s2
        (trans (Sub G HA) (o G Dx' HA (p HA IK') s1) sx (o G Dx' HA (p HA IK') s2)
           pp1 (trans (Sub G HA) sx st (o G Dx' HA (p HA IK') s2) eSec (sym (Sub G HA) (o G Dx' HA (p HA IK') s2) st pp2)))
        Ixx c
        (H2.comp3 G H Dx' WI pt2 sg Ixx' QT2 Ixx PBc2) q1
        (H2.comp3 G H Dx' WI KK.diag sg Ixt QTd Ixx PB3) q2 ;
    -- chi, a map Id(x , t) -> Id(x , t) over H
    PA2 : Id (Ty H) (subT H Dx' KK.AT pt2) A' = JP.wwT-inst H A' IK' x' Ixx' (JP.IKpt H A' x' x') cc A' ;
    Kp : Id (Ty H) (subT H Dx' KK.Kt pt2) Ixt =
      Id-ov H Dx' KK.AT KK.zz KK.tt pt2 A' PA2 x' t'
        (JP.zv-inst H A' IK' x' Ixx' (JP.IKpt H A' x' x') cc PA2)
        (JP.wwE-inst H A' IK' x' Ixx' (JP.IKpt H A' x' x') cc A' t' PA2) ;
    chi : El H Ixt = trE H (subT H Dx' KK.Kt pt2) Ixt Kp (subt H Dx' KK.Kt KK.kap pt2) ;
    -- chi at (x , c), read in Id(x , x), is kd there
    chiX : El G Ixx = trE G (subT G H Ixt sg) Ixx PB3 (subt G H Ixt chi sg) ;
    module LA = KK.LkAt[x, c] ;
    stA : Ov G Dx' KK.Kt s1 Ixx (H2.comp3 G H Dx' KK.Kt pt2 sg Ixt Kp Ixx PB3) KK.kap chiX =
      H2.ovC G H Dx' KK.Kt pt2 sg Ixt Kp Ixx PB3 KK.kap chi chiX (refl chi) (refl chiX) ;
    stB : Ov G Dx' KK.Kt s2 Ixx (H2.comp3 G H Dx' KK.Kt KK.diag sg KK.Itt KK.Kd Ixx LA.PIy) KK.kap LA.kdy =
      H2.ovC G H Dx' KK.Kt KK.diag sg KK.Itt KK.Kd Ixx LA.PIy KK.kap KK.kd LA.kdy (refl KK.kd) (refl LA.kdy) ;
    eqX : Id (El G Ixx) chiX LA.kdy =
      trans (El G Ixx) chiX (trE G (subT G Dx' KK.Kt s1) Ixx (H2.comp3 G H Dx' KK.Kt pt2 sg Ixt Kp Ixx PB3) (subt G Dx' KK.Kt KK.kap s1)) LA.kdy
        (sym (El G Ixx) (trE G (subT G Dx' KK.Kt s1) Ixx (H2.comp3 G H Dx' KK.Kt pt2 sg Ixt Kp Ixx PB3) (subt G Dx' KK.Kt KK.kap s1)) chiX stA)
        (trans (El G Ixx) (trE G (subT G Dx' KK.Kt s1) Ixx (H2.comp3 G H Dx' KK.Kt pt2 sg Ixt Kp Ixx PB3) (subt G Dx' KK.Kt KK.kap s1))
           (trE G (subT G Dx' KK.Kt s2) Ixx (H2.comp3 G H Dx' KK.Kt KK.diag sg KK.Itt KK.Kd Ixx LA.PIy) (subt G Dx' KK.Kt KK.kap s2)) LA.kdy
           (SJ.subtEq G Dx' KK.Kt KK.kap s1 s2 E2 Ixx (H2.comp3 G H Dx' KK.Kt pt2 sg Ixt Kp Ixx PB3) (H2.comp3 G H Dx' KK.Kt KK.diag sg KK.Itt KK.Kd Ixx LA.PIy))
           stB) ;
    -- chi_x (c) = refl, internally
    law : El G (IJ.IdT G Ixx chiX (IJ.rfl G A x)) =
      subst (El G Ixx) (\ w -> El G (IJ.IdT G Ixx w (IJ.rfl G A x))) LA.kdy chiX (sym (El G Ixx) chiX LA.kdy eqX) LA.law ;
  } ;
} ;
