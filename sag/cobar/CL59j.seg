-- CL59j.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part j: ev . inv ~ Psi', first leg.  At psi over W the value of
-- ev . inv is Gf at (W, y.u) of tau(psi) and (D rho)^-1 (tau e0), e0 the
-- A-element of rho at the identity of y.u; the path of g f ~ id of D rho's
-- quasi-inverse (CL59h) at the point bk(tau id), pushed through Gf, goes
-- to Psi'(psi) = Gf (tau psi) (tau id).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module H1 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module QHd = CL59h[a].QH[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module IVd = QHd.IVd ;
  module RM = QHd.RM ;
  module OY = RM.OY ;
  module CV = IVd.CV ;
  module QC = IVd.QC ;
  module DA0 = IVd.DA0 ;
  module Hyp (ef : TR.G0.GB.CEquiv[a+].EquivOp RM.PD.UG RM.PD.UA RM.PD.UB RM.PD.Uf)
   (mQ : G1.GB.CEquiv[a+].EquivOp CT.P1 Q.1 IVd.B2Q IVd.C15Q.tauM) {
   module HH = QHd.Hyp[ef, mQ] ;
   module HI = HH.HI ;
   module EQd = HH.EQd ;
   module P13 = HH.DI.P13 ;
   DG : TR.P1.PCtx = P13.DF.DG ;
   DAt : TR.P1.PTy[DG] = P13.DF.DA.DTy ;
   DBt : TR.P1.PTy[DG] = P13.DF.DB.DTy ;
   module HO1 = G1.GB.CHtpyOps[a+] ;
   module T = HO1.HT[DG, DAt, DAt, HO1.compN DG DAt DBt DAt EQd.PNa.nm EQd.EI.gN, HO1.idN DG DAt] ;
   K0 (W : Ob) : CT.TC.TOb = (W, LA.yu) ;
   n0 (W : Ob) : V1.Ix (LA.PYu.ob (K0 W)) = CM.CO.idM W LA.yu ;
   z (W : Ob) : V1.Ix (T.GA.ob (K0 W)) = OY.bk W LA.yu (CV.DYu.tau W LA.yu (n0 W)) ;
   lineD (W Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv) : CV.DYu.Ob' Vv LA.yu =
    OY.fw (Vv, LA.yu) (T.pv EQd.EI.eta (K0 W) (z W) (Vv, LA.yu) (QC.qm Vv W g) j) ;
   module TY = PB.GPre[a+].TyL[LA.Nl, DA0.QC] ;
   tv (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (psi : V1.Ix (DA0.qTob W tt)) (Vv : Ob) (g : Hom Vv W) (j : Hom Vv Iv) : TY.EI Vv =
    TY.pr Vv o (HI.Gf (Vv, LA.yu) (CV.DQc.tau Vv LA.yu (QC.qact Vv W g psi)) (lineD W Vv g j)) ;
   -- naturality of the line
   module TN (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (psi : V1.Ix (DA0.qTob W tt)) (Vb Va : Ob) (g2 : Hom Vb Va) (g : Hom Va W) (j : Hom Va Iv) {
    Ja : CT.TC.TOb = (Va, LA.yu) ;
    Kb : CT.TC.TOb = (Vb, LA.yu) ;
    wa : CV.DQc.Ob' Va LA.yu = CV.DQc.tau Va LA.yu (QC.qact Va W g psi) ;
    da : CV.DYu.Ob' Va LA.yu = lineD W Va g j ;
    module GNa = HI.GN[Ja, Kb, QC.qm Vb Va g2, wa, da] ;
    qEq : Id (V1.Ix (Q.1.tob Kb tt)) (QC.qact Vb Va g2 (QC.qact Va W g psi)) (QC.qact Vb W (compH Vb Va W g g2) psi) =
     symH (QC.Qc.act-o Vb Va W g g2 LA.yu LA.yu LA.yu (CM.IC.cart Va W g LA.yu) (CM.IC.cart Vb Va g2 LA.yu) psi) ;
    wEq : Id (CV.DQc.Ob' Vb LA.yu) GNa.w' (CV.DQc.tau Vb LA.yu (QC.qact Vb W (compH Vb Va W g g2) psi)) =
     transH (symH (CV.DQc.tau-nat Vb Va g2 LA.yu LA.yu (CM.IC.cart Vb Va g2 LA.yu) (QC.qact Va W g psi)))
      (apH {V1.Ix (Q.1.tob Kb tt)} {CV.DQc.Ob' Vb LA.yu} (CV.DQc.tau Vb LA.yu) qEq) ;
    pvA : V1.Ix (T.GA.ob Ja) = T.pv EQd.EI.eta (K0 W) (z W) Ja (QC.qm Va W g) j ;
    dEq : Id (CV.DYu.Ob' Vb LA.yu) GNa.d' (lineD W Vb (compH Vb Va W g g2) (compH Vb Va Iv j g2)) =
     transH (symH (OY.fwN Kb Ja (QC.qm Vb Va g2) pvA))
      (apH {V1.Ix (T.GA.ob Kb)} {CV.DYu.Ob' Vb LA.yu} (OY.fw Kb)
        (transH ((EQd.EI.eta.eob (K0 W) (z W)).1.2 Kb Ja (QC.qm Vb Va g2) (QC.qm Va W g) j)
          (apH {CT.TC.THm Kb (K0 W)} {V1.Ix (T.GA.ob Kb)} (\ k -> T.pv EQd.EI.eta (K0 W) (z W) Kb k (compH Vb Va Iv j g2)) (QC.cmpEq Vb Va W g g2)))) ;
    law : Id (TY.EI Vb) (TY.E.act Vb Va g2 (tv W o psi Va g j)) (tv W o psi Vb (compH Vb Va W g g2) (compH Vb Va Iv j g2)) =
     transH (TY.pr-tact Vb Va g2 o o (refl o) (HI.Gf Ja wa da))
      (apH {V1.Ix (Q.1.tob Kb tt)} {TY.EI Vb} (TY.pr Vb o)
        (transH (GNa.law (refl tt))
          (transH (apH {CV.DQc.Ob' Vb LA.yu} {V1.Ix (Q.1.tob Kb tt)} (\ w0 -> HI.Gf Kb w0 GNa.d') wEq)
            (apH {CV.DYu.Ob' Vb LA.yu} {V1.Ix (Q.1.tob Kb tt)} (HI.Gf Kb (CV.DQc.tau Vb LA.yu (QC.qact Vb W (compH Vb Va W g g2) psi))) dEq)))) ;
   } ;
   -- the start of the line: D rho at bk(tau id) is bk(tau e0), e0 = rho(id)
   aYu (W : Ob) : P13.DF.DA.TOb' W LA.yu (OY.d1 W LA.yu) = OY.Bk[W, LA.yu, CV.DYu.tau W LA.yu (n0 W)].res ;
   e0 (W : Ob) : V1.Ix (IVd.E.ob (K0 W)) = (DA0.ptW W, DA0.vW W) ;
   module TYB = G1.GB.GPre[a+].TyL[DG, DBt] ;
   module EB (W : Ob) {
    module DMa = P13.DF.DM[W, LA.yu, OY.d1 W LA.yu, aYu W] ;
    e0Eq : Id (V1.Ix (IVd.E.ob (K0 W))) (e0 W) (rho.nt (K0 W) (n0 W)) =
     symH (DA0.TAy.pr-coe (K0 W) (DA0.TAy.pr1 (K0 W) (DA0.rW W)) (DA0.ptW W) (DA0.eqPt W) (DA0.TAy.pr2 (K0 W) (DA0.rW W))) ;
    qh (q : P13.DF.DA.Idx W LA.yu) : CT.TC.THm (q.2.1, q.2.2.2.1) (K0 W) = (q.2.2.1, CV.DYu.tmap W LA.yu q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) ;
    rq (q : P13.DF.DA.Idx W LA.yu) (l : P13.DF.DA.LandsI W LA.yu q)
     : Id (V1.Ix (IVd.E.ob (q.2.1, q.2.2.2.1))) ((HI.DE.tau W LA.yu (e0 W)).1 q l) (rho.nt (q.2.1, q.2.2.2.1) ((CV.DYu.tau W LA.yu (n0 W)).1 q l)) =
     transH (apH {V1.Ix (IVd.E.ob (K0 W))} {V1.Ix (IVd.E.ob (q.2.1, q.2.2.2.1))} (IVd.E.act (q.2.1, q.2.2.2.1) (K0 W) (qh q)) e0Eq)
      (symH (rho.nt-nat (q.2.1, q.2.2.2.1) (K0 W) (qh q) (n0 W))) ;
    law : Id (P13.DF.DB.TOb' W LA.yu (OY.d1 W LA.yu)) (RM.OZ.Bk[W, LA.yu, HI.DE.tau W LA.yu (e0 W)].res) DMa.res =
     P13.DF.DB.tob-eq W LA.yu (OY.d1 W LA.yu) (RM.OZ.Bk[W, LA.yu, HI.DE.tau W LA.yu (e0 W)].res) DMa.res (\ q l ->
      P13.DF.DB.pr-inj q.2.1 q.2.2.2.1 ((OY.d1 W LA.yu).1 q l) ((HI.DE.tau W LA.yu (e0 W)).1 q l) (DMa.b q l)
       (transH (apH {V1.Ix (IVd.E.ob (q.2.1, q.2.2.2.1))} {P13.DF.DB.Ez q.2.1 q.2.2.2.1} (\ e -> ((OY.d1 W LA.yu).1 q l, e)) (rq q l))
          (symH (DMa.pc q l)))) ;
    eqA : Id (V1.Ix (DBt.tob (K0 W) (OY.d1 W LA.yu))) (RM.OZ.Bk[W, LA.yu, HI.DE.tau W LA.yu (e0 W)].res) (EQd.PNa.nf (K0 W) (OY.d1 W LA.yu) (aYu W)) =
     TYB.pr-inj (K0 W) (OY.d1 W LA.yu) (RM.OZ.Bk[W, LA.yu, HI.DE.tau W LA.yu (e0 W)].res) (EQd.PNa.nf (K0 W) (OY.d1 W LA.yu) (aYu W))
      (transH (apH {V1.Ix (DBt.tob (K0 W) (OY.d1 W LA.yu))} {TYB.EI (K0 W)} (TYB.pr (K0 W) (OY.d1 W LA.yu)) law)
        (symH (EQd.PNa.q (K0 W) (OY.d1 W LA.yu) (aYu W)))) ;
   } ;
   -- the two maps of closed types and Psi'
   module HO0 = PB.CHtpyOps[a+] ;
   evNM : HO0.NMap[LA.Nl, DA0.PiC, DA0.QC] =
    new HO0.NMap[LA.Nl, DA0.PiC, DA0.QC, \ W o phi -> DA0.evV W phi, \ J I h x x' e phi -> DA0.EvN[J, I, h].At[phi].law] ;
   invNM : HO0.NMap[LA.Nl, DA0.QC, DA0.PiC] =
    new HO0.NMap[LA.Nl, DA0.QC, DA0.PiC, \ W o psi -> HI.PI[W, psi].elt, \ J I h x x' e psi -> HI.WN[J, I, h, psi].law] ;
   compo : HO0.NMap[LA.Nl, DA0.QC, DA0.QC] = HO0.compN LA.Nl DA0.QC DA0.PiC DA0.QC invNM evNM ;
   wq (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) : CV.DQc.Ob' W LA.yu = CV.DQc.tau W LA.yu (QC.qact W W (idH W) psi) ;
   PsiV (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) : V1.Ix (Q.1.tob (K0 W) tt) = HI.Gf (K0 W) (wq W psi) (CV.DYu.tau W LA.yu (n0 W)) ;
   -- tau of the identity of y.u is natural
   tauN (J I : Ob) (h : Hom J I)
    : Id (CV.DYu.Ob' J LA.yu) (CV.DYu.act J I h LA.yu LA.yu (CM.IC.cart J I h LA.yu) (CV.DYu.tau I LA.yu (n0 I))) (CV.DYu.tau J LA.yu (n0 J)) =
    transH (symH (CV.DYu.tau-nat J I h LA.yu LA.yu (CM.IC.cart J I h LA.yu) (n0 I)))
     (apH {V1.Ix (LA.PYu.ob (K0 J))} {CV.DYu.Ob' J LA.yu} (CV.DYu.tau J LA.yu)
       (CM.MO.Fn[LA.yu, LA.yu].mExt J (LA.PYu.act (K0 J) (K0 I) (QC.qm J I h) (n0 I)) (n0 J) (refl (CM.MO.Fn[LA.yu, LA.yu].fpOf J (n0 J))))) ;
   qid (J I : Ob) (h : Hom J I) (psi : V1.Ix (DA0.qTob I tt))
    : Id (V1.Ix (Q.1.tob (K0 J) tt)) (QC.qact J I h (QC.qact I I (idH I) psi)) (QC.qact J J (idH J) (QC.qact J I h psi)) =
    transH (symH (QC.Qc.act-o J I I (idH I) h LA.yu LA.yu LA.yu (CM.IC.cart I I (idH I) LA.yu) (CM.IC.cart J I h LA.yu) psi))
     (transH (apH {Hom J I} {V1.Ix (Q.1.tob (K0 J) tt)} (\ k -> QC.qact J I k psi) (transH (comp-idl J I h) (symH (comp-idr J I h))))
       (QC.Qc.act-o J J I h (idH J) LA.yu LA.yu LA.yu (CM.IC.cart J I h LA.yu) (CM.IC.cart J J (idH J) LA.yu) psi)) ;
   module PsN (J I : Ob) (h : Hom J I) (psi : V1.Ix (DA0.qTob I tt)) {
    module GNp = HI.GN[K0 I, K0 J, QC.qm J I h, wq I psi, CV.DYu.tau I LA.yu (n0 I)] ;
    wEq : Id (CV.DQc.Ob' J LA.yu) GNp.w' (wq J (QC.qact J I h psi)) =
     transH (symH (CV.DQc.tau-nat J I h LA.yu LA.yu (CM.IC.cart J I h LA.yu) (QC.qact I I (idH I) psi)))
      (apH {V1.Ix (Q.1.tob (K0 J) tt)} {CV.DQc.Ob' J LA.yu} (CV.DQc.tau J LA.yu) (qid J I h psi)) ;
    law : Id (V1.Ix (Q.1.tob (K0 J) tt)) (QC.qact J I h (PsiV I psi)) (PsiV J (QC.qact J I h psi)) =
     transH (GNp.law (refl tt))
      (transH (apH {CV.DQc.Ob' J LA.yu} {V1.Ix (Q.1.tob (K0 J) tt)} (\ w0 -> HI.Gf (K0 J) w0 GNp.d') wEq)
        (apH {CV.DYu.Ob' J LA.yu} {V1.Ix (Q.1.tob (K0 J) tt)} (HI.Gf (K0 J) (wq J (QC.qact J I h psi))) (tauN J I h))) ;
   } ;
   PsiNM : HO0.NMap[LA.Nl, DA0.QC, DA0.QC] =
    new HO0.NMap[LA.Nl, DA0.QC, DA0.QC, \ W o psi -> PsiV W psi, \ J I h x x' e psi -> PsN[J, I, h, psi].law] ;
   -- the homotopy ev . inv ~ Psi'
   module HC = HO0.HT[LA.Nl, DA0.QC, DA0.QC, compo, PsiNM] ;
   dX0 (W : Ob) : Id (CV.DYu.Ob' W LA.yu) (lineD W W (idH W) (PB.ptH W PB.e0)) (HI.DI.invP.nt (K0 W) (HI.DE.tau W LA.yu (e0 W))) =
    apH {V1.Ix (T.GA.ob (K0 W))} {CV.DYu.Ob' W LA.yu} (OY.fw (K0 W))
     (transH ((EQd.EI.eta.eob (K0 W) (z W)).2.2.1)
       (apH {V1.Ix (DBt.tob (K0 W) (OY.d1 W LA.yu))} {V1.Ix (T.GA.ob (K0 W))} (\ a0 -> (OY.d1 W LA.yu, EQd.EI.gN.nfun (K0 W) (OY.d1 W LA.yu) a0)) (symH EB[W].eqA))) ;
   dX1 (W : Ob) : Id (CV.DYu.Ob' W LA.yu) (lineD W W (idH W) (PB.ptH W PB.e1)) (CV.DYu.tau W LA.yu (n0 W)) =
    transH (apH {V1.Ix (T.GA.ob (K0 W))} {CV.DYu.Ob' W LA.yu} (OY.fw (K0 W)) ((EQd.EI.eta.eob (K0 W) (z W)).2.2.2))
     (OY.fb W LA.yu (CV.DYu.tau W LA.yu (n0 W))) ;
   end0 (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (psi : V1.Ix (DA0.qTob W tt)) : Id (TY.EI W) (tv W o psi W (idH W) (PB.ptH W PB.e0)) (HC.aE W (o, psi)) =
    apH {V1.Ix (Q.1.tob (K0 W) tt)} {TY.EI W} (TY.pr W o) (apH {CV.DYu.Ob' W LA.yu} {V1.Ix (Q.1.tob (K0 W) tt)} (HI.Gf (K0 W) (wq W psi)) (dX0 W)) ;
   end1 (W : Ob) (o : V1.Ix (LA.Nl.ob W)) (psi : V1.Ix (DA0.qTob W tt)) : Id (TY.EI W) (tv W o psi W (idH W) (PB.ptH W PB.e1)) (HC.bE W (o, psi)) =
    apH {V1.Ix (Q.1.tob (K0 W) tt)} {TY.EI W} (TY.pr W o) (apH {CV.DYu.Ob' W LA.yu} {V1.Ix (Q.1.tob (K0 W) tt)} (HI.Gf (K0 W) (wq W psi)) (dX1 W)) ;
   path (W : Ob) (zz : V1.Ix (HC.GA.ob W)) : V1.Ix (HC.PT.tobP W zz) =
    HC.PT.mkPath W zz (\ Vv g j -> tv W (TY.pr1 W zz) (TY.pr2 W zz) Vv g j)
     (\ Vb Va g2 g j -> TN[W, TY.pr1 W zz, TY.pr2 W zz, Vb, Va, g2, g, j].law)
     (\ Vv g j -> refl (TY.pr1 W zz)) (end0 W (TY.pr1 W zz) (TY.pr2 W zz)) (end1 W (TY.pr1 W zz) (TY.pr2 W zz)) ;
   -- naturality of the paths in the point
   zNat (J I : Ob) (h : Hom J I) : Id (V1.Ix (T.GA.ob (K0 J))) (T.GA.act (K0 J) (K0 I) (QC.qm J I h) (z I)) (z J) =
    transH (symH (OY.bkS.nt-nat (K0 J) (K0 I) (QC.qm J I h) (CV.DYu.tau I LA.yu (n0 I))))
     (apH {CV.DYu.Ob' J LA.yu} {V1.Ix (T.GA.ob (K0 J))} (OY.bkS.nt (K0 J)) (tauN J I h)) ;
   module ENt (J I : Ob) (h : Hom J I) (o : V1.Ix (LA.Nl.ob I)) (psi : V1.Ix (DA0.qTob I tt)) (Vv : Ob) (f : Hom Vv J) (i : Hom Vv Iv) {
    wA : Id (CV.DQc.Ob' Vv LA.yu) (CV.DQc.tau Vv LA.yu (QC.qact Vv I (compH Vv J I h f) psi)) (CV.DQc.tau Vv LA.yu (QC.qact Vv J f (QC.qact J I h psi))) =
     apH {V1.Ix (Q.1.tob (Vv, LA.yu) tt)} {CV.DQc.Ob' Vv LA.yu} (CV.DQc.tau Vv LA.yu)
      (QC.Qc.act-o Vv J I h f LA.yu LA.yu LA.yu (CM.IC.cart J I h LA.yu) (CM.IC.cart Vv J f LA.yu) psi) ;
    dA : Id (CV.DYu.Ob' Vv LA.yu) (lineD I Vv (compH Vv J I h f) i) (lineD J Vv f i) =
     apH {V1.Ix (T.GA.ob (Vv, LA.yu))} {CV.DYu.Ob' Vv LA.yu} (OY.fw (Vv, LA.yu))
      (transH (apH {CT.TC.THm (Vv, LA.yu) (K0 I)} {V1.Ix (T.GA.ob (Vv, LA.yu))} (\ k -> T.pv EQd.EI.eta (K0 I) (z I) (Vv, LA.yu) k i) (symH (QC.cmpEq Vv J I h f)))
        (transH (T.pv-res EQd.EI.eta (K0 J) (K0 I) (QC.qm J I h) (z I) (T.GA.act (K0 J) (K0 I) (QC.qm J I h) (z I))
                   (refl (T.GA.act (K0 J) (K0 I) (QC.qm J I h) (z I))) (Vv, LA.yu) (QC.qm Vv J f) i)
          (apH {V1.Ix (T.GA.ob (K0 J))} {V1.Ix (T.GA.ob (Vv, LA.yu))} (\ z2 -> T.pv EQd.EI.eta (K0 J) z2 (Vv, LA.yu) (QC.qm Vv J f) i) (zNat J I h)))) ;
    law : Id (TY.EI Vv) (tv I o psi Vv (compH Vv J I h f) i) (tv J o (QC.qact J I h psi) Vv f i) =
     apH {V1.Ix (Q.1.tob (Vv, LA.yu) tt)} {TY.EI Vv} (TY.pr Vv o)
      (transH (apH {CV.DQc.Ob' Vv LA.yu} {V1.Ix (Q.1.tob (Vv, LA.yu) tt)} (\ w0 -> HI.Gf (Vv, LA.yu) w0 (lineD I Vv (compH Vv J I h f) i)) wA)
        (apH {CV.DYu.Ob' Vv LA.yu} {V1.Ix (Q.1.tob (Vv, LA.yu) tt)} (HI.Gf (Vv, LA.yu) (CV.DQc.tau Vv LA.yu (QC.qact Vv J f (QC.qact J I h psi)))) dA)) ;
   } ;
   enat (J I : Ob) (h : Hom J I) (zz : V1.Ix (HC.GA.ob I)) (zz' : V1.Ix (HC.GA.ob J)) (e : Id (V1.Ix (HC.GA.ob J)) (HC.GA.act J I h zz) zz')
    : Id (V1.Ix (HC.PT.tobP J zz')) (HC.PT.PathP.tact J I h zz zz' e (path I zz)) (path J zz') =
    HC.PT.path-eq J zz' (HC.PT.PathP.tact J I h zz zz' e (path I zz)) (path J zz') (\ Vv f i ->
     transH (ENt[J, I, h, TY.pr1 I zz, TY.pr2 I zz, Vv, f, i].law)
      (apH {V1.Ix (HC.GA.ob J)} {TY.EI Vv} (\ z2 -> tv J (TY.pr1 J z2) (TY.pr2 J z2) Vv f i) e)) ;
   -- ev . inv ~ Psi'
   h1a : L.PEl[HC.GA, HC.PT.PathP] = new L.PEl[HC.GA, HC.PT.PathP, path, enat] ;
  } ;
 } ;
} ;
