-- CPshL.seg (canonicity-45; COBAR.md, Lemma 12 fibrancy half, step (a)):
-- the line constructions of the base (CLine) as presheaves on C.
--   ExtC G A    the extension G.A as a CCtx (the action of A on totals)
--   LinC G      the lines of G at each object, acted on by FMap
--   LinA G A    the lines in A (FT.AI) over LinC G, acted on by A.tE on
--               values (tl-ext)
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;

module LOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 CO : U a = P.CO ;

 -- the extension of a C-context by a C-type
 ExtC (G : P.CCtx) (A : P.CTy[G]) : P.CCtx =
  new P.CCtx[\ x -> extP (G.ob x) (A.ty x), A.tE, A.tE-id, A.tE-o] ;

 -- the lines of a C-context
 LinC (G : P.CCtx) : P.CCtx =
  new P.CCtx[\ x -> CL.FC[G.ob x].GI, \ y x f -> CL.FMap[G.ob x, G.ob y, G.act y x f].map,
   \ x X ln -> CL.FC[G.ob x].fam-eq X (CL.FMap[G.ob x, G.ob x, G.act x x (P.cid x)].mapF X ln) ln
                 (\ W f i -> G.act-id x W (ln.1 W f i)),
   \ z y x f h X ln -> CL.FC[G.ob z].fam-eq X (CL.FMap[G.ob x, G.ob z, G.act z x (P.co z y x f h)].mapF X ln)
                 (CL.FMap[G.ob y, G.ob z, G.act z y h].mapF X (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X ln))
                 (\ W f' i -> G.act-o z y x f h W (ln.1 W f' i))] ;

 -- the lines in a C-type, over the lines of the context
 module LA (G : P.CCtx) (A : P.CTy[G]) {
  -- the action on totals: map the line in E_x by A.tE
  mapL (y x : CO) (f : P.CH y x) (X : Ob) (w : SigT CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI X)
   : SigT CL.FC[G.ob y].GI CL.FT[G.ob y, A.ty y].AI X =
   pairE CL.FC[G.ob y].GI CL.FT[G.ob y, A.ty y].AI X
    (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI X w))
    (CL.FMap[extP (G.ob x) (A.ty x), extP (G.ob y) (A.ty y), A.tE y x f].mapF X (CL.FT[G.ob x, A.ty x].lline X w),
     CL.FC[G.ob y].fam-eq X
      (CL.FT[G.ob y, A.ty y].piL X (CL.FMap[extP (G.ob x) (A.ty x), extP (G.ob y) (A.ty y), A.tE y x f].mapF X (CL.FT[G.ob x, A.ty x].lline X w)))
      (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI X w))
      (\ W g i -> transH (A.tE-pt y x f W ((CL.FT[G.ob x, A.ty x].lline X w).1 W g i))
                   (apH (\ v -> (G.act y x f).nt W v) (apH (\ ln -> ln.1 W g i) (CL.FT[G.ob x, A.ty x].lover X w))))) ;
  tEL (y x : CO) (f : P.CH y x) : PSub[extP CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI, extP CL.FC[G.ob y].GI CL.FT[G.ob y, A.ty y].AI] =
   new PSub[extP CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI, extP CL.FC[G.ob y].GI CL.FT[G.ob y, A.ty y].AI, mapL y x f,
    \ Y X h w -> CL.FT[G.ob y, A.ty y].tl-ext Y _ _ (\ V g j -> refl ((A.tE y x f).nt V ((CL.FT[G.ob x, A.ty x].lline X w).1 V (PB.compH V Y X h g) j)))] ;
  LinA : P.CTy[LinC G] =
   new P.CTy[LinC G, \ x -> CL.FT[G.ob x, A.ty x].AI, tEL,
    \ y x f X w -> refl (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI X w)),
    \ x X w -> CL.FT[G.ob x, A.ty x].tl-ext X _ w (\ V g j -> A.tE-id x V (CL.FT[G.ob x, A.ty x].lval X w V g j)),
    \ z y x f h X w -> CL.FT[G.ob z, A.ty z].tl-ext X _ _ (\ V g j -> A.tE-o z y x f h V (CL.FT[G.ob x, A.ty x].lval X w V g j))] ;
 } ;

 -- A at the end e of the lines, over the lines of the context
 module AE (G : P.CCtx) (A : P.CTy[G]) (e : PB.IPt) {
  TVT (x : CO) (X : Ob) : U l = SigT CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev X ;
  tEv (y x : CO) (f : P.CH y x) (X : Ob) (zz : TVT x X) : TVT y X =
   GPR.TyL[CL.FC[G.ob y].GI, CL.FT[G.ob y, A.ty y].Ev[e].Aev].pr X
    (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev X zz))
    (GPR.TyL[G.ob y, A.ty y].coeT X
       (fstE (G.ob y) (A.ty y) X ((A.tE y x f).nt X (CL.EndKit[G.ob x, A.ty x, e].endE X zz)))
       ((G.act y x f).nt X (fstE (G.ob x) (A.ty x) X (CL.EndKit[G.ob x, A.ty x, e].endE X zz)))
       (A.tE-pt y x f X (CL.EndKit[G.ob x, A.ty x, e].endE X zz))
       (sndE (G.ob y) (A.ty y) X ((A.tE y x f).nt X (CL.EndKit[G.ob x, A.ty x, e].endE X zz)))) ;
  endEv (y x : CO) (f : P.CH y x) (X : Ob) (zz : TVT x X)
   : Id (SigT (G.ob y) (A.ty y) X) (CL.EndKit[G.ob y, A.ty y, e].endE X (tEv y x f X zz)) ((A.tE y x f).nt X (CL.EndKit[G.ob x, A.ty x, e].endE X zz)) =
   symH (GPR.TyL[G.ob y, A.ty y].pr-coe X
     (fstE (G.ob y) (A.ty y) X ((A.tE y x f).nt X (CL.EndKit[G.ob x, A.ty x, e].endE X zz)))
     ((G.act y x f).nt X (fstE (G.ob x) (A.ty x) X (CL.EndKit[G.ob x, A.ty x, e].endE X zz)))
     (A.tE-pt y x f X (CL.EndKit[G.ob x, A.ty x, e].endE X zz))
     (sndE (G.ob y) (A.ty y) X ((A.tE y x f).nt X (CL.EndKit[G.ob x, A.ty x, e].endE X zz)))) ;
  tEvP (y x : CO) (f : P.CH y x)
   : PSub[extP CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev, extP CL.FC[G.ob y].GI CL.FT[G.ob y, A.ty y].Ev[e].Aev] =
   new PSub[extP CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev, extP CL.FC[G.ob y].GI CL.FT[G.ob y, A.ty y].Ev[e].Aev, tEv y x f,
    \ Y X h zz -> CL.EndKit[G.ob y, A.ty y, e].tv-eq Y _ _
      (symH (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF-act Y X h (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev X zz)))
      (transH (endEv y x f Y ((extP CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev).act Y X h zz))
        (transH (apH ((A.tE y x f).nt Y) (CL.EndKit[G.ob x, A.ty x, e].endE-act Y X h zz))
          (transH ((A.tE y x f).nt-nat Y X h (CL.EndKit[G.ob x, A.ty x, e].endE X zz))
            (transH (apH ((extP (G.ob y) (A.ty y)).act Y X h) (symH (endEv y x f X zz)))
              (symH (CL.EndKit[G.ob y, A.ty y, e].endE-act Y X h (tEv y x f X zz)))))))] ;
  AevC : P.CTy[LinC G] =
   new P.CTy[LinC G, \ x -> CL.FT[G.ob x, A.ty x].Ev[e].Aev, tEvP,
    \ y x f X zz -> refl (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev X zz)),
    \ x X zz -> CL.EndKit[G.ob x, A.ty x, e].tv-eq X _ zz
       ((LinC G).act-id x X (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev X zz))
       (transH (endEv x x (P.cid x) X zz) (A.tE-id x X (CL.EndKit[G.ob x, A.ty x, e].endE X zz))),
    \ z y x f h X zz -> CL.EndKit[G.ob z, A.ty z, e].tv-eq X _ _
       ((LinC G).act-o z y x f h X (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].Ev[e].Aev X zz))
       (transH (endEv z x (P.co z y x f h) X zz)
         (transH (A.tE-o z y x f h X (CL.EndKit[G.ob x, A.ty x, e].endE X zz))
           (transH (apH ((A.tE z y h).nt X) (symH (endEv y x f X zz)))
             (symH (endEv z y h X (tEv y x f X zz))))))] ;
 } ;

 -- evaluation at e commutes with the C-action, and the strict fibre of
 -- evaluation as a C-type over the extension by A at the end
 module SF (G : P.CCtx) (A : P.CTy[G]) (e : PB.IPt) {
  module LA' = LA[G, A] ;
  module AE' = AE[G, A, e] ;
  TLT (x : CO) (X : Ob) : U l = SigT CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI X ;
  evNat (y x : CO) (f : P.CH y x) (X : Ob) (w : TLT x X)
   : Id (AE'.TVT y X) (CL.FT[G.ob y, A.ty y].Ev[e].evA.mE X (LA'.mapL y x f X w)) (AE'.tEv y x f X (CL.FT[G.ob x, A.ty x].Ev[e].evA.mE X w)) =
   CL.EndKit[G.ob y, A.ty y, e].tv-eq X _ _
    (refl (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF X (fstE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI X w)))
    (transH (CL.FT[G.ob y, A.ty y].Ev[e].endB-E X (LA'.mapL y x f X w))
      (symH (transH (AE'.endEv y x f X (CL.FT[G.ob x, A.ty x].Ev[e].evA.mE X w))
               (apH ((A.tE y x f).nt X) (CL.FT[G.ob x, A.ty x].Ev[e].endB-E X w))))) ;

  -- the C-context of points at the end, and the strict fibre over it
  TVC : P.CCtx = ExtC (LinC G) AE'.AevC ;
  TST (x : CO) (X : Ob) : U l =
   SigT (TVC.ob x) CL.SFib[CL.FC[G.ob x].GI, CL.FT[G.ob x, A.ty x].AI, CL.FT[G.ob x, A.ty x].Ev[e].Aev, CL.FT[G.ob x, A.ty x].Ev[e].evA].SF X ;
  tES (y x : CO) (f : P.CH y x) (X : Ob) (ww : TST x X) : TST y X =
   pairE (TVC.ob y) CL.SFib[CL.FC[G.ob y].GI, CL.FT[G.ob y, A.ty y].AI, CL.FT[G.ob y, A.ty y].Ev[e].Aev, CL.FT[G.ob y, A.ty y].Ev[e].evA].SF X
    (AE'.tEv y x f X ww.1)
    (sndE CL.FC[G.ob y].GI CL.FT[G.ob y, A.ty y].AI X
       (LA'.mapL y x f X (pairE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI X ww.1.1 ww.2.1)),
     transH (evNat y x f X (pairE CL.FC[G.ob x].GI CL.FT[G.ob x, A.ty x].AI X ww.1.1 ww.2.1))
      (apH (AE'.tEv y x f X) ww.2.2)) ;
  tESP (y x : CO) (f : P.CH y x)
   : PSub[extP (TVC.ob x) CL.SFib[CL.FC[G.ob x].GI, CL.FT[G.ob x, A.ty x].AI, CL.FT[G.ob x, A.ty x].Ev[e].Aev, CL.FT[G.ob x, A.ty x].Ev[e].evA].SF,
          extP (TVC.ob y) CL.SFib[CL.FC[G.ob y].GI, CL.FT[G.ob y, A.ty y].AI, CL.FT[G.ob y, A.ty y].Ev[e].Aev, CL.FT[G.ob y, A.ty y].Ev[e].evA].SF] =
   new PSub[extP (TVC.ob x) CL.SFib[CL.FC[G.ob x].GI, CL.FT[G.ob x, A.ty x].AI, CL.FT[G.ob x, A.ty x].Ev[e].Aev, CL.FT[G.ob x, A.ty x].Ev[e].evA].SF,
          extP (TVC.ob y) CL.SFib[CL.FC[G.ob y].GI, CL.FT[G.ob y, A.ty y].AI, CL.FT[G.ob y, A.ty y].Ev[e].Aev, CL.FT[G.ob y, A.ty y].Ev[e].evA].SF,
    tES y x f,
    \ Y X h ww -> CL.EndKit[G.ob y, A.ty y, e].ts-ext Y _ _ ((AE'.tEvP y x f).nt-nat Y X h ww.1)
       (\ V g j -> refl ((A.tE y x f).nt V (CL.EndKit[G.ob x, A.ty x, e].lv X ww V (PB.compH V Y X h g) j)))] ;
  SFC : P.CTy[TVC] =
   new P.CTy[TVC, \ x -> CL.SFib[CL.FC[G.ob x].GI, CL.FT[G.ob x, A.ty x].AI, CL.FT[G.ob x, A.ty x].Ev[e].Aev, CL.FT[G.ob x, A.ty x].Ev[e].evA].SF,
    tESP,
    \ y x f X ww -> refl (AE'.tEv y x f X ww.1),
    \ x X ww -> CL.EndKit[G.ob x, A.ty x, e].ts-ext X _ ww (AE'.AevC.tE-id x X ww.1)
       (\ V g j -> A.tE-id x V (CL.EndKit[G.ob x, A.ty x, e].lv X ww V g j)),
    \ z y x f h X ww -> CL.EndKit[G.ob z, A.ty z, e].ts-ext X _ _ (AE'.AevC.tE-o z y x f h X ww.1)
       (\ V g j -> A.tE-o z y x f h V (CL.EndKit[G.ob x, A.ty x, e].lv X ww V g j))] ;
 } ;
} ;
