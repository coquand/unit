-- CIntCat.seg (canonicity-45; SIMPLIFIED.md step 3 / 4, agreed with
-- canonicity-c2): a category internal to the base, as a DISPLAYED category
-- over the base category: V-coded objects over each I, maps over each base
-- map u : J -> I, identities and composition with laws stated in the total
-- hom THom (no transports), cartesian lifts (the restriction res u x with
-- cart and the factorisation fact, unique), and a terminal object over
-- every I with its unique maps (for the interval of the total site).
-- Consumed by GrothCB (the total site, c2) and by the cobar layer (chains
-- at a stage, D).  Instance: the trivial category (one object, one map),
-- as a check that the record is well-formed.

level a ;
open Base ;
open Prelude[a+] ;
open Paths[a+] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

record IC {
 obD (I : Ob) : VA.V ;
 homD (J I : Ob) (u : Hom J I) (y : VA.Ix (obD J)) (x : VA.Ix (obD I)) : VA.V ;
 -- the total hom
 THom (J : Ob) (y : VA.Ix (obD J)) (I : Ob) (x : VA.Ix (obD I)) : U a = (u : Hom J I) * VA.Ix (homD J I u y x) ;
 idD (I : Ob) (x : VA.Ix (obD I)) : VA.Ix (homD I I (idH I) x x) ;
 compD (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : VA.Ix (obD K)) (y : VA.Ix (obD J)) (x : VA.Ix (obD I))
  (f : VA.Ix (homD J I u y x)) (g : VA.Ix (homD K J v z y)) : VA.Ix (homD K I (compH K J I u v) z x) ;
 idl (J I : Ob) (u : Hom J I) (y : VA.Ix (obD J)) (x : VA.Ix (obD I)) (f : VA.Ix (homD J I u y x))
  : Id (THom J y I x) (compH J I I (idH I) u, compD J I I (idH I) u y x x (idD I x) f) (u, f) ;
 idr (J I : Ob) (u : Hom J I) (y : VA.Ix (obD J)) (x : VA.Ix (obD I)) (f : VA.Ix (homD J I u y x))
  : Id (THom J y I x) (compH J J I u (idH J), compD J J I u (idH J) y y x f (idD J y)) (u, f) ;
 assoc (L K J I : Ob) (u : Hom J I) (v : Hom K J) (w : Hom L K)
  (t : VA.Ix (obD L)) (z : VA.Ix (obD K)) (y : VA.Ix (obD J)) (x : VA.Ix (obD I))
  (f : VA.Ix (homD J I u y x)) (g : VA.Ix (homD K J v z y)) (h : VA.Ix (homD L K w t z))
  : Id (THom L t I x)
      (compH L K I (compH K J I u v) w, compD L K I (compH K J I u v) w t z x (compD K J I u v z y x f g) h)
      (compH L J I u (compH L K J v w), compD L J I u (compH L K J v w) t y x f (compD L K J v w t z y g h)) ;
 -- cartesian lifts
 res (J I : Ob) (u : Hom J I) (x : VA.Ix (obD I)) : VA.Ix (obD J) ;
 cart (J I : Ob) (u : Hom J I) (x : VA.Ix (obD I)) : VA.Ix (homD J I u (res J I u x) x) ;
 fact (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : VA.Ix (obD K)) (x : VA.Ix (obD I))
  (h : VA.Ix (homD K I (compH K J I u v) z x)) : VA.Ix (homD K J v z (res J I u x)) ;
 fact-eq (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : VA.Ix (obD K)) (x : VA.Ix (obD I))
  (h : VA.Ix (homD K I (compH K J I u v) z x))
  : Id (VA.Ix (homD K I (compH K J I u v) z x)) (compD K J I u v z (res J I u x) x (cart J I u x) (fact K J I u v z x h)) h ;
 fact-uniq (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : VA.Ix (obD K)) (x : VA.Ix (obD I))
  (h : VA.Ix (homD K I (compH K J I u v) z x)) (g : VA.Ix (homD K J v z (res J I u x)))
  (e : Id (VA.Ix (homD K I (compH K J I u v) z x)) (compD K J I u v z (res J I u x) x (cart J I u x) g) h)
  : Id (VA.Ix (homD K J v z (res J I u x))) g (fact K J I u v z x h) ;
 -- restriction is strictly functorial on objects (equalities of objects,
 -- used only by the cobar layer: the naturality of the chain indices)
 res-id (I : Ob) (x : VA.Ix (obD I)) : Id (VA.Ix (obD I)) (res I I (idH I) x) x ;
 res-comp (K J I : Ob) (u : Hom J I) (v : Hom K J) (x : VA.Ix (obD I))
  : Id (VA.Ix (obD K)) (res K I (compH K J I u v) x) (res K J v (res J I u x)) ;
 -- the cartesian lifts are compatible with identities and composition
 -- (the cleavage is a splitting), up to the equalities of objects above
 cart-id (I : Ob) (x : VA.Ix (obD I))
  : Id (VA.Ix (homD I I (idH I) (res I I (idH I) x) x))
      (cart I I (idH I) x)
      (subst (VA.Ix (obD I)) (\ w -> VA.Ix (homD I I (idH I) w x)) x (res I I (idH I) x) (symH (res-id I x)) (idD I x)) ;
 cart-comp (K J I : Ob) (u : Hom J I) (v : Hom K J) (x : VA.Ix (obD I))
  : Id (VA.Ix (homD K I (compH K J I u v) (res K J v (res J I u x)) x))
      (compD K J I u v (res K J v (res J I u x)) (res J I u x) x (cart J I u x) (cart K J v (res J I u x)))
      (subst (VA.Ix (obD K)) (\ w -> VA.Ix (homD K I (compH K J I u v) w x)) (res K I (compH K J I u v) x) (res K J v (res J I u x)) (res-comp K J I u v x) (cart K I (compH K J I u v) x)) ;
 -- terminal objects, stable because displayed
 term (I : Ob) : VA.Ix (obD I) ;
 bang (J I : Ob) (u : Hom J I) (y : VA.Ix (obD J)) : VA.Ix (homD J I u y (term I)) ;
 bang-uniq (J I : Ob) (u : Hom J I) (y : VA.Ix (obD J)) (f : VA.Ix (homD J I u y (term I)))
  : Id (VA.Ix (homD J I u y (term I))) f (bang J I u y) ;
} ;

-- the trivial internal category: one object and one map over every base map
module Trivial {
 unitV : VA.V = VA.sing VA.emptyV ;
 pt : VA.Ix unitV = tt ;
 isTop' (a b : VA.Ix unitV) : Id (VA.Ix unitV) a b = isTop a b ;
 pairEq (J I : Ob) (u : Hom J I) (f g : VA.Ix unitV) : Id ((u' : Hom J I) * VA.Ix unitV) (u, f) (u, g) =
  apH {VA.Ix unitV} {(u' : Hom J I) * VA.Ix unitV} (\ z -> (u, z)) (isTop' f g) ;
 trivial : IC = new IC[\ I -> unitV, \ J I u y x -> unitV, \ I x -> pt, \ K J I u v z y x f g -> pt,
  \ J I u y x f -> transH (apH {Hom J I} {(u' : Hom J I) * VA.Ix unitV} (\ w -> (w, pt)) (comp-idl J I u)) (pairEq J I u pt f),
  \ J I u y x f -> transH (apH {Hom J I} {(u' : Hom J I) * VA.Ix unitV} (\ w -> (w, pt)) (comp-idr J I u)) (pairEq J I u pt f),
  \ L K J I u v w t z y x f g h -> apH {Hom L I} {(u' : Hom L I) * VA.Ix unitV} (\ w' -> (w', pt)) (comp-assoc L K J I u v w),
  \ J I u x -> pt, \ J I u x -> pt, \ K J I u v z x h -> pt, \ K J I u v z x h -> isTop' pt h,
  \ K J I u v z x h g e -> isTop' g pt, \ I x -> isTop' pt x, \ K J I u v x -> refl pt,
  \ I x -> isTop' pt (subst (VA.Ix unitV) (\ w -> VA.Ix unitV) x pt (symH (isTop' pt x)) pt), \ K J I u v x -> isTop' pt (subst (VA.Ix unitV) (\ w -> VA.Ix unitV) pt pt (refl pt) pt),
  \ I -> pt, \ J I u y -> pt, \ J I u y f -> isTop' f pt] ;
} ;
