-- CPshEqSub.seg (canonicity-45; COBAR.md "Plan: Theorem 29", M5): an
-- equivalence structure of a map of C-types in Prop13U's shape (a
-- uniform trivial fibrancy of its homotopy fibres, Prop13.HP) pulled back
-- along a C-substitution t : De -> G.  At x the base's CHSub (the
-- homotopy fibres of the substituted map are cartesian over those of the
-- map, CHFibCart.HCart: moveEq); the fibre type of the substituted map at
-- x IS HP's type at x of the pulled-back CMap (CPshMapSub), so no
-- comparison of fibre types is needed.  Uniform in C: HCart's comparison
-- map mS commutes with HP's action (mSC: point, B part and line values
-- by CPshL.SC.rBtE), then the argument of CPshUTrivSub with mS in place
-- of the reading.
--   subEqU De G t A B f ut : UTriv (De.B[t]) HP[De, A[t], B[t], f[t]].PC
-- No new axioms beyond the named premises.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;
module CE = PB.CEquiv[l] ;

module EqSubOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 module MSB = CPshMapSub[a, l].MapSubOf[C] ;
 open P ;

 module ES (De G : CCtx) (t : CSub[De, G]) (A B : CTy[G]) (f : P13.CMap[G, A, B])
  (ut : UTriv (LO.ExtC G B) (P13.HP[G, A, B, f].PC)) {
  module SCA = LO.SC[De, G, t, A] ;
  module SCB = LO.SC[De, G, t, B] ;
  module HPx = P13.HP[G, A, B, f] ;
  module HPs = P13.HP[De, LO.subCTy De G t A, LO.subCTy De G t B, MSB.subCMap De G t A B f] ;
  -- the base's substituted equivalence structure at x
  module HSx (x : CO) { module H = PB.CHSub[l].HSub[De.ob x, G.ob x, t.sb x, A.ty x, B.ty x, f.mp x] ; } ;
  c (x : CO) : CP.ContrOp (HPs.GB.ob x) (HPs.PC.ty x) = HSx[x].H.subEq (ut.1 x) ;

  -- the comparison map of fibres commutes with HP's action
  mSC (y x : CO) (h : CH y x) (X : Ob) (v : HSx[x].H.H.F'.TF.EI X)
   : Id (HSx[y].H.H.F.TF.EI X) (HPx.res y x h X (HSx[x].H.H.mS X v)) (HSx[y].H.H.mS X (HPs.res y x h X v)) =
   HSx[y].H.H.F.fibE-eq X (HPx.res y x h X (HSx[x].H.H.mS X v)) (HSx[y].H.H.mS X (HPs.res y x h X v))
    (symH (SCB.rBtE y x h X (HSx[x].H.H.F'.TF.pr1 X v)))
    (transH (HPx.rb y x h X (HSx[x].H.H.mS X v))
     (transH (apH ((A.tE y x h).nt X) (HSx[x].H.H.bm-E X v))
      (transH (symH (SCA.rBtE y x h X (HSx[x].H.H.F'.fibB X v)))
       (transH (apH (HSx[y].H.SB.mV X) (symH (HPs.rb y x h X v)))
        (symH (HSx[y].H.H.bm-E X (HPs.res y x h X v)))))))
    (\ W g i -> symH (SCB.rBtE y x h W (HSx[x].H.H.F'.fibL X v W g i))) ;
  opaque mSC ;

  module At (y x : CO) (f' : CH y x) (X : Ob) (g : SigT (De.ob x) (SCB.ST x) X) (s : CP.Partials[HPs.GB.ob x, HPs.PC.ty x].Side[X, g]) {
   gy : SigT (De.ob y) (SCB.ST y) X = SCB.tEs y x f' X g ;
   sy : CP.Partials[HPs.GB.ob y, HPs.PC.ty y].Side[X, gy] = MapSide[HPs.GB, HPs.PC, y, x, f'].mapside X g s ;
   -- the sides read in the fibres of f, at x and at y
   sG : CP.Partials[HPx.GB.ob x, HPx.PC.ty x].Side[X, HSx[x].H.SA.mV X g] = HSx[x].H.H.C.mside (ut.1 x) X g s ;
   sGy : CP.Partials[HPx.GB.ob y, HPx.PC.ty y].Side[X, HSx[y].H.SA.mV X gy] = HSx[y].H.H.C.mside (ut.1 y) X gy sy ;
   sGm : CP.Partials[HPx.GB.ob y, HPx.PC.ty y].Side[X, (B.tE y x f').nt X (HSx[x].H.SA.mV X g)] =
    MapSide[HPx.GB, HPx.PC, y, x, f'].mapside X (HSx[x].H.SA.mV X g) sG ;
   pe : Id (SigT (G.ob y) (B.ty y) X) ((B.tE y x f').nt X (HSx[x].H.SA.mV X g)) (HSx[y].H.SA.mV X gy) = symH (SCB.rBtE y x f' X g) ;
   sEq : Id (CP.Partials[HPx.GB.ob y, HPx.PC.ty y].Side[X, HSx[y].H.SA.mV X gy])
           (subst (SigT (G.ob y) (B.ty y) X) (\ z -> CP.Partials[HPx.GB.ob y, HPx.PC.ty y].Side[X, z]) ((B.tE y x f').nt X (HSx[x].H.SA.mV X g)) (HSx[y].H.SA.mV X gy) pe sGm) sGy =
    CP.Partials[HPx.GB.ob y, HPx.PC.ty y].side-extH X ((B.tE y x f').nt X (HSx[x].H.SA.mV X g)) (HSx[y].H.SA.mV X gy) pe sGm sGy (refl s.pQ)
     (\ W h i i' -> transH (apH (\ v -> HPx.res y x f' W (HSx[x].H.H.mS W v)) (CP.Partials[HPs.GB.ob x, HPs.PC.ty x].pv-irr X g s W h i i'))
                     (mSC y x f' W (s.pv W h i'))) ;
   opaque sEq ;
   Kp (z : SigT (G.ob y) (B.ty y) X) (sd : CP.Partials[HPx.GB.ob y, HPx.PC.ty y].Side[X, z]) : SigT (HPx.GB.ob y) (HPx.PC.ty y) X =
    pairE (HPx.GB.ob y) (HPx.PC.ty y) X z ((ut.1 y).kop X z sd) ;
   kpEq : Id (SigT (HPx.GB.ob y) (HPx.PC.ty y) X) (Kp ((B.tE y x f').nt X (HSx[x].H.SA.mV X g)) sGm) (Kp (HSx[y].H.SA.mV X gy) sGy) =
    idJ (SigT (G.ob y) (B.ty y) X) ((B.tE y x f').nt X (HSx[x].H.SA.mV X g))
     (\ z2 P2 -> (sd2 : CP.Partials[HPx.GB.ob y, HPx.PC.ty y].Side[X, z2])
        -> Id (CP.Partials[HPx.GB.ob y, HPx.PC.ty y].Side[X, z2]) (subst (SigT (G.ob y) (B.ty y) X) (\ z -> CP.Partials[HPx.GB.ob y, HPx.PC.ty y].Side[X, z]) ((B.tE y x f').nt X (HSx[x].H.SA.mV X g)) z2 P2 sGm) sd2
        -> Id (SigT (HPx.GB.ob y) (HPx.PC.ty y) X) (Kp ((B.tE y x f').nt X (HSx[x].H.SA.mV X g)) sGm) (Kp z2 sd2))
     (\ sd2 E2 -> apH (Kp ((B.tE y x f').nt X (HSx[x].H.SA.mV X g))) E2)
     (HSx[y].H.SA.mV X gy) pe sGy sEq ;
   opaque kpEq ;
   -- the uniformity equation, by injectivity of the comparison map
   res : Id (SigT (HPs.GB.ob y) (HPs.PC.ty y) X)
           ((HPs.PC.tE y x f').nt X (pairE (HPs.GB.ob x) (HPs.PC.ty x) X g ((c x).kop X g s)))
           (pairE (HPs.GB.ob y) (HPs.PC.ty y) X gy ((c y).kop X gy sy)) =
    HSx[y].H.H.mSinj X ((HPs.PC.tE y x f').nt X (pairE (HPs.GB.ob x) (HPs.PC.ty x) X g ((c x).kop X g s))) (pairE (HPs.GB.ob y) (HPs.PC.ty y) X gy ((c y).kop X gy sy))
     (refl gy)
     (transH (symH (mSC y x f' X (pairE (HPs.GB.ob x) (HPs.PC.ty x) X g ((c x).kop X g s))))
      (transH (apH (HPx.res y x f' X) (HSx[x].H.H.C.kopMv (ut.1 x) X g s))
       (transH (ut.2 y x f' X (HSx[x].H.SA.mV X g) sG)
        (transH kpEq (symH (HSx[y].H.H.C.kopMv (ut.1 y) X gy sy)))))) ;
   opaque res ;
  } ;
  res : UTriv HPs.GB HPs.PC = (c, \ y x f' X g s -> At[y, x, f', X, g, s].res) ;
 } ;

 subEqU (De G : CCtx) (t : CSub[De, G]) (A B : CTy[G]) (f : P13.CMap[G, A, B]) (ut : UTriv (LO.ExtC G B) (P13.HP[G, A, B, f].PC))
  : UTriv (LO.ExtC De (LO.subCTy De G t B)) (P13.HP[De, LO.subCTy De G t A, LO.subCTy De G t B, MSB.subCMap De G t A B f].PC) =
  ES[De, G, t, A, B, f, ut].res ;
} ;
