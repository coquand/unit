-- CUG24.seg (canonicity-c2; the generic (U), part 24 of CCmpU24's
-- numbering): for homs s -> y out of ANY presentation s, over nil.H for a
-- closed H with two hom projections pkA, pkB (natural); as CCmpU24 with
-- F2 replaced by s and the generator cases a hypothesis gen.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module UG24 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (s y : SX.Over[R].Presentation) (H : C.Ty C.nil) (pkA pkB : (K : Ob) (w : V1.Ix ((C.ext C.nil H).ob K)) -> V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob K w.1)) (pkAN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkA I w)) (pkA J ((C.ext C.nil H).act J I f w))) (pkBN : (J I : Ob) (f : Hom J I) (w : V1.Ix ((C.ext C.nil H).ob I)) -> Id (V1.Ix (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tob J w.1)) (CHomT3[a].HomP[R, encK, pe].Hom[s, y].HomT.1.tact J I f w.1 w.1 (refl w.1) (pkB I w)) (pkB J ((C.ext C.nil H).act J I f w))) (gen : (v : SX.Fin s.1) -> C.El (C.ext C.nil H) (CUG20[a].UG20[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN].IdZ (CHomT3[a].HomP[R, encK, pe].Alg[s].AX.cls (var v)))) {
 module U23m = CUG23[a].UG23[R, encK, pe, s, y, H, pkA, pkB, pkAN, pkBN] ;
 module U20m = U23m.U20m ;
 module U13m = U20m.U13m ;
 module HZ = U20m.HZ ;
 module AS = HZ.AS ;
 Nl : C.Ctx = C.nil ;
 GH : C.Ctx = U20m.GH ;
 QYh : C.Ty GH = U20m.QYh ;
 IdZ (c : C.El Nl U20m.QA) : C.Ty GH = U20m.IdZ c ;
 h : (t : AS.AX.Term) -> C.El GH (IdZ (AS.AX.cls t)) = split {
  var v -> gen v ;
  cst r -> U23m.At[r].res ;
  sumE p q | rp rq -> U20m.Bin[AS.O.addQ, HZ.AT.O.addQ, U20m.dkA, U20m.dkAN, AS.AX.cls p, AS.AX.cls q, AS.AX.cls (sumE p q), AS.O.add-beta p q, rp, rq].res ;
  mulE p q | rp rq -> U20m.Bin[AS.O.mulQ, HZ.AT.O.mulQ, U20m.dkM, U20m.dkMN, AS.AX.cls p, AS.AX.cls q, AS.AX.cls (mulE p q), AS.O.mul-beta p q, rp, rq].res } ;
} ;
