-- CProdSet.seg (canonicity-c2): the product A x A' of two closed sets is a
-- set (Hedberg, CwFHed6, with R = the pair of Ids of the components), as
-- CSigSetC for a Sigma with propositional fibres.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;

module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
idBackL (G : C.Ctx) (X X' : C.Ty G) (P : Id (C.Ty G) X X') (x y : C.El G X) (u : C.El G (IJ.IdT G X' (OV.trE G X X' P x) (OV.trE G X X' P y)))
  : C.El G (IJ.IdT G X x y) =
 idJ (C.Ty G) X (\ Z PZ -> C.El G (IJ.IdT G Z (OV.trE G X Z PZ x) (OV.trE G X Z PZ y)) -> C.El G (IJ.IdT G X x y)) (\ v -> v) X' P u ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
-- pairs in a non-dependent Sigma, and Ids of pairs from Ids of components
module PairId (G : C.Ctx) (X Y : C.Ty G) {
 SXY : C.Ty G = SS.Sig G X (OV.wkT G X Y) ;
 pst (u : C.El G X) : Id (C.Ty G) (C.subT G (C.ext G X) (OV.wkT G X Y) (C.sec G X u)) Y = CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst G X Y u ;
 prN (x : C.El G X) (y : C.El G Y) : C.El G SXY =
  INm.pr G X (OV.wkT G X Y) x (OV.trE G Y (C.subT G (C.ext G X) (OV.wkT G X Y) (C.sec G X x)) (symH (pst x)) y) ;
 prR (x : C.El G X) (y : C.El G Y) (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (SXY.1.tob K w)) ((prN x y).eob K w) (x.eob K w, y.eob K w) =
  apH {V1.Ix (Y.1.tob K w)} {V1.Ix (SXY.1.tob K w)} (\ v -> (x.eob K w, v))
   (transH (CAppRd[a].trE-rd G Y (C.subT G (C.ext G X) (OV.wkT G X Y) (C.sec G X x)) (symH (pst x)) y K w)
     (CAppRd[a].same-rd G Y (C.subT G (C.ext G X) (OV.wkT G X Y) (C.sec G X x)) (symH (pst x)) K w (refl (Y.1.tob K w)) (y.eob K w))) ;
} ;
-- the value of a map at a point, read (PT.atv)
atvR (G : C.Ctx) (A B : C.Ty G) (r : C.El (C.ext G A) (OV.wkT G A B)) (x : C.El G A) (K : Ob) (w : V1.Ix (G.ob K))
  : Id (V1.Ix (B.1.tob K w)) ((PT.atv G A B r x).eob K w) (r.eob K (w, x.eob K w)) =
 transH (CAppRd[a].trE-rd G (C.subT G (C.ext G A) (OV.wkT G A B) (C.sec G A x)) B
          (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst G A B x) (C.subt G (C.ext G A) (OV.wkT G A B) r (C.sec G A x)) K w)
  (CAppRd[a].same-rd G (C.subT G (C.ext G A) (OV.wkT G A B) (C.sec G A x)) B
     (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst G A B x) K w (refl (B.1.tob K w)) (r.eob K (w, x.eob K w))) ;
-- Ids of pairs from Ids of the components
module PE (G : C.Ctx) (X Y : C.Ty G) (x x' : C.El G X) (y y' : C.El G Y) (ex : C.El G (IJ.IdT G X x x')) (ey : C.El G (IJ.IdT G Y y y')) {
 module P0 = PairId[G, X, Y] ;
 SXY : C.Ty G = P0.SXY ;
 -- along the first component
 GXc : C.Ctx = C.ext G X ;
 module P1 = PairId[GXc, OV.wkT G X X, OV.wkT G X Y] ;
 PS1 : Id (C.Ty GXc) (OV.wkT G X SXY) P1.SXY =
  transH (FibCwF[a, a+].fibSig.Sig-nat GXc G X (OV.wkT G X Y) (C.p G X))
   (apH {C.Ty (C.ext GXc (OV.wkT G X X))} {C.Ty GXc} (\ B -> SS.Sig GXc (OV.wkT G X X) B) (CAppRd[a].W.plT GXc G X Y (C.p G X))) ;
 r1' : C.El GXc P1.SXY = P1.prN (C.q G X) (OV.wkE G X Y y) ;
 r1 : C.El GXc (OV.wkT G X SXY) = OV.trE GXc P1.SXY (OV.wkT G X SXY) (symH PS1) r1' ;
 rd1 (u : C.El G X) (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (SXY.1.tob K w)) ((PT.atv G X SXY r1 u).eob K w) ((P0.prN u y).eob K w) =
  transH (atvR G X SXY r1 u K w)
   (transH (CAppRd[a].trE-rd GXc P1.SXY (OV.wkT G X SXY) (symH PS1) r1' K (w, u.eob K w))
     (transH (CAppRd[a].same-rd GXc P1.SXY (OV.wkT G X SXY) (symH PS1) K (w, u.eob K w) (refl (SXY.1.tob K w)) (r1'.eob K (w, u.eob K w)))
       (transH (P1.prR (C.q G X) (OV.wkE G X Y y) K (w, u.eob K w)) (symH (P0.prR u y K w))))) ;
 e1 : C.El G (IJ.IdT G SXY (P0.prN x y) (P0.prN x' y)) =
  CCmpU14[a].rwId G SXY (PT.atv G X SXY r1 x) (P0.prN x y) (PT.atv G X SXY r1 x') (P0.prN x' y) (rd1 x) (rd1 x') (PT.apM G X SXY r1 x x' ex) ;
 -- along the second component
 GYc : C.Ctx = C.ext G Y ;
 module P2 = PairId[GYc, OV.wkT G Y X, OV.wkT G Y Y] ;
 PS2 : Id (C.Ty GYc) (OV.wkT G Y SXY) P2.SXY =
  transH (FibCwF[a, a+].fibSig.Sig-nat GYc G X (OV.wkT G X Y) (C.p G Y))
   (apH {C.Ty (C.ext GYc (OV.wkT G Y X))} {C.Ty GYc} (\ B -> SS.Sig GYc (OV.wkT G Y X) B) (CAppRd[a].W.plT GYc G X Y (C.p G Y))) ;
 r2' : C.El GYc P2.SXY = P2.prN (OV.wkE G Y X x') (C.q G Y) ;
 r2 : C.El GYc (OV.wkT G Y SXY) = OV.trE GYc P2.SXY (OV.wkT G Y SXY) (symH PS2) r2' ;
 rd2 (u : C.El G Y) (K : Ob) (w : V1.Ix (G.ob K)) : Id (V1.Ix (SXY.1.tob K w)) ((PT.atv G Y SXY r2 u).eob K w) ((P0.prN x' u).eob K w) =
  transH (atvR G Y SXY r2 u K w)
   (transH (CAppRd[a].trE-rd GYc P2.SXY (OV.wkT G Y SXY) (symH PS2) r2' K (w, u.eob K w))
     (transH (CAppRd[a].same-rd GYc P2.SXY (OV.wkT G Y SXY) (symH PS2) K (w, u.eob K w) (refl (SXY.1.tob K w)) (r2'.eob K (w, u.eob K w)))
       (transH (P2.prR (OV.wkE G Y X x') (C.q G Y) K (w, u.eob K w)) (symH (P0.prR x' u K w))))) ;
 e2 : C.El G (IJ.IdT G SXY (P0.prN x' y) (P0.prN x' y')) =
  CCmpU14[a].rwId G SXY (PT.atv G Y SXY r2 y) (P0.prN x' y) (PT.atv G Y SXY r2 y') (P0.prN x' y') (rd2 y) (rd2 y') (PT.apM G Y SXY r2 y y' ey) ;
 res : C.El G (IJ.IdT G SXY (P0.prN x y) (P0.prN x' y')) = PT.transM G SXY (P0.prN x y) (P0.prN x' y) (P0.prN x' y') e1 e2 ;
} ;
module ProdSet (A A' : C.Ty C.nil) (sA : CQCtx[a].G3Of[A].SetQiTy) (sA' : CQCtx[a].G3Of[A'].SetQiTy) {
 Nl : C.Ctx = C.nil ;
 S : C.Ty Nl = SS.Sig Nl A (OV.wkT Nl A A') ;
 module GA = CQCtx[a].G3Of[A] ;
 module GB = CQCtx[a].G3Of[A'] ;
 module GS = CQCtx[a].G3Of[S] ;
 G2 : C.Ctx = GS.G2 ;
 -- the components: G2 -> GA.G2, GB.G2
 sg1N (K : Ob) (w : V1.Ix (G2.ob K)) : V1.Ix (GA.G2.ob K) = ((w.1.1, w.1.2.1), w.2.1) ;
 sg1 : C.Sub G2 GA.G2 = new L.PSub[G2, GA.G2, sg1N, \ L0 K g w -> refl (sg1N L0 (G2.act L0 K g w))] ;
 sg2N (K : Ob) (w : V1.Ix (G2.ob K)) : V1.Ix (GB.G2.ob K) = ((w.1.1, w.1.2.2), w.2.2) ;
 sg2 : C.Sub G2 GB.G2 = new L.PSub[G2, GB.G2, sg2N, \ L0 K g w -> refl (sg2N L0 (G2.act L0 K g w))] ;
 IA : C.Ty GA.G2 = IJ.IdT GA.G2 GA.Qw2 GA.v1 GA.v2 ;
 IB : C.Ty GB.G2 = IJ.IdT GB.G2 GB.Qw2 GB.v1 GB.v2 ;
 R1 : C.Ty G2 = C.subT G2 GA.G2 IA sg1 ;
 R2 : C.Ty G2 = C.subT G2 GB.G2 IB sg2 ;
 pR1 : C.El G2 (PU.isProp G2 R1) =
  OV.trE G2 (C.subT G2 GA.G2 (PU.isProp GA.G2 IA) sg1) (PU.isProp G2 R1) (PU.isProp-ov G2 GA.G2 IA sg1 R1 (refl R1))
   (C.subt G2 GA.G2 (PU.isProp GA.G2 IA) (GA.setV2 sA) sg1) ;
 pR2 : C.El G2 (PU.isProp G2 R2) =
  OV.trE G2 (C.subT G2 GB.G2 (PU.isProp GB.G2 IB) sg2) (PU.isProp G2 R2) (PU.isProp-ov G2 GB.G2 IB sg2 R2 (refl R2))
   (C.subt G2 GB.G2 (PU.isProp GB.G2 IB) (GB.setV2 sA') sg2) ;
 R : C.Ty G2 = SS.Sig G2 R1 (OV.wkT G2 R1 R2) ;
 pR : C.El G2 (PU.isProp G2 R) = CSetProps[a].SigProp[G2, R1, OV.wkT G2 R1 R2, pR1, PU.wkProp G2 R1 R2 pR2].sigProp ;
 -- rho : R at (x , x) is the pair of reflexivities
 G1 : C.Ctx = GS.G1 ;
 x0 : C.El G1 GS.Qw = C.q Nl S ;
 sx : C.Sub G1 G2 = C.sec G1 GS.Qw x0 ;
 module Rf (X : C.Ty Nl) (sX : C.Sub G2 (CQCtx[a].G3Of[X].G2)) {
  module GX = CQCtx[a].G3Of[X] ;
  IX : C.Ty GX.G2 = IJ.IdT GX.G2 GX.Qw2 GX.v1 GX.v2 ;
  s0 : C.Sub G1 GX.G2 = C.o G1 G2 GX.G2 sX sx ;
  Q2s : C.Ty G1 = C.subT G1 GX.G2 GX.Qw2 s0 ;
  a1 : C.El G1 Q2s = C.subt G1 GX.G2 GX.Qw2 GX.v1 s0 ;
  a2 : C.El G1 Q2s = C.subt G1 GX.G2 GX.Qw2 GX.v2 s0 ;
  module At (e12 : Id (C.El G1 Q2s) a1 a2) {
   rf : C.El G1 (IJ.IdT G1 Q2s a1 a2) = subst (C.El G1 Q2s) (\ r -> C.El G1 (IJ.IdT G1 Q2s a1 r)) a1 a2 e12 (IJ.rfl G1 Q2s a1) ;
   rho : C.El G1 (C.subT G1 G2 (C.subT G2 GX.G2 IX sX) sx) =
    OV.trE G1 (IJ.IdT G1 Q2s a1 a2) (C.subT G1 G2 (C.subT G2 GX.G2 IX sX) sx)
     (transH (symH (IJ.IdT-nat G1 GX.G2 GX.Qw2 GX.v1 GX.v2 s0)) (C.subT-o G1 G2 GX.G2 IX sX sx)) rf ;
  } ;
 } ;
 module RA = Rf[A, sg1] ;
 module RB = Rf[A', sg2] ;
 rho1 : C.El G1 (C.subT G1 G2 R1 sx) = RA.At[L.el-ext G1 RA.Q2s.1 RA.a1 RA.a2 (\ K w -> refl (RA.a1.eob K w))].rho ;
 rho2 : C.El G1 (C.subT G1 G2 R2 sx) = RB.At[L.el-ext G1 RB.Q2s.1 RB.a1 RB.a2 (\ K w -> refl (RB.a1.eob K w))].rho ;
 R1s : C.Ty G1 = C.subT G1 G2 R1 sx ;
 lfx : C.Sub (C.ext G1 R1s) (C.ext G2 R1) = C.lift G1 G2 R1 sx ;
 Ys : C.Ty (C.ext G1 R1s) = C.subT (C.ext G1 R1s) (C.ext G2 R1) (OV.wkT G2 R1 R2) lfx ;
 PY2 : Id (C.Ty G1) (C.subT G1 G2 R2 sx) (C.subT G1 (C.ext G1 R1s) Ys (C.sec G1 R1s rho1)) =
  symH (transH (symH (C.subT-o G1 (C.ext G1 R1s) (C.ext G2 R1) (OV.wkT G2 R1 R2) lfx (C.sec G1 R1s rho1)))
    (transH (symH (C.subT-o G1 (C.ext G2 R1) G2 R2 (C.p G2 R1) (C.o G1 (C.ext G1 R1s) (C.ext G2 R1) lfx (C.sec G1 R1s rho1))))
      (apH {C.Sub G1 G2} {C.Ty G1} (\ s -> C.subT G1 G2 R2 s)
        (L.sub-ext G1 G2 (C.o G1 (C.ext G2 R1) G2 (C.p G2 R1) (C.o G1 (C.ext G1 R1s) (C.ext G2 R1) lfx (C.sec G1 R1s rho1))) sx (\ K w -> refl (sx.nt K w)))))) ;
 rho : C.El G1 (C.subT G1 G2 R sx) =
  OV.trE G1 (SS.Sig G1 R1s Ys) (C.subT G1 G2 R sx) (symH (FibCwF[a, a+].fibSig.Sig-nat G1 G2 R1 (OV.wkT G2 R1 R2) sx))
   (INm.pr G1 R1s Ys rho1 (OV.trE G1 (C.subT G1 G2 R2 sx) (C.subT G1 (C.ext G1 R1s) Ys (C.sec G1 R1s rho1)) PY2 rho2)) ;
 -- over G2.R: the two variables as pairs
 GR : C.Ctx = C.ext G2 R ;
 pRp : C.Sub GR G2 = C.p G2 R ;
 XA : C.Ty GR = C.subT GR Nl A (C.eps GR) ;
 XB : C.Ty GR = C.subT GR Nl A' (C.eps GR) ;
 module PG = PairId[GR, XA, XB] ;
 SR : C.Ty GR = PG.SXY ;
 pp3 : C.Sub GR Nl = C.o GR G2 Nl (C.o G2 G1 Nl (C.p Nl S) (C.p G1 GS.Qw)) pRp ;
 TP : Id (C.Ty GR) (OV.wkT G2 R GS.Qw2) SR =
  transH (apH {C.Ty G2} {C.Ty GR} (\ T -> C.subT GR G2 T pRp) (symH (C.subT-o G2 G1 Nl S (C.p Nl S) (C.p G1 GS.Qw))))
   (transH (symH (C.subT-o GR G2 Nl S (C.o G2 G1 Nl (C.p Nl S) (C.p G1 GS.Qw)) pRp))
     (transH (apH {C.Sub GR Nl} {C.Ty GR} (\ s -> C.subT GR Nl S s) (C.eps-uniq GR pp3))
       (transH (FibCwF[a, a+].fibSig.Sig-nat GR Nl A (OV.wkT Nl A A') (C.eps GR))
         (apH {C.Ty (C.ext GR XA)} {C.Ty GR} (\ B -> SS.Sig GR XA B) (CAppRd[a].W.plT GR Nl A A' (C.eps GR)))))) ;
 w1 : C.El GR SR = OV.trE GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 GS.v1) ;
 w2 : C.El GR SR = OV.trE GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 GS.v2) ;
 -- the two components of the R variable, semantically
 R1g : C.Ty GR = C.subT GR G2 R1 pRp ;
 R2g : C.Ty GR = C.subT GR G2 R2 pRp ;
 eAN (J I : Ob) (f : Hom J I) (z : V1.Ix (GR.ob I))
   : Id (V1.Ix (R1g.1.tob J (GR.act J I f z))) (R1g.1.tact J I f z (GR.act J I f z) (refl (GR.act J I f z)) z.2.1) (GR.act J I f z).2.1 =
  L.tact-irr G2 R1.1 J I f z.1 (G2.act J I f z.1) (L.ntEq GR G2 pRp J I f z (GR.act J I f z) (refl (GR.act J I f z))) (refl (G2.act J I f z.1)) z.2.1 ;
 eA : C.El GR R1g = L.mkPEl GR R1g.1 (\ K z -> z.2.1) (\ J I f z z' e ->
  idJ (V1.Ix (GR.ob J)) (GR.act J I f z) (\ z2 e2 -> Id (V1.Ix (R1g.1.tob J z2)) (R1g.1.tact J I f z z2 e2 z.2.1) z2.2.1) (eAN J I f z) z' e) ;
 eBN (J I : Ob) (f : Hom J I) (z : V1.Ix (GR.ob I))
   : Id (V1.Ix (R2g.1.tob J (GR.act J I f z))) (R2g.1.tact J I f z (GR.act J I f z) (refl (GR.act J I f z)) z.2.2) (GR.act J I f z).2.2 =
  L.tact-irr G2 R2.1 J I f z.1 (G2.act J I f z.1) (L.ntEq GR G2 pRp J I f z (GR.act J I f z) (refl (GR.act J I f z)))
   (L.ntEq (L.extP G2 R1.1) G2 (L.pP G2 R1.1) J I f (z.1, z.2.1) (G2.act J I f z.1, R1.1.tact J I f z.1 (G2.act J I f z.1) (refl (G2.act J I f z.1)) z.2.1)
      (L.pair-act G2 R1.1 J I f z.1 (G2.act J I f z.1) (refl (G2.act J I f z.1)) z.2.1))
   z.2.2 ;
 eB : C.El GR R2g = L.mkPEl GR R2g.1 (\ K z -> z.2.2) (\ J I f z z' e ->
  idJ (V1.Ix (GR.ob J)) (GR.act J I f z) (\ z2 e2 -> Id (V1.Ix (R2g.1.tob J z2)) (R2g.1.tact J I f z z2 e2 z.2.2) z2.2.2) (eBN J I f z) z' e) ;
 -- an Id of components, moved to X at eps
 module Cmp (X : C.Ty Nl) (sX : C.Sub G2 (CQCtx[a].G3Of[X].G2)) (eX : C.El GR (C.subT GR G2 (C.subT G2 (CQCtx[a].G3Of[X].G2) (IJ.IdT (CQCtx[a].G3Of[X].G2) (CQCtx[a].G3Of[X].Qw2) (CQCtx[a].G3Of[X].v1) (CQCtx[a].G3Of[X].v2)) sX) pRp)) {
  module GX = CQCtx[a].G3Of[X] ;
  tR : C.Sub GR GX.G2 = C.o GR G2 GX.G2 sX pRp ;
  QX2 : C.Ty GR = C.subT GR GX.G2 GX.Qw2 tR ;
  c1 : C.El GR QX2 = C.subt GR GX.G2 GX.Qw2 GX.v1 tR ;
  c2 : C.El GR QX2 = C.subt GR GX.G2 GX.Qw2 GX.v2 tR ;
  u0 : C.El GR (IJ.IdT GR QX2 c1 c2) =
   OV.trE GR (C.subT GR G2 (C.subT G2 GX.G2 (IJ.IdT GX.G2 GX.Qw2 GX.v1 GX.v2) sX) pRp) (IJ.IdT GR QX2 c1 c2)
    (transH (symH (C.subT-o GR G2 GX.G2 (IJ.IdT GX.G2 GX.Qw2 GX.v1 GX.v2) sX pRp)) (IJ.IdT-nat GR GX.G2 GX.Qw2 GX.v1 GX.v2 tR)) eX ;
  XT : C.Ty GR = C.subT GR Nl X (C.eps GR) ;
  pX2 : C.Sub GR Nl = C.o GR GX.G2 Nl (C.o GX.G2 GX.G1 Nl (C.p Nl X) (C.p GX.G1 GX.Qw)) tR ;
  TPX : Id (C.Ty GR) QX2 XT =
   transH (apH {C.Ty GX.G2} {C.Ty GR} (\ T -> C.subT GR GX.G2 T tR) (symH (C.subT-o GX.G2 GX.G1 Nl X (C.p Nl X) (C.p GX.G1 GX.Qw))))
    (transH (symH (C.subT-o GR GX.G2 Nl X (C.o GX.G2 GX.G1 Nl (C.p Nl X) (C.p GX.G1 GX.Qw)) tR)) (apH {C.Sub GR Nl} {C.Ty GR} (\ s -> C.subT GR Nl X s) (C.eps-uniq GR pX2))) ;
  d1 : C.El GR XT = OV.trE GR QX2 XT TPX c1 ;
  d2 : C.El GR XT = OV.trE GR QX2 XT TPX c2 ;
  u1 : C.El GR (IJ.IdT GR XT d1 d2) = CInjP[a].idFwdL GR QX2 XT TPX c1 c2 u0 ;
 } ;
 module CA = Cmp[A, sg1, eA] ;
 module CB = Cmp[A', sg2, eB] ;
 -- the components of w1, w2 and their readings (at the point tt of nil)
 fw (w : C.El GR SR) : C.El GR XA = INm.fst GR XA (OV.wkT GR XA XB) w ;
 sw (w : C.El GR SR) : C.El GR XB = OV.trE GR (C.subT GR (C.ext GR XA) (OV.wkT GR XA XB) (C.sec GR XA (fw w))) XB (PG.pst (fw w)) (INm.snd GR XA (OV.wkT GR XA XB) w) ;
 swr (w : C.El GR SR) (K : Ob) (z : V1.Ix (GR.ob K)) : Id (V1.Ix (XB.1.tob K z)) ((sw w).eob K z) (w.eob K z).2 =
  transH (CAppRd[a].trE-rd GR (C.subT GR (C.ext GR XA) (OV.wkT GR XA XB) (C.sec GR XA (fw w))) XB (PG.pst (fw w)) (INm.snd GR XA (OV.wkT GR XA XB) w) K z)
   (CAppRd[a].same-rd GR (C.subT GR (C.ext GR XA) (OV.wkT GR XA XB) (C.sec GR XA (fw w))) XB (PG.pst (fw w)) K z (refl (XB.1.tob K z)) (w.eob K z).2) ;
 wr (v : C.El G2 GS.Qw2) (K : Ob) (s1 s2 : V1.Ix (S.1.tob K tt)) (r : V1.Ix (R.1.tob K ((tt, s1), s2)))
   : Id (V1.Ix (S.1.tob K tt)) ((OV.trE GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 v)).eob K (((tt, s1), s2), r)) (v.eob K ((tt, s1), s2)) =
  transH (CAppRd[a].trE-rd GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 v) K (((tt, s1), s2), r))
   (CAppRd[a].same-rd GR (OV.wkT G2 R GS.Qw2) SR TP K (((tt, s1), s2), r) (refl (S.1.tob K tt)) (v.eob K ((tt, s1), s2))) ;
 drA (c : C.El GR CA.QX2) (K : Ob) (s1 s2 : V1.Ix (S.1.tob K tt)) (r : V1.Ix (R.1.tob K ((tt, s1), s2)))
   : Id (V1.Ix (A.1.tob K tt)) ((OV.trE GR CA.QX2 CA.XT CA.TPX c).eob K (((tt, s1), s2), r)) (c.eob K (((tt, s1), s2), r)) =
  transH (CAppRd[a].trE-rd GR CA.QX2 CA.XT CA.TPX c K (((tt, s1), s2), r))
   (CAppRd[a].same-rd GR CA.QX2 CA.XT CA.TPX K (((tt, s1), s2), r) (refl (A.1.tob K tt)) (c.eob K (((tt, s1), s2), r))) ;
 drB (c : C.El GR CB.QX2) (K : Ob) (s1 s2 : V1.Ix (S.1.tob K tt)) (r : V1.Ix (R.1.tob K ((tt, s1), s2)))
   : Id (V1.Ix (A'.1.tob K tt)) ((OV.trE GR CB.QX2 CB.XT CB.TPX c).eob K (((tt, s1), s2), r)) (c.eob K (((tt, s1), s2), r)) =
  transH (CAppRd[a].trE-rd GR CB.QX2 CB.XT CB.TPX c K (((tt, s1), s2), r))
   (CAppRd[a].same-rd GR CB.QX2 CB.XT CB.TPX K (((tt, s1), s2), r) (refl (A'.1.tob K tt)) (c.eob K (((tt, s1), s2), r))) ;
 -- the pointwise identifications, split at the point of nil
 hA1 (K : Ob) : (o : Top) (s1 s2 : V1.Ix (S.1.tob K o)) (r : V1.Ix (R.1.tob K ((o, s1), s2)))
   -> Id (V1.Ix (XA.1.tob K (((o, s1), s2), r))) (CA.d1.eob K (((o, s1), s2), r)) ((fw w1).eob K (((o, s1), s2), r)) =
  split { tt -> \ s1 s2 r -> transH (drA CA.c1 K s1 s2 r) (symH (apH {V1.Ix (S.1.tob K tt)} {V1.Ix (A.1.tob K tt)} (\ u -> u.1) (wr GS.v1 K s1 s2 r))) } ;
 hA2 (K : Ob) : (o : Top) (s1 s2 : V1.Ix (S.1.tob K o)) (r : V1.Ix (R.1.tob K ((o, s1), s2)))
   -> Id (V1.Ix (XA.1.tob K (((o, s1), s2), r))) (CA.d2.eob K (((o, s1), s2), r)) ((fw w2).eob K (((o, s1), s2), r)) =
  split { tt -> \ s1 s2 r -> transH (drA CA.c2 K s1 s2 r) (symH (apH {V1.Ix (S.1.tob K tt)} {V1.Ix (A.1.tob K tt)} (\ u -> u.1) (wr GS.v2 K s1 s2 r))) } ;
 hB1 (K : Ob) : (o : Top) (s1 s2 : V1.Ix (S.1.tob K o)) (r : V1.Ix (R.1.tob K ((o, s1), s2)))
   -> Id (V1.Ix (XB.1.tob K (((o, s1), s2), r))) (CB.d1.eob K (((o, s1), s2), r)) ((sw w1).eob K (((o, s1), s2), r)) =
  split { tt -> \ s1 s2 r -> transH (drB CB.c1 K s1 s2 r) (symH (transH (swr w1 K (((tt, s1), s2), r)) (apH {V1.Ix (S.1.tob K tt)} {V1.Ix (A'.1.tob K tt)} (\ u -> u.2) (wr GS.v1 K s1 s2 r)))) } ;
 hB2 (K : Ob) : (o : Top) (s1 s2 : V1.Ix (S.1.tob K o)) (r : V1.Ix (R.1.tob K ((o, s1), s2)))
   -> Id (V1.Ix (XB.1.tob K (((o, s1), s2), r))) (CB.d2.eob K (((o, s1), s2), r)) ((sw w2).eob K (((o, s1), s2), r)) =
  split { tt -> \ s1 s2 r -> transH (drB CB.c2 K s1 s2 r) (symH (transH (swr w2 K (((tt, s1), s2), r)) (apH {V1.Ix (S.1.tob K tt)} {V1.Ix (A'.1.tob K tt)} (\ u -> u.2) (wr GS.v2 K s1 s2 r)))) } ;
 eA' : C.El GR (IJ.IdT GR XA (fw w1) (fw w2)) =
  CCmpU14[a].rwId GR XA CA.d1 (fw w1) CA.d2 (fw w2) (\ K z -> hA1 K z.1.1.1 z.1.1.2 z.1.2 z.2) (\ K z -> hA2 K z.1.1.1 z.1.1.2 z.1.2 z.2) CA.u1 ;
 eB' : C.El GR (IJ.IdT GR XB (sw w1) (sw w2)) =
  CCmpU14[a].rwId GR XB CB.d1 (sw w1) CB.d2 (sw w2) (\ K z -> hB1 K z.1.1.1 z.1.1.2 z.1.2 z.2) (\ K z -> hB2 K z.1.1.1 z.1.1.2 z.1.2 z.2) CB.u1 ;
 -- the two pairs are joined, hence the two variables
 module PEm = PE[GR, XA, XB, fw w1, fw w2, sw w1, sw w2, eA', eB'] ;
 pq (w : C.El GR SR) (K : Ob) (z : V1.Ix (GR.ob K)) : Id (V1.Ix (SR.1.tob K z)) ((PG.prN (fw w) (sw w)).eob K z) (w.eob K z) =
  transH (PG.prR (fw w) (sw w) K z) (apH {V1.Ix (XB.1.tob K z)} {V1.Ix (SR.1.tob K z)} (\ v -> ((w.eob K z).1, v)) (swr w K z)) ;
 pp : C.El GR (IJ.IdT GR SR w1 w2) = CCmpU14[a].rwId GR SR (PG.prN (fw w1) (sw w1)) w1 (PG.prN (fw w2) (sw w2)) w2 (pq w1) (pq w2) PEm.res ;
 fB : C.El GR (IJ.IdT GR (OV.wkT G2 R GS.Qw2) (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2)) =
  idBackL GR (OV.wkT G2 R GS.Qw2) SR TP (OV.wkE G2 R GS.Qw2 GS.v1) (OV.wkE G2 R GS.Qw2 GS.v2) pp ;
} ;
