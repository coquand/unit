-- CGrothCyl.seg (canonicity-c2; (A), constant types at the total site): the
-- cylinder of the Grothendieck site of an internal category C over the
-- poset base: cyl (I, x) = (cyl I, x restricted along the projection),
-- the projection is the cartesian lift, pairing is the cartesian
-- factorisation over the base pairing, and eta is the factorisation's
-- uniqueness after the base eta (the base homs are moved by path induction).
-- No new axioms.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;

module GCyl (C : CIntCat[a, a+].IC) {
 module GO = CGrothBase[a, a+, a+].GrothOf[C] ;
 module TC = GO.TC ;
 module VA = V[a+] ;
 cy0 : CCyl[a].CylOf[PB.BC, CCyl[a].PosCyl.pivV, CCyl[a].PosCyl.pivA].Cyl = CCyl[a].PosCyl.posCyl ;
 TOb : U a+ = TC.TOb ;
 THm (Y X : TOb) : U a+ = TC.THm Y X ;
 cylT (X : TOb) : TOb = (cy0.cyl X.1, C.res (cy0.cyl X.1) X.1 (cy0.cpr1 X.1) X.2) ;
 cpr1T (X : TOb) : THm (cylT X) X = TC.cartT (cy0.cyl X.1) X (cy0.cpr1 X.1) ;
 cpr2T (X : TOb) : PB.IvP (cylT X).1 = cy0.cpr2 X.1 ;
 cpairT (X Z : TOb) (f : THm Z X) (j : PB.IvP Z.1) : THm Z (cylT X) =
  TC.factT (cy0.cyl X.1) Z X (cy0.cpr1 X.1) (cy0.cpair X.1 Z.1 f.1 j) f (symH (cy0.cpr1-pair X.1 Z.1 f.1 j)) ;
 cpr1-pairT (X Z : TOb) (f : THm Z X) (j : PB.IvP Z.1) : Id (THm Z X) (GO.tcomp Z (cylT X) X (cpr1T X) (cpairT X Z f j)) f =
  TC.factT-eq (cy0.cyl X.1) Z X (cy0.cpr1 X.1) (cy0.cpair X.1 Z.1 f.1 j) f (symH (cy0.cpr1-pair X.1 Z.1 f.1 j)) ;
 cpr2-pairT (X Z : TOb) (f : THm Z X) (j : PB.IvP Z.1) : Id (PB.IvP Z.1) (GO.ivA Z (cylT X) (cpairT X Z f j) (cpr2T X)) j =
  cy0.cpr2-pair X.1 Z.1 f.1 j ;
 -- eta: any factorisation through the lift with base map h.1 is h
 etaB (X Z : TOb) (h : THm Z (cylT X)) (e : Id (Hom Z.1 X.1) (GO.tcomp Z (cylT X) X (cpr1T X) h).1 (compH Z.1 (cy0.cyl X.1) X.1 (cy0.cpr1 X.1) h.1))
   : Id (THm Z (cylT X)) (TC.factT (cy0.cyl X.1) Z X (cy0.cpr1 X.1) h.1 (GO.tcomp Z (cylT X) X (cpr1T X) h) e) h =
  apH {VA.Ix (C.homD Z.1 (cy0.cyl X.1) h.1 Z.2 (cylT X).2)} {THm Z (cylT X)} (\ g -> (h.1, g))
   (symH (TC.factT-uniq (cy0.cyl X.1) Z X (cy0.cpr1 X.1) h.1 (GO.tcomp Z (cylT X) X (cpr1T X) h) e h.2
            (refl (GO.tcomp Z (cylT X) X (cpr1T X) h)))) ;
 cpair-etaT (X Z : TOb) (h : THm Z (cylT X))
   : Id (THm Z (cylT X)) (cpairT X Z (GO.tcomp Z (cylT X) X (cpr1T X) h) (GO.ivA Z (cylT X) h (cpr2T X))) h =
  idJ (Hom Z.1 (cy0.cyl X.1)) h.1
   (\ v p -> (e : Id (Hom Z.1 X.1) (GO.tcomp Z (cylT X) X (cpr1T X) h).1 (compH Z.1 (cy0.cyl X.1) X.1 (cy0.cpr1 X.1) v))
       -> Id (THm Z (cylT X)) (TC.factT (cy0.cyl X.1) Z X (cy0.cpr1 X.1) v (GO.tcomp Z (cylT X) X (cpr1T X) h) e) h)
   (etaB X Z h)
   (cy0.cpair X.1 Z.1 (GO.tcomp Z (cylT X) X (cpr1T X) h).1 (GO.ivA Z (cylT X) h (cpr2T X)))
   (symH (cy0.cpair-eta X.1 Z.1 h.1))
   (symH (cy0.cpr1-pair X.1 Z.1 (GO.tcomp Z (cylT X) X (cpr1T X) h).1 (GO.ivA Z (cylT X) h (cpr2T X)))) ;
 cylG : CCyl[a+].CylOf[GO.GB.BC, \ X -> TC.embV (PB.ivV X.1), GO.ivA].Cyl =
  new CCyl[a+].CylOf[GO.GB.BC, \ X -> TC.embV (PB.ivV X.1), GO.ivA].Cyl[cylT, cpr1T, cpr2T, cpairT, cpr1-pairT, cpr2-pairT, cpair-etaT] ;
} ;
