-- CwFQuotElim3.seg (canonicity-c2; SIMPLIFIED.md item 3): QE1 part 3,
-- the quotient's eliminator in two arguments into a set B, in CAlgX's
-- agreed shapes (Elim2Ty / Elim2Beta):
--   g t = elim1 (f t)  (rs2),  elim2 = elim1 g into Fun Qt B
-- (Fun Qt B a set: CwFFunSetB), its respect proof pointwise at the
-- classes (elimP1, the two betas and rs1) then funext (NF); beta by
-- evaluation at cls u (CwFMaps.EvF, apF) and the inner beta.
-- No new axioms beyond the named premises and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module MP = CwFMaps.Maps[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

module QE3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy) {
 module Q1 = CwFQuotElim1[a].QE1[R, encK, x, pe] ;
 module Q2 = CwFQuotElim2[a].QE2[R, encK, x, pe] ;
 module AX = Q1.AX ;
 Nl : C.Ctx = C.nil ;
 Qt : C.Ty Nl = AX.Qt ;
 G1 : C.Ctx = C.ext Nl Qt ;
 module E2 (B : C.Ty Nl) (sB : CQCtx[a].G3Of[B].SetQiTy) (f : AX.Term -> AX.Term -> C.El Nl B)
   (rs1 : (t t' u : AX.Term) -> C.El Nl (AX.RelC t t') -> C.El Nl (IJ.IdT Nl B (f t u) (f t' u)))
   (rs2 : (t u u' : AX.Term) -> C.El Nl (AX.RelC u u') -> C.El Nl (IJ.IdT Nl B (f t u) (f t u'))) {
  B' : C.Ty Nl = OV.Fun Nl Qt B ;
  g (t : AX.Term) : C.El Nl B' = Q2.elim1 B sB (f t) (\ u u' w -> rs2 t u u' w) ;
  gb (t u : AX.Term) : C.El Nl (IJ.IdT Nl B (OV.app Nl Qt B (g t) (AX.cls u)) (f t u)) = Q2.elim1-beta B sB (f t) (\ u1 u' w -> rs2 t u1 u' w) u ;
  sB' : CQCtx[a].G3Of[B'].SetQiTy = CwFFunSetB[a].FunSetQ[Qt, B, sB].setQi ;
  module SBm = CwFFunSetB[a].SetB[B, sB] ;
  WB : C.Ty G1 = OV.wkT Nl Qt B ;
  -- the respect proof of g: pointwise at the classes, then funext
  module RS (t t' : AX.Term) (w : C.El Nl (AX.RelC t t')) {
   Pw : C.Ty G1 = IJ.IdT G1 WB (OV.bod Nl Qt WB (g t)) (OV.bod Nl Qt WB (g t')) ;
   pPw : C.El G1 (PU.isProp G1 Pw) = SBm.idPB G1 (C.p Nl Qt) (OV.bod Nl Qt WB (g t)) (OV.bod Nl Qt WB (g t')) ;
   module H (u : AX.Term) {
    c : C.El Nl Qt = AX.cls u ;
    e : C.El Nl (IJ.IdT Nl B (OV.app Nl Qt B (g t) c) (OV.app Nl Qt B (g t') c)) =
     PT.transM Nl B (OV.app Nl Qt B (g t) c) (f t u) (OV.app Nl Qt B (g t') c) (gb t u)
       (PT.transM Nl B (f t u) (f t' u) (OV.app Nl Qt B (g t') c) (rs1 t t' u w) (PT.symM Nl B (OV.app Nl Qt B (g t') c) (f t' u) (gb t' u))) ;
    PI : Id (C.Ty Nl) (C.subT Nl G1 Pw (C.sec Nl Qt c)) (IJ.IdT Nl B (OV.app Nl Qt B (g t) c) (OV.app Nl Qt B (g t') c)) =
     OV.Id-ov Nl G1 WB (OV.bod Nl Qt WB (g t)) (OV.bod Nl Qt WB (g t')) (C.sec Nl Qt c) B
       (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst Nl Qt B c) (OV.app Nl Qt B (g t) c) (OV.app Nl Qt B (g t') c)
       (refl (OV.app Nl Qt B (g t) c)) (refl (OV.app Nl Qt B (g t') c)) ;
    h : C.El Nl (C.subT Nl G1 Pw (Q1.GQ.Sec1[c].sec1)) =
     OV.trE Nl (C.subT Nl G1 Pw (C.sec Nl Qt c)) (C.subT Nl G1 Pw (Q1.GQ.Sec1[c].sec1))
       (apH {C.Sub Nl G1} {C.Ty Nl} (\ s -> C.subT Nl G1 Pw s) (Q1.sS1 u))
       (OV.trE Nl (IJ.IdT Nl B (OV.app Nl Qt B (g t) c) (OV.app Nl Qt B (g t') c)) (C.subT Nl G1 Pw (C.sec Nl Qt c)) (symH PI) e) ;
   } ;
   pw : C.El G1 Pw = Q1.elimP1 Pw pPw (\ u -> H[u].h) ;
   res : C.El Nl (IJ.IdT Nl B' (g t) (g t')) = FibNF[a, a+].nf Nl Qt WB (g t) (g t') (OV.lam Nl Qt Pw pw) ;
  } ;
  elim2 : C.El Nl (OV.Fun Nl Qt B') = Q2.elim1 B' sB' g (\ t t' w -> RS[t, t', w].res) ;
  -- beta
  module BT (t u : AX.Term) {
   b1 : C.El Nl (IJ.IdT Nl B' (OV.app Nl Qt B' elim2 (AX.cls t)) (g t)) = Q2.elim1-beta B' sB' g (\ t1 t' w -> RS[t1, t', w].res) t ;
   module EV = MP.EvF[Nl, Qt, B, AX.cls u] ;
   b2 : C.El Nl (IJ.IdT Nl B (OV.app Nl B' B EV.evF (OV.app Nl Qt B' elim2 (AX.cls t))) (OV.app Nl B' B EV.evF (g t))) =
    MP.apF Nl B' B EV.evF (OV.app Nl Qt B' elim2 (AX.cls t)) (g t) b1 ;
   b3 : C.El Nl (IJ.IdT Nl B (OV.app Nl Qt B (OV.app Nl Qt B' elim2 (AX.cls t)) (AX.cls u)) (OV.app Nl Qt B (g t) (AX.cls u))) =
    subst (C.El Nl B) (\ v -> C.El Nl (IJ.IdT Nl B (OV.app Nl Qt B (OV.app Nl Qt B' elim2 (AX.cls t)) (AX.cls u)) v))
      (OV.app Nl B' B EV.evF (g t)) (OV.app Nl Qt B (g t) (AX.cls u)) EV.At[g t].val
      (subst (C.El Nl B) (\ v -> C.El Nl (IJ.IdT Nl B v (OV.app Nl B' B EV.evF (g t))))
         (OV.app Nl B' B EV.evF (OV.app Nl Qt B' elim2 (AX.cls t))) (OV.app Nl Qt B (OV.app Nl Qt B' elim2 (AX.cls t)) (AX.cls u))
         EV.At[OV.app Nl Qt B' elim2 (AX.cls t)].val b2) ;
   beta : C.El Nl (IJ.IdT Nl B (OV.app Nl Qt B (OV.app Nl Qt B' elim2 (AX.cls t)) (AX.cls u)) (f t u)) =
    PT.transM Nl B (OV.app Nl Qt B (OV.app Nl Qt B' elim2 (AX.cls t)) (AX.cls u)) (OV.app Nl Qt B (g t) (AX.cls u)) (f t u) b3 (gb t u) ;
  } ;
 } ;
 -- in the agreed shapes (CAlgX)
 elim2 : AX.Elim2Ty = \ B sB f rs1 rs2 -> E2[B, sB, f, rs1, rs2].elim2 ;
 elim2-beta : AX.Elim2Beta elim2 = \ B sB f rs1 rs2 t u -> E2[B, sB, f, rs1, rs2].BT[t, u].beta ;
} ;
