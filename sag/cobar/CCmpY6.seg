-- CCmpY6.seg (canonicity-45; COBAR.md "Prop 58"): tau is compatible with
-- G's operations up to paths.  For an operation op of G from a structure
-- map io : F1 -> F2 (GopsOf.Op; add, mul) and w in yo F2 with
-- cmp w = (a, b):  op (tau a, tau b) ~ tau (w . io), a path homotopy of maps
-- yo F2 -> G read as types over the terminal context (CtxTy's Y1T, the
-- form c2's G uses).  The path is the quasi-inverse homotopy of D cmp
-- (CCmpY5, EqQinv) pushed through D(yo io); the ends by tau's
-- compatibility with D on maps and with pairing (CTauOps).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module Cp6 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) { module O = CCmpY5[a].Ops2[R, encK, pe, al, eqal, commH] ;
 module BS = O.BS ;
 module CM = BS.CM ;
 module CT = BS.CT ;
 module TR = BS.TR ;
 module G1 = TR.G1 ;
 module HO1 = G1.GB.CHtpyOps[a+] ;
 module PS1 = G1.GB.GPre[a+].PS ;
 Y1 : CM.TP.TCtx = CM.Yo[BS.FR.F1].yoT ;
 Y2 : CM.TP.TCtx = CM.Yo[BS.FR.F2].yoT ;
 module Q1 = CT.Of[Y1] ;
 module Q2 = BS.O2 ;
 module Q11 = BS.O11 ;
 module QG = CT.Of[Q1.DY.DCtx] ;
 GT : TR.P1.PTy[CT.P1] = QG.Y1T ;
 -- a map of contexts as a map of types over the terminal context
 module TN (Yc : CM.TP.TCtx) (s : CM.TP.TSub[Yc, Q1.DY.DCtx]) {
  module QY = CT.Of[Yc] ;
  nm : HO1.NMap[CT.P1, QY.Y1T, GT] =
   new HO1.NMap[CT.P1, QY.Y1T, GT, \ X o w -> s.nt X.1 X.2 w, \ J I f x x' e w -> symH (s.nt-nat J.1 I.1 f.1 J.2 I.2 f.2 w)] ;
 } ;
 -- tau and D on maps / pairing, on GO's module paths (as CTauOps)
 module TauS (Dc Gc : CM.TP.TCtx) (sc : CM.TP.TSub[Dc, Gc]) {
  module DSs = O.GO.DO.DS[Dc, Gc, sc] ;
  law (I : Ob) (x : V1.Ix (CM.IC.obD I)) (g : V1.Ix (Dc.ob I x)) : Id (DSs.DG.Ob' I x) (DSs.dmap I x (DSs.DD.tau I x g)) (DSs.DG.tau I x (sc.nt I x g)) =
   DSs.DG.ob-eq I x (DSs.dmap I x (DSs.DD.tau I x g)) (DSs.DG.tau I x (sc.nt I x g)) (\ q l ->
    sc.nt-nat q.2.1 I q.2.2.1 q.2.2.2.1 x (DSs.DD.tmap I x q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) g) ;
 } ;
 tauP (I : Ob) (x : V1.Ix (CM.IC.obD I)) (g h : V1.Ix (Y1.ob I x))
  : Id (O.GO.PP.DGH.Ob' I x) (O.GO.PP.fromS.nt I x (O.GO.PP.DG.tau I x g, O.GO.PP.DH.tau I x h)) (O.GO.PP.DGH.tau I x (g, h)) =
  O.GO.PP.DGH.ob-eq I x (O.GO.PP.fromS.nt I x (O.GO.PP.DG.tau I x g, O.GO.PP.DH.tau I x h)) (O.GO.PP.DGH.tau I x (g, h)) (\ q l ->
   refl ((O.GO.PP.DGH.tau I x (g, h)).1 q l)) ;
 module Opc (io : (J : Ob) -> CM.MO.Fn[CM.F1, CM.F2].M J) (io-nat : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[CM.F1, CM.F2].M K) (CM.MO.Fn[CM.F1, CM.F2].res J K v (io J)) (io K)) {
  module OP = O.GO.Op[io, io-nat] ;
  -- the two sides, as maps of contexts yo F2 -> G
  lS : CM.TP.TSub[Y2, Q1.DY.DCtx] =
   new CM.TP.TSub[Y2, Q1.DY.DCtx, \ I x w -> OP.op.nt I x (Q1.DY.tau I x (CM.cmpS.nt I x w).1, Q1.DY.tau I x (CM.cmpS.nt I x w).2),
    \ J I uu yy x f w -> transH (apH {V1.Ix ((CM.PD.prodT Q1.DY.DCtx Q1.DY.DCtx).ob J yy)} {Q1.DY.Ob' J yy} (OP.op.nt J yy)
        (CM.PD.pairE2 (Q1.DY.Ob' J yy) (Q1.DY.Ob' J yy) _ _ _ _
          (transH (apH {V1.Ix (Y1.ob J yy)} {Q1.DY.Ob' J yy} (Q1.DY.tau J yy) (apH {V1.Ix ((CM.PD.prodT Y1 Y1).ob J yy)} {V1.Ix (Y1.ob J yy)} (\ p -> p.1) (CM.cmpS.nt-nat J I uu yy x f w))) (Q1.DY.tau-nat J I uu yy x f (CM.cmpS.nt I x w).1))
          (transH (apH {V1.Ix (Y1.ob J yy)} {Q1.DY.Ob' J yy} (Q1.DY.tau J yy) (apH {V1.Ix ((CM.PD.prodT Y1 Y1).ob J yy)} {V1.Ix (Y1.ob J yy)} (\ p -> p.2) (CM.cmpS.nt-nat J I uu yy x f w))) (Q1.DY.tau-nat J I uu yy x f (CM.cmpS.nt I x w).2))))
       (OP.op.nt-nat J I uu yy x f (Q1.DY.tau I x (CM.cmpS.nt I x w).1, Q1.DY.tau I x (CM.cmpS.nt I x w).2))] ;
  rS : CM.TP.TSub[Y2, Q1.DY.DCtx] = O.GO.compS Y2 Y1 Q1.DY.DCtx Q1.DY.tauS OP.PR.preS ;
  l : HO1.NMap[CT.P1, Q2.Y1T, GT] = TN[Y2, lS].nm ;
  r : HO1.NMap[CT.P1, Q2.Y1T, GT] = TN[Y2, rS].nm ;
  -- the path: D cmp's quasi-inverse homotopy at bk(tau w), through D(yo io)
  module P13 = O.P13 ;
  DG : TR.P1.PCtx = P13.DF.DG ;
  DA2 : TR.P1.PTy[DG] = P13.DF.DA.DTy ;
  DB11 : TR.P1.PTy[DG] = P13.DF.DB.DTy ;
  module TE = HO1.HT[DG, DA2, DA2, HO1.compN DG DA2 DB11 DA2 O.EQ.PNa.nm O.EQ.EI.gN, HO1.idN DG DA2] ;
  module HC = HO1.HT[CT.P1, Q2.Y1T, GT, l, r] ;
  module TGT = G1.GB.GPre[a+].TyL[CT.P1, GT] ;
  z (X : CT.TC.TOb) (w : V1.Ix (Y2.ob X.1 X.2)) : V1.Ix (TE.GA.ob X) = Q2.bk X.1 X.2 (Q2.DY.tau X.1 X.2 w) ;
  lineG (X : CT.TC.TOb) (w : V1.Ix (Y2.ob X.1 X.2)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv) : Q1.DY.Ob' Vv.1 Vv.2 =
   OP.dY.nt Vv.1 Vv.2 (Q2.fw Vv (TE.pv O.EQ.EI.eta X (z X w) Vv g j)) ;
  tv (X : CT.TC.TOb) (o : V1.Ix (CT.P1.ob X)) (w : V1.Ix (Y2.ob X.1 X.2)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv) : TGT.EI Vv =
   TGT.pr Vv o (lineG X w Vv g j) ;
  tn (X : CT.TC.TOb) (o : V1.Ix (CT.P1.ob X)) (w : V1.Ix (Y2.ob X.1 X.2)) (Vb Va : CT.TC.TOb) (g2 : CT.TC.THm Vb Va) (g : CT.TC.THm Va X) (j : Hom Va.1 Iv)
   : Id (TGT.EI Vb) (TGT.E.act Vb Va g2 (tv X o w Va g j)) (tv X o w Vb (CT.TC.TotCat.oC Vb Va X g g2) (compH Vb.1 Va.1 Iv j g2.1)) =
   transH (TGT.pr-tact Vb Va g2 o o (refl o) (lineG X w Va g j))
    (apH {Q1.DY.Ob' Vb.1 Vb.2} {TGT.EI Vb} (TGT.pr Vb o)
      (transH (symH (OP.dY.nt-nat Vb.1 Va.1 g2.1 Vb.2 Va.2 g2.2 (Q2.fw Va (TE.pv O.EQ.EI.eta X (z X w) Va g j))))
        (apH {Q2.DY.Ob' Vb.1 Vb.2} {Q1.DY.Ob' Vb.1 Vb.2} (OP.dY.nt Vb.1 Vb.2)
          (transH (symH (Q2.fwN Vb Va g2 (TE.pv O.EQ.EI.eta X (z X w) Va g j)))
            (apH {V1.Ix (TE.GA.ob Vb)} {Q2.DY.Ob' Vb.1 Vb.2} (Q2.fw Vb) ((O.EQ.EI.eta.eob X (z X w)).1.2 Vb Va g2 g j)))))) ;
  -- the start: D cmp at bk(tau w) is bk(fromS (tau a, tau b))
  module TYB = G1.GB.GPre[a+].TyL[DG, DB11] ;
  module St (X : CT.TC.TOb) (w : V1.Ix (Y2.ob X.1 X.2)) {
   d1 : P13.DF.D.Ob' X.1 X.2 = Q2.d1 X.1 X.2 ;
   a0 : P13.DF.DA.TOb' X.1 X.2 d1 = (z X w).2 ;
   pw (Vb : Ob) (zb : V1.Ix (CM.IC.obD Vb)) (u0 : Hom Vb X.1) (f0 : CM.TP.HomD Vb X.1 u0 zb X.2) :
     Id (V1.Ix ((CM.PD.prodT Y1 Y1).ob Vb zb)) ((CM.PD.prodT Y1 Y1).act Vb X.1 u0 zb X.2 f0 (CM.cmpS.nt X.1 X.2 w)) (CM.cmpS.nt Vb zb (Y2.act Vb X.1 u0 zb X.2 f0 w)) =
    symH (CM.cmpS.nt-nat Vb X.1 u0 zb X.2 f0 w) ;
   ff : Q11.DY.Ob' X.1 X.2 = O.GO.PP.fromS.nt X.1 X.2 (Q1.DY.tau X.1 X.2 (CM.cmpS.nt X.1 X.2 w).1, Q1.DY.tau X.1 X.2 (CM.cmpS.nt X.1 X.2 w).2) ;
   module DMc = P13.DF.DM[X.1, X.2, d1, a0] ;
   tmEq (q : P13.DF.DA.Idx X.1 X.2) : Id (CM.TP.HomD q.2.1 X.1 q.2.2.1 q.2.2.2.1 X.2) (Q1.DY.tmap X.1 X.2 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) (Q2.DY.tmap X.1 X.2 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) =
    CTauOps[a, a+, a+].TauOps[CM.IC].tmapEq Y1 Y2 X.1 X.2 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1 ;
   rdP (pp : V1.Ix ((CM.PD.prodT Y1 Y1).ob X.1 X.2)) (q : P13.DF.DA.Idx X.1 X.2) (l : P13.DF.DA.LandsI X.1 X.2 q)
    : Id (V1.Ix ((CM.PD.prodT Y1 Y1).ob q.2.1 q.2.2.2.1)) ((O.GO.PP.fromS.nt X.1 X.2 (Q1.DY.tau X.1 X.2 pp.1, Q1.DY.tau X.1 X.2 pp.2)).1 q l)
       ((CM.PD.prodT Y1 Y1).act q.2.1 X.1 q.2.2.1 q.2.2.2.1 X.2 (Q1.DY.tmap X.1 X.2 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) pp) =
    refl ((CM.PD.prodT Y1 Y1).act q.2.1 X.1 q.2.2.1 q.2.2.2.1 X.2 (Q1.DY.tmap X.1 X.2 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) pp) ;
   ptA (q : P13.DF.DA.Idx X.1 X.2) (l : P13.DF.DA.LandsI X.1 X.2 q)
    : Id (V1.Ix ((CM.PD.prodT Y1 Y1).ob q.2.1 q.2.2.2.1)) (ff.1 q l) (CM.cmpS.nt q.2.1 q.2.2.2.1 ((Q2.DY.tau X.1 X.2 w).1 q l)) =
    transH (rdP (CM.cmpS.nt X.1 X.2 w) q l) (transH (pw q.2.1 q.2.2.2.1 q.2.2.1 (Q1.DY.tmap X.1 X.2 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1))
     (apH {CM.TP.HomD q.2.1 X.1 q.2.2.1 q.2.2.2.1 X.2} {V1.Ix ((CM.PD.prodT Y1 Y1).ob q.2.1 q.2.2.2.1)}
        (\ f0 -> CM.cmpS.nt q.2.1 q.2.2.2.1 (Y2.act q.2.1 X.1 q.2.2.1 q.2.2.2.1 X.2 f0 w)) (tmEq q))) ;
   ptB (q : P13.DF.DA.Idx X.1 X.2) (l : P13.DF.DA.LandsI X.1 X.2 q)
    : Id (P13.DF.DB.Ez q.2.1 q.2.2.2.1) (P13.DF.DB.prz q.2.1 q.2.2.2.1 (d1.1 q l) (DMc.b q l)) (DMc.v q l) = DMc.pc q l ;
   bkEq : Id (P13.DF.DB.TOb' X.1 X.2 d1) (Q11.Bk[X.1, X.2, ff].res) DMc.res =
    P13.DF.DB.tob-eq X.1 X.2 d1 (Q11.Bk[X.1, X.2, ff].res) DMc.res (\ q l ->
     P13.DF.DB.pr-inj q.2.1 q.2.2.2.1 (d1.1 q l) (ff.1 q l) (DMc.b q l)
      (transH (apH {V1.Ix ((CM.PD.prodT Y1 Y1).ob q.2.1 q.2.2.2.1)} {P13.DF.DB.Ez q.2.1 q.2.2.2.1} (\ e -> (d1.1 q l, e)) (ptA q l))
        (symH (ptB q l)))) ;
   nfEq : Id (P13.DF.DB.TOb' X.1 X.2 d1) (Q11.Bk[X.1, X.2, ff].res) (O.EQ.PNa.nf X d1 a0) =
    transH bkEq (TYB.pr-inj X d1 DMc.res (O.EQ.PNa.nf X d1 a0) (symH (O.EQ.PNa.q X d1 a0))) ;
  } ;
  end0 (X : CT.TC.TOb) (o : V1.Ix (CT.P1.ob X)) (w : V1.Ix (Y2.ob X.1 X.2)) : Id (TGT.EI X) (tv X o w X (CT.TC.tid X) (PB.ptH X.1 PB.e0)) (HC.aE X (o, w)) =
   apH {Q1.DY.Ob' X.1 X.2} {TGT.EI X} (TGT.pr X o)
    (apH {Q2.DY.Ob' X.1 X.2} {Q1.DY.Ob' X.1 X.2} (OP.dY.nt X.1 X.2)
      (apH {V1.Ix (TE.GA.ob X)} {Q2.DY.Ob' X.1 X.2} (Q2.fw X)
        (transH (O.EQ.EI.eta.eob X (z X w)).2.2.1
          (apH {P13.DF.DB.TOb' X.1 X.2 St[X, w].d1} {V1.Ix (TE.GA.ob X)} (\ b0 -> (St[X, w].d1, O.EQ.EI.gN.nfun X St[X, w].d1 b0)) (symH St[X, w].nfEq))))) ;
  end1 (X : CT.TC.TOb) (o : V1.Ix (CT.P1.ob X)) (w : V1.Ix (Y2.ob X.1 X.2)) : Id (TGT.EI X) (tv X o w X (CT.TC.tid X) (PB.ptH X.1 PB.e1)) (HC.bE X (o, w)) =
   apH {Q1.DY.Ob' X.1 X.2} {TGT.EI X} (TGT.pr X o)
    (transH (apH {Q2.DY.Ob' X.1 X.2} {Q1.DY.Ob' X.1 X.2} (OP.dY.nt X.1 X.2)
              (transH (apH {V1.Ix (TE.GA.ob X)} {Q2.DY.Ob' X.1 X.2} (Q2.fw X) (O.EQ.EI.eta.eob X (z X w)).2.2.2) (Q2.fb X.1 X.2 (Q2.DY.tau X.1 X.2 w))))
      (TauS[Y2, Y1, OP.PR.preS].law X.1 X.2 w)) ;
  path (X : CT.TC.TOb) (zz : V1.Ix (HC.GA.ob X)) : V1.Ix (HC.PT.tobP X zz) =
   HC.PT.mkPath X zz (\ Vv g j -> tv X (HC.TA.pr1 X zz) (HC.TA.pr2 X zz) Vv g j)
    (\ Vb Va g2 g j -> tn X (HC.TA.pr1 X zz) (HC.TA.pr2 X zz) Vb Va g2 g j)
    (\ Vv g j -> refl (HC.TA.pr1 X zz)) (end0 X (HC.TA.pr1 X zz) (HC.TA.pr2 X zz)) (end1 X (HC.TA.pr1 X zz) (HC.TA.pr2 X zz)) ;
  zN (J I : CT.TC.TOb) (h : CT.TC.THm J I) (w : V1.Ix (Y2.ob I.1 I.2)) : Id (V1.Ix (TE.GA.ob J)) (TE.GA.act J I h (z I w)) (z J (Y2.act J.1 I.1 h.1 J.2 I.2 h.2 w)) =
   transH (symH (Q2.bkN J I h (Q2.DY.tau I.1 I.2 w)))
    (apH {Q2.DY.Ob' J.1 J.2} {V1.Ix (TE.GA.ob J)} (Q2.bk J.1 J.2) (symH (Q2.DY.tau-nat J.1 I.1 h.1 J.2 I.2 h.2 w))) ;
  enat (J I : CT.TC.TOb) (h : CT.TC.THm J I) (zz : V1.Ix (HC.GA.ob I)) (zz' : V1.Ix (HC.GA.ob J)) (ee : Id (V1.Ix (HC.GA.ob J)) (HC.GA.act J I h zz) zz')
   : Id (V1.Ix (HC.PT.tobP J zz')) (HC.PT.PathP.tact J I h zz zz' ee (path I zz)) (path J zz') =
   HC.PT.path-eq J zz' (HC.PT.PathP.tact J I h zz zz' ee (path I zz)) (path J zz') (\ Vv f i ->
    transH (apH {Q1.DY.Ob' Vv.1 Vv.2} {TGT.EI Vv} (TGT.pr Vv (HC.TA.pr1 I zz))
      (apH {Q2.DY.Ob' Vv.1 Vv.2} {Q1.DY.Ob' Vv.1 Vv.2} (OP.dY.nt Vv.1 Vv.2)
        (apH {V1.Ix (TE.GA.ob Vv)} {Q2.DY.Ob' Vv.1 Vv.2} (Q2.fw Vv)
          (transH (TE.pv-res O.EQ.EI.eta J I h (z I (HC.TA.pr2 I zz)) (TE.GA.act J I h (z I (HC.TA.pr2 I zz))) (refl (TE.GA.act J I h (z I (HC.TA.pr2 I zz)))) Vv f i)
            (apH {V1.Ix (TE.GA.ob J)} {V1.Ix (TE.GA.ob Vv)} (\ z2 -> TE.pv O.EQ.EI.eta J z2 Vv f i) (zN J I h (HC.TA.pr2 I zz)))))))
     (apH {V1.Ix (HC.GA.ob J)} {TGT.EI Vv} (\ z2 -> tv J (HC.TA.pr1 J z2) (HC.TA.pr2 J z2) Vv f i) ee)) ;
  -- op (tau a, tau b) ~ tau (w . io)
  compat : PS1.PEl[HC.GA, HC.PT.PathP] = new PS1.PEl[HC.GA, HC.PT.PathP, path, enat] ;
 } ;
 -- addition and multiplication
 module AddC = Opc[CM.II.AddF.M.mor, CM.II.AddF.M.mor-nat] ;
 module MulC = Opc[CM.II.MulF.M.mor, CM.II.MulF.M.mor-nat] ;
 addCompat : PS1.PEl[AddC.HC.GA, AddC.HC.PT.PathP] = AddC.compat ;
 mulCompat : PS1.PEl[MulC.HC.GA, MulC.HC.PT.PathP] = MulC.compat ;
} ;
