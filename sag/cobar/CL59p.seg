-- CL59p.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part p: inv . ev ~ id at the total site, last leg.  Psi2 is
-- tau_Q^-1 tau_Q ev'' pointwise (CTotTauDM over Om), tau_Q's homotopy
-- tau_Q^-1 tau_Q ~ id (CL59h) read over Om, and the composite with the first
-- leg (Kan composition of Q over Om): M1 ~ ev''.
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module H2c (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module HD = CL59o[a].H2[R, encK, pe, y, u].Data[A, rho, rho1, Q] ;
  module OL = HD.OL ;
  module CM2 = HD.CM2 ;
  module HO1 = HD.HO1 ;
  module PS1 = HD.PS1 ;
  module Hyp (ef : TR.G0.GB.CEquiv[a+].EquivOp HD.JD.RM.PD.UG HD.JD.RM.PD.UA HD.JD.RM.PD.UB HD.JD.RM.PD.Uf)
   (mQ : G1.GB.CEquiv[a+].EquivOp CT.P1 Q.1 HD.JD.IVd.B2Q HD.JD.IVd.C15Q.tauM) {
   module H = HD.Hyp[ef, mQ] ;
   module EQt = H.J1.HH.EQt ;
   module TQw = H.TQw ;
   R1 : HO1.NMap[CT.P1, Q.1, Q.1] = HO1.compN CT.P1 Q.1 HD.JD.IVd.B2Q Q.1 EQt.PNa.nm EQt.EI.gN ;
   R1w : HO1.NMap[OL.POm, OL.Qw, OL.Qw] =
    new HO1.NMap[OL.POm, OL.Qw, OL.Qw, \ X o q -> R1.nfun X tt q, \ J I f x x' ee q -> R1.nnat J I f tt tt (H.eps0 J I f x x' ee) q] ;
   R2 : HO1.NMap[OL.POm, OL.Ew, OL.Qw] = HO1.compN OL.POm OL.Ew OL.Qw OL.Qw HD.N2 R1w ;
   -- tau_Q's homotopy over Om
   module T1h = HO1.HT[CT.P1, Q.1, Q.1, R1, HO1.idN CT.P1 Q.1] ;
   module TQ1 = G1.GB.GPre[a+].TyL[CT.P1, Q.1] ;
   zt (X : CT.TC.TOb) (q : V1.Ix (Q.1.tob X tt)) : V1.Ix (T1h.GA.ob X) = (tt, q) ;
   pvt (X : CT.TC.TOb) (q : V1.Ix (Q.1.tob X tt)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv) : TQ1.EI Vv = T1h.pv EQt.EI.eta X (zt X q) Vv g j ;
   pteq (X : CT.TC.TOb) (q : V1.Ix (Q.1.tob X tt)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv)
    : Id (V1.Ix (CT.P1.ob Vv)) (TQ1.pr1 Vv (pvt X q Vv g j)) tt = (EQt.EI.eta.eob X (zt X q)).2.1 Vv g j ;
   Lf (X : CT.TC.TOb) (q : V1.Ix (Q.1.tob X tt)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv) : V1.Ix (Q.1.tob Vv tt) =
    TQ1.coeT Vv (TQ1.pr1 Vv (pvt X q Vv g j)) tt (pteq X q Vv g j) (TQ1.pr2 Vv (pvt X q Vv g j)) ;
   Lf-rd (X : CT.TC.TOb) (q : V1.Ix (Q.1.tob X tt)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv)
    : Id (TQ1.EI Vv) (TQ1.pr Vv tt (Lf X q Vv g j)) (pvt X q Vv g j) =
    symH (TQ1.pr-coe Vv (TQ1.pr1 Vv (pvt X q Vv g j)) tt (pteq X q Vv g j) (TQ1.pr2 Vv (pvt X q Vv g j))) ;
   N2v (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X)) : V1.Ix (Q.1.tob X tt) = HD.N2.nfun X phi e ;
   tvc (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X)) (Vv : CT.TC.TOb) (g : CT.TC.THm Vv X) (j : Hom Vv.1 Iv) : TQw.EI Vv =
    TQw.pr Vv (OL.POm.act Vv X g phi) (Lf X (N2v X phi e) Vv g j) ;
   tnc (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X)) (Vb Va : CT.TC.TOb) (g2 : CT.TC.THm Vb Va) (g : CT.TC.THm Va X) (j : Hom Va.1 Iv)
    : Id (TQw.EI Vb) (TQw.E.act Vb Va g2 (tvc X phi e Va g j)) (tvc X phi e Vb (CT.TC.TotCat.oC Vb Va X g g2) (compH Vb.1 Va.1 Iv j g2.1)) =
    transH (TQw.pr-tact Vb Va g2 (OL.POm.act Va X g phi) (OL.POm.act Vb X (CT.TC.TotCat.oC Vb Va X g g2) phi) (symH (OL.POm.act-o Vb Va X g g2 phi)) (Lf X (N2v X phi e) Va g j))
     (apH {V1.Ix (Q.1.tob Vb tt)} {TQw.EI Vb} (TQw.pr Vb (OL.POm.act Vb X (CT.TC.TotCat.oC Vb Va X g g2) phi))
       (TQ1.pr-inj Vb tt _ (Lf X (N2v X phi e) Vb (CT.TC.TotCat.oC Vb Va X g g2) (compH Vb.1 Va.1 Iv j g2.1))
         (transH (symH (TQ1.pr-tact Vb Va g2 tt tt (H.eps0 Vb Va g2 (OL.POm.act Va X g phi) (OL.POm.act Vb X (CT.TC.TotCat.oC Vb Va X g g2) phi) (symH (OL.POm.act-o Vb Va X g g2 phi))) (Lf X (N2v X phi e) Va g j)))
           (transH (apH {TQ1.EI Va} {TQ1.EI Vb} (TQ1.E.act Vb Va g2) (Lf-rd X (N2v X phi e) Va g j))
             (transH ((EQt.EI.eta.eob X (zt X (N2v X phi e))).1.2 Vb Va g2 g j)
               (symH (Lf-rd X (N2v X phi e) Vb (CT.TC.TotCat.oC Vb Va X g g2) (compH Vb.1 Va.1 Iv j g2.1)))))))) ;
   module HT2c = HO1.HT[OL.POm, OL.Ew, OL.Qw, R2, HD.N2] ;
   endc0 (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X))
    : Id (TQw.EI X) (tvc X phi e X (CT.TC.tid X) (PB.ptH X.1 PB.e0)) (TQw.pr X phi (R2.nfun X phi e)) =
    transH (apH {V1.Ix (OL.POm.ob X)} {TQw.EI X} (\ ph -> TQw.pr X ph (Lf X (N2v X phi e) X (CT.TC.tid X) (PB.ptH X.1 PB.e0))) (OL.POm.act-id X phi))
     (apH {V1.Ix (Q.1.tob X tt)} {TQw.EI X} (TQw.pr X phi)
       (TQ1.pr-inj X tt (Lf X (N2v X phi e) X (CT.TC.tid X) (PB.ptH X.1 PB.e0)) (R1.nfun X tt (N2v X phi e))
         (transH (Lf-rd X (N2v X phi e) X (CT.TC.tid X) (PB.ptH X.1 PB.e0)) (EQt.EI.eta.eob X (zt X (N2v X phi e))).2.2.1))) ;
   endc1 (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X))
    : Id (TQw.EI X) (tvc X phi e X (CT.TC.tid X) (PB.ptH X.1 PB.e1)) (TQw.pr X phi (N2v X phi e)) =
    transH (apH {V1.Ix (OL.POm.ob X)} {TQw.EI X} (\ ph -> TQw.pr X ph (Lf X (N2v X phi e) X (CT.TC.tid X) (PB.ptH X.1 PB.e1))) (OL.POm.act-id X phi))
     (apH {V1.Ix (Q.1.tob X tt)} {TQw.EI X} (TQw.pr X phi)
       (TQ1.pr-inj X tt (Lf X (N2v X phi e) X (CT.TC.tid X) (PB.ptH X.1 PB.e1)) (N2v X phi e)
         (transH (Lf-rd X (N2v X phi e) X (CT.TC.tid X) (PB.ptH X.1 PB.e1)) (EQt.EI.eta.eob X (zt X (N2v X phi e))).2.2.2))) ;
   pathc (X : CT.TC.TOb) (zz : V1.Ix (HT2c.GA.ob X)) : V1.Ix (HT2c.PT.tobP X zz) =
    HT2c.PT.mkPath X zz (\ Vv g j -> tvc X (HT2c.TA.pr1 X zz) (HT2c.TA.pr2 X zz) Vv g j)
     (\ Vb Va g2 g j -> tnc X (HT2c.TA.pr1 X zz) (HT2c.TA.pr2 X zz) Vb Va g2 g j)
     (\ Vv g j -> refl (OL.POm.act Vv X g (HT2c.TA.pr1 X zz)))
     (endc0 X (HT2c.TA.pr1 X zz) (HT2c.TA.pr2 X zz)) (endc1 X (HT2c.TA.pr1 X zz) (HT2c.TA.pr2 X zz)) ;
   zq (J I : CT.TC.TOb) (h : CT.TC.THm J I) (phi : V1.Ix (OL.POm.ob I)) (e : V1.Ix (OL.E.ob I))
    : Id (V1.Ix (T1h.GA.ob J)) (T1h.GA.act J I h (zt I (N2v I phi e))) (zt J (N2v J (OL.POm.act J I h phi) (OL.E.act J I h e))) =
    apH {V1.Ix (Q.1.tob J tt)} {V1.Ix (T1h.GA.ob J)} (zt J)
     (transH (PS1.tact-irr G1.fibCwF-T.nil Q.1 J I h tt tt (refl tt) (H.eps0 J I h phi (OL.POm.act J I h phi) (refl (OL.POm.act J I h phi))) (N2v I phi e))
       (HD.N2.nnat J I h phi (OL.POm.act J I h phi) (refl (OL.POm.act J I h phi)) e)) ;
   ENc (J I : CT.TC.TOb) (h : CT.TC.THm J I) (phi : V1.Ix (OL.POm.ob I)) (e : V1.Ix (OL.E.ob I)) (Vv : CT.TC.TOb) (f : CT.TC.THm Vv J) (i : Hom Vv.1 Iv)
    : Id (TQw.EI Vv) (tvc I phi e Vv (CT.TC.TotCat.oC Vv J I h f) i) (tvc J (OL.POm.act J I h phi) (OL.E.act J I h e) Vv f i) =
    transH (apH {V1.Ix (OL.POm.ob Vv)} {TQw.EI Vv} (\ ph -> TQw.pr Vv ph (Lf I (N2v I phi e) Vv (CT.TC.TotCat.oC Vv J I h f) i)) (OL.POm.act-o Vv J I h f phi))
     (apH {V1.Ix (Q.1.tob Vv tt)} {TQw.EI Vv} (TQw.pr Vv (OL.POm.act Vv J f (OL.POm.act J I h phi)))
       (TQ1.pr-inj Vv tt (Lf I (N2v I phi e) Vv (CT.TC.TotCat.oC Vv J I h f) i) (Lf J (N2v J (OL.POm.act J I h phi) (OL.E.act J I h e)) Vv f i)
         (transH (Lf-rd I (N2v I phi e) Vv (CT.TC.TotCat.oC Vv J I h f) i)
           (transH (T1h.pv-res EQt.EI.eta J I h (zt I (N2v I phi e)) (T1h.GA.act J I h (zt I (N2v I phi e))) (refl (T1h.GA.act J I h (zt I (N2v I phi e)))) Vv f i)
             (transH (apH {V1.Ix (T1h.GA.ob J)} {TQ1.EI Vv} (\ z2 -> T1h.pv EQt.EI.eta J z2 Vv f i) (zq J I h phi e))
               (symH (Lf-rd J (N2v J (OL.POm.act J I h phi) (OL.E.act J I h e)) Vv f i))))))) ;
   enatc (J I : CT.TC.TOb) (h : CT.TC.THm J I) (zz : V1.Ix (HT2c.GA.ob I)) (zz' : V1.Ix (HT2c.GA.ob J)) (ee : Id (V1.Ix (HT2c.GA.ob J)) (HT2c.GA.act J I h zz) zz')
    : Id (V1.Ix (HT2c.PT.tobP J zz')) (HT2c.PT.PathP.tact J I h zz zz' ee (pathc I zz)) (pathc J zz') =
    HT2c.PT.path-eq J zz' (HT2c.PT.PathP.tact J I h zz zz' ee (pathc I zz)) (pathc J zz') (\ Vv f i ->
     transH (ENc J I h (HT2c.TA.pr1 I zz) (HT2c.TA.pr2 I zz) Vv f i)
      (apH {V1.Ix (HT2c.GA.ob J)} {TQw.EI Vv} (\ z2 -> tvc J (HT2c.TA.pr1 J z2) (HT2c.TA.pr2 J z2) Vv f i) ee)) ;
   h2c : PS1.PEl[HT2c.GA, HT2c.PT.PathP] = new PS1.PEl[HT2c.GA, HT2c.PT.PathP, pathc, enatc] ;
   -- Psi2 = tau_Q^-1 tau_Q ev'' pointwise
   module PE2 (X : CT.TC.TOb) (phi : V1.Ix (OL.POm.ob X)) (e : V1.Ix (OL.E.ob X)) {
    wO : CM2.DOm.Ob' X.1 X.2 = CM2.DOm.tau X.1 X.2 phi ;
    module TAE = CTotL14a[a, a+, a+].TauA[CM.IC, OL.OmT, OL.Ew] ;
    module TBQ = CTotL14a[a, a+, a+].TauA[CM.IC, OL.OmT, OL.Qw] ;
    module TQ = HD.JD.IVd.C15Q.LB.TA ;
    module TDM = CTotTauDM[a, a+, a+].TauDM[CM.IC, OL.OmT, OL.Ew, OL.Qw, OL.ev''] ;
    module TD = TDM.At[X.1, X.2, phi, e] ;
    c1 : Id (CM2.DF2.DA.TOb' X.1 X.2 wO) (CM2.C1[X.1, X.2, wO, CM2.DE.tau X.1 X.2 e].res) (TAE.tauA X.1 X.2 phi e) =
     CM2.DF2.DA.tob-eq X.1 X.2 wO (CM2.C1[X.1, X.2, wO, CM2.DE.tau X.1 X.2 e].res) (TAE.tauA X.1 X.2 phi e) (\ q' l -> refl ((CM2.DE.tau X.1 X.2 e).1 q' l)) ;
    module PNe = G1.FT.GEqQinv[a+].PN[OL.POm, OL.Ew, OL.Qw, OL.ev''] ;
    bvEq : Id (V1.Ix (Q.1.tob X tt)) TD.bv (N2v X phi e) =
     transH (TDM.DB.pr-inj X.1 X.2 phi TD.bv (OL.ev2 X phi e) (symH TD.fvE))
      (symH (TQw.pr-inj X phi (N2v X phi e) (OL.ev2 X phi e) (PNe.q X phi e))) ;
    c3 : Id (V1.Ix (HD.JD.IVd.B2Q.tob X tt)) (CM2.C2[X.1, X.2, wO, TBQ.tauA X.1 X.2 phi TD.bv].res) (TQ.tauA X.1 X.2 tt TD.bv) =
     CM2.DQ.tob-eq X.1 X.2 (CM2.DT1.tau X.1 X.2 tt) (CM2.C2[X.1, X.2, wO, TBQ.tauA X.1 X.2 phi TD.bv].res) (TQ.tauA X.1 X.2 tt TD.bv) (\ q' l ->
      PS1.tact-irr G1.fibCwF-T.nil Q.1 (q'.2.1, q'.2.2.2.1) X (q'.2.2.1, CM2.DE.tmap X.1 X.2 q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) tt tt
       (PS1.ntEq OL.POm G1.fibCwF-T.nil (G1.fibCwF-T.eps OL.POm) (q'.2.1, q'.2.2.2.1) X
          (q'.2.2.1, CM2.DE.tmap X.1 X.2 q'.1 q'.2.1 q'.2.2.1 q'.2.2.2.1 q'.2.2.2.2.1) phi (wO.1 q' l) (refl (wO.1 q' l)))
       (refl ((CM2.DT1.tau X.1 X.2 tt).1 q' l)) TD.bv) ;
    module TQB = G1.GB.GPre[a+].TyL[CT.P1, HD.JD.IVd.B2Q] ;
    c5 : Id (V1.Ix (HD.JD.IVd.B2Q.tob X tt)) (TQ.tauA X.1 X.2 tt (N2v X phi e)) (EQt.PNa.nf X tt (N2v X phi e)) =
     TQB.pr-inj X tt (TQ.tauA X.1 X.2 tt (N2v X phi e)) (EQt.PNa.nf X tt (N2v X phi e)) (symH (EQt.PNa.q X tt (N2v X phi e))) ;
    chain : Id (V1.Ix (HD.JD.IVd.B2Q.tob X tt)) (CM2.C2[X.1, X.2, wO, CM2.DF2.DM[X.1, X.2, wO, CM2.C1[X.1, X.2, wO, CM2.DE.tau X.1 X.2 e].res].res].res) (EQt.PNa.nf X tt (N2v X phi e)) =
     transH (apH {CM2.DF2.DA.TOb' X.1 X.2 wO} {V1.Ix (HD.JD.IVd.B2Q.tob X tt)} (\ a0 -> CM2.C2[X.1, X.2, wO, CM2.DF2.DM[X.1, X.2, wO, a0].res].res) c1)
      (transH (apH {CM2.DF2.DB.TOb' X.1 X.2 wO} {V1.Ix (HD.JD.IVd.B2Q.tob X tt)} (\ b0 -> CM2.C2[X.1, X.2, wO, b0].res) TD.law)
        (transH c3 (transH (apH {V1.Ix (Q.1.tob X tt)} {V1.Ix (HD.JD.IVd.B2Q.tob X tt)} (TQ.tauA X.1 X.2 tt) bvEq) c5))) ;
    law : Id (V1.Ix (Q.1.tob X tt)) (H.Psi2N.nfun X phi e) (R2.nfun X phi e) =
     apH {V1.Ix (HD.JD.IVd.B2Q.tob X tt)} {V1.Ix (Q.1.tob X tt)} (EQt.EI.gN.nfun X tt) chain ;
   } ;
   module RT2 = HO1.Ret[OL.POm, OL.Ew, OL.Qw, R2, HD.N2, H.Psi2N, HD.N2, \ I x a0 -> PE2[I, x, a0].law, \ I x a0 -> refl (HD.N2.nfun I x a0), h2c] ;
   -- M1 ~ ev'' over Om
   cQw : G1.GB.CLine[a+].Lines[OL.POm, OL.Qw].CompK[PB.e0, PB.e1].Comp =
    (G1.GB.CFibSub[a+].FibSub[OL.POm, G1.fibCwF-T.nil, G1.fibCwF-T.eps OL.POm, Q.1].sub Q.2).1 ;
   module CA2 = HO1.Cat[OL.POm, OL.Ew, OL.Qw, H.M1, H.Psi2N, HD.N2, cQw, H.h2a, RT2.res] ;
   h2g : PS1.PEl[CA2.GA, CA2.T.PT.PathP] = CA2.res ;
  } ;
 } ;
} ;
