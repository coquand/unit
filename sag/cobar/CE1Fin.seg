-- CE1Fin.seg (canonicity-45; COBAR.md "comparison"): E1 at a copy y',
-- with all parameters filled except the pairing of codes (cop and its two
-- sections, from c2's (K) for pairs): phi (CPhi), Kan composition in G
-- (CFibTc), the readings of +, x (CReadA, CReadA2, CReadM) and of the
-- constants (CRead, CTrips).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module F (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) (y' : SX.Over[R].Presentation) {
 module E = CE1Copy[a].E1C[R, encK, pe, al, eqal, commH, y'] ;
 module HO = E.HO ;
 Nl : L.PCtx = E.Nl ;
 module PH = CPhi[a].Phi[R, encK, pe, y'] ;
 module FT = CFibTc[a].Plug[R, encK, pe, al, eqal, commH, y'] ;
 module RA = CReadA[a].RA[R, encK, pe, al, eqal, commH, y'] ;
 module RA2 = CReadA2[a].RA2[R, encK, pe, al, eqal, commH, y'] ;
 module RMm = CReadM[a].RM[R, encK, pe, al, eqal, commH, y'] ;
 module TP = CTrips[a].TR[R, encK, pe, y'] ;
 module Pair (cop : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, E.Ac]) -> HO.NMap[Nl, X, E.A2c])
   (sec1 : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, E.Ac]) -> L.PEl[L.extP Nl X, HO.HT[Nl, X, E.Ac, HO.compN Nl X E.A2c E.Ac (cop X f1 f2) E.p1c, f1].PT.PathP])
   (sec2 : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, E.Ac]) -> L.PEl[L.extP Nl X, HO.HT[Nl, X, E.Ac, HO.compN Nl X E.A2c E.Ac (cop X f1 f2) E.p2c, f2].PT.PathP]) {
  module H = E.Hyp[PH.phi, cop, sec1, sec2, FT.cTp] ;
  module RR = RA.Rd[cop, sec1, sec2] ;
  module FN = H.Fin[\ X f g -> RR.OpR[E.CM.II.AddF.M.mor, E.CM.II.AddF.M.mor-nat, E.addA, E.addAN, RA2.hAdd].At[X, f, g].res,
    \ X f g -> RR.OpR[E.CM.II.MulF.M.mor, E.CM.II.MulF.M.mor-nat, E.mulA, E.mulAN, RMm.hMul].At[X, f, g].res,
    \ r X -> TP.TP.KRd[r, X].res] ;
  -- G's evaluation of every term agrees with tau' of its evaluation in Q_y'
  E1 : (k : Nat) (t : SX.Over[R].Expr (SX.Fin k))
   -> L.PEl[L.extP Nl (H.AL.Pm k), HO.HT[Nl, H.AL.Pm k, E.Tc, H.AL.evGt k t, HO.compN Nl (H.AL.Pm k) E.Qc E.Tc (H.AL.evA k t) H.tau'].PT.PathP] = FN.E1 ;
 } ;
} ;
