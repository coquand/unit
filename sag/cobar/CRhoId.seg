-- CRhoId.seg (canonicity-45; COBAR.md "Prop 58"): the generators of y.u split
-- into old and new (CSpA2.AY.spl) and back (un), un . spl = id; the input maps
-- of rho's equations (old: tau . pre_(x_i) . pre_(p_u), new: tau . pre_(x_v)) and
-- their homotopies to the generator maps tau . pre_(x_v) of y.u.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module RI (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module AYm = CSpA2[a].AY[R, encK, pe, y, u] ;
 yu : SX.Over[R].Presentation = SX.Rel[R].concat y u ;
 k : Nat = y.1 ;
 -- the new generators inside y.u
 newpos : (m : Nat) -> SX.Fin m -> SX.Fin (Arith[a].plus m k) = split {
  zero -> \ v -> absurd (SX.Fin (Arith[a].plus zero k)) v ;
  suc m | ih -> split { inl w -> inl (ih w) ; inr t -> inr t } } ;
 un (m : Nat) : Arith[a].Plus (SX.Fin k) (SX.Fin m) -> SX.Fin (Arith[a].plus m k) = split {
  inl i -> SX.emb k m i ; inr j -> newpos m j } ;
 unLift (m : Nat) : (w : Arith[a].Plus (SX.Fin k) (SX.Fin m)) -> Id (SX.Fin (Arith[a].plus (suc m) k)) (un (suc m) (AYm.lift m w)) (inl (un m w)) = split {
  inl i -> refl (inl (SX.emb k m i)) ; inr j -> refl (inl (newpos m j)) } ;
 unspl : (m : Nat) (v : SX.Fin (Arith[a].plus m k)) -> Id (SX.Fin (Arith[a].plus m k)) (un m (AYm.spl m v)) v = split {
  zero -> \ v -> refl v ;
  suc m | ih -> split {
   inl v -> transH (unLift m (AYm.spl m v)) (apH {SX.Fin (Arith[a].plus m k)} {SX.Fin (Arith[a].plus (suc m) k)} (\ w -> inl w) (ih v)) ;
   inr t -> refl (inr t) } } ;
 module Tu = CE1Tot[a].T1[R, encK, pe, yu] ;
 module HO1 = Tu.HO1 ;
 module PS1 = Tu.G1.GB.GPre[a+].PS ;
 module RO' (i : SX.Fin k) { module O = CRhoOld[a].RO[R, encK, pe, y, u, i] ; } ;
 -- the input maps, by old / new
 compF : Arith[a].Plus (SX.Fin k) (SX.Fin u.1) -> HO1.NMap[Tu.P1, Tu.XT, Tu.GT] = split {
  inl i -> RO'[i].O.gOld ;
  inr j -> Tu.Rs (var (newpos u.1 j)) } ;
 HF : (w : Arith[a].Plus (SX.Fin k) (SX.Fin u.1)) -> PS1.PEl[PS1.extP Tu.P1 Tu.XT, HO1.HT[Tu.P1, Tu.XT, Tu.GT, compF w, Tu.Rs (var (un u.1 w))].PT.PathP] = split {
  inl i -> RO'[i].O.res ;
  inr j -> HO1.Rf[Tu.P1, Tu.XT, Tu.GT, Tu.Rs (var (newpos u.1 j))].res } ;
 gIn (v : SX.Fin yu.1) : HO1.NMap[Tu.P1, Tu.XT, Tu.GT] = compF (AYm.spl u.1 v) ;
 H (v : SX.Fin yu.1) : PS1.PEl[PS1.extP Tu.P1 Tu.XT, HO1.HT[Tu.P1, Tu.XT, Tu.GT, gIn v, Tu.Rs (var v)].PT.PathP] =
  subst (SX.Fin yu.1) (\ v2 -> PS1.PEl[PS1.extP Tu.P1 Tu.XT, HO1.HT[Tu.P1, Tu.XT, Tu.GT, gIn v, Tu.Rs (var v2)].PT.PathP])
   (un u.1 (AYm.spl u.1 v)) v (unspl u.1 v) (HF (AYm.spl u.1 v)) ;
 -- an equation q = 0 of y.u: G's evaluation of q at rho's inputs ~ G's zero, and as an internal Id
 module E = CEvCong[a].EC[R, encK, pe, yu, SX.Fin yu.1] ;
 module EVm = CEvCong[a].EV[R, encK, pe, yu] ;
 module Eq (q : SX.Over[R].Der[yu].Term) (d : SX.Over[R].Der[yu].Proof q SX.Over[R].Der[yu].zeroE) {
  module C1 = E.Cg[gIn, EVm.g0, H] ;
  module R2 = HO1.Ret[Tu.P1, Tu.XT, Tu.GT, E.Lg gIn q, E.Lg EVm.g0 q, E.Lg gIn q, EVm.TA.I.Lv q,
    \ X o c -> refl ((E.Lg gIn q).nfun X o c), \ X o c -> EVm.eq q X o c, C1.cg q] ;
  module Z = CE1Zero[a].Z[R, encK, pe, yu, q, d] ;
  module C2 = HO1.Cat[Tu.P1, Tu.XT, Tu.GT, E.Lg gIn q, EVm.TA.I.Lv q, EVm.TA.I.Lv (cst R.z), Tu.cB, R2.res, Z.res] ;
  -- the internal Id over yo(y.u)
  module HI = CHtIdG[a].HI[R, encK, pe].At[Tu.P1, Tu.XT, (Tu.GT, CGBr[a].GBr[R, encK, pe].fbGT), E.Lg gIn q, EVm.TA.I.Lv (cst R.z), C2.res] ;
  elq : Tu.G1.fibCwF-T.El HI.K (Tu.G1.fibId-T.IdT HI.K HI.YY HI.a0 HI.b0) = HI.el ;
 } ;
} ;
