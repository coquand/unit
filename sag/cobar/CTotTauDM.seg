-- CTotTauDM.seg (canonicity-45; COBAR.md "Lemma 59"): D commutes with the
-- unit on maps of types at the total site.  For f : A -> B over G (a PMap)
-- and av over g at (I, x),
--   D f (tau_A g av) = tau_B g (f av)        (f av : B over g, along f's
--                                             point equation)
-- index by index: the value of tau_A at an index is A's action along its
-- total map, f commutes with it (f's naturality), and f av read in the
-- total space is (g, f av) (pr-coe); the families agree (tob-eq).
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module TauDM (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module DF = CTotP13a[a, vl, l].DFOf[C, G, A, B, f] ;
 module TA = CTotL14a[a, vl, l].TauA[C, G, A] ;
 module TB = CTotL14a[a, vl, l].TauA[C, G, B] ;
 module P = DF.P ;
 module D = DF.D ;
 module DA = DF.DA ;
 module DB = DF.DB ;
 GP : P.PCtx = DF.GP ;
 module At (I : Ob) (x : DF.Obj I) (g : W0.Ix (G.ob I x)) (av : W0.Ix (A.tob (I, x) g)) {
  fv : P.SigT GP B (I, x) = f.mE (I, x) (P.pairE GP A (I, x) g av) ;
  bv : W0.Ix (B.tob (I, x) g) = DB.coeT I x (P.fstE GP B (I, x) fv) g (f.mpt (I, x) (P.pairE GP A (I, x) g av)) (P.sndE GP B (I, x) fv) ;
  fvE : Id (P.SigT GP B (I, x)) fv (P.pairE GP B (I, x) g bv) =
   DB.pr-coe I x (P.fstE GP B (I, x) fv) g (f.mpt (I, x) (P.pairE GP A (I, x) g av)) (P.sndE GP B (I, x) fv) ;
  module DMt = DF.DM[I, x, D.tau I x g, TA.tauA I x g av] ;
  pt (q : DA.Idx I x) (l : DA.LandsI I x q)
   : Id (DB.Ez q.2.1 q.2.2.2.1) (DMt.v q l) (DB.prz q.2.1 q.2.2.2.1 ((D.tau I x g).1 q l) (TB.tv I x g bv q l)) =
   transH (f.mnat (q.2.1, q.2.2.2.1) (I, x) (q.2.2.1, D.tmap I x q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1) (P.pairE GP A (I, x) g av))
    (apH {P.SigT GP B (I, x)} {DB.Ez q.2.1 q.2.2.2.1} (DB.E.act (q.2.1, q.2.2.2.1) (I, x) (q.2.2.1, D.tmap I x q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1)) fvE) ;
  law : Id (DB.TOb' I x (D.tau I x g)) DMt.res (TB.tauA I x g bv) =
   DB.tob-eq I x (D.tau I x g) DMt.res (TB.tauA I x g bv) (\ q l ->
    DB.pr-inj q.2.1 q.2.2.2.1 ((D.tau I x g).1 q l) (DMt.b q l) (TB.tv I x g bv q l) (transH (DMt.pc q l) (pt q l))) ;
 } ;
} ;
