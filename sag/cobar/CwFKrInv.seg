-- CwFKrInv.seg (canonicity-c2; COBAR.md, Lemma 16's invariance): in a
-- CwF with Pi, Sigma, Swan Id and naive function extensionality,
-- "r has contractible fibres" (CwFQP.Kr) is invariant under homotopy.
--
-- Informal text.  Kr r is the instance at r of one family K1 over
-- G.(Y -> X) (CwFQP.QV, PQm.PK).  An element u of Id(r , r') transports
-- K1(r) to K1(r') (CwFTr.trP): krTr.  A homotopy h : Pi y Id(r y , r' y)
-- gives such a u by NF: krHt.
open Base ;

module KrInv (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr)
  (NF : (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) (f g : C.El G (PS.Pi G A B))
        -> C.El G (PS.Pi G A (IJ.IdT (C.ext G A) B ((PS.Pi-iso G A B).fun f) ((PS.Pi-iso G A B).fun g)))
        -> C.El G (IJ.IdT G (PS.Pi G A B) f g)) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module QP = CwFQP.QP[l, C, PS, SS, IJ, NF] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;

  krTr (G : Ctx) (X Y : Ty G) (r r' : El G (Fun G Y X)) (u : El G (IJ.IdT G (Fun G Y X) r r'))
    (k : El G (QP.Kr G X Y r)) : El G (QP.Kr G X Y r') =
    trE G (subT G QP.QV[G, X, Y].G1 QP.QV[G, X, Y].K1 (sec G (Fun G Y X) r')) (QP.Kr G X Y r') QP.PQm[G, X, Y, r'].PK
      (TR.trP G (Fun G Y X) QP.QV[G, X, Y].K1 r r' u
         (trE G (QP.Kr G X Y r) (subT G QP.QV[G, X, Y].G1 QP.QV[G, X, Y].K1 (sec G (Fun G Y X) r))
            (sym (Ty G) (subT G QP.QV[G, X, Y].G1 QP.QV[G, X, Y].K1 (sec G (Fun G Y X) r)) (QP.Kr G X Y r) QP.PQm[G, X, Y, r].PK) k)) ;

  krHt (G : Ctx) (X Y : Ty G) (r r' : El G (Fun G Y X))
    (h : El G (PS.Pi G Y (IJ.IdT (ext G Y) (wkT G Y X) ((PS.Pi-iso G Y (wkT G Y X)).fun r) ((PS.Pi-iso G Y (wkT G Y X)).fun r'))))
    (k : El G (QP.Kr G X Y r)) : El G (QP.Kr G X Y r') =
    krTr G X Y r r' (NF G Y (wkT G Y X) r r' h) k ;
} ;
