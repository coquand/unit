-- CCst5.seg (canonicity-45; COBAR.md "Prop 58"): the constants' compatibility
-- at the total site (CCst4 generalised from a copy to every total object):
-- for a presentation t, the constant cst r of G and tau of c . can_t . k_r
-- (c : t -> x the point of yo(t), can_t : F0 -> t, k_r : F1 -> F0) are joined
-- by a path homotopy of maps yo(t) -> G over the terminal context: EqQinv's
-- homotopy of D(yo F0 -> 1) at the point (tau tt, tau_A (c . can_t)).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module C5 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation) (r : R.R) {
 module K3 = CCst3[a].Cst3[R, encK, pe] ;
 module K2 = K3.K2 ;
 module FN = K3.Fin[CUF0[a].cF0 R encK pe] ;
 module KR = FN.KR[r] ;
 module CM = K2.CM ;
 module CT = K2.CT ;
 module TR = K2.TR ;
 module G1 = TR.G1 ;
 module HO1 = G1.GB.CHtpyOps[a+] ;
 module P13 = FN.P13 ;
 DG : TR.P1.PCtx = P13.DF.DG ;
 DA0 : TR.P1.PTy[DG] = P13.DF.DA.DTy ;
 DB0 : TR.P1.PTy[DG] = P13.DF.DB.DTy ;
 module EQd = FN.EQd ;
 module TE = HO1.HT[DG, DA0, DA0, HO1.compN DG DA0 DB0 DA0 EQd.PNa.nm EQd.EI.gN, HO1.idN DG DA0] ;
 -- the canonical code F0 -> t, and the point c . can_t of yo(F0)
 module SCan = CM.II.SubC[K2.F0, t, \ v -> absurd (SX.Over[R].Der[t].Term) v, \ pp m -> absurd _ m] ;
 module PC = CM.Pre[t, K2.F0, SCan.M.mor, SCan.M.mor-nat] ;
 module QT = CT.Of[CM.Yo[t].yoT] ;
 mc (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2)) : V1.Ix (K2.Y0.ob X.1 X.2) = PC.pre X.1 X.2 c ;
 module TA0 = CTotL14a[a, a+, a+].TauA[CM.IC, CT.T1, K2.O0.Y1T] ;
 z (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2)) : V1.Ix (TE.GA.ob X) = (P13.DF.D.tau X.1 X.2 tt, TA0.tauA X.1 X.2 tt (mc X c)) ;
 lineC (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2)) (V : CT.TC.TOb) (k : CT.TC.THm V X) (j : Hom V.1 Iv) : KR.DSr.DG.Ob' V.1 V.2 =
  KR.DSr.dmap V.1 V.2 (K2.O0.fw V (TE.pv EQd.EI.eta X (z X c) V k j)) ;
 -- the start: cst r
 module TDM = CTotTauDM[a, a+, a+].TauDM[CM.IC, CT.T1, K2.O0.Y1T, K2.OT.Y1T, K2.cF] ;
 module TYB = G1.GB.GPre[a+].TyL[DG, DB0] ;
 nfEq (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2))
  : Id (P13.DF.DB.TOb' X.1 X.2 (P13.DF.D.tau X.1 X.2 tt)) (EQd.PNa.nf X (P13.DF.D.tau X.1 X.2 tt) (z X c).2) (FN.TA1.tauA X.1 X.2 tt tt) =
  transH (TYB.pr-inj X (P13.DF.D.tau X.1 X.2 tt) (EQd.PNa.nf X (P13.DF.D.tau X.1 X.2 tt) (z X c).2) (TDM.At[X.1, X.2, tt, mc X c].DMt.res)
            (EQd.PNa.q X (P13.DF.D.tau X.1 X.2 tt) (z X c).2))
   (transH TDM.At[X.1, X.2, tt, mc X c].law (apH {V1.Ix (K2.OT.Y1T.tob X tt)} {P13.DF.DB.TOb' X.1 X.2 (P13.DF.D.tau X.1 X.2 tt)} (FN.TA1.tauA X.1 X.2 tt) (isTop TDM.At[X.1, X.2, tt, mc X c].bv tt))) ;
 end0 (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2)) : Id (KR.DSr.DG.Ob' X.1 X.2) (lineC X c X (CT.TC.TotCat.idC X) (PB.ptH X.1 PB.e0)) (KR.cstD X) =
  apH {V1.Ix (TE.GA.ob X)} {KR.DSr.DG.Ob' X.1 X.2} (\ t0 -> KR.DSr.dmap X.1 X.2 (K2.O0.fw X t0))
   (transH (EQd.EI.eta.eob X (z X c)).2.2.1
     (apH {P13.DF.DB.TOb' X.1 X.2 (P13.DF.D.tau X.1 X.2 tt)} {V1.Ix (TE.GA.ob X)} (\ b -> (P13.DF.D.tau X.1 X.2 tt, EQd.EI.gN.nfun X (P13.DF.D.tau X.1 X.2 tt) b)) (nfEq X c))) ;
 -- the end: fw z = tau (c . can), D(yo k) (tau m) = tau (m . k)
 module TO = CTauOps[a, a+, a+].TauOps[CM.IC] ;
 fwz (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2)) : Id (KR.DSr.DD.Ob' X.1 X.2) (K2.O0.fw X (z X c)) (KR.DSr.DD.tau X.1 X.2 (mc X c)) =
  KR.DSr.DD.ob-eq X.1 X.2 (K2.O0.fw X (z X c)) (KR.DSr.DD.tau X.1 X.2 (mc X c)) (\ q l ->
   apH {CM.TP.HomD q.2.1 X.1 q.2.2.1 q.2.2.2.1 X.2} {V1.Ix (K2.Y0.ob q.2.1 q.2.2.2.1)} (\ f0 -> K2.Y0.act q.2.1 X.1 q.2.2.1 q.2.2.2.1 X.2 f0 (mc X c))
    (TO.tmapEq CT.T1 K2.Y0 X.1 X.2 q.1 q.2.1 q.2.2.1 q.2.2.2.1 q.2.2.2.2.1)) ;
 kc (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2)) : V1.Ix (FN.Y1.ob X.1 X.2) = KR.PRe.preS.nt X.1 X.2 (mc X c) ;
 end1 (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2)) : Id (KR.DSr.DG.Ob' X.1 X.2) (lineC X c X (CT.TC.TotCat.idC X) (PB.ptH X.1 PB.e1)) (KR.DSr.DG.tau X.1 X.2 (kc X c)) =
  transH (apH {V1.Ix (TE.GA.ob X)} {KR.DSr.DG.Ob' X.1 X.2} (\ t0 -> KR.DSr.dmap X.1 X.2 (K2.O0.fw X t0)) (EQd.EI.eta.eob X (z X c)).2.2.2)
   (transH (apH {KR.DSr.DD.Ob' X.1 X.2} {KR.DSr.DG.Ob' X.1 X.2} (KR.DSr.dmap X.1 X.2) (fwz X c))
     (TO.TauS[K2.Y0, FN.Y1, KR.PRe.preS].law X.1 X.2 (mc X c))) ;
 -- naturality of the line along total maps g : V' -> V
 lineN (X : CT.TC.TOb) (c : V1.Ix (CM.Yo[t].yoT.ob X.1 X.2)) (V' V : CT.TC.TOb) (g : CT.TC.THm V' V) (k : CT.TC.THm V X) (j : Hom V.1 Iv)
  : Id (KR.DSr.DG.Ob' V'.1 V'.2) (KR.DSr.DG.act V'.1 V.1 g.1 V'.2 V.2 g.2 (lineC X c V k j)) (lineC X c V' (CT.TC.TotCat.oC V' V X k g) (compH V'.1 V.1 Iv j g.1)) =
  transH (symH (KR.DSr.dmap-nat V'.1 V.1 g.1 V'.2 V.2 g.2 (K2.O0.fw V (TE.pv EQd.EI.eta X (z X c) V k j))))
   (apH {KR.DSr.DD.Ob' V'.1 V'.2} {KR.DSr.DG.Ob' V'.1 V'.2} (KR.DSr.dmap V'.1 V'.2)
     (transH (symH (K2.O0.fwN V' V g (TE.pv EQd.EI.eta X (z X c) V k j)))
       (apH {V1.Ix (TE.GA.ob V')} {KR.DSr.DD.Ob' V'.1 V'.2} (K2.O0.fw V') ((EQd.EI.eta.eob X (z X c)).1.2 V' V g k j)))) ;
 -- naturality of the point z in (X, c)
 module ZN (J I : CT.TC.TOb) (h : CT.TC.THm J I) (c : V1.Ix (CM.Yo[t].yoT.ob I.1 I.2)) {
  module TN = TA0.Nat[J.1, I.1, h.1, J.2, I.2, h.2, tt, mc I c] ;
  zN : Id (V1.Ix (TE.GA.ob J)) (TE.GA.act J I h (z I c)) (z J (CM.Yo[t].yoT.act J.1 I.1 h.1 J.2 I.2 h.2 c)) =
   transH (TE.TA.pr-tact J I h (P13.DF.D.tau I.1 I.2 tt) (P13.DF.D.tau J.1 J.2 tt) TN.e (z I c).2)
    (apH {P13.DF.DA.TOb' J.1 J.2 (P13.DF.D.tau J.1 J.2 tt)} {TE.TA.EI J} (TE.TA.pr J (P13.DF.D.tau J.1 J.2 tt))
      (transH TN.law (apH {V1.Ix (K2.Y0.ob J.1 J.2)} {P13.DF.DA.TOb' J.1 J.2 (P13.DF.D.tau J.1 J.2 tt)} (TA0.tauA J.1 J.2 tt)
        (symH (PC.pre-nat J.1 I.1 h.1 J.2 I.2 h.2 c))))) ;
 } ;
 -- the two maps yo(t) -> G over the terminal context, and the homotopy
 GTk : G1.GB.GPre[a+].PS.PTy[CT.P1] = CT.Of[KR.DSr.DG.DCtx].Y1T ;
 cTN : HO1.NMap[CT.P1, QT.Y1T, GTk] = new HO1.NMap[CT.P1, QT.Y1T, GTk, \ X o c -> KR.cstD X, \ J I f x y e c -> KR.NT[J, I, f].law] ;
 kcN (J I : CT.TC.TOb) (f : CT.TC.THm J I) (c : V1.Ix (CM.Yo[t].yoT.ob I.1 I.2))
  : Id (V1.Ix (FN.Y1.ob J.1 J.2)) (FN.Y1.act J.1 I.1 f.1 J.2 I.2 f.2 (kc I c)) (kc J (CM.Yo[t].yoT.act J.1 I.1 f.1 J.2 I.2 f.2 c)) =
  transH (symH (KR.PRe.preS.nt-nat J.1 I.1 f.1 J.2 I.2 f.2 (mc I c)))
   (apH {V1.Ix (K2.Y0.ob J.1 J.2)} {V1.Ix (FN.Y1.ob J.1 J.2)} (KR.PRe.preS.nt J.1 J.2) (symH (PC.pre-nat J.1 I.1 f.1 J.2 I.2 f.2 c))) ;
 rTN : HO1.NMap[CT.P1, QT.Y1T, GTk] = new HO1.NMap[CT.P1, QT.Y1T, GTk, \ X o c -> KR.DSr.DG.tau X.1 X.2 (kc X c),
  \ J I f x y e c -> transH (symH (KR.DSr.DG.tau-nat J.1 I.1 f.1 J.2 I.2 f.2 (kc I c)))
     (apH {V1.Ix (FN.Y1.ob J.1 J.2)} {KR.DSr.DG.Ob' J.1 J.2} (KR.DSr.DG.tau J.1 J.2) (kcN J I f c))] ;
 module T = HO1.HT[CT.P1, QT.Y1T, GTk, cTN, rTN] ;
 prE (X : CT.TC.TOb) (p p' : V1.Ix (CT.P1.ob X)) (v v' : KR.DSr.DG.Ob' X.1 X.2) (q : Id (KR.DSr.DG.Ob' X.1 X.2) v v')
  : Id (T.TB.EI X) (T.TB.pr X p v) (T.TB.pr X p' v') =
  transH (apH {V1.Ix (CT.P1.ob X)} {T.TB.EI X} (\ p2 -> T.TB.pr X p2 v) (isTop p p')) (apH {KR.DSr.DG.Ob' X.1 X.2} {T.TB.EI X} (T.TB.pr X p') q) ;
 val (X : CT.TC.TOb) (zz : V1.Ix (T.GA.ob X)) (V : CT.TC.TOb) (k : CT.TC.THm V X) (j : Hom V.1 Iv) : T.TB.EI V =
  T.TB.pr V (T.s X zz V k j) (lineC X zz.2 V k j) ;
 path (X : CT.TC.TOb) (zz : V1.Ix (T.GA.ob X)) : V1.Ix (T.PT.tobP X zz) =
  T.PT.mkPath X zz (val X zz)
   (\ V' V g k j -> transH (T.TB.pr-tact V' V g (T.s X zz V k j) (CT.P1.act V' V g (T.s X zz V k j)) (refl (CT.P1.act V' V g (T.s X zz V k j))) (lineC X zz.2 V k j))
       (prE V' (CT.P1.act V' V g (T.s X zz V k j)) (T.s X zz V' (CT.TC.TotCat.oC V' V X k g) (compH V'.1 V.1 Iv j g.1)) _ _ (lineN X zz.2 V' V g k j)))
   (\ V k j -> refl (T.s X zz V k j))
   (prE X (T.s X zz X (CT.TC.TotCat.idC X) (PB.ptH X.1 PB.e0)) zz.1 _ _ (end0 X zz.2))
   (prE X (T.s X zz X (CT.TC.TotCat.idC X) (PB.ptH X.1 PB.e1)) zz.1 _ _ (end1 X zz.2)) ;
 enat (J I : CT.TC.TOb) (h : CT.TC.THm J I) (zz : V1.Ix (T.GA.ob I)) (zz' : V1.Ix (T.GA.ob J)) (ee : Id (V1.Ix (T.GA.ob J)) (T.GA.act J I h zz) zz')
  : Id (V1.Ix (T.PT.tobP J zz')) (T.PT.PathP.tact J I h zz zz' ee (path I zz)) (path J zz') =
  T.PT.path-eq J zz' (T.PT.PathP.tact J I h zz zz' ee (path I zz)) (path J zz') (\ V f i ->
   transH (prE V (T.s I zz V (CT.TC.TotCat.oC V J I h f) i) (T.s J (T.GA.act J I h zz) V f i) _ _
      (apH {V1.Ix (TE.GA.ob V)} {KR.DSr.DG.Ob' V.1 V.2} (\ t0 -> KR.DSr.dmap V.1 V.2 (K2.O0.fw V t0))
        (transH (TE.pv-res EQd.EI.eta J I h (z I zz.2) (TE.GA.act J I h (z I zz.2)) (refl (TE.GA.act J I h (z I zz.2))) V f i)
          (apH {V1.Ix (TE.GA.ob J)} {V1.Ix (TE.GA.ob V)} (\ z2 -> TE.pv EQd.EI.eta J z2 V f i) ZN[J, I, h, zz.2].zN))))
    (apH {V1.Ix (T.GA.ob J)} {T.TB.EI V} (\ z2 -> val J z2 V f i) ee)) ;
 -- cst r ~ tau (c . can_t . k_r) at the total site
 res : G1.GB.GPre[a+].PS.PEl[T.GA, T.PT.PathP] = new G1.GB.GPre[a+].PS.PEl[T.GA, T.PT.PathP, path, enat] ;
} ;
