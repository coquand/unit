-- CTrLF2.seg (canonicity-c2; SAG 8.3, location-free truncation, part 2):
-- rebasing core's good normal forms along a map of contexts s : D -> G: a
-- good tree over (G, A) rooted at the image of d becomes a tree over
-- (D, A[s]) rooted at d, the children indexed through the images of D's
-- locations (core CTruncRaw.Build at both contexts). Transports along the
-- root equality are by idJ.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = CPosInst[a].PB ; module PR = PB.GPre[a+] ; open PR.PS ;
module W = V[a+] ;
module L = PR.PS ;
decB (W0 X : Ob) (Q : PB.Phi X) (f : Hom W0 X) : Bool = CTruncRaw[a, a+].dec W0 X Q f ;
module Reb (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (B : PTy[D]) (psi : (X : Ob) (d : W.Ix (D.ob X)) -> W.Ix (A.tob X (s.nt X d)) -> W.Ix (B.tob X d)) (psiN : (J I : Ob) (f : Hom J I) (d : W.Ix (D.ob I)) (d' : W.Ix (D.ob J)) (e : Id (W.Ix (D.ob J)) (D.act J I f d) d') (v : W.Ix (A.tob I (s.nt I d))) -> Id (W.Ix (B.tob J d')) (B.tact J I f d d' e (psi I d v)) (psi J d' (A.tact J I f (s.nt I d) (s.nt J d') (ntEq D G s J I f d d' e) v))) {
 module BG = CTruncRaw[a, a+].Build[G, A] ;
 module BD = CTruncRaw[a, a+].Build[D, B] ;
 sl (d : BD.Loc) : BG.Loc = (d.1, s.nt d.1 d.2) ;
 -- an arrow of D's locations, imaged in G
 arrS (r d : BD.Loc) (h : BD.Arr r d) : BG.Arr (sl r) (sl d) =
  (h.1, transH (symH (s.nt-nat r.1 d.1 h.1 d.2)) (apH {W.Ix (D.ob r.1)} {W.Ix (G.ob r.1)} (s.nt r.1) h.2)) ;
 -- transports along an equality of G-locations
 tV (z w : BG.Loc) (e : Id BG.Loc z w) (v : W.Ix (A.tob z.1 z.2)) : W.Ix (A.tob w.1 w.2) =
  subst BG.Loc (\ q -> W.Ix (A.tob q.1 q.2)) z w e v ;
 tQ (z w : BG.Loc) (e : Id BG.Loc z w) (Q : PB.Phi z.1) : PB.Phi w.1 = subst BG.Loc (\ q -> PB.Phi q.1) z w e Q ;
 tA (r z w : BG.Loc) (e : Id BG.Loc z w) (h : BG.Arr r z) : BG.Arr r w = subst BG.Loc (\ q -> BG.Arr r q) z w e h ;
 tL (r z w : BG.Loc) (e : Id BG.Loc z w) (Q : PB.Phi z.1) (h : BG.Arr r w)
   : PB.Lands r.1 w.1 (tQ z w e Q) h.1 -> PB.Lands r.1 z.1 Q ((tA r w z (symH e) h).1) =
  idJ BG.Loc z (\ w2 e2 -> (h2 : BG.Arr r w2) -> PB.Lands r.1 w2.1 (tQ z w2 e2 Q) h2.1 -> PB.Lands r.1 z.1 Q ((tA r w2 z (symH e2) h2).1))
   (\ h2 i -> i) w e h ;
 -- the rebasing
 rb : (t : BG.Raw) -> BG.Good t -> (d : BD.Loc) -> Id BG.Loc (BG.root t) (sl d) -> BD.Raw = split {
  leaf z v -> \ good d e -> leaf d (psi d.1 d.2 (tV z (sl d) e v)) ;
  node z Q u v | ru rv -> \ good d e ->
   node d (tQ z (sl d) e Q)
    (\ r h -> ru (sl r) (tA (sl r) (sl d) z (symH e) (arrS r d h)) (good.2.1 (sl r) (tA (sl r) (sl d) z (symH e) (arrS r d h))).1 r
                (good.2.1 (sl r) (tA (sl r) (sl d) z (symH e) (arrS r d h))).2)
    (\ r h i -> rv (sl r) (tA (sl r) (sl d) z (symH e) (arrS r d h)) (tL (sl r) z (sl d) e Q (arrS r d h) i)
                  (good.2.2.1 (sl r) (tA (sl r) (sl d) z (symH e) (arrS r d h)) (tL (sl r) z (sl d) e Q (arrS r d h) i)).1 r
                  (good.2.2.1 (sl r) (tA (sl r) (sl d) z (symH e) (arrS r d h)) (tL (sl r) z (sl d) e Q (arrS r d h) i)).2) } ;
 -- at on a leaf, for any root equality
 atLeaf (z : BG.Loc) (v : W.Ix (A.tob z.1 z.2)) (q : BG.Loc) (w : BG.Loc) (e : Id BG.Loc z w) (k : BG.Arr q w)
   : Id BG.Raw (BG.at (leaf z v) w e q k) (leaf q (A.tact q.1 w.1 k.1 w.2 q.2 k.2 (tV z w e v))) =
  idJ BG.Loc z (\ w2 e2 -> (k2 : BG.Arr q w2) -> Id BG.Raw (BG.at (leaf z v) w2 e2 q k2) (leaf q (A.tact q.1 w2.1 k2.1 w2.2 q.2 k2.2 (tV z w2 e2 v))))
   (\ k2 -> refl (leaf q (A.tact q.1 z.1 k2.1 z.2 q.2 k2.2 v))) w e k ;
 -- tV along a loop is the identity (locations form a set)
 tVloop (q : BG.Loc) (e : Id BG.Loc q q) (v : W.Ix (A.tob q.1 q.2)) : Id (W.Ix (A.tob q.1 q.2)) (tV q q e v) v =
  apH {Id BG.Loc q q} {W.Ix (A.tob q.1 q.2)} (\ p -> tV q q p v) (BG.loc-set q q e (refl q)) ;
 module GG = CTruncGood[a, a+].GoodSets[G, A] ;
 -- rb depends only on the tree (goodness and root equality are irrelevant)
 rbIrr (t : BG.Raw) (g g' : BG.Good t) (d : BD.Loc) (e e' : Id BG.Loc (BG.root t) (sl d)) : Id BD.Raw (rb t g d e) (rb t g' d e') =
  apH {BG.Good t * Id BG.Loc (BG.root t) (sl d)} {BD.Raw} (\ p -> rb t p.1 d p.2) (GG.witness-prop (sl d) t (g, e) (g', e')) ;
 rbCong (t t' : BG.Raw) (p : Id BG.Raw t t') (g : BG.Good t) (g' : BG.Good t') (d : BD.Loc)
   (e : Id BG.Loc (BG.root t) (sl d)) (e' : Id BG.Loc (BG.root t') (sl d)) : Id BD.Raw (rb t g d e) (rb t' g' d e') =
  idJ BG.Raw t (\ t2 p2 -> (g2 : BG.Good t2) (e2 : Id BG.Loc (BG.root t2) (sl d)) -> Id BD.Raw (rb t g d e) (rb t2 g2 d e2))
   (\ g2 e2 -> rbIrr t g g2 d e e2) t' p g' e' ;
 -- rebasing commutes with restriction: the leaf case
 module CmLeaf (z : BG.Loc) (v : W.Ix (A.tob z.1 z.2)) (d : BD.Loc) (e : Id BG.Loc z (sl d)) (r : BD.Loc) (h : BD.Arr r d) {
  t0 : BG.Raw = leaf z v ;
  ag : BG.Good (BG.at t0 (sl d) e (sl r) (arrS r d h)) * Id BG.Loc (BG.root (BG.at t0 (sl d) e (sl r) (arrS r d h))) (sl r) =
   BG.at-good t0 tt (sl d) e (sl r) (arrS r d h) ;
  val : W.Ix (A.tob r.1 (s.nt r.1 r.2)) = A.tact r.1 d.1 h.1 (s.nt d.1 d.2) (s.nt r.1 r.2) (arrS r d h).2 (tV z (sl d) e v) ;
  res : Id BD.Raw (rb (BG.at t0 (sl d) e (sl r) (arrS r d h)) ag.1 r ag.2) (BD.restrict (rb t0 tt d e) r h) =
   transH (rbCong (BG.at t0 (sl d) e (sl r) (arrS r d h)) (leaf (sl r) val) (atLeaf z v (sl r) (sl d) e (arrS r d h)) ag.1 tt r ag.2 (refl (sl r)))
    (apH {W.Ix (B.tob r.1 r.2)} {BD.Raw} (\ c -> leaf r c)
      (symH (transH (psiN r.1 d.1 h.1 d.2 r.2 h.2 (tV z (sl d) e v))
        (apH {W.Ix (A.tob r.1 (s.nt r.1 r.2))} {W.Ix (B.tob r.1 r.2)} (psi r.1 r.2)
           (L.tact-irr G A r.1 d.1 h.1 (s.nt d.1 d.2) (s.nt r.1 r.2) (ntEq D G s r.1 d.1 h.1 d.2 r.2 h.2) (arrS r d h).2 (tV z (sl d) e v)))))) ;
 } ;
 -- at is restriction along the transported arrow
 atRes (t0 : BG.Raw) (q w : BG.Loc) (e : Id BG.Loc (BG.root t0) w) (k : BG.Arr q w)
   : Id BG.Raw (BG.at t0 w e q k) (BG.restrict t0 q (tA q w (BG.root t0) (symH e) k)) =
  idJ BG.Loc (BG.root t0) (\ w2 e2 -> (k2 : BG.Arr q w2) -> Id BG.Raw (BG.at t0 w2 e2 q k2) (BG.restrict t0 q (tA q w2 (BG.root t0) (symH e2) k2)))
   (\ k2 -> refl (BG.restrict t0 q k2)) w e k ;
 -- the boundary test, transported
 qv (X : Ob) (Q : PB.Phi X) (Y : Ob) (k : Hom Y X) : Bool = Q.1.1 Y k ;
 bq (z w q : BG.Loc) (e : Id BG.Loc z w) (Q : PB.Phi z.1) (a : BG.Arr q w)
   : Id Bool (qv z.1 Q q.1 (tA q w z (symH e) a).1) (qv w.1 (tQ z w e Q) q.1 a.1) =
  idJ BG.Loc z (\ w2 e2 -> (a2 : BG.Arr q w2) -> Id Bool (qv z.1 Q q.1 (tA q w2 z (symH e2) a2).1) (qv w2.1 (tQ z w2 e2 Q) q.1 a2.1))
   (\ a2 -> refl (qv z.1 Q q.1 a2.1)) w e a ;
 -- the restricted cofibration, transported
 preT (z w q : BG.Loc) (e : Id BG.Loc z w) (Q : PB.Phi z.1) (a : BG.Arr q w)
   : Id (PB.Phi q.1) (PB.pre q.1 z.1 ((tA q w z (symH e) a).1) Q) (PB.pre q.1 w.1 a.1 (tQ z w e Q)) =
  idJ BG.Loc z (\ w2 e2 -> (a2 : BG.Arr q w2) -> Id (PB.Phi q.1) (PB.pre q.1 z.1 ((tA q w2 z (symH e2) a2).1) Q) (PB.pre q.1 w2.1 a2.1 (tQ z w2 e2 Q)))
   (\ a2 -> refl (PB.pre q.1 z.1 a2.1 Q)) w e a ;
 tQloop (q : BG.Loc) (e : Id BG.Loc q q) (Q : PB.Phi q.1) : Id (PB.Phi q.1) (tQ q q e Q) Q =
  apH {Id BG.Loc q q} {PB.Phi q.1} (\ p -> tQ q q p Q) (BG.loc-set q q e (refl q)) ;
 -- arrows and tests under the root transport
 tAloop (q w : BG.Loc) (e : Id BG.Loc w w) (a : BG.Arr q w) : Id (BG.Arr q w) (tA q w w e a) a =
  apH {Id BG.Loc w w} {BG.Arr q w} (\ p -> tA q w w p a) (BG.loc-set w w e (refl w)) ;
 tAcomp (q2 q z w : BG.Loc) (e : Id BG.Loc z w) (a : BG.Arr q w) (b : BG.Arr q2 q)
   : Id (BG.Arr q2 z) (BG.compose q2 q z (tA q w z (symH e) a) b) (tA q2 w z (symH e) (BG.compose q2 q w a b)) =
  idJ BG.Loc z (\ w2 e2 -> (a2 : BG.Arr q w2) -> Id (BG.Arr q2 z) (BG.compose q2 q z (tA q w2 z (symH e2) a2) b) (tA q2 w2 z (symH e2) (BG.compose q2 q w2 a2 b)))
   (\ a2 -> refl (BG.compose q2 q z a2 b)) w e a ;
 arrSc (r2 r d : BD.Loc) (g2 : BD.Arr r2 r) (h : BD.Arr r d)
   : Id (BG.Arr (sl r2) (sl d)) (BG.compose (sl r2) (sl r) (sl d) (arrS r d h) (arrS r2 r g2)) (arrS r2 d (BD.compose r2 r d h g2)) =
  BG.arr-eq (sl r2) (sl d) (BG.compose (sl r2) (sl r) (sl d) (arrS r d h) (arrS r2 r g2)) (arrS r2 d (BD.compose r2 r d h g2)) (refl (compH r2.1 r.1 d.1 h.1 g2.1)) ;
 decEq (z w q : BG.Loc) (e : Id BG.Loc z w) (Q : PB.Phi z.1) (a : BG.Arr q w)
   : Id Bool (decB q.1 z.1 Q (tA q w z (symH e) a).1) (decB q.1 w.1 (tQ z w e Q) a.1) =
  idJ BG.Loc z (\ w2 e2 -> (a2 : BG.Arr q w2) -> Id Bool (decB q.1 z.1 Q (tA q w2 z (symH e2) a2).1) (decB q.1 w2.1 (tQ z w2 e2 Q) a2.1))
   (\ a2 -> refl (decB q.1 z.1 Q a2.1)) w e a ;
 tLi (r z w : BG.Loc) (e : Id BG.Loc z w) (Q : PB.Phi z.1) (h : BG.Arr r w)
   : PB.Lands r.1 z.1 Q (tA r w z (symH e) h).1 -> PB.Lands r.1 w.1 (tQ z w e Q) h.1 =
  idJ BG.Loc z (\ w2 e2 -> (h2 : BG.Arr r w2) -> PB.Lands r.1 z.1 Q (tA r w2 z (symH e2) h2).1 -> PB.Lands r.1 w2.1 (tQ z w2 e2 Q) h2.1)
   (\ h2 i -> i) w e h ;
} ;
