-- CTotPsi21.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 21: bkMv, Psi of the lift back is u.  At
-- each index the two lines of A agree (rho-inj at the context G.A): their
-- levelwise restrictions are the lift back read at cartesian lifts (Cart
-- slice, ivA-id) and u's line restricted (u's naturality through lineL,
-- tail moved).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi21 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P20 = CTotPsi20[a, vl, l].Psi20[C, G, A, e] ;
 module P14 = CTotPsi14[a, vl, l].Psi14[C, G, A, e] ;
 module P17 = P20.P17 ;
 module P13 = P20.P13 ;
 module P12 = P20.P12 ;
 module P10 = P20.P10 ;
 module PO = P20.PO ;
 module TR = PO.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = PO.TC ;
 module VT = PO.VT ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module CL = PO.CL ;
 module DA = P20.DA ;
 module EKg = P20.EKg ;
 module EKd = P20.EKd ;
 module FTg = P20.FTg ;
 module XBE = P12.Q2E.XB ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;

 -- abstract forms of the two steps (checked once, then instantiated)
 module ABS (Y' Y : TC.TOb) (cv : TC.THm Y' Y) (p1 : EKg.TV.EI Y) (f1 : W0.Ix (EKg.SFm.sfOb Y p1))
   (p2 : EKg.TV.EI Y') (f2 : W0.Ix (EKg.SFm.sfOb Y' p2))
   (uN : Id (EKg.TS.EI Y') (EKg.TS.E.act Y' Y cv (EKg.TS.pr Y p1 f1)) (EKg.TS.pr Y' p2 f2)) (j : PB.IvP Y'.1) {
  mid : EKg.TA.EI Y' = f1.1.1.1 Y' (TC.tcomp Y' Y' Y cv (TC.tid Y')) j ;
  l1 : Id (EKg.TA.EI Y') mid (f2.1.1.1 Y' (TC.tid Y') j) =
   ap (EKg.TS.EI Y') (EKg.TA.EI Y') (\ T -> (EKg.TS.pr2 Y' T).1.1.1 Y' (TC.tid Y') j)
    (EKg.TS.E.act Y' Y cv (EKg.TS.pr Y p1 f1)) (EKg.TS.pr Y' p2 f2) uN ;
  l2 : Id (EKg.TA.EI Y') mid (f1.1.1.1 Y' cv j) =
   ap (TC.THm Y' Y) (EKg.TA.EI Y') (\ k -> f1.1.1.1 Y' k j) (TC.tcomp Y' Y' Y cv (TC.tid Y')) cv (G1.GB.BC.oC-idr Y' Y cv) ;
  law : Id (EKg.TA.EI Y') (f2.1.1.1 Y' (TC.tid Y') j) (f1.1.1.1 Y' cv j) =
   trans (EKg.TA.EI Y') (f2.1.1.1 Y' (TC.tid Y') j) mid (f1.1.1.1 Y' cv j) (symH l1) l2 ;
 } ;
 module GenL (W1 J : Ob) (vv : Hom W1 J) (z : Obj J) (lnq : W0.Ix (FTg.FE.ob (J, z)))
   (L : (y : Obj W1) (e1 : Id (Obj W1) (C.res W1 J vv z) y) -> W0.Ix (FTg.FE.ob (W1, y))) (j : PB.IvP W1)
   (base : Id (EKg.TA.EI (W1, C.res W1 J vv z)) ((L (C.res W1 J vv z) (refl (C.res W1 J vv z))).1 (W1, C.res W1 J vv z) (TC.tid (W1, C.res W1 J vv z)) j)
             (lnq.1 (W1, C.res W1 J vv z) (vv, C.cart W1 J vv z) j)) {
  gen (y : Obj W1) (e1 : Id (Obj W1) (C.res W1 J vv z) y)
   : Id (EKg.TA.EI (W1, y)) ((L y e1).1 (W1, y) (TC.tid (W1, y)) j)
       (lnq.1 (W1, y) (vv, VT.trD W1 J vv (C.res W1 J vv z) y e1 z (C.cart W1 J vv z)) j) =
   idJ (Obj W1) (C.res W1 J vv z)
    (\ y2 e2 -> Id (EKg.TA.EI (W1, y2)) ((L y2 e2).1 (W1, y2) (TC.tid (W1, y2)) j)
       (lnq.1 (W1, y2) (vv, VT.trD W1 J vv (C.res W1 J vv z) y2 e2 z (C.cart W1 J vv z)) j))
    base y e1 ;
 } ;

 module BM (X : TC.TOb) (w : EKd.TV.EI X) (u : P13.DS.TOb' X.1 X.2 (P10.psi X w)) {
  module B = P17.BKd[X, w, u] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module PQ (n : Nat) (J : Ob) (Ub : Hom J I) (z : Obj J) (cc : CT.Ch J n (C.res J I Ub x) z) (i : Wt.Pn n J) {
   qq : DO.Idx I x = (n, J, Ub, z, cc, i.1) ;
   Y : TC.TOb = (J, z) ;
   lnq : W0.Ix (FTg.FE.ob Y) = B.lineE qq i.2 ;
   cT (W1 : Ob) (vv : Hom W1 J) (y : Obj W1) (e1 : Id (Obj W1) (C.res W1 J vv z) y) : CT.Ch W1 n (C.res W1 I (compH W1 J I Ub vv) x) y =
    subst (Obj W1) (\ t -> CT.Ch W1 n (C.res W1 I (compH W1 J I Ub vv) x) t) (C.res W1 J vv z) y e1 (DO.rCh W1 J I vv Ub x n z cc) ;
   module LV (W1 : Ob) (vv : Hom W1 J) (j : PB.IvP W1) {
    rz : Obj W1 = C.res W1 J vv z ;
    R : Wt.Pn n W1 = Wt.Res[n, W1, J, vv, i].res ;
    Uv : Hom W1 I = compH W1 J I Ub vv ;
    cv : TC.THm (W1, rz) Y = (vv, C.cart W1 J vv z) ;
    lineAt (y : Obj W1) (e1 : Id (Obj W1) rz y) : W0.Ix (FTg.FE.ob (W1, y)) =
     B.lineE (n, W1, Uv, y, cT W1 vv y e1, R.1) R.2 ;
    -- u's naturality: the restricted line is the line at the restricted index
    uN : Id (EKg.TS.EI (W1, rz)) (EKg.TS.E.act (W1, rz) Y cv (EKg.TS.pr Y ((P10.psi X w).1 qq i.2) (u.1 qq i.2)))
           (EKg.TS.pr (W1, rz) ((P10.psi X w).1 (n, W1, Uv, rz, DO.rCh W1 J I vv Ub x n z cc, R.1) R.2) (u.1 (n, W1, Uv, rz, DO.rCh W1 J I vv Ub x n z cc, R.1) R.2)) =
     u.2.1 (qq, (W1, vv)) i.2 ;
    module AB0 = ABS[(W1, rz), Y, cv, (P10.psi X w).1 qq i.2, u.1 qq i.2,
       (P10.psi X w).1 (n, W1, Uv, rz, DO.rCh W1 J I vv Ub x n z cc, R.1) R.2, u.1 (n, W1, Uv, rz, DO.rCh W1 J I vv Ub x n z cc, R.1) R.2,
       uN, j] ;
    base : Id (EKg.TA.EI (W1, rz)) ((lineAt rz (refl rz)).1 (W1, rz) (TC.tid (W1, rz)) j) (lnq.1 (W1, rz) cv j) = AB0.law ;
    gen (y : Obj W1) (e1 : Id (Obj W1) rz y)
     : Id (EKg.TA.EI (W1, y)) ((lineAt y e1).1 (W1, y) (TC.tid (W1, y)) j)
         (lnq.1 (W1, y) (vv, VT.trD W1 J vv rz y e1 z (C.cart W1 J vv z)) j) =
     GenL[W1, J, vv, z, lnq, lineAt, j, base].gen y e1 ;
   } ;
  } ;
 } ;
} ;
