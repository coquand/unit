-- CDFw3.seg (canonicity-c2; (d)(1), part 3): at an old generator j of x.u,
-- z (cls x_j) = h (x_j): z's evaluation moved along p_u's beta (as CCmpU14's
-- Gen), read at the two valuations (ev_x_j at z, and at fwd's valuation).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module PT = CwFPth.Pth[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module Fw3 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F2m = CDFw2[a].Fw2[R, encK, pe, x, u, y] ;
 module F1 = F2m.F1 ;
 module DE = F1.DE ;
 module U13m = DE.U13m ;
 module PM = F1.PC.PM ;
 module C1 = CDCg1[a].Cg1[R, encK, pe, F1.xu, y, F1.s2] ;
 Nl : C.Ctx = C.nil ;
 n : Nat = F2m.n ;
 m : Nat = F1.m ;
 HU : C.Ty Nl = F1.HU ;
 D1 : C.Ctx = F1.D1 ;
 QA : C.Ty Nl = U13m.QA ;
 QH : C.Ty D1 = U13m.QH ;
 QYh : C.Ty D1 = U13m.QYh ;
 module AXx = PM.AS ;
 cp (j : SX.Fin n) : C.El Nl QA = OV.app Nl AXx.Qt QA PM.Phi (AXx.cls (var j)) ;
 cv (j : SX.Fin n) : C.El Nl QA = PM.AT.cls (var (F2m.emb m j)) ;
 -- z's evaluation moved along a closed Id
 atA (c : C.El Nl QA) : C.El D1 QYh = PT.atv D1 QH QYh (OV.bod D1 QH (OV.wkT D1 QH QYh) U13m.ZA.fC) (OV.wkE Nl HU QA c) ;
 rdA (c : C.El Nl QA) (K : Ob) (w : V1.Ix (D1.ob K)) : Id (V1.Ix (QYh.1.tob K w)) ((atA c).eob K w) ((U13m.ZA.apC c).eob K w) =
  transH (CAppRd[a].trE-rd D1 (C.subT D1 (C.ext D1 QH) (OV.wkT D1 QH QYh) (C.sec D1 QH (OV.wkE Nl HU QA c))) QYh
           (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst D1 QH QYh (OV.wkE Nl HU QA c))
           (C.subt D1 (C.ext D1 QH) (OV.wkT D1 QH QYh) (OV.bod D1 QH (OV.wkT D1 QH QYh) U13m.ZA.fC) (C.sec D1 QH (OV.wkE Nl HU QA c))) K w)
   (transH (CAppRd[a].same-rd D1 (C.subT D1 (C.ext D1 QH) (OV.wkT D1 QH QYh) (C.sec D1 QH (OV.wkE Nl HU QA c))) QYh
             (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst D1 QH QYh (OV.wkE Nl HU QA c)) K w (refl (QYh.1.tob K w))
             ((OV.bod D1 QH (OV.wkT D1 QH QYh) U13m.ZA.fC).eob K (w, c.eob K w.1)))
     (transH (QinvEq[a, a+].FunOf[D1, QH, QYh, U13m.ZA.nm].bod-eq K (w, c.eob K w.1)) (symH (U13m.ZA.rdF c K w)))) ;
 aA (j : SX.Fin n) : C.El D1 (IJ.IdT D1 QYh (U13m.ZA.apC (cp j)) (U13m.ZA.apC (cv j))) =
  DE.rwId D1 QYh (atA (cp j)) (U13m.ZA.apC (cp j)) (atA (cv j)) (U13m.ZA.apC (cv j)) (rdA (cp j)) (rdA (cv j))
   (PT.apM D1 QH QYh (OV.bod D1 QH (OV.wkT D1 QH QYh) U13m.ZA.fC) (OV.wkE Nl HU QA (cp j)) (OV.wkE Nl HU QA (cv j))
     (OV.trE D1 (C.subT D1 Nl (IJ.IdT Nl QA (cp j) (cv j)) (C.p Nl HU)) (IJ.IdT D1 QH (OV.wkE Nl HU QA (cp j)) (OV.wkE Nl HU QA (cv j)))
       (IJ.IdT-nat D1 Nl QA (cp j) (cv j) (C.p Nl HU)) (C.subt D1 Nl (IJ.IdT Nl QA (cp j) (cv j)) (PM.beta (var j)) (C.p Nl HU)))) ;
 mv (c c' : C.El Nl QA) (e : C.El Nl (IJ.IdT Nl QA c c')) : C.El D1 (IJ.IdT D1 QYh (U13m.ZA.apC c) (U13m.ZA.apC c')) =
  DE.rwId D1 QYh (atA c) (U13m.ZA.apC c) (atA c') (U13m.ZA.apC c') (rdA c) (rdA c')
   (PT.apM D1 QH QYh (OV.bod D1 QH (OV.wkT D1 QH QYh) U13m.ZA.fC) (OV.wkE Nl HU QA c) (OV.wkE Nl HU QA c')
     (OV.trE D1 (C.subT D1 Nl (IJ.IdT Nl QA c c') (C.p Nl HU)) (IJ.IdT D1 QH (OV.wkE Nl HU QA c) (OV.wkE Nl HU QA c'))
       (IJ.IdT-nat D1 Nl QA c c' (C.p Nl HU)) (C.subt D1 Nl (IJ.IdT Nl QA c c') e (C.p Nl HU)))) ;
} ;
