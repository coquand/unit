-- CTotL16i.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at the total
-- site, SPECIFIC TO OUR C: the lines.  mwe reads MW at weight j in the
-- total space of B2 = (D DAC)[tau_G]; it is natural along total maps
-- (CTotL16h); LP2 is a homotopy al ~ be at the total site (G1) whose line
-- at (g, u) is j |-> MW at j, given its two ends (CTotL14f.LP at G1).
-- No new axioms beyond the named premises (fe).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a+] ;
module VA = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, a+] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module RI (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module RH = CTotL16h[a].RH[R, encK, pe] ;
 IC : CIntCat[a, a+].IC = RH.IC ;
 module VT = RH.VT ;
 module Ln (G : CTPsh[a, a+, a+].TPshOf[IC].TCtx) (A : Presheaf[a+, a+].Psh[CTotCat[a, a+, a+].TotOf[IC].TotCat].PTy[CTotCat[a, a+, a+].TotOf[IC].toP G])
  (Wf : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J) -> Wt.Pn (Ar.plus m (suc n)) J)
  (Wres : (m n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (Ar.plus m (suc n)) J') (Wt.Res[Ar.plus m (suc n), J', J, h, Wf m n J t j i].res)
          (Wf m n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[m, J', J, h, j].res) (Wt.Res[n, J', J, h, i].res)))
  (WfaceR : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J)
          (CTotL16b[a, a+, a+].substP J (Ar.plus m (suc (suc n))) (suc (Ar.plus m (suc n))) (Ar.plus-suc m (suc n)) (Wf m (suc n) J t j (Wt.Face[n, J, k, hk].Of[i].face)))
          (Wt.Face[Ar.plus m (suc n), J, Ar.plus m (suc k), Wt.hRB m n k hk].Of[Wf m n J t j i].face))
  (WfaceL : (m n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc m))) (j : Wt.Pn m J) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (Ar.plus m (suc n))) J) (Wf (suc m) n J t (Wt.Face[m, J, k, hk].Of[j].face) i)
          (Wt.Face[Ar.plus m (suc n), J, k, Wt.hkB m n k hk].Of[Wf m n J t j i].face)) {
  module NT = RH.Nat[G, A, Wf, Wres, WfaceR, WfaceL] ;
  module O = NT.O ;
  module LB = O.LB ;
  module DA = O.DA ;
  module D = O.D ;
  module L16a = O.L16a ;
  module G1 = L16a.G1 ;
  module HO1 = L16a.HO1 ;
  GP : LB.P.PCtx = O.GP ;
  DAC : LB.P.PTy[GP] = L16a.DAC ;
  B2 : LB.P.PTy[GP] = L16a.B2 ;
  module TZ = G1.GB.GPre[a+].TyL[GP, DAC] ;
  module TX = G1.GB.GPre[a+].TyL[GP, B2] ;
  mwe (W : LB.TC.TOb) (z : TZ.EI W) (j : Hom W.1 PFO.ivO) : TX.EI W =
   TX.pr W (TZ.pr1 W z) (O.MW[W.1, W.2, TZ.pr1 W z, TZ.pr2 W z, j].res) ;
  mwe-act (V W : LB.TC.TOb) (g : LB.TC.THm V W) (z : TZ.EI W) (j : Hom W.1 PFO.ivO)
   : Id (TX.EI V) (TX.E.act V W g (mwe W z j)) (mwe V (TZ.E.act V W g z) (PB.compH V.1 W.1 PFO.ivO j g.1)) =
   transH (TX.pr-tact V W g (TZ.pr1 W z) (GP.act V W g (TZ.pr1 W z)) (refl (GP.act V W g (TZ.pr1 W z)))
             (O.MW[W.1, W.2, TZ.pr1 W z, TZ.pr2 W z, j].res))
    (apH {W0.Ix (B2.tob V (GP.act V W g (TZ.pr1 W z)))} {TX.EI V} (TX.pr V (GP.act V W g (TZ.pr1 W z)))
       (NT.At0[V.1, W.1, g.1, V.2, W.2, g.2, TZ.pr1 W z, GP.act V W g (TZ.pr1 W z), refl (GP.act V W g (TZ.pr1 W z)), TZ.pr2 W z, j].nat)) ;
  -- a homotopy al ~ be at the total site whose line at z is j |-> MW at j, given its ends
  module LP2 (al be : HO1.NMap[GP, DAC, B2])
   (en0 : (X : LB.TC.TOb) (z : TZ.EI X) -> Id (TX.EI X) (mwe X z (PB.ptH X.1 PB.e0)) (HO1.HT[GP, DAC, B2, al, be].aE X z))
   (en1 : (X : LB.TC.TOb) (z : TZ.EI X) -> Id (TX.EI X) (mwe X z (PB.ptH X.1 PB.e1)) (HO1.HT[GP, DAC, B2, al, be].bE X z)) {
   module H = HO1.HT[GP, DAC, B2, al, be] ;
   module EL = G1.GB.GPre[a+].PshL[TZ.E] ;
   val (X : LB.TC.TOb) (z : W0.Ix (H.GA.ob X)) (W : LB.TC.TOb) (f : LB.TC.THm W X) (j : Hom W.1 PFO.ivO) : TX.EI W = mwe W (TZ.E.act W X f z) j ;
   path (X : LB.TC.TOb) (z : W0.Ix (H.GA.ob X)) : W0.Ix (H.PT.tobP X z) =
    H.PT.mkPath X z (val X z)
     (\ V W g f j -> transH (mwe-act V W g (TZ.E.act W X f z) j) (apH {TZ.EI V} {TX.EI V} (\ w -> mwe V w (PB.compH V.1 W.1 PFO.ivO j g.1)) (EL.actC V W X f g z)))
     (\ W f j -> refl (GP.act W X f (TZ.pr1 X z)))
     (transH (apH {TZ.EI X} {TX.EI X} (\ w -> mwe X w (PB.ptH X.1 PB.e0)) (EL.actId X (G1.GB.idH X) (refl (G1.GB.idH X)) z)) (en0 X z))
     (transH (apH {TZ.EI X} {TX.EI X} (\ w -> mwe X w (PB.ptH X.1 PB.e1)) (EL.actId X (G1.GB.idH X) (refl (G1.GB.idH X)) z)) (en1 X z)) ;
   enat (J I : LB.TC.TOb) (h : LB.TC.THm J I) (z : W0.Ix (H.GA.ob I)) (z' : W0.Ix (H.GA.ob J)) (e : Id (W0.Ix (H.GA.ob J)) (H.GA.act J I h z) z')
    : Id (W0.Ix (H.PT.tobP J z')) (H.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    H.PT.path-eq J z' (H.PT.PathP.tact J I h z z' e (path I z)) (path J z')
     (\ V f j -> apH {TZ.EI V} {TX.EI V} (\ w -> mwe V w j) (transH (symH (EL.actC V J I h f z)) (apH {TZ.EI J} {TZ.EI V} (TZ.E.act V J f) e))) ;
   res : G1.GB.GPre[a+].PS.PEl[H.GA, H.PT.PathP] = new G1.GB.GPre[a+].PS.PEl[H.GA, H.PT.PathP, path, enat] ;
  } ;
 } ;
} ;
