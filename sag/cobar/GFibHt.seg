-- GFibHt.seg: GENERATED from FibHt.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change FibHt.seg or the generator.
-- FibHt.seg (M1 step 3, S4): from Swan's Id to core's homotopies, and the
-- converse of S2: an internally contractible fibrant type has a relative
-- contractibility structure (core's ContrOp).
--
-- Informal text.
-- (1) For maps al , be : A -> B over G, a homotopy in core's sense
--     (CHtpyOps.HT) is a family of paths in the total space of B, at
--     (x , a), from (x , al a) to (x , be a).  An element w of
--     Id(al' , be') over G.A (al' , be' the maps read as elements of B[p])
--     gives one: its path at (X , z) is the family of its readings, sent to
--     the total space of B by forgetting the A part of the point.  These
--     are natural (natV of w), lie over the constant line (by definition),
--     have the right ends (endV of w at the identity, act-id), and the
--     family is natural in (X , z) (the readings of a restriction, w
--     natural).  (YH)
-- (2) Let T be fibrant with an element of isContr T: centre c, contraction
--     an element of Id(c[p] , q) over G.T.  Extending every partial element
--     by c is an extension relative to the constant map c (the constant map
--     is natural); the contraction is a homotopy from const c to the
--     identity by (1); T's composition corrects the relative extension into
--     an absolute one (CLocBoundRetr.Correct).  (CF)

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module FCw = GFibCwF[l] ;
module FC = FCw.FC ;
module LB = GCLocBoundContr[l] ;
module LR = GCLocBoundRetr[l] ;
module SG = CwFSing.Sing[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, GFibId[l].fibId] ;
module EQ = CwFEq.Eqv[l+, FCw.fibCwF, FCw.fibPi, FCw.fibSig, GFibId[l].fibId] ;

------------------------------------------------------------------------
-- (1) a Swan homotopy is a core homotopy

module YH (G : PCtx) (A B : PTy[G]) (al be : HO.NMap[G, A, B])
  (alP beP : PEl[extP G A, subTy (extP G A) G B (pP G A)])
  (alQ : (X : Ob) (z : W0.Ix ((extP G A).ob X)) -> Id (W0.Ix (B.tob X (fstE G A X z))) (alP.eob X z) (al.nfun X (fstE G A X z) (sndE G A X z)))
  (beQ : (X : Ob) (z : W0.Ix ((extP G A).ob X)) -> Id (W0.Ix (B.tob X (fstE G A X z))) (beP.eob X z) (be.nfun X (fstE G A X z) (sndE G A X z)))
  (w : PEl[extP G A, GPosIdY[l].IdY[extP G A, subTy (extP G A) G B (pP G A), alP, beP].IdYT]) {
  module T = HO.HT[G, A, B, al, be] ;
  module Y = GPosIdY[l].IdY[T.GA, subTy T.GA G B (pP G A), alP, beP] ;

  -- forget the A part of the point
  proj (W : Ob) (v : Y.TA.EI W) : T.TB.EI W = T.TB.pr W (T.TA.pr1 W (Y.TA.pr1 W v)) (Y.TA.pr2 W v) ;

  t (X : Ob) (z : W0.Ix (T.GA.ob X)) (W : Ob) (f : Hom W X) (j : IvP W) : T.TB.EI W = proj W (Y.rd X z (w.eob X z) W f j) ;

  tn (X : Ob) (z : W0.Ix (T.GA.ob X)) (V W : Ob) (g : Hom V W) (f : Hom W X) (j : IvP W)
    : Id (T.TB.EI V) (T.TB.E.act V W g (t X z W f j)) (t X z V (compH V W X f g) (ivA V W g j)) =
    transH (T.TB.pr-tact V W g (T.TA.pr1 W (Y.pt X z W f)) (T.TA.pr1 V (Y.pt X z V (compH V W X f g)))
              (ntEq T.GA G (pP G A) V W g (Y.pt X z W f) (Y.pt X z V (compH V W X f g)) (Y.ptn X z V W g f)) ((w.eob X z).1.1 W f j))
      (apH (T.TB.pr V (T.TA.pr1 V (Y.pt X z V (compH V W X f g)))) ((w.eob X z).1.2.1 V W g f j)) ;

  -- at an end
  te (c : PEl[T.GA, subTy T.GA G B (pP G A)]) (cE : (V : Ob) -> W0.Ix (T.GA.ob V) -> T.TB.EI V)
    (cQ : (X : Ob) (z : W0.Ix (T.GA.ob X)) -> Id (T.TB.EI X) (T.TB.pr X (T.TA.pr1 X z) (c.eob X z)) (cE X z))
    (e : PB.IPt) (X : Ob) (z : W0.Ix (T.GA.ob X))
    (Ez : Id (W0.Ix (B.tob X (T.TA.pr1 X (Y.pt X z X (idH X))))) ((w.eob X z).1.1 X (idH X) (PB.ptH X e)) (c.eob X (Y.pt X z X (idH X))))
    : Id (T.TB.EI X) (t X z X (idH X) (PB.ptH X e)) (cE X z) =
    transH (apH (T.TB.pr X (T.TA.pr1 X (Y.pt X z X (idH X)))) Ez)
      (transH (apH (\ z1 -> T.TB.pr X (T.TA.pr1 X z1) (c.eob X z1)) (T.GA.act-id X z)) (cQ X z)) ;

  path (X : Ob) (z : W0.Ix (T.GA.ob X)) : W0.Ix (T.PT.tobP X z) =
    T.PT.mkPath X z (t X z) (tn X z) (\ W f j -> refl (G.act W X f (T.TA.pr1 X z)))
      (te alP T.aE (\ X1 z1 -> apH (T.TB.pr X1 (T.TA.pr1 X1 z1)) (alQ X1 z1)) e0 X z ((w.eob X z).1.2.2.1 X (idH X)))
      (te beP T.bE (\ X1 z1 -> apH (T.TB.pr X1 (T.TA.pr1 X1 z1)) (beQ X1 z1)) e1 X z ((w.eob X z).1.2.2.2 X (idH X))) ;

  enat (J I : Ob) (h : Hom J I) (z : W0.Ix (T.GA.ob I)) (z' : W0.Ix (T.GA.ob J)) (e : Id (W0.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' e (path I z)) (path J z')
      (\ W f j -> transH (apH (proj W) (symH (Y.Tact[J, I, h, z, z', e, w.eob I z].rdc W f j)))
                    (apH (\ v -> proj W (Y.rd J z' v W f j)) (w.enat J I h z z' e))) ;

  H : PEl[T.GA, T.PT.PathP] = mkPEl T.GA T.PT.PathP path enat ;
} ;

------------------------------------------------------------------------
-- (2) internal contractibility gives a ContrOp

module CF (G : PCtx) (T : FC.STy G) (kc : FCw.fibCwF.El G (EQ.isContr G T)) {
  module TT = GPR.TyL[G, T.1] ;
  GT : PCtx = extP G T.1 ;

  c : PEl[G, T.1] = SG.cenOf G T kc ;
  cst : HO.NMap[G, T.1, T.1] = LB.constant G T.1 c ;

  -- the contraction, an element of Id(c[p] , q) over G.T
  ctr : PEl[GT, GPosIdY[l].IdY[GT, subTy GT G T.1 (pP G T.1), subEl GT G T.1 c (pP G T.1), qP G T.1].IdYT] =
    (FCw.fibPi.Pi-iso G T (SG.JP.IK G T c)).fun (SG.ctrPiOf G T kc) ;

  module Y = YH[G, T.1, T.1, cst, HO.idN G T.1, subEl GT G T.1 c (pP G T.1), qP G T.1,
    \ X z -> refl (c.eob X (fstE G T.1 X z)), \ X z -> refl (sndE G T.1 X z), ctr] ;

  -- the extension by c, relative to the constant map
  cE-act (Y X : Ob) (h : Hom Y X) (x : TT.Pt X)
    : Id (TT.EI Y) (TT.E.act Y X h (TT.pr X x (c.eob X x))) (TT.pr Y (G.act Y X h x) (c.eob Y (G.act Y X h x))) =
    transH (TT.pr-tact Y X h x (G.act Y X h x) (refl (G.act Y X h x)) (c.eob X x))
      (apH (TT.pr Y (G.act Y X h x)) (c.enat Y X h x (G.act Y X h x) (refl (G.act Y X h x)))) ;

  module R = CP.Rel[G, T.1, T.1, LR.Map[G, T.1, T.1, cst].pmap] ;

  kR : R.RC = new R.RC[
    \ X x s -> c.eob X x,
    \ X x s Y h i -> transH (cE-act Y X h x) (apH (\ y -> TT.pr Y y (c.eob Y y)) (symH (s.ppt Y h i))),
    \ Y X h x s -> cE-act Y X h x] ;

  contrOp : CP.ContrOp G T.1 = LR.Correct[G, T.1, cst, kR, Y.H, T.2.1].extension ;
} ;

contrOp (G : PCtx) (T : FC.STy G) (kc : FCw.fibCwF.El G (EQ.isContr G T)) : CP.ContrOp G T.1 = CF[G, T, kc].contrOp ;
