-- CCmpU19.seg (canonicity-c2; (K) for cmpI, part 19): the datum of a binary
-- operation, pulled back to nil.H along each of the two homs, read.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module L = PosFull[a].PB.GPre[a+].PS ;
module U19 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module U13m = CCmpU13[a].U13[R, encK, pe, y] ;
 module U16m = CCmpU16[a].U16[R, encK, pe, y] ;
 module BZ = U16m.BZ ;
 Nl : C.Ctx = C.nil ;
 H : C.Ty Nl = U13m.H ;
 GH : C.Ctx = U13m.GH ;
 HS : C.Ty Nl = U16m.HS ;
 D1 : C.Ctx = U16m.D1 ;
 QA : C.Ty Nl = U16m.QA ;
 QY : C.Ty Nl = U16m.QY ;
 QYh : C.Ty GH = OV.wkT Nl H QY ;
 module PBk (opS : C.El Nl (OV.Fun Nl QA (OV.Fun Nl QA QA))) (opT : C.El Nl (OV.Fun Nl QY (OV.Fun Nl QY QY)))
   (dk : (K : Ob) (w : V1.Ix (D1.ob K)) -> V1.Ix (BZ.BinOf[opS, opT].DataBin.1.tob K (U16m.sAn K w)))
   (dkN : (J I : Ob) (f : Hom J I) (w : V1.Ix (D1.ob I))
     -> Id (V1.Ix (BZ.BinOf[opS, opT].DataBin.1.tob J (U16m.sAn J (D1.act J I f w))))
          ((C.subT D1 U16m.Gh BZ.BinOf[opS, opT].DataBin U16m.sA).1.tact J I f w (D1.act J I f w) (refl (D1.act J I f w)) (dk I w)) (dk J (D1.act J I f w)))
   (ct cs cv : C.El Nl QA) (bt : C.El Nl (IJ.IdT Nl QA (OV.app Nl QA QA (OV.app Nl QA (OV.Fun Nl QA QA) opS ct) cs) cv))
   (pk : (K : Ob) (w : V1.Ix (GH.ob K)) -> V1.Ix (HS.1.tob K w.1))
   (pkN : (J I : Ob) (f : Hom J I) (w : V1.Ix (GH.ob I))
     -> Id (V1.Ix (HS.1.tob J w.1)) (HS.1.tact J I f w.1 w.1 (refl w.1) (pk I w)) (pk J (GH.act J I f w)))
   (apZ : C.El Nl QA -> C.El GH QYh)
   (zr : (c : C.El Nl QA) (K : Ob) (w : V1.Ix (GH.ob K)) -> Id (V1.Ix (QYh.1.tob K w)) ((apZ c).eob K w) (BZ.hv K w.1 (pk K w).1 (c.eob K w.1))) {
  sgN (K : Ob) (w : V1.Ix (GH.ob K)) : V1.Ix (D1.ob K) = (w.1, pk K w) ;
  sg : C.Sub GH D1 = new L.PSub[GH, D1, sgN, \ J I f w -> apH {V1.Ix (HS.1.tob J w.1)} {V1.Ix (D1.ob J)} (\ v -> (w.1, v)) (symH (pkN J I f w))] ;
  module PR = CCmpU17[a].PrOf[QA, opS, ct, cs, cv, bt] ;
  module WPm = CCmpU17[a].WP[QA, opS, ct, cs, cv, PR.pr] ;
  module DBm = U16m.DB[opS, opT, dk, dkN, WPm.wt] ;
  QYd : C.Ty D1 = U16m.QYd ;
  pl : C.El GH (IJ.IdT GH (C.subT GH D1 QYd sg) (C.subt GH D1 QYd DBm.e1 sg) (C.subt GH D1 QYd DBm.e3 sg)) =
   OV.trE GH (C.subT GH D1 (IJ.IdT D1 QYd DBm.e1 DBm.e3) sg) (IJ.IdT GH (C.subT GH D1 QYd sg) (C.subt GH D1 QYd DBm.e1 sg) (C.subt GH D1 QYd DBm.e3 sg))
    (IJ.IdT-nat GH D1 QYd DBm.e1 DBm.e3 sg) (C.subt GH D1 (IJ.IdT D1 QYd DBm.e1 DBm.e3) DBm.res sg) ;
  PY : Id (C.Ty GH) (C.subT GH D1 QYd sg) QYh =
   transH (symH (C.subT-o GH D1 Nl QY (C.p Nl HS) sg)) (U16m.clT GH QY (C.o GH D1 Nl (C.p Nl HS) sg) (C.p Nl H)) ;
  y1 : C.El GH QYh = OV.trE GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd DBm.e1 sg) ;
  y3 : C.El GH QYh = OV.trE GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd DBm.e3 sg) ;
  p2 : C.El GH (IJ.IdT GH QYh y1 y3) = U16m.idFwd GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd DBm.e1 sg) (C.subt GH D1 QYd DBm.e3 sg) pl ;
  module OH = CCmpU18[a].OpH[GH, QY, opT, C.p Nl H] ;
  QK (K : Ob) (w : V1.Ix (GH.ob K)) : U a+ = V1.Ix (QY.1.tob K w.1) ;
  y1r (K : Ob) (w : V1.Ix (GH.ob K)) : Id (QK K w) (y1.eob K w) (OH.P2[apZ ct, apZ cs].val.eob K w) =
   transH (CAppRd[a].trE-rd GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd DBm.e1 sg) K w)
    (transH (CAppRd[a].same-rd GH (C.subT GH D1 QYd sg) QYh PY K w (refl (QYh.1.tob K w)) (DBm.e1.eob K (sgN K w)))
      (transH (DBm.e1rd K (sgN K w))
        (transH (apH {V1.Ix (BZ.BinOf[opS, opT].W4.1.tob K w.1)} {QK K w} (DBm.v1 K (sgN K w)) (WPm.wtrd K w.1))
          (symH (transH (OH.P2[apZ ct, apZ cs].rd K w)
             (transH (apH {QK K w} {QK K w} (\ u -> OH.SO.ev2 K w.1 u ((apZ cs).eob K w)) (zr ct K w))
                (apH {QK K w} {QK K w} (\ u -> OH.SO.ev2 K w.1 (BZ.hv K w.1 (pk K w).1 (ct.eob K w.1)) u) (zr cs K w)))))))) ;
  y3r (K : Ob) (w : V1.Ix (GH.ob K)) : Id (QK K w) (y3.eob K w) ((apZ cv).eob K w) =
   transH (CAppRd[a].trE-rd GH (C.subT GH D1 QYd sg) QYh PY (C.subt GH D1 QYd DBm.e3 sg) K w)
    (transH (CAppRd[a].same-rd GH (C.subT GH D1 QYd sg) QYh PY K w (refl (QYh.1.tob K w)) (DBm.e3.eob K (sgN K w)))
      (transH (DBm.e3rd K (sgN K w))
        (transH (apH {V1.Ix (BZ.BinOf[opS, opT].W4.1.tob K w.1)} {QK K w} (DBm.v3 K (sgN K w)) (WPm.wtrd K w.1))
          (symH (zr cv K w))))) ;
  res : C.El GH (IJ.IdT GH QYh OH.P2[apZ ct, apZ cs].val (apZ cv)) =
   CCmpU14[a].rwId GH QYh y1 OH.P2[apZ ct, apZ cs].val y3 (apZ cv) y1r y3r p2 ;
 } ;
} ;
