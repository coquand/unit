-- CTotUFib4.seg (canonicity-c2; SIMPLIFIED.md item 5): U of a fibration
-- of the total site is a levelwise fibration.
--   KSd.kside   the side law of the composite of CTotUFib3
--   compU       a composition structure of A from e to e' at the total
--               site gives one of U A at the levelwise site
--   fibU        hence a fibration structure (both directions)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module UFib4 (C : CIntCat[a, vl].IC) {
 module U3 = CTotUFib3[a, vl, l].UFib3[C] ;
 module UX = U3.UX ;
 module TR = U3.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;

 module Cm (G : P1.PCtx) (A : P1.PTy[G]) (e e' : G1.GB.IPt)
   (c1 : G1.GB.CLine[l].Lines[G, A].CompK[e, e'].Comp) {
  module CP = U3.Cp[G, A, e, e', c1] ;
  module SD = CP.SD ;
  module EKm = CP.EKm ;
  module EK1 = CP.EK1 ;
  module EK0 = CP.EK0 ;
  module FT1 = CP.FT1 ;
  module FT0 = CP.FT0 ;
  module CK1 = CP.CK1 ;
  module CK0 = CP.CK0 ;
  Tot1 (X : Ob1) : U l = CP.Tot1 X ;

  module KSd (Y : Ob0) (z0 : EK0.TV.EI Y) (s0 : EK0.PT.Side[Y, z0]) (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.Lands Z Y s0.pQ h) {
   module K = CP.KP[Y, z0, s0] ;
   fh : RN.Hom1 (RN.o Z) (RN.o Y) = TR.fn.onH Z Y h ;
   u : EK0.TS.EI Z = s0.pv Z h i ;
   module S = EKm.XS[Z, u] ;
   L : Ob0 = UX.lf Y (RN.o Z) fh ;
   c : RN.Hom0 L Y = UX.cl Y (RN.o Z) fh ;
   vv : RN.Hom1 (RN.o Z) (RN.o L) = SD.vp Y (RN.o Z) fh ;
   id1 : RN.Hom1 (RN.o Z) (RN.o Z) = G1.GB.BC.idC (RN.o Z) ;
   module I = TR.DS.Ini[Y, Z, RN.o Z, h, id1, fh, G1.GB.BC.oC-idr (RN.o Z) (RN.o Y) fh] ;
   j : G0.GB.Lands L Y s0.pQ (G0.GB.BC.oC L Z Y h I.d) = G0.GB.lands-comp L Z Y s0.pQ h I.d i ;
   e1 : Id (EK0.TS.EI L) (EK0.TS.E.act L Z I.d u) (K.P.u (RN.o Z) fh i) =
    trans (EK0.TS.EI L) (EK0.TS.E.act L Z I.d u) (s0.pv L (G0.GB.BC.oC L Z Y h I.d) j) (K.P.u (RN.o Z) fh i)
     (s0.pnat L Z I.d h i j)
     (EK0.PT.pv-hom Y z0 s0 L (G0.GB.BC.oC L Z Y h I.d) c I.eq1 j i) ;
   -- the extended side at the image of h is the extension of the side at h
   pvRet : Id (EK1.TS.EI (RN.o Z)) (K.P.pv (RN.o Z) fh i) S.u1 =
    trans (EK1.TS.EI (RN.o Z)) (K.P.pv (RN.o Z) fh i) (EK1.TS.E.act (RN.o Z) (RN.o L) vv (EK1.TS.E.act (RN.o L) (RN.o Z) (TR.fn.onH L Z I.d) S.u1)) S.u1
     (ap (EK1.TS.EI (RN.o L)) (EK1.TS.EI (RN.o Z)) (\ w -> EK1.TS.E.act (RN.o Z) (RN.o L) vv w) (K.P.x (RN.o Z) fh i)
        (EK1.TS.E.act (RN.o L) (RN.o Z) (TR.fn.onH L Z I.d) S.u1)
        (symH (trans (EK1.TS.EI (RN.o L)) (EK1.TS.E.act (RN.o L) (RN.o Z) (TR.fn.onH L Z I.d) S.u1) (EKm.XS[L, EK0.TS.E.act L Z I.d u].u1) (K.P.x (RN.o Z) fh i)
           EKm.SN[L, Z, I.d, u].nat
           (ap (EK0.TS.EI L) (EK1.TS.EI (RN.o L)) (\ w -> EKm.XS[L, w].u1) (EK0.TS.E.act L Z I.d u) (K.P.u (RN.o Z) fh i) e1))))
     (trans (EK1.TS.EI (RN.o Z)) (EK1.TS.E.act (RN.o Z) (RN.o L) vv (EK1.TS.E.act (RN.o L) (RN.o Z) (TR.fn.onH L Z I.d) S.u1))
        (EK1.TS.E.act (RN.o Z) (RN.o Z) (G1.GB.BC.oC (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z I.d) vv) S.u1) S.u1
        (symH (EK1.TS.E.act-o (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z I.d) vv S.u1))
        (trans (EK1.TS.EI (RN.o Z)) (EK1.TS.E.act (RN.o Z) (RN.o Z) (G1.GB.BC.oC (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z I.d) vv) S.u1)
           (EK1.TS.E.act (RN.o Z) (RN.o Z) id1 S.u1) S.u1
           (ap (RN.Hom1 (RN.o Z) (RN.o Z)) (EK1.TS.EI (RN.o Z)) (\ w -> EK1.TS.E.act (RN.o Z) (RN.o Z) w S.u1)
              (G1.GB.BC.oC (RN.o Z) (RN.o L) (RN.o Z) (TR.fn.onH L Z I.d) vv) id1 I.eq2)
           (EK1.TS.E.act-id (RN.o Z) S.u1))) ;
   -- the other ends, read as totals of A
   en : Id (Tot1 (RN.o Z)) (CP.rd1 (RN.o Z) (CK1.endM (RN.o Z) S.u1)) (CP.rd0 Z (CK0.endM Z u)) =
    trans (Tot1 (RN.o Z)) (CP.rd1 (RN.o Z) (CK1.endM (RN.o Z) S.u1)) (FT1.lval (RN.o Z) S.L.line (RN.o Z) id1 (CP.pe' Z)) (CP.rd0 Z (CK0.endM Z u))
     (trans (Tot1 (RN.o Z)) (CP.rd1 (RN.o Z) (CK1.endM (RN.o Z) S.u1)) (FT1.lval (RN.o Z) (EK1.lineL (RN.o Z) S.u1) (RN.o Z) id1 (CP.pe' Z))
        (FT1.lval (RN.o Z) S.L.line (RN.o Z) id1 (CP.pe' Z))
        (FT1.Ev[e'].endB-E (RN.o Z) (EK1.lineL (RN.o Z) S.u1))
        (ap (EK1.TL.EI (RN.o Z)) (Tot1 (RN.o Z)) (\ M -> FT1.lval (RN.o Z) M (RN.o Z) id1 (CP.pe' Z)) (EK1.lineL (RN.o Z) S.u1) S.L.line
           (EK1.mkTS-line (RN.o Z) S.Z.z1 S.L.line (refl S.Z.x1) S.q)))
     (trans (Tot1 (RN.o Z)) (FT1.lval (RN.o Z) S.L.line (RN.o Z) id1 (CP.pe' Z)) (FT0.lval Z S.L0 Z (EKm.id0 Z) (CP.pe' Z)) (CP.rd0 Z (CK0.endM Z u))
        (trans (Tot1 (RN.o Z)) (FT1.lval (RN.o Z) S.L.line (RN.o Z) id1 (CP.pe' Z)) (FT1.lval (RN.o Z) S.L.line (RN.o Z) (TR.fn.onH Z Z (EKm.id0 Z)) (CP.pe' Z))
           (FT0.lval Z S.L0 Z (EKm.id0 Z) (CP.pe' Z))
           (ap (RN.Hom1 (RN.o Z) (RN.o Z)) (Tot1 (RN.o Z)) (\ k -> FT1.lval (RN.o Z) S.L.line (RN.o Z) k (CP.pe' Z)) id1 (TR.fn.onH Z Z (EKm.id0 Z)) (symH (TR.fn.onId Z)))
           (S.L.lv-ret Z (EKm.id0 Z) (CP.pe' Z)))
        (symH (FT0.Ev[e'].endB-E Z S.L0))) ;
   lhs : CK0.SE.TS.EI Z = CK0.SE.TS.E.act Z Y h K.t0 ;
   S1 : Id (CK1.SE.TS.EI (RN.o Z)) (CK1.SE.TS.E.act (RN.o Z) (RN.o Y) fh K.t1) (CK1.endM (RN.o Z) S.u1) =
    trans (CK1.SE.TS.EI (RN.o Z)) (CK1.SE.TS.E.act (RN.o Z) (RN.o Y) fh K.t1) (CK1.endM (RN.o Z) (K.P.pv (RN.o Z) fh i)) (CK1.endM (RN.o Z) S.u1)
     (c1.kside (RN.o Y) K.Z.z1 K.P.side (RN.o Z) fh i)
     (ap (EK1.TS.EI (RN.o Z)) (CK1.SE.TS.EI (RN.o Z)) (CK1.endM (RN.o Z)) (K.P.pv (RN.o Z) fh i) S.u1 pvRet) ;
   Q2 : Id (Tot1 (RN.o Z)) (CP.rd0 Z lhs) (CP.rd0 Z (CK0.endM Z u)) =
    trans (Tot1 (RN.o Z)) (CP.rd0 Z lhs) (CP.SB1.TC.E.act (RN.o Z) (RN.o Y) fh (CP.rd0 Y K.t0)) (CP.rd0 Z (CK0.endM Z u))
     (CP.rdN0 Z Y h K.t0)
     (trans (Tot1 (RN.o Z)) (CP.SB1.TC.E.act (RN.o Z) (RN.o Y) fh (CP.rd0 Y K.t0)) (CP.SB1.TC.E.act (RN.o Z) (RN.o Y) fh (CP.rd1 (RN.o Y) K.t1)) (CP.rd0 Z (CK0.endM Z u))
        (ap (Tot1 (RN.o Y)) (Tot1 (RN.o Z)) (\ w -> CP.SB1.TC.E.act (RN.o Z) (RN.o Y) fh w) (CP.rd0 Y K.t0) (CP.rd1 (RN.o Y) K.t1) K.rdEq)
        (trans (Tot1 (RN.o Z)) (CP.SB1.TC.E.act (RN.o Z) (RN.o Y) fh (CP.rd1 (RN.o Y) K.t1)) (CP.rd1 (RN.o Z) (CK1.endM (RN.o Z) S.u1)) (CP.rd0 Z (CK0.endM Z u))
           (trans (Tot1 (RN.o Z)) (CP.SB1.TC.E.act (RN.o Z) (RN.o Y) fh (CP.rd1 (RN.o Y) K.t1)) (CP.rd1 (RN.o Z) (CK1.SE.TS.E.act (RN.o Z) (RN.o Y) fh K.t1))
              (CP.rd1 (RN.o Z) (CK1.endM (RN.o Z) S.u1))
              (symH (CP.rdN1 (RN.o Z) (RN.o Y) fh K.t1))
              (ap (CK1.SE.TS.EI (RN.o Z)) (Tot1 (RN.o Z)) (CP.rd1 (RN.o Z)) (CK1.SE.TS.E.act (RN.o Z) (RN.o Y) fh K.t1) (CK1.endM (RN.o Z) S.u1) S1))
           en)) ;
   Pz : Id (EK0.TV.EI Z) (EK0.TV.E.act Z Y h z0) (EK0.TS.pr1 Z u) = symH (s0.ppt Z h i) ;
   kside : Id (CK0.SE.TS.EI Z) lhs (CK0.endM Z u) =
    CK0.SE.mV-inj Z lhs (CK0.endM Z u) Pz
     (CP.SB0.mV-inj Z (CK0.SE.mV Z lhs) (CK0.SE.mV Z (CK0.endM Z u))
        (ap (EK0.TV.EI Z) (W0.Ix (CP.XB.RH.F0.ob Z)) (EK0.TV.pr1 Z) (EK0.TV.E.act Z Y h z0) (EK0.TS.pr1 Z u) Pz) Q2) ;
  } ;

  -- the composition structure of U A from e to e'
  compU : CK0.Comp =
   G0.GB.CPartial[l].Rel[EK0.TV.E, EK0.SFm.SF, CK0.Tend, CK0.endL].mkRC
    (\ Y z0 s0 -> CP.KP[Y, z0, s0].k0)
    (\ Y z0 s0 Z h i -> KSd[Y, z0, s0, Z, h, i].kside)
    (\ Z Y h z0 s0 -> CP.KUn[Z, Y, h, z0, s0].kunif) ;
 } ;

 -- U of a fibration of the total site is a levelwise fibration
 fibU (G : P1.PCtx) (A : P1.PTy[G]) (fb : G1.GB.CLine[l].Lines[G, A].Fib)
  : G0.GB.CLine[l].Lines[RS.rC G, RS.rT G A].Fib =
  (Cm[G, A, G1.GB.e0, G1.GB.e1, fb.1].compU, Cm[G, A, G1.GB.e1, G1.GB.e0, fb.2].compU) ;
} ;
