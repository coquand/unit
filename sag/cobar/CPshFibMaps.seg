-- CPshFibMaps.seg (canonicity-c2; COBAR.md (B), the S3 bridge, part
-- (II-a)): the fibres of a map of base types, on raw data.
--
-- RawFib restates, for a map al : Y -> X of base types over G given as a
-- CPartial.PMap (no packaged element of a function type), what FibS3 does
-- through CwFFv.E: the ends a0 = al y and b0 = x as elements over
-- K = G.X.Y, the comparison FibYC.YC between the Yoneda Id(a0 , b0) and
-- core's IdOver, the fibre FV1 = Sigma Y Id, HFibId, and the four maps
-- toS / frS / embS / prjS.  New here: HFib (core's homotopy fibre) is a
-- retract of FV1, by fN = frS after embS and gN = prjS after toS (mId:
-- toC after frC is the identity, prj after emb is the identity).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module PFm = PresheafFormers[a, l].PFormers[PB.BC] ;
module LR = CLocBoundRetr[a, l] ;
module YCm = FibYC[a, l] ;

module RawFib (G : PCtx) (Y X : PTy[G]) (al : CP.PMap[G, Y, X]) {
 module HF = PB.CEquiv[l].HFib[G, Y, X, al] ;
 module TX = GPR.TyL[G, X] ;
 K : PCtx = HF.EAB ;
 D : PCtx = HF.EA ;
 XD : PTy[D] = subTy D G X (pP G X) ;
 XK : PTy[K] = subTy K D XD (pP D HF.B1) ;

 -- the end al y, over K
 aPt (W : Ob) (z : W0.Ix (K.ob W)) : Id (W0.Ix (G.ob W)) (TX.pr1 W (HF.aE W z)) (HF.sx W z) =
  al.mpt W (GPR.TyL[G, Y].pr W (HF.sx W z) (HF.TAB.pr2 W z)) ;
 a0v (W : Ob) (z : W0.Ix (K.ob W)) : W0.Ix (XK.tob W z) = TX.fromE W (HF.sx W z) (HF.aE W z) (aPt W z) ;
 aQ (W : Ob) (z : W0.Ix (K.ob W)) : Id (TX.EI W) (TX.pr W (HF.sx W z) (a0v W z)) (HF.aE W z) =
  TX.fromE-eq W (HF.sx W z) (HF.aE W z) (aPt W z) ;
 a0n (J I : Ob) (h : Hom J I) (x : W0.Ix (K.ob I)) (y : W0.Ix (K.ob J)) (e : Id (W0.Ix (K.ob J)) (K.act J I h x) y)
  : Id (W0.Ix (XK.tob J y)) (XK.tact J I h x y e (a0v I x)) (a0v J y) =
  TX.pr-inj J (HF.sx J y) (XK.tact J I h x y e (a0v I x)) (a0v J y)
   (transH (symH (TX.pr-tact J I h (HF.sx I x) (HF.sx J y)
                    (ntEq D G (pP G X) J I h ((pP D HF.B1).nt I x) ((pP D HF.B1).nt J y) (ntEq K D (pP D HF.B1) J I h x y e)) (a0v I x)))
     (transH (apH (\ t -> TX.E.act J I h t) (aQ I x))
       (transH (HF.aE-act J I h x) (transH (apH (\ t -> HF.aE J t) e) (symH (aQ J y)))))) ;
 a0 : PEl[K, XK] = mkPEl K XK a0v a0n ;
 -- the end x, over K
 b0 : PEl[K, XK] = subEl K D XD (qP G X) (pP D HF.B1) ;

 module YC = YCm.YC[K, D, G, pP D HF.B1, pP G X, X,
   \ Z x W f i -> HF.sx W (K.act W Z f x), HF.sN, HF.aE, HF.bE, HF.aE-act, HF.bE-act,
   \ Z x W f i -> refl (HF.sx W (K.act W Z f x)),
   a0, b0, aQ, \ W z -> refl (HF.bE W z)] ;

 FV1 : PTy[D] = PFm.SigAB[D, HF.B1, YC.Y.IdYT].SigP ;
 HFibId : PTy[D] = PFm.SigAB[D, HF.B1, YC.IO.IdT].SigP ;
 toS : HO.NMap[D, FV1, HFibId] = YCm.SigN[D, HF.B1, YC.Y.IdYT, YC.IO.IdT, YC.toN].map ;
 frS : HO.NMap[D, HFibId, FV1] = YCm.SigN[D, HF.B1, YC.IO.IdT, YC.Y.IdYT, YC.frN].map ;
 emb : HO.NMap[K, HF.PE.PathP, YC.IO.IdT] = new HO.NMap[K, HF.PE.PathP, YC.IO.IdT,
   \ Z z p -> (p, (PB.emptyS Z, \ W f i j -> absurd (Id (YC.IO.TA.EI W) (p.1.1 W f j) (HF.aE W (K.act W Z f z))) (PB.empty-lands W Z f i))),
   \ J I h x y e p -> YC.IO.idI-eq J y _ _ (refl (HF.PE.PathP.tact J I h x y e p)) (PB.pre-empty J I h)] ;
 prj : HO.NMap[K, YC.IO.IdT, HF.PE.PathP] = new HO.NMap[K, YC.IO.IdT, HF.PE.PathP,
   \ Z z w -> w.1, \ J I h x y e w -> refl (HF.PE.PathP.tact J I h x y e w.1)] ;
 embS : HO.NMap[D, HF.FibT, HFibId] = YCm.SigN[D, HF.B1, HF.PE.PathP, YC.IO.IdT, emb].map ;
 prjS : HO.NMap[D, HFibId, HF.FibT] = YCm.SigN[D, HF.B1, YC.IO.IdT, HF.PE.PathP, prj].map ;

 -- HFib is a retract of FV1
 fN : HO.NMap[D, HF.FibT, FV1] = HO.compN D HF.FibT HFibId FV1 embS frS ;
 gN : HO.NMap[D, FV1, HF.FibT] = HO.compN D FV1 HFibId HF.FibT toS prjS ;
 mId (Z : Ob) (w : SigT D HF.FibT Z)
  : Id (SigT D HF.FibT Z) (LR.Map[D, HF.FibT, HF.FibT, HO.compN D HF.FibT FV1 HF.FibT fN gN].pmap.mE Z w) w =
  apH (\ v -> pairE D HF.FibT Z (fstE D HF.FibT Z w) ((sndE D HF.FibT Z w).1, v.1))
   (YC.to-fr Z (pairE D HF.B1 Z (fstE D HF.FibT Z w) (sndE D HF.FibT Z w).1)
      (emb.nfun Z (pairE D HF.B1 Z (fstE D HF.FibT Z w) (sndE D HF.FibT Z w).1) (sndE D HF.FibT Z w).2)) ;
} ;
