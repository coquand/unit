-- CPshMapC.seg (canonicity-c2; COBAR.md, Lemma 16's invariance): maps
-- of C-types as elements.  For Y , X over G, a map f : Y -> X in
-- Prop13's sense (CMap: a map of the totals over G at each x, commuting
-- with the C-actions) is the same as an element of X[p] over G.Y.
--   ElOf (base)   the element of a PMap: its value at w is the second
--                 component of al w, read over the point of w (fromE)
--   pmap-ext, cmap-ext   maps are determined by their values
--   M[G, Y, X].toEl , ofEl    the two passages
--   of-to , to-of             they are inverse
--   AlOf (base)   the map of an element: (g , y) |-> (g , rb (g , y))
-- Premises: fe.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CP = PB.CPartial[l] ;

------------------------------------------------------------------------
-- base maps are determined by their values

METy (G : PCtx) (B A : PTy[G]) : U l = (X : Ob) -> SigT G B X -> SigT G A X ;
MptTy (G : PCtx) (B A : PTy[G]) (m : METy G B A) : U l =
 (X : Ob) (w : SigT G B X) -> Id (W0.Ix (G.ob X)) (fstE G A X (m X w)) (fstE G B X w) ;
MnatTy (G : PCtx) (B A : PTy[G]) (m : METy G B A) : U l =
 (Y X : Ob) (h : Hom Y X) (w : SigT G B X) -> Id (SigT G A Y) (m Y ((extP G B).act Y X h w)) ((extP G A).act Y X h (m X w)) ;
isProp-Mpt (G : PCtx) (B A : PTy[G]) (m : METy G B A) : isProp (MptTy G B A m) =
 isProp-Pi Ob (\ X -> (w : SigT G B X) -> Id (W0.Ix (G.ob X)) (fstE G A X (m X w)) (fstE G B X w)) (\ X ->
 isProp-Pi (SigT G B X) (\ w -> Id (W0.Ix (G.ob X)) (fstE G A X (m X w)) (fstE G B X w)) (\ w ->
 W0.isSetIx (G.ob X) (fstE G A X (m X w)) (fstE G B X w))) ;
isProp-Mnat (G : PCtx) (B A : PTy[G]) (m : METy G B A) : isProp (MnatTy G B A m) =
 isProp-Pi Ob (\ Y -> (X : Ob) (h : Hom Y X) (w : SigT G B X) -> Id (SigT G A Y) (m Y ((extP G B).act Y X h w)) ((extP G A).act Y X h (m X w))) (\ Y ->
 isProp-Pi Ob (\ X -> (h : Hom Y X) (w : SigT G B X) -> Id (SigT G A Y) (m Y ((extP G B).act Y X h w)) ((extP G A).act Y X h (m X w))) (\ X ->
 isProp-Pi (Hom Y X) (\ h -> (w : SigT G B X) -> Id (SigT G A Y) (m Y ((extP G B).act Y X h w)) ((extP G A).act Y X h (m X w))) (\ h ->
 isProp-Pi (SigT G B X) (\ w -> Id (SigT G A Y) (m Y ((extP G B).act Y X h w)) ((extP G A).act Y X h (m X w))) (\ w ->
 W0.isSetIx ((extP G A).ob Y) (m Y ((extP G B).act Y X h w)) ((extP G A).act Y X h (m X w)))))) ;
pmap-ext (G : PCtx) (B A : PTy[G]) (al al2 : CP.PMap[G, B, A])
 (q : (X : Ob) (w : SigT G B X) -> Id (SigT G A X) (al.mE X w) (al2.mE X w))
 : Id (CP.PMap[G, B, A]) al al2 =
 transH (CP.pmap-eta G B A al) (transH
  (idJ (METy G B A) al.mE
    (\ m2 P2 -> (mp2 : MptTy G B A m2) (mn2 : MnatTy G B A m2)
       -> Id (CP.PMap[G, B, A]) (CP.mkPMap G B A al.mE al.mpt al.mnat) (CP.mkPMap G B A m2 mp2 mn2))
    (\ mp2 mn2 ->
       transH (apH {MptTy G B A al.mE} {CP.PMap[G, B, A]} (\ z -> CP.mkPMap G B A al.mE z al.mnat) (isProp-Mpt G B A al.mE al.mpt mp2))
              (apH {MnatTy G B A al.mE} {CP.PMap[G, B, A]} (\ z -> CP.mkPMap G B A al.mE mp2 z) (isProp-Mnat G B A al.mE al.mnat mn2)))
    al2.mE (funext Ob (\ X -> SigT G B X -> SigT G A X) al.mE al2.mE (\ X ->
              funext (SigT G B X) (\ w -> SigT G A X) (al.mE X) (al2.mE X) (\ w -> q X w)))
    al2.mpt al2.mnat)
  (symH (CP.pmap-eta G B A al2))) ;

------------------------------------------------------------------------
-- the map of core of an element of X[p] over G.Y
module AlOf (G : PCtx) (Y X : PTy[G]) (rb : PEl[extP G Y, subTy (extP G Y) G X (pP G Y)]) {
 module TX = GPR.TyL[G, X] ;
 module TY = GPR.TyL[G, Y] ;
 alE (W : Ob) (w : SigT G Y W) : SigT G X W = TX.pr W (TY.pr1 W w) (rb.eob W w) ;
 alN (V W : Ob) (h : Hom V W) (w : SigT G Y W) : Id (SigT G X V) (alE V ((extP G Y).act V W h w)) ((extP G X).act V W h (alE W w)) =
  apH (TX.pr V (G.act V W h (TY.pr1 W w)))
   (symH (transH (tact-irr G X V W h (TY.pr1 W w) (G.act V W h (TY.pr1 W w)) (refl (G.act V W h (TY.pr1 W w)))
                    (ntEq (extP G Y) G (pP G Y) V W h w ((extP G Y).act V W h w) (refl ((extP G Y).act V W h w))) (rb.eob W w))
            (rb.enat V W h w ((extP G Y).act V W h w) (refl ((extP G Y).act V W h w))))) ;
 al : CP.PMap[G, Y, X] = new CP.PMap[G, Y, X, alE, \ W w -> refl (TY.pr1 W w), alN] ;
} ;


------------------------------------------------------------------------
-- the element of a base map

module ElOf (G : PCtx) (Y X : PTy[G]) (al : CP.PMap[G, Y, X]) {
 module TX = GPR.TyL[G, X] ;
 module TY = GPR.TyL[G, Y] ;
 GY : PCtx = extP G Y ;
 XY : PTy[GY] = subTy GY G X (pP G Y) ;
 ev (W : Ob) (w : SigT G Y W) : W0.Ix (XY.tob W w) = TX.fromE W (TY.pr1 W w) (al.mE W w) (al.mpt W w) ;
 eQ (W : Ob) (w : SigT G Y W) : Id (SigT G X W) (TX.pr W (TY.pr1 W w) (ev W w)) (al.mE W w) =
  TX.fromE-eq W (TY.pr1 W w) (al.mE W w) (al.mpt W w) ;
 en (J I : Ob) (h : Hom J I) (x : SigT G Y I) (y : SigT G Y J) (e : Id (SigT G Y J) (GY.act J I h x) y)
  : Id (W0.Ix (XY.tob J y)) (XY.tact J I h x y e (ev I x)) (ev J y) =
  TX.pr-inj J (TY.pr1 J y) (XY.tact J I h x y e (ev I x)) (ev J y)
   (transH (symH (TX.pr-tact J I h (TY.pr1 I x) (TY.pr1 J y) (ntEq GY G (pP G Y) J I h x y e) (ev I x)))
     (transH (apH (\ t -> (extP G X).act J I h t) (eQ I x))
       (transH (symH (al.mnat J I h x)) (transH (apH (\ t -> al.mE J t) e) (symH (eQ J y)))))) ;
 el : PEl[GY, XY] = mkPEl GY XY ev en ;
 -- its map is al
 back : Id (CP.PMap[G, Y, X]) AlOf[G, Y, X, el].al al = pmap-ext G Y X AlOf[G, Y, X, el].al al eQ ;
} ;

------------------------------------------------------------------------
-- maps of C-types

module MapCOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module P13 = Prop13[a, l].P13Of[C] ;
 open P ;

 module M (G : CCtx) (Y X : CTy[G]) {
  GY : CCtx = LO.ExtC G Y ;
  module SCX = LO.SC[GY, G, LO.pPC G Y, X] ;
  XY : CTy[GY] = SCX.subCTy ;

  -- C-maps are determined by their values
  MpF : U l = (x : CO) -> CP.PMap[G.ob x, Y.ty x, X.ty x] ;
  MpNat (mp : MpF) : U l =
   (y x : CO) (h : CH y x) (W : Ob) (w : SigT (G.ob x) (Y.ty x) W)
   -> Id (SigT (G.ob y) (X.ty y) W) ((X.tE y x h).nt W ((mp x).mE W w)) ((mp y).mE W ((Y.tE y x h).nt W w)) ;
  mkCMap (mp : MpF) (nn : MpNat mp) : P13.CMap[G, Y, X] = new P13.CMap[G, Y, X, mp, nn] ;
  cmap-eta : (f : P13.CMap[G, Y, X]) -> Id (P13.CMap[G, Y, X]) f (mkCMap f.mp f.mp-nat) =
   split { CMap n k -> refl (mkCMap n k) } ;
  mpNat-prop (mp : MpF) : isProp (MpNat mp) =
   isProp-Pi CO (\ y -> (x : CO) (h : CH y x) (W : Ob) (w : SigT (G.ob x) (Y.ty x) W) -> Id (SigT (G.ob y) (X.ty y) W) ((X.tE y x h).nt W ((mp x).mE W w)) ((mp y).mE W ((Y.tE y x h).nt W w))) (\ y ->
   isProp-Pi CO (\ x -> (h : CH y x) (W : Ob) (w : SigT (G.ob x) (Y.ty x) W) -> Id (SigT (G.ob y) (X.ty y) W) ((X.tE y x h).nt W ((mp x).mE W w)) ((mp y).mE W ((Y.tE y x h).nt W w))) (\ x ->
   isProp-Pi (CH y x) (\ h -> (W : Ob) (w : SigT (G.ob x) (Y.ty x) W) -> Id (SigT (G.ob y) (X.ty y) W) ((X.tE y x h).nt W ((mp x).mE W w)) ((mp y).mE W ((Y.tE y x h).nt W w))) (\ h ->
   isProp-Pi Ob (\ W -> (w : SigT (G.ob x) (Y.ty x) W) -> Id (SigT (G.ob y) (X.ty y) W) ((X.tE y x h).nt W ((mp x).mE W w)) ((mp y).mE W ((Y.tE y x h).nt W w))) (\ W ->
   isProp-Pi (SigT (G.ob x) (Y.ty x) W) (\ w -> Id (SigT (G.ob y) (X.ty y) W) ((X.tE y x h).nt W ((mp x).mE W w)) ((mp y).mE W ((Y.tE y x h).nt W w))) (\ w ->
   W0.isSetIx ((extP (G.ob y) (X.ty y)).ob W) ((X.tE y x h).nt W ((mp x).mE W w)) ((mp y).mE W ((Y.tE y x h).nt W w))))))) ;
  cmap-ext (f g : P13.CMap[G, Y, X]) (H : (x : CO) -> Id (CP.PMap[G.ob x, Y.ty x, X.ty x]) (f.mp x) (g.mp x))
   : Id (P13.CMap[G, Y, X]) f g =
   transH (cmap-eta f)
    (transH (idJ MpF f.mp (\ n1 P1 -> (k1 : MpNat n1) -> Id (P13.CMap[G, Y, X]) (mkCMap f.mp f.mp-nat) (mkCMap n1 k1))
              (\ k1 -> apH (\ k2 -> mkCMap f.mp k2) (mpNat-prop f.mp f.mp-nat k1))
              g.mp (funext CO (\ x -> CP.PMap[G.ob x, Y.ty x, X.ty x]) f.mp g.mp H) g.mp-nat)
      (symH (cmap-eta g))) ;

  -- a map as an element of X[p] over G.Y
  module To (f : P13.CMap[G, Y, X]) {
   module Ex (x : CO) { module E = ElOf[G.ob x, Y.ty x, X.ty x, f.mp x] ; } ;
   toEl : CEl[GY, XY] =
    new CEl[GY, XY, \ x -> Ex[x].E.el,
     \ y x h W w -> SCX.sub-eq y W ((XY.tE y x h).nt W (pairE (GY.ob x) (XY.ty x) W w (Ex[x].E.ev W w)))
        (pairE (GY.ob y) (XY.ty y) W ((GY.act y x h).nt W w) (Ex[y].E.ev W ((GY.act y x h).nt W w)))
        (refl ((GY.act y x h).nt W w))
        (transH (SCX.rBtE y x h W (pairE (GY.ob x) (XY.ty x) W w (Ex[x].E.ev W w)))
          (transH (apH (\ t -> (X.tE y x h).nt W t) (Ex[x].E.eQ W w))
            (transH (f.mp-nat y x h W w) (symH (Ex[y].E.eQ W ((Y.tE y x h).nt W w))))))] ;
  } ;
  toEl (f : P13.CMap[G, Y, X]) : CEl[GY, XY] = To[f].toEl ;

  -- an element of X[p] over G.Y as a map
  module Of (rb : CEl[GY, XY]) {
   module Ax (x : CO) { module A = AlOf[G.ob x, Y.ty x, X.ty x, rb.el x] ; } ;
   ofEl : P13.CMap[G, Y, X] =
    new P13.CMap[G, Y, X, \ x -> Ax[x].A.al,
     \ y x h W w -> transH (symH (SCX.rBtE y x h W (pairE (GY.ob x) (SCX.ST x) W w ((rb.el x).eob W w))))
                     (apH (SCX.rB y W) (rb.el-nat y x h W w))] ;
  } ;
  ofEl (rb : CEl[GY, XY]) : P13.CMap[G, Y, X] = Of[rb].ofEl ;

  of-to (f : P13.CMap[G, Y, X]) : Id (P13.CMap[G, Y, X]) (ofEl (toEl f)) f =
   cmap-ext (ofEl (toEl f)) f (\ x -> To[f].Ex[x].E.back) ;
  to-of (rb : CEl[GY, XY]) : Id (CEl[GY, XY]) (toEl (ofEl rb)) rb =
   EX.cel-ext GY XY (toEl (ofEl rb)) rb (\ x W w ->
    GPR.TyL[G.ob x, X.ty x].pr-inj W (fstE (G.ob x) (Y.ty x) W w) ((((toEl (ofEl rb)).el x)).eob W w) ((rb.el x).eob W w)
     (To[ofEl rb].Ex[x].E.eQ W w)) ;
 } ;
} ;
