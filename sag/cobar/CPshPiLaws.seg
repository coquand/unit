-- CPshPiLaws.seg (canonicity-c2; COBAR.md "Plan: Lemma 54", (B) stage 2(c)):
-- the restriction of Pi_A B to identities, application and abstraction.
--
-- Notation of CPshPi: the value valAt b y f Y h w of a family b at
-- (f , h) and at a total w of A_y.
--
--   valNat-at   base naturality of values (the naturality inside Pi_y):
--               the base action along j sends the value at (f , h , w) to
--               the value at (f , h j , w j)
--   resT        RESTRICTION TO IDENTITIES: the value of a total wP of
--               Pi_A B at x, at f = id_x, h = id_X and a total w of A_x
--               over the point of wP; a total of B_x
--   res-C       resT commutes with the C-actions (B.tE, PiT.tE, A.tE)
--   res-B       resT commutes with the base actions
--   val-res     every value is a restriction: the value of wP at
--               (f , h , w) is resT of wP moved along f and h
--   App         application: app t at w = resT (t at the point of w) w
--   Lam         abstraction: lam v at (y , f) = the base abstraction of v_y
--   beta , eta  app (lam v) = v, lam (app t) = t
--
-- Informal proofs.  res-C: by cnat-at the left side is the value at
-- (id_x f , id , w f); by valRix-at the right side is the value at
-- (f id_y , id , w f).  res-B: the same with valNat-at and valAct-at and
-- the unit laws of the base.  val-res: valAct-at, valRix-at, unit laws.
-- beta: the value of lam v at any (f , h , w) is (w , v w).  eta: by
-- val-res the value of t at (f , h , w) is resT of t moved, and t is
-- natural in C and in the base.
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;

module PiLawOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module PO = CPshPi[a, l].PiOf[C] ;
 open P ;

 module L (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) {
  module PC = PO.PiC[G, A, B] ;
  E : CCtx = PC.E ;

  ------------------------------------------------------------------
  -- base naturality of values

  module VN (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) {
   module S = PC.At[x, X, gm] ;
   aAct (y : CO) (f : CH y x) (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (a : S.FA y f Y h) : S.FA y f Y' (compH Y' Y X h j) =
    PP.PiCode[G.ob y, A.ty y, B.ty y].AactOf X (PP.PiCode[G.ob y, A.ty y, B.ty y].ptOf X (S.ptC y f))
      (PP.PiCode[G.ob y, A.ty y, B.ty y].cOf X (S.ptC y f)) Y Y' h j a ;
   aAct-pr (y : CO) (f : CH y x) (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (a : S.FA y f Y h)
    : Id (PC.TA y Y') ((E.ob y).act Y' Y j (PC.prA y Y (S.ptH y f Y h) a))
        (PC.prA y Y' (S.ptH y f Y' (compH Y' Y X h j)) (aAct y f Y' Y j h a)) =
    PP.PiCode[G.ob y, A.ty y, B.ty y].eOf X (S.ptC y f) Y Y' h j a ;
   valNatT (b : S.Comp) (y : CO) (f : CH y x) (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (a : S.FA y f Y h)
    : Id (PC.TB y Y') ((extP (E.ob y) (B.ty y)).act Y' Y j (S.valT b y f Y h a))
        (S.valT b y f Y' (compH Y' Y X h j) (aAct y f Y' Y j h a)) =
    transH (GPR.TyL[E.ob y, B.ty y].pr-tact Y' Y j (PC.prA y Y (S.ptH y f Y h) a)
              (PC.prA y Y' (S.ptH y f Y' (compH Y' Y X h j)) (aAct y f Y' Y j h a)) (aAct-pr y f Y' Y j h a) (S.val b y f Y h a))
     (apH (\ v -> PC.prB y Y' (PC.prA y Y' (S.ptH y f Y' (compH Y' Y X h j)) (aAct y f Y' Y j h a)) v) ((b y f).2 Y Y' h j a)) ;
   valNat-at (b : S.Comp) (y : CO) (f : CH y x) (Y' Y : Ob) (j : Hom Y' Y) (h : Hom Y X) (w : PC.TA y Y)
    (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (S.ptH y f Y h))
    (r' : Id (W0.Ix ((G.ob y).ob Y')) (fstE (G.ob y) (A.ty y) Y' ((E.ob y).act Y' Y j w)) (S.ptH y f Y' (compH Y' Y X h j)))
    : Id (PC.TB y Y') ((extP (E.ob y) (B.ty y)).act Y' Y j (S.valAt b y f Y h w r))
        (S.valAt b y f Y' (compH Y' Y X h j) ((E.ob y).act Y' Y j w) r') =
    transH (valNatT b y f Y' Y j h (S.coeA y f Y h w r))
     (S.valAt-cong b y f f (refl f) Y' (compH Y' Y X h j) (compH Y' Y X h j) (refl (compH Y' Y X h j))
       (PC.prA y Y' (S.ptH y f Y' (compH Y' Y X h j)) (aAct y f Y' Y j h (S.coeA y f Y h w r))) ((E.ob y).act Y' Y j w)
       (transH (symH (aAct-pr y f Y' Y j h (S.coeA y f Y h w r)))
          (apH (\ w1 -> (E.ob y).act Y' Y j w1) (symH (S.coeA-pr y f Y h w r))))
       (refl (S.ptH y f Y' (compH Y' Y X h j))) r') ;
  } ;

  ------------------------------------------------------------------
  -- restriction to identities

  idPt (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) : Id (W0.Ix ((G.ob x).ob X)) (PC.At[x, X, gm].ptH x (cid x) X (idH X)) gm =
   transH ((G.ob x).act-id X ((G.act x x (cid x)).nt X gm)) (G.act-id x X gm) ;
  -- a path to the point of wP, as a path to the point at the identities
  rId (x : CO) (X : Ob) (wP : PC.TP x X) (w : PC.TA x X)
   (r : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w) (fstE (G.ob x) (PC.piTy x) X wP))
   : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w) (PC.At[x, X, fstE (G.ob x) (PC.piTy x) X wP].ptH x (cid x) X (idH X)) =
   transH r (symH (idPt x X (fstE (G.ob x) (PC.piTy x) X wP))) ;
  resT (x : CO) (X : Ob) (wP : PC.TP x X) (w : PC.TA x X)
   (r : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w) (fstE (G.ob x) (PC.piTy x) X wP)) : PC.TB x X =
   PC.At[x, X, fstE (G.ob x) (PC.piTy x) X wP].valAt (sndE (G.ob x) (PC.piTy x) X wP).1 x (cid x) X (idH X) w (rId x X wP w r) ;
  resT-cong (x : CO) (X : Ob) (wP wP' : PC.TP x X) (eP : Id (PC.TP x X) wP wP') (w w' : PC.TA x X) (ew : Id (PC.TA x X) w w')
   (r : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w) (fstE (G.ob x) (PC.piTy x) X wP))
   (r' : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w') (fstE (G.ob x) (PC.piTy x) X wP'))
   : Id (PC.TB x X) (resT x X wP w r) (resT x X wP' w' r') =
   idJ (PC.TP x X) wP
    (\ wP1 e1 -> (r1 : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w') (fstE (G.ob x) (PC.piTy x) X wP1))
       -> Id (PC.TB x X) (resT x X wP w r) (resT x X wP1 w' r1))
    (\ r1 -> PC.At[x, X, fstE (G.ob x) (PC.piTy x) X wP].valAt-cong (sndE (G.ob x) (PC.piTy x) X wP).1 x (cid x) (cid x) (refl (cid x))
       X (idH X) (idH X) (refl (idH X)) w w' ew (rId x X wP w r) (rId x X wP w' r1))
    wP' eP r' ;

  -- resT commutes with the C-actions
  module RC (y x : CO) (f : CH y x) (X : Ob) (wP : PC.TP x X) (w : PC.TA x X)
   (r : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w) (fstE (G.ob x) (PC.piTy x) X wP))
   (r' : Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (A.ty y) X ((A.tE y x f).nt X w)) (fstE (G.ob y) (PC.piTy y) X (PC.tEn y x f X wP))) {
   g0 : W0.Ix ((G.ob x).ob X) = fstE (G.ob x) (PC.piTy x) X wP ;
   u : PC.At[x, X, g0].PiIx = sndE (G.ob x) (PC.piTy x) X wP ;
   module S = PC.At[x, X, g0] ;
   module Cc = PC.CAct[y, x, f, X, g0] ;
   wf : PC.TA y X = (A.tE y x f).nt X w ;
   R2 : Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (A.ty y) X wf) (S.ptH y (co y y x f (cid y)) X (idH X)) =
    Cc.rS y (cid y) X (idH X) wf (rId y X (PC.tEn y x f X wP) wf r') ;
   cc : Id (CH y x) (co y x x (cid x) f) (co y y x f (cid y)) = transH (co-idl y x f) (symH (co-idr y x f)) ;
   R1 : Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (A.ty y) X wf) (S.ptH y (co y x x (cid x) f) X (idH X)) =
    transH R2 (apH (\ c -> S.ptH y c X (idH X)) (symH cc)) ;
   res : Id (PC.TB y X) ((B.tE y x f).nt X (resT x X wP w r)) (resT y X (PC.tEn y x f X wP) wf r') =
    transH (S.cnat-at u y x f (cid x) X (idH X) w (rId x X wP w r) R1)
     (transH (S.valAt-cong u.1 y (co y x x (cid x) f) (co y y x f (cid y)) cc X (idH X) (idH X) (refl (idH X)) wf wf (refl wf) R1 R2)
       (symH (Cc.valRix-at u.1 y (cid y) X (idH X) wf (rId y X (PC.tEn y x f X wP) wf r') R2))) ;
  } ;
  res-C (y x : CO) (f : CH y x) (X : Ob) (wP : PC.TP x X) (w : PC.TA x X)
   (r : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w) (fstE (G.ob x) (PC.piTy x) X wP))
   (r' : Id (W0.Ix ((G.ob y).ob X)) (fstE (G.ob y) (A.ty y) X ((A.tE y x f).nt X w)) (fstE (G.ob y) (PC.piTy y) X (PC.tEn y x f X wP)))
   : Id (PC.TB y X) ((B.tE y x f).nt X (resT x X wP w r)) (resT y X (PC.tEn y x f X wP) ((A.tE y x f).nt X w) r') =
   RC[y, x, f, X, wP, w, r, r'].res ;

  -- resT commutes with the base actions
  module RB (x : CO) (X' X : Ob) (j : Hom X' X) (wP : PC.TP x X) (w : PC.TA x X)
   (r : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w) (fstE (G.ob x) (PC.piTy x) X wP))
   (r' : Id (W0.Ix ((G.ob x).ob X')) (fstE (G.ob x) (A.ty x) X' ((E.ob x).act X' X j w))
           (fstE (G.ob x) (PC.piTy x) X' ((extP (G.ob x) (PC.piTy x)).act X' X j wP))) {
   g0 : W0.Ix ((G.ob x).ob X) = fstE (G.ob x) (PC.piTy x) X wP ;
   u : PC.At[x, X, g0].PiIx = sndE (G.ob x) (PC.piTy x) X wP ;
   module S = PC.At[x, X, g0] ;
   module Aa = PC.Act[x, X', X, j, g0, (G.ob x).act X' X j g0, refl ((G.ob x).act X' X j g0)] ;
   wPj : PC.TP x X' = (extP (G.ob x) (PC.piTy x)).act X' X j wP ;
   wj : PC.TA x X' = (E.ob x).act X' X j w ;
   R2 : Id (W0.Ix ((G.ob x).ob X')) (fstE (G.ob x) (A.ty x) X' wj) (S.ptH x (cid x) X' (compH X' X' X j (idH X'))) =
    Aa.rS x (cid x) X' (idH X') wj (rId x X' wPj wj r') ;
   cc : Id (Hom X' X) (compH X' X X (idH X) j) (compH X' X' X j (idH X')) = transH (comp-idl X' X j) (symH (comp-idr X' X j)) ;
   R1 : Id (W0.Ix ((G.ob x).ob X')) (fstE (G.ob x) (A.ty x) X' wj) (S.ptH x (cid x) X' (compH X' X X (idH X) j)) =
    transH R2 (apH (\ c -> S.ptH x (cid x) X' c) (symH cc)) ;
   res : Id (PC.TB x X') ((extP (E.ob x) (B.ty x)).act X' X j (resT x X wP w r)) (resT x X' wPj wj r') =
    transH (VN[x, X, g0].valNat-at u.1 x (cid x) X' X j (idH X) w (rId x X wP w r) R1)
     (transH (S.valAt-cong u.1 x (cid x) (cid x) (refl (cid x)) X' (compH X' X X (idH X) j) (compH X' X' X j (idH X')) cc wj wj (refl wj) R1 R2)
       (symH (Aa.valAct-at u.1 x (cid x) X' (idH X') wj (rId x X' wPj wj r') R2))) ;
  } ;
  res-B (x : CO) (X' X : Ob) (j : Hom X' X) (wP : PC.TP x X) (w : PC.TA x X)
   (r : Id (W0.Ix ((G.ob x).ob X)) (fstE (G.ob x) (A.ty x) X w) (fstE (G.ob x) (PC.piTy x) X wP))
   (r' : Id (W0.Ix ((G.ob x).ob X')) (fstE (G.ob x) (A.ty x) X' ((E.ob x).act X' X j w))
           (fstE (G.ob x) (PC.piTy x) X' ((extP (G.ob x) (PC.piTy x)).act X' X j wP)))
   : Id (PC.TB x X') ((extP (E.ob x) (B.ty x)).act X' X j (resT x X wP w r))
       (resT x X' ((extP (G.ob x) (PC.piTy x)).act X' X j wP) ((E.ob x).act X' X j w) r') =
   RB[x, X', X, j, wP, w, r, r'].res ;

  -- every value is a restriction
  module VR (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (u : PC.At[x, X, gm].PiIx)
   (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : PC.TA y Y) {
   module S = PC.At[x, X, gm] ;
   module Cc = PC.CAct[y, x, f, X, gm] ;
   module Aa = PC.Act[y, Y, X, h, (G.act y x f).nt X gm, S.ptH y f Y h, refl (S.ptH y f Y h)] ;
   wM : PC.TP y Y = (extP (G.ob y) (PC.piTy y)).act Y X h (PC.tEn y x f X (PC.prP x X gm u)) ;
   q0 (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (fstE (G.ob y) (PC.piTy y) Y wM)) : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (PC.At[y, Y, S.ptH y f Y h].ptH y (cid y) Y (idH Y)) = rId y Y wM w r' ;
   q1 (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (fstE (G.ob y) (PC.piTy y) Y wM)) : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (Aa.S.ptH y (cid y) Y (compH Y Y X h (idH Y))) =
    Aa.rS y (cid y) Y (idH Y) w (q0 r') ;
   q2 (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (fstE (G.ob y) (PC.piTy y) Y wM)) : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (S.ptH y (co y y x f (cid y)) Y (compH Y Y X h (idH Y))) =
    Cc.rS y (cid y) Y (compH Y Y X h (idH Y)) w (q1 r') ;
   s1 (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (fstE (G.ob y) (PC.piTy y) Y wM)) : Id (PC.TB y Y) (resT y Y wM w r') (Aa.S.valAt (Cc.rixC u.1) y (cid y) Y (compH Y Y X h (idH Y)) w (q1 r')) =
    Aa.valAct-at (Cc.rixC u.1) y (cid y) Y (idH Y) w (q0 r') (q1 r') ;
   s2 (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (fstE (G.ob y) (PC.piTy y) Y wM)) : Id (PC.TB y Y) (Cc.T.valAt (Cc.rixC u.1) y (cid y) Y (compH Y Y X h (idH Y)) w (q1 r'))
       (S.valAt u.1 y (co y y x f (cid y)) Y (compH Y Y X h (idH Y)) w (q2 r')) =
    Cc.valRix-at u.1 y (cid y) Y (compH Y Y X h (idH Y)) w (q1 r') (q2 r') ;
   res (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (S.ptH y f Y h))
    (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (fstE (G.ob y) (PC.piTy y) Y wM))
    : Id (PC.TB y Y) (S.valAt u.1 y f Y h w r) (resT y Y wM w r') =
    symH (transH (s1 r') (transH (s2 r')
      (S.valAt-cong u.1 y (co y y x f (cid y)) f (co-idr y x f) Y (compH Y Y X h (idH Y)) h (comp-idr Y X h) w w (refl w) (q2 r') r))) ;
  } ;

  val-res (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (u : PC.At[x, X, gm].PiIx)
   (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : PC.TA y Y)
   (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (PC.At[x, X, gm].ptH y f Y h))
   (r' : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (fstE (G.ob y) (PC.piTy y) Y VR[x, X, gm, u, y, f, Y, h, w].wM))
   : Id (PC.TB y Y) (PC.At[x, X, gm].valAt u.1 y f Y h w r) (resT y Y VR[x, X, gm, u, y, f, Y, h, w].wM w r') =
   VR[x, X, gm, u, y, f, Y, h, w].res r r' ;

  ------------------------------------------------------------------
  -- application

  module App (t : CEl[G, PC.PiT]) {
   -- t at a point, as a total of Pi
   tP (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) : PC.TP x X = PC.prP x X gm ((t.el x).eob X gm) ;
   tP-B (x : CO) (X' X : Ob) (j : Hom X' X) (gm : W0.Ix ((G.ob x).ob X))
    : Id (PC.TP x X') ((extP (G.ob x) (PC.piTy x)).act X' X j (tP x X gm)) (tP x X' ((G.ob x).act X' X j gm)) =
    symH ((secP (G.ob x) (PC.piTy x) (t.el x)).nt-nat X' X j gm) ;
   tP-C (y x : CO) (f : CH y x) (X : Ob) (gm : W0.Ix ((G.ob x).ob X))
    : Id (PC.TP y X) (PC.tEn y x f X (tP x X gm)) (tP y X ((G.act y x f).nt X gm)) = t.el-nat y x f X gm ;

   appT (x : CO) (X : Ob) (w : PC.TA x X) : PC.TB x X =
    resT x X (tP x X (fstE (G.ob x) (A.ty x) X w)) w (refl (fstE (G.ob x) (A.ty x) X w)) ;
   appT-pt (x : CO) (X : Ob) (w : PC.TA x X) : Id (PC.TA x X) (fstE (E.ob x) (B.ty x) X (appT x X w)) w =
    symH (PC.At[x, X, fstE (G.ob x) (A.ty x) X w].coeA-pr x (cid x) X (idH X) w
            (rId x X (tP x X (fstE (G.ob x) (A.ty x) X w)) w (refl (fstE (G.ob x) (A.ty x) X w)))) ;
   appV (x : CO) (X : Ob) (w : PC.TA x X) : W0.Ix ((B.ty x).tob X w) =
    GPR.TyL[E.ob x, B.ty x].coeT X (fstE (E.ob x) (B.ty x) X (appT x X w)) w (appT-pt x X w) (sndE (E.ob x) (B.ty x) X (appT x X w)) ;
   appV-pr (x : CO) (X : Ob) (w : PC.TA x X) : Id (PC.TB x X) (appT x X w) (PC.prB x X w (appV x X w)) =
    GPR.TyL[E.ob x, B.ty x].pr-coe X (fstE (E.ob x) (B.ty x) X (appT x X w)) w (appT-pt x X w) (sndE (E.ob x) (B.ty x) X (appT x X w)) ;

   -- appT is natural in the base (res-B, t natural) and in C (res-C)
   appT-B (x : CO) (X' X : Ob) (j : Hom X' X) (w : PC.TA x X)
    : Id (PC.TB x X') ((extP (E.ob x) (B.ty x)).act X' X j (appT x X w)) (appT x X' ((E.ob x).act X' X j w)) =
    transH (res-B x X' X j (tP x X (fstE (G.ob x) (A.ty x) X w)) w (refl (fstE (G.ob x) (A.ty x) X w))
              (refl ((G.ob x).act X' X j (fstE (G.ob x) (A.ty x) X w))))
     (resT-cong x X' ((extP (G.ob x) (PC.piTy x)).act X' X j (tP x X (fstE (G.ob x) (A.ty x) X w)))
        (tP x X' ((G.ob x).act X' X j (fstE (G.ob x) (A.ty x) X w))) (tP-B x X' X j (fstE (G.ob x) (A.ty x) X w))
        ((E.ob x).act X' X j w) ((E.ob x).act X' X j w) (refl ((E.ob x).act X' X j w))
        (refl ((G.ob x).act X' X j (fstE (G.ob x) (A.ty x) X w))) (refl ((G.ob x).act X' X j (fstE (G.ob x) (A.ty x) X w)))) ;
   appT-C (y x : CO) (f : CH y x) (X : Ob) (w : PC.TA x X)
    : Id (PC.TB y X) ((B.tE y x f).nt X (appT x X w)) (appT y X ((A.tE y x f).nt X w)) =
    transH (res-C y x f X (tP x X (fstE (G.ob x) (A.ty x) X w)) w (refl (fstE (G.ob x) (A.ty x) X w)) (A.tE-pt y x f X w))
     (resT-cong y X (PC.tEn y x f X (tP x X (fstE (G.ob x) (A.ty x) X w)))
        (tP y X (fstE (G.ob y) (A.ty y) X ((A.tE y x f).nt X w)))
        (transH (tP-C y x f X (fstE (G.ob x) (A.ty x) X w)) (apH (\ p -> tP y X p) (symH (A.tE-pt y x f X w))))
        ((A.tE y x f).nt X w) ((A.tE y x f).nt X w) (refl ((A.tE y x f).nt X w))
        (A.tE-pt y x f X w) (refl (fstE (G.ob y) (A.ty y) X ((A.tE y x f).nt X w)))) ;

   appEnat (x : CO) (J I : Ob) (j : Hom J I) (w : PC.TA x I) (w' : PC.TA x J) (e : Id (PC.TA x J) ((E.ob x).act J I j w) w')
    : Id (W0.Ix ((B.ty x).tob J w')) ((B.ty x).tact J I j w w' e (appV x I w)) (appV x J w') =
    GPR.TyL[E.ob x, B.ty x].pr-inj J w' ((B.ty x).tact J I j w w' e (appV x I w)) (appV x J w')
     (transH (symH (GPR.TyL[E.ob x, B.ty x].pr-tact J I j w w' e (appV x I w)))
       (transH (apH (\ v -> (extP (E.ob x) (B.ty x)).act J I j v) (symH (appV-pr x I w)))
         (transH (appT-B x J I j w)
           (transH (apH (\ w1 -> appT x J w1) e) (appV-pr x J w'))))) ;
   appEl (x : CO) : PEl[E.ob x, B.ty x] = new PEl[E.ob x, B.ty x, appV x, appEnat x] ;
   appNat (y x : CO) (f : CH y x) (X : Ob) (w : PC.TA x X)
    : Id (PC.TB y X) ((B.tE y x f).nt X (PC.prB x X w (appV x X w)))
        (PC.prB y X ((A.tE y x f).nt X w) (appV y X ((A.tE y x f).nt X w))) =
    transH (apH (\ v -> (B.tE y x f).nt X v) (symH (appV-pr x X w)))
     (transH (appT-C y x f X w) (appV-pr y X ((A.tE y x f).nt X w))) ;
   app : CEl[E, B] = new CEl[E, B, appEl, appNat] ;
  } ;

  ------------------------------------------------------------------
  -- abstraction

  module Lam (v : CEl[E, B]) {
   secV (y : CO) (Y : Ob) (w : PC.TA y Y) : PC.TB y Y = PC.prB y Y w ((v.el y).eob Y w) ;
   module AtL (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) {
    module S = PC.At[x, X, gm] ;
    lamB : S.Comp = \ y f -> (PP.PiCode[G.ob y, A.ty y, B.ty y].lamEl (v.el y)).eob X (S.ptC y f) ;
    -- by definition of the base abstraction
    valLamT (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a : S.FA y f Y h)
     : Id (PC.TB y Y) (S.valT lamB y f Y h a) (secV y Y (PC.prA y Y (S.ptH y f Y h) a)) =
     refl (secV y Y (PC.prA y Y (S.ptH y f Y h) a)) ;
    valLam (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (w : PC.TA y Y)
     (r : Id (W0.Ix ((G.ob y).ob Y)) (fstE (G.ob y) (A.ty y) Y w) (S.ptH y f Y h))
     : Id (PC.TB y Y) (S.valAt lamB y f Y h w r) (secV y Y w) =
     apH (\ w1 -> secV y Y w1) (symH (S.coeA-pr y f Y h w r)) ;
    lamN : S.CNat lamB = \ z y g f Y h a ->
     transH (v.el-nat z y g Y (PC.prA y Y (S.ptH y f Y h) a)) (apH (\ w1 -> secV z Y w1) (S.aM-mv z y g f Y h a)) ;
    lamI : S.PiIx = (lamB, lamN) ;
   } ;
   lamEl (x : CO) : PEl[G.ob x, PC.piTy x] =
    new PEl[G.ob x, PC.piTy x, \ X gm -> AtL[x, X, gm].lamI,
     \ J I k gm gm' e -> PC.At[x, J, gm'].pi-eqC (PC.Act[x, J, I, k, gm, gm', e].act AtL[x, I, gm].lamI) AtL[x, J, gm'].lamI
        (\ y f -> (PP.PiCode[G.ob y, A.ty y, B.ty y].lamEl (v.el y)).enat J I k (PC.At[x, I, gm].ptC y f) (PC.At[x, J, gm'].ptC y f)
                    (PC.Act[x, J, I, k, gm, gm', e].ePt y f))] ;
   lamVals (y x : CO) (f : CH y x) (X : Ob) (gm : W0.Ix ((G.ob x).ob X))
    : PC.ValEq y X ((G.act y x f).nt X gm) ((G.act y x f).nt X gm) (PC.CAct[y, x, f, X, gm].rix AtL[x, X, gm].lamI)
        AtL[y, X, (G.act y x f).nt X gm].lamI =
    \ y' f' Y h w r r' ->
     transH (PC.CAct[y, x, f, X, gm].valRix-at AtL[x, X, gm].lamB y' f' Y h w r (PC.CAct[y, x, f, X, gm].rS y' f' Y h w r))
      (transH (AtL[x, X, gm].valLam y' (co y' y x f f') Y h w (PC.CAct[y, x, f, X, gm].rS y' f' Y h w r))
        (symH (AtL[y, X, (G.act y x f).nt X gm].valLam y' f' Y h w r'))) ;
   lamNat (y x : CO) (f : CH y x) (X : Ob) (gm : W0.Ix ((G.ob x).ob X))
    : Id (PC.TP y X) (PC.tEn y x f X (PC.prP x X gm AtL[x, X, gm].lamI))
        (PC.prP y X ((G.act y x f).nt X gm) AtL[y, X, (G.act y x f).nt X gm].lamI) =
    PC.tot-ext y X ((G.act y x f).nt X gm) ((G.act y x f).nt X gm) (refl ((G.act y x f).nt X gm))
     (PC.CAct[y, x, f, X, gm].rix AtL[x, X, gm].lamI) AtL[y, X, (G.act y x f).nt X gm].lamI (lamVals y x f X gm) ;
   lam : CEl[G, PC.PiT] = new CEl[G, PC.PiT, lamEl, lamNat] ;
  } ;

  ------------------------------------------------------------------
  -- beta: the value of lam v at the identities and w is (w , v w)

  beta (v : CEl[E, B]) : Id (CEl[E, B]) App[Lam[v].lam].app v =
   EX.cel-ext E B App[Lam[v].lam].app v (\ x X w ->
    GPR.TyL[E.ob x, B.ty x].pr-inj X w (App[Lam[v].lam].appV x X w) ((v.el x).eob X w)
     (transH (symH (App[Lam[v].lam].appV-pr x X w))
       (Lam[v].AtL[x, X, fstE (G.ob x) (A.ty x) X w].valLam x (cid x) X (idH X) w
          (rId x X (App[Lam[v].lam].tP x X (fstE (G.ob x) (A.ty x) X w)) w (refl (fstE (G.ob x) (A.ty x) X w)))))) ;

  ------------------------------------------------------------------
  -- eta: the value of t at (f , h , a) is the restriction of t moved
  -- along f and h (val-res), and t moved is t at the moved point

  module Eta (t : CEl[G, PC.PiT]) {
   module Ap = App[t] ;
   module Lm = Lam[Ap.app] ;
   module EAt (x : CO) (X : Ob) (gm : W0.Ix ((G.ob x).ob X)) (y : CO) (f : CH y x) (Y : Ob) (h : Hom Y X) (a0 : PC.At[x, X, gm].FA y f Y h) {
    module S = PC.At[x, X, gm] ;
    module VR' = VR[x, X, gm, (t.el x).eob X gm, y, f, Y, h, PC.prA y Y (S.ptH y f Y h) a0] ;
    w0 : PC.TA y Y = PC.prA y Y (S.ptH y f Y h) a0 ;
    -- t at the point (act f gm) h is t at gm moved along f and h
    pM : Id (PC.TP y Y) (Ap.tP y Y (S.ptH y f Y h)) VR'.wM =
     symH (transH (apH (\ wP -> (extP (G.ob y) (PC.piTy y)).act Y X h wP) (Ap.tP-C y x f X gm))
            (Ap.tP-B y Y X h ((G.act y x f).nt X gm))) ;
    e1 : Id (PC.TB y Y) (Lm.secV y Y w0) (Ap.appT y Y w0) = symH (Ap.appV-pr y Y w0) ;
    e2 : Id (PC.TB y Y) (Ap.appT y Y w0) (resT y Y VR'.wM w0 (refl (S.ptH y f Y h))) =
     resT-cong y Y (Ap.tP y Y (S.ptH y f Y h)) VR'.wM pM w0 w0 (refl w0) (refl (S.ptH y f Y h)) (refl (S.ptH y f Y h)) ;
    e3 : Id (PC.TB y Y) (resT y Y VR'.wM w0 (refl (S.ptH y f Y h))) (S.valT ((t.el x).eob X gm).1 y f Y h a0) =
     symH (VR'.res (refl (S.ptH y f Y h)) (refl (S.ptH y f Y h))) ;
    res : Id (W0.Ix ((B.ty y).tob Y w0)) (S.val Lm.AtL[x, X, gm].lamB y f Y h a0) (S.val ((t.el x).eob X gm).1 y f Y h a0) =
     GPR.TyL[E.ob y, B.ty y].pr-inj Y w0 (S.val Lm.AtL[x, X, gm].lamB y f Y h a0) (S.val ((t.el x).eob X gm).1 y f Y h a0)
      (transH e1 (transH e2 e3)) ;
   } ;
   eta : Id (CEl[G, PC.PiT]) Lm.lam t =
    EX.cel-ext G PC.PiT Lm.lam t (\ x X gm ->
     PC.At[x, X, gm].pi-eq Lm.AtL[x, X, gm].lamI ((t.el x).eob X gm) (\ y f Y h a0 -> EAt[x, X, gm, y, f, Y, h, a0].res)) ;
  } ;
  eta (t : CEl[G, PC.PiT]) : Id (CEl[G, PC.PiT]) Lam[App[t].app].lam t = Eta[t].eta ;

  -- Pi-iso of CwF.Formers.PiStr, on the raw CwF of C-presheaves
  PiIso : Iso (CEl[G, PC.PiT]) (CEl[E, B]) =
   new IsoData[CEl[G, PC.PiT], CEl[E, B], \ t -> App[t].app, \ v -> Lam[v].lam, beta, eta] ;
 } ;
} ;
