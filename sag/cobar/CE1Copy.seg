-- CE1Copy.seg (canonicity-45; COBAR.md "comparison"): E1's addition and
-- multiplication parameters at a copy y', with the algebra side the
-- quotient Q_y' (strict operations) and tau' = tau . phi (phi : Q_y' ->
-- codes F1 -> y', from c2's evaluation at the generator and beta).  The
-- path is CCmpY6's compatibility restricted to the copy (CRestrHT), at the
-- pairing w = cop (phi f, phi g); its two ends are joined to the two sides
-- by cop's sections and by the reading of the operations (parameters).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module E1C (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) (y' : SX.Over[R].Presentation) {
 module C6 = CCmpY6[a].Cp6[R, encK, pe, al, eqal, commH] ;
 module CM = C6.CM ;
 module RH = CRestrHT[a].RHT[R, encK, pe, y'] ;
 module HO = RH.HO ;
 Nl : L.PCtx = RH.Nl ;
 module AQ = CHomT3[a].HomP[R, encK, pe].Alg[y'] ;
 Qc : L.PTy[Nl] = AQ.Qt.1 ;
 module SA = CSemOp[a].SemOp[AQ.Qt, AQ.O.addQ] ;
 module SM = CSemOp[a].SemOp[AQ.Qt, AQ.O.mulQ] ;
 Ac : L.PTy[Nl] = RH.ClT[C6.Y1].ty ;
 A2c : L.PTy[Nl] = RH.ClT[C6.Y2].ty ;
 Tc : L.PTy[Nl] = RH.ClT[C6.Q1.DY.DCtx].ty ;
 -- the operations on Q_y' (strict) and on G at the copy
 addA (I : Ob) (o : V1.Ix (Nl.ob I)) (a0 b0 : V1.Ix (Qc.tob I o)) : V1.Ix (Qc.tob I o) = SA.ev2 I o a0 b0 ;
 mulA (I : Ob) (o : V1.Ix (Nl.ob I)) (a0 b0 : V1.Ix (Qc.tob I o)) : V1.Ix (Qc.tob I o) = SM.ev2 I o a0 b0 ;
 addAN (J I : Ob) (f : Hom J I) (x : V1.Ix (Nl.ob I)) (y : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I f x) y) (a0 b0 : V1.Ix (Qc.tob I x))
  : Id (V1.Ix (Qc.tob J y)) (Qc.tact J I f x y e (addA I x a0 b0)) (addA J y (Qc.tact J I f x y e a0) (Qc.tact J I f x y e b0)) =
  idJ (V1.Ix (Nl.ob J)) (Nl.act J I f x) (\ y2 e2 -> Id (V1.Ix (Qc.tob J y2)) (Qc.tact J I f x y2 e2 (addA I x a0 b0)) (addA J y2 (Qc.tact J I f x y2 e2 a0) (Qc.tact J I f x y2 e2 b0)))
   (SA.NT[I, J, f, x, a0, b0].law) y e ;
 mulAN (J I : Ob) (f : Hom J I) (x : V1.Ix (Nl.ob I)) (y : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I f x) y) (a0 b0 : V1.Ix (Qc.tob I x))
  : Id (V1.Ix (Qc.tob J y)) (Qc.tact J I f x y e (mulA I x a0 b0)) (mulA J y (Qc.tact J I f x y e a0) (Qc.tact J I f x y e b0)) =
  idJ (V1.Ix (Nl.ob J)) (Nl.act J I f x) (\ y2 e2 -> Id (V1.Ix (Qc.tob J y2)) (Qc.tact J I f x y2 e2 (mulA I x a0 b0)) (mulA J y2 (Qc.tact J I f x y2 e2 a0) (Qc.tact J I f x y2 e2 b0)))
   (SM.NT[I, J, f, x, a0, b0].law) y e ;
 -- the restricted maps on codes: the components of the pairing, precomposition
 p1c : HO.NMap[Nl, A2c, Ac] = new HO.NMap[Nl, A2c, Ac, \ I o c -> (CM.cmpS.nt I y' c).1,
  \ J I h x x' e c -> symH (apH {V1.Ix ((CM.PD.prodT C6.Y1 C6.Y1).ob J y')} {V1.Ix (C6.Y1.ob J y')} (\ p -> p.1) (CM.cmpS.nt-nat J I h y' y' (CM.IC.cart J I h y') c))] ;
 p2c : HO.NMap[Nl, A2c, Ac] = new HO.NMap[Nl, A2c, Ac, \ I o c -> (CM.cmpS.nt I y' c).2,
  \ J I h x x' e c -> symH (apH {V1.Ix ((CM.PD.prodT C6.Y1 C6.Y1).ob J y')} {V1.Ix (C6.Y1.ob J y')} (\ p -> p.2) (CM.cmpS.nt-nat J I h y' y' (CM.IC.cart J I h y') c))] ;
 tauc : HO.NMap[Nl, Ac, Tc] = new HO.NMap[Nl, Ac, Tc, \ I o a0 -> C6.Q1.DY.tau I y' a0, \ J I h x x' e a0 -> symH (C6.Q1.DY.tau-nat J I h y' y' (CM.IC.cart J I h y') a0)] ;
 module Op (io : (J : Ob) -> CM.MO.Fn[CM.F1, CM.F2].M J) (io-nat : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[CM.F1, CM.F2].M K) (CM.MO.Fn[CM.F1, CM.F2].res J K v (io J)) (io K)) {
  module OC = C6.Opc[io, io-nat] ;
  preC : HO.NMap[Nl, A2c, Ac] = new HO.NMap[Nl, A2c, Ac, \ I o c -> OC.OP.PR.preS.nt I y' c,
   \ J I h x x' e c -> symH (OC.OP.PR.preS.nt-nat J I h y' y' (CM.IC.cart J I h y') c)] ;
  opT (I : Ob) (o : V1.Ix (Nl.ob I)) (a0 b0 : V1.Ix (Tc.tob I o)) : V1.Ix (Tc.tob I o) = OC.OP.op.nt I y' (a0, b0) ;
  opTN (J I : Ob) (f : Hom J I) (x : V1.Ix (Nl.ob I)) (y : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I f x) y) (a0 b0 : V1.Ix (Tc.tob I x))
   : Id (V1.Ix (Tc.tob J y)) (Tc.tact J I f x y e (opT I x a0 b0)) (opT J y (Tc.tact J I f x y e a0) (Tc.tact J I f x y e b0)) =
   symH (OC.OP.op.nt-nat J I f y' y' (CM.IC.cart J I f y') (a0, b0)) ;
  -- the restricted compatibility on codes F2 -> y'
  module RO = RH.Of[C6.Y2, C6.Q1.DY.DCtx] ;
  rc : L.PEl[L.extP Nl A2c, HO.HT[Nl, A2c, Tc, RO.rN OC.l, RO.rN OC.r].PT.PathP] = RO.RHt[OC.l, OC.r, OC.compat].res ;
 } ;
 module AddO = Op[CM.II.AddF.M.mor, CM.II.AddF.M.mor-nat] ;
 module MulO = Op[CM.II.MulF.M.mor, CM.II.MulF.M.mor-nat] ;
 -- the hypotheses: phi : Q_y' -> codes, the pairing cop with its sections, Kan composition in G
 module Hyp (phi : HO.NMap[Nl, Qc, Ac])
   (cop : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, Ac]) -> HO.NMap[Nl, X, A2c])
   (sec1 : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, Ac]) -> L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, HO.compN Nl X A2c Ac (cop X f1 f2) p1c, f1].PT.PathP])
   (sec2 : (X : L.PTy[Nl]) (f1 f2 : HO.NMap[Nl, X, Ac]) -> L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, HO.compN Nl X A2c Ac (cop X f1 f2) p2c, f2].PT.PathP])
   (cTp : PB.CLine[a+].Lines[Nl, Tc].CompK[PB.e0, PB.e1].Comp) {
  tau' : HO.NMap[Nl, Qc, Tc] = HO.compN Nl Qc Ac Tc phi tauc ;
  -- one operation: its reading on codes rd gives E1's parameter
  module OpC (io : (J : Ob) -> CM.MO.Fn[CM.F1, CM.F2].M J) (io-nat : (J K : Ob) (v : Hom K J) -> Id (CM.MO.Fn[CM.F1, CM.F2].M K) (CM.MO.Fn[CM.F1, CM.F2].res J K v (io J)) (io K))
    (opA : (I : Ob) (x : V1.Ix (Nl.ob I)) (a0 b0 : V1.Ix (Qc.tob I x)) -> V1.Ix (Qc.tob I x))
    (opAN : (J I : Ob) (f : Hom J I) (x : V1.Ix (Nl.ob I)) (y : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I f x) y) (a0 b0 : V1.Ix (Qc.tob I x))
       -> Id (V1.Ix (Qc.tob J y)) (Qc.tact J I f x y e (opA I x a0 b0)) (opA J y (Qc.tact J I f x y e a0) (Qc.tact J I f x y e b0)))
    (rd : (X : L.PTy[Nl]) (f g : HO.NMap[Nl, X, Qc])
       -> L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, HO.compN Nl X A2c Ac (cop X (HO.compN Nl X Qc Ac f phi) (HO.compN Nl X Qc Ac g phi)) Op[io, io-nat].preC,
            HO.compN Nl X Qc Ac (CApOp2[a].AO[Nl, X, Qc, opA, opAN].OP f g) phi].PT.PathP]) {
   module OO = Op[io, io-nat] ;
   module At (X : L.PTy[Nl]) (f g : HO.NMap[Nl, X, Qc]) {
    module AOT = CApOp2[a].AO[Nl, X, Tc, OO.opT, OO.opTN] ;
    module AOA = CApOp2[a].AO[Nl, X, Qc, opA, opAN] ;
    f' : HO.NMap[Nl, X, Ac] = HO.compN Nl X Qc Ac f phi ;
    g' : HO.NMap[Nl, X, Ac] = HO.compN Nl X Qc Ac g phi ;
    w : HO.NMap[Nl, X, A2c] = cop X f' g' ;
    ft : HO.NMap[Nl, X, Tc] = HO.compN Nl X Qc Tc f tau' ;
    gt : HO.NMap[Nl, X, Tc] = HO.compN Nl X Qc Tc g tau' ;
    u1 : HO.NMap[Nl, X, Ac] = HO.compN Nl X A2c Ac w p1c ;
    u2 : HO.NMap[Nl, X, Ac] = HO.compN Nl X A2c Ac w p2c ;
    u1t : HO.NMap[Nl, X, Tc] = HO.compN Nl X Ac Tc u1 tauc ;
    u2t : HO.NMap[Nl, X, Tc] = HO.compN Nl X Ac Tc u2 tauc ;
    wr : HO.NMap[Nl, X, Tc] = HO.compN Nl X Ac Tc (HO.compN Nl X A2c Ac w OO.preC) tauc ;
    -- tau' f ~ tau (w . p1), tau' g ~ tau (w . p2)
    module W1 = HO.WL[Nl, X, Ac, Tc, u1, f', tauc, sec1 X f' g'] ;
    module I1 = HO.Inv[Nl, X, Tc, HO.compN Nl X Ac Tc u1 tauc, HO.compN Nl X Ac Tc f' tauc, cTp, W1.res] ;
    module R1 = HO.Ret[Nl, X, Tc, HO.compN Nl X Ac Tc f' tauc, u1t, ft, u1t, \ I x a0 -> refl (ft.nfun I x a0), \ I x a0 -> refl (u1t.nfun I x a0), I1.res] ;
    module W2 = HO.WL[Nl, X, Ac, Tc, u2, g', tauc, sec2 X f' g'] ;
    module I2 = HO.Inv[Nl, X, Tc, HO.compN Nl X Ac Tc u2 tauc, HO.compN Nl X Ac Tc g' tauc, cTp, W2.res] ;
    module R2 = HO.Ret[Nl, X, Tc, HO.compN Nl X Ac Tc g' tauc, u2t, gt, u2t, \ I x a0 -> refl (gt.nfun I x a0), \ I x a0 -> refl (u2t.nfun I x a0), I2.res] ;
    module H1 = AOT.Ap[ft, u1t, gt, u2t, R1.res, R2.res] ;
    -- CCmpY6 at w
    module W3 = HO.WR[Nl, A2c, Tc, X, OO.RO.rN OO.OC.l, OO.RO.rN OO.OC.r, w, OO.rc] ;
    module R3 = HO.Ret[Nl, X, Tc, HO.compN Nl X A2c Tc w (OO.RO.rN OO.OC.l), HO.compN Nl X A2c Tc w (OO.RO.rN OO.OC.r), AOT.OP u1t u2t, wr,
       \ I x a0 -> refl ((AOT.OP u1t u2t).nfun I x a0), \ I x a0 -> refl (wr.nfun I x a0), W3.res] ;
    -- the reading of the operation
    module W4 = HO.WL[Nl, X, Ac, Tc, HO.compN Nl X A2c Ac w OO.preC, HO.compN Nl X Qc Ac (AOA.OP f g) phi, tauc, rd X f g] ;
    module R4 = HO.Ret[Nl, X, Tc, wr, HO.compN Nl X Ac Tc (HO.compN Nl X Qc Ac (AOA.OP f g) phi) tauc, wr, HO.compN Nl X Qc Tc (AOA.OP f g) tau',
       \ I x a0 -> refl (wr.nfun I x a0), \ I x a0 -> refl ((HO.compN Nl X Qc Tc (AOA.OP f g) tau').nfun I x a0), W4.res] ;
    module C1 = HO.Cat[Nl, X, Tc, AOT.OP ft gt, AOT.OP u1t u2t, wr, cTp, H1.res, R3.res] ;
    module C2 = HO.Cat[Nl, X, Tc, AOT.OP ft gt, wr, HO.compN Nl X Qc Tc (AOA.OP f g) tau', cTp, C1.res, R4.res] ;
    res : L.PEl[L.extP Nl X, HO.HT[Nl, X, Tc, AOT.OP ft gt, HO.compN Nl X Qc Tc (AOA.OP f g) tau'].PT.PathP] = C2.res ;
   } ;
  } ;
  -- the constants (CCst4 at c2's cF0)
  module K4 (r : R.R) { module K = CCst4[a].C4[R, encK, pe, CUF0[a].cF0 R encK pe, y', r] ; } ;
  cA (r : R.R) (I : Ob) (o : V1.Ix (Nl.ob I)) : V1.Ix (Qc.tob I o) = (AQ.AX.cls (cst r)).eob I o ;
  cAN (r : R.R) (J I : Ob) (f : Hom J I) (x : V1.Ix (Nl.ob I)) (y : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I f x) y)
   : Id (V1.Ix (Qc.tob J y)) (Qc.tact J I f x y e (cA r I x)) (cA r J y) = (AQ.AX.cls (cst r)).enat J I f x y e ;
  cT (r : R.R) (I : Ob) (o : V1.Ix (Nl.ob I)) : V1.Ix (Tc.tob I o) = K4[r].K.KR.cstD (I, y') ;
  cTN (r : R.R) (J I : Ob) (f : Hom J I) (x : V1.Ix (Nl.ob I)) (y : V1.Ix (Nl.ob J)) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I f x) y)
   : Id (V1.Ix (Tc.tob J y)) (Tc.tact J I f x y e (cT r I x)) (cT r J y) = K4[r].K.KR.NT[K4[r].K.K0 J, K4[r].K.K0 I, K4[r].K.qm J I f].law ;
  module AL = CHtpyAlg[a].Alg[R, Nl, Qc, Tc, addA, addAN, mulA, mulAN, cA, cAN, AddO.opT, AddO.opTN, MulO.opT, MulO.opTN, cT, cTN, tau'] ;
  -- E1 at the copy, from the readings of the operations and of the constants on codes
  module Fin
    (rdA : (X : L.PTy[Nl]) (f g : HO.NMap[Nl, X, Qc])
       -> L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, HO.compN Nl X A2c Ac (cop X (HO.compN Nl X Qc Ac f phi) (HO.compN Nl X Qc Ac g phi)) AddO.preC,
            HO.compN Nl X Qc Ac (CApOp2[a].AO[Nl, X, Qc, addA, addAN].OP f g) phi].PT.PathP])
    (rdM : (X : L.PTy[Nl]) (f g : HO.NMap[Nl, X, Qc])
       -> L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, HO.compN Nl X A2c Ac (cop X (HO.compN Nl X Qc Ac f phi) (HO.compN Nl X Qc Ac g phi)) MulO.preC,
            HO.compN Nl X Qc Ac (CApOp2[a].AO[Nl, X, Qc, mulA, mulAN].OP f g) phi].PT.PathP])
    (kR : (r : R.R) (X : L.PTy[Nl]) -> L.PEl[L.extP Nl X, HO.HT[Nl, X, Ac, AL.constN X Ac (\ I o -> K4[r].K.kc I) (\ J I f x y e -> K4[r].K.kcN J I f), HO.compN Nl X Qc Ac (AL.constN X Qc (cA r) (cAN r)) phi].PT.PathP]) {
   module CC (r : R.R) (X : L.PTy[Nl]) {
    module CH = K4[r].K.CstH[X] ;
    module R0 = HO.Ret[Nl, X, Tc, CH.cTN, HO.compN Nl X Ac Tc CH.cAN K4[r].K.tauc, AL.constN X Tc (cT r) (cTN r), HO.compN Nl X Ac Tc (AL.constN X Ac (\ I o -> K4[r].K.kc I) (\ J I f x y e -> K4[r].K.kcN J I f)) tauc,
       \ I x a0 -> refl (cT r I x), \ I x a0 -> refl (C6.Q1.DY.tau I y' (K4[r].K.kc I)), CH.res] ;
    module W5 = HO.WL[Nl, X, Ac, Tc, AL.constN X Ac (\ I o -> K4[r].K.kc I) (\ J I f x y e -> K4[r].K.kcN J I f), HO.compN Nl X Qc Ac (AL.constN X Qc (cA r) (cAN r)) phi, tauc, kR r X] ;
    module R5 = HO.Ret[Nl, X, Tc, HO.compN Nl X Ac Tc (AL.constN X Ac (\ I o -> K4[r].K.kc I) (\ J I f x y e -> K4[r].K.kcN J I f)) tauc, HO.compN Nl X Ac Tc (HO.compN Nl X Qc Ac (AL.constN X Qc (cA r) (cAN r)) phi) tauc,
       HO.compN Nl X Ac Tc (AL.constN X Ac (\ I o -> K4[r].K.kc I) (\ J I f x y e -> K4[r].K.kcN J I f)) tauc, HO.compN Nl X Qc Tc (AL.constN X Qc (cA r) (cAN r)) tau',
       \ I x a0 -> refl (C6.Q1.DY.tau I y' (K4[r].K.kc I)), \ I x a0 -> refl (tau'.nfun I x (cA r I x)), W5.res] ;
    module C5 = HO.Cat[Nl, X, Tc, AL.constN X Tc (cT r) (cTN r), HO.compN Nl X Ac Tc (AL.constN X Ac (\ I o -> K4[r].K.kc I) (\ J I f x y e -> K4[r].K.kcN J I f)) tauc, HO.compN Nl X Qc Tc (AL.constN X Qc (cA r) (cAN r)) tau', cTp, R0.res, R5.res] ;
    res : L.PEl[L.extP Nl X, HO.HT[Nl, X, Tc, AL.constN X Tc (cT r) (cTN r), HO.compN Nl X Qc Tc (AL.constN X Qc (cA r) (cAN r)) tau'].PT.PathP] = C5.res ;
   } ;
   module E = AL.E1M[cTp,
     \ X f g -> OpC[CM.II.AddF.M.mor, CM.II.AddF.M.mor-nat, addA, addAN, rdA].At[X, f, g].res,
     \ X f g -> OpC[CM.II.MulF.M.mor, CM.II.MulF.M.mor-nat, mulA, mulAN, rdM].At[X, f, g].res,
     \ r X -> CC[r, X].res] ;
   -- evGt_t ~ tau' . evA_t, for every term t in k variables
   E1 : (k : Nat) (t : SX.Over[R].Expr (SX.Fin k))
    -> L.PEl[L.extP Nl (AL.Pm k), HO.HT[Nl, AL.Pm k, Tc, AL.evGt k t, HO.compN Nl (AL.Pm k) Qc Tc (AL.evA k t) tau'].PT.PathP] = E.E1 ;
  } ;
 } ;
} ;
