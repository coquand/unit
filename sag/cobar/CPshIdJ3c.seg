-- CPshIdJ3c.seg (part 7c: the starts, PosJNat.JNatG at x, the law) (part 7 of the Id instance, canonicity-45): J is stable
-- under C-substitutions.  PosJNat.JNatG at each x for the record's upS
-- read at x, with the base's Yoneda data (FibId.JNt's Y, Y') spelled as
-- the base spells them; the commutation of upS with the J-data is the
-- base's (JNt.prEq, lamEq, psiEq) through upSEqC; the transported start
-- is compared through FibIdRd.elTr with the path of codes of the centres
-- (cenNat's pointwise form, CPshIdJ2.CNC.At.pt).  Each conversion between
-- the record's spelling and the base's is one opaque lemma.
--   JN[D, G, A, a, s, CM, d].law : subCEl J upS = J (CM[upS]) d''

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module FBC = FibCwF[a, l] ;
module FIC = FibIdCen[a, l] ;
module FID = FibId[a, l] ;
module RD = FibIdRd[a, l] ;
module PJ = PosJNat[a, l] ;

module IdJ3cOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module UF = CPshUFib[a, l].UFibOf[C] ;
 module JA = CPshIdJa[a, l].IdJaOf[C] ;
 module JB = CPshIdJb[a, l].IdJbOf[C] ;
 module JC2 = CPshIdJc2[a, l].IdJc2Of[C] ;
 module J1 = CPshIdJ1[a, l].IdJ1Of[C] ;
 module J2 = CPshIdJ2[a, l].IdJ2Of[C] ;
 open P ;
 STy (G : CCtx) : U l+ = UF.FCC.STy G ;
 module DRC = JA.DRC ;
 module DRB = JA.DRB ;
 module J3 = CPshIdJ3[a, l].IdJ3Of[C] ;
 module J3b = CPshIdJ3b[a, l].IdJ3bOf[C] ;
 module J3p = CPshIdJ3p[a, l].IdJ3pOf[C] ;
 module J3l = CPshIdJ3l[a, l].IdJ3lOf[C] ;

 module JN (D G : CCtx) (A : STy G) (a0 : CEl[G, A.1]) (s : CSub[D, G]) (CM : STy (DRC.Dx G A a0))
  (d : CEl[G, (UF.FCC.subS G (DRC.Dx G A a0) CM (DRC.cen G A a0)).1]) {
  module N = J3.JN[D, G, A, a0, s, CM, d] ;
  module Nb = J3b.JN[D, G, A, a0, s, CM, d] ;
  module Np = J3p.JN[D, G, A, a0, s, CM, d] ;
  module Nl = J3l.JN[D, G, A, a0, s, CM, d] ;
  PCt : Id (CTy[D]) N.Zs.1 N.Zd.1 = apH (\ Z -> Z.1) N.PT ;
  dC2 : Id (CEl[D, N.Zd.1]) N.d'' (subst (CTy[D]) (\ X -> CEl[D, X]) N.Zs.1 N.Zd.1 PCt (CW.subCEl D G (UF.FCC.subS G N.Dc CM N.cenG).1 d s)) =
   subst-ap (STy D) (CTy[D]) (\ Z -> Z.1) (\ X -> CEl[D, X]) N.Zs N.Zd N.PT (CW.subCEl D G (UF.FCC.subS G N.Dc CM N.cenG).1 d s) ;
  opaque dC2 ;
  module At (x : CO) {
   module Ax = N.At[x] ;
   module TC = GPR.TyL[(DRC.Dx G A a0).ob x, CM.1.ty x] ;
   module TC' = GPR.TyL[(DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x, subTy ((DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) ((DRC.upS D G A a0 s).sb x)] ;
   module SE = PB.CSub[l].SubE[(DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x, (DRC.Dx G A a0).ob x, (DRC.upS D G A a0 s).sb x, CM.1.ty x] ;
   -- the starts of JEl at D, in the spelling of JNatG (one conversion)
   dD : PEl[D.ob x, subTy (D.ob x) ((DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x) (subTy ((DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) ((DRC.upS D G A a0 s).sb x)) (N.JD.cY x)] = N.JD.dY x ;
   dd : PEl[D.ob x, subTy (D.ob x) ((DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x) (subTy ((DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) ((DRC.upS D G A a0 s).sb x)) (N.cenD.sb x)] = N.d''.el x ;
   eD (X : Ob) (x0 : W0.Ix ((D.ob x).ob X)) : Id (TC'.EI X) (TC'.pr X ((N.JD.cY x).nt X x0) (dD.eob X x0)) (TC'.pr X ((N.cenD.sb x).nt X x0) (dd.eob X x0)) =
    N.JD.e1 x X x0 ;
   opaque eD ;
   -- the pointwise form of cenNat at x, and its path of codes
   ptR (X : Ob) (x0 : W0.Ix ((D.ob x).ob X)) : Id (W0.Ix (((DRC.Dx G A a0).ob x).ob X)) ((N.cenG.sb x).nt X ((s.sb x).nt X x0)) (((DRC.upS D G A a0 s).sb x).nt X ((N.cenD.sb x).nt X x0)) =
    J2.CNC[D, G, A, a0, s].At[x].pt X x0 ;
   opaque ptR ;
   cd (X : Ob) (x0 : W0.Ix ((D.ob x).ob X)) : Id W0.V ((CM.1.ty x).tob X ((N.cenG.sb x).nt X ((s.sb x).nt X x0))) ((CM.1.ty x).tob X (((DRC.upS D G A a0 s).sb x).nt X ((N.cenD.sb x).nt X x0))) =
    apH (\ z -> (CM.1.ty x).tob X z) (ptR X x0) ;
   -- the transported start at a point is d at s x0 coerced along cd
   vEq (X : Ob) (x0 : W0.Ix ((D.ob x).ob X))
    : Id (W0.Ix ((CM.1.ty x).tob X (((DRC.upS D G A a0 s).sb x).nt X ((N.cenD.sb x).nt X x0)))) (dd.eob X x0)
        (subst W0.V (\ v -> W0.Ix v) ((CM.1.ty x).tob X ((N.cenG.sb x).nt X ((s.sb x).nt X x0))) ((CM.1.ty x).tob X (((DRC.upS D G A a0 s).sb x).nt X ((N.cenD.sb x).nt X x0))) (cd X x0) ((d.el x).eob X ((s.sb x).nt X x0))) =
    transH (apH (\ e -> (e.el x).eob X x0) dC2)
     (transH (apH (\ e -> e.eob X x0) (CW.elTrC D N.Zs.1 N.Zd.1 PCt (CW.subCEl D G (UF.FCC.subS G N.Dc CM N.cenG).1 d s) x))
       (RD.elTr (D.ob x) (PTy[D.ob x]) (\ T -> T) (N.Zs.1.ty x) (N.Zd.1.ty x) (apH (\ X2 -> X2.ty x) PCt) ((CW.subCEl D G (UF.FCC.subS G N.Dc CM N.cenG).1 d s).el x) X x0 (cd X x0))) ;
   opaque vEq ;
   st (X : Ob) (x0 : W0.Ix ((D.ob x).ob X))
    : Id (TC.EI X) (TC.pr X (((DRC.upS D G A a0 s).sb x).nt X ((N.cenD.sb x).nt X x0)) (dd.eob X x0)) (TC.pr X ((N.cenG.sb x).nt X ((s.sb x).nt X x0)) ((d.el x).eob X ((s.sb x).nt X x0))) =
    symH (TC.pr-eqV X ((N.cenG.sb x).nt X ((s.sb x).nt X x0)) (((DRC.upS D G A a0 s).sb x).nt X ((N.cenD.sb x).nt X x0)) (ptR X x0) ((d.el x).eob X ((s.sb x).nt X x0)) (dd.eob X x0) (cd X x0) (symH (vEq X x0))) ;
   opaque st ;
   dEq (X : Ob) (x0 : W0.Ix ((D.ob x).ob X))
    : Id (TC.EI X) (TC.pr X (((DRC.upS D G A a0 s).sb x).nt X ((N.JD.cY x).nt X x0)) (dD.eob X x0)) (TC.pr X ((N.JG.cY x).nt X ((s.sb x).nt X x0)) ((N.JG.dY x).eob X ((s.sb x).nt X x0))) =
    transH (apH (SE.mV X) (eD X x0)) (transH (st X x0) (symH (N.JG.e1 x X ((s.sb x).nt X x0)))) ;
   opaque dEq ;
   module JNG = PJ.JNatG[D.ob x, G.ob x, s.sb x, (DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x, (DRC.Dx G A a0).ob x, N.JD.Y[x].J.yjD, N.JG.Y[x].J.yjD, (DRC.upS D G A a0 s).sb x, Ax.prEq, Nl.At[x].lamEq, Np.At[x].psiEq, CM.1.ty x, (CM.2.1 x).1, N.JG.dY x, dD, dEq] ;
   -- the J's of JNatG are the J's of the instance (one conversion each)
   j0 : Id (PEl[(DRC.Dx G A a0).ob x, CM.1.ty x]) JNG.J0.J (N.JG.jx x) = refl (N.JG.jx x) ;
   opaque j0 ;
   j1 : Id (PEl[(DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x, subTy ((DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) ((DRC.upS D G A a0 s).sb x)]) JNG.J1.J (N.JD.jx x) = refl (N.JD.jx x) ;
   opaque j1 ;
   pt (X : Ob) (z : W0.Ix (((DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x).ob X)) : Id (W0.Ix ((subTy ((DRC.Dx D (UF.FCC.subS D G A s) (CW.subCEl D G A.1 a0 s)).ob x) ((DRC.Dx G A a0).ob x) (CM.1.ty x) ((DRC.upS D G A a0 s).sb x)).tob X z)) ((N.JG.jx x).eob X (((DRC.upS D G A a0 s).sb x).nt X z)) ((N.JD.jx x).eob X z) =
    transH (apH (\ e -> e.eob X (((DRC.upS D G A a0 s).sb x).nt X z)) (symH j0)) (transH (symH (JNG.jnat X z)) (apH (\ e -> e.eob X z) j1)) ;
   opaque pt ;
  } ;
  law : Id (CEl[N.Dd, N.CM'.1]) (CW.subCEl N.Dd N.Dc CM.1 N.JG.J N.up) N.JD.J =
   EX.cel-ext N.Dd N.CM'.1 (CW.subCEl N.Dd N.Dc CM.1 N.JG.J N.up) N.JD.J (\ x X z -> At[x].pt X z) ;
  opaque law ;
 } ;
} ;
