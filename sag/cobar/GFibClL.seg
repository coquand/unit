-- GFibClL.seg: GENERATED from FibClL.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change FibClL.seg or the generator.
-- FibClL.seg (M1, step 3): the classifier Cl = Fib at presheaf level l >= a,
-- over the base PosFull[a].  Core's CFibCl is the case l = a (fixed at the
-- base level inside CB; core is read-only here).  The universe of level-a
-- fibrant types is a type with level-a+ fibres, so the CwF that carries it
-- is FibCwF[a, a+], whose classifier is this one at l = a+.
--
-- Informal text (as CFibCl).  Substitution moves the structure along the
-- cart of A[s] into A (CFibSub).  c[id] = c: a structure is determined by
-- its extensions (CFibExt.fibExt), and the identity cart has the data of
-- the substitution cart at the identity (CCartLaws2.congFib).  c[s s'] =
-- c[s][s']: both are moves along carts with the same data (compFib,
-- congFib).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;

Cl (G : PCtx) (A : PTy[G]) : U l+ = PB.CLine[l].Lines[G, A].Fib ;

clSub (D G : PCtx) (s : PSub[D, G]) (A : PTy[G]) (c : Cl G A) : Cl D (subTy D G A s) = PB.CFibSub[l].FibSub[D, G, s, A].sub c ;

module FX = PB.CFibExt[l] ;

-- the identity
module Sid (G : PCtx) (A : PTy[G]) (c : Cl G A) {
  q : FX.FX[G].Pack A.tob = ((subTy G G A (idS G)).tact, ((subTy G G A (idS G)).tact-id, (subTy G G A (idS G)).tact-o)) ;

  Ht : PtEq G A.tob A.tact q.1 = \ J I f x y e x' -> tact-irr G A J I f x y e (ntEq G G (idS G) J I f x y e) x' ;

  mn : FX.FX[G].NatTy A q = \ V W g v ->
    apH {W0.Ix (A.tob V (G.act V W g (GPR.TyL[G, A].pr1 W v)))} {GPR.TyL[G, A].EI V} (\ z -> GPR.TyL[G, A].pr V (G.act V W g (GPR.TyL[G, A].pr1 W v)) z)
      (tact-irr G A V W g (GPR.TyL[G, A].pr1 W v) (G.act V W g (GPR.TyL[G, A].pr1 W v)) (refl (G.act V W g (GPR.TyL[G, A].pr1 W v))) (ntEq G G (idS G) V W g (GPR.TyL[G, A].pr1 W v) (G.act V W g (GPR.TyL[G, A].pr1 W v)) (refl (G.act V W g (GPR.TyL[G, A].pr1 W v)))) (GPR.TyL[G, A].pr2 W v)) ;

  law : Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c) =
    transH (FX.FX[G].fibExt A c q Ht mn)
      (apH {Cl G (subTy G G A (idS G))} {(A' : PTy[G]) * Cl G A'} (\ z -> (subTy G G A (idS G), z))
        (PB.CCartLaws2[l, l, l].CG[G, subTy G G A (idS G), G, A,
           \ W x -> x, \ V W g x -> refl (G.act V W g x), \ W v -> v, \ W v -> refl (GPR.TyL[G, subTy G G A (idS G)].pr1 W v), mn, \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (GPR.TyL[G, A].pr X x u),
           (idS G).nt, (idS G).nt-nat, PB.CSub[l].SubE[G, G, (idS G), A].mV, \ W v -> refl ((idS G).nt W (PB.CSub[l].SubE[G, G, (idS G), A].TS.pr1 W v)), PB.CSub[l].SubE[G, G, (idS G), A].mV-nat, PB.CSub[l].SubE[G, G, (idS G), A].mV-inj, \ X x u -> u, \ X x u -> refl (PB.CSub[l].SubE[G, G, (idS G), A].TC.pr X ((idS G).nt X x) u),
           \ W x -> refl x, \ W v -> refl v].congFib c)) ;
} ;

clSub-id (G : PCtx) (A : PTy[G]) (c : Cl G A) : Id ((A' : PTy[G]) * Cl G A') (A, c) (subTy G G A (idS G), clSub G G (idS G) A c) =
  Sid[G, A, c].law ;

-- composition
module So (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A) {
  B : PTy[T] = subTy T G A (oS T D G s s') ;
  B2 : PTy[T] = subTy T D (subTy D G A s) s' ;

  q : FX.FX[T].Pack B.tob = (B2.tact, (B2.tact-id, B2.tact-o)) ;

  Ht : PtEq T B.tob B.tact q.1 = \ J I f x y e x' ->
    tact-irr G A J I f (s.nt I (s'.nt I x)) (s.nt J (s'.nt J y)) (ntEq T G (oS T D G s s') J I f x y e)
      (ntEq D G s J I f (s'.nt I x) (s'.nt J y) (ntEq T D s' J I f x y e)) x' ;

  mn : FX.FX[T].NatTy B q = \ V W g v ->
    apH {W0.Ix (B.tob V (T.act V W g (GPR.TyL[T, B].pr1 W v)))} {GPR.TyL[T, B].EI V} (\ z -> GPR.TyL[T, B].pr V (T.act V W g (GPR.TyL[T, B].pr1 W v)) z)
      (Ht V W g (GPR.TyL[T, B].pr1 W v) (T.act V W g (GPR.TyL[T, B].pr1 W v)) (refl (T.act V W g (GPR.TyL[T, B].pr1 W v))) (GPR.TyL[T, B].pr2 W v)) ;

  module K1 = PB.CCartLaws2[l, l, l].CC[T, B2, T, B, G, A,
    \ W x -> x, \ V W g x -> refl (T.act V W g x), \ W v -> v, \ W v -> refl (GPR.TyL[T, B2].pr1 W v), mn, \ W v v' P Q -> Q, \ X x u -> u, \ X x u -> refl (GPR.TyL[T, B].pr X x u),
    (oS T D G s s').nt, (oS T D G s s').nt-nat, PB.CSub[l].SubE[T, G, (oS T D G s s'), A].mV, \ W v -> refl ((oS T D G s s').nt W (PB.CSub[l].SubE[T, G, (oS T D G s s'), A].TS.pr1 W v)), PB.CSub[l].SubE[T, G, (oS T D G s s'), A].mV-nat, PB.CSub[l].SubE[T, G, (oS T D G s s'), A].mV-inj, \ X x u -> u, \ X x u -> refl (PB.CSub[l].SubE[T, G, (oS T D G s s'), A].TC.pr X ((oS T D G s s').nt X x) u)] ;

  module K2 = PB.CCartLaws2[l, l, l].CC[T, B2, D, subTy D G A s, G, A,
    s'.nt, s'.nt-nat, PB.CSub[l].SubE[T, D, s', (subTy D G A s)].mV, \ W v -> refl (s'.nt W (PB.CSub[l].SubE[T, D, s', (subTy D G A s)].TS.pr1 W v)), PB.CSub[l].SubE[T, D, s', (subTy D G A s)].mV-nat, PB.CSub[l].SubE[T, D, s', (subTy D G A s)].mV-inj, \ X x u -> u, \ X x u -> refl (PB.CSub[l].SubE[T, D, s', (subTy D G A s)].TC.pr X (s'.nt X x) u),
    s.nt, s.nt-nat, PB.CSub[l].SubE[D, G, s, A].mV, \ W v -> refl (s.nt W (PB.CSub[l].SubE[D, G, s, A].TS.pr1 W v)), PB.CSub[l].SubE[D, G, s, A].mV-nat, PB.CSub[l].SubE[D, G, s, A].mV-inj, \ X x u -> u, \ X x u -> refl (PB.CSub[l].SubE[D, G, s, A].TC.pr X (s.nt X x) u)] ;

  law : Id ((A' : PTy[T]) * Cl T A') (B, clSub T G (oS T D G s s') A c) (B2, clSub T D s' (subTy D G A s) (clSub D G s A c)) =
    transH (FX.FX[T].fibExt B (clSub T G (oS T D G s s') A c) q Ht mn)
      (apH {Cl T B2} {(A' : PTy[T]) * Cl T A'} (\ z -> (B2, z))
        (calc (Cl T B2) {
            K1.C1.moveFib (K1.C2.moveFib c)
          =< K1.compFib c >
            K1.C12.moveFib c
          =< (PB.CCartLaws2[l, l, l].CG[T, B2, G, A,
                     K1.s, K1.s-nat, K1.ta, K1.tapt, K1.tanat, K1.tainj, K1.bk, K1.bkta,
                     K2.s, K2.s-nat, K2.ta, K2.tapt, K2.tanat, K2.tainj, K2.bk, K2.bkta,
                     \ W x -> refl (s.nt W (s'.nt W x)), \ W v -> refl (GPR.TyL[G, A].pr W (s.nt W (s'.nt W (GPR.TyL[T, B2].pr1 W v))) (GPR.TyL[T, B2].pr2 W v))].congFib c) >
            K2.C12.moveFib c
          =< symH (K2.compFib c) >
            K2.C1.moveFib (K2.C2.moveFib c) })) ;
} ;

clSub-o (T D G : PCtx) (s : PSub[D, G]) (s' : PSub[T, D]) (A : PTy[G]) (c : Cl G A)
  : Id ((A' : PTy[T]) * Cl T A') (subTy T G A (oS T D G s s'), clSub T G (oS T D G s s') A c)
                                  (subTy T D (subTy D G A s) s', clSub T D s' (subTy D G A s) (clSub D G s A c)) =
  So[T, D, G, s, s', A, c].law ;

