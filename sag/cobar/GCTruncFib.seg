-- GCTruncFib.seg: GENERATED from CTruncFib.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change CTruncFib.seg or the generator.
-- CTruncFib.seg (canonicity-c2; SIMPLIFIED.md item 1): the base
-- truncation of a fibrant type is fibrant.
--
-- (1) OpRC: the seeded extension operation of B over G is a relative
--     contractibility structure of B[p] over G.B (the seed is the point).
-- (2) A composition problem of ||A|| is a line ln of G, a base point t0
--     over its source end and a partial line with that end.  The seed
--     of CTruncSeed moves t0 to the target end, naturally; the problem
--     is then moved (CMove.Mv) to the extension problem of (1) at
--     (target end , seed), the partial element being the other end of
--     the partial line.
level l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
module PR = PB.GPre[l] ; open PR.PS ;
module HO = PB.CHtpyOps[l] ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module OpRC (G : PCtx) (B : PTy[G]) (k : GCTruncSeededBack[l].Seeded[G, B].Op) {
  D0 : PCtx = extP G B ;
  module SO = GCTruncSubOp[l].SubOp[D0, G, pP G B, B, k] ;
  T0 : PTy[D0] = SO.Bs ;
  module TB = PR.TyL[G, B] ;
  module T0L = PR.TyL[D0, T0] ;
  module PP0 = CP.Partials[D0, T0] ;
  kop (X : Ob) (z : W.Ix (D0.ob X)) (sd : PP0.Side[X, z]) : W.Ix (T0.tob X z) = SO.kop X z (TB.pr2 X z) sd ;
  kunif (Y X : Ob) (h : Hom Y X) (z : W.Ix (D0.ob X)) (sd : PP0.Side[X, z])
    : Id (T0L.EI Y) (T0L.E.act Y X h (pairE D0 T0 X z (kop X z sd)))
        (pairE D0 T0 Y (D0.act Y X h z) (kop Y (D0.act Y X h z) (PP0.rside Y X h z sd))) =
    transH (SO.Un[Y, X, h, z, TB.pr2 X z, sd].res)
      (apH (\ u' -> pairE D0 T0 Y (D0.act Y X h z) (SO.kop Y (D0.act Y X h z) u' (PP0.rside Y X h z sd)))
        (tact-irr G B Y X h (TB.pr1 X z) (TB.pr1 Y (D0.act Y X h z))
           (ntEq D0 G (pP G B) Y X h z (D0.act Y X h z) (refl (D0.act Y X h z)))
           (refl (G.act Y X h (TB.pr1 X z))) (TB.pr2 X z))) ;
  rc : CP.Rel[D0, T0, T0, CP.pmap-id D0 T0].RC =
    new CP.Rel[D0, T0, T0, CP.pmap-id D0 T0].RC[kop, \ X z sd Y h i -> SO.kside X z (TB.pr2 X z) sd Y h i, kunif] ;
} ;

module TrComp (G : PCtx) (A : PTy[G]) (d : Bool) (ca : CL.Lines[G, A].CompK[PB.src d, PB.tgt d].Comp) {
  module SD = GCTruncSeed[l].Seed[G, A, d, ca] ;
  Ty : PTy[G] = SD.TT.Ty ;
  module LK = CL.Lines[G, Ty].CompK[PB.src d, PB.tgt d] ;
  module EK = LK.EK ;
  Dc : PCtx = EK.TV.E ;
  module RCo = OpRC[G, Ty, SD.opG] ;
  D0 : PCtx = RCo.D0 ;
  T0 : PTy[D0] = RCo.T0 ;
  module TT' = PR.TyL[Dc, LK.Tend] ;
  module TS' = PR.TyL[Dc, EK.SFm.SF] ;
  module T0L = PR.TyL[D0, T0] ;
  module TY = PR.TyL[G, Ty] ;
  module SE0 = PB.CSub[l].SubE[D0, G, pP G Ty, Ty] ;

  -- a problem's point moved: (target end , seed)
  sF (X : Ob) (z : W.Ix (Dc.ob X)) : W.Ix (D0.ob X) =
    pairE G Ty X (SD.evt.nt X (EK.TV.pr1 X z)) (SD.seed.nfun X (EK.TV.pr1 X z) (EK.TV.pr2 X z)) ;
  s-nat (Y X : Ob) (g : Hom Y X) (z : W.Ix (Dc.ob X)) : Id (W.Ix (D0.ob Y)) (sF Y (Dc.act Y X g z)) (D0.act Y X g (sF X z)) =
    symH (transH (pair-act G Ty Y X g (SD.evt.nt X (EK.TV.pr1 X z)) (SD.evt.nt Y (SD.L.act Y X g (EK.TV.pr1 X z)))
                    (ntEq SD.L G SD.evt Y X g (EK.TV.pr1 X z) (SD.L.act Y X g (EK.TV.pr1 X z)) (refl (SD.L.act Y X g (EK.TV.pr1 X z))))
                    (SD.seed.nfun X (EK.TV.pr1 X z) (EK.TV.pr2 X z)))
            (apH (\ b -> pairE G Ty Y (SD.evt.nt Y (SD.L.act Y X g (EK.TV.pr1 X z))) b)
               (SD.seed.nnat Y X g (EK.TV.pr1 X z) (SD.L.act Y X g (EK.TV.pr1 X z)) (refl (SD.L.act Y X g (EK.TV.pr1 X z))) (EK.TV.pr2 X z)))) ;

  mT (X : Ob) (w : TT'.EI X) : T0L.EI X = pairE D0 T0 X (sF X (TT'.pr1 X w)) (TT'.pr2 X w) ;
  mS (X : Ob) (v : TS'.EI X) : T0L.EI X = mT X (LK.endL.mE X v) ;
  -- read in the totals of ||A||
  rdY (X : Ob) (w : TT'.EI X) : TY.EI X = TY.pr X (SD.evt.nt X (EK.TV.pr1 X (TT'.pr1 X w))) (TT'.pr2 X w) ;
  rdY-nat (Y X : Ob) (g : Hom Y X) (w : TT'.EI X) : Id (TY.EI Y) (TY.E.act Y X g (rdY X w)) (rdY Y (TT'.E.act Y X g w)) =
    transH (TY.pr-tact Y X g (SD.evt.nt X (EK.TV.pr1 X (TT'.pr1 X w))) (G.act Y X g (SD.evt.nt X (EK.TV.pr1 X (TT'.pr1 X w))))
              (refl (G.act Y X g (SD.evt.nt X (EK.TV.pr1 X (TT'.pr1 X w))))) (TT'.pr2 X w))
      (pair-act G Ty Y X g (SD.evt.nt X (EK.TV.pr1 X (TT'.pr1 X w))) (SD.evt.nt Y (EK.TV.pr1 Y (Dc.act Y X g (TT'.pr1 X w))))
         (ntEq SD.L G SD.evt Y X g (EK.TV.pr1 X (TT'.pr1 X w)) (EK.TV.pr1 Y (Dc.act Y X g (TT'.pr1 X w)))
            (ntEq Dc SD.L (pP SD.L (subTy SD.L G Ty SD.evs)) Y X g (TT'.pr1 X w) (Dc.act Y X g (TT'.pr1 X w)) (refl (Dc.act Y X g (TT'.pr1 X w)))))
         (TT'.pr2 X w)) ;
  mTnat (Y X : Ob) (g : Hom Y X) (w : TT'.EI X) : Id (T0L.EI Y) (T0L.E.act Y X g (mT X w)) (mT Y (TT'.E.act Y X g w)) =
    SE0.mV-inj Y (T0L.E.act Y X g (mT X w)) (mT Y (TT'.E.act Y X g w)) (symH (s-nat Y X g (TT'.pr1 X w)))
      (transH (symH (SE0.mV-nat Y X g (mT X w))) (rdY-nat Y X g w)) ;
  mSnat (Y X : Ob) (g : Hom Y X) (v : TS'.EI X) : Id (T0L.EI Y) (T0L.E.act Y X g (mS X v)) (mS Y (TS'.E.act Y X g v)) =
    transH (mTnat Y X g (LK.endL.mE X v)) (apH (mT Y) (symH (LK.endL.mnat Y X g v))) ;
  mTinj (X : Ob) (v v' : TT'.EI X) (P : Id (W.Ix (Dc.ob X)) (TT'.pr1 X v) (TT'.pr1 X v')) (Q : Id (T0L.EI X) (mT X v) (mT X v'))
    : Id (TT'.EI X) v v' =
    idJ (W.Ix (Dc.ob X)) (TT'.pr1 X v)
      (\ z2 P2 -> (b2 : TT'.T X z2) -> Id (T0L.EI X) (mT X v) (pairE D0 T0 X (sF X z2) b2) -> Id (TT'.EI X) v (TT'.pr X z2 b2))
      (\ b2 Q2 -> apH (TT'.pr X (TT'.pr1 X v)) (T0L.pr-inj X (sF X (TT'.pr1 X v)) (TT'.pr2 X v) b2 Q2))
      (TT'.pr1 X v') P (TT'.pr2 X v') Q ;

  module M = PB.CMove[l, l].Mv[Dc, EK.SFm.SF, LK.Tend, LK.endL, D0, T0, T0, CP.pmap-id D0 T0,
    sF, s-nat, mS, \ X v -> refl (sF X (TS'.pr1 X v)), mSnat, mT, \ X v -> refl (sF X (TT'.pr1 X v)), mTnat, mTinj,
    \ X x u -> u, \ X x u -> refl (pairE D0 T0 X (sF X x) u), \ X v -> refl (mS X v), RCo.rc] ;

  -- the composition of the truncation
  comp : LK.Comp = M.rc ;
} ;

-- the truncation of a fibrant type is fibrant
truncFib (G : PCtx) (A : PTy[G]) (fa : CL.Lines[G, A].Fib) : CL.Lines[G, GCTrunc[l].Truncation[G, A].Ty].Fib =
  (TrComp[G, A, true, fa.1].comp, TrComp[G, A, false, fa.2].comp) ;
