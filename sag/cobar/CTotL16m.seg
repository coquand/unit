-- CTotL16m.seg (canonicity-45; COBAR.md "Lemma 16"): Lemma 16 at yo F1, for
-- our C: G = D(yo F1), read as the type DAC = (D Y1T)[tau_1] over the
-- terminal context (c2's CtxTy), is D-modal; the levelwise fibration
-- structure of U(yo F1) is CCopy6.YoF.fibG0.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module YoMod (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module YF = CCopy6[a].YoF[R, encK, pe] ;
 module L16 = CTotL16l[a].RL[R, encK, pe].L16[YF.CT.T1, YF.O1.Y1T] ;
 module M = L16.Main[YF.fibG0] ;
 lemma16 : L16.G1.GB.CEquiv[a+].EquivOp L16.GP L16.DAC L16.B2 (L16.L16a.LRt.Map[L16.GP, L16.DAC, L16.B2, L16.L16a.tauD].pmap) = M.lemma16 ;
} ;

-- Delta N, the constant presheaf N at the total site, and Lemma 16 at it
module NMod (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module YF = CCopy6[a].YoF[R, encK, pe] ;
 module TR = YF.TR ;
 module CT = YF.CT ;
 module CC = YF.CC ;
 GP : TR.P1.PCtx = YF.GP ;
 UG : TR.P0.PCtx = YF.UG ;
 DeltaN : TR.P1.PTy[GP] = TR.P1.mkTy GP (\ X o -> V1.natV) (\ J I f x x' e n -> n) (\ I x e n -> refl n) (\ K J I f g x x' x'' e1 e2 e3 n -> refl n) ;
 UN : TR.P0.PTy[UG] = TR.RS.rT GP DeltaN ;
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 CN : FibCwF[a, a+].FC.STy Nl = CConst[a, a+].ConstOf[CCyl[a].PosCyl.posCyl, V1.natV].constS Nl ;
 module Cp (y : SX.Over[R].Presentation) {
  module Cy = CC.Copy[y] ;
  D : L.PCtx = Cy.rCy UG ;
  A' : L.PTy[D] = Cy.rTy UG UN ;
  module TA' = PB.GPre[a+].TyL[D, A'] ;
  module TA = PB.GPre[a+].TyL[Nl, CN.1] ;
  s (W : Ob) (x : V1.Ix (D.ob W)) : V1.Ix (Nl.ob W) = tt ;
  snat (Vv W : Ob) (g : Hom Vv W) (d : V1.Ix (D.ob W)) : Id (V1.Ix (Nl.ob Vv)) (s Vv (D.act Vv W g d)) (Nl.act Vv W g (s W d)) = refl tt ;
  ta (W : Ob) (v : TA'.EI W) : TA.EI W = TA.pr W tt (TA'.pr2 W v) ;
  tapt (W : Ob) (v : TA'.EI W) : Id (V1.Ix (Nl.ob W)) (TA.pr1 W (ta W v)) (s W (TA'.pr1 W v)) = refl tt ;
  tanat (Vv W : Ob) (g : Hom Vv W) (v : TA'.EI W) : Id (TA.EI Vv) (TA.E.act Vv W g (ta W v)) (ta Vv (TA'.E.act Vv W g v)) = refl (ta Vv (TA'.E.act Vv W g v)) ;
  tainj (W : Ob) (v v' : TA'.EI W) (Pp : Id (V1.Ix (D.ob W)) (TA'.pr1 W v) (TA'.pr1 W v')) (Q : Id (TA.EI W) (ta W v) (ta W v')) : Id (TA'.EI W) v v' =
   idJ (V1.Ix (D.ob W)) (TA'.pr1 W v)
    (\ o2 P2 -> (m2 : V1.Ix (A'.tob W o2)) -> Id (V1.Ix V1.natV) (TA'.pr2 W v) m2 -> Id (TA'.EI W) v (TA'.pr W o2 m2))
    (\ m2 Q2 -> apH {V1.Ix V1.natV} {TA'.EI W} (TA'.pr W (TA'.pr1 W v)) Q2)
    (TA'.pr1 W v') Pp (TA'.pr2 W v') (TA.pr-inj W tt (TA'.pr2 W v) (TA'.pr2 W v') Q) ;
  bk (X : Ob) (x : V1.Ix (D.ob X)) (u : V1.Ix (CN.1.tob X (s X x))) : V1.Ix (A'.tob X x) = u ;
  bkta (X : Ob) (x : V1.Ix (D.ob X)) (u : V1.Ix (CN.1.tob X (s X x))) : Id (TA.EI X) (ta X (TA'.pr X x (bk X x u))) (TA.pr X (s X x) u) = refl (TA.pr X tt u) ;
  module CRT = PB.CCart[a+, a+].Cart[D, A', Nl, CN.1, s, snat, ta, tapt, tanat, tainj, bk, bkta] ;
  fib : PB.CLine[a+].Lines[D, A'].Fib = CRT.moveFib CN.2 ;
 } ;
 fibG0 : TR.G0.GB.CLine[a+].Lines[UG, UN].Fib = CCopy5[a].FibC[R, encK, pe, UG, UN, \ y -> Cp[y].fib].fib ;
 module L16 = CTotL16l[a].RL[R, encK, pe].L16[CT.T1, DeltaN] ;
 -- N_D = D(Delta N) is D-modal
 lemma16 : L16.G1.GB.CEquiv[a+].EquivOp L16.GP L16.DAC L16.B2 (L16.L16a.LRt.Map[L16.GP, L16.DAC, L16.B2, L16.L16a.tauD].pmap) = L16.Main[fibG0].lemma16 ;
} ;
