-- GFibNF.seg: GENERATED from FibNF.seg by tools/mkseg.py (canonicity-c2): the same file
-- as a member of the segment CFibSeg.FB, over any base with the dependent
-- conjunction of sieves.  Do not edit; change FibNF.seg or the generator.
-- FibNF.seg (M1 step 3, S4, input NF): naive function extensionality for
-- the Yoneda Id over Pi in the CwF of fibrant types GFibCwF[l].
--
-- Informal text.
-- (A) A line field for a type T over G is a family U W y j : T(W , y), for
--     y : G(W) and j : W -> I, natural in (W , y , j).  With ends
--     U W y e0 = a y and U W y e1 = b y it is an element of Id(a , b): at
--     x : G(X) the path is (W , f , j) |-> U W (x f) j, with the empty
--     sieve.  Its readings at (V , g , j) are (x g , U V (x g) j), so the
--     element is natural (its restriction along h has the readings of the
--     path at h g, and x (h g) = y g), the sieves being empty on both sides.
-- (B) Given h : Pi x Id(f x , g x), let hv K z j : B(K , z) be the value of
--     the path h z at (K , id , j) (read at z through act-id).  It is
--     natural in (K , z , j): its reading is a reading of h z, readings are
--     natural, and h is natural.  At its ends it is f z and g z.  The line
--     field of Pi A B is U W y j = (K , m , a) |-> hv K (y m , a) (j m):
--     natural since hv is (an element of Pi is determined by its values,
--     values transported along a path of points are hv at the other point);
--     its ends are f y and g y (ptH-nat, the ends of hv, la-pt).
-- (C) NF is (B) applied to the function of h, at the fibrant types.

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;
module PP = PresheafPi[a, l].PPi[PB.BC] ;

------------------------------------------------------------------------
-- (A) a line field with ends is an element of the Yoneda Id

module LineY (G : PCtx) (T : PTy[G]) (a0 b0 : PEl[G, T])
  (Lf : (W : Ob) (y : W0.Ix (G.ob W)) (j : IvP W) -> W0.Ix (T.tob W y))
  (Unat : (V W : Ob) (g : Hom V W) (y : W0.Ix (G.ob W)) (y' : W0.Ix (G.ob V)) (E : Id (W0.Ix (G.ob V)) (G.act V W g y) y') (j : IvP W)
     -> Id (W0.Ix (T.tob V y')) (T.tact V W g y y' E (Lf W y j)) (Lf V y' (ivA V W g j)))
  (U0 : (W : Ob) (y : W0.Ix (G.ob W)) -> Id (W0.Ix (T.tob W y)) (Lf W y (PB.ptH W e0)) (a0.eob W y))
  (U1 : (W : Ob) (y : W0.Ix (G.ob W)) -> Id (W0.Ix (T.tob W y)) (Lf W y (PB.ptH W e1)) (b0.eob W y)) {
  module Y = GPosIdY[l].IdY[G, T, a0, b0] ;

  val (X : Ob) (x : W0.Ix (G.ob X)) : W0.Ix (Y.tob X x) =
    ((\ W f j -> Lf W (Y.pt X x W f) j,
      (\ V W g f j -> Unat V W g (Y.pt X x W f) (Y.pt X x V (compH V W X f g)) (Y.ptn X x V W g f) j,
       (\ W f -> U0 W (Y.pt X x W f),
        \ W f -> U1 W (Y.pt X x W f)))),
     (PB.emptyS X, \ W f i j -> absurd (Id (W0.Ix (T.tob W (Y.pt X x W f))) (Lf W (Y.pt X x W f) j) (a0.eob W (Y.pt X x W f)))
                                   (PB.empty-lands W X f i))) ;

  enat (J I : Ob) (h : Hom J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I h x) y)
    : Id (W0.Ix (Y.tob J y)) (Y.tactY J I h x y e (val I x)) (val J y) =
    Y.idY-eq J y (Y.tactY J I h x y e (val I x)) (val J y)
      (\ V g j -> transH (Y.Tact[J, I, h, x, y, e, val I x].rdc V g j)
                    (apH (\ z -> Y.TA.pr V z (Lf V z j)) (Y.Tact[J, I, h, x, y, e, val I x].pi V g)))
      (PB.pre-empty J I h) ;

  el : PEl[G, Y.IdYT] = mkPEl G Y.IdYT val enat ;
} ;

------------------------------------------------------------------------
-- (B) the line field of Pi A B from a family of paths

module NFP (G : PCtx) (A : PTy[G]) (B : PTy[extP G A]) (f g : PEl[G, PP.PiCode[G, A, B].PiP])
  (h : PEl[extP G A, GPosIdY[l].IdY[extP G A, B, PP.PiCode[G, A, B].appEl f, PP.PiCode[G, A, B].appEl g].IdYT]) {
  module PC = PP.PiCode[G, A, B] ;
  module YB = GPosIdY[l].IdY[extP G A, B, PC.appEl f, PC.appEl g] ;
  module TB = YB.TA ;
  GA : PCtx = extP G A ;

  -- the value of the path h z at (K , id , j)
  hv (K : Ob) (z : W0.Ix (GA.ob K)) (j : IvP K) : W0.Ix (B.tob K z) =
    TB.coeT K (YB.pt K z K (idH K)) z (GA.act-id K z) ((h.eob K z).1.1 K (idH K) j) ;

  hv-rd (K : Ob) (z : W0.Ix (GA.ob K)) (j : IvP K) : Id (TB.EI K) (TB.pr K z (hv K z j)) (YB.rd K z (h.eob K z) K (idH K) j) =
    symH (TB.pr-coe K (YB.pt K z K (idH K)) z (GA.act-id K z) ((h.eob K z).1.1 K (idH K) j)) ;

  hv-nat (L K : Ob) (m : Hom L K) (z : W0.Ix (GA.ob K)) (z' : W0.Ix (GA.ob L)) (E : Id (W0.Ix (GA.ob L)) (GA.act L K m z) z') (j : IvP K)
    : Id (W0.Ix (B.tob L z')) (B.tact L K m z z' E (hv K z j)) (hv L z' (ivA L K m j)) =
    TB.pr-inj L z' (B.tact L K m z z' E (hv K z j)) (hv L z' (ivA L K m j))
      (calc (TB.EI L) {
          TB.pr L z' (B.tact L K m z z' E (hv K z j))
        =< symH (TB.pr-tact L K m z z' E (hv K z j)) >
          TB.E.act L K m (TB.pr K z (hv K z j))
        =< apH (TB.E.act L K m) (hv-rd K z j) >
          TB.E.act L K m (YB.rd K z (h.eob K z) K (idH K) j)
        =< YB.rd-nat K z (h.eob K z) L K m (idH K) j >
          YB.rd K z (h.eob K z) L (compH L K K (idH K) m) (ivA L K m j)
        =< apH (\ k -> YB.rd K z (h.eob K z) L k (ivA L K m j)) (transH (comp-idl L K m) (symH (comp-idr L K m))) >
          YB.rd K z (h.eob K z) L (compH L L K m (idH L)) (ivA L K m j)
        =< symH (YB.Tact[L, K, m, z, z', E, h.eob K z].rdc L (idH L) (ivA L K m j)) >
          YB.rd L z' (YB.tactY L K m z z' E (h.eob K z)) L (idH L) (ivA L K m j)
        =< apH (\ w -> YB.rd L z' w L (idH L) (ivA L K m j)) (h.enat L K m z z' E) >
          YB.rd L z' (h.eob L z') L (idH L) (ivA L K m j)
        =< symH (hv-rd L z' (ivA L K m j)) >
          TB.pr L z' (hv L z' (ivA L K m j)) }) ;

  -- at an end, hv is the end of the path
  hv-end (c : PEl[GA, B]) (e : PB.IPt) (K : Ob) (z : W0.Ix (GA.ob K))
    (Ez : Id (W0.Ix (B.tob K (YB.pt K z K (idH K)))) ((h.eob K z).1.1 K (idH K) (PB.ptH K e)) (c.eob K (YB.pt K z K (idH K))))
    : Id (W0.Ix (B.tob K z)) (hv K z (PB.ptH K e)) (c.eob K z) =
    TB.pr-inj K z (hv K z (PB.ptH K e)) (c.eob K z)
      (transH (hv-rd K z (PB.ptH K e))
        (transH (apH (TB.pr K (YB.pt K z K (idH K))) Ez)
          (apH (\ z1 -> TB.pr K z1 (c.eob K z1)) (GA.act-id K z)))) ;

  -- hv moved along a path of points
  hv-tr (K : Ob) (z1 z2 : W0.Ix (GA.ob K)) (Q : Id (W0.Ix (GA.ob K)) z1 z2) (j : IvP K)
    : Id (W0.Ix (B.tob K z2)) (subst (W0.Ix (GA.ob K)) (\ w -> W0.Ix (B.tob K w)) z1 z2 Q (hv K z1 j)) (hv K z2 j) =
    idJ (W0.Ix (GA.ob K)) z1
      (\ z3 Q3 -> Id (W0.Ix (B.tob K z3)) (subst (W0.Ix (GA.ob K)) (\ w -> W0.Ix (B.tob K w)) z1 z3 Q3 (hv K z1 j)) (hv K z3 j))
      (refl (hv K z1 j)) z2 Q ;

  -- the line field
  zz (W : Ob) (y : W0.Ix (G.ob W)) (K : Ob) (m : Hom K W) (a1 : W0.Ix (A.tob K (G.act K W m y))) : W0.Ix (GA.ob K) =
    pairE G A K (G.act K W m y) a1 ;

  phi (W : Ob) (y : W0.Ix (G.ob W)) (j : IvP W) : PC.FunT W (PC.ptOf W y) =
    \ K m a1 -> hv K (zz W y K m a1) (ivA K W m j) ;

  phiN (W : Ob) (y : W0.Ix (G.ob W)) (j : IvP W) : PC.NatT W (PC.ptOf W y) (PC.cOf W y) (PC.eOf W y) (phi W y j) =
    \ K L m g1 a1 ->
      transH (hv-nat L K g1 (zz W y K m a1) (zz W y L (compH L K W m g1) (PC.AactOf W (PC.ptOf W y) (PC.cOf W y) K L m g1 a1))
                (PC.eOf W y K L m g1 a1) (ivA K W m j))
             (apH (hv L (zz W y L (compH L K W m g1) (PC.AactOf W (PC.ptOf W y) (PC.cOf W y) K L m g1 a1))) (ivA-comp L K W m g1 j)) ;

  Uv (W : Ob) (y : W0.Ix (G.ob W)) (j : IvP W) : W0.Ix (PC.PiO W y) = (phi W y j, phiN W y j) ;

  Unat (V W : Ob) (g1 : Hom V W) (y : W0.Ix (G.ob W)) (y' : W0.Ix (G.ob V)) (E : Id (W0.Ix (G.ob V)) (G.act V W g1 y) y') (j : IvP W)
    : Id (W0.Ix (PC.PiO V y')) (PC.PiP.tact V W g1 y y' E (Uv W y j)) (Uv V y' (ivA V W g1 j)) =
    PC.piCode-eq V (PC.ptOf V y') (PC.cOf V y') (PC.eOf V y') (PC.PiP.tact V W g1 y y' E (Uv W y j)) (Uv V y' (ivA V W g1 j))
      (\ K m a1 ->
        transH (hv-tr K
                  (pairE G A K (G.act K W (compH K V W g1 m) y)
                     (PP.bk G A K (G.act K W (compH K V W g1 m) y) (G.act K V m y') (PC.piPt V W g1 y y' E K m) a1))
                  (zz V y' K m a1)
                  (PP.pairpath G A K (G.act K W (compH K V W g1 m) y) (G.act K V m y') (PC.piPt V W g1 y y' E K m) a1)
                  (ivA K W (compH K V W g1 m) j))
               (apH (hv K (zz V y' K m a1)) (symH (ivA-comp K V W g1 m j)))) ;

  Uend (c : PEl[G, PC.PiP]) (e : PB.IPt)
    (Ez : (K : Ob) (z : W0.Ix (GA.ob K))
       -> Id (W0.Ix (B.tob K (YB.pt K z K (idH K)))) ((h.eob K z).1.1 K (idH K) (PB.ptH K e)) ((PC.appEl c).eob K (YB.pt K z K (idH K))))
    (W : Ob) (y : W0.Ix (G.ob W)) : Id (W0.Ix (PC.PiO W y)) (Uv W y (PB.ptH W e)) (c.eob W y) =
    PC.piCode-eq W (PC.ptOf W y) (PC.cOf W y) (PC.eOf W y) (Uv W y (PB.ptH W e)) (c.eob W y)
      (\ K m a1 ->
        transH (apH (hv K (zz W y K m a1)) (PB.ptH-nat K W m e))
          (transH (hv-end (PC.appEl c) e K (zz W y K m a1) (Ez K (zz W y K m a1)))
            (PC.la-pt c W y K m a1))) ;

  module LY = LineY[G, PC.PiP, f, g, Uv, Unat,
    Uend f e0 (\ K z -> (h.eob K z).1.2.2.1 K (idH K)),
    Uend g e1 (\ K z -> (h.eob K z).1.2.2.2 K (idH K))] ;

  nf : PEl[G, LY.Y.IdYT] = LY.el ;
} ;

------------------------------------------------------------------------
-- (C) NF at the fibrant types

module FCw = GFibCwF[l] ;

nf (G : FCw.fibCwF.Ctx) (A : FCw.fibCwF.Ty G) (B : FCw.fibCwF.Ty (FCw.fibCwF.ext G A))
   (f g : FCw.fibCwF.El G (FCw.fibPi.Pi G A B))
   (h : FCw.fibCwF.El G (FCw.fibPi.Pi G A (GFibId[l].fibId.IdT (FCw.fibCwF.ext G A) B
          ((FCw.fibPi.Pi-iso G A B).fun f) ((FCw.fibPi.Pi-iso G A B).fun g))))
  : FCw.fibCwF.El G (GFibId[l].fibId.IdT G (FCw.fibPi.Pi G A B) f g) =
  NFP[G, A.1, B.1, f, g,
      PP.PiCode[G, A.1, (GFibId[l].fibId.IdT (FCw.fibCwF.ext G A) B
          ((FCw.fibPi.Pi-iso G A B).fun f) ((FCw.fibPi.Pi-iso G A B).fun g)).1].appEl h].nf ;
