-- CSpA.seg (canonicity-45; COBAR.md "Prop 58", 4e's ruling): the type Sp(u)
-- over Pr = G^k: the Sigma-collapse of c2's telescope (CAxSp: the points
-- x : G^n, then the Ids q_j(x) = 0), with G's concrete operations (CAxOps at
-- CAlEq) and constants (CCst3's cst r), the innermost factor the constant unit
-- type (CAxDelta).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module SA (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (k n : Nat) {
 module GR = CGRing[a].GR[R, encK, pe] ;
 module OP = CAxOps[a].OpsOf[R, encK, pe, GR.al, \ y -> GR.AE[y].A.eqal, \ y -> GR.AE[y].A.commH] ;
 module K3 = CCst3[a].Cst3[R, encK, pe] ;
 module FN = K3.Fin[CUF0[a].cF0 R encK pe] ;
 module EG = OP.EG ;
 cV (r : R.R) (X : EG.Ob) : EG.GV X = FN.KR[r].cstD X ;
 cN (r : R.R) (J I : EG.Ob) (f : EG.Hm J I) : Id (EG.GV J) (EG.rsG J I f (cV r I)) (cV r J) = FN.KR[r].NT[J, I, f].law ;
 module SO = CAxSp[a].SpOf[R, encK, pe, OP.addV, OP.mulV, OP.addN, OP.mulN, cV, cN, k, n] ;
 C : CwF.CwF[a++] = SO.C ;
 Sig (G : C.Ctx) (A : C.Ty G) (B : C.Ty (C.ext G A)) : C.Ty G = SO.PW.G1.fibSig-T.Sig G A B ;
 Ut (G : C.Ctx) : C.Ty G = CAxDelta[a].DeltaOf[R, encK, pe].D V1.unitV G ;
 SigH : (qs : SX.Over[R].Equations SO.TW.Var) -> C.Ty (SO.HS qs).1 -> C.Ty SO.Xc = split {
  nil -> \ B -> B ;
  cons q qs | r -> \ B -> r (Sig (SO.HS qs).1 (SO.EqT (SO.HS qs).1 (SO.HS qs).2 q) B) } ;
 SigX : (j : Nat) -> C.Ty (SO.PW.Ext SO.Pr j) -> C.Ty SO.Pr = split {
  zero -> \ B -> B ;
  suc j | r -> \ B -> r (Sig (SO.PW.Ext SO.Pr j) (SO.PW.Gat (SO.PW.Ext SO.Pr j)) B) } ;
 -- Sp(u) over G^k
 Sp (qs : SX.Over[R].Equations SO.TW.Var) : C.Ty SO.Pr = SigX n (SigH qs (Ut (SO.HS qs).1)) ;
} ;
