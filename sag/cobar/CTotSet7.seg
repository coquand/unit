-- CTotSet7.seg (canonicity-c2; "D preserves h-sets", part 7): an element
-- rv of R at a point k of D G . D A . D A and an interval point jj give
-- an element of D A over k's point of D G: at an index q (map u into the
-- object) the reading psi at ivA u jj of rv's Id_A element at q (moved to
-- the point of D G along act-id). Its equations are rv's, through psi's
-- naturality (CTotSet6) and the laws of ivA.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
module Wt = Weights[a, l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module ST7 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G)) {
 module S6 = CTotSet6[a, vl, l].ST6[C, G, A] ;
 module S4 = CTotSet4[a, vl, l].ST4[C, G, A] ;
 module S1 = S6.S1 ;
 module G1 = S1.G1 ;
 module DI = S4.DI ;
 module DAm = S1.P2.DA ;
 module VE (I : Ob) (x : DAm.Obj I) (k : W0.Ix (S1.K.ob (I, x))) (rv : DI.TOb' I x (S1.phi2.nt (I, x) k)) (jj : G1.GB.IvP (I, x)) {
  gp : DAm.D.Ob' I x = k.1.1 ;
  zq (q : DAm.Idx I x) (l : DAm.LandsI I x q) : W0.Ix (S6.E1.ob (q.2.1, q.2.2.2.1)) = (S1.phi2.nt (I, x) k).1 q l ;
  jq (q : DAm.Idx I x) : G1.GB.IvP (q.2.1, q.2.2.2.1) = G1.PB.ivA q.2.1 I q.2.2.1 jj ;
  Xq (q : DAm.Idx I x) (l : DAm.LandsI I x q) : W0.Ix (S6.EI.ob (q.2.1, q.2.2.2.1)) = DI.prz q.2.1 q.2.2.2.1 (zq q l) (rv.1 q l) ;
  ps (q : DAm.Idx I x) (l : DAm.LandsI I x q) : DAm.Ez q.2.1 q.2.2.2.1 = S6.psi (q.2.1, q.2.2.2.1) (jq q) (Xq q l) ;
  pth (q : DAm.Idx I x) (l : DAm.LandsI I x q) : Id (DAm.Pt q.2.1 q.2.2.2.1) (ps q l).1 (gp.1 q l) =
   apH {W0.Ix (S6.E1.ob (q.2.1, q.2.2.2.1))} {DAm.Pt q.2.1 q.2.2.2.1} (\ v -> v.1.1) (S6.E1.act-id (q.2.1, q.2.2.2.1) (zq q l)) ;
  av : DAm.TA I x gp = \ q l -> DAm.coeT q.2.1 q.2.2.2.1 (ps q l).1 (gp.1 q l) (pth q l) (ps q l).2 ;
  eqq (q : DAm.Idx I x) (l : DAm.LandsI I x q) : Id (DAm.Ez q.2.1 q.2.2.2.1) (DAm.prz q.2.1 q.2.2.2.1 (gp.1 q l) (av q l)) (ps q l) =
   symH (DAm.pr-coe q.2.1 q.2.2.2.1 (ps q l).1 (gp.1 q l) (pth q l) (ps q l).2) ;
  pw : DI.D.Ob' I x = S1.phi2.nt (I, x) k ;
  eqR (n : Nat) (J : Ob) (z : DAm.Obj J) (i : VA.Ix (DAm.DO.coordV n J)) (sw : DAm.D.S I x n J z) (l : DAm.LandsI I x (n, J, sw.1, z, sw.2, i))
    : Id (DAm.Ez J z) (DAm.rdP I x gp av n J z i sw l) (S6.psi (J, z) (jq (n, J, sw.1, z, sw.2, i)) (DI.rdP I x pw rv.1 n J z i sw l)) =
   eqq (n, J, sw.1, z, sw.2, i) l ;
  anat' : W0.Ix (DAm.anatEq I x gp av) = \ rr lq ->
   transH (apH {DAm.Ez rr.1.2.1 rr.1.2.2.2.1} {DAm.Ez rr.2.1 (C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1)}
             (DAm.E.act (rr.2.1, C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1) (rr.1.2.1, rr.1.2.2.2.1) (rr.2.2, C.cart rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1))
             (eqq rr.1 lq))
    (transH (S6.PN[(rr.2.1, C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1), (rr.1.2.1, rr.1.2.2.2.1), (rr.2.2, C.cart rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1), jq rr.1, Xq rr.1 lq].law)
     (transH (apH {W0.Ix (S6.EI.ob (rr.2.1, C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1))} {DAm.Ez rr.2.1 (C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1)}
                (S6.psi (rr.2.1, C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1) (G1.PB.ivA rr.2.1 rr.1.2.1 rr.2.2 (jq rr.1))) (rv.2.1 rr lq))
      (transH (apH {G1.GB.IvP (rr.2.1, C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1)} {DAm.Ez rr.2.1 (C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1)}
                 (\ j -> S6.psi (rr.2.1, C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1) j (DI.anatR I x pw rv.1 rr lq))
                 (G1.PB.ivA-comp rr.2.1 rr.1.2.1 I rr.1.2.2.1 rr.2.2 jj))
        (symH (eqR rr.1.1 rr.2.1 (C.res rr.2.1 rr.1.2.1 rr.2.2 rr.1.2.2.2.1) (Wt.Res[rr.1.1, rr.2.1, rr.1.2.1, rr.2.2, (rr.1.2.2.2.2.2, lq)].res).1
                 (compH rr.2.1 rr.1.2.1 I rr.1.2.2.1 rr.2.2, DAm.DO.rCh rr.2.1 rr.1.2.1 I rr.2.2 rr.1.2.2.1 x rr.1.1 rr.1.2.2.2.1 rr.1.2.2.2.2.1)
                 (Wt.Res[rr.1.1, rr.2.1, rr.1.2.1, rr.2.2, (rr.1.2.2.2.2.2, lq)].res).2))))) ;
  face' : W0.Ix (DAm.afaceEq I x gp av) = \ rr lq ->
   transH (eqq (suc rr.1, rr.2.2.2.1, rr.2.2.2.2.1, rr.2.2.2.2.2.1, rr.2.2.2.2.2.2.1, (DAm.afaceF I x rr lq).1) (DAm.afaceF I x rr lq).2)
    (transH (apH {W0.Ix (S6.EI.ob (rr.2.2.2.1, rr.2.2.2.2.2.1))} {DAm.Ez rr.2.2.2.1 rr.2.2.2.2.2.1}
               (S6.psi (rr.2.2.2.1, rr.2.2.2.2.2.1) (G1.PB.ivA rr.2.2.2.1 I rr.2.2.2.2.1 jj)) (rv.2.2.1 rr lq))
      (symH (eqq (rr.1, rr.2.2.2.1, rr.2.2.2.2.1, rr.2.2.2.2.2.1,
                  DAm.DO.KJ[rr.2.2.2.1].K.comp rr.1 rr.2.1 (C.res rr.2.2.2.1 I rr.2.2.2.2.1 x) rr.2.2.2.2.2.1 rr.2.2.2.2.2.2.1, rr.2.2.2.2.2.2.2) lq))) ;
  top' : W0.Ix (DAm.atopEq I x gp av) = \ rr lq ->
   transH (eqq (suc rr.1, rr.2.1, rr.2.2.1, rr.2.2.2.1, rr.2.2.2.2.1, (DAm.atopF I x rr lq).1) (DAm.atopF I x rr lq).2)
    (transH (apH {W0.Ix (S6.EI.ob (rr.2.1, rr.2.2.2.1))} {DAm.Ez rr.2.1 rr.2.2.2.1}
               (S6.psi (rr.2.1, rr.2.2.2.1) (G1.PB.ivA rr.2.1 I rr.2.2.1 jj)) (rv.2.2.2 rr lq))
     (transH (apH {G1.GB.IvP (rr.2.1, rr.2.2.2.1)} {DAm.Ez rr.2.1 rr.2.2.2.1}
                (\ j -> S6.psi (rr.2.1, rr.2.2.2.1) j (DI.atopR I x pw rv.1 rr lq))
                (symH (G1.PB.ivA-id rr.2.1 (G1.PB.ivA rr.2.1 I rr.2.2.1 jj))))
      (transH (symH (S6.PN[(rr.2.1, rr.2.2.2.1), (rr.2.1, (DAm.D.topD I x rr).1), (idH rr.2.1, (DAm.D.topD I x rr).2.2),
                          G1.PB.ivA rr.2.1 I rr.2.2.1 jj,
                          Xq (rr.1, rr.2.1, rr.2.2.1, (DAm.D.topD I x rr).1, (DAm.D.topD I x rr).2.1, rr.2.2.2.2.2) lq].law))
        (apH {DAm.Ez rr.2.1 (DAm.D.topD I x rr).1} {DAm.Ez rr.2.1 rr.2.2.2.1}
           (DAm.E.act (rr.2.1, rr.2.2.2.1) (rr.2.1, (DAm.D.topD I x rr).1) (idH rr.2.1, (DAm.D.topD I x rr).2.2))
           (symH (eqq (rr.1, rr.2.1, rr.2.2.1, (DAm.D.topD I x rr).1, (DAm.D.topD I x rr).2.1, rr.2.2.2.2.2) lq)))))) ;
  res : DAm.TOb' I x gp = (av, anat', face', top') ;
 } ;
} ;
