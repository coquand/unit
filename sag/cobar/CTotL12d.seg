-- CTotL12d.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 12 at the
-- total site, trivial half, part d: piece 0 under restriction.
--   Coh.coh   the restriction of piece 0 at an index along a base map h
--             is piece 0 at the restricted index (over gm's naturality)
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module L12d (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LC = CTotL12c[a, vl, l].L12c[C, G, A] ;
 module LB = LC.LB ;
 module LA = LC.LA ;
 module CL = LC.CL ;
 module TR = LA.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = LA.TC ;
 module VT = LA.VT ;
 module DO = LA.DO ;
 module D = LA.D ;
 module DA = LA.DA ;
 module CT = DO.CT ;
 module Py = LB.Py ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 UG : TR.P0.PCtx = LB.UG ;
 UA : TR.P0.PTy[UG] = LB.UA ;
 Ob0 : U vl = TR.RN.Ob0 ;

 module Fd (X : TC.TOb) (gm : W0.Ix (LA.DG.ob X)) (s : LA.PD.Side[X, gm]) {
  module FC = LC.Fc[X, gm, s] ;
  module F = FC.F ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;

  module Coh (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : F.Ch n J u z) (i : Wt.Pn n J) (J' : Ob) (h : Hom J' J) {
   module Q = FC.Q0[n, J, u, z, c, i] ;
   rzh : Obj J' = C.res J' J h z ;
   uh : Hom J' I = compH J' J I u h ;
   c' : F.Ch n J' uh rzh = DO.rCh J' J I h u x n z c ;
   i' : Wt.Pn n J' = Wt.Res[n, J', J, h, i].res ;
   module Q' = FC.Q0[n, J', uh, rzh, c', i'] ;
   Y' : Ob0 = (J', rzh) ;
   hh : TR.RN.Hom0 Y' Q.Y = (h, refl rzh) ;
   gnat : Id (W0.Ix (G.ob J' rzh)) (UG.act Y' Q.Y hh Q.gp) Q'.gp = gm.2.1 ((n, J, u, z, c, i.1), (J', h)) i.2 ;
   module EV (W1 : Ob) (f1 : Hom W1 J') (la : PB.Lands W1 J Q.Q (compH W1 J' J h f1)) (lb : PB.Lands W1 J' Q'.Q f1) {
    T0 : Obj W1 = C.res W1 J' f1 rzh ;
    hf : Hom W1 J = compH W1 J' J h f1 ;
    module R2 = CL.RC2[W1, J', J, I, f1, h, u, x, n, z, c] ;
    SP (eT : Id (Obj W1) (C.res W1 J hf z) T0)
     : Id (D.S I x n W1 T0) (compH W1 J' I uh f1, DO.rCh W1 J' I f1 uh x n rzh c') (compH W1 J I u hf, Q.cT W1 hf T0 eT) =
     D.sEq I x n W1 T0 (compH W1 J' I uh f1) (compH W1 J I u hf) (comp-assoc W1 J' J I u h f1)
      (DO.rCh W1 J' I f1 uh x n rzh c') (Q.cT W1 hf T0 eT)
      (transH R2.law
         (apH {Id (Obj W1) (C.res W1 J hf z) T0} {CT.Ch W1 n (C.res W1 I (compH W1 J I u hf) x) T0} (\ e -> Q.cT W1 hf T0 e)
            (CT.setObj W1 (C.res W1 J hf z) T0 R2.et eT))) ;
    evg (y : Obj W1) (e' : Id (Obj W1) T0 y) (eT : Id (Obj W1) (C.res W1 J hf z) y)
     : Id (DA.Ez W1 y) (Q.vg W1 hf y eT la) (Q'.vg W1 f1 y e' lb) =
     idJ (Obj W1) T0
      (\ y2 e2 -> (eT2 : Id (Obj W1) (C.res W1 J hf z) y2) -> Id (DA.Ez W1 y2) (Q.vg W1 hf y2 eT2 la) (Q'.vg W1 f1 y2 e2 lb))
      (\ eT2 -> symH (FC.rdS-eq n W1 T0 (compH W1 J' I uh f1, DO.rCh W1 J' I f1 uh x n rzh c') (compH W1 J I u hf, Q.cT W1 hf T0 eT2) (SP eT2)
                    (PB.lands-pre W1 J' I uh s.pQ f1 lb) (PB.lands-pre W1 J I u s.pQ hf la)
                    (Wt.Res[n, W1, J', f1, i'].res) (Wt.Res[n, W1, J, hf, i].res) (LA.L1.resres n W1 J' J h f1 i)))
      y e' eT ;
   } ;
   coh : Id (Py.Side[Y', Q'.gp])
          (subst (W0.Ix (G.ob J' rzh)) (\ p -> Py.Side[Y', p]) (UG.act Y' Q.Y hh Q.gp) Q'.gp gnat (Py.rside Y' Q.Y hh Q.gp Q.side))
          Q'.side =
    Py.side-extH Y' (UG.act Y' Q.Y hh Q.gp) Q'.gp gnat (Py.rside Y' Q.Y hh Q.gp Q.side) Q'.side
     (PB.pre-comp J' J I h u s.pQ)
     (\ W f lw lw' -> EV[W.1, f.1, G0.GB.lands-pre W Y' Q.Y hh Q.Q f lw, lw'].evg W.2 (symH f.2) (symH (G0.GB.BC.oC W Y' Q.Y hh f).2)) ;
  } ;
 } ;
} ;
