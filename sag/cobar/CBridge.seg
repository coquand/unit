-- CBridge.seg (canonicity-45; SIMPLIFIED.md step 6): from a closed algebra
-- map to a morphism of C at every stage.  For s, t presentations and a
-- closed function Phi : Fun Q_s Q_t over the terminal context:
--   phi K u      Phi's fibre family at the identity of K (the value at u)
--   sgE X        the substitution (u1, u2, v, ..) |-> (phi u1, phi u2, phi v)
--                from nil.Q_s^3.X to nil.Q_t^3 (semantic, natural by Phi's
--                naturality); sg1 the same for one variable
--   Bridge[dA, dM, dC].mor J : a morphism A_s -> A_t at the stage J, from
--                Hoefer data given internally as elements dA over the
--                hypothesis context nil.Q_s^3.(u1 + u2 = v) of the Id type
--                (phi u1 + phi u2 = phi v) along sgE (and dM, dC r alike);
--                their fibres are the Id fibres at the image points, moved
--                along Phi's naturality to the slice of J
--   mor-nat      restricting mor J along v : K -> J gives mor K
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Sig (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (addO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (mulO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (s t : SX.Over[R].Presentation)
 (Phi : C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, s, pe].Qt CAlgX[a].AlgX[R, encK, t, pe].Qt)) {
 module MO = CMorX[a].MorOf[R, encK, pe, addO, mulO] ;
 module F = MO.Fn[s, t] ;
 module S = F.S ;
 module T = F.T ;
 -- points of the terminal context
 NO (K : Ob) : U a+ = V1.Ix (C.nil.ob K) ;
 SQ (K : Ob) (o : NO K) : U a+ = V1.Ix (S.Qt.1.tob K o) ;
 TQ (K : Ob) (o : NO K) : U a+ = V1.Ix (T.Qt.1.tob K o) ;
 phiG (K : Ob) (o : NO K) (u : SQ K o) : TQ K o = (Phi.eob K o).1 K (idH K) u ;
 phi (K : Ob) (u : S.QK K) : T.QK K = phiG K tt u ;
 -- the family at J along f is phi at K (Phi's naturality)
 eqphiG (J K : Ob) (f : Hom K J) (o : NO J) (u : SQ K o) : Id (TQ K o) (phiG K o u) ((Phi.eob J o).1 K f u) =
  transH (apH {V1.Ix ((OV.Fun C.nil S.Qt T.Qt).1.tob K o)} {TQ K o} (\ m -> m.1 K (idH K) u) (symH (Phi.enat K J f o o (refl o))))
   (apH {Hom K J} {TQ K o} (\ h -> (Phi.eob J o).1 K h u) (comp-idr K J f)) ;
 eqphi (J K : Ob) (f : Hom K J) (u : S.QK K) : Id (T.QK K) (phi K u) ((Phi.eob J tt).1 K f u) = eqphiG J K f tt u ;
 rsS (K L0 : Ob) (g : Hom L0 K) (o : NO K) (u : SQ K o) : SQ L0 o = S.Qt.1.tact L0 K g o o (refl o) u ;
 rsT (K L0 : Ob) (g : Hom L0 K) (o : NO K) (u : TQ K o) : TQ L0 o = T.Qt.1.tact L0 K g o o (refl o) u ;
 phiG-nat (K L0 : Ob) (g : Hom L0 K) (o : NO K) (u : SQ K o) : Id (TQ L0 o) (phiG L0 o (rsS K L0 g o u)) (rsT K L0 g o (phiG K o u)) =
  transH (eqphiG K L0 g o (rsS K L0 g o u))
   (transH (apH {Hom L0 K} {TQ L0 o} (\ h -> (Phi.eob K o).1 L0 h (rsS K L0 g o u)) (symH (comp-idl L0 K g)))
     (symH ((Phi.eob K o).2 K L0 (idH K) g u))) ;
 phi-nat (K L0 : Ob) (g : Hom L0 K) (u : S.QK K) : Id (T.QK L0) (phi L0 (S.rs K L0 g u)) (T.rs K L0 g (phi K u)) = phiG-nat K L0 g tt u ;
 p3 (K : Ob) (w : S.T3 K) : T.T3 K = (phi K w.1, (phi K w.2.1, phi K w.2.2)) ;
 -- the substitutions applying phi componentwise
 sgnt (X : C.Ty S.G3) (K : Ob) (x : V1.Ix ((C.ext S.G3 X).ob K)) : V1.Ix (T.G3.ob K) =
  (((x.1.1.1.1, phiG K x.1.1.1.1 x.1.1.1.2), phiG K x.1.1.1.1 x.1.1.2), phiG K x.1.1.1.1 x.1.2) ;
 sgnat (X : C.Ty S.G3) (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix ((C.ext S.G3 X).ob K))
  : Id (V1.Ix (T.G3.ob L0)) (sgnt X L0 ((C.ext S.G3 X).act L0 K g x)) (T.G3.act L0 K g (sgnt X K x)) =
  transH (apH {TQ L0 x.1.1.1.1} {V1.Ix (T.G3.ob L0)} (\ z -> (((x.1.1.1.1, z), phiG L0 x.1.1.1.1 (rsS K L0 g x.1.1.1.1 x.1.1.2)), phiG L0 x.1.1.1.1 (rsS K L0 g x.1.1.1.1 x.1.2))) (phiG-nat K L0 g x.1.1.1.1 x.1.1.1.2))
   (transH (apH {TQ L0 x.1.1.1.1} {V1.Ix (T.G3.ob L0)} (\ z -> (((x.1.1.1.1, rsT K L0 g x.1.1.1.1 (phiG K x.1.1.1.1 x.1.1.1.2)), z), phiG L0 x.1.1.1.1 (rsS K L0 g x.1.1.1.1 x.1.2))) (phiG-nat K L0 g x.1.1.1.1 x.1.1.2))
     (apH {TQ L0 x.1.1.1.1} {V1.Ix (T.G3.ob L0)} (\ z -> (((x.1.1.1.1, rsT K L0 g x.1.1.1.1 (phiG K x.1.1.1.1 x.1.1.1.2)), rsT K L0 g x.1.1.1.1 (phiG K x.1.1.1.1 x.1.1.2)), z)) (phiG-nat K L0 g x.1.1.1.1 x.1.2))) ;
 sgE (X : C.Ty S.G3) : C.Sub (C.ext S.G3 X) T.G3 = new L.PSub[C.ext S.G3 X, T.G3, sgnt X, sgnat X] ;
 sg1nt (X : C.Ty S.G1) (K : Ob) (x : V1.Ix ((C.ext S.G1 X).ob K)) : V1.Ix (T.G1.ob K) = (x.1.1, phiG K x.1.1 x.1.2) ;
 sg1nat (X : C.Ty S.G1) (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix ((C.ext S.G1 X).ob K))
  : Id (V1.Ix (T.G1.ob L0)) (sg1nt X L0 ((C.ext S.G1 X).act L0 K g x)) (T.G1.act L0 K g (sg1nt X K x)) =
  apH {TQ L0 x.1.1} {V1.Ix (T.G1.ob L0)} (\ z -> (x.1.1, z)) (phiG-nat K L0 g x.1.1 x.1.2) ;
 sg1 (X : C.Ty S.G1) : C.Sub (C.ext S.G1 X) T.G1 = new L.PSub[C.ext S.G1 X, T.G1, sg1nt X, sg1nat X] ;
} ;

module Bridge (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
 (addO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (mulO : (x : SX.Over[R].Presentation) -> C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt (OV.Fun C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt)))
 (s t : SX.Over[R].Presentation)
 (Phi : C.El C.nil (OV.Fun C.nil CAlgX[a].AlgX[R, encK, s, pe].Qt CAlgX[a].AlgX[R, encK, t, pe].Qt))
 (dA : C.El (C.ext CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].G3 CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdA) (C.subT (C.ext CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].G3 CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdA) CMorX[a].MorOf[R, encK, pe, addO, mulO].At[t].G3 CMorX[a].MorOf[R, encK, pe, addO, mulO].At[t].IdA (Sig[R, encK, pe, addO, mulO, s, t, Phi].sgE CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdA)))
 (dM : C.El (C.ext CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].G3 CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdM) (C.subT (C.ext CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].G3 CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdM) CMorX[a].MorOf[R, encK, pe, addO, mulO].At[t].G3 CMorX[a].MorOf[R, encK, pe, addO, mulO].At[t].IdM (Sig[R, encK, pe, addO, mulO, s, t, Phi].sgE CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdM)))
 (dC : (c : R.R) -> C.El (C.ext CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].G1 (CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdC c)) (C.subT (C.ext CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].G1 (CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdC c)) CMorX[a].MorOf[R, encK, pe, addO, mulO].At[t].G1 (CMorX[a].MorOf[R, encK, pe, addO, mulO].At[t].IdC c) (Sig[R, encK, pe, addO, mulO, s, t, Phi].sg1 (CMorX[a].MorOf[R, encK, pe, addO, mulO].At[s].IdC c)))) {
 module SG = Sig[R, encK, pe, addO, mulO, s, t, Phi] ;
 module F = SG.F ;
 module S = SG.S ;
 module T = SG.T ;
 FT3 (IT : C.Ty T.G3) (K : Ob) (z : T.T3 K) : U a++ = V1.Ix (IT.1.tob K (T.mk3 K z)) ;
 FT1 (IT : C.Ty T.G1) (K : Ob) (z : T.QK K) : U a++ = V1.Ix (IT.1.tob K (T.mk1 K z)) ;
 -- the action commutes with moving the points
 TS3 (IT : C.Ty T.G3) (K L0 : Ob) (g : Hom L0 K) (z z' : T.T3 K) (EK : Id (T.T3 K) z z') (y y' : T.T3 L0) (EL : Id (T.T3 L0) y y')
  (e1 : Id (V1.Ix (T.G3.ob L0)) (T.G3.act L0 K g (T.mk3 K z)) (T.mk3 L0 y)) (e2 : Id (V1.Ix (T.G3.ob L0)) (T.G3.act L0 K g (T.mk3 K z')) (T.mk3 L0 y')) (x0 : FT3 IT K z)
  : Id (FT3 IT L0 y') (subst (T.T3 L0) (FT3 IT L0) y y' EL (IT.1.tact L0 K g (T.mk3 K z) (T.mk3 L0 y) e1 x0))
       (IT.1.tact L0 K g (T.mk3 K z') (T.mk3 L0 y') e2 (subst (T.T3 K) (FT3 IT K) z z' EK x0)) =
  idJ (T.T3 K) z (\ z2 E2 -> (e3 : Id (V1.Ix (T.G3.ob L0)) (T.G3.act L0 K g (T.mk3 K z2)) (T.mk3 L0 y'))
      -> Id (FT3 IT L0 y') (subst (T.T3 L0) (FT3 IT L0) y y' EL (IT.1.tact L0 K g (T.mk3 K z) (T.mk3 L0 y) e1 x0))
            (IT.1.tact L0 K g (T.mk3 K z2) (T.mk3 L0 y') e3 (subst (T.T3 K) (FT3 IT K) z z2 E2 x0)))
   (\ e3 -> idJ (T.T3 L0) y (\ y2 F2 -> (e4 : Id (V1.Ix (T.G3.ob L0)) (T.G3.act L0 K g (T.mk3 K z)) (T.mk3 L0 y2))
         -> Id (FT3 IT L0 y2) (subst (T.T3 L0) (FT3 IT L0) y y2 F2 (IT.1.tact L0 K g (T.mk3 K z) (T.mk3 L0 y) e1 x0))
               (IT.1.tact L0 K g (T.mk3 K z) (T.mk3 L0 y2) e4 x0))
       (\ e4 -> L.tact-irr T.G3 IT.1 L0 K g (T.mk3 K z) (T.mk3 L0 y) e1 e4 x0) y' EL e3)
   z' EK e2 ;
 TS1 (IT : C.Ty T.G1) (K L0 : Ob) (g : Hom L0 K) (z z' : T.QK K) (EK : Id (T.QK K) z z') (y y' : T.QK L0) (EL : Id (T.QK L0) y y')
  (e1 : Id (V1.Ix (T.G1.ob L0)) (T.G1.act L0 K g (T.mk1 K z)) (T.mk1 L0 y)) (e2 : Id (V1.Ix (T.G1.ob L0)) (T.G1.act L0 K g (T.mk1 K z')) (T.mk1 L0 y')) (x0 : FT1 IT K z)
  : Id (FT1 IT L0 y') (subst (T.QK L0) (FT1 IT L0) y y' EL (IT.1.tact L0 K g (T.mk1 K z) (T.mk1 L0 y) e1 x0))
       (IT.1.tact L0 K g (T.mk1 K z') (T.mk1 L0 y') e2 (subst (T.QK K) (FT1 IT K) z z' EK x0)) =
  idJ (T.QK K) z (\ z2 E2 -> (e3 : Id (V1.Ix (T.G1.ob L0)) (T.G1.act L0 K g (T.mk1 K z2)) (T.mk1 L0 y'))
      -> Id (FT1 IT L0 y') (subst (T.QK L0) (FT1 IT L0) y y' EL (IT.1.tact L0 K g (T.mk1 K z) (T.mk1 L0 y) e1 x0))
            (IT.1.tact L0 K g (T.mk1 K z2) (T.mk1 L0 y') e3 (subst (T.QK K) (FT1 IT K) z z2 E2 x0)))
   (\ e3 -> idJ (T.QK L0) y (\ y2 F2 -> (e4 : Id (V1.Ix (T.G1.ob L0)) (T.G1.act L0 K g (T.mk1 K z)) (T.mk1 L0 y2))
         -> Id (FT1 IT L0 y2) (subst (T.QK L0) (FT1 IT L0) y y2 F2 (IT.1.tact L0 K g (T.mk1 K z) (T.mk1 L0 y) e1 x0))
               (IT.1.tact L0 K g (T.mk1 K z) (T.mk1 L0 y2) e4 x0))
       (\ e4 -> L.tact-irr T.G1 IT.1 L0 K g (T.mk1 K z) (T.mk1 L0 y) e1 e4 x0) y' EL e3)
   z' EK e2 ;

 -- the data for a family psi equal to phi pointwise
 module DD (J : Ob) (psi : F.Fam J) (H : (K : Ob) (f : Hom K J) (u : S.QK K) -> Id (T.QK K) (SG.phi K u) (psi K f u)) {
  H3 (K : Ob) (f : Hom K J) (w : S.T3 K) : Id (T.T3 K) (SG.p3 K w) (F.mp3 J psi K f w) =
   F.ap3 K (SG.p3 K w) (F.mp3 J psi K f w) (H K f w.1) (H K f w.2.1) (H K f w.2.2) ;
  module B2 (IS : C.Ty S.G3) (IT : C.Ty T.G3) (d0 : C.El (C.ext S.G3 IS) (C.subT (C.ext S.G3 IS) T.G3 IT (SG.sgE IS))) {
   module BB = F.Bin[IS, IT] ;
   x0 (K : Ob) (w : S.T3 K) (p : V1.Ix (BB.FS K w)) : FT3 IT K (SG.p3 K w) = d0.eob K (S.mk3 K w, p) ;
   dd : BB.DT J psi = \ K f w p -> subst (T.T3 K) (FT3 IT K) (SG.p3 K w) (F.mp3 J psi K f w) (H3 K f w) (x0 K w p) ;
   dn : BB.DN J psi dd = \ K L0 f g w e p ->
    transH (symH (TS3 IT K L0 g (SG.p3 K w) (F.mp3 J psi K f w) (H3 K f w) (SG.p3 L0 (S.rs3 K L0 g w)) (F.mp3 J psi L0 (compH L0 K J f g) (S.rs3 K L0 g w))
                     (H3 L0 (compH L0 K J f g) (S.rs3 K L0 g w))
                     (L.ntEq (C.ext S.G3 IS) T.G3 (SG.sgE IS) L0 K g (S.mk3 K w, p) (S.mk3 L0 (S.rs3 K L0 g w), BB.acS K L0 g w p) (refl (S.mk3 L0 (S.rs3 K L0 g w), BB.acS K L0 g w p)))
                     e (x0 K w p)))
     (apH {FT3 IT L0 (SG.p3 L0 (S.rs3 K L0 g w))} {FT3 IT L0 (F.mp3 J psi L0 (compH L0 K J f g) (S.rs3 K L0 g w))}
        (\ r -> subst (T.T3 L0) (FT3 IT L0) (SG.p3 L0 (S.rs3 K L0 g w)) (F.mp3 J psi L0 (compH L0 K J f g) (S.rs3 K L0 g w)) (H3 L0 (compH L0 K J f g) (S.rs3 K L0 g w)) r)
        (d0.enat L0 K g (S.mk3 K w, p) (S.mk3 L0 (S.rs3 K L0 g w), BB.acS K L0 g w p) (refl (S.mk3 L0 (S.rs3 K L0 g w), BB.acS K L0 g w p)))) ;
  } ;
  module B1 (IS : C.Ty S.G1) (IT : C.Ty T.G1) (d0 : C.El (C.ext S.G1 IS) (C.subT (C.ext S.G1 IS) T.G1 IT (SG.sg1 IS))) {
   module BB = F.Nul[IS, IT] ;
   x0 (K : Ob) (u : S.QK K) (p : V1.Ix (BB.FS K u)) : FT1 IT K (SG.phi K u) = d0.eob K (S.mk1 K u, p) ;
   dd : BB.DT J psi = \ K f u p -> subst (T.QK K) (FT1 IT K) (SG.phi K u) (psi K f u) (H K f u) (x0 K u p) ;
   dn : BB.DN J psi dd = \ K L0 f g u e p ->
    transH (symH (TS1 IT K L0 g (SG.phi K u) (psi K f u) (H K f u) (SG.phi L0 (S.rs K L0 g u)) (psi L0 (compH L0 K J f g) (S.rs K L0 g u))
                     (H L0 (compH L0 K J f g) (S.rs K L0 g u))
                     (L.ntEq (C.ext S.G1 IS) T.G1 (SG.sg1 IS) L0 K g (S.mk1 K u, p) (S.mk1 L0 (S.rs K L0 g u), BB.acS K L0 g u p) (refl (S.mk1 L0 (S.rs K L0 g u), BB.acS K L0 g u p)))
                     e (x0 K u p)))
     (apH {FT1 IT L0 (SG.phi L0 (S.rs K L0 g u))} {FT1 IT L0 (psi L0 (compH L0 K J f g) (S.rs K L0 g u))}
        (\ r -> subst (T.QK L0) (FT1 IT L0) (SG.phi L0 (S.rs K L0 g u)) (psi L0 (compH L0 K J f g) (S.rs K L0 g u)) (H L0 (compH L0 K J f g) (S.rs K L0 g u)) r)
        (d0.enat L0 K g (S.mk1 K u, p) (S.mk1 L0 (S.rs K L0 g u), BB.acS K L0 g u p) (refl (S.mk1 L0 (S.rs K L0 g u), BB.acS K L0 g u p)))) ;
  } ;
  module DA2 = B2[S.IdA, T.IdA, dA] ;
  module DM2 = B2[S.IdM, T.IdM, dM] ;
  module DC1 (c : R.R) { module N = B1[S.IdC c, T.IdC c, dC c] ; } ;
  fp : F.FP J = (psi, (DA2.dd, (DM2.dd, \ c -> DC1[c].N.dd))) ;
  rest (nt : F.Nat J psi) : F.M J = F.mkM J psi nt ((DA2.dd, DA2.dn), ((DM2.dd, DM2.dn), \ c -> (DC1[c].N.dd, DC1[c].N.dn))) ;
 } ;

 -- the morphism at every stage, and its naturality
 mor (J : Ob) : F.M J = DD[J, (Phi.eob J tt).1, SG.eqphi J].rest (Phi.eob J tt).2 ;
 HT (K : Ob) (psi : F.Fam K) : U a++ = (K' : Ob) (f : Hom K' K) (u : S.QK K') -> Id (T.QK K') (SG.phi K' u) (psi K' f u) ;
 HP (K : Ob) (psi : F.Fam K) : isProp (HT K psi) =
  isProp-Pi Ob (\ K' -> (f : Hom K' K) (u : S.QK K') -> Id (T.QK K') (SG.phi K' u) (psi K' f u)) (\ K' ->
  isProp-Pi (Hom K' K) (\ f -> (u : S.QK K') -> Id (T.QK K') (SG.phi K' u) (psi K' f u)) (\ f ->
  isProp-Pi (S.QK K') (\ u -> Id (T.QK K') (SG.phi K' u) (psi K' f u)) (\ u ->
  V1.isSetIx (T.QV K') (SG.phi K' u) (psi K' f u)))) ;
 FPeq (K : Ob) (psi psi' : F.Fam K) (P : Id (F.Fam K) psi psi') (H : HT K psi) (H' : HT K psi')
  : Id (F.FP K) (DD[K, psi, H].fp) (DD[K, psi', H'].fp) =
  idJ (F.Fam K) psi (\ psi2 P2 -> (H2 : HT K psi2) -> Id (F.FP K) (DD[K, psi, H].fp) (DD[K, psi2, H2].fp))
   (\ H2 -> apH {HT K psi} {F.FP K} (\ Hx -> DD[K, psi, Hx].fp) (HP K psi H H2)) psi' P H' ;
 mor-nat (J K : Ob) (v : Hom K J) : Id (F.M K) (F.res J K v (mor J)) (mor K) =
  F.mExt K (F.res J K v (mor J)) (mor K)
   (FPeq K (F.resF J K v (Phi.eob J tt).1) (Phi.eob K tt).1
      (apH {V1.Ix (F.PF K)} {F.Fam K} (\ m -> m.1) (Phi.enat K J v tt tt (refl tt)))
      (\ K' f' u -> SG.eqphi J K' (compH K' K J v f') u) (SG.eqphi K)) ;
} ;
