-- CQCtx.seg (canonicity-45; SIMPLIFIED.md step 6): the contexts nil.Q^n of
-- a closed type Q, the semantic section at three global elements, the
-- shapes of the quotient's ElimP3 and closed set-ness (agreed with c2 for
-- CwFQuotElim1.QE1), and the Id types of the binary operations (CSemOp's
-- terms).  CMorX's per-algebra contexts and Id types are these, so that
-- later files compare them by name, not by unfolding through the quotient.
-- No new axioms.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

-- the contexts nil.Q^n of a closed type, a semantic section at three
-- global elements, and the shapes of the quotient's ElimP3 and closed
-- set-ness (agreed with c2 for CwFQuotElim1.QE1)
module G3Of (Qt : C.Ty C.nil) {
 Nl : C.Ctx = C.nil ;
 G1 : C.Ctx = C.ext Nl Qt ;
 Qw : C.Ty G1 = OV.wkT Nl Qt Qt ;
 G2 : C.Ctx = C.ext G1 Qw ;
 Qw2 : C.Ty G2 = OV.wkT G1 Qw Qw ;
 G3 : C.Ctx = C.ext G2 Qw2 ;
 Qw3 : C.Ty G3 = OV.wkT G2 Qw2 Qw2 ;
 module Sec3 (q1 q2 q3 : C.El Nl Qt) {
  nt (K : Ob) (o : V1.Ix (Nl.ob K)) : V1.Ix (G3.ob K) = (((o, q1.eob K o), q2.eob K o), q3.eob K o) ;
  nat (L0 K : Ob) (g : Hom L0 K) (o : V1.Ix (Nl.ob K)) : Id (V1.Ix (G3.ob L0)) (nt L0 (Nl.act L0 K g o)) (G3.act L0 K g (nt K o)) =
   transH (apH {V1.Ix (Qt.1.tob L0 o)} {V1.Ix (G3.ob L0)} (\ z -> (((o, z), q2.eob L0 o), q3.eob L0 o)) (symH (q1.enat L0 K g o o (refl o))))
    (transH (apH {V1.Ix (Qt.1.tob L0 o)} {V1.Ix (G3.ob L0)} (\ z -> (((o, Qt.1.tact L0 K g o o (refl o) (q1.eob K o)), z), q3.eob L0 o)) (symH (q2.enat L0 K g o o (refl o))))
      (apH {V1.Ix (Qt.1.tob L0 o)} {V1.Ix (G3.ob L0)} (\ z -> (((o, Qt.1.tact L0 K g o o (refl o) (q1.eob K o)), Qt.1.tact L0 K g o o (refl o) (q2.eob K o)), z)) (symH (q3.enat L0 K g o o (refl o))))) ;
  sec3 : C.Sub Nl G3 = new L.PSub[Nl, G3, nt, nat] ;
 } ;
 ElimP3Ty (Term : U a) (cls : Term -> C.El Nl Qt) : U a++ =
  (P : C.Ty G3) (pPr : C.El G3 (PU.isProp G3 P))
  (h : (t1 t2 t3 : Term) -> C.El Nl (C.subT Nl G3 P (Sec3[cls t1, cls t2, cls t3].sec3))) -> C.El G3 P ;
 -- the two variables of nil.Q.Q and Q's set-ness, closed and over them
 v1 : C.El G2 Qw2 = OV.wkE G1 Qw Qw (C.q Nl Qt) ;
 v2 : C.El G2 Qw2 = C.q G1 Qw ;
 SP : C.Ty G2 = PU.isProp G2 (IJ.IdT G2 Qw2 v1 v2) ;
 SetQiTy : U a++ = C.El Nl (FibCwF[a, a+].fibPi.Pi Nl Qt (FibCwF[a, a+].fibPi.Pi G1 Qw SP)) ;
 setV2 (sq : SetQiTy) : C.El G2 SP = OV.bod G1 Qw SP (OV.bod Nl Qt (FibCwF[a, a+].fibPi.Pi G1 Qw SP) sq) ;
 -- the two-variable term of an operation and its Id type over nil.Q^3
 module OpTy (op : C.El Nl (OV.Fun Nl Qt (OV.Fun Nl Qt Qt))) {
  o12 : C.El G2 Qw2 = CSemOp[a].SemOp[Qt, op].o12s ;
  o12w : C.El G3 Qw3 = OV.wkE G2 Qw2 Qw2 o12 ;
  IdOp : C.Ty G3 = IJ.IdT G3 Qw3 o12w (C.q G2 Qw2) ;
 } ;
 -- one variable: the section at a global element, ElimP1, and the Id type
 -- of a constant c (c = v over nil.Q)
 module Sec1 (q1 : C.El Nl Qt) {
  nt (K : Ob) (o : V1.Ix (Nl.ob K)) : V1.Ix (G1.ob K) = (o, q1.eob K o) ;
  nat (L0 K : Ob) (g : Hom L0 K) (o : V1.Ix (Nl.ob K)) : Id (V1.Ix (G1.ob L0)) (nt L0 (Nl.act L0 K g o)) (G1.act L0 K g (nt K o)) =
   apH {V1.Ix (Qt.1.tob L0 o)} {V1.Ix (G1.ob L0)} (\ z -> (o, z)) (symH (q1.enat L0 K g o o (refl o))) ;
  sec1 : C.Sub Nl G1 = new L.PSub[Nl, G1, nt, nat] ;
 } ;
 ElimP1Ty (Term : U a) (cls : Term -> C.El Nl Qt) : U a++ =
  (P : C.Ty G1) (pPr : C.El G1 (PU.isProp G1 P)) (h : (t1 : Term) -> C.El Nl (C.subT Nl G1 P (Sec1[cls t1].sec1))) -> C.El G1 P ;
 module CTy (c : C.El Nl Qt) {
  cw : C.El G1 Qw = OV.wkE Nl Qt Qt c ;
  IdCst : C.Ty G1 = IJ.IdT G1 Qw cw (C.q Nl Qt) ;
 } ;
} ;
