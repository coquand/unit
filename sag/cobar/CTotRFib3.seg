-- CTotRFib3.seg (canonicity-c2; SIMPLIFIED.md item 5): R of a levelwise
-- fibration is a fibration, by transferring the composition structure
-- Comp e e' componentwise (as CTotR.L9 for contractions).  Here: the
-- projected side.  A partial line of R B at a stage X of the total site
-- (a side of the strict fibre of ev e over the context of lines with an
-- end element) gives, at each (Y , m : F Y -> X), a partial line of B at
-- Y in the levelwise site, by the map toTS of CTotRFib2.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RFib3 (C : CIntCat[a, vl].IC) {
 module R2 = CTotRFib2[a, vl, l].RFib2[C] ;
 module RF = R2.RF ;
 module TR = RF.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U vl = RN.Ob0 ;
 Ob1 : U vl = RN.Ob1 ;

 module Pr (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (e : G1.GB.IPt) {
  module TO = R2.To[G, B, e] ;
  module CT = TO.CT ;
  module L9 = TO.L9 ;
  module EK1 = CT.EK1 ;
  module EK0 = CT.EK0 ;
  K1 : P1.PCtx = EK1.TV.E ;
  K0 : P0.PCtx = EK0.TV.E ;
  -- the point of the levelwise context under (Y , m)
  zc (X : Ob1) (z : EK1.TV.EI X) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) : EK0.TV.EI Y = CT.kap Y (K1.act (RN.o Y) X m z) ;
  module PS (X : Ob1) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) (Y : Ob0) (m : RN.Hom1 (RN.o Y) X) {
   Q : G0.GB.Phi Y = G1.GB.pre (RN.o Y) X m s.pQ ;
   pv (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.Lands Z Y Q h) : EK0.TS.EI Z = TO.toTS Z (s.pv (RN.o Z) (L9.mh X Y m Z h) i) ;
   module PP (Z : Ob0) (h : RN.Hom0 Z Y) (i : G0.GB.Lands Z Y Q h) {
    u : EK1.TS.EI (RN.o Z) = s.pv (RN.o Z) (L9.mh X Y m Z h) i ;
    module SZ = TO.TS[Z, u] ;
    a1 : Id (EK0.TV.EI Z) (EK0.TS.pr1 Z (pv Z h i)) (CT.kap Z (EK1.TS.pr1 (RN.o Z) u)) =
     EK0.mkTS-pt Z (CT.kap Z SZ.z) SZ.L0 (refl (CT.RH.rhoV Z SZ.x)) SZ.q ;
    a2 : Id (EK1.TV.EI (RN.o Z)) (EK1.TS.pr1 (RN.o Z) u) (K1.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (K1.act (RN.o Y) X m z)) =
     trans (EK1.TV.EI (RN.o Z)) (EK1.TS.pr1 (RN.o Z) u) (K1.act (RN.o Z) X (L9.mh X Y m Z h) z)
       (K1.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (K1.act (RN.o Y) X m z))
      (s.ppt (RN.o Z) (L9.mh X Y m Z h) i)
      (K1.act-o (RN.o Z) (RN.o Y) X m (TR.fn.onH Z Y h) z) ;
    ppt : Id (EK0.TV.EI Z) (EK0.TS.pr1 Z (pv Z h i)) (K0.act Z Y h (zc X z Y m)) =
     trans (EK0.TV.EI Z) (EK0.TS.pr1 Z (pv Z h i)) (CT.kap Z (EK1.TS.pr1 (RN.o Z) u)) (K0.act Z Y h (zc X z Y m))
      a1
      (trans (EK0.TV.EI Z) (CT.kap Z (EK1.TS.pr1 (RN.o Z) u)) (CT.kap Z (K1.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (K1.act (RN.o Y) X m z)))
         (K0.act Z Y h (zc X z Y m))
         (ap (EK1.TV.EI (RN.o Z)) (EK0.TV.EI Z) (CT.kap Z) (EK1.TS.pr1 (RN.o Z) u)
            (K1.act (RN.o Z) (RN.o Y) (TR.fn.onH Z Y h) (K1.act (RN.o Y) X m z)) a2)
         CT.KN[Z, Y, h, K1.act (RN.o Y) X m z].nat) ;
   } ;
   module PN (Z' Z : Ob0) (chi : RN.Hom0 Z' Z) (h : RN.Hom0 Z Y) (i : G0.GB.Lands Z Y Q h)
     (i' : G0.GB.Lands Z' Y Q (G0.GB.BC.oC Z' Z Y h chi)) {
    Fc : RN.Hom1 (RN.o Z') (RN.o Z) = TR.fn.onH Z' Z chi ;
    k2 : RN.Hom1 (RN.o Z') X = G1.GB.BC.oC (RN.o Z') (RN.o Z) X (L9.mh X Y m Z h) Fc ;
    k3 : RN.Hom1 (RN.o Z') X = L9.mh X Y m Z' (G0.GB.BC.oC Z' Z Y h chi) ;
    u0 : EK1.TS.EI (RN.o Z) = s.pv (RN.o Z) (L9.mh X Y m Z h) i ;
    i2 : G1.GB.Lands (RN.o Z') X s.pQ k2 = G1.GB.lands-eq (RN.o Z') X s.pQ k3 k2 (symH (L9.mhc X Y m Z' Z chi h)) i' ;
    u2 : EK1.TS.EI (RN.o Z') = s.pv (RN.o Z') k2 i2 ;
    u3 : EK1.TS.EI (RN.o Z') = s.pv (RN.o Z') k3 i' ;
    q1 : Id (EK1.TS.EI (RN.o Z')) (EK1.TS.E.act (RN.o Z') (RN.o Z) Fc u0) u2 = s.pnat (RN.o Z') (RN.o Z) Fc (L9.mh X Y m Z h) i i2 ;
    q2 : Id (EK1.TS.EI (RN.o Z')) u2 u3 = EK1.PT.pv-hom X z s (RN.o Z') k2 k3 (L9.mhc X Y m Z' Z chi h) i2 i' ;
    pnat : Id (EK0.TS.EI Z') (EK0.TS.E.act Z' Z chi (pv Z h i)) (pv Z' (G0.GB.BC.oC Z' Z Y h chi) i') =
     trans (EK0.TS.EI Z') (EK0.TS.E.act Z' Z chi (pv Z h i)) (TO.toTS Z' (EK1.TS.E.act (RN.o Z') (RN.o Z) Fc u0)) (TO.toTS Z' u3)
      (sym (EK0.TS.EI Z') (TO.toTS Z' (EK1.TS.E.act (RN.o Z') (RN.o Z) Fc u0)) (EK0.TS.E.act Z' Z chi (pv Z h i)) TO.TSN[Z', Z, chi, u0].nat)
      (ap (EK1.TS.EI (RN.o Z')) (EK0.TS.EI Z') (TO.toTS Z') (EK1.TS.E.act (RN.o Z') (RN.o Z) Fc u0) u3
         (trans (EK1.TS.EI (RN.o Z')) (EK1.TS.E.act (RN.o Z') (RN.o Z) Fc u0) u2 u3 q1 q2)) ;
   } ;
   side : EK0.PT.Side[Y, zc X z Y m] =
    EK0.PT.mkSide Y (zc X z Y m) Q pv (\ Z h i -> PP[Z, h, i].ppt) (\ Z' Z chi h i i' -> PN[Z', Z, chi, h, i, i'].pnat) ;
  } ;
 } ;
} ;
