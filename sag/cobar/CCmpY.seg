-- CCmpY.seg (canonicity-45; SIMPLIFIED.md step 6): the comparison
-- yo F2 -> yo F1 x yo F1 as a map of types over the terminal context of the
-- total site (cmpF, through c2's CtxTy and TotOf.toPS), its levelwise
-- triple (Prop 13's input, CTotP13d), and the triple restricted to the copy
-- of a presentation y: its fibres are CMorX's map codes on the nose and
-- its action is CMorX's restriction up to mExt on equal families (resEq).
-- No new axioms beyond the named premises (fe).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module CmpBase (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module CC = CCopy[a].ConcC[R, encK, pe] ;
 module CM = CC.CM ;
 module TR = CC.TR ;
 module CT = CTotCtxTy[a, a+, a+].CtxTy[CM.IC] ;
 module FR = CSubst[a].Free[R] ;
 module O2 = CT.Of[CM.Yo[FR.F2].yoT] ;
 Y11 : CM.TP.TCtx = CM.PD.prodT CM.Yo[FR.F1].yoT CM.Yo[FR.F1].yoT ;
 module O11 = CT.Of[Y11] ;
 cS : TR.P1.PSub[CT.TC.toP CM.Yo[FR.F2].yoT, CT.TC.toP Y11] = CT.TC.toPS CM.Yo[FR.F2].yoT Y11 CM.cmpS ;
 cmpF : TR.G1.GB.CPartial[a+].PMap[CT.P1, O2.Y1T, O11.Y1T] =
  TR.G1.GB.CPartial[a+].mkPMap CT.P1 O2.Y1T O11.Y1T (\ X w -> (w.1, cS.nt X w.2)) (\ X w -> refl w.1)
   (\ Z X h w -> apH {V1.Ix ((CT.TC.toP Y11).ob Z)} {V1.Ix ((TR.P1.extP CT.P1 O11.Y1T).ob Z)} (\ g -> ((CT.P1.act Z X h w.1), g)) (cS.nt-nat Z X h w.2)) ;
 GP : TR.P1.PCtx = CT.P1 ;
 UG : TR.P0.PCtx = TR.RS.rC GP ;
 UA2 : TR.P0.PTy[UG] = TR.RS.rT GP O2.Y1T ;
 module PD = CTotP13d[a, a+, a+].P13d[CM.IC, CT.T1, O2.Y1T, O11.Y1T, cmpF] ;
} ;

module CmpY (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) {
 module BS = CmpBase[R, encK, pe] ;
 module CC = BS.CC ;
 module CM = BS.CM ;
 module TR = BS.TR ;
 module CT = BS.CT ;
 module FR = BS.FR ;
 module O2 = BS.O2 ;
 module O11 = BS.O11 ;
 module PD = BS.PD ;
 GP : TR.P1.PCtx = BS.GP ;
 UG : TR.P0.PCtx = BS.UG ;
 UA2 : TR.P0.PTy[UG] = BS.UA2 ;
 module Cy = CC.Copy[y] ;
 module P = CHomT4[a].P3[R, encK, pe, FR.F2, y] ;
 probe1 (I : Ob) (o : V1.Ix ((Cy.rCy UG).ob I)) (m : V1.Ix ((Cy.rTy UG UA2).tob I o)) : P.F.M I = m ;
 resEq (J I : Ob) (u : Hom J I) (o : V1.Ix ((Cy.rCy UG).ob I)) (o' : V1.Ix ((Cy.rCy UG).ob J)) (e : Id (V1.Ix ((Cy.rCy UG).ob J)) ((Cy.rCy UG).act J I u o) o')
   (m : V1.Ix ((Cy.rTy UG UA2).tob I o)) : Id (P.F.M J) ((Cy.rTy UG UA2).tact J I u o o' e m) (P.F.res I J u m) =
  P.F.mExt J ((Cy.rTy UG UA2).tact J I u o o' e m) (P.F.res I J u m) (refl (P.F.fpOf J (P.F.res I J u m))) ;
 -- Prop 13's levelwise triple of the comparison, restricted to the copy y
 D : L.PCtx = Cy.rCy PD.UG ;
 B' : L.PTy[D] = Cy.rTy PD.UG PD.UA ;
 A' : L.PTy[D] = Cy.rTy PD.UG PD.UB ;
 al' : PB.CPartial[a+].PMap[D, B', A'] = Cy.rMy PD.UG PD.UA PD.UB PD.Uf ;
 module P1F = CHomT4[a].P3[R, encK, pe, FR.F1, y] ;
 fibB (I : Ob) (o : V1.Ix (D.ob I)) (m : V1.Ix (B'.tob I o)) : P.F.M I = m ;
 fibA (I : Ob) (o : V1.Ix (D.ob I)) (m : V1.Ix (A'.tob I o)) : P1F.F.M I * P1F.F.M I = m ;
 cmpPt (I : Ob) (w : V1.Ix ((L.extP D B').ob I)) : Id (P1F.F.M I * P1F.F.M I) (al'.mE I w).2 (CM.P1.pre I y w.2, CM.P2.pre I y w.2) = refl (al'.mE I w).2 ;
 resEqA (J I : Ob) (u : Hom J I) (o : V1.Ix (D.ob I)) (o' : V1.Ix (D.ob J)) (e : Id (V1.Ix (D.ob J)) (D.act J I u o) o')
   (mm : V1.Ix (A'.tob I o)) : Id (P1F.F.M J * P1F.F.M J) (A'.tact J I u o o' e mm) (P1F.F.res I J u mm.1, P1F.F.res I J u mm.2) =
  CM.PD.pairE2 (P1F.F.M J) (P1F.F.M J) (A'.tact J I u o o' e mm).1 (P1F.F.res I J u mm.1) (A'.tact J I u o o' e mm).2 (P1F.F.res I J u mm.2)
   (P1F.F.mExt J (A'.tact J I u o o' e mm).1 (P1F.F.res I J u mm.1) (refl (P1F.F.fpOf J (P1F.F.res I J u mm.1))))
   (P1F.F.mExt J (A'.tact J I u o o' e mm).2 (P1F.F.res I J u mm.2) (refl (P1F.F.fpOf J (P1F.F.res I J u mm.2)))) ;
} ;
