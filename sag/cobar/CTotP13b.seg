-- CTotP13b.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part b: the homotopy fibres.
--   H        the homotopy fibre of f : A -> B, a type over G.B (CEquiv.HFib)
--   G', Pt   the context G.B as a displayed context (TC.ofP) and H over it
--            (along the pointwise identity toP (ofP E) -> E), the input of
--            c2's Lemma 12 (trivial half): L12[al].k : a contraction of
--            D Pt over D G' from a levelwise one al
--   HD       the homotopy fibre of D f (CTotP13a): Prop 13 contracts it
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module P13b (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module DF = CTotP13a[a, vl, l].DFOf[C, G, A, B, f] ;
 module TC = DF.TC ;
 module P = DF.P ;
 module TR = DF.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 GP : P.PCtx = DF.GP ;
 module H = G1.GB.CEquiv[l].HFib[GP, A, B, f] ;
 E' : P.PCtx = P.extP GP B ;
 G' : CTPsh[a, vl, l].TPshOf[C].TCtx = TC.ofP E' ;
 iota : P.PSub[TC.toP G', E'] = new P.PSub[TC.toP G', E', \ X g -> g, \ Y X h g -> refl (E'.act Y X h g)] ;
 Pt : P.PTy[TC.toP G'] = P.subTy (TC.toP G') E' H.FibT iota ;
 module LZ = CTotL12n[a, vl, l].L12n[C, G', Pt] ;
 -- the homotopy fibre of D f
 module HD = G1.GB.CEquiv[l].HFib[DF.DG, DF.DA.DTy, DF.DB.DTy, DF.Df] ;
 -- Prop 13's conclusion
 Goal : U l+ = G1.GB.CEquiv[l].EquivOp DF.DG DF.DA.DTy DF.DB.DTy DF.Df ;
} ;
