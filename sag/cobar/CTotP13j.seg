-- CTotP13j.seg (canonicity-45; SIMPLIFIED.md step 4): Prop 13 at the total
-- site, part j: the naturality equation of the lift back's D B element
-- (anat), as c2's CTotPsi18: the path's naturality, u's naturality
-- equation (through fibL), D's index law natPath, ivA-comp.
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module P13j (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A B : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G])
  (f : CTotR[a, vl, l].TotR[C].G1.GB.CPartial[l].PMap[CTotCat[a, vl, l].TotOf[C].toP G, A, B]) {
 module PI = CTotP13i[a, vl, l].P13i[C, G, A, B, f] ;
 module PE = PI.PE ;
 module TR = PE.TR ;
 module G1 = TR.G1 ;
 module TC = PE.TC ;
 module DO = PE.DO ;
 module DF = PE.DF ;
 module H = PE.H ;
 module HD = PE.HD ;
 module DS = PI.DS ;
 Obj (I : Ob) : U vl = PE.Obj I ;

 module AN (X : TC.TOb) (w : HD.TA.EI X) (u : DS.TOb' X.1 X.2 (PE.PR.phi X w)) (Wd : TC.TOb) (g : TC.THm Wd X) (j : PB.IvP Wd.1) {
  module BK = PI.BKd[X, w, u] ;
  module AB = BK.AB[Wd, g, j] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module NT (r : VA.Ix (DF.D.natIdxV Wd.1 Wd.2)) (lq : DO.LandsI Wd.1 Wd.2 r.1) {
   q : DO.Idx Wd.1 Wd.2 = r.1 ;
   J : Ob = q.2.1 ;
   z : Obj J = q.2.2.2.1 ;
   J' : Ob = r.2.1 ;
   v : Hom J' J = r.2.2 ;
   rz : Obj J' = C.res J' J v z ;
   Y : TC.TOb = (J, z) ;
   Y' : TC.TOb = (J', rz) ;
   cv : TC.THm Y' Y = (v, C.cart J' J v z) ;
   R : Wt.Pn q.1 J' = Wt.Res[q.1, J', J, v, (q.2.2.2.2.2, lq)].res ;
   q' : DO.Idx Wd.1 Wd.2 = (q.1, J', compH J' J Wd.1 q.2.2.1 v, rz, DO.rCh J' J Wd.1 v q.2.2.1 Wd.2 q.1 z q.2.2.2.2.1, R.1) ;
   module R1 = AB.RQ[q, lq] ;
   module R2 = AB.RQ[q', R.2] ;
   lnq : W0.Ix (PE.FTg.FE.ob Y) = BK.lineE R1.qq lq ;
   j1 : PB.IvP J' = PB.ivA J' J v R1.RC.j0 ;
   rqq : DO.Idx I x = (q.1, J', compH J' J I R1.RC.U0 v, rz, DO.rCh J' J I v R1.RC.U0 x q.1 z R1.RC.cc, R.1) ;
   lineEs (sw : DF.D.S I x q.1 J' rz) : W0.Ix (PE.FTg.FE.ob Y') = BK.lineE (q.1, J', sw.1, rz, sw.2, R.1) R.2 ;
   s1 : Id (H.TA.EI Y') (DF.DB.E.act Y' Y cv (DF.DB.prz J z (AB.dd.1 q lq) (AB.bfam q lq))) (DF.DB.E.act Y' Y cv R1.te) =
    apH {H.TA.EI Y} {H.TA.EI Y'} (\ t -> DF.DB.E.act Y' Y cv t) R1.beq ;
   s2 : Id (H.TA.EI Y') (DF.DB.E.act Y' Y cv R1.te) (lnq.1 Y' cv j1) =
    transH (lnq.2 Y' Y cv (TC.tid Y) R1.RC.j0)
     (apH {TC.THm Y' Y} {H.TA.EI Y'} (\ k -> lnq.1 Y' k j1) (G1.GB.BC.oC-idl Y' Y cv)) ;
   uN : Id (H.TF.EI Y') (DS.anatL I x BK.pt u.1 (R1.qq, (J', v)) lq) (DS.anatR I x BK.pt u.1 (R1.qq, (J', v)) lq) = u.2.1 (R1.qq, (J', v)) lq ;
   s3 : Id (H.TA.EI Y') (lnq.1 Y' cv j1) ((BK.lineE rqq R.2).1 Y' (TC.tid Y') j1) =
    transH (apH {TC.THm Y' Y} {H.TA.EI Y'} (\ k -> lnq.1 Y' k j1) (symH (G1.GB.BC.oC-idr Y' Y cv)))
     (apH {H.TF.EI Y'} {H.TA.EI Y'} (\ T -> H.fibL Y' T Y' (TC.tid Y') j1) uN) ;
   s4 : Id (H.TA.EI Y') ((BK.lineE rqq R.2).1 Y' (TC.tid Y') j1) ((BK.lineE R2.qq R.2).1 Y' (TC.tid Y') j1) =
    apH {DF.D.S I x q.1 J' rz} {H.TA.EI Y'} (\ sw -> (lineEs sw).1 Y' (TC.tid Y') j1)
     (DF.D.Act[Wd.1, I, g.1, Wd.2, x, g.2, BK.d].natPath r lq) ;
   s5 : Id (H.TA.EI Y') ((BK.lineE R2.qq R.2).1 Y' (TC.tid Y') j1) R2.te =
    apH {PB.IvP J'} {H.TA.EI Y'} (\ jj -> (BK.lineE R2.qq R.2).1 Y' (TC.tid Y') jj) (PB.ivA-comp J' J Wd.1 q.2.2.1 v j) ;
   law : Id (H.TA.EI Y') (DF.DB.E.act Y' Y cv (DF.DB.prz J z (AB.dd.1 q lq) (AB.bfam q lq))) (DF.DB.prz J' rz (AB.dd.1 q' R.2) (AB.bfam q' R.2)) =
    transH s1 (transH s2 (transH s3 (transH s4 (transH s5 (symH R2.beq))))) ;
  } ;
  anat : W0.Ix (DF.DB.anatEq Wd.1 Wd.2 AB.dd AB.bfam) = \ r lq -> NT[r, lq].law ;
 } ;
} ;
