-- CRelResp.seg (canonicity-45; SIMPLIFIED.md step 2b): the "respects"
-- input of the universal map A_x -> R: an element of Rel (ct t) (ct u)
-- (the decoded closed truncation of Proof_x t u, CRelPack.relT-ct) gives
-- the Id-element ev t = ev u in an h-set ring R of the base, through
-- c2's elimination of a decoded closed truncation into a proposition
-- (CTruncLevelCwF.ElimUpP) applied to the family w |-> evP t u w
-- (CTermEval), packaged over the constant type of proofs at level a+.
--   PackAp     the packaging of a metatheory family over the proofs of t ~ u, and
--              its elimination at an element of Rel (ct t) (ct u) (atRel)
--   rsRel t u : El nil (Rel (ct t) (ct u)) -> El nil (Id R (ev t) (ev u))
-- No new axioms beyond the named premises.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module GS = PB.GPre[a].PS ;
module L = PB.GPre[a+].PS ;
module FU = FibUniv[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module FB = FibCwF[a, a+] ;
module PR = CPilotRing[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
C : CwF.CwF[a++] = FB.fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;

-- a metatheory family over the proofs of t ~ u, as an element over
-- nil.ApG (the constant type of proofs read at level a+, ElimUpP's ApG)
-- of a fibrant type P over nil weakened: the input of ElimUpP.On
module PackAp (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (t u : SX.Over[R].Der[x].Term)
 (P : C.Ty C.nil) (pP : C.El C.nil (PU.isProp C.nil P)) (fam : SX.Over[R].Der[x].Proof t u -> C.El C.nil P) {
 module RP = CRelPack[a].Rel[R, encK, x] ;
 module EP = CTruncLevelCwF[a].ElimUpP[RP.RC.PT[t, u].P0.1, RP.RC.PT[t, u].T.Tr0.2, L.nilP, P, pP] ;
 GA : L.PCtx = L.extP L.nilP EP.ApG ;
 Pw : L.PTy[GA] = L.subTy GA L.nilP P.1 (L.pP L.nilP EP.ApG) ;
 ob (I : Ob) (z : V1.Ix (GA.ob I)) : V1.Ix (Pw.tob I z) = (fam z.2).eob I z.1 ;
 nat (J I : Ob) (g : Hom J I) (z : V1.Ix (GA.ob I)) (z' : V1.Ix (GA.ob J)) (e : Id (V1.Ix (GA.ob J)) (GA.act J I g z) z')
  : Id (V1.Ix (Pw.tob J z')) (Pw.tact J I g z z' e (ob I z)) (ob J z') =
  idJ (V1.Ix (GA.ob J)) (GA.act J I g z)
   (\ z2 e2 -> Id (V1.Ix (Pw.tob J z2)) (Pw.tact J I g z z2 e2 (ob I z)) (ob J z2))
   (transH (apH {Id (V1.Ix (L.nilP.ob J)) (L.nilP.act J I g z.1) (L.nilP.act J I g z.1)} {V1.Ix (P.1.tob J (L.nilP.act J I g z.1))}
              (\ q -> P.1.tact J I g z.1 (L.nilP.act J I g z.1) q (ob I z))
              (V1.isSetIx (L.nilP.ob J) (L.nilP.act J I g z.1) (L.nilP.act J I g z.1)
                 (L.ntEq GA L.nilP (L.pP L.nilP EP.ApG) J I g z (GA.act J I g z) (refl (GA.act J I g z))) (refl (L.nilP.act J I g z.1))))
     ((fam z.2).enat J I g z.1 (L.nilP.act J I g z.1) (refl (L.nilP.act J I g z.1))))
   z' e ;
 f : L.PEl[GA, Pw] = L.mkPEl GA Pw ob nat ;
 module O = EP.On[f] ;
 -- the eliminated element, at a given element of the decoded truncation Dc t u
 Dc : C.Ty C.nil = RP.Dc t u ;
 at (w : C.El C.nil Dc) : C.El C.nil P =
  OV.trE C.nil (C.subT C.nil (C.ext C.nil Dc) (OV.wkT C.nil Dc P) (C.sec C.nil Dc w)) P (CConstLam[a, a+].PST[FibCwF[a, a+].fibCwF].pst C.nil Dc P w)
   (C.subt C.nil (C.ext C.nil Dc) (OV.wkT C.nil Dc P) O.elim (C.sec C.nil Dc w)) ;
 -- at an element of Rel (ct t) (ct u)
 atRel (w : C.El C.nil (RP.RelT (RP.ct t) (RP.ct u))) : C.El C.nil P =
  at (OV.trE C.nil (RP.RelT (RP.ct t) (RP.ct u)) Dc (RP.relT-ct t u) w) ;
} ;

module Resp (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (Rg : PR.HRing[C.nil])
 (phi : R.R -> C.El C.nil Rg.R)
 (phi-add : (a1 b1 : R.R) -> C.El C.nil (IJ.IdT C.nil Rg.R (phi (R.add a1 b1)) (PR.ap2 C.nil Rg.R Rg.add (phi a1) (phi b1))))
 (phi-mul : (a1 b1 : R.R) -> C.El C.nil (IJ.IdT C.nil Rg.R (phi (R.mul a1 b1)) (PR.ap2 C.nil Rg.R Rg.mul (phi a1) (phi b1))))
 (phi-one : C.El C.nil (IJ.IdT C.nil Rg.R (phi R.o) Rg.one))
 (phi-zero : C.El C.nil (IJ.IdT C.nil Rg.R (phi R.z) Rg.zero))
 (val : SX.Over[R].Der[x].Vs -> C.El C.nil Rg.R)
 (pSet : (u v : C.El C.nil Rg.R) -> C.El C.nil (PU.isProp C.nil (IJ.IdT C.nil Rg.R u v)))
 (hyp : (p : SX.Over[R].Der[x].Term) -> SX.Over[R].Der[x].Member p x.2 -> C.El C.nil (IJ.IdT C.nil Rg.R (CTermEval[a, a+].Eval[R, x, C.nil, Rg, phi, phi-add, phi-mul, phi-one, phi-zero, val].ev p) Rg.zero)) {
 module RP = CRelPack[a].Rel[R, encK, x] ;
 module EV = CTermEval[a, a+].Eval[R, x, C.nil, Rg, phi, phi-add, phi-mul, phi-one, phi-zero, val] ;
 module RS = EV.Resp[hyp] ;
 Term : U a = RP.Term ;
 rsRel (t u : Term) (w : C.El C.nil (RP.RelT (RP.ct t) (RP.ct u))) : C.El C.nil (IJ.IdT C.nil Rg.R (EV.ev t) (EV.ev u)) =
  PackAp[R, encK, x, t, u, IJ.IdT C.nil Rg.R (EV.ev t) (EV.ev u), pSet (EV.ev t) (EV.ev u), \ w2 -> RS.evP t u w2].atRel w ;
} ;
