-- CConstLam.seg (canonicity-45; SIMPLIFIED.md step 2): metatheory families
-- over a constant type, packaged as elements of the base presheaf CwF.
-- For E : V and a context G, the constant type Delta E = CConst.constTy G
-- has as elements at (I, x) the elements of E, with trivial action.
--   cE e        the constant element e : El G (Delta E)
--   pack f      a metatheory family f : (e : Ix E) -> El G (B[sec (cE e)])
--               packaged as an element of B over G.(Delta E); natural in
--               the base because every f e is an element over G and the
--               constant type's action is trivial
--   pack-beta   pack f substituted along sec (cE e) is f e (el-ext)
--   packN       the non-dependent case (B weakened from G), and lamC: the
--               element of Fun (Delta E) B, with its beta law through app
-- The quotient's relation r : Term -> Term -> PropU and the reflexivity
-- family reflR for eff are packaged with these (CBaseAlg).
-- No new axioms beyond the named premises (fe, through el-ext).

level l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;

module GPR = PB.GPre[l] ;
open GPR.PS ;
module CY = CCyl[a].CylOf[PB.BC, PB.ivV, PB.ivA] ;

module LamOf (cy : CY.Cyl) (E : W0.V) {
 module K = GCConst[l].ConstOf[cy, E] ;
 DE (G : PCtx) : PTy[G] = K.constTy G ;
 GE (G : PCtx) : PCtx = extP G (DE G) ;
 Pt (G : PCtx) (I : Ob) : U l = W0.Ix (G.ob I) ;

 -- the constant element
 cE (G : PCtx) (e : W0.Ix E) : PEl[G, DE G] = mkPEl G (DE G) (\ I x -> e) (\ J I f x y p -> refl e) ;
 -- the section at a constant: its point is the pair (x, e), by definition
 sE (G : PCtx) (e : W0.Ix E) : PSub[G, GE G] = secP G (DE G) (cE G e) ;

 -- packaging a dependent metatheory family
 module Pack (G : PCtx) (B : PTy[GE G]) (f : (e : W0.Ix E) -> PEl[G, subTy G (GE G) B (sE G e)]) {
  ob (I : Ob) (w : W0.Ix ((GE G).ob I)) : W0.Ix (B.tob I w) = (f w.2).eob I w.1 ;
  -- naturality: along a path of points of G.(Delta E); the two transports
  -- (through the section's ntEq and through the given path) agree since
  -- the points form a set
  nat (J I : Ob) (g : Hom J I) (w : W0.Ix ((GE G).ob I)) (w' : W0.Ix ((GE G).ob J)) (p : Id (W0.Ix ((GE G).ob J)) ((GE G).act J I g w) w')
   : Id (W0.Ix (B.tob J w')) (B.tact J I g w w' p (ob I w)) (ob J w') =
   idJ (W0.Ix ((GE G).ob J)) ((GE G).act J I g w)
    (\ w2 p2 -> Id (W0.Ix (B.tob J w2)) (B.tact J I g w w2 p2 (ob I w)) (ob J w2))
    (transH (apH {Id (W0.Ix ((GE G).ob J)) ((GE G).act J I g w) ((GE G).act J I g w)} {W0.Ix (B.tob J ((GE G).act J I g w))}
               (\ r -> B.tact J I g w ((GE G).act J I g w) r (ob I w))
               (W0.isSetIx ((GE G).ob J) ((GE G).act J I g w) ((GE G).act J I g w) (refl ((GE G).act J I g w))
                  (ntEq G (GE G) (sE G w.2) J I g w.1 (G.act J I g w.1) (refl (G.act J I g w.1)))))
      ((f w.2).enat J I g w.1 (G.act J I g w.1) (refl (G.act J I g w.1))))
    w' p ;
  res : PEl[GE G, B] = mkPEl (GE G) B ob nat ;
 } ;
 pack (G : PCtx) (B : PTy[GE G]) (f : (e : W0.Ix E) -> PEl[G, subTy G (GE G) B (sE G e)]) : PEl[GE G, B] = Pack[G, B, f].res ;
 pack-beta (G : PCtx) (B : PTy[GE G]) (f : (e : W0.Ix E) -> PEl[G, subTy G (GE G) B (sE G e)]) (e : W0.Ix E)
  : Id (PEl[G, subTy G (GE G) B (sE G e)]) (subEl G (GE G) B (pack G B f) (sE G e)) (f e) =
  el-ext G (subTy G (GE G) B (sE G e)) (subEl G (GE G) B (pack G B f) (sE G e)) (f e) (\ I x -> refl ((f e).eob I x)) ;

 -- packaging under a further extension: X a type over G.(Delta E), B over
 -- G.(Delta E).X; a metatheory family over e of elements over G.X[sec e]
 -- of B pulled back along the lifted section
 module PackX (G : PCtx) (X : PTy[GE G]) (B : PTy[extP (GE G) X])
  (f : (e : W0.Ix E) -> PEl[extP G (subTy G (GE G) X (sE G e)), subTy (extP G (subTy G (GE G) X (sE G e))) (extP (GE G) X) B (liftP G (GE G) X (sE G e))]) {
  H : PCtx = extP (GE G) X ;
  Xe (e : W0.Ix E) : PTy[G] = subTy G (GE G) X (sE G e) ;
  He (e : W0.Ix E) : PCtx = extP G (Xe e) ;
  ob (I : Ob) (w : W0.Ix (H.ob I)) : W0.Ix (B.tob I w) = (f w.1.2).eob I (w.1.1, w.2) ;
  module N (J I : Ob) (g : Hom J I) (w : W0.Ix (H.ob I)) {
   x : W0.Ix (G.ob I) = w.1.1 ;
   e : W0.Ix E = w.1.2 ;
   v : W0.Ix (X.tob I w.1) = w.2 ;
   y : W0.Ix (G.ob J) = G.act J I g x ;
   vN : W0.Ix (X.tob J (y, e)) = X.tact J I g (x, e) (y, e) (ntEq G (GE G) (sE G e) J I g x y (refl y)) v ;
   vR : W0.Ix (X.tob J (y, e)) = X.tact J I g (x, e) (y, e) (refl (y, e)) v ;
   q : Id (W0.Ix (X.tob J (y, e))) vN vR = tact-irr (GE G) X J I g (x, e) (y, e) (ntEq G (GE G) (sE G e) J I g x y (refl y)) (refl (y, e)) v ;
   w1 : W0.Ix (H.ob J) = ((y, e), vN) ;
   w2 : W0.Ix (H.ob J) = ((y, e), vR) ;
   pN : Id (W0.Ix (H.ob J)) (H.act J I g w) w1 = ntEq (He e) H (liftP G (GE G) X (sE G e)) J I g (x, v) ((He e).act J I g (x, v)) (refl ((He e).act J I g (x, v))) ;
   base : Id (W0.Ix (B.tob J w1)) (B.tact J I g w w1 pN (ob I w)) (ob J w1) = (f e).enat J I g (x, v) ((He e).act J I g (x, v)) (refl ((He e).act J I g (x, v))) ;
   Q : Id (W0.Ix (H.ob J)) w1 w2 = pairE-snd (GE G) X J (y, e) vN vR q ;
   step : Id (W0.Ix (B.tob J w2)) (B.tact J I g w w2 (transH pN Q) (ob I w)) (ob J w2) =
    idJ (W0.Ix (H.ob J)) w1 (\ w3 Q3 -> Id (W0.Ix (B.tob J w3)) (B.tact J I g w w3 (transH pN Q3) (ob I w)) (ob J w3))
     (transH (tact-irr H B J I g w w1 (transH pN (refl w1)) pN (ob I w)) base) w2 Q ;
   res : Id (W0.Ix (B.tob J w2)) (B.tact J I g w w2 (refl w2) (ob I w)) (ob J w2) =
    transH (tact-irr H B J I g w w2 (refl w2) (transH pN Q) (ob I w)) step ;
  } ;
  nat (J I : Ob) (g : Hom J I) (w : W0.Ix (H.ob I)) (w' : W0.Ix (H.ob J)) (p : Id (W0.Ix (H.ob J)) (H.act J I g w) w')
   : Id (W0.Ix (B.tob J w')) (B.tact J I g w w' p (ob I w)) (ob J w') =
   idJ (W0.Ix (H.ob J)) (H.act J I g w) (\ w3 p3 -> Id (W0.Ix (B.tob J w3)) (B.tact J I g w w3 p3 (ob I w)) (ob J w3)) N[J, I, g, w].res w' p ;
  res : PEl[H, B] = mkPEl H B ob nat ;
 } ;
 packX (G : PCtx) (X : PTy[GE G]) (B : PTy[extP (GE G) X])
  (f : (e : W0.Ix E) -> PEl[extP G (subTy G (GE G) X (sE G e)), subTy (extP G (subTy G (GE G) X (sE G e))) (extP (GE G) X) B (liftP G (GE G) X (sE G e))]) : PEl[extP (GE G) X, B] =
  PackX[G, X, B, f].res ;

 -- the non-dependent case: B a type over G, weakened
 wk (G : PCtx) (B : PTy[G]) : PTy[GE G] = subTy (GE G) G B (pP G (DE G)) ;
 -- an element of B over G is an element of B[p][sec (cE e)] (same points)
 up (G : PCtx) (B : PTy[G]) (e : W0.Ix E) (b : PEl[G, B]) : PEl[G, subTy G (GE G) (wk G B) (sE G e)] =
  mkPEl G (subTy G (GE G) (wk G B) (sE G e)) (\ I x -> b.eob I x)
   (\ J I g x y p -> b.enat J I g x y (ntEq (GE G) G (pP G (DE G)) J I g ((sE G e).nt I x) ((sE G e).nt J y) (ntEq G (GE G) (sE G e) J I g x y p))) ;
 packN (G : PCtx) (B : PTy[G]) (f : W0.Ix E -> PEl[G, B]) : PEl[GE G, wk G B] = pack G (wk G B) (\ e -> up G B e (f e)) ;
 packN-beta (G : PCtx) (B : PTy[G]) (f : W0.Ix E -> PEl[G, B]) (e : W0.Ix E)
  : Id (PEl[G, subTy G (GE G) (wk G B) (sE G e)]) (subEl G (GE G) (wk G B) (packN G B f) (sE G e)) (up G B e (f e)) =
  pack-beta G (wk G B) (\ e2 -> up G B e2 (f e2)) e ;
} ;

------------------------------------------------------------------
-- at the fibrant CwF: the constant type as a fibrant type, lamC and its
-- beta law through app, and the constancy of elements over the terminal
-- context (the base has the point unitP, with a map from every object)
module PST (C0 : CwF.CwF[l+]) {
 open C0 ;
 pst (G : C0.Ctx) (A B : C0.Ty G) (a : C0.El G A) : Id (C0.Ty G) (C0.subT G (C0.ext G A) (C0.subT (C0.ext G A) G B (C0.p G A)) (C0.sec G A a)) B = p-sec-T G A B a ;
} ;

module LamC (cy : CY.Cyl) (E : W0.V) {
 module L = LamOf[cy, E] ;
 module K = GCConst[l].ConstOf[cy, E] ;
 module FBC = GFibCwF[l] ;
 module FID = GFibId[l] ;
 C : CwF.CwF[l+] = FBC.fibCwF ;
 module OV = CwFOv.Ov[l+, FBC.fibCwF, FBC.fibPi, FBC.fibSig, FID.fibId] ;
 module IN = CwFInt.Int[l+, FBC.fibCwF, FBC.fibPi, FBC.fibSig, FID.fibId] ;
 TE (G : C.Ctx) : C.Ty G = K.constS G ;
 cE (G : C.Ctx) (e : W0.Ix E) : C.El G (TE G) = L.cE G e ;

 -- a transported element is determined by its points (the fibre codes
 -- form a set, so the fibre path of a type path at a point is trivial)
 fibP (G : C.Ctx) (I : Ob) (x : W0.Ix (G.ob I)) (T : C.Ty G) : W0.V = T.1.tob I x ;
 subst-ap (G : C.Ctx) (I : Ob) (x : W0.Ix (G.ob I)) (A A' : C.Ty G) (P : Id (C.Ty G) A A') (v : W0.Ix (fibP G I x A))
  : Id (W0.Ix (fibP G I x A')) (subst (C.Ty G) (\ T -> W0.Ix (fibP G I x T)) A A' P v) (subst W0.V (\ c -> W0.Ix c) (fibP G I x A) (fibP G I x A') (apH {C.Ty G} {W0.V} (fibP G I x) P) v) =
  idJ (C.Ty G) A (\ A2 P2 -> Id (W0.Ix (fibP G I x A2)) (subst (C.Ty G) (\ T -> W0.Ix (fibP G I x T)) A A2 P2 v) (subst W0.V (\ c -> W0.Ix c) (fibP G I x A) (fibP G I x A2) (apH {C.Ty G} {W0.V} (fibP G I x) P2) v)) (refl v) A' P ;
 trE-ext (G : C.Ctx) (A A' : C.Ty G) (P : Id (C.Ty G) A A') (a : C.El G A) (b : C.El G A')
  (H : (I : Ob) (x : W0.Ix (G.ob I)) -> Id (W0.Ix (fibP G I x A')) (subst (C.Ty G) (\ T -> W0.Ix (fibP G I x T)) A A' P (a.eob I x)) (b.eob I x))
  : Id (C.El G A') (OV.trE G A A' P a) b =
  idJ (C.Ty G) A (\ A2 P2 -> (b2 : C.El G A2) -> ((I : Ob) (x : W0.Ix (G.ob I)) -> Id (W0.Ix (fibP G I x A2)) (subst (C.Ty G) (\ T -> W0.Ix (fibP G I x T)) A A2 P2 (a.eob I x)) (b2.eob I x)) -> Id (C.El G A2) (OV.trE G A A2 P2 a) b2)
   (\ b2 H2 -> el-ext G A.1 a b2 H2) A' P b H ;
 -- when the two fibre codes coincide, the transport is trivial
 same-fib (G : C.Ctx) (I : Ob) (x : W0.Ix (G.ob I)) (A A' : C.Ty G) (P : Id (C.Ty G) A A') (v : W0.Ix (fibP G I x A)) (E2 : Id W0.V (fibP G I x A) (fibP G I x A'))
  : Id (W0.Ix (fibP G I x A')) (subst (C.Ty G) (\ T -> W0.Ix (fibP G I x T)) A A' P v) (subst W0.V (\ c -> W0.Ix c) (fibP G I x A) (fibP G I x A') E2 v) =
  transH (subst-ap G I x A A' P v) (apH {Id W0.V (fibP G I x A) (fibP G I x A')} {W0.Ix (fibP G I x A')} (\ r -> subst W0.V (\ c -> W0.Ix c) (fibP G I x A) (fibP G I x A') r v)
                                        (W0.isSetV (fibP G I x A) (fibP G I x A') (apH {C.Ty G} {W0.V} (fibP G I x) P) E2)) ;

 -- the element of Fun (Delta E) B packaging a metatheory family, and its beta law
 lamC (G : C.Ctx) (B : C.Ty G) (f : W0.Ix E -> C.El G B) : C.El G (OV.Fun G (TE G) B) =
  OV.lam G (TE G) (OV.wkT G (TE G) B) (L.packN G B.1 f) ;
 lamC-beta (G : C.Ctx) (B : C.Ty G) (f : W0.Ix E -> C.El G B) (e : W0.Ix E) : Id (C.El G B) (OV.app G (TE G) B (lamC G B f) (cE G e)) (f e) =
  transH (IN.app-lam G (TE G) B (L.packN G B.1 f) (cE G e))
   (trE-ext G (C.subT G (C.ext G (TE G)) (OV.wkT G (TE G) B) (C.sec G (TE G) (cE G e))) B (PST[FBC.fibCwF].pst G (TE G) B (cE G e))
      (C.subt G (C.ext G (TE G)) (OV.wkT G (TE G) B) (L.packN G B.1 f) (C.sec G (TE G) (cE G e))) (f e)
      (\ I x -> same-fib G I x (C.subT G (C.ext G (TE G)) (OV.wkT G (TE G) B) (C.sec G (TE G) (cE G e))) B (PST[FBC.fibCwF].pst G (TE G) B (cE G e)) ((f e).eob I x) (refl (B.1.tob I x)))) ;

} ;
