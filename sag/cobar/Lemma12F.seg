-- Lemma12F.seg (canonicity-45; COBAR.md): the fibrancy half of Lemma 12.
-- From a levelwise fibration structure al of A over G, a levelwise
-- fibration structure of D A over D G, as in the paper: "reduce to trivial
-- fibrancy by Lemma 11".
--   fillZ e z     the filler of A_z at the end e (CFill, from al z)
--   UT e          lemma12U on the strict fibre of ev_e: D of the lines
--   FillD e x     moved along lemma11-lines (CMove.Mv: Psi , psi-nat , mS ,
--                 mTinj , bk , bkMv) to the filler of D A at x
--   fibD          the compositions of D A (Lines.CompK.fromFill)
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;

module F12 (C : SmallCat[a].SmallCat) (G : CPshC[a, l].CPsh[C].CCtx) (A : CPshC[a, l].CPsh[C].CTy[G])
 (al : CPshC[a, l].CPsh[C].LFib G A) {
 module P = CPshC[a, l].CPsh[C] ;
 module DD = Cobar[a, l].DOf[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module D = DD.DC[G] ;
 module DA = DD.DT[G, A] ;
 module PS' = Lemma11L[a, l].PsiOf[C, G] ;
 CO : U a = P.CO ;

 -- the fillers of A at the ends, levelwise
 fillZ : (d : Bool) -> (z : CO) -> CP.ContrOp (LO.SF[G, A, PB.src d].TVC.ob z) (LO.SF[G, A, PB.src d].SFC.ty z) = split {
  true -> \ z -> PB.CFill[l].FillC[G.ob z, A.ty z, true, (al z).1].fill ;
  false -> \ z -> PB.CFill[l].FillC[G.ob z, A.ty z, false, (al z).2].fill } ;

 -- D of the strict fibre of ev_e is a trivial fibration, uniformly
 UT (d : Bool) : P.UTriv (DD.DC[LO.SF[G, A, PB.src d].TVC].DCtx) (DD.DT[LO.SF[G, A, PB.src d].TVC, LO.SF[G, A, PB.src d].SFC].DCTy) =
  Lemma12[a, l].L12[C, LO.SF[G, A, PB.src d].TVC, LO.SF[G, A, PB.src d].SFC].lemma12U (fillZ d) ;

 -- moved along lemma11-lines: the filler of D A at x
 module FD (d : Bool) (x : CO) {
  module MSx = PS'.MS[A, PB.src d, x] ;
  module Mv = PB.CMove[l, l].Mv[
   extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[PB.src d].Aev, MSx.SFD.SF, MSx.SFD.SF,
   CP.pmap-id (extP CL.FC[D.obD x].GI CL.FT[D.obD x, DA.DTy x].Ev[PB.src d].Aev) MSx.SFD.SF,
   MSx.DV.obD x, MSx.DS.DTy x, MSx.DS.DTy x, CP.pmap-id (MSx.DV.obD x) (MSx.DS.DTy x),
   MSx.PNx.psi, MSx.PNx.psi-nat,
   MSx.mS, MSx.mSpt, MSx.mSnat, MSx.mS, MSx.mSpt, MSx.mSnat, MSx.mTinj,
   \ X w u -> MSx.BK[X, w, u].bkv, \ X w u -> MSx.BK[X, w, u].bkMv,
   \ W v -> refl (MSx.mS W v),
   (UT d).1 x] ;
  fill : CL.Lines[D.obD x, DA.DTy x].Fill (PB.src d) = Mv.rc ;
 } ;

 -- the fibration structure of D A, levelwise
 fibD : P.LFib D.DCtx DA.DCTy = \ x ->
  (CL.Lines[D.obD x, DA.DTy x].CompK[PB.e0, PB.e1].fromFill FD[true, x].fill,
   CL.Lines[D.obD x, DA.DTy x].CompK[PB.e1, PB.e0].fromFill FD[false, x].fill) ;

 ------------------------------------------------------------------
 -- the fillers of D A are uniform in C

 module UFl (d : Bool) (x' x : CO) (gC : P.CH x' x) (X : Ob) (w : PS'.PN[A, PB.src d, x].Pts X)
  (s : CP.Partials[LO.SF[D.DCtx, DA.DCTy, PB.src d].TVC.ob x, LO.SF[D.DCtx, DA.DCTy, PB.src d].SFC.ty x].Side[X, w]) {
  module SFd = LO.SF[D.DCtx, DA.DCTy, PB.src d] ;
  module Fx = FD[d, x] ;
  module Fx' = FD[d, x'] ;
  module PCx = PS'.PC[A, PB.src d, x', x, gC] ;
  w' : PS'.PN[A, PB.src d, x'].Pts X = (SFd.TVC.act x' x gC).nt X w ;
  sm : CP.Partials[SFd.TVC.ob x', SFd.SFC.ty x'].Side[X, w'] = P.MapSide[SFd.TVC, SFd.SFC, x', x, gC].mapside X w s ;
  -- the moved sides agree
  R : Id (CP.Partials[Fx'.MSx.DV.obD x', Fx'.MSx.DS.DTy x'].Side[X, Fx'.MSx.PNx.psi X w'])
        (subst (W0.Ix ((Fx'.MSx.DV.obD x').ob X)) (\ y -> CP.Partials[Fx'.MSx.DV.obD x', Fx'.MSx.DS.DTy x'].Side[X, y])
           (Fx.MSx.DV.CA[x', x, gC, X, Fx.MSx.PNx.psi X w].res) (Fx'.MSx.PNx.psi X w') (symH (PCx.psiC X w))
           (P.MapSide[Fx.MSx.DV.DCtx, Fx.MSx.DS.DCTy, x', x, gC].mapside X (Fx.MSx.PNx.psi X w) (Fx.Mv.mside X w s)))
        (Fx'.Mv.mside X w' sm) =
   CP.Partials[Fx'.MSx.DV.obD x', Fx'.MSx.DS.DTy x'].side-extH X
    (Fx.MSx.DV.CA[x', x, gC, X, Fx.MSx.PNx.psi X w].res) (Fx'.MSx.PNx.psi X w') (symH (PCx.psiC X w))
    (P.MapSide[Fx.MSx.DV.DCtx, Fx.MSx.DS.DCTy, x', x, gC].mapside X (Fx.MSx.PNx.psi X w) (Fx.Mv.mside X w s))
    (Fx'.Mv.mside X w' sm)
    (refl s.pQ)
    (\ W f i i' -> transH (apH (\ v -> (Fx.MSx.DS.tEC x' x gC).nt W (Fx.MSx.mS W v))
                            (CP.Partials[SFd.TVC.ob x, SFd.SFC.ty x].pv-irr X w s W f i i'))
                   (symH (PCx.mSC W (s.pv W f i')))) ;
  res : Id (SigT (SFd.TVC.ob x') (SFd.SFC.ty x') X)
          ((SFd.SFC.tE x' x gC).nt X (pairE (SFd.TVC.ob x) (SFd.SFC.ty x) X w (Fx.fill.kop X w s)))
          (pairE (SFd.TVC.ob x') (SFd.SFC.ty x') X w' (Fx'.fill.kop X w' sm)) =
   Fx'.MSx.mTinj X _ _ (refl w')
    (transH (PCx.mSC X (pairE (SFd.TVC.ob x) (SFd.SFC.ty x) X w (Fx.fill.kop X w s)))
      (transH (apH ((Fx.MSx.DS.tEC x' x gC).nt X) (Fx.Mv.kopMv X w s))
        (transH ((UT d).2 x' x gC X (Fx.MSx.PNx.psi X w) (Fx.Mv.mside X w s))
          (transH (CP.Rel[Fx'.MSx.DV.obD x', Fx'.MSx.DS.DTy x', Fx'.MSx.DS.DTy x', CP.pmap-id (Fx'.MSx.DV.obD x') (Fx'.MSx.DS.DTy x')].kop-cong
                     ((UT d).1 x') X (Fx.MSx.DV.CA[x', x, gC, X, Fx.MSx.PNx.psi X w].res) (Fx'.MSx.PNx.psi X w') (symH (PCx.psiC X w))
                     (P.MapSide[Fx.MSx.DV.DCtx, Fx.MSx.DS.DCTy, x', x, gC].mapside X (Fx.MSx.PNx.psi X w) (Fx.Mv.mside X w s))
                     (Fx'.Mv.mside X w' sm) R)
            (symH (Fx'.Mv.kopMv X w' sm)))))) ;
 } ;
} ;
