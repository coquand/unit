-- CTotPsi18.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 18: the naturality equation of the lift
-- back's D A element (anat): the line's naturality, u's naturality
-- equation (through lineL), D's index law natPath, ivA-comp.
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi18 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P17 = CTotPsi17[a, vl, l].Psi17[C, G, A, e] ;
 module P13 = P17.P13 ;
 module P10 = P17.P10 ;
 module PO = P17.PO ;
 module TR = PO.TR ;
 module G1 = TR.G1 ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module DA = P17.DA ;
 module EKg = P17.EKg ;
 module EKd = P17.EKd ;
 module FTg = P17.FTg ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;

 module AN (X : TC.TOb) (w : EKd.TV.EI X) (u : P13.DS.TOb' X.1 X.2 (P10.psi X w)) (Wd : TC.TOb) (f : TC.THm Wd X) (j : PB.IvP Wd.1) {
  module B = P17.BKd[X, w, u] ;
  module AB = B.AB[Wd, f, j] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module NT (r : VA.Ix (D.natIdxV Wd.1 Wd.2)) (lq : DO.LandsI Wd.1 Wd.2 r.1) {
   q : DO.Idx Wd.1 Wd.2 = r.1 ;
   J : Ob = q.2.1 ;
   z : Obj J = q.2.2.2.1 ;
   J' : Ob = r.2.1 ;
   v : Hom J' J = r.2.2 ;
   rz : Obj J' = C.res J' J v z ;
   Y : TC.TOb = (J, z) ;
   Y' : TC.TOb = (J', rz) ;
   cv : TC.THm Y' Y = (v, C.cart J' J v z) ;
   R : Wt.Pn q.1 J' = Wt.Res[q.1, J', J, v, (q.2.2.2.2.2, lq)].res ;
   q' : DO.Idx Wd.1 Wd.2 = (q.1, J', compH J' J Wd.1 q.2.2.1 v, rz, DO.rCh J' J Wd.1 v q.2.2.1 Wd.2 q.1 z q.2.2.2.2.1, R.1) ;
   module R1 = AB.RQ[q, lq] ;
   module R2 = AB.RQ[q', R.2] ;
   lnq : W0.Ix (FTg.FE.ob Y) = B.lineE R1.qq lq ;
   j1 : PB.IvP J' = PB.ivA J' J v R1.RC.j0 ;
   -- the restricted index of the moved index
   rqq : DO.Idx I x = (q.1, J', compH J' J I R1.RC.U0 v, rz, DO.rCh J' J I v R1.RC.U0 x q.1 z R1.RC.cc, R.1) ;
   lineEs (sw : D.S I x q.1 J' rz) : W0.Ix (FTg.FE.ob Y') = B.lineE (q.1, J', sw.1, rz, sw.2, R.1) R.2 ;
   s1 : Id (EKg.TA.EI Y') (DA.E.act Y' Y cv (DA.prz J z (AB.dd.1 q lq) (AB.abfam q lq))) (DA.E.act Y' Y cv R1.te) =
    apH {EKg.TA.EI Y} {EKg.TA.EI Y'} (\ t -> DA.E.act Y' Y cv t) R1.aeq ;
   s2 : Id (EKg.TA.EI Y') (DA.E.act Y' Y cv R1.te) (lnq.1 Y' cv j1) =
    transH (lnq.2 Y' Y cv (TC.tid Y) R1.RC.j0)
     (apH {TC.THm Y' Y} {EKg.TA.EI Y'} (\ k -> lnq.1 Y' k j1) (G1.GB.BC.oC-idl Y' Y cv)) ;
   uN : Id (EKg.TS.EI Y') (EKg.TS.E.act Y' Y cv (EKg.TS.pr Y ((P10.psi X w).1 R1.qq lq) (u.1 R1.qq lq)))
          (EKg.TS.pr Y' ((P10.psi X w).1 rqq R.2) (u.1 rqq R.2)) =
    u.2.1 (R1.qq, (J', v)) lq ;
   s3 : Id (EKg.TA.EI Y') (lnq.1 Y' cv j1) ((B.lineE rqq R.2).1 Y' (TC.tid Y') j1) =
    transH (apH {TC.THm Y' Y} {EKg.TA.EI Y'} (\ k -> lnq.1 Y' k j1) (symH (G1.GB.BC.oC-idr Y' Y cv)))
     (transH (symH (apH {EKg.TL.EI Y'} {EKg.TA.EI Y'} (\ MM -> FTg.lval Y' MM Y' (TC.tid Y') j1)
                      (EKg.lineL-act Y' Y cv (EKg.TS.pr Y ((P10.psi X w).1 R1.qq lq) (u.1 R1.qq lq)))))
       (apH {EKg.TS.EI Y'} {EKg.TA.EI Y'} (\ T -> FTg.lval Y' (EKg.lineL Y' T) Y' (TC.tid Y') j1) uN)) ;
   s4 : Id (EKg.TA.EI Y') ((B.lineE rqq R.2).1 Y' (TC.tid Y') j1) ((B.lineE R2.qq R.2).1 Y' (TC.tid Y') j1) =
    apH {D.S I x q.1 J' rz} {EKg.TA.EI Y'} (\ sw -> (lineEs sw).1 Y' (TC.tid Y') j1)
     (D.Act[Wd.1, I, f.1, Wd.2, x, f.2, B.PP.u0].natPath r lq) ;
   s5 : Id (EKg.TA.EI Y') ((B.lineE R2.qq R.2).1 Y' (TC.tid Y') j1) R2.te =
    apH {PB.IvP J'} {EKg.TA.EI Y'} (\ jj -> (B.lineE R2.qq R.2).1 Y' (TC.tid Y') jj) (PB.ivA-comp J' J Wd.1 q.2.2.1 v j) ;
   law : Id (EKg.TA.EI Y') (DA.E.act Y' Y cv (DA.prz J z (AB.dd.1 q lq) (AB.abfam q lq))) (DA.prz J' rz (AB.dd.1 q' R.2) (AB.abfam q' R.2)) =
    transH s1 (transH s2 (transH s3 (transH s4 (transH s5 (symH R2.aeq))))) ;
  } ;
  anat : W0.Ix (DA.anatEq Wd.1 Wd.2 AB.dd AB.abfam) = \ r lq -> NT[r, lq].law ;
 } ;
} ;
