-- CPreI.seg (canonicity-c2; SIMPLIFIED.md step 6, for cmpI and (d)): the
-- precomposition with a closed map F' -> F on the internal Hom types,
-- preI : HomT(F, y) -> HomT(F', y) over nil, read through canonicity-45's
-- codes: z |-> alpha (pre (beta z)) (CHomT8 beta, CCmp.Pre.pre, CHomT11
-- alpha), natural by CHomT16 and Pre's naturality.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;

module PreOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module CM = CCopy[a].ConcC[R, encK, pe].CM ;
 module MO = CM.MO ;
 Pres : U a = CM.Pres ;
 -- composing with an identity code
 cmpId (J : Ob) (F y : Pres) (m : MO.Fn[F, y].M J) : Id (MO.Fn[F, y].M J) (MO.Cmp[F, y, y, J, m, CM.CO.idM J y].cmp) m =
  MO.Fn[F, y].mExt J (MO.Cmp[F, y, y, J, m, CM.CO.idM J y].cmp) m (refl (MO.Fn[F, y].fpOf J m)) ;
 module PI (F F' : Pres) (io : (J : Ob) -> MO.Fn[F', F].M J)
  (io-nat : (J K : Ob) (v : Hom K J) -> Id (MO.Fn[F', F].M K) (MO.Fn[F', F].res J K v (io J)) (io K)) (y : Pres) {
  module PR = CM.Pre[F, F', io, io-nat] ;
  stage-nat (I J : Ob) (v : Hom J I) (h : MO.Fn[F, y].M I)
    : Id (MO.Fn[F', y].M J) (PR.pre J y (MO.Fn[F, y].res I J v h)) (MO.Fn[F', y].res I J v (PR.pre I y h)) =
   transH (apH {MO.Fn[F, y].M J} {MO.Fn[F', y].M J} (PR.pre J y) (symH (cmpId J F y (MO.Fn[F, y].res I J v h))))
    (transH (PR.pre-nat J I v y y (CM.CO.idM J y) h)
       (cmpId J F' y (MO.Fn[F', y].res I J v (PR.pre I y h)))) ;
  module TM = CHomT8[a].ToM[R, encK, pe, F, y] ;
  module FM = CHomT11[a].FromM[R, encK, pe, F', y] ;
  bz (I : Ob) (z : TM.P.Z I) : MO.Fn[F, y].M I = TM.beta I z ;
  pz (I : Ob) (z : TM.P.Z I) : MO.Fn[F', y].M I = PR.pre I y (bz I z) ;
  val (I : Ob) (z : TM.P.Z I) : FM.P.Z I = FM.alpha I (pz I z) ;
  module NS = CHomT16[a].Nat[R, encK, pe, F, y] ;
  module NT = CHomT16[a].Nat[R, encK, pe, F', y] ;
  valNat (I J : Ob) (v : Hom J I) (z : TM.P.Z I)
    : Id (FM.P.Z J) (val J (NS.BN0.tactZ I J v z)) (NT.BN0.tactZ I J v (val I z)) =
   transH (apH {MO.Fn[F, y].M J} {FM.P.Z J} (\ m -> FM.alpha J (PR.pre J y m)) (symH (NS.At[I, J, v, z].bNat)))
    (transH (apH {MO.Fn[F', y].M J} {FM.P.Z J} (FM.alpha J) (stage-nat I J v (bz I z)))
       (NT.aNat I J v (pz I z))) ;
  -- as a natural map over nil, and as an element of Fun over nil
  module L = PosFull[a].PB.GPre[a+].PS ;
  module HO = PosFull[a].PB.CHtpyOps[a+] ;
  HS : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = TM.P.H.HomT ;
  HT : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = FM.P.H.HomT ;
  nf (I : Ob) : (o : Top) -> V1.Ix (HS.1.tob I o) -> V1.Ix (HT.1.tob I o) = split { tt -> \ z -> val I z } ;
  nn (J I : Ob) (f : Hom J I) : (x : Top) (x' : Top) (e : Id Top (FibCwF[a, a+].fibCwF.nil.act J I f x) x') (z : V1.Ix (HS.1.tob I x))
    -> Id (V1.Ix (HT.1.tob J x')) (HT.1.tact J I f x x' e (nf I x z)) (nf J x' (HS.1.tact J I f x x' e z)) =
   split { tt -> split { tt -> \ e z ->
     transH (L.tact-irr FibCwF[a, a+].fibCwF.nil HT.1 J I f tt tt e (refl tt) (val I z))
      (transH (symH (valNat I J f z))
        (apH {V1.Ix (HS.1.tob J tt)} {V1.Ix (HT.1.tob J tt)} (val J) (L.tact-irr FibCwF[a, a+].fibCwF.nil HS.1 J I f tt tt (refl tt) e z))) } } ;
  nmap : HO.NMap[FibCwF[a, a+].fibCwF.nil, HS.1, HT.1] = new HO.NMap[FibCwF[a, a+].fibCwF.nil, HS.1, HT.1, nf, nn] ;
  preI : FibCwF[a, a+].fibCwF.El FibCwF[a, a+].fibCwF.nil (CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId].Fun FibCwF[a, a+].fibCwF.nil HS HT) =
   QinvEq[a, a+].FunOf[FibCwF[a, a+].fibCwF.nil, HS, HT, nmap].fC ;
 } ;
 -- cmpI: the pairing of the precompositions with the two coprojections
 module CmpI (y : Pres) {
  module Q1 = PI[CM.F2, CM.F1, CM.II.I1.M.mor, CM.II.I1.M.mor-nat, y] ;
  module Q2 = PI[CM.F2, CM.F1, CM.II.I2.M.mor, CM.II.I2.M.mor-nat, y] ;
  module L = Q1.L ;
  module HO = Q1.HO ;
  Nl : FibCwF[a, a+].fibCwF.Ctx = FibCwF[a, a+].fibCwF.nil ;
  module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
  HS : FibCwF[a, a+].fibCwF.Ty Nl = Q1.HS ;
  HT : FibCwF[a, a+].fibCwF.Ty Nl = Q1.HT ;
  HTT : FibCwF[a, a+].fibCwF.Ty Nl = FibCwF[a, a+].fibSig.Sig Nl HT (OV.wkT Nl HT HT) ;
  nf (I : Ob) (o : Top) (z : V1.Ix (HS.1.tob I o)) : V1.Ix (HTT.1.tob I o) = (Q1.nf I o z, Q2.nf I o z) ;
  -- the action of HTT on a pair (CwF Sigma, presheaf SigAB)
  wkP (J I : Ob) (f : Hom J I) (e : Id Top (Nl.act J I f tt) tt) (a : V1.Ix (HT.1.tob I tt)) : Id Top (Nl.act J I f tt) tt =
   L.ntEq (L.extP Nl HT.1) Nl (L.pP Nl HT.1) J I f (tt, a) (tt, HT.1.tact J I f tt tt e a) (L.pair-act Nl HT.1 J I f tt tt e a) ;
  actP (J I : Ob) (f : Hom J I) (e : Id Top (Nl.act J I f tt) tt) (a b : V1.Ix (HT.1.tob I tt))
    : Id (V1.Ix (HTT.1.tob J tt)) (HTT.1.tact J I f tt tt e (a, b)) (HT.1.tact J I f tt tt e a, HT.1.tact J I f tt tt (wkP J I f e a) b) =
   refl (HTT.1.tact J I f tt tt e (a, b)) ;
  c2 (J I : Ob) (f : Hom J I) (e : Id Top (Nl.act J I f tt) tt) (z : V1.Ix (HS.1.tob I tt))
    : Id (V1.Ix (HT.1.tob J tt)) (HT.1.tact J I f tt tt (wkP J I f e (Q1.nf I tt z)) (Q2.nf I tt z)) (Q2.nf J tt (HS.1.tact J I f tt tt e z)) =
   transH (L.tact-irr Nl HT.1 J I f tt tt (wkP J I f e (Q1.nf I tt z)) e (Q2.nf I tt z)) (Q2.nn J I f tt tt e z) ;
  nn (J I : Ob) (f : Hom J I) : (x : Top) (x' : Top) (e : Id Top (Nl.act J I f x) x') (z : V1.Ix (HS.1.tob I x))
    -> Id (V1.Ix (HTT.1.tob J x')) (HTT.1.tact J I f x x' e (nf I x z)) (nf J x' (HS.1.tact J I f x x' e z)) =
   split { tt -> split { tt -> \ e z ->
    transH (actP J I f e (Q1.nf I tt z) (Q2.nf I tt z))
     (transH (apH {V1.Ix (HT.1.tob J tt)} {V1.Ix (HTT.1.tob J tt)} (\ c -> (c, HT.1.tact J I f tt tt (wkP J I f e (Q1.nf I tt z)) (Q2.nf I tt z))) (Q1.nn J I f tt tt e z))
       (apH {V1.Ix (HT.1.tob J tt)} {V1.Ix (HTT.1.tob J tt)} (\ c -> (Q1.nf J tt (HS.1.tact J I f tt tt e z), c)) (c2 J I f e z))) } } ;
  nmap : HO.NMap[Nl, HS.1, HTT.1] = new HO.NMap[Nl, HS.1, HTT.1, nf, nn] ;
  cmpI : FibCwF[a, a+].fibCwF.El Nl (OV.Fun Nl HS HTT) = QinvEq[a, a+].FunOf[Nl, HS, HTT, nmap].fC ;
 } ;
} ;
