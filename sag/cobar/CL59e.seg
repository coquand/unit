-- CL59e.seg (canonicity-45; COBAR.md "Lemma 59"): Lemma 59 at a fixed
-- (y, u), part e: the inverse of the evaluation, its value at a point
-- (K, f, v) of the copy y: with e = (f . id_y, v) a point of yo(y).A,
--   tau_Q^-1 (c2 (D ev' (c1 ((D rho)^-1 (tau e), tau_Qc (psi . f)))))
-- (D rho^-1 by Prop 13 + CEqCen from rho's levelwise equivalence ef,
-- tau_Q^-1 by CEqCen from Q's D-modality mQ).
-- No new axioms beyond the named premises (fe) and the module parameters.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module IV (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres y) {
 module LA = CL59a[a].L59[R, encK, pe, y, u] ;
 module G1 = LA.G1 ;
 module CT = LA.CT ;
 module CM = LA.CM ;
 module TR = LA.TR ;
 module DRr = CL59b[a].DR[R, encK, pe] ;
 module Data (A : G1.fibCwF-T.Ty LA.PYy) (rho : TR.P1.PSub[LA.PYu, TR.P1.extP LA.PYy A.1])
  (rho1 : (X : CT.TC.TOb) (w : V1.Ix (LA.PYu.ob X)) -> Id (V1.Ix (LA.PYy.ob X)) (TR.P1.fstE LA.PYy A.1 X (rho.nt X w)) (LA.PyoPu.nt X w))
  (Q : G1.fibCwF-T.Ty G1.fibCwF-T.nil) {
  module DA0 = LA.Data[A, rho, rho1, Q] ;
  E : TR.P1.PCtx = TR.P1.extP LA.PYy A.1 ;
  rhoT : CM.TP.TSub[LA.Yu, CT.TC.ofP E] =
   new CM.TP.TSub[LA.Yu, CT.TC.ofP E, \ I x d -> rho.nt (I, x) d, \ J I uu yy x f d -> rho.nt-nat (J, yy) (I, x) (uu, f) d] ;
  module RM = DRr.Map[LA.Yu, CT.TC.ofP E, rhoT] ;
  module QC = CL59c[a].QCt[R, encK, pe, LA.yu, Q] ;
  module CV = CL59d[a].Cv[R, encK, pe, LA.yu, Q] ;
  module C15Q = CTotC15[a, a+, a+].C15[CM.IC, CT.T1, Q.1] ;
  B2Q : TR.P1.PTy[CT.P1] = C15Q.LB.Bt ;
  module Hyp (ef : TR.G0.GB.CEquiv[a+].EquivOp RM.PD.UG RM.PD.UA RM.PD.UB RM.PD.Uf)
   (mQ : G1.GB.CEquiv[a+].EquivOp CT.P1 Q.1 B2Q C15Q.tauM) {
   module DI = RM.DInv[ef] ;
   module TI = CEqCen[a, a+, a+].Cen[CM.IC, CT.P1, Q.1, B2Q, C15Q.tauM, mQ] ;
   module DE = CV.DO.DC[CT.TC.ofP E] ;
   -- the downstream composite, as a function of the two D-points, and its naturality
   Gf (X : CT.TC.TOb) (w : CV.DQc.Ob' X.1 X.2) (d : CV.DYu.Ob' X.1 X.2) : V1.Ix (Q.1.tob X tt) =
    (TI.inv.mE X (tt, CV.C2[X.1, X.2, w, QC.DF.DM[X.1, X.2, w, CV.C1[X.1, X.2, w, d].res].res].res)).2 ;
   module GN (J K : CT.TC.TOb) (g : CT.TC.THm K J) (w : CV.DQc.Ob' J.1 J.2) (d : CV.DYu.Ob' J.1 J.2) {
    w' : CV.DQc.Ob' K.1 K.2 = CV.DQc.act K.1 J.1 g.1 K.2 J.2 g.2 w ;
    d' : CV.DYu.Ob' K.1 K.2 = CV.DYu.act K.1 J.1 g.1 K.2 J.2 g.2 d ;
    aJ : QC.DF.DA.TOb' J.1 J.2 w = CV.C1[J.1, J.2, w, d].res ;
    bJ : QC.DF.DB.TOb' J.1 J.2 w = QC.DF.DM[J.1, J.2, w, aJ].res ;
    cJ : V1.Ix (B2Q.tob J tt) = CV.C2[J.1, J.2, w, bJ].res ;
    module N1 = CV.C1N[K.1, J.1, g.1, K.2, J.2, g.2, w, d] ;
    module N3 = CV.C2N[K.1, J.1, g.1, K.2, J.2, g.2, w, bJ] ;
    m2 : Id (QC.DF.DB.TOb' K.1 K.2 w') (QC.DF.DM[K.1, K.2, w', N1.TB.res].res) N3.TBb.res =
     G1.GB.GPre[a+].TyL[QC.DF.DG, QC.DF.DB.DTy].pr-inj K w' _ _ QC.DF.DN[K, J, g, (w, aJ)].nat ;
    module TBB = CV.DQ.TB[K.1, J.1, g.1, K.2, J.2, g.2, CV.DT1.tau J.1 J.2 tt, CV.DT1.tau K.1 K.2 tt,
       G1.GB.GPre[a+].PS.ntEq CT.P1 (CT.TC.toP CV.DT1.DCtx) (CT.TC.toPS CT.T1 CV.DT1.DCtx CV.DT1.tauS) K J g tt tt (refl tt), cJ] ;
    tbIrr : Id (V1.Ix (B2Q.tob K tt)) TBB.res N3.TBq.res =
     CV.DQ.tob-eq K.1 K.2 (CV.DT1.tau K.1 K.2 tt) TBB.res N3.TBq.res (\ q l ->
      CV.DQ.pr-inj q.2.1 q.2.2.2.1 ((CV.DT1.tau K.1 K.2 tt).1 q l) (TBB.a' q l) (N3.TBq.a' q l) (transH (TBB.pc q l) (symH (N3.TBq.pc q l)))) ;
    chainC : Id (V1.Ix (B2Q.tob K tt)) TBB.res (CV.C2[K.1, K.2, w', QC.DF.DM[K.1, K.2, w', CV.C1[K.1, K.2, w', d'].res].res].res) =
     transH tbIrr (transH N3.law
      (apH {QC.DF.DB.TOb' K.1 K.2 w'} {V1.Ix (B2Q.tob K tt)} (\ b -> CV.C2[K.1, K.2, w', b].res)
        (transH (symH m2) (apH {QC.DF.DA.TOb' K.1 K.2 w'} {QC.DF.DB.TOb' K.1 K.2 w'} (\ a0 -> QC.DF.DM[K.1, K.2, w', a0].res) N1.law)))) ;
    law (e : Id (V1.Ix (G1.fibCwF-T.nil.ob K)) (G1.fibCwF-T.nil.act K J g tt) tt)
     : Id (V1.Ix (Q.1.tob K tt)) (Q.1.tact K J g tt tt e (Gf J w d)) (Gf K w' d') =
     transH (G1.GB.GPre[a+].PS.tact-irr G1.fibCwF-T.nil Q.1 K J g tt tt e (refl tt) (Gf J w d))
      (transH (symH (G1.GB.GPre[a+].TyL[CT.P1, Q.1].pr-inj K tt _ _ (TI.inv.mnat K J g (tt, cJ))))
        (apH {V1.Ix (B2Q.tob K tt)} {V1.Ix (Q.1.tob K tt)} (\ c -> (TI.inv.mE K (tt, c)).2) chainC)) ;
   } ;
   -- the inverse as an element of Pi's fibre at (W, y) over the identity point
   module PI (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) {
    I0 : CT.TC.TOb = (W, y) ;
    module PC = DA0.PE.PC ;
    pt : PC.Pt I0 = PC.ptOf I0 (DA0.idy W) ;
    wqf (K : CT.TC.TOb) (f : CT.TC.THm K I0) : CV.DQc.Ob' K.1 K.2 = CV.DQc.tau K.1 K.2 (QC.qact K.1 W f.1 psi) ;
    tEf (K : CT.TC.TOb) (f : CT.TC.THm K I0) (v : V1.Ix (A.1.tob K (pt K f))) : DE.Ob' K.1 K.2 = DE.tau K.1 K.2 (pt K f, v) ;
    d1f (K : CT.TC.TOb) (f : CT.TC.THm K I0) (v : V1.Ix (A.1.tob K (pt K f))) : CV.DYu.Ob' K.1 K.2 = DI.invP.nt K (tEf K f v) ;
    fun (K : CT.TC.TOb) (f : CT.TC.THm K I0) (v : V1.Ix (A.1.tob K (pt K f))) : V1.Ix (Q.1.tob K tt) = Gf K (wqf K f) (d1f K f v) ;
    module NT (J K : CT.TC.TOb) (f : CT.TC.THm J I0) (g : CT.TC.THm K J) (av : V1.Ix (A.1.tob J (pt J f))) {
     fg : CT.TC.THm K I0 = CT.TC.TotCat.oC K J I0 f g ;
     a' : V1.Ix (A.1.tob K (pt K fg)) = PC.AactOf I0 pt (PC.cOf I0 (DA0.idy W)) J K f g av ;
     module GNm = GN[J, K, g, wqf J f, d1f J f av] ;
     eW : Id (CV.DQc.Ob' K.1 K.2) GNm.w' (wqf K fg) =
      transH (symH (CV.DQc.tau-nat K.1 J.1 g.1 K.2 J.2 g.2 (QC.qact J.1 W f.1 psi)))
       (apH {V1.Ix (QC.Qc.ob K.1 K.2)} {CV.DQc.Ob' K.1 K.2} (CV.DQc.tau K.1 K.2) (symH (QC.Qc.act-o K.1 J.1 W f.1 g.1 K.2 J.2 y f.2 g.2 psi))) ;
     eD : Id (CV.DYu.Ob' K.1 K.2) GNm.d' (d1f K fg a') =
      transH (symH (DI.invP.nt-nat K J g (tEf J f av)))
       (apH {DE.Ob' K.1 K.2} {CV.DYu.Ob' K.1 K.2} (DI.invP.nt K)
         (transH (symH (DE.tau-nat K.1 J.1 g.1 K.2 J.2 g.2 (pt J f, av)))
           (apH {V1.Ix (E.ob K)} {DE.Ob' K.1 K.2} (DE.tau K.1 K.2) (PC.eOf I0 (DA0.idy W) J K f g av)))) ;
     law : Id (V1.Ix (Q.1.tob K tt)) (PC.BactOf I0 pt (PC.cOf I0 (DA0.idy W)) (PC.eOf I0 (DA0.idy W)) J K f g av (fun J f av)) (fun K fg a') =
      transH (GNm.law (G1.GB.GPre[a+].PS.ntEq (G1.fibCwF-T.ext LA.PYy A) G1.fibCwF-T.nil (G1.fibCwF-T.eps (G1.fibCwF-T.ext LA.PYy A)) K J g
               (pt J f, av) (pt K fg, a') (PC.eOf I0 (DA0.idy W) J K f g av)))
       (transH (apH {CV.DQc.Ob' K.1 K.2} {V1.Ix (Q.1.tob K tt)} (\ w0 -> Gf K w0 GNm.d') eW)
         (apH {CV.DYu.Ob' K.1 K.2} {V1.Ix (Q.1.tob K tt)} (\ d0 -> Gf K (wqf K fg) d0) eD)) ;
    } ;
    elt : V1.Ix (DA0.piTob W tt) = (fun, \ J K f g a0 -> NT[J, K, f, g, a0].law) ;
   } ;
   -- naturality in the stage: the inverse is a map of closed types
   module WN (W' W : Ob) (h : Hom W' W) (psi : V1.Ix (DA0.qTob W tt)) {
    psi' : V1.Ix (DA0.qTob W' tt) = DA0.qTact W' W h tt tt (refl tt) psi ;
    module P1 = PI[W, psi] ;
    module P2 = PI[W', psi'] ;
    module PC = DA0.PE.PC ;
    I0 : CT.TC.TOb = (W, y) ;
    Jy : CT.TC.TOb = (W', y) ;
    g0 : CT.TC.THm Jy I0 = (h, CM.IC.cart W' W h y) ;
    substC (K : CT.TC.TOb) (w1 w2 : PC.Pts K) (p : Id (PC.Pts K) w1 w2) (b : V1.Ix (Q.1.tob K tt))
     : Id (V1.Ix (Q.1.tob K tt)) (subst (PC.Pts K) (\ z -> PC.FB K z) w1 w2 p b) b =
     idJ (PC.Pts K) w1 (\ w3 p3 -> Id (V1.Ix (Q.1.tob K tt)) (subst (PC.Pts K) (\ z -> PC.FB K z) w1 w3 p3 b) b) (refl b) w2 p ;
    module At (K : CT.TC.TOb) (f : CT.TC.THm K Jy) (av : V1.Ix (A.1.tob K (P2.pt K f))) {
     hf : CT.TC.THm K I0 = CT.TC.TotCat.oC K Jy I0 g0 f ;
     ppt : Id (V1.Ix (LA.PYy.ob K)) (LA.PYy.act K I0 hf (DA0.idy W)) (LA.PYy.act K Jy f (DA0.idy W')) = PC.piPt Jy I0 g0 (DA0.idy W) (DA0.idy W') (DA0.idyR W' W h) K f ;
     bv : V1.Ix (A.1.tob K (P1.pt K hf)) = DA0.PE.bk K (LA.PYy.act K I0 hf (DA0.idy W)) (LA.PYy.act K Jy f (DA0.idy W')) ppt av ;
     pq0 : Id (PC.Pts K) (P1.pt K hf, bv) (P2.pt K f, av) = DA0.PE.pp K (LA.PYy.act K I0 hf (DA0.idy W)) (LA.PYy.act K Jy f (DA0.idy W')) ppt av ;
     law : Id (V1.Ix (Q.1.tob K tt)) (subst (PC.Pts K) (\ z -> PC.FB K z) (P1.pt K hf, bv) (P2.pt K f, av) pq0 (P1.fun K hf bv)) (P2.fun K f av) =
      transH (substC K (P1.pt K hf, bv) (P2.pt K f, av) pq0 (P1.fun K hf bv))
       (transH (apH {CV.DQc.Ob' K.1 K.2} {V1.Ix (Q.1.tob K tt)} (\ w0 -> Gf K w0 (P1.d1f K hf bv))
                  (apH {V1.Ix (QC.Qc.ob K.1 K.2)} {CV.DQc.Ob' K.1 K.2} (CV.DQc.tau K.1 K.2) (QC.Qc.act-o K.1 W' W h f.1 K.2 y y g0.2 f.2 psi)))
         (apH {V1.Ix (E.ob K)} {V1.Ix (Q.1.tob K tt)} (\ e0 -> Gf K (P2.wqf K f) (DI.invP.nt K (DE.tau K.1 K.2 e0))) pq0)) ;
    } ;
    law : Id (V1.Ix (DA0.piTob W' tt)) (DA0.piTact W' W h tt tt (refl tt) P1.elt) P2.elt =
     PC.piCode-eq Jy P2.pt (PC.cOf Jy (DA0.idy W')) (PC.eOf Jy (DA0.idy W')) (DA0.piTact W' W h tt tt (refl tt) P1.elt) P2.elt
      (\ K f av -> At[K, f, av].law) ;
   } ;
   invE (W : Ob) (w : L.SigT LA.Nl DA0.QC W) : L.SigT LA.Nl DA0.PiC W = (w.1, PI[W, w.2].elt) ;
   inv : PB.CPartial[a+].PMap[LA.Nl, DA0.QC, DA0.PiC] =
    PB.CPartial[a+].mkPMap LA.Nl DA0.QC DA0.PiC invE (\ W w -> refl w.1)
     (\ Vv W g w -> apH {V1.Ix (DA0.piTob Vv tt)} {L.SigT LA.Nl DA0.PiC Vv} (\ ph -> (LA.Nl.act Vv W g w.1, ph)) (symH (WN[Vv, W, g, w.2].law))) ;
   module Vl (W : Ob) (psi : V1.Ix (DA0.qTob W tt)) (K : CT.TC.TOb) (f : CT.TC.THm K (W, y)) (v : V1.Ix (A.1.tob K (LA.PYy.act K (W, y) f (DA0.idy W)))) {
    e : V1.Ix (E.ob K) = (LA.PYy.act K (W, y) f (DA0.idy W), v) ;
    tE : DE.Ob' K.1 K.2 = DE.tau K.1 K.2 e ;
    d1 : CV.DYu.Ob' K.1 K.2 = DI.invP.nt K tE ;
    psiK : V1.Ix (QC.Qc.ob K.1 K.2) = QC.qact K.1 W f.1 psi ;
    wq : CV.DQc.Ob' K.1 K.2 = CV.DQc.tau K.1 K.2 psiK ;
    a1 : QC.DF.DA.TOb' K.1 K.2 wq = CV.C1[K.1, K.2, wq, d1].res ;
    b1 : QC.DF.DB.TOb' K.1 K.2 wq = QC.DF.DM[K.1, K.2, wq, a1].res ;
    c1 : V1.Ix (B2Q.tob K tt) = CV.C2[K.1, K.2, wq, b1].res ;
    val : V1.Ix (Q.1.tob K tt) = (TI.inv.mE K (tt, c1)).2 ;
   } ;
  } ;
 } ;
} ;
