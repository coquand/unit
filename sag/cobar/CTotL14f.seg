-- CTotL14f.seg (canonicity-45; SIMPLIFIED.md step 4): Lemma 14 at the
-- total site, part f: m and the homotopies from lines, at the levelwise site.
--   weights   the families (1, i), (t, i), (1, t /\ i) and their laws
--             (base-level, as in Lemma14.seg)
--   MWN.nat   MW is natural along a levelwise map (path induction on its
--             equation; reindexing along a cartesian lift commutes with
--             consId: part d)
--   mN        m : U B -> U B, MW at the weight (1, i)
--   LN, LP    a homotopy al ~ be from the line j |-> MW at weight t = j
--             (given its two ends)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module PFO = PosFull[a] ;
module Wt = Weights[a, l] ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;

------------------------------------------------------------------
-- the weight families (base-level)
-- restriction of consOne i is consOne of the restriction
consOne-res (n : Nat) (J'' J' : Ob) (h : Hom J'' J') (i : Wt.Pn n J')
 : Id (Wt.Pn (suc n) J'') (Wt.Res[suc n, J'', J', h, Wt.consOne n J' i.1].res) (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1) =
 Sigma-eq (Wt.Coords (suc n) J'') (\ cs -> PB.Lands J'' J'' (Wt.oneS (suc n) J'' cs) (PB.idH J''))
  (Wt.Res[suc n, J'', J', h, Wt.consOne n J' i.1].res).1 (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1).1
  (Wt.Res[suc n, J'', J', h, Wt.consOne n J' i.1].res).2 (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1).2
  (funext (Ar.Fin (suc (suc n))) (\ k -> Hom J'' PFO.ivO)
     (Wt.Res[suc n, J'', J', h, Wt.consOne n J' i.1].res).1 (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1).1
     (\ k -> transH (Wt.cons-res n J'' J' h (PB.ptH J' PB.e1) i.1 k)
               (apH (\ jj -> Wt.consC n J'' jj (Wt.resC n J'' J' h i.1) k) (PB.ptH-nat J'' J' h PB.e1))))
  (PB.isProp-Lands J'' J'' (Wt.oneS (suc n) J'' (Wt.consOne n J'' (Wt.Res[n, J'', J', h, i].res).1).1) (PB.idH J'')) ;

-- consOne of a face is the face (k+1) of consOne
consOne-face (n : Nat) (J : Ob) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (suc n)) J) (Wt.consOne (suc n) J (Wt.Face[n, J, k, hk].Of[i].face).1) (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face) =
 Sigma-eq (Wt.Coords (suc (suc n)) J) (\ cs -> PB.Lands J J (Wt.oneS (suc (suc n)) J cs) (PB.idH J))
  (Wt.consOne (suc n) J (Wt.Face[n, J, k, hk].Of[i].face).1).1 (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face).1
  (Wt.consOne (suc n) J (Wt.Face[n, J, k, hk].Of[i].face).1).2 (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face).2
  (funext (Ar.Fin (suc (suc (suc n)))) (\ m -> Hom J PFO.ivO)
     (Wt.consOne (suc n) J (Wt.Face[n, J, k, hk].Of[i].face).1).1 (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face).1
     (\ m -> symH (Wt.FaceCons[n, J, k, hk, PB.ptH J PB.e1, i.1].coord m)))
  (PB.isProp-Lands J J (Wt.oneS (suc (suc n)) J (Wt.Face[suc n, J, suc k, hk].Of[Wt.consOne n J i.1].face).1) (PB.idH J)) ;
WfOne (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) : Wt.Pn (suc n) J = Wt.consOne n J i.1 ;
WresOne (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, WfOne n J t i].res) (WfOne n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)) =
 consOne-res n J' J h i ;
WfaceOne (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (suc n)) J) (WfOne (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[WfOne n J t i].face) =
 consOne-face n J k hk i ;
pnEq (n : Nat) (J : Ob) (p p' : Wt.Pn n J) (H : (k : Ar.Fin (suc n)) -> Id (Hom J PFO.ivO) (p.1 k) (p'.1 k)) : Id (Wt.Pn n J) p p' =
 Sigma-eq (Wt.Coords n J) (\ cs -> PB.Lands J J (Wt.oneS n J cs) (PB.idH J)) p.1 p'.1 p.2 p'.2
  (funext (Ar.Fin (suc n)) (\ k -> Hom J PFO.ivO) p.1 p'.1 H)
  (PB.isProp-Lands J J (Wt.oneS n J p'.1) (PB.idH J)) ;
coEq (n : Nat) (J : Ob) (c c' : Wt.Coords n J) (H : (k : Ar.Fin (suc n)) -> Id (Hom J PFO.ivO) (c k) (c' k)) : Id (Wt.Coords n J) c c' =
 funext (Ar.Fin (suc n)) (\ k -> Hom J PFO.ivO) c c' H ;

WfCons (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) : Wt.Pn (suc n) J = Wt.ConsP[n, J, t, i].consP ;
WresCons (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, WfCons n J t i].res) (WfCons n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)) =
 pnEq (suc n) J' _ _ (\ k -> Wt.cons-res n J' J h t i.1 k) ;
WfaceCons (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (suc n)) J) (WfCons (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[WfCons n J t i].face) =
 pnEq (suc (suc n)) J _ _ (\ m -> symH (Wt.FaceCons[n, J, k, hk, t, i.1].coord m)) ;

WfMeet (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) : Wt.Pn (suc n) J = Wt.consOne n J (Wt.meetC n J t i.1) ;
WresMeet (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, WfMeet n J t i].res) (WfMeet n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)) =
 pnEq (suc n) J' _ _ (\ k ->
  transH (Wt.cons-res n J' J h (PB.ptH J PB.e1) (Wt.meetC n J t i.1) k)
   (transH (apH (\ jj -> Wt.consC n J' jj (Wt.resC n J' J h (Wt.meetC n J t i.1)) k) (PB.ptH-nat J' J h PB.e1))
     (apH {Wt.Coords n J'} {Hom J' PFO.ivO} (\ cc -> Wt.consC n J' (PB.ptH J' PB.e1) cc k)
        (coEq n J' (Wt.resC n J' J h (Wt.meetC n J t i.1)) (Wt.meetC n J' (PB.compH J' J PFO.ivO t h) (Wt.resC n J' J h i.1))
           (\ m -> Wt.meet-res n J' J h t i.1 m))))) ;
WfaceMeet (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
 : Id (Wt.Pn (suc (suc n)) J) (WfMeet (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[WfMeet n J t i].face) =
 pnEq (suc (suc n)) J _ _ (\ m ->
  transH (apH {Wt.Coords (suc n) J} {Hom J PFO.ivO} (\ cc -> Wt.consC (suc n) J (PB.ptH J PB.e1) cc m)
            (coEq (suc n) J (Wt.meetC (suc n) J t (Wt.Face[n, J, k, hk].faceC i.1)) (Wt.Face[n, J, k, hk].faceC (Wt.meetC n J t i.1))
               (\ m' -> symH (Wt.MeetFace[n, J, k, hk, t, i.1].coord m'))))
   (symH (Wt.FaceCons[n, J, k, hk, PB.ptH J PB.e1, Wt.meetC n J t i.1].coord m))) ;


module L14f (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LB = CTotL14b[a, vl, l].L14b[C, G, A] ;
 module LC = CTotL14c[a, vl, l].L14c[C, G, A] ;
 module LD = CTotL14d[a, vl, l].L14d[C] ;
 module ME = CTotL14e[a, vl, l].L14e[C, G, A] ;
 module TC = LB.TC ;
 module P = LB.P ;
 module VT = LB.VT ;
 module DA = LB.DA ;
 module D = LB.D ;
 module TR = LB.TR ;
 module G0 = TR.G0 ;
 module HO = LB.HO ;
 module GP0 = G0.GB.GPre[l] ;
 GP : P.PCtx = LB.GP ;
 Obj (I : Ob) : U vl = VT.Obj I ;

 ------------------------------------------------------------------
 -- MW is natural along levelwise maps
 module MWN (Wf : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (I : Ob) (x : Obj I) (g : W0.Ix (G.ob I x)) (u : DA.TOb' I x (D.tau I x g)) (t : Hom I PFO.ivO) (J' : Ob) (v : Hom J' I) {
  module M = ME.MW[Wf, Wres, Wface, I, x, g, u, t] ;
  y : Obj J' = C.res J' I v x ;
  g0 : VT.VMap J' y (C.res J' I v x) = VT.vpart J' I v y x (C.cart J' I v x) ;
  module B0 (g3 : W0.Ix (G.ob J' y)) (e03 : Id (D.Ob' J' y) (D.act J' I v y x (C.cart J' I v x) (D.tau I x g)) (D.tau J' y g3)) {
   module TBm = DA.TB[J', I, v, y, x, C.cart J' I v x, D.tau I x g, D.tau J' y g3, e03, M.res] ;
   module TBu = DA.TB[J', I, v, y, x, C.cart J' I v x, D.tau I x g, D.tau J' y g3, e03, u] ;
   module M' = ME.MW[Wf, Wres, Wface, J', y, g3, TBu.res, PB.compH J' I PFO.ivO t v] ;
   idx (q : DA.Idx J' y) (l : DA.LandsI J' y q)
    : Id (DA.Ez q.2.1 q.2.2.2.1)
         (M.rr q.1 q.2.1 (compH q.2.1 J' I v q.2.2.1) q.2.2.2.1
            (ME.KJ[q.2.1].CI.consId q.1 (C.res q.2.1 I (compH q.2.1 J' I v q.2.2.1) x) q.2.2.2.1 (LB.TA.DO.CT.rxM q.2.1 J' I q.2.2.1 v y x g0 q.1 q.2.2.2.1 q.2.2.2.2.1))
            (M.wq (TBm.sh q) l))
         (M.rr q.1 q.2.1 (compH q.2.1 J' I v q.2.2.1) q.2.2.2.1
            (LB.TA.DO.CT.rxM q.2.1 J' I q.2.2.1 v y x g0 (suc q.1) q.2.2.2.1 (ME.KJ[q.2.1].CI.consId q.1 (C.res q.2.1 J' q.2.2.1 y) q.2.2.2.1 q.2.2.2.2.1))
            (M'.wq q l)) =
    transH (apH {ME.KJ[q.2.1].K.Ch (suc q.1) (C.res q.2.1 I (compH q.2.1 J' I v q.2.2.1) x) q.2.2.2.1} {DA.Ez q.2.1 q.2.2.2.1}
              (\ cc -> M.rr q.1 q.2.1 (compH q.2.1 J' I v q.2.2.1) q.2.2.2.1 cc (M.wq (TBm.sh q) l))
              (symH (LD.rxM-cart q.2.1 J' I q.2.2.1 v x q.1 q.2.2.2.1 q.2.2.2.2.1)))
     (apH {Hom q.2.1 PFO.ivO} {DA.Ez q.2.1 q.2.2.2.1}
        (\ t' -> M.rr q.1 q.2.1 (compH q.2.1 J' I v q.2.2.1) q.2.2.2.1
                   (LB.TA.DO.CT.rxM q.2.1 J' I q.2.2.1 v y x g0 (suc q.1) q.2.2.2.1 (ME.KJ[q.2.1].CI.consId q.1 (C.res q.2.1 J' q.2.2.1 y) q.2.2.2.1 q.2.2.2.2.1))
                   (Wf q.1 q.2.1 t' (q.2.2.2.2.2, l)))
        (symH (PB.comp-assoc q.2.1 J' I PFO.ivO t v q.2.2.1))) ;
   law : Id (DA.TOb' J' y (D.tau J' y g3)) TBm.res M'.res =
    DA.tob-eq J' y (D.tau J' y g3) TBm.res M'.res (\ q l ->
     DA.pr-inj q.2.1 q.2.2.2.1 ((D.tau J' y g3).1 q l) (TBm.a' q l) (M'.mv q l)
      (transH (TBm.pc q l)
        (transH (M.mpc (TBm.sh q) l)
          (transH (idx q l)
            (transH (symH (TBu.pc (M'.i1 q l) (M'.l1 q l)))
              (symH (M'.mpc q l))))))) ;
  } ;
  nat (y2 : Obj J') (p2 : Id (Obj J') y y2) (g' : W0.Ix (G.ob J' y2))
   (e0 : Id (D.Ob' J' y2) (D.act J' I v y2 x (LC.fp J' I v x y2 p2) (D.tau I x g)) (D.tau J' y2 g'))
   : Id (DA.TOb' J' y2 (D.tau J' y2 g'))
        (DA.TB[J', I, v, y2, x, LC.fp J' I v x y2 p2, D.tau I x g, D.tau J' y2 g', e0, M.res].res)
        (ME.MW[Wf, Wres, Wface, J', y2, g', DA.TB[J', I, v, y2, x, LC.fp J' I v x y2 p2, D.tau I x g, D.tau J' y2 g', e0, u].res, PB.compH J' I PFO.ivO t v].res) =
   idJ (Obj J') y
    (\ y3 p3 -> (g3 : W0.Ix (G.ob J' y3))
       (e03 : Id (D.Ob' J' y3) (D.act J' I v y3 x (LC.fp J' I v x y3 p3) (D.tau I x g)) (D.tau J' y3 g3))
       -> Id (DA.TOb' J' y3 (D.tau J' y3 g3))
             (DA.TB[J', I, v, y3, x, LC.fp J' I v x y3 p3, D.tau I x g, D.tau J' y3 g3, e03, M.res].res)
             (ME.MW[Wf, Wres, Wface, J', y3, g3, DA.TB[J', I, v, y3, x, LC.fp J' I v x y3 p3, D.tau I x g, D.tau J' y3 g3, e03, u].res, PB.compH J' I PFO.ivO t v].res))
    (\ g3 e03 -> B0[g3, e03].law)
    y2 p2 g' e0 ;
 } ;
 ------------------------------------------------------------------
 -- m : U B -> U B
 mN : HO.NMap[LB.UG, LB.UB, LB.UB] =
  new HO.NMap[LB.UG, LB.UB, LB.UB, \ X g u -> ME.MW[WfOne, WresOne, WfaceOne, X.1, X.2, g, u, PB.ptH X.1 PB.e1].res,
   \ Y X h g g' e u ->
    transH (MWN[WfOne, WresOne, WfaceOne, X.1, X.2, g, u, PB.ptH X.1 PB.e1, Y.1, h.1].nat Y.2 (symH h.2) g'
              (P.ntEq GP (TC.toP D.DCtx) (TC.toPS G D.DCtx D.tauS) Y X (TR.DS.fnH Y X h) g g' e))
     (apH {Hom Y.1 PFO.ivO} {DA.TOb' Y.1 Y.2 (D.tau Y.1 Y.2 g')}
        (\ t' -> ME.MW[WfOne, WresOne, WfaceOne, Y.1, Y.2, g', LB.UB.tact Y X h g g' e u, t'].res)
        (PB.ptH-nat Y.1 X.1 h.1 PB.e1))] ;

 ------------------------------------------------------------------
 -- MW read in the total space of U B
 module LN (Wf : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face)) {
  module TX = GP0.TyL[LB.UG, LB.UB] ;
  mwe (W : G0.TOb) (w : TX.EI W) (j : Hom W.1 PFO.ivO) : TX.EI W =
   TX.pr W (TX.pr1 W w) (ME.MW[Wf, Wres, Wface, W.1, W.2, TX.pr1 W w, TX.pr2 W w, j].res) ;
  mwe-act (V W : G0.TOb) (g : G0.THm V W) (w : TX.EI W) (j : Hom W.1 PFO.ivO)
   : Id (TX.EI V) (TX.E.act V W g (mwe W w j)) (mwe V (TX.E.act V W g w) (PB.compH V.1 W.1 PFO.ivO j g.1)) =
   transH (TX.pr-tact V W g (TX.pr1 W w) (LB.UG.act V W g (TX.pr1 W w)) (refl (LB.UG.act V W g (TX.pr1 W w)))
             (ME.MW[Wf, Wres, Wface, W.1, W.2, TX.pr1 W w, TX.pr2 W w, j].res))
    (apH {DA.TOb' V.1 V.2 (D.tau V.1 V.2 (LB.UG.act V W g (TX.pr1 W w)))} {TX.EI V} (TX.pr V (LB.UG.act V W g (TX.pr1 W w)))
       (MWN[Wf, Wres, Wface, W.1, W.2, TX.pr1 W w, TX.pr2 W w, j, V.1, g.1].nat V.2 (symH g.2) (LB.UG.act V W g (TX.pr1 W w))
          (P.ntEq GP (TC.toP D.DCtx) (TC.toPS G D.DCtx D.tauS) V W (TR.DS.fnH V W g) (TX.pr1 W w) (LB.UG.act V W g (TX.pr1 W w)) (refl (LB.UG.act V W g (TX.pr1 W w)))))) ;
 } ;

 -- a homotopy al ~ be whose line at (gamma, u) is j |-> MW at j, given its ends
 module LP (Wf : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (i : Wt.Pn n J) -> Wt.Pn (suc n) J)
  (Wres : (n : Nat) (J' J : Ob) (h : Hom J' J) (t : Hom J PFO.ivO) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc n) J') (Wt.Res[suc n, J', J, h, Wf n J t i].res) (Wf n J' (PB.compH J' J PFO.ivO t h) (Wt.Res[n, J', J, h, i].res)))
  (Wface : (n : Nat) (J : Ob) (t : Hom J PFO.ivO) (k : Nat) (hk : Tr.IsT (Tr.leb k (suc n))) (i : Wt.Pn n J)
     -> Id (Wt.Pn (suc (suc n)) J) (Wf (suc n) J t (Wt.Face[n, J, k, hk].Of[i].face)) (Wt.Face[suc n, J, suc k, hk].Of[Wf n J t i].face))
  (al be : HO.NMap[LB.UG, LB.UB, LB.UB])
  (en0 : (X : G0.TOb) (z : W0.Ix ((LB.RS.P0.extP LB.UG LB.UB).ob X))
     -> Id (GP0.TyL[LB.UG, LB.UB].EI X) (LN[Wf, Wres, Wface].mwe X z (PB.ptH X.1 PB.e0)) (HO.HT[LB.UG, LB.UB, LB.UB, al, be].aE X z))
  (en1 : (X : G0.TOb) (z : W0.Ix ((LB.RS.P0.extP LB.UG LB.UB).ob X))
     -> Id (GP0.TyL[LB.UG, LB.UB].EI X) (LN[Wf, Wres, Wface].mwe X z (PB.ptH X.1 PB.e1)) (HO.HT[LB.UG, LB.UB, LB.UB, al, be].bE X z)) {
  module H = HO.HT[LB.UG, LB.UB, LB.UB, al, be] ;
  module LNx = LN[Wf, Wres, Wface] ;
  module TX = LNx.TX ;
  module EL = GP0.PshL[TX.E] ;
  val (X : G0.TOb) (z : W0.Ix (H.GA.ob X)) (W : G0.TOb) (f : G0.THm W X) (j : Hom W.1 PFO.ivO) : TX.EI W = LNx.mwe W (TX.E.act W X f z) j ;
  path (X : G0.TOb) (z : W0.Ix (H.GA.ob X)) : W0.Ix (H.PT.tobP X z) =
   H.PT.mkPath X z (val X z)
    (\ V W g f j -> transH (LNx.mwe-act V W g (TX.E.act W X f z) j) (apH {TX.EI V} {TX.EI V} (\ w -> LNx.mwe V w (PB.compH V.1 W.1 PFO.ivO j g.1)) (EL.actC V W X f g z)))
    (\ W f j -> refl (LB.UG.act W X f (TX.pr1 X z)))
    (transH (apH {TX.EI X} {TX.EI X} (\ w -> LNx.mwe X w (PB.ptH X.1 PB.e0)) (EL.actId X (G0.GB.idH X) (refl (G0.GB.idH X)) z)) (en0 X z))
    (transH (apH {TX.EI X} {TX.EI X} (\ w -> LNx.mwe X w (PB.ptH X.1 PB.e1)) (EL.actId X (G0.GB.idH X) (refl (G0.GB.idH X)) z)) (en1 X z)) ;
  enat (J I : G0.TOb) (h : G0.THm J I) (z : W0.Ix (H.GA.ob I)) (z' : W0.Ix (H.GA.ob J)) (e : Id (W0.Ix (H.GA.ob J)) (H.GA.act J I h z) z')
   : Id (W0.Ix (H.PT.tobP J z')) (H.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
   H.PT.path-eq J z' (H.PT.PathP.tact J I h z z' e (path I z)) (path J z')
    (\ V f j -> apH {TX.EI V} {TX.EI V} (\ w -> LNx.mwe V w j) (transH (symH (EL.actC V J I h f z)) (apH {TX.EI J} {TX.EI V} (TX.E.act V J f) e))) ;
  res : LB.RS.P0.PEl[H.GA, H.PT.PathP] = new LB.RS.P0.PEl[H.GA, H.PT.PathP, path, enat] ;
 } ;
} ;
