-- CwFHed1.seg (canonicity-c2; SIMPLIFIED.md item 3, toolkit for the
-- quotient's set-ness): a map between two families over G.A commutes with
-- transport, in a CwF with Pi, Sigma and Swan Id.
--
-- Informal text.  Let P Q be types over G.A, phi : P -> Q over G.A (an
-- element of Q weakened over G.A.P), x : A and v : P(x).  For y : A and
-- u : Id(x , y):
--     phi_y (trP P u v) = trP Q u (phi_x v).
-- Over the context Dx = G.A.Id(x , z) of J, JTP (CwFTr.JT, the transport
-- of v along the variable path) is a point of P, and phiJ = phi at JTP is a
-- point of Q; the motive is Id(phiJ , JTQ), JTQ the transport of phi_x v.
-- At any point instG y d of Dx, phiJ reads as phi_y of JTP's reading (At:
-- the two maps into G.A.P agree, IN.ext-eq).  At the centre both sides
-- read as phi_x v (JT-beta), so J gives the motive; read at (y , u) it is
-- the statement.
open Base ;

module Hed1 (l : Level) (C : CwF.CwF[l]) (PS : CwF.Formers[l, C].PiStr)
  (SS : CwF.Formers[l, C].SigStr) (IJ : CwFId.SwanId[l, C].IdJStr) {
  open Prelude[l] ;
  open C ;
  open CwFOv.Ov[l, C, PS, SS, IJ] ;
  module IN = CwFInt.Int[l, C, PS, SS, IJ] ;
  module JP = CwFJ.JPt[l, C, PS, SS, IJ] ;
  module TR = CwFTr.Tr[l, C, PS, SS, IJ] ;
  module SJ = CwFId.SwanId[l, C] ;
  module DJ = SJ.Der[IJ.IdT, IJ.IdT-nat, IJ.rfl] ;

  module L1 (G : Ctx) (A : Ty G) (x : El G A) (P Q : Ty (ext G A))
    (phi : El (ext (ext G A) P) (wkT (ext G A) P Q)) (v : El G (subT G (ext G A) P (sec G A x))) {
    GA : Ctx = ext G A ;
    GAP : Ctx = ext GA P ;
    IK : Ty GA = JP.IK G A x ;
    Dx : Ctx = JP.Dx G A x ;
    pD : Sub Dx GA = p GA IK ;
    CP : Ty Dx = TR.CMt G A x P ;
    CQ : Ty Dx = TR.CMt G A x Q ;
    WQ : Ty GAP = wkT GA P Q ;
    WP : Ty GAP = wkT GA P P ;
    -- phi at a point of P over the section of y
    phiAt (y : El G A) (w : El G (subT G GA P (sec G A y))) : El G (subT G GA Q (sec G A y)) =
      trE G (subT G GAP WQ (extS G GA P (sec G A y) w)) (subT G GA Q (sec G A y)) (IN.wkT-extS G GA P Q (sec G A y) w)
        (subt G GAP WQ phi (extS G GA P (sec G A y) w)) ;
    -- over Dx: the transport of v, and phi at it
    JTP : El Dx CP = TR.JT G A x P v ;
    sgm : Sub Dx GAP = extS Dx GA P pD JTP ;
    phiJ : El Dx CQ = trE Dx (subT Dx GAP WQ sgm) CQ (IN.wkT-extS Dx GA P Q pD JTP) (subt Dx GAP WQ phi sgm) ;
    JTQ : El Dx CQ = TR.JT G A x Q (phiAt x v) ;

    -- at a point of Dx, phiJ reads as phi of JTP's reading
    module At (y : El G A) (I' : Ty G) (PI : Id (Ty G) (subT G GA IK (sec G A y)) I') (d : El G I') {
      pt : Sub G Dx = JP.instG G A IK y I' PI d ;
      Py : Ty G = subT G GA P (sec G A y) ;
      Qy : Ty G = subT G GA Q (sec G A y) ;
      WPy : Id (Ty G) (subT G Dx CP pt) Py = JP.wT-inst G A IK y I' PI d P ;
      WQy : Id (Ty G) (subT G Dx CQ pt) Qy = JP.wT-inst G A IK y I' PI d Q ;
      jv : El G Py = trE G (subT G Dx CP pt) Py WPy (subt G Dx CP JTP pt) ;
      s1 : Sub G GAP = o G Dx GAP sgm pt ;
      s2 : Sub G GAP = extS G GA P (sec G A y) jv ;
      eP : Id (Sub G GA) (o G GAP GA (p GA P) s1) (o G GAP GA (p GA P) s2) =
        trans (Sub G GA) (o G GAP GA (p GA P) s1) (sec G A y) (o G GAP GA (p GA P) s2)
          (trans (Sub G GA) (o G GAP GA (p GA P) s1) (o G Dx GA (o Dx GAP GA (p GA P) sgm) pt) (sec G A y)
             (sym (Sub G GA) (o G Dx GA (o Dx GAP GA (p GA P) sgm) pt) (o G GAP GA (p GA P) s1) (o-assoc G Dx GAP GA (p GA P) sgm pt))
             (trans (Sub G GA) (o G Dx GA (o Dx GAP GA (p GA P) sgm) pt) (o G Dx GA pD pt) (sec G A y)
                (ap (Sub Dx GA) (Sub G GA) (\ t -> o G Dx GA t pt) (o Dx GAP GA (p GA P) sgm) pD (IN.p-extS Dx GA P pD JTP))
                (JP.p-inst G A IK y I' PI d)))
          (sym (Sub G GA) (o G GAP GA (p GA P) s2) (sec G A y) (IN.p-extS G GA P (sec G A y) jv)) ;
      PW0 : Id (Ty Dx) (subT Dx GAP WP sgm) CP = IN.wkT-extS Dx GA P P pD JTP ;
      P1 : Id (Ty G) (subT G GAP WP s1) Py =
        trans (Ty G) (subT G GAP WP s1) (subT G Dx (subT Dx GAP WP sgm) pt) Py
          (subT-o G Dx GAP WP sgm pt)
          (trans (Ty G) (subT G Dx (subT Dx GAP WP sgm) pt) (subT G Dx CP pt) Py
             (ap (Ty Dx) (Ty G) (\ X -> subT G Dx X pt) (subT Dx GAP WP sgm) CP PW0) WPy) ;
      q1 : Ov G GAP WP s1 Py P1 (q GA P) jv =
        JP.ovO G Dx GAP WP sgm pt CP PW0 Py WPy P1 (q GA P) JTP jv
          (JP.q-extS Dx GA P pD JTP PW0) (refl jv) ;
      P2 : Id (Ty G) (subT G GAP WP s2) Py = IN.wkT-extS G GA P P (sec G A y) jv ;
      q2 : Ov G GAP WP s2 Py P2 (q GA P) jv = JP.q-extS G GA P (sec G A y) jv P2 ;
      sEq : Id (Sub G GAP) s1 s2 = IN.ext-eq G GA P s1 s2 eP Py jv P1 q1 P2 q2 ;
      -- phiJ read at pt, through s1, then s2
      PQ1 : Id (Ty G) (subT G GAP WQ s1) Qy =
        trans (Ty G) (subT G GAP WQ s1) (subT G Dx (subT Dx GAP WQ sgm) pt) Qy
          (subT-o G Dx GAP WQ sgm pt)
          (trans (Ty G) (subT G Dx (subT Dx GAP WQ sgm) pt) (subT G Dx CQ pt) Qy
             (ap (Ty Dx) (Ty G) (\ X -> subT G Dx X pt) (subT Dx GAP WQ sgm) CQ (IN.wkT-extS Dx GA P Q pD JTP)) WQy) ;
      o1 : Ov G GAP WQ s1 Qy PQ1 phi (trE G (subT G Dx CQ pt) Qy WQy (subt G Dx CQ phiJ pt)) =
        JP.ovO G Dx GAP WQ sgm pt CQ (IN.wkT-extS Dx GA P Q pD JTP) Qy WQy PQ1 phi phiJ
          (trE G (subT G Dx CQ pt) Qy WQy (subt G Dx CQ phiJ pt)) (refl phiJ) (refl (trE G (subT G Dx CQ pt) Qy WQy (subt G Dx CQ phiJ pt))) ;
      law : Ov G Dx CQ pt Qy WQy phiJ (phiAt y jv) =
        trans (El G Qy) (trE G (subT G Dx CQ pt) Qy WQy (subt G Dx CQ phiJ pt))
          (trE G (subT G GAP WQ s1) Qy PQ1 (subt G GAP WQ phi s1)) (phiAt y jv)
          (sym (El G Qy) (trE G (subT G GAP WQ s1) Qy PQ1 (subt G GAP WQ phi s1)) (trE G (subT G Dx CQ pt) Qy WQy (subt G Dx CQ phiJ pt)) o1)
          (SJ.subtEq G GAP WQ phi s1 s2 sEq Qy PQ1 (IN.wkT-extS G GA P Q (sec G A y) jv)) ;
    } ;

    -- the motive and its base at the centre
    M : Ty Dx = IJ.IdT Dx CQ phiJ JTQ ;
    Qx : Ty G = subT G GA Q (sec G A x) ;
    module CN = At[x, TR.I0 G A x, refl (TR.I0 G A x), DJ.reflE G A x] ;
    jv0 : Id (El G (subT G GA P (sec G A x))) CN.jv v = TR.JT-beta G A x P v ;
    pa : Ov G Dx CQ (DJ.cen G A x) Qx CN.WQy phiJ (phiAt x v) =
      trans (El G Qx) (trE G (subT G Dx CQ (DJ.cen G A x)) Qx CN.WQy (subt G Dx CQ phiJ (DJ.cen G A x))) (phiAt x CN.jv) (phiAt x v)
        CN.law (ap (El G (subT G GA P (sec G A x))) (El G Qx) (\ w -> phiAt x w) CN.jv v jv0) ;
    pb : Ov G Dx CQ (DJ.cen G A x) Qx CN.WQy JTQ (phiAt x v) = TR.JT-beta G A x Q (phiAt x v) ;
    Mc : Id (Ty G) (subT G Dx M (DJ.cen G A x)) (IJ.IdT G Qx (phiAt x v) (phiAt x v)) =
      Id-ov G Dx CQ phiJ JTQ (DJ.cen G A x) Qx CN.WQy (phiAt x v) (phiAt x v) pa pb ;
    base : El G (subT G Dx M (DJ.cen G A x)) =
      trE G (IJ.IdT G Qx (phiAt x v) (phiAt x v)) (subT G Dx M (DJ.cen G A x))
        (sym (Ty G) (subT G Dx M (DJ.cen G A x)) (IJ.IdT G Qx (phiAt x v) (phiAt x v)) Mc) (IJ.rfl G Qx (phiAt x v)) ;
    E : El Dx M = IJ.J G A x M base ;

    -- read at (y , u)
    module Pt (y : El G A) (u : El G (IJ.IdT G A x y)) {
      module AY = At[y, IJ.IdT G A x y, JP.IKpt G A x y, u] ;
      tv : El G AY.Py = TR.trP G A P x y u v ;
      tq : El G AY.Qy = TR.trP G A Q x y u (phiAt x v) ;
      Mp : Id (Ty G) (subT G Dx M AY.pt) (IJ.IdT G AY.Qy (phiAt y tv) tq) =
        Id-ov G Dx CQ phiJ JTQ AY.pt AY.Qy AY.WQy (phiAt y tv) tq AY.law (refl tq) ;
      law : El G (IJ.IdT G AY.Qy (phiAt y tv) tq) = trE G (subT G Dx M AY.pt) (IJ.IdT G AY.Qy (phiAt y tv) tq) Mp (subt G Dx M E AY.pt) ;
    } ;
  } ;

  -- phi_y (trP P u v) = trP Q u (phi_x v)
  trP-map (G : Ctx) (A : Ty G) (x : El G A) (P Q : Ty (ext G A))
    (phi : El (ext (ext G A) P) (wkT (ext G A) P Q)) (v : El G (subT G (ext G A) P (sec G A x)))
    (y : El G A) (u : El G (IJ.IdT G A x y))
    : El G (IJ.IdT G (subT G (ext G A) Q (sec G A y)) (L1[G, A, x, P, Q, phi, v].phiAt y (TR.trP G A P x y u v)) (TR.trP G A Q x y u (L1[G, A, x, P, Q, phi, v].phiAt x v))) =
    L1[G, A, x, P, Q, phi, v].Pt[y, u].law ;
} ;
