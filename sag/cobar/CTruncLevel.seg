-- CTruncLevel.seg (canonicity-c2; SIMPLIFIED.md item 2): the normal
-- forms of the truncation of a closed small type, lifted one level.
--
-- A0 is a closed level-a type; Ap is the same type read at level a+
-- (the same elements).  A raw tree over (1 , A0) at level a is sent to
-- the raw tree over (1 , Ap) at level a+ with the same shape (liftRaw):
-- the two terminal contexts have the same points (Top), so both kinds of
-- trees have the same locations and arrows, and the lift only changes
-- the level of the tree type.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
open Trees[a] ; open Arith[a] ; open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GS = PB.GPre[a].PS ;
module L = PB.GPre[a+].PS ;

module Lift (A0 : GS.PTy[GS.nilP]) {
  -- the type read one level up: the same fibres and action
  sp : PB.CSmall.SPTy[L.nilP] = new PB.CSmall.SPTy[L.nilP, A0.tob, A0.tact, A0.tact-id, A0.tact-o] ;
  Ap : L.PTy[L.nilP] = PB.CSmall.up L.nilP sp ;
  module BP = CTruncRaw[a, a+].Build[L.nilP, Ap] ;
  -- the constructors of the level-a+ trees, by name (both instances have constructors leaf / node)
  module MP {
    open CTruncRaw[a, a+].Build[L.nilP, Ap] ;
    mkLeaf (z : Loc) (v : V1.Ix (Ap.tob z.1 z.2)) : Raw = leaf z v ;
    mkNode (z : Loc) (Q : PB.Phi z.1) (u : (s : Loc) -> Arr s z -> Raw)
      (v : (s : Loc) (h : Arr s z) -> PB.Lands s.1 z.1 Q h.1 -> Raw) : Raw = node z Q u v ;
  } ;
  module BA = CTruncRaw[a, a].Build[GS.nilP, A0] ;
  open CTruncRaw[a, a].Build[GS.nilP, A0] ;

  liftRaw : BA.Raw -> BP.Raw = split {
    leaf z v -> MP.mkLeaf z v ;
    node z Q u v | iu iv -> MP.mkNode z Q iu iv
  } ;
  lift-root : (t : BA.Raw) -> Id BP.Loc (BP.root (liftRaw t)) (BA.root t) = split {
    leaf z v -> refl z ;
    node z Q u v -> refl z
  } ;

  -- the lift commutes with deciding
  dmap : (b : Bool) (yes : IsT b -> BA.Raw) (no : Id Bool b false -> BA.Raw)
    -> Id BP.Raw (liftRaw (CTruncRaw[a, a].decide BA.Raw b yes no))
         (CTruncRaw[a, a+].decide BP.Raw b (\ i -> liftRaw (yes i)) (\ j -> liftRaw (no j))) = split {
    true -> \ yes no -> refl (liftRaw (yes (refl true))) ;
    false -> \ yes no -> refl (liftRaw (no (refl false)))
  } ;

  -- the lift commutes with restriction
  lift-restrict : (t : BA.Raw) (s : BA.Loc) (h : BA.Arr s (BA.root t))
    -> Id BP.Raw (liftRaw (BA.restrict t s h)) (BP.at (liftRaw t) (BA.root t) (lift-root t) s h) = split {
    leaf z v -> \ s h -> refl (liftRaw (BA.restrict (leaf z v) s h)) ;
    node z Q u v -> \ s h ->
      transH (dmap (CTruncRaw[a, a].dec s.1 z.1 Q h.1)
                (\ i -> v s h (CTruncRaw[a, a].toL s.1 z.1 Q h.1 i))
                (\ no -> node s (PB.pre s.1 z.1 h.1 Q) (\ r g -> u r (BA.compose r s z h g)) (\ r g i -> v r (BA.compose r s z h g) i)))
        (CTruncRaw[a, a+].decide-cong BP.Raw (CTruncRaw[a, a].dec s.1 z.1 Q h.1)
           (\ i -> liftRaw (v s h (CTruncRaw[a, a].toL s.1 z.1 Q h.1 i)))
           (\ i -> liftRaw (v s h (CTruncRaw[a, a+].toL s.1 z.1 Q h.1 i)))
           (\ no -> liftRaw (node s (PB.pre s.1 z.1 h.1 Q) (\ r g -> u r (BA.compose r s z h g)) (\ r g i -> v r (BA.compose r s z h g) i)))
           (\ no -> MP.mkNode s (PB.pre s.1 z.1 h.1 Q) (\ r g -> liftRaw (u r (BP.compose r s z h g))) (\ r g i -> liftRaw (v r (BP.compose r s z h g) i)))
           (\ i -> apH (\ j -> liftRaw (v s h j)) (PB.isProp-Lands s.1 z.1 Q h.1 (CTruncRaw[a, a].toL s.1 z.1 Q h.1 i) (CTruncRaw[a, a+].toL s.1 z.1 Q h.1 i)))
           (\ no -> refl (MP.mkNode s (PB.pre s.1 z.1 h.1 Q) (\ r g -> liftRaw (u r (BP.compose r s z h g))) (\ r g i -> liftRaw (v r (BP.compose r s z h g) i)))))
  } ;

  -- and with restriction at a propositionally equal root
  lift-at (t : BA.Raw) (z : BA.Loc) (e0 : Id BA.Loc (BA.root t) z) (ep : Id BP.Loc (BP.root (liftRaw t)) z) (r : BA.Loc) (g : BA.Arr r z)
    : Id BP.Raw (BP.at (liftRaw t) z ep r g) (liftRaw (BA.at t z e0 r g)) =
    idJ BA.Loc (BA.root t)
      (\ z2 e2 -> (ep2 : Id BP.Loc (BP.root (liftRaw t)) z2) (g2 : BA.Arr r z2)
         -> Id BP.Raw (BP.at (liftRaw t) z2 ep2 r g2) (liftRaw (BA.at t z2 e2 r g2)))
      (\ ep2 g2 -> transH (BP.at-irr (liftRaw t) (BA.root t) ep2 (lift-root t) r g2) (symH (lift-restrict t r g2)))
      z e0 ep g ;

  -- the lift of a well-formed tree is well-formed
  lift-good : (t : BA.Raw) -> BA.Good t -> BP.Good (liftRaw t) = split {
    leaf z v -> \ good -> tt ;
    node z Q u v | gu gv -> \ good ->
      (good.1,
       (\ s h -> (gu s h (good.2.1 s h).1, transH (lift-root (u s h)) (good.2.1 s h).2)),
       (\ s h i -> (gv s h i (good.2.2.1 s h i).1, transH (lift-root (v s h i)) (good.2.2.1 s h i).2)),
       (\ s h r g e -> transH (lift-at (u s h) s (good.2.1 s h).2 e r g)
                        (apH liftRaw (good.2.2.2.1 s h r g (good.2.1 s h).2))),
       (\ s h i r g j e -> transH (lift-at (v s h i) s (good.2.2.1 s h i).2 e r g)
                            (apH liftRaw (good.2.2.2.2 s h i r g j (good.2.2.1 s h i).2))))
  } ;

  -- on the well-formed trees at a location: the truncation's elements, one level up
  liftEl (z : BA.Loc) (t : BA.TrEl z) : BP.TrEl z =
    (liftRaw t.1, (lift-good t.1 t.2.1, transH (lift-root t.1) t.2.2)) ;
  -- natural in the location
  liftEl-nat (s z : BA.Loc) (h : BA.Arr s z) (t : BA.TrEl z)
    : Id (BP.TrEl s) (liftEl s (BA.tr-res s z h t)) (BP.tr-res s z h (liftEl z t)) =
    CTruncGood[a, a+].GoodSets[L.nilP, Ap].tr-eq s (liftEl s (BA.tr-res s z h t)) (BP.tr-res s z h (liftEl z t))
      (symH (lift-at t.1 z t.2.2 (transH (lift-root t.1) t.2.2) s h)) ;
} ;

-- Elimination of the decoding of a closed small truncation into a large
-- proposition P over any context G: lift the tree (Lift.liftEl), then the
-- level-a+ truncation's recursor into the pushforward of P along G -> 1,
-- untransposed.
module ElimUp (P0 : GS.PTy[GS.nilP]) (cT : PB.CFibCl.Cl GS.nilP CTrunc[a, a].Truncation[GS.nilP, P0].Ty)
  (G : L.PCtx) (P : L.PTy[G]) (kP : CTruncSeededBack[a, a+].Seeded[G, P].Op)
  (f : PB.CHtpyOps[a+].NMap[G, L.subTy G L.nilP Lift[P0].Ap (L.epsP G), P]) {
  module LF = Lift[P0] ;
  module TA = CTrunc[a, a].Truncation[GS.nilP, P0] ;
  module TP = CTrunc[a, a+].Truncation[L.nilP, LF.Ap] ;
  module CC = CClosedCode[a].Closed[TA.Ty, cT] ;
  Dt : L.PTy[G] = (CC.DecT G).1 ;
  eG : L.PSub[G, L.nilP] = L.epsP G ;
  Tp' : L.PTy[G] = L.subTy G L.nilP TP.Ty eG ;
  -- the decoding into the large truncation
  mu : PB.CHtpyOps[a+].NMap[G, Dt, Tp'] =
    new PB.CHtpyOps[a+].NMap[G, Dt, Tp', \ I x t -> LF.liftEl (I, tt) t,
      \ J I g x y e t ->
        transH (L.tact-irr L.nilP TP.Ty J I g tt tt (L.ntEq G L.nilP eG J I g x y e) (refl tt) (LF.liftEl (I, tt) t))
          (transH (symH (LF.liftEl-nat (J, tt) (I, tt) (g, refl tt) t))
            (apH (LF.liftEl (J, tt)) (symH (CC.dec-nat G J I g x y e t))))] ;
  module TPm = CTruncPushAdj[a, a+].Tp[G, L.nilP, eG, LF.Ap, P, f] ;
  module PA = CTruncPushAlg[a, a+].PushAlg[G, L.nilP, eG, P, kP] ;
  module RC = TP.Recursor[TPm.Pu.pushTy, PA.algebra, TPm.map] ;
  module UTm = CTruncPushAdj[a, a+].Ut[G, L.nilP, eG, TP.Ty, P, RC.map] ;
  elim : PB.CHtpyOps[a+].NMap[G, Dt, P] = PB.CHtpyOps[a+].compN G Dt Tp' P mu UTm.map ;
} ;
