-- CCopy6.seg (canonicity-45; SIMPLIFIED.md step 4, COBAR.md "Lemma 16"):
-- yo F1 is levelwise fibrant, for our C.  At a copy y the fibre of
-- U(yo F1) at I is the code set Fn[F1, y].M I, in natural bijection with
-- the fibre of HomT(F1, y) (CHomT11 alpha / CHomT8 beta, CHomT12/13 RT1 /
-- RT2, CHomT16 aNat), so HomT's fibration structure moves to the copy
-- (CCart.moveFib); the copies assemble (CCopy5.FibC).
-- Specific to this C (constant objects).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module YoF (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
 module BS = CCmpY[a].CmpBase[R, encK, pe] ;
 module CC = BS.CC ;
 module CM = BS.CM ;
 module TR = BS.TR ;
 module CT = BS.CT ;
 module FR = BS.FR ;
 module O1 = CT.Of[CM.Yo[FR.F1].yoT] ;
 GP : TR.P1.PCtx = BS.GP ;
 UG : TR.P0.PCtx = BS.UG ;
 UA1 : TR.P0.PTy[UG] = TR.RS.rT GP O1.Y1T ;
 Nl : L.PCtx = FibCwF[a, a+].fibCwF.nil ;
 module Cp (y : SX.Over[R].Presentation) {
  module Cy = CC.Copy[y] ;
  module P = CHomT4[a].P3[R, encK, pe, FR.F1, y] ;
  module FM = CHomT11[a].FromM[R, encK, pe, FR.F1, y] ;
  module TM = CHomT8[a].ToM[R, encK, pe, FR.F1, y] ;
  module NA = CHomT16[a].Nat[R, encK, pe, FR.F1, y] ;
  HT : FibCwF[a, a+].FC.STy Nl = P.H.HomT ;
  D : L.PCtx = Cy.rCy UG ;
  A' : L.PTy[D] = Cy.rTy UG UA1 ;
  module TA' = PB.GPre[a+].TyL[D, A'] ;
  module TA = PB.GPre[a+].TyL[Nl, HT.1] ;
  probe (I : Ob) (o : V1.Ix (D.ob I)) (m : V1.Ix (A'.tob I o)) : P.F.M I = m ;
  resEq (J I : Ob) (u : Hom J I) (o : V1.Ix (D.ob I)) (o' : V1.Ix (D.ob J)) (e : Id (V1.Ix (D.ob J)) (D.act J I u o) o') (m : V1.Ix (A'.tob I o))
   : Id (P.F.M J) (A'.tact J I u o o' e m) (P.F.res I J u m) =
   P.F.mExt J (A'.tact J I u o o' e m) (P.F.res I J u m) (refl (P.F.fpOf J (P.F.res I J u m))) ;
  s (W : Ob) (x : V1.Ix (D.ob W)) : V1.Ix (Nl.ob W) = tt ;
  snat (Vv W : Ob) (g : Hom Vv W) (d : V1.Ix (D.ob W)) : Id (V1.Ix (Nl.ob Vv)) (s Vv (D.act Vv W g d)) (Nl.act Vv W g (s W d)) = refl tt ;
  ta (W : Ob) (v : TA'.EI W) : TA.EI W = TA.pr W tt (FM.alpha W (TA'.pr2 W v)) ;
  tapt (W : Ob) (v : TA'.EI W) : Id (V1.Ix (Nl.ob W)) (TA.pr1 W (ta W v)) (s W (TA'.pr1 W v)) = refl tt ;
  tanat (Vv W : Ob) (g : Hom Vv W) (v : TA'.EI W) : Id (TA.EI Vv) (TA.E.act Vv W g (ta W v)) (ta Vv (TA'.E.act Vv W g v)) =
   apH {P.Z Vv} {TA.EI Vv} (TA.pr Vv tt)
    (symH (transH (apH {P.F.M Vv} {P.Z Vv} (FM.alpha Vv) (resEq Vv W g (TA'.pr1 W v) (D.act Vv W g (TA'.pr1 W v)) (refl (D.act Vv W g (TA'.pr1 W v))) (TA'.pr2 W v)))
                 (NA.aNat W Vv g (TA'.pr2 W v)))) ;
  minj (W : Ob) (m m' : P.F.M W) (Q : Id (P.Z W) (FM.alpha W m) (FM.alpha W m')) : Id (P.F.M W) m m' =
   transH (symH (CHomT12[a].RT1[R, encK, pe, FR.F1, y].At[W, m].rt))
    (transH (apH {P.Z W} {P.F.M W} (TM.beta W) Q) (CHomT12[a].RT1[R, encK, pe, FR.F1, y].At[W, m'].rt)) ;
  tainj (W : Ob) (v v' : TA'.EI W) (Pp : Id (V1.Ix (D.ob W)) (TA'.pr1 W v) (TA'.pr1 W v')) (Q : Id (TA.EI W) (ta W v) (ta W v')) : Id (TA'.EI W) v v' =
   idJ (V1.Ix (D.ob W)) (TA'.pr1 W v)
    (\ o2 P2 -> (m2 : V1.Ix (A'.tob W o2)) -> Id (P.Z W) (FM.alpha W (TA'.pr2 W v)) (FM.alpha W m2) -> Id (TA'.EI W) v (TA'.pr W o2 m2))
    (\ m2 Q2 -> apH {V1.Ix (A'.tob W (TA'.pr1 W v))} {TA'.EI W} (TA'.pr W (TA'.pr1 W v)) (minj W (TA'.pr2 W v) m2 Q2))
    (TA'.pr1 W v') Pp (TA'.pr2 W v') (TA.pr-inj W tt (FM.alpha W (TA'.pr2 W v)) (FM.alpha W (TA'.pr2 W v')) Q) ;
  bk (X : Ob) (x : V1.Ix (D.ob X)) (u : V1.Ix (HT.1.tob X (s X x))) : V1.Ix (A'.tob X x) = TM.beta X u ;
  bkta (X : Ob) (x : V1.Ix (D.ob X)) (u : V1.Ix (HT.1.tob X (s X x))) : Id (TA.EI X) (ta X (TA'.pr X x (bk X x u))) (TA.pr X (s X x) u) =
   apH {P.Z X} {TA.EI X} (TA.pr X tt) (CHomT13[a].RT2[R, encK, pe, FR.F1, y].At[X, u].rt) ;
  module CRT = PB.CCart[a+, a+].Cart[D, A', Nl, HT.1, s, snat, ta, tapt, tanat, tainj, bk, bkta] ;
  fib : PB.CLine[a+].Lines[D, A'].Fib = CRT.moveFib HT.2 ;
 } ;
 -- U(yo F1) is levelwise fibrant
 fibG0 : TR.G0.GB.CLine[a+].Lines[UG, UA1].Fib = CCopy5[a].FibC[R, encK, pe, UG, UA1, \ y -> Cp[y].fib].fib ;
} ;
