-- CTotPsi11.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 11, generic in the context G:
--   EP.EQ.Pq   the end of psi_q is the end of the line at q (the argument
--              of CTotPsi6, for any line of D G)
--   Pair       for a type A over G: the pairing of D G . D A into D (G.A)
--              (phi, natural by TB's reading: phiN) and its action on lines
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi11 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P3 = CTotPsi3[a, vl, l].Psi3[C, G] ;
 module P2 = P3.P2 ;
 module PO = P3.PO ;
 module TR = PO.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module TC = PO.TC ;
 module VT = PO.VT ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module XB = P3.XB ;
 module FG1 = P3.FG1 ;
 Obj (I : Ob) : U vl = VT.Obj I ;
 Ob0 : U vl = TR.RN.Ob0 ;

 module EP (X : TC.TOb) (ln : W0.Ix (PO.FL.ob X)) {
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  u0 : D.Ob' I x = ln.1 X (TC.tid X) (G1.GB.ptH X e) ;
  module EQ (n : Nat) (J : Ob) (u : Hom J I) (z : Obj J) (c : CT.Ch J n (C.res J I u x) z) (i : Wt.Pn n J) {
   module Q = P2.PQ[X, ln, n, J, u, z, c, i] ;
   Y : Ob0 = (J, z) ;
   q : DO.Idx I x = (n, J, u, z, c, i.1) ;
   pe : PB.IvP J = PB.ptH J e ;
   endq : W0.Ix (G.ob J z) = (FG1.ev e).nt Y Q.psiq ;
   id0 : TR.RN.Hom0 Y Y = G0.GB.BC.idC Y ;
   U1 : Hom J I = compH J J I u (idH J) ;
   cc1 : CT.Ch J n (C.res J I U1 x) (C.res J J (idH J) z) = DO.rCh J J I (idH J) u x n z c ;
   R1 : Wt.Pn n J = Wt.Res[n, J, J, idH J, i].res ;
   e' : Id (Obj J) (C.res J J (idH J) z) z = symH id0.2 ;
   -- the D-element's naturality along the identity, tail moved
   natT (y : Obj J) (e2 : Id (Obj J) (C.res J J (idH J) z) y)
    : Id (W0.Ix (G.ob J y)) (G.act J J (idH J) y z (VT.trD J J (idH J) (C.res J J (idH J) z) y e2 z (C.cart J J (idH J) z)) (u0.1 q i.2))
        (u0.1 (n, J, U1, y, subst (Obj J) (\ t -> CT.Ch J n (C.res J I U1 x) t) (C.res J J (idH J) z) y e2 cc1, R1.1) R1.2) =
    idJ (Obj J) (C.res J J (idH J) z)
     (\ y2 e3 -> Id (W0.Ix (G.ob J y2)) (G.act J J (idH J) y2 z (VT.trD J J (idH J) (C.res J J (idH J) z) y2 e3 z (C.cart J J (idH J) z)) (u0.1 q i.2))
        (u0.1 (n, J, U1, y2, subst (Obj J) (\ t -> CT.Ch J n (C.res J I U1 x) t) (C.res J J (idH J) z) y2 e3 cc1, R1.1) R1.2))
     (u0.2.1 (q, (J, idH J)) i.2) y e2 ;
   -- the identity of (J, z) acts trivially
   a1 : Id (W0.Ix (G.ob J z)) (PO.GP.act Y Y (TR.fn.onH Y Y id0) (u0.1 q i.2)) (u0.1 q i.2) =
    transH (apH {TC.THm Y Y} {W0.Ix (G.ob J z)} (\ k -> PO.GP.act Y Y k (u0.1 q i.2)) (TR.fn.onId Y)) (PO.GP.act-id Y (u0.1 q i.2)) ;
   -- the line read at cart U1 x is u0 at the moved index
   module R = PO.PL[X, ln].RC[n, J, z, U1, Q.cT J (idH J) z e', R1, pe] ;
   peX : PB.IvP I = PB.ptH I e ;
   g1 : Id (W0.Ix (PO.DG.ob R.Xv)) R.t (PO.DG.act R.Xv X R.f u0) =
    symH (transH (ln.2 R.Xv X R.f (TC.tid X) peX)
            (transH (apH {TC.THm R.Xv X} {W0.Ix (PO.DG.ob R.Xv)} (\ k -> ln.1 R.Xv k (PB.ivA J I U1 peX)) (G1.GB.BC.oC-idl R.Xv X R.f))
              (apH {PB.IvP J} {W0.Ix (PO.DG.ob R.Xv)} (\ jj -> ln.1 R.Xv R.f jj) (PB.ptH-nat J I U1 e)))) ;
   g2 : Id (W0.Ix (G.ob J z)) R.val (u0.1 (n, J, U1, z, Q.cT J (idH J) z e', R1.1) R1.2) =
    transH (apH {W0.Ix (PO.DG.ob R.Xv)} {W0.Ix (G.ob J z)} (\ ww -> ww.1 R.q0 R1.2) g1)
     (apH {D.S I x n J z} {W0.Ix (G.ob J z)} (\ sw -> D.rd I x u0.1 n J z R1.1 sw R1.2)
        (D.sEq I x n J z (compH J J I U1 (idH J)) U1 (comp-idr J I U1)
           (CT.rxM J J I (idH J) U1 (C.res J I U1 x) x R.CA.g0 n z R.CA.ch) (Q.cT J (idH J) z e') R.CA.law)) ;
   -- the end of psi_q
   g3 : Id (W0.Ix (G.ob J z)) endq R.val =
    transH (apH {TC.THm Y Y} {W0.Ix (G.ob J z)} (\ k -> Q.psiq.1 Y k pe) (symH (TR.fn.onId Y)))
     XB.RE[Y, Q.L0, Y, id0, pe].ret ;
   Pq : Id (W0.Ix (G.ob J z)) (u0.1 q i.2) endq =
    transH (symH a1) (transH (natT z e') (transH (symH g2) (symH g3))) ;
  } ;
 } ;

 -- the pairing of D G . D A into D (G.A)
 module Pair (A : TR.P1.PTy[PO.GP]) {
  module DA = CobarIT[a, vl, l].DTI[C, G, A] ;
  ET : CTPsh[a, vl, l].TPshOf[C].TCtx = TC.ofP DA.E ;
  module DE = DO.DC[ET] ;
  DEP : TR.P1.PCtx = TC.toP DE.DCtx ;
  Ext : TR.P1.PCtx = TR.P1.extP PO.DG DA.DTy ;
  phi (W : TC.TOb) (t : W0.Ix (Ext.ob W)) : DE.Ob' W.1 W.2 =
   (\ q lq -> DA.prz q.2.1 q.2.2.2.1 (t.1.1 q lq) (t.2.1 q lq), t.2.2.1, t.2.2.2.1, t.2.2.2.2) ;
  phiN (V W : TC.TOb) (g : TC.THm V W) (t : W0.Ix (Ext.ob W))
   : Id (DE.Ob' V.1 V.2) (phi V (Ext.act V W g t)) (DE.act V.1 W.1 g.1 V.2 W.2 g.2 (phi W t)) =
   DE.ob-eq V.1 V.2 (phi V (Ext.act V W g t)) (DE.act V.1 W.1 g.1 V.2 W.2 g.2 (phi W t))
    (\ q lq -> DA.TB[V.1, W.1, g.1, V.2, W.2, g.2, t.1, PO.DG.act V W g t.1, refl (PO.DG.act V W g t.1), t.2].pc q lq) ;
  module FX = G1.GB.CLine[l].FC[Ext] ;
  module FDE = G1.GB.CLine[l].FC[DEP] ;
  phiL (X : TC.TOb) (L : W0.Ix (FX.ob X)) : W0.Ix (FDE.ob X) =
   (\ W f j -> phi W (L.1 W f j),
    \ V W g f j -> transH (symH (phiN V W g (L.1 W f j))) (apH {W0.Ix (Ext.ob V)} {DE.Ob' V.1 V.2} (phi V) (L.2 V W g f j))) ;
 } ;
} ;
