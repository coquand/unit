-- CSemOp.seg (canonicity-45; SIMPLIFIED.md step 6): the two-variable term
-- op u1 u2 of a closed binary operation op : Fun Q (Fun Q Q), semantically:
-- at a point ((o, a1), a2) of nil.Q.Q it is op's fibre family applied at the
-- identity twice (ev2), natural by op's naturality and the naturality of
-- the outer and inner families (NT.law; point equations normalised by
-- tact-irr).  CMorX's Id types of the operations use it, so that their
-- fibres are read on the nose.
-- No new axioms beyond the named premises (fe).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module SemOp (Qt : C.Ty C.nil) (op : C.El C.nil (OV.Fun C.nil Qt (OV.Fun C.nil Qt Qt))) {
 Nl : C.Ctx = C.nil ;
 FQ : C.Ty Nl = OV.Fun Nl Qt Qt ;
 G1 : C.Ctx = C.ext Nl Qt ;
 Qw : C.Ty G1 = OV.wkT Nl Qt Qt ;
 G2 : C.Ctx = C.ext G1 Qw ;
 Qw2 : C.Ty G2 = OV.wkT G1 Qw Qw ;
 NO (K : Ob) : U a+ = V1.Ix (Nl.ob K) ;
 OB (K : Ob) (o : NO K) : U a+ = V1.Ix (Qt.1.tob K o) ;
 inn (K : Ob) (o : NO K) (a1 : OB K o) : V1.Ix (FQ.1.tob K o) = (op.eob K o).1 K (idH K) a1 ;
 ev2 (K : Ob) (o : NO K) (a1 a2 : OB K o) : OB K o = (inn K o a1).1 K (idH K) a2 ;
 rd (K : Ob) (x : V1.Ix (G2.ob K)) : V1.Ix (Qw2.1.tob K x) = ev2 K x.1.1 x.1.2 x.2 ;
 -- the action of G2 on points, componentwise
 actG2 (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (G2.ob K))
  : Id (V1.Ix (G2.ob L0)) (G2.act L0 K g x) ((x.1.1, Qt.1.tact L0 K g x.1.1 x.1.1 (refl x.1.1) x.1.2), Qt.1.tact L0 K g x.1.1 x.1.1 (refl x.1.1) x.2) =
  refl (G2.act L0 K g x) ;
 actQw2 (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (G2.ob K)) (v : V1.Ix (Qw2.1.tob K x))
  : Id (V1.Ix (Qt.1.tob L0 x.1.1)) (Qw2.1.tact L0 K g x (G2.act L0 K g x) (refl (G2.act L0 K g x)) v) (Qt.1.tact L0 K g x.1.1 x.1.1 (refl x.1.1) v) =
  refl (Qw2.1.tact L0 K g x (G2.act L0 K g x) (refl (G2.act L0 K g x)) v) ;
 rsQ (K L0 : Ob) (g : Hom L0 K) (o : NO K) (b : OB K o) : OB L0 o = Qt.1.tact L0 K g o o (refl o) b ;
 -- naturality of ev2 along g (all point equations refl)
 module NT (K L0 : Ob) (g : Hom L0 K) (o : NO K) (a1 a2 : OB K o) {
  FK : V1.Ix ((OV.Fun Nl Qt FQ).1.tob K o) = op.eob K o ;
  h : V1.Ix (FQ.1.tob K o) = inn K o a1 ;
  -- step A: op at L0 is op at K restricted
  sA : Id (OB L0 o) (ev2 L0 o (rsQ K L0 g o a1) (rsQ K L0 g o a2)) ((FK.1 L0 (compH L0 K K (idH K) g) (rsQ K L0 g o a1)).1 L0 (idH L0) (rsQ K L0 g o a2)) =
   transH (apH {V1.Ix ((OV.Fun Nl Qt FQ).1.tob L0 o)} {OB L0 o} (\ m -> (m.1 L0 (idH L0) (rsQ K L0 g o a1)).1 L0 (idH L0) (rsQ K L0 g o a2))
             (symH (op.enat L0 K g o o (refl o))))
    (apH {Hom L0 K} {OB L0 o} (\ k -> (FK.1 L0 k (rsQ K L0 g o a1)).1 L0 (idH L0) (rsQ K L0 g o a2))
       (transH (comp-idr L0 K g) (symH (comp-idl L0 K g)))) ;
  module PC1 = PresheafPi[a, a+].PPi[PB.BC].PiCode[Nl, Qt.1, (OV.wkT Nl Qt FQ).1] ;
  module PC2 = PresheafPi[a, a+].PPi[PB.BC].PiCode[Nl, Qt.1, (OV.wkT Nl Qt Qt).1] ;
  mB : V1.Ix (FQ.1.tob L0 o) = PC1.BactOf K (PC1.ptOf K o) (PC1.cOf K o) (PC1.eOf K o) K L0 (idH K) g a1 h ;
  aB : OB L0 o = PC1.AactOf K (PC1.ptOf K o) (PC1.cOf K o) K L0 (idH K) g a1 ;
  -- step B: the outer family's naturality at (idH K, g)
  sB : Id (V1.Ix (FQ.1.tob L0 o)) (FQ.1.tact L0 K g o o (refl o) h) (FK.1 L0 (compH L0 K K (idH K) g) (rsQ K L0 g o a1)) =
   transH {V1.Ix (FQ.1.tob L0 o)} {FQ.1.tact L0 K g o o (refl o) h} {mB} {FK.1 L0 (compH L0 K K (idH K) g) (rsQ K L0 g o a1)}
    (L.tact-irr Nl FQ.1 L0 K g o o (refl o) (L.ntEq (C.ext Nl Qt) Nl (C.p Nl Qt) L0 K g (L.pairE Nl Qt.1 K o a1) (L.pairE Nl Qt.1 L0 o aB) (PC1.eOf K o K L0 (idH K) g a1)) h)
    (transH {V1.Ix (FQ.1.tob L0 o)} {mB} {FK.1 L0 (compH L0 K K (idH K) g) aB} {FK.1 L0 (compH L0 K K (idH K) g) (rsQ K L0 g o a1)}
      (FK.2 K L0 (idH K) g a1)
      (apH {OB L0 o} {V1.Ix (FQ.1.tob L0 o)} (\ b -> FK.1 L0 (compH L0 K K (idH K) g) b) (L.tact-irr Nl Qt.1 L0 K g o o (PC1.cOf K o K L0 (idH K) g) (refl o) a1))) ;
  mC : OB L0 o = PC2.BactOf K (PC2.ptOf K o) (PC2.cOf K o) (PC2.eOf K o) K L0 (idH K) g a2 (h.1 K (idH K) a2) ;
  aC : OB L0 o = PC2.AactOf K (PC2.ptOf K o) (PC2.cOf K o) K L0 (idH K) g a2 ;
  -- step C: the inner family's naturality at (idH K, g)
  sC : Id (OB L0 o) (rsQ K L0 g o (ev2 K o a1 a2)) (h.1 L0 (compH L0 K K (idH K) g) (rsQ K L0 g o a2)) =
   transH {OB L0 o} {rsQ K L0 g o (ev2 K o a1 a2)} {mC} {h.1 L0 (compH L0 K K (idH K) g) (rsQ K L0 g o a2)}
    (L.tact-irr Nl Qt.1 L0 K g o o (refl o) (L.ntEq (C.ext Nl Qt) Nl (C.p Nl Qt) L0 K g (L.pairE Nl Qt.1 K o a2) (L.pairE Nl Qt.1 L0 o aC) (PC2.eOf K o K L0 (idH K) g a2)) (ev2 K o a1 a2))
    (transH {OB L0 o} {mC} {h.1 L0 (compH L0 K K (idH K) g) aC} {h.1 L0 (compH L0 K K (idH K) g) (rsQ K L0 g o a2)}
      (h.2 K L0 (idH K) g a2)
      (apH {OB L0 o} {OB L0 o} (\ b -> h.1 L0 (compH L0 K K (idH K) g) b) (L.tact-irr Nl Qt.1 L0 K g o o (PC2.cOf K o K L0 (idH K) g) (refl o) a2))) ;
  b2 : OB L0 o = rsQ K L0 g o a2 ;
  law : Id (OB L0 o) (rsQ K L0 g o (ev2 K o a1 a2)) (ev2 L0 o (rsQ K L0 g o a1) b2) =
   transH {OB L0 o} {rsQ K L0 g o (ev2 K o a1 a2)} {h.1 L0 (compH L0 K K (idH K) g) b2} {ev2 L0 o (rsQ K L0 g o a1) b2} sC
    (transH {OB L0 o} {h.1 L0 (compH L0 K K (idH K) g) b2} {(FQ.1.tact L0 K g o o (refl o) h).1 L0 (idH L0) b2} {ev2 L0 o (rsQ K L0 g o a1) b2}
      (apH {Hom L0 K} {OB L0 o} (\ k -> h.1 L0 k b2) (transH (comp-idl L0 K g) (symH (comp-idr L0 K g))))
      (transH {OB L0 o} {(FQ.1.tact L0 K g o o (refl o) h).1 L0 (idH L0) b2} {(FK.1 L0 (compH L0 K K (idH K) g) (rsQ K L0 g o a1)).1 L0 (idH L0) b2} {ev2 L0 o (rsQ K L0 g o a1) b2}
        (apH {V1.Ix (FQ.1.tob L0 o)} {OB L0 o} (\ m -> m.1 L0 (idH L0) b2) sB)
        (symH sA))) ;
 } ;
 nat (L0 K : Ob) (g : Hom L0 K) (x : V1.Ix (G2.ob K)) (y : V1.Ix (G2.ob L0)) (e : Id (V1.Ix (G2.ob L0)) (G2.act L0 K g x) y)
  : Id (V1.Ix (Qw2.1.tob L0 y)) (Qw2.1.tact L0 K g x y e (rd K x)) (rd L0 y) =
  idJ (V1.Ix (G2.ob L0)) (G2.act L0 K g x) (\ y2 e2 -> Id (V1.Ix (Qw2.1.tob L0 y2)) (Qw2.1.tact L0 K g x y2 e2 (rd K x)) (rd L0 y2))
   (NT[K, L0, g, x.1.1, x.1.2, x.2].law) y e ;
 o12s : C.El G2 Qw2 = new L.PEl[G2, Qw2.1, rd, nat] ;
} ;
