-- CTotRFib8.seg (canonicity-c2; SIMPLIFIED.md item 5): R of a levelwise
-- fibration is a fibration.  The side law of the componentwise composite
-- (from CTotRFib7.KC.c3, read at the points), and the assembly:
--   compR   a composition structure of B from e to e' at the levelwise
--           site gives one of R B at the total site
--   fibR    hence a fibration structure (both directions)
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module RFib8 (C : CIntCat[a].IC) {
 module R7 = CTotRFib7[a, l].RFib7[C] ;
 module TR = R7.TR ;
 module G1 = TR.G1 ;
 module G0 = TR.G0 ;
 module RN = TR.RN ;
 module RS = TR.RS ;
 module P0 = TR.P0 ;
 module P1 = TR.P1 ;
 Ob0 : U a = RN.Ob0 ;
 Ob1 : U a = RN.Ob1 ;

 module Cm (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (e e' : G1.GB.IPt)
   (c0 : G0.GB.CLine[l].Lines[RS.rC G, B].CompK[e, e'].Comp) {
  module KS = R7.Ks[G, B, e, e', c0] ;
  module KU = KS.KU ;
  module KO = KS.KO ;
  module CP = KS.CP ;
  module CT = KS.CT ;
  module L9 = KS.L9 ;
  module RT = KS.RT ;
  module EK1 = KS.EK1 ;
  module TL0 = KS.TL0 ;
  module CK1 = KS.CK1 ;
  module TT1 = KS.TT1 ;
  UG : P0.PCtx = KS.UG ;
  K1 : P1.PCtx = KS.K1 ;
  Tot1 (X : Ob1) : U l = KS.Tot1 X ;
  Pt0 (Y : Ob0) : U l = KS.Pt0 Y ;
  Pt1 (X : Ob1) : U l = W0.Ix (G.ob X) ;

  -- a family at equal maps and equal points
  famPt (X : Ob1) (g : Pt1 X) (b : RT.Fam X g) (Y : Ob0) (m m' : RN.Hom1 (RN.o Y) X) (pm : Id (RN.Hom1 (RN.o Y) X) m m')
   (p p' : Pt0 Y) (ep : Id (Pt0 Y) p p') (eq : Id (Pt0 Y) p (RT.at X g Y m)) (eq' : Id (Pt0 Y) p' (RT.at X g Y m'))
   : Id (W0.Ix (B.tob Y p')) (TL0.coeT Y p p' ep (b Y m p eq)) (b Y m' p' eq') =
   idJ (Pt0 Y) p (\ p2 ep2 -> (eq2 : Id (Pt0 Y) p2 (RT.at X g Y m')) -> Id (W0.Ix (B.tob Y p2)) (TL0.coeT Y p p2 ep2 (b Y m p eq)) (b Y m' p2 eq2))
    (\ eq2 -> RT.famCong X g b Y m m' pm p eq eq2) p' ep eq' ;
  -- two totals of R B with equal points and the same families are equal
  totExt (W : Ob1) (t t' : Tot1 W) (e1 : Id (Pt1 W) t.1 t'.1)
   (q : (Y : Ob0) (m : RN.Hom1 (RN.o Y) W) (p : Pt0 Y) (eq : Id (Pt0 Y) p (RT.at W t.1 Y m)) (eq' : Id (Pt0 Y) p (RT.at W t'.1 Y m))
        -> Id (W0.Ix (B.tob Y p)) (t.2.1 Y m p eq) (t'.2.1 Y m p eq'))
   : Id (Tot1 W) t t' =
   idJ (Pt1 W) t.1
    (\ g2 e2 -> (w2 : RT.T W g2)
       -> ((Y : Ob0) (m : RN.Hom1 (RN.o Y) W) (p : Pt0 Y) (eq : Id (Pt0 Y) p (RT.at W t.1 Y m)) (eq' : Id (Pt0 Y) p (RT.at W g2 Y m))
             -> Id (W0.Ix (B.tob Y p)) (t.2.1 Y m p eq) (w2.1 Y m p eq'))
       -> Id (Tot1 W) t (P1.pairE G RT.RB W g2 w2))
    (\ w2 q2 -> ap (RT.T W t.1) (Tot1 W) (\ v -> P1.pairE G RT.RB W t.1 v) t.2 w2 (RT.famExt W t.1 t.2 w2 (\ Y m p eq -> q2 Y m p eq eq)))
    t'.1 e1 t'.2 q ;

  module SB1 = G1.GB.CSub[l].SubE[CT.RH.F1.GI, G, CT.RH.F1.ev e', RT.RB] ;
  -- the side law, componentwise
  module SL (X : Ob1) (z : EK1.TV.EI X) (s : EK1.PT.Side[X, z]) (W : Ob1) (f : RN.Hom1 W X) (i : G1.GB.Lands W X s.pQ f) {
   module UN = KU.UN[W, X, f, z, s] ;
   u : EK1.TS.EI W = s.pv W f i ;
   gzu : Pt1 W = KO.gE W (EK1.TS.pr1 W u) ;
   eb : RT.T W gzu = KS.TO.FT1.Ev[e'].endB W (EK1.lineL W u) ;
   comp (Y0 : Ob0) (m : RN.Hom1 (RN.o Y0) W) (p : Pt0 Y0) (eq : Id (Pt0 Y0) p (RT.at W (KO.gE W UN.z') Y0 m))
    (eq' : Id (Pt0 Y0) p (RT.at W gzu Y0 m))
    : Id (W0.Ix (B.tob Y0 p)) (UN.A.res.1 Y0 m p eq) (eb.1 Y0 m p eq') =
    trans (W0.Ix (B.tob Y0 p)) (UN.A.res.1 Y0 m p eq) (TL0.coeT Y0 KS.KC[X, z, s, W, f, i, Y0, m].gR p (symH eq') KS.KC[X, z, s, W, f, i, Y0, m].rv)
      (eb.1 Y0 m p eq')
     (KU.coeEq Y0 (CP.p0 Y0 KS.KC[X, z, s, W, f, i, Y0, m].zA) KS.KC[X, z, s, W, f, i, Y0, m].gR p
        (KO.pth X z Y0 (G1.GB.BC.oC (RN.o Y0) W X f m) p (transH eq (UN.A.ek Y0 m))) (symH eq')
        KS.KC[X, z, s, W, f, i, Y0, m].kv KS.KC[X, z, s, W, f, i, Y0, m].rv KS.KC[X, z, s, W, f, i, Y0, m].c3)
     (famPt W gzu eb.1 Y0 (G1.GB.BC.oC (RN.o Y0) (RN.o Y0) W m (G1.GB.BC.idC (RN.o Y0))) m (G1.GB.BC.oC-idr (RN.o Y0) W m)
        KS.KC[X, z, s, W, f, i, Y0, m].gR p (symH eq') KS.KC[X, z, s, W, f, i, Y0, m].EE eq') ;
   Pz : Id (EK1.TV.EI W) UN.z' (EK1.TS.pr1 W u) = symH (s.ppt W f i) ;
   lhs0 : TT1.EI W = TT1.E.act W X f (TT1.pr X z (KO.kop X z s)) ;
   rhs0 : TT1.EI W = CK1.endM W u ;
   Q2 : Id (Tot1 W) (P1.pairE G RT.RB W (KO.gE W UN.z') UN.A.res) (P1.pairE G RT.RB W gzu eb) =
    totExt W (P1.pairE G RT.RB W (KO.gE W UN.z') UN.A.res) (P1.pairE G RT.RB W gzu eb)
     (ap (EK1.TV.EI W) (Pt1 W) (KO.gE W) UN.z' (EK1.TS.pr1 W u) Pz) comp ;
   Q1 : Id (SB1.TS.EI W) (CK1.SE.mV W lhs0) (CK1.SE.mV W rhs0) =
    SB1.mV-inj W (CK1.SE.mV W lhs0) (CK1.SE.mV W rhs0)
     (ap (EK1.TV.EI W) (W0.Ix (CT.RH.F1.ob W)) (EK1.TV.pr1 W) UN.z' (EK1.TS.pr1 W u) Pz) Q2 ;
   kside : Id (TT1.EI W) lhs0 rhs0 = CK1.SE.mV-inj W lhs0 rhs0 Pz Q1 ;
  } ;

  -- the composition structure of R B from e to e'
  compR : CK1.Comp =
   G1.GB.CPartial[l].Rel[K1, EK1.SFm.SF, CK1.Tend, CK1.endL].mkRC
    (\ X z s -> KO.kop X z s)
    (\ X z s W f i -> SL[X, z, s, W, f, i].kside)
    (\ Y X h z s -> KU.UN[Y, X, h, z, s].kunif) ;
 } ;

 -- R of a levelwise fibration is a fibration
 fibR (G : P1.PCtx) (B : P0.PTy[RS.rC G]) (fb : G0.GB.CLine[l].Lines[RS.rC G, B].Fib)
  : G1.GB.CLine[l].Lines[G, RN.Ty[G, B].RB].Fib =
  (Cm[G, B, G1.GB.e0, G1.GB.e1, fb.1].compR, Cm[G, B, G1.GB.e1, G1.GB.e0, fb.2].compR) ;
} ;
