-- CDFw9.seg (canonicity-c2; (d)(1), part 9): pointwise readings of fwd's
-- body t0 at (K, (tt, z)): first component z . p_u (CPreI.PI.val), second
-- component's first the values of z at the new generators (CDFw1.vt).
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
open Axioms[a++].FunExtLemmas[fe @(a++)] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module V1 = V[a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;
SS : CwF.Formers[a++, FibCwF[a, a+].fibCwF].SigStr = FibCwF[a, a+].fibSig ;

IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module INm = CwFInt.Int[a++, C, FibCwF[a, a+].fibPi, SS, IJ] ;
module Fw9 (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x) (y : SX.Over[R].Presentation) {
 module F8 = CDFw8[a].Fw8[R, encK, pe, x, u, y] ;
 module F1 = F8.F1 ;
 module S1 = F1.S1 ;
 Nl : C.Ctx = C.nil ;
 HU : C.Ty Nl = F8.HU ;
 T0 : C.Ty Nl = F8.T0 ;
 D1 : C.Ctx = F8.D1 ;
 TK (K : Ob) : U a+ = V1.Ix (T0.1.tob K tt) ;
 -- t0 at a point, through the outer transport (Sigma-nat) and the pair
 rd0 (K : Ob) (z : V1.Ix (HU.1.tob K tt)) : Id (TK K) (F8.t0.eob K (tt, z))
   ((INm.pr D1 F8.HXD (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0) F1.hX (OV.trE D1 (C.subT D1 F8.Gh F1.S2.Sol F8.sg1) (C.subT D1 (C.ext D1 F8.HXD) (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0) (C.sec D1 F8.HXD F1.hX)) F8.PS0 F8.sol)).eob K (tt, z)) =
  transH (CAppRd[a].trE-rd D1 (SS.Sig D1 F8.HXD (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0)) (C.subT D1 Nl T0 (C.p Nl HU)) (symH (FibCwF[a, a+].fibSig.Sig-nat D1 Nl F8.HXY F1.S2.Sol (C.p Nl HU)))
           (INm.pr D1 F8.HXD (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0) F1.hX (OV.trE D1 (C.subT D1 F8.Gh F1.S2.Sol F8.sg1) (C.subT D1 (C.ext D1 F8.HXD) (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0) (C.sec D1 F8.HXD F1.hX)) F8.PS0 F8.sol)) K (tt, z))
   (CAppRd[a].same-rd D1 (SS.Sig D1 F8.HXD (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0)) (C.subT D1 Nl T0 (C.p Nl HU)) (symH (FibCwF[a, a+].fibSig.Sig-nat D1 Nl F8.HXY F1.S2.Sol (C.p Nl HU))) K (tt, z) (refl (T0.1.tob K tt))
      ((INm.pr D1 F8.HXD (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0) F1.hX (OV.trE D1 (C.subT D1 F8.Gh F1.S2.Sol F8.sg1) (C.subT D1 (C.ext D1 F8.HXD) (C.subT (C.ext D1 F8.HXD) F8.Gh F1.S2.Sol F8.lf0) (C.sec D1 F8.HXD F1.hX)) F8.PS0 F8.sol)).eob K (tt, z))) ;
 rdH (K : Ob) (z : V1.Ix (HU.1.tob K tt)) : Id (V1.Ix (S1.HXY.1.tob K tt)) (F8.t0.eob K (tt, z)).1 (F1.PIu.val K z) =
  apH {TK K} {V1.Ix (S1.HXY.1.tob K tt)} (\ v -> v.1) (rd0 K z) ;
} ;
