-- CobarIT.seg (canonicity-45; SIMPLIFIED.md step 4): the cobar
-- construction D on TYPES over the total site: for G a displayed presheaf
-- (CTPsh) and A a presheaf type over it (Presheaf's PTy at CTotCat's
-- TotCat), D A is a presheaf type over D G (CobarI.DCtx).  Its fibre at
-- (I, x) over w : (D G)(I, x) is the families av over the indices of w,
-- with values in A at the points w q l, satisfying the three equations of
-- w read in the total space G.A (naturality through the cartesian action,
-- faces, top face through the vertical action).  The action along a total
-- map is the action of D G on the points with a transport of the values
-- (coeT), stated in Presheaf's e-form; its laws come from the slice paths
-- of CobarI (idPath, oPath) read in G.A.
-- No new axioms beyond the named premises (fe, through tob-eq).

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Ar = Arith[a] ;
module Tr = Trees[a] ;
module Wt = Weights[a, l] ;

module DTI (C : CIntCat[a].IC) (G : CTPsh[a, l].TPshOf[C].TCtx) (A : Presheaf[a, l].Psh[CTotCat[a, l].TotOf[C].TotCat].PTy[CTotCat[a, l].TotOf[C].toP G]) {
 module TC = CTotCat[a, l].TotOf[C] ;
 module P = Presheaf[a, l].Psh[TC.TotCat] ;
 module VT = CVert[a].VertOf[C] ;
 module CT = CChainsT[a].ChT[C] ;
 module TP = CTPsh[a, l].TPshOf[C] ;
 module DO = CobarI[a, l].DOfI[C] ;
 module D = DO.DC[G] ;
 Obj (I : Ob) : U a = VT.Obj I ;
 Idx (I : Ob) (x : Obj I) : U a = DO.Idx I x ;
 LandsI (I : Ob) (x : Obj I) (q : Idx I x) : U a = DO.LandsI I x q ;
 GP : P.PCtx = TC.toP G ;
 E : P.PCtx = P.extP GP A ;
 -- points of G at (J, z) and of A over them; the total space
 Pt (J : Ob) (z : Obj J) : U l = W0.Ix (G.ob J z) ;
 Tv (J : Ob) (z : Obj J) (g : Pt J z) : U l = W0.Ix (A.tob (J, z) g) ;
 Ez (J : Ob) (z : Obj J) : U l = P.SigT GP A (J, z) ;
 prz (J : Ob) (z : Obj J) (g : Pt J z) (b : Tv J z g) : Ez J z = P.pairE GP A (J, z) g b ;
 coeT (J : Ob) (z : Obj J) (g g' : Pt J z) (e : Id (Pt J z) g g') (b : Tv J z g) : Tv J z g' = subst (Pt J z) (\ k -> Tv J z k) g g' e b ;
 pr-coe (J : Ob) (z : Obj J) (g g' : Pt J z) (e : Id (Pt J z) g g') (b : Tv J z g) : Id (Ez J z) (prz J z g b) (prz J z g' (coeT J z g g' e b)) =
  idJ (Pt J z) g (\ k e2 -> Id (Ez J z) (prz J z g b) (prz J z k (coeT J z g k e2 b))) (refl (prz J z g b)) g' e ;
 pr-inj (J : Ob) (z : Obj J) (g : Pt J z) (b b' : Tv J z g) (Q : Id (Ez J z) (prz J z g b) (prz J z g b')) : Id (Tv J z g) b b' =
  P.pairE-inj GP A (J, z) g b b' Q ;

 -- the families of values
 aV (I : Ob) (x : Obj I) (w : D.Ob' I x) : W0.V =
  DO.piI (DO.idxV I x) (\ q -> DO.piP (LandsI I x q) (DO.isPropL I x q) (\ l -> A.tob (q.2.1, q.2.2.2.1) (w.1 q l))) ;
 TA (I : Ob) (x : Obj I) (w : D.Ob' I x) : U l = W0.Ix (aV I x w) ;
 -- reading a family in the total space, on the slice
 rdP (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (n : Nat) (J : Ob) (z : Obj J) (i : VA.Ix (DO.coordV n J)) (sw : D.S I x n J z) (l : LandsI I x (n, J, sw.1, z, sw.2, i)) : Ez J z =
  prz J z (w.1 (n, J, sw.1, z, sw.2, i) l) (av (n, J, sw.1, z, sw.2, i) l) ;

 -- naturality in the base, in the total space
 anatL (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.natIdxV I x)) (l : LandsI I x r.1) : Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) =
  E.act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (prz r.1.2.1 r.1.2.2.2.1 (w.1 r.1 l) (av r.1 l)) ;
 anatR (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.natIdxV I x)) (l : LandsI I x r.1) : Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) =
  rdP I x w av r.1.1 r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1
   (compH r.2.1 r.1.2.1 I r.1.2.2.1 r.2.2, DO.rCh r.2.1 r.1.2.1 I r.2.2 r.1.2.2.1 x r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1)
   (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2 ;
 anatB (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.natIdxV I x)) : W0.V =
  DO.piP (LandsI I x r.1) (DO.isPropL I x r.1) (\ l -> W0.IdV (P.SigE GP A.tob (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (anatL I x w av r l) (anatR I x w av r l)) ;
 anatEq (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) : W0.V = DO.piI (D.natIdxV I x) (anatB I x w av) ;
 anatP (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) : isProp (W0.Ix (anatEq I x w av)) =
  DO.piIP (D.natIdxV I x) (anatB I x w av) (\ r -> DO.piPP (LandsI I x r.1) (DO.isPropL I x r.1)
   (\ l -> W0.IdV (P.SigE GP A.tob (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (anatL I x w av r l) (anatR I x w av r l))
   (\ l -> DO.idProp (P.SigE GP A.tob (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (anatL I x w av r l) (anatR I x w av r l))) ;

 -- the inner faces
 afaceF (I : Ob) (x : Obj I) (r : VA.Ix (D.faceIdxV I x)) (l : D.faceLd I x r) : Wt.Pn (suc r.1) r.2.2.2.1 =
  Wt.Face[r.1, r.2.2.2.1, r.2.1, Ar.leb-step r.2.1 r.1 r.2.2.1].Of[(r.2.2.2.2.2.2.2, l)].face ;
 afaceL (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.faceIdxV I x)) (l : D.faceLd I x r) : Ez r.2.2.2.1 r.2.2.2.2.2.1 =
  prz r.2.2.2.1 r.2.2.2.2.2.1
   (w.1 (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (afaceF I x r l).1) (afaceF I x r l).2)
   (av (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (afaceF I x r l).1) (afaceF I x r l).2) ;
 afaceR (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.faceIdxV I x)) (l : D.faceLd I x r) : Ez r.2.2.2.1 r.2.2.2.2.2.1 =
  prz r.2.2.2.1 r.2.2.2.2.2.1
   (w.1 (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)
   (av (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 I r.2.2.2.2.1 x) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l) ;
 afaceB (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.faceIdxV I x)) : W0.V =
  DO.piP (D.faceLd I x r) (D.facePL I x r) (\ l -> W0.IdV (P.SigE GP A.tob (r.2.2.2.1, r.2.2.2.2.2.1)) (afaceL I x w av r l) (afaceR I x w av r l)) ;
 afaceEq (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) : W0.V = DO.piI (D.faceIdxV I x) (afaceB I x w av) ;
 afaceP (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) : isProp (W0.Ix (afaceEq I x w av)) =
  DO.piIP (D.faceIdxV I x) (afaceB I x w av) (\ r -> DO.piPP (D.faceLd I x r) (D.facePL I x r)
   (\ l -> W0.IdV (P.SigE GP A.tob (r.2.2.2.1, r.2.2.2.2.2.1)) (afaceL I x w av r l) (afaceR I x w av r l))
   (\ l -> DO.idProp (P.SigE GP A.tob (r.2.2.2.1, r.2.2.2.2.2.1)) (afaceL I x w av r l) (afaceR I x w av r l))) ;

 -- the top face: the vertical action of G.A along the last map
 atopF (I : Ob) (x : Obj I) (r : VA.Ix (D.topIdxV I x)) (l : D.topLd I x r) : Wt.Pn (suc r.1) r.2.1 =
  Wt.Face[r.1, r.2.1, suc r.1, Tr.leb-refl (suc r.1)].Of[(r.2.2.2.2.2, l)].face ;
 atopL (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.topIdxV I x)) (l : D.topLd I x r) : Ez r.2.1 r.2.2.2.1 =
  prz r.2.1 r.2.2.2.1
   (w.1 (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (atopF I x r l).1) (atopF I x r l).2)
   (av (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (atopF I x r l).1) (atopF I x r l).2) ;
 atopAct (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.topIdxV I x)) (l : D.topLd I x r)
  (DD : DO.KJ[r.2.1].K.DR r.1 (C.res r.2.1 I r.2.2.1 x) r.2.2.2.1) : Ez r.2.1 r.2.2.2.1 =
  E.act (r.2.1, r.2.2.2.1) (r.2.1, DD.1) (idH r.2.1, DD.2.2)
   (prz r.2.1 DD.1 (w.1 (r.1, r.2.1, r.2.2.1, DD.1, DD.2.1, r.2.2.2.2.2) l) (av (r.1, r.2.1, r.2.2.1, DD.1, DD.2.1, r.2.2.2.2.2) l)) ;
 atopR (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.topIdxV I x)) (l : D.topLd I x r) : Ez r.2.1 r.2.2.2.1 =
  atopAct I x w av r l (D.topD I x r) ;
 atopB (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) (r : VA.Ix (D.topIdxV I x)) : W0.V =
  DO.piP (D.topLd I x r) (D.topPL I x r) (\ l -> W0.IdV (P.SigE GP A.tob (r.2.1, r.2.2.2.1)) (atopL I x w av r l) (atopR I x w av r l)) ;
 atopEq (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) : W0.V = DO.piI (D.topIdxV I x) (atopB I x w av) ;
 atopP (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) : isProp (W0.Ix (atopEq I x w av)) =
  DO.piIP (D.topIdxV I x) (atopB I x w av) (\ r -> DO.piPP (D.topLd I x r) (D.topPL I x r)
   (\ l -> W0.IdV (P.SigE GP A.tob (r.2.1, r.2.2.2.1)) (atopL I x w av r l) (atopR I x w av r l))
   (\ l -> DO.idProp (P.SigE GP A.tob (r.2.1, r.2.2.2.1)) (atopL I x w av r l) (atopR I x w av r l))) ;

 AEqsV (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) : W0.V =
  W0.SigV (anatEq I x w av) (\ p -> W0.SigV (afaceEq I x w av) (\ p' -> atopEq I x w av)) ;
 aeqs-prop (I : Ob) (x : Obj I) (w : D.Ob' I x) (av : TA I x w) : isProp (W0.Ix (AEqsV I x w av)) =
  isProp-Sigma (W0.Ix (anatEq I x w av)) (\ p -> W0.Ix (W0.SigV (afaceEq I x w av) (\ p' -> atopEq I x w av))) (anatP I x w av)
   (\ p -> isProp-Sigma (W0.Ix (afaceEq I x w av)) (\ p' -> W0.Ix (atopEq I x w av)) (afaceP I x w av) (\ p' -> atopP I x w av)) ;

 -- the fibre of D A at (I, x) over w
 tobV (I : Ob) (x : Obj I) (w : D.Ob' I x) : W0.V = W0.SigV (aV I x w) (\ av -> AEqsV I x w av) ;
 TOb' (I : Ob) (x : Obj I) (w : D.Ob' I x) : U l = W0.Ix (tobV I x w) ;
 tob-eq (I : Ob) (x : Obj I) (w : D.Ob' I x) (av b : TOb' I x w)
  (H : (q : Idx I x) (l : LandsI I x q) -> Id (Tv q.2.1 q.2.2.2.1 (w.1 q l)) (av.1 q l) (b.1 q l))
  : Id (TOb' I x w) av b =
  Sigma-path (TA I x w) (\ a' -> W0.Ix (AEqsV I x w a')) av.1 b.1 av.2 b.2
   (funext (Idx I x) (\ q -> (l : LandsI I x q) -> Tv q.2.1 q.2.2.2.1 (w.1 q l)) av.1 b.1 (\ q ->
     funext (LandsI I x q) (\ l -> Tv q.2.1 q.2.2.2.1 (w.1 q l)) (av.1 q) (b.1 q) (H q)))
   (aeqs-prop I x w b.1 _ b.2) ;

 ------------------------------------------------------------------
 -- the action along a total map (u0, f0) : (J0, y) -> (I, x), over
 -- e : (D G).act (u0, f0) w = w'
 module TB (J0 I : Ob) (u0 : Hom J0 I) (y : Obj J0) (x : Obj I) (f0 : VT.HomD J0 I u0 y x) (w : D.Ob' I x) (w' : D.Ob' J0 y)
  (e : Id (D.Ob' J0 y) (D.act J0 I u0 y x f0 w) w') (av : TOb' I x w) {
  module AC = D.Act[J0, I, u0, y, x, f0, w] ;
  sh (q : Idx J0 y) : Idx I x = AC.rq q ;
  pe (q : Idx J0 y) (l : LandsI J0 y q) : Id (Pt q.2.1 q.2.2.2.1) (w.1 (sh q) l) (w'.1 q l) = apH {D.Ob' J0 y} {Pt q.2.1 q.2.2.2.1} (\ v -> v.1 q l) e ;
  a' : TA J0 y w' = \ q l -> coeT q.2.1 q.2.2.2.1 (w.1 (sh q) l) (w'.1 q l) (pe q l) (av.1 (sh q) l) ;
  -- read in the total space, a' is av at the shifted index
  pc (q : Idx J0 y) (l : LandsI J0 y q) : Id (Ez q.2.1 q.2.2.2.1) (prz q.2.1 q.2.2.2.1 (w'.1 q l) (a' q l)) (prz q.2.1 q.2.2.2.1 (w.1 (sh q) l) (av.1 (sh q) l)) =
   symH (pr-coe q.2.1 q.2.2.2.1 (w.1 (sh q) l) (w'.1 q l) (pe q l) (av.1 (sh q) l)) ;
  nat' : W0.Ix (anatEq J0 y w' a') = \ r l ->
   transH (apH {Ez r.1.2.1 r.1.2.2.2.1} {Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
             (E.act (r.2.1, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (r.1.2.1, r.1.2.2.2.1) (r.2.2, C.cart r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)) (pc r.1 l))
    (transH (av.2.1 (sh r.1, r.2) l)
      (transH (apH {D.S I x r.1.1 r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)} {Ez r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1)}
                 (\ sw -> rdP I x w av.1 r.1.1 r.2.1 (C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1) (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1 sw (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)
                 (AC.natPath r l))
        (symH (pc (r.1.1, r.2.1, compH r.2.1 r.1.2.1 J0 r.1.2.2.1 r.2.2, C.res r.2.1 r.1.2.1 r.2.2 r.1.2.2.2.1,
                    DO.rCh r.2.1 r.1.2.1 J0 r.2.2 r.1.2.2.1 y r.1.1 r.1.2.2.2.1 r.1.2.2.2.2.1, (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).1)
                  (Wt.Res[r.1.1, r.2.1, r.1.2.1, r.2.2, (r.1.2.2.2.2.2, l)].res).2)))) ;
  face' : W0.Ix (afaceEq J0 y w' a') = \ r l ->
   transH (pc (suc r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, r.2.2.2.2.2.2.1, (afaceF J0 y r l).1) (afaceF J0 y r l).2)
    (transH (av.2.2.1 (r.1, r.2.1, r.2.2.1, r.2.2.2.1, compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1, r.2.2.2.2.2.1,
                       CT.rxM r.2.2.2.1 J0 I r.2.2.2.2.1 u0 y x AC.g0 (suc r.1) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)
      (transH (apH {DO.KJ[r.2.2.2.1].K.Ch r.1 (C.res r.2.2.2.1 I (compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1) x) r.2.2.2.2.2.1} {Ez r.2.2.2.1 r.2.2.2.2.2.1}
                 (\ cc -> prz r.2.2.2.1 r.2.2.2.2.2.1 (w.1 (r.1, r.2.2.2.1, compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1, r.2.2.2.2.2.1, cc, r.2.2.2.2.2.2.2) l)
                                                     (av.1 (r.1, r.2.2.2.1, compH r.2.2.2.1 J0 I u0 r.2.2.2.2.1, r.2.2.2.2.2.1, cc, r.2.2.2.2.2.2.2) l))
                 (AC.facePath r))
        (symH (pc (r.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2.1, DO.KJ[r.2.2.2.1].K.comp r.1 r.2.1 (C.res r.2.2.2.1 J0 r.2.2.2.2.1 y) r.2.2.2.2.2.1 r.2.2.2.2.2.2.1, r.2.2.2.2.2.2.2) l)))) ;
  top' : W0.Ix (atopEq J0 y w' a') = \ r l ->
   transH (pc (suc r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, (atopF J0 y r l).1) (atopF J0 y r l).2)
    (transH (av.2.2.2 (r.1, r.2.1, compH r.2.1 J0 I u0 r.2.2.1, r.2.2.2.1, CT.rxM r.2.1 J0 I r.2.2.1 u0 y x AC.g0 (suc r.1) r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2) l)
      (transH (apH {DO.KJ[r.2.1].K.DR r.1 (C.res r.2.1 I (compH r.2.1 J0 I u0 r.2.2.1) x) r.2.2.2.1} {Ez r.2.1 r.2.2.2.1}
                 (\ DD -> atopAct I x w av.1 (r.1, r.2.1, compH r.2.1 J0 I u0 r.2.2.1, r.2.2.2.1, CT.rxM r.2.1 J0 I r.2.2.1 u0 y x AC.g0 (suc r.1) r.2.2.2.1 r.2.2.2.2.1, r.2.2.2.2.2) l DD)
                 (AC.Top[r.1, r.2.1, r.2.2.1, r.2.2.2.1, r.2.2.2.2.1, r.2.2.2.2.2, l].dEq))
        (apH {Ez r.2.1 (D.topD J0 y r).1} {Ez r.2.1 r.2.2.2.1} (E.act (r.2.1, r.2.2.2.1) (r.2.1, (D.topD J0 y r).1) (idH r.2.1, (D.topD J0 y r).2.2))
           (symH (pc (r.1, r.2.1, r.2.2.1, (D.topD J0 y r).1, (D.topD J0 y r).2.1, r.2.2.2.2.2) l))))) ;
  res : TOb' J0 y w' = (a', nat', face', top') ;
 } ;

 tb-id (I : Ob) (x : Obj I) (w : D.Ob' I x) (e : Id (D.Ob' I x) (D.act I I (idH I) x x (C.idD I x) w) w) (av : TOb' I x w)
  : Id (TOb' I x w) (TB[I, I, idH I, x, x, C.idD I x, w, w, e, av].res) av =
  tob-eq I x w (TB[I, I, idH I, x, x, C.idD I x, w, w, e, av].res) av (\ q l ->
   pr-inj q.2.1 q.2.2.2.1 (w.1 q l) (TB[I, I, idH I, x, x, C.idD I x, w, w, e, av].a' q l) (av.1 q l)
    (transH (TB[I, I, idH I, x, x, C.idD I x, w, w, e, av].pc q l)
      (apH {D.S I x q.1 q.2.1 q.2.2.2.1} {Ez q.2.1 q.2.2.2.1} (\ sw -> rdP I x w av.1 q.1 q.2.1 q.2.2.2.1 q.2.2.2.2.2 sw l) (D.idPath I x q)))) ;

 tb-o (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : Obj K) (y : Obj J) (x : Obj I) (f : VT.HomD J I u y x) (f' : VT.HomD K J v z y)
  (w1 : D.Ob' I x) (w2 : D.Ob' J y) (w3 : D.Ob' K z)
  (e1 : Id (D.Ob' J y) (D.act J I u y x f w1) w2) (e2 : Id (D.Ob' K z) (D.act K J v z y f' w2) w3)
  (e3 : Id (D.Ob' K z) (D.act K I (compH K J I u v) z x (C.compD K J I u v z y x f f') w1) w3) (av : TOb' I x w1)
  : Id (TOb' K z w3) (TB[K, I, compH K J I u v, z, x, C.compD K J I u v z y x f f', w1, w3, e3, av].res)
      (TB[K, J, v, z, y, f', w2, w3, e2, TB[J, I, u, y, x, f, w1, w2, e1, av].res].res) =
  tob-eq K z w3 (TB[K, I, compH K J I u v, z, x, C.compD K J I u v z y x f f', w1, w3, e3, av].res)
    (TB[K, J, v, z, y, f', w2, w3, e2, TB[J, I, u, y, x, f, w1, w2, e1, av].res].res) (\ q l ->
   pr-inj q.2.1 q.2.2.2.1 (w3.1 q l)
    (TB[K, I, compH K J I u v, z, x, C.compD K J I u v z y x f f', w1, w3, e3, av].a' q l)
    (TB[K, J, v, z, y, f', w2, w3, e2, TB[J, I, u, y, x, f, w1, w2, e1, av].res].a' q l)
    (transH (TB[K, I, compH K J I u v, z, x, C.compD K J I u v z y x f f', w1, w3, e3, av].pc q l)
      (transH (symH (apH {D.S I x q.1 q.2.1 q.2.2.2.1} {Ez q.2.1 q.2.2.2.1} (\ sw -> rdP I x w1 av.1 q.1 q.2.1 q.2.2.2.1 q.2.2.2.2.2 sw l) (D.oPath K J I u v z y x f f' q)))
        (symH (transH (TB[K, J, v, z, y, f', w2, w3, e2, TB[J, I, u, y, x, f, w1, w2, e1, av].res].pc q l)
                 (TB[J, I, u, y, x, f, w1, w2, e1, av].pc (TB[K, J, v, z, y, f', w2, w3, e2, TB[J, I, u, y, x, f, w1, w2, e1, av].res].sh q) l)))))) ;

 -- D A as a presheaf type over D G (over the total category)
 DTy : P.PTy[TC.toP D.DCtx] =
  new P.PTy[TC.toP D.DCtx, \ X w -> tobV X.1 X.2 w,
   \ Y X f w w' e av -> TB[Y.1, X.1, f.1, Y.2, X.2, f.2, w, w', e, av].res,
   \ X w e av -> tb-id X.1 X.2 w e av,
   \ Z Y X f g w1 w2 w3 e1 e2 e3 av -> tb-o Z.1 Y.1 X.1 f.1 g.1 Z.2 Y.2 X.2 f.2 g.2 w1 w2 w3 e1 e2 e3 av] ;
} ;
