-- CE1Cst.seg (canonicity-45; COBAR.md "Prop 58"): the constants' case of
-- total E1 (CE1Tot3's cC): cst r ~ tau (c . can_t . k_r) (CCst5), retyped by
-- associativity of codes to tau . pre along the composite code can_t . k_r,
-- then CCodeH to tau . pre_(k_(cst r)) (both send the generator to cls (cst r)).
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;

module CS (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (t : SX.Over[R].Presentation) (r : R.R) {
 module C5 = CCst5[a].C5[R, encK, pe, t, r] ;
 module A = CE1Tot[a].T1[R, encK, pe, t] ;
 module CM = A.CM ;
 module HO1 = A.HO1 ;
 module KC = CCompC[a].CC2[R, encK, pe, C5.K2.F0, CM.F1, t, C5.KR.SC.M.mor, C5.KR.SC.M.mor-nat, C5.SCan.M.mor, C5.SCan.M.mor-nat] ;
 -- (c . can) . k = c . (can . k)
 assoc (K : Ob) (x : SX.Over[R].Presentation) (c : CM.MO.Fn[t, x].M K)
  : Id (CM.MO.Fn[CM.F1, x].M K) (C5.KR.PRe.pre K x (C5.PC.pre K x c)) (CM.Pre[t, CM.F1, KC.c, KC.cn].pre K x c) =
  symH (transH (apH {(w : Hom K K) * CM.MO.Fn[CM.F1, x].M K} {CM.MO.Fn[CM.F1, x].M K} (\ p -> p.2)
                  (CM.CO.As[K, K, K, K, idH K, idH K, idH K, x, t, C5.K2.F0, CM.F1, C5.KR.SC.M.mor K, C5.SCan.M.mor K, c].law))
    (apH {Hom K K} {CM.MO.Fn[CM.F1, x].M K} (\ hh -> CM.CO.cmpM K K K hh x C5.K2.F0 CM.F1 (C5.KR.SC.M.mor K) (CM.CO.cmpM K K K (idH K) x t C5.K2.F0 (C5.SCan.M.mor K) c)) (comp-idl K K (idH K)))) ;
 aK : HO1.NMap[A.P1, A.XT, A.GT] = A.aC KC.c KC.cn ;
 module R1 = HO1.Ret[A.P1, A.XT, A.GT, C5.cTN, C5.rTN, C5.cTN, aK, \ X o c -> refl (C5.cTN.nfun X o c),
   \ X o c -> apH {CM.MO.Fn[CM.F1, X.2].M X.1} {A.C6.Q1.DY.Ob' X.1 X.2} (A.C6.Q1.DY.tau X.1 X.2) (symH (assoc X.1 X.2 c)), C5.res] ;
 -- the composite against k_(cst r): both send the generator to cls (cst r)
 module KB = A.KS[cst r] ;
 module GO = CCodeH[a].GenOf[R, encK, pe, t, KC.c, KC.cn, KB.S.M.mor, KB.S.M.mor-nat] ;
 Nl : FibCwF[a, a+].fibCwF.Ctx = FibCwF[a, a+].fibCwF.nil ;
 Q1 : FibCwF[a, a+].fibCwF.Ty Nl = CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].Qt ;
 Q0 : FibCwF[a, a+].fibCwF.Ty Nl = CHomT3[a].HomP[R, encK, pe].Alg[C5.K2.F0].Qt ;
 Qt : FibCwF[a, a+].fibCwF.Ty Nl = GO.QY ;
 cx : FibCwF[a, a+].fibCwF.El Nl Q1 = CHomT3[a].HomP[R, encK, pe].Alg[CM.F1].AX.cls (var (inr tt)) ;
 Pk : FibCwF[a, a+].fibCwF.El Nl (OV.Fun Nl Q1 Q0) = C5.KR.SC.SM.Phi ;
 c0 : FibCwF[a, a+].fibCwF.El Nl Q0 = OV.app Nl Q1 Q0 Pk cx ;
 Ea : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q0 Qt C5.SCan.SM.Phi c0 ;
 Eb : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q1 Qt KB.S.SM.Phi cx ;
 mid : FibCwF[a, a+].fibCwF.El Nl Qt = OV.app Nl Q0 Qt C5.SCan.SM.Phi (CHomT3[a].HomP[R, encK, pe].Alg[C5.K2.F0].AX.cls (cst r)) ;
 cs : FibCwF[a, a+].fibCwF.El Nl Qt = CHomT3[a].HomP[R, encK, pe].Alg[t].AX.cls (cst r) ;
 E : FibCwF[a, a+].fibCwF.El Nl (IJ.IdT Nl Qt Ea Eb) =
  PT.transM Nl Qt Ea mid Eb (PT.apM Nl Q0 Qt (OV.bod Nl Q0 (OV.wkT Nl Q0 Qt) C5.SCan.SM.Phi) c0 (CHomT3[a].HomP[R, encK, pe].Alg[C5.K2.F0].AX.cls (cst r)) (C5.KR.SC.SM.beta (var (inr tt))))
   (PT.transM Nl Qt mid cs Eb (C5.SCan.SM.beta (cst r)) (PT.symM Nl Qt Eb cs (KB.S.SM.beta (var (inr tt))))) ;
 ra (K : Ob) : Id (V1.Ix (Qt.1.tob K tt)) (Ea.eob K tt) (GO.fa K) =
  transH (CAppRd[a].App0[Q0, Qt, C5.SCan.SM.Phi, c0].rd K tt)
   (apH {V1.Ix (Q0.1.tob K tt)} {V1.Ix (Qt.1.tob K tt)} (\ v -> (C5.SCan.SM.Phi.eob K tt).1 K (idH K) v)
     (transH (CAppRd[a].App0[Q1, Q0, Pk, cx].rd K tt)
       (apH {Hom K K} {V1.Ix (Q0.1.tob K tt)} (\ f -> (Pk.eob K tt).1 K f (cx.eob K tt)) (symH (comp-idl K K (idH K)))))) ;
 rb (K : Ob) : Id (V1.Ix (Qt.1.tob K tt)) (Eb.eob K tt) (GO.fb K) = CAppRd[a].App0[Q1, Qt, KB.S.SM.Phi, cx].rd K tt ;
 module G = GO.At[Ea, Eb, E, ra, rb] ;
 module H3 = HO1.Ret[A.P1, A.XT, A.GT, HO1.compN A.P1 A.XT A.C6.Q1.Y1T A.GT G.H.PLm.mA G.H.tauN, HO1.compN A.P1 A.XT A.C6.Q1.Y1T A.GT G.H.PLm.mB G.H.tauN,
   aK, A.Rs (cst r), \ I x c -> refl (aK.nfun I x c), \ I x c -> refl ((A.Rs (cst r)).nfun I x c), G.H.res] ;
 -- CE1Tot3's constants: cT r and cst r ~ tau . pre_(k_(cst r))
 cT : HO1.NMap[A.P1, A.XT, A.GT] = C5.cTN ;
 module CC = HO1.Cat[A.P1, A.XT, A.GT, C5.cTN, aK, A.Rs (cst r), A.cB, R1.res, H3.res] ;
 cC : A.G1.GB.GPre[a+].PS.PEl[A.G1.GB.GPre[a+].PS.extP A.P1 A.XT, HO1.HT[A.P1, A.XT, A.GT, cT, A.Rs (cst r)].PT.PathP] = CC.res ;
} ;
