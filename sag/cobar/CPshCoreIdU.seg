-- CPshCoreIdU.seg (canonicity-45; (B) stage 2(b), COBAR.md): core's
-- identity type (CId.IdOver: a path valued in the total space with a
-- sieve of constancy) as a C-type, and the C-uniformity of its
-- compositions (CIdFib.IF.comp from a composition of the path type):
-- mirror of CIdNat.IdNatC for the C-action.
--   CoreIdC[G, A, a, b]   IdT : CTy[G], ty x = CIdFib.IdFib[G.ob x, A.ty x,
--                         a.el x, b.el x].IdT on the nose; the C-action moves
--                         the path as CPshPathU.PathC and keeps the sieve
--                         (the constancy moved by a.el-nat)
--   IU[G, A, a, b, d, dc, kP, cuP].res   the compositions of core's Id at
--                         each x (IF.comp from kP x) are C-uniform when the
--                         path compositions kP are: the point is G.act of
--                         the point (ptEq), the path is the path composite
--                         (pathEq by cuP and kop-cong, the problem read in
--                         the path type moves: sideV, sideEq), the sieve is
--                         the dependent conjunction of equal families
--                         (famEq by the readings R1 and LO.EL.endLC)

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module CL = PB.CLine[l] ;
module CP = PB.CPartial[l] ;
module CIF = PB.CIdFib[l] ;
module CIm = PB.CId[l] ;

module CoreIdUOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module FUm = CPshFillU[a, l].FillUOf[C] ;
 module PUm = CPshPathU[a, l].PathUOf[C] ;
 open P ;

 ------------------------------------------------------------------
 -- core's identity type of a C-type

 module CoreIdC (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) {
  module PC = PUm.PathC[G, A, a0, b0] ;
  module IF0 (x : CO) {
   module F = CIF.IdFib[G.ob x, A.ty x, a0.el x, b0.el x] ;
   module IO = CIm.IdOver[G.ob x, G.ob x, A.ty x, F.PF.s, F.PF.sN, F.PF.PE.aE, F.PF.PE.bE, F.PF.PE.aE-act, F.PF.PE.bE-act] ;
  } ;
  module TA (x : CO) { module T = GPR.TyL[G.ob x, A.ty x] ; } ;
  ty (x : CO) : PTy[G.ob x] = IF0[x].F.IdT ;

  -- the C-action on an element: the path moved, the sieve kept
  module TC (y x : CO) (f : CH y x) (X : Ob) (g : W0.Ix ((G.ob x).ob X)) (w : W0.Ix (IF0[x].IO.tobI X g)) {
   gy : W0.Ix ((G.ob y).ob X) = (G.act y x f).nt X g ;
   res : W0.Ix (IF0[y].IO.tobI X gy) =
    (PC.TC[y, x, f, X, g, w.1].res,
     (w.2.1,
      \ W h i j -> transH (apH ((A.tE y x f).nt W) (w.2.2 W h i j))
                    (transH (a0.el-nat y x f W ((G.ob x).act W X h g))
                      (apH (\ y1 -> IF0[y].IO.PT.aE W y1) ((G.act y x f).nt-nat W X h g))))) ;
  } ;
  tEn (y x : CO) (f : CH y x) (X : Ob) (v : SigT (G.ob x) (ty x) X) : SigT (G.ob y) (ty y) X =
   pairE (G.ob y) (ty y) X ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v)) (TC[y, x, f, X, fstE (G.ob x) (ty x) X v, sndE (G.ob x) (ty x) X v].res) ;
  tEnP (y x : CO) (f : CH y x) : PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y)] =
   new PSub[extP (G.ob x) (ty x), extP (G.ob y) (ty y), tEn y x f,
    \ V X h v -> IF0[y].IO.tpI-ext V (tEn y x f V ((extP (G.ob x) (ty x)).act V X h v)) ((extP (G.ob y) (ty y)).act V X h (tEn y x f X v))
       ((G.act y x f).nt-nat V X h (fstE (G.ob x) (ty x) X v))
       (\ V' h' j -> refl ((A.tE y x f).nt V' ((sndE (G.ob x) (ty x) X v).1.1.1 V' (compH V' V X h h') j)))
       (refl (PB.pre V X h (sndE (G.ob x) (ty x) X v).2.1))] ;
  IdT : CTy[G] =
   new CTy[G, ty, tEnP,
    \ y x f X v -> refl ((G.act y x f).nt X (fstE (G.ob x) (ty x) X v)),
    \ x X v -> IF0[x].IO.tpI-ext X (tEn x x (cid x) X v) v (G.act-id x X (fstE (G.ob x) (ty x) X v))
       (\ V h j -> A.tE-id x V ((sndE (G.ob x) (ty x) X v).1.1.1 V h j))
       (refl (sndE (G.ob x) (ty x) X v).2.1),
    \ z y x f h X v -> IF0[z].IO.tpI-ext X (tEn z x (co z y x f h) X v) (tEn z y h X (tEn y x f X v)) (G.act-o z y x f h X (fstE (G.ob x) (ty x) X v))
       (\ V h' j -> A.tE-o z y x f h V ((sndE (G.ob x) (ty x) X v).1.1.1 V h' j))
       (refl (sndE (G.ob x) (ty x) X v).2.1)] ;
 } ;

 ------------------------------------------------------------------
 -- the compositions of core's Id are C-uniform

 module IU (G : CCtx) (A : CTy[G]) (a0 b0 : CEl[G, A]) (d : Bool) (dc : CIm.DConj)
  (kP : (x : CO) -> CL.Lines[G.ob x, PUm.PathC[G, A, a0, b0].ty x].CompK[PB.src d, PB.tgt d].Comp)
  (cuP : LO.UF[G, PUm.PathC[G, A, a0, b0].PathT].UComp (PB.src d) (PB.tgt d) kP) {
  module CI = CoreIdC[G, A, a0, b0] ;
  module PC = CI.PC ;
  module FP = FUm.FU[G, PC.PathT, d, kP, cuP] ;
  module Ix (x : CO) {
   module I = CI.IF0[x].F.IFm[PB.src d, PB.tgt d, kP x, dc].I ;
  } ;
  kI (x : CO) : CL.Lines[G.ob x, CI.ty x].CompK[PB.src d, PB.tgt d].Comp = Ix[x].I.comp ;
  module SFI = LO.SF[G, CI.IdT, PB.src d] ;
  module AEI = SFI.AE' ;
  module AEI' = LO.AE[G, CI.IdT, PB.tgt d] ;
  module SCI = LO.SC[SFI.TVC, LO.LinC G, LO.pPC (LO.LinC G) AEI.AevC, AEI'.AevC] ;
  module EL = LO.EL[G, CI.IdT, PB.src d, PB.tgt d] ;
  module MI (y x : CO) (f : CH y x) { module M = MapSide[SFI.TVC, SFI.SFC, y, x, f] ; } ;
  tvI (y x : CO) (f : CH y x) (X : Ob) (w : Ix[x].I.TVI.EI X) : Ix[y].I.TVI.EI X = AEI.tEv y x f X w ;
  tsI (y x : CO) (f : CH y x) (X : Ob) (u : Ix[x].I.TSI.EI X) : Ix[y].I.TSI.EI X = SFI.tES y x f X u ;
  taI (y x : CO) (f : CH y x) (W : Ob) (v : Ix[x].I.TI.EI W) : Ix[y].I.TI.EI W = (CI.IdT.tE y x f).nt W v ;
  taP (y x : CO) (f : CH y x) (W : Ob) (v : Ix[x].I.TP.EI W) : Ix[y].I.TP.EI W = (PC.PathT.tE y x f).nt W v ;

  -- a composite of Id, moved and read in the total space, is the composite read
  mVrB (x : CO) (W : Ob) (u : Ix[x].I.TTI.EI W) : Id (AEI'.TVT x W) (Ix[x].I.CKI.SE.mV W u) (SCI.rB x W u) = refl (SCI.rB x W u) ;
  opaque mVrB ;
  R1 (y x : CO) (f : CH y x) (W : Ob) (v : Ix[x].I.TTI.EI W)
   : Id (Ix[y].I.TI.EI W) (Ix[y].I.rdI W (SCI.tEs y x f W v)) (taI y x f W (Ix[x].I.rdI W v)) =
   transH {Ix[y].I.TI.EI W} {Ix[y].I.EKI'.endE W (Ix[y].I.CKI.SE.mV W (SCI.tEs y x f W v))} {Ix[y].I.EKI'.endE W (AEI'.tEv y x f W (SCI.rB x W v))} {taI y x f W (Ix[x].I.rdI W v)}
    (apH (Ix[y].I.EKI'.endE W) (transH (mVrB y W (SCI.tEs y x f W v)) (SCI.rBtE y x f W v)))
    (transH {Ix[y].I.TI.EI W} {Ix[y].I.EKI'.endE W (AEI'.tEv y x f W (SCI.rB x W v))} {taI y x f W (Ix[x].I.EKI'.endE W (SCI.rB x W v))} {taI y x f W (Ix[x].I.rdI W v)}
      (AEI'.endEv y x f W (SCI.rB x W v))
      (apH (taI y x f W) (apH (Ix[x].I.EKI'.endE W) (symH (mVrB x W v))))) ;
  opaque R1 ;

  module H (y x : CO) (f : CH y x) (X : Ob) (w : Ix[x].I.TVI.EI X) (sd : Ix[x].I.PTI.Side[X, w]) {
   module Xs = Ix[x].I ;
   module Ys = Ix[y].I ;
   sdG : Ys.PTI.Side[X, tvI y x f X w] = MI[y, x, f].M.mapside X w sd ;

   -- the path part of moved end data is the moved path part
   ptEq (W : Ob) (z : Xs.TVI.EI W) : Id (Ys.TVP.EI W) (FP.tv y x f W (Xs.sP W z)) (Ys.sP W (tvI y x f W z)) =
    Ys.EKP.tv-eq W (FP.tv y x f W (Xs.sP W z)) (Ys.sP W (tvI y x f W z))
     (refl (CL.FMap[G.ob x, G.ob y, G.act y x f].mapF W (Xs.TVI.pr1 W z)))
     (transH (FP.AEe.endEv y x f W (Xs.sP W z))
       (symH (apH (Ys.IO.proj.mE W) (AEI.endEv y x f W z)))) ;

   -- strict-fibre elements read in the path type, moved
   sideV (W : Ob) (v v' : Xs.TSI.EI W) (Pt : Id (Xs.TVI.EI W) (Xs.TSI.pr1 W v) (Xs.TSI.pr1 W v'))
    (Lv : (V : Ob) (g : Hom V W) (j : Hom V Iv) -> Id (Xs.TI.EI V) (Xs.FTI.lval W (Xs.EKI.lineL W v) V g j) (Xs.FTI.lval W (Xs.EKI.lineL W v') V g j))
    : Id (Ys.TSP.EI W) (FP.ts y x f W (Xs.mS W v)) (Ys.mS W (tsI y x f W v')) =
    Ys.EKP.ts-ext W (FP.ts y x f W (Xs.mS W v)) (Ys.mS W (tsI y x f W v'))
     (transH (apH (FP.tv y x f W) (Xs.mS-pt W v))
       (transH (apH (\ z -> FP.tv y x f W (Xs.sP W z)) Pt)
         (transH (ptEq W (Xs.TSI.pr1 W v')) (symH (Ys.mS-pt W (tsI y x f W v'))))))
     (\ V g j ->
      transH (apH (\ M -> taP y x f V (Xs.FTP.lval W M V g j)) (Xs.mS-line W v))
        (transH (apH (\ z -> taP y x f V (Xs.IO.proj.mE V z)) (Lv V g j))
          (symH (apH (\ M -> Ys.FTP.lval W M V g j) (Ys.mS-line W (tsI y x f W v')))))) ;

   sideEq : Id (Ys.PTP.Side[X, Ys.sP X (tvI y x f X w)])
             (subst (Ys.TVP.EI X) (\ z -> Ys.PTP.Side[X, z]) (FP.tv y x f X (Xs.sP X w)) (Ys.sP X (tvI y x f X w)) (ptEq X w)
                (FP.MSd[y, x, f].M.mapside X (Xs.sP X w) (Xs.mside X w sd)))
             (Ys.mside X (tvI y x f X w) sdG) =
    Ys.PTP.side-extH X (FP.tv y x f X (Xs.sP X w)) (Ys.sP X (tvI y x f X w)) (ptEq X w)
     (FP.MSd[y, x, f].M.mapside X (Xs.sP X w) (Xs.mside X w sd)) (Ys.mside X (tvI y x f X w) sdG)
     (refl sd.pQ)
     (\ W h i i' -> sideV W (sd.pv W h i) (sd.pv W h i') (apH (\ z -> Xs.TSI.pr1 W z) (Xs.PTI.pv-irr X w sd W h i i'))
        (\ V g j -> apH (\ z -> Xs.FTI.lval W (Xs.EKI.lineL W z) V g j) (Xs.PTI.pv-irr X w sd W h i i'))) ;
   opaque ptEq ; opaque sideEq ;

   -- the composite paths agree
   pathEq : Id (Ys.TP.EI X) (taP y x f X (Xs.rdP X Xs.F[X, w, sd].pk)) (Ys.rdP X Ys.F[X, tvI y x f X w, sdG].pk) =
    transH (symH (FP.rdC y x f X Xs.F[X, w, sd].pk))
     (apH (Ys.rdP X)
       (transH (cuP y x f X (Xs.sP X w) (Xs.mside X w sd))
         (Ys.RCP.kop-cong (kP y) X (FP.tv y x f X (Xs.sP X w)) (Ys.sP X (tvI y x f X w)) (ptEq X w)
            (FP.MSd[y, x, f].M.mapside X (Xs.sP X w) (Xs.mside X w sd)) (Ys.mside X (tvI y x f X w) sdG) sideEq))) ;
   opaque pathEq ;

   -- the sieves of the ends of the sides agree
   famEq (W : Ob) (h : Hom W X) (i : PB.Lands W X sd.pQ h) : Id (PB.Phi W) (Xs.F[X, w, sd].Fs W h i) (Ys.F[X, tvI y x f X w, sdG].Fs W h i) =
    symH (transH (apH (\ z -> (Ys.TI.pr2 W z).2.1) (apH (Ys.rdI W) (symH (EL.endLC y x f W (sd.pv W h i)))))
            (apH (\ z -> (Ys.TI.pr2 W z).2.1) (R1 y x f W (Xs.CKI.endL.mE W (sd.pv W h i))))) ;
   opaque famEq ;

   val : Id (Ys.TTI.EI X) (SCI.tEs y x f X (Xs.TTI.pr X w (Xs.kop X w sd))) (Ys.TTI.pr X (tvI y x f X w) (Ys.kop X (tvI y x f X w) sdG)) =
    Ys.ttI-ext X (SCI.tEs y x f X (Xs.TTI.pr X w (Xs.kop X w sd))) (Ys.TTI.pr X (tvI y x f X w) (Ys.kop X (tvI y x f X w) sdG))
     (refl (tvI y x f X w))
     (transH (R1 y x f X (Xs.TTI.pr X w (Xs.kop X w sd)))
       (Ys.IO.tpI-ext X (taI y x f X (Xs.rdI X (Xs.TTI.pr X w (Xs.kop X w sd)))) (Ys.rdI X (Ys.TTI.pr X (tvI y x f X w) (Ys.kop X (tvI y x f X w) sdG)))
          (refl (Ys.TI.pr1 X (taI y x f X (Xs.rdI X (Xs.TTI.pr X w (Xs.kop X w sd))))))
          (\ V g j -> apH (\ z -> (Ys.TP.pr2 X z).1.1 V g j) pathEq)
          (CIm.dconj-cong dc X sd.pQ Xs.F[X, w, sd].Fs Ys.F[X, tvI y x f X w, sdG].Fs Xs.F[X, w, sd].Fn Ys.F[X, tvI y x f X w, sdG].Fn famEq))) ;
  } ;

  res : LO.UF[G, CI.IdT].UComp (PB.src d) (PB.tgt d) kI = \ y x f X w sd -> H[y, x, f, X, w, sd].val ;
 } ;
} ;
