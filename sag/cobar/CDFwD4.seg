-- Move the already checked fibre proposition from CDIn9's function
-- presentation to CDFw8's lambda, along their explicit equality.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module QP = CwFQP.QP[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibNF[a, a+].nf] ;
C : CwF.CwF[a++] = FibCwF[a, a+].fibCwF ;

module Move (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (x : SX.Over[R].Presentation) (u : SX.Rel[R].RelPres x)
  (y : SX.Over[R].Presentation) {
 module D = CDFwD3[a].D3[R, encK, pe, x, u, y] ;
 module E = CDFwEq[a].Eq[R, encK, pe, x, u, y] ;
 module I9 = CDIn9[a].In9[R, encK, pe, x, u, y] ;
 module B = CInjFibBridge[a].Bridge[I9.I1m.HU, I9.I1m.T0, I9.I1m.fwdN] ;
 GB : C.Ctx = D.Fib.GB ;
 sourceFib : C.Ty GB = QP.FVr C.nil D.F.T0 D.F.HU B.I.fC ;
 sourceEq : Id (C.Ty GB) B.I.Fib sourceFib = B.fibreEq ;
 targetFib : C.Ty GB = QP.FVr C.nil D.F.T0 D.F.HU D.F.fwd ;
 mapFib : Id (C.Ty GB) sourceFib targetFib =
  apH {C.El C.nil (OV.Fun C.nil D.F.HU D.F.T0)} {C.Ty GB}
    (\ f -> QP.FVr C.nil D.F.T0 D.F.HU f) E.mapEq ;
 targetEq : Id (C.Ty GB) targetFib D.Fib.Fib = refl targetFib ;
 fibEq : Id (C.Ty GB) B.I.Fib D.Fib.Fib = transH sourceEq (transH mapFib targetEq) ;
 propEq : Id (C.Ty GB) (PU.isProp GB B.I.Fib) (PU.isProp GB D.Fib.Fib) =
  apH {C.Ty GB} {C.Ty GB} (\ T -> PU.isProp GB T) fibEq ;
 pF : C.El GB (PU.isProp GB D.Fib.Fib) =
  OV.trE GB (PU.isProp GB B.I.Fib) (PU.isProp GB D.Fib.Fib) propEq I9.pF ;
 module Conditional (ms : D.MereSurj) {
  Kd : C.El C.nil (QP.Kr C.nil D.F.T0 D.F.HU D.F.fwd) = D.Assemble[pF, ms].Kd ;
 } ;
} ;
