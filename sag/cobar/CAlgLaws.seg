-- CAlgLaws.seg (canonicity-45; SIMPLIFIED.md step 2b): the ring laws of
-- the presented algebra A_x at ALL elements, from the laws at the classes
-- of constants (CAlgX) by Law1 (CAlgLaw) one variable at a time: for each
-- variable the two sides are functions of it given by a body over nil.Qt
-- (Fun1, with its beta law from the Ov calculus Ov1), the other variables
-- being external elements; the law at constants of the innermost
-- variable is the law at constants of CAlgX read through the betas.
--   One variable:   addZero, mulOne, addNeg
--   Two variables:  addComm, mulComm
--   (three variables in CAlgLaws3)
-- Against the parameters of CAlgX.Ops (set-ness, elim2 with beta) and
-- Law1's set-ness of the weakened Qt.  No new axioms beyond those.

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module W0 = V[a] ;
module V1 = V[a+] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module FB = FibCwF[a, a+] ;
module OV = CwFOv.Ov[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module EQ = CwFEq.Eqv[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module IN = CwFInt.Int[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
module PT = CwFPth.Pth[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId] ;
C : CwF.CwF[a++] = FB.fibCwF ;
IJ : CwFId.SwanId[a++, FibCwF[a, a+].fibCwF].IdJStr = FibId[a, a+].fibId ;
module CF = CAlgFun[a] ;

module Laws (R : Ring[a].CRing) (encK : EN.Enc R.R) (x : SX.Over[R].Presentation) (pe : PU.PropExtTy)
 (setQ : (q q' : C.El C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) -> C.El C.nil (PU.isProp C.nil (IJ.IdT C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt q q')))
 (elim2 : CAlgX[a].AlgX[R, encK, x, pe].Elim2Ty) (elim2-beta : CAlgX[a].AlgX[R, encK, x, pe].Elim2Beta elim2)
 (setW : (a1 b1 : C.El (C.ext C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) (OV.wkT C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt))
   -> C.El (C.ext C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) (PU.isProp (C.ext C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) (IJ.IdT (C.ext C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt) (OV.wkT C.nil CAlgX[a].AlgX[R, encK, x, pe].Qt CAlgX[a].AlgX[R, encK, x, pe].Qt) a1 b1))) {
 module AX = CAlgX[a].AlgX[R, encK, x, pe] ;
 module OP = AX.Ops[setQ, elim2, elim2-beta] ;
 Nl : C.Ctx = C.nil ;
 Term : U a = AX.Term ;
 Qt : C.Ty Nl = AX.Qt ;
 Q : U a++ = C.El Nl Qt ;
 IdQ (q q' : Q) : C.Ty Nl = AX.IdQ q q' ;
 cls (t : Term) : Q = AX.cls t ;
 add (q q' : Q) : Q = OP.add q q' ;
 mul (q q' : Q) : Q = OP.mul q q' ;
 FQ : C.Ty Nl = OV.Fun Nl Qt Qt ;
 G1 : C.Ctx = C.ext Nl Qt ;
 Qw : C.Ty G1 = OV.wkT Nl Qt Qt ;
 q0 : C.El G1 Qw = C.q Nl Qt ;
 wF (F : C.El Nl FQ) : C.El G1 (OV.Fun G1 Qw Qw) = EQ.wkF Nl Qt Qt Qt F ;
 wG (F : C.El Nl (OV.Fun Nl Qt FQ)) : C.El G1 (OV.Fun G1 Qw (OV.wkT Nl Qt FQ)) = EQ.wkF Nl Qt Qt FQ F ;
 wE (q : Q) : C.El G1 Qw = OV.wkE Nl Qt Qt q ;
 ap (f : C.El Nl FQ) (q : Q) : Q = OV.app Nl Qt Qt f q ;
 ap1 (f : C.El G1 (OV.Fun G1 Qw Qw)) (b : C.El G1 Qw) : C.El G1 Qw = OV.app G1 Qw Qw f b ;
 ap2 (f : C.El G1 (OV.Fun G1 Qw (OV.wkT Nl Qt FQ))) (b : C.El G1 Qw) : C.El G1 (OV.Fun G1 Qw Qw) = CF.toFun Qt Qt Qt (OV.app G1 Qw (OV.wkT Nl Qt FQ) f b) ;
 tr (q1 q2 q3 : Q) (e : C.El Nl (IdQ q1 q2)) (e' : C.El Nl (IdQ q2 q3)) : C.El Nl (IdQ q1 q3) = OP.tr q1 q2 q3 e e' ;
 sy (q1 q2 : Q) (e : C.El Nl (IdQ q1 q2)) : C.El Nl (IdQ q2 q1) = OP.sy q1 q2 e ;
 ofEq (q1 q2 : Q) (e : Id Q q1 q2) : C.El Nl (IdQ q1 q2) = OP.ofEq q1 q2 e ;
 -- the identity function and its beta
 idQ : C.El Nl FQ = IN.idF Nl Qt ;
 id-beta (q : Q) : Id Q (ap idQ q) q = IN.app-idF Nl Qt q ;
 -- Law1 for two functions and the law at constants, giving the law at q
 module L1 (F1 F2 : C.El Nl FQ) (lawC : (t : Term) -> C.El Nl (IdQ (ap F1 (cls t)) (ap F2 (cls t)))) {
  module LL = CAlgLaw[a].Law1[R, encK, x, pe, setW, F1, F2, lawC] ;
  at (q : Q) : C.El Nl (IdQ (ap F1 q) (ap F2 q)) = LL.lawAll q ;
 } ;
 -- a law between two sides v1 v2 : Q -> Q given by bodies, from the law at constants
 module Unary (b1 b2 : C.El G1 Qw) (v1 v2 : Q -> Q)
  (o1 : (q : Q) -> CF.Ov1[Qt, q].OvB Qt b1 (v1 q)) (o2 : (q : Q) -> CF.Ov1[Qt, q].OvB Qt b2 (v2 q))
  (lawC : (t : Term) -> C.El Nl (IdQ (v1 (cls t)) (v2 (cls t)))) {
  module F1 = CF.Fun1[Qt, Qt, b1, v1, o1] ;
  module F2 = CF.Fun1[Qt, Qt, b2, v2, o2] ;
  lawC' (t : Term) : C.El Nl (IdQ (ap F1.F (cls t)) (ap F2.F (cls t))) =
   tr (ap F1.F (cls t)) (v1 (cls t)) (ap F2.F (cls t)) (ofEq (ap F1.F (cls t)) (v1 (cls t)) (F1.beta (cls t)))
    (tr (v1 (cls t)) (v2 (cls t)) (ap F2.F (cls t)) (lawC t) (ofEq (v2 (cls t)) (ap F2.F (cls t)) (symH (F2.beta (cls t))))) ;
  module M = L1[F1.F, F2.F, lawC'] ;
  at (q : Q) : C.El Nl (IdQ (v1 q) (v2 q)) =
   tr (v1 q) (ap F1.F q) (v2 q) (ofEq (v1 q) (ap F1.F q) (symH (F1.beta q)))
    (tr (ap F1.F q) (ap F2.F q) (v2 q) (M.at q) (ofEq (ap F2.F q) (v2 q) (F2.beta q))) ;
 } ;

 ------------------------------------------------------------------
 -- bodies for a binary operation op: q `op` c and c `op` q (c external),
 -- with their Ov at every q; the identity body; q + (-1) q
 module Bin (op : C.El Nl (OV.Fun Nl Qt FQ)) {
  apO (q q' : Q) : Q = OV.app Nl Qt Qt (OV.app Nl Qt FQ op q) q' ;
  -- the body op b1 b2 of two bodies, and its Ov from theirs (proved once)
  bB (b1 b2 : C.El G1 Qw) : C.El G1 Qw = ap1 (ap2 (wG op) b1) b2 ;
  oB (b1 b2 : C.El G1 Qw) (v1 v2 : Q -> Q) (o1 : (q : Q) -> CF.Ov1[Qt, q].OvB Qt b1 (v1 q)) (o2 : (q : Q) -> CF.Ov1[Qt, q].OvB Qt b2 (v2 q)) (q : Q)
   : CF.Ov1[Qt, q].OvB Qt (bB b1 b2) (apO (v1 q) (v2 q)) =
   CF.Ov1[Qt, q].ovApp Qt Qt (ap2 (wG op) b1) (OV.app Nl Qt FQ op (v1 q))
    (CF.Ov1[Qt, q].ovToFun Qt Qt (OV.app G1 Qw (OV.wkT Nl Qt FQ) (wG op) b1) (OV.app Nl Qt FQ op (v1 q))
      (CF.Ov1[Qt, q].ovApp Qt FQ (wG op) op (CF.Ov1[Qt, q].ovFun Qt FQ op) b1 (v1 q) (o1 q)))
    b2 (v2 q) (o2 q) ;
  opaque oB ;
  -- q `op` c and c `op` q for an external c
  bR (c : Q) : C.El G1 Qw = bB q0 (wE c) ;
  oR (c q : Q) : CF.Ov1[Qt, q].OvB Qt (bR c) (apO q c) = oB q0 (wE c) (\ q2 -> q2) (\ q2 -> c) (\ q2 -> CF.Ov1[Qt, q2].ovVar) (\ q2 -> CF.Ov1[Qt, q2].ovGl Qt c) q ;
  bL (c : Q) : C.El G1 Qw = bB (wE c) q0 ;
  oL (c q : Q) : CF.Ov1[Qt, q].OvB Qt (bL c) (apO c q) = oB (wE c) q0 (\ q2 -> c) (\ q2 -> q2) (\ q2 -> CF.Ov1[Qt, q2].ovGl Qt c) (\ q2 -> CF.Ov1[Qt, q2].ovVar) q ;
 } ;
 module BA = Bin[OP.addQ] ;
 module BM = Bin[OP.mulQ] ;
 bId : C.El G1 Qw = q0 ;
 oId (q : Q) : CF.Ov1[Qt, q].OvB Qt bId q = CF.Ov1[Qt, q].ovVar ;
 oGl (c : Q) (q : Q) : CF.Ov1[Qt, q].OvB Qt (wE c) c = CF.Ov1[Qt, q].ovGl Qt c ;
 negC : Q = cls (cst (R.neg R.o)) ;
 bNeg : C.El G1 Qw = BA.bB q0 (BM.bL negC) ;
 oNeg (q : Q) : CF.Ov1[Qt, q].OvB Qt bNeg (add q (OP.negQ q)) = BA.oB q0 (BM.bL negC) (\ q2 -> q2) (\ q2 -> OP.negQ q2) oId (BM.oL negC) q ;

 ------------------------------------------------------------------
 -- the one-variable laws
 addZero (q : Q) : C.El Nl (IdQ (add q OP.zeroQ) q) = Unary[BA.bR OP.zeroQ, bId, \ q2 -> add q2 OP.zeroQ, \ q2 -> q2, BA.oR OP.zeroQ, oId, OP.add-zeroC].at q ;
 mulOne (q : Q) : C.El Nl (IdQ (mul q OP.oneQ) q) = Unary[BM.bR OP.oneQ, bId, \ q2 -> mul q2 OP.oneQ, \ q2 -> q2, BM.oR OP.oneQ, oId, OP.mul-oneC].at q ;
 addNeg (q : Q) : C.El Nl (IdQ (add q (OP.negQ q)) OP.zeroQ) =
  Unary[bNeg, wE OP.zeroQ, \ q2 -> add q2 (OP.negQ q2), \ q2 -> OP.zeroQ, oNeg, oGl OP.zeroQ, OP.add-negC].at q ;
 -- the two-variable laws: the inner variable at constants first
 addCommI (u : Term) (q : Q) : C.El Nl (IdQ (add q (cls u)) (add (cls u) q)) =
  Unary[BA.bR (cls u), BA.bL (cls u), \ q2 -> add q2 (cls u), \ q2 -> add (cls u) q2, BA.oR (cls u), BA.oL (cls u), \ t -> OP.add-commC t u].at q ;
 addComm (q q' : Q) : C.El Nl (IdQ (add q q') (add q' q)) =
  Unary[BA.bL q, BA.bR q, \ q2 -> add q q2, \ q2 -> add q2 q, BA.oL q, BA.oR q, \ u -> addCommI u q].at q' ;
 mulCommI (u : Term) (q : Q) : C.El Nl (IdQ (mul q (cls u)) (mul (cls u) q)) =
  Unary[BM.bR (cls u), BM.bL (cls u), \ q2 -> mul q2 (cls u), \ q2 -> mul (cls u) q2, BM.oR (cls u), BM.oL (cls u), \ t -> OP.mul-commC t u].at q ;
 mulComm (q q' : Q) : C.El Nl (IdQ (mul q q') (mul q' q)) =
  Unary[BM.bL q, BM.bR q, \ q2 -> mul q q2, \ q2 -> mul q2 q, BM.oL q, BM.oR q, \ u -> mulCommI u q].at q' ;
} ;
