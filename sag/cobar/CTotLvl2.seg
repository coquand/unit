-- CTotLvl2.seg (canonicity-c2; SIMPLIFIED.md step 4): the levelwise input
-- of the fibration half of Lemma 12, part 2: U of the strict fibre at the
-- total site restricts to the levelwise strict fibre (mS: the line of
-- G.A restricted by rho, its end by fn.onId), naturally (mSnat), and
-- injectively over equal points (mTinj: rho-inj on the lines of G.A).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;

module Lvl2 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module L1 = CTotLvl[a, vl, l].Lvl[C, G, A, e] ;
 module PO = L1.PO ;
 module TR = L1.TR ;
 module G0 = TR.G0 ;
 module TC = L1.TC ;
 module EK1 = L1.EK1 ;
 module EK0 = L1.EK0 ;
 module RH = L1.RH ;
 E1 : TR.P1.PCtx = TR.P1.extP PO.GP A ;
 module RHE = CTotRFib[a, vl, l].RFib[C].Rho[E1] ;
 module XE = CTotUExt[a, vl, l].UExt[C].FI.XG[E1] ;
 Ob0 : U vl = TR.RN.Ob0 ;
 module FT1 = TR.G1.GB.CLine[l].FT[PO.GP, A] ;
 module FT0 = G0.GB.CLine[l].FT[TR.RS.rC PO.GP, TR.RS.rT PO.GP A] ;
 module TSU = G0.GB.GPre[l].TyL[L1.DU, L1.SU] ;

 module MS (Y : Ob0) (v : TSU.EI Y) {
  x : W0.Ix (L1.DU.ob Y) = TSU.pr1 Y v ;
  module P = L1.PT[Y, x] ;
  sv1 : W0.Ix (EK1.SFm.sfOb (TR.RN.o Y) x) = TSU.pr2 Y v ;
  La : W0.Ix (FT1.FE.ob (TR.RN.o Y)) = sv1.1.1 ;
  eqL1 : Id (W0.Ix (RH.F1.ob (TR.RN.o Y))) (FT1.piL (TR.RN.o Y) La) P.x1 = sv1.1.2 ;
  L0 : W0.Ix (FT0.FE.ob Y) = RHE.rhoV Y La ;
  eqL0 : Id (W0.Ix (RH.F0.ob Y)) (FT0.piL Y L0) P.x0 =
   transH (RH.F0.fam-eq Y (FT0.piL Y L0) (RH.rhoV Y (FT1.piL (TR.RN.o Y) La)) (\ W h j -> refl ((FT0.piL Y L0).1 W h j)))
    (apH {W0.Ix (RH.F1.ob (TR.RN.o Y))} {W0.Ix (RH.F0.ob Y)} (RH.rhoV Y) eqL1) ;
  wl0 : EK0.TL.EI Y = EK0.TL.pr Y P.x0 (L0, eqL0) ;
  id0 : TR.RN.Hom0 Y Y = G0.GB.BC.idC Y ;
  endE : Id (EK0.TA.EI Y) (EK0.endE Y (FT0.Ev[e].evA.mE Y wl0)) (EK0.endE Y (L1.s Y x)) =
   transH (FT0.Ev[e].endB-E Y wl0)
    (transH (apH {TC.THm (TR.RN.o Y) (TR.RN.o Y)} {EK1.TA.EI (TR.RN.o Y)} (\ k -> La.1 (TR.RN.o Y) k P.pe) (TR.fn.onId Y))
      (transH (symH (FT1.Ev[e].endB-E (TR.RN.o Y) (EK1.lineL (TR.RN.o Y) v)))
        (transH (apH {EK1.TV.EI (TR.RN.o Y)} {EK1.TA.EI (TR.RN.o Y)} (EK1.endE (TR.RN.o Y)) sv1.2)
          (symH P.pc)))) ;
  pth0 : Id (EK0.TV.EI Y) (FT0.Ev[e].evA.mE Y wl0) (L1.s Y x) = EK0.tv-eq Y (FT0.Ev[e].evA.mE Y wl0) (L1.s Y x) (refl P.x0) endE ;
  res : EK0.TS.EI Y = EK0.TS.pr Y (L1.s Y x) ((L0, eqL0), pth0) ;
 } ;
 mS (Y : Ob0) (v : TSU.EI Y) : EK0.TS.EI Y = MS[Y, v].res ;
 mSnat (Z Y : Ob0) (h : TR.RN.Hom0 Z Y) (v : TSU.EI Y) : Id (EK0.TS.EI Z) (EK0.TS.E.act Z Y h (mS Y v)) (mS Z (TSU.E.act Z Y h v)) =
  EK0.ts-ext Z (EK0.TS.E.act Z Y h (mS Y v)) (mS Z (TSU.E.act Z Y h v)) (symH (L1.sNat Z Y h MS[Y, v].x))
   (\ Vb g j -> transH (apH {EK0.TL.EI Z} {EK0.TA.EI Vb} (\ MM -> FT0.lval Z MM Vb g j) (EK0.lineL-act Z Y h (mS Y v)))
      (apH {W0.Ix (FT0.FE.ob Z)} {EK0.TA.EI Vb} (\ MM -> MM.1 Vb g j) (symH (RHE.rho.nt-nat Z Y h MS[Y, v].La)))) ;
 module Inj (Y : Ob0) (v v' : TSU.EI Y) (P : Id (W0.Ix (L1.DU.ob Y)) (TSU.pr1 Y v) (TSU.pr1 Y v')) (Q : Id (EK0.TS.EI Y) (mS Y v) (mS Y v')) {
  r0 : Id (W0.Ix (FT0.FE.ob Y)) MS[Y, v].L0 MS[Y, v'].L0 =
   FT0.FE.fam-eq Y MS[Y, v].L0 MS[Y, v'].L0 (\ Vb g j -> apH {EK0.TS.EI Y} {EK0.TA.EI Vb} (\ T -> EK0.lv Y T Vb g j) Q) ;
  r1 : Id (W0.Ix (FT1.FE.ob (TR.RN.o Y))) MS[Y, v].La MS[Y, v'].La = XE.rho-inj Y MS[Y, v].La MS[Y, v'].La r0 ;
  law : Id (TSU.EI Y) v v' =
   EK1.ts-ext (TR.RN.o Y) v v' P (\ Vb g j -> apH {W0.Ix (FT1.FE.ob (TR.RN.o Y))} {EK1.TA.EI Vb} (\ MM -> MM.1 Vb g j) r1) ;
 } ;
} ;
