-- CTotSet12.seg (canonicity-c2): D PRESERVES H-SETS. If A over G is a set
-- at the total site (Id_A between the two variables over G.A.A is a
-- proposition), then so is D A over D G: over D G . D A . D A the
-- identity type Id_{D A}(x , y) is a proposition (CwFHed6 with the
-- Hedberg data of CTotSet1-11).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;

module ST12 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.Ty (CTotCat[a, vl, l].TotOf[C].toP G))
  (pS : CTotR[a, vl, l].TotR[C].G1.fibCwF-T.El (CTotSet1[a, vl, l].ST1[C, G, A].E1)
          (CTotSet1[a, vl, l].ST1[C, G, A].PN1.isProp (CTotSet1[a, vl, l].ST1[C, G, A].E1) (CTotSet1[a, vl, l].ST1[C, G, A].IdA))) {
 module S11 = CTotSet11[a, vl, l].ST11[C, G, A, pS] ;
 module S5 = S11.S5 ;
 module G1 = S11.G1 ;
 module OV = S11.OV ;
 module PN1 = S11.S10.S1.PN1 ;
 module S2 = S11.S2 ;
 -- R is a proposition (CTotSet2), moved to the FC.subS form of R
 pRR : Id (G1.fibCwF-T.Ty S5.K) S2.R S11.R = refl S11.R ;
 pR : G1.fibCwF-T.El S5.K (PN1.isProp S5.K S11.R) =
  OV.trE S5.K (PN1.isProp S5.K S2.R) (PN1.isProp S5.K S11.R)
    (ap (G1.fibCwF-T.Ty S5.K) (G1.fibCwF-T.Ty S5.K) (\ T -> PN1.isProp S5.K T) S2.R S11.R pRR) S2.propR ;
 module H6 = CwFHed6.Hed6[l+, G1.fibCwF-T, G1.fibPi-T, G1.fibSig-T, G1.fibId-T, G1.nf-T] ;
 module HS = H6.S[S5.Ext, S5.SFT, S5.xq, S11.R, S5.At[pS].rho, S11.fT, pR] ;
 -- THE RESULT
 setD : G1.fibCwF-T.El S5.K (PN1.isProp S5.K S11.IK) = HS.propIK ;
} ;
