-- CPshSig.seg (canonicity-45; (B) stage 2(a), COBAR.md): Sigma types of
-- C-presheaves, a SigStr on the raw CwF CPCwF.
--   SG       Sigma A B as a C-type: the base's SigAB at each x; the
--            C-action on totals by flattening a Sigma-total to a total of B
--            (unflat . B.tE . flat), so that the laws are B's (tE-pt by
--            B.tE-pt and A.tE-pt; tE-id, tE-o by B's) and the readings
--            through a substitution are B's readings (SC.rBtE)
--   SigNatC  Sigma under a C-substitution: cty-ext2 with the base's SigNat
--            at each x, the actions compared through the readings
--   iso      elements of Sigma are pairs: the base's fst' / snd' / pair'
--            at each x, natural in C by the flattening
--   iso-nat  the base's iso-nat at each x (cel-subst, elTrC)
--   PSigC    the SigStr

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module PFm = PresheafFormers[a, l].PFormers[PB.BC] ;
module BF = PFm.F ;

module SigOf (C : SmallCat[a].SmallCat) {
 module P = CPshC[a, l].CPsh[C] ;
 module LO = CPshL[a, l].LOf[C] ;
 module EX = CPshExt[a, l].ExtOf[C] ;
 module CW = CPCwF[a, l].CwFOf[C] ;
 module CF = CwF.Formers[l+, CW.CPCwF] ;
 open P ;

 ------------------------------------------------------------------
 -- aa transported C-element in aa family of C-types is transported pointwise

 ovTr (G : CCtx) (X : U l+) (F0 : X -> CTy[G]) (aa aa' : X) (Q : Id X aa aa') (u : CEl[G, F0 aa]) (x : CO)
  : Id (PEl[G.ob x, (F0 aa').ty x]) ((subst X (\ a2 -> CEl[G, F0 a2]) aa aa' Q u).el x) (subst X (\ a2 -> PEl[G.ob x, (F0 a2).ty x]) aa aa' Q (u.el x)) =
  idJ X aa (\ a2 Q2 -> Id (PEl[G.ob x, (F0 a2).ty x]) ((subst X (\ a3 -> CEl[G, F0 a3]) aa a2 Q2 u).el x) (subst X (\ a3 -> PEl[G.ob x, (F0 a3).ty x]) aa a2 Q2 (u.el x)))
   (refl (u.el x)) aa' Q ;
 cel-over (G : CCtx) (X : U l+) (F0 : X -> CTy[G]) (aa aa' : X) (Q : Id X aa aa') (u : CEl[G, F0 aa]) (t : CEl[G, F0 aa'])
  (h : (x : CO) -> Id (PEl[G.ob x, (F0 aa').ty x]) (subst X (\ a2 -> PEl[G.ob x, (F0 a2).ty x]) aa aa' Q (u.el x)) (t.el x))
  : Id (CEl[G, F0 aa']) (subst X (\ a2 -> CEl[G, F0 a2]) aa aa' Q u) t =
  EX.cel-ext G (F0 aa') (subst X (\ a2 -> CEl[G, F0 a2]) aa aa' Q u) t (\ x X2 g -> apH (\ e -> e.eob X2 g) (transH (ovTr G X F0 aa aa' Q u x) (h x))) ;

 ------------------------------------------------------------------
 -- Sigma as a C-type

 module SG (G : CCtx) (A : CTy[G]) (B : CTy[LO.ExtC G A]) {
  Sx (x : CO) : PTy[G.ob x] = PFm.SigAB[G.ob x, A.ty x, B.ty x].SigP ;
  EA (x : CO) : PCtx = extP (G.ob x) (A.ty x) ;
  flat (x : CO) (X : Ob) (w : SigT (G.ob x) (Sx x) X) : SigT (EA x) (B.ty x) X =
   pairE (EA x) (B.ty x) X (pairE (G.ob x) (A.ty x) X (fstE (G.ob x) (Sx x) X w) (sndE (G.ob x) (Sx x) X w).1) (sndE (G.ob x) (Sx x) X w).2 ;
  unflat (x : CO) (X : Ob) (v : SigT (EA x) (B.ty x) X) : SigT (G.ob x) (Sx x) X =
   pairE (G.ob x) (Sx x) X (fstE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v))
    (sndE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v), sndE (EA x) (B.ty x) X v) ;

  -- flat and unflat commute with the base action (the B-action's proof differs: tact-irr)
  flat-act (x : CO) (Y X : Ob) (h : Hom Y X) (w : SigT (G.ob x) (Sx x) X)
   : Id (SigT (EA x) (B.ty x) Y) (flat x Y ((extP (G.ob x) (Sx x)).act Y X h w)) ((extP (EA x) (B.ty x)).act Y X h (flat x X w)) =
   apH (\ b -> pairE (EA x) (B.ty x) Y (pairE (G.ob x) (A.ty x) Y ((G.ob x).act Y X h (fstE (G.ob x) (Sx x) X w))
                                                 ((A.ty x).tact Y X h (fstE (G.ob x) (Sx x) X w) ((G.ob x).act Y X h (fstE (G.ob x) (Sx x) X w)) (refl ((G.ob x).act Y X h (fstE (G.ob x) (Sx x) X w))) (sndE (G.ob x) (Sx x) X w).1)) b)
    (tact-irr (EA x) (B.ty x) Y X h (pairE (G.ob x) (A.ty x) X (fstE (G.ob x) (Sx x) X w) (sndE (G.ob x) (Sx x) X w).1)
       (pairE (G.ob x) (A.ty x) Y ((G.ob x).act Y X h (fstE (G.ob x) (Sx x) X w))
          ((A.ty x).tact Y X h (fstE (G.ob x) (Sx x) X w) ((G.ob x).act Y X h (fstE (G.ob x) (Sx x) X w)) (refl ((G.ob x).act Y X h (fstE (G.ob x) (Sx x) X w))) (sndE (G.ob x) (Sx x) X w).1))
       (pair-act (G.ob x) (A.ty x) Y X h (fstE (G.ob x) (Sx x) X w) ((G.ob x).act Y X h (fstE (G.ob x) (Sx x) X w)) (refl ((G.ob x).act Y X h (fstE (G.ob x) (Sx x) X w))) (sndE (G.ob x) (Sx x) X w).1)
       (refl ((EA x).act Y X h (pairE (G.ob x) (A.ty x) X (fstE (G.ob x) (Sx x) X w) (sndE (G.ob x) (Sx x) X w).1)))
       (sndE (G.ob x) (Sx x) X w).2) ;
  unflat-act (x : CO) (Y X : Ob) (h : Hom Y X) (v : SigT (EA x) (B.ty x) X)
   : Id (SigT (G.ob x) (Sx x) Y) (unflat x Y ((extP (EA x) (B.ty x)).act Y X h v)) ((extP (G.ob x) (Sx x)).act Y X h (unflat x X v)) =
   apH (\ b -> pairE (G.ob x) (Sx x) Y ((G.ob x).act Y X h (fstE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v)))
                 ((A.ty x).tact Y X h (fstE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v)) ((G.ob x).act Y X h (fstE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v))) (refl ((G.ob x).act Y X h (fstE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v)))) (sndE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v)), b))
    (tact-irr (EA x) (B.ty x) Y X h (fstE (EA x) (B.ty x) X v) ((EA x).act Y X h (fstE (EA x) (B.ty x) X v))
       (refl ((EA x).act Y X h (fstE (EA x) (B.ty x) X v)))
       (pair-act (G.ob x) (A.ty x) Y X h (fstE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v)) ((G.ob x).act Y X h (fstE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v))) (refl ((G.ob x).act Y X h (fstE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v)))) (sndE (G.ob x) (A.ty x) X (fstE (EA x) (B.ty x) X v)))
       (sndE (EA x) (B.ty x) X v)) ;

  -- the C-action
  tEs (y x : CO) (f : CH y x) (X : Ob) (w : SigT (G.ob x) (Sx x) X) : SigT (G.ob y) (Sx y) X = unflat y X ((B.tE y x f).nt X (flat x X w)) ;
  tEsP (y x : CO) (f : CH y x) : PSub[extP (G.ob x) (Sx x), extP (G.ob y) (Sx y)] =
   new PSub[extP (G.ob x) (Sx x), extP (G.ob y) (Sx y), tEs y x f,
    \ Y X h w -> transH (apH (unflat y Y) (transH (apH ((B.tE y x f).nt Y) (flat-act x Y X h w)) ((B.tE y x f).nt-nat Y X h (flat x X w))))
                   (unflat-act y Y X h ((B.tE y x f).nt X (flat x X w)))] ;
  SigC : CTy[G] =
   new CTy[G, Sx, tEsP,
    \ y x f X w -> transH (apH (fstE (G.ob y) (A.ty y) X) (B.tE-pt y x f X (flat x X w)))
                     (A.tE-pt y x f X (pairE (G.ob x) (A.ty x) X (fstE (G.ob x) (Sx x) X w) (sndE (G.ob x) (Sx x) X w).1)),
    \ x X w -> apH (unflat x X) (B.tE-id x X (flat x X w)),
    \ z y x f h X w -> apH (unflat z X) (B.tE-o z y x f h X (flat x X w))] ;

  ------------------------------------------------------------------
  -- elements of Sigma are pairs

  fstC (u : CEl[G, SigC]) : CEl[G, A] =
   new CEl[G, A, \ x -> PFm.SigAB[G.ob x, A.ty x, B.ty x].fst' (u.el x),
    \ y x f X g -> transH (symH (B.tE-pt y x f X (flat x X (pairE (G.ob x) (Sx x) X g ((u.el x).eob X g)))))
                    (apH (\ w -> pairE (G.ob y) (A.ty y) X (fstE (G.ob y) (Sx y) X w) (sndE (G.ob y) (Sx y) X w).1) (u.el-nat y x f X g))] ;
  module SCs (aa : CEl[G, A]) { module M = LO.SC[G, LO.ExtC G A, CW.secC G A aa, B] ; } ;
  sndTy (aa : CEl[G, A]) : CTy[G] = LO.subCTy G (LO.ExtC G A) (CW.secC G A aa) B ;
  sndC (u : CEl[G, SigC]) : CEl[G, sndTy (fstC u)] =
   new CEl[G, sndTy (fstC u), \ x -> PFm.SigAB[G.ob x, A.ty x, B.ty x].snd' (u.el x),
    \ y x f X g ->
     SCs[fstC u].M.sub-eq y X _ _ (refl ((G.act y x f).nt X g))
      (transH (SCs[fstC u].M.rBtE y x f X (pairE (G.ob x) (SCs[fstC u].M.ST x) X g ((u.el x).eob X g).2))
        (apH (flat y X) (u.el-nat y x f X g)))] ;
  pairC (ab : (aa : CEl[G, A]) * CEl[G, sndTy aa]) : CEl[G, SigC] =
   new CEl[G, SigC, \ x -> PFm.SigAB[G.ob x, A.ty x, B.ty x].pair' ((ab.1).el x, (ab.2).el x),
    \ y x f X g ->
     apH {SigT (EA y) (B.ty y) X} {SigT (G.ob y) (Sx y) X} (unflat y X)
      {(B.tE y x f).nt X (flat x X (pairE (G.ob x) (Sx x) X g (((ab.1).el x).eob X g, ((ab.2).el x).eob X g)))}
      {SCs[ab.1].M.rB y X (pairE (G.ob y) (SCs[ab.1].M.ST y) X ((G.act y x f).nt X g) (((ab.2).el y).eob X ((G.act y x f).nt X g)))}
      (transH (symH (SCs[ab.1].M.rBtE y x f X (pairE (G.ob x) (SCs[ab.1].M.ST x) X g (((ab.2).el x).eob X g))))
        (apH (SCs[ab.1].M.rB y X) ((ab.2).el-nat y x f X g)))] ;

  fst-pair (ab : (aa : CEl[G, A]) * CEl[G, sndTy aa]) : Id (CEl[G, A]) (fstC (pairC ab)) ab.1 =
   EX.cel-ext G A (fstC (pairC ab)) ab.1 (\ x X g -> refl (((ab.1).el x).eob X g)) ;
  snd-pair (ab : (aa : CEl[G, A]) * CEl[G, sndTy aa])
   : Id (CEl[G, sndTy ab.1]) (subst (CEl[G, A]) (\ a2 -> CEl[G, sndTy a2]) (fstC (pairC ab)) ab.1 (fst-pair ab) (sndC (pairC ab))) ab.2 =
   cel-over G (CEl[G, A]) sndTy (fstC (pairC ab)) ab.1 (fst-pair ab) (sndC (pairC ab)) ab.2 (\ x ->
    transH (subst-ap (CEl[G, A]) (PEl[G.ob x, A.ty x]) (\ a2 -> a2.el x) (\ a3 -> PEl[G.ob x, subTy (G.ob x) (EA x) (B.ty x) (secP (G.ob x) (A.ty x) a3)])
              (fstC (pairC ab)) ab.1 (fst-pair ab) ((sndC (pairC ab)).el x))
     (transH (apH (\ pp -> subst (PEl[G.ob x, A.ty x]) (\ a3 -> PEl[G.ob x, subTy (G.ob x) (EA x) (B.ty x) (secP (G.ob x) (A.ty x) a3)])
                              ((fstC (pairC ab)).el x) ((ab.1).el x) pp ((sndC (pairC ab)).el x))
                (isSet-PEl (G.ob x) (A.ty x) ((fstC (pairC ab)).el x) ((ab.1).el x)
                   (apH (\ a2 -> a2.el x) (fst-pair ab)) (PFm.SigAB[G.ob x, A.ty x, B.ty x].fst-pair ((ab.1).el x, (ab.2).el x))))
       (PFm.el-over (G.ob x) (PEl[G.ob x, A.ty x]) (\ a3 -> subTy (G.ob x) (EA x) (B.ty x) (secP (G.ob x) (A.ty x) a3))
          ((fstC (pairC ab)).el x) ((ab.1).el x) (PFm.SigAB[G.ob x, A.ty x, B.ty x].fst-pair ((ab.1).el x, (ab.2).el x))
          (refl (\ I x2 -> (B.ty x).tob I (pairE (G.ob x) (A.ty x) I x2 (((ab.1).el x).eob I x2))))
          ((sndC (pairC ab)).el x) ((ab.2).el x) (\ I x2 -> refl (((ab.2).el x).eob I x2))))) ;

  iso : Iso (CEl[G, SigC]) ((aa : CEl[G, A]) * CEl[G, sndTy aa]) = new IsoData[CEl[G, SigC], (aa : CEl[G, A]) * CEl[G, sndTy aa],
   fun := \ u -> (fstC u, sndC u),
   inv := pairC,
   fun-inv := \ ab -> Sigma-path (CEl[G, A]) (\ a2 -> CEl[G, sndTy a2]) (fstC (pairC ab)) ab.1 (sndC (pairC ab)) ab.2 (fst-pair ab) (snd-pair ab),
   inv-fun := \ u -> EX.cel-ext G SigC (pairC (fstC u, sndC u)) u (\ x X g -> refl ((u.el x).eob X g)) ] ;
 } ;

 ------------------------------------------------------------------
 -- Sigma under a C-substitution

 module SigNatC (D G : CCtx) (s : CSub[D, G]) (A : CTy[G]) (B : CTy[LO.ExtC G A]) {
  module SGg = SG[G, A, B] ;
  -- the Sigma at D is instantiated at the CwF record's own spelling of
  -- A[s] and B[lift s], so that the SigStr's types meet it syntactically
  -- (the same types in the LOf spelling convert, but not within 10 s)
  module SGd = SG[D, CW.CPCwF.subT D G A s, CW.CPCwF.subT (CW.CPCwF.ext D (CW.CPCwF.subT D G A s)) (CW.CPCwF.ext G A) B (CW.CPCwF.lift D G A s)] ;
  module SCS = LO.SC[D, G, s, SGg.SigC] ;
  module SCB = LO.SC[LO.ExtC D (LO.subCTy D G s A), LO.ExtC G A, CW.liftC D G A s, B] ;
  Pf (x : CO) : Id (PTy[D.ob x]) (SCS.ST x) (SGd.Sx x) = PFm.SigNat[D.ob x, G.ob x, A.ty x, B.ty x, s.sb x].nat ;
  -- the two actions agree, through the readings
  agree (y x : CO) (f : CH y x) (X : Ob) (w : SigT (D.ob x) (SCS.ST x) X) : Id (SigT (D.ob y) (SGd.Sx y) X) (SGd.tEs y x f X w) (SCS.tEs y x f X w) =
   SCS.sub-eq y X (SGd.tEs y x f X w) (SCS.tEs y x f X w) (refl ((D.act y x f).nt X (fstE (D.ob x) (SCS.ST x) X w)))
    (transH (apH (SGg.unflat y X) (SCB.rBtE y x f X (SGd.flat x X w))) (symH (SCS.rBtE y x f X w))) ;
  Q (y x : CO) (f : CH y x) (X : Ob) (w : SigT (D.ob x) (SCS.ST x) X)
   : Id (SigT (D.ob y) (SGd.Sx y) X)
      ((SGd.SigC.tE y x f).nt X (subst (PTy[D.ob x]) (\ T -> SigT (D.ob x) T X) (SCS.ST x) (SGd.Sx x) (Pf x) w))
      (subst (PTy[D.ob y]) (\ T -> SigT (D.ob y) T X) (SCS.ST y) (SGd.Sx y) (Pf y) ((SCS.subCTy.tE y x f).nt X w)) =
   transH (apH (SGd.tEs y x f X) (EX.tyTr-same (D.ob x) (SCS.ST x) (SGd.Sx x) (Pf x) (refl (SGd.Sx x).tob) X w))
    (transH (agree y x f X w)
      (symH (EX.tyTr-same (D.ob y) (SCS.ST y) (SGd.Sx y) (Pf y) (refl (SGd.Sx y).tob) X (SCS.tEs y x f X w)))) ;
  nat : Id (CTy[D]) (LO.subCTy D G s SGg.SigC) SGd.SigC = EX.cty-ext2 D (LO.subCTy D G s SGg.SigC) SGd.SigC Pf Q ;
  opaque nat ;

  -- the pairs under substitution: the base's iso-nat at each x
  BsT (aa : CEl[G, A]) : CTy[D] = LO.subCTy D G s (SGg.sndTy aa) ;
  BtT (aa : CEl[G, A]) : CTy[D] = SGd.sndTy (CW.subCEl D G A aa s) ;
  cTy (aa : CEl[G, A]) : Id (CTy[D]) (BsT aa) (BtT aa) = CF.coerce D G A B aa s ;
  e2a (aa : CEl[G, A]) (b : CEl[G, SGg.sndTy aa]) (x : CO)
   : Id (PEl[D.ob x, (BtT aa).ty x])
      ((subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s)).el x)
      (subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) ((BsT aa).ty x) ((BtT aa).ty x) (apH (\ X -> X.ty x) (cTy aa)) (subEl (D.ob x) (G.ob x) ((SGg.sndTy aa).ty x) (b.el x) (s.sb x))) =
   CW.elTrC D (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s) x ;
  opaque e2a ;
  e2b (aa : CEl[G, A]) (x : CO) : Id (Id (PTy[D.ob x]) ((BsT aa).ty x) ((BtT aa).ty x)) (apH (\ X -> X.ty x) (cTy aa)) (BF.coerce (D.ob x) (G.ob x) (A.ty x) (B.ty x) (aa.el x) (s.sb x)) =
   isSet-PTy (D.ob x) ((BsT aa).ty x) ((BtT aa).ty x) (apH (\ X -> X.ty x) (cTy aa)) (BF.coerce (D.ob x) (G.ob x) (A.ty x) (B.ty x) (aa.el x) (s.sb x)) ;
  opaque e2b ;
  e2 (aa : CEl[G, A]) (b : CEl[G, SGg.sndTy aa]) (x : CO)
   : Id (PEl[D.ob x, (BtT aa).ty x])
      ((subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s)).el x)
      (subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) ((BsT aa).ty x) ((BtT aa).ty x)
         (BF.coerce (D.ob x) (G.ob x) (A.ty x) (B.ty x) (aa.el x) (s.sb x)) (subEl (D.ob x) (G.ob x) ((SGg.sndTy aa).ty x) (b.el x) (s.sb x))) =
   transH {PEl[D.ob x, (BtT aa).ty x]}
     {(subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s)).el x}
     {subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) ((BsT aa).ty x) ((BtT aa).ty x) (apH (\ X -> X.ty x) (cTy aa)) (subEl (D.ob x) (G.ob x) ((SGg.sndTy aa).ty x) (b.el x) (s.sb x))}
     {subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) ((BsT aa).ty x) ((BtT aa).ty x) (BF.coerce (D.ob x) (G.ob x) (A.ty x) (B.ty x) (aa.el x) (s.sb x)) (subEl (D.ob x) (G.ob x) ((SGg.sndTy aa).ty x) (b.el x) (s.sb x))}
     (e2a aa b x)
     (apH {Id (PTy[D.ob x]) ((BsT aa).ty x) ((BtT aa).ty x)} {PEl[D.ob x, (BtT aa).ty x]}
        (\ pp -> subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) ((BsT aa).ty x) ((BtT aa).ty x) pp (subEl (D.ob x) (G.ob x) ((SGg.sndTy aa).ty x) (b.el x) (s.sb x)))
        {apH (\ X -> X.ty x) (cTy aa)} {BF.coerce (D.ob x) (G.ob x) (A.ty x) (B.ty x) (aa.el x) (s.sb x)} (e2b aa x)) ;
  opaque e2 ;
  pairD (aa : CEl[G, A]) (x0 : CO) (e : PEl[D.ob x0, (BtT aa).ty x0]) : PEl[D.ob x0, SGd.Sx x0] =
   PFm.SigAB[D.ob x0, (CW.CPCwF.subT D G A s).ty x0, (CW.CPCwF.subT (CW.CPCwF.ext D (CW.CPCwF.subT D G A s)) (CW.CPCwF.ext G A) B (CW.CPCwF.lift D G A s)).ty x0].pair' (subEl (D.ob x0) (G.ob x0) (A.ty x0) (aa.el x0) (s.sb x0), e) ;
  hx (aa : CEl[G, A]) (b : CEl[G, SGg.sndTy aa]) (x : CO)
   : Id (PEl[D.ob x, SGd.Sx x])
      (subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) (SCS.ST x) (SGd.Sx x) (Pf x) ((CW.subCEl D G SGg.SigC (SGg.pairC (aa, b)) s).el x))
      ((SGd.pairC (CW.subCEl D G A aa s, subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s))).el x) =
   transH {PEl[D.ob x, SGd.Sx x]}
     {subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) (SCS.ST x) (SGd.Sx x) (Pf x) ((CW.subCEl D G SGg.SigC (SGg.pairC (aa, b)) s).el x)}
     {pairD aa x (subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) ((BsT aa).ty x) ((BtT aa).ty x) (BF.coerce (D.ob x) (G.ob x) (A.ty x) (B.ty x) (aa.el x) (s.sb x)) (subEl (D.ob x) (G.ob x) ((SGg.sndTy aa).ty x) (b.el x) (s.sb x)))}
     {pairD aa x ((subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s)).el x)}
     (PFm.SigNat[D.ob x, G.ob x, A.ty x, B.ty x, s.sb x].iso-nat (aa.el x) (b.el x))
     (apH {PEl[D.ob x, (BtT aa).ty x]} {PEl[D.ob x, SGd.Sx x]} (pairD aa x)
        {subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) ((BsT aa).ty x) ((BtT aa).ty x) (BF.coerce (D.ob x) (G.ob x) (A.ty x) (B.ty x) (aa.el x) (s.sb x)) (subEl (D.ob x) (G.ob x) ((SGg.sndTy aa).ty x) (b.el x) (s.sb x))}
        {(subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s)).el x}
        (symH {PEl[D.ob x, (BtT aa).ty x]}
           {(subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s)).el x}
           {subst (PTy[D.ob x]) (\ X -> PEl[D.ob x, X]) ((BsT aa).ty x) ((BtT aa).ty x) (BF.coerce (D.ob x) (G.ob x) (A.ty x) (B.ty x) (aa.el x) (s.sb x)) (subEl (D.ob x) (G.ob x) ((SGg.sndTy aa).ty x) (b.el x) (s.sb x))}
           (e2 aa b x))) ;
  opaque hx ;
  iso-nat (aa : CEl[G, A]) (b : CEl[G, SGg.sndTy aa])
   : Id (CEl[D, SGd.SigC])
      (subst (CTy[D]) (\ X -> CEl[D, X]) (LO.subCTy D G s SGg.SigC) SGd.SigC nat (CW.subCEl D G SGg.SigC (SGg.pairC (aa, b)) s))
      (SGd.pairC (CW.subCEl D G A aa s, subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s))) =
   CW.cel-subst D (LO.subCTy D G s SGg.SigC) SGd.SigC nat Pf (CW.subCEl D G SGg.SigC (SGg.pairC (aa, b)) s)
    (SGd.pairC (CW.subCEl D G A aa s, subst (CTy[D]) (\ X -> CEl[D, X]) (BsT aa) (BtT aa) (cTy aa) (CW.subCEl D G (SGg.sndTy aa) b s)))
    (hx aa b) ;
  opaque iso-nat ;
 } ;

 PSigC : CF.SigStr = new CF.SigStr[
  Sig         := \ G A B -> SG[G, A, B].SigC,
  Sig-nat     := \ D G A B s -> SigNatC[D, G, s, A, B].nat,
  Sig-iso     := \ G A B -> SG[G, A, B].iso,
  Sig-iso-nat := \ D G A B aa b s -> SigNatC[D, G, s, A, B].iso-nat aa b ] ;
} ;
