-- Naturality of the restricted ext constructor.
level l ; constraint a <= l ;
open Base ; open Prelude[l+] ; open Paths[l+] ;
open Axioms[l+].FunExtLemmas[fe @(l+)] ;
module W = V[l] ;
open Trees[a] ; open Arith[a] ;
module PR = PB.GPre[l] ; open PR.PS ;
open GCTruncRaw[l] ;

module Nat (G : PCtx) (A : PTy[G]) {
  open Build[G, A] ;
  open GCTruncGood[l].GoodSets[G, A] ;
  open GCTruncLaws[l].Laws[G, A] ;
  open GCTruncExt[l].Ops[G, A] ;

  module Restrict (z : Loc) (Q : PB.Phi z.1) (u : TrEl z) (v : Partial z Q) (vn : Natural z Q v)
    (s : Loc) (h : Arr s z) {
    module E = Extend[z, Q, u, v, vn] ;
    R : PB.Phi s.1 = PB.pre s.1 z.1 h.1 Q ;
    rv (r : Loc) (g : Arr r s) (i : PB.Lands r.1 s.1 R g.1) : TrEl r =
      v r (compose r s z h g) (lp r s z Q h g i) ;
    rvn : Natural s R rv = \ r g i q f j ->
      transH (vn r (compose r s z h g) (lp r s z Q h g i) q f
        (PB.lands-comp q.1 r.1 z.1 Q (compose r s z h g).1 f.1 (lp r s z Q h g i)))
        (partial-cong z Q v q _ _ (compose-assoc q r s z h g f) _ (lp q s z Q h (compose q r s g f) j)) ;
    opaque rvn ;
    module F = Extend[s, R, tr-res s z h u, rv, rvn] ;
    goal : U l = Id (TrEl s) (tr-res s z h E.value) F.value ;

    inside (i : PB.Lands s.1 z.1 Q h.1) : goal =
      transH (E.boundary s h i)
        (transH (partial-cong z Q v s h (compose s s z h (ident s)) (symH (compose-idr s z h)) i (lp s s z Q h (ident s) j))
          (symH (F.full j)))
      where { j : PB.Lands s.1 s.1 R (idH s.1) =
        PB.pre-lands s.1 s.1 z.1 h.1 Q (idH s.1)
          (PB.lands-eq s.1 z.1 Q h.1 (compH s.1 s.1 z.1 h.1 (idH s.1)) (symH (comp-idr s.1 z.1 h.1)) i) ; } ;
    opaque inside ;

    root-outside (no : Id Bool (dec s.1 z.1 Q h.1) false) : Id Bool (dec z.1 z.1 Q (idH z.1)) false =
      decide (Id Bool (dec z.1 z.1 Q (idH z.1)) false) (dec z.1 z.1 Q (idH z.1))
        (\ i -> absurd (Id Bool (dec z.1 z.1 Q (idH z.1)) false)
          (false-true (transH (symH no)
            (ofL s.1 z.1 Q h.1
              (PB.lands-eq s.1 z.1 Q (compH s.1 z.1 z.1 (idH z.1) h.1) h.1 (comp-idl s.1 z.1 h.1)
                (PB.lands-comp s.1 z.1 z.1 Q (idH z.1) h.1 (toL z.1 z.1 Q (idH z.1) i)))))))
        (\ n -> n) ;
    opaque root-outside ;

    module Outside (no : Id Bool (dec s.1 z.1 Q h.1) false) {
      module NN = N[z, Q, E.us, E.vs] ;
      n0 : Id Bool (dec z.1 z.1 Q (idH z.1)) false = root-outside no ;
      n1 : Id Bool (dec s.1 s.1 R (idH s.1)) false =
        transH (dec-pre s.1 z.1 Q h.1) no ;
      left : Id Raw (tr-res s z h E.value).1 (NN.R s h) =
        transH (at-cong E.tree (node z Q E.us E.vs) (E.outside n0) z E.witness.2 (refl z) s h)
          (NN.outside s h no) ;
      middle : Id Raw (NN.R s h) (node s R F.us F.vs) =
        node-cong s R R (refl R)
          (\ r g -> E.us r (compose r s z h g)) F.us
          (\ r g i -> E.vs r (compose r s z h g) (lp r s z Q h g i)) F.vs
          (\ r g -> apH (\ t -> t.1) (symH (tr-res-o r s z h g u)))
          (\ r g i j -> boundary-cong z Q E.vs r _ _ (refl (compose r s z h g)) (lp r s z Q h g i) (lp r s z Q h g j)) ;
      result : goal = tr-eq s _ _ (transH left (transH middle (symH (F.outside n1)))) ;
    } ;
    uniform : goal = decideL goal s.1 z.1 Q h.1 inside (\ no -> Outside[no].result) ;
    opaque uniform ;
  } ;
} ;
