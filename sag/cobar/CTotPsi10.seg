-- CTotPsi10.seg (canonicity-c2; SIMPLIFIED.md step 4): Lemma 11 for
-- lines at the total site, part 10: Psi on points is natural along total
-- maps (s-nat of CMove.Mv): lines by CTotPsi9, end elements by the
-- reading of D A's action at the moved index (pr-coe).
level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[vl] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module PB = PosFull[a].PB ;
module Wt = Weights[a, l] ;

module Psi10 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx)
  (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) (e : CTotR[a, vl, l].TotR[C].G1.GB.IPt) {
 module P7 = CTotPsi7[a, vl, l].Psi7[C, G, A, e] ;
 module P9 = CTotPsi9[a, vl, l].Psi9[C, G] ;
 module P6 = P7.P6 ;
 module PO = P6.PO ;
 module TR = PO.TR ;
 module TC = PO.TC ;
 module DO = PO.DO ;
 module D = PO.D ;
 module CT = PO.CT ;
 module DA = P6.DA ;
 module EKg = P6.EKg ;
 module EKd = P6.EKd ;
 module DV = P6.DV ;
 Obj (I : Ob) : U vl = PO.VT.Obj I ;
 psi (X : TC.TOb) (w : W0.Ix (EKd.TV.E.ob X)) : DV.Ob' X.1 X.2 = P7.PE[X, w].PsiPt ;

 module SN (X' X : TC.TOb) (g : TC.THm X' X) (w : W0.Ix (EKd.TV.E.ob X)) {
  w' : W0.Ix (EKd.TV.E.ob X') = EKd.TV.E.act X' X g w ;
  module PX = P6.PP[X, w] ;
  module PY = P6.PP[X', w'] ;
  module PN = P9.PNat[X', X, g, PX.ln] ;
  I : Ob = X.1 ;
  x : Obj I = X.2 ;
  module VQ (q : DO.Idx X'.1 X'.2) (lq : DO.LandsI X'.1 X'.2 q) {
   rq : DO.Idx I x = D.Act[X'.1, I, g.1, X'.2, x, g.2, PX.u0].rq q ;
   module QY = PY.PQ[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)] ;
   module QX = PX.PQ[rq.1, rq.2.1, rq.2.2.1, rq.2.2.2.1, rq.2.2.2.2.1, (rq.2.2.2.2.2, lq)] ;
   Y : TC.TOb = (q.2.1, q.2.2.2.1) ;
   E' : Id (D.Ob' X'.1 X'.2) (D.act X'.1 I g.1 X'.2 x g.2 PX.u0) PY.u0 =
    TR.P1.ntEq PO.FL.GI PO.DG (PO.FL.ev e) X' X g PX.ln (PO.FL.actF X' X g PX.ln) (refl (PO.FL.actF X' X g PX.ln)) ;
   law : Id (W0.Ix (P6.TVC.ob Y)) QY.pt QX.pt =
    EKg.tv-eq Y QY.pt QX.pt (PN.PQe[q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2.1, (q.2.2.2.2.2, lq)].law)
     (transH QY.pc
       (transH (symH (EKg.TA.pr-coe Y (PX.u0.1 rq lq) (PY.u0.1 q lq) (apH {D.Ob' X'.1 X'.2} {W0.Ix (G.ob q.2.1 q.2.2.2.1)} (\ vv -> vv.1 q lq) E') (PX.av.1 rq lq)))
         (symH QX.pc))) ;
  } ;
  law : Id (DV.Ob' X'.1 X'.2) (psi X' w') (DV.act X'.1 I g.1 X'.2 x g.2 (psi X w)) =
   DV.ob-eq X'.1 X'.2 (psi X' w') (DV.act X'.1 I g.1 X'.2 x g.2 (psi X w)) (\ q lq -> VQ[q, lq].law) ;
 } ;
} ;
