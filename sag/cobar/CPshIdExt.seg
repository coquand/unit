-- CPshIdExt.seg (canonicity-c2; COBAR.md (B), the S3 bridge, part
-- (II-b)): a ContrOp of Sigma Y Path gives one of Sigma Y Id.
--
-- NEW ARGUMENT (not the base's).  FibS3's S3a obtains a ContrOp on
-- HFibId = Sigma Y IdOver from the equivalence Id -> Path (CIdEquiv, which
-- uses the fillers of the path type) and FibC2.  Here it is direct, with
-- no filler: the base's S3a does not need the path fillers.
--
-- IdExt.  Let eop be a ContrOp of core's homotopy fibre HFib = Sigma Y Path
-- over G.X, and s a side of HFibId at (X0 , d).  Its image in HFib
-- (forget the sieves) is extended by eop: (y* , p*).  The extension of s
-- is (y* , (p* , ph)) where ph is the dependent conjunction (CId.DCL, the
-- construction CIdEquiv uses for its sieve of the same name) of s's sieve
-- with the family f |-> the sieve of the Id part of s at f.
--   c       p* is constant on ph: at f in ph it restricts to the path
--           part of s at f (eop's kside), which is constant on its own
--           sieve, and the identity is in that sieve
--   kside   same image in HFib (eop's kside) and same sieve (DCL.dc-at)
--   kunif   same image in HFib (eop's kunif, Map.side-res) and same sieve
--           (DCL.dc-restr)
-- contrFV: FV1 = Sigma Y YonedaId is a retract of HFibId (toS , frS).
level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module PB = PosFull[a].PB ;
module GPR = PB.GPre[l] ;
open GPR.PS ;
module HO = PB.CHtpyOps[l] ;
module CP = PB.CPartial[l] ;
module LR = CLocBoundRetr[a, l] ;
module YCm = FibYC[a, l] ;
module RF = CPshFibMaps[a, l] ;

module IdExt (G : PCtx) (Y X : PTy[G]) (al : CP.PMap[G, Y, X])
 (eop : CP.ContrOp RF.RawFib[G, Y, X, al].D RF.RawFib[G, Y, X, al].HF.FibT) {
 module R = RF.RawFib[G, Y, X, al] ;
 module IO = R.YC.IO ;
 module PI = CP.Partials[R.D, R.HFibId] ;
 module MP = LR.Map[R.D, R.HFibId, R.HF.FibT, R.prjS] ;
 module TH = GPR.TyL[R.D, R.HFibId] ;
 module TFb = GPR.TyL[R.D, R.HF.FibT] ;
 dcc : PB.CId[l].DConj = PosId[a, l].dc ;

 -- two totals of HFibId with the same image in HFib and the same sieve
 flatI (W : Ob) (u : TH.EI W) : IO.TI.EI W =
  IO.TI.pr W (pairE R.D R.HF.B1 W (TH.pr1 W u) (TH.pr2 W u).1) (TH.pr2 W u).2 ;
 unflatI (W : Ob) (z : IO.TI.EI W) : TH.EI W =
  TH.pr W (fstE R.D R.HF.B1 W (IO.TI.pr1 W z)) (sndE R.D R.HF.B1 W (IO.TI.pr1 W z), IO.TI.pr2 W z) ;
 upI (W : Ob) (u u' : TH.EI W) (E : Id (TFb.EI W) (MP.onE W u) (MP.onE W u'))
  (Q : Id (PB.Phi W) (TH.pr2 W u).2.2.1 (TH.pr2 W u').2.2.1) : Id (TH.EI W) u u' =
  apH (\ z -> unflatI W z)
   (IO.tpI-ext W (flatI W u) (flatI W u')
      (apH (\ t -> pairE R.D R.HF.B1 W (TFb.pr1 W t) (TFb.pr2 W t).1) E)
      (\ V1 g j -> apH (\ t -> (TFb.pr2 W t).2.1.1 V1 g j) E) Q) ;

 module Ex (X0 : Ob) (d : W0.Ix (R.D.ob X0)) (s : PI.Side[X0, d]) {
  sP : CP.Partials[R.D, R.HF.FibT].Side[X0, d] = MP.side X0 d s ;
  kv : W0.Ix (R.HF.FibT.tob X0 d) = eop.kop X0 d sP ;
  kz : W0.Ix (R.K.ob X0) = pairE R.D R.HF.B1 X0 d kv.1 ;
  -- the sieves of the Id parts of the side
  Fs (V1 : Ob) (f : Hom V1 X0) (i : PB.Lands V1 X0 s.pQ f) : PB.Phi V1 = (TH.pr2 V1 (s.pv V1 f i)).2.2.1 ;
  Fn (V1 W : Ob) (g : Hom V1 W) (f : Hom W X0) (i : PB.Lands W X0 s.pQ f) (i' : PB.Lands V1 X0 s.pQ (compH V1 W X0 f g))
   : Id (PB.Phi V1) (PB.pre V1 W g (Fs W f i)) (Fs V1 (compH V1 W X0 f g) i') =
   apH (\ t -> (TH.pr2 V1 t).2.2.1) (s.pnat V1 W g f i i') ;
  module DL = PB.CId[l].DCL[dcc, X0, s.pQ, Fs, Fn] ;
  ph : PB.Phi X0 = DL.DQ ;
  -- eop's extension restricts to the image of the side
  ks (W : Ob) (f : Hom W X0) (i : PB.Lands W X0 s.pQ f)
   : Id (TFb.EI W) (TFb.E.act W X0 f (TFb.pr X0 d kv)) (MP.onE W (s.pv W f i)) = eop.kside X0 d sP W f i ;
  -- p* is constant on ph
  module Cc (W : Ob) (f : Hom W X0) (l0 : PB.Lands W X0 ph f) (k : Hom W Iv) {
   i0 : PB.Lands W X0 s.pQ f = (dcc.dc-out W X0 s.pQ Fs Fn f l0).1 ;
   j0 : PB.Lands W W (Fs W f i0) (idH W) = (dcc.dc-out W X0 s.pQ Fs Fn f l0).2 ;
   tf : TH.EI W = s.pv W f i0 ;
   kzf : W0.Ix (R.K.ob W) = pairE R.D R.HF.B1 W (TH.pr1 W tf) (TH.pr2 W tf).1 ;
   qk : Id (W0.Ix (R.K.ob W)) (R.K.act W X0 f kz) kzf =
    apH (\ t -> pairE R.D R.HF.B1 W (TFb.pr1 W t) (TFb.pr2 W t).1) (ks W f i0) ;
   res : Id (IO.TA.EI W) (kv.2.1.1 W f k) (R.HF.aE W (R.K.act W X0 f kz)) =
    transH (apH (\ m -> kv.2.1.1 W m k) (symH (comp-idr W X0 f)))
     (transH (apH (\ t -> (TFb.pr2 W t).2.1.1 W (idH W) k) (ks W f i0))
       (transH ((TH.pr2 W tf).2.2.2 W (idH W) j0 k)
         (apH (\ z -> R.HF.aE W z) (transH (R.K.act-id W kzf) (symH qk))))) ;
  } ;
  c : IO.ConstC X0 kz kv.2 ph = \ W f l0 k -> Cc[W, f, l0, k].res ;
  vstar : W0.Ix (IO.tobI X0 kz) = (kv.2, (ph, c)) ;
  kopI : W0.Ix (R.HFibId.tob X0 d) = (kv.1, vstar) ;
 } ;

 kop (X0 : Ob) (d : W0.Ix (R.D.ob X0)) (s : PI.Side[X0, d]) : W0.Ix (R.HFibId.tob X0 d) = Ex[X0, d, s].kopI ;
 -- by definition: the image in HFib of the extension is eop's extension
 kop-P (X0 : Ob) (d : W0.Ix (R.D.ob X0)) (s : PI.Side[X0, d])
  : Id (TFb.EI X0) (MP.onE X0 (TH.pr X0 d (kop X0 d s))) (TFb.pr X0 d Ex[X0, d, s].kv) = refl (TFb.pr X0 d Ex[X0, d, s].kv) ;

 kside (X0 : Ob) (d : W0.Ix (R.D.ob X0)) (s : PI.Side[X0, d]) (W : Ob) (f : Hom W X0) (i : PB.Lands W X0 s.pQ f)
  : Id (TH.EI W) (TH.E.act W X0 f (TH.pr X0 d (kop X0 d s))) (s.pv W f i) =
  upI W (TH.E.act W X0 f (TH.pr X0 d (kop X0 d s))) (s.pv W f i)
   (transH (symH (MP.act W X0 f (TH.pr X0 d (kop X0 d s)))) (Ex[X0, d, s].ks W f i))
   (Ex[X0, d, s].DL.dc-at W f i) ;

 module Un (Y0 X0 : Ob) (h : Hom Y0 X0) (d : W0.Ix (R.D.ob X0)) (s : PI.Side[X0, d]) {
  module E0 = Ex[X0, d, s] ;
  module E1 = Ex[Y0, R.D.act Y0 X0 h d, PI.rside Y0 X0 h d s] ;
  eP : Id (TFb.EI Y0) (MP.onE Y0 (TH.E.act Y0 X0 h (TH.pr X0 d (kop X0 d s))))
        (MP.onE Y0 (TH.pr Y0 (R.D.act Y0 X0 h d) (kop Y0 (R.D.act Y0 X0 h d) (PI.rside Y0 X0 h d s)))) =
   transH (symH (MP.act Y0 X0 h (TH.pr X0 d (kop X0 d s))))
    (transH (eop.kunif Y0 X0 h d E0.sP)
      (apH (\ sd -> TFb.pr Y0 (R.D.act Y0 X0 h d) (eop.kop Y0 (R.D.act Y0 X0 h d) sd)) (MP.side-res Y0 X0 h d s))) ;
  res : Id (TH.EI Y0) (TH.E.act Y0 X0 h (TH.pr X0 d (kop X0 d s))) (TH.pr Y0 (R.D.act Y0 X0 h d) (kop Y0 (R.D.act Y0 X0 h d) (PI.rside Y0 X0 h d s))) =
   upI Y0 (TH.E.act Y0 X0 h (TH.pr X0 d (kop X0 d s))) (TH.pr Y0 (R.D.act Y0 X0 h d) (kop Y0 (R.D.act Y0 X0 h d) (PI.rside Y0 X0 h d s)))
    eP (E0.DL.dc-restr Y0 h E1.Fn) ;
 } ;

 -- the ContrOp of HFibId = Sigma Y IdOver
 contrI : CP.ContrOp R.D R.HFibId =
  new CP.Rel[R.D, R.HFibId, R.HFibId, CP.pmap-id R.D R.HFibId].RC[kop, kside, \ Y0 X0 h d s -> Un[Y0, X0, h, d, s].res] ;

 -- the ContrOp of FV1 = Sigma Y YonedaId, a retract of HFibId
 contrFV : CP.ContrOp R.D R.FV1 =
  YCm.RelId[R.D, R.FV1, LR.Map[R.D, R.FV1, R.FV1, HO.compN R.D R.FV1 R.HFibId R.FV1 R.toS R.frS].pmap,
    \ Z w -> apH (\ v -> pairE R.D R.FV1 Z (fstE R.D R.FV1 Z w) ((sndE R.D R.FV1 Z w).1, v))
               (R.YC.fr-to Z (pairE R.D R.HF.B1 Z (fstE R.D R.FV1 Z w) (sndE R.D R.FV1 Z w).1) (sndE R.D R.FV1 Z w).2),
    LR.Relative[R.D, R.FV1, R.HFibId, R.toS, R.frS, contrI].extension].contrOp ;
} ;
