-- CDisc.seg (canonicity-45; SIMPLIFIED.md step 4, the levelwise site): the
-- DISCRETE internal category C0 on the objects of an internal category C:
-- a map over u : J -> I from y to x is an equality y = res u x (an
-- element of a set, so all laws are by set-ness), identities by res-id,
-- composition by res-comp, the cleavage trivial.  Its total site
-- (c2's GrothOf[disc]) is the levelwise site of the paper: lines at (W, y)
-- are points at (W x I, res pr1 y), partial elements have the base's
-- sieves.  The functor from the total category of C0 to that of C is the
-- identity on objects and sends (u, e) to the cartesian lift of u at x
-- with its domain moved along e; restriction along it (U, here on
-- displayed presheaves and their maps; types and elements by c2's CTotU)
-- gives the levelwise notions for presheaves over the total site of C.
--   disc            the discrete IC
--   fnO / fnH       the functor on objects and maps; fn : SFun
--   U / US          restriction of a TCtx / TSub along it
-- No new axioms.

level a l ;
constraint a <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
module VA = V[a] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module DiscOf (C : CIntCat[a].IC) {
 module VT = CVert[a].VertOf[C] ;
 Obj (I : Ob) : U a = VA.Ix (C.obD I) ;
 homV (J I : Ob) (u : Hom J I) (y : Obj J) (x : Obj I) : VA.V = VA.IdV (C.obD J) y (C.res J I u x) ;
 HD (J I : Ob) (u : Hom J I) (y : Obj J) (x : Obj I) : U a = Id (Obj J) y (C.res J I u x) ;
 setHD (J I : Ob) (u : Hom J I) (y : Obj J) (x : Obj I) (f f' : HD J I u y x) : Id (HD J I u y x) f f' = VA.isSetIx (C.obD J) y (C.res J I u x) f f' ;
 idD (I : Ob) (x : Obj I) : HD I I (idH I) x x = symH (C.res-id I x) ;
 compD (K J I : Ob) (u : Hom J I) (v : Hom K J) (z : Obj K) (y : Obj J) (x : Obj I) (f : HD J I u y x) (g : HD K J v z y) : HD K I (compH K J I u v) z x =
  transH g (transH (apH {Obj J} {Obj K} (\ w -> C.res K J v w) f) (symH (C.res-comp K J I u v x))) ;
 TH (J : Ob) (y : Obj J) (I : Ob) (x : Obj I) : U a = (u : Hom J I) * HD J I u y x ;
 pairEq (J : Ob) (y : Obj J) (I : Ob) (x : Obj I) (u u' : Hom J I) (p : Id (Hom J I) u u') (f : HD J I u y x) (f' : HD J I u' y x) : Id (TH J y I x) (u, f) (u', f') =
  Sigma-path (Hom J I) (\ w -> HD J I w y x) u u' f f' p (setHD J I u' y x (subst (Hom J I) (\ w -> HD J I w y x) u u' p f) f') ;
 disc : CIntCat[a].IC = new CIntCat[a].IC[
  \ I -> C.obD I,
  \ J I u y x -> homV J I u y x,
  \ I x -> idD I x,
  \ K J I u v z y x f g -> compD K J I u v z y x f g,
  \ J I u y x f -> pairEq J y I x (compH J I I (idH I) u) u (comp-idl J I u) (compD J I I (idH I) u y x x (idD I x) f) f,
  \ J I u y x f -> pairEq J y I x (compH J J I u (idH J)) u (comp-idr J I u) (compD J J I u (idH J) y y x f (idD J y)) f,
  \ L K J I u v w t z y x f g h -> pairEq L t I x (compH L K I (compH K J I u v) w) (compH L J I u (compH L K J v w)) (comp-assoc L K J I u v w)
     (compD L K I (compH K J I u v) w t z x (compD K J I u v z y x f g) h) (compD L J I u (compH L K J v w) t y x f (compD L K J v w t z y g h)),
  \ J I u x -> C.res J I u x,
  \ J I u x -> refl (C.res J I u x),
  \ K J I u v z x h -> transH h (C.res-comp K J I u v x),
  \ K J I u v z x h -> setHD K I (compH K J I u v) z x (compD K J I u v z (C.res J I u x) x (refl (C.res J I u x)) (transH h (C.res-comp K J I u v x))) h,
  \ K J I u v z x h g e -> setHD K J v z (C.res J I u x) g (transH h (C.res-comp K J I u v x)),
  \ I x -> C.res-id I x,
  \ K J I u v x -> C.res-comp K J I u v x,
  \ I x -> setHD I I (idH I) (C.res I I (idH I) x) x (refl (C.res I I (idH I) x))
             (subst (Obj I) (\ w -> HD I I (idH I) w x) x (C.res I I (idH I) x) (symH (C.res-id I x)) (idD I x)),
  \ K J I u v x -> setHD K I (compH K J I u v) (C.res K J v (C.res J I u x)) x
             (compD K J I u v (C.res K J v (C.res J I u x)) (C.res J I u x) x (refl (C.res J I u x)) (refl (C.res K J v (C.res J I u x))))
             (subst (Obj K) (\ w -> HD K I (compH K J I u v) w x) (C.res K I (compH K J I u v) x) (C.res K J v (C.res J I u x)) (C.res-comp K J I u v x) (refl (C.res K I (compH K J I u v) x)))] ;

 ------------------------------------------------------------------
 -- the functor from the total category of C0 to that of C
 module T0 = CTotCat[a, l].TotOf[disc] ;
 module TC = CTotCat[a, l].TotOf[C] ;
 fnO (X : T0.TOb) : TC.TOb = X ;
 -- the cartesian lift of u at x, with its domain moved along e : y = res u x
 fnH (Y X : T0.TOb) (f : T0.THm Y X) : TC.THm Y X = (f.1, VT.trD Y.1 X.1 f.1 (C.res Y.1 X.1 f.1 X.2) Y.2 (symH f.2) X.2 (C.cart Y.1 X.1 f.1 X.2)) ;
 -- identities: the cartesian lift of the identity is the identity moved (cart-id)
 fnId (X : T0.TOb) : Id (TC.THm X X) (fnH X X (T0.tid X)) (TC.tid X) =
  VT.pairL X.1 X.1 (idH X.1) X.2 X.2 (fnH X X (T0.tid X)).2 (C.idD X.1 X.2)
   (transH (apH {VT.HomD X.1 X.1 (idH X.1) (C.res X.1 X.1 (idH X.1) X.2) X.2} {VT.HomD X.1 X.1 (idH X.1) X.2 X.2}
              (\ w -> VT.trD X.1 X.1 (idH X.1) (C.res X.1 X.1 (idH X.1) X.2) X.2 (symH (symH (C.res-id X.1 X.2))) X.2 w) (C.cart-id X.1 X.2))
     (VT.trD-back' X.1 X.1 (idH X.1) X.2 (C.res X.1 X.1 (idH X.1) X.2) (symH (C.res-id X.1 X.2)) X.2 (C.idD X.1 X.2))) ;
 -- the cartesian lift at a moved object: both ends move
 cart-mv (J I : Ob) (u : Hom J I) (y x : Obj I) (p : Id (Obj I) y x)
  : Id (VT.HomD J I u (C.res J I u x) x) (C.cart J I u x) (VT.trC J I u (C.res J I u x) y x p (VT.trD J I u (C.res J I u y) (C.res J I u x) (apH {Obj I} {Obj J} (\ w -> C.res J I u w) p) y (C.cart J I u y))) =
  idJ (Obj I) y (\ w q -> Id (VT.HomD J I u (C.res J I u w) w) (C.cart J I u w) (VT.trC J I u (C.res J I u w) y w q (VT.trD J I u (C.res J I u y) (C.res J I u w) (apH {Obj I} {Obj J} (\ w2 -> C.res J I u w2) q) y (C.cart J I u y))))
   (refl (C.cart J I u y)) x p ;
 -- composition: through cart-comp, with the domains moved
 module FnComp (Z Y X : T0.TOb) (f : T0.THm Y X) (g : T0.THm Z Y) {
  K : Ob = Z.1 ; J : Ob = Y.1 ; I : Ob = X.1 ;
  u : Hom J I = f.1 ; v : Hom K J = g.1 ;
  x : Obj I = X.2 ; y : Obj J = Y.2 ; z : Obj K = Z.2 ;
  rux : Obj J = C.res J I u x ;
  rvy : Obj K = C.res K J v y ;
  rvr : Obj K = C.res K J v rux ;
  ruv : Obj K = C.res K I (compH K J I u v) x ;
  ef : Id (Obj J) y rux = f.2 ;
  eg : Id (Obj K) z rvy = g.2 ;
  e : Id (Obj K) z ruv = compD K J I u v z y x ef eg ;
  cx : VT.HomD J I u rux x = C.cart J I u x ;
  cy : VT.HomD K J v rvy y = C.cart K J v y ;
  cr : VT.HomD K J v rvr rux = C.cart K J v rux ;
  cuv : VT.HomD K I (compH K J I u v) ruv x = C.cart K I (compH K J I u v) x ;
  -- the right-hand side, in the total hom
  R : VT.HomD K I (compH K J I u v) z x = C.compD K J I u v z y x (VT.trD J I u rux y (symH ef) x cx) (VT.trD K J v rvy z (symH eg) y cy) ;
  -- the left-hand side: cart (u . v) x moved along symH e
  Lh : VT.HomD K I (compH K J I u v) z x = VT.trD K I (compH K J I u v) ruv z (symH e) x cuv ;
  -- cart v y is cart v rux with both ends moved along ef
  s1 : Id (VT.HomD K I (compH K J I u v) z x) R (C.compD K J I u v z y x (VT.trD J I u rux y (symH ef) x cx) (VT.trD K J v rvy z (symH eg) y (VT.trC K J v rvy rux y (symH ef) (VT.trD K J v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux cr)))) =
   apH {VT.HomD K J v rvy y} {VT.HomD K I (compH K J I u v) z x} (\ w -> C.compD K J I u v z y x (VT.trD J I u rux y (symH ef) x cx) (VT.trD K J v rvy z (symH eg) y w)) (cart-mv K J v rux y (symH ef)) ;
  -- the domain transport of the right factor moves out (cmp-trD), then the junction moves (cmp-trM)
  s2 : Id (VT.HomD K I (compH K J I u v) z x) (C.compD K J I u v z y x (VT.trD J I u rux y (symH ef) x cx) (VT.trD K J v rvy z (symH eg) y (VT.trC K J v rvy rux y (symH ef) (VT.trD K J v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux cr))))
         (VT.trD K I (compH K J I u v) rvy z (symH eg) x (C.compD K J I u v rvy y x (VT.trD J I u rux y (symH ef) x cx) (VT.trC K J v rvy rux y (symH ef) (VT.trD K J v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux cr)))) =
   VT.cmp-trD K J I u v rvy z (symH eg) y x (VT.trD J I u rux y (symH ef) x cx) (VT.trC K J v rvy rux y (symH ef) (VT.trD K J v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux cr)) ;
  s3 : Id (VT.HomD K I (compH K J I u v) rvy x) (C.compD K J I u v rvy y x (VT.trD J I u rux y (symH ef) x cx) (VT.trC K J v rvy rux y (symH ef) (VT.trD K J v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux cr)))
         (C.compD K J I u v rvy rux x cx (VT.trD K J v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux cr)) =
   VT.cmp-trM K J I u v rvy rux y (symH ef) x cx (VT.trD K J v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux cr) ;
  s4 : Id (VT.HomD K I (compH K J I u v) rvy x) (C.compD K J I u v rvy rux x cx (VT.trD K J v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux cr))
         (VT.trD K I (compH K J I u v) rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) x (C.compD K J I u v rvr rux x cx cr)) =
   VT.cmp-trD K J I u v rvr rvy (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) rux x cx cr ;
  s5 : Id (VT.HomD K I (compH K J I u v) rvr x) (C.compD K J I u v rvr rux x cx cr) (VT.trD K I (compH K J I u v) ruv rvr (C.res-comp K J I u v x) x cuv) = C.cart-comp K J I u v x ;
  -- assembling the transports: Lh = trD (symH e) cuv, and the composite path is symH e
  pR : Id (Obj K) ruv z = transH (C.res-comp K J I u v x) (transH (apH {Obj J} {Obj K} (\ w -> C.res K J v w) (symH ef)) (symH eg)) ;
  law : Id (VT.HomD K I (compH K J I u v) z x) Lh R =
   symH (transH s1 (transH s2 (transH (apH {VT.HomD K I (compH K J I u v) rvy x} {VT.HomD K I (compH K J I u v) z x} (\ w -> VT.trD K I (compH K J I u v) rvy z (symH eg) x w) (transH s3 s4))
     (transH (apH {VT.HomD K I (compH K J I u v) rvr x} {VT.HomD K I (compH K J I u v) z x}
                (\ w -> VT.trD K I (compH K J I u v) rvy z (symH eg) x (VT.trD K I (compH K J I u v) rvr rvy (apH {Obj J} {Obj K} (\ w2 -> C.res K J v w2) (symH ef)) x w)) s5)
       (transH (apH {VT.HomD K I (compH K J I u v) rvy x} {VT.HomD K I (compH K J I u v) z x} (\ w -> VT.trD K I (compH K J I u v) rvy z (symH eg) x w)
                  (VT.trD-trans K I (compH K J I u v) ruv rvr rvy (C.res-comp K J I u v x) (apH {Obj J} {Obj K} (\ w2 -> C.res K J v w2) (symH ef)) x cuv))
         (transH (VT.trD-trans K I (compH K J I u v) ruv rvy z (transH (C.res-comp K J I u v x) (apH {Obj J} {Obj K} (\ w2 -> C.res K J v w2) (symH ef))) (symH eg) x cuv)
           (apH {Id (Obj K) ruv z} {VT.HomD K I (compH K J I u v) z x} (\ q -> VT.trD K I (compH K J I u v) ruv z q x cuv)
              (VA.isSetIx (C.obD K) ruv z (transH (transH (C.res-comp K J I u v x) (apH {Obj J} {Obj K} (\ w2 -> C.res K J v w2) (symH ef))) (symH eg)) (symH e))))))))) ;
 } ;
 fnComp (Z Y X : T0.TOb) (f : T0.THm Y X) (g : T0.THm Z Y) : Id (TC.THm Z X) (fnH Z X (T0.tcomp Z Y X f g)) (TC.tcomp Z Y X (fnH Y X f) (fnH Z Y g)) =
  VT.pairL Z.1 X.1 (compH Z.1 Y.1 X.1 f.1 g.1) Z.2 X.2 (fnH Z X (T0.tcomp Z Y X f g)).2 (TC.tcomp Z Y X (fnH Y X f) (fnH Z Y g)).2 FnComp[Z, Y, X, f, g].law ;
 fn : CChainsF[a].FunOf[T0.TotCat, TC.TotCat].SFun = new CChainsF[a].FunOf[T0.TotCat, TC.TotCat].SFun[fnO, fnH, fnId, fnComp] ;

 ------------------------------------------------------------------
 -- restriction of displayed presheaves and their maps along the functor
 module TP = CTPsh[a, l].TPshOf[C] ;
 module TP0 = CTPsh[a, l].TPshOf[disc] ;
 resC (G : TP.TCtx) : TP0.TCtx =
  new TP0.TCtx[\ I x -> G.ob I x,
   \ J I u y x e -> G.act J I u y x (fnH (J, y) (I, x) (u, e)).2,
   \ I x g -> transH (apH {VT.HomD I I (idH I) x x} {W0.Ix (G.ob I x)} (\ w -> G.act I I (idH I) x x w g)
                       (VT.THom-snd' I I x x (fnH (I, x) (I, x) (T0.tid (I, x))) (TC.tid (I, x)) (fnId (I, x)) (refl (idH I)))) (G.act-id I x g),
   \ K J I u v z y x f f' g ->
     transH (apH {VT.HomD K I (compH K J I u v) z x} {W0.Ix (G.ob K z)} (\ w -> G.act K I (compH K J I u v) z x w g)
               (VT.THom-snd' K I z x (fnH (K, z) (I, x) (T0.tcomp (K, z) (J, y) (I, x) (u, f) (v, f'))) (TC.tcomp (K, z) (J, y) (I, x) (fnH (J, y) (I, x) (u, f)) (fnH (K, z) (J, y) (v, f')))
                  (fnComp (K, z) (J, y) (I, x) (u, f) (v, f')) (refl (compH K J I u v))))
       (G.act-o K J I u v z y x (fnH (J, y) (I, x) (u, f)).2 (fnH (K, z) (J, y) (v, f')).2 g)] ;
 resS (D G : TP.TCtx) (s : TP.TSub[D, G]) : TP0.TSub[resC D, resC G] =
  new TP0.TSub[resC D, resC G, \ I x d -> s.nt I x d, \ J I u y x e d -> s.nt-nat J I u y x (fnH (J, y) (I, x) (u, e)).2 d] ;
} ;
