-- CApOp2G.seg (canonicity-45; COBAR.md "comparison"): CApOp2 (a binary
-- operation on maps into B, and its action on path homotopies) over the
-- total site G1 of an integral category C (CTotR), for E1 at the total site.
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;

module On (C : CIntCat[a, vl].IC) {
 module GB = CTotR[a, vl, l].TotR[C].G1.GB ;
 module L = GB.GPre[l].PS ;
 module HO = GB.CHtpyOps[l] ;
 TO : U vl = CTotCat[a, vl, l].TotOf[C].TOb ;
 TH (Y X : TO) : U vl = CTotCat[a, vl, l].TotOf[C].THm Y X ;
 module AO (G : L.PCtx) (X B : L.PTy[G])
   (opF : (I : TO) (x : W0.Ix (G.ob I)) (a0 b0 : W0.Ix (B.tob I x)) -> W0.Ix (B.tob I x))
   (opN : (J I : TO) (f : TH J I) (x : W0.Ix (G.ob I)) (y : W0.Ix (G.ob J)) (e : Id (W0.Ix (G.ob J)) (G.act J I f x) y) (a0 b0 : W0.Ix (B.tob I x))
      -> Id (W0.Ix (B.tob J y)) (B.tact J I f x y e (opF I x a0 b0)) (opF J y (B.tact J I f x y e a0) (B.tact J I f x y e b0))) {
  module TB = GB.GPre[l].TyL[G, B] ;
  OP (f g : HO.NMap[G, X, B]) : HO.NMap[G, X, B] =
   new HO.NMap[G, X, B, \ I x a0 -> opF I x (f.nfun I x a0) (g.nfun I x a0),
    \ J I h x y e a0 -> transH (opN J I h x y e (f.nfun I x a0) (g.nfun I x a0))
       (transH (apH {W0.Ix (B.tob J y)} {W0.Ix (B.tob J y)} (\ c -> opF J y c (B.tact J I h x y e (g.nfun I x a0))) (f.nnat J I h x y e a0))
         (apH {W0.Ix (B.tob J y)} {W0.Ix (B.tob J y)} (opF J y (f.nfun J y (X.tact J I h x y e a0))) (g.nnat J I h x y e a0)))] ;
  -- op in two fibres over equal points, read in the total space
  prOp (V : TO) (x x' : W0.Ix (G.ob V)) (q : Id (W0.Ix (G.ob V)) x x') (b1 b2 : W0.Ix (B.tob V x)) (b1' b2' : W0.Ix (B.tob V x'))
   (Q1 : Id (TB.EI V) (TB.pr V x b1) (TB.pr V x' b1')) (Q2 : Id (TB.EI V) (TB.pr V x b2) (TB.pr V x' b2'))
   : Id (TB.EI V) (TB.pr V x (opF V x b1 b2)) (TB.pr V x' (opF V x' b1' b2')) =
   idJ (W0.Ix (G.ob V)) x
    (\ x2 q2 -> (c1 c2 : W0.Ix (B.tob V x2)) -> Id (TB.EI V) (TB.pr V x b1) (TB.pr V x2 c1) -> Id (TB.EI V) (TB.pr V x b2) (TB.pr V x2 c2)
       -> Id (TB.EI V) (TB.pr V x (opF V x b1 b2)) (TB.pr V x2 (opF V x2 c1 c2)))
    (\ c1 c2 R1 R2 -> apH {W0.Ix (B.tob V x)} {TB.EI V} (TB.pr V x)
       (transH (apH {W0.Ix (B.tob V x)} {W0.Ix (B.tob V x)} (\ c -> opF V x c b2) (TB.pr-inj V x b1 c1 R1))
         (apH {W0.Ix (B.tob V x)} {W0.Ix (B.tob V x)} (opF V x c1) (TB.pr-inj V x b2 c2 R2))))
    x' q b1' b2' Q1 Q2 ;
  module Ap (f1 g1 f2 g2 : HO.NMap[G, X, B])
    (H1 : L.PEl[L.extP G X, HO.HT[G, X, B, f1, g1].PT.PathP]) (H2 : L.PEl[L.extP G X, HO.HT[G, X, B, f2, g2].PT.PathP]) {
   module T1 = HO.HT[G, X, B, f1, g1] ;
   module T2 = HO.HT[G, X, B, f2, g2] ;
   module T = HO.HT[G, X, B, OP f1 f2, OP g1 g2] ;
   bv1 (W : TO) (z : W0.Ix (T.GA.ob W)) (Vv : TO) (k : TH Vv W) (j : GB.IvP Vv) : W0.Ix (B.tob Vv (T.s W z Vv k j)) =
    TB.coeT Vv (TB.pr1 Vv (T1.pv H1 W z Vv k j)) (T.s W z Vv k j) ((H1.eob W z).2.1 Vv k j) (TB.pr2 Vv (T1.pv H1 W z Vv k j)) ;
   bv2 (W : TO) (z : W0.Ix (T.GA.ob W)) (Vv : TO) (k : TH Vv W) (j : GB.IvP Vv) : W0.Ix (B.tob Vv (T.s W z Vv k j)) =
    TB.coeT Vv (TB.pr1 Vv (T2.pv H2 W z Vv k j)) (T.s W z Vv k j) ((H2.eob W z).2.1 Vv k j) (TB.pr2 Vv (T2.pv H2 W z Vv k j)) ;
   r1 (W : TO) (z : W0.Ix (T.GA.ob W)) (Vv : TO) (k : TH Vv W) (j : GB.IvP Vv) : Id (TB.EI Vv) (TB.pr Vv (T.s W z Vv k j) (bv1 W z Vv k j)) (T1.pv H1 W z Vv k j) =
    symH (TB.pr-coe Vv (TB.pr1 Vv (T1.pv H1 W z Vv k j)) (T.s W z Vv k j) ((H1.eob W z).2.1 Vv k j) (TB.pr2 Vv (T1.pv H1 W z Vv k j))) ;
   r2 (W : TO) (z : W0.Ix (T.GA.ob W)) (Vv : TO) (k : TH Vv W) (j : GB.IvP Vv) : Id (TB.EI Vv) (TB.pr Vv (T.s W z Vv k j) (bv2 W z Vv k j)) (T2.pv H2 W z Vv k j) =
    symH (TB.pr-coe Vv (TB.pr1 Vv (T2.pv H2 W z Vv k j)) (T.s W z Vv k j) ((H2.eob W z).2.1 Vv k j) (TB.pr2 Vv (T2.pv H2 W z Vv k j))) ;
   val (W : TO) (z : W0.Ix (T.GA.ob W)) (Vv : TO) (k : TH Vv W) (j : GB.IvP Vv) : TB.EI Vv =
    TB.pr Vv (T.s W z Vv k j) (opF Vv (T.s W z Vv k j) (bv1 W z Vv k j) (bv2 W z Vv k j)) ;
   -- naturality of the line
   module TN (W : TO) (z : W0.Ix (T.GA.ob W)) (V' Vv : TO) (g : TH V' Vv) (k : TH Vv W) (j : GB.IvP Vv) {
    s0 : W0.Ix (G.ob Vv) = T.s W z Vv k j ;
    s1 : W0.Ix (G.ob V') = T.s W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j) ;
    e' : Id (W0.Ix (G.ob V')) (G.act V' Vv g s0) s1 = symH (G.act-o V' Vv W k g (T.TA.pr1 W z)) ;
    bvE1 : Id (W0.Ix (B.tob V' s1)) (B.tact V' Vv g s0 s1 e' (bv1 W z Vv k j)) (bv1 W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j)) =
     TB.pr-inj V' s1 (B.tact V' Vv g s0 s1 e' (bv1 W z Vv k j)) (bv1 W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j))
      (transH (symH (TB.pr-tact V' Vv g s0 s1 e' (bv1 W z Vv k j)))
        (transH (apH {TB.EI Vv} {TB.EI V'} (TB.E.act V' Vv g) (r1 W z Vv k j))
          (transH ((H1.eob W z).1.2 V' Vv g k j) (symH (r1 W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j)))))) ;
    bvE2 : Id (W0.Ix (B.tob V' s1)) (B.tact V' Vv g s0 s1 e' (bv2 W z Vv k j)) (bv2 W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j)) =
     TB.pr-inj V' s1 (B.tact V' Vv g s0 s1 e' (bv2 W z Vv k j)) (bv2 W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j))
      (transH (symH (TB.pr-tact V' Vv g s0 s1 e' (bv2 W z Vv k j)))
        (transH (apH {TB.EI Vv} {TB.EI V'} (TB.E.act V' Vv g) (r2 W z Vv k j))
          (transH ((H2.eob W z).1.2 V' Vv g k j) (symH (r2 W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j)))))) ;
    law : Id (TB.EI V') (TB.E.act V' Vv g (val W z Vv k j)) (val W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j)) =
     transH (TB.pr-tact V' Vv g s0 s1 e' (opF Vv s0 (bv1 W z Vv k j) (bv2 W z Vv k j)))
      (apH {W0.Ix (B.tob V' s1)} {TB.EI V'} (TB.pr V' s1)
        (transH (opN V' Vv g s0 s1 e' (bv1 W z Vv k j) (bv2 W z Vv k j))
          (transH (apH {W0.Ix (B.tob V' s1)} {W0.Ix (B.tob V' s1)} (\ c -> opF V' s1 c (B.tact V' Vv g s0 s1 e' (bv2 W z Vv k j))) bvE1)
            (apH {W0.Ix (B.tob V' s1)} {W0.Ix (B.tob V' s1)} (opF V' s1 (bv1 W z V' (GB.compH V' Vv W k g) (GB.ivA V' Vv g j))) bvE2)))) ;
   } ;
   -- the ends
   endE (W : TO) (z : W0.Ix (T.GA.ob W)) (ep : GB.IPt)
    (c1 c2 : W0.Ix (B.tob W (T.TA.pr1 W z)))
    (Q1 : Id (TB.EI W) (T1.pv H1 W z W (GB.idH W) (GB.ptH W ep)) (TB.pr W (T.TA.pr1 W z) c1))
    (Q2 : Id (TB.EI W) (T2.pv H2 W z W (GB.idH W) (GB.ptH W ep)) (TB.pr W (T.TA.pr1 W z) c2))
    : Id (TB.EI W) (val W z W (GB.idH W) (GB.ptH W ep)) (TB.pr W (T.TA.pr1 W z) (opF W (T.TA.pr1 W z) c1 c2)) =
    prOp W (T.s W z W (GB.idH W) (GB.ptH W ep)) (T.TA.pr1 W z) (G.act-id W (T.TA.pr1 W z)) (bv1 W z W (GB.idH W) (GB.ptH W ep)) (bv2 W z W (GB.idH W) (GB.ptH W ep)) c1 c2
     (transH (r1 W z W (GB.idH W) (GB.ptH W ep)) Q1) (transH (r2 W z W (GB.idH W) (GB.ptH W ep)) Q2) ;
   path (W : TO) (z : W0.Ix (T.GA.ob W)) : W0.Ix (T.PT.tobP W z) =
    T.PT.mkPath W z (\ Vv k j -> val W z Vv k j) (\ V' Vv g k j -> TN[W, z, V', Vv, g, k, j].law) (\ Vv k j -> refl (T.s W z Vv k j))
     (endE W z GB.e0 (f1.nfun W (T.TA.pr1 W z) (T.TA.pr2 W z)) (f2.nfun W (T.TA.pr1 W z) (T.TA.pr2 W z)) (H1.eob W z).2.2.1 (H2.eob W z).2.2.1)
     (endE W z GB.e1 (g1.nfun W (T.TA.pr1 W z) (T.TA.pr2 W z)) (g2.nfun W (T.TA.pr1 W z) (T.TA.pr2 W z)) (H1.eob W z).2.2.2 (H2.eob W z).2.2.2) ;
   enat (J I : TO) (h : TH J I) (z : W0.Ix (T.GA.ob I)) (z' : W0.Ix (T.GA.ob J)) (e : Id (W0.Ix (T.GA.ob J)) (T.GA.act J I h z) z')
    : Id (W0.Ix (T.PT.tobP J z')) (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') =
    T.PT.path-eq J z' (T.PT.PathP.tact J I h z z' e (path I z)) (path J z') (\ Vv f i ->
     prOp Vv (T.s I z Vv (GB.compH Vv J I h f) i) (T.s J z' Vv f i) (T.sN J I h z z' e Vv f i)
      (bv1 I z Vv (GB.compH Vv J I h f) i) (bv2 I z Vv (GB.compH Vv J I h f) i) (bv1 J z' Vv f i) (bv2 J z' Vv f i)
      (transH (r1 I z Vv (GB.compH Vv J I h f) i) (transH (T1.pv-res H1 J I h z z' e Vv f i) (symH (r1 J z' Vv f i))))
      (transH (r2 I z Vv (GB.compH Vv J I h f) i) (transH (T2.pv-res H2 J I h z z' e Vv f i) (symH (r2 J z' Vv f i))))) ;
   -- op (f1, f2) ~ op (g1, g2)
   res : L.PEl[T.GA, T.PT.PathP] = new L.PEl[T.GA, T.PT.PathP, path, enat] ;
  } ;
 } ;
} ;
