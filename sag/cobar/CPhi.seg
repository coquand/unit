-- CPhi.seg (canonicity-45; COBAR.md "comparison"): at a copy y', the map
-- phi : Q_y' -> codes F1 -> y' of E1's instance (CE1Copy): c2's inverse of
-- the evaluation at the generator (CEv6), followed by beta (CHomT8), whose
-- naturality comes from alpha's (CHomT16) and the two round trips.
-- No new axioms beyond the named premises (fe).

level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
open CPosC[a] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;
module PB = PosFull[a].PB ;
module L = PB.GPre[a+].PS ;

module Phi (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) (y' : SX.Over[R].Presentation) {
 module RH = CRestrHT[a].RHT[R, encK, pe, y'] ;
 module CM = RH.CM ;
 module HO = RH.HO ;
 Nl : L.PCtx = RH.Nl ;
 module HP = CHomT3[a].HomP[R, encK, pe] ;
 F1 : SX.Over[R].Presentation = CM.F1 ;
 HT : FibCwF[a, a+].fibCwF.Ty FibCwF[a, a+].fibCwF.nil = HP.Hom[F1, y'].HomT ;
 Ac : L.PTy[Nl] = RH.ClT[CM.Yo[F1].yoT].ty ;
 module TM = CHomT8[a].ToM[R, encK, pe, F1, y'] ;
 module FM = CHomT11[a].FromM[R, encK, pe, F1, y'] ;
 module NN = CHomT16[a].Nat[R, encK, pe, F1, y'] ;
 module FF = CM.MO.Fn[F1, y'] ;
 resE (J I : Ob) (h : Hom J I) (m : FF.M I) : Id (FF.M J) (Ac.tact J I h tt tt (refl tt) m) (FF.res I J h m) =
  FF.mExt J (Ac.tact J I h tt tt (refl tt) m) (FF.res I J h m) (refl (FF.fpOf J (FF.res I J h m))) ;
 bnat (J I : Ob) (h : Hom J I) (z : V1.Ix (HT.1.tob I tt))
  : Id (FF.M J) (Ac.tact J I h tt tt (refl tt) (TM.beta I z)) (TM.beta J (HT.1.tact J I h tt tt (refl tt) z)) =
  transH (resE J I h (TM.beta I z))
   (transH (symH (CHomT12[a].RT1[R, encK, pe, F1, y'].At[J, FF.res I J h (TM.beta I z)].rt))
     (apH {V1.Ix (HT.1.tob J tt)} {FF.M J} (TM.beta J)
       (transH (NN.aNat I J h (TM.beta I z))
         (apH {V1.Ix (HT.1.tob I tt)} {V1.Ix (HT.1.tob J tt)} (\ u -> HT.1.tact J I h tt tt (refl tt) u) (CHomT13[a].RT2[R, encK, pe, F1, y'].At[I, z].rt))))) ;
 -- beta at an arbitrary point of the terminal context (by cases on it)
 bt (I : Ob) : (o : Top) -> V1.Ix (HT.1.tob I o) -> FF.M I = split { tt -> \ z -> TM.beta I z } ;
 bnat2 (J I : Ob) (h : Hom J I) : (x : Top) (x' : Top) (e : Id (V1.Ix (Nl.ob J)) (Nl.act J I h x) x') (z : V1.Ix (HT.1.tob I x))
  -> Id (FF.M J) (Ac.tact J I h x x' e (bt I x z)) (bt J x' (HT.1.tact J I h x x' e z)) = split {
  tt -> split { tt -> \ e z -> transH (bnat J I h z) (apH {V1.Ix (HT.1.tob J tt)} {FF.M J} (TM.beta J) (L.tact-irr Nl HT.1 J I h tt tt (refl tt) e z)) } } ;
 betaN : HO.NMap[Nl, HT.1, Ac] = new HO.NMap[Nl, HT.1, Ac, bt, \ J I h x x' e z -> bnat2 J I h x x' e z] ;
 module E6 = CEv6[a].E6[R, encK, pe, y'] ;
 invN : HO.NMap[Nl, (HP.Alg[y'].Qt).1, HT.1] = EqQinv[a, a+].NM[Nl, HP.Alg[y'].Qt, HT, E6.inv].nm ;
 phi : HO.NMap[Nl, (HP.Alg[y'].Qt).1, Ac] = HO.compN Nl (HP.Alg[y'].Qt).1 HT.1 Ac invN betaN ;
} ;

-- phi has the type of CE1Copy's parameter
module Plug (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (al : (y : SX.Over[R].Presentation) -> PB.CPartial[a+].PMap[FibCwF[a, a+].fibCwF.nil, CCmpY2[a].Sides[R, encK, pe, y].HS.1, CCmpY2[a].Sides[R, encK, pe, y].HTT.1])
  (eqal : (y : SX.Over[R].Presentation) -> PB.CEquiv[a+].EquivOp FibCwF[a, a+].fibCwF.nil CCmpY2[a].Sides[R, encK, pe, y].HS.1 CCmpY2[a].Sides[R, encK, pe, y].HTT.1 (al y))
  (commH : (y : SX.Over[R].Presentation) (W : Ob) (v : CCmpY2[a].Sides[R, encK, pe, y].TB'.EI W)
     -> Id (CCmpY2[a].Sides[R, encK, pe, y].TA.EI W) (CCmpY2[a].Sides[R, encK, pe, y].tA W (CCmpY2[a].Sides[R, encK, pe, y].CY.al'.mE W v))
          ((al y).mE W (CCmpY2[a].Sides[R, encK, pe, y].tB W v))) (y' : SX.Over[R].Presentation) {
 module E = CE1Copy[a].E1C[R, encK, pe, al, eqal, commH, y'] ;
 phi : E.HO.NMap[E.Nl, E.Qc, E.Ac] = Phi[R, encK, pe, y'].phi ;
} ;
