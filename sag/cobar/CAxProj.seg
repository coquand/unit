-- CAxProj.seg (canonicity-c2; the axioms' statements, part 6): projectivity
-- of Sp(u) (jonas.pdf Definition 73, Axiom 1), externally: for every
-- s : D -> Pr_u and every P over D.Sp(u)[s] (the telescope x : G^n,
-- h : q(x) = 0 substituted along s), a map
--     El D (Pi_{Sp(u)[s]} ||P||)  ->  El D (|| Pi_{Sp(u)[s]} P ||).
-- Naturality in s (Remark 74) holds up to Id for free: the target is a
-- proposition.  Metatheory schema in u; the quantification over (D, s, P)
-- is a schema over types (the model has no universe in this development),
-- equivalent to the internal Definition 73 when a universe is available.
-- P ranges over D-MODAL types (the inner model's types, as in Definition 73):
-- the hypothesis mP is tau_P an equivalence, the form of Lemma 59's mQ.
-- No new axioms beyond the named premises.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module ProjOf (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy)
  (addV mulV : (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X -> CAxEv[a].EvG[R, encK, pe].GV X)
  (addN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (addV I u v)) (addV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (mulN : (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I) (u v : CAxEv[a].EvG[R, encK, pe].GV I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (mulV I u v)) (mulV J (CAxEv[a].EvG[R, encK, pe].rsG J I f u) (CAxEv[a].EvG[R, encK, pe].rsG J I f v)))
  (cV : R.R -> (X : CAxEv[a].EvG[R, encK, pe].Ob) -> CAxEv[a].EvG[R, encK, pe].GV X)
  (cN : (r : R.R) (J I : CAxEv[a].EvG[R, encK, pe].Ob) (f : CAxEv[a].EvG[R, encK, pe].Hm J I)
     -> Id (CAxEv[a].EvG[R, encK, pe].GV J) (CAxEv[a].EvG[R, encK, pe].rsG J I f (cV r I)) (cV r J))
  (k n : Nat) {
 module NO = CAxN[a].NOf[R, encK, pe, addV, mulV, addN, mulN, cV, cN, k, n] ;
 module S = NO.S ;
 module PW = S.PW ;
 C : CwF.CwF[a++] = S.C ;
 Pr : C.Ctx = S.Pr ;
 Eqs : U a = NO.Eqs ;
 -- the telescope substituted along s : D -> Pr (points, then hypotheses)
 XD (D : C.Ctx) (s : C.Sub D Pr) : (j : Nat) -> (E : C.Ctx) * C.Sub E (PW.Ext Pr j) = split {
  zero -> (D, s) ;
  suc j | r -> (C.ext r.1 (C.subT r.1 (PW.Ext Pr j) (PW.Gat (PW.Ext Pr j)) r.2), C.lift r.1 (PW.Ext Pr j) (PW.Gat (PW.Ext Pr j)) r.2) } ;
 HD (D : C.Ctx) (s : C.Sub D S.Xc) : (qs : Eqs) -> (E : C.Ctx) * C.Sub E (S.HS qs).1 = split {
  nil -> (D, s) ;
  cons q qs | r -> (C.ext r.1 (C.subT r.1 (S.HS qs).1 (S.EqT (S.HS qs).1 (S.HS qs).2 q) r.2), C.lift r.1 (S.HS qs).1 (S.EqT (S.HS qs).1 (S.HS qs).2 q) r.2) } ;
 PiXD (D : C.Ctx) (s : C.Sub D Pr) : (j : Nat) -> C.Ty (XD D s j).1 -> C.Ty D = split {
  zero -> \ B -> B ;
  suc j | r -> \ B -> r (S.Pi (XD D s j).1 (C.subT (XD D s j).1 (PW.Ext Pr j) (PW.Gat (PW.Ext Pr j)) (XD D s j).2) B) } ;
 PiHD (D : C.Ctx) (s : C.Sub D S.Xc) : (qs : Eqs) -> C.Ty (HD D s qs).1 -> C.Ty D = split {
  nil -> \ B -> B ;
  cons q qs | r -> \ B -> r (S.Pi (HD D s qs).1 (C.subT (HD D s qs).1 (S.HS qs).1 (S.EqT (S.HS qs).1 (S.HS qs).2 q) (HD D s qs).2) B) } ;
 -- the context D.Sp(u)[s] and Pi over it
 SpC (D : C.Ctx) (s : C.Sub D Pr) (qs : Eqs) : C.Ctx = (HD (XD D s n).1 (XD D s n).2 qs).1 ;
 PiSp (D : C.Ctx) (s : C.Sub D Pr) (qs : Eqs) (B : C.Ty (SpC D s qs)) : C.Ty D = PiXD D s n (PiHD (XD D s n).1 (XD D s n).2 qs B) ;
 -- D-modality of a type over any context (tau_P an equivalence, as Lemma 59's mQ)
 module TC = CTotCat[a, a+, a+].TotOf[PW.GB.YF.CM.IC] ;
 module MD (E : C.Ctx) (P : C.Ty E) {
  E' : PW.TR.P1.PCtx = TC.toP (TC.ofP E) ;
  jS : PW.TR.P1.PSub[E', E] = new PW.TR.P1.PSub[E', E, \ X w -> w, \ Y X f w -> refl (E.act Y X f w)] ;
  P' : PW.TR.P1.PTy[E'] = PW.TR.P1.subTy E' E P.1 jS ;
  module C15P = CTotC15[a, a+, a+].C15[PW.GB.YF.CM.IC, TC.ofP E, P'] ;
  Modal : U a++ = PW.G1.GB.CEquiv[a+].EquivOp E' P' C15P.LB.Bt C15P.tauM ;
 } ;
 -- projectivity of Sp(u): for D-modal P (types of the inner model)
 Proj (qs : Eqs) : U a++ = (D : C.Ctx) (s : C.Sub D Pr) (P : C.Ty (SpC D s qs)) (mP : MD[SpC D s qs, P].Modal)
   -> C.El D (PiSp D s qs (NO.Tr (SpC D s qs) P)) -> C.El D (NO.Tr D (PiSp D s qs P)) ;
} ;
