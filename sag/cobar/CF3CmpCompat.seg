-- The three components of the F3 comparison are the generic maps used
-- by E1 after applying tau.  This is an equality of readings at the total
-- site, with the maps themselves natural along every C-arrow.
level a ;
open Base ;
open Prelude[a++] ;
open Paths[a++] ;
module V1 = V[a+] ;
module SX = CSyntax[a] ;
module EN = Encode[a, a] ;
module PU = CwFPropU.PropU[a++, FibCwF[a, a+].fibCwF, FibCwF[a, a+].fibPi, FibCwF[a, a+].fibSig, FibId[a, a+].fibId, FibUniv[a].fibUniv] ;

module Compat (R : Ring[a].CRing) (encK : EN.Enc R.R) (pe : PU.PropExtTy) {
  module FC = CFree3Assoc[a].Free3Comparison[R, encK, pe] ;
  module F = FC.F ;
  module A = CE1Tot[a].T1[R, encK, pe, F.F3] ;
  module Q1 = A.C6.Q1 ;
  cmp1 (X : A.CT.TC.TOb) (w : V1.Ix (FC.Y3.ob X.1 X.2)) :
    Id (V1.Ix (A.GT.tob X tt)) ((A.Rs F.x1).nfun X tt w)
      (Q1.DY.tau X.1 X.2 (FC.cmpS.nt X.1 X.2 w).1.1) =
    refl ((A.Rs F.x1).nfun X tt w) ;
  cmp2 (X : A.CT.TC.TOb) (w : V1.Ix (FC.Y3.ob X.1 X.2)) :
    Id (V1.Ix (A.GT.tob X tt)) ((A.Rs F.x2).nfun X tt w)
      (Q1.DY.tau X.1 X.2 (FC.cmpS.nt X.1 X.2 w).1.2) =
    refl ((A.Rs F.x2).nfun X tt w) ;
  cmp3 (X : A.CT.TC.TOb) (w : V1.Ix (FC.Y3.ob X.1 X.2)) :
    Id (V1.Ix (A.GT.tob X tt)) ((A.Rs F.x3).nfun X tt w)
      (Q1.DY.tau X.1 X.2 (FC.cmpS.nt X.1 X.2 w).2) =
    refl ((A.Rs F.x3).nfun X tt w) ;
} ;
