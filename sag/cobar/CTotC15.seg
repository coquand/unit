-- CTotC15.seg (canonicity-45; SIMPLIFIED.md step 4): Corollary 15 at the
-- total site: D tau_A is an equivalence (G1 EquivOp over D G), for A with
-- a levelwise fibration structure of U A over U G.
--   tauM     tau_A : A -> (D A)[tau_G] as a map of types at the total
--            site (Lemma 14's tauA, naturality NatE.law)
-- No new axioms beyond the named premises (fe).

level a vl l ;
constraint a <= vl ;
constraint vl <= l ;
open Base ;
open Prelude[l+] ;
open Paths[l+] ;
module W0 = V[l] ;
open Cat[a] ;
open SmallCat[a].Objs[obV] ; open SmallCat[a].Homs[obV, homV] ;

module C15 (C : CIntCat[a, vl].IC) (G : CTPsh[a, vl, l].TPshOf[C].TCtx) (A : Presheaf[vl, l].Psh[CTotCat[a, vl, l].TotOf[C].TotCat].PTy[CTotCat[a, vl, l].TotOf[C].toP G]) {
 module LB = CTotL14b[a, vl, l].L14b[C, G, A] ;
 module TR = LB.TR ;
 module G1 = TR.G1 ;
 module CP1 = G1.GB.CPartial[l] ;
 GP : LB.P.PCtx = LB.GP ;
 tauM : CP1.PMap[GP, A, LB.Bt] =
  CP1.mkPMap GP A LB.Bt (\ X w -> (w.1, LB.TA.tauA X.1 X.2 w.1 w.2)) (\ X w -> refl w.1)
   (\ Y X h w -> apH {W0.Ix (LB.Bt.tob Y (GP.act Y X h w.1))} {CP1.GPR.PS.SigT GP LB.Bt Y} (\ b -> (GP.act Y X h w.1, b))
      (symH (LB.NatE[Y.1, X.1, h.1, Y.2, X.2, h.2, w.1, w.2].law (GP.act Y X h w.1) (refl (GP.act Y X h w.1))
         (LB.P.ntEq GP (LB.TC.toP LB.D.DCtx) (LB.TC.toPS G LB.D.DCtx LB.D.tauS) Y X h w.1 (GP.act Y X h w.1) (refl (GP.act Y X h w.1)))))) ;
 module P13 = CTotP13o[a, vl, l].P13[C, G, A, LB.Bt, tauM] ;
 module PD = P13.PD ;
 module G0 = TR.G0 ;
 module LG = CTotL14g[a, vl, l].L14g[C, G, A] ;
 module LH = CTotL14h[a, vl, l].L14[C, G, A] ;
 module LF = CTotL12Fib2[a, vl, l].L12F[C, G, A] ;
 module Main (fb : G0.GB.CLine[l].Lines[LB.UG, LB.UA].Fib) {
  q : LG.QInv = LH.lemma14 fb ;
  fbB : G0.GB.CLine[l].Lines[LB.UG, LB.UB].Fib = LG.Out[LF.lemma12F fb].fbU ;
  module QE = G0.FT.GQinvEq[l].QE[LB.UG, (LB.UA, fb), (LB.UB, fbB), LB.tauN, q.1, q.2.1, q.2.2] ;
  module TA = G0.GB.GPre[l].TyL[LB.UG, LB.UA] ;
  module TB = G0.GB.GPre[l].TyL[LB.UG, LB.UB] ;
  module HC = G0.GB.CHFibCart[l, l].HCart[LB.UG, LB.UA, LB.UB, PD.Uf, LB.UG, LB.UA, LB.UB, QE.fM,
     \ W d -> d, \ V W g d -> refl (LB.UG.act V W g d),
     \ W v -> v, \ W v -> refl (TB.pr1 W v), \ V W g v -> refl (TB.E.act V W g v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TB.pr X x u),
     \ W v -> v, \ W v -> refl (TA.pr1 W v), \ V W g v -> refl (TA.E.act V W g v),
     \ W v v' P Q -> Q,
     \ X x u -> u, \ X x u -> refl (TA.pr X x u),
     \ W v -> refl (PD.Uf.mE W v)] ;
  ef : G0.GB.CEquiv[l].EquivOp PD.UG PD.UA PD.UB PD.Uf = HC.moveEq QE.qinvEq ;
  -- Corollary 15
  cor15 : G1.GB.CEquiv[l].EquivOp P13.DF.DG P13.DF.DA.DTy P13.DF.DB.DTy P13.DF.Df = P13.prop13 ef ;
 } ;
} ;
