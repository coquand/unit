-- Test.seg: the definitions compute, over Z/2 (Bool, xor, and).

level a ;
open Ring[a] ;
open Poly[a] ;
open Mul[a] ;
open Group[a] ;

data B = O | I ;
xor : B -> B -> B = split { O -> \ y -> y ; I -> split { O -> I ; I -> O } } ;
and : B -> B -> B = split { O -> \ y -> O ; I -> \ y -> y } ;

z2addA : (x y w : B) -> Id B (xor x (xor y w)) (xor (xor x y) w) = split {
  O -> \ y w -> refl (xor y w) ;
  I -> split { O -> \ w -> refl (xor I w) ;
               I -> split { O -> refl O ; I -> refl I } } } ;
z2addC : (x y : B) -> Id B (xor x y) (xor y x) = split {
  O -> split { O -> refl O ; I -> refl I } ;
  I -> split { O -> refl I ; I -> refl O } } ;
z2addZ : (x : B) -> Id B (xor x O) x = split { O -> refl O ; I -> refl I } ;
z2addN : (x : B) -> Id B (xor x x) O = split { O -> refl O ; I -> refl O } ;
z2mulA : (x y w : B) -> Id B (and x (and y w)) (and (and x y) w) = split {
  O -> \ y w -> refl O ; I -> \ y w -> refl (and y w) } ;
z2mulC : (x y : B) -> Id B (and x y) (and y x) = split {
  O -> split { O -> refl O ; I -> refl O } ;
  I -> split { O -> refl O ; I -> refl I } } ;
z2mulO : (x : B) -> Id B (and x I) x = split { O -> refl O ; I -> refl I } ;
z2dist : (x y w : B) -> Id B (and x (xor y w)) (xor (and x y) (and x w)) = split {
  O -> \ y w -> refl O ; I -> \ y w -> refl (xor y w) } ;

Z2 : CRing = mkCRing B O I xor and (\ x -> x)
  z2addA z2addC z2addZ z2addN z2mulA z2mulC z2mulO z2dist ;

open PolyR[Z2] ;
open MulR[Z2] ;
open GroupR[Z2] ;

-- f = 1 + X^2 = (X + 1)^2 over Z/2
f : P = cons I (cons O (cons I nil)) ;
#conv ev f I = O ;
#conv ev f O = I ;
#conv sdiv I f = (cons I (cons I nil), O) ;
#conv mulXa I (cons I nil) = cons I (cons I nil) ;
#conv pmul (cons I (cons I nil)) (cons I (cons I nil)) = cons I (cons O (cons I nil)) ;
#conv prodL I (cons I (cons I nil)) = cons I (cons O (cons I nil)) ;
#conv E (cons (I, suc zero) nil) (cons I nil) = cons I (cons O (cons I nil)) ;
#conv lastD f = I ;
#conv initL f = cons I (cons O nil) ;
#fails { #conv ev f I = I ; } ;
