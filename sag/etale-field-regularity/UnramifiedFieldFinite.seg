-- Complete one-generator field theorem: finite presentation and formal
-- unramifiedness give regularity, hence zero-dimensionality; expression
-- generation by one element then gives a fixed finite spanning family.
-- The final adapter takes an actual presentation with one variable, so
-- generation and finite presentation are derived from that presentation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nonzero : Not (Id k.R k.o k.z)) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module FE = FormallyEtale[l].Over[k,setk] ;
 module One (S : C.Algebra) (x : S.ring.R)
  (gen : GeneratedSubalgebra[l].Over[k,setk].At[S,suc zero,\ i -> x].Generators)
  (fp : P.FP S) (unique : FE.Unique S) {
  module R = UnramifiedFieldRegular[l].Over[k,setk,dec].At[S,fp,unique] ;
  module M = MonogenicExpressions[l].Over[k,setk,dec,nonzero].At[S,x] ;
  finite : FiniteSpan[l].Over[k,S.ring,S.iota].Finite = M.theorem gen R.zero-dimensional ;
 } ;
 module Presented (S : C.Algebra) (equations : P.Equations (Fin (suc zero)))
  (ps : P.Presents (suc zero,equations) S) (unique : FE.Unique S) {
  x : S.ring.R = ps.1.1 (inr tt) ;
  module G = GeneratedSubalgebra[l].Over[k,setk].At[S,suc zero,\ i -> x] ;
  module Old = Generated[l].Over[k,setk] ;
  module PG = Old.Generated[(suc zero,equations),S,ps] ;
  values : (i : Fin (suc zero)) -> Id S.ring.R x (ps.1.1 i) = split {
   inl e -> efq e ; inr t -> ap (\ z -> ps.1.1 (inr z)) (MnSums[l].top-eq tt t) } ;
  representation (c : S.ring.R) (r : Old.Representation (suc zero,equations) S ps c) : G.Rep c =
   (r.1,trans (Old.eval-ext (Fin (suc zero)) S (\ i -> x) ps.1.1 values r.1) r.2) ;
  generated : G.Generators = \ c ->
   TC.map (Old.Representation (suc zero,equations) S ps c) (G.Rep c) (representation c) (PG.generated c) ;
  fp : P.FP S = Truncation[l+].Trunc[P.Witness S].inc ((suc zero,equations),ps) ;
  finite : FiniteSpan[l].Over[k,S.ring,S.iota].Finite = One[S,x,generated,fp,unique].finite ;
 } ;
} ;
