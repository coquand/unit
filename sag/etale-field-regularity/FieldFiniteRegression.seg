-- The full arbitrary-arity field theorem on the base algebra and on the
-- constructed standard quadratic F2[X]/(X^2-X), with its localisation
-- presentation. Also exercise the underlying generator induction with
-- three redundant generators, without a finite-presentation input.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module B = BooleanRing[l] ; module H = RingHom[l] ;
module F = FieldRegression[l] ; module C = Algebras[l].Over[F.A,B.bool-set] ;
module P = Presentations[l].Over[F.A,B.bool-set] ; module FE = FormallyEtale[l].Over[F.A,B.bool-set] ;
empty-to-ring : Base.Empty -> Empty = split {} ;
nontrivial : Not (Id F.A.R F.A.o F.A.z) = \ eq -> empty-to-ring (B.true-false eq) ;
module General = UnramifiedFieldFiniteGeneral[l].Over[F.A,B.bool-set,F.dec,nontrivial] ;
module BaseP = BasePresentation[l].Over[F.A,B.bool-set] ;
base-unique : FE.Unique C.base = \ A N f g eq ->
 C.ext C.base A f g (\ r -> trans (f.2 r) (sym (g.2 r))) ;
base-finite : FiniteSpan[l].Over[F.A,F.A,H.identity F.A].Finite =
 General.At[C.base,BaseP.finitely-presented,base-unique].finite ;
three : Nat = suc (suc (suc zero)) ;
x (i : Fin three) : F.A.R = F.A.z ;
module G = GeneratedSubalgebra[l].Over[F.A,B.bool-set].At[C.base,three,x] ;
generation : G.Generators = \ a -> Tr.Trunc[G.Rep a].inc (cst a,refl a) ;
dimension : IntegralDescent[l].ZeroDim[F.A,B.bool-set].Property =
 IntegralDescent[l].ZeroDim[F.A,B.bool-set].from-regular F.regular ;
three-generators-finite : FiniteSpan[l].Over[F.A,F.A,H.identity F.A].Finite =
 ZeroDimensionalFinite[l].Over[F.A,B.bool-set,F.dec,nontrivial].theorem three C.base x generation dimension ;
module Quadratic (rq : FieldRegularRegression[l].Reps.Representation FieldRegularRegression[l].q)
 (rg : FieldRegularRegression[l].Reps.Representation FieldRegularRegression[l].Pt.g) {
 module Q = FieldRegularRegression[l].Test[rq,rg] ;
 finite : FiniteSpan[l].Over[F.A,Q.S.ring,Q.S.iota].Finite =
  General.At[Q.S,Q.fp,Q.etale.1.2].finite ;
 integral : IntegralDescent[l].Map[F.A,Q.S.ring,Q.S.iota].Extension =
  General.At[Q.S,Q.fp,Q.etale.1.2].integral ;
} ;
