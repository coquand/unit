-- Actual field F2, a polynomial target (which is not finite dimensional),
-- its nonreduced quotient F2[t]/t^2, the empty relation and zero rows.
-- The final example invokes principal-quotient regularity on F2 itself.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F2 = BooleanRing[l] ;
A : CRing = F2.two-ring ;
dec : (x : A.R) -> Plus (Id A.R x A.z) ((w : A.R) * Id A.R (A.mul x w) A.o) = split {
 false -> inl (refl false) ; true -> inr (true,refl true) } ;
module Field = FieldFlat[l].Over[A,dec] ;
module P = PolynomialRing[l].Extension[A,F2.bool-set] ;
polynomial-flat : FlatRelations[l].Over[A,P.ring,P.inclusion].Flat = Field.To[P.ring,P.inclusion].flat ;
module Dual = FlatPrincipalQuotient[l].Over[P.ring,P.ring.mul P.variable P.variable] ;
dual-map : RingHom[l].Hom A Dual.Q.ring = RingHom[l].compose A P.ring Dual.Q.ring Dual.Q.projection P.inclusion ;
dual-flat : FlatRelations[l].Over[A,Dual.Q.ring,dual-map].Flat = Field.To[Dual.Q.ring,dual-map].flat ;
module Tests (B : CRing) (h : RingHom[l].Hom A B) (t : B.R) {
 module F = Field.To[B,h] ; module O = FlatRelations[l].Over[A,B,h] ; module LB = RL[B] ;
 empty : O.Explanation[zero,\ i -> efq i,\ i -> efq i] = F.explanation zero (\ i -> efq i) (\ i -> efq i) (refl B.z) ;
 empty-size : Id Nat empty.size zero = refl zero ;
 zero-row : O.Explanation[suc zero,\ i -> false,\ i -> t] =
  F.explanation (suc zero) (\ i -> false) (\ i -> t)
   (trans (B.addZ (B.mul (h.1 false) t))
    (trans (ap (\ x -> B.mul x t) (RingHom[l].zero A B h)) (LB.zero-mul t))) ;
 zero-column : Id A.R (zero-row.column (inr tt) (inr tt)) true = refl true ;
 n : Nat = suc (suc zero) ;
 a (i : Fin n) : A.R = true ;
 b : Fin n -> B.R = snoc (Fin (suc zero)) B.R (\ i -> t) (B.neg t) ;
 relation : O.Relation n a b =
  trans (ap (B.add (B.mul (h.1 true) (B.neg t))) (B.addZ (B.mul (h.1 true) t)))
   (trans (cong2 B.R B.add _ _ _ _
    (trans (ap (\ x -> B.mul x (B.neg t)) h.2.1) (LB.one-left (B.neg t)))
    (trans (ap (\ x -> B.mul x t) h.2.1) (LB.one-left t)))
    (trans (B.addC (B.neg t) t) (B.addN t))) ;
 explained : O.Explanation[n,a,b] = F.explanation n a b relation ;
 column11 : Id A.R (explained.column (inl (inr tt)) (inl (inr tt))) true = refl true ;
 column12 : Id A.R (explained.column (inl (inr tt)) (inr tt)) true = refl true ;
 column21 : Id A.R (explained.column (inr tt) (inl (inr tt))) false = refl false ;
 column22 : Id A.R (explained.column (inr tt) (inr tt)) false = refl false ;
} ;
module Polynomial = Tests[P.ring,P.inclusion,P.variable] ;
polynomial-relation : Polynomial.O.Explanation[Polynomial.n,Polynomial.a,Polynomial.b] = Polynomial.explained ;
module Nonreduced = Tests[Dual.Q.ring,dual-map,Dual.Q.include P.variable] ;
nonreduced-relation : Nonreduced.O.Explanation[Nonreduced.n,Nonreduced.a,Nonreduced.b] = Nonreduced.explained ;
module Reg = PrincipalRegularity[l].Over[A] ;
module At (a : A.R) {
 module Q = Reg.At[a].P.Q ;
 flat : FlatRelations[l].Over[A,Q.ring,Q.projection].Flat = Field.To[Q.ring,Q.projection].flat ;
} ;
regular : Reg.Regular = Reg.from-principal-flat (\ a -> At[a].flat) ;
zero-regular : Tr.Trunc[Reg.Witness false].carrier = regular false ;
one-regular : Tr.Trunc[Reg.Witness true].carrier = regular true ;
