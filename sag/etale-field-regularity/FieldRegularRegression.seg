-- Constructed separable quadratic over F2: the new general diagonal
-- theorem supplies regularity for every element, not just its generator.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module ZM = BooleanRing[l] ;
A : CRing = ZM.two-ring ;
module C = Algebras[l].Over[A,ZM.bool-set] ;
module SE = StandardEtale[l].Over[A,ZM.bool-set] ; module P = SE.RX ;
module E = FormallyEtale[l].Over[A,ZM.bool-set] ;
q : P.Carrier = P.addQ (P.mulQ P.variable P.variable) (P.negQ P.variable) ;
module Pt = SE.Points[q,P.oneQ] ;
module At (a : A.R) {
 module X = SE.At[A,ZM.bool-set,H.identity A,a] ;
 value : Id A.R (X.value q) (A.add (A.mul a a) (A.neg a)) =
  trans (X.ev.2.2.1 (P.mulQ P.variable P.variable) (P.negQ P.variable))
   (Ps.cong2 A.R A.add _ _ _ _
    (trans (X.ev.2.2.2 P.variable P.variable) (Ps.cong2 A.R A.mul _ _ _ _ X.UP.on-variable X.UP.on-variable))
    (trans (H.negation P.ring A X.ev P.variable) (ap A.neg X.UP.on-variable))) ;
 dual : Id X.DN.Pair (X.evd.1 q) (X.DN.ring.add (X.DN.ring.mul (a,A.o) (a,A.o)) (X.DN.ring.neg (a,A.o))) =
  trans (X.evd.2.2.1 (P.mulQ P.variable P.variable) (P.negQ P.variable))
   (Ps.cong2 X.DN.Pair X.DN.ring.add _ _ _ _
    (trans (X.evd.2.2.2 P.variable P.variable)
     (Ps.cong2 X.DN.Pair X.DN.ring.mul _ _ _ _ X.UPe.on-variable X.UPe.on-variable))
    (trans (H.negation P.ring X.DN.ring X.evd P.variable) (ap X.DN.ring.neg X.UPe.on-variable))) ;
 g-value : Id A.R (X.value Pt.g) (X.derivative q) =
  trans (X.ev.2.2.2 P.oneQ (SE.deriv q))
   (trans (ap (\ z -> A.mul z (X.value (SE.deriv q))) X.ev.2.1)
    (trans (RL[A].one-left (X.value (SE.deriv q))) (SE.deriv-value A ZM.bool-set (H.identity A) a q))) ;
} ;
point0 : Pt.Point C.base = (false,At[false].value,
 subst (RL[A].unit) (sym (trans (At[false].g-value) (ap (\ p -> p.2) At[false].dual))) (true,refl true)) ;
point1 : Pt.Point C.base = (true,At[true].value,
 subst (RL[A].unit) (sym (trans (At[true].g-value) (ap (\ p -> p.2) At[true].dual))) (true,refl true)) ;
module Reps = FlatPolynomialData[l].Coefficients[A,ZM.bool-set] ;
empty-to-ring : Base.Empty -> Empty = split {} ;
module Test (rq : Reps.Representation q) (rg : Reps.Representation Pt.g) {
 module SA = StandardAlgebra[l].Over[A,ZM.bool-set].Build[q,P.oneQ,rq.1,rg.1,rq.2,rg.2] ;
 S : C.Algebra = SA.S ;
 etale : E.Etale S = StandardEtaleLift[l].Over[A,ZM.bool-set].At[q,P.oneQ,S,SA.standard].etale (SA.Loc.pres,SA.Loc.K.presentation) ;
 fp : Presentations[l].Over[A,ZM.bool-set].FP S =
  Truncation[l+].Trunc[Presentations[l].Over[A,ZM.bool-set].Witness S].inc (etale.2.1,etale.2.2) ;
 module R = UnramifiedFieldRegular[l].Over[A,ZM.bool-set,FieldRegression[l].dec].At[S,fp,etale.1.2] ;
 regular : PrincipalRegularity[l].Over[S.ring].Regular = R.regular ;
 dimension-zero : IntegralDescent[l].ZeroDim[S.ring,S.set].Property = R.zero-dimensional ;
 reduced (x : S.ring.R) (nil : AffinePowers[l].Over[S.ring].Nilpotent x) : Id S.ring.R x S.ring.z = R.reduced x nil ;
 v : C.Hom S C.base = (SA.standard.2 C.base).sec point1 ;
 x : S.ring.R = SA.point.1 ;
 vx : Id A.R (v.1.1 x) A.o = ap (\ p -> p.1) ((SA.standard.2 C.base).sec-eq point1) ;
 nonzero : Not (Id S.ring.R x S.ring.z) = \ h ->
  empty-to-ring (ZM.true-false (trans (sym vx) (trans (ap v.1.1 h) (H.zero S.ring A v.1)))) ;
 witness : Tr.Trunc[PrincipalRegularity[l].Over[S.ring].Witness x].carrier = regular x ;
} ;
Result : U l+ = (S : C.Algebra) * E.Etale S * PrincipalRegularity[l].Over[S.ring].Regular *
 (x : S.ring.R) * Not (Id S.ring.R x S.ring.z) ;
from (rq : Reps.Representation q) (rg : Reps.Representation Pt.g) : Result =
 (Test[rq,rg].S,Test[rq,rg].etale,Test[rq,rg].regular,Test[rq,rg].x,Test[rq,rg].nonzero) ;
from-q (rq : Reps.Representation q) : Truncation[l+].Trunc[Result].carrier =
 Tr.Trunc[Reps.Representation Pt.g].induction @(l+) (\ w -> Truncation[l+].Trunc[Result].carrier)
  (\ w -> Truncation[l+].Trunc[Result].proposition) (\ rg -> Truncation[l+].Trunc[Result].inc (from rq rg)) (Reps.representation Pt.g) ;
regression : Truncation[l+].Trunc[Result].carrier =
 Tr.Trunc[Reps.Representation q].induction @(l+) (\ w -> Truncation[l+].Trunc[Result].carrier)
  (\ w -> Truncation[l+].Trunc[Result].proposition) from-q (Reps.representation q) ;
