-- Flatness of A/(a) gives a=a^2*b. Apply the checked flat-kernel theorem
-- to a, then use effectiveness of the principal quotient to write its
-- kernel witness k as a*b. All witnesses stay under truncation.
level l ; open Ring[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) {
 Witness (a : A.R) : U l = (b : A.R) * Id A.R a (A.mul (A.mul a a) b) ;
 Regular : U l = (a : A.R) -> Tr.Trunc[Witness a].carrier ;
 module At (a : A.R) {
  module P = FlatPrincipalQuotient[l].Over[A,a] ;
  module WithFlat (flat : FlatRelations[l].Over[A,P.Q.ring,P.Q.projection].Flat) {
   module K = FlatQuotient[l].Over[A,P.Q.ring,P.Q.projection,P.onto,flat] ;
   assemble (k : K.Witness a) (v : P.Witness k.1) : Witness a =
    (v.1,trans k.2.2 (trans (ap (A.mul a) v.2) (A.mulA a a v.1))) ;
   reduce (k : K.Witness a) : Tr.Trunc[Witness a].carrier =
    TC.map (P.Witness k.1) (Witness a) (assemble k) (P.Q.kernel k.1 k.2.1) ;
   result : Tr.Trunc[Witness a].carrier =
    TC.bind (K.Witness a) (Witness a) reduce (K.theorem a P.root) ;
  } ;
  from-flat (flat : FlatRelations[l].Over[A,P.Q.ring,P.Q.projection].Flat) : Tr.Trunc[Witness a].carrier =
   WithFlat[flat].result ;
 } ;
 from-principal-flat
  (flat : (a : A.R) -> FlatRelations[l].Over[A,At[a].P.Q.ring,At[a].P.Q.projection].Flat) : Regular =
  \ a -> At[a].from-flat (flat a) ;
} ;
-- The application over a discrete field is separated from the transfer
-- theorem's construction. This adapter explicitly requires transfer;
-- it must not be reported as an unconditional unramified-field theorem.
module Field (k C : CRing)
 (dec : (x : k.R) -> Plus (Id k.R x k.z) ((w : k.R) * Id k.R (k.mul x w) k.o))
 (iota : RingHom[l].Hom k C)
 (transfer : (B : CRing) -> Prelude[l].isSet B.R -> (u : RingHom[l].Hom C B) ->
  FlatRelations[l].Over[k,B,RingHom[l].compose k C B u iota].Flat -> FlatRelations[l].Over[C,B,u].Flat) {
 module R = Over[C] ;
 module At (a : C.R) {
  module P = R.At[a].P ;
  base : RingHom[l].Hom k P.Q.ring = RingHom[l].compose k C P.Q.ring P.Q.projection iota ;
  field-flat : FlatRelations[l].Over[k,P.Q.ring,base].Flat = FieldFlat[l].Over[k,dec].To[P.Q.ring,base].flat ;
  flat : FlatRelations[l].Over[C,P.Q.ring,P.Q.projection].Flat = transfer P.Q.ring P.Q.set P.Q.projection field-flat ;
 } ;
 regular : R.Regular = R.from-principal-flat (\ a -> At[a].flat) ;
} ;
