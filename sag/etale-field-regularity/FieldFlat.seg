-- Every algebra over a discrete field is flat, without choosing a basis.
-- For a finite relation either all coefficients vanish, when the standard
-- columns explain it, or a_p*w=1. In that case put K_i=-w*delta(p,i)
-- and column(j,i)=delta(j,i)+a_j*K_i. Each column is a relation and
-- sum_j h(column(j,i))*b_j=b_i+h(K_i)*sum_j h(a_j)*b_j=b_i.
-- The proof needs only the zero-or-unit operation, even for the zero ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ;
module Over (A : CRing)
 (dec : (x : A.R) -> Plus (Id A.R x A.z) ((w : A.R) * Id A.R (A.mul x w) A.o)) {
 module LA = RL[A] ; module SA = FiniteIdeal[l].Sums[A] ; module DA = MnSums[l].Over[A] ;
 Cases (n : Nat) (a : Fin n -> A.R) : U l =
  Plus ((i : Fin n) -> Id A.R (a i) A.z)
   ((p : Fin n) * (w : A.R) * Id A.R (A.mul (a p) w) A.o) ;
 zero-step (n : Nat) (a : Fin (suc n) -> A.R) (hz : Id A.R (a (inr tt)) A.z) :
  Cases n (\ i -> a (inl i)) -> Cases (suc n) a = split {
  inl hs -> inl (AffineFinite[l].section n (\ i -> Id A.R (a i) A.z) hs hz) ;
  inr p -> inr (inl p.1,p.2) } ;
 step (n : Nat) (a : Fin (suc n) -> A.R) (old : Cases n (\ i -> a (inl i))) :
  Plus (Id A.R (a (inr tt)) A.z) ((w : A.R) * Id A.R (A.mul (a (inr tt)) w) A.o) -> Cases (suc n) a = split {
  inl hz -> zero-step n a hz old ;
  inr w -> inr (inr tt,w) } ;
 cases : (n : Nat) (a : Fin n -> A.R) -> Cases n a = split {
  zero -> \ a -> inl (\ i -> efq i) ;
  suc n | ih -> \ a -> step n a (ih (\ i -> a (inl i))) (dec (a (inr tt))) } ;
 module To (B : CRing) (h : RingHom[l].Hom A B) {
  module LB = RL[B] ; module SB = FiniteIdeal[l].Sums[B] ; module DB = MnSums[l].Over[B] ;
  module O = FlatRelations[l].Over[A,B,h] ;
  delta : (n : Nat) (i j : Fin n) -> Id B.R (h.1 (DA.delta n i j)) (DB.delta n i j) = split {
   zero -> \ i j -> RingHom[l].zero A B h ;
   suc n | ih -> split {
    inl i -> split { inl j -> ih i j ; inr t -> RingHom[l].zero A B h } ;
    inr t -> split { inl j -> RingHom[l].zero A B h ; inr u -> h.2.1 } } } ;
  row (n : Nat) (i : Fin n) (b : Fin n -> B.R) :
   Id B.R (SB.lin n (\ j -> h.1 (DA.delta n j i)) b) (b i) =
   trans (SB.sum-cong n (\ j -> B.mul (h.1 (DA.delta n j i)) (b j))
    (\ j -> B.mul (DB.delta n i j) (b j))
    (\ j -> ap (\ t -> B.mul t (b j)) (trans (delta n j i) (DB.delta-sym n j i))))
    (DB.sum-delta n i b) ;
  zero-relation (n : Nat) (a : Fin n -> A.R) (hz : (i : Fin n) -> Id A.R (a i) A.z)
   (c : Fin n -> A.R) : Id A.R (SA.lin n a c) A.z =
   trans (SA.sum-cong n (\ i -> A.mul (a i) (c i)) (\ i -> A.z)
    (\ i -> trans (ap (\ t -> A.mul t (c i)) (hz i)) (LA.zero-mul (c i)))) (SA.sum-zero n) ;
  zero-explanation (n : Nat) (a : Fin n -> A.R) (b : Fin n -> B.R)
   (hz : (i : Fin n) -> Id A.R (a i) A.z) : O.Explanation[n,a,b] =
   new O.Explanation[n,a,b,n,DA.delta n,b,\ i -> sym (row n i b),\ j -> zero-relation n a hz (DA.delta n j)] ;
  module Pivot (n : Nat) (a : Fin n -> A.R) (b : Fin n -> B.R)
   (r : O.Relation n a b) (p : Fin n) (w : A.R) (unit : Id A.R (A.mul (a p) w) A.o) {
   K (i : Fin n) : A.R = A.neg (A.mul w (DA.delta n p i)) ;
   col (j i : Fin n) : A.R = A.add (DA.delta n j i) (A.mul (a j) (K i)) ;
   k-value : Id A.R (SA.lin n a K) (A.neg A.o) =
    trans (SA.lin-neg n a (\ i -> A.mul w (DA.delta n p i)))
     (trans (ap A.neg (SA.lin-scale n a (DA.delta n p) w))
      (trans (ap (\ t -> A.neg (A.mul w t))
       (trans (FlatRelations[l].lin-comm A n a (DA.delta n p)) (DA.sum-delta n p a)))
       (ap A.neg (trans (A.mulC w (a p)) unit)))) ;
   relation (j : Fin n) : Id A.R (SA.lin n a (col j)) A.z =
    trans (SA.lin-add n a (DA.delta n j) (\ i -> A.mul (a j) (K i)))
     (trans (cong2 A.R A.add _ _ _ _
      (trans (FlatRelations[l].lin-comm A n a (DA.delta n j)) (DA.sum-delta n j a))
      (trans (SA.lin-scale n a K (a j)) (ap (A.mul (a j)) k-value)))
      (trans (ap (A.add (a j)) (trans (LA.mul-neg (a j) A.o) (ap A.neg (A.mulO (a j)))))
       (A.addN (a j)))) ;
   term (i j : Fin n) : Id B.R (B.mul (h.1 (col j i)) (b j))
    (B.add (B.mul (h.1 (DA.delta n j i)) (b j))
     (B.mul (h.1 (K i)) (B.mul (h.1 (a j)) (b j)))) =
    trans (ap (\ t -> B.mul t (b j)) (h.2.2.1 (DA.delta n j i) (A.mul (a j) (K i))))
     (trans (LB.dist-left (h.1 (DA.delta n j i)) (h.1 (A.mul (a j) (K i))) (b j))
      (ap (B.add (B.mul (h.1 (DA.delta n j i)) (b j)))
       (trans (ap (\ t -> B.mul t (b j)) (h.2.2.2 (a j) (K i)))
        (trans (sym (B.mulA (h.1 (a j)) (h.1 (K i)) (b j)))
         (LB.mul-swap (h.1 (a j)) (h.1 (K i)) (b j)))))) ;
   expands (i : Fin n) : Id B.R (b i) (SB.lin n (\ j -> h.1 (col j i)) b) = sym
    (trans (SB.sum-cong n (\ j -> B.mul (h.1 (col j i)) (b j))
     (\ j -> B.add (B.mul (h.1 (DA.delta n j i)) (b j))
      (B.mul (h.1 (K i)) (B.mul (h.1 (a j)) (b j)))) (term i))
     (trans (SB.sum-add n (\ j -> B.mul (h.1 (DA.delta n j i)) (b j))
      (\ j -> B.mul (h.1 (K i)) (B.mul (h.1 (a j)) (b j))))
      (trans (cong2 B.R B.add _ _ _ _ (row n i b)
       (trans (SB.sum-scale (h.1 (K i)) n (\ j -> B.mul (h.1 (a j)) (b j)))
        (trans (ap (B.mul (h.1 (K i))) r) (LB.mul-zero (h.1 (K i)))))) (B.addZ (b i))))) ;
   explanation : O.Explanation[n,a,b] = new O.Explanation[n,a,b,n,col,b,expands,relation] ;
  } ;
  choose (n : Nat) (a : Fin n -> A.R) (b : Fin n -> B.R) (r : O.Relation n a b) :
   Cases n a -> O.Explanation[n,a,b] = split {
   inl hz -> zero-explanation n a b hz ;
   inr pw -> Pivot[n,a,b,r,pw.1,pw.2.1,pw.2.2].explanation } ;
  explanation (n : Nat) (a : Fin n -> A.R) (b : Fin n -> B.R) (r : O.Relation n a b) :
   O.Explanation[n,a,b] = choose n a b r (cases n a) ;
  flat : O.Flat = \ n a b r -> Tr.Trunc[O.Explanation[n,a,b]].inc (explanation n a b r) ;
 } ;
} ;
