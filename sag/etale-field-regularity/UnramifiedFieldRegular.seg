-- Unconditional field-level regularity from finite presentation and
-- uniqueness of square-zero lifting. The diagonal, flat basechange and
-- averaging are constructed in FlatDiagonalTransfer, not assumed here.
-- Apply transfer to each effective principal quotient C/(a), which is
-- field-flat by FieldFlat; then a=a^2*b by PrincipalRegularity.
-- The zero-or-unit operation need only be merely given.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (x : k.R) -> Tr.Trunc[FieldFlat[l].Over[k].Decision x].carrier) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module FE = FormallyEtale[l].Over[k,setk] ;
 module At (S : C.Algebra) (fp : P.FP S) (unique : FE.Unique S) {
  module R = PrincipalRegularity[l].Over[S.ring] ;
  module Principal (a : S.ring.R) {
   module Q = R.At[a].P.Q ;
   iota : H.Hom k Q.ring = H.compose k S.ring Q.ring Q.projection S.iota ;
   algebra : C.Algebra = C.mkAlgebra Q.ring Q.set iota ;
   map : C.Hom S algebra = (Q.projection,\ x -> refl (Q.projection.1 (S.iota.1 x))) ;
   base-flat : FlatRelations[l].Over[k,Q.ring,iota].Flat = FieldFlat[l].Over[k].Mere[dec].flat Q.ring iota ;
   flat : FlatRelations[l].Over[S.ring,Q.ring,Q.projection].Flat =
    FlatDiagonalTransfer[l].Over[k,setk].At[S,algebra,map,fp,unique,base-flat].theorem ;
  } ;
  regular : R.Regular = R.from-principal-flat (\ a -> Principal[a].flat) ;
  reduced (a : S.ring.R) (nil : AffinePowers[l].Over[S.ring].Nilpotent a) : Id S.ring.R a S.ring.z =
   RegularReduced[l].Over[S.ring,S.set].reduced regular a nil ;
  zero-dimensional : IntegralDescent[l].ZeroDim[S.ring,S.set].Property =
   IntegralDescent[l].ZeroDim[S.ring,S.set].from-regular regular ;
 } ;
} ;
