-- A von Neumann regular commutative set-ring is reduced. For a=a^2*b,
-- put r=a*b. Induction gives a=a*r^n. If a^n=0 then r^n=a^n*b^n=0,
-- so a=0. This includes n=0 and the zero ring.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module L = RL[A] ; module P = AffinePowers[l].Over[A] ; module Reg = PrincipalRegularity[l].Over[A] ;
 module At (a b : A.R) (eq : Id A.R a (A.mul (A.mul a a) b)) {
  r : A.R = A.mul a b ;
  absorb : Id A.R a (A.mul a r) = trans eq (sym (A.mulA a a b)) ;
  iterate : (n : Nat) -> Id A.R a (A.mul a (P.power r n)) = split {
   zero -> sym (A.mulO a) ;
   suc n | ih -> trans ih
    (trans (ap (\ t -> A.mul t (P.power r n)) absorb) (sym (A.mulA a r (P.power r n)))) } ;
  kill (n : Nat) (nil : Id A.R (P.power a n) A.z) : Id A.R a A.z =
   trans (iterate n)
    (trans (ap (A.mul a)
     (trans (P.power-mul a b n)
      (trans (ap (\ t -> A.mul t (P.power b n)) nil) (L.zero-mul (P.power b n))))) (L.mul-zero a)) ;
 } ;
 kill-witness (a : A.R) (n : Nat) (nil : Id A.R (P.power a n) A.z) (w : Reg.Witness a) : Id A.R a A.z =
  At[a,w.1,w.2].kill n nil ;
 kill (regular : Reg.Regular) (a : A.R) (n : Nat) (nil : Id A.R (P.power a n) A.z) : Id A.R a A.z =
  TC.rec (Reg.Witness a) @l (Id A.R a A.z) (setA _ _) (kill-witness a n nil) (regular a) ;
 reduced (regular : Reg.Regular) (a : A.R) (nil : P.Nilpotent a) : Id A.R a A.z =
  TC.rec ((n : Nat) * Id A.R (P.power a n) A.z) @l (Id A.R a A.z) (setA _ _)
   (\ w -> kill regular a w.1 w.2) nil ;
} ;
