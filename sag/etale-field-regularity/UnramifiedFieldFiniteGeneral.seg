-- Finite presentation and formal unramifiedness over a discrete nonzero
-- field imply finite module span. The number of generators is arbitrary.
-- The diagonal gives regularity, hence algebraic dimension zero; the
-- constructed Nagata reduction supplies the full finite-generation
-- induction. No field structure of the target, basis, or ZMT is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TH = Truncation[l+] ;
module TC = TruncationCombinators[l+] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nontrivial : Not (Id k.R k.o k.z)) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 module FE = FormallyEtale[l].Over[k,setk] ;
 module Finite = ZeroDimensionalFinite[l].Over[k,setk,dec,nontrivial] ;
 module Presented (p : P.Presentation) (S : C.Algebra) (ps : P.Presents p S) (unique : FE.Unique S) {
  module Old = Generated[l].Over[k,setk] ;
  module PG = Old.Generated[p,S,ps] ;
  module G = GeneratedSubalgebra[l].Over[k,setk].At[S,p.1,ps.1.1] ;
  generated : G.Generators = PG.generated ;
  fp : P.FP S = TH.Trunc[P.Witness S].inc (p,ps) ;
  module R = UnramifiedFieldRegular[l].Over[k,setk,dec].At[S,fp,unique] ;
  finite : FiniteSpan[l].Over[k,S.ring,S.iota].Finite =
   Finite.theorem p.1 S ps.1.1 generated R.zero-dimensional ;
 } ;
 module At (S : C.Algebra) (fp : P.FP S) (unique : FE.Unique S) {
  module FS = FiniteSpan[l].Over[k,S.ring,S.iota] ;
  finite : FS.Finite = TC.rec (P.Witness S) @l FS.Finite Tr.Trunc[FS.Data].proposition
   (\ w -> Presented[w.1,S,w.2,unique].finite) fp ;
  module Integrals = FiniteSpanIntegral[l].Over[k,S.ring,setk,S.set,S.iota] ;
  integral : Integrals.IM.Extension = Integrals.theorem finite ;
 } ;
} ;
