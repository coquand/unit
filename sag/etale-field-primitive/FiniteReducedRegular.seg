-- A reduced finite-basis algebra over a weak field is regular. The
-- determinant trick supplies monic annihilators and weak coefficient
-- stripping supplies mere regular witnesses. exact-theorem retains
-- the original endpoint. No minimal polynomial or infinite choice is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n])
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z) {
 module F = FiniteSpan[l].Over[k,S.ring,S.iota] ;
 module I = FiniteSpanIntegral[l].Over[k,S.ring,setk,S.set,S.iota] ;
 module IM = IntegralDescent[l].Map[k,S.ring,S.iota] ;
 module R = ReducedIntegralRegular[l].Over[k,setk,S,reduced] ;
 finite : F.Data = (n,basis.vector,\ a -> Tr.Trunc[F.Coordinates n basis.vector a].inc (basis.coordinate a,basis.reconstruction a)) ;
 module At (a : S.ring.R) {
  module H = MonicValueNaturality[l].Over[k,setk].Horner[S,a] ;
  convert (w : IM.IntegralWitness a) :
   (lower : List k.R) * Id S.ring.R (R.value a (R.Statement.monic lower)) S.ring.z =
   (w.1,trans (H.equation w.1) (trans (H.integral-value w.1) w.2)) ;
  annihilator : Tr.Trunc[(lower : List k.R) * Id S.ring.R (R.value a (R.Statement.monic lower)) S.ring.z].carrier =
   TC.map (IM.IntegralWitness a)
    ((lower : List k.R) * Id S.ring.R (R.value a (R.Statement.monic lower)) S.ring.z) convert (I.integral finite a) ;
 } ;
 theorem (weak : (a : k.R) -> Tr.Trunc[Plus (Id k.R a k.z) (RL[k].unit a)].carrier) :
  PrincipalRegularity[l].Over[S.ring].Regular = R.Mere[weak].regular (\ a -> At[a].annihilator) ;
 exact-theorem (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a)) :
  PrincipalRegularity[l].Over[S.ring].Regular = R.Exact[dec].regular (\ a -> At[a].annihilator) ;
} ;
