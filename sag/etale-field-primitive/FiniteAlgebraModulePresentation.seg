-- A finite A-module presentation of S from finite k-bases of A and S.
-- Generators are the k-basis b_j of S. For each basis a_i of A impose
-- a_i*u_j = sum_t iota_A(lambda_t(h(a_i)*b_j))*u_t.
-- Expanding every coefficient c_j in the basis a_i proves the exact
-- identity sum_ij iota_A(coord_i(c_j))*relation_ij = c-eta(phi(c)).
-- Thus every kernel vector has explicit relation coefficients. No
-- field, injectivity, regularity or choice hypothesis is required.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Sums (R : CRing) {
 module S = FiniteIdeal[l].Sums[R] ; module L = RL[R] ;
 negation : (n : Nat) (v : Fin n -> R.R) ->
  Id R.R (S.sum n (\ i -> R.neg (v i))) (R.neg (S.sum n v)) = split {
  zero -> \ v -> sym L.neg-zero ;
  suc n | ih -> \ v -> trans (ap (R.add (R.neg (v (inr tt)))) (ih (\ i -> v (inl i))))
   (sym (L.neg-add (v (inr tt)) (S.sum n (\ i -> v (inl i))))) } ;
 difference (n : Nat) (v w : Fin n -> R.R) :
  Id R.R (S.sum n (\ i -> R.add (v i) (R.neg (w i)))) (R.add (S.sum n v) (R.neg (S.sum n w))) =
  trans (S.sum-add n v (\ i -> R.neg (w i))) (ap (R.add (S.sum n v)) (negation n w)) ;
} ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (A S : Algebras[l].Over[k,setk].Algebra) (h : Algebras[l].Over[k,setk].Hom A S)
 (m n : Nat) (ab : TraceBasis[l].Over[k,setk,A].Basis[m])
 (sb : TraceBasis[l].Over[k,setk,S].Basis[n]) {
 module C = Algebras[l].Over[k,setk] ; module TL = TraceLinear[l].Over[k,setk] ;
 module V = GaussianVectors[l].Over[A.ring] ; module Delta = MnSums[l].Over[A.ring] ;
 module KS = FiniteIdeal[l].Sums[k] ; module AS = FiniteIdeal[l].Sums[A.ring] ;
 module SS = FiniteIdeal[l].Sums[S.ring] ; module AL = RL[A.ring] ; module SL = RL[S.ring] ;
 module AB = TraceBasis[l].Over[k,setk,A].At[m,ab] ;
 module SB = TraceBasis[l].Over[k,setk,S].At[n,sb] ; module FP = FiniteProduct[l] ;
 iota-linear : TL.Linear[C.base,A] = new TL.Linear[C.base,A,A.iota.1,A.iota.2.2.1,A.iota.2.2.2] ;
 module Iota = TL.Map[C.base,A,iota-linear] ;
 phi (c : V.Vec n) : S.ring.R = SS.sum n (\ j -> S.ring.mul (h.1.1 (c j)) (sb.vector j)) ;
 eta (b : S.ring.R) : V.Vec n = \ j -> A.iota.1 (sb.coordinate b j) ;
 phi-eta (b : S.ring.R) : Id S.ring.R (phi (eta b)) b =
  trans (SS.sum-cong n (\ j -> S.ring.mul (h.1.1 (eta b j)) (sb.vector j))
   (\ j -> S.ring.mul (S.iota.1 (sb.coordinate b j)) (sb.vector j))
   (\ j -> ap (\ a -> S.ring.mul a (sb.vector j)) (h.2 (sb.coordinate b j)))) (sb.reconstruction b) ;
 phi-add (c d : V.Vec n) : Id S.ring.R (phi (V.addV n c d)) (S.ring.add (phi c) (phi d)) =
  trans (SS.sum-cong n (\ j -> S.ring.mul (h.1.1 (A.ring.add (c j) (d j))) (sb.vector j))
   (\ j -> S.ring.add (S.ring.mul (h.1.1 (c j)) (sb.vector j)) (S.ring.mul (h.1.1 (d j)) (sb.vector j)))
   (\ j -> trans (ap (\ a -> S.ring.mul a (sb.vector j)) (h.1.2.2.1 (c j) (d j)))
   (SL.dist-left (h.1.1 (c j)) (h.1.1 (d j)) (sb.vector j))))
   (SS.sum-add n (\ j -> S.ring.mul (h.1.1 (c j)) (sb.vector j)) (\ j -> S.ring.mul (h.1.1 (d j)) (sb.vector j))) ;
 phi-scale (a : A.ring.R) (c : V.Vec n) : Id S.ring.R (phi (V.scaleV n a c)) (S.ring.mul (h.1.1 a) (phi c)) =
  trans (SS.sum-cong n (\ j -> S.ring.mul (h.1.1 (A.ring.mul a (c j))) (sb.vector j))
   (\ j -> S.ring.mul (h.1.1 a) (S.ring.mul (h.1.1 (c j)) (sb.vector j)))
   (\ j -> trans (ap (\ z -> S.ring.mul z (sb.vector j)) (h.1.2.2.2 a (c j)))
   (sym (S.ring.mulA (h.1.1 a) (h.1.1 (c j)) (sb.vector j)))))
   (SS.sum-scale (h.1.1 a) n (\ j -> S.ring.mul (h.1.1 (c j)) (sb.vector j))) ;
 module UM = FlatRelations[l].Over[A.ring,S.ring,h.1].Underlying[A.set,S.set] ;
 module DL = DescentLinear[l].Over[A.ring,A.set] ;
 module SM = DescentSubmodules[l].Over[Modules[l].Over[A.ring,A.set].ring] ;
 linear : SM.Linear (DL.Free n) UM.M = (phi,phi-add,phi-scale) ;
 module Phi = SM.Lin[DL.Free n,UM.M,linear] ;
 delta-hom : (r : Nat) (i j : Fin r) ->
  Id S.ring.R (h.1.1 (Delta.delta r i j)) (MnSums[l].Over[S.ring].delta r i j) = split {
  zero -> \ i j -> RingHom[l].zero A.ring S.ring h.1 ;
  suc r | ih -> split {
   inl i -> split { inl j -> ih i j ; inr t -> RingHom[l].zero A.ring S.ring h.1 } ;
   inr t -> split { inl j -> RingHom[l].zero A.ring S.ring h.1 ; inr u -> h.1.2.1 } } } ;
 phi-unit (j : Fin n) : Id S.ring.R (phi (Delta.delta n j)) (sb.vector j) =
  trans (SS.sum-cong n (\ i -> S.ring.mul (h.1.1 (Delta.delta n j i)) (sb.vector i))
   (\ i -> S.ring.mul (MnSums[l].Over[S.ring].delta n j i) (sb.vector i))
   (\ i -> ap (\ a -> S.ring.mul a (sb.vector i)) (delta-hom n j i)))
   (MnSums[l].Over[S.ring].sum-delta n j sb.vector) ;
 module Column (j : Fin n) {
  value (a : A.ring.R) : S.ring.R = S.ring.mul (h.1.1 a) (sb.vector j) ;
  add (a b : A.ring.R) : Id S.ring.R (value (A.ring.add a b)) (S.ring.add (value a) (value b)) =
   trans (ap (\ z -> S.ring.mul z (sb.vector j)) (h.1.2.2.1 a b)) (SL.dist-left (h.1.1 a) (h.1.1 b) (sb.vector j)) ;
  scale (r : k.R) (a : A.ring.R) : Id S.ring.R (value (A.ring.mul (A.iota.1 r) a)) (S.ring.mul (S.iota.1 r) (value a)) =
   trans (ap (\ z -> S.ring.mul z (sb.vector j)) (h.1.2.2.2 (A.iota.1 r) a))
    (trans (ap (\ z -> S.ring.mul (S.ring.mul z (h.1.1 a)) (sb.vector j)) (h.2 r))
     (sym (S.ring.mulA (S.iota.1 r) (h.1.1 a) (sb.vector j)))) ;
  map : TL.Linear[A,S] = new TL.Linear[A,S,value,add,scale] ;
  module Coordinates = TL.Coordinates[A,S,m,n,ab,sb,map] ;
  rel (i : Fin m) : V.Vec n = V.subV n (V.scaleV n (ab.vector i) (Delta.delta n j)) (eta (value (ab.vector i))) ;
  killed (i : Fin m) : Id S.ring.R (phi (rel i)) S.ring.z =
   trans (Phi.map-sub (V.scaleV n (ab.vector i) (Delta.delta n j)) (eta (value (ab.vector i))))
    (trans (cong2 S.ring.R S.ring.add _ _ _ _
     (trans (phi-scale (ab.vector i) (Delta.delta n j)) (ap (S.ring.mul (h.1.1 (ab.vector i))) (phi-unit j)))
     (ap S.ring.neg (phi-eta (value (ab.vector i))))) (S.ring.addN (value (ab.vector i)))) ;
  module At (a : A.ring.R) (t : Fin n) {
   coefficient (i : Fin m) : A.ring.R = A.iota.1 (ab.coordinate a i) ;
   first : Id A.ring.R (AS.sum m (\ i -> A.ring.mul (A.ring.mul (ab.vector i) (Delta.delta n j t)) (coefficient i)))
    (A.ring.mul a (Delta.delta n j t)) =
    trans (AS.sum-cong m _ _ (\ i -> trans (sym (A.ring.mulA (ab.vector i) (Delta.delta n j t) (coefficient i)))
     (trans (AL.mul-swap (ab.vector i) (Delta.delta n j t) (coefficient i))
      (ap (A.ring.mul (Delta.delta n j t)) (A.ring.mulC (ab.vector i) (coefficient i))))))
     (trans (AS.sum-scale (Delta.delta n j t) m (\ i -> A.ring.mul (coefficient i) (ab.vector i)))
      (trans (ap (A.ring.mul (Delta.delta n j t)) (ab.reconstruction a)) (A.ring.mulC (Delta.delta n j t) a))) ;
   second : Id A.ring.R (AS.sum m (\ i -> A.ring.mul (eta (value (ab.vector i)) t) (coefficient i)))
    (A.iota.1 (sb.coordinate (value a) t)) =
    trans (AS.sum-cong m _ _ (\ i -> trans (A.ring.mulC (eta (value (ab.vector i)) t) (coefficient i))
     (sym (A.iota.2.2.2 (ab.coordinate a i) (sb.coordinate (value (ab.vector i)) t)))))
     (trans (sym (Iota.sum m (\ i -> k.mul (ab.coordinate a i) (sb.coordinate (value (ab.vector i)) t))))
      (ap A.iota.1 (sym (Coordinates.image a t)))) ;
   equation : Id A.ring.R (AS.sum m (\ i -> A.ring.mul (rel i t) (coefficient i)))
    (A.ring.add (A.ring.mul a (Delta.delta n j t)) (A.ring.neg (eta (value a) t))) =
    trans (AS.sum-cong m _ _ (\ i -> trans (AL.dist-left (A.ring.mul (ab.vector i) (Delta.delta n j t))
     (A.ring.neg (eta (value (ab.vector i)) t)) (coefficient i))
     (ap (A.ring.add (A.ring.mul (A.ring.mul (ab.vector i) (Delta.delta n j t)) (coefficient i)))
      (AL.neg-mul-left (eta (value (ab.vector i)) t) (coefficient i)))))
     (trans (Sums[A.ring].difference m
      (\ i -> A.ring.mul (A.ring.mul (ab.vector i) (Delta.delta n j t)) (coefficient i))
      (\ i -> A.ring.mul (eta (value (ab.vector i)) t) (coefficient i)))
      (cong2 A.ring.R A.ring.add _ _ _ _ first (ap A.ring.neg second))) ;
  } ;
 } ;
 count : Nat = FP.size n m ;
 relations (u : Fin count) : V.Vec n = Column[(FP.decode n m u).1].rel (FP.decode n m u).2 ;
 killed (u : Fin count) : Id S.ring.R (phi (relations u)) S.ring.z = Column[(FP.decode n m u).1].killed (FP.decode n m u).2 ;
 coefficients (c : V.Vec n) (u : Fin count) : A.ring.R = A.iota.1 (ab.coordinate (c (FP.decode n m u).1) (FP.decode n m u).2) ;
 module At (c : V.Vec n) (t : Fin n) {
  second : Id A.ring.R (AS.sum n (\ j -> eta (Column[j].value (c j)) t)) (eta (phi c) t) =
   trans (sym (Iota.sum n (\ j -> sb.coordinate (Column[j].value (c j)) t)))
    (ap A.iota.1 (sym (SB.sum n (\ j -> Column[j].value (c j)) t))) ;
  equation : Id A.ring.R (V.comb n count relations (coefficients c) t) (V.subV n c (eta (phi c)) t) =
   trans (FP.Sums[A.ring].rectangular n m
    (\ p -> A.ring.mul (Column[p.1].rel p.2 t) (A.iota.1 (ab.coordinate (c p.1) p.2))))
    (trans (AS.sum-cong n _ _ (\ j -> Column[j].At[c j,t].equation))
     (trans (Sums[A.ring].difference n (\ j -> A.ring.mul (c j) (Delta.delta n j t)) (\ j -> eta (Column[j].value (c j)) t))
      (cong2 A.ring.R A.ring.add _ _ _ _ (Delta.sum-delta-right n t c) (ap A.ring.neg second)))) ;
 } ;
 difference (c : V.Vec n) : V.Span[n,count,relations].Witness (V.subV n c (eta (phi c))) =
  (coefficients c,\ t -> At[c,t].equation) ;
 kernel (c : V.Vec n) (hc : Id S.ring.R (phi c) S.ring.z) : V.Span[n,count,relations].Witness c =
  (coefficients c,\ t -> trans (At[c,t].equation)
   (trans (ap (\ a -> A.ring.add (c t) (A.ring.neg (A.iota.1 a)))
    (trans (ap (\ a -> sb.coordinate a t) hc) (SB.zero t)))
    (trans (ap (\ a -> A.ring.add (c t) (A.ring.neg a)) (RingHom[l].zero k A.ring A.iota))
     (trans (ap (A.ring.add (c t)) AL.neg-zero) (A.ring.addZ (c t)))))) ;
 onto (b : S.ring.R) : Tr.Trunc[(c : V.Vec n) * Id S.ring.R (phi c) b].carrier =
  Tr.Trunc[(c : V.Vec n) * Id S.ring.R (phi c) b].inc (eta b,phi-eta b) ;
 kernel-merely (c : V.Vec n) (hc : Id S.ring.R (phi c) S.ring.z) : Tr.Trunc[V.Span[n,count,relations].Witness c].carrier =
  Tr.Trunc[V.Span[n,count,relations].Witness c].inc (kernel c hc) ;
} ;
