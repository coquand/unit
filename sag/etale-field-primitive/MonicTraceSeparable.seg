-- The derivative in a monic quotient has zero annihilator when its
-- trace pairing is nondegenerate. An annihilator h gives the root
-- x+h*epsilon in the dual numbers and hence a self-valued derivation
-- with D(x)=h. The trace-commutator theorem forces h=0.
-- If the quotient is regular, a=a^2*b then makes the derivative a unit.
-- All quotient, finite-basis and dual-root constructions are actual.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (lower : List k.R) {
 module C = Algebras[l].Over[k,setk] ; module M = MonicBasisUniversal[l].Over[k,setk].At[lower] ;
 Q : C.Algebra = M.Q ; module L = RL[Q.ring] ;
 module V = MonicDualValues[l].Over[k,Q.ring,Q.set,Q.iota,M.x] ; module D = V.D ;
 dual-algebra : C.Algebra = C.mkAlgebra D.ring D.set V.dual ;
 projection : C.Hom dual-algebra Q =
  ((\ a -> a.1,refl Q.ring.o,\ a b -> refl (Q.ring.add a.1 b.1),
   \ a b -> trans (ap (Q.ring.add (Q.ring.mul a.1 b.1)) (L.zero-mul (Q.ring.mul a.2 b.2)))
    (Q.ring.addZ (Q.ring.mul a.1 b.1))),\ r -> refl (Q.iota.1 r)) ;
 module Der = TraceDerivations[l].Over[k,setk,Q,M.degree,M.basis] ;
 module B = TraceBasis[l].Over[k,setk,Q].At[M.degree,M.basis] ;
 derivative : Q.ring.R = V.slope lower ;
 module Ordinary = MonicReduce[l].Horner[k,D.ring,V.dual,(M.x,Q.ring.o)] ;
 slope : Q.ring.R = (Ordinary.horner (SelectedFactorStatement[l].Over[k,setk].monic lower)).2 ;
 slope-is : Id Q.ring.R slope derivative = ap (\ z -> z.2)
  (MonicValueNaturality[l].Over[k,setk].Horner[dual-algebra,(M.x,Q.ring.o)].equation lower) ;
 module Annihilator (h : Q.ring.R) (killed : Id Q.ring.R (Q.ring.mul derivative h) Q.ring.z) {
  dual-root : Id D.Pair (V.At[h].Value.value lower) D.zeroQ =
   trans (V.equation h lower) (D.eq _ _ M.root killed) ;
  module Lift = M.To[dual-algebra,(M.x,h),dual-root] ;
  first-map : C.Hom Q Q = C.compose Q dual-algebra Q projection Lift.hom ;
  first (a : Q.ring.R) : Id Q.ring.R (Lift.hom.1.1 a).1 a =
   M.unique Q first-map (C.identity Q) (ap (\ z -> z.1) Lift.beta) a ;
  value (a : Q.ring.R) : Q.ring.R = (Lift.hom.1.1 a).2 ;
  add (a b : Q.ring.R) : Id Q.ring.R (value (Q.ring.add a b)) (Q.ring.add (value a) (value b)) =
   ap (\ z -> z.2) (Lift.hom.1.2.2.1 a b) ;
  scale (r : k.R) (a : Q.ring.R) : Id Q.ring.R (value (Q.ring.mul (Q.iota.1 r) a)) (Q.ring.mul (Q.iota.1 r) (value a)) =
   trans (ap (\ z -> z.2) (Lift.hom.1.2.2.2 (Q.iota.1 r) a))
    (trans (ap (\ z -> (D.timesQ z (Lift.hom.1.1 a)).2) (Lift.hom.2 r))
     (trans (ap (Q.ring.add (Q.ring.mul (Q.iota.1 r) (value a))) (L.zero-mul (Lift.hom.1.1 a).1))
      (Q.ring.addZ (Q.ring.mul (Q.iota.1 r) (value a))))) ;
  linear : TraceLinear[l].Over[k,setk].Linear[Q,Q] =
   new TraceLinear[l].Over[k,setk].Linear[Q,Q,value,add,scale] ;
  product (a b : Q.ring.R) : Id Q.ring.R (value (Q.ring.mul a b))
   (Q.ring.add (Q.ring.mul (value a) b) (Q.ring.mul a (value b))) =
   trans (ap (\ z -> z.2) (Lift.hom.1.2.2.2 a b))
    (trans (cong2 Q.ring.R Q.ring.add _ _ _ _
     (ap (\ z -> Q.ring.mul z (value b)) (first a)) (ap (Q.ring.mul (value a)) (first b)))
     (Q.ring.addC (Q.ring.mul a (value b)) (Q.ring.mul (value a) b))) ;
  derivation : Der.Derivation = new Der.Derivation[linear,product] ;
  generator : Id Q.ring.R (value M.x) h = ap (\ z -> z.2) Lift.beta ;
  zero
   (nondegenerate : (a : Q.ring.R) -> ((b : Q.ring.R) -> Id k.R (B.trace (Q.ring.mul a b)) k.z) -> Id Q.ring.R a Q.ring.z) :
   Id Q.ring.R h Q.ring.z = trans (sym generator) (Der.Given[derivation].from-nondegenerate nondegenerate M.x) ;
 } ;
 module Regular
  (nondegenerate : (a : Q.ring.R) -> ((b : Q.ring.R) -> Id k.R (B.trace (Q.ring.mul a b)) k.z) -> Id Q.ring.R a Q.ring.z) {
  module Witness (b : Q.ring.R) (hb : Id Q.ring.R derivative (Q.ring.mul (Q.ring.mul derivative derivative) b)) {
   complement : Q.ring.R = Q.ring.add Q.ring.o (Q.ring.neg (Q.ring.mul derivative b)) ;
   kills : Id Q.ring.R (Q.ring.mul derivative complement) Q.ring.z =
    trans (Q.ring.dist derivative Q.ring.o (Q.ring.neg (Q.ring.mul derivative b)))
     (trans (cong2 Q.ring.R Q.ring.add _ _ _ _ (Q.ring.mulO derivative)
      (trans (L.mul-neg derivative (Q.ring.mul derivative b))
       (ap Q.ring.neg (trans (Q.ring.mulA derivative derivative b) (sym hb))))) (Q.ring.addN derivative)) ;
   complement-zero : Id Q.ring.R complement Q.ring.z = Annihilator[complement,kills].zero nondegenerate ;
   unit : L.unit derivative = (b,sym (FormallyEtale[l].Units[Q.ring,Q.set].sub-zero Q.ring.o (Q.ring.mul derivative b) complement-zero)) ;
  } ;
  theorem (regular : PrincipalRegularity[l].Over[Q.ring].Regular) : L.unit derivative =
   TC.rec (PrincipalRegularity[l].Over[Q.ring].Witness derivative) @l (L.unit derivative)
    (FormallyEtale[l].Units[Q.ring,Q.set].unit-prop derivative) (\ w -> Witness[w.1,w.2].unit) (regular derivative) ;
 } ;
 module Reduced
  (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
  (reduced : (a : Q.ring.R) -> Id Q.ring.R (Q.ring.mul a a) Q.ring.z -> Id Q.ring.R a Q.ring.z)
  (nondegenerate : (a : Q.ring.R) -> ((b : Q.ring.R) -> Id k.R (B.trace (Q.ring.mul a b)) k.z) -> Id Q.ring.R a Q.ring.z) {
  regular : PrincipalRegularity[l].Over[Q.ring].Regular =
   FiniteReducedRegular[l].Over[k,setk,dec,Q,M.degree,M.basis,reduced].theorem ;
  theorem : L.unit derivative = Regular[nondegenerate].theorem regular ;
  ordinary : L.unit slope = subst L.unit (sym slope-is) theorem ;
 } ;
} ;
