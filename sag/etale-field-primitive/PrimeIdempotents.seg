-- Algebra at a specified decidable prime. Complementary idempotents
-- select exactly one side. A regular witness a=a^2 b constructs the
-- idempotent a*b and its complementary annihilator 1-a*b.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) {
 module L = RL[A] ;
 record Prime {
  ideal : RegularIdeal[l].IdealPred[A] ;
  proposition (a : A.R) : Pr.isProp (ideal.In a) ;
  proper : Not (ideal.In A.o) ;
  prime (a b : A.R) : ideal.In (A.mul a b) -> Plus (ideal.In a) (ideal.In b) ;
  decide (a : A.R) : Plus (ideal.In a) (Not (ideal.In a)) ;
 } ;
 complement (e : A.R) : A.R = A.add A.o (A.neg e) ;
 complement-expand (e : A.R) : Id A.R (A.mul e (complement e)) (A.add e (A.neg (A.mul e e))) =
  trans (A.dist e A.o (A.neg e)) (cong2 A.R A.add _ _ _ _ (A.mulO e) (L.mul-neg e e)) ;
 complement-kills (e : A.R) (he : Id A.R (A.mul e e) e) : Id A.R (A.mul e (complement e)) A.z =
  trans (complement-expand e) (trans (ap (\ a -> A.add e (A.neg a)) he) (A.addN e)) ;
 complement-sum (e : A.R) : Id A.R (A.add e (complement e)) A.o =
  trans (L.add-swap e A.o (A.neg e)) (trans (ap (A.add A.o) (A.addN e)) (A.addZ A.o)) ;
 complement-idempotent (e : A.R) (he : Id A.R (A.mul e e) e) :
  Id A.R (A.mul (complement e) (complement e)) (complement e) =
  trans (L.dist-left A.o (A.neg e) (complement e))
   (trans (cong2 A.R A.add _ _ _ _ (L.one-left (complement e))
    (trans (L.neg-mul-left e (complement e)) (trans (ap A.neg (complement-kills e he)) L.neg-zero)))
    (A.addZ (complement e))) ;
 product-idempotent (e f : A.R) (he : Id A.R (A.mul e e) e) (hf : Id A.R (A.mul f f) f) :
  Id A.R (A.mul (A.mul e f) (A.mul e f)) (A.mul e f) =
  trans (L.mul-four e f e f) (cong2 A.R A.mul _ _ _ _ he hf) ;
 module At (q : Prime) {
  module I = RegularIdeal[l].IdealLaws[A,q.ideal] ;
  both-impossible (e : A.R) (h : q.ideal.In e) (hc : q.ideal.In (complement e)) : Empty =
   q.proper (subst q.ideal.In (complement-sum e) (q.ideal.in-add e (complement e) h hc)) ;
  outside-complement (e : A.R) (h : q.ideal.In e) : Not (q.ideal.In (complement e)) = both-impossible e h ;
  prime-case (e : A.R) (out : Not (q.ideal.In e)) :
   Plus (q.ideal.In e) (q.ideal.In (complement e)) -> q.ideal.In (complement e) = split {
   inl h -> efq (out h) ; inr h -> h } ;
  complement-in (e : A.R) (he : Id A.R (A.mul e e) e) (out : Not (q.ideal.In e)) : q.ideal.In (complement e) =
   prime-case e out (q.prime e (complement e)
    (subst q.ideal.In (sym (complement-kills e he)) q.ideal.in-zero)) ;
  record Selected (e : A.R) {
   value : A.R ;
   idempotent : Id A.R (A.mul value value) value ;
   outside : Not (q.ideal.In value) ;
   side : Plus (Id A.R value e) (Id A.R value (complement e)) ;
  } ;
  choose-case (e : A.R) (he : Id A.R (A.mul e e) e) :
   Plus (q.ideal.In e) (Not (q.ideal.In e)) -> Selected[e] = split {
   inl h -> new Selected[e,complement e,complement-idempotent e he,outside-complement e h,inr (refl (complement e))] ;
   inr h -> new Selected[e,e,he,h,inl (refl e)] } ;
  choose (e : A.R) (he : Id A.R (A.mul e e) e) : Selected[e] = choose-case e he (q.decide e) ;
 } ;
 module Regular (a b : A.R) (eq : Id A.R a (A.mul (A.mul a a) b)) {
  e : A.R = A.mul a b ;
  absorb : Id A.R (A.mul a e) a = trans (A.mulA a a b) (sym eq) ;
  idempotent : Id A.R (A.mul e e) e =
   trans (trans (sym (A.mulA a b e)) (trans (L.mul-swap a b e) (ap (A.mul b) absorb))) (A.mulC b a) ;
  annihilator : A.R = complement e ;
  annihilator-idempotent : Id A.R (A.mul annihilator annihilator) annihilator = complement-idempotent e idempotent ;
  kills : Id A.R (A.mul annihilator a) A.z =
   trans (A.mulC annihilator a)
    (trans (A.dist a A.o (A.neg e))
     (trans (cong2 A.R A.add _ _ _ _ (A.mulO a) (trans (L.mul-neg a e) (ap A.neg absorb))) (A.addN a))) ;
  one-minus : Id A.R (complement annihilator) e =
   trans (ap (A.add A.o) (L.neg-add A.o (A.neg e)))
    (trans (ap (\ x -> A.add A.o (A.add (A.neg A.o) x)) (L.neg-neg e))
     (trans (A.addA A.o (A.neg A.o) e) (trans (ap (\ x -> A.add x e) (A.addN A.o)) (L.zl e)))) ;
 } ;
} ;
