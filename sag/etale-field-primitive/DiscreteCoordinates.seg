-- A finite basis over a discrete nonzero field supplies decidable
-- equality in the algebra by comparing finitely many coordinates.
-- This is the equality decision used for enumerated coefficient
-- subalgebras; finite generation alone is not silently used as a basis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field) {
 module L = RL[k] ;
 unit-nonzero (a : k.R) (u : L.unit a) (h : Id k.R a k.z) : Empty =
  field.nonzero (trans (sym u.2) (trans (ap (\ x -> k.mul x u.1) h) (L.zero-mul u.1))) ;
 zero-case (a : k.R) : Plus (Id k.R a k.z) (L.unit a) -> Plus (Id k.R a k.z) (Not (Id k.R a k.z)) = split {
  inl h -> inl h ; inr h -> inr (unit-nonzero a h) } ;
 zero-dec (a : k.R) : Plus (Id k.R a k.z) (Not (Id k.R a k.z)) = zero-case a (field.decide a) ;
 equal-case (a b : k.R) : Plus (Id k.R (k.add a (k.neg b)) k.z) (Not (Id k.R (k.add a (k.neg b)) k.z)) ->
  Plus (Id k.R a b) (Not (Id k.R a b)) = split {
  inl h -> inl (FormallyEtale[l].Units[k,setk].sub-zero a b h) ;
  inr h -> inr (\ p -> h (trans (ap (\ x -> k.add x (k.neg b)) p) (k.addN b))) } ;
 equal (a b : k.R) : Plus (Id k.R a b) (Not (Id k.R a b)) = equal-case a b (zero-dec (k.add a (k.neg b))) ;
 Pointwise (n : Nat) (a b : Fin n -> k.R) : U l = (i : Fin n) -> Id k.R (a i) (b i) ;
 combine (n : Nat) (a b : Fin (suc n) -> k.R) (last : Id k.R (a (inr tt)) (b (inr tt))) :
  Plus (Pointwise n (\ i -> a (inl i)) (\ i -> b (inl i))) (Not (Pointwise n (\ i -> a (inl i)) (\ i -> b (inl i)))) ->
  Plus (Pointwise (suc n) a b) (Not (Pointwise (suc n) a b)) = split {
  inl h -> inl (AffineFinite[l].section n (\ i -> Id k.R (a i) (b i)) h last) ;
  inr h -> inr (\ p -> h (\ i -> p (inl i))) } ;
 step (n : Nat) (a b : Fin (suc n) -> k.R)
  (old : Plus (Pointwise n (\ i -> a (inl i)) (\ i -> b (inl i))) (Not (Pointwise n (\ i -> a (inl i)) (\ i -> b (inl i))))) :
  Plus (Id k.R (a (inr tt)) (b (inr tt))) (Not (Id k.R (a (inr tt)) (b (inr tt)))) ->
  Plus (Pointwise (suc n) a b) (Not (Pointwise (suc n) a b)) = split {
  inl h -> combine n a b h old ; inr h -> inr (\ p -> h (p (inr tt))) } ;
 compare : (n : Nat) (a b : Fin n -> k.R) -> Plus (Pointwise n a b) (Not (Pointwise n a b)) = split {
  zero -> \ a b -> inl (\ i -> efq i) ;
  suc n | ih -> \ a b -> step n a b (ih (\ i -> a (inl i)) (\ i -> b (inl i))) (equal (a (inr tt)) (b (inr tt))) } ;
 module At (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) {
  module B = TraceBasis[l].Over[k,setk,S].At[n,basis] ;
  choose (a b : S.ring.R) : Plus (Pointwise n (basis.coordinate a) (basis.coordinate b))
   (Not (Pointwise n (basis.coordinate a) (basis.coordinate b))) ->
   Plus (Id S.ring.R a b) (Not (Id S.ring.R a b)) = split {
   inl h -> inl (B.coordinates-determine a b h) ;
   inr h -> inr (\ p -> h (\ i -> ap (\ x -> basis.coordinate x i) p)) } ;
  decide (a b : S.ring.R) : Plus (Id S.ring.R a b) (Not (Id S.ring.R a b)) =
   choose a b (compare n (basis.coordinate a) (basis.coordinate b)) ;
  zero (a : S.ring.R) : Plus (Id S.ring.R a S.ring.z) (Not (Id S.ring.R a S.ring.z)) = decide a S.ring.z ;
 } ;
} ;
