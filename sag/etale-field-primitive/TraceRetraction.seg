-- Trace and its nondegeneracy pass to an algebra retract whose inclusion
-- is multiplication-linear over the projection. Idempotent factors have
-- precisely this property. Rectangular trace cyclicity compares the two
-- multiplication traces, so no basis of the complementary factor or
-- discriminant product formula is needed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S T : Algebras[l].Over[k,setk].Algebra) (n m : Nat)
 (source : TraceBasis[l].Over[k,setk,S].Basis[n])
 (target : TraceBasis[l].Over[k,setk,T].Basis[m])
 (projection : Algebras[l].Over[k,setk].Hom S T)
 (inclusion : TraceLinear[l].Over[k,setk].Linear[T,S])
 (retract : (a : T.ring.R) -> Id T.ring.R (projection.1.1 (inclusion.map a)) a)
 (multiplication : (a : T.ring.R) (b : S.ring.R) ->
  Id S.ring.R (inclusion.map (T.ring.mul a (projection.1.1 b))) (S.ring.mul (inclusion.map a) b)) {
 module TL = TraceLinear[l].Over[k,setk] ;
 module SB = TraceBasis[l].Over[k,setk,S].At[n,source] ;
 module TB = TraceBasis[l].Over[k,setk,T].At[m,target] ;
 projection-linear : TL.Linear[S,T] = new TL.Linear[S,T,projection.1.1,projection.1.2.2.1,
  \ r a -> trans (projection.1.2.2.2 (S.iota.1 r) a) (ap (\ c -> T.ring.mul c (projection.1.1 a)) (projection.2 r))] ;
 module At (a : T.ring.R) {
  multiplied : TL.Linear[T,S] = TL.compose T T S inclusion (TL.multiply T a) ;
  module Cyclic = TL.Cyclic[S,T,n,m,source,target,projection-linear,multiplied] ;
  source-trace : Id k.R (TL.trace S n source (TL.compose S T S multiplied projection-linear)) (SB.trace (inclusion.map a)) =
   trans (TL.trace-equal S n source (TL.compose S T S multiplied projection-linear) (TL.multiply S (inclusion.map a)) (multiplication a))
    (TL.multiply-trace S n source (inclusion.map a)) ;
  target-trace : Id k.R (TL.trace T m target (TL.compose T S T projection-linear multiplied)) (TB.trace a) =
   trans (TL.trace-equal T m target (TL.compose T S T projection-linear multiplied) (TL.multiply T a)
    (\ b -> retract (T.ring.mul a b))) (TL.multiply-trace T m target a) ;
  theorem : Id k.R (SB.trace (inclusion.map a)) (TB.trace a) = trans (sym source-trace) (trans Cyclic.theorem target-trace) ;
 } ;
 trace (a : T.ring.R) : Id k.R (SB.trace (inclusion.map a)) (TB.trace a) = At[a].theorem ;
 module Nondegenerate
  (source-nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) -> Id k.R (SB.trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
  (a : T.ring.R) (h : (b : T.ring.R) -> Id k.R (TB.trace (T.ring.mul a b)) k.z) {
  pair-zero (b : S.ring.R) : Id k.R (SB.trace (S.ring.mul (inclusion.map a) b)) k.z =
   trans (ap SB.trace (sym (multiplication a b)))
    (trans (trace (T.ring.mul a (projection.1.1 b))) (h (projection.1.1 b))) ;
  killed : Id S.ring.R (inclusion.map a) S.ring.z = source-nondegenerate (inclusion.map a) pair-zero ;
  theorem : Id T.ring.R a T.ring.z = trans (sym (retract a))
   (trans (ap projection.1.1 killed) (RingHom[l].zero S.ring T.ring projection.1)) ;
 } ;
 nondegenerate
  (source-nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) -> Id k.R (SB.trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
  (a : T.ring.R) (h : (b : T.ring.R) -> Id k.R (TB.trace (T.ring.mul a b)) k.z) : Id T.ring.R a T.ring.z =
  Nondegenerate[source-nondegenerate,a,h].theorem ;
} ;
module Idempotent (k : CRing) (setk : Pr.isSet k.R)
 (S : Algebras[l].Over[k,setk].Algebra) (e : S.ring.R) (he : Id S.ring.R (S.ring.mul e e) e) {
 module C = Algebras[l].Over[k,setk] ; module TL = TraceLinear[l].Over[k,setk] ;
 module F = IdempotentFactor[l].Over[S.ring,S.set,e,he] ; module L = RL[S.ring] ;
 iota : RingHom[l].Hom k F.ring = RingHom[l].compose k S.ring F.ring F.projection S.iota ;
 algebra : C.Algebra = C.mkAlgebra F.ring F.set iota ;
 projection : C.Hom S algebra = (F.projection,\ r -> refl (F.project (S.iota.1 r))) ;
 inclusion-scale (r : k.R) (a : F.Carrier) :
  Id S.ring.R (F.mul (iota.1 r) a).1 (S.ring.mul (S.iota.1 r) a.1) =
  trans (sym (S.ring.mulA e (S.iota.1 r) a.1))
   (trans (L.mul-swap e (S.iota.1 r) a.1) (ap (S.ring.mul (S.iota.1 r)) a.2)) ;
 inclusion : TL.Linear[algebra,S] = new TL.Linear[algebra,S,\ a -> a.1,
  \ a b -> refl (S.ring.add a.1 b.1),inclusion-scale] ;
 retract (a : F.Carrier) : Id F.Carrier (F.project a.1) a = F.project-fixed a ;
 multiplication (a : F.Carrier) (b : S.ring.R) :
  Id S.ring.R (F.mul a (F.project b)).1 (S.ring.mul a.1 b) =
  trans (L.mul-swap a.1 e b)
   (trans (S.ring.mulA e a.1 b) (ap (\ c -> S.ring.mul c b) a.2)) ;
 module Bases (n m : Nat) (source : TraceBasis[l].Over[k,setk,S].Basis[n])
  (target : TraceBasis[l].Over[k,setk,algebra].Basis[m]) {
  module Theorem = Over[k,setk,S,algebra,n,m,source,target,projection,inclusion,retract,multiplication] ;
 } ;
} ;
