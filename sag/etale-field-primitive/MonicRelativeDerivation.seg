-- A derivative annihilator at a monic root y in T gives an actual
-- derivation k[X]/(f) -> T, taking X to that annihilator. The map into
-- T[epsilon] is constructed from the monic quotient universal property;
-- its first component is the prescribed root map by uniqueness.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (lower : List k.R)
 (T : Algebras[l].Over[k,setk].Algebra) (y : T.ring.R)
 (root : Id T.ring.R (MonicBasisUniversal[l].Values[k,T.ring,T.iota,y].value lower) T.ring.z) {
 module C = Algebras[l].Over[k,setk] ; module M = MonicBasisUniversal[l].Over[k,setk].At[lower] ;
 Q : C.Algebra = M.Q ; module L = RL[T.ring] ; module To = M.To[T,y,root] ;
 hom : C.Hom Q T = To.hom ;
 module V = MonicDualValues[l].Over[k,T.ring,T.set,T.iota,y] ; module D = V.D ;
 dual-algebra : C.Algebra = C.mkAlgebra D.ring D.set V.dual ;
 projection : C.Hom dual-algebra T =
  ((\ a -> a.1,refl T.ring.o,\ a b -> refl (T.ring.add a.1 b.1),
   \ a b -> trans (ap (T.ring.add (T.ring.mul a.1 b.1)) (L.zero-mul (T.ring.mul a.2 b.2)))
    (T.ring.addZ (T.ring.mul a.1 b.1))),\ r -> refl (T.iota.1 r)) ;
 module RD = RelativeDerivations[l].Over[k,setk,Q,T,hom] ;
 derivative : T.ring.R = V.slope lower ;
 module Ordinary = MonicReduce[l].Horner[k,D.ring,V.dual,(y,T.ring.o)] ;
 slope : T.ring.R = (Ordinary.horner (SelectedFactorStatement[l].Over[k,setk].monic lower)).2 ;
 slope-is : Id T.ring.R slope derivative = ap (\ z -> z.2)
  (MonicValueNaturality[l].Over[k,setk].Horner[dual-algebra,(y,T.ring.o)].equation lower) ;
 module At (a : T.ring.R) (killed : Id T.ring.R (T.ring.mul derivative a) T.ring.z) {
  dual-root : Id D.Pair (V.At[a].Value.value lower) D.zeroQ =
   trans (V.equation a lower) (D.eq _ _ root killed) ;
  module Lift = M.To[dual-algebra,(y,a),dual-root] ;
  first-map : C.Hom Q T = C.compose Q dual-algebra T projection Lift.hom ;
  first (b : Q.ring.R) : Id T.ring.R (Lift.hom.1.1 b).1 (hom.1.1 b) =
   M.unique T first-map hom (trans (ap (\ z -> z.1) Lift.beta) (sym To.beta)) b ;
  value (b : Q.ring.R) : T.ring.R = (Lift.hom.1.1 b).2 ;
  add (b c : Q.ring.R) : Id T.ring.R (value (Q.ring.add b c)) (T.ring.add (value b) (value c)) =
   ap (\ z -> z.2) (Lift.hom.1.2.2.1 b c) ;
  scale (r : k.R) (b : Q.ring.R) : Id T.ring.R (value (Q.ring.mul (Q.iota.1 r) b)) (T.ring.mul (T.iota.1 r) (value b)) =
   trans (ap (\ z -> z.2) (Lift.hom.1.2.2.2 (Q.iota.1 r) b))
    (trans (ap (\ z -> (D.timesQ z (Lift.hom.1.1 b)).2) (Lift.hom.2 r))
     (trans (ap (T.ring.add (T.ring.mul (T.iota.1 r) (value b))) (L.zero-mul (Lift.hom.1.1 b).1))
      (T.ring.addZ (T.ring.mul (T.iota.1 r) (value b))))) ;
  linear : TraceLinear[l].Over[k,setk].Linear[Q,T] =
   new TraceLinear[l].Over[k,setk].Linear[Q,T,value,add,scale] ;
  product (b c : Q.ring.R) : Id T.ring.R (value (Q.ring.mul b c))
   (T.ring.add (T.ring.mul (value b) (hom.1.1 c)) (T.ring.mul (hom.1.1 b) (value c))) =
   trans (ap (\ z -> z.2) (Lift.hom.1.2.2.2 b c))
    (trans (cong2 T.ring.R T.ring.add _ _ _ _
     (ap (\ z -> T.ring.mul z (value c)) (first b)) (ap (T.ring.mul (value b)) (first c)))
     (T.ring.addC (T.ring.mul (hom.1.1 b) (value c)) (T.ring.mul (value b) (hom.1.1 c)))) ;
  derivation : RD.Derivation = new RD.Derivation[linear,product] ;
  generator : Id T.ring.R (value M.x) a = ap (\ z -> z.2) Lift.beta ;
 } ;
} ;
