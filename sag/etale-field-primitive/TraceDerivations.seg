-- Nondegenerate multiplication trace kills self-valued derivations.
-- If D is a k-derivation, then bD is again a derivation and
-- [bD,m_a]=m_(b*D(a)). Trace cyclicity therefore gives Tr(b*D(a))=0
-- for every b. Nondegeneracy gives D(a)=0. This needs neither a field
-- nor a discriminant identity; an invertible Gram determinant suffices.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra)
 (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) {
 module TL = TraceLinear[l].Over[k,setk] ; module B = TraceBasis[l].Over[k,setk,S].At[n,basis] ;
 module L = RL[S.ring] ; module KL = RL[k] ; module KS = FiniteIdeal[l].Sums[k] ;
 module ND = PerfectTraceNondegenerate[l].Over[k,setk,S,n,basis] ;
 record Derivation {
  linear : TL.Linear[S,S] ;
  product (a b : S.ring.R) : Id S.ring.R (linear.map (S.ring.mul a b))
   (S.ring.add (S.ring.mul (linear.map a) b) (S.ring.mul a (linear.map b))) ;
 } ;
 module Given (d : Derivation) {
  module Pair (a b : S.ring.R) {
   weighted : TL.Linear[S,S] = TL.compose S S S (TL.multiply S b) d.linear ;
   left : TL.Linear[S,S] = TL.compose S S S weighted (TL.multiply S a) ;
   right : TL.Linear[S,S] = TL.compose S S S (TL.multiply S a) weighted ;
   module Cyclic = TL.Cyclic[S,S,n,n,basis,basis,TL.multiply S a,weighted] ;
   equation (x : S.ring.R) : Id S.ring.R (left.map x)
    (S.ring.add (S.ring.mul (S.ring.mul b (d.linear.map a)) x) (right.map x)) =
    trans (ap (S.ring.mul b) (d.product a x))
     (trans (S.ring.dist b (S.ring.mul (d.linear.map a) x) (S.ring.mul a (d.linear.map x)))
      (cong2 S.ring.R S.ring.add _ _ _ _ (S.ring.mulA b (d.linear.map a) x) (L.mul-swap b a (d.linear.map x)))) ;
   trace-equation : Id k.R (TL.trace S n basis left)
    (k.add (B.trace (S.ring.mul b (d.linear.map a))) (TL.trace S n basis right)) =
    trans (KS.sum-cong n (\ i -> basis.coordinate (left.map (basis.vector i)) i)
     (\ i -> k.add (basis.coordinate (S.ring.mul (S.ring.mul b (d.linear.map a)) (basis.vector i)) i)
      (basis.coordinate (right.map (basis.vector i)) i))
     (\ i -> trans (ap (\ x -> basis.coordinate x i) (equation (basis.vector i)))
      (basis.add (S.ring.mul (S.ring.mul b (d.linear.map a)) (basis.vector i)) (right.map (basis.vector i)) i)))
     (KS.sum-add n (\ i -> basis.coordinate (S.ring.mul (S.ring.mul b (d.linear.map a)) (basis.vector i)) i)
      (\ i -> basis.coordinate (right.map (basis.vector i)) i)) ;
   zero : Id k.R (B.trace (S.ring.mul b (d.linear.map a))) k.z =
    KL.add-cancel (TL.trace S n basis right) (B.trace (S.ring.mul b (d.linear.map a)))
     (trans (k.addC (TL.trace S n basis right) (B.trace (S.ring.mul b (d.linear.map a))))
      (trans (sym trace-equation) Cyclic.theorem)) ;
  } ;
  pair-zero (a b : S.ring.R) : Id k.R (B.trace (S.ring.mul (d.linear.map a) b)) k.z =
   trans (ap B.trace (S.ring.mulC (d.linear.map a) b)) Pair[a,b].zero ;
  from-nondegenerate
   (nondegenerate : (a : S.ring.R) -> ((b : S.ring.R) -> Id k.R (B.trace (S.ring.mul a b)) k.z) -> Id S.ring.R a S.ring.z)
   (a : S.ring.R) : Id S.ring.R (d.linear.map a) S.ring.z = nondegenerate (d.linear.map a) (pair-zero a) ;
  theorem (perfect : ND.Perfect) (a : S.ring.R) : Id S.ring.R (d.linear.map a) S.ring.z =
   from-nondegenerate (ND.nondegenerate perfect) a ;
 } ;
} ;
