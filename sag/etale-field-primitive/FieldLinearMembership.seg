-- Decide membership in an explicitly finitely generated vector subspace.
-- The constructed Gaussian quotient projection vanishes exactly on the
-- given span. Vanishing gives actual coefficients from the normal-form
-- difference witness; a nonzero projected coordinate disproves membership.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field) {
 module V = GaussianVectors[l].Over[k] ; module G = GaussianQuotient[l].Over[k,field.decide] ;
 module D = DiscreteCoordinates[l].Over[k,setk,field] ; module Sum = FiniteIdeal[l].Sums[k] ; module L = RL[k] ;
 module At (n m : Nat) (v : Fin m -> V.Vec n) {
  module Span = V.Span[n,m,v] ;
  q : G.NormalForm[n,m,v] = G.normal-form n m v ;
  killed (x : V.Vec n) (w : Span.Witness x) (i : Fin q.rank) : Id k.R (q.project.map x i) k.z =
   trans (ap (\ c -> q.project.map c i) (sym (V.ext n (V.comb n m v w.1) x w.2)))
    (trans (V.On[n,q.rank,q.project].combination m v w.1 i)
     (trans (Sum.sum-cong m (\ j -> k.mul (q.project.map (v j) i) (w.1 j)) (\ j -> k.z)
      (\ j -> trans (ap (\ a -> k.mul a (w.1 j)) (q.kills j i)) (L.zero-mul (w.1 j)))) (Sum.sum-zero m))) ;
  from-zero (x : V.Vec n) (h : (i : Fin q.rank) -> Id k.R (q.project.map x i) k.z) : Span.Witness x =
   Span.equal (V.subV n x (q.section.map (q.project.map x))) x
    (\ i -> trans (ap (\ a -> k.add (x i) (k.neg a))
     (trans (ap (\ c -> q.section.map c i) (V.ext q.rank (q.project.map x) (V.zeroV q.rank) h)) (q.section.zero i)))
     (trans (ap (k.add (x i)) L.neg-zero) (k.addZ (x i)))) (q.difference x) ;
  choose (x : V.Vec n) : Plus (D.Pointwise q.rank (q.project.map x) (V.zeroV q.rank))
   (Not (D.Pointwise q.rank (q.project.map x) (V.zeroV q.rank))) -> Plus (Span.Witness x) (Not (Span.Witness x)) = split {
   inl h -> inl (from-zero x h) ; inr h -> inr (\ w -> h (killed x w)) } ;
  decide (x : V.Vec n) : Plus (Span.Witness x) (Not (Span.Witness x)) =
   choose x (D.compare q.rank (q.project.map x) (V.zeroV q.rank)) ;
 } ;
} ;
