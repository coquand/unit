-- Euclidean division over a field only needs an explicit unit leading
-- coefficient. Normalize the divisor by that inverse, reuse arbitrary
-- monic division, and move the inverse into the quotient. The remainder
-- is an actual bounded coefficient list; the quotient is a polynomial
-- ring element. No choice or degree oracle is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module Raw = Poly[l].PolyR[k] ; module M = Mul[l].MulR[k] ;
 module Bound = PolynomialBounds[l].Over[k] ; module B = PolynomialRing[l].Extension[k,setk] ;
 module L = RL[k] ; module LB = RL[B.ring] ;
 scaled (a : k.R) (p : Raw.P) : Id B.Carrier (B.include (M.scal a p)) (B.mulQ (B.constant a) (B.include p)) =
  trans (sym (B.Q.relates _ _ (RawMultiplication[l].Laws[k].mul-single-left a p)))
   (sym (B.Multiply.beta (cons a nil) p)) ;
 module At (n : Nat) (q : Raw.P) (bounded : Bound.Bound (suc n) q)
  (leading : L.unit (Raw.coef q n)) {
  monic : Raw.P = M.scal leading.1 q ;
  monic-leading : Id k.R (Raw.coef monic n) k.o =
   trans (M.coef-scal leading.1 q n) (trans (k.mulC leading.1 (Raw.coef q n)) leading.2) ;
  monic-bound : Bound.Bound (suc n) monic = Bound.scale-bound (suc n) leading.1 q bounded ;
  module D = MonicDivision[l].Over[k,setk].General[monic,n,monic-leading,monic-bound] ;
  module Divide (p : Raw.P) {
   calculation : D.Result p = D.divide p ;
   quotient : B.Carrier = B.mulQ (B.constant leading.1) (B.include calculation.1) ;
   remainder : Raw.P = calculation.2.1 ;
   remainder-bound : Bound.Bound n remainder = calculation.2.2.1 ;
   multiply : Id B.Carrier (B.mulQ (B.include monic) (B.include calculation.1)) (B.mulQ (B.include q) quotient) =
    trans (ap (\ x -> B.mulQ x (B.include calculation.1)) (scaled leading.1 q))
     (trans (sym (B.ring.mulA (B.constant leading.1) (B.include q) (B.include calculation.1)))
      (LB.mul-swap (B.constant leading.1) (B.include q) (B.include calculation.1))) ;
   equation : Id B.Carrier (B.include p) (B.addQ (B.mulQ (B.include q) quotient) (B.include remainder)) =
    trans calculation.2.2.2 (ap (\ x -> B.addQ x (B.include remainder)) multiply) ;
  } ;
 } ;
} ;
