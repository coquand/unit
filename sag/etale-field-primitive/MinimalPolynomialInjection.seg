-- The concrete quotient by the minimal polynomial embeds in S by T|->x.
-- Every quotient element has its canonical bounded polynomial remainder.
-- If its image vanishes, minimality makes that remainder zero. Thus the
-- quotient itself is a finite-basis model of k[x]; no separate image
-- subalgebra or basis transport is needed for the relative module step.
-- If x generates all of S, mere polynomial representatives give an
-- actual inverse, since injectivity makes each representative fibre a
-- proposition. The inverse is constructed as an algebra homomorphism.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (S : Algebras[l].Over[k,setk].Algebra) (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) (x : S.ring.R) {
 module Min = MinimalPolynomial[l].Over[k,setk,field,S,n,basis,x] ;
 module C = Algebras[l].Over[k,setk] ; module H = RingHom[l] ;
 module Pol = Min.B ; module Red = MonicReduction[l].Over[k,setk] ;
 module Reps = FlatPolynomialData[l].Coefficients[k,setk] ;
 module At (f : Min.Minimal) {
  module M = MonicBasisUniversal[l].Over[k,setk].At[f.lower] ;
  Q : C.Algebra = M.Q ; module QL = RL[Q.ring] ; module SL = RL[S.ring] ;
  root : Id S.ring.R (MonicBasisUniversal[l].Values[k,S.ring,S.iota,x].value f.lower) S.ring.z =
   trans (sym (MonicBasisUniversal[l].Over[k,setk].In[S,x].polynomial-value f.lower)) f.root ;
  module To = M.To[S,x,root] ;
  hom : C.Hom Q S = To.hom ;
  beta : Id S.ring.R (hom.1.1 M.x) x = To.beta ;
  composite : H.Hom Pol.ring S.ring = H.compose Pol.ring Q.ring S.ring hom.1 M.B.quotient-map.1 ;
  composite-constant (a : k.R) : Id S.ring.R (composite.1 (Pol.constant a)) (S.iota.1 a) =
   trans (ap hom.1.1 (M.B.quotient-map.2 a)) (hom.2 a) ;
  composite-variable : Id S.ring.R (composite.1 Pol.variable) x =
   trans (ap hom.1.1 (M.B.value-equation (var (inr tt)))) beta ;
  composite-eq : Id (H.Hom Pol.ring S.ring) composite Min.P.UP.extend =
   Min.P.UP.unique composite composite-constant composite-variable ;
  polynomial (p : Pol.Carrier) : Id S.ring.R (hom.1.1 (M.B.quotient-map.1.1 p)) (Min.P.UP.extend.1 p) =
   ap (\ h -> h.1 p) composite-eq ;
  module Small (p : Pol.Carrier) (bounded : Red.Bounded f.degree p)
   (root0 : Id S.ring.R (Min.P.UP.extend.1 p) S.ring.z) {
   from (w : Reps.Representation p) : Id Pol.Carrier p Pol.zeroQ =
    trans (sym w.2) (Pol.Q.relates w.1 nil
     (f.no-smaller w.1
      (\ i -> trans (sym (Red.coef-include w.1 (plus f.degree i)))
       (trans (ap (\ z -> Red.coef z (plus f.degree i)) w.2) (bounded i)))
      (trans (ap Min.P.UP.extend.1 w.2) root0))) ;
   theorem : Id Pol.Carrier p Pol.zeroQ =
    TC.rec (Reps.Representation p) @l (Id Pol.Carrier p Pol.zeroQ) (Pol.set _ _) from (Reps.representation p) ;
  } ;
  normal-bound (a : Q.ring.R) : Red.Bounded f.degree (M.B.normal-form a) =
   \ i -> trans (ap (Red.coef (M.B.normal-form a)) (ap (\ d -> plus d i) (sym f.length))) (M.B.normal-form-bounded a i) ;
  normal-value (a : Q.ring.R) : Id S.ring.R (Min.P.UP.extend.1 (M.B.normal-form a)) (hom.1.1 a) =
   trans (sym (polynomial (M.B.normal-form a))) (ap hom.1.1 (M.B.quotient-normal a)) ;
  kernel (a : Q.ring.R) (ha : Id S.ring.R (hom.1.1 a) S.ring.z) : Id Q.ring.R a Q.ring.z =
   trans (sym (M.B.quotient-normal a))
    (trans (ap M.B.quotient-map.1.1 (Small[M.B.normal-form a,normal-bound a,trans (normal-value a) ha].theorem))
     (H.zero Pol.ring Q.ring M.B.quotient-map.1)) ;
  injective (a b : Q.ring.R) (eq : Id S.ring.R (hom.1.1 a) (hom.1.1 b)) : Id Q.ring.R a b =
   FormallyEtale[l].Units[Q.ring,Q.set].sub-zero a b
    (kernel (Q.ring.add a (Q.ring.neg b))
     (trans (hom.1.2.2.1 a (Q.ring.neg b))
      (trans (cong2 S.ring.R S.ring.add _ _ _ _ eq (H.negation Q.ring S.ring hom.1 b)) (S.ring.addN (hom.1.1 b))))) ;
  module Reduced
   (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z) {
   theorem (a : Q.ring.R) (ha : Id Q.ring.R (Q.ring.mul a a) Q.ring.z) : Id Q.ring.R a Q.ring.z =
    kernel a (reduced (hom.1.1 a)
     (trans (sym (hom.1.2.2.2 a a)) (trans (ap hom.1.1 ha) (H.zero Q.ring S.ring hom.1)))) ;
   regular : PrincipalRegularity[l].Over[Q.ring].Regular =
    FiniteReducedRegular[l].Over[k,setk,field.decide,Q,M.degree,M.basis,theorem].theorem ;
  } ;
  module Prime (q : PrimeIdempotents[l].Over[S.ring].Prime) {
   member (a : Q.ring.R) : U l = q.ideal.In (hom.1.1 a) ;
   ideal : RegularIdeal[l].IdealPred[Q.ring] = RegularIdeal[l].mkIdealPred Q.ring member
    (subst q.ideal.In (sym (H.zero Q.ring S.ring hom.1)) q.ideal.in-zero)
    (\ a b ha hb -> subst q.ideal.In (sym (hom.1.2.2.1 a b)) (q.ideal.in-add (hom.1.1 a) (hom.1.1 b) ha hb))
    (\ a b hb -> subst q.ideal.In (sym (hom.1.2.2.2 a b)) (q.ideal.in-mul (hom.1.1 a) (hom.1.1 b) hb)) ;
   proper : Not (member Q.ring.o) = \ hx -> q.proper (subst q.ideal.In hom.1.2.1 hx) ;
   prime (a b : Q.ring.R) (hx : member (Q.ring.mul a b)) : Plus (member a) (member b) =
    q.prime (hom.1.1 a) (hom.1.1 b) (subst q.ideal.In (hom.1.2.2.2 a b) hx) ;
   theorem : PrimeIdempotents[l].Over[Q.ring].Prime = new PrimeIdempotents[l].Over[Q.ring].Prime[
    ideal,\ a -> q.proposition (hom.1.1 a),proper,prime,\ a -> q.decide (hom.1.1 a)] ;
  } ;
  module Monogenic
   (generated : (a : S.ring.R) -> Tr.Trunc[(p : Pol.Carrier) * Id S.ring.R (Min.P.UP.extend.1 p) a].carrier) {
   Fibre (a : S.ring.R) : U l = (b : Q.ring.R) * Id S.ring.R (hom.1.1 b) a ;
   fibre-prop (a : S.ring.R) : Pr.isProp (Fibre a) = \ b c ->
    Pr.Sigma-eq Q.ring.R (\ b -> Id S.ring.R (hom.1.1 b) a) b.1 c.1 b.2 c.2
     (injective b.1 c.1 (trans b.2 (sym c.2))) (S.set _ _) ;
   preimage (a : S.ring.R) : Fibre a =
    TC.rec ((p : Pol.Carrier) * Id S.ring.R (Min.P.UP.extend.1 p) a) @l (Fibre a) (fibre-prop a)
     (\ p -> (M.B.quotient-map.1.1 p.1,trans (polynomial p.1) p.2)) (generated a) ;
   inverse (a : S.ring.R) : Q.ring.R = (preimage a).1 ;
   forward-backward (a : S.ring.R) : Id S.ring.R (hom.1.1 (inverse a)) a = (preimage a).2 ;
   backward-forward (a : Q.ring.R) : Id Q.ring.R (inverse (hom.1.1 a)) a = injective _ _ (forward-backward (hom.1.1 a)) ;
   one : Id Q.ring.R (inverse S.ring.o) Q.ring.o = injective _ _ (trans (forward-backward S.ring.o) (sym hom.1.2.1)) ;
   add (a b : S.ring.R) : Id Q.ring.R (inverse (S.ring.add a b)) (Q.ring.add (inverse a) (inverse b)) =
    injective _ _ (trans (forward-backward (S.ring.add a b))
     (sym (trans (hom.1.2.2.1 (inverse a) (inverse b)) (cong2 S.ring.R S.ring.add _ _ _ _ (forward-backward a) (forward-backward b))))) ;
   mul (a b : S.ring.R) : Id Q.ring.R (inverse (S.ring.mul a b)) (Q.ring.mul (inverse a) (inverse b)) =
    injective _ _ (trans (forward-backward (S.ring.mul a b))
     (sym (trans (hom.1.2.2.2 (inverse a) (inverse b)) (cong2 S.ring.R S.ring.mul _ _ _ _ (forward-backward a) (forward-backward b))))) ;
   constants (a : k.R) : Id Q.ring.R (inverse (S.iota.1 a)) (Q.iota.1 a) =
    injective _ _ (trans (forward-backward (S.iota.1 a)) (sym (hom.2 a))) ;
   backward : C.Hom S Q = ((inverse,one,add,mul),constants) ;
   equivalence : Pr.Equiv Q.ring.R S.ring.R =
    (hom.1.1,Pr.qinv Q.ring.R S.ring.R hom.1.1 inverse forward-backward backward-forward) ;
  } ;
 } ;
} ;
