-- An invertible trace Gram determinant makes the trace pairing
-- nondegenerate. Expand an element in the given basis. Its pairings with
-- basis vectors are the Gram matrix applied to its coordinates. The
-- determinant trick kills those coordinates; multiplying by the explicit
-- inverse determinant makes every coordinate zero.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra)
 (n : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[n]) {
 module C = Algebras[l].Over[k,setk] ;
 module B = TraceBasis[l].Over[k,setk,S].At[n,basis] ;
 module TL = TraceLinear[l].Over[k,setk] ;
 module SS = FiniteIdeal[l].Sums[S.ring] ; module KS = FiniteIdeal[l].Sums[k] ;
 module SL = RL[S.ring] ; module KL = RL[k] ;
 module D = Determinant[l].Over[k,setk] ; module Trick = DeterminantTrick[l].Over[k,setk] ;
 gram (j i : Fin n) : k.R = B.trace (S.ring.mul (basis.vector j) (basis.vector i)) ;
 trace-linear : TL.Linear[S,C.base] = new TL.Linear[S,C.base,B.trace,B.trace-add,B.trace-scale] ;
 module MapTrace = TL.Map[S,C.base,trace-linear] ;
 product-expansion (a : S.ring.R) (j : Fin n) : Id S.ring.R (S.ring.mul a (basis.vector j))
  (SS.sum n (\ i -> S.ring.mul (S.iota.1 (basis.coordinate a i)) (S.ring.mul (basis.vector i) (basis.vector j)))) =
  trans (S.ring.mulC a (basis.vector j))
   (trans (ap (S.ring.mul (basis.vector j)) (sym (basis.reconstruction a)))
    (trans (sym (SS.sum-scale (basis.vector j) n (\ i -> S.ring.mul (S.iota.1 (basis.coordinate a i)) (basis.vector i))))
     (SS.sum-cong n _ _ (\ i ->
      trans (SL.mul-swap (basis.vector j) (S.iota.1 (basis.coordinate a i)) (basis.vector i))
       (ap (S.ring.mul (S.iota.1 (basis.coordinate a i))) (S.ring.mulC (basis.vector j) (basis.vector i))))))) ;
 pairing (a : S.ring.R) (j : Fin n) : Id k.R (B.trace (S.ring.mul a (basis.vector j)))
  (D.act n gram (basis.coordinate a) j) =
  trans (ap B.trace (product-expansion a j))
   (MapTrace.combination n (\ i -> S.ring.mul (basis.vector i) (basis.vector j)) (basis.coordinate a)) ;
 Perfect : U l = RL[k].unit (ExteriorModel[l].Over[k].det n gram) ;
 module At (perfect : Perfect) (a : S.ring.R)
  (h : (j : Fin n) -> Id k.R (B.trace (S.ring.mul a (basis.vector j))) k.z) {
  kernel (j : Fin n) : Id k.R (D.act n gram (basis.coordinate a) j) k.z = trans (sym (pairing a j)) (h j) ;
  killed (j : Fin n) : Id k.R (k.mul (ExteriorModel[l].Over[k].det n gram) (basis.coordinate a j)) k.z =
   Trick.trick n gram (basis.coordinate a) kernel j ;
  coordinate-zero (j : Fin n) : Id k.R (basis.coordinate a j) k.z =
   trans (sym (KL.one-left (basis.coordinate a j)))
    (trans (ap (\ c -> k.mul c (basis.coordinate a j))
     (sym (trans (k.mulC perfect.1 (ExteriorModel[l].Over[k].det n gram)) perfect.2)))
     (trans (sym (k.mulA perfect.1 (ExteriorModel[l].Over[k].det n gram) (basis.coordinate a j)))
      (trans (ap (k.mul perfect.1) (killed j)) (KL.mul-zero perfect.1)))) ;
  theorem : Id S.ring.R a S.ring.z = B.coordinates-determine a S.ring.z (\ j -> trans (coordinate-zero j) (sym (B.zero j))) ;
 } ;
 nondegenerate (perfect : Perfect) (a : S.ring.R)
  (h : (b : S.ring.R) -> Id k.R (B.trace (S.ring.mul a b)) k.z) : Id S.ring.R a S.ring.z =
  At[perfect,a,\ j -> h (basis.vector j)].theorem ;
} ;
