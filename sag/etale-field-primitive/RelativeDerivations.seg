-- Derivations along an algebra homomorphism. The underlying map is
-- k-linear, and the Leibniz rule uses the specified algebra map on the
-- two unchanged factors. This is the interface used to restrict a
-- monic-quotient derivation to a selected idempotent factor.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S T : Algebras[l].Over[k,setk].Algebra) (h : Algebras[l].Over[k,setk].Hom S T) {
 record Derivation {
  linear : TraceLinear[l].Over[k,setk].Linear[S,T] ;
  product (a b : S.ring.R) : Id T.ring.R (linear.map (S.ring.mul a b))
   (T.ring.add (T.ring.mul (linear.map a) (h.1.1 b)) (T.ring.mul (h.1.1 a) (linear.map b))) ;
 } ;
} ;
module Retarget (k : CRing) (setk : Pr.isSet k.R)
 (S T : Algebras[l].Over[k,setk].Algebra)
 (h h' : Algebras[l].Over[k,setk].Hom S T)
 (same : (a : S.ring.R) -> Id T.ring.R (h.1.1 a) (h'.1.1 a)) {
 module Source = Over[k,setk,S,T,h] ; module Target = Over[k,setk,S,T,h'] ;
 map (d : Source.Derivation) : Target.Derivation = new Target.Derivation[d.linear,
  \ a b -> trans (d.product a b)
   (Presentations[l].cong2 T.ring.R T.ring.add _ _ _ _
    (ap (T.ring.mul (d.linear.map a)) (same b))
    (ap (\ c -> T.ring.mul c (d.linear.map b)) (same a)))] ;
} ;
