-- The exact field-level target needed by the local proof, expressed in
-- the ambient algebra. No existence theorem is asserted here. A selected
-- factor is one idempotent outside the specified prime, a generator,
-- a monic annihilator with invertible derivative on that factor, and
-- polynomial representations of only the finitely many basis vectors.
-- The derivative is the same dual-number Horner value as Introduction.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module C = Algebras[l].Over[k,setk] ;
 record Field {
  decide (a : k.R) : Plus (Id k.R a k.z) (RL[k].unit a) ;
  nonzero : Not (Id k.R k.o k.z) ;
 } ;
 monic : List k.R -> List k.R = split { nil -> cons k.o nil ; cons a p | ih -> cons a ih } ;
 module At (S : C.Algebra) {
  module B = TraceBasis[l].Over[k,setk,S] ;
  module PI = PrimeIdempotents[l].Over[S.ring] ;
  module DN = QuadraticPairs[l].Over[S.ring,S.set,S.ring.z] ;
  dual : RingHom[l].Hom k DN.ring = RingHom[l].compose k S.ring DN.ring DN.inclusion S.iota ;
  value (x : S.ring.R) (p : List k.R) : S.ring.R = MonicReduce[l].Horner[k,S.ring,S.iota,x].horner p ;
  slope (x : S.ring.R) (p : List k.R) : S.ring.R =
   (MonicReduce[l].Horner[k,DN.ring,dual,(x,S.ring.o)].horner p).2 ;
  -- This is input data, not an axiom producing a primitive element.
  record Input {
   field : Field ;
   rank : Nat ;
   basis : B.Basis[rank] ;
   perfect-trace : RL[k].unit (ExteriorModel[l].Over[k].det rank
    (\ j i -> B.At[rank,basis].trace (S.ring.mul (basis.vector j) (basis.vector i)))) ;
   prime : PI.Prime ;
  } ;
  record Selected (n : Nat) (basis : B.Basis[n]) (q : PI.Prime) {
   idempotent : S.ring.R ;
   square : Id S.ring.R (S.ring.mul idempotent idempotent) idempotent ;
   outside : Not (q.ideal.In idempotent) ;
   generator : S.ring.R ;
   lower : List k.R ;
   root : Id S.ring.R (S.ring.mul idempotent (value generator (monic lower))) S.ring.z ;
   inverse : S.ring.R ;
   separable : Id S.ring.R
    (S.ring.mul idempotent (S.ring.add (S.ring.mul (slope generator (monic lower)) inverse) (S.ring.neg S.ring.o))) S.ring.z ;
   representation : Fin n -> List k.R ;
   generates (i : Fin n) : Id S.ring.R
    (S.ring.mul idempotent (S.ring.add (basis.vector i) (S.ring.neg (value generator (representation i))))) S.ring.z ;
  } ;
  Result (input : Input) : U l = Truncation[l].Trunc[Selected[input.rank,input.basis,input.prime]].carrier ;
 } ;
} ;
