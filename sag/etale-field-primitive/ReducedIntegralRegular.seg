-- A reduced algebra over a weak field is regular at every integral
-- element. Strip zero coefficients from a monic annihilator, maintaining
-- a*P(a)=0. Reducedness cancels a square at a zero head; a unit head
-- constructs a regular witness. Mere runs the finite scan under
-- truncation; Exact retains the actual coefficient-stripping proof.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (S : Algebras[l].Over[k,setk].Algebra)
 (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z) {
 module L = RL[S.ring] ; module R = PrincipalRegularity[l].Over[S.ring] ;
 module Statement = SelectedFactorStatement[l].Over[k,setk] ;
 value (a : S.ring.R) (p : List k.R) : S.ring.R = MonicReduce[l].Horner[k,S.ring,S.iota,a].horner p ;
 cancel-square (a b : S.ring.R) (h : Id S.ring.R (S.ring.mul a (S.ring.mul a b)) S.ring.z) :
  Id S.ring.R (S.ring.mul a b) S.ring.z = reduced (S.ring.mul a b)
   (trans (L.mul-four a b a b)
    (trans (S.ring.mulA (S.ring.mul a a) b b)
     (trans (ap (\ x -> S.ring.mul x b) (trans (sym (S.ring.mulA a a b)) h)) (L.zero-mul b)))) ;
 module UnitHead (a : S.ring.R) (c : k.R) (p : List k.R) (unit : RL[k].unit c)
  (root : Id S.ring.R (S.ring.mul a (value a (cons c p))) S.ring.z) {
  u : S.ring.R = S.iota.1 unit.1 ;
  cu : Id S.ring.R (S.ring.mul (S.iota.1 c) u) S.ring.o =
   trans (sym (S.iota.2.2.2 c unit.1)) (trans (ap S.iota.1 unit.2) S.iota.2.1) ;
  uca : Id S.ring.R (S.ring.mul u (S.ring.mul a (S.iota.1 c))) a =
   trans (L.mul-swap u a (S.iota.1 c))
    (trans (ap (S.ring.mul a) (trans (S.ring.mulC u (S.iota.1 c)) cu)) (S.ring.mulO a)) ;
  tail : S.ring.R = value a p ;
  rearrange : Id S.ring.R (S.ring.mul u (S.ring.mul a (S.ring.mul a tail)))
   (S.ring.mul (S.ring.mul a a) (S.ring.mul u tail)) =
   trans (ap (S.ring.mul u) (S.ring.mulA a a tail)) (L.mul-swap u (S.ring.mul a a) tail) ;
  sum-zero : Id S.ring.R (S.ring.add a (S.ring.mul (S.ring.mul a a) (S.ring.mul u tail))) S.ring.z =
   trans (sym (trans (ap (S.ring.mul u) (S.ring.dist a (S.iota.1 c) (S.ring.mul a tail)))
    (trans (S.ring.dist u (S.ring.mul a (S.iota.1 c)) (S.ring.mul a (S.ring.mul a tail)))
     (cong2 S.ring.R S.ring.add _ _ _ _ uca rearrange))))
    (trans (ap (S.ring.mul u) root) (L.mul-zero u)) ;
  witness : R.Witness a = (S.ring.neg (S.ring.mul u tail),
   trans (FormallyEtale[l].Units[S.ring,S.set].sub-zero a
    (S.ring.neg (S.ring.mul (S.ring.mul a a) (S.ring.mul u tail)))
    (trans (ap (S.ring.add a) (L.neg-neg (S.ring.mul (S.ring.mul a a) (S.ring.mul u tail)))) sum-zero))
    (sym (L.mul-neg (S.ring.mul a a) (S.ring.mul u tail)))) ;
 } ;
 zero-head (a : S.ring.R) (c : k.R) (p : List k.R) (hc : Id k.R c k.z)
  (root : Id S.ring.R (S.ring.mul a (value a (cons c p))) S.ring.z) :
  Id S.ring.R (S.ring.mul a (value a p)) S.ring.z =
  cancel-square a (value a p)
   (trans (sym (ap (S.ring.mul a)
    (trans (ap (\ x -> S.ring.add x (S.ring.mul a (value a p)))
     (trans (ap S.iota.1 hc) (RingHom[l].zero k S.ring S.iota))) (L.zl (S.ring.mul a (value a p)))))) root) ;
 -- The same finite coefficient scan under truncation needs only weak
 -- zero-or-unit decisions. Every continuation returns a mere witness.
 module Mere
  (weak : (c : k.R) -> Truncation[l].Trunc[Plus (Id k.R c k.z) (RL[k].unit c)].carrier) {
  module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
  step (a : S.ring.R) (c : k.R) (p : List k.R)
   (ih : Id S.ring.R (S.ring.mul a (value a p)) S.ring.z -> Tr.Trunc[R.Witness a].carrier)
   (root : Id S.ring.R (S.ring.mul a (value a (cons c p))) S.ring.z) :
   Plus (Id k.R c k.z) (RL[k].unit c) -> Tr.Trunc[R.Witness a].carrier = split {
    inl h -> ih (zero-head a c p h root) ;
    inr h -> Tr.Trunc[R.Witness a].inc UnitHead[a,c,p,h,root].witness } ;
  strip (a : S.ring.R) : (lower : List k.R) ->
   Id S.ring.R (S.ring.mul a (value a (Statement.monic lower))) S.ring.z -> Tr.Trunc[R.Witness a].carrier = split {
    nil -> \ root -> Tr.Trunc[R.Witness a].inc UnitHead[a,k.o,nil,(k.o,k.mulO k.o),root].witness ;
    cons c p | ih -> \ root -> TC.bind (Plus (Id k.R c k.z) (RL[k].unit c)) (R.Witness a)
     (step a c (Statement.monic p) ih root) (weak c) } ;
  from-annihilator (a : S.ring.R) (lower : List k.R)
   (root : Id S.ring.R (value a (Statement.monic lower)) S.ring.z) : Tr.Trunc[R.Witness a].carrier =
   strip a lower (trans (ap (S.ring.mul a) root) (L.mul-zero a)) ;
  regular (annihilators : (a : S.ring.R) -> Tr.Trunc[
   (lower : List k.R) * Id S.ring.R (value a (Statement.monic lower)) S.ring.z].carrier) : R.Regular =
   \ a -> TC.bind ((lower : List k.R) * Id S.ring.R (value a (Statement.monic lower)) S.ring.z)
    (R.Witness a) (\ h -> from-annihilator a h.1 h.2) (annihilators a) ;
 } ;
 module Exact (dec : (c : k.R) -> Plus (Id k.R c k.z) (RL[k].unit c)) {
 step (a : S.ring.R) (c : k.R) (p : List k.R)
  (ih : Id S.ring.R (S.ring.mul a (value a p)) S.ring.z -> R.Witness a)
  (root : Id S.ring.R (S.ring.mul a (value a (cons c p))) S.ring.z) :
  Plus (Id k.R c k.z) (RL[k].unit c) -> R.Witness a = split {
   inl h -> ih (zero-head a c p h root) ; inr h -> UnitHead[a,c,p,h,root].witness } ;
 strip (a : S.ring.R) : (lower : List k.R) ->
  Id S.ring.R (S.ring.mul a (value a (Statement.monic lower))) S.ring.z -> R.Witness a = split {
   nil -> \ root -> UnitHead[a,k.o,nil,(k.o,k.mulO k.o),root].witness ;
   cons c p | ih -> \ root -> step a c (Statement.monic p) ih root (dec c) } ;
 from-annihilator (a : S.ring.R) (lower : List k.R)
  (root : Id S.ring.R (value a (Statement.monic lower)) S.ring.z) : R.Witness a =
  strip a lower (trans (ap (S.ring.mul a) root) (L.mul-zero a)) ;
 regular (annihilators : (a : S.ring.R) -> Truncation[l].Trunc[
  (lower : List k.R) * Id S.ring.R (value a (Statement.monic lower)) S.ring.z].carrier) : R.Regular =
  \ a -> TruncationCombinators[l].map
   ((lower : List k.R) * Id S.ring.R (value a (Statement.monic lower)) S.ring.z)
   (R.Witness a) (\ h -> from-annihilator a h.1 h.2) (annihilators a) ;
 } ;
} ;
