-- The coefficient rescaling identity holds after any base map. In
-- particular it can be interpreted in the target polynomial ring.
level l ; open Ring[l] ; open Presentations[l] ;
module H = RingHom[l] ; module V = MonicRescalingValues[l] ;
map (X Y : U l) (f : X -> Y) : List X -> List Y = split {
 nil -> nil ; cons x xs | ih -> cons (f x) ih } ;
length (X Y : U l) (f : X -> Y) : (xs : List X) -> Id Nat (len (map X Y f xs)) (len xs) = split {
 nil -> refl zero ; cons x xs | ih -> ap (\ n -> suc n) ih } ;
cons-eq (X : U l) (x y : X) (xs ys : List X) (h : Id X x y) (k : Id (List X) xs ys) :
 Id (List X) (cons x xs) (cons y ys) =
 Prelude[l].trans (List X) (cons x xs) (cons y xs) (cons y ys)
  (ap (\ a -> cons a xs) h) (ap (\ a -> cons y a) k) ;
module Values (B C : CRing) (k : H.Hom B C) (x : C.R) {
 module Original = V.Values[B,C,k,x] ; module Mapped = V.Values[C,C,H.identity C,x] ;
 value : (p : List B.R) -> Id C.R (Mapped.value (map B.R C.R k.1 p)) (Original.value p) = split {
  nil -> refl C.o ; cons a p | ih -> ap (\ z -> C.add (k.1 a) (C.mul x z)) ih } ;
} ;
module Over (A B C : CRing) (h : H.Hom A B) (k : H.Hom B C) (u : A.R) {
 module Source = V.Over[A,B,h,u] ;
 composite : H.Hom A C = H.compose A B C k h ;
 module Target = V.Over[A,C,composite,u] ;
 image (p : List B.R) : List C.R = map B.R C.R k.1 p ;
 numerators : (p : List B.R) -> Source.Numerators p -> Target.Numerators (image p) = split {
  nil -> \ w -> tt ;
  cons a p | ih -> \ w ->
   ((w.1.1,trans (ap k.1 w.1.2) (k.2.2.2 Source.scale a)),ih w.2) } ;
 lower : (p : List B.R) (w : Source.Numerators p) ->
  Id (List A.R) (Target.lower (image p) (numerators p w)) (Source.lower p w) = split {
  nil -> \ w -> refl nil ;
  cons a p | ih -> \ w -> cons-eq A.R _ _ _ _
   (ap (\ n -> A.mul (Source.AP.power u n) w.1.1) (length B.R C.R k.1 p)) (ih w.2) } ;
 module At (x : C.R) {
  module T = Target.At[x] ;
  module Original = V.Values[B,C,k,x] ;
  value (p : List B.R) (w : Source.Numerators p) :
   Id C.R (T.Scaled.value (Source.lower p w))
    (C.mul (Target.BP.power Target.scale (len p)) (Original.value p)) =
   trans (ap T.Scaled.value (sym (lower p w)))
    (trans (T.value (image p) (numerators p w))
     (cong2 C.R C.mul _ _ _ _
      (ap (Target.BP.power Target.scale) (length B.R C.R k.1 p)) (Values[B,C,k,x].value p))) ;
 } ;
} ;
