-- Weighted dependence in arbitrary nvar=extra+3 homogeneous coordinates.
-- Apply coefficient projection degree N+1 to the FINAL checked scalar
-- dependence identity; neither its syzygies nor its proof are modified.
-- Nested boundary truncations are eliminated into the final truncation.
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module K = GenericDegree[l] ;

module Over (K0 : U l) (A : CRing) (t : Nat) (D : CRing) (setD : Pr.isSet D.R) (G : Graded[A,t,D]) (cfn : CFN[l].CFN[K0,D]) (extra : Nat) {
  module GL = Laws[A,t,D,setD,G] ;
  module CC = GenericCoefficientCech[l].Over[A,t,D,setD,G] ;
  module CD = ScalarResolutionDependence[l].Over[K0,D,setD,cfn,extra] ;
  module BA = GenericBihomogeneousAction[l].Over[A,t,D,setD,G,CD.T.nvar] ;

  module Input (a : Nat) (d : Ps.Fin a -> Base.Nat) (f : Ps.Fin a -> Base.Nat) (g : Ps.Fin a -> BA.AC.A.Polys)
    (hg : (i : Ps.Fin a) -> CD.T.P.HR.HomShift zero (d i) (g i)) (hf : (i : Ps.Fin a) -> BA.CoefHom (f i) (g i)) {
    module CI = CD.Input[a,d,g,hg] ;
    -- Pr on C^0(-1), C^1(-1) and on prod_j C^1(-1-d_j)
    module P0 = CC.CochainPr[CD.T.nvar,negsuc zero,K.topRank (suc zero)].P ;
    module P1 = CC.CochainPr[CD.T.nvar,negsuc zero,K.topRank (suc (suc zero))].P ;
    module DF = CC.Diff[CD.T.nvar,negsuc zero,K.topRank (suc zero)] ;
    module FP = BA.RowPr[a,CD.T.C.twists CI.I.source,negsuc zero,g,\ i -> CI.I.A1.hs i (inr tt),f,hf,K.topRank (suc (suc zero))] ;
    module E1 = CI.C1 ;

    module Seq (c : Nat -> E1.El) (hc : (n : Nat) -> P1.Hom (cdeg (suc n)) (c n))
      (lift : (n : Nat) -> Tr.Trunc[CI.Lifted (c n)].carrier) {
      module CS = CI.Seq[c,lift] ;

      -- the entry with tail length i gets pr (N - i)
      projL (N : Nat) : List D.R -> List D.R = split {
        nil -> nil ;
        cons x xs | r -> cons (G.pr (lowerZ (cdeg N) (len xs)) x) r } ;
      len-proj (N : Nat) : (qs : List D.R) -> Id Nat (len (projL N qs)) (len qs) = split {
        nil -> refl zero ;
        cons x xs | r -> ap (\ n -> suc n) r } ;
      -- the entry with tail length i has coefficient degree N - i
      HomL (N : Nat) : List D.R -> U l = split {
        nil -> Top ;
        cons x xs | r -> GL.Hom (lowerZ (cdeg N) (len xs)) x * r } ;
      hom-projL (N : Nat) : (qs : List D.R) -> HomL N (projL N qs) = split {
        nil -> tt ;
        cons x xs | r -> (subst (\ n -> GL.Hom (lowerZ (cdeg N) n) (G.pr (lowerZ (cdeg N) (len xs)) x)) (sym (len-proj N xs))
                            (GL.hom-pr (lowerZ (cdeg N) (len xs)) x), r) } ;

      -- Pr (N+1) (q c_i) = pr (N - i)(q) c_i
      term-proj (N : Nat) (q : D.R) (i : Nat) :
        Id E1.El (P1.proj (cdeg (suc N)) (E1.mod.sm q (c i))) (E1.mod.sm (G.pr (lowerZ (cdeg N) i) q) (c i)) =
        trans (P1.proj-scalar-pos (cdeg (suc N)) (suc (toB i)) q (c i) (hc i))
              (ap (\ e -> E1.mod.sm (G.pr e q) (c i)) (minus-suc-suc (cdeg N) (toB i))) ;
      -- Pr (N+1) (sum_{i<N} q_i c_i) = sum_{i<N} pr (N - i)(q_i) c_i
      sum-proj (N : Nat) : (qs : List D.R) -> Id E1.El (P1.proj (cdeg (suc N)) (CS.sumL qs)) (CS.sumL (projL N qs)) = split {
        nil -> P1.proj-zero (cdeg (suc N)) ;
        cons x xs | r -> calc E1.El {
          P1.proj (cdeg (suc N)) (E1.mod.madd (E1.mod.sm x (c (len xs))) (CS.sumL xs))
            =< P1.proj-add (cdeg (suc N)) (E1.mod.sm x (c (len xs))) (CS.sumL xs)
            > E1.mod.madd (P1.proj (cdeg (suc N)) (E1.mod.sm x (c (len xs)))) (P1.proj (cdeg (suc N)) (CS.sumL xs))
            =< CI.CL.G.cong-add (term-proj N x (len xs)) r
            > E1.mod.madd (E1.mod.sm (G.pr (lowerZ (cdeg N) (len xs)) x) (c (len xs))) (CS.sumL (projL N xs))
            =< ap (\ n -> E1.mod.madd (E1.mod.sm (G.pr (lowerZ (cdeg N) (len xs)) x) (c n)) (CS.sumL (projL N xs))) (sym (len-proj N xs))
            > CS.sumL (projL N (cons x xs)) } } ;

      -- the weighted conclusion (W) for N and rs
      WBdry (N : Nat) (rs : List D.R) : U l =
        (v : CI.C0.El) * ((a' : CI.I.U1.El) * (P0.Hom (cdeg (suc N)) v * (FP.Hom (cdeg (suc N)) a' * (HomL N rs *
          Id E1.El (CI.CL.msub (c N) (CS.sumL rs)) (E1.mod.madd (CI.D0.d.f v) (CI.I.A1.A.lin.f a' (inr tt))))))) ;
      WResult : U l = (rs : List D.R) * WBdry (len rs) rs ;
      -- accessors
      module WR (w : WResult) {
        rs : List D.R = w.1 ;
        N : Nat = len w.1 ;
        v : CI.C0.El = w.2.1 ;
        a' : CI.I.U1.El = w.2.2.1 ;
        hom-v : P0.Hom (cdeg (suc N)) v = w.2.2.2.1 ;
        hom-a : FP.Hom (cdeg (suc N)) a' = w.2.2.2.2.1 ;
        hom-r : HomL N rs = w.2.2.2.2.2.1 ;
        eq : Id E1.El (CI.CL.msub (c N) (CS.sumL rs)) (E1.mod.madd (CI.D0.d.f v) (CI.I.A1.A.lin.f a' (inr tt))) = w.2.2.2.2.2.2 ;
      } ;

      -- projecting one result (U) of CoherentDependence4
      module Project (qs : List D.R) (res : CI.Bdry (CI.CL.msub (c (len qs)) (CS.sumL qs))) {
        N : Nat = len qs ;
        h : CI.C0.El = res.1 ;
        a0 : CI.I.U1.El = res.2.1 ;
        -- (U)
        U-eq : Id E1.El (CI.CL.msub (c N) (CS.sumL qs)) (E1.mod.madd (CI.D0.d.f h) (CI.I.A1.A.lin.f a0 (inr tt))) = res.2.2 ;
        k : Int = cdeg (suc N) ;
        rs : List D.R = projL N qs ;
        v : CI.C0.El = P0.proj k h ;
        a' : CI.I.U1.El = FP.proj k a0 ;
        -- (W) = Pr (N+1) (U)
        W-eq : Id E1.El (CI.CL.msub (c N) (CS.sumL rs)) (E1.mod.madd (CI.D0.d.f v) (CI.I.A1.A.lin.f a' (inr tt))) = calc E1.El {
          CI.CL.msub (c N) (CS.sumL rs)
            =< ap (\ w -> CI.CL.msub w (CS.sumL rs)) (sym (P1.proj-hom k (c N) (hc N)))
            > CI.CL.msub (P1.proj k (c N)) (CS.sumL rs)
            =< ap (CI.CL.msub (P1.proj k (c N))) (sym (sum-proj N qs))
            > CI.CL.msub (P1.proj k (c N)) (P1.proj k (CS.sumL qs))
            =< sym (P1.proj-sub k (c N) (CS.sumL qs)) > P1.proj k (CI.CL.msub (c N) (CS.sumL qs))
            =< ap (P1.proj k) U-eq > P1.proj k (E1.mod.madd (CI.D0.d.f h) (CI.I.A1.A.lin.f a0 (inr tt)))
            =< P1.proj-add k (CI.D0.d.f h) (CI.I.A1.A.lin.f a0 (inr tt))
            > E1.mod.madd (P1.proj k (CI.D0.d.f h)) (P1.proj k (CI.I.A1.A.lin.f a0 (inr tt)))
            =< CI.CL.G.cong-add (DF.equation k h) (FP.equation k a0)
            > E1.mod.madd (CI.D0.d.f v) (CI.I.A1.A.lin.f a' (inr tt)) } ;
        bdry : WBdry N rs = (v, (a', (P0.hom-proj k h, (FP.hom-proj k a0, (hom-projL N qs, W-eq))))) ;
        result : WResult = (rs, subst (\ n -> WBdry n rs) (sym (len-proj N qs)) bdry) ;
      } ;

      -- THEOREM (Gate C)
      convert (res : CS.Result) : Tr.Trunc[WResult].carrier =
        TC.map (CI.Bdry (CI.CL.msub (c (len res.1)) (CS.sumL res.1))) WResult
          (\ w -> Project[res.1,w].result) res.2 ;
      dependence : Tr.Trunc[WResult].carrier = TC.bind CS.Result WResult convert CS.dependence ;
    } ;
  } ;
} ;

-- the concrete theorem: D = A[U_1, .., U_t] with its constructed grading
-- and CFN structure
module Concrete (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) (t extra : Nat) {
  module T = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
  module W = Over[K0,A,t,T.D t,T.setD t,T.grD t,T.cfnD K0 cfnA t,extra] ;
} ;
