-- Five-coordinate P4 regressions: nonzero actual C1 coefficient, shifted
-- scalar projection, differential projection, explicit evaluation/powers;
-- nonmonomial coefficient input, zero/empty ranks and fixed-N indexing.
level l ; open Ring[l] ; open ZInt[l] ; open GenericCube[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module L = GenericLaurent[l] ; module N = FiniteExponents[l] ; module K = GenericDegree[l] ;
module Tr = Truncation[l] ; module RC = RelationCertificate[l] ; module PA = PolynomialAction4[l] ;
module Old = WeightedRegression4[l] ; module CR = CubicResolution4[l] ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ; four : Nat = suc three ; five : Nat = suc four ;
m0 : L.Exp five = LaurentExponentDecision[l].join four (\ i -> zeroZ) (negsuc zero) ;
s0 : Sub five = (present,(present,(absent,(absent,(absent,tt))))) ;
good : GenericCech[l].Bad five (negsuc zero) (K.topRank two) s0 m0 -> Empty = split {
 inl ne -> ne (refl (negsuc zero)) ;
 inr b -> good-other b }
where { good-other : Plus (GenericSupport[l].bad five (L.mask five m0) s0) (Not (Id Int (K.card five s0) (K.topRank two))) -> Empty = split {
 inl b -> b ; inr ne -> ne (refl (K.topRank two)) } } ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module S = Old.Over[A,setA] ; module D = S.DL ;
 module C = GenericCoefficientCech[l].Over[A,two,S.D2,S.T.setD two,S.G2] ;
 module P = C.CochainPr[five,negsuc zero,K.topRank two].P ;
 x : S.D2.R = S.D2.add S.UU S.UV ;
 hx : S.GL.Hom (pos Old.twoB) x = S.GL.hom-add (pos Old.twoB) S.UU S.UV S.hUU S.hUV ;
 module Atom = GenericCochainAtom[l].Over[S.D2,S.T.setD two,L.Exp five,Sub five,
  GenericCech[l].Bad five (negsuc zero) (K.topRank two),LaurentExponentDecision[l].dec five,GenericCochainAtom[l].sub-dec five,s0,m0,good,x] ;
 c : P.CH.El = Atom.element ;
 coefficient : Id S.D2.R (P.CH.val c s0 m0) x = Atom.at ;
 hc : P.Hom (pos Old.twoB) c = Atom.Property[S.GL.Hom (pos Old.twoB),S.GL.hom-zero (pos Old.twoB),hx].point-property ;
 scal3 : Id P.CH.El (P.proj (pos Old.threeB) (P.CH.mod.sm S.q c)) (P.CH.mod.sm S.Uv c) =
  trans (P.proj-scalar-pos (pos Old.threeB) Old.twoB S.q c hc) (ap (\ z -> P.CH.mod.sm z c) S.pr1-q) ;
 scal1 : Id P.CH.El (P.proj (pos Old.oneB) (P.CH.mod.sm S.q c)) P.CH.mod.mz =
  trans (P.proj-scalar-pos (pos Old.oneB) Old.twoB S.q c hc)
   (trans (ap (\ z -> P.CH.mod.sm z c) S.prneg-q) (IP.ModL[S.D2,P.CH.mod].zero-sm c)) ;
 diff : Id C.Diff[five,negsuc zero,K.topRank two].P1.CH.El
   (C.Diff[five,negsuc zero,K.topRank two].P1.proj (pos Old.twoB) (C.Diff[five,negsuc zero,K.topRank two].CT.d.f c))
   (C.Diff[five,negsuc zero,K.topRank two].CT.d.f (P.proj (pos Old.twoB) c)) = C.Diff[five,negsuc zero,K.topRank two].equation (pos Old.twoB) c ;
 module Eval (b : Ps.Fin two -> A.R) {
  module E = GenericCoefficientEvaluation[l].Over[A,setA,two,S.D2,S.T.setD two,S.G2,b,five] ;
  module F = E.CochainEv[negsuc zero,K.topRank two].E ;
  evaluated-coefficient : Id A.R (F.CHA.val (F.evc c) s0 m0) (E.ev.1 x) = ap E.ev.1 Atom.at ;
  witness : F.FC.Wit Old.twoB (F.evc c) = F.wit Old.twoB c hc ;
 } ;
 module Dep (K0 : U l) (cfnA : CFN[l].CFN[K0,A]) (b : Ps.Fin two -> A.R) {
  module T = EvaluatedWeightedDependence[l].Concrete[K0,A,setA,cfnA,two,two,b].ED ;
  ex : N.Exp five = N.join four (N.zeroE four) Old.threeB ;
  d (i : Ps.Fin one) : Base.Nat = Old.threeB ;
  f (i : Ps.Fin one) : Base.Nat = Old.oneB ;
  g (i : Ps.Fin one) : T.WD.BA.AC.A.Polys = cons (S.D2.add S.Uv S.Vv,ex) nil ;
  hg (i : Ps.Fin one) : T.WD.CD.T.P.HR.HomShift zero (d i) (g i) =
   (trans (ap (NatArith[l].plus Old.threeB) (GenericCertificateRegression[l].degree-zero four)) (NatArith[l].plus-zero Old.threeB),tt) ;
  hf (i : Ps.Fin one) : T.WD.BA.CoefHom (f i) (g i) = (S.GL.hom-add (pos Old.oneB) S.Uv S.Vv S.hU S.hV,tt) ;
  module I = T.Input[one,d,f,g,hg,hf] ;
  module Seq (cs : Nat -> I.W.E1.El) (hcs : (j : Nat) -> I.W.P1.Hom (cdeg (suc j)) (cs j))
   (lift : (j : Nat) -> Tr.Trunc[I.CI.Lifted (cs j)].carrier) {
    evaluated : Tr.Trunc[I.Seq[cs,hcs,lift].EvResult].carrier = I.Seq[cs,hcs,lift].evaluated ;
    module Q = I.W.Seq[cs,hcs,lift] ;
    -- The earlier coefficient keeps fixed outer N even in a shorter tail.
    fixed-index (N0 : Nat) (q r : S.D2.R) :
     Id (List S.D2.R) (Q.projL N0 (cons q (cons r nil)))
       (cons (S.G2.pr (lowerZ (cdeg N0) one) q) (cons (S.G2.pr (cdeg N0) r) nil)) = refl (Q.projL N0 (cons q (cons r nil))) ;
  } ;
  zero-seq (j : Nat) : I.W.E1.El = I.W.E1.mod.mz ;
  zero-hom (j : Nat) : I.W.P1.Hom (cdeg (suc j)) (zero-seq j) = I.W.P1.hom-zero (cdeg (suc j)) ;
  zero-lift (j : Nat) : Tr.Trunc[I.CI.Lifted (zero-seq j)].carrier = Tr.Trunc[I.CI.Lifted (zero-seq j)].inc
   (I.CI.I.U2.mod.mz,trans RC.LinL[S.D2,I.CI.C1.mod,I.CI.C2.mod,I.CI.D1.d].f-zero
    (sym (ap (\ u -> u (inr tt)) RC.LinL[S.D2,I.CI.I.U2.mod,I.CI.I.F2.mod,I.CI.I.A2.A.lin].f-zero))) ;
  evaluated-zero : Tr.Trunc[I.Seq[zero-seq,zero-hom,zero-lift].EvResult].carrier = I.Seq[zero-seq,zero-hom,zero-lift].evaluated ;
 } ;
} ;

-- Empty coefficient-variable block, zero polynomial with a deliberately
-- large declared degree, and the explicit N=0 boundary construction.
module Corner (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A]) (extra : Nat) {
 b (j : Ps.Fin zero) : A.R = absurd A.R j ;
 module T = EvaluatedWeightedDependence[l].Concrete[K0,A,setA,cfnA,zero,extra,b].ED ;
 d (i : Ps.Fin one) : Base.Nat = GenericCertificateRegression[l].fiveB ;
 g (i : Ps.Fin one) : T.WD.BA.AC.A.Polys = nil ;
 hg (i : Ps.Fin one) : T.WD.CD.T.P.HR.HomShift zero (d i) (g i) = tt ;
 hf (i : Ps.Fin one) : T.WD.BA.CoefHom (d i) (g i) = tt ;
 module I = T.Input[one,d,d,g,hg,hf] ;
 cs (j : Nat) : I.W.E1.El = I.W.E1.mod.mz ;
 hcs (j : Nat) : I.W.P1.Hom (cdeg (suc j)) (cs j) = I.W.P1.hom-zero (cdeg (suc j)) ;
 lift (j : Nat) : Tr.Trunc[I.CI.Lifted (cs j)].carrier = Tr.Trunc[I.CI.Lifted (cs j)].inc
   (I.CI.I.U2.mod.mz,trans RC.LinL[A,I.CI.C1.mod,I.CI.C2.mod,I.CI.D1.d].f-zero
    (sym (ap (\ u -> u (inr tt)) RC.LinL[A,I.CI.I.U2.mod,I.CI.I.F2.mod,I.CI.I.A2.A.lin].f-zero))) ;
 module Q = I.W.Seq[cs,hcs,lift] ;
 evaluated : Tr.Trunc[I.Seq[cs,hcs,lift].EvResult].carrier = I.Seq[cs,hcs,lift].evaluated ;
 boundary : I.CI.Bdry (I.CI.CL.msub (cs zero) (Q.CS.sumL nil)) =
  (I.CI.C0.mod.mz,(I.CI.I.U1.mod.mz,
    trans (I.CI.CL.sub-self I.CI.C1.mod.mz)
     (sym (trans (I.CI.CL.G.cong-add RC.LinL[A,I.CI.C0.mod,I.CI.C1.mod,I.CI.D0.d].f-zero
       (ap (\ u -> u (inr tt)) RC.LinL[A,I.CI.I.U1.mod,I.CI.I.F1.mod,I.CI.I.A1.A.lin].f-zero))
       (I.CI.C1.mod.maddZ I.CI.C1.mod.mz))))) ;
 empty-N : Q.WBdry zero nil = Q.Project[nil,boundary].bdry ;
 negative-degree : Id Int (PA.minus (cdeg (suc zero)) (d (inr tt))) (negsuc (suc (suc (suc zero)))) = refl (negsuc (suc (suc (suc zero)))) ;
 emptyd (i : Ps.Fin zero) : Base.Nat = absurd Base.Nat i ;
 emptyg (i : Ps.Fin zero) : T.WD.BA.AC.A.Polys = absurd T.WD.BA.AC.A.Polys i ;
 emptyhg (i : Ps.Fin zero) : T.WD.CD.T.P.HR.HomShift zero (emptyd i) (emptyg i) = absurd (T.WD.CD.T.P.HR.HomShift zero (emptyd i) (emptyg i)) i ;
 emptyhf (i : Ps.Fin zero) : T.WD.BA.CoefHom (emptyd i) (emptyg i) = absurd (T.WD.BA.CoefHom (emptyd i) (emptyg i)) i ;
 module Empty = T.Input[zero,emptyd,emptyd,emptyg,emptyhg,emptyhf] ;
 empty-evaluated (c : Nat -> Empty.W.E1.El) (hc : (j : Nat) -> Empty.W.P1.Hom (cdeg (suc j)) (c j))
  (lifts : (j : Nat) -> Tr.Trunc[Empty.CI.Lifted (c j)].carrier) : Tr.Trunc[Empty.Seq[c,hc,lifts].EvResult].carrier =
   Empty.Seq[c,hc,lifts].evaluated ;
} ;
module OverZ {
 module R = Over[ZRing[l].ring,ZRing[l].set] ; module E = R.Eval[Old.OverZ.aZ] ;
 coefficient-ten : Id Int (E.F.CHA.val (E.F.evc R.c) s0 m0) (pos Old.tenB) = trans E.evaluated-coefficient Old.OverZ.ev-UU-UV ;
 witness : E.F.FC.Wit Old.twoB (E.F.evc R.c) = E.witness ;
 module Dep = R.Dep[Nat * Nat,ZCFN[l].cfn,Old.OverZ.aZ] ;
 module P2 = Corner[Nat * Nat,ZRing[l].ring,ZRing[l].set,ZCFN[l].cfn,zero] ;
 module P3 = Corner[Nat * Nat,ZRing[l].ring,ZRing[l].set,ZCFN[l].cfn,one] ;
 module P4 = Corner[Nat * Nat,ZRing[l].ring,ZRing[l].set,ZCFN[l].cfn,two] ;
 evaluated : Tr.Trunc[Dep.I.Seq[Dep.zero-seq,Dep.zero-hom,Dep.zero-lift].EvResult].carrier = Dep.evaluated-zero ;
} ;
