-- Project only coefficient degrees. A coefficient-homogeneous polynomial
-- of U-degree f factors out, leaving degree k-f in its input cochain.
-- Projective Laurent exponents and subset cardinalities stay unchanged.
level l ; open Ring[l] ; open ZInt[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module Ps = Presentations[l] ;
module PA = PolynomialAction4[l] ; module N = FiniteExponents[l] ; module L = GenericLaurent[l] ;
module Over (A : CRing) (t : Nat) (D : CRing) (setD : Pr.isSet D.R) (G : Graded[A,t,D]) (n : Nat) {
 module GL = Laws[A,t,D,setD,G] ; module CC = GenericCoefficientCech[l].Over[A,t,D,setD,G] ;
 module AC = CechPolynomialAction[l].Over[D,setD,n] ; module M = ShiftedMatrixAction[l].Over[D,setD,n] ;
 module DL = IP.ModL[D,IP.regular D] ;
 CoefHom (f : Base.Nat) : AC.A.Polys -> U l = split {
  nil -> Top ; cons u p | rec -> GL.Hom (pos f) u.1 * rec } ;
 mulP-proj (k : Int) (f : Base.Nat) : (p : AC.A.Polys) -> CoefHom f p -> (F : L.Exp n -> D.R) (m : L.Exp n) ->
  Id D.R (G.pr k (AC.A.mulP p F m)) (AC.A.mulP p (\ m' -> G.pr (PA.minus k f) (F m')) m) = split {
  nil -> \ hp F m -> GL.pr-zero k ;
  cons u p | rec -> \ hp F m ->
   trans (G.pr-add k (D.mul u.1 (F (AC.V.subE m u.2))) (AC.A.mulP p F m))
    (DL.G.cong-add (GL.pr-mul-pos-left k f u.1 (F (AC.V.subE m u.2)) hp.1) (rec hp.2 F m)) } ;
 module Act (ki ko r : Int) (p : AC.A.Polys) (hp : AC.Shifts ki ko p) (f : Base.Nat) (hf : CoefHom f p) {
  module F = AC.Act[ki,ko,r,p,hp] ;
  module P0 = CC.CochainPr[n,ki,r].P ; module P1 = CC.CochainPr[n,ko,r].P ;
  equation (k : Int) (x : P0.CH.El) : Id P1.CH.El (P1.proj k (F.lin.f x)) (F.lin.f (P0.proj (PA.minus k f) x)) =
   P1.CH.eq _ _ (\ s m -> mulP-proj k f p hf (P0.CH.val x s) m) ;
 } ;
 module RowPr (a : Nat) (ki : Ps.Fin a -> Int) (ko : Int) (g : Ps.Fin a -> AC.A.Polys)
  (hg : (i : Ps.Fin a) -> AC.Shifts (ki i) ko (g i))
  (f : Ps.Fin a -> Base.Nat) (hf : (i : Ps.Fin a) -> CoefHom (f i) (g i)) (r : Int) {
  module F = M.Matrix[suc zero,a,\ j -> ko,ki,\ j i -> g i,\ j i -> hg i,r] ;
  module P0 = CC.CochainPr[n,ko,r].P ;
  module P1 (i : Ps.Fin a) { module P = CC.CochainPr[n,ki i,r].P ; } ;
  module S = Comb[l].Sums[D,P0.CH.mod] ;
  proj (k : Int) (y : F.Source.El) : F.Source.El = \ i -> P1[i].P.proj (PA.minus k (f i)) (y i) ;
  Hom (k : Int) (y : F.Source.El) : U l = (i : Ps.Fin a) -> P1[i].P.Hom (PA.minus k (f i)) (y i) ;
  hom-proj (k : Int) (y : F.Source.El) : Hom k (proj k y) = \ i -> P1[i].P.hom-proj (PA.minus k (f i)) (y i) ;
  entry (k : Int) (y : F.Source.El) (i : Ps.Fin a) :
   Id P0.CH.El (P0.proj k ((F.entry (inr tt) i).f (y i))) ((F.entry (inr tt) i).f (proj k y i)) =
    Act[ki i,ko,r,g i,hg i,f i,hf i].equation k (y i) ;
  equation (k : Int) (y : F.Source.El) :
   Id P0.CH.El (P0.proj k (F.lin.f y (inr tt))) (F.lin.f (proj k y) (inr tt)) =
    trans (P0.proj-sum k a (\ i -> (F.entry (inr tt) i).f (y i)))
     (S.sum-cong a (\ i -> P0.proj k ((F.entry (inr tt) i).f (y i)))
      (\ i -> (F.entry (inr tt) i).f (proj k y i)) (entry k y)) ;
 } ;
} ;
