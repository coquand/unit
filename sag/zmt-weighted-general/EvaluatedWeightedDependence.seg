-- Evaluate the final weighted identity. Original evaluated defining
-- polynomials stay explicit in the finite sum; their vanishing modulo
-- an equation ideal belongs to the Rees comparison, not this theorem.
level l ; open Ring[l] ; open ZInt[l] ; open PolynomialAction4[l] ; open CoefficientParts[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module IP = IdealPowers[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module K = GenericDegree[l] ;
module Over (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (t : Nat)
 (D : CRing) (setD : Pr.isSet D.R) (G : Graded[A,t,D]) (cfn : CFN[l].CFN[K0,D])
 (extra : Nat) (b : Ps.Fin t -> A.R) {
 module WD = GenericWeightedDependence[l].Over[K0,A,t,D,setD,G,cfn,extra] ;
 module EV = GenericCoefficientEvaluation[l].Over[A,setA,t,D,setD,G,b,WD.CD.T.nvar] ;
 module MA = ShiftedMatrixAction[l].Over[A,setA,WD.CD.T.nvar] ;
 module Input (a : Nat) (d f : Ps.Fin a -> Base.Nat) (g : Ps.Fin a -> WD.BA.AC.A.Polys)
  (hg : (i : Ps.Fin a) -> WD.CD.T.P.HR.HomShift zero (d i) (g i))
  (hf : (i : Ps.Fin a) -> WD.BA.CoefHom (f i) (g i)) {
  module W = WD.Input[a,d,f,g,hg,hf] ; module CI = W.CI ;
  module E0 = EV.CochainEv[negsuc zero,K.topRank (suc zero)].E ;
  module E1 = EV.CochainEv[negsuc zero,K.topRank (suc (suc zero))].E ;
  module Ei (i : Ps.Fin a) { module E = EV.CochainEv[WD.CD.T.C.twists CI.I.source i,K.topRank (suc (suc zero))].E ; } ;
  module AF = MA.Family[a,WD.CD.T.C.twists CI.I.source,K.topRank (suc (suc zero))] ;
  module SA = Comb[l].Sums[A,E1.CHA.mod] ; module AL = IP.ModL[A,E1.CHA.mod] ;
  module DA = EV.Diff[negsuc zero,K.topRank (suc zero)] ;
  module Entries (i : Ps.Fin a) {
    module E = EV.Act[WD.CD.T.C.twists CI.I.source i,negsuc zero,K.topRank (suc (suc zero)),g i,CI.I.A1.hs i (inr tt)] ;
  } ;
  evE1 (y : CI.I.U1.El) : AF.El = \ i -> Ei[i].E.evc (y i) ;
  actionA (y : AF.El) : E1.CHA.El = SA.sum a (\ i -> Entries[i].E.AA.lin.f (y i)) ;
  ev-A (y : CI.I.U1.El) : Id E1.CHA.El (E1.evc (CI.I.A1.A.lin.f y (inr tt))) (actionA (evE1 y)) =
    trans (E1.evc-sum a (\ i -> (CI.I.A1.A.entry (inr tt) i).f (y i)))
      (SA.sum-cong a (\ i -> E1.evc ((CI.I.A1.A.entry (inr tt) i).f (y i)))
        (\ i -> Entries[i].E.AA.lin.f (Ei[i].E.evc (y i))) (\ i -> Entries[i].E.equation (y i))) ;
  module Seq (c : Nat -> W.E1.El) (hc : (j : Nat) -> W.P1.Hom (cdeg (suc j)) (c j))
   (lift : (j : Nat) -> Tr.Trunc[CI.Lifted (c j)].carrier) {
   module WS = W.Seq[c,hc,lift] ;
   cA (j : Nat) : E1.CHA.El = E1.evc (c j) ;
   sumA : List D.R -> E1.CHA.El = split {
    nil -> E1.CHA.mod.mz ;
    cons q qs | rec -> E1.CHA.mod.madd (E1.CHA.mod.sm (EV.ev.1 q) (cA (len qs))) rec } ;
   ev-sumL : (rs : List D.R) -> Id E1.CHA.El (E1.evc (WS.CS.sumL rs)) (sumA rs) = split {
    nil -> E1.evc-zero ;
    cons q qs | rec -> trans (E1.evc-add (W.E1.mod.sm q (c (len qs))) (WS.CS.sumL qs))
      (AL.G.cong-add (E1.evc-sm q (c (len qs))) rec) } ;
   PowL (N : Nat) : List D.R -> U l = split {
    nil -> Top ; cons x xs | rec -> EV.FR.WitZ (lowerZ (cdeg N) (len xs)) (EV.ev.1 x) * rec } ;
   powL (N : Nat) : (rs : List D.R) -> WS.HomL N rs -> PowL N rs = split {
    nil -> \ h -> tt ; cons x xs | rec -> \ h -> (EV.witZ-scalar (lowerZ (cdeg N) (len xs)) x h.1,rec h.2) } ;
   module Ev (w : WS.WResult) {
    module R = WS.WR[w] ;
    equation : Id E1.CHA.El (AL.msub (cA R.N) (sumA R.rs))
      (E1.CHA.mod.madd (DA.DA.d.f (E0.evc R.v)) (actionA (evE1 R.a'))) =
       trans (ap (AL.msub (cA R.N)) (sym (ev-sumL R.rs)))
        (trans (sym (E1.evc-sub (c R.N) (WS.CS.sumL R.rs)))
         (trans (ap E1.evc R.eq)
          (trans (E1.evc-add (CI.D0.d.f R.v) (CI.I.A1.A.lin.f R.a' (inr tt)))
           (AL.G.cong-add (DA.equation R.v) (ev-A R.a'))))) ;
    pow-r : PowL R.N R.rs = powL R.N R.rs R.hom-r ;
    pow-v : E0.FC.Wit (suc (toB R.N)) (E0.evc R.v) = E0.wit (suc (toB R.N)) R.v R.hom-v ;
    pow-a (i : Ps.Fin a) : Ei[i].E.FC.WitZ (minus (cdeg (suc R.N)) (f i)) (Ei[i].E.evc (R.a' i)) =
      Ei[i].E.witZ (minus (cdeg (suc R.N)) (f i)) (R.a' i) (R.hom-a i) ;
   } ;
   EvBdry (w : WS.WResult) : U l =
     Id E1.CHA.El (AL.msub (cA WS.WR[w].N) (sumA WS.WR[w].rs))
       (E1.CHA.mod.madd (DA.DA.d.f (E0.evc WS.WR[w].v)) (actionA (evE1 WS.WR[w].a')))
     * (PowL WS.WR[w].N WS.WR[w].rs
     * (E0.FC.Wit (suc (toB WS.WR[w].N)) (E0.evc WS.WR[w].v)
     * ((i : Ps.Fin a) -> Ei[i].E.FC.WitZ (minus (cdeg (suc WS.WR[w].N)) (f i)) (Ei[i].E.evc (WS.WR[w].a' i))))) ;
   EvResult : U l = (w : WS.WResult) * EvBdry w ;
   evaluated : Tr.Trunc[EvResult].carrier = TC.map WS.WResult EvResult
     (\ w -> (w,(Ev[w].equation,(Ev[w].pow-r,(Ev[w].pow-v,Ev[w].pow-a))))) WS.dependence ;
  } ;
 } ;
} ;
module Concrete (K0 : U l) (A : CRing) (setA : Pr.isSet A.R) (cfnA : CFN[l].CFN[K0,A])
 (t extra : Nat) (b : Ps.Fin t -> A.R) {
 module T = CoefficientPolynomial[l].CoefficientTower[A,setA] ;
 module ED = Over[K0,A,setA,t,T.D t,T.setD t,T.grD t,T.cfnD K0 cfnA t,extra,b] ;
} ;
