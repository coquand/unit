-- Apply the completed field theorem to the exact localized special fibre.
-- Basis and selected factor are constructed inside truncation. The local
-- setup, fibre FP/Unique, field, compatible prime and quasiinverse remain
-- explicit inputs; this file does not yet construct those local bridges.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (q a) (q c)) (q-proper : Not (q E.o))
 (q-dec : (a : E.R) -> Plus (q a) (Not (q a)))
 -- ZMT
 (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom A B) (j : H.Hom B E)
 (j-alg : (a : A.R) -> Id E.R (j.1 (iB.1 a)) (iota.1 a))
 (n' : Nat) (bs : Ps.Fin (suc n') -> B.R)
 (coord : (x : B.R) -> Tr.Trunc[(rho : Ps.Fin (suc n') -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
 (s : B.R) (s-one : Tr.Trunc[IdealGenerated[l].Over[A,m,E,iota].InmB (E.add (j.1 s) (E.neg E.o))].carrier)
 (zmt : (z : E.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b)].carrier)
 -- E finitely presented and flat; exact fibre hypotheses are supplied below.
 (presentation : Presentations[l].Over[A,setA].Witness (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (flat : FlatRelations[l].Over[A,E,iota].Flat) (prop-m : (a : A.R) -> Pr.isProp (m a)) {
 module Lift = SelectedLocalLift[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,
  q,q-zero,q-add,q-scale,q-m,q-prime,q-proper,q-dec,B,setB,iB,j,j-alg,n',bs,coord,s,s-one,zmt,presentation,flat,prop-m] ;
 module GivenInverse (N : Nat) (v : B.R)
  (relation : Lift.F.F.InIE (B.mul (Lift.F.Q.PB.power s N) (B.add B.o (B.neg (B.mul s v))))) {
  module Inv = Lift.GivenInverse[N,v,relation] ;
  module Field
   (field : SelectedFactorStatement[l].Over[Lift.F.K,Lift.F.F.QR.set].Field)
   (fp : Presentations[l].Over[Lift.F.K,Lift.F.F.QR.set].FP Inv.Inv.Lift.algebra)
   (unique : FormallyEtale[l].Over[Lift.F.K,Lift.F.F.QR.set].Unique Inv.Inv.Lift.algebra)
   (prime : Inv.Inv.Lift.St.PI.Prime)
   (prime-map : (b : B.R) -> q (j.1 b) -> prime.ideal.In (Lift.F.Q.eta.1 b)) {
   module Structure = UnramifiedFieldSelected[l].Over[Lift.F.K,Lift.F.F.QR.set,field].At[
    Inv.Inv.Lift.algebra,fp,unique,prime] ;
   module Chosen (c : Structure.Certificate) {
    module Apply = Inv.Given[c.dimension,c.basis,prime,c.selected,prime-map] ;
    selected-data : Tr.Trunc[Lift.Lcl.SelectedData].carrier = Apply.selected-data ;
   } ;
   selected-data : Tr.Trunc[Lift.Lcl.SelectedData].carrier =
    TC.bind Structure.Certificate Lift.Lcl.SelectedData (\ c -> Chosen[c].selected-data) Structure.theorem ;
   theorem : Truncation[l+].Trunc[Lift.Lcl.St.Conclusion].carrier = Lift.Lcl.theorem selected-data ;
  } ;
 } ;
} ;
