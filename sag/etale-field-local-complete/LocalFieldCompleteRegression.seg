-- Actual split local example B=F2 x F2, s=(1,0), E=F2. Reuse the
-- quotient/localisation maps, but construct FP and Unique of its exact
-- localized special fibre. The new theorem supplies its basis and
-- selected factor; the older handwritten certificate is not used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module T = SelectedLocalRegression[l] ; module R = SelectedLiftRegression[l] ;
module BF = BooleanRing[l] ;
module Residue = LocalResidueField[l].Over[T.A,R.Bridge.ideal,\ a -> BF.bool-set a false,T.nonzero,T.dec] ;
field : SelectedFactorStatement[l].Over[R.K.ring,R.K.set].Field =
 new SelectedFactorStatement[l].Over[R.K.ring,R.K.set].Field[Residue.decide,Residue.nonzero] ;
module C = Algebras[l].Over[R.K.ring,R.K.set] ;
module P = Presentations[l].Over[R.K.ring,R.K.set] ;
module FE = FormallyEtale[l].Over[R.K.ring,R.K.set] ;
module BP = BasePresentation[l].Over[R.K.ring,R.K.set] ;
module To (D : C.Algebra) {
 arrow : C.Hom R.C.algebra D =
  (H.compose R.Q.T R.K.ring D.ring D.iota R.coordinate,
   \ a -> ap D.iota.1 (R.scalar-coordinate a)) ;
 equal (h : C.Hom R.C.algebra D) (a : R.Q.T.R) : Id D.ring.R (h.1.1 a) (arrow.1.1 a) =
  trans (ap h.1.1 (sym (R.section a))) (h.2 (R.coordinate.1 a)) ;
 inverse (s : P.Solutions BP.empty D) : C.Hom R.C.algebra D = arrow ;
} ;
generators : P.Solutions BP.empty R.C.algebra = (\ i -> efq i,tt) ;
module EmptyUniversal (D : C.Algebra) {
 module M = To[D] ;
 forward (h : C.Hom R.C.algebra D) : P.Solutions BP.empty D = P.canonical BP.empty R.C.algebra generators D h ;
 fb (s : P.Solutions BP.empty D) : Id (P.Solutions BP.empty D) (forward (M.inverse s)) s =
  P.solutions-ext BP.empty D _ s (\ i -> efq i) ;
 bf (h : C.Hom R.C.algebra D) : Id (C.Hom R.C.algebra D) (M.inverse (forward h)) h =
  C.ext R.C.algebra D M.arrow h (\ a -> sym (M.equal h a)) ;
 theorem : Pr.isEquiv (C.Hom R.C.algebra D) (P.Solutions BP.empty D) forward =
  Pr.qinv _ _ forward M.inverse fb bf ;
} ;
presentation : P.Presents BP.empty R.C.algebra = (generators,\ D -> EmptyUniversal[D].theorem) ;
fp : P.FP R.C.algebra = Truncation[l+].Trunc[P.Witness R.C.algebra].inc (BP.empty,presentation) ;
unique : FE.Unique R.C.algebra = \ D N f g eq ->
 C.ext R.C.algebra D f g (\ a -> trans (To[D].equal f a) (sym (To[D].equal g a))) ;
module Bridge = LocalFieldComplete[l].Over[T.A,BF.bool-set,T.m,T.m-zero,T.m-add,T.m-scale,T.dec,T.rad,
 T.A,BF.bool-set,H.identity T.A,T.m,T.m-zero,T.m-add,T.m-scale,(\ a h -> h),T.prime,T.nonzero,T.prime-dec,
 T.B,T.setB,T.iota,T.j,(\ a -> refl a),T.one,T.bs,T.coord,T.s,T.s-one,T.zmt,
 (T.BP.empty,T.BP.presentation),FlatRelations[l].Self[T.A].flat,\ a -> BF.bool-set a false] ;
module Finish = Bridge.GivenInverse[T.one,T.B.o,R.relation].Field[field,fp,unique,R.prime,R.prime-map] ;
selected-data : Tr.Trunc[Bridge.Lift.Lcl.SelectedData].carrier = Finish.selected-data ;
theorem : Truncation[l+].Trunc[Bridge.Lift.Lcl.St.Conclusion].carrier = Finish.theorem ;
-- The nonzero quotient class is still killed in the localized fibre.
nonzero-quotient-class : Not (Id R.F.F.QE.Carrier (R.F.F.QE.include (T.bs T.i1)) R.F.F.QE.zeroQ) =
 R.quotient-other-nonzero ;
zero-localized-class : Id R.Q.T.R (R.Q.eta.1 (T.bs T.i1)) R.Q.T.z = R.other-zero ;
