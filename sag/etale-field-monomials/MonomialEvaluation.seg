-- Evaluation of ordinary monomials, with the newest variable first.
-- This is the common semantic convention for sparse expressions and
-- the triangular Nagata substitution, over any commutative ring.
level l ; open Ring[l] ; open Presentations[l] ;
module E = MonomialExponents[l] ;
module Over (A : CRing) {
 module P = AffinePowers[l].Over[A] ; module L = RL[A] ;
 monomial : (n : Nat) -> (Fin n -> A.R) -> E.Exponent n -> A.R = split {
  zero -> \ x u -> A.o ;
  suc n | rec -> \ x u -> A.mul (P.power (x (inr tt)) (u (inr tt))) (rec (\ i -> x (inl i)) (E.old n u)) } ;
 zero-value : (n : Nat) (x : Fin n -> A.R) -> Id A.R (monomial n x (E.zeroE n)) A.o = split {
  zero -> \ x -> refl A.o ;
  suc n | rec -> \ x -> trans (ap (A.mul A.o) (rec (\ i -> x (inl i)))) (A.mulO A.o) } ;
 unit-value : (n : Nat) (x : Fin n -> A.R) (j : Fin n) -> Id A.R (monomial n x (E.unit n j)) (x j) = split {
  zero -> \ x j -> efq j ;
  suc n | rec -> \ x -> AffineFinite[l].section n
   (\ j -> Id A.R (monomial (suc n) x (E.unit (suc n) j)) (x j))
   (\ j -> trans (ap (A.mul A.o) (rec (\ i -> x (inl i)) j)) (L.one-left (x (inl j))))
   (trans (ap (A.mul (A.mul (x (inr tt)) A.o)) (zero-value n (\ i -> x (inl i))))
    (trans (A.mulO (A.mul (x (inr tt)) A.o)) (A.mulO (x (inr tt))))) } ;
 product : (n : Nat) (x : Fin n -> A.R) (u v : E.Exponent n) ->
  Id A.R (monomial n x (E.addE n u v)) (A.mul (monomial n x u) (monomial n x v)) = split {
  zero -> \ x u v -> sym (A.mulO A.o) ;
  suc n | rec -> \ x u v ->
   trans (cong2 A.R A.mul _ _ _ _ (P.power-add (x (inr tt)) (u (inr tt)) (v (inr tt)))
    (rec (\ i -> x (inl i)) (E.old n u) (E.old n v)))
    (L.mul-four (P.power (x (inr tt)) (u (inr tt))) (P.power (x (inr tt)) (v (inr tt)))
     (monomial n (\ i -> x (inl i)) (E.old n u)) (monomial n (\ i -> x (inl i)) (E.old n v))) } ;
} ;
