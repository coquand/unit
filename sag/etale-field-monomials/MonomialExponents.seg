-- Ordinary exponent vectors for presentation variables, using Ring.Nat.
-- Equality is decided coordinate by coordinate; the newest variable is last.
level l ; open Ring[l] ; open Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
Exponent (n : Nat) : U l = Fin n -> Nat ;
zeroE (n : Nat) : Exponent n = \ i -> zero ;
addE (n : Nat) (u v : Exponent n) : Exponent n = \ i -> plus (u i) (v i) ;
old (n : Nat) (u : Exponent (suc n)) : Exponent n = \ i -> u (inl i) ;
unit : (n : Nat) -> Fin n -> Exponent n = split {
 zero -> \ i -> efq i ; suc n | rec -> split {
  inl j -> snoc (Fin n) Nat (rec j) zero ;
  inr t -> snoc (Fin n) Nat (zeroE n) (suc zero) } } ;
ext (n : Nat) (u v : Exponent n) (eq : (i : Fin n) -> Id Nat (u i) (v i)) : Id (Exponent n) u v =
 F.funext (Fin n) (\ i -> Nat) u v eq ;
nat-step (m n : Nat) : Plus (Id Nat m n) (Not (Id Nat m n)) -> Plus (Id Nat (suc m) (suc n)) (Not (Id Nat (suc m) (suc n))) = split {
 inl eq -> inl (ap (\ a -> suc a) eq) ; inr ne -> inr (\ eq -> ne (suc-inj eq)) } ;
nat-dec : (m n : Nat) -> Plus (Id Nat m n) (Not (Id Nat m n)) = split {
 zero -> split { zero -> inl (refl zero) ; suc n -> inr (zero-suc n) } ;
 suc m | rec -> split { zero -> inr (suc-zero m) ; suc n -> nat-step m n (rec n) } } ;
module Step (n : Nat) (rec : (u v : Exponent n) -> Plus (Id (Exponent n) u v) (Not (Id (Exponent n) u v)))
 (u v : Exponent (suc n)) {
 combine (p : Id (Exponent n) (old n u) (old n v)) :
  Plus (Id Nat (u (inr tt)) (v (inr tt))) (Not (Id Nat (u (inr tt)) (v (inr tt)))) ->
  Plus (Id (Exponent (suc n)) u v) (Not (Id (Exponent (suc n)) u v)) = split {
   inl q -> inl (ext (suc n) u v (AffineFinite[l].section n (\ i -> Id Nat (u i) (v i))
    (\ i -> ap (\ a -> a i) p) q)) ;
   inr nq -> inr (\ eq -> nq (ap (\ a -> a (inr tt)) eq)) } ;
 choose : Plus (Id (Exponent n) (old n u) (old n v)) (Not (Id (Exponent n) (old n u) (old n v))) ->
  Plus (Id (Exponent (suc n)) u v) (Not (Id (Exponent (suc n)) u v)) = split {
   inl p -> combine p (nat-dec (u (inr tt)) (v (inr tt))) ;
   inr np -> inr (\ eq -> np (ap (old n) eq)) } ;
 result : Plus (Id (Exponent (suc n)) u v) (Not (Id (Exponent (suc n)) u v)) = choose (rec (old n u) (old n v)) ;
} ;
dec : (n : Nat) (u v : Exponent n) -> Plus (Id (Exponent n) u v) (Not (Id (Exponent n) u v)) = split {
 zero -> \ u v -> inl (ext zero u v (\ i -> efq i)) ;
 suc n | rec -> \ u v -> Step[n,rec,u,v].result } ;
