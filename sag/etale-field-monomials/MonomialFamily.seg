-- Enumerate a normalized monomial list by Fin(length), putting the head
-- at the last index. Distinctness becomes injectivity of the exponent map,
-- and list evaluation becomes exactly the library's finite sum.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module E = MonomialExponents[l] ;
module Tr = Truncation[l] ; module TH = Truncation[l+] ; module THC = TruncationCombinators[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (n : Nat) {
 module T = MonomialLists[l].Over[A,setA,n] ;
 length : T.Terms -> Nat = split { nil -> zero ; cons t p | rec -> suc rec } ;
 at : (p : T.Terms) -> Fin (length p) -> T.Term = split {
  nil -> \ i -> efq i ; cons t p | rec -> snoc (Fin (length p)) T.Term rec t } ;
 away (u : E.Exponent n) : (p : T.Terms) -> T.Away u p ->
  (i : Fin (length p)) -> Not (Id (E.Exponent n) u (at p i).2) = split {
   nil -> \ hp i -> efq i ;
   cons t p | rec -> \ hp -> AffineFinite[l].section (length p)
    (\ i -> Not (Id (E.Exponent n) u (at (cons t p) i).2)) (rec hp.2) hp.1 } ;
 indexed-keeps (K : A.R -> U l) : (p : T.Terms) -> T.Keeps K p -> (i : Fin (length p)) -> K (at p i).1 = split {
  nil -> \ hp i -> efq i ;
  cons t p | rec -> \ hp -> AffineFinite[l].section (length p)
   (\ i -> K (at (cons t p) i).1) (rec hp.2) hp.1 } ;
 module DistinctStep (t : T.Term) (p : T.Terms) (hp : T.Away t.2 p)
  (rec : (i j : Fin (length p)) -> Id (E.Exponent n) (at p i).2 (at p j).2 -> Id (Fin (length p)) i j) {
  result : (i j : Fin (suc (length p))) ->
   Id (E.Exponent n) (at (cons t p) i).2 (at (cons t p) j).2 -> Id (Fin (suc (length p))) i j = split {
    inl i -> split {
     inl j -> \ eq -> ap (\ k -> inl k) (rec i j eq) ;
     inr u -> \ eq -> efq (away t.2 p hp i (sym eq)) } ;
    inr u -> split {
     inl j -> \ eq -> efq (away t.2 p hp j eq) ;
     inr v -> \ eq -> ap (\ w -> inr w) (T.P.top-prop u v) } } ;
 } ;
 indexed-distinct : (p : T.Terms) -> T.Unique p -> (i j : Fin (length p)) ->
  Id (E.Exponent n) (at p i).2 (at p j).2 -> Id (Fin (length p)) i j = split {
   nil -> \ hp i j eq -> efq i ;
   cons t p | rec -> \ hp -> DistinctStep[t,p,hp.1,rec hp.2].result } ;
 module At (B : T.C.Algebra) (x : Fin n -> B.ring.R) {
  module V = T.At[B,x] ; module S = FiniteIdeal[l].Sums[B.ring] ;
  value : (p : T.Terms) -> Id B.ring.R (V.value p) (S.sum (length p) (\ i -> V.term (at p i))) = split {
   nil -> refl B.ring.z ; cons t p | rec -> ap (B.ring.add (V.term t)) rec } ;
 } ;
 module Keep (K : A.R -> U l) {
  module N = MonomialNormalize[l].Over[A,setA,n] ; module NK = N.Keep[K] ;
  record SparseData (e : T.P.Expr (Fin n)) {
   size : Nat ;
   coefficient : Fin size -> A.R ;
   exponent : Fin size -> E.Exponent n ;
   keep (i : Fin size) : K (coefficient i) ;
   distinct (i j : Fin size) : Id (E.Exponent n) (exponent i) (exponent j) -> Id (Fin size) i j ;
   value (B : T.C.Algebra) (x : Fin n -> B.ring.R) :
    Id B.ring.R (T.P.eval (Fin n) B x e)
     (FiniteIdeal[l].Sums[B.ring].sum size
      (\ j -> B.ring.mul (B.iota.1 (coefficient j)) (MonomialEvaluation[l].Over[B.ring].monomial n x (exponent j)))) ;
  } ;
  -- The filter of the coalesced expansion of e, read as sparse data.
  module For (e : T.P.Expr (Fin n)) (f : NK.Filtered (N.coalesce (T.raw e))) {
   list : T.Terms = f.1 ;
   size : Nat = length list ;
   coefficient (i : Fin size) : A.R = (at list i).1 ;
   exponent (i : Fin size) : E.Exponent n = (at list i).2 ;
   keep (i : Fin size) : K (coefficient i) = indexed-keeps K list f.2.2.2.1 i ;
   distinct (i j : Fin size) : Id (E.Exponent n) (exponent i) (exponent j) -> Id (Fin size) i j =
    indexed-distinct list (f.2.2.1 (N.coalesce-unique (T.raw e))) i j ;
   sound (B : T.C.Algebra) (x : Fin n -> B.ring.R) :
    Id B.ring.R (T.P.eval (Fin n) B x e) (T.At[B,x].value list) =
    trans (T.At[B,x].sound e) (sym (trans (f.2.2.2.2 B x) (N.At[B,x].coalesce-value (T.raw e)))) ;
   value (B : T.C.Algebra) (x : Fin n -> B.ring.R) :
    Id B.ring.R (T.P.eval (Fin n) B x e)
     (FiniteIdeal[l].Sums[B.ring].sum size
      (\ j -> B.ring.mul (B.iota.1 (coefficient j)) (MonomialEvaluation[l].Over[B.ring].monomial n x (exponent j)))) =
    trans (sound B x) (At[B,x].value list) ;
   result : SparseData[e] = new SparseData[e,size,coefficient,exponent,keep,distinct,value] ;
  } ;
  module Given (decide : (a : A.R) -> NK.Decision a) {
   expand (e : T.P.Expr (Fin n)) : SparseData[e] = For[e,NK.Given[decide].filtered (N.coalesce (T.raw e))].result ;
  } ;
  module Mere (decide : (a : A.R) -> Tr.Trunc[NK.Decision a].carrier) {
   expand (e : T.P.Expr (Fin n)) : TH.Trunc[SparseData[e]].carrier =
    THC.map (NK.Filtered (N.coalesce (T.raw e))) SparseData[e] (\ f -> For[e,f].result)
     (NK.Mere[decide].filtered (N.coalesce (T.raw e))) ;
  } ;
 } ;
} ;
