-- Computed examples over the nonreduced ring Z/4.  They test duplicate
-- collection, cancellation, zero-divisor coefficients, mixed exponents,
-- and the structural nonempty relation at N=0 and N=1.
level l ; open Ring[l] ; open Presentations[l] ;
module Z = ZMod4[l] ; open Z ;
A : CRing = Z.ring ;
zero-dec : (a : A.R) -> Plus (Id A.R a A.z) (Not (Id A.R a A.z)) = split {
 q0 -> inl (refl q0) ;
 q1 -> inr (\ eq -> subst (Z.code q1) eq tt) ;
 q2 -> inr (\ eq -> subst (Z.code q2) eq tt) ;
 q3 -> inr (\ eq -> subst (Z.code q3) eq tt) } ;
one-nonzero : Not (Id A.R A.o A.z) = \ eq -> subst (Z.code q1) eq tt ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ;
module C = Algebras[l].Over[A,Z.set] ; module P = Presentations[l].Over[A,Z.set] ;
module F = MonomialFamily[l].Over[A,Z.set,two].Normalized[zero-dec] ;
i0 : Fin two = inl (inr tt) ; i1 : Fin two = inr tt ;
x : P.Expr (Fin two) = var i0 ; y : P.Expr (Fin two) = var i1 ;
linear : P.Expr (Fin two) = sumE x y ;
square : P.Expr (Fin two) = mulE linear linear ;
sq : F.SparseData[square] = F.expand square ;
square-size : Id Nat sq.size three = refl three ;
square-mixed-coefficient : Id A.R (sq.coefficient (inl (inr tt))) q2 = refl q2 ;
square-mixed-x : Id Nat (sq.exponent (inl (inr tt)) i0) one = refl one ;
square-mixed-y : Id Nat (sq.exponent (inl (inr tt)) i1) one = refl one ;
point : Fin two -> A.R = snoc (Fin one) A.R (\ i -> q2) q1 ;
square-value : Id A.R (P.eval (Fin two) C.base point square) q1 = refl q1 ;
square-sound : Id A.R q1
 (FiniteIdeal[l].Sums[A].sum sq.size (\ j -> A.mul (sq.coefficient j)
   (MonomialEvaluation[l].Over[A].monomial two point (sq.exponent j)))) = sq.value C.base point ;
cancel : P.Expr (Fin two) = sumE x (mulE (cst q3) x) ;
cancel-size : Id Nat (F.expand cancel).size zero = refl zero ;
zero-divisor : P.Expr (Fin two) = mulE (mulE (cst q2) x) (mulE (cst q2) y) ;
zero-divisor-size : Id Nat (F.expand zero-divisor).size zero = refl zero ;
module Constant = MonomialFamily[l].Over[A,Z.set,zero].Normalized[zero-dec] ;
constant-size : Id Nat (Constant.expand (sumE (cst q1) (cst q3))).size zero = refl zero ;
module D = MonomialDifference[l].Over[A,Z.set,one,zero-dec,one-nonzero] ;
module EmptyRelation = D.At[zero,cst q0,F.expand (cst q0)] ;
empty-relation-size : Id Nat EmptyRelation.sparse.size one = refl one ;
empty-relation-leading : Id A.R (EmptyRelation.sparse.coefficient EmptyRelation.distinguished) q1 = EmptyRelation.leading-coefficient ;
empty-relation-degree : Id Nat (EmptyRelation.sparse.exponent EmptyRelation.distinguished i1) zero = refl zero ;
module Relation = D.At[one,linear,F.expand linear] ;
relation-size : Id Nat Relation.sparse.size three = refl three ;
relation-leading : Id A.R (Relation.sparse.coefficient Relation.distinguished) q1 = Relation.leading-coefficient ;
relation-tail-sign : Id A.R (Relation.sparse.coefficient (inl (inr tt))) q3 = refl q3 ;
relation-leading-degree : Id Nat (Relation.sparse.exponent Relation.distinguished i1) one = refl one ;
relation-tail-degree : Id Nat (Relation.sparse.exponent (inl (inr tt)) i1) three = refl three ;
relation-value : Id A.R (P.eval (Fin two) C.base point Relation.expression) q2 = refl q2 ;
relation-sound : Id A.R q2
 (FiniteIdeal[l].Sums[A].sum Relation.sparse.size (\ j -> A.mul (Relation.sparse.coefficient j)
   (MonomialEvaluation[l].Over[A].monomial two point (Relation.sparse.exponent j)))) = Relation.sparse.value C.base point ;
