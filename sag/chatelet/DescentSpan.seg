-- Step 2: membership in the span of a fixed finite family is a sheaf.
-- Lift the local coefficients on the root affine using the QC kernel,
-- then take the coefficient of 1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module DM = DescentModules[l].Over[R,setR,axioms] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module At (M : MD.Module) (modal : ET.T.isModal @l M.M)
  (sh : [j] SheafClosure[l,j].Over[ET.I,ET.G].Ops)
  (rank : Nat) (local : (sh @l).close (DL.On[M].Frame rank)) {
  module LM = DL.On[M] ;
  module Fractions = DescentFractions[l].Over[R,setR,axioms].At[M,modal,sh,rank,local] ;
  module Family (n : Nat) (w : Fin n -> M.M) {
   Witness (m : M.M) : U l = (c : (DL.Free n).M) * Id M.M (LM.lin n w c) m ;
   Span (m : M.M) : U l = Tr.Trunc[Witness m].carrier ;
   module SM = DescentSubmodules[l].Over[MD.ring] ;
   linear : SM.Linear (DL.Free n) M = (LM.lin n w,LM.lin-add n w,LM.lin-scale n w) ;
   module Image = SM.Image[DL.Free n,M,linear] ;
   generator (j : Fin n) : Span (w j) =
    Tr.Trunc[Witness (w j)].inc (\ k -> DL.D.delta n k j,LM.lin-unit n w j) ;
   span-zero : Span M.mz = Image.sub.zero ;
   span-add (u v : M.M) : Span u -> Span v -> Span (M.madd u v) = Image.sub.add u v ;
   span-scale (a : R.R) (u : M.M) : Span u -> Span (M.sm a u) = Image.sub.scale a u ;
   span-sum : (k : Nat) (v : Fin k -> M.M) -> ((j : Fin k) -> Span (v j)) -> Span (LM.S.sum k v) = split {
    zero -> \ v hv -> span-zero ;
    suc k | ih -> \ v hv -> span-add (v (inr tt)) (LM.S.sum k (\ j -> v (inl j)))
     (hv (inr tt)) (ih (\ j -> v (inl j)) (\ j -> hv (inl j))) } ;
   span-lin (k : Nat) (v : Fin k -> M.M) (c : (DL.Free k).M) (hv : (j : Fin k) -> Span (v j)) : Span (LM.lin k v c) =
    Pr.subst M.M Span _ _ (sym (LM.lin-value k v c))
     (span-sum k (\ j -> M.sm (c j) (v j)) (\ j -> span-scale (c j) (v j) (hv j))) ;
   module Lifted = DescentLift[l].Over[R,setR,axioms].At[DL.Free n,M,linear,DM.free-qc n,Fractions.qc] ;
   module Generator (idx : ET.I) (m : M.M) (h : ET.G idx -> Span m) {
    module E = DescentEvaluation[l].Over[R,setR,axioms].Generator[idx] ;
    module A = DescentAverage[l].Over[R,setR,axioms].Generator[idx].At[M,E.At[M,modal,sh,rank,local].equivalence] ;
    module G = DescentQC[l].Over[R,setR,axioms].At[M,modal].Generator[idx] ;
    module L = Lifted.Solutions[E.X,G.affine,\ x -> m,\ x -> h (ET.root-inc idx x)] ;
    module Chosen (z : (x : E.X) -> L.T x) {
     a (x : E.X) : (DL.Free n).M = (z x).1 ;
     terms (j : Fin n) (x : E.X) : M.M = M.sm (a x j) (w j) ;
     module Eval (x : E.X) {
      module H = DL.Hom[A.L.Q,M,\ u -> u x,
       \ u v -> refl (M.madd (u x) (v x)),\ r u -> refl (M.sm r (u x))] ;
     } ;
     total : A.L.Q.M = A.H.LM.S.sum n terms ;
     total-equation : Id A.L.Q.M total (\ x -> m) =
      F.funext E.X (\ x -> M.M) total (\ x -> m) (\ x ->
       trans (Eval[x].H.sum n terms)
        (trans (sym (LM.lin-value n w (a x))) (z x).2)) ;
     coefficients (j : Fin n) : R.R = E.scalar-equiv.sec (\ x -> a x j) DescentAverage[l].Over[R,setR,axioms].Generator[idx].last ;
     result : Witness m = (coefficients,
      trans (LM.lin-value n w coefficients)
       (trans (sym (LM.S.congruent n (\ j -> A.average (terms j))
         (\ j -> M.sm (coefficients j) (w j)) (\ j -> A.weighted (\ x -> a x j) (w j))))
        (trans (sym (A.H.sum n terms))
         (trans (ap A.average total-equation) (A.constant m))))) ;
    } ;
    result : Span m = Tr.Trunc[(x : E.X) -> L.T x].induction @l
     (\ z -> Span m) (\ z -> Tr.Trunc[Witness m].proposition)
     (\ z -> Tr.Trunc[Witness m].inc Chosen[z].result) L.theorem ;
   } ;
   span-modal (m : M.M) : ET.T.isModal @l (Span m) =
    SL.modal-of-sec (Span m) Tr.Trunc[Witness m].proposition (\ idx h -> Generator[idx,m,h].result) ;
   opaque span-modal ;
  } ;
 } ;
} ;
