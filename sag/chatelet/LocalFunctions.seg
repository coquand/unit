-- Functions on a standard open D(f) of Spec A, A finitely presented, by SQC
-- for the localisation A[1/f]:
--   rep:    every phi : D(f) -> R is merely x |-> x(a) / x(f)^N;
--   vanish: if x(a) = 0 for every x in D(f), then merely f^N a = 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module LF = LocalizationFractions[l].Over[R,setR] ;
 module LK = LocalizationKernel[l].Over[R,setR] ;
 module RP = AffinePowers[l].Over[R] ;
 module At (A : C.Algebra) (fp : P.FP A) (f : A.ring.R) {
  module AP = AffinePowers[l].Over[A.ring] ;
  module K = LocalizationKernel[l].Relative[A.ring,A.set,f] ;
  Dom : U l = I.D A f ;
  ev (x : Dom) (a : A.ring.R) : R.R = x.1.1.1 a ;
  Rep (phi : Dom -> R.R) : U l =
   (a : A.ring.R) * (N : Nat) * ((x : Dom) -> Id R.R (ev x a) (R.mul (RP.power (ev x f) N) (phi x))) ;
  module WithLoc (loc : I.LocalizationWitness A f) {
   L : C.Algebra = loc.1 ;
   inc : C.Hom A L = loc.2.2.1 ;
   sp : Pr.Equiv (C.Spec L) Dom = I.spectrum A f loc ;
   e : Pr.isEquiv L.ring.R (C.Spec L -> R.R) (C.evaluation L) = sqc L loc.2.1 ;
   sigma (x : Dom) : C.Spec L = sp.2.sec x ;
   -- x(a) is the value at sigma x of the image of a
   through (x : Dom) (a : A.ring.R) : Id R.R (ev x a) ((sigma x).1.1 (inc.1.1 a)) =
    ap (\ y -> ev y a) (sym (sp.2.sec-eq x)) ;
   module Represent (phi : Dom -> R.R) {
    values (s : C.Spec L) : R.R = phi (sp.1 s) ;
    element : L.ring.R = e.sec values ;
    value (x : Dom) : Id R.R ((sigma x).1.1 element) (phi x) =
     trans (Pr.happly (C.Spec L) (\ s -> R.R) _ _ (e.sec-eq values) (sigma x)) (ap phi (sp.2.sec-eq x)) ;
    from-form (w : LF.Form A f loc element) : Rep phi =
     (w.1,w.2.1,\ x -> calc R.R {
      ev x w.1 =< through x w.1 > (sigma x).1.1 (inc.1.1 w.1)
       =< ap (sigma x).1.1 w.2.2 > (sigma x).1.1 (L.ring.mul (AffinePowers[l].Over[L.ring].power (inc.1.1 f) w.2.1) element)
       =< (sigma x).1.2.2.2 _ element > R.mul ((sigma x).1.1 (AffinePowers[l].Over[L.ring].power (inc.1.1 f) w.2.1)) ((sigma x).1.1 element)
       =< Presentations[l].cong2 R.R R.mul _ _ _ _
         (trans (AffinePowers[l].power-map L.ring R (sigma x).1 (inc.1.1 f) w.2.1)
          (ap (\ t -> RP.power t w.2.1) (sym (through x f))))
         (value x)
       > R.mul (RP.power (ev x f) w.2.1) (phi x) }) ;
    result : Tr.Trunc[Rep phi].carrier =
     Tr.Trunc[LF.Form A f loc element].induction @l (\ t -> Tr.Trunc[Rep phi].carrier)
      (\ t -> Tr.Trunc[Rep phi].proposition) (\ w -> Tr.Trunc[Rep phi].inc (from-form w))
      (LF.fractions A fp f loc element) ;
   } ;
   module Vanishes (a : A.ring.R) (v : (x : Dom) -> Id R.R (ev x a) R.z) {
    values (s : C.Spec L) : Id R.R (s.1.1 (inc.1.1 a)) (s.1.1 L.ring.z) =
     trans (v (sp.1 s)) (sym (RingHom[l].zero L.ring R s.1)) ;
    vanishes : Id L.ring.R (inc.1.1 a) L.ring.z =
     trans (sym (Pr.sec-ret _ _ (C.evaluation L) e (inc.1.1 a)))
      (trans (ap e.sec (F.funext (C.Spec L) (\ s -> R.R)
         (C.evaluation L (inc.1.1 a)) (C.evaluation L L.ring.z) values))
       (Pr.sec-ret _ _ (C.evaluation L) e L.ring.z)) ;
    result : K.Vanishes a = LK.At[A,loc.1,f,loc.2.2.1,loc.2.2.2].clear a vanishes ;
   } ;
  } ;
  rep (phi : Dom -> R.R) : Tr.Trunc[Rep phi].carrier =
   Tr1.Trunc[I.LocalizationWitness A f].induction @l (\ t -> Tr.Trunc[Rep phi].carrier)
    (\ t -> Tr.Trunc[Rep phi].proposition) (\ loc -> WithLoc[loc].Represent[phi].result) (I.localize A fp f) ;
  vanish (a : A.ring.R) (v : (x : Dom) -> Id R.R (ev x a) R.z) : K.Vanishes a =
   Tr1.Trunc[I.LocalizationWitness A f].induction @l (\ t -> K.Vanishes a)
    (\ t -> Tr.Trunc[(n : Nat) * Id A.ring.R (A.ring.mul (AP.power f n) a) A.ring.z].proposition)
    (\ loc -> WithLoc[loc].Vanishes[a,v].result) (I.localize A fp f) ;
 } ;
} ;
