-- Fractions at an arbitrary multiplicative monoid, with explicit
-- annihilator witnesses. Membership need not be decidable or a proposition.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (S : A.R -> U l) (one : S A.o)
 (product : (s t : A.R) -> S s -> S t -> S (A.mul s t)) {
 open A ; open RL[A] ;
 module Tr = Truncation[l] ;
 module L = LocalizationIdentities[l].Laws[A] ;
 Fraction : U l = (a s : R) * S s ;
 numerator (x : Fraction) : R = x.1 ;
 denominator (x : Fraction) : R = x.2.1 ;
 addF (x y : Fraction) : Fraction =
  (add (mul x.1 y.2.1) (mul y.1 x.2.1),mul x.2.1 y.2.1,product x.2.1 y.2.1 x.2.2 y.2.2) ;
 mulF (x y : Fraction) : Fraction =
  (mul x.1 y.1,mul x.2.1 y.2.1,product x.2.1 y.2.1 x.2.2 y.2.2) ;
 negF (x : Fraction) : Fraction = (neg x.1,x.2.1,x.2.2) ;
 constantF (a : R) : Fraction = (a,o,one) ;
 Witness (x y : Fraction) : U l =
  (u : R) * S u * Id R (mul u (mul x.1 y.2.1)) (mul u (mul y.1 x.2.1)) ;
 Relation (x y : Fraction) : U l = Tr.Trunc[Witness x y].carrier ;
 proposition (x y : Fraction) : Prelude[l].isProp (Relation x y) = Tr.Trunc[Witness x y].proposition ;
 Exact (x y : Fraction) : U l = Id R (mul x.1 y.2.1) (mul y.1 x.2.1) ;
 exact (x y : Fraction) (eq : Exact x y) : Relation x y =
  Tr.Trunc[Witness x y].inc (o,one,ap (mul o) eq) ;
 reflexive (x : Fraction) : Relation x x = exact x x (refl (mul x.1 x.2.1)) ;
 symmetric (x y : Fraction) : Relation x y -> Relation y x =
  Tr.Trunc[Witness x y].induction @l
   (\ w -> Relation y x) (\ w -> proposition y x)
   (\ w -> Tr.Trunc[Witness y x].inc (w.1,w.2.1,sym w.2.2)) ;
 join (x y z1 : Fraction) (h : Witness x y) (k : Witness y z1) : Witness x z1 =
  (mul (mul h.1 k.1) y.2.1,product (mul h.1 k.1) y.2.1 (product h.1 k.1 h.2.1 k.2.1) y.2.2,
   trans (L.trans-left h.1 k.1 y.2.1 x.1 z1.2.1)
    (trans (ap (mul (mul k.1 z1.2.1)) h.2.2)
     (trans (L.trans-middle h.1 k.1 y.1 x.2.1 z1.2.1)
      (trans (ap (mul (mul h.1 x.2.1)) k.2.2)
       (L.trans-right h.1 k.1 y.2.1 z1.1 x.2.1))))) ;
 transitive (x y z1 : Fraction) (h : Relation x y) (k : Relation y z1) : Relation x z1 =
  Tr.Trunc[Witness x y].induction @l
   (\ w -> Relation x z1) (\ w -> proposition x z1)
   (\ w -> Tr.Trunc[Witness y z1].induction @l
    (\ v -> Relation x z1) (\ v -> proposition x z1)
    (\ v -> Tr.Trunc[Witness x z1].inc (join x y z1 w v)) k) h ;
 add-witness (x x1 y y1 : Fraction) (h : Witness x x1) (k : Witness y y1) :
  Witness (addF x y) (addF x1 y1) =
  (mul h.1 k.1,product h.1 k.1 h.2.1 k.2.1,
   trans (L.add-respect-left h.1 k.1 x.1 y.1 x.2.1 y.2.1 x1.2.1 y1.2.1)
    (trans (cong2 R add _ _ _ _
      (ap (mul (mul (mul k.1 y.2.1) y1.2.1)) h.2.2)
      (ap (mul (mul (mul h.1 x.2.1) x1.2.1)) k.2.2))
     (L.add-respect-right h.1 k.1 x1.1 y1.1 x.2.1 y.2.1 x1.2.1 y1.2.1))) ;
 mul-witness (x x1 y y1 : Fraction) (h : Witness x x1) (k : Witness y y1) :
  Witness (mulF x y) (mulF x1 y1) =
  (mul h.1 k.1,product h.1 k.1 h.2.1 k.2.1,
   trans (L.mul-respect h.1 k.1 x.1 y.1 x1.2.1 y1.2.1)
    (trans (cong2 R mul _ _ _ _ h.2.2 k.2.2)
     (sym (L.mul-respect h.1 k.1 x1.1 y1.1 x.2.1 y.2.1)))) ;
 module Binary (op : Fraction -> Fraction -> Fraction)
  (combine : (x x1 y y1 : Fraction) -> Witness x x1 -> Witness y y1 -> Witness (op x y) (op x1 y1)) {
  respects (x x1 y y1 : Fraction) (h : Relation x x1) (k : Relation y y1) : Relation (op x y) (op x1 y1) =
   Tr.Trunc[Witness x x1].induction @l
    (\ w -> Relation (op x y) (op x1 y1)) (\ w -> proposition (op x y) (op x1 y1))
    (\ w -> Tr.Trunc[Witness y y1].induction @l
     (\ v -> Relation (op x y) (op x1 y1)) (\ v -> proposition (op x y) (op x1 y1))
     (\ v -> Tr.Trunc[Witness (op x y) (op x1 y1)].inc (combine x x1 y y1 w v)) k) h ;
 } ;
 negative-left (a b : R) : Id R (mul (neg a) b) (neg (mul a b)) =
  trans (mulC (neg a) b) (trans (mul-neg b a) (ap neg (mulC b a))) ;
 negative-scaled (u a b : R) : Id R (mul u (mul (neg a) b)) (neg (mul u (mul a b))) =
  trans (ap (mul u) (negative-left a b)) (mul-neg u (mul a b)) ;
 neg-respects (x y : Fraction) : Relation x y -> Relation (negF x) (negF y) =
  Tr.Trunc[Witness x y].induction @l
   (\ w -> Relation (negF x) (negF y)) (\ w -> proposition (negF x) (negF y))
   (\ w -> Tr.Trunc[Witness (negF x) (negF y)].inc
    (w.1,w.2.1,trans (negative-scaled w.1 x.1 y.2.1)
     (trans (ap neg w.2.2) (sym (negative-scaled w.1 y.1 x.2.1))))) ;
 add-assoc (x y z1 : Fraction) : Relation (addF x (addF y z1)) (addF (addF x y) z1) =
  exact (addF x (addF y z1)) (addF (addF x y) z1) (L.add-assoc x.1 y.1 z1.1 x.2.1 y.2.1 z1.2.1) ;
 add-comm (x y : Fraction) : Relation (addF x y) (addF y x) =
  exact (addF x y) (addF y x) (L.add-comm x.1 y.1 z x.2.1 y.2.1 o) ;
 add-zero (x : Fraction) : Relation (addF x (constantF z)) x =
  exact (addF x (constantF z)) x (L.add-zero x.1 z z x.2.1 o o) ;
 add-neg (x : Fraction) : Relation (addF x (negF x)) (constantF z) =
  exact (addF x (negF x)) (constantF z)
   (trans (mulO (add (mul x.1 x.2.1) (mul (neg x.1) x.2.1)))
    (trans (ap (add (mul x.1 x.2.1)) (negative-left x.1 x.2.1))
     (trans (addN (mul x.1 x.2.1)) (sym (zero-mul (mul x.2.1 x.2.1)))))) ;
 mul-assoc (x y z1 : Fraction) : Relation (mulF x (mulF y z1)) (mulF (mulF x y) z1) =
  exact (mulF x (mulF y z1)) (mulF (mulF x y) z1) (L.mul-assoc x.1 y.1 z1.1 x.2.1 y.2.1 z1.2.1) ;
 mul-comm (x y : Fraction) : Relation (mulF x y) (mulF y x) =
  exact (mulF x y) (mulF y x) (L.mul-comm x.1 y.1 z x.2.1 y.2.1 o) ;
 mul-one (x : Fraction) : Relation (mulF x (constantF o)) x =
  exact (mulF x (constantF o)) x (L.mul-one x.1 z z x.2.1 o o) ;
 distributive (x y z1 : Fraction) : Relation (mulF x (addF y z1)) (addF (mulF x y) (mulF x z1)) =
  exact (mulF x (addF y z1)) (addF (mulF x y) (mulF x z1)) (L.distributive x.1 y.1 z1.1 x.2.1 y.2.1 z1.2.1) ;
 constant-add (a b : R) : Relation (constantF (add a b)) (addF (constantF a) (constantF b)) =
  exact (constantF (add a b)) (addF (constantF a) (constantF b)) (L.constant-add a b z o o o) ;
 constant-mul (a b : R) : Relation (constantF (mul a b)) (mulF (constantF a) (constantF b)) =
  exact (constantF (mul a b)) (mulF (constantF a) (constantF b)) (L.constant-mul a b z o o o) ;
 inverse (s : R) (hs : S s) : Relation (mulF (constantF s) (o,s,hs)) (constantF o) =
  exact (mulF (constantF s) (o,s,hs)) (constantF o) (L.inverse s z z o o o) ;
} ;
