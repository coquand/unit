-- Worker B's deliverable: the three algebraic fields of the Picard
-- interface, from the common SAG assumptions (Loc and uniform SQC; Z-choice
-- is not used).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sag : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module PI = PicardInterface[l].Over[R,setR] ;
 results : PI.AlgebraResults = new PI.AlgebraResults[
  Factorisation[l].Over[R,setR,sag.sqc,sag.loc].factorisation,
  DegreeUnique[l].Over[R,setR,sag.sqc,sag.loc.1].degree-unique,
  ChartIntersection[l].Over[R,setR,sag.sqc].intersection] ;
} ;
