-- The coefficient of 1 gives a linear retraction M^Root -> M.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module EQ = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module Generator (idx : ET.I) {
  module E = DescentEvaluation[l].Over[R,setR,axioms].Generator[idx] ;
  module Gen = EtaleRoots[l].Over[R,setR].Generator[idx] ;
  module B = E.B ;
  last : Fin E.d = inr tt ;
  ones : Fin E.d -> R.R = B.coords (B.A.iota.1 R.o) ;
  ones-last : Id R.R (ones last) R.o = Gen.Positive.coords-constant R.o last ;
  ones-value (x : E.X) : Id R.R (E.scalar ones x) R.o =
   trans (E.scalar-value ones x)
    (trans (ap (\ a -> E.value a x) (B.expansion-coords (B.A.iota.1 R.o))) ((E.Roots.spec-root.2.sec x).2 R.o)) ;
  module At (M : MD.Module) (equiv : E.Claim M) {
   module L = E.Linear[M] ; module LM = DL.On[M] ;
   coefficients (h : L.Q.M) : L.P.M = equiv.sec h ;
   equation (h : L.Q.M) : Id L.Q.M (E.evaluate M (coefficients h)) h = equiv.sec-eq h ;
   unique (u v : L.P.M) : Id L.Q.M (E.evaluate M u) (E.evaluate M v) -> Id L.P.M u v =
    EQ.injective L.P.M L.Q.M (E.evaluate M) equiv u v ;
   add (h k : L.Q.M) : Id L.P.M (coefficients (L.Q.madd h k)) (L.P.madd (coefficients h) (coefficients k)) =
    unique (coefficients (L.Q.madd h k)) (L.P.madd (coefficients h) (coefficients k))
     (trans (equation (L.Q.madd h k))
      (sym (trans (L.add (coefficients h) (coefficients k))
       (cong2 L.Q.M L.Q.madd _ _ _ _ (equation h) (equation k))))) ;
   scale (a : R.R) (h : L.Q.M) : Id L.P.M (coefficients (L.Q.sm a h)) (L.P.sm a (coefficients h)) =
    unique (coefficients (L.Q.sm a h)) (L.P.sm a (coefficients h))
     (trans (equation (L.Q.sm a h))
      (sym (trans (L.scale a (coefficients h)) (ap (L.Q.sm a) (equation h))))) ;
   average (h : L.Q.M) : M.M = coefficients h last ;
   average-add (h k : L.Q.M) : Id M.M (average (L.Q.madd h k)) (M.madd (average h) (average k)) =
    ap (\ v -> v last) (add h k) ;
   average-scale (a : R.R) (h : L.Q.M) : Id M.M (average (L.Q.sm a h)) (M.sm a (average h)) =
    ap (\ v -> v last) (scale a h) ;
   constant (m : M.M) : Id M.M (average (\ x -> m)) m =
    trans (ap (\ v -> v last)
      (unique (coefficients (\ x -> m)) (\ t -> M.sm (ones t) m)
       (trans (equation (\ x -> m))
        (sym (F.funext E.X (\ x -> M.M) _ _ (\ x ->
         trans (E.tensor M ones m x) (trans (ap (\ a -> M.sm a m) (ones-value x)) (M.smO m))))))))
     (trans (ap (\ a -> M.sm a m) ones-last) (M.smO m)) ;
   weighted (a : E.X -> R.R) (m : M.M) :
    Id M.M (average (\ x -> M.sm (a x) m)) (M.sm (E.scalar-equiv.sec a last) m) =
    ap (\ v -> v last)
     (unique (coefficients (\ x -> M.sm (a x) m)) (\ t -> M.sm (E.scalar-equiv.sec a t) m)
      (trans (equation (\ x -> M.sm (a x) m))
       (sym (F.funext E.X (\ x -> M.M) _ _ (\ x ->
        trans (E.tensor M (E.scalar-equiv.sec a) m x)
         (ap (\ c -> M.sm c m) (Pr.happly E.X (\ y -> R.R) _ a (E.scalar-equiv.sec-eq a) x))))))) ;
   module H = DL.Hom[L.Q,M,average,average-add,average-scale] ;
   opaque coefficients ; opaque average ;
  } ;
 } ;
} ;
