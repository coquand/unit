-- Every function phi on the units is a Laurent polynomial: merely a
-- polynomial p and N with p(x) = x^N phi(x).  By SQC for R[X][1/X], whose
-- points are the units, phi is an element of the localization, and every
-- element of it is a fraction p/X^N.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module CI = ChartIntersection[l].Over[R,setR,sqc] ;
 module UV = CI.UV ;
 module C = UV.C ;
 module I = UV.I ;
 module X = UV.X ;
 module Raw = UV.Raw ;
 module G = PicardUnits[l].Over[R,setR] ;
 module Pow = AffinePowers[l].Over[R] ;
 module LF = LocalizationFractions[l].Over[R,setR] ;
 RX : C.Algebra = UV.RX.algebra ;
 Rep (phi : G.Unit -> R.R) : U l =
  (p : Raw.P) * (N : Nat) * ((u : G.Unit) -> Id R.R (Raw.ev p u.1) (R.mul (Pow.power u.1 N) (phi u))) ;
 module At (phi : G.Unit -> R.R) (loc : I.LocalizationWitness RX X.variable) {
  inc : C.Hom RX loc.1 = loc.2.2.1 ;
  xinv : RL[loc.1.ring].unit (inc.1.1 X.variable) = loc.2.2.2.1 ;
  sp : Pr.Equiv (C.Spec loc.1) (I.D RX X.variable) = I.spectrum RX X.variable loc ;
  e : Pr.isEquiv loc.1.ring.R (C.Spec loc.1 -> R.R) (C.evaluation loc.1) = sqc loc.1 loc.2.1 ;
  unit-of (s : C.Spec loc.1) : G.Unit =
   (s.1.1 (inc.1.1 X.variable),AffineRing[l].unit-map loc.1.ring R s.1 (inc.1.1 X.variable) xinv) ;
  values (s : C.Spec loc.1) : R.R = phi (unit-of s) ;
  element : loc.1.ring.R = e.sec values ;
  d-point (u : G.Unit) : I.D RX X.variable =
   (CI.point u.1,Pr.subst R.R RL[R].unit u.1 ((CI.point u.1).1.1 X.variable) (sym (CI.point-variable u.1)) u.2) ;
  sigma (u : G.Unit) : C.Spec loc.1 = sp.2.sec (d-point u) ;
  sigma-inc (u : G.Unit) : Id (C.Hom RX C.base) (C.compose RX loc.1 C.base (sigma u) inc) (CI.point u.1) =
   ap (\ d -> d.1) (sp.2.sec-eq (d-point u)) ;
  sigma-X (u : G.Unit) : Id R.R ((sigma u).1.1 (inc.1.1 X.variable)) u.1 =
   trans (ap (\ g -> g.1.1 X.variable) (sigma-inc u)) (CI.point-variable u.1) ;
  value (u : G.Unit) : Id R.R ((sigma u).1.1 element) (phi u) =
   trans (Pr.happly (C.Spec loc.1) (\ s -> R.R) _ _ (e.sec-eq values) (sigma u))
    (ap phi (G.eq (unit-of (sigma u)) u (sigma-X u))) ;
  from-form (w : LF.Form RX X.variable loc element) (p : Raw.P) (hp : Id X.Carrier (X.include p) w.1) : Rep phi =
   (p,w.2.1,\ u -> calc R.R {
    Raw.ev p u.1
     =< ap (Raw.ev p) (sym (sigma-X u)) > Raw.ev p ((sigma u).1.1 (inc.1.1 X.variable))
     =< sym (UV.at-point (C.compose RX loc.1 C.base (sigma u) inc) p) > (sigma u).1.1 (inc.1.1 (X.include p))
     =< ap (\ a -> (sigma u).1.1 (inc.1.1 a)) hp > (sigma u).1.1 (inc.1.1 w.1)
     =< ap (sigma u).1.1 w.2.2
     > (sigma u).1.1 (loc.1.ring.mul (AffinePowers[l].Over[loc.1.ring].power (inc.1.1 X.variable) w.2.1) element)
     =< (sigma u).1.2.2.2 (AffinePowers[l].Over[loc.1.ring].power (inc.1.1 X.variable) w.2.1) element
     > R.mul ((sigma u).1.1 (AffinePowers[l].Over[loc.1.ring].power (inc.1.1 X.variable) w.2.1)) ((sigma u).1.1 element)
     =< Presentations[l].cong2 R.R R.mul _ _ _ _
       (trans (AffinePowers[l].power-map loc.1.ring R (sigma u).1 (inc.1.1 X.variable) w.2.1)
        (ap (\ t -> Pow.power t w.2.1) (sigma-X u)))
       (value u)
     > R.mul (Pow.power u.1 w.2.1) (phi u) }) ;
  from-fraction (w : LF.Form RX X.variable loc element) : Tr.Trunc[Rep phi].carrier =
   X.Q.induction @l (\ c -> Id X.Carrier c w.1 -> Tr.Trunc[Rep phi].carrier)
    (\ c -> F.isProp-Pi (Id X.Carrier c w.1) (\ h -> Tr.Trunc[Rep phi].carrier)
      (\ h -> Tr.Trunc[Rep phi].proposition))
    (\ p hp -> Tr.Trunc[Rep phi].inc (from-form w p hp)) w.1 (refl w.1) ;
  result : Tr.Trunc[Rep phi].carrier =
   Tr.Trunc[LF.Form RX X.variable loc element].induction @l (\ t -> Tr.Trunc[Rep phi].carrier)
    (\ t -> Tr.Trunc[Rep phi].proposition) from-fraction
    (LF.fractions RX UV.fp X.variable loc element) ;
 } ;
 representation (phi : G.Unit -> R.R) : Tr.Trunc[Rep phi].carrier =
  Tr1.Trunc[I.LocalizationWitness RX X.variable].induction @l (\ t -> Tr.Trunc[Rep phi].carrier)
   (\ t -> Tr.Trunc[Rep phi].proposition) (\ loc -> At[phi,loc].result) (I.localize RX UV.fp X.variable) ;
} ;
