-- Lemma 7.5 instantiated with the actual quotient by a finite radical ideal.
-- Finite ideals are exactly the ideals I in the formal gcd nodes S(I;U).
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (n : Nat) (fs : Fin n -> A.R) {
 module I = Ideals[l].Over[A,setA] ;
 J : I.Ideal = I.Gen[n,fs].ideal ;
 module Quot = QuotientCertificate[l].Relative[A,setA,n,fs] ;
 C : CRing = Quot.K.A.ring ;
 phi : RingHom[l].Hom A C = Quot.K.A.inclusion ;
 module At (radical : (a : A.R) -> J.1 a -> RL[A].unit (A.add A.o (A.neg a))) {
  module Kernel = JacobsonReduction[l].Over[A,C,setA,phi].At[J,Quot.kernel,radical] ;
  module Lifting = Kernel.Lifting ;
  module BaseChange = PolynomialMap[l].Over[A,C,setA,Quot.K.A.set,phi] ;
 } ;
} ;
