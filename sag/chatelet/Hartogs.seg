-- Abstract Hartogs lemma.  A is finitely presented with elements
-- s_0, s_1, ... (at least two) such that
--   regular:  each s_i is regular;
--   divides:  s_1^b g = s_0^a h implies s_0^a divides g.
-- Then every function on the punctured spectrum U = D(s_0) u D(s_1) u ...
-- is x |-> x(c) for a unique c in A:  functions : A ~ (U -> R).
-- Proof: on D(s_0) and D(s_1), phi is g_0/s_0^a and g_1/s_1^b; they agree
-- on D(s_0 s_1), so s_1^b g_0 = s_0^a g_1, hence g_0 = s_0^a c.  On every
-- D(s_i), c and the local fraction agree on D(s_0 s_i), hence on D(s_i).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module LFn = LocalFunctions[l].Over[R,setR,sqc] ;
 module RP = AffinePowers[l].Over[R] ;
 module RPU = RP.Units[setR] ;
 module ARR = AffineRing[l].Laws[R,setR] ;
 -- c a = c b with c a unit gives a = b
 cancel (c a b : R.R) (hc : RL[R].unit c) (h : Id R.R (R.mul c a) (R.mul c b)) : Id R.R a b =
  calc R.R {
   a =< sym (RP.one-left a) > R.mul R.o a
     =< ap (\ t -> R.mul t a) (sym (trans (R.mulC hc.1 c) hc.2)) > R.mul (R.mul hc.1 c) a
     =< sym (R.mulA hc.1 c a) > R.mul hc.1 (R.mul c a)
     =< ap (R.mul hc.1) h > R.mul hc.1 (R.mul c b)
     =< R.mulA hc.1 c b > R.mul (R.mul hc.1 c) b
     =< ap (\ t -> R.mul t b) (trans (R.mulC hc.1 c) hc.2) > R.mul R.o b
     =< RP.one-left b > b } ;
 cancel-power (u : R.R) (hu : RL[R].unit u) (n : Nat) (a b : R.R)
  (h : Id R.R (R.mul (RP.power u n) a) (R.mul (RP.power u n) b)) : Id R.R a b =
  cancel (RP.power u n) a b (RPU.power-unit u hu n) h ;

 module At (A : C.Algebra) (fp : P.FP A) (m : Nat) (s : Fin (suc (suc m)) -> A.ring.R)
  (regular : (i : Fin (suc (suc m))) (a : A.ring.R) -> Id A.ring.R (A.ring.mul (s i) a) A.ring.z -> Id A.ring.R a A.ring.z)
  (divides : (a b : Nat) (g h : A.ring.R) ->
   Id A.ring.R (A.ring.mul (AffinePowers[l].Over[A.ring].power (s (inl (inr tt))) b) g)
    (A.ring.mul (AffinePowers[l].Over[A.ring].power (s (inr tt)) a) h) ->
   (c : A.ring.R) * Id A.ring.R g (A.ring.mul (AffinePowers[l].Over[A.ring].power (s (inr tt)) a) c)) {
  AR : CRing = A.ring ;
  module AP = AffinePowers[l].Over[A.ring] ;
  module ARA = AffineRing[l].Laws[A.ring,A.set] ;
  Ix : U l = Fin (suc (suc m)) ;
  i0 : Ix = inr tt ;
  i1 : Ix = inl (inr tt) ;
  ev (x : C.Spec A) (a : AR.R) : R.R = x.1.1 a ;
  ev-mul (x : C.Spec A) (a b : AR.R) : Id R.R (ev x (AR.mul a b)) (R.mul (ev x a) (ev x b)) = x.1.2.2.2 a b ;
  ev-power (x : C.Spec A) (a : AR.R) (n : Nat) : Id R.R (ev x (AP.power a n)) (RP.power (ev x a) n) =
   AffinePowers[l].power-map AR R x.1 a n ;
  ev-difference (x : C.Spec A) (a b : AR.R) : Id R.R (ev x (AR.add a (AR.neg b))) (R.add (ev x a) (R.neg (ev x b))) =
   trans (x.1.2.2.1 a (AR.neg b)) (ap (R.add (ev x a)) (RingHom[l].negation AR R x.1 b)) ;
  -- x(p^n a) = x(p)^n x(a)
  ev-scaled (x : C.Spec A) (p a : AR.R) (n : Nat) :
   Id R.R (ev x (AR.mul (AP.power p n) a)) (R.mul (RP.power (ev x p) n) (ev x a)) =
   trans (ev-mul x (AP.power p n) a) (ap (\ t -> R.mul t (ev x a)) (ev-power x p n)) ;

  power-regular (i : Ix) : (n : Nat) (a : AR.R) -> Id AR.R (AR.mul (AP.power (s i) n) a) AR.z -> Id AR.R a AR.z = split {
   zero -> \ a h -> trans (sym (AP.one-left a)) h ;
   suc n | ih -> \ a h -> ih a (regular i (AR.mul (AP.power (s i) n) a) (trans (AR.mulA (s i) (AP.power (s i) n) a) h)) } ;
  pair-regular (i j : Ix) (n : Nat) (a : AR.R)
   (h : Id AR.R (AR.mul (AP.power (AR.mul (s i) (s j)) n) a) AR.z) : Id AR.R a AR.z =
   power-regular j n a (power-regular i n (AR.mul (AP.power (s j) n) a)
    (trans (AR.mulA (AP.power (s i) n) (AP.power (s j) n) a)
     (trans (ap (\ t -> AR.mul t a) (sym (AP.power-mul (s i) (s j) n))) h))) ;
  from-annihilated (i j : Ix) (a : AR.R)
   (w : LocalizationKernel[l].Relative[AR,A.set,AR.mul (s i) (s j)].Vanishes a) : Id AR.R a AR.z =
   Tr.Trunc[(n : Nat) * Id AR.R (AR.mul (AP.power (AR.mul (s i) (s j)) n) a) AR.z].induction @l
    (\ t -> Id AR.R a AR.z) (\ t -> A.set a AR.z) (\ v -> pair-regular i j v.1 a v.2) w ;
  both-units (i j : Ix) (x : I.D A (AR.mul (s i) (s j))) :
   RL[R].unit (ev x.1 (s i)) * RL[R].unit (ev x.1 (s j)) =
   (ARR.unit-left _ _ (Pr.subst R.R RL[R].unit _ _ (ev-mul x.1 (s i) (s j)) x.2),
    ARR.unit-right _ _ (Pr.subst R.R RL[R].unit _ _ (ev-mul x.1 (s i) (s j)) x.2)) ;

  Covered (x : C.Spec A) : U l = Tr.Trunc[(i : Ix) * RL[R].unit (ev x (s i))].carrier ;
  Punctured : U l = (x : C.Spec A) * Covered x ;
  into (i : Ix) (x : I.D A (s i)) : Punctured = (x.1,Tr.Trunc[(i : Ix) * RL[R].unit (ev x.1 (s i))].inc (i,x.2)) ;
  point-eq (y z : Punctured) (h : Id (C.Spec A) y.1 z.1) : Id Punctured y z =
   Pr.Sigma-eq (C.Spec A) Covered y.1 z.1 y.2 z.2 h Tr.Trunc[(i : Ix) * RL[R].unit (ev z.1 (s i))].proposition ;
  restrict (c : AR.R) (y : Punctured) : R.R = ev y.1 c ;
  Extends (phi : Punctured -> R.R) : U l = (c : AR.R) * ((y : Punctured) -> Id R.R (ev y.1 c) (phi y)) ;

  module Main (phi : Punctured -> R.R) {
   local (i : Ix) (x : I.D A (s i)) : R.R = phi (into i x) ;
   same (i j : Ix) (x : C.Spec A) (u : RL[R].unit (ev x (s i))) (v : RL[R].unit (ev x (s j))) :
    Id R.R (local i (x,u)) (local j (x,v)) = ap phi (point-eq (into i (x,u)) (into j (x,v)) (refl x)) ;
   -- vanishing on D(s_i s_j) of x |-> P_j a - P_i b, where a and b are local values times powers
   module Compare (i j : Ix) (a b : AR.R) (M N : Nat)
    (ha : (x : I.D A (s i)) -> Id R.R (ev x.1 a) (R.mul (RP.power (ev x.1 (s i)) M) (local i x)))
    (hb : (x : I.D A (s j)) -> Id R.R (ev x.1 b) (R.mul (RP.power (ev x.1 (s j)) N) (local j x))) {
    d : AR.R = AR.add (AR.mul (AP.power (s j) N) a) (AR.neg (AR.mul (AP.power (s i) M) b)) ;
    module D = LFn.At[A,fp,AR.mul (s i) (s j)] ;
    zero-at (x : D.Dom) : Id R.R (ev x.1 d) R.z =
     trans (ev-difference x.1 (AR.mul (AP.power (s j) N) a) (AR.mul (AP.power (s i) M) b))
      (trans (Presentations[l].cong2 R.R R.add _ _ _ _
        (trans (ev-scaled x.1 (s j) a N)
         (ap (R.mul (RP.power (ev x.1 (s j)) N)) (ha (x.1,(both-units i j x).1))))
        (ap R.neg (trans (ev-scaled x.1 (s i) b M)
         (trans (ap (R.mul (RP.power (ev x.1 (s i)) M)) (hb (x.1,(both-units i j x).2)))
          (ap (\ t -> R.mul (RP.power (ev x.1 (s i)) M) (R.mul (RP.power (ev x.1 (s j)) N) t))
           (same j i x.1 (both-units i j x).2 (both-units i j x).1))))))
       (trans (ap (\ t -> R.add t (R.neg (R.mul (RP.power (ev x.1 (s i)) M)
          (R.mul (RP.power (ev x.1 (s j)) N) (local i (x.1,(both-units i j x).1))))))
         (RL[R].mul-swap (RP.power (ev x.1 (s j)) N) (RP.power (ev x.1 (s i)) M) (local i (x.1,(both-units i j x).1))))
        (R.addN _))) ;
    equation : Id AR.R (AR.mul (AP.power (s j) N) a) (AR.mul (AP.power (s i) M) b) =
     ARA.difference-zero _ _ (from-annihilated i j d (D.vanish d zero-at)) ;
   } ;
   module Glue (r0 : LFn.At[A,fp,s i0].Rep (local i0)) (r1 : LFn.At[A,fp,s i1].Rep (local i1)) {
    module E = Compare[i0,i1,r0.1,r1.1,r0.2.1,r1.2.1,r0.2.2,r1.2.2] ;
    cw : (c : AR.R) * Id AR.R r0.1 (AR.mul (AP.power (s i0) r0.2.1) c) = divides r0.2.1 r1.2.1 r0.1 r1.1 E.equation ;
    c : AR.R = cw.1 ;
    on-zero (x : I.D A (s i0)) : Id R.R (ev x.1 c) (local i0 x) =
     cancel-power (ev x.1 (s i0)) x.2 r0.2.1 _ _
      (trans (sym (ev-scaled x.1 (s i0) c r0.2.1)) (trans (ap (ev x.1) (sym cw.2)) (r0.2.2 x))) ;
    module Chart (i : Ix) (ri : LFn.At[A,fp,s i].Rep (local i)) {
     module E2 = Compare[i0,i,c,ri.1,zero,ri.2.1,\ x -> trans (on-zero x) (sym (RP.one-left (local i0 x))),ri.2.2] ;
     -- s_i^N c = h
     equation : Id AR.R (AR.mul (AP.power (s i) ri.2.1) c) ri.1 =
      trans E2.equation (AP.one-left ri.1) ;
     result (x : I.D A (s i)) : Id R.R (ev x.1 c) (local i x) =
      cancel-power (ev x.1 (s i)) x.2 ri.2.1 _ _
       (trans (sym (ev-scaled x.1 (s i) c ri.2.1)) (trans (ap (ev x.1) equation) (ri.2.2 x))) ;
    } ;
    extends (y : Punctured) : Id R.R (ev y.1 c) (phi y) =
     Tr.Trunc[(i : Ix) * RL[R].unit (ev y.1 (s i))].induction @l (\ t -> Id R.R (ev y.1 c) (phi y))
      (\ t -> setR (ev y.1 c) (phi y))
      (\ iu -> Tr.Trunc[LFn.At[A,fp,s iu.1].Rep (local iu.1)].induction @l (\ t -> Id R.R (ev y.1 c) (phi y))
        (\ t -> setR (ev y.1 c) (phi y))
        (\ ri -> trans (Chart[iu.1,ri].result (y.1,iu.2)) (ap phi (point-eq (into iu.1 (y.1,iu.2)) y (refl y.1))))
        (LFn.At[A,fp,s iu.1].rep (local iu.1)))
      y.2 ;
    result : Extends phi = (c,extends) ;
   } ;
   power-regular-annihilated (a : AR.R)
    (w : LocalizationKernel[l].Relative[AR,A.set,s i0].Vanishes a) : Id AR.R a AR.z =
    Tr.Trunc[(n : Nat) * Id AR.R (AR.mul (AP.power (s i0) n) a) AR.z].induction @l
     (\ t -> Id AR.R a AR.z) (\ t -> A.set a AR.z) (\ v -> power-regular i0 v.1 a v.2) w ;
   -- uniqueness: two extensions agree on D(s_0), hence are equal
   unique (e e' : Extends phi) : Id AR.R e.1 e'.1 =
    ARA.difference-zero _ _ (power-regular-annihilated (AR.add e.1 (AR.neg e'.1))
     (LFn.At[A,fp,s i0].vanish (AR.add e.1 (AR.neg e'.1)) (\ x ->
      trans (ev-difference x.1 e.1 e'.1)
       (trans (ap (\ t -> R.add t (R.neg (ev x.1 e'.1))) (trans (e.2 (into i0 x)) (sym (e'.2 (into i0 x)))))
        (R.addN (ev x.1 e'.1)))))) ;
   extends-prop : Pr.isProp (Extends phi) = \ e e' ->
    Pr.Sigma-eq AR.R (\ c -> (y : Punctured) -> Id R.R (ev y.1 c) (phi y)) e.1 e'.1 e.2 e'.2 (unique e e')
     (F.isProp-Pi Punctured (\ y -> Id R.R (ev y.1 e'.1) (phi y)) (\ y -> setR (ev y.1 e'.1) (phi y))) ;
   extension : Extends phi =
    Tr.Trunc[LFn.At[A,fp,s i0].Rep (local i0)].induction @l (\ t -> Extends phi) (\ t -> extends-prop)
     (\ r0 -> Tr.Trunc[LFn.At[A,fp,s i1].Rep (local i1)].induction @l (\ t -> Extends phi) (\ t -> extends-prop)
       (\ r1 -> Glue[r0,r1].result) (LFn.At[A,fp,s i1].rep (local i1)))
     (LFn.At[A,fp,s i0].rep (local i0)) ;
  } ;
  extend (phi : Punctured -> R.R) : AR.R = Main[phi].extension.1 ;
  functions : Pr.Equiv AR.R (Punctured -> R.R) =
   (restrict,Pr.qinv AR.R (Punctured -> R.R) restrict extend
    (\ phi -> F.funext Punctured (\ y -> R.R) _ phi Main[phi].extension.2)
    (\ c -> Main[restrict c].unique Main[restrict c].extension (c,\ y -> refl (ev y.1 c)))) ;
 } ;
} ;
