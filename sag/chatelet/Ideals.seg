-- Ideals as proposition-valued predicates; finite generation is a property.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module FH = Axioms[l+].FunExtLemmas[fe @l+] ;
module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 open A ; open RL[A] ;
 Predicate : U l+ = R -> U l ;
 Iff (Q S : U l) : U l = (Q -> S) * (S -> Q) ;
 module Conditions (m : Predicate) {
  Props : U l = (a : R) -> Pr.isProp (m a) ;
  Add : U l = (a b : R) -> m a -> m b -> m (add a b) ;
  Scale : U l = (a b : R) -> m b -> m (mul a b) ;
  Rest : U l = m z * Add * Scale ;
  Laws : U l = Props * Rest ;
  props-prop : Pr.isProp Props = F.isProp-Pi R (\ a -> Pr.isProp (m a)) (\ a -> F.isProp-isProp (m a)) ;
  rest-prop (p : Props) : Pr.isProp Rest =
   Pr.isProp-Sigma (m z) (\ q -> Add * Scale) (p z)
    (\ q -> Pr.isProp-Sigma Add (\ h -> Scale)
     (F.isProp-Pi R (\ a -> (b : R) -> m a -> m b -> m (add a b))
      (\ a -> F.isProp-Pi R (\ b -> m a -> m b -> m (add a b))
       (\ b -> F.isProp-Pi (m a) (\ u -> m b -> m (add a b))
        (\ u -> F.isProp-Pi (m b) (\ v -> m (add a b)) (\ v -> p (add a b))))))
     (\ h -> F.isProp-Pi R (\ a -> (b : R) -> m b -> m (mul a b))
      (\ a -> F.isProp-Pi R (\ b -> m b -> m (mul a b))
       (\ b -> F.isProp-Pi (m b) (\ u -> m (mul a b)) (\ u -> p (mul a b)))))) ;
  laws-prop : Pr.isProp Laws = Pr.isProp-Sigma Props (\ p -> Rest) props-prop rest-prop ;
 } ;
 Laws (m : Predicate) : U l = Conditions[m].Laws ;
 Ideal : U l+ = (m : Predicate) * Laws m ;
 Included (I J : Ideal) : U l = (a : R) -> I.1 a -> J.1 a ;
 included-prop (I J : Ideal) : Pr.isProp (Included I J) =
  F.isProp-Pi R (\ a -> I.1 a -> J.1 a) (\ a -> F.isProp-Pi (I.1 a) (\ u -> J.1 a) (\ u -> J.2.1 a)) ;
 predicate-path (I J : Ideal) (h : Included I J) (k : Included J I) : Id Predicate I.1 J.1 =
  FH.funext R (\ a -> U l) I.1 J.1
   (\ a -> Axioms[l].UnivalenceLemmas[univ @l].ua (I.1 a) (J.1 a)
    (h a,Pr.qinv (I.1 a) (J.1 a) (h a) (k a)
     (\ u -> J.2.1 a (h a (k a u)) u) (\ u -> I.2.1 a (k a (h a u)) u))) ;
 ext (I J : Ideal) (h : Included I J) (k : Included J I) : Id Ideal I J =
  Hi.Sigma-eq Predicate (\ m -> Laws m) I.1 J.1 I.2 J.2 (predicate-path I J h k) Conditions[J.1].laws-prop ;
 module Gen (n : Nat) (fs : Fin n -> R) {
  module G = GeneratedIdeal[l].Over[A,n,fs] ;
  ideal : Ideal = (G.Member,G.proposition,G.zero-member,G.addition,G.scale) ;
 } ;
 FGWitness (I : Ideal) : U l =
  (n : Nat) * (fs : Fin n -> R) * ((a : R) -> Iff (I.1 a) (GeneratedIdeal[l].Over[A,n,fs].Member a)) ;
 FG (I : Ideal) : U l = Tr.Trunc[FGWitness I].carrier ;
 FinitelyGenerated : U l+ = (I : Ideal) * FG I ;
 generated (n : Nat) (fs : Fin n -> R) : FinitelyGenerated =
  (Gen[n,fs].ideal,Tr.Trunc[FGWitness Gen[n,fs].ideal].inc (n,fs,\ a -> ((\ u -> u),(\ u -> u)))) ;
 fg-ext (I J : FinitelyGenerated) (h : Included I.1 J.1) (k : Included J.1 I.1) :
  Id FinitelyGenerated I J =
  Hi.Sigma-eq Ideal (\ I -> FG I) I.1 J.1 I.2 J.2 (ext I.1 J.1 h k) Tr.Trunc[FGWitness J.1].proposition ;
 module In (I : Ideal) {
  module S = FiniteIdeal[l].Sums[A] ;
  equal (a b : R) (p : Id R a b) : I.1 a -> I.1 b = Pr.subst R I.1 a b p ;
  finite-sum : (n : Nat) (fs : Fin n -> R) -> ((i : Fin n) -> I.1 (fs i)) -> I.1 (S.sum n fs) = split {
   zero -> \ fs h -> I.2.2.1 ;
   suc n | ih -> \ fs h -> I.2.2.2.1 (fs (inr tt)) (S.sum n (\ i -> fs (inl i)))
    (h (inr tt)) (ih (\ i -> fs (inl i)) (\ i -> h (inl i))) } ;
  certificate (n : Nat) (fs : Fin n -> R) (h : (i : Fin n) -> I.1 (fs i))
   (a : R) (w : FiniteIdeal[l].Over[A,n,fs].Certificate a z) : I.1 a =
   equal _ _ (sym (trans w.2 (zl (S.lin n fs w.1))))
    (finite-sum n (\ i -> mul (fs i) (w.1 i))
     (\ i -> equal _ _ (mulC (w.1 i) (fs i)) (I.2.2.2.2 (w.1 i) (fs i) (h i)))) ;
  generated-in (n : Nat) (fs : Fin n -> R) (h : (i : Fin n) -> I.1 (fs i)) (a : R) :
   GeneratedIdeal[l].Over[A,n,fs].Member a -> I.1 a =
   Tr.Trunc[FiniteIdeal[l].Over[A,n,fs].Certificate a z].induction @l
    (\ t -> I.1 a) (\ t -> I.2.1 a) (certificate n fs h a) ;
 } ;
} ;
