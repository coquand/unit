-- Finite bookkeeping for gluing finitely generated ideals.
level l ; open Ring[l] ; open Presentations[l] ;
module CB = CoefficientBound[l] ;
module FB = FiniteBounds[l] ;
module FS = FinSum[l] ;
module AF = AffineFinite[l] ;
le-difference : (n m : Nat) -> CB.le n m -> (d : Nat) * Id Nat m (plus d n) = split {
 zero -> \ m h -> (m,sym (plus-zero m)) ;
 suc n | ih -> split {
  zero -> \ h -> efq h ;
  suc m -> \ h -> ((ih m h).1,
   trans (ap (\ k -> suc k) (ih m h).2) (sym (plus-suc (ih m h).1 n))) } } ;
module PowerMember (A : CRing) (n : Nat) (gs : Fin n -> A.R) {
 module G = GeneratedIdeal[l].Over[A,n,gs] ;
 module P = AffinePowers[l].Over[A] ;
 grow (f a : A.R) (k N : Nat) (le : CB.le k N) (h : G.Member (A.mul (P.power f k) a)) :
  G.Member (A.mul (P.power f N) a) =
  G.equal _ _
   (trans (A.mulA (P.power f (le-difference k N le).1) (P.power f k) a)
    (trans (ap (\ t -> A.mul t a) (sym (P.power-add f (le-difference k N le).1 k)))
     (ap (\ t -> A.mul (P.power f t) a) (sym (le-difference k N le).2))))
   (G.scale (P.power f (le-difference k N le).1) (A.mul (P.power f k) a) h) ;
} ;
count : (m : Nat) -> (Fin m -> Nat) -> Nat = FB.bound ;
collect (B : U l) : (m : Nat) (ns : Fin m -> Nat) ->
 ((i : Fin m) -> Fin (ns i) -> B) -> Fin (count m ns) -> B = split {
 zero -> \ ns vs -> AF.empty-section (\ k -> B) ;
 suc m | ih -> \ ns vs -> FS.cases (count m (\ i -> ns (inl i))) B
  (ih (\ i -> ns (inl i)) (\ i -> vs (inl i))) (ns (inr tt)) (vs (inr tt)) } ;
index : (m : Nat) (ns : Fin m -> Nat) -> (i : Fin m) -> Fin (ns i) -> Fin (count m ns) = split {
 zero -> \ ns -> AF.empty-section (\ i -> Fin (ns i) -> Fin (count zero ns)) ;
 suc m | ih -> \ ns -> AF.section m (\ i -> Fin (ns i) -> Fin (count (suc m) ns))
  (\ i k -> FS.left (count m (\ j -> ns (inl j))) (ns (inr tt)) (ih (\ j -> ns (inl j)) i k))
  (\ k -> FS.right (count m (\ j -> ns (inl j))) (ns (inr tt)) k) } ;
collect-index (B : U l) : (m : Nat) (ns : Fin m -> Nat)
 (vs : (i : Fin m) -> Fin (ns i) -> B) (i : Fin m) (k : Fin (ns i)) ->
 Id B (collect B m ns vs (index m ns i k)) (vs i k) = split {
 zero -> \ ns vs -> AF.empty-section (\ i -> (k : Fin (ns i)) -> Id B (collect B zero ns vs (index zero ns i k)) (vs i k)) ;
 suc m | ih -> \ ns vs -> AF.section m
  (\ i -> (k : Fin (ns i)) -> Id B (collect B (suc m) ns vs (index (suc m) ns i k)) (vs i k))
  (\ i k -> trans
   (FS.cases-left (count m (\ j -> ns (inl j))) B
    (collect B m (\ j -> ns (inl j)) (\ j -> vs (inl j))) (ns (inr tt)) (vs (inr tt))
    (index m (\ j -> ns (inl j)) i k))
   (ih (\ j -> ns (inl j)) (\ j -> vs (inl j)) i k))
  (\ k -> FS.cases-right (count m (\ j -> ns (inl j))) B
   (collect B m (\ j -> ns (inl j)) (\ j -> vs (inl j))) (ns (inr tt)) (vs (inr tt)) k) } ;
cases-all (n : Nat) (B : U l) (P : B -> U l) (a : Fin n -> B)
 (ha : (i : Fin n) -> P (a i)) : (m : Nat) (b : Fin m -> B) ->
 ((j : Fin m) -> P (b j)) -> (k : Fin (plus m n)) -> P (FS.cases n B a m b k) = split {
 zero -> \ b hb -> ha ;
 suc m | ih -> \ b hb -> AF.section (plus m n)
  (\ k -> P (FS.cases n B a (suc m) b k))
  (ih (\ j -> b (inl j)) (\ j -> hb (inl j))) (hb (inr tt)) } ;
collect-all (B : U l) (P : B -> U l) : (m : Nat) (ns : Fin m -> Nat)
 (vs : (i : Fin m) -> Fin (ns i) -> B) ->
 ((i : Fin m) (k : Fin (ns i)) -> P (vs i k)) ->
 (k : Fin (count m ns)) -> P (collect B m ns vs k) = split {
 zero -> \ ns vs h -> AF.empty-section (\ k -> P (collect B zero ns vs k)) ;
 suc m | ih -> \ ns vs h -> cases-all (count m (\ j -> ns (inl j))) B P
  (collect B m (\ j -> ns (inl j)) (\ j -> vs (inl j)))
  (ih (\ j -> ns (inl j)) (\ j -> vs (inl j)) (\ j -> h (inl j)))
  (ns (inr tt)) (vs (inr tt)) (h (inr tt)) } ;
