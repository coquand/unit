-- Projective space, Remark 1.1 (i) of projective.pdf:
--   P^n = (l : Line) * (l^{n+1} \ {0}).
-- Line is the type of R^*-torsors T (PicardLines), and l^{n+1} is the type
-- of maps v : T -> R^{n+1} with v (g t) = g^-1 v t, the associated line
-- (LineAssociated).  Paths (l,v) = (l',w) are the torsor maps f with
-- w (f t) = v t; there is at most one, since w is injective.  So P^n is a
-- set: the action of the units on nonzero vectors is free.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat) {
 open R ; open RL[R] ;
 module Q2 = ProjectiveQuotient[l].Over[R,setR,n] ;
 module L = PicardLines[l].Over[R,setR] ;
 module G = L.Units ;
 module TI = L.TI ;
 V : U l = Q2.V ;
 Line : U l = L.Line ;
 Car (a : Line) : U l = (L.torsor a).1 ;
 act (a : Line) (g : G.Unit) (t : Car a) : Car a = (L.torsor a).2.1 g t ;
 setCar (a : Line) : Pr.isSet (Car a) = (L.torsor a).2.2.1 ;

 Equivariant (a : Line) (v : Car a -> V) : U l =
  (g : G.Unit) (t : Car a) -> Id V (v (act a g t)) (Q2.scale (G.inverse g).1 (v t)) ;
 Laws (a : Line) (v : Car a -> V) : U l = Equivariant a v * ((t : Car a) -> Q2.NonZero (v t)) ;
 Vectors (a : Line) : U l = (v : Car a -> V) * Laws a v ;
 Pn : U l = (a : Line) * Vectors a ;

 laws-prop (a : Line) (v : Car a -> V) : Pr.isProp (Laws a v) =
  Pr.isProp-Sigma (Equivariant a v) (\ e -> (t : Car a) -> Q2.NonZero (v t))
   (F.isProp-Pi G.Unit (\ g -> (t : Car a) -> Id V (v (act a g t)) (Q2.scale (G.inverse g).1 (v t)))
    (\ g -> F.isProp-Pi (Car a) (\ t -> Id V (v (act a g t)) (Q2.scale (G.inverse g).1 (v t)))
     (\ t -> Q2.setV _ _)))
   (\ e -> F.isProp-Pi (Car a) (\ t -> Q2.NonZero (v t)) (\ t -> Tr.Trunc[Q2.Pivots (v t)].proposition)) ;
 vectors-eq (a : Line) (v w : Vectors a) (h : (t : Car a) -> Id V (v.1 t) (w.1 t)) : Id (Vectors a) v w =
  Pr.Sigma-eq (Car a -> V) (Laws a) v.1 w.1 v.2 w.2 (F.funext (Car a) (\ t -> V) v.1 w.1 h) (laws-prop a w.1) ;
 vectors-set (a : Line) : Pr.isSet (Vectors a) =
  Torsor[l].isSet-sub (Car a -> V) (Laws a) (F.isSet-Pi (Car a) (\ t -> V) (\ t -> Q2.setV)) (laws-prop a) ;

 -- a nonzero equivariant vector is injective
 module Injective (b : Line) (w : Vectors b) (s s' : Car b) (e : Id V (w.1 s) (w.1 s')) {
  module DB = Torsor[l].TorBase[G.group].D[Car b,(L.torsor b).2] ;
  d : G.Unit = DB.diff s s' ;
  moved : Id V (w.1 s) (Q2.scale d.2.1 (w.1 s)) =
   trans e (trans (sym (ap w.1 (DB.dact s s'))) (w.2.1 d s)) ;
  module At (p : Q2.Pivots (w.1 s)) {
   inverse-one : Id R.R d.2.1 o =
    sym (Q2.cancel o d.2.1 (w.1 s p.1) p.2
     (trans (trans (mulC o (w.1 s p.1)) (mulO (w.1 s p.1))) (Pr.happly Q2.I (\ i -> R.R) _ _ moved p.1))) ;
   one : Id G.Unit d G.one = G.eq d G.one (trans (sym (mulO d.1)) (trans (ap (mul d.1) (sym inverse-one)) d.2.2)) ;
   result : Id (Car b) s s' =
    trans (sym ((L.torsor b).2.2.2.2.1 s))
     (trans (ap (\ g -> act b g s) (sym one)) (DB.dact s s')) ;
  } ;
  result : Id (Car b) s s' =
   Tr.Trunc[Q2.Pivots (w.1 s)].induction @l (\ t -> Id (Car b) s s') (\ t -> setCar b s s')
    (\ p -> At[p].result) (w.2.2 s) ;
 } ;

 -- transport along a path of lines is composition with its torsor map
 Over-hom (a b : Line) (f : L.Hom a b) (v : Vectors a) (w : Vectors b) : U l =
  (t : Car a) -> Id V (w.1 (f.1 t)) (v.1 t) ;
 transport-hom (a b : Line) (p : Id Line a b) (v : Vectors a) (w : Vectors b)
  (q : Id (Vectors b) (Pr.subst Line Vectors a b p v) w) : Over-hom a b (L.encode a b p) v w =
  idJ Line a (\ c r -> (w' : Vectors c) -> Id (Vectors c) (Pr.subst Line Vectors a c r v) w' ->
    Over-hom a c (L.encode a c r) v w')
   (\ w' q' t -> sym (ap (\ z -> z.1 t) q')) b p w q ;
 hom-transport (a b : Line) (p : Id Line a b) (v : Vectors a) (w : Vectors b)
  (h : Over-hom a b (L.encode a b p) v w) : Id (Vectors b) (Pr.subst Line Vectors a b p v) w =
  idJ Line a (\ c r -> (w' : Vectors c) -> Over-hom a c (L.encode a c r) v w' ->
    Id (Vectors c) (Pr.subst Line Vectors a c r v) w')
   (\ w' h' -> vectors-eq a v w' (\ t -> sym (h' t))) b p w h ;
 path (a b : Line) (f : L.Hom a b) (v : Vectors a) (w : Vectors b) (h : Over-hom a b f v w) :
  Id Pn (a,v) (b,w) =
  Pr.Sigma-path Line Vectors a b v w (L.decode a b f)
   (hom-transport a b (L.decode a b f) v w
    (\ t -> trans (ap (\ g -> w.1 (g.1 t)) (L.ed a b f)) (h t))) ;

 -- P^n is a set
 PairPaths (x y : Pn) : U l = (p : Id Line x.1 y.1) * Id (Vectors y.1) (Pr.subst Line Vectors x.1 y.1 p x.2) y.2 ;
 paths-prop (x y : Pn) : Pr.isProp (PairPaths x y) = \ c c' ->
  Pr.Sigma-eq (Id Line x.1 y.1) (\ p -> Id (Vectors y.1) (Pr.subst Line Vectors x.1 y.1 p x.2) y.2)
   c.1 c'.1 c.2 c'.2
   (trans (sym (L.de x.1 y.1 c.1))
    (trans (ap (L.decode x.1 y.1)
      (TI.hom-eq (L.torsor x.1) (L.torsor y.1) (L.encode x.1 y.1 c.1) (L.encode x.1 y.1 c'.1)
       (\ t -> Injective[y.1,y.2,(L.encode x.1 y.1 c.1).1 t,(L.encode x.1 y.1 c'.1).1 t,
         trans (transport-hom x.1 y.1 c.1 x.2 y.2 c.2 t)
          (sym (transport-hom x.1 y.1 c'.1 x.2 y.2 c'.2 t))].result)))
     (L.de x.1 y.1 c'.1)))
   (vectors-set y.1 _ _) ;
 set : Pr.isSet Pn = \ x y ->
  Pr.retract-prop (Id Pn x y) (PairPaths x y) (Pr.sPath Line Vectors x y)
   (\ c -> Pr.Sigma-path Line Vectors x.1 y.1 x.2 y.2 c.1 c.2) (Pr.rsPath Line Vectors x y) (paths-prop x y) ;
} ;
