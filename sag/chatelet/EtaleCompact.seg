-- sevb Lemma 1.2.2: compactness of the monic root scheme, algebraically.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OT = OpenTransitivity[l].Over[R,setR] ;
 module OA = OpenAffine[l].Over[R,setR,axioms] ;
 module At (i : ET.I) {
  module Gen = EtaleRoots[l].Over[R,setR].Generator[i] ;
  module B = Gen.B ;
  module RO = Gen.Roots ;
  module IO = EtaleIdealOpen[l].Over[R,setR,axioms.loc,ET.lower i] ;
  module SpecOpen (V : C.Spec B.A -> U l) (o : (x : C.Spec B.A) -> OP.Open (V x)) {
   All : U l = (x : C.Spec B.A) -> V x ;
   all-prop : Pr.isProp All = FL.isProp-Pi (C.Spec B.A) V (\ x -> OP.open-prop (V x) (o x)) ;
   module Witness (w : OT.OpenWitness B.A V) {
    module Cover = AffineCovers[l].Over[R,setR,axioms.loc].At[B.A,w.1,w.2.1] ;
    to (v : All) : Cover.Cover = \ x -> (w.2.2 x).1 (v x) ;
    from (u : Cover.Cover) : All = \ x -> (w.2.2 x).2 (u x) ;
    ideal-equiv : Pr.Equiv All (IO.Ax.Unimodular B.A w.1 w.2.1) =
     (\ v -> Cover.unimodular axioms.sqc B.fp (to v),
      Pr.qinv All (IO.Ax.Unimodular B.A w.1 w.2.1)
       (\ v -> Cover.unimodular axioms.sqc B.fp (to v)) (\ u -> from (Cover.cover u))
       (\ u -> Tr.Trunc[IO.Ax.UnimodularWitness B.A w.1 w.2.1].proposition _ u)
       (\ v -> all-prop _ v)) ;
    result : OP.Open All = OP.along All (IO.Ax.Unimodular B.A w.1 w.2.1) ideal-equiv
     IO.At[w.1,w.2.1].unimodular-open ;
   } ;
   compact : OP.Open All = Tr.Trunc[OT.OpenWitness B.A V].induction @l
    (\ t -> OP.Open All) (\ t -> Tr.Trunc[OP.Witness All].proposition)
    (\ w -> Witness[w].result)
    OA.At[B.A,B.fp,V,o].theorem ;
  } ;
  compact (V : ET.Root i -> U l) (o : (x : ET.Root i) -> OP.Open (V x)) :
   OP.Open ((x : ET.Root i) -> V x) =
   OP.along ((x : ET.Root i) -> V x) ((x : C.Spec B.A) -> V (RO.spec-root.1 x))
    ((\ v x -> v (RO.spec-root.1 x)),Pr.qinv ((x : ET.Root i) -> V x) ((x : C.Spec B.A) -> V (RO.spec-root.1 x)) (\ v x -> v (RO.spec-root.1 x))
      (\ v x -> Pr.subst (ET.Root i) V _ _ (RO.spec-root.2.sec-eq x) (v (RO.spec-root.2.sec x)))
      (\ v -> FL.isProp-Pi (C.Spec B.A) (\ x -> V (RO.spec-root.1 x))
        (\ x -> OP.open-prop (V (RO.spec-root.1 x)) (o (RO.spec-root.1 x))) _ v)
      (\ v -> FL.isProp-Pi (ET.Root i) V (\ x -> OP.open-prop (V x) (o x)) _ v))
    SpecOpen[\ x -> V (RO.spec-root.1 x),\ x -> o (RO.spec-root.1 x)].compact ;
 } ;
} ;
