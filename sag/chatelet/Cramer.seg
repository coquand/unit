-- Cramer's rule for 2x2 systems: with D = a d - c b,
--   a (d s - b t) + b (a t - c s) = D s      c (d s - b t) + d (a t - c s) = D t
--   d (a s + b t) - b (c s + d t) = D s      a (c s + d t) - c (a s + b t) = D t
level l ; open Ring[l] ;
module Over (Rg : CRing) {
 open Rg ; open RL[Rg] ;
 sub (x y : R) : R = add x (neg y) ;
 cong-add {x x' y y' : R} (p : Id R x x') (q : Id R y y') : Id R (add x y) (add x' y') =
  trans (ap (\ u -> add u y) p) (ap (add x') q) ;
 neg-left (x y : R) : Id R (mul (neg x) y) (neg (mul x y)) =
  trans (mulC (neg x) y) (trans (mul-neg y x) (ap neg (mulC y x))) ;
 neg-add (x y : R) : Id R (neg (add x y)) (add (neg x) (neg y)) =
  sym (neg-uniq (add x y) (add (neg x) (neg y))
   (trans (swap x y (neg x) (neg y)) (trans (cong-add (addN x) (addN y)) (addZ z)))) ;
 cancel-left (x : R) : Id R (add (neg x) x) z = trans (addC (neg x) x) (addN x) ;
 -- (p - X) + (X - q) = p - q
 telescope (p x q : R) : Id R (add (sub p x) (sub x q)) (sub p q) =
  trans (ap (add (sub p x)) (addC x (neg q)))
   (trans (swap p (neg x) (neg q) x) (trans (ap (add (sub p q)) (cancel-left x)) (addZ (sub p q)))) ;
 -- (p + W) - (q + W) = p - q
 cancel-common (p q w : R) : Id R (sub (add p w) (add q w)) (sub p q) =
  trans (ap (add (add p w)) (neg-add q w))
   (trans (swap p w (neg q) (neg w)) (trans (ap (add (sub p q)) (addN w)) (addZ (sub p q)))) ;
 -- (D) s = (a d) s - (c b) s
 det-left (a b c d s : R) : Id R (mul (sub (mul a d) (mul c b)) s) (sub (mul (mul a d) s) (mul (mul c b) s)) =
  trans (mulC (sub (mul a d) (mul c b)) s)
   (trans (dist s (mul a d) (neg (mul c b)))
    (cong-add (mulC s (mul a d)) (trans (mul-neg s (mul c b)) (ap neg (mulC s (mul c b)))))) ;
 expand (x y w : R) : Id R (mul x (sub y w)) (sub (mul x y) (mul x w)) =
  trans (dist x y (neg w)) (ap (add (mul x y)) (mul-neg x w)) ;
 cramer-y (a b c d s t : R) :
  Id R (add (mul a (sub (mul d s) (mul b t))) (mul b (sub (mul a t) (mul c s)))) (mul (sub (mul a d) (mul c b)) s) =
  trans (cong-add (trans (expand a (mul d s) (mul b t)) (ap (\ u -> sub u (mul a (mul b t))) (mulA a d s)))
     (trans (expand b (mul a t) (mul c s))
      (cong-add (mul-swap b a t) (ap neg (trans (mulA b c s) (ap (\ u -> mul u s) (mulC b c)))))))
   (trans (telescope (mul (mul a d) s) (mul a (mul b t)) (mul (mul c b) s)) (sym (det-left a b c d s))) ;
 cramer-z (a b c d s t : R) :
  Id R (add (mul c (sub (mul d s) (mul b t))) (mul d (sub (mul a t) (mul c s)))) (mul (sub (mul a d) (mul c b)) t) =
  trans (cong-add (trans (expand c (mul d s) (mul b t)) (cong-add (mul-swap c d s) (ap neg (mulA c b t))))
     (trans (expand d (mul a t) (mul c s)) (ap (\ u -> sub u (mul d (mul c s))) (trans (mulA d a t) (ap (\ u -> mul u t) (mulC d a))))))
   (trans (addC (sub (mul d (mul c s)) (mul (mul c b) t)) (sub (mul (mul a d) t) (mul d (mul c s))))
    (trans (telescope (mul (mul a d) t) (mul d (mul c s)) (mul (mul c b) t)) (sym (det-left a b c d t)))) ;
 inverse-y (a b c d s t : R) :
  Id R (sub (mul d (add (mul a s) (mul b t))) (mul b (add (mul c s) (mul d t)))) (mul (sub (mul a d) (mul c b)) s) =
  trans (cong-add (trans (dist d (mul a s) (mul b t)) (ap (\ u -> add u (mul d (mul b t))) (trans (mulA d a s) (ap (\ u -> mul u s) (mulC d a)))))
     (ap neg (trans (dist b (mul c s) (mul d t))
      (cong-add (trans (mulA b c s) (ap (\ u -> mul u s) (mulC b c))) (mul-swap b d t)))))
   (trans (cancel-common (mul (mul a d) s) (mul (mul c b) s) (mul d (mul b t))) (sym (det-left a b c d s))) ;
 inverse-z (a b c d s t : R) :
  Id R (sub (mul a (add (mul c s) (mul d t))) (mul c (add (mul a s) (mul b t)))) (mul (sub (mul a d) (mul c b)) t) =
  trans (cong-add (trans (dist a (mul c s) (mul d t)) (trans (addC (mul a (mul c s)) (mul a (mul d t))) (ap (\ u -> add u (mul a (mul c s))) (mulA a d t))))
     (ap neg (trans (dist c (mul a s) (mul b t))
      (trans (addC (mul c (mul a s)) (mul c (mul b t))) (cong-add (mulA c b t) (mul-swap c a s))))))
   (trans (cancel-common (mul (mul a d) t) (mul (mul c b) t) (mul a (mul c s))) (sym (det-left a b c d t))) ;
} ;
