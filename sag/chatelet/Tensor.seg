-- SAG 3.2.1. The tensor product A (x) B of R-algebras is their coproduct:
-- Hom(A (x) B, D) = Hom(A, D) * Hom(B, D).  For presented A and B, the
-- algebra presented by the concatenated presentation is a coproduct.
-- With D = R this gives Spec(A (x) B) = Spec A * Spec B.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
open Presentations[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Presentations[l].Over[R,setR] ; open P ;
 module C = Algebras[l].Over[R,setR] ;
 module S = FinSum[l].Over[R,setR] ;
 restrict (A B T : C.Algebra) (inA : C.Hom A T) (inB : C.Hom B T) (D : C.Algebra)
  (h : C.Hom T D) : C.Hom A D * C.Hom B D =
  (C.compose A T D h inA,C.compose B T D h inB) ;
 -- T with two maps through which every pair of maps factors uniquely.
 Coproduct (A B T : C.Algebra) : U l+ =
  (inA : C.Hom A T) * (inB : C.Hom B T) *
  ((D : C.Algebra) -> Pr.isEquiv (C.Hom T D) (C.Hom A D * C.Hom B D) (restrict A B T inA inB D)) ;
 -- 3.2.1
 spec-product (A B T : C.Algebra) (c : Coproduct A B T) : Pr.Equiv (C.Spec T) (C.Spec A * C.Spec B) =
  (restrict A B T c.1 c.2.1 C.base,c.2.2 C.base) ;
 -- maps out of a presented algebra agree when they agree on the generators
 hom-eq (p : Presentation) (A : C.Algebra) (pa : Presents p A) (D : C.Algebra) (f g : C.Hom A D)
  (h : (v : Fin p.1) -> Id D.ring.R (f.1.1 (pa.1.1 v)) (g.1.1 (pa.1.1 v))) : Id (C.Hom A D) f g =
  E.injective (C.Hom A D) (Solutions p D) (canonical p A pa.1 D) (pa.2 D) f g
   (solutions-ext p D _ _ h) ;
 module Construction (p q : Presentation) (A B : C.Algebra) (pa : Presents p A) (pb : Presents q B)
  (T : C.Algebra) (pt : Presents (S.tensor p q) T) {
  gens : S.Split[p,q,T].Data = S.Split[p,q,T].forward pt.1 ;
  inA : C.Hom A T = (pa.2 T).sec gens.1 ;
  inB : C.Hom B T = (pb.2 T).sec gens.2 ;
  inA-gen (v : Fin p.1) : Id T.ring.R (inA.1.1 (pa.1.1 v)) (pt.1.1 (FinSum[l].left p.1 q.1 v)) =
   ap (\ s -> s.1 v) ((pa.2 T).sec-eq gens.1) ;
  inB-gen (v : Fin q.1) : Id T.ring.R (inB.1.1 (pb.1.1 v)) (pt.1.1 (FinSum[l].right p.1 q.1 v)) =
   ap (\ s -> s.1 v) ((pb.2 T).sec-eq gens.2) ;
  module To (D : C.Algebra) {
   module SD = S.Split[p,q,D] ;
   pair (d : C.Hom A D * C.Hom B D) : SD.Data = (canonical p A pa.1 D d.1,canonical q B pb.1 D d.2) ;
   backward (d : C.Hom A D * C.Hom B D) : C.Hom T D = (pt.2 D).sec (SD.backward (pair d)) ;
   backward-gen (d : C.Hom A D * C.Hom B D) (w : SD.V) :
    Id D.ring.R ((backward d).1.1 (pt.1.1 w)) (SD.combine (pair d).1.1 (pair d).2.1 w) =
    ap (\ s -> s.1 w) ((pt.2 D).sec-eq (SD.backward (pair d))) ;
   forward : C.Hom T D -> C.Hom A D * C.Hom B D = restrict A B T inA inB D ;
   fb (d : C.Hom A D * C.Hom B D) : Id (C.Hom A D * C.Hom B D) (forward (backward d)) d =
    Pr.trans (C.Hom A D * C.Hom B D) _ (d.1,(forward (backward d)).2) d
     (Pr.ap (C.Hom A D) (C.Hom A D * C.Hom B D) (\ x -> (x,(forward (backward d)).2)) _ _
      (hom-eq p A pa D _ d.1 (\ v ->
       trans (ap (backward d).1.1 (inA-gen v))
        (trans (backward-gen d (FinSum[l].left p.1 q.1 v))
         (FinSum[l].cases-left p.1 D.ring.R (pair d).1.1 q.1 (pair d).2.1 v)))))
     (Pr.ap (C.Hom B D) (C.Hom A D * C.Hom B D) (\ y -> (d.1,y)) _ _
      (hom-eq q B pb D _ d.2 (\ v ->
       trans (ap (backward d).1.1 (inB-gen v))
        (trans (backward-gen d (FinSum[l].right p.1 q.1 v))
         (FinSum[l].cases-right p.1 D.ring.R (pair d).1.1 q.1 (pair d).2.1 v))))) ;
   bf (h : C.Hom T D) : Id (C.Hom T D) (backward (forward h)) h =
    hom-eq (S.tensor p q) T pt D _ h (\ w ->
     trans (backward-gen (forward h) w)
      (FinSum[l].cases-unique p.1 D.ring.R (pair (forward h)).1.1 q.1 (pair (forward h)).2.1
       (\ u -> h.1.1 (pt.1.1 u))
       (\ v -> ap h.1.1 (inA-gen v)) (\ v -> ap h.1.1 (inB-gen v)) w)) ;
   universal : Pr.isEquiv (C.Hom T D) (C.Hom A D * C.Hom B D) forward =
    Pr.qinv _ _ forward backward fb bf ;
  } ;
  coproduct : Coproduct A B T = (inA,inB,\ D -> To[D].universal) ;
 } ;
 -- the presented tensor product of two presented algebras
 module Presented (p q : Presentation) (A B : C.Algebra) (pa : Presents p A) (pb : Presents q B) {
  module X = PresentationExistence[l].Over[R,setR,S.tensor p q] ;
  T : C.Algebra = X.A.algebra ;
  coproduct : Coproduct A B T = Construction[p,q,A,B,pa,pb,T,X.presentation].coproduct ;
 } ;
 Tensor (A B : C.Algebra) : U l+ = (T : C.Algebra) * Coproduct A B T * FP T ;
 -- finitely presented algebras have a finitely presented tensor product
 exists (A B : C.Algebra) (fa : FP A) (fb : FP B) : Truncation[l+].Trunc[Tensor A B].carrier =
  Truncation[l+].Trunc[Witness A].induction @(l+) (\ t -> Truncation[l+].Trunc[Tensor A B].carrier)
   (\ t -> Truncation[l+].Trunc[Tensor A B].proposition)
   (\ wa -> Truncation[l+].Trunc[Witness B].induction @(l+) (\ t -> Truncation[l+].Trunc[Tensor A B].carrier)
    (\ t -> Truncation[l+].Trunc[Tensor A B].proposition)
    (\ wb -> Truncation[l+].Trunc[Tensor A B].inc
     (Presented[wa.1,wb.1,A,B,wa.2,wb.2].T,Presented[wa.1,wb.1,A,B,wa.2,wb.2].coproduct,
      Presented[wa.1,wb.1,A,B,wa.2,wb.2].X.finitely-presented)) fb) fa ;
} ;
