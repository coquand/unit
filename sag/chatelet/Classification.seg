-- The classification of line bundles on P^n, n = k+1, as a statement:
--   (a,d) |-> (x |-> a (x) O(d)(x))  is an equivalence  Line x Z -> (P^n -> Line).
-- Theorem73 proves it for n >= 2, Theorem73One for n = 1; Lift and the
-- proof of Aut(P^n) = PGL use only this statement.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (k : Nat)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 n : Nat = suc k ;
 module TW = Twist[l].Over[R,setR,n,sqc,loc] ;
 module Q2 = ProjectiveQuotient[l].Over[R,setR,n] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module L = PicardLines[l].Over[R,setR] ;
 Degree : U l = PicardInterface[l].Degree ;
 Pn : U l = Q2.Pn ;
 Bundle : U l = Pn -> L.Line ;
 classify (w : L.Line * Degree) (x : Pn) : L.Line = L.tensor w.1 (TW.O w.2 x) ;
 Theorem : U l = Pr.isEquiv (L.Line * Degree) Bundle classify ;
} ;
