-- SAG 3.1.3: the representing algebra, together with the spectrum
-- identification, is unique. No choice of a presentation is made.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module AI = AlgebraInverse[l].Over[R,setR] ;
 module At (X : U l) {
  module FX = FA.At[X] ;
  module SIP = AlgebraPointsIdentity[l].Over[R,setR,X] ;
  module From (w : FA.AffineWitness X) {
   algebra : C.Algebra = w.1 ;
   points : X -> C.Spec algebra = w.2.2.1 ;
   evaluation : C.Hom algebra FX.algebra =
    ((\ a x -> (points x).1.1 a,
      FX.ext _ _ (\ x -> (points x).1.2.1),
      \ a b -> FX.ext _ _ (\ x -> (points x).1.2.2.1 a b),
      \ a b -> FX.ext _ _ (\ x -> (points x).1.2.2.2 a b)),
     \ r -> FX.ext _ _ (\ x -> (points x).2 r)) ;
   equiv : Pr.Equiv algebra.ring.R FX.Carrier =
    Equivalences[l].compose algebra.ring.R (C.Spec algebra -> R.R) FX.Carrier
     (C.evaluation algebra,sqc algebra w.2.1) (Functions[l].pre X (C.Spec algebra) R.R w.2.2) ;
   inverse : C.Hom FX.algebra algebra = AI.At[algebra,FX.algebra,evaluation,equiv.2].inverse ;
   fp : P.FP FX.algebra = AI.transfer-fp algebra FX.algebra evaluation equiv.2 w.2.1 ;
  } ;
  module Compare (w z : FA.AffineWitness X) {
   module A = From[w] ; module B = From[z] ;
   h : C.Hom w.1 z.1 = C.compose w.1 FX.algebra z.1 B.inverse A.evaluation ;
   equiv : Pr.Equiv w.1.ring.R z.1.ring.R =
    Equivalences[l].compose w.1.ring.R FX.Carrier z.1.ring.R A.equiv
     (Functions[l].inverse z.1.ring.R FX.Carrier B.equiv) ;
   points (x : X) (a : w.1.ring.R) :
    Id R.R ((A.points x).1.1 a) ((B.points x).1.1 (h.1.1 a)) =
    sym (Pr.happly X (\ x -> R.R) _ _ (B.equiv.2.sec-eq (A.equiv.1 a)) x) ;
   decorated : Id SIP.Decorated (w.1,A.points) (z.1,B.points) =
    SIP.sip w.1 z.1 A.points B.points h equiv.2 points ;
  } ;
  Property (d : SIP.Decorated) : U l+ = P.FP d.1 * Pr.isEquiv X (C.Spec d.1) d.2 ;
  property-prop (d : SIP.Decorated) : Hi.isProp (Property d) =
   Hi.isProp-Sigma (P.FP d.1) (\ fp -> Pr.isEquiv X (C.Spec d.1) d.2)
    (Tr1.Trunc[P.Witness d.1].proposition)
    (\ fp -> AffineHLevels[l].EquivalenceProofs[X,C.Spec d.1,FA.spec-set d.1,d.2].proposition) ;
  Data : U l+ = (d : SIP.Decorated) * Property d ;
  encode (w : FA.AffineWitness X) : Data = ((w.1,w.2.2.1),w.2.1,w.2.2.2) ;
  decode (d : Data) : FA.AffineWitness X = (d.1.1,d.2.1,d.1.2,d.2.2) ;
  proposition : Hi.isProp (FA.AffineWitness X) = \ w z ->
   Hi.ap Data (FA.AffineWitness X) decode (encode w) (encode z)
    (Hi.Sigma-eq SIP.Decorated Property _ _ _ _ Compare[w,z].decorated (property-prop (encode z).1)) ;
  representation (affine : FA.Affine X) : FA.AffineWitness X =
   Tr1.Trunc[FA.AffineWitness X].induction @l+ (\ t -> FA.AffineWitness X) (\ t -> proposition) (\ w -> w) affine ;
  function-algebra-fp (affine : FA.Affine X) : P.FP FX.algebra =
   From[representation affine].fp ;
 } ;
} ;
