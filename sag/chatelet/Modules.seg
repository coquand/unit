-- Modules for Section 7.  A module over R : Ring[l].CRing is a module of
-- torsor/Alg73 over RingBridge.ring R, so torsor's laws and its 7.3.6
-- apply without translation.  Exponents are written in Ring's Nat (the
-- Nat of 3.3.4 and of the boundedness results) and sent to Alg73's Nat by
-- toN.  Weak quasi-coherence is stated on fractions, in the two clauses of
-- torsor/Affine.WQC: a section over D(g) is merely m / g^N, and m vanishing
-- on D(g) is merely killed by a power of g.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CF = FinChoice[l] ; module A7 = Alg73[l] ; module NF = NatFin[l] ;
module CB = CoefficientBound[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
-- m <= n as Alg73 writes it: d + m = n
le-plus : (m n : Nat) -> CB.le m n -> (d : Base.Nat) * Id Base.Nat (A7.plusN d (NF.toN m)) (NF.toN n) = split {
 zero -> \ n h -> (NF.toN n,A7.plusN-zero (NF.toN n)) ;
 suc m | r -> split {
  zero -> \ h -> efq h ;
  suc n -> \ h -> ((r n h).1,
   trans (A7.plusN-suc (r n h).1 (NF.toN m)) (ap (\ k -> suc k) (r n h).2)) } } ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module RB = RingBridge[l].Over[R,setR] ;
 ring : A7.CRing = RB.ring ;
 module RA = A7.RA[ring] ;
 Module : U l+ = A7.Mod[ring] ;
 -- R as a module over itself
 regular : Module = A7.Reg[ring].reg ;
 -- 7.1.1: M(U) = (x : U) -> M x, with pointwise structure
 pi (X : U l) (Mx : X -> Module) : Module = new A7.Mod[ring,(x : X) -> (Mx x).M,
  F.isSet-Pi X (\ x -> (Mx x).M) (\ x -> (Mx x).setM),
  \ x -> (Mx x).mz,
  \ m m' x -> (Mx x).madd (m x) (m' x),
  \ m x -> (Mx x).mneg (m x),
  \ m m' m'' -> F.funext X (\ x -> (Mx x).M) _ _ (\ x -> (Mx x).maddA (m x) (m' x) (m'' x)),
  \ m m' -> F.funext X (\ x -> (Mx x).M) _ _ (\ x -> (Mx x).maddC (m x) (m' x)),
  \ m -> F.funext X (\ x -> (Mx x).M) _ _ (\ x -> (Mx x).maddZ (m x)),
  \ m -> F.funext X (\ x -> (Mx x).M) _ _ (\ x -> (Mx x).maddN (m x)),
  \ a m x -> (Mx x).sm a (m x),
  \ a b m -> F.funext X (\ x -> (Mx x).M) _ _ (\ x -> (Mx x).smA a b (m x)),
  \ m -> F.funext X (\ x -> (Mx x).M) _ _ (\ x -> (Mx x).smO (m x)),
  \ a m m' -> F.funext X (\ x -> (Mx x).M) _ _ (\ x -> (Mx x).smD a (m x) (m' x)),
  \ a b m -> F.funext X (\ x -> (Mx x).M) _ _ (\ x -> (Mx x).smE a b (m x))] ;
 module Fractions (Md : Module) {
  module MA = A7.MA[ring,Md] ;
  M : U l = Md.M ;
  -- g^K x = 0, with K in Ring's Nat; proposition-valued and upwards closed
  Kills (g : R.R) (x : M) (K : Nat) : U l = Id M (Md.sm (RA.pw g (NF.toN K)) x) Md.mz ;
  kills-prop (g : R.R) (x : M) (K : Nat) : Pr.isProp (Kills g x K) = Md.setM _ _ ;
  kills-up (g : R.R) (x : M) (K K' : Nat) (h : CB.le K K') (k : Kills g x K) : Kills g x K' =
   MA.zero-raise g x (NF.toN K) (le-plus K K' h).1 (NF.toN K') k (le-plus K K' h).2 ;
  -- x / g^p = x' / g^p' is witnessed by the exponent K
  Same (g : R.R) (x : M) (p : Nat) (x' : M) (p' : Nat) (K : Nat) : U l =
   Kills g (MA.sub (Md.sm (RA.pw g (NF.toN p')) x) (Md.sm (RA.pw g (NF.toN p)) x')) K ;
  -- the image of x / g^N on D(g): u is an inverse of g
  value (g : R.R) (u : RA.unit g) (x : M) (N : Nat) : M = Md.sm (RA.pw u.1 (NF.toN N)) x ;
 } ;
 -- 7.1.5 for one module, as torsor's WQC over the point
 WeaklyQC (Md : Module) : U l = Affine[l].Aff[ring,Top,\ t -> Md].WQC ;
 -- 7.1.7: a bundle with weakly quasi-coherent fibres
 WqcBundle (X : U l) (Mx : X -> Module) : U l = (x : X) -> WeaklyQC (Mx x) ;
 -- 7.1.8 for U = X, in the form taken by torsor's 7.3.6
 Restriction (X : U l) (Mx : X -> Module) : U l = Affine[l].Aff[ring,X,Mx].WQC ;
} ;
