-- Skolem-Noether for M_N(R), R local, N = n+1 (sevb Prop 3.2.3, the short
-- argument of SEVB-INFORMAL.md Section 4: only (K1) and (K2)).
--
-- Let phi be a unital algebra endomorphism of M_N(R), e_ab = phi(E_ab),
-- and t a fixed index.  Then e_ab e_cd = delta_bc e_ad and sum_j e_jj = 1,
-- so sum_j (e_jj)_tt = 1 and by Loc merely c = (e_jj)_tt is a unit for
-- some j.  Put
--      W_xy = (e_yj)_xt,      L_xy = c^-1 (e_jx)_ty.
-- Then (L W)_xy = c^-1 (e_jx e_yj)_tt = delta_xy, so W L = 1 by (K2), and
-- phi(X) W = W X, since both have entries phi(X E_yj)_xt (X E_yj =
-- sum_z X_zy E_zj).  Hence phi(X) = W X L.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Ps = Presentations[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (loc : StandardOpens[l].Over[R,setR].Locality) (n : Nat) {
 module L = RL[R] ;
 module S = FiniteIdeal[l].Sums[R] ;
 module D = MnSums[l].Over[R] ;
 module MN = MnAlgebra[l].Over[R,setR,suc n] ;
 module ME = MnElementary[l].Over[R,setR,suc n] ;
 module AS = AlgSIP[l].Over[R,setR] ;
 module K = MatrixLeftInverse[l].Over[R,setR,loc] ;
 module LocL = StandardOpens[l].Over[R,setR].Local[loc] ;
 N : Nat = suc n ;
 I : U l = MN.I ;
 Mat : U l = MN.Mat ;
 M : MN.NA.Algebra = MN.algebra ;
 t : I = inr tt ;
 dl (i j : I) : R.R = D.delta N i j ;
 -- X E_yj = sum_z X_zy E_zj
 col-expand (X : Mat) (y j : I) : Id Mat (MN.mmul X (ME.E y j)) (ME.sum N (\ z -> MN.mscale (X z y) (ME.E z j))) =
  MN.mat-eq (MN.mmul X (ME.E y j)) (ME.sum N (\ z -> MN.mscale (X z y) (ME.E z j))) (\ a b ->
   calc R.R {
    S.sum N (\ k -> R.mul (X a k) (R.mul (dl y k) (dl j b)))
     =< S.sum-cong N _ (\ k -> R.mul (dl y k) (R.mul (X a k) (dl j b))) (\ k -> L.mul-swap (X a k) (dl y k) (dl j b)) >
    S.sum N (\ k -> R.mul (dl y k) (R.mul (X a k) (dl j b)))
     =< D.sum-delta N y (\ k -> R.mul (X a k) (dl j b)) >
    R.mul (X a y) (dl j b)
     =< sym (D.sum-delta N a (\ z -> R.mul (X z y) (dl j b))) >
    S.sum N (\ z -> R.mul (dl a z) (R.mul (X z y) (dl j b)))
     =< S.sum-cong N _ (\ z -> R.mul (X z y) (R.mul (dl z a) (dl j b)))
         (\ z -> trans (ap (\ w -> R.mul w (R.mul (X z y) (dl j b))) (D.delta-sym N a z)) (L.mul-swap (dl z a) (X z y) (dl j b))) >
    S.sum N (\ z -> R.mul (X z y) (R.mul (dl z a) (dl j b)))
     =< sym (ME.sum-entry a b N (\ z -> MN.mscale (X z y) (ME.E z j))) >
    ME.sum N (\ z -> MN.mscale (X z y) (ME.E z j)) a b }) ;

 -- an algebra endomorphism phi of M_N(R)
 module Endo (phi : Mat -> Mat) (hom : AS.Hom M M phi) {
  phi-zero : Id Mat (phi MN.mzero) MN.mzero =
   SkolemNoetherConj[l].Over[R,setR].On[M].hom-zero phi hom ;
  phi-sum : (m : Nat) (v : Ps.Fin m -> Mat) -> Id Mat (phi (ME.sum m v)) (ME.sum m (\ i -> phi (v i))) = split {
   zero -> \ v -> phi-zero ;
   suc m | r -> \ v -> trans (hom.1 (v (inr tt)) (ME.sum m (\ i -> v (inl i))))
    (ap (MN.madd (phi (v (inr tt)))) (r (\ i -> v (inl i)))) } ;
  e (a b : I) : Mat = phi (ME.E a b) ;
  e-prod (a b c d : I) : Id Mat (MN.mmul (e a b) (e c d)) (MN.mscale (dl b c) (e a d)) =
   trans (sym (hom.2.2.1 (ME.E a b) (ME.E c d)))
    (trans (ap phi (ME.product a b c d)) (hom.2.1 (dl b c) (ME.E a d))) ;
  -- sum_j (e_jj)_tt = 1
  trace : Id R.R (S.sum N (\ j -> e j j t t)) R.o =
   calc R.R {
    S.sum N (\ j -> e j j t t) =< sym (ME.sum-entry t t N (\ j -> e j j)) >
    ME.sum N (\ j -> e j j) t t =< ap (\ Y -> Y t t) (sym (phi-sum N (\ j -> ME.E j j))) >
    phi (ME.sum N (\ j -> ME.E j j)) t t =< ap (\ Y -> phi Y t t) ME.sum-diagonal >
    phi MN.mone t t =< ap (\ Y -> Y t t) hom.2.2.2 >
    dl t t =< D.delta-diag N t > R.o } ;
  -- phi (X E_yj) at (x,t), expanded
  expand (X : Mat) (x y j : I) :
   Id R.R (phi (MN.mmul X (ME.E y j)) x t) (S.sum N (\ z -> R.mul (X z y) (e z j x t))) =
   calc R.R {
    phi (MN.mmul X (ME.E y j)) x t =< ap (\ Y -> phi Y x t) (col-expand X y j) >
    phi (ME.sum N (\ z -> MN.mscale (X z y) (ME.E z j))) x t
     =< ap (\ Y -> Y x t) (phi-sum N (\ z -> MN.mscale (X z y) (ME.E z j))) >
    ME.sum N (\ z -> phi (MN.mscale (X z y) (ME.E z j))) x t
     =< ME.sum-entry x t N (\ z -> phi (MN.mscale (X z y) (ME.E z j))) >
    S.sum N (\ z -> phi (MN.mscale (X z y) (ME.E z j)) x t)
     =< S.sum-cong N (\ z -> phi (MN.mscale (X z y) (ME.E z j)) x t) (\ z -> R.mul (X z y) (e z j x t)) (\ z -> ap (\ Y -> Y x t) (hom.2.1 (X z y) (ME.E z j))) >
    S.sum N (\ z -> R.mul (X z y) (e z j x t)) } ;

  -- the conjugating matrix, for a pivot j
  module PivotAt (j : I) (u : L.unit (e j j t t)) {
   c : R.R = e j j t t ;
   W : Mat = \ x y -> e y j x t ;
   Lm : Mat = \ x y -> R.mul u.1 (e j x t y) ;
   LW : Id Mat (MN.mmul Lm W) MN.mone = MN.mat-eq (MN.mmul Lm W) MN.mone (\ x y ->
    calc R.R {
     S.sum N (\ z -> R.mul (R.mul u.1 (e j x t z)) (e y j z t))
      =< S.sum-cong N _ (\ z -> R.mul u.1 (R.mul (e j x t z) (e y j z t))) (\ z -> sym (R.mulA u.1 (e j x t z) (e y j z t))) >
     S.sum N (\ z -> R.mul u.1 (R.mul (e j x t z) (e y j z t)))
      =< S.sum-scale u.1 N (\ z -> R.mul (e j x t z) (e y j z t)) >
     R.mul u.1 (MN.mmul (e j x) (e y j) t t)
      =< ap (\ Y -> R.mul u.1 (Y t t)) (e-prod j x y j) >
     R.mul u.1 (R.mul (dl x y) c)
      =< L.mul-swap u.1 (dl x y) c >
     R.mul (dl x y) (R.mul u.1 c)
      =< ap (R.mul (dl x y)) (trans (R.mulC u.1 c) u.2) >
     R.mul (dl x y) R.o
      =< R.mulO (dl x y) >
     dl x y }) ;
   WL : Id Mat (MN.mmul W Lm) MN.mone = K.k2 N Lm W LW ;
   -- phi(X) W = W X
   intertwine (X : Mat) : Id Mat (MN.mmul (phi X) W) (MN.mmul W X) = MN.mat-eq (MN.mmul (phi X) W) (MN.mmul W X) (\ x y ->
    calc R.R {
     MN.mmul (phi X) (e y j) x t
      =< ap (\ Y -> Y x t) (sym (hom.2.2.1 X (ME.E y j))) >
     phi (MN.mmul X (ME.E y j)) x t
      =< expand X x y j >
     S.sum N (\ z -> R.mul (X z y) (e z j x t))
      =< S.sum-cong N (\ z -> R.mul (X z y) (e z j x t)) (\ z -> R.mul (e z j x t) (X z y)) (\ z -> R.mulC (X z y) (e z j x t)) >
     MN.mmul W X x y }) ;
   conj (X : Mat) : Id Mat (phi X) (MN.mmul (MN.mmul W X) Lm) =
    calc Mat {
     phi X =< sym (MN.m-one-right (phi X)) > MN.mmul (phi X) MN.mone
      =< ap (MN.mmul (phi X)) (sym WL) > MN.mmul (phi X) (MN.mmul W Lm)
      =< MN.m-mulA (phi X) W Lm > MN.mmul (MN.mmul (phi X) W) Lm
      =< ap (\ Y -> MN.mmul Y Lm) (intertwine X) > MN.mmul (MN.mmul W X) Lm } ;
  } ;
  Conjugator : U l = (W Lm : Mat) * Id Mat (MN.mmul Lm W) MN.mone * Id Mat (MN.mmul W Lm) MN.mone *
   ((X : Mat) -> Id Mat (phi X) (MN.mmul (MN.mmul W X) Lm)) ;
  from-pivot (p : (j : I) * L.unit (e j j t t)) : Conjugator =
   (PivotAt[p.1,p.2].W,PivotAt[p.1,p.2].Lm,PivotAt[p.1,p.2].LW,PivotAt[p.1,p.2].WL,PivotAt[p.1,p.2].conj) ;
  -- Skolem-Noether: phi is merely conjugation by an invertible matrix
  theorem : Tr.Trunc[Conjugator].carrier =
   Tr.Trunc[(j : I) * L.unit (e j j t t)].induction @l (\ w -> Tr.Trunc[Conjugator].carrier)
    (\ w -> Tr.Trunc[Conjugator].proposition) (\ p -> Tr.Trunc[Conjugator].inc (from-pivot p))
    (LocL.finite-unit N (\ j -> e j j t t) (K.unit-one (S.sum N (\ j -> e j j t t)) trace)) ;
 } ;
} ;
