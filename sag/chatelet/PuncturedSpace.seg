-- Lemma 1.6 of projective.pdf: for k >= 2, every map R^k \ {0} -> R extends
-- uniquely to R^k:  lemma-1-6 : Equiv (R^k -> R) (R^k \ {0} -> R).
-- "Nonzero" is: some coordinate is invertible (ProjectiveSAG: this is x /= 0).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) (m : Nat) {
 module AS = AffineSpace[l].Over[R,setR] ;
 k : Nat = suc (suc m) ;
 module VH = VectorHartogs[l].Over[R,setR,sqc,k,m,AS.var k,AS.regular k,AS.TwoBy[m,AS.var (suc m) (inr tt),AS.regular (suc m) (inr tt)].divides] ;
 V : U l = AS.Vec k ;
 Pivots (v : V) : U l = (i : Fin k) * RL[R].unit (v i) ;
 NonZero (v : V) : U l = Tr.Trunc[Pivots v].carrier ;
 Punctured : U l = (v : V) * NonZero v ;
 VPivot (v : V) : U l = (i : Fin k) * RL[R].unit (VH.value v (AS.var k i)) ;
 to-cov (v : Punctured) : VH.Open =
  (v.1,Tr.Trunc[Pivots v.1].induction @l (\ t -> VH.Cov v.1) (\ t -> Tr.Trunc[VPivot v.1].proposition)
    (\ p -> Tr.Trunc[VPivot v.1].inc (p.1,Pr.subst R.R RL[R].unit _ _ (sym (AS.coords-point k v.1 p.1)) p.2)) v.2) ;
 restrict (psi : V -> R.R) (v : Punctured) : R.R = psi v.1 ;
 from-cov (w : VH.Open) : Punctured =
  (w.1,Tr.Trunc[VPivot w.1].induction @l (\ t -> NonZero w.1) (\ t -> Tr.Trunc[Pivots w.1].proposition)
    (\ p -> Tr.Trunc[Pivots w.1].inc (p.1,Pr.subst R.R RL[R].unit _ _ (AS.coords-point k w.1 p.1) p.2)) w.2) ;
 pulled (phi : Punctured -> R.R) (w : VH.Open) : R.R = phi (from-cov w) ;
 extend (phi : Punctured -> R.R) (v : V) : R.R = VH.extend (pulled phi) v ;
 punctured-eq (v w : Punctured) (h : Id V v.1 w.1) : Id Punctured v w =
  Pr.Sigma-eq V NonZero v.1 w.1 v.2 w.2 h Tr.Trunc[Pivots w.1].proposition ;
 extend-restrict (phi : Punctured -> R.R) (v : Punctured) : Id R.R (extend phi v.1) (phi v) =
  trans (VH.extend-restrict (pulled phi) (to-cov v)) (ap phi (punctured-eq (from-cov (to-cov v)) v (refl v.1))) ;
 extend-global (psi : V -> R.R) (v : V) : Id R.R (extend (restrict psi) v) (psi v) = VH.Global[psi].result v ;
 lemma-1-6 : Pr.Equiv (V -> R.R) (Punctured -> R.R) =
  (restrict,Pr.qinv (V -> R.R) (Punctured -> R.R) restrict extend
   (\ phi -> F.funext Punctured (\ v -> R.R) _ phi (extend-restrict phi))
   (\ psi -> F.funext V (\ v -> R.R) _ psi (extend-global psi))) ;
} ;
