-- A factorisation of the affine projector gives a frame of the entire
-- torsor family. The truncation is outside the space of global frames.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AS = LineAssociated[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (T : C.Spec Alg -> AS.TI.Tor) {
  module A = AffineLineProjector[l].Over[R,setR,axioms].At[Alg,fp,T] ;
  Frames : U l = (x : A.X) -> (T x).1 ;
  module From (w : A.D.Data) {
   module E = A.From[w] ;
   module Factor (h : E.M.Factors E.entry) {
    module H = E.Fixed.Factor[E.entry,h] ;
    c : E.Fixed.Fixed E.entry = H.column-fixed Alg.ring.o ;
    module Fiber (x : A.X) {
     module L = E.Fiber[x].L ;
     module Pair = E.Fiber[x].Pair ;
     module SM = StandardOpens[l].SumMap[Alg.ring,R,x.1] ;
     v : L.Carrier = E.decode c x ;
     phi (v1 : L.Carrier) : R.R = RS.lin E.n (\ i -> x.1.1 (H.y i)) (E.Fiber[x].coordinates v1) ;
     scalar (a : R.R) (v1 : L.Carrier) :
      Id R.R (phi (L.scale a v1)) (R.mul a (phi v1)) =
      trans (RS.sum-cong E.n (\ i -> R.mul (x.1.1 (H.y i)) (E.Fiber[x].coordinates (L.scale a v1) i)) (\ i -> R.mul (x.1.1 (H.y i)) (R.mul a (E.Fiber[x].coordinates v1 i))) (\ i -> ap (R.mul (x.1.1 (H.y i))) (Pair.scale-right (E.ds i x) a v1)))
       (RS.lin-scale E.n (\ i -> x.1.1 (H.y i)) (E.Fiber[x].coordinates v1) a) ;
     coord (i : Fin E.n) : Id R.R (E.Fiber[x].coordinates v i) (x.1.1 (c.1 i)) =
      trans (E.Fiber[x].coord-rebuild (\ j -> x.1.1 (c.1 j)) i)
       (trans (sym (E.action-at c.1 i x)) (ap x.1.1 (c.2 i))) ;
     normalised : Id R.R (phi v) R.o =
      trans (RS.sum-cong E.n (\ i -> R.mul (x.1.1 (H.y i)) (E.Fiber[x].coordinates v i)) (\ i -> R.mul (x.1.1 (H.y i)) (x.1.1 (c.1 i))) (\ i -> ap (R.mul (x.1.1 (H.y i))) (coord i)))
       (trans (sym (SM.combination E.n H.y c.1))
        (trans (ap x.1.1 (H.coordinate-column Alg.ring.o)) x.1.2.1)) ;
     module Recover = LineFrameRecovery[l].Over[R,setR].At[T x].Recover[v,phi,scalar,normalised] ;
     point : (T x).1 = Recover.point ;
    } ;
    frames : Frames = \ x -> Fiber[x].point ;
   } ;
   theorem (h : E.M.Free E.entry) : Tr.Trunc[Frames].carrier =
    Tr.Trunc[E.M.Factors E.entry].induction @l (\ z -> Tr.Trunc[Frames].carrier)
     (\ z -> Tr.Trunc[Frames].proposition) (\ z -> Tr.Trunc[Frames].inc Factor[z].frames) h ;
  } ;
 } ;
} ;
