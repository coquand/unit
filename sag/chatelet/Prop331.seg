-- Prop 3.3.1 of sevb.pdf: RI : AZ_n -> SB_n (AzumayaProbe.Types,
-- lemma-2-4-3) is an equivalence.  By the delooping lemma (Deloop) it is
-- enough that AZ_n and SB_n are connected sheaves and that Omega RI is an
-- equivalence.
--   * Sheaves: SB_n is Sigma over the sheaves of level l+ (lexness).  AZ_n
--     is a retract of Sigma over the sheaves of level l of the algebra
--     structures (AlgSIP.At.Str), which are sheaves when the carrier is
--     (StrModal).
--   * Loops: h : PGL -> Omega AZ_n, p |-> sip (alpha p) (alpha =
--     SkolemNoetherPGL.iso-of), and k : Omega SB_n -> Aut(P^n), a loop
--     |-> transport along its first component, are equivalences.
--   * k (Omega RI (h p)) = beta p (beta = AutPGL.aut-of): transport along
--     delta^-1 . ap RI (sip (alpha p)) . delta, which is
--     q |-> eps (transport of delta[q]) = beta p q by Triangle.omega.
--   So Omega RI = k^-1 . beta . h^-1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module P2 = Prelude[l++] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module UA1 = Axioms[l+].UnivalenceLemmas[univ @(l+)] ;
module Q0 = Prop331Paths[l] ;
module Q1 = Prop331Paths[l+] ;
module Q2 = Prop331Paths[l++] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n0 : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (cls : Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem)
 (I : U l) (G : I -> U l)
 (sh : [j] SheafClosure[l,j].Over[I,G].Ops)
 (R-modal : SheafTopology[l].Over[I,G].isModal @l R.R)
 (descends : (S : AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Sub (MnAlgebra[l].Over[R,setR,suc (suc n0)].algebra)) ->
   (sh @l).close (AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Basis (MnAlgebra[l].Over[R,setR,suc (suc n0)].algebra) S) ->
   Tr.Trunc[AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Basis (MnAlgebra[l].Over[R,setR,suc (suc n0)].algebra) S].carrier) {
 module TRI = Triangle[l].Over[R,setR,n0,sag,cls,I,G,sh,R-modal,descends] ;
 module DL = TRI.DL ;
 module SP = TRI.SP ;
 module TR = TRI.TR ;
 module AP = DL.AP ;
 module APG = SP.AP ;
 module PQ = DL.PQ ;
 module AS = TR.AS ;
 module T = SheafTopology[l].Over[I,G] ;
 module S0 = SheafLemmas[l,l].Over[I,G] ;
 module S1 = SheafLemmas[l,l+].Over[I,G] ;
 module S2 = SheafLemmas[l,l++].Over[I,G] ;
 module DLV = DeloopLevels[l].Over[I,G,sh] ;
 module Ty = DL.Ty ;
 Mt : AP.Alg = DL.Mt ;
 Pn : U l = PQ.Pn ;
 AZ : U l+ = Ty.AZ ;
 SB : U l++ = Ty.SB ;
 f (A : AZ) : SB = Ty.lemma-2-4-3 A ;

 ------------------------------------------------------------------------
 -- sheaves
 modal-prop0 (X : U l) : Pr.isProp (T.isModal @l X) =
  FL.isProp-Pi I (\ i -> Pr.isEquiv X (G i -> X) (\ x g -> x)) (\ i -> Q0.isEquiv-prop X (G i -> X) (\ x g -> x)) ;
 modal-prop1 (X : U l+) : P1.isProp (T.isModal @(l+) X) =
  Axioms[l+].FunExtLemmas[fe @(l+)].isProp-Pi I (\ i -> P1.isEquiv X (G i -> X) (\ x g -> x))
   (\ i -> Q1.isEquiv-prop X (G i -> X) (\ x g -> x)) ;
 -- being a sheaf, one level up
 up1 (X : U l+) (h : T.isModal @(l+) X) : T.isModal @(l++) X = \ i ->
  struct { sec = (h i).sec ; sec-eq = (h i).sec-eq ; ret = (h i).ret ; ret-eq = (h i).ret-eq } ;
 Mt-modal : T.isModal @l Mt.A =
  S0.modal-Pi DL.Ix (\ i -> DL.Ix -> R.R) (\ i -> S0.modal-Pi DL.Ix (\ j -> R.R) (\ j -> R-modal)) ;
 Pn-modal : T.isModal @(l+) Pn =
  P2.subst (U l+) (\ X -> T.isModal @(l+) X) (AP.RI Mt) Pn DL.delta (AP.RI-modal Mt) ;
 -- SB is Sigma over the sheaves of level l+
 SB' : U l++ = (Xm : (X : U l+) * T.isModal @(l+) X) * (sh @(l++)).close (Id (U l+) Xm.1 Pn) ;
 SB-modal : T.isModal @(l++) SB =
  S2.modal-retract SB' SB (\ b -> ((b.1,b.2.1),b.2.2)) (\ c -> (c.1.1,c.1.2,c.2)) (\ b -> refl b)
   (S2.modal-Sigma ((X : U l+) * T.isModal @(l+) X) (\ Xm -> (sh @(l++)).close (Id (U l+) Xm.1 Pn))
     (sh @(l+)).lex (\ Xm -> (sh @(l++)).modal (Id (U l+) Xm.1 Pn))) ;
 -- AZ is a retract of Sigma over the sheaves of level l of the structures
 module SM = Prop331Str[l].Over[R,setR,I,G] ;
 AZ' : U l+ = (Y : (Xm : (X : U l) * T.isModal @l X) * AS.At[Xm.1].Str) * (sh @(l+)).close (Id AP.Alg (AS.At[Y.1.1].mk Y.2) Mt) ;
 AZ'-modal : T.isModal @(l+) AZ' =
  S1.modal-Sigma ((Xm : (X : U l) * T.isModal @l X) * AS.At[Xm.1].Str)
   (\ Y -> (sh @(l+)).close (Id AP.Alg (AS.At[Y.1.1].mk Y.2) Mt))
   (S1.modal-Sigma ((X : U l) * T.isModal @l X) (\ Xm -> AS.At[Xm.1].Str) (sh @l).lex
     (\ Xm -> AP.up (AS.At[Xm.1].Str) (SM.str-modal Xm.1 Xm.2)))
   (\ Y -> (sh @(l+)).modal (Id AP.Alg (AS.At[Y.1.1].mk Y.2) Mt)) ;
 az-prop (A : AP.Alg) : P1.isProp (T.isModal @l A.A * (sh @(l+)).close (Id AP.Alg A Mt)) =
  P1.isProp-Sigma (T.isModal @l A.A) (\ u -> (sh @(l+)).close (Id AP.Alg A Mt)) (modal-prop0 A.A)
   (\ u -> (sh @(l+)).proposition (Id AP.Alg A Mt)) ;
 module ZS = Q1.Sub[AP.Alg,\ A -> T.isModal @l A.A * (sh @(l+)).close (Id AP.Alg A Mt),az-prop] ;
 to-AZ' (a : AZ) : AZ' =
  (((a.1.A,a.2.1),SM.fields a.1),
   P1.subst AP.Alg (\ B -> (sh @(l+)).close (Id AP.Alg B Mt)) a.1 (AS.At[a.1.A].mk (SM.fields a.1)) (SM.eta a.1) a.2.2) ;
 of-AZ' (c : AZ') : AZ = (AS.At[c.1.1.1].mk c.1.2,c.1.1.2,c.2) ;
 AZ-modal1 : T.isModal @(l+) AZ =
  S1.modal-retract AZ' AZ to-AZ' of-AZ'
   (\ a -> ZS.lift (of-AZ' (to-AZ' a)) a (P1.sym AP.Alg a.1 (AS.At[a.1.A].mk (SM.fields a.1)) (SM.eta a.1))) AZ'-modal ;
 AZ-modal : T.isModal @(l++) AZ = up1 AZ AZ-modal1 ;
 -- base points
 a0 : AZ = (Mt,Mt-modal,(sh @(l+)).inc (Id AP.Alg Mt Mt) (refl Mt)) ;
 b0 : SB = (Pn,Pn-modal,(sh @(l++)).inc (Id (U l+) Pn Pn) (refl Pn)) ;
 sb-prop (X : U l+) : P2.isProp (T.isModal @(l+) X * (sh @(l++)).close (Id (U l+) X Pn)) =
  P2.isProp-Sigma (T.isModal @(l+) X) (\ u -> (sh @(l++)).close (Id (U l+) X Pn)) (modal-prop1 X)
   (\ u -> (sh @(l++)).proposition (Id (U l+) X Pn)) ;
 module YS = Q2.Sub[U l+,\ X -> T.isModal @(l+) X * (sh @(l++)).close (Id (U l+) X Pn),sb-prop] ;
 -- connected
 cA : DLV.D.Connected AZ = \ x y ->
  (sh @(l+)).elim @(l \/ l++) (Id AP.Alg x.1 Mt) ((sh @(l++)).close (Id AZ x y))
   ((sh @(l++)).proposition (Id AZ x y)) ((sh @(l++)).modal (Id AZ x y))
   (\ px -> (sh @(l+)).elim @(l \/ l++) (Id AP.Alg y.1 Mt) ((sh @(l++)).close (Id AZ x y))
     ((sh @(l++)).proposition (Id AZ x y)) ((sh @(l++)).modal (Id AZ x y))
     (\ py -> (sh @(l++)).inc (Id AZ x y) (ZS.lift x y (P1.trans AP.Alg x.1 Mt y.1 px (P1.sym AP.Alg y.1 Mt py))))
     y.2.2)
   x.2.2 ;
 cB : DLV.D.Connected SB = \ x y ->
  (sh @(l++)).elim @(l++) (Id (U l+) x.1 Pn) ((sh @(l++)).close (Id SB x y))
   ((sh @(l++)).proposition (Id SB x y)) ((sh @(l++)).modal (Id SB x y))
   (\ px -> (sh @(l++)).elim @(l++) (Id (U l+) y.1 Pn) ((sh @(l++)).close (Id SB x y))
     ((sh @(l++)).proposition (Id SB x y)) ((sh @(l++)).modal (Id SB x y))
     (\ py -> (sh @(l++)).inc (Id SB x y) (YS.lift x y (P2.trans (U l+) x.1 Pn y.1 px (P2.sym (U l+) y.1 Pn py))))
     y.2.2)
   x.2.2 ;
 -- RI is pointed by delta
 pp : Id SB (f a0) b0 = YS.lift (f a0) b0 DL.delta ;
 Om (w : Id AZ a0 a0) : Id SB b0 b0 = DLV.D.Omega AZ SB f a0 b0 pp w ;

 ------------------------------------------------------------------------
 -- h : PGL = Omega AZ
 h (p : APG.PGL) : Id AZ a0 a0 = ZS.lift a0 a0 (AS.sip Mt Mt (SP.iso-of p)) ;
 hinv (w : Id AZ a0 a0) : APG.PGL = SP.iso-equiv.sec (AS.idToIso Mt Mt (ZS.fst a0 a0 w)) ;
 h-hinv (w : Id AZ a0 a0) : Id (Id AZ a0 a0) (h (hinv w)) w =
  calc (Id AZ a0 a0) {
   h (hinv w)
    =< P2.ap (AS.AlgIso Mt Mt) (Id AZ a0 a0) (\ e -> ZS.lift a0 a0 (AS.sip Mt Mt e)) _ _
        (SP.iso-equiv.sec-eq (AS.idToIso Mt Mt (ZS.fst a0 a0 w))) >
   ZS.lift a0 a0 (AS.sip Mt Mt (AS.idToIso Mt Mt (ZS.fst a0 a0 w)))
    =< P2.ap (Id AP.Alg Mt Mt) (Id AZ a0 a0) (ZS.lift a0 a0) _ _ (AS.sip-idToIso Mt Mt (ZS.fst a0 a0 w)) >
   ZS.lift a0 a0 (ZS.fst a0 a0 w)
    =< ZS.lift-fst a0 a0 w >
   w } ;
 hinv-h (p : APG.PGL) : Id APG.PGL (hinv (h p)) p =
  calc APG.PGL {
   hinv (h p)
    =< P2.ap (Id AP.Alg Mt Mt) APG.PGL (\ s -> SP.iso-equiv.sec (AS.idToIso Mt Mt s)) _ _
        (ZS.fst-lift a0 a0 (AS.sip Mt Mt (SP.iso-of p))) >
   SP.iso-equiv.sec (AS.idToIso Mt Mt (AS.sip Mt Mt (SP.iso-of p)))
    =< P2.ap (AS.AlgIso Mt Mt) APG.PGL SP.iso-equiv.sec _ _ (AS.idToIso-sip Mt Mt (SP.iso-of p)) >
   SP.iso-equiv.sec (SP.iso-of p)
    =< Pr.sec-ret APG.PGL (AS.AlgIso Mt Mt) SP.iso-of SP.iso-equiv p >
   p } ;

 ------------------------------------------------------------------------
 -- k : Omega SB = Aut(P^n)
 coe-inv (X Y : U l+) (u : Id (U l+) X Y) (x : X) : Id X (P1.coe Y X (P1.symU X Y u) (P1.coe X Y u x)) x =
  idJ (U l+) X (\ Z u2 -> Id X (P1.coe Z X (P1.symU X Z u2) (P1.coe X Z u2 x)) x) (refl x) Y u ;
 kf (w : Id SB b0 b0) (q : Pn) : Pn = P1.coe Pn Pn (YS.fst b0 b0 w) q ;
 k (w : Id SB b0 b0) : APG.Aut =
  (kf w,\ q -> P1.coe Pn Pn (P1.symU Pn Pn (YS.fst b0 b0 w)) q,
   \ q -> coe-inv Pn Pn (YS.fst b0 b0 w) q,
   \ q -> P1.coe-sym Pn Pn (YS.fst b0 b0 w) q) ;
 eq-of (a : APG.Aut) : P1.Equiv Pn Pn = (a.1,P1.qinv Pn Pn a.1 a.2.1 a.2.2.2 a.2.2.1) ;
 kinv (a : APG.Aut) : Id SB b0 b0 = YS.lift b0 b0 (UA1.ua Pn Pn (eq-of a)) ;
 k-kinv (a : APG.Aut) : Id APG.Aut (k (kinv a)) a = APG.aut-eq (k (kinv a)) a (\ q ->
  trans (P2.ap (Id (U l+) Pn Pn) Pn (\ u -> P1.coe Pn Pn u q) _ _ (YS.fst-lift b0 b0 (UA1.ua Pn Pn (eq-of a))))
   (UA1.ua-beta Pn Pn (eq-of a) q)) ;
 kinv-k (w : Id SB b0 b0) : Id (Id SB b0 b0) (kinv (k w)) w =
  let { u : Id (U l+) Pn Pn = YS.fst b0 b0 w ;
        e1 : Id (P1.Equiv Pn Pn) (eq-of (k w)) (Axioms[l+].idtoeqv Pn Pn u) =
         P1.Sigma-eq (Pn -> Pn) (\ g -> P1.isEquiv Pn Pn g) (eq-of (k w)).1 (Axioms[l+].idtoeqv Pn Pn u).1
          (eq-of (k w)).2 (Axioms[l+].idtoeqv Pn Pn u).2
          (FL.funext Pn (\ q -> Pn) (eq-of (k w)).1 (Axioms[l+].idtoeqv Pn Pn u).1 (\ q -> sym (UA1.fst-idtoeqv Pn Pn u q)))
          (Q1.isEquiv-prop Pn Pn (Axioms[l+].idtoeqv Pn Pn u).1) ;
        e2 : Id (Id (U l+) Pn Pn) (UA1.ua Pn Pn (Axioms[l+].idtoeqv Pn Pn u)) u =
         P2.sec-ret (Id (U l+) Pn Pn) (P1.Equiv Pn Pn) (Axioms[l+].idtoeqv Pn Pn) (univ @(l+) Pn Pn) u ; }
  in calc (Id SB b0 b0) {
   kinv (k w)
    =< P2.ap (P1.Equiv Pn Pn) (Id SB b0 b0) (\ e -> YS.lift b0 b0 (UA1.ua Pn Pn e)) _ _ e1 >
   YS.lift b0 b0 (UA1.ua Pn Pn (Axioms[l+].idtoeqv Pn Pn u))
    =< P2.ap (Id (U l+) Pn Pn) (Id SB b0 b0) (YS.lift b0 b0) _ _ e2 >
   YS.lift b0 b0 u
    =< YS.lift-fst b0 b0 w >
   w } ;

 ------------------------------------------------------------------------
 -- k (Omega (h p)) = beta p
 dE : P1.Equiv (AP.RI Mt) Pn = (DL.eps,P1.qinv (AP.RI Mt) Pn DL.eps DL.delta-map DL.eps-delta DL.delta-eps) ;
 coe-delta (J : AP.RI Mt) : Id Pn (P1.coe (AP.RI Mt) Pn DL.delta J) (DL.eps J) = UA1.ua-beta (AP.RI Mt) Pn dE J ;
 coe-sym-delta (q : Pn) : Id (AP.RI Mt) (P1.coe Pn (AP.RI Mt) (P2.sym (U l+) (AP.RI Mt) Pn DL.delta) q) (DL.delta-map q) =
  let { J : AP.RI Mt = P1.coe Pn (AP.RI Mt) (P2.sym (U l+) (AP.RI Mt) Pn DL.delta) q ;
        epsJ : Id Pn (DL.eps J) q = trans (sym (coe-delta J)) (P1.coe-sym (AP.RI Mt) Pn DL.delta q) ; }
  in P1.trans (AP.RI Mt) J (DL.delta-map (DL.eps J)) (DL.delta-map q) (P1.sym (AP.RI Mt) (DL.delta-map (DL.eps J)) J (DL.delta-eps J))
   (P1.ap Pn (AP.RI Mt) DL.delta-map (DL.eps J) q epsJ) ;
 coe-trans (X Y Z : U l+) (u : Id (U l+) X Y) (v : Id (U l+) Y Z) (x : X) :
  Id Z (P1.coe X Z (P2.trans (U l+) X Y Z u v) x) (P1.coe Y Z v (P1.coe X Y u x)) =
  idJ (U l+) Y (\ Z2 v2 -> Id Z2 (P1.coe X Z2 (P2.trans (U l+) X Y Z2 u v2) x) (P1.coe Y Z2 v2 (P1.coe X Y u x))) (refl (P1.coe X Y u x)) Z v ;
 tc (X Y Z : U l+) (u u' : Id (U l+) X Y) (v v' : Id (U l+) Y Z) (eu : Id (Id (U l+) X Y) u u') (ev : Id (Id (U l+) Y Z) v v') :
  Id (Id (U l+) X Z) (P2.trans (U l+) X Y Z u v) (P2.trans (U l+) X Y Z u' v') =
  P2.trans (Id (U l+) X Z) (P2.trans (U l+) X Y Z u v) (P2.trans (U l+) X Y Z u' v) (P2.trans (U l+) X Y Z u' v')
   (P2.ap (Id (U l+) X Y) (Id (U l+) X Z) (\ u2 -> P2.trans (U l+) X Y Z u2 v) u u' eu)
   (P2.ap (Id (U l+) Y Z) (Id (U l+) X Z) (\ v2 -> P2.trans (U l+) X Y Z u' v2) v v' ev) ;
 fstSB (x y : SB) (w : Id SB x y) : Id (U l+) x.1 y.1 = YS.fst x y w ;
 module Core (p : APG.PGL) {
  s : Id AP.Alg Mt Mt = AS.sip Mt Mt (SP.iso-of p) ;
  apf : Id SB (f a0) (f a0) = P2.ap AZ SB f a0 a0 (h p) ;
  -- the first component of ap f (h p) is ap RI s
  fst-apf : Id (Id (U l+) (AP.RI Mt) (AP.RI Mt)) (fstSB (f a0) (f a0) apf) (P2.ap AP.Alg (U l+) AP.RI Mt Mt s) =
   P2.trans (Id (U l+) (AP.RI Mt) (AP.RI Mt)) (fstSB (f a0) (f a0) apf) (P2.ap AZ (U l+) (\ a -> AP.RI a.1) a0 a0 (h p))
    (P2.ap AP.Alg (U l+) AP.RI Mt Mt s)
    (Q2.ap-ap AZ SB (U l+) f (\ w -> w.1) a0 a0 (h p))
    (P2.trans (Id (U l+) (AP.RI Mt) (AP.RI Mt)) (P2.ap AZ (U l+) (\ a -> AP.RI a.1) a0 a0 (h p))
      (P2.ap AP.Alg (U l+) AP.RI Mt Mt (P2.ap AZ AP.Alg (\ a -> a.1) a0 a0 (h p))) (P2.ap AP.Alg (U l+) AP.RI Mt Mt s)
      (P2.sym (Id (U l+) (AP.RI Mt) (AP.RI Mt)) (P2.ap AP.Alg (U l+) AP.RI Mt Mt (P2.ap AZ AP.Alg (\ a -> a.1) a0 a0 (h p)))
        (P2.ap AZ (U l+) (\ a -> AP.RI a.1) a0 a0 (h p)) (Q2.ap-ap AZ AP.Alg (U l+) (\ a -> a.1) AP.RI a0 a0 (h p)))
      (P2.ap (Id AP.Alg Mt Mt) (Id (U l+) (AP.RI Mt) (AP.RI Mt)) (P2.ap AP.Alg (U l+) AP.RI Mt Mt) _ _
        (ZS.fst-lift a0 a0 s))) ;
  path : Id (Id (U l+) Pn Pn) (fstSB b0 b0 (Om (h p)))
   (P2.trans (U l+) Pn (AP.RI Mt) Pn (P2.sym (U l+) (AP.RI Mt) Pn DL.delta)
     (P2.trans (U l+) (AP.RI Mt) (AP.RI Mt) Pn (P2.ap AP.Alg (U l+) AP.RI Mt Mt s) DL.delta)) =
   calc (Id (U l+) Pn Pn) {
    fstSB b0 b0 (Om (h p))
     =< Q2.ap-trans SB (U l+) (\ w -> w.1) b0 (f a0) b0 (P2.sym SB (f a0) b0 pp) (P2.trans SB (f a0) (f a0) b0 apf pp) >
    P2.trans (U l+) Pn (AP.RI Mt) Pn (fstSB b0 (f a0) (P2.sym SB (f a0) b0 pp)) (fstSB (f a0) b0 (P2.trans SB (f a0) (f a0) b0 apf pp))
     =< tc Pn (AP.RI Mt) Pn _ _ _ _
         (P2.trans (Id (U l+) Pn (AP.RI Mt)) _ (P2.sym (U l+) (AP.RI Mt) Pn (fstSB (f a0) b0 pp)) _
           (Q2.ap-sym SB (U l+) (\ w -> w.1) (f a0) b0 pp)
           (P2.ap (Id (U l+) (AP.RI Mt) Pn) (Id (U l+) Pn (AP.RI Mt)) (P2.sym (U l+) (AP.RI Mt) Pn) _ _ (YS.fst-lift (f a0) b0 DL.delta)))
         (P2.trans (Id (U l+) (AP.RI Mt) Pn) _ (P2.trans (U l+) (AP.RI Mt) (AP.RI Mt) Pn (fstSB (f a0) (f a0) apf) (fstSB (f a0) b0 pp)) _
           (Q2.ap-trans SB (U l+) (\ w -> w.1) (f a0) (f a0) b0 apf pp)
           (tc (AP.RI Mt) (AP.RI Mt) Pn _ _ _ _ fst-apf (YS.fst-lift (f a0) b0 DL.delta))) >
    P2.trans (U l+) Pn (AP.RI Mt) Pn (P2.sym (U l+) (AP.RI Mt) Pn DL.delta)
     (P2.trans (U l+) (AP.RI Mt) (AP.RI Mt) Pn (P2.ap AP.Alg (U l+) AP.RI Mt Mt s) DL.delta) } ;
  value (q : Pn) : Id Pn (kf (Om (h p)) q) ((APG.aut-of p).1 q) =
   calc Pn {
    kf (Om (h p)) q
     =< P2.ap (Id (U l+) Pn Pn) Pn (\ u -> P1.coe Pn Pn u q) _ _ path >
    P1.coe Pn Pn (P2.trans (U l+) Pn (AP.RI Mt) Pn (P2.sym (U l+) (AP.RI Mt) Pn DL.delta)
      (P2.trans (U l+) (AP.RI Mt) (AP.RI Mt) Pn (P2.ap AP.Alg (U l+) AP.RI Mt Mt s) DL.delta)) q
     =< coe-trans Pn (AP.RI Mt) Pn (P2.sym (U l+) (AP.RI Mt) Pn DL.delta)
         (P2.trans (U l+) (AP.RI Mt) (AP.RI Mt) Pn (P2.ap AP.Alg (U l+) AP.RI Mt Mt s) DL.delta) q >
    P1.coe (AP.RI Mt) Pn (P2.trans (U l+) (AP.RI Mt) (AP.RI Mt) Pn (P2.ap AP.Alg (U l+) AP.RI Mt Mt s) DL.delta)
      (P1.coe Pn (AP.RI Mt) (P2.sym (U l+) (AP.RI Mt) Pn DL.delta) q)
     =< coe-trans (AP.RI Mt) (AP.RI Mt) Pn (P2.ap AP.Alg (U l+) AP.RI Mt Mt s) DL.delta
         (P1.coe Pn (AP.RI Mt) (P2.sym (U l+) (AP.RI Mt) Pn DL.delta) q) >
    P1.coe (AP.RI Mt) Pn DL.delta (TR.coeRI Mt Mt s (P1.coe Pn (AP.RI Mt) (P2.sym (U l+) (AP.RI Mt) Pn DL.delta) q))
     =< P2.ap (AP.RI Mt) Pn (\ J -> P1.coe (AP.RI Mt) Pn DL.delta (TR.coeRI Mt Mt s J)) _ _ (coe-sym-delta q) >
    P1.coe (AP.RI Mt) Pn DL.delta (TR.coeRI Mt Mt s (DL.delta-map q))
     =< P2.ap (AP.RI Mt) Pn (P1.coe (AP.RI Mt) Pn DL.delta) _ _ (TRI.omega p q) >
    P1.coe (AP.RI Mt) Pn DL.delta (DL.delta-map ((APG.aut-of p).1 q))
     =< coe-delta (DL.delta-map ((APG.aut-of p).1 q)) >
    DL.eps (DL.delta-map ((APG.aut-of p).1 q))
     =< DL.eps-delta ((APG.aut-of p).1 q) >
    (APG.aut-of p).1 q } ;
 } ;
 tri (p : APG.PGL) : Id APG.Aut (k (Om (h p))) (APG.aut-of p) = APG.aut-eq (k (Om (h p))) (APG.aut-of p) Core[p].value ;

 ------------------------------------------------------------------------
 -- Omega RI is an equivalence, and Prop 3.3.1
 ao : Pr.isEquiv APG.PGL APG.Aut APG.aut-of = APG.corollary-5-6 ;
 inv (w : Id SB b0 b0) : Id AZ a0 a0 = h (ao.sec (k w)) ;
 om-inv (w : Id SB b0 b0) : Id (Id SB b0 b0) (Om (inv w)) w =
  calc (Id SB b0 b0) {
   Om (inv w)
    =< P2.sym (Id SB b0 b0) (kinv (k (Om (inv w)))) (Om (inv w)) (kinv-k (Om (inv w))) > kinv (k (Om (inv w)))
    =< P2.ap APG.Aut (Id SB b0 b0) kinv _ _ (tri (ao.sec (k w))) > kinv (APG.aut-of (ao.sec (k w)))
    =< P2.ap APG.Aut (Id SB b0 b0) kinv _ _ (ao.sec-eq (k w)) > kinv (k w)
    =< kinv-k w > w } ;
 inv-om (x : Id AZ a0 a0) : Id (Id AZ a0 a0) (inv (Om x)) x =
  calc (Id AZ a0 a0) {
   inv (Om x)
    =< P2.ap (Id AZ a0 a0) (Id AZ a0 a0) (\ z -> inv (Om z)) _ _ (P2.sym (Id AZ a0 a0) (h (hinv x)) x (h-hinv x)) >
   h (ao.sec (k (Om (h (hinv x)))))
    =< P2.ap APG.Aut (Id AZ a0 a0) (\ a -> h (ao.sec a)) _ _ (tri (hinv x)) >
   h (ao.sec (APG.aut-of (hinv x)))
    =< P2.ap APG.PGL (Id AZ a0 a0) h _ _ (Pr.sec-ret APG.PGL APG.Aut APG.aut-of ao (hinv x)) >
   h (hinv x)
    =< h-hinv x > x } ;
 omega-equiv : P2.isEquiv (Id AZ a0 a0) (Id SB b0 b0) Om = P2.qinv (Id AZ a0 a0) (Id SB b0 b0) Om inv om-inv inv-om ;
 -- Prop 3.3.1: AZ_n = SB_n
 prop-3-3-1 : P2.isEquiv AZ SB f = DLV.deloop AZ SB AZ-modal SB-modal a0 b0 cA cB f pp omega-equiv ;
} ;
