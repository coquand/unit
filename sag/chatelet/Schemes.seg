-- SAG 5.1.1: small finite covers by presented affine open embeddings.
-- All cover data, and Scheme X itself, live in U l.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module M = SchemeMaps[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Presentations[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 record Chart (X : U l) {
  presentation : P.Presentation ;
  map : SA.Sol presentation -> X ;
  embedding : M.Embedding (SA.Sol presentation) X map ;
  open-image : (x : X) -> OP.Open (M.Image (SA.Sol presentation) X map x) ;
 } ;
 Domain (X : U l) (c : Chart[X]) : U l = SA.Sol c.presentation ;
 Image (X : U l) (c : Chart[X]) : X -> U l = M.Image (Domain X c) X c.map ;
 Covered (X : U l) (n : Nat) (cs : Fin n -> Chart[X]) : U l =
  (x : X) -> Tr.Trunc[(i : Fin n) * Image X (cs i) x].carrier ;
 record Cover (X : U l) {
  size : Nat ;
  charts : Fin size -> Chart[X] ;
  covers : Covered X size charts ;
 } ;
 Scheme (X : U l) : U l = Tr.Trunc[Cover[X]].carrier ;
 proposition (X : U l) : Pr.isProp (Scheme X) = Tr.Trunc[Cover[X]].proposition ;
 from-cover (X : U l) (c : Cover[X]) : Scheme X = Tr.Trunc[Cover[X]].inc c ;
 AtSet (X : U l) (x : X) : U l = (y : X) -> Pr.isProp (Id X x y) ;
 at-prop (X : U l) (x : X) : Pr.isProp (AtSet X x) =
  F.isProp-Pi X (\ y -> Pr.isProp (Id X x y)) (\ y -> F.isProp-isProp (Id X x y)) ;
 chart-set (X : U l) (c : Chart[X]) (x : X) (u : Image X c x) : AtSet X x =
  Tr.Trunc[M.Fiber (Domain X c) X c.map x].induction @l (\ t -> AtSet X x) (\ t -> at-prop X x)
   (\ w -> Pr.subst X (AtSet X) (c.map w.1) x w.2
    M.Embedded[Domain X c,X,c.map,c.embedding].LocalSet[SA.sol-set c.presentation,w.1].at) u ;
 cover-set (X : U l) (c : Cover[X]) : Pr.isSet X = \ x ->
  Tr.Trunc[(i : Fin c.size) * Image X (c.charts i) x].induction @l
   (\ t -> AtSet X x) (\ t -> at-prop X x) (\ w -> chart-set X (c.charts w.1) x w.2) (c.covers x) ;
 set (X : U l) (s : Scheme X) : Pr.isSet X =
  Tr.Trunc[Cover[X]].induction @l (\ t -> Pr.isSet X) (\ t -> AffineHLevels[l].set-prop X)
   (cover-set X) s ;
 Schemes : U l+ = (X : U l) * Scheme X ;
} ;
