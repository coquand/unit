-- Structure identity for R-algebras equipped with X-indexed points.
-- Univalence is used by induction on the underlying carrier equivalence.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
eqind (T : U l) (P : (T' : U l) -> Pr.Equiv T T' -> U l+) (d : P T (Pr.idEquiv T))
 (T' : U l) (e : Pr.Equiv T T') : P T' e =
 Hi.subst (Pr.Equiv T T') (P T')
  (Axioms[l].idtoeqv T T' ((univ @l T T').sec e)) e ((univ @l T T').sec-eq e)
  (idJ (U l) T (\ Y q -> P Y (Axioms[l].idtoeqv T Y q)) d T' ((univ @l T T').sec e)) ;
module Over (R : CRing) (setR : Pr.isSet R.R) (X : U l) {
 module C = Algebras[l].Over[R,setR] ;
 Decorated : U l+ = (A : C.Algebra) * (X -> C.Spec A) ;
 Operations (T : U l) : U l = T * T * (T -> T -> T) * (T -> T -> T) * (T -> T) * (R.R -> T) * (X -> T -> R.R) ;
 module Ops (T : U l) (s : Operations T) {
  z : T = s.1 ;
  o : T = s.2.1 ;
  ad : T -> T -> T = s.2.2.1 ;
  mu : T -> T -> T = s.2.2.2.1 ;
  ne : T -> T = s.2.2.2.2.1 ;
  co : R.R -> T = s.2.2.2.2.2.1 ;
  pt : X -> T -> R.R = s.2.2.2.2.2.2 ;
  aA : U l = (a b c : T) -> Id T (ad a (ad b c)) (ad (ad a b) c) ;
  aC : U l = (a b : T) -> Id T (ad a b) (ad b a) ;
  aZ : U l = (a : T) -> Id T (ad a z) a ;
  aN : U l = (a : T) -> Id T (ad a (ne a)) z ;
  mA : U l = (a b c : T) -> Id T (mu a (mu b c)) (mu (mu a b) c) ;
  mC : U l = (a b : T) -> Id T (mu a b) (mu b a) ;
  mO : U l = (a : T) -> Id T (mu a o) a ;
  di : U l = (a b c : T) -> Id T (mu a (ad b c)) (ad (mu a b) (mu a c)) ;
  cO : U l = Id T (co R.o) o ;
  cA : U l = (a b : R.R) -> Id T (co (R.add a b)) (ad (co a) (co b)) ;
  cM : U l = (a b : R.R) -> Id T (co (R.mul a b)) (mu (co a) (co b)) ;
  pO : U l = (x : X) -> Id R.R (pt x o) R.o ;
  pA : U l = (x : X) (a b : T) -> Id R.R (pt x (ad a b)) (R.add (pt x a) (pt x b)) ;
  pM : U l = (x : X) (a b : T) -> Id R.R (pt x (mu a b)) (R.mul (pt x a) (pt x b)) ;
  pC : U l = (x : X) (r : R.R) -> Id R.R (pt x (co r)) r ;
  Checks : U l = aA * aC * aZ * aN * mA * mC * mO * di * cO * cA * cM * pO * pA * pM * pC ;
  aA-prop (setT : Pr.isSet T) : Pr.isProp aA = F.isProp-Pi T (\ a -> (b : T) -> (c : T) -> Id T (ad a (ad b c)) (ad (ad a b) c)) (\ a -> F.isProp-Pi T (\ b -> (c : T) -> Id T (ad a (ad b c)) (ad (ad a b) c)) (\ b -> F.isProp-Pi T (\ c -> Id T (ad a (ad b c)) (ad (ad a b) c)) (\ c -> setT _ _))) ;
  aC-prop (setT : Pr.isSet T) : Pr.isProp aC = F.isProp-Pi T (\ a -> (b : T) -> Id T (ad a b) (ad b a)) (\ a -> F.isProp-Pi T (\ b -> Id T (ad a b) (ad b a)) (\ b -> setT _ _)) ;
  aZ-prop (setT : Pr.isSet T) : Pr.isProp aZ = F.isProp-Pi T (\ a -> Id T (ad a z) a) (\ a -> setT _ _) ;
  aN-prop (setT : Pr.isSet T) : Pr.isProp aN = F.isProp-Pi T (\ a -> Id T (ad a (ne a)) z) (\ a -> setT _ _) ;
  mA-prop (setT : Pr.isSet T) : Pr.isProp mA = F.isProp-Pi T (\ a -> (b : T) -> (c : T) -> Id T (mu a (mu b c)) (mu (mu a b) c)) (\ a -> F.isProp-Pi T (\ b -> (c : T) -> Id T (mu a (mu b c)) (mu (mu a b) c)) (\ b -> F.isProp-Pi T (\ c -> Id T (mu a (mu b c)) (mu (mu a b) c)) (\ c -> setT _ _))) ;
  mC-prop (setT : Pr.isSet T) : Pr.isProp mC = F.isProp-Pi T (\ a -> (b : T) -> Id T (mu a b) (mu b a)) (\ a -> F.isProp-Pi T (\ b -> Id T (mu a b) (mu b a)) (\ b -> setT _ _)) ;
  mO-prop (setT : Pr.isSet T) : Pr.isProp mO = F.isProp-Pi T (\ a -> Id T (mu a o) a) (\ a -> setT _ _) ;
  di-prop (setT : Pr.isSet T) : Pr.isProp di = F.isProp-Pi T (\ a -> (b : T) -> (c : T) -> Id T (mu a (ad b c)) (ad (mu a b) (mu a c))) (\ a -> F.isProp-Pi T (\ b -> (c : T) -> Id T (mu a (ad b c)) (ad (mu a b) (mu a c))) (\ b -> F.isProp-Pi T (\ c -> Id T (mu a (ad b c)) (ad (mu a b) (mu a c))) (\ c -> setT _ _))) ;
  cO-prop (setT : Pr.isSet T) : Pr.isProp cO = setT _ _ ;
  cA-prop (setT : Pr.isSet T) : Pr.isProp cA = F.isProp-Pi R.R (\ a -> (b : R.R) -> Id T (co (R.add a b)) (ad (co a) (co b))) (\ a -> F.isProp-Pi R.R (\ b -> Id T (co (R.add a b)) (ad (co a) (co b))) (\ b -> setT _ _)) ;
  cM-prop (setT : Pr.isSet T) : Pr.isProp cM = F.isProp-Pi R.R (\ a -> (b : R.R) -> Id T (co (R.mul a b)) (mu (co a) (co b))) (\ a -> F.isProp-Pi R.R (\ b -> Id T (co (R.mul a b)) (mu (co a) (co b))) (\ b -> setT _ _)) ;
  pO-prop (setT : Pr.isSet T) : Pr.isProp pO = F.isProp-Pi X (\ x -> Id R.R (pt x o) R.o) (\ x -> setR _ _) ;
  pA-prop (setT : Pr.isSet T) : Pr.isProp pA = F.isProp-Pi X (\ x -> (a : T) -> (b : T) -> Id R.R (pt x (ad a b)) (R.add (pt x a) (pt x b))) (\ x -> F.isProp-Pi T (\ a -> (b : T) -> Id R.R (pt x (ad a b)) (R.add (pt x a) (pt x b))) (\ a -> F.isProp-Pi T (\ b -> Id R.R (pt x (ad a b)) (R.add (pt x a) (pt x b))) (\ b -> setR _ _))) ;
  pM-prop (setT : Pr.isSet T) : Pr.isProp pM = F.isProp-Pi X (\ x -> (a : T) -> (b : T) -> Id R.R (pt x (mu a b)) (R.mul (pt x a) (pt x b))) (\ x -> F.isProp-Pi T (\ a -> (b : T) -> Id R.R (pt x (mu a b)) (R.mul (pt x a) (pt x b))) (\ a -> F.isProp-Pi T (\ b -> Id R.R (pt x (mu a b)) (R.mul (pt x a) (pt x b))) (\ b -> setR _ _))) ;
  pC-prop (setT : Pr.isSet T) : Pr.isProp pC = F.isProp-Pi X (\ x -> (r : R.R) -> Id R.R (pt x (co r)) r) (\ x -> F.isProp-Pi R.R (\ r -> Id R.R (pt x (co r)) r) (\ r -> setR _ _)) ;
  checks-prop (setT : Pr.isSet T) : Pr.isProp Checks = Pr.isProp-Sigma aA (\ h -> aC * aZ * aN * mA * mC * mO * di * cO * cA * cM * pO * pA * pM * pC) (aA-prop setT) (\ h -> Pr.isProp-Sigma aC (\ h -> aZ * aN * mA * mC * mO * di * cO * cA * cM * pO * pA * pM * pC) (aC-prop setT) (\ h -> Pr.isProp-Sigma aZ (\ h -> aN * mA * mC * mO * di * cO * cA * cM * pO * pA * pM * pC) (aZ-prop setT) (\ h -> Pr.isProp-Sigma aN (\ h -> mA * mC * mO * di * cO * cA * cM * pO * pA * pM * pC) (aN-prop setT) (\ h -> Pr.isProp-Sigma mA (\ h -> mC * mO * di * cO * cA * cM * pO * pA * pM * pC) (mA-prop setT) (\ h -> Pr.isProp-Sigma mC (\ h -> mO * di * cO * cA * cM * pO * pA * pM * pC) (mC-prop setT) (\ h -> Pr.isProp-Sigma mO (\ h -> di * cO * cA * cM * pO * pA * pM * pC) (mO-prop setT) (\ h -> Pr.isProp-Sigma di (\ h -> cO * cA * cM * pO * pA * pM * pC) (di-prop setT) (\ h -> Pr.isProp-Sigma cO (\ h -> cA * cM * pO * pA * pM * pC) (cO-prop setT) (\ h -> Pr.isProp-Sigma cA (\ h -> cM * pO * pA * pM * pC) (cA-prop setT) (\ h -> Pr.isProp-Sigma cM (\ h -> pO * pA * pM * pC) (cM-prop setT) (\ h -> Pr.isProp-Sigma pO (\ h -> pA * pM * pC) (pO-prop setT) (\ h -> Pr.isProp-Sigma pA (\ h -> pM * pC) (pA-prop setT) (\ h -> Pr.isProp-Sigma pM (\ h -> pC) (pM-prop setT) (\ h -> pC-prop setT)))))))))))))) ;
 } ;
 Laws (T : U l) (s : Operations T) : U l = Pr.isSet T * Ops[T,s].Checks ;
 laws-prop (T : U l) (s : Operations T) : Pr.isProp (Laws T s) = Pr.isProp-Sigma (Pr.isSet T) (\ h -> Ops[T,s].Checks) (AffineHLevels[l].set-prop T) (\ h -> Ops[T,s].checks-prop h) ;
 Structure (T : U l) : U l = (s : Operations T) * Laws T s ;
 Space : U l+ = (T : U l) * Structure T ;
 module Decode (T : U l) (st : Structure T) {
  module O = Ops[T,st.1] ;
  aA : O.aA = st.2.2.1 ;
  aC : O.aC = st.2.2.2.1 ;
  aZ : O.aZ = st.2.2.2.2.1 ;
  aN : O.aN = st.2.2.2.2.2.1 ;
  mA : O.mA = st.2.2.2.2.2.2.1 ;
  mC : O.mC = st.2.2.2.2.2.2.2.1 ;
  mO : O.mO = st.2.2.2.2.2.2.2.2.1 ;
  di : O.di = st.2.2.2.2.2.2.2.2.2.1 ;
  cO : O.cO = st.2.2.2.2.2.2.2.2.2.2.1 ;
  cA : O.cA = st.2.2.2.2.2.2.2.2.2.2.2.1 ;
  cM : O.cM = st.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  pO : O.pO = st.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  pA : O.pA = st.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  pM : O.pM = st.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 ;
  pC : O.pC = st.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 ;
  ring : CRing = mkCRing T O.z O.o O.ad O.mu O.ne aA aC aZ aN mA mC mO di ;
  algebra : C.Algebra = C.mkAlgebra ring st.2.1 (O.co,cO,cA,cM) ;
  points (x : X) : C.Spec algebra = ((O.pt x,pO x,pA x,pM x),pC x) ;
 } ;
 decode (d : Space) : Decorated = (Decode[d.1,d.2].algebra,Decode[d.1,d.2].points) ;
 encode (d : Decorated) : Space =
  (d.1.ring.R,(d.1.ring.z,d.1.ring.o,d.1.ring.add,d.1.ring.mul,d.1.ring.neg,d.1.iota.1,\ x -> (d.2 x).1.1),
   d.1.set,d.1.ring.addA,d.1.ring.addC,d.1.ring.addZ,d.1.ring.addN,d.1.ring.mulA,d.1.ring.mulC,d.1.ring.mulO,d.1.ring.dist,
   d.1.iota.2.1,d.1.iota.2.2.1,d.1.iota.2.2.2,\ x -> (d.2 x).1.2.1,\ x -> (d.2 x).1.2.2.1,\ x -> (d.2 x).1.2.2.2,\ x -> (d.2 x).2) ;
 eta-ring : (ring : CRing) (set : Pr.isSet ring.R) (iota : RingHom[l].Hom R ring)
  (u : X -> C.Spec (C.mkAlgebra ring set iota)) ->
  Id Decorated (C.mkAlgebra ring set iota,u) (decode (encode (C.mkAlgebra ring set iota,u))) = split {
  mkCRing T z o ad mu ne aa ac az an ma mc mo di -> \ set iota u -> refl (C.mkAlgebra (mkCRing T z o ad mu ne aa ac az an ma mc mo di) set iota,u)
 } ;
 eta-algebra : (A : C.Algebra) (u : X -> C.Spec A) ->
  Id Decorated (A,u) (decode (encode (A,u))) = split {
  mkAlgebra ring set iota -> \ u -> eta-ring ring set iota u
 } ;
 module Compare (T T' : U l) (s : Operations T) (t : Operations T') (e : Pr.Equiv T T') {
  module S = Ops[T,s] ; module D = Ops[T',t] ;
  Compatible : U l = Id T' (e.1 S.z) D.z * Id T' (e.1 S.o) D.o *
   ((a b : T) -> Id T' (e.1 (S.ad a b)) (D.ad (e.1 a) (e.1 b))) *
   ((a b : T) -> Id T' (e.1 (S.mu a b)) (D.mu (e.1 a) (e.1 b))) *
   ((a : T) -> Id T' (e.1 (S.ne a)) (D.ne (e.1 a))) *
   ((r : R.R) -> Id T' (e.1 (S.co r)) (D.co r)) *
   ((x : X) (a : T) -> Id R.R (S.pt x a) (D.pt x (e.1 a))) ;
 } ;
 module Same (T : U l) (s t : Operations T) (h : Compare[T,T,s,t,Pr.idEquiv T].Compatible) {
  module S = Ops[T,s] ; module D = Ops[T,t] ;
  z : Id T S.z D.z = h.1 ;
  o : Id T S.o D.o = h.2.1 ;
  ad : Id (T -> T -> T) S.ad D.ad = F.funext T (\ a -> T -> T) S.ad D.ad (\ a -> F.funext T (\ b -> T) (S.ad a) (D.ad a) (h.2.2.1 a)) ;
  mu : Id (T -> T -> T) S.mu D.mu = F.funext T (\ a -> T -> T) S.mu D.mu (\ a -> F.funext T (\ b -> T) (S.mu a) (D.mu a) (h.2.2.2.1 a)) ;
  ne : Id (T -> T) S.ne D.ne = F.funext T (\ a -> T) S.ne D.ne h.2.2.2.2.1 ;
  co : Id (R.R -> T) S.co D.co = F.funext R.R (\ r -> T) S.co D.co h.2.2.2.2.2.1 ;
  pt : Id (X -> T -> R.R) S.pt D.pt = F.funext X (\ x -> T -> R.R) S.pt D.pt (\ x -> F.funext T (\ a -> R.R) (S.pt x) (D.pt x) (h.2.2.2.2.2.2 x)) ;
  equality : Id (Operations T) s t = AffineHLevels[l].pair-path (T) ((T) * (T -> T -> T) * (T -> T -> T) * (T -> T) * (R.R -> T) * (X -> T -> R.R)) s.1 t.1 s.2 t.2 z (AffineHLevels[l].pair-path (T) ((T -> T -> T) * (T -> T -> T) * (T -> T) * (R.R -> T) * (X -> T -> R.R)) s.2.1 t.2.1 s.2.2 t.2.2 o (AffineHLevels[l].pair-path (T -> T -> T) ((T -> T -> T) * (T -> T) * (R.R -> T) * (X -> T -> R.R)) s.2.2.1 t.2.2.1 s.2.2.2 t.2.2.2 ad (AffineHLevels[l].pair-path (T -> T -> T) ((T -> T) * (R.R -> T) * (X -> T -> R.R)) s.2.2.2.1 t.2.2.2.1 s.2.2.2.2 t.2.2.2.2 mu (AffineHLevels[l].pair-path (T -> T) ((R.R -> T) * (X -> T -> R.R)) s.2.2.2.2.1 t.2.2.2.2.1 s.2.2.2.2.2 t.2.2.2.2.2 ne (AffineHLevels[l].pair-path (R.R -> T) ((X -> T -> R.R)) s.2.2.2.2.2.1 t.2.2.2.2.2.1 s.2.2.2.2.2.2 t.2.2.2.2.2.2 co (pt)))))) ;
 } ;
 Mot (T : U l) (st : Structure T) (T' : U l) (e : Pr.Equiv T T') : U l+ =
  (st' : Structure T') -> Compare[T,T',st.1,st'.1,e].Compatible -> Id Space (T,st) (T',st') ;
 base (T : U l) (st : Structure T) : Mot T st T (Pr.idEquiv T) = \ st' h ->
  Hi.ap (Structure T) Space (\ s -> (T,s)) st st'
   (Pr.Sigma-eq (Operations T) (Laws T) st.1 st'.1 st.2 st'.2 (Same[T,st.1,st'.1,h].equality) (laws-prop T st'.1)) ;
 sip-space (T : U l) (st : Structure T) (T' : U l) (e : Pr.Equiv T T') : Mot T st T' e =
  eqind T (Mot T st) (base T st) T' e ;
 sip (A B : C.Algebra) (u : X -> C.Spec A) (v : X -> C.Spec B) (h : C.Hom A B)
  (eh : Pr.isEquiv A.ring.R B.ring.R h.1.1)
  (points : (x : X) (a : A.ring.R) -> Id R.R ((u x).1.1 a) ((v x).1.1 (h.1.1 a))) :
  Id Decorated (A,u) (B,v) =
  Hi.trans Decorated _ _ _ (eta-algebra A u)
  (Hi.trans Decorated _ _ _ (Hi.ap Space Decorated decode (encode (A,u)) (encode (B,v))
   (sip-space A.ring.R (encode (A,u)).2 B.ring.R (h.1.1,eh) (encode (B,v)).2
    (RingHom[l].zero A.ring B.ring h.1,h.1.2.1,h.1.2.2.1,h.1.2.2.2,RingHom[l].negation A.ring B.ring h.1,h.2,points)))
   (Hi.sym Decorated _ _ (eta-algebra B v))) ;
} ;
