-- The leaves of a finite radical/unit tree as a finite list, and
-- comaximality for any choice of one denominator at each leaf.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) (P : FormalMonoidTree[l].Over[A,setA].State -> U l) {
 module Pr = Prelude[l] ;
 module Tr = Truncation[l] ;
 module T = FormalMonoidTree[l].Over[A,setA] ;
 module C = FormalTreeCover[l].Over[A,setA].For[P] ;
 module MC = FormalMonoidCover[l].Over[A,setA] ;
 module IA = Ideals[l].Over[A,setA] ;
 module FS = FinSum[l] ;
 module Sums = FiniteIdeal[l].Sums[A] ;
 Point : U l = (state : T.State) * P state ;
 points : (tree : T.Tree) (state : T.State) -> C.Leaves tree state -> Fin (MC.count tree) -> Point = split {
  leaf -> \ state w i -> (state,w) ;
  branch a left right | il ir -> \ state w ->
   FS.cases (MC.count left) Point (il (T.radical state a) w.1) (MC.count right) (ir (T.invert state a) w.2) } ;
 evidence : (tree : T.Tree) (state : T.State) (w : C.Leaves tree state) (I : IA.Ideal) ->
  ((i : Fin (MC.count tree)) -> T.Meets (points tree state w i).1 I) -> T.Evidence tree state I = split {
  leaf -> \ state w I h -> h (inr tt) ;
  branch a left right | il ir -> \ state w I h ->
   (il (T.radical state a) w.1 I
     (\ i -> Pr.subst Point (\ x -> T.Meets x.1 I) _ _
      (FS.cases-left (MC.count left) Point (points left (T.radical state a) w.1)
       (MC.count right) (points right (T.invert state a) w.2) i)
      (h (FS.left (MC.count left) (MC.count right) i))),
    ir (T.invert state a) w.2 I
     (\ i -> Pr.subst Point (\ x -> T.Meets x.1 I) _ _
      (FS.cases-right (MC.count left) Point (points left (T.radical state a) w.1)
       (MC.count right) (points right (T.invert state a) w.2) i)
      (h (FS.right (MC.count left) (MC.count right) i)))) } ;
 module Partition (tree : T.Tree) (w : C.Leaves tree T.root) (s : Fin (MC.count tree) -> A.R)
  (denominators : (i : Fin (MC.count tree)) -> T.Denominator (points tree T.root w i).1 (s i)) {
  m : Nat = MC.count tree ;
  module G = GeneratedIdeal[l].Over[A,m,s] ;
  I : IA.Ideal = IA.Gen[m,s].ideal ;
  meets (i : Fin m) : T.Meets (points tree T.root w i).1 I =
   Tr.Trunc[T.Intersection (points tree T.root w i).1 I].inc (s i,denominators i,G.generator i) ;
  comaximal : G.Member A.o = T.comaximal tree I (evidence tree T.root w I meets) ;
  Coordinates : U l = Sums.Coordinates m s A.o ;
  partition : Tr.Trunc[Coordinates].carrier =
   Tr.Trunc[G.Witness A.o].induction @l
    (\ x -> Tr.Trunc[Coordinates].carrier) (\ x -> Tr.Trunc[Coordinates].proposition)
    (\ x -> Tr.Trunc[Coordinates].inc (x.1,sym (trans x.2 (RL[A].zl (Sums.lin m s x.1)))))
    comaximal ;
 } ;
} ;
