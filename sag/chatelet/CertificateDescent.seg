-- A principal row ideal descends a scalar factorisation.
-- This calculation uses regularity, not determinants or trace identities.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) {
 open A ; open RL[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module M = RankOneProjector[l].Over[A] ;
 Regular (t : R) : U l =
  (a b : R) -> Id R (mul t a) (mul t b) -> Id R a b ;
 module At (n : Nat) (e : M.Size[n].Matrix) (t : R)
  (regular : Regular t) (w : M.Size[n].ScalarFactor e t) {
  x : M.Size[n].Vector = w.1 ;
  y : M.Size[n].Vector = w.2.1 ;
  xy (i j : Fin n) : Id R (mul (x i) (y j)) (mul t (e i j)) =
   w.2.2.1 i j ;
  contraction : Id R (S.lin n y x) t = w.2.2.2 ;
  -- y_i = g a_i and g belongs to the ideal generated by the y_i.
  PrincipalRow : U l = (g : R) * (a c : M.Size[n].Vector) *
   ((i : Fin n) -> Id R (y i) (mul g (a i))) *
   Id R (S.lin n y c) g ;
  module Given (p : PrincipalRow) {
   g : R = p.1 ;
   a : M.Size[n].Vector = p.2.1 ;
   c : M.Size[n].Vector = p.2.2.1 ;
   y-ga (i : Fin n) : Id R (y i) (mul g (a i)) = p.2.2.2.1 i ;
   generated : Id R (S.lin n y c) g = p.2.2.2.2 ;
   b (i : Fin n) : R = S.lin n (e i) c ;
   xg (i : Fin n) : Id R (mul (x i) g) (mul t (b i)) =
    trans (ap (mul (x i)) (sym generated))
     (trans (sym (S.sum-scale (x i) n (\ j -> mul (y j) (c j))))
      (trans (S.sum-cong n
        (\ j -> mul (x i) (mul (y j) (c j)))
        (\ j -> mul t (mul (e i j) (c j)))
        (\ j -> trans (mulA (x i) (y j) (c j))
         (trans (ap (\ z1 -> mul z1 (c j)) (xy i j))
          (sym (mulA t (e i j) (c j))))))
       (S.sum-scale t n (\ j -> mul (e i j) (c j))))) ;
   factor (i j : Fin n) : Id R (mul (b i) (a j)) (e i j) =
    regular (mul (b i) (a j)) (e i j)
     (trans (mulA t (b i) (a j))
      (trans (ap (\ z1 -> mul z1 (a j)) (sym (xg i)))
       (trans (sym (mulA (x i) g (a j)))
        (trans (ap (mul (x i)) (sym (y-ga j))) (xy i j))))) ;
   term (i : Fin n) : Id R (mul t (mul (a i) (b i))) (mul (y i) (x i)) =
    trans (mul-swap t (a i) (b i))
     (trans (ap (mul (a i)) (sym (xg i)))
      (trans (mul-swap (a i) (x i) g)
       (trans (ap (mul (x i)) (mulC (a i) g))
        (trans (ap (mul (x i)) (sym (y-ga i))) (mulC (x i) (y i)))))) ;
   dot-one : Id R (S.lin n a b) o =
    regular (S.lin n a b) o
     (trans (sym (S.sum-scale t n (\ i -> mul (a i) (b i))))
      (trans (S.sum-cong n (\ i -> mul t (mul (a i) (b i)))
        (\ i -> mul (y i) (x i)) term)
       (trans contraction (sym (mulO t))))) ;
   certificate : M.Size[n].Factors e =
    (b,a,(\ i j -> trans (factor i j) (sym (trans (mulC o (e i j)) (mulO (e i j))))),dot-one) ;
  } ;
  descend (p : PrincipalRow) : M.Size[n].Factors e = Given[p].certificate ;
 } ;
} ;
