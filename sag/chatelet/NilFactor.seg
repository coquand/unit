-- 1 + (nilpotent terms) on the units factors as a(x) b(1/x), a and b
-- unit valued on R.  One term n mu: split mu = g(x) + h(1/x); then
--   1 + e mu = (1 + e g)(1 + e h)(1 - e^2 g h / ((1 + e g)(1 + e h))),
-- so with e = n^(r+1) the error moves to n^(r+2), and n^m = 0 ends the
-- iteration.  Several terms are absorbed one after the other.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC)
 (one-nz : Not (Id R.R R.o R.z)) {
 open R ; open RL[R] ;
 module SP = Split[l].Over[R,setR,sqc] ;
 module G = SP.G ;
 module Pow = AffinePowers[l].Over[R] ;
 module AU = AffineUnits[l].Over[R,setR,sqc,one-nz] ;
 Factored (phi : G.Unit -> R.R) : U l =
  (a : R.R -> G.Unit) * (b : R.R -> G.Unit) * ((u : G.Unit) -> Id R.R (phi u) (mul (a u.1).1 (b u.2.1).1)) ;
 factored-eq (phi psi : G.Unit -> R.R) (h : (u : G.Unit) -> Id R.R (phi u) (psi u)) (f : Factored phi) :
  Factored psi = (f.1,f.2.1,\ u -> trans (sym (h u)) (f.2.2 u)) ;
 -- 1 + nilpotent is a unit
 minus-one-unit : unit (neg o) =
  (neg o,trans (mul-neg (neg o) o) (trans (ap neg (mulO (neg o))) (neg-neg o))) ;
 one-plus-unit (n v : R.R) (m : Nat) (hn : Id R.R (Pow.power n m) z) : unit (add o (mul n v)) =
  AU.nonzero-unit (add o (mul n v)) (\ h -> one-nz (Pow.Units[setR].nilpotent-unit (mul n v)
   (Pr.subst R.R unit (neg o) (mul n v) (sym (neg-uniq o (mul n v) h)) minus-one-unit)
   (m,trans (Pow.power-mul n v m) (trans (ap (\ t -> mul t (Pow.power v m)) hn) (zero-mul (Pow.power v m)))))) ;
 -- the ring identity of one step
 key (e g h ai bi : R.R) (ha : Id R.R (mul (add o (mul e g)) ai) o) (hb : Id R.R (mul (add o (mul e h)) bi) o) :
  Id R.R (add o (mul e (add g h)))
   (mul (mul (add o (mul e g)) (add o (mul e h))) (add o (mul (mul e e) (neg (mul (mul g h) (mul ai bi)))))) =
  let {
   A : R.R = add o (mul e g) ; B : R.R = add o (mul e h) ;
   M : R.R = mul (mul e e) (mul g h) ;
   cancel : Id R.R (mul (mul A B) (mul (mul e e) (mul (mul g h) (mul ai bi)))) M = calc R.R {
    mul (mul A B) (mul (mul e e) (mul (mul g h) (mul ai bi)))
     =< ap (mul (mul A B)) (mulA (mul e e) (mul g h) (mul ai bi)) > mul (mul A B) (mul M (mul ai bi))
     =< ap (mul (mul A B)) (mulC M (mul ai bi)) > mul (mul A B) (mul (mul ai bi) M)
     =< mulA (mul A B) (mul ai bi) M > mul (mul (mul A B) (mul ai bi)) M
     =< ap (\ t -> mul t M) (G.four A B ai bi) > mul (mul (mul A ai) (mul B bi)) M
     =< ap (\ t -> mul t M) (trans (Presentations[l].cong2 R.R mul _ _ _ _ ha hb) (mulO o)) > mul o M
     =< trans (mulC o M) (mulO M) > M } ;
   cross : Id R.R (mul A (mul e h)) (add (mul e h) M) = calc R.R {
    mul A (mul e h) =< mulC A (mul e h) > mul (mul e h) A
     =< dist (mul e h) o (mul e g) > add (mul (mul e h) o) (mul (mul e h) (mul e g))
     =< Presentations[l].cong2 R.R add _ _ _ _ (mulO (mul e h))
       (trans (mulC (mul e h) (mul e g)) (G.four e g e h)) > add (mul e h) M } ;
   expand : Id R.R (mul A B) (add A (add (mul e h) M)) =
    trans (dist A o (mul e h)) (Presentations[l].cong2 R.R add _ _ _ _ (mulO A) cross) ;
  } in sym (calc R.R {
   mul (mul A B) (add o (mul (mul e e) (neg (mul (mul g h) (mul ai bi)))))
    =< dist (mul A B) o (mul (mul e e) (neg (mul (mul g h) (mul ai bi))))
    > add (mul (mul A B) o) (mul (mul A B) (mul (mul e e) (neg (mul (mul g h) (mul ai bi)))))
    =< Presentations[l].cong2 R.R add _ _ _ _ (mulO (mul A B))
      (trans (ap (mul (mul A B)) (mul-neg (mul e e) (mul (mul g h) (mul ai bi))))
       (trans (mul-neg (mul A B) (mul (mul e e) (mul (mul g h) (mul ai bi)))) (ap neg cancel)))
    > add (mul A B) (neg M)
    =< ap (\ t -> add t (neg M)) expand > add (add A (add (mul e h) M)) (neg M)
    =< ap (\ t -> add t (neg M)) (addA A (mul e h) M) > add (add (add A (mul e h)) M) (neg M)
    =< add-neg-cancel (add A (mul e h)) M > add (add o (mul e g)) (mul e h)
    =< sym (addA o (mul e g) (mul e h)) > add o (add (mul e g) (mul e h))
    =< ap (add o) (sym (dist e g h)) > add o (mul e (add g h)) }) ;
 -- one nilpotent n with n^m = 0
 module Nil (n : R.R) (m : Nat) (hn : Id R.R (Pow.power n m) z) {
  E (r : Nat) (mu : G.Unit -> R.R) (u : G.Unit) : R.R = add o (mul (Pow.power n (suc r)) (mu u)) ;
  ee (r : Nat) : Id R.R (mul (Pow.power n (suc r)) (Pow.power n (suc r)))
   (mul (Pow.power n (suc (suc r))) (Pow.power n r)) =
   trans (sym (Pow.power-add n (suc r) (suc r)))
    (trans (ap (\ k -> Pow.power n (suc k)) (plus-suc r r)) (Pow.power-add n (suc (suc r)) r)) ;
  module Step (r : Nat) (mu : G.Unit -> R.R) (s : SP.SplitOf mu) {
   e : R.R = Pow.power n (suc r) ;
   unit-at (v : R.R) : unit (add o (mul e v)) =
    Pr.subst R.R unit _ _ (ap (add o) (mulA n (Pow.power n r) v))
     (one-plus-unit n (mul (Pow.power n r) v) m hn) ;
   A (x : R.R) : G.Unit = (add o (mul e (s.1 x)),unit-at (s.1 x)) ;
   B (y : R.R) : G.Unit = (add o (mul e (s.2.1 y)),unit-at (s.2.1 y)) ;
   W (u : G.Unit) : R.R = mul (mul (s.1 u.1) (s.2.1 u.2.1)) (mul (A u.1).2.1 (B u.2.1).2.1) ;
   mu' (u : G.Unit) : R.R = mul (Pow.power n r) (neg (W u)) ;
   combine (f : Factored (E (suc r) mu')) : Factored (E r mu) =
    (\ x -> G.times (A x) (f.1 x),\ y -> G.times (B y) (f.2.1 y),\ u -> calc R.R {
     add o (mul e (mu u))
      =< ap (\ t -> add o (mul e t)) (s.2.2 u) > add o (mul e (add (s.1 u.1) (s.2.1 u.2.1)))
      =< key e (s.1 u.1) (s.2.1 u.2.1) (A u.1).2.1 (B u.2.1).2.1 (A u.1).2.2 (B u.2.1).2.2
      > mul (mul (A u.1).1 (B u.2.1).1) (add o (mul (mul e e) (neg (W u))))
      =< ap (\ t -> mul (mul (A u.1).1 (B u.2.1).1) (add o t))
        (trans (ap (\ t -> mul t (neg (W u))) (ee r)) (sym (mulA (Pow.power n (suc (suc r))) (Pow.power n r) (neg (W u)))))
      > mul (mul (A u.1).1 (B u.2.1).1) (E (suc r) mu' u)
      =< ap (mul (mul (A u.1).1 (B u.2.1).1)) (f.2.2 u)
      > mul (mul (A u.1).1 (B u.2.1).1) (mul (f.1 u.1).1 (f.2.1 u.2.1).1)
      =< G.four (A u.1).1 (B u.2.1).1 (f.1 u.1).1 (f.2.1 u.2.1).1
      > mul (mul (A u.1).1 (f.1 u.1).1) (mul (B u.2.1).1 (f.2.1 u.2.1).1) }) ;
  } ;
  D (k : Nat) : U l = (r : Nat) (mu : G.Unit -> R.R) ->
   Id R.R (Pow.power n (plus k (suc r))) z -> Tr.Trunc[Factored (E r mu)].carrier ;
  iterate : (k : Nat) -> D k = split {
   zero -> \ r mu hz -> Tr.Trunc[Factored (E r mu)].inc (\ x -> G.one,\ y -> G.one,\ u ->
    trans (ap (\ t -> add o (mul t (mu u))) hz)
     (trans (ap (add o) (zero-mul (mu u))) (trans (addZ o) (sym (mulO o))))) ;
   suc k | ih -> \ r mu hz ->
    Tr.Trunc[SP.SplitOf mu].induction @l (\ t -> Tr.Trunc[Factored (E r mu)].carrier)
     (\ t -> Tr.Trunc[Factored (E r mu)].proposition)
     (\ s -> Tr.Trunc[Factored (E (suc r) Step[r,mu,s].mu')].induction @l
       (\ t -> Tr.Trunc[Factored (E r mu)].carrier) (\ t -> Tr.Trunc[Factored (E r mu)].proposition)
       (\ f -> Tr.Trunc[Factored (E r mu)].inc (Step[r,mu,s].combine f))
       (ih (suc r) Step[r,mu,s].mu' (trans (ap (Pow.power n) (plus-suc k (suc r))) hz)))
     (SP.splitting mu) } ;
  vanish : Id R.R (Pow.power n (plus m (suc zero))) z =
   trans (Pow.power-add n m (suc zero))
    (trans (ap (\ t -> mul t (Pow.power n (suc zero))) hn) (zero-mul (Pow.power n (suc zero)))) ;
  factor (mu : G.Unit -> R.R) : Tr.Trunc[Factored (\ u -> add o (mul n (mu u)))].carrier =
   Tr.Trunc[Factored (E zero mu)].induction @l
    (\ t -> Tr.Trunc[Factored (\ u -> add o (mul n (mu u)))].carrier)
    (\ t -> Tr.Trunc[Factored (\ u -> add o (mul n (mu u)))].proposition)
    (\ f -> Tr.Trunc[Factored (\ u -> add o (mul n (mu u)))].inc
      (factored-eq (E zero mu) (\ u -> add o (mul n (mu u)))
        (\ u -> ap (\ t -> add o (mul t (mu u))) (mulO n)) f))
    (iterate m zero mu vanish) ;
 } ;
 -- several nilpotent terms
 Term : U l = (n : R.R) * (mu : G.Unit -> R.R) * Pow.Nilpotent n ;
 sumT : List Term -> G.Unit -> R.R = split {
  nil -> \ u -> z ;
  cons t ts | r -> \ u -> add (mul t.1 (t.2.1 u)) (r u) } ;
 module Absorb (t : Term) (ts : List Term) (f : Factored (\ u -> add o (sumT ts u))) {
  AB (u : G.Unit) : R.R = mul (f.1 u.1).1 (f.2.1 u.2.1).1 ;
  ABi (u : G.Unit) : R.R = mul (f.1 u.1).2.1 (f.2.1 u.2.1).2.1 ;
  inverse (u : G.Unit) : Id R.R (mul (AB u) (ABi u)) o =
   trans (G.four (f.1 u.1).1 (f.2.1 u.2.1).1 (f.1 u.1).2.1 (f.2.1 u.2.1).2.1)
    (trans (Presentations[l].cong2 R.R mul _ _ _ _ (f.1 u.1).2.2 (f.2.1 u.2.1).2.2) (mulO o)) ;
  mu'' (u : G.Unit) : R.R = mul (t.2.1 u) (ABi u) ;
  pull (u : G.Unit) : Id R.R (add (AB u) (mul t.1 (t.2.1 u))) (mul (AB u) (add o (mul t.1 (mu'' u)))) = sym (calc R.R {
   mul (AB u) (add o (mul t.1 (mu'' u)))
    =< dist (AB u) o (mul t.1 (mu'' u)) > add (mul (AB u) o) (mul (AB u) (mul t.1 (mu'' u)))
    =< Presentations[l].cong2 R.R add _ _ _ _ (mulO (AB u))
      (trans (mul-swap (AB u) t.1 (mu'' u))
       (ap (mul t.1) (trans (mul-swap (AB u) (t.2.1 u) (ABi u))
        (trans (ap (mul (t.2.1 u)) (inverse u)) (mulO (t.2.1 u))))))
    > add (AB u) (mul t.1 (t.2.1 u)) }) ;
  combine (f2 : Factored (\ u -> add o (mul t.1 (mu'' u)))) : Factored (\ u -> add o (sumT (cons t ts) u)) =
   (\ x -> G.times (f.1 x) (f2.1 x),\ y -> G.times (f.2.1 y) (f2.2.1 y),\ u -> calc R.R {
    add o (add (mul t.1 (t.2.1 u)) (sumT ts u))
     =< ap (add o) (addC (mul t.1 (t.2.1 u)) (sumT ts u)) > add o (add (sumT ts u) (mul t.1 (t.2.1 u)))
     =< addA o (sumT ts u) (mul t.1 (t.2.1 u)) > add (add o (sumT ts u)) (mul t.1 (t.2.1 u))
     =< ap (\ v -> add v (mul t.1 (t.2.1 u))) (f.2.2 u) > add (AB u) (mul t.1 (t.2.1 u))
     =< pull u > mul (AB u) (add o (mul t.1 (mu'' u)))
     =< ap (mul (AB u)) (f2.2.2 u) > mul (AB u) (mul (f2.1 u.1).1 (f2.2.1 u.2.1).1)
     =< G.four (f.1 u.1).1 (f.2.1 u.2.1).1 (f2.1 u.1).1 (f2.2.1 u.2.1).1
     > mul (mul (f.1 u.1).1 (f2.1 u.1).1) (mul (f.2.1 u.2.1).1 (f2.2.1 u.2.1).1) }) ;
  result : Tr.Trunc[Factored (\ u -> add o (sumT (cons t ts) u))].carrier =
   Tr.Trunc[(k : Nat) * Id R.R (Pow.power t.1 k) z].induction @l
    (\ s -> Tr.Trunc[Factored (\ u -> add o (sumT (cons t ts) u))].carrier)
    (\ s -> Tr.Trunc[Factored (\ u -> add o (sumT (cons t ts) u))].proposition)
    (\ w -> Tr.Trunc[Factored (\ u -> add o (mul t.1 (mu'' u)))].induction @l
      (\ s -> Tr.Trunc[Factored (\ u -> add o (sumT (cons t ts) u))].carrier)
      (\ s -> Tr.Trunc[Factored (\ u -> add o (sumT (cons t ts) u))].proposition)
      (\ f2 -> Tr.Trunc[Factored (\ u -> add o (sumT (cons t ts) u))].inc (combine f2))
      (Nil[t.1,w.1,w.2].factor mu''))
    t.2.2 ;
 } ;
 factor-terms : (ts : List Term) -> Tr.Trunc[Factored (\ u -> add o (sumT ts u))].carrier = split {
  nil -> Tr.Trunc[Factored (\ u -> add o z)].inc (\ x -> G.one,\ y -> G.one,\ u -> trans (addZ o) (sym (mulO o))) ;
  cons t ts | ih -> Tr.Trunc[Factored (\ u -> add o (sumT ts u))].induction @l
   (\ s -> Tr.Trunc[Factored (\ u -> add o (sumT (cons t ts) u))].carrier)
   (\ s -> Tr.Trunc[Factored (\ u -> add o (sumT (cons t ts) u))].proposition)
   (\ f -> Absorb[t,ts,f].result) ih } ;
} ;
