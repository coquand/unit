-- Iso-induction for NCAlgebra: to prove P B phi for every algebra
-- isomorphism phi : A ~ B, it is enough to prove P A (idIso A).  It is
-- transport along the path to the centre of the contractible type
-- (B : Alg) * AlgIso A B (AlgSIP.pth), and computes to the given case at
-- the identity, up to a path (iso-ind-beta).  Motives at level (l \/ j)+.
level l j ; open Base ;
module Pk1 = Prelude[(l \/ j)+] ;
module Over (R : Ring[l].CRing) (setR : Prelude[l].isSet R.R) {
 module S = AlgSIP[l].Over[R,setR] ;
 iso-ind (A : S.Alg) (P : (B : S.Alg) -> S.AlgIso A B -> U (l \/ j)+) (d : P A (S.idIso A))
  (B : S.Alg) (phi : S.AlgIso A B) : P B phi =
  Pk1.subst (S.Total A) (\ c -> P c.1 c.2) (A, S.idIso A) (B, phi) (S.pth A (B, phi)) d ;
 iso-ind-beta (A : S.Alg) (P : (B : S.Alg) -> S.AlgIso A B -> U (l \/ j)+) (d : P A (S.idIso A))
  : Id (P A (S.idIso A)) (iso-ind A P d A (S.idIso A)) d =
  Pk1.ap (Id (S.Total A) (A, S.idIso A) (A, S.idIso A)) (P A (S.idIso A))
   (\ q -> Pk1.subst (S.Total A) (\ c -> P c.1 c.2) (A, S.idIso A) (A, S.idIso A) q d)
   (S.pth A (A, S.idIso A)) (refl (A, S.idIso A)) (S.pth-id A) ;
 opaque iso-ind ;
} ;
