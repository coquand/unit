-- Structure identity for modules: a linear bijection A ~ B gives A = B in
-- the type of modules.  A module is its carrier, the data (zero, +, -,
-- scalar multiplication) and propositions (set, laws).  By the record
-- eliminator every module is mk of its fields; by induction on
-- equivalences (univalence) the bijection may be taken to be the
-- identity; then + and scaling agree by linearity, zero and negation are
-- determined by +, and the laws are propositions.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module P1 = Prelude[l+] ;
module Over (Rg : A7.CRing) {
 Mod : U l+ = A7.Mod[Rg] ;
 R : U l = Rg.R ;
 prod-prop (A B : U l) (pA : isProp A) (pB : isProp B) : isProp (A * B) =
  isProp-Sigma A (\ a -> B) pA (\ a -> pB) ;
 module At (M : U l) {
  Data : U l = M * (M -> M -> M) * (M -> M) * (R -> M -> M) ;
  module D (d : Data) {
   mz : M = d.1 ; ad : M -> M -> M = d.2.1 ; ng : M -> M = d.2.2.1 ; sc : R -> M -> M = d.2.2.2 ;
   LA : U l = (x y w : M) -> Id M (ad x (ad y w)) (ad (ad x y) w) ;
   LC : U l = (x y : M) -> Id M (ad x y) (ad y x) ;
   LZ : U l = (x : M) -> Id M (ad x mz) x ;
   LN : U l = (x : M) -> Id M (ad x (ng x)) mz ;
   SA : U l = (a b : R) (x : M) -> Id M (sc a (sc b x)) (sc (Rg.mul a b) x) ;
   SO : U l = (x : M) -> Id M (sc Rg.o x) x ;
   SD : U l = (a : R) (x y : M) -> Id M (sc a (ad x y)) (ad (sc a x) (sc a y)) ;
   SE : U l = (a b : R) (x : M) -> Id M (sc (Rg.add a b) x) (ad (sc a x) (sc b x)) ;
   Rest : U l = LA * LC * LZ * LN * SA * SO * SD * SE ;
   Laws : U l = isSet M * Rest ;
   module P (s : isSet M) {
    e (x y : M) : isProp (Id M x y) = s x y ;
    pM (B : M -> U l) (pB : (x : M) -> isProp (B x)) : isProp ((x : M) -> B x) = FL.isProp-Pi M B pB ;
    pR (B : R -> U l) (pB : (x : R) -> isProp (B x)) : isProp ((x : R) -> B x) = FL.isProp-Pi R B pB ;
    la : isProp LA = pM (\ x -> (y w : M) -> Id M (ad x (ad y w)) (ad (ad x y) w)) (\ x ->
     pM (\ y -> (w : M) -> Id M (ad x (ad y w)) (ad (ad x y) w)) (\ y ->
      pM (\ w -> Id M (ad x (ad y w)) (ad (ad x y) w)) (\ w -> e (ad x (ad y w)) (ad (ad x y) w)))) ;
    lc : isProp LC = pM (\ x -> (y : M) -> Id M (ad x y) (ad y x)) (\ x ->
     pM (\ y -> Id M (ad x y) (ad y x)) (\ y -> e (ad x y) (ad y x))) ;
    lz : isProp LZ = pM (\ x -> Id M (ad x mz) x) (\ x -> e (ad x mz) x) ;
    ln : isProp LN = pM (\ x -> Id M (ad x (ng x)) mz) (\ x -> e (ad x (ng x)) mz) ;
    sa : isProp SA = pR (\ a -> (b : R) (x : M) -> Id M (sc a (sc b x)) (sc (Rg.mul a b) x)) (\ a ->
     pR (\ b -> (x : M) -> Id M (sc a (sc b x)) (sc (Rg.mul a b) x)) (\ b ->
      pM (\ x -> Id M (sc a (sc b x)) (sc (Rg.mul a b) x)) (\ x -> e (sc a (sc b x)) (sc (Rg.mul a b) x)))) ;
    so : isProp SO = pM (\ x -> Id M (sc Rg.o x) x) (\ x -> e (sc Rg.o x) x) ;
    sd : isProp SD = pR (\ a -> (x y : M) -> Id M (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ a ->
     pM (\ x -> (y : M) -> Id M (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ x ->
      pM (\ y -> Id M (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ y -> e (sc a (ad x y)) (ad (sc a x) (sc a y))))) ;
    se : isProp SE = pR (\ a -> (b : R) (x : M) -> Id M (sc (Rg.add a b) x) (ad (sc a x) (sc b x))) (\ a ->
     pR (\ b -> (x : M) -> Id M (sc (Rg.add a b) x) (ad (sc a x) (sc b x))) (\ b ->
      pM (\ x -> Id M (sc (Rg.add a b) x) (ad (sc a x) (sc b x))) (\ x -> e (sc (Rg.add a b) x) (ad (sc a x) (sc b x))))) ;
    rest : isProp Rest = prod-prop LA (LC * LZ * LN * SA * SO * SD * SE) la (prod-prop LC (LZ * LN * SA * SO * SD * SE) lc
     (prod-prop LZ (LN * SA * SO * SD * SE) lz (prod-prop LN (SA * SO * SD * SE) ln
     (prod-prop SA (SO * SD * SE) sa (prod-prop SO (SD * SE) so (prod-prop SD SE sd se)))))) ;
   } ;
   laws-prop : isProp Laws = isProp-Sigma (isSet M) (\ s -> Rest) (Torsor[l].isProp-isSet M) (\ s -> P[s].rest) ;
  } ;
  Str : U l = (d : Data) * D[d].Laws ;
  mk (t : Str) : Mod = new A7.Mod[Rg,M,t.2.1,t.1.1,t.1.2.1,t.1.2.2.1,
   t.2.2.1,t.2.2.2.1,t.2.2.2.2.1,t.2.2.2.2.2.1,t.1.2.2.2,
   t.2.2.2.2.2.2.1,t.2.2.2.2.2.2.2.1,t.2.2.2.2.2.2.2.2.1,t.2.2.2.2.2.2.2.2.2] ;
  -- equal data give equal modules
  mk-eq (t t' : Str) (h : Id Data t.1 t'.1) : Id Mod (mk t) (mk t') =
   P1.ap Str Mod mk t t' (Sigma-eq Data (\ d -> D[d].Laws) t.1 t'.1 t.2 t'.2 h (D[t'.1].laws-prop)) ;
  data-eq (z z' : M) (a a' : M -> M -> M) (n n' : M -> M) (c c' : R -> M -> M)
   (hz : Id M z z') (ha : Id (M -> M -> M) a a') (hn : Id (M -> M) n n') (hc : Id (R -> M -> M) c c') :
   Id Data (z,a,n,c) (z',a',n',c') =
   trans Data (z,a,n,c) (z',a,n,c) (z',a',n',c') (ap M Data (\ u -> (u,a,n,c)) z z' hz)
    (trans Data (z',a,n,c) (z',a',n,c) (z',a',n',c') (ap (M -> M -> M) Data (\ u -> (z',u,n,c)) a a' ha)
     (trans Data (z',a',n,c) (z',a',n',c) (z',a',n',c') (ap (M -> M) Data (\ u -> (z',a',u,c)) n n' hn)
      (ap (R -> M -> M) Data (\ u -> (z',a',n',u)) c c' hc))) ;
 } ;
 -- every module is mk of its fields
 fields (A : Mod) : At[A.M].Str = ((A.mz,A.madd,A.mneg,A.sm),
  (A.setM,A.maddA,A.maddC,A.maddZ,A.maddN,A.smA,A.smO,A.smD,A.smE)) ;
 eta : (A : Mod) -> Id Mod A (At[A.M].mk (fields A)) = split {
  Mod M setM mz madd mneg maddA maddC maddZ maddN sm smA smO smD smE ->
   refl (new A7.Mod[Rg,M,setM,mz,madd,mneg,maddA,maddC,maddZ,maddN,sm,smA,smO,smD,smE]) } ;
 -- linear bijections
 Additive (A B : Mod) (f : A.M -> B.M) : U l = (x y : A.M) -> Id B.M (f (A.madd x y)) (B.madd (f x) (f y)) ;
 Scalar (A B : Mod) (f : A.M -> B.M) : U l = (a : R) (x : A.M) -> Id B.M (f (A.sm a x)) (B.sm a (f x)) ;
 LinEquiv (A B : Mod) : U l = (e : Equiv A.M B.M) * Additive A B e.1 * Scalar A B e.1 ;
 module Core (M : U l) (t : At[M].Str) {
  A : Mod = At[M].mk t ;
  Mot (N : U l) (e : Equiv M N) : U l+ = (t' : At[N].Str) ->
   Additive A (At[N].mk t') e.1 -> Scalar A (At[N].mk t') e.1 -> Id Mod A (At[N].mk t') ;
  base : Mot M (idEquiv M) = \ t' ha hs ->
   At[M].mk-eq t t' (At[M].data-eq _ _ _ _ _ _ _ _
    (calc M {
     A.mz =< sym M _ _ (t'.2.2.2.2.1 A.mz) > t'.1.2.1 A.mz t'.1.1
      =< sym M _ _ (ha A.mz t'.1.1) > A.madd A.mz t'.1.1
      =< A.maddC A.mz t'.1.1 > A.madd t'.1.1 A.mz
      =< A.maddZ t'.1.1 > t'.1.1 })
    (FL.funext M (\ x -> M -> M) _ _ (\ x -> FL.funext M (\ y -> M) _ _ (\ y -> ha x y)))
    (FL.funext M (\ x -> M) _ _ (\ x -> A7.MA[Rg,At[M].mk t'].mneg-uniq x (A.mneg x)
      (trans M _ _ _ (sym M _ _ (ha x (A.mneg x))) (trans M _ _ _ (A.maddN x)
       (calc M {
        A.mz =< sym M _ _ (t'.2.2.2.2.1 A.mz) > t'.1.2.1 A.mz t'.1.1
         =< sym M _ _ (ha A.mz t'.1.1) > A.madd A.mz t'.1.1
         =< A.maddC A.mz t'.1.1 > A.madd t'.1.1 A.mz
         =< A.maddZ t'.1.1 > t'.1.1 })))))
    (FL.funext R (\ a -> M -> M) _ _ (\ a -> FL.funext M (\ x -> M) _ _ (\ x -> hs a x)))) ;
  theorem (N : U l) (e : Equiv M N) : Mot N e = Torsor[l].eqind M Mot base N e ;
 } ;
 -- the structure identity principle (one direction)
 sip (A B : Mod) (l : LinEquiv A B) : Id Mod A B =
  P1.trans Mod A (At[A.M].mk (fields A)) B (eta A)
   (P1.trans Mod (At[A.M].mk (fields A)) (At[B.M].mk (fields B)) B
    (Core[A.M,fields A].theorem B.M l.1 (fields B) l.2.1 l.2.2)
    (P1.sym Mod B (At[B.M].mk (fields B)) (eta B))) ;
} ;
