-- Step 4 probe: weak quasi-coherence descends for a module with a sheaf
-- carrier.  Use the kernel of the two maps M^Root -> M^(Root x Root).
-- This is the fraction-level kernel argument of Kernel716, specialised
-- to constant functions; no tensor product or flatness is used.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ; module A7 = Alg73[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module BO = BundleOperations[l].Over[R,setR,axioms] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module At (M : MD.Module) (modal : ET.T.isModal @l M.M) {
  module MA = A7.MA[MD.ring,M] ;
  module Pt = Affine[l].PtL[MD.ring,M] ;
  module SC = BO.Scalar[M] ;
  qc-prop : Pr.isProp (MD.WeaklyQC M) = LineAssociated[l].Over[R,setR].QCProp[M].theorem ;
  module Generator (idx : ET.I) {
   X : U l = ET.Root idx ;
   module Roots = EtaleRoots[l].Over[R,setR].Generator[idx].Roots ;
   affine : FA.Affine X = Tr1.Trunc[FA.AffineWitness X].inc
    (Roots.B.A,Roots.B.fp,Functions[l].inverse (C.Spec Roots.B.A) X Roots.spec-root) ;
   scheme : SB.S.Scheme X = SB.affine X affine ;
   separated (a b : M.M) (p : X -> Id M.M a b) : Id M.M a b =
    (SL.modal-Id M.M modal a b idx).sec
     (Tr.Trunc[X].induction @l (\ q -> Id M.M a b) (\ q -> M.setM a b) p) ;
   module Constant (h : X -> M.M) (agree : (x y : X) -> Id M.M (h x) (h y)) {
    module D = SectionDescent[l].At[X,M.M,M.setM,h,agree] ;
    lift (q : ET.G idx) : M.M = D.Inhabited[q].result.1 ;
    value : M.M = (modal idx).sec lift ;
    point (x : X) : Id M.M value (h x) =
     trans (Pr.happly (ET.G idx) (\ q -> M.M) _ lift ((modal idx).sec-eq lift) (ET.root-inc idx x))
      (D.Inhabited[ET.root-inc idx x].result.2 x) ;
    opaque value ;
   } ;
   module Local (w : X -> MD.WeaklyQC M) {
    P : MD.Module = MD.pi X (\ x -> M) ;
    wP : MD.WeaklyQC P = BO.Sections[X,scheme,\ x -> M,w].theorem-7-1-10 ;
    Q : MD.Module = MD.pi X (\ x -> P) ;
    wQ : MD.WeaklyQC Q = BO.Sections[X,scheme,\ x -> P,\ x -> wP].theorem-7-1-10 ;
    module SP = BO.Scalar[P] ; module SQ = BO.Scalar[Q] ;
    module WP = Affine[l].Aff[MD.ring,Top,\ t -> P] ;
    module WQ = Affine[l].Aff[MD.ring,Top,\ t -> Q] ;
    module Represent (r : R.R) (s : MD.RA.unit r -> M.M)
     (a : WP.Rep (\ t -> r) (\ t d x -> s d)) {
     numerator : X -> M.M = a.1 tt ;
     degree : Base.Nat = a.2.1 ;
     eqn (d : MD.RA.unit r) (x : X) :
      Id M.M (s d) (M.sm (MD.RA.pw d.1 degree) (numerator x)) =
      ap (\ h -> h x) (a.2.2 tt d) ;
     numerator-unit (d : MD.RA.unit r) (x : X) :
      Id M.M (numerator x) (M.sm (MD.RA.pw r degree) (s d)) =
      trans (sym (Pt.cancel-pw d.1 r (trans (R.mulC d.1 r) d.2) degree (numerator x)))
       (ap (M.sm (MD.RA.pw r degree)) (sym (eqn d x))) ;
     difference : Q.M = \ x y -> MA.sub (numerator x) (numerator y) ;
     vanish (d : MD.RA.unit r) : Id Q.M difference Q.mz =
      F.funext X (\ x -> P.M) _ _ (\ x -> F.funext X (\ y -> M.M) _ _ (\ y ->
       trans (ap (\ v -> MA.sub (numerator x) v)
        (trans (numerator-unit d y) (sym (numerator-unit d x)))) (MA.sub-self (numerator x)))) ;
     module Raised (k : WQ.Kill (\ t -> r) (\ t -> difference)) {
      exponent : Base.Nat = k.1 ;
      scaled (x : X) : M.M = M.sm (MD.RA.pw r exponent) (numerator x) ;
      agree (x y : X) : Id M.M (scaled x) (scaled y) =
       MA.sub-zero (scaled x) (scaled y)
        (trans (sym (MA.sm-sub (MD.RA.pw r exponent) (numerator x) (numerator y)))
         (ap (\ h -> h x y) (k.2 tt))) ;
      module D = Constant[scaled,agree] ;
      result : SC.Rep r s = (D.value,A7.plusN exponent degree,\ d ->
       separated (s d) (M.sm (MD.RA.pw d.1 (A7.plusN exponent degree)) D.value) (\ x ->
        trans (eqn d x)
         (trans (sym (Pt.raise r d.1 d.2 exponent degree (numerator x)))
          (ap (M.sm (MD.RA.pw d.1 (A7.plusN exponent degree))) (sym (D.point x)))))) ;
     } ;
     result : Tr.Trunc[SC.Rep r s].carrier =
      Tr.Trunc[WQ.Kill (\ t -> r) (\ t -> difference)].induction @l
       (\ z -> Tr.Trunc[SC.Rep r s].carrier) (\ z -> Tr.Trunc[SC.Rep r s].proposition)
       (\ k -> Tr.Trunc[SC.Rep r s].inc Raised[k].result)
       ((wQ (\ t -> r)).2 (\ t -> difference) (\ t -> vanish)) ;
    } ;
    represent (r : R.R) (s : MD.RA.unit r -> M.M) : Tr.Trunc[SC.Rep r s].carrier =
     Tr.Trunc[WP.Rep (\ t -> r) (\ t d x -> s d)].induction @l
      (\ z -> Tr.Trunc[SC.Rep r s].carrier) (\ z -> Tr.Trunc[SC.Rep r s].proposition)
      (\ a -> Represent[r,s,a].result) ((wP (\ t -> r)).1 (\ t d x -> s d)) ;
    killed (r : R.R) (m : M.M) (v : MD.RA.unit r -> Id M.M m M.mz) :
     Tr.Trunc[SC.Kill r m].carrier =
     Tr.Trunc[WP.Kill (\ t -> r) (\ t x -> m)].induction @l
      (\ z -> Tr.Trunc[SC.Kill r m].carrier) (\ z -> Tr.Trunc[SC.Kill r m].proposition)
      (\ k -> Tr.Trunc[SC.Kill r m].inc
       (k.1,separated (M.sm (MD.RA.pw r k.1) m) M.mz (\ x -> ap (\ h -> h x) (k.2 tt))))
      ((wP (\ t -> r)).2 (\ t x -> m) (\ t d -> F.funext X (\ x -> M.M) _ _ (\ x -> v d))) ;
    theorem : MD.WeaklyQC M = SC.Clauses[represent,killed].theorem ;
    opaque theorem ;
   } ;
  } ;
  qc-modal : ET.T.isModal @l (MD.WeaklyQC M) =
   SL.modal-of-sec (MD.WeaklyQC M) qc-prop
    (\ idx h -> Generator[idx].Local[\ x -> h (ET.root-inc idx x)].theorem) ;
  opaque qc-modal ;
 } ;
} ;
