-- Polynomial base change respects a commuting triangle of base rings.
level l ; open Ring[l] ;
module Over (A C D : CRing)
 (setA : Prelude[l].isSet A.R) (setC : Prelude[l].isSet C.R) (setD : Prelude[l].isSet D.R)
 (phi : RingHom[l].Hom A C) (theta : RingHom[l].Hom C D) (psi : RingHom[l].Hom A D)
 (triangle : (a : A.R) -> Id D.R (theta.1 (phi.1 a)) (psi.1 a)) {
 module AC = PolynomialMap[l].Over[A,C,setA,setC,phi] ;
 module CD = PolynomialMap[l].Over[C,D,setC,setD,theta] ;
 module AD = PolynomialMap[l].Over[A,D,setA,setD,psi] ;
 composite : RingHom[l].Hom AC.B.ring AD.D.ring =
  RingHom[l].compose AC.B.ring AC.D.ring AD.D.ring CD.hom AC.hom ;
 constants (a : A.R) : Id AD.D.Carrier (composite.1 (AC.B.constant a)) (AD.D.constant (psi.1 a)) =
  trans (ap CD.hom.1 (AC.Extension.on-constants a))
   (trans (CD.Extension.on-constants (phi.1 a)) (ap AD.D.constant (triangle a))) ;
 variable : Id AD.D.Carrier (composite.1 AC.B.variable) AD.D.variable =
  trans (ap CD.hom.1 AC.Extension.on-variable) CD.Extension.on-variable ;
 equality : Id (RingHom[l].Hom AC.B.ring AD.D.ring) composite AD.hom =
  AD.Extension.unique composite constants variable ;
 pointwise (p : AC.B.Carrier) :
  Id AD.D.Carrier (CD.hom.1 (AC.hom.1 p)) (AD.hom.1 p) =
  ap (\ h -> h.1 p) equality ;
} ;
