-- A unit-valued transition function determines a cocycle on chart representatives.
-- Convention: e_hi = t(x) . e_lo on lo(x)=hi(x^-1).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module GL = Torsor[l].AbL[G.group] ;
 lu (a b : R.R) (h : Id R.R (R.mul a b) R.o) : G.Unit = (a,b,h) ;
 ru (a b : R.R) (h : Id R.R (R.mul a b) R.o) : G.Unit = (b,a,trans (R.mulC b a) h) ;
 module At (t : G.Unit -> G.Unit) {
  c : (u v : P.C) -> P.relation u v -> G.Unit = split {
   lo a -> split { lo b -> \ h -> G.one ; hi b -> \ h -> G.inverse (t (lu a b h)) } ;
   hi a -> split { lo b -> \ h -> t (ru a b h) ; hi b -> \ h -> G.one } } ;
  -- Equal chart coordinates give equal units, independently of inverse proofs.
  teq (u v : G.Unit) (h : Id R.R u.1 v.1) : Id G.Unit (t u) (t v) = ap t (G.eq u v h) ;
  ieq (u v : G.Unit) (h : Id R.R u.1 v.1) : Id G.Unit (G.inverse (t u)) (G.inverse (t v)) = ap G.inverse (teq u v h) ;
  coc : (u v w : P.C) (h : P.relation u v) (k : P.relation v w) ->
   Id G.Unit (G.times (c u v h) (c v w k)) (c u w (P.relation-trans u v w h k)) = split {
   lo a -> split {
    lo b -> split {
     lo d -> \ h k -> G.unitr G.one ;
     hi d -> \ h k -> trans (GL.unitl (G.inverse (t (lu b d k))))
      (ieq (lu b d k) (lu a d (P.relation-trans (lo a) (lo b) (hi d) h k)) (sym h)) } ;
    hi b -> split {
     lo d -> \ h k -> trans
      (ap (G.times (G.inverse (t (lu a b h))))
       (teq (ru b d k) (lu a b h) (sym (P.relation-trans (lo a) (hi b) (lo d) h k))))
      (GL.invl (t (lu a b h))) ;
     hi d -> \ h k -> trans (G.unitr (G.inverse (t (lu a b h))))
      (ieq (lu a b h) (lu a d (P.relation-trans (lo a) (hi b) (hi d) h k)) (refl a)) } } ;
   hi a -> split {
    lo b -> split {
     lo d -> \ h k -> trans (G.unitr (t (ru a b h)))
      (teq (ru a b h) (ru a d (P.relation-trans (hi a) (lo b) (lo d) h k)) k) ;
     hi d -> \ h k -> trans
      (ap (G.times (t (ru a b h))) (ieq (lu b d k) (ru a b h) (refl b)))
      (G.invr (t (ru a b h))) } ;
    hi b -> split {
     lo d -> \ h k -> trans (GL.unitl (t (ru b d k)))
      (teq (ru b d k) (ru a d (P.relation-trans (hi a) (hi b) (lo d) h k)) (refl d)) ;
     hi d -> \ h k -> G.unitr G.one } } } ;
 } ;
} ;
