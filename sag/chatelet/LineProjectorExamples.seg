-- Small Picard line families are covered by the actual affine theorem.
-- Boundary tests retain the frame weight and the trace-one hypothesis.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Lines = PicardLines[l].Over[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module SmallLine (Alg : C.Algebra) (fp : P.FP Alg) (B : C.Spec Alg -> Lines.Line) {
  module Theorem = AffineLineProjector[l].Over[R,setR,axioms].At[Alg,fp,\ x -> Lines.torsor (B x)] ;
  represented : Truncation[l].Trunc[Theorem.Witness].carrier = Theorem.theorem ;
 } ;
 module At (T : Lines.TI.Tor) {
  module Pair = LinePairing[l].Over[R,setR].At[T] ;
  #fails {
   dropped-frame-weight (a : G.Unit) (t : T.1) :
    Id Pair.L.Carrier Pair.Based[T.2.1 a t].frame Pair.Based[t].frame =
    Pair.FrameAction[a,t].theorem ;
  } ;
  #fails {
   zero-is-a-basis : Id R.R (Pair.pair Pair.D.zero Pair.L.zero) R.o =
    Pair.zero-right Pair.D.zero ;
  } ;
 } ;
} ;
