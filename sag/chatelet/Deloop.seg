-- Lemma 3.1.2 of sevb.pdf (delooping), for any topology given by sh.  Let
-- A, B : U j be sheaves, pointed by a0, b0 and connected (any two points
-- are T-locally equal), and f : A -> B with p : f a0 = b0 such that
--     Omega f : q |-> p^-1 . (ap f q . p)
-- is an equivalence.  Then f is an equivalence.
--   1. "ap f at x, y has contractible fibres" is a sheaf proposition, so
--      by connectedness of A it suffices to take x = y = a0, where ap f is
--      Omega f up to conjugation by p (DeloopEquiv.ap-of-omega).
--   2. So the fibres of f are propositions; they are sheaves, so by
--      connectedness of B each is inhabited, as the fibre over b0 is.
-- One level j (used at j = l++).  The coherence is in DeloopEquiv.
level l j ; open Base ;
module Pj = Prelude[j] ;
module DE = DeloopEquiv[j] ;
module CT = FunExtUA[j] ;
module FL = Axioms[j].FunExtLemmas[fe @j] ;
module Over (I : U l) (G : I -> U l) (sh : [m] SheafClosure[l,m].Over[I,G].Ops) {
 module T = SheafTopology[l].Over[I,G] ;
 module SL = SheafLemmas[l,j].Over[I,G] ;
 modal-isContr (X : U j) (hX : T.isModal @j X) : T.isModal @j (CT.isContr X) =
  SL.modal-Sigma X (\ c -> (y : X) -> Id X c y) hX (\ c -> SL.modal-Pi X (\ y -> Id X c y) (\ y -> SL.modal-Id X hX c y)) ;
 modal-fib (A B : U j) (hA : T.isModal @j A) (hB : T.isModal @j B) (f : A -> B) (b : B) : T.isModal @j (DE.fib A B f b) =
  SL.modal-Sigma A (\ a -> Id B (f a) b) hA (\ a -> SL.modal-Id B hB (f a) b) ;
 Connected (A : U j) : U (l \/ j) = (x y : A) -> (sh @j).close (Id A x y) ;
 Omega (A B : U j) (f : A -> B) (a0 : A) (b0 : B) (p : Id B (f a0) b0) (q : Id A a0 a0) : Id B b0 b0 =
  DE.Lp B (f a0) b0 p (Pj.ap A B f a0 a0 q) ;
 module Lemma (A B : U j) (hA : T.isModal @j A) (hB : T.isModal @j B) (a0 : A) (b0 : B)
  (cA : Connected A) (cB : Connected B) (f : A -> B) (p : Id B (f a0) b0)
  (omega : Pj.isEquiv (Id A a0 a0) (Id B b0 b0) (Omega A B f a0 b0 p)) {
  -- 1. ap f is an equivalence everywhere
  Q (x y : A) : U j = (w : Id B (f x) (f y)) -> CT.isContr (DE.fib (Id A x y) (Id B (f x) (f y)) (Pj.ap A B f x y) w) ;
  Q-prop (x y : A) : Pj.isProp (Q x y) =
   FL.isProp-Pi (Id B (f x) (f y)) (\ w -> CT.isContr (DE.fib (Id A x y) (Id B (f x) (f y)) (Pj.ap A B f x y) w))
    (\ w -> Torsor[j].isProp-isContr (DE.fib (Id A x y) (Id B (f x) (f y)) (Pj.ap A B f x y) w)) ;
  Q-modal (x y : A) : T.isModal @j (Q x y) =
   SL.modal-Pi (Id B (f x) (f y)) (\ w -> CT.isContr (DE.fib (Id A x y) (Id B (f x) (f y)) (Pj.ap A B f x y) w))
    (\ w -> modal-isContr (DE.fib (Id A x y) (Id B (f x) (f y)) (Pj.ap A B f x y) w)
      (modal-fib (Id A x y) (Id B (f x) (f y)) (SL.modal-Id A hA x y) (SL.modal-Id B hB (f x) (f y)) (Pj.ap A B f x y) w)) ;
  Q0 : Q a0 a0 = DE.equiv-contr (Id A a0 a0) (Id B (f a0) (f a0)) (Pj.ap A B f a0 a0)
   (DE.ap-of-omega A B f a0 b0 p omega) ;
  move (x y : A) (r : Id A a0 x) (s : Id A a0 y) : Q x y =
   idJ A a0 (\ x1 r1 -> Q x1 y) (idJ A a0 (\ y1 s1 -> Q a0 y1) Q0 y s) x r ;
  Q-all (x y : A) : Q x y =
   (sh @j).elim @j (Id A a0 x) (Q x y) (Q-prop x y) (Q-modal x y)
    (\ r -> (sh @j).elim @j (Id A a0 y) (Q x y) (Q-prop x y) (Q-modal x y) (\ s -> move x y r s) (cA a0 y))
    (cA a0 x) ;
  emb (x y : A) : Pj.isEquiv (Id A x y) (Id B (f x) (f y)) (Pj.ap A B f x y) =
   DE.contr-equiv (Id A x y) (Id B (f x) (f y)) (Pj.ap A B f x y) (Q-all x y) ;
  -- 2. every fibre is inhabited
  inh (b : B) : DE.fib A B f b =
   (sh @j).elim @j (Id B b0 b) (DE.fib A B f b) (DE.fib-prop A B f emb b) (modal-fib A B hA hB f b)
    (\ r -> (a0,Pj.trans B (f a0) b0 b p r)) (cB b0 b) ;
  theorem : Pj.isEquiv A B f =
   DE.contr-equiv A B f (\ b -> (inh b,\ v -> DE.fib-prop A B f emb b (inh b) v)) ;
 } ;
} ;
