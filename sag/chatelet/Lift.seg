-- Every map phi : P^n -> P^t (n = n0+1 >= 1) merely lifts to vectors:
-- there are d : Z and F : R^{n+1} \ {0} -> R^{t+1} \ {0} with
--   phi [x] = [F x]   and   F (u x) = u^d F x  for units u.
-- In definition (i), phi q is a line B q with a nonzero equivariant vector
-- v_q on it.  By the classification cls (Theorem 7.3; Theorem73One for
-- n = 1), B = l0 (x) O(d), and l0 is merely trivial.
-- The fibre of O(d) at [x] has the frame w_x given by the representative
-- x, and w_{u x} = u^-d w_x; so F x = v_[x] (w_x) has weight d.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = Prelude[l+] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n0 : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (cls : Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem) (t : Nat) {
 open R ; open RL[R] ;
 module CL = Classification[l].Over[R,setR,n0,sag.sqc,sag.loc] ;
 module TW = CL.TW ;
 module Q2 = CL.Q2 ;
 module G = CL.G ;
 module L = CL.L ;
 module TI = L.TI ;
 module PSt = ProjectiveSpace[l].Over[R,setR,t] ;
 module Lnt = PSt.Ln ;
 module Q2t = PSt.Q2 ;
 Degree : U l = CL.Degree ;
 Pn : U l = Q2.Pn ;
 Car (a : L.Line) : U l = (L.torsor a).1 ;
 act (a : L.Line) (g : G.Unit) (s : Car a) : Car a = (L.torsor a).2.1 g s ;
 scale-point (u : G.Unit) (x : Q2.Point) : Q2.Point = (Q2.scale u.1 x.1,Q2.nonzero-scale u x.1 x.2) ;
 Weight (d : Degree) (Fv : Q2.Point -> Q2t.V) : U l =
  (u : G.Unit) (x : Q2.Point) -> Id Q2t.V (Fv (scale-point u x)) (Q2t.scale (TW.I.monomial d u).1 (Fv x)) ;
 Lift (phi : Pn -> Q2t.Pn) : U l =
  (d : Degree) * (Fv : Q2.Point -> Q2t.V) * (nz : (x : Q2.Point) -> Q2t.NonZero (Fv x)) *
  Weight d Fv * ((x : Q2.Point) -> Id Q2t.Pn (phi (Q2.class x)) (Q2t.class (Fv x,nz x))) ;
 module Map (phi : Pn -> Q2t.Pn) {
  z (q : Pn) : Lnt.Pn = PSt.backward (phi q) ;
  B (q : Pn) : L.Line = (z q).1 ;
  d : Degree = (cls.sec B).2 ;
  l0 : L.Line = (cls.sec B).1 ;
  module Frame (triv : Id L.Line l0 L.trivial) {
   to-B (q : Pn) : Id L.Line (TW.O d q) (B q) =
    trans (sym (trans (Pr.ap L.Line L.Line (\ a -> L.tensor a (TW.O d q)) l0 L.trivial triv) (L.tensor-left (TW.O d q))))
     (Pr.happly Pn (\ q' -> L.Line) (CL.classify (cls.sec B)) B (cls.sec-eq B) q) ;
   hom (q : Pn) : L.Hom (TW.O d q) (B q) = L.encode (TW.O d q) (B q) (to-B q) ;
   unpack (q : Pn) : TI.Hom (TW.Twist[d].raw q) (L.torsor (TW.O d q)) =
    TI.idtohom (TW.Twist[d].raw q) (L.torsor (TW.O d q)) (H.sym TI.Tor (L.torsor (TW.O d q)) (TW.Twist[d].raw q) (L.unpack-pack (TW.Twist[d].raw q))) ;
   elem (q : Pn) (r : TW.Rep q) : Car (B q) = (hom q).1 ((unpack q).1 (TW.Twist[d].At[q].S.uc r)) ;
   Fq (q : Pn) (r : TW.Rep q) : Q2t.V = (z q).2.1 (elem q r) ;
   Fv (x : Q2.Point) : Q2t.V = Fq (Q2.class x) (x,refl (Q2.class x)) ;
   nz (x : Q2.Point) : Q2t.NonZero (Fv x) = (z (Q2.class x)).2.2.2 (elem (Q2.class x) (x,refl (Q2.class x))) ;
   lifts (x : Q2.Point) : Id Q2t.Pn (phi (Q2.class x)) (Q2t.class (Fv x,nz x)) =
    trans (sym (PSt.front (phi (Q2.class x)))) (PSt.Forward[z (Q2.class x)].beta (elem (Q2.class x) (x,refl (Q2.class x)))) ;
   -- frames at two representatives
   change (q : Pn) (r r' : TW.Rep q) :
    Id (Car (B q)) (elem q r') (act (B q) (TW.Twist[d].At[q].c r' r) (elem q r)) =
    trans (Pr.ap TW.Twist[d].At[q].S.Tc (Car (B q)) (\ w -> (hom q).1 ((unpack q).1 w))
      (TW.Twist[d].At[q].S.uc r') (TW.Twist[d].At[q].S.actc (TW.Twist[d].At[q].c r' r) (TW.Twist[d].At[q].S.uc r))
      (sym (TW.Twist[d].At[q].S.tc-eq
        (TW.Twist[d].At[q].S.actc (TW.Twist[d].At[q].c r' r) (TW.Twist[d].At[q].S.uc r))
        (TW.Twist[d].At[q].S.uc r') (\ k -> TW.Twist[d].At[q].coc r' r k))))
     (trans (Pr.ap (Car (TW.O d q)) (Car (B q)) (hom q).1 _ _
       ((unpack q).2 (TW.Twist[d].At[q].c r' r) (TW.Twist[d].At[q].S.uc r)))
      ((hom q).2 (TW.Twist[d].At[q].c r' r) ((unpack q).1 (TW.Twist[d].At[q].S.uc r)))) ;
   rescale (q : Pn) (r r' : TW.Rep q) :
    Id Q2t.V (Fq q r') (Q2t.scale (G.inverse (TW.Twist[d].At[q].c r' r)).1 (Fq q r)) =
    trans (Pr.ap (Car (B q)) Q2t.V (z q).2.1 _ _ (change q r r'))
     ((z q).2.2.1 (TW.Twist[d].At[q].c r' r) (elem q r)) ;
   move (q1 q2 : Pn) (e : Id Pn q1 q2) (y : Q2.Point) (ey : Id Pn (Q2.class y) q1) :
    Id Q2t.V (Fq q1 (y,ey)) (Fq q2 (y,Pr.trans Pn (Q2.class y) q1 q2 ey e)) =
    idJ Pn q1 (\ q e' -> Id Q2t.V (Fq q1 (y,ey)) (Fq q (y,Pr.trans Pn (Q2.class y) q1 q ey e')))
     (refl (Fq q1 (y,ey))) q2 e ;
   module Scaled (u : G.Unit) (x : Q2.Point) {
    ux : Q2.Point = scale-point u x ;
    back : Q2.Related ux x = Q2.related-sym x ux (u,refl (Q2.scale u.1 x.1)) ;
    ex : Id Pn (Q2.class ux) (Q2.class x) = Q2.Q.relates ux x back ;
    r : TW.Rep (Q2.class x) = (x,refl (Q2.class x)) ;
    r' : TW.Rep (Q2.class x) = (ux,Pr.trans Pn (Q2.class ux) (Q2.class ux) (Q2.class x) (refl (Q2.class ux)) ex) ;
    unit-eq : Id G.Unit (TW.relate (Q2.class x) r' r).1 (G.inverse u) =
     Pr.ap (Q2.Related ux x) G.Unit (\ w -> w.1) _ _ (Q2.related-prop ux x (TW.relate (Q2.class x) r' r) back) ;
    coefficient : Id R.R (G.inverse (TW.Twist[d].At[Q2.class x].c r' r)).1 (TW.I.monomial d u).1 =
     trans (Pr.ap G.Unit R.R (\ w -> (G.inverse (TW.I.monomial d w)).1) _ _ unit-eq)
      (Pr.ap G.Unit R.R (\ w -> (G.inverse w).1) _ _ (TW.monomial-inverse d u)) ;
    result : Id Q2t.V (Fv ux) (Q2t.scale (TW.I.monomial d u).1 (Fv x)) =
     trans (move (Q2.class ux) (Q2.class x) ex ux (refl (Q2.class ux)))
      (trans (rescale (Q2.class x) r r')
       (Pr.ap R.R Q2t.V (\ c -> Q2t.scale c (Fv x)) _ _ coefficient)) ;
   } ;
   weight : Weight d Fv = \ u x -> Scaled[u,x].result ;
   result : Lift phi = (d,Fv,nz,weight,lifts) ;
  } ;
  lift : Tr.Trunc[Lift phi].carrier =
   Tr.Trunc[Id L.Line l0 L.trivial].induction @l (\ u -> Tr.Trunc[Lift phi].carrier) (\ u -> Tr.Trunc[Lift phi].proposition)
    (\ e -> Tr.Trunc[Lift phi].inc Frame[e].result) (L.K.k-conn l0 L.trivial) ;
 } ;
} ;
