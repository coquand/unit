-- Lemma 7.6 for the row ideal of the actual Horrocks certificate.
-- A monic member generating the row ideal modulo a finite radical ideal
-- already generates it over A[X]. The final corollary gives freeness.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (m : Nat) (fs : Fin m -> A.R) {
 module Tr = Truncation[l] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module Mat = RankOneProjector[l].Over[B.ring] ;
 module S = FiniteIdeal[l].Sums[B.ring] ;
 module Pow = AffinePowers[l].Over[B.ring] ;
 module Rad = FiniteRadicalLifting[l].Over[A,setA,m,fs] ;
 module Representatives = PolynomialRepresentatives[l].Over[A,setA] ;
 module At (radical : (a : A.R) -> Rad.J.1 a -> RL[A].unit (A.add A.o (A.neg a)))
  (lower : List A.R) (power : Nat) (n : Nat) (e : Mat.Size[n].Matrix)
  (w : Mat.Size[n].ScalarFactor e (Pow.power (H.monic lower) power))
  (h-lower : List A.R) (hc a : Mat.Size[n].Vector)
  (h-generated : Id B.Carrier (S.lin n w.2.1 hc) (H.monic h-lower)) {
  module Change = Rad.At[radical].BaseChange ;
  module Regular = MonicRegular[l].Over[A,setA].At[lower] ;
  t : B.Carrier = Pow.power (H.monic lower) power ;
  h : B.Carrier = H.monic h-lower ;
  y : Mat.Size[n].Vector = w.2.1 ;
  module Reduction
   (generates : (i : Fin n) -> Id Change.D.Carrier
    (Change.hom.1 (y i)) (Change.hom.1 (B.mulQ h (a i)))) {
   module Relations = LocalGeneratorRelations[l].Over[B.ring,Change.D.ring,Change.hom].At[
    n,e,t,Regular.power-regular power,Change.power-regular lower power,w,h,hc,h-generated,a,generates] ;
   module Quot = QuotientCertificate[l].Relative[B.ring,B.set,suc zero,\ i -> h] ;
   C : CRing = Quot.K.A.ring ;
   psi : RingHom[l].Hom B.ring C = Quot.K.A.inclusion ;
   module CR = RL[C] ;
   module SC = FiniteIdeal[l].Sums[C] ;
   module SumMap = StandardOpens[l].SumMap[B.ring,C,psi] ;
   kills : Id C.R (psi.1 h) C.z = Quot.kills (inr tt) ;
   v (i : Fin n) : C.R = psi.1 (y i) ;
   module Given (reps : Representatives.MatrixWitness n Relations.coefficients) {
    q (i j : Fin n) : List A.R = (reps i j).1 ;
    matrix-equality (i j : Fin n) :
     Id C.R (psi.1 (B.include (q i j))) (psi.1 (Relations.coefficients i j)) =
     ap psi.1 (reps i j).2 ;
    coefficients-inJ (i j : Fin n) (k : Nat) : Rad.J.1 (Poly[l].PolyR[A].coef (q i j) k) =
     Rad.Quot.kernel (Poly[l].PolyR[A].coef (q i j) k)
      (Change.raw-kernel (q i j)
       (trans (ap Change.hom.1 (reps i j).2) (Relations.kernel i j)) k) ;
    equations (i : Fin n) :
     Id C.R (v i) (SC.sum n (\ j -> C.mul (psi.1 (B.include (q i j))) (v j))) =
     trans (ap psi.1 (Relations.equations i))
      (trans (psi.2.2.1 (B.mulQ h (a i)) (S.lin n y (Relations.coefficients i)))
       (trans (ap (\ c -> C.add c (psi.1 (S.lin n y (Relations.coefficients i))))
         (trans (psi.2.2.2 h (a i))
          (trans (ap (\ c -> C.mul c (psi.1 (a i))) kills) (CR.zero-mul (psi.1 (a i))))))
        (trans (CR.zl (psi.1 (S.lin n y (Relations.coefficients i))))
         (trans (SumMap.combination n y (Relations.coefficients i))
          (SC.sum-cong n
           (\ j -> C.mul (v j) (psi.1 (Relations.coefficients i j)))
           (\ j -> C.mul (psi.1 (B.include (q i j))) (v j))
           (\ j -> trans (C.mulC (v j) (psi.1 (Relations.coefficients i j)))
            (ap (\ c -> C.mul c (v j)) (sym (matrix-equality i j))))))))) ;
    module VanishingResult = PolynomialNakayama[l].Over[A,setA,m,fs].At[radical,C,psi].Given[
     H.monic-list h-lower,len h-lower,H.leading h-lower,H.above h-lower,kills,
     n,v,q,coefficients-inJ,equations] ;
    Factor (i : Fin n) : U l = (b : B.Carrier) * Id B.Carrier (y i) (B.mulQ h b) ;
    singleton (i : Fin n) (cert : FiniteIdeal[l].Over[B.ring,suc zero,\ j -> h].Certificate (y i) B.zeroQ) :
     Factor i =
     (cert.1 (inr tt),
      trans cert.2
       (trans (RL[B.ring].zl (S.lin (suc zero) (\ j -> h) cert.1))
        (B.add-zero (B.mulQ h (cert.1 (inr tt)))))) ;
    factor (i : Fin n) : Tr.Trunc[Factor i].carrier =
     Tr.Trunc[FiniteIdeal[l].Over[B.ring,suc zero,\ j -> h].Certificate (y i) B.zeroQ].induction @l
      (\ z -> Tr.Trunc[Factor i].carrier) (\ z -> Tr.Trunc[Factor i].proposition)
      (\ cert -> Tr.Trunc[Factor i].inc (singleton i cert))
      (Quot.kernel (y i) (VanishingResult.all-zero i)) ;
    factors : Tr.Trunc[(i : Fin n) -> Factor i].carrier =
     AffineFinite[l].choice n Factor factor ;
   } ;
   Factors : U l = (b : Mat.Size[n].Vector) * ((i : Fin n) -> Id B.Carrier (y i) (B.mulQ h (b i))) ;
   from-representatives (reps : Representatives.MatrixWitness n Relations.coefficients) : Tr.Trunc[Factors].carrier =
    Tr.Trunc[(i : Fin n) -> Given[reps].Factor i].induction @l
     (\ z -> Tr.Trunc[Factors].carrier) (\ z -> Tr.Trunc[Factors].proposition)
     (\ z -> Tr.Trunc[Factors].inc ((\ i -> (z i).1),(\ i -> (z i).2)))
     Given[reps].factors ;
   factors : Tr.Trunc[Factors].carrier =
    Tr.Trunc[Representatives.MatrixWitness n Relations.coefficients].induction @l
     (\ z -> Tr.Trunc[Factors].carrier) (\ z -> Tr.Trunc[Factors].proposition)
     from-representatives (Representatives.matrix n Relations.coefficients) ;
   module Descent = CertificateDescent[l].Over[B.ring].At[n,e,t,Regular.power-regular power,w] ;
   free : Mat.Size[n].Free e =
    Tr.Trunc[Factors].induction @l
     (\ z -> Mat.Size[n].Free e) (\ z -> Tr.Trunc[Mat.Size[n].Factors e].proposition)
     (\ z -> Tr.Trunc[Mat.Size[n].Factors e].inc (Descent.descend (h,z.1,hc,z.2,h-generated)))
     factors ;
  } ;
 } ;
} ;
