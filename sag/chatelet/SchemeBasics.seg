-- Basic introductions and invariance for the shared scheme interface.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module S = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module ST = SchemeSubtype[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR] ;
 empty-charts : Fin zero -> S.Chart[Empty] = split { } ;
 empty-covers : S.Covered Empty zero empty-charts = split { } ;
 empty-cover : S.Cover[Empty] = new S.Cover[Empty,zero,empty-charts,empty-covers] ;
 empty : S.Scheme Empty = S.from-cover Empty empty-cover ;
 along (X Y : U l) (e : Pr.Equiv X Y) (s : S.Scheme X) : S.Scheme Y =
  Hi.subst (U l) (\ Z -> S.Scheme Z) X Y (Axioms[l].UnivalenceLemmas[univ @l].ua X Y e) s ;
 module Affine (X : U l) (aff : FA.Affine X) {
  Total : U l = X * Top ;
  forget : Pr.Equiv Total X =
   (\ a -> a.1,Pr.qinv Total X (\ a -> a.1) (\ x -> (x,tt))
    (\ x -> refl x) (\ a -> Pr.Sigma-eq X (\ x -> Top) _ _ _ _ (refl a.1) FinSum[l].top-prop)) ;
  aff-total : FA.Affine Total =
   SA.to-affine Total (SA.along Total X forget (SA.from-affine X aff)) ;
  subtypes : Fin (suc zero) -> X -> U l = \ i x -> Top ;
  covers (x : X) : ST.Has X (suc zero) subtypes x =
   Tr.Trunc[(i : Fin (suc zero)) * Top].inc (inr tt,tt) ;
  witness : ST.Witness[X] =
   new ST.Witness[X,suc zero,subtypes,\ i x -> OO.open-top,\ i -> aff-total,covers] ;
  scheme : S.Scheme X = ST.From[X,witness].scheme ;
 } ;
 affine (X : U l) (a : FA.Affine X) : S.Scheme X = Affine[X,a].scheme ;
 small-affine (X : U l) (a : SA.Affine X) : S.Scheme X = affine X (SA.to-affine X a) ;
 solutions (p : SA.P.Presentation) : S.Scheme (SA.Sol p) = affine (SA.Sol p) SA.Presented[p].affine ;
 module C = Algebras[l].Over[R,setR] ;
 base-unique (x y : C.Spec C.base) : Id (C.Spec C.base) x y =
  C.ext C.base C.base x y (\ r -> trans (x.2 r) (sym (y.2 r))) ;
 top-spectrum : Pr.Equiv Top (C.Spec C.base) =
  (\ t -> C.identity C.base,Pr.qinv Top (C.Spec C.base) (\ t -> C.identity C.base) (\ x -> tt)
   (\ x -> base-unique _ x) (\ t -> FinSum[l].top-prop tt t)) ;
 top-affine : FA.Affine Top = Truncation[l+].Trunc[FA.AffineWitness Top].inc
  (C.base,BasePresentation[l].Over[R,setR].finitely-presented,top-spectrum) ;
 top : S.Scheme Top = affine Top top-affine ;
} ;
