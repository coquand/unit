-- Equality of isomorphic line bundles is determined by its value at [0:1].
-- This is the fully faithful part of the higher-type classification.
level l ; open Prelude[l] ; open Paths[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module Tr = Truncation[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R)
 (intersection : PicardInterface[l].Over[R,setR].ChartIntersection) {
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module L = PicardLines[l].Over[R,setR] ;
 module C = PicardConstant[l].Over[R,setR,intersection] ;
 module GP = Gerbe[l].Gerbes[G.group].GL[L.K.KG] ;
 module Sec = TorsorSections[l].Over[G.group,P.P1,C.origin,C.unit-constant] ;
 Bundle : U l = P.P1 -> L.Line ;
 module At (B D : Bundle) (same : Tr.Trunc[Id Bundle B D].carrier) {
  S : U l = (x : P.P1) -> Id L.Line (B x) (D x) ;
  inhabit : Tr.Trunc[S].carrier = Tr.Trunc[Id Bundle B D].induction @l
   (\ t -> Tr.Trunc[S].carrier) (\ t -> Tr.Trunc[S].proposition)
   (\ q -> Tr.Trunc[S].inc (happly P.P1 (\ x -> L.Line) B D q)) same ;
  module T = Sec.At[\ x -> GP.PTor (B x) (D x),inhabit] ;
  eval (p : Id Bundle B D) : Id L.Line (B C.origin) (D C.origin) = happly P.P1 (\ x -> L.Line) B D p C.origin ;
  inverse (p : Id L.Line (B C.origin) (D C.origin)) : Id Bundle B D = FL.funext P.P1 (\ x -> L.Line) B D (T.equivalence.2.sec p) ;
  sec (p : Id L.Line (B C.origin) (D C.origin)) : Id (Id L.Line (B C.origin) (D C.origin)) (eval (inverse p)) p =
   transH (happly P.P1 (\ x -> Id L.Line (B x) (D x)) _ _
    (FL.happly-funext P.P1 (\ x -> L.Line) B D (T.equivalence.2.sec p)) C.origin)
    (T.equivalence.2.sec-eq p) ;
  ret (p : Id Bundle B D) : Id (Id Bundle B D) (inverse (eval p)) p =
   transH (ap S (Id Bundle B D) (FL.funext P.P1 (\ x -> L.Line) B D)
    (T.equivalence.2.sec (eval p)) (happly P.P1 (\ x -> L.Line) B D p)
    (sec-ret S (Id L.Line (B C.origin) (D C.origin)) T.equivalence.1 T.equivalence.2 (happly P.P1 (\ x -> L.Line) B D p)))
    (FL.funext-happly P.P1 (\ x -> L.Line) B D p) ;
  equivalence : Equiv (Id Bundle B D) (Id L.Line (B C.origin) (D C.origin)) = (eval,qinv _ _ eval inverse sec ret) ;
 } ;
} ;
