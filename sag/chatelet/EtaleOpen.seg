-- Open propositions are local, using double negation only for opens.
level l ; open Ring[l] ;
module Over (R : CRing) (setR : Prelude[l].isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OO = OpenOps[l].Over[R,setR].SAG[axioms.sqc,axioms.loc] ;
 module S = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 open-local (Q : U l) (o : OP.Open Q) : ET.T.isModal @l Q =
  S.modal-of-sec Q (OP.open-prop Q o) (\ i h -> OO.stable Q o
    (\ nq -> EtaleRoots[l].Over[R,setR].Generator[i].not-not-root axioms
      (\ x -> nq (h (ET.root-inc i x))))) ;
} ;
