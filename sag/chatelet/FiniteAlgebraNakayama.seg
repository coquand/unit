-- Restrict a finite polynomial-coefficient system to finitely many
-- A-generators, then apply determinant-free Nakayama over A.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R)
 (phi : RingHom[l].Hom A C) {
 module IA = Ideals[l].Over[A,setA] ;
 module S = FiniteIdeal[l].Sums[C] ;
 module CR = RL[C] ;
 module FP = FiniteProduct[l] ;
 module Rect = FP.Sums[C] ;
 module Linear = AlgebraLinear[l].Over[A,C,phi] ;
 module At (J : IA.Ideal)
  (radical : (a : A.R) -> J.1 a -> RL[A].unit (A.add A.o (A.neg a)))
  (n d : Nat) (v : Fin n -> C.R) (basis : Fin d -> C.R)
  (matrix : Fin n -> Fin n -> C.R)
  (equations : (i : Fin n) -> Id C.R (v i) (S.sum n (\ j -> C.mul (matrix i j) (v j))))
  (coefficients : Fin n -> Fin d -> Fin n -> Fin d -> A.R)
  (inJ : (i : Fin n) (k : Fin d) (j : Fin n) (s : Fin d) -> J.1 (coefficients i k j s))
  (expansion : (i : Fin n) (k : Fin d) (j : Fin n) ->
   Id C.R (C.mul (basis k) (matrix i j))
    (S.sum d (\ s -> C.mul (phi.1 (coefficients i k j s)) (basis s)))) {
  total : Nat = FP.size n d ;
  pair-value (p : FP.Pair n d) : C.R = C.mul (basis p.2) (v p.1) ;
  vectors (u : Fin total) : C.R = pair-value (FP.decode n d u) ;
  entries (u w : Fin total) : A.R =
   coefficients (FP.decode n d u).1 (FP.decode n d u).2 (FP.decode n d w).1 (FP.decode n d w).2 ;
  entries-inJ (u w : Fin total) : J.1 (entries u w) =
   inJ (FP.decode n d u).1 (FP.decode n d u).2 (FP.decode n d w).1 (FP.decode n d w).2 ;
  term (i : Fin n) (k : Fin d) (j : Fin n) :
   Id C.R (C.mul (basis k) (C.mul (matrix i j) (v j)))
    (S.sum d (\ s -> C.mul (phi.1 (coefficients i k j s)) (C.mul (basis s) (v j)))) =
   trans (C.mulA (basis k) (matrix i j) (v j))
    (trans (ap (\ a -> C.mul a (v j)) (expansion i k j))
     (trans (C.mulC (S.sum d (\ s -> C.mul (phi.1 (coefficients i k j s)) (basis s))) (v j))
      (trans (sym (S.sum-scale (v j) d (\ s -> C.mul (phi.1 (coefficients i k j s)) (basis s))))
       (S.sum-cong d
        (\ s -> C.mul (v j) (C.mul (phi.1 (coefficients i k j s)) (basis s)))
        (\ s -> C.mul (phi.1 (coefficients i k j s)) (C.mul (basis s) (v j)))
        (\ s -> trans (CR.mul-swap (v j) (phi.1 (coefficients i k j s)) (basis s))
         (ap (C.mul (phi.1 (coefficients i k j s))) (C.mulC (v j) (basis s)))))))) ;
  pair-equation (i : Fin n) (k : Fin d) :
   Id C.R (C.mul (basis k) (v i))
    (S.sum total (\ u -> C.mul
     (phi.1 (coefficients i k (FP.decode n d u).1 (FP.decode n d u).2)) (vectors u))) =
   trans (ap (C.mul (basis k)) (equations i))
    (trans (sym (S.sum-scale (basis k) n (\ j -> C.mul (matrix i j) (v j))))
     (trans (S.sum-cong n
       (\ j -> C.mul (basis k) (C.mul (matrix i j) (v j)))
       (\ j -> S.sum d (\ s -> C.mul (phi.1 (coefficients i k j s)) (C.mul (basis s) (v j))))
       (term i k))
      (sym (Rect.rectangular n d (\ p -> C.mul (phi.1 (coefficients i k p.1 p.2)) (pair-value p)))))) ;
  module N = NakayamaElimination[l].Over[A,setA].At[J,radical,Linear.structure] ;
  vectors-zero (u : Fin total) : Id C.R (vectors u) C.z =
   N.eliminate total vectors entries entries-inJ
    (\ w -> trans (pair-equation (FP.decode n d w).1 (FP.decode n d w).2)
     (sym (Linear.lin-equation total (entries w) vectors))) u ;
  pair-zero (i : Fin n) (k : Fin d) : Id C.R (C.mul (basis k) (v i)) C.z =
   trans (sym (ap pair-value (FP.decode-encode n d i k))) (vectors-zero (FP.encode n d i k)) ;
  original-zero (k : Fin d) (one : Id C.R (basis k) C.o) (i : Fin n) : Id C.R (v i) C.z =
   trans (sym (trans (C.mulC C.o (v i)) (C.mulO (v i))))
    (trans (ap (\ a -> C.mul a (v i)) (sym one)) (pair-zero i k)) ;
 } ;
} ;
