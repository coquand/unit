-- Equality on D(f) is killed by one power of f, using 7.1.8 for R.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module NF = NatFin[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module MA = Alg73[l].MA[MD.ring,MD.regular] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg)
  (scheme : Schemes[l].Over[R,setR].Scheme (C.Spec Alg)) {
  X : U l = C.Spec Alg ;
  module Pow = AffinePowers[l].Over[Alg.ring] ;
  module AF = Affine[l].Aff[MD.ring,X,\ x -> MD.regular] ;
  restriction : MD.Restriction X (\ x -> MD.regular) =
   Restriction718[l].Over[R,setR,axioms].At[X,scheme,\ x -> MD.regular,
    \ x -> RegularQC[l].Over[R,setR,axioms].theorem].theorem-7-1-8 ;
  power-eval (f : Alg.ring.R) (p : Base.Nat) (x : X) :
   Id R.R (x.1.1 (Pow.power f (NF.fromN p))) (MD.RA.pw (x.1.1 f) p) =
   trans (AffinePowers[l].power-map Alg.ring R x.1 f (NF.fromN p))
    (trans (sym (MD.RB.power (x.1.1 f) (NF.fromN p)))
     (ap (MD.RA.pw (x.1.1 f)) (NF.to-from p))) ;
  module EqualOn (f a b : Alg.ring.R)
   (agree : (x : X) -> RL[R].unit (x.1.1 f) -> Id R.R (x.1.1 a) (x.1.1 b)) {
   g (x : X) : R.R = x.1.1 f ;
   diff (x : X) : R.R = MA.sub (x.1.1 a) (x.1.1 b) ;
   vanishes (x : X) (u : RL[R].unit (g x)) : Id R.R (diff x) R.z =
    trans (ap (\ r -> R.add r (R.neg (x.1.1 b))) (agree x u)) (R.addN (x.1.1 b)) ;
   Witness : U l = (k : Nat) * Id Alg.ring.R (Alg.ring.mul (Pow.power f k) a) (Alg.ring.mul (Pow.power f k) b) ;
   module Killed (k : AF.Kill g diff) {
    equal-at (x : X) : Id R.R
     (R.mul (MD.RA.pw (g x) k.1) (x.1.1 a)) (R.mul (MD.RA.pw (g x) k.1) (x.1.1 b)) =
     MA.sub-zero _ _ (trans (sym (MA.sm-sub (MD.RA.pw (g x) k.1) (x.1.1 a) (x.1.1 b))) (k.2 x)) ;
    equation : Id Alg.ring.R (Alg.ring.mul (Pow.power f (NF.fromN k.1)) a) (Alg.ring.mul (Pow.power f (NF.fromN k.1)) b) =
     Equivalences[l].injective Alg.ring.R (X -> R.R) (C.evaluation Alg) (axioms.sqc Alg fp) _ _
      (Axioms[l].FunExtLemmas[fe @l].funext X (\ x -> R.R) _ _ (\ x ->
       trans (x.1.2.2.2 (Pow.power f (NF.fromN k.1)) a)
        (trans (ap (\ t -> R.mul t (x.1.1 a)) (power-eval f k.1 x))
         (trans (equal-at x)
          (trans (ap (\ t -> R.mul t (x.1.1 b)) (sym (power-eval f k.1 x)))
           (sym (x.1.2.2.2 (Pow.power f (NF.fromN k.1)) b))))))) ;
    witness : Witness = (NF.fromN k.1,equation) ;
   } ;
   theorem : Tr.Trunc[Witness].carrier =
    Tr.Trunc[AF.Kill g diff].induction @l (\ z -> Tr.Trunc[Witness].carrier)
     (\ z -> Tr.Trunc[Witness].proposition) (\ z -> Tr.Trunc[Witness].inc Killed[z].witness)
     ((restriction g).2 diff vanishes) ;
  } ;
 } ;
} ;
