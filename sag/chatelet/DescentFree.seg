-- Split bases of subtypes descend when the ambient algebra is finite free.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : [j] SheafClosure[l,j].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module DI = DescentIdeal[l].Over[R,setR,axioms,sh] ; module ET = EtaleTopology[l].Over[R,setR] ;
 module DF = DescentFrames[l].Over[R,setR,axioms.loc] ;
 module Rank (n : Nat) {
  module AP = AzumayaProbe[l].Over[R,setR,n,ET.I,ET.G,sh] ;
  module At (A : AP.Alg) (modal : ET.T.isModal @l A.A) (S : AP.Sub A)
   (local : (sh @l).close (AP.Basis A S)) {
   module IS = DI.Rank[n].At[A,modal,S,local] ;
   module Based (b : DL.On[IS.carrier].Frame (suc n)) {
    V : MD.Module = DL.Free (suc n) ; W : MD.Module = IS.carrier ;
    module LW = DL.On[W] ;
    f : V.M -> W.M = LW.lin (suc n) b.1 ;
    fa (u v : V.M) : Id W.M (f (V.madd u v)) (W.madd (f u) (f v)) = LW.lin-add (suc n) b.1 u v ;
    fs (a : R.R) (v : V.M) : Id W.M (f (V.sm a v)) (W.sm a (f v)) = LW.lin-scale (suc n) b.1 a v ;
    module Inv = DF.Inverse[V,W,f,fa,fs,b.2] ;
    inclusion (v : V.M) : A.A = (f v).1 ;
    inclusion-add (u v : V.M) : Id A.A (inclusion (V.madd u v)) (A.add (inclusion u) (inclusion v)) =
     ap (\ w -> w.1) (fa u v) ;
    inclusion-scale (a : R.R) (v : V.M) : Id A.A (inclusion (V.sm a v)) (A.scale a (inclusion v)) =
     ap (\ w -> w.1) (fs a v) ;
    module RT = DescentRetraction[l].Over[R,setR,axioms,sh].Map[DI.underlying A,suc n,inclusion,inclusion-add,inclusion-scale] ;
    module Given (old : AP.Basis A S) {
     old-f : V.M -> W.M = old.1 ;
     old-fa (u v : V.M) : Id W.M (old-f (V.madd u v)) (W.madd (old-f u) (old-f v)) = IS.SS.eq _ _ (old.2.1 u v) ;
     old-fs (a : R.R) (v : V.M) : Id W.M (old-f (V.sm a v)) (W.sm a (old-f v)) = IS.SS.eq _ _ (old.2.2.1 a v) ;
     e : Pr.isEquiv V.M W.M old-f = old.2.2.2.1 ;
     ret : AP.Retraction A S old-f = old.2.2.2.2 ;
     old-g : A.A -> V.M = ret.1 ;
     old-ga (x y : A.A) : Id V.M (old-g (A.add x y)) (V.madd (old-g x) (old-g y)) =
      F.funext (Fin (suc n)) (\ j -> R.R) _ _ (ret.2.1 x y) ;
     old-gs (a : R.R) (x : A.A) : Id V.M (old-g (A.scale a x)) (V.sm a (old-g x)) =
      F.funext (Fin (suc n)) (\ j -> R.R) _ _ (ret.2.2.1 a x) ;
     old-law (v : V.M) : Id V.M (old-g (old-f v).1) v =
      F.funext (Fin (suc n)) (\ j -> R.R) _ _ (ret.2.2.2 v) ;
     projector (s : W.M) : Id W.M (old-f (old-g s.1)) s =
      trans (ap (\ z -> old-f (old-g z.1)) (sym (e.sec-eq s)))
       (trans (ap old-f (old-law (e.sec s))) (e.sec-eq s)) ;
     g (x : A.A) : V.M = Inv.inverse (old-f (old-g x)) ;
     add (x y : A.A) : Id V.M (g (A.add x y)) (V.madd (g x) (g y)) =
      trans (ap (\ v -> Inv.inverse (old-f v)) (old-ga x y))
       (trans (ap Inv.inverse (old-fa (old-g x) (old-g y)))
        (Inv.inverse-add (old-f (old-g x)) (old-f (old-g y)))) ;
     scale (a : R.R) (x : A.A) : Id V.M (g (A.scale a x)) (V.sm a (g x)) =
      trans (ap (\ v -> Inv.inverse (old-f v)) (old-gs a x))
       (trans (ap Inv.inverse (old-fs a (old-g x))) (Inv.inverse-scale a (old-f (old-g x)))) ;
     law (v : V.M) : Id V.M (g (inclusion v)) v =
      trans (ap Inv.inverse (projector (f v))) (Pr.sec-ret V.M W.M f b.2 v) ;
     result : RT.Retraction = (g,add,scale,law) ;
    } ;
    local-retraction : (sh @l).close RT.Retraction =
     (sh @l).elim @l (AP.Basis A S) ((sh @l).close RT.Retraction)
      ((sh @l).proposition RT.Retraction) ((sh @l).modal RT.Retraction)
      (\ old -> (sh @l).inc RT.Retraction Given[old].result) local ;
    finish (g : RT.Retraction) : AP.Basis A S =
     (f,inclusion-add,inclusion-scale,b.2,
      (g.1,\ x y j -> ap (\ v -> v j) (g.2.1 x y),
       \ a x j -> ap (\ v -> v j) (g.2.2.1 a x),\ v j -> ap (\ w -> w j) (g.2.2.2 v))) ;
    theorem (free : Tr.Trunc[(m : Nat) * DL.On[DI.underlying A].Frame m].carrier) : Tr.Trunc[AP.Basis A S].carrier =
     TC.map RT.Retraction (AP.Basis A S) finish (RT.theorem local-retraction free) ;
   } ;
   descends-free (free : Tr.Trunc[(m : Nat) * DL.On[DI.underlying A].Frame m].carrier) : Tr.Trunc[AP.Basis A S].carrier =
    TC.bind (DL.On[IS.carrier].Frame (suc n)) (AP.Basis A S) (\ b -> Based[b].theorem free) IS.theorem ;
   opaque descends-free ;
  } ;
 } ;
} ;
