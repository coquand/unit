-- Linear maps over an arbitrary commutative ring; no locality or SAG.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 identity (M : MD.Module) : SM.Linear M M = (\ x -> x,\ x y -> refl (M.madd x y),\ a x -> refl (M.sm a x)) ;
 compose (P Q S : MD.Module) (g : SM.Linear Q S) (f : SM.Linear P Q) : SM.Linear P S =
  (\ x -> g.1 (f.1 x),\ x y -> trans (ap g.1 (f.2.1 x y)) (g.2.1 (f.1 x) (f.1 y)),
   \ a x -> trans (ap g.1 (f.2.2 a x)) (g.2.2 a (f.1 x))) ;
 combination (M : MD.Module) (n : Nat) (v : Fin n -> M.M) : SM.Linear (DL.Free n) M =
  (DL.On[M].lin n v,DL.On[M].lin-add n v,DL.On[M].lin-scale n v) ;
 module Map (P Q : MD.Module) (f : SM.Linear P Q) {
  module H = DL.Hom[P,Q,f.1,f.2.1,f.2.2] ;
 } ;
 subtract (P Q : MD.Module) (f g : SM.Linear P Q) : SM.Linear P Q =
  (\ x -> Alg73[l].MA[MD.ring,Q].sub (f.1 x) (g.1 x),
   \ x y -> trans (cong2 Q.M Alg73[l].MA[MD.ring,Q].sub _ _ _ _ (f.2.1 x y) (g.2.1 x y))
    (trans (ap (Q.madd (Q.madd (f.1 x) (f.1 y))) (Alg73[l].MA[MD.ring,Q].neg-add (g.1 x) (g.1 y)))
     (Alg73[l].MA[MD.ring,Q].swap4 (f.1 x) (f.1 y) (Q.mneg (g.1 x)) (Q.mneg (g.1 y)))),
   \ a x -> trans (cong2 Q.M Alg73[l].MA[MD.ring,Q].sub _ _ _ _ (f.2.2 a x) (g.2.2 a x))
    (sym (Alg73[l].MA[MD.ring,Q].sm-sub a (f.1 x) (g.1 x)))) ;
 module Free (n : Nat) {
  V : MD.Module = DL.Free n ;
  unit (j : Fin n) (k : Fin n) : R.R = DL.D.delta n k j ;
  module Projection (k : Fin n) {
   module H = DL.Hom[V,MD.regular,\ v -> v k,
    \ u v -> refl (R.add (u k) (v k)),\ a v -> refl (R.mul a (v k))] ;
  } ;
  expansion (v : V.M) : Id V.M (DL.On[V].lin n unit v) v =
   F.funext (Fin n) (\ k -> R.R) _ v (\ k ->
    trans (Projection[k].H.lin n unit v)
     (trans (DL.On[MD.regular].lin-value n (\ j -> unit j k) v)
      (trans (DL.On[MD.regular].S.map (\ a -> a) (refl R.z) (\ a b -> refl (R.add a b))
        n (\ j -> R.mul (v j) (unit j k)))
       (trans (FiniteIdeal[l].Sums[R].sum-cong n
         (\ j -> R.mul (v j) (DL.D.delta n k j)) (\ j -> R.mul (DL.D.delta n k j) (v j))
         (\ j -> R.mulC (v j) (DL.D.delta n k j))) (DL.D.sum-delta n k v))))) ;
  module LinearMap (M : MD.Module) (f : SM.Linear V M) {
   columns (j : Fin n) : M.M = f.1 (unit j) ;
   equation (v : V.M) : Id M.M (DL.On[M].lin n columns v) (f.1 v) =
    trans (sym (Map[V,M,f].H.lin n unit v)) (ap f.1 (expansion v)) ;
  } ;
 } ;
 module Killed (P Q : MD.Module) (f : SM.Linear P Q) (n : Nat) (a : Fin n -> P.M)
  (h : (j : Fin n) -> Id Q.M (f.1 (a j)) Q.mz) {
  theorem (c : (DL.Free n).M) : Id Q.M (f.1 (DL.On[P].lin n a c)) Q.mz =
   trans (Map[P,Q,f].H.lin n a c)
    (trans (DL.On[Q].lin-value n (\ j -> f.1 (a j)) c)
     (trans (DL.On[Q].S.congruent n (\ j -> Q.sm (c j) (f.1 (a j))) (\ j -> Q.mz)
       (\ j -> trans (ap (Q.sm (c j)) (h j)) (Alg73[l].MA[MD.ring,Q].sm-zr (c j))))
      (DL.On[Q].sum-zero n))) ;
 } ;
} ;
