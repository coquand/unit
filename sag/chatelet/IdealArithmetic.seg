level l ; open Ring[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 open A ; open RL[A] ;
 module IdealsA = Ideals[l].Over[A,setA] ;
 module In (I : IdealsA.Ideal) {
  module Old = IdealsA.In[I] ;
  negative (a : R) (h : I.1 a) : I.1 (neg a) =
   Old.equal _ _
    (trans (mulC (neg o) a) (trans (mul-neg a o) (ap neg (mulO a))))
    (I.2.2.2.2 (neg o) a h) ;
  subtract (a b : R) (ha : I.1 a) (hb : I.1 b) : I.1 (add a (neg b)) =
   I.2.2.2.1 a (neg b) ha (negative b hb) ;
  remainder (p q r : R) (hp : I.1 p) (hq : I.1 q)
   (equation : Id R p (add q r)) : I.1 r =
   Old.equal _ _
    (trans (ap (\ v -> add v (neg q)) equation)
     (trans (ap (\ v -> add v (neg q)) (addC q r)) (add-neg-cancel r q)))
    (subtract p q hp hq) ;
 } ;
} ;
