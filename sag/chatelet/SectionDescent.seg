-- Compatible sections of a set family glue along any merely inhabited cover.
-- Unique choice, derived from propositional truncation; no geometric axiom.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module At (I M : U l) (setM : Pr.isSet M) (local : I -> M)
 (agree : (i j : I) -> Id M (local i) (local j)) {
 Property (m : M) : U l = (i : I) -> Id M m (local i) ;
 property-prop (m : M) : Pr.isProp (Property m) =
  F.isProp-Pi I (\ i -> Id M m (local i)) (\ i -> setM m (local i)) ;
 Match : U l = (m : M) * Property m ;
 module Inhabited (cover : Tr.Trunc[I].carrier) {
  same (a b : Match) : Id M a.1 b.1 =
   Tr.Trunc[I].induction @l (\ t -> Id M a.1 b.1)
    (\ t -> setM a.1 b.1) (\ i -> trans (a.2 i) (sym (b.2 i))) cover ;
  proposition : Pr.isProp Match = \ a b ->
   Pr.Sigma-eq M Property a.1 b.1 a.2 b.2 (same a b) (property-prop b.1) ;
  result : Match = Tr.Trunc[I].induction @l
   (\ t -> Match) (\ t -> proposition) (\ i -> (local i,agree i)) cover ;
 } ;
} ;
