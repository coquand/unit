-- The unit group of R: powers, cancellation, and comparison of exponents.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module G = PicardUnits[l].Over[R,setR] ;
 module GL = Torsor[l].AbL[G.group] ;
 module Pow = AffinePowers[l].Over[R] ;
 Unit : U l = G.Unit ;
 tm : Unit -> Unit -> Unit = G.times ;
 pw : Unit -> Nat -> Unit = G.power ;
 inv : Unit -> Unit = G.inverse ;
 -- group calculations
 four (a b c d : Unit) : Id Unit (tm (tm a b) (tm c d)) (tm (tm a c) (tm b d)) = calc Unit {
  tm (tm a b) (tm c d)
   =< G.assoc a b (tm c d) > tm a (tm b (tm c d))
   =< ap (tm a) (sym (G.assoc b c d)) > tm a (tm (tm b c) d)
   =< ap (\ t -> tm a (tm t d)) (G.comm b c) > tm a (tm (tm c b) d)
   =< ap (tm a) (G.assoc c b d) > tm a (tm c (tm b d))
   =< sym (G.assoc a c (tm b d)) > tm (tm a c) (tm b d) } ;
 power-add (x : Unit) : (m n : Nat) -> Id Unit (pw x (plus m n)) (tm (pw x m) (pw x n)) = split {
  zero -> \ n -> sym (GL.unitl (pw x n)) ;
  suc m | r -> \ n -> trans (ap (tm x) (r n)) (sym (G.assoc x (pw x m) (pw x n))) } ;
 power-inv (x : Unit) : (k : Nat) -> Id Unit (tm (pw x k) (pw (inv x) k)) G.one = split {
  zero -> G.unitr G.one ;
  suc k | r -> trans (four x (pw x k) (inv x) (pw (inv x) k))
   (trans (ap (\ t -> tm t (tm (pw x k) (pw (inv x) k))) (G.invr x))
    (trans (ap (tm G.one) r) (G.unitr G.one))) } ;
 cancel (w u v : Unit) (h : Id Unit (tm w u) (tm w v)) : Id Unit u v = calc Unit {
  u =< sym (GL.unitl u) > tm G.one u
   =< ap (\ t -> tm t u) (sym (GL.invl w)) > tm (tm (inv w) w) u
   =< G.assoc (inv w) w u > tm (inv w) (tm w u)
   =< ap (tm (inv w)) h > tm (inv w) (tm w v)
   =< sym (G.assoc (inv w) w v) > tm (tm (inv w) w) v
   =< ap (\ t -> tm t v) (GL.invl w) > tm G.one v
   =< GL.unitl v > v } ;
 power-fst (x : Unit) : (n : Nat) -> Id R.R (pw x n).1 (Pow.power x.1 n) = split {
  zero -> refl R.o ; suc n | r -> ap (R.mul x.1) r } ;
 Cmp (n m : Nat) : U l = Plus (Id Nat n m)
  (Plus ((j : Nat) * Id Nat n (plus m (suc j))) ((j : Nat) * Id Nat m (plus n (suc j)))) ;
 cmp-suc2 (n m : Nat) : Plus ((j : Nat) * Id Nat n (plus m (suc j))) ((j : Nat) * Id Nat m (plus n (suc j))) ->
  Plus ((j : Nat) * Id Nat (suc n) (plus (suc m) (suc j))) ((j : Nat) * Id Nat (suc m) (plus (suc n) (suc j))) = split {
  inl w -> inl (w.1,ap (\ i -> suc i) w.2) ; inr w -> inr (w.1,ap (\ i -> suc i) w.2) } ;
 cmp-suc (n m : Nat) : Cmp n m -> Cmp (suc n) (suc m) = split {
  inl p -> inl (ap (\ i -> suc i) p) ; inr w -> inr (cmp-suc2 n m w) } ;
 compare : (n m : Nat) -> Cmp n m = split {
  zero -> split { zero -> inl (refl zero) ; suc m -> inr (inr (m,refl (suc m))) } ;
  suc n | r -> split { zero -> inr (inl (n,refl (suc n))) ; suc m -> cmp-suc n m (r m) } } ;
} ;
