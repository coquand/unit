-- Between sets, being an equivalence (Prelude.isEquiv) is a proposition:
-- sec and ret are both equal to any other section, and the two laws are
-- propositions.  Eta for the sig isEquiv is the eliminator (split, with
-- any identifier as the pattern head).  Hence Aut A (SkolemNoetherConj)
-- is equivalent to AlgSIP2.AlgIso A A.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module SetEquiv (A B : U l) (sA : Pr.isSet A) (sB : Pr.isSet B) (f : A -> B) {
 E : U l = Pr.isEquiv A B f ;
 SE (s : B -> A) : U l = (b : B) -> Id B (f (s b)) b ;
 RE (r : B -> A) : U l = (a : A) -> Id A (r (f a)) a ;
 se-prop (s : B -> A) : Pr.isProp (SE s) = F.isProp-Pi B (\ b -> Id B (f (s b)) b) (\ b -> sB (f (s b)) b) ;
 re-prop (r : B -> A) : Pr.isProp (RE r) = F.isProp-Pi A (\ a -> Id A (r (f a)) a) (\ a -> sA (r (f a)) a) ;
 mk (s : B -> A) (se : SE s) (r : B -> A) (re : RE r) : E = struct { sec = s ; sec-eq = se ; ret = r ; ret-eq = re } ;
 -- equal sections and retractions give equal structures
 mk-eq (s s' : B -> A) (ps : Id (B -> A) s s') (se : SE s) (se' : SE s')
  (r r' : B -> A) (pr : Id (B -> A) r r') (re : RE r) (re' : RE r') : Id E (mk s se r re) (mk s' se' r' re') =
  idJ (B -> A) s (\ s2 p2 -> (se2 : SE s2) -> Id E (mk s se r re) (mk s2 se2 r' re'))
   (\ se2 -> idJ (B -> A) r (\ r2 p2 -> (re2 : RE r2) -> Id E (mk s se r re) (mk s se2 r2 re2))
     (\ re2 -> Pr.trans E (mk s se r re) (mk s se2 r re) (mk s se2 r re2)
       (Pr.ap (SE s) E (\ x -> mk s x r re) se se2 (se-prop s se se2))
       (Pr.ap (RE r) E (\ y -> mk s se2 r y) re re2 (re-prop r re re2)))
     r' pr re')
   s' ps se' ;
 -- a section of f equals the retraction of any equivalence structure
 sec-ret-eq (s : B -> A) (se : SE s) (r : B -> A) (re : RE r) (b : B) : Id A (s b) (r b) =
  trans (sym (re (s b))) (ap r (se b)) ;
 prop-at (s : B -> A) (se : SE s) (r : B -> A) (re : RE r) : (e' : E) -> Id E (mk s se r re) e' = split {
  IsEquiv s' se' r' re' ->
   mk-eq s s' (F.funext B (\ b -> A) s s' (\ b -> trans (sec-ret-eq s se r' re' b) (sym (sec-ret-eq s' se' r' re' b)))) se se'
    r r' (F.funext B (\ b -> A) r r' (\ b -> trans (sym (sec-ret-eq s se r re b)) (trans (sec-ret-eq s se r' re' b) (refl (r' b)))))
    re re' } ;
 prop : (e : E) (e' : E) -> Id E e e' = split { IsEquiv s se r re -> prop-at s se r re } ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module AS = AlgSIP2[l].Over[R,setR] ;
 module On (A : NCAlgebra[l].Over[R,setR].Algebra) {
  module CJ = SkolemNoetherConj[l].Over[R,setR].On[A] ;
  iso-eq (e e' : AS.AlgIso A A) (h : Id (A.A -> A.A) e.1.1 e'.1.1) : Id (AS.AlgIso A A) e e' =
   Pr.Sigma-eq (Pr.Equiv A.A A.A) (\ q -> AS.Hom A A q.1) e.1 e'.1 e.2 e'.2
    (Pr.Sigma-eq (A.A -> A.A) (\ g -> Pr.isEquiv A.A A.A g) e.1.1 e'.1.1 e.1.2 e'.1.2 h
      (SetEquiv[A.A,A.A,A.set,A.set,e'.1.1].prop))
    (AS.hom-prop A A e'.1.1) ;
  to-from (e : AS.AlgIso A A) : Id (AS.AlgIso A A) (CJ.to-iso (CJ.from-iso e)) e =
   iso-eq (CJ.to-iso (CJ.from-iso e)) e (refl e.1.1) ;
  -- Aut A is AlgIso A A
  equivalence : Pr.Equiv CJ.Aut (AS.AlgIso A A) =
   (CJ.to-iso,Pr.qinv CJ.Aut (AS.AlgIso A A) CJ.to-iso CJ.from-iso to-from CJ.from-to) ;
 } ;
} ;
