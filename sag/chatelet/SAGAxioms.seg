-- SAG 2.1, uniform in finitely presented R-algebras.
-- k is the universe of the family in Z-choice; no resizing is assumed.
level l k ;
module Pr = Prelude[l] ;
module Over (R : Ring[l].CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module O = StandardOpens[l].Over[R,setR] ;
 Loc : U l = O.Locality ;
 SQC : U l+ = P.SQC ;
 UnimodularWitness (A : C.Algebra) (n : Ring[l].Nat) (fs : Presentations[l].Fin n -> A.ring.R) : U l =
  (rs : Presentations[l].Fin n -> A.ring.R) *
   Id A.ring.R (FiniteIdeal[l].Sums[A.ring].lin n fs rs) A.ring.o ;
 Unimodular (A : C.Algebra) (n : Ring[l].Nat) (fs : Presentations[l].Fin n -> A.ring.R) : U l =
  Truncation[l].Trunc[UnimodularWitness A n fs].carrier ;
 ChoiceData (A : C.Algebra) (B : C.Spec A -> U k) : U (l \/ k) =
  (n : Ring[l].Nat) * (fs : Presentations[l].Fin n -> A.ring.R) *
   Unimodular A n fs *
   ((i : Presentations[l].Fin n) (x : C.Spec A) -> Ring[l].RL[R].unit (x.1.1 (fs i)) -> B x) ;
 ZChoice : U (l+ \/ k+) = (A : C.Algebra) -> P.FP A ->
  (B : C.Spec A -> U k) -> ((x : C.Spec A) -> Truncation[k].Trunc[B x].carrier) ->
  Truncation[l \/ k].Trunc[ChoiceData A B].carrier ;
 record Assumptions {
  loc : Loc ;
  sqc : SQC ;
  zchoice : ZChoice ;
 } ;
} ;
