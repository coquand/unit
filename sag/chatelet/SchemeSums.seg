-- SAG 5.6.1: schemes are closed under dependent sums.
-- No affine-total assertion for arbitrary affine families is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module S = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module ST = SchemeSubtype[l].Over[R,setR] ;
 module SB = SchemeBasics[l].Over[R,setR] ;
 module SC = SchemeCover[l].Over[R,setR,axioms] ;
 module Choice = SchemeChoice[l].Over[R,setR,axioms] ;
 module Bound = SchemeBounded[l].Over[R,setR,axioms] ;
 module CovPad = SchemeCoverPadding[l].Over[R,setR,axioms.loc.1] ;
 module AS = SchemeAffineSums[l].Over[R,setR,axioms] ;
 module CS = CoverSigma[l].Over[R,setR,axioms] ;
 module Bounded (X : U l) (schX : S.Scheme X) (Y : X -> U l)
  (cs : (x : X) -> S.Cover[Y x]) (N : Nat) (bound : (x : X) -> CB.le (cs x).size N) {
  Total : U l = (x : X) * Y x ;
  chart (x : X) (j : Fin N) : S.Chart[Y x] = CovPad.At[Y x,cs x,N,bound x].charts j ;
  us (j : Fin N) (z : Total) : U l = S.Image (Y z.1) (chart z.1 j) z.2 ;
  opens (j : Fin N) (z : Total) : S.OP.Open (us j z) = (chart z.1 j).open-image z.2 ;
  module Part (j : Fin N) {
   A (x : X) : U l = (y : Y x) * S.Image (Y x) (chart x j) y ;
   affine (x : X) : FA.Affine (A x) = ST.chart-affine (Y x) (chart x j) ;
   local-scheme : S.Scheme ((x : X) * A x) = AS.theorem X schX A affine ;
   exchange : Pr.Equiv ((x : X) * A x) ((z : Total) * us j z) =
    (\ w -> ((w.1,w.2.1),w.2.2),
     Pr.qinv ((x : X) * A x) ((z : Total) * us j z) (\ w -> ((w.1,w.2.1),w.2.2))
      (\ z -> (z.1.1,z.1.2,z.2)) (\ z -> refl z) (\ w -> refl w)) ;
   scheme : S.Scheme ((z : Total) * us j z) = SB.along _ _ exchange local-scheme ;
  } ;
  covers (z : Total) : Tr.Trunc[(j : Fin N) * us j z].carrier =
   CovPad.At[Y z.1,cs z.1,N,bound z.1].covers z.2 ;
  theorem : S.Scheme Total =
   SC.At[Total,N,us,opens,\ j -> Part[j].scheme,covers].theorem ;
 } ;
 module Chosen (X : U l) (affX : FA.Affine X) (Y : X -> U l)
  (cs : (x : X) -> S.Cover[Y x]) {
  count (x : X) : Nat = (cs x).size ;
  theorem : S.Scheme ((x : X) * Y x) =
   Tr.Trunc[Bound.Goal X count].induction @l
    (\ t -> S.Scheme ((x : X) * Y x)) (\ t -> S.proposition ((x : X) * Y x))
    (\ b -> Bounded[X,SB.affine X affX,Y,cs,b.1,b.2].theorem)
    (Bound.theorem X affX count) ;
 } ;
 module Local (X : U l) (Y : X -> U l) (w : Choice.Witness X (\ x -> S.Cover[Y x])) {
  c : S.Cover[X] = w.1 ;
  module Part (i : Fin c.size) {
   D : U l = S.Domain X (c.charts i) ;
   affine : FA.Affine D = SA.Presented[(c.charts i).presentation].affine ;
   family (a : D) : U l = Y ((c.charts i).map a) ;
   theorem : S.Scheme ((a : D) * family a) = Chosen[D,affine,family,w.2 i].theorem ;
  } ;
  theorem : S.Scheme ((x : X) * Y x) = CS.At[X,c,Y].theorem (\ i -> Part[i].theorem) ;
 } ;
 theorem (X : U l) (scheme : S.Scheme X) (Y : X -> U l)
  (schemes : (x : X) -> S.Scheme (Y x)) : S.Scheme ((x : X) * Y x) =
  Tr.Trunc[Choice.Witness X (\ x -> S.Cover[Y x])].induction @l
   (\ t -> S.Scheme ((x : X) * Y x)) (\ t -> S.proposition ((x : X) * Y x))
   (\ w -> Local[X,Y,w].theorem) (Choice.theorem X scheme (\ x -> S.Cover[Y x]) schemes) ;
} ;
