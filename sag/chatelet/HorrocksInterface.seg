-- Rank-one affine Horrocks: a target type, not a postulate.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module Polynomial = PolynomialRing[l].Extension[A,setA] ;
 module Raw = Poly[l].PolyR[A] ;
 module Mat = RankOneProjector[l].Over[Polynomial.ring] ;
 -- Append the leading coefficient 1 to the list of lower coefficients.
 monic-list : List A.R -> List A.R = split {
  nil -> cons A.o nil ;
  cons a p | ih -> cons a ih } ;
 monic (lower : List A.R) : Polynomial.Carrier =
  Polynomial.include (monic-list lower) ;
 leading : (lower : List A.R) ->
  Id A.R (Raw.coef (monic-list lower) (len lower)) A.o = split {
  nil -> refl A.o ;
  cons a p | ih -> ih } ;
 above : (lower : List A.R) (k : Nat) ->
  Id A.R (Raw.coef (monic-list lower) (plus (suc (len lower)) k)) A.z = split {
  nil -> \ k -> refl A.z ;
  cons a p | ih -> ih } ;
 Horrocks : U l = (lower : List A.R) (n : Nat)
  (e : Mat.Size[n].Projector) ->
  Mat.Size[n].FreeAfter e.entry (monic lower) -> Mat.Size[n].Free e.entry ;
} ;
