-- Convert the degree-and-coefficient form of monicity back to A's interface.
level l ; open Ring[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module P = Poly[l].PolyR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 normalized-coefficients : (r : Nat) (p : P.P) -> Bounds.Bound (suc r) p ->
  Id A.R (P.coef p r) A.o ->
  P.peq p (H.monic-list (Bounds.cut r p)) = split {
  zero -> \ p bound leading -> split {
   zero -> leading ;
   suc k -> bound k } ;
  suc r | ih -> \ p bound leading -> split {
   zero -> refl (P.coef p zero) ;
   suc k -> trans (sym (Bounds.tail-coef p k))
    (ih (Bounds.tail p) (Bounds.tail-bound (suc r) p bound)
     (trans (Bounds.tail-coef p r) leading) k) } } ;
 equation (r : Nat) (p : P.P) (bound : Bounds.Bound (suc r) p)
  (leading : Id A.R (P.coef p r) A.o) :
  Id B.Carrier (B.include p) (H.monic (Bounds.cut r p)) =
  B.Q.relates p (H.monic-list (Bounds.cut r p)) (normalized-coefficients r p bound leading) ;
} ;
