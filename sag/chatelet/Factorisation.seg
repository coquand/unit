-- Existence in Lemma 4.4: every t : Units -> Units is merely
--   t(x) = u x^d a(x) b(1/x)
-- with u a unit and a, b : R -> Units.  With p(x) = x^N t(x) and
-- q(x) = x^M t(x)^-1 (LaurentRep), p q = X^(N+M) as coefficient lists, so
-- by Pivot one coefficient c = p_i is a unit and the others are nilpotent.
-- Then t(x) = c x^(i-N) (1 + sum_j (p_j/c) x^(j-i)) and NilFactor factors
-- the last factor.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC)
 (loc : StandardOpens[l].Over[R,setR].Locality) {
 open R ; open RL[R] ;
 module PV = Pivot[l].Over[R,setR,sqc,loc] ;
 module NF = NilFactor[l].Over[R,setR,sqc,loc.1] ;
 module SP = NF.SP ;
 module LR = SP.LR ;
 module CI = LR.CI ;
 module UV = CI.UV ;
 module X = UV.X ;
 module Raw = PV.Raw ;
 module M = PV.M ;
 module L = RawLaws[l].Laws[R] ;
 module XL = AffineRing[l].Laws[X.ring,X.set] ;
 module G = PV.G ;
 module UP = PV.UP ;
 module Pow = AffinePowers[l].Over[R] ;
 module PI = PicardInterface[l].Over[R,setR] ;
 module U23 = Units23[l].Over[R,setR,sqc,loc] ;
 -- evaluation of coefficient lists
 incl-diff (a b : Raw.P) : Id X.Carrier (X.include (M.addP a (L.negP b))) (X.addQ (X.include a) (X.negQ (X.include b))) =
  trans (sym (X.Add.beta a (L.negP b))) (ap (X.addQ (X.include a)) (sym (X.Negate.beta b))) ;
 ev-diff (a b : Raw.P) (x : R.R) : Id R.R (Raw.ev (M.addP a (L.negP b)) x) (add (Raw.ev a x) (neg (Raw.ev b x))) =
  trans (CI.at (M.addP a (L.negP b)) x)
   (trans (ap (CI.point x).1.1 (incl-diff a b))
    (trans ((CI.point x).1.2.2.1 (X.include a) (X.negQ (X.include b)))
     (Presentations[l].cong2 R.R add _ _ _ _ (sym (CI.at a x))
      (trans (RingHom[l].negation X.ring R (CI.point x).1 (X.include b)) (ap neg (sym (CI.at b x))))))) ;
 ev-mul (a b : Raw.P) (x : R.R) : Id R.R (Raw.ev (M.pmul a b) x) (mul (Raw.ev a x) (Raw.ev b x)) =
  trans (CI.at (M.pmul a b) x)
   (trans (ap (CI.point x).1.1 (sym (X.Multiply.beta a b)))
    (trans ((CI.point x).1.2.2.2 (X.include a) (X.include b))
     (Presentations[l].cong2 R.R mul _ _ _ _ (sym (CI.at a x)) (sym (CI.at b x))))) ;
 ev-shift : (K : Nat) (p : Raw.P) (x : R.R) -> Id R.R (Raw.ev (PV.shiftN K p) x) (mul (Pow.power x K) (Raw.ev p x)) = split {
  zero -> \ p x -> sym (Pow.one-left (Raw.ev p x)) ;
  suc K | r -> \ p x -> trans (zl (mul x (Raw.ev (PV.shiftN K p) x)))
   (trans (ap (mul x) (r p x)) (mulA x (Pow.power x K) (Raw.ev p x))) } ;
 -- two polynomials agreeing on the units are equal
 agreement (a b : Raw.P) (h : (u : G.Unit) -> Id R.R (Raw.ev a u.1) (Raw.ev b u.1)) : Raw.peq a b =
  let {
   v (x : R.R) (ux : unit x) : Id R.R (Raw.ev (M.addP a (L.negP b)) x) z =
    trans (ev-diff a b x) (trans (ap (\ s -> add s (neg (Raw.ev b x))) (h (x,ux))) (addN (Raw.ev b x))) ;
   z0 : Id X.Carrier (X.addQ (X.include a) (X.negQ (X.include b))) X.zeroQ =
    trans (sym (incl-diff a b)) (X.Q.relates _ _ UV.Vanish[M.addP a (L.negP b),v].result) ;
  } in X.Q.effective a b (XL.difference-zero (X.include a) (X.include b) z0) ;
 power-one : (N : Nat) -> Id R.R (Pow.power o N) o = split {
  zero -> refl o ; suc N | r -> trans (ap (mul o) r) (mulO o) } ;
 no-cycle : (i a : Nat) -> Not (Id Nat i (plus i (suc a))) = split {
  zero -> \ a e -> zero-suc a e ;
  suc i | r -> \ a e -> r a (Pr.ap Nat Nat pred _ _ e) } ;
 module For (t : G.Unit -> G.Unit) {
  phi (u : G.Unit) : R.R = (t u).1 ;
  psi (u : G.Unit) : R.R = (t u).2.1 ;
  module Reps (rp : LR.Rep phi) (rq : LR.Rep psi) {
   P : Raw.P = rp.1 ; N : Nat = rp.2.1 ;
   Q : Raw.P = rq.1 ; Mq : Nat = rq.2.1 ;
   K : Nat = plus N Mq ;
   prod-agree (u : G.Unit) : Id R.R (Raw.ev (M.pmul P Q) u.1) (Raw.ev (PV.shiftN K PV.one) u.1) = calc R.R {
    Raw.ev (M.pmul P Q) u.1
     =< ev-mul P Q u.1 > mul (Raw.ev P u.1) (Raw.ev Q u.1)
     =< Presentations[l].cong2 R.R mul _ _ _ _ (rp.2.2 u) (rq.2.2 u)
     > mul (mul (Pow.power u.1 N) (phi u)) (mul (Pow.power u.1 Mq) (psi u))
     =< G.four (Pow.power u.1 N) (phi u) (Pow.power u.1 Mq) (psi u)
     > mul (mul (Pow.power u.1 N) (Pow.power u.1 Mq)) (mul (phi u) (psi u))
     =< Presentations[l].cong2 R.R mul _ _ _ _ (sym (Pow.power-add u.1 N Mq)) (t u).2.2
     > mul (Pow.power u.1 K) o
     =< ap (mul (Pow.power u.1 K)) (sym (add-mulzero o u.1)) > mul (Pow.power u.1 K) (Raw.ev PV.one u.1)
     =< sym (ev-shift K PV.one u.1) > Raw.ev (PV.shiftN K PV.one) u.1 } ;
   hPQ : Raw.peq (M.pmul P Q) (PV.shiftN K PV.one) = agreement (M.pmul P Q) (PV.shiftN K PV.one) prod-agree ;
   pu : unit (Raw.ev P o) =
    Pr.subst R.R unit _ _
     (sym (trans (rp.2.2 G.one) (trans (ap (\ s -> mul s (phi G.one)) (power-one N)) (Pow.one-left (phi G.one)))))
     (t G.one).2 ;
   module Pivoted (i : Nat) (g : PV.Good P i) {
    c : R.R = Raw.coef P i ;
    ci : R.R = g.1.1 ;
    mono-c : Raw.P = PV.shiftN i (cons c nil) ;
    Phat : Raw.P = M.addP P (L.negP mono-c) ;
    coef-hat (j : Nat) : Id R.R (Raw.coef Phat j) (add (Raw.coef P j) (neg (Raw.coef mono-c j))) =
     trans (M.coef-addP P (L.negP mono-c) j) (ap (add (Raw.coef P j)) (L.neg-coef mono-c j)) ;
    hat-i : Id R.R (Raw.coef Phat i) z =
     trans (coef-hat i) (trans (ap (\ s -> add c (neg s)) (PV.coef-at i (cons c nil))) (addN c)) ;
    hat-other (j : Nat) (ne : Not (Id Nat j i)) (mz : Id R.R (Raw.coef mono-c j) z) :
     PV.NN (Id R.R (Raw.coef Phat j) z) = \ k -> g.2 j ne (\ h -> k (trans (coef-hat j)
      (trans (Presentations[l].cong2 R.R add _ _ _ _ h (trans (ap neg mz) neg-zero)) (addZ z)))) ;
    hat-apart (j : Nat) :
     Plus ((a : Nat) * Id Nat j (plus i (suc a))) ((a : Nat) * Id Nat i (plus j (suc a))) ->
     PV.NN (Id R.R (Raw.coef Phat j) z) = split {
     inl w -> hat-other j (\ e -> no-cycle i w.1 (trans (sym e) w.2))
      (trans (ap (Raw.coef mono-c) w.2) (PV.coef-shift i (cons c nil) (suc w.1))) ;
     inr w -> hat-other j (\ e -> no-cycle j w.1 (trans e w.2))
      (trans (ap (\ m -> Raw.coef (PV.shiftN m (cons c nil)) j) w.2) (PV.coef-low j w.1 (cons c nil))) } ;
    hat-cmp (j : Nat) : UP.Cmp j i -> PV.NN (Id R.R (Raw.coef Phat j) z) = split {
     inl e -> \ k -> k (Pr.subst Nat (\ m -> Id R.R (Raw.coef Phat m) z) i j (sym e) hat-i) ;
     inr a -> hat-apart j a } ;
    nn-hat (j : Nat) : PV.NN (Id R.R (Raw.coef Phat j) z) = hat-cmp j (UP.compare j i) ;
    -- the nilpotent terms (p_j/c) x^j y^i
    mono (k : Nat) (u : G.Unit) : R.R = mul (Pow.power u.2.1 i) (Pow.power u.1 k) ;
    nil-term (a : R.R) (n : PV.NN (Id R.R a z)) : Pow.Nilpotent (mul ci a) =
     U23.nn-nilpotent (mul ci a) (\ k2 -> n (\ h -> k2 (trans (ap (mul ci) h) (mul-zero ci)))) ;
    termsOf : (q : Raw.P) -> (k : Nat) -> ((j : Nat) -> PV.NN (Id R.R (Raw.coef q j) z)) -> List NF.Term = split {
     nil -> \ k nq -> nil ;
     cons a q | r -> \ k nq -> cons (mul ci a,mono k,nil-term a (nq zero)) (r (suc k) (\ j -> nq (suc j))) } ;
    sum-terms : (q : Raw.P) (k : Nat) (nq : (j : Nat) -> PV.NN (Id R.R (Raw.coef q j) z)) (u : G.Unit) ->
     Id R.R (NF.sumT (termsOf q k nq) u) (mul (mul ci (Pow.power u.2.1 i)) (mul (Pow.power u.1 k) (Raw.ev q u.1))) = split {
     nil -> \ k nq u -> sym (trans (ap (mul (mul ci (Pow.power u.2.1 i))) (mul-zero (Pow.power u.1 k)))
      (mul-zero (mul ci (Pow.power u.2.1 i)))) ;
     cons a q | r -> \ k nq u -> calc R.R {
      add (mul (mul ci a) (mono k u)) (NF.sumT (termsOf q (suc k) (\ j -> nq (suc j))) u)
       =< Presentations[l].cong2 R.R add _ _ _ _
         (trans (G.four ci a (Pow.power u.2.1 i) (Pow.power u.1 k))
          (ap (mul (mul ci (Pow.power u.2.1 i))) (mulC a (Pow.power u.1 k))))
         (r (suc k) (\ j -> nq (suc j)) u)
       > add (mul (mul ci (Pow.power u.2.1 i)) (mul (Pow.power u.1 k) a))
          (mul (mul ci (Pow.power u.2.1 i)) (mul (mul u.1 (Pow.power u.1 k)) (Raw.ev q u.1)))
       =< sym (dist (mul ci (Pow.power u.2.1 i)) (mul (Pow.power u.1 k) a) (mul (mul u.1 (Pow.power u.1 k)) (Raw.ev q u.1)))
       > mul (mul ci (Pow.power u.2.1 i)) (add (mul (Pow.power u.1 k) a) (mul (mul u.1 (Pow.power u.1 k)) (Raw.ev q u.1)))
       =< ap (mul (mul ci (Pow.power u.2.1 i))) (sym (trans (dist (Pow.power u.1 k) a (mul u.1 (Raw.ev q u.1)))
         (ap (add (mul (Pow.power u.1 k) a)) (trans (mul-swap (Pow.power u.1 k) u.1 (Raw.ev q u.1))
          (mulA u.1 (Pow.power u.1 k) (Raw.ev q u.1))))))
       > mul (mul ci (Pow.power u.2.1 i)) (mul (Pow.power u.1 k) (add a (mul u.1 (Raw.ev q u.1)))) } } ;
    terms : List NF.Term = termsOf Phat zero nn-hat ;
    -- t(x) = c x^i y^N (1 + sum of the terms)
    ev-mono (x : R.R) : Id R.R (Raw.ev mono-c x) (mul (Pow.power x i) c) =
     trans (ev-shift i (cons c nil) x) (ap (mul (Pow.power x i)) (add-mulzero c x)) ;
    ev-split (x : R.R) : Id R.R (Raw.ev P x) (add (mul (Pow.power x i) c) (Raw.ev Phat x)) = sym (calc R.R {
     add (mul (Pow.power x i) c) (Raw.ev Phat x)
      =< ap (add (mul (Pow.power x i) c)) (trans (ev-diff P mono-c x) (ap (\ s -> add (Raw.ev P x) (neg s)) (ev-mono x)))
      > add (mul (Pow.power x i) c) (add (Raw.ev P x) (neg (mul (Pow.power x i) c)))
      =< addC (mul (Pow.power x i) c) (add (Raw.ev P x) (neg (mul (Pow.power x i) c)))
      > add (add (Raw.ev P x) (neg (mul (Pow.power x i) c))) (mul (Pow.power x i) c)
      =< sym (addA (Raw.ev P x) (neg (mul (Pow.power x i) c)) (mul (Pow.power x i) c))
      > add (Raw.ev P x) (add (neg (mul (Pow.power x i) c)) (mul (Pow.power x i) c))
      =< ap (add (Raw.ev P x)) (trans (addC (neg (mul (Pow.power x i) c)) (mul (Pow.power x i) c)) (addN (mul (Pow.power x i) c)))
      > add (Raw.ev P x) z
      =< addZ (Raw.ev P x) > Raw.ev P x }) ;
    yx-i (u : G.Unit) : Id R.R (mul (Pow.power u.2.1 i) (Pow.power u.1 i)) o =
     trans (mulC (Pow.power u.2.1 i) (Pow.power u.1 i)) (SP.xy-power u i) ;
    YX (u : G.Unit) : R.R = mul (Pow.power u.2.1 N) (Pow.power u.1 i) ;
    tail-part (u : G.Unit) (H : R.R) :
     Id R.R (mul (mul c (YX u)) (mul (mul ci (Pow.power u.2.1 i)) (mul o H))) (mul (Pow.power u.2.1 N) H) = calc R.R {
     mul (mul c (YX u)) (mul (mul ci (Pow.power u.2.1 i)) (mul o H))
      =< ap (\ s -> mul (mul c (YX u)) (mul (mul ci (Pow.power u.2.1 i)) s)) (Pow.one-left H)
      > mul (mul c (YX u)) (mul (mul ci (Pow.power u.2.1 i)) H)
      =< G.four c (YX u) (mul ci (Pow.power u.2.1 i)) H
      > mul (mul c (mul ci (Pow.power u.2.1 i))) (mul (YX u) H)
      =< ap (\ s -> mul s (mul (YX u) H))
        (trans (mulA c ci (Pow.power u.2.1 i)) (trans (ap (\ s -> mul s (Pow.power u.2.1 i)) g.1.2) (Pow.one-left (Pow.power u.2.1 i))))
      > mul (Pow.power u.2.1 i) (mul (YX u) H)
      =< ap (mul (Pow.power u.2.1 i)) (sym (mulA (Pow.power u.2.1 N) (Pow.power u.1 i) H))
      > mul (Pow.power u.2.1 i) (mul (Pow.power u.2.1 N) (mul (Pow.power u.1 i) H))
      =< mul-swap (Pow.power u.2.1 i) (Pow.power u.2.1 N) (mul (Pow.power u.1 i) H)
      > mul (Pow.power u.2.1 N) (mul (Pow.power u.2.1 i) (mul (Pow.power u.1 i) H))
      =< ap (mul (Pow.power u.2.1 N)) (trans (mulA (Pow.power u.2.1 i) (Pow.power u.1 i) H)
        (trans (ap (\ s -> mul s H) (yx-i u)) (Pow.one-left H)))
      > mul (Pow.power u.2.1 N) H } ;
    identity (u : G.Unit) : Id R.R (phi u) (mul (mul c (YX u)) (add o (NF.sumT terms u))) = sym (calc R.R {
     mul (mul c (YX u)) (add o (NF.sumT terms u))
      =< dist (mul c (YX u)) o (NF.sumT terms u) > add (mul (mul c (YX u)) o) (mul (mul c (YX u)) (NF.sumT terms u))
      =< Presentations[l].cong2 R.R add _ _ _ _ (mulO (mul c (YX u)))
        (trans (ap (mul (mul c (YX u))) (sum-terms Phat zero nn-hat u)) (tail-part u (Raw.ev Phat u.1)))
      > add (mul c (YX u)) (mul (Pow.power u.2.1 N) (Raw.ev Phat u.1))
      =< ap (\ s -> add s (mul (Pow.power u.2.1 N) (Raw.ev Phat u.1)))
        (trans (mulC c (YX u)) (trans (sym (mulA (Pow.power u.2.1 N) (Pow.power u.1 i) c))
         (ap (mul (Pow.power u.2.1 N)) (refl (mul (Pow.power u.1 i) c)))))
      > add (mul (Pow.power u.2.1 N) (mul (Pow.power u.1 i) c)) (mul (Pow.power u.2.1 N) (Raw.ev Phat u.1))
      =< sym (dist (Pow.power u.2.1 N) (mul (Pow.power u.1 i) c) (Raw.ev Phat u.1))
      > mul (Pow.power u.2.1 N) (add (mul (Pow.power u.1 i) c) (Raw.ev Phat u.1))
      =< ap (mul (Pow.power u.2.1 N)) (sym (ev-split u.1)) > mul (Pow.power u.2.1 N) (Raw.ev P u.1)
      =< sym (SP.from-rep phi rp u) > phi u }) ;
    -- the degree i - N
    DegW : U l = (d : PicardInterface[l].Degree) *
     ((u : G.Unit) -> Id R.R (PI.monomial d u).1 (YX u)) ;
    deg-eq (e : Id Nat i N) : DegW = (nonneg zero,\ u ->
     sym (trans (ap (\ m -> mul (Pow.power u.2.1 N) (Pow.power u.1 m)) e)
      (trans (mulC (Pow.power u.2.1 N) (Pow.power u.1 N)) (SP.xy-power u N)))) ;
    deg-apart : Plus ((j : Nat) * Id Nat i (plus N (suc j))) ((j : Nat) * Id Nat N (plus i (suc j))) -> DegW = split {
     inl w -> (nonneg (suc w.1),\ u -> trans (UP.power-fst u (suc w.1)) (sym (calc R.R {
      mul (Pow.power u.2.1 N) (Pow.power u.1 i)
       =< ap (\ m -> mul (Pow.power u.2.1 N) (Pow.power u.1 m)) w.2
       > mul (Pow.power u.2.1 N) (Pow.power u.1 (plus N (suc w.1)))
       =< ap (mul (Pow.power u.2.1 N)) (Pow.power-add u.1 N (suc w.1))
       > mul (Pow.power u.2.1 N) (mul (Pow.power u.1 N) (Pow.power u.1 (suc w.1)))
       =< mulA (Pow.power u.2.1 N) (Pow.power u.1 N) (Pow.power u.1 (suc w.1))
       > mul (mul (Pow.power u.2.1 N) (Pow.power u.1 N)) (Pow.power u.1 (suc w.1))
       =< ap (\ s -> mul s (Pow.power u.1 (suc w.1))) (trans (mulC (Pow.power u.2.1 N) (Pow.power u.1 N)) (SP.xy-power u N))
       > mul o (Pow.power u.1 (suc w.1))
       =< Pow.one-left (Pow.power u.1 (suc w.1)) > Pow.power u.1 (suc w.1) }))) ;
     inr w -> (negative w.1,\ u -> trans (UP.power-fst (G.inverse u) (suc w.1)) (sym (calc R.R {
      mul (Pow.power u.2.1 N) (Pow.power u.1 i)
       =< ap (\ m -> mul (Pow.power u.2.1 m) (Pow.power u.1 i)) w.2
       > mul (Pow.power u.2.1 (plus i (suc w.1))) (Pow.power u.1 i)
       =< ap (\ s -> mul s (Pow.power u.1 i)) (trans (Pow.power-add u.2.1 i (suc w.1))
         (mulC (Pow.power u.2.1 i) (Pow.power u.2.1 (suc w.1))))
       > mul (mul (Pow.power u.2.1 (suc w.1)) (Pow.power u.2.1 i)) (Pow.power u.1 i)
       =< sym (mulA (Pow.power u.2.1 (suc w.1)) (Pow.power u.2.1 i) (Pow.power u.1 i))
       > mul (Pow.power u.2.1 (suc w.1)) (mul (Pow.power u.2.1 i) (Pow.power u.1 i))
       =< ap (mul (Pow.power u.2.1 (suc w.1))) (yx-i u) > mul (Pow.power u.2.1 (suc w.1)) o
       =< mulO (Pow.power u.2.1 (suc w.1)) > Pow.power u.2.1 (suc w.1) }))) } ;
    deg-cmp : UP.Cmp i N -> DegW = split { inl e -> deg-eq e ; inr a -> deg-apart a } ;
    factors-from (f : NF.Factored (\ u -> add o (NF.sumT terms u))) (dw : DegW) : PI.Factors t =
     (dw.1,(c,g.1),f.1,f.2.1,\ u -> G.eq (t u) _ (calc R.R {
      phi u =< identity u > mul (mul c (YX u)) (add o (NF.sumT terms u))
       =< ap (mul (mul c (YX u))) (f.2.2 u) > mul (mul c (YX u)) (mul (f.1 u.1).1 (f.2.1 u.2.1).1)
       =< sym (mulA c (YX u) (mul (f.1 u.1).1 (f.2.1 u.2.1).1))
       > mul c (mul (YX u) (mul (f.1 u.1).1 (f.2.1 u.2.1).1))
       =< ap (\ s -> mul c (mul s (mul (f.1 u.1).1 (f.2.1 u.2.1).1))) (sym (dw.2 u))
       > mul c (mul (PI.monomial dw.1 u).1 (mul (f.1 u.1).1 (f.2.1 u.2.1).1)) })) ;
    result : Tr.Trunc[PI.Factors t].carrier =
     Tr.Trunc[NF.Factored (\ u -> add o (NF.sumT terms u))].induction @l
      (\ s -> Tr.Trunc[PI.Factors t].carrier) (\ s -> Tr.Trunc[PI.Factors t].proposition)
      (\ f -> Tr.Trunc[PI.Factors t].inc (factors-from f (deg-cmp (UP.compare i N))))
      (NF.factor-terms terms) ;
   } ;
   result : Tr.Trunc[PI.Factors t].carrier =
    Tr.Trunc[(i : Nat) * PV.Good P i].induction @l
     (\ s -> Tr.Trunc[PI.Factors t].carrier) (\ s -> Tr.Trunc[PI.Factors t].proposition)
     (\ w -> Pivoted[w.1,w.2].result) (PV.Main[P,Q,K,hPQ,pu].result) ;
  } ;
  factors : Tr.Trunc[PI.Factors t].carrier =
   Tr.Trunc[LR.Rep phi].induction @l (\ s -> Tr.Trunc[PI.Factors t].carrier)
    (\ s -> Tr.Trunc[PI.Factors t].proposition)
    (\ rp -> Tr.Trunc[LR.Rep psi].induction @l (\ s -> Tr.Trunc[PI.Factors t].carrier)
      (\ s -> Tr.Trunc[PI.Factors t].proposition) (\ rq -> Reps[rp,rq].result) (LR.representation psi))
    (LR.representation phi) ;
 } ;
 factorisation : PI.Factorisation = \ t -> For[t].factors ;
} ;
