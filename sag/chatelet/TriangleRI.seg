-- The action of an algebra isomorphism phi : A ~ B on right ideals,
-- RI(phi) : RI A -> RI B, I |-> phi[I], and transport of structure for RI
-- (Prop 3.3.1 of sevb.pdf): transporting along ap RI (sip phi) is RI(phi).
--
-- phi[I] is the preimage of I under phi^-1, so membership needs no
-- truncation; the basis f, g of I gives the basis phi f, g phi^-1.  The
-- transport statement is pointwise (an equality in RI B for every I), by
-- iso-induction (AlgSIP2.iso-ind): at the identity both sides are I, since
-- sip (idIso A) = refl and RI(idIso) only changes proofs of propositions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module P2 = Prelude[l++] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (I : U l) (G : I -> U l)
 (sh : [j] SheafClosure[l,j].Over[I,G].Ops) {
 module AP = AzumayaProbe[l].Over[R,setR,n,I,G,sh] ;
 module AS = AlgSIP2[l].Over[R,setR] ;
 module RIm (A B : AS.Alg) (phi : AS.AlgIso A B) {
  e (x : A.A) : B.A = phi.1.1 x ;
  ei (y : B.A) : A.A = phi.1.2.sec y ;
  ee (y : B.A) : Id B.A (e (ei y)) y = phi.1.2.sec-eq y ;
  ie (x : A.A) : Id A.A (ei (e x)) x = Pr.sec-ret A.A B.A phi.1.1 phi.1.2 x ;
  -- phi^-1 is a homomorphism
  ei-add (y y' : B.A) : Id A.A (ei (B.add y y')) (A.add (ei y) (ei y')) =
   trans (ap ei (trans (cong2 B.A B.add y (e (ei y)) y' (e (ei y')) (sym (ee y)) (sym (ee y')))
     (sym (phi.2.1 (ei y) (ei y'))))) (ie (A.add (ei y) (ei y'))) ;
  ei-scale (a : R.R) (y : B.A) : Id A.A (ei (B.scale a y)) (A.scale a (ei y)) =
   trans (ap ei (trans (ap (B.scale a) (sym (ee y))) (sym (phi.2.2.1 a (ei y))))) (ie (A.scale a (ei y))) ;
  ei-mul (y y' : B.A) : Id A.A (ei (B.mul y y')) (A.mul (ei y) (ei y')) =
   trans (ap ei (trans (cong2 B.A B.mul y (e (ei y)) y' (e (ei y')) (sym (ee y)) (sym (ee y')))
     (sym (phi.2.2.2.1 (ei y) (ei y'))))) (ie (A.mul (ei y) (ei y'))) ;
  -- x + x = x gives x = 0
  idem-zero (x : B.A) (h : Id B.A (B.add x x) x) : Id B.A x B.zero =
   calc B.A {
    x =< sym (B.addZ x) > B.add x B.zero
      =< ap (B.add x) (sym (B.addN x)) > B.add x (B.add x (B.neg x))
      =< B.addA x x (B.neg x) > B.add (B.add x x) (B.neg x)
      =< ap (\ s -> B.add s (B.neg x)) h > B.add x (B.neg x)
      =< B.addN x > B.zero } ;
  e-zero : Id B.A (e A.zero) B.zero =
   idem-zero (e A.zero) (trans (sym (phi.2.1 A.zero A.zero)) (ap e (A.addZ A.zero))) ;
  ei-zero : Id A.A (ei B.zero) A.zero = trans (ap ei (sym e-zero)) (ie A.zero) ;
  -- the image of a subset
  Smap (S : AP.Sub A) : AP.Sub B = \ y -> S (ei y) ;
  memT (S : AP.Sub A) (x x' : A.A) (p : Id A.A x x') (m : AP.mem A S x) : AP.mem A S x' =
   Pr.subst A.A (\ z -> AP.mem A S z) x x' p m ;
  ideal-map (S : AP.Sub A) (id : AP.Ideal A S) : AP.Ideal B (Smap S) =
   (memT S A.zero (ei B.zero) (sym ei-zero) id.1,
    \ y y' my my' -> memT S (A.add (ei y) (ei y')) (ei (B.add y y')) (sym (ei-add y y')) (id.2.1 (ei y) (ei y') my my'),
    \ a y my -> memT S (A.scale a (ei y)) (ei (B.scale a y)) (sym (ei-scale a y)) (id.2.2.1 a (ei y) my),
    \ y y' my -> memT S (A.mul (ei y) (ei y')) (ei (B.mul y y')) (sym (ei-mul y y')) (id.2.2.2 (ei y) (ei y') my)) ;
  module Bas (S : AP.Sub A) (b : AP.Basis A S) {
   f (v : AP.V) : AP.Carrier A S = b.1 v ;
   feq : Pr.isEquiv AP.V (AP.Carrier A S) b.1 = b.2.2.2.1 ;
   g (x : A.A) : AP.V = b.2.2.2.2.1 x ;
   f' (v : AP.V) : AP.Carrier B (Smap S) = (e (f v).1,memT S (f v).1 (ei (e (f v).1)) (sym (ie (f v).1)) (f v).2) ;
   inv (Z : AP.Carrier B (Smap S)) : AP.V = feq.sec (ei Z.1,Z.2) ;
   carrier-eq (Z Z' : AP.Carrier B (Smap S)) (h : Id B.A Z.1 Z'.1) : Id (AP.Carrier B (Smap S)) Z Z' =
    Pr.Sigma-eq B.A (\ y -> AP.mem B (Smap S) y) Z.1 Z'.1 Z.2 Z'.2 h (AP.mem-prop B (Smap S) Z'.1) ;
   f'-inv (Z : AP.Carrier B (Smap S)) : Id (AP.Carrier B (Smap S)) (f' (inv Z)) Z =
    carrier-eq (f' (inv Z)) Z (trans (ap e (ap (\ c -> c.1) (feq.sec-eq (ei Z.1,Z.2)))) (ee Z.1)) ;
   inv-f' (v : AP.V) : Id AP.V (inv (f' v)) v =
    trans (ap feq.sec (Pr.Sigma-eq A.A (\ x -> AP.mem A S x) (ei (e (f v).1)) (f v).1 (f' v).2 (f v).2
      (ie (f v).1) (AP.mem-prop A S (f v).1)))
     (Pr.sec-ret AP.V (AP.Carrier A S) b.1 feq v) ;
   basis : AP.Basis B (Smap S) =
    (f',
     \ v w -> trans (ap e (b.2.1 v w)) (phi.2.1 (f v).1 (f w).1),
     \ a v -> trans (ap e (b.2.2.1 a v)) (phi.2.2.1 a (f v).1),
     Pr.qinv AP.V (AP.Carrier B (Smap S)) f' inv f'-inv inv-f',
     (\ y -> g (ei y),
      \ y y' i -> trans (ap (\ x -> g x i) (ei-add y y')) (b.2.2.2.2.2.1 (ei y) (ei y') i),
      \ a y i -> trans (ap (\ x -> g x i) (ei-scale a y)) (b.2.2.2.2.2.2.1 a (ei y) i),
      \ v i -> trans (ap (\ x -> g x i) (ie (f v).1)) (b.2.2.2.2.2.2.2 v i))) ;
  } ;
  close-map (S : AP.Sub A) : (sh @l).close (AP.Basis A S) -> (sh @l).close (AP.Basis B (Smap S)) =
   (sh @l).elim @l (AP.Basis A S) ((sh @l).close (AP.Basis B (Smap S)))
    ((sh @l).proposition (AP.Basis B (Smap S))) ((sh @l).modal (AP.Basis B (Smap S)))
    (\ bs -> (sh @l).inc (AP.Basis B (Smap S)) Bas[S,bs].basis) ;
  map (J : AP.RI A) : AP.RI B = (Smap J.1,ideal-map J.1 J.2.1,close-map J.1 J.2.2) ;
 } ;
 -- equality in RI is equality of the subsets
 ri-eq (A : AS.Alg) (J J' : AP.RI A) (h : Id (AP.Sub A) J.1 J'.1) : Id (AP.RI A) J J' =
  P1.Sigma-eq (AP.Sub A) (\ S -> AP.Ideal A S * (sh @l).close (AP.Basis A S)) J.1 J'.1 J.2 J'.2 h
   (AP.pair-prop (AP.Ideal A J'.1) ((sh @l).close (AP.Basis A J'.1))
     (AP.ideal-prop A J'.1) ((sh @l).proposition (AP.Basis A J'.1))) ;
 map-id (A : AS.Alg) (J : AP.RI A) : Id (AP.RI A) (RIm[A,A,AS.idIso A].map J) J =
  ri-eq A (RIm[A,A,AS.idIso A].map J) J (refl J.1) ;
 -- transport of structure
 coeRI (A B : AS.Alg) (p : Id AS.Alg A B) (J : AP.RI A) : AP.RI B =
  P1.coe (AP.RI A) (AP.RI B) (P2.ap AS.Alg (U l+) AP.RI A B p) J ;
 Goal (A B : AS.Alg) (phi : AS.AlgIso A B) : U l+ =
  (J : AP.RI A) -> Id (AP.RI B) (coeRI A B (AS.sip A B phi) J) (RIm[A,B,phi].map J) ;
 base (A : AS.Alg) : Goal A A (AS.idIso A) = \ J ->
  P1.trans (AP.RI A) (coeRI A A (AS.sip A A (AS.idIso A)) J) J (RIm[A,A,AS.idIso A].map J)
   (P1.ap (Id AS.Alg A A) (AP.RI A) (\ s -> coeRI A A s J) (AS.sip A A (AS.idIso A)) (refl A) (AS.sip-id A))
   (P1.sym (AP.RI A) (RIm[A,A,AS.idIso A].map J) J (map-id A J)) ;
 transport (A B : AS.Alg) (phi : AS.AlgIso A B) : Goal A B phi =
  AS.iso-ind A (\ B1 phi1 -> Goal A B1 phi1) (base A) B phi ;
} ;
