-- Pad a bounded finite system of equations with zero equations.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module CB = CoefficientBound[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module Cl = ClosedProp[l].Over[R,setR] ;
 pad : (n N : Nat) -> (Fin n -> R.R) -> CB.le n N -> Fin N -> R.R = split {
  zero -> \ N xs h j -> R.z ;
  suc n | ih -> split {
   zero -> \ xs h -> efq h ;
   suc N -> \ xs h -> AffineFinite[l].section N (\ j -> R.R)
    (ih N (\ i -> xs (inl i)) h) (xs (inr tt)) } } ;
 pad-in : (n N : Nat) (xs : Fin n -> R.R) (h : CB.le n N) ->
  Cl.Zeros n xs -> Cl.Zeros N (pad n N xs h) = split {
  zero -> \ N xs h z j -> refl R.z ;
  suc n | ih -> split {
   zero -> \ xs h z -> efq h ;
   suc N -> \ xs h z -> AffineFinite[l].section N
    (\ j -> Id R.R (pad (suc n) (suc N) xs h j) R.z)
    (ih N (\ i -> xs (inl i)) h (\ i -> z (inl i))) (z (inr tt)) } } ;
 pad-out : (n N : Nat) (xs : Fin n -> R.R) (h : CB.le n N) ->
  Cl.Zeros N (pad n N xs h) -> Cl.Zeros n xs = split {
  zero -> \ N xs h z -> AffineFinite[l].empty-section (\ j -> Id R.R (xs j) R.z) ;
  suc n | ih -> split {
   zero -> \ xs h z -> efq h ;
   suc N -> \ xs h z -> AffineFinite[l].section n (\ j -> Id R.R (xs j) R.z)
    (ih N (\ i -> xs (inl i)) h (\ i -> z (inl i))) (z (inr tt)) } } ;
 equivalence (n N : Nat) (xs : Fin n -> R.R) (h : CB.le n N) :
  Pr.Equiv (Cl.Zeros n xs) (Cl.Zeros N (pad n N xs h)) =
  (pad-in n N xs h,Pr.qinv (Cl.Zeros n xs) (Cl.Zeros N (pad n N xs h))
   (pad-in n N xs h) (pad-out n N xs h)
   (\ z -> Cl.zeros-prop N (pad n N xs h) _ z)
   (\ z -> Cl.zeros-prop n xs _ z)) ;
} ;
