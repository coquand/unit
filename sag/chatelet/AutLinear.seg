-- An invertible map phi of P^n (n = n0+1 >= 1) is induced by a linear
-- automorphism of R^{n+1}.  Lift phi and its inverse psi to F, G of weights
-- a, b (Lift).  Weights are not negative, since a function of negative
-- weight vanishes (Weights).  G (F x) = lambda(x) x, and
-- lambda(u x) u = (u^a)^b lambda(x).  If a or b is 0, lambda has weight -1;
-- if a b >= 2, lambda(t x) = c(t) lambda(x) with c(0) = 0; both are
-- impossible for a unit-valued lambda (Weights).  So a = b = 1, lambda is
-- a constant (Proposition 1.7), and F, G extend to linear maps with
-- G F = F G = lambda (WeightOne gives additivity).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n0 : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (cls : Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem) {
 open R ; open RL[R] ;
 n : Nat = suc n0 ;
 module LF = Lift[l].Over[R,setR,n0,sag,cls,n] ;
 module Q2 = LF.Q2 ;
 module G = LF.G ;
 module TW = LF.TW ;
 module W = Weights[l].Over[R,setR,sag.sqc,sag.loc,n0] ;
 module PS = W.PS ;
 module WO = WeightOne[l].Over[R,setR,sag.sqc] ;
 module PL = ProjectiveLinear[l].Over[R,setR,n,sag.sqc,sag.loc] ;
 module PF = ProjectiveFunctions[l].Over[R,setR,sag.sqc].Space[n0] ;
 module Pow = AffinePowers[l].Over[R] ;
 Pn : U l = Q2.Pn ;
 V : U l = Q2.V ;
 I : U l = Q2.I ;
 Point : U l = Q2.Point ;
 Degree : U l = LF.Degree ;
 e0 : V = split { inr t -> o ; inl j -> z } ;
 p0 : Point = (e0,Tr.Trunc[Q2.Pivots e0].inc (inr tt,(o,mulO o))) ;
 coord (v w : V) (h : Id V v w) (i : I) : Id R.R (v i) (w i) = Pr.happly I (\ j -> R.R) v w h i ;
 unit-zero (u : unit z) : Empty = sag.loc.1 (trans (sym u.2) (zero-mul u.1)) ;
 gpow (u : G.Unit) : (j : Nat) -> Id R.R (G.power u j).1 (Pow.power u.1 j) = split {
  zero -> refl o ;
  suc j | r -> ap (mul u.1) r } ;
 pow-one : (j : Nat) -> Id R.R (Pow.power o j) o = split {
  zero -> refl o ;
  suc j | r -> trans (one-left (Pow.power o j)) r } ;
 -- extensions of lifts
 ext-coord (Fv : Point -> V) (i : I) (v : V) : R.R = PS.extend (\ x -> Fv x i) v ;
 ext (Fv : Point -> V) (v : V) : V = \ i -> ext-coord Fv i v ;
 ext-on (Fv : Point -> V) (x : Point) : Id V (ext Fv x.1) (Fv x) =
  Q2.vector-eq (ext Fv x.1) (Fv x) (\ i -> PS.extend-restrict (\ y -> Fv y i) x) ;

 -- no lift has negative weight
 module NotNegative (Fv : Point -> V) (nz : (x : Point) -> Q2.NonZero (Fv x)) (k : Nat) (w : LF.Weight (negative k) Fv) {
  inverse-power (u : G.Unit) : Id R.R (mul (Pow.power u.1 (suc k)) (G.power (G.inverse u) (suc k)).1) o =
   trans (ap (\ c -> mul c (G.power (G.inverse u) (suc k)).1) (sym (gpow u (suc k))))
    (trans (ap (mul (G.power u (suc k)).1) (TW.power-inverse u (suc k))) (G.power u (suc k)).2.2) ;
  h (i : I) (u : G.Unit) (v : PS.Punctured) :
   Id R.R (mul (Pow.power u.1 (suc k)) (ext-coord Fv i (W.scale u.1 v.1))) (ext-coord Fv i v.1) =
   trans (ap (mul (Pow.power u.1 (suc k)))
     (trans (PS.extend-restrict (\ y -> Fv y i) (LF.scale-point u v)) (coord _ _ (w u v) i)))
    (trans (mulA (Pow.power u.1 (suc k)) (G.power (G.inverse u) (suc k)).1 (Fv v i))
     (trans (ap (\ c -> mul c (Fv v i)) (inverse-power u)) (trans (one-left (Fv v i)) (sym (PS.extend-restrict (\ y -> Fv y i) v))))) ;
  zero-at (i : I) (v : PS.Punctured) : Id R.R (Fv v i) z =
   trans (sym (PS.extend-restrict (\ y -> Fv y i) v)) (W.Negative[k,ext-coord Fv i,h i,v].result) ;
  absurd : Empty =
   Tr.Trunc[Q2.Pivots (Fv p0)].induction @l (\ t -> Empty) (\ t -> \ a b -> efq a)
    (\ pv -> unit-zero (Pr.subst R.R unit (Fv p0 pv.1) z (zero-at pv.1 p0) pv.2)) (nz p0) ;
 } ;
 weight-nonneg (Fv : Point -> V) (nz : (x : Point) -> Q2.NonZero (Fv x)) :
  (d : Degree) -> LF.Weight d Fv -> (a : Nat) * Id Degree d (nonneg a) = split {
  nonneg a -> \ w -> (a,refl (nonneg a)) ;
  negative k -> \ w -> efq (NotNegative[Fv,nz,k,w].absurd) } ;

 -- a unit-valued function with lambda(u x) u = (u^a)^b lambda(x) forces a = 1
 Key (lam : V -> R.R) (a b : Nat) : U l = (u : G.Unit) (v : PS.Punctured) ->
  Id R.R (mul (lam (W.scale u.1 v.1)) u.1) (mul (Pow.power (Pow.power u.1 a) b) (lam v.1)) ;
 module Degrees (lam : V -> R.R) (hu : (v : PS.Punctured) -> unit (lam v.1)) {
  -- M = 1: weight -1
  low (b : Nat) (M : Id R.R (Pow.power (Pow.power o zero) b) o) (key : (u : G.Unit) (v : PS.Punctured) ->
    Id R.R (mul (lam (W.scale u.1 v.1)) u.1) (mul (Pow.power (Pow.power u.1 zero) b) (lam v.1))) : Empty =
   unit-zero (Pr.subst R.R unit (lam p0.1) z
    (W.Negative[zero,lam,\ u v -> trans (trans (ap (\ c -> mul c (lam (W.scale u.1 v.1))) (mulO u.1)) (mulC u.1 (lam (W.scale u.1 v.1))))
      (trans (key u v) (trans (ap (\ c -> mul c (lam v.1)) M) (one-left (lam v.1)))),p0].result) (hu p0)) ;
  zero-b (a : Nat) (key : Key lam a zero) : Empty =
   unit-zero (Pr.subst R.R unit (lam p0.1) z
    (W.Negative[zero,lam,\ u v -> trans (trans (ap (\ c -> mul c (lam (W.scale u.1 v.1))) (mulO u.1)) (mulC u.1 (lam (W.scale u.1 v.1))))
      (trans (key u v) (one-left (lam v.1))),p0].result) (hu p0)) ;
  -- a = a'+1, b = b'+1:  (u^a)^b = u c(u)
  c (a' b' : Nat) (t : R.R) : R.R = mul (Pow.power t a') (Pow.power (Pow.power t (suc a')) b') ;
  factor (a' b' : Nat) (t : R.R) : Id R.R (Pow.power (Pow.power t (suc a')) (suc b')) (mul t (c a' b' t)) =
   sym (mulA t (Pow.power t a') (Pow.power (Pow.power t (suc a')) b')) ;
  divided (a' b' : Nat) (key : Key lam (suc a') (suc b')) (u : G.Unit) (v : PS.Punctured) :
   Id R.R (lam (W.scale u.1 v.1)) (mul (c a' b' u.1) (lam v.1)) =
   Q2.cancel (lam (W.scale u.1 v.1)) (mul (c a' b' u.1) (lam v.1)) u.1 u.2
    (trans (key u v) (trans (ap (\ e -> mul e (lam v.1)) (factor a' b' u.1))
     (trans (sym (mulA u.1 (c a' b' u.1) (lam v.1))) (mulC u.1 (mul (c a' b' u.1) (lam v.1)))))) ;
  high (a' b' : Nat) (c0 : Id R.R (c a' b' z) z) (key : Key lam (suc a') (suc b')) : Empty =
   W.positive (c a' b') c0 lam (divided a' b' key) hu ;
  c0-a (a'' b' : Nat) : Id R.R (c (suc a'') b' z) z =
   trans (ap (\ e -> mul e (Pow.power (Pow.power z (suc (suc a''))) b')) (zero-mul (Pow.power z a'')))
    (zero-mul (Pow.power (Pow.power z (suc (suc a''))) b')) ;
  c0-b (b'' : Nat) : Id R.R (c zero (suc b'') z) z =
   trans (one-left (Pow.power (Pow.power z (suc zero)) (suc b'')))
    (trans (ap (\ e -> mul e (Pow.power (Pow.power z (suc zero)) b'')) (zero-mul o)) (zero-mul (Pow.power (Pow.power z (suc zero)) b''))) ;
  inner : (a' b' : Nat) -> Key lam (suc a') (suc b') -> Id Nat (suc a') (suc zero) = split {
   suc a'' -> \ b' key -> efq (high (suc a'') b' (c0-a a'' b') key) ;
   zero -> split {
    zero -> \ key -> refl (suc zero) ;
    suc b'' -> \ key -> efq (high zero (suc b'') (c0-b b'') key) } } ;
  outer (a' : Nat) : (b : Nat) -> Key lam (suc a') b -> Id Nat (suc a') (suc zero) = split {
   zero -> \ key -> efq (zero-b (suc a') key) ;
   suc b' -> inner a' b' } ;
  degree-one : (a b : Nat) -> Key lam a b -> Id Nat a (suc zero) = split {
   zero -> \ b key -> efq (low b (pow-one b) key) ;
   suc a' -> outer a' } ;
 } ;

 -- an invertible map with lifts of weights a, b
 module Pair (phi psi : Pn -> Pn) (psiphi : (x : Pn) -> Id Pn (psi (phi x)) x)
  (a : Nat) (Fv : Point -> V) (nzF : (x : Point) -> Q2.NonZero (Fv x)) (wF : LF.Weight (nonneg a) Fv)
  (lF : (x : Point) -> Id Pn (phi (Q2.class x)) (Q2.class (Fv x,nzF x)))
  (b : Nat) (Gv : Point -> V) (nzG : (x : Point) -> Q2.NonZero (Gv x)) (wG : LF.Weight (nonneg b) Gv)
  (lG : (x : Point) -> Id Pn (psi (Q2.class x)) (Q2.class (Gv x,nzG x))) {
  FP (x : Point) : Point = (Fv x,nzF x) ;
  GP (x : Point) : Point = (Gv x,nzG x) ;
  back (x : Point) : Id Pn (Q2.class x) (Q2.class (GP (FP x))) =
   trans (sym (psiphi (Q2.class x))) (trans (ap psi (lF x)) (lG (FP x))) ;
  rel (x : Point) : Q2.Related x (GP (FP x)) = Q2.Q.effective x (GP (FP x)) (back x) ;
  lam (x : Point) : G.Unit = (rel x).1 ;
  lam-eq (x : Point) (i : I) : Id R.R (mul (lam x).1 (x.1 i)) (Gv (FP x) i) = coord _ _ (rel x).2 i ;
  FP-scale (u : G.Unit) (x : Point) : Id Point (FP (LF.scale-point u x)) (LF.scale-point (G.power u a) (FP x)) =
   Q2.point-eq (FP (LF.scale-point u x)) (LF.scale-point (G.power u a) (FP x)) (wF u x) ;
  M (u : G.Unit) : R.R = (G.power (G.power u a) b).1 ;
  M-pow (u : G.Unit) : Id R.R (M u) (Pow.power (Pow.power u.1 a) b) =
   trans (gpow (G.power u a) b) (ap (\ e -> Pow.power e b) (gpow u a)) ;
  composite (u : G.Unit) (x : Point) : Id V (Gv (FP (LF.scale-point u x))) (Q2.scale (M u) (Gv (FP x))) =
   trans (ap Gv (FP-scale u x)) (wG (G.power u a) (FP x)) ;
  key-at (u : G.Unit) (x : Point) (pv : Q2.Pivots x.1) :
   Id R.R (mul (lam (LF.scale-point u x)).1 u.1) (mul (M u) (lam x).1) =
   Q2.cancel (mul (lam (LF.scale-point u x)).1 u.1) (mul (M u) (lam x).1) (x.1 pv.1) pv.2
    (trans (sym (mulA (lam (LF.scale-point u x)).1 u.1 (x.1 pv.1)))
     (trans (lam-eq (LF.scale-point u x) pv.1)
      (trans (coord _ _ (composite u x) pv.1)
       (trans (ap (mul (M u)) (sym (lam-eq x pv.1))) (mulA (M u) (lam x).1 (x.1 pv.1)))))) ;
  key-point (u : G.Unit) (x : Point) : Id R.R (mul (lam (LF.scale-point u x)).1 u.1) (mul (M u) (lam x).1) =
   Tr.Trunc[Q2.Pivots x.1].induction @l (\ t -> Id R.R (mul (lam (LF.scale-point u x)).1 u.1) (mul (M u) (lam x).1))
    (\ t -> setR _ _) (key-at u x) x.2 ;
  -- lambda extended to R^{n+1}
  lamh (v : V) : R.R = PS.extend (\ x -> (lam x).1) v ;
  lamh-on (x : Point) : Id R.R (lamh x.1) (lam x).1 = PS.extend-restrict (\ y -> (lam y).1) x ;
  lamh-unit (x : PS.Punctured) : unit (lamh x.1) = Pr.subst R.R unit (lam x).1 (lamh x.1) (sym (lamh-on x)) (lam x).2 ;
  key : Key lamh a b = \ u v ->
   trans (ap (\ e -> mul e u.1) (lamh-on (LF.scale-point u v)))
    (trans (key-point u v) (Presentations[l].cong2 R.R mul _ _ _ _ (M-pow u) (sym (lamh-on v)))) ;
  degree-one : Id Nat a (suc zero) = Degrees[lamh,lamh-unit].degree-one a b key ;
 } ;

 -- a lift of weight 1 extends to a linear map
 module Linear (Fv : Point -> V) (w : LF.Weight (nonneg (suc zero)) Fv) {
  g (v : V) : V = ext Fv v ;
  h (i : I) (u : G.Unit) (v : PS.Punctured) :
   Id R.R (ext-coord Fv i (W.scale u.1 v.1)) (mul (mul u.1 o) (ext-coord Fv i v.1)) =
   trans (PS.extend-restrict (\ y -> Fv y i) (LF.scale-point u v))
    (trans (coord _ _ (w u v) i) (ap (mul (mul u.1 o)) (sym (PS.extend-restrict (\ y -> Fv y i) v)))) ;
  homogeneous (i : I) (t : R.R) (v : V) : Id R.R (ext-coord Fv i (W.scale t v)) (mul t (ext-coord Fv i v)) =
   trans (W.Hom[\ s -> mul s o,ext-coord Fv i,h i].all t v) (ap (\ e -> mul e (ext-coord Fv i v)) (mulO t)) ;
  linear : PL.Linear g = \ t v -> Q2.vector-eq (g (Q2.scale t v)) (Q2.scale t (g v)) (\ i -> homogeneous i t v) ;
  additive (v v' : V) : Id V (g (\ i -> add (v i) (v' i))) (\ i -> add (g v i) (g v' i)) =
   Q2.vector-eq (g (\ i -> add (v i) (v' i))) (\ i -> add (g v i) (g v' i))
    (\ i -> WO.Additive[suc n,ext-coord Fv i,homogeneous i].additive v v') ;
  on-points (x : Point) : Id V (g x.1) (Fv x) = ext-on Fv x ;
 } ;

 Additive (g : V -> V) : U l = (v v' : V) -> Id V (g (\ i -> add (v i) (v' i))) (\ i -> add (g v i) (g v' i)) ;
 scale-comm (a c : R.R) (v : V) : Id V (Q2.scale a (Q2.scale c v)) (Q2.scale c (Q2.scale a v)) =
  trans (Q2.scale-scale a c v) (trans (ap (\ e -> Q2.scale e v) (mulC a c)) (sym (Q2.scale-scale c a v))) ;
 scale-cancel (u : G.Unit) (v : V) : Id V (Q2.scale u.2.1 (Q2.scale u.1 v)) v =
  trans (Q2.scale-scale u.2.1 u.1 v) (trans (ap (\ e -> Q2.scale e v) (trans (mulC u.2.1 u.1) u.2.2)) (Q2.scale-one v)) ;
 Induced (phi : Pn -> Pn) : U l = (A : PL.Auto) * Additive A.1 * ((q : Pn) -> Id Pn (PL.Act[A].map q) (phi q)) ;
 module Build (phi psi : Pn -> Pn) (psiphi : (x : Pn) -> Id Pn (psi (phi x)) x) (phipsi : (x : Pn) -> Id Pn (phi (psi x)) x)
  (lf : LF.Lift phi) (lg : LF.Lift psi) {
  Fv : Point -> V = lf.2.1 ;
  nzF : (x : Point) -> Q2.NonZero (Fv x) = lf.2.2.1 ;
  lF : (x : Point) -> Id Pn (phi (Q2.class x)) (Q2.class (Fv x,nzF x)) = lf.2.2.2.2 ;
  Gv : Point -> V = lg.2.1 ;
  nzG : (x : Point) -> Q2.NonZero (Gv x) = lg.2.2.1 ;
  lG : (x : Point) -> Id Pn (psi (Q2.class x)) (Q2.class (Gv x,nzG x)) = lg.2.2.2.2 ;
  aF : (a : Nat) * Id Degree lf.1 (nonneg a) = weight-nonneg Fv nzF lf.1 lf.2.2.2.1 ;
  aG : (a : Nat) * Id Degree lg.1 (nonneg a) = weight-nonneg Gv nzG lg.1 lg.2.2.2.1 ;
  wF : LF.Weight (nonneg aF.1) Fv = Pr.subst Degree (\ d -> LF.Weight d Fv) lf.1 (nonneg aF.1) aF.2 lf.2.2.2.1 ;
  wG : LF.Weight (nonneg aG.1) Gv = Pr.subst Degree (\ d -> LF.Weight d Gv) lg.1 (nonneg aG.1) aG.2 lg.2.2.2.1 ;
  oneF : Id Nat aF.1 (suc zero) = Pair[phi,psi,psiphi,aF.1,Fv,nzF,wF,lF,aG.1,Gv,nzG,wG,lG].degree-one ;
  oneG : Id Nat aG.1 (suc zero) = Pair[psi,phi,phipsi,aG.1,Gv,nzG,wG,lG,aF.1,Fv,nzF,wF,lF].degree-one ;
  w1F : LF.Weight (nonneg (suc zero)) Fv = Pr.subst Nat (\ a -> LF.Weight (nonneg a) Fv) aF.1 (suc zero) oneF wF ;
  w1G : LF.Weight (nonneg (suc zero)) Gv = Pr.subst Nat (\ a -> LF.Weight (nonneg a) Gv) aG.1 (suc zero) oneG wG ;
  module PA = Pair[phi,psi,psiphi,suc zero,Fv,nzF,w1F,lF,suc zero,Gv,nzG,w1G,lG] ;
  module PB = Pair[psi,phi,phipsi,suc zero,Gv,nzG,w1G,lG,suc zero,Fv,nzF,w1F,lF] ;
  -- with weights 1, lambda is invariant, hence constant
  invariant-a (u : G.Unit) (x : Point) : Id R.R (PA.lam (LF.scale-point u x)).1 (PA.lam x).1 =
   Q2.cancel (PA.lam (LF.scale-point u x)).1 (PA.lam x).1 u.1 u.2
    (trans (PA.key-point u x) (trans (ap (\ e -> mul e (PA.lam x).1) (trans (mulO (mul u.1 o)) (mulO u.1))) (mulC u.1 (PA.lam x).1))) ;
  invariant-b (u : G.Unit) (x : Point) : Id R.R (PB.lam (LF.scale-point u x)).1 (PB.lam x).1 =
   Q2.cancel (PB.lam (LF.scale-point u x)).1 (PB.lam x).1 u.1 u.2
    (trans (PB.key-point u x) (trans (ap (\ e -> mul e (PB.lam x).1) (trans (mulO (mul u.1 o)) (mulO u.1))) (mulC u.1 (PB.lam x).1))) ;
  module DA = Q2.Q.Descend[R.R,setR,\ x -> (PA.lam x).1,
   \ x y r -> trans (sym (invariant-a r.1 x)) (ap (\ w -> (PA.lam w).1) (Q2.point-eq (LF.scale-point r.1 x) y r.2))] ;
  module DB = Q2.Q.Descend[R.R,setR,\ x -> (PB.lam x).1,
   \ x y r -> trans (sym (invariant-b r.1 x)) (ap (\ w -> (PB.lam w).1) (Q2.point-eq (LF.scale-point r.1 x) y r.2))] ;
  const-a (x : Point) : Id R.R (PA.lam x).1 (PA.lam p0).1 =
   trans (sym (DA.beta x)) (trans (PF.constant DA.map (Q2.class x) (Q2.class p0)) (DA.beta p0)) ;
  const-b (x : Point) : Id R.R (PB.lam x).1 (PB.lam p0).1 =
   trans (sym (DB.beta x)) (trans (PF.constant DB.map (Q2.class x) (Q2.class p0)) (DB.beta p0)) ;
  lam0 : G.Unit = PA.lam p0 ;
  mu0 : G.Unit = PB.lam p0 ;
  module LinF = Linear[Fv,w1F] ;
  module LinG = Linear[Gv,w1G] ;
  GF (v : V) : Id V (LinG.g (LinF.g v)) (Q2.scale lam0.1 v) =
   Q2.vector-eq (LinG.g (LinF.g v)) (Q2.scale lam0.1 v) (\ i ->
    W.same (\ v' -> LinG.g (LinF.g v') i) (\ v' -> mul lam0.1 (v' i))
     (\ x -> trans (coord _ _ (trans (ap LinG.g (LinF.on-points x)) (LinG.on-points (PA.FP x))) i)
       (trans (sym (PA.lam-eq x i)) (ap (\ e -> mul e (x.1 i)) (const-a x)))) v) ;
  FG (v : V) : Id V (LinF.g (LinG.g v)) (Q2.scale mu0.1 v) =
   Q2.vector-eq (LinF.g (LinG.g v)) (Q2.scale mu0.1 v) (\ i ->
    W.same (\ v' -> LinF.g (LinG.g v') i) (\ v' -> mul mu0.1 (v' i))
     (\ x -> trans (coord _ _ (trans (ap LinF.g (LinG.on-points x)) (LinF.on-points (PB.FP x))) i)
       (trans (sym (PB.lam-eq x i)) (ap (\ e -> mul e (x.1 i)) (const-b x)))) v) ;
  -- lam0 = mu0, comparing F G F at p0
  v0 : V = LinF.g p0.1 ;
  both : Id V (Q2.scale lam0.1 v0) (Q2.scale mu0.1 v0) =
   trans (sym (LinF.linear lam0.1 p0.1)) (trans (ap LinF.g (sym (GF p0.1))) (FG v0)) ;
  lam-mu : Id R.R lam0.1 mu0.1 =
   Tr.Trunc[Q2.Pivots (Fv p0)].induction @l (\ t -> Id R.R lam0.1 mu0.1) (\ t -> setR lam0.1 mu0.1)
    (\ pv -> Q2.cancel lam0.1 mu0.1 (Fv p0 pv.1) pv.2
      (trans (ap (mul lam0.1) (sym (coord _ _ (LinF.on-points p0) pv.1)))
       (trans (coord _ _ both pv.1) (ap (mul mu0.1) (coord _ _ (LinF.on-points p0) pv.1))))) (nzF p0) ;
  g (v : V) : V = LinF.g v ;
  h (w : V) : V = Q2.scale lam0.2.1 (LinG.g w) ;
  lin-h : PL.Linear h = \ a w -> trans (ap (Q2.scale lam0.2.1) (LinG.linear a w)) (scale-comm lam0.2.1 a (LinG.g w)) ;
  hg (v : V) : Id V (h (g v)) v = trans (ap (Q2.scale lam0.2.1) (GF v)) (scale-cancel lam0 v) ;
  gh (w : V) : Id V (g (h w)) w =
   trans (LinF.linear lam0.2.1 (LinG.g w))
    (trans (ap (Q2.scale lam0.2.1) (trans (FG w) (ap (\ e -> Q2.scale e w) (sym lam-mu)))) (scale-cancel lam0 w)) ;
  A : PL.Auto = (g,h,LinF.linear,lin-h,hg,gh) ;
  acts (q : Pn) : Id Pn (PL.Act[A].map q) (phi q) =
   Q2.Q.induction @l (\ q' -> Id Pn (PL.Act[A].map q') (phi q')) (\ q' -> Q2.Q.set _ _)
    (\ x -> trans (PL.Act[A].beta x)
      (trans (ap Q2.class (Q2.point-eq (PL.Act[A].point x) (Fv x,nzF x) (LinF.on-points x))) (sym (lF x)))) q ;
  result : Induced phi = (A,LinF.additive,acts) ;
 } ;
 surjective (phi psi : Pn -> Pn) (psiphi : (x : Pn) -> Id Pn (psi (phi x)) x) (phipsi : (x : Pn) -> Id Pn (phi (psi x)) x) :
  Tr.Trunc[Induced phi].carrier =
  Tr.Trunc[LF.Lift phi].induction @l (\ t -> Tr.Trunc[Induced phi].carrier) (\ t -> Tr.Trunc[Induced phi].proposition)
   (\ lf -> Tr.Trunc[LF.Lift psi].induction @l (\ t -> Tr.Trunc[Induced phi].carrier) (\ t -> Tr.Trunc[Induced phi].proposition)
     (\ lg -> Tr.Trunc[Induced phi].inc Build[phi,psi,psiphi,phipsi,lf,lg].result) LF.Map[psi].lift)
   LF.Map[phi].lift ;
} ;
