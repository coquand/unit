-- Explicit monic representatives of products and powers.
-- These witnesses supply the monic member required by Lemma 7.5.
level l ; open Ring[l] ;
plus-assoc : (n m k : Nat) -> Id Nat (plus (plus n m) k) (plus n (plus m k)) = split {
 zero -> \ m k -> refl (plus m k) ;
 suc n | ih -> \ m k -> ap (\ j -> suc j) (ih m k) } ;
module Raw (A : CRing) {
 open A ; open RL[A] ;
 open Poly[l].PolyR[A] ; open Mul[l].MulR[A] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 weaken (n m : Nat) (p : P) (h : Bounds.Bound n p) : Bounds.Bound (plus n m) p =
  \ k -> trans (ap (coef p) (plus-assoc n m k)) (h (plus m k)) ;
 product-bound (n : Nat) (f : P) (h : Bounds.Bound (suc n) f) :
  (q : P) -> Bounds.Bound (plus n (plen q)) (pmul f q) = split {
  nil -> \ k -> refl z ;
  cons b q | ih -> \ k ->
   trans (ap (coef (pmul f (cons b q))) (ap (\ j -> plus j k) (plus-suc n (plen q))))
    (trans (coef-addP (scal b f) (cons z (pmul f q)) (suc (plus (plus n (plen q)) k)))
     (trans (ap (\ c -> add c (coef (pmul f q) (plus (plus n (plen q)) k)))
       (Bounds.scale-bound (plus (suc n) (plen q)) b f (weaken (suc n) (plen q) f h) k))
      (trans (ap (add z) (ih k)) (addZ z)))) } ;
} ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module P = Poly[l].PolyR[A] ;
 module M = Mul[l].MulR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Normal = MonicNormalForm[l].Over[A,setA] ;
 module Monic = MonicRegular[l].Over[A,setA] ;
 module Pow = AffinePowers[l].Over[B.ring] ;
 module Product (p q : List A.R) {
  f : P.P = H.monic-list p ;
  g : P.P = H.monic-list q ;
  raw : P.P = M.pmul f g ;
  degree : Nat = plus (len q) (len p) ;
  degree-equality : Id Nat (plus (len p) (P.plen g)) (suc degree) =
   trans (ap (plus (len p)) (Monic.monic-length q))
    (trans (plus-suc (len p) (len q)) (ap (\ k -> suc k) (plus-comm (len p) (len q)))) ;
  bound : Bounds.Bound (suc degree) raw =
   \ k -> trans (ap (P.coef raw) (ap (\ j -> plus j k) (sym degree-equality)))
    (Raw[A].product-bound (len p) f (H.above p) g k) ;
  leading : Id A.R (P.coef raw degree) A.o =
   trans (MonicRegular[l].Raw[A].At[f,len p,Monic.monic-length p].top g (len q) (Monic.monic-length q))
    (trans (ap (\ c -> A.mul c (P.lastD g)) (Monic.leading p))
     (trans (ap (A.mul A.o) (Monic.leading q)) (A.mulO A.o))) ;
  lower : List A.R = Bounds.cut degree raw ;
  equation : Id B.Carrier (H.monic lower) (B.mulQ (H.monic p) (H.monic q)) =
   trans (sym (Normal.equation degree raw bound leading)) (sym (B.Multiply.beta f g)) ;
 } ;
 Witness (p : B.Carrier) : U l = (lower : List A.R) * Id B.Carrier (H.monic lower) p ;
 powers (lower : List A.R) : (k : Nat) -> Witness (Pow.power (H.monic lower) k) = split {
  zero -> (nil,refl B.oneQ) ;
  suc k | ih -> (Product[lower,ih.1].lower,
   trans Product[lower,ih.1].equation (ap (B.mulQ (H.monic lower)) ih.2)) } ;
} ;
