-- Weak quasi-coherence of one module (7.1.5), stated at a scalar r : R
-- instead of a function Top -> R, and its equivalence with
-- Modules.WeaklyQC (torsor's WQC over the point).
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ; module Tr = Truncation[l] ;
module Over (Rg : A7.CRing) {
 module RA = A7.RA[Rg] ;
 top-ind (F : Ring[l].Top -> U l) (u : F tt) : (t : Ring[l].Top) -> F t = split { tt -> u } ;
 module At (Md : A7.Mod[Rg]) {
  D (r : Rg.R) : U l = RA.unit r ;
  -- s = m / r^N on D(r)
  Rep (r : Rg.R) (s : D r -> Md.M) : U l = (m : Md.M) * (N : Nat)
   * ((d : D r) -> Id Md.M (s d) (Md.sm (RA.pw d.1 N) m)) ;
  -- r^K m = 0
  Kill (r : Rg.R) (m : Md.M) : U l = (K : Nat) * Id Md.M (Md.sm (RA.pw r K) m) Md.mz ;
  RepClause (r : Rg.R) : U l = (s : D r -> Md.M) -> Tr.Trunc[Rep r s].carrier ;
  KillClause (r : Rg.R) : U l =
   (m : Md.M) -> (D r -> Id Md.M m Md.mz) -> Tr.Trunc[Kill r m].carrier ;
  WQC : U l = (r : Rg.R) -> RepClause r * KillClause r ;
  module Af = Affine[l].Aff[Rg,Ring[l].Top,\ t -> Md] ;
  from-aff (w : Af.WQC) : WQC = \ r ->
   (\ s -> Tr.Trunc[Af.Rep (\ t -> r) (\ t -> s)].induction @l (\ z -> Tr.Trunc[Rep r s].carrier)
     (\ z -> Tr.Trunc[Rep r s].proposition)
     (\ a -> Tr.Trunc[Rep r s].inc (a.1 tt,a.2.1,a.2.2 tt)) ((w (\ t -> r)).1 (\ t -> s)),
    \ m v -> Tr.Trunc[Af.Kill (\ t -> r) (\ t -> m)].induction @l (\ z -> Tr.Trunc[Kill r m].carrier)
     (\ z -> Tr.Trunc[Kill r m].proposition)
     (\ a -> Tr.Trunc[Kill r m].inc (a.1,a.2 tt)) ((w (\ t -> r)).2 (\ t -> m) (\ t -> v))) ;
  to-aff (w : WQC) : Af.WQC = \ g ->
   (\ s -> Tr.Trunc[Rep (g tt) (s tt)].induction @l (\ z -> Tr.Trunc[Af.Rep g s].carrier)
     (\ z -> Tr.Trunc[Af.Rep g s].proposition)
     (\ a -> Tr.Trunc[Af.Rep g s].inc (\ t -> a.1,a.2.1,
       top-ind (\ t -> (d : Af.Dg g t) -> Id Md.M (s t d) (Md.sm (RA.pw d.1 a.2.1) a.1)) a.2.2))
     ((w (g tt)).1 (s tt)),
    \ m v -> Tr.Trunc[Kill (g tt) (m tt)].induction @l (\ z -> Tr.Trunc[Af.Kill g m].carrier)
     (\ z -> Tr.Trunc[Af.Kill g m].proposition)
     (\ a -> Tr.Trunc[Af.Kill g m].inc (a.1,
       top-ind (\ t -> Id Md.M (Md.sm (RA.pw (g t) a.1) (m t)) Md.mz) a.2))
     ((w (g tt)).2 (m tt) (v tt))) ;
 } ;
} ;
