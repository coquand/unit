-- Two distinct points of P^n (n >= 2) can be moved to [e_Y] and [e_Z] by a
-- linear automorphism (coordinates: X = inr, Y = inl inr, Z = inl inl inr).
--   apart:  [x] /= [y] gives an invertible minor x_a y_b - x_b y_a (SAG);
--   swaps:  two transpositions move (a,b) to (Y,Z);
--   cramer: h(w) = w_Y x + w_Z y + (other coordinates of w), with explicit
--           inverse by Cramer's rule, sends e_Y, e_Z to x, y.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (m : Nat)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 open R ; open RL[R] ;
 n : Nat = suc (suc m) ;
 module Q2 = ProjectiveQuotient[l].Over[R,setR,n] ;
 module L = ProjectiveLinear[l].Over[R,setR,n,sqc,loc] ;
 module U23 = Units23[l].Over[R,setR,sqc,loc] ;
 module CR = Cramer[l].Over[R] ;
 module FS = FinSwap[l] ;
 I : U l = Q2.I ;
 V : U l = Q2.V ;
 iX : I = inr tt ;
 iY : I = inl (inr tt) ;
 iZ : I = inl (inl (inr tt)) ;
 inner (j : Fin m) : I = inl (inl (inl j)) ;
 top-elim (Q : Top -> U l) (h : Q tt) : (t : Top) -> Q t = split { tt -> h } ;
 cases2 (P : I -> U l) (hZ : P iZ) (hIn : (j : Fin m) -> P (inner j)) : (j : Fin (suc m)) -> P (inl (inl j)) = split {
  inl j -> hIn j ; inr t -> top-elim (\ t -> P (inl (inl (inr t)))) hZ t } ;
 cases1 (P : I -> U l) (hY : P iY) (hZ : P iZ) (hIn : (j : Fin m) -> P (inner j)) : (j : Fin (suc (suc m))) -> P (inl j) = split {
  inl j -> cases2 P hZ hIn j ; inr t -> top-elim (\ t -> P (inl (inr t))) hY t } ;
 cases (P : I -> U l) (hX : P iX) (hY : P iY) (hZ : P iZ) (hIn : (j : Fin m) -> P (inner j)) : (j : I) -> P j = split {
  inl j -> cases1 P hY hZ hIn j ; inr t -> top-elim (\ t -> P (inr t)) hX t } ;
 build2 (fZ : R.R) (fIn : Fin m -> R.R) : Fin (suc m) -> R.R = split { inr t -> fZ ; inl j -> fIn j } ;
 build1 (fY fZ : R.R) (fIn : Fin m -> R.R) : Fin (suc (suc m)) -> R.R = split { inr t -> fY ; inl j -> build2 fZ fIn j } ;
 build (fX fY fZ : R.R) (fIn : Fin m -> R.R) : V = split { inr t -> fX ; inl j -> build1 fY fZ fIn j } ;
 vec-eq (x y : V) (hX : Id R.R (x iX) (y iX)) (hY : Id R.R (x iY) (y iY)) (hZ : Id R.R (x iZ) (y iZ))
  (hIn : (j : Fin m) -> Id R.R (x (inner j)) (y (inner j))) : Id V x y =
  Q2.vector-eq x y (cases (\ j -> Id R.R (x j) (y j)) hX hY hZ hIn) ;
 eY : V = build z o z (\ j -> z) ;
 eZ : V = build z z o (\ j -> z) ;
 one-unit : unit o = (o,mulO o) ;
 pY : Q2.Point = (eY,Tr.Trunc[Q2.Pivots eY].inc (iY,one-unit)) ;
 pZ : Q2.Point = (eZ,Tr.Trunc[Q2.Pivots eZ].inc (iZ,one-unit)) ;

 -- apartness
 minor (x y : V) (a b : I) : R.R = CR.sub (mul (x a) (y b)) (mul (x b) (y a)) ;
 module Apart (x y : Q2.Point) (ne : Not (Id Q2.Pn (Q2.class x) (Q2.class y))) (p : Q2.Pivots x.1) {
  a : I = p.1 ;
  module Zero (zs : (b : I) -> Id R.R (minor x.1 y.1 a b) z) {
   eq (b : I) : Id R.R (mul (x.1 a) (y.1 b)) (mul (x.1 b) (y.1 a)) = AffineRing[l].Laws[R,setR].difference-zero _ _ (zs b) ;
   proportional : Q2.Proportional x.1 y.1 = \ i j ->
    Q2.cancel (mul (x.1 i) (y.1 j)) (mul (x.1 j) (y.1 i)) (x.1 a) p.2
     (calc R.R {
      mul (mul (x.1 i) (y.1 j)) (x.1 a)
       =< trans (mulC (mul (x.1 i) (y.1 j)) (x.1 a)) (mul-swap (x.1 a) (x.1 i) (y.1 j)) > mul (x.1 i) (mul (x.1 a) (y.1 j))
       =< ap (mul (x.1 i)) (eq j) > mul (x.1 i) (mul (x.1 j) (y.1 a))
       =< mul-swap (x.1 i) (x.1 j) (y.1 a) > mul (x.1 j) (mul (x.1 i) (y.1 a))
       =< ap (mul (x.1 j)) (sym (eq i)) > mul (x.1 j) (mul (x.1 a) (y.1 i))
       =< trans (mul-swap (x.1 j) (x.1 a) (y.1 i)) (mulC (x.1 a) (mul (x.1 j) (y.1 i))) > mul (mul (x.1 j) (y.1 i)) (x.1 a) }) ;
  } ;
  result : Tr.Trunc[(b : I) * unit (minor x.1 y.1 a b)].carrier =
   U23.nonzero-unit (suc n) (\ b -> minor x.1 y.1 a b)
    (\ zs -> ne (Q2.Q.relates x y (Q2.FromProportional[x,y,Zero[zs].proportional].related))) ;
 } ;
 distinct (x y : V) (a b : I) (u : unit (minor x y a b)) (e : Id I a b) : Empty =
  loc.1 (trans (sym u.2) (trans (ap (\ t -> mul t u.1)
    (trans (ap (\ c -> minor x y a c) (sym e)) (addN (mul (x a) (y a))))) (zero-mul u.1))) ;

 -- two transpositions moving (a,b) to (Y,Z)
 module Move (a b : I) (ne : Not (Id I a b)) {
  module SB = FS.Swap[suc n,iY,a] ;
  c : I = SB.swap b ;
  module SA = FS.Swap[suc n,iZ,c] ;
  P : L.Auto = L.compose (L.swap iZ c) (L.swap iY a) ;
  y-ne-z (e : Id I iY iZ) : Empty =
   FS.inl-inr (Fin (suc m)) Top (inr tt) tt (sym (FS.inl-inj (Fin (suc (suc m))) Top (inr tt) (inl (inr tt)) e)) ;
  y-ne-c (e : Id I iY c) : Empty = ne (sym (trans (sym (SB.involution b)) (trans (ap SB.swap (sym e)) SB.at-u))) ;
  at-y : Id I (SB.swap (SA.swap iY)) a = trans (ap SB.swap (SA.other iY y-ne-z y-ne-c)) SB.at-u ;
  at-z : Id I (SB.swap (SA.swap iZ)) b = trans (ap SB.swap SA.at-u) (SB.involution b) ;
 } ;

 -- the Cramer automorphism for x, y with invertible minor at (Y,Z)
 module Normalise (x y : V) (hd : unit (minor x y iY iZ)) {
  a : R.R = x iY ; b : R.R = y iY ; c : R.R = x iZ ; d : R.R = y iZ ;
  e : R.R = hd.1 ;
  -- (P e) = s when P = D s
  solve (p s : R.R) (h : Id R.R p (mul (minor x y iY iZ) s)) : Id R.R (mul p e) s =
   trans (ap (\ t -> mul t e) h) (trans (sym (mulA (minor x y iY iZ) s e))
    (trans (ap (mul (minor x y iY iZ)) (mulC s e)) (trans (mulA (minor x y iY iZ) e s) (trans (ap (\ t -> mul t s) hd.2) (trans (mulC o s) (mulO s)))))) ;
  -- a (P e) + b (Q e) = (a P + b Q) e
  combine (a' b' p q : R.R) : Id R.R (add (mul a' (mul p e)) (mul b' (mul q e))) (mul (add (mul a' p) (mul b' q)) e) =
   trans (CR.cong-add (mulA a' p e) (mulA b' q e))
    (trans (CR.cong-add (mulC (mul a' p) e) (mulC (mul b' q) e))
     (trans (sym (dist e (mul a' p) (mul b' q))) (mulC e (add (mul a' p) (mul b' q))))) ;
  gy (v : V) : R.R = mul (CR.sub (mul d (v iY)) (mul b (v iZ))) e ;
  gz (v : V) : R.R = mul (CR.sub (mul a (v iZ)) (mul c (v iY))) e ;
  rest (v : V) (j : I) : R.R = CR.sub (v j) (add (mul (x j) (gy v)) (mul (y j) (gz v))) ;
  other (w : V) (j : I) : R.R = add (w j) (add (mul (x j) (w iY)) (mul (y j) (w iZ))) ;
  gmap (v : V) : V = build (rest v iX) (gy v) (gz v) (\ j -> rest v (inner j)) ;
  hmap (w : V) : V =
   build (other w iX) (add (mul a (w iY)) (mul b (w iZ))) (add (mul c (w iY)) (mul d (w iZ))) (\ j -> other w (inner j)) ;
  plus-minus (p s : R.R) : Id R.R (add (CR.sub p s) s) p =
   trans (sym (addA p (neg s) s)) (trans (ap (add p) (CR.cancel-left s)) (addZ p)) ;
  hg-y (v : V) : Id R.R (hmap (gmap v) iY) (v iY) =
   trans (combine a b _ _) (solve _ (v iY) (CR.cramer-y a b c d (v iY) (v iZ))) ;
  hg-z (v : V) : Id R.R (hmap (gmap v) iZ) (v iZ) =
   trans (combine c d _ _) (solve _ (v iZ) (CR.cramer-z a b c d (v iY) (v iZ))) ;
  hg (v : V) : Id V (hmap (gmap v)) v =
   vec-eq (hmap (gmap v)) v (plus-minus (v iX) (add (mul (x iX) (gy v)) (mul (y iX) (gz v)))) (hg-y v) (hg-z v) (\ j -> plus-minus (v (inner j)) (add (mul (x (inner j)) (gy v)) (mul (y (inner j)) (gz v)))) ;
  gh-y (w : V) : Id R.R (gy (hmap w)) (w iY) = solve _ (w iY) (CR.inverse-y a b c d (w iY) (w iZ)) ;
  gh-z (w : V) : Id R.R (gz (hmap w)) (w iZ) = solve _ (w iZ) (CR.inverse-z a b c d (w iY) (w iZ)) ;
  minus-plus (p s : R.R) : Id R.R (CR.sub (add p s) s) p = add-neg-cancel p s ;
  gh-rest (w : V) (j : I) (hj : Id R.R (hmap w j) (other w j)) : Id R.R (rest (hmap w) j) (w j) =
   trans (ap (\ t -> CR.sub t (add (mul (x j) (gy (hmap w))) (mul (y j) (gz (hmap w))))) hj)
    (trans (ap (\ t -> CR.sub (other w j) t)
      (CR.cong-add (ap (mul (x j)) (gh-y w)) (ap (mul (y j)) (gh-z w))))
     (minus-plus (w j) _)) ;
  gh (w : V) : Id V (gmap (hmap w)) w =
   vec-eq (gmap (hmap w)) w (gh-rest w iX (refl (other w iX))) (gh-y w) (gh-z w) (\ j -> gh-rest w (inner j) (refl (other w (inner j)))) ;
  -- linearity
  lin2 (p q u s t : R.R) : Id R.R (add (mul p (mul u s)) (mul q (mul u t))) (mul u (add (mul p s) (mul q t))) =
   trans (CR.cong-add (mul-swap p u s) (mul-swap q u t)) (sym (dist u (mul p s) (mul q t))) ;
  sub2 (p q u s t : R.R) : Id R.R (CR.sub (mul p (mul u s)) (mul q (mul u t))) (mul u (CR.sub (mul p s) (mul q t))) =
   trans (CR.cong-add (mul-swap p u s) (ap neg (mul-swap q u t))) (sym (CR.expand u (mul p s) (mul q t))) ;
  scale-e (u p : R.R) : Id R.R (mul (mul u p) e) (mul u (mul p e)) = sym (mulA u p e) ;
  gy-lin (u : R.R) (v : V) : Id R.R (gy (Q2.scale u v)) (mul u (gy v)) =
   trans (ap (\ t -> mul t e) (sub2 d b u (v iY) (v iZ))) (scale-e u _) ;
  gz-lin (u : R.R) (v : V) : Id R.R (gz (Q2.scale u v)) (mul u (gz v)) =
   trans (ap (\ t -> mul t e) (sub2 a c u (v iZ) (v iY))) (scale-e u _) ;
  rest-lin (u : R.R) (v : V) (j : I) : Id R.R (rest (Q2.scale u v) j) (mul u (rest v j)) =
   trans (ap (CR.sub (mul u (v j)))
     (trans (CR.cong-add (ap (mul (x j)) (gy-lin u v)) (ap (mul (y j)) (gz-lin u v))) (lin2 (x j) (y j) u (gy v) (gz v))))
    (sym (CR.expand u (v j) (add (mul (x j) (gy v)) (mul (y j) (gz v))))) ;
  other-lin (u : R.R) (w : V) (j : I) : Id R.R (other (Q2.scale u w) j) (mul u (other w j)) =
   trans (ap (add (mul u (w j))) (lin2 (x j) (y j) u (w iY) (w iZ))) (sym (dist u (w j) (add (mul (x j) (w iY)) (mul (y j) (w iZ))))) ;
  g-lin : L.Linear gmap = \ u v ->
   vec-eq (gmap (Q2.scale u v)) (Q2.scale u (gmap v)) (rest-lin u v iX) (gy-lin u v) (gz-lin u v) (\ j -> rest-lin u v (inner j)) ;
  h-lin : L.Linear hmap = \ u w ->
   vec-eq (hmap (Q2.scale u w)) (Q2.scale u (hmap w)) (other-lin u w iX) (lin2 a b u (w iY) (w iZ)) (lin2 c d u (w iY) (w iZ))
    (\ j -> other-lin u w (inner j)) ;
  auto : L.Auto = (gmap,hmap,g-lin,h-lin,hg,gh) ;
  -- h(e_Y) = x and h(e_Z) = y
  unit-y (p q : R.R) : Id R.R (add (mul p o) (mul q z)) p = trans (CR.cong-add (mulO p) (mul-zero q)) (addZ p) ;
  unit-z (p q : R.R) : Id R.R (add (mul p z) (mul q o)) q = trans (CR.cong-add (mul-zero p) (mulO q)) (zl q) ;
  h-y : Id V (hmap eY) x =
   vec-eq (hmap eY) x (trans (zl _) (unit-y (x iX) (y iX))) (unit-y a b) (unit-y c d) (\ j -> trans (zl _) (unit-y (x (inner j)) (y (inner j)))) ;
  h-z : Id V (hmap eZ) y =
   vec-eq (hmap eZ) y (trans (zl _) (unit-z (x iX) (y iX))) (unit-z a b) (unit-z c d) (\ j -> trans (zl _) (unit-z (x (inner j)) (y (inner j)))) ;
  g-x : Id V (gmap x) eY = trans (ap gmap (sym h-y)) (gh eY) ;
  g-y : Id V (gmap y) eZ = trans (ap gmap (sym h-z)) (gh eZ) ;
 } ;
} ;
