-- The missing inverse law for the rectangular enumeration.
level l ; open Ring[l] ; open Presentations[l] ;
module FP = FiniteProduct[l] ; module FS = FinSum[l] ;
module Step (n m : Nat) (ih : (a : Fin (FP.size n m)) ->
 Id (Fin (FP.size n m)) (FP.encode n m (FP.decode n m a).1 (FP.decode n m a).2) a) {
 old : Nat = FP.size n m ; total : Nat = FP.size (suc n) m ;
 f (a : Fin total) : Fin total = FP.encode (suc n) m (FP.decode (suc n) m a).1 (FP.decode (suc n) m a).2 ;
 left (a : Fin old) : Id (Fin total) (f (FS.left old m a)) (FS.left old m a) =
  trans (ap (\ p -> FP.encode (suc n) m p.1 p.2)
    (FS.cases-left old (FP.Pair (suc n) m)
     (\ z -> (inl (FP.decode n m z).1,(FP.decode n m z).2)) m (\ j -> (inr tt,j)) a))
   (ap (FS.left old m) (ih a)) ;
 right (a : Fin m) : Id (Fin total) (f (FS.right old m a)) (FS.right old m a) =
  ap (\ p -> FP.encode (suc n) m p.1 p.2)
   (FS.cases-right old (FP.Pair (suc n) m)
    (\ z -> (inl (FP.decode n m z).1,(FP.decode n m z).2)) m (\ j -> (inr tt,j)) a) ;
 theorem (a : Fin total) : Id (Fin total) (f a) a =
  trans (sym (FS.cases-unique old (Fin total) (FS.left old m) m (FS.right old m)
    f (\ z -> sym (left z)) (\ z -> sym (right z)) a))
   (FS.cases-unique old (Fin total) (FS.left old m) m (FS.right old m)
    (\ z -> z) (\ z -> refl (FS.left old m z)) (\ z -> refl (FS.right old m z)) a) ;
} ;
encode-decode : (n m : Nat) (a : Fin (FP.size n m)) ->
 Id (Fin (FP.size n m)) (FP.encode n m (FP.decode n m a).1 (FP.decode n m a).2) a = split {
 zero -> \ m a -> efq a ;
 suc n | ih -> \ m -> Step[n,m,ih m].theorem } ;
opaque encode-decode ;
