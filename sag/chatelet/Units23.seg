-- SAG 2.2.3(b),(c), from Loc and uniform SQC.
-- (b) a vector is nonzero iff one of its entries is invertible: R/(x_i) has
-- no points, so it collapses, so 1 = sum x_i c_i, and Loc finds a unit summand.
-- (c) x is nilpotent iff not not x = 0: R[1/x] has no points iff x is nilpotent.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module Q = FiniteQuotient[l].Over[R,setR] ;
 module W = WeakNullstellensatz[l].Over[R,setR,sqc] ;
 module L = StandardOpens[l].Over[R,setR].Local[loc] ;
 module CP = ClosedProp[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module Uts = AffineUnits[l].Over[R,setR,sqc,loc.1] ;
 module N = LocalizationNilpotence[l].Over[R,setR].SAG[sqc,loc.1] ;
 module Pow = AffinePowers[l].Over[R] ;
 unit-factor (a b : R.R) (u : RL[R].unit (R.mul a b)) : RL[R].unit a =
  (R.mul b u.1,trans (R.mulA a b u.1) u.2) ;
 module At (n : Nat) (xs : Fin n -> R.R) (nz : CP.Zeros n xs -> Empty) (q : Q.Witness C.base n xs) {
  inc : C.Hom C.base q.1 = q.2.2.1 ;
  empty (x : C.Spec q.1) : Empty = nz (\ i ->
   trans (sym ((C.compose C.base q.1 C.base x inc).2 (xs i)))
    (trans (ap x.1.1 (q.2.2.2.1 i)) (RingHom[l].zero q.1.ring R x.1))) ;
  collapsed : Id q.1.ring.R q.1.ring.o q.1.ring.z = W.empty-collapse q.1 q.2.1 empty ;
  from-certificate (w : FiniteIdeal[l].Over[R,n,xs].Certificate R.o R.z) : OP.Units n xs =
   Tr.Trunc[(i : Fin n) * RL[R].unit (R.mul (xs i) (w.1 i))].induction @l
    (\ t -> OP.Units n xs) (\ t -> Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].proposition)
    (\ v -> Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].inc (v.1,unit-factor (xs v.1) (w.1 v.1) v.2))
    (L.finite-unit n (\ i -> R.mul (xs i) (w.1 i))
     (R.o,trans (R.mulO (RS.lin n xs w.1)) (trans (sym (RL[R].zl (RS.lin n xs w.1))) (sym w.2)))) ;
  result : OP.Units n xs =
   Tr.Trunc[FiniteIdeal[l].Over[R,n,xs].Certificate R.o R.z].induction @l
    (\ t -> OP.Units n xs) (\ t -> Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].proposition)
    from-certificate
    (QuotientCertificate[l].Over[R,setR].At[C.base,n,xs,q].kernel R.o (trans inc.1.2.1 collapsed)) ;
 } ;
 -- 2.2.3(b)
 nonzero-unit (n : Nat) (xs : Fin n -> R.R) (nz : CP.Zeros n xs -> Empty) : OP.Units n xs =
  Tr1.Trunc[Q.Witness C.base n xs].induction @l (\ t -> OP.Units n xs)
   (\ t -> Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].proposition) (\ q -> At[n,xs,nz,q].result)
   (Q.quotient C.base BasePresentation[l].Over[R,setR].finitely-presented n xs) ;
 unit-nonzero (n : Nat) (xs : Fin n -> R.R) (u : OP.Units n xs) (z : CP.Zeros n xs) : Empty =
  Tr.Trunc[(i : Fin n) * RL[R].unit (xs i)].induction @l (\ t -> Empty) (\ t -> \ a b -> efq a)
   (\ w -> L.zero-unit (xs w.1) (z w.1) w.2) u ;
 nonzero-iff-some-unit (n : Nat) (xs : Fin n -> R.R) :
  OpenProp[l].Iff (CP.Zeros n xs -> Empty) (OP.Units n xs) =
  (nonzero-unit n xs,unit-nonzero n xs) ;
 -- 2.2.3(c)
 point : C.Spec C.base = C.identity C.base ;
 nilpotent-nn (x : R.R) (nil : Pow.Nilpotent x) (nz : Id R.R x R.z -> Empty) : Empty =
  N.nilpotent-to-empty C.base x nil (point,Uts.nonzero-unit x nz) ;
 nn-nilpotent (x : R.R) (nn : (Id R.R x R.z -> Empty) -> Empty) : Pow.Nilpotent x =
  N.empty-to-nilpotent C.base BasePresentation[l].Over[R,setR].finitely-presented x
   (\ d -> nn (\ h -> L.zero-unit (d.1.1.1 x) (trans (d.1.2 x) h) d.2)) ;
 nilpotent-iff (x : R.R) :
  OpenProp[l].Iff (Pow.Nilpotent x) ((Id R.R x R.z -> Empty) -> Empty) =
  (nilpotent-nn x,nn-nilpotent x) ;
} ;
