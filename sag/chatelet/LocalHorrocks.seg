-- Assemble Lemmas 7.5 and 7.6 for the actual scalar certificate.
-- The remaining input is a monic generator of the row ideal modulo J.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (m : Nat) (fs : Fin m -> A.R) {
 module Tr = Truncation[l] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module P = Poly[l].PolyR[A] ;
 module Mat = RankOneProjector[l].Over[B.ring] ;
 module S = FiniteIdeal[l].Sums[B.ring] ;
 module Pow = AffinePowers[l].Over[B.ring] ;
 module MP = MonicPowers[l].Over[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Normal = MonicNormalForm[l].Over[A,setA] ;
 module Rad = FiniteRadicalLifting[l].Over[A,setA,m,fs] ;
 module At (radical : (a : A.R) -> Rad.J.1 a -> RL[A].unit (A.add A.o (A.neg a)))
  (lower : List A.R) (power : Nat) (n : Nat) (e : Mat.Size[n].Matrix)
  (w : Mat.Size[n].ScalarFactor e (Pow.power (H.monic lower) power)) {
  module Change = Rad.At[radical].BaseChange ;
  module Red = DivisionReduction[l].Over[A,Rad.C,setA,Rad.phi] ;
  y : Mat.Size[n].Vector = w.2.1 ;
  module Row = GeneratedIdeal[l].Over[B.ring,n,y] ;
  I : Ideals[l].Over[B.ring,B.set].Ideal =
   Ideals[l].Over[B.ring,B.set].Gen[n,y].ideal ;
  monic-power : MP.Witness (Pow.power (H.monic lower) power) = MP.powers lower power ;
  power-member : I.1 (H.monic monic-power.1) =
   Row.equal _ _ (trans w.2.2.2 (sym monic-power.2))
    (Row.linear-combination n y w.1 Row.generator) ;
  module ReducedGenerator (r : Nat) (g : P.P)
   (leading : Id Rad.C.R (Rad.phi.1 (P.coef g r)) Rad.C.o)
   (bound : Red.Bound (suc r) g) (member : I.1 (B.include g))
   (a : Mat.Size[n].Vector)
   (generates : (i : Fin n) -> Id Change.D.Carrier
    (Change.hom.1 (y i)) (Change.hom.1 (B.mulQ (B.include g) (a i)))) {
   module Lift = Rad.At[radical].Lifting.At[I,r,g,leading,bound,member] ;
   lifted : Lift.Result =
    Lift.lift (H.monic-list monic-power.1) (len monic-power.1)
     (H.leading monic-power.1) (H.above monic-power.1) power-member ;
   h-lower : List A.R = Bounds.cut r lifted.1 ;
   h : B.Carrier = H.monic h-lower ;
   normalized : Id B.Carrier (B.include lifted.1) h =
    Normal.equation r lifted.1 lifted.2.1 lifted.2.2.1 ;
   same-reduction : Id Change.D.Carrier (Change.hom.1 h) (Change.hom.1 (B.include g)) =
    trans (ap Change.hom.1 (sym normalized))
     (Change.raw-equal lifted.1 g lifted.2.2.2.1) ;
   h-member : I.1 h = Row.equal _ _ normalized lifted.2.2.2.2 ;
   h-generates (i : Fin n) : Id Change.D.Carrier
    (Change.hom.1 (y i)) (Change.hom.1 (B.mulQ h (a i))) =
    trans (generates i)
     (trans (Change.hom.2.2.2 (B.include g) (a i))
      (trans (ap (\ c -> Change.D.mulQ c (Change.hom.1 (a i))) (sym same-reduction))
       (sym (Change.hom.2.2.2 h (a i))))) ;
   module Certificate (c : Row.Witness h) {
    hc : Mat.Size[n].Vector = c.1 ;
    equation : Id B.Carrier (S.lin n y hc) h =
     sym (trans c.2 (RL[B.ring].zl (S.lin n y hc))) ;
    module Local = LocalMonicGenerator[l].Over[A,setA,m,fs].At[
     radical,lower,power,n,e,w,h-lower,hc,a,equation].Reduction[h-generates] ;
    free : Mat.Size[n].Free e = Local.free ;
   } ;
   free : Mat.Size[n].Free e =
    Tr.Trunc[Row.Witness h].induction @l
     (\ c -> Mat.Size[n].Free e) (\ c -> Tr.Trunc[Mat.Size[n].Factors e].proposition)
     (\ c -> Certificate[c].free) h-member ;
  } ;
 } ;
} ;
