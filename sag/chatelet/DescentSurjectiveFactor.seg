-- A linear map which kills the kernel of a surjection factors through it.
-- Unique choice constructs the factor; no choice of preimages is made.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module MD = Modules[l].Over[R,setR] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module At (P M N : MD.Module) (q : SM.Linear P M)
  (onto : (x : M.M) -> Tr.Trunc[(v : P.M) * Id M.M (q.1 v) x].carrier)
  (b : SM.Linear P N)
  (kill : (v : P.M) -> Id M.M (q.1 v) M.mz -> Id N.M (b.1 v) N.mz) {
  module Lq = SM.Lin[P,M,q] ; module Lb = SM.Lin[P,N,b] ;
  module MP = Alg73[l].MA[MD.ring,P] ; module MM = Alg73[l].MA[MD.ring,M] ;
  module MN = Alg73[l].MA[MD.ring,N] ;
  compatible (v w : P.M) (h : Id M.M (q.1 v) (q.1 w)) : Id N.M (b.1 v) (b.1 w) =
   MN.sub-zero (b.1 v) (b.1 w)
    (trans (sym (Lb.map-sub v w))
     (kill (MP.sub v w) (trans (Lq.map-sub v w)
      (trans (ap (\ x -> MM.sub x (q.1 w)) h) (MM.sub-self (q.1 w)))))) ;
  Fibre (x : M.M) : U l = (v : P.M) * Id M.M (q.1 v) x ;
  module Point (x : M.M) {
   module D = SectionDescent[l].At[Fibre x,N.M,N.setM,\ w -> b.1 w.1,
    \ v w -> compatible v.1 w.1 (trans v.2 (sym w.2))].Inhabited[onto x] ;
  } ;
  factor (x : M.M) : N.M = Point[x].D.result.1 ;
  point (x : M.M) (w : Fibre x) : Id N.M (factor x) (b.1 w.1) = Point[x].D.result.2 w ;
  beta (v : P.M) : Id N.M (factor (q.1 v)) (b.1 v) = point (q.1 v) (v,refl (q.1 v)) ;
  module Add (x y : M.M) (v : Fibre x) (w : Fibre y) {
   equation : Id M.M (q.1 (P.madd v.1 w.1)) (M.madd x y) =
    trans (q.2.1 v.1 w.1) (cong2 M.M M.madd _ _ _ _ v.2 w.2) ;
   result : Id N.M (factor (M.madd x y)) (N.madd (factor x) (factor y)) =
    trans (ap factor (sym equation))
     (trans (beta (P.madd v.1 w.1))
      (trans (b.2.1 v.1 w.1)
       (cong2 N.M N.madd _ _ _ _ (sym (point x v)) (sym (point y w))))) ;
  } ;
  add (x y : M.M) : Id N.M (factor (M.madd x y)) (N.madd (factor x) (factor y)) =
   TC.rec (Fibre x) @l (Id N.M (factor (M.madd x y)) (N.madd (factor x) (factor y))) (N.setM _ _)
    (\ v -> TC.rec (Fibre y) @l (Id N.M (factor (M.madd x y)) (N.madd (factor x) (factor y))) (N.setM _ _)
     (\ w -> Add[x,y,v,w].result) (onto y)) (onto x) ;
  module Scale (a : R.R) (x : M.M) (v : Fibre x) {
   equation : Id M.M (q.1 (P.sm a v.1)) (M.sm a x) = trans (q.2.2 a v.1) (ap (M.sm a) v.2) ;
   result : Id N.M (factor (M.sm a x)) (N.sm a (factor x)) =
    trans (ap factor (sym equation))
     (trans (beta (P.sm a v.1)) (trans (b.2.2 a v.1) (ap (N.sm a) (sym (point x v))))) ;
  } ;
  scale (a : R.R) (x : M.M) : Id N.M (factor (M.sm a x)) (N.sm a (factor x)) =
   TC.rec (Fibre x) @l (Id N.M (factor (M.sm a x)) (N.sm a (factor x))) (N.setM _ _)
    (\ v -> Scale[a,x,v].result) (onto x) ;
  linear : SM.Linear M N = (factor,add,scale) ;
  opaque factor ;
 } ;
} ;
