-- Rank-one Horrocks over a local ring by the divisor argument.
-- Induction on the degree of a monic member F of the row ideal L:
-- either F generates L, or L has a monic member of smaller degree.
-- No formal gcd tree, no gluing of local generators, no determinant.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (loc : (a b : A.R) -> RL[A].unit (A.add a b) ->
  Tr.Trunc[Plus (RL[A].unit a) (RL[A].unit b)].carrier) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module S = FiniteIdeal[l].Sums[B.ring] ;
 module BR = RL[B.ring] ;
 module Div = DivisorStep[l].Over[A,setA,loc] ;
 module IB = Ideals[l].Over[B.ring,B.set] ;
 module MG = MonicGenerator[l].Over[A,setA] ;
 module MR = MonicRegular[l].Over[A,setA] ;
 module Data (n : Nat) (y : Fin n -> B.Carrier) (e : Fin n -> Fin n -> B.Carrier)
  (exchange : (i j k : Fin n) -> Id B.Carrier (B.mulQ (e i k) (y j)) (B.mulQ (e i j) (y k)))
  (trace : Id B.Carrier (S.sum n (\ i -> e i i)) B.oneQ) {
  module St = Div.Data[n,y,e,exchange,trace] ;
  Goal : U l = Tr.Trunc[St.MonicPrincipal].carrier ;
  -- A monic generator of L; the type of such is a proposition.
  IsMonic (g : B.Carrier) : U l = Tr.Trunc[(lower : List A.R) * Id B.Carrier (H.monic lower) g].carrier ;
  Divides (g x : B.Carrier) : U l = (q : B.Carrier) * Id B.Carrier x (B.mulQ g q) ;
  Tail (g : B.Carrier) : U l = IsMonic g * St.InL g * ((i : Fin n) -> Divides g (y i)) ;
  Generator : U l = (g : B.Carrier) * Tail g ;
  -- A monic polynomial is regular, so its quotients are unique.
  Witness (g : B.Carrier) : U l = (lower : List A.R) * Id B.Carrier (H.monic lower) g ;
  regular (g : B.Carrier) (w : Witness g) : MR.Reg.Regular g =
   Pr.subst B.Carrier MR.Reg.Regular (H.monic w.1) g w.2 MR.At[w.1].regular ;
  divides-prop (g x : B.Carrier) (m : IsMonic g) : Pr.isProp (Divides g x) =
   Tr.Trunc[Witness g].induction @l (\ t -> Pr.isProp (Divides g x)) (\ t -> FE.isProp-isProp (Divides g x))
    (\ w u v -> Pr.Sigma-eq B.Carrier (\ q -> Id B.Carrier x (B.mulQ g q)) u.1 v.1 u.2 v.2
      (regular g w u.1 v.1 (trans (sym u.2) v.2)) (B.set x (B.mulQ g v.1))) m ;
  tail-prop (g : B.Carrier) : Pr.isProp (Tail g) =
   Pr.isProp-Sigma (IsMonic g) (\ m -> St.InL g * ((i : Fin n) -> Divides g (y i)))
    Tr.Trunc[Witness g].proposition
    (\ m -> Pr.isProp-Sigma (St.InL g) (\ h -> (i : Fin n) -> Divides g (y i)) (St.Lid.2.1 g)
      (\ h -> FE.isProp-Pi (Fin n) (\ i -> Divides g (y i)) (\ i -> divides-prop g (y i) m))) ;
  -- The multiples of g form an ideal; it contains L when it contains the y_i.
  Mult (g x : B.Carrier) : U l = Tr.Trunc[Divides g x].carrier ;
  mult-add (g a b : B.Carrier) (ha : Mult g a) (hb : Mult g b) : Mult g (B.addQ a b) =
   Tr.Trunc[Divides g a].induction @l (\ t -> Mult g (B.addQ a b)) (\ t -> Tr.Trunc[Divides g (B.addQ a b)].proposition)
    (\ u -> Tr.Trunc[Divides g b].induction @l (\ t -> Mult g (B.addQ a b))
      (\ t -> Tr.Trunc[Divides g (B.addQ a b)].proposition)
      (\ v -> Tr.Trunc[Divides g (B.addQ a b)].inc (B.addQ u.1 v.1,
        trans (cong2 B.Carrier B.addQ _ _ _ _ u.2 v.2) (sym (B.ring.dist g u.1 v.1)))) hb) ha ;
  mult-scale (g a b : B.Carrier) (hb : Mult g b) : Mult g (B.mulQ a b) =
   Tr.Trunc[Divides g b].induction @l (\ t -> Mult g (B.mulQ a b)) (\ t -> Tr.Trunc[Divides g (B.mulQ a b)].proposition)
    (\ v -> Tr.Trunc[Divides g (B.mulQ a b)].inc (B.mulQ a v.1,
      trans (ap (B.mulQ a) v.2) (BR.mul-swap a g v.1))) hb ;
  mult-ideal (g : B.Carrier) : IB.Ideal =
   (Mult g,\ x -> Tr.Trunc[Divides g x].proposition,
    Tr.Trunc[Divides g B.zeroQ].inc (B.zeroQ,sym (BR.mul-zero g)),mult-add g,mult-scale g) ;
  in-mult (g : B.Carrier) (d : (i : Fin n) -> Divides g (y i)) (x : B.Carrier) (h : St.InL x) : Mult g x =
   IB.In[mult-ideal g].generated-in n y (\ i -> Tr.Trunc[Divides g (y i)].inc (d i)) x h ;
  -- Two monic generators divide each other, so they are equal.
  module Pair (u v : Generator) {
   core (wu : Witness u.1) (wv : Witness v.1) (dv : Divides u.1 v.1) (du : Divides v.1 u.1) : Id B.Carrier u.1 v.1 =
    trans (sym wu.2)
     (trans (MG.unique wu.1 wv.1 dv.1 du.1
       (trans wv.2 (trans dv.2 (ap (\ g -> B.mulQ g dv.1) (sym wu.2))))
       (trans wu.2 (trans du.2 (ap (\ g -> B.mulQ g du.1) (sym wv.2)))))
      wv.2) ;
   Goal2 : U l = Id B.Carrier u.1 v.1 ;
   prop2 : Pr.isProp Goal2 = B.set u.1 v.1 ;
   equal : Goal2 =
    Tr.Trunc[Witness u.1].induction @l (\ t -> Goal2) (\ t -> prop2) (\ wu ->
     Tr.Trunc[Witness v.1].induction @l (\ t -> Goal2) (\ t -> prop2) (\ wv ->
      Tr.Trunc[Divides u.1 v.1].induction @l (\ t -> Goal2) (\ t -> prop2) (\ dv ->
       Tr.Trunc[Divides v.1 u.1].induction @l (\ t -> Goal2) (\ t -> prop2) (\ du -> core wu wv dv du)
        (in-mult v.1 v.2.2.2 u.1 u.2.2.1))
       (in-mult u.1 u.2.2.2 v.1 v.2.2.1))
      v.2.1)
     u.2.1 ;
  } ;
  generator-prop : Pr.isProp Generator =
   \ u v -> Pr.Sigma-eq B.Carrier Tail u.1 v.1 u.2 v.2 Pair[u,v].equal (tail-prop v.1) ;
  of-principal (p : St.MonicPrincipal) : Generator =
   (p.2.1.1,Tr.Trunc[Witness p.2.1.1].inc (p.1,sym p.2.2),
    St.member p.2.1.2.2.1 p.2.1.1 p.2.1.2.2.2.2,\ i -> (p.2.1.2.1 i,p.2.1.2.2.2.1 i)) ;
  Statement (k : Nat) : U l =
   (lower : List A.R) -> Id Nat (len lower) k -> (cs : Fin n -> B.Carrier) ->
   Id B.Carrier (S.lin n y cs) (H.monic lower) -> Goal ;
  next (k : Nat) (ih : Statement k) (m : Nat) (em : Id Nat m k) :
   Plus St.MonicPrincipal (St.Lower m) -> Goal = split {
   inl p -> Tr.Trunc[St.MonicPrincipal].inc p ;
   inr low -> ih low.1 (trans low.2.1 em) low.2.2.1 low.2.2.2 } ;
  principal : (k : Nat) -> Statement k = split {
   zero -> split {
    nil -> \ el cs g -> Tr.Trunc[St.MonicPrincipal].inc St.Bottom[cs,g].principal ;
    cons a rest -> \ el cs g -> efq (suc-zero (len rest) el) } ;
   suc k | ih -> split {
    nil -> \ el cs g -> efq (zero-suc k el) ;
    cons a rest -> \ el cs g ->
     Tr.Trunc[St.Positive[a,rest,cs,g].Outcome].induction @l (\ t -> Goal)
      (\ t -> Tr.Trunc[St.MonicPrincipal].proposition)
      (next k ih (len rest) (suc-inj el)) St.Positive[a,rest,cs,g].outcome } } ;
  -- If L contains a monic polynomial, L has a unique monic generator.
  module Monic (lower : List A.R) (cs : Fin n -> B.Carrier)
   (generated : Id B.Carrier (S.lin n y cs) (H.monic lower)) {
   generator : Generator =
    Tr.Trunc[St.MonicPrincipal].induction @l (\ t -> Generator) (\ t -> generator-prop) of-principal
     (principal (len lower) lower (refl (len lower)) cs generated) ;
  } ;
 } ;
 -- The interface: a rank-one projector free after inverting a monic is free.
 module Mat = RankOneProjector[l].Over[B.ring] ;
 module Pow = AffinePowers[l].Over[B.ring] ;
 module Monic = MonicRegular[l].Over[A,setA] ;
 module Powers = MonicPowers[l].Over[A,setA] ;
 module Certificate (lower : List A.R) (n : Nat) (proj : Mat.Size[n].Projector)
  (w : Mat.Size[n].LocalFactors proj.entry (H.monic lower)) {
  e : Fin n -> Fin n -> B.Carrier = proj.entry ;
  t : B.Carrier = Pow.power (H.monic lower) w.1 ;
  x : Fin n -> B.Carrier = w.2.1 ;
  y : Fin n -> B.Carrier = w.2.2.1 ;
  xy (i j : Fin n) : Id B.Carrier (B.mulQ (x i) (y j)) (B.mulQ t (e i j)) = w.2.2.2.1 i j ;
  regular : Monic.Reg.Regular t = Monic.At[lower].power-regular w.1 ;
  exchange (i j k : Fin n) : Id B.Carrier (B.mulQ (e i k) (y j)) (B.mulQ (e i j) (y k)) =
   regular (B.mulQ (e i k) (y j)) (B.mulQ (e i j) (y k)) (calc B.Carrier {
    B.mulQ t (B.mulQ (e i k) (y j))
     =< B.ring.mulA t (e i k) (y j) > B.mulQ (B.mulQ t (e i k)) (y j)
     =< ap (\ v -> B.mulQ v (y j)) (sym (xy i k)) > B.mulQ (B.mulQ (x i) (y k)) (y j)
     =< sym (B.ring.mulA (x i) (y k) (y j)) > B.mulQ (x i) (B.mulQ (y k) (y j))
     =< ap (B.mulQ (x i)) (B.ring.mulC (y k) (y j)) > B.mulQ (x i) (B.mulQ (y j) (y k))
     =< B.ring.mulA (x i) (y j) (y k) > B.mulQ (B.mulQ (x i) (y j)) (y k)
     =< ap (\ v -> B.mulQ v (y k)) (xy i j) > B.mulQ (B.mulQ t (e i j)) (y k)
     =< sym (B.ring.mulA t (e i j) (y k)) > B.mulQ t (B.mulQ (e i j) (y k)) }) ;
  trace : Id B.Carrier (S.sum n (\ i -> e i i)) B.oneQ =
   regular (S.sum n (\ i -> e i i)) B.oneQ
    (trans (sym (S.sum-scale t n (\ i -> e i i)))
     (trans (S.sum-cong n (\ i -> B.mulQ t (e i i)) (\ i -> B.mulQ (y i) (x i))
       (\ i -> trans (sym (xy i i)) (B.ring.mulC (x i) (y i))))
      (trans w.2.2.2.2 (sym (B.ring.mulO t))))) ;
  power : Powers.Witness t = Powers.powers lower w.1 ;
  generated : Id B.Carrier (S.lin n y x) (H.monic power.1) = trans w.2.2.2.2 (sym power.2) ;
  module D = Data[n,y,e,exchange,trace] ;
  module Descent = CertificateDescent[l].Over[B.ring].At[n,e,t,regular,w.2] ;
  free : Mat.Size[n].Free e =
   Tr.Trunc[D.St.MonicPrincipal].induction @l (\ u -> Mat.Size[n].Free e)
    (\ u -> Tr.Trunc[Mat.Size[n].Factors e].proposition)
    (\ p -> Tr.Trunc[Mat.Size[n].Factors e].inc (Descent.descend p.2.1))
    (D.principal (len power.1) power.1 (refl (len power.1)) x generated) ;
 } ;
 horrocks : H.Horrocks = \ lower n proj after ->
  Tr.Trunc[Mat.Size[n].LocalFactors proj.entry (H.monic lower)].induction @l
   (\ u -> Mat.Size[n].Free proj.entry)
   (\ u -> Tr.Trunc[Mat.Size[n].Factors proj.entry].proposition)
   (\ w -> Certificate[lower,n,proj,w].free) after ;
} ;
