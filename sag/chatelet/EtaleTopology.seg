-- Nonconstant monic polynomials, as in sevb Remark 1.1.2.
-- Double-negated inhabitation of Root is deferred until EtaleBasis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module H = HorrocksInterface[l].Over[R,setR] ;
 module Raw = Poly[l].PolyR[R] ;
 module PP = PolynomialPresentation[l].Over[R,setR] ;
 coefficients : (n : Nat) -> (Fin n -> R.R) -> List R.R = split {
  zero -> \ a -> nil ;
  suc n | ih -> \ a -> cons (a (inr tt)) (ih (\ t -> a (inl t))) } ;
 coefficients-length : (n : Nat) (a : Fin n -> R.R) ->
  Id Nat (len (coefficients n a)) n = split {
  zero -> \ a -> refl zero ;
  suc n | ih -> \ a -> ap (\ t -> suc t) (ih (\ t -> a (inl t))) } ;
 I : U l = (d : Nat) * (Fin (suc d) -> R.R) ;
 lower (i : I) : List R.R = coefficients (suc i.1) i.2 ;
 polynomial (i : I) : Raw.P = H.monic-list (lower i) ;
 Root (i : I) : U l = PP.For[polynomial i].Root ;
 G (i : I) : U l = Truncation[l].Trunc[Root i].carrier ;
 root-inc (i : I) : Root i -> G i = Truncation[l].Trunc[Root i].inc ;
 G-prop (i : I) : Pr.isProp (G i) = Truncation[l].Trunc[Root i].proposition ;
 module T = SheafTopology[l].Over[I,G] ;
} ;
