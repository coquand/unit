-- The hypothesis of MonicLifting follows from a Jacobson-radical kernel.
level l ; open Ring[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R)
 (phi : RingHom[l].Hom A C) {
 open A ; open RL[A] ;
 module I = Ideals[l].Over[A,setA] ;
 module At (J : I.Ideal)
  (kernel : (a : R) -> Id C.R (phi.1 a) C.z -> J.1 a)
  (radical : (a : R) -> J.1 a -> unit (add o (neg a))) {
  one-minus-twice (a : R) : Id R (add o (neg (add o (neg a)))) a =
   trans (ap (add o) (negsub o a))
    (trans (addA o (neg o) a) (trans (ap (\ c -> add c a) (addN o)) (zl a))) ;
  kernel-member (a : R) (h : Id C.R (phi.1 a) C.o) : J.1 (add o (neg a)) =
   kernel (add o (neg a))
    (trans (phi.2.2.1 o (neg a))
     (trans (ap (\ c -> C.add c (phi.1 (neg a))) phi.2.1)
      (trans (ap (C.add C.o) (RingHom[l].negation A C phi a))
       (trans (ap (\ c -> C.add C.o (C.neg c)) h) (C.addN C.o))))) ;
  lift-unit (a : R) (h : Id C.R (phi.1 a) C.o) : unit a =
   subst unit (one-minus-twice a) (radical (add o (neg a)) (kernel-member a h)) ;
  module Lifting = MonicLifting[l].Over[A,C,setA,phi,lift-unit] ;
 } ;
} ;
