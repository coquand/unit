-- Automorphisms of an NCAlgebra A, and conjugation.  Aut A: maps with a
-- two-sided inverse that are algebra homomorphisms (AlgSIP.Hom); equality
-- in Aut A is equality of the maps.  Aut A is a retract of AlgSIP.AlgIso A A.
-- For g h = 1 = h g, x |-> g x h is in Aut A (Conj).  conj-scale: it does
-- not change when g is replaced by a g with another inverse.  central: if
-- conjugation by g and by g' agree, h' g commutes with everything.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module NA = NCAlgebra[l].Over[R,setR] ;
 module AS = AlgSIP[l].Over[R,setR] ;
 module On (A : NA.Algebra) {
  X : U l = A.A ;
  Laws (phi psi : X -> X) : U l = ((x : X) -> Id X (psi (phi x)) x) * ((x : X) -> Id X (phi (psi x)) x) ;
  Inv (phi : X -> X) : U l = (psi : X -> X) * Laws phi psi ;
  laws-prop (phi psi : X -> X) : Pr.isProp (Laws phi psi) =
   Pr.isProp-Sigma ((x : X) -> Id X (psi (phi x)) x) (\ e -> (x : X) -> Id X (phi (psi x)) x)
    (F.isProp-Pi X (\ x -> Id X (psi (phi x)) x) (\ x -> A.set _ _))
    (\ e -> F.isProp-Pi X (\ x -> Id X (phi (psi x)) x) (\ x -> A.set _ _)) ;
  inv-prop (phi : X -> X) : Pr.isProp (Inv phi) = \ a b ->
   Pr.Sigma-eq (X -> X) (Laws phi) a.1 b.1 a.2 b.2
    (F.funext X (\ x -> X) a.1 b.1 (\ y -> trans (ap a.1 (sym (b.2.2 y))) (a.2.1 (b.1 y))))
    (laws-prop phi b.1) ;
  Str (phi : X -> X) : U l = Inv phi * AS.Hom A A phi ;
  str-prop (phi : X -> X) : Pr.isProp (Str phi) =
   Pr.isProp-Sigma (Inv phi) (\ i -> AS.Hom A A phi) (inv-prop phi) (\ i -> AS.hom-prop A A phi) ;
  Aut : U l = (phi : X -> X) * Str phi ;
  set-maps : Pr.isSet (X -> X) = F.isSet-Pi X (\ x -> X) (\ x -> A.set) ;
  set-aut : Pr.isSet Aut = Pr.isSet-Sigma (X -> X) Str set-maps (\ phi -> Pr.prop-to-set (Str phi) (str-prop phi)) ;
  aut-eq (a b : Aut) (h : (x : X) -> Id X (a.1 x) (b.1 x)) : Id Aut a b =
   Pr.Sigma-eq (X -> X) Str a.1 b.1 a.2 b.2 (F.funext X (\ x -> X) a.1 b.1 h) (str-prop b.1) ;
  -- comparison with algebra isomorphisms
  to-iso (a : Aut) : AS.AlgIso A A = ((a.1,Pr.qinv X X a.1 a.2.1.1 a.2.1.2.2 a.2.1.2.1),a.2.2) ;
  from-iso (e : AS.AlgIso A A) : Aut =
   (e.1.1,((e.1.2.sec,\ x -> Pr.sec-ret X X e.1.1 e.1.2 x,e.1.2.sec-eq),e.2)) ;
  from-to (a : Aut) : Id Aut (from-iso (to-iso a)) a = aut-eq (from-iso (to-iso a)) a (\ x -> refl (a.1 x)) ;

  -- a homomorphism preserves zero
  hom-zero (phi : X -> X) (hom : AS.Hom A A phi) : Id X (phi A.zero) A.zero = calc X {
   phi A.zero =< sym (A.addZ (phi A.zero)) > A.add (phi A.zero) A.zero
    =< ap (A.add (phi A.zero)) (sym (A.addN (phi A.zero))) > A.add (phi A.zero) (A.add (phi A.zero) (A.neg (phi A.zero)))
    =< A.addA (phi A.zero) (phi A.zero) (A.neg (phi A.zero)) > A.add (A.add (phi A.zero) (phi A.zero)) (A.neg (phi A.zero))
    =< ap (\ y -> A.add y (A.neg (phi A.zero))) (sym (hom.1 A.zero A.zero)) > A.add (phi (A.add A.zero A.zero)) (A.neg (phi A.zero))
    =< ap (\ y -> A.add (phi y) (A.neg (phi A.zero))) (A.addZ A.zero) > A.add (phi A.zero) (A.neg (phi A.zero))
    =< A.addN (phi A.zero) > A.zero } ;

  -- p (q x r) s = x when p q = 1 = r s
  cancel (p q r s x : X) (pq : Id X (A.mul p q) A.one) (rs : Id X (A.mul r s) A.one) :
   Id X (A.mul (A.mul p (A.mul (A.mul q x) r)) s) x = calc X {
   A.mul (A.mul p (A.mul (A.mul q x) r)) s
    =< sym (A.mulA p (A.mul (A.mul q x) r) s) > A.mul p (A.mul (A.mul (A.mul q x) r) s)
    =< ap (A.mul p) (sym (A.mulA (A.mul q x) r s)) > A.mul p (A.mul (A.mul q x) (A.mul r s))
    =< ap (\ y -> A.mul p (A.mul (A.mul q x) y)) rs > A.mul p (A.mul (A.mul q x) A.one)
    =< ap (A.mul p) (A.one-right (A.mul q x)) > A.mul p (A.mul q x)
    =< A.mulA p q x > A.mul (A.mul p q) x
    =< ap (\ y -> A.mul y x) pq > A.mul A.one x
    =< A.one-left x > x } ;

  module Conj (g h : X) (gh : Id X (A.mul g h) A.one) (hg : Id X (A.mul h g) A.one) {
   map (x : X) : X = A.mul (A.mul g x) h ;
   back (x : X) : X = A.mul (A.mul h x) g ;
   hom-add (x y : X) : Id X (map (A.add x y)) (A.add (map x) (map y)) =
    trans (ap (\ z -> A.mul z h) (A.dist-left g x y)) (A.dist-right (A.mul g x) (A.mul g y) h) ;
   hom-scale (a : R.R) (x : X) : Id X (map (A.scale a x)) (A.scale a (map x)) =
    trans (ap (\ z -> A.mul z h) (A.scale-mul-right a g x)) (A.scale-mul-left a (A.mul g x) h) ;
   hom-mul (x y : X) : Id X (map (A.mul x y)) (A.mul (map x) (map y)) = calc X {
    A.mul (A.mul g (A.mul x y)) h
     =< ap (\ z -> A.mul z h) (A.mulA g x y) > A.mul (A.mul (A.mul g x) y) h
     =< ap (\ z -> A.mul (A.mul z y) h) (sym (A.one-right (A.mul g x))) > A.mul (A.mul (A.mul (A.mul g x) A.one) y) h
     =< ap (\ z -> A.mul (A.mul (A.mul (A.mul g x) z) y) h) (sym hg) > A.mul (A.mul (A.mul (A.mul g x) (A.mul h g)) y) h
     =< ap (\ z -> A.mul (A.mul z y) h) (A.mulA (A.mul g x) h g) > A.mul (A.mul (A.mul (A.mul (A.mul g x) h) g) y) h
     =< ap (\ z -> A.mul z h) (sym (A.mulA (A.mul (A.mul g x) h) g y)) > A.mul (A.mul (A.mul (A.mul g x) h) (A.mul g y)) h
     =< sym (A.mulA (A.mul (A.mul g x) h) (A.mul g y) h) > A.mul (A.mul (A.mul g x) h) (A.mul (A.mul g y) h) } ;
   hom-one : Id X (map A.one) A.one = trans (ap (\ z -> A.mul z h) (A.one-right g)) gh ;
   aut : Aut = (map,((back,\ x -> cancel h g h g x hg hg,\ x -> cancel g h g h x gh gh),
    (hom-add,hom-scale,hom-mul,hom-one))) ;
  } ;

  -- g x h = g' x h' when g' = a g, h g = 1 and g' h' = 1
  conj-scale (g h g' h' : X) (a : R.R) (eg : Id X g' (A.scale a g))
   (hg : Id X (A.mul h g) A.one) (gh' : Id X (A.mul g' h') A.one) (x : X) :
   Id X (A.mul (A.mul g x) h) (A.mul (A.mul g' x) h') = calc X {
   A.mul (A.mul g x) h
    =< sym (A.one-right (A.mul (A.mul g x) h)) > A.mul (A.mul (A.mul g x) h) A.one
    =< ap (A.mul (A.mul (A.mul g x) h)) (sym gh') > A.mul (A.mul (A.mul g x) h) (A.mul g' h')
    =< A.mulA (A.mul (A.mul g x) h) g' h' > A.mul (A.mul (A.mul (A.mul g x) h) g') h'
    =< ap (\ z -> A.mul z h') (sym (A.mulA (A.mul g x) h g')) > A.mul (A.mul (A.mul g x) (A.mul h g')) h'
    =< ap (\ z -> A.mul (A.mul (A.mul g x) (A.mul h z)) h') eg > A.mul (A.mul (A.mul g x) (A.mul h (A.scale a g))) h'
    =< ap (\ z -> A.mul (A.mul (A.mul g x) z) h') (A.scale-mul-right a h g) > A.mul (A.mul (A.mul g x) (A.scale a (A.mul h g))) h'
    =< ap (\ z -> A.mul (A.mul (A.mul g x) (A.scale a z)) h') hg > A.mul (A.mul (A.mul g x) (A.scale a A.one)) h'
    =< ap (\ z -> A.mul z h') (A.scale-mul-right a (A.mul g x) A.one) > A.mul (A.scale a (A.mul (A.mul g x) A.one)) h'
    =< ap (\ z -> A.mul (A.scale a z) h') (A.one-right (A.mul g x)) > A.mul (A.scale a (A.mul g x)) h'
    =< ap (\ z -> A.mul z h') (sym (A.scale-mul-left a g x)) > A.mul (A.mul (A.scale a g) x) h'
    =< ap (\ z -> A.mul (A.mul z x) h') (sym eg) > A.mul (A.mul g' x) h' } ;

  -- if g x h = g' x h' for all x, then h' g is central
  central (g h g' h' : X) (hg : Id X (A.mul h g) A.one) (hg' : Id X (A.mul h' g') A.one)
   (e : (y : X) -> Id X (A.mul (A.mul g y) h) (A.mul (A.mul g' y) h')) (x : X) :
   Id X (A.mul (A.mul h' g) x) (A.mul x (A.mul h' g)) = calc X {
   A.mul (A.mul h' g) x
    =< sym (A.one-right (A.mul (A.mul h' g) x)) > A.mul (A.mul (A.mul h' g) x) A.one
    =< ap (A.mul (A.mul (A.mul h' g) x)) (sym hg) > A.mul (A.mul (A.mul h' g) x) (A.mul h g)
    =< A.mulA (A.mul (A.mul h' g) x) h g > A.mul (A.mul (A.mul (A.mul h' g) x) h) g
    =< ap (\ z -> A.mul (A.mul z h) g) (sym (A.mulA h' g x)) > A.mul (A.mul (A.mul h' (A.mul g x)) h) g
    =< ap (\ z -> A.mul z g) (sym (A.mulA h' (A.mul g x) h)) > A.mul (A.mul h' (A.mul (A.mul g x) h)) g
    =< ap (\ z -> A.mul (A.mul h' z) g) (e x) > A.mul (A.mul h' (A.mul (A.mul g' x) h')) g
    =< ap (\ z -> A.mul z g) (A.mulA h' (A.mul g' x) h') > A.mul (A.mul (A.mul h' (A.mul g' x)) h') g
    =< ap (\ z -> A.mul (A.mul z h') g) (A.mulA h' g' x) > A.mul (A.mul (A.mul (A.mul h' g') x) h') g
    =< ap (\ z -> A.mul (A.mul (A.mul z x) h') g) hg' > A.mul (A.mul (A.mul A.one x) h') g
    =< ap (\ z -> A.mul (A.mul z h') g) (A.one-left x) > A.mul (A.mul x h') g
    =< sym (A.mulA x h' g) > A.mul x (A.mul h' g) } ;
 } ;
} ;
