-- A linear left inverse between finite free modules descends: its rows
-- solve fixed linear systems, whose solvability is a sheaf (DescentSpan).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : [j] SheafClosure[l,j].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module DF = DescentFrames[l].Over[R,setR,axioms.loc] ;
 module SQ = DescentSquare[l].Over[R,setR,axioms.loc] ;
 module ET = EtaleTopology[l].Over[R,setR] ; module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ; module RS = FiniteIdeal[l].Sums[R] ;
 module Map (r m : Nat) (f : (DL.Free r).M -> (DL.Free m).M)
  (fa : (u v : (DL.Free r).M) -> Id (DL.Free m).M (f ((DL.Free r).madd u v)) ((DL.Free m).madd (f u) (f v)))
  (fs : (a : R.R) (v : (DL.Free r).M) -> Id (DL.Free m).M (f ((DL.Free r).sm a v)) ((DL.Free m).sm a (f v))) {
  V : MD.Module = DL.Free r ; W : MD.Module = DL.Free m ;
  Retraction : U l = (g : W.M -> V.M) *
   ((u v : W.M) -> Id V.M (g (W.madd u v)) (V.madd (g u) (g v))) *
   ((a : R.R) (v : W.M) -> Id V.M (g (W.sm a v)) (V.sm a (g v))) *
   ((v : V.M) -> Id V.M (g (f v)) v) ;
  columns (k : Fin m) (t : Fin r) : R.R = f (DF.Rank[r].unit t) k ;
  module SP = DescentSpan[l].Over[R,setR,axioms].At[V,
   SL.modal-Pi (Fin r) (\ j -> R.R) (\ j -> ER.R-local),sh,r,
   (sh @l).inc (DL.On[V].Frame r) DF.Rank[r].standard].Family[m,columns] ;
  module Given (b : Retraction) {
   module G = DF.Rank[m].Map[V,b.1,b.2.1,b.2.2.1] ;
   coefficients (j : Fin r) (k : Fin m) : R.R = G.columns k j ;
   row (j : Fin r) : SP.Witness (DF.Rank[r].unit j) =
    (coefficients j,F.funext (Fin r) (\ t -> R.R) _ _ (\ t ->
     trans (ap (\ v -> v t) (SQ.Rank[r].coordinates m columns (coefficients j)))
      (trans (RS.sum-cong m (\ k -> R.mul (columns k t) (coefficients j k))
        (\ k -> R.mul (coefficients j k) (columns k t)) (\ k -> R.mulC (columns k t) (coefficients j k)))
       (trans (sym (ap (\ v -> v j) (SQ.Rank[r].coordinates m G.columns (f (DF.Rank[r].unit t)))))
        (trans (ap (\ v -> v j) (G.equation (f (DF.Rank[r].unit t))))
         (trans (ap (\ v -> v j) (b.2.2.2 (DF.Rank[r].unit t))) (DL.D.delta-sym r j t))))))) ;
  } ;
  Rows : U l = (j : Fin r) -> SP.Witness (DF.Rank[r].unit j) ;
  module Chosen (c : Rows) {
   g (v : W.M) (j : Fin r) : R.R = RS.lin m (c j).1 v ;
   add (u v : W.M) : Id V.M (g (W.madd u v)) (V.madd (g u) (g v)) =
    F.funext (Fin r) (\ j -> R.R) _ _ (\ j -> RS.lin-add m (c j).1 u v) ;
   scale (a : R.R) (v : W.M) : Id V.M (g (W.sm a v)) (V.sm a (g v)) =
    F.funext (Fin r) (\ j -> R.R) _ _ (\ j -> RS.lin-scale m (c j).1 v a) ;
   on-unit (t : Fin r) : Id V.M (g (f (DF.Rank[r].unit t))) (DF.Rank[r].unit t) =
    F.funext (Fin r) (\ j -> R.R) _ _ (\ j ->
     trans (RS.sum-cong m (\ k -> R.mul ((c j).1 k) (columns k t))
       (\ k -> R.mul (columns k t) ((c j).1 k)) (\ k -> R.mulC ((c j).1 k) (columns k t)))
      (trans (sym (ap (\ v -> v t) (SQ.Rank[r].coordinates m columns (c j).1)))
       (trans (ap (\ v -> v t) (c j).2) (DL.D.delta-sym r t j)))) ;
   comp-add (u v : V.M) : Id V.M (g (f (V.madd u v))) (V.madd (g (f u)) (g (f v))) =
    trans (ap g (fa u v)) (add (f u) (f v)) ;
   comp-scale (a : R.R) (v : V.M) : Id V.M (g (f (V.sm a v))) (V.sm a (g (f v))) =
    trans (ap g (fs a v)) (scale a (f v)) ;
   module C = DF.Rank[r].Map[V,\ v -> g (f v),comp-add,comp-scale] ;
   law (v : V.M) : Id V.M (g (f v)) v =
    trans (sym (C.equation v))
     (trans (ap (\ w -> DL.On[V].lin r w v)
       (F.funext (Fin r) (\ t -> V.M) C.columns DF.Rank[r].unit on-unit)) (DF.Rank[r].expansion v)) ;
   result : Retraction = (g,add,scale,law) ;
  } ;
  theorem (local : (sh @l).close Retraction) : Tr.Trunc[Retraction].carrier =
   TC.map Rows Retraction (\ c -> Chosen[c].result)
    (AffineFinite[l].choice r (\ j -> SP.Witness (DF.Rank[r].unit j))
     (\ j -> (sh @l).elim @l Retraction (SP.Span (DF.Rank[r].unit j))
      Tr.Trunc[SP.Witness (DF.Rank[r].unit j)].proposition (SP.span-modal (DF.Rank[r].unit j))
      (\ b -> Tr.Trunc[SP.Witness (DF.Rank[r].unit j)].inc (Given[b].row j)) local)) ;
  opaque theorem ;
 } ;
} ;
