-- Lemma 4.1 for R: if P Q = X^K as coefficient lists and P(1) is a unit,
-- then merely one coefficient P_i is a unit and all others are not not 0.
-- P(1) is the sum of the coefficients, so Loc gives the unit P_i.  For
-- P_j /= 0 the goal is negative, so the finitely many coefficients of P
-- and Q may be decided (each is 0 or, by 2.2.3(b), a unit).  Then
-- P = X^k P'' with P''(0) and the top of P'' units, and Q = X^l Q' with
-- Q'(0) a unit; comparing at X^(k+l) gives k+l = K and P'' Q' = 1, so
-- P'' has degree 0 (TopCoefficient), i.e. P has the single nonzero
-- coefficient P_k, and k = i.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC)
 (loc : StandardOpens[l].Over[R,setR].Locality) {
 open R ; open RL[R] ;
 module Raw = Poly[l].PolyR[R] ;
 module M = Mul[l].MulR[R] ;
 module MR = RawMultiplication[l].Laws[R] ;
 module AU = AffineUnits[l].Over[R,setR,sqc,loc.1] ;
 module UP = UnitPowers[l].Over[R,setR] ;
 module G = UP.G ;
 module SO = StandardOpens[l].Over[R,setR].Local[loc] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module Pow = AffinePowers[l].Over[R] ;
 one-nz : Not (Id R.R o z) = loc.1 ;
 zero-unit (u : unit z) : Empty = SO.zero-unit z (refl z) u ;
 unit-mul (a b : R.R) (ua : unit a) (ub : unit b) : unit (mul a b) = (G.times (a,ua) (b,ub)).2 ;
 -- shifts
 one : Raw.P = cons o nil ;
 shiftN : Nat -> Raw.P -> Raw.P = split { zero -> \ p -> p ; suc k | r -> \ p -> cons z (r p) } ;
 coef-shift : (K : Nat) (p : Raw.P) (j : Nat) -> Id R.R (Raw.coef (shiftN K p) (plus K j)) (Raw.coef p j) = split {
  zero -> \ p j -> refl (Raw.coef p j) ; suc K | r -> r } ;
 coef-at : (K : Nat) (p : Raw.P) -> Id R.R (Raw.coef (shiftN K p) K) (Raw.coef p zero) = split {
  zero -> \ p -> refl (Raw.coef p zero) ; suc K | r -> r } ;
 coef-low : (j a : Nat) (p : Raw.P) -> Id R.R (Raw.coef (shiftN (plus j (suc a)) p) j) z = split {
  zero -> \ a p -> refl z ; suc j | r -> r } ;
 shiftN-cong : (k : Nat) (p q : Raw.P) -> Raw.peq p q -> Raw.peq (shiftN k p) (shiftN k q) = split {
  zero -> \ p q h -> h ;
  suc k | r -> \ p q h -> M.consz-peq (shiftN k p) (shiftN k q) (r p q h) } ;
 shift-cancel (K : Nat) (p q : Raw.P) (h : Raw.peq (shiftN K p) (shiftN K q)) : Raw.peq p q =
  \ j -> trans (sym (coef-shift K p j)) (trans (h (plus K j)) (coef-shift K q j)) ;
 mul-shift-right (a b : Raw.P) : (l : Nat) -> Raw.peq (M.pmul a (shiftN l b)) (shiftN l (M.pmul a b)) = split {
  zero -> \ k -> refl (Raw.coef (M.pmul a b) k) ;
  suc l | r -> Raw.peq-trans _ _ _ (MR.mul-shift-right a (shiftN l b))
   (M.consz-peq (M.pmul a (shiftN l b)) (shiftN l (M.pmul a b)) r) } ;
 mul-shift : (k l : Nat) (a b : Raw.P) ->
  Raw.peq (M.pmul (shiftN k a) (shiftN l b)) (shiftN (plus k l) (M.pmul a b)) = split {
  zero -> \ l a b -> mul-shift-right a b l ;
  suc k | r -> \ l a b -> Raw.peq-trans _ _ _ (MR.mul-shift-left (shiftN k a) (shiftN l b))
   (M.consz-peq (M.pmul (shiftN k a) (shiftN l b)) (shiftN (plus k l) (M.pmul a b)) (r l a b)) } ;
 -- decided coefficients
 Dec : Raw.P -> U l = split { nil -> Top ; cons c p | r -> Plus (Id R.R c z) (unit c) * r } ;
 NN (A : U l) : U l = (A -> Empty) -> Empty ;
 nn-dec : (p : Raw.P) -> NN (Dec p) = split {
  nil -> \ k -> k tt ;
  cons c p | ih -> \ k -> ih (\ d -> k (inr (AU.nonzero-unit c (\ h -> k (inl h,d))),d)) } ;
 cz-nil (c : R.R) (p : Raw.P) (h : Id R.R c z) (e : Raw.peq p nil) :
  (k : Nat) -> Id R.R (Raw.coef (cons c p) k) (Raw.coef nil k) = split { zero -> h ; suc k -> e k } ;
 -- lowest nonzero coefficient
 LowW (p : Raw.P) : U l = (k : Nat) * (q : Raw.P) * Raw.peq p (shiftN k q) * unit (Raw.coef q zero) * Dec q ;
 low-zero (c : R.R) (p : Raw.P) (h : Id R.R c z) :
  Plus (Raw.peq p nil) (LowW p) -> Plus (Raw.peq (cons c p) nil) (LowW (cons c p)) = split {
  inl e -> inl (cz-nil c p h e) ;
  inr w -> inr (suc w.1,w.2.1,MR.cons-cong c z p (shiftN w.1 w.2.1) h w.2.2.1,w.2.2.2.1,w.2.2.2.2) } ;
 low-cons (c : R.R) (p : Raw.P) (dp : Dec p) (r : Plus (Raw.peq p nil) (LowW p)) :
  Plus (Id R.R c z) (unit c) -> Plus (Raw.peq (cons c p) nil) (LowW (cons c p)) = split {
  inl h -> low-zero c p h r ;
  inr u -> inr (zero,cons c p,\ k -> refl (Raw.coef (cons c p) k),u,(inr u,dp)) } ;
 low : (p : Raw.P) -> Dec p -> Plus (Raw.peq p nil) (LowW p) = split {
  nil -> \ d -> inl (\ k -> refl z) ;
  cons c p | ih -> \ d -> low-cons c p d.2 (ih d.2) d.1 } ;
 -- highest nonzero coefficient
 TrimW (p : Raw.P) : U l = (q : Raw.P) * Raw.peq p q * unit (Raw.lastD q) ;
 last-cons (c : R.R) : (q : Raw.P) -> unit (Raw.lastD q) -> unit (Raw.lastD (cons c q)) = split {
  nil -> \ u -> efq (zero-unit u) ; cons d g -> \ u -> u } ;
 trim-end (c : R.R) (p : Raw.P) (e : Raw.peq p nil) :
  Plus (Id R.R c z) (unit c) -> Plus (Raw.peq (cons c p) nil) (TrimW (cons c p)) = split {
  inl h -> inl (cz-nil c p h e) ;
  inr u -> inr (cons c nil,MR.cons-cong c c p nil (refl c) e,u) } ;
 trim-cons (c : R.R) (p : Raw.P) :
  Plus (Raw.peq p nil) (TrimW p) -> Plus (Id R.R c z) (unit c) -> Plus (Raw.peq (cons c p) nil) (TrimW (cons c p)) = split {
  inl e -> \ dc -> trim-end c p e dc ;
  inr w -> \ dc -> inr (cons c w.1,MR.cons-cong c c p w.1 (refl c) w.2.1,last-cons c w.1 w.2.2) } ;
 trim : (p : Raw.P) -> Dec p -> Plus (Raw.peq p nil) (TrimW p) = split {
  nil -> \ d -> inl (\ k -> refl z) ;
  cons c p | ih -> \ d -> trim-cons c p (ih d.2) d.1 } ;
 -- a single nonzero coefficient
 SingleW (p : Raw.P) : U l = (k : Nat) * (c : R.R) * Raw.peq p (shiftN k (cons c nil)) ;
 module Single (P Q : Raw.P) (K : Nat) (h : Raw.peq (M.pmul P Q) (shiftN K one)) {
  product-zero (e : Raw.peq (M.pmul P Q) nil) : Empty = one-nz (calc R.R {
   o =< sym (coef-at K one) > Raw.coef (shiftN K one) K
    =< sym (h K) > Raw.coef (M.pmul P Q) K
    =< e K > z }) ;
  p-nil (e : Raw.peq P nil) : Empty = product-zero (Raw.peq-trans _ _ _ (MR.mul-cong-left P nil e Q) (MR.mul-zero-left Q)) ;
  q-nil (e : Raw.peq Q nil) : Empty = product-zero (Raw.peq-trans _ _ _ (MR.mul-comm P Q)
   (Raw.peq-trans _ _ _ (MR.mul-cong-left Q nil e P) (MR.mul-zero-left P))) ;
  unit-nil (q : Raw.P) (e : Raw.peq q nil) (u : unit (Raw.coef q zero)) : Empty =
   zero-unit (Pr.subst R.R unit _ _ (e zero) u) ;
  module With (w : LowW P) (t : TrimW w.2.1) (v : LowW Q) {
   kP : Nat = w.1 ; P2 : Raw.P = t.1 ; lQ : Nat = v.1 ; Q1 : Raw.P = v.2.1 ;
   hP : Raw.peq P (shiftN kP P2) = Raw.peq-trans _ _ _ w.2.2.1 (shiftN-cong kP w.2.1 P2 t.2.1) ;
   prod : Raw.peq (M.pmul P Q) (shiftN (plus kP lQ) (M.pmul P2 Q1)) =
    Raw.peq-trans _ _ _ (MR.mul-cong P (shiftN kP P2) Q (shiftN lQ Q1) hP v.2.2.1) (mul-shift kP lQ P2 Q1) ;
   H : Raw.peq (shiftN (plus kP lQ) (M.pmul P2 Q1)) (shiftN K one) = \ j -> trans (sym (prod j)) (h j) ;
   u0 : unit (Raw.coef (M.pmul P2 Q1) zero) =
    Pr.subst R.R unit _ _ (sym (M.coef0-pmul P2 Q1))
     (unit-mul (Raw.coef P2 zero) (Raw.coef Q1 zero) (Pr.subst R.R unit _ _ (t.2.1 zero) w.2.2.2.1) v.2.2.2.1) ;
   unit-at : unit (Raw.coef (shiftN K one) (plus kP lQ)) =
    Pr.subst R.R unit _ _ (sym (trans (sym (H (plus kP lQ))) (coef-at (plus kP lQ) (M.pmul P2 Q1)))) u0 ;
   above (j : Nat) (e : Id Nat (plus kP lQ) (plus K (suc j))) : Empty =
    zero-unit (Pr.subst R.R unit _ _ (coef-shift K one (suc j))
     (Pr.subst Nat (\ m -> unit (Raw.coef (shiftN K one) m)) _ _ e unit-at)) ;
   below (j : Nat) (e : Id Nat K (plus (plus kP lQ) (suc j))) : Empty =
    zero-unit (Pr.subst R.R unit _ _ (coef-low (plus kP lQ) j one)
     (Pr.subst Nat (\ m -> unit (Raw.coef (shiftN m one) (plus kP lQ))) _ _ e unit-at)) ;
   apart : Plus ((j : Nat) * Id Nat (plus kP lQ) (plus K (suc j))) ((j : Nat) * Id Nat K (plus (plus kP lQ) (suc j))) -> Empty = split {
    inl a -> above a.1 a.2 ; inr a -> below a.1 a.2 } ;
   equal : UP.Cmp (plus kP lQ) K -> Id Nat (plus kP lQ) K = split { inl e -> e ; inr a -> efq (apart a) } ;
   inverse : Raw.peq (M.pmul P2 Q1) one =
    shift-cancel K (M.pmul P2 Q1) one
     (Pr.subst Nat (\ m -> Raw.peq (shiftN m (M.pmul P2 Q1)) (shiftN K one)) _ _ (equal (UP.compare (plus kP lQ) K)) H) ;
   by-length-suc : (n : Nat) -> Id Nat (Raw.plen P2) (suc n) -> SingleW P = split {
    zero -> \ e -> (kP,Raw.lastD P2,Raw.peq-trans _ _ _ hP (shiftN-cong kP P2 (cons (Raw.lastD P2) nil) (Raw.single P2 e))) ;
    suc n -> \ e -> efq (TopCoefficient[l].TopR[R,P2,n,e].noninv t.2.2 one-nz (Raw.plen Q1) Q1 (refl (Raw.plen Q1)) inverse) } ;
   by-length : (n : Nat) -> Id Nat (Raw.plen P2) n -> SingleW P = split {
    zero -> \ e -> efq (unit-nil P2 (Raw.len0 P2 e) (Pr.subst R.R unit _ _ (t.2.1 zero) w.2.2.2.1)) ;
    suc n -> by-length-suc n } ;
   result : SingleW P = by-length (Raw.plen P2) (refl (Raw.plen P2)) ;
  } ;
  module Decided (dP : Dec P) (dQ : Dec Q) {
   on-q (w : LowW P) (t : TrimW w.2.1) : Plus (Raw.peq Q nil) (LowW Q) -> SingleW P = split {
    inl e -> efq (q-nil e) ; inr v -> With[w,t,v].result } ;
   on-trim (w : LowW P) : Plus (Raw.peq w.2.1 nil) (TrimW w.2.1) -> SingleW P = split {
    inl e -> efq (unit-nil w.2.1 e w.2.2.2.1) ; inr t -> on-q w t (low Q dQ) } ;
   on-low : Plus (Raw.peq P nil) (LowW P) -> SingleW P = split {
    inl e -> efq (p-nil e) ; inr w -> on-trim w (trim w.2.1 w.2.2.2.2) } ;
   result : SingleW P = on-low (low P dP) ;
  } ;
 } ;
 -- the coefficients of a monomial
 monomial-apart (k : Nat) (c : R.R) (j : Nat) :
  Plus ((a : Nat) * Id Nat j (plus k (suc a))) ((a : Nat) * Id Nat k (plus j (suc a))) ->
  Plus (Id Nat j k) (Id R.R (Raw.coef (shiftN k (cons c nil)) j) z) = split {
  inl a -> inr (trans (ap (Raw.coef (shiftN k (cons c nil))) a.2) (coef-shift k (cons c nil) (suc a.1))) ;
  inr a -> inr (trans (ap (\ m -> Raw.coef (shiftN m (cons c nil)) j) a.2) (coef-low j a.1 (cons c nil))) } ;
 monomial-coef (k : Nat) (c : R.R) (j : Nat) :
  UP.Cmp j k -> Plus (Id Nat j k) (Id R.R (Raw.coef (shiftN k (cons c nil)) j) z) = split {
  inl e -> inl e ;
  inr a -> monomial-apart k c j a } ;
 -- coefficients as a finite sum
 idx-suc (n : Nat) (r : Presentations[l].Fin n -> Nat) : Presentations[l].Fin (suc n) -> Nat = split {
  inl i -> suc (r i) ; inr t -> zero } ;
 idx : (n : Nat) -> Presentations[l].Fin n -> Nat = split {
  zero -> \ e -> efq e ; suc n | r -> idx-suc n r } ;
 eval-one : (p : Raw.P) -> Id R.R (Raw.ev p o) (RS.sum (Raw.plen p) (\ i -> Raw.coef p (idx (Raw.plen p) i))) = split {
  nil -> refl z ;
  cons c p | r -> ap (add c) (trans (Pow.one-left (Raw.ev p o)) r) } ;
 Good (P : Raw.P) (i : Nat) : U l =
  unit (Raw.coef P i) * ((j : Nat) -> Not (Id Nat j i) -> Not (Not (Id R.R (Raw.coef P j) z))) ;
 module Main (P Q : Raw.P) (K : Nat) (h : Raw.peq (M.pmul P Q) (shiftN K one)) (pu : unit (Raw.ev P o)) {
  module S = Single[P,Q,K,h] ;
  at-i (i : Nat) (ui : unit (Raw.coef P i)) (s : SingleW P) : Plus (Id Nat i s.1) (Id R.R (Raw.coef (shiftN s.1 (cons s.2.1 nil)) i) z) -> Id Nat i s.1 = split {
   inl e -> e ; inr zi -> efq (zero-unit (Pr.subst R.R unit _ _ (trans (s.2.2 i) zi) ui)) } ;
  at-j (j i : Nat) (ne : Not (Id Nat j i)) (s : SingleW P) (ei : Id Nat i s.1) :
   Plus (Id Nat j s.1) (Id R.R (Raw.coef (shiftN s.1 (cons s.2.1 nil)) j) z) -> Id R.R (Raw.coef P j) z = split {
   inl e -> efq (ne (trans e (sym ei))) ; inr zj -> trans (s.2.2 j) zj } ;
  from-single (i : Nat) (ui : unit (Raw.coef P i)) (j : Nat) (ne : Not (Id Nat j i)) (s : SingleW P) :
   Id R.R (Raw.coef P j) z =
   at-j j i ne s (at-i i ui s (monomial-coef s.1 s.2.1 i (UP.compare i s.1)))
    (monomial-coef s.1 s.2.1 j (UP.compare j s.1)) ;
  others (i : Nat) (ui : unit (Raw.coef P i)) (j : Nat) (ne : Not (Id Nat j i)) :
   Not (Not (Id R.R (Raw.coef P j) z)) = \ nz ->
   nn-dec P (\ dP -> nn-dec Q (\ dQ -> nz (from-single i ui j ne S.Decided[dP,dQ].result))) ;
  v (i : Presentations[l].Fin (Raw.plen P)) : R.R = Raw.coef P (idx (Raw.plen P) i) ;
  result : Tr.Trunc[(i : Nat) * Good P i].carrier =
   Tr.Trunc[(i : Presentations[l].Fin (Raw.plen P)) * unit (v i)].induction @l
    (\ s -> Tr.Trunc[(i : Nat) * Good P i].carrier) (\ s -> Tr.Trunc[(i : Nat) * Good P i].proposition)
    (\ w -> Tr.Trunc[(i : Nat) * Good P i].inc (idx (Raw.plen P) w.1,w.2,others (idx (Raw.plen P) w.1) w.2))
    (SO.finite-unit (Raw.plen P) v (Pr.subst R.R unit _ _ (eval-one P) pu)) ;
 } ;
} ;
