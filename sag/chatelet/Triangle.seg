-- The triangle of Prop 3.3.1 (sevb.pdf): through delta, the action of
-- alpha(p) on right ideals is the action of p on P^n,
--     RI(alpha p) (delta[q]) = delta[p q],
-- and so, by transport of structure (TriangleRI), transporting delta[q]
-- along ap RI (sip (alpha p)) gives delta[p q] (omega).  With delta, alpha
-- (SkolemNoetherPGL) and beta (AutPGL) equivalences, this makes Omega RI
-- an equivalence (Lemma 3.1.2 then gives AZ_n = SB_n).
--
-- For p = [A], with G, H the matrices of A and of its inverse, alpha p is
-- X |-> G X H and its inverse Y |-> H Y G.  So Y is in alpha p [delta[x]]
-- iff H Y G is in delta[x].  The identity P (x r^T) Q = (P x)(Q^T r)^T
-- gives: Col x Z implies Col (P x) (P Z Q) (conj-col), and G H = 1 = H G
-- give both directions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n0 : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (cls : Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem)
 (I : U l) (G : I -> U l)
 (sh : [j] SheafClosure[l,j].Over[I,G].Ops)
 (R-modal : SheafTopology[l].Over[I,G].isModal @l R.R)
 (descends : (S : AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Sub (MnAlgebra[l].Over[R,setR,suc (suc n0)].algebra)) ->
   (sh @l).close (AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Basis (MnAlgebra[l].Over[R,setR,suc (suc n0)].algebra) S) ->
   Tr.Trunc[AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Basis (MnAlgebra[l].Over[R,setR,suc (suc n0)].algebra) S].carrier) {
 module DL = Delta[l].Over[R,setR,suc n0,I,G,sh,sag.loc,R-modal,descends] ;
 module SP = SkolemNoetherPGL[l].Over[R,setR,n0,sag,cls] ;
 module TR = TriangleRI[l].Over[R,setR,suc n0,I,G,sh] ;
 module AP = DL.AP ;
 module MN = DL.MN ;
 module PQ = DL.PQ ;
 module D = DL.D ;
 module SR = DL.SR ;
 module CJ = SP.CJ ;
 module APG = SP.AP ;
 Mt : AP.Alg = DL.Mt ;
 Mat : U l = DL.Mat ;
 Vc : U l = DL.Vc ;
 -- P (x r^T) Q = (P x) (Q^T r)^T
 rT (Q : Mat) (r : Vc) : Vc = \ j -> SR.sum (suc (suc n0)) (\ k -> R.mul (r k) (Q k j)) ;
 conj-outer (P Q : Mat) (x r : Vc) :
  Id Mat (MN.mmul (MN.mmul P (DL.outer x r)) Q) (DL.outer (SP.mv P x) (rT Q r)) =
  MN.mat-eq (MN.mmul (MN.mmul P (DL.outer x r)) Q) (DL.outer (SP.mv P x) (rT Q r)) (\ i j ->
   let { px : R.R = SP.mv P x i ;
         inner (k : Fin (suc (suc n0))) :
          Id R.R (SR.sum (suc (suc n0)) (\ m -> R.mul (P i m) (R.mul (x m) (r k)))) (R.mul px (r k)) =
          trans (SR.sum-cong (suc (suc n0)) _ (\ m -> R.mul (R.mul (P i m) (x m)) (r k)) (\ m -> R.mulA (P i m) (x m) (r k)))
           (D.sum-scale-right (r k) (suc (suc n0)) (\ m -> R.mul (P i m) (x m))) ; }
   in calc R.R {
    SR.sum (suc (suc n0)) (\ k -> R.mul (MN.mmul P (DL.outer x r) i k) (Q k j))
     =< SR.sum-cong (suc (suc n0)) _ (\ k -> R.mul (R.mul px (r k)) (Q k j)) (\ k -> ap (\ s -> R.mul s (Q k j)) (inner k)) >
    SR.sum (suc (suc n0)) (\ k -> R.mul (R.mul px (r k)) (Q k j))
     =< SR.sum-cong (suc (suc n0)) _ (\ k -> R.mul px (R.mul (r k) (Q k j))) (\ k -> sym (R.mulA px (r k) (Q k j))) >
    SR.sum (suc (suc n0)) (\ k -> R.mul px (R.mul (r k) (Q k j)))
     =< SR.sum-scale px (suc (suc n0)) (\ k -> R.mul (r k) (Q k j)) >
    R.mul px (rT Q r j) }) ;
 -- conjugating a matrix with columns along x gives one with columns along P x
 conj-col (P Q : Mat) (x : Vc) (nz : PQ.NonZero x) (Z : Mat) (h : DL.Col x Z) :
  DL.Col (SP.mv P x) (MN.mmul (MN.mmul P Z) Q) =
  Tr.Trunc[PQ.Pivots x].induction @l (\ t -> DL.Col (SP.mv P x) (MN.mmul (MN.mmul P Z) Q))
   (\ t -> DL.col-prop (SP.mv P x) (MN.mmul (MN.mmul P Z) Q))
   (\ pv -> Pr.subst Mat (DL.Col (SP.mv P x))
     (DL.outer (SP.mv P x) (rT Q (DL.row pv.1 pv.2.1 Z))) (MN.mmul (MN.mmul P Z) Q)
     (trans (sym (conj-outer P Q x (DL.row pv.1 pv.2.1 Z)))
      (ap (\ W -> MN.mmul (MN.mmul P W) Q) (DL.outer-row x pv.1 pv.2 Z h)))
     (DL.col-outer (SP.mv P x) (rT Q (DL.row pv.1 pv.2.1 Z)))) nz ;

 module OfA (A : SP.GL) {
  Gm : Mat = SP.OfGL[A].Gm ;
  Hm : Mat = SP.OfGL[A].Hm ;
  phi : TR.AS.AlgIso Mt Mt = CJ.to-iso (SP.act A) ;
  ei (Y : Mat) : Mat = MN.mmul (MN.mmul Hm Y) Gm ;
  amap (q : PQ.Pn) : PQ.Pn = SP.PL.Act[A.1].map q ;
  pt (x : PQ.Point) : PQ.Point = SP.PL.Act[A.1].point x ;
  gx (x : Vc) : Id Vc (A.1.1 x) (SP.mv Gm x) = SP.OfGL[A].LG.rep x ;
  -- P ((Q Y) P') Q' = Y when P Q = 1 and P' Q' = 1
  sandwich (P Q P' Q' Y : Mat) (pq : Id Mat (MN.mmul P Q) MN.mone) (pq' : Id Mat (MN.mmul P' Q') MN.mone) :
   Id Mat (MN.mmul (MN.mmul P (MN.mmul (MN.mmul Q Y) P')) Q') Y =
   calc Mat {
    MN.mmul (MN.mmul P (MN.mmul (MN.mmul Q Y) P')) Q'
     =< ap (\ W -> MN.mmul W Q') (MN.m-mulA P (MN.mmul Q Y) P') > MN.mmul (MN.mmul (MN.mmul P (MN.mmul Q Y)) P') Q'
     =< ap (\ W -> MN.mmul (MN.mmul W P') Q') (MN.m-mulA P Q Y) > MN.mmul (MN.mmul (MN.mmul (MN.mmul P Q) Y) P') Q'
     =< ap (\ W -> MN.mmul (MN.mmul (MN.mmul W Y) P') Q') pq > MN.mmul (MN.mmul (MN.mmul MN.mone Y) P') Q'
     =< ap (\ W -> MN.mmul (MN.mmul W P') Q') (MN.m-one-left Y) > MN.mmul (MN.mmul Y P') Q'
     =< sym (MN.m-mulA Y P' Q') > MN.mmul Y (MN.mmul P' Q')
     =< ap (MN.mmul Y) pq' > MN.mmul Y MN.mone
     =< MN.m-one-right Y > Y } ;
  hgx (x : Vc) : Id Vc (SP.mv Hm (SP.mv Gm x)) x =
   trans (SP.mv-assoc Hm Gm x) (trans (ap (\ W -> SP.mv W x) SP.OfGL[A].HG) (SP.mv-one x)) ;
  fw-at (x : PQ.Point) (Y : Mat) (h : DL.Col x.1 (ei Y)) : DL.Col (pt x).1 Y =
   Pr.subst Vc (\ v -> DL.Col v Y) (SP.mv Gm x.1) (A.1.1 x.1) (sym (gx x.1))
    (Pr.subst Mat (DL.Col (SP.mv Gm x.1)) (MN.mmul (MN.mmul Gm (ei Y)) Hm) Y
      (sandwich Gm Hm Gm Hm Y SP.OfGL[A].GH SP.OfGL[A].GH)
      (conj-col Gm Hm x.1 x.2 (ei Y) h)) ;
  bw-at (x : PQ.Point) (Y : Mat) (h : DL.Col (pt x).1 Y) : DL.Col x.1 (ei Y) =
   Pr.subst Vc (\ v -> DL.Col v (ei Y)) (SP.mv Hm (SP.mv Gm x.1)) x.1 (hgx x.1)
    (conj-col Hm Gm (SP.mv Gm x.1)
      (Pr.subst Vc PQ.NonZero (A.1.1 x.1) (SP.mv Gm x.1) (gx x.1) (pt x).2) Y
      (Pr.subst Vc (\ v -> DL.Col v Y) (A.1.1 x.1) (SP.mv Gm x.1) (gx x.1) h)) ;
  Fw (q : PQ.Pn) : U l = (Y : Mat) -> DL.Memb q (ei Y) -> DL.Memb (amap q) Y ;
  Bw (q : PQ.Pn) : U l = (Y : Mat) -> DL.Memb (amap q) Y -> DL.Memb q (ei Y) ;
  fw (q : PQ.Pn) : Fw q =
   PQ.Q.induction @l Fw
    (\ q1 -> FL.isProp-Pi Mat (\ Y -> DL.Memb q1 (ei Y) -> DL.Memb (amap q1) Y) (\ Y ->
      FL.isProp-Pi (DL.Memb q1 (ei Y)) (\ m -> DL.Memb (amap q1) Y) (\ m -> DL.memb-prop (amap q1) Y)))
    (\ x Y m -> Pr.subst PQ.Pn (\ q2 -> DL.Memb q2 Y) (PQ.class (pt x)) (amap (PQ.class x))
      (sym (SP.PL.Act[A.1].beta x))
      (DL.col-class (pt x) Y (fw-at x Y (DL.col-of-memb x (ei Y) m)))) q ;
  bw (q : PQ.Pn) : Bw q =
   PQ.Q.induction @l Bw
    (\ q1 -> FL.isProp-Pi Mat (\ Y -> DL.Memb (amap q1) Y -> DL.Memb q1 (ei Y)) (\ Y ->
      FL.isProp-Pi (DL.Memb (amap q1) Y) (\ m -> DL.Memb q1 (ei Y)) (\ m -> DL.memb-prop q1 (ei Y))))
    (\ x Y m -> DL.col-class x (ei Y) (bw-at x Y (DL.col-of-memb (pt x) Y
      (Pr.subst PQ.Pn (\ q2 -> DL.Memb q2 Y) (amap (PQ.class x)) (PQ.class (pt x)) (SP.PL.Act[A.1].beta x) m)))) q ;
  tri-RI (q : PQ.Pn) : Id (AP.RI Mt) (TR.RIm[Mt,Mt,phi].map (DL.delta-map q)) (DL.delta-map (amap q)) =
   TR.ri-eq Mt (TR.RIm[Mt,Mt,phi].map (DL.delta-map q)) (DL.delta-map (amap q))
    (FL1.funext Mat (\ Y -> AP.PropT) (TR.RIm[Mt,Mt,phi].Smap (DL.Sq q)) (DL.Sq (amap q)) (\ Y ->
      AP.propT-ext (DL.Sq q (ei Y)) (DL.Sq (amap q) Y) (fw q Y) (bw q Y))) ;
 } ;

 -- the triangle on PGL
 tri (p : APG.PGL) (q : PQ.Pn) :
  Id PQ.Pn (DL.eps (TR.RIm[Mt,Mt,SP.iso-of p].map (DL.delta-map q))) ((APG.aut-of p).1 q) =
  APG.QP.induction @l (\ p1 -> Id PQ.Pn (DL.eps (TR.RIm[Mt,Mt,SP.iso-of p1].map (DL.delta-map q))) ((APG.aut-of p1).1 q))
   (\ p1 -> PQ.Q.set (DL.eps (TR.RIm[Mt,Mt,SP.iso-of p1].map (DL.delta-map q))) ((APG.aut-of p1).1 q))
   (\ A -> calc PQ.Pn {
     DL.eps (TR.RIm[Mt,Mt,SP.iso-of (APG.QP.inc A)].map (DL.delta-map q))
      =< ap (\ a -> DL.eps (TR.RIm[Mt,Mt,CJ.to-iso a].map (DL.delta-map q))) (SP.De.beta A) >
     DL.eps (TR.RIm[Mt,Mt,CJ.to-iso (SP.act A)].map (DL.delta-map q))
      =< P1.ap (AP.RI Mt) PQ.Pn DL.eps _ _ (OfA[A].tri-RI q) >
     DL.eps (DL.delta-map (OfA[A].amap q))
      =< DL.eps-delta (OfA[A].amap q) >
     OfA[A].amap q
      =< ap (\ a -> a.1 q) (sym (APG.D.beta A)) >
     (APG.aut-of (APG.QP.inc A)).1 q }) p ;
 -- Omega RI at sip (alpha p), on delta[q]
 omega (p : APG.PGL) (q : PQ.Pn) :
  Id (AP.RI Mt) (TR.coeRI Mt Mt (TR.AS.sip Mt Mt (SP.iso-of p)) (DL.delta-map q)) (DL.delta-map ((APG.aut-of p).1 q)) =
  P1.trans (AP.RI Mt) (TR.coeRI Mt Mt (TR.AS.sip Mt Mt (SP.iso-of p)) (DL.delta-map q))
   (TR.RIm[Mt,Mt,SP.iso-of p].map (DL.delta-map q)) (DL.delta-map ((APG.aut-of p).1 q))
   (TR.transport Mt Mt (SP.iso-of p) (DL.delta-map q))
   (P1.trans (AP.RI Mt) (TR.RIm[Mt,Mt,SP.iso-of p].map (DL.delta-map q))
     (DL.delta-map (DL.eps (TR.RIm[Mt,Mt,SP.iso-of p].map (DL.delta-map q)))) (DL.delta-map ((APG.aut-of p).1 q))
     (P1.sym (AP.RI Mt) (DL.delta-map (DL.eps (TR.RIm[Mt,Mt,SP.iso-of p].map (DL.delta-map q))))
       (TR.RIm[Mt,Mt,SP.iso-of p].map (DL.delta-map q)) (DL.delta-eps (TR.RIm[Mt,Mt,SP.iso-of p].map (DL.delta-map q))))
     (P1.ap PQ.Pn (AP.RI Mt) DL.delta-map (DL.eps (TR.RIm[Mt,Mt,SP.iso-of p].map (DL.delta-map q))) ((APG.aut-of p).1 q)
       (tri p q))) ;
} ;
