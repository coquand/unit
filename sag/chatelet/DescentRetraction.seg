-- Transfer finite-free left-inverse descent along an ambient frame.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : [j] SheafClosure[l,j].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module DF = DescentFrames[l].Over[R,setR,axioms.loc] ;
 module Map (M : MD.Module) (r : Nat) (f : (DL.Free r).M -> M.M)
  (fa : (u v : (DL.Free r).M) -> Id M.M (f ((DL.Free r).madd u v)) (M.madd (f u) (f v)))
  (fs : (a : R.R) (v : (DL.Free r).M) -> Id M.M (f ((DL.Free r).sm a v)) (M.sm a (f v))) {
  V : MD.Module = DL.Free r ;
  Retraction : U l = (g : M.M -> V.M) *
   ((u v : M.M) -> Id V.M (g (M.madd u v)) (V.madd (g u) (g v))) *
   ((a : R.R) (v : M.M) -> Id V.M (g (M.sm a v)) (V.sm a (g v))) *
   ((v : V.M) -> Id V.M (g (f v)) v) ;
  module Ambient (m : Nat) (b : DL.On[M].Frame m) {
   W : MD.Module = DL.Free m ;
   a : W.M -> M.M = DL.On[M].lin m b.1 ;
   aa (u v : W.M) : Id M.M (a (W.madd u v)) (M.madd (a u) (a v)) = DL.On[M].lin-add m b.1 u v ;
   ascale (s : R.R) (v : W.M) : Id M.M (a (W.sm s v)) (M.sm s (a v)) = DL.On[M].lin-scale m b.1 s v ;
   module I = DF.Inverse[W,M,a,aa,ascale,b.2] ;
   coordinates (v : V.M) : W.M = I.inverse (f v) ;
   add (u v : V.M) : Id W.M (coordinates (V.madd u v)) (W.madd (coordinates u) (coordinates v)) =
    trans (ap I.inverse (fa u v)) (I.inverse-add (f u) (f v)) ;
   scale (s : R.R) (v : V.M) : Id W.M (coordinates (V.sm s v)) (W.sm s (coordinates v)) =
    trans (ap I.inverse (fs s v)) (I.inverse-scale s (f v)) ;
   module LI = DescentLeftInverse[l].Over[R,setR,axioms,sh].Map[r,m,coordinates,add,scale] ;
   to (z : Retraction) : LI.Retraction =
    (\ v -> z.1 (a v),
     \ u v -> trans (ap z.1 (aa u v)) (z.2.1 (a u) (a v)),
     \ s v -> trans (ap z.1 (ascale s v)) (z.2.2.1 s (a v)),
     \ v -> trans (ap z.1 (b.2.sec-eq (f v))) (z.2.2.2 v)) ;
   from (z : LI.Retraction) : Retraction =
    (\ x -> z.1 (I.inverse x),
     \ x y -> trans (ap z.1 (I.inverse-add x y)) (z.2.1 (I.inverse x) (I.inverse y)),
     \ s x -> trans (ap z.1 (I.inverse-scale s x)) (z.2.2.1 s (I.inverse x)),
     z.2.2.2) ;
   local-coordinates (local : (sh @l).close Retraction) : (sh @l).close LI.Retraction =
    (sh @l).elim @l Retraction ((sh @l).close LI.Retraction)
     ((sh @l).proposition LI.Retraction) ((sh @l).modal LI.Retraction)
     (\ z -> (sh @l).inc LI.Retraction (to z)) local ;
   theorem (local : (sh @l).close Retraction) : Tr.Trunc[Retraction].carrier =
    TC.map LI.Retraction Retraction from (LI.theorem (local-coordinates local)) ;
  } ;
  theorem (local : (sh @l).close Retraction)
   (free : Tr.Trunc[(m : Nat) * DL.On[M].Frame m].carrier) : Tr.Trunc[Retraction].carrier =
   TC.bind ((m : Nat) * DL.On[M].Frame m) Retraction (\ b -> Ambient[b.1,b.2].theorem local) free ;
  opaque theorem ;
 } ;
} ;
