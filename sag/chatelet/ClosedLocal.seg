-- SAG 4.1.4, local stage. Pointwise closed subtypes admit finite
-- equations on a finite unimodular standard-open cover.
-- All chosen local algebras remain inside propositional truncation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
high-empty (B : Fin zero -> U l+) : (i : Fin zero) -> B i = split { } ;
high-section (n : Nat) (B : Fin (suc n) -> U l+)
 (old : (i : Fin n) -> B (inl i)) (last : B (inr tt)) : (i : Fin (suc n)) -> B i = split {
 inl i -> old i ;
 inr t -> Hi.subst Top (\ u -> B (inr u)) tt t (AffineFinite[l].top-eq tt t) last } ;
high-choice : (n : Nat) (B : Fin n -> U l+) ->
 ((i : Fin n) -> Tr1.Trunc[B i].carrier) -> Tr1.Trunc[(i : Fin n) -> B i].carrier = split {
 zero -> \ B h -> Tr1.Trunc[(i : Fin zero) -> B i].inc (high-empty B) ;
 suc n | ih -> \ B h ->
  Tr1.Trunc[(i : Fin n) -> B (inl i)].induction @(l+)
   (\ t -> Tr1.Trunc[(i : Fin (suc n)) -> B i].carrier)
   (\ t -> Tr1.Trunc[(i : Fin (suc n)) -> B i].proposition)
   (\ old -> Tr1.Trunc[B (inr tt)].induction @(l+)
    (\ t -> Tr1.Trunc[(i : Fin (suc n)) -> B i].carrier)
    (\ t -> Tr1.Trunc[(i : Fin (suc n)) -> B i].proposition)
    (\ last -> Tr1.Trunc[(i : Fin (suc n)) -> B i].inc (high-section n B old last)) (h (inr tt)))
   (ih (\ i -> B (inl i)) (\ i -> h (inl i))) } ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module Cl = ClosedProp[l].Over[R,setR] ;
 module Pad = ClosedLocalPad[l].Over[R,setR] ;
 restrict (A : C.Algebra) (f : A.ring.R) (loc : I.LocalizationWitness A f)
  (x : C.Spec loc.1) : C.Spec A = C.compose A loc.1 C.base x loc.2.2.1 ;
 LocalWitness (A : C.Algebra) (sub : C.Spec A -> U l) (f : A.ring.R) : U l+ =
  (loc : I.LocalizationWitness A f) * (m : Nat) * (gs : Fin m -> loc.1.ring.R) *
  ((x : C.Spec loc.1) -> Pr.Equiv (sub (restrict A f loc x)) (Cl.Zeros m (\ j -> x.1.1 (gs j)))) ;
 Witness (A : C.Algebra) (sub : C.Spec A -> U l) : U l+ =
  (n : Nat) * (fs : Fin n -> A.ring.R) * Ax.Unimodular A n fs *
  ((i : Fin n) -> LocalWitness A sub (fs i)) ;
 module SAG (axioms : Ax.Assumptions) {
  module Bnd = UniformBounded[l].Theorem[R,setR,axioms.loc.1,axioms.sqc] ;
  module At (A : C.Algebra) (fp : P.FP A) (sub : C.Spec A -> U l)
   (closed : Cl.ClosedSubtype (C.Spec A) sub) {
   module Choices (c : Ax.ChoiceData A (\ x -> Cl.Witness (sub x))) {
    n : Nat = c.1 ;
    fs : Fin n -> A.ring.R = c.2.1 ;
    module Localized (i : Fin n) (loc : I.LocalizationWitness A (fs i)) {
     spectrum : Pr.Equiv (C.Spec loc.1) (I.D A (fs i)) = I.spectrum A (fs i) loc ;
     chosen (x : C.Spec loc.1) : Cl.Witness (sub (restrict A (fs i) loc x)) =
      c.2.2.2 i (spectrum.1 x).1 (spectrum.1 x).2 ;
     lengths (x : C.Spec loc.1) : Nat = (chosen x).1 ;
     module Bound = Bnd.ForAlgebra[loc.1,loc.2.1] ;
     module Bounded (w : Bound.Goal lengths) {
      N : Nat = w.1 ;
      values (x : C.Spec loc.1) : Fin N -> R.R =
       Pad.pad (chosen x).1 N (chosen x).2.1 (w.2 x) ;
      padded (x : C.Spec loc.1) : Pr.Equiv (sub (restrict A (fs i) loc x)) (Cl.Zeros N (values x)) =
       Equivalences[l].compose _ _ _ (chosen x).2.2
        (Pad.equivalence (chosen x).1 N (chosen x).2.1 (w.2 x)) ;
      sq : Pr.isEquiv loc.1.ring.R (C.Spec loc.1 -> R.R) (C.evaluation loc.1) = axioms.sqc loc.1 loc.2.1 ;
      gs (j : Fin N) : loc.1.ring.R = sq.sec (\ x -> values x j) ;
      beta (j : Fin N) (x : C.Spec loc.1) : Id R.R (x.1.1 (gs j)) (values x j) =
       Pr.happly (C.Spec loc.1) (\ x -> R.R) _ _ (sq.sec-eq (\ x -> values x j)) x ;
      to (x : C.Spec loc.1) (u : sub (restrict A (fs i) loc x)) : Cl.Zeros N (\ j -> x.1.1 (gs j)) =
       \ j -> trans (beta j x) ((padded x).1 u j) ;
      from (x : C.Spec loc.1) (z : Cl.Zeros N (\ j -> x.1.1 (gs j))) : sub (restrict A (fs i) loc x) =
       (padded x).2.sec (\ j -> trans (sym (beta j x)) (z j)) ;
      equations (x : C.Spec loc.1) : Pr.Equiv (sub (restrict A (fs i) loc x))
       (Cl.Zeros N (\ j -> x.1.1 (gs j))) =
       (Cl.from-iff (sub (restrict A (fs i) loc x))
        (Cl.closed-prop _ (closed (restrict A (fs i) loc x))) N (\ j -> x.1.1 (gs j)) (to x) (from x)).2.2 ;
      result : LocalWitness A sub (fs i) = (loc,N,gs,equations) ;
     } ;
     result : Tr1.Trunc[LocalWitness A sub (fs i)].carrier =
      Tr.Trunc[Bound.Goal lengths].induction @(l+)
       (\ t -> Tr1.Trunc[LocalWitness A sub (fs i)].carrier)
       (\ t -> Tr1.Trunc[LocalWitness A sub (fs i)].proposition)
       (\ w -> Tr1.Trunc[LocalWitness A sub (fs i)].inc Bounded[w].result) (Bound.theorem lengths) ;
    } ;
    local (i : Fin n) : Tr1.Trunc[LocalWitness A sub (fs i)].carrier =
     Tr1.Trunc[I.LocalizationWitness A (fs i)].induction @(l+)
      (\ t -> Tr1.Trunc[LocalWitness A sub (fs i)].carrier)
      (\ t -> Tr1.Trunc[LocalWitness A sub (fs i)].proposition)
      (\ loc -> Localized[i,loc].result) (I.localize A fp (fs i)) ;
    result : Tr1.Trunc[Witness A sub].carrier =
     Tr1.Trunc[(i : Fin n) -> LocalWitness A sub (fs i)].induction @(l+)
      (\ t -> Tr1.Trunc[Witness A sub].carrier) (\ t -> Tr1.Trunc[Witness A sub].proposition)
      (\ ls -> Tr1.Trunc[Witness A sub].inc (n,fs,c.2.2.1,ls))
      (high-choice n (\ i -> LocalWitness A sub (fs i)) local) ;
   } ;
   theorem : Tr1.Trunc[Witness A sub].carrier =
    Tr.Trunc[Ax.ChoiceData A (\ x -> Cl.Witness (sub x))].induction @(l+)
     (\ t -> Tr1.Trunc[Witness A sub].carrier) (\ t -> Tr1.Trunc[Witness A sub].proposition)
     (\ c -> Choices[c].result) (axioms.zchoice A fp (\ x -> Cl.Witness (sub x)) closed) ;
  } ;
 } ;
} ;
