-- Intrinsic form of 3.3.3, for affine base types.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module SA = SmallAffine[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module Bound = UniformBounded[l].Theorem[R,setR,axioms.loc.1,axioms.sqc] ;
 Goal (X : U l) (f : X -> Nat) : U l = (N : Nat) * ((x : X) -> CB.le (f x) N) ;
 module With (X : U l) (w : SA.Witness X) (f : X -> Nat) {
  module P = SA.Presented[w.1] ;
  e : Pr.Equiv (C.Spec P.Ex.A.algebra) X =
   Equivalences[l].compose _ _ _ P.spectrum (Functions[l].inverse X (SA.Sol w.1) w.2) ;
  module B = Bound.ForAlgebra[P.Ex.A.algebra,P.Ex.finitely-presented] ;
  transfer (b : B.Goal (\ a -> f (e.1 a))) : Goal X f =
   (b.1,\ x -> Pr.subst X (\ z -> CB.le (f z) b.1) _ _ (e.2.sec-eq x) (b.2 (e.2.sec x))) ;
  theorem : Tr.Trunc[Goal X f].carrier =
   Tr.Trunc[B.Goal (\ a -> f (e.1 a))].induction @l
    (\ t -> Tr.Trunc[Goal X f].carrier) (\ t -> Tr.Trunc[Goal X f].proposition)
    (\ b -> Tr.Trunc[Goal X f].inc (transfer b)) (B.theorem (\ a -> f (e.1 a))) ;
 } ;
 small (X : U l) (aff : SA.Affine X) (f : X -> Nat) : Tr.Trunc[Goal X f].carrier =
  Tr.Trunc[SA.Witness X].induction @l
   (\ t -> Tr.Trunc[Goal X f].carrier) (\ t -> Tr.Trunc[Goal X f].proposition)
   (\ w -> With[X,w,f].theorem) aff ;
 theorem (X : U l) (aff : FA.Affine X) (f : X -> Nat) : Tr.Trunc[Goal X f].carrier =
  small X (SA.from-affine X aff) f ;
} ;
