-- Probe for sevb.pdf, Sections 2.1 and 2.4, option (B) of SEVB-INFORMAL.md:
-- right ideals as subtypes valued in sheaf propositions, so that RI(A) is a
-- sheaf without Grassmannians.  Levels: RI(A) : U l+, AZ_n : U l+,
-- SB_n : U l++.  Lemma 2.4.2 (delta : RI(M_N(R)) = P^n) is a parameter of Types
-- here; closure of sheaves under Pi and Sigma is SheafLemmas, and sheaf
-- propositions form a sheaf by lexness.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module P2 = Prelude[l++] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (I : U l) (G : I -> U l)
 (sh : [j] SheafClosure[l,j].Over[I,G].Ops) {
 module T = SheafTopology[l].Over[I,G] ;
 module S0 = SheafLemmas[l,l].Over[I,G] ;
 module S1 = SheafLemmas[l,l+].Over[I,G] ;
 module NA = NCAlgebra[l].Over[R,setR] ;
 Alg : U l+ = NA.Algebra ;
 -- being a sheaf, read one level up
 up (X : U l) (h : T.isModal @l X) : T.isModal @(l+) X = \ i ->
  struct { sec = (h i).sec ; sec-eq = (h i).sec-eq ; ret = (h i).ret ; ret-eq = (h i).ret-eq } ;

 -- sheaf propositions.  A sheaf proposition is kept as a proposition with
 -- a section of each constant map: this is a proposition (being an
 -- equivalence is not provably one here, isEquiv has no eta), and it is
 -- a retract of (X : (P : U l) * isModal P) * isProp X.1, a sheaf by
 -- lexness.
 PropT0 : U l+ = (X : (P : U l) * T.isModal @l P) * Pr.isProp X.1 ;
 modal-PropT0 : T.isModal @(l+) PropT0 =
  S1.modal-Sigma ((P : U l) * T.isModal @l P) (\ X -> Pr.isProp X.1) (sh @l).lex
   (\ X -> up (Pr.isProp X.1) (S0.modal-isProp X.1 X.2)) ;
 PropT : U l+ = (X : (P : U l) * Pr.isProp P) * ((i : I) -> (G i -> X.1) -> X.1) ;
 to-PropT0 (p : PropT) : PropT0 = ((p.1.1,S0.modal-of-sec p.1.1 p.1.2 p.2),p.1.2) ;
 of-PropT0 (q : PropT0) : PropT = ((q.1.1,q.2),\ i -> (q.1.2 i).sec) ;
 modal-PropT : T.isModal @(l+) PropT =
  S1.modal-retract PropT0 PropT to-PropT0 of-PropT0 (\ p -> refl p) modal-PropT0 ;
 -- sheaf propositions with the same inhabitants are equal
 propT-ext (p q : PropT) (to : p.1.1 -> q.1.1) (from : q.1.1 -> p.1.1) : Id PropT p q =
  P1.Sigma-eq ((P : U l) * Pr.isProp P) (\ X -> (i : I) -> (G i -> X.1) -> X.1) p.1 q.1 p.2 q.2
   (P1.Sigma-eq (U l) (\ P -> Pr.isProp P) p.1.1 q.1.1 p.1.2 q.1.2
     (UA.ua p.1.1 q.1.1 (to,Pr.qinv p.1.1 q.1.1 to from (\ b -> q.1.2 (to (from b)) b) (\ a -> p.1.2 (from (to a)) a)))
     (FL.isProp-isProp q.1.1))
   (FL.isProp-Pi I (\ i -> (G i -> q.1.1) -> q.1.1) (\ i ->
     FL.isProp-Pi (G i -> q.1.1) (\ phi -> q.1.1) (\ phi -> q.1.2))) ;
 -- right ideals
 Sub (A : Alg) : U l+ = A.A -> PropT ;
 mem (A : Alg) (S : Sub A) (x : A.A) : U l = (S x).1.1 ;
 mem-prop (A : Alg) (S : Sub A) (x : A.A) : Pr.isProp (mem A S x) = (S x).1.2 ;
 mem-modal (A : Alg) (S : Sub A) (x : A.A) : T.isModal @l (mem A S x) = S0.modal-of-sec (S x).1.1 (S x).1.2 (S x).2 ;
 Ideal (A : Alg) (S : Sub A) : U l =
  mem A S A.zero *
  ((x y : A.A) -> mem A S x -> mem A S y -> mem A S (A.add x y)) *
  ((a : R.R) (x : A.A) -> mem A S x -> mem A S (A.scale a x)) *
  ((x a : A.A) -> mem A S x -> mem A S (A.mul x a)) ;
 pair-prop (X Y : U l) (pX : Pr.isProp X) (pY : Pr.isProp Y) : Pr.isProp (X * Y) =
  Pr.isProp-Sigma X (\ u -> Y) pX (\ u -> pY) ;
 ideal-prop (A : Alg) (S : Sub A) : Pr.isProp (Ideal A S) =
  pair-prop (mem A S A.zero) (((x y : A.A) -> mem A S x -> mem A S y -> mem A S (A.add x y)) *
    ((a : R.R) (x : A.A) -> mem A S x -> mem A S (A.scale a x)) *
    ((x a : A.A) -> mem A S x -> mem A S (A.mul x a)))
   (mem-prop A S A.zero)
   (pair-prop ((x y : A.A) -> mem A S x -> mem A S y -> mem A S (A.add x y))
     (((a : R.R) (x : A.A) -> mem A S x -> mem A S (A.scale a x)) * ((x a : A.A) -> mem A S x -> mem A S (A.mul x a)))
     (FL.isProp-Pi A.A (\ x -> (y : A.A) -> mem A S x -> mem A S y -> mem A S (A.add x y)) (\ x ->
       FL.isProp-Pi A.A (\ y -> mem A S x -> mem A S y -> mem A S (A.add x y)) (\ y ->
        FL.isProp-Pi (mem A S x) (\ h -> mem A S y -> mem A S (A.add x y)) (\ h ->
         FL.isProp-Pi (mem A S y) (\ h2 -> mem A S (A.add x y)) (\ h2 -> mem-prop A S (A.add x y))))))
     (pair-prop ((a : R.R) (x : A.A) -> mem A S x -> mem A S (A.scale a x)) ((x a : A.A) -> mem A S x -> mem A S (A.mul x a))
       (FL.isProp-Pi R.R (\ a -> (x : A.A) -> mem A S x -> mem A S (A.scale a x)) (\ a ->
         FL.isProp-Pi A.A (\ x -> mem A S x -> mem A S (A.scale a x)) (\ x ->
          FL.isProp-Pi (mem A S x) (\ h -> mem A S (A.scale a x)) (\ h -> mem-prop A S (A.scale a x)))))
       (FL.isProp-Pi A.A (\ x -> (a : A.A) -> mem A S x -> mem A S (A.mul x a)) (\ x ->
         FL.isProp-Pi A.A (\ a -> mem A S x -> mem A S (A.mul x a)) (\ a ->
          FL.isProp-Pi (mem A S x) (\ h -> mem A S (A.mul x a)) (\ h -> mem-prop A S (A.mul x a))))))) ;
 -- membership conditions are sheaves
 implication (A : Alg) (S : Sub A) (x y : A.A) : T.isModal @l (mem A S x -> mem A S y) =
  S0.modal-Pi (mem A S x) (\ u -> mem A S y) (\ u -> mem-modal A S y) ;
 ideal-modal (A : Alg) (S : Sub A) : T.isModal @l (Ideal A S) =
  S0.modal-Sigma (mem A S A.zero) (\ u -> ((x y : A.A) -> mem A S x -> mem A S y -> mem A S (A.add x y)) *
    ((a : R.R) (x : A.A) -> mem A S x -> mem A S (A.scale a x)) *
    ((x a : A.A) -> mem A S x -> mem A S (A.mul x a)))
   (mem-modal A S A.zero)
   (\ u -> S0.modal-Sigma ((x y : A.A) -> mem A S x -> mem A S y -> mem A S (A.add x y))
     (\ v -> ((a : R.R) (x : A.A) -> mem A S x -> mem A S (A.scale a x)) *
       ((x a : A.A) -> mem A S x -> mem A S (A.mul x a)))
     (S0.modal-Pi A.A (\ x -> (y : A.A) -> mem A S x -> mem A S y -> mem A S (A.add x y)) (\ x ->
       S0.modal-Pi A.A (\ y -> mem A S x -> mem A S y -> mem A S (A.add x y)) (\ y ->
        S0.modal-Pi (mem A S x) (\ h -> mem A S y -> mem A S (A.add x y)) (\ h ->
         implication A S y (A.add x y)))))
     (\ v -> S0.modal-Sigma ((a : R.R) (x : A.A) -> mem A S x -> mem A S (A.scale a x))
       (\ w -> (x a : A.A) -> mem A S x -> mem A S (A.mul x a))
       (S0.modal-Pi R.R (\ a -> (x : A.A) -> mem A S x -> mem A S (A.scale a x)) (\ a ->
         S0.modal-Pi A.A (\ x -> mem A S x -> mem A S (A.scale a x)) (\ x -> implication A S x (A.scale a x))))
       (\ w -> S0.modal-Pi A.A (\ x -> (a : A.A) -> mem A S x -> mem A S (A.mul x a)) (\ x ->
         S0.modal-Pi A.A (\ a -> mem A S x -> mem A S (A.mul x a)) (\ a -> implication A S x (A.mul x a)))))) ;

 -- an ideal free of rank N = n+1 and a direct summand: a linear bijection
 -- f : R^N -> I with a linear left inverse g : A -> R^N defined on all of
 -- A (sevb's Grassmannian: frames with a left inverse).  Without g,
 -- (t) in R, with t a non-unit non-zero-divisor, would be a right ideal of
 -- M_1(R) free of rank 1.
 V : U l = Fin (suc n) -> R.R ;
 Carrier (A : Alg) (S : Sub A) : U l = (x : A.A) * mem A S x ;
 Retraction (A : Alg) (S : Sub A) (f : V -> Carrier A S) : U l =
  (g : A.A -> V) *
  ((x y : A.A) (i : Fin (suc n)) -> Id R.R (g (A.add x y) i) (R.add (g x i) (g y i))) *
  ((a : R.R) (x : A.A) (i : Fin (suc n)) -> Id R.R (g (A.scale a x) i) (R.mul a (g x i))) *
  ((v : V) (i : Fin (suc n)) -> Id R.R (g (f v).1 i) (v i)) ;
 Basis (A : Alg) (S : Sub A) : U l =
  (f : V -> Carrier A S) *
  ((v w : V) -> Id A.A (f (\ i -> R.add (v i) (w i))).1 (A.add (f v).1 (f w).1)) *
  ((a : R.R) (v : V) -> Id A.A (f (\ i -> R.mul a (v i))).1 (A.scale a (f v).1)) *
  Pr.isEquiv V (Carrier A S) f *
  Retraction A S f ;
 RI (A : Alg) : U l+ = (S : Sub A) * Ideal A S * (sh @l).close (Basis A S) ;

 -- RI(A) is a sheaf when A is
 sub-modal (A : Alg) : T.isModal @(l+) (Sub A) = S1.modal-Pi A.A (\ x -> PropT) (\ x -> modal-PropT) ;
 RI-modal (A : Alg) : T.isModal @(l+) (RI A) =
  S1.modal-Sigma (Sub A) (\ S -> Ideal A S * (sh @l).close (Basis A S)) (sub-modal A) (\ S ->
   S1.modal-Sigma (Ideal A S) (\ u -> (sh @l).close (Basis A S))
    (up (Ideal A S) (ideal-modal A S))
    (\ u -> up ((sh @l).close (Basis A S)) ((sh @l).modal (Basis A S)))) ;

 -- AZ_n and SB_n, and Lemma 2.4.3 from Lemma 2.4.2
 module Types (M : Alg) (Pn : U l) (delta : Id (U l+) (RI M) Pn) {
  AZ : U l+ = (A : Alg) * T.isModal @l A.A * (sh @(l+)).close (Id Alg A M) ;
  SB : U l++ = (X : U l+) * T.isModal @(l+) X * (sh @(l++)).close (Id (U l+) X Pn) ;
  locally (A : AZ) : (sh @(l++)).close (Id (U l+) (RI A.1) Pn) =
   (sh @(l+)).elim @(l \/ l++) (Id Alg A.1 M) ((sh @(l++)).close (Id (U l+) (RI A.1) Pn))
    ((sh @(l++)).proposition (Id (U l+) (RI A.1) Pn)) ((sh @(l++)).modal (Id (U l+) (RI A.1) Pn))
    (\ p -> (sh @(l++)).inc (Id (U l+) (RI A.1) Pn)
      (P2.trans (U l+) (RI A.1) (RI M) Pn (P2.ap Alg (U l+) RI A.1 M p) delta))
    A.2.2 ;
  lemma-2-4-3 (A : AZ) : SB = (RI A.1,RI-modal A.1,locally A) ;
 } ;
} ;
