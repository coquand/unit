-- A polynomial whose values at all units vanish has zero coefficients.
-- R[X][1/X] is finitely presented, so by SQC its elements are determined by
-- their values at points, which are the units; the localization kernel then
-- gives X^k p = 0 in R[X], hence p = 0.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module W = PolynomialPresentation[l].Over[R,setR] ;
 module RX = W.RX ;
 module X = RX.X ;
 module Raw = Poly[l].PolyR[R] ;
 module L = RawLaws[l].Laws[R] ;
 module Pow = AffinePowers[l].Over[X.ring] ;
 module LK = LocalizationKernel[l].Over[R,setR] ;
 fp : P.FP RX.algebra =
  AddVariable[l].Over[R,setR].preserves-FP C.base BasePresentation[l].Over[R,setR].finitely-presented ;
 -- a point of R[X] evaluates a polynomial at the image of X
 at-point (g : C.Hom RX.algebra C.base) (p : Raw.P) :
  Id R.R (g.1.1 (X.include p)) (Raw.ev p (g.1.1 X.variable)) =
  trans (ap g.1.1 (sym (W.eval-polynomial p)))
   (trans (P.natural W.V RX.algebra C.base g (\ v -> X.variable) (W.expression p))
    (W.eval-base (\ v -> g.1.1 X.variable) p)) ;
 shifted (p : Raw.P) : Id X.Carrier (X.include (L.shift p)) (X.mulQ X.variable (X.include p)) =
  sym (trans (X.Multiply.beta X.T p) (X.Q.relates _ _ (X.T-mul p))) ;
 step (k : Nat) (p : Raw.P) :
  Id X.Carrier (X.mulQ (Pow.power X.variable k) (X.include (L.shift p)))
   (X.mulQ (Pow.power X.variable (suc k)) (X.include p)) = calc X.Carrier {
  X.mulQ (Pow.power X.variable k) (X.include (L.shift p))
   =< ap (X.mulQ (Pow.power X.variable k)) (shifted p)
   > X.mulQ (Pow.power X.variable k) (X.mulQ X.variable (X.include p))
   =< X.mul-assoc (Pow.power X.variable k) X.variable (X.include p)
   > X.mulQ (X.mulQ (Pow.power X.variable k) X.variable) (X.include p)
   =< ap (\ t -> X.mulQ t (X.include p)) (X.mul-comm (Pow.power X.variable k) X.variable)
   > X.mulQ (Pow.power X.variable (suc k)) (X.include p) } ;
 shift-back (p : Raw.P) (h : Raw.peq (L.shift p) nil) : Raw.peq p nil = \ k -> h (suc k) ;
 power-zero : (k : Nat) (p : Raw.P) ->
  Id X.Carrier (X.mulQ (Pow.power X.variable k) (X.include p)) X.zeroQ -> Raw.peq p nil = split {
  zero -> \ p h -> X.Q.effective p nil (trans (sym (Pow.one-left (X.include p))) h) ;
  suc k | ih -> \ p h -> shift-back p (ih (L.shift p) (trans (step k p) h)) } ;
 module Vanish (p : Raw.P) (v : (x : R.R) -> RL[R].unit x -> Id R.R (Raw.ev p x) R.z) {
  module At (loc : I.LocalizationWitness RX.algebra X.variable) {
   module K = LK.At[RX.algebra,loc.1,X.variable,loc.2.2.1,loc.2.2.2] ;
   e : Pr.isEquiv loc.1.ring.R (C.Spec loc.1 -> R.R) (C.evaluation loc.1) = sqc loc.1 loc.2.1 ;
   point-unit (x : C.Spec loc.1) : RL[R].unit (x.1.1 (K.inc.1.1 X.variable)) =
    AffineRing[l].unit-map loc.1.ring R x.1 (K.inc.1.1 X.variable) loc.2.2.2.1 ;
   values (x : C.Spec loc.1) : Id R.R (x.1.1 (K.inc.1.1 (X.include p))) (x.1.1 loc.1.ring.z) =
    trans (at-point (C.compose RX.algebra loc.1 C.base x K.inc) p)
     (trans (v (x.1.1 (K.inc.1.1 X.variable)) (point-unit x)) (sym (RingHom[l].zero loc.1.ring R x.1))) ;
   vanishes : Id loc.1.ring.R (K.inc.1.1 (X.include p)) loc.1.ring.z =
    trans (sym (Pr.sec-ret _ _ (C.evaluation loc.1) e (K.inc.1.1 (X.include p))))
     (trans (ap e.sec (F.funext (C.Spec loc.1) (\ x -> R.R)
        (C.evaluation loc.1 (K.inc.1.1 (X.include p))) (C.evaluation loc.1 loc.1.ring.z) values))
      (Pr.sec-ret _ _ (C.evaluation loc.1) e loc.1.ring.z)) ;
   result : Raw.peq p nil =
    Tr.Trunc[K.Witness (X.include p)].induction @l (\ t -> Raw.peq p nil)
     (\ t -> X.peq-prop p nil) (\ w -> power-zero w.1 p w.2) (K.clear (X.include p) vanishes) ;
  } ;
  result : Raw.peq p nil =
   Tr1.Trunc[I.LocalizationWitness RX.algebra X.variable].induction @l (\ t -> Raw.peq p nil)
    (\ t -> X.peq-prop p nil) (\ loc -> At[loc].result) (I.localize RX.algebra fp X.variable) ;
 } ;
} ;
