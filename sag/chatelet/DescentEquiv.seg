-- Being an equivalence between sheaves is a sheaf proposition.
level l ;
module Pr = Prelude[l] ;
module Over (I : U l) (G : I -> U l) {
 module T = SheafTopology[l].Over[I,G] ;
 module S = SheafLemmas[l,l].Over[I,G] ;
 module At (X Y : U l) (mx : T.isModal @l X) (my : T.isModal @l Y) (f : X -> Y) {
  Sec : U l = (s : Y -> X) * ((y : Y) -> Id Y (f (s y)) y) ;
  Ret : U l = (r : Y -> X) * ((x : X) -> Id X (r (f x)) x) ;
  sec-modal : T.isModal @l Sec =
   S.modal-Sigma (Y -> X) (\ s -> (y : Y) -> Id Y (f (s y)) y)
    (S.modal-Pi Y (\ y -> X) (\ y -> mx))
    (\ s -> S.modal-Pi Y (\ y -> Id Y (f (s y)) y) (\ y -> S.modal-Id Y my (f (s y)) y)) ;
  ret-modal : T.isModal @l Ret =
   S.modal-Sigma (Y -> X) (\ r -> (x : X) -> Id X (r (f x)) x)
    (S.modal-Pi Y (\ y -> X) (\ y -> mx))
    (\ r -> S.modal-Pi X (\ x -> Id X (r (f x)) x) (\ x -> S.modal-Id X mx (r (f x)) x)) ;
  from (a : Sec * Ret) : Pr.isEquiv X Y f =
   struct { sec = a.1.1 ; sec-eq = a.1.2 ; ret = a.2.1 ; ret-eq = a.2.2 } ;
  to (e : Pr.isEquiv X Y f) : Sec * Ret = ((e.sec,e.sec-eq),(e.ret,e.ret-eq)) ;
  modal : T.isModal @l (Pr.isEquiv X Y f) =
   S.modal-retract (Sec * Ret) (Pr.isEquiv X Y f) to from (Prop331Paths[l].eta X Y f)
    (S.modal-Sigma Sec (\ s -> Ret) sec-modal (\ s -> ret-modal)) ;
  proposition : Pr.isProp (Pr.isEquiv X Y f) = Prop331Paths[l].isEquiv-prop X Y f ;
 } ;
} ;
