-- The spectrum of the concrete monic quotient is its type of roots.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module EQ = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module W = PolynomialPresentation[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module At (lower : List R.R) {
  module B = EtaleBasis[l].Over[R,setR].At[lower] ;
  module K = B.K ;
  module PF = W.For[B.f] ;
  Root : U l = PF.Root ;
  Sol : U l = P.Solutions (W.presentation B.f) C.base ;
  solutions-root (s : Sol) : Root =
   (s.1 (inr tt),trans (sym (W.eval-base s.1 B.f)) s.2.1) ;
  root-solutions (r : Root) : Sol =
   (\ v -> r.1,(trans (W.eval-base (\ v -> r.1) B.f) r.2,tt)) ;
  solutions-root-solutions (r : Root) : Id Root (solutions-root (root-solutions r)) r =
   Pr.Sigma-eq R.R (\ x -> Id R.R (W.Raw.ev B.f x) R.z) _ _ _ _ (refl r.1) (setR _ _) ;
  root-solutions-root (s : Sol) : Id Sol (root-solutions (solutions-root s)) s =
   P.solutions-ext (W.presentation B.f) C.base _ s (\ v -> ap s.1 (B.one-index v)) ;
  spec-root : Pr.Equiv (C.Spec B.A) Root =
   EQ.compose (C.Spec B.A) Sol Root (K.To[C.base].forward,K.To[C.base].universal)
    (solutions-root,Pr.qinv Sol Root solutions-root root-solutions solutions-root-solutions root-solutions-root) ;
  root-evaluation (a : B.A.ring.R) (r : Root) : R.R = (spec-root.2.sec r).1.1 a ;
  root-evaluation-iota (a : R.R) (r : Root) : Id R.R (root-evaluation (B.A.iota.1 a) r) a =
   (spec-root.2.sec r).2 a ;
  functions-root : Pr.Equiv (C.Spec B.A -> R.R) (Root -> R.R) =
   (\ h r -> h (spec-root.2.sec r),Pr.qinv (C.Spec B.A -> R.R) (Root -> R.R)
    (\ h r -> h (spec-root.2.sec r)) (\ h x -> h (spec-root.1 x))
    (\ h -> FL.funext Root (\ r -> R.R) _ h (\ r -> ap h (spec-root.2.sec-eq r)))
    (\ h -> FL.funext (C.Spec B.A) (\ x -> R.R) _ h
      (\ x -> ap h (Pr.sec-ret (C.Spec B.A) Root spec-root.1 spec-root.2 x)))) ;
  sqc-root (sqc : P.SQC) : Pr.isEquiv B.A.ring.R (Root -> R.R) root-evaluation =
   (EQ.compose B.A.ring.R (C.Spec B.A -> R.R) (Root -> R.R)
    (C.evaluation B.A,sqc B.A B.fp) functions-root).2 ;
  opaque root-evaluation ;
 } ;
 module Generator (i : ET.I) {
  module B = EtaleBasis[l].Over[R,setR].At[ET.lower i] ;
  module Positive = B.Positive[i.1,ET.coefficients-length (suc i.1) i.2] ;
  module Roots = At[ET.lower i] ;
  not-not-root (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) : Not (Not (ET.Root i)) =
   \ empty -> axioms.loc.1
    (Positive.iota-injective R.o R.z
     (trans B.A.iota.2.1
      (trans (WeakNullstellensatz[l].Over[R,setR,axioms.sqc].empty-collapse B.A B.fp
        (\ x -> empty (Roots.spec-root.1 x)))
       (sym (RingHom[l].zero R B.A.ring B.A.iota))))) ;
 } ;
} ;
