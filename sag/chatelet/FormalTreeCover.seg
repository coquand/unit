-- Finite radical/unit covers carrying arbitrary data at their leaves.
level l ; open Ring[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module T = FormalMonoidTree[l].Over[A,setA] ; open T ;
 module Tr = Truncation[l] ;
 module For (P : T.State -> U l) {
  Leaves : T.Tree -> T.State -> U l = split {
   leaf -> \ state -> P state ;
   branch a left right | il ir -> \ state -> il (T.radical state a) * ir (T.invert state a) } ;
  Witness (state : T.State) : U l = (tree : T.Tree) * Leaves tree state ;
  Cover (state : T.State) : U l = Tr.Trunc[Witness state].carrier ;
  immediate (state : T.State) (p : P state) : Cover state =
   Tr.Trunc[Witness state].inc (leaf,p) ;
  join (state : T.State) (a : A.R) (left : Cover (T.radical state a)) (right : Cover (T.invert state a)) :
   Cover state =
   Tr.Trunc[Witness (T.radical state a)].induction @l
    (\ x -> Cover state) (\ x -> Tr.Trunc[Witness state].proposition)
    (\ x -> Tr.Trunc[Witness (T.invert state a)].induction @l
     (\ y -> Cover state) (\ y -> Tr.Trunc[Witness state].proposition)
     (\ y -> Tr.Trunc[Witness state].inc (branch a x.1 y.1,(x.2,y.2))) right) left ;
 } ;
 module Map (P Q : T.State -> U l) (f : (state : T.State) -> P state -> Q state) {
  module Source = For[P] ; module Target = For[Q] ;
  leaves : (tree : T.Tree) (state : T.State) -> Source.Leaves tree state -> Target.Leaves tree state = split {
   leaf -> f ;
   branch a left right | il ir -> \ state w ->
    (il (T.radical state a) w.1,ir (T.invert state a) w.2) } ;
  map (state : T.State) : Source.Cover state -> Target.Cover state =
   Tr.Trunc[Source.Witness state].induction @l
    (\ w -> Target.Cover state) (\ w -> Tr.Trunc[Target.Witness state].proposition)
    (\ w -> Tr.Trunc[Target.Witness state].inc (w.1,leaves w.1 state w.2)) ;
 } ;
 module Bind (P Q : T.State -> U l) (f : (state : T.State) -> P state -> For[Q].Cover state) {
  module Source = For[P] ; module Target = For[Q] ;
  leaves : (tree : T.Tree) (state : T.State) -> Source.Leaves tree state -> Target.Cover state = split {
   leaf -> f ;
   branch a left right | il ir -> \ state w ->
    Target.join state a (il (T.radical state a) w.1) (ir (T.invert state a) w.2) } ;
  bind (state : T.State) : Source.Cover state -> Target.Cover state =
   Tr.Trunc[Source.Witness state].induction @l
    (\ w -> Target.Cover state) (\ w -> Tr.Trunc[Target.Witness state].proposition)
    (\ w -> leaves w.1 state w.2) ;
 } ;
} ;
