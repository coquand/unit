-- The final assertion of SAG 3.1.9: a finite standard-open family
-- covers precisely when its generators generate the unit ideal.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (loc : StandardOpens[l].Over[R,setR].Locality) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module O = StandardOpens[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module Local = O.Local[loc] ;
 module At (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) {
  module AP = AffinePowers[l].Over[A.ring] ;
  module AS = FiniteIdeal[l].Sums[A.ring] ;
  Cover : U l = (x : C.Spec A) -> O.Union A n fs x ;
  one-power : (k : Nat) -> Id A.ring.R (AP.power A.ring.o k) A.ring.o = split {
   zero -> refl A.ring.o ; suc k | ih -> trans (ap (A.ring.mul A.ring.o) ih) (A.ring.mulO A.ring.o) } ;
  to-radical (w : Ax.UnimodularWitness A n fs) : O.RadicalWitness A A.ring.o n fs =
   (zero,w.1,trans (sym w.2) (sym (RL[A.ring].zl (AS.lin n fs w.1)))) ;
  cover (uni : Ax.Unimodular A n fs) : Cover = \ x ->
   Local.radical-to-inclusion A A.ring.o n fs
    (Tr.Trunc[Ax.UnimodularWitness A n fs].induction @l
     (\ t -> O.Radical A A.ring.o n fs) (\ t -> Tr.Trunc[O.RadicalWitness A A.ring.o n fs].proposition)
     (\ w -> Tr.Trunc[O.RadicalWitness A A.ring.o n fs].inc (to-radical w)) uni)
    x (Pr.subst R.R RL[R].unit R.o (x.1.1 A.ring.o) (sym x.1.2.1) (R.o,R.mulO R.o)) ;
  from-radical (w : O.RadicalWitness A A.ring.o n fs) : Ax.UnimodularWitness A n fs =
   (w.2.1,sym (trans (sym (one-power w.1)) (trans w.2.2 (RL[A.ring].zl (AS.lin n fs w.2.1))))) ;
  unimodular (sqc : P.SQC) (fp : P.FP A) (c : Cover) : Ax.Unimodular A n fs =
   Tr.Trunc[O.RadicalWitness A A.ring.o n fs].induction @l
    (\ t -> Ax.Unimodular A n fs) (\ t -> Tr.Trunc[Ax.UnimodularWitness A n fs].proposition)
    (\ w -> Tr.Trunc[Ax.UnimodularWitness A n fs].inc (from-radical w))
    (Local.SAG[sqc].inclusion-to-radical A fp A.ring.o n fs (\ x u -> c x)) ;
 } ;
} ;
