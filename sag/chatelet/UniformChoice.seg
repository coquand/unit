-- SAG 3.3.4: upwards closed, pointwise merely inhabited families
-- of natural numbers have a merely inhabited intersection.
-- Z-choice gives finitely many local sections; localization and 3.3.3
-- bound each section. Finite choice and a sum of bounds finish the proof.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module CB = CoefficientBound[l] ; module FB = FiniteBounds[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module O = StandardOpens[l].Over[R,setR] ;
 module Bnd = UniformBounded[l].Theorem[R,setR,axioms.loc.1,axioms.sqc] ;
 module At (A : C.Algebra) (fp : P.FP A) (family : C.Spec A -> Nat -> U l)
  (prop : (x : C.Spec A) (n : Nat) -> Pr.isProp (family x n))
  (up : (x : C.Spec A) (m n : Nat) -> CB.le m n -> family x m -> family x n) {
  Inhabitant (x : C.Spec A) : U l = (n : Nat) * family x n ;
  Goal : U l = (n : Nat) * ((x : C.Spec A) -> family x n) ;
  module Choices (c : Ax.ChoiceData A Inhabitant) {
   n : Nat = c.1 ;
   fs : Fin n -> A.ring.R = c.2.1 ;
   choose (i : Fin n) (x : C.Spec A) (u : RL[R].unit (x.1.1 (fs i))) : Inhabitant x = c.2.2.2 i x u ;
   LocalBound (i : Fin n) : U l =
    (N : Nat) * ((x : C.Spec A) (u : RL[R].unit (x.1.1 (fs i))) -> CB.le (choose i x u).1 N) ;
   module Localized (i : Fin n) (loc : I.LocalizationWitness A (fs i)) {
    e : Pr.Equiv (C.Spec loc.1) (I.D A (fs i)) = I.spectrum A (fs i) loc ;
    f (x : C.Spec loc.1) : Nat = (choose i (e.1 x).1 (e.1 x).2).1 ;
    module Bound = Bnd.ForAlgebra[loc.1,loc.2.1] ;
    from-bound (w : Bound.Goal f) : LocalBound i =
     (w.1,\ x u -> Pr.subst (I.D A (fs i)) (\ d -> CB.le (choose i d.1 d.2).1 w.1)
      (e.1 (e.2.sec (x,u))) (x,u) (e.2.sec-eq (x,u)) (w.2 (e.2.sec (x,u)))) ;
    result : Tr.Trunc[LocalBound i].carrier =
     Tr.Trunc[Bound.Goal f].induction @l (\ t -> Tr.Trunc[LocalBound i].carrier)
      (\ t -> Tr.Trunc[LocalBound i].proposition)
      (\ w -> Tr.Trunc[LocalBound i].inc (from-bound w)) (Bound.theorem f) ;
   } ;
   local-bound (i : Fin n) : Tr.Trunc[LocalBound i].carrier =
    Tr1.Trunc[I.LocalizationWitness A (fs i)].induction @l (\ t -> Tr.Trunc[LocalBound i].carrier)
     (\ t -> Tr.Trunc[LocalBound i].proposition)
     (\ loc -> Localized[i,loc].result) (I.localize A fp (fs i)) ;
   cover (x : C.Spec A) : O.Union A n fs x =
    AffineCovers[l].Over[R,setR,axioms.loc].At[A,n,fs].cover c.2.2.1 x ;
   module Combine (ws : (i : Fin n) -> LocalBound i) {
    N : Nat = FB.bound n (\ i -> (ws i).1) ;
    result : Goal =
     (N,\ x -> Tr.Trunc[(i : Fin n) * RL[R].unit (x.1.1 (fs i))].induction @l
      (\ t -> family x N) (\ t -> prop x N)
      (\ v -> up x (choose v.1 x v.2).1 N
       (FB.le-trans _ (ws v.1).1 N ((ws v.1).2 x v.2) (FB.bounded n (\ i -> (ws i).1) v.1))
       (choose v.1 x v.2).2) (cover x)) ;
   } ;
   result : Tr.Trunc[Goal].carrier =
    Tr.Trunc[(i : Fin n) -> LocalBound i].induction @l (\ t -> Tr.Trunc[Goal].carrier)
     (\ t -> Tr.Trunc[Goal].proposition) (\ ws -> Tr.Trunc[Goal].inc Combine[ws].result)
     (AffineFinite[l].choice n LocalBound local-bound) ;
  } ;
  theorem (inhabited : (x : C.Spec A) -> Tr.Trunc[Inhabitant x].carrier) : Tr.Trunc[Goal].carrier =
   Tr.Trunc[Ax.ChoiceData A Inhabitant].induction @l (\ t -> Tr.Trunc[Goal].carrier)
    (\ t -> Tr.Trunc[Goal].proposition) (\ c -> Choices[c].result) (axioms.zchoice A fp Inhabitant inhabited) ;
 } ;
} ;
