-- Lemma 2.4.2 of sevb.pdf: delta : P^n = RI(M_N(R)), N = n+1, for right
-- ideals as in AzumayaProbe (sheaf-valued subsets, free and split).
--
-- delta[x] = {x y^T}.  Its membership condition is that every column of X
-- is proportional to x, X_ij x_k = X_kj x_i (Col x X); for a class q it
-- is Col x X for every representative x of q, so no choice and no descent
-- are needed.  Col is an equation in R, so a sheaf when R is.
--
-- Injective: x 1^T in delta[x] makes x and x' proportional.
-- Surjective: for I with basis f : R^N = I and linear left inverse
-- g : M_N(R) -> R^N, g_t(f(e_t)) = 1, so by Loc (K1) some entry M_ab of
-- M = f(e_t) is a unit.  With c the column b of M, c y^T = M (e_b y^T)
-- is in I.  The matrices L_ji = f(e_i)_aj / c_a and M'_ij = g(c e_j^T)_i
-- satisfy L M' = 1, so M' L = 1 by (K2), which says f(e_i) = c r_i^T.
-- Hence I = delta[c].
--
-- Parameters besides AzumayaProbe's: Loc, R is a sheaf, and "finite free
-- descends" for right ideals of M_N(R) (SEVB-INFORMAL, Section 1).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module UA1 = Axioms[l+].UnivalenceLemmas[univ @(l+)] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (I : U l) (G : I -> U l)
 (sh : [j] SheafClosure[l,j].Over[I,G].Ops)
 (loc : StandardOpens[l].Over[R,setR].Locality)
 (R-modal : SheafTopology[l].Over[I,G].isModal @l R.R)
 (descends : (S : AzumayaProbe[l].Over[R,setR,n,I,G,sh].Sub (MnAlgebra[l].Over[R,setR,suc n].algebra)) ->
   (sh @l).close (AzumayaProbe[l].Over[R,setR,n,I,G,sh].Basis (MnAlgebra[l].Over[R,setR,suc n].algebra) S) ->
   Tr.Trunc[AzumayaProbe[l].Over[R,setR,n,I,G,sh].Basis (MnAlgebra[l].Over[R,setR,suc n].algebra) S].carrier) {
 module T = SheafTopology[l].Over[I,G] ;
 module S0 = SheafLemmas[l,l].Over[I,G] ;
 module AP = AzumayaProbe[l].Over[R,setR,n,I,G,sh] ;
 module MN = MnAlgebra[l].Over[R,setR,suc n] ;
 module D = MnSums[l].Over[R] ;
 module L = RL[R] ;
 module SR = FiniteIdeal[l].Sums[R] ;
 module PQ = ProjectiveQuotient[l].Over[R,setR,n] ;
 module LocL = StandardOpens[l].Over[R,setR].Local[loc] ;
 module K = MatrixLeftInverse[l].Over[R,setR,loc] ;
 Mt : AP.Alg = MN.algebra ;
 Ix : U l = Fin (suc n) ;
 Vc : U l = AP.V ;
 Mat : U l = MN.Mat ;
 t0 : Ix = inr tt ;
 cong2-R {a a1 b b1 : R.R} (p : Id R.R a a1) (q : Id R.R b b1) : Id R.R (R.add a b) (R.add a1 b1) =
  cong2 R.R R.add a a1 b b1 p q ;
 -- (a b) c = (a c) b
 swap23 (a b c : R.R) : Id R.R (R.mul (R.mul a b) c) (R.mul (R.mul a c) b) =
  trans (sym (R.mulA a b c)) (trans (ap (R.mul a) (R.mulC b c)) (R.mulA a c b)) ;
 unit-left (x y : R.R) (u : L.unit (R.mul x y)) : L.unit x =
  (R.mul y u.1,trans (R.mulA x y u.1) u.2) ;

 ------------------------------------------------------------------------
 -- columns proportional to x
 Col (x : Vc) (X : Mat) : U l = (i j k : Ix) -> Id R.R (R.mul (X i j) (x k)) (R.mul (X k j) (x i)) ;
 col-prop (x : Vc) (X : Mat) : Pr.isProp (Col x X) =
  FL.isProp-Pi Ix (\ i -> (j k : Ix) -> Id R.R (R.mul (X i j) (x k)) (R.mul (X k j) (x i))) (\ i ->
   FL.isProp-Pi Ix (\ j -> (k : Ix) -> Id R.R (R.mul (X i j) (x k)) (R.mul (X k j) (x i))) (\ j ->
    FL.isProp-Pi Ix (\ k -> Id R.R (R.mul (X i j) (x k)) (R.mul (X k j) (x i))) (\ k ->
     setR (R.mul (X i j) (x k)) (R.mul (X k j) (x i))))) ;
 col-modal (x : Vc) (X : Mat) : T.isModal @l (Col x X) =
  S0.modal-Pi Ix (\ i -> (j k : Ix) -> Id R.R (R.mul (X i j) (x k)) (R.mul (X k j) (x i))) (\ i ->
   S0.modal-Pi Ix (\ j -> (k : Ix) -> Id R.R (R.mul (X i j) (x k)) (R.mul (X k j) (x i))) (\ j ->
    S0.modal-Pi Ix (\ k -> Id R.R (R.mul (X i j) (x k)) (R.mul (X k j) (x i))) (\ k ->
     S0.modal-Id R.R R-modal (R.mul (X i j) (x k)) (R.mul (X k j) (x i))))) ;
 col-zero (x : Vc) : Col x MN.mzero = \ i j k -> trans (L.zero-mul (x k)) (sym (L.zero-mul (x i))) ;
 col-add (x : Vc) (X Y : Mat) (hX : Col x X) (hY : Col x Y) : Col x (MN.madd X Y) = \ i j k ->
  trans (L.dist-left (X i j) (Y i j) (x k))
   (trans (cong2-R (hX i j k) (hY i j k)) (sym (L.dist-left (X k j) (Y k j) (x i)))) ;
 col-scale (x : Vc) (a : R.R) (X : Mat) (hX : Col x X) : Col x (MN.mscale a X) = \ i j k ->
  trans (sym (R.mulA a (X i j) (x k))) (trans (ap (R.mul a) (hX i j k)) (R.mulA a (X k j) (x i))) ;
 col-mul (x : Vc) (X Y : Mat) (hX : Col x X) : Col x (MN.mmul X Y) = \ i j k ->
  calc R.R {
   R.mul (MN.mmul X Y i j) (x k)
    =< sym (D.sum-scale-right (x k) (suc n) (\ m -> R.mul (X i m) (Y m j))) >
   SR.sum (suc n) (\ m -> R.mul (R.mul (X i m) (Y m j)) (x k))
    =< SR.sum-cong (suc n) _ (\ m -> R.mul (R.mul (X k m) (Y m j)) (x i)) (\ m ->
        trans (swap23 (X i m) (Y m j) (x k))
         (trans (ap (\ s -> R.mul s (Y m j)) (hX i m k)) (sym (swap23 (X k m) (Y m j) (x i))))) >
   SR.sum (suc n) (\ m -> R.mul (R.mul (X k m) (Y m j)) (x i))
    =< D.sum-scale-right (x i) (suc n) (\ m -> R.mul (X k m) (Y m j)) >
   R.mul (MN.mmul X Y k j) (x i) } ;
 -- Col depends only on the class of x
 col-related (x y : PQ.Point) (r : PQ.Related x y) (X : Mat) (h : Col y.1 X) : Col x.1 X = \ i j k ->
  let { yk (m : Ix) : Id R.R (R.mul r.1.1 (x.1 m)) (y.1 m) = Pr.happly Ix (\ m1 -> R.R) _ _ r.2 m ;
        e1 (Z : R.R) (m : Ix) : Id R.R (R.mul (R.mul Z (x.1 m)) r.1.1) (R.mul Z (y.1 m)) =
         trans (sym (R.mulA Z (x.1 m) r.1.1)) (ap (R.mul Z) (trans (R.mulC (x.1 m) r.1.1) (yk m))) ; }
  in PQ.cancel (R.mul (X i j) (x.1 k)) (R.mul (X k j) (x.1 i)) r.1.1 r.1.2
   (trans (e1 (X i j) k) (trans (h i j k) (sym (e1 (X k j) i)))) ;

 ------------------------------------------------------------------------
 -- the subset delta[q]
 Memb (q : PQ.Pn) (X : Mat) : U l = (x : PQ.Point) -> Id PQ.Pn (PQ.class x) q -> Col x.1 X ;
 memb-prop (q : PQ.Pn) (X : Mat) : Pr.isProp (Memb q X) =
  FL.isProp-Pi PQ.Point (\ x -> Id PQ.Pn (PQ.class x) q -> Col x.1 X) (\ x ->
   FL.isProp-Pi (Id PQ.Pn (PQ.class x) q) (\ e -> Col x.1 X) (\ e -> col-prop x.1 X)) ;
 memb-modal (q : PQ.Pn) (X : Mat) : T.isModal @l (Memb q X) =
  S0.modal-Pi PQ.Point (\ x -> Id PQ.Pn (PQ.class x) q -> Col x.1 X) (\ x ->
   S0.modal-Pi (Id PQ.Pn (PQ.class x) q) (\ e -> Col x.1 X) (\ e -> col-modal x.1 X)) ;
 Sq (q : PQ.Pn) : AP.Sub Mt = \ X -> ((Memb q X,memb-prop q X),\ i -> (memb-modal q X i).sec) ;
 col-class (x : PQ.Point) (X : Mat) (h : Col x.1 X) : Memb (PQ.class x) X = \ x' e ->
  col-related x' x (PQ.Q.effective x' x e) X h ;
 col-of-memb (x : PQ.Point) (X : Mat) (m : Memb (PQ.class x) X) : Col x.1 X = m x (refl (PQ.class x)) ;
 ideal (q : PQ.Pn) : AP.Ideal Mt (Sq q) =
  (\ x e -> col-zero x.1,
   \ X Y hX hY x e -> col-add x.1 X Y (hX x e) (hY x e),
   \ a X hX x e -> col-scale x.1 a X (hX x e),
   \ X Y hX x e -> col-mul x.1 X Y (hX x e)) ;

 -- rank one matrices x y^T, and recovering y from a pivot of x
 outer (x y : Vc) : Mat = \ i j -> R.mul (x i) (y j) ;
 col-outer (x y : Vc) : Col x (outer x y) = \ i j k ->
  trans (swap23 (x i) (y j) (x k)) (trans (ap (\ s -> R.mul s (y j)) (R.mulC (x i) (x k))) (sym (swap23 (x k) (y j) (x i)))) ;
 row (kp : Ix) (w : R.R) (X : Mat) : Vc = \ j -> R.mul (X kp j) w ;
 outer-row (x : Vc) (kp : Ix) (u : L.unit (x kp)) (X : Mat) (h : Col x X) : Id Mat (outer x (row kp u.1 X)) X =
  MN.mat-eq (outer x (row kp u.1 X)) X (\ i j ->
   calc R.R {
    R.mul (x i) (R.mul (X kp j) u.1)
     =< R.mulA (x i) (X kp j) u.1 > R.mul (R.mul (x i) (X kp j)) u.1
     =< ap (\ s -> R.mul s u.1) (R.mulC (x i) (X kp j)) > R.mul (R.mul (X kp j) (x i)) u.1
     =< ap (\ s -> R.mul s u.1) (sym (h i j kp)) > R.mul (R.mul (X i j) (x kp)) u.1
     =< sym (R.mulA (X i j) (x kp) u.1) > R.mul (X i j) (R.mul (x kp) u.1)
     =< ap (R.mul (X i j)) u.2 > R.mul (X i j) R.o
     =< R.mulO (X i j) > X i j }) ;
 row-outer-at (x : Vc) (kp : Ix) (u : L.unit (x kp)) (y : Vc) (j : Ix) : Id R.R (row kp u.1 (outer x y) j) (y j) =
  trans (swap23 (x kp) (y j) u.1) (trans (ap (\ s -> R.mul s (y j)) u.2) (L.one-left (y j))) ;

 ------------------------------------------------------------------------
 -- the basis of delta[x] at a pivot of x
 module At (x : PQ.Point) (p : PQ.Pivots x.1) {
  kp : Ix = p.1 ;
  q : PQ.Pn = PQ.class x ;
  bf (y : Vc) : AP.Carrier Mt (Sq q) = (outer x.1 y,col-class x (outer x.1 y) (col-outer x.1 y)) ;
  bg (X : Mat) : Vc = row kp p.2.1 X ;
  bf-bg (Z : AP.Carrier Mt (Sq q)) : Id (AP.Carrier Mt (Sq q)) (bf (bg Z.1)) Z =
   Pr.Sigma-eq Mat (\ X -> Memb q X) (outer x.1 (bg Z.1)) Z.1 (bf (bg Z.1)).2 Z.2
    (outer-row x.1 kp p.2 Z.1 (col-of-memb x Z.1 Z.2)) (memb-prop q Z.1) ;
  bg-bf (y : Vc) : Id Vc (bg (bf y).1) y = PQ.vector-eq (bg (bf y).1) y (row-outer-at x.1 kp p.2 y) ;
  basis : AP.Basis Mt (Sq q) =
   (bf,
    \ v v' -> MN.mat-eq (outer x.1 (\ i -> R.add (v i) (v' i))) (MN.madd (outer x.1 v) (outer x.1 v'))
      (\ i j -> R.dist (x.1 i) (v j) (v' j)),
    \ a v -> MN.mat-eq (outer x.1 (\ i -> R.mul a (v i))) (MN.mscale a (outer x.1 v))
      (\ i j -> L.mul-swap (x.1 i) a (v j)),
    Pr.qinv Vc (AP.Carrier Mt (Sq q)) bf (\ Z -> bg Z.1) bf-bg bg-bf,
    (bg,
     \ X Y j -> L.dist-left (X kp j) (Y kp j) p.2.1,
     \ a X j -> sym (R.mulA a (X kp j) p.2.1),
     \ v j -> row-outer-at x.1 kp p.2 v j)) ;
 } ;
 basis (q : PQ.Pn) : (sh @l).close (AP.Basis Mt (Sq q)) =
  PQ.Q.induction @l (\ q1 -> (sh @l).close (AP.Basis Mt (Sq q1))) (\ q1 -> (sh @l).proposition (AP.Basis Mt (Sq q1)))
   (\ x -> Tr.Trunc[PQ.Pivots x.1].induction @l (\ t -> (sh @l).close (AP.Basis Mt (Sq (PQ.class x))))
     (\ t -> (sh @l).proposition (AP.Basis Mt (Sq (PQ.class x))))
     (\ p -> (sh @l).inc (AP.Basis Mt (Sq (PQ.class x))) At[x,p].basis) x.2) q ;
 delta-map (q : PQ.Pn) : AP.RI Mt = (Sq q,ideal q,basis q) ;

 ------------------------------------------------------------------------
 -- injectivity
 ones : Vc = \ j -> R.o ;
 inj-at (x x' : PQ.Point) (h : (X : Mat) -> Memb (PQ.class x) X -> Memb (PQ.class x') X) :
  Id PQ.Pn (PQ.class x) (PQ.class x') =
  let { cc : Col x'.1 (outer x.1 ones) =
         col-of-memb x' (outer x.1 ones) (h (outer x.1 ones) (col-class x (outer x.1 ones) (col-outer x.1 ones))) ;
        pr : PQ.Proportional x.1 x'.1 = \ i j ->
         trans (sym (ap (\ s -> R.mul s (x'.1 j)) (R.mulO (x.1 i))))
          (trans (cc i t0 j) (ap (\ s -> R.mul s (x'.1 i)) (R.mulO (x.1 j)))) ; }
  in PQ.Q.relates x x' PQ.FromProportional[x,x',pr].related ;
 Inc (q q' : PQ.Pn) : U l = (X : Mat) -> Memb q X -> Memb q' X ;
 inj-prop (q q' : PQ.Pn) : Pr.isProp (Inc q q' -> Id PQ.Pn q q') =
  FL.isProp-Pi (Inc q q') (\ h -> Id PQ.Pn q q') (\ h -> PQ.Q.set q q') ;
 inj (q q' : PQ.Pn) : Inc q q' -> Id PQ.Pn q q' =
  PQ.Q.induction @l (\ q1 -> (q2 : PQ.Pn) -> Inc q1 q2 -> Id PQ.Pn q1 q2)
   (\ q1 -> FL.isProp-Pi PQ.Pn (\ q2 -> Inc q1 q2 -> Id PQ.Pn q1 q2) (\ q2 -> inj-prop q1 q2))
   (\ x q2 -> PQ.Q.induction @l (\ q3 -> Inc (PQ.class x) q3 -> Id PQ.Pn (PQ.class x) q3)
     (\ q3 -> inj-prop (PQ.class x) q3) (\ x' -> inj-at x x') q2) q q' ;

 ------------------------------------------------------------------------
 -- linear maps into R are determined by finite sums
 module Lin (W : U l) (wz : W) (wadd : W -> W -> W) (phi : W -> R.R)
  (phi-z : Id R.R (phi wz) R.z) (phi-add : (v v' : W) -> Id R.R (phi (wadd v v')) (R.add (phi v) (phi v'))) {
  wsum : (m : Nat) -> (Fin m -> W) -> W = split {
   zero -> \ ws -> wz ;
   suc m | r -> \ ws -> wadd (ws (inr tt)) (r (\ i -> ws (inl i))) } ;
  lin-sum : (m : Nat) (ws : Fin m -> W) -> Id R.R (phi (wsum m ws)) (SR.sum m (\ i -> phi (ws i))) = split {
   zero -> \ ws -> phi-z ;
   suc m | r -> \ ws -> trans (phi-add (ws (inr tt)) (wsum m (\ i -> ws (inl i))))
     (ap (R.add (phi (ws (inr tt)))) (r (\ i -> ws (inl i)))) } ;
 } ;
 ev (j : Ix) : Vc = \ i -> D.delta (suc n) j i ;
 vzero : Vc = \ i -> R.z ;
 vadd (v v' : Vc) : Vc = \ i -> R.add (v i) (v' i) ;
 vscale (a : R.R) (v : Vc) : Vc = \ i -> R.mul a (v i) ;
 -- a linear form on R^N is sum_i z_i phi(e_i)
 module Expand (phi : Vc -> R.R)
  (phi-add : (v v' : Vc) -> Id R.R (phi (vadd v v')) (R.add (phi v) (phi v')))
  (phi-sc : (a : R.R) (v : Vc) -> Id R.R (phi (vscale a v)) (R.mul a (phi v))) {
  phi-z : Id R.R (phi vzero) R.z =
   trans (ap phi (PQ.vector-eq vzero (vscale R.z vzero) (\ i -> sym (L.zero-mul R.z))))
    (trans (phi-sc R.z vzero) (L.zero-mul (phi vzero))) ;
  module LV = Lin[Vc,vzero,vadd,phi,phi-z,phi-add] ;
  entries : (m : Nat) (ws : Fin m -> Vc) (j : Ix) -> Id R.R (LV.wsum m ws j) (SR.sum m (\ i -> ws i j)) = split {
   zero -> \ ws j -> refl R.z ;
   suc m | r -> \ ws j -> ap (R.add (ws (inr tt) j)) (r (\ i -> ws (inl i)) j) } ;
  expand (z : Vc) : Id R.R (phi z) (SR.sum (suc n) (\ i -> R.mul (z i) (phi (ev i)))) =
   trans (ap phi (PQ.vector-eq z (LV.wsum (suc n) (\ i -> vscale (z i) (ev i))) (\ j ->
     sym (trans (entries (suc n) (\ i -> vscale (z i) (ev i)) j) (D.sum-delta-right (suc n) j z)))))
    (trans (LV.lin-sum (suc n) (\ i -> vscale (z i) (ev i)))
     (SR.sum-cong (suc n) _ _ (\ i -> phi-sc (z i) (ev i)))) ;
 } ;
 -- a matrix is the sum of its rows: X = sum_p e_p (X_p)^T
 rowmat (pr : Ix) (y : Vc) : Mat = outer (ev pr) y ;
 mzero : Mat = MN.mzero ;
 module ExpandM (phi : Mat -> R.R)
  (phi-add : (X Y : Mat) -> Id R.R (phi (MN.madd X Y)) (R.add (phi X) (phi Y)))
  (phi-sc : (a : R.R) (X : Mat) -> Id R.R (phi (MN.mscale a X)) (R.mul a (phi X))) {
  phi-z : Id R.R (phi mzero) R.z =
   trans (ap phi (MN.mat-eq mzero (MN.mscale R.z mzero) (\ i j -> sym (L.zero-mul R.z))))
    (trans (phi-sc R.z mzero) (L.zero-mul (phi mzero))) ;
  module LM = Lin[Mat,mzero,MN.madd,phi,phi-z,phi-add] ;
  entries : (m : Nat) (ws : Fin m -> Mat) (i j : Ix) -> Id R.R (LM.wsum m ws i j) (SR.sum m (\ p -> ws p i j)) = split {
   zero -> \ ws i j -> refl R.z ;
   suc m | r -> \ ws i j -> ap (R.add (ws (inr tt) i j)) (r (\ p -> ws (inl p)) i j) } ;
  rows (X : Mat) : Id R.R (phi X) (SR.sum (suc n) (\ pr -> phi (rowmat pr (\ j -> X pr j)))) =
   trans (ap phi (MN.mat-eq X (LM.wsum (suc n) (\ pr -> rowmat pr (\ j -> X pr j))) (\ i j ->
     sym (trans (entries (suc n) (\ pr -> rowmat pr (\ j1 -> X pr j1)) i j)
      (trans (SR.sum-cong (suc n) (\ pr -> R.mul (D.delta (suc n) pr i) (X pr j)) (\ pr -> R.mul (D.delta (suc n) i pr) (X pr j))
        (\ pr -> ap (\ s -> R.mul s (X pr j)) (D.delta-sym (suc n) pr i)))
       (D.sum-delta (suc n) i (\ pr -> X pr j)))))))
    (LM.lin-sum (suc n) (\ pr -> rowmat pr (\ j -> X pr j))) ;
 } ;

 ------------------------------------------------------------------------
 -- surjectivity
 Fib (J : AP.RI Mt) : U l = (q : PQ.Pn) *
  ((X : Mat) -> Memb q X -> AP.mem Mt J.1 X) * ((X : Mat) -> AP.mem Mt J.1 X -> Memb q X) ;
 fib-prop (J : AP.RI Mt) : Pr.isProp (Fib J) = \ u v ->
  Pr.Sigma-eq PQ.Pn (\ q -> ((X : Mat) -> Memb q X -> AP.mem Mt J.1 X) * ((X : Mat) -> AP.mem Mt J.1 X -> Memb q X))
   u.1 v.1 u.2 v.2 (inj u.1 v.1 (\ X m -> v.2.2 X (u.2.1 X m)))
   (AP.pair-prop ((X : Mat) -> Memb v.1 X -> AP.mem Mt J.1 X) ((X : Mat) -> AP.mem Mt J.1 X -> Memb v.1 X)
     (FL.isProp-Pi Mat (\ X -> Memb v.1 X -> AP.mem Mt J.1 X) (\ X ->
       FL.isProp-Pi (Memb v.1 X) (\ m -> AP.mem Mt J.1 X) (\ m -> AP.mem-prop Mt J.1 X)))
     (FL.isProp-Pi Mat (\ X -> AP.mem Mt J.1 X -> Memb v.1 X) (\ X ->
       FL.isProp-Pi (AP.mem Mt J.1 X) (\ m -> Memb v.1 X) (\ m -> memb-prop v.1 X)))) ;
 module Surj (J : AP.RI Mt) (b : AP.Basis Mt J.1) {
  Sj : AP.Sub Mt = J.1 ;
  F (v : Vc) : Mat = (b.1 v).1 ;
  feq : Pr.isEquiv Vc (AP.Carrier Mt Sj) b.1 = b.2.2.2.1 ;
  g (X : Mat) : Vc = b.2.2.2.2.1 X ;
  gf (v : Vc) : Id Vc (g (F v)) v = PQ.vector-eq (g (F v)) v (b.2.2.2.2.2.2.2 v) ;
  -- f (g Z) = Z on members
  fg (Z : Mat) (m : AP.mem Mt Sj Z) : Id Mat (F (g Z)) Z =
   let { zz : Vc = feq.sec (Z,m) ;
         Fz : Id Mat (F zz) Z = ap (\ c -> c.1) (feq.sec-eq (Z,m)) ; }
   in trans (ap F (trans (ap g (sym Fz)) (gf zz))) Fz ;
  -- entries of F and of g are linear
  module EF (a j : Ix) { module E = Expand[\ v -> F v a j,
   \ v v' -> ap (\ X -> X a j) (b.2.1 v v'),
   \ c v -> ap (\ X -> X a j) (b.2.2.1 c v)] ; } ;
  M0 : Mat = F (ev t0) ;
  -- (K1): some entry of M0 is a unit
  module G0 = ExpandM[\ X -> g X t0, \ X Y -> b.2.2.2.2.2.1 X Y t0, \ c X -> b.2.2.2.2.2.2.1 c X t0] ;
  module GR (pr : Ix) { module E = Expand[\ y -> g (rowmat pr y) t0,
   \ v v' -> trans (ap (\ X -> g X t0) (MN.mat-eq (rowmat pr (vadd v v')) (MN.madd (rowmat pr v) (rowmat pr v'))
      (\ i j -> R.dist (ev pr i) (v j) (v' j)))) (b.2.2.2.2.2.1 (rowmat pr v) (rowmat pr v') t0),
   \ c v -> trans (ap (\ X -> g X t0) (MN.mat-eq (rowmat pr (vscale c v)) (MN.mscale c (rowmat pr v))
      (\ i j -> L.mul-swap (ev pr i) c (v j)))) (b.2.2.2.2.2.2.1 c (rowmat pr v) t0)] ; } ;
  lam (pr q : Ix) : R.R = g (rowmat pr (ev q)) t0 ;
  one-sum : Id R.R (SR.sum (suc n) (\ pr -> SR.sum (suc n) (\ q -> R.mul (M0 pr q) (lam pr q)))) R.o =
   trans (sym (SR.sum-cong (suc n) _ _ (\ pr -> GR[pr].E.expand (\ j -> M0 pr j))))
    (trans (sym (G0.rows M0)) (b.2.2.2.2.2.2.2 (ev t0) t0)) ;
  Entry : U l = (pa : Ix) * (pb : Ix) * L.unit (M0 pa pb) ;
  entry : Tr.Trunc[Entry].carrier =
   Tr.Trunc[(pr : Ix) * L.unit (SR.sum (suc n) (\ q -> R.mul (M0 pr q) (lam pr q)))].induction @l
    (\ t -> Tr.Trunc[Entry].carrier) (\ t -> Tr.Trunc[Entry].proposition)
    (\ w -> Tr.Trunc[(q : Ix) * L.unit (R.mul (M0 w.1 q) (lam w.1 q))].induction @l
      (\ t -> Tr.Trunc[Entry].carrier) (\ t -> Tr.Trunc[Entry].proposition)
      (\ w2 -> Tr.Trunc[Entry].inc (w.1,w2.1,unit-left (M0 w.1 w2.1) (lam w.1 w2.1) w2.2))
      (LocL.finite-unit (suc n) (\ q -> R.mul (M0 w.1 q) (lam w.1 q)) w.2))
    (LocL.finite-unit (suc n) (\ pr -> SR.sum (suc n) (\ q -> R.mul (M0 pr q) (lam pr q)))
      (K.unit-one _ one-sum)) ;
  -- with the pivot M0_ab: c = column b of M0, and I = delta[c]
  module Piv (pa pb : Ix) (u : L.unit (M0 pa pb)) {
   c : Vc = \ i -> M0 i pb ;
   w : R.R = u.1 ;
   cP : PQ.Point = (c,Tr.Trunc[PQ.Pivots c].inc (pa,u)) ;
   ymat (y : Vc) : Mat = \ m j -> R.mul (D.delta (suc n) pb m) (y j) ;
   prod (y : Vc) : Id Mat (MN.mmul M0 (ymat y)) (outer c y) = MN.mat-eq (MN.mmul M0 (ymat y)) (outer c y) (\ i j ->
    trans (SR.sum-cong (suc n) (\ m -> R.mul (M0 i m) (R.mul (D.delta (suc n) pb m) (y j)))
      (\ m -> R.mul (R.mul (M0 i m) (y j)) (D.delta (suc n) m pb)) (\ m ->
      trans (ap (R.mul (M0 i m)) (trans (R.mulC (D.delta (suc n) pb m) (y j))
        (ap (R.mul (y j)) (D.delta-sym (suc n) pb m))))
       (R.mulA (M0 i m) (y j) (D.delta (suc n) m pb))))
     (D.sum-delta-right (suc n) pb (\ m -> R.mul (M0 i m) (y j)))) ;
   outer-mem (y : Vc) : AP.mem Mt Sj (outer c y) =
    Pr.subst Mat (\ X -> AP.mem Mt Sj X) (MN.mmul M0 (ymat y)) (outer c y) (prod y)
     (J.2.1.2.2.2 M0 (ymat y) (b.1 (ev t0)).2) ;
   -- (K2)
   Mm : Mat = \ i j -> g (outer c (ev j)) i ;
   Lm : Mat = \ j i -> R.mul (F (ev i) pa j) w ;
   module EG (i : Ix) { module E = Expand[\ y -> g (outer c y) i,
    \ v v' -> trans (ap (\ X -> g X i) (MN.mat-eq (outer c (vadd v v')) (MN.madd (outer c v) (outer c v'))
       (\ i1 j -> R.dist (c i1) (v j) (v' j)))) (b.2.2.2.2.2.1 (outer c v) (outer c v') i),
    \ a v -> trans (ap (\ X -> g X i) (MN.mat-eq (outer c (vscale a v)) (MN.mscale a (outer c v))
       (\ i1 j -> L.mul-swap (c i1) a (v j)))) (b.2.2.2.2.2.2.1 a (outer c v) i)] ; } ;
   wc : Id R.R (R.mul w (c pa)) R.o = trans (R.mulC w (c pa)) u.2 ;
   LM : Id Mat (MN.mmul Lm Mm) MN.mone = MN.mat-eq (MN.mmul Lm Mm) MN.mone (\ j j' ->
    calc R.R {
     SR.sum (suc n) (\ i -> R.mul (R.mul (F (ev i) pa j) w) (Mm i j'))
      =< SR.sum-cong (suc n) _ (\ i -> R.mul w (R.mul (Mm i j') (F (ev i) pa j))) (\ i ->
          trans (ap (\ s -> R.mul s (Mm i j')) (R.mulC (F (ev i) pa j) w))
           (trans (sym (R.mulA w (F (ev i) pa j) (Mm i j'))) (ap (R.mul w) (R.mulC (F (ev i) pa j) (Mm i j'))))) >
     SR.sum (suc n) (\ i -> R.mul w (R.mul (Mm i j') (F (ev i) pa j)))
      =< SR.sum-scale w (suc n) (\ i -> R.mul (Mm i j') (F (ev i) pa j)) >
     R.mul w (SR.sum (suc n) (\ i -> R.mul (Mm i j') (F (ev i) pa j)))
      =< ap (R.mul w) (sym (EF[pa,j].E.expand (g (outer c (ev j'))))) >
     R.mul w (F (g (outer c (ev j'))) pa j)
      =< ap (\ X -> R.mul w (X pa j)) (fg (outer c (ev j')) (outer-mem (ev j'))) >
     R.mul w (R.mul (c pa) (D.delta (suc n) j' j))
      =< R.mulA w (c pa) (D.delta (suc n) j' j) >
     R.mul (R.mul w (c pa)) (D.delta (suc n) j' j)
      =< ap (\ s -> R.mul s (D.delta (suc n) j' j)) wc >
     R.mul R.o (D.delta (suc n) j' j)
      =< L.one-left (D.delta (suc n) j' j) >
     D.delta (suc n) j' j
      =< D.delta-sym (suc n) j' j >
     D.delta (suc n) j j' }) ;
   ML : Id Mat (MN.mmul Mm Lm) MN.mone = K.k2 (suc n) Lm Mm LM ;
   -- f(e_i) = c r_i^T
   r (i' : Ix) : Vc = \ j -> Lm j i' ;
   g-outer-r (i' : Ix) : Id Vc (g (outer c (r i'))) (ev i') = PQ.vector-eq (g (outer c (r i'))) (ev i') (\ i ->
    trans (EG[i].E.expand (r i'))
     (trans (SR.sum-cong (suc n) _ (\ j -> R.mul (Mm i j) (Lm j i')) (\ j -> R.mulC (r i' j) (Mm i j)))
      (trans (ap (\ X -> X i i') ML) (D.delta-sym (suc n) i i')))) ;
   F-ev (i' : Ix) : Id Mat (F (ev i')) (outer c (r i')) =
    trans (ap F (sym (g-outer-r i'))) (fg (outer c (r i')) (outer-mem (r i'))) ;
   F-col (z : Vc) : Col c (F z) =
    let { s (j : Ix) : R.R = SR.sum (suc n) (\ i' -> R.mul (z i') (r i' j)) ;
          eq : Id Mat (F z) (outer c s) = MN.mat-eq (F z) (outer c s) (\ i j ->
           trans (EF[i,j].E.expand z)
            (trans (SR.sum-cong (suc n) _ (\ i' -> R.mul (c i) (R.mul (z i') (r i' j))) (\ i' ->
               trans (ap (R.mul (z i')) (ap (\ X -> X i j) (F-ev i'))) (L.mul-swap (z i') (c i) (r i' j))))
             (SR.sum-scale (c i) (suc n) (\ i' -> R.mul (z i') (r i' j))))) ; }
    in Pr.subst Mat (Col c) (outer c s) (F z) (sym eq) (col-outer c s) ;
   fib : Fib J =
    (PQ.class cP,
     \ X m -> Pr.subst Mat (\ Y -> AP.mem Mt Sj Y) (outer c (row pa w X)) X
       (outer-row c pa u X (col-of-memb cP X m)) (outer-mem (row pa w X)),
     \ X m -> col-class cP X (Pr.subst Mat (Col c) (F (g X)) X (fg X m) (F-col (g X)))) ;
  } ;
  fib : Fib J = Tr.Trunc[Entry].induction @l (\ t -> Fib J) (\ t -> fib-prop J) (\ e -> Piv[e.1,e.2.1,e.2.2].fib) entry ;
 } ;
 fib-point (J : AP.RI Mt) : Fib J =
  Tr.Trunc[AP.Basis Mt J.1].induction @l (\ t -> Fib J) (\ t -> fib-prop J) (\ bs -> Surj[J,bs].fib) (descends J.1 J.2.2) ;

 ------------------------------------------------------------------------
 -- delta is an equivalence
 eps (J : AP.RI Mt) : PQ.Pn = (fib-point J).1 ;
 eps-delta (q : PQ.Pn) : Id PQ.Pn (eps (delta-map q)) q =
  inj (eps (delta-map q)) q (\ X m -> (fib-point (delta-map q)).2.1 X m) ;
 delta-eps (J : AP.RI Mt) : Id (AP.RI Mt) (delta-map (eps J)) J =
  P1.Sigma-eq (AP.Sub Mt) (\ S -> AP.Ideal Mt S * (sh @l).close (AP.Basis Mt S))
   (Sq (eps J)) J.1 (ideal (eps J),basis (eps J)) J.2
   (FL1.funext Mat (\ X -> AP.PropT) (Sq (eps J)) J.1 (\ X ->
     AP.propT-ext (Sq (eps J) X) (J.1 X) ((fib-point J).2.1 X) ((fib-point J).2.2 X)))
   (AP.pair-prop (AP.Ideal Mt J.1) ((sh @l).close (AP.Basis Mt J.1))
     (AP.ideal-prop Mt J.1) ((sh @l).proposition (AP.Basis Mt J.1))) ;
 delta : Id (U l+) (AP.RI Mt) PQ.Pn =
  UA1.ua (AP.RI Mt) PQ.Pn (eps,P1.qinv (AP.RI Mt) PQ.Pn eps delta-map eps-delta delta-eps) ;
 -- Lemma 2.4.3
 module Ty = AP.Types[Mt,PQ.Pn,delta] ;
 lemma-2-4-3 (A : Ty.AZ) : Ty.SB = Ty.lemma-2-4-3 A ;
} ;
