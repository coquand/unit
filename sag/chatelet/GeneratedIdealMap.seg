-- Transport finite ideal certificates along a ring map.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A B : CRing) (phi : RingHom[l].Hom A B) (n : Nat)
 (fs : Fin n -> A.R) (gs : Fin n -> B.R)
 (generators : (i : Fin n) -> Id B.R (phi.1 (fs i)) (gs i)) {
 module GA = GeneratedIdeal[l].Over[A,n,fs] ;
 module GB = GeneratedIdeal[l].Over[B,n,gs] ;
 module SA = FiniteIdeal[l].Sums[A] ;
 module SB = FiniteIdeal[l].Sums[B] ;
 module Map = StandardOpens[l].SumMap[A,B,phi] ;
 certificate (a : A.R) (w : GA.Witness a) : GB.Witness (phi.1 a) =
  ((\ i -> phi.1 (w.1 i)),
   trans (ap phi.1 w.2)
    (trans (phi.2.2.1 A.z (SA.lin n fs w.1))
     (trans (ap (\ z -> B.add z (phi.1 (SA.lin n fs w.1))) (RingHom[l].zero A B phi))
      (ap (B.add B.z) (trans (Map.combination n fs w.1)
       (SB.sum-cong n (\ i -> B.mul (phi.1 (fs i)) (phi.1 (w.1 i)))
        (\ i -> B.mul (gs i) (phi.1 (w.1 i)))
        (\ i -> ap (\ c -> B.mul c (phi.1 (w.1 i))) (generators i)))))))) ;
 member (a : A.R) : GA.Member a -> GB.Member (phi.1 a) =
  Truncation[l].Trunc[GA.Witness a].induction @l
   (\ w -> GB.Member (phi.1 a)) (\ w -> GB.proposition (phi.1 a))
   (\ w -> Truncation[l].Trunc[GB.Witness (phi.1 a)].inc (certificate a w)) ;
} ;
