-- First half of Lemma 7.6: lift generation modulo a kernel to equations
-- y_i = h*a_i + sum_j b_ij*y_j with all b_ij in that kernel.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A C : CRing) (phi : RingHom[l].Hom A C) {
 open A ; open RL[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module M = RankOneProjector[l].Over[A] ;
 module RA = Regularity[l].Over[A] ;
 module RC = Regularity[l].Over[C] ;
 module At (n : Nat) (e : M.Size[n].Matrix) (t : R)
  (regular : RA.Regular t) (residue-regular : RC.Regular (phi.1 t))
  (w : M.Size[n].ScalarFactor e t) (h : R) (hc : M.Size[n].Vector)
  (h-generated : Id R (S.lin n w.2.1 hc) h)
  (a : M.Size[n].Vector)
  (reduced-generation : (i : Fin n) -> Id C.R (phi.1 (w.2.1 i)) (phi.1 (mul h (a i)))) {
  module Sat = DivisorSaturation[l].Over[A,C,phi].At[n,e,t,regular,residue-regular,w] ;
  module CR = RL[C] ;
  y : M.Size[n].Vector = w.2.1 ;
  module Generator (i : Fin n) {
   singleton : S.Coordinates n y (y i) = S.coordinates n y i ;
   p : R = add (y i) (neg (mul h (a i))) ;
   c (j : Fin n) : R = add (singleton.1 j) (neg (mul (a i) (hc j))) ;
   generated : Id R (S.lin n y c) p =
    trans (S.lin-add n y singleton.1 (\ j -> neg (mul (a i) (hc j))))
     (cong2 R add _ _ _ _ singleton.2
      (trans (S.lin-neg n y (\ j -> mul (a i) (hc j)))
       (ap neg (trans (S.lin-scale n y hc (a i))
        (trans (ap (mul (a i)) h-generated) (mulC (a i) h)))))) ;
   zero-p : Id C.R (phi.1 p) C.z =
    trans (phi.2.2.1 (y i) (neg (mul h (a i))))
     (trans (ap (C.add (phi.1 (y i))) (RingHom[l].negation A C phi (mul h (a i))))
      (trans (ap (\ c -> C.add c (C.neg (phi.1 (mul h (a i))))) (reduced-generation i))
       (C.addN (phi.1 (mul h (a i)))))) ;
   module E = Sat.Element[p,c,generated] ;
   equation : Id R (y i) (add (mul h (a i)) (S.lin n y E.q)) =
    sym (trans (ap (add (mul h (a i))) E.reconstruct)
     (trans (addC (mul h (a i)) p)
      (trans (sym (addA (y i) (neg (mul h (a i))) (mul h (a i))))
       (trans (ap (add (y i)) (trans (addC (neg (mul h (a i))) (mul h (a i))) (addN (mul h (a i)))))
        (addZ (y i)))))) ;
  } ;
  coefficients (i j : Fin n) : R = Generator[i].E.q j ;
  equations (i : Fin n) :
   Id R (y i) (add (mul h (a i)) (S.lin n y (coefficients i))) = Generator[i].equation ;
  kernel (i j : Fin n) : Id C.R (phi.1 (coefficients i j)) C.z =
   Generator[i].E.coefficient-kernel Generator[i].zero-p j ;
 } ;
} ;
