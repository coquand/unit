-- Enumeration of a rectangular finite family, with its finite-sum formula.
level l ; open Ring[l] ; open Presentations[l] ;
module FS = FinSum[l] ;
size : Nat -> Nat -> Nat = split {
 zero -> \ m -> zero ;
 suc n | ih -> \ m -> plus m (ih m) } ;
Pair (n m : Nat) : U l = (i : Fin n) * Fin m ;
decode : (n m : Nat) -> Fin (size n m) -> Pair n m = split {
 zero -> \ m i -> efq i ;
 suc n | ih -> \ m ->
  FS.cases (size n m) (Pair (suc n) m)
   (\ u -> (inl (ih m u).1,(ih m u).2)) m (\ j -> (inr tt,j)) } ;
encode : (n m : Nat) -> Fin n -> Fin m -> Fin (size n m) = split {
 zero -> \ m i j -> efq i ;
 suc n | ih -> \ m -> split {
  inl i -> \ j -> FS.left (size n m) m (ih m i j) ;
  inr t -> \ j -> FS.right (size n m) m j } } ;
decode-encode : (n m : Nat) (i : Fin n) (j : Fin m) ->
 Id (Pair n m) (decode n m (encode n m i j)) (i,j) = split {
 zero -> \ m i j -> efq i ;
 suc n | ih -> \ m -> split {
  inl i -> \ j ->
   trans (FS.cases-left (size n m) (Pair (suc n) m)
     (\ u -> (inl (decode n m u).1,(decode n m u).2)) m (\ j -> (inr tt,j))
     (encode n m i j))
    (ap (\ p -> (inl p.1,p.2)) (ih m i j)) ;
  inr t -> \ j ->
   trans (FS.cases-right (size n m) (Pair (suc n) m)
     (\ u -> (inl (decode n m u).1,(decode n m u).2)) m (\ j -> (inr tt,j)) j)
    (ap (\ u -> (inr u,j)) (AffineFinite[l].top-eq tt t)) } } ;
module Sums (A : CRing) {
 open A ; open RL[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 split-sum (n : Nat) : (m : Nat) (v : Fin (plus m n) -> R) ->
  Id R (S.sum (plus m n) v)
   (add (S.sum m (\ i -> v (FS.right n m i))) (S.sum n (\ i -> v (FS.left n m i)))) = split {
  zero -> \ v -> sym (zl (S.sum n v)) ;
  suc m | ih -> \ v ->
   trans (ap (add (v (inr tt))) (ih (\ i -> v (inl i))))
    (addA (v (inr tt)) (S.sum m (\ i -> v (inl (FS.right n m i))))
     (S.sum n (\ i -> v (inl (FS.left n m i))))) } ;
 rectangular : (n m : Nat) (f : Pair n m -> R) ->
  Id R (S.sum (size n m) (\ u -> f (decode n m u)))
   (S.sum n (\ i -> S.sum m (\ j -> f (i,j)))) = split {
  zero -> \ m f -> refl z ;
  suc n | ih -> \ m f ->
   trans (split-sum (size n m) m (\ u -> f (decode (suc n) m u)))
    (cong2 R add _ _ _ _
     (S.sum-cong m
      (\ j -> f (decode (suc n) m (FS.right (size n m) m j)))
      (\ j -> f (inr tt,j))
      (\ j -> ap f (FS.cases-right (size n m) (Pair (suc n) m)
        (\ u -> (inl (decode n m u).1,(decode n m u).2)) m (\ k -> (inr tt,k)) j)))
     (trans (S.sum-cong (size n m)
       (\ u -> f (decode (suc n) m (FS.left (size n m) m u)))
       (\ u -> f (inl (decode n m u).1,(decode n m u).2))
       (\ u -> ap f (FS.cases-left (size n m) (Pair (suc n) m)
         (\ v -> (inl (decode n m v).1,(decode n m v).2)) m (\ k -> (inr tt,k)) u)))
      (ih m (\ p -> f (inl p.1,p.2))))) } ;
} ;
