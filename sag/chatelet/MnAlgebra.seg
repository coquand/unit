-- The matrix algebra M_N(R): matrices Fin N -> Fin N -> R, entrywise
-- module structure, product (a b)_ij = sum_k a_ik b_kj, unit the
-- Kronecker delta.  Associativity is exchange of a double sum.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Ps = Presentations[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (N : Nat) {
 module L = RL[R] ;
 module S = FiniteIdeal[l].Sums[R] ;
 module D = MnSums[l].Over[R] ;
 module NA = NCAlgebra[l].Over[R,setR] ;
 I : U l = Ps.Fin N ;
 Mat : U l = I -> I -> R.R ;
 set-mat : Pr.isSet Mat =
  F.isSet-Pi I (\ i -> I -> R.R) (\ i -> F.isSet-Pi I (\ j -> R.R) (\ j -> setR)) ;
 mat-eq (a b : Mat) (h : (i j : I) -> Id R.R (a i j) (b i j)) : Id Mat a b =
  F.funext I (\ i -> I -> R.R) a b (\ i -> F.funext I (\ j -> R.R) (a i) (b i) (h i)) ;
 mzero : Mat = \ i j -> R.z ;
 madd (a b : Mat) : Mat = \ i j -> R.add (a i j) (b i j) ;
 mneg (a : Mat) : Mat = \ i j -> R.neg (a i j) ;
 mscale (c : R.R) (a : Mat) : Mat = \ i j -> R.mul c (a i j) ;
 mone : Mat = D.delta N ;
 mmul (a b : Mat) : Mat = \ i j -> S.sum N (\ k -> R.mul (a i k) (b k j)) ;
 -- (a (b c))_ij = ((a b) c)_ij
 mmulA-at (a b c : Mat) (i j : I) : Id R.R (mmul a (mmul b c) i j) (mmul (mmul a b) c i j) =
  calc R.R {
   S.sum N (\ k -> R.mul (a i k) (S.sum N (\ m -> R.mul (b k m) (c m j))))
    =< S.sum-cong N _ (\ k -> S.sum N (\ m -> R.mul (a i k) (R.mul (b k m) (c m j))))
        (\ k -> sym (S.sum-scale (a i k) N (\ m -> R.mul (b k m) (c m j)))) >
   S.sum N (\ k -> S.sum N (\ m -> R.mul (a i k) (R.mul (b k m) (c m j))))
    =< D.exchange N N (\ k m -> R.mul (a i k) (R.mul (b k m) (c m j))) >
   S.sum N (\ m -> S.sum N (\ k -> R.mul (a i k) (R.mul (b k m) (c m j))))
    =< S.sum-cong N _ (\ m -> S.sum N (\ k -> R.mul (R.mul (a i k) (b k m)) (c m j)))
        (\ m -> S.sum-cong N _ _ (\ k -> R.mulA (a i k) (b k m) (c m j))) >
   S.sum N (\ m -> S.sum N (\ k -> R.mul (R.mul (a i k) (b k m)) (c m j)))
    =< S.sum-cong N _ _ (\ m -> D.sum-scale-right (c m j) N (\ k -> R.mul (a i k) (b k m))) >
   S.sum N (\ m -> R.mul (mmul a b i m) (c m j)) } ;
 m-addA (x y w : Mat) : Id Mat (madd x (madd y w)) (madd (madd x y) w) =
  mat-eq (madd x (madd y w)) (madd (madd x y) w) (\ i j -> R.addA (x i j) (y i j) (w i j)) ;
 m-addC (x y : Mat) : Id Mat (madd x y) (madd y x) =
  mat-eq (madd x y) (madd y x) (\ i j -> R.addC (x i j) (y i j)) ;
 m-addZ (x : Mat) : Id Mat (madd x mzero) x = mat-eq (madd x mzero) x (\ i j -> R.addZ (x i j)) ;
 m-addN (x : Mat) : Id Mat (madd x (mneg x)) mzero = mat-eq (madd x (mneg x)) mzero (\ i j -> R.addN (x i j)) ;
 m-scale-one (x : Mat) : Id Mat (mscale R.o x) x = mat-eq (mscale R.o x) x (\ i j -> L.one-left (x i j)) ;
 m-scale-scale (a b : R.R) (x : Mat) : Id Mat (mscale a (mscale b x)) (mscale (R.mul a b) x) =
  mat-eq (mscale a (mscale b x)) (mscale (R.mul a b) x) (\ i j -> R.mulA a b (x i j)) ;
 m-scale-add (a : R.R) (x y : Mat) : Id Mat (mscale a (madd x y)) (madd (mscale a x) (mscale a y)) =
  mat-eq (mscale a (madd x y)) (madd (mscale a x) (mscale a y)) (\ i j -> R.dist a (x i j) (y i j)) ;
 m-add-scale (a b : R.R) (x : Mat) : Id Mat (mscale (R.add a b) x) (madd (mscale a x) (mscale b x)) =
  mat-eq (mscale (R.add a b) x) (madd (mscale a x) (mscale b x)) (\ i j -> L.dist-left a b (x i j)) ;
 m-mulA (x y w : Mat) : Id Mat (mmul x (mmul y w)) (mmul (mmul x y) w) =
  mat-eq (mmul x (mmul y w)) (mmul (mmul x y) w) (mmulA-at x y w) ;
 m-one-left (x : Mat) : Id Mat (mmul mone x) x =
  mat-eq (mmul mone x) x (\ i j -> D.sum-delta N i (\ k -> x k j)) ;
 m-one-right (x : Mat) : Id Mat (mmul x mone) x =
  mat-eq (mmul x mone) x (\ i j -> D.sum-delta-right N j (x i)) ;
 m-dist-left (x y w : Mat) : Id Mat (mmul x (madd y w)) (madd (mmul x y) (mmul x w)) =
  mat-eq (mmul x (madd y w)) (madd (mmul x y) (mmul x w)) (\ i j ->
   trans (S.sum-cong N (\ k -> R.mul (x i k) (R.add (y k j) (w k j)))
     (\ k -> R.add (R.mul (x i k) (y k j)) (R.mul (x i k) (w k j)))
     (\ k -> R.dist (x i k) (y k j) (w k j)))
    (S.sum-add N (\ k -> R.mul (x i k) (y k j)) (\ k -> R.mul (x i k) (w k j)))) ;
 m-dist-right (x y w : Mat) : Id Mat (mmul (madd x y) w) (madd (mmul x w) (mmul y w)) =
  mat-eq (mmul (madd x y) w) (madd (mmul x w) (mmul y w)) (\ i j ->
   trans (S.sum-cong N (\ k -> R.mul (R.add (x i k) (y i k)) (w k j))
     (\ k -> R.add (R.mul (x i k) (w k j)) (R.mul (y i k) (w k j)))
     (\ k -> L.dist-left (x i k) (y i k) (w k j)))
    (S.sum-add N (\ k -> R.mul (x i k) (w k j)) (\ k -> R.mul (y i k) (w k j)))) ;
 m-scale-mul-left (a : R.R) (x y : Mat) : Id Mat (mmul (mscale a x) y) (mscale a (mmul x y)) =
  mat-eq (mmul (mscale a x) y) (mscale a (mmul x y)) (\ i j ->
   trans (S.sum-cong N (\ k -> R.mul (R.mul a (x i k)) (y k j)) (\ k -> R.mul a (R.mul (x i k) (y k j)))
     (\ k -> sym (R.mulA a (x i k) (y k j))))
    (S.sum-scale a N (\ k -> R.mul (x i k) (y k j)))) ;
 m-scale-mul-right (a : R.R) (x y : Mat) : Id Mat (mmul x (mscale a y)) (mscale a (mmul x y)) =
  mat-eq (mmul x (mscale a y)) (mscale a (mmul x y)) (\ i j ->
   trans (S.sum-cong N (\ k -> R.mul (x i k) (R.mul a (y k j))) (\ k -> R.mul a (R.mul (x i k) (y k j)))
     (\ k -> L.mul-swap (x i k) a (y k j)))
    (S.sum-scale a N (\ k -> R.mul (x i k) (y k j)))) ;
 algebra : NA.Algebra = new NA.Algebra[Mat,set-mat,mzero,madd,mneg,mscale,mone,mmul,
  m-addA,m-addC,m-addZ,m-addN,m-scale-one,m-scale-scale,m-scale-add,m-add-scale,
  m-mulA,m-one-left,m-one-right,m-dist-left,m-dist-right,m-scale-mul-left,m-scale-mul-right] ;
} ;
