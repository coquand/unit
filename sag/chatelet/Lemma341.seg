-- Lemma 3.4.1 of sevb.pdf: for A : AZ_n and I : RI(A), rho : A -> End_R(I)^op,
-- a |-> (v |-> v a), is an isomorphism of algebras.
--
-- End_R(I) is stated via a basis b = (f, g) of I (AzumayaProbe.Basis:
-- f : R^N = I, g a linear left inverse on all of A), so End_R(I) = M_N(R),
-- and End_R(I)^op = M_N(R) by transposition.  The composite is
--     sigma_b (a)_ij = g (f(e_i) a)_j ,
-- the transpose of the matrix of v |-> v a.  The lemma: for every basis b
-- of I, sigma_b : A -> M_N(R) is an algebra isomorphism (iso).  This is the
-- form used in Theorem 3.4.2 (A merely = M_N(R)).
--
-- "sigma_b is a homomorphism with contractible fibres" (P) is a sheaf
-- proposition, so we may take A = M_N(R) (A : AZ), then I = delta[eps I]
-- (Delta.delta-eps), then I = delta[x] with a pivot x_k unit.  There
-- f(e_i) = x y_i^T (Delta.outer-row), and with D_jk = g(x e_k^T)_j,
--     sigma_b (M) = Y M Z ,   Y_im = (y_i)_m ,  Z_kj = D_jk ,
-- since w |-> g(x w^T)_j is linear (Delta.Expand).  Y Z = 1 is g f = 1,
-- so Z Y = 1 by (K2): sigma_b is conjugation (SkolemNoetherConj).  (For
-- b = At[x,p].basis, theta : y |-> x y^T, one has Y = Z = 1, i.e. rho(M) is
-- y |-> M^T y in the basis theta; this special case is not needed, since
-- the argument works for every basis.)
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module Tr = Truncation[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module DE = DeloopEquiv[l] ;
module CT = FunExtUA[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (I : U l) (G : I -> U l)
 (sh : [j] SheafClosure[l,j].Over[I,G].Ops)
 (loc : StandardOpens[l].Over[R,setR].Locality)
 (R-modal : SheafTopology[l].Over[I,G].isModal @l R.R)
 (descends : (S : AzumayaProbe[l].Over[R,setR,n,I,G,sh].Sub (MnAlgebra[l].Over[R,setR,suc n].algebra)) ->
   (sh @l).close (AzumayaProbe[l].Over[R,setR,n,I,G,sh].Basis (MnAlgebra[l].Over[R,setR,suc n].algebra) S) ->
   Tr.Trunc[AzumayaProbe[l].Over[R,setR,n,I,G,sh].Basis (MnAlgebra[l].Over[R,setR,suc n].algebra) S].carrier) {
 module DL = Delta[l].Over[R,setR,n,I,G,sh,loc,R-modal,descends] ;
 module AP = DL.AP ;
 module T = DL.T ;
 module S0 = DL.S0 ;
 module MN = DL.MN ;
 module PQ = DL.PQ ;
 module SR = DL.SR ;
 module L = DL.L ;
 module K = DL.K ;
 module AS = AlgSIP2[l].Over[R,setR] ;
 module DM = Deloop[l,l].Over[I,G,sh] ;
 Mt : AP.Alg = DL.Mt ;
 Mat : U l = DL.Mat ;
 Vc : U l = DL.Vc ;
 Ix : U l = DL.Ix ;
 AZ : U l+ = DL.Ty.AZ ;

 -- rho in the basis b, transposed
 sigma (B : AP.Alg) (S : AP.Sub B) (b : AP.Basis B S) (a : B.A) : Mat =
  \ i j -> b.2.2.2.2.1 (B.mul (b.1 (DL.ev i)).1 a) j ;
 Fibres (B : AP.Alg) (S : AP.Sub B) (b : AP.Basis B S) : U l =
  (M : Mat) -> CT.isContr (DE.fib B.A Mat (sigma B S b) M) ;
 P (B : AP.Alg) (S : AP.Sub B) (b : AP.Basis B S) : U l = AS.Hom B Mt (sigma B S b) * Fibres B S b ;
 iso (B : AP.Alg) (S : AP.Sub B) (b : AP.Basis B S) (h : P B S b) : AS.AlgIso B Mt =
  ((sigma B S b,DE.contr-equiv B.A Mat (sigma B S b) h.2),h.1) ;

 -- P is a sheaf proposition
 P-prop (B : AP.Alg) (S : AP.Sub B) (b : AP.Basis B S) : Pr.isProp (P B S b) =
  Pr.isProp-Sigma (AS.Hom B Mt (sigma B S b)) (\ h -> Fibres B S b) (AS.hom-prop B Mt (sigma B S b))
   (\ h -> FL.isProp-Pi Mat (\ M -> CT.isContr (DE.fib B.A Mat (sigma B S b) M))
     (\ M -> Torsor[l].isProp-isContr (DE.fib B.A Mat (sigma B S b) M))) ;
 mat-modal : T.isModal @l Mat = S0.modal-Pi Ix (\ i -> Ix -> R.R) (\ i -> S0.modal-Pi Ix (\ j -> R.R) (\ j -> R-modal)) ;
 eq-modal (X Y : Mat) : T.isModal @l (Id Mat X Y) = S0.modal-Id Mat mat-modal X Y ;
 P-modal (B : AP.Alg) (hB : T.isModal @l B.A) (S : AP.Sub B) (b : AP.Basis B S) : T.isModal @l (P B S b) =
  S0.modal-Sigma (AS.Hom B Mt (sigma B S b)) (\ h -> Fibres B S b)
   (S0.modal-Sigma ((x y : B.A) -> Id Mat (sigma B S b (B.add x y)) (MN.madd (sigma B S b x) (sigma B S b y)))
     (\ h1 -> ((a : R.R) (x : B.A) -> Id Mat (sigma B S b (B.scale a x)) (MN.mscale a (sigma B S b x))) *
       ((x y : B.A) -> Id Mat (sigma B S b (B.mul x y)) (MN.mmul (sigma B S b x) (sigma B S b y))) *
       Id Mat (sigma B S b B.one) MN.mone)
     (S0.modal-Pi B.A (\ x -> (y : B.A) -> Id Mat (sigma B S b (B.add x y)) (MN.madd (sigma B S b x) (sigma B S b y)))
       (\ x -> S0.modal-Pi B.A (\ y -> Id Mat (sigma B S b (B.add x y)) (MN.madd (sigma B S b x) (sigma B S b y)))
         (\ y -> eq-modal (sigma B S b (B.add x y)) (MN.madd (sigma B S b x) (sigma B S b y)))))
     (\ h1 -> S0.modal-Sigma ((a : R.R) (x : B.A) -> Id Mat (sigma B S b (B.scale a x)) (MN.mscale a (sigma B S b x)))
       (\ h2 -> ((x y : B.A) -> Id Mat (sigma B S b (B.mul x y)) (MN.mmul (sigma B S b x) (sigma B S b y))) *
         Id Mat (sigma B S b B.one) MN.mone)
       (S0.modal-Pi R.R (\ a -> (x : B.A) -> Id Mat (sigma B S b (B.scale a x)) (MN.mscale a (sigma B S b x)))
         (\ a -> S0.modal-Pi B.A (\ x -> Id Mat (sigma B S b (B.scale a x)) (MN.mscale a (sigma B S b x)))
           (\ x -> eq-modal (sigma B S b (B.scale a x)) (MN.mscale a (sigma B S b x)))))
       (\ h2 -> S0.modal-Sigma ((x y : B.A) -> Id Mat (sigma B S b (B.mul x y)) (MN.mmul (sigma B S b x) (sigma B S b y)))
         (\ h3 -> Id Mat (sigma B S b B.one) MN.mone)
         (S0.modal-Pi B.A (\ x -> (y : B.A) -> Id Mat (sigma B S b (B.mul x y)) (MN.mmul (sigma B S b x) (sigma B S b y)))
           (\ x -> S0.modal-Pi B.A (\ y -> Id Mat (sigma B S b (B.mul x y)) (MN.mmul (sigma B S b x) (sigma B S b y)))
             (\ y -> eq-modal (sigma B S b (B.mul x y)) (MN.mmul (sigma B S b x) (sigma B S b y)))))
         (\ h3 -> eq-modal (sigma B S b B.one) MN.mone))))
   (\ h -> S0.modal-Pi Mat (\ M -> CT.isContr (DE.fib B.A Mat (sigma B S b) M))
     (\ M -> DM.modal-isContr (DE.fib B.A Mat (sigma B S b) M)
       (DM.modal-fib B.A Mat hB mat-modal (sigma B S b) M))) ;

 -- the concrete case: I = delta[x], x_kp a unit, b any basis
 module Conc (x : PQ.Point) (p : PQ.Pivots x.1) (b : AP.Basis Mt (DL.Sq (PQ.class x))) {
  kp : Ix = p.1 ;
  f (v : Vc) : Mat = (b.1 v).1 ;
  g (X : Mat) : Vc = b.2.2.2.2.1 X ;
  y (i : Ix) : Vc = DL.row kp p.2.1 (f (DL.ev i)) ;
  f-ev (i : Ix) : Id Mat (f (DL.ev i)) (DL.outer x.1 (y i)) =
   sym (DL.outer-row x.1 kp p.2 (f (DL.ev i)) (DL.col-of-memb x (f (DL.ev i)) (b.1 (DL.ev i)).2)) ;
  -- w |-> g(x w^T)_j is linear
  psi (j : Ix) (w : Vc) : R.R = g (DL.outer x.1 w) j ;
  psi-add (j : Ix) (v v' : Vc) : Id R.R (psi j (DL.vadd v v')) (R.add (psi j v) (psi j v')) =
   trans (ap (\ X -> g X j) (MN.mat-eq (DL.outer x.1 (DL.vadd v v')) (MN.madd (DL.outer x.1 v) (DL.outer x.1 v'))
     (\ i k -> R.dist (x.1 i) (v k) (v' k))))
    (b.2.2.2.2.2.1 (DL.outer x.1 v) (DL.outer x.1 v') j) ;
  psi-sc (j : Ix) (a : R.R) (v : Vc) : Id R.R (psi j (DL.vscale a v)) (R.mul a (psi j v)) =
   trans (ap (\ X -> g X j) (MN.mat-eq (DL.outer x.1 (DL.vscale a v)) (MN.mscale a (DL.outer x.1 v))
     (\ i k -> L.mul-swap (x.1 i) a (v k))))
    (b.2.2.2.2.2.2.1 a (DL.outer x.1 v) j) ;
  expand (j : Ix) (w : Vc) : Id R.R (psi j w) (SR.sum (suc n) (\ k -> R.mul (w k) (psi j (DL.ev k)))) =
   DL.Expand[psi j,psi-add j,psi-sc j].expand w ;
  Ym : Mat = \ i m -> y i m ;
  Zm : Mat = \ k j -> psi j (DL.ev k) ;
  -- (x w^T) M = x (w^T M)
  outer-mul (w : Vc) (M : Mat) : Id Mat (MN.mmul (DL.outer x.1 w) M) (DL.outer x.1 (\ k -> SR.sum (suc n) (\ m -> R.mul (w m) (M m k)))) =
   MN.mat-eq (MN.mmul (DL.outer x.1 w) M) (DL.outer x.1 (\ k -> SR.sum (suc n) (\ m -> R.mul (w m) (M m k)))) (\ i k ->
    trans (SR.sum-cong (suc n) (\ m -> R.mul (R.mul (x.1 i) (w m)) (M m k)) (\ m -> R.mul (x.1 i) (R.mul (w m) (M m k)))
      (\ m -> sym (R.mulA (x.1 i) (w m) (M m k))))
     (SR.sum-scale (x.1 i) (suc n) (\ m -> R.mul (w m) (M m k)))) ;
  sigma-at (M : Mat) (i j : Ix) : Id R.R (sigma Mt (DL.Sq (PQ.class x)) b M i j) (MN.mmul (MN.mmul Ym M) Zm i j) =
   calc R.R {
    g (MN.mmul (f (DL.ev i)) M) j
     =< ap (\ X -> g (MN.mmul X M) j) (f-ev i) > g (MN.mmul (DL.outer x.1 (y i)) M) j
     =< ap (\ X -> g X j) (outer-mul (y i) M) > psi j (\ k -> SR.sum (suc n) (\ m -> R.mul (y i m) (M m k)))
     =< expand j (\ k -> SR.sum (suc n) (\ m -> R.mul (y i m) (M m k))) >
    MN.mmul (MN.mmul Ym M) Zm i j } ;
  YZ : Id Mat (MN.mmul Ym Zm) MN.mone = MN.mat-eq (MN.mmul Ym Zm) MN.mone (\ i j ->
   calc R.R {
    SR.sum (suc n) (\ k -> R.mul (y i k) (psi j (DL.ev k)))
     =< sym (expand j (y i)) > psi j (y i)
     =< ap (\ X -> g X j) (sym (f-ev i)) > g (f (DL.ev i)) j
     =< b.2.2.2.2.2.2.2 (DL.ev i) j > MN.mone i j }) ;
  ZY : Id Mat (MN.mmul Zm Ym) MN.mone = K.k2 (suc n) Ym Zm YZ ;
  module C = SkolemNoetherConj[l].Over[R,setR].On[Mt].Conj[Ym,Zm,YZ,ZY] ;
  sigma-conj : Id (Mat -> Mat) C.map (sigma Mt (DL.Sq (PQ.class x)) b) =
   FL.funext Mat (\ M -> Mat) C.map (sigma Mt (DL.Sq (PQ.class x)) b) (\ M ->
    MN.mat-eq (C.map M) (sigma Mt (DL.Sq (PQ.class x)) b M) (\ i j -> sym (sigma-at M i j))) ;
  Pmap (h : Mat -> Mat) : U l = AS.Hom Mt Mt h * ((M : Mat) -> CT.isContr (DE.fib Mat Mat h M)) ;
  at-conj : Pmap C.map =
   (C.aut.2.2,DE.equiv-contr Mat Mat C.map (Pr.qinv Mat Mat C.map C.back C.aut.2.1.2.2 C.aut.2.1.2.1)) ;
  holds : P Mt (DL.Sq (PQ.class x)) b = Pr.subst (Mat -> Mat) Pmap C.map (sigma Mt (DL.Sq (PQ.class x)) b) sigma-conj at-conj ;
 } ;

 -- reduction to the concrete case
 at-delta (q : PQ.Pn) : (b : AP.Basis Mt (DL.Sq q)) -> P Mt (DL.Sq q) b =
  PQ.Q.induction @l (\ q1 -> (b : AP.Basis Mt (DL.Sq q1)) -> P Mt (DL.Sq q1) b)
   (\ q1 -> FL.isProp-Pi (AP.Basis Mt (DL.Sq q1)) (\ b -> P Mt (DL.Sq q1) b) (\ b -> P-prop Mt (DL.Sq q1) b))
   (\ x b -> Tr.Trunc[PQ.Pivots x.1].induction @l (\ t -> P Mt (DL.Sq (PQ.class x)) b)
     (\ t -> P-prop Mt (DL.Sq (PQ.class x)) b) (\ pv -> Conc[x,pv,b].holds) x.2) q ;
 at-M (J : AP.RI Mt) : (b : AP.Basis Mt J.1) -> P Mt J.1 b =
  P1.subst (AP.RI Mt) (\ J1 -> (b : AP.Basis Mt J1.1) -> P Mt J1.1 b) (DL.delta-map (DL.eps J)) J (DL.delta-eps J)
   (at-delta (DL.eps J)) ;
 along (B : AP.Alg) (e : Id AP.Alg Mt B) : (J : AP.RI B) (b : AP.Basis B J.1) -> P B J.1 b =
  idJ AP.Alg Mt (\ B1 e1 -> (J : AP.RI B1) (b : AP.Basis B1 J.1) -> P B1 J.1 b) at-M B e ;

 -- Lemma 3.4.1
 holds (A : AZ) (J : AP.RI A.1) (b : AP.Basis A.1 J.1) : P A.1 J.1 b =
  (sh @(l+)).elim @l (Id AP.Alg A.1 Mt) (P A.1 J.1 b) (P-prop A.1 J.1 b) (P-modal A.1 A.2.1 J.1 b)
   (\ e -> along A.1 (P1.sym AP.Alg A.1 Mt e) J b) A.2.2 ;
 lemma-3-4-1 (A : AZ) (J : AP.RI A.1) (b : AP.Basis A.1 J.1) : AS.AlgIso A.1 Mt = iso A.1 J.1 b (holds A J b) ;
} ;
