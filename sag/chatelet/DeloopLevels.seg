-- Deloop instantiated at j = l++, where AZ_n and SB_n live (sevb Prop 3.3.1).
level l ;
module Over (I : U l) (G : I -> U l) (sh : [m] SheafClosure[l,m].Over[I,G].Ops) {
 module D = Deloop[l,l++].Over[I,G,sh] ;
 deloop (A B : U l++) (hA : D.T.isModal @(l++) A) (hB : D.T.isModal @(l++) B) (a0 : A) (b0 : B)
  (cA : D.Connected A) (cB : D.Connected B) (f : A -> B) (p : Id B (f a0) b0)
  (omega : Prelude[l++].isEquiv (Id A a0 a0) (Id B b0 b0) (D.Omega A B f a0 b0 p)) : Prelude[l++].isEquiv A B f =
  D.Lemma[A,B,hA,hB,a0,b0,cA,cB,f,p,omega].theorem ;
} ;
