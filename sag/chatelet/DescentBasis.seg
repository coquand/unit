-- Step 3: a basis among finitely many generators.  The finite disjunction
-- is open, hence a sheaf, and locally it follows by Schur pivoting.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module OP = OpenProp[l].Over[R,setR] ; module EO = EtaleOpen[l].Over[R,setR,axioms] ;
 module SQ = DescentSquare[l].Over[R,setR,axioms.loc] ;
 module LR = EtaleLinear[l].Over[R,setR] ;
 module Rank (rank : Nat) {
  OpenClaim (M : MD.Module) : U l = (w : Fin rank -> M.M) -> OP.Open (DL.On[M].Basis rank w) ;
  free-open : OpenClaim (DL.Free rank) = \ w -> SQ.Rank[rank].Basis[w].basis-open ;
  module LocalModule (M : MD.Module) (modal : ET.T.isModal @l M.M)
   (sh : [j] SheafClosure[l,j].Over[ET.I,ET.G].Ops)
   (local : (sh @l).close (DL.On[M].Frame rank)) {
   module LM = DL.On[M] ;
   module Family (w : Fin rank -> M.M) {
    module E = DescentEquiv[l].Over[ET.I,ET.G].At[(DL.Free rank).M,M.M,
     SL.modal-Pi (Fin rank) (\ j -> R.R) (\ j -> ER.R-local),modal,LM.lin rank w] ;
    module O = DescentOpen[l].Over[R,setR,axioms].At[LM.Basis rank w,E.proposition,E.modal] ;
    basis-open : OP.Open (LM.Basis rank w) =
     (sh @l).elim @l (LM.Frame rank) (OP.Open (LM.Basis rank w))
      Tr.Trunc[OP.Witness (LM.Basis rank w)].proposition O.theorem
      (\ b -> P1.subst MD.Module (\ N -> OpenClaim N) (DL.Free rank) M
       (P1.sym MD.Module M (DL.Free rank) (LM.frame-equality rank b)) free-open w) local ;
   } ;
  } ;
  module Size (n : Nat) {
   Onto (M : MD.Module) (w : Fin n -> M.M) : U l =
    (m : M.M) -> Tr.Trunc[(c : (DL.Free n).M) * Id M.M (DL.On[M].lin n w c) m].carrier ;
   Some (M : MD.Module) (w : Fin n -> M.M) : U l =
    Tr.Trunc[(s : Fin rank -> Fin n) * DL.On[M].Basis rank (\ j -> w (s j))].carrier ;
   Claim (M : MD.Module) : U l = (w : Fin n -> M.M) -> Onto M w -> Some M w ;
   module Free (w : Fin n -> (DL.Free rank).M) (onto : Onto (DL.Free rank) w) {
    surj : LR.Surj n rank w = \ v ->
     TC.map ((c : (DL.Free n).M) * Id (DL.Free rank).M (DL.On[DL.Free rank].lin n w c) v)
      (LR.Witness n rank w v)
      (\ z -> (z.1,\ k -> ap (\ u -> u k) (trans (sym (SQ.Rank[rank].coordinates n w z.1)) z.2))) (onto v) ;
    result : Some (DL.Free rank) w =
     TC.map (DescentColumns[l].Over[R,setR,axioms.loc].Selected n rank w)
      ((s : Fin rank -> Fin n) * DL.On[DL.Free rank].Basis rank (\ j -> w (s j)))
      (\ z -> (z.1,SQ.Rank[rank].Basis[\ j -> w (z.1 j)].backward z.2))
      (DescentColumns[l].Over[R,setR,axioms.loc].theorem rank n w surj) ;
   } ;
   free : Claim (DL.Free rank) = \ w onto -> Free[w,onto].result ;
   module FiniteGenerators (M : MD.Module) (modal : ET.T.isModal @l M.M)
    (sh : [j] SheafClosure[l,j].Over[ET.I,ET.G].Ops)
    (local : (sh @l).close (DL.On[M].Frame rank))
    (w : Fin n -> M.M) (onto : Onto M w) {
    module LM = DL.On[M] ;
    module O = LocalModule[M,modal,sh,local] ;
    some-open : OP.Open (Some M w) =
     DescentTuples[l].Over[R,setR].At[rank,n,
      \ s -> LM.Basis rank (\ j -> w (s j)),\ s -> O.Family[\ j -> w (s j)].basis-open].theorem ;
    theorem : Some M w =
     (sh @l).elim @l (LM.Frame rank) (Some M w)
      Tr.Trunc[(s : Fin rank -> Fin n) * LM.Basis rank (\ j -> w (s j))].proposition
      (EO.open-local (Some M w) some-open)
      (\ b -> P1.subst MD.Module (\ N -> Claim N) (DL.Free rank) M
       (P1.sym MD.Module M (DL.Free rank) (LM.frame-equality rank b)) free w onto) local ;
    frame : Tr.Trunc[LM.Frame rank].carrier =
     TC.map ((s : Fin rank -> Fin n) * LM.Basis rank (\ j -> w (s j))) (LM.Frame rank)
      (\ z -> (\ j -> w (z.1 j),z.2)) theorem ;
    opaque theorem ; opaque frame ;
   } ;
  } ;
 } ;
} ;
