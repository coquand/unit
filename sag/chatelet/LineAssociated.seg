-- Modules of equivariant scalar functions on a unit torsor.
-- Inverse weight gives the associated line; ordinary weight gives its dual.
-- A point is used only for the local trivialisation, not for construction.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Pr1 = Prelude[l+] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 open R ; open RL[R] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module TI = TorsorId[l].TorId[G.group] ;
 module MD = Modules[l].Over[R,setR] ;
 module SIP = ModuleSIP[l].Over[MD.ring] ;
 module QCProp (M : MD.Module) {
  module Af = Affine[l].Aff[MD.ring,Top,\ t -> M] ;
  Rep (g : Top -> R.R) : U l =
   (s : (t : Top) -> MD.RA.unit (g t) -> M.M) -> Tr.Trunc[Af.Rep g s].carrier ;
  ZeroOn (g : Top -> R.R) (m : Top -> M.M) : U l =
   (t : Top) -> MD.RA.unit (g t) -> Id M.M (m t) M.mz ;
  Kill (g : Top -> R.R) : U l =
   (m : Top -> M.M) -> ZeroOn g m -> Tr.Trunc[Af.Kill g m].carrier ;
  rep-prop (g : Top -> R.R) : Pr.isProp (Rep g) =
   F.isProp-Pi ((t : Top) -> MD.RA.unit (g t) -> M.M)
    (\ s -> Tr.Trunc[Af.Rep g s].carrier) (\ s -> Tr.Trunc[Af.Rep g s].proposition) ;
  kill-prop (g : Top -> R.R) : Pr.isProp (Kill g) =
   F.isProp-Pi (Top -> M.M) (\ m -> ZeroOn g m -> Tr.Trunc[Af.Kill g m].carrier)
    (\ m -> F.isProp-Pi (ZeroOn g m) (\ h -> Tr.Trunc[Af.Kill g m].carrier)
     (\ h -> Tr.Trunc[Af.Kill g m].proposition)) ;
  theorem : Pr.isProp (MD.WeaklyQC M) =
   F.isProp-Pi (Top -> R.R) (\ g -> Rep g * Kill g)
    (\ g -> Pr.isProp-Sigma (Rep g) (\ r -> Kill g) (rep-prop g) (\ r -> kill-prop g)) ;
 } ;
 module Weight (chi : G.Unit -> G.Unit)
  (chi-one : Id G.Unit (chi G.one) G.one)
  (chi-times : (a b : G.Unit) -> Id G.Unit (chi (G.times a b)) (G.times (chi a) (chi b))) {
  module At (T : TI.Tor) {
   module D = Torsor[l].TorBase[G.group].D[T.1,T.2] ;
   Cond (f : T.1 -> R.R) : U l =
    (a : G.Unit) (t : T.1) -> Id R.R (f (T.2.1 a t)) (mul (chi a).1 (f t)) ;
   cond-prop (f : T.1 -> R.R) : Pr.isProp (Cond f) =
    F.isProp-Pi G.Unit (\ a -> (t : T.1) -> Id R.R (f (T.2.1 a t)) (mul (chi a).1 (f t)))
     (\ a -> F.isProp-Pi T.1 (\ t -> Id R.R (f (T.2.1 a t)) (mul (chi a).1 (f t)))
      (\ t -> setR _ _)) ;
   Carrier : U l = (f : T.1 -> R.R) * Cond f ;
   equal (f g : Carrier) (h : (t : T.1) -> Id R.R (f.1 t) (g.1 t)) : Id Carrier f g =
    Pr.Sigma-eq (T.1 -> R.R) Cond f.1 g.1 f.2 g.2
     (F.funext T.1 (\ t -> R.R) f.1 g.1 h) (cond-prop g.1) ;
   set : Pr.isSet Carrier =
    Torsor[l].isSet-sub (T.1 -> R.R) Cond (F.isSet-Pi T.1 (\ t -> R.R) (\ t -> setR)) cond-prop ;
   zero : Carrier = (\ t -> z,\ a t -> sym (mul-zero (chi a).1)) ;
   addM (f g : Carrier) : Carrier =
    (\ t -> add (f.1 t) (g.1 t),\ a t ->
     trans (Presentations[l].cong2 R.R add _ _ _ _ (f.2 a t) (g.2 a t))
      (sym (dist (chi a).1 (f.1 t) (g.1 t)))) ;
   negM (f : Carrier) : Carrier =
    (\ t -> neg (f.1 t),\ a t -> trans (ap neg (f.2 a t)) (sym (mul-neg (chi a).1 (f.1 t)))) ;
   scale (r : R.R) (f : Carrier) : Carrier =
    (\ t -> mul r (f.1 t),\ a t ->
     trans (ap (mul r) (f.2 a t)) (mul-swap r (chi a).1 (f.1 t))) ;
   associated : MD.Module = new Alg73[l].Mod[MD.ring,Carrier,set,zero,addM,negM,
    \ f g h -> equal _ _ (\ t -> addA (f.1 t) (g.1 t) (h.1 t)),
    \ f g -> equal _ _ (\ t -> addC (f.1 t) (g.1 t)),
    \ f -> equal _ _ (\ t -> addZ (f.1 t)),
    \ f -> equal _ _ (\ t -> addN (f.1 t)),
    scale,
    \ a b f -> equal _ _ (\ t -> mulA a b (f.1 t)),
    \ f -> equal _ _ (\ t -> trans (mulC o (f.1 t)) (mulO (f.1 t))),
    \ a f g -> equal _ _ (\ t -> dist a (f.1 t) (g.1 t)),
    \ a b f -> equal _ _ (\ t -> RL[R].dist-left a b (f.1 t))] ;
   module Based (t0 : T.1) {
    module B = TorsorMaps[l].Over[G.group].Based[T,T,t0,t0] ;
    ratio (t : T.1) : G.Unit = chi (D.diff t0 t) ;
    shift (a : G.Unit) (t : T.1) :
     Id G.Unit (ratio (T.2.1 a t)) (G.times (chi a) (ratio t)) =
     trans (ap chi (B.dshift a t)) (chi-times a (D.diff t0 t)) ;
    extend (r : R.R) : Carrier =
     (\ t -> mul (ratio t).1 r,\ a t ->
      trans (ap (\ u -> mul u.1 r) (shift a t)) (sym (mulA (chi a).1 (ratio t).1 r))) ;
    beta (r : R.R) : Id R.R ((extend r).1 t0) r =
     trans (ap (\ u -> mul u.1 r)
      (trans (ap chi (D.uniq t0 t0 G.one (T.2.2.2.2.1 t0))) chi-one))
      (trans (mulC o r) (mulO r)) ;
    eta (f : Carrier) : Id Carrier (extend (f.1 t0)) f =
     equal _ _ (\ t -> trans (sym (f.2 (D.diff t0 t) t0)) (ap f.1 (D.dact t0 t))) ;
    evaluation : Pr.Equiv Carrier R.R =
     (\ f -> f.1 t0,Pr.qinv Carrier R.R (\ f -> f.1 t0) extend beta eta) ;
    eval-zero : Id R.R (evaluation.1 zero) z = refl z ;
    eval-add (f g : Carrier) : Id R.R (evaluation.1 (addM f g)) (add (evaluation.1 f) (evaluation.1 g)) =
     refl (add (f.1 t0) (g.1 t0)) ;
    eval-scale (a : R.R) (f : Carrier) :
     Id R.R (evaluation.1 (scale a f)) (mul a (evaluation.1 f)) = refl (mul a (f.1 t0)) ;
    module-equality : Id MD.Module associated MD.regular =
     SIP.sip associated MD.regular (evaluation,eval-add,eval-scale) ;
    qc (w : MD.WeaklyQC MD.regular) : MD.WeaklyQC associated =
     idJ MD.Module MD.regular (\ N p -> MD.WeaklyQC N) w associated
      (Pr1.sym MD.Module associated MD.regular module-equality) ;
   } ;
   weakly-qc (w : MD.WeaklyQC MD.regular) : MD.WeaklyQC associated =
    Tr.Trunc[T.1].induction @l (\ t -> MD.WeaklyQC associated)
     (\ t -> QCProp[associated].theorem) (\ t -> Based[t].qc w) T.2.2.2.2.2.2 ;
  } ;
 } ;
 inverse-one : Id G.Unit (G.inverse G.one) G.one = G.eq _ _ (refl o) ;
 inverse-times (a b : G.Unit) :
  Id G.Unit (G.inverse (G.times a b)) (G.times (G.inverse a) (G.inverse b)) =
  G.eq _ _ (refl (mul a.2.1 b.2.1)) ;
 module Line = Weight[G.inverse,inverse-one,inverse-times] ;
 module Dual = Weight[\ a -> a,refl G.one,\ a b -> refl (G.times a b)] ;
} ;
