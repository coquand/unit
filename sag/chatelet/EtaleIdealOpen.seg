-- The unit ideal in a finite free monic algebra is an open condition.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module FP = FiniteProduct[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (loc : StandardOpens[l].Over[R,setR].Locality) (lower : List R.R) {
 module F = EtaleFreeLinear[l].Over[R,setR,lower] ;
 module B = F.B ;
 A : Algebras[l].Over[R,setR].Algebra = B.A ;
 module AS = F.AS ;
 module PS = FP.Sums[R] ;
 module WPS = EtaleProduct[l].Over[R] ;
 module LR = EtaleLinear[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module At (m : Nat) (hs : Fin m -> A.ring.R) {
  n : Nat = FP.size m B.d ;
  matrix : LR.Matrix n B.d = \ u k ->
   B.coords (A.ring.mul (hs (FP.decode m B.d u).1) (F.basis-vector (FP.decode m B.d u).2)) k ;
  weights (as : Fin m -> A.ring.R) : Fin n -> R.R =
   \ u -> B.coords (as (FP.decode m B.d u).1) (FP.decode m B.d u).2 ;
  matrix-weights (as : Fin m -> A.ring.R) (k : Fin B.d) :
   Id R.R (LR.apply n B.d matrix (weights as) k) (B.coords (AS.lin m hs as) k) =
   trans (PS.rectangular m B.d
     (\ p -> R.mul (B.coords (A.ring.mul (hs p.1) (F.basis-vector p.2)) k) (B.coords (as p.1) p.2)))
    (sym (F.coords-combination m hs as k)) ;
  coefficients (c : Fin n -> R.R) (s : Fin m) : A.ring.R =
   B.expansion (\ t -> c (FP.encode m B.d s t)) ;
  matrix-coefficients (c : Fin n -> R.R) (k : Fin B.d) :
   Id R.R (LR.apply n B.d matrix c k) (B.coords (AS.lin m hs (coefficients c)) k) =
   trans (WPS.rectangular m B.d
     (\ p -> B.coords (A.ring.mul (hs p.1) (F.basis-vector p.2)) k) c)
    (trans (F.RS.sum-cong m _ _ (\ s -> F.RS.sum-cong B.d _ _ (\ t ->
       ap (R.mul (B.coords (A.ring.mul (hs s) (F.basis-vector t)) k))
        (sym (Pr.happly (Fin B.d) (\ t -> R.R) _ _ (B.coords-expansion (\ t -> c (FP.encode m B.d s t))) t)))))
     (sym (F.coords-combination m hs (coefficients c) k))) ;
  opaque matrix ; opaque weights ; opaque coefficients ;
  module Generate (w : Ax.UnimodularWitness A m hs) (v : Fin B.d -> R.R) {
   as : Fin m -> A.ring.R = \ s -> A.ring.mul (w.1 s) (B.expansion v) ;
   combination : Id A.ring.R (AS.lin m hs as) (B.expansion v) =
    trans (AS.sum-cong m (\ s -> A.ring.mul (hs s) (A.ring.mul (w.1 s) (B.expansion v))) (\ s -> A.ring.mul (A.ring.mul (hs s) (w.1 s)) (B.expansion v)) (\ s -> A.ring.mulA (hs s) (w.1 s) (B.expansion v)))
     (trans (MnSums[l].Over[A.ring].sum-scale-right (B.expansion v) m (\ s -> A.ring.mul (hs s) (w.1 s)))
      (trans (ap (\ a -> A.ring.mul a (B.expansion v)) w.2) (RL[A.ring].one-left (B.expansion v)))) ;
   witness : LR.Witness n B.d matrix v =
    (weights as,\ k -> trans (matrix-weights as k)
      (trans (ap (\ a -> B.coords a k) combination)
       (Pr.happly (Fin B.d) (\ t -> R.R) _ _ (B.coords-expansion v) k))) ;
  } ;
  forward (uni : Ax.Unimodular A m hs) : LR.Surj n B.d matrix =
   TC.rec (Ax.UnimodularWitness A m hs) @l (LR.Surj n B.d matrix) (LR.surj-prop n B.d matrix)
    (\ w v -> Tr.Trunc[LR.Witness n B.d matrix v].inc Generate[w,v].witness) uni ;
  recover (w : LR.Witness n B.d matrix (B.coords A.ring.o)) : Ax.UnimodularWitness A m hs =
   (coefficients w.1,Equivalences[l].injective A.ring.R (Fin B.d -> R.R) B.coords B.basis.2 _ _
     (FL.funext (Fin B.d) (\ k -> R.R) _ _
       (\ k -> trans (sym (matrix-coefficients w.1 k)) (w.2 k)))) ;
  backward (onto : LR.Surj n B.d matrix) : Ax.Unimodular A m hs =
   TC.map (LR.Witness n B.d matrix (B.coords A.ring.o)) (Ax.UnimodularWitness A m hs)
    recover (onto (B.coords A.ring.o)) ;
  equivalence : Pr.Equiv (Ax.Unimodular A m hs) (LR.Surj n B.d matrix) =
   (forward,Pr.qinv _ _ forward backward (\ s -> LR.surj-prop n B.d matrix _ s)
     (\ u -> Tr.Trunc[Ax.UnimodularWitness A m hs].proposition _ u)) ;
  unimodular-open : OP.Open (Ax.Unimodular A m hs) =
   OP.along (Ax.Unimodular A m hs) (LR.Surj n B.d matrix) equivalence
    (EtaleSurj[l].Over[R,setR,loc].surj-open B.d n matrix) ;
 } ;
} ;
