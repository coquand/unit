-- The SQC half of SAG 3.2.2: for finitely presented A and presented K,
-- every map Spec A -> Spec K is induced by a unique algebra map K -> A.
-- So the pullback of arbitrary maps of affine schemes is affine.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
module Fn = Functions[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr1 = Truncation[l+] ;
open Presentations[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module P = Presentations[l].Over[R,setR] ; open P ;
 module C = Algebras[l].Over[R,setR] ;
 module G = Generated[l].Over[R,setR] ;
 module PO = Pushout[l].Over[R,setR] ;
 spec-set (K : C.Algebra) : Pr.isSet (C.Spec K) =
  Pr.isSet-Sigma (RingHom[l].Hom K.ring R) (C.Commutes K C.base)
   (RingHom[l].Properties[K.ring,R,setR].set)
   (\ h -> Pr.prop-to-set (C.Commutes K C.base h) (C.commutes-prop K C.base h)) ;
 -- induced map on spectra
 induced (K A : C.Algebra) (phi : C.Hom K A) (x : C.Spec A) : C.Spec K = C.compose K A C.base x phi ;
 module At (k : Presentation) (K : C.Algebra) (pk : Presents k K) (A : C.Algebra) (fa : FP A) {
  V : U l = Fin k.1 ;
  ev : Pr.isEquiv A.ring.R (C.Spec A -> R.R) (C.evaluation A) = sqc A fa ;
  -- an element of A vanishes when it vanishes at every point
  vanishes (a : A.ring.R) (h : (x : C.Spec A) -> Id R.R (x.1.1 a) R.z) : Id A.ring.R a A.ring.z =
   E.injective A.ring.R (C.Spec A -> R.R) (C.evaluation A) ev a A.ring.z
    (F.funext (C.Spec A) (\ x -> R.R) _ _ (\ x -> trans (h x) (sym (RingHom[l].zero A.ring R x.1)))) ;
  zeros-from-points (a : V -> A.ring.R) (b : C.Spec A -> V -> R.R)
   (hb : (x : C.Spec A) (v : V) -> Id R.R (x.1.1 (a v)) (b x v)) :
   (es : Equations V) -> ((x : C.Spec A) -> Zeros V C.base (b x) es) -> Zeros V A a es = split {
   nil -> \ z -> tt ;
   cons e es | r -> \ z -> (vanishes (eval V A a e) (\ x ->
     trans (natural V A C.base x a e) (trans (G.eval-ext V C.base _ (b x) (hb x) e) (z x).1)),
    r (\ x -> (z x).2)) } ;
  -- Solutions k A = (Spec A -> Solutions k R)
  module Pointwise {
   forward (s : Solutions k A) (x : C.Spec A) : Solutions k C.base = canonical k A s C.base x ;
   value (u : C.Spec A -> Solutions k C.base) (v : V) : A.ring.R = ev.sec (\ x -> (u x).1 v) ;
   value-at (u : C.Spec A -> Solutions k C.base) (x : C.Spec A) (v : V) :
    Id R.R (x.1.1 (value u v)) ((u x).1 v) =
    Pr.happly (C.Spec A) (\ x -> R.R) _ _ (ev.sec-eq (\ x -> (u x).1 v)) x ;
   backward (u : C.Spec A -> Solutions k C.base) : Solutions k A =
    (value u,zeros-from-points (value u) (\ x -> (u x).1) (value-at u) k.2 (\ x -> (u x).2)) ;
   fb (u : C.Spec A -> Solutions k C.base) : Id (C.Spec A -> Solutions k C.base) (\ x -> forward (backward u) x) u =
    F.funext (C.Spec A) (\ x -> Solutions k C.base) _ u (\ x ->
     solutions-ext k C.base _ (u x) (value-at u x)) ;
   bf (s : Solutions k A) : Id (Solutions k A) (backward (\ x -> forward s x)) s =
    solutions-ext k A _ s (\ v -> Pr.sec-ret A.ring.R (C.Spec A -> R.R) (C.evaluation A) ev (s.1 v)) ;
   equivalence : Pr.Equiv (Solutions k A) (C.Spec A -> Solutions k C.base) =
    (\ s x -> forward s x,Pr.qinv _ _ (\ s x -> forward s x) backward fb bf) ;
  } ;
  chain : Pr.Equiv (C.Hom K A) (C.Spec A -> C.Spec K) =
   E.compose _ _ _ (canonical k K pk.1 A,pk.2 A)
    (E.compose _ _ _ Pointwise.equivalence
     (Fn.post (C.Spec A) (Solutions k C.base) (C.Spec K)
      (Fn.inverse (C.Spec K) (Solutions k C.base) (canonical k K pk.1 C.base,pk.2 C.base)))) ;
  theorem : Pr.isEquiv (C.Hom K A) (C.Spec A -> C.Spec K) (induced K A) =
   E.homotopy _ _ chain (induced K A) (\ phi ->
    F.funext (C.Spec A) (\ x -> C.Spec K) _ _ (\ x -> sym (trans
     (Pr.ap (Solutions k C.base) (C.Spec K) (pk.2 C.base).sec
      (canonical k A (canonical k K pk.1 A phi) C.base x) (canonical k K pk.1 C.base (induced K A phi x))
      (solutions-ext k C.base (canonical k A (canonical k K pk.1 A phi) C.base x) (canonical k K pk.1 C.base (induced K A phi x))
      (\ v -> refl (x.1.1 (phi.1.1 (pk.1.1 v))))))
     (Pr.sec-ret (C.Hom K C.base) (Solutions k C.base) (canonical k K pk.1 C.base) (pk.2 C.base) (induced K A phi x))))) ;
 } ;
 ------------------------------------------------------------------
 -- 3.2.2 for maps of affine schemes
 Pullback (X Y Z : U l) (f : X -> Z) (g : Y -> Z) : U l = (x : X) * (y : Y) * Id Z (f x) (g y) ;
 module Maps (A B K : C.Algebra) (fs : C.Hom K A) (gs : C.Hom K B) {
  module Sq = PO.Square[A,B,K,fs,gs] ;
  Fibre (x : C.Spec A) (y : C.Spec B) : U l =
   (c : K.ring.R) -> Id R.R (x.1.1 (fs.1.1 c)) (y.1.1 (gs.1.1 c)) ;
  to (x : C.Spec A) (y : C.Spec B) (h : Fibre x y) : Id (C.Spec K) (induced K A fs x) (induced K B gs y) =
   C.ext K C.base _ _ h ;
  from (x : C.Spec A) (y : C.Spec B) (h : Id (C.Spec K) (induced K A fs x) (induced K B gs y)) : Fibre x y =
   \ c -> ap (\ z -> z.1.1 c) h ;
  PB : U l = Pullback (C.Spec A) (C.Spec B) (C.Spec K) (induced K A fs) (induced K B gs) ;
  -- the cocone description of the pullback agrees with the usual one
  pullback : Pr.Equiv (Sq.Cocone C.base) PB =
   (\ d -> (d.1.1,d.1.2,to d.1.1 d.1.2 d.2),
    Pr.qinv (Sq.Cocone C.base) PB (\ d -> (d.1.1,d.1.2,to d.1.1 d.1.2 d.2)) (\ e -> ((e.1,e.2.1),from e.1 e.2.1 e.2.2))
     (\ e -> Pr.ap (Id (C.Spec K) (induced K A fs e.1) (induced K B gs e.2.1))
       PB (\ q -> (e.1,e.2.1,q)) _ _ (spec-set K _ _ _ _))
     (\ d -> Pr.ap (Fibre d.1.1 d.1.2) (Sq.Cocone C.base) (\ q -> (d.1,q)) _ _
       (Sq.cocone-prop C.base d.1 _ _))) ;
  spec-pullback (T : C.Algebra) (c : Sq.Pushout T) :
   Pr.Equiv (C.Spec T) PB =
   E.compose _ _ _ (Sq.spec-pullback T c) pullback ;
 } ;
 -- 3.2.2: the pullback of maps between finitely presented affine schemes
 -- is a finitely presented affine scheme
 module Affine (A B K : C.Algebra) (fa : FP A) (fb : FP B) (fk : FP K)
  (f : C.Spec A -> C.Spec K) (g : C.Spec B -> C.Spec K) {
  Arrows : U l = (C.Spec A -> C.Spec K) * (C.Spec B -> C.Spec K) ;
  PB (fg : Arrows) : U l = Pullback (C.Spec A) (C.Spec B) (C.Spec K) fg.1 fg.2 ;
  Result : U l+ = (T : C.Algebra) * Pr.Equiv (C.Spec T) (PB (f,g)) * FP T ;
  module Goal = Tr1.Trunc[Result] ;
  module With (wk : Witness K) {
   fs : C.Hom K A = At[wk.1,K,wk.2,A,fa].theorem.sec f ;
   gs : C.Hom K B = At[wk.1,K,wk.2,B,fb].theorem.sec g ;
   arrows : Id Arrows (induced K A fs,induced K B gs) (f,g) =
    Pr.trans Arrows _ (f,induced K B gs) _
     (Pr.ap (C.Spec A -> C.Spec K) Arrows (\ u -> (u,induced K B gs)) _ _ (At[wk.1,K,wk.2,A,fa].theorem.sec-eq f))
     (Pr.ap (C.Spec B -> C.Spec K) Arrows (\ u -> (f,u)) _ _ (At[wk.1,K,wk.2,B,fb].theorem.sec-eq g)) ;
   along : Pr.Equiv (PB (induced K A fs,induced K B gs)) (PB (f,g)) =
    Axioms[l].idtoeqv _ _ (Prelude[l+].ap Arrows (U l) PB _ _ arrows) ;
   result (r : PO.Result A B K fs gs) : Result =
    (r.1,E.compose _ _ _ (Maps[A,B,K,fs,gs].spec-pullback r.1 r.2.1) along,r.2.2) ;
   exists : Goal.carrier =
    Tr1.Trunc[PO.Result A B K fs gs].induction @(l+) (\ t -> Goal.carrier) (\ t -> Goal.proposition)
     (\ r -> Goal.inc (result r)) (PO.Exists[A,B,K,fs,gs].exists fa fb fk) ;
  } ;
  exists : Goal.carrier =
   Tr1.Trunc[Witness K].induction @(l+) (\ t -> Goal.carrier) (\ t -> Goal.proposition)
    (\ wk -> With[wk].exists) fk ;
 } ;
} ;
