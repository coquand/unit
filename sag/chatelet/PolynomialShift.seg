level l ; open Ring[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module P = Poly[l].PolyR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module IA = Ideals[l].Over[B.ring,B.set] ;
 shift : Nat -> P.P -> P.P = split {
  zero -> \ p -> p ;
  suc n | ih -> \ p -> cons A.z (ih p) } ;
 coefficient : (n : Nat) (p : P.P) (r : Nat) ->
  Id A.R (P.coef (shift n p) (plus n r)) (P.coef p r) = split {
  zero -> \ p r -> refl (P.coef p r) ;
  suc n | ih -> \ p r -> ih p r } ;
 bound : (n : Nat) (r : Nat) (p : P.P) -> Bounds.Bound r p ->
  Bounds.Bound (plus n r) (shift n p) = split {
  zero -> \ r p h -> h ;
  suc n | ih -> \ r p h -> ih r p h } ;
 shift-equation (p : P.P) :
  Id B.Carrier (B.mulQ B.variable (B.include p)) (B.include (cons A.z p)) =
  sym (trans (B.horner A.z p)
   (trans (ap (\ a -> B.addQ a (B.mulQ B.variable (B.include p)))
     (RingHom[l].zero A B.ring B.inclusion))
    (RL[B.ring].zl (B.mulQ B.variable (B.include p))))) ;
 member (I : IA.Ideal) : (n : Nat) (p : P.P) -> I.1 (B.include p) -> I.1 (B.include (shift n p)) = split {
  zero -> \ p h -> h ;
  suc n | ih -> \ p h ->
   IA.In[I].equal _ _ (shift-equation (shift n p))
    (I.2.2.2.2 B.variable (B.include (shift n p)) (ih p h)) } ;
 module Reduction (C : CRing) (phi : RingHom[l].Hom A C) {
  module Red = DivisionReduction[l].Over[A,C,setA,phi] ;
  reduced-bound : (n : Nat) (r : Nat) (p : P.P) -> Red.Bound r p ->
   Red.Bound (plus n r) (shift n p) = split {
   zero -> \ r p h -> h ;
   suc n | ih -> \ r p h -> ih r p h } ;
 } ;
} ;
