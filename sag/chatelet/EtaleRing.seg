-- sevb Lemma 1.1.3 and Remark 1.1.4, using the monic power basis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module EQ = Equivalences[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module T = ET.T ;
 module S = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module EM = EtaleModal[l,l].Over[ET.I,ET.G] ;
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module At (i : ET.I) {
  module Gen = EtaleRoots[l].Over[R,setR].Generator[i] ;
  module B = Gen.B ;
  module Roots = Gen.Roots ;
  module Positive = Gen.Positive ;
  sqc : Pr.isEquiv B.A.ring.R (ET.Root i -> R.R) Roots.root-evaluation = Roots.sqc-root axioms.sqc ;
  unique (r s : R.R) (e : (g : ET.G i) -> Id R.R r s) : Id R.R r s =
   Positive.iota-injective r s
    (EQ.injective B.A.ring.R (ET.Root i -> R.R) Roots.root-evaluation sqc _ _
     (FL.funext (ET.Root i) (\ x -> R.R) _ _ (\ x ->
       trans (Roots.root-evaluation-iota r x)
        (trans (e (ET.root-inc i x)) (sym (Roots.root-evaluation-iota s x)))))) ;
  module Function (h : ET.G i -> R.R) {
   a : B.A.ring.R = sqc.sec (\ x -> h (ET.root-inc i x)) ;
   value (x : ET.Root i) : Id R.R (Roots.root-evaluation a x) (h (ET.root-inc i x)) =
    Pr.happly (ET.Root i) (\ x -> R.R) _ _ (sqc.sec-eq (\ x -> h (ET.root-inc i x))) x ;
   constant (x : ET.Root i) : Id B.A.ring.R a (B.A.iota.1 (h (ET.root-inc i x))) =
    EQ.injective B.A.ring.R (ET.Root i -> R.R) Roots.root-evaluation sqc _ _
     (FL.funext (ET.Root i) (\ y -> R.R) _ _ (\ y ->
       trans (value y)
        (trans (ap h (ET.G-prop i (ET.root-inc i y) (ET.root-inc i x)))
         (sym (Roots.root-evaluation-iota (h (ET.root-inc i x)) y))))) ;
   section : R.R = Positive.constant-term a ;
   section-root (x : ET.Root i) : Id R.R section (h (ET.root-inc i x)) =
    trans (ap Positive.constant-term (constant x)) (Positive.constant-term-iota (h (ET.root-inc i x))) ;
   section-point : (g : ET.G i) -> Id R.R section (h g) =
    Tr.Trunc[ET.Root i].induction @l (\ g -> Id R.R section (h g)) (\ g -> setR _ _) section-root ;
   opaque section ;
  } ;
 } ;
 R-local : T.isModal @l R.R = \ i ->
  Pr.qinv R.R (ET.G i -> R.R) (\ r g -> r) (\ h -> At[i].Function[h].section)
   (\ h -> FL.funext (ET.G i) (\ g -> R.R) _ h At[i].Function[h].section-point)
   (\ r -> At[i].unique _ r At[i].Function[\ g -> r].section-point) ;
 opaque R-local ;
 top-local : T.isModal @l Top = S.modal-of-sec Top P.top-prop (\ i h -> tt) ;
 zeros-local (n : Nat) (v : Fin n -> R.R) : (es : P.Equations (Fin n)) ->
  T.isModal @l (P.Zeros (Fin n) C.base v es) = split {
  nil -> top-local ;
  cons e es | ih -> S.modal-Sigma (Id R.R (P.eval (Fin n) C.base v e) R.z)
   (\ q -> P.Zeros (Fin n) C.base v es)
   (S.modal-Id R.R R-local (P.eval (Fin n) C.base v e) R.z) (\ q -> ih) } ;
 solutions-local (p : P.Presentation) : T.isModal @l (SA.Sol p) =
  S.modal-Sigma (Fin p.1 -> R.R) (\ v -> P.Zeros (Fin p.1) C.base v p.2)
   (S.modal-Pi (Fin p.1) (\ t -> R.R) (\ t -> R-local)) (\ v -> zeros-local p.1 v p.2) ;
 affine-local (X : U l) (aff : SA.Affine X) : T.isModal @l X =
  EM.Mere[X,SA.set X aff,
   Tr.Trunc[SA.Witness X].induction @l (\ t -> Tr.Trunc[T.isModal @l X].carrier)
    (\ t -> Tr.Trunc[T.isModal @l X].proposition)
    (\ w -> Tr.Trunc[T.isModal @l X].inc
      (EM.modal-along (SA.Sol w.1) X (Functions[l].inverse X (SA.Sol w.1) w.2) (solutions-local w.1))) aff].modal ;
} ;
