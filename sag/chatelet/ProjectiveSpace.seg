-- The two definitions of P^n in Remark 1.1 of projective.pdf agree:
--   equivalence : Equiv ((l : Line) * (l^{n+1} \ {0})) (R^{n+1} \ {0} / R^*).
-- Forward: (l,v) |-> [v t] for any point t of the torsor of l.
-- Backward: [x] |-> (trivial line, the vector s |-> (s - t0)^-1 x).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat) {
 open R ; open RL[R] ;
 module Q2 = ProjectiveQuotient[l].Over[R,setR,n] ;
 module Ln = ProjectiveLines[l].Over[R,setR,n] ;
 module L = Ln.L ;
 module G = Ln.G ;
 module TI = Ln.TI ;
 V : U l = Q2.V ;
 Line : U l = L.Line ;
 Car (a : Line) : U l = Ln.Car a ;
 act (a : Line) (g : G.Unit) (t : Car a) : Car a = Ln.act a g t ;

 -- differences in a torsor
 module TorFacts (X : TI.Tor) {
  module D = Torsor[l].TorBase[G.group].D[X.1,X.2] ;
  diff-act (x0 s : X.1) (g : G.Unit) : Id G.Unit (D.diff x0 (X.2.1 g s)) (G.times g (D.diff x0 s)) =
   D.uniq x0 (X.2.1 g s) (G.times g (D.diff x0 s))
    (trans (X.2.2.2.1 g (D.diff x0 s) x0) (ap (X.2.1 g) (D.dact x0 s))) ;
  diff-self (x0 : X.1) : Id G.Unit (D.diff x0 x0) G.one = D.uniq x0 x0 G.one (X.2.2.2.2.1 x0) ;
 } ;
 -- the torsor map sending x0 to y0
 through (X Y : TI.Tor) (x0 : X.1) (y0 : Y.1) : TI.Hom X Y =
  (\ s -> Y.2.1 (TorFacts[X].D.diff x0 s) y0,
   \ g s -> trans (ap (\ u -> Y.2.1 u y0) (TorFacts[X].diff-act x0 s g))
    (Y.2.2.2.1 g (TorFacts[X].D.diff x0 s) y0)) ;

 -- u^-1 (b (u x)) = b x
 unscale (u : G.Unit) (b : R.R) (x : V) : Id V (Q2.scale u.2.1 (Q2.scale b (Q2.scale u.1 x))) (Q2.scale b x) =
  Q2.vector-eq _ _ (\ i -> calc R.R {
   mul u.2.1 (mul b (mul u.1 (x i)))
    =< ap (mul u.2.1) (trans (mulA b u.1 (x i)) (trans (ap (\ t -> mul t (x i)) (mulC b u.1)) (sym (mulA u.1 b (x i)))))
    > mul u.2.1 (mul u.1 (mul b (x i)))
    =< mulA u.2.1 u.1 (mul b (x i)) > mul (mul u.2.1 u.1) (mul b (x i))
    =< ap (\ t -> mul t (mul b (x i))) (G.inverse u).2.2 > mul o (mul b (x i))
    =< trans (mulC o (mul b (x i))) (mulO (mul b (x i))) > mul b (x i) }) ;

 -- the equivariant vector through a point: s |-> (s - t)^-1 x
 module Through (a : Line) (t : Car a) (x : Q2.Point) {
  module T = TorFacts[L.torsor a] ;
  v (s : Car a) : V = Q2.scale (G.inverse (T.D.diff t s)).1 x.1 ;
  equivariant : Ln.Equivariant a v = \ g s ->
   trans (ap (\ u -> Q2.scale (G.inverse u).1 x.1) (T.diff-act t s g))
    (sym (Q2.scale-scale g.2.1 (T.D.diff t s).2.1 x.1)) ;
  vectors : Ln.Vectors a = (v,equivariant,\ s -> Q2.nonzero-scale (G.inverse (T.D.diff t s)) x.1 x.2) ;
  at-point : Id V (v t) x.1 =
   trans (ap (\ u -> Q2.scale (G.inverse u).1 x.1) (T.diff-self t)) (Q2.scale-one x.1) ;
 } ;

 -- (i) -> (ii)
 module Forward (z : Ln.Pn) {
  a : Line = z.1 ;
  f (t : Car a) : Q2.Pn = Q2.class (z.2.1 t,z.2.2.2 t) ;
  module T = TorFacts[L.torsor a] ;
  constant (t t' : Car a) : Id Q2.Pn (f t) (f t') =
   Q2.Q.relates (z.2.1 t,z.2.2.2 t) (z.2.1 t',z.2.2.2 t') (G.inverse (T.D.diff t t'),
    sym (trans (sym (ap z.2.1 (T.D.dact t t'))) (z.2.2.1 (T.D.diff t t') t))) ;
  module M = TruncatedMap[l].Map[Car a,Q2.Pn,Q2.Q.set,f,constant] ;
  image : Q2.Pn = M.map (L.torsor a).2.2.2.2.2.2 ;
  beta (t : Car a) : Id Q2.Pn image (f t) = M.beta (L.torsor a).2.2.2.2.2.2 t ;
 } ;
 forward (z : Ln.Pn) : Q2.Pn = Forward[z].image ;

 -- (ii) -> (i)
 base : Line = L.trivial ;
 t0 : Car base = L.trivial-point ;
 lift (x : Q2.Point) : Ln.Pn = (base,Through[base,t0,x].vectors) ;
 module Respect (x y : Q2.Point) (r : Q2.Related x y) {
  g : G.Unit = r.1 ;
  d (s : Car base) : G.Unit = Through[base,t0,x].T.D.diff t0 s ;
  over : Ln.Over-hom base base (TI.transl (L.torsor base) g) Through[base,t0,x].vectors Through[base,t0,y].vectors =
   \ s -> trans (Through[base,t0,y].equivariant g s)
    (trans (ap (\ w -> Q2.scale g.2.1 (Q2.scale (d s).2.1 w)) (sym r.2)) (unscale g (d s).2.1 x.1)) ;
  result : Id Ln.Pn (lift x) (lift y) = Ln.path base base (TI.transl (L.torsor base) g) _ _ over ;
 } ;
 module D2 = Q2.Q.Descend[Ln.Pn,Ln.set,lift,\ x y r -> Respect[x,y,r].result] ;
 backward (q : Q2.Pn) : Ln.Pn = D2.map q ;

 module Back (z : Ln.Pn) (t : Car z.1) {
  x : Q2.Point = (z.2.1 t,z.2.2.2 t) ;
  hom : L.Hom base z.1 = through (L.torsor base) (L.torsor z.1) t0 t ;
  over : Ln.Over-hom base z.1 hom Through[base,t0,x].vectors z.2 =
   \ s -> z.2.2.1 (Through[base,t0,x].T.D.diff t0 s) t ;
  result : Id Ln.Pn (backward (forward z)) z =
   trans (ap backward (Forward[z].beta t)) (trans (D2.beta x) (Ln.path base z.1 hom _ z.2 over)) ;
 } ;
 back (z : Ln.Pn) : Id Ln.Pn (backward (forward z)) z =
  Tr.Trunc[Car z.1].induction @l (\ h -> Id Ln.Pn (backward (forward z)) z) (\ h -> Ln.set _ _)
   (\ t -> Back[z,t].result) (L.torsor z.1).2.2.2.2.2.2 ;
 front-class (x : Q2.Point) : Id Q2.Pn (forward (backward (Q2.class x))) (Q2.class x) =
  trans (ap forward (D2.beta x))
   (trans (Forward[lift x].beta t0) (ap Q2.class (Q2.point-eq (Through[base,t0,x].v t0,Through[base,t0,x].vectors.2.2 t0) x Through[base,t0,x].at-point))) ;
 front (q : Q2.Pn) : Id Q2.Pn (forward (backward q)) q =
  Q2.Q.induction @l (\ q -> Id Q2.Pn (forward (backward q)) q) (\ q -> Q2.Q.set _ _) front-class q ;

 equivalence : Pr.Equiv Ln.Pn Q2.Pn = (forward,Pr.qinv Ln.Pn Q2.Pn forward backward front back) ;
} ;
