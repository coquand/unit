-- Theorem 3.4.2 of sevb.pdf (Chatelet): a Severi-Brauer variety X : SB_n
-- with a point is P^n:  ||X|| -> ||X = P^n||.
--
-- By Prop 3.3.1, X = RI(A) for some A : AZ_n.  A point of X is a right
-- ideal I : RI(A); its basis is T-local, and "finite free descends" makes
-- it a basis b.  Lemma 3.4.1 (with End(I)^op = M_N(R)^op = M_N(R) inside
-- it) gives A = M_N(R) by the SIP, so X = RI(A) = RI(M_N(R)) = P^n (delta).
--
-- Descent is needed only for algebras locally equal to M_N(R).
-- Over retains the earlier unrestricted interface as a compatibility wrapper.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module P2 = Prelude[l++] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module Tr2 = Truncation[l++] ;
module OverAzumaya (R : CRing) (setR : Pr.isSet R.R) (n0 : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (cls : Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem)
 (I : U l) (G : I -> U l)
 (sh : [j] SheafClosure[l,j].Over[I,G].Ops)
 (R-modal : SheafTopology[l].Over[I,G].isModal @l R.R)
 (descends : (A : AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Alg) ->
   SheafTopology[l].Over[I,G].isModal @l A.A ->
   (sh @(l+)).close (Id AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Alg A
    MnAlgebra[l].Over[R,setR,suc (suc n0)].algebra) ->
   (S : AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Sub A) ->
   (sh @l).close (AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Basis A S) ->
   Tr.Trunc[AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Basis A S].carrier) {
 module AP = AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh] ;
 module S0 = SheafLemmas[l,l].Over[I,G] ;
 Mt : AP.Alg = MnAlgebra[l].Over[R,setR,suc (suc n0)].algebra ;
 Mt-modal : SheafTopology[l].Over[I,G].isModal @l Mt.A =
  S0.modal-Pi (Fin (suc (suc n0))) (\ i -> Fin (suc (suc n0)) -> R.R) (\ i ->
   S0.modal-Pi (Fin (suc (suc n0))) (\ j -> R.R) (\ j -> R-modal)) ;
 descends-M (S : AP.Sub Mt) : (sh @l).close (AP.Basis Mt S) -> Tr.Trunc[AP.Basis Mt S].carrier =
  descends Mt Mt-modal ((sh @(l+)).inc (Id AP.Alg Mt Mt) (refl Mt)) S ;
 module PR = Prop331[l].Over[R,setR,n0,sag,cls,I,G,sh,R-modal,descends-M] ;
 module L341 = Lemma341[l].Over[R,setR,suc n0,I,G,sh,sag.loc,R-modal,descends-M] ;
 module DL = PR.DL ;
 module AS = PR.AS ;
 Pn : U l = PR.Pn ;
 AZ : U l+ = PR.AZ ;
 SB : U l++ = PR.SB ;
 Goal (X : SB) : U l++ = Tr2.Trunc[Id (U l+) X.1 Pn].carrier ;
 module At (X : SB) {
  A : AZ = PR.prop-3-3-1.sec X ;
  -- X = RI(A)
  e : Id (U l+) (AP.RI A.1) X.1 = PR.fstSB (PR.f A) X (PR.prop-3-3-1.sec-eq X) ;
  module WithBasis (J : AP.RI A.1) (b : AP.Basis A.1 J.1) {
   s : Id AP.Alg A.1 Mt = AS.sip A.1 Mt (L341.lemma-3-4-1 A J b) ;
   path : Id (U l+) X.1 Pn =
    P2.trans (U l+) X.1 (AP.RI A.1) Pn (P2.sym (U l+) (AP.RI A.1) X.1 e)
     (P2.trans (U l+) (AP.RI A.1) (AP.RI Mt) Pn (P2.ap AP.Alg (U l+) AP.RI A.1 Mt s) DL.delta) ;
  } ;
  at-point (x : X.1) : Goal X =
   let { J : AP.RI A.1 = P1.coe X.1 (AP.RI A.1) (P2.sym (U l+) (AP.RI A.1) X.1 e) x ; }
   in Tr.Trunc[AP.Basis A.1 J.1].induction @(l++) (\ t -> Goal X) (\ t -> Tr2.Trunc[Id (U l+) X.1 Pn].proposition)
    (\ b -> Tr2.Trunc[Id (U l+) X.1 Pn].inc WithBasis[J,b].path)
    (descends A.1 A.2.1 A.2.2 J.1 J.2.2) ;
 } ;
 -- Chatelet's theorem
 theorem-3-4-2 (X : SB) (x : Tr1.Trunc[X.1].carrier) : Goal X =
  Tr1.Trunc[X.1].induction @(l++) (\ t -> Goal X) (\ t -> Tr2.Trunc[Id (U l+) X.1 Pn].proposition) At[X].at-point x ;
} ;
-- Existing clients may still supply the stronger descent hypothesis.
module Over (R : CRing) (setR : Pr.isSet R.R) (n0 : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (cls : Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem)
 (I : U l) (G : I -> U l)
 (sh : [j] SheafClosure[l,j].Over[I,G].Ops)
 (R-modal : SheafTopology[l].Over[I,G].isModal @l R.R)
 (descends : (A : AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Alg) ->
   SheafTopology[l].Over[I,G].isModal @l A.A ->
   (S : AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Sub A) ->
   (sh @l).close (AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Basis A S) ->
   Tr.Trunc[AzumayaProbe[l].Over[R,setR,suc n0,I,G,sh].Basis A S].carrier) {
 module Core = OverAzumaya[R,setR,n0,sag,cls,I,G,sh,R-modal,\ A modal local -> descends A modal] ;
 module AP = Core.AP ; module S0 = Core.S0 ;
 Mt : AP.Alg = Core.Mt ;
 Mt-modal : SheafTopology[l].Over[I,G].isModal @l Mt.A = Core.Mt-modal ;
 descends-M (S : AP.Sub Mt) : (sh @l).close (AP.Basis Mt S) -> Tr.Trunc[AP.Basis Mt S].carrier = Core.descends-M S ;
 module PR = Core.PR ; module L341 = Core.L341 ; module DL = Core.DL ; module AS = Core.AS ;
 Pn : U l = Core.Pn ; AZ : U l+ = Core.AZ ; SB : U l++ = Core.SB ;
 Goal (X : SB) : U l++ = Core.Goal X ;
 module At (X : SB) { module Original = Core.At[X] ;
  A : AZ = Original.A ;
  e : Id (U l+) (AP.RI A.1) X.1 = Original.e ;
  module WithBasis (J : AP.RI A.1) (b : AP.Basis A.1 J.1) {
   s : Id AP.Alg A.1 Mt = Original.WithBasis[J,b].s ;
   path : Id (U l+) X.1 Pn = Original.WithBasis[J,b].path ;
  } ;
  at-point (x : X.1) : Goal X = Original.at-point x ;
 } ;
 theorem-3-4-2 (X : SB) (x : Tr1.Trunc[X.1].carrier) : Goal X = Core.theorem-3-4-2 X x ;
} ;
