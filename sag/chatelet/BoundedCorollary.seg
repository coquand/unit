-- SAG 3.3.3 by the paper's route: f : Spec A -> N gives the eventually
-- vanishing sequences s(x)(n) = 1 if n < f x, 0 otherwise; 3.3.2 bounds
-- them all, and 1 != 0 turns that bound into a bound for f.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ;
le-refl : (n : Nat) -> CB.le n n = split { zero -> tt ; suc n | r -> r } ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC)
 (one-nz : Id R.R R.o R.z -> Empty) {
 module C = Algebras[l].Over[R,setR] ;
 module V = Vanishing[l].Over[R,setR,sqc] ;
 -- step m n = 1 if n < m, 0 otherwise
 step : Nat -> Nat -> R.R = split {
  zero -> \ n -> R.z ;
  suc m | r -> split { zero -> R.o ; suc n -> r n } } ;
 step-vanishes : (m n : Nat) -> CB.le m n -> Id R.R (step m n) R.z = split {
  zero -> \ n h -> refl R.z ;
  suc m | r -> split { zero -> \ h -> efq h ; suc n -> \ h -> r n h } } ;
 step-decide : (m n : Nat) -> Plus (CB.le m n) (Id R.R (step m n) R.o) = split {
  zero -> \ n -> inl tt ;
  suc m | r -> split { zero -> inr (refl R.o) ; suc n -> r n } } ;
 resolve (m N : Nat) (h : Id R.R (step m N) R.z) : Plus (CB.le m N) (Id R.R (step m N) R.o) -> CB.le m N = split {
  inl k -> k ; inr e -> efq (one-nz (trans (sym e) h)) } ;
 module Theorem (A : C.Algebra) (fa : Presentations[l].Over[R,setR].FP A) (f : C.Spec A -> Nat) {
  module L = V.Lemma[A,fa,\ x -> step (f x),\ x -> Tr.Trunc[V.Vanishing (step (f x))].inc (f x,step-vanishes (f x))] ;
  Goal : U l = (N : Nat) * ((x : C.Spec A) -> CB.le (f x) N) ;
  theorem : Tr.Trunc[Goal].carrier =
   Tr.Trunc[L.Goal].induction @l (\ t -> Tr.Trunc[Goal].carrier) (\ t -> Tr.Trunc[Goal].proposition)
    (\ w -> Tr.Trunc[Goal].inc (w.1,\ x ->
     resolve (f x) w.1 (w.2 x w.1 (le-refl w.1)) (step-decide (f x) w.1))) L.theorem ;
 } ;
} ;
