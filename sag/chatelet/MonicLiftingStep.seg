-- The degree-r / degree-(r+1) step of Appendix 1, Lemma 7.5.
-- The reduction map may be any ring map for which elements mapping to 1
-- are invertible (in particular reduction modulo a Jacobson-radical ideal).
level l ; open Ring[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R) (phi : RingHom[l].Hom A C)
 (lift-unit : (a : A.R) -> Id C.R (phi.1 a) C.o -> RL[A].unit a) {
 module P = Poly[l].PolyR[A] ;
 module MulA = Mul[l].MulR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Reduction = DivisionReduction[l].Over[A,C,setA,phi] ;
 module IA = Ideals[l].Over[B.ring,B.set] ;
 module CR = RL[C] ;
 module At (I : IA.Ideal) (r : Nat) (f g : P.P)
  (f-leading : Id A.R (P.coef f (suc r)) A.o)
  (f-bound : Bounds.Bound (suc (suc r)) f)
  (f-member : I.1 (B.include f))
  (g-leading : Id C.R (phi.1 (P.coef g r)) C.o)
  (g-bound : Reduction.Bound (suc r) g)
  (g-member : I.1 (B.include g)) {
  module D = MonicDivision[l].Over[A,setA].General[f,suc r,f-leading,f-bound] ;
  module Red = Reduction.At[f,suc r,f-leading,f-bound] ;
  module Ideal = IdealArithmetic[l].Over[B.ring,B.set].In[I] ;
  division : D.Result g = D.divide g ;
  q : P.P = division.1 ;
  remainder : P.P = division.2.1 ;
  reduced : Reduction.Equal remainder g = Red.remainder-reduction g g-bound ;
  coefficient : A.R = P.coef remainder r ;
  coefficient-one : Id C.R (phi.1 coefficient) C.o = trans (reduced r) g-leading ;
  inverse : RL[A].unit coefficient = lift-unit coefficient coefficient-one ;
  polynomial : P.P = MulA.scal inverse.1 remainder ;
  bound : Bounds.Bound (suc r) polynomial =
   Bounds.scale-bound (suc r) inverse.1 remainder division.2.2.1 ;
  leading : Id A.R (P.coef polynomial r) A.o =
   trans (MulA.coef-scal inverse.1 remainder r)
    (trans (A.mulC inverse.1 coefficient) inverse.2) ;
  inverse-one : Id C.R (phi.1 inverse.1) C.o =
   trans (sym (trans (C.mulC C.o (phi.1 inverse.1)) (C.mulO (phi.1 inverse.1))))
    (trans (ap (\ a -> C.mul a (phi.1 inverse.1)) (sym coefficient-one))
     (trans (sym (phi.2.2.2 coefficient inverse.1))
      (trans (ap phi.1 inverse.2) phi.2.1))) ;
  reduction : Reduction.Equal polynomial g = \ k ->
   trans (ap phi.1 (MulA.coef-scal inverse.1 remainder k))
    (trans (phi.2.2.2 inverse.1 (P.coef remainder k))
     (trans (ap (\ a -> C.mul a (phi.1 (P.coef remainder k))) inverse-one)
      (trans (trans (C.mulC C.o (phi.1 (P.coef remainder k))) (C.mulO (phi.1 (P.coef remainder k))))
       (reduced k)))) ;
  remainder-member : I.1 (B.include remainder) =
   Ideal.remainder (B.include g) (B.mulQ (B.include f) (B.include q)) (B.include remainder)
    g-member
    (IA.In[I].equal _ _ (B.mul-comm (B.include q) (B.include f))
     (I.2.2.2.2 (B.include q) (B.include f) f-member))
    division.2.2.2 ;
  member : I.1 (B.include polynomial) =
   IA.In[I].equal _ _
    (trans (B.Multiply.beta (RawLaws[l].Laws[A].constantP inverse.1) remainder)
     (B.Q.relates _ _ (RawMultiplication[l].Laws[A].mul-single-left inverse.1 remainder)))
    (I.2.2.2.2 (B.constant inverse.1) (B.include remainder) remainder-member) ;
 } ;
} ;
