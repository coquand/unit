-- Coefficients of B[X] (PolynomialRing.Extension) and three consequences:
--   X is regular, a regular constant stays regular, and
--   c g = X^a h with c regular in B implies g = X^a g'.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (B : CRing) (setB : Pr.isSet B.R) {
 module X = PolynomialRing[l].Extension[B,setB] ;
 module PR = Poly[l].PolyR[B] ;
 module MR = Mul[l].MulR[B] ;
 module XP = AffinePowers[l].Over[X.ring] ;
 K : U l = X.Carrier ;
 Coeffs : U l = Nat -> B.R ;
 module CD = X.Q.Descend[Coeffs,F.isSet-Pi Nat (\ k -> B.R) (\ k -> setB),PR.coef,
   \ p q h -> F.funext Nat (\ k -> B.R) (PR.coef p) (PR.coef q) h] ;
 coef (g : K) (k : Nat) : B.R = CD.map g k ;
 coef-include (p : PR.P) (k : Nat) : Id B.R (coef (X.include p) k) (PR.coef p k) =
  Pr.happly Nat (\ k -> B.R) _ _ (CD.beta p) k ;
 Same (g h : K) : U l = (k : Nat) -> Id B.R (coef g k) (coef h k) ;
 same-prop (g h : K) : Pr.isProp (Same g h) =
  F.isProp-Pi Nat (\ k -> Id B.R (coef g k) (coef h k)) (\ k -> setB (coef g k) (coef h k)) ;
 -- coefficients determine the polynomial
 ext-include (p : PR.P) : (h : K) -> Same (X.include p) h -> Id K (X.include p) h =
  X.Q.induction @l (\ h -> Same (X.include p) h -> Id K (X.include p) h)
   (\ h -> F.isProp-Pi (Same (X.include p) h) (\ e -> Id K (X.include p) h) (\ e -> X.set (X.include p) h))
   (\ q e -> X.Q.relates p q (\ k -> trans (sym (coef-include p k)) (trans (e k) (coef-include q k)))) ;
 ext : (g h : K) -> Same g h -> Id K g h =
  X.Q.induction @l (\ g -> (h : K) -> Same g h -> Id K g h)
   (\ g -> F.isProp-Pi K (\ h -> Same g h -> Id K g h)
     (\ h -> F.isProp-Pi (Same g h) (\ e -> Id K g h) (\ e -> X.set g h)))
   ext-include ;
 coef-zero (k : Nat) : Id B.R (coef X.zeroQ k) B.z = coef-include nil k ;

 -- multiplication by X shifts
 shifted (p : PR.P) : Id K (X.mulQ X.variable (X.include p)) (X.include (cons B.z p)) =
  trans (X.Multiply.beta X.T p) (X.Q.relates _ _ (X.T-mul p)) ;
 shift-coef : (g : K) -> Id B.R (coef (X.mulQ X.variable g) zero) B.z * ((k : Nat) -> Id B.R (coef (X.mulQ X.variable g) (suc k)) (coef g k)) =
  X.Q.induction @l (\ g -> Id B.R (coef (X.mulQ X.variable g) zero) B.z * ((k : Nat) -> Id B.R (coef (X.mulQ X.variable g) (suc k)) (coef g k)))
   (\ g -> Pr.isProp-Sigma (Id B.R (coef (X.mulQ X.variable g) zero) B.z)
     (\ e -> (k : Nat) -> Id B.R (coef (X.mulQ X.variable g) (suc k)) (coef g k))
     (setB (coef (X.mulQ X.variable g) zero) B.z)
     (\ e -> F.isProp-Pi Nat (\ k -> Id B.R (coef (X.mulQ X.variable g) (suc k)) (coef g k))
       (\ k -> setB (coef (X.mulQ X.variable g) (suc k)) (coef g k))))
   (\ p -> (trans (ap (\ t -> coef t zero) (shifted p)) (coef-include (cons B.z p) zero),
     \ k -> trans (ap (\ t -> coef t (suc k)) (shifted p))
      (trans (coef-include (cons B.z p) (suc k)) (sym (coef-include p k))))) ;

 -- multiplication by a constant scales
 zero-tail : (k : Nat) -> Id B.R (PR.coef (cons B.z nil) k) B.z = split { zero -> refl B.z ; suc k -> refl B.z } ;
 constant-raw (c : B.R) (p : PR.P) (k : Nat) :
  Id B.R (PR.coef (MR.pmul p (cons c nil)) k) (B.mul c (PR.coef p k)) =
  trans (MR.coef-addP (MR.scal c p) (cons B.z nil) k)
   (trans (ap (B.add (PR.coef (MR.scal c p) k)) (zero-tail k))
    (trans (B.addZ (PR.coef (MR.scal c p) k)) (MR.coef-scal c p k))) ;
 scale-coef (c : B.R) : (g : K) (k : Nat) -> Id B.R (coef (X.mulQ (X.constant c) g) k) (B.mul c (coef g k)) =
  X.Q.induction @l (\ g -> (k : Nat) -> Id B.R (coef (X.mulQ (X.constant c) g) k) (B.mul c (coef g k)))
   (\ g -> F.isProp-Pi Nat (\ k -> Id B.R (coef (X.mulQ (X.constant c) g) k) (B.mul c (coef g k)))
     (\ k -> setB _ _))
   (\ p k -> trans (ap (\ t -> coef t k)
      (trans (X.mul-comm (X.constant c) (X.include p)) (X.Multiply.beta p (cons c nil))))
     (trans (coef-include (MR.pmul p (cons c nil)) k)
      (trans (constant-raw c p k) (ap (B.mul c) (sym (coef-include p k)))))) ;

 -- division by X when the constant term vanishes
 tailP : PR.P -> PR.P = split { nil -> nil ; cons a p -> p } ;
 coef-tail : (p : PR.P) (k : Nat) -> Id B.R (PR.coef (tailP p) k) (PR.coef p (suc k)) = split {
  nil -> \ k -> refl B.z ; cons a p -> \ k -> refl (PR.coef p k) } ;
 module TD = X.Q.Descend[K,X.set,\ p -> X.include (tailP p),
   \ p q h -> X.Q.relates (tailP p) (tailP q) (\ k -> trans (coef-tail p k) (trans (h (suc k)) (sym (coef-tail q k))))] ;
 tail (g : K) : K = TD.map g ;
 tail-coef : (g : K) (k : Nat) -> Id B.R (coef (tail g) k) (coef g (suc k)) =
  X.Q.induction @l (\ g -> (k : Nat) -> Id B.R (coef (tail g) k) (coef g (suc k)))
   (\ g -> F.isProp-Pi Nat (\ k -> Id B.R (coef (tail g) k) (coef g (suc k))) (\ k -> setB _ _))
   (\ p k -> trans (ap (\ t -> coef t k) (TD.beta p))
     (trans (coef-include (tailP p) k) (trans (coef-tail p k) (sym (coef-include p (suc k)))))) ;
 factor-same (g : K) (h0 : Id B.R (coef g zero) B.z) :
  (k : Nat) -> Id B.R (coef g k) (coef (X.mulQ X.variable (tail g)) k) = split {
   zero -> trans h0 (sym (shift-coef (tail g)).1) ;
   suc k -> sym (trans ((shift-coef (tail g)).2 k) (tail-coef g k)) } ;
 factor-variable (g : K) (h0 : Id B.R (coef g zero) B.z) : Id K g (X.mulQ X.variable (tail g)) =
  ext g (X.mulQ X.variable (tail g)) (factor-same g h0) ;

 -- consequences
 variable-cancel (g h : K) (e : Id K (X.mulQ X.variable g) (X.mulQ X.variable h)) : Id K g h =
  ext g h (\ k -> trans (sym ((shift-coef g).2 k)) (trans (ap (\ t -> coef t (suc k)) e) ((shift-coef h).2 k))) ;
 variable-regular (g : K) (e : Id K (X.mulQ X.variable g) X.zeroQ) : Id K g X.zeroQ =
  ext g X.zeroQ (\ k -> trans (sym ((shift-coef g).2 k))
   (trans (ap (\ t -> coef t (suc k)) e) (trans (coef-zero (suc k)) (sym (coef-zero k))))) ;
 constant-regular (c : B.R) (reg : (a : B.R) -> Id B.R (B.mul c a) B.z -> Id B.R a B.z)
  (g : K) (e : Id K (X.mulQ (X.constant c) g) X.zeroQ) : Id K g X.zeroQ =
  ext g X.zeroQ (\ k -> trans (reg (coef g k)
    (trans (sym (scale-coef c g k)) (trans (ap (\ t -> coef t k) e) (coef-zero k)))) (sym (coef-zero k))) ;
 divide (c : B.R) (reg : (a : B.R) -> Id B.R (B.mul c a) B.z -> Id B.R a B.z) :
  (a : Nat) (g h : K) -> Id K (X.mulQ (X.constant c) g) (X.mulQ (XP.power X.variable a) h) ->
  (g' : K) * Id K g (X.mulQ (XP.power X.variable a) g') = split {
  zero -> \ g h e -> (g,sym (XP.one-left g)) ;
  suc a | ih -> \ g h e ->
   let { g0 : Id B.R (coef g zero) B.z =
          reg (coef g zero) (trans (sym (scale-coef c g zero))
           (trans (ap (\ t -> coef t zero) (trans e (sym (X.mul-assoc X.variable (XP.power X.variable a) h))))
            (shift-coef (X.mulQ (XP.power X.variable a) h)).1)) ;
         g1 : K = tail g ;
         split-g : Id K g (X.mulQ X.variable g1) = factor-variable g g0 ;
         moved : Id K (X.mulQ X.variable (X.mulQ (X.constant c) g1)) (X.mulQ X.variable (X.mulQ (XP.power X.variable a) h)) =
          trans (X.mul-assoc X.variable (X.constant c) g1)
           (trans (ap (\ t -> X.mulQ t g1) (X.mul-comm X.variable (X.constant c)))
            (trans (sym (X.mul-assoc (X.constant c) X.variable g1))
             (trans (ap (X.mulQ (X.constant c)) (sym split-g))
              (trans e (sym (X.mul-assoc X.variable (XP.power X.variable a) h)))))) ;
         rest : (g' : K) * Id K g1 (X.mulQ (XP.power X.variable a) g') =
          ih g1 h (variable-cancel _ _ moved) ; } in
   (rest.1,trans split-g (trans (ap (X.mulQ X.variable) rest.2) (X.mul-assoc X.variable (XP.power X.variable a) rest.1))) } ;
} ;
