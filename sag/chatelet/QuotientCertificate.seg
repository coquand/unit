-- Every element killed by a finite quotient has an explicit ideal
-- certificate, merely. Extracted from finite equality derivations.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Relative (A : CRing) (setA : Pr.isSet A.R) (n : Nat) (fs : Fin n -> A.R) {
 module C = Algebras[l].Over[A,setA] ;
 module P = Presentations[l].Over[A,setA] ;
 module Finite = AffineFinite[l].Over[A,setA] ;
 V : U l = Fin zero ;
 es : Fin n -> P.Expr V = \ i -> cst (fs i) ;
 pres : P.Presentation = (zero,Finite.listed V n es) ;
 module K = PresentationExistence[l].Over[A,setA,pres] ;
 module D = ExpressionCongruence[l].Over[A,setA,pres] ;
 values : V -> A.R = split { } ;
 module T = FiniteIdealInterpretation[l].Over[A,setA,pres].In[C.base,values,n,fs] ;
 module I = FiniteIdeal[l].Over[A,n,fs] ;
 choose (t a : D.Term) (xs : List D.Term)
  (first : I.Certificate (T.ev a) A.z)
  (rest : (e : D.Term) -> D.Member e xs -> I.Certificate (T.ev e) A.z) :
  D.Member t (cons a xs) -> I.Certificate (T.ev t) A.z = split {
   inl h -> I.transitive _ _ _ (I.equal _ _ (ap T.ev h)) first ;
   inr h -> rest t h } ;
 listed-cert : (m : Nat) (eqs : Fin m -> D.Term)
  (certs : (i : Fin m) -> I.Certificate (T.ev (eqs i)) A.z) ->
  (t : D.Term) -> D.Member t (Finite.listed V m eqs) -> I.Certificate (T.ev t) A.z = split {
   zero -> \ eqs certs t e -> efq e ;
   suc m | ih -> \ eqs certs t -> choose t (eqs (inr tt)) (Finite.listed V m (\ i -> eqs (inl i)))
    (certs (inr tt)) (ih (\ i -> eqs (inl i)) (\ i -> certs (inl i))) } ;
 equations (t : D.Term) (h : D.Member t pres.2) : I.Certificate (T.ev t) (T.ev D.zeroE) =
  listed-cert n es I.generator t h ;
 module Interpret = T.Equations[equations] ;
 kills (i : Fin n) : Id K.A.Carrier (K.A.constant (fs i)) K.A.zeroQ =
  Finite.zeros-out V K.A.algebra K.A.generators n es K.A.solution.2 i ;
 kernel (a : A.R) (h : Id K.A.Carrier (K.A.constant a) K.A.zeroQ) :
  Tr.Trunc[I.Certificate a A.z].carrier =
  Interpret.certificate (cst a) (cst A.z) (K.A.Q.effective (cst a) (cst A.z) h) ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module Q = FiniteQuotient[l].Over[R,setR] ;
 module Model (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) {
  module Rel = Relative[A.ring,A.set,n,fs] ;
  target : C.Algebra = C.mkAlgebra Rel.K.A.ring Rel.K.A.set
   (RingHom[l].compose R A.ring Rel.K.A.ring Rel.K.A.inclusion A.iota) ;
  inclusion : C.Hom A target = (Rel.K.A.inclusion,\ r -> refl (Rel.K.A.constant (A.iota.1 r))) ;
  kills : Q.Kills A target n fs inclusion = Rel.kills ;
 }
 ;
 module At (A : C.Algebra) (n : Nat) (fs : Fin n -> A.ring.R) (q : Q.Witness A n fs) {
  module M = Model[A,n,fs] ;
  h : C.Hom q.1 M.target = (q.2.2.2.2 M.target).sec (M.inclusion,M.kills) ;
  beta : Id (C.Hom A M.target) (C.compose A q.1 M.target h q.2.2.1) M.inclusion =
   Pr.ap (Q.Data A M.target n fs) (C.Hom A M.target) (\ d -> d.1) _ _
    ((q.2.2.2.2 M.target).sec-eq (M.inclusion,M.kills)) ;
  kernel (a : A.ring.R) (vanish : Id q.1.ring.R (q.2.2.1.1.1 a) q.1.ring.z) :
   Tr.Trunc[FiniteIdeal[l].Over[A.ring,n,fs].Certificate a A.ring.z].carrier =
   M.Rel.kernel a
    (trans (sym (Pr.ap (C.Hom A M.target) M.target.ring.R (\ g -> g.1.1 a) _ _ beta))
     (trans (ap h.1.1 vanish) (RingHom[l].zero q.1.ring M.target.ring h.1))) ;
 } ;
} ;
