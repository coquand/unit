-- SAG 3.3.2. A family of eventually vanishing sequences on Spec A, for
-- finitely presented A, has a common bound.  As in the paper: such a
-- sequence is a polynomial in R[X]; A[X] = A (x) R[X]; 3.3.1 turns the
-- family into one polynomial over A; its length is the bound.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module E = Equivalences[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module CB = CoefficientBound[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 module P = Presentations[l].Over[R,setR] ;
 module C = Algebras[l].Over[R,setR] ;
 module TO = Tensor[l].Over[R,setR] ;
 module ST = SqcTensor[l].Over[R,setR,sqc] ;
 module AV = AddVariable[l].Over[R,setR] ;
 module RP = Poly[l].PolyR[R] ;
 module RX = C.Polynomial[C.base] ;
 rx-fp : P.FP RX.algebra = AV.preserves-FP C.base BasePresentation[l].Over[R,setR].finitely-presented ;
 point (D : C.Algebra) : C.Hom C.base D = (D.iota,\ r -> refl (D.iota.1 r)) ;
 base-initial (D : C.Algebra) (f g : C.Hom C.base D) : Id (C.Hom C.base D) f g =
  C.ext C.base D f g (\ r -> trans (f.2 r) (sym (g.2 r))) ;
 -- maps out of R[X] agree when they agree on X
 rx-eq (D : C.Algebra) (f g : C.Hom RX.algebra D)
  (h : Id D.ring.R (f.1.1 RX.X.variable) (g.1.1 RX.X.variable)) : Id (C.Hom RX.algebra D) f g =
  E.injective (C.Hom RX.algebra D) RX.To[D].Data RX.To[D].forward RX.To[D].universal.2 f g
   (Pr.trans RX.To[D].Data _ ((RX.To[D].forward g).1,f.1.1 RX.X.variable) _
    (Pr.ap (C.Hom C.base D) RX.To[D].Data (\ k -> (k,f.1.1 RX.X.variable)) _ _
     (base-initial D (RX.To[D].forward f).1 (RX.To[D].forward g).1))
    (Pr.ap D.ring.R RX.To[D].Data (\ y -> ((RX.To[D].forward g).1,y)) _ _ h)) ;
 ------------------------------------------------------------------
 -- A[X] is A (x) R[X]
 module PolyCoproduct (A : C.Algebra) {
  module AX = C.Polynomial[A] ;
  inA : C.Hom A AX.algebra = AX.inclusion ;
  inB : C.Hom RX.algebra AX.algebra = RX.To[AX.algebra].backward (point AX.algebra,AX.X.variable) ;
  inB-X : Id AX.X.Carrier (inB.1.1 RX.X.variable) AX.X.variable =
   Pr.ap RX.To[AX.algebra].Data AX.X.Carrier (\ d -> d.2) _ _ (RX.To[AX.algebra].fb (point AX.algebra,AX.X.variable)) ;
  module To (D : C.Algebra) {
   module UA = AX.To[D] ;
   Maps : U l = C.Hom A D * C.Hom RX.algebra D ;
   forward : C.Hom AX.algebra D -> Maps = TO.restrict A RX.algebra AX.algebra inA inB D ;
   given (d : Maps) : UA.Data = (d.1,d.2.1.1 RX.X.variable) ;
   backward (d : Maps) : C.Hom AX.algebra D = UA.backward (given d) ;
   fb (d : Maps) : Id Maps (forward (backward d)) d =
    Pr.trans Maps _ (d.1,(forward (backward d)).2) d
     (Pr.ap (C.Hom A D) Maps (\ k -> (k,(forward (backward d)).2)) _ _
      (Pr.ap UA.Data (C.Hom A D) (\ e -> e.1) _ _ (UA.fb (given d))))
     (Pr.ap (C.Hom RX.algebra D) Maps (\ k -> (d.1,k)) _ _
      (rx-eq D _ d.2 (trans (ap (backward d).1.1 inB-X)
       (Pr.ap UA.Data D.ring.R (\ e -> e.2) _ _ (UA.fb (given d)))))) ;
   bf (g : C.Hom AX.algebra D) : Id (C.Hom AX.algebra D) (backward (forward g)) g =
    E.injective (C.Hom AX.algebra D) UA.Data UA.forward UA.universal.2 _ g
     (Pr.trans UA.Data _ (given (forward g)) (UA.forward g) (UA.fb (given (forward g)))
      (Pr.ap AX.X.Carrier UA.Data (\ y -> ((forward g).1,g.1.1 y)) _ _ inB-X)) ;
   universal : Pr.isEquiv (C.Hom AX.algebra D) Maps forward = Pr.qinv _ _ forward backward fb bf ;
  } ;
  coproduct : TO.Coproduct A RX.algebra AX.algebra = (inA,inB,\ D -> To[D].universal) ;
 } ;
 ------------------------------------------------------------------
 -- eventually vanishing sequences are polynomials
 Seq : U l = Nat -> R.R ;
 seq-set : Pr.isSet Seq = F.isSet-Pi Nat (\ n -> R.R) (\ n -> setR) ;
 module Co = RX.X.Q.Descend[Seq,seq-set,RP.coef,\ p q h -> F.funext Nat (\ n -> R.R) _ _ h] ;
 coefficients : RX.X.Carrier -> Seq = Co.map ;
 coefficients-injective : (x y : RX.X.Carrier) ->
  Id Seq (coefficients x) (coefficients y) -> Id RX.X.Carrier x y =
  RX.X.forall2 (\ x y -> Id Seq (coefficients x) (coefficients y) -> Id RX.X.Carrier x y)
   (\ x y -> F.isProp-Pi (Id Seq (coefficients x) (coefficients y)) (\ h -> Id RX.X.Carrier x y) (\ h -> RX.X.set x y))
   (\ p q h -> RX.X.Q.relates p q (Pr.happly Nat (\ n -> R.R) _ _ (trans (sym (Co.beta p)) (trans h (Co.beta q))))) ;
 Vanishing (u : Seq) : U l = (N : Nat) * ((n : Nat) -> CB.le N n -> Id R.R (u n) R.z) ;
 EV (u : Seq) : U l = Tr.Trunc[Vanishing u].carrier ;
 Polynomial (u : Seq) : U l = (x : RX.X.Carrier) * Id Seq (coefficients x) u ;
 polynomial-prop (u : Seq) : Pr.isProp (Polynomial u) = \ a b ->
  Pr.Sigma-eq RX.X.Carrier (\ x -> Id Seq (coefficients x) u) a.1 b.1 a.2 b.2
   (coefficients-injective a.1 b.1 (trans a.2 (sym b.2))) (seq-set _ _) ;
 take : Nat -> Seq -> List R.R = split {
  zero -> \ u -> nil ; suc N | r -> \ u -> cons (u zero) (r (\ k -> u (suc k))) } ;
 coef-take : (N : Nat) -> (u : Seq) -> ((n : Nat) -> CB.le N n -> Id R.R (u n) R.z) ->
  (k : Nat) -> Id R.R (RP.coef (take N u) k) (u k) = split {
  zero -> \ u h k -> sym (h k tt) ;
  suc N | r -> \ u h -> split {
   zero -> refl (u zero) ;
   suc k -> r (\ k -> u (suc k)) (\ n -> h (suc n)) k } } ;
 polynomial (u : Seq) (e : EV u) : Polynomial u =
  Tr.Trunc[Vanishing u].induction @l (\ t -> Polynomial u) (\ t -> polynomial-prop u)
   (\ w -> (RX.X.include (take w.1 u),
    trans (Co.beta (take w.1 u)) (F.funext Nat (\ n -> R.R) _ _ (coef-take w.1 u w.2)))) e ;
 ------------------------------------------------------------------
 module Lemma (A : C.Algebra) (fa : P.FP A) (s : C.Spec A -> Seq) (ev : (x : C.Spec A) -> EV (s x)) {
  module PC = PolyCoproduct[A] ;
  module AX = PC.AX ;
  module T = ST.At[A,RX.algebra,AX.algebra,PC.coproduct,AV.preserves-FP A fa,rx-fp] ;
  family (x : C.Spec A) : RX.X.Carrier = (polynomial (s x) (ev x)).1 ;
  -- 3.3.1 with B = R[X]
  p : AX.X.Carrier = T.theorem.sec family ;
  at (x : C.Spec A) : Id RX.X.Carrier (T.map p x) (family x) =
   Pr.happly (C.Spec A) (\ x -> RX.X.Carrier) _ _ (T.theorem.sec-eq family) x ;
  mapc (x : C.Spec A) : List A.ring.R -> List R.R = split {
   nil -> nil ; cons a L | r -> cons (x.1.1 a) r } ;
  beyond (x : C.Spec A) : (L : List A.ring.R) -> (k : Nat) -> CB.le (len {A.ring.R} L) k ->
   Id R.R (RP.coef (mapc x L) k) R.z = split {
   nil -> \ k h -> refl R.z ;
   cons a L | r -> split { zero -> \ h -> efq h ; suc k -> \ h -> r k h } } ;
  -- x (x) R[X] applies x to the coefficients
  module At (x : C.Spec A) {
   h : C.Hom AX.algebra RX.algebra = T.tensorB x ;
   restricts : Id PC.To[RX.algebra].Maps (PC.To[RX.algebra].forward h)
    (C.compose A C.base RX.algebra T.point x,C.identity RX.algebra) =
    (PC.coproduct.2.2 RX.algebra).sec-eq (C.compose A C.base RX.algebra T.point x,C.identity RX.algebra) ;
   on-constant (a : A.ring.R) : Id RX.X.Carrier (h.1.1 (AX.X.constant a)) (RX.X.constant (x.1.1 a)) =
    Pr.ap PC.To[RX.algebra].Maps RX.X.Carrier (\ d -> d.1.1.1 a) _ _ restricts ;
   on-variable : Id RX.X.Carrier (h.1.1 AX.X.variable) RX.X.variable =
    trans (ap h.1.1 (sym PC.inB-X))
     (Pr.ap PC.To[RX.algebra].Maps RX.X.Carrier (\ d -> d.2.1.1 RX.X.variable) _ _ restricts) ;
   coefficientwise : (L : List A.ring.R) ->
    Id RX.X.Carrier (h.1.1 (AX.X.include L)) (RX.X.include (mapc x L)) = split {
    nil -> RingHom[l].zero AX.X.ring RX.X.ring h.1 ;
    cons a L | ih -> calc RX.X.Carrier {
     h.1.1 (AX.X.include (cons a L))
      =< ap h.1.1 (AX.X.horner a L)
       > h.1.1 (AX.X.addQ (AX.X.constant a) (AX.X.mulQ AX.X.variable (AX.X.include L)))
      =< h.1.2.2.1 (AX.X.constant a) (AX.X.mulQ AX.X.variable (AX.X.include L))
       > RX.X.addQ (h.1.1 (AX.X.constant a)) (h.1.1 (AX.X.mulQ AX.X.variable (AX.X.include L)))
      =< ap (RX.X.addQ (h.1.1 (AX.X.constant a))) (h.1.2.2.2 AX.X.variable (AX.X.include L))
       > RX.X.addQ (h.1.1 (AX.X.constant a)) (RX.X.mulQ (h.1.1 AX.X.variable) (h.1.1 (AX.X.include L)))
      =< Presentations[l].cong2 RX.X.Carrier RX.X.addQ _ _ _ _ (on-constant a)
          (Presentations[l].cong2 RX.X.Carrier RX.X.mulQ _ _ _ _ on-variable ih)
       > RX.X.addQ (RX.X.constant (x.1.1 a)) (RX.X.mulQ RX.X.variable (RX.X.include (mapc x L)))
      =< sym (RX.X.horner (x.1.1 a) (mapc x L)) > RX.X.include (mapc x (cons a L)) } } ;
  } ;
  Goal : U l = (N : Nat) * ((x : C.Spec A) (n : Nat) -> CB.le N n -> Id R.R (s x n) R.z) ;
  Representative : U l = (L : List A.ring.R) * Id AX.X.Carrier (AX.X.include L) p ;
  bound (w : Representative) : Goal = (len {A.ring.R} w.1,\ x n k -> calc R.R {
   s x n =< sym (Pr.happly Nat (\ n -> R.R) _ _ (polynomial (s x) (ev x)).2 n) > coefficients (family x) n
    =< ap (\ y -> coefficients y n) (sym (at x)) > coefficients (At[x].h.1.1 p) n
    =< ap (\ y -> coefficients (At[x].h.1.1 y) n) (sym w.2) > coefficients (At[x].h.1.1 (AX.X.include w.1)) n
    =< ap (\ y -> coefficients y n) (At[x].coefficientwise w.1) > coefficients (RX.X.include (mapc x w.1)) n
    =< Pr.happly Nat (\ n -> R.R) _ _ (Co.beta (mapc x w.1)) n > RP.coef (mapc x w.1) n
    =< beyond x w.1 n k > R.z }) ;
  theorem : Tr.Trunc[Goal].carrier =
   AX.X.Q.induction @l (\ q -> Id AX.X.Carrier q p -> Tr.Trunc[Goal].carrier)
    (\ q -> F.isProp-Pi (Id AX.X.Carrier q p) (\ e -> Tr.Trunc[Goal].carrier) (\ e -> Tr.Trunc[Goal].proposition))
    (\ L e -> Tr.Trunc[Goal].inc (bound (L,e))) p (refl p) ;
 } ;
} ;
