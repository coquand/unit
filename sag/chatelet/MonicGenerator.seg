-- Two monic polynomials that divide each other are equal, over any
-- commutative ring. If H = G b and deg H < deg G, uniqueness of division
-- by G gives H = 0, hence G = H a = 0. If the degrees are equal, H - G has
-- degree < deg G and H = G * 1 + (H - G) = G * b + 0, so H - G = 0.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
-- Comparison of natural numbers.
Compare (m n : Nat) : U l =
 Plus (Id Nat m n) (Plus ((k : Nat) * Id Nat (plus (suc m) k) n) ((k : Nat) * Id Nat (plus (suc n) k) m)) ;
compare-lt (m n : Nat) :
 Plus ((k : Nat) * Id Nat (plus (suc m) k) n) ((k : Nat) * Id Nat (plus (suc n) k) m) ->
 Plus ((k : Nat) * Id Nat (plus (suc (suc m)) k) (suc n)) ((k : Nat) * Id Nat (plus (suc (suc n)) k) (suc m)) = split {
 inl t -> inl (t.1,ap (\ j -> suc j) t.2) ;
 inr t -> inr (t.1,ap (\ j -> suc j) t.2) } ;
compare-suc (m n : Nat) : Compare m n -> Compare (suc m) (suc n) = split {
 inl e -> inl (ap (\ j -> suc j) e) ;
 inr t -> inr (compare-lt m n t) } ;
compare : (m n : Nat) -> Compare m n = split {
 zero -> split {
  zero -> inl (refl zero) ;
  suc n -> inr (inl (n,refl (suc n))) } ;
 suc m | ih -> split {
  zero -> inr (inr (m,refl (suc m))) ;
  suc n -> compare-suc m n (ih n) } } ;
plus-assoc : (d k j : Nat) -> Id Nat (plus (plus d k) j) (plus d (plus k j)) = split {
 zero -> \ k j -> refl (plus k j) ;
 suc d | ih -> \ k j -> ap (\ i -> suc i) (ih k j) } ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module Red = MonicReduction[l].Over[A,setA] ;
 module AR = RL[A] ;
 module BR = RL[B.ring] ;
 module Reg = Regularity[l].Over[B.ring] ;
 -- A monic polynomial of degree d has degree < d + 1, hence < d + 1 + k.
 bounded-monic (lower : List A.R) : Red.Bounded (suc (len lower)) (H.monic lower) =
  \ k -> Red.At[lower].above k ;
 bounded-up (d k : Nat) (x : B.Carrier) (h : Red.Bounded d x) : Red.Bounded (plus d k) x =
  \ j -> trans (ap (\ i -> Red.coef x i) (plus-assoc d k j)) (h (plus k j)) ;
 -- x = m + (x - m') when m = m'.
 reassemble (x m m' : B.Carrier) (h : Id B.Carrier m m') :
  Id B.Carrier x (B.addQ m (B.addQ x (B.negQ m'))) =
  sym (trans (ap (\ w -> B.addQ w (B.addQ x (B.negQ m'))) h)
   (trans (BR.add-swap m' x (B.negQ m')) (trans (ap (B.addQ x) (B.ring.addN m')) (B.ring.addZ x)))) ;
 -- deg H < deg G and H = G b, G = H a: both are zero.
 module Smaller (lg lh : List A.R) (k : Nat) (lt : Id Nat (plus (suc (len lh)) k) (len lg))
  (b a : B.Carrier) (hb : Id B.Carrier (H.monic lh) (B.mulQ (H.monic lg) b))
  (ha : Id B.Carrier (H.monic lg) (B.mulQ (H.monic lh) a)) {
  module D = Red.At[lg] ;
  bound : Red.Bounded (len lg) (H.monic lh) =
   Pr.subst Nat (\ i -> Red.Bounded i (H.monic lh)) (plus (suc (len lh)) k) (len lg) lt
    (bounded-up (suc (len lh)) k (H.monic lh) (bounded-monic lh)) ;
  module C1 = D.Characterise[H.monic lh,b,B.zeroQ,Red.bounded-zero (len lg),
   trans hb (Red.Dec.multiple (H.monic lg) b)] ;
  module C2 = D.Characterise[H.monic lh,B.zeroQ,H.monic lh,bound,Red.Dec.small (H.monic lg) (H.monic lh)] ;
  zero-h : Id B.Carrier (H.monic lh) B.zeroQ = trans (sym C2.remainder-is) C1.remainder-is ;
  zero-g : Id B.Carrier (H.monic lg) B.zeroQ =
   trans ha (trans (ap (\ v -> B.mulQ v a) zero-h) (BR.zero-mul a)) ;
  equal : Id B.Carrier (H.monic lg) (H.monic lh) = trans zero-g (sym zero-h) ;
 } ;
 -- Equal degrees and H = G b.
 module Same (lg lh : List A.R) (same : Id Nat (len lh) (len lg))
  (b : B.Carrier) (hb : Id B.Carrier (H.monic lh) (B.mulQ (H.monic lg) b)) {
  module D = Red.At[lg] ;
  G : B.Carrier = H.monic lg ;
  K : B.Carrier = H.monic lh ;
  diff : B.Carrier = B.addQ K (B.negQ G) ;
  coef-diff (i : Nat) : Id A.R (Red.coef diff i) (A.add (Red.coef K i) (A.neg (Red.coef G i))) =
   trans (Red.coef-add K (B.negQ G) i) (ap (A.add (Red.coef K i)) (Red.coef-neg G i)) ;
  bound-at : (k : Nat) -> Id A.R (Red.coef diff (plus (len lg) k)) A.z = split {
   zero -> trans (coef-diff (plus (len lg) zero))
    (trans (cong2 A.R A.add _ _ _ _
      (trans (ap (\ i -> Red.coef K i) (trans (plus-zero (len lg)) (sym same))) Red.At[lh].leading)
      (ap A.neg (trans (ap (\ i -> Red.coef G i) (plus-zero (len lg))) D.leading)))
     (A.addN A.o)) ;
   suc j -> trans (coef-diff (plus (len lg) (suc j)))
    (trans (cong2 A.R A.add _ _ _ _
      (trans (ap {Nat} (\ i -> Red.coef K i) (trans (plus-suc (len lg) j) (ap {Nat} (\ i -> suc (plus i j)) (sym same))))
       (Red.At[lh].above j))
      (ap A.neg (trans (ap (\ i -> Red.coef G i) (plus-suc (len lg) j)) (D.above j))))
     (trans (AR.zl (A.neg A.z)) AR.neg-zero)) } ;
  bound : Red.Bounded (len lg) diff = bound-at ;
  module C1 = D.Characterise[K,b,B.zeroQ,Red.bounded-zero (len lg),trans hb (Red.Dec.multiple G b)] ;
  module C2 = D.Characterise[K,B.oneQ,diff,bound,reassemble K (B.mulQ G B.oneQ) G (B.ring.mulO G)] ;
  diff-zero : Id B.Carrier diff B.zeroQ = trans (sym C2.remainder-is) C1.remainder-is ;
  equal : Id B.Carrier G K = sym (Reg.difference K G diff-zero) ;
 } ;
 -- Monic polynomials dividing each other are equal.
 unique-lt (lg lh : List A.R) (b a : B.Carrier)
  (hb : Id B.Carrier (H.monic lh) (B.mulQ (H.monic lg) b))
  (ha : Id B.Carrier (H.monic lg) (B.mulQ (H.monic lh) a)) :
  Plus ((k : Nat) * Id Nat (plus (suc (len lh)) k) (len lg)) ((k : Nat) * Id Nat (plus (suc (len lg)) k) (len lh)) ->
  Id B.Carrier (H.monic lg) (H.monic lh) = split {
  inl t -> Smaller[lg,lh,t.1,t.2,b,a,hb,ha].equal ;
  inr t -> sym Smaller[lh,lg,t.1,t.2,a,b,ha,hb].equal } ;
 unique-at (lg lh : List A.R) (b a : B.Carrier)
  (hb : Id B.Carrier (H.monic lh) (B.mulQ (H.monic lg) b))
  (ha : Id B.Carrier (H.monic lg) (B.mulQ (H.monic lh) a)) :
  Compare (len lh) (len lg) -> Id B.Carrier (H.monic lg) (H.monic lh) = split {
  inl e -> Same[lg,lh,e,b,hb].equal ;
  inr t -> unique-lt lg lh b a hb ha t } ;
 unique (lg lh : List A.R) (b a : B.Carrier)
  (hb : Id B.Carrier (H.monic lh) (B.mulQ (H.monic lg) b))
  (ha : Id B.Carrier (H.monic lg) (B.mulQ (H.monic lh) a)) : Id B.Carrier (H.monic lg) (H.monic lh) =
  unique-at lg lh b a hb ha (compare (len lh) (len lg)) ;
} ;
