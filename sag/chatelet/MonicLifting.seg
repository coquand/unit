-- Full monic lifting (Appendix 1, Lemma 7.5), in a relative formulation.
-- Given a monic in I and an element of I monic after reduction, construct
-- a monic in I of that same degree and with that same reduction.
level l ; open Ring[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R) (phi : RingHom[l].Hom A C)
 (lift-unit : (a : A.R) -> Id C.R (phi.1 a) C.o -> RL[A].unit a) {
 module P = Poly[l].PolyR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Red = DivisionReduction[l].Over[A,C,setA,phi] ;
 module Shift = PolynomialShift[l].Over[A,setA] ;
 module RS = Shift.Reduction[C,phi] ;
 module IA = Ideals[l].Over[B.ring,B.set] ;
 module OneStep = MonicLiftingStep[l].Over[A,C,setA,phi,lift-unit] ;
 module At (I : IA.Ideal) (r : Nat) (g : P.P)
  (g-leading : Id C.R (phi.1 (P.coef g r)) C.o)
  (g-bound : Red.Bound (suc r) g)
  (g-member : I.1 (B.include g)) {
  Result : U l = (h : P.P) * Bounds.Bound (suc r) h *
   Id A.R (P.coef h r) A.o * Red.Equal h g * I.1 (B.include h) ;
  Statement (n : Nat) : U l =
   (f : P.P) -> Id A.R (P.coef f (plus n (suc r))) A.o ->
   Bounds.Bound (suc (plus n (suc r))) f -> I.1 (B.include f) -> Result ;
  module BaseCase (f : P.P) (leading : Id A.R (P.coef f (suc r)) A.o)
   (bound : Bounds.Bound (suc (suc r)) f) (member : I.1 (B.include f)) {
   module S = OneStep.At[I,r,f,g,leading,bound,member,g-leading,g-bound,g-member] ;
   result : Result = (S.polynomial,S.bound,S.leading,S.reduction,S.member) ;
  } ;
  module Step (n : Nat) (ih : Statement n) (f : P.P)
   (leading : Id A.R (P.coef f (plus (suc n) (suc r))) A.o)
   (bound : Bounds.Bound (suc (plus (suc n) (suc r))) f)
   (member : I.1 (B.include f)) {
   t : Nat = plus n (suc r) ;
   shifted : P.P = Shift.shift (suc n) g ;
   shifted-leading : Id C.R (phi.1 (P.coef shifted t)) C.o =
    trans (ap (\ k -> phi.1 (P.coef shifted k)) (plus-suc n r))
     (trans (ap phi.1 (Shift.coefficient (suc n) g r)) g-leading) ;
   shifted-bound : Red.Bound (suc t) shifted =
    RS.reduced-bound (suc n) (suc r) g g-bound ;
   module S = OneStep.At[I,t,f,shifted,leading,bound,member,
    shifted-leading,shifted-bound,Shift.member I (suc n) g g-member] ;
   result : Result = ih S.polynomial S.leading S.bound S.member ;
  } ;
  lower : (n : Nat) -> Statement n = split {
   zero -> \ f leading bound member -> BaseCase[f,leading,bound,member].result ;
   suc n | ih -> \ f leading bound member -> Step[n,ih,f,leading,bound,member].result } ;
  module Start (f : P.P) (d : Nat) (leading : Id A.R (P.coef f d) A.o)
   (bound : Bounds.Bound (suc d) f) (member : I.1 (B.include f)) {
   raised : P.P = Shift.shift (suc r) f ;
   raised-leading : Id A.R (P.coef raised (plus d (suc r))) A.o =
    trans (ap (P.coef raised) (plus-comm d (suc r)))
     (trans (Shift.coefficient (suc r) f d) leading) ;
   degree-equality : Id Nat (plus (suc r) (suc d)) (suc (plus d (suc r))) =
    trans (plus-suc (suc r) d) (ap (\ n -> suc n) (plus-comm (suc r) d)) ;
   raised-bound : Bounds.Bound (suc (plus d (suc r))) raised =
    \ k -> trans (ap (P.coef raised) (ap (\ n -> plus n k) (sym degree-equality)))
     (Shift.bound (suc r) (suc d) f bound k) ;
   result : Result = lower d raised raised-leading raised-bound (Shift.member I (suc r) f member) ;
  } ;
  lift (f : P.P) (d : Nat) (leading : Id A.R (P.coef f d) A.o)
   (bound : Bounds.Bound (suc d) f) (member : I.1 (B.include f)) : Result =
   Start[f,d,leading,bound,member].result ;
 } ;
} ;
