-- Boundary uses of the new results, plus rejection of an invalid descent.
level l ; open Ring[l] ; open Presentations[l] ;
module DivisionByOne (A : CRing) (setA : Prelude[l].isSet A.R) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module D = MonicDivision[l].Over[A,setA].At[nil] ;
 module R = RL[B.ring] ;
 quotient-is-input (p : List A.R) :
  Id B.Carrier (B.include p) (B.include (D.divide p).1) =
  trans (D.divide p).2.2.2
   (trans (ap (B.addQ (B.mulQ B.oneQ (B.include (D.divide p).1)))
     (B.Q.relates (D.divide p).2.1 nil (D.divide p).2.2.1))
    (trans (B.add-zero (B.mulQ B.oneQ (B.include (D.divide p).1)))
     (trans (B.mul-comm B.oneQ (B.include (D.divide p).1))
      (B.mul-one (B.include (D.divide p).1))))) ;
} ;
module LiftingDegreeZero (A C : CRing) (setA : Prelude[l].isSet A.R)
 (phi : RingHom[l].Hom A C)
 (lift-unit : (a : A.R) -> Id C.R (phi.1 a) C.o -> RL[A].unit a) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Red = DivisionReduction[l].Over[A,C,setA,phi] ;
 module P = Poly[l].PolyR[A] ;
 module IA = Ideals[l].Over[B.ring,B.set] ;
 module At (I : IA.Ideal) (g : List A.R)
  (leading : Id C.R (phi.1 (P.coef g zero)) C.o)
  (bound : Red.Bound (suc zero) g) (member : I.1 (B.include g)) {
  module Lift = MonicLifting[l].Over[A,C,setA,phi,lift-unit].At[I,zero,g,leading,bound,member] ;
  contains-one (f : List A.R) (d : Nat)
   (f-leading : Id A.R (P.coef f d) A.o)
   (f-bound : Bounds.Bound (suc d) f) (f-member : I.1 (B.include f)) : I.1 B.oneQ =
   let {
    h : Lift.Result = Lift.lift f d f-leading f-bound f-member ;
   } in IA.In[I].equal _ _
    (MonicNormalForm[l].Over[A,setA].equation zero h.1 h.2.1 h.2.2.1)
    h.2.2.2.2 ;
 } ;
} ;
module OneGenerator (A : CRing) (setA : Prelude[l].isSet A.R) {
 module IA = Ideals[l].Over[A,setA] ;
 module L = FiniteLinear[l].Over[A] ;
 module At (J : IA.Ideal)
  (radical : (a : A.R) -> J.1 a -> RL[A].unit (A.add A.o (A.neg a)))
  (D : L.Module) {
  module N = NakayamaElimination[l].Over[A,setA].At[J,radical,D] ;
  vanish (a : A.R) (inJ : J.1 a) (v : D.V)
   (equation : Id D.V v (D.scale a v)) : Id D.V v D.zeroV =
   N.eliminate (suc zero) (\ i -> v) (\ i j -> a) (\ i j -> inJ)
    (\ i -> trans equation (sym (D.zero-right (D.scale a v)))) (inr tt) ;
 } ;
} ;
#fails {
 module InvalidScalarDescent (A : CRing) (n : Nat)
  (e : RankOneProjector[l].Over[A].Size[n].Matrix) (t : A.R) {
  module M = RankOneProjector[l].Over[A].Size[n] ;
  -- A denominator cannot simply be erased from the input certificate.
  forget-denominator (w : M.ScalarFactor e t) : M.Factors e = w ;
 } ;
} ;
