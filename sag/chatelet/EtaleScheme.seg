-- sevb Lemma 1.2.1 and Proposition 1.2.3.
-- A finite cover by affine open charts gives an etale sheaf.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module T = ET.T ;
 module SC = Schemes[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module EO = EtaleOpen[l].Over[R,setR,axioms] ;
 module ER = EtaleRing[l].Over[R,setR,axioms] ;
 module OT = EtaleOpenType[l].Over[R,setR,axioms] ;
 module FO = EtaleFiniteOpen[l].Over[R,setR] ;
 module S = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module EM = EtaleModal[l,l].Over[ET.I,ET.G] ;
 module Cover (X : U l) (cover : SC.Cover[X]) {
  setX : Pr.isSet X = SC.cover-set X cover ;
  module Chart (s : Fin cover.size) {
   c : SC.Chart[X] = cover.charts s ;
   module Embedded = SchemeMaps[l].Embedded[SA.Sol c.presentation,X,c.map,c.embedding] ;
   Total : U l = Embedded.Total ;
   local : T.isModal @l Total = EM.modal-along (SA.Sol c.presentation) Total
    Embedded.equivalence (ER.solutions-local c.presentation) ;
   image (x : X) : U l = SC.Image X c x ;
   image-prop (x : X) : Pr.isProp (image x) = SchemeMaps[l].image-prop (SA.Sol c.presentation) X c.map x ;
   equality (x y : X) (ux : image x) (i : ET.I) (h : ET.G i -> Id X x y) : Id X x y =
    let {
     uy : image y = ((EO.open-local (image y) (c.open-image y)) i).sec
      (\ g -> Pr.subst X image x y (h g) ux) ;
     path : Id Total (x,ux) (y,uy) = ((S.modal-Id Total local (x,ux) (y,uy)) i).sec
      (\ g -> Pr.Sigma-eq X image x y ux uy (h g) (image-prop y)) ;
    } in ap (\ w -> w.1) path ;
  } ;
  separated (x y : X) : T.isModal @l (Id X x y) =
   S.modal-of-sec (Id X x y) (setX x y) (\ i h ->
    TC.rec ((s : Fin cover.size) * SC.Image X (cover.charts s) x) @l (Id X x y) (setX x y)
     (\ w -> Chart[w.1].equality x y w.2 i h) (cover.covers x)) ;
  module Sep = EM.Separated[X,setX,separated] ;
  module Function (i : ET.I) (h : ET.G i -> X) {
   chart-open (s : Fin cover.size) (g : ET.G i) : OT.Opn =
    (Chart[s].image (h g),Chart[s].c.open-image (h g)) ;
   constant-open (s : Fin cover.size) : OT.Opn = (OT.opens-local i).sec (chart-open s) ;
   equality (s : Fin cover.size) (g : ET.G i) : Id OT.Opn (constant-open s) (chart-open s g) =
    P1.happly (ET.G i) (\ g -> OT.Opn) _ _ ((OT.opens-local i).sec-eq (chart-open s)) g ;
   from (s : Fin cover.size) (g : ET.G i) : Chart[s].image (h g) -> (constant-open s).1 =
    (OT.encode (constant-open s) (chart-open s g) (equality s g)).2 ;
   to (s : Fin cover.size) (g : ET.G i) : (constant-open s).1 -> Chart[s].image (h g) =
    (OT.encode (constant-open s) (chart-open s g) (equality s g)).1 ;
   Some : U l = FO.Some cover.size (\ s -> (constant-open s).1) ;
   some-open : OP.Open Some = FO.finite-open cover.size
    (\ s -> (constant-open s).1) (\ s -> (constant-open s).2) ;
   covered (g : ET.G i) : Some =
    TC.map ((s : Fin cover.size) * SC.Image X (cover.charts s) (h g))
     ((s : Fin cover.size) * (constant-open s).1) (\ w -> (w.1,from w.1 g w.2)) (cover.covers (h g)) ;
   some : Some = (EO.open-local Some some-open i).sec covered ;
   module Piece (w : (s : Fin cover.size) * (constant-open s).1) {
    lift (g : ET.G i) : Chart[w.1].Total = (h g,to w.1 g w.2) ;
    a : Chart[w.1].Total = (Chart[w.1].local i).sec lift ;
    constant : Sep.At[i,h].Constant =
     (a.1,\ g -> ap (\ p -> p.1)
       (Pr.happly (ET.G i) (\ g -> Chart[w.1].Total) _ _ ((Chart[w.1].local i).sec-eq lift) g)) ;
   } ;
   factor : Tr.Trunc[Sep.At[i,h].Constant].carrier =
    TC.map ((s : Fin cover.size) * (constant-open s).1) Sep.At[i,h].Constant
     (\ w -> Piece[w].constant) some ;
  } ;
  cover-local : T.isModal @l X = Sep.separated-factor (\ i h -> Function[i,h].factor) ;
 } ;
 etale-scheme (X : U l) (s : SC.Scheme X) : T.isModal @l X =
  EM.Mere[X,SC.set X s,
    TC.map SC.Cover[X] (T.isModal @l X) (\ cover -> Cover[X,cover].cover-local) s].modal ;
 opaque etale-scheme ;
} ;
