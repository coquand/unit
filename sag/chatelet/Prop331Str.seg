-- Algebra structures on a sheaf form a sheaf (for Prop 3.3.1: AZ_n is a
-- sheaf).  AlgSIP.At[X].Str is the data (operations, X -> ... -> X) and
-- the laws (isSet X and equations in X); each is a Pi or an identity type
-- of the sheaf X.  Also: every algebra is mk of its fields (eta, by the
-- record eliminator).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (I : U l) (G : I -> U l) {
 module AS = AlgSIP[l].Over[R,setR] ;
 module NA = NCAlgebra[l].Over[R,setR] ;
 module T = SheafTopology[l].Over[I,G] ;
 module S0 = SheafLemmas[l,l].Over[I,G] ;
 fields (A : AS.Alg) : AS.At[A.A].Str =
  ((A.zero,A.add,A.neg,A.scale,A.one,A.mul),
   (A.set,A.addA,A.addC,A.addZ,A.addN,A.scale-one,A.scale-scale,A.scale-add,A.add-scale,
    A.mulA,A.one-left,A.one-right,A.dist-left,A.dist-right,A.scale-mul-left,A.scale-mul-right)) ;
 eta : (A : AS.Alg) -> Id AS.Alg A (AS.At[A.A].mk (fields A)) = split {
  Algebra x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 x21 x22 x23 ->
   refl (new NA.Algebra[x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,x23]) } ;
 pm (P Q : U l) (hP : T.isModal @l P) (hQ : T.isModal @l Q) : T.isModal @l (P * Q) =
  S0.modal-Sigma P (\ u -> Q) hP (\ u -> hQ) ;
 module On (X : U l) (hX : T.isModal @l X) {
  fn1 : T.isModal @l (X -> X) = S0.modal-Pi X (\ x -> X) (\ x -> hX) ;
  fn2 : T.isModal @l (X -> X -> X) = S0.modal-Pi X (\ x -> X -> X) (\ x -> fn1) ;
  fnR : T.isModal @l (R.R -> X -> X) = S0.modal-Pi R.R (\ a -> X -> X) (\ a -> fn1) ;
  eqv (x y : X) : T.isModal @l (Id X x y) = S0.modal-Id X hX x y ;
  e1 (f g : X -> X) : T.isModal @l ((x : X) -> Id X (f x) (g x)) =
   S0.modal-Pi X (\ x -> Id X (f x) (g x)) (\ x -> eqv (f x) (g x)) ;
  e2 (f g : X -> X -> X) : T.isModal @l ((x y : X) -> Id X (f x y) (g x y)) =
   S0.modal-Pi X (\ x -> (y : X) -> Id X (f x y) (g x y)) (\ x -> e1 (f x) (g x)) ;
  e3 (f g : X -> X -> X -> X) : T.isModal @l ((x y w : X) -> Id X (f x y w) (g x y w)) =
   S0.modal-Pi X (\ x -> (y w : X) -> Id X (f x y w) (g x y w)) (\ x -> e2 (f x) (g x)) ;
  r2 (f g : R.R -> X -> X -> X) : T.isModal @l ((a : R.R) (x y : X) -> Id X (f a x y) (g a x y)) =
   S0.modal-Pi R.R (\ a -> (x y : X) -> Id X (f a x y) (g a x y)) (\ a -> e2 (f a) (g a)) ;
  rr1 (f g : R.R -> R.R -> X -> X) : T.isModal @l ((a b : R.R) (x : X) -> Id X (f a b x) (g a b x)) =
   S0.modal-Pi R.R (\ a -> (b : R.R) (x : X) -> Id X (f a b x) (g a b x)) (\ a ->
    S0.modal-Pi R.R (\ b -> (x : X) -> Id X (f a b x) (g a b x)) (\ b -> e1 (f a b) (g a b))) ;
  set-modal : T.isModal @l (Pr.isSet X) =
   S0.modal-Pi X (\ x -> (y : X) -> Pr.isProp (Id X x y)) (\ x ->
    S0.modal-Pi X (\ y -> Pr.isProp (Id X x y)) (\ y -> S0.modal-isProp (Id X x y) (eqv x y))) ;
  data-modal : T.isModal @l (AS.At[X].Data) =
   pm X _ hX (pm (X -> X -> X) _ fn2 (pm (X -> X) _ fn1 (pm (R.R -> X -> X) _ fnR (pm X (X -> X -> X) hX fn2)))) ;
  module L (d : AS.At[X].Data) {
   module DD = AS.At[X].D[d] ;
   rest : T.isModal @l DD.Rest =
    pm _ _ (e3 (\ x y w -> DD.dad x (DD.dad y w)) (\ x y w -> DD.dad (DD.dad x y) w))
    (pm _ _ (e2 (\ x y -> DD.dad x y) (\ x y -> DD.dad y x))
    (pm _ _ (e1 (\ x -> DD.dad x DD.dz) (\ x -> x))
    (pm _ _ (e1 (\ x -> DD.dad x (DD.dng x)) (\ x -> DD.dz))
    (pm _ _ (e1 (\ x -> DD.dsc R.o x) (\ x -> x))
    (pm _ _ (rr1 (\ a b x -> DD.dsc a (DD.dsc b x)) (\ a b x -> DD.dsc (R.mul a b) x))
    (pm _ _ (r2 (\ a x y -> DD.dsc a (DD.dad x y)) (\ a x y -> DD.dad (DD.dsc a x) (DD.dsc a y)))
    (pm _ _ (rr1 (\ a b x -> DD.dsc (R.add a b) x) (\ a b x -> DD.dad (DD.dsc a x) (DD.dsc b x)))
    (pm _ _ (e3 (\ x y w -> DD.dmu x (DD.dmu y w)) (\ x y w -> DD.dmu (DD.dmu x y) w))
    (pm _ _ (e1 (\ x -> DD.dmu DD.don x) (\ x -> x))
    (pm _ _ (e1 (\ x -> DD.dmu x DD.don) (\ x -> x))
    (pm _ _ (e3 (\ x y w -> DD.dmu x (DD.dad y w)) (\ x y w -> DD.dad (DD.dmu x y) (DD.dmu x w)))
    (pm _ _ (e3 (\ x y w -> DD.dmu (DD.dad x y) w) (\ x y w -> DD.dad (DD.dmu x w) (DD.dmu y w)))
    (pm _ _ (r2 (\ a x y -> DD.dmu (DD.dsc a x) y) (\ a x y -> DD.dsc a (DD.dmu x y)))
     (r2 (\ a x y -> DD.dmu x (DD.dsc a y)) (\ a x y -> DD.dsc a (DD.dmu x y)))))))))))))))) ;
   laws : T.isModal @l DD.Laws = pm (Pr.isSet X) DD.Rest set-modal rest ;
  } ;
  str : T.isModal @l (AS.At[X].Str) = S0.modal-Sigma (AS.At[X].Data) (\ d -> AS.At[X].D[d].Laws) data-modal (\ d -> L[d].laws) ;
 } ;
 str-modal (X : U l) (hX : T.isModal @l X) : T.isModal @l (AS.At[X].Str) = On[X,hX].str ;
} ;
