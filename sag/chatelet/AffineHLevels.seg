level l ; open Prelude[l] ; open FunExtUA[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
contr-prop (X : U l) : isProp (isContr X) = \ c d ->
 Sigma-eq X (\ x -> (y : X) -> Id X x y) c.1 d.1 c.2 d.2 (pathC X c c.1 d.1)
  (F.isProp-Pi X (\ y -> Id X d.1 y)
   (\ y -> prop-to-set X (\ x y -> pathC X c x y) d.1 y)) ;
set-prop (X : U l) : isProp (isSet X) =
 F.isProp-Pi X (\ x -> (y : X) -> isProp (Id X x y))
  (\ x -> F.isProp-Pi X (\ y -> isProp (Id X x y)) (\ y -> F.isProp-isProp (Id X x y))) ;
module Fibres (A B : U l) (setB : isSet B) (f : A -> B) {
 Fib (b : B) : U l = (a : A) * Id B (f a) b ;
 from-equiv (e : isEquiv A B f) (b : B) : isContr (Fib b) =
  ((e.sec b,e.sec-eq b),\ w -> Sigma-eq A (\ a -> Id B (f a) b) _ _ _ _
   (Equivalences[l].injective A B f e _ _ (trans B _ _ _ (e.sec-eq b) (sym B _ _ w.2))) (setB _ _)) ;
 to-equiv (fib : (b : B) -> isContr (Fib b)) : isEquiv A B f =
  qinv A B f (\ b -> (fib b).1.1) (\ b -> (fib b).1.2)
   (\ a -> ap (Fib (f a)) A (\ w -> w.1) _ _ ((fib (f a)).2 (a,refl (f a)))) ;
} ;
pair-path (A B : U l) (a a' : A) (b b' : B) (p : Id A a a') (q : Id B b b') :
 Id (A * B) (a,b) (a',b') =
 trans (A * B) _ (a',b) _ (ap A (A * B) (\ x -> (x,b)) _ _ p) (ap B (A * B) (\ y -> (a',y)) _ _ q) ;
set-from-equiv (A B : U l) (setB : isSet B) (f : A -> B) (e : isEquiv A B f) : isSet A = \ x ->
 Hedberg[A,x,\ y -> Id B (f x) (f y),\ y -> setB (f x) (f y),refl (f x),
  \ y p -> Equivalences[l].injective A B f e x y p].hedberg ;
module EquivalenceProofs (A B : U l) (setB : isSet B) (f : A -> B) {
 Pair : U l = (B -> A) * (B -> A) ;
 Laws (p : Pair) : U l = ((b : B) -> Id B (f (p.1 b)) b) * ((a : A) -> Id A (p.2 (f a)) a) ;
 Data : U l = (p : Pair) * Laws p ;
 encode (e : isEquiv A B f) : Data = ((e.sec,e.ret),e.sec-eq,e.ret-eq) ;
 decode (d : Data) : isEquiv A B f =
  struct { sec = d.1.1 ; sec-eq = d.2.1 ; ret = d.1.2 ; ret-eq = d.2.2 } ;
 eta : (e : isEquiv A B f) -> Id (isEquiv A B f) e (decode (encode e)) = split {
  mk s se r re -> refl (struct { sec = s ; sec-eq = se ; ret = r ; ret-eq = re }) } ;
 laws-prop (setA : isSet A) (p : Pair) : isProp (Laws p) =
  isProp-Sigma _ (\ h -> (a : A) -> Id A (p.2 (f a)) a)
   (F.isProp-Pi B (\ b -> Id B (f (p.1 b)) b) (\ b -> setB _ _))
   (\ h -> F.isProp-Pi A (\ a -> Id A (p.2 (f a)) a) (\ a -> setA _ _)) ;
 section-path (e d : isEquiv A B f) : Id (B -> A) e.sec d.sec =
  F.funext B (\ b -> A) e.sec d.sec (\ b ->
   Equivalences[l].injective A B f e _ _ (trans B _ _ _ (e.sec-eq b) (sym B _ _ (d.sec-eq b)))) ;
 retraction-path (e d : isEquiv A B f) : Id (B -> A) e.ret d.ret =
  F.funext B (\ b -> A) e.ret d.ret (\ b ->
   trans A _ (e.sec b) _
    (trans A _ _ _ (ap B A e.ret _ _ (sym B _ _ (e.sec-eq b))) (e.ret-eq (e.sec b)))
    (sym A _ _ (trans A _ _ _ (ap B A d.ret _ _ (sym B _ _ (e.sec-eq b))) (d.ret-eq (e.sec b))))) ;
 proposition : isProp (isEquiv A B f) = \ e d ->
  trans (isEquiv A B f) e (decode (encode e)) d (eta e)
   (trans (isEquiv A B f) (decode (encode e)) (decode (encode d)) d
   (ap Data (isEquiv A B f) decode (encode e) (encode d)
   (Sigma-eq Pair Laws _ _ _ _
    (pair-path (B -> A) (B -> A) e.sec d.sec e.ret d.ret (section-path e d) (retraction-path e d))
    (laws-prop (set-from-equiv A B setB f e) (encode d).1)))
   (sym (isEquiv A B f) d (decode (encode d)) (eta d))) ;
} ;
