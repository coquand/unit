-- Path lemmas for Prop 3.3.1, at one level j.
--   isEquiv-prop   being an equivalence is a proposition (eta for the sig
--                  isEquiv is its eliminator; induction on equivalences;
--                  for the identity both halves are Sigma (s) s ~ id)
--   lift, fst-lift, lift-fst
--                  over a family of propositions, paths in the Sigma type
--                  are paths of the first components
--   ap-trans, ap-sym, ap-ap
level j ; open Base ;
module Pj = Prelude[j] ;
module FL = Axioms[j].FunExtLemmas[fe @j] ;
-- eta for isEquiv
eta (A B : U j) (f : A -> B) : (e : Pj.isEquiv A B f) ->
 Id (Pj.isEquiv A B f) (struct { sec = e.sec ; sec-eq = e.sec-eq ; ret = e.ret ; ret-eq = e.ret-eq }) e = split {
 IsEquiv s se r re -> refl (struct { sec = s ; sec-eq = se ; ret = r ; ret-eq = re }) } ;
half-prop (A : U j) : Pj.isProp ((s : A -> A) * ((b : A) -> Id A (s b) b)) =
 Pj.retract-prop ((s : A -> A) * ((b : A) -> Id A (s b) b)) ((s : A -> A) * Id (A -> A) s (\ b -> b))
  (\ w -> (w.1,FL.funext A (\ b -> A) w.1 (\ b -> b) w.2))
  (\ w -> (w.1,Pj.happly A (\ b -> A) w.1 (\ b -> b) w.2))
  (\ w -> Pj.ap ((b : A) -> Id A (w.1 b) b) ((s : A -> A) * ((b : A) -> Id A (s b) b)) (\ h -> (w.1,h))
    (Pj.happly A (\ b -> A) w.1 (\ b -> b) (FL.funext A (\ b -> A) w.1 (\ b -> b) w.2)) w.2
    (FL.happly-funext A (\ b -> A) w.1 (\ b -> b) w.2))
  (\ u v -> FunExtUA[j].pathC ((s : A -> A) * Id (A -> A) s (\ b -> b)) (FunExtUA[j].sing (A -> A) (\ b -> b)) u v) ;
id-equiv-prop (A : U j) : Pj.isProp (Pj.isEquiv A A (\ a -> a)) =
 Pj.retract-prop (Pj.isEquiv A A (\ a -> a))
  (((s : A -> A) * ((b : A) -> Id A (s b) b)) * ((s : A -> A) * ((b : A) -> Id A (s b) b)))
  (\ e -> ((e.sec,e.sec-eq),(e.ret,e.ret-eq)))
  (\ w -> struct { sec = w.1.1 ; sec-eq = w.1.2 ; ret = w.2.1 ; ret-eq = w.2.2 })
  (eta A A (\ a -> a))
  (Pj.isProp-Sigma ((s : A -> A) * ((b : A) -> Id A (s b) b)) (\ w -> (s : A -> A) * ((b : A) -> Id A (s b) b))
    (half-prop A) (\ w -> half-prop A)) ;
isEquiv-prop (A B : U j) (f : A -> B) : Pj.isProp (Pj.isEquiv A B f) = \ e1 e2 ->
 AlgebraPointsIdentity[j].eqind A (\ B' d -> Pj.isProp (Pj.isEquiv A B' d.1)) (id-equiv-prop A) B (f,e1) e1 e2 ;

-- Sigma types over propositions
module Sub (A : U j) (B : A -> U j) (pB : (a : A) -> Pj.isProp (B a)) {
 S : U j = (a : A) * B a ;
 lift (u v : S) (p : Id A u.1 v.1) : Id S u v = Pj.Sigma-eq A B u.1 v.1 u.2 v.2 p (pB v.1) ;
 fst (u v : S) (q : Id S u v) : Id A u.1 v.1 = Pj.ap S A (\ w -> w.1) u v q ;
 -- ap of a pair with a fixed first component is refl on the first component
 fst-pair (a : A) (b b' : B a) (q : Id (B a) b b') :
  Id (Id A a a) (Pj.ap S A (\ w -> w.1) (a,b) (a,b') (Pj.ap (B a) S (\ y -> (a,y)) b b' q)) (refl a) =
  idJ (B a) b (\ b2 q2 -> Id (Id A a a) (Pj.ap S A (\ w -> w.1) (a,b) (a,b2) (Pj.ap (B a) S (\ y -> (a,y)) b b2 q2)) (refl a))
   (refl (refl a)) b' q ;
 fst-lift (u v : S) (p : Id A u.1 v.1) : Id (Id A u.1 v.1) (fst u v (lift u v p)) p =
  idJ A u.1 (\ a2 p2 -> (b2 : B a2) -> Id (Id A u.1 a2) (fst u (a2,b2) (Pj.Sigma-eq A B u.1 a2 u.2 b2 p2 (pB a2))) p2)
   (\ b2 -> fst-pair u.1 u.2 b2 (pB u.1 u.2 b2)) v.1 p v.2 ;
 lift-fst (u v : S) (q : Id S u v) : Id (Id S u v) (lift u v (fst u v q)) q =
  idJ S u (\ w q2 -> Id (Id S u w) (lift u w (fst u w q2)) q2)
   (Pj.ap (Id (B u.1) u.2 u.2) (Id S u u) (\ r -> Pj.ap (B u.1) S (\ y -> (u.1,y)) u.2 u.2 r) (pB u.1 u.2 u.2) (refl u.2)
     (Pj.prop-to-set (B u.1) (pB u.1) u.2 u.2 (pB u.1 u.2 u.2) (refl u.2))) v q ;
} ;

-- ap
ap-trans (A B : U j) (f : A -> B) (x y z : A) (p : Id A x y) (q : Id A y z) :
 Id (Id B (f x) (f z)) (Pj.ap A B f x z (Pj.trans A x y z p q)) (Pj.trans B (f x) (f y) (f z) (Pj.ap A B f x y p) (Pj.ap A B f y z q)) =
 idJ A y (\ z2 q2 -> Id (Id B (f x) (f z2)) (Pj.ap A B f x z2 (Pj.trans A x y z2 p q2))
   (Pj.trans B (f x) (f y) (f z2) (Pj.ap A B f x y p) (Pj.ap A B f y z2 q2)))
  (refl (Pj.ap A B f x y p)) z q ;
ap-sym (A B : U j) (f : A -> B) (x y : A) (p : Id A x y) :
 Id (Id B (f y) (f x)) (Pj.ap A B f y x (Pj.sym A x y p)) (Pj.sym B (f x) (f y) (Pj.ap A B f x y p)) =
 idJ A x (\ y2 p2 -> Id (Id B (f y2) (f x)) (Pj.ap A B f y2 x (Pj.sym A x y2 p2)) (Pj.sym B (f x) (f y2) (Pj.ap A B f x y2 p2)))
  (refl (refl (f x))) y p ;
ap-ap (A B C : U j) (f : A -> B) (g : B -> C) (x y : A) (p : Id A x y) :
 Id (Id C (g (f x)) (g (f y))) (Pj.ap B C g (f x) (f y) (Pj.ap A B f x y p)) (Pj.ap A C (\ a -> g (f a)) x y p) =
 idJ A x (\ y2 p2 -> Id (Id C (g (f x)) (g (f y2))) (Pj.ap B C g (f x) (f y2) (Pj.ap A B f x y2 p2)) (Pj.ap A C (\ a -> g (f a)) x y2 p2))
  (refl (refl (g (f x)))) y p ;
