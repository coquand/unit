-- Functions f,g : R -> R with f(x) = g(1/x) on units are constant.
-- By SQC both are polynomials p, q.  Induction on q: if q = c + Y q', then
-- X(p - c) agrees with q' on units; the base case is UnitVanishing.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (sqc : Presentations[l].Over[R,setR].SQC) {
 open R ; open RL[R] ;
 module UV = UnitVanishing[l].Over[R,setR,sqc] ;
 module C = UV.C ;
 module X = UV.X ;
 module Raw = UV.Raw ;
 module G = PicardUnits[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 module PX = C.Polynomial[C.base].To[C.base] ;
 -- points of R[X]
 point (x : R.R) : C.Hom UV.RX.algebra C.base = PX.backward (C.identity C.base,x) ;
 point-variable (x : R.R) : Id R.R ((point x).1.1 X.variable) x =
  ap (\ d -> d.2) (PX.fb (C.identity C.base,x)) ;
 at (p : Raw.P) (x : R.R) : Id R.R (Raw.ev p x) ((point x).1.1 (X.include p)) =
  trans (ap (Raw.ev p) (sym (point-variable x))) (sym (UV.at-point (point x) p)) ;
 eval-respects (p q : Raw.P) (h : Raw.peq p q) (x : R.R) : Id R.R (Raw.ev p x) (Raw.ev q x) =
  trans (at p x) (trans (ap (point x).1.1 (X.Q.relates p q h)) (sym (at q x))) ;
 -- every function is a polynomial
 Rep (f : R.R -> R.R) : U l = (p : Raw.P) * ((x : R.R) -> Id R.R (Raw.ev p x) (f x)) ;
 e : Pr.isEquiv X.Carrier (C.Spec UV.RX.algebra -> R.R) (C.evaluation UV.RX.algebra) = sqc UV.RX.algebra UV.fp ;
 lifted (f : R.R -> R.R) (g : C.Spec UV.RX.algebra) : R.R = f (g.1.1 X.variable) ;
 from-rep (f : R.R -> R.R) (p : Raw.P) (hp : Id X.Carrier (X.include p) (e.sec (lifted f))) : Rep f =
  (p,\ x -> trans (at p x) (trans (ap (point x).1.1 hp)
   (trans (Pr.happly (C.Spec UV.RX.algebra) (\ g -> R.R) _ _ (e.sec-eq (lifted f)) (point x))
    (ap f (point-variable x))))) ;
 representation (f : R.R -> R.R) : Tr.Trunc[Rep f].carrier =
  X.Q.induction @l (\ c -> Id X.Carrier c (e.sec (lifted f)) -> Tr.Trunc[Rep f].carrier)
   (\ c -> F.isProp-Pi (Id X.Carrier c (e.sec (lifted f))) (\ h -> Tr.Trunc[Rep f].carrier)
     (\ h -> Tr.Trunc[Rep f].proposition))
   (\ p hp -> Tr.Trunc[Rep f].inc (from-rep f p hp)) (e.sec (lifted f)) (refl (e.sec (lifted f))) ;
 -- coefficient induction
 Agree (p q : Raw.P) : U l = (x : G.Unit) -> Id R.R (Raw.ev p x.1) (Raw.ev q x.2.1) ;
 Const (p q : Raw.P) : U l =
  Raw.peq p (cons (Raw.coef q zero) nil) * Raw.peq q (cons (Raw.coef q zero) nil) ;
 headsub : Raw.P -> R.R -> Raw.P = split {
  nil -> \ c -> cons (neg c) nil ;
  cons a p -> \ c -> cons (add a (neg c)) p } ;
 headsub-ev : (p : Raw.P) (c x : R.R) -> Id R.R (Raw.ev (headsub p c) x) (add (Raw.ev p x) (neg c)) = split {
  nil -> \ c x -> trans (add-mulzero (neg c) x) (sym (zl (neg c))) ;
  cons a p -> \ c x -> calc R.R {
   add (add a (neg c)) (mul x (Raw.ev p x))
    =< sym (addA a (neg c) (mul x (Raw.ev p x))) > add a (add (neg c) (mul x (Raw.ev p x)))
    =< ap (add a) (addC (neg c) (mul x (Raw.ev p x))) > add a (add (mul x (Raw.ev p x)) (neg c))
    =< addA a (mul x (Raw.ev p x)) (neg c) > add (add a (mul x (Raw.ev p x))) (neg c) } } ;
 headsub-zero : (p : Raw.P) (c : R.R) -> Id R.R (Raw.coef (headsub p c) zero) (add (Raw.coef p zero) (neg c)) = split {
  nil -> \ c -> sym (zl (neg c)) ;
  cons a p -> \ c -> refl (add a (neg c)) } ;
 headsub-suc : (p : Raw.P) (c : R.R) (k : Nat) -> Id R.R (Raw.coef (headsub p c) (suc k)) (Raw.coef p (suc k)) = split {
  nil -> \ c k -> refl z ;
  cons a p -> \ c k -> refl (Raw.coef p k) } ;
 agree-step (p : Raw.P) (c : R.R) (q : Raw.P) (h : Agree p (cons c q)) : Agree (cons z (headsub p c)) q =
  \ x -> calc R.R {
   add z (mul x.1 (Raw.ev (headsub p c) x.1))
    =< zl (mul x.1 (Raw.ev (headsub p c) x.1)) > mul x.1 (Raw.ev (headsub p c) x.1)
    =< ap (mul x.1) (headsub-ev p c x.1) > mul x.1 (add (Raw.ev p x.1) (neg c))
    =< ap (\ t -> mul x.1 (add t (neg c))) (h x)
    > mul x.1 (add (add c (mul x.2.1 (Raw.ev q x.2.1))) (neg c))
    =< ap (\ t -> mul x.1 (add t (neg c))) (addC c (mul x.2.1 (Raw.ev q x.2.1)))
    > mul x.1 (add (add (mul x.2.1 (Raw.ev q x.2.1)) c) (neg c))
    =< ap (mul x.1) (add-neg-cancel (mul x.2.1 (Raw.ev q x.2.1)) c) > mul x.1 (mul x.2.1 (Raw.ev q x.2.1))
    =< mulA x.1 x.2.1 (Raw.ev q x.2.1) > mul (mul x.1 x.2.1) (Raw.ev q x.2.1)
    =< ap (\ t -> mul t (Raw.ev q x.2.1)) x.2.2 > mul o (Raw.ev q x.2.1)
    =< trans (mulC o (Raw.ev q x.2.1)) (mulO (Raw.ev q x.2.1)) > Raw.ev q x.2.1 } ;
 nil-single : (k : Nat) -> Id R.R (Raw.coef nil k) (Raw.coef (cons z nil) k) = split {
  zero -> refl z ; suc k -> refl z } ;
 tail-single (q : Raw.P) (q0 : Id R.R (Raw.coef q zero) z) (k2 : Raw.peq q (cons (Raw.coef q zero) nil)) :
  (k : Nat) -> Id R.R (Raw.coef q k) z = split {
  zero -> q0 ; suc k -> k2 (suc k) } ;
 step-const (p : Raw.P) (c : R.R) (q : Raw.P) (k : Const (cons z (headsub p c)) q) : Const p (cons c q) =
  let {
   q0 : Id R.R (Raw.coef q zero) z = sym (k.1 zero) ;
   hs (j : Nat) : Id R.R (Raw.coef (headsub p c) j) z = k.1 (suc j) ;
   first : (j : Nat) -> Id R.R (Raw.coef p j) (Raw.coef (cons c nil) j) = split {
    zero -> RR.difference-zero (Raw.coef p zero) c (trans (sym (headsub-zero p c)) (hs zero)) ;
    suc j -> trans (sym (headsub-suc p c j)) (hs (suc j)) } ;
   second : (j : Nat) -> Id R.R (Raw.coef (cons c q) j) (Raw.coef (cons c nil) j) = split {
    zero -> refl c ; suc j -> tail-single q q0 k.2 j } ;
  } in (first,second) ;
 intersect : (q p : Raw.P) -> Agree p q -> Const p q = split {
  nil -> \ p h -> (\ k -> trans (UV.Vanish[p,\ x u -> h (x,u)].result k) (nil-single k),nil-single) ;
  cons c q | ih -> \ p h -> step-const p c q (ih (cons z (headsub p c)) (agree-step p c q h)) } ;
 -- the interface statement
 Conclusion (f g : R.R -> R.R) : U l =
  ((x : R.R) -> Id R.R (f x) (f z)) * ((y : R.R) -> Id R.R (g y) (f z)) ;
 conclusion-prop (f g : R.R -> R.R) : Pr.isProp (Conclusion f g) =
  Pr.isProp-Sigma ((x : R.R) -> Id R.R (f x) (f z)) (\ a -> (y : R.R) -> Id R.R (g y) (f z))
   (F.isProp-Pi R.R (\ x -> Id R.R (f x) (f z)) (\ x -> setR (f x) (f z)))
   (\ a -> F.isProp-Pi R.R (\ y -> Id R.R (g y) (f z)) (\ y -> setR (g y) (f z))) ;
 module Represented (f g : R.R -> R.R) (h : (x : G.Unit) -> Id R.R (f x.1) (g x.2.1))
  (rp : Rep f) (rq : Rep g) {
  agree : Agree rp.1 rq.1 = \ x -> trans (rp.2 x.1) (trans (h x) (sym (rq.2 x.2.1))) ;
  k : Const rp.1 rq.1 = intersect rq.1 rp.1 agree ;
  c : R.R = Raw.coef rq.1 zero ;
  value-f (x : R.R) : Id R.R (f x) c =
   trans (sym (rp.2 x)) (trans (eval-respects rp.1 (cons c nil) k.1 x) (add-mulzero c x)) ;
  value-g (y : R.R) : Id R.R (g y) c =
   trans (sym (rq.2 y)) (trans (eval-respects rq.1 (cons c nil) k.2 y) (add-mulzero c y)) ;
  result : Conclusion f g =
   (\ x -> trans (value-f x) (sym (value-f z)),\ y -> trans (value-g y) (sym (value-f z))) ;
 } ;
 intersection : PicardInterface[l].Over[R,setR].ChartIntersection = \ f g h ->
  Tr.Trunc[Rep f].induction @l (\ t -> Conclusion f g) (\ t -> conclusion-prop f g)
   (\ rp -> Tr.Trunc[Rep g].induction @l (\ t -> Conclusion f g) (\ t -> conclusion-prop f g)
     (\ rq -> Represented[f,g,h,rp,rq].result) (representation g))
   (representation f) ;
} ;
