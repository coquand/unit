-- alpha : PGL_N -> Aut(M_N(R)), [A] |-> (X |-> G X H), is an equivalence,
-- (equivalence; equivalence-iso is the same onto AlgSIP.AlgIso M M),
-- for N = n0+2 and PGL_N literally AutPGL's (GL modulo unit scalars).  G and
-- H are the matrices of the linear map of A and of its inverse, so G H = 1
-- = H G and A v = G v.  Scalars do not change the conjugation
-- (conj-scale).  Injective: if G X H = G' X H' for all X then P = H' G is
-- central, so P = mu 1 (compare P E_at and E_at P), mu is a unit and
-- G = mu G'.  Surjective: Skolem-Noether gives W, L with W L = 1 = L W and
-- phi(X) = W X L; v |-> W v is in GL and its matrix is W.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n0 : Nat)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (cls : Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem) {
 module AP = AutPGL[l].Over[R,setR,n0,sag,cls] ;
 module PL = AP.PL ;
 module Q2 = AP.Q2 ;
 module AL = AP.AL ;
 module SN = SkolemNoether[l].Over[R,setR,sag.loc,suc n0] ;
 module MN = SN.MN ;
 module ME = SN.ME ;
 module S = SN.S ;
 module D = SN.D ;
 module L = SN.L ;
 module CJ = SkolemNoetherConj[l].Over[R,setR].On[SN.M] ;
 N : Nat = SN.N ;
 I : U l = SN.I ;
 Mat : U l = SN.Mat ;
 V : U l = Q2.V ;
 GL : U l = AP.GL ;
 PGL : U l = AP.PGL ;
 Aut : U l = CJ.Aut ;
 t : I = SN.t ;
 dl (i j : I) : R.R = D.delta N i j ;
 coord {v w : V} (h : Id V v w) (i : I) : Id R.R (v i) (w i) = ap (\ y -> y i) h ;

 -- vectors and matrices
 mv (A : Mat) (v : V) : V = \ i -> S.sum N (\ k -> R.mul (A i k) (v k)) ;
 ecol (j : I) : V = \ i -> dl i j ;
 matOf (g : V -> V) : Mat = \ i j -> g (ecol j) i ;
 vsum : (m : Nat) -> (Fin m -> V) -> V = split {
  zero -> \ w -> PL.zero-vector ;
  suc m | r -> \ w -> \ i -> R.add (w (inr tt) i) (r (\ k -> w (inl k)) i) } ;
 vsum-entry (i : I) : (m : Nat) (w : Fin m -> V) -> Id R.R (vsum m w i) (S.sum m (\ k -> w k i)) = split {
  zero -> \ w -> refl R.z ;
  suc m | r -> \ w -> ap (R.add (w (inr tt) i)) (r (\ k -> w (inl k))) } ;
 -- v = sum_j v_j e_j
 expand-v (v : V) : Id V v (vsum N (\ j -> Q2.scale (v j) (ecol j))) =
  Q2.vector-eq v (vsum N (\ j -> Q2.scale (v j) (ecol j))) (\ i ->
   calc R.R {
    v i =< sym (D.sum-delta N i v) > S.sum N (\ k -> R.mul (dl i k) (v k))
     =< S.sum-cong N (\ k -> R.mul (dl i k) (v k)) (\ k -> R.mul (v k) (dl i k)) (\ k -> R.mulC (dl i k) (v k)) >
    S.sum N (\ k -> R.mul (v k) (dl i k))
     =< sym (vsum-entry i N (\ j -> Q2.scale (v j) (ecol j))) > vsum N (\ j -> Q2.scale (v j) (ecol j)) i }) ;
 -- a linear additive map is multiplication by its matrix
 module Lin (g : V -> V) (lin : PL.Linear g) (add : AL.Additive g) {
  g-vsum : (m : Nat) (w : Fin m -> V) -> Id V (g (vsum m w)) (vsum m (\ k -> g (w k))) = split {
   zero -> \ w -> PL.linear-zero g lin ;
   suc m | r -> \ w -> trans (add (w (inr tt)) (vsum m (\ k -> w (inl k))))
    (ap (\ y -> \ i -> R.add (g (w (inr tt)) i) (y i)) (r (\ k -> w (inl k)))) } ;
  rep (v : V) : Id V (g v) (mv (matOf g) v) =
   calc V {
    g v =< ap g (expand-v v) > g (vsum N (\ j -> Q2.scale (v j) (ecol j)))
     =< g-vsum N (\ j -> Q2.scale (v j) (ecol j)) > vsum N (\ j -> g (Q2.scale (v j) (ecol j)))
     =< ap (vsum N) (F.funext (Fin N) (\ j -> V) (\ j -> g (Q2.scale (v j) (ecol j))) (\ j -> Q2.scale (v j) (g (ecol j)))
         (\ j -> lin (v j) (ecol j))) > vsum N (\ j -> Q2.scale (v j) (g (ecol j)))
     =< Q2.vector-eq (vsum N (\ j -> Q2.scale (v j) (g (ecol j)))) (mv (matOf g) v) (\ i ->
         trans (vsum-entry i N (\ j -> Q2.scale (v j) (g (ecol j))))
          (S.sum-cong N (\ j -> R.mul (v j) (g (ecol j) i)) (\ j -> R.mul (g (ecol j) i) (v j)) (\ j -> R.mulC (v j) (g (ecol j) i)))) >
    mv (matOf g) v } ;
 } ;
 -- the inverse of an additive automorphism is additive
 inv-additive (A : PL.Auto) (add : AL.Additive A.1) : AL.Additive A.2.1 = \ v v' -> calc V {
  A.2.1 (\ i -> R.add (v i) (v' i))
   =< ap (\ y -> A.2.1 (\ i -> R.add (y i) (v' i))) (sym (A.2.2.2.2.2 v)) >
  A.2.1 (\ i -> R.add (A.1 (A.2.1 v) i) (v' i))
   =< ap (\ y -> A.2.1 (\ i -> R.add (A.1 (A.2.1 v) i) (y i))) (sym (A.2.2.2.2.2 v')) >
  A.2.1 (\ i -> R.add (A.1 (A.2.1 v) i) (A.1 (A.2.1 v') i))
   =< ap A.2.1 (sym (add (A.2.1 v) (A.2.1 v'))) >
  A.2.1 (A.1 (\ i -> R.add (A.2.1 v i) (A.2.1 v' i)))
   =< A.2.2.2.2.1 (\ i -> R.add (A.2.1 v i) (A.2.1 v' i)) >
  (\ i -> R.add (A.2.1 v i) (A.2.1 v' i)) } ;

 -- the conjugation of a linear automorphism
 module OfGL (A : GL) {
  Gm : Mat = matOf A.1.1 ;
  Hm : Mat = matOf A.1.2.1 ;
  module LG = Lin[A.1.1,A.1.2.2.1,A.2] ;
  module LH = Lin[A.1.2.1,A.1.2.2.2.1,inv-additive A.1 A.2] ;
  GH : Id Mat (MN.mmul Gm Hm) MN.mone = MN.mat-eq (MN.mmul Gm Hm) MN.mone (\ i k ->
   trans (sym (coord (LG.rep (A.1.2.1 (ecol k))) i)) (coord (A.1.2.2.2.2.2 (ecol k)) i)) ;
  HG : Id Mat (MN.mmul Hm Gm) MN.mone = MN.mat-eq (MN.mmul Hm Gm) MN.mone (\ i k ->
   trans (sym (coord (LH.rep (A.1.1 (ecol k))) i)) (coord (A.1.2.2.2.2.1 (ecol k)) i)) ;
  aut : Aut = CJ.Conj[Gm,Hm,GH,HG].aut ;
 } ;
 act (A : GL) : Aut = OfGL[A].aut ;
 respects (A B : GL) (s : AP.Scalar A B) : Id Aut (act A) (act B) =
  CJ.aut-eq (act A) (act B) (\ X -> CJ.conj-scale OfGL[A].Gm OfGL[A].Hm OfGL[B].Gm OfGL[B].Hm s.1.1
   (MN.mat-eq OfGL[B].Gm (MN.mscale s.1.1 OfGL[A].Gm) (\ i j -> coord (s.2 (ecol j)) i))
   OfGL[A].HG OfGL[B].GH X) ;
 module De = AP.QP.Descend[Aut,CJ.set-aut,act,respects] ;
 alpha (p : PGL) : Aut = De.map p ;

 -- entries of products with E_ab
 pE (Q : Mat) (a b x y : I) : Id R.R (MN.mmul Q (ME.E a b) x y) (R.mul (Q x a) (dl b y)) =
  trans (S.sum-cong N (\ k -> R.mul (Q x k) (R.mul (dl a k) (dl b y))) (\ k -> R.mul (dl a k) (R.mul (Q x k) (dl b y)))
    (\ k -> L.mul-swap (Q x k) (dl a k) (dl b y)))
   (D.sum-delta N a (\ k -> R.mul (Q x k) (dl b y))) ;
 Ep (Q : Mat) (a b x y : I) : Id R.R (MN.mmul (ME.E a b) Q x y) (R.mul (dl a x) (Q b y)) =
  trans (S.sum-cong N (\ k -> R.mul (R.mul (dl a x) (dl b k)) (Q k y)) (\ k -> R.mul (dl b k) (R.mul (dl a x) (Q k y)))
    (\ k -> trans (sym (R.mulA (dl a x) (dl b k) (Q k y))) (L.mul-swap (dl a x) (dl b k) (Q k y))))
   (D.sum-delta N b (\ k -> R.mul (dl a x) (Q k y))) ;

 -- injectivity
 module Same (A B : GL) (e : Id Aut (act A) (act B)) {
  GA : Mat = OfGL[A].Gm ; HA : Mat = OfGL[A].Hm ;
  GB : Mat = OfGL[B].Gm ; HB : Mat = OfGL[B].Hm ;
  agree (X : Mat) : Id Mat (MN.mmul (MN.mmul GA X) HA) (MN.mmul (MN.mmul GB X) HB) =
   Pr.happly Mat (\ X1 -> Mat) (act A).1 (act B).1 (ap (\ a -> a.1) e) X ;
  P : Mat = MN.mmul HB GA ;
  comm (X : Mat) : Id Mat (MN.mmul P X) (MN.mmul X P) = CJ.central GA HA GB HB OfGL[A].HG OfGL[B].HG agree X ;
  mu : R.R = P t t ;
  diag (x a : I) : Id R.R (P x a) (R.mul mu (dl x a)) = calc R.R {
   P x a =< sym (R.mulO (P x a)) > R.mul (P x a) R.o
    =< ap (R.mul (P x a)) (sym (D.delta-diag N t)) > R.mul (P x a) (dl t t)
    =< sym (pE P a t x t) > MN.mmul P (ME.E a t) x t
    =< ap (\ Y -> Y x t) (comm (ME.E a t)) > MN.mmul (ME.E a t) P x t
    =< Ep P a t x t > R.mul (dl a x) mu
    =< R.mulC (dl a x) mu > R.mul mu (dl a x)
    =< ap (R.mul mu) (D.delta-sym N a x) > R.mul mu (dl x a) } ;
  P-scalar : Id Mat P (MN.mscale mu MN.mone) = MN.mat-eq P (MN.mscale mu MN.mone) diag ;
  Qm : Mat = MN.mmul HA GB ;
  PQ : Id Mat (MN.mmul P Qm) MN.mone = calc Mat {
   MN.mmul P Qm =< sym (MN.m-mulA HB GA Qm) > MN.mmul HB (MN.mmul GA Qm)
    =< ap (MN.mmul HB) (MN.m-mulA GA HA GB) > MN.mmul HB (MN.mmul (MN.mmul GA HA) GB)
    =< ap (\ Y -> MN.mmul HB (MN.mmul Y GB)) OfGL[A].GH > MN.mmul HB (MN.mmul MN.mone GB)
    =< ap (MN.mmul HB) (MN.m-one-left GB) > MN.mmul HB GB
    =< OfGL[B].HG > MN.mone } ;
  mu-unit : L.unit mu = (Qm t t, calc R.R {
   R.mul mu (Qm t t) =< ap (\ Y -> MN.mscale mu Y t t) (sym (MN.m-one-left Qm)) > MN.mscale mu (MN.mmul MN.mone Qm) t t
    =< ap (\ Y -> Y t t) (sym (MN.m-scale-mul-left mu MN.mone Qm)) > MN.mmul (MN.mscale mu MN.mone) Qm t t
    =< ap (\ Y -> MN.mmul Y Qm t t) (sym P-scalar) > MN.mmul P Qm t t
    =< ap (\ Y -> Y t t) PQ > dl t t
    =< D.delta-diag N t > R.o }) ;
  GA-eq : Id Mat GA (MN.mscale mu GB) = calc Mat {
   GA =< sym (MN.m-one-left GA) > MN.mmul MN.mone GA
    =< ap (\ Y -> MN.mmul Y GA) (sym OfGL[B].GH) > MN.mmul (MN.mmul GB HB) GA
    =< sym (MN.m-mulA GB HB GA) > MN.mmul GB P
    =< ap (MN.mmul GB) P-scalar > MN.mmul GB (MN.mscale mu MN.mone)
    =< MN.m-scale-mul-right mu GB MN.mone > MN.mscale mu (MN.mmul GB MN.mone)
    =< ap (MN.mscale mu) (MN.m-one-right GB) > MN.mscale mu GB } ;
  mv-scale (c : R.R) (Y : Mat) (v : V) : Id V (mv (MN.mscale c Y) v) (Q2.scale c (mv Y v)) =
   Q2.vector-eq (mv (MN.mscale c Y) v) (Q2.scale c (mv Y v)) (\ i ->
    trans (S.sum-cong N (\ k -> R.mul (R.mul c (Y i k)) (v k)) (\ k -> R.mul c (R.mul (Y i k) (v k)))
      (\ k -> sym (R.mulA c (Y i k) (v k))))
     (S.sum-scale c N (\ k -> R.mul (Y i k) (v k)))) ;
  scalarBA : AP.Scalar B A = ((mu,mu-unit),\ v -> calc V {
   A.1.1 v =< OfGL[A].LG.rep v > mv GA v
    =< ap (\ Y -> mv Y v) GA-eq > mv (MN.mscale mu GB) v
    =< mv-scale mu GB v > Q2.scale mu (mv GB v)
    =< ap (Q2.scale mu) (sym (OfGL[B].LG.rep v)) > Q2.scale mu (B.1.1 v) }) ;
  scalar : AP.Scalar A B = AP.scalar-sym B A scalarBA ;
 } ;
 injective (p p' : PGL) (e : Id Aut (alpha p) (alpha p')) : Id PGL p p' =
  AP.QP.induction @l (\ q -> (q' : PGL) -> Id Aut (alpha q) (alpha q') -> Id PGL q q')
   (\ q -> F.isProp-Pi PGL (\ q' -> Id Aut (alpha q) (alpha q') -> Id PGL q q')
     (\ q' -> F.isProp-Pi (Id Aut (alpha q) (alpha q')) (\ e' -> Id PGL q q') (\ e' -> AP.QP.set q q')))
   (\ A -> AP.QP.induction @l (\ q' -> Id Aut (alpha (AP.QP.inc A)) (alpha q') -> Id PGL (AP.QP.inc A) q')
     (\ q' -> F.isProp-Pi (Id Aut (alpha (AP.QP.inc A)) (alpha q')) (\ e' -> Id PGL (AP.QP.inc A) q') (\ e' -> AP.QP.set _ _))
     (\ B e' -> AP.QP.relates A B Same[A,B,trans (sym (De.beta A)) (trans e' (De.beta B))].scalar))
   p p' e ;

 -- surjectivity, by Skolem-Noether
 Fib (a : Aut) : U l = (p : PGL) * Id Aut (alpha p) a ;
 fib-prop (a : Aut) : Pr.isProp (Fib a) = \ f f' ->
  Pr.Sigma-eq PGL (\ p -> Id Aut (alpha p) a) f.1 f'.1 f.2 f'.2
   (injective f.1 f'.1 (trans f.2 (sym f'.2))) (CJ.set-aut (alpha f'.1) a) ;
 mv-assoc (A B : Mat) (v : V) : Id V (mv A (mv B v)) (mv (MN.mmul A B) v) =
  Q2.vector-eq (mv A (mv B v)) (mv (MN.mmul A B) v) (\ i -> MN.mmulA-at A B (\ p q -> v p) i i) ;
 mv-one (v : V) : Id V (mv MN.mone v) v = Q2.vector-eq (mv MN.mone v) v (\ i -> D.sum-delta N i v) ;
 mv-linear (A : Mat) : PL.Linear (mv A) = \ a v ->
  Q2.vector-eq (mv A (Q2.scale a v)) (Q2.scale a (mv A v)) (\ i ->
   trans (S.sum-cong N (\ k -> R.mul (A i k) (R.mul a (v k))) (\ k -> R.mul a (R.mul (A i k) (v k)))
     (\ k -> L.mul-swap (A i k) a (v k)))
    (S.sum-scale a N (\ k -> R.mul (A i k) (v k)))) ;
 mv-additive (A : Mat) : AL.Additive (mv A) = \ v v' ->
  Q2.vector-eq (mv A (\ i -> R.add (v i) (v' i))) (\ i -> R.add (mv A v i) (mv A v' i)) (\ i ->
   trans (S.sum-cong N (\ k -> R.mul (A i k) (R.add (v k) (v' k))) (\ k -> R.add (R.mul (A i k) (v k)) (R.mul (A i k) (v' k)))
     (\ k -> R.dist (A i k) (v k) (v' k)))
    (S.sum-add N (\ k -> R.mul (A i k) (v k)) (\ k -> R.mul (A i k) (v' k)))) ;
 matOf-mv (B : Mat) : Id Mat (matOf (mv B)) B = MN.mat-eq (matOf (mv B)) B (\ i j -> D.sum-delta-right N j (B i)) ;
 module FromConj (a : Aut) (cj : SN.Endo[a.1,a.2.2].Conjugator) {
  W : Mat = cj.1 ;
  Lm : Mat = cj.2.1 ;
  auto : PL.Auto = (mv W,mv Lm,mv-linear W,mv-linear Lm,
   \ v -> trans (mv-assoc Lm W v) (trans (ap (\ Y -> mv Y v) cj.2.2.1) (mv-one v)),
   \ v -> trans (mv-assoc W Lm v) (trans (ap (\ Y -> mv Y v) cj.2.2.2.1) (mv-one v))) ;
  A : GL = (auto,mv-additive W) ;
  act-eq : Id Aut (act A) a = CJ.aut-eq (act A) a (\ X ->
   trans (ap (\ Y -> MN.mmul (MN.mmul Y X) (matOf (mv Lm))) (matOf-mv W))
    (trans (ap (MN.mmul (MN.mmul W X)) (matOf-mv Lm)) (sym (cj.2.2.2.2 X)))) ;
  fib : Fib a = (AP.QP.inc A,trans (De.beta A) act-eq) ;
 } ;
 fib (a : Aut) : Fib a =
  Tr.Trunc[SN.Endo[a.1,a.2.2].Conjugator].induction @l (\ w -> Fib a) (\ w -> fib-prop a)
   (\ cj -> FromConj[a,cj].fib) SN.Endo[a.1,a.2.2].theorem ;
 alpha-equiv : Pr.isEquiv PGL Aut alpha =
  Pr.qinv PGL Aut alpha (\ a -> (fib a).1) (\ a -> (fib a).2)
   (\ p -> injective (fib (alpha p)).1 p (fib (alpha p)).2) ;
 equivalence : Pr.Equiv PGL Aut = (alpha,alpha-equiv) ;
 -- the same with algebra isomorphisms (AlgSIP.AlgIso M M), for the SIP
 module IM = SkolemNoetherIso[l].Over[R,setR].On[SN.M] ;
 iso-of (p : PGL) : SN.AS.AlgIso SN.M SN.M = CJ.to-iso (alpha p) ;
 iso-equiv : Pr.isEquiv PGL (SN.AS.AlgIso SN.M SN.M) iso-of =
  Pr.qinv PGL (SN.AS.AlgIso SN.M SN.M) iso-of (\ e -> (fib (CJ.from-iso e)).1)
   (\ e -> trans (ap CJ.to-iso (fib (CJ.from-iso e)).2) (IM.to-from e))
   (\ p -> injective (fib (CJ.from-iso (iso-of p))).1 p (trans (fib (CJ.from-iso (iso-of p))).2 (CJ.from-to (alpha p)))) ;
 equivalence-iso : Pr.Equiv PGL (SN.AS.AlgIso SN.M SN.M) = (iso-of,iso-equiv) ;
} ;
