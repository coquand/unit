-- Probe: the sheaf interface at several levels (sevb.pdf, Section 2).
level l ;
module Over (I : U l) (G : I -> U l) (sh : [j] SheafClosure[l,j].Over[I,G].Ops) {
 module T = SheafTopology[l].Over[I,G] ;
 -- a type of U l is in U l+, and being a sheaf does not depend on the level
 -- isModal @l X and isModal @(l+) X are the same expression, but conversion
 -- does not unfold Prelude[l].isEquiv against Prelude[l+].isEquiv: the
 -- lift from l to l+ re-packs the four fields.
 #fails { up1 (X : U l) (h : T.isModal @l X) : T.isModal @(l+) X = h ; } ;
 #fails { up2 (X : U l) (h : T.isModal @l X) : T.isModal @(l+) X = \ i -> h i ; } ;
 up3 (X : U l) (h : T.isModal @l X) : T.isModal @(l+) X = \ i ->
  struct { sec = (h i).sec ; sec-eq = (h i).sec-eq ; ret = (h i).ret ; ret-eq = (h i).ret-eq } ;
 -- ||A = B||_T for A B : U l lives at l+
 Eq (A B : U l) : U l+ = (sh @(l+)).close (Id (U l) A B) ;
 -- mapping ||A = B||_T into a sheaf proposition at l++
 lift (A B : U l) (Q : U l++) (pQ : Prelude[l++].isProp Q) (mQ : T.isModal @(l++) Q)
  (f : Id (U l) A B -> Q) : Eq A B -> Q = (sh @(l+)).elim @(l++) (Id (U l) A B) Q pQ mQ f ;
} ;
