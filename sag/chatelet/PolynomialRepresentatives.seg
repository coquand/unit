-- Finite choices of list representatives, kept inside propositional truncation.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module Tr = Truncation[l] ;
 Witness (b : B.Carrier) : U l = (p : List A.R) * Id B.Carrier (B.include p) b ;
 choose : (b : B.Carrier) -> Tr.Trunc[Witness b].carrier =
  B.Q.induction @l (\ b -> Tr.Trunc[Witness b].carrier)
   (\ b -> Tr.Trunc[Witness b].proposition)
   (\ p -> Tr.Trunc[Witness (B.include p)].inc (p,refl (B.include p))) ;
 MatrixWitness (n : Nat) (a : Fin n -> Fin n -> B.Carrier) : U l =
  (i j : Fin n) -> Witness (a i j) ;
 matrix (n : Nat) (a : Fin n -> Fin n -> B.Carrier) : Tr.Trunc[MatrixWitness n a].carrier =
  AffineFinite[l].choice n (\ i -> (j : Fin n) -> Witness (a i j))
   (\ i -> AffineFinite[l].choice n (\ j -> Witness (a i j)) (\ j -> choose (a i j))) ;
} ;
