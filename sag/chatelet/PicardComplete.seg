-- Proposition 4.6 from the SAG axioms alone, over univalence/replacement.
-- The former chart-triviality hypothesis is discharged by Corollary 2.3.
level l ; open Prelude[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module Charts = ChartTriviality[l].Over[R,setR,sag] ;
 module Proof = PicardSAG[l].Over[R,setR,sag,Charts.corollary-2-3] ;
 proposition-4-6 : Proof.Proof.W.Proposition46 = Proof.proposition-4-6 ;
 equivalence : Equiv (Proof.Proof.W.L.Line * PicardInterface[l].Degree)
  (Proof.Proof.W.P.P1 -> Proof.Proof.W.L.Line) = Proof.equivalence ;
 inverse : (Proof.Proof.W.P.P1 -> Proof.Proof.W.L.Line) ->
  Proof.Proof.W.L.Line * PicardInterface[l].Degree = Proof.inverse ;
} ;
