-- Units of the common SAG ring as the abelian group used by torsor/.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 open R ; open RL[R] ;
 inverse-unique (x y w : R.R) (h : Id R.R (mul x y) o) (k : Id R.R (mul x w) o) : Id R.R y w =
  calc R.R { y =< sym (mulO y) > mul y o
   =< ap (mul y) (sym k) > mul y (mul x w)
   =< mulA y x w > mul (mul y x) w
   =< ap (\ t -> mul t w) (trans (mulC y x) h) > mul o w
   =< trans (mulC o w) (mulO w) > w } ;
 unit-prop (x : R.R) : Pr.isProp (unit x) = \ u v ->
  Pr.Sigma-eq R.R (\ y -> Id R.R (mul x y) o) u.1 v.1 u.2 v.2
   (inverse-unique x u.1 v.1 u.2 v.2) (setR (mul x v.1) o) ;
 Unit : U l = (x : R.R) * unit x ;
 eq (u v : Unit) (h : Id R.R u.1 v.1) : Id Unit u v = Pr.Sigma-eq R.R unit u.1 v.1 u.2 v.2 h (unit-prop v.1) ;
 setU : Pr.isSet Unit = Torsor[l].isSet-sub R.R unit setR unit-prop ;
 one : Unit = (o,o,mulO o) ;
 inverse (u : Unit) : Unit = (u.2.1,u.1,trans (mulC u.2.1 u.1) u.2.2) ;
 four (a b c d : R.R) : Id R.R (mul (mul a b) (mul c d)) (mul (mul a c) (mul b d)) = mul-four a b c d ;
 times (u v : Unit) : Unit = (mul u.1 v.1,mul u.2.1 v.2.1,
  trans (four u.1 v.1 u.2.1 v.2.1)
   (trans (ap (\ t -> mul t (mul v.1 v.2.1)) u.2.2)
    (trans (ap (mul o) v.2.2) (mulO o)))) ;
 assoc (u v w : Unit) : Id Unit (times (times u v) w) (times u (times v w)) = eq _ _ (sym (mulA u.1 v.1 w.1)) ;
 comm (u v : Unit) : Id Unit (times u v) (times v u) = eq _ _ (mulC u.1 v.1) ;
 unitr (u : Unit) : Id Unit (times u one) u = eq _ _ (mulO u.1) ;
 invr (u : Unit) : Id Unit (times u (inverse u)) one = eq _ _ u.2.2 ;
 group : Torsor[l].Ab = new Torsor[l].Ab[Unit,setU,one,times,inverse,assoc,comm,unitr,invr] ;
 power (u : Unit) : Nat -> Unit = split { zero -> one ; suc n | r -> times u r } ;
} ;
