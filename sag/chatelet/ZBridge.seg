-- Z-choice in the form of torsor/Affine (ZChoice over a type X, with
-- functions X -> R) for an affine X, from SAGAxioms.ZChoice on a finitely
-- presented algebra A with X = Spec A.  The functions are the coordinates
-- x |-> x(f_i); a ring map carries the unimodular relation in A to the
-- relation at every point.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module CF = FinChoice[l] ; module A7 = Alg73[l] ; module NF = NatFin[l] ;
-- a ring map preserves finite sums
hom-sum (A B : CRing) (h : RingHom[l].Hom A B) : (n : Nat) (v : Fin n -> A.R) ->
 Id B.R (h.1 (FiniteIdeal[l].Sums[A].sum n v)) (FiniteIdeal[l].Sums[B].sum n (\ i -> h.1 (v i))) = split {
 zero -> \ v -> RingHom[l].zero A B h ;
 suc n | r -> \ v -> trans (h.2.2.1 (v (inr tt)) (FiniteIdeal[l].Sums[A].sum n (\ i -> v (inl i))))
  (ap (B.add (h.1 (v (inr tt)))) (r (\ i -> v (inl i)))) } ;
module Over (R : CRing) (setR : Pr.isSet R.R) (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module Ax = SAGAxioms[l,l].Over[R,setR] ;
 module RB = RingBridge[l].Over[R,setR] ;
 module MD = Modules[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module At (X : U l) (Mx : X -> MD.Module) (A : C.Algebra) (fp : P.FP A) (e : Pr.Equiv X (C.Spec A)) {
  module Af = Affine[l].Aff[RB.ring,X,Mx] ;
  pt (x : X) : C.Spec A = e.1 x ;
  back (a : C.Spec A) : X = e.2.sec a ;
  back-pt (x : X) : Id X (back (pt x)) x = Pr.sec-ret X (C.Spec A) e.1 e.2 x ;
  module Data (B : X -> U l) (c : Ax.ChoiceData A (\ a -> B (back a)))
   (w : Ax.UnimodularWitness A c.1 c.2.1) {
   n : Nat = c.1 ;
   fs : Fin n -> A.ring.R = c.2.1 ;
   at (x : X) (a : A.ring.R) : R.R = (pt x).1.1 a ;
   f (k : CF.Fin (NF.toN n)) (x : X) : R.R = at x (fs (NF.fromF n k)) ;
   r (k : CF.Fin (NF.toN n)) (x : X) : R.R = at x (w.1 (NF.fromF n k)) ;
   term (x : X) (i : Fin n) : R.R = R.mul (at x (w.1 i)) (at x (fs i)) ;
   unim (x : X) : Id R.R (A7.Reg[RB.ring].sumR (NF.toN n) (\ k -> R.mul (r k x) (f k x))) R.o =
    trans (RB.sum n (\ k -> R.mul (r k x) (f k x)))
     (trans (RS.sum-cong n _ (\ i -> at x (A.ring.mul (fs i) (w.1 i)))
       (\ i -> trans (ap (term x) (NF.from-toF n i))
        (trans (R.mulC (at x (w.1 i)) (at x (fs i))) (Pr.sym R.R _ _ ((pt x).1.2.2.2 (fs i) (w.1 i))))))
      (trans (Pr.sym R.R _ _ (hom-sum A.ring R (pt x).1 n (\ i -> A.ring.mul (fs i) (w.1 i))))
       (trans (ap (pt x).1.1 w.2) (pt x).1.2.1))) ;
   section (k : CF.Fin (NF.toN n)) (x : X) (d : Af.Dg (f k) x) : B x =
    subst B (back-pt x) (c.2.2.2 (NF.fromF n k) (pt x) d) ;
   zc : Af.ZC B = (NF.toN n,f,r,unim,section) ;
  } ;
  zchoice : Af.ZChoice = \ B inh ->
   Tr.Trunc[Ax.ChoiceData A (\ a -> B (back a))].induction @l (\ t -> Tr.Trunc[Af.ZC B].carrier)
    (\ t -> Tr.Trunc[Af.ZC B].proposition)
    (\ c -> Tr.Trunc[Ax.UnimodularWitness A c.1 c.2.1].induction @l (\ t -> Tr.Trunc[Af.ZC B].carrier)
     (\ t -> Tr.Trunc[Af.ZC B].proposition) (\ w -> Tr.Trunc[Af.ZC B].inc (Data[B,c,w].zc)) c.2.2.1)
    (axioms.zchoice A fp (\ a -> B (back a)) (\ a -> inh (back a))) ;
 } ;
} ;
