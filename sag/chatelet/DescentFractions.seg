-- The denominator-clearing obligation in step 4, including a common
-- exponent for all columns of a local frame.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module DM = DescentModules[l].Over[R,setR,axioms] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module At (M : MD.Module) (modal : ET.T.isModal @l M.M)
  (sh : [j] SheafClosure[l,j].Over[ET.I,ET.G].Ops)
  (rank : Nat) (local : (sh @l).close (DL.On[M].Frame rank)) {
  module D = DescentQC[l].Over[R,setR,axioms].At[M,modal] ;
  qc : MD.WeaklyQC M =
   (sh @l).elim @l (DL.On[M].Frame rank) (MD.WeaklyQC M) D.qc-prop D.qc-modal
    (\ b -> P1.subst MD.Module (\ N -> MD.WeaklyQC N) (DL.Free rank) M
     (P1.sym MD.Module M (DL.Free rank) (DL.On[M].frame-equality rank b)) (DM.free-qc rank)) local ;
  opaque qc ;
  module Generator (idx : ET.I) {
   module G = D.Generator[idx] ;
   X : U l = ET.Root idx ;
   V : MD.Module = MD.pi (Fin rank) (\ j -> M) ;
   vector-qc : MD.WeaklyQC V = DM.Finite[rank,\ j -> M,\ j -> qc].theorem ;
   restriction : MD.Restriction X (\ x -> V) =
    Restriction718[l].Over[R,setR,axioms].At[X,G.scheme,\ x -> V,\ x -> vector-qc].theorem-7-1-8 ;
   module Af = Affine[l].Aff[MD.ring,X,\ x -> V] ;
   clear (g : X -> R.R) (v : (x : X) -> MD.RA.unit (g x) -> V.M) :
    Tr.Trunc[Af.Rep g v].carrier = (restriction g).1 v ;
   opaque clear ;
  } ;
 } ;
} ;
