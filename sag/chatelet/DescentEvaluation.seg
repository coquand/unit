-- Step 1: the power-basis evaluation M^d -> M^Root is an equivalence
-- for a sheaf module which is etale-locally finite free.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module EQ = Equivalences[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module MD = Modules[l].Over[R,setR] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ;
 module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module C = Algebras[l].Over[R,setR] ;
 module Generator (idx : ET.I) {
  module Roots = EtaleRoots[l].Over[R,setR].Generator[idx].Roots ;
  module B = Roots.B ;
  module EF = EtaleFreeLinear[l].Over[R,setR,ET.lower idx] ;
  d : Nat = B.d ;
  X : U l = ET.Root idx ;
  value (a : B.A.ring.R) (x : X) : R.R = (Roots.spec-root.2.sec x).1.1 a ;
  value-add (a b : B.A.ring.R) (x : X) :
   Id R.R (value (B.A.ring.add a b) x) (R.add (value a x) (value b x)) =
   (Roots.spec-root.2.sec x).1.2.2.1 a b ;
  value-scale (r : R.R) (a : B.A.ring.R) (x : X) :
   Id R.R (value (B.A.ring.mul (B.A.iota.1 r) a) x) (R.mul r (value a x)) =
   trans ((Roots.spec-root.2.sec x).1.2.2.2 (B.A.iota.1 r) a)
    (ap (\ c -> R.mul c (value a x)) ((Roots.spec-root.2.sec x).2 r)) ;
  sqc : Pr.isEquiv B.A.ring.R (X -> R.R) value =
   (EQ.compose B.A.ring.R (C.Spec B.A -> R.R) (X -> R.R)
    (C.evaluation B.A,axioms.sqc B.A B.fp) Roots.functions-root).2 ;
  e (t : Fin d) (x : X) : R.R = value (EF.basis-vector t) x ;
  evaluate (M : MD.Module) (u : Fin d -> M.M) (x : X) : M.M = DL.On[M].lin d u (\ t -> e t x) ;
  evaluate-equation (M : MD.Module) (u : Fin d -> M.M) (x : X) :
   Id M.M (evaluate M u x) (DL.On[M].S.sum d (\ t -> M.sm (e t x) (u t))) =
   DL.On[M].lin-value d u (\ t -> e t x) ;
  module Linear (M : MD.Module) {
   P : MD.Module = MD.pi (Fin d) (\ t -> M) ;
   Q : MD.Module = MD.pi X (\ x -> M) ;
   module LM = DL.On[M] ;
   add (u v : P.M) : Id Q.M (evaluate M (P.madd u v)) (Q.madd (evaluate M u) (evaluate M v)) =
    F.funext X (\ x -> M.M) _ _ (\ x ->
     trans (evaluate-equation M (P.madd u v) x)
      (trans (LM.S.congruent d (\ t -> M.sm (e t x) (M.madd (u t) (v t)))
        (\ t -> M.madd (M.sm (e t x) (u t)) (M.sm (e t x) (v t)))
        (\ t -> M.smD (e t x) (u t) (v t)))
       (trans (LM.sum-add d (\ t -> M.sm (e t x) (u t)) (\ t -> M.sm (e t x) (v t)))
        (cong2 M.M M.madd _ _ _ _ (sym (evaluate-equation M u x)) (sym (evaluate-equation M v x)))))) ;
   scale (a : R.R) (u : P.M) : Id Q.M (evaluate M (P.sm a u)) (Q.sm a (evaluate M u)) =
    F.funext X (\ x -> M.M) _ _ (\ x ->
     trans (evaluate-equation M (P.sm a u) x)
      (trans (LM.S.congruent d (\ t -> M.sm (e t x) (M.sm a (u t)))
        (\ t -> M.sm a (M.sm (e t x) (u t))) (\ t -> LM.MA.sm-swap (e t x) a (u t)))
       (trans (sym (LM.scale-sum a d (\ t -> M.sm (e t x) (u t))))
        (ap (M.sm a) (sym (evaluate-equation M u x)))))) ;
  } ;
  scalar (v : Fin d -> R.R) : X -> R.R = evaluate MD.regular v ;
  regular-sum (n : Nat) (v : Fin n -> R.R) :
   Id R.R (DL.On[MD.regular].S.sum n v) (RS.sum n v) =
   DL.On[MD.regular].S.map (\ a -> a) (refl R.z) (\ a b -> refl (R.add a b)) n v ;
  scalar-sum (v : Fin d -> R.R) (x : X) :
   Id R.R (scalar v x) (RS.sum d (\ t -> R.mul (e t x) (v t))) =
   trans (evaluate-equation MD.regular v x) (regular-sum d (\ t -> R.mul (e t x) (v t))) ;
  tensor (M : MD.Module) (v : Fin d -> R.R) (m : M.M) (x : X) :
   Id M.M (evaluate M (\ t -> M.sm (v t) m) x) (M.sm (scalar v x) m) =
   trans (evaluate-equation M (\ t -> M.sm (v t) m) x)
    (trans (DL.On[M].S.congruent d (\ t -> M.sm (e t x) (M.sm (v t) m))
      (\ t -> M.sm (R.mul (e t x) (v t)) m) (\ t -> M.smA (e t x) (v t) m))
     (trans (DL.On[M].S.sum-scale m d (\ t -> R.mul (e t x) (v t)))
      (ap (\ a -> M.sm a m) (sym (scalar-sum v x))))) ;
  scalar-value (v : Fin d -> R.R) (x : X) :
   Id R.R (scalar v x) (value (B.expansion v) x) =
   trans (DL.On[MD.regular].lin-value d v (\ t -> e t x))
    (trans (regular-sum d (\ t -> R.mul (e t x) (v t)))
     (trans (RS.sum-cong d (\ t -> R.mul (e t x) (v t)) (\ t -> R.mul (v t) (e t x))
      (\ t -> R.mulC (e t x) (v t)))
     (sym (trans (ap (\ a -> value a x) (sym (EF.basis-expansion v)))
      (trans (ZBridge[l].hom-sum B.A.ring R (Roots.spec-root.2.sec x).1 d
        (\ t -> B.A.ring.mul (B.A.iota.1 (v t)) (EF.basis-vector t)))
       (RS.sum-cong d (\ t -> value (B.A.ring.mul (B.A.iota.1 (v t)) (EF.basis-vector t)) x)
        (\ t -> R.mul (v t) (e t x)) (\ t -> value-scale (v t) (EF.basis-vector t) x))))))) ;
  scalar-equiv : Pr.isEquiv (Fin d -> R.R) (X -> R.R) scalar =
   EQ.homotopy (Fin d -> R.R) (X -> R.R)
    (EQ.compose (Fin d -> R.R) B.A.ring.R (X -> R.R)
     (Functions[l].inverse B.A.ring.R (Fin d -> R.R) B.basis) (value,sqc)) scalar
    (\ v -> F.funext X (\ x -> R.R) _ _ (\ x -> scalar-value v x)) ;
  module Free (rank : Nat) {
   M : MD.Module = DL.Free rank ;
   module Column (j : Fin rank) {
    module H = DL.Hom[M,MD.regular,\ v -> v j,
     \ u v -> refl (R.add (u j) (v j)),\ a v -> refl (R.mul a (v j))] ;
   } ;
   point (u : Fin d -> M.M) (x : X) (j : Fin rank) :
    Id R.R (evaluate M u x j) (scalar (\ t -> u t j) x) =
    Column[j].H.lin d u (\ t -> e t x) ;
   inverse (h : X -> M.M) (t : Fin d) (j : Fin rank) : R.R =
    scalar-equiv.sec (\ x -> h x j) t ;
   section (h : X -> M.M) : Id (X -> M.M) (evaluate M (inverse h)) h =
    F.funext X (\ x -> M.M) _ h (\ x -> F.funext (Fin rank) (\ j -> R.R) _ (h x) (\ j ->
     trans (point (inverse h) x j)
      (Pr.happly X (\ y -> R.R) _ (\ y -> h y j) (scalar-equiv.sec-eq (\ y -> h y j)) x))) ;
   retraction (u : Fin d -> M.M) : Id (Fin d -> M.M) (inverse (evaluate M u)) u =
    F.funext (Fin d) (\ t -> M.M) _ u (\ t -> F.funext (Fin rank) (\ j -> R.R) _ (u t) (\ j ->
     trans (ap (\ h -> scalar-equiv.sec h t)
       (F.funext X (\ x -> R.R) (\ x -> evaluate M u x j) (scalar (\ k -> u k j)) (\ x -> point u x j)))
      (ap (\ v -> v t) (Pr.sec-ret (Fin d -> R.R) (X -> R.R) scalar scalar-equiv (\ k -> u k j))))) ;
   theorem : Pr.isEquiv (Fin d -> M.M) (X -> M.M) (evaluate M) =
    Pr.qinv (Fin d -> M.M) (X -> M.M) (evaluate M) inverse section retraction ;
   opaque inverse ; opaque theorem ;
  } ;
  Claim (M : MD.Module) : U l = Pr.isEquiv (Fin d -> M.M) (X -> M.M) (evaluate M) ;
  module At (M : MD.Module) (modal : ET.T.isModal @l M.M)
   (sh : [j] SheafClosure[l,j].Over[ET.I,ET.G].Ops)
   (rank : Nat) (local : (sh @l).close (DL.On[M].Frame rank)) {
   module E = DescentEquiv[l].Over[ET.I,ET.G].At[Fin d -> M.M,X -> M.M,
    SL.modal-Pi (Fin d) (\ t -> M.M) (\ t -> modal),
    SL.modal-Pi X (\ x -> M.M) (\ x -> modal),evaluate M] ;
   equivalence : Claim M =
    (sh @l).elim @l (DL.On[M].Frame rank) (Claim M) E.proposition E.modal
     (\ b -> P1.subst MD.Module (\ N -> Claim N) (DL.Free rank) M
      (P1.sym MD.Module M (DL.Free rank) (DL.On[M].frame-equality rank b)) Free[rank].theorem) local ;
   opaque equivalence ;
  } ;
  opaque evaluate ;
 } ;
} ;
