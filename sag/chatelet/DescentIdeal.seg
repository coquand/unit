-- Underlying modules of algebras and locally based subtypes.
-- Closure of the subtype is a sheaf proposition and follows from a basis.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : [j] SheafClosure[l,j].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module A7 = Alg73[l] ; module ET = EtaleTopology[l].Over[R,setR] ;
 module DF = DescentFrames[l].Over[R,setR,axioms.loc] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ;
 module NA = NCAlgebra[l].Over[R,setR] ;
 underlying (A : NA.Algebra) : MD.Module = new A7.Mod[MD.ring,A.A,A.set,A.zero,A.add,A.neg,
  A.addA,A.addC,A.addZ,A.addN,A.scale,A.scale-scale,A.scale-one,A.scale-add,A.add-scale] ;
 module Rank (n : Nat) {
  module AP = AzumayaProbe[l].Over[R,setR,n,ET.I,ET.G,sh] ;
  module At (A : AP.Alg) (modal : ET.T.isModal @l A.A) (S : AP.Sub A)
   (local : (sh @l).close (AP.Basis A S)) {
   M : MD.Module = underlying A ;
   module MA = A7.MA[MD.ring,M] ;
   module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
   module Based (b : AP.Basis A S) {
    module H = DL.Hom[DL.Free (suc n),M,\ v -> (b.1 v).1,b.2.1,b.2.2.1] ;
    e : Pr.isEquiv AP.V (AP.Carrier A S) b.1 = b.2.2.2.1 ;
    zero : AP.mem A S A.zero = Pr.subst A.A (AP.mem A S) _ _ H.map-zero (b.1 (DL.Free (suc n)).mz).2 ;
    add (x y : A.A) (hx : AP.mem A S x) (hy : AP.mem A S y) : AP.mem A S (A.add x y) =
     Pr.subst A.A (AP.mem A S) _ _
      (trans (b.2.1 (e.sec (x,hx)) (e.sec (y,hy)))
       (cong2 A.A A.add _ _ _ _ (ap (\ s -> s.1) (e.sec-eq (x,hx))) (ap (\ s -> s.1) (e.sec-eq (y,hy)))))
      (b.1 ((DL.Free (suc n)).madd (e.sec (x,hx)) (e.sec (y,hy)))).2 ;
    scale (r : R.R) (x : A.A) (hx : AP.mem A S x) : AP.mem A S (A.scale r x) =
     Pr.subst A.A (AP.mem A S) _ _
      (trans (b.2.2.1 r (e.sec (x,hx))) (ap (A.scale r) (ap (\ s -> s.1) (e.sec-eq (x,hx)))))
      (b.1 ((DL.Free (suc n)).sm r (e.sec (x,hx)))).2 ;
   } ;
   closed (x : A.A) (f : AP.Basis A S -> AP.mem A S x) : AP.mem A S x =
    (sh @l).elim @l (AP.Basis A S) (AP.mem A S x) (AP.mem-prop A S x) (AP.mem-modal A S x) f local ;
   zero : AP.mem A S A.zero = closed A.zero (\ b -> Based[b].zero) ;
   add (x y : A.A) (hx : AP.mem A S x) (hy : AP.mem A S y) : AP.mem A S (A.add x y) =
    closed (A.add x y) (\ b -> Based[b].add x y hx hy) ;
   scale (r : R.R) (x : A.A) (hx : AP.mem A S x) : AP.mem A S (A.scale r x) =
    closed (A.scale r x) (\ b -> Based[b].scale r x hx) ;
   negative-one (x : A.A) : Id A.A (A.scale (R.neg R.o) x) (A.neg x) =
    MA.mneg-uniq x (A.scale (R.neg R.o) x)
     (trans (ap (\ v -> A.add v (A.scale (R.neg R.o) x)) (sym (A.scale-one x)))
      (trans (sym (A.add-scale R.o (R.neg R.o) x))
       (trans (ap (\ r -> A.scale r x) (R.addN R.o)) (MA.sm-zl x)))) ;
   neg (x : A.A) (hx : AP.mem A S x) : AP.mem A S (A.neg x) =
    Pr.subst A.A (AP.mem A S) _ _ (negative-one x) (scale (R.neg R.o) x hx) ;
   submodule : DescentSubmodules[l].Submodule[MD.ring,M] =
    new DescentSubmodules[l].Submodule[MD.ring,M,AP.mem A S,AP.mem-prop A S,zero,add,neg,scale] ;
   module SS = SM.Sub[M,submodule] ;
   carrier : MD.Module = SS.carrier ;
   carrier-modal : ET.T.isModal @l carrier.M =
    SL.modal-Sigma A.A (AP.mem A S) modal (AP.mem-modal A S) ;
   frame (b : AP.Basis A S) : DL.On[carrier].Frame (suc n) =
    DF.Rank[suc n].Map[carrier,b.1,
     \ u v -> SS.eq _ _ (b.2.1 u v),\ r v -> SS.eq _ _ (b.2.2.1 r v)].from-equiv b.2.2.2.1 ;
   local-frame : (sh @l).close (DL.On[carrier].Frame (suc n)) =
    (sh @l).elim @l (AP.Basis A S) ((sh @l).close (DL.On[carrier].Frame (suc n)))
     ((sh @l).proposition (DL.On[carrier].Frame (suc n))) ((sh @l).modal (DL.On[carrier].Frame (suc n)))
     (\ b -> (sh @l).inc (DL.On[carrier].Frame (suc n)) (frame b)) local ;
   theorem : Tr.Trunc[DL.On[carrier].Frame (suc n)].carrier =
    DescentTheoremD[l].Over[R,setR,axioms,sh].At[carrier,carrier-modal,suc n,local-frame].theorem ;
   opaque theorem ;
  } ;
 } ;
} ;
