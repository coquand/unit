-- Local-global principle for comaximal monoids S_1, ..., S_m of A,
-- for an A-algebra Rg with localisation maps phi_i : Rg -> D_i.
-- Comaximal: any choice of one element in each S_i generates 1.
-- Each phi_i inverts S_i, clears finitely many denominators by one
-- element of S_i, and its kernel is killed by elements of S_i.
--   Ideal: z lies in an ideal (w) of Rg if it does after each phi_i.
--   Overlaps.Glue: elements of the D_i which agree on the overlaps
--   come from one element of Rg.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A Rg : CRing) (kappa : RingHom[l].Hom A Rg) (m : Nat)
 (S : Fin m -> A.R -> U l) (one : (i : Fin m) -> S i A.o)
 (product : (i : Fin m) (s t : A.R) -> S i s -> S i t -> S i (A.mul s t))
 (comaximal : (s : Fin m -> A.R) -> ((i : Fin m) -> S i (s i)) ->
  Truncation[l].Trunc[FiniteIdeal[l].Sums[A].Coordinates m s A.o].carrier)
 (D : Fin m -> CRing) (phi : (i : Fin m) -> RingHom[l].Hom Rg (D i))
 (units : (i : Fin m) (s : A.R) -> S i s -> RL[D i].unit ((phi i).1 (kappa.1 s)))
 (clear : (i : Fin m) (r : Nat) (P : Fin r -> (D i).R) -> Truncation[l].Trunc[
   (d : A.R) * S i d * (p : Fin r -> Rg.R) *
   ((j : Fin r) -> Id (D i).R ((phi i).1 (p j)) ((D i).mul ((phi i).1 (kappa.1 d)) (P j)))].carrier)
 (kernel : (i : Fin m) (p : Rg.R) -> Id (D i).R ((phi i).1 p) (D i).z ->
  Truncation[l].Trunc[(s : A.R) * S i s * Id Rg.R (Rg.mul (kappa.1 s) p) Rg.z].carrier) {
 module Tr = Truncation[l] ;
 module TC = TruncationCombinators[l] ;
 module SA = FiniteIdeal[l].Sums[A] ;
 module SR = FiniteIdeal[l].Sums[Rg] ;
 module KS = StandardOpens[l].SumMap[A,Rg,kappa] ;
 module RG = RL[Rg] ;
 module RR = RingRearrange[l] ;
 k (a : A.R) : Rg.R = kappa.1 a ;
 interchange : (r n : Nat) (v : Fin r -> Fin n -> Rg.R) ->
  Id Rg.R (SR.sum r (\ j -> SR.sum n (v j))) (SR.sum n (\ i -> SR.sum r (\ j -> v j i))) = split {
  zero -> \ n v -> sym (SR.sum-zero n) ;
  suc r | ih -> \ n v ->
   trans (ap (Rg.add (SR.sum n (v (inr tt)))) (ih n (\ j -> v (inl j))))
    (sym (SR.sum-add n (v (inr tt)) (\ i -> SR.sum r (\ j -> v (inl j) i)))) } ;
 -- u a = u b with u a unit gives a = b.
 cancel (X : CRing) (u a b : X.R) (hu : RL[X].unit u) (h : Id X.R (X.mul u a) (X.mul u b)) : Id X.R a b =
  calc X.R {
   a =< sym (X.mulO a) > X.mul a X.o
     =< ap (X.mul a) (sym hu.2) > X.mul a (X.mul u hu.1)
     =< X.mulA a u hu.1 > X.mul (X.mul a u) hu.1
     =< ap (\ t -> X.mul t hu.1) (trans (X.mulC a u) (trans h (X.mulC u b))) > X.mul (X.mul b u) hu.1
     =< sym (X.mulA b u hu.1) > X.mul b (X.mul u hu.1)
     =< ap (X.mul b) hu.2 > X.mul b X.o
     =< X.mulO b > b } ;
 -- sum_i c_i s_i = 1 in A gives sum_i c_i (s_i v) = v in Rg.
 reconstruct (s c : Fin m -> A.R) (cover : Id A.R (SA.lin m s c) A.o) (v : Rg.R) :
  Id Rg.R (SR.sum m (\ i -> Rg.mul (k (c i)) (Rg.mul (k (s i)) v))) v =
  trans (SR.sum-cong m (\ i -> Rg.mul (k (c i)) (Rg.mul (k (s i)) v)) (\ i -> Rg.mul v (k (A.mul (s i) (c i))))
    (\ i -> trans (RG.mul-swap (k (c i)) (k (s i)) v)
     (trans (Rg.mulA (k (s i)) (k (c i)) v)
      (trans (ap (\ t -> Rg.mul t v) (sym (kappa.2.2.2 (s i) (c i)))) (Rg.mulC (k (A.mul (s i) (c i))) v)))))
   (trans (SR.sum-scale v m (\ i -> k (A.mul (s i) (c i))))
    (trans (ap (Rg.mul v) (trans (sym (KS.natural m (\ i -> A.mul (s i) (c i)))) (trans (ap kappa.1 cover) kappa.2.1)))
     (Rg.mulO v))) ;

 -- Membership in a finitely generated ideal is local.
 module Ideal (r : Nat) (w : Fin r -> Rg.R) (z : Rg.R) {
  Scaled (i : Fin m) : U l =
   (s : A.R) * S i s * (a : Fin r -> Rg.R) * Id Rg.R (Rg.mul (k s) z) (SR.lin r w a) ;
  Local (i : Fin m) : U l =
   (c : Fin r -> (D i).R) *
   Id (D i).R ((phi i).1 z) (FiniteIdeal[l].Sums[D i].lin r (\ j -> (phi i).1 (w j)) c) ;
  module AtLeaf (i : Fin m) (loc : Local i) {
   module SD = FiniteIdeal[l].Sums[D i] ;
   module Map = StandardOpens[l].SumMap[Rg,D i,phi i] ;
   f (a : Rg.R) : (D i).R = (phi i).1 a ;
   Cleared : U l = (d : A.R) * S i d * (a : Fin r -> Rg.R) *
    ((j : Fin r) -> Id (D i).R (f (a j)) ((D i).mul (f (k d)) (loc.1 j))) ;
   module Given (cl : Cleared) {
    d : A.R = cl.1 ;
    a : Fin r -> Rg.R = cl.2.2.1 ;
    first : Rg.R = Rg.mul (k d) z ;
    second : Rg.R = SR.lin r w a ;
    agree : Id (D i).R (f first) (f second) =
     trans ((phi i).2.2.2 (k d) z)
      (trans (ap ((D i).mul (f (k d))) loc.2)
       (sym (trans (Map.combination r w a)
        (trans (SD.sum-cong r (\ j -> (D i).mul (f (w j)) (f (a j)))
          (\ j -> (D i).mul (f (w j)) ((D i).mul (f (k d)) (loc.1 j)))
          (\ j -> ap ((D i).mul (f (w j))) (cl.2.2.2 j)))
         (SD.lin-scale r (\ j -> f (w j)) loc.1 (f (k d))))))) ;
    vanish : Id (D i).R (f (Rg.add first (Rg.neg second))) (D i).z =
     trans ((phi i).2.2.1 first (Rg.neg second))
      (trans (ap ((D i).add (f first)) (RingHom[l].negation Rg (D i) (phi i) second))
       (trans (ap (\ t -> (D i).add t ((D i).neg (f second))) agree)
        ((D i).addN (f second)))) ;
    Killer : U l = (s : A.R) * S i s * Id Rg.R (Rg.mul (k s) (Rg.add first (Rg.neg second))) Rg.z ;
    killed (kl : Killer) : Scaled i =
     (A.mul kl.1 d,product i kl.1 d kl.2.1 cl.2.1,\ j -> Rg.mul (k kl.1) (a j),
      trans (ap (\ t -> Rg.mul t z) (kappa.2.2.2 kl.1 d))
       (trans (sym (Rg.mulA (k kl.1) (k d) z))
        (trans (RR.cancel-difference Rg (k kl.1) first second kl.2.2)
         (sym (SR.lin-scale r w a (k kl.1)))))) ;
    result : Tr.Trunc[Scaled i].carrier =
     TC.map Killer (Scaled i) killed (kernel i (Rg.add first (Rg.neg second)) vanish) ;
   } ;
   scaled : Tr.Trunc[Scaled i].carrier =
    TC.bind Cleared (Scaled i) (\ cl -> Given[cl].result) (clear i r loc.1) ;
  } ;
  module FromScaled (sc : (i : Fin m) -> Scaled i)
   (cov : SA.Coordinates m (\ i -> (sc i).1) A.o) {
   s (i : Fin m) : A.R = (sc i).1 ;
   a (i : Fin m) (j : Fin r) : Rg.R = (sc i).2.2.1 j ;
   c (i : Fin m) : A.R = cov.1 i ;
   b (j : Fin r) : Rg.R = SR.sum m (\ i -> Rg.mul (k (c i)) (a i j)) ;
   equation : Id Rg.R (SR.lin r w b) z =
    trans (SR.sum-cong r (\ j -> Rg.mul (w j) (b j))
      (\ j -> SR.sum m (\ i -> Rg.mul (w j) (Rg.mul (k (c i)) (a i j))))
      (\ j -> sym (SR.sum-scale (w j) m (\ i -> Rg.mul (k (c i)) (a i j)))))
     (trans (interchange r m (\ j i -> Rg.mul (w j) (Rg.mul (k (c i)) (a i j))))
      (trans (SR.sum-cong m
        (\ i -> SR.sum r (\ j -> Rg.mul (w j) (Rg.mul (k (c i)) (a i j))))
        (\ i -> Rg.mul (k (c i)) (Rg.mul (k (s i)) z))
        (\ i -> trans (SR.lin-scale r w (a i) (k (c i)))
         (ap (Rg.mul (k (c i))) (sym (sc i).2.2.2))))
       (reconstruct s c cov.2 z))) ;
   result : SR.Coordinates r w z = (b,equation) ;
  } ;
  member (local : (i : Fin m) -> Local i) : Tr.Trunc[SR.Coordinates r w z].carrier =
   TC.bind ((i : Fin m) -> Scaled i) (SR.Coordinates r w z)
    (\ sc -> TC.map (SA.Coordinates m (\ i -> (sc i).1) A.o) (SR.Coordinates r w z)
      (\ cov -> FromScaled[sc,cov].result)
      (comaximal (\ i -> (sc i).1) (\ i -> (sc i).2.1)))
    (AffineFinite[l].choice m Scaled (\ i -> AtLeaf[i,local i].scaled)) ;
 } ;

 -- Gluing, given rings D_ij for the overlaps.
 module Overlaps (E : Fin m -> Fin m -> CRing)
  (left : (i j : Fin m) -> RingHom[l].Hom (D i) (E i j))
  (right : (i j : Fin m) -> RingHom[l].Hom (D j) (E i j))
  (commute : (i j : Fin m) (a : Rg.R) ->
   Id (E i j).R ((left i j).1 ((phi i).1 a)) ((right i j).1 ((phi j).1 a)))
  (overlap-kernel : (i j : Fin m) (p : Rg.R) -> Id (E i j).R ((left i j).1 ((phi i).1 p)) (E i j).z ->
   Tr.Trunc[(u : A.R) * (v : A.R) * S i u * S j v * Id Rg.R (Rg.mul (k (A.mul u v)) p) Rg.z].carrier) {
  module Glue (P : (i : Fin m) -> (D i).R)
   (agree : (i j : Fin m) -> Id (E i j).R ((left i j).1 (P i)) ((right i j).1 (P j))) {
   Fraction (i : Fin m) : U l = (d : A.R) * S i d * (p : Fin (suc zero) -> Rg.R) *
    ((j : Fin (suc zero)) -> Id (D i).R ((phi i).1 (p j)) ((D i).mul ((phi i).1 (k d)) (P i))) ;
   Result : U l = (g : Rg.R) * ((i : Fin m) -> Id (D i).R ((phi i).1 g) (P i)) ;
   module Cleared (fr : (i : Fin m) -> Fraction i) {
    d (i : Fin m) : A.R = (fr i).1 ;
    p (i : Fin m) : Rg.R = (fr i).2.2.1 (inr tt) ;
    image (i : Fin m) : Id (D i).R ((phi i).1 (p i)) ((D i).mul ((phi i).1 (k (d i))) (P i)) =
     (fr i).2.2.2 (inr tt) ;
    module Pair (i j : Fin m) {
     X : CRing = E i j ;
     psi : RingHom[l].Hom Rg X = RingHom[l].compose Rg (D i) X (left i j) (phi i) ;
     chi : RingHom[l].Hom Rg X = RingHom[l].compose Rg (D j) X (right i j) (phi j) ;
     first : Rg.R = Rg.mul (k (d j)) (p i) ;
     second : Rg.R = Rg.mul (k (d i)) (p j) ;
     image-j : Id (D j).R ((phi j).1 (p j)) ((D j).mul ((phi j).1 (k (d j))) (P j)) = image j ;
     one-side : Id X.R (psi.1 first) (X.mul (psi.1 (k (d j))) (X.mul (psi.1 (k (d i))) ((left i j).1 (P i)))) =
      trans (psi.2.2.2 (k (d j)) (p i))
       (ap (X.mul (psi.1 (k (d j))))
        (trans (ap (left i j).1 (image i))
         ((left i j).2.2.2 ((phi i).1 (k (d i))) (P i)))) ;
     other-side : Id X.R (chi.1 second) (X.mul (chi.1 (k (d i))) (X.mul (chi.1 (k (d j))) ((right i j).1 (P j)))) =
      trans (chi.2.2.2 (k (d i)) (p j))
       (ap (X.mul (chi.1 (k (d i))))
        (trans (ap (right i j).1 image-j)
         ((right i j).2.2.2 ((phi j).1 (k (d j))) (P j)))) ;
     same (a : A.R) : Id X.R (chi.1 (k a)) (psi.1 (k a)) = sym (commute i j (k a)) ;
     agree-both : Id X.R (psi.1 first) (psi.1 second) =
      trans one-side
       (trans (RL[X].mul-swap (psi.1 (k (d j))) (psi.1 (k (d i))) ((left i j).1 (P i)))
        (sym (trans (commute i j second)
         (trans other-side
          (cong2 X.R X.mul _ _ _ _ (same (d i))
           (cong2 X.R X.mul _ _ _ _ (same (d j)) (sym (agree i j)))))))) ;
     vanish : Id X.R (psi.1 (Rg.add first (Rg.neg second))) X.z =
      trans (psi.2.2.1 first (Rg.neg second))
       (trans (ap (X.add (psi.1 first)) (RingHom[l].negation Rg X psi second))
        (trans (ap (\ t -> X.add t (X.neg (psi.1 second))) agree-both)
         (X.addN (psi.1 second)))) ;
     Data : U l = (u : A.R) * (v : A.R) * S i u * S j v *
      Id Rg.R (Rg.mul (k (A.mul u v)) (Rg.add first (Rg.neg second))) Rg.z ;
     witness : Tr.Trunc[Data].carrier = overlap-kernel i j (Rg.add first (Rg.neg second)) vanish ;
    } ;
    AllData : U l = (i j : Fin m) -> Pair[i,j].Data ;
    module Compatible (ov : AllData) {
     u (i j : Fin m) : A.R = (ov i j).1 ;
     v (i j : Fin m) : A.R = (ov i j).2.1 ;
     module CN = CompatibleNumerators[l].Over[A,Rg,kappa,m,d,p,u,v,\ i j -> (ov i j).2.2.2.2] ;
     r-member (i : Fin m) : S i (CN.r i) =
      CN.P.member (S i) (one i) (product i) m (\ x -> A.mul (u i x) (v x i))
       (\ x -> product i (u i x) (v x i) (ov i x).2.2.1 (ov x i).2.2.2.1) ;
     s-member (i : Fin m) : S i (CN.s i) = product i (d i) (CN.r i) (fr i).2.1 (r-member i) ;
     module With (cov : SA.Coordinates m CN.s A.o) {
      c (i : Fin m) : A.R = cov.1 i ;
      g : Rg.R = SR.sum m (\ x -> Rg.mul (k (c x)) (CN.h x)) ;
      restrict (i : Fin m) : Id Rg.R (Rg.mul (k (CN.s i)) g) (CN.h i) =
       trans (sym (SR.sum-scale (k (CN.s i)) m (\ x -> Rg.mul (k (c x)) (CN.h x))))
        (trans (SR.sum-cong m
          (\ x -> Rg.mul (k (CN.s i)) (Rg.mul (k (c x)) (CN.h x)))
          (\ x -> Rg.mul (k (c x)) (Rg.mul (k (CN.s x)) (CN.h i)))
          (\ x -> trans (RG.mul-swap (k (CN.s i)) (k (c x)) (CN.h x))
           (ap (Rg.mul (k (c x))) (CN.Pair[i,x].overlap))))
         (reconstruct CN.s c cov.2 (CN.h i))) ;
      module Leaf (i : Fin m) {
       Di : CRing = D i ;
       f (a : Rg.R) : Di.R = (phi i).1 a ;
       scalar : Id Di.R (Di.mul (f (k (CN.r i))) (f (k (d i)))) (f (k (CN.s i))) =
        trans (sym ((phi i).2.2.2 (k (CN.r i)) (k (d i))))
         (ap (phi i).1 (trans (sym (kappa.2.2.2 (CN.r i) (d i))) (ap kappa.1 (A.mulC (CN.r i) (d i))))) ;
       local : Id Di.R (f g) (P i) =
        cancel Di (f (k (CN.s i))) (f g) (P i) (units i (CN.s i) (s-member i))
         (trans (sym ((phi i).2.2.2 (k (CN.s i)) g))
          (trans (ap (phi i).1 (restrict i))
           (trans ((phi i).2.2.2 (k (CN.r i)) (p i))
            (trans (ap (Di.mul (f (k (CN.r i)))) (image i))
             (trans (Di.mulA (f (k (CN.r i))) (f (k (d i))) (P i))
              (ap (\ t -> Di.mul t (P i)) scalar)))))) ;
      } ;
      result : Result = (g,\ i -> Leaf[i].local) ;
     } ;
     result : Tr.Trunc[Result].carrier =
      TC.map (SA.Coordinates m CN.s A.o) Result (\ cov -> With[cov].result) (comaximal CN.s s-member) ;
    } ;
    result : Tr.Trunc[Result].carrier =
     TC.bind AllData Result (\ ov -> Compatible[ov].result)
      (AffineFinite[l].choice m (\ i -> (j : Fin m) -> Pair[i,j].Data)
       (\ i -> AffineFinite[l].choice m (\ j -> Pair[i,j].Data) (\ j -> Pair[i,j].witness))) ;
   } ;
   glue : Tr.Trunc[Result].carrier =
    TC.bind ((i : Fin m) -> Fraction i) Result (\ fr -> Cleared[fr].result)
     (AffineFinite[l].choice m Fraction (\ i -> clear i (suc zero) (\ j -> P i))) ;
  } ;
 } ;
} ;
