-- The degree-lowering step for the formal gcd computation.
-- A polynomial in I whose top surviving coefficient is a unit
-- supplies a monic member of I of precisely that smaller degree.
level l ; open Ring[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R)
 (phi : RingHom[l].Hom A C)
 (lift-unit : (a : A.R) -> Id C.R (phi.1 a) C.o -> RL[A].unit a) {
 module P = Poly[l].PolyR[A] ;
 module M = Mul[l].MulR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module IA = Ideals[l].Over[B.ring,B.set] ;
 module Red = DivisionReduction[l].Over[A,C,setA,phi] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Normal = MonicNormalForm[l].Over[A,setA] ;
 module At (I : IA.Ideal) (lower : List A.R) (member : I.1 (H.monic lower))
  (g : P.P) (g-member : I.1 (B.include g)) (r : Nat)
  (top-unit : RL[A].unit (P.coef g r)) (bound : Red.Bound (suc r) g) {
  normalized : P.P = M.scal top-unit.1 g ;
  normalized-leading : Id A.R (P.coef normalized r) A.o =
   trans (M.coef-scal top-unit.1 g r)
    (trans (A.mulC top-unit.1 (P.coef g r)) top-unit.2) ;
  leading : Id C.R (phi.1 (P.coef normalized r)) C.o =
   trans (ap phi.1 normalized-leading) phi.2.1 ;
  normalized-bound : Red.Bound (suc r) normalized =
   \ k -> trans (ap phi.1 (M.coef-scal top-unit.1 g (plus (suc r) k)))
    (trans (phi.2.2.2 top-unit.1 (P.coef g (plus (suc r) k)))
     (trans (ap (C.mul (phi.1 top-unit.1)) (bound k)) (RL[C].mul-zero (phi.1 top-unit.1)))) ;
  scalar-equation : Id B.Carrier
   (B.mulQ (B.constant top-unit.1) (B.include g)) (B.include normalized) =
   trans (B.Multiply.beta (cons top-unit.1 nil) g)
    (B.Q.relates (M.pmul (cons top-unit.1 nil) g) normalized
     (RawMultiplication[l].Laws[A].mul-single-left top-unit.1 g)) ;
  normalized-member : I.1 (B.include normalized) =
   IA.In[I].equal _ _ scalar-equation
    (I.2.2.2.2 (B.constant top-unit.1) (B.include g) g-member) ;
  module Lift = MonicLifting[l].Over[A,C,setA,phi,lift-unit].At[
   I,r,normalized,leading,normalized-bound,normalized-member] ;
  result : Lift.Result =
   Lift.lift (H.monic-list lower) (len lower) (H.leading lower) (H.above lower) member ;
  new-lower : List A.R = Bounds.cut r result.1 ;
  degree : Id Nat (len new-lower) r = Bounds.cut-length r result.1 ;
  equation : Id B.Carrier (B.include result.1) (H.monic new-lower) =
   Normal.equation r result.1 result.2.1 result.2.2.1 ;
  new-member : I.1 (H.monic new-lower) =
   IA.In[I].equal _ _ equation result.2.2.2.2 ;
 } ;
} ;
