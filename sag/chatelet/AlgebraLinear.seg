-- Any commutative A-algebra is a module for finite generator elimination.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A B : CRing) (phi : RingHom[l].Hom A B) {
 module BR = RL[B] ;
 module L = FiniteLinear[l].Over[A] ;
 scale (a : A.R) (v : B.R) : B.R = B.mul (phi.1 a) v ;
 scalar-add (a b : A.R) (v : B.R) :
  Id B.R (scale (A.add a b) v) (B.add (scale a v) (scale b v)) =
  trans (ap (\ c -> B.mul c v) (phi.2.2.1 a b)) (BR.dist-left (phi.1 a) (phi.1 b) v) ;
 scalar-mul (a b : A.R) (v : B.R) :
  Id B.R (scale (A.mul a b) v) (scale a (scale b v)) =
  trans (ap (\ c -> B.mul c v) (phi.2.2.2 a b)) (sym (B.mulA (phi.1 a) (phi.1 b) v)) ;
 scalar-one (v : B.R) : Id B.R (scale A.o v) v =
  trans (ap (\ c -> B.mul c v) phi.2.1) (trans (B.mulC B.o v) (B.mulO v)) ;
 scalar-zero (v : B.R) : Id B.R (scale A.z v) B.z =
  trans (ap (\ c -> B.mul c v) (RingHom[l].zero A B phi)) (BR.zero-mul v) ;
 structure : L.Module = L.mkModule B.R B.z B.add scale B.addA B.addC B.addZ
  scalar-add (\ a -> B.dist (phi.1 a)) scalar-mul scalar-one scalar-zero
  (\ a -> BR.mul-zero (phi.1 a)) ;
 module LinearSums = L.In[structure] ;
 module RingSums = FiniteIdeal[l].Sums[B] ;
 sums-agree : (n : Nat) (v : Fin n -> B.R) ->
  Id B.R (LinearSums.sum n v) (RingSums.sum n v) = split {
  zero -> \ v -> refl B.z ;
  suc n | ih -> \ v -> ap (B.add (v (inr tt))) (ih (\ i -> v (inl i))) } ;
 lin-equation (n : Nat) (a : Fin n -> A.R) (v : Fin n -> B.R) :
  Id B.R (LinearSums.lin n a v)
   (RingSums.sum n (\ i -> B.mul (phi.1 (a i)) (v i))) =
  sums-agree n (\ i -> B.mul (phi.1 (a i)) (v i)) ;
} ;
