-- The type of open propositions is an etale sheaf, one universe up.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module P1 = Prelude[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
module Tr = Truncation[l] ;
module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module T = ET.T ;
 module OP = OpenProp[l].Over[R,setR] ;
 module EO = EtaleOpen[l].Over[R,setR,axioms] ;
 module EC = EtaleCompact[l].Over[R,setR,axioms] ;
 module S0 = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module S1 = SheafLemmas[l,l+].Over[ET.I,ET.G] ;
 module EM = EtaleModal[l,l+].Over[ET.I,ET.G] ;
 Opn : U l+ = (Q : U l) * OP.Open Q ;
 prop (p : Opn) : Pr.isProp p.1 = OP.open-prop p.1 p.2 ;
 Iff (p q : Opn) : U l = OpenProp[l].Iff p.1 q.1 ;
 iff-prop (p q : Opn) : Pr.isProp (Iff p q) =
  Pr.isProp-Sigma (p.1 -> q.1) (\ f -> q.1 -> p.1)
   (FL.isProp-Pi p.1 (\ x -> q.1) (\ x -> prop q))
   (\ f -> FL.isProp-Pi q.1 (\ x -> p.1) (\ x -> prop p)) ;
 ext (p q : Opn) (e : Iff p q) : Id Opn p q =
  P1.Sigma-eq (U l) (\ Q -> OP.Open Q) p.1 q.1 p.2 q.2
   (UA.ua p.1 q.1 (e.1,Pr.qinv p.1 q.1 e.1 e.2
     (\ b -> prop q _ b) (\ a -> prop p _ a)))
   Tr.Trunc[OP.Witness q.1].proposition ;
 set-opens : P1.isSet Opn = \ p ->
  P1.Hedberg[Opn,p,\ q -> Iff p q,\ q -> iff-prop p q,(\ a -> a,\ a -> a),\ q -> ext p q].hedberg ;
 encode (p q : Opn) (e : Id Opn p q) : Iff p q =
  (Pr.coe p.1 q.1 (P1.ap Opn (U l) (\ a -> a.1) p q e),
   Pr.coe q.1 p.1 (P1.sym (U l) p.1 q.1 (P1.ap Opn (U l) (\ a -> a.1) p q e))) ;
 up (X : U l) (modal : T.isModal @l X) : T.isModal @(l+) X = \ i ->
  struct { sec = (modal i).sec ; sec-eq = (modal i).sec-eq ;
   ret = (modal i).ret ; ret-eq = (modal i).ret-eq } ;
 iff-local (p q : Opn) : T.isModal @l (Iff p q) =
  S0.modal-Sigma (p.1 -> q.1) (\ f -> q.1 -> p.1)
   (S0.modal-Pi p.1 (\ a -> q.1) (\ a -> EO.open-local q.1 q.2))
   (\ f -> S0.modal-Pi q.1 (\ a -> p.1) (\ a -> EO.open-local p.1 p.2)) ;
 separated (p q : Opn) : T.isModal @(l+) (Id Opn p q) =
  S1.modal-of-sec (Id Opn p q) (set-opens p q)
   (\ i h -> ext p q ((up (Iff p q) (iff-local p q) i).sec (\ g -> encode p q (h g)))) ;
 module Sep = EM.Separated[Opn,set-opens,separated] ;
 module Function (i : ET.I) (h : ET.G i -> Opn) {
  Value : U l = (y : ET.Root i) -> (h (ET.root-inc i y)).1 ;
  value-open : OP.Open Value = EC.At[i].compact
   (\ y -> (h (ET.root-inc i y)).1) (\ y -> (h (ET.root-inc i y)).2) ;
  constant-open : Opn = (Value,value-open) ;
  to (g : ET.G i) (v : Value) : (h g).1 =
   Tr.Trunc[ET.Root i].induction @l (\ t -> (h g).1) (\ t -> prop (h g))
    (\ y -> (encode (h (ET.root-inc i y)) (h g) (P1.ap (ET.G i) Opn h _ _ (ET.G-prop i _ _))).1 (v y)) g ;
  from (g : ET.G i) (v : (h g).1) : Value = \ y ->
   (encode (h g) (h (ET.root-inc i y)) (P1.ap (ET.G i) Opn h _ _ (ET.G-prop i _ _))).1 v ;
  constant : Sep.At[i,h].Constant = (constant-open,\ g -> ext constant-open (h g) (to g,from g)) ;
 } ;
 opens-local : T.isModal @(l+) Opn = Sep.separated-factor
  (\ i h -> Tr1.Trunc[Sep.At[i,h].Constant].inc Function[i,h].constant) ;
 opaque opens-local ;
} ;
