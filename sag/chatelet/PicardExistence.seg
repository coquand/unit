-- Corollary 4.5: chart triviality plus Laurent factorisation.
-- All passage between line bundles, frames, transitions and gauges is
-- constructed here. Only B's Factorisation and geometric ChartTriviality
-- are module parameters.
level l ; open Prelude[l] ; open Paths[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module Tr = Truncation[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R)
 (factor : PicardInterface[l].Over[R,setR].Factorisation)
 (charts : PicardTwists[l].Over[R,setR].ChartTriviality) {
 module P = Projective[l].Line[R,setR] ;
 module G = PicardUnits[l].Over[R,setR] ;
 module L = PicardLines[l].Over[R,setR] ;
 module W = PicardTwists[l].Over[R,setR] ;
 module I = PicardInterface[l].Over[R,setR] ;
 module Gauge = PicardGauge[l].Over[R,setR] ;
 Bundle : U l = P.P1 -> L.Line ;
 Result (B : Bundle) : U l = Tr.Trunc[(d : PicardInterface[l].Degree) * Id Bundle B (W.O d)].carrier ;
 cancel (a b : G.Unit) : Id G.Unit (G.times (G.times a b) (G.inverse a)) b =
  transH (ap G.Unit G.Unit (\ z -> G.times z (G.inverse a)) (G.times a b) (G.times b a) (G.comm a b))
   (transH (G.assoc b a (G.inverse a))
    (transH (ap G.Unit G.Unit (G.times b) (G.times a (G.inverse a)) G.one (G.invr a)) (G.unitr b))) ;
 simplify (u m a b : G.Unit) :
  Id G.Unit (G.times (G.times u (G.times m (G.times a b))) (G.inverse a)) (G.times (G.times u b) m) =
  transH (G.assoc u (G.times m (G.times a b)) (G.inverse a))
   (transH (ap G.Unit G.Unit (G.times u) _ _ (G.assoc m (G.times a b) (G.inverse a)))
    (transH (ap G.Unit G.Unit (\ z -> G.times u (G.times m z)) _ _ (cancel a b))
     (transH (ap G.Unit G.Unit (G.times u) _ _ (G.comm m b)) (symH (G.assoc u b m))))) ;
 module Frames (B : Bundle)
  (s0 : (x : R.R) -> Id L.Line (B (P.affine x)) L.trivial)
  (s1 : (y : R.R) -> Id L.Line (B (P.infinity-chart y)) L.trivial) {
  raw (p : P.P1) : L.TI.Tor = L.torsor (B p) ;
  loF (x : R.R) : (raw (P.affine x)).1 = L.frame (B (P.affine x)) (s0 x) ;
  hiF (y : R.R) : (raw (P.infinity-chart y)).1 = L.frame (B (P.infinity-chart y)) (s1 y) ;
  module F = Gauge.F[raw,loF,hiF] ;
  module Factors (w : I.Factors F.transition) {
   d : PicardInterface[l].Degree = w.1 ;
   u : G.Unit = w.2.1 ; a : I.PolynomialUnit = w.2.2.1 ; b : I.PolynomialUnit = w.2.2.2.1 ;
   module Target = W.Glue[I.monomial d] ;
   module Compare = Gauge.Compare[raw,Target.raw,loF,hiF,
    \ x -> Target.chart-frame (lo x),\ y -> Target.chart-frame (hi y),F.transition,I.monomial d,F.law,Target.transition] ;
   ga (x : R.R) : G.Unit = G.inverse (a x) ;
   gb (y : R.R) : G.Unit = G.times u (b y) ;
   equation (x : G.Unit) : Id G.Unit (G.times (F.transition x) (ga x.1)) (G.times (gb x.2.1) (I.monomial d x)) =
    transH (ap G.Unit G.Unit (\ z -> G.times z (ga x.1)) _ _ (w.2.2.2.2 x))
     (simplify u (I.monomial d x) (a x.1) (b x.2.1)) ;
   module Map = Compare.Build[ga,gb,equation] ;
   equality : Id Bundle B (W.O d) =
    transH (symH (FL.funext P.P1 (\ p -> L.Line) (\ p -> L.pack (raw p)) B (\ p -> L.pack-unpack (B p)))) Map.equality ;
   result : Result B = Tr.Trunc[(d : PicardInterface[l].Degree) * Id Bundle B (W.O d)].inc (d,equality) ;
  } ;
  result : Result B = Tr.Trunc[I.Factors F.transition].induction @l (\ t -> Result B)
   (\ t -> Tr.Trunc[(d : PicardInterface[l].Degree) * Id Bundle B (W.O d)].proposition)
   (\ w -> Factors[w].result) (factor F.transition) ;
 } ;
 exists (B : Bundle) : Result B =
  Tr.Trunc[(x : R.R) -> Id L.Line (B (P.affine x)) L.trivial].induction @l
   (\ t -> Result B) (\ t -> Tr.Trunc[(d : PicardInterface[l].Degree) * Id Bundle B (W.O d)].proposition)
   (\ s0 -> Tr.Trunc[(y : R.R) -> Id L.Line (B (P.infinity-chart y)) L.trivial].induction @l
    (\ t -> Result B) (\ t -> Tr.Trunc[(d : PicardInterface[l].Degree) * Id Bundle B (W.O d)].proposition)
    (\ s1 -> Frames[B,s0,s1].result) (charts B).2) (charts B).1 ;
} ;
