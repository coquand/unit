-- One step of the divisor proof of rank-one Horrocks over a local ring.
-- Data: y_1..y_n in A[X] and e_ij with e_ik y_j = e_ij y_k, sum_i e_ii = 1,
-- and a monic F = sum_k y_k c_k of degree d in L = (y_1..y_n).
-- Division by F gives an A-linear projection rho of A[X] onto L. With it,
-- every bounded element of L is an A-combination of d fixed ones, whose
-- coefficients lie in the ideal J of top coefficients; Nakayama and
-- locality then give: either F generates L, or L has a monic of degree d-1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
-- The power-basis index of a finite coordinate (last coordinate = X^0).
index : (n : Nat) -> Fin n -> Nat = split {
 zero -> \ i -> efq i ;
 suc n | ih -> snoc (Fin n) Nat (\ i -> suc (ih i)) zero } ;
-- Every index below suc m has a complement summing to m.
complement : (m : Nat) (i : Fin (suc m)) -> (k : Nat) * Id Nat (plus (index (suc m) i) k) m = split {
 zero -> split {
  inl i -> efq i ;
  inr t -> (zero,refl zero) } ;
 suc m | ih -> split {
  inl i -> ((ih i).1,ap (\ j -> suc j) (ih i).2) ;
  inr t -> (suc m,refl (suc m)) } } ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (loc : (a b : A.R) -> RL[A].unit (A.add a b) ->
  Tr.Trunc[Plus (RL[A].unit a) (RL[A].unit b)].carrier) {
 module P = Poly[l].PolyR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module Red = MonicReduction[l].Over[A,setA] ;
 module SA = FiniteIdeal[l].Sums[A] ;
 module S = FiniteIdeal[l].Sums[B.ring] ;
 module AR = RL[A] ;
 module BR = RL[B.ring] ;
 module IA = Ideals[l].Over[A,setA] ;
 module IB = Ideals[l].Over[B.ring,B.set] ;
 module E = PolynomialFiniteExpansion[l].Over[A,B.ring,setA,RingHom[l].identity B.ring] ;
 module Lin = AlgebraLinear[l].Over[A,B.ring,B.inclusion] ;
 module Nak = UnitNakayama[l].Over[A,setA] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Normal = MonicNormalForm[l].Over[A,setA] ;
 cst (a : A.R) : B.Carrier = B.constant a ;
 -- Finite sums in A[X].
 sum-swap : (n m : Nat) (f : Fin n -> Fin m -> B.Carrier) ->
  Id B.Carrier (S.sum n (\ i -> S.sum m (f i))) (S.sum m (\ j -> S.sum n (\ i -> f i j))) = split {
  zero -> \ m f -> sym (S.sum-zero m) ;
  suc n | ih -> \ m f ->
   trans (ap (B.addQ (S.sum m (f (inr tt)))) (ih m (\ i -> f (inl i))))
    (sym (S.sum-add m (f (inr tt)) (\ j -> S.sum n (\ i -> f (inl i) j)))) } ;
 coef-sum : (n : Nat) (v : Fin n -> B.Carrier) (k : Nat) ->
  Id A.R (Red.coef (S.sum n v) k) (SA.sum n (\ i -> Red.coef (v i) k)) = split {
  zero -> \ v k -> Red.coef-zero k ;
  suc n | ih -> \ v k -> trans (Red.coef-add (v (inr tt)) (S.sum n (\ i -> v (inl i))) k)
   (ap (A.add (Red.coef (v (inr tt)) k)) (ih (\ i -> v (inl i)) k)) } ;
 bounded-sum (d : Nat) : (n : Nat) (v : Fin n -> B.Carrier) ->
  ((i : Fin n) -> Red.Bounded d (v i)) -> Red.Bounded d (S.sum n v) = split {
  zero -> \ v h -> Red.bounded-zero d ;
  suc n | ih -> \ v h -> Red.bounded-add d (v (inr tt)) (S.sum n (\ i -> v (inl i)))
   (h (inr tt)) (ih (\ i -> v (inl i)) (\ i -> h (inl i))) } ;
 -- r = x - m whenever x = m + r.
 solve (x m r : B.Carrier) (h : Id B.Carrier x (B.addQ m r)) :
  Id B.Carrier r (B.addQ x (B.negQ m)) =
  trans (sym (BR.add-neg-cancel r m))
   (trans (ap (\ w -> B.addQ w (B.negQ m)) (B.ring.addC r m))
    (ap (\ w -> B.addQ w (B.negQ m)) (sym h))) ;
 -- x = m + (x - m') when m = m'.
 reassemble (x m m' : B.Carrier) (h : Id B.Carrier m m') :
  Id B.Carrier x (B.addQ m (B.addQ x (B.negQ m'))) =
  sym (trans (ap (\ w -> B.addQ w (B.addQ x (B.negQ m'))) h)
   (trans (BR.add-swap m' x (B.negQ m')) (trans (ap (B.addQ x) (B.ring.addN m')) (B.ring.addZ x)))) ;
 -- A-linear maps commute with finite A-combinations.
 module Linear (phi : B.Carrier -> B.Carrier)
  (phi-add : (x y : B.Carrier) -> Id B.Carrier (phi (B.addQ x y)) (B.addQ (phi x) (phi y)))
  (phi-scale : (a : A.R) (x : B.Carrier) -> Id B.Carrier (phi (B.mulQ (cst a) x)) (B.mulQ (cst a) (phi x)))
  (phi-zero : Id B.Carrier (phi B.zeroQ) B.zeroQ) {
  combination : (n : Nat) (a : Fin n -> A.R) (v : Fin n -> B.Carrier) ->
   Id B.Carrier (phi (S.sum n (\ i -> B.mulQ (cst (a i)) (v i))))
    (S.sum n (\ i -> B.mulQ (cst (a i)) (phi (v i)))) = split {
   zero -> \ a v -> phi-zero ;
   suc n | ih -> \ a v ->
    trans (phi-add (B.mulQ (cst (a (inr tt))) (v (inr tt)))
      (S.sum n (\ i -> B.mulQ (cst (a (inl i))) (v (inl i)))))
     (cong2 B.Carrier B.addQ _ _ _ _ (phi-scale (a (inr tt)) (v (inr tt)))
      (ih (\ i -> a (inl i)) (\ i -> v (inl i)))) } ;
 } ;
 -- Coordinates in the power basis, read on A[X].
 coefficients-index : (n : Nat) (p : P.P) (i : Fin n) ->
  Id A.R (E.coefficients n p i) (P.coef p (index n i)) = split {
  zero -> \ p i -> efq i ;
  suc n | ih -> \ p -> split {
   inl i -> trans (ih (Bounds.tail p) i) (Bounds.tail-coef p (index n i)) ;
   inr t -> refl (P.coef p zero) } } ;
 coordinate (d : Nat) (w : B.Carrier) (i : Fin d) : A.R = Red.coef w (index d i) ;
 Expands (d : Nat) (w : B.Carrier) : U l =
  Red.Bounded d w -> Id B.Carrier w (S.sum d (\ i -> B.mulQ (cst (coordinate d w i)) (E.basis d i))) ;
 expand (d : Nat) : (w : B.Carrier) -> Expands d w =
  B.Q.induction @l (Expands d)
   (\ w -> FE.isProp-Pi (Red.Bounded d w)
    (\ h -> Id B.Carrier w (S.sum d (\ i -> B.mulQ (cst (coordinate d w i)) (E.basis d i))))
    (\ h -> B.set _ _))
   (\ p h -> trans (E.equation d p (\ k -> trans (sym (Red.coef-include p (plus d k))) (h k)))
    (S.sum-cong d (\ i -> B.mulQ (cst (E.coefficients d p i)) (E.basis d i))
     (\ i -> B.mulQ (cst (coordinate d (B.include p) i)) (E.basis d i))
     (\ i -> ap (\ a -> B.mulQ (cst a) (E.basis d i))
     (trans (coefficients-index d p i) (sym (Red.coef-include p (index d i))))))) ;
 raw-representative : (x : B.Carrier) ->
  Tr.Trunc[(p : P.P) * Id B.Carrier (B.include p) x].carrier =
  B.Q.induction @l (\ x -> Tr.Trunc[(p : P.P) * Id B.Carrier (B.include p) x].carrier)
   (\ x -> Tr.Trunc[(p : P.P) * Id B.Carrier (B.include p) x].proposition)
   (\ p -> Tr.Trunc[(q : P.P) * Id B.Carrier (B.include q) (B.include p)].inc (p,refl (B.include p))) ;
 module Data (n : Nat) (y : Fin n -> B.Carrier) (e : Fin n -> Fin n -> B.Carrier)
  (exchange : (i j k : Fin n) -> Id B.Carrier (B.mulQ (e i k) (y j)) (B.mulQ (e i j) (y k)))
  (trace : Id B.Carrier (S.sum n (\ i -> e i i)) B.oneQ) {
  module G = IB.Gen[n,y] ;
  module Cert = FiniteIdeal[l].Over[B.ring,n,y] ;
  Lid : IB.Ideal = G.ideal ;
  InL (x : B.Carrier) : U l = Lid.1 x ;
  module LI = IB.In[Lid] ;
  in-mul (a x : B.Carrier) (h : InL x) : InL (B.mulQ a x) = Lid.2.2.2.2 a x h ;
  in-add (x x' : B.Carrier) (h : InL x) (h' : InL x') : InL (B.addQ x x') = Lid.2.2.2.1 x x' h h' ;
  in-neg (x : B.Carrier) (h : InL x) : InL (B.negQ x) =
   LI.equal _ _ (trans (BR.neg-mul-left B.oneQ x) (ap B.negQ (BR.one-left x)))
    (in-mul (B.negQ B.oneQ) x h) ;
  member (c : Fin n -> B.Carrier) (x : B.Carrier) (h : Id B.Carrier (S.lin n y c) x) : InL x =
   Tr.Trunc[Cert.Certificate x B.zeroQ].inc (c,sym (trans (BR.zl (S.lin n y c)) h)) ;
  Principal : U l = (g : B.Carrier) * (a c : Fin n -> B.Carrier) *
   ((i : Fin n) -> Id B.Carrier (y i) (B.mulQ g (a i))) * Id B.Carrier (S.lin n y c) g ;
  -- L is generated by the monic polynomial of the list.
  MonicPrincipal : U l = (lower : List A.R) * (p : Principal) * Id B.Carrier p.1 (H.monic lower) ;
  Lower (m : Nat) : U l = (lower : List A.R) * Id Nat (len lower) m *
   (c : Fin n -> B.Carrier) * Id B.Carrier (S.lin n y c) (H.monic lower) ;
  module Step (lower : List A.R) (cs : Fin n -> B.Carrier)
   (generated : Id B.Carrier (S.lin n y cs) (H.monic lower)) {
   module D = Red.At[lower] ;
   F : B.Carrier = D.F ;
   d : Nat = D.d ;
   F-in : InL F = member cs F generated ;
   x (i : Fin n) : B.Carrier = S.sum n (\ k -> B.mulQ (e i k) (cs k)) ;
   -- y_j (e_ik c_k) = e_ij (y_k c_k).
   term (i j k : Fin n) :
    Id B.Carrier (B.mulQ (y j) (B.mulQ (e i k) (cs k))) (B.mulQ (e i j) (B.mulQ (y k) (cs k))) =
    trans (BR.mul-swap (y j) (e i k) (cs k))
     (trans (B.ring.mulA (e i k) (y j) (cs k))
      (trans (ap (\ w -> B.mulQ w (cs k)) (exchange i j k))
       (sym (B.ring.mulA (e i j) (y k) (cs k))))) ;
   xy (i j : Fin n) : Id B.Carrier (B.mulQ (x i) (y j)) (B.mulQ F (e i j)) =
    trans (B.ring.mulC (x i) (y j))
     (trans (sym (S.sum-scale (y j) n (\ k -> B.mulQ (e i k) (cs k))))
      (trans (S.sum-cong n _ _ (term i j))
       (trans (S.sum-scale (e i j) n (\ k -> B.mulQ (y k) (cs k)))
        (trans (ap (B.mulQ (e i j)) generated) (B.ring.mulC (e i j) F))))) ;
   rho (p : B.Carrier) : B.Carrier = S.sum n (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) p))) ;
   rho-in (p : B.Carrier) : InL (rho p) =
    LI.finite-sum n (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) p)))
     (\ i -> LI.equal _ _ (B.ring.mulC (D.quotient (B.mulQ (x i) p)) (y i))
      (in-mul (D.quotient (B.mulQ (x i) p)) (y i) (G.G.generator i))) ;
   rho-add (p q : B.Carrier) : Id B.Carrier (rho (B.addQ p q)) (B.addQ (rho p) (rho q)) =
    trans (S.sum-cong n (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) (B.addQ p q))))
      (\ i -> B.addQ (B.mulQ (y i) (D.quotient (B.mulQ (x i) p)))
       (B.mulQ (y i) (D.quotient (B.mulQ (x i) q))))
      (\ i -> trans (ap (\ w -> B.mulQ (y i) (D.quotient w)) (B.ring.dist (x i) p q))
       (trans (ap (B.mulQ (y i)) (D.quotient-add (B.mulQ (x i) p) (B.mulQ (x i) q)))
        (B.ring.dist (y i) (D.quotient (B.mulQ (x i) p)) (D.quotient (B.mulQ (x i) q))))))
     (S.sum-add n (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) p)))
      (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) q)))) ;
   rho-scale (a : A.R) (p : B.Carrier) :
    Id B.Carrier (rho (B.mulQ (cst a) p)) (B.mulQ (cst a) (rho p)) =
    trans (S.sum-cong n (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) (B.mulQ (cst a) p))))
      (\ i -> B.mulQ (cst a) (B.mulQ (y i) (D.quotient (B.mulQ (x i) p))))
      (\ i -> trans (ap (\ w -> B.mulQ (y i) (D.quotient w)) (BR.mul-swap (x i) (cst a) p))
       (trans (ap (B.mulQ (y i)) (D.quotient-scale a (B.mulQ (x i) p)))
        (BR.mul-swap (y i) (cst a) (D.quotient (B.mulQ (x i) p))))))
     (S.sum-scale (cst a) n (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) p)))) ;
   quotient-zero : Id B.Carrier (D.quotient B.zeroQ) B.zeroQ =
    trans (ap D.quotient (sym (BR.mul-zero F))) (D.quotient-multiple B.zeroQ) ;
   rho-zero : Id B.Carrier (rho B.zeroQ) B.zeroQ =
    trans (S.sum-cong n (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) B.zeroQ))) (\ i -> B.zeroQ)
      (\ i -> trans (ap (\ w -> B.mulQ (y i) (D.quotient w)) (BR.mul-zero (x i)))
       (trans (ap (B.mulQ (y i)) quotient-zero) (BR.mul-zero (y i)))))
     (S.sum-zero n) ;
   remainder-zero : Id B.Carrier (D.remainder B.zeroQ) B.zeroQ =
    D.remainder-small B.zeroQ (Red.bounded-zero d) ;
   module RhoLinear = Linear[rho,rho-add,rho-scale,rho-zero] ;
   module RemLinear = Linear[D.remainder,D.remainder-add,D.remainder-scale,remainder-zero] ;
   -- rho is the identity on L.
   Fixed (p : B.Carrier) : U l = Id B.Carrier (rho p) p ;
   module Fix (p : B.Carrier) (b : Fin n -> B.Carrier) (hp : Id B.Carrier p (S.lin n y b)) {
    xp (i : Fin n) : Id B.Carrier (B.mulQ (x i) p) (B.mulQ F (S.sum n (\ j -> B.mulQ (e i j) (b j)))) =
     trans (ap (B.mulQ (x i)) hp)
      (trans (sym (S.sum-scale (x i) n (\ j -> B.mulQ (y j) (b j))))
       (trans (S.sum-cong n _ (\ j -> B.mulQ F (B.mulQ (e i j) (b j)))
         (\ j -> trans (B.ring.mulA (x i) (y j) (b j))
          (trans (ap (\ w -> B.mulQ w (b j)) (xy i j)) (sym (B.ring.mulA F (e i j) (b j))))))
        (S.sum-scale F n (\ j -> B.mulQ (e i j) (b j))))) ;
    q (i : Fin n) : Id B.Carrier (D.quotient (B.mulQ (x i) p)) (S.sum n (\ j -> B.mulQ (e i j) (b j))) =
     trans (ap D.quotient (xp i)) (D.quotient-multiple (S.sum n (\ j -> B.mulQ (e i j) (b j)))) ;
    -- y_i (e_ij b_j) = e_ii (y_j b_j).
    swap-term (i j : Fin n) :
     Id B.Carrier (B.mulQ (y i) (B.mulQ (e i j) (b j))) (B.mulQ (e i i) (B.mulQ (y j) (b j))) =
     trans (BR.mul-swap (y i) (e i j) (b j))
      (trans (B.ring.mulA (e i j) (y i) (b j))
       (trans (ap (\ w -> B.mulQ w (b j)) (exchange i i j)) (sym (B.ring.mulA (e i i) (y j) (b j))))) ;
    fixed : Fixed p =
     trans (S.sum-cong n (\ i -> B.mulQ (y i) (D.quotient (B.mulQ (x i) p)))
       (\ i -> S.sum n (\ j -> B.mulQ (y i) (B.mulQ (e i j) (b j))))
       (\ i -> trans (ap (B.mulQ (y i)) (q i)) (sym (S.sum-scale (y i) n (\ j -> B.mulQ (e i j) (b j))))))
      (trans (sum-swap n n (\ i j -> B.mulQ (y i) (B.mulQ (e i j) (b j))))
       (trans (S.sum-cong n (\ j -> S.sum n (\ i -> B.mulQ (y i) (B.mulQ (e i j) (b j))))
         (\ j -> B.mulQ (y j) (b j))
         (\ j -> trans (S.sum-cong n _ _ (\ i -> swap-term i j))
          (trans (S.sum-cong n (\ i -> B.mulQ (e i i) (B.mulQ (y j) (b j)))
            (\ i -> B.mulQ (B.mulQ (y j) (b j)) (e i i))
            (\ i -> B.ring.mulC (e i i) (B.mulQ (y j) (b j))))
           (trans (S.sum-scale (B.mulQ (y j) (b j)) n (\ i -> e i i))
            (trans (ap (B.mulQ (B.mulQ (y j) (b j))) trace) (B.ring.mulO (B.mulQ (y j) (b j))))))))
        (sym hp))) ;
   } ;
   rho-fixes (p : B.Carrier) (h : InL p) : Fixed p =
    Tr.Trunc[Cert.Certificate p B.zeroQ].induction @l (\ t -> Fixed p) (\ t -> B.set _ _)
     (\ w -> Fix[p,w.1,trans w.2 (BR.zl (S.lin n y w.1))].fixed) h ;
   -- M: the bounded elements of L.
   InM (w : B.Carrier) : U l = InL w * Red.Bounded d w ;
   remainder-in (p : B.Carrier) (h : InL p) : InM (D.remainder p) =
    (LI.equal _ _ (sym (solve p (B.mulQ F (D.quotient p)) (D.remainder p) (D.equation p)))
      (in-add p (B.negQ (B.mulQ F (D.quotient p))) h
       (in-neg (B.mulQ F (D.quotient p)) (LI.equal _ _ (B.ring.mulC (D.quotient p) F)
        (in-mul (D.quotient p) F F-in)))),
     D.bounded p) ;
   u (t : Fin d) : B.Carrier = D.remainder (rho (E.basis d t)) ;
   u-in (t : Fin d) : InM (u t) = remainder-in (rho (E.basis d t)) (rho-in (E.basis d t)) ;
   -- Every element of M is the combination of the u_t by its coordinates.
   span (w : B.Carrier) (hw : InM w) :
    Id B.Carrier w (S.sum d (\ t -> B.mulQ (cst (coordinate d w t)) (u t))) =
    trans (sym (D.remainder-small w hw.2))
     (trans (ap D.remainder (sym (rho-fixes w hw.1)))
      (trans (ap (\ v -> D.remainder (rho v)) (expand d w hw.2))
       (trans (ap D.remainder (RhoLinear.combination d (coordinate d w) (E.basis d)))
        (RemLinear.combination d (coordinate d w) (\ t -> rho (E.basis d t)))))) ;
   in-M-sum (a : Fin d -> A.R) :
    InM (S.sum d (\ t -> B.mulQ (cst (a t)) (u t))) =
    (LI.finite-sum d (\ t -> B.mulQ (cst (a t)) (u t)) (\ t -> in-mul (cst (a t)) (u t) (u-in t).1),
     bounded-sum d d (\ t -> B.mulQ (cst (a t)) (u t)) (\ t -> Red.bounded-scale d (a t) (u t) (u-in t).2)) ;
   -- If an element of A kills M and is a unit, M = 0 and F generates L.
   module Generates (m : A.R) (unit : AR.unit m)
    (kills : (w : B.Carrier) -> InM w -> Id B.Carrier (B.mulQ (cst m) w) B.zeroQ) {
    zero (w : B.Carrier) (hw : InM w) : Id B.Carrier w B.zeroQ =
     trans (sym (BR.one-left w))
      (trans (ap (\ c -> B.mulQ c w) (trans (sym (ap cst unit.2)) (trans (B.constant-mul m unit.1) (B.ring.mulC (cst m) (cst unit.1)))))
       (trans (sym (B.ring.mulA (cst unit.1) (cst m) w))
        (trans (ap (B.mulQ (cst unit.1)) (kills w hw)) (BR.mul-zero (cst unit.1))))) ;
    divides (i : Fin n) : Id B.Carrier (y i) (B.mulQ F (D.quotient (y i))) =
     trans (D.equation (y i))
      (trans (ap (B.addQ (B.mulQ F (D.quotient (y i)))) (zero (D.remainder (y i)) (remainder-in (y i) (G.G.generator i))))
       (B.ring.addZ (B.mulQ F (D.quotient (y i))))) ;
    principal : Principal = (F,\ i -> D.quotient (y i),cs,divides,generated) ;
    monic-principal : MonicPrincipal = (lower,principal,refl F) ;
   } ;
   -- Combinations of the u_t are killed by anything killing every u_t.
   kills (m : A.R) (h : (t : Fin d) -> Id B.Carrier (B.mulQ (cst m) (u t)) B.zeroQ)
    (w : B.Carrier) (hw : InM w) : Id B.Carrier (B.mulQ (cst m) w) B.zeroQ =
    trans (ap (B.mulQ (cst m)) (span w hw))
     (trans (sym (S.sum-scale (cst m) d (\ t -> B.mulQ (cst (coordinate d w t)) (u t))))
      (trans (S.sum-cong d _ (\ t -> B.zeroQ)
        (\ t -> trans (BR.mul-swap (cst m) (cst (coordinate d w t)) (u t))
         (trans (ap (B.mulQ (cst (coordinate d w t))) (h t)) (BR.mul-zero (cst (coordinate d w t))))))
       (S.sum-zero d))) ;
  } ;
  -- Degree zero: M = 0 outright.
  module Bottom (cs : Fin n -> B.Carrier) (generated : Id B.Carrier (S.lin n y cs) (H.monic nil)) {
   module St = Step[nil,cs,generated] ;
   module Gen = St.Generates[A.o,(A.o,A.mulO A.o),
    \ w hw -> trans (BR.one-left w) (St.span w hw)] ;
   principal : MonicPrincipal = Gen.monic-principal ;
  } ;
  -- Positive degree d = suc d'.
  module Positive (a0 : A.R) (rest : List A.R) (cs : Fin n -> B.Carrier)
   (generated : Id B.Carrier (S.lin n y cs) (H.monic (cons a0 rest))) {
   module St = Step[cons a0 rest,cs,generated] ;
   d' : Nat = len rest ;
   d : Nat = St.d ;
   top (t : Fin d) : A.R = Red.coef (St.u t) d' ;
   module JG = IA.Gen[d,top] ;
   J : IA.Ideal = JG.ideal ;
   module JI = IA.In[J] ;
   top-in (w : B.Carrier) (hw : St.InM w) : J.1 (Red.coef w d') =
    JG.G.equal (A.add A.z (SA.lin d top (coordinate d w))) (Red.coef w d')
     (sym (trans (ap (\ v -> Red.coef v d') (St.span w hw))
      (trans (coef-sum d (\ t -> B.mulQ (cst (coordinate d w t)) (St.u t)) d')
       (trans (SA.sum-cong d _ (\ t -> A.mul (top t) (coordinate d w t))
         (\ t -> trans (Red.coef-scale (coordinate d w t) (St.u t) d') (A.mulC (coordinate d w t) (top t))))
        (sym (AR.zl (SA.lin d top (coordinate d w))))))))
     (Tr.Trunc[JG.G.Witness (A.add A.z (SA.lin d top (coordinate d w)))].inc
      (coordinate d w,refl (A.add A.z (SA.lin d top (coordinate d w))))) ;
   -- Multiplication by X, reduced: X w = F c + (X w - c F), c the top coefficient.
   module Shift (w : B.Carrier) (hw : St.InM w) {
    c : A.R = Red.coef w d' ;
    b : B.Carrier = B.addQ (B.mulQ B.variable w) (B.negQ (B.mulQ (cst c) St.F)) ;
    coef-b (k : Nat) : Id A.R (Red.coef b k)
     (A.add (Red.shifted w k) (A.neg (A.mul c (Red.coef St.F k)))) =
     trans (Red.coef-add (B.mulQ B.variable w) (B.negQ (B.mulQ (cst c) St.F)) k)
      (cong2 A.R A.add _ _ _ _ (Red.coef-variable w k)
       (trans (Red.coef-neg (B.mulQ (cst c) St.F) k) (ap A.neg (Red.coef-scale c St.F k)))) ;
    bounded : Red.Bounded d b = split {
     zero -> trans (coef-b (suc (plus d' zero)))
      (trans (cong2 A.R A.add _ _ _ _ (ap (Red.coef w) (plus-zero d'))
        (ap (\ v -> A.neg (A.mul c v)) (trans (ap (\ jj -> Red.coef St.F (suc jj)) (plus-zero d')) St.D.leading)))
       (trans (ap (\ v -> A.add c (A.neg v)) (A.mulO c)) (A.addN c))) ;
     suc k -> trans (coef-b (suc (plus d' (suc k))))
      (trans (cong2 A.R A.add _ _ _ _ (trans (ap (Red.coef w) (plus-suc d' k)) (hw.2 k))
        (ap (\ v -> A.neg (A.mul c v)) (trans (ap (\ jj -> Red.coef St.F (suc jj)) (plus-suc d' k)) (St.D.above k))))
       (trans (ap (\ v -> A.add A.z (A.neg v)) (AR.mul-zero c))
        (trans (ap (A.add A.z) AR.neg-zero) (A.addZ A.z)))) } ;
    decomposition : Id B.Carrier (B.mulQ B.variable w) (B.addQ (B.mulQ St.F (cst c)) b) =
     reassemble (B.mulQ B.variable w) (B.mulQ St.F (cst c)) (B.mulQ (cst c) St.F)
      (B.ring.mulC St.F (cst c)) ;
    reduced : Id B.Carrier (St.D.remainder (B.mulQ B.variable w)) b =
     St.D.Characterise[B.mulQ B.variable w,cst c,b,bounded,decomposition].remainder-is ;
    next : B.Carrier = St.D.remainder (B.mulQ B.variable w) ;
    next-in : St.InM next = St.remainder-in (B.mulQ B.variable w) (in-mul B.variable w hw.1) ;
    -- coef w t = coef next (t+1) + c F_(t+1).
    relation (t : Nat) : Id A.R (Red.coef w t)
     (A.add (Red.coef next (suc t)) (A.mul c (Red.coef St.F (suc t)))) =
     sym (trans (ap (\ v -> A.add v (A.mul c (Red.coef St.F (suc t))))
       (trans (ap (\ v -> Red.coef v (suc t)) reduced) (coef-b (suc t))))
      (trans (sym (A.addA (Red.coef w t) (A.neg (A.mul c (Red.coef St.F (suc t)))) (A.mul c (Red.coef St.F (suc t)))))
       (trans (ap (A.add (Red.coef w t)) (AR.neg-cancel (A.mul c (Red.coef St.F (suc t))))) (A.addZ (Red.coef w t))))) ;
   } ;
   Down (k : Nat) : U l = (w : B.Carrier) -> St.InM w -> (t : Nat) -> Id Nat (plus t k) d' -> J.1 (Red.coef w t) ;
   down : (k : Nat) -> Down k = split {
    zero -> \ w hw t e -> JI.equal _ _ (ap (Red.coef w) (sym (trans (sym (plus-zero t)) e))) (top-in w hw) ;
    suc k | ih -> \ w hw t e ->
     JI.equal _ _ (sym (Shift[w,hw].relation t))
      (J.2.2.2.1 _ _ (ih Shift[w,hw].next Shift[w,hw].next-in (suc t) (trans (sym (plus-suc t k)) e))
       (JI.equal _ _ (A.mulC (Red.coef St.F (suc t)) (Red.coef w d'))
        (J.2.2.2.2 (Red.coef St.F (suc t)) (Red.coef w d') (top-in w hw)))) } ;
   coordinate-in (w : B.Carrier) (hw : St.InM w) (i : Fin d) : J.1 (coordinate d w i) =
    down (complement d' i).1 w hw (index d i) (complement d' i).2 ;
   -- Nakayama on the u_t.
   module K = Nak.At[J,Lin.structure] ;
   killer : K.Killer d St.u =
    K.kill d St.u (\ s t -> coordinate d (St.u s) t)
     (\ s t -> coordinate-in (St.u s) (St.u-in s) t)
     (\ s -> trans (St.span (St.u s) (St.u-in s))
      (sym (Lin.lin-equation d (\ t -> coordinate d (St.u s) t) St.u))) ;
   m : A.R = killer.1 ;
   j : A.R = A.add m (A.neg A.o) ;
   split-one : Id A.R (A.add m (A.neg j)) A.o =
    trans (ap (A.add m) (AR.negsub m A.o))
     (trans (A.addA m (A.neg m) A.o) (trans (ap (\ v -> A.add v A.o) (A.addN m)) (AR.zl A.o))) ;
   kills-M : (w : B.Carrier) -> St.InM w -> Id B.Carrier (B.mulQ (cst m) w) B.zeroQ =
    St.kills m killer.2.2 ;
   Outcome : U l = Plus MonicPrincipal (Lower d') ;
   -- A unit top coefficient in M gives a monic of degree d' in L.
   module Drop (gamma : Fin d -> A.R) (jg : Id A.R j (A.add A.z (SA.lin d top gamma)))
    (ju : AR.unit j) {
    W : B.Carrier = S.sum d (\ t -> B.mulQ (cst (gamma t)) (St.u t)) ;
    W-in : St.InM W = St.in-M-sum gamma ;
    W-top : Id A.R (Red.coef W d') j =
     trans (coef-sum d (\ t -> B.mulQ (cst (gamma t)) (St.u t)) d')
      (trans (SA.sum-cong d _ (\ t -> A.mul (top t) (gamma t))
        (\ t -> trans (Red.coef-scale (gamma t) (St.u t) d') (A.mulC (gamma t) (top t))))
       (trans (sym (AR.zl (SA.lin d top gamma))) (sym jg))) ;
    V : B.Carrier = B.mulQ (cst ju.1) W ;
    V-in : InL V = in-mul (cst ju.1) W W-in.1 ;
    V-bounded : Red.Bounded d V = Red.bounded-scale d ju.1 W W-in.2 ;
    V-top : Id A.R (Red.coef V d') A.o =
     trans (Red.coef-scale ju.1 W d') (trans (ap (A.mul ju.1) W-top) (trans (A.mulC ju.1 j) ju.2)) ;
    module Raw (p : P.P) (rep : Id B.Carrier (B.include p) V) {
     bound : Bounds.Bound (suc d') p =
      \ k -> trans (sym (Red.coef-include p (plus d k))) (trans (ap (\ v -> Red.coef v (plus d k)) rep) (V-bounded k)) ;
     leading : Id A.R (P.coef p d') A.o =
      trans (sym (Red.coef-include p d')) (trans (ap (\ v -> Red.coef v d') rep) V-top) ;
     lowered : List A.R = Bounds.cut d' p ;
     monic : Id B.Carrier V (H.monic lowered) = trans (sym rep) (Normal.equation d' p bound leading) ;
     result : Tr.Trunc[Outcome].carrier =
      Tr.Trunc[Cert.Certificate V B.zeroQ].induction @l (\ t -> Tr.Trunc[Outcome].carrier)
       (\ t -> Tr.Trunc[Outcome].proposition)
       (\ w -> Tr.Trunc[Outcome].inc (inr (lowered,Bounds.cut-length d' p,w.1,
         trans (sym (BR.zl (S.lin n y w.1))) (trans (sym w.2) monic))))
       V-in ;
    } ;
    result : Tr.Trunc[Outcome].carrier =
     Tr.Trunc[(p : P.P) * Id B.Carrier (B.include p) V].induction @l (\ t -> Tr.Trunc[Outcome].carrier)
      (\ t -> Tr.Trunc[Outcome].proposition) (\ r -> Raw[r.1,r.2].result) (raw-representative V) ;
   } ;
   neg-unit (v : A.R) (h : AR.unit (A.neg v)) : AR.unit v =
    (A.neg h.1,trans (AR.mul-neg v h.1) (trans (sym (AR.neg-mul-left v h.1)) h.2)) ;
   decide : Plus (AR.unit m) (AR.unit (A.neg j)) -> Tr.Trunc[Outcome].carrier = split {
    inl um -> Tr.Trunc[Outcome].inc (inl St.Generates[m,um,kills-M].monic-principal) ;
    inr uj -> Tr.Trunc[JG.G.Witness j].induction @l (\ t -> Tr.Trunc[Outcome].carrier)
      (\ t -> Tr.Trunc[Outcome].proposition)
      (\ g -> Drop[g.1,g.2,neg-unit j uj].result) killer.2.1 } ;
   outcome : Tr.Trunc[Outcome].carrier =
    Tr.Trunc[Plus (AR.unit m) (AR.unit (A.neg j))].induction @l (\ t -> Tr.Trunc[Outcome].carrier)
     (\ t -> Tr.Trunc[Outcome].proposition) decide
     (loc m (A.neg j) (Pr.subst A.R AR.unit A.o (A.add m (A.neg j)) (sym split-one) (A.o,A.mulO A.o))) ;
  } ;
 } ;
} ;
