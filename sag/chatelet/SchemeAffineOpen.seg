-- The affine case of SAG 5.4.2: an open subtype is a scheme.
-- 4.2.7 supplies finitely many principal opens, each represented by a localization.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Hi = Prelude[l+] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module FA = FunctionAlgebra[l].Over[R,setR] ;
 module SA = SmallAffine[l].Over[R,setR] ;
 module S = Schemes[l].Over[R,setR] ;
 module ST = SchemeSubtype[l].Over[R,setR] ;
 module OP = OpenProp[l].Over[R,setR] ;
 module OT = OpenTransitivity[l].Over[R,setR] ;
 module OA = OpenAffine[l].Over[R,setR,axioms] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module RR = AffineRing[l].Laws[R,setR] ;
 unit-open (r : R.R) : OP.Open (RL[R].unit r) =
  Tr.Trunc[OP.Witness (RL[R].unit r)].inc
   (OP.from-iff (RL[R].unit r) (RR.unit-prop r) (suc zero) (\ i -> r)
    (\ u -> Tr.Trunc[(i : Fin (suc zero)) * RL[R].unit r].inc (inr tt,u))
    (Tr.Trunc[(i : Fin (suc zero)) * RL[R].unit r].induction @l
     (\ t -> RL[R].unit r) (\ t -> RR.unit-prop r) (\ w -> w.2))) ;
 principal-affine (A : C.Algebra) (fp : P.FP A) (f : A.ring.R) : FA.Affine (I.D A f) =
  Tr1.Trunc[I.LocalizationWitness A f].induction @(l+) (\ t -> FA.Affine (I.D A f))
   (\ t -> Tr1.Trunc[FA.AffineWitness (I.D A f)].proposition)
   (\ loc -> Tr1.Trunc[FA.AffineWitness (I.D A f)].inc
    (loc.1,loc.2.1,Functions[l].inverse _ _ (I.spectrum A f loc))) (I.localize A fp f) ;
 module At (A : C.Algebra) (fp : P.FP A) (sub : C.Spec A -> U l)
  (op : OP.OpenSubtype (C.Spec A) sub) {
  Y : U l = (x : C.Spec A) * sub x ;
  prop (x : C.Spec A) : Pr.isProp (sub x) = OP.open-prop _ (op x) ;
  module With (w : OT.OpenWitness A sub) {
   n : Nat = w.1 ; fs : Fin n -> A.ring.R = w.2.1 ;
   us (i : Fin n) (y : Y) : U l = RL[R].unit (y.1.1.1 (fs i)) ;
   opens (i : Fin n) (y : Y) : OP.Open (us i y) = unit-open (y.1.1.1 (fs i)) ;
   module Part (i : Fin n) {
    T : U l = (y : Y) * us i y ;
    to (t : T) : I.D A (fs i) = (t.1.1,t.2) ;
    from (d : I.D A (fs i)) : T =
     ((d.1,(w.2.2 d.1).2
      (Tr.Trunc[(j : Fin n) * RL[R].unit (d.1.1.1 (fs j))].inc (i,d.2))),d.2) ;
    fb (d : I.D A (fs i)) : Id (I.D A (fs i)) (to (from d)) d = refl d ;
    bf (t : T) : Id T (from (to t)) t =
     Pr.Sigma-eq Y (us i) _ _ _ _
      (Pr.Sigma-eq (C.Spec A) sub _ _ _ _ (refl t.1.1) (prop t.1.1))
      (RR.unit-prop (t.1.1.1.1 (fs i))) ;
    equivalence : Pr.Equiv T (I.D A (fs i)) = (to,Pr.qinv _ _ to from fb bf) ;
    affine : FA.Affine T = SA.to-affine T
     (SA.along T (I.D A (fs i)) equivalence (SA.from-affine _ (principal-affine A fp (fs i)))) ;
   } ;
   covers (y : Y) : ST.Has Y n us y = (w.2.2 y.1).1 y.2 ;
   witness : ST.Witness[Y] = new ST.Witness[Y,n,us,opens,\ i -> Part[i].affine,covers] ;
   scheme : S.Scheme Y = ST.From[Y,witness].scheme ;
  } ;
  theorem : S.Scheme Y =
   Tr.Trunc[OT.OpenWitness A sub].induction @l (\ t -> S.Scheme Y) (\ t -> S.proposition Y)
    (\ w -> With[w].scheme) (OA.At[A,fp,sub,op].theorem) ;
 } ;
 Property (X : U l) : U l+ =
  (sub : X -> U l) -> OP.OpenSubtype X sub -> S.Scheme ((x : X) * sub x) ;
 from-witness (X : U l) (w : FA.AffineWitness X) : Property X =
  Hi.subst (U l) Property (C.Spec w.1) X
   (Hi.sym (U l) X (C.Spec w.1) (Axioms[l].UnivalenceLemmas[univ @l].ua X (C.Spec w.1) w.2.2))
   (\ sub op -> At[w.1,w.2.1,sub,op].theorem) ;
 theorem (X : U l) (aff : FA.Affine X) : Property X =
  from-witness X (AffineUniqueness[l].Over[R,setR,axioms.sqc].At[X].representation aff) ;
} ;
