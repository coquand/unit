-- Theorem 3.4.2 for the etale topology (sevb, Section 1): T is generated
-- by ||roots of f||, f monic of positive degree (EtaleTopology); R is a
-- T-sheaf (EtaleRing, Lemma 1.1.3); Aut(P^n) = PGL uses the classification
-- of line bundles (Theorem 7.3 for n >= 2, Theorem73One for n = 1).  The
-- remaining hypotheses are the sheafified truncation with lexness (sh)
-- and descent of finite free right ideals (descends).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : [j] SheafClosure[l,j].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops)
 (descends : (n0 : Nat)
   (A : AzumayaProbe[l].Over[R,setR,suc n0,EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G,sh].Alg) ->
   SheafTopology[l].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].isModal @l A.A ->
   (S : AzumayaProbe[l].Over[R,setR,suc n0,EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G,sh].Sub A) ->
   (sh @l).close (AzumayaProbe[l].Over[R,setR,suc n0,EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G,sh].Basis A S) ->
   Tr.Trunc[AzumayaProbe[l].Over[R,setR,suc n0,EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G,sh].Basis A S].carrier) {
 module ET = EtaleTopology[l].Over[R,setR] ;
 module ER = EtaleRing[l].Over[R,setR,sag] ;
 cls : (n0 : Nat) -> Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem = split {
  zero -> Theorem73One[l].Over[R,setR,sag].theorem ;
  suc m -> Theorem73[l].Over[R,setR,m,sag].theorem-7-3 } ;
 module At (n0 : Nat) {
  module TH = Theorem342[l].Over[R,setR,n0,sag,cls n0,ET.I,ET.G,sh,ER.R-local,descends n0] ;
  chatelet (X : TH.SB) (x : Truncation[l+].Trunc[X.1].carrier) : TH.Goal X = TH.theorem-3-4-2 X x ;
 } ;
} ;
