-- The higher-type step of Proposition 4.6, with an explicit inverse.
-- Inputs still to be obtained from chart triviality and worker B:
--   mere classification by the O(d), and separation of their degrees.
-- These module parameters are visible; this is not yet the integrated theorem.
level l ; open Prelude[l] ; open Paths[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ; module Tr = Truncation[l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R)
 (intersection : PicardInterface[l].Over[R,setR].ChartIntersection) {
 module P = Projective[l].Line[R,setR] ;
 module L = PicardLines[l].Over[R,setR] ;
 module W = PicardTwists[l].Over[R,setR] ;
 module BP = PicardBundlePaths[l].Over[R,setR,intersection] ;
 module D = PicardDegree[l] ;
 Degree : U l = PicardInterface[l].Degree ;
 Bundle : U l = P.P1 -> L.Line ;
 origin : P.P1 = P.affine R.z ;
 Witness (B : Bundle) : U l = (d : Degree) * Tr.Trunc[Id Bundle B (W.O d)].carrier ;
 MereClassification : U l = (B : Bundle) -> Tr.Trunc[(d : Degree) * Id Bundle B (W.O d)].carrier ;
 Separation : U l = (d e : Degree) -> Id Bundle (W.O d) (W.O e) -> Id Degree d e ;
 module Proof (exists : MereClassification) (separate : Separation) {
  equal-degrees (B : Bundle) (d e : Degree)
   (u : Tr.Trunc[Id Bundle B (W.O d)].carrier) (v : Tr.Trunc[Id Bundle B (W.O e)].carrier) : Id Degree d e =
   Tr.Trunc[Id Bundle B (W.O d)].induction @l (\ t -> Id Degree d e) (\ t -> D.degree-set d e)
    (\ p -> Tr.Trunc[Id Bundle B (W.O e)].induction @l (\ t -> Id Degree d e) (\ t -> D.degree-set d e)
     (\ q -> separate d e (transH (symH p) q)) v) u ;
  witness-prop (B : Bundle) : isProp (Witness B) = \ u v ->
   Sigma-eq Degree (\ d -> Tr.Trunc[Id Bundle B (W.O d)].carrier) u.1 v.1 u.2 v.2
    (equal-degrees B u.1 v.1 u.2 v.2) Tr.Trunc[Id Bundle B (W.O v.1)].proposition ;
  chosen (B : Bundle) : Witness B =
   Tr.Trunc[(d : Degree) * Id Bundle B (W.O d)].induction @l
    (\ t -> Witness B) (\ t -> witness-prop B)
    (\ w -> (w.1,Tr.Trunc[Id Bundle B (W.O w.1)].inc w.2)) (exists B) ;
  degree (B : Bundle) : Degree = (chosen B).1 ;
  shape (a : L.Line) (d : Degree) : Tr.Trunc[Id Bundle (W.classify a d) (W.O d)].carrier =
   Tr.Trunc[Id L.Line a L.trivial].induction @l
    (\ t -> Tr.Trunc[Id Bundle (W.classify a d) (W.O d)].carrier)
    (\ t -> Tr.Trunc[Id Bundle (W.classify a d) (W.O d)].proposition)
    (\ p -> Tr.Trunc[Id Bundle (W.classify a d) (W.O d)].inc
     (transH (ap L.Line Bundle (\ b -> W.classify b d) a L.trivial p)
      (FL.funext P.P1 (\ x -> L.Line) (W.classify L.trivial d) (W.O d) (\ x -> L.tensor-left (W.O d x)))))
    (L.K.k-conn a L.trivial) ;
  degree-classify (a : L.Line) (d : Degree) : Id Degree (degree (W.classify a d)) d =
   equal-degrees (W.classify a d) (degree (W.classify a d)) d (chosen (W.classify a d)).2 (shape a d) ;
  at-origin (a : L.Line) (d : Degree) : Id L.Line (W.classify a d origin) a =
   L.tensor-pointed a (W.O d origin) (W.lo-trivial d R.z) ;
  inverse (B : Bundle) : L.Line * Degree = (B origin,degree B) ;
  -- Existence supplies a mere comparison; evaluation makes it unique
  -- after prescribing the identification at the base point.
  comparison (B : Bundle) : Tr.Trunc[Id Bundle (W.classify (B origin) (degree B)) B].carrier =
   Tr.Trunc[Id Bundle (W.classify (B origin) (degree B)) (W.O (degree B))].induction @l
    (\ t -> Tr.Trunc[Id Bundle (W.classify (B origin) (degree B)) B].carrier)
    (\ t -> Tr.Trunc[Id Bundle (W.classify (B origin) (degree B)) B].proposition)
    (\ p -> Tr.Trunc[Id Bundle B (W.O (degree B))].induction @l
     (\ t -> Tr.Trunc[Id Bundle (W.classify (B origin) (degree B)) B].carrier)
     (\ t -> Tr.Trunc[Id Bundle (W.classify (B origin) (degree B)) B].proposition)
     (\ q -> Tr.Trunc[Id Bundle (W.classify (B origin) (degree B)) B].inc (transH p (symH q))) (chosen B).2)
    (shape (B origin) (degree B)) ;
  sec (B : Bundle) : Id Bundle (W.classify (inverse B).1 (inverse B).2) B =
   BP.At[W.classify (B origin) (degree B),B,comparison B].inverse (at-origin (B origin) (degree B)) ;
  ret (z : L.Line * Degree) : Id (L.Line * Degree) (inverse (W.classify z.1 z.2)) z =
   transH (ap L.Line (L.Line * Degree) (\ a -> (a,degree (W.classify z.1 z.2)))
    (W.classify z.1 z.2 origin) z.1 (at-origin z.1 z.2))
    (ap Degree (L.Line * Degree) (\ d -> (z.1,d)) (degree (W.classify z.1 z.2)) z.2 (degree-classify z.1 z.2)) ;
  proposition-4-6 : W.Proposition46 =
   qinv (L.Line * Degree) Bundle (\ z -> W.classify z.1 z.2) inverse sec ret ;
 } ;
} ;
