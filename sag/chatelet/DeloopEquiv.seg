-- Coherence lemmas for Deloop, at one level j.  Prelude.isEquiv is a sig;
-- these are the only places where its fields are used.
--   contr-equiv   contractible fibres give an equivalence
--   equiv-contr   an equivalence has contractible fibres (induction on
--                 equivalences, the fibres of the identity are singletons)
--   Lp, Kp, KL    conjugation by p : c = b and its inverse on loops
--   ap-of-omega   if q |-> p^-1 . (ap f q . p) is an equivalence, so is ap f
--   fib-prop      if every ap f is an equivalence, the fibres of f are
--                 propositions
level j ; open Base ; open Prelude[j] ;
module CT = FunExtUA[j] ;
fib (A B : U j) (f : A -> B) (b : B) : U j = (a : A) * Id B (f a) b ;

contr-equiv (A B : U j) (f : A -> B) (c : (b : B) -> CT.isContr (fib A B f b)) : isEquiv A B f =
 qinv A B f (\ b -> (c b).1.1) (\ b -> (c b).1.2)
  (\ a -> ap (fib A B f (f a)) A (\ w -> w.1) (c (f a)).1 (a,refl (f a)) ((c (f a)).2 (a,refl (f a)))) ;

equiv-contr (A B : U j) (f : A -> B) (e : isEquiv A B f) (b : B) : CT.isContr (fib A B f b) =
 AlgebraPointsIdentity[j].eqind A (\ B1 e1 -> (b1 : B1) -> CT.isContr (fib A B1 e1.1 b1))
  (\ b1 -> CT.sing A b1) B (f,e) b ;

-- loops at c and at b, for p : c = b
Lp (B : U j) (c b : B) (p : Id B c b) (w : Id B c c) : Id B b b = trans B b c b (sym B c b p) (trans B c c b w p) ;
Kp (B : U j) (c b : B) (p : Id B c b) (u : Id B b b) : Id B c c = trans B c b c p (trans B b b c u (sym B c b p)) ;
KL (B : U j) (c b : B) (p : Id B c b) (w : Id B c c) : Id (Id B c c) (Kp B c b p (Lp B c b p w)) w =
 idJ B c (\ b1 p1 -> (w1 : Id B c c) -> Id (Id B c c) (Kp B c b1 p1 (Lp B c b1 p1 w1)) w1)
  (\ w1 -> trans (Id B c c) (trans B c c c (refl c) (trans B c c c (refl c) w1)) (trans B c c c (refl c) w1) w1
    (trans-refl-l B c c (trans B c c c (refl c) w1)) (trans-refl-l B c c w1))
  b p w ;

ap-of-omega (A B : U j) (f : A -> B) (a0 : A) (b0 : B) (p : Id B (f a0) b0)
 (e : isEquiv (Id A a0 a0) (Id B b0 b0) (\ q -> Lp B (f a0) b0 p (ap A B f a0 a0 q))) :
 isEquiv (Id A a0 a0) (Id B (f a0) (f a0)) (ap A B f a0 a0) =
 qinv (Id A a0 a0) (Id B (f a0) (f a0)) (ap A B f a0 a0) (\ w -> e.sec (Lp B (f a0) b0 p w))
  (\ w -> trans (Id B (f a0) (f a0)) (ap A B f a0 a0 (e.sec (Lp B (f a0) b0 p w)))
    (Kp B (f a0) b0 p (Lp B (f a0) b0 p w)) w
    (trans (Id B (f a0) (f a0)) (ap A B f a0 a0 (e.sec (Lp B (f a0) b0 p w)))
      (Kp B (f a0) b0 p (Lp B (f a0) b0 p (ap A B f a0 a0 (e.sec (Lp B (f a0) b0 p w)))))
      (Kp B (f a0) b0 p (Lp B (f a0) b0 p w))
      (sym (Id B (f a0) (f a0)) (Kp B (f a0) b0 p (Lp B (f a0) b0 p (ap A B f a0 a0 (e.sec (Lp B (f a0) b0 p w)))))
        (ap A B f a0 a0 (e.sec (Lp B (f a0) b0 p w))) (KL B (f a0) b0 p (ap A B f a0 a0 (e.sec (Lp B (f a0) b0 p w)))))
      (ap (Id B b0 b0) (Id B (f a0) (f a0)) (Kp B (f a0) b0 p)
        (Lp B (f a0) b0 p (ap A B f a0 a0 (e.sec (Lp B (f a0) b0 p w)))) (Lp B (f a0) b0 p w)
        (e.sec-eq (Lp B (f a0) b0 p w))))
    (KL B (f a0) b0 p w))
  (\ q -> sec-ret (Id A a0 a0) (Id B b0 b0) (\ q1 -> Lp B (f a0) b0 p (ap A B f a0 a0 q1)) e q) ;

-- transport in the fibre family
subst-fib (A B : U j) (f : A -> B) (b : B) (a a1 : A) (q : Id A a a1) (u : Id B (f a) b) :
 Id (Id B (f a1) b) (subst A (\ z -> Id B (f z) b) a a1 q u) (trans B (f a1) (f a) b (sym B (f a) (f a1) (ap A B f a a1 q)) u) =
 idJ A a (\ z q1 -> Id (Id B (f z) b) (subst A (\ z1 -> Id B (f z1) b) a z q1 u)
   (trans B (f z) (f a) b (sym B (f a) (f z) (ap A B f a z q1)) u))
  (sym (Id B (f a) b) (trans B (f a) (f a) b (refl (f a)) u) u (trans-refl-l B (f a) b u)) a1 q ;
sym-sym (B : U j) (x y : B) (p : Id B x y) : Id (Id B x y) (sym B y x (sym B x y p)) p =
 idJ B x (\ y1 p1 -> Id (Id B x y1) (sym B y1 x (sym B x y1 p1)) p1) (refl (refl x)) y p ;
-- (u . u'^-1)^-1 . u = u'
cancel (B : U j) (x y b : B) (u : Id B y b) (u' : Id B x b) :
 Id (Id B x b) (trans B x y b (sym B y x (trans B y b x u (sym B x b u'))) u) u' =
 idJ B y (\ b1 u1 -> (u2 : Id B x b1) -> Id (Id B x b1) (trans B x y b1 (sym B y x (trans B y b1 x u1 (sym B x b1 u2))) u1) u2)
  (\ u2 -> trans (Id B x y) (sym B y x (trans B y y x (refl y) (sym B x y u2))) (sym B y x (sym B x y u2)) u2
    (ap (Id B y x) (Id B x y) (sym B y x) (trans B y y x (refl y) (sym B x y u2)) (sym B x y u2)
      (trans-refl-l B y x (sym B x y u2)))
    (sym-sym B x y u2))
  b u u' ;

fib-prop (A B : U j) (f : A -> B) (emb : (x y : A) -> isEquiv (Id A x y) (Id B (f x) (f y)) (ap A B f x y)) (b : B) :
 isProp (fib A B f b) = \ v v1 ->
 Sigma-path A (\ a -> Id B (f a) b) v.1 v1.1 v.2 v1.2
  ((emb v.1 v1.1).sec (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2)))
  (trans (Id B (f v1.1) b)
    (subst A (\ z -> Id B (f z) b) v.1 v1.1 ((emb v.1 v1.1).sec (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2))) v.2)
    (trans B (f v1.1) (f v.1) b (sym B (f v.1) (f v1.1) (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2))) v.2)
    v1.2
    (trans (Id B (f v1.1) b)
      (subst A (\ z -> Id B (f z) b) v.1 v1.1 ((emb v.1 v1.1).sec (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2))) v.2)
      (trans B (f v1.1) (f v.1) b (sym B (f v.1) (f v1.1)
        (ap A B f v.1 v1.1 ((emb v.1 v1.1).sec (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2))))) v.2)
      (trans B (f v1.1) (f v.1) b (sym B (f v.1) (f v1.1) (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2))) v.2)
      (subst-fib A B f b v.1 v1.1 ((emb v.1 v1.1).sec (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2))) v.2)
      (ap (Id B (f v.1) (f v1.1)) (Id B (f v1.1) b) (\ w -> trans B (f v1.1) (f v.1) b (sym B (f v.1) (f v1.1) w) v.2)
        (ap A B f v.1 v1.1 ((emb v.1 v1.1).sec (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2))))
        (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2))
        ((emb v.1 v1.1).sec-eq (trans B (f v.1) b (f v1.1) v.2 (sym B (f v1.1) b v1.2)))))
    (cancel B (f v1.1) (f v.1) b v.2 v1.2)) ;
