-- Chatelet for the etale topology from the SAG axioms and sh (H2, H3).
-- Finite-free descent and split-basis descent are theorems, not parameters.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (sag : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : [j] SheafClosure[l,j].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module ET = EtaleTopology[l].Over[R,setR] ; module ER = EtaleRing[l].Over[R,setR,sag] ;
 module DL = DescentLinear[l].Over[R,setR] ;
 module DI = DescentIdeal[l].Over[R,setR,sag,sh] ;
 cls : (n0 : Nat) -> Classification[l].Over[R,setR,n0,sag.sqc,sag.loc].Theorem = split {
  zero -> Theorem73One[l].Over[R,setR,sag].theorem ;
  suc m -> Theorem73[l].Over[R,setR,m,sag].theorem-7-3 } ;
 module At (n0 : Nat) {
  module AP = AzumayaProbe[l].Over[R,setR,suc n0,ET.I,ET.G,sh] ;
  module AZ = DescentAzumaya[l].Over[R,setR,sag,sh].Size[suc (suc n0)] ;
  descends (A : AP.Alg) (modal : ET.T.isModal @l A.A)
   (locally-matrix : (sh @(l+)).close (Id AP.Alg A AZ.MN.algebra))
   (S : AP.Sub A) (local : (sh @l).close (AP.Basis A S)) : Tr.Trunc[AP.Basis A S].carrier =
   DescentFree[l].Over[R,setR,sag,sh].Rank[suc n0].At[A,modal,S,local].descends-free
    (TC.map (DL.On[DI.underlying A].Frame AZ.rank) ((m : Nat) * DL.On[DI.underlying A].Frame m)
     (\ b -> (AZ.rank,b)) AZ.At[A,modal,locally-matrix].az-free) ;
  module TH = Theorem342[l].OverAzumaya[R,setR,n0,sag,cls n0,ET.I,ET.G,sh,ER.R-local,descends] ;
  az-free (A : TH.AZ) : Tr.Trunc[DL.On[DI.underlying A.1].Frame AZ.rank].carrier =
   AZ.At[A.1,A.2.1,A.2.2].az-free ;
  chatelet (X : TH.SB) (x : Truncation[l+].Trunc[X.1].carrier) : TH.Goal X = TH.theorem-3-4-2 X x ;
  opaque descends ; opaque az-free ; opaque chatelet ;
 } ;
} ;
