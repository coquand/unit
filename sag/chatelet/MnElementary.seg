-- The elementary matrices E_ij of M_N(R), (E_ij)_ab = delta_ia delta_jb,
-- with E_ij E_kl = delta_jk E_il and sum_i E_ii = 1, stated in the
-- operations of the NCAlgebra M_N(R).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Ps = Presentations[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (N : Nat) {
 module L = RL[R] ;
 module S = FiniteIdeal[l].Sums[R] ;
 module D = MnSums[l].Over[R] ;
 module MN = MnAlgebra[l].Over[R,setR,N] ;
 M : MN.NA.Algebra = MN.algebra ;
 I : U l = MN.I ;
 E (i j : I) : M.A = \ a b -> R.mul (D.delta N i a) (D.delta N j b) ;
 -- one summand of (E_ij E_kl)_ab, rearranged for sum-delta
 term (i j k h a b c : I) :
  Id R.R (R.mul (R.mul (D.delta N i a) (D.delta N j c)) (R.mul (D.delta N k c) (D.delta N h b)))
   (R.mul (D.delta N j c) (R.mul (D.delta N c k) (R.mul (D.delta N i a) (D.delta N h b)))) =
  calc R.R {
   R.mul (R.mul (D.delta N i a) (D.delta N j c)) (R.mul (D.delta N k c) (D.delta N h b))
    =< ap (\ x -> R.mul x (R.mul (D.delta N k c) (D.delta N h b))) (R.mulC (D.delta N i a) (D.delta N j c)) >
   R.mul (R.mul (D.delta N j c) (D.delta N i a)) (R.mul (D.delta N k c) (D.delta N h b))
    =< sym (R.mulA (D.delta N j c) (D.delta N i a) (R.mul (D.delta N k c) (D.delta N h b))) >
   R.mul (D.delta N j c) (R.mul (D.delta N i a) (R.mul (D.delta N k c) (D.delta N h b)))
    =< ap (R.mul (D.delta N j c)) (L.mul-swap (D.delta N i a) (D.delta N k c) (D.delta N h b)) >
   R.mul (D.delta N j c) (R.mul (D.delta N k c) (R.mul (D.delta N i a) (D.delta N h b)))
    =< ap (\ x -> R.mul (D.delta N j c) (R.mul x (R.mul (D.delta N i a) (D.delta N h b)))) (D.delta-sym N k c) >
   R.mul (D.delta N j c) (R.mul (D.delta N c k) (R.mul (D.delta N i a) (D.delta N h b))) } ;
 -- E_ij E_kh = delta_jk E_ih
 product (i j k h : I) : Id M.A (M.mul (E i j) (E k h)) (M.scale (D.delta N j k) (E i h)) =
  MN.mat-eq (M.mul (E i j) (E k h)) (M.scale (D.delta N j k) (E i h)) (\ a b ->
   trans (S.sum-cong N
     (\ c -> R.mul (R.mul (D.delta N i a) (D.delta N j c)) (R.mul (D.delta N k c) (D.delta N h b)))
     (\ c -> R.mul (D.delta N j c) (R.mul (D.delta N c k) (R.mul (D.delta N i a) (D.delta N h b))))
     (term i j k h a b))
    (D.sum-delta N j (\ c -> R.mul (D.delta N c k) (R.mul (D.delta N i a) (D.delta N h b))))) ;
 scale-zero (x : M.A) : Id M.A (M.scale R.z x) M.zero =
  MN.mat-eq (M.scale R.z x) M.zero (\ a b -> L.zero-mul (x a b)) ;
 -- the two cases of delta_jk
 product-same (i j h : I) : Id M.A (M.mul (E i j) (E j h)) (E i h) =
  trans (product i j j h)
   (trans (ap (\ x -> M.scale x (E i h)) (D.delta-diag N j)) (M.scale-one (E i h))) ;
 product-other (i j k h : I) (ne : Not (Id I j k)) : Id M.A (M.mul (E i j) (E k h)) M.zero =
  trans (product i j k h)
   (trans (ap (\ x -> M.scale x (E i h)) (D.delta-off N j k ne)) (scale-zero (E i h))) ;
 -- finite sums in M_N(R), computed entrywise
 sum : (n : Nat) -> (Ps.Fin n -> M.A) -> M.A = split {
  zero -> \ v -> M.zero ;
  suc n | r -> \ v -> M.add (v (inr tt)) (r (\ i -> v (inl i))) } ;
 sum-entry (a b : I) : (n : Nat) (v : Ps.Fin n -> M.A) ->
  Id R.R (sum n v a b) (S.sum n (\ i -> v i a b)) = split {
  zero -> \ v -> refl R.z ;
  suc n | r -> \ v -> ap (R.add (v (inr tt) a b)) (r (\ i -> v (inl i))) } ;
 -- sum_i E_ii = 1
 sum-diagonal : Id M.A (sum N (\ i -> E i i)) M.one =
  MN.mat-eq (sum N (\ i -> E i i)) M.one (\ a b ->
   trans (sum-entry a b N (\ i -> E i i))
    (trans (S.sum-cong N (\ i -> R.mul (D.delta N i a) (D.delta N i b))
      (\ i -> R.mul (D.delta N a i) (D.delta N i b))
      (\ i -> ap (\ x -> R.mul x (D.delta N i b)) (D.delta-sym N i a)))
     (D.sum-delta N a (\ i -> D.delta N i b)))) ;
} ;
