-- Theorem D on the underlying module of an Azumaya algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module P1 = Prelude[l+] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ; module FP = FiniteProduct[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : [j] SheafClosure[l,j].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module DI = DescentIdeal[l].Over[R,setR,axioms,sh] ; module ET = EtaleTopology[l].Over[R,setR] ;
 module DF = DescentFrames[l].Over[R,setR,axioms.loc] ; module NA = NCAlgebra[l].Over[R,setR] ;
 module Size (N : Nat) {
  module MN = MnAlgebra[l].Over[R,setR,N] ;
  rank : Nat = FP.size N N ;
  V : MD.Module = DL.Free rank ; M : MD.Module = DI.underlying MN.algebra ;
  map (v : V.M) (i j : Fin N) : R.R = v (FP.encode N N i j) ;
  back (x : M.M) (a : Fin rank) : R.R = x (FP.decode N N a).1 (FP.decode N N a).2 ;
  section (x : M.M) : Id M.M (map (back x)) x =
   MN.mat-eq (map (back x)) x (\ i j -> ap (\ p -> x p.1 p.2) (FP.decode-encode N N i j)) ;
  retraction (v : V.M) : Id V.M (back (map v)) v =
   F.funext (Fin rank) (\ a -> R.R) _ v (\ a -> ap v (DescentProducts[l].encode-decode N N a)) ;
  standard : DL.On[M].Frame rank =
   DF.Rank[rank].Map[M,map,\ u v -> refl (M.madd (map u) (map v)),\ a v -> refl (M.sm a (map v))]
    .from-equiv (Pr.qinv V.M M.M map back section retraction) ;
  module At (A : NA.Algebra) (modal : ET.T.isModal @l A.A)
   (local : (sh @(l+)).close (Id NA.Algebra A MN.algebra)) {
   Claim : U l = DL.On[DI.underlying A].Frame rank ;
   local-frame : (sh @l).close Claim =
    (sh @(l+)).elim @l (Id NA.Algebra A MN.algebra) ((sh @l).close Claim)
     ((sh @l).proposition Claim) ((sh @l).modal Claim)
     (\ p -> (sh @l).inc Claim
      (P1.subst NA.Algebra (\ B -> DL.On[DI.underlying B].Frame rank) MN.algebra A
       (P1.sym NA.Algebra A MN.algebra p) standard)) local ;
   az-free : Tr.Trunc[Claim].carrier =
    DescentTheoremD[l].Over[R,setR,axioms,sh].At[DI.underlying A,modal,rank,local-frame].theorem ;
   opaque az-free ;
  } ;
 } ;
} ;
