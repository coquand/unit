-- Linear automorphisms of R^{n+1} act on P^n.  An automorphism is a pair of
-- mutually inverse maps commuting with scalars.  Nonzero vectors go to
-- nonzero vectors because g 0 = 0 and, in SAG, nonzero is x /= 0
-- (SAG 2.2.3(b), Units23).  Permutations of coordinates are examples.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (sqc : Presentations[l].Over[R,setR].SQC) (loc : StandardOpens[l].Over[R,setR].Locality) {
 open R ; open RL[R] ;
 module Q2 = ProjectiveQuotient[l].Over[R,setR,n] ;
 module U23 = Units23[l].Over[R,setR,sqc,loc] ;
 I : U l = Q2.I ;
 V : U l = Q2.V ;
 zero-vector : V = \ i -> z ;
 Linear (g : V -> V) : U l = (a : R.R) (v : V) -> Id V (g (Q2.scale a v)) (Q2.scale a (g v)) ;
 Auto : U l = (g : V -> V) * (h : V -> V) * Linear g * Linear h *
  ((v : V) -> Id V (h (g v)) v) * ((w : V) -> Id V (g (h w)) w) ;
 inverse (A : Auto) : Auto = (A.2.1,A.1,A.2.2.2.1,A.2.2.1,A.2.2.2.2.2,A.2.2.2.2.1) ;
 compose (A B : Auto) : Auto =
  (\ v -> A.1 (B.1 v),\ w -> B.2.1 (A.2.1 w),
   \ a v -> trans (ap A.1 (B.2.2.1 a v)) (A.2.2.1 a (B.1 v)),
   \ a w -> trans (ap B.2.1 (A.2.2.2.1 a w)) (B.2.2.2.1 a (A.2.1 w)),
   \ v -> trans (ap B.2.1 (A.2.2.2.2.1 (B.1 v))) (B.2.2.2.2.1 v),
   \ w -> trans (ap A.1 (B.2.2.2.2.2 (A.2.1 w))) (A.2.2.2.2.2 w)) ;
 scaled-zero : Id V (Q2.scale z zero-vector) zero-vector = Q2.vector-eq _ _ (\ i -> zero-mul z) ;
 linear-zero (g : V -> V) (lin : Linear g) : Id V (g zero-vector) zero-vector =
  trans (ap g (sym scaled-zero)) (trans (lin z zero-vector) (Q2.vector-eq _ _ (\ i -> zero-mul (g zero-vector i)))) ;

 module Act (A : Auto) {
  g : V -> V = A.1 ;
  h : V -> V = A.2.1 ;
  nonzero (v : V) (nz : Q2.NonZero v) : Q2.NonZero (g v) =
   U23.nonzero-unit (suc n) (g v) (\ zs ->
    U23.unit-nonzero (suc n) v nz (\ i -> Pr.happly I (\ j -> R.R) v zero-vector
      (trans (sym (A.2.2.2.2.1 v)) (trans (ap h (Q2.vector-eq (g v) zero-vector zs)) (linear-zero h A.2.2.2.1))) i)) ;
  point (x : Q2.Point) : Q2.Point = (g x.1,nonzero x.1 x.2) ;
  respects (x y : Q2.Point) (r : Q2.Related x y) : Q2.Related (point x) (point y) =
   (r.1,trans (sym (A.2.2.1 r.1.1 x.1)) (ap g r.2)) ;
  module M = Q2.Q.Descend[Q2.Pn,Q2.Q.set,\ x -> Q2.class (point x),\ x y r -> Q2.Q.relates _ _ (respects x y r)] ;
  map (q : Q2.Pn) : Q2.Pn = M.map q ;
  beta (x : Q2.Point) : Id Q2.Pn (map (Q2.class x)) (Q2.class (point x)) = M.beta x ;
 } ;
 -- the inverse automorphism inverts the action
 back (A : Auto) (q : Q2.Pn) : Id Q2.Pn (Act[inverse A].map (Act[A].map q)) q =
  Q2.Q.induction @l (\ q -> Id Q2.Pn (Act[inverse A].map (Act[A].map q)) q) (\ q -> Q2.Q.set _ _)
   (\ x -> trans (ap (Act[inverse A].map) (Act[A].beta x))
     (trans (Act[inverse A].beta (Act[A].point x)) (ap Q2.class (Q2.point-eq (Act[inverse A].point (Act[A].point x)) x (A.2.2.2.2.1 x.1))))) q ;
 forth (A : Auto) (q : Q2.Pn) : Id Q2.Pn (Act[A].map (Act[inverse A].map q)) q =
  Q2.Q.induction @l (\ q -> Id Q2.Pn (Act[A].map (Act[inverse A].map q)) q) (\ q -> Q2.Q.set _ _)
   (\ x -> trans (ap (Act[A].map) (Act[inverse A].beta x))
     (trans (Act[A].beta (Act[inverse A].point x)) (ap Q2.class (Q2.point-eq (Act[A].point (Act[inverse A].point x)) x (A.2.2.2.2.2 x.1))))) q ;
 injective (A : Auto) (q q' : Q2.Pn) (e : Id Q2.Pn (Act[A].map q) (Act[A].map q')) : Id Q2.Pn q q' =
  trans (sym (back A q)) (trans (ap (Act[inverse A].map) e) (back A q')) ;

 -- permutations of coordinates
 permutation (s t : I -> I) (st : (i : I) -> Id I (s (t i)) i) (ts : (i : I) -> Id I (t (s i)) i) : Auto =
  (\ v i -> v (s i),\ w i -> w (t i),\ a v -> refl (Q2.scale a (\ i -> v (s i))),\ a w -> refl (Q2.scale a (\ i -> w (t i))),
   \ v -> Q2.vector-eq _ _ (\ i -> ap v (st i)),\ w -> Q2.vector-eq _ _ (\ i -> ap w (ts i))) ;
 swap (u v : I) : Auto =
  permutation (FinSwap[l].Swap[suc n,u,v].swap) (FinSwap[l].Swap[suc n,u,v].swap)
   (FinSwap[l].Swap[suc n,u,v].involution) (FinSwap[l].Swap[suc n,u,v].involution) ;
} ;
