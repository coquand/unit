-- Boundary cases for the constructed localization and quotient, and
-- negative checks against silently collapsing their source algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module BP = BasePresentation[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ;
 module Q = FiniteQuotient[l].Over[R,setR] ;
 module Zero = I.Presented[C.base,BP.empty,BP.presentation,R.z,cst R.z,refl R.z] ;
 module One = I.Presented[C.base,BP.empty,BP.presentation,R.o,cst R.o,refl R.o] ;
 -- Localizing at zero collapses the target, without any geometric axiom.
 module Z = AffinePowers[l].Over[Zero.L.algebra.ring] ;
 zero-collapses : Id Zero.L.algebra.ring.R Zero.L.algebra.ring.o Zero.L.algebra.ring.z =
  trans (sym Zero.L.inverse.2)
   (trans (ap (\ t -> Zero.L.algebra.ring.mul t Zero.L.inverse.1)
    (RingHom[l].zero R Zero.L.algebra.ring Zero.L.inclusion.1))
    (RL[Zero.L.algebra.ring].zero-mul Zero.L.inverse.1)) ;
 -- Localizing at one has an actual algebra retraction.
 one-back : C.Hom One.L.algebra C.base =
  (One.result.2.2.2.2 C.base).sec (C.identity C.base,(R.o,R.mulO R.o)) ;
 one-beta (a : R.R) : Id R.R (one-back.1.1 (One.L.inclusion.1.1 a)) a =
  ap (\ d -> d.1.1.1 a) ((One.result.2.2.2.2 C.base).sec-eq (C.identity C.base,(R.o,R.mulO R.o))) ;
 module KillOne = Q.Presented[C.base,BP.empty,BP.presentation,suc zero,\ i -> R.o,\ i -> cst R.o,\ i -> refl R.o] ;
 quotient-one-collapses : Id KillOne.Q.algebra.ring.R KillOne.Q.algebra.ring.o KillOne.Q.algebra.ring.z =
  trans (sym KillOne.Q.inclusion.1.2.1) (KillOne.kills (inr tt)) ;
 module KillNone = Q.Presented[C.base,BP.empty,BP.presentation,zero,
  BP.no-values C.base,absurd (P.Expr (Fin zero)),\ i -> efq i] ;
 none-back : C.Hom KillNone.Q.algebra C.base =
  (KillNone.universal C.base).sec (C.identity C.base,\ i -> efq i) ;
 none-beta (a : R.R) : Id R.R (none-back.1.1 (KillNone.Q.inclusion.1.1 a)) a =
  ap (\ d -> d.1.1.1 a) ((KillNone.universal C.base).sec-eq (C.identity C.base,\ i -> efq i)) ;
 module Geometric (sqc : P.SQC) (one-nz : Not (Id R.R R.o R.z)) {
  module FA = FunctionAlgebra[l].Over[R,setR] ;
  base-point (t : Top) : C.Spec C.base = C.identity C.base ;
  base-equiv : Pr.Equiv Top (C.Spec C.base) =
   (base-point,Pr.qinv Top (C.Spec C.base) base-point (\ x -> tt)
    (\ x -> C.ext C.base C.base _ x (\ a -> sym (x.2 a))) (\ t -> AffineFinite[l].top-eq tt t)) ;
  affine-top : FA.Affine Top =
   Tr1.Trunc[FA.AffineWitness Top].inc (C.base,BP.finitely-presented,base-equiv) ;
  reconstruct-top : Pr.Equiv Top (C.Spec FA.At[Top].algebra) = FA.SAG[sqc].equivalence Top affine-top ;
  function-ring-fp : P.FP FA.At[Top].algebra =
   AffineUniqueness[l].Over[R,setR,sqc].At[Top].function-algebra-fp affine-top ;
  no-base-zero-unit : RL[R].unit R.z -> Empty =
   \ u -> AffineUnits[l].Over[R,setR,sqc,one-nz].unit-nonzero R.z u (refl R.z) ;
  no-nilpotent-one : AffinePowers[l].Over[R].Nilpotent R.o -> Empty =
   Tr.Trunc[(n : Nat) * Id R.R (AffinePowers[l].Over[R].power R.o n) R.z].induction @l
    (\ t -> Empty) (\ t -> \ a b -> efq a)
    (\ w -> one-nz (AffinePowers[l].Over[R].Units[setR].nilpotent-unit R.o (R.o,R.mulO R.o) w)) ;
 } ;
 #fails {
  -- A localization can kill a nonzero source element.
  false-reflection : Id R.R R.o R.z = zero-collapses ;
 } ;
 #fails {
  -- In particular there is no automatically supplied map R[0^-1] -> R.
  false-zero-retraction : C.Hom Zero.L.algebra C.base = C.identity C.base ;
 } ;
 #fails {
  false-nilpotence : Id R.R (AffinePowers[l].Over[R].power R.o (suc zero)) R.z = refl R.z ;
 } ;
} ;
