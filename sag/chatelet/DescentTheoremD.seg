-- Theorem D (sevb 1.3.5): finite freeness of fixed rank descends.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
 (sh : [j] SheafClosure[l,j].Over[EtaleTopology[l].Over[R,setR].I,EtaleTopology[l].Over[R,setR].G].Ops) {
 module MD = Modules[l].Over[R,setR] ; module DL = DescentLinear[l].Over[R,setR] ;
 module ET = EtaleTopology[l].Over[R,setR] ; module SL = SheafLemmas[l,l].Over[ET.I,ET.G] ;
 module At (M : MD.Module) (modal : ET.T.isModal @l M.M)
  (rank : Nat) (local : (sh @l).close (DL.On[M].Frame rank)) {
  module G = DescentGenerators[l].Over[R,setR,axioms].At[M,modal,sh,rank,local] ;
  module B = DescentBasis[l].Over[R,setR,axioms].Rank[rank] ;
  module Generator (idx : ET.I) (h : ET.G idx -> Tr.Trunc[DL.On[M].Frame rank].carrier) {
   result : Tr.Trunc[DL.On[M].Frame rank].carrier =
    TC.bind G.Generating (DL.On[M].Frame rank)
     (\ g -> B.Size[g.1].FiniteGenerators[M,modal,sh,local,g.2.1,g.2.2].frame)
     G.Generator[idx,\ x -> h (ET.root-inc idx x)].theorem ;
  } ;
  modal-frame : ET.T.isModal @l Tr.Trunc[DL.On[M].Frame rank].carrier =
   SL.modal-of-sec Tr.Trunc[DL.On[M].Frame rank].carrier Tr.Trunc[DL.On[M].Frame rank].proposition
    (\ idx h -> Generator[idx,h].result) ;
  theorem : Tr.Trunc[DL.On[M].Frame rank].carrier =
   (sh @l).elim @l (DL.On[M].Frame rank) Tr.Trunc[DL.On[M].Frame rank].carrier
    Tr.Trunc[DL.On[M].Frame rank].proposition modal-frame Tr.Trunc[DL.On[M].Frame rank].inc local ;
  opaque theorem ;
 } ;
} ;
