-- Spec R[X] is R, with evaluation of coefficient lists made explicit.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module RX = C.Polynomial[C.base] ;
 module Raw = Poly[l].PolyR[R] ; module To = RX.To[C.base] ;
 module UP = Universal[l].Property[R,R,setR,setR] ;
 X : U l = C.Spec RX.algebra ;
 point (a : R.R) : X = To.backward (C.identity C.base,a) ;
 coordinate (x : X) : R.R = x.1.1 RX.X.variable ;
 beta (a : R.R) : Id R.R (coordinate (point a)) a = UP.Given[RingHom[l].identity R,a].on-variable ;
 eta (x : X) : Id X (point (coordinate x)) x =
  C.ext RX.algebra C.base _ _ (\ p -> ap (\ h -> h.1 p)
   (sym (UP.Given[RingHom[l].identity R,coordinate x].unique x.1 x.2 (refl (coordinate x))))) ;
 equivalence : Pr.Equiv X R.R = (coordinate,Pr.qinv X R.R coordinate point beta eta) ;
 module At (a : R.R) {
  module E = Evaluation[l].Evaluate[R,R,setR,setR,RingHom[l].identity R,a] ;
  raw : (p : Raw.P) -> Id R.R (E.E p) (Raw.ev p a) = split {
   nil -> refl R.z ; cons b p | ih -> ap (\ v -> R.add b (R.mul a v)) ih } ;
  evaluate (p : Raw.P) : Id R.R ((point a).1.1 (RX.X.include p)) (Raw.ev p a) =
   trans (E.D.beta p) (raw p) ;
 } ;
 evaluate (x : X) (p : Raw.P) : Id R.R (x.1.1 (RX.X.include p)) (Raw.ev p (coordinate x)) =
  trans (ap (\ q -> q.1.1 (RX.X.include p)) (sym (eta x))) (At[coordinate x].evaluate p) ;
 module Monic (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions)
  (T : R.R -> LineAssociated[l].Over[R,setR].TI.Tor) (lower : List R.R)
  (local-frame : (a : R.R) -> RL[R].unit (Raw.ev (HorrocksInterface[l].Over[R,setR].monic-list lower) a) -> (T a).1) {
  module H = HorrocksInterface[l].Over[R,setR] ;
  t (x : X) (u : RL[R].unit (x.1.1 (H.monic lower))) : (T (coordinate x)).1 =
   local-frame (coordinate x) (Pr.subst R.R RL[R].unit _ _ (evaluate x (H.monic-list lower)) u) ;
  module M = MonicLineTriviality[l].Over[R,setR,axioms].For[\ x -> T (coordinate x),lower,t] ;
  Frames : U l = (a : R.R) -> (T a).1 ;
  map (v : (x : X) -> (T (coordinate x)).1) : Frames = \ a ->
   Pr.subst R.R (\ b -> (T b).1) (coordinate (point a)) a (beta a) (v (point a)) ;
  theorem : Tr.Trunc[Frames].carrier =
   Tr.Trunc[(x : X) -> (T (coordinate x)).1].induction @l (\ v -> Tr.Trunc[Frames].carrier)
    (\ v -> Tr.Trunc[Frames].proposition) (\ v -> Tr.Trunc[Frames].inc (map v)) M.theorem ;
 } ;
} ;
