-- Finite normalised pairings give an actual projector over the affine
-- coordinate algebra. Its fixed vectors are equivalent to global sections.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R)
 (axioms : SAGAxioms[l,l].Over[R,setR].Assumptions) {
 module C = Algebras[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 module AS = LineAssociated[l].Over[R,setR] ;
 module RS = FiniteIdeal[l].Sums[R] ;
 module At (Alg : C.Algebra) (fp : P.FP Alg) (T : C.Spec Alg -> AS.TI.Tor) {
  module D = AffineLineData[l].Over[R,setR,axioms].At[Alg,fp,T] ;
  X : U l = C.Spec Alg ;
  module SA = FiniteIdeal[l].Sums[Alg.ring] ;
  back (f : X -> R.R) : Alg.ring.R = (axioms.sqc Alg fp).sec f ;
  back-beta (f : X -> R.R) (x : X) : Id R.R (x.1.1 (back f)) (f x) =
   Pr.happly X (\ x -> R.R) _ _ ((axioms.sqc Alg fp).sec-eq f) x ;
  ext (a b : Alg.ring.R) (h : (x : X) -> Id R.R (x.1.1 a) (x.1.1 b)) : Id Alg.ring.R a b =
   Equivalences[l].injective Alg.ring.R (X -> R.R) (C.evaluation Alg) (axioms.sqc Alg fp) a b
    (F.funext X (\ x -> R.R) _ _ h) ;
  module From (w : D.Data) {
   n : Nat = w.1 ;
   ss : Fin n -> D.Sections = w.2.1 ;
   ds : Fin n -> D.DualSections = w.2.2.1 ;
   module M = RankOneProjector[l].Over[Alg.ring].Size[n] ;
   module Fixed = ProjectorFreeness[l].Over[Alg.ring,Alg.set,n] ;
   entry (i j : Fin n) : Alg.ring.R = back (D.pair (ds i) (ss j)) ;
   beta (i j : Fin n) (x : X) :
    Id R.R (x.1.1 (entry i j)) (D.pair (ds i) (ss j) x) =
    back-beta (D.pair (ds i) (ss j)) x ;
   trace : Id Alg.ring.R (SA.sum n (\ i -> entry i i)) Alg.ring.o =
    ext _ _ (\ x ->
     trans (StandardOpens[l].SumMap[Alg.ring,R,x.1].natural n (\ i -> entry i i))
      (trans (RS.sum-cong n _ _ (\ i -> beta i i x)) (trans (w.2.2.2 x) (sym x.1.2.1)))) ;
   minors (i j k h : Fin n) :
    Id Alg.ring.R (Alg.ring.mul (entry i j) (entry k h)) (Alg.ring.mul (entry i h) (entry k j)) =
    ext _ _ (\ x ->
     trans (x.1.2.2.2 (entry i j) (entry k h))
      (trans (cong2 R.R R.mul _ _ _ _ (beta i j x) (beta k h x))
       (trans (D.Fiber[x].Pair.exchange (ds i x) (ds k x) (ss j x) (ss h x))
        (trans (sym (cong2 R.R R.mul _ _ _ _ (beta i h x) (beta k j x)))
         (sym (x.1.2.2.2 (entry i h) (entry k j))))))) ;
   projector : M.Projector = RankOneTrace[l].Over[Alg.ring,n].From[entry,trace,minors].projector ;
   module Fiber (x : X) {
    module L = D.Fiber[x].L ;
    module Pair = D.Fiber[x].Pair ;
    module Sum = ModuleFiniteSums[l].Over[R,setR,L.associated] ;
    coordinates (v : L.Carrier) (i : Fin n) : R.R = Pair.pair (ds i x) v ;
    rebuild (a : Fin n -> R.R) : L.Carrier = Sum.sum n (\ i -> L.scale (a i) (ss i x)) ;
    reconstruct (v : L.Carrier) : Id L.Carrier (rebuild (coordinates v)) v =
     trans (Sum.congruent n (\ i -> L.scale (coordinates v i) (ss i x))
      (\ i -> L.scale (Pair.pair (ds i x) (ss i x)) v)
      (\ i -> Pair.rank-one (ds i x) v (ss i x)))
      (trans (Sum.sum-scale v n (\ i -> Pair.pair (ds i x) (ss i x)))
       (trans (ap (\ r -> L.scale r v) (w.2.2.2 x)) (L.associated.smO v))) ;
    coord-rebuild (a : Fin n -> R.R) (i : Fin n) :
     Id R.R (coordinates (rebuild a) i)
      (RS.sum n (\ j -> R.mul (x.1.1 (entry i j)) (a j))) =
     trans (Sum.map (Pair.pair (ds i x)) (Pair.zero-right (ds i x)) (Pair.add-right (ds i x))
      n (\ j -> L.scale (a j) (ss j x)))
      (RS.sum-cong n _ _ (\ j ->
       trans (Pair.scale-right (ds i x) (a j) (ss j x))
        (trans (R.mulC (a j) (Pair.pair (ds i x) (ss j x)))
         (ap (\ r -> R.mul r (a j)) (sym (beta i j x)))))) ;
   } ;
   coordinates (s : D.Sections) (i : Fin n) : Alg.ring.R = back (D.pair (ds i) s) ;
   coord-beta (s : D.Sections) (i : Fin n) (x : X) :
    Id R.R (x.1.1 (coordinates s i)) (Fiber[x].coordinates (s x) i) =
    back-beta (D.pair (ds i) s) x ;
   action-at (v : M.Vector) (i : Fin n) (x : X) :
    Id R.R (x.1.1 (M.action entry v i))
     (RS.sum n (\ j -> R.mul (x.1.1 (entry i j)) (x.1.1 (v j)))) =
    StandardOpens[l].SumMap[Alg.ring,R,x.1].combination n (entry i) v ;
   fixed (s : D.Sections) (i : Fin n) :
    Id Alg.ring.R (M.action entry (coordinates s) i) (coordinates s i) =
    ext _ _ (\ x ->
     trans (action-at (coordinates s) i x)
      (trans (RS.sum-cong n _ _ (\ j -> ap (R.mul (x.1.1 (entry i j))) (coord-beta s j x)))
       (trans (sym (Fiber[x].coord-rebuild (Fiber[x].coordinates (s x)) i))
        (trans (ap (\ v -> Fiber[x].coordinates v i) (Fiber[x].reconstruct (s x)))
         (sym (coord-beta s i x)))))) ;
   encode (s : D.Sections) : Fixed.Fixed entry = (coordinates s,fixed s) ;
   decode (v : Fixed.Fixed entry) (x : X) : (D.LM x).M =
    Fiber[x].rebuild (\ i -> x.1.1 (v.1 i)) ;
   decode-encode (s : D.Sections) : Id D.Sections (decode (encode s)) s =
    F.funext X (\ x -> (D.LM x).M) _ _ (\ x ->
     trans (Fiber[x].Sum.congruent n
      (\ i -> D.Fiber[x].L.scale (x.1.1 (coordinates s i)) (ss i x))
      (\ i -> D.Fiber[x].L.scale (Fiber[x].coordinates (s x) i) (ss i x))
      (\ i -> ap (\ r -> D.Fiber[x].L.scale r (ss i x)) (coord-beta s i x)))
      (Fiber[x].reconstruct (s x))) ;
   encode-decode (v : Fixed.Fixed entry) : Id (Fixed.Fixed entry) (encode (decode v)) v =
    Pr.Sigma-eq M.Vector (\ a -> (i : Fin n) -> Id Alg.ring.R (M.action entry a i) (a i))
     _ _ _ _ (F.funext (Fin n) (\ i -> Alg.ring.R) _ _ (\ i ->
      ext _ _ (\ x -> trans (coord-beta (decode v) i x)
       (trans (Fiber[x].coord-rebuild (\ j -> x.1.1 (v.1 j)) i)
        (trans (sym (action-at v.1 i x)) (ap x.1.1 (v.2 i)))))))
     (Fixed.fixed-prop entry v.1) ;
   equivalence : Pr.Equiv D.Sections (Fixed.Fixed entry) =
    (encode,Pr.qinv D.Sections (Fixed.Fixed entry) encode decode encode-decode decode-encode) ;
   -- The representation respects the coordinate algebra's module action.
   coordinates-add (s t : D.Sections) (i : Fin n) :
    Id Alg.ring.R (coordinates (\ x -> (D.LM x).madd (s x) (t x)) i)
     (Alg.ring.add (coordinates s i) (coordinates t i)) =
    ext _ _ (\ x ->
     trans (coord-beta (\ x -> (D.LM x).madd (s x) (t x)) i x)
      (trans (D.Fiber[x].Pair.add-right (ds i x) (s x) (t x))
       (trans (sym (cong2 R.R R.add _ _ _ _ (coord-beta s i x) (coord-beta t i x)))
        (sym (x.1.2.2.1 (coordinates s i) (coordinates t i)))))) ;
   coordinates-scale (a : Alg.ring.R) (s : D.Sections) (i : Fin n) :
    Id Alg.ring.R (coordinates (\ x -> (D.LM x).sm (x.1.1 a) (s x)) i)
     (Alg.ring.mul a (coordinates s i)) =
    ext _ _ (\ x ->
     trans (coord-beta (\ x -> (D.LM x).sm (x.1.1 a) (s x)) i x)
      (trans (D.Fiber[x].Pair.scale-right (ds i x) (x.1.1 a) (s x))
       (trans (ap (R.mul (x.1.1 a)) (sym (coord-beta s i x)))
        (sym (x.1.2.2.2 a (coordinates s i)))))) ;
  } ;
  Representation (n : Nat) (e : RankOneProjector[l].Over[Alg.ring].Size[n].Projector) : U l =
   (q : Pr.Equiv D.Sections (ProjectorFreeness[l].Over[Alg.ring,Alg.set,n].Fixed e.entry)) *
   ((s t : D.Sections) (i : Fin n) ->
    Id Alg.ring.R ((q.1 (\ x -> (D.LM x).madd (s x) (t x))).1 i)
     (Alg.ring.add ((q.1 s).1 i) ((q.1 t).1 i))) *
   ((a : Alg.ring.R) (s : D.Sections) (i : Fin n) ->
    Id Alg.ring.R ((q.1 (\ x -> (D.LM x).sm (x.1.1 a) (s x))).1 i)
     (Alg.ring.mul a ((q.1 s).1 i))) ;
  Witness : U l = (n : Nat) * (e : RankOneProjector[l].Over[Alg.ring].Size[n].Projector) *
   Representation n e ;
  theorem : Tr.Trunc[Witness].carrier =
   Tr.Trunc[D.Data].induction @l (\ d -> Tr.Trunc[Witness].carrier)
    (\ d -> Tr.Trunc[Witness].proposition)
    (\ d -> Tr.Trunc[Witness].inc
     (d.1,From[d].projector,From[d].equivalence,From[d].coordinates-add,From[d].coordinates-scale)) D.theorem ;
 } ;
} ;
