-- Restrict a derivation Q -> eQ to the actual idempotent factor eQ.
-- D(e)=0 follows without dividing by 2. Consequently D(e*x)=D(x),
-- so trace nondegeneracy on just this factor detects D(x).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (S : Algebras[l].Over[k,setk].Algebra)
 (e : S.ring.R) (he : Id S.ring.R (S.ring.mul e e) e) {
 module R = TraceRetraction[l].Idempotent[k,setk,S,e,he] ; module F = R.F ;
 module TL = TraceLinear[l].Over[k,setk] ; module L = RL[F.ring] ;
 module Relative = RelativeDerivations[l].Over[k,setk,S,R.algebra,R.projection] ;
 module Given (d : Relative.Derivation) {
  projection-e : Id F.Carrier (F.project e) F.one = F.eq _ _ he ;
  idempotent-equation : Id F.Carrier (d.linear.map e) (F.add (d.linear.map e) (d.linear.map e)) =
   trans (ap d.linear.map (sym he))
    (trans (d.product e e)
     (cong2 F.Carrier F.add _ _ _ _
      (trans (ap (F.mul (d.linear.map e)) projection-e) (F.ring.mulO (d.linear.map e)))
      (trans (ap (\ a -> F.mul a (d.linear.map e)) projection-e) (L.one-left (d.linear.map e))))) ;
  idempotent-zero : Id F.Carrier (d.linear.map e) F.zero =
   L.add-cancel (d.linear.map e) (d.linear.map e) (sym idempotent-equation) ;
  linear : TL.Linear[R.algebra,R.algebra] = TL.compose R.algebra S R.algebra d.linear R.inclusion ;
  product (a b : F.Carrier) : Id F.Carrier (linear.map (F.mul a b))
   (F.add (F.mul (linear.map a) b) (F.mul a (linear.map b))) =
    trans (d.product a.1 b.1)
     (cong2 F.Carrier F.add _ _ _ _ (ap (F.mul (d.linear.map a.1)) (R.retract b))
      (ap (\ c -> F.mul c (d.linear.map b.1)) (R.retract a))) ;
  on-project (a : S.ring.R) : Id F.Carrier (linear.map (F.project a)) (d.linear.map a) =
   trans (d.product e a)
    (trans (cong2 F.Carrier F.add _ _ _ _
     (trans (ap (\ b -> F.mul b (F.project a)) idempotent-zero) (L.zero-mul (F.project a)))
     (trans (ap (\ b -> F.mul b (d.linear.map a)) projection-e) (L.one-left (d.linear.map a))))
     (L.zl (d.linear.map a))) ;
  module Trace (n : Nat) (basis : TraceBasis[l].Over[k,setk,R.algebra].Basis[n]) {
   module D = TraceDerivations[l].Over[k,setk,R.algebra,n,basis] ;
   derivation : D.Derivation = new D.Derivation[linear,product] ;
   theorem (nondegenerate : (a : F.Carrier) ->
    ((b : F.Carrier) -> Id k.R (D.B.trace (F.mul a b)) k.z) -> Id F.Carrier a F.zero)
    (a : S.ring.R) : Id F.Carrier (d.linear.map a) F.zero =
     trans (sym (on-project a)) (D.Given[derivation].from-nondegenerate nondegenerate (F.project a)) ;
  } ;
 } ;
} ;
