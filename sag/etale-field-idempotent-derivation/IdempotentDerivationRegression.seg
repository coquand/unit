-- Characteristic-two regression: dual numbers have a nonzero derivation.
-- Restriction to the unit factor preserves D(epsilon)=1. No trace
-- nondegeneracy hypothesis is silently inferred for this nonreduced ring.
level l ; open Ring[l] ; open Presentations[l] ;
module B = BooleanRing[l] ; k : CRing = B.two-ring ;
module Q = QuadraticPairs[l].Over[k,B.bool-set,k.z] ;
module C = Algebras[l].Over[k,B.bool-set] ; module TL = TraceLinear[l].Over[k,B.bool-set] ;
value (a : Q.Pair) : Q.Pair = (a.2,false) ;
add (a b : Q.Pair) : Id Q.Pair (value (Q.plusQ a b)) (Q.plusQ (value a) (value b)) = refl (k.add a.2 b.2,false) ;
scale-cases : (r a b : k.R) -> Id Q.Pair (value (Q.timesQ (Q.constant r) (a,b))) (Q.timesQ (Q.constant r) (value (a,b))) = split { false -> split { false -> split { false -> refl (false,false) ; true -> refl (false,false) } ; true -> split { false -> refl (false,false) ; true -> refl (false,false) } } ; true -> split { false -> split { false -> refl (false,false) ; true -> refl (true,false) } ; true -> split { false -> refl (false,false) ; true -> refl (true,false) } } } ;
product-cases : (a b c d : k.R) -> Id Q.Pair (value (Q.timesQ (a,b) (c,d))) (Q.plusQ (Q.timesQ (value (a,b)) (c,d)) (Q.timesQ (a,b) (value (c,d)))) = split { false -> split { false -> split { false -> split { false -> refl (false,false) ; true -> refl (false,false) } ; true -> split { false -> refl (false,false) ; true -> refl (false,false) } } ; true -> split { false -> split { false -> refl (false,false) ; true -> refl (false,false) } ; true -> split { false -> refl (true,false) ; true -> refl (true,false) } } } ; true -> split { false -> split { false -> split { false -> refl (false,false) ; true -> refl (true,false) } ; true -> split { false -> refl (false,false) ; true -> refl (true,false) } } ; true -> split { false -> split { false -> refl (false,false) ; true -> refl (true,false) } ; true -> split { false -> refl (true,false) ; true -> refl (false,false) } } } } ;
linear : TL.Linear[Q.algebra,Q.algebra] = new TL.Linear[Q.algebra,Q.algebra,value,add,\ r a -> scale-cases r a.1 a.2] ;
module Restrict = IdempotentDerivation[l].Over[k,B.bool-set,Q.algebra,Q.oneQ,refl Q.oneQ] ;
module F = Restrict.F ; module R = Restrict.R ;
projection-linear : TL.Linear[Q.algebra,R.algebra] = new TL.Linear[Q.algebra,R.algebra,F.project,F.project-add,
 \ r a -> F.project-mul (Q.constant r) a] ;
relative-linear : TL.Linear[Q.algebra,R.algebra] = TL.compose Q.algebra Q.algebra R.algebra projection-linear linear ;
product (a b : Q.Pair) : Id F.Carrier (relative-linear.map (Q.timesQ a b))
 (F.add (F.mul (relative-linear.map a) (F.project b)) (F.mul (F.project a) (relative-linear.map b))) =
 trans (ap F.project (product-cases a.1 a.2 b.1 b.2))
  (trans (F.project-add (Q.timesQ (value a) b) (Q.timesQ a (value b)))
   (cong2 F.Carrier F.add _ _ _ _ (F.project-mul (value a) b) (F.project-mul a (value b)))) ;
d : Restrict.Relative.Derivation = new Restrict.Relative.Derivation[relative-linear,product] ;
module Result = Restrict.Given[d] ;
idempotent-zero : Id F.Carrier (relative-linear.map Q.oneQ) F.zero = Result.idempotent-zero ;
generator : Id F.Carrier (Result.linear.map (F.project Q.tau)) F.one =
 trans (Result.on-project Q.tau) F.project-one ;
nonzero : Not (Id F.Carrier (Result.linear.map (F.project Q.tau)) F.zero) =
 \ h -> PrimitiveRegression[l].nonzero (ap (\ a -> a.1.1) (trans (sym generator) h)) ;
