-- The localisation E[1/G(y)] is basic standard etale.
--
-- Informal proof.  E is finitely presented and formally unramified, and
-- every e in E is merely A(y)/G(y)^n; G(y) need not be a unit and y need
-- not be integral.  Put T = E[1/G(y)] (PrincipalEtale: T is presented,
-- unramified, and formally smooth when E is).  In T, G(y) is a unit and
-- every element is a fraction over G(y): the old generators are fractions
-- by hypothesis, the new generator is 1/G(y), and fractions are closed
-- under the operations.  BasicStandard applies to T.
-- This is LocalMonogenicStandard with the integral equation removed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module Tr1 = Truncation[l+] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (cs : List R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 module FE = FormallyEtale[l].Over[R,setR] ; module PF = PolynomialFractions[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ; module GS = Generated[l].Over[R,setR] ;
 G : B.Carrier = B.include cs ;
 module At (E : C.Algebra) (p : P.Presentation) (pe : P.Presents p E)
  (y : E.ring.R) (full : PF.At[E,y,G].Full) (unique : FE.Unique E) {
  module Old = PF.At[E,y,G] ; g : E.ring.R = Old.g ;
  Result : U l+ = (loc : I.LocalizationWitness E g) * (coefficients : List R.R) *
   (denominator : B.Carrier) * SE.Points[B.include coefficients,denominator].Standard loc.1 ;
  module Given (rep : GS.Representation p E pe g) {
   module PL = PrincipalEtale[l].Over[R,setR,E,p,pe,g,rep.1,rep.2] ; module Loc = PL.L ;
   T : C.Algebra = Loc.algebra ; i : C.Hom E T = Loc.inclusion ; z : T.ring.R = i.1.1 y ;
   module Map = PF.Map[E,T,y,z,G,i,refl z] ; module Fr = Map.Bp ;
   unit : RL[T.ring].unit Fr.g = subst (RL[T.ring].unit) (Map.value G) Loc.inverse ;
   -- every element of T is a fraction over G(z)
   W : U l = Fin (suc p.1) ;
   generators : W -> T.ring.R = Loc.K.A.solution.1 ;
   old-fraction (v : Fin p.1) : Tr.Trunc[Fr.Fraction (generators (inl v))].carrier =
    TC.map (Old.Fraction (pe.1.1 v)) (Fr.Fraction (generators (inl v)))
     (\ w -> subst Fr.Fraction (Loc.Canonical[T].inclusion-gen v) (Map.fraction (pe.1.1 v) w)) (full (pe.1.1 v)) ;
   inverse-fraction : Fr.Fraction (generators (inr tt)) =
    (B.oneQ,suc zero,trans Fr.X.ev.2.1
     (trans (sym Loc.inverse.2) (ap (\ a -> T.ring.mul a Loc.inverse.1)
      (trans (Map.value G) (sym (T.ring.mulO Fr.g)))))) ;
   variable : (v : W) -> Tr.Trunc[Fr.Fraction (generators v)].carrier = split {
    inl v -> old-fraction v ;
    inr t -> Tr.Trunc[Fr.Fraction (generators (inr t))].inc
     (subst (\ t -> Fr.Fraction (generators (inr t))) (P.top-prop tt t) inverse-fraction) } ;
   expression : (e : P.Expr W) -> Tr.Trunc[Fr.Fraction (P.eval W T generators e)].carrier = split {
    var v -> variable v ;
    cst r -> Tr.Trunc[Fr.Fraction (T.iota.1 r)].inc
     (B.constant r,zero,trans (Fr.X.UP.on-constants r) (sym (RL[T.ring].one-left (T.iota.1 r)))) ;
    sumE e f | he hf -> TC.map2 (Fr.Fraction (P.eval W T generators e)) (Fr.Fraction (P.eval W T generators f))
     (Fr.Fraction (T.ring.add (P.eval W T generators e) (P.eval W T generators f)))
     (Fr.Ar.add (P.eval W T generators e) (P.eval W T generators f)) he hf ;
    mulE e f | he hf -> TC.map2 (Fr.Fraction (P.eval W T generators e)) (Fr.Fraction (P.eval W T generators f))
     (Fr.Fraction (T.ring.mul (P.eval W T generators e) (P.eval W T generators f)))
     (Fr.Ar.multiply (P.eval W T generators e) (P.eval W T generators f)) he hf } ;
   module Gens = GS.Generated[Loc.pres,T,Loc.K.presentation] ;
   from-expression (t : T.ring.R) (w : GS.Representation Loc.pres T Loc.K.presentation t) : Tr.Trunc[Fr.Fraction t].carrier =
    TC.map (Fr.Fraction (P.eval W T generators w.1)) (Fr.Fraction t) (subst Fr.Fraction w.2) (expression w.1) ;
   fractions (t : T.ring.R) : Tr.Trunc[Fr.Fraction t].carrier =
    TC.bind (GS.Representation Loc.pres T Loc.K.presentation t) (Fr.Fraction t) (from-expression t) (Gens.generated t) ;
   -- BasicStandard on T
   module M = BasicStandard[l].Over[R,setR,cs].At[T,Loc.pres,Loc.K.presentation,z,unit,fractions,
    PL.Unramified[unique].theorem] ;
   localisation : I.LocalizationWitness E g = I.Presented[E,p,pe,g,rep.1,rep.2].result ;
   result (w : M.Result) : Result = (localisation,w) ;
   theorem (smooth : FE.Lift E) : Tr1.Trunc[Result].carrier =
    Tr1.Trunc[M.Result].induction @l+ (\ w -> Tr1.Trunc[Result].carrier) (\ w -> Tr1.Trunc[Result].proposition)
     (\ w -> Tr1.Trunc[Result].inc (result w)) M.Smooth[PL.Smooth[smooth].theorem].theorem ;
  } ;
  module Gens = GS.Generated[p,E,pe] ;
  theorem (smooth : FE.Lift E) : Tr1.Trunc[Result].carrier =
   TC.rec (GS.Representation p E pe g) @l+ (Tr1.Trunc[Result].carrier) Tr1.Trunc[Result].proposition
    (\ rep -> Given[rep].theorem smooth) (Gens.generated g) ;
  module Flat (flat : FlatRelations[l].Over[R,E.ring,E.iota].Flat) {
   module Direct = FlatUnramifiedEtale[l].Over[R,setR].Presented[E,(p,pe),unique,flat] ;
   result : Tr1.Trunc[Result].carrier = theorem Direct.theorem.1.1 ;
  } ;
 } ;
} ;
