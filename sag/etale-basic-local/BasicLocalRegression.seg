-- Regressions for the basic endpoint.  No integral equation is supplied
-- anywhere in this file.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
-- The base algebra R at y = a, localised at G(a) = t.
module Point (R : CRing) (setR : Pr.isSet R.R) (a t : R.R) {
 module P0 = DirectRegression[l].AtPoint[R,setR,a] ;
 module Empty = DirectRegression[l].Empty[R,setR] ;
 module Red = DirectRegression[l].Point[R,setR,a] ;
 module C = P0.C ; module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 cs : List R.R = cons t nil ;
 module Fr = PolynomialFractions[l].Over[R,setR].At[C.base,a,B.include cs] ;
 full (r : R.R) : Tr.Trunc[Fr.Fraction r].carrier = Tr.Trunc[Fr.Fraction r].inc
  (B.constant r,zero,trans (Fr.X.UP.on-constants r) (sym (RL[R].one-left r))) ;
 module Local = LocalBasicStandard[l].Over[R,setR,cs].At[C.base,P0.presentation,P0.presents,a,full,Empty.unique] ;
 theorem : Tr1.Trunc[Local.Result].carrier = Local.theorem Empty.theorem.1.1 ;
 flat-theorem : Tr1.Trunc[Local.Result].carrier = Local.Flat[FlatRelations[l].Self[R].flat].result ;
 module Redundant = LocalBasicStandard[l].Over[R,setR,cs].At[C.base,Red.redundant,Red.presents,a,full,Empty.unique] ;
 redundant-theorem : Tr1.Trunc[Redundant.Result].carrier = Redundant.theorem Red.redundant-theorem.1.1 ;
 module NoGenerators = LocalBasicStandard[l].Over[R,setR,cs].At[C.base,Empty.presentation.1,Empty.presentation.2,a,full,Empty.unique] ;
 empty-presentation : Tr1.Trunc[NoGenerators.Result].carrier = NoGenerators.theorem Empty.theorem.1.1 ;
 module Public = ShortBasicEtale[l].Over[R,setR,cs].At[C.base,a,full,Empty.unique] ;
 module Pres = Presentations[l].Over[R,setR] ;
 fp : Pres.FP C.base = Tr1.Trunc[Pres.Witness C.base].inc (P0.presentation,P0.presents) ;
 public-theorem : Tr1.Trunc[Public.Result].carrier = Public.theorem fp Empty.theorem.1.1 ;
 public-flat : Tr1.Trunc[Public.Result].carrier = Public.flat-theorem fp FlatRelations[l].Self[R].flat ;
} ;
module Z = ZMod4[l] ;
module AtUnit = Point[Z.ring,Z.set,q2,q1] ;
module AtNilpotent = Point[Z.ring,Z.set,q2,q2] ;
module AtZero = Point[Z.ring,Z.set,q2,q0] ;
unit-localisation : Tr1.Trunc[AtUnit.Local.Result].carrier = AtUnit.theorem ;
nilpotent-localisation : Tr1.Trunc[AtNilpotent.Local.Result].carrier = AtNilpotent.flat-theorem ;
zero-localisation : Tr1.Trunc[AtZero.NoGenerators.Result].carrier = AtZero.empty-presentation ;
nonreduced-redundant : Tr1.Trunc[AtUnit.Redundant.Result].carrier = AtUnit.redundant-theorem ;
public-nilpotent : Tr1.Trunc[AtNilpotent.Public.Result].carrier = AtNilpotent.public-flat ;

-- Any standard algebra (R[T]/(Q))[1/(aux Q')], Q arbitrary (for example
-- t T - 1, which presents R[1/t] by a non-integral generator), is fed
-- through BasicStandard at its own generator, with no monic relation.
module StandardInput (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 module Given (Q aux : B.Carrier) (LQ cs : List R.R) (hQ : Id B.Carrier (B.include LQ) Q)
  (rep : Id B.Carrier (B.include cs) SE.Points[Q,aux].g) {
  module SA = StandardAlgebra[l].Over[R,setR].Build[Q,aux,LQ,cs,hQ,rep] ;
  E : C.Algebra = SA.S ; y : E.ring.R = SA.point.1 ;
  module Fr = PolynomialFractions[l].Over[R,setR].At[E,y,B.include cs] ;
  module Etale = StandardEtaleLift[l].Over[R,setR].At[Q,aux,E,SA.standard] ;
  unit : RL[E.ring].unit Fr.g = subst (RL[E.ring].unit) (sym (ap Fr.X.value rep)) SA.point.2.2 ;
  convert (e : E.ring.R) (w : SA.Fr.Fraction e) : Fr.Fraction e =
   (w.1,w.2.1,trans (sym w.2.2)
    (trans (E.ring.mulC e (Fr.Pow.power SA.Fr.g w.2.1))
     (ap (\ a -> E.ring.mul (Fr.Pow.power a w.2.1) e) (sym (ap Fr.X.value rep))))) ;
  full (e : E.ring.R) : Tr.Trunc[Fr.Fraction e].carrier =
   TruncationCombinators[l].map (SA.Fr.Fraction e) (Fr.Fraction e) (convert e) (SA.full e) ;
  module New = BasicStandard[l].Over[R,setR,cs].At[E,SA.Loc.pres,SA.Loc.K.presentation,y,unit,full,Etale.unique] ;
  theorem : Tr1.Trunc[New.Result].carrier = New.Smooth[Etale.lift].theorem ;
  simple-relation : Tr.Trunc[New.SR.Relation].carrier = New.simple-relation ;
 } ;
} ;
