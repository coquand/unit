-- Public endpoint: monogenic by fractions gives a basic standard chart.
--
-- Statement.  Let E be finitely presented (merely) and formally etale
-- over R (or flat and formally unramified), y in E, G in R[T], and every
-- e in E merely A(y)/G(y)^n.  Then, merely,
--     E[1/G(y)] = (R[T]/(H))[1/D]
-- with H, D in R[T] and D a multiple of H', as the existing algebra
-- universal property StandardEtale.Points[H,D].Standard.  No integral
-- equation for y and no monic H is required.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Tr1 = Truncation[l+] ;
module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (cs : List R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module FE = FormallyEtale[l].Over[R,setR] ; module SE = StandardEtale[l].Over[R,setR] ; module B = SE.RX ;
 module PF = PolynomialFractions[l].Over[R,setR] ;
 module I = AffineInterface[l].Over[R,setR] ; G : B.Carrier = B.include cs ;
 module At (E : C.Algebra) (y : E.ring.R) (full : PF.At[E,y,G].Full) (unique : FE.Unique E) {
  module X = SE.At[E.ring,E.set,E.iota,y] ;
  Result : U l+ = (loc : I.LocalizationWitness E (X.value G)) * (coefficients : List R.R) *
   (denominator : B.Carrier) * SE.Points[B.include coefficients,denominator].Standard loc.1 ;
  module Presented (p : P.Presentation) (pe : P.Presents p E) {
   module Local = LocalBasicStandard[l].Over[R,setR,cs].At[E,p,pe,y,full,unique] ;
   theorem (smooth : FE.Lift E) : Tr1.Trunc[Result].carrier = Local.theorem smooth ;
  } ;
  theorem (fp : P.FP E) (smooth : FE.Lift E) : Tr1.Trunc[Result].carrier =
   Tr1.Trunc[P.Witness E].induction @l+ (\ p -> Tr1.Trunc[Result].carrier) (\ p -> Tr1.Trunc[Result].proposition)
    (\ p -> Presented[p.1,p.2].theorem smooth) fp ;
  flat-theorem (fp : P.FP E) (flat : FlatRelations[l].Over[R,E.ring,E.iota].Flat) : Tr1.Trunc[Result].carrier =
   theorem fp FlatUnramifiedEtale[l].Over[R,setR].At[E,fp,unique,flat].lift ;
 } ;
} ;
