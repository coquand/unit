-- The image of a block sum is the sum of the images (PROJECTORS):
--     Image (dsum p q) ~ Image p + Image q,   w |-> (w_l, w_r),
-- since dsum p q acts by parts (DIRECTSUMS); the inverse is catv.  The
-- image of the zero projector has a single element.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module PJ = Projectors[l].Over[A,setA] ;
 module MI = PJ.MI ;
 module SumImage (p q : PJ.Projector) {
  module PQ = PJ.Sum[p,q] ;
  module DS = PQ.DS ;
  module IS = PJ.Image[PQ.projector] ;
  module IP = PJ.Image[p] ;
  module IQ = PJ.Image[q] ;
  module T = SP.Pair[A,IP.image,IQ.image] ;
  left-member (w : IS.Carrier) : IP.Member (DS.lpart (IS.value w)) =
   DS.Vm.vec-eq _ _ (\ i -> trans (sym (DS.act-l p.matrix q.matrix (IS.value w) i)) (DS.V2.entry _ _ (IS.member w) (DS.il i))) ;
  right-member (w : IS.Carrier) : IQ.Member (DS.rpart (IS.value w)) =
   DS.Vn.vec-eq _ _ (\ i -> trans (sym (DS.act-r p.matrix q.matrix (IS.value w) i)) (DS.V2.entry _ _ (IS.member w) (DS.ir i))) ;
  parts (w : IS.Carrier) : T.Carrier = ((DS.lpart (IS.value w),left-member w),(DS.rpart (IS.value w),right-member w)) ;
  module Join (y : T.Carrier) {
   u : DS.Vm.Vec = IP.value y.1 ;
   v : DS.Vn.Vec = IQ.value y.2 ;
   member : IS.Member (DS.catv u v) =
    DS.Parts[DS.V2.act PQ.projector.matrix (DS.catv u v),DS.catv u v,
     \ i -> trans (DS.act-l p.matrix q.matrix (DS.catv u v) i)
      (trans (ap (\ t -> DS.Vm.act p.matrix t i) (DS.lpart-catv u v))
       (trans (DS.Vm.entry _ _ (IP.member y.1) i) (sym (DS.catv-l u v i)))),
     \ i -> trans (DS.act-r p.matrix q.matrix (DS.catv u v) i)
      (trans (ap (\ t -> DS.Vn.act q.matrix t i) (DS.rpart-catv u v))
       (trans (DS.Vn.entry _ _ (IQ.member y.2) i) (sym (DS.catv-r u v i))))].equal ;
   point : IS.Carrier = (DS.catv u v,member) ;
  } ;
  iso : MI.Iso[IS.image,T.product] = MI.make IS.image T.product parts (\ y -> Join[y].point)
   (\ w w' -> T.ext _ _ (IP.ext _ _ (refl (DS.lpart (DS.V2.vadd (IS.value w) (IS.value w')))))
     (IQ.ext _ _ (refl (DS.rpart (DS.V2.vadd (IS.value w) (IS.value w'))))))
   (\ a w -> T.ext _ _ (IP.ext _ _ (refl (DS.lpart (DS.V2.vscale a (IS.value w)))))
     (IQ.ext _ _ (refl (DS.rpart (DS.V2.vscale a (IS.value w))))))
   (\ y -> T.ext _ _ (IP.ext _ _ (DS.lpart-catv (IP.value y.1) (IQ.value y.2))) (IQ.ext _ _ (DS.rpart-catv (IP.value y.1) (IQ.value y.2))))
   (\ w -> IS.ext _ _ (DS.catv-parts (IS.value w))) ;
 } ;
 module IZ = PJ.Image[PJ.zeroP] ;
 zero-single : MI.Single IZ.image = \ x -> IZ.ext x IZ.zero (IZ.V.vec-eq _ _ (\ i -> efq i)) ;
} ;
