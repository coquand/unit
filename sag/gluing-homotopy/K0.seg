-- K_0(A) in the projector model.  Projectors (PROJECTORS) with block sum,
-- Kronecker product, the zero and the unit projector form a commutative
-- semiring up to "the images are isomorphic" (merely):
--  congruence  Image (dsum p q) ~ Image p + Image q (PROJECTORSUMS), and
--              Image (p (x) q) ~ Image p (x) q (TWIST) is functorial in
--              Image p; in the second factor by commutativity;
--  laws        + : associativity and commutativity of sums of modules,
--                  Image 0 has a single element;
--              * : SWAP and ASSOC of PROJECTORREINDEX; P (x) 1 ~ P,
--                  P (x) 0 has a single element, P (x) dsum q r ~
--                  P (x) q + P (x) r (TWIST).
-- K_0(A) is the Grothendieck ring (GROTHENDIECK) of its quotient (SEMIRING).
-- Projectors with isomorphic images have the same class, and classes are
-- additive and multiplicative.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module PJ = Projectors[l].Over[A,setA] ;
 module MI = PJ.MI ;
 module PSm = ProjectorSums[l].Over[A,setA] ;
 module RX = ProjectorReindex[l].Over[A,setA] ;
 module TW = Twist[l].Over[A,setA] ;
 Projector : U l = PJ.Projector ;
 image (p : Projector) : PJ.SA.Module = PJ.Image[p].image ;
 sum (p q : Projector) : Projector = PJ.Sum[p,q].projector ;
 product (p q : Projector) : Projector = PJ.Product[p,q].projector ;
 Iso (p q : Projector) : U l = MI.Iso[image p,image q] ;
 Rel (p q : Projector) : U l = Tr.Trunc[Iso p q].carrier ;
 rel-prop (p q : Projector) : Pr.isProp (Rel p q) = Tr.Trunc[Iso p q].proposition ;
 related (p q : Projector) (e : Iso p q) : Rel p q = Tr.Trunc[Iso p q].inc e ;
 rel-refl (p : Projector) : Rel p p = related p p (MI.identity (image p)) ;
 rel-sym (p q : Projector) (h : Rel p q) : Rel q p = TC.map (Iso p q) (Iso q p) (MI.inverse (image p) (image q)) h ;
 rel-trans (p q r : Projector) (h : Rel p q) (k : Rel q r) : Rel p r =
  TC.map2 (Iso p q) (Iso q r) (Iso p r) (MI.compose (image p) (image q) (image r)) h k ;

 -- isomorphisms of images for the operations
 sum-iso (p p' q q' : Projector) (e : Iso p p') (f : Iso q q') : Iso (sum p q) (sum p' q') =
  MI.compose (image (sum p q)) PSm.SumImage[p,q].T.product (image (sum p' q')) PSm.SumImage[p,q].iso
   (MI.compose PSm.SumImage[p,q].T.product PSm.SumImage[p',q'].T.product (image (sum p' q'))
    (MI.Sum[image p,image p',image q,image q',e,f].sum)
    (MI.inverse (image (sum p' q')) PSm.SumImage[p',q'].T.product PSm.SumImage[p',q'].iso)) ;
 left-iso (p p' q : Projector) (e : Iso p p') : Iso (product p q) (product p' q) =
  MI.compose (image (product p q)) TW.Of[image p,q].twisted (image (product p' q)) TW.ImageOf[p,q].iso
   (MI.compose TW.Of[image p,q].twisted TW.Of[image p',q].twisted (image (product p' q)) TW.Map[image p,image p',q,e].iso
    (MI.inverse (image (product p' q)) TW.Of[image p',q].twisted TW.ImageOf[p',q].iso)) ;
 swap-iso (p q : Projector) : Iso (product p q) (product q p) = RX.Swap[p,q].iso ;
 right-iso (p q q' : Projector) (e : Iso q q') : Iso (product p q) (product p q') =
  MI.compose (image (product p q)) (image (product q p)) (image (product p q')) (swap-iso p q)
   (MI.compose (image (product q p)) (image (product q' p)) (image (product p q')) (left-iso q q' p e) (swap-iso q' p)) ;
 add-cong (p p' q q' : Projector) (h : Rel p p') (k : Rel q q') : Rel (sum p q) (sum p' q') =
  TC.map2 (Iso p p') (Iso q q') (Iso (sum p q) (sum p' q')) (sum-iso p p' q q') h k ;
 mul-cong (p p' q q' : Projector) (h : Rel p p') (k : Rel q q') : Rel (product p q) (product p' q') =
  TC.map2 (Iso p p') (Iso q q') (Iso (product p q) (product p' q'))
   (\ e f -> MI.compose (image (product p q)) (image (product p' q)) (image (product p' q')) (left-iso p p' q e) (right-iso p' q q' f)) h k ;

 -- the laws
 add-assoc (p q r : Projector) : Rel (sum p (sum q r)) (sum (sum p q) r) = related _ _
  (MI.compose (image (sum p (sum q r))) PSm.SumImage[p,sum q r].T.product (image (sum (sum p q) r)) PSm.SumImage[p,sum q r].iso
   (MI.compose PSm.SumImage[p,sum q r].T.product MI.Assoc[image p,image q,image r].R.product (image (sum (sum p q) r))
    (MI.Sum[image p,image p,image (sum q r),MI.Assoc[image p,image q,image r].NP.product,MI.identity (image p),PSm.SumImage[q,r].iso].sum)
    (MI.compose MI.Assoc[image p,image q,image r].R.product MI.Assoc[image p,image q,image r].L.product (image (sum (sum p q) r))
     (MI.inverse MI.Assoc[image p,image q,image r].L.product MI.Assoc[image p,image q,image r].R.product MI.Assoc[image p,image q,image r].iso)
     (MI.compose MI.Assoc[image p,image q,image r].L.product PSm.SumImage[sum p q,r].T.product (image (sum (sum p q) r))
      (MI.Sum[MI.Assoc[image p,image q,image r].MN.product,image (sum p q),image r,image r,
        MI.inverse (image (sum p q)) MI.Assoc[image p,image q,image r].MN.product PSm.SumImage[p,q].iso,MI.identity (image r)].sum)
      (MI.inverse (image (sum (sum p q) r)) PSm.SumImage[sum p q,r].T.product PSm.SumImage[sum p q,r].iso))))) ;
 add-comm (p q : Projector) : Rel (sum p q) (sum q p) = related _ _
  (MI.compose (image (sum p q)) PSm.SumImage[p,q].T.product (image (sum q p)) PSm.SumImage[p,q].iso
   (MI.compose PSm.SumImage[p,q].T.product PSm.SumImage[q,p].T.product (image (sum q p)) MI.Swap[image p,image q].iso
    (MI.inverse (image (sum q p)) PSm.SumImage[q,p].T.product PSm.SumImage[q,p].iso))) ;
 add-zero (p : Projector) : Rel (sum p PJ.zeroP) p = related _ _
  (MI.compose (image (sum p PJ.zeroP)) PSm.SumImage[p,PJ.zeroP].T.product (image p) PSm.SumImage[p,PJ.zeroP].iso
   MI.ZeroRight[image p,image PJ.zeroP,PSm.zero-single].iso) ;
 mul-assoc (p q r : Projector) : Rel (product p (product q r)) (product (product p q) r) = related _ _
  (MI.inverse (image (product (product p q) r)) (image (product p (product q r))) RX.Assoc[p,q,r].iso) ;
 mul-comm (p q : Projector) : Rel (product p q) (product q p) = related _ _ (swap-iso p q) ;
 mul-one (p : Projector) : Rel (product p PJ.oneP) p = related _ _
  (MI.compose (image (product p PJ.oneP)) TW.Of[image p,PJ.oneP].twisted (image p) TW.ImageOf[p,PJ.oneP].iso TW.UnitOf[image p].iso) ;
 mul-dist (p q r : Projector) : Rel (product p (sum q r)) (sum (product p q) (product p r)) = related _ _
  (MI.compose (image (product p (sum q r))) TW.Of[image p,sum q r].twisted (image (sum (product p q) (product p r))) TW.ImageOf[p,sum q r].iso
   (MI.compose TW.Of[image p,sum q r].twisted TW.SumOf[image p,q,r].Pair.product (image (sum (product p q) (product p r))) TW.SumOf[image p,q,r].iso
    (MI.compose TW.SumOf[image p,q,r].Pair.product PSm.SumImage[product p q,product p r].T.product (image (sum (product p q) (product p r)))
     (MI.Sum[TW.Of[image p,q].twisted,image (product p q),TW.Of[image p,r].twisted,image (product p r),
       MI.inverse (image (product p q)) TW.Of[image p,q].twisted TW.ImageOf[p,q].iso,
       MI.inverse (image (product p r)) TW.Of[image p,r].twisted TW.ImageOf[p,r].iso].sum)
     (MI.inverse (image (sum (product p q) (product p r))) PSm.SumImage[product p q,product p r].T.product
      PSm.SumImage[product p q,product p r].iso)))) ;
 mul-zero (p : Projector) : Rel (product p PJ.zeroP) PJ.zeroP = related _ _
  (MI.compose (image (product p PJ.zeroP)) TW.Of[image p,PJ.zeroP].twisted (image PJ.zeroP) TW.ImageOf[p,PJ.zeroP].iso
   MI.Singles[TW.Of[image p,PJ.zeroP].twisted,image PJ.zeroP,TW.zero-single (image p),PSm.zero-single].iso) ;

 -- the semiring of iso classes and its Grothendieck ring
 module SR = Semiring[l].FromCongruence[Projector,PJ.zeroP,PJ.oneP,sum,product,Rel,rel-prop,rel-refl,rel-sym,rel-trans,
  add-cong,mul-cong,add-assoc,add-comm,add-zero,mul-assoc,mul-comm,mul-one,mul-dist,mul-zero] ;
 module G = Grothendieck[l].Over[SR.semiring] ;
 K0 : CRing = G.ring ;
 class (p : Projector) : K0.R = G.class (SR.class p) ;
 class-sum (p q : Projector) : Id K0.R (K0.add (class p) (class q)) (class (sum p q)) =
  trans (G.class-add (SR.class p) (SR.class q)) (ap G.class (SR.add2 p q)) ;
 class-product (p q : Projector) : Id K0.R (K0.mul (class p) (class q)) (class (product p q)) =
  trans (G.class-mul (SR.class p) (SR.class q)) (ap G.class (SR.mul2 p q)) ;
 class-one : Id K0.R K0.o (class PJ.oneP) = G.class-one ;
 -- projectors with isomorphic images have the same class
 class-iso (p q : Projector) (e : Iso p q) : Id K0.R (class p) (class q) = ap G.class (SR.Q.relates p q (related p q e)) ;
 -- two projectors presenting the same module
 module Presenting (P : PJ.SA.Module) (p q : Projector) (e : MI.Iso[image p,P]) (f : MI.Iso[image q,P]) {
  same : Id K0.R (class p) (class q) = class-iso p q (MI.compose (image p) P (image q) e (MI.inverse (image q) P f)) ;
 } ;
} ;
