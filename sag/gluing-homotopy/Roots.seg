-- gabber-recollement.tex, Lemma `roots`.  Let f be a projector over A of
-- constant rank N on a cover: s_1 .. s_k comaximal and mu = [f] - N
-- restricting to 0 in each K_0(A_(s_i)).  If rho(f)^n = 1 in
-- K = K_0(A) (x) Q (RATIONAL), with rho(f) = [f]/N, then rho(f) = 1.
--
-- Proof.  mu is nilpotent (NILPOTENCE), hence so is t = mu/N in K, and
-- rho(f) = 1 + t.  By the expansion (1 + t)^n = 1 + t (n + t q) we get
-- t (n + t q) = 0, and n + t q is a unit (n is a unit, t q is nilpotent),
-- so t = 0.  (This is the paper's argument, with LQ X.5.5 replaced by
-- NILPOTENCE for classes of constant rank on a cover.)
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module K = K0[l].Over[A,setA] ;
 module PJ = K.PJ ;
 module IK = Rational[l].Integers[K.K0] ;
 module RQ = Rational[l].Over[K.K0] ;
 module IQ = Rational[l].Integers[RQ.K] ;
 module LQ = RL[RQ.K] ;
 module PQ = AffinePowers[l].Over[RQ.K] ;
 module PK = AffinePowers[l].Over[K.K0] ;
 module NM = Rational[l].NatMap[K.K0,RQ.K,RQ.iota] ;
 iota (u : K.K0.R) : RQ.K.R = RQ.iota.1 u ;
 module Lemma (f : PJ.Projector) (N0 n0 : Nat) (k : Nat) (cv : Nilpotence[l].Cover A k)
  (hv : (i : Fin k) -> Nilpotence[l].Vanishes A setA (cv.1 i) (K.K0.add (K.class f) (K.K0.neg (IK.nat (suc N0)))))
  (hr : Id RQ.K.R (PQ.power (RQ.rho (K.class f) (IK.nat (suc N0)) (RQ.positive N0)) (suc n0)) RQ.K.o) {
  N : Nat = suc N0 ;
  n : Nat = suc n0 ;
  mu : K.K0.R = K.K0.add (K.class f) (K.K0.neg (IK.nat N)) ;
  rho-f : RQ.K.R = RQ.rho (K.class f) (IK.nat N) (RQ.positive N0) ;
  invN : RQ.K.R = RQ.inverse (IK.nat N) (RQ.positive N0) ;
  t : RQ.K.R = RQ.K.mul (iota mu) invN ;
  -- rho(f) = 1 + t
  t-eq : Id RQ.K.R t (RQ.K.add rho-f (RQ.K.neg RQ.K.o)) =
   calc RQ.K.R { RQ.K.mul (iota mu) invN
     =< ap (\ w -> RQ.K.mul w invN) (trans (RQ.iota.2.2.1 (K.class f) (K.K0.neg (IK.nat N)))
         (ap (RQ.K.add (iota (K.class f))) (H.negation K.K0 RQ.K RQ.iota (IK.nat N)))) >
        RQ.K.mul (RQ.K.add (iota (K.class f)) (RQ.K.neg (iota (IK.nat N)))) invN
     =< LQ.dist-left (iota (K.class f)) (RQ.K.neg (iota (IK.nat N))) invN >
        RQ.K.add rho-f (RQ.K.mul (RQ.K.neg (iota (IK.nat N))) invN)
     =< ap (RQ.K.add rho-f) (trans (LQ.neg-mul-left (iota (IK.nat N)) invN) (ap RQ.K.neg (RQ.inverse-law (IK.nat N) (RQ.positive N0)))) >
        RQ.K.add rho-f (RQ.K.neg RQ.K.o) } ;
  rho-split : Id RQ.K.R rho-f (RQ.K.add RQ.K.o t) =
   sym (trans (ap (RQ.K.add RQ.K.o) t-eq)
    (trans (LQ.add-swap RQ.K.o rho-f (RQ.K.neg RQ.K.o)) (trans (ap (RQ.K.add rho-f) (RQ.K.addN RQ.K.o)) (RQ.K.addZ rho-f)))) ;
  module E = IQ.Expand[t] ;
  -- t P_n = 0
  kills : Id RQ.K.R (RQ.K.mul t (E.P n)) RQ.K.z =
   calc RQ.K.R { RQ.K.mul t (E.P n)
     =< sym (LQ.add-neg-cancel (RQ.K.mul t (E.P n)) RQ.K.o) >
        RQ.K.add (RQ.K.add (RQ.K.mul t (E.P n)) RQ.K.o) (RQ.K.neg RQ.K.o)
     =< ap (\ w -> RQ.K.add w (RQ.K.neg RQ.K.o)) (RQ.K.addC (RQ.K.mul t (E.P n)) RQ.K.o) >
        RQ.K.add (RQ.K.add RQ.K.o (RQ.K.mul t (E.P n))) (RQ.K.neg RQ.K.o)
     =< ap (\ w -> RQ.K.add w (RQ.K.neg RQ.K.o))
         (trans (sym (E.power-P n)) (trans (ap (\ w -> PQ.power w n) (sym rho-split)) hr)) >
        RQ.K.add RQ.K.o (RQ.K.neg RQ.K.o)
     =< RQ.K.addN RQ.K.o > RQ.K.z } ;
  module With (m : Nat) (hm : Id K.K0.R (PK.power mu m) K.K0.z) {
   t-power : Id RQ.K.R (PQ.power t m) RQ.K.z =
    calc RQ.K.R { PQ.power t m
      =< PQ.power-mul (iota mu) invN m > RQ.K.mul (PQ.power (iota mu) m) (PQ.power invN m)
      =< ap (\ w -> RQ.K.mul w (PQ.power invN m))
          (trans (sym (AffinePowers[l].power-map K.K0 RQ.K RQ.iota mu m)) (trans (ap iota hm) (H.zero K.K0 RQ.K RQ.iota))) >
         RQ.K.mul RQ.K.z (PQ.power invN m)
      =< LQ.zero-mul (PQ.power invN m) > RQ.K.z } ;
   v : RQ.K.R = RQ.K.mul t (E.q n) ;
   v-power : Id RQ.K.R (PQ.power v m) RQ.K.z =
    trans (PQ.power-mul t (E.q n) m) (trans (ap (\ w -> RQ.K.mul w (PQ.power (E.q n) m)) t-power) (LQ.zero-mul (PQ.power (E.q n) m))) ;
   -- P_n = n + t q is a unit
   P-eq : Id RQ.K.R (E.P n) (RQ.K.add (iota (IK.nat n)) v) =
    trans (E.P-split n) (ap (\ w -> RQ.K.add w v) (sym (NM.nat-map n))) ;
   module UP = IQ.UnitPlus[iota (IK.nat n),v,RQ.unit (IK.nat n) (RQ.positive n0),m,v-power] ;
   P-unit : LQ.unit (E.P n) = (UP.unit.1,trans (ap (\ w -> RQ.K.mul w UP.unit.1) P-eq) UP.unit.2) ;
   t-zero : Id RQ.K.R t RQ.K.z = LQ.unit-reg (E.P n) t P-unit (trans (RQ.K.mulC (E.P n) t) kills) ;
   theorem : Id RQ.K.R rho-f RQ.K.o = trans rho-split (trans (ap (RQ.K.add RQ.K.o) t-zero) (RQ.K.addZ RQ.K.o)) ;
  } ;
  theorem : Id RQ.K.R rho-f RQ.K.o =
   TC.rec ((m : Nat) * Id K.K0.R (PK.power mu m) K.K0.z) @l (Id RQ.K.R rho-f RQ.K.o) (RQ.Q.set _ _)
    (\ w -> With[w.1,w.2].theorem) (Nilpotence[l].nil k A setA cv mu hv) ;
 } ;
} ;
