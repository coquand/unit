-- gabber-recollement.tex, Lemma 3.6(1), in K_0(A) (K0).  In the situation
-- of STABLESUM, let g, g' and h, h' be inverse M x M matrices over C, and
-- p, q, s projectors presenting P_g, P_h and P_gh.  Then
--     [p] + [q] = [s] + [A^M].
--
-- Proof.  P_g + P_h ~ P_gh + A^M merely (STABLESUM), so
--     Image (p + q) ~ Image p + Image q ~ P_g + P_h            (PROJECTORSUMS)
--                   ~ P_gh + A^M ~ Image s + Image 1_M ~ Image (s + 1_M),
-- and [p] + [q] = [p + q] = [s + 1_M] = [s] + [A^M]; the equation is a
-- proposition, so the mere isomorphism suffices.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (M : Nat) {
 module SS = StableSum[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,M] ;
 module K = K0[l].Over[A,setA] ;
 module G1 = SS.G1 ;
 module MI = SS.MI ;
 module PSm = K.PSm ;
 module FR = K.PJ.Free[M] ;
 module MC = SS.D.MC ;
 module IM = SS.D.IM ;
 module Cj = Conjugation[l].Over[C,setC,M] ;
 module GPM = GluedProjector[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,M] ;
 module Lemma (g g' : SS.D.MC.Mat) (gi : SS.D.IM.Inverse[g,g']) (h h' : SS.D.MC.Mat) (hi : SS.D.IM.Inverse[h,h'])
  (p q s : K.Projector) (ep : MI.Iso[K.image p,G1.Glue[g].glued]) (eq : MI.Iso[K.image q,G1.Glue[h].glued])
  (es : MI.Iso[K.image s,G1.Glue[SS.D.MC.mmul g h].glued]) {
  module L = SS.Lemma[g,g',gi,h,h',hi] ;
  -- Image (p + q) ~ P_g + P_h
  source : MI.Iso[K.image (K.sum p q),L.Source] =
   MI.compose (K.image (K.sum p q)) PSm.SumImage[p,q].T.product L.Source PSm.SumImage[p,q].iso
    (MI.Sum[K.image p,G1.Glue[g].glued,K.image q,G1.Glue[h].glued,ep,eq].sum) ;
  -- P_gh + A^M ~ Image (s + 1_M)
  target : MI.Iso[L.Target,K.image (K.sum s FR.projector)] =
   MI.compose L.Target PSm.SumImage[s,FR.projector].T.product (K.image (K.sum s FR.projector))
    (MI.Sum[L.Pgh.glued,K.image s,SS.GF.free,K.image FR.projector,
      MI.inverse (K.image s) L.Pgh.glued es,MI.inverse (K.image FR.projector) SS.GF.free FR.iso].sum)
    (MI.inverse (K.image (K.sum s FR.projector)) PSm.SumImage[s,FR.projector].T.product PSm.SumImage[s,FR.projector].iso) ;
  module At (e : MI.Iso[L.Source,L.Target]) {
   equation : Id K.K0.R (K.K0.add (K.class p) (K.class q)) (K.K0.add (K.class s) (K.free M)) =
    calc K.K0.R { K.K0.add (K.class p) (K.class q)
      =< K.class-sum p q > K.class (K.sum p q)
      =< K.class-iso (K.sum p q) (K.sum s FR.projector)
          (MI.compose (K.image (K.sum p q)) L.Source (K.image (K.sum s FR.projector)) source
           (MI.compose L.Source L.Target (K.image (K.sum s FR.projector)) e target)) > K.class (K.sum s FR.projector)
      =< sym (K.class-sum s FR.projector) > K.K0.add (K.class s) (K.free M) } ;
  } ;
  theorem : Id K.K0.R (K.K0.add (K.class p) (K.class q)) (K.K0.add (K.class s) (K.free M)) =
   TC.rec (MI.Iso[L.Source,L.Target]) @l (Id K.K0.R (K.K0.add (K.class p) (K.class q)) (K.K0.add (K.class s) (K.free M)))
    (K.G.set _ _) (\ e -> At[e].equation) L.theorem ;
 } ;

 -- powers: g^0 = 1, g^(j+1) = g^j g; the inverse of g^j is (g')^j taken from the left
 power (g : MC.Mat) : (j : Nat) -> MC.Mat = split {
  zero -> MC.mone ;
  suc j | r -> MC.mmul r g } ;
 copower (g' : MC.Mat) : (j : Nat) -> MC.Mat = split {
  zero -> MC.mone ;
  suc j | r -> MC.mmul g' r } ;
 power-inverse (g g' : MC.Mat) (gi : IM.Inverse[g,g']) : (j : Nat) -> IM.Inverse[power g j,copower g' j] = split {
  zero -> new IM.Inverse[MC.mone,MC.mone,MC.m-one-left MC.mone,MC.m-one-left MC.mone] ;
  suc j | r -> new IM.Inverse[MC.mmul (power g j) g,MC.mmul g' (copower g' j),
   Cj.sandwich (power g j) (copower g' j) g' g r.right gi.right,
   Cj.sandwich g' g (power g j) (copower g' j) gi.left r.left] } ;
 -- the second sentence of Lemma 3.6(1): [P_(g^j)] = j [P_g] - (j - 1) M for j in Z,
 -- as  [P_(g^j)] + j M = j [P_g] + M  and  [P_(g'^j)] + j [P_g] = (j + 1) M  (j in N)
 module Powers (g g' : MC.Mat) (gi : IM.Inverse[g,g']) (q : K.Projector) (eq : MI.Iso[K.image q,G1.Glue[g].glued]) {
  gi' : IM.Inverse[g',g] = new IM.Inverse[g',g,gi.left,gi.right] ;
  Positive (j : Nat) : U l = (r : K.Projector) -> MI.Iso[K.image r,G1.Glue[power g j].glued] ->
   Id K.K0.R (K.K0.add (K.class r) (K.multiple j (K.free M))) (K.K0.add (K.multiple j (K.class q)) (K.free M)) ;
  Negative (j : Nat) : U l = (r : K.Projector) -> MI.Iso[K.image r,G1.Glue[power g' j].glued] ->
   Id K.K0.R (K.K0.add (K.class r) (K.multiple j (K.class q))) (K.multiple (suc j) (K.free M)) ;
  -- a projector presenting P_1 has the class of A^M
  unit (r : K.Projector) (er : MI.Iso[K.image r,G1.Glue[MC.mone].glued]) : Id K.K0.R (K.class r) (K.free M) =
   K.free-class M r (MI.compose (K.image r) G1.Glue[MC.mone].glued (K.PJ.FM.free M) er (MI.inverse SS.GF.free SS.GF.P1.glued SS.GF.iso)) ;
  -- with x + j f = j y + f (induction) and t + y = x' + f (Lemma 3.6(1)):
  -- x' + (j f + f) = (j y + f) + y
  module Rearrange (x x' y f u v : K.K0.R) (e1 : Id K.K0.R (K.K0.add x y) (K.K0.add x' f)) (e2 : Id K.K0.R (K.K0.add x u) v) {
   positive : Id K.K0.R (K.K0.add x' (K.K0.add u f)) (K.K0.add v y) =
    calc K.K0.R { K.K0.add x' (K.K0.add u f)
      =< ap (K.K0.add x') (K.K0.addC u f) > K.K0.add x' (K.K0.add f u)
      =< K.K0.addA x' f u > K.K0.add (K.K0.add x' f) u
      =< ap (\ w -> K.K0.add w u) (sym e1) > K.K0.add (K.K0.add x y) u
      =< sym (K.K0.addA x y u) > K.K0.add x (K.K0.add y u)
      =< ap (K.K0.add x) (K.K0.addC y u) > K.K0.add x (K.K0.add u y)
      =< K.K0.addA x u y > K.K0.add (K.K0.add x u) y
      =< ap (\ w -> K.K0.add w y) e2 > K.K0.add v y } ;
  } ;
  -- with x + y = x' + f (Lemma 3.6(1)) and x' + u = v (induction): x + (u + y) = v + f
  rearrange (x x' y f u v : K.K0.R) (e1 : Id K.K0.R (K.K0.add x y) (K.K0.add x' f)) (e2 : Id K.K0.R (K.K0.add x' u) v) :
   Id K.K0.R (K.K0.add x (K.K0.add u y)) (K.K0.add v f) =
   calc K.K0.R { K.K0.add x (K.K0.add u y)
     =< ap (K.K0.add x) (K.K0.addC u y) > K.K0.add x (K.K0.add y u)
     =< K.K0.addA x y u > K.K0.add (K.K0.add x y) u
     =< ap (\ w -> K.K0.add w u) e1 > K.K0.add (K.K0.add x' f) u
     =< sym (K.K0.addA x' f u) > K.K0.add x' (K.K0.add f u)
     =< ap (K.K0.add x') (K.K0.addC f u) > K.K0.add x' (K.K0.add u f)
     =< K.K0.addA x' u f > K.K0.add (K.K0.add x' u) f
     =< ap (\ w -> K.K0.add w f) e2 > K.K0.add v f } ;
  -- the steps
  module Up (j : Nat) (ih : Positive j) (r : K.Projector) (er : MI.Iso[K.image r,G1.Glue[power g (suc j)].glued])
   (t : GPM.Explicit[power g j,copower g' j,power-inverse g g' gi j].Presented) {
   -- [P_(g^j)] + [P_g] = [P_(g^(j+1))] + M
   sum : Id K.K0.R (K.K0.add (K.class t.1) (K.class q)) (K.K0.add (K.class r) (K.free M)) =
    Lemma[power g j,copower g' j,power-inverse g g' gi j,g,g',gi,t.1,q,r,t.2,eq,er].theorem ;
   equation : Id K.K0.R (K.K0.add (K.class r) (K.multiple (suc j) (K.free M))) (K.K0.add (K.multiple (suc j) (K.class q)) (K.free M)) =
    trans (Rearrange[K.class t.1,K.class r,K.class q,K.free M,K.multiple j (K.free M),
      K.K0.add (K.multiple j (K.class q)) (K.free M),sum,ih t.1 t.2].positive)
     (trans (sym (K.K0.addA (K.multiple j (K.class q)) (K.free M) (K.class q)))
      (trans (ap (K.K0.add (K.multiple j (K.class q))) (K.K0.addC (K.free M) (K.class q)))
       (K.K0.addA (K.multiple j (K.class q)) (K.class q) (K.free M)))) ;
  } ;
  -- g'^(j+1) g = g'^j
  back (j : Nat) : Id MC.Mat (power g' j) (MC.mmul (power g' (suc j)) g) =
   sym (trans (sym (MC.m-mulA (power g' j) g' g)) (trans (ap (MC.mmul (power g' j)) gi.left) (MC.m-one-right (power g' j)))) ;
  module Down (j : Nat) (ih : Negative j) (r : K.Projector) (er : MI.Iso[K.image r,G1.Glue[power g' (suc j)].glued])
   (t : GPM.Explicit[power g' j,copower g j,power-inverse g' g gi' j].Presented) {
   -- [P_(g'^(j+1))] + [P_g] = [P_(g'^j)] + M
   sum : Id K.K0.R (K.K0.add (K.class r) (K.class q)) (K.K0.add (K.class t.1) (K.free M)) =
    Lemma[power g' (suc j),copower g (suc j),power-inverse g' g gi' (suc j),g,g',gi,r,q,t.1,er,eq,
     MI.compose (K.image t.1) G1.Glue[power g' j].glued G1.Glue[MC.mmul (power g' (suc j)) g].glued t.2
      G1.Equal[MC.mmul (power g' (suc j)) g,power g' j,back j].iso].theorem ;
   equation : Id K.K0.R (K.K0.add (K.class r) (K.multiple (suc j) (K.class q))) (K.multiple (suc (suc j)) (K.free M)) =
    rearrange (K.class r) (K.class t.1) (K.class q) (K.free M) (K.multiple j (K.class q))
     (K.multiple (suc j) (K.free M)) sum (ih t.1 t.2) ;
  } ;
  positive : (j : Nat) -> Positive j = split {
   zero -> \ r er -> trans (K.K0.addZ (K.class r)) (trans (unit r er) (sym (RL[K.K0].zl (K.free M)))) ;
   suc j | ih -> \ r er -> TC.rec GPM.Explicit[power g j,copower g' j,power-inverse g g' gi j].Presented @l
    (Id K.K0.R (K.K0.add (K.class r) (K.multiple (suc j) (K.free M))) (K.K0.add (K.multiple (suc j) (K.class q)) (K.free M)))
    (K.G.set _ _) (\ t -> Up[j,ih,r,er,t].equation) GPM.Explicit[power g j,copower g' j,power-inverse g g' gi j].theorem } ;
  negative : (j : Nat) -> Negative j = split {
   zero -> \ r er -> trans (K.K0.addZ (K.class r)) (trans (unit r er) (sym (RL[K.K0].zl (K.free M)))) ;
   suc j | ih -> \ r er -> TC.rec GPM.Explicit[power g' j,copower g j,power-inverse g' g gi' j].Presented @l
    (Id K.K0.R (K.K0.add (K.class r) (K.multiple (suc j) (K.class q))) (K.multiple (suc (suc j)) (K.free M)))
    (K.G.set _ _) (\ t -> Down[j,ih,r,er,t].equation) GPM.Explicit[power g' j,copower g j,power-inverse g' g gi' j].theorem } ;
 } ;
} ;
