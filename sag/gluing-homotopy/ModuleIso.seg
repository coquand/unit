-- Isomorphisms of A-modules (SERREMODULE): a linear map (SERREMODULEMAPS,
-- over the identity of A) with an inverse map.  The inverse is linear:
--     inv (x + y) = inv (f (inv x + inv y)) = inv x + inv y,
-- since f (inv x + inv y) = x + y; likewise for scalars.  Isomorphisms
-- compose, and two isomorphisms give one between the direct sums
-- (SERREMODULEPRODUCTS.Pair).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A : CRing) {
 module SA = SM.Over[A] ;
 module Lin (Md Nd : SA.Module) { module B = MM.Between[A,A,RingHom[l].identity A,Md,Nd] ; } ;
 record Iso (Md Nd : SA.Module) {
  hom : Lin[Md,Nd].B.Hom ;
  inv : Nd.M -> Md.M ;
  to-inv (y : Nd.M) : Id Nd.M (hom.fn (inv y)) y ;
  inv-to (x : Md.M) : Id Md.M (inv (hom.fn x)) x ;
 } ;
 to {Md Nd : SA.Module} (e : Iso[Md,Nd]) : Md.M -> Nd.M = e.hom.fn ;
 to-add {Md Nd : SA.Module} (e : Iso[Md,Nd]) (x y : Md.M) :
  Id Nd.M (to e (Md.madd x y)) (Nd.madd (to e x) (to e y)) = e.hom.additive x y ;
 to-scale {Md Nd : SA.Module} (e : Iso[Md,Nd]) (a : A.R) (x : Md.M) :
  Id Nd.M (to e (Md.sm a x)) (Nd.sm a (to e x)) = e.hom.scalar a x ;

 -- an isomorphism from its map, its inverse and the four laws
 make (Md Nd : SA.Module) (f : Md.M -> Nd.M) (g : Nd.M -> Md.M)
  (fadd : (x y : Md.M) -> Id Nd.M (f (Md.madd x y)) (Nd.madd (f x) (f y)))
  (fscale : (a : A.R) (x : Md.M) -> Id Nd.M (f (Md.sm a x)) (Nd.sm a (f x)))
  (fg : (y : Nd.M) -> Id Nd.M (f (g y)) y) (gf : (x : Md.M) -> Id Md.M (g (f x)) x) : Iso[Md,Nd] =
  new Iso[Md,Nd,new Lin[Md,Nd].B.Hom[f,fadd,fscale],g,fg,gf] ;

 identity (Md : SA.Module) : Iso[Md,Md] =
  make Md Md (\ x -> x) (\ x -> x) (\ x y -> refl (Md.madd x y)) (\ a x -> refl (Md.sm a x))
   (\ x -> refl x) (\ x -> refl x) ;

 module Inverse (Md Nd : SA.Module) (e : Iso[Md,Nd]) {
  inv-add (x y : Nd.M) : Id Md.M (e.inv (Nd.madd x y)) (Md.madd (e.inv x) (e.inv y)) =
   trans (ap e.inv (sym (trans (to-add e (e.inv x) (e.inv y))
     (cong2 Nd.M Nd.madd _ _ _ _ (e.to-inv x) (e.to-inv y)))))
    (e.inv-to (Md.madd (e.inv x) (e.inv y))) ;
  inv-scale (a : A.R) (x : Nd.M) : Id Md.M (e.inv (Nd.sm a x)) (Md.sm a (e.inv x)) =
   trans (ap e.inv (sym (trans (to-scale e a (e.inv x)) (ap (Nd.sm a) (e.to-inv x)))))
    (e.inv-to (Md.sm a (e.inv x))) ;
  inverse : Iso[Nd,Md] = make Nd Md e.inv (to e) inv-add inv-scale e.inv-to e.to-inv ;
 } ;
 inverse (Md Nd : SA.Module) (e : Iso[Md,Nd]) : Iso[Nd,Md] = Inverse[Md,Nd,e].inverse ;

 compose (Md Nd Pd : SA.Module) (e : Iso[Md,Nd]) (f : Iso[Nd,Pd]) : Iso[Md,Pd] =
  make Md Pd (\ x -> to f (to e x)) (\ z -> e.inv (f.inv z))
   (\ x y -> trans (ap (to f) (to-add e x y)) (to-add f (to e x) (to e y)))
   (\ a x -> trans (ap (to f) (to-scale e a x)) (to-scale f a (to e x)))
   (\ z -> trans (ap (to f) (e.to-inv (f.inv z))) (f.to-inv z))
   (\ x -> trans (ap e.inv (f.inv-to (to e x))) (e.inv-to x)) ;

 module Sum (Md Md' Nd Nd' : SA.Module) (e : Iso[Md,Md']) (f : Iso[Nd,Nd']) {
  module S = SP.Pair[A,Md,Nd] ;
  module T = SP.Pair[A,Md',Nd'] ;
  sum : Iso[S.product,T.product] =
   make S.product T.product (\ x -> (to e x.1,to f x.2)) (\ y -> (e.inv y.1,f.inv y.2))
    (\ x y -> T.ext _ _ (to-add e x.1 y.1) (to-add f x.2 y.2))
    (\ a x -> T.ext _ _ (to-scale e a x.1) (to-scale f a x.2))
    (\ y -> T.ext _ _ (e.to-inv y.1) (f.to-inv y.2))
    (\ x -> S.ext _ _ (e.inv-to x.1) (f.inv-to x.2)) ;
 } ;
} ;
