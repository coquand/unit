-- The bridge: [P_h][P_g] = [P_{h (x) g}] in K_0(A) (K0).  In the situation
-- of STABLESUM, let g, g' be inverse n x n matrices and h an m x m matrix
-- over C, and E the projector of GLUEDPROJECTOR (ia E = alpha D alpha',
-- ib E = beta' D beta).  Then
--     P_h (x) E ~ P_{h (x) g}         (TWIST, KRONECKER):
-- a family c_y in P_h (y in Fin 2n) gives, for each j, the columns
-- L_j = (left(c_y)_j)_y and R_j = (right(c_y)_j)_y with jb R_j = sum_j' h_jj' L_j'
-- (in C), and
--     c |-> (U, V),  U_(j,i) = (alpha' L_j)_(l,i),  V_(j,i) = (beta R_j)_(l,i),
-- where jb V_(j,.) = (beta R_j)_l = sum_j' h_jj' (k alpha' L_j')_l
-- = sum_j' h_jj' g U_(j',.).  Conversely (U, V) gives c_y with
-- left(c_y)_j = (alpha (cat U_(j,.) 0))_y and right(c_y)_j = (beta' (cat V_(j,.) 0))_y,
-- which lie in P_h by the same computation read backwards (alpha = beta' k,
-- k (cat x 0) = cat (g x) 0), and the family is fixed by E since
-- alpha D alpha' fixes alpha (cat u 0).  The round trips are
-- alpha' alpha = 1 and alpha (cat (alpha' w)_l 0) = alpha D alpha' w = E w.
--
-- So if p presents P_h and q presents P_g, then
--     Image (p (x) E) ~ Image p (x) E ~ P_h (x) E ~ P_{h (x) g},
-- and [p][q] = [p][E] = [p (x) E] = [s] for any s presenting P_{h (x) g}.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (m n : Nat) {
 module GP = GluedProjector[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,n] ;
 module G1 = GP.G1 ;
 module G2 = GP.G2 ;
 module Gm = Glued[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,m] ;
 module GN = Glued[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,Pairing[l].times m n] ;
 module KC = Kronecker[l].Over[C,setC,m,n] ;
 module TW = Twist[l].Over[A,setA] ;
 module K = K0[l].Over[A,setA] ;
 module MI = GP.MI ;
 module VC = GP.VC ;
 module BA = GP.BA ;
 module BB = GP.BB ;
 module BC = GP.BC ;
 module SAa = FiniteIdeal[l].Sums[Aa] ;
 module SAb = FiniteIdeal[l].Sums[Ab] ;
 module SC = FiniteIdeal[l].Sums[C] ;
 module LC = RL[C] ;
 -- X acting on a combination of vectors
 comb-act (X : GP.MC.Mat) (k : Nat) (cs : Fin k -> C.R) (v : Fin k -> VC.Vec) (x : Fin (plus n n)) :
  Id C.R (VC.act X (\ y -> SC.sum k (\ j -> C.mul (cs j) (v j y))) x) (SC.sum k (\ j -> C.mul (cs j) (VC.act X (v j) x))) =
  Pairing[l].Sums[C].swap-sums (plus n n) k (X x) cs (\ y j -> v j y) ;

 module Tensor (g g' : G1.MC.Mat) (gi : GP.DP.IM.Inverse[g,g']) (r : GP.Explicit[g,g',gi].DL.Result) (h : Gm.MC.Mat) {
  module X = GP.Explicit[g,g',gi] ;
  module D = X.Data[r] ;
  module Ph = Gm.Glue[h] ;
  module PK = GN.Glue[KC.kron h g] ;
  module T = TW.Of[Ph.glued,D.projector] ;
  module PS = T.PS ;
  -- parts of a module sum in P_h
  left-sum : (k : Nat) (xs : Fin k -> Ph.Carrier) (j : Fin m) ->
   Id Aa.R (Ph.left (PS.sum k xs) j) (SAa.sum k (\ t -> Ph.left (xs t) j)) = split {
   zero -> \ xs j -> ap (\ x -> Ph.left x j) (PS.sum-empty xs) ;
   suc k | rr -> \ xs j -> trans (ap (\ x -> Ph.left x j) (PS.sum-step k xs)) (ap (Aa.add (Ph.left (xs (inr tt)) j)) (rr (\ t -> xs (inl t)) j)) } ;
  right-sum : (k : Nat) (xs : Fin k -> Ph.Carrier) (j : Fin m) ->
   Id Ab.R (Ph.right (PS.sum k xs) j) (SAb.sum k (\ t -> Ph.right (xs t) j)) = split {
   zero -> \ xs j -> ap (\ x -> Ph.right x j) (PS.sum-empty xs) ;
   suc k | rr -> \ xs j -> trans (ap (\ x -> Ph.right x j) (PS.sum-step k xs)) (ap (Ab.add (Ph.right (xs (inr tt)) j)) (rr (\ t -> xs (inl t)) j)) } ;
  -- the columns of a family
  Lc (c : T.PL.Carrier) (j : Fin m) : G2.VAa.Vec = \ y -> Ph.left (c y) j ;
  Rc (c : T.PL.Carrier) (j : Fin m) : G2.VAb.Vec = \ y -> Ph.right (c y) j ;
  Ufun (c : T.PL.Carrier) (j : Fin m) : BA.V.Vec = BA.lhalf (G2.VAa.act D.alpha' (Lc c j)) ;
  Vfun (c : T.PL.Carrier) (j : Fin m) : BB.V.Vec = BB.lhalf (G2.VAb.act D.beta (Rc c j)) ;
  right-col (c : T.PL.Carrier) (j : Fin m) :
   Id VC.Vec (G2.JB.map (Rc c j)) (\ y -> SC.sum m (\ j' -> C.mul (h j j') (ja.1 (Lc c j' y)))) =
   VC.vec-eq _ _ (\ y -> Gm.VC.entry _ _ (Ph.member (c y)) j) ;
  -- (beta w)_l = g (alpha' w)_l for w = ja L
  step (c : T.PL.Carrier) (j' : Fin m) (i : Fin n) :
   Id C.R (VC.act D.B (G2.JA.map (Lc c j')) (BC.B.il i)) (G1.VC.act g (G1.JA.map (Ufun c j')) i) =
   trans (sym (VC.entry _ _ (D.kB (G2.JA.map (Lc c j'))) (BC.B.il i)))
    (trans (BC.diag-l g g' (VC.act D.Al' (G2.JA.map (Lc c j'))) i)
     (ap (\ w -> G1.VC.act g (BC.lhalf w) i) (sym (G2.JA.map-act D.alpha' (Lc c j'))))) ;
  forward-at (c : T.PL.Carrier) (j : Fin m) (i : Fin n) :
   Id C.R (jb.1 (Vfun c j i)) (SC.sum m (\ j' -> C.mul (h j j') (G1.VC.act g (G1.JA.map (Ufun c j')) i))) =
   calc C.R { jb.1 (Vfun c j i)
     =< VC.entry _ _ (G2.JB.map-act D.beta (Rc c j)) (BC.B.il i) > VC.act D.B (G2.JB.map (Rc c j)) (BC.B.il i)
     =< ap (\ w -> VC.act D.B w (BC.B.il i)) (right-col c j) >
        VC.act D.B (\ y -> SC.sum m (\ j' -> C.mul (h j j') (ja.1 (Lc c j' y)))) (BC.B.il i)
     =< comb-act D.B m (h j) (\ j' -> G2.JA.map (Lc c j')) (BC.B.il i) >
        SC.sum m (\ j' -> C.mul (h j j') (VC.act D.B (G2.JA.map (Lc c j')) (BC.B.il i)))
     =< SC.sum-cong m _ _ (\ j' -> ap (C.mul (h j j')) (step c j' i)) >
        SC.sum m (\ j' -> C.mul (h j j') (G1.VC.act g (G1.JA.map (Ufun c j')) i)) } ;
  Uz (c : T.PL.Carrier) : GN.VAa.Vec = \ z -> Ufun c (KC.first z) (KC.second z) ;
  Vz (c : T.PL.Carrier) : GN.VAb.Vec = \ z -> Vfun c (KC.first z) (KC.second z) ;
  Uz-at (c : T.PL.Carrier) (j : Fin m) (i : Fin n) : Id Aa.R (Uz c (KC.pair j i)) (Ufun c j i) =
   ap (\ p -> Ufun c p.1 p.2) (Pairing[l].unpair-pair n m j i) ;
  Vz-at (c : T.PL.Carrier) (j : Fin m) (i : Fin n) : Id Ab.R (Vz c (KC.pair j i)) (Vfun c j i) =
   ap (\ p -> Vfun c p.1 p.2) (Pairing[l].unpair-pair n m j i) ;
  forward-member (c : T.PL.Carrier) : Id GN.VC.Vec (GN.JB.map (Vz c)) (GN.VC.act (KC.kron h g) (GN.JA.map (Uz c))) =
   KC.vec-pairs _ _ (\ j i -> calc C.R { jb.1 (Vz c (KC.pair j i))
     =< ap jb.1 (Vz-at c j i) > jb.1 (Vfun c j i)
     =< forward-at c j i > SC.sum m (\ j' -> C.mul (h j j') (G1.VC.act g (G1.JA.map (Ufun c j')) i))
     =< SC.sum-cong m _ _ (\ j' -> ap (C.mul (h j j'))
         (SC.sum-cong n (\ i' -> C.mul (g i i') (ja.1 (Ufun c j' i'))) (\ i' -> C.mul (g i i') (ja.1 (Uz c (KC.pair j' i'))))
          (\ i' -> ap (\ t -> C.mul (g i i') (ja.1 t)) (sym (Uz-at c j' i'))))) >
        SC.sum m (\ j' -> C.mul (h j j') (SC.sum n (\ i' -> C.mul (g i i') (ja.1 (Uz c (KC.pair j' i'))))))
     =< sym (KC.act-kron h g (GN.JA.map (Uz c)) j i) > GN.VC.act (KC.kron h g) (GN.JA.map (Uz c)) (KC.pair j i) }) ;
  forward (c : T.Carrier) : PK.Carrier = PK.point (Uz (T.family c)) (Vz (T.family c)) (forward-member (T.family c)) ;

  module Back (x : PK.Carrier) {
   u (j : Fin m) : BA.V.Vec = \ i -> PK.left x (KC.pair j i) ;
   v (j : Fin m) : BB.V.Vec = \ i -> PK.right x (KC.pair j i) ;
   ua (j : Fin m) : G2.VAa.Vec = G2.VAa.act D.alpha (BA.cat (u j) BA.V.vzero) ;
   vb (j : Fin m) : G2.VAb.Vec = G2.VAb.act D.beta' (BB.cat (v j) BB.V.vzero) ;
   v-image (j : Fin m) (i : Fin n) : Id C.R (jb.1 (v j i)) (SC.sum m (\ j' -> C.mul (h j j') (G1.VC.act g (G1.JA.map (u j')) i))) =
    trans (GN.VC.entry _ _ (PK.member x) (KC.pair j i)) (KC.act-kron h g (GN.JA.map (PK.left x)) j i) ;
   -- cat (jb v_j) 0 = sum_j' h_jj' k (cat (ja u_j') 0)
   cat-comb (j : Fin m) : Id VC.Vec (BC.cat (G1.JB.map (v j)) BC.V.vzero)
    (\ y -> SC.sum m (\ j' -> C.mul (h j j') (VC.act X.k (BC.cat (G1.JA.map (u j')) BC.V.vzero) y))) =
    BC.Halves[BC.cat (G1.JB.map (v j)) BC.V.vzero,\ y -> SC.sum m (\ j' -> C.mul (h j j') (VC.act X.k (BC.cat (G1.JA.map (u j')) BC.V.vzero) y)),
     \ i -> trans (BC.cat-l (G1.JB.map (v j)) BC.V.vzero i) (trans (v-image j i)
      (SC.sum-cong m _ _ (\ j' -> ap (C.mul (h j j'))
       (sym (trans (VC.entry _ _ (X.k-cat (G1.JA.map (u j'))) (BC.B.il i)) (BC.cat-l (G1.VC.act g (G1.JA.map (u j'))) BC.V.vzero i)))))),
     \ i -> trans (BC.cat-r (G1.JB.map (v j)) BC.V.vzero i)
      (sym (trans (SC.sum-cong m (\ j' -> C.mul (h j j') (VC.act X.k (BC.cat (G1.JA.map (u j')) BC.V.vzero) (BC.B.ir i))) (\ j' -> C.z)
        (\ j' -> trans (ap (C.mul (h j j')) (trans (VC.entry _ _ (X.k-cat (G1.JA.map (u j'))) (BC.B.ir i))
          (BC.cat-r (G1.VC.act g (G1.JA.map (u j'))) BC.V.vzero i))) (LC.mul-zero (h j j'))))
       (SC.sum-zero m)))].equal ;
   -- beta' k (cat x 0) = alpha (cat x 0)
   step2 (j' : Fin m) (y : Fin (plus n n)) :
    Id C.R (VC.act D.B' (VC.act X.k (BC.cat (G1.JA.map (u j')) BC.V.vzero)) y) (ja.1 (ua j' y)) =
    trans (sym (VC.entry _ _ (D.kA (BC.cat (G1.JA.map (u j')) BC.V.vzero)) y))
     (sym (VC.entry _ _ (trans (G2.JA.map-act D.alpha (BA.cat (u j') BA.V.vzero))
      (ap (VC.act D.Al) (trans (GP.BMa.map-cat (u j') BA.V.vzero) (ap (BC.cat (G1.JA.map (u j'))) G1.JA.map-zero)))) y)) ;
   member-y (y : Fin (plus n n)) : Id Gm.VC.Vec (Gm.JB.map (\ j -> vb j y)) (Gm.VC.act h (Gm.JA.map (\ j -> ua j y))) =
    Gm.VC.vec-eq _ _ (\ j -> calc C.R { jb.1 (vb j y)
      =< VC.entry _ _ (G2.JB.map-act D.beta' (BB.cat (v j) BB.V.vzero)) y > VC.act D.B' (G2.JB.map (BB.cat (v j) BB.V.vzero)) y
      =< ap (\ w -> VC.act D.B' w y) (trans (GP.BMb.map-cat (v j) BB.V.vzero) (ap (BC.cat (G1.JB.map (v j))) G1.JB.map-zero)) >
         VC.act D.B' (BC.cat (G1.JB.map (v j)) BC.V.vzero) y
      =< ap (\ w -> VC.act D.B' w y) (cat-comb j) >
         VC.act D.B' (\ y' -> SC.sum m (\ j' -> C.mul (h j j') (VC.act X.k (BC.cat (G1.JA.map (u j')) BC.V.vzero) y'))) y
      =< comb-act D.B' m (h j) (\ j' -> VC.act X.k (BC.cat (G1.JA.map (u j')) BC.V.vzero)) y >
         SC.sum m (\ j' -> C.mul (h j j') (VC.act D.B' (VC.act X.k (BC.cat (G1.JA.map (u j')) BC.V.vzero)) y))
      =< SC.sum-cong m _ _ (\ j' -> ap (C.mul (h j j')) (step2 j' y)) > SC.sum m (\ j' -> C.mul (h j j') (ja.1 (ua j' y))) }) ;
   cy (y : Fin (plus n n)) : Ph.Carrier = Ph.point (\ j -> ua j y) (\ j -> vb j y) (member-y y) ;
   fixed (y : Fin (plus n n)) : Id Ph.Carrier (T.comb cy y) (cy y) =
    Ph.ext _ _
     (Gm.VAa.vec-eq _ _ (\ j -> trans (left-sum (plus n n) (\ y' -> Ph.glued.sm (D.E y y') (cy y')) j)
      (G2.VAa.entry _ _ (trans (ap (\ Z -> G2.VAa.act Z (ua j)) D.E-a) (D.fix-a (u j))) y)))
     (Gm.VAb.vec-eq _ _ (\ j -> trans (right-sum (plus n n) (\ y' -> Ph.glued.sm (D.E y y') (cy y')) j)
      (G2.VAb.entry _ _ (trans (ap (\ Z -> G2.VAb.act Z (vb j)) D.E-b) (D.fix-b (v j))) y))) ;
   point : T.Carrier = (cy,fixed) ;
  } ;
  -- the round trips
  there-back-a (x : PK.Carrier) (z : Fin (Pairing[l].times m n)) : Id Aa.R (Uz Back[x].cy z) (PK.left x z) =
   trans (G2.VAa.entry _ _ (G2.VAa.act-cancel D.alpha D.alpha' D.ai.left (BA.cat (Back[x].u (KC.first z)) BA.V.vzero)) (BA.B.il (KC.second z)))
    (trans (BA.cat-l (Back[x].u (KC.first z)) BA.V.vzero (KC.second z)) (ap (PK.left x) (KC.pu z))) ;
  there-back-b (x : PK.Carrier) (z : Fin (Pairing[l].times m n)) : Id Ab.R (Vz Back[x].cy z) (PK.right x z) =
   trans (G2.VAb.entry _ _ (G2.VAb.act-cancel D.beta' D.beta D.bi.right (BB.cat (Back[x].v (KC.first z)) BB.V.vzero)) (BB.B.il (KC.second z)))
    (trans (BB.cat-l (Back[x].v (KC.first z)) BB.V.vzero (KC.second z)) (ap (PK.right x) (KC.pu z))) ;
  back-there-a (c : T.Carrier) (y : Fin (plus n n)) (j : Fin m) :
   Id Aa.R (Back[forward c].ua j y) (Ph.left (T.family c y) j) =
   calc Aa.R { Back[forward c].ua j y
     =< ap (\ t -> G2.VAa.act D.alpha (BA.cat t BA.V.vzero) y) (BA.V.vec-eq (\ i -> Uz (T.family c) (KC.pair j i)) (Ufun (T.family c) j) (Uz-at (T.family c) j)) >
        G2.VAa.act D.alpha (BA.cat (Ufun (T.family c) j) BA.V.vzero) y
     =< G2.VAa.entry _ _ (D.restore-a (Lc (T.family c) j)) y > G2.VAa.act D.Ma (Lc (T.family c) j) y
     =< G2.VAa.entry _ _ (ap (\ Z -> G2.VAa.act Z (Lc (T.family c) j)) (sym D.E-a)) y >
        G2.VAa.act (GP.IAm.map D.E) (Lc (T.family c) j) y
     =< sym (left-sum (plus n n) (\ y' -> Ph.glued.sm (D.E y y') (T.family c y')) j) > Ph.left (T.comb (T.family c) y) j
     =< ap (\ t -> Ph.left t j) (T.member c y) > Ph.left (T.family c y) j } ;
  back-there-b (c : T.Carrier) (y : Fin (plus n n)) (j : Fin m) :
   Id Ab.R (Back[forward c].vb j y) (Ph.right (T.family c y) j) =
   calc Ab.R { Back[forward c].vb j y
     =< ap (\ t -> G2.VAb.act D.beta' (BB.cat t BB.V.vzero) y) (BB.V.vec-eq (\ i -> Vz (T.family c) (KC.pair j i)) (Vfun (T.family c) j) (Vz-at (T.family c) j)) >
        G2.VAb.act D.beta' (BB.cat (Vfun (T.family c) j) BB.V.vzero) y
     =< G2.VAb.entry _ _ (D.restore-b (Rc (T.family c) j)) y > G2.VAb.act D.Mb (Rc (T.family c) j) y
     =< G2.VAb.entry _ _ (ap (\ Z -> G2.VAb.act Z (Rc (T.family c) j)) (sym D.E-b)) y >
        G2.VAb.act (GP.IBm.map D.E) (Rc (T.family c) j) y
     =< sym (right-sum (plus n n) (\ y' -> Ph.glued.sm (D.E y y') (T.family c y')) j) > Ph.right (T.comb (T.family c) y) j
     =< ap (\ t -> Ph.right t j) (T.member c y) > Ph.right (T.family c y) j } ;
  iso : MI.Iso[T.twisted,PK.glued] = MI.make T.twisted PK.glued forward (\ x -> Back[x].point)
   (\ c d -> PK.ext _ _
     (GN.VAa.vec-eq _ _ (\ z -> G2.VAa.entry _ _ (G2.VAa.act-add D.alpha' (Lc (T.family c) (KC.first z)) (Lc (T.family d) (KC.first z))) (BA.B.il (KC.second z))))
     (GN.VAb.vec-eq _ _ (\ z -> G2.VAb.entry _ _ (G2.VAb.act-add D.beta (Rc (T.family c) (KC.first z)) (Rc (T.family d) (KC.first z))) (BB.B.il (KC.second z)))))
   (\ s c -> PK.ext _ _
     (GN.VAa.vec-eq _ _ (\ z -> G2.VAa.entry _ _ (G2.VAa.act-scale D.alpha' (ia.1 s) (Lc (T.family c) (KC.first z))) (BA.B.il (KC.second z))))
     (GN.VAb.vec-eq _ _ (\ z -> G2.VAb.entry _ _ (G2.VAb.act-scale D.beta (ib.1 s) (Rc (T.family c) (KC.first z))) (BB.B.il (KC.second z)))))
   (\ x -> PK.ext _ _ (GN.VAa.vec-eq _ _ (there-back-a x)) (GN.VAb.vec-eq _ _ (there-back-b x)))
   (\ c -> T.ext _ _ (\ y -> Ph.ext _ _ (Gm.VAa.vec-eq _ _ (back-there-a c y)) (Gm.VAb.vec-eq _ _ (back-there-b c y)))) ;
 } ;

 -- the bridge in K_0
 module Bridge (g g' : G1.MC.Mat) (gi : GP.DP.IM.Inverse[g,g']) (h : Gm.MC.Mat) (p q s : K.Projector)
  (ep : MI.Iso[K.image p,Gm.Glue[h].glued]) (eq : MI.Iso[K.image q,G1.Glue[g].glued])
  (es : MI.Iso[K.image s,GN.Glue[KC.kron h g].glued]) {
  module X = GP.Explicit[g,g',gi] ;
  module At (r : X.DL.Result) {
   module Tn = Tensor[g,g',gi,r,h] ;
   e : K.Projector = X.Data[r].projector ;
   -- Image (p (x) E) ~ Image p (x) E ~ P_h (x) E ~ P_{h (x) g} ~ Image s
   tensor : MI.Iso[K.image (K.product p e),K.image s] =
    MI.compose (K.image (K.product p e)) TW.Of[K.image p,e].twisted (K.image s) TW.ImageOf[p,e].iso
     (MI.compose TW.Of[K.image p,e].twisted Tn.T.twisted (K.image s) TW.Map[K.image p,Gm.Glue[h].glued,e,ep].iso
      (MI.compose Tn.T.twisted Tn.PK.glued (K.image s) Tn.iso (MI.inverse (K.image s) Tn.PK.glued es))) ;
   equation : Id K.K0.R (K.K0.mul (K.class p) (K.class q)) (K.class s) =
    calc K.K0.R { K.K0.mul (K.class p) (K.class q)
      =< ap (K.K0.mul (K.class p)) (K.Presenting[G1.Glue[g].glued,q,e,eq,X.Data[r].iso].same) > K.K0.mul (K.class p) (K.class e)
      =< K.class-product p e > K.class (K.product p e)
      =< K.class-iso (K.product p e) s tensor > K.class s } ;
  } ;
  theorem : Id K.K0.R (K.K0.mul (K.class p) (K.class q)) (K.class s) =
   TC.rec X.DL.Result @l (Id K.K0.R (K.K0.mul (K.class p) (K.class q)) (K.class s)) (K.G.set _ _)
    (\ r -> At[r].equation) X.DL.theorem ;
 } ;
} ;
