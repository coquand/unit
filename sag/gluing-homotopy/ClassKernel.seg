-- gabber-recollement.tex, Lemma 3.6(3), in K_0 (K0).  In the situation of
-- GLUEDFREE (A -> A_a -> C, A -> A_b -> C, a and b comaximal), let p, q be
-- projectors over A whose base changes (PROJECTORMAP) have equal classes in
-- K_0(A_a) and in K_0(A_b).  Then merely there are L, an invertible L x L
-- matrix g over C and a projector r presenting P_g (GLUEDMODULE) with
--     [p] + [A^L] = [r] + [q],   i.e.   [p] - [q] = [P_g] - L.
--
-- Proof.  Pad to one size: e = p + 0, f = 0 + q (COMPLEMENTS.Null), so
-- [e] = [p], [f] = [q], and [e] = [f] in K_0(A_a) and K_0(A_b).  By
-- STABILISE, merely Image (e + 1_j) ~ Image (f + 1_j) over A_a, and with j'
-- over A_b; with J = j + j' both hold (Up).  Put E = e + 1_J, F = f + 1_J,
-- of size L.  Base change commutes with sums (PROJECTORMAP), so the images
-- of E and F are isomorphic over A_a and over A_b, hence equivalent
-- (EQUIVALENCE.FromIso), and GLUEDIMAGE gives g with
-- Image E + Image (1 - F) ~ P_g.  With r = E + (1 - F) and
-- [F] + [1 - F] = [A^L] (COMPLEMENTS):
--     [p] + [A^L] = [p] + (([q] + [A^J]) + [1 - F])
--                 = (([p] + [A^J]) + [1 - F]) + [q] = [r] + [q].
-- Kernel: the same for x in K_0(A) whose restrictions (K0RESTRICTION) to
-- K_0(A_a) and K_0(A_b) are 0, as x is merely [p] - [q] (K0.difference):
-- x = [P_g] - L.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier) {
 module K = K0[l].Over[A,setA] ;
 module CA = Complements[l].Over[A,setA] ;
 module PJ = K.PJ ;
 module MI = K.MI ;
 module MA = ProjectorMap[l].Over[A,Aa,setA,setAa,ia] ;
 module MB = ProjectorMap[l].Over[A,Ab,setA,setAb,ib] ;
 module SA = Stabilise[l].Over[Aa,setAa] ;
 module SB = Stabilise[l].Over[Ab,setAb] ;
 module RK = RL[K.K0] ;
 module RA = K0Restriction[l].Over[A,Aa,setA,setAa,ia] ;
 module RB = K0Restriction[l].Over[A,Ab,setA,setAb,ib] ;
 -- x + ((y + j) + c) = ((x + j) + c) + y
 rearrange (x y j c : K.K0.R) :
  Id K.K0.R (K.K0.add x (K.K0.add (K.K0.add y j) c)) (K.K0.add (K.K0.add (K.K0.add x j) c) y) =
  calc K.K0.R { K.K0.add x (K.K0.add (K.K0.add y j) c)
    =< ap (K.K0.add x) (sym (K.K0.addA y j c)) > K.K0.add x (K.K0.add y (K.K0.add j c))
    =< ap (K.K0.add x) (K.K0.addC y (K.K0.add j c)) > K.K0.add x (K.K0.add (K.K0.add j c) y)
    =< K.K0.addA x (K.K0.add j c) y > K.K0.add (K.K0.add x (K.K0.add j c)) y
    =< ap (\ t -> K.K0.add t y) (K.K0.addA x j c) > K.K0.add (K.K0.add (K.K0.add x j) c) y } ;
 -- a + l = r + y gives a - y = r - l
 difference (x l r y : K.K0.R) (h : Id K.K0.R (K.K0.add x l) (K.K0.add r y)) :
  Id K.K0.R (K.K0.add x (K.K0.neg y)) (K.K0.add r (K.K0.neg l)) =
  calc K.K0.R { K.K0.add x (K.K0.neg y)
    =< ap (\ t -> K.K0.add t (K.K0.neg y)) (sym (RK.add-neg-cancel x l)) > K.K0.add (K.K0.add (K.K0.add x l) (K.K0.neg l)) (K.K0.neg y)
    =< ap (\ t -> K.K0.add (K.K0.add t (K.K0.neg l)) (K.K0.neg y)) h > K.K0.add (K.K0.add (K.K0.add r y) (K.K0.neg l)) (K.K0.neg y)
    =< ap (\ t -> K.K0.add t (K.K0.neg y))
        (trans (sym (K.K0.addA r y (K.K0.neg l))) (trans (ap (K.K0.add r) (K.K0.addC y (K.K0.neg l))) (K.K0.addA r (K.K0.neg l) y))) >
       K.K0.add (K.K0.add (K.K0.add r (K.K0.neg l)) y) (K.K0.neg y)
    =< RK.add-neg-cancel (K.K0.add r (K.K0.neg l)) y > K.K0.add r (K.K0.neg l) } ;

 -- p and q padded to one size, then stabilised
 module Padded (p q : PJ.Projector) {
  e : PJ.Projector = K.sum p CA.Null[q.size].projector ;
  f : PJ.Projector = K.sum CA.Null[p.size].projector q ;
  E (J : Nat) : PJ.Projector = K.sum e PJ.Free[J].projector ;
  F (J : Nat) : PJ.Projector = K.sum f PJ.Free[J].projector ;
  -- [e] = [p], [f] = [q]
  class-e : Id K.K0.R (K.class e) (K.class p) =
   trans (sym (K.class-sum p CA.Null[q.size].projector))
    (trans (ap (K.K0.add (K.class p)) CA.Null[q.size].class) (K.K0.addZ (K.class p))) ;
  class-f : Id K.K0.R (K.class f) (K.class q) =
   trans (sym (K.class-sum CA.Null[p.size].projector q))
    (trans (ap (\ t -> K.K0.add t (K.class q)) CA.Null[p.size].class) (RK.zl (K.class q))) ;
 } ;

 -- on one side: Image (e + 1_J) ~ Image (f + 1_J) over B makes the base
 -- changes of E and F equivalent
 module Side (B : CRing) (setB : Pr.isSet B.R) (phi : H.Hom A B) (p q : PJ.Projector) (J : Nat)
  (h : Stabilise[l].Over[B,setB].Stably (ProjectorMap[l].Over[A,B,setA,setB,phi].map Padded[p,q].e)
    (ProjectorMap[l].Over[A,B,setA,setB,phi].map Padded[p,q].f) J) {
  module M = ProjectorMap[l].Over[A,B,setA,setB,phi] ;
  module KB = M.KB ;
  module ST = Stabilise[l].Over[B,setB] ;
  module P = Padded[p,q] ;
  L : Nat = plus (plus p.size q.size) J ;
  module EQ = Equivalence[l].Over[B,setB,L] ;
  -- Image phi(r + 1_J) ~ Image (phi r + 1_J)
  out (r : PJ.Projector) : KB.Iso (M.map (K.sum r PJ.Free[J].projector)) (KB.sum (M.map r) (ST.one J)) =
   KB.MI.compose (KB.image (M.map (K.sum r PJ.Free[J].projector))) (KB.image (KB.sum (M.map r) (M.map PJ.Free[J].projector)))
    (KB.image (KB.sum (M.map r) (ST.one J))) M.Sum[r,PJ.Free[J].projector].iso
    (KB.sum-iso (M.map r) (M.map r) (M.map PJ.Free[J].projector) (ST.one J) (KB.MI.identity (KB.image (M.map r))) M.Free[J].iso) ;
  iso (i : KB.Iso (KB.sum (M.map P.e) (ST.one J)) (KB.sum (M.map P.f) (ST.one J))) : KB.Iso (M.map (P.E J)) (M.map (P.F J)) =
   KB.MI.compose (KB.image (M.map (P.E J))) (KB.image (KB.sum (M.map P.e) (ST.one J))) (KB.image (M.map (P.F J))) (out P.e)
    (KB.MI.compose (KB.image (KB.sum (M.map P.e) (ST.one J))) (KB.image (KB.sum (M.map P.f) (ST.one J))) (KB.image (M.map (P.F J))) i
     (KB.MI.inverse (KB.image (M.map (P.F J))) (KB.image (KB.sum (M.map P.f) (ST.one J))) (out P.f))) ;
  Equivalent : U l = EQ.Equivalent[M.At[L].MM.map (P.E J).matrix,M.At[L].MM.map (P.F J).matrix] ;
  equivalent : Tr.Trunc[Equivalent].carrier =
   TC.map (KB.Iso (KB.sum (M.map P.e) (ST.one J)) (KB.sum (M.map P.f) (ST.one J))) Equivalent
    (\ i -> EQ.FromIso[M.At[L].MM.map (P.E J).matrix,M.At[L].MM.map (P.F J).matrix,
      (M.map (P.E J)).idempotent,(M.map (P.F J)).idempotent,iso i].equivalent) h ;
 } ;

 module Lemma (p q : PJ.Projector)
  (ha : Id MA.KB.K0.R (MA.KB.class (MA.map p)) (MA.KB.class (MA.map q)))
  (hb : Id MB.KB.K0.R (MB.KB.class (MB.map p)) (MB.KB.class (MB.map q))) {
  module P = Padded[p,q] ;
  -- [e] = [f] after base change
  module Restrict (B : CRing) (setB : Pr.isSet B.R) (phi : H.Hom A B)
   (h : Id ProjectorMap[l].Over[A,B,setA,setB,phi].KB.K0.R (ProjectorMap[l].Over[A,B,setA,setB,phi].KB.class (ProjectorMap[l].Over[A,B,setA,setB,phi].map p))
     (ProjectorMap[l].Over[A,B,setA,setB,phi].KB.class (ProjectorMap[l].Over[A,B,setA,setB,phi].map q))) {
   module M = ProjectorMap[l].Over[A,B,setA,setB,phi] ;
   module KB = M.KB ;
   same : Id KB.K0.R (KB.class (M.map P.e)) (KB.class (M.map P.f)) =
    calc KB.K0.R { KB.class (M.map P.e)
      =< M.Sum[p,CA.Null[q.size].projector].class > KB.K0.add (KB.class (M.map p)) (KB.class (M.map CA.Null[q.size].projector))
      =< ap (KB.K0.add (KB.class (M.map p))) M.Null[q.size].class > KB.K0.add (KB.class (M.map p)) KB.K0.z
      =< KB.K0.addZ (KB.class (M.map p)) > KB.class (M.map p)
      =< h > KB.class (M.map q)
      =< sym (RL[KB.K0].zl (KB.class (M.map q))) > KB.K0.add KB.K0.z (KB.class (M.map q))
      =< ap (\ t -> KB.K0.add t (KB.class (M.map q))) (sym M.Null[p.size].class) >
         KB.K0.add (KB.class (M.map CA.Null[p.size].projector)) (KB.class (M.map q))
      =< sym M.Sum[CA.Null[p.size].projector,q].class > KB.class (M.map P.f) } ;
  } ;
  -- what is asserted for one size L
  Datum (L : Nat) : U l = (g : MnAlgebra[l].Over[C,setC,L].Mat) * (g' : MnAlgebra[l].Over[C,setC,L].Mat) *
   MatrixMap[l].Invertible[C,setC,L].Inverse[g,g'] * (r : PJ.Projector) *
   MI.Iso[K.image r,GluedModule[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,L].Glue[g].glued] *
   Id K.K0.R (K.K0.add (K.class p) (K.free L)) (K.K0.add (K.class r) (K.class q)) ;
  Witness : U l = (L : Nat) * Datum L ;
  module With (j j' : Nat) (sa : SA.Stably (MA.map P.e) (MA.map P.f) j) (sb : SB.Stably (MB.map P.e) (MB.map P.f) j') {
   J : Nat = plus j j' ;
   module WA = Side[Aa,setAa,ia,p,q,J,SA.up-right (MA.map P.e) (MA.map P.f) j j' sa] ;
   module WB = Side[Ab,setAb,ib,p,q,J,SB.up-left (MB.map P.e) (MB.map P.f) j' j sb] ;
   L : Nat = WA.L ;
   module Glue (qa : WA.Equivalent) (qb : WB.Equivalent) {
    module GI = GluedImage[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,
     L,(P.E J).matrix,(P.F J).matrix,(P.E J).idempotent,(P.F J).idempotent,qa,qb] ;
    -- [E] = [p] + [A^J], [F] = [q] + [A^J]
    class-E : Id K.K0.R (K.class (P.E J)) (K.K0.add (K.class p) (K.free J)) =
     trans (sym (K.class-sum P.e PJ.Free[J].projector)) (ap (\ t -> K.K0.add t (K.free J)) P.class-e) ;
    class-F : Id K.K0.R (K.class (P.F J)) (K.K0.add (K.class q) (K.free J)) =
     trans (sym (K.class-sum P.f PJ.Free[J].projector)) (ap (\ t -> K.K0.add t (K.free J)) P.class-f) ;
    equation : Id K.K0.R (K.K0.add (K.class p) (K.free L)) (K.K0.add (K.class GI.presenter) (K.class q)) =
     calc K.K0.R { K.K0.add (K.class p) (K.free L)
       =< ap (K.K0.add (K.class p)) (sym GI.CF.class) > K.K0.add (K.class p) (K.K0.add (K.class (P.F J)) (K.class GI.CF.projector))
       =< ap (\ t -> K.K0.add (K.class p) (K.K0.add t (K.class GI.CF.projector))) class-F >
          K.K0.add (K.class p) (K.K0.add (K.K0.add (K.class q) (K.free J)) (K.class GI.CF.projector))
       =< rearrange (K.class p) (K.class q) (K.free J) (K.class GI.CF.projector) >
          K.K0.add (K.K0.add (K.K0.add (K.class p) (K.free J)) (K.class GI.CF.projector)) (K.class q)
       =< ap (\ t -> K.K0.add (K.K0.add t (K.class GI.CF.projector)) (K.class q)) (sym class-E) >
          K.K0.add (K.K0.add (K.class (P.E J)) (K.class GI.CF.projector)) (K.class q)
       =< ap (\ t -> K.K0.add t (K.class q)) (K.class-sum (P.E J) GI.CF.projector) > K.K0.add (K.class GI.presenter) (K.class q) } ;
    witness : Witness = (L,(GI.g,(GI.g',(GI.inverse,(GI.presenter,(GI.presents,equation)))))) ;
   } ;
   theorem : Tr.Trunc[Witness].carrier =
    TC.bind WA.Equivalent Witness (\ qa -> TC.map WB.Equivalent Witness (\ qb -> Glue[qa,qb].witness) WB.equivalent) WA.equivalent ;
  } ;
  theorem : Tr.Trunc[Witness].carrier =
   TC.bind ((j : Nat) * SA.Stably (MA.map P.e) (MA.map P.f) j) Witness
    (\ va -> TC.bind ((j' : Nat) * SB.Stably (MB.map P.e) (MB.map P.f) j') Witness
     (\ vb -> With[va.1,vb.1,va.2,vb.2].theorem)
     SB.Stabilise[MB.map P.e,MB.map P.f,Restrict[Ab,setAb,ib,hb].same].theorem)
    SA.Stabilise[MA.map P.e,MA.map P.f,Restrict[Aa,setAa,ia,ha].same].theorem ;
 } ;
 -- x - y = 0 gives x = y
 cancel (R : CRing) (x y : R.R) (h : Id R.R (R.add x (R.neg y)) R.z) : Id R.R x y =
  calc R.R { x =< sym (RL[R].neg-neg x) > R.neg (R.neg x)
    =< ap R.neg (sym (RL[R].neg-uniq x (R.neg y) h)) > R.neg (R.neg y)
    =< RL[R].neg-neg y > y } ;
 -- the lemma for x in K_0(A) restricting to 0 in K_0(A_a) and K_0(A_b)
 -- (K0RESTRICTION): x is merely [p] - [q] (K0.difference), and then
 -- [f p] - [f q] = f x = 0 on each side
 module Kernel (x : K.K0.R)
  (ha : Id K0Restriction[l].Over[A,Aa,setA,setAa,ia].KB.K0.R (K0Restriction[l].Over[A,Aa,setA,setAa,ia].restrict.1 x)
    K0Restriction[l].Over[A,Aa,setA,setAa,ia].KB.K0.z)
  (hb : Id K0Restriction[l].Over[A,Ab,setA,setAb,ib].KB.K0.R (K0Restriction[l].Over[A,Ab,setA,setAb,ib].restrict.1 x)
    K0Restriction[l].Over[A,Ab,setA,setAb,ib].KB.K0.z) {
  Datum (L : Nat) : U l = (g : MnAlgebra[l].Over[C,setC,L].Mat) * (g' : MnAlgebra[l].Over[C,setC,L].Mat) *
   MatrixMap[l].Invertible[C,setC,L].Inverse[g,g'] * (r : PJ.Projector) *
   MI.Iso[K.image r,GluedModule[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,L].Glue[g].glued] *
   Id K.K0.R x (K.K0.add (K.class r) (K.K0.neg (K.free L))) ;
  Witness : U l = (L : Nat) * Datum L ;
  module At (p q : PJ.Projector) (e : Id K.K0.R x (K.K0.add (K.class p) (K.K0.neg (K.class q)))) {
   module Restrict (B : CRing) (setB : Pr.isSet B.R) (phi : H.Hom A B)
    (h : Id K0Restriction[l].Over[A,B,setA,setB,phi].KB.K0.R (K0Restriction[l].Over[A,B,setA,setB,phi].restrict.1 x)
      K0Restriction[l].Over[A,B,setA,setB,phi].KB.K0.z) {
    module R = K0Restriction[l].Over[A,B,setA,setB,phi] ;
    same : Id R.KB.K0.R (R.KB.class (R.M.map p)) (R.KB.class (R.M.map q)) =
     cancel R.KB.K0 (R.KB.class (R.M.map p)) (R.KB.class (R.M.map q))
      (calc R.KB.K0.R { R.KB.K0.add (R.KB.class (R.M.map p)) (R.KB.K0.neg (R.KB.class (R.M.map q)))
        =< sym (cong2 R.KB.K0.R R.KB.K0.add _ _ _ _ (R.restrict-class p)
            (trans (H.negation K.K0 R.KB.K0 R.restrict (K.class q)) (ap R.KB.K0.neg (R.restrict-class q)))) >
           R.KB.K0.add (R.restrict.1 (K.class p)) (R.restrict.1 (K.K0.neg (K.class q)))
        =< sym (R.restrict.2.2.1 (K.class p) (K.K0.neg (K.class q))) >
           R.restrict.1 (K.K0.add (K.class p) (K.K0.neg (K.class q)))
        =< ap R.restrict.1 (sym e) > R.restrict.1 x
        =< h > R.KB.K0.z }) ;
   } ;
   module LP = Lemma[p,q,Restrict[Aa,setAa,ia,ha].same,Restrict[Ab,setAb,ib,hb].same] ;
   convert (w : LP.Witness) : Witness =
    (w.1,(w.2.1,(w.2.2.1,(w.2.2.2.1,(w.2.2.2.2.1,(w.2.2.2.2.2.1,
     trans e (difference (K.class p) (K.free w.1) (K.class w.2.2.2.2.1) (K.class q) w.2.2.2.2.2.2))))))) ;
   theorem : Tr.Trunc[Witness].carrier = TC.map LP.Witness Witness convert LP.theorem ;
  } ;
  theorem : Tr.Trunc[Witness].carrier =
   TC.bind ((p : PJ.Projector) * (q : PJ.Projector) * Id K.K0.R x (K.K0.add (K.class p) (K.K0.neg (K.class q)))) Witness
    (\ v -> At[v.1,v.2.1,v.2.2].theorem) (K.difference x) ;
 } ;
} ;
