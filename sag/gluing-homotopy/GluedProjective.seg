-- Glued modules are finite projective (handoff step 5).  In the situation
-- of STABLESUM, let g, g' be inverse M x M matrices over C.  Then P_g is a
-- retract of A^(M+M) (FREEMODULES), merely.
--
-- Proof.  STABLESUM for h = g' gives P_g + P_g' ~ P_gg' + A^M.  Since
-- g g' = 1 = 1 1 1, invariance (GLUED, beta = alpha = 1) gives
-- P_gg' ~ P_1 ~ A^M (GLUEDFREE), and A^M + A^M ~ A^(M+M) (halves).  So
-- P_g + P_g' ~ A^(M+M), and P_g is a summand of A^(M+M).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (M : Nat) {
 module SS = StableSum[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,M] ;
 module FM = FreeModules[l].Over[A,setA] ;
 module G1 = SS.G1 ;
 module GF = SS.GF ;
 module MI = SS.MI ;
 module MC = G1.MC ;
 -- the identity matrices are inverse to themselves
 one-a : G1.IAa.Inverse[G1.VAa.MR.mone,G1.VAa.MR.mone] =
  new G1.IAa.Inverse[G1.VAa.MR.mone,G1.VAa.MR.mone,G1.VAa.MR.m-one-left G1.VAa.MR.mone,G1.VAa.MR.m-one-left G1.VAa.MR.mone] ;
 one-b : G1.IAb.Inverse[G1.VAb.MR.mone,G1.VAb.MR.mone] =
  new G1.IAb.Inverse[G1.VAb.MR.mone,G1.VAb.MR.mone,G1.VAb.MR.m-one-left G1.VAb.MR.mone,G1.VAb.MR.m-one-left G1.VAb.MR.mone] ;
 -- 1 1 1 = 1 (images in C)
 unit-product : Id MC.Mat (MC.mmul (MC.mmul (G1.JB.MM.map G1.VAb.MR.mone) MC.mone) (G1.JA.MM.map G1.VAa.MR.mone)) MC.mone =
  calc MC.Mat { MC.mmul (MC.mmul (G1.JB.MM.map G1.VAb.MR.mone) MC.mone) (G1.JA.MM.map G1.VAa.MR.mone)
    =< ap (\ X -> MC.mmul (MC.mmul X MC.mone) (G1.JA.MM.map G1.VAa.MR.mone)) G1.JB.MM.map-one >
       MC.mmul (MC.mmul MC.mone MC.mone) (G1.JA.MM.map G1.VAa.MR.mone)
    =< ap (\ X -> MC.mmul X (G1.JA.MM.map G1.VAa.MR.mone)) (MC.m-one-left MC.mone) > MC.mmul MC.mone (G1.JA.MM.map G1.VAa.MR.mone)
    =< MC.m-one-left (G1.JA.MM.map G1.VAa.MR.mone) > G1.JA.MM.map G1.VAa.MR.mone
    =< G1.JA.MM.map-one > MC.mone } ;
 module Projective (g g' : MC.Mat) (gi : SS.D.IM.Inverse[g,g']) {
  gi' : SS.D.IM.Inverse[g',g] = new SS.D.IM.Inverse[g',g,gi.left,gi.right] ;
  module L = SS.Lemma[g,g',gi,g',g,gi'] ;
  module Two = FM.Halving[M] ;
  -- P_gg' ~ P_1 ~ A^M
  trivial : MI.Iso[L.Pgh.glued,GF.free] =
   MI.compose L.Pgh.glued GF.P1.glued GF.free
    (G1.Invariance[MC.mone,MC.mmul g g',G1.VAb.MR.mone,G1.VAb.MR.mone,one-b,G1.VAa.MR.mone,G1.VAa.MR.mone,one-a,
      trans gi.right (sym unit-product)].iso)
    (MI.inverse GF.free GF.P1.glued GF.iso) ;
  -- P_gg' + A^M ~ A^M + A^M ~ A^(M+M)
  to-free : MI.Iso[L.Target,FM.free (plus M M)] =
   MI.compose L.Target Two.S.product (FM.free (plus M M))
    (MI.Sum[L.Pgh.glued,GF.free,GF.free,GF.free,trivial,MI.identity GF.free].sum)
    (MI.inverse (FM.free (plus M M)) Two.S.product Two.iso) ;
  retract (s : MI.Iso[L.Source,L.Target]) : FM.Retract[G1.Glue[g].glued] =
   FM.Summand[G1.Glue[g].glued,G1.Glue[g'].glued,plus M M,
    MI.compose L.Source L.Target (FM.free (plus M M)) s to-free].retract ;
  theorem : FM.FiniteProjective G1.Glue[g].glued =
   TC.map (MI.Iso[L.Source,L.Target]) (FM.Retract[G1.Glue[g].glued]) retract L.theorem ;
 } ;
} ;
