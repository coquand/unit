-- Classes vanishing on a cover are nilpotent (towards LQ X.5.5).
--  (two opens)  In the situation of CLASSKERNEL, if x restricts to 0 in
--   K_0(A_a) and K_0(A_b), then x x = 0: x = [P_g] - L (Lemma 3.6(3)) and
--   ([P_g] - L)^2 = 0 (Lemma 3.6(2)).
--  (zero ring)  If 0 = 1 in A, every projector has a single-element image,
--   so K_0(A) = 0.
--  (cover)  Let s_1 .. s_k be comaximal, sum_i c_i s_i = 1, and let x in
--   K_0(A) restrict to 0 in each K_0(A_(s_i)) (localisations at powers,
--   LOCALISATIONS).  Then x is nilpotent.  Induction on k; k = 0 is the zero
--   ring.  For k + 1 put b = sum_(i<=k) c_i s_i, so c s + b = 1 with
--   s = s_(k+1).  In A_b the images t_i of s_1 .. s_k are comaximal
--   (sum (c_i/b) t_i = 1), and x restricts to 0 in each (A_b)_(t_i), since
--   A -> A_b -> (A_b)_(t_i) factors through A_(s_i) (MONOIDLOCALIZATIONMAP;
--   K0RESTRICTION.Compose, Pointwise).  So x^m = 0 in K_0(A_b) by induction;
--   y = x^(m+1) restricts to 0 in A_b and in A_s, and y y = 0 by (two opens).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;

-- (two opens)
module Square (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (x : K0[l].Over[A,setA].K0.R)
 (ha : Id K0Restriction[l].Over[A,Aa,setA,setAa,ia].KB.K0.R (K0Restriction[l].Over[A,Aa,setA,setAa,ia].restrict.1 x)
   K0Restriction[l].Over[A,Aa,setA,setAa,ia].KB.K0.z)
 (hb : Id K0Restriction[l].Over[A,Ab,setA,setAb,ib].KB.K0.R (K0Restriction[l].Over[A,Ab,setA,setAb,ib].restrict.1 x)
   K0Restriction[l].Over[A,Ab,setA,setAb,ib].KB.K0.z) {
 module CK = ClassKernel[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal] ;
 module K = CK.K ;
 module KX = CK.Kernel[x,ha,hb] ;
 at (v : KX.Witness) : Id K.K0.R (K.K0.mul x x) K.K0.z =
  trans (cong2 K.K0.R K.K0.mul _ _ _ _ v.2.2.2.2.2.2 v.2.2.2.2.2.2)
   ClassProduct[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal,v.1,v.1].Lemma[
    v.2.1,v.2.2.1,v.2.2.2.1,v.2.1,v.2.2.1,v.2.2.2.1,v.2.2.2.2.1,v.2.2.2.2.1,v.2.2.2.2.2.1,v.2.2.2.2.2.1].theorem ;
 theorem : Id K.K0.R (K.K0.mul x x) K.K0.z = TC.rec KX.Witness @l (Id K.K0.R (K.K0.mul x x) K.K0.z) (K.G.set _ _) at KX.theorem ;
} ;

-- (zero ring)
module Trivial (A : CRing) (setA : Pr.isSet A.R) (h : Id A.R A.z A.o) {
 module K = K0[l].Over[A,setA] ;
 module PJ = K.PJ ;
 single (p : PJ.Projector) : K.MI.Single (K.image p) = \ v ->
  PJ.Image[p].ext v PJ.Image[p].zero (PJ.Image[p].V.vec-eq _ _ (\ i ->
   trans (sym (A.mulO (PJ.Image[p].value v i))) (trans (ap (A.mul (PJ.Image[p].value v i)) (sym h)) (RL[A].mul-zero (PJ.Image[p].value v i))))) ;
 class-zero (p : PJ.Projector) : Id K.K0.R (K.class p) K.K0.z =
  trans (K.class-iso p PJ.zeroP (K.MI.Singles[K.image p,K.image PJ.zeroP,single p,K.PSm.zero-single].iso)) (sym K.class-zero) ;
 zero (x : K.K0.R) : Id K.K0.R x K.K0.z =
  TC.rec ((p : PJ.Projector) * (q : PJ.Projector) * Id K.K0.R x (K.K0.add (K.class p) (K.K0.neg (K.class q))))
   @l (Id K.K0.R x K.K0.z) (K.G.set _ _)
   (\ v -> trans v.2.2 (trans (cong2 K.K0.R K.K0.add _ _ _ _ (class-zero v.1) (trans (ap K.K0.neg (class-zero v.2.1)) RL[K.K0].neg-zero))
     (K.K0.addZ K.K0.z)))
   (K.difference x) ;
} ;

-- (cover)
Cover (A : CRing) (k : Nat) : U l =
 (s : Fin k -> A.R) * (c : Fin k -> A.R) * Id A.R (FiniteIdeal[l].Sums[A].sum k (\ i -> A.mul (c i) (s i))) A.o ;
Vanishes (A : CRing) (setA : Pr.isSet A.R) (s : A.R) (x : K0[l].Over[A,setA].K0.R) : U l =
 Id K0Restriction[l].Over[A,Localisations[l].Over[A].Inclusion[s].LX.ring,setA,Localisations[l].Over[A].Inclusion[s].LX.set,
   Localisations[l].Over[A].Inclusion[s].LX.inclusion].KB.K0.R
  (K0Restriction[l].Over[A,Localisations[l].Over[A].Inclusion[s].LX.ring,setA,Localisations[l].Over[A].Inclusion[s].LX.set,
    Localisations[l].Over[A].Inclusion[s].LX.inclusion].restrict.1 x)
  K0Restriction[l].Over[A,Localisations[l].Over[A].Inclusion[s].LX.ring,setA,Localisations[l].Over[A].Inclusion[s].LX.set,
   Localisations[l].Over[A].Inclusion[s].LX.inclusion].KB.K0.z ;
Nilpotent (A : CRing) (setA : Pr.isSet A.R) (x : K0[l].Over[A,setA].K0.R) : U l =
 AffinePowers[l].Over[K0[l].Over[A,setA].K0].Nilpotent x ;
Statement (k : Nat) : U (l+) = (A : CRing) (setA : Pr.isSet A.R) (cv : Cover A k) (x : K0[l].Over[A,setA].K0.R) ->
 ((i : Fin k) -> Vanishes A setA (cv.1 i) x) -> Nilpotent A setA x ;

module Step (k : Nat) (ih : Statement k) (A : CRing) (setA : Pr.isSet A.R) (cv : Cover A (suc k))
 (x : K0[l].Over[A,setA].K0.R) (h : (i : Fin (suc k)) -> Vanishes A setA (cv.1 i) x) {
 module K = K0[l].Over[A,setA] ;
 module LA = Localisations[l].Over[A] ;
 module PA = AffinePowers[l].Over[A] ;
 module PK = AffinePowers[l].Over[K.K0] ;
 s (i : Fin (suc k)) : A.R = cv.1 i ;
 c (i : Fin (suc k)) : A.R = cv.2.1 i ;
 last : A.R = s (inr tt) ;
 b : A.R = FiniteIdeal[l].Sums[A].sum k (\ i -> A.mul (c (inl i)) (s (inl i))) ;
 comaximal : Comaximal[l].Over[A].Comaximal last b =
  (c (inr tt),(A.o,trans (cong2 A.R A.add _ _ _ _ (A.mulC last (c (inr tt))) (A.mulO b)) cv.2.2)) ;
 -- A_b, and the cover of A_b by the images of s_1 .. s_k
 module LB = LA.Inclusion[b].LX ;
 module SB = FiniteIdeal[l].Sums[LB.ring] ;
 b-power : LA.Powers b b = (suc zero,A.mulO b) ;
 binv : LB.ring.R = (LB.inverse b b-power).1 ;
 t (i : Fin k) : LB.ring.R = LB.constant (s (inl i)) ;
 c' (i : Fin k) : LB.ring.R = LB.ring.mul binv (LB.constant (c (inl i))) ;
 cover-sum : Id LB.ring.R (SB.sum k (\ i -> LB.ring.mul (c' i) (t i))) LB.ring.o =
  calc LB.ring.R { SB.sum k (\ i -> LB.ring.mul (c' i) (t i))
    =< SB.sum-cong k _ (\ i -> LB.ring.mul binv (LB.constant (A.mul (c (inl i)) (s (inl i)))))
        (\ i -> trans (sym (LB.ring.mulA binv (LB.constant (c (inl i))) (t i)))
         (ap (LB.ring.mul binv) (sym (LB.constant-mul (c (inl i)) (s (inl i)))))) >
       SB.sum k (\ i -> LB.ring.mul binv (LB.constant (A.mul (c (inl i)) (s (inl i)))))
    =< SB.sum-scale binv k (\ i -> LB.constant (A.mul (c (inl i)) (s (inl i)))) >
       LB.ring.mul binv (SB.sum k (\ i -> LB.constant (A.mul (c (inl i)) (s (inl i)))))
    =< ap (LB.ring.mul binv) (sym (MatrixMap[l].hom-sum A LB.ring LB.inclusion k (\ i -> A.mul (c (inl i)) (s (inl i))))) >
       LB.ring.mul binv (LB.constant b)
    =< LB.ring.mulC binv (LB.constant b) > LB.ring.mul (LB.constant b) binv
    =< (LB.inverse b b-power).2 > LB.ring.o } ;
 cover : Cover LB.ring k = (t,(c',cover-sum)) ;
 module RB = K0Restriction[l].Over[A,LB.ring,setA,LB.set,LB.inclusion] ;
 xb : RB.KB.K0.R = RB.restrict.1 x ;
 -- x restricts to 0 in (A_b)_(t_i), through A_(s_i)
 module V (i : Fin k) {
  module LS = LA.Inclusion[s (inl i)].LX ;
  module LT = Localisations[l].Over[LB.ring].Inclusion[t i].LX ;
  phi : H.Hom A LT.ring = H.compose A LB.ring LT.ring LT.inclusion LB.inclusion ;
  -- phi (s_i^m) = (t_i^m) / 1 is a unit
  power-image (m : Nat) : Id LT.ring.R (phi.1 (PA.power (s (inl i)) m)) (LT.constant (AffinePowers[l].Over[LB.ring].power (t i) m)) =
   ap LT.constant (AffinePowers[l].power-map A LB.ring LB.inclusion (s (inl i)) m) ;
  units (u : A.R) (hu : LA.Powers (s (inl i)) u) : RL[LT.ring].unit (phi.1 u) =
   ((LT.inverse (AffinePowers[l].Over[LB.ring].power (t i) hu.1) (Localisations[l].Over[LB.ring].power-in (t i) hu.1)).1,
    trans (ap (\ v -> LT.ring.mul v (LT.inverse (AffinePowers[l].Over[LB.ring].power (t i) hu.1)
       (Localisations[l].Over[LB.ring].power-in (t i) hu.1)).1)
      (trans (ap phi.1 (sym hu.2)) (power-image hu.1)))
     (LT.inverse (AffinePowers[l].Over[LB.ring].power (t i) hu.1) (Localisations[l].Over[LB.ring].power-in (t i) hu.1)).2) ;
  module J = MonoidLocalizationMap[l].Over[A,LA.Powers (s (inl i)),LA.powers-one (s (inl i)),LA.powers-product (s (inl i)),
   LT.ring,LT.set,phi,units] ;
  psi : H.Hom LS.ring LT.ring = J.hom ;
  module RT = K0Restriction[l].Over[LB.ring,LT.ring,LB.set,LT.set,LT.inclusion] ;
  module RS = K0Restriction[l].Over[A,LS.ring,setA,LS.set,LS.inclusion] ;
  module RP = K0Restriction[l].Over[LS.ring,LT.ring,LS.set,LT.set,psi] ;
  vanishes : Vanishes LB.ring LB.set (t i) xb =
   calc RT.KB.K0.R { RT.restrict.1 (RB.restrict.1 x)
     =< K0Restriction[l].Compose[A,LB.ring,LT.ring,setA,LB.set,LT.set,LB.inclusion,LT.inclusion].theorem x >
        K0Restriction[l].Over[A,LT.ring,setA,LT.set,phi].restrict.1 x
     =< K0Restriction[l].Pointwise[A,LT.ring,setA,LT.set,phi,H.compose A LS.ring LT.ring psi LS.inclusion,
         \ r -> sym (J.constants r)].theorem x >
        K0Restriction[l].Over[A,LT.ring,setA,LT.set,H.compose A LS.ring LT.ring psi LS.inclusion].restrict.1 x
     =< sym (K0Restriction[l].Compose[A,LS.ring,LT.ring,setA,LS.set,LT.set,LS.inclusion,psi].theorem x) >
        RP.restrict.1 (RS.restrict.1 x)
     =< ap RP.restrict.1 (h (inl i)) > RP.restrict.1 RS.KB.K0.z
     =< H.zero RS.KB.K0 RP.KB.K0 RP.restrict > RT.KB.K0.z } ;
 } ;
 nilpotent-b : Nilpotent LB.ring LB.set xb = ih LB.ring LB.set cover xb (\ i -> V[i].vanishes) ;
 -- y = x^(m+1) restricts to 0 in A_b and in A_s
 module With (m : Nat) (hm : Id RB.KB.K0.R (AffinePowers[l].Over[RB.KB.K0].power xb m) RB.KB.K0.z) {
  y : K.K0.R = PK.power x (suc m) ;
  module I = LA.Instance[setA,last,b,Tr.Trunc[Comaximal[l].Over[A].Comaximal last b].inc comaximal] ;
  module RA = K0Restriction[l].Over[A,I.Aa.ring,setA,I.Aa.set,I.Aa.inclusion] ;
  module RB' = K0Restriction[l].Over[A,I.Ab.ring,setA,I.Ab.set,I.Ab.inclusion] ;
  va : Id RA.KB.K0.R (RA.restrict.1 y) RA.KB.K0.z =
   calc RA.KB.K0.R { RA.restrict.1 y
     =< AffinePowers[l].power-map K.K0 RA.KB.K0 RA.restrict x (suc m) > AffinePowers[l].Over[RA.KB.K0].power (RA.restrict.1 x) (suc m)
     =< ap (\ v -> RA.KB.K0.mul v (AffinePowers[l].Over[RA.KB.K0].power (RA.restrict.1 x) m)) (h (inr tt)) >
        RA.KB.K0.mul RA.KB.K0.z (AffinePowers[l].Over[RA.KB.K0].power (RA.restrict.1 x) m)
     =< RL[RA.KB.K0].zero-mul (AffinePowers[l].Over[RA.KB.K0].power (RA.restrict.1 x) m) > RA.KB.K0.z } ;
  vb : Id RB'.KB.K0.R (RB'.restrict.1 y) RB'.KB.K0.z =
   calc RB'.KB.K0.R { RB'.restrict.1 y
     =< AffinePowers[l].power-map K.K0 RB'.KB.K0 RB'.restrict x (suc m) > AffinePowers[l].Over[RB'.KB.K0].power xb (suc m)
     =< ap (RB'.KB.K0.mul xb) hm > RB'.KB.K0.mul xb RB'.KB.K0.z
     =< RL[RB'.KB.K0].mul-zero xb > RB'.KB.K0.z } ;
  y-square : Id K.K0.R (K.K0.mul y y) K.K0.z =
   Square[A,I.Aa.ring,I.Ab.ring,I.C.ring,setA,I.Aa.set,I.Ab.set,I.C.set,I.Aa.inclusion,I.Ab.inclusion,I.Sa.j,I.Sb.j,
    I.square,last,b,LA.Inclusion[last].localising,LA.Inclusion[b].localising,I.Sa.localising,I.Sb.localising,
    Tr.Trunc[Comaximal[l].Over[A].Comaximal last b].inc comaximal,y,va,vb].theorem ;
  nilpotent : Nilpotent A setA x =
   Tr.Trunc[(n : Nat) * Id K.K0.R (PK.power x n) K.K0.z].inc
    (plus (suc m) (suc m),trans (PK.power-add x (suc m) (suc m)) y-square) ;
 } ;
 nilpotent : Nilpotent A setA x =
  TC.bind ((m : Nat) * Id RB.KB.K0.R (AffinePowers[l].Over[RB.KB.K0].power xb m) RB.KB.K0.z)
   ((n : Nat) * Id K.K0.R (PK.power x n) K.K0.z) (\ v -> With[v.1,v.2].nilpotent) nilpotent-b ;
} ;

nil : (k : Nat) -> Statement k = split {
 zero -> \ A setA cv x h -> Tr.Trunc[(n : Nat) * Id K0[l].Over[A,setA].K0.R (AffinePowers[l].Over[K0[l].Over[A,setA].K0].power x n)
   K0[l].Over[A,setA].K0.z].inc (suc zero,trans (K0[l].Over[A,setA].K0.mulO x) (Trivial[A,setA,cv.2.2].zero x)) ;
 suc k | ih -> \ A setA cv x h -> Step[k,ih,A,setA,cv,x,h].nilpotent } ;
