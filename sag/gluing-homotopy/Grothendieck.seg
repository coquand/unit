-- The Grothendieck ring of a commutative semiring T (SEMIRING).  A pair
-- (a, b) stands for a - b, and (a, b) ~ (c, d) when a + d + u = c + b + u
-- for some u (merely).  This is an equivalence relation: for transitivity
-- add the two equations and cancel nothing, taking u + v + q1 + q2 as the
-- new u.  The operations
--     (a,b) + (c,d) = (a+c, b+d),    -(a,b) = (b,a),
--     (a,b)(c,d) = (ac+bd, ad+bc),   0 = (0,0),   1 = (1,0)
-- respect ~ (for the product: if a + b' + u = a' + b + u then
-- (a + b' + u) c + (a' + b + u) d = (a' + b + u) c + (a + b' + u) d, which
-- is the required equation with u c + u d as the new u), and the ring laws
-- hold for pairs, as equations of T after expanding.  The class of a is
-- (a, 0); it is additive and multiplicative, and a, b have the same class
-- iff a + u = b + u for some u.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (T : Semiring[l].CSemiring) {
 -- laws of T used below
 zl (x : T.S) : Id T.S (T.add T.zero x) x = trans (T.addC T.zero x) (T.addZ x) ;
 zm (x : T.S) : Id T.S (T.mul T.zero x) T.zero = trans (T.mulC T.zero x) (T.mulZ x) ;
 dr (x y z : T.S) : Id T.S (T.mul (T.add x y) z) (T.add (T.mul x z) (T.mul y z)) =
  trans (T.mulC (T.add x y) z) (trans (T.dist z x y) (cong2 T.S T.add _ _ _ _ (T.mulC z x) (T.mulC z y))) ;
 inter (a b c d : T.S) : Id T.S (T.add (T.add a b) (T.add c d)) (T.add (T.add a c) (T.add b d)) =
  calc T.S { T.add (T.add a b) (T.add c d)
    =< sym (T.addA a b (T.add c d)) > T.add a (T.add b (T.add c d))
    =< ap (T.add a) (T.addA b c d) > T.add a (T.add (T.add b c) d)
    =< ap (\ t -> T.add a (T.add t d)) (T.addC b c) > T.add a (T.add (T.add c b) d)
    =< ap (T.add a) (sym (T.addA c b d)) > T.add a (T.add c (T.add b d))
    =< T.addA a c (T.add b d) > T.add (T.add a c) (T.add b d) } ;
 -- ((a+b)+(c+d))+(u+v) = ((a+d)+u)+((c+b)+v)
 regroup (a b c d u v : T.S) :
  Id T.S (T.add (T.add (T.add a b) (T.add c d)) (T.add u v)) (T.add (T.add (T.add a d) u) (T.add (T.add c b) v)) =
  calc T.S { T.add (T.add (T.add a b) (T.add c d)) (T.add u v)
    =< ap (\ t -> T.add (T.add (T.add a b) t) (T.add u v)) (T.addC c d) > T.add (T.add (T.add a b) (T.add d c)) (T.add u v)
    =< ap (\ t -> T.add t (T.add u v)) (inter a b d c) > T.add (T.add (T.add a d) (T.add b c)) (T.add u v)
    =< inter (T.add a d) (T.add b c) u v > T.add (T.add (T.add a d) u) (T.add (T.add b c) v)
    =< ap (\ t -> T.add (T.add (T.add a d) u) (T.add t v)) (T.addC b c) > T.add (T.add (T.add a d) u) (T.add (T.add c b) v) } ;
 -- ((a+b)+(c+d))+(u+v) = ((a+c)+u)+((b+d)+v)
 regroup2 (a b c d u v : T.S) :
  Id T.S (T.add (T.add (T.add a b) (T.add c d)) (T.add u v)) (T.add (T.add (T.add a c) u) (T.add (T.add b d) v)) =
  trans (ap (\ t -> T.add t (T.add u v)) (inter a b c d)) (inter (T.add a c) (T.add b d) u v) ;
 -- (x y + z w) v = x (y v) + z (w v)
 expand (x y z w v : T.S) : Id T.S (T.mul (T.add (T.mul x y) (T.mul z w)) v) (T.add (T.mul x (T.mul y v)) (T.mul z (T.mul w v))) =
  trans (dr (T.mul x y) (T.mul z w) v) (cong2 T.S T.add _ _ _ _ (sym (T.mulA x y v)) (sym (T.mulA z w v))) ;

 Pair : U l = T.S * T.S ;
 set-pair : Pr.isSet Pair = Pr.isSet-Sigma T.S (\ x -> T.S) T.setS (\ x -> T.setS) ;
 pair-eq (x x' y y' : T.S) (p : Id T.S x x') (q : Id T.S y y') : Id Pair (x,y) (x',y') =
  Pr.trans Pair (x,y) (x',y) (x',y') (Pr.ap T.S Pair (\ t -> (t,y)) x x' p) (Pr.ap T.S Pair (\ t -> (x',t)) y y' q) ;
 Witness (p q : Pair) (u : T.S) : U l = Id T.S (T.add (T.add p.1 q.2) u) (T.add (T.add q.1 p.2) u) ;
 Rel (p q : Pair) : U l = Tr.Trunc[(u : T.S) * Witness p q u].carrier ;
 rel-prop (p q : Pair) : Pr.isProp (Rel p q) = Tr.Trunc[(u : T.S) * Witness p q u].proposition ;
 rel-refl (p : Pair) : Rel p p = Tr.Trunc[(u : T.S) * Witness p p u].inc (T.zero,refl (T.add (T.add p.1 p.2) T.zero)) ;
 rel-eq (p q : Pair) (e : Id Pair p q) : Rel p q = subst (Rel p) e (rel-refl p) ;
 rel-sym (p q : Pair) (h : Rel p q) : Rel q p =
  TC.map ((u : T.S) * Witness p q u) ((u : T.S) * Witness q p u) (\ w -> (w.1,sym w.2)) h ;
 module Trans (p q r : Pair) (w : (u : T.S) * Witness p q u) (v : (u : T.S) * Witness q r u) {
  witness : (u : T.S) * Witness p r u = (T.add (T.add q.1 q.2) (T.add w.1 v.1),
   calc T.S { T.add (T.add p.1 r.2) (T.add (T.add q.1 q.2) (T.add w.1 v.1))
     =< T.addA (T.add p.1 r.2) (T.add q.1 q.2) (T.add w.1 v.1) >
        T.add (T.add (T.add p.1 r.2) (T.add q.1 q.2)) (T.add w.1 v.1)
     =< ap (\ t -> T.add t (T.add w.1 v.1)) (trans (inter p.1 r.2 q.1 q.2) (ap (T.add (T.add p.1 q.1)) (T.addC r.2 q.2))) >
        T.add (T.add (T.add p.1 q.1) (T.add q.2 r.2)) (T.add w.1 v.1)
     =< sym (ap (\ t -> T.add t (T.add w.1 v.1)) (inter p.1 q.2 q.1 r.2)) >
        T.add (T.add (T.add p.1 q.2) (T.add q.1 r.2)) (T.add w.1 v.1)
     =< inter (T.add p.1 q.2) (T.add q.1 r.2) w.1 v.1 >
        T.add (T.add (T.add p.1 q.2) w.1) (T.add (T.add q.1 r.2) v.1)
     =< cong2 T.S T.add _ _ _ _ w.2 v.2 >
        T.add (T.add (T.add q.1 p.2) w.1) (T.add (T.add r.1 q.2) v.1)
     =< T.addC (T.add (T.add q.1 p.2) w.1) (T.add (T.add r.1 q.2) v.1) >
        T.add (T.add (T.add r.1 q.2) v.1) (T.add (T.add q.1 p.2) w.1)
     =< sym (inter (T.add r.1 q.2) (T.add q.1 p.2) v.1 w.1) >
        T.add (T.add (T.add r.1 q.2) (T.add q.1 p.2)) (T.add v.1 w.1)
     =< ap (\ t -> T.add t (T.add v.1 w.1)) (inter r.1 q.2 q.1 p.2) >
        T.add (T.add (T.add r.1 q.1) (T.add q.2 p.2)) (T.add v.1 w.1)
     =< ap (\ t -> T.add t (T.add v.1 w.1)) (trans (ap (T.add (T.add r.1 q.1)) (T.addC q.2 p.2)) (sym (inter r.1 p.2 q.1 q.2))) >
        T.add (T.add (T.add r.1 p.2) (T.add q.1 q.2)) (T.add v.1 w.1)
     =< sym (T.addA (T.add r.1 p.2) (T.add q.1 q.2) (T.add v.1 w.1)) >
        T.add (T.add r.1 p.2) (T.add (T.add q.1 q.2) (T.add v.1 w.1))
     =< ap (\ t -> T.add (T.add r.1 p.2) (T.add (T.add q.1 q.2) t)) (T.addC v.1 w.1) >
        T.add (T.add r.1 p.2) (T.add (T.add q.1 q.2) (T.add w.1 v.1)) }) ;
 } ;
 rel-trans (p q r : Pair) (h : Rel p q) (k : Rel q r) : Rel p r =
  TC.map2 ((u : T.S) * Witness p q u) ((u : T.S) * Witness q r u) ((u : T.S) * Witness p r u)
   (\ w v -> Trans[p,q,r,w,v].witness) h k ;

 -- operations on pairs
 padd (p q : Pair) : Pair = (T.add p.1 q.1,T.add p.2 q.2) ;
 pneg (p : Pair) : Pair = (p.2,p.1) ;
 pmul (p q : Pair) : Pair = (T.add (T.mul p.1 q.1) (T.mul p.2 q.2),T.add (T.mul p.1 q.2) (T.mul p.2 q.1)) ;
 pzero : Pair = (T.zero,T.zero) ;
 pone : Pair = (T.one,T.zero) ;
 add-cong (p p' q q' : Pair) (h : Rel p p') (k : Rel q q') : Rel (padd p q) (padd p' q') =
  TC.map2 ((u : T.S) * Witness p p' u) ((u : T.S) * Witness q q' u) ((u : T.S) * Witness (padd p q) (padd p' q') u)
   (\ w v -> (T.add w.1 v.1,
    trans (regroup2 p.1 q.1 p'.2 q'.2 w.1 v.1)
     (trans (cong2 T.S T.add _ _ _ _ w.2 v.2) (sym (regroup2 p'.1 q'.1 p.2 q.2 w.1 v.1))))) h k ;
 neg-cong (p p' : Pair) (h : Rel p p') : Rel (pneg p) (pneg p') =
  TC.map ((u : T.S) * Witness p p' u) ((u : T.S) * Witness (pneg p) (pneg p') u)
   (\ w -> (w.1,calc T.S { T.add (T.add p.2 p'.1) w.1
     =< ap (\ t -> T.add t w.1) (T.addC p.2 p'.1) > T.add (T.add p'.1 p.2) w.1
     =< sym w.2 > T.add (T.add p.1 p'.2) w.1
     =< ap (\ t -> T.add t w.1) (T.addC p.1 p'.2) > T.add (T.add p'.2 p.1) w.1 })) h ;
 pmul-comm (p q : Pair) : Id Pair (pmul p q) (pmul q p) =
  pair-eq _ _ _ _ (cong2 T.S T.add _ _ _ _ (T.mulC p.1 q.1) (T.mulC p.2 q.2))
   (trans (cong2 T.S T.add _ _ _ _ (T.mulC p.1 q.2) (T.mulC p.2 q.1)) (T.addC (T.mul q.2 p.1) (T.mul q.1 p.2))) ;
 module MulLeft (p p' q : Pair) (w : (u : T.S) * Witness p p' u) {
  X : T.S = T.add (T.add p.1 p'.2) w.1 ;
  Y : T.S = T.add (T.add p'.1 p.2) w.1 ;
  -- (x + y) + u, multiplied by c
  spread (x y c : T.S) : Id T.S (T.mul (T.add (T.add x y) w.1) c) (T.add (T.add (T.mul x c) (T.mul y c)) (T.mul w.1 c)) =
   trans (dr (T.add x y) w.1 c) (ap (\ t -> T.add t (T.mul w.1 c)) (dr x y c)) ;
  witness : (u : T.S) * Witness (pmul p q) (pmul p' q) u = (T.add (T.mul w.1 q.1) (T.mul w.1 q.2),
   calc T.S { T.add (T.add (T.add (T.mul p.1 q.1) (T.mul p.2 q.2)) (T.add (T.mul p'.1 q.2) (T.mul p'.2 q.1)))
       (T.add (T.mul w.1 q.1) (T.mul w.1 q.2))
     =< regroup (T.mul p.1 q.1) (T.mul p.2 q.2) (T.mul p'.1 q.2) (T.mul p'.2 q.1) (T.mul w.1 q.1) (T.mul w.1 q.2) >
        T.add (T.add (T.add (T.mul p.1 q.1) (T.mul p'.2 q.1)) (T.mul w.1 q.1)) (T.add (T.add (T.mul p'.1 q.2) (T.mul p.2 q.2)) (T.mul w.1 q.2))
     =< sym (cong2 T.S T.add _ _ _ _ (spread p.1 p'.2 q.1) (spread p'.1 p.2 q.2)) > T.add (T.mul X q.1) (T.mul Y q.2)
     =< cong2 T.S T.add _ _ _ _ (ap (\ t -> T.mul t q.1) w.2) (ap (\ t -> T.mul t q.2) (sym w.2)) > T.add (T.mul Y q.1) (T.mul X q.2)
     =< cong2 T.S T.add _ _ _ _ (spread p'.1 p.2 q.1) (spread p.1 p'.2 q.2) >
        T.add (T.add (T.add (T.mul p'.1 q.1) (T.mul p.2 q.1)) (T.mul w.1 q.1)) (T.add (T.add (T.mul p.1 q.2) (T.mul p'.2 q.2)) (T.mul w.1 q.2))
     =< sym (regroup (T.mul p'.1 q.1) (T.mul p'.2 q.2) (T.mul p.1 q.2) (T.mul p.2 q.1) (T.mul w.1 q.1) (T.mul w.1 q.2)) >
        T.add (T.add (T.add (T.mul p'.1 q.1) (T.mul p'.2 q.2)) (T.add (T.mul p.1 q.2) (T.mul p.2 q.1)))
         (T.add (T.mul w.1 q.1) (T.mul w.1 q.2)) }) ;
 } ;
 mul-left (p p' q : Pair) (h : Rel p p') : Rel (pmul p q) (pmul p' q) =
  TC.map ((u : T.S) * Witness p p' u) ((u : T.S) * Witness (pmul p q) (pmul p' q) u) (\ w -> MulLeft[p,p',q,w].witness) h ;
 mul-cong (p p' q q' : Pair) (h : Rel p p') (k : Rel q q') : Rel (pmul p q) (pmul p' q') =
  rel-trans _ _ _ (mul-left p p' q h)
   (rel-trans _ _ _ (rel-eq _ _ (pmul-comm p' q))
    (rel-trans _ _ _ (mul-left q q' p' k) (rel-eq _ _ (pmul-comm q' p')))) ;

 -- the quotient
 module Q = Quotient[l].Quot[Pair,Rel,rel-prop,rel-refl,rel-sym,rel-trans] ;
 Carrier : U l = Q.Q ;
 include : Pair -> Carrier = Q.inc ;
 set : Pr.isSet Carrier = Q.set ;
 module Binary (op : Pair -> Pair -> Pair) (cong : (a a' b b' : Pair) -> Rel a a' -> Rel b b' -> Rel (op a b) (op a' b')) {
  module Right (a : Pair) {
   module D = Q.Descend[Carrier,set,\ b -> include (op a b),\ b b' h -> Q.relates _ _ (cong a a b b' (rel-refl a) h)] ;
  } ;
  left-respects (a a' : Pair) (h : Rel a a') : Id (Carrier -> Carrier) Right[a].D.map Right[a'].D.map =
   F.funext Carrier (\ q -> Carrier) _ _
    (Q.induction @l (\ q -> Id Carrier (Right[a].D.map q) (Right[a'].D.map q)) (\ q -> set _ _)
     (\ b -> trans (Right[a].D.beta b) (trans (Q.relates _ _ (cong a a' b b h (rel-refl b))) (sym (Right[a'].D.beta b))))) ;
  module Left = Q.Descend[Carrier -> Carrier,F.isSet-Pi Carrier (\ q -> Carrier) (\ q -> set),\ a -> Right[a].D.map,left-respects] ;
  operation : Carrier -> Carrier -> Carrier = Left.map ;
  beta (a b : Pair) : Id Carrier (operation (include a) (include b)) (include (op a b)) =
   trans (Pr.happly Carrier (\ q -> Carrier) _ _ (Left.beta a) (include b)) (Right[a].D.beta b) ;
 } ;
 module Plus2 = Binary[padd,add-cong] ;
 module Times2 = Binary[pmul,mul-cong] ;
 module Negate = Q.Descend[Carrier,set,\ p -> include (pneg p),\ p q h -> Q.relates _ _ (neg-cong p q h)] ;
 addG : Carrier -> Carrier -> Carrier = Plus2.operation ;
 mulG : Carrier -> Carrier -> Carrier = Times2.operation ;
 negG : Carrier -> Carrier = Negate.map ;
 zeroG : Carrier = include pzero ;
 oneG : Carrier = include pone ;
 forall1 (B : Carrier -> U l) (p : (x : Carrier) -> Pr.isProp (B x)) (b : (a : Pair) -> B (include a)) : (x : Carrier) -> B x =
  Q.induction @l B p b ;
 forall2 (B : Carrier -> Carrier -> U l) (p : (x y : Carrier) -> Pr.isProp (B x y))
  (b : (a c : Pair) -> B (include a) (include c)) : (x y : Carrier) -> B x y =
  Q.induction @l (\ x -> (y : Carrier) -> B x y) (\ x -> F.isProp-Pi Carrier (B x) (p x))
   (\ a -> Q.induction @l (B (include a)) (p (include a)) (b a)) ;
 forall3 (B : Carrier -> Carrier -> Carrier -> U l) (p : (x y z : Carrier) -> Pr.isProp (B x y z))
  (b : (a c d : Pair) -> B (include a) (include c) (include d)) : (x y z : Carrier) -> B x y z =
  forall2 (\ x y -> (z : Carrier) -> B x y z) (\ x y -> F.isProp-Pi Carrier (B x y) (p x y))
   (\ a c -> Q.induction @l (B (include a) (include c)) (p (include a) (include c)) (b a c)) ;
 add2 (a b : Pair) : Id Carrier (addG (include a) (include b)) (include (padd a b)) = Plus2.beta a b ;
 mul2 (a b : Pair) : Id Carrier (mulG (include a) (include b)) (include (pmul a b)) = Times2.beta a b ;

 -- the laws for pairs
 padd-assoc (a b c : Pair) : Id Pair (padd a (padd b c)) (padd (padd a b) c) = pair-eq _ _ _ _ (T.addA a.1 b.1 c.1) (T.addA a.2 b.2 c.2) ;
 padd-comm (a b : Pair) : Id Pair (padd a b) (padd b a) = pair-eq _ _ _ _ (T.addC a.1 b.1) (T.addC a.2 b.2) ;
 padd-zero (a : Pair) : Id Pair (padd a pzero) a = pair-eq _ _ _ _ (T.addZ a.1) (T.addZ a.2) ;
 padd-neg (a : Pair) : Rel (padd a (pneg a)) pzero =
  Tr.Trunc[(u : T.S) * Witness (padd a (pneg a)) pzero u].inc (T.zero,
   ap (\ t -> T.add t T.zero) (trans (T.addZ (T.add a.1 a.2)) (trans (T.addC a.1 a.2) (sym (zl (T.add a.2 a.1)))))) ;
 pmul-one (a : Pair) : Id Pair (pmul a pone) a =
  pair-eq _ _ _ _ (trans (cong2 T.S T.add _ _ _ _ (T.mulO a.1) (T.mulZ a.2)) (T.addZ a.1))
   (trans (cong2 T.S T.add _ _ _ _ (T.mulZ a.1) (T.mulO a.2)) (zl a.2)) ;
 pmul-dist (a b c : Pair) : Id Pair (pmul a (padd b c)) (padd (pmul a b) (pmul a c)) =
  pair-eq _ _ _ _
   (trans (cong2 T.S T.add _ _ _ _ (T.dist a.1 b.1 c.1) (T.dist a.2 b.2 c.2)) (inter (T.mul a.1 b.1) (T.mul a.1 c.1) (T.mul a.2 b.2) (T.mul a.2 c.2)))
   (trans (cong2 T.S T.add _ _ _ _ (T.dist a.1 b.2 c.2) (T.dist a.2 b.1 c.1)) (inter (T.mul a.1 b.2) (T.mul a.1 c.2) (T.mul a.2 b.1) (T.mul a.2 c.1))) ;
 -- a (b c) = (a b) c: both sides are sums of the same four products
 shape (x1 x2 x3 x4 : T.S) : Id T.S (T.add (T.add x1 x3) (T.add x4 x2)) (T.add (T.add x1 x2) (T.add x3 x4)) =
  trans (ap (T.add (T.add x1 x3)) (T.addC x4 x2)) (inter x1 x3 x2 x4) ;
 pmul-assoc (a b c : Pair) : Id Pair (pmul a (pmul b c)) (pmul (pmul a b) c) =
  pair-eq _ _ _ _
   (trans (cong2 T.S T.add _ _ _ _ (T.dist a.1 (T.mul b.1 c.1) (T.mul b.2 c.2)) (T.dist a.2 (T.mul b.1 c.2) (T.mul b.2 c.1)))
    (trans (shape (T.mul a.1 (T.mul b.1 c.1)) (T.mul a.2 (T.mul b.2 c.1)) (T.mul a.1 (T.mul b.2 c.2)) (T.mul a.2 (T.mul b.1 c.2)))
     (sym (cong2 T.S T.add _ _ _ _ (expand a.1 b.1 a.2 b.2 c.1) (expand a.1 b.2 a.2 b.1 c.2)))))
   (trans (cong2 T.S T.add _ _ _ _ (T.dist a.1 (T.mul b.1 c.2) (T.mul b.2 c.1)) (T.dist a.2 (T.mul b.1 c.1) (T.mul b.2 c.2)))
    (trans (shape (T.mul a.1 (T.mul b.1 c.2)) (T.mul a.2 (T.mul b.2 c.2)) (T.mul a.1 (T.mul b.2 c.1)) (T.mul a.2 (T.mul b.1 c.1)))
     (sym (cong2 T.S T.add _ _ _ _ (expand a.1 b.1 a.2 b.2 c.2) (expand a.1 b.2 a.2 b.1 c.1))))) ;

 -- the ring laws at representatives
 addA-at (a b c : Pair) : Id Carrier (addG (include a) (addG (include b) (include c))) (addG (addG (include a) (include b)) (include c)) =
  calc Carrier { addG (include a) (addG (include b) (include c))
    =< ap (addG (include a)) (add2 b c) > addG (include a) (include (padd b c))
    =< add2 a (padd b c) > include (padd a (padd b c))
    =< ap include (padd-assoc a b c) > include (padd (padd a b) c)
    =< sym (add2 (padd a b) c) > addG (include (padd a b)) (include c)
    =< ap (\ t -> addG t (include c)) (sym (add2 a b)) > addG (addG (include a) (include b)) (include c) } ;
 mulA-at (a b c : Pair) : Id Carrier (mulG (include a) (mulG (include b) (include c))) (mulG (mulG (include a) (include b)) (include c)) =
  calc Carrier { mulG (include a) (mulG (include b) (include c))
    =< ap (mulG (include a)) (mul2 b c) > mulG (include a) (include (pmul b c))
    =< mul2 a (pmul b c) > include (pmul a (pmul b c))
    =< ap include (pmul-assoc a b c) > include (pmul (pmul a b) c)
    =< sym (mul2 (pmul a b) c) > mulG (include (pmul a b)) (include c)
    =< ap (\ t -> mulG t (include c)) (sym (mul2 a b)) > mulG (mulG (include a) (include b)) (include c) } ;
 dist-at (a b c : Pair) : Id Carrier (mulG (include a) (addG (include b) (include c))) (addG (mulG (include a) (include b)) (mulG (include a) (include c))) =
  calc Carrier { mulG (include a) (addG (include b) (include c))
    =< ap (mulG (include a)) (add2 b c) > mulG (include a) (include (padd b c))
    =< mul2 a (padd b c) > include (pmul a (padd b c))
    =< ap include (pmul-dist a b c) > include (padd (pmul a b) (pmul a c))
    =< sym (add2 (pmul a b) (pmul a c)) > addG (include (pmul a b)) (include (pmul a c))
    =< cong2 Carrier addG _ _ _ _ (sym (mul2 a b)) (sym (mul2 a c)) > addG (mulG (include a) (include b)) (mulG (include a) (include c)) } ;
 ring : CRing = new CRing[Carrier,zeroG,oneG,addG,mulG,negG,
  forall3 (\ x y z -> Id Carrier (addG x (addG y z)) (addG (addG x y) z)) (\ x y z -> set _ _) addA-at,
  forall2 (\ x y -> Id Carrier (addG x y) (addG y x)) (\ x y -> set _ _)
   (\ a b -> trans (add2 a b) (trans (ap include (padd-comm a b)) (sym (add2 b a)))),
  forall1 (\ x -> Id Carrier (addG x zeroG) x) (\ x -> set _ _) (\ a -> trans (add2 a pzero) (ap include (padd-zero a))),
  forall1 (\ x -> Id Carrier (addG x (negG x)) zeroG) (\ x -> set _ _)
   (\ a -> trans (ap (addG (include a)) (Negate.beta a)) (trans (add2 a (pneg a)) (Q.relates _ _ (padd-neg a)))),
  forall3 (\ x y z -> Id Carrier (mulG x (mulG y z)) (mulG (mulG x y) z)) (\ x y z -> set _ _) mulA-at,
  forall2 (\ x y -> Id Carrier (mulG x y) (mulG y x)) (\ x y -> set _ _)
   (\ a b -> trans (mul2 a b) (trans (ap include (pmul-comm a b)) (sym (mul2 b a)))),
  forall1 (\ x -> Id Carrier (mulG x oneG) x) (\ x -> set _ _) (\ a -> trans (mul2 a pone) (ap include (pmul-one a))),
  forall3 (\ x y z -> Id Carrier (mulG x (addG y z)) (addG (mulG x y) (mulG x z))) (\ x y z -> set _ _) dist-at] ;

 -- the class of an element of T
 class (s : T.S) : Carrier = include (s,T.zero) ;
 class-add (s t : T.S) : Id Carrier (addG (class s) (class t)) (class (T.add s t)) =
  trans (add2 (s,T.zero) (t,T.zero)) (ap include (pair-eq _ _ _ _ (refl (T.add s t)) (T.addZ T.zero))) ;
 class-mul (s t : T.S) : Id Carrier (mulG (class s) (class t)) (class (T.mul s t)) =
  trans (mul2 (s,T.zero) (t,T.zero)) (ap include (pair-eq _ _ _ _
   (trans (ap (T.add (T.mul s t)) (T.mulZ T.zero)) (T.addZ (T.mul s t)))
   (trans (cong2 T.S T.add _ _ _ _ (T.mulZ s) (zm t)) (T.addZ T.zero)))) ;
 class-one : Id Carrier oneG (class T.one) = refl oneG ;
 class-zero : Id Carrier zeroG (class T.zero) = refl zeroG ;
 Stable (s t : T.S) : U l = Tr.Trunc[(u : T.S) * Id T.S (T.add s u) (T.add t u)].carrier ;
 -- a and b have the same class iff a + u = b + u for some u
 effective (s t : T.S) (h : Id Carrier (class s) (class t)) : Stable s t =
  TC.map ((u : T.S) * Witness (s,T.zero) (t,T.zero) u) ((u : T.S) * Id T.S (T.add s u) (T.add t u))
   (\ w -> (w.1,trans (ap (\ x -> T.add x w.1) (sym (T.addZ s))) (trans w.2 (ap (\ x -> T.add x w.1) (T.addZ t)))))
   (Q.effective (s,T.zero) (t,T.zero) h) ;
 same-class (s t : T.S) (h : Stable s t) : Id Carrier (class s) (class t) =
  Q.relates (s,T.zero) (t,T.zero)
   (TC.map ((u : T.S) * Id T.S (T.add s u) (T.add t u)) ((u : T.S) * Witness (s,T.zero) (t,T.zero) u)
    (\ w -> (w.1,trans (ap (\ x -> T.add x w.1) (T.addZ s)) (trans w.2 (ap (\ x -> T.add x w.1) (sym (T.addZ t))))))
    h) ;
} ;
