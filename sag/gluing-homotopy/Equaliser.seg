-- The sheaf property of the square, for P_1 = A^M (GLUEDFREE).  Let
-- ia : A -> A_a be localising at a and ib : A -> A_b localising at b
-- (LOCALISING), and A_a -> C, A_b -> C as in HOMOTOPY, with a, b comaximal.
-- If u in A_a and v in A_b have the same image in C, there is exactly one
-- r in A with ia r = u and ib r = v.
--
-- Proof.  If psi is localising at s and psi r = psi r', then
-- s^e r = s^e r' for some e: kill r - r' (Equalise).
-- (unique) If ia r = ia r' and ib r = ib r', then a^e r = a^e r' and
--   b^f r = b^f r'.  With a^e x + b^f y = 1, r = x a^e r + y b^f r = r'.
-- (exists) Clear the denominators: ia x = a^k u and ib y = b^m v.  Then
--   jb(a^k v) = ja(a^k u) = ja(ia x) = jb(ib x), so a^f a^k v = a^f x in A_b
--   for some f; likewise b^e b^m u = b^e y in A_a.  With K = f + k,
--   L = e + m, X = a^f x and Y = b^e y,
--     ia X = a^K u,   ib X = a^K v,   ia Y = b^L u,   ib Y = b^L v.
--   Write a^K p + b^L q = 1.  Then r = X p + Y q has ia r = u and ib r = v
--   (Combine: psi (X p + Y q) = (psi(a^K p) + psi(b^L q)) w = w).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Bd = ExponentBounds[l] ;

module Equalise (R C : CRing) (psi : H.Hom R C) (s : R.R) (loc : Localising[l].Over[R,C,psi,s].Localising) {
 module LS = Localising[l].Over[R,C,psi,s] ;
 module L = RL[R] ;
 Same (r r' : R.R) (k : Nat) : U l = Id R.R (R.mul (LS.pow k) r) (R.mul (LS.pow k) r') ;
 difference (r r' : R.R) (h : Id C.R (psi.1 r) (psi.1 r')) : Id C.R (psi.1 (R.add r (R.neg r'))) C.z =
  calc C.R { psi.1 (R.add r (R.neg r'))
    =< psi.2.2.1 r (R.neg r') > C.add (psi.1 r) (psi.1 (R.neg r'))
    =< cong2 C.R C.add _ _ _ _ h (H.negation R C psi r') > C.add (psi.1 r') (C.neg (psi.1 r'))
    =< C.addN (psi.1 r') > C.z } ;
 -- t (r - r') = 0 gives t r - t r' = 0, and x - y = 0 gives x = y
 distribute (t r r' : R.R) (h : Id R.R (R.mul t (R.add r (R.neg r'))) R.z) :
  Id R.R (R.add (R.mul t r) (R.neg (R.mul t r'))) R.z =
  trans (ap (R.add (R.mul t r)) (sym (L.mul-neg t r'))) (trans (sym (R.dist t r (R.neg r'))) h) ;
 cancel (x y : R.R) (h : Id R.R (R.add x (R.neg y)) R.z) : Id R.R x y =
  calc R.R { x =< sym (L.neg-neg x) > R.neg (R.neg x)
    =< ap R.neg (sym (L.neg-uniq x (R.neg y) h)) > R.neg (R.neg y)
    =< L.neg-neg y > y } ;
 same (r r' : R.R) (k : Nat) (h : LS.Kills (R.add r (R.neg r')) k) : Same r r' k =
  cancel (R.mul (LS.pow k) r) (R.mul (LS.pow k) r') (distribute (LS.pow k) r r' h) ;
 equalise (r r' : R.R) (h : Id C.R (psi.1 r) (psi.1 r')) : Bd.Merely (Same r r') =
  TC.map (Bd.Bound (LS.Kills (R.add r (R.neg r')))) (Bd.Bound (Same r r'))
   (\ w -> (w.1,same r r' w.1 w.2)) (loc.kill (R.add r (R.neg r')) (difference r r' h)) ;
} ;

module Combine (A T : CRing) (psi : H.Hom A T) (s t p q : A.R)
 (one : Id A.R (A.add (A.mul s p) (A.mul t q)) A.o) (w : T.R) (X Y : A.R)
 (hX : Id T.R (psi.1 X) (T.mul (psi.1 s) w)) (hY : Id T.R (psi.1 Y) (T.mul (psi.1 t) w)) {
 -- (c w) d = (c d) w
 move (c d : T.R) : Id T.R (T.mul (T.mul c w) d) (T.mul (T.mul c d) w) =
  trans (sym (T.mulA c w d)) (trans (ap (T.mul c) (T.mulC w d)) (T.mulA c d w)) ;
 value : Id T.R (psi.1 (A.add (A.mul X p) (A.mul Y q))) w =
  calc T.R { psi.1 (A.add (A.mul X p) (A.mul Y q))
    =< psi.2.2.1 (A.mul X p) (A.mul Y q) > T.add (psi.1 (A.mul X p)) (psi.1 (A.mul Y q))
    =< cong2 T.R T.add _ _ _ _ (psi.2.2.2 X p) (psi.2.2.2 Y q) > T.add (T.mul (psi.1 X) (psi.1 p)) (T.mul (psi.1 Y) (psi.1 q))
    =< cong2 T.R T.add _ _ _ _ (ap (\ c -> T.mul c (psi.1 p)) hX) (ap (\ c -> T.mul c (psi.1 q)) hY) >
       T.add (T.mul (T.mul (psi.1 s) w) (psi.1 p)) (T.mul (T.mul (psi.1 t) w) (psi.1 q))
    =< cong2 T.R T.add _ _ _ _ (move (psi.1 s) (psi.1 p)) (move (psi.1 t) (psi.1 q)) >
       T.add (T.mul (T.mul (psi.1 s) (psi.1 p)) w) (T.mul (T.mul (psi.1 t) (psi.1 q)) w)
    =< sym (RL[T].dist-left (T.mul (psi.1 s) (psi.1 p)) (T.mul (psi.1 t) (psi.1 q)) w) >
       T.mul (T.add (T.mul (psi.1 s) (psi.1 p)) (T.mul (psi.1 t) (psi.1 q))) w
    =< ap (\ c -> T.mul c w) (sym (trans (psi.2.2.1 (A.mul s p) (A.mul t q))
         (cong2 T.R T.add _ _ _ _ (psi.2.2.2 s p) (psi.2.2.2 t q)))) >
       T.mul (psi.1 (A.add (A.mul s p) (A.mul t q))) w
    =< ap (\ c -> T.mul (psi.1 c) w) one > T.mul (psi.1 A.o) w
    =< ap (\ c -> T.mul c w) psi.2.1 > T.mul T.o w
    =< RL[T].one-left w > w } ;
} ;

module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R) (setAb : Pr.isSet Ab.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier) {
 module RA = RL[A] ;
 module PA = AffinePowers[l].Over[A] ;
 module CM = Comaximal[l].Over[A] ;
 module KA = Localising[l].Over[A,Aa,ia,a] ;
 module KB = Localising[l].Over[A,Ab,ib,b] ;
 module KAb = Localising[l].Over[A,Ab,ib,a] ;
 module KBa = Localising[l].Over[A,Aa,ia,b] ;
 module EA = Equalise[A,Aa,ia,a,ka] ;
 module EB = Equalise[A,Ab,ib,b,kb] ;
 module ELa = Equalise[Aa,C,ja,ia.1 b,la] ;
 module ELb = Equalise[Ab,C,jb,ib.1 a,lb] ;
 Preimage (u : Aa.R) (v : Ab.R) : U l = (r : A.R) * Id Aa.R (ia.1 r) u * Id Ab.R (ib.1 r) v ;
 -- r = x (s r) + y (t r) when s x + t y = 1
 split-one (s t x y : A.R) (c : Id A.R (A.add (A.mul s x) (A.mul t y)) A.o) (r : A.R) :
  Id A.R r (A.add (A.mul x (A.mul s r)) (A.mul y (A.mul t r))) =
  calc A.R { r =< sym (RA.one-left r) > A.mul A.o r
    =< ap (\ e -> A.mul e r) (sym c) > A.mul (A.add (A.mul s x) (A.mul t y)) r
    =< RA.dist-left (A.mul s x) (A.mul t y) r > A.add (A.mul (A.mul s x) r) (A.mul (A.mul t y) r)
    =< cong2 A.R A.add _ _ _ _ (trans (sym (A.mulA s x r)) (RA.mul-swap s x r)) (trans (sym (A.mulA t y r)) (RA.mul-swap t y r)) >
       A.add (A.mul x (A.mul s r)) (A.mul y (A.mul t r)) } ;

 -- (unique)
 module Unique (r r' : A.R) (ha : Id Aa.R (ia.1 r) (ia.1 r')) (hb : Id Ab.R (ib.1 r) (ib.1 r')) {
  combine (e f : Nat) (pe : EA.Same r r' e) (pf : EB.Same r r' f) (c : CM.Comaximal (PA.power a e) (PA.power b f)) :
   Id A.R r r' =
   trans (split-one (PA.power a e) (PA.power b f) c.1 c.2.1 c.2.2 r)
    (trans (cong2 A.R A.add _ _ _ _ (ap (A.mul c.1) pe) (ap (A.mul c.2.1) pf))
     (sym (split-one (PA.power a e) (PA.power b f) c.1 c.2.1 c.2.2 r'))) ;
  equal : Id A.R r r' =
   TC.rec (Bd.Bound (EA.Same r r')) @l (Id A.R r r') (setA r r') (\ we ->
    TC.rec (Bd.Bound (EB.Same r r')) @l (Id A.R r r') (setA r r') (\ wf ->
     TC.rec (CM.Comaximal (PA.power a we.1) (PA.power b wf.1)) @l (Id A.R r r') (setA r r')
      (combine we.1 wf.1 we.2 wf.2) (CM.merely-powers a b comaximal we.1 wf.1))
     (EB.equalise r r' hb))
    (EA.equalise r r' ha) ;
 } ;
 preimage-prop (u : Aa.R) (v : Ab.R) : Pr.isProp (Preimage u v) = \ g g' ->
  Pr.Sigma-eq A.R (\ r -> Id Aa.R (ia.1 r) u * Id Ab.R (ib.1 r) v) g.1 g'.1 g.2 g'.2
   (Unique[g.1,g'.1,trans g.2.1 (sym g'.2.1),trans g.2.2 (sym g'.2.2)].equal)
   (Pr.isProp-Sigma (Id Aa.R (ia.1 g'.1) u) (\ p -> Id Ab.R (ib.1 g'.1) v) (setAa _ _) (\ p -> setAb _ _)) ;

 -- (exists)
 module Exists (u : Aa.R) (v : Ab.R) (h : Id C.R (ja.1 u) (jb.1 v)) {
  -- after clearing: ia x = a^k u, ib y = b^m v
  module Cleared (k m : Nat) (cu : KA.Clears u k) (cv : KB.Clears v m) {
   x : A.R = cu.1 ;
   y : A.R = cv.1 ;
   image-b : Id C.R (jb.1 (Ab.mul (ib.1 (PA.power a k)) v)) (jb.1 (ib.1 x)) =
    calc C.R { jb.1 (Ab.mul (ib.1 (PA.power a k)) v)
      =< jb.2.2.2 (ib.1 (PA.power a k)) v > C.mul (jb.1 (ib.1 (PA.power a k))) (jb.1 v)
      =< cong2 C.R C.mul _ _ _ _ (sym (square (PA.power a k))) (sym h) > C.mul (ja.1 (ia.1 (PA.power a k))) (ja.1 u)
      =< sym (ja.2.2.2 (ia.1 (PA.power a k)) u) > ja.1 (Aa.mul (ia.1 (PA.power a k)) u)
      =< ap ja.1 (sym cu.2) > ja.1 (ia.1 x)
      =< square x > jb.1 (ib.1 x) } ;
   image-a : Id C.R (ja.1 (Aa.mul (ia.1 (PA.power b m)) u)) (ja.1 (ia.1 y)) =
    calc C.R { ja.1 (Aa.mul (ia.1 (PA.power b m)) u)
      =< ja.2.2.2 (ia.1 (PA.power b m)) u > C.mul (ja.1 (ia.1 (PA.power b m))) (ja.1 u)
      =< cong2 C.R C.mul _ _ _ _ (square (PA.power b m)) h > C.mul (jb.1 (ib.1 (PA.power b m))) (jb.1 v)
      =< sym (jb.2.2.2 (ib.1 (PA.power b m)) v) > jb.1 (Ab.mul (ib.1 (PA.power b m)) v)
      =< ap jb.1 (sym cv.2) > jb.1 (ib.1 y)
      =< sym (square y) > ja.1 (ia.1 y) } ;
   module Equalised (f e : Nat) (sb : ELb.Same (Ab.mul (ib.1 (PA.power a k)) v) (ib.1 x) f)
    (sa : ELa.Same (Aa.mul (ia.1 (PA.power b m)) u) (ia.1 y) e) {
    K : Nat = plus f k ;
    L : Nat = plus e m ;
    X : A.R = A.mul (PA.power a f) x ;
    Y : A.R = A.mul (PA.power b e) y ;
    -- the powers of ib a in A_b and of ia b in A_a are images of powers
    pow-b : Id Ab.R (ELb.LS.pow f) (ib.1 (PA.power a f)) = sym (AffinePowers[l].power-map A Ab ib a f) ;
    pow-a : Id Aa.R (ELa.LS.pow e) (ia.1 (PA.power b e)) = sym (AffinePowers[l].power-map A Aa ia b e) ;
    Xa : Id Aa.R (ia.1 X) (Aa.mul (ia.1 (PA.power a K)) u) =
     trans (ia.2.2.2 (PA.power a f) x) (trans (ap (Aa.mul (ia.1 (PA.power a f))) cu.2) (sym (KA.image-split f k u))) ;
    Xb : Id Ab.R (ib.1 X) (Ab.mul (ib.1 (PA.power a K)) v) =
     calc Ab.R { ib.1 X
       =< ib.2.2.2 (PA.power a f) x > Ab.mul (ib.1 (PA.power a f)) (ib.1 x)
       =< ap (\ t -> Ab.mul t (ib.1 x)) (sym pow-b) > Ab.mul (ELb.LS.pow f) (ib.1 x)
       =< sym sb > Ab.mul (ELb.LS.pow f) (Ab.mul (ib.1 (PA.power a k)) v)
       =< ap (\ t -> Ab.mul t (Ab.mul (ib.1 (PA.power a k)) v)) pow-b >
          Ab.mul (ib.1 (PA.power a f)) (Ab.mul (ib.1 (PA.power a k)) v)
       =< sym (KAb.image-split f k v) > Ab.mul (ib.1 (PA.power a K)) v } ;
    Ya : Id Aa.R (ia.1 Y) (Aa.mul (ia.1 (PA.power b L)) u) =
     calc Aa.R { ia.1 Y
       =< ia.2.2.2 (PA.power b e) y > Aa.mul (ia.1 (PA.power b e)) (ia.1 y)
       =< ap (\ t -> Aa.mul t (ia.1 y)) (sym pow-a) > Aa.mul (ELa.LS.pow e) (ia.1 y)
       =< sym sa > Aa.mul (ELa.LS.pow e) (Aa.mul (ia.1 (PA.power b m)) u)
       =< ap (\ t -> Aa.mul t (Aa.mul (ia.1 (PA.power b m)) u)) pow-a >
          Aa.mul (ia.1 (PA.power b e)) (Aa.mul (ia.1 (PA.power b m)) u)
       =< sym (KBa.image-split e m u) > Aa.mul (ia.1 (PA.power b L)) u } ;
    Yb : Id Ab.R (ib.1 Y) (Ab.mul (ib.1 (PA.power b L)) v) =
     trans (ib.2.2.2 (PA.power b e) y) (trans (ap (Ab.mul (ib.1 (PA.power b e))) cv.2) (sym (KB.image-split e m v))) ;
    preimage (c : CM.Comaximal (PA.power a K) (PA.power b L)) : Preimage u v =
     (A.add (A.mul X c.1) (A.mul Y c.2.1),
      Combine[A,Aa,ia,PA.power a K,PA.power b L,c.1,c.2.1,c.2.2,u,X,Y,Xa,Ya].value,
      Combine[A,Ab,ib,PA.power a K,PA.power b L,c.1,c.2.1,c.2.2,v,X,Y,Xb,Yb].value) ;
    exists : Tr.Trunc[Preimage u v].carrier =
     TC.map (CM.Comaximal (PA.power a K) (PA.power b L)) (Preimage u v) preimage (CM.merely-powers a b comaximal K L) ;
   } ;
   exists : Tr.Trunc[Preimage u v].carrier =
    TC.bind (Bd.Bound (ELb.Same (Ab.mul (ib.1 (PA.power a k)) v) (ib.1 x))) (Preimage u v)
     (\ wf -> TC.bind (Bd.Bound (ELa.Same (Aa.mul (ia.1 (PA.power b m)) u) (ia.1 y))) (Preimage u v)
      (\ we -> Equalised[wf.1,we.1,wf.2,we.2].exists)
      (ELa.equalise (Aa.mul (ia.1 (PA.power b m)) u) (ia.1 y) image-a))
     (ELb.equalise (Ab.mul (ib.1 (PA.power a k)) v) (ib.1 x) image-b) ;
  } ;
  exists : Tr.Trunc[Preimage u v].carrier =
   TC.bind (Bd.Bound (KA.Clears u)) (Preimage u v)
    (\ wu -> TC.bind (Bd.Bound (KB.Clears v)) (Preimage u v)
     (\ wv -> Cleared[wu.1,wv.1,wu.2,wv.2].exists) (kb.clear v))
    (ka.clear u) ;
 } ;
 preimage (u : Aa.R) (v : Ab.R) (h : Id C.R (ja.1 u) (jb.1 v)) : Preimage u v =
  TC.rec (Preimage u v) @l (Preimage u v) (preimage-prop u v) (\ g -> g) Exists[u,v,h].exists ;
} ;
