-- LQ XVI.3.4, in the form used for the homotopy lemma.  Let psi : R -> C
-- be localising at s, and F, F' inverse N x N matrices over C[X] with
-- F(0) = 1.  Then for some k there are inverse matrices G, G' over R[X]
-- with psi[X] G = F(psi(s^k) X).
--
-- Proof.  Write scale_c for X |-> c X, on R[X] and on C[X].
--  (1) F = 1 + X T with T = tail F (CONSTANTTERM); F'(0) = 1 as well, so
--      F' = 1 + X T'.
--  (2) Clearing (POLYNOMIALLOCALISING, all entries, one exponent k):
--      psi[X] Q = e T and psi[X] Q' = e T', with e = psi[X](s^k) = psi(s^k).
--  (3) G0 = 1 + X scale_(s^k) Q maps to 1 + X e scale_e T = scale_e F, as
--      scale_e X = e X and scale_e fixes e; likewise G0' maps to scale_e F'.
--  (4) G0 G0' = 1 + X K (UNIPOTENT), and psi[X] (G0 G0') = scale_e (F F') = 1,
--      so X psi[X] K = 0 and psi[X] K = 0 (X is regular).  Killing (all
--      entries of K and of K' for G0' G0, one exponent k2): s^k2 K = 0.
--  (5) G = scale_d G0, G' = scale_d G0' with d = s^k2:
--      G G' = scale_d (1 + X K) = 1 + X scale_d (d K) = 1, likewise G' G = 1,
--      and psi[X] G = scale_(psi d) (scale_e F) = F(psi(s^(k+k2)) X).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module B = ExponentBounds[l] ;
module Over (R C : CRing) (setR : Pr.isSet R.R) (setC : Pr.isSet C.R) (psi : H.Hom R C) (s : R.R)
 (loc : Localising[l].Over[R,C,psi,s].Localising) (N : Nat) {
 module LB = Localising[l].Over[R,C,psi,s] ;
 module PL = PolynomialLocalising[l].Over[R,C,setR,setC,psi,s,loc] ;
 module Ch = PL.Ch ;
 module RX = Ch.RX ;
 module CX = Ch.CX ;
 module SR = Ch.SR ;
 module SC = Ch.SC ;
 module LX = PL.LX ;
 module CT = ConstantTerm[l].Over[C,setC] ;
 module MC = MnAlgebra[l].Over[C,setC,N] ;
 module UR = Unipotent[l].Over[RX.ring,RX.set,N] ;
 module UC = Unipotent[l].Over[CX.ring,CX.set,N] ;
 module MR = UR.M ;
 module MCX = UC.M ;
 module IR = MatrixMap[l].Invertible[RX.ring,RX.set,N] ;
 module IC = MatrixMap[l].Invertible[CX.ring,CX.set,N] ;
 module Hm = Unipotent[l].Map[RX.ring,CX.ring,RX.set,CX.set,Ch.hom,N] ;
 module V0 = MatrixMap[l].Over[CX.ring,C,CX.set,setC,CT.value0,N] ;
 module K0 = MatrixMap[l].Over[C,CX.ring,setC,CX.set,CX.inclusion,N] ;
 module ScaleR (d : R.R) { module Mp = Unipotent[l].Map[RX.ring,RX.ring,RX.set,RX.set,SR.scale d,N] ; } ;
 module ScaleC (d : C.R) { module Mp = Unipotent[l].Map[CX.ring,CX.ring,CX.set,CX.set,SC.scale d,N] ; } ;

 -- (1) F(0) = 1 gives F = 1 + X tail F.
 Unit (F : MCX.Mat) : U l = Id MC.Mat (V0.map F) MC.mone ;
 tails (F : MCX.Mat) : MCX.Mat = \ i j -> CT.tail (F i j) ;
 -- the constant term of F i j is the (i, j) entry of 1
 constant-entry (F : MCX.Mat) (u : Unit F) (i j : Fin N) :
  Id CX.Carrier (CX.constant (CT.value0.1 (F i j))) (MCX.mone i j) =
  trans (ap CX.constant (ap (\ m -> m i j) u)) (K0.delta-map N i j) ;
 shape-entry (F : MCX.Mat) (u : Unit F) (i j : Fin N) :
  Id CX.Carrier (F i j) (UC.uni CX.variable (tails F) i j) =
  calc CX.Carrier { F i j
    =< CT.decompose (F i j) > CX.addQ (CX.constant (CT.value0.1 (F i j))) (CX.mulQ CX.variable (CT.tail (F i j)))
    =< ap (\ t -> CX.addQ t (CX.mulQ CX.variable (CT.tail (F i j)))) (constant-entry F u i j) >
       CX.addQ (MCX.mone i j) (CX.mulQ CX.variable (CT.tail (F i j))) } ;
 shape (F : MCX.Mat) (u : Unit F) : Id MCX.Mat F (UC.uni CX.variable (tails F)) =
  MCX.mat-eq F (UC.uni CX.variable (tails F)) (shape-entry F u) ;
 unit-inverse (F F' : MCX.Mat) (inv : IC.Inverse[F,F']) (u : Unit F) : Unit F' =
  calc MC.Mat { V0.map F'
    =< sym (MC.m-one-left (V0.map F')) > MC.mmul MC.mone (V0.map F')
    =< ap (\ m -> MC.mmul m (V0.map F')) (sym u) > MC.mmul (V0.map F) (V0.map F')
    =< sym (V0.map-mul F F') > V0.map (MCX.mmul F F')
    =< ap V0.map inv.right > V0.map MCX.mone
    =< V0.map-one > MC.mone } ;

 -- (2) clearing all entries with one exponent
 ClearsAll (T : MCX.Mat) : Nat -> U l = B.All2 N (\ i j -> LX.Clears (T i j)) ;
 clears-all-monotone (T : MCX.Mat) : B.Monotone (ClearsAll T) =
  B.all2-monotone N (\ i j -> LX.Clears (T i j)) (\ i j -> LX.clears-monotone (T i j)) ;
 clear-all (T : MCX.Mat) : B.Merely (ClearsAll T) =
  B.merely-common2 N (\ i j -> LX.Clears (T i j)) (\ i j -> LX.clears-monotone (T i j))
   (\ i j -> PL.clear (T i j)) ;
 -- scale_c fixes the constant e = psi[X](s^k)
 fixed (k : Nat) (c : C.R) : Id CX.Carrier ((SC.scale c).1 (Ch.hom.1 (LX.pow k))) (Ch.hom.1 (LX.pow k)) =
  trans (ap (SC.scale c).1 (PL.image-pow k))
   (trans (SC.scale-constant c (psi.1 (LB.pow k))) (sym (PL.image-pow k))) ;

 -- (3) the first lift, from the numerators Q of T = tail F
 module First (F : MCX.Mat) (u : Unit F) (k : Nat) (w : ClearsAll (tails F) k) {
  c : R.R = LB.pow k ;
  e : CX.Carrier = Ch.hom.1 (LX.pow k) ;
  module SCc = ScaleC[psi.1 c] ;
  module SRc = ScaleR[c] ;
  Q : MR.Mat = \ i j -> (w i j).1 ;
  A : MR.Mat = SRc.Mp.MM.map Q ;
  G : MR.Mat = UR.uni RX.variable A ;
  -- psi[X] (scale_c Q) = scale_e (e T) = e scale_e T
  Q-image (i j : Fin N) : Id CX.Carrier (Ch.hom.1 (Q i j)) (CX.mulQ e (CT.tail (F i j))) = (w i j).2 ;
  A-entry (i j : Fin N) :
   Id CX.Carrier (Hm.MM.map A i j) (MCX.mscale e (SCc.Mp.MM.map (tails F)) i j) =
   calc CX.Carrier { Ch.hom.1 ((SR.scale c).1 (Q i j))
     =< Ch.scale-change c (Q i j) > (SC.scale (psi.1 c)).1 (Ch.hom.1 (Q i j))
     =< ap (SC.scale (psi.1 c)).1 (Q-image i j) > (SC.scale (psi.1 c)).1 (CX.mulQ e (CT.tail (F i j)))
     =< SC.scale-mul (psi.1 c) e (CT.tail (F i j)) >
        CX.mulQ ((SC.scale (psi.1 c)).1 e) ((SC.scale (psi.1 c)).1 (CT.tail (F i j)))
     =< ap (\ t -> CX.mulQ t ((SC.scale (psi.1 c)).1 (CT.tail (F i j)))) (fixed k (psi.1 c)) >
        CX.mulQ e ((SC.scale (psi.1 c)).1 (CT.tail (F i j))) } ;
  -- psi[X] (scale_c Q) = scale_e (e T) = e scale_e T
  A-image : Id MCX.Mat (Hm.MM.map A) (MCX.mscale e (SCc.Mp.MM.map (tails F))) =
   MCX.mat-eq (Hm.MM.map A) (MCX.mscale e (SCc.Mp.MM.map (tails F))) A-entry ;
  -- X e = scale_e X
  slope : Id CX.Carrier (CX.mulQ CX.variable e) ((SC.scale (psi.1 c)).1 CX.variable) =
   trans (CX.mul-comm CX.variable e)
    (trans (ap (\ t -> CX.mulQ t CX.variable) (PL.image-pow k)) (sym (SC.scale-variable (psi.1 c)))) ;
  image : Id MCX.Mat (Hm.MM.map G) (SCc.Mp.MM.map F) =
   calc MCX.Mat { Hm.MM.map G
     =< Hm.map-uni RX.variable A > UC.uni (Ch.hom.1 RX.variable) (Hm.MM.map A)
     =< ap (\ t -> UC.uni t (Hm.MM.map A)) Ch.hom-variable > UC.uni CX.variable (Hm.MM.map A)
     =< ap (UC.uni CX.variable) A-image > UC.uni CX.variable (MCX.mscale e (SCc.Mp.MM.map (tails F)))
     =< ap (MCX.madd MCX.mone) (MCX.m-scale-scale CX.variable e (SCc.Mp.MM.map (tails F))) >
        UC.uni (CX.mulQ CX.variable e) (SCc.Mp.MM.map (tails F))
     =< ap (\ t -> UC.uni t (SCc.Mp.MM.map (tails F))) slope >
        UC.uni ((SC.scale (psi.1 c)).1 CX.variable) (SCc.Mp.MM.map (tails F))
     =< sym (SCc.Mp.map-uni CX.variable (tails F)) > SCc.Mp.MM.map (UC.uni CX.variable (tails F))
     =< ap SCc.Mp.MM.map (sym (shape F u)) > SCc.Mp.MM.map F } ;
  image-entry (i j : Fin N) : Id CX.Carrier (Ch.hom.1 (G i j)) ((SC.scale (psi.1 c)).1 (F i j)) =
   ap (\ m -> m i j) image ;
 } ;

 -- (4)-(5)
 KillsAll (T : MR.Mat) : Nat -> U l = B.All2 N (\ i j -> LX.Kills (T i j)) ;
 kills-all-monotone (T : MR.Mat) : B.Monotone (KillsAll T) =
  B.all2-monotone N (\ i j -> LX.Kills (T i j)) (\ i j -> LX.kills-monotone (T i j)) ;
 kill-all (T : MR.Mat) (h : (i j : Fin N) -> Id CX.Carrier (Ch.hom.1 (T i j)) CX.zeroQ) : B.Merely (KillsAll T) =
  B.merely-common2 N (\ i j -> LX.Kills (T i j)) (\ i j -> LX.kills-monotone (T i j))
   (\ i j -> PL.kill (T i j) (h i j)) ;
 -- psi[X] (1 + X K) = 1 gives psi[X] K = 0
 killed (K : MR.Mat) (h : Id MCX.Mat (Hm.MM.map (UR.uni RX.variable K)) MCX.mone) (i j : Fin N) :
  Id CX.Carrier (Ch.hom.1 (K i j)) CX.zeroQ =
  CT.cancel-variable (Ch.hom.1 (K i j))
   (ap (\ m -> m i j) (UC.cancel CX.variable (Hm.MM.map K)
    (trans (ap (\ t -> UC.uni t (Hm.MM.map K)) (sym Ch.hom-variable))
     (trans (sym (Hm.map-uni RX.variable K)) h)))) ;
 -- with d = s^k2 and s^k2 K = 0:  scale_d (1 + X K) = 1 + X scale_d (d K) = 1
 rescaled-one (k2 : Nat) (K : MR.Mat) (v : KillsAll K k2) :
  Id MR.Mat (ScaleR[LB.pow k2].Mp.MM.map (UR.uni RX.variable K)) MR.mone =
  calc MR.Mat { ScaleR[LB.pow k2].Mp.MM.map (UR.uni RX.variable K)
    =< ScaleR[LB.pow k2].Mp.map-uni RX.variable K >
       UR.uni ((SR.scale (LB.pow k2)).1 RX.variable) (ScaleR[LB.pow k2].Mp.MM.map K)
    =< ap (\ t -> UR.uni t (ScaleR[LB.pow k2].Mp.MM.map K))
        (trans (SR.scale-variable (LB.pow k2))
         (trans (ap (\ t -> RX.mulQ t RX.variable) (sym (PL.pow-constant k2))) (RX.mul-comm (LX.pow k2) RX.variable))) >
       UR.uni (RX.mulQ RX.variable (LX.pow k2)) (ScaleR[LB.pow k2].Mp.MM.map K)
    =< ap (MR.madd MR.mone) (sym (MR.m-scale-scale RX.variable (LX.pow k2) (ScaleR[LB.pow k2].Mp.MM.map K))) >
       UR.uni RX.variable (MR.mscale (LX.pow k2) (ScaleR[LB.pow k2].Mp.MM.map K))
    =< ap (UR.uni RX.variable)
        (trans (ap (\ t -> MR.mscale t (ScaleR[LB.pow k2].Mp.MM.map K))
          (sym (trans (ap (SR.scale (LB.pow k2)).1 (PL.pow-constant k2))
           (trans (SR.scale-constant (LB.pow k2) (LB.pow k2)) (sym (PL.pow-constant k2))))))
         (sym (ScaleR[LB.pow k2].Mp.MM.map-scale (LX.pow k2) K))) >
       UR.uni RX.variable (ScaleR[LB.pow k2].Mp.MM.map (MR.mscale (LX.pow k2) K))
    =< ap (\ m -> UR.uni RX.variable (ScaleR[LB.pow k2].Mp.MM.map m))
        (MR.mat-eq (MR.mscale (LX.pow k2) K) MR.mzero (\ i j -> v i j)) >
       UR.uni RX.variable (ScaleR[LB.pow k2].Mp.MM.map MR.mzero)
    =< ap (UR.uni RX.variable) ScaleR[LB.pow k2].Mp.MM.map-zero > UR.uni RX.variable MR.mzero
    =< UR.uni-zero RX.variable > MR.mone } ;

 Lift (F : MCX.Mat) (k : Nat) : U l =
  (G : MR.Mat) * (G' : MR.Mat) * IR.Inverse[G,G'] *
  Id MCX.Mat (Hm.MM.map G) (ScaleC[psi.1 (LB.pow k)].Mp.MM.map F) ;

 -- the entries of the image equation of a lift
 image-at (F : MCX.Mat) (k : Nat) (w : Lift F k) (i j : Fin N) :
  Id CX.Carrier (Ch.hom.1 (w.1 i j)) ((SC.scale (psi.1 (LB.pow k))).1 (F i j)) =
  ap (\ m -> m i j) w.2.2.2 ;

 module Second (F F' : MCX.Mat) (inv : IC.Inverse[F,F']) (u : Unit F) (k : Nat)
  (w : ClearsAll (tails F) k) (w' : ClearsAll (tails F') k) {
  module P = First[F,u,k,w] ;
  module P' = First[F',unit-inverse F F' inv u,k,w'] ;
  module SCc = P.SCc ;
  K : MR.Mat = UR.product-term RX.variable P.A P'.A ;
  K' : MR.Mat = UR.product-term RX.variable P'.A P.A ;
  -- psi[X] (G1 G2) = scale_e F1 scale_e F2 = scale_e (F1 F2) = 1
  image-one (F1 F2 : MCX.Mat) (G1 G2 : MR.Mat)
   (h1 : Id MCX.Mat (Hm.MM.map G1) (SCc.Mp.MM.map F1)) (h2 : Id MCX.Mat (Hm.MM.map G2) (SCc.Mp.MM.map F2))
   (one : Id MCX.Mat (MCX.mmul F1 F2) MCX.mone) : Id MCX.Mat (Hm.MM.map (MR.mmul G1 G2)) MCX.mone =
   calc MCX.Mat { Hm.MM.map (MR.mmul G1 G2)
     =< Hm.MM.map-mul G1 G2 > MCX.mmul (Hm.MM.map G1) (Hm.MM.map G2)
     =< cong2 MCX.Mat MCX.mmul _ _ _ _ h1 h2 > MCX.mmul (SCc.Mp.MM.map F1) (SCc.Mp.MM.map F2)
     =< sym (SCc.Mp.MM.map-mul F1 F2) > SCc.Mp.MM.map (MCX.mmul F1 F2)
     =< ap SCc.Mp.MM.map one > SCc.Mp.MM.map MCX.mone
     =< SCc.Mp.MM.map-one > MCX.mone } ;
  K-image (i j : Fin N) : Id CX.Carrier (Ch.hom.1 (K i j)) CX.zeroQ =
   killed K (trans (ap Hm.MM.map (sym (UR.product RX.variable P.A P'.A)))
    (image-one F F' P.G P'.G P.image P'.image inv.right)) i j ;
  K'-image (i j : Fin N) : Id CX.Carrier (Ch.hom.1 (K' i j)) CX.zeroQ =
   killed K' (trans (ap Hm.MM.map (sym (UR.product RX.variable P'.A P.A)))
    (image-one F' F P'.G P.G P'.image P.image inv.left)) i j ;
  module Third (k2 : Nat) (v : KillsAll K k2) (v' : KillsAll K' k2) {
   d : R.R = LB.pow k2 ;
   module SRd = ScaleR[d] ;
   G : MR.Mat = SRd.Mp.MM.map P.G ;
   G' : MR.Mat = SRd.Mp.MM.map P'.G ;
   one (G1 G2 T : MR.Mat) (p : Id MR.Mat (MR.mmul G1 G2) (UR.uni RX.variable T)) (kt : KillsAll T k2) :
    Id MR.Mat (MR.mmul (SRd.Mp.MM.map G1) (SRd.Mp.MM.map G2)) MR.mone =
    trans (sym (SRd.Mp.MM.map-mul G1 G2)) (trans (ap SRd.Mp.MM.map p) (rescaled-one k2 T kt)) ;
   inverse : IR.Inverse[G,G'] =
    new IR.Inverse[G,G',one P.G P'.G K (UR.product RX.variable P.A P'.A) v,
     one P'.G P.G K' (UR.product RX.variable P'.A P.A) v'] ;
   -- psi(s^k) psi(s^k2) = psi(s^(k+k2))
   exponent : Id C.R (C.mul (psi.1 P.c) (psi.1 d)) (psi.1 (LB.pow (plus k k2))) =
    sym (trans (ap psi.1 (LB.PR.power-add s k k2)) (psi.2.2.2 (LB.pow k) (LB.pow k2))) ;
   image-entry (i j : Fin N) :
    Id CX.Carrier (Hm.MM.map G i j) (ScaleC[psi.1 (LB.pow (plus k k2))].Mp.MM.map F i j) =
    calc CX.Carrier { Ch.hom.1 ((SR.scale d).1 (P.G i j))
      =< Ch.scale-change d (P.G i j) > (SC.scale (psi.1 d)).1 (Ch.hom.1 (P.G i j))
      =< ap (SC.scale (psi.1 d)).1 (P.image-entry i j) >
         (SC.scale (psi.1 d)).1 ((SC.scale (psi.1 P.c)).1 (F i j))
      =< SC.scale-scale (psi.1 d) (psi.1 P.c) (F i j) > (SC.scale (C.mul (psi.1 P.c) (psi.1 d))).1 (F i j)
      =< ap (\ t -> (SC.scale t).1 (F i j)) exponent > (SC.scale (psi.1 (LB.pow (plus k k2)))).1 (F i j) } ;
   image : Id MCX.Mat (Hm.MM.map G) (ScaleC[psi.1 (LB.pow (plus k k2))].Mp.MM.map F) =
    MCX.mat-eq (Hm.MM.map G) (ScaleC[psi.1 (LB.pow (plus k k2))].Mp.MM.map F) image-entry ;
   result : B.Bound (Lift F) = (plus k k2,(G,G',inverse,image)) ;
  } ;
  kills : B.Merely (B.Both (KillsAll K) (KillsAll K')) =
   B.both (KillsAll K) (KillsAll K') (kills-all-monotone K) (kills-all-monotone K')
    (kill-all K K-image) (kill-all K' K'-image) ;
  result : B.Merely (Lift F) =
   TC.map (B.Bound (B.Both (KillsAll K) (KillsAll K'))) (B.Bound (Lift F))
    (\ y -> Third[y.1,y.2.1,y.2.2].result) kills ;
 } ;
 lift (F F' : MCX.Mat) (inv : IC.Inverse[F,F']) (u : Unit F) : B.Merely (Lift F) =
  TC.bind (B.Bound (B.Both (ClearsAll (tails F)) (ClearsAll (tails F')))) (B.Bound (Lift F))
   (\ x -> Second[F,F',inv,u,x.1,x.2.1,x.2.2].result)
   (B.both (ClearsAll (tails F)) (ClearsAll (tails F'))
    (clears-all-monotone (tails F)) (clears-all-monotone (tails F'))
    (clear-all (tails F)) (clear-all (tails F'))) ;
} ;
