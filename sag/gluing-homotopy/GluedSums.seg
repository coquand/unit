-- Sums of glued modules (GLUED): P_{diag(g,h)} ~ P_g + P_h, with
-- Fin (M + M) split into halves (VECTORBLOCKS).  The halves of
-- jb(V) = diag(g,h) ja(U) are
--     jb(V_l) = g ja(U_l),     jb(V_r) = h ja(U_r),
-- so (U, V) |-> ((U_l, V_l), (U_r, V_r)) is a map P_{diag(g,h)} -> P_g + P_h,
-- linear by definition.  Its inverse puts the halves together
-- ((u, v), (u', v')) |-> (cat u u', cat v v'), by the same two equations.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A Aa Ab C : CRing) (setAa : Pr.isSet Aa.R) (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r))) (M : Nat) {
 module G1 = Glued[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,M] ;
 module G2 = Glued[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,plus M M] ;
 module BA = VectorBlocks[l].Over[Aa,setAa,M] ;
 module BB = VectorBlocks[l].Over[Ab,setAb,M] ;
 module BC = VectorBlocks[l].Over[C,setC,M] ;
 module W = Whitehead[l].Over[C,setC,M] ;
 module Diagonal (g h : G1.MC.Mat) {
  module Pg = G1.Glue[g] ;
  module Ph = G1.Glue[h] ;
  module PD = G2.Glue[W.diag g h] ;
  module S = SP.Pair[A,Pg.glued,Ph.glued] ;
  -- the two halves of the equation of P_{diag(g,h)}
  member-l (X : PD.Carrier) :
   Id G1.VC.Vec (G1.JB.map (BB.lhalf (PD.right X))) (G1.VC.act g (G1.JA.map (BA.lhalf (PD.left X)))) =
   G1.VC.vec-eq _ _ (\ i -> trans (G2.VC.entry _ _ (PD.member X) (BC.B.il i)) (BC.diag-l g h (G2.JA.map (PD.left X)) i)) ;
  member-r (X : PD.Carrier) :
   Id G1.VC.Vec (G1.JB.map (BB.rhalf (PD.right X))) (G1.VC.act h (G1.JA.map (BA.rhalf (PD.left X)))) =
   G1.VC.vec-eq _ _ (\ i -> trans (G2.VC.entry _ _ (PD.member X) (BC.B.ir i)) (BC.diag-r g h (G2.JA.map (PD.left X)) i)) ;
  halves (X : PD.Carrier) : S.Carrier =
   (Pg.point (BA.lhalf (PD.left X)) (BB.lhalf (PD.right X)) (member-l X),
    Ph.point (BA.rhalf (PD.left X)) (BB.rhalf (PD.right X)) (member-r X)) ;
  -- and conversely
  module Join (y : S.Carrier) {
   u : G1.VAa.Vec = Pg.left y.1 ;
   v : G1.VAb.Vec = Pg.right y.1 ;
   u' : G1.VAa.Vec = Ph.left y.2 ;
   v' : G1.VAb.Vec = Ph.right y.2 ;
   at-l (i : Fin M) : Id C.R (jb.1 (BB.cat v v' (BC.B.il i))) (G2.VC.act (W.diag g h) (G2.JA.map (BA.cat u u')) (BC.B.il i)) =
    calc C.R { jb.1 (BB.cat v v' (BC.B.il i))
      =< ap jb.1 (BB.cat-l v v' i) > jb.1 (v i)
      =< G1.VC.entry _ _ (Pg.member y.1) i > G1.VC.act g (G1.JA.map u) i
      =< ap (\ t -> G1.VC.act g (G1.JA.map t) i) (sym (BA.lhalf-cat u u')) > G1.VC.act g (G1.JA.map (BA.lhalf (BA.cat u u'))) i
      =< sym (BC.diag-l g h (G2.JA.map (BA.cat u u')) i) > G2.VC.act (W.diag g h) (G2.JA.map (BA.cat u u')) (BC.B.il i) } ;
   at-r (i : Fin M) : Id C.R (jb.1 (BB.cat v v' (BC.B.ir i))) (G2.VC.act (W.diag g h) (G2.JA.map (BA.cat u u')) (BC.B.ir i)) =
    calc C.R { jb.1 (BB.cat v v' (BC.B.ir i))
      =< ap jb.1 (BB.cat-r v v' i) > jb.1 (v' i)
      =< G1.VC.entry _ _ (Ph.member y.2) i > G1.VC.act h (G1.JA.map u') i
      =< ap (\ t -> G1.VC.act h (G1.JA.map t) i) (sym (BA.rhalf-cat u u')) > G1.VC.act h (G1.JA.map (BA.rhalf (BA.cat u u'))) i
      =< sym (BC.diag-r g h (G2.JA.map (BA.cat u u')) i) > G2.VC.act (W.diag g h) (G2.JA.map (BA.cat u u')) (BC.B.ir i) } ;
   point : PD.Carrier = PD.point (BA.cat u u') (BB.cat v v')
    (BC.Halves[G2.JB.map (BB.cat v v'),G2.VC.act (W.diag g h) (G2.JA.map (BA.cat u u')),at-l,at-r].equal) ;
  } ;
  join (y : S.Carrier) : PD.Carrier = Join[y].point ;
  iso : G1.MI.Iso[PD.glued,S.product] = G1.MI.make PD.glued S.product halves join
   (\ X Y -> S.ext _ _ (Pg.ext _ _ (refl (BA.lhalf (G2.VAa.vadd (PD.left X) (PD.left Y)))) (refl (BB.lhalf (G2.VAb.vadd (PD.right X) (PD.right Y)))))
     (Ph.ext _ _ (refl (BA.rhalf (G2.VAa.vadd (PD.left X) (PD.left Y)))) (refl (BB.rhalf (G2.VAb.vadd (PD.right X) (PD.right Y))))))
   (\ r X -> S.ext _ _ (Pg.ext _ _ (refl (BA.lhalf (G2.VAa.vscale (ia.1 r) (PD.left X)))) (refl (BB.lhalf (G2.VAb.vscale (ib.1 r) (PD.right X)))))
     (Ph.ext _ _ (refl (BA.rhalf (G2.VAa.vscale (ia.1 r) (PD.left X)))) (refl (BB.rhalf (G2.VAb.vscale (ib.1 r) (PD.right X))))))
   (\ y -> S.ext _ _ (Pg.ext _ _ (BA.lhalf-cat (Pg.left y.1) (Ph.left y.2)) (BB.lhalf-cat (Pg.right y.1) (Ph.right y.2)))
     (Ph.ext _ _ (BA.rhalf-cat (Pg.left y.1) (Ph.left y.2)) (BB.rhalf-cat (Pg.right y.1) (Ph.right y.2))))
   (\ X -> PD.ext _ _ (BA.cat-halves (PD.left X)) (BB.cat-halves (PD.right X))) ;
 } ;
} ;
