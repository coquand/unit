-- Whitehead's identity and its homotopy (gabber-recollement.tex, proof of
-- Lemma 3.6(1)).  With the block-unipotent matrices
--   u x = ( 1 x )      l y = ( 1 0 )
--         ( 0 1 ),           ( y 1 ),
-- and h h' = 1 = h' h,
--   u h' . l(-h) . u h' . u(-1) . l 1 . u(-1) = diag(h', h)     (whitehead).
-- Proof: multiply from the right, by u-left and l-left,
--   u x . (a b; c d) = (a+xc  b+xd; c d),  l y . (a b; c d) = (a b; ya+c  yb+d):
--   u(-1) = (1 -1; 0 1),  l 1 . u(-1) = (1 -1; 1 0),  u(-1) . that = (0 -1; 1 0),
--   u h' . that = (h' -1; 1 0),  l(-h) . that = (h' -1; 0 h),
--   u h' . that = (h' 0; 0 h).
-- The homotopy: multiply every block by a scalar c,
--   word c X1 .. X6 = u(cX1) . l(cX2) . u(cX3) . u(cX4) . l(cX5) . u(cX6).
-- It is invertible (u x u(-x) = 1 = l y l(-y)), word 0 = 1, word 1 is the
-- product without the scalar, and a ring map f sends word c X.. to
-- word (f c) (f X)...
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (M : Nat) {
 module B = Blocks[l].Over[R,setR,M] ;
 module MM = B.MM ;
 module M2 = B.M2 ;
 module I2 = MatrixMap[l].Invertible[R,setR,plus M M] ;
 module Cj = Conjugation[l].Over[R,setR,plus M M] ;
 one : MM.Mat = MM.mone ;
 zero : MM.Mat = MM.mzero ;
 m1 : MM.Mat = MM.mneg MM.mone ;
 u (x : MM.Mat) : M2.Mat = B.blk one x zero one ;
 lo (y : MM.Mat) : M2.Mat = B.blk one zero y one ;
 diag (a d : MM.Mat) : M2.Mat = B.blk a zero zero d ;
 -- products of inverse pairs
 mul-inverse (x x' y y' : M2.Mat) (ix : I2.Inverse[x,x']) (iy : I2.Inverse[y,y']) :
  I2.Inverse[M2.mmul x y,M2.mmul y' x'] =
  new I2.Inverse[M2.mmul x y,M2.mmul y' x',Cj.sandwich x x' y' y ix.right iy.right,
   Cj.sandwich y' y x x' iy.left ix.left] ;
 -- u x . (a b; c d) = (a+xc  b+xd; c d)
 u-left (x a b c d : MM.Mat) :
  Id M2.Mat (M2.mmul (u x) (B.blk a b c d)) (B.blk (MM.madd a (MM.mmul x c)) (MM.madd b (MM.mmul x d)) c d) =
  trans (B.block-mul one x zero one a b c d)
   (B.blk-cong _ _ _ _ _ _ _ _
    (ap (\ t -> MM.madd t (MM.mmul x c)) (MM.m-one-left a))
    (ap (\ t -> MM.madd t (MM.mmul x d)) (MM.m-one-left b))
    (trans (cong2 MM.Mat MM.madd _ _ _ _ (B.mul-zero-left a) (MM.m-one-left c)) (B.zero-add c))
    (trans (cong2 MM.Mat MM.madd _ _ _ _ (B.mul-zero-left b) (MM.m-one-left d)) (B.zero-add d))) ;
 -- l y . (a b; c d) = (a b; ya+c  yb+d)
 lo-left (y a b c d : MM.Mat) :
  Id M2.Mat (M2.mmul (lo y) (B.blk a b c d)) (B.blk a b (MM.madd (MM.mmul y a) c) (MM.madd (MM.mmul y b) d)) =
  trans (B.block-mul one zero y one a b c d)
   (B.blk-cong _ _ _ _ _ _ _ _
    (trans (cong2 MM.Mat MM.madd _ _ _ _ (MM.m-one-left a) (B.mul-zero-left c)) (MM.m-addZ a))
    (trans (cong2 MM.Mat MM.madd _ _ _ _ (MM.m-one-left b) (B.mul-zero-left d)) (MM.m-addZ b))
    (ap (MM.madd (MM.mmul y a)) (MM.m-one-left c))
    (ap (MM.madd (MM.mmul y b)) (MM.m-one-left d))) ;
 -- u x u y = u (y + x),  l x l y = l (x + y)
 u-add (x y : MM.Mat) : Id M2.Mat (M2.mmul (u x) (u y)) (u (MM.madd y x)) =
  trans (u-left x one y zero one)
   (B.blk-cong _ _ _ _ _ _ _ _
    (trans (ap (MM.madd one) (B.mul-zero-right x)) (MM.m-addZ one))
    (ap (MM.madd y) (MM.m-one-right x)) (refl zero) (refl one)) ;
 lo-add (x y : MM.Mat) : Id M2.Mat (M2.mmul (lo x) (lo y)) (lo (MM.madd x y)) =
  trans (lo-left x one zero y one)
   (B.blk-cong _ _ _ _ _ _ _ _ (refl one) (refl zero)
    (ap (\ t -> MM.madd t y) (MM.m-one-right x))
    (trans (ap (\ t -> MM.madd t one) (B.mul-zero-right x)) (B.zero-add one))) ;
 u-inverse (x : MM.Mat) : I2.Inverse[u x,u (MM.mneg x)] =
  new I2.Inverse[u x,u (MM.mneg x),
   trans (u-add x (MM.mneg x)) (trans (ap u (B.neg-add-left x)) B.blk-one),
   trans (u-add (MM.mneg x) x) (trans (ap u (MM.m-addN x)) B.blk-one)] ;
 lo-inverse (x : MM.Mat) : I2.Inverse[lo x,lo (MM.mneg x)] =
  new I2.Inverse[lo x,lo (MM.mneg x),
   trans (lo-add x (MM.mneg x)) (trans (ap lo (MM.m-addN x)) B.blk-one),
   trans (lo-add (MM.mneg x) x) (trans (ap lo (B.neg-add-left x)) B.blk-one)] ;
 -- diag a d . diag a' d' = diag (a a') (d d')
 diag-mul (a d a' d' : MM.Mat) : Id M2.Mat (M2.mmul (diag a d) (diag a' d')) (diag (MM.mmul a a') (MM.mmul d d')) =
  trans (B.block-mul a zero zero d a' zero zero d')
   (B.blk-cong _ _ _ _ _ _ _ _
    (trans (ap (MM.madd (MM.mmul a a')) (B.mul-zero-left zero)) (MM.m-addZ (MM.mmul a a')))
    (trans (cong2 MM.Mat MM.madd _ _ _ _ (B.mul-zero-right a) (B.mul-zero-left d')) (MM.m-addZ zero))
    (trans (cong2 MM.Mat MM.madd _ _ _ _ (B.mul-zero-left a') (B.mul-zero-right d)) (MM.m-addZ zero))
    (trans (ap (\ t -> MM.madd t (MM.mmul d d')) (B.mul-zero-left zero)) (B.zero-add (MM.mmul d d')))) ;

 -- Whitehead's identity, multiplied out from the right
 module Identity (h h' : MM.Mat) (hh : Id MM.Mat (MM.mmul h h') one) (hh' : Id MM.Mat (MM.mmul h' h) one) {
  w5 : M2.Mat = M2.mmul (lo one) (u m1) ;
  w4 : M2.Mat = M2.mmul (u m1) w5 ;
  w3 : M2.Mat = M2.mmul (u h') w4 ;
  w2 : M2.Mat = M2.mmul (lo (MM.mneg h)) w3 ;
  w1 : M2.Mat = M2.mmul (u h') w2 ;
  -- l 1 . u(-1) = (1 -1; 1 0)
  s5 : Id M2.Mat w5 (B.blk one m1 one zero) =
   trans (lo-left one one m1 zero one)
    (B.blk-cong _ _ _ _ _ _ _ _ (refl one) (refl m1)
     (trans (ap (\ t -> MM.madd t zero) (MM.m-one-left one)) (MM.m-addZ one))
     (trans (ap (\ t -> MM.madd t one) (MM.m-one-left m1)) (B.neg-add-left one))) ;
  -- u(-1) . (1 -1; 1 0) = (0 -1; 1 0)
  s4 : Id M2.Mat w4 (B.blk zero m1 one zero) =
   trans (ap (M2.mmul (u m1)) s5)
    (trans (u-left m1 one m1 one zero)
     (B.blk-cong _ _ _ _ _ _ _ _
      (trans (ap (MM.madd one) (MM.m-one-right m1)) (MM.m-addN one))
      (trans (ap (MM.madd m1) (B.mul-zero-right m1)) (MM.m-addZ m1)) (refl one) (refl zero))) ;
  -- u h' . (0 -1; 1 0) = (h' -1; 1 0)
  s3 : Id M2.Mat w3 (B.blk h' m1 one zero) =
   trans (ap (M2.mmul (u h')) s4)
    (trans (u-left h' zero m1 one zero)
     (B.blk-cong _ _ _ _ _ _ _ _
      (trans (B.zero-add (MM.mmul h' one)) (MM.m-one-right h'))
      (trans (ap (MM.madd m1) (B.mul-zero-right h')) (MM.m-addZ m1)) (refl one) (refl zero))) ;
  -- (-h) h' + 1 = -(h h') + 1 = -1 + 1 = 0
  c2 : Id MM.Mat (MM.madd (MM.mmul (MM.mneg h) h') one) zero =
   calc MM.Mat { MM.madd (MM.mmul (MM.mneg h) h') one
     =< ap (\ t -> MM.madd t one) (B.mul-neg-left h h') > MM.madd (MM.mneg (MM.mmul h h')) one
     =< ap (\ t -> MM.madd (MM.mneg t) one) hh > MM.madd m1 one
     =< B.neg-add-left one > zero } ;
  -- (-h)(-1) + 0 = h
  d2 : Id MM.Mat (MM.madd (MM.mmul (MM.mneg h) m1) zero) h =
   calc MM.Mat { MM.madd (MM.mmul (MM.mneg h) m1) zero
     =< MM.m-addZ (MM.mmul (MM.mneg h) m1) > MM.mmul (MM.mneg h) m1
     =< B.mul-neg-left h m1 > MM.mneg (MM.mmul h m1)
     =< ap MM.mneg (B.mul-neg-right h one) > MM.mneg (MM.mneg (MM.mmul h one))
     =< B.neg-neg (MM.mmul h one) > MM.mmul h one
     =< MM.m-one-right h > h } ;
  -- l(-h) . (h' -1; 1 0) = (h' -1; 0 h)
  s2 : Id M2.Mat w2 (B.blk h' m1 zero h) =
   trans (ap (M2.mmul (lo (MM.mneg h))) s3)
    (trans (lo-left (MM.mneg h) h' m1 one zero)
     (B.blk-cong _ _ _ _ _ _ _ _ (refl h') (refl m1) c2 d2)) ;
  -- u h' . (h' -1; 0 h) = (h' 0; 0 h)
  s1 : Id M2.Mat w1 (diag h' h) =
   trans (ap (M2.mmul (u h')) s2)
    (trans (u-left h' h' m1 zero h)
     (B.blk-cong _ _ _ _ _ _ _ _
      (trans (ap (MM.madd h') (B.mul-zero-right h')) (MM.m-addZ h'))
      (trans (ap (MM.madd m1) hh') (B.neg-add-left one)) (refl zero) (refl h))) ;
 } ;
 whitehead (h h' : MM.Mat) (hh : Id MM.Mat (MM.mmul h h') one) (hh' : Id MM.Mat (MM.mmul h' h) one) :
  Id M2.Mat (M2.mmul (u h') (M2.mmul (lo (MM.mneg h)) (M2.mmul (u h') (M2.mmul (u m1) (M2.mmul (lo one) (u m1))))))
   (diag h' h) = Identity[h,h',hh,hh'].s1 ;

 -- the homotopy: every block multiplied by c
 uc (c : R.R) (X : MM.Mat) : M2.Mat = u (MM.mscale c X) ;
 lc (c : R.R) (X : MM.Mat) : M2.Mat = lo (MM.mscale c X) ;
 uc' (c : R.R) (X : MM.Mat) : M2.Mat = u (MM.mneg (MM.mscale c X)) ;
 lc' (c : R.R) (X : MM.Mat) : M2.Mat = lo (MM.mneg (MM.mscale c X)) ;
 word (c : R.R) (X1 X2 X3 X4 X5 X6 : MM.Mat) : M2.Mat =
  M2.mmul (uc c X1) (M2.mmul (lc c X2) (M2.mmul (uc c X3) (M2.mmul (uc c X4) (M2.mmul (lc c X5) (uc c X6))))) ;
 word' (c : R.R) (X1 X2 X3 X4 X5 X6 : MM.Mat) : M2.Mat =
  M2.mmul (M2.mmul (M2.mmul (M2.mmul (M2.mmul (uc' c X6) (lc' c X5)) (uc' c X4)) (uc' c X3)) (lc' c X2)) (uc' c X1) ;
 word-inverse (c : R.R) (X1 X2 X3 X4 X5 X6 : MM.Mat) : I2.Inverse[word c X1 X2 X3 X4 X5 X6,word' c X1 X2 X3 X4 X5 X6] =
  mul-inverse _ _ _ _ (u-inverse (MM.mscale c X1))
   (mul-inverse _ _ _ _ (lo-inverse (MM.mscale c X2))
    (mul-inverse _ _ _ _ (u-inverse (MM.mscale c X3))
     (mul-inverse _ _ _ _ (u-inverse (MM.mscale c X4))
      (mul-inverse _ _ _ _ (lo-inverse (MM.mscale c X5)) (u-inverse (MM.mscale c X6)))))) ;
 -- c = 0
 scale-zero (X : MM.Mat) : Id MM.Mat (MM.mscale R.z X) zero =
  MM.mat-eq (MM.mscale R.z X) zero (\ i j -> RL[R].zero-mul (X i j)) ;
 uc-zero (X : MM.Mat) : Id M2.Mat (uc R.z X) M2.mone = trans (ap u (scale-zero X)) B.blk-one ;
 lc-zero (X : MM.Mat) : Id M2.Mat (lc R.z X) M2.mone = trans (ap lo (scale-zero X)) B.blk-one ;
 one-one (P Q : M2.Mat) (p : Id M2.Mat P M2.mone) (q : Id M2.Mat Q M2.mone) : Id M2.Mat (M2.mmul P Q) M2.mone =
  trans (cong2 M2.Mat M2.mmul _ _ _ _ p q) (M2.m-one-left M2.mone) ;
 word-zero (X1 X2 X3 X4 X5 X6 : MM.Mat) : Id M2.Mat (word R.z X1 X2 X3 X4 X5 X6) M2.mone =
  one-one _ _ (uc-zero X1) (one-one _ _ (lc-zero X2) (one-one _ _ (uc-zero X3)
   (one-one _ _ (uc-zero X4) (one-one _ _ (lc-zero X5) (uc-zero X6))))) ;
 mul-cong (P P' Q Q' : M2.Mat) (p : Id M2.Mat P P') (q : Id M2.Mat Q Q') : Id M2.Mat (M2.mmul P Q) (M2.mmul P' Q') =
  cong2 M2.Mat M2.mmul _ _ _ _ p q ;
 word-cong (c : R.R) (X1 X2 X3 X4 X5 X6 Y1 Y2 Y3 Y4 Y5 Y6 : MM.Mat)
  (p1 : Id MM.Mat X1 Y1) (p2 : Id MM.Mat X2 Y2) (p3 : Id MM.Mat X3 Y3) (p4 : Id MM.Mat X4 Y4)
  (p5 : Id MM.Mat X5 Y5) (p6 : Id MM.Mat X6 Y6) :
  Id M2.Mat (word c X1 X2 X3 X4 X5 X6) (word c Y1 Y2 Y3 Y4 Y5 Y6) =
  mul-cong _ _ _ _ (ap (uc c) p1) (mul-cong _ _ _ _ (ap (lc c) p2)
   (mul-cong _ _ _ _ (ap (uc c) p3) (mul-cong _ _ _ _ (ap (uc c) p4)
    (mul-cong _ _ _ _ (ap (lc c) p5) (ap (uc c) p6))))) ;
 -- c = 1
 word-one (X1 X2 X3 X4 X5 X6 : MM.Mat) :
  Id M2.Mat (word R.o X1 X2 X3 X4 X5 X6)
   (M2.mmul (u X1) (M2.mmul (lo X2) (M2.mmul (u X3) (M2.mmul (u X4) (M2.mmul (lo X5) (u X6)))))) =
  mul-cong _ _ _ _ (ap u (MM.m-scale-one X1)) (mul-cong _ _ _ _ (ap lo (MM.m-scale-one X2))
   (mul-cong _ _ _ _ (ap u (MM.m-scale-one X3)) (mul-cong _ _ _ _ (ap u (MM.m-scale-one X4))
    (mul-cong _ _ _ _ (ap lo (MM.m-scale-one X5)) (ap u (MM.m-scale-one X6)))))) ;
} ;
module Map (X Y : CRing) (setX : Pr.isSet X.R) (setY : Pr.isSet Y.R) (f : H.Hom X Y) (M : Nat) {
 module WX = Over[X,setX,M] ;
 module WY = Over[Y,setY,M] ;
 module BM = Blocks[l].Map[X,Y,setX,setY,f,M] ;
 module MM = BM.MM ;
 module M2 = BM.M2 ;
 map-u (x : WX.MM.Mat) : Id WY.M2.Mat (M2.map (WX.u x)) (WY.u (MM.map x)) =
  trans (BM.map-blk WX.one x WX.zero WX.one)
   (WY.B.blk-cong _ _ _ _ _ _ _ _ MM.map-one (refl (MM.map x)) MM.map-zero MM.map-one) ;
 map-lo (y : WX.MM.Mat) : Id WY.M2.Mat (M2.map (WX.lo y)) (WY.lo (MM.map y)) =
  trans (BM.map-blk WX.one WX.zero y WX.one)
   (WY.B.blk-cong _ _ _ _ _ _ _ _ MM.map-one MM.map-zero (refl (MM.map y)) MM.map-one) ;
 map-uc (c : X.R) (A : WX.MM.Mat) : Id WY.M2.Mat (M2.map (WX.uc c A)) (WY.uc (f.1 c) (MM.map A)) =
  trans (map-u (WX.MM.mscale c A)) (ap WY.u (MM.map-scale c A)) ;
 map-lc (c : X.R) (A : WX.MM.Mat) : Id WY.M2.Mat (M2.map (WX.lc c A)) (WY.lc (f.1 c) (MM.map A)) =
  trans (map-lo (WX.MM.mscale c A)) (ap WY.lo (MM.map-scale c A)) ;
 map-mul (P Q : WX.M2.Mat) (P' Q' : WY.M2.Mat) (p : Id WY.M2.Mat (M2.map P) P') (q : Id WY.M2.Mat (M2.map Q) Q') :
  Id WY.M2.Mat (M2.map (WX.M2.mmul P Q)) (WY.M2.mmul P' Q') =
  trans (M2.map-mul P Q) (WY.mul-cong _ _ _ _ p q) ;
 map-word (c : X.R) (X1 X2 X3 X4 X5 X6 : WX.MM.Mat) :
  Id WY.M2.Mat (M2.map (WX.word c X1 X2 X3 X4 X5 X6))
   (WY.word (f.1 c) (MM.map X1) (MM.map X2) (MM.map X3) (MM.map X4) (MM.map X5) (MM.map X6)) =
  map-mul _ _ _ _ (map-uc c X1) (map-mul _ _ _ _ (map-lc c X2) (map-mul _ _ _ _ (map-uc c X3)
   (map-mul _ _ _ _ (map-uc c X4) (map-mul _ _ _ _ (map-lc c X5) (map-uc c X6))))) ;
} ;
