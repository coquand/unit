-- Comaximal elements: u x + v y = 1.  If u, v and u', v are comaximal, so
-- are u u', v:
--   1 = u x + v y = u x (u' x' + v y') + v y = (u u')(x x') + v (u x y' + y).
-- Hence powers of comaximal elements are comaximal.
level l ; open Ring[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A : CRing) {
 open A ; module L = RL[A] ;
 module P = AffinePowers[l].Over[A] ;
 Comaximal (u v : R) : U l = (x : R) * (y : R) * Id R (add (mul u x) (mul v y)) o ;
 product-left (u u' v : R) (c : Comaximal u v) (c' : Comaximal u' v) : Comaximal (mul u u') v =
  (mul c.1 c'.1,add (mul (mul u c.1) c'.2.1) c.2.1,
   sym (calc R { o
     =< sym c.2.2 > add (mul u c.1) (mul v c.2.1)
     =< ap (\ t -> add t (mul v c.2.1)) (sym (mulO (mul u c.1))) > add (mul (mul u c.1) o) (mul v c.2.1)
     =< ap (\ t -> add (mul (mul u c.1) t) (mul v c.2.1)) (sym c'.2.2) >
        add (mul (mul u c.1) (add (mul u' c'.1) (mul v c'.2.1))) (mul v c.2.1)
     =< ap (\ t -> add t (mul v c.2.1)) (dist (mul u c.1) (mul u' c'.1) (mul v c'.2.1)) >
        add (add (mul (mul u c.1) (mul u' c'.1)) (mul (mul u c.1) (mul v c'.2.1))) (mul v c.2.1)
     =< sym (addA (mul (mul u c.1) (mul u' c'.1)) (mul (mul u c.1) (mul v c'.2.1)) (mul v c.2.1)) >
        add (mul (mul u c.1) (mul u' c'.1)) (add (mul (mul u c.1) (mul v c'.2.1)) (mul v c.2.1))
     =< ap (\ t -> add t (add (mul (mul u c.1) (mul v c'.2.1)) (mul v c.2.1))) (L.mul-four u c.1 u' c'.1) >
        add (mul (mul u u') (mul c.1 c'.1)) (add (mul (mul u c.1) (mul v c'.2.1)) (mul v c.2.1))
     =< ap (\ t -> add (mul (mul u u') (mul c.1 c'.1)) (add t (mul v c.2.1))) (L.mul-swap (mul u c.1) v c'.2.1) >
        add (mul (mul u u') (mul c.1 c'.1)) (add (mul v (mul (mul u c.1) c'.2.1)) (mul v c.2.1))
     =< ap (add (mul (mul u u') (mul c.1 c'.1))) (sym (dist v (mul (mul u c.1) c'.2.1) c.2.1)) >
        add (mul (mul u u') (mul c.1 c'.1)) (mul v (add (mul (mul u c.1) c'.2.1) c.2.1)) })) ;
 symmetric (u v : R) (c : Comaximal u v) : Comaximal v u =
  (c.2.1,c.1,trans (addC (mul v c.2.1) (mul u c.1)) c.2.2) ;
 -- 1 1 + v 0 = 1
 one-left (v : R) : Comaximal o v = (o,z,trans (L.add-mulzero (mul o o) v) (mulO o)) ;
 power-left (u v : R) (c : Comaximal u v) : (k : Nat) -> Comaximal (P.power u k) v = split {
  zero -> one-left v ;
  suc k | ih -> product-left u (P.power u k) v c ih } ;
 powers (u v : R) (c : Comaximal u v) (k m : Nat) : Comaximal (P.power u k) (P.power v m) =
  symmetric (P.power v m) (P.power u k)
   (power-left v (P.power u k) (symmetric (P.power u k) v (power-left u v c k)) m) ;
 merely-powers (u v : R) (c : Tr.Trunc[Comaximal u v].carrier) (k m : Nat) :
  Tr.Trunc[Comaximal (P.power u k) (P.power v m)].carrier =
  TC.map (Comaximal u v) (Comaximal (P.power u k) (P.power v m)) (\ w -> powers u v w k m) c ;
} ;
