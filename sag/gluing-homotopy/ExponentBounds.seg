-- Exponents that can be raised.  A property P of natural numbers is
-- monotone when P k gives P (m + k).  Finitely many monotone properties,
-- each holding for some exponent, hold together for one exponent: the sum
-- of the exponents (common).  With truncations, the same by finite choice
-- (merely-common).  The matrix case is a family indexed by Fin n twice.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
Monotone (P : Nat -> U l) : U l = (m k : Nat) -> P k -> P (plus m k) ;
Bound (P : Nat -> U l) : U l = (k : Nat) * P k ;
Merely (P : Nat -> U l) : U l = Tr.Trunc[Bound P].carrier ;
-- P k also gives P (k + m).
raise-right (P : Nat -> U l) (mono : Monotone P) (k m : Nat) (h : P k) : P (plus k m) =
 subst P (plus-comm m k) (mono m k h) ;

All (n : Nat) (P : Fin n -> Nat -> U l) (k : Nat) : U l = (i : Fin n) -> P i k ;
all-monotone (n : Nat) (P : Fin n -> Nat -> U l) (mono : (i : Fin n) -> Monotone (P i)) :
 Monotone (All n P) = \ m k h i -> mono i m k (h i) ;
common : (n : Nat) (P : Fin n -> Nat -> U l) -> ((i : Fin n) -> Monotone (P i)) ->
 ((i : Fin n) -> Bound (P i)) -> Bound (All n P) = split {
 zero -> \ P mono w -> (zero,AffineFinite[l].empty-section (\ i -> P i zero)) ;
 suc n | ih -> \ P mono w ->
  let { old : Bound (All n (\ i -> P (inl i))) =
         ih (\ i -> P (inl i)) (\ i -> mono (inl i)) (\ i -> w (inl i)) ;
        last : Bound (P (inr tt)) = w (inr tt) ; } in
  (plus last.1 old.1,
   AffineFinite[l].section n (\ i -> P i (plus last.1 old.1))
    (\ i -> mono (inl i) last.1 old.1 (old.2 i))
    (raise-right (P (inr tt)) (mono (inr tt)) last.1 old.1 last.2)) } ;
merely-common (n : Nat) (P : Fin n -> Nat -> U l) (mono : (i : Fin n) -> Monotone (P i))
 (w : (i : Fin n) -> Merely (P i)) : Merely (All n P) =
 TC.map ((i : Fin n) -> Bound (P i)) (Bound (All n P)) (common n P mono)
  (AffineFinite[l].choice n (\ i -> Bound (P i)) w) ;

-- Families indexed by the entries of an n x n matrix.
All2 (n : Nat) (P : Fin n -> Fin n -> Nat -> U l) : Nat -> U l =
 All n (\ i -> All n (P i)) ;
all2-monotone (n : Nat) (P : Fin n -> Fin n -> Nat -> U l)
 (mono : (i j : Fin n) -> Monotone (P i j)) : Monotone (All2 n P) =
 all-monotone n (\ i -> All n (P i)) (\ i -> all-monotone n (P i) (mono i)) ;
merely-common2 (n : Nat) (P : Fin n -> Fin n -> Nat -> U l)
 (mono : (i j : Fin n) -> Monotone (P i j)) (w : (i j : Fin n) -> Merely (P i j)) :
 Merely (All2 n P) =
 merely-common n (\ i -> All n (P i)) (\ i -> all-monotone n (P i) (mono i))
  (\ i -> merely-common n (P i) (mono i) (w i)) ;
-- Two monotone properties hold together.
Both (P Q : Nat -> U l) (k : Nat) : U l = P k * Q k ;
both (P Q : Nat -> U l) (mp : Monotone P) (mq : Monotone Q)
 (p : Merely P) (q : Merely Q) : Merely (Both P Q) =
 TC.map2 (Bound P) (Bound Q) (Bound (Both P Q))
  (\ x y -> (plus x.1 y.1,(raise-right P mp x.1 y.1 x.2,mq x.1 y.1 y.2))) p q ;
