-- A projector for a glued module.  In the situation of STABLESUM, let g, g'
-- be inverse n x n matrices over C.  DIAGONALPRODUCT (for h = g') gives
-- inverse pairs beta over A_b and alpha over A_a with
--     k := diag(g, g') = beta alpha        (same-image in C),
-- since diag(g g', 1) = 1.  Let D = blk 1 0 0 0 (VECTORBLOCKS: D w = cat w_l 0).
-- Then alpha D alpha' over A_a and beta' D beta over A_b agree in C:
--     alpha D alpha' = beta' k D alpha' = beta' D k alpha' = beta' D beta,
-- because k D = D k (k is block diagonal), alpha = beta' k and k alpha' = beta.
-- So there is a matrix E over A with ia E = alpha D alpha' and
-- ib E = beta' D beta (EQUALISER, entrywise), and E E = E (both same-image are
-- idempotent).  Its image is P_g:
--     r |-> ((alpha' r)_l, (beta r)_l),   (u, v) |-> the r with
--     ia r = alpha (cat u 0), ib r = beta' (cat v 0),
-- where jb((beta r)_l) = (k alpha' r)_l = g (alpha' r)_l, and conversely
-- alpha (cat u 0) = beta' k (cat u 0) = beta' (cat (g u) 0) = beta' (cat v 0)
-- in C; E r = r since D (cat u 0) = cat u 0, and alpha (cat (alpha' r)_l 0)
-- = alpha D alpha' r = E r = r.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (ka : Localising[l].Over[A,Aa,ia,a].Localising)
 (kb : Localising[l].Over[A,Ab,ib,b].Localising)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (n : Nat) {
 module DP = DiagonalProduct[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,la,lb,comaximal,n] ;
 module Eq = Equaliser[l].Over[A,Aa,Ab,C,setA,setAa,setAb,ia,ib,ja,jb,square,a,b,ka,kb,la,lb,comaximal] ;
 module G1 = Glued[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,n] ;
 module G2 = Glued[l].Over[A,Aa,Ab,C,setAa,setAb,setC,ia,ib,ja,jb,square,plus n n] ;
 module PJ = Projectors[l].Over[A,setA] ;
 module MI = G1.MI ;
 module BA = VectorBlocks[l].Over[Aa,setAa,n] ;
 module BB = VectorBlocks[l].Over[Ab,setAb,n] ;
 module BC = VectorBlocks[l].Over[C,setC,n] ;
 module BMa = VectorBlocks[l].Map[Aa,C,setAa,setC,ja,n] ;
 module BMb = VectorBlocks[l].Map[Ab,C,setAb,setC,jb,n] ;
 module W = DP.W ;
 module VA = Vectors[l].Over[A,setA,plus n n] ;
 module IA = Vectors[l].Map[A,Aa,setA,setAa,ia,plus n n] ;
 module IB = Vectors[l].Map[A,Ab,setA,setAb,ib,plus n n] ;
 module VC = G2.VC ;
 module MC = G2.MC ;
 -- the two same-image of a vector over A agree in C
 same-image (r : VA.Vec) : Id VC.Vec (G2.JA.map (IA.map r)) (G2.JB.map (IB.map r)) = VC.vec-eq _ _ (\ i -> square (r i)) ;
 -- vectors over A are determined by their same-image, and have preimages
 vec-unique (r r' : VA.Vec) (ha : Id G2.VAa.Vec (IA.map r) (IA.map r')) (hb : Id G2.VAb.Vec (IB.map r) (IB.map r')) : Id VA.Vec r r' =
  VA.vec-eq r r' (\ i -> Eq.Unique[r i,r' i,G2.VAa.entry _ _ ha i,G2.VAb.entry _ _ hb i].equal) ;
 Preimage (u : G2.VAa.Vec) (v : G2.VAb.Vec) : U l = (r : VA.Vec) * Id G2.VAa.Vec (IA.map r) u * Id G2.VAb.Vec (IB.map r) v ;
 preimage (u : G2.VAa.Vec) (v : G2.VAb.Vec) (h : Id VC.Vec (G2.JA.map u) (G2.JB.map v)) : Preimage u v =
  (\ i -> (Eq.preimage (u i) (v i) (VC.entry _ _ h i)).1,
   G2.VAa.vec-eq _ _ (\ i -> (Eq.preimage (u i) (v i) (VC.entry _ _ h i)).2.1),
   G2.VAb.vec-eq _ _ (\ i -> (Eq.preimage (u i) (v i) (VC.entry _ _ h i)).2.2)) ;
 module IAm = MatrixMap[l].Over[A,Aa,setA,setAa,ia,plus n n] ;
 module IBm = MatrixMap[l].Over[A,Ab,setA,setAb,ib,plus n n] ;

 module Explicit (g g' : G1.MC.Mat) (gi : DP.IM.Inverse[g,g']) {
  gi' : DP.IM.Inverse[g',g] = new DP.IM.Inverse[g',g,gi.left,gi.right] ;
  module DL = DP.Lemma[g,g',gi,g',g,gi'] ;
  module Pg = G1.Glue[g] ;
  k : MC.Mat = W.diag g g' ;
  -- diag(g g', 1) = 1
  G-one : Id MC.Mat DL.G MC.mone =
   trans (W.B.blk-cong _ _ _ _ _ _ _ _ gi.right (refl W.zero) (refl W.zero) (refl W.one)) W.B.blk-one ;
  -- k acts by halves
  k-half (w : VC.Vec) : Id BC.V.Vec (BC.lhalf (VC.act k w)) (BC.V.act g (BC.lhalf w)) =
   BC.V.vec-eq _ _ (BC.diag-l g g' w) ;
  k-cat (x : BC.V.Vec) : Id VC.Vec (VC.act k (BC.cat x BC.V.vzero)) (BC.cat (BC.V.act g x) BC.V.vzero) =
   BC.Halves[VC.act k (BC.cat x BC.V.vzero),BC.cat (BC.V.act g x) BC.V.vzero,
    \ i -> trans (BC.diag-l g g' (BC.cat x BC.V.vzero) i)
     (trans (ap (\ t -> BC.V.act g t i) (BC.lhalf-cat x BC.V.vzero)) (sym (BC.cat-l (BC.V.act g x) BC.V.vzero i))),
    \ i -> trans (BC.diag-r g g' (BC.cat x BC.V.vzero) i)
     (trans (ap (\ t -> BC.V.act g' t i) (BC.rhalf-cat x BC.V.vzero))
      (trans (BC.V.entry _ _ (BC.V.act-zero g') i) (sym (BC.cat-r (BC.V.act g x) BC.V.vzero i))))].equal ;
  k-D (w : VC.Vec) : Id VC.Vec (VC.act k (VC.act BC.D w)) (VC.act BC.D (VC.act k w)) =
   trans (ap (VC.act k) (BC.head w))
    (trans (k-cat (BC.lhalf w)) (trans (ap (\ t -> BC.cat t BC.V.vzero) (sym (k-half w))) (sym (BC.head (VC.act k w))))) ;
  module Data (r : DL.Result) {
   beta : G2.VAb.MR.Mat = r.1 ;
   beta' : G2.VAb.MR.Mat = r.2.1 ;
   bi : G2.IAb.Inverse[beta,beta'] = r.2.2.1 ;
   alpha : G2.VAa.MR.Mat = r.2.2.2.1 ;
   alpha' : G2.VAa.MR.Mat = r.2.2.2.2.1 ;
   ai : G2.IAa.Inverse[alpha,alpha'] = r.2.2.2.2.2.1 ;
   B : MC.Mat = G2.JB.MM.map beta ;
   B' : MC.Mat = G2.JB.MM.map beta' ;
   Al : MC.Mat = G2.JA.MM.map alpha ;
   Al' : MC.Mat = G2.JA.MM.map alpha' ;
   bc : G2.JB.MM.IY.Inverse[B,B'] = G2.JB.MM.map-inverse beta beta' bi ;
   ac : G2.JA.MM.IY.Inverse[Al,Al'] = G2.JA.MM.map-inverse alpha alpha' ai ;
   -- k = beta alpha
   k-eq : Id MC.Mat k (MC.mmul B Al) =
    trans r.2.2.2.2.2.2 (ap (\ X -> MC.mmul X Al) (trans (ap (MC.mmul B) G-one) (MC.m-one-right B))) ;
   -- k alpha' = beta, alpha = beta' k
   kB (w : VC.Vec) : Id VC.Vec (VC.act k (VC.act Al' w)) (VC.act B w) =
    calc VC.Vec { VC.act k (VC.act Al' w)
      =< ap (\ X -> VC.act X (VC.act Al' w)) k-eq > VC.act (MC.mmul B Al) (VC.act Al' w)
      =< sym (VC.act-mul B Al (VC.act Al' w)) > VC.act B (VC.act Al (VC.act Al' w))
      =< ap (VC.act B) (VC.act-cancel Al' Al ac.right w) > VC.act B w } ;
   kA (w : VC.Vec) : Id VC.Vec (VC.act Al w) (VC.act B' (VC.act k w)) =
    sym (calc VC.Vec { VC.act B' (VC.act k w)
      =< ap (\ X -> VC.act B' (VC.act X w)) k-eq > VC.act B' (VC.act (MC.mmul B Al) w)
      =< ap (VC.act B') (sym (VC.act-mul B Al w)) > VC.act B' (VC.act B (VC.act Al w))
      =< VC.act-cancel B B' bc.left (VC.act Al w) > VC.act Al w }) ;
   -- the two idempotents and their same-image in C
   Ma : G2.VAa.MR.Mat = G2.VAa.MR.mmul (G2.VAa.MR.mmul alpha BA.D) alpha' ;
   Mb : G2.VAb.MR.Mat = G2.VAb.MR.mmul (G2.VAb.MR.mmul beta' BB.D) beta ;
   Ma-act (w : G2.VAa.Vec) : Id G2.VAa.Vec (G2.VAa.act Ma w) (G2.VAa.act alpha (G2.VAa.act BA.D (G2.VAa.act alpha' w))) =
    trans (sym (G2.VAa.act-mul (G2.VAa.MR.mmul alpha BA.D) alpha' w)) (sym (G2.VAa.act-mul alpha BA.D (G2.VAa.act alpha' w))) ;
   Mb-act (w : G2.VAb.Vec) : Id G2.VAb.Vec (G2.VAb.act Mb w) (G2.VAb.act beta' (G2.VAb.act BB.D (G2.VAb.act beta w))) =
    trans (sym (G2.VAb.act-mul (G2.VAb.MR.mmul beta' BB.D) beta w)) (sym (G2.VAb.act-mul beta' BB.D (G2.VAb.act beta w))) ;
   Ma-image : Id MC.Mat (G2.JA.MM.map Ma) (MC.mmul (MC.mmul Al BC.D) Al') =
    trans (G2.JA.MM.map-mul (G2.VAa.MR.mmul alpha BA.D) alpha')
     (ap (\ X -> MC.mmul X Al') (trans (G2.JA.MM.map-mul alpha BA.D) (ap (MC.mmul Al) BMa.map-D))) ;
   Mb-image : Id MC.Mat (G2.JB.MM.map Mb) (MC.mmul (MC.mmul B' BC.D) B) =
    trans (G2.JB.MM.map-mul (G2.VAb.MR.mmul beta' BB.D) beta)
     (ap (\ X -> MC.mmul X B) (trans (G2.JB.MM.map-mul beta' BB.D) (ap (MC.mmul B') BMb.map-D))) ;
   agree-act (w : VC.Vec) : Id VC.Vec (VC.act (MC.mmul (MC.mmul Al BC.D) Al') w) (VC.act (MC.mmul (MC.mmul B' BC.D) B) w) =
    calc VC.Vec { VC.act (MC.mmul (MC.mmul Al BC.D) Al') w
      =< trans (sym (VC.act-mul (MC.mmul Al BC.D) Al' w)) (sym (VC.act-mul Al BC.D (VC.act Al' w))) >
         VC.act Al (VC.act BC.D (VC.act Al' w))
      =< kA (VC.act BC.D (VC.act Al' w)) > VC.act B' (VC.act k (VC.act BC.D (VC.act Al' w)))
      =< ap (VC.act B') (k-D (VC.act Al' w)) > VC.act B' (VC.act BC.D (VC.act k (VC.act Al' w)))
      =< ap (\ t -> VC.act B' (VC.act BC.D t)) (kB w) > VC.act B' (VC.act BC.D (VC.act B w))
      =< trans (VC.act-mul B' BC.D (VC.act B w)) (VC.act-mul (MC.mmul B' BC.D) B w) > VC.act (MC.mmul (MC.mmul B' BC.D) B) w } ;
   agree : Id MC.Mat (G2.JA.MM.map Ma) (G2.JB.MM.map Mb) =
    trans Ma-image (trans (VC.mat-act _ _ agree-act) (sym Mb-image)) ;
   -- the matrix E over A
   entry (i j : Fin (plus n n)) : Eq.Preimage (Ma i j) (Mb i j) =
    Eq.preimage (Ma i j) (Mb i j) (ap (\ Z -> Z i j) agree) ;
   E : VA.MR.Mat = \ i j -> (entry i j).1 ;
   E-a : Id G2.VAa.MR.Mat (IAm.map E) Ma = G2.VAa.MR.mat-eq _ _ (\ i j -> (entry i j).2.1) ;
   E-b : Id G2.VAb.MR.Mat (IBm.map E) Mb = G2.VAb.MR.mat-eq _ _ (\ i j -> (entry i j).2.2) ;
   Ma-idem : Id G2.VAa.MR.Mat (G2.VAa.MR.mmul Ma Ma) Ma = G2.VAa.mat-act _ _ (\ w ->
    calc G2.VAa.Vec { G2.VAa.act (G2.VAa.MR.mmul Ma Ma) w
      =< sym (G2.VAa.act-mul Ma Ma w) > G2.VAa.act Ma (G2.VAa.act Ma w)
      =< trans (Ma-act (G2.VAa.act Ma w)) (ap (\ t -> G2.VAa.act alpha (G2.VAa.act BA.D (G2.VAa.act alpha' t))) (Ma-act w)) >
         G2.VAa.act alpha (G2.VAa.act BA.D (G2.VAa.act alpha' (G2.VAa.act alpha (G2.VAa.act BA.D (G2.VAa.act alpha' w)))))
      =< ap (\ t -> G2.VAa.act alpha (G2.VAa.act BA.D t)) (G2.VAa.act-cancel alpha alpha' ai.left (G2.VAa.act BA.D (G2.VAa.act alpha' w))) >
         G2.VAa.act alpha (G2.VAa.act BA.D (G2.VAa.act BA.D (G2.VAa.act alpha' w)))
      =< ap (G2.VAa.act alpha) (BA.head-head (G2.VAa.act alpha' w)) > G2.VAa.act alpha (G2.VAa.act BA.D (G2.VAa.act alpha' w))
      =< sym (Ma-act w) > G2.VAa.act Ma w }) ;
   Mb-idem : Id G2.VAb.MR.Mat (G2.VAb.MR.mmul Mb Mb) Mb = G2.VAb.mat-act _ _ (\ w ->
    calc G2.VAb.Vec { G2.VAb.act (G2.VAb.MR.mmul Mb Mb) w
      =< sym (G2.VAb.act-mul Mb Mb w) > G2.VAb.act Mb (G2.VAb.act Mb w)
      =< trans (Mb-act (G2.VAb.act Mb w)) (ap (\ t -> G2.VAb.act beta' (G2.VAb.act BB.D (G2.VAb.act beta t))) (Mb-act w)) >
         G2.VAb.act beta' (G2.VAb.act BB.D (G2.VAb.act beta (G2.VAb.act beta' (G2.VAb.act BB.D (G2.VAb.act beta w)))))
      =< ap (\ t -> G2.VAb.act beta' (G2.VAb.act BB.D t)) (G2.VAb.act-cancel beta' beta bi.right (G2.VAb.act BB.D (G2.VAb.act beta w))) >
         G2.VAb.act beta' (G2.VAb.act BB.D (G2.VAb.act BB.D (G2.VAb.act beta w)))
      =< ap (G2.VAb.act beta') (BB.head-head (G2.VAb.act beta w)) > G2.VAb.act beta' (G2.VAb.act BB.D (G2.VAb.act beta w))
      =< sym (Mb-act w) > G2.VAb.act Mb w }) ;
   E-idem : Id VA.MR.Mat (VA.MR.mmul E E) E = VA.MR.mat-eq _ _ (\ i j ->
    Eq.Unique[VA.MR.mmul E E i j,E i j,
     ap (\ Z -> Z i j) (trans (IAm.map-mul E E) (trans (cong2 G2.VAa.MR.Mat G2.VAa.MR.mmul _ _ _ _ E-a E-a) (trans Ma-idem (sym E-a)))),
     ap (\ Z -> Z i j) (trans (IBm.map-mul E E) (trans (cong2 G2.VAb.MR.Mat G2.VAb.MR.mmul _ _ _ _ E-b E-b) (trans Mb-idem (sym E-b))))].equal) ;
   projector : PJ.Projector = new PJ.Projector[plus n n,E,E-idem] ;
   module IE = PJ.Image[projector] ;
   -- the same-image of E r
   E-act-a (w : VA.Vec) : Id G2.VAa.Vec (IA.map (VA.act E w)) (G2.VAa.act Ma (IA.map w)) =
    trans (IA.map-act E w) (ap (\ Z -> G2.VAa.act Z (IA.map w)) E-a) ;
   E-act-b (w : VA.Vec) : Id G2.VAb.Vec (IB.map (VA.act E w)) (G2.VAb.act Mb (IB.map w)) =
    trans (IB.map-act E w) (ap (\ Z -> G2.VAb.act Z (IB.map w)) E-b) ;

   -- alpha (cat u 0) is fixed by alpha D alpha', and beta' (cat v 0) by beta' D beta
   fix-a (u : BA.V.Vec) : Id G2.VAa.Vec (G2.VAa.act Ma (G2.VAa.act alpha (BA.cat u BA.V.vzero))) (G2.VAa.act alpha (BA.cat u BA.V.vzero)) =
    calc G2.VAa.Vec { G2.VAa.act Ma (G2.VAa.act alpha (BA.cat u BA.V.vzero))
      =< Ma-act (G2.VAa.act alpha (BA.cat u BA.V.vzero)) >
         G2.VAa.act alpha (G2.VAa.act BA.D (G2.VAa.act alpha' (G2.VAa.act alpha (BA.cat u BA.V.vzero))))
      =< ap (\ t -> G2.VAa.act alpha (G2.VAa.act BA.D t)) (G2.VAa.act-cancel alpha alpha' ai.left (BA.cat u BA.V.vzero)) >
         G2.VAa.act alpha (G2.VAa.act BA.D (BA.cat u BA.V.vzero))
      =< ap (G2.VAa.act alpha) (BA.head-cat u) > G2.VAa.act alpha (BA.cat u BA.V.vzero) } ;
   fix-b (v : BB.V.Vec) : Id G2.VAb.Vec (G2.VAb.act Mb (G2.VAb.act beta' (BB.cat v BB.V.vzero))) (G2.VAb.act beta' (BB.cat v BB.V.vzero)) =
    calc G2.VAb.Vec { G2.VAb.act Mb (G2.VAb.act beta' (BB.cat v BB.V.vzero))
      =< Mb-act (G2.VAb.act beta' (BB.cat v BB.V.vzero)) >
         G2.VAb.act beta' (G2.VAb.act BB.D (G2.VAb.act beta (G2.VAb.act beta' (BB.cat v BB.V.vzero))))
      =< ap (\ t -> G2.VAb.act beta' (G2.VAb.act BB.D t)) (G2.VAb.act-cancel beta' beta bi.right (BB.cat v BB.V.vzero)) >
         G2.VAb.act beta' (G2.VAb.act BB.D (BB.cat v BB.V.vzero))
      =< ap (G2.VAb.act beta') (BB.head-cat v) > G2.VAb.act beta' (BB.cat v BB.V.vzero) } ;
   -- Image E ~ P_g
   forward-member (w : VA.Vec) :
    Id G1.VC.Vec (G1.JB.map (BB.lhalf (G2.VAb.act beta (IB.map w)))) (G1.VC.act g (G1.JA.map (BA.lhalf (G2.VAa.act alpha' (IA.map w))))) =
    calc G1.VC.Vec { BC.lhalf (G2.JB.map (G2.VAb.act beta (IB.map w)))
      =< ap BC.lhalf (G2.JB.map-act beta (IB.map w)) > BC.lhalf (VC.act B (G2.JB.map (IB.map w)))
      =< ap BC.lhalf (sym (kB (G2.JB.map (IB.map w)))) > BC.lhalf (VC.act k (VC.act Al' (G2.JB.map (IB.map w))))
      =< ap (\ t -> BC.lhalf (VC.act k (VC.act Al' t))) (sym (same-image w)) > BC.lhalf (VC.act k (VC.act Al' (G2.JA.map (IA.map w))))
      =< k-half (VC.act Al' (G2.JA.map (IA.map w))) > G1.VC.act g (BC.lhalf (VC.act Al' (G2.JA.map (IA.map w))))
      =< ap (\ t -> G1.VC.act g (BC.lhalf t)) (sym (G2.JA.map-act alpha' (IA.map w))) >
         G1.VC.act g (BC.lhalf (G2.JA.map (G2.VAa.act alpha' (IA.map w)))) } ;
   forward (w : IE.Carrier) : Pg.Carrier =
    Pg.point (BA.lhalf (G2.VAa.act alpha' (IA.map (IE.value w)))) (BB.lhalf (G2.VAb.act beta (IB.map (IE.value w)))) (forward-member (IE.value w)) ;
   module Back (x : Pg.Carrier) {
    ua : G2.VAa.Vec = G2.VAa.act alpha (BA.cat (Pg.left x) BA.V.vzero) ;
    vb : G2.VAb.Vec = G2.VAb.act beta' (BB.cat (Pg.right x) BB.V.vzero) ;
    agree-c : Id VC.Vec (G2.JA.map ua) (G2.JB.map vb) =
     calc VC.Vec { G2.JA.map ua
       =< G2.JA.map-act alpha (BA.cat (Pg.left x) BA.V.vzero) > VC.act Al (G2.JA.map (BA.cat (Pg.left x) BA.V.vzero))
       =< ap (VC.act Al) (trans (BMa.map-cat (Pg.left x) BA.V.vzero) (ap (BC.cat (G1.JA.map (Pg.left x))) G1.JA.map-zero)) >
          VC.act Al (BC.cat (G1.JA.map (Pg.left x)) BC.V.vzero)
       =< kA (BC.cat (G1.JA.map (Pg.left x)) BC.V.vzero) > VC.act B' (VC.act k (BC.cat (G1.JA.map (Pg.left x)) BC.V.vzero))
       =< ap (VC.act B') (k-cat (G1.JA.map (Pg.left x))) > VC.act B' (BC.cat (G1.VC.act g (G1.JA.map (Pg.left x))) BC.V.vzero)
       =< ap (\ t -> VC.act B' (BC.cat t BC.V.vzero)) (sym (Pg.member x)) > VC.act B' (BC.cat (G1.JB.map (Pg.right x)) BC.V.vzero)
       =< ap (VC.act B') (sym (trans (BMb.map-cat (Pg.right x) BB.V.vzero) (ap (BC.cat (G1.JB.map (Pg.right x))) G1.JB.map-zero))) >
          VC.act B' (G2.JB.map (BB.cat (Pg.right x) BB.V.vzero))
       =< sym (G2.JB.map-act beta' (BB.cat (Pg.right x) BB.V.vzero)) > G2.JB.map vb } ;
    pre : Preimage ua vb = preimage ua vb agree-c ;
    fixed-a : Id G2.VAa.Vec (G2.VAa.act Ma ua) ua = fix-a (Pg.left x) ;
    fixed-b : Id G2.VAb.Vec (G2.VAb.act Mb vb) vb = fix-b (Pg.right x) ;
    member : IE.Member pre.1 = vec-unique (VA.act E pre.1) pre.1
     (trans (E-act-a pre.1) (trans (ap (G2.VAa.act Ma) pre.2.1) (trans fixed-a (sym pre.2.1))))
     (trans (E-act-b pre.1) (trans (ap (G2.VAb.act Mb) pre.2.2) (trans fixed-b (sym pre.2.2)))) ;
    point : IE.Carrier = (pre.1,member) ;
   } ;
   -- alpha (cat (alpha' w)_l 0) = alpha D alpha' w
   restore-a (w : G2.VAa.Vec) : Id G2.VAa.Vec (G2.VAa.act alpha (BA.cat (BA.lhalf (G2.VAa.act alpha' w)) BA.V.vzero)) (G2.VAa.act Ma w) =
    trans (ap (G2.VAa.act alpha) (sym (BA.head (G2.VAa.act alpha' w)))) (sym (Ma-act w)) ;
   restore-b (w : G2.VAb.Vec) : Id G2.VAb.Vec (G2.VAb.act beta' (BB.cat (BB.lhalf (G2.VAb.act beta w)) BB.V.vzero)) (G2.VAb.act Mb w) =
    trans (ap (G2.VAb.act beta') (sym (BB.head (G2.VAb.act beta w)))) (sym (Mb-act w)) ;
   iso : MI.Iso[IE.image,Pg.glued] = MI.make IE.image Pg.glued forward (\ x -> Back[x].point)
    (\ w w' -> Pg.ext _ _
      (ap BA.lhalf (trans (ap (G2.VAa.act alpha') (IA.map-add (IE.value w) (IE.value w'))) (G2.VAa.act-add alpha' (IA.map (IE.value w)) (IA.map (IE.value w')))))
      (ap BB.lhalf (trans (ap (G2.VAb.act beta) (IB.map-add (IE.value w) (IE.value w'))) (G2.VAb.act-add beta (IB.map (IE.value w)) (IB.map (IE.value w'))))))
    (\ c w -> Pg.ext _ _
      (ap BA.lhalf (trans (ap (G2.VAa.act alpha') (IA.map-scale c (IE.value w))) (G2.VAa.act-scale alpha' (ia.1 c) (IA.map (IE.value w)))))
      (ap BB.lhalf (trans (ap (G2.VAb.act beta) (IB.map-scale c (IE.value w))) (G2.VAb.act-scale beta (ib.1 c) (IB.map (IE.value w))))))
    (\ x -> Pg.ext _ _
      (trans (ap (\ t -> BA.lhalf (G2.VAa.act alpha' t)) Back[x].pre.2.1)
       (trans (ap BA.lhalf (G2.VAa.act-cancel alpha alpha' ai.left (BA.cat (Pg.left x) BA.V.vzero))) (BA.lhalf-cat (Pg.left x) BA.V.vzero)))
      (trans (ap (\ t -> BB.lhalf (G2.VAb.act beta t)) Back[x].pre.2.2)
       (trans (ap BB.lhalf (G2.VAb.act-cancel beta' beta bi.right (BB.cat (Pg.right x) BB.V.vzero))) (BB.lhalf-cat (Pg.right x) BB.V.vzero))))
    (\ w -> IE.ext _ _ (vec-unique _ _
      (trans Back[forward w].pre.2.1 (trans (restore-a (IA.map (IE.value w)))
       (trans (sym (E-act-a (IE.value w))) (ap IA.map (IE.member w)))))
      (trans Back[forward w].pre.2.2 (trans (restore-b (IB.map (IE.value w)))
       (trans (sym (E-act-b (IE.value w))) (ap IB.map (IE.member w))))))) ;
  } ;
  -- merely, a projector presenting P_g
  Presented : U l = (p : PJ.Projector) * MI.Iso[PJ.Image[p].image,Pg.glued] ;
  theorem : Tr.Trunc[Presented].carrier =
   TC.map DL.Result Presented (\ r -> (Data[r].projector,Data[r].iso)) DL.theorem ;
 } ;
} ;
