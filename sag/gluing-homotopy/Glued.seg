-- The module glued along a matrix (gabber-recollement, "Gluing matrices").
-- In a commutative square A -> A_a -> C, A -> A_b -> C (as in HOMOTOPY), for
-- an M x M matrix g over C,
--     P_g = { (u, v) in A_a^M x A_b^M | jb(v) = g ja(u) },
-- an A-submodule of A_a^M x A_b^M, with A acting through ia and ib: the
-- condition is additive in (u, v), and for r in A, with
-- c(r) = ja(ia r) = jb(ib r),
--     jb(ib(r) v) = c(r) jb(v) = c(r) g ja(u) = g ja(ia(r) u).
--
-- Invariance.  If k = beta g alpha (images in C) for inverse pairs
-- beta, beta' over A_b and alpha, alpha' over A_a, then
--     (u, v) |-> (alpha u, beta' v),     (u, v) |-> (alpha' u, beta v)
-- are inverse isomorphisms P_k ~ P_g, because
--     jb(beta' v) = beta' k ja(u) = beta' beta g alpha ja(u) = g ja(alpha u),
--     jb(beta v) = beta g ja(u) = beta g alpha alpha' ja(u) = k ja(alpha' u).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module SP = SerreModuleProducts[l] ;
module Over (A Aa Ab C : CRing) (setAa : Pr.isSet Aa.R) (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r))) (M : Nat) {
 module SA = SM.Over[A] ;
 module MI = ModuleIso[l].Over[A] ;
 module VAa = Vectors[l].Over[Aa,setAa,M] ;
 module VAb = Vectors[l].Over[Ab,setAb,M] ;
 module VC = Vectors[l].Over[C,setC,M] ;
 module JA = Vectors[l].Map[Aa,C,setAa,setC,ja,M] ;
 module JB = Vectors[l].Map[Ab,C,setAb,setC,jb,M] ;
 module MC = VC.MR ;
 module IAa = MatrixMap[l].Invertible[Aa,setAa,M] ;
 module IAb = MatrixMap[l].Invertible[Ab,setAb,M] ;
 -- A_a^M and A_b^M as A-modules, and their sum
 module Fa = SP.Over[A,Fin M,\ i -> MM.RestrictScalars[A,Aa,ia].Of[SM.Over[Aa].regular setAa].restricted] ;
 module Fb = SP.Over[A,Fin M,\ i -> MM.RestrictScalars[A,Ab,ib].Of[SM.Over[Ab].regular setAb].restricted] ;
 module E = SP.Pair[A,Fa.product,Fb.product] ;

 module Glue (g : MC.Mat) {
  Member (x : E.Carrier) : U l = Id VC.Vec (JB.map x.2) (VC.act g (JA.map x.1)) ;
  member-prop (x : E.Carrier) : Pr.isProp (Member x) = VC.set-vec _ _ ;
  Carrier : U l = (x : E.Carrier) * Member x ;
  value (x : Carrier) : E.Carrier = x.1 ;
  left (x : Carrier) : VAa.Vec = x.1.1 ;
  right (x : Carrier) : VAb.Vec = x.1.2 ;
  member (x : Carrier) : Id VC.Vec (JB.map (right x)) (VC.act g (JA.map (left x))) = x.2 ;
  point (u : VAa.Vec) (v : VAb.Vec) (h : Id VC.Vec (JB.map v) (VC.act g (JA.map u))) : Carrier = ((u,v),h) ;
  ext-value (x y : Carrier) (p : Id E.Carrier (value x) (value y)) : Id Carrier x y =
   Pr.Sigma-eq E.Carrier Member (value x) (value y) (member x) (member y) p (member-prop (value y)) ;
  ext (x y : Carrier) (p : Id VAa.Vec (left x) (left y)) (q : Id VAb.Vec (right x) (right y)) : Id Carrier x y =
   ext-value x y (E.ext (value x) (value y) p q) ;
  set : Pr.isSet Carrier =
   Pr.isSet-Sigma E.Carrier Member E.product.setM (\ x -> Pr.prop-to-set (Member x) (member-prop x)) ;
  zero : Carrier = point VAa.vzero VAb.vzero
   (trans JB.map-zero (sym (trans (ap (VC.act g) JA.map-zero) (VC.act-zero g)))) ;
  add (x y : Carrier) : Carrier = point (VAa.vadd (left x) (left y)) (VAb.vadd (right x) (right y))
   (calc VC.Vec { JB.map (VAb.vadd (right x) (right y))
     =< JB.map-add (right x) (right y) > VC.vadd (JB.map (right x)) (JB.map (right y))
     =< cong2 VC.Vec VC.vadd _ _ _ _ (member x) (member y) >
        VC.vadd (VC.act g (JA.map (left x))) (VC.act g (JA.map (left y)))
     =< sym (VC.act-add g (JA.map (left x)) (JA.map (left y))) > VC.act g (VC.vadd (JA.map (left x)) (JA.map (left y)))
     =< ap (VC.act g) (sym (JA.map-add (left x) (left y))) > VC.act g (JA.map (VAa.vadd (left x) (left y))) }) ;
  negative (x : Carrier) : Carrier = point (VAa.vneg (left x)) (VAb.vneg (right x))
   (calc VC.Vec { JB.map (VAb.vneg (right x))
     =< JB.map-neg (right x) > VC.vneg (JB.map (right x))
     =< ap VC.vneg (member x) > VC.vneg (VC.act g (JA.map (left x)))
     =< sym (VC.act-neg g (JA.map (left x))) > VC.act g (VC.vneg (JA.map (left x)))
     =< ap (VC.act g) (sym (JA.map-neg (left x))) > VC.act g (JA.map (VAa.vneg (left x))) }) ;
  scale (r : A.R) (x : Carrier) : Carrier = point (VAa.vscale (ia.1 r) (left x)) (VAb.vscale (ib.1 r) (right x))
   (calc VC.Vec { JB.map (VAb.vscale (ib.1 r) (right x))
     =< JB.map-scale (ib.1 r) (right x) > VC.vscale (jb.1 (ib.1 r)) (JB.map (right x))
     =< ap (VC.vscale (jb.1 (ib.1 r))) (member x) > VC.vscale (jb.1 (ib.1 r)) (VC.act g (JA.map (left x)))
     =< ap (\ c -> VC.vscale c (VC.act g (JA.map (left x)))) (sym (square r)) >
        VC.vscale (ja.1 (ia.1 r)) (VC.act g (JA.map (left x)))
     =< sym (VC.act-scale g (ja.1 (ia.1 r)) (JA.map (left x))) > VC.act g (VC.vscale (ja.1 (ia.1 r)) (JA.map (left x)))
     =< ap (VC.act g) (sym (JA.map-scale (ia.1 r) (left x))) > VC.act g (JA.map (VAa.vscale (ia.1 r) (left x))) }) ;
  glued : SA.Module = new SA.Module[Carrier,set,zero,add,negative,
   \ x y z -> ext-value _ _ (E.product.maddA (value x) (value y) (value z)),
   \ x y -> ext-value _ _ (E.product.maddC (value x) (value y)),
   \ x -> ext-value _ _ (E.product.maddZ (value x)),
   \ x -> ext-value _ _ (E.product.maddN (value x)),scale,
   \ r s x -> ext-value _ _ (E.product.smA r s (value x)),
   \ x -> ext-value _ _ (E.product.smO (value x)),
   \ r x y -> ext-value _ _ (E.product.smD r (value x) (value y)),
   \ r s x -> ext-value _ _ (E.product.smE r s (value x))] ;
 } ;

 module Invariance (g k : MC.Mat) (beta beta' : VAb.MR.Mat) (bi : IAb.Inverse[beta,beta'])
  (alpha alpha' : VAa.MR.Mat) (ai : IAa.Inverse[alpha,alpha'])
  (e : Id MC.Mat k (MC.mmul (MC.mmul (JB.MM.map beta) g) (JA.MM.map alpha))) {
  module Pk = Glue[k] ;
  module Pg = Glue[g] ;
  -- the images in C
  B : MC.Mat = JB.MM.map beta ;
  B' : MC.Mat = JB.MM.map beta' ;
  Al : MC.Mat = JA.MM.map alpha ;
  Al' : MC.Mat = JA.MM.map alpha' ;
  bc : JB.MM.IY.Inverse[B,B'] = JB.MM.map-inverse beta beta' bi ;
  ac : JA.MM.IY.Inverse[Al,Al'] = JA.MM.map-inverse alpha alpha' ai ;
  forward-member (x : Pk.Carrier) :
   Id VC.Vec (JB.map (VAb.act beta' (Pk.right x))) (VC.act g (JA.map (VAa.act alpha (Pk.left x)))) =
   calc VC.Vec { JB.map (VAb.act beta' (Pk.right x))
     =< JB.map-act beta' (Pk.right x) > VC.act B' (JB.map (Pk.right x))
     =< ap (VC.act B') (Pk.member x) > VC.act B' (VC.act k (JA.map (Pk.left x)))
     =< ap (\ Z -> VC.act B' (VC.act Z (JA.map (Pk.left x)))) e >
        VC.act B' (VC.act (MC.mmul (MC.mmul B g) Al) (JA.map (Pk.left x)))
     =< ap (VC.act B') (sym (VC.act-mul (MC.mmul B g) Al (JA.map (Pk.left x)))) >
        VC.act B' (VC.act (MC.mmul B g) (VC.act Al (JA.map (Pk.left x))))
     =< ap (VC.act B') (sym (VC.act-mul B g (VC.act Al (JA.map (Pk.left x))))) >
        VC.act B' (VC.act B (VC.act g (VC.act Al (JA.map (Pk.left x)))))
     =< VC.act-cancel B B' bc.left (VC.act g (VC.act Al (JA.map (Pk.left x)))) >
        VC.act g (VC.act Al (JA.map (Pk.left x)))
     =< ap (VC.act g) (sym (JA.map-act alpha (Pk.left x))) > VC.act g (JA.map (VAa.act alpha (Pk.left x))) } ;
  forward (x : Pk.Carrier) : Pg.Carrier =
   Pg.point (VAa.act alpha (Pk.left x)) (VAb.act beta' (Pk.right x)) (forward-member x) ;
  backward-member (y : Pg.Carrier) :
   Id VC.Vec (JB.map (VAb.act beta (Pg.right y))) (VC.act k (JA.map (VAa.act alpha' (Pg.left y)))) =
   calc VC.Vec { JB.map (VAb.act beta (Pg.right y))
     =< JB.map-act beta (Pg.right y) > VC.act B (JB.map (Pg.right y))
     =< ap (VC.act B) (Pg.member y) > VC.act B (VC.act g (JA.map (Pg.left y)))
     =< ap (\ t -> VC.act B (VC.act g t)) (sym (VC.act-cancel Al' Al ac.right (JA.map (Pg.left y)))) >
        VC.act B (VC.act g (VC.act Al (VC.act Al' (JA.map (Pg.left y)))))
     =< VC.act-mul B g (VC.act Al (VC.act Al' (JA.map (Pg.left y)))) >
        VC.act (MC.mmul B g) (VC.act Al (VC.act Al' (JA.map (Pg.left y))))
     =< VC.act-mul (MC.mmul B g) Al (VC.act Al' (JA.map (Pg.left y))) >
        VC.act (MC.mmul (MC.mmul B g) Al) (VC.act Al' (JA.map (Pg.left y)))
     =< ap (\ Z -> VC.act Z (VC.act Al' (JA.map (Pg.left y)))) (sym e) > VC.act k (VC.act Al' (JA.map (Pg.left y)))
     =< ap (VC.act k) (sym (JA.map-act alpha' (Pg.left y))) > VC.act k (JA.map (VAa.act alpha' (Pg.left y))) } ;
  backward (y : Pg.Carrier) : Pk.Carrier =
   Pk.point (VAa.act alpha' (Pg.left y)) (VAb.act beta (Pg.right y)) (backward-member y) ;
  iso : MI.Iso[Pk.glued,Pg.glued] = MI.make Pk.glued Pg.glued forward backward
   (\ x y -> Pg.ext _ _ (VAa.act-add alpha (Pk.left x) (Pk.left y)) (VAb.act-add beta' (Pk.right x) (Pk.right y)))
   (\ r x -> Pg.ext _ _ (VAa.act-scale alpha (ia.1 r) (Pk.left x)) (VAb.act-scale beta' (ib.1 r) (Pk.right x)))
   (\ y -> Pg.ext _ _ (VAa.act-cancel alpha' alpha ai.right (Pg.left y)) (VAb.act-cancel beta beta' bi.left (Pg.right y)))
   (\ x -> Pk.ext _ _ (VAa.act-cancel alpha alpha' ai.left (Pk.left x)) (VAb.act-cancel beta' beta bi.right (Pk.right x))) ;
 } ;
} ;
