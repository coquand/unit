-- The localising square of HOMOTOPY for actual localisations: A_x is the
-- localisation of A at the powers of x (MONOIDLOCALIZATION).  If x y = w,
-- then x is invertible in A_w, so A -> A_w extends to j : A_x -> A_w
-- (MONOIDLOCALIZATIONMAP), and j is localising at y:
--  (clear) c = n / w^k in A_w.  Put r = n / x^k.  Both j r and y^k c solve
--          x^k v = n in A_w, and x^k is regular there, so j r = y^k c.
--  (kill)  r = n / s with s a power of x, and j r = 0.  Then n = s r maps
--          to 0, so t n = 0 in A for a power t = w^e.  In A_x,
--          (x^e s) (y^e r) = w^e (s r) = w^e n = 0, and x^e s is a unit,
--          so y^e r = 0.
-- With w = a b this gives A_a -> A_ab localising at b and A_b -> A_ab
-- localising at a, so HOMOTOPY and DIAGONALPRODUCT apply (Instance).
-- With A -> A_a localising at a and A -> A_b at b (Inclusion), so does
-- STABLESUM, GLUEDPROJECTIVE, GLUEDKRONECKER, GLUEDTENSOR, CLASSSUM,
-- CLASSPRODUCT, CLASSKERNEL and CORRECTION.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A : CRing) {
 module PA = AffinePowers[l].Over[A] ;
 Powers (x s : A.R) : U l = (k : Nat) * Id A.R (PA.power x k) s ;
 powers-one (x : A.R) : Powers x A.o = (zero,refl A.o) ;
 powers-product (x s t : A.R) (hs : Powers x s) (ht : Powers x t) : Powers x (A.mul s t) =
  (plus hs.1 ht.1,trans (PA.power-add x hs.1 ht.1) (cong2 A.R A.mul _ _ _ _ hs.2 ht.2)) ;
 power-in (x : A.R) (k : Nat) : Powers x (PA.power x k) = (k,refl (PA.power x k)) ;

 -- A -> A_x is localising at x: n / x^k times x^k is n, and a kernel
 -- element is killed by a power of x (MONOIDLOCALIZATION)
 module Inclusion (x : A.R) {
  module LX = MonoidLocalization[l].Over[A,Powers x,powers-one x,powers-product x] ;
  module LI = Localising[l].Over[A,LX.ring,LX.inclusion,x] ;
  clears (p : LX.Raw.Fraction) : LI.Clears (LX.include p) p.2.2.1 =
   (p.1,sym (trans (ap (\ t -> LX.ring.mul (LX.constant t) (LX.include p)) p.2.2.2) (LX.fraction-equation p))) ;
  clear (c : LX.ring.R) : ExponentBounds[l].Merely (LI.Clears c) =
   TC.map (LX.Representatives c) (ExponentBounds[l].Bound (LI.Clears c))
    (\ rp -> (rp.1.2.2.1,subst (\ t -> LI.Clears t rp.1.2.2.1) rp.2 (clears rp.1)))
    (LX.representatives c) ;
  kill (r : A.R) (h : Id LX.ring.R (LX.inclusion.1 r) LX.ring.z) : ExponentBounds[l].Merely (LI.Kills r) =
   TC.map (LX.Kernel r) (ExponentBounds[l].Bound (LI.Kills r))
    (\ kn -> (kn.2.1.1,trans (ap (\ t -> A.mul t r) kn.2.1.2) kn.2.2)) (LX.kernel r h) ;
  localising : LI.Localising = new LI.Localising[clear,kill] ;
 } ;

 module Step (x y w : A.R) (hw : Id A.R (A.mul x y) w) {
  module LX = MonoidLocalization[l].Over[A,Powers x,powers-one x,powers-product x] ;
  module LW = MonoidLocalization[l].Over[A,Powers w,powers-one w,powers-product w] ;
  -- w^k = x^k y^k
  power-w (k : Nat) : Id A.R (PA.power w k) (A.mul (PA.power x k) (PA.power y k)) =
   trans (ap (\ t -> PA.power t k) (sym hw)) (PA.power-mul x y k) ;
  -- x^k is a unit of A_w, with inverse y^k / w^k
  unit-power (k : Nat) : RL[LW.ring].unit (LW.constant (PA.power x k)) =
   (LW.ring.mul (LW.constant (PA.power y k)) (LW.inverse (PA.power w k) (power-in w k)).1,
    calc LW.ring.R { LW.ring.mul (LW.constant (PA.power x k)) (LW.ring.mul (LW.constant (PA.power y k)) (LW.inverse (PA.power w k) (power-in w k)).1)
      =< LW.ring.mulA (LW.constant (PA.power x k)) (LW.constant (PA.power y k)) (LW.inverse (PA.power w k) (power-in w k)).1 >
         LW.ring.mul (LW.ring.mul (LW.constant (PA.power x k)) (LW.constant (PA.power y k))) (LW.inverse (PA.power w k) (power-in w k)).1
      =< ap (\ t -> LW.ring.mul t (LW.inverse (PA.power w k) (power-in w k)).1)
          (trans (sym (LW.constant-mul (PA.power x k) (PA.power y k))) (ap LW.constant (sym (power-w k)))) >
         LW.ring.mul (LW.constant (PA.power w k)) (LW.inverse (PA.power w k) (power-in w k)).1
      =< (LW.inverse (PA.power w k) (power-in w k)).2 > LW.ring.o }) ;
  units (s : A.R) (hs : Powers x s) : RL[LW.ring].unit (LW.constant s) =
   subst (\ t -> RL[LW.ring].unit (LW.constant t)) hs.2 (unit-power hs.1) ;
  module J = MonoidLocalizationMap[l].Over[A,Powers x,powers-one x,powers-product x,LW.ring,LW.set,LW.inclusion,units] ;
  j : RingHom[l].Hom LX.ring LW.ring = J.hom ;
  constants (r : A.R) : Id LW.ring.R (j.1 (LX.constant r)) (LW.constant r) = J.constants r ;
  module LB = Localising[l].Over[LX.ring,LW.ring,j,LX.constant y] ;
  -- the powers of y in A_x, and their images
  pow-constant (k : Nat) : Id LX.ring.R (LB.pow k) (LX.constant (PA.power y k)) =
   sym (AffinePowers[l].power-map A LX.ring LX.inclusion y k) ;
  image-pow (k : Nat) : Id LW.ring.R (j.1 (LB.pow k)) (LW.constant (PA.power y k)) =
   trans (ap j.1 (pow-constant k)) (constants (PA.power y k)) ;
  -- multiplication by x^k is injective on A_w
  cancel (k : Nat) : Regularity[l].Over[LW.ring].Regular (LW.constant (PA.power x k)) =
   J.cancel (PA.power x k) (power-in x k) ;

  -- (clear)
  module Clear (p : LW.Raw.Fraction) (k : Nat) (hk : Id A.R (PA.power w k) p.2.1) {
   q : LX.Raw.Fraction = (p.1,PA.power x k,power-in x k) ;
   r : LX.ring.R = LX.include q ;
   c : LW.ring.R = LW.include p ;
   -- x^k (j r) = n
   solves-r : Id LW.ring.R (LW.ring.mul (LW.constant (PA.power x k)) (j.1 r)) (LW.constant p.1) =
    trans (ap (LW.ring.mul (LW.constant (PA.power x k))) (J.D.beta q)) (J.equation q) ;
   -- x^k (y^k c) = w^k c = n
   solves-c : Id LW.ring.R (LW.ring.mul (LW.constant (PA.power x k)) (LW.ring.mul (LW.constant (PA.power y k)) c)) (LW.constant p.1) =
    calc LW.ring.R { LW.ring.mul (LW.constant (PA.power x k)) (LW.ring.mul (LW.constant (PA.power y k)) c)
      =< LW.ring.mulA (LW.constant (PA.power x k)) (LW.constant (PA.power y k)) c >
         LW.ring.mul (LW.ring.mul (LW.constant (PA.power x k)) (LW.constant (PA.power y k))) c
      =< ap (\ t -> LW.ring.mul t c) (sym (LW.constant-mul (PA.power x k) (PA.power y k))) >
         LW.ring.mul (LW.constant (A.mul (PA.power x k) (PA.power y k))) c
      =< ap (\ t -> LW.ring.mul (LW.constant t) c) (trans (sym (power-w k)) hk) > LW.ring.mul (LW.constant p.2.1) c
      =< LW.fraction-equation p > LW.constant p.1 } ;
   clears : LB.Clears c k =
    (r,trans (cancel k (j.1 r) (LW.ring.mul (LW.constant (PA.power y k)) c) (trans solves-r (sym solves-c)))
       (ap (\ t -> LW.ring.mul t c) (sym (image-pow k)))) ;
  } ;
  clear (c : LW.ring.R) : ExponentBounds[l].Merely (LB.Clears c) =
   TC.map (LW.Representatives c) (ExponentBounds[l].Bound (LB.Clears c))
    (\ rp -> (rp.1.2.2.1,subst (\ t -> LB.Clears t rp.1.2.2.1) rp.2 (Clear[rp.1,rp.1.2.2.1,rp.1.2.2.2].clears)))
    (LW.representatives c) ;

  -- (kill)  j (n / s) = 0 gives n = 0 in A_w
  numerator-zero (p : LX.Raw.Fraction) (h : Id LW.ring.R (j.1 (LX.include p)) LW.ring.z) : Id LW.ring.R (LW.constant p.1) LW.ring.z =
   calc LW.ring.R { LW.constant p.1
     =< sym (constants p.1) > j.1 (LX.constant p.1)
     =< ap j.1 (sym (LX.fraction-equation p)) > j.1 (LX.ring.mul (LX.constant p.2.1) (LX.include p))
     =< j.2.2.2 (LX.constant p.2.1) (LX.include p) > LW.ring.mul (j.1 (LX.constant p.2.1)) (j.1 (LX.include p))
     =< ap (LW.ring.mul (j.1 (LX.constant p.2.1))) h > LW.ring.mul (j.1 (LX.constant p.2.1)) LW.ring.z
     =< RL[LW.ring].mul-zero (j.1 (LX.constant p.2.1)) > LW.ring.z } ;
  module Kill (p : LX.Raw.Fraction) (t : A.R) (e : Nat) (he : Id A.R (PA.power w e) t) (tn : Id A.R (A.mul t p.1) A.z) {
   s : A.R = p.2.1 ;
   r : LX.ring.R = LX.include p ;
   u : A.R = A.mul (PA.power x e) s ;
   u-power : Powers x u = powers-product x (PA.power x e) s (power-in x e) p.2.2 ;
   -- (x^e s) y^e = w^e s = t s
   reorder : Id A.R (A.mul u (PA.power y e)) (A.mul t s) =
    calc A.R { A.mul u (PA.power y e)
      =< sym (A.mulA (PA.power x e) s (PA.power y e)) > A.mul (PA.power x e) (A.mul s (PA.power y e))
      =< ap (A.mul (PA.power x e)) (A.mulC s (PA.power y e)) > A.mul (PA.power x e) (A.mul (PA.power y e) s)
      =< A.mulA (PA.power x e) (PA.power y e) s > A.mul (A.mul (PA.power x e) (PA.power y e)) s
      =< ap (\ v -> A.mul v s) (trans (sym (power-w e)) he) > A.mul t s } ;
   -- u (y^e r) = t (s r) = t n = 0 in A_x
   product-zero : Id LX.ring.R (LX.ring.mul (LX.constant u) (LX.ring.mul (LX.constant (PA.power y e)) r)) LX.ring.z =
    calc LX.ring.R { LX.ring.mul (LX.constant u) (LX.ring.mul (LX.constant (PA.power y e)) r)
      =< LX.ring.mulA (LX.constant u) (LX.constant (PA.power y e)) r > LX.ring.mul (LX.ring.mul (LX.constant u) (LX.constant (PA.power y e))) r
      =< ap (\ v -> LX.ring.mul v r) (sym (LX.constant-mul u (PA.power y e))) > LX.ring.mul (LX.constant (A.mul u (PA.power y e))) r
      =< ap (\ v -> LX.ring.mul (LX.constant v) r) reorder > LX.ring.mul (LX.constant (A.mul t s)) r
      =< ap (\ v -> LX.ring.mul v r) (LX.constant-mul t s) > LX.ring.mul (LX.ring.mul (LX.constant t) (LX.constant s)) r
      =< sym (LX.ring.mulA (LX.constant t) (LX.constant s) r) > LX.ring.mul (LX.constant t) (LX.ring.mul (LX.constant s) r)
      =< ap (LX.ring.mul (LX.constant t)) (LX.fraction-equation p) > LX.ring.mul (LX.constant t) (LX.constant p.1)
      =< sym (LX.constant-mul t p.1) > LX.constant (A.mul t p.1)
      =< ap LX.constant tn > LX.ring.z } ;
   kills : LB.Kills r e =
    trans (ap (\ v -> LX.ring.mul v r) (pow-constant e))
     (RL[LX.ring].unit-reg (LX.constant u) (LX.ring.mul (LX.constant (PA.power y e)) r) (LX.inverse u u-power) product-zero) ;
  } ;
  kill (r : LX.ring.R) (h : Id LW.ring.R (j.1 r) LW.ring.z) : ExponentBounds[l].Merely (LB.Kills r) =
   TC.bind (LX.Representatives r) (ExponentBounds[l].Bound (LB.Kills r))
    (\ rp -> TC.map (LW.Kernel rp.1.1) (ExponentBounds[l].Bound (LB.Kills r))
     (\ kn -> (kn.2.1.1,subst (\ v -> LB.Kills v kn.2.1.1) rp.2 (Kill[rp.1,kn.1,kn.2.1.1,kn.2.1.2,kn.2.2].kills)))
     (LW.kernel rp.1.1 (numerator-zero rp.1 (trans (ap j.1 rp.2) h))))
    (LX.representatives r) ;
  localising : LB.Localising = new LB.Localising[clear,kill] ;
 } ;

 -- A_a -> A_ab <- A_b
 module Instance (setA : Pr.isSet A.R) (a b : A.R)
  (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier) {
  module Sa = Step[a,b,A.mul a b,refl (A.mul a b)] ;
  module Sb = Step[b,a,A.mul a b,A.mulC b a] ;
  module Aa = Sa.LX ;
  module Ab = Sb.LX ;
  module C = Sa.LW ;
  square (r : A.R) : Id C.ring.R (Sa.j.1 (Aa.constant r)) (Sb.j.1 (Ab.constant r)) =
   trans (Sa.constants r) (sym (Sb.constants r)) ;
  -- Lemma 3.5 and Lemma 3.6(1) (matrix level) for A_a, A_b, A_ab
  module HomotopyAt (N : Nat) { module P = Homotopy[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Sa.localising,Sb.localising,comaximal,N] ;
   theorem (g g' : P.MC.Mat) (gi : P.IC.Inverse[g,g']) (eps eps' : P.MCT.Mat) (ei : P.ICT.Inverse[eps,eps'])
    (eu : P.LA.Unit eps) : Tr.Trunc[P.Lemma[g,g',gi,eps,eps',ei,eu].Result].carrier =
    P.Lemma[g,g',gi,eps,eps',ei,eu].theorem ;
  } ;
  module DiagonalAt (M : Nat) { module P = DiagonalProduct[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Sa.localising,Sb.localising,comaximal,M] ;
   theorem (g g' : P.MC.Mat) (gi : P.IM.Inverse[g,g']) (h h' : P.MC.Mat) (hi : P.IM.Inverse[h,h']) :
    Tr.Trunc[P.Lemma[g,g',gi,h,h',hi].Result].carrier = P.Lemma[g,g',gi,h,h',hi].theorem ;
  } ;
  -- Lemma 3.6(1) (module level): P_g + P_h ~ P_gh + A^M
  module StableAt (M : Nat) { module P = StableSum[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Inclusion[a].localising,Inclusion[b].localising,
   Sa.localising,Sb.localising,comaximal,M] ;
   theorem (g g' : P.D.MC.Mat) (gi : P.D.IM.Inverse[g,g']) (h h' : P.D.MC.Mat) (hi : P.D.IM.Inverse[h,h']) :
    Tr.Trunc[P.MI.Iso[P.Lemma[g,g',gi,h,h',hi].Source,P.Lemma[g,g',gi,h,h',hi].Target]].carrier =
    P.Lemma[g,g',gi,h,h',hi].theorem ;
  } ;
  -- glued modules are finite projective
  module ProjectiveAt (M : Nat) { module P = GluedProjective[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Inclusion[a].localising,Inclusion[b].localising,
   Sa.localising,Sb.localising,comaximal,M] ;
   theorem (g g' : P.MC.Mat) (gi : P.SS.D.IM.Inverse[g,g']) : P.FM.FiniteProjective P.G1.Glue[g].glued =
    P.Projective[g,g',gi].theorem ;
  } ;
  -- Lemma 3.6(2) (module level): P_g^m + P_h^n ~ P_{g (x) h} + A^(mn)
  module KroneckerAt (m n : Nat) { module P = GluedKronecker[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Inclusion[a].localising,Inclusion[b].localising,
   Sa.localising,Sb.localising,comaximal,m,n] ;
   theorem (g g' : P.KC.Mn.Mat) (gi : P.KC.In.Inverse[g,g']) (h h' : P.KC.Mm.Mat) (hi : P.KC.Im.Inverse[h,h']) :
    Tr.Trunc[P.MI.Iso[P.Lemma[g,g',gi,h,h',hi].Copies,P.Lemma[g,g',gi,h,h',hi].Target]].carrier =
    P.Lemma[g,g',gi,h,h',hi].theorem ;
  } ;
  -- the bridge in K_0(A): [P_h][P_g] = [P_{h (x) g}]
  module BridgeAt (m n : Nat) { module P = GluedTensor[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Inclusion[a].localising,Inclusion[b].localising,
   Sa.localising,Sb.localising,comaximal,m,n] ;
   theorem (g g' : P.G1.MC.Mat) (gi : P.GP.DP.IM.Inverse[g,g']) (h : P.Gm.MC.Mat) (p q s : P.K.Projector)
    (ep : P.MI.Iso[P.K.image p,P.Gm.Glue[h].glued]) (eq : P.MI.Iso[P.K.image q,P.G1.Glue[g].glued])
    (es : P.MI.Iso[P.K.image s,P.GN.Glue[P.KC.kron h g].glued]) :
    Id P.K.K0.R (P.K.K0.mul (P.K.class p) (P.K.class q)) (P.K.class s) = P.Bridge[g,g',gi,h,p,q,s,ep,eq,es].theorem ;
  } ;
  -- Lemma 3.6(1) in K_0(A): [P_g] + [P_h] = [P_gh] + M
  module ClassSumAt (M : Nat) { module P = ClassSum[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Inclusion[a].localising,Inclusion[b].localising,
   Sa.localising,Sb.localising,comaximal,M] ;
   theorem (g g' : P.MC.Mat) (gi : P.IM.Inverse[g,g']) (h h' : P.MC.Mat) (hi : P.IM.Inverse[h,h'])
    (p q s : P.K.Projector) (ep : P.MI.Iso[P.K.image p,P.G1.Glue[g].glued]) (eq : P.MI.Iso[P.K.image q,P.G1.Glue[h].glued])
    (es : P.MI.Iso[P.K.image s,P.G1.Glue[P.MC.mmul g h].glued]) :
    Id P.K.K0.R (P.K.K0.add (P.K.class p) (P.K.class q)) (P.K.K0.add (P.K.class s) (P.K.free M)) =
    P.Lemma[g,g',gi,h,h',hi,p,q,s,ep,eq,es].theorem ;
  } ;
  -- Lemma 3.6(2) in K_0(A): ([P_h] - m)([P_g] - n) = 0
  module ClassProductAt (m n : Nat) { module P = ClassProduct[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Inclusion[a].localising,Inclusion[b].localising,
   Sa.localising,Sb.localising,comaximal,m,n] ;
   theorem (g g' : P.KC.Mn.Mat) (gi : P.KC.In.Inverse[g,g']) (h h' : P.KC.Mm.Mat) (hi : P.KC.Im.Inverse[h,h'])
    (p q : P.K.Projector) (ep : P.MI.Iso[P.K.image p,P.T.Gm.Glue[h].glued]) (eq : P.MI.Iso[P.K.image q,P.T.G1.Glue[g].glued]) :
    P.Lemma[g,g',gi,h,h',hi,p,q,ep,eq].Statement = P.Lemma[g,g',gi,h,h',hi,p,q,ep,eq].theorem ;
  } ;
  -- Lemma 3.6(3) in K_0(A): if [p] = [q] in K_0(A_a) and in K_0(A_b), then
  -- [p] - [q] = [P_g] - L for some invertible g over A_ab (merely)
  module KernelAt { module P = ClassKernel[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Inclusion[a].localising,Inclusion[b].localising,
   Sa.localising,Sb.localising,comaximal] ;
   theorem (p q : P.PJ.Projector)
    (ha : Id P.MA.KB.K0.R (P.MA.KB.class (P.MA.map p)) (P.MA.KB.class (P.MA.map q)))
    (hb : Id P.MB.KB.K0.R (P.MB.KB.class (P.MB.map p)) (P.MB.KB.class (P.MB.map q))) :
    Tr.Trunc[P.Lemma[p,q,ha,hb].Witness].carrier = P.Lemma[p,q,ha,hb].theorem ;
   -- the same for x in K_0(A) restricting to 0 on both sides: x = [P_g] - L
   kernel (x : P.K.K0.R)
    (ha : Id P.RA.KB.K0.R (P.RA.restrict.1 x) P.RA.KB.K0.z) (hb : Id P.RB.KB.K0.R (P.RB.restrict.1 x) P.RB.KB.K0.z) :
    Tr.Trunc[P.Kernel[x,ha,hb].Witness].carrier = P.Kernel[x,ha,hb].theorem ;
  } ;
  -- Proposition `correct`, K-theoretic core: rho(f) rho(S)^n = 1 in K_0(A) (x) Q
  module CorrectionAt { module P = Correction[l].Over[A,Aa.ring,Ab.ring,C.ring,setA,Aa.set,Ab.set,C.set,
   Aa.inclusion,Ab.inclusion,Sa.j,Sb.j,square,a,b,Inclusion[a].localising,Inclusion[b].localising,
   Sa.localising,Sb.localising,comaximal] ;
   theorem (f : P.PJ.Projector) (N0 kappa0 n0 : Nat)
    (ha : Id P.CK.RA.KB.K0.R (P.CK.RA.restrict.1 (P.K.K0.mul (P.IK.nat (suc kappa0)) (P.K.K0.add (P.K.class f) (P.K.K0.neg (P.IK.nat (suc N0))))))
      P.CK.RA.KB.K0.z)
    (hb : Id P.CK.RB.KB.K0.R (P.CK.RB.restrict.1 (P.K.K0.mul (P.IK.nat (suc kappa0)) (P.K.K0.add (P.K.class f) (P.K.K0.neg (P.IK.nat (suc N0))))))
      P.CK.RB.KB.K0.z) :
