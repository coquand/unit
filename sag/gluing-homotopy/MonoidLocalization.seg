-- The effective quotient ring at an arbitrary multiplicative monoid.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (S : A.R -> U l) (one : S A.o)
 (product : (s t : A.R) -> S s -> S t -> S (A.mul s t)) {
 open A ;
 module Raw = MonoidFractions[l].Over[A,S,one,product] ; open Raw ;
 module Q = Quotient[l].Quot[Fraction,Relation,proposition,reflexive,symmetric,transitive] ;
 Carrier : U l = Q.Q ;
 include : Fraction -> Carrier = Q.inc ;
 set : Pr.isSet Carrier = Q.set ;
 module Binary (op : Fraction -> Fraction -> Fraction)
   (cong : (p p' q q' : Fraction) -> Relation p p' -> Relation q q' -> Relation (op p q) (op p' q')) {
  module Right (p : Fraction) {
   module D = Q.Descend[Carrier,set,\ q -> include (op p q),\ q q' h -> Q.relates _ _ (cong p p q q' (Raw.reflexive p) h)] ;
  } ;
  left-respects (p p' : Fraction) (h : Relation p p') : Id (Carrier -> Carrier) Right[p].D.map Right[p'].D.map =
   F.funext Carrier (\ q -> Carrier) _ _
    (Q.induction @l (\ q -> Id Carrier (Right[p].D.map q) (Right[p'].D.map q)) (\ q -> set _ _)
     (\ q -> trans (Right[p].D.beta q)
       (trans (Q.relates _ _ (cong p p' q q h (Raw.reflexive q))) (sym (Right[p'].D.beta q))))) ;
  module Left = Q.Descend[Carrier -> Carrier,F.isSet-Pi Carrier (\ q -> Carrier) (\ q -> set),
    \ p -> Right[p].D.map,left-respects] ;
  operation : Carrier -> Carrier -> Carrier = Left.map ;
  beta (p q : Fraction) : Id Carrier (operation (include p) (include q)) (include (op p q)) =
   trans (Pr.happly Carrier (\ q -> Carrier) _ _ (Left.beta p) (include q)) (Right[p].D.beta q) ;
 } ;
 module Add = Binary[addF,Raw.Binary[addF,add-witness].respects] ;
 module Multiply = Binary[mulF,Raw.Binary[mulF,mul-witness].respects] ;
 module Negate = Q.Descend[Carrier,set,\ p -> include (negF p),\ p q h -> Q.relates _ _ (Raw.neg-respects p q h)] ;
 addQ : Carrier -> Carrier -> Carrier = Add.operation ;
 mulQ : Carrier -> Carrier -> Carrier = Multiply.operation ;
 negQ : Carrier -> Carrier = Negate.map ;
 zeroQ : Carrier = include (constantF z) ;
 oneQ : Carrier = include (constantF o) ;

 forall2 (B : Carrier -> Carrier -> U l) (prop : (x y : Carrier) -> Pr.isProp (B x y))
   (b : (p q : Fraction) -> B (include p) (include q)) : (x y : Carrier) -> B x y =
   Q.induction @l (\ x -> (y : Carrier) -> B x y)
    (\ x -> F.isProp-Pi Carrier (B x) (prop x))
    (\ p -> Q.induction @l (B (include p)) (prop (include p)) (b p)) ;
 forall3 (B : Carrier -> Carrier -> Carrier -> U l) (prop : (x y z : Carrier) -> Pr.isProp (B x y z))
   (b : (p q r : Fraction) -> B (include p) (include q) (include r)) : (x y z : Carrier) -> B x y z =
   forall2 (\ x y -> (z : Carrier) -> B x y z)
    (\ x y -> F.isProp-Pi Carrier (B x y) (prop x y))
    (\ p q -> Q.induction @l (B (include p) (include q)) (prop (include p) (include q)) (b p q)) ;

 -- A small internal syntax packages the repeated beta-rule rewrites.
 data Expr : U l = atom (p : Fraction) | sumE (a b : Expr) | mulE (a b : Expr) | negE (a : Expr) ;
 raw : Expr -> Fraction = split {
   atom p -> p ; sumE a b | ar br -> addF ar br ;
   mulE a b | ar br -> mulF ar br ; negE a | ar -> negF ar } ;
 value : Expr -> Carrier = split {
   atom p -> include p ; sumE a b | av bv -> addQ av bv ;
   mulE a b | av bv -> mulQ av bv ; negE a | av -> negQ av } ;
 sound : (e : Expr) -> Id Carrier (value e) (include (raw e)) = split {
   atom p -> refl (include p) ;
   sumE a b | ah bh -> trans (ap (\ x -> addQ x (value b)) ah)
    (trans (ap (addQ (include (raw a))) bh) (Add.beta (raw a) (raw b))) ;
   mulE a b | ah bh -> trans (ap (\ x -> mulQ x (value b)) ah)
    (trans (ap (mulQ (include (raw a))) bh) (Multiply.beta (raw a) (raw b))) ;
   negE a | ah -> trans (ap negQ ah) (Negate.beta (raw a)) } ;
 lift (e e' : Expr) (h : Relation (raw e) (raw e')) : Id Carrier (value e) (value e') =
   trans (sound e) (trans (Q.relates _ _ h) (sym (sound e'))) ;
 add-assoc : (x y z : Carrier) -> Id Carrier (addQ x (addQ y z)) (addQ (addQ x y) z) =
   forall3 (\ x y z -> Id Carrier (addQ x (addQ y z)) (addQ (addQ x y) z)) (\ x y z -> set _ _)
    (\ p q r -> lift (sumE (atom p) (sumE (atom q) (atom r)))
      (sumE (sumE (atom p) (atom q)) (atom r)) (Raw.add-assoc p q r)) ;
 add-comm : (x y : Carrier) -> Id Carrier (addQ x y) (addQ y x) =
   forall2 (\ x y -> Id Carrier (addQ x y) (addQ y x)) (\ x y -> set _ _)
    (\ p q -> lift (sumE (atom p) (atom q)) (sumE (atom q) (atom p)) (Raw.add-comm p q)) ;
 add-zero : (x : Carrier) -> Id Carrier (addQ x zeroQ) x =
   Q.induction @l (\ x -> Id Carrier (addQ x zeroQ) x) (\ x -> set _ _)
    (\ p -> lift (sumE (atom p) (atom (constantF z))) (atom p) (Raw.add-zero p)) ;
 add-neg : (x : Carrier) -> Id Carrier (addQ x (negQ x)) zeroQ =
   Q.induction @l (\ x -> Id Carrier (addQ x (negQ x)) zeroQ) (\ x -> set _ _)
    (\ p -> lift (sumE (atom p) (negE (atom p))) (atom (constantF z)) (Raw.add-neg p)) ;
 mul-assoc : (x y z : Carrier) -> Id Carrier (mulQ x (mulQ y z)) (mulQ (mulQ x y) z) =
   forall3 (\ x y z -> Id Carrier (mulQ x (mulQ y z)) (mulQ (mulQ x y) z)) (\ x y z -> set _ _)
    (\ p q r -> lift (mulE (atom p) (mulE (atom q) (atom r)))
      (mulE (mulE (atom p) (atom q)) (atom r)) (Raw.mul-assoc p q r)) ;
 mul-comm : (x y : Carrier) -> Id Carrier (mulQ x y) (mulQ y x) =
   forall2 (\ x y -> Id Carrier (mulQ x y) (mulQ y x)) (\ x y -> set _ _)
    (\ p q -> lift (mulE (atom p) (atom q)) (mulE (atom q) (atom p)) (Raw.mul-comm p q)) ;
 mul-one : (x : Carrier) -> Id Carrier (mulQ x oneQ) x =
   Q.induction @l (\ x -> Id Carrier (mulQ x oneQ) x) (\ x -> set _ _)
    (\ p -> lift (mulE (atom p) (atom (constantF o))) (atom p) (Raw.mul-one p)) ;
 distributive : (x y z : Carrier) -> Id Carrier (mulQ x (addQ y z)) (addQ (mulQ x y) (mulQ x z)) =
   forall3 (\ x y z -> Id Carrier (mulQ x (addQ y z)) (addQ (mulQ x y) (mulQ x z))) (\ x y z -> set _ _)
    (\ p q r -> lift (mulE (atom p) (sumE (atom q) (atom r)))
      (sumE (mulE (atom p) (atom q)) (mulE (atom p) (atom r))) (Raw.distributive p q r)) ;
 ring : CRing = mkCRing Carrier zeroQ oneQ addQ mulQ negQ
   add-assoc add-comm add-zero add-neg mul-assoc mul-comm mul-one distributive ;
 constant (a : R) : Carrier = include (constantF a) ;
 constant-add (a b : R) : Id Carrier (constant (add a b)) (addQ (constant a) (constant b)) =
  trans (Q.relates (constantF (add a b)) (addF (constantF a) (constantF b)) (Raw.constant-add a b))
   (sym (Add.beta (constantF a) (constantF b))) ;
 constant-mul (a b : R) : Id Carrier (constant (mul a b)) (mulQ (constant a) (constant b)) =
  trans (Q.relates (constantF (mul a b)) (mulF (constantF a) (constantF b)) (Raw.constant-mul a b))
   (sym (Multiply.beta (constantF a) (constantF b))) ;
 inclusion : RingHom[l].Hom A ring = (constant,refl oneQ,constant-add,constant-mul) ;
 inverse (s : R) (hs : S s) : RL[ring].unit (constant s) =
  (include (o,s,hs),
   trans (Multiply.beta (constantF s) (o,s,hs))
    (Q.relates (mulF (constantF s) (o,s,hs)) (constantF o) (Raw.inverse s hs))) ;
 fraction-equation (q : Fraction) :
  Id Carrier (mulQ (constant q.2.1) (include q)) (constant q.1) =
  trans (Multiply.beta (constantF q.2.1) q)
   (Q.relates (mulF (constantF q.2.1) q) (constantF q.1)
    (Raw.exact (mulF (constantF q.2.1) q) (constantF q.1)
     (trans (mulO (mul q.2.1 q.1))
      (trans (mulC q.2.1 q.1)
       (ap (mul q.1) (sym (AffinePowers[l].Over[A].one-left q.2.1))))))) ;
 module Tr = Truncation[l] ;
 Representatives (q : Carrier) : U l = (p : Fraction) * Id Carrier (include p) q ;
 representatives (q : Carrier) : Tr.Trunc[Representatives q].carrier =
  Q.induction @l (\ q -> Tr.Trunc[Representatives q].carrier)
   (\ q -> Tr.Trunc[Representatives q].proposition)
   (\ p -> Tr.Trunc[Representatives (include p)].inc (p,refl (include p))) q ;
 Kernel (a : R) : U l = (s : R) * S s * Id R (mul s a) z ;
 kernel-witness (a : R) (w : Raw.Witness (constantF a) (constantF z)) : Kernel a =
  (w.1,w.2.1,
   trans (ap (mul w.1) (sym (mulO a)))
    (trans w.2.2 (trans (ap (mul w.1) (mulO z)) (RL[A].mul-zero w.1)))) ;
 kernel (a : R) (eq : Id Carrier (constant a) zeroQ) : Tr.Trunc[Kernel a].carrier =
  Tr.Trunc[Raw.Witness (constantF a) (constantF z)].induction @l
   (\ w -> Tr.Trunc[Kernel a].carrier) (\ w -> Tr.Trunc[Kernel a].proposition)
   (\ w -> Tr.Trunc[Kernel a].inc (kernel-witness a w))
   (Q.effective (constantF a) (constantF z) eq) ;
} ;
