-- Conjugation by an inverse pair (h, h'):  conj P = h P h'.  With h' h = 1,
--   conj P conj Q = conj (P Q),     conj P h = h P,
-- and conj 1 = 1 with h h' = 1.  Two more rearrangements used in the
-- homotopy lemma:
--   (P Q')(Q P') = 1          when P P' = 1 and Q' Q = 1        (sandwich)
--   (conj P conj Q') h Q = h P  when h' h = 1 and Q' Q = 1        (final)
-- A ring map commutes with conjugation (map-conj).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (N : Nat) {
 module M = MnAlgebra[l].Over[R,setR,N] ;
 conj (h h' P : M.Mat) : M.Mat = M.mmul h (M.mmul P h') ;
 -- X (h' h) Y = X Y
 cancel-middle (h h' X Y : M.Mat) (left : Id M.Mat (M.mmul h' h) M.mone) :
  Id M.Mat (M.mmul (M.mmul X h') (M.mmul h Y)) (M.mmul X Y) =
  calc M.Mat { M.mmul (M.mmul X h') (M.mmul h Y)
    =< sym (M.m-mulA X h' (M.mmul h Y)) > M.mmul X (M.mmul h' (M.mmul h Y))
    =< ap (M.mmul X) (M.m-mulA h' h Y) > M.mmul X (M.mmul (M.mmul h' h) Y)
    =< ap (\ t -> M.mmul X (M.mmul t Y)) left > M.mmul X (M.mmul M.mone Y)
    =< ap (M.mmul X) (M.m-one-left Y) > M.mmul X Y } ;
 conj-mul (h h' : M.Mat) (left : Id M.Mat (M.mmul h' h) M.mone) (P Q : M.Mat) :
  Id M.Mat (M.mmul (conj h h' P) (conj h h' Q)) (conj h h' (M.mmul P Q)) =
  calc M.Mat { M.mmul (conj h h' P) (conj h h' Q)
    =< ap (\ t -> M.mmul t (conj h h' Q)) (M.m-mulA h P h') > M.mmul (M.mmul (M.mmul h P) h') (conj h h' Q)
    =< cancel-middle h h' (M.mmul h P) (M.mmul Q h') left > M.mmul (M.mmul h P) (M.mmul Q h')
    =< sym (M.m-mulA h P (M.mmul Q h')) > M.mmul h (M.mmul P (M.mmul Q h'))
    =< ap (M.mmul h) (M.m-mulA P Q h') > conj h h' (M.mmul P Q) } ;
 conj-one (h h' : M.Mat) (right : Id M.Mat (M.mmul h h') M.mone) : Id M.Mat (conj h h' M.mone) M.mone =
  trans (ap (M.mmul h) (M.m-one-left h')) right ;
 conj-right (h h' : M.Mat) (left : Id M.Mat (M.mmul h' h) M.mone) (P : M.Mat) :
  Id M.Mat (M.mmul (conj h h' P) h) (M.mmul h P) =
  calc M.Mat { M.mmul (conj h h' P) h
    =< ap (\ t -> M.mmul t h) (M.m-mulA h P h') > M.mmul (M.mmul (M.mmul h P) h') h
    =< sym (M.m-mulA (M.mmul h P) h' h) > M.mmul (M.mmul h P) (M.mmul h' h)
    =< ap (M.mmul (M.mmul h P)) left > M.mmul (M.mmul h P) M.mone
    =< M.m-one-right (M.mmul h P) > M.mmul h P } ;
 sandwich (P P' Q Q' : M.Mat) (pp : Id M.Mat (M.mmul P P') M.mone) (qq : Id M.Mat (M.mmul Q' Q) M.mone) :
  Id M.Mat (M.mmul (M.mmul P Q') (M.mmul Q P')) M.mone =
  trans (cancel-middle Q Q' P P' qq) pp ;
 final (h h' P Q Q' : M.Mat) (left : Id M.Mat (M.mmul h' h) M.mone) (qq : Id M.Mat (M.mmul Q' Q) M.mone) :
  Id M.Mat (M.mmul (M.mmul (M.mmul (conj h h' P) (conj h h' Q')) h) Q) (M.mmul h P) =
  calc M.Mat { M.mmul (M.mmul (M.mmul (conj h h' P) (conj h h' Q')) h) Q
    =< ap (\ t -> M.mmul (M.mmul t h) Q) (conj-mul h h' left P Q') >
       M.mmul (M.mmul (conj h h' (M.mmul P Q')) h) Q
    =< ap (\ t -> M.mmul t Q) (conj-right h h' left (M.mmul P Q')) > M.mmul (M.mmul h (M.mmul P Q')) Q
    =< sym (M.m-mulA h (M.mmul P Q') Q) > M.mmul h (M.mmul (M.mmul P Q') Q)
    =< ap (M.mmul h) (sym (M.m-mulA P Q' Q)) > M.mmul h (M.mmul P (M.mmul Q' Q))
    =< ap (\ t -> M.mmul h (M.mmul P t)) qq > M.mmul h (M.mmul P M.mone)
    =< ap (M.mmul h) (M.m-one-right P) > M.mmul h P } ;
} ;
module Map (X Y : CRing) (setX : Pr.isSet X.R) (setY : Pr.isSet Y.R) (f : H.Hom X Y) (N : Nat) {
 module CX = Over[X,setX,N] ;
 module CY = Over[Y,setY,N] ;
 module MM = MatrixMap[l].Over[X,Y,setX,setY,f,N] ;
 map-conj (h h' P : CX.M.Mat) :
  Id CY.M.Mat (MM.map (CX.conj h h' P)) (CY.conj (MM.map h) (MM.map h') (MM.map P)) =
  trans (MM.map-mul h (CX.M.mmul P h')) (ap (CY.M.mmul (MM.map h)) (MM.map-mul P h')) ;
} ;
