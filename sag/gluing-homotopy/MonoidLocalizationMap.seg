-- Maps from a monoid localization to any ring inverting its monoid.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (S : A.R -> U l) (one : S A.o)
 (product : (s t : A.R) -> S s -> S t -> S (A.mul s t))
 (C : CRing) (setC : Prelude[l].isSet C.R) (phi : RingHom[l].Hom A C)
 (units : (s : A.R) -> S s -> RL[C].unit (phi.1 s)) {
 open C ; open RL[C] ;
 module B = MonoidLocalization[l].Over[A,S,one,product] ;
 module Reg = Regularity[l].Over[C] ;
 module CU = AffineRing[l].Laws[C,setC] ;
 module Tr = Truncation[l] ;
 cancel (s : A.R) (hs : S s) : Reg.Regular (phi.1 s) =
  Reg.from-kernel (phi.1 s) (\ a h -> unit-reg (phi.1 s) a (units s hs) h) ;
 evaluate (q : B.Raw.Fraction) : R = mul (phi.1 q.1) (units q.2.1 q.2.2).1 ;
 equation (q : B.Raw.Fraction) : Id R (mul (phi.1 q.2.1) (evaluate q)) (phi.1 q.1) =
  trans (mul-swap (phi.1 q.2.1) (phi.1 q.1) (units q.2.1 q.2.2).1)
   (trans (ap (mul (phi.1 q.1)) (units q.2.1 q.2.2).2) (mulO (phi.1 q.1))) ;
 unique (q : B.Raw.Fraction) (b : R) (h : Id R (mul (phi.1 q.2.1) b) (phi.1 q.1)) :
  Id R (evaluate q) b =
  cancel q.2.1 q.2.2 (evaluate q) b (trans (equation q) (sym h)) ;
 triple (u a s : A.R) : Id R (phi.1 (A.mul u (A.mul a s))) (mul (phi.1 u) (mul (phi.1 a) (phi.1 s))) =
  trans (phi.2.2.2 u (A.mul a s)) (ap (mul (phi.1 u)) (phi.2.2.2 a s)) ;
 module Related (x y : B.Raw.Fraction) (w : B.Raw.Witness x y) {
  cross : Id R (mul (phi.1 x.1) (phi.1 y.2.1)) (mul (phi.1 y.1) (phi.1 x.2.1)) =
   cancel w.1 w.2.1 _ _
    (trans (sym (triple w.1 x.1 y.2.1))
     (trans (ap phi.1 w.2.2) (triple w.1 y.1 x.2.1))) ;
  equality : Id R (evaluate x) (evaluate y) =
   cancel y.2.1 y.2.2 _ _
    (cancel x.2.1 x.2.2 _ _
     (trans (mul-swap (phi.1 x.2.1) (phi.1 y.2.1) (evaluate x))
      (trans (ap (mul (phi.1 y.2.1)) (equation x))
       (trans (mulC (phi.1 y.2.1) (phi.1 x.1))
        (trans cross
         (trans (mulC (phi.1 y.1) (phi.1 x.2.1))
          (ap (mul (phi.1 x.2.1)) (sym (equation y))))))))) ;
 } ;
 respects (x y : B.Raw.Fraction) : B.Raw.Relation x y -> Id R (evaluate x) (evaluate y) =
  Tr.Trunc[B.Raw.Witness x y].induction @l
   (\ w -> Id R (evaluate x) (evaluate y)) (\ w -> setC _ _)
   (\ w -> Related[x,y,w].equality) ;
 module D = B.Q.Descend[R,setC,evaluate,respects] ;
 on-constant (a : A.R) : Id R (evaluate (B.Raw.constantF a)) (phi.1 a) =
  unique (B.Raw.constantF a) (phi.1 a)
   (trans (ap (\ c -> mul c (phi.1 a)) phi.2.1)
    (trans (mulC o (phi.1 a)) (mulO (phi.1 a)))) ;
 clear-add (s t x y : R) :
  Id R (mul (mul s t) (add x y)) (add (mul t (mul s x)) (mul s (mul t y))) =
  trans (dist (mul s t) x y)
   (cong2 R add _ _ _ _
    (trans (sym (mulA s t x)) (mul-swap s t x))
    (sym (mulA s t y))) ;
 add-equation (x y : B.Raw.Fraction) :
  Id R (mul (phi.1 (A.mul x.2.1 y.2.1)) (add (evaluate x) (evaluate y)))
   (phi.1 (A.add (A.mul x.1 y.2.1) (A.mul y.1 x.2.1))) =
  trans (ap (\ s -> mul s (add (evaluate x) (evaluate y))) (phi.2.2.2 x.2.1 y.2.1))
   (trans (clear-add (phi.1 x.2.1) (phi.1 y.2.1) (evaluate x) (evaluate y))
    (trans (cong2 R add _ _ _ _
      (trans (ap (mul (phi.1 y.2.1)) (equation x))
       (trans (mulC (phi.1 y.2.1) (phi.1 x.1)) (sym (phi.2.2.2 x.1 y.2.1))))
      (trans (ap (mul (phi.1 x.2.1)) (equation y))
       (trans (mulC (phi.1 x.2.1) (phi.1 y.1)) (sym (phi.2.2.2 y.1 x.2.1)))))
     (sym (phi.2.2.1 (A.mul x.1 y.2.1) (A.mul y.1 x.2.1))))) ;
 mul-equation (x y : B.Raw.Fraction) :
  Id R (mul (phi.1 (A.mul x.2.1 y.2.1)) (mul (evaluate x) (evaluate y))) (phi.1 (A.mul x.1 y.1)) =
  trans (ap (\ s -> mul s (mul (evaluate x) (evaluate y))) (phi.2.2.2 x.2.1 y.2.1))
   (trans (CU.mul-four (phi.1 x.2.1) (phi.1 y.2.1) (evaluate x) (evaluate y))
    (trans (cong2 R mul _ _ _ _ (equation x) (equation y)) (sym (phi.2.2.2 x.1 y.1)))) ;
 add-raw (x y : B.Raw.Fraction) :
  Id R (evaluate (B.Raw.addF x y)) (add (evaluate x) (evaluate y)) =
  unique (B.Raw.addF x y) (add (evaluate x) (evaluate y)) (add-equation x y) ;
 mul-raw (x y : B.Raw.Fraction) :
  Id R (evaluate (B.Raw.mulF x y)) (mul (evaluate x) (evaluate y)) =
  unique (B.Raw.mulF x y) (mul (evaluate x) (evaluate y)) (mul-equation x y) ;
 preserves-one : Id R (D.map B.oneQ) o =
  trans (D.beta (B.Raw.constantF A.o)) (trans (on-constant A.o) phi.2.1) ;
 preserves-add : (a b : B.Carrier) -> Id R (D.map (B.addQ a b)) (add (D.map a) (D.map b)) =
  B.forall2 (\ a b -> Id R (D.map (B.addQ a b)) (add (D.map a) (D.map b))) (\ a b -> setC _ _)
   (\ x y -> trans (ap D.map (B.Add.beta x y))
    (trans (D.beta (B.Raw.addF x y))
     (trans (add-raw x y) (cong2 R add _ _ _ _ (sym (D.beta x)) (sym (D.beta y)))))) ;
 preserves-mul : (a b : B.Carrier) -> Id R (D.map (B.mulQ a b)) (mul (D.map a) (D.map b)) =
  B.forall2 (\ a b -> Id R (D.map (B.mulQ a b)) (mul (D.map a) (D.map b))) (\ a b -> setC _ _)
   (\ x y -> trans (ap D.map (B.Multiply.beta x y))
    (trans (D.beta (B.Raw.mulF x y))
     (trans (mul-raw x y) (cong2 R mul _ _ _ _ (sym (D.beta x)) (sym (D.beta y)))))) ;
 hom : RingHom[l].Hom B.ring C = (D.map,preserves-one,preserves-add,preserves-mul) ;
 constants (a : A.R) : Id R (hom.1 (B.constant a)) (phi.1 a) =
  trans (D.beta (B.Raw.constantF a)) (on-constant a) ;
} ;
