-- Rescaling the variable, evaluation, and base change, compared by the
-- universal property of A[X]: two ring maps out of A[X] agreeing on the
-- constants and on X are equal (agree).
--   scale c : A[X] -> A[X],  X |-> c X;      eval r : A[X] -> A,  X |-> r;
--   scale c (scale d p) = scale (d c) p      (X |-> d X |-> d c X)
--   eval r (scale c p)  = eval (c r) p
-- and for a ring map psi : R -> C with psi[X] : R[X] -> C[X],
--   psi[X] (scale d p) = scale (psi d) (psi[X] p),
--   psi (eval r p)     = eval (psi r) (psi[X] p).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Agree (A Y : CRing) (setA : Pr.isSet A.R) (setY : Pr.isSet Y.R) {
 module AX = PolynomialRing[l].Extension[A,setA] ;
 module UP = Universal[l].Property[A,Y,setA,setY] ;
 agree (g h : H.Hom AX.ring Y)
  (constants : (a : A.R) -> Id Y.R (g.1 (AX.constant a)) (h.1 (AX.constant a)))
  (variable : Id Y.R (g.1 AX.variable) (h.1 AX.variable)) : Id (H.Hom AX.ring Y) g h =
  trans (UP.Given[UP.restrict h,h.1 AX.variable].unique g constants variable)
   (sym (UP.Given[UP.restrict h,h.1 AX.variable].unique h
     (\ a -> refl (h.1 (AX.constant a))) (refl (h.1 AX.variable)))) ;
 agree-at (g h : H.Hom AX.ring Y)
  (constants : (a : A.R) -> Id Y.R (g.1 (AX.constant a)) (h.1 (AX.constant a)))
  (variable : Id Y.R (g.1 AX.variable) (h.1 AX.variable)) (p : AX.Carrier) :
  Id Y.R (g.1 p) (h.1 p) =
  ap (\ k -> k.1 p) (agree g h constants variable) ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module AX = PolynomialRing[l].Extension[A,setA] ;
 module Sub = Substitution[l].Substitute[A,setA] ;
 module Self = Agree[A,AX.ring,setA,AX.set] ;
 module Onto = Agree[A,A,setA,setA] ;
 module UP = Universal[l].Property[A,A,setA,setA] ;
 scale (c : A.R) : H.Hom AX.ring AX.ring = Sub.substitution (AX.mulQ (AX.constant c) AX.variable) ;
 scale-constant (c a : A.R) : Id AX.Carrier ((scale c).1 (AX.constant a)) (AX.constant a) =
  Sub.on-constant (AX.mulQ (AX.constant c) AX.variable) a ;
 scale-variable (c : A.R) :
  Id AX.Carrier ((scale c).1 AX.variable) (AX.mulQ (AX.constant c) AX.variable) =
  Sub.on-variable (AX.mulQ (AX.constant c) AX.variable) ;
 scale-mul (c : A.R) (p q : AX.Carrier) :
  Id AX.Carrier ((scale c).1 (AX.mulQ p q)) (AX.mulQ ((scale c).1 p) ((scale c).1 q)) = (scale c).2.2.2 p q ;
 opaque scale ;
 -- (scale c) (c' X) = c' (c X)
 scale-linear (c c' : A.R) :
  Id AX.Carrier ((scale c).1 (AX.mulQ (AX.constant c') AX.variable))
   (AX.mulQ (AX.constant c') (AX.mulQ (AX.constant c) AX.variable)) =
  trans (scale-mul c (AX.constant c') AX.variable)
   (cong2 AX.Carrier AX.mulQ _ _ _ _ (scale-constant c c') (scale-variable c)) ;
 scale-scale (c d : A.R) (p : AX.Carrier) :
  Id AX.Carrier ((scale c).1 ((scale d).1 p)) ((scale (A.mul d c)).1 p) =
  Self.agree-at (H.compose AX.ring AX.ring AX.ring (scale c) (scale d)) (scale (A.mul d c))
   (\ a -> trans (ap (scale c).1 (scale-constant d a))
     (trans (scale-constant c a) (sym (scale-constant (A.mul d c) a))))
   (calc AX.Carrier { (scale c).1 ((scale d).1 AX.variable)
     =< ap (scale c).1 (scale-variable d) > (scale c).1 (AX.mulQ (AX.constant d) AX.variable)
     =< scale-linear c d > AX.mulQ (AX.constant d) (AX.mulQ (AX.constant c) AX.variable)
     =< AX.mul-assoc (AX.constant d) (AX.constant c) AX.variable >
        AX.mulQ (AX.mulQ (AX.constant d) (AX.constant c)) AX.variable
     =< ap (\ t -> AX.mulQ t AX.variable) (sym (AX.constant-mul d c)) >
        AX.mulQ (AX.constant (A.mul d c)) AX.variable
     =< sym (scale-variable (A.mul d c)) > (scale (A.mul d c)).1 AX.variable }) p ;
 eval (r : A.R) : H.Hom AX.ring A = UP.Given[H.identity A,r].extend ;
 eval-constant (r a : A.R) : Id A.R ((eval r).1 (AX.constant a)) a = UP.Given[H.identity A,r].on-constants a ;
 eval-variable (r : A.R) : Id A.R ((eval r).1 AX.variable) r = UP.Given[H.identity A,r].on-variable ;
 opaque eval ;
 -- eval r (c X) = c r
 eval-linear (r c : A.R) : Id A.R ((eval r).1 (AX.mulQ (AX.constant c) AX.variable)) (A.mul c r) =
  trans ((eval r).2.2.2 (AX.constant c) AX.variable)
   (cong2 A.R A.mul _ _ _ _ (eval-constant r c) (eval-variable r)) ;
 eval-scale (r c : A.R) (p : AX.Carrier) :
  Id A.R ((eval r).1 ((scale c).1 p)) ((eval (A.mul c r)).1 p) =
  Onto.agree-at (H.compose AX.ring AX.ring A (eval r) (scale c)) (eval (A.mul c r))
   (\ a -> trans (ap (eval r).1 (scale-constant c a))
     (trans (eval-constant r a) (sym (eval-constant (A.mul c r) a))))
   (trans (ap (eval r).1 (scale-variable c))
    (trans (eval-linear r c) (sym (eval-variable (A.mul c r))))) p ;
} ;
module Change (R C : CRing) (setR : Pr.isSet R.R) (setC : Pr.isSet C.R) (psi : H.Hom R C) {
 module PM = PolynomialMap[l].Over[R,C,setR,setC,psi] ;
 module SR = Over[R,setR] ;
 module SC = Over[C,setC] ;
 module RX = SR.AX ;
 module CX = SC.AX ;
 hom : H.Hom RX.ring CX.ring = PM.hom ;
 hom-constant (a : R.R) : Id CX.Carrier (hom.1 (RX.constant a)) (CX.constant (psi.1 a)) =
  PM.Extension.on-constants a ;
 hom-variable : Id CX.Carrier (hom.1 RX.variable) CX.variable = PM.Extension.on-variable ;
 raw-kernel (p : List R.R) (h : Id CX.Carrier (hom.1 (RX.include p)) CX.zeroQ) (k : Nat) :
  Id C.R (psi.1 (Poly[l].PolyR[R].coef p k)) C.z = PM.raw-kernel p h k ;
 opaque hom ;
 -- psi[X] (c X) = psi c X
 hom-linear (c : R.R) :
  Id CX.Carrier (hom.1 (RX.mulQ (RX.constant c) RX.variable)) (CX.mulQ (CX.constant (psi.1 c)) CX.variable) =
  trans (hom.2.2.2 (RX.constant c) RX.variable)
   (cong2 CX.Carrier CX.mulQ _ _ _ _ (hom-constant c) hom-variable) ;
 scale-change (d : R.R) (p : RX.Carrier) :
  Id CX.Carrier (hom.1 ((SR.scale d).1 p)) ((SC.scale (psi.1 d)).1 (hom.1 p)) =
  Agree[R,CX.ring,setR,CX.set].agree-at
   (H.compose RX.ring RX.ring CX.ring hom (SR.scale d))
   (H.compose RX.ring CX.ring CX.ring (SC.scale (psi.1 d)) hom)
   (\ a -> trans (ap hom.1 (SR.scale-constant d a))
     (trans (hom-constant a)
      (sym (trans (ap (SC.scale (psi.1 d)).1 (hom-constant a)) (SC.scale-constant (psi.1 d) (psi.1 a))))))
   (trans (ap hom.1 (SR.scale-variable d))
    (trans (hom-linear d)
     (sym (trans (ap (SC.scale (psi.1 d)).1 hom-variable) (SC.scale-variable (psi.1 d)))))) p ;
 eval-change (r : R.R) (p : RX.Carrier) :
  Id C.R (psi.1 ((SR.eval r).1 p)) ((SC.eval (psi.1 r)).1 (hom.1 p)) =
  Agree[R,C,setR,setC].agree-at
   (H.compose RX.ring R C psi (SR.eval r))
   (H.compose RX.ring CX.ring C (SC.eval (psi.1 r)) hom)
   (\ a -> trans (ap psi.1 (SR.eval-constant r a))
     (sym (trans (ap (SC.eval (psi.1 r)).1 (hom-constant a)) (SC.eval-constant (psi.1 r) (psi.1 a)))))
   (trans (ap psi.1 (SR.eval-variable r))
    (sym (trans (ap (SC.eval (psi.1 r)).1 hom-variable) (SC.eval-variable (psi.1 r))))) p ;
} ;
