-- Equal classes in K_0(B) (K0) are stably isomorphic with a free summand.
-- If [s] = [t] in K_0(B), then merely
--     Image (s + 1_j) ~ Image (t + 1_j)        for some j.
-- Proof.  Equal classes in the Grothendieck ring give s + w ~ t + w in the
-- semiring of projectors for some projector w (GROTHENDIECK.effective, at
-- a representative w of the semiring class), and w + (1 - w) ~ 1_j with j
-- the size of w (COMPLEMENTS), so
--     s + 1_j ~ (s + w) + (1 - w) ~ (t + w) + (1 - w) ~ t + 1_j.
-- A larger j also works: s + 1_(j+k) ~ (s + 1_j) + 1_k, and likewise for
-- k + j (up-right, up-left).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (B : CRing) (setB : Pr.isSet B.R) {
 module K = K0[l].Over[B,setB] ;
 module CB = Complements[l].Over[B,setB] ;
 module PJ = K.PJ ;
 module MI = K.MI ;
 module SR = K.SR ;
 cls (p : PJ.Projector) : SR.Carrier = SR.class p ;
 one (j : Nat) : PJ.Projector = PJ.Free[j].projector ;
 Stably (s t : PJ.Projector) (j : Nat) : U l = K.Rel (K.sum s (one j)) (K.sum t (one j)) ;
 -- [1_j] + [1_k] = [1_(j+k)] in the semiring
 free-sum (j k : Nat) : Id SR.Carrier (SR.addQ (cls (one j)) (cls (one k))) (cls (one (plus j k))) =
  trans (SR.add2 (one j) (one k)) (SR.Q.relates (K.sum (one j) (one k)) (one (plus j k))
   (K.related (K.sum (one j) (one k)) (one (plus j k)) K.PSm.FreeSum[j,k].iso)) ;
 -- [w] + [1 - w] = [1_j] in the semiring
 complete (w : PJ.Projector) :
  Id SR.Carrier (SR.addQ (cls w) (cls CB.Complement[w].projector)) (cls (one w.size)) =
  trans (SR.add2 w CB.Complement[w].projector) (SR.Q.relates (K.sum w CB.Complement[w].projector) (one w.size)
   (K.related (K.sum w CB.Complement[w].projector) (one w.size)
    (MI.compose (K.image (K.sum w CB.Complement[w].projector)) CB.Complement[w].T.product (K.image (one w.size))
     K.PSm.SumImage[w,CB.Complement[w].projector].iso
     (MI.compose CB.Complement[w].T.product (PJ.FM.free w.size) (K.image (one w.size)) CB.Complement[w].iso
      (MI.inverse (K.image (one w.size)) (PJ.FM.free w.size) PJ.Free[w.size].iso))))) ;

 module Stabilise (s t : PJ.Projector) (h : Id K.K0.R (K.class s) (K.class t)) {
  Goal : U l = Tr.Trunc[(j : Nat) * Stably s t j].carrier ;
  goal-prop : Pr.isProp Goal = Tr.Trunc[(j : Nat) * Stably s t j].proposition ;
  Equal (u : SR.Carrier) : U l = Id SR.Carrier (SR.addQ (cls s) u) (SR.addQ (cls t) u) ;
  at (w : PJ.Projector) (e : Equal (cls w)) : Goal =
   Tr.Trunc[(j : Nat) * Stably s t j].inc (w.size,SR.effective (K.sum s (one w.size)) (K.sum t (one w.size))
    (calc SR.Carrier { cls (K.sum s (one w.size))
      =< sym (SR.add2 s (one w.size)) > SR.addQ (cls s) (cls (one w.size))
      =< ap (SR.addQ (cls s)) (sym (complete w)) > SR.addQ (cls s) (SR.addQ (cls w) (cls CB.Complement[w].projector))
      =< SR.semiring.addA (cls s) (cls w) (cls CB.Complement[w].projector) >
         SR.addQ (SR.addQ (cls s) (cls w)) (cls CB.Complement[w].projector)
      =< ap (\ x -> SR.addQ x (cls CB.Complement[w].projector)) e >
         SR.addQ (SR.addQ (cls t) (cls w)) (cls CB.Complement[w].projector)
      =< sym (SR.semiring.addA (cls t) (cls w) (cls CB.Complement[w].projector)) >
         SR.addQ (cls t) (SR.addQ (cls w) (cls CB.Complement[w].projector))
      =< ap (SR.addQ (cls t)) (complete w) > SR.addQ (cls t) (cls (one w.size))
      =< SR.add2 t (one w.size) > cls (K.sum t (one w.size)) })) ;
  theorem : Goal =
   TC.rec ((u : SR.Carrier) * Equal u) @l Goal goal-prop
    (\ v -> SR.forall1 (\ u -> Equal u -> Goal) (\ u -> F.isProp-Pi (Equal u) (\ e -> Goal) (\ e -> goal-prop)) at v.1 v.2)
    (K.G.effective (cls s) (cls t) h) ;
 } ;

 module Up (s t : PJ.Projector) (j k J : Nat)
  (eJ : Id SR.Carrier (cls (one J)) (SR.addQ (cls (one j)) (cls (one k)))) (h : Stably s t j) {
  -- [r + 1_J] = [r + 1_j] + [1_k]
  regroup (r : PJ.Projector) : Id SR.Carrier (cls (K.sum r (one J))) (SR.addQ (cls (K.sum r (one j))) (cls (one k))) =
   calc SR.Carrier { cls (K.sum r (one J))
     =< sym (SR.add2 r (one J)) > SR.addQ (cls r) (cls (one J))
     =< ap (SR.addQ (cls r)) eJ > SR.addQ (cls r) (SR.addQ (cls (one j)) (cls (one k)))
     =< SR.semiring.addA (cls r) (cls (one j)) (cls (one k)) > SR.addQ (SR.addQ (cls r) (cls (one j))) (cls (one k))
     =< ap (\ x -> SR.addQ x (cls (one k))) (SR.add2 r (one j)) > SR.addQ (cls (K.sum r (one j))) (cls (one k)) } ;
  stably : Stably s t J = SR.effective (K.sum s (one J)) (K.sum t (one J))
   (trans (regroup s)
    (trans (ap (\ x -> SR.addQ x (cls (one k))) (SR.Q.relates (K.sum s (one j)) (K.sum t (one j)) h))
     (sym (regroup t)))) ;
 } ;
 up-right (s t : PJ.Projector) (j k : Nat) (h : Stably s t j) : Stably s t (plus j k) =
  Up[s,t,j,k,plus j k,sym (free-sum j k),h].stably ;
 up-left (s t : PJ.Projector) (j k : Nat) (h : Stably s t j) : Stably s t (plus k j) =
  Up[s,t,j,k,plus k j,trans (sym (free-sum k j)) (SR.semiring.addC (cls (one k)) (cls (one j))),h].stably ;
} ;
