-- The homotopy lemma (gabber-recollement.tex, Lemma 3.5).  Let a, b in A
-- be comaximal, and A -> A_a -> C, A -> A_b -> C a commutative square where
-- A_a -> C is localising at b and A_b -> C is localising at a (LOCALISING;
-- for instance C = A_ab).  Let g, g' be inverse N x N matrices over C, and
-- eps(T), eps'(T) inverse matrices over C[T] with eps(0) = 1.  Then there
-- are inverse pairs beta over A_b and alpha over A_a with
--     g eps(1) = beta g alpha        (images in C).
--
-- Proof.  Put phi = g eps g', phi' = g eps' g' (inverse over C[T]), and
--     Phi(T,U) = phi(T+U) phi'(T),   Phi' = phi(T) phi'(T+U)
-- over C[T][U], inverse with Phi(T,0) = 1.
--  (alpha) LIFT for A_a -> C at b and eps: inverse G1 over A_a[T] with
--          G1 |-> eps(e1 T), e1 = b^k1.
--  (beta)  POLYNOMIALLOCALISING makes A_b[T] -> C[T] localising at a, and
--          LIFT for it and Phi: inverse G2 over A_b[T][U] with
--          G2 |-> Phi(T, e2 U), e2 = a^k2.
--  Powers of comaximal elements are comaximal: a^k2 x + b^k1 y = 1.  Put
--  t = b^k1 y, u = a^k2 x, alpha = G1(y), beta = G2(t, x).  Then
--     alpha |-> eps(t),     beta |-> Phi(t, u) = phi(t+u) phi'(t) = phi(1) phi'(t),
--  and  beta g alpha = (g eps(1) g')(g eps'(t) g') g eps(t) = g eps(1)
--  (CONJUGATION, final).  The variable T of Phi is what makes k2
--  independent of t, which depends on k2 through x and y.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module B = Bounds[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (N : Nat) {
 -- the map A -> C
 c (r : A.R) : C.R = jb.1 (ib.1 r) ;
 c-add (r r' : A.R) : Id C.R (c (A.add r r')) (C.add (c r) (c r')) =
  trans (ap jb.1 (ib.2.2.1 r r')) (jb.2.2.1 (ib.1 r) (ib.1 r')) ;
 c-one : Id C.R (c A.o) C.o = trans (ap jb.1 ib.2.1) jb.2.1 ;
 module PA = AffinePowers[l].Over[A] ;
 module CM = Comaximal[l].Over[A] ;
 -- polynomial rings C[T], C[T][U], A_a[T], A_b[T], A_b[T][U]
 module SC0 = Rescaling[l].Over[C,setC] ;
 module CT = SC0.AX ;
 module SCU = Rescaling[l].Over[CT.ring,CT.set] ;
 module CTU = SCU.AX ;
 module SAa = Rescaling[l].Over[Aa,setAa] ;
 module SAb = Rescaling[l].Over[Ab,setAb] ;
 module AbT = SAb.AX ;
 module SAbU = Rescaling[l].Over[AbT.ring,AbT.set] ;
 module CT1 = ConstantTerm[l].Over[CT.ring,CT.set] ;
 -- matrices
 module MC = MnAlgebra[l].Over[C,setC,N] ;
 module MCT = MnAlgebra[l].Over[CT.ring,CT.set,N] ;
 module MCTU = MnAlgebra[l].Over[CTU.ring,CTU.set,N] ;
 module MAa = MnAlgebra[l].Over[Aa,setAa,N] ;
 module MAb = MnAlgebra[l].Over[Ab,setAb,N] ;
 module IC = MatrixMap[l].Invertible[C,setC,N] ;
 module ICT = MatrixMap[l].Invertible[CT.ring,CT.set,N] ;
 module ICTU = MatrixMap[l].Invertible[CTU.ring,CTU.set,N] ;
 module IAa = MatrixMap[l].Invertible[Aa,setAa,N] ;
 module IAb = MatrixMap[l].Invertible[Ab,setAb,N] ;
 module CjC = Conjugation[l].Over[C,setC,N] ;
 module CjT = Conjugation[l].Over[CT.ring,CT.set,N] ;
 module CjTU = Conjugation[l].Over[CTU.ring,CTU.set,N] ;
 module JA = MatrixMap[l].Over[Aa,C,setAa,setC,ja,N] ;
 module JB = MatrixMap[l].Over[Ab,C,setAb,setC,jb,N] ;
 module KT = Conjugation[l].Map[C,CT.ring,setC,CT.set,CT.inclusion,N] ;
 module KU = MatrixMap[l].Over[CT.ring,CTU.ring,CT.set,CTU.set,CTU.inclusion,N] ;
 module Ev (w : C.R) { module Mp = Conjugation[l].Map[CT.ring,C,CT.set,setC,SC0.eval w,N] ; } ;
 -- the substitution T |-> T + U
 module UPS = Universal[l].Property[C,CTU.ring,setC,CTU.set] ;
 shift-base : H.Hom C CTU.ring = H.compose C CT.ring CTU.ring CTU.inclusion CT.inclusion ;
 shift : H.Hom CT.ring CTU.ring = UPS.Given[shift-base,CTU.addQ (CTU.constant CT.variable) CTU.variable].extend ;
 module Sh = MatrixMap[l].Over[CT.ring,CTU.ring,CT.set,CTU.set,shift,N] ;
 shift-constant (r : C.R) : Id CTU.Carrier (shift.1 (CT.constant r)) (CTU.constant (CT.constant r)) =
  UPS.Given[shift-base,CTU.addQ (CTU.constant CT.variable) CTU.variable].on-constants r ;
 shift-variable : Id CTU.Carrier (shift.1 CT.variable) (CTU.addQ (CTU.constant CT.variable) CTU.variable) =
  UPS.Given[shift-base,CTU.addQ (CTU.constant CT.variable) CTU.variable].on-variable ;
 opaque shift ;
 -- U |-> 0 after T |-> T + U is the identity
 value0-shift (p : CT.Carrier) : Id CT.Carrier (CT1.value0.1 (shift.1 p)) p =
  Rescaling[l].Agree[C,CT.ring,setC,CT.set].agree-at
   (H.compose CT.ring CTU.ring CT.ring CT1.value0 shift) (H.identity CT.ring)
   (\ r -> trans (ap CT1.value0.1 (shift-constant r)) (CT1.value0-constant (CT.constant r)))
   (calc CT.Carrier { CT1.value0.1 (shift.1 CT.variable)
     =< ap CT1.value0.1 shift-variable > CT1.value0.1 (CTU.addQ (CTU.constant CT.variable) CTU.variable)
     =< CT1.value0.2.2.1 (CTU.constant CT.variable) CTU.variable >
        CT.addQ (CT1.value0.1 (CTU.constant CT.variable)) (CT1.value0.1 CTU.variable)
     =< cong2 CT.Carrier CT.addQ _ _ _ _ (CT1.value0-constant CT.variable) CT1.value0-variable >
        CT.addQ CT.variable CT.zeroQ
     =< CT.add-zero CT.variable > CT.variable }) p ;

 -- the two localising maps and their lifts
 module LA = Lift[l].Over[Aa,C,setAa,setC,ja,ia.1 b,la,N] ;
 module PLb = PolynomialLocalising[l].Over[Ab,C,setAb,setC,jb,ib.1 a,lb] ;
 module LB2 = Lift[l].Over[AbT.ring,CT.ring,AbT.set,CT.set,PLb.Ch.hom,AbT.constant (ib.1 a),PLb.localising,N] ;

 module Lemma (g g' : MC.Mat) (gi : IC.Inverse[g,g']) (eps eps' : MCT.Mat)
  (ei : ICT.Inverse[eps,eps']) (eu : LA.Unit eps) {
  Kg-left : Id MCT.Mat (MCT.mmul (KT.MM.map g') (KT.MM.map g)) MCT.mone =
   (KT.MM.map-inverse g g' gi).left ;
  Kg-right : Id MCT.Mat (MCT.mmul (KT.MM.map g) (KT.MM.map g')) MCT.mone =
   (KT.MM.map-inverse g g' gi).right ;
  phi : MCT.Mat = CjT.conj (KT.MM.map g) (KT.MM.map g') eps ;
  phi' : MCT.Mat = CjT.conj (KT.MM.map g) (KT.MM.map g') eps' ;
  phi-inverse : ICT.Inverse[phi,phi'] =
   new ICT.Inverse[phi,phi',
    trans (CjT.conj-mul (KT.MM.map g) (KT.MM.map g') Kg-left eps eps')
     (trans (ap (CjT.conj (KT.MM.map g) (KT.MM.map g')) ei.right) (CjT.conj-one (KT.MM.map g) (KT.MM.map g') Kg-right)),
    trans (CjT.conj-mul (KT.MM.map g) (KT.MM.map g') Kg-left eps' eps)
     (trans (ap (CjT.conj (KT.MM.map g) (KT.MM.map g')) ei.left) (CjT.conj-one (KT.MM.map g) (KT.MM.map g') Kg-right))] ;
  Phi : MCTU.Mat = MCTU.mmul (Sh.map phi) (KU.map phi') ;
  Phi' : MCTU.Mat = MCTU.mmul (KU.map phi) (Sh.map phi') ;
  Phi-inverse : ICTU.Inverse[Phi,Phi'] =
   new ICTU.Inverse[Phi,Phi',
    CjTU.sandwich (Sh.map phi) (Sh.map phi') (KU.map phi) (KU.map phi')
     (Sh.map-inverse phi phi' phi-inverse).right (KU.map-inverse phi phi' phi-inverse).left,
    CjTU.sandwich (KU.map phi) (KU.map phi') (Sh.map phi) (Sh.map phi')
     (KU.map-inverse phi phi' phi-inverse).right (Sh.map-inverse phi phi' phi-inverse).left] ;
  value0-shift-entry (P : MCT.Mat) (i j : Fin N) : Id CT.Carrier (LB2.V0.map (Sh.map P) i j) (P i j) =
   value0-shift (P i j) ;
  value0-constant-entry (P : MCT.Mat) (i j : Fin N) : Id CT.Carrier (LB2.V0.map (KU.map P) i j) (P i j) =
   CT1.value0-constant (P i j) ;
  -- Phi(T,0) = phi(T) phi'(T) = 1
  Phi-unit : LB2.Unit Phi =
   calc MCT.Mat { LB2.V0.map Phi
     =< LB2.V0.map-mul (Sh.map phi) (KU.map phi') > MCT.mmul (LB2.V0.map (Sh.map phi)) (LB2.V0.map (KU.map phi'))
     =< cong2 MCT.Mat MCT.mmul _ _ _ _
         (MCT.mat-eq (LB2.V0.map (Sh.map phi)) phi (value0-shift-entry phi))
         (MCT.mat-eq (LB2.V0.map (KU.map phi')) phi' (value0-constant-entry phi')) >
        MCT.mmul phi phi'
     =< phi-inverse.right > MCT.mone } ;
  -- eps' (t) eps (t) = 1
  eps-left (w : C.R) : Id MC.Mat (MC.mmul (Ev[w].Mp.MM.map eps') (Ev[w].Mp.MM.map eps)) MC.mone =
   (Ev[w].Mp.MM.map-inverse eps eps' ei).left ;
  -- phi (w) = g eps(w) g'
  ev-g-entry (w : C.R) (h : MC.Mat) (i j : Fin N) : Id C.R (Ev[w].Mp.MM.map (KT.MM.map h) i j) (h i j) =
   SC0.eval-constant w (h i j) ;
  ev-g (w : C.R) (h : MC.Mat) : Id MC.Mat (Ev[w].Mp.MM.map (KT.MM.map h)) h =
   MC.mat-eq (Ev[w].Mp.MM.map (KT.MM.map h)) h (ev-g-entry w h) ;
  ev-conj (w : C.R) (P : MCT.Mat) :
   Id MC.Mat (Ev[w].Mp.MM.map (CjT.conj (KT.MM.map g) (KT.MM.map g') P)) (CjC.conj g g' (Ev[w].Mp.MM.map P)) =
   trans (Ev[w].Mp.map-conj (KT.MM.map g) (KT.MM.map g') P)
    (cong2 MC.Mat (\ h h2 -> CjC.conj h h2 (Ev[w].Mp.MM.map P)) _ _ _ _ (ev-g w g) (ev-g w g')) ;

  -- alpha = G1(y)
  module Alpha (y : A.R) (k1 : Nat) (w : LA.Lift eps k1) {
   module E = MatrixMap[l].Over[SAa.AX.ring,Aa,SAa.AX.set,setAa,SAa.eval (ia.1 y),N] ;
   alpha : MAa.Mat = E.map w.1 ;
   alpha' : MAa.Mat = E.map w.2.1 ;
   alpha-inverse : IAa.Inverse[alpha,alpha'] = E.map-inverse w.1 w.2.1 w.2.2.1 ;
   t : C.R = c (A.mul (PA.power b k1) y) ;
   -- ja (b^k1) ja (y) = c (b^k1 y)
   point : Id C.R (C.mul (ja.1 (LA.LB.pow k1)) (ja.1 (ia.1 y))) t =
    calc C.R { C.mul (ja.1 (LA.LB.pow k1)) (ja.1 (ia.1 y))
      =< sym (ja.2.2.2 (LA.LB.pow k1) (ia.1 y)) > ja.1 (Aa.mul (LA.LB.pow k1) (ia.1 y))
      =< ap (\ r -> ja.1 (Aa.mul r (ia.1 y))) (sym (AffinePowers[l].power-map A Aa ia b k1)) >
         ja.1 (Aa.mul (ia.1 (PA.power b k1)) (ia.1 y))
      =< ap ja.1 (sym (ia.2.2.2 (PA.power b k1) y)) > ja.1 (ia.1 (A.mul (PA.power b k1) y))
      =< square (A.mul (PA.power b k1) y) > t } ;
   image-entry (i j : Fin N) : Id C.R (JA.map alpha i j) ((SC0.eval t).1 (eps i j)) =
    calc C.R { ja.1 ((SAa.eval (ia.1 y)).1 (w.1 i j))
      =< LA.Ch.eval-change (ia.1 y) (w.1 i j) > (SC0.eval (ja.1 (ia.1 y))).1 (LA.Ch.hom.1 (w.1 i j))
      =< ap (SC0.eval (ja.1 (ia.1 y))).1 (LA.image-at eps k1 w i j) >
         (SC0.eval (ja.1 (ia.1 y))).1 ((SC0.scale (ja.1 (LA.LB.pow k1))).1 (eps i j))
      =< SC0.eval-scale (ja.1 (ia.1 y)) (ja.1 (LA.LB.pow k1)) (eps i j) >
         (SC0.eval (C.mul (ja.1 (LA.LB.pow k1)) (ja.1 (ia.1 y)))).1 (eps i j)
      =< ap (\ r -> (SC0.eval r).1 (eps i j)) point > (SC0.eval t).1 (eps i j) } ;
   image : Id MC.Mat (JA.map alpha) (Ev[t].Mp.MM.map eps) =
    MC.mat-eq (JA.map alpha) (Ev[t].Mp.MM.map eps) image-entry ;
  } ;

  -- beta = G2(t, x)
  module Beta (x y : A.R) (k1 k2 : Nat) (w : LB2.Lift Phi k2) {
   t : C.R = c (A.mul (PA.power b k1) y) ;
   u : C.R = c (A.mul (PA.power a k2) x) ;
   evalU : H.Hom SAbU.AX.ring AbT.ring = SAbU.eval (AbT.constant (ib.1 x)) ;
   evalT : H.Hom AbT.ring Ab = SAb.eval (ib.1 (A.mul (PA.power b k1) y)) ;
   module E = MatrixMap[l].Over[SAbU.AX.ring,Ab,SAbU.AX.set,setAb,H.compose SAbU.AX.ring AbT.ring Ab evalT evalU,N] ;
   beta : MAb.Mat = E.map w.1 ;
   beta' : MAb.Mat = E.map w.2.1 ;
   beta-inverse : IAb.Inverse[beta,beta'] = E.map-inverse w.1 w.2.1 w.2.2.1 ;
   -- evaluation at T = t, U = u over C
   E' : H.Hom CTU.ring C = H.compose CTU.ring CT.ring C (SC0.eval t) (SCU.eval (CT.constant u)) ;
   module E'M = MatrixMap[l].Over[CTU.ring,C,CTU.set,setC,E',N] ;
   e2 : CT.Carrier = PLb.Ch.hom.1 (LB2.LB.pow k2) ;
   -- a^k2 x as a constant of C[T]
   slope : Id CT.Carrier (CT.mulQ e2 (PLb.Ch.hom.1 (AbT.constant (ib.1 x)))) (CT.constant u) =
    calc CT.Carrier { CT.mulQ e2 (PLb.Ch.hom.1 (AbT.constant (ib.1 x)))
      =< cong2 CT.Carrier CT.mulQ _ _ _ _ (PLb.image-pow k2) (PLb.Ch.hom-constant (ib.1 x)) >
         CT.mulQ (CT.constant (jb.1 (PLb.LB.pow k2))) (CT.constant (jb.1 (ib.1 x)))
      =< sym (CT.constant-mul (jb.1 (PLb.LB.pow k2)) (jb.1 (ib.1 x))) >
         CT.constant (C.mul (jb.1 (PLb.LB.pow k2)) (jb.1 (ib.1 x)))
      =< ap CT.constant (sym (jb.2.2.2 (PLb.LB.pow k2) (ib.1 x))) > CT.constant (jb.1 (Ab.mul (PLb.LB.pow k2) (ib.1 x)))
      =< ap (\ r -> CT.constant (jb.1 (Ab.mul r (ib.1 x)))) (sym (AffinePowers[l].power-map A Ab ib a k2)) >
         CT.constant (jb.1 (Ab.mul (ib.1 (PA.power a k2)) (ib.1 x)))
      =< ap (\ r -> CT.constant (jb.1 r)) (sym (ib.2.2.2 (PA.power a k2) x)) > CT.constant u } ;
   image-E-entry (i j : Fin N) : Id C.R (JB.map beta i j) (E'M.map Phi i j) =
    calc C.R { jb.1 (evalT.1 (evalU.1 (w.1 i j)))
      =< PLb.Ch.eval-change (ib.1 (A.mul (PA.power b k1) y)) (evalU.1 (w.1 i j)) >
         (SC0.eval t).1 (PLb.Ch.hom.1 (evalU.1 (w.1 i j)))
      =< ap (SC0.eval t).1 (LB2.Ch.eval-change (AbT.constant (ib.1 x)) (w.1 i j)) >
         (SC0.eval t).1 ((SCU.eval (PLb.Ch.hom.1 (AbT.constant (ib.1 x)))).1 (LB2.Ch.hom.1 (w.1 i j)))
      =< ap (\ p -> (SC0.eval t).1 ((SCU.eval (PLb.Ch.hom.1 (AbT.constant (ib.1 x)))).1 p)) (LB2.image-at Phi k2 w i j) >
         (SC0.eval t).1 ((SCU.eval (PLb.Ch.hom.1 (AbT.constant (ib.1 x)))).1 ((SCU.scale e2).1 (Phi i j)))
      =< ap (SC0.eval t).1 (SCU.eval-scale (PLb.Ch.hom.1 (AbT.constant (ib.1 x))) e2 (Phi i j)) >
         (SC0.eval t).1 ((SCU.eval (CT.mulQ e2 (PLb.Ch.hom.1 (AbT.constant (ib.1 x))))).1 (Phi i j))
      =< ap (\ q -> (SC0.eval t).1 ((SCU.eval q).1 (Phi i j))) slope > E'.1 (Phi i j) } ;
   image-E : Id MC.Mat (JB.map beta) (E'M.map Phi) =
    MC.mat-eq (JB.map beta) (E'M.map Phi) image-E-entry ;
   -- E' (T + U) = t + u and E' on constants of C[T] is evaluation at t
   shift-point (p : CT.Carrier) : Id C.R (E'.1 (shift.1 p)) ((SC0.eval (C.add t u)).1 p) =
    SC0.Onto.agree-at (H.compose CT.ring CTU.ring C E' shift) (SC0.eval (C.add t u))
     (\ r -> trans (ap E'.1 (shift-constant r))
       (trans (ap (SC0.eval t).1 (SCU.eval-constant (CT.constant u) (CT.constant r)))
        (trans (SC0.eval-constant t r) (sym (SC0.eval-constant (C.add t u) r)))))
     (calc C.R { E'.1 (shift.1 CT.variable)
       =< ap E'.1 shift-variable > E'.1 (CTU.addQ (CTU.constant CT.variable) CTU.variable)
       =< E'.2.2.1 (CTU.constant CT.variable) CTU.variable > C.add (E'.1 (CTU.constant CT.variable)) (E'.1 CTU.variable)
       =< cong2 C.R C.add _ _ _ _
           (trans (ap (SC0.eval t).1 (SCU.eval-constant (CT.constant u) CT.variable)) (SC0.eval-variable t))
           (trans (ap (SC0.eval t).1 (SCU.eval-variable (CT.constant u))) (SC0.eval-constant t u)) > C.add t u
       =< sym (SC0.eval-variable (C.add t u)) > (SC0.eval (C.add t u)).1 CT.variable }) p ;
   constant-point (p : CT.Carrier) : Id C.R (E'.1 (CTU.constant p)) ((SC0.eval t).1 p) =
    ap (SC0.eval t).1 (SCU.eval-constant (CT.constant u) p) ;
   shift-entry (P : MCT.Mat) (i j : Fin N) :
    Id C.R (E'M.map (Sh.map P) i j) (Ev[C.add t u].Mp.MM.map P i j) = shift-point (P i j) ;
   constant-entry (P : MCT.Mat) (i j : Fin N) :
    Id C.R (E'M.map (KU.map P) i j) (Ev[t].Mp.MM.map P i j) = constant-point (P i j) ;
   -- beta |-> phi(t+u) phi'(t)
   image : Id MC.Mat (JB.map beta) (MC.mmul (Ev[C.add t u].Mp.MM.map phi) (Ev[t].Mp.MM.map phi')) =
    trans image-E (trans (E'M.map-mul (Sh.map phi) (KU.map phi'))
     (cong2 MC.Mat MC.mmul _ _ _ _
      (MC.mat-eq (E'M.map (Sh.map phi)) (Ev[C.add t u].Mp.MM.map phi) (shift-entry phi))
      (MC.mat-eq (E'M.map (KU.map phi')) (Ev[t].Mp.MM.map phi') (constant-entry phi')))) ;
  } ;

  Result : U l =
   (beta : MAb.Mat) * (beta' : MAb.Mat) * IAb.Inverse[beta,beta'] *
   (alpha : MAa.Mat) * (alpha' : MAa.Mat) * IAa.Inverse[alpha,alpha'] *
   Id MC.Mat (MC.mmul g (Ev[C.o].Mp.MM.map eps)) (MC.mmul (MC.mmul (JB.map beta) g) (JA.map alpha)) ;
  module Assemble (k1 : Nat) (wa : LA.Lift eps k1) (k2 : Nat) (wb : LB2.Lift Phi k2)
   (cm : CM.Comaximal (PA.power a k2) (PA.power b k1)) {
   module Al = Alpha[cm.2.1,k1,wa] ;
   module Be = Beta[cm.1,cm.2.1,k1,k2,wb] ;
   -- t + u = c (b^k1 y + a^k2 x) = c 1 = 1
   one : Id C.R (C.add Be.t Be.u) C.o =
    trans (C.addC Be.t Be.u)
     (trans (sym (c-add (A.mul (PA.power a k2) cm.1) (A.mul (PA.power b k1) cm.2.1)))
      (trans (ap c cm.2.2) c-one)) ;
   equation : Id MC.Mat (MC.mmul g (Ev[C.o].Mp.MM.map eps)) (MC.mmul (MC.mmul (JB.map Be.beta) g) (JA.map Al.alpha)) =
    sym (calc MC.Mat { MC.mmul (MC.mmul (JB.map Be.beta) g) (JA.map Al.alpha)
      =< cong2 MC.Mat (\ p q -> MC.mmul (MC.mmul p g) q) _ _ _ _ Be.image Al.image >
         MC.mmul (MC.mmul (MC.mmul (Ev[C.add Be.t Be.u].Mp.MM.map phi) (Ev[Be.t].Mp.MM.map phi')) g) (Ev[Be.t].Mp.MM.map eps)
      =< cong2 MC.Mat (\ p q -> MC.mmul (MC.mmul (MC.mmul p q) g) (Ev[Be.t].Mp.MM.map eps)) _ _ _ _
          (ev-conj (C.add Be.t Be.u) eps) (ev-conj Be.t eps') >
         MC.mmul (MC.mmul (MC.mmul (CjC.conj g g' (Ev[C.add Be.t Be.u].Mp.MM.map eps))
          (CjC.conj g g' (Ev[Be.t].Mp.MM.map eps'))) g) (Ev[Be.t].Mp.MM.map eps)
      =< CjC.final g g' (Ev[C.add Be.t Be.u].Mp.MM.map eps) (Ev[Be.t].Mp.MM.map eps) (Ev[Be.t].Mp.MM.map eps')
          gi.left (eps-left Be.t) > MC.mmul g (Ev[C.add Be.t Be.u].Mp.MM.map eps)
      =< ap (\ r -> MC.mmul g (Ev[r].Mp.MM.map eps)) one > MC.mmul g (Ev[C.o].Mp.MM.map eps) }) ;
   result : Result = (Be.beta,Be.beta',Be.beta-inverse,Al.alpha,Al.alpha',Al.alpha-inverse,equation) ;
  } ;
  theorem : Tr.Trunc[Result].carrier =
   TC.bind (B.Bound (LA.Lift eps)) Result
    (\ wa -> TC.bind (B.Bound (LB2.Lift Phi)) Result
     (\ wb -> TC.map (CM.Comaximal (PA.power a wb.1) (PA.power b wa.1)) Result
      (\ cm -> Assemble[wa.1,wa.2,wb.1,wb.2,cm].result)
      (CM.merely-powers a b comaximal wb.1 wa.1))
     (LB2.lift Phi Phi' Phi-inverse Phi-unit))
    (LA.lift eps eps' ei eu) ;
 } ;
} ;
