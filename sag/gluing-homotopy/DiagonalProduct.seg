-- gabber-recollement.tex, Lemma 3.6(1), at the level of matrices.  In the
-- situation of HOMOTOPY (a, b comaximal, A_a -> C localising at b,
-- A_b -> C localising at a), let g, g' and h, h' be inverse M x M matrices
-- over C.  Then there are inverse pairs beta over A_b and alpha over A_a,
-- of size 2M, with
--     diag(g, h) = beta diag(gh, 1) alpha        (images in C).
--
-- Proof.  diag(g, h) = diag(gh, 1) diag(h', h) (DIAG-MUL), and
-- diag(h', h) = eps(1) for the homotopy (WHITEHEAD)
--     eps(T) = u(T h') l(-T h) u(T h') u(-T) l(T) u(-T)      over C[T],
-- which is invertible with eps(0) = 1.  The homotopy lemma for
-- diag(gh, 1) and eps gives diag(gh, 1) eps(1) = beta diag(gh, 1) alpha.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module H = RingHom[l] ;
module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;
module Over (A Aa Ab C : CRing) (setA : Pr.isSet A.R) (setAa : Pr.isSet Aa.R)
 (setAb : Pr.isSet Ab.R) (setC : Pr.isSet C.R)
 (ia : H.Hom A Aa) (ib : H.Hom A Ab) (ja : H.Hom Aa C) (jb : H.Hom Ab C)
 (square : (r : A.R) -> Id C.R (ja.1 (ia.1 r)) (jb.1 (ib.1 r)))
 (a b : A.R)
 (la : Localising[l].Over[Aa,C,ja,ia.1 b].Localising)
 (lb : Localising[l].Over[Ab,C,jb,ib.1 a].Localising)
 (comaximal : Tr.Trunc[Comaximal[l].Over[A].Comaximal a b].carrier)
 (M : Nat) {
 module Hm = Homotopy[l].Over[A,Aa,Ab,C,setA,setAa,setAb,setC,ia,ib,ja,jb,square,a,b,la,lb,comaximal,plus M M] ;
 module CT = Hm.CT ;
 module W = Whitehead[l].Over[C,setC,M] ;
 module WT = Whitehead[l].Over[CT.ring,CT.set,M] ;
 module MC = W.MM ;
 module IM = MatrixMap[l].Invertible[C,setC,M] ;
 module CjM = Conjugation[l].Over[C,setC,M] ;
 module K = MatrixMap[l].Over[C,CT.ring,setC,CT.set,CT.inclusion,M] ;
 module V0 = Whitehead[l].Map[CT.ring,C,CT.set,setC,Hm.LA.CT.value0,M] ;
 module E1 = Whitehead[l].Map[CT.ring,C,CT.set,setC,Hm.SC0.eval C.o,M] ;
 -- evaluating a constant matrix at 1 gives it back
 back-entry (X : MC.Mat) (i j : Fin M) : Id C.R (E1.MM.map (K.map X) i j) (X i j) =
  Hm.SC0.eval-constant C.o (X i j) ;
 back (X : MC.Mat) : Id MC.Mat (E1.MM.map (K.map X)) X = MC.mat-eq (E1.MM.map (K.map X)) X (back-entry X) ;

 module Lemma (g g' : MC.Mat) (gi : IM.Inverse[g,g']) (h h' : MC.Mat) (hi : IM.Inverse[h,h']) {
  -- the homotopy eps(T), with eps(0) = 1 and eps(1) = diag(h', h)
  eps : WT.M2.Mat =
   WT.word CT.variable (K.map h') (K.map (MC.mneg h)) (K.map h') (K.map W.m1) (K.map W.one) (K.map W.m1) ;
  eps' : WT.M2.Mat =
   WT.word' CT.variable (K.map h') (K.map (MC.mneg h)) (K.map h') (K.map W.m1) (K.map W.one) (K.map W.m1) ;
  eps-inverse : WT.I2.Inverse[eps,eps'] =
   WT.word-inverse CT.variable (K.map h') (K.map (MC.mneg h)) (K.map h') (K.map W.m1) (K.map W.one) (K.map W.m1) ;
  eps-unit : Hm.LA.Unit eps =
   trans (V0.map-word CT.variable (K.map h') (K.map (MC.mneg h)) (K.map h') (K.map W.m1) (K.map W.one) (K.map W.m1))
    (trans (ap (\ c -> W.word c (V0.MM.map (K.map h')) (V0.MM.map (K.map (MC.mneg h))) (V0.MM.map (K.map h'))
         (V0.MM.map (K.map W.m1)) (V0.MM.map (K.map W.one)) (V0.MM.map (K.map W.m1))) Hm.LA.CT.value0-variable)
     (W.word-zero _ _ _ _ _ _)) ;
  eps-one : Id W.M2.Mat (E1.M2.map eps) (W.diag h' h) =
   calc W.M2.Mat { E1.M2.map eps
     =< E1.map-word CT.variable (K.map h') (K.map (MC.mneg h)) (K.map h') (K.map W.m1) (K.map W.one) (K.map W.m1) >
        W.word ((Hm.SC0.eval C.o).1 CT.variable) (E1.MM.map (K.map h')) (E1.MM.map (K.map (MC.mneg h)))
         (E1.MM.map (K.map h')) (E1.MM.map (K.map W.m1)) (E1.MM.map (K.map W.one)) (E1.MM.map (K.map W.m1))
     =< ap (\ c -> W.word c (E1.MM.map (K.map h')) (E1.MM.map (K.map (MC.mneg h))) (E1.MM.map (K.map h'))
         (E1.MM.map (K.map W.m1)) (E1.MM.map (K.map W.one)) (E1.MM.map (K.map W.m1))) (Hm.SC0.eval-variable C.o) >
        W.word C.o (E1.MM.map (K.map h')) (E1.MM.map (K.map (MC.mneg h)))
         (E1.MM.map (K.map h')) (E1.MM.map (K.map W.m1)) (E1.MM.map (K.map W.one)) (E1.MM.map (K.map W.m1))
     =< W.word-cong C.o _ _ _ _ _ _ _ _ _ _ _ _
         (back h') (back (MC.mneg h)) (back h') (back W.m1) (back W.one) (back W.m1) >
        W.word C.o h' (MC.mneg h) h' W.m1 W.one W.m1
     =< W.word-one h' (MC.mneg h) h' W.m1 W.one W.m1 >
        W.M2.mmul (W.u h') (W.M2.mmul (W.lo (MC.mneg h)) (W.M2.mmul (W.u h')
         (W.M2.mmul (W.u W.m1) (W.M2.mmul (W.lo W.one) (W.u W.m1)))))
     =< W.whitehead h h' hi.right hi.left > W.diag h' h } ;
  -- G = diag(gh, 1), inverse G' = diag(h'g', 1)
  G : W.M2.Mat = W.diag (MC.mmul g h) W.one ;
  G' : W.M2.Mat = W.diag (MC.mmul h' g') W.one ;
  G-inverse : Hm.IC.Inverse[G,G'] =
   new Hm.IC.Inverse[G,G',
    trans (W.diag-mul (MC.mmul g h) W.one (MC.mmul h' g') W.one)
     (trans (W.B.blk-cong _ _ _ _ _ _ _ _ (CjM.sandwich g g' h' h gi.right hi.right) (refl W.zero) (refl W.zero)
       (MC.m-one-left W.one)) W.B.blk-one),
    trans (W.diag-mul (MC.mmul h' g') W.one (MC.mmul g h) W.one)
     (trans (W.B.blk-cong _ _ _ _ _ _ _ _ (CjM.sandwich h' h g g' hi.left gi.left) (refl W.zero) (refl W.zero)
       (MC.m-one-left W.one)) W.B.blk-one)] ;
  -- diag(g, h) = diag(gh, 1) diag(h', h)
  factor : Id W.M2.Mat (W.diag g h) (W.M2.mmul G (W.diag h' h)) =
   sym (trans (W.diag-mul (MC.mmul g h) W.one h' h)
    (W.B.blk-cong _ _ _ _ _ _ _ _
     (calc MC.Mat { MC.mmul (MC.mmul g h) h'
       =< sym (MC.m-mulA g h h') > MC.mmul g (MC.mmul h h')
       =< ap (MC.mmul g) hi.right > MC.mmul g W.one
       =< MC.m-one-right g > g })
     (refl W.zero) (refl W.zero) (MC.m-one-left h))) ;
  module L = Hm.Lemma[G,G',G-inverse,eps,eps',eps-inverse,eps-unit] ;
  Result : U l =
   (beta : Hm.MAb.Mat) * (beta' : Hm.MAb.Mat) * Hm.IAb.Inverse[beta,beta'] *
   (alpha : Hm.MAa.Mat) * (alpha' : Hm.MAa.Mat) * Hm.IAa.Inverse[alpha,alpha'] *
   Id W.M2.Mat (W.diag g h) (W.M2.mmul (W.M2.mmul (Hm.JB.map beta) G) (Hm.JA.map alpha)) ;
  equation (beta : Hm.MAb.Mat) (alpha : Hm.MAa.Mat)
   (e : Id W.M2.Mat (W.M2.mmul G (E1.M2.map eps)) (W.M2.mmul (W.M2.mmul (Hm.JB.map beta) G) (Hm.JA.map alpha))) :
   Id W.M2.Mat (W.diag g h) (W.M2.mmul (W.M2.mmul (Hm.JB.map beta) G) (Hm.JA.map alpha)) =
   trans factor (trans (ap (W.M2.mmul G) (sym eps-one)) e) ;
  convert (r : L.Result) : Result =
   (r.1,r.2.1,r.2.2.1,r.2.2.2.1,r.2.2.2.2.1,r.2.2.2.2.2.1,equation r.1 r.2.2.2.1 r.2.2.2.2.2.2) ;
  theorem : Tr.Trunc[Result].carrier = TC.map L.Result Result convert L.theorem ;
 } ;
} ;
