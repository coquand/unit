-- Vectors over Fin (M + M) by halves (BLOCKS).  cat u u' has u on the left
-- indices and u' on the right ones; the halves of cat u u' are u and u',
-- a vector is cat of its halves, and two vectors are equal when their
-- halves are.  A block matrix acts by halves,
--     (blk a b c d w)_l = a w_l + b w_r,     (blk a b c d w)_r = c w_l + d w_r,
-- so diag(a, d) acts as a on the left half and as d on the right one.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (M : Nat) {
 module L = RL[R] ;
 module S = FiniteIdeal[l].Sums[R] ;
 module B = Blocks[l].Over[R,setR,M] ;
 module V = Vectors[l].Over[R,setR,M] ;
 module V2 = Vectors[l].Over[R,setR,plus M M] ;
 lhalf (w : V2.Vec) : V.Vec = \ i -> w (B.il i) ;
 rhalf (w : V2.Vec) : V.Vec = \ i -> w (B.ir i) ;
 choose (u u' : V.Vec) : B.Side -> R.R = split { inl i -> u i ; inr i -> u' i } ;
 cat (u u' : V.Vec) : V2.Vec = \ x -> choose u u' (Blocks[l].side M M x) ;
 cat-l (u u' : V.Vec) (i : Fin M) : Id R.R (cat u u' (B.il i)) (u i) =
  ap (choose u u') (Blocks[l].side-injl M M i) ;
 cat-r (u u' : V.Vec) (i : Fin M) : Id R.R (cat u u' (B.ir i)) (u' i) =
  ap (choose u u') (Blocks[l].side-injr M M i) ;
 -- equality by halves
 module Halves (w w' : V2.Vec) (hl : (i : Fin M) -> Id R.R (w (B.il i)) (w' (B.il i)))
  (hr : (i : Fin M) -> Id R.R (w (B.ir i)) (w' (B.ir i))) {
  at-join : (e : B.Side) -> Id R.R (w (Blocks[l].join M M e)) (w' (Blocks[l].join M M e)) = split {
   inl i -> hl i ; inr i -> hr i } ;
  entry (x : Fin (plus M M)) : Id R.R (w x) (w' x) =
   trans (sym (ap w (Blocks[l].join-side M M x)))
    (trans (at-join (Blocks[l].side M M x)) (ap w' (Blocks[l].join-side M M x))) ;
  equal : Id V2.Vec w w' = V2.vec-eq w w' entry ;
 } ;
 lhalf-cat (u u' : V.Vec) : Id V.Vec (lhalf (cat u u')) u = V.vec-eq (lhalf (cat u u')) u (cat-l u u') ;
 rhalf-cat (u u' : V.Vec) : Id V.Vec (rhalf (cat u u')) u' = V.vec-eq (rhalf (cat u u')) u' (cat-r u u') ;
 cat-halves (w : V2.Vec) : Id V2.Vec (cat (lhalf w) (rhalf w)) w =
  Halves[cat (lhalf w) (rhalf w),w,cat-l (lhalf w) (rhalf w),cat-r (lhalf w) (rhalf w)].equal ;
 -- the zero matrix acts as zero
 act-mzero-at (u : V.Vec) (i : Fin M) : Id R.R (V.act V.MR.mzero u i) R.z =
  trans (S.sum-cong M (\ k -> R.mul R.z (u k)) (\ k -> R.z) (\ k -> L.zero-mul (u k))) (S.sum-zero M) ;
 act-l (a b c d : V.MR.Mat) (w : V2.Vec) (i : Fin M) :
  Id R.R (V2.act (B.blk a b c d) w (B.il i)) (R.add (V.act a (lhalf w) i) (V.act b (rhalf w) i)) =
  trans (B.SP.sum-plus M M (\ k -> R.mul (B.blk a b c d (B.il i) k) (w k)))
   (cong2 R.R R.add _ _ _ _
    (S.sum-cong M (\ k -> R.mul (B.blk a b c d (B.il i) (B.il k)) (w (B.il k))) (\ k -> R.mul (a i k) (w (B.il k)))
     (\ k -> ap (\ t -> R.mul t (w (B.il k))) (B.at-ll a b c d i k)))
    (S.sum-cong M (\ k -> R.mul (B.blk a b c d (B.il i) (B.ir k)) (w (B.ir k))) (\ k -> R.mul (b i k) (w (B.ir k)))
     (\ k -> ap (\ t -> R.mul t (w (B.ir k))) (B.at-lr a b c d i k)))) ;
 act-r (a b c d : V.MR.Mat) (w : V2.Vec) (i : Fin M) :
  Id R.R (V2.act (B.blk a b c d) w (B.ir i)) (R.add (V.act c (lhalf w) i) (V.act d (rhalf w) i)) =
  trans (B.SP.sum-plus M M (\ k -> R.mul (B.blk a b c d (B.ir i) k) (w k)))
   (cong2 R.R R.add _ _ _ _
    (S.sum-cong M (\ k -> R.mul (B.blk a b c d (B.ir i) (B.il k)) (w (B.il k))) (\ k -> R.mul (c i k) (w (B.il k)))
     (\ k -> ap (\ t -> R.mul t (w (B.il k))) (B.at-rl a b c d i k)))
    (S.sum-cong M (\ k -> R.mul (B.blk a b c d (B.ir i) (B.ir k)) (w (B.ir k))) (\ k -> R.mul (d i k) (w (B.ir k)))
     (\ k -> ap (\ t -> R.mul t (w (B.ir k))) (B.at-rr a b c d i k)))) ;
 diag-l (a d : V.MR.Mat) (w : V2.Vec) (i : Fin M) :
  Id R.R (V2.act (B.blk a V.MR.mzero V.MR.mzero d) w (B.il i)) (V.act a (lhalf w) i) =
  trans (act-l a V.MR.mzero V.MR.mzero d w i)
   (trans (ap (R.add (V.act a (lhalf w) i)) (act-mzero-at (rhalf w) i)) (R.addZ (V.act a (lhalf w) i))) ;
 diag-r (a d : V.MR.Mat) (w : V2.Vec) (i : Fin M) :
  Id R.R (V2.act (B.blk a V.MR.mzero V.MR.mzero d) w (B.ir i)) (V.act d (rhalf w) i) =
  trans (act-r a V.MR.mzero V.MR.mzero d w i)
   (trans (ap (\ t -> R.add t (V.act d (rhalf w) i)) (act-mzero-at (lhalf w) i)) (L.zl (V.act d (rhalf w) i))) ;
 -- the projection on the left half, D = blk 1 0 0 0: D w = cat w_l 0
 D : V2.MR.Mat = B.blk V.MR.mone V.MR.mzero V.MR.mzero V.MR.mzero ;
 head (w : V2.Vec) : Id V2.Vec (V2.act D w) (cat (lhalf w) V.vzero) =
  Halves[V2.act D w,cat (lhalf w) V.vzero,
   \ i -> trans (diag-l V.MR.mone V.MR.mzero w i) (trans (V.entry _ _ (V.act-one (lhalf w)) i) (sym (cat-l (lhalf w) V.vzero i))),
   \ i -> trans (diag-r V.MR.mone V.MR.mzero w i) (trans (act-mzero-at (rhalf w) i) (sym (cat-r (lhalf w) V.vzero i)))].equal ;
 head-cat (u : V.Vec) : Id V2.Vec (V2.act D (cat u V.vzero)) (cat u V.vzero) =
  trans (head (cat u V.vzero)) (ap (\ t -> cat t V.vzero) (lhalf-cat u V.vzero)) ;
 head-head (w : V2.Vec) : Id V2.Vec (V2.act D (V2.act D w)) (V2.act D w) =
  trans (ap (V2.act D) (head w)) (trans (head-cat (lhalf w)) (sym (head w))) ;
} ;
-- a ring map commutes with cat, and sends D to D
module Map (X Y : CRing) (setX : Pr.isSet X.R) (setY : Pr.isSet Y.R) (f : RingHom[l].Hom X Y) (M : Nat) {
 module BX = Over[X,setX,M] ;
 module BY = Over[Y,setY,M] ;
 module F1 = Vectors[l].Map[X,Y,setX,setY,f,M] ;
 module F2 = Vectors[l].Map[X,Y,setX,setY,f,plus M M] ;
 module BM = Blocks[l].Map[X,Y,setX,setY,f,M] ;
 map-cat (u u' : BX.V.Vec) : Id BY.V2.Vec (F2.map (BX.cat u u')) (BY.cat (F1.map u) (F1.map u')) =
  BY.Halves[F2.map (BX.cat u u'),BY.cat (F1.map u) (F1.map u'),
   \ i -> trans (ap f.1 (BX.cat-l u u' i)) (sym (BY.cat-l (F1.map u) (F1.map u') i)),
   \ i -> trans (ap f.1 (BX.cat-r u u' i)) (sym (BY.cat-r (F1.map u) (F1.map u') i))].equal ;
 map-D : Id BY.V2.MR.Mat (F2.MM.map BX.D) BY.D =
  trans (BM.map-blk BX.V.MR.mone BX.V.MR.mzero BX.V.MR.mzero BX.V.MR.mzero)
   (BY.B.blk-cong _ _ _ _ _ _ _ _ F1.MM.map-one F1.MM.map-zero F1.MM.map-zero F1.MM.map-zero) ;
} ;
