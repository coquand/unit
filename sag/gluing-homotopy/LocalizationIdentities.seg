-- Generated by localization_identities.py; the longer proofs (trans-*, add-respect-*,
-- mul-respect, add-assoc, add-comm, mul-assoc, distributive) rewritten by hand;
-- all proofs use only CRing laws.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Laws (Rg : CRing) {
 open Rg ; open RL[Rg] ;
 -- (x y) w = (x w) y
 swap-right (x y w : R) : Id R (mul (mul x y) w) (mul (mul x w) y) =
  trans (sym (mulA x y w)) (trans (ap (mul x) (mulC y w)) (mulA x w y)) ;
 -- (x (y z)) w = (x y)(w z)
 regroup (x y z w : R) : Id R (mul (mul x (mul y z)) w) (mul (mul x y) (mul w z)) =
  trans (ap (\ u -> mul u w) (mulA x y z))
   (trans (sym (mulA (mul x y) z w)) (ap (mul (mul x y)) (mulC z w))) ;
 trans-left (u v t a r : R) : Id R (mul (mul (mul u v) t) (mul a r)) (mul (mul v r) (mul u (mul a t))) = calc R {
  mul (mul (mul u v) t) (mul a r)
   =< ap (\ x -> mul x (mul a r)) (swap-right u v t) > mul (mul (mul u t) v) (mul a r)
   =< mul-four (mul u t) v a r > mul (mul (mul u t) a) (mul v r)
   =< ap (\ x -> mul x (mul v r)) (sym (mulA u t a)) > mul (mul u (mul t a)) (mul v r)
   =< ap (\ x -> mul (mul u x) (mul v r)) (mulC t a) > mul (mul u (mul a t)) (mul v r)
   =< mulC (mul u (mul a t)) (mul v r) > mul (mul v r) (mul u (mul a t))
 } ;
 trans-middle (u v b s r : R) : Id R (mul (mul v r) (mul u (mul b s))) (mul (mul u s) (mul v (mul b r))) = calc R {
  mul (mul v r) (mul u (mul b s))
   =< mulC (mul v r) (mul u (mul b s)) > mul (mul u (mul b s)) (mul v r)
   =< mul-four u (mul b s) v r > mul (mul u v) (mul (mul b s) r)
   =< ap (\ x -> mul (mul u v) (mul x r)) (mulC b s) > mul (mul u v) (mul (mul s b) r)
   =< ap (mul (mul u v)) (sym (mulA s b r)) > mul (mul u v) (mul s (mul b r))
   =< sym (mul-four u s v (mul b r)) > mul (mul u s) (mul v (mul b r))
 } ;
 trans-right (u v t c s : R) : Id R (mul (mul u s) (mul v (mul c t))) (mul (mul (mul u v) t) (mul c s)) = calc R {
  mul (mul u s) (mul v (mul c t))
   =< mul-four u s v (mul c t) > mul (mul u v) (mul s (mul c t))
   =< ap (mul (mul u v)) (mul-swap s c t) > mul (mul u v) (mul c (mul s t))
   =< ap (\ x -> mul (mul u v) (mul c x)) (mulC s t) > mul (mul u v) (mul c (mul t s))
   =< ap (mul (mul u v)) (mul-swap c t s) > mul (mul u v) (mul t (mul c s))
   =< mulA (mul u v) t (mul c s) > mul (mul (mul u v) t) (mul c s)
 } ;
 add-respect-left (u v a b s t r q : R) : Id R (mul (mul u v) (mul (add (mul a t) (mul b s)) (mul r q))) (add (mul (mul (mul v t) q) (mul u (mul a r))) (mul (mul (mul u s) r) (mul v (mul b q)))) = calc R {
  mul (mul u v) (mul (add (mul a t) (mul b s)) (mul r q))
   =< ap (mul (mul u v)) (dist-left (mul a t) (mul b s) (mul r q))
   > mul (mul u v) (add (mul (mul a t) (mul r q)) (mul (mul b s) (mul r q)))
   =< dist (mul u v) (mul (mul a t) (mul r q)) (mul (mul b s) (mul r q))
   > add (mul (mul u v) (mul (mul a t) (mul r q))) (mul (mul u v) (mul (mul b s) (mul r q)))
   =< ap (\ x -> add (mul (mul u v) x) (mul (mul u v) (mul (mul b s) (mul r q)))) (mul-four a t r q)
   > add (mul (mul u v) (mul (mul a r) (mul t q))) (mul (mul u v) (mul (mul b s) (mul r q)))
   =< ap (\ x -> add x (mul (mul u v) (mul (mul b s) (mul r q)))) (mul-four u v (mul a r) (mul t q))
   > add (mul (mul u (mul a r)) (mul v (mul t q))) (mul (mul u v) (mul (mul b s) (mul r q)))
   =< ap (\ x -> add x (mul (mul u v) (mul (mul b s) (mul r q)))) (mulC (mul u (mul a r)) (mul v (mul t q)))
   > add (mul (mul v (mul t q)) (mul u (mul a r))) (mul (mul u v) (mul (mul b s) (mul r q)))
   =< ap (\ x -> add (mul x (mul u (mul a r))) (mul (mul u v) (mul (mul b s) (mul r q)))) (mulA v t q)
   > add (mul (mul (mul v t) q) (mul u (mul a r))) (mul (mul u v) (mul (mul b s) (mul r q)))
   =< ap (\ x -> add (mul (mul (mul v t) q) (mul u (mul a r))) (mul (mul u v) (mul x (mul r q)))) (mulC b s)
   > add (mul (mul (mul v t) q) (mul u (mul a r))) (mul (mul u v) (mul (mul s b) (mul r q)))
   =< ap (\ x -> add (mul (mul (mul v t) q) (mul u (mul a r))) (mul (mul u v) x)) (mul-four s b r q)
   > add (mul (mul (mul v t) q) (mul u (mul a r))) (mul (mul u v) (mul (mul s r) (mul b q)))
   =< ap (add (mul (mul (mul v t) q) (mul u (mul a r)))) (mul-four u v (mul s r) (mul b q))
   > add (mul (mul (mul v t) q) (mul u (mul a r))) (mul (mul u (mul s r)) (mul v (mul b q)))
   =< ap (\ x -> add (mul (mul (mul v t) q) (mul u (mul a r))) (mul x (mul v (mul b q)))) (mulA u s r)
   > add (mul (mul (mul v t) q) (mul u (mul a r))) (mul (mul (mul u s) r) (mul v (mul b q)))
 } ;
 add-respect-right (u v c d s t r q : R) : Id R (add (mul (mul (mul v t) q) (mul u (mul c s))) (mul (mul (mul u s) r) (mul v (mul d t)))) (mul (mul u v) (mul (add (mul c q) (mul d r)) (mul s t))) = calc R {
  add (mul (mul (mul v t) q) (mul u (mul c s))) (mul (mul (mul u s) r) (mul v (mul d t)))
   =< ap (\ x -> add (mul x (mul u (mul c s))) (mul (mul (mul u s) r) (mul v (mul d t)))) (swap-right v t q)
   > add (mul (mul (mul v q) t) (mul u (mul c s))) (mul (mul (mul u s) r) (mul v (mul d t)))
   =< ap (\ x -> add (mul (mul (mul v q) t) (mul u (mul c s))) (mul x (mul v (mul d t)))) (swap-right u s r)
   > add (mul (mul (mul v q) t) (mul u (mul c s))) (mul (mul (mul u r) s) (mul v (mul d t)))
   =< sym (add-respect-left u v c d r q s t)
   > mul (mul u v) (mul (add (mul c q) (mul d r)) (mul s t))
 } ;
 mul-respect (u v a b r q : R) : Id R (mul (mul u v) (mul (mul a b) (mul r q))) (mul (mul u (mul a r)) (mul v (mul b q))) = calc R {
  mul (mul u v) (mul (mul a b) (mul r q))
   =< ap (mul (mul u v)) (mul-four a b r q) > mul (mul u v) (mul (mul a r) (mul b q))
   =< mul-four u v (mul a r) (mul b q) > mul (mul u (mul a r)) (mul v (mul b q))
 } ;
 add-assoc (a b c s t r : R) : Id R (mul (add (mul a (mul t r)) (mul (add (mul b r) (mul c t)) s)) (mul (mul s t) r)) (mul (add (mul (add (mul a t) (mul b s)) r) (mul c (mul s t))) (mul s (mul t r))) = calc R {
  mul (add (mul a (mul t r)) (mul (add (mul b r) (mul c t)) s)) (mul (mul s t) r)
   =< ap (\ x -> mul (add (mul a (mul t r)) x) (mul (mul s t) r)) (dist-left (mul b r) (mul c t) s)
   > mul (add (mul a (mul t r)) (add (mul (mul b r) s) (mul (mul c t) s))) (mul (mul s t) r)
   =< ap (\ x -> mul x (mul (mul s t) r)) (addA (mul a (mul t r)) (mul (mul b r) s) (mul (mul c t) s))
   > mul (add (add (mul a (mul t r)) (mul (mul b r) s)) (mul (mul c t) s)) (mul (mul s t) r)
   =< ap (\ x -> mul (add (add x (mul (mul b r) s)) (mul (mul c t) s)) (mul (mul s t) r)) (mulA a t r)
   > mul (add (add (mul (mul a t) r) (mul (mul b r) s)) (mul (mul c t) s)) (mul (mul s t) r)
   =< ap (\ x -> mul (add (add (mul (mul a t) r) x) (mul (mul c t) s)) (mul (mul s t) r)) (swap-right b r s)
   > mul (add (add (mul (mul a t) r) (mul (mul b s) r)) (mul (mul c t) s)) (mul (mul s t) r)
   =< ap (\ x -> mul (add x (mul (mul c t) s)) (mul (mul s t) r)) (sym (dist-left (mul a t) (mul b s) r))
   > mul (add (mul (add (mul a t) (mul b s)) r) (mul (mul c t) s)) (mul (mul s t) r)
   =< ap (\ x -> mul (add (mul (add (mul a t) (mul b s)) r) x) (mul (mul s t) r)) (trans (sym (mulA c t s)) (ap (mul c) (mulC t s)))
   > mul (add (mul (add (mul a t) (mul b s)) r) (mul c (mul s t))) (mul (mul s t) r)
   =< ap (mul (add (mul (add (mul a t) (mul b s)) r) (mul c (mul s t)))) (sym (mulA s t r))
   > mul (add (mul (add (mul a t) (mul b s)) r) (mul c (mul s t))) (mul s (mul t r))
 } ;
 add-comm (a b c s t r : R) : Id R (mul (add (mul a t) (mul b s)) (mul t s)) (mul (add (mul b s) (mul a t)) (mul s t)) = calc R {
  mul (add (mul a t) (mul b s)) (mul t s)
   =< ap (\ x -> mul x (mul t s)) (addC (mul a t) (mul b s)) > mul (add (mul b s) (mul a t)) (mul t s)
   =< ap (mul (add (mul b s) (mul a t))) (mulC t s) > mul (add (mul b s) (mul a t)) (mul s t)
 } ;
 add-zero (a b c s t r : R) : Id R (mul (add (mul a o) (mul z s)) s) (mul a (mul s o)) = calc R {
  (mul (add (mul a o) (mul z s)) s)
   =< (Pr.ap R R (\ hole -> (mul (add hole (mul z s)) s)) (mul a o) a (mulO a)) > (mul (add a (mul z s)) s)
   =< (Pr.ap R R (\ hole -> (mul (add a hole) s)) (mul z s) z (zero-mul s)) > (mul (add a z) s)
   =< (Pr.ap R R (\ hole -> (mul hole s)) (add a z) a (addZ a)) > (mul a s)
   =< (sym (Pr.ap R R (\ hole -> (mul a hole)) (mul s o) s (mulO s))) > (mul a (mul s o))
 } ;
 mul-assoc (a b c s t r : R) : Id R (mul (mul a (mul b c)) (mul (mul s t) r)) (mul (mul (mul a b) c) (mul s (mul t r))) = calc R {
  mul (mul a (mul b c)) (mul (mul s t) r)
   =< ap (\ x -> mul x (mul (mul s t) r)) (mulA a b c) > mul (mul (mul a b) c) (mul (mul s t) r)
   =< ap (mul (mul (mul a b) c)) (sym (mulA s t r)) > mul (mul (mul a b) c) (mul s (mul t r))
 } ;
 mul-comm (a b c s t r : R) : Id R (mul (mul a b) (mul t s)) (mul (mul b a) (mul s t)) = calc R {
  (mul (mul a b) (mul t s))
   =< (sym (mulA a b (mul t s))) > (mul a (mul b (mul t s)))
   =< (Pr.ap R R (\ hole -> (mul a (mul b hole))) (mul t s) (mul s t) (mulC t s)) > (mul a (mul b (mul s t)))
   =< (sym (mul-swap b a (mul s t))) > (mul b (mul a (mul s t)))
   =< (sym (sym (mulA b a (mul s t)))) > (mul (mul b a) (mul s t))
 } ;
 mul-one (a b c s t r : R) : Id R (mul (mul a o) s) (mul a (mul s o)) = calc R {
  (mul (mul a o) s)
   =< (Pr.ap R R (\ hole -> (mul hole s)) (mul a o) a (mulO a)) > (mul a s)
   =< (sym (Pr.ap R R (\ hole -> (mul a hole)) (mul s o) s (mulO s))) > (mul a (mul s o))
 } ;
 distributive (a b c s t r : R) : Id R (mul (mul a (add (mul b r) (mul c t))) (mul (mul s t) (mul s r))) (mul (add (mul (mul a b) (mul s r)) (mul (mul a c) (mul s t))) (mul s (mul t r))) = calc R {
  mul (mul a (add (mul b r) (mul c t))) (mul (mul s t) (mul s r))
   =< ap (mul (mul a (add (mul b r) (mul c t)))) (trans (sym (mulA s t (mul s r))) (ap (mul s) (mul-swap t s r)))
   > mul (mul a (add (mul b r) (mul c t))) (mul s (mul s (mul t r)))
   =< mulA (mul a (add (mul b r) (mul c t))) s (mul s (mul t r))
   > mul (mul (mul a (add (mul b r) (mul c t))) s) (mul s (mul t r))
   =< ap (\ x -> mul (mul x s) (mul s (mul t r))) (dist a (mul b r) (mul c t))
   > mul (mul (add (mul a (mul b r)) (mul a (mul c t))) s) (mul s (mul t r))
   =< ap (\ x -> mul x (mul s (mul t r))) (dist-left (mul a (mul b r)) (mul a (mul c t)) s)
   > mul (add (mul (mul a (mul b r)) s) (mul (mul a (mul c t)) s)) (mul s (mul t r))
   =< ap (\ x -> mul (add x (mul (mul a (mul c t)) s)) (mul s (mul t r))) (regroup a b r s)
   > mul (add (mul (mul a b) (mul s r)) (mul (mul a (mul c t)) s)) (mul s (mul t r))
   =< ap (\ x -> mul (add (mul (mul a b) (mul s r)) x) (mul s (mul t r))) (regroup a c t s)
   > mul (add (mul (mul a b) (mul s r)) (mul (mul a c) (mul s t))) (mul s (mul t r))
 } ;
 constant-add (a b c s t r : R) : Id R (mul (add a b) (mul o o)) (mul (add (mul a o) (mul b o)) o) = calc R {
  (mul (add a b) (mul o o))
   =< (Pr.ap R R (\ hole -> (mul (add a b) hole)) (mul o o) o (mulO o)) > (mul (add a b) o)
   =< (mulO (add a b)) > (add a b)
   =< (sym (mulO (add a b))) > (mul (add a b) o)
   =< (sym (Pr.ap R R (\ hole -> (mul (add a hole) o)) (mul b o) b (mulO b))) > (mul (add a (mul b o)) o)
   =< (sym (Pr.ap R R (\ hole -> (mul (add hole (mul b o)) o)) (mul a o) a (mulO a))) > (mul (add (mul a o) (mul b o)) o)
 } ;
 constant-mul (a b c s t r : R) : Id R (mul (mul a b) (mul o o)) (mul (mul a b) o) = calc R {
  (mul (mul a b) (mul o o))
   =< (Pr.ap R R (\ hole -> (mul (mul a b) hole)) (mul o o) o (mulO o)) > (mul (mul a b) o)
   =< (mulO (mul a b)) > (mul a b)
   =< (sym (mulO (mul a b))) > (mul (mul a b) o)
 } ;
 inverse (a b c s t r : R) : Id R (mul (mul a o) o) (mul o (mul o a)) = calc R {
  (mul (mul a o) o)
   =< (Pr.ap R R (\ hole -> (mul hole o)) (mul a o) a (mulO a)) > (mul a o)
   =< (mulO a) > a
   =< (sym (trans (mulC o a) (mulO a))) > (mul o a)
   =< (sym (Pr.ap R R (\ hole -> (mul o hole)) (mul o a) a (trans (mulC o a) (mulO a)))) > (mul o (mul o a))
 } ;
} ;
