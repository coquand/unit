-- Functions out of Fin 0 form a singleton. Splitting off the first
-- value identifies functions out of Fin (n+1) with a finite product.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module FC = FiniteClosure[l] ;
module Fi = Finite[l] ;
module Values (X : U l) {
 empty-fun : Fin zero -> X = absurd X ;
 empty-equiv : Equiv (Fin zero -> X) Top =
  ((\ f -> tt), qinv (Fin zero -> X) Top (\ f -> tt) (\ t -> empty-fun) (\ t -> isTop tt t)
   (\ f -> F.funext (Fin zero) (\ i -> X) empty-fun f (fin-zero (\ i -> Id X (empty-fun i) (f i))))) ;
 parts (n : Nat) (f : Fin (suc n) -> X) : X * (Fin n -> X) = (f none, \ i -> f (some i)) ;
 assemble (n : Nat) (v : X * (Fin n -> X)) : Fin (suc n) -> X = combine n (\ i -> X) v.1 v.2 ;
 restore (n : Nat) (f : Fin (suc n) -> X) : Id (Fin (suc n) -> X) (assemble n (parts n f)) f =
  F.funext (Fin (suc n)) (\ i -> X) _ f
   (combine n (\ i -> Id X (assemble n (parts n f) i) (f i)) (refl (f none)) (\ i -> refl (f (some i)))) ;
 split-equiv (n : Nat) : Equiv (Fin (suc n) -> X) (X * (Fin n -> X)) =
  (parts n, qinv (Fin (suc n) -> X) (X * (Fin n -> X)) (parts n) (assemble n) (\ v -> refl v) (restore n)) ;
 finite (fX : Fi.isFinite X) : (n : Nat) -> Fi.isFinite (Fin n -> X) = split {
  zero -> FC.finite-equiv (Fin zero -> X) Top empty-equiv FC.top-finite ;
  suc n | ih -> FC.finite-equiv (Fin (suc n) -> X) (X * (Fin n -> X)) (split-equiv n)
   (FiniteFacts[l].product-finite X (Fin n -> X) fX ih) } ;
} ;
