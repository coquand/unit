-- Every vector is the sum of its weighted basis vectors, by evaluation
-- at each coordinate. Thus two linear maps agreeing on the basis agree
-- everywhere. In particular the fibre-sum maps compose along the tower.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module A = Alg73[l] ;
module Over (R : A.CRing) {
 module V = FinSum[l].Vectors[R] ; module RM = RModule[l].Over[R] ;
 module G = Measures[l].Stage[R] ;
 module Basis (n : Nat) {
  module VS = A.MA[R,V.stage n] ;
  module P = RM.PiModule[Fin n,\ i -> V.Reg.reg] ;
  term (u : V.Vec n) (i : Fin n) : V.Vec n = (V.stage n).sm (u i) (V.basis n i) ;
  coordinate (u : V.Vec n) (y : Fin n) : Id R.R (V.S.sumM n (\ i -> term u i y)) (u y) =
   transH (V.Z.single n (\ i -> term u i y) y
     (\ i ne -> transH (apH (R.mul (u i)) (V.basis-off n i y ne)) (V.L.mul-zero (u i))))
    (transH (apH (R.mul (u y)) (V.basis-at n y)) (R.mulO (u y))) ;
  expansion (u : V.Vec n) : Id (V.Vec n) (VS.sumM n (term u)) u =
   P.ext _ _ (\ y -> transH (FinSum[l].MapSum[R,V.stage n,V.Reg.reg,P.eval y].map-sum n (term u)) (coordinate u y)) ;

  module Into (N : A.Mod[R]) {
   module H = RM.Maps[V.stage n,N] ; module S = A.MA[R,N] ;
   by-values (f : H.Hom) (u : V.Vec n) : Id N.M (f.1 u) (S.sumM n (\ i -> N.sm (u i) (f.1 (V.basis n i)))) =
    transH (apH f.1 (symH (expansion u))) (transH (FinSum[l].MapSum[R,V.stage n,N,f].map-sum n (term u))
     (S.sum-ext n (\ i -> f.1 (term u i)) (\ i -> N.sm (u i) (f.1 (V.basis n i))) (\ i -> f.2.2 (u i) (V.basis n i)))) ;
   agree (f g : H.Hom) (h : (i : Fin n) -> Id N.M (f.1 (V.basis n i)) (g.1 (V.basis n i))) (u : V.Vec n) :
    Id N.M (f.1 u) (g.1 u) = transH (by-values f u)
     (transH (S.sum-ext n (\ i -> N.sm (u i) (f.1 (V.basis n i))) (\ i -> N.sm (u i) (g.1 (V.basis n i)))
       (\ i -> apH (N.sm (u i)) (h i))) (symH (by-values g u))) ;
  } ;
 } ;
 identity (n : Nat) : RM.Maps[V.stage n,V.stage n].Hom =
  ((\ u -> u), (\ u v -> refl ((V.stage n).madd u v)), \ a u -> refl ((V.stage n).sm a u)) ;
 push-id (n : Nat) : (u : V.Vec n) -> Id (V.Vec n) (G.Along[n,n,\ i -> i].push u) u =
  Basis[n].Into[V.stage n].agree G.Along[n,n,\ i -> i].linear (identity n) G.Along[n,n,\ i -> i].push-basis ;
 module Composite (a b c : Nat) (p : Fin a -> Fin b) (q : Fin b -> Fin c) {
  module P = G.Along[a,b,p] ; module Q = G.Along[b,c,q] ; module PQ = G.Along[a,c,\ x -> q (p x)] ;
  law : (u : V.Vec a) -> Id (V.Vec c) (PQ.push u) (Q.push (P.push u)) =
   Basis[a].Into[V.stage c].agree PQ.linear (RM.compose (V.stage a) (V.stage b) (V.stage c) Q.linear P.linear)
    (\ i -> transH (PQ.push-basis i) (symH (transH (apH Q.push (P.push-basis i)) (Q.push-basis (p i))))) ;
 } ;
} ;

module Tower (K : FiniteRing[l].Coeff) (c : Nat -> Nat) (p : (n : Nat) -> Fin (c (suc n)) -> Fin (c n)) {
 module D = Measures[l].Tower[K,c,p] ; module B = Over[D.C.scalars] ;
 module NA = NatArith[l] ;
 module From (n : Nat) {
  later (d : Nat) : Nat = NA.plus d n ;
  down : (d : Nat) -> D.P.E (later d) -> D.P.E n = FiniteCode[l].down D.P.E p n ;
  push (d : Nat) : D.V.Vec (c (later d)) -> D.V.Vec (c n) = D.G.Along[c (later d),c n,down d].push ;
  compatible (u : D.M.L.lim) : (d : Nat) -> Id (D.V.Vec (c n)) (push d (u.1 (later d))) (u.1 n) = split {
   zero -> B.push-id (c n) (u.1 n) ;
   suc d | ih -> transH (B.Composite[c (suc (later d)),c (later d),c n,p (later d),down d].law (u.1 (suc (later d))))
    (transH (apH (push d) (u.2 (later d))) ih) } ;
 } ;
} ;
