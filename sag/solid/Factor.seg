-- Code an R-valued map into N and take a colimit representative using
-- Corollary 3.7. Decoding that representative gives a total stage map,
-- even at stage points which do not extend to a point of the limit.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Fi = Finite[l] ; module SA = StoneAxioms[l,l] ;

-- The canonical colimit map on the class of a stage function.
module Natural (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) {
 module M = Cor37[l,l].Maps[E,p] ;
 stage-value (n : Nat) (g : E n -> Nat) : Id (M.Lim -> Nat) (M.phi (M.CN.inc n g)) (M.restrict n g) = M.R.beta n g ;
} ;

module Stages (K : FiniteRing[l].Coeff) (E : Nat -> U l) (p : (n : Nat) -> E (suc n) -> E n) {
 module M = Cor37[l,l].Maps[E,p] ;
 module C = FiniteRing[l].Over[K] ;
 record Through (f : M.Lim -> K.ring.R) {
  n : Nat ;
  at : E n -> K.ring.R ;
  agrees (x : M.Lim) : Id K.ring.R (f x) (at (x.1 n)) ;
 } ;
 module ForMap (f : M.Lim -> K.ring.R) {
  coded (x : M.Lim) : Nat = C.code (f x) ;
  representative (n : Nat) (g : E n -> Nat) (e : Id (M.Lim -> Nat) (M.phi (M.CN.inc n g)) coded) : Through[f] =
   new Through[f,n,\ y -> C.decode (g y),\ x -> transH (symH (C.decode-code (f x)))
    (apH C.decode (happly M.Lim (\ x -> Nat) coded (M.restrict n g) (transH (symH e) (Natural[E,p].stage-value n g)) x))] ;
  from-class (u : M.CN.colim) (h : Id (M.Lim -> Nat) (M.phi u) coded) : T.Trunc[Through[f]].carrier =
   TC.map ((v : M.CN.Tot) * Id M.CN.colim (M.CN.cls v) u) Through[f]
    (\ w -> representative w.1.1 w.1.2 (transH (apH M.phi w.2) h)) (M.CN.inc-surj u) ;
  factor (ax : SA.Assumptions) (fin : (n : Nat) -> Fi.isFinite (E n)) : T.Trunc[Through[f]].carrier =
   TC.bind ((u : M.CN.colim) * Id (M.Lim -> Nat) (M.phi u) coded) Through[f] (\ w -> from-class w.1 w.2)
    (Cor37[l,l].Over[ax].Cor37[E,p,fin].surjective coded) ;
 } ;
} ;

module Tower (K : FiniteRing[l].Coeff) (c : Nat -> Nat) (p : (n : Nat) -> Fin (c (suc n)) -> Fin (c n)) {
 module D = Measures[l].Tower[K,c,p] ;
 module P = Stages[K,D.P.E,p] ;
 module Q = Stages[K,D.M.seq.E,D.M.seq.p] ;
 finite-vectors (n : Nat) : Fi.isFinite (D.M.seq.E n) = FunFinite[l].Values[K.ring.R].finite D.C.finite (c n) ;
 point-factor (ax : SA.Assumptions) (g : D.P.X.lim -> K.ring.R) : T.Trunc[P.Through[g]].carrier =
  P.ForMap[g].factor ax D.P.finite ;
 measure-factor (ax : SA.Assumptions) (f : D.M.L.lim -> K.ring.R) : T.Trunc[Q.Through[f]].carrier =
  Q.ForMap[f].factor ax finite-vectors ;
} ;
