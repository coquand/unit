-- Push a vector forward by summing each fibre. Pairing with an indicator
-- is linear and carries the point mass at x to the point mass at p(x).
-- This gives a compatible Dirac measure on the entire tower.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module A = Alg73[l] ;
module Stage (R : A.CRing) {
 module V = FinSum[l].Vectors[R] ;
 module RM = RModule[l].Over[R] ;
 module Along (m n : Nat) (p : Fin m -> Fin n) {
  weight (y : Fin n) (x : Fin m) : R.R = V.basis n (p x) y ;
  push (u : V.Vec m) (y : Fin n) : R.R = V.dot m (weight y) u ;
  linear : RM.Maps[V.stage m,V.stage n].Hom =
   (push, (\ u v -> F.funext (Fin n) (\ y -> R.R) _ _ (\ y -> (V.pair m (weight y)).2.1 u v)),
    \ a u -> F.funext (Fin n) (\ y -> R.R) _ _ (\ y -> (V.pair m (weight y)).2.2 a u)) ;
  push-basis (x : Fin m) : Id (V.Vec n) (push (V.basis m x)) (V.basis n (p x)) =
   F.funext (Fin n) (\ y -> R.R) _ _ (\ y -> V.dot-basis m (weight y) x) ;
 } ;
} ;

module PointTower (c : Nat -> Nat) (p : (n : Nat) -> Fin (c (suc n)) -> Fin (c n)) {
 E (n : Nat) : U l = Fin (c n) ;
 points : SeqLim[l].InvSeq = new SeqLim[l].InvSeq[E,p] ;
 module X = SeqLim[l].Limit[points] ;
 finite (n : Nat) : Finite[l].isFinite (E n) = FiniteClosure[l].fin-finite (c n) ;
} ;

module Tower (K : FiniteRing[l].Coeff) (c : Nat -> Nat) (p : (n : Nat) -> Fin (c (suc n)) -> Fin (c n)) {
 module C = FiniteRing[l].Over[K] ;
 module V = FinSum[l].Vectors[C.scalars] ;
 module G = Stage[C.scalars] ;
 module RM = RModule[l].Over[C.scalars] ;
 module P = PointTower[c,p] ;
 B (n : Nat) : A.Mod[C.scalars] = V.stage (c n) ;
 transition (n : Nat) : RM.Maps[B (suc n),B n].Hom = G.Along[c (suc n),c n,p n].linear ;
 module M = ModuleLimit[l].Inverse[C.scalars,B,transition] ;
 dirac (x : P.X.lim) : M.L.lim = (\ n -> V.basis (c n) (P.X.proj n x),
  \ n -> transH (G.Along[c (suc n),c n,p n].push-basis (P.X.proj (suc n) x))
   (apH (V.basis (c n)) (P.X.compat n x))) ;
 project-dirac (n : Nat) (x : P.X.lim) :
  Id (V.Vec (c n)) ((M.projection n).1 (dirac x)) (V.basis (c n) (P.X.proj n x)) = refl (V.basis (c n) (P.X.proj n x)) ;
 opaque dirac ;
 -- Solidity relative to this presentation is the Dirac restriction equivalence.
 module Restriction (N : A.Mod[C.scalars]) {
  module H = RM.Maps[M.limit-module,N] ;
  restrict (f : H.Hom) (x : P.X.lim) : N.M = f.1 (dirac x) ;
  Solid : U l = isEquiv H.Hom (P.X.lim -> N.M) restrict ;
 } ;
} ;
