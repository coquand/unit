-- Modules and their finite sums come from Alg73. Linearity is a property
-- of a function between sets, so equality of homomorphisms is pointwise.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module A = Alg73[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

module Over (R : A.CRing) {
 module Maps (M N : A.Mod[R]) {
  Additive (f : M.M -> N.M) : U l = (x y : M.M) -> Id N.M (f (M.madd x y)) (N.madd (f x) (f y)) ;
  Scalar (f : M.M -> N.M) : U l = (a : R.R) (x : M.M) -> Id N.M (f (M.sm a x)) (N.sm a (f x)) ;
  Linear (f : M.M -> N.M) : U l = Additive f * Scalar f ;
  linear-prop (f : M.M -> N.M) : isProp (Linear f) = isProp-Sigma (Additive f) (\ h -> Scalar f)
   (F.isProp-Pi M.M (\ x -> (y : M.M) -> Id N.M (f (M.madd x y)) (N.madd (f x) (f y)))
    (\ x -> F.isProp-Pi M.M (\ y -> Id N.M (f (M.madd x y)) (N.madd (f x) (f y))) (\ y -> N.setM _ _)))
   (\ h -> F.isProp-Pi R.R (\ a -> (x : M.M) -> Id N.M (f (M.sm a x)) (N.sm a (f x)))
    (\ a -> F.isProp-Pi M.M (\ x -> Id N.M (f (M.sm a x)) (N.sm a (f x))) (\ x -> N.setM _ _))) ;
  Hom : U l = (f : M.M -> N.M) * Linear f ;
  set : isSet Hom = Torsor[l].isSet-sub (M.M -> N.M) Linear (F.isSet-Pi M.M (\ x -> N.M) (\ x -> N.setM)) linear-prop ;
  ext (f g : Hom) (h : (x : M.M) -> Id N.M (f.1 x) (g.1 x)) : Id Hom f g =
   Sigma-eq (M.M -> N.M) Linear f.1 g.1 f.2 g.2 (F.funext M.M (\ x -> N.M) f.1 g.1 h) (linear-prop g.1) ;
  map-zero (f : Hom) : Id N.M (f.1 M.mz) N.mz =
   A.MA[R,N].madd-cancel (f.1 M.mz) (f.1 M.mz)
    (transH (symH (f.2.1 M.mz M.mz)) (apH f.1 (M.maddZ M.mz))) ;
  map-neg (f : Hom) (x : M.M) : Id N.M (f.1 (M.mneg x)) (N.mneg (f.1 x)) =
   A.MA[R,N].mneg-uniq (f.1 x) (f.1 (M.mneg x))
    (transH (symH (f.2.1 x (M.mneg x))) (transH (apH f.1 (M.maddN x)) (map-zero f))) ;
  zero : Hom = (\ x -> N.mz, (\ x y -> symH (N.maddZ N.mz)), \ a x -> symH (A.MA[R,N].sm-zr a)) ;
 } ;

 compose (M N P : A.Mod[R]) (g : Maps[N,P].Hom) (f : Maps[M,N].Hom) : Maps[M,P].Hom =
  (\ x -> g.1 (f.1 x),
   (\ x y -> transH (apH g.1 (f.2.1 x y)) (g.2.1 (f.1 x) (f.1 y))),
   \ a x -> transH (apH g.1 (f.2.2 a x)) (g.2.2 a (f.1 x))) ;

 -- All operations on a product are pointwise.
 module PiModule (X : U l) (B : X -> A.Mod[R]) {
  V : U l = (x : X) -> (B x).M ;
  ext (u v : V) : ((x : X) -> Id (B x).M (u x) (v x)) -> Id V u v =
   F.funext X (\ x -> (B x).M) u v ;
  product : A.Mod[R] = new A.Mod[R,V,F.isSet-Pi X (\ x -> (B x).M) (\ x -> (B x).setM),
   \ x -> (B x).mz, \ u v x -> (B x).madd (u x) (v x), \ u x -> (B x).mneg (u x),
   \ u v w -> ext _ _ (\ x -> (B x).maddA (u x) (v x) (w x)),
   \ u v -> ext _ _ (\ x -> (B x).maddC (u x) (v x)), \ u -> ext _ _ (\ x -> (B x).maddZ (u x)),
   \ u -> ext _ _ (\ x -> (B x).maddN (u x)), \ a u x -> (B x).sm a (u x),
   \ a b u -> ext _ _ (\ x -> (B x).smA a b (u x)), \ u -> ext _ _ (\ x -> (B x).smO (u x)),
   \ a u v -> ext _ _ (\ x -> (B x).smD a (u x) (v x)), \ a b u -> ext _ _ (\ x -> (B x).smE a b (u x))] ;
  eval (x : X) : Maps[product,B x].Hom = (\ u -> u x, (\ u v -> refl ((B x).madd (u x) (v x))), \ a u -> refl ((B x).sm a (u x))) ;
 } ;
} ;
