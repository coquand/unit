-- Enumerate the coefficient ring. Its index in N has a total decoder
-- obtained by extending the inverse enumeration by zero.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ; open Logic[l] ;
module FC = FiniteClosure[l] ;
module FN = FreeCountable[l] ;
record Coeff {
 ring : Ring[l].CRing ;
 size : Nat ;
 enum : Equiv ring.R (Fin size) ;
} ;

extend (X : U l) (z : X) : (n : Nat) -> (Fin n -> X) -> Nat -> X = split {
 zero -> \ f j -> z ;
 suc n | ih -> \ f -> split { zero -> f none ; suc j -> ih (\ i -> f (some i)) j } } ;
extend-index (X : U l) (z : X) : (n : Nat) (f : Fin n -> X) (i : Fin n) ->
 Id X (extend X z n f (FN.index n i)) (f i) = split {
 zero -> \ f -> fin-zero (\ i -> Id X z (f i)) ;
 suc n | ih -> \ f -> split { none -> refl (f none) ; some i -> ih (\ j -> f (some j)) i } } ;

pull-dec (X Y : U l) (f : X -> Y) (inj : Bijection[l].Injective f) (a b : X) :
 Dec (Id Y (f a) (f b)) -> Dec (Id X a b) = split {
 yes p -> yes (inj a b p) ; no h -> no (\ p -> h (apH f p)) } ;
fin-dec (n : Nat) (a b : Fin n) : Dec (Id (Fin n) a b) =
 pull-dec (Fin n) Nat (FN.index n) (FinBool[l].index-inj n) a b
  (Integers[l].nat-dec (FN.index n a) (FN.index n b)) ;

module Over (K : Coeff) {
 finite : Finite[l].isFinite K.ring.R = Truncation[l].Trunc[Finite[l].FinEquiv K.ring.R].inc (K.size,K.enum) ;
 setR : isSet K.ring.R = FC.finite-set K.ring.R finite ;
 dec (a b : K.ring.R) : Dec (Id K.ring.R a b) = pull-dec K.ring.R (Fin K.size) K.enum.1
  (Equivalences[l].injective K.ring.R (Fin K.size) K.enum.1 K.enum.2) a b (fin-dec K.size (K.enum.1 a) (K.enum.1 b)) ;
 code (a : K.ring.R) : Nat = FN.index K.size (K.enum.1 a) ;
 decode : Nat -> K.ring.R = extend K.ring.R K.ring.z K.size K.enum.2.sec ;
 decode-code (a : K.ring.R) : Id K.ring.R (decode (code a)) a =
  transH (extend-index K.ring.R K.ring.z K.size K.enum.2.sec (K.enum.1 a)) (sec-ret K.ring.R (Fin K.size) K.enum.1 K.enum.2 a) ;
 opaque code ; opaque decode ;
 -- The library module structure takes a ring together with its set law.
 scalars : Alg73[l].CRing = new Alg73[l].CRing[K.ring.R,setR,K.ring.z,K.ring.o,
  K.ring.add,K.ring.mul,K.ring.neg,K.ring.addA,K.ring.addC,K.ring.addZ,K.ring.addN,
  K.ring.mulA,K.ring.mulC,K.ring.mulO,K.ring.dist] ;
} ;
