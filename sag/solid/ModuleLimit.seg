-- Compatible sequences of module elements form a module under
-- componentwise operations. Projection preserves addition and scalars.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ;
module A = Alg73[l] ; module SL = SeqLim[l] ; module FN = FreeCountable[l] ;
module Inverse (R : A.CRing) (B : Nat -> A.Mod[R])
 (t : (n : Nat) -> RModule[l].Over[R].Maps[B (suc n),B n].Hom) {
 module RM = RModule[l].Over[R] ;
 seq : SL.InvSeq = new SL.InvSeq[\ n -> (B n).M, \ n -> (t n).1] ;
 module L = SL.Limit[seq] ;
 module Eq = L.Sets[\ n -> (B n).setM] ;
 zeroM : L.lim = (\ n -> (B n).mz, \ n -> RM.Maps[B (suc n),B n].map-zero (t n)) ;
 addM (u v : L.lim) : L.lim = (\ n -> (B n).madd (u.1 n) (v.1 n),
  \ n -> transH ((t n).2.1 (u.1 (suc n)) (v.1 (suc n))) (FN.cong2 (B n).madd (u.2 n) (v.2 n))) ;
 negM (u : L.lim) : L.lim = (\ n -> (B n).mneg (u.1 n),
  \ n -> transH (RM.Maps[B (suc n),B n].map-neg (t n) (u.1 (suc n))) (apH (B n).mneg (u.2 n))) ;
 scaleM (a : R.R) (u : L.lim) : L.lim = (\ n -> (B n).sm a (u.1 n),
  \ n -> transH ((t n).2.2 a (u.1 (suc n))) (apH ((B n).sm a) (u.2 n))) ;
 limit-module : A.Mod[R] = new A.Mod[R,L.lim,Eq.set,zeroM,addM,negM,
  \ u v w -> Eq.lim-eq _ _ (\ n -> (B n).maddA (u.1 n) (v.1 n) (w.1 n)),
  \ u v -> Eq.lim-eq _ _ (\ n -> (B n).maddC (u.1 n) (v.1 n)),
  \ u -> Eq.lim-eq _ _ (\ n -> (B n).maddZ (u.1 n)),
  \ u -> Eq.lim-eq _ _ (\ n -> (B n).maddN (u.1 n)),scaleM,
  \ a b u -> Eq.lim-eq _ _ (\ n -> (B n).smA a b (u.1 n)),
  \ u -> Eq.lim-eq _ _ (\ n -> (B n).smO (u.1 n)),
  \ a u v -> Eq.lim-eq _ _ (\ n -> (B n).smD a (u.1 n) (v.1 n)),
  \ a b u -> Eq.lim-eq _ _ (\ n -> (B n).smE a b (u.1 n))] ;
 projection (n : Nat) : RM.Maps[limit-module,B n].Hom =
  (L.proj n, (\ u v -> refl ((B n).madd (L.proj n u) (L.proj n v))), \ a u -> refl ((B n).sm a (L.proj n u))) ;
} ;
