-- A point reached from every later stage lies in the image of the
-- limit projection. If the limit missed it, its indicator and zero
-- would agree on the limit. Corollary 3.7 makes their stage classes
-- equal, so they agree at some later stage, contradicting persistence.
-- The projection fibre has closed inhabitation, hence is double-negation stable.
level l ;
open Base ; open Prelude[l] ; open Paths[l] ; open FinChoice[l] ; open Logic[l] ;
module T = Truncation[l] ; module TC = TruncationCombinators[l] ;
module NA = NatArith[l] ; module NO = NatOrder[l] ;
module FN = FreeCountable[l] ; module FB = FinBool[l] ;
module OC = OpenClosed[l,l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;

module Tower (ax : StoneAxioms[l,l].Assumptions) (c : Nat -> Nat) (p : (n : Nat) -> Fin (c (suc n)) -> Fin (c n)) {
 module P = Measures[l].PointTower[c,p] ;
 module M = Cor37[l,l].Maps[P.E,p] ;
 module Cor = Cor37[l,l].Over[ax].Cor37[P.E,p,P.finite] ;
 module CN = M.CN ;
 module NatMap = Factor[l].Natural[P.E,p] ;
 stone : Profinite[l,l].isStone P.X.lim = Lemma32[l,l].Over[ax].lemma32 P.E p P.finite ;
 module AtPoint (n : Nat) (y : P.E n) {
  down : (d : Nat) -> P.E (NA.plus d n) -> P.E n = FiniteCode[l].down P.E p n ;
  Fibre : U l = (x : P.X.lim) * Id (P.E n) (P.X.proj n x) y ;
  Reached (d : Nat) : U l = (a : P.E (NA.plus d n)) * Id (P.E n) (down d a) y ;
  InImage : U l = T.Trunc[Fibre].carrier ;
  closed : OC.isClosed InImage = Thm311[l].Over[ax].closed-exists P.X.lim stone
   (\ x -> Id (P.E n) (P.X.proj n x) y) (\ x -> FiniteClosure[l].fin-set (c n) (P.X.proj n x) y)
   (\ x -> OC.dec-closed (Id (P.E n) (P.X.proj n x) y) (FiniteRing[l].fin-dec (c n) (P.X.proj n x) y)) ;
  number : Bool -> Nat = split { true -> suc zero ; false -> zero } ;
  indicator (a : P.E n) : Nat = number (FB.eqFin (c n) a y) ;
  hit : Id Nat (indicator y) (suc zero) = apH number (NO.delta-self (FN.index (c n) y)) ;
  nil-map (a : P.E n) : Nat = zero ;
  module Miss (miss : Not InImage) {
   off (x : P.X.lim) : Id Nat (indicator (P.X.proj n x)) zero =
    apH number (NO.delta-ne (FN.index (c n) y) (FN.index (c n) (P.X.proj n x))
     (\ e -> miss (T.Trunc[Fibre].inc (x,FB.index-inj (c n) (P.X.proj n x) y e)))) ;
   equal : Id CN.colim (CN.inc n indicator) (CN.inc n nil-map) = Cor.injective (CN.inc n indicator) (CN.inc n nil-map)
    (transH (NatMap.stage-value n indicator) (transH (F.funext P.X.lim (\ x -> Nat) (M.restrict n indicator) (M.restrict n nil-map) off)
     (symH (NatMap.stage-value n nil-map)))) ;
   module Later (d : Nat) (agree : Id (P.E (NA.plus d n) -> Nat) (CN.shift d n indicator) (CN.shift d n nil-map)) {
    impossible (w : Reached d) : Empty = NO.zero-not-suc zero (calc Nat {
     zero =< symH (M.shift-down n nil-map d w.1) > CN.shift d n nil-map w.1
     =< symH (happly (P.E (NA.plus d n)) (\ a -> Nat) _ _ agree w.1) > CN.shift d n indicator w.1
     =< M.shift-down n indicator d w.1 > indicator (down d w.1)
     =< apH indicator w.2 > indicator y =< hit > suc zero }) ;
   } ;
   at-meet (w : (d : Nat) * Id (P.E (NA.plus d n) -> Nat) (CN.shift d n indicator) (CN.shift d n nil-map))
    (every : (d : Nat) -> T.Trunc[Reached d].carrier) : Empty =
    TC.rec (Reached w.1) @l Empty isProp-Empty Later[w.1,w.2].impossible (every w.1) ;
   contradiction (h : (d : Nat) -> T.Trunc[Reached d].carrier) : Empty =
    TC.rec CN.Meet[(n,indicator),(n,nil-map)] @l Empty isProp-Empty
     (\ meet -> at-meet (CN.stage-meet n indicator nil-map meet) h) (CN.effective (n,indicator) (n,nil-map) equal) ;
  } ;
  persistent (h : (d : Nat) -> T.Trunc[Reached d].carrier) : InImage =
   OC.closed-stable InImage T.Trunc[Fibre].proposition closed (\ miss -> Miss[miss].contradiction h) ;
 } ;
} ;
