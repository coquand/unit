-- A finite basis over an explicitly finite coefficient ring gives an
-- actual finite enumeration: enumerate all coefficient tuples, then
-- expand them in the basis. Basis coordinates give actual coverage.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (m : Nat) (values : Fin m -> R.R)
 (cover : (r : R.R) -> (i : Fin m) * Id R.R (values i) r)
 (S : Algebras[l].Over[R,setR].Algebra) (d : Nat) (basis : TraceBasis[l].Over[R,setR,S].Basis[d]) {
 module Tuples = FiniteTuples[l].Over[R.R,m,values,cover] ;
 tuples : Tuples.Enumeration[d] = Tuples.enumerate d ;
 module Coords = FiniteBasisComposition[l].Coordinates[R,setR,S,d,basis] ;
 size : Nat = tuples.size ;
 enumeration (i : Fin size) : S.ring.R = Coords.expand (tuples.tuple i) ;
 covers (a : S.ring.R) : (i : Fin size) * Id S.ring.R (enumeration i) a =
  ((tuples.covers (basis.coordinate a)).1,
   trans (ap Coords.expand (tuples.covers (basis.coordinate a)).2) (Coords.expand-coordinate a)) ;
} ;
