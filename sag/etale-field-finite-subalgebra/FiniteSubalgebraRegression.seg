-- Full construction inside F2 x F2 at the first-projection prime.
-- The coefficient field is produced by bounded closure, not supplied
-- as a new assumption. Both complementary idempotents satisfy X^2-X.
-- The resulting finite coefficient image has a selected field whose
-- second generator is zero and whose first generator is nonzero.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module P = PrimitiveRegression[l] ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ; four : Nat = suc three ;
empty-up : Empty -> Ring[l+].Empty = split {} ;
module CF = FiniteCoefficientField[l].Over[P.k,P.B.bool-set,P.dec,P.nonzero,zero,\ i -> efq i] ;
branch : CF.Result two -> Nat = split { inl many -> zero ; inr small -> one } ;
small-branch : Id Nat (branch (CF.theorem two)) one = refl one ;
choose : (r : CF.Result two) -> Id Nat (branch r) one -> CF.Subfield = split {
 inl many -> \ h -> Ring[l+].absurd CF.Subfield (empty-up (zero-suc zero h)) ; inr small -> \ h -> small } ;
K0 : CF.Subfield = choose (CF.theorem two) small-branch ;
module Top = CoefficientSubalgebra[l].Over[P.k,P.B.bool-set,P.field,zero,\ i -> efq i,K0].At[P.S,two,P.basis] ;
lower : Fin two -> List K0.ring.R = \ i -> cons K0.ring.z (cons (K0.ring.neg K0.ring.o) nil) ;
root : IteratedMonicBasis[l].Over[K0.ring,K0.set].Roots two lower Top.restricted P.vector =
 P.two-elim (\ i -> Id P.Pair
  (MonicBasisUniversal[l].Values[K0.ring,P.A,Top.restricted.iota,P.vector i].value (lower i)) P.z)
  (refl P.z) (refl P.z) ;
module Image = Top.Generators[two,P.vector,lower,root] ;
actual-coverage (b : Image.Image.B.Carrier) :
 (i : Fin Image.size) * Id Image.Image.B.Carrier (Image.enumeration i) b = Image.covers b ;
module Choice = Image.Selected[P.reduced,P.q] ;
selected : Tr.Trunc[Choice.F.PF.Result].carrier = Choice.theorem ;
module At (r : Choice.F.PF.Result) {
 module F = Choice.F.Chosen[r] ;
 finite-field (a : F.field.R) : (i : Fin F.size) * Id F.field.R (F.enumeration i) a = F.covers a ;
 field-nonzero : Not (Id F.field.R F.field.o F.field.z) = F.field-nonzero ;
 field-decide (a : F.field.R) : Plus (Id F.field.R a F.field.z) (RL[F.field].unit a) = F.field-decide a ;
 second-killed : Id F.field.R (F.generator P.i1) F.field.z = F.Raw.Selected.kernel-forward (Choice.F.B.variables P.i1) (refl false) ;
 first-nonzero : Not (Id F.field.R (F.generator P.i0) F.field.z) =
  \ h -> P.nonzero (F.Raw.Selected.kernel-backward (Choice.F.B.variables P.i0) h) ;
 generator-image (i : Fin two) : Id P.Pair (F.to-ambient (F.generator i)) (P.A.mul F.idempotent (P.vector i)) = F.generator-image i ;
} ;
-- Direct computations for tuple enumeration and duplicate removal.
values : Fin two -> P.k.R = snoc (Fin one) P.k.R (\ i -> false) true ;
cover : (a : P.k.R) -> (i : Fin two) * Id P.k.R (values i) a = split {
 false -> (inl (inr tt),refl false) ; true -> (inr tt,refl true) } ;
module Tuples = FiniteTuples[l].Over[P.k.R,two,values,cover] ;
tuples : Tuples.Enumeration[two] = Tuples.enumerate two ;
four-tuples : Id Nat tuples.size four = refl four ;
module Equal = DiscreteFieldOperations[l].Over[P.k,P.B.bool-set,P.dec,P.nonzero] ;
module DD = FiniteDedup[l].Over[P.k.R,P.B.bool-set,Equal.equal] ;
repetitions : Fin three -> P.k.R = snoc (Fin two) P.k.R (snoc (Fin one) P.k.R (\ i -> true) false) true ;
distinct : DD.Enumeration[three,repetitions] = DD.dedup three repetitions ;
two-values : Id Nat distinct.size two = refl two ;
