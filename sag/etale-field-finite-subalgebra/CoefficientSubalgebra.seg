-- The requested ambient-field interface. The coefficient field is the
-- ACTUAL Subfield returned by the bounded coefficient-field theorem.
-- Equality in the ambient algebra is constructed from its supplied
-- finite basis over k. No extra equality or kernel theorem is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) (field : SelectedFactorStatement[l].Over[k,setk].Field)
 (t : Nat) (coefficients : Fin t -> k.R)
 (K0 : FiniteCoefficientField[l].Over[k,setk,field.decide,field.nonzero,t,coefficients].Subfield) {
 module C = Algebras[l].Over[k,setk] ; module C0 = Algebras[l].Over[K0.ring,K0.set] ;
 module At (S : C.Algebra) (d : Nat) (basis : TraceBasis[l].Over[k,setk,S].Basis[d]) {
  module Equal = DiscreteCoordinates[l].Over[k,setk,field].At[S,d,basis] ;
  restricted : C0.Algebra = C0.mkAlgebra S.ring S.set (H.compose K0.ring k S.ring S.iota K0.inclusion) ;
  module Generators (n : Nat) (x : Fin n -> S.ring.R) (lower : Fin n -> List K0.ring.R)
   (roots : IteratedMonicBasis[l].Over[K0.ring,K0.set].Roots n lower restricted x) {
   module Image = MonicFiniteImage[l].Over[K0.ring,K0.set,K0.size,K0.enumeration,K0.cover].At[restricted,Equal.decide,n,x,lower,roots] ;
   size : Nat = Image.size ;
   enumeration : Fin size -> Image.B.Carrier = Image.enumeration ;
   enumeration-injective (i j : Fin size) (h : Id Image.B.Carrier (enumeration i) (enumeration j)) : Id (Fin size) i j = Image.enumeration-injective i j h ;
   covers (b : Image.B.Carrier) : (i : Fin size) * Id Image.B.Carrier (enumeration i) b = Image.covers b ;
   module Selected
    (reduced : (a : S.ring.R) -> Id S.ring.R (S.ring.mul a a) S.ring.z -> Id S.ring.R a S.ring.z)
    (q : PrimeIdempotents[l].Over[S.ring].Prime) {
    module F = SelectedFiniteImage[l].Over[K0.ring,K0.set,K0.field-decide,K0.size,K0.enumeration,K0.cover,
     restricted,Equal.decide,n,x,lower,roots,reduced,q] ;
    theorem : Tr.Trunc[F.PF.Result].carrier = F.selected ;
   } ;
  } ;
 } ;
} ;
