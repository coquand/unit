-- Naturality of monic Horner values, and the comparison with the
-- ordinary coefficient-list Horner expression used by regularity.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module MV = MonicBasisUniversal[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ;
 module Map (S T : C.Algebra) (h : C.Hom S T) (x : S.ring.R) {
  value : (cs : List R.R) ->
   Id T.ring.R (h.1.1 (MV.Values[R,S.ring,S.iota,x].value cs))
    (MV.Values[R,T.ring,T.iota,h.1.1 x].value cs) = split {
   nil -> h.1.2.1 ;
   cons a cs | ih -> trans (h.1.2.2.1 (S.iota.1 a) (S.ring.mul x (MV.Values[R,S.ring,S.iota,x].value cs)))
    (cong2 T.ring.R T.ring.add _ _ _ _ (h.2 a)
     (trans (h.1.2.2.2 x (MV.Values[R,S.ring,S.iota,x].value cs)) (ap (T.ring.mul (h.1.1 x)) ih))) } ;
 } ;
 module Horner (S : C.Algebra) (x : S.ring.R) {
  module Ho = MonicReduce[l].Horner[R,S.ring,S.iota,x] ;
  module St = SelectedFactorStatement[l].Over[R,setR] ;
  module IM = IntegralDescent[l].Map[R,S.ring,S.iota] ;
  integral-value : (cs : List R.R) -> Id S.ring.R (MV.Values[R,S.ring,S.iota,x].value cs) (IM.PC.value x (IM.coefficients cs)) = split {
   nil -> refl S.ring.o ; cons a cs | ih -> ap (\ z -> S.ring.add (S.iota.1 a) (S.ring.mul x z)) ih } ;
  equation : (cs : List R.R) -> Id S.ring.R (Ho.horner (St.monic cs)) (MV.Values[R,S.ring,S.iota,x].value cs) = split {
   nil -> trans (ap (S.ring.add (S.iota.1 R.o)) (RL[S.ring].mul-zero x))
    (trans (S.ring.addZ (S.iota.1 R.o)) S.iota.2.1) ;
   cons a cs | ih -> ap (\ z -> S.ring.add (S.iota.1 a) (S.ring.mul x z)) ih } ;
 } ;
} ;
