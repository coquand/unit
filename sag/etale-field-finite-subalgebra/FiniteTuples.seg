-- Enumerate every finite tuple over an explicitly finite type. The
-- enumeration and coverage witnesses are actual; no finite choice is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ; module FP = FiniteProduct[l] ;
module Over (X : U l) (n : Nat) (v : Fin n -> X)
 (cover : (x : X) -> (i : Fin n) * Id X (v i) x) {
 record Enumeration (d : Nat) {
  size : Nat ;
  tuple : Fin size -> Fin d -> X ;
  covers (a : Fin d -> X) : (i : Fin size) * Id (Fin d -> X) (tuple i) a ;
 } ;
 initial : Enumeration[zero] = mkEnumeration zero (suc zero) (\ i j -> efq j)
  (\ a -> (inr tt,F.funext (Fin zero) (\ i -> X) (\ i -> efq i) a (\ i -> efq i))) ;
 module Step (d : Nat) (old : Enumeration[d]) {
  size : Nat = FP.size n old.size ;
  pair-tuple (p : FP.Pair n old.size) : Fin (suc d) -> X = snoc (Fin d) X (old.tuple p.2) (v p.1) ;
  tuple (i : Fin size) : Fin (suc d) -> X = pair-tuple (FP.decode n old.size i) ;
  chosen (a : Fin (suc d) -> X) : FP.Pair n old.size = ((cover (a (inr tt))).1,(old.covers (\ i -> a (inl i))).1) ;
  pair-equation (a : Fin (suc d) -> X) : Id (Fin (suc d) -> X) (pair-tuple (chosen a)) a =
   F.funext (Fin (suc d)) (\ i -> X) _ a
    (AffineFinite[l].section d (\ i -> Id X (pair-tuple (chosen a) i) (a i))
     (\ i -> Pr.happly (Fin d) (\ j -> X) _ _ (old.covers (\ j -> a (inl j))).2 i)
     (cover (a (inr tt))).2) ;
  covers (a : Fin (suc d) -> X) : (i : Fin size) * Id (Fin (suc d) -> X) (tuple i) a =
   (FP.encode n old.size (chosen a).1 (chosen a).2,
    trans (ap pair-tuple (FP.decode-encode n old.size (chosen a).1 (chosen a).2)) (pair-equation a)) ;
  result : Enumeration[suc d] = mkEnumeration (suc d) size tuple covers ;
 } ;
 enumerate : (d : Nat) -> Enumeration[d] = split { zero -> initial ; suc d | ih -> Step[d,ih].result } ;
} ;
