-- If every prime avoids an element carrying G, a finite family carrying
-- G generates 1. G need not be a proposition. No choice of one element
-- for every prime is made. The ideal membership itself is truncated.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module Ps = Presentations[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (G : A.R -> U l) {
 module PE = PrimeExistence[l].Over[A] ;
 module I = IdealGenerated[l].Over[A,G,A,RingHom[l].identity A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 In (x : A.R) : U l = Tr.Trunc[I.InmB x].carrier ;
 in-prop (x : A.R) : Pr.isProp (In x) = Tr.Trunc[I.InmB x].proposition ;
 in-zero : In A.z = Tr.Trunc[I.InmB A.z].inc I.in-zero ;
 in-add (x y : A.R) : In x -> In y -> In (A.add x y) =
  TC.map2 (I.InmB x) (I.InmB y) (I.InmB (A.add x y)) (I.in-add x y) ;
 in-scale (a x : A.R) : In x -> In (A.mul a x) =
  TC.map (I.InmB x) (I.InmB (A.mul a x)) (I.in-scale a x) ;
 ideal : RegularIdeal[l].IdealPred[A] =
  new RegularIdeal[l].IdealPred[A,In,in-zero,in-add,in-scale] ;
 generator (x : A.R) (g : G x) : In x = Tr.Trunc[I.InmB x].inc (I.in-m x g) ;
 Hit (q : PE.Prime) : U l = (s : A.R) * G s * Not (q.ideal.In s) ;
 Pointwise : U l+ = (q : PE.Prime) -> Tr.Trunc[Hit q].carrier ;
 Cover : U l = (n : Nat) * (s a : Ps.Fin n -> A.R) *
  ((i : Ps.Fin n) -> G (s i)) * Id A.R (S.lin n s a) A.o ;
 extract (w : I.InmB A.o) : Cover =
  (len w.1,\ i -> (I.Ls.at w.1 i).1,\ i -> (I.Ls.at w.1 i).2.2,
   \ i -> (I.Ls.at w.1 i).2.1,sym (trans w.2 (I.Ls.lsum-sum I.value w.1))) ;
 module Given (pointwise : Pointwise) {
  contradict (q : PE.Prime) (inc : PE.Contains ideal q) (h : Hit q) : Empty =
   h.2.2 (inc h.1 (generator h.1 h.2.1)) ;
  no-common-prime (w : PE.Above ideal) : Empty =
   TC.rec (Hit w.1) @l Empty ClassicalLogic[l].empty-prop
    (contradict w.1 w.2) (pointwise w.1) ;
  not-proper (proper : Not (In A.o)) : Empty =
   TruncationCombinators[l+].rec (PE.Above ideal) @l Empty ClassicalLogic[l].empty-prop
    no-common-prime (prime-existence @l A setA ideal in-prop proper) ;
  one : In A.o = ClassicalLogic[l].dne (In A.o) (in-prop A.o) not-proper ;
  theorem : Tr.Trunc[Cover].carrier = TC.map (I.InmB A.o) Cover extract one ;
 } ;
} ;
