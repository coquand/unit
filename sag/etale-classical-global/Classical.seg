-- Precisely the classical boundary. Shared constructive imports above
-- this segment do not acquire either parameter. Prime existence is left
-- as a premise; deriving it from choice is a separate future theorem.
module Cl
 (lem : [l] (P : U l) -> Prelude[l].isProp P -> Ring[l].Plus P (Ring[l].Not P))
 (prime-existence : [l] (A : Ring[l].CRing) -> Prelude[l].isSet A.R ->
  PrimeExistence[l].Over[A].Principle) {
 import ClassicalLogic ;
 import ClassicalPrimeCover ;
 import ClassicalCertifiedCover ;
 import ClassicalEtaleCover ;
 import ClassicalRegression ;
} ;
