-- Only excluded middle is used here. Resizing of propositions follows
-- by choosing Top or Empty; it is not an additional resizing axiom.
level l ; open Ring[l] ; module Pr = Prelude[l] ;
empty-prop : Pr.isProp Empty = \ e -> efq e ;
dne-case (P : U l) (nn : Not (Not P)) : Plus P (Not P) -> P = split {
 inl p -> p ; inr n -> efq (nn n) } ;
dne (P : U l) (prop : Pr.isProp P) (nn : Not (Not P)) : P =
 dne-case P nn (lem @l P prop) ;
empty-up : Empty -> Ring[l+].Empty = split { } ;
empty-down : Ring[l+].Empty -> Empty = split { } ;
record Small (P : U l+) {
 carrier : U l ;
 proposition : Pr.isProp carrier ;
 out : carrier -> P ;
 into : P -> carrier ;
} ;
small-yes (P : U l+) (p : P) : Small[P] =
 new Small[P,Top,AffineFinite[l].top-eq,\ t -> p,\ p -> tt] ;
small-no (P : U l+) (n : Ring[l+].Not P) : Small[P] =
 new Small[P,Empty,empty-prop,\ e -> Ring[l+].efq (empty-up e),\ p -> empty-down (n p)] ;
small-case (P : U l+) : Ring[l+].Plus P (Ring[l+].Not P) -> Small[P] = split {
 inl p -> small-yes P p ; inr n -> small-no P n } ;
resize (P : U l+) (prop : Prelude[l+].isProp P) : Small[P] =
 small-case P (lem @l+ P prop) ;

-- A prime supplied by the existence principle becomes a decidable prime
-- in the exact interface already used by the constructive local proof.
module Prime (A : CRing) (q : PrimeExistence[l].Over[A].Prime) {
 module TC = TruncationCombinators[l] ;
 decide (x : A.R) : Plus (q.ideal.In x) (Not (q.ideal.In x)) =
  lem @l (q.ideal.In x) (q.proposition x) ;
 right (x y : A.R) (out : Not (q.ideal.In x)) :
  Plus (q.ideal.In x) (q.ideal.In y) -> q.ideal.In y = split {
  inl h -> efq (out h) ; inr h -> h } ;
 split-case (x y : A.R) (h : q.ideal.In (A.mul x y)) :
  Plus (q.ideal.In x) (Not (q.ideal.In x)) -> Plus (q.ideal.In x) (q.ideal.In y) = split {
  inl hx -> inl hx ;
  inr out -> inr (TC.rec (Plus (q.ideal.In x) (q.ideal.In y)) @l
   (q.ideal.In y) (q.proposition y) (right x y out) (q.prime x y h)) } ;
 split-prime (x y : A.R) (h : q.ideal.In (A.mul x y)) : Plus (q.ideal.In x) (q.ideal.In y) =
  split-case x y h (decide x) ;
 decidable : PrimeIdempotents[l].Over[A].Prime =
  new PrimeIdempotents[l].Over[A].Prime[q.ideal,q.proposition,q.proper,split-prime,decide] ;
} ;
