-- Certificates such as actual standard-etale localisations live one
-- universe above ring elements. Classical proposition resizing gives a
-- small generated ideal; finite choice then restores the certificates.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module Tr = Truncation[l] ; module Big = Truncation[l+] ;
module TC = TruncationCombinators[l+] ;
empty-section (B : Ps.Fin zero -> U l+) : (i : Ps.Fin zero) -> B i = split { } ;
section (n : Nat) (B : Ps.Fin (suc n) -> U l+)
 (old : (i : Ps.Fin n) -> B (inl i)) (last : B (inr tt)) : (i : Ps.Fin (suc n)) -> B i = split {
 inl i -> old i ;
 inr t -> idJ Top tt (\ u h -> B (inr u)) last t (AffineFinite[l].top-eq tt t) } ;
choice : (n : Nat) (B : Ps.Fin n -> U l+) ->
 ((i : Ps.Fin n) -> Big.Trunc[B i].carrier) -> Big.Trunc[(i : Ps.Fin n) -> B i].carrier = split {
 zero -> \ B h -> Big.Trunc[(i : Ps.Fin zero) -> B i].inc (empty-section B) ;
 suc n | ih -> \ B h -> TC.bind2 ((i : Ps.Fin n) -> B (inl i)) (B (inr tt))
  ((i : Ps.Fin (suc n)) -> B i)
  (\ old last -> Big.Trunc[(i : Ps.Fin (suc n)) -> B i].inc (section n B old last))
  (ih (\ i -> B (inl i)) (\ i -> h (inl i))) (h (inr tt)) } ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Certificate : A.R -> U l+) {
 module PE = PrimeExistence[l].Over[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 small (s : A.R) : ClassicalLogic[l].Small[Big.Trunc[Certificate s].carrier] =
  ClassicalLogic[l].resize Big.Trunc[Certificate s].carrier Big.Trunc[Certificate s].proposition ;
 Good (s : A.R) : U l = (small s).carrier ;
 module C = ClassicalPrimeCover[l].Over[A,setA,Good] ;
 Hit (q : PE.Prime) : U l+ = (s : A.R) * Not (q.ideal.In s) * Certificate s ;
 Pointwise : U l+ = (q : PE.Prime) -> Big.Trunc[Hit q].carrier ;
 Cover : U l+ = (n : Nat) * (s a : Ps.Fin n -> A.R) *
  ((i : Ps.Fin n) -> Certificate (s i)) * Id A.R (S.lin n s a) A.o ;
 small-hit (q : PE.Prime) (h : Hit q) : C.Hit q =
  (h.1,(small h.1).into (Big.Trunc[Certificate h.1].inc h.2.2),h.2.1) ;
 restore (c : C.Cover) (certs : (i : Ps.Fin c.1) -> Certificate (c.2.1 i)) : Cover =
  (c.1,c.2.1,c.2.2.1,certs,c.2.2.2.2) ;
 restore-merely (c : C.Cover) : Big.Trunc[Cover].carrier =
  TC.map ((i : Ps.Fin c.1) -> Certificate (c.2.1 i)) Cover (restore c)
   (choice c.1 (\ i -> Certificate (c.2.1 i)) (\ i -> (small (c.2.1 i)).out (c.2.2.2.1 i))) ;
 module Given (pointwise : Pointwise) {
  small-pointwise (q : PE.Prime) : Tr.Trunc[C.Hit q].carrier =
   TC.rec (Hit q) @l Tr.Trunc[C.Hit q].carrier Tr.Trunc[C.Hit q].proposition
    (\ h -> Tr.Trunc[C.Hit q].inc (small-hit q h)) (pointwise q) ;
  theorem : Big.Trunc[Cover].carrier =
   TruncationCombinators[l].rec C.Cover @l+ Big.Trunc[Cover].carrier Big.Trunc[Cover].proposition
    restore-merely C.Given[small-pointwise].theorem ;
 } ;
} ;
