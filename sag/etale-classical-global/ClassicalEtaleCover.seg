-- Exact interface with Local.Statement and FlatLocalStatement. These
-- theorems assemble primewise neighbourhoods already standard over the
-- original base. Descent from the localised base is not assumed proved.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R)
 (iota : RingHom[l].Hom A E) {
 module St = Local[l].Statement[A,setA,E,setE,iota,\ s -> Empty] ;
 module C = St.C ; module SE = St.SE ;
 module PE = PrimeExistence[l].Over[E] ;
 module PI = PrimeIdempotents[l].Over[E] ;
 Chart (s : E.R) : U l+ = (T : C.Algebra) * (i : C.Hom St.Ealg T) * St.IsLocalisation T i s *
  (Q G : SE.RX.Carrier) * SE.Points[Q,G].Standard T ;
 module Global = ClassicalCertifiedCover[l].Over[E,setE,Chart] ;
 LocalAt (q : PI.Prime) : U l+ =
  Local[l].Statement[A,setA,E,setE,iota,q.ideal.In].Conclusion ;
 LocalTheorem : U l+ = (q : PI.Prime) -> Tr.Trunc[LocalAt q].carrier ;
 module Given (local : LocalTheorem) {
  at-prime (q : PE.Prime) : Tr.Trunc[Global.Hit q].carrier =
   local ClassicalLogic[l].Prime[E,q].decidable ;
  theorem : Tr.Trunc[Global.Cover].carrier = Global.Given[at-prime].theorem ;
 } ;
 -- The flat local theorem carries the square-zero etale certificate too.
 EtaleChart (s : E.R) : U l+ = (T : C.Algebra) * (i : C.Hom St.Ealg T) * St.IsLocalisation T i s *
  (Q G : SE.RX.Carrier) * SE.Points[Q,G].Standard T * FormallyEtale[l].Over[A,setA].Etale T ;
 module FlatGlobal = ClassicalCertifiedCover[l].Over[E,setE,EtaleChart] ;
 FlatLocalAt (q : PI.Prime) : U l+ =
  FlatLocalStatement[l].Over[A,setA,E,setE,iota,q.ideal.In].Conclusion ;
 FlatLocalTheorem : U l+ = (q : PI.Prime) -> Tr.Trunc[FlatLocalAt q].carrier ;
 module GivenFlat (local : FlatLocalTheorem) {
  at-prime (q : PE.Prime) : Tr.Trunc[FlatGlobal.Hit q].carrier =
   local ClassicalLogic[l].Prime[E,q].decidable ;
  theorem : Tr.Trunc[FlatGlobal.Cover].carrier = FlatGlobal.Given[at-prime].theorem ;
 } ;
 -- The old Standard interface does not record monicity. This stronger
 -- certificate retains a coefficient list followed by the leading 1,
 -- so the monic version of the note is available without conflating the
 -- two statements. Producing it from the old endpoint is not asserted.
 monic-terms : List A.R -> List A.R = split {
  nil -> cons A.o nil ; cons a lower | r -> cons a r } ;
 MonicChart (s : E.R) : U l+ = (lower : List A.R) * (T : C.Algebra) *
  (i : C.Hom St.Ealg T) * St.IsLocalisation T i s * (G : SE.RX.Carrier) *
  SE.Points[SE.RX.include (monic-terms lower),G].Standard T ;
 forget-monic (s : E.R) (h : MonicChart s) : Chart s =
  (h.2.1,h.2.2.1,h.2.2.2.1,SE.RX.include (monic-terms h.1),h.2.2.2.2.1,h.2.2.2.2.2) ;
 module MonicGlobal = ClassicalCertifiedCover[l].Over[E,setE,MonicChart] ;
 MonicLocalAt (q : PI.Prime) : U l+ = (s : E.R) * Not (q.ideal.In s) * MonicChart s ;
 MonicLocalTheorem : U l+ = (q : PI.Prime) -> Tr.Trunc[MonicLocalAt q].carrier ;
 module GivenMonic (local : MonicLocalTheorem) {
  at-prime (q : PE.Prime) : Tr.Trunc[MonicGlobal.Hit q].carrier =
   local ClassicalLogic[l].Prime[E,q].decidable ;
  theorem : Tr.Trunc[MonicGlobal.Cover].carrier = MonicGlobal.Given[at-prime].theorem ;
 } ;
} ;
