-- The prime-ideal principle is a type, not an axiom. No classical
-- parameter is in scope in this file. A prime has propositional
-- membership and merely disjunctive primality; no decision is included.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) {
 record Prime {
  ideal : RegularIdeal[l].IdealPred[A] ;
  proposition (x : A.R) : Pr.isProp (ideal.In x) ;
  proper : Not (ideal.In A.o) ;
  prime (x y : A.R) : ideal.In (A.mul x y) ->
   Tr.Trunc[Plus (ideal.In x) (ideal.In y)].carrier ;
 } ;
 Contains (I : RegularIdeal[l].IdealPred[A]) (q : Prime) : U l =
  (x : A.R) -> I.In x -> q.ideal.In x ;
 Above (I : RegularIdeal[l].IdealPred[A]) : U l+ =
  (q : Prime) * Contains I q ;
 Principle : U l+ = (I : RegularIdeal[l].IdealPred[A]) ->
  ((x : A.R) -> Pr.isProp (I.In x)) -> Not (I.In A.o) ->
  Truncation[l+].Trunc[Above I].carrier ;
} ;
