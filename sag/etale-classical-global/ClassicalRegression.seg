-- Degenerate cases, a cover whose good elements need not be units, large
-- certificates, and an actual constructed standard-etale algebra.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Big = Truncation[l+] ; module H = RingHom[l] ;
module One (A : CRing) (setA : Pr.isSet A.R) {
 Good (s : A.R) : U l = Id A.R s A.o ;
 module C = ClassicalPrimeCover[l].Over[A,setA,Good] ;
 hit (q : C.PE.Prime) : Tr.Trunc[C.Hit q].carrier =
  Tr.Trunc[C.Hit q].inc (A.o,refl A.o,q.proper) ;
 theorem : Tr.Trunc[C.Cover].carrier = C.Given[hit].theorem ;
} ;
module EmptyCover (A : CRing) (setA : Pr.isSet A.R) (one-zero : Id A.R A.o A.z) {
 module C = ClassicalPrimeCover[l].Over[A,setA,\ s -> Empty] ;
 impossible (q : C.PE.Prime) : Empty =
  q.proper (subst q.ideal.In (sym one-zero) q.ideal.in-zero) ;
 hit (q : C.PE.Prime) : Tr.Trunc[C.Hit q].carrier = efq (impossible q) ;
 theorem : Tr.Trunc[C.Cover].carrier = C.Given[hit].theorem ;
 -- The conclusion permits precisely the empty family in this case.
 no-generators : (i : Presentations[l].Fin zero) -> A.R = split { } ;
 no-good : (i : Presentations[l].Fin zero) -> Empty = split { } ;
 empty : C.Cover = (zero,no-generators,no-generators,no-good,sym one-zero) ;
} ;
module EmptyGood (A : CRing) (setA : Pr.isSet A.R) {
 module C = ClassicalPrimeCover[l].Over[A,setA,\ s -> Empty] ;
 sum-zero : (n : Nat) (s a : Presentations[l].Fin n -> A.R) ->
  ((i : Presentations[l].Fin n) -> Empty) -> Id A.R (C.S.lin n s a) A.z = split {
  zero -> \ s a good -> refl A.z ;
  suc n | ih -> \ s a good -> efq (good (inr tt)) } ;
 forces-zero (c : C.Cover) : Id A.R A.o A.z =
  trans (sym c.2.2.2.2) (sum-zero c.1 c.2.1 c.2.2.1 c.2.2.2.1) ;
 impossible (nonzero : Not (Id A.R A.o A.z)) : Not Tr.Trunc[C.Cover].carrier =
  TruncationCombinators[l].rec C.Cover @l Empty ClassicalLogic[l].empty-prop
   (\ c -> nonzero (forces-zero c)) ;
} ;
module Two (A : CRing) (setA : Pr.isSet A.R) (a b : A.R) (sum-one : Id A.R (A.add a b) A.o) {
 Good (s : A.R) : U l = Plus (Id A.R s a) (Id A.R s b) ;
 module C = ClassicalPrimeCover[l].Over[A,setA,Good] ;
 out-b (q : C.PE.Prime) (ha : q.ideal.In a) (hb : q.ideal.In b) : Empty =
  q.proper (subst q.ideal.In sum-one (q.ideal.in-add a b ha hb)) ;
 pick (q : C.PE.Prime) : Plus (q.ideal.In a) (Not (q.ideal.In a)) -> C.Hit q = split {
  inl ha -> (b,inr (refl b),out-b q ha) ;
  inr na -> (a,inl (refl a),na) } ;
 hit (q : C.PE.Prime) : Tr.Trunc[C.Hit q].carrier =
  Tr.Trunc[C.Hit q].inc (pick q (ClassicalLogic[l].Prime[A,q].decide a)) ;
 theorem : Tr.Trunc[C.Cover].carrier = C.Given[hit].theorem ;
} ;
module Complementary (A : CRing) (setA : Pr.isSet A.R) (e : A.R) {
 module P = PrimeIdempotents[l].Over[A] ;
 module T = Two[A,setA,e,P.complement e,P.complement-sum e] ;
 theorem : Tr.Trunc[T.C.Cover].carrier = T.theorem ;
} ;
module LargeCertificate (A : CRing) (setA : Pr.isSet A.R) {
 Certificate (s : A.R) : U l+ = (X : U l) * X * Id A.R s A.o ;
 module C = ClassicalCertifiedCover[l].Over[A,setA,Certificate] ;
 hit (q : C.PE.Prime) : Big.Trunc[C.Hit q].carrier =
  Big.Trunc[C.Hit q].inc (A.o,q.proper,Top,tt,refl A.o) ;
 theorem : Big.Trunc[C.Cover].carrier = C.Given[hit].theorem ;
} ;

-- Every algebra is its own localisation at 1, with the actual universal
-- property used by Local.Statement, not an assumed localisation record.
module AtOne (A : CRing) (setA : Pr.isSet A.R) (E : Algebras[l].Over[A,setA].Algebra) {
 module C = Algebras[l].Over[A,setA] ;
 module G = ClassicalEtaleCover[l].Over[A,setA,E.ring,E.set,E.iota] ;
 one-unit : RL[E.ring].unit E.ring.o = (E.ring.o,E.ring.mulO E.ring.o) ;
 module To (B : C.Algebra) {
  Data : U l = (h : C.Hom E B) * RL[B.ring].unit (h.1.1 E.ring.o) ;
  forward (h : C.Hom E B) : Data = G.St.Restrict E (C.identity E) E.ring.o one-unit B h ;
  backward (d : Data) : C.Hom E B = d.1 ;
  bf (h : C.Hom E B) : Id (C.Hom E B) (backward (forward h)) h =
   C.ext E B _ _ (\ x -> refl (h.1.1 x)) ;
  fb (d : Data) : Id Data (forward (backward d)) d =
   Pr.Sigma-eq (C.Hom E B) (\ h -> RL[B.ring].unit (h.1.1 E.ring.o))
    _ d.1 _ d.2 (bf d.1) (FormallyEtale[l].Units[B.ring,B.set].unit-prop (d.1.1.1 E.ring.o)) ;
  equivalence : Pr.isEquiv (C.Hom E B) Data forward = Pr.qinv _ _ forward backward fb bf ;
 } ;
 localisation : G.St.IsLocalisation E (C.identity E) E.ring.o =
  (one-unit,\ B -> To[B].equivalence) ;
 module Standard (Q H0 : G.SE.RX.Carrier) (st : G.SE.Points[Q,H0].Standard E) {
  chart : G.Chart E.ring.o = (E,C.identity E,localisation,Q,H0,st) ;
  local (q : G.PI.Prime) : Big.Trunc[G.LocalAt q].carrier =
   Big.Trunc[G.LocalAt q].inc (E.ring.o,q.proper,chart) ;
  theorem : Big.Trunc[G.Global.Cover].carrier = G.Given[local].theorem ;
 } ;
 module Monic (lower : List A.R) (H0 : G.SE.RX.Carrier)
  (st : G.SE.Points[G.SE.RX.include (G.monic-terms lower),H0].Standard E) {
  chart : G.MonicChart E.ring.o = (lower,E,C.identity E,localisation,H0,st) ;
  local (q : G.PI.Prime) : Big.Trunc[G.MonicLocalAt q].carrier =
   Big.Trunc[G.MonicLocalAt q].inc (E.ring.o,q.proper,chart) ;
  theorem : Big.Trunc[G.MonicGlobal.Cover].carrier = G.GivenMonic[local].theorem ;
 } ;
} ;

-- Q=X, G=1. Build the presented algebra and its standardness with the
-- existing construction, then run both complete classical cover maps.
module ConstructedStandard (A : CRing) (setA : Pr.isSet A.R) {
 module SE = StandardEtale[l].Over[A,setA] ; module RX = SE.RX ;
 lower : List A.R = cons A.z nil ;
 terms : List A.R = cons A.z (cons A.o nil) ;
 derivative-X : Id RX.Carrier (SE.deriv RX.variable) RX.ring.o =
  ap (\ p -> p.2) SE.At[RX.ring,RX.set,RX.inclusion,RX.variable].UPe.on-variable ;
 denominator-one : Id RX.Carrier SE.Points[RX.variable,RX.ring.o].g RX.ring.o =
  trans (ap (RX.ring.mul RX.ring.o) derivative-X) (RX.ring.mulO RX.ring.o) ;
 module S = StandardAlgebra[l].Over[A,setA].Build[RX.variable,RX.ring.o,terms,cons A.o nil,
  refl RX.variable,sym denominator-one] ;
 module Unit = AtOne[A,setA,S.S] ;
 theorem : Big.Trunc[Unit.G.Global.Cover].carrier = Unit.Standard[RX.variable,RX.ring.o,S.standard].theorem ;
 monic-theorem : Big.Trunc[Unit.G.MonicGlobal.Cover].carrier = Unit.Monic[lower,RX.ring.o,S.standard].theorem ;
} ;
