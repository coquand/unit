-- Every inverted chart coordinate has an explicitly constructed inverse.
-- Its coefficient is the shifted delta function, independently of chart.
-- Restriction preserves variables and their inverses by ring algebra.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module CR = ChartRestriction4[l] ;
module CL = ChartLaurentRing4[l] ;
unitN : Pt -> N4 = split {
 p0 -> nx (suc zero) zero zero zero ; p1 -> nx zero (suc zero) zero zero ;
 p2 -> nx zero zero (suc zero) zero ; p3 -> nx zero zero zero (suc zero) } ;
single-exp : (k : Pt) -> Id N4 (CL.direction (setPt k) (suc zero)) (unitN k) = split {
 p0 -> refl (unitN p0) ; p1 -> refl (unitN p1) ; p2 -> refl (unitN p2) ; p3 -> refl (unitN p3) } ;
size-unit : (k : Pt) -> Id Base.Nat (size (unitN k)) (suc zero) = split {
 p0 -> refl (suc zero) ; p1 -> refl (suc zero) ; p2 -> refl (suc zero) ; p3 -> refl (suc zero) } ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : Sub4) {
 module R = CL.Over[A,setA,E] ;
 variable (k : Pt) : R.ring.R = R.inclusion.1 (R.B.term A.o (unitN k)) ;
 module Inverse (k : Pt) (has : Le4 (setPt k) E) {
   module S = CR.Over[A,setA,setPt k,E,has] ;
   inverse : R.ring.R = S.invertible.1 ;
   law : Id R.ring.R (R.ring.mul (variable k) inverse) R.ring.o =
     trans (ap (\ u -> R.ring.mul (R.inclusion.1 (R.B.term A.o u)) inverse) (sym (single-exp k))) S.invertible.2 ;
   unit : Ring[l].RL[R.ring].unit (variable k) = (inverse,law) ;
   coefficient-variable (x : R.ring.R) (m : E4) :
     Id A.R (R.coeff (R.ring.mul (variable k) x) m) (R.coeff x (subE m (unitN k))) =
     trans (S.coeff-term A.o (unitN k) x m) (Ring[l].RL[A].one-left (R.coeff x (subE m (unitN k)))) ;
   coefficient (m : E4) : Id A.R (R.coeff inverse m) (R.FP.delta0 (addE m (unitN k))) =
     trans (ap (R.coeff inverse) (sym (subE-addE m (unitN k))))
       (trans (sym (coefficient-variable inverse (addE m (unitN k))))
         (trans (ap (\ x -> R.coeff x (addE m (unitN k))) law) (R.coeff-one (addE m (unitN k))))) ;
   cancel-inverse (x : R.ring.R) : Id R.ring.R (R.ring.mul (variable k) (R.ring.mul inverse x)) x =
     trans (R.ring.mulA (variable k) inverse x)
       (trans (ap (\ c -> R.ring.mul c x) law) (Ring[l].RL[R.ring].one-left x)) ;
   coefficient-inverse-mul (x : R.ring.R) (m : E4) :
     Id A.R (R.coeff (R.ring.mul inverse x) m) (R.coeff x (addE m (unitN k))) =
     trans (ap (R.coeff (R.ring.mul inverse x)) (sym (subE-addE m (unitN k))))
       (trans (sym (coefficient-variable (R.ring.mul inverse x) (addE m (unitN k))))
         (ap (\ z -> R.coeff z (addE m (unitN k))) (cancel-inverse x))) ;
   degree (m : E4) (ne : Not (Id Int (deg m) (negsuc zero))) : Id A.R (R.coeff inverse m) A.z =
     trans (coefficient m) (R.FP.delta0-away (addE m (unitN k))
       (\ e -> ne (trans (sym (pred-suc (deg m)))
         (ap predZ (trans (sym (trans (deg-addE m (unitN k)) (ap (addP (deg m)) (size-unit k)))) (ap deg e)))))) ;
 } ;
} ;
module Restriction (A : CRing) (setA : Pr.isSet A.R) (E F : Sub4) (le : Le4 E F) {
 module Map = CR.Over[A,setA,E,F,le] ; module Source = Over[A,setA,E] ; module Target = Over[A,setA,F] ;
 variable (k : Pt) : Id Target.R.ring.R (Map.hom.1 (Source.variable k)) (Target.variable k) =
   Map.constant (Source.R.B.term A.o (unitN k)) ;
 module Inverse (k : Pt) (hs : Le4 (setPt k) E) (ht : Le4 (setPt k) F) {
   module SI = Source.Inverse[k,hs] ; module TI = Target.Inverse[k,ht] ;
   law : Id Target.R.ring.R (Target.R.ring.mul (Target.variable k) (Map.hom.1 SI.inverse)) Target.R.ring.o =
     trans (ap (\ x -> Target.R.ring.mul x (Map.hom.1 SI.inverse)) (sym (variable k)))
       (trans (sym (Map.hom.2.2.2 (Source.variable k) SI.inverse)) (trans (ap Map.hom.1 SI.law) Map.hom.2.1)) ;
   equation : Id Target.R.ring.R (Map.hom.1 SI.inverse) TI.inverse =
     Map.Map.cancel (Target.variable k) TI.unit _ _ (trans law (sym TI.law)) ;
 } ;
} ;
