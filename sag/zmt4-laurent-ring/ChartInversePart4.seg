-- The degree -1 projection of an inverse coordinate is that inverse's
-- coefficient function itself. This is the exact Z-chart normalisation
-- required by the finite-fibre sections, including after restriction.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module LG = Logic[l] ; module FP = FinitePolynomial4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : Sub4) (k : Pt) (has : Le4 (setPt k) E) {
 module C = ChartCoordinates4[l].Over[A,setA,E] ; module I = C.Inverse[k,has] ;
 module D = ChartDegreePart4[l].Over[A,setA,E] ; module P = D.Part[negsuc zero] ;
 projection-case (m : E4) : (d : LG.Dec (Id Int (deg m) (negsuc zero))) ->
   Id A.R (FP.sel A (C.R.coeff I.inverse m) (Id Int (deg m) (negsuc zero)) d) (C.R.coeff I.inverse m) = split {
   yes e -> refl (C.R.coeff I.inverse m) ;
   no ne -> sym (I.degree m (\ e -> Pr.absurd Empty (ne e))) } ;
 projection (m : E4) : Id A.R (P.value I.inverse m) (C.R.coeff I.inverse m) =
   projection-case m (int-dec (deg m) (negsuc zero)) ;
 coefficient (m : E4) : Id A.R (P.value I.inverse m) (C.R.FP.delta0 (addE m (ChartCoordinates4[l].unitN k))) =
   trans (projection m) (I.coefficient m) ;
} ;
