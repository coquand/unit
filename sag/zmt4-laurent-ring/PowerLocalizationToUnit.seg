-- Universal map from a power localisation to a ring where the element
-- is invertible. This is constructed on fractions and descended through
-- the existing effective quotient. No universal-property axiom is used.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module Ps = Presentations[l] ;
module TC = TruncationCombinators[l] ;
module Over (S R : CRing) (setR : Pr.isSet R.R) (f : RH.Hom S R) (j : S.R) (hj : RL[R].unit (f.1 j)) {
 module L = RL[R] ; module P = AffinePowers[l].Over[R] ;
 module Loc = PowerLocalization[l].Over[S,j] ; module Raw = Loc.L.Raw ; module Q = Loc.L.Q ;
 cancel (u : R.R) (hu : L.unit u) (x y : R.R) (h : Id R.R (R.mul u x) (R.mul u y)) : Id R.R x y = calc R.R {
   x =< sym (L.one-left x) > R.mul R.o x
     =< ap (\ c -> R.mul c x) (sym (trans (R.mulC hu.1 u) hu.2)) > R.mul (R.mul hu.1 u) x
     =< sym (R.mulA hu.1 u x) > R.mul hu.1 (R.mul u x)
     =< ap (R.mul hu.1) h > R.mul hu.1 (R.mul u y)
     =< R.mulA hu.1 u y > R.mul (R.mul hu.1 u) y
     =< ap (\ c -> R.mul c y) (trans (R.mulC hu.1 u) hu.2) > R.mul R.o y
     =< L.one-left y > y } ;
 unit-product (u v : R.R) (hu : L.unit u) (hv : L.unit v) : L.unit (R.mul u v) =
   (R.mul hu.1 hv.1,trans (L.mul-four u v hu.1 hv.1)
     (trans (Ps.cong2 R.R R.mul _ _ _ _ hu.2 hv.2) (R.mulO R.o))) ;
 unit-power (u : S.R) (hu : Loc.Powers u) : L.unit (f.1 u) =
   subst L.unit (sym (trans (ap f.1 hu.2) (AffinePowers[l].power-map S R f j hu.1))) (P.Units[setR].power-unit (f.1 j) hj hu.1) ;
 mapF (q : Raw.Fraction) : R.R = R.mul (f.1 q.1) (unit-power q.2.1 q.2.2).1 ;
 fraction (q : Raw.Fraction) : Id R.R (R.mul (f.1 q.2.1) (mapF q)) (f.1 q.1) =
   trans (L.mul-swap (f.1 q.2.1) (f.1 q.1) (unit-power q.2.1 q.2.2).1)
     (trans (ap (R.mul (f.1 q.1)) (unit-power q.2.1 q.2.2).2) (R.mulO (f.1 q.1))) ;
 mul2 (u a b : S.R) : Id R.R (f.1 (S.mul u (S.mul a b))) (R.mul (f.1 u) (R.mul (f.1 a) (f.1 b))) =
   trans (f.2.2.2 u (S.mul a b)) (ap (R.mul (f.1 u)) (f.2.2.2 a b)) ;
 cross (q r : Raw.Fraction) (w : Raw.Witness q r) :
   Id R.R (R.mul (f.1 q.1) (f.1 r.2.1)) (R.mul (f.1 r.1) (f.1 q.2.1)) =
   cancel (f.1 w.1) (unit-power w.1 w.2.1) _ _
     (trans (sym (mul2 w.1 q.1 r.2.1)) (trans (ap f.1 w.2.2) (mul2 w.1 r.1 q.2.1))) ;
 solve (d e a b x y : R.R) (hd : L.unit d) (he : L.unit e)
   (dx : Id R.R (R.mul d x) a) (ey : Id R.R (R.mul e y) b)
   (ab : Id R.R (R.mul a e) (R.mul b d)) : Id R.R x y =
   cancel (R.mul d e) (unit-product d e hd he) x y
     (trans (sym (R.mulA d e x)) (trans (L.mul-swap d e x)
       (trans (ap (R.mul e) dx) (trans (R.mulC e a)
         (trans ab (trans (R.mulC b d) (trans (ap (R.mul d) (sym ey)) (R.mulA d e y)))))))) ;
 witness-respect (q r : Raw.Fraction) (w : Raw.Witness q r) : Id R.R (mapF q) (mapF r) =
   solve (f.1 q.2.1) (f.1 r.2.1) (f.1 q.1) (f.1 r.1) (mapF q) (mapF r)
     (unit-power q.2.1 q.2.2) (unit-power r.2.1 r.2.2) (fraction q) (fraction r) (cross q r w) ;
 respect (q r : Raw.Fraction) (h : Raw.Relation q r) : Id R.R (mapF q) (mapF r) =
   TC.rec (Raw.Witness q r) @l (Id R.R (mapF q) (mapF r)) (setR _ _) (witness-respect q r) h ;
 module Descend = Q.Descend[R.R,setR,mapF,respect] ;
 map : Loc.ring.R -> R.R = Descend.map ;
 beta (q : Raw.Fraction) : Id R.R (map (Loc.L.include q)) (mapF q) = Descend.beta q ;
 add-denominator (q r : Raw.Fraction) :
   Id R.R (R.mul (f.1 (Raw.addF q r).2.1) (R.add (mapF q) (mapF r))) (f.1 (Raw.addF q r).1) =
   trans (ap (\ c -> R.mul c (R.add (mapF q) (mapF r))) (f.2.2.2 q.2.1 r.2.1))
     (trans (R.dist (R.mul (f.1 q.2.1) (f.1 r.2.1)) (mapF q) (mapF r))
       (trans (Ps.cong2 R.R R.add _ _ _ _
         (trans (sym (R.mulA (f.1 q.2.1) (f.1 r.2.1) (mapF q)))
           (trans (L.mul-swap (f.1 q.2.1) (f.1 r.2.1) (mapF q))
             (trans (ap (R.mul (f.1 r.2.1)) (fraction q)) (R.mulC (f.1 r.2.1) (f.1 q.1)))))
         (trans (sym (R.mulA (f.1 q.2.1) (f.1 r.2.1) (mapF r)))
           (trans (ap (R.mul (f.1 q.2.1)) (fraction r)) (R.mulC (f.1 q.2.1) (f.1 r.1)))))
         (trans (Ps.cong2 R.R R.add _ _ _ _ (sym (f.2.2.2 q.1 r.2.1)) (sym (f.2.2.2 r.1 q.2.1)))
           (sym (f.2.2.1 (S.mul q.1 r.2.1) (S.mul r.1 q.2.1)))))) ;
 mul-denominator (q r : Raw.Fraction) :
   Id R.R (R.mul (f.1 (Raw.mulF q r).2.1) (R.mul (mapF q) (mapF r))) (f.1 (Raw.mulF q r).1) =
   trans (ap (\ c -> R.mul c (R.mul (mapF q) (mapF r))) (f.2.2.2 q.2.1 r.2.1))
     (trans (L.mul-four (f.1 q.2.1) (f.1 r.2.1) (mapF q) (mapF r))
       (trans (Ps.cong2 R.R R.mul _ _ _ _ (fraction q) (fraction r)) (sym (f.2.2.2 q.1 r.1)))) ;
 addF (q r : Raw.Fraction) : Id R.R (mapF (Raw.addF q r)) (R.add (mapF q) (mapF r)) =
   cancel (f.1 (Raw.addF q r).2.1) (unit-power (Raw.addF q r).2.1 (Raw.addF q r).2.2) _ _
     (trans (fraction (Raw.addF q r)) (sym (add-denominator q r))) ;
 mulF (q r : Raw.Fraction) : Id R.R (mapF (Raw.mulF q r)) (R.mul (mapF q) (mapF r)) =
   cancel (f.1 (Raw.mulF q r).2.1) (unit-power (Raw.mulF q r).2.1 (Raw.mulF q r).2.2) _ _
     (trans (fraction (Raw.mulF q r)) (sym (mul-denominator q r))) ;
 constant (a : S.R) : Id R.R (map (Loc.inclusion.1 a)) (f.1 a) =
   trans (beta (Raw.constantF a))
     (cancel (f.1 S.o) (unit-power S.o Loc.one) _ _
       (trans (fraction (Raw.constantF a)) (sym (trans (ap (\ c -> R.mul c (f.1 a)) f.2.1) (L.one-left (f.1 a)))))) ;
 one : Id R.R (map Loc.ring.o) R.o = trans (constant S.o) f.2.1 ;
 add (x y : Loc.ring.R) : Id R.R (map (Loc.ring.add x y)) (R.add (map x) (map y)) =
   Loc.L.forall2 (\ x y -> Id R.R (map (Loc.ring.add x y)) (R.add (map x) (map y))) (\ x y -> setR _ _)
     (\ q r -> trans (ap map (Loc.L.Add.beta q r))
       (trans (beta (Raw.addF q r)) (trans (addF q r) (Ps.cong2 R.R R.add _ _ _ _ (sym (beta q)) (sym (beta r)))))) x y ;
 mul (x y : Loc.ring.R) : Id R.R (map (Loc.ring.mul x y)) (R.mul (map x) (map y)) =
   Loc.L.forall2 (\ x y -> Id R.R (map (Loc.ring.mul x y)) (R.mul (map x) (map y))) (\ x y -> setR _ _)
     (\ q r -> trans (ap map (Loc.L.Multiply.beta q r))
       (trans (beta (Raw.mulF q r)) (trans (mulF q r) (Ps.cong2 R.R R.mul _ _ _ _ (sym (beta q)) (sym (beta r)))))) x y ;
 hom : RH.Hom Loc.ring R = (map,one,add,mul) ;
} ;
