-- Coefficient-preserving restrictions compose and are identity on an
-- unchanged chart, by the proved coefficient extensionality theorem.
level l ; open Ring[l] ; open Laurent4[l] ;
module Pr = Prelude[l] ; module C = ChartLaurentRing4[l] ; module R = ChartRestriction4[l] ;
le-fl : (f : Fl) -> Le f f = split { outside -> tt ; inside -> tt } ;
le-self : (E : Sub4) -> Le4 E E = split { sub a b c d -> (le-fl a,(le-fl b,(le-fl c,le-fl d))) } ;
module Identity (A : CRing) (setA : Pr.isSet A.R) (E : Sub4) {
 module Map = R.Over[A,setA,E,E,le-self E] ;
 equation (x : Map.Source.ring.R) : Id Map.Source.ring.R (Map.hom.1 x) x = Map.Source.ext _ _ (Map.coefficient x) ;
} ;
module Composition (A : CRing) (setA : Pr.isSet A.R) (E F G : Sub4) (ef : Le4 E F) (fg : Le4 F G) (eg : Le4 E G) {
 module EF = R.Over[A,setA,E,F,ef] ; module FG = R.Over[A,setA,F,G,fg] ; module EG = R.Over[A,setA,E,G,eg] ;
 equation (x : EF.Source.ring.R) : Id EG.Target.ring.R (FG.hom.1 (EF.hom.1 x)) (EG.hom.1 x) =
   EG.Target.ext _ _ (\ m -> trans (FG.coefficient (EF.hom.1 x) m) (trans (EF.coefficient x m) (sym (EG.coefficient x m)))) ;
} ;
