-- Project native chart Laurent elements to any fixed projective degree.
-- Finite support and chart support survive coefficient selection. The
-- resulting map to actual homogeneous chart cochains is A-linear.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module IP = IdealPowers[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ; module LG = Logic[l] ;
module FP = FinitePolynomial4[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : Sub4) {
 module R = ChartLaurentRing4[l].Over[A,setA,E] ; module B = R.B ;
 module V = ChartCoefficientSupport4[l].Over[A,setA,E] ; module LO = Laurent4[l].Over[A,setA] ;
 module RR = RL[R.ring] ; module AL = RL[A] ;
 c1 : RH.Hom A B.L1.T = B.L1.X.inclusion ;
 c2 : RH.Hom A B.L2.T = RH.compose A B.L1.T B.L2.T B.L2.X.inclusion c1 ;
 c3 : RH.Hom A B.L3.T = RH.compose A B.L2.T B.L3.T B.L3.X.inclusion c2 ;
 constants : RH.Hom A R.S = RH.compose A B.L3.T R.S B.L4.X.inclusion c3 ;
 iota : RH.Hom A R.ring = RH.compose A R.S R.ring R.inclusion constants ;
 moduleM : IP.Mod[A] = IP.mkMod A R.ring.R R.ring.z R.ring.add R.ring.neg
   R.ring.addA R.ring.addC R.ring.addZ R.ring.addN (\ a x -> R.ring.mul (iota.1 a) x)
   (\ a b x -> trans (R.ring.mulA (iota.1 a) (iota.1 b) x) (ap (\ c -> R.ring.mul c x) (sym (iota.2.2.2 a b))))
   (\ x -> trans (ap (\ c -> R.ring.mul c x) iota.2.1) (RR.one-left x))
   (\ a x y -> R.ring.dist (iota.1 a) x y)
   (\ a b x -> trans (ap (\ c -> R.ring.mul c x) (iota.2.2.1 a b)) (RR.dist-left (iota.1 a) (iota.1 b) x)) ;
 constant-polynomial (a : A.R) : Id R.S.R (B.phi (cons (a,LaurentPowerRing4[l].zeroN) nil)) (B.cst a) =
   trans (R.S.addZ (B.term a LaurentPowerRing4[l].zeroN)) (B.term-zero a) ;
 coeff-sm (a : A.R) (x : R.ring.R) (m : E4) : Id A.R (R.coeff (moduleM.sm a x) m) (A.mul a (R.coeff x m)) =
   trans (ap (\ c -> R.coeff (R.ring.mul c x) m) (ap R.inclusion.1 (sym (constant-polynomial a))))
     (trans (R.coeff-mul-polynomial (cons (a,LaurentPowerRing4[l].zeroN) nil) x m)
       (trans (A.addZ (A.mul a (R.coeff x (subE m LaurentPowerRing4[l].zeroN))))
         (ap (\ u -> A.mul a (R.coeff x u)) (LaurentPowerRing4[l].sub-zero m)))) ;
 select-cong (k : Int) (m : E4) (x y : A.R) (e : Id A.R x y) :
   Id A.R (FP.sel A x (Id Int (deg m) k) (int-dec (deg m) k)) (FP.sel A y (Id Int (deg m) k) (int-dec (deg m) k)) =
   ap (\ c -> FP.sel A c (Id Int (deg m) k) (int-dec (deg m) k)) e ;
 select-add (P : U l) (x y : A.R) : (d : LG.Dec P) ->
   Id A.R (FP.sel A (A.add x y) P d) (A.add (FP.sel A x P d) (FP.sel A y P d)) = split {
   yes h -> refl (A.add x y) ; no ne -> sym (A.addZ A.z) } ;
 select-sm (P : U l) (a x : A.R) : (d : LG.Dec P) ->
   Id A.R (FP.sel A (A.mul a x) P d) (A.mul a (FP.sel A x P d)) = split {
   yes h -> refl (A.mul a x) ; no ne -> sym (AL.mul-zero a) } ;
 select-zero (P : U l) (x : A.R) (e : Id A.R x A.z) (d : LG.Dec P) : Id A.R (FP.sel A x P d) A.z =
   trans (ap (\ c -> FP.sel A c P d) e) (FP.sel-zero A P d) ;
 module Part (k : Int) {
   value (x : R.ring.R) (m : E4) : A.R = FP.sel A (R.coeff x m) (Id Int (deg m) k) (int-dec (deg m) k) ;
   at (x : R.ring.R) (m : E4) (e : Id Int (deg m) k) : Id A.R (value x m) (R.coeff x m) =
     FP.sel-yes A (R.coeff x m) (Id Int (deg m) k) e (int-dec (deg m) k) ;
   zero (x : R.ring.R) (m : E4) (ne : Not (Id Int (deg m) k)) : Id A.R (value x m) A.z =
     FP.sel-no A (R.coeff x m) (Id Int (deg m) k) ne (int-dec (deg m) k) ;
   van (x : R.ring.R) (m : E4) : Cech4[l].Bad k E m -> Id A.R (value x m) A.z = split {
     inl ne -> zero x m ne ;
     inr b -> select-zero (Id Int (deg m) k) (R.coeff x m) (V.van x m b) (int-dec (deg m) k) } ;
   module Into (I : U l) {
     module C = LO.Chart[I,\ i -> Cech4[l].Bad k E] ;
     support (x : R.ring.R) : C.Supp (\ i -> value x) = TC.map (R.Support (R.coeff x)) (C.SuppW (\ i -> value x))
       (\ w -> (w.1,\ i m nm -> select-zero (Id Int (deg m) k) (R.coeff x m) (w.2 m nm) (int-dec (deg m) k))) (R.finite x) ;
     element (x : R.ring.R) : C.El = C.mk (\ i -> value x) (support x) (\ i -> van x) ;
     add (x y : R.ring.R) : Id C.El (element (R.ring.add x y)) (C.mod.madd (element x) (element y)) =
       C.eq _ _ (\ i m -> trans (select-cong k m _ _ (R.coeff-add x y m))
         (select-add (Id Int (deg m) k) (R.coeff x m) (R.coeff y m) (int-dec (deg m) k))) ;
     sm (a : A.R) (x : R.ring.R) : Id C.El (element (moduleM.sm a x)) (C.mod.sm a (element x)) =
       C.eq _ _ (\ i m -> trans (select-cong k m _ _ (coeff-sm a x m))
         (select-sm (Id Int (deg m) k) a (R.coeff x m) (int-dec (deg m) k))) ;
     lin : IP.Lin[A,moduleM,C.mod] = IP.mkLin A moduleM C.mod element add sm ;
   } ;
 } ;
} ;
