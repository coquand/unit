-- Actual chart normalisation/restriction/projection regressions.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module N = ChartRestrictionNaturality4[l] ; module C = ChartCoordinates4[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module Z = C.Over[A,setA,setPt p0] ; module IZ = Z.Inverse[p0,N.le-self (setPt p0)] ;
 module Edge = C.Over[A,setA,setEd e01] ; module EZ = Edge.Inverse[p0,ok4] ; module EX = Edge.Inverse[p1,ok4] ;
 module Restr = ChartRestriction4[l].Over[A,setA,setPt p0,setEd e01,ok4] ;
 module RI = C.Restriction[A,setA,setPt p0,setEd e01,ok4].Inverse[p0,N.le-self (setPt p0),ok4] ;
 inverse-on-edge : Id Edge.R.ring.R (Restr.hom.1 IZ.inverse) EZ.inverse = RI.equation ;
 coefficient-on-edge (m : E4) : Id A.R (Edge.R.coeff (Restr.hom.1 IZ.inverse) m) (Z.R.FP.delta0 (addE m (C.unitN p0))) =
   trans (Restr.coefficient IZ.inverse m) (IZ.coefficient m) ;
 module PartZ = ChartInversePart4[l].Over[A,setA,setPt p0,p0,N.le-self (setPt p0)] ;
 normalisation (m : E4) : Id A.R (PartZ.P.value IZ.inverse m) (Z.R.FP.delta0 (addE m (nx (suc zero) zero zero zero))) = PartZ.coefficient m ;
 module MP = ChartPartMultiplication4[l].Over[A,setA,setEd e01] ;
 px : TPoly A.R = cons (A.o,C.unitN p1) nil ;
 hp : HomogeneousMatrices4[l].HomDeg A.R (suc zero) px = (C.size-unit p1,tt) ;
 module Projection = MP.Product[zeroZ,suc zero,px,hp] ;
 project-multiplication (x : Edge.R.ring.R) :
   Id Projection.Target.C.El (Projection.Target.element (Projection.product x)) (Projection.Act.lin.f (Projection.Source.element x)) = Projection.equation x ;
 module Empty = ChartCoefficientSupport4[l].Over[A,setA,ShiftedCech4[l].none] ;
 polynomial-chart (x : Empty.R.ring.R) (m : E4) (b : Out ShiftedCech4[l].none m) : Id A.R (Empty.R.coeff x m) A.z = Empty.van x m b ;
 module Path = N.Composition[A,setA,setPt p0,setEd e01,full,ok4,ok4,ok4] ;
 restriction-composition (x : Z.R.ring.R) : Id Path.EG.Target.ring.R (Path.FG.hom.1 (Path.EF.hom.1 x)) (Path.EG.hom.1 x) = Path.equation x ;
} ;
