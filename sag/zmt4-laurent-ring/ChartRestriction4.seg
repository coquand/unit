-- Restriction along E subset F. J_E times the complementary monomial is
-- J_F, so J_E is invertible in the native F-chart ring. The constructed
-- localisation-to-unit map is a ring homomorphism and preserves every
-- Laurent coefficient. No chart equality or inverse law is assumed.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module RH = RingHom[l] ;
module CL = ChartLaurentRing4[l] ; module NA = NatArith[l] ;
rest : Fl -> Fl -> Fl = split { outside -> \ f -> f ; inside -> \ f -> outside } ;
complement : Sub4 -> Sub4 -> Sub4 = split {
 sub e0 e1 e2 e3 -> split { sub f0 f1 f2 f3 -> sub (rest e0 f0) (rest e1 f1) (rest e2 f2) (rest e3 f3) } } ;
entry-sum : (e f : Fl) -> Le e f -> Id Base.Nat (NA.plus (CL.entry e (suc zero)) (CL.entry (rest e f) (suc zero))) (CL.entry f (suc zero)) = split {
 outside -> \ f h -> refl (CL.entry f (suc zero)) ;
 inside -> split {
   outside -> \ h -> absurd (Id Base.Nat (NA.plus (CL.entry inside (suc zero)) (CL.entry (rest inside outside) (suc zero))) (CL.entry outside (suc zero))) h ;
   inside -> \ h -> refl (suc zero) } } ;
mask-sum : (E F : Sub4) -> Le4 E F ->
 Id N4 (addN4 (CL.direction E (suc zero)) (CL.direction (complement E F) (suc zero))) (CL.direction F (suc zero)) = split {
 sub e0 e1 e2 e3 -> split { sub f0 f1 f2 f3 -> \ h -> nx-eq _ _ _ _ _ _ _ _
   (entry-sum e0 f0 h.1) (entry-sum e1 f1 h.2.1) (entry-sum e2 f2 h.2.2.1) (entry-sum e3 f3 h.2.2.2) } } ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E F : Sub4) (le : Le4 E F) {
 module Source = CL.Over[A,setA,E] ; module Target = CL.Over[A,setA,F] ;
 module B = Source.B ; S : CRing = Source.S ; module P = Source.PW ;
 R : CRing = Target.ring ; module RL = Ring[l].RL[Target.ring] ;
 C : S.R = B.term A.o (CL.direction (complement E F) (suc zero)) ;
 factor : Id S.R (S.mul Source.J C) Target.J =
   trans (B.term-mul A.o A.o (CL.direction E (suc zero)) (CL.direction (complement E F) (suc zero)))
     (trans (ap (\ c -> B.term c (addN4 (CL.direction E (suc zero)) (CL.direction (complement E F) (suc zero)))) (A.mulO A.o))
       (ap (B.term A.o) (mask-sum E F le))) ;
 image-factor : Id R.R (R.mul (Target.inclusion.1 Source.J) (Target.inclusion.1 C)) (Target.inclusion.1 Target.J) =
   trans (sym (Target.inclusion.2.2.2 Source.J C)) (ap Target.inclusion.1 factor) ;
 invertible : RL.unit (Target.inclusion.1 Source.J) =
   (R.mul (Target.inclusion.1 C) Target.Loc.invertible.1,
    trans (R.mulA (Target.inclusion.1 Source.J) (Target.inclusion.1 C) Target.Loc.invertible.1)
      (trans (ap (\ x -> R.mul x Target.Loc.invertible.1) image-factor) Target.Loc.invertible.2)) ;
 module Map = PowerLocalizationToUnit[l].Over[S,Target.ring,Target.set,Target.inclusion,Source.J,invertible] ;
 hom : RH.Hom Source.ring Target.ring = Map.hom ;
 constant (x : S.R) : Id R.R (hom.1 (Source.inclusion.1 x)) (Target.inclusion.1 x) = Map.constant x ;
 coeff-term (c : A.R) (u : N4) (x : R.R) (m : E4) :
   Id A.R (Target.coeff (R.mul (Target.inclusion.1 (B.term c u)) x) m) (A.mul c (Target.coeff x (subE m u))) =
   trans (ap (\ s -> Target.coeff (R.mul (Target.inclusion.1 s) x) m) (sym (S.addZ (B.term c u))))
     (trans (Target.coeff-mul-polynomial (cons (c,u) nil) x m) (A.addZ (A.mul c (Target.coeff x (subE m u))))) ;
 coeff-J (x : R.R) (m : E4) : Id A.R (Target.coeff (R.mul (Target.inclusion.1 Source.J) x) m) (Target.coeff x (subE m Source.Dir.oneN)) =
   trans (coeff-term A.o Source.Dir.oneN x m) (Ring[l].RL[A].one-left (Target.coeff x (subE m Source.Dir.oneN))) ;
 coeff-power : (n : Nat) (x : R.R) (m : E4) ->
   Id A.R (Target.coeff (R.mul (Target.inclusion.1 (P.power Source.J n)) x) m) (Target.coeff x (subE m (Source.Dir.diag n))) = split {
   zero -> \ x m -> trans (ap (\ c -> Target.coeff (R.mul c x) m) Target.inclusion.2.1)
     (trans (ap (\ c -> Target.coeff c m) (RL.one-left x)) (ap (Target.coeff x) (sym (Source.Dir.sub-zero m)))) ;
   suc n | rec -> \ x m -> trans (ap (\ c -> Target.coeff (R.mul c x) m) (Target.inclusion.2.2.2 Source.J (P.power Source.J n)))
     (trans (ap (\ c -> Target.coeff c m) (sym (R.mulA (Target.inclusion.1 Source.J) (Target.inclusion.1 (P.power Source.J n)) x)))
       (trans (coeff-J (R.mul (Target.inclusion.1 (P.power Source.J n)) x) m)
         (trans (rec x (subE m Source.Dir.oneN))
           (ap (Target.coeff x) (trans (subE-subE m Source.Dir.oneN (Source.Dir.diag n))
             (ap (subE m) (Source.Dir.diag-step n))))))) } ;
 module Fraction (q : Source.Raw.Fraction) (m : E4) {
   n : Nat = q.2.2.1 ; at : E4 = addE m (Source.Dir.diag n) ;
   equation : Id R.R (R.mul (Target.inclusion.1 (P.power Source.J n)) (Map.mapF q)) (Target.inclusion.1 q.1) =
     trans (ap (\ d -> R.mul (Target.inclusion.1 d) (Map.mapF q)) (sym q.2.2.2)) (Map.fraction q) ;
   result : Id A.R (Target.coeff (hom.1 (Source.Loc.L.include q)) m) (Source.raw-coeff q m) =
     trans (ap (\ x -> Target.coeff x m) (Map.beta q))
       (trans (ap (Target.coeff (Map.mapF q)) (sym (subE-addE m (Source.Dir.diag n))))
         (trans (sym (coeff-power n (Map.mapF q) at))
           (trans (ap (\ x -> Target.coeff x at) equation) (Target.coeff-inclusion q.1 at)))) ;
 } ;
 coefficient (x : Source.ring.R) (m : E4) : Id A.R (Target.coeff (hom.1 x) m) (Source.coeff x m) =
   Source.Q.induction @l (\ x -> Id A.R (Target.coeff (hom.1 x) m) (Source.coeff x m)) (\ x -> setA _ _)
     (\ q -> trans (Fraction[q,m].result) (sym (Source.coeff-fraction q m))) x ;
} ;
