-- Multiplication by a homogeneous polynomial commutes with the native
-- chart degree projection, with the required shift in the input degree.
-- This allows an arbitrary J-witness to be projected term by term.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open Cech4[l] ;
open PolynomialAction4[l] ; open HomogeneousMatrices4[l] ;
module Pr = Prelude[l] ; module IP = IdealPowers[l] ; module FP = FinitePolynomial4[l] ; module LG = Logic[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : Sub4) {
 module D = ChartDegreePart4[l].Over[A,setA,E] ; module R = D.R ;
 module SC = ShiftedCech4[l].Over[A,setA] ; module HM = HomogeneousMatrices4[l].Over[A,setA] ;
 module AL = IP.ModL[A,IP.regular A] ;
 degree-shift (k : Int) (dd : Base.Nat) (m : E4) (u : N4) (hm : Id Int (deg m) k) (hu : Id Base.Nat (size u) dd) :
   Id Int (deg (subE m u)) (minus k dd) =
   trans (deg-subE m u) (trans (ap (\ d -> minus d (size u)) hm) (ap (minus k) hu)) ;
 read-terms (k : Int) (dd : Base.Nat) (x : R.ring.R) :
   (p : TPoly A.R) -> HomDeg A.R dd p -> (m : E4) -> Id Int (deg m) k ->
   Id A.R (R.PA.mulP p (D.Part[minus k dd].value x) m) (R.PA.mulP p (R.coeff x) m) = split {
   nil -> \ hp m hm -> refl A.z ;
   cons t p | rec -> \ hp m hm -> AL.G.cong-add
     (ap (A.mul t.1) (D.Part[minus k dd].at x (subE m t.2) (degree-shift k dd m t.2 hm hp.1))) (rec hp.2 m hm) } ;
 module Product (k : Int) (dd : Base.Nat) (p : TPoly A.R) (hp : HomDeg A.R dd p) {
   module Source = D.Part[minus k dd].Into[Sq] ; module Target = D.Part[k].Into[Sq] ;
   module Act = SC.Act[Sq,\ i -> E,minus k dd,k,p,HM.hg-shifts k dd p hp] ;
   product (x : R.ring.R) : R.ring.R = R.ring.mul (R.inclusion.1 (R.B.phi p)) x ;
   case (x : R.ring.R) (i : Sq) (m : E4) : (q : LG.Dec (Id Int (deg m) k)) ->
     Id A.R (FP.sel A (R.coeff (product x) m) (Id Int (deg m) k) q)
       (Act.CB.val (Act.lin.f (Source.element x)) i m) = split {
     yes hm -> trans (R.coeff-mul-polynomial p x m) (sym (read-terms k dd x p hp m hm)) ;
     no ne -> sym (Act.CB.van (Act.lin.f (Source.element x)) i m (inl (\ h -> Pr.absurd Empty (ne h)))) } ;
   equation (x : R.ring.R) : Id Target.C.El (Target.element (product x)) (Act.lin.f (Source.element x)) =
     Target.C.eq _ _ (\ i m -> case x i m (int-dec (deg m) k)) ;
 } ;
} ;
