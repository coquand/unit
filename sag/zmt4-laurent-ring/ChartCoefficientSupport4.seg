-- Every element of the native chart localisation is chart-supported.
-- The denominator shifts only inverted coordinates; a negative exponent
-- outside the chart therefore remains negative in the polynomial numerator.
level l ; open Ring[l] ; open ZInt[l] ; open Laurent4[l] ; open PolynomialAction4[l] ;
module Pr = Prelude[l] ; module TC = TruncationCombinators[l] ;
module CL = ChartLaurentRing4[l] ;
out-entry : (f : Fl) (n : Nat) (x : Int) -> gate f (Neg x) -> Neg (addP x (CL.entry f n)) = split {
 outside -> \ n x h -> h ; inside -> \ n x h -> absurd (Neg (addP x (CL.entry inside n))) h } ;
out-direction : (E : Sub4) (n : Nat) (m : E4) -> Out E m -> Out ShiftedCech4[l].none (addE m (CL.direction E n)) = split {
 sub f0 f1 f2 f3 -> \ n -> outDir f0 f1 f2 f3 n }
where {
 outDir (f0 f1 f2 f3 : Fl) (n : Nat) : (m : E4) -> Out (sub f0 f1 f2 f3) m ->
   Out ShiftedCech4[l].none (addE m (CL.direction (sub f0 f1 f2 f3) n)) = split {
   ex a b c d -> split {
     o0 h -> o0 (out-entry f0 n a h) ; o1 h -> o1 (out-entry f1 n b h) ;
     o2 h -> o2 (out-entry f2 n c h) ; o3 h -> o3 (out-entry f3 n d h) } } } ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : Sub4) {
 module R = CL.Over[A,setA,E] ;
 polynomial-negative (x : R.S.R) (m : E4) (h : Out ShiftedCech4[l].none m) : Id A.R (R.B.psi x m) A.z =
   TC.rec (R.B.RepW x) @l (Id A.R (R.B.psi x m) A.z) (setA _ _)
     (\ p -> trans (ap (\ z -> R.B.psi z m) (sym p.2)) (trans (R.B.psi-phi m p.1) (R.FP.cf-neg m h p.1))) (R.B.rep x) ;
 van (x : R.ring.R) (m : E4) (h : Out E m) : Id A.R (R.coeff x m) A.z =
   R.Q.induction @l (\ x -> Id A.R (R.coeff x m) A.z) (\ x -> setA _ _)
     (\ q -> trans (R.coeff-fraction q m)
       (polynomial-negative q.1 (addE m (R.Dir.diag q.2.2.1)) (out-direction E q.2.2.1 m h))) x ;
} ;
