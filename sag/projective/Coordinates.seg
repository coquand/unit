-- Homogeneous coordinates, normalized using merely a unit coordinate.
-- No choice of chart is retained in the point.
level l ;
open Algebra[l] ;
module P = Prelude[l] ;
module Coordinates (ring : CRing) (setR : P.isSet ring.R) {
 open ring ; open RL[ring] ; open RingFacts[l].Facts[ring] ;
 module L = Projective[l].Line[ring,setR] ; open L ;
 Choice (x y : R) : U l = Plus (unit x) (unit y) ;
 Covered (x y : R) : U l = Truncation[l].Trunc[Choice x y].carrier ;
 unit-prop (x : R) : P.isProp (unit x) = \ u v ->
   P.Sigma-eq R (\ c -> Id R (mul x c) o) u.1 v.1 u.2 v.2
     (inverse-unique x u.1 v.1 u.2 v.2) (setR (mul x v.1) o) ;
 normalize (x y : R) : Choice x y -> C = split {
   inl u -> hi (mul y u.1) ; inr v -> lo (mul x v.1) } ;
 reciprocal (x y : R) (u : unit x) (v : unit y) : Id R (mul (mul y u.1) (mul x v.1)) o =
   trans (ap (mul (mul y u.1)) (mulC x v.1))
    (trans (four y u.1 v.1 x)
     (trans (ap (\ t -> mul t (mul u.1 x)) v.2)
      (trans (ap (mul o) (trans (mulC u.1 x) u.2)) (mulO o)))) ;
 independent (x y : R) : (c d : Choice x y) -> Id P1 (point (normalize x y c)) (point (normalize x y d)) = split {
  inl u -> split {
   inl v -> ap (\ w -> infinity-chart (mul y w.1)) (unit-prop x u v) ;
   inr v -> Q.relates (hi (mul y u.1)) (lo (mul x v.1)) (reciprocal x y u v) } ;
  inr u -> split {
   inl v -> sym (Q.relates (hi (mul y v.1)) (lo (mul x u.1)) (reciprocal x y v u)) ;
   inr v -> ap (\ w -> affine (mul x w.1)) (unit-prop y u v) } } ;
 module Normalization (x y : R) {
   module M = TruncatedMap[l].Map[Choice x y,P1,Q.set,\ c -> point (normalize x y c),independent x y] ;
 } ;
 homogeneous (x y : R) (h : Covered x y) : P1 = Normalization[x,y].M.map h ;
 beta (x y : R) (h : Covered x y) (c : Choice x y) : Id P1 (homogeneous x y h) (point (normalize x y c)) =
   Normalization[x,y].M.beta h c ;
 square-unit (x : R) (u : unit x) : unit (square x) = (square u.1,square-inverse x u.1 u.2) ;
 square-choice (x y : R) : Choice x y -> Choice (square x) (square y) = split {
   inl u -> inl (square-unit x u) ; inr v -> inr (square-unit y v) } ;
 square-cover (x y : R) (h : Covered x y) : Covered (square x) (square y) =
   Truncation[l].Trunc[Choice x y].induction @l (\ t -> Covered (square x) (square y))
     (\ t -> Truncation[l].Trunc[Choice (square x) (square y)].proposition)
     (\ c -> Truncation[l].Trunc[Choice (square x) (square y)].inc (square-choice x y c)) h ;
 normalize-square (x y : R) : (c : Choice x y) ->
   Id P1 (point (chart-square (normalize x y c))) (point (normalize (square x) (square y) (square-choice x y c))) = split {
    inl u -> ap infinity-chart (four y u.1 y u.1) ;
    inr v -> ap affine (four x v.1 x v.1) } ;
 square-formula (x y : R) (h : Covered x y) (k : Covered (square x) (square y)) :
   Id P1 (squaring (homogeneous x y h)) (homogeneous (square x) (square y) k) =
   Truncation[l].Trunc[Choice x y].induction @l
    (\ t -> Id P1 (squaring (homogeneous x y h)) (homogeneous (square x) (square y) k))
    (\ t -> Q.set _ _) (\ c -> trans (ap squaring (beta x y h c))
      (trans (Squaring.beta (normalize x y c))
        (trans (normalize-square x y c) (sym (beta (square x) (square y) k (square-choice x y c)))))) h ;
 product-unit (c x : R) (u : unit c) (v : unit x) : unit (mul c x) =
   (mul u.1 v.1,trans (four c x u.1 v.1)
     (trans (ap (\ t -> mul t (mul x v.1)) u.2) (trans (ap (mul o) v.2) (mulO o)))) ;
 scaled-choice (c x y : R) (u : unit c) : Choice x y -> Choice (mul c x) (mul c y) = split {
   inl v -> inl (product-unit c x u v) ; inr v -> inr (product-unit c y u v) } ;
 scaled-cover (c x y : R) (u : unit c) (h : Covered x y) : Covered (mul c x) (mul c y) =
   Truncation[l].Trunc[Choice x y].induction @l (\ t -> Covered (mul c x) (mul c y))
     (\ t -> Truncation[l].Trunc[Choice (mul c x) (mul c y)].proposition)
     (\ v -> Truncation[l].Trunc[Choice (mul c x) (mul c y)].inc (scaled-choice c x y u v)) h ;
 cancel-ratio (c a b : R) (u : unit c) : Id R (mul (mul c a) (mul u.1 b)) (mul a b) =
   trans (four c a u.1 b)
     (trans (ap (\ t -> mul t (mul a b)) u.2) (trans (mulC o (mul a b)) (mulO (mul a b)))) ;
 normalize-scaled (c x y : R) (u : unit c) : (v : Choice x y) ->
   Id P1 (point (normalize (mul c x) (mul c y) (scaled-choice c x y u v))) (point (normalize x y v)) = split {
    inl v -> ap infinity-chart (cancel-ratio c y v.1 u) ;
    inr v -> ap affine (cancel-ratio c x v.1 u) } ;
 scaling (c x y : R) (u : unit c) (h : Covered x y) (k : Covered (mul c x) (mul c y)) :
   Id P1 (homogeneous (mul c x) (mul c y) k) (homogeneous x y h) =
   Truncation[l].Trunc[Choice x y].induction @l
    (\ t -> Id P1 (homogeneous (mul c x) (mul c y) k) (homogeneous x y h))
    (\ t -> Q.set _ _) (\ v -> trans (beta (mul c x) (mul c y) k (scaled-choice c x y u v))
      (trans (normalize-scaled c x y u v) (sym (beta x y h v)))) h ;
} ;
