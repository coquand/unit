-- The projective line by gluing its two standard affine charts.
-- lo a = [a:1], hi b = [1:b], overlap a*b=1.
level l ;
open Algebra[l] ;
module P = Prelude[l] ;
data Chart (R : U l) : U l = lo (a : R) | hi (b : R) ;

module Line (ring : CRing) (setR : P.isSet ring.R) {
 open ring ; open RL[ring] ; open RingFacts[l].Facts[ring] ;
 C : U l = Chart R ;
 relation : C -> C -> U l = split {
  lo a -> split { lo b -> Id R a b ; hi b -> Id R (mul a b) o } ;
  hi a -> split { lo b -> Id R (mul a b) o ; hi b -> Id R a b } } ;
 relation-prop : (u v : C) -> P.isProp (relation u v) = split {
  lo a -> split { lo b -> setR a b ; hi b -> setR (mul a b) o } ;
  hi a -> split { lo b -> setR (mul a b) o ; hi b -> setR a b } } ;
 relation-refl : (u : C) -> relation u u = split { lo a -> refl a ; hi b -> refl b } ;
 relation-sym : (u v : C) -> relation u v -> relation v u = split {
  lo a -> split { lo b -> \ p -> sym p ; hi b -> \ p -> trans (mulC b a) p } ;
  hi a -> split { lo b -> \ p -> trans (mulC b a) p ; hi b -> \ p -> sym p } } ;
 relation-trans : (u v w : C) -> relation u v -> relation v w -> relation u w = split {
  lo a -> split {
   lo b -> split {
    lo c -> \ p q -> trans p q ;
    hi c -> \ p q -> trans (ap (\ t -> mul t c) p) q } ;
   hi b -> split {
    lo c -> \ p q -> inverse-unique b a c (trans (mulC b a) p) q ;
    hi c -> \ p q -> trans (ap (mul a) (sym q)) p } } ;
  hi a -> split {
   lo b -> split {
    lo c -> \ p q -> trans (ap (mul a) (sym q)) p ;
    hi c -> \ p q -> inverse-unique b a c (trans (mulC b a) p) q } ;
   hi b -> split {
    lo c -> \ p q -> trans (ap (\ t -> mul t c) p) q ;
    hi c -> \ p q -> trans p q } } } ;
 module Q = Quotient[l].Quot[C,relation,relation-prop,relation-refl,relation-sym,relation-trans] ;
 P1 : U l = Q.Q ;
 point : C -> P1 = Q.inc ;
 affine (a : R) : P1 = point (lo a) ;
 infinity-chart (a : R) : P1 = point (hi a) ;
 affine-injective (a b : R) (p : Id P1 (affine a) (affine b)) : Id R a b = Q.effective (lo a) (lo b) p ;
 overlap (a b : R) (p : Id R (mul a b) o) : Id P1 (affine a) (infinity-chart b) = Q.relates (lo a) (hi b) p ;
 chart-square : C -> C = split { lo a -> lo (square a) ; hi a -> hi (square a) } ;
 square-respects : (u v : C) -> relation u v -> relation (chart-square u) (chart-square v) = split {
  lo a -> split { lo b -> \ p -> ap square p ; hi b -> square-inverse a b } ;
  hi a -> split { lo b -> square-inverse a b ; hi b -> \ p -> ap square p } } ;
 module Squaring = Q.Descend[P1,Q.set,\ c -> point (chart-square c),
   \ u v h -> Q.relates (chart-square u) (chart-square v) (square-respects u v h)] ;
 squaring : P1 -> P1 = Squaring.map ;
 affine-beta (a : R) : Id P1 (squaring (affine a)) (affine (square a)) = Squaring.beta (lo a) ;
 infinity-beta (a : R) : Id P1 (squaring (infinity-chart a)) (infinity-chart (square a)) = Squaring.beta (hi a) ;
} ;
