-- The chart construction is equivalent to the homogeneous-coordinate
-- quotient of unimodular pairs by unit scaling.
level l ;
open Algebra[l] ;
module P = Prelude[l] ;
module QuotientLine (ring : CRing) (setR : P.isSet ring.R) {
 open ring ; open RL[ring] ; open RingFacts[l].Facts[ring] ;
 module N = Coordinates[l].Coordinates[ring,setR] ; open N ;
 module L = Projective[l].Line[ring,setR] ; open L ;
 V : U l = R * R ;
 Raw : U l = (v : V) * Covered v.1 v.2 ;
 Units : U l = (c : R) * unit c ;
 oneUnit : unit o = (o,mulO o) ;
 left-one (a : R) : Id R (mul o a) a = trans (mulC o a) (mulO a) ;
 Scaled (v w : V) : U l = (u : Units) * (Id R v.1 (mul u.1 w.1) * Id R v.2 (mul u.1 w.2)) ;
 scaled-refl (v : V) : Scaled v v = ((o,oneUnit),(sym (left-one v.1),sym (left-one v.2))) ;
 unscl (c a b : R) (u : unit c) (p : Id R a (mul c b)) : Id R b (mul u.1 a) =
   sym (trans (ap (mul u.1) p)
    (trans (mulA u.1 c b) (trans (ap (\ t -> mul t b) (trans (mulC u.1 c) u.2)) (left-one b)))) ;
 scaled-sym (v w : V) (s : Scaled v w) : Scaled w v =
   ((s.1.2.1,(s.1.1,trans (mulC s.1.2.1 s.1.1) s.1.2.2)),
     (unscl s.1.1 v.1 w.1 s.1.2 s.2.1,unscl s.1.1 v.2 w.2 s.1.2 s.2.2)) ;
 scaled-trans (v w t : V) (s : Scaled v w) (r : Scaled w t) : Scaled v t =
   ((mul s.1.1 r.1.1,product-unit s.1.1 r.1.1 s.1.2 r.1.2),
    (trans s.2.1 (trans (ap (mul s.1.1) r.2.1) (mulA s.1.1 r.1.1 t.1)),
     trans s.2.2 (trans (ap (mul s.1.1) r.2.2) (mulA s.1.1 r.1.1 t.2)))) ;
 relation (u v : Raw) : U l = Truncation[l].Trunc[Scaled u.1 v.1].carrier ;
 relation-prop (u v : Raw) : P.isProp (relation u v) = Truncation[l].Trunc[Scaled u.1 v.1].proposition ;
 rr (u : Raw) : relation u u = Truncation[l].Trunc[Scaled u.1 u.1].inc (scaled-refl u.1) ;
 rs (u v : Raw) (h : relation u v) : relation v u =
   Truncation[l].Trunc[Scaled u.1 v.1].induction @l (\ t -> relation v u) (\ t -> relation-prop v u)
    (\ s -> Truncation[l].Trunc[Scaled v.1 u.1].inc (scaled-sym u.1 v.1 s)) h ;
 rt (u v w : Raw) (h : relation u v) (k : relation v w) : relation u w =
   Truncation[l].Trunc[Scaled u.1 v.1].induction @l (\ t -> relation u w) (\ t -> relation-prop u w)
    (\ s -> Truncation[l].Trunc[Scaled v.1 w.1].induction @l (\ t -> relation u w) (\ t -> relation-prop u w)
      (\ r -> Truncation[l].Trunc[Scaled u.1 w.1].inc (scaled-trans u.1 v.1 w.1 s r)) k) h ;
 module HQ = Quotient[l].Quot[Raw,relation,relation-prop,rr,rs,rt] ;
 hom (u : Raw) : P1 = homogeneous u.1.1 u.1.2 u.2 ;
 raw-equal (u v : Raw) (p : Id R u.1.1 v.1.1) (q : Id R u.1.2 v.1.2) : Id Raw u v =
   P.Sigma-eq V (\ w -> Covered w.1 w.2) u.1 v.1 u.2 v.2
    (P.trans V u.1 (v.1.1,u.1.2) v.1
      (P.ap R V (\ x -> (x,u.1.2)) u.1.1 v.1.1 p)
      (P.ap R V (\ y -> (v.1.1,y)) u.1.2 v.1.2 q))
    Truncation[l].Trunc[Choice v.1.1 v.1.2].proposition ;
 scaled-hom (u v : Raw) (s : Scaled u.1 v.1) : Id P1 (hom u) (hom v) =
   trans (ap hom (raw-equal u
     ((mul s.1.1 v.1.1,mul s.1.1 v.1.2),scaled-cover s.1.1 v.1.1 v.1.2 s.1.2 v.2) s.2.1 s.2.2))
     (scaling s.1.1 v.1.1 v.1.2 s.1.2 v.2 (scaled-cover s.1.1 v.1.1 v.1.2 s.1.2 v.2)) ;
 hom-respects (u v : Raw) (h : relation u v) : Id P1 (hom u) (hom v) =
   Truncation[l].Trunc[Scaled u.1 v.1].induction @l (\ t -> Id P1 (hom u) (hom v)) (\ t -> Q.set _ _)
    (scaled-hom u v) h ;
 module To = HQ.Descend[P1,Q.set,hom,hom-respects] ;
 vector : C -> V = split { lo a -> (a,o) ; hi a -> (o,a) } ;
 chartRaw : (c : C) -> Raw = split {
   lo a -> ((a,o),Truncation[l].Trunc[Choice a o].inc (inr oneUnit)) ;
   hi a -> ((o,a),Truncation[l].Trunc[Choice o a].inc (inl oneUnit)) } ;
 chart-vector : (c : C) -> Id V (chartRaw c).1 (vector c) = split {
   lo a -> refl (a,o) ; hi a -> refl (o,a) } ;
 chart-scaled : (u v : C) -> L.relation u v -> Scaled (chartRaw u).1 (chartRaw v).1 = split {
  lo a -> split {
   lo b -> \ p -> ((o,oneUnit),(trans p (sym (left-one b)),sym (left-one o))) ;
   hi b -> \ p -> ((a,(b,p)),(sym (mulO a),sym p)) } ;
  hi a -> split {
   lo b -> \ p -> ((a,(b,p)),(sym p,sym (mulO a))) ;
   hi b -> \ p -> ((o,oneUnit),(sym (left-one o),trans p (sym (left-one b)))) } } ;
 from-respects (u v : C) (h : L.relation u v) : Id HQ.Q (HQ.inc (chartRaw u)) (HQ.inc (chartRaw v)) =
   HQ.relates (chartRaw u) (chartRaw v) (Truncation[l].Trunc[Scaled (chartRaw u).1 (chartRaw v).1].inc (chart-scaled u v h)) ;
 module From = Q.Descend[HQ.Q,HQ.set,\ c -> HQ.inc (chartRaw c),from-respects] ;
 chart-beta : (c : C) -> Id P1 (hom (chartRaw c)) (point c) = split {
   lo a -> trans (beta a o (chartRaw (lo a)).2 (inr oneUnit)) (ap affine (mulO a)) ;
   hi a -> trans (beta o a (chartRaw (hi a)).2 (inl oneUnit)) (ap infinity-chart (mulO a)) } ;
 normalized-rep (x y : R) : (c : Choice x y) -> Scaled (x,y) (chartRaw (normalize x y c)).1 = split {
   inl u -> ((x,u),(sym (mulO x),sym (trans (mul-swap x y u.1) (trans (ap (mul y) u.2) (mulO y))))) ;
   inr v -> ((y,v),(sym (trans (mul-swap y x v.1) (trans (ap (mul x) v.2) (mulO x))),sym (mulO y))) } ;
 from-hom (u : Raw) : Id HQ.Q (From.map (hom u)) (HQ.inc u) =
   Truncation[l].Trunc[Choice u.1.1 u.1.2].induction @l
    (\ t -> Id HQ.Q (From.map (hom u)) (HQ.inc u)) (\ t -> HQ.set _ _)
    (\ c -> trans (ap From.map (beta u.1.1 u.1.2 u.2 c))
      (trans (From.beta (normalize u.1.1 u.1.2 c))
        (HQ.relates (chartRaw (normalize u.1.1 u.1.2 c)) u
          (Truncation[l].Trunc[Scaled (chartRaw (normalize u.1.1 u.1.2 c)).1 u.1].inc
            (scaled-sym u.1 (chartRaw (normalize u.1.1 u.1.2 c)).1 (normalized-rep u.1.1 u.1.2 c)))))) u.2 ;
 to-from (q : P1) : Id P1 (To.map (From.map q)) q = Q.induction @l
   (\ q -> Id P1 (To.map (From.map q)) q) (\ q -> Q.set _ _)
   (\ c -> trans (ap To.map (From.beta c)) (trans (To.beta (chartRaw c)) (chart-beta c))) q ;
 from-to (q : HQ.Q) : Id HQ.Q (From.map (To.map q)) q = HQ.induction @l
   (\ q -> Id HQ.Q (From.map (To.map q)) q) (\ q -> HQ.set _ _)
   (\ u -> trans (ap From.map (To.beta u)) (from-hom u)) q ;
 equivalence : P.Equiv HQ.Q P1 = (To.map,P.qinv HQ.Q P1 To.map From.map to-from from-to) ;

 hom-effective (u v : Raw) (p : Id P1 (hom u) (hom v)) : relation u v =
   HQ.effective u v (trans (sym (from-hom u)) (trans (ap From.map p) (from-hom v))) ;
} ;
