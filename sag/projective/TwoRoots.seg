-- The discrete fibre: local ring, 1 != 0, and 2 invertible.
-- SAG's hypothesis 2 != 0 supplies invertibility via Proposition 2.2.3(a).
level l ;
open Base ;
open Algebra[l] ;
module P = Prelude[l] ;
module Facts (ring : CRing) {
 open ring ; open RL[ring] ; open RingFacts[l].Facts[ring] ;
 two : R = add o o ;
 minus (a : R) : R = add o (neg a) ;
 plus-one (a : R) : R = add o a ;
 negneg (a : R) : Id R (neg (neg a)) a = sym (neg-uniq (neg a) a (trans (addC (neg a) a) (addN a))) ;
 square-neg (a : R) : Id R (square (neg a)) (square a) =
  trans (mul-neg (neg a) a)
    (trans (ap neg (trans (mulC (neg a) a) (mul-neg a a))) (negneg (square a))) ;
 middle (u a v : R) : Id R (add (add u (neg a)) (add a v)) (add u v) =
  calc R { add (add u (neg a)) (add a v)
    =< sym (addA u (neg a) (add a v)) > add u (add (neg a) (add a v))
    =< ap (add u) (addA (neg a) a v) > add u (add (add (neg a) a) v)
    =< ap (\ t -> add u (add t v)) (trans (addC (neg a) a) (addN a)) > add u (add z v)
    =< ap (add u) (zl v) > add u v } ;
 factor (a : R) : Id R (mul (minus a) (plus-one a)) (add o (neg (square a))) =
  calc R { mul (minus a) (plus-one a)
    =< dist (minus a) o a > add (mul (minus a) o) (mul (minus a) a)
    =< ap (\ t -> add t (mul (minus a) a)) (mulO (minus a)) > add (minus a) (mul (minus a) a)
    =< ap (add (minus a)) (trans (mulC (minus a) a) (dist a o (neg a)))
      > add (minus a) (add (mul a o) (mul a (neg a)))
    =< ap (\ t -> add (minus a) (add t (mul a (neg a)))) (mulO a)
      > add (minus a) (add a (mul a (neg a)))
    =< ap (\ t -> add (minus a) (add a t)) (mul-neg a a)
      > add (minus a) (add a (neg (square a)))
    =< middle o a (neg (square a)) > add o (neg (square a)) } ;
 sum-two (a : R) : Id R (add (minus a) (plus-one a)) two =
  trans (swap o (neg a) o a)
    (trans (ap (add two) (trans (addC (neg a) a) (addN a))) (addZ two)) ;
} ;

module Discrete (ring : CRing) (setR : P.isSet ring.R)
 (nontrivial : Id ring.R ring.o ring.z -> Algebra[l].Empty)
 (local : (x y : ring.R) -> RL[ring].unit (ring.add x y) ->
    Truncation[l].Trunc[Plus (RL[ring].unit x) (RL[ring].unit y)].carrier)
 (twoUnit : RL[ring].unit (ring.add ring.o ring.o)) {
 open ring ; open RL[ring] ; open RingFacts[l].Facts[ring] ; open Facts[ring] ;
 module C = Fibres[l].Calculation[ring,setR] ;
 module One = C.At[o] ;
 Root : U l = One.Root ;
 root : Base.Bool -> Root = split {
  true -> (o,square-one) ;
  false -> (neg o,trans (square-neg o) square-one) } ;
 distinct (p : Id R o (neg o)) : Algebra[l].Empty = nontrivial
  (trans (sym twoUnit.2)
    (trans (ap (\ t -> mul t twoUnit.1) (trans (ap (add o) p) (addN o))) (zero-mul twoUnit.1))) ;
 root-injective : (b c : Base.Bool) -> Id Root (root b) (root c) -> Id Base.Bool b c = split {
  true -> split {
    true -> \ p -> refl true ;
    false -> \ p -> absurd (Id Base.Bool true false) (distinct (ap (\ r -> r.1) p)) } ;
  false -> split {
    true -> \ p -> absurd (Id Base.Bool false true) (distinct (sym (ap (\ r -> r.1) p))) ;
    false -> \ p -> refl false } } ;
 root-set : P.isSet Root = P.isSet-Sigma R (\ a -> Id R (square a) o) setR
    (\ a -> P.prop-to-set (Id R (square a) o) (setR (square a) o)) ;
 module E = SurjectiveEmbedding[l].Map[Base.Bool,Root,root-set,root,root-injective] ;
 root-eq (a b : Root) (p : Id R a.1 b.1) : Id Root a b =
   P.Sigma-eq R (\ x -> Id R (square x) o) a.1 b.1 a.2 b.2 p (setR (square b.1) o) ;
 factor-zero (r : Root) : Id R (mul (minus r.1) (plus-one r.1)) z =
   trans (factor r.1) (trans (ap (\ t -> add o (neg t)) r.2) (addN o)) ;
 local-unit (r : Root) : unit (add (minus r.1) (plus-one r.1)) =
   subst unit (sym (sum-two r.1)) twoUnit ;
 choose-root (r : Root) : Plus (unit (minus r.1)) (unit (plus-one r.1)) -> E.Fibre r = split {
  inl u -> (false,root-eq (root false) r
    (sym (neg-uniq o r.1 (unit-reg (minus r.1) (plus-one r.1) u (factor-zero r))))) ;
  inr u -> (true,root-eq (root true) r
    (trans (sym (negneg o))
      (trans (ap neg (sym (neg-uniq o (neg r.1)
        (unit-reg (plus-one r.1) (minus r.1) u (trans (mulC (plus-one r.1) (minus r.1)) (factor-zero r))))))
        (negneg r.1)))) } ;
 cover (r : Root) : Truncation[l].Trunc[E.Fibre r].carrier =
   Truncation[l].Trunc[Plus (unit (minus r.1)) (unit (plus-one r.1))].induction @l
    (\ t -> Truncation[l].Trunc[E.Fibre r].carrier) (\ t -> Truncation[l].Trunc[E.Fibre r].proposition)
    (\ u -> Truncation[l].Trunc[E.Fibre r].inc (choose-root r u))
    (local (minus r.1) (plus-one r.1) (local-unit r)) ;
 roots-equivalence : P.Equiv Base.Bool Root = E.Surjective[cover].equivalence ;
 forward (b : Base.Bool) : One.Fibre = One.forward (root b) ;
 backward (v : One.Fibre) : Base.Bool = roots-equivalence.2.sec (One.backward v) ;
 fb (v : One.Fibre) : Id One.Fibre (forward (backward v)) v =
   trans (ap One.forward (roots-equivalence.2.sec-eq (One.backward v))) (One.fb v) ;
 bf (b : Base.Bool) : Id Base.Bool (backward (forward b)) b =
   trans (ap roots-equivalence.2.sec (One.bf (root b)))
     (P.sec-ret Base.Bool Root root roots-equivalence.2 b) ;
 -- SAG Example 6.1.9, the two-point fibre.
 fibre-equivalence : P.Equiv Base.Bool One.Fibre = (forward,P.qinv _ _ forward backward fb bf) ;
} ;
