-- SAG Lemma 6.2.1.  Every function on the constructed projective line
-- is constant, using the SQC evaluation instances for A^1 and G_m.
level l ;
open Algebra[l] ;
module P = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

module Theorem (ring : CRing) (setR : P.isSet ring.R)
 (affine-sqc : PolynomialFunctions[l].Polynomials[ring,setR].SQC)
 (torus-sqc : LaurentFunctions[l].Laurent[ring,setR].SQC) {
 open ring ;
 module Line = Projective[l].Line[ring,setR] ;
 module Poly = PolynomialFunctions[l].Polynomials[ring,setR] ;
 module Pol = Poly.Polynomiality[affine-sqc] ;
 module Lau = LaurentFunctions[l].Laurent[ring,setR] ;
 module Compare = Lau.Comparison[torus-sqc] ;
 P1 : U l = Line.P1 ;
 origin : P1 = Line.affine z ;

 module Function (f : P1 -> R) {
  first (x : R) : R = f (Line.affine x) ;
  second (y : R) : R = f (Line.infinity-chart y) ;
  Statement : U l = (q : P1) -> Id R (f q) (f origin) ;
  statement-prop : P.isProp Statement =
    F.isProp-Pi P1 (\ q -> Id R (f q) (f origin)) (\ q -> setR (f q) (f origin)) ;
  compatible (p : Pol.Representation first) (q : Pol.Representation second) : Compare.Compatible p.1 q.1 =
    \ u -> trans (p.2 u.1)
      (trans (ap f (Line.overlap u.1 u.2.1 u.2.2)) (sym (q.2 u.2.1))) ;
  on-charts (p : Pol.Representation first) (q : Pol.Representation second) :
    (c : Line.C) -> Id R (f (Line.point c)) (f origin) = split {
     lo x -> trans (sym (p.2 x))
       (trans (Compare.positive-constant p.1 q.1 (compatible p q) x) (p.2 z)) ;
     hi y -> trans (sym (q.2 y))
       (trans (Compare.negative-constant p.1 q.1 (compatible p q) y) (p.2 z)) } ;
  from-polynomials (p : Pol.Representation first) (q : Pol.Representation second) : Statement =
    Line.Q.induction @l (\ x -> Id R (f x) (f origin)) (\ x -> setR (f x) (f origin)) (on-charts p q) ;
  constant : Statement = Truncation[l].Trunc[Pol.Representation first].induction @l
    (\ t -> Statement) (\ t -> statement-prop)
    (\ p -> Truncation[l].Trunc[Pol.Representation second].induction @l
      (\ t -> Statement) (\ t -> statement-prop) (from-polynomials p) (Pol.exists second)) (Pol.exists first) ;
 } ;

 -- The explicit constant is f([0:1]); no truncated choice is needed.
 constant (f : P1 -> R) (q : P1) : Id R (f q) (f origin) = Function[f].constant q ;
 constant-function (c : R) : P1 -> R = \ q -> c ;
 function-equality (f : P1 -> R) : Id (P1 -> R) f (constant-function (f origin)) =
   F.funext P1 (\ q -> R) f (constant-function (f origin)) (constant f) ;
 at-origin (f : P1 -> R) : R = f origin ;
 functions-equivalence : P.Equiv R (P1 -> R) =
   (constant-function,P.qinv R (P1 -> R) constant-function at-origin
     (\ f -> sym (function-equality f)) (\ c -> refl c)) ;
} ;


-- The same conclusion on the P1 used in the checked squaring example.
-- Loc and the R/(x,y) SQC instances identify it with nonzero homogeneous
-- coordinates; the constancy proof itself uses only the two new instances.
module SAG (ring : CRing) (setR : P.isSet ring.R)
 (nontrivial : Id ring.R ring.o ring.z -> Empty)
 (local : (x y : ring.R) -> RL[ring].unit (ring.add x y) ->
   Truncation[l].Trunc[Plus (RL[ring].unit x) (RL[ring].unit y)].carrier)
 (principal-sqc : (x y : ring.R) -> LinearIdeal[l].Ideal[ring,setR,x,y].SQC)
 (affine-sqc : PolynomialFunctions[l].Polynomials[ring,setR].SQC)
 (torus-sqc : LaurentFunctions[l].Laurent[ring,setR].SQC) {
 module Geometry = Example[l].SAG[ring,setR,nontrivial,local,principal-sqc] ;
 module Proof = Theorem[ring,setR,affine-sqc,torus-sqc] ;
 lemma-6-2-1 (f : Geometry.P1 -> ring.R) (q : Geometry.P1) :
   Id ring.R (f q) (f Geometry.zero) = Proof.constant f q ;
 functions-equivalence : P.Equiv ring.R (Geometry.P1 -> ring.R) = Proof.functions-equivalence ;
} ;
