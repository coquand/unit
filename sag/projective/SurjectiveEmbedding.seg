level l ;
open Prelude[l] ;
module Map (X Y : U l) (setY : isSet Y) (f : X -> Y)
 (injective : (x x' : X) -> Id Y (f x) (f x') -> Id X x x') {
 Fibre (y : Y) : U l = (x : X) * Id Y (f x) y ;
 unique (y : Y) : isProp (Fibre y) = \ u v -> Sigma-eq X (\ x -> Id Y (f x) y)
  u.1 v.1 u.2 v.2 (injective u.1 v.1 (trans _ _ _ _ u.2 (sym _ _ _ v.2))) (setY (f v.1) y) ;
 module Surjective (cover : (y : Y) -> Truncation[l].Trunc[Fibre y].carrier) {
  choose (y : Y) : Fibre y = Truncation[l].Trunc[Fibre y].induction @l
   (\ t -> Fibre y) (\ t -> unique y) (\ u -> u) (cover y) ;
  inverse (y : Y) : X = (choose y).1 ;
  equivalence : Equiv X Y = (f,qinv X Y f inverse (\ y -> (choose y).2)
    (\ x -> injective _ x (choose (f x)).2)) ;
 } ;
} ;
