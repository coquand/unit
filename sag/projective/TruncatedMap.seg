-- Weakly constant maps into sets descend through propositional truncation.
level l ;
open Prelude[l] ;
module Map (A B : U l) (setB : isSet B) (f : A -> B)
 (constant : (a a' : A) -> Id B (f a) (f a')) {
 Witness (b : B) : U l = (a : A) * Id B (f a) b ;
 Has (b : B) : U l = Truncation[l].Trunc[Witness b].carrier ;
 Result : U l = (b : B) * Has b ;
 equal (b c : B) (u : Has b) (v : Has c) : Id B b c =
   Truncation[l].Trunc[Witness b].induction @l (\ t -> Id B b c) (\ t -> setB b c)
     (\ w -> Truncation[l].Trunc[Witness c].induction @l (\ t -> Id B b c) (\ t -> setB b c)
       (\ w' -> trans B b (f w.1) c (sym B _ _ w.2)
         (trans B (f w.1) (f w'.1) c (constant w.1 w'.1) w'.2)) v) u ;
 unique : isProp Result = \ u v -> Sigma-eq B Has u.1 v.1 u.2 v.2 (equal u.1 v.1 u.2 v.2)
   Truncation[l].Trunc[Witness v.1].proposition ;
 at (a : A) : Result = (f a,Truncation[l].Trunc[Witness (f a)].inc (a,refl (f a))) ;
 result (t : Truncation[l].Trunc[A].carrier) : Result =
   Truncation[l].Trunc[A].induction @l (\ t -> Result) (\ t -> unique) at t ;
 map (t : Truncation[l].Trunc[A].carrier) : B = (result t).1 ;
 beta (t : Truncation[l].Trunc[A].carrier) (a : A) : Id B (map t) (f a) =
   ap Result B (\ r -> r.1) _ _ (unique (result t) (at a)) ;
} ;
