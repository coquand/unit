-- SAG Example 6.1.9: the two specified fibres of projective squaring.
-- Foundational assumptions: the enclosing univalence/replacement schema.
-- Ring assumptions: Loc and the SQC instances for R/(x,y).
level l ;
open Algebra[l] ;
module P = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
empty-prop : P.isProp Empty = \ e -> absurd ((e' : Empty) -> Id Empty e e') e ;

module SAG (ring : CRing) (setR : P.isSet ring.R)
 (nontrivial : Id ring.R ring.o ring.z -> Empty)
 (local : (x y : ring.R) -> RL[ring].unit (ring.add x y) ->
   Truncation[l].Trunc[Plus (RL[ring].unit x) (RL[ring].unit y)].carrier)
 (sqc : (x y : ring.R) -> LinearIdeal[l].Ideal[ring,setR,x,y].SQC) {
 open ring ; open RL[ring] ; open RingFacts[l].Facts[ring] ;
 module D = UnitDetection[l].Detection[ring,setR,local,sqc] ;
 module H = Homogeneous[l].QuotientLine[ring,setR] ;
 module N = Coordinates[l].Coordinates[ring,setR] ;
 module L = Projective[l].Line[ring,setR] ;
 module C = Fibres[l].Calculation[ring,setR] ;
 P1 : U l = L.P1 ;
 s : P1 -> P1 = L.squaring ;
 zero : P1 = L.affine z ;
 one : P1 = L.affine o ;
 Fibre (q : P1) : U l = (p : P1) * Id P1 (s p) q ;
 Disk : U l = (a : R) * Id R (square a) z ;
 zero-fibre : P.Equiv Disk (Fibre zero) = C.zero-fibre ;
 two-fibre (two-nonzero : Id R (add o o) z -> Empty) : P.Equiv Base.Bool (Fibre one) =
   UnitDetection[l].SAG[ring,setR,nontrivial,local,sqc,two-nonzero].theorem ;

 -- Relate the input to SAG's nonzero homogeneous coordinates.  The
 -- two predicates are propositions, not choices of a distinguished chart.
 Nonzero (v : H.V) : U l = (Id R v.1 z * Id R v.2 z) -> Empty ;
 nonzero-prop (v : H.V) : P.isProp (Nonzero v) =
   F.isProp-Pi (Id R v.1 z * Id R v.2 z) (\ h -> Empty) (\ h -> empty-prop) ;
 NonzeroRaw : U l = (v : H.V) * Nonzero v ;
 unit-nonzero (x : R) (u : unit x) (p : Id R x z) : Empty =
   nontrivial (trans (sym u.2) (trans (ap (\ t -> mul t u.1) p) (zero-mul u.1))) ;
 choice-nonzero (x y : R) : N.Choice x y -> Nonzero (x,y) = split {
   inl u -> \ h -> unit-nonzero x u h.1 ;
   inr u -> \ h -> unit-nonzero y u h.2 } ;
 covered-nonzero (x y : R) (h : N.Covered x y) : Nonzero (x,y) =
   Truncation[l].Trunc[N.Choice x y].induction @l (\ t -> Nonzero (x,y))
     (\ t -> nonzero-prop (x,y)) (choice-nonzero x y) h ;
 toRaw (v : NonzeroRaw) : H.Raw = (v.1,D.nonzero-cover v.1.1 v.1.2 v.2) ;
 fromRaw (v : H.Raw) : NonzeroRaw = (v.1,covered-nonzero v.1.1 v.1.2 v.2) ;
 raw-equivalence : P.Equiv NonzeroRaw H.Raw = (toRaw,P.qinv NonzeroRaw H.Raw toRaw fromRaw
   (\ v -> P.Sigma-eq H.V (\ v -> N.Covered v.1 v.2) v.1 v.1 _ v.2 (refl v.1)
      Truncation[l].Trunc[N.Choice v.1.1 v.1.2].proposition)
   (\ v -> P.Sigma-eq H.V Nonzero v.1 v.1 _ v.2 (refl v.1) (nonzero-prop v.1))) ;
 homogeneous (v : NonzeroRaw) : P1 = H.hom (toRaw v) ;
 squaredRaw (v : NonzeroRaw) : H.Raw =
   ((square v.1.1,square v.1.2),N.square-cover v.1.1 v.1.2 (toRaw v).2) ;
 squared (v : NonzeroRaw) : NonzeroRaw = fromRaw (squaredRaw v) ;
 squaring-formula (v : NonzeroRaw) : Id P1 (s (homogeneous v)) (homogeneous (squared v)) =
   N.square-formula v.1.1 v.1.2 (toRaw v).2 (toRaw (squared v)).2 ;
 -- A scalar relating nonzero representatives is necessarily a unit.
 scalar-unit (v w : NonzeroRaw) (c : R)
   (p : Id R v.1.1 (mul c w.1.1)) (q : Id R v.1.2 (mul c w.1.2)) : unit c =
   D.nonzero-unit c (\ h -> v.2
     (trans p (trans (ap (\ t -> mul t w.1.1) h) (zero-mul w.1.1)),
      trans q (trans (ap (\ t -> mul t w.1.2) h) (zero-mul w.1.2)))) ;
 scalar-invariance (v w : NonzeroRaw) (c : R)
   (p : Id R v.1.1 (mul c w.1.1)) (q : Id R v.1.2 (mul c w.1.2)) :
   Id P1 (homogeneous v) (homogeneous w) =
   H.scaled-hom (toRaw v) (toRaw w) ((c,scalar-unit v w c p q),(p,q)) ;

 Scalar (v w : NonzeroRaw) : U l = (c : R) *
   (Id R v.1.1 (mul c w.1.1) * Id R v.1.2 (mul c w.1.2)) ;
 homogeneous-effective (v w : NonzeroRaw) (p : Id P1 (homogeneous v) (homogeneous w)) :
   Truncation[l].Trunc[Scalar v w].carrier =
   Truncation[l].Trunc[H.Scaled v.1 w.1].induction @l
    (\ t -> Truncation[l].Trunc[Scalar v w].carrier)
    (\ t -> Truncation[l].Trunc[Scalar v w].proposition)
    (\ t -> Truncation[l].Trunc[Scalar v w].inc (t.1.1,t.2))
    (H.hom-effective (toRaw v) (toRaw w) p) ;
 Representative (q : P1) : U l = (v : NonzeroRaw) * Id P1 (homogeneous v) q ;
 representatives (q : P1) : Truncation[l].Trunc[Representative q].carrier =
   L.Q.induction @l (\ q -> Truncation[l].Trunc[Representative q].carrier)
    (\ q -> Truncation[l].Trunc[Representative q].proposition)
    (\ c -> Truncation[l].Trunc[Representative (L.point c)].inc
      (fromRaw (H.chartRaw c),trans (ap H.hom (raw-equivalence.2.sec-eq (H.chartRaw c))) (H.chart-beta c))) q ;
} ;
