-- R/(x,y), constructed as an effective set quotient.
-- SQC below is exactly the evaluation instance for this finite presentation,
-- with its spectrum represented by the equations x=0 and y=0.
level l ;
open Algebra[l] ;
module P = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Ideal (ring : CRing) (setR : P.isSet ring.R) (x y : ring.R) {
 open ring ; open RL[ring] ;
 linear (c d : R) : R = add (mul x c) (mul y d) ;
 linear-zero : Id R (linear z z) z = trans (ap (\ t -> add t (mul y z)) (mul-zero x))
   (trans (ap (add z) (mul-zero y)) (addZ z)) ;
 linear-add (c d e f : R) : Id R (linear (add c e) (add d f)) (add (linear c d) (linear e f)) =
   trans (ap (\ t -> add t (mul y (add d f))) (dist x c e))
    (trans (ap (add (add (mul x c) (mul x e))) (dist y d f))
     (swap (mul x c) (mul x e) (mul y d) (mul y f))) ;
 linear-neg (c d : R) : Id R (linear (neg c) (neg d)) (neg (linear c d)) =
   neg-uniq (linear c d) (linear (neg c) (neg d))
    (trans (ap (\ t -> add (linear c d) (add t (mul y (neg d)))) (mul-neg x c))
     (trans (ap (\ t -> add (linear c d) (add (neg (mul x c)) t)) (mul-neg y d))
      (trans (swap (mul x c) (mul y d) (neg (mul x c)) (neg (mul y d)))
       (trans (ap (\ t -> add t (add (mul y d) (neg (mul y d)))) (addN (mul x c)))
        (trans (ap (add z) (addN (mul y d))) (addZ z)))))) ;
 Witness (a b : R) : U l = (c : R) * (d : R) * Id R a (add b (linear c d)) ;
 relation (a b : R) : U l = Truncation[l].Trunc[Witness a b].carrier ;
 relation-prop (a b : R) : P.isProp (relation a b) = Truncation[l].Trunc[Witness a b].proposition ;
 relation-refl (a : R) : relation a a = Truncation[l].Trunc[Witness a a].inc
   (z,z,sym (trans (ap (add a) linear-zero) (addZ a))) ;
 witness-sym (a b : R) (w : Witness a b) : Witness b a =
   (neg w.1,neg w.2.1,sym
     (trans (ap (\ t -> add t (linear (neg w.1) (neg w.2.1))) w.2.2)
      (trans (ap (add (add b (linear w.1 w.2.1))) (linear-neg w.1 w.2.1))
       (add-neg-cancel b (linear w.1 w.2.1))))) ;
 relation-sym (a b : R) (r : relation a b) : relation b a =
   Truncation[l].Trunc[Witness a b].induction @l (\ t -> relation b a) (\ t -> relation-prop b a)
     (\ w -> Truncation[l].Trunc[Witness b a].inc (witness-sym a b w)) r ;
 witness-trans (a b c : R) (u : Witness a b) (v : Witness b c) : Witness a c =
   (add v.1 u.1,add v.2.1 u.2.1,
     trans u.2.2 (trans (ap (\ t -> add t (linear u.1 u.2.1)) v.2.2)
      (trans (sym (addA c (linear v.1 v.2.1) (linear u.1 u.2.1)))
       (ap (add c) (sym (linear-add v.1 v.2.1 u.1 u.2.1)))))) ;
 relation-trans (a b c : R) (u : relation a b) (v : relation b c) : relation a c =
   Truncation[l].Trunc[Witness a b].induction @l (\ t -> relation a c) (\ t -> relation-prop a c)
    (\ u' -> Truncation[l].Trunc[Witness b c].induction @l (\ t -> relation a c) (\ t -> relation-prop a c)
      (\ v' -> Truncation[l].Trunc[Witness a c].inc (witness-trans a b c u' v')) v) u ;
 module Q = Quotient[l].Quot[R,relation,relation-prop,relation-refl,relation-sym,relation-trans] ;
 Spectrum : U l = Id R x z * Id R y z ;
 vanishes (h : Spectrum) (c d : R) : Id R (linear c d) z =
   trans (ap (\ t -> add (mul t c) (mul y d)) h.1)
    (trans (ap (\ t -> add (mul z c) (mul t d)) h.2)
     (trans (ap (\ t -> add t (mul z d)) (zero-mul c))
      (trans (ap (add z) (zero-mul d)) (addZ z)))) ;
 evaluate-witness (a b : R) (w : Witness a b) (h : Spectrum) : Id R a b =
   trans w.2.2 (trans (ap (add b) (vanishes h w.1 w.2.1)) (addZ b)) ;
 evaluates (a b : R) (r : relation a b) : Id (Spectrum -> R) (\ h -> a) (\ h -> b) =
   F.funext Spectrum (\ h -> R) _ _ (\ h -> Truncation[l].Trunc[Witness a b].induction @l
     (\ t -> Id R a b) (\ t -> setR a b) (\ w -> evaluate-witness a b w h) r) ;
 module Evaluation = Q.Descend[Spectrum -> R,F.isSet-Pi Spectrum (\ h -> R) (\ h -> setR),
   \ a h -> a,evaluates] ;
 evaluation : Q.Q -> Spectrum -> R = Evaluation.map ;
 SQC : U l = P.isEquiv Q.Q (Spectrum -> R) evaluation ;
 module Consequence (sqc : SQC) {
  quotient-trivial (no : Spectrum -> Empty) : Id Q.Q (Q.inc o) (Q.inc z) =
   trans (sym (P.sec-ret _ _ evaluation sqc (Q.inc o)))
    (trans (ap sqc.sec (F.funext Spectrum (\ h -> R) _ _
      (\ h -> absurd (Id R (evaluation (Q.inc o) h) (evaluation (Q.inc z) h)) (no h))))
     (P.sec-ret _ _ evaluation sqc (Q.inc z))) ;
  generates-one (no : Spectrum -> Empty) : relation o z = Q.effective o z (quotient-trivial no) ;
 } ;
} ;
