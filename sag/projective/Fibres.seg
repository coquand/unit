-- Every fibre over [t:1] is the affine equation a^2=t.
-- This calculation works over any commutative set-ring.
level l ;
open Algebra[l] ;
module P = Prelude[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;

module Calculation (ring : CRing) (setR : P.isSet ring.R) {
 open ring ; open RL[ring] ; open RingFacts[l].Facts[ring] ;
 module L = Projective[l].Line[ring,setR] ; open L ;
 HasAffine (q : P1) : U l = (a : R) * Id P1 (affine a) q ;
 affine-unique (q : P1) : P.isProp (HasAffine q) = \ u v ->
  P.Sigma-eq R (\ a -> Id P1 (affine a) q) u.1 v.1 u.2 v.2
    (affine-injective u.1 v.1 (trans u.2 (sym v.2))) (Q.set (affine v.1) q) ;

 module At (t : R) {
  Root : U l = (a : R) * Id R (square a) t ;
  Fibre : U l = (q : P1) * Id P1 (squaring q) (affine t) ;
  affine-on-chart : (c : C) -> Id P1 (squaring (point c)) (affine t) -> HasAffine (point c) = split {
   lo a -> \ h -> (a,refl (affine a)) ;
   hi a -> \ h -> (mul a t,overlap (mul a t) a
     (trans (mulC (mul a t) a)
       (trans (mulA a a t) (Q.effective (hi (square a)) (lo t) (trans (sym (infinity-beta a)) h))))) } ;
  affine-preimage (q : P1) (h : Id P1 (squaring q) (affine t)) : HasAffine q =
   Q.induction @l (\ q -> Id P1 (squaring q) (affine t) -> HasAffine q)
    (\ q -> F.isProp-Pi (Id P1 (squaring q) (affine t)) (\ h -> HasAffine q) (\ h -> affine-unique q))
    affine-on-chart q h ;
  forward (r : Root) : Fibre = (affine r.1,trans (affine-beta r.1) (ap affine r.2)) ;
  root-equation (v : Fibre) : Id R (square (affine-preimage v.1 v.2).1) t =
   affine-injective _ t (trans (sym (affine-beta (affine-preimage v.1 v.2).1))
     (trans (ap squaring (affine-preimage v.1 v.2).2) v.2)) ;
  backward (v : Fibre) : Root = ((affine-preimage v.1 v.2).1,root-equation v) ;
  fb (v : Fibre) : Id Fibre (forward (backward v)) v =
   P.Sigma-eq P1 (\ q -> Id P1 (squaring q) (affine t)) _ v.1 _ v.2
     (affine-preimage v.1 v.2).2 (Q.set (squaring v.1) (affine t)) ;
  bf (r : Root) : Id Root (backward (forward r)) r =
   P.Sigma-eq R (\ a -> Id R (square a) t) _ r.1 _ r.2
     (affine-injective _ r.1 (affine-preimage (forward r).1 (forward r).2).2)
     (setR (square r.1) t) ;
  equivalence : P.Equiv Root Fibre = (forward,P.qinv Root Fibre forward backward fb bf) ;
 } ;
 -- SAG Example 6.1.9, the infinitesimal fibre, with actual inverse maps.
 first-order-disk : U l = At[z].Root ;
 zero-fibre : P.Equiv first-order-disk At[z].Fibre = At[z].equivalence ;
 one-fibre : P.Equiv At[o].Root At[o].Fibre = At[o].equivalence ;
} ;
