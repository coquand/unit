-- Families A -> U l form a locally small type: Id (A -> U l) f g is
-- equivalent to the small type (a : A) -> Equiv (f a) (g a), by function
-- extensionality and univalence.  (Moved from Quotient, which needs this
-- only for families of propositions, PropFamilies there.)
level l ;
open Base ; open Prelude[l] ;
module H = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module G = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;
module Rep = Replacement[l,l+] ;

module FunctionSmall (A : U l) (f g : A -> U l) {
  E : U l = (a : A) -> Equiv (f a) (g a) ;
  Path : U l+ = Id (A -> U l) f g ;
  encode (p : Path) : E = \ a -> Axioms[l].idtoeqv (f a) (g a) (H.happly A (\ a -> U l) f g p a) ;
  decode (e : E) : Path = G.funext A (\ a -> U l) f g (\ a -> UA.ua (f a) (g a) (e a)) ;
  ed (e : E) : Id E (encode (decode e)) e = F.funext A (\ a -> Equiv (f a) (g a)) _ e (\ a ->
    trans _ _ _ _
      (H.ap _ _ (Axioms[l].idtoeqv (f a) (g a)) _ _
        (H.happly A (\ a -> Id (U l) (f a) (g a)) _ _
          (G.happly-funext A (\ a -> U l) f g (\ a -> UA.ua (f a) (g a) (e a))) a))
      ((univ @l (f a) (g a)).sec-eq (e a))) ;
  de (p : Path) : Id Path (decode (encode p)) p = H.trans _ _ _ _
    (H.ap ((a : A) -> Id (U l) (f a) (g a)) Path (G.funext A (\ a -> U l) f g)
      (\ a -> UA.ua (f a) (g a) (encode p a)) (\ a -> H.happly A (\ a -> U l) f g p a)
      (G.funext A (\ a -> Id (U l) (f a) (g a)) _ _ (\ a ->
        H.sec-ret _ _ (Axioms[l].idtoeqv (f a) (g a)) (univ @l (f a) (g a))
          (H.happly A (\ a -> U l) f g p a))))
    (G.funext-happly A (\ a -> U l) f g p) ;
  small : Rep.Small Path = (E,(decode,H.qinv E Path decode encode de ed)) ;
} ;
