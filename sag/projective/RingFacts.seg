level l ;
open Algebra[l] ;
module Facts (ring : CRing) {
 open ring ; open RL[ring] ;
 inverse-unique (y x w : R) (h : Id R (mul y x) o) (k : Id R (mul y w) o) : Id R x w =
  calc R { x =< sym (mulO x) > mul x o
   =< ap (mul x) (sym k) > mul x (mul y w)
   =< mulA x y w > mul (mul x y) w
   =< ap (\ t -> mul t w) (trans (mulC x y) h) > mul o w
   =< trans (mulC o w) (mulO w) > w } ;
 four (a b c d : R) : Id R (mul (mul a b) (mul c d)) (mul (mul a c) (mul b d)) =
  calc R { mul (mul a b) (mul c d)
   =< sym (mulA a b (mul c d)) > mul a (mul b (mul c d))
   =< ap (mul a) (mul-swap b c d) > mul a (mul c (mul b d))
   =< mulA a c (mul b d) > mul (mul a c) (mul b d) } ;
 square (x : R) : R = mul x x ;
 square-inverse (x y : R) (h : Id R (mul x y) o) : Id R (mul (square x) (square y)) o =
  trans (four x x y y)
    (trans (ap (\ t -> mul t (mul x y)) h) (trans (ap (mul o) h) (mulO o))) ;
 square-one : Id R (square o) o = mulO o ;
 square-zero : Id R (square z) z = mul-zero z ;
} ;
