-- Effective small quotients of proposition-valued equivalence relations.
-- Derived from replacement, function extensionality and univalence for
-- propositions (propUA); no quotient axiom, no univalence.
--
-- The quotient of A by rel is the image (replacement) of
--     family : A -> (A -> Prop),  a |-> (x |-> rel x a),
-- where Prop = (X : U l) * isProp X.  The image exists because A -> Prop
-- is locally small: a path f = g is the same as a pointwise logical
-- equivalence (PropFamilies), since both are propositions and there are
-- maps both ways (funext and propUA one way, transport the other; Hedberg
-- for the paths).
level l ;
open Base ; open Prelude[l] ;
module H = Prelude[l+] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module G = Axioms[l+].FunExtLemmas[fe @(l+)] ;
module Rep = Replacement[l,l+] ;

Prop : U l+ = (X : U l) * isProp X ;

-- a logical equivalence of propositions is a path in Prop
prop-path (P Q : Prop) (u : P.1 -> Q.1) (v : Q.1 -> P.1) : Id Prop P Q =
  H.Sigma-eq (U l) (\ X -> isProp X) P.1 Q.1 P.2 Q.2
    ((propUA @l P.1 Q.1 P.2 Q.2).sec (u, qinv P.1 Q.1 u v (\ y -> Q.2 (u (v y)) y) (\ x -> P.2 (v (u x)) x)))
    (F.isProp-isProp Q.1) ;

-- paths between families of propositions, from f
module PropFamilies (A : U l) (f : A -> Prop) {
  Logical (g : A -> Prop) : U l = (a : A) -> ((f a).1 -> (g a).1) * ((g a).1 -> (f a).1) ;
  logical-prop (g : A -> Prop) : isProp (Logical g) = F.isProp-Pi A (\ a -> ((f a).1 -> (g a).1) * ((g a).1 -> (f a).1)) (\ a ->
    isProp-Sigma ((f a).1 -> (g a).1) (\ u -> (g a).1 -> (f a).1)
      (F.isProp-Pi (f a).1 (\ u -> (g a).1) (\ u -> (g a).2))
      (\ u -> F.isProp-Pi (g a).1 (\ v -> (f a).1) (\ v -> (f a).2))) ;
  logical-refl : Logical f = \ a -> (\ x -> x, \ x -> x) ;
  decode (g : A -> Prop) (h : Logical g) : Id (A -> Prop) f g =
    G.funext A (\ a -> Prop) f g (\ a -> prop-path (f a) (g a) (h a).1 (h a).2) ;
  encode (g : A -> Prop) (p : Id (A -> Prop) f g) : Logical g =
    H.subst (A -> Prop) (\ k -> Logical k) f g p logical-refl ;
  path-prop (g : A -> Prop) : H.isProp (Id (A -> Prop) f g) =
    H.Hedberg[A -> Prop, f, \ k -> Logical k, logical-prop, logical-refl, decode].hedberg g ;
  small (g : A -> Prop) : Rep.Small (Id (A -> Prop) f g) =
    (Logical g,(decode g,H.qinv (Logical g) (Id (A -> Prop) f g) (decode g) (encode g)
      (\ p -> path-prop g (decode g (encode g p)) p) (\ h -> logical-prop g (encode g (decode g h)) h))) ;
} ;

module Quot (A : U l) (rel : A -> A -> U l)
 (prop : (a b : A) -> isProp (rel a b))
 (rr : (a : A) -> rel a a)
 (rs : (a b : A) -> rel a b -> rel b a)
 (rt : (a b c : A) -> rel a b -> rel b c -> rel a c) {
  small : Rep.LocallySmall (A -> Prop) = \ f g -> PropFamilies[A,f].small g ;
  family (a : A) : A -> Prop = \ x -> (rel x a, prop x a) ;
  image : Rep.Image[A,A -> Prop,family] = images @l @(l+) A (A -> Prop) small family ;
  Q : U l = image.carrier ;
  inc : A -> Q = image.quotient ;
  code (q : Q) (a : A) : U l = (image.inclusion q a).1 ;
  induction : [j] (P : Q -> U j) -> ((q : Q) -> Prelude[j].isProp (P q)) ->
    ((a : A) -> P (inc a)) -> (q : Q) -> P q = <j> \ P p b ->
    (surjections @l @(l+) @j A (A -> Prop) small family P p).sec b ;
  code-prop (q : Q) (a : A) : isProp (code q a) = (image.inclusion q a).2 ;
  Logical (q r : Q) : U l = PropFamilies[A,image.inclusion q].Logical (image.inclusion r) ;
  logical-prop (q r : Q) : isProp (Logical q r) = PropFamilies[A,image.inclusion q].logical-prop (image.inclusion r) ;
  logical-path (q r : Q) (h : Logical q r) : Id Q q r = (image.embedding q r).sec
    (PropFamilies[A,image.inclusion q].decode (image.inclusion r) h) ;
  set : isSet Q = \ q -> Hedberg[Q,q,Logical q,logical-prop q,
    \ a -> (\ u -> u,\ u -> u),logical-path q].hedberg ;
  relates (a b : A) (h : rel a b) : Id Q (inc a) (inc b) = (image.embedding (inc a) (inc b)).sec
    (H.trans _ _ _ _ (image.triangle a)
      (H.trans _ _ _ _
        (PropFamilies[A,family a].decode (family b) (\ x -> (\ u -> rt x a b u h,\ v -> rt x b a v (rs a b h))))
        (H.sym _ _ _ (image.triangle b)))) ;
  effective (a b : A) (p : Id Q (inc a) (inc b)) : rel a b =
    H.subst (A -> Prop) (\ f -> (f a).1) (family a) (family b)
      (H.trans _ _ _ _ (H.sym _ _ _ (image.triangle a))
        (H.trans _ _ _ _ (H.ap Q (A -> Prop) image.inclusion _ _ p) (image.triangle b))) (rr a) ;

  module Descend (B : U l) (sB : isSet B) (f : A -> B)
    (respect : (a b : A) -> rel a b -> Id B (f a) (f b)) {
    Witness (q : Q) (b : B) : U l = (a : A) * (Id Q (inc a) q * Id B (f a) b) ;
    Has (q : Q) (b : B) : U l = Truncation[l].Trunc[Witness q b].carrier ;
    Candidate (q : Q) : U l = (b : B) * Has q b ;
    value-eq (q : Q) (b c : B) (u : Witness q b) (v : Witness q c) : Id B b c =
      trans B b (f u.1) c (sym B _ _ u.2.2)
        (trans B (f u.1) (f v.1) c
          (respect u.1 v.1 (effective u.1 v.1 (trans Q _ _ _ u.2.1 (sym Q _ _ v.2.1)))) v.2.2) ;
    unique-value (q : Q) (b c : B) (u : Has q b) (v : Has q c) : Id B b c =
      Truncation[l].Trunc[Witness q b].induction @l (\ t -> Id B b c) (\ t -> sB b c)
        (\ w -> Truncation[l].Trunc[Witness q c].induction @l (\ t -> Id B b c) (\ t -> sB b c)
          (value-eq q b c w) v) u ;
    candidate-prop (q : Q) : isProp (Candidate q) = \ u v -> Sigma-eq B (Has q)
      u.1 v.1 u.2 v.2 (unique-value q u.1 v.1 u.2 v.2) Truncation[l].Trunc[Witness q v.1].proposition ;
    at (a : A) : Candidate (inc a) = (f a,Truncation[l].Trunc[Witness (inc a) (f a)].inc
      (a,(refl (inc a),refl (f a)))) ;
    choose (q : Q) : Candidate q = induction @l Candidate candidate-prop at q ;
    map (q : Q) : B = (choose q).1 ;
    beta (a : A) : Id B (map (inc a)) (f a) = ap (Candidate (inc a)) B (\ t -> t.1) _ _
      (candidate-prop (inc a) (choose (inc a)) (at a)) ;
  } ;
} ;
