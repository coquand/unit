-- The one- and two-coordinate cases of SAG Proposition 2.2.3.
-- Only SQC for the finite presentations R/(x,y) is used.
level l ;
open Algebra[l] ;
module P = Prelude[l] ;
module Detection (ring : CRing) (setR : P.isSet ring.R)
 (local : (x y : ring.R) -> RL[ring].unit (ring.add x y) ->
   Truncation[l].Trunc[Plus (RL[ring].unit x) (RL[ring].unit y)].carrier)
 (sqc : (x y : ring.R) -> LinearIdeal[l].Ideal[ring,setR,x,y].SQC) {
 open ring ; open RL[ring] ; open RingFacts[l].Facts[ring] ;
 unit-prop (x : R) : P.isProp (unit x) = \ u v ->
   P.Sigma-eq R (\ c -> Id R (mul x c) o) u.1 v.1 u.2 v.2
     (inverse-unique x u.1 v.1 u.2 v.2) (setR (mul x v.1) o) ;
 product-unit (x c : R) (u : unit (mul x c)) : unit x =
   (mul c u.1,trans (mulA x c u.1) u.2) ;
 Unimodular (x y : R) : U l = Truncation[l].Trunc[Plus (unit x) (unit y)].carrier ;
 factor-choice (x y c d : R) : Plus (unit (mul x c)) (unit (mul y d)) -> Unimodular x y = split {
   inl u -> Truncation[l].Trunc[Plus (unit x) (unit y)].inc (inl (product-unit x c u)) ;
   inr u -> Truncation[l].Trunc[Plus (unit x) (unit y)].inc (inr (product-unit y d u)) } ;
 witness-cover (x y : R) (w : LinearIdeal[l].Ideal[ring,setR,x,y].Witness o z) : Unimodular x y =
   Truncation[l].Trunc[Plus (unit (mul x w.1)) (unit (mul y w.2.1))].induction @l
     (\ t -> Unimodular x y) (\ t -> Truncation[l].Trunc[Plus (unit x) (unit y)].proposition)
     (factor-choice x y w.1 w.2.1)
     (local (mul x w.1) (mul y w.2.1)
       (o,trans (mulO (add (mul x w.1) (mul y w.2.1)))
         (sym (trans w.2.2 (zl (add (mul x w.1) (mul y w.2.1))))))) ;
 nonzero-cover (x y : R) (no : (Id R x z * Id R y z) -> Empty) : Unimodular x y =
   Truncation[l].Trunc[LinearIdeal[l].Ideal[ring,setR,x,y].Witness o z].induction @l
     (\ t -> Unimodular x y) (\ t -> Truncation[l].Trunc[Plus (unit x) (unit y)].proposition)
     (witness-cover x y)
     (LinearIdeal[l].Ideal[ring,setR,x,y].Consequence[sqc x y].generates-one no) ;
 witness-unit (x : R) (w : LinearIdeal[l].Ideal[ring,setR,x,z].Witness o z) : unit x =
   (w.1,sym (trans w.2.2
     (trans (zl (add (mul x w.1) (mul z w.2.1)))
       (trans (ap (add (mul x w.1)) (zero-mul w.2.1)) (addZ (mul x w.1)))))) ;
 nonzero-unit (x : R) (no : Id R x z -> Empty) : unit x =
   Truncation[l].Trunc[LinearIdeal[l].Ideal[ring,setR,x,z].Witness o z].induction @l
     (\ t -> unit x) (\ t -> unit-prop x) (witness-unit x)
     (LinearIdeal[l].Ideal[ring,setR,x,z].Consequence[sqc x z].generates-one (\ h -> no h.1)) ;
} ;

module SAG (ring : CRing) (setR : P.isSet ring.R)
 (nontrivial : Id ring.R ring.o ring.z -> Empty)
 (local : (x y : ring.R) -> RL[ring].unit (ring.add x y) ->
   Truncation[l].Trunc[Plus (RL[ring].unit x) (RL[ring].unit y)].carrier)
 (sqc : (x y : ring.R) -> LinearIdeal[l].Ideal[ring,setR,x,y].SQC)
 (two-nonzero : Id ring.R (ring.add ring.o ring.o) ring.z -> Empty) {
 module D = Detection[ring,setR,local,sqc] ;
 module Two = TwoRoots[l].Discrete[ring,setR,nontrivial,local,D.nonzero-unit (ring.add ring.o ring.o) two-nonzero] ;
 -- The two-point fibre with the paper's nonzero-2 hypothesis.
 theorem : P.Equiv Base.Bool Two.One.Fibre = Two.fibre-equivalence ;
} ;
