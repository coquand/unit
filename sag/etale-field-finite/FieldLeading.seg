-- Scan a bounded coefficient list over a discrete field from the top.
-- It is either identically zero or has a last nonzero, hence invertible,
-- coefficient. Scaling by its inverse gives a monic polynomial. No
-- factorisation algorithm and no assumption on the size of the field.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing)
 (dec : (a : A.R) -> Plus (Id A.R a A.z) (RL[A].unit a)) {
 module P = Poly[l].PolyR[A] ; module M = Mul[l].MulR[A] ;
 module Bound = PolynomialBounds[l].Over[A] ;
 Zero (p : P.P) : U l = (i : Nat) -> Id A.R (P.coef p i) A.z ;
 Leading (p : P.P) : U l = (d : Nat) * (RL[A].unit (P.coef p d)) * Bound.Bound (suc d) p ;
 Result (p : P.P) : U l = Plus (Zero p) (Leading p) ;
 scan-step (n : Nat)
  (ih : (p : P.P) -> Bound.Bound n p -> Result p)
  (p : P.P) (bound : Bound.Bound (suc n) p) :
  Plus (Id A.R (P.coef p n) A.z) (RL[A].unit (P.coef p n)) -> Result p = split {
  inl h -> ih p (Bound.lower-bound n p bound h) ;
  inr u -> inr (n,u,bound) } ;
 scan : (n : Nat) (p : P.P) -> Bound.Bound n p -> Result p = split {
  zero -> \ p bound -> inl bound ;
  suc n | ih -> \ p bound -> scan-step n ih p bound (dec (P.coef p n)) } ;
 result (p : P.P) : Result p = scan (P.plen p) p (M.coef-beyond p) ;
 nonzero-result (p : P.P) (i : Nat) (nonzero : Not (Id A.R (P.coef p i) A.z)) : Result p -> Leading p = split {
  inl h -> efq (nonzero (h i)) ; inr h -> h } ;
 leading (p : P.P) (i : Nat) (nonzero : Not (Id A.R (P.coef p i) A.z)) : Leading p =
  nonzero-result p i nonzero (result p) ;
 module Normalize (p : P.P) (h : Leading p) {
  polynomial : P.P = M.scal h.2.1.1 p ;
  degree : Nat = h.1 ;
  monic : Id A.R (P.coef polynomial degree) A.o =
   trans (M.coef-scal h.2.1.1 p degree)
    (trans (A.mulC h.2.1.1 (P.coef p degree)) h.2.1.2) ;
  bound : Bound.Bound (suc degree) polynomial = Bound.scale-bound (suc degree) h.2.1.1 p h.2.2 ;
 } ;
} ;
