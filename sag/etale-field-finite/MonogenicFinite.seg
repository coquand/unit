-- A zero-dimensional algebra generated by one element over a discrete
-- nonzero field is finite, without a finite-presentation hypothesis.
-- For the generator x take x^N(1-x*b)=0 and merely write b=P(x).
-- The polynomial X^N(1-X*P) has coefficient 1 in degree N, hence is
-- explicitly nonzero. FieldLeading makes it monic. Monic division
-- then provides a fixed finite spanning family for every element.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Over (A C : CRing) (setA : Pr.isSet A.R) (setC : Pr.isSet C.R)
 (dec : (a : A.R) -> Plus (Id A.R a A.z) (RL[A].unit a))
 (one-nonzero : Not (Id A.R A.o A.z))
 (hom : H.Hom PolynomialRing[l].Extension[A,setA].ring C) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module P = Poly[l].PolyR[A] ; module M = Mul[l].MulR[A] ;
 module Raw = RawLaws[l].Laws[A] ; module RM = RawMultiplication[l].Laws[A] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Leading = FieldLeading[l].Over[A,dec] ;
 module PolyExpansion = PolynomialFiniteExpansion[l].Over[A,C,setA,hom] ;
 module S = FiniteIdeal[l].Sums[C] ; module LC = RL[C] ;
 module Pow = AffinePowers[l].Over[C] ;
 module ZD = IntegralDescent[l].ZeroDim[C,setC] ;
 Representation (c : C.R) : U l = (p : P.P) * Id C.R (hom.1 (B.include p)) c ;
 PolynomialGeneration : U l = (c : C.R) -> Tr.Trunc[Representation c].carrier ;
 Coordinates (n : Nat) (v : Fin n -> C.R) (c : C.R) : U l =
  (lambda : Fin n -> A.R) *
   Id C.R (S.sum n (\ i -> C.mul (PolyExpansion.phi.1 (lambda i)) (v i))) c ;
 Finite : U l = (n : Nat) * (v : Fin n -> C.R) *
  ((c : C.R) -> Tr.Trunc[Coordinates n v c].carrier) ;

 module FromMonic (generated : PolynomialGeneration) (f : P.P) (d : Nat)
  (monic : Id A.R (P.coef f d) A.o) (bound : Bounds.Bound (suc d) f)
  (root : Id C.R (hom.1 (B.include f)) C.z) {
  module Q = MonicQuotientCoordinates[l].Over[A,C,setA,hom].At[f,d,monic,bound,root] ;
  spanning (c : C.R) (p : Representation c) : Coordinates d (PolyExpansion.basis d) c =
   (Q.coordinates p.1,trans (sym (Q.equation p.1)) p.2) ;
  finite : Finite = (d,PolyExpansion.basis d,
   \ c -> TC.map (Representation c) (Coordinates d (PolyExpansion.basis d) c) (spanning c) (generated c)) ;
 } ;

 scaled (a : A.R) (p : P.P) :
  Id B.Carrier (B.include (M.scal a p)) (B.mulQ (B.constant a) (B.include p)) =
  sym (trans (B.Multiply.beta (Raw.constantP a) p)
   (B.Q.relates _ _ (RM.mul-single-left a p))) ;
 scale-root (p : P.P) (a : A.R) (root : Id C.R (hom.1 (B.include p)) C.z) :
  Id C.R (hom.1 (B.include (M.scal a p))) C.z =
  trans (ap hom.1 (scaled a p))
   (trans (hom.2.2.2 (B.constant a) (B.include p))
    (trans (ap (C.mul (hom.1 (B.constant a))) root) (LC.mul-zero (hom.1 (B.constant a))))) ;
 module FromRelation (generated : PolynomialGeneration) (f : P.P) (i : Nat)
  (nonzero : Not (Id A.R (P.coef f i) A.z))
  (root : Id C.R (hom.1 (B.include f)) C.z) {
  leading : Leading.Leading f = Leading.leading f i nonzero ;
  module N = Leading.Normalize[f,leading] ;
  normalized-root : Id C.R (hom.1 (B.include N.polynomial)) C.z = scale-root f leading.2.1.1 root ;
  finite : Finite = FromMonic[generated,N.polynomial,N.degree,N.monic,N.bound,normalized-root].finite ;
 } ;

 -- Multiplication by X^N on raw coefficient lists, with named laws.
 shift : Nat -> P.P -> P.P = split {
  zero -> \ p -> p ; suc n | r -> \ p -> cons A.z (r p) } ;
 shifted-coefficient : (n : Nat) (p : P.P) -> Id A.R (P.coef (shift n p) n) (P.coef p zero) = split {
  zero -> \ p -> refl (P.coef p zero) ; suc n | r -> r } ;
 shift-one (p : P.P) : Id C.R (hom.1 (B.include (cons A.z p)))
  (C.mul PolyExpansion.variable (hom.1 (B.include p))) =
  trans (ap hom.1 (B.horner A.z p))
   (trans (hom.2.2.1 (B.constant A.z) (B.mulQ B.variable (B.include p)))
    (trans (cong2 C.R C.add _ _ _ _ (H.zero A C PolyExpansion.phi)
      (hom.2.2.2 B.variable (B.include p)))
     (LC.zl (C.mul PolyExpansion.variable (hom.1 (B.include p)))))) ;
 shifted-image : (n : Nat) (p : P.P) ->
  Id C.R (hom.1 (B.include (shift n p)))
   (C.mul (Pow.power PolyExpansion.variable n) (hom.1 (B.include p))) = split {
  zero -> \ p -> sym (LC.one-left (hom.1 (B.include p))) ;
  suc n | r -> \ p -> trans (shift-one (shift n p))
   (trans (ap (C.mul PolyExpansion.variable) (r p))
    (C.mulA PolyExpansion.variable (Pow.power PolyExpansion.variable n) (hom.1 (B.include p)))) } ;
 negative-image (p : P.P) :
  Id C.R (hom.1 (B.include (Raw.negP p))) (C.neg (hom.1 (B.include p))) =
  trans (ap hom.1 (sym (B.Negate.beta p))) (H.negation B.ring C hom (B.include p)) ;
 unit-minus (p : P.P) : Id C.R (hom.1 (B.include (cons A.o (Raw.negP p))))
  (C.add C.o (C.neg (C.mul PolyExpansion.variable (hom.1 (B.include p))))) =
  trans (ap hom.1 (B.horner A.o (Raw.negP p)))
   (trans (hom.2.2.1 (B.constant A.o) (B.mulQ B.variable (B.include (Raw.negP p))))
    (cong2 C.R C.add _ _ _ _ hom.2.1
     (trans (hom.2.2.2 B.variable (B.include (Raw.negP p)))
      (trans (ap (C.mul PolyExpansion.variable) (negative-image p))
       (LC.mul-neg PolyExpansion.variable (hom.1 (B.include p))))))) ;

 module FromZeroDim (generated : PolynomialGeneration) (w : ZD.Witness PolyExpansion.variable)
  (p : Representation w.2.1) {
  relation : P.P = shift w.1 (cons A.o (Raw.negP p.1)) ;
  nonzero : Not (Id A.R (P.coef relation w.1) A.z) =
   \ e -> one-nonzero (trans (sym (shifted-coefficient w.1 (cons A.o (Raw.negP p.1)))) e) ;
  root : Id C.R (hom.1 (B.include relation)) C.z =
   trans (shifted-image w.1 (cons A.o (Raw.negP p.1)))
    (trans (ap (C.mul (Pow.power PolyExpansion.variable w.1))
      (trans (unit-minus p.1)
       (ap (\ b -> C.add C.o (C.neg (C.mul PolyExpansion.variable b))) p.2))) w.2.2) ;
  finite : Finite = FromRelation[generated,relation,w.1,nonzero,root].finite ;
 } ;
 from-witness (generated : PolynomialGeneration) (w : ZD.Witness PolyExpansion.variable) : Tr.Trunc[Finite].carrier =
  TC.map (Representation w.2.1) Finite (\ p -> FromZeroDim[generated,w,p].finite) (generated w.2.1) ;
 theorem (generated : PolynomialGeneration) (zero-dimensional : ZD.Property) : Tr.Trunc[Finite].carrier =
  TC.bind (ZD.Witness PolyExpansion.variable) Finite (from-witness generated) (zero-dimensional PolyExpansion.variable) ;
} ;
