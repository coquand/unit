-- User-facing Nagata theorem for a normalized expression expansion.
-- It retains the original algebra and expression relation, transports
-- coefficients along an algebra map, and makes the resulting relation
-- monic over the smaller coefficient algebra.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a))
 (nontrivial : Not (Id k.R k.o k.z)) {
 module C = Algebras[l].Over[k,setk] ; module P = Presentations[l].Over[k,setk] ;
 zero-case (a : k.R) : Plus (Id k.R a k.z) (RL[k].unit a) ->
  Plus (Id k.R a k.z) (Not (Id k.R a k.z)) = split {
   inl eq -> inl eq ;
   inr inv -> inr (\ eq -> nontrivial (trans (sym inv.2)
    (trans (ap (\ b -> k.mul b inv.1) eq) (RL[k].zero-mul inv.1)))) } ;
 zero-dec (a : k.R) : Plus (Id k.R a k.z) (Not (Id k.R a k.z)) = zero-case a (dec a) ;
 nonzero-unit-case (a : k.R) (nz : Not (Id k.R a k.z)) :
  Plus (Id k.R a k.z) (RL[k].unit a) -> RL[k].unit a = split {
   inl eq -> efq (nz eq) ; inr inv -> inv } ;
 nonzero-unit (a : k.R) (nz : Not (Id k.R a k.z)) : RL[k].unit a = nonzero-unit-case a nz (dec a) ;
 module Expression (n : Nat) (e : P.Expr (Fin n))
  (sparse : MonomialFamily[l].Over[k,setk,n].Normalized[zero-dec].SparseData[e]) {
  module W = NagataWeights[l].Family[n,sparse.size,sparse.exponent] ;
  module At (A S : C.Algebra) (jota : C.Hom A S) (seed : Fin sparse.size)
   (y : Fin n -> A.ring.R) (t : S.ring.R) (x : Fin n -> S.ring.R) {
   module N = NagataFamily[l].Over[k,A.ring,A.set,A.iota,n,sparse.size,sparse.coefficient,sparse.exponent,sparse.distinct,seed,y] ;
   module V = N.Target[S.ring,S.set,jota.1,t] ;
   inverse : RL[k].unit (sparse.coefficient N.index) = nonzero-unit (sparse.coefficient N.index) (sparse.nonzero N.index) ;
   module Normal = N.Normalize[inverse] ; module NV = V.Normalized[inverse] ;
   module Sum = FiniteIdeal[l].Sums[S.ring] ; module Mono = MonomialEvaluation[l].Over[S.ring] ;
   shifted : Fin n -> S.ring.R = V.EV.shifted n y ;
   terms (i : Fin sparse.size) : S.ring.R = S.ring.mul (S.iota.1 (sparse.coefficient i)) (Mono.monomial n x (sparse.exponent i)) ;
   term-equal (eq : (i : Fin n) -> Id S.ring.R (shifted i) (x i)) (j : Fin sparse.size) :
    Id S.ring.R (V.terms j) (terms j) =
    cong2 S.ring.R S.ring.mul _ _ _ _ (jota.2 (sparse.coefficient j))
     (NagataSemantics[l].Congruence[S.ring].ext n shifted x eq (sparse.exponent j)) ;
   sum-equal (eq : (i : Fin n) -> Id S.ring.R (shifted i) (x i)) :
    Id S.ring.R (Sum.sum sparse.size V.terms) (P.eval (Fin n) S x e) =
    trans (Sum.sum-cong sparse.size V.terms terms (term-equal eq)) (sym (sparse.value S x)) ;
   root (eq : (i : Fin n) -> Id S.ring.R (shifted i) (x i))
    (h : Id S.ring.R (P.eval (Fin n) S x e) S.ring.z) :
    Id S.ring.R (V.E.extend.1 (N.B.include Normal.raw)) S.ring.z =
    NV.root (trans (sum-equal eq) h) ;
  } ;
 } ;
} ;
