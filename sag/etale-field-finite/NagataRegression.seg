-- Concrete regressions for distinct monomials of the same ordinary
-- total degree, a constant relation (degree zero), and radix one.
-- The coefficient ring may have characteristic two or be the zero ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module E = MonomialExponents[l] ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ;
first : Fin two = inl (inr tt) ; last : Fin two = inr tt ;
singleton-prop : (i j : Fin one) -> Id (Fin one) i j = split {
 inl e -> \ j -> efq e ;
 inr u -> split { inl e -> efq e ; inr v -> ap (\ t -> inr t) (MnSums[l].top-eq u v) } } ;
vectors : Fin two -> E.Exponent two = E.unit two ;
distinct : (i j : Fin two) -> Id (E.Exponent two) (vectors i) (vectors j) -> Id (Fin two) i j = split {
 inl i -> split {
  inl j -> \ eq -> ap (\ t -> inl t) (singleton-prop i j) ;
  inr v -> \ eq -> efq (zero-suc zero (ap (\ u -> u last) eq)) } ;
 inr u -> split {
  inl j -> \ eq -> efq (suc-zero zero (ap (\ v -> v last) eq)) ;
  inr v -> \ eq -> ap (\ t -> inr t) (MnSums[l].top-eq u v) } } ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module N = NagataFamily[l].Over[A,A,setA,RingHom[l].identity A,two,two,
  \ j -> A.o,vectors,distinct,first,\ i -> A.z] ;
 chosen : Id (Fin two) N.index first = refl first ;
 radix-three : Id Nat N.F.radix three = refl three ;
 first-weight : Id Nat (N.degree first) three = refl three ;
 last-weight : Id Nat (N.degree last) one = refl one ;
 degree-three : Id Nat N.top three = refl three ;
 module Normal = N.Normalize[(A.o,A.mulO A.o)] ;
 leading-one : Id A.R (N.P.coef Normal.raw three) A.o = Normal.monic ;
 bounded : N.N.Bound.Bound (suc three) Normal.raw = Normal.bounded ;
 module C = NagataFamily[l].Over[A,A,setA,RingHom[l].identity A,two,one,
  \ j -> A.o,\ j -> E.zeroE two,\ i j eq -> singleton-prop i j,inr tt,\ i -> A.z] ;
 constant-degree : Id Nat C.top zero = refl zero ;
 radix-one : Id Nat C.F.radix one = refl one ;
 module Constant = C.Normalize[(A.o,A.mulO A.o)] ;
 constant-leading : Id A.R (C.P.coef Constant.raw zero) A.o = Constant.monic ;
 constant-bound : C.N.Bound.Bound one Constant.raw = Constant.bounded ;
 module D = IntegralDescent[l].ZeroDim[A,setA] ;
 zero-dimensional-unit : D.Equation A.o zero A.o =
  trans (RL[A].one-left (A.add A.o (A.neg (A.mul A.o A.o))))
   (trans (ap (\ t -> A.add A.o (A.neg t)) (A.mulO A.o)) (A.addN A.o)) ;
 corrected-iteration : Id A.R (AffinePowers[l].Over[A].power A.o zero)
  (A.mul (AffinePowers[l].Over[A].power A.o three)
   (AffinePowers[l].Over[A].power A.o (plus three zero))) =
  D.Iterate[A.o,zero,A.o,zero-dimensional-unit].iterate three ;
} ;
