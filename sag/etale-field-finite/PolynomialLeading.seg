-- Leading coefficients under products, with explicit degree bounds.
-- This is over an arbitrary coefficient ring. Cutting at the bound
-- gives lists of exactly d+1 coefficients. The checked product bound
-- and top-coefficient theorem of the monic-division library then apply;
-- no cancellation or nonzero assumptions on leading coefficients.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) {
 open A ; module L = RL[A] ;
 module P = Poly[l].PolyR[A] ; module M = Mul[l].MulR[A] ;
 module Raw = RawLaws[l].Laws[A] ; module RM = RawMultiplication[l].Laws[A] ;
 module Bound = PolynomialBounds[l].Over[A] ;
 module MP = MonicPowers[l].Raw[A] ;
 Lead (d : Nat) (p : P.P) (c : R) : U l = Bound.Bound (suc d) p * Id R (P.coef p d) c ;
 equal (d : Nat) (p q : P.P) (c : R) (eq : P.peq p q) (h : Lead d p c) : Lead d q c =
  (Bound.equal-bound (suc d) p q eq h.1,trans (sym (eq d)) h.2) ;
 lead-zero (d : Nat) : Lead d nil z = (\ k -> refl z,refl z) ;
 lead-constant (c : R) : Lead zero (cons c nil) c = (\ k -> refl z,refl c) ;
 lead-add (d : Nat) (p q : P.P) (c c' : R) (hp : Lead d p c) (hq : Lead d q c') :
  Lead d (M.addP p q) (A.add c c') =
  (Bound.add-bound (suc d) p q hp.1 hq.1,
   trans (M.coef-addP p q d) (cong2 R A.add _ _ _ _ hp.2 hq.2)) ;
 lead-scale (d : Nat) (p : P.P) (c a : R) (hp : Lead d p c) : Lead d (M.scal a p) (mul a c) =
  (Bound.scale-bound (suc d) a p hp.1,trans (M.coef-scal a p d) (ap (mul a) hp.2)) ;
 module Cut (d : Nat) (p : P.P) (c : R) (h : Lead d p c) {
  polynomial : P.P = Bound.cut (suc d) p ;
  length : Id Nat (P.plen polynomial) (suc d) = Bound.cut-length (suc d) p ;
  bound : Bound.Bound (suc d) polynomial = Bound.cut-bound (suc d) p ;
  equation : P.peq p polynomial = Bound.cut-equal (suc d) p h.1 ;
  leading : Id R (P.coef polynomial d) c = trans (sym (equation d)) h.2 ;
  last : Id R (P.lastD polynomial) c = trans (sym (M.coef-top polynomial d length)) leading ;
 } ;
 module Product (d e : Nat) (p q : P.P) (c c' : R) (hp : Lead d p c) (hq : Lead e q c') {
  module F = Cut[d,p,c,hp] ; module G = Cut[e,q,c',hq] ;
  polynomial : P.P = M.pmul F.polynomial G.polynomial ;
  degree : Nat = plus e d ;
  equal-degree : Id Nat (plus d (P.plen G.polynomial)) (suc degree) =
   trans (ap (plus d) G.length)
    (trans (plus-suc d e) (ap (\ k -> suc k) (plus-comm d e))) ;
  bound : Bound.Bound (suc degree) polynomial =
   \ k -> trans (ap (P.coef polynomial) (ap (\ j -> plus j k) (sym equal-degree)))
    (MP.product-bound d F.polynomial F.bound G.polynomial k) ;
  leading : Id R (P.coef polynomial degree) (mul c c') =
   trans (MonicRegular[l].Raw[A].At[F.polynomial,d,F.length].top G.polynomial e G.length)
    (cong2 R mul _ _ _ _ F.last G.last) ;
  equation : P.peq (M.pmul p q) polynomial = RM.mul-cong p F.polynomial q G.polynomial F.equation G.equation ;
  result : Lead degree (M.pmul p q) (mul c c') =
   equal degree polynomial (M.pmul p q) (mul c c') (P.peq-sym _ _ equation) (bound,leading) ;
 } ;
 product (d e : Nat) (p q : P.P) (c c' : R) (hp : Lead d p c) (hq : Lead e q c') :
  Lead (plus e d) (M.pmul p q) (mul c c') = Product[d,e,p,q,c,c',hp,hq].result ;
} ;
