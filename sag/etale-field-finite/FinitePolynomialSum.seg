-- Finite sums of raw polynomials and bounds enlarged by an explicit
-- natural-number inequality. These are independent of field hypotheses.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module O = NatOrder[l] ;
module Over (A : CRing) {
 module P = Poly[l].PolyR[A] ; module M = Mul[l].MulR[A] ;
 module B = PolynomialBounds[l].Over[A] ; module S = FiniteIdeal[l].Sums[A] ;
 sum : (n : Nat) -> (Fin n -> P.P) -> P.P = split {
  zero -> \ p -> nil ;
  suc n | rec -> \ p -> M.addP (p (inr tt)) (rec (\ i -> p (inl i))) } ;
 coefficient : (n : Nat) (p : Fin n -> P.P) (d : Nat) ->
  Id A.R (P.coef (sum n p) d) (S.sum n (\ i -> P.coef (p i) d)) = split {
   zero -> \ p d -> refl A.z ;
   suc n | rec -> \ p d -> trans (M.coef-addP (p (inr tt)) (sum n (\ i -> p (inl i))) d)
    (ap (A.add (P.coef (p (inr tt)) d)) (rec (\ i -> p (inl i)) d)) } ;
 bound : (n : Nat) (p : Fin n -> P.P) (d : Nat) ->
  ((i : Fin n) -> B.Bound d (p i)) -> B.Bound d (sum n p) = split {
   zero -> \ p d h k -> refl A.z ;
   suc n | rec -> \ p d h -> B.add-bound d (p (inr tt)) (sum n (\ i -> p (inl i)))
    (h (inr tt)) (rec (\ i -> p (inl i)) d (\ i -> h (inl i))) } ;
 above (d e : Nat) (p : P.P) (h : B.Bound d p) (le : O.Le d e) : Id A.R (P.coef p e) A.z =
  trans (ap (P.coef p) (trans (O.le-plus d e le).2 (plus-comm (O.le-plus d e le).1 d)))
   (h (O.le-plus d e le).1) ;
 weaken (d e : Nat) (p : P.P) (h : B.Bound d p) (le : O.Le d e) : B.Bound e p =
  \ k -> above d (plus e k) p h (O.le-trans d e (plus e k) le (NagataWeights[l].le-left e k)) ;
 module Polynomial (setA : Pr.isSet A.R) {
  module BQ = PolynomialRing[l].Extension[A,setA] ;
  module SQ = FiniteIdeal[l].Sums[BQ.ring] ;
  include-sum : (n : Nat) (p : Fin n -> P.P) ->
   Id BQ.Carrier (BQ.include (sum n p)) (SQ.sum n (\ i -> BQ.include (p i))) = split {
    zero -> \ p -> refl BQ.zeroQ ;
    suc n | rec -> \ p -> trans (sym (BQ.Add.beta (p (inr tt)) (sum n (\ i -> p (inl i)))))
     (ap (BQ.addQ (BQ.include (p (inr tt)))) (rec (\ i -> p (inl i)))) } ;
  include-scale (a : A.R) (p : P.P) :
   Id BQ.Carrier (BQ.include (M.scal a p)) (BQ.mulQ (BQ.constant a) (BQ.include p)) =
   trans (sym (BQ.Q.relates _ _ (RawMultiplication[l].Laws[A].mul-single-left a p)))
    (sym (BQ.Multiply.beta (cons a nil) p)) ;
 } ;
} ;
module Map (A C : CRing) (h : H.Hom A C) {
 module SA = FiniteIdeal[l].Sums[A] ; module SC = FiniteIdeal[l].Sums[C] ;
 sum : (n : Nat) (v : Fin n -> A.R) -> Id C.R (h.1 (SA.sum n v)) (SC.sum n (\ i -> h.1 (v i))) = split {
  zero -> \ v -> H.zero A C h ;
  suc n | rec -> \ v -> trans (h.2.2.1 (v (inr tt)) (SA.sum n (\ i -> v (inl i))))
   (ap (C.add (h.1 (v (inr tt)))) (rec (\ i -> v (inl i)))) } ;
} ;
