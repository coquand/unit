-- Algebraic dimension zero descends along an integral injection.
-- Definition: for every x, merely N,b with x^N(1-xb)=0.
-- If d=d*x*b and p(b)=0 is monic of degree h, multiplication by
-- d*x^h gives d*(1+c_(h-1)x+...+c_0*x^h)=0.  This is proved by
-- induction on the coefficient list; no prime-ideal language is used.
-- All choices remain under the truncation in the dimension-zero witness.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Ps = Presentations[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ;

module Polynomial (A : CRing) {
 open A ; module L = RL[A] ; module Pow = AffinePowers[l].Over[A] ;
 -- A list records the lower coefficients of a monic polynomial.
 value (b : R) : List R -> R = split {
  nil -> o ; cons c cs | r -> add c (mul b r) } ;
 -- reciprocal = 1+c_(h-1)x+...+c_0*x^h
 reciprocal (x : R) : List R -> R = split {
  nil -> o ; cons c cs | r -> add (mul c (Pow.power x (suc (len cs)))) r } ;
 -- reciprocal = 1+x*cofactor, including the empty coefficient list.
 cofactor (x : R) : List R -> R = split {
  nil -> z ; cons c cs | r -> add (mul c (Pow.power x (len cs))) r } ;
 factor (x : R) : (cs : List R) ->
  Id R (reciprocal x cs) (add o (mul x (cofactor x cs))) = split {
  nil -> sym (trans (ap (add o) (L.mul-zero x)) (addZ o)) ;
  cons c cs | r ->
   trans (Ps.cong2 R add _ _ _ _ (L.mul-swap c x (Pow.power x (len cs))) r)
    (trans (L.add-swap (mul x (mul c (Pow.power x (len cs)))) o (mul x (cofactor x cs)))
     (ap (add o) (sym (dist x (mul c (Pow.power x (len cs))) (cofactor x cs))))) } ;
 negative-cofactor (x t : R) :
  Id R (add o (neg (mul x (neg t)))) (add o (mul x t)) =
  ap (add o) (trans (ap neg (L.mul-neg x t)) (L.neg-neg (mul x t))) ;

 module Weighted (d x b : R) (absorb : Id R d (mul d (mul x b))) {
  step (w : R) : Id R (mul d (mul (mul x b) w)) (mul d w) =
   trans (mulA d (mul x b) w) (ap (\ u -> mul u w) (sym absorb)) ;
  clear : (cs : List R) ->
   Id R (mul d (mul (Pow.power x (len cs)) (value b cs)))
    (mul d (reciprocal x cs)) = split {
   nil -> ap (mul d) (mulO o) ;
   cons c cs | r ->
    calc R {
     mul d (mul (Pow.power x (suc (len cs))) (add c (mul b (value b cs))))
      =< ap (mul d) (dist (Pow.power x (suc (len cs))) c (mul b (value b cs))) >
       mul d (add (mul (Pow.power x (suc (len cs))) c)
        (mul (Pow.power x (suc (len cs))) (mul b (value b cs))))
      =< dist d (mul (Pow.power x (suc (len cs))) c)
          (mul (Pow.power x (suc (len cs))) (mul b (value b cs))) >
       add (mul d (mul (Pow.power x (suc (len cs))) c))
        (mul d (mul (Pow.power x (suc (len cs))) (mul b (value b cs))))
      =< Ps.cong2 R add _ _ _ _
          (ap (mul d) (mulC (Pow.power x (suc (len cs))) c))
          (trans (ap (mul d) (L.mul-four x (Pow.power x (len cs)) b (value b cs)))
           (trans (step (mul (Pow.power x (len cs)) (value b cs))) r)) >
       add (mul d (mul c (Pow.power x (suc (len cs))))) (mul d (reciprocal x cs))
      =< sym (dist d (mul c (Pow.power x (suc (len cs)))) (reciprocal x cs)) >
       mul d (reciprocal x (cons c cs)) } } ;
  annihilate (cs : List R) (root : Id R (value b cs) z) :
   Id R (mul d (reciprocal x cs)) z =
   trans (sym (clear cs))
    (trans (ap (\ t -> mul d (mul (Pow.power x (len cs)) t)) root)
     (trans (ap (mul d) (L.mul-zero (Pow.power x (len cs)))) (L.mul-zero d))) ;
 } ;
} ;

module ZeroDim (A : CRing) (setA : Pr.isSet A.R) {
 open A ; module L = RL[A] ; module Pow = AffinePowers[l].Over[A] ;
 module Laws = AffineRing[l].Laws[A,setA] ;
 Equation (x : R) (n : Nat) (b : R) : U l =
  Id R (mul (Pow.power x n) (add o (neg (mul x b)))) z ;
 Witness (x : R) : U l = (n : Nat) * (b : R) * Equation x n b ;
 At (x : R) : U l = Tr.Trunc[Witness x].carrier ;
 Property : U l = (x : R) -> At x ;
 absorption (x : R) (n : Nat) (b : R) (eq : Equation x n b) :
  Id R (Pow.power x n) (mul (Pow.power x n) (mul x b)) =
  Laws.difference-zero (Pow.power x n) (mul (Pow.power x n) (mul x b))
   (trans (sym (trans (dist (Pow.power x n) o (neg (mul x b)))
      (Ps.cong2 R add _ _ _ _ (mulO (Pow.power x n)) (L.mul-neg (Pow.power x n) (mul x b))))) eq) ;
 from-absorption (x : R) (n : Nat) (b : R)
  (eq : Id R (Pow.power x n) (mul (Pow.power x n) (mul x b))) : Equation x n b =
  trans (dist (Pow.power x n) o (neg (mul x b)))
   (trans (Ps.cong2 R add _ _ _ _ (mulO (Pow.power x n)) (L.mul-neg (Pow.power x n) (mul x b)))
    (trans (ap (\ u -> add u (neg (mul (Pow.power x n) (mul x b)))) eq)
     (addN (mul (Pow.power x n) (mul x b))))) ;
 regular-equation (x b : R) (eq : Id R x (mul (mul x x) b)) : Equation x (suc zero) b =
  from-absorption x (suc zero) b
   (trans (mulO x)
    (trans eq (trans (sym (mulA x x b)) (ap (\ u -> mul u (mul x b)) (sym (mulO x)))))) ;
 from-regular
  (regular : (x : R) -> Tr.Trunc[(b : R) * Id R x (mul (mul x x) b)].carrier) : Property =
  \ x -> TC.map ((b : R) * Id R x (mul (mul x x) b)) (Witness x)
   (\ h -> (suc zero,h.1,regular-equation x h.1 h.2)) (regular x) ;
 -- Correct iteration: x^N = b^j*x^(N+j), not x^(N+j)=b^j*x^(N+j+1).
 module Iterate (x : R) (n : Nat) (b : R) (eq : Equation x n b) {
  one-step : Id R (Pow.power x n) (mul b (Pow.power x (suc n))) =
   trans (absorption x n b eq)
    (trans (L.mul-swap (Pow.power x n) x b)
     (trans (ap (mul x) (mulC (Pow.power x n) b)) (L.mul-swap x b (Pow.power x n)))) ;
  shifted (j : Nat) : Id R (Pow.power x (plus j n)) (mul b (Pow.power x (suc (plus j n)))) =
   trans (Pow.power-add x j n)
    (trans (ap (mul (Pow.power x j)) one-step)
     (trans (L.mul-swap (Pow.power x j) b (Pow.power x (suc n)))
      (ap (mul b) (trans (sym (Pow.power-add x j (suc n))) (ap (Pow.power x) (plus-suc j n)))))) ;
  iterate : (j : Nat) ->
   Id R (Pow.power x n) (mul (Pow.power b j) (Pow.power x (plus j n))) = split {
   zero -> sym (L.one-left (Pow.power x n)) ;
   suc j | r -> trans r
    (trans (ap (mul (Pow.power b j)) (shifted j))
     (trans (mulA (Pow.power b j) b (Pow.power x (suc (plus j n))))
      (ap (\ t -> mul t (Pow.power x (suc (plus j n)))) (mulC (Pow.power b j) b)))) } ;
 } ;
} ;

module Map (A C : CRing) (iota : H.Hom A C) {
 module PA = Polynomial[A] ; module PC = Polynomial[C] ;
 coefficients : List A.R -> List C.R = split {
  nil -> nil ; cons c cs | r -> cons (iota.1 c) r } ;
 length : (cs : List A.R) -> Id Nat (len (coefficients cs)) (len cs) = split {
  nil -> refl zero ; cons c cs | r -> ap (\ n -> suc n) r } ;
 top-power (x : A.R) (cs : List A.R) :
  Id C.R (iota.1 (PA.Pow.power x (suc (len cs))))
   (PC.Pow.power (iota.1 x) (suc (len (coefficients cs)))) =
  trans (AffinePowers[l].power-map A C iota x (suc (len cs)))
   (ap (PC.Pow.power (iota.1 x)) (ap (\ n -> suc n) (sym (length cs)))) ;
 reciprocal-map (x : A.R) : (cs : List A.R) ->
  Id C.R (iota.1 (PA.reciprocal x cs)) (PC.reciprocal (iota.1 x) (coefficients cs)) = split {
  nil -> iota.2.1 ;
  cons c cs | r -> trans (iota.2.2.1 (A.mul c (PA.Pow.power x (suc (len cs)))) (PA.reciprocal x cs))
   (Ps.cong2 C.R C.add _ _ _ _
    (trans (iota.2.2.2 c (PA.Pow.power x (suc (len cs))))
     (ap (C.mul (iota.1 c)) (top-power x cs))) r) } ;
 IntegralWitness (b : C.R) : U l =
  (cs : List A.R) * Id C.R (PC.value b (coefficients cs)) C.z ;
 Integral (b : C.R) : U l = Tr.Trunc[IntegralWitness b].carrier ;
 Extension : U l = (b : C.R) -> Integral b ;

 module Descent (setA : Pr.isSet A.R) (setC : Pr.isSet C.R)
  (injective : (a a' : A.R) -> Id C.R (iota.1 a) (iota.1 a') -> Id A.R a a') {
  module ZA = ZeroDim[A,setA] ; module ZC = ZeroDim[C,setC] ;
  module LC = RL[C] ;
  module At (x : A.R) (n : Nat) (b : C.R) (eq : ZC.Equation (iota.1 x) n b)
   (cs : List A.R) (root : Id C.R (PC.value b (coefficients cs)) C.z) {
   module W = PC.Weighted[PC.Pow.power (iota.1 x) n,iota.1 x,b,ZC.absorption (iota.1 x) n b eq] ;
   reciprocal-zero : Id C.R
    (iota.1 (A.mul (PA.Pow.power x n) (PA.reciprocal x cs))) C.z =
    trans (iota.2.2.2 (PA.Pow.power x n) (PA.reciprocal x cs))
     (trans (Ps.cong2 C.R C.mul _ _ _ _
       (AffinePowers[l].power-map A C iota x n) (reciprocal-map x cs))
      (W.annihilate (coefficients cs) root)) ;
   source-zero : Id A.R (A.mul (PA.Pow.power x n) (PA.reciprocal x cs)) A.z =
    injective (A.mul (PA.Pow.power x n) (PA.reciprocal x cs)) A.z
     (trans reciprocal-zero (sym (H.zero A C iota))) ;
   equation : ZA.Equation x n (A.neg (PA.cofactor x cs)) =
    trans (ap (A.mul (PA.Pow.power x n))
      (trans (PA.negative-cofactor x (PA.cofactor x cs)) (sym (PA.factor x cs)))) source-zero ;
   witness : ZA.Witness x = (n,A.neg (PA.cofactor x cs),equation) ;
  } ;
  descend-witness (integral : Extension) (x : A.R) (w : ZC.Witness (iota.1 x)) : ZA.At x =
   TC.map (IntegralWitness w.2.1) (ZA.Witness x)
    (\ p -> At[x,w.1,w.2.1,w.2.2,p.1,p.2].witness) (integral w.2.1) ;
  theorem (integral : Extension) (zero-dimensional : ZC.Property) : ZA.Property =
   \ x -> TC.bind (ZC.Witness (iota.1 x)) (ZA.Witness x)
    (descend-witness integral x) (zero-dimensional (iota.1 x)) ;
 } ;
} ;
