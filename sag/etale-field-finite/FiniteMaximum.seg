-- A maximum in a nonempty finite family of natural numbers, with the
-- chosen index and a bound for every entry. No excluded middle is used.
level l ; open Ring[l] ; open Presentations[l] ;
module O = NatOrder[l] ;
lt-le : (a b : Nat) -> O.Lt a b -> O.Le a b = split {
 zero -> \ b h -> tt ;
 suc a | rec -> split { zero -> \ h -> efq h ; suc b -> \ h -> rec b h } } ;
lt-not-equal : (a b : Nat) -> O.Lt a b -> Not (Id Nat a b) = split {
 zero -> split {
  zero -> \ h e -> efq h ; suc b -> \ h e -> zero-suc b e } ;
 suc a | rec -> split {
  zero -> \ h e -> efq h ; suc b -> \ h e -> rec b h (suc-inj e) } } ;
Maximum (n : Nat) (d : Fin n -> Nat) : U l = (j : Fin n) * ((i : Fin n) -> O.Le (d i) (d j)) ;
top (P : Top -> U l) (p : P tt) : (t : Top) -> P t = split { tt -> p } ;
module Step (n : Nat) (d : Fin (suc n) -> Nat) (h : Maximum n (\ i -> d (inl i))) {
 old-index : Fin (suc n) = inl h.1 ;
 old-bound (q : O.Le (d (inr tt)) (d old-index)) : (i : Fin (suc n)) -> O.Le (d i) (d old-index) = split {
  inl i -> h.2 i ; inr t -> top (\ u -> O.Le (d (inr u)) (d old-index)) q t } ;
 new-bound (q : O.Lt (d old-index) (d (inr tt))) : (i : Fin (suc n)) -> O.Le (d i) (d (inr tt)) = split {
  inl i -> O.le-trans (d (inl i)) (d old-index) (d (inr tt)) (h.2 i) (lt-le _ _ q) ;
  inr t -> top (\ u -> O.Le (d (inr u)) (d (inr tt))) (O.le-refl (d (inr tt))) t } ;
 choose : Plus (O.Le (d (inr tt)) (d old-index)) (O.Lt (d old-index) (d (inr tt))) -> Maximum (suc n) d = split {
  inl q -> (old-index,old-bound q) ;
  inr q -> (inr tt,new-bound q) } ;
 maximum : Maximum (suc n) d = choose (O.le-or-gt (d (inr tt)) (d old-index)) ;
} ;
maximum : (n : Nat) (d : Fin (suc n) -> Nat) -> Maximum (suc n) d = split {
 zero -> \ d -> (inr tt,AffineFinite[l].section zero (\ i -> O.Le (d i) (d (inr tt)))
  (\ i -> efq i) (O.le-refl (d (inr tt)))) ;
 suc n | rec -> \ d -> Step[suc n,d,rec (\ i -> d (inl i))].maximum } ;
inhabited : (n : Nat) (d : Fin n -> Nat) -> Fin n -> Maximum n d = split {
 zero -> \ d i -> efq i ; suc n -> \ d i -> maximum n d } ;
