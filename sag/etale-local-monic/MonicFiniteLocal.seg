-- The local theorem with a MONIC chart, without the loop.
-- Hypotheses: those of FiniteIntroduction before its loop (A local with m
-- and a MERE residual decision dec; q containing m E, proper relative to
-- Bot, prime as the eliminator q-prime-out and merely decided relative to
-- Bot; the ZMT data B, bs, coord, s, zmt), no rad, no exact decision; and,
-- for the field case, E finitely presented, formally unramified and flat
-- over A.
-- Conclusion: merely h in E with q h -> Bot and E[1/h] monic standard
-- over A: a localisation witness for h, a monic Q (lower coefficients) and
-- a denominator D with E[1/h] = (A[T]/(Q))[1/(D Q')].
-- Informal proof.  The Introduction (before its loop) gives y in E, a list
-- G with g = G(y) and g not in q (g-out), Full (every x in E merely has
-- x g^k = r(y)), and y b_i = sum_j b_j a_ji with 1 = sum c_k b_k
-- (integralE, oneE).  The determinant trick gives chi(y) = 0 for the
-- characteristic polynomial chi of a, monic of degree n (LoopInputs.
-- Integral); as a coefficient list it is T^n + lower (MonicWitness).  These
-- are the inputs of ShortLocalEtale (sag/etale-monic-local) over A with
-- G, together with fp, unique and flat: it gives E[1/G(y)] monic standard.
-- Take h = g.  The degree-lowering loop, Q'(y) and rad are not used.
-- The data (y, G, Full, the monic relation, g not in q) need neither fp,
-- unique nor flat (Data); they are what LocalDescent descends from A_M to A.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ;
module H = RingHom[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Tr1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Tr.Trunc[Plus (m a) (RL[A].unit a)].carrier)
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (Bot : U l) (q-prime-out : (a c : E.R) -> (q a -> Bot) -> (q c -> Bot) -> q (E.mul a c) -> Bot) (q-proper : q E.o -> Bot)
 (q-dec : (a : E.R) -> Tr.Trunc[Plus (q a) (q a -> Bot)].carrier)
 (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom A B) (j : H.Hom B E)
 (j-alg : (a : A.R) -> Id E.R (j.1 (iB.1 a)) (iota.1 a))
 (n' : Nat) (bs : Ps.Fin (suc n') -> B.R)
 (coord : (x : B.R) -> Tr.Trunc[(rho : Ps.Fin (suc n') -> A.R) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
 (s : B.R) (s-out : q (j.1 s) -> Bot)
 (zmt : (z : E.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id E.R (E.mul (AffinePowers[l].Over[E].power (j.1 s) k) z) (j.1 b)].carrier) {
 module In = FiniteIntroduction[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,E,setE,iota,q,q-zero,q-add,q-scale,q-m,Bot,q-prime-out,q-proper,q-dec,
  B,setB,iB,j,j-alg,n',bs,coord,s,s-out,zmt] ;
 module C = Algebras[l].Over[A,setA] ;
 module P = Presentations[l].Over[A,setA] ;
 module FE = FormallyEtale[l].Over[A,setA] ;
 module SE = StandardEtale[l].Over[A,setA] ;
 module RX = SE.RX ;
 module I = AffineInterface[l].Over[A,setA] ;
 module Mon = HorrocksInterface[l].Over[A,setA] ;
 Ealg : C.Algebra = C.mkAlgebra E setE iota ;
 -- E[1/h] is monic standard over A
 MonicChart (h : E.R) : U l+ = (loc : I.LocalizationWitness Ealg h) * (lower : List A.R) *
  (denominator : RX.Carrier) * SE.Points[Mon.monic lower,denominator].Standard loc.1 ;
 -- the theorem relative to Bot: h with q h -> Bot and a monic chart at h
 Good : U l+ = (h : E.R) * (q h -> Bot) * MonicChart h ;

 -- the chart data before ShortLocalEtale: y, G = cs, Full at G, a monic
 -- relation of y, and G(y) outside q relative to Bot
 module At (y : E.R) (cs : List A.R) {
  module X = SE.At[E,setE,iota,y] ;
  G : RX.Carrier = RX.include cs ;
  Full : U l = PolynomialFractions[l].Over[A,setA].At[Ealg,y,G].Full ;
  Integral : U l = (lower : List A.R) * Id E.R (X.value (Mon.monic lower)) E.z ;
  Out : U l = q (X.value G) -> Bot ;
 } ;
 ChartData : U l = (y : E.R) * (cs : List A.R) * At[y,cs].Full * Tr.Trunc[At[y,cs].Integral].carrier * At[y,cs].Out ;
 chart-y (d : ChartData) : E.R = d.1 ;
 chart-cs (d : ChartData) : List A.R = d.2.1 ;
 chart-full (d : ChartData) : At[chart-y d,chart-cs d].Full = d.2.2.1 ;
 chart-integral (d : ChartData) : Tr.Trunc[At[chart-y d,chart-cs d].Integral].carrier = d.2.2.2.1 ;
 chart-out (d : ChartData) : At[chart-y d,chart-cs d].Out = d.2.2.2.2 ;
 module Data (x0 : B.R) (F0 : In.Factor x0) {
  module FC = In.FieldCase[x0,F0] ;
  Into (X : U l) (f : X -> Tr.Trunc[ChartData].carrier) (x : Tr.Trunc[X].carrier) : Tr.Trunc[ChartData].carrier =
   TC.bind X ChartData f x ;
  -- at a generator outside q (merely chosen: FC.generator)
  module Gen (gen : In.Generator) {
   module M = In.Main[gen] ;
   module Run (c0 : M.Choice0) (cm : M.Step0[c0].Choice1) (ch : M.Step0[c0].Step1[cm].Choice) {
    module M0 = M.Step0[c0] ; module Ch = M0.Step1[cm].Chosen[ch] ;
    yE : E.R = j.1 M0.y ;
    cs : List A.R = Ch.G ;
    module X = At[yE,cs].X ;
    module HV = HornerValues[l].Over[A,setA,m,m-zero,m-add,m-scale,E,setE,iota,yE] ;
    module PF = PolynomialFractions[l].Over[A,setA].At[Ealg,yE,At[yE,cs].G] ;
    module PE = AffinePowers[l].Over[E] ;
    -- g = G(y)
    g-value : Id E.R (X.value At[yE,cs].G) Ch.gE = sym (HV.value-class cs) ;
    -- Full: x g^k = r(y) gives r(y) = g^k x
    fraction (x : E.R) (w : Ch.CDE.FullAt Ch.G x) : PF.Fraction x =
     (RX.include w.1,w.2.1,
      trans (sym (HV.value-class w.1))
       (trans (sym w.2.2)
        (trans (E.mulC x (PE.power Ch.gE w.2.1)) (ap (\ t -> E.mul (PE.power t w.2.1) x) (sym g-value))))) ;
    full : At[yE,cs].Full = \ x -> TC.map (Ch.CDE.FullAt Ch.G x) (PF.Fraction x) (fraction x) (Ch.full x) ;
    -- the integral equation of y: chi(y) = 0, chi monic of degree n
    module LI = LoopInputs[l].Over[A,setA,m,m-zero,m-add,m-scale,E,setE,iota,yE] ;
    module Int = LI.Integral[n',Ch.RY.a,Ch.bsE,Ch.integralE,Ch.cE,Ch.oneE] ;
    module MW = FiniteSpanIntegral[l].MonicWitness[A,E,setA,setE,iota,yE] ;
    module MWA = MW.At[Int.chi,Int.n,Int.IT.integral.1,Int.IT.integral.2.1,Int.IT.integral.2.2] ;
    integral-of (r : MWA.Reps.Representation Int.chi) : At[yE,cs].Integral =
     (MW.Lists.Bounds.cut Int.n r.1,trans (ap X.ev.1 (sym MWA.Raw[r].normalized)) Int.IT.integral.2.2) ;
    integral : Tr.Trunc[At[yE,cs].Integral].carrier =
     TC.map (MWA.Reps.Representation Int.chi) At[yE,cs].Integral integral-of (MWA.Reps.representation Int.chi) ;
    -- g is not in q, relative to Bot
    g-out : At[yE,cs].Out = \ h -> Ch.g-out (subst q g-value h) ;
    chart-data : ChartData = (yE,cs,full,integral,g-out) ;
   } ;
   theorem : Tr.Trunc[ChartData].carrier =
    Into M.Choice0 (\ c0 ->
     Into (M.Step0[c0].Choice1) (\ cm ->
      Into (M.Step0[c0].Step1[cm].Choice) (\ ch -> Tr.Trunc[ChartData].inc Run[c0,cm,ch].chart-data)
       (M.Step0[c0].Step1[cm].choice))
      (M.Step0[c0].choice1))
     M.choice0 ;
  } ;
  theorem : Tr.Trunc[ChartData].carrier = Into In.Generator (\ gen -> Gen[gen].theorem) FC.generator ;
 } ;
 -- the chart: ShortLocalEtale at the data, h = G(y)
 module SmoothField (x0 : B.R) (F0 : In.Factor x0) (fp : P.FP Ealg) (unique : FE.Unique Ealg)
  (smooth : FE.Lift Ealg) {
  module Chart (d : ChartData) {
   module Short = ShortLocalEtale[l].Over[A,setA,chart-cs d].At[Ealg,chart-y d,chart-full d,unique] ;
   good (r : Short.Result) : Good = (At[chart-y d,chart-cs d].X.value At[chart-y d,chart-cs d].G,chart-out d,r) ;
   theorem : Tr1.Trunc[Good].carrier =
    TC1.map Short.Result Good good (Short.theorem fp (chart-integral d) smooth) ;
  } ;
  theorem : Tr1.Trunc[Good].carrier =
   Tr.Trunc[ChartData].induction @(l+) (\ w -> Tr1.Trunc[Good].carrier) (\ w -> Tr1.Trunc[Good].proposition)
    (\ d -> Chart[d].theorem) Data[x0,F0].theorem ;
 } ;
 -- Preserve the flat endpoint through the proved lifting implication.
 module Field (x0 : B.R) (F0 : In.Factor x0) (fp : P.FP Ealg) (unique : FE.Unique Ealg)
  (flat : FlatRelations[l].Over[A,E,iota].Flat) {
  module Smooth = SmoothField[x0,F0,fp,unique,FlatUnramifiedEtale[l].Over[A,setA].At[Ealg,fp,unique,flat].lift] ;
  module Chart (d : ChartData) {
   theorem : Tr1.Trunc[Good].carrier = Smooth.Chart[d].theorem ;
  } ;
  theorem : Tr1.Trunc[Good].carrier = Smooth.theorem ;
 } ;
} ;
