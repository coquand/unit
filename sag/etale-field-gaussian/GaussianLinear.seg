-- Coordinate operations used in one Gaussian pivot.  All maps carry
-- their linearity laws; later induction uses these laws by name.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) {
 module V = GaussianVectors[l].Over[A] ; module L = RL[A] ;
 drop (n : Nat) : V.Linear[suc n,n] = new V.Linear[suc n,n,\ v i -> v (inl i),
  \ i -> refl A.z,\ v w i -> refl (A.add (v (inl i)) (w (inl i))),
  \ a v i -> refl (A.mul a (v (inl i)))] ;
 adjoin (n : Nat) : V.Linear[n,suc n] =
  new V.Linear[n,suc n,\ v -> snoc (Fin n) A.R v A.z,
   AffineFinite[l].section n (\ i -> Id A.R (snoc (Fin n) A.R (\ j -> A.z) A.z i) A.z)
    (\ i -> refl A.z) (refl A.z),
   \ v w -> AffineFinite[l].section n
    (\ i -> Id A.R (snoc (Fin n) A.R (V.addV n v w) A.z i)
     (A.add (snoc (Fin n) A.R v A.z i) (snoc (Fin n) A.R w A.z i)))
    (\ i -> refl (A.add (v i) (w i))) (sym (A.addZ A.z)),
   \ a v -> AffineFinite[l].section n
    (\ i -> Id A.R (snoc (Fin n) A.R (V.scaleV n a v) A.z i) (A.mul a (snoc (Fin n) A.R v A.z i)))
    (\ i -> refl (A.mul a (v i))) (sym (L.mul-zero a))] ;
 outer (n r : Nat) (u : V.Vec r) (j : Fin n) : V.Linear[n,r] =
  new V.Linear[n,r,\ v -> V.scaleV r (v j) u,\ i -> L.zero-mul (u i),
   \ v w i -> L.dist-left (v j) (w j) (u i),\ a v i -> sym (A.mulA a (v j) (u i))] ;
 difference (n r : Nat) (f g : V.Linear[n,r]) : V.Linear[n,r] =
  new V.Linear[n,r,\ v -> V.subV r (f.map v) (g.map v),
   \ i -> trans (cong2 A.R A.add _ _ _ _ (f.zero i) (ap A.neg (g.zero i))) (A.addN A.z),
   \ v w i -> trans (cong2 A.R A.add _ _ _ _ (f.add v w i) (ap A.neg (g.add v w i)))
    (trans (ap (A.add (A.add (f.map v i) (f.map w i))) (L.neg-add (g.map v i) (g.map w i)))
     (L.swap (f.map v i) (f.map w i) (A.neg (g.map v i)) (A.neg (g.map w i)))),
   \ a v i -> trans (cong2 A.R A.add _ _ _ _ (f.scale a v i) (ap A.neg (g.scale a v i)))
    (trans (ap (A.add (A.mul a (f.map v i))) (sym (L.mul-neg a (g.map v i))))
     (sym (A.dist a (f.map v i) (A.neg (g.map v i)))))] ;
 extend (n r : Nat) (f : V.Linear[n,r]) : V.Linear[suc n,suc r] =
  new V.Linear[suc n,suc r,\ v -> snoc (Fin r) A.R (f.map ((drop n).map v)) (v (inr tt)),
   AffineFinite[l].section r
    (\ i -> Id A.R (snoc (Fin r) A.R (f.map (\ j -> A.z)) A.z i) A.z) f.zero (refl A.z),
   \ v w -> AffineFinite[l].section r
    (\ i -> Id A.R
     (snoc (Fin r) A.R (f.map ((drop n).map (V.addV (suc n) v w))) (A.add (v (inr tt)) (w (inr tt))) i)
     (A.add (snoc (Fin r) A.R (f.map ((drop n).map v)) (v (inr tt)) i)
      (snoc (Fin r) A.R (f.map ((drop n).map w)) (w (inr tt)) i)))
    (f.add ((drop n).map v) ((drop n).map w)) (refl (A.add (v (inr tt)) (w (inr tt)))),
   \ a v -> AffineFinite[l].section r
    (\ i -> Id A.R
     (snoc (Fin r) A.R (f.map ((drop n).map (V.scaleV (suc n) a v))) (A.mul a (v (inr tt))) i)
     (A.mul a (snoc (Fin r) A.R (f.map ((drop n).map v)) (v (inr tt)) i)))
    (f.scale a ((drop n).map v)) (refl (A.mul a (v (inr tt))))] ;
 sub-sub (x y : A.R) : Id A.R (A.add x (A.neg (A.add x (A.neg y)))) y =
  trans (ap (A.add x) (L.negsub x y))
   (trans (A.addA x (A.neg x) y) (trans (ap (\ z -> A.add z y) (A.addN x)) (L.zl y))) ;
 telescope (x y z : A.R) : Id A.R
  (A.add (A.add x (A.neg y)) (A.add y (A.neg z))) (A.add x (A.neg z)) =
  trans (sym (A.addA x (A.neg y) (A.add y (A.neg z))))
   (ap (A.add x) (trans (A.addA (A.neg y) y (A.neg z))
    (trans (ap (\ w -> A.add w (A.neg z)) (L.neg-cancel y)) (L.zl (A.neg z))))) ;
} ;
