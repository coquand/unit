-- Package Gaussian quotient coordinates in the exact TraceBasis record.
-- Only the underlying module is used; no multiplication property beyond
-- the R-algebra scalar action is needed for this adapter.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (dec : (x : A.R) -> Plus (Id A.R x A.z) ((w : A.R) * Id A.R (A.mul x w) A.o))
 (B : Algebras[l].Over[A,setA].Algebra) {
 module UM = FlatRelations[l].Over[A,B.ring,B.iota].Underlying[setA,B.set] ;
 module G = GaussianModuleQuotient[l].Over[A,setA,dec] ;
 module TB = TraceBasis[l].Over[A,setA,B] ;
 module At (n m : Nat) (v : Fin m -> G.V.Vec n) (phi : G.SM.Linear (G.DL.Free n) UM.M)
  (onto : (x : B.ring.R) -> Tr.Trunc[(c : G.V.Vec n) * Id B.ring.R (phi.1 c) x].carrier)
  (relations : (j : Fin m) -> Id B.ring.R (phi.1 (v j)) B.ring.z)
  (kernel : (c : G.V.Vec n) -> Id B.ring.R (phi.1 c) B.ring.z -> Tr.Trunc[G.V.Span[n,m,v].Witness c].carrier) {
  module Q = G.At[n,m,v,UM.M,phi,onto,relations,kernel] ;
  reconstruction (x : B.ring.R) :
   Id B.ring.R (TB.SS.sum Q.rank (\ j -> B.ring.mul (B.iota.1 (Q.coordinate x j)) (Q.vector j))) x =
   trans (sym (trans (G.DL.On[UM.M].lin-value Q.rank Q.vector (Q.coordinate x))
    (UM.sums Q.rank (\ j -> B.ring.mul (B.iota.1 (Q.coordinate x j)) (Q.vector j))))) (Q.expands x) ;
  basis : TB.Basis[Q.rank] = TB.mkBasis Q.rank Q.vector Q.coordinate Q.add Q.scale reconstruction Q.on-vector ;
 } ;
} ;
