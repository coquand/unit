-- F2 regressions exercise both recursion branches, duplicate equations,
-- the empty case, a full-rank quotient, and descent to an actual module.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ; module F2 = BooleanRing[l] ;
A : CRing = F2.two-ring ;
dec : (x : A.R) -> Plus (Id A.R x A.z) ((w : A.R) * Id A.R (A.mul x w) A.o) = split {
 false -> inl (refl false) ; true -> inr (true,refl true) } ;
module G = GaussianQuotient[l].Over[A,dec] ; module V = G.V ;
one : Nat = suc zero ; two : Nat = suc one ; three : Nat = suc two ;
i0 : Fin two = inl (inr tt) ; i1 : Fin two = inr tt ;
pair (a b : A.R) : V.Vec two = snoc (Fin one) A.R (\ i -> a) b ;
empty : G.NormalForm[zero,zero,\ j -> efq j] = G.normal-form zero zero (\ j -> efq j) ;
empty-rank : Id Nat empty.rank zero = refl zero ;
free : G.NormalForm[three,zero,\ j -> efq j] = G.normal-form three zero (\ j -> efq j) ;
free-rank : Id Nat free.rank three = refl three ;
zero-row : G.NormalForm[three,one,\ j i -> false] = G.normal-form three one (\ j i -> false) ;
zero-rank : Id Nat zero-row.rank three = refl three ;
duplicates : G.NormalForm[two,two,\ j -> pair true true] = G.normal-form two two (\ j -> pair true true) ;
duplicate-rank : Id Nat duplicates.rank one = refl one ;
duplicate-project : Id A.R (duplicates.project.map (pair true true) (inr tt)) false = refl false ;
unit-relations (j : Fin two) : V.Vec two = V.D.delta two j ;
full : G.NormalForm[two,two,unit-relations] = G.normal-form two two unit-relations ;
full-rank : Id Nat full.rank zero = refl zero ;
chain : Fin two -> V.Vec three = snoc (Fin one) (V.Vec three)
 (\ j -> snoc (Fin two) A.R (pair true true) false)
 (snoc (Fin two) A.R (pair false true) true) ;
quotient : G.NormalForm[three,two,chain] = G.normal-form three two chain ;
quotient-rank : Id Nat quotient.rank one = refl one ;
quotient-value : Id A.R (quotient.project.map (\ i -> true) (inr tt)) true = refl true ;
module Q = GaussianModuleQuotient[l].Over[A,F2.bool-set,dec] ;
module M = Q.MD ;
addition (x : V.Vec two) : A.R = A.add (x i0) (x i1) ;
phi : Q.SM.Linear (Q.DL.Free two) M.regular =
 (addition,\ x y -> G.L.swap (x i0) (y i0) (x i1) (y i1),\ a x -> sym (A.dist a (x i0) (x i1))) ;
onto (a : A.R) : Tr.Trunc[(c : V.Vec two) * Id A.R (phi.1 c) a].carrier =
 Tr.Trunc[(c : V.Vec two) * Id A.R (phi.1 c) a].inc (pair a false,A.addZ a) ;
relation (j : Fin one) : V.Vec two = pair true true ;
relation-value (j : Fin one) : (i : Fin two) -> Id A.R (relation j i) true =
 AffineFinite[l].section one (\ i -> Id A.R (relation j i) true)
  (\ i -> refl true) (refl true) ;
killed (j : Fin one) : Id A.R (phi.1 (relation j)) false = refl false ;
module Sp = V.Span[two,one,relation] ;
module BoolLaws = F2.Laws[A,F2.and-self] ;
module InKernel (x : V.Vec two) (eq : Id A.R (phi.1 x) false) {
 same : Id A.R (x i0) (x i1) = BoolLaws.sum-zero (x i0) (x i1) eq ;
 coefficient : V.Vec one = \ j -> x i0 ;
 value (i : Fin two) : Id A.R (V.comb two one relation coefficient i) (x i0) =
  trans (ap (\ a -> A.add (A.mul a (x i0)) A.z) (relation-value (inr tt) i))
   (trans (A.addZ (A.mul true (x i0))) (G.L.one-left (x i0))) ;
 witness : Sp.Witness x = (coefficient,AffineFinite[l].section one
  (\ i -> Id A.R (V.comb two one relation coefficient i) (x i))
  (AffineFinite[l].section zero
   (\ j -> Id A.R (V.comb two one relation coefficient (inl j)) (x (inl j))) (\ j -> efq j) (value i0))
  (trans (value i1) same)) ;
} ;
kernel (x : V.Vec two) (eq : Id A.R (phi.1 x) false) : Tr.Trunc[Sp.Witness x].carrier =
 Tr.Trunc[Sp.Witness x].inc InKernel[x,eq].witness ;
module Actual = Q.At[two,one,relation,M.regular,phi,onto,killed,kernel] ;
actual-rank : Id Nat Actual.rank one = refl one ;
actual-basis : Q.DL.On[M.regular].Frame Actual.rank = Actual.frame ;
actual-reconstruct (a : A.R) : Id A.R (Q.DL.On[M.regular].lin Actual.rank Actual.vector (Actual.coordinate a)) a = Actual.expands a ;
