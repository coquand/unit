-- The abstract scalar/module filtrations are actual powers of I=(a,b).
-- Principal ideals are included by setting b=0.
level l ; open Ring[l] ;
module IP = IdealPowers[l] ; module FC = FilteredControl[l] ;
module Over (A : CRing) (a b : A.R) {
 module PA = IP.Over[A,IP.regular A,a,b] ;
 scalars : FC.ScalarFiltration[A] = FC.mkScalarFiltration A PA.Pow PA.pow-drop ;
 module On (M : IP.Mod[A]) {
  module PM = IP.Over[A,M,a,b] ; module MM = IP.Mult[A,M,a,b] ;
  scale (n : Nat) (r : A.R) (x : M.M) (h : PA.Pow n r) : PM.Pow n (M.sm r x) =
   subst (\ k -> PM.Pow k (M.sm r x)) (plus-zero n) (MM.pow-mul n zero r x h tt) ;
  filtration : FC.Filtration[A,M,scalars] =
   FC.mkFiltration A M scalars PM.Pow PM.pow-zero PM.pow-add PM.pow-neg PM.pow-drop scale ;
 } ;
} ;

-- A concrete degree-zero application. If the filtered annihilator of f
-- has the supplied finite graded generation data, then f*x=0 and
-- x in (f)^(c+m+1) imply x=0. No local-ring assumption is needed.
module Principal (A : CRing) (setA : Prelude[l].isSet A.R) (f : A.R) (c : Nat) {
 module R = RL[A] ;
 C : IP.Mod[A] = IP.regular A ;
 module P = Over[A,f,A.z] ; module F = P.On[C] ;
 zero-map : IP.Lin[A,C,C] = IP.mkLin A C C (\ x -> A.z)
  (\ x y -> sym (A.addZ A.z)) (\ r x -> sym (R.mul-zero r)) ;
 module Ct = FC.Control[A,C,C,zero-map,P.scalars,F.filtration,c] ;
 Cycle (x : A.R) : U l = Id A.R (A.mul f x) A.z ;
 annihilate (r x : A.R) (hr : P.PA.Pow (suc zero) r) (hx : Cycle x) : Id A.R (A.mul r x) A.z =
  trans (ap (\ t -> A.mul t x) hr.2.2.2.2)
   (trans (R.dist-left (A.mul f hr.1) (A.mul A.z hr.2.1) x)
    (trans (ap (\ t -> A.add t (A.mul (A.mul A.z hr.2.1) x))
      (trans (ap (\ t -> A.mul t x) (A.mulC f hr.1))
       (trans (sym (A.mulA hr.1 f x)) (trans (ap (A.mul hr.1) hx) (R.mul-zero hr.1)))))
     (trans (ap (A.add A.z) (trans (ap (\ t -> A.mul t x) (R.zero-mul hr.2.1)) (R.zero-mul x))) (A.addZ A.z)))) ;
 module Finite (gs : List Ct.V.G) (closed : Ct.V.All Cycle gs)
  (generation : (m : Nat) (x : A.R) -> Cycle x -> P.PA.Pow (plus c m) x ->
   Truncation[l].Trunc[Ct.Image[Cycle,gs,closed].Rep m x].carrier) {
  module UI = Ct.UniformImage[Cycle,P.PA.Pow,gs,closed,generation] ;
  module K = UI.Kill[setA,annihilate,\ v -> refl A.z] ;
  vanish (m : Nat) (x : A.R) (hx : Cycle x) (hn : P.PA.Pow (plus c (suc m)) x) : Id A.R x A.z =
   K.vanish m x hx hn ;
 } ;
} ;
