-- The ZMT data of the hit-or-split certificate, at the localisation.
-- Hypotheses: E an A-algebra with a presentation p, formally unramified
-- over A, with formal smoothness at the chart endpoint; q an ideal of E,
-- prime relative to a falsum Bot that is
-- a proposition, 1 in q only up to Bot, membership decided merely up to
-- Bot.  M = the elements of A that strip from q (LocalisedAlgebra
-- .Canonical); A_M is then merely local with m = q' o iota'.
-- Remaining hypothesis: for every ZMT output, merely Bot or ChartData
-- after component refinement. A global generator at the original s is
-- retained only as the stronger Unrefined sufficient premise.
-- Conclusion: || Bot + (h in E, q h -> Bot, monic standard chart) ||.
-- Informal proof.
--  1. E_M has over A_M the mapped presentation, so it is finitely
--     presented and formally unramified over A_M (LocalisedPresentation).
--  2. A_M is merely local (Mere.dec), so the special fibre E_M/mE_M is
--     merely finite over A_M/m (FiniteSpecialFibre, which needs only a
--     mere decision and no properness).
--  3. ZMT at (A_M, m, E_M) (TheoremLocalZMT.Data): merely s with s - 1 in
--     m E_M and B = A_M[s, s x_i] finite with B[1/s] = E_M[1/s].
--  4. s is outside q' up to Bot: m E_M is in q', so s in q' gives
--     1 = s - (s - 1) in q', which gives Bot (q'-proper).
--  5. SmoothData descends the refined ChartData using fp, unique and
--     smoothness over A. The Bot alternative is retained; both ZMT and
--     field-case truncations eliminate into the truncated outcome.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module Tr1 = Truncation[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (p : Presentations[l].Over[A,setA].Presentation)
 (ps : Presentations[l].Over[A,setA].Presents p (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (unique : FormallyEtale[l].Over[A,setA].Unique (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c))
 (Bot : U l) (bot-prop : Pr.isProp Bot) (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (Plus (q a) (q c)) Bot)
 (q-proper : q E.o -> Bot) (q-dec : (a : E.R) -> Tr.Trunc[Plus (q a) (q a -> Bot)].carrier) {
 module C = LocalisedAlgebra[l].Canonical[A,setA,E,setE,iota,q,q-zero,q-add,q-scale,Bot,q-prime] ;
 module L = C.O.L ; module EM = C.O.EM ;
 module I = C.O.Ideal[q,q-zero,q-add,q-scale] ;
 module X = C.Mere[bot-prop,q-proper,q-dec].X ;
 m-prop (r : L.Carrier) : Pr.isProp (I.m r) = Tr.Trunc[I.Member (C.O.iota'.1 r)].proposition ;
 -- 1. E_M over A_M
 module P = LocalisedPresentation[l].Over[A,setA,E,setE,iota,C.S.Strips,C.S.one,C.S.product] ;
 module PM = P.Scalar.Presented[p,ps] ;
 -- 2. the special fibre at A_M is merely finite
 module SF = FiniteSpecialFibre[l].Over[L.ring,L.set,RegularIdeal[l].mkIdealPred L.ring I.m I.m-zero I.m-add I.m-scale,m-prop,X.dec,P.algebra] ;
 fo : Tr.Trunc[SF.Fibre.Finite].carrier = SF.theorem PM.finite-presentation (PM.unramified unique) ;
 -- 3. ZMT at (A_M, m, E_M)
 module Z = TheoremLocalZMT[l].Data[L.ring,L.set,I.m,m-prop,I.m-zero,I.m-add,I.m-scale,EM.ring,EM.set,C.O.iota',PM.mapped,PM.presents,fo] ;
 -- 4. m E_M is in q', so s is outside q' up to Bot
 module LE = RL[EM.ring] ;
 q'-gens : (gs : List Z.IGE.Gen) -> I.q' (Z.IGE.Ls.lsum Z.IGE.value gs) = split {
  nil -> I.q'-zero ;
  cons g gs | r -> I.q'-add _ _ (subst I.q' (EM.ring.mulC g.2.2 (C.O.iota'.1 g.1)) (I.q'-scale g.2.2 _ (I.q-m g.1 g.2.1))) r } ;
 -- x - (x - 1) = 1 is in q' when x and x - 1 are
 one-in (x : EM.ring.R) (h : I.q' x) (w : Z.IGE.InmB (EM.ring.add x (EM.ring.neg EM.ring.o))) : I.q' EM.ring.o =
  subst I.q' (FiniteIntroduction[l].Steps[EM.ring].sub-sub x EM.ring.o)
   (I.q'-add _ _ h (subst I.q' (trans (LE.neg-mul-left EM.ring.o (EM.ring.add x (EM.ring.neg EM.ring.o)))
      (ap EM.ring.neg (LE.one-left (EM.ring.add x (EM.ring.neg EM.ring.o)))))
     (I.q'-scale (EM.ring.neg EM.ring.o) _ (subst I.q' (sym w.2) (q'-gens w.1))))) ;
 s-out (x : EM.ring.R) (s-one : Tr.Trunc[Z.IGE.InmB (EM.ring.add x (EM.ring.neg EM.ring.o))].carrier) (h : I.q' x) : Bot =
  TC.rec (Z.IGE.InmB (EM.ring.add x (EM.ring.neg EM.ring.o))) @l Bot bot-prop (\ w -> X.q'-proper (one-in x h w)) s-one ;
 -- 5. the certificate for an output of ZMT
 module At (c : Z.Z.Conclusion) {
  module ZD = Z.At[c] ;
  module Cert = X.Certificate[ZD.B.ring,ZD.B.set,ZD.B.iotaB,ZD.B.incl,\ a -> refl (C.O.iota'.1 a),ZD.n',ZD.bs,ZD.coord,ZD.sB,
   s-out (ZD.B.incl.1 ZD.sB) ZD.s-one,ZD.zmt] ;
  Generator : U l = (x0 : ZD.B.ring.R) * Cert.MF.In.Factor x0 ;
  -- Refinement is allowed before producing ChartData. Its type mentions
  -- neither the original s nor a generator for all of B.
  Refined : U l = Plus Bot Cert.MF.ChartData ;
  from-generator (g : Generator) : Tr.Trunc[Refined].carrier =
   TC.map Cert.MF.ChartData Refined (\ d -> inr d) Cert.MF.Data[g.1,g.2].theorem ;

 } ;
 -- A split is retained explicitly; Bot need not imply an actual chart.
 Outcome : U l+ = Ring[l+].Plus Bot C.St.Certified ;
 module FieldCase (field : (c : Z.Z.Conclusion) -> Tr.Trunc[At[c].Refined].carrier)
  (smooth : FormallyEtale[l].Over[A,setA].Lift C.O.Mo.Ealg) {
  module Node (c : Z.Z.Conclusion) {
   module Data = At[c].Cert.SmoothData[Tr1.Trunc[Presentations[l].Over[A,setA].Witness C.O.Mo.Ealg].inc (p,ps),unique,smooth] ;
   certify : At[c].Refined -> Tr1.Trunc[Outcome].carrier = split {
    inl b -> Tr1.Trunc[Outcome].inc (inl b) ;
    inr d -> TruncationCombinators[l+].map C.St.Certified Outcome (\ x -> inr x) (Data.certify d) } ;
   theorem : Tr1.Trunc[Outcome].carrier =
    TC.rec At[c].Refined @l+ Tr1.Trunc[Outcome].carrier Tr1.Trunc[Outcome].proposition certify (field c) ;
  } ;
  theorem : Tr1.Trunc[Outcome].carrier =
   TC.rec Z.Z.Conclusion @l+ Tr1.Trunc[Outcome].carrier Tr1.Trunc[Outcome].proposition (\ c -> Node[c].theorem) Z.Z.result ;
 } ;
 -- The former, stronger premise remains a sufficient input. It is not
 -- the field case demanded by the corrected endpoint.
 module Unrefined (field : (c : Z.Z.Conclusion) -> Tr.Trunc[At[c].Generator].carrier) {
  refined (c : Z.Z.Conclusion) : Tr.Trunc[At[c].Refined].carrier =
   TC.bind At[c].Generator At[c].Refined At[c].from-generator (field c) ;
  theorem (smooth : FormallyEtale[l].Over[A,setA].Lift C.O.Mo.Ealg) : Tr1.Trunc[Outcome].carrier = FieldCase[refined,smooth].theorem ;
 } ;
} ;
