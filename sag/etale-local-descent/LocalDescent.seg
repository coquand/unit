-- Front 4.2: descent of the local chart DATA from A_M to A.
-- Setting: M a multiplicative monoid of A (membership any type), R = A_M,
-- E an A-algebra and E' an R-algebra with phi : E -> E' over A -> R, such
-- that E' = M^{-1} E in the two senses used: every z in E' merely has
-- t z = phi(e) (t in M), and phi(a) = phi(b) merely gives s a = s b (s in M).
-- Data over R (as produced by the local proof, sag/etale-local-monic):
-- y in E', G = cs in R[T], Full (every z in E' merely r(y) = G(y)^k z) and
-- a monic relation of y over R.  E is finitely presented, formally
-- unramified and formally smooth over A (SmoothChart). The former flat
-- wrapper Chart derives smoothness using FlatUnramifiedEtale.
-- Conclusion: merely h in E with phi(h) = c G(y), c in M, and E[1/h]
-- monic standard over A.
-- Informal proof.
-- (1) Integrality.  t y = phi(y0); the lower coefficients of the monic
--  relation have a common denominator u in M; rescaling by s = t u
--  (MonicRescalingMap) gives a monic Q over A with phi(Q(x1)) = 0,
--  x1 = u y0, phi(x1) = s y.  Hence v Q(x1) = 0 (v in M); T Q is monic and
--  its rescaling by v (MonicRescalingValues) kills y1 = v x1: the value is
--  v^(n+1) x1 Q(x1) = 0.  phi(y1) = c y with c = v s.
-- (2) Descending values.  Call z in E' descended if w z = phi(p(y1)) for
--  some w in M and p in A[T].  Constants of R (fractions), y (c y = phi y1),
--  sums and products are descended, so r(y) is, for every r in R[T].
--  In particular wG G(y) = phi(h0), h0 = pG(y1).
-- (3) Generators.  For a generator x of E: r(y) = G(y)^k phi(x), so
--  phi(wr h0^k x) = phi(wG^k pr(y1)), hence w h0^k x = p(y1) (w in M).  Then
--  (w h0)^(k+1) x = w^k h0 p(y1): x is a fraction at G_w = w pG.  A fraction
--  at G_W stays one at G_(eW), so finitely many generators have a common
--  W; sums and products of fractions are fractions, so Full holds over A at
--  G_W (E is generated by its generators).
-- (4) ShortLocalEtale over A at y1 and a list for G_W: h = G_W(y1),
--  phi(h) = W wG G(y).
-- (5) Relative to Bot: q h gives q'(c G(y)), hence q' G(y) (c is a unit of
--  E'), hence Bot.  No primality.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Tr1 = Truncation[l+] ; module TC1 = TruncationCombinators[l+] ;
module V = MonicRescalingValues[l] ; module MR = MonicRescalingMap[l] ;
-- the two spellings of "append the leading 1"
module MonicLists (B : CRing) (setB : Pr.isSet B.R) {
 same : (p : List B.R) -> Id (List B.R) (HorrocksInterface[l].Over[B,setB].monic-list p) (V.Lists[B].monic p) = split {
  nil -> refl (cons B.o nil) ; cons a p | ih -> ap (\ q -> cons a q) ih } ;
 -- the value of the monic polynomial with lower coefficients p is Values.value p
 module At (C : CRing) (setC : Pr.isSet C.R) (h : H.Hom B C) (x : C.R) {
  module X = StandardEtale[l].Over[B,setB].At[C,setC,h,x] ;
  module Pol = MonicRescalingPolynomial[l].Polynomials[B,setB] ;
  value (p : List B.R) : Id C.R (X.value (HorrocksInterface[l].Over[B,setB].monic p)) (V.Values[B,C,h,x].value p) =
   trans (ap (\ q -> X.value (Pol.X.include q)) (same p)) (Pol.At[C,setC,h,x].value p) ;
 } ;
} ;
-- E[1/h] is monic standard over A: a notion of A and E alone
module Monic (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E) {
 module SA = StandardEtale[l].Over[A,setA] ; module RX = SA.RX ;
 Ealg : Algebras[l].Over[A,setA].Algebra = Algebras[l].Over[A,setA].mkAlgebra E setE iota ;
 MonicChart (h : E.R) : U l+ = (loc : AffineInterface[l].Over[A,setA].LocalizationWitness Ealg h) * (lower : List A.R) *
  (denominator : RX.Carrier) * SA.Points[HorrocksInterface[l].Over[A,setA].monic lower,denominator].Standard loc.1 ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (M : A.R -> U l) (one : M A.o)
 (product : (s t : A.R) -> M s -> M t -> M (A.mul s t)) {
 module L = MonoidLocalization[l].Over[A,M,one,product] ;
 -- (1a) common denominators of finitely many fractions
 module Clear (u : A.R) { module N = V.Over[A,L.ring,L.inclusion,u] ; } ;
 Scalar (a : L.Carrier) (u : A.R) : U l = (b : A.R) * Id L.Carrier (L.constant b) (L.mulQ (L.constant u) a) ;
 from-representative (a : L.Carrier) (w : L.Representatives a) : Scalar a w.1.2.1 =
  (w.1.1,trans (sym (L.fraction-equation w.1)) (ap (L.mulQ (L.constant w.1.2.1)) w.2)) ;
 grow-left (v u : A.R) (a : L.Carrier) (w : Scalar a u) : Scalar a (A.mul v u) =
  (A.mul v w.1,
   calc L.Carrier { L.constant (A.mul v w.1)
    =< L.constant-mul v w.1 > L.mulQ (L.constant v) (L.constant w.1)
    =< ap (L.mulQ (L.constant v)) w.2 > L.mulQ (L.constant v) (L.mulQ (L.constant u) a)
    =< L.ring.mulA (L.constant v) (L.constant u) a > L.mulQ (L.mulQ (L.constant v) (L.constant u)) a
    =< ap (\ c -> L.mulQ c a) (sym (L.constant-mul v u)) > L.mulQ (L.constant (A.mul v u)) a }) ;
 grow-right (u v : A.R) (a : L.Carrier) (w : Scalar a u) : Scalar a (A.mul u v) =
  subst (Scalar a) (A.mulC v u) (grow-left v u a w) ;
 family-left (v u : A.R) : (p : List L.Carrier) -> Clear[u].N.Numerators p -> Clear[A.mul v u].N.Numerators p = split {
  nil -> \ w -> tt ; cons a p | ih -> \ w -> (grow-left v u a w.1,ih w.2) } ;
 Common (p : List L.Carrier) : U l = (u : A.R) * M u * Clear[u].N.Numerators p ;
 combine (a : L.Carrier) (p : List L.Carrier) (w : L.Representatives a) (c : Common p) : Common (cons a p) =
  (A.mul w.1.2.1 c.1,product w.1.2.1 c.1 w.1.2.2 c.2.1,
   (grow-right w.1.2.1 c.1 a (from-representative a w),family-left w.1.2.1 c.1 p c.2.2)) ;
 common : (p : List L.Carrier) -> Tr.Trunc[Common p].carrier = split {
  nil -> Tr.Trunc[Common nil].inc (A.o,one,tt) ;
  cons a p | ih -> TC.map2 (L.Representatives a) (Common p) (Common (cons a p)) (combine a p) (L.representatives a) ih } ;
 module Algebra (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
  (E' : CRing) (setE' : Pr.isSet E'.R) (iota' : H.Hom L.ring E') (phi : H.Hom E E')
  (compat : (a : A.R) -> Id E'.R (phi.1 (iota.1 a)) (iota'.1 (L.constant a)))
  (fractions : (z : E'.R) -> Tr.Trunc[(t : A.R) * M t * (e : E.R) * Id E'.R (E'.mul (iota'.1 (L.constant t)) z) (phi.1 e)].carrier)
  (equalizer : (a b : E.R) -> Id E'.R (phi.1 a) (phi.1 b) ->
   Tr.Trunc[(s : A.R) * M s * Id E.R (E.mul (iota.1 s) a) (E.mul (iota.1 s) b)].carrier) {
  module LE = RL[E] ; module LE' = RL[E'] ;
  -- the image of a in E'
  image (a : A.R) : E'.R = iota'.1 (L.constant a) ;
  image-mul (a b : A.R) : Id E'.R (image (A.mul a b)) (E'.mul (image a) (image b)) =
   trans (ap iota'.1 (L.constant-mul a b)) (iota'.2.2.2 (L.constant a) (L.constant b)) ;
  -- (ab)x = b(ax)
  exchange (C : CRing) (a b x : C.R) : Id C.R (C.mul (C.mul a b) x) (C.mul b (C.mul a x)) =
   trans (ap (\ c -> C.mul c x) (C.mulC a b)) (sym (C.mulA b a x)) ;
  -- (1) the integral variable
  module Variable (y : E'.R) {
   module XR = StandardEtale[l].Over[L.ring,L.set].At[E',setE',iota',y] ;
   module MonR = HorrocksInterface[l].Over[L.ring,L.set] ; module MonA = HorrocksInterface[l].Over[A,setA] ;
   IntegralR : U l = (lower : List L.Carrier) * Id E'.R (XR.value (MonR.monic lower)) E'.z ;
   IntegralA (y1 : E.R) : U l =
    (lower : List A.R) * Id E.R (StandardEtale[l].Over[A,setA].At[E,setE,iota,y1].value (MonA.monic lower)) E.z ;
   -- y1 in E with phi(y1) = c y, c in M, integral over A
   Descended : U l = (y1 : E.R) * (c : A.R) * M c * Id E'.R (phi.1 y1) (E'.mul (image c) y) * IntegralA y1 ;
   module Lift (lower : List L.Carrier) (root : Id E'.R (XR.value (MonR.monic lower)) E'.z)
    (t : A.R) (mt : M t) (y0 : E.R) (ty : Id E'.R (E'.mul (image t) y) (phi.1 y0))
    (u : A.R) (mu : M u) (w : Clear[u].N.Numerators lower) {
    s : A.R = A.mul t u ;
    module Map = MR.Over[A,L.ring,E',L.inclusion,iota',s] ;
    numerators : Map.Source.Numerators lower = family-left t u lower w ;
    lowerA : List A.R = Map.Source.lower lower numerators ;
    x1 : E.R = E.mul (iota.1 u) y0 ;
    point : Id E'.R (E'.mul (image s) y) (phi.1 x1) =
     calc E'.R { E'.mul (image s) y
      =< ap (\ c -> E'.mul c y) (image-mul t u) > E'.mul (E'.mul (image t) (image u)) y
      =< exchange E' (image t) (image u) y > E'.mul (image u) (E'.mul (image t) y)
      =< ap (E'.mul (image u)) ty > E'.mul (image u) (phi.1 y0)
      =< ap (\ c -> E'.mul c (phi.1 y0)) (sym (compat u)) > E'.mul (phi.1 (iota.1 u)) (phi.1 y0)
      =< sym (phi.2.2.2 (iota.1 u) y0) > phi.1 x1 } ;
    module QE = V.Values[A,E,iota,x1] ;
    natural : (p : List A.R) -> Id E'.R (V.Values[A,E',Map.composite,phi.1 x1].value p) (phi.1 (QE.value p)) = split {
     nil -> sym phi.2.1 ;
     cons a p | ih ->
      trans (cong2 E'.R E'.add _ _ _ _ (sym (compat a)) (trans (ap (E'.mul (phi.1 x1)) ih) (sym (phi.2.2.2 x1 (QE.value p)))))
       (sym (phi.2.2.1 (iota.1 a) (E.mul x1 (QE.value p)))) } ;
    -- phi(Q(x1)) = s^n * (monic lower)(y) = 0
    vanishes : Id E'.R (phi.1 (QE.value lowerA)) (phi.1 E.z) =
     calc E'.R { phi.1 (QE.value lowerA)
      =< sym (natural lowerA) > V.Values[A,E',Map.composite,phi.1 x1].value lowerA
      =< ap (\ z -> V.Values[A,E',Map.composite,z].value lowerA) (sym point) > Map.At[y].T.Scaled.value lowerA
      =< Map.At[y].value lower numerators > E'.mul (Map.Target.BP.power (image s) (len lower)) (Map.At[y].Original.value lower)
      =< ap (E'.mul (Map.Target.BP.power (image s) (len lower)))
          (trans (sym (MonicLists[L.ring,L.set].At[E',setE',iota',y].value lower)) root)
        > E'.mul (Map.Target.BP.power (image s) (len lower)) E'.z
      =< LE'.mul-zero (Map.Target.BP.power (image s) (len lower)) > E'.z
      =< sym (H.zero E E' phi) > phi.1 E.z } ;
    module Kill (v : A.R) (mv : M v) (kill : Id E.R (E.mul (iota.1 v) (QE.value lowerA)) (E.mul (iota.1 v) E.z)) {
     module N = V.Over[A,E,iota,v] ;
     -- T Q, monic of degree n+1
     shifted : List E.R = cons E.z (MR.map A.R E.R iota.1 lowerA) ;
     numerators-map : (p : List A.R) -> N.Numerators (MR.map A.R E.R iota.1 p) = split {
      nil -> tt ; cons a p | ih -> ((A.mul v a,iota.2.2.2 v a),ih) } ;
     shifted-numerators : N.Numerators shifted =
      ((A.z,trans (H.zero A E iota) (sym (LE.mul-zero (iota.1 v)))),numerators-map lowerA) ;
     y1 : E.R = E.mul (iota.1 v) x1 ;
     lowerA2 : List A.R = N.lower shifted shifted-numerators ;
     -- v^(n+1) x1 Q(x1) = 0
     root-y1 : Id E.R (V.Values[A,E,iota,y1].value lowerA2) E.z =
      calc E.R { V.Values[A,E,iota,y1].value lowerA2
       =< N.At[x1].value shifted shifted-numerators >
          E.mul (E.mul (iota.1 v) (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA))))
           (E.add E.z (E.mul x1 (N.At[x1].Original.value (MR.map A.R E.R iota.1 lowerA))))
       =< ap (\ q -> E.mul (E.mul (iota.1 v) (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA)))) q)
           (trans (LE.zl (E.mul x1 (N.At[x1].Original.value (MR.map A.R E.R iota.1 lowerA))))
            (ap (E.mul x1) (MR.Values[A,E,iota,x1].value lowerA))) >
          E.mul (E.mul (iota.1 v) (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA)))) (E.mul x1 (QE.value lowerA))
       =< ap (\ q -> E.mul q (E.mul x1 (QE.value lowerA))) (E.mulC (iota.1 v) (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA)))) >
          E.mul (E.mul (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA))) (iota.1 v)) (E.mul x1 (QE.value lowerA))
       =< LE.mul-four (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA))) (iota.1 v) x1 (QE.value lowerA) >
          E.mul (E.mul (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA))) x1) (E.mul (iota.1 v) (QE.value lowerA))
       =< ap (E.mul (E.mul (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA))) x1)) (trans kill (LE.mul-zero (iota.1 v))) >
          E.mul (E.mul (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA))) x1) E.z
       =< LE.mul-zero (E.mul (N.BP.power (iota.1 v) (len (MR.map A.R E.R iota.1 lowerA))) x1) > E.z } ;
     c : A.R = A.mul v s ;
     phi-y1 : Id E'.R (phi.1 y1) (E'.mul (image c) y) =
      calc E'.R { phi.1 y1
       =< phi.2.2.2 (iota.1 v) x1 > E'.mul (phi.1 (iota.1 v)) (phi.1 x1)
       =< cong2 E'.R E'.mul _ _ _ _ (compat v) (sym point) > E'.mul (image v) (E'.mul (image s) y)
       =< E'.mulA (image v) (image s) y > E'.mul (E'.mul (image v) (image s)) y
       =< ap (\ q -> E'.mul q y) (sym (image-mul v s)) > E'.mul (image c) y } ;
     descended : Descended =
      (y1,c,product v s mv (product t u mt mu),phi-y1,
       (lowerA2,trans (MonicLists[A,setA].At[E,setE,iota,y1].value lowerA2) root-y1)) ;
    } ;
    descended : Tr.Trunc[Descended].carrier =
     TC.map ((v : A.R) * M v * Id E.R (E.mul (iota.1 v) (QE.value lowerA)) (E.mul (iota.1 v) E.z)) Descended
      (\ k -> Kill[k.1,k.2.1,k.2.2].descended) (equalizer (QE.value lowerA) E.z vanishes) ;
   } ;
   descend (integral : Tr.Trunc[IntegralR].carrier) : Tr.Trunc[Descended].carrier =
    TC.bind IntegralR Descended (\ r ->
     TC.bind ((t : A.R) * M t * (e : E.R) * Id E'.R (E'.mul (image t) y) (phi.1 e)) Descended (\ f ->
      TC.bind (Common r.1) Descended (\ c -> Lift[r.1,r.2,f.1,f.2.1,f.2.2.1,f.2.2.2,c.1,c.2.1,c.2.2].descended)
       (common r.1))
      (fractions y))
     integral ;
  } ;
  open Monic[A,setA,E,setE,iota] ;
  module PA = AffinePowers[l].Over[A] ; module PE = AffinePowers[l].Over[E] ; module PE' = AffinePowers[l].Over[E'] ;
  E'alg : Algebras[l].Over[L.ring,L.set].Algebra = Algebras[l].Over[L.ring,L.set].mkAlgebra E' setE' iota' ;
  module PFA = PolynomialFractions[l].Over[A,setA] ; module PFR = PolynomialFractions[l].Over[L.ring,L.set] ;
  -- the image of A in E' as a ring map
  imageHom : H.Hom A E' = H.compose A L.ring E' iota' L.inclusion ;
  -- (2) values at y descend, once y does
  module Values (y : E'.R) (y1 : E.R) (c : A.R) (mc : M c) (py : Id E'.R (phi.1 y1) (E'.mul (image c) y)) {
   module XA = SA.At[E,setE,iota,y1] ;
   module XR = StandardEtale[l].Over[L.ring,L.set].At[E',setE',iota',y] ;
   Phi : H.Hom RX.ring E' = H.compose RX.ring E E' phi XA.ev ;
   constant (a : A.R) : Id E'.R (Phi.1 (RX.constant a)) (image a) = trans (ap phi.1 (XA.UP.on-constants a)) (compat a) ;
   Descends (z : E'.R) : U l = (w : A.R) * M w * (p : RX.Carrier) * Id E'.R (E'.mul (image w) z) (Phi.1 p) ;
   weight (z : E'.R) (d : Descends z) : A.R = d.1 ;
   numerator (z : E'.R) (d : Descends z) : RX.Carrier = d.2.2.1 ;
   equation (z : E'.R) (d : Descends z) : Id E'.R (E'.mul (image (weight z d)) z) (Phi.1 (numerator z d)) = d.2.2.2 ;
   variable : Descends y = (c,mc,RX.variable,trans (sym py) (ap phi.1 (sym XA.UP.on-variable))) ;
   origin : Descends E'.z = (A.o,one,RX.ring.z,trans (LE'.mul-zero (image A.o)) (sym (H.zero RX.ring E' Phi))) ;
   fraction (r : L.Carrier) (w : L.Representatives r) : Descends (iota'.1 r) =
    (w.1.2.1,w.1.2.2,RX.constant w.1.1,
     calc E'.R { E'.mul (image w.1.2.1) (iota'.1 r)
      =< sym (iota'.2.2.2 (L.constant w.1.2.1) r) > iota'.1 (L.mulQ (L.constant w.1.2.1) r)
      =< ap iota'.1 (trans (ap (L.mulQ (L.constant w.1.2.1)) (sym w.2)) (L.fraction-equation w.1)) > image w.1.1
      =< sym (constant w.1.1) > Phi.1 (RX.constant w.1.1) }) ;
   sum (z1 z2 : E'.R) (d1 : Descends z1) (d2 : Descends z2) : Descends (E'.add z1 z2) =
    (A.mul (weight z1 d1) (weight z2 d2),product (weight z1 d1) (weight z2 d2) d1.2.1 d2.2.1,
     RX.ring.add (RX.ring.mul (RX.constant (weight z2 d2)) (numerator z1 d1)) (RX.ring.mul (RX.constant (weight z1 d1)) (numerator z2 d2)),
     calc E'.R { E'.mul (image (A.mul (weight z1 d1) (weight z2 d2))) (E'.add z1 z2)
      =< ap (\ q -> E'.mul q (E'.add z1 z2)) (image-mul (weight z1 d1) (weight z2 d2)) >
         E'.mul (E'.mul (image (weight z1 d1)) (image (weight z2 d2))) (E'.add z1 z2)
      =< E'.dist (E'.mul (image (weight z1 d1)) (image (weight z2 d2))) z1 z2 >
         E'.add (E'.mul (E'.mul (image (weight z1 d1)) (image (weight z2 d2))) z1) (E'.mul (E'.mul (image (weight z1 d1)) (image (weight z2 d2))) z2)
      =< cong2 E'.R E'.add _ _ _ _ (exchange E' (image (weight z1 d1)) (image (weight z2 d2)) z1)
          (sym (E'.mulA (image (weight z1 d1)) (image (weight z2 d2)) z2)) >
         E'.add (E'.mul (image (weight z2 d2)) (E'.mul (image (weight z1 d1)) z1)) (E'.mul (image (weight z1 d1)) (E'.mul (image (weight z2 d2)) z2))
      =< cong2 E'.R E'.add _ _ _ _ (cong2 E'.R E'.mul _ _ _ _ (sym (constant (weight z2 d2))) (equation z1 d1))
          (cong2 E'.R E'.mul _ _ _ _ (sym (constant (weight z1 d1))) (equation z2 d2)) >
         E'.add (E'.mul (Phi.1 (RX.constant (weight z2 d2))) (Phi.1 (numerator z1 d1))) (E'.mul (Phi.1 (RX.constant (weight z1 d1))) (Phi.1 (numerator z2 d2)))
      =< sym (cong2 E'.R E'.add _ _ _ _ (Phi.2.2.2 (RX.constant (weight z2 d2)) (numerator z1 d1)) (Phi.2.2.2 (RX.constant (weight z1 d1)) (numerator z2 d2))) >
         E'.add (Phi.1 (RX.ring.mul (RX.constant (weight z2 d2)) (numerator z1 d1))) (Phi.1 (RX.ring.mul (RX.constant (weight z1 d1)) (numerator z2 d2)))
      =< sym (Phi.2.2.1 (RX.ring.mul (RX.constant (weight z2 d2)) (numerator z1 d1)) (RX.ring.mul (RX.constant (weight z1 d1)) (numerator z2 d2))) >
         Phi.1 (RX.ring.add (RX.ring.mul (RX.constant (weight z2 d2)) (numerator z1 d1)) (RX.ring.mul (RX.constant (weight z1 d1)) (numerator z2 d2))) }) ;
   times (z1 z2 : E'.R) (d1 : Descends z1) (d2 : Descends z2) : Descends (E'.mul z1 z2) =
    (A.mul (weight z1 d1) (weight z2 d2),product (weight z1 d1) (weight z2 d2) d1.2.1 d2.2.1,
     RX.ring.mul (numerator z1 d1) (numerator z2 d2),
     calc E'.R { E'.mul (image (A.mul (weight z1 d1) (weight z2 d2))) (E'.mul z1 z2)
      =< ap (\ q -> E'.mul q (E'.mul z1 z2)) (image-mul (weight z1 d1) (weight z2 d2)) >
         E'.mul (E'.mul (image (weight z1 d1)) (image (weight z2 d2))) (E'.mul z1 z2)
      =< LE'.mul-four (image (weight z1 d1)) (image (weight z2 d2)) z1 z2 >
         E'.mul (E'.mul (image (weight z1 d1)) z1) (E'.mul (image (weight z2 d2)) z2)
      =< cong2 E'.R E'.mul _ _ _ _ (equation z1 d1) (equation z2 d2) > E'.mul (Phi.1 (numerator z1 d1)) (Phi.1 (numerator z2 d2))
      =< sym (Phi.2.2.2 (numerator z1 d1) (numerator z2 d2)) > Phi.1 (RX.ring.mul (numerator z1 d1) (numerator z2 d2)) }) ;
   module PolR = MonicRescalingPolynomial[l].Polynomials[L.ring,L.set] ;
   module Cons = PolR.At[E',setE',iota',y] ;
   values : (cs : List L.Carrier) -> Tr.Trunc[Descends (XR.value (PolR.X.include cs))].carrier = split {
    nil -> Tr.Trunc[Descends (XR.value (PolR.X.include nil))].inc (subst Descends (sym (H.zero PolR.X.ring E' XR.ev)) origin) ;
    cons a p | ih ->
     TC.map2 (L.Representatives a) (Descends (XR.value (PolR.X.include p))) (Descends (XR.value (PolR.X.include (cons a p))))
      (\ w d -> subst Descends (sym (Cons.val-cons a p))
        (sum (iota'.1 a) (E'.mul y (XR.value (PolR.X.include p))) (fraction a w) (times y (XR.value (PolR.X.include p)) variable d)))
      (L.representatives a) ih } ;
   value (P : PFR.B.Carrier) : Tr.Trunc[Descends (XR.value P)].carrier =
    TC.bind (PFR.Representation P) (Descends (XR.value P))
     (\ r -> subst (\ q -> Tr.Trunc[Descends (XR.value q)].carrier) r.2 (values r.1)) (PFR.represents P) ;
   -- (3) generators, at G with G(y) descended: wG G(y) = phi(h0)
   module Generators (G : PFR.B.Carrier) (full : PFR.At[E'alg,y,G].Full) (dG : Descends (XR.value G)) {
    g : E'.R = XR.value G ;
    h0 : E.R = XA.value (numerator g dG) ;
    phi-h0 : Id E'.R (phi.1 h0) (E'.mul (image (weight g dG)) g) = sym (equation g dG) ;
    GenForm (x : E.R) : U l = (w : A.R) * M w * (k : Nat) * (p : RX.Carrier) *
     Id E.R (E.mul (iota.1 w) (E.mul (PE.power h0 k) x)) (XA.value p) ;
    gen-weight (x : E.R) (f : GenForm x) : A.R = f.1 ;
    gen-exponent (x : E.R) (f : GenForm x) : Nat = f.2.2.1 ;
    gen-numerator (x : E.R) (f : GenForm x) : RX.Carrier = f.2.2.2.1 ;
    gen-equation (x : E.R) (f : GenForm x) :
     Id E.R (E.mul (iota.1 (gen-weight x f)) (E.mul (PE.power h0 (gen-exponent x f)) x)) (XA.value (gen-numerator x f)) = f.2.2.2.2 ;
    module Gen (x : E.R) (r : PFR.B.Carrier) (k : Nat) (er : Id E'.R (XR.value r) (E'.mul (PE'.power g k) (phi.1 x)))
     (dr : Descends (XR.value r)) {
     wr : A.R = weight (XR.value r) dr ;
     target : RX.Carrier = RX.ring.mul (RX.constant (PA.power (weight g dG) k)) (numerator (XR.value r) dr) ;
     agree : Id E'.R (phi.1 (E.mul (iota.1 wr) (E.mul (PE.power h0 k) x))) (phi.1 (XA.value target)) =
      calc E'.R { phi.1 (E.mul (iota.1 wr) (E.mul (PE.power h0 k) x))
       =< phi.2.2.2 (iota.1 wr) (E.mul (PE.power h0 k) x) > E'.mul (phi.1 (iota.1 wr)) (phi.1 (E.mul (PE.power h0 k) x))
       =< cong2 E'.R E'.mul _ _ _ _ (compat wr)
           (trans (phi.2.2.2 (PE.power h0 k) x) (ap (\ q -> E'.mul q (phi.1 x)) (AffinePowers[l].power-map E E' phi h0 k))) >
          E'.mul (image wr) (E'.mul (PE'.power (phi.1 h0) k) (phi.1 x))
       =< ap (\ q -> E'.mul (image wr) (E'.mul (PE'.power q k) (phi.1 x))) phi-h0 >
          E'.mul (image wr) (E'.mul (PE'.power (E'.mul (image (weight g dG)) g) k) (phi.1 x))
       =< ap (\ q -> E'.mul (image wr) (E'.mul q (phi.1 x))) (PE'.power-mul (image (weight g dG)) g k) >
          E'.mul (image wr) (E'.mul (E'.mul (PE'.power (image (weight g dG)) k) (PE'.power g k)) (phi.1 x))
       =< ap (E'.mul (image wr)) (sym (E'.mulA (PE'.power (image (weight g dG)) k) (PE'.power g k) (phi.1 x))) >
          E'.mul (image wr) (E'.mul (PE'.power (image (weight g dG)) k) (E'.mul (PE'.power g k) (phi.1 x)))
       =< LE'.mul-swap (image wr) (PE'.power (image (weight g dG)) k) (E'.mul (PE'.power g k) (phi.1 x)) >
          E'.mul (PE'.power (image (weight g dG)) k) (E'.mul (image wr) (E'.mul (PE'.power g k) (phi.1 x)))
       =< ap (\ q -> E'.mul (PE'.power (image (weight g dG)) k) (E'.mul (image wr) q)) (sym er) >
          E'.mul (PE'.power (image (weight g dG)) k) (E'.mul (image wr) (XR.value r))
       =< ap (E'.mul (PE'.power (image (weight g dG)) k)) (equation (XR.value r) dr) >
          E'.mul (PE'.power (image (weight g dG)) k) (Phi.1 (numerator (XR.value r) dr))
       =< ap (\ q -> E'.mul q (Phi.1 (numerator (XR.value r) dr)))
           (sym (trans (AffinePowers[l].power-map A E' imageHom (weight g dG) k) (refl (PE'.power (image (weight g dG)) k)))) >
          E'.mul (image (PA.power (weight g dG) k)) (Phi.1 (numerator (XR.value r) dr))
       =< ap (\ q -> E'.mul q (Phi.1 (numerator (XR.value r) dr))) (sym (constant (PA.power (weight g dG) k))) >
          E'.mul (Phi.1 (RX.constant (PA.power (weight g dG) k))) (Phi.1 (numerator (XR.value r) dr))
       =< sym (Phi.2.2.2 (RX.constant (PA.power (weight g dG) k)) (numerator (XR.value r) dr)) > phi.1 (XA.value target) } ;
     form (s : A.R) (ms : M s)
      (es : Id E.R (E.mul (iota.1 s) (E.mul (iota.1 wr) (E.mul (PE.power h0 k) x))) (E.mul (iota.1 s) (XA.value target))) : GenForm x =
      (A.mul s wr,product s wr ms dr.2.1,k,RX.ring.mul (RX.constant s) target,
       calc E.R { E.mul (iota.1 (A.mul s wr)) (E.mul (PE.power h0 k) x)
        =< ap (\ q -> E.mul q (E.mul (PE.power h0 k) x)) (iota.2.2.2 s wr) > E.mul (E.mul (iota.1 s) (iota.1 wr)) (E.mul (PE.power h0 k) x)
        =< sym (E.mulA (iota.1 s) (iota.1 wr) (E.mul (PE.power h0 k) x)) > E.mul (iota.1 s) (E.mul (iota.1 wr) (E.mul (PE.power h0 k) x))
        =< es > E.mul (iota.1 s) (XA.value target)
        =< ap (\ q -> E.mul q (XA.value target)) (sym (XA.UP.on-constants s)) > E.mul (XA.value (RX.constant s)) (XA.value target)
        =< sym (XA.ev.2.2.2 (RX.constant s) target) > XA.value (RX.ring.mul (RX.constant s) target) }) ;
     theorem : Tr.Trunc[GenForm x].carrier =
      TC.map ((s : A.R) * M s * Id E.R (E.mul (iota.1 s) (E.mul (iota.1 wr) (E.mul (PE.power h0 k) x))) (E.mul (iota.1 s) (XA.value target)))
       (GenForm x) (\ e -> form e.1 e.2.1 e.2.2)
       (equalizer (E.mul (iota.1 wr) (E.mul (PE.power h0 k) x)) (XA.value target) agree) ;
    } ;
    gen-form (x : E.R) : Tr.Trunc[GenForm x].carrier =
     TC.bind (PFR.At[E'alg,y,G].Fraction (phi.1 x)) (GenForm x)
      (\ f -> TC.bind (Descends (XR.value f.1)) (GenForm x) (\ d -> Gen[x,f.1,f.2.1,f.2.2,d].theorem) (value f.1))
      (full (phi.1 x)) ;
    -- fractions at G_W = W pG over A
    GW (W : A.R) : RX.Carrier = RX.ring.mul (RX.constant W) (numerator g dG) ;
    FormAt (W : A.R) (x : E.R) : U l = PFA.At[Ealg,y1,GW W].Fraction x ;
    value-GW (W : A.R) : Id E.R (XA.value (GW W)) (E.mul (iota.1 W) h0) =
     trans (XA.ev.2.2.2 (RX.constant W) (numerator g dG)) (ap (\ q -> E.mul q h0) (XA.UP.on-constants W)) ;
    power-GW (W : A.R) (k : Nat) : Id E.R (PE.power (XA.value (GW W)) k) (E.mul (iota.1 (PA.power W k)) (PE.power h0 k)) =
     trans (ap (\ q -> PE.power q k) (value-GW W))
      (trans (PE.power-mul (iota.1 W) h0 k) (ap (\ q -> E.mul q (PE.power h0 k)) (sym (AffinePowers[l].power-map A E iota W k)))) ;
    -- a generator form gives a fraction at G_w, exponent k+1
    to-form (x : E.R) (f : GenForm x) : FormAt (gen-weight x f) x =
     (RX.ring.mul (RX.constant (PA.power (gen-weight x f) (gen-exponent x f))) (RX.ring.mul (numerator g dG) (gen-numerator x f)),suc (gen-exponent x f),
      calc E.R { XA.value (RX.ring.mul (RX.constant (PA.power (gen-weight x f) (gen-exponent x f))) (RX.ring.mul (numerator g dG) (gen-numerator x f)))
       =< trans (XA.ev.2.2.2 (RX.constant (PA.power (gen-weight x f) (gen-exponent x f))) (RX.ring.mul (numerator g dG) (gen-numerator x f)))
           (cong2 E.R E.mul _ _ _ _ (XA.UP.on-constants (PA.power (gen-weight x f) (gen-exponent x f))) (XA.ev.2.2.2 (numerator g dG) (gen-numerator x f))) >
          E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (E.mul h0 (XA.value (gen-numerator x f)))
       =< ap (\ q -> E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (E.mul h0 q)) (sym (gen-equation x f)) >
          E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (E.mul h0 (E.mul (iota.1 (gen-weight x f)) (E.mul (PE.power h0 (gen-exponent x f)) x)))
       =< ap (E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f)))) (LE.mul-swap h0 (iota.1 (gen-weight x f)) (E.mul (PE.power h0 (gen-exponent x f)) x)) >
          E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (E.mul (iota.1 (gen-weight x f)) (E.mul h0 (E.mul (PE.power h0 (gen-exponent x f)) x)))
       =< E.mulA (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (iota.1 (gen-weight x f)) (E.mul h0 (E.mul (PE.power h0 (gen-exponent x f)) x)) >
          E.mul (E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (iota.1 (gen-weight x f))) (E.mul h0 (E.mul (PE.power h0 (gen-exponent x f)) x))
       =< ap (E.mul (E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (iota.1 (gen-weight x f)))) (E.mulA h0 (PE.power h0 (gen-exponent x f)) x) >
          E.mul (E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (iota.1 (gen-weight x f))) (E.mul (E.mul h0 (PE.power h0 (gen-exponent x f))) x)
       =< E.mulA (E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (iota.1 (gen-weight x f))) (E.mul h0 (PE.power h0 (gen-exponent x f))) x >
          E.mul (E.mul (E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (iota.1 (gen-weight x f))) (E.mul h0 (PE.power h0 (gen-exponent x f)))) x
       =< ap (\ q -> E.mul (E.mul q (E.mul h0 (PE.power h0 (gen-exponent x f)))) x) (E.mulC (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (iota.1 (gen-weight x f))) >
          E.mul (E.mul (E.mul (iota.1 (gen-weight x f)) (iota.1 (PA.power (gen-weight x f) (gen-exponent x f)))) (E.mul h0 (PE.power h0 (gen-exponent x f)))) x
       =< ap (\ q -> E.mul q x) (LE.mul-four (iota.1 (gen-weight x f)) (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) h0 (PE.power h0 (gen-exponent x f))) >
          E.mul (E.mul (E.mul (iota.1 (gen-weight x f)) h0) (E.mul (iota.1 (PA.power (gen-weight x f) (gen-exponent x f))) (PE.power h0 (gen-exponent x f)))) x
       =< ap (\ q -> E.mul q x) (cong2 E.R E.mul _ _ _ _ (sym (value-GW (gen-weight x f))) (sym (power-GW (gen-weight x f) (gen-exponent x f)))) >
          E.mul (PE.power (XA.value (GW (gen-weight x f))) (suc (gen-exponent x f))) x }) ;
    -- a fraction at G_W is one at G_(eW)
    scale (e W : A.R) (x : E.R) (f : FormAt W x) : FormAt (A.mul e W) x =
     (RX.ring.mul (RX.constant (PA.power e f.2.1)) f.1,f.2.1,
      calc E.R { XA.value (RX.ring.mul (RX.constant (PA.power e f.2.1)) f.1)
       =< trans (XA.ev.2.2.2 (RX.constant (PA.power e f.2.1)) f.1) (ap (\ q -> E.mul q (XA.value f.1)) (XA.UP.on-constants (PA.power e f.2.1))) >
          E.mul (iota.1 (PA.power e f.2.1)) (XA.value f.1)
       =< ap (E.mul (iota.1 (PA.power e f.2.1))) f.2.2 > E.mul (iota.1 (PA.power e f.2.1)) (E.mul (PE.power (XA.value (GW W)) f.2.1) x)
       =< E.mulA (iota.1 (PA.power e f.2.1)) (PE.power (XA.value (GW W)) f.2.1) x >
          E.mul (E.mul (iota.1 (PA.power e f.2.1)) (PE.power (XA.value (GW W)) f.2.1)) x
       =< ap (\ q -> E.mul (E.mul q (PE.power (XA.value (GW W)) f.2.1)) x) (AffinePowers[l].power-map A E iota e f.2.1) >
          E.mul (E.mul (PE.power (iota.1 e) f.2.1) (PE.power (XA.value (GW W)) f.2.1)) x
       =< ap (\ q -> E.mul q x) (sym (PE.power-mul (iota.1 e) (XA.value (GW W)) f.2.1)) >
          E.mul (PE.power (E.mul (iota.1 e) (XA.value (GW W))) f.2.1) x
       =< ap (\ q -> E.mul (PE.power q f.2.1) x)
           (calc E.R { E.mul (iota.1 e) (XA.value (GW W))
             =< ap (E.mul (iota.1 e)) (value-GW W) > E.mul (iota.1 e) (E.mul (iota.1 W) h0)
             =< E.mulA (iota.1 e) (iota.1 W) h0 > E.mul (E.mul (iota.1 e) (iota.1 W)) h0
             =< ap (\ q -> E.mul q h0) (sym (iota.2.2.2 e W)) > E.mul (iota.1 (A.mul e W)) h0
             =< sym (value-GW (A.mul e W)) > XA.value (GW (A.mul e W)) }) >
          E.mul (PE.power (XA.value (GW (A.mul e W))) f.2.1) x }) ;
    -- finitely many elements have a common W
    Commons (n : Nat) (xs : Fin n -> E.R) : U l = (W : A.R) * M W * ((v : Fin n) -> FormAt W (xs v)) ;
    module Extend (n : Nat) (xs : Fin (suc n) -> E.R) (cn : Commons n (\ v -> xs (inl v))) (f : GenForm (xs (inr tt))) {
     W : A.R = A.mul f.1 cn.1 ;
     last : (t : Top) -> FormAt W (xs (inr t)) = split {
      tt -> subst (\ V -> FormAt V (xs (inr tt))) (A.mulC cn.1 f.1) (scale cn.1 f.1 (xs (inr tt)) (to-form (xs (inr tt)) f)) } ;
     forms : (v : Fin (suc n)) -> FormAt W (xs v) = split {
      inl v -> scale f.1 cn.1 (xs (inl v)) (cn.2.2 v) ; inr t -> last t } ;
     result : Commons (suc n) xs = (W,product f.1 cn.1 f.2.1 cn.2.1,forms) ;
    } ;
    commons : (n : Nat) (xs : Fin n -> E.R) -> Tr.Trunc[Commons n xs].carrier = split {
     zero -> \ xs -> Tr.Trunc[Commons zero xs].inc (A.o,one,\ v -> absurd (FormAt A.o (xs v)) v) ;
     suc n | ih -> \ xs ->
      TC.map2 (Commons n (\ v -> xs (inl v))) (GenForm (xs (inr tt))) (Commons (suc n) xs)
       (\ cn f -> Extend[n,xs,cn,f].result) (ih (\ v -> xs (inl v))) (gen-form (xs (inr tt))) } ;
    -- every element of a presented E is a fraction at G_W
    module Presented (pr : Presentations[l].Over[A,setA].Presentation) (pa : Presentations[l].Over[A,setA].Presents pr Ealg)
     (cm : Commons pr.1 pa.1.1) {
     module AG = AffineGenerated[l].Over[A,setA,Ealg,pr,pa] ;
     module F = PFA.At[Ealg,y1,GW cm.1] ;
     form : (e : Presentations[l].Over[A,setA].Expr AG.V) -> FormAt cm.1 (AG.ev e) = split {
      var v -> cm.2.2 v ;
      cst r -> (RX.constant r,zero,trans (XA.UP.on-constants r) (sym (LE.one-left (iota.1 r)))) ;
      sumE a b | ra rb -> F.Ar.add (AG.ev a) (AG.ev b) ra rb ;
      mulE a b | ra rb -> F.Ar.multiply (AG.ev a) (AG.ev b) ra rb } ;
     everywhere : F.Full = \ x -> TC.map (AG.Rep x) (F.Fraction x) (\ e -> subst F.Fraction e.2 (form e.1)) (AG.generated x) ;
    } ;
   } ;
  } ;
  -- (4) the chart over A
  module SmoothChart (y : E'.R) (cs : List L.Carrier) (full : PFR.At[E'alg,y,PFR.B.include cs].Full)
   (integral : Tr.Trunc[Variable[y].IntegralR].carrier)
   (fp : Presentations[l].Over[A,setA].FP Ealg) (unique : FormallyEtale[l].Over[A,setA].Unique Ealg)
   (smooth : FormallyEtale[l].Over[A,setA].Lift Ealg) {
   module XR = StandardEtale[l].Over[L.ring,L.set].At[E',setE',iota',y] ;
   g : E'.R = XR.value (PFR.B.include cs) ;
   Good : U l+ = (h : E.R) * (c : A.R) * M c * Id E'.R (phi.1 h) (E'.mul (image c) g) * MonicChart h ;
   Into (X : U l) (f : X -> Tr1.Trunc[Good].carrier) (x : Tr.Trunc[X].carrier) : Tr1.Trunc[Good].carrier =
    Tr.Trunc[X].induction @(l+) (\ w -> Tr1.Trunc[Good].carrier) (\ w -> Tr1.Trunc[Good].proposition) f x ;
   module At (d : Variable[y].Descended) {
    module Vs = Values[y,d.1,d.2.1,d.2.2.1,d.2.2.2.1] ;
    module Final (dG : Vs.Descends g) (pr : Presentations[l].Over[A,setA].Presentation)
     (pa : Presentations[l].Over[A,setA].Presents pr Ealg) (cm : Vs.Generators[PFR.B.include cs,full,dG].Commons pr.1 pa.1.1)
     (rep : PFA.Representation (Vs.Generators[PFR.B.include cs,full,dG].GW cm.1)) {
     module Gs = Vs.Generators[PFR.B.include cs,full,dG] ;
     module Short = ShortLocalEtale[l].Over[A,setA,rep.1].At[Ealg,d.1,
      subst (\ G -> PFA.At[Ealg,d.1,G].Full) (sym rep.2) Gs.Presented[pr,pa,cm].everywhere,unique] ;
     -- phi(h) = W wG G(y)
     relation : Id E'.R (phi.1 (Vs.XA.value (RX.include rep.1))) (E'.mul (image (A.mul cm.1 (Vs.weight g dG))) g) =
      calc E'.R { phi.1 (Vs.XA.value (RX.include rep.1))
       =< ap (\ q -> phi.1 (Vs.XA.value q)) rep.2 > Vs.Phi.1 (Gs.GW cm.1)
       =< Vs.Phi.2.2.2 (RX.constant cm.1) (Vs.numerator g dG) > E'.mul (Vs.Phi.1 (RX.constant cm.1)) (Vs.Phi.1 (Vs.numerator g dG))
       =< cong2 E'.R E'.mul _ _ _ _ (Vs.constant cm.1) (sym (Vs.equation g dG)) > E'.mul (image cm.1) (E'.mul (image (Vs.weight g dG)) g)
       =< E'.mulA (image cm.1) (image (Vs.weight g dG)) g > E'.mul (E'.mul (image cm.1) (image (Vs.weight g dG))) g
       =< ap (\ q -> E'.mul q g) (sym (image-mul cm.1 (Vs.weight g dG))) > E'.mul (image (A.mul cm.1 (Vs.weight g dG))) g } ;
     good (r : Short.Result) : Good =
      (Vs.XA.value (RX.include rep.1),A.mul cm.1 (Vs.weight g dG),product cm.1 (Vs.weight g dG) cm.2.1 dG.2.1,relation,r) ;
     theorem : Tr1.Trunc[Good].carrier =
      TC1.map Short.Result Good good (Short.theorem fp (Tr.Trunc[Short.Integral].inc d.2.2.2.2) smooth) ;
    } ;
    theorem : Tr1.Trunc[Good].carrier =
     Into (Vs.Descends g) (\ dG ->
      Tr1.Trunc[Presentations[l].Over[A,setA].Witness Ealg].induction @(l+) (\ w -> Tr1.Trunc[Good].carrier) (\ w -> Tr1.Trunc[Good].proposition)
       (\ w -> Into (Vs.Generators[PFR.B.include cs,full,dG].Commons w.1.1 w.2.1.1) (\ cm ->
         Into (PFA.Representation (Vs.Generators[PFR.B.include cs,full,dG].GW cm.1)) (\ rep -> Final[dG,w.1,w.2,cm,rep].theorem)
          (PFA.represents (Vs.Generators[PFR.B.include cs,full,dG].GW cm.1)))
        (Vs.Generators[PFR.B.include cs,full,dG].commons w.1.1 w.2.1.1))
       fp)
      (Vs.value (PFR.B.include cs)) ;
   } ;
   theorem : Tr1.Trunc[Good].carrier = Into Variable[y].Descended (\ d -> At[d].theorem) (Variable[y].descend integral) ;
   -- relative to a falsum Bot: q h -> Bot from q' G(y) -> Bot, q' only closed under scaling
   module Relative (q : E.R -> U l) (q' : E'.R -> U l) (Bot : U l)
    (q-phi : (x : E.R) -> q x -> q' (phi.1 x)) (q'-scale : (a z : E'.R) -> q' z -> q' (E'.mul a z))
    (g-out : q' g -> Bot) {
    Certified : U l+ = (h : E.R) * (q h -> Bot) * MonicChart h ;
    -- the image of c in M is a unit of E'
    cancel (c : A.R) (mc : M c) (k : q' (E'.mul (image c) g)) : q' g =
     subst q'
      (calc E'.R { E'.mul (iota'.1 (L.inverse c mc).1) (E'.mul (image c) g)
        =< E'.mulA (iota'.1 (L.inverse c mc).1) (image c) g > E'.mul (E'.mul (iota'.1 (L.inverse c mc).1) (image c)) g
        =< ap (\ z -> E'.mul z g) (trans (E'.mulC (iota'.1 (L.inverse c mc).1) (image c))
            (trans (sym (iota'.2.2.2 (L.constant c) (L.inverse c mc).1)) (trans (ap iota'.1 (L.inverse c mc).2) iota'.2.1))) > E'.mul E'.o g
        =< LE'.one-left g > g })
      (q'-scale (iota'.1 (L.inverse c mc).1) (E'.mul (image c) g) k) ;
    certify (gd : Good) : Certified =
     (gd.1,\ k -> g-out (cancel gd.2.1 gd.2.2.1 (subst q' gd.2.2.2.1 (q-phi gd.1 k))),gd.2.2.2.2) ;
    certified : Tr1.Trunc[Certified].carrier = TC1.map Good Certified certify theorem ;
   } ;
  } ;
  -- The former flat endpoint is the smooth theorem with the existing
  -- finite-presentation flat + unramified lifting implication.
  module Chart (y : E'.R) (cs : List L.Carrier) (full : PFR.At[E'alg,y,PFR.B.include cs].Full)
   (integral : Tr.Trunc[Variable[y].IntegralR].carrier)
   (fp : Presentations[l].Over[A,setA].FP Ealg) (unique : FormallyEtale[l].Over[A,setA].Unique Ealg)
   (flat : FlatRelations[l].Over[A,E,iota].Flat) {
   module Smooth = SmoothChart[y,cs,full,integral,fp,unique,FlatUnramifiedEtale[l].Over[A,setA].At[Ealg,fp,unique,flat].lift] ;
   theorem : Tr1.Trunc[Smooth.Good].carrier = Smooth.theorem ;
   module Relative (q : E.R -> U l) (q' : E'.R -> U l) (Bot : U l)
    (q-phi : (x : E.R) -> q x -> q' (phi.1 x)) (q'-scale : (a z : E'.R) -> q' z -> q' (E'.mul a z))
    (g-out : q' Smooth.g -> Bot) {
    module R = Smooth.Relative[q,q',Bot,q-phi,q'-scale,g-out] ;
    certified : Tr1.Trunc[R.Certified].carrier = R.certified ;
   } ;
  } ;
 } ;
} ;
