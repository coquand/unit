-- Finite bases compose along a tower R -> Q -> T. The coordinate
-- map reads the Q-coordinates and then the R-coordinates. Its inverse
-- takes the two finite linear combinations. No choice is involved.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ; module H = RingHom[l] ;
module Coordinates (R : CRing) (setR : Pr.isSet R.R) (S : Algebras[l].Over[R,setR].Algebra)
 (n : Nat) (b : TraceBasis[l].Over[R,setR,S].Basis[n]) {
 module TB = TraceBasis[l].Over[R,setR,S] ; module B = TB.At[n,b] ; module D = MnSums[l].Over[R] ;
 expand (v : Fin n -> R.R) : S.ring.R = TB.SS.sum n (\ i -> S.ring.mul (S.iota.1 (v i)) (b.vector i)) ;
 coordinate-expand (v : Fin n -> R.R) (i : Fin n) : Id R.R (b.coordinate (expand v) i) (v i) =
  trans (B.combination n b.vector v i)
   (trans (TB.RS.sum-cong n _ (\ j -> R.mul (v j) (D.delta n j i))
    (\ j -> ap (R.mul (v j)) (trans (b.on-vector j i) (D.delta-sym n i j)))) (D.sum-delta-right n i v)) ;
 expand-coordinate (a : S.ring.R) : Id S.ring.R (expand (b.coordinate a)) a = b.reconstruction a ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) (Q : Algebras[l].Over[R,setR].Algebra)
 (T : Algebras[l].Over[Q.ring,Q.set].Algebra)
 (n : Nat) (b : TraceBasis[l].Over[R,setR,Q].Basis[n])
 (m : Nat) (c : TraceBasis[l].Over[Q.ring,Q.set,T].Basis[m]) {
 module C = Algebras[l].Over[R,setR] ; module FP = FiniteProduct[l] ;
 S : C.Algebra = C.mkAlgebra T.ring T.set (H.compose R Q.ring T.ring T.iota Q.iota) ;
 d : Nat = FP.size m n ;
 module BC = Coordinates[R,setR,Q,n,b] ; module CC = Coordinates[Q.ring,Q.set,T,m,c] ;
 coordinate (a : T.ring.R) (i : Fin d) : R.R = b.coordinate (c.coordinate a (FP.decode m n i).1) (FP.decode m n i).2 ;
 expand (v : Fin d -> R.R) : T.ring.R = CC.expand (\ j -> BC.expand (\ k -> v (FP.encode m n j k))) ;
 coordinate-add (a z : T.ring.R) (i : Fin d) :
  Id R.R (coordinate (T.ring.add a z) i) (R.add (coordinate a i) (coordinate z i)) =
  trans (ap (\ q -> b.coordinate q (FP.decode m n i).2) (c.add a z (FP.decode m n i).1))
   (b.add (c.coordinate a (FP.decode m n i).1) (c.coordinate z (FP.decode m n i).1) (FP.decode m n i).2) ;
 coordinate-scale (r : R.R) (a : T.ring.R) (i : Fin d) :
  Id R.R (coordinate (T.ring.mul (S.iota.1 r) a) i) (R.mul r (coordinate a i)) =
  trans (ap (\ q -> b.coordinate q (FP.decode m n i).2) (c.scale (Q.iota.1 r) a (FP.decode m n i).1))
   (b.scale r (c.coordinate a (FP.decode m n i).1) (FP.decode m n i).2) ;
 forward (v : Fin d -> R.R) (i : Fin d) : Id R.R (coordinate (expand v) i) (v i) =
  trans (ap (\ q -> b.coordinate q (FP.decode m n i).2)
    (CC.coordinate-expand (\ j -> BC.expand (\ k -> v (FP.encode m n j k))) (FP.decode m n i).1))
   (trans (BC.coordinate-expand (\ k -> v (FP.encode m n (FP.decode m n i).1 k)) (FP.decode m n i).2)
    (ap v (DescentProducts[l].encode-decode m n i))) ;
 backward-row (a : T.ring.R) (j : Fin m) :
  Id Q.ring.R (BC.expand (\ k -> coordinate a (FP.encode m n j k))) (c.coordinate a j) =
  trans (ap BC.expand (F.funext (Fin n) (\ k -> R.R) _ (b.coordinate (c.coordinate a j))
    (\ k -> ap (\ p -> b.coordinate (c.coordinate a p.1) p.2) (FP.decode-encode m n j k))))
   (BC.expand-coordinate (c.coordinate a j)) ;
 backward (a : T.ring.R) : Id T.ring.R (expand (coordinate a)) a =
  trans (ap CC.expand (F.funext (Fin m) (\ j -> Q.ring.R) (\ j -> BC.expand (\ k -> coordinate a (FP.encode m n j k))) (c.coordinate a) (backward-row a))) (CC.expand-coordinate a) ;
 module Linear = LinearCoordinatesBasis[l].Over[R,setR,S,d,coordinate,coordinate-add,coordinate-scale,expand,forward,backward] ;
 basis : TraceBasis[l].Over[R,setR,S].Basis[d] = Linear.basis ;
} ;
