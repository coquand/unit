-- A property of every entry in a rectangular family holds at every
-- index of its flattened list.  The proof follows finite concatenation.
level l ; open Ring[l] ; open Presentations[l] ;
along-cases (n : Nat) (A : U l) (a : Fin n -> A) :
 (m : Nat) (b : Fin m -> A) (P : A -> U l) ->
 ((j : Fin n) -> P (a j)) -> ((j : Fin m) -> P (b j)) ->
 (k : Fin (plus m n)) -> P (FinSum[l].cases n A a m b k) = split {
 zero -> \ b P ha hb -> ha ;
 suc m | ih -> \ b P ha hb ->
  AffineFinite[l].section (plus m n)
   (\ k -> P (FinSum[l].cases n A a (suc m) b k))
   (ih (\ j -> b (inl j)) P ha (\ j -> hb (inl j))) (hb (inr tt)) } ;
flatten-property (A : U l) (P : A -> U l) :
 (n m : Nat) (a : Fin n -> Fin m -> A) ->
 ((j : Fin n) (i : Fin m) -> P (a j i)) ->
 (k : Fin (FiniteRectangle[l].size n m)) -> P (FiniteRectangle[l].flatten A n m a k) = split {
 zero -> \ m a h k -> efq k ;
 suc n | ih -> \ m a h ->
  along-cases (FiniteRectangle[l].size n m) A
   (FiniteRectangle[l].flatten A n m (\ j -> a (inl j))) m (a (inr tt)) P
   (ih m (\ j -> a (inl j)) (\ j -> h (inl j))) (h (inr tt)) } ;
