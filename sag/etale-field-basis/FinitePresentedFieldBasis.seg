-- A finitely presented algebra which is finite as a module over a
-- discrete field merely has an actual finite basis. Choose monic
-- annihilators for its finitely many algebra generators, form the
-- finite-free iterated monic quotient Q, and use the ORIGINAL finite
-- equations to generate ker(Q -> S). Its module relations are the
-- equation generators times the finite Q-basis; Gaussian elimination
-- supplies a basis of S. All annihilator and normal-form choices remain
-- truncated. theorem takes mere normal forms; exact-theorem retains the
-- exact-decision specialization.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module MB = IteratedMonicBasis[l].Over[R,setR] ; module MV = MonicBasisUniversal[l] ;
 module Gauss = GaussianQuotient[l].Operations[R] ;
 module At (S : C.Algebra) {
  module TB = TraceBasis[l].Over[R,setR,S] ;
  module FI = FiniteSpanIntegral[l].Over[R,S.ring,setR,S.set,S.iota] ;
  module IM = FI.IM ;
  Witness : U l = (d : Nat) * TB.Basis[d] ;
  Result : U l = Tr.Trunc[Witness].carrier ;
  values-agree (x : S.ring.R) : (cs : List R.R) ->
   Id S.ring.R (MV.Values[R,S.ring,S.iota,x].value cs) (IM.PC.value x (IM.coefficients cs)) = split {
   nil -> refl S.ring.o ;
   cons r cs | ih -> ap (\ z -> S.ring.add (S.iota.1 r) (S.ring.mul x z)) ih } ;
  module Presented (p : P.Presentation) (ps : P.Presents p S) {
   Choices : U l = (i : Fin p.1) -> IM.IntegralWitness (ps.1.1 i) ;
   module Chosen (choice : Choices) {
    coefficients (i : Fin p.1) : List R.R = (choice i).1 ;
    roots : MB.Roots p.1 coefficients S ps.1.1 = \ i -> trans (values-agree (ps.1.1 i) (coefficients i)) (choice i).2 ;
    cover : MB.Cover[p.1,coefficients] = MB.construct p.1 coefficients ;
    Q : C.Algebra = cover.algebra ;
    u : C.Hom Q S = cover.extend S ps.1.1 roots ;
    on-generators (i : Fin p.1) : Id S.ring.R (u.1.1 (cover.generator i)) (ps.1.1 i) = cover.beta S ps.1.1 roots i ;
    module K = PresentationKernel[l].Over[R,setR].At[Q,S,p,ps,cover.generator,u,on-generators,cover.unique] ;
    module G = Generated[l].Over[R,setR].Generated[p,S,ps] ;
    Rep (s : S.ring.R) : U l = (q : Q.ring.R) * Id S.ring.R (u.1.1 q) s ;
    representative (s : S.ring.R) (w : Generated[l].Over[R,setR].Representation p S ps s) : Rep s =
     (P.eval (Fin p.1) Q cover.generator w.1,
      trans (P.natural (Fin p.1) Q S u cover.generator w.1)
       (trans (Generated[l].Over[R,setR].eval-ext (Fin p.1) S (\ i -> u.1.1 (cover.generator i)) ps.1.1 on-generators w.1) w.2)) ;
    onto (s : S.ring.R) : Tr.Trunc[Rep s].carrier =
     TC.map (Generated[l].Over[R,setR].Representation p S ps s) (Rep s) (representative s) (G.generated s) ;
    module Quot = FiniteFreeQuotientBasis[l].Data[R,setR].At[
     Q,S,cover.rank,cover.basis,u,onto,K.number,K.generators,K.killed,K.kernel] ;
    witness (q : Gauss.NormalForm[cover.rank,Quot.size,Quot.columns]) : Witness = (q.rank,Quot.Given[q].basis) ;
    theorem (forms : (n m : Nat) (v : Fin m -> Gauss.V.Vec n) -> Tr.Trunc[Gauss.NormalForm[n,m,v]].carrier) : Result =
     TC.map Gauss.NormalForm[cover.rank,Quot.size,Quot.columns] Witness witness (forms cover.rank Quot.size Quot.columns) ;
   } ;
   theorem (forms : (n m : Nat) (v : Fin m -> Gauss.V.Vec n) -> Tr.Trunc[Gauss.NormalForm[n,m,v]].carrier)
    (finite : FI.FS.Finite) : Result =
    TC.bind Choices Witness (\ choice -> Chosen[choice].theorem forms)
     (AffineFinite[l].choice p.1 (\ i -> IM.IntegralWitness (ps.1.1 i)) (\ i -> FI.theorem finite (ps.1.1 i))) ;
  } ;
  theorem (forms : (n m : Nat) (v : Fin m -> Gauss.V.Vec n) -> Tr.Trunc[Gauss.NormalForm[n,m,v]].carrier)
   (fp : P.FP S) (finite : FI.FS.Finite) : Result =
   Truncation[l+].Trunc[P.Witness S].induction @l (\ w -> Result) (\ w -> Tr.Trunc[Witness].proposition)
    (\ w -> Presented[w.1,w.2].theorem forms finite) fp ;
  -- The previous exact-decision theorem is recovered without choice.
  exact-theorem (dec : (x : R.R) -> Plus (Id R.R x R.z) (RL[R].unit x)) (fp : P.FP S) (finite : FI.FS.Finite) : Result =
   theorem (\ n m v -> Tr.Trunc[Gauss.NormalForm[n,m,v]].inc (GaussianQuotient[l].Over[R,dec].normal-form n m v)) fp finite ;
 } ;
} ;
