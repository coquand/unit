-- The unique monic remainder already supplies all finite-basis laws.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (lower : List R.R) {
 module M = EtaleFreeLinear[l].Over[R,setR,lower] ;
 basis : TraceBasis[l].Over[R,setR,M.A].Basis[M.d] =
  TraceBasis[l].Over[R,setR,M.A].mkBasis M.d M.basis-vector M.B.coords M.B.coords-add M.B.coords-scale
   (\ a -> trans (M.basis-expansion (M.B.coords a)) (M.B.expansion-coords a)) M.basis-coordinate ;
} ;
