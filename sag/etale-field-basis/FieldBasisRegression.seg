-- End-to-end finite-basis construction over F2, including the base,
-- a nonreduced dual-number algebra, and a degree-zero monic quotient.
-- The monic tower also computes two-generator and zero-rank bounds over
-- Z/4Z, where no field assumption is available or needed for the tower.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
one : Nat = suc zero ; two : Nat = suc one ; four : Nat = suc (suc two) ;
module FromBasis (R : CRing) (setR : Pr.isSet R.R) (S : Algebras[l].Over[R,setR].Algebra)
 (n : Nat) (b : TraceBasis[l].Over[R,setR,S].Basis[n]) {
 module FS = FiniteSpan[l].Over[R,S.ring,S.iota] ;
 finite : FS.Finite = Tr.Trunc[FS.Data].inc
  (n,b.vector,\ a -> Tr.Trunc[FS.Coordinates n b.vector a].inc (b.coordinate a,b.reconstruction a)) ;
} ;
module F2 = BooleanRing[l] ;
field : CRing = F2.two-ring ;
dec : (x : field.R) -> Plus (Id field.R x field.z) ((w : field.R) * Id field.R (field.mul x w) field.o) = split {
 false -> inl (refl false) ; true -> inr (true,refl true) } ;
module FB = FinitePresentedFieldBasis[l].Over[field,F2.bool-set,dec] ;
module Initial = IteratedMonicBasis[l].Over[field,F2.bool-set].Initial[\ i -> efq i] ;
module BaseFinite = FromBasis[field,F2.bool-set,FB.C.base,one,Initial.basis] ;
base : FB.At[FB.C.base].Result = FB.At[FB.C.base].theorem
 BasePresentation[l].Over[field,F2.bool-set].finitely-presented BaseFinite.finite ;
module Dual = MonicBasisUniversal[l].Over[field,F2.bool-set].At[cons false (cons false nil)] ;
module DualFinite = FromBasis[field,F2.bool-set,Dual.Q,Dual.degree,Dual.basis] ;
nonreduced : FB.At[Dual.Q].Result = FB.At[Dual.Q].theorem Dual.B.fp DualFinite.finite ;
module Zero = MonicBasisUniversal[l].Over[field,F2.bool-set].At[nil] ;
module ZeroFinite = FromBasis[field,F2.bool-set,Zero.Q,Zero.degree,Zero.basis] ;
zero-algebra : FB.At[Zero.Q].Result = FB.At[Zero.Q].theorem Zero.B.fp ZeroFinite.finite ;
module Z4 = ZMod4[l] ;
module Tower = IteratedMonicBasis[l].Over[Z4.ring,Z4.set] ;
coefficients : Fin two -> List Z4.ring.R = \ i -> cons q0 (cons q3 nil) ;
cover : Tower.Cover[two,coefficients] = Tower.construct two coefficients ;
rank-four : Id Nat cover.rank four = refl four ;
coordinates-reconstruct (a : cover.algebra.ring.R) :
 Id cover.algebra.ring.R (FiniteIdeal[l].Sums[cover.algebra.ring].sum cover.rank
  (\ i -> cover.algebra.ring.mul (cover.algebra.iota.1 (cover.basis.coordinate a i)) (cover.basis.vector i))) a =
 cover.basis.reconstruction a ;
values : Fin two -> Z4.ring.R = snoc (Fin one) Z4.ring.R (\ i -> q0) q1 ;
roots : Tower.Roots two coefficients Tower.C.base values =
 AffineFinite[l].section one (\ i -> Id Z4.ring.R
  (MonicBasisUniversal[l].Values[Z4.ring,Z4.ring,Tower.C.base.iota,values i].value (coefficients i)) q0)
  (\ i -> refl q0) (refl q0) ;
evaluation : Tower.C.Hom cover.algebra Tower.C.base = cover.extend Tower.C.base values roots ;
evaluation-generators (i : Fin two) : Id Z4.ring.R (evaluation.1.1 (cover.generator i)) (values i) =
 cover.beta Tower.C.base values roots i ;
empty-degree : Tower.Cover[one,\ i -> nil] = Tower.construct one (\ i -> nil) ;
rank-zero : Id Nat empty-degree.rank zero = refl zero ;
