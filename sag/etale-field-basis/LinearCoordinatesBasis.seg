-- A linear coordinate isomorphism gives the ordinary finite-basis record.
-- The vectors are the inverse images of coordinate unit vectors.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (S : Algebras[l].Over[R,setR].Algebra) (n : Nat)
 (coordinate : S.ring.R -> Fin n -> R.R)
 (add : (a b : S.ring.R) (i : Fin n) -> Id R.R (coordinate (S.ring.add a b) i) (R.add (coordinate a i) (coordinate b i)))
 (scale : (r : R.R) (a : S.ring.R) (i : Fin n) -> Id R.R (coordinate (S.ring.mul (S.iota.1 r) a) i) (R.mul r (coordinate a i)))
 (expansion : (Fin n -> R.R) -> S.ring.R)
 (forward : (v : Fin n -> R.R) (i : Fin n) -> Id R.R (coordinate (expansion v) i) (v i))
 (backward : (a : S.ring.R) -> Id S.ring.R (expansion (coordinate a)) a) {
 module RS = FiniteIdeal[l].Sums[R] ; module SS = FiniteIdeal[l].Sums[S.ring] ; module D = MnSums[l].Over[R] ;
 vector (j : Fin n) : S.ring.R = expansion (\ i -> D.delta n i j) ;
 on-vector (j i : Fin n) : Id R.R (coordinate (vector j) i) (D.delta n i j) = forward (\ k -> D.delta n k j) i ;
 zero (i : Fin n) : Id R.R (coordinate S.ring.z i) R.z =
  RL[R].add-cancel (coordinate S.ring.z i) (coordinate S.ring.z i)
   (trans (sym (add S.ring.z S.ring.z i)) (ap (\ a -> coordinate a i) (S.ring.addZ S.ring.z))) ;
 sum : (m : Nat) (a : Fin m -> S.ring.R) (i : Fin n) ->
  Id R.R (coordinate (SS.sum m a) i) (RS.sum m (\ j -> coordinate (a j) i)) = split {
  zero -> \ a i -> zero i ;
  suc m | ih -> \ a i -> trans (add (a (inr tt)) (SS.sum m (\ j -> a (inl j))) i)
   (ap (R.add (coordinate (a (inr tt)) i)) (ih (\ j -> a (inl j)) i)) } ;
 injective (a b : S.ring.R) (h : (i : Fin n) -> Id R.R (coordinate a i) (coordinate b i)) : Id S.ring.R a b =
  trans (sym (backward a)) (trans (ap expansion (F.funext (Fin n) (\ i -> R.R) _ _ h)) (backward b)) ;
 reconstruction (a : S.ring.R) : Id S.ring.R (SS.sum n (\ j -> S.ring.mul (S.iota.1 (coordinate a j)) (vector j))) a =
  injective _ a (\ i -> trans (sum n (\ j -> S.ring.mul (S.iota.1 (coordinate a j)) (vector j)) i)
   (trans (RS.sum-cong n _ (\ j -> R.mul (coordinate a j) (D.delta n j i))
    (\ j -> trans (scale (coordinate a j) (vector j) i)
     (ap (R.mul (coordinate a j)) (trans (on-vector j i) (D.delta-sym n i j)))))
    (D.sum-delta-right n i (coordinate a)))) ;
 basis : TraceBasis[l].Over[R,setR,S].Basis[n] =
  TraceBasis[l].Over[R,setR,S].mkBasis n vector coordinate add scale reconstruction on-vector ;
} ;
