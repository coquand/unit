-- Structure identity for NCAlgebra, from SipGeneric (compare AlgSIP).  An
-- algebra structure on X is +, scaling, product and one (data), with
-- axioms: X a set, + an abelian group (AbAxioms.Ab: zero and negation
-- unique), the scaling laws and the product laws.  The isomorphisms are
-- AlgSIP's (same, same').  The names (Alg, Hom, hom-prop, idHom, AlgIso,
-- idIso, Total, pth, pth-id, sip, idToIso, sip-id, PH, prod) are AlgSIP's,
-- with the same types, and iso-ind is AlgSIPInd's (motives at level l+).
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module G = SipGeneric[l] ;
module GH = SipGeneric[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : Ring[l].CRing) (setR : isSet R.R) {
 module NA = NCAlgebra[l].Over[R,setR] ;
 Alg : U l+ = NA.Algebra ;
 -- propositions over a set (AlgSIP's)
 module PH (M : U l) (s : isSet M) (X : U l) {
  p1 (f g : X -> M) : isProp ((x : X) -> Id M (f x) (g x)) =
   FL.isProp-Pi X (\ x -> Id M (f x) (g x)) (\ x -> s (f x) (g x)) ;
  p2 (f g : X -> X -> M) : isProp ((x y : X) -> Id M (f x y) (g x y)) =
   FL.isProp-Pi X (\ x -> (y : X) -> Id M (f x y) (g x y)) (\ x -> p1 (f x) (g x)) ;
  p3 (f g : X -> X -> X -> M) : isProp ((x y w : X) -> Id M (f x y w) (g x y w)) =
   FL.isProp-Pi X (\ x -> (y w : X) -> Id M (f x y w) (g x y w)) (\ x -> p2 (f x) (g x)) ;
  r1 (f g : R.R -> X -> M) : isProp ((a : R.R) (x : X) -> Id M (f a x) (g a x)) =
   FL.isProp-Pi R.R (\ a -> (x : X) -> Id M (f a x) (g a x)) (\ a -> p1 (f a) (g a)) ;
  r2 (f g : R.R -> X -> X -> M) : isProp ((a : R.R) (x y : X) -> Id M (f a x y) (g a x y)) =
   FL.isProp-Pi R.R (\ a -> (x y : X) -> Id M (f a x y) (g a x y)) (\ a -> p2 (f a) (g a)) ;
  rr1 (f g : R.R -> R.R -> X -> M) : isProp ((a b : R.R) (x : X) -> Id M (f a b x) (g a b x)) =
   FL.isProp-Pi R.R (\ a -> (b : R.R) (x : X) -> Id M (f a b x) (g a b x)) (\ a -> r1 (f a) (g a)) ;
 } ;
 prod (X Y : U l) (pX : isProp X) (pY : isProp Y) : isProp (X * Y) = isProp-Sigma X (\ u -> Y) pX (\ u -> pY) ;
 -- the laws of scaling and product
 module Laws (X : U l) (ad : X -> X -> X) (sc : R.R -> X -> X) (mu : X -> X -> X) (on : X) {
  Scale : U l =
   ((x : X) -> Id X (sc R.o x) x) *
   ((a b : R.R) (x : X) -> Id X (sc a (sc b x)) (sc (R.mul a b) x)) *
   ((a : R.R) (x y : X) -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y))) *
   ((a b : R.R) (x : X) -> Id X (sc (R.add a b) x) (ad (sc a x) (sc b x))) ;
  Prod : U l =
   ((x y w : X) -> Id X (mu x (mu y w)) (mu (mu x y) w)) *
   ((x : X) -> Id X (mu on x) x) *
   ((x : X) -> Id X (mu x on) x) *
   ((x y w : X) -> Id X (mu x (ad y w)) (ad (mu x y) (mu x w))) *
   ((x y w : X) -> Id X (mu (ad x y) w) (ad (mu x w) (mu y w))) *
   ((a : R.R) (x y : X) -> Id X (mu (sc a x) y) (sc a (mu x y))) *
   ((a : R.R) (x y : X) -> Id X (mu x (sc a y)) (sc a (mu x y))) ;
  module P (s : isSet X) {
   scale-prop : isProp Scale =
    prod _ _ (PH[X,s,X].p1 (\ x -> sc R.o x) (\ x -> x))
    (prod _ _ (PH[X,s,X].rr1 (\ a b x -> sc a (sc b x)) (\ a b x -> sc (R.mul a b) x))
    (prod _ _ (PH[X,s,X].r2 (\ a x y -> sc a (ad x y)) (\ a x y -> ad (sc a x) (sc a y)))
     (PH[X,s,X].rr1 (\ a b x -> sc (R.add a b) x) (\ a b x -> ad (sc a x) (sc b x))))) ;
   mul-prop : isProp Prod =
    prod _ _ (PH[X,s,X].p3 (\ x y w -> mu x (mu y w)) (\ x y w -> mu (mu x y) w))
    (prod _ _ (PH[X,s,X].p1 (\ x -> mu on x) (\ x -> x))
    (prod _ _ (PH[X,s,X].p1 (\ x -> mu x on) (\ x -> x))
    (prod _ _ (PH[X,s,X].p3 (\ x y w -> mu x (ad y w)) (\ x y w -> ad (mu x y) (mu x w)))
    (prod _ _ (PH[X,s,X].p3 (\ x y w -> mu (ad x y) w) (\ x y w -> ad (mu x w) (mu y w)))
    (prod _ _ (PH[X,s,X].r2 (\ a x y -> mu (sc a x) y) (\ a x y -> sc a (mu x y)))
     (PH[X,s,X].r2 (\ a x y -> mu x (sc a y)) (\ a x y -> sc a (mu x y)))))))) ;
  } ;
 } ;
 -- the notion of algebra structure
 Data : G.Notion = G.join G.binop (G.join (G.action R.R) (G.join G.binop G.point)) ;
 Ax (X : U l) (d : Data.S X) : U l = (s : isSet X) * AbAxioms[l].Ab[X,d.1].Ax *
  Laws[X,d.1,d.2.1,d.2.2.1,d.2.2.2].Scale * Laws[X,d.1,d.2.1,d.2.2.1,d.2.2.2].Prod ;
 ax-prop (X : U l) (d : Data.S X) : isProp (Ax X d) =
  isProp-Sigma (isSet X) (\ s -> AbAxioms[l].Ab[X,d.1].Ax * Laws[X,d.1,d.2.1,d.2.2.1,d.2.2.2].Scale * Laws[X,d.1,d.2.1,d.2.2.1,d.2.2.2].Prod)
   (Torsor[l].isProp-isSet X) (\ s ->
   prod _ _ AbAxioms[l].Ab[X,d.1].P[s].ax-prop (prod _ _ Laws[X,d.1,d.2.1,d.2.2.1,d.2.2.2].P[s].scale-prop
    Laws[X,d.1,d.2.1,d.2.2.1,d.2.2.2].P[s].mul-prop)) ;
 N : G.Notion = G.axioms Data Ax ax-prop ;
 module S = G.Over[N] ;

 -- the record of algebras is S.Str
 fields (A : Alg) : S.Str = (A.A, (A.add, A.scale, A.mul, A.one), A.set,
  (A.addA, A.addC, A.zero, A.addZ, A.neg, A.addN),
  (A.scale-one, A.scale-scale, A.scale-add, A.add-scale),
  (A.mulA, A.one-left, A.one-right, A.dist-left, A.dist-right, A.scale-mul-left, A.scale-mul-right)) ;
 module Pj (B : S.Str) {
  d : Data.S B.1 = B.2.1 ; ab : AbAxioms[l].Ab[B.1,d.1].Ax = B.2.2.2.1 ;
  sl : Laws[B.1,d.1,d.2.1,d.2.2.1,d.2.2.2].Scale = B.2.2.2.2.1 ;
  ml : Laws[B.1,d.1,d.2.1,d.2.2.1,d.2.2.2].Prod = B.2.2.2.2.2 ;
  alg : Alg = new NA.Algebra[B.1,B.2.2.1,ab.2.2.1,d.1,ab.2.2.2.2.1,d.2.1,d.2.2.2,d.2.2.1,
   ab.1,ab.2.1,ab.2.2.2.1,ab.2.2.2.2.2,sl.1,sl.2.1,sl.2.2.1,sl.2.2.2,
   ml.1,ml.2.1,ml.2.2.1,ml.2.2.2.1,ml.2.2.2.2.1,ml.2.2.2.2.2.1,ml.2.2.2.2.2.2] ;
 } ;
 mk (B : S.Str) : Alg = Pj[B].alg ;
 -- algebra isomorphisms
 AlgIso (A B : Alg) : U l = S.Iso (fields A) (fields B) ;
 idIso (A : Alg) : AlgIso A A = S.idIso (fields A) ;
 Total (A : Alg) : U l+ = (B : Alg) * AlgIso A B ;
 back (A : Alg) : (B : Alg) (phi : AlgIso A B) -> Id (Total A) (mk (fields B), phi) (B, phi) = split {
  Algebra bA bset bz bad bng bsc bon bmu b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 -> \ phi ->
   refl (new NA.Algebra[bA,bset,bz,bad,bng,bsc,bon,bmu,b1,b2,b3,b4,b5,b6,b7,b8,b9,b10,b11,b12,b13,b14,b15], phi) } ;
 total-contr (A : Alg) : FunExtUA[l+].isContr (Total A) =
  GH.ctr-retract (S.Total (fields A)) (Total A) (S.total-contr (fields A))
   (\ c -> (fields c.1, c.2)) (\ c -> (mk c.1, c.2)) (\ c -> back A c.1 c.2) ;
 opaque total-contr ;
 -- the structure identity principle: Id Alg A B ~ AlgIso A B, under AlgSIP's names
 module Fd = G.Fundamental[Alg,AlgIso,idIso,total-contr] ;
 pth (A : Alg) (c : Total A) : Id (Total A) (A, idIso A) c = Fd.pth A c ;
 pth-id (A : Alg) : Id (Id (Total A) (A, idIso A) (A, idIso A)) (pth A (A, idIso A)) (refl (A, idIso A)) = Fd.pth-id A ;
 sip (A B : Alg) (phi : AlgIso A B) : Id Alg A B = Fd.sip A B phi ;
 idToIso (A B : Alg) (p : Id Alg A B) : AlgIso A B = Fd.idToIso A B p ;
 sip-id (A : Alg) : Id (Id Alg A A) (sip A A (idIso A)) (refl A) = Fd.sip-id A ;
 idToIso-sip (A B : Alg) (phi : AlgIso A B) : Id (AlgIso A B) (idToIso A B (sip A B phi)) phi = Fd.idToIso-sip A B phi ;
 sip-idToIso (A B : Alg) (p : Id Alg A B) : Id (Id Alg A B) (sip A B (idToIso A B p)) p = Fd.sip-idToIso A B p ;
 iso-ind (A : Alg) (P : (B : Alg) -> AlgIso A B -> U l+) (d : P A (idIso A)) (B : Alg) (phi : AlgIso A B) : P B phi =
  Fd.iso-ind A P d B phi ;
 -- AlgSIP's names for homomorphisms
 Hom (A B : Alg) (f : A.A -> B.A) : U l =
  ((x y : A.A) -> Id B.A (f (A.add x y)) (B.add (f x) (f y))) *
  ((a : R.R) (x : A.A) -> Id B.A (f (A.scale a x)) (B.scale a (f x))) *
  ((x y : A.A) -> Id B.A (f (A.mul x y)) (B.mul (f x) (f y))) *
  Id B.A (f A.one) B.one ;
 hom-prop (A B : Alg) (f : A.A -> B.A) : isProp (Hom A B f) =
  prod _ _ (PH[B.A,B.set,A.A].p2 (\ x y -> f (A.add x y)) (\ x y -> B.add (f x) (f y)))
   (prod _ _ (PH[B.A,B.set,A.A].r1 (\ a x -> f (A.scale a x)) (\ a x -> B.scale a (f x)))
    (prod _ _ (PH[B.A,B.set,A.A].p2 (\ x y -> f (A.mul x y)) (\ x y -> B.mul (f x) (f y)))
     (B.set (f A.one) B.one))) ;
 idHom (A : Alg) : Hom A A (\ x -> x) = (idIso A).2 ;
 -- these isomorphisms are AlgSIP's, by definition
 same (A B : Alg) (phi : AlgSIP[l].Over[R,setR].AlgIso A B) : AlgIso A B = phi ;
 same' (A B : Alg) (phi : AlgIso A B) : AlgSIP[l].Over[R,setR].AlgIso A B = phi ;
 -- idToIso is AlgSIP's by definition, so sip is AlgSIP's sip: both invert it
 module Old = AlgSIP[l].Over[R,setR] ;
 idToIso-same (A B : Alg) (p : Id Alg A B) : Id (AlgIso A B) (idToIso A B p) (Old.idToIso A B p) = refl (idToIso A B p) ;
 sip-same (A B : Alg) (phi : AlgIso A B) : Id (Id Alg A B) (sip A B phi) (Old.sip A B phi) = calc (Id Alg A B) {
  sip A B phi
   =< Prelude[l+].ap (AlgIso A B) (Id Alg A B) (sip A B) phi (idToIso A B (Old.sip A B phi))
       (sym (AlgIso A B) (idToIso A B (Old.sip A B phi)) phi (Old.idToIso-sip A B phi)) >
  sip A B (idToIso A B (Old.sip A B phi))
   =< sip-idToIso A B (Old.sip A B phi) >
  Old.sip A B phi } ;
} ;
