-- sip: the structure identity principle once (SipGeneric), and modules and
-- algebras as instances (ModuleSIP2, AlgSIP2), with the interfaces of
-- pn/ModuleSIP, cffru/ModuleSIPFull and pn/AlgSIP.  The old files are linked
-- for the comparisons (same, same').
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 -- linked (read-only)
 import Truncation ; import TruncationCombinators ; import FinChoice ; import Torsor ;
 import NCAlgebra ; import AlgSIP ; import Alg73 ; import ModuleSIP ;
 -- sip
 import SipGeneric ; import AbAxioms ; import ModuleSIP2 ; import AlgSIP2 ;
} ;
