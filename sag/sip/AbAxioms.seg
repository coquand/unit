-- Abelian groups as a property of a binary operation (Escardó's "axioms"):
-- zero and negation are unique given associativity and commutativity
-- (zero-uniq, neg-uniq), so Ab.Ax is a proposition on a set (ax-prop).
-- Used by ModuleSIP2 and AlgSIP2, where zero and negation are axioms.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

-- a type family over A in which elements over a, a' force a = a', and
-- whose fibres are propositions, has a propositional total space
prop-sigma (A : U l) (B : A -> U l) (u : (a a' : A) -> B a -> B a' -> Id A a a')
 (pB : (a : A) -> isProp (B a)) : isProp ((a : A) * B a) =
 \ w w' -> Sigma-eq A B w.1 w'.1 w.2 w'.2 (u w.1 w'.1 w.2 w'.2) (pB w'.1) ;

-- abelian groups: a property of a binary operation
module Ab (X : U l) (ad : X -> X -> X) {
 Assoc : U l = (x y w : X) -> Id X (ad x (ad y w)) (ad (ad x y) w) ;
 Comm : U l = (x y : X) -> Id X (ad x y) (ad y x) ;
 Unit (z : X) : U l = (x : X) -> Id X (ad x z) x ;
 Neg (z : X) : U l = (n : X -> X) * ((x : X) -> Id X (ad x (n x)) z) ;
 Zero : U l = (z : X) * Unit z * Neg z ;
 Ax : U l = Assoc * Comm * Zero ;
 module P (sX : isSet X) {
  pi (B : X -> U l) (pB : (x : X) -> isProp (B x)) : isProp ((x : X) -> B x) = FL.isProp-Pi X B pB ;
  assoc-prop : isProp Assoc = pi (\ x -> (y w : X) -> Id X (ad x (ad y w)) (ad (ad x y) w)) (\ x ->
   pi (\ y -> (w : X) -> Id X (ad x (ad y w)) (ad (ad x y) w)) (\ y ->
    pi (\ w -> Id X (ad x (ad y w)) (ad (ad x y) w)) (\ w -> sX (ad x (ad y w)) (ad (ad x y) w)))) ;
  comm-prop : isProp Comm = pi (\ x -> (y : X) -> Id X (ad x y) (ad y x)) (\ x ->
   pi (\ y -> Id X (ad x y) (ad y x)) (\ y -> sX (ad x y) (ad y x))) ;
  unit-prop (z : X) : isProp (Unit z) = pi (\ x -> Id X (ad x z) x) (\ x -> sX (ad x z) x) ;
  module Uniq (a : Assoc) (c : Comm) {
   -- two zeros are equal
   zero-uniq (z z' : X) (hz : Unit z) (hz' : Unit z') : Id X z z' = calc X {
    z =< symH (hz' z) > ad z z' =< c z z' > ad z' z =< hz z' > z' } ;
   -- two negations are equal
   neg-uniq (z : X) (hz : Unit z) (n n' : X -> X) (hn : (x : X) -> Id X (ad x (n x)) z)
    (hn' : (x : X) -> Id X (ad x (n' x)) z) (x : X) : Id X (n x) (n' x) = calc X {
    n x =< symH (hz (n x)) > ad (n x) z
     =< apH (ad (n x)) (symH (hn' x)) > ad (n x) (ad x (n' x))
     =< a (n x) x (n' x) > ad (ad (n x) x) (n' x)
     =< apH (\ t -> ad t (n' x)) (c (n x) x) > ad (ad x (n x)) (n' x)
     =< apH (\ t -> ad t (n' x)) (hn x) > ad z (n' x)
     =< c z (n' x) > ad (n' x) z
     =< hz (n' x) > n' x } ;
   neg-prop (z : X) (hz : Unit z) : isProp (Neg z) =
    prop-sigma (X -> X) (\ n -> (x : X) -> Id X (ad x (n x)) z)
     (\ n n' hn hn' -> FL.funext X (\ x -> X) n n' (neg-uniq z hz n n' hn hn'))
     (\ n -> pi (\ x -> Id X (ad x (n x)) z) (\ x -> sX (ad x (n x)) z)) ;
   zero-prop : isProp Zero =
    prop-sigma X (\ z -> Unit z * Neg z) (\ z z' u u' -> zero-uniq z z' u.1 u'.1)
     (\ z -> isProp-Sigma (Unit z) (\ hz -> Neg z) (unit-prop z) (\ hz -> neg-prop z hz)) ;
  } ;
  ax-prop : isProp Ax =
   isProp-Sigma Assoc (\ a -> Comm * Zero) assoc-prop (\ a ->
    isProp-Sigma Comm (\ c -> Zero) comm-prop (\ c -> Uniq[a,c].zero-prop)) ;
 } ;
} ;

