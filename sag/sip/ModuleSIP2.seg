-- Structure identity for modules, from SipGeneric.  A module structure on
-- X is a binary operation and an action of R (data), with axioms: X a set,
-- the operation an abelian group, the action a module action.  Zero and
-- negation are part of the axioms, not of the data: given associativity
-- and commutativity they are unique (AbAxioms.Ab.P.ax-prop), so the axioms
-- are a proposition.  This is the only algebraic fact used; SipGeneric does the
-- rest.  The record A7.Mod is this Sigma type field by field (fields, mk,
-- back), and its linear equivalences are SipGeneric's isomorphisms.  The
-- names (LinEquiv, Additive, Scalar, Lin, lin-prop, idLin, Total, pth,
-- sip, idToIso, sip-id, sip-equiv, local-small) are those of ModuleSIP and
-- ModuleSIPFull, with the same types, so a user switches by its module name.
level l ; open Base ; open Prelude[l] ; open Paths[l] ;
module A7 = Alg73[l] ;
module G = SipGeneric[l] ;
module GH = SipGeneric[l+] ;
module FL = Axioms[l].FunExtLemmas[fe @l] ;

module Over (Rg : A7.CRing) {
 R : U l = Rg.R ;
 Mod : U l+ = A7.Mod[Rg] ;
 -- the laws of the action
 module Act (X : U l) (ad : X -> X -> X) (sc : R -> X -> X) {
  SA : U l = (a b : R) (x : X) -> Id X (sc a (sc b x)) (sc (Rg.mul a b) x) ;
  SO : U l = (x : X) -> Id X (sc Rg.o x) x ;
  SD : U l = (a : R) (x y : X) -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y)) ;
  SE : U l = (a b : R) (x : X) -> Id X (sc (Rg.add a b) x) (ad (sc a x) (sc b x)) ;
  Ax : U l = SA * SO * SD * SE ;
  module P (sX : isSet X) {
   pX (B : X -> U l) (pB : (x : X) -> isProp (B x)) : isProp ((x : X) -> B x) = FL.isProp-Pi X B pB ;
   pR (B : R -> U l) (pB : (a : R) -> isProp (B a)) : isProp ((a : R) -> B a) = FL.isProp-Pi R B pB ;
   sa : isProp SA = pR (\ a -> (b : R) (x : X) -> Id X (sc a (sc b x)) (sc (Rg.mul a b) x)) (\ a ->
    pR (\ b -> (x : X) -> Id X (sc a (sc b x)) (sc (Rg.mul a b) x)) (\ b ->
     pX (\ x -> Id X (sc a (sc b x)) (sc (Rg.mul a b) x)) (\ x -> sX (sc a (sc b x)) (sc (Rg.mul a b) x)))) ;
   so : isProp SO = pX (\ x -> Id X (sc Rg.o x) x) (\ x -> sX (sc Rg.o x) x) ;
   sd : isProp SD = pR (\ a -> (x y : X) -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ a ->
    pX (\ x -> (y : X) -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ x ->
     pX (\ y -> Id X (sc a (ad x y)) (ad (sc a x) (sc a y))) (\ y -> sX (sc a (ad x y)) (ad (sc a x) (sc a y))))) ;
   se : isProp SE = pR (\ a -> (b : R) (x : X) -> Id X (sc (Rg.add a b) x) (ad (sc a x) (sc b x))) (\ a ->
    pR (\ b -> (x : X) -> Id X (sc (Rg.add a b) x) (ad (sc a x) (sc b x))) (\ b ->
     pX (\ x -> Id X (sc (Rg.add a b) x) (ad (sc a x) (sc b x))) (\ x -> sX (sc (Rg.add a b) x) (ad (sc a x) (sc b x))))) ;
   ax-prop : isProp Ax =
    isProp-Sigma SA (\ h -> SO * SD * SE) sa (\ h -> isProp-Sigma SO (\ h1 -> SD * SE) so (\ h1 ->
     isProp-Sigma SD (\ h2 -> SE) sd (\ h2 -> se))) ;
  } ;
 } ;
 -- the notion of module structure
 Data : G.Notion = G.join G.binop (G.action R) ;
 Ax (X : U l) (d : Data.S X) : U l = (sX : isSet X) * AbAxioms[l].Ab[X,d.1].Ax * Act[X,d.1,d.2].Ax ;
 ax-prop (X : U l) (d : Data.S X) : isProp (Ax X d) =
  isProp-Sigma (isSet X) (\ sX -> AbAxioms[l].Ab[X,d.1].Ax * Act[X,d.1,d.2].Ax) (Torsor[l].isProp-isSet X) (\ sX ->
   isProp-Sigma AbAxioms[l].Ab[X,d.1].Ax (\ h -> Act[X,d.1,d.2].Ax) AbAxioms[l].Ab[X,d.1].P[sX].ax-prop (\ h -> Act[X,d.1,d.2].P[sX].ax-prop)) ;
 N : G.Notion = G.axioms Data Ax ax-prop ;
 module S = G.Over[N] ;

 -- the record of modules is S.Str
 fields (A : Mod) : S.Str = (A.M, (A.madd, A.sm), A.setM, (A.maddA, A.maddC, A.mz, A.maddZ, A.mneg, A.maddN),
  (A.smA, A.smO, A.smD, A.smE)) ;
 mk (B : S.Str) : Mod = new A7.Mod[Rg,B.1,B.2.2.1,B.2.2.2.1.2.2.1,B.2.1.1,B.2.2.2.1.2.2.2.2.1,
  B.2.2.2.1.1,B.2.2.2.1.2.1,B.2.2.2.1.2.2.2.1,B.2.2.2.1.2.2.2.2.2,
  B.2.1.2,B.2.2.2.2.1,B.2.2.2.2.2.1,B.2.2.2.2.2.2.1,B.2.2.2.2.2.2.2] ;
 -- linear equivalences
 LinEquiv (A B : Mod) : U l = S.Iso (fields A) (fields B) ;
 idLin (A : Mod) : LinEquiv A A = S.idIso (fields A) ;
 Total (A : Mod) : U l+ = (B : Mod) * LinEquiv A B ;
 back (A B : Mod) (phi : LinEquiv A B) : Id (Total A) (mk (fields B), phi) (B, phi) =
  Total-eta A B phi
  where {
   Total-eta (A : Mod) : (B : Mod) (phi : LinEquiv A B) -> Id (Total A) (mk (fields B), phi) (B, phi) = split {
    Mod M setM mz madd mneg maddA maddC maddZ maddN sm smA smO smD smE -> \ phi ->
     refl (new A7.Mod[Rg,M,setM,mz,madd,mneg,maddA,maddC,maddZ,maddN,sm,smA,smO,smD,smE], phi) } ;
  } ;
 total-contr (A : Mod) : FunExtUA[l+].isContr (Total A) =
  GH.ctr-retract (S.Total (fields A)) (Total A) (S.total-contr (fields A))
   (\ c -> (fields c.1, c.2)) (\ c -> (mk c.1, c.2)) (\ c -> back A c.1 c.2) ;
 opaque total-contr ;
 -- the structure identity principle: Id Mod A B ~ LinEquiv A B, under the
 -- names of ModuleSIP and ModuleSIPFull
 module Fd = G.Fundamental[Mod,LinEquiv,idLin,total-contr] ;
 pth (A : Mod) (c : Total A) : Id (Total A) (A,idLin A) c = Fd.pth A c ;
 pth-id (A : Mod) : Id (Id (Total A) (A,idLin A) (A,idLin A)) (pth A (A,idLin A)) (refl (A,idLin A)) = Fd.pth-id A ;
 sip (A B : Mod) (phi : LinEquiv A B) : Id Mod A B = Fd.sip A B phi ;
 idToIso (A B : Mod) (p : Id Mod A B) : LinEquiv A B = Fd.idToIso A B p ;
 sip-id (A : Mod) : Id (Id Mod A A) (sip A A (idLin A)) (refl A) = Fd.sip-id A ;
 idToIso-sip (A B : Mod) (phi : LinEquiv A B) : Id (LinEquiv A B) (idToIso A B (sip A B phi)) phi = Fd.idToIso-sip A B phi ;
 sip-idToIso (A B : Mod) (p : Id Mod A B) : Id (Id Mod A B) (sip A B (idToIso A B p)) p = Fd.sip-idToIso A B p ;
 sip-equiv (A B : Mod) : Prelude[l+].Equiv (LinEquiv A B) (Id Mod A B) = Fd.sip-equiv A B ;
 local-small : Replacement[l,l+].LocallySmall Mod = \ A B -> (LinEquiv A B,sip-equiv A B) ;
 -- ModuleSIP's and ModuleSIPFull's names for the parts of a linear equivalence
 Additive (A B : Mod) (f : A.M -> B.M) : U l = (x y : A.M) -> Id B.M (f (A.madd x y)) (B.madd (f x) (f y)) ;
 Scalar (A B : Mod) (f : A.M -> B.M) : U l = (a : R) (x : A.M) -> Id B.M (f (A.sm a x)) (B.sm a (f x)) ;
 Lin (A B : Mod) (f : A.M -> B.M) : U l = Additive A B f * Scalar A B f ;
 lin-prop (A B : Mod) (f : A.M -> B.M) : isProp (Lin A B f) =
  isProp-Sigma (Additive A B f) (\ h -> Scalar A B f)
   (FL.isProp-Pi A.M (\ x -> (y : A.M) -> Id B.M (f (A.madd x y)) (B.madd (f x) (f y))) (\ x ->
     FL.isProp-Pi A.M (\ y -> Id B.M (f (A.madd x y)) (B.madd (f x) (f y))) (\ y -> B.setM (f (A.madd x y)) (B.madd (f x) (f y)))))
   (\ h -> FL.isProp-Pi R (\ a -> (x : A.M) -> Id B.M (f (A.sm a x)) (B.sm a (f x))) (\ a ->
     FL.isProp-Pi A.M (\ x -> Id B.M (f (A.sm a x)) (B.sm a (f x))) (\ x -> B.setM (f (A.sm a x)) (B.sm a (f x))))) ;
 -- these linear equivalences are ModuleSIP's, by definition
 same (A B : Mod) (phi : ModuleSIP[l].Over[Rg].LinEquiv A B) : LinEquiv A B = phi ;
 same' (A B : Mod) (phi : LinEquiv A B) : ModuleSIP[l].Over[Rg].LinEquiv A B = phi ;
} ;
