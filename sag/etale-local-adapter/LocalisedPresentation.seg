-- E_M = M^{-1}E over A_M is the scalar extension of E along A -> A_M: it
-- has the mapped presentation, so it is finitely presented over A_M, and
-- formally unramified over A_M when E is over A.  This feeds the special
-- fibre at A_M (FiniteSpecialFibre) and the generators given to ZMT.
-- Informal proof.
-- (1) Agree: two ring maps g, g' out of a monoid localisation S^{-1}A that
--  agree on constants are equal.  On a fraction a/t: g(t) g(a/t) = g(a)
--  (fraction-equation), and g(t) = g'(t) is a unit (the image of the unit
--  t/1), so g(a/t) and g'(a/t) both solve phi(t) b = phi(a) with phi = g
--  on constants; that solution is unique (MonoidLocalizationMap.unique).
-- (2) ScalarExtension (generic, any rho : R -> K): a K-algebra T with an
--  R-algebra map projection : E -> T and, for every K-algebra B, an inverse
--  "backward" to "forward h = h o projection" (beta: backward f extends f;
--  bf: backward (forward h) = h) is presented by the mapped presentation p
--  of a presentation of E: a solution of the mapped p in B is a solution
--  of p in B over R, i.e. a map E -> B, i.e. (backward) a map T -> B; the
--  two round trips are identities by beta on the generators and by bf.
--  Then T is finitely presented, and formally unramified when E is
--  (UnramifiedBaseChange).
-- (3) Over: the instance T = E_M, projection = phi.  For f : E -> B over
--  A, the image of t in M is iota(t), and f(iota t) = B.iota(t/1) is a
--  unit, so f extends to E_M (MonoidLocalizationMap); the extension is
--  A_M-linear by (1) on A_M (both maps send a/1 to B.iota(a/1)); beta is
--  the extension's value on constants, and bf is (1) on E_M.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
-- (1) maps out of a monoid localisation are determined on constants
module Agree (A : CRing) (S : A.R -> U l) (one : S A.o)
 (product : (s t : A.R) -> S s -> S t -> S (A.mul s t)) (C : CRing) (setC : Pr.isSet C.R)
 (g g' : H.Hom MonoidLocalization[l].Over[A,S,one,product].ring C)
 (agree : (a : A.R) -> Id C.R (g.1 (MonoidLocalization[l].Over[A,S,one,product].constant a))
   (g'.1 (MonoidLocalization[l].Over[A,S,one,product].constant a))) {
 module B = MonoidLocalization[l].Over[A,S,one,product] ;
 phi : H.Hom A C = H.compose A B.ring C g B.inclusion ;
 units (t : A.R) (ht : S t) : RL[C].unit (phi.1 t) = FormallyEtale[l].unit-map B.ring C g (B.constant t) (B.inverse t ht) ;
 module X = MonoidLocalizationMap[l].Over[A,S,one,product,C,setC,phi,units] ;
 left (q : B.Raw.Fraction) : Id C.R (X.evaluate q) (g.1 (B.include q)) =
  X.unique q (g.1 (B.include q)) (trans (sym (g.2.2.2 (B.constant q.2.1) (B.include q))) (ap g.1 (B.fraction-equation q))) ;
 right (q : B.Raw.Fraction) : Id C.R (X.evaluate q) (g'.1 (B.include q)) =
  X.unique q (g'.1 (B.include q))
   (calc C.R { C.mul (phi.1 q.2.1) (g'.1 (B.include q))
    =< ap (\ c -> C.mul c (g'.1 (B.include q))) (agree q.2.1) > C.mul (g'.1 (B.constant q.2.1)) (g'.1 (B.include q))
    =< sym (g'.2.2.2 (B.constant q.2.1) (B.include q)) > g'.1 (B.ring.mul (B.constant q.2.1) (B.include q))
    =< ap g'.1 (B.fraction-equation q) > g'.1 (B.constant q.1)
    =< sym (agree q.1) > phi.1 q.1 }) ;
 equal (x : B.Carrier) : Id C.R (g.1 x) (g'.1 x) =
  B.Q.induction @l (\ x -> Id C.R (g.1 x) (g'.1 x)) (\ x -> setC _ _) (\ q -> trans (sym (left q)) (right q)) x ;
} ;
-- (2) a K-algebra with the universal property of scalar extension
module ScalarExtension (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : H.Hom R K) {
 module BC = MappedPresentation[l].Over[R,K,setR,setK,rho] ;
 module CR = BC.CR ; module CK = BC.CK ; module PR = BC.PR ; module PK = BC.PK ;
 forward (E : CR.Algebra) (T : CK.Algebra) (projection : CR.Hom E (BC.restrict T)) (B : CK.Algebra) (h : CK.Hom T B) :
  CR.Hom E (BC.restrict B) = CR.compose E (BC.restrict T) (BC.restrict B) (BC.restrict-map T B h) projection ;
 module At (E : CR.Algebra) (T : CK.Algebra) (projection : CR.Hom E (BC.restrict T))
  (backward : (B : CK.Algebra) -> CR.Hom E (BC.restrict B) -> CK.Hom T B)
  (beta : (B : CK.Algebra) (f : CR.Hom E (BC.restrict B)) (e : E.ring.R) ->
    Id B.ring.R ((backward B f).1.1 (projection.1.1 e)) (f.1.1 e))
  (bf : (B : CK.Algebra) (h : CK.Hom T B) -> Id (CK.Hom T B) (backward B (forward E T projection B h)) h) {
  module Presented (p : PR.Presentation) (ps : PR.Presents p E) {
   mapped : PK.Presentation = BC.presentation p ;
   solution : PK.Solutions mapped T = BC.solution-forward p T (PR.canonical p E ps.1 (BC.restrict T) projection) ;
   module Target (B : CK.Algebra) {
    solution-R (s : PK.Solutions mapped B) : PR.Solutions p (BC.restrict B) = BC.solution-backward p B s ;
    original (s : PK.Solutions mapped B) : CR.Hom E (BC.restrict B) = (ps.2 (BC.restrict B)).sec (solution-R s) ;
    extend (s : PK.Solutions mapped B) : CK.Hom T B = backward B (original s) ;
    to-solution : CK.Hom T B -> PK.Solutions mapped B = PK.canonical mapped T solution B ;
    original-beta (s : PK.Solutions mapped B) (i : Fin p.1) : Id B.ring.R ((original s).1.1 (ps.1.1 i)) (s.1 i) =
     ap (\ w -> w.1 i) ((ps.2 (BC.restrict B)).sec-eq (solution-R s)) ;
    fb (s : PK.Solutions mapped B) : Id (PK.Solutions mapped B) (to-solution (extend s)) s =
     PK.solutions-ext mapped B _ s (\ i -> trans (beta B (original s) (ps.1.1 i)) (original-beta s i)) ;
    original-forward (h : CK.Hom T B) : Id (CR.Hom E (BC.restrict B)) (original (to-solution h)) (forward E T projection B h) =
     Equivalences[l].injective (CR.Hom E (BC.restrict B)) (PR.Solutions p (BC.restrict B))
      (PR.canonical p E ps.1 (BC.restrict B)) (ps.2 (BC.restrict B)) _ _
      (PR.solutions-ext p (BC.restrict B) _ _ (original-beta (to-solution h))) ;
    bf' (h : CK.Hom T B) : Id (CK.Hom T B) (extend (to-solution h)) h =
     trans (ap (backward B) (original-forward h)) (bf B h) ;
    universal : Pr.isEquiv (CK.Hom T B) (PK.Solutions mapped B) to-solution = Pr.qinv _ _ to-solution extend fb bf' ;
   } ;
   presents : PK.Presents mapped T = (solution,\ B -> Target[B].universal) ;
   finite-presentation : PK.FP T = Truncation[l+].Trunc[PK.Witness T].inc (mapped,presents) ;
   unramified (unique : FormallyEtale[l].Over[R,setR].Unique E) : FormallyEtale[l].Over[K,setK].Unique T =
    UnramifiedBaseChange[l].Over[R,K,setR,setK,rho].At[E,p,ps,T,presents,unique].theorem ;
  } ;
 } ;
} ;
-- (3) E_M over A_M
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (M : A.R -> U l) (one : M A.o) (product : (s t : A.R) -> M s -> M t -> M (A.mul s t)) {
 module LA = LocalisedAlgebra[l].Over[A,setA,E,setE,iota,M,one,product] ;
 module UA = ScalarExtension[A,LA.L.ring,setA,LA.L.set,LA.L.inclusion] ;
 Ea : UA.CR.Algebra = UA.CR.mkAlgebra E setE iota ;
 algebra : UA.CK.Algebra = UA.CK.mkAlgebra LA.EM.ring LA.EM.set LA.iota' ;
 projection : UA.CR.Hom Ea (UA.BC.restrict algebra) = (LA.phi,LA.compat) ;
 module To (B : UA.CK.Algebra) {
  -- f(iota t) = B.iota(t/1) is a unit
  units (f : UA.CR.Hom Ea (UA.BC.restrict B)) (e : E.R) (he : LA.Image e) : RL[B.ring].unit (f.1.1 e) =
   subst (\ x -> RL[B.ring].unit (f.1.1 x)) he.2.2
    (subst (RL[B.ring].unit) (sym (f.2 he.1))
     (FormallyEtale[l].unit-map LA.L.ring B.ring B.iota (LA.L.constant he.1) (LA.L.inverse he.1 he.2.1))) ;
  module Map (f : UA.CR.Hom Ea (UA.BC.restrict B)) {
   module X = MonoidLocalizationMap[l].Over[E,LA.Image,LA.image-one,LA.image-product,B.ring,B.set,f.1,units f] ;
   on-constants (a : A.R) : Id B.ring.R (X.hom.1 (LA.iota'.1 (LA.L.constant a))) (B.iota.1 (LA.L.constant a)) =
    trans (ap X.hom.1 (sym (LA.compat a))) (trans (X.constants (iota.1 a)) (f.2 a)) ;
   module G = Agree[A,M,one,product,B.ring,B.set,H.compose LA.L.ring LA.EM.ring B.ring X.hom LA.iota',B.iota,on-constants] ;
   hom : UA.CK.Hom algebra B = (X.hom,G.equal) ;
  } ;
  backward (f : UA.CR.Hom Ea (UA.BC.restrict B)) : UA.CK.Hom algebra B = Map[f].hom ;
  beta (f : UA.CR.Hom Ea (UA.BC.restrict B)) (e : E.R) : Id B.ring.R ((backward f).1.1 (LA.phi.1 e)) (f.1.1 e) =
   Map[f].X.constants e ;
  bf (h : UA.CK.Hom algebra B) : Id (UA.CK.Hom algebra B) (backward (UA.forward Ea algebra projection B h)) h =
   UA.CK.ext algebra B _ h
    (Agree[E,LA.Image,LA.image-one,LA.image-product,B.ring,B.set,(backward (UA.forward Ea algebra projection B h)).1,h.1,
      beta (UA.forward Ea algebra projection B h)].equal) ;
 } ;
 module Scalar = UA.At[Ea,algebra,projection,\ B f -> To[B].backward f,\ B f e -> To[B].beta f e,\ B h -> To[B].bf h] ;
} ;
