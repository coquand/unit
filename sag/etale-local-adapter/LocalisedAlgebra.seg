-- Front 4.3: the localisation adapter.  For an A-algebra E and a
-- multiplicative family M of A, the ring E_M = M^{-1}E is the instance of
-- LocalDescent's abstract E'; a predicate q of E induces q' on E_M; and
-- when q is a decidable prime relative to Bot (merely, Bot a proposition;
-- or exactly, with an exit from Bot) and M contains every a with iota(a)
-- outside q, A_M is local with maximal ideal m = q' o iota' (merely, up to
-- Bot).  Then the chart data of
-- MonicFiniteLocal at (A_M, E_M, q') descend to a chart over A.
-- Informal proof.
-- (1) E_M is the localisation of E at iota(M); iota' : A_M -> E_M is the
--  extension of A -> E -> E_M (the image of t in M is a unit).  Every z in
--  E_M is merely e/iota(t), so t z = phi(e) (fractions); phi(a) = phi(b)
--  merely gives u a = u b, u = iota(t) (equalizer, by effectiveness).
-- (2) q' z: merely t z = phi(e) with q e.  q' is an ideal containing
--  phi(q) (sums and products of fractions), and m = q' o iota' is an
--  ideal of A_M.
-- (3) Moving a membership between two fractions of z.  If t z = phi e and
--  t' z = phi e', then phi(t' e) = phi(t e'), so merely s t' e = s t e'
--  (s in M); q e' then gives q (s t' e), and stripping s t' (strip:
--  q (iota(t) x) gives q x or Bot, for t in M) gives q e or Bot.
-- (4) The hit-or-split regime (Bot a proposition, no exit; q decided
--  merely up to Bot, 1 in q gives Bot, q prime as an eliminator into Bot).
--  Every goal below is a proposition, so representatives may be chosen:
--  q' z is decided on a representative e/t by q e (the negative case: a
--  member fraction moves to e/t, giving q e or Bot, both Bot); q' 1 gives
--  Bot by moving to 1/1; q'(ac) with a, c outside q' up to Bot moves to the
--  product of fractions and primality of q gives Bot; A_M is local: a/t
--  with q(iota a) is in m, otherwise a is in M and a/t is a unit (t/a).
-- (4') The exact regime (exit : Bot -> Empty, q decidable, 1 not in q).
--  The alternatives are disjoint propositions, so the decisions descend
--  as functions; the exit makes Bot a proposition, so (4) applies.
-- (5) The certificate.  MonicFiniteLocal at (A_M, E_M, q') gives the chart
--  data; LocalDescent.Chart.Relative gives h in E with q h -> Bot and
--  E[1/h] monic standard over A.
-- (6) The canonical M: the elements that strip from q (Strips); it contains
--  every a with iota(a) outside q by primality of q relative to Bot.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module F = Axioms[l].FunExtLemmas[fe @l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Tr1 = Truncation[l+] ;
empty-prop : Pr.isProp Empty = \ e -> absurd ((y : Empty) -> Id Empty e y) e ;
-- (6) the elements of A that strip from q
module Stripping (A : CRing) (E : CRing) (iota : RingHom[l].Hom A E) (q : E.R -> U l)
 (Bot : U l) (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (Plus (q a) (q c)) Bot) {
 Strips (t : A.R) : U l = (x : E.R) -> q (E.mul (iota.1 t) x) -> Plus (q x) Bot ;
 one : Strips A.o = \ x h -> inl (subst q (trans (ap (\ c -> E.mul c x) iota.2.1) (RL[E].one-left x)) h) ;
 -- iota(s t) x = iota(s) (iota(t) x)
 associate (s t : A.R) (x : E.R) : Id E.R (E.mul (iota.1 (A.mul s t)) x) (E.mul (iota.1 s) (E.mul (iota.1 t) x)) =
  trans (ap (\ c -> E.mul c x) (iota.2.2.2 s t)) (sym (E.mulA (iota.1 s) (iota.1 t) x)) ;
 continue (t : A.R) (mt : Strips t) (x : E.R) : Plus (q (E.mul (iota.1 t) x)) Bot -> Plus (q x) Bot = split {
  inl k -> mt x k ; inr b -> inr b } ;
 product (s t : A.R) (ms : Strips s) (mt : Strips t) : Strips (A.mul s t) = \ x h ->
  continue t mt x (ms (E.mul (iota.1 t) x) (subst q (associate s t x) h)) ;
 -- an element outside q (up to Bot) strips, by primality
 outside-left (a : A.R) (n : q (iota.1 a) -> Bot) (x : E.R) : Plus (q (iota.1 a)) (q x) -> Plus (q x) Bot = split {
  inl h -> inr (n h) ; inr k -> inl k } ;
 outside-case (a : A.R) (n : q (iota.1 a) -> Bot) (x : E.R) : Plus (Plus (q (iota.1 a)) (q x)) Bot -> Plus (q x) Bot = split {
  inl d -> outside-left a n x d ; inr b -> inr b } ;
 outside (a : A.R) (n : q (iota.1 a) -> Bot) : Strips a = \ x h -> outside-case a n x (q-prime (iota.1 a) x h) ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (M : A.R -> U l) (one : M A.o) (product : (s t : A.R) -> M s -> M t -> M (A.mul s t)) {
 module L = MonoidLocalization[l].Over[A,M,one,product] ;
 -- (1) E_M, the localisation of E at the image of M
 Image (e : E.R) : U l = (t : A.R) * M t * Id E.R (iota.1 t) e ;
 image-one : Image E.o = (A.o,one,iota.2.1) ;
 image-product (e f : E.R) (he : Image e) (hf : Image f) : Image (E.mul e f) =
  (A.mul he.1 hf.1,product he.1 hf.1 he.2.1 hf.2.1,trans (iota.2.2.2 he.1 hf.1) (cong2 E.R E.mul _ _ _ _ he.2.2 hf.2.2)) ;
 module EM = MonoidLocalization[l].Over[E,Image,image-one,image-product] ;
 module LEM = RL[EM.ring] ;
 phi : H.Hom E EM.ring = EM.inclusion ;
 imageA : H.Hom A EM.ring = H.compose A E EM.ring EM.inclusion iota ;
 units (t : A.R) (mt : M t) : LEM.unit (imageA.1 t) = EM.inverse (iota.1 t) (t,mt,refl (iota.1 t)) ;
 module Ext = MonoidLocalizationMap[l].Over[A,M,one,product,EM.ring,EM.set,imageA,units] ;
 iota' : H.Hom L.ring EM.ring = Ext.hom ;
 compat (a : A.R) : Id EM.ring.R (phi.1 (iota.1 a)) (iota'.1 (L.constant a)) = sym (Ext.constants a) ;
 -- z is a fraction: t z = phi(e), t in M
 Frac (z : EM.ring.R) : U l = (t : A.R) * M t * (e : E.R) * Id EM.ring.R (EM.ring.mul (iota'.1 (L.constant t)) z) (phi.1 e) ;
 weight (z : EM.ring.R) (f : Frac z) : A.R = f.1 ;
 numerator (z : EM.ring.R) (f : Frac z) : E.R = f.2.2.1 ;
 from-fraction (p : EM.Raw.Fraction) : Frac (EM.include p) =
  (p.2.2.1,p.2.2.2.1,p.1,
   trans (ap (\ c -> EM.ring.mul c (EM.include p)) (trans (sym (compat p.2.2.1)) (ap EM.constant p.2.2.2.2)))
    (EM.fraction-equation p)) ;
 fractions (z : EM.ring.R) : Tr.Trunc[Frac z].carrier =
  TC.map (EM.Representatives z) (Frac z) (\ r -> subst Frac r.2 (from-fraction r.1)) (EM.representatives z) ;
 Equalized (a b : E.R) : U l = (s : A.R) * M s * Id E.R (E.mul (iota.1 s) a) (E.mul (iota.1 s) b) ;
 equalized (a b : E.R) (w : EM.Raw.Witness (EM.Raw.constantF a) (EM.Raw.constantF b)) : Equalized a b =
  (w.2.1.1,w.2.1.2.1,
   calc E.R { E.mul (iota.1 w.2.1.1) a
    =< ap (\ c -> E.mul c a) w.2.1.2.2 > E.mul w.1 a
    =< ap (E.mul w.1) (sym (E.mulO a)) > E.mul w.1 (E.mul a E.o)
    =< w.2.2 > E.mul w.1 (E.mul b E.o)
    =< ap (E.mul w.1) (E.mulO b) > E.mul w.1 b
    =< ap (\ c -> E.mul c b) (sym w.2.1.2.2) > E.mul (iota.1 w.2.1.1) b }) ;
 equalizer (a b : E.R) (eq : Id EM.ring.R (phi.1 a) (phi.1 b)) : Tr.Trunc[Equalized a b].carrier =
  TC.map (EM.Raw.Witness (EM.Raw.constantF a) (EM.Raw.constantF b)) (Equalized a b) (equalized a b)
   (EM.Q.effective (EM.Raw.constantF a) (EM.Raw.constantF b) eq) ;
 -- E_M is an instance of LocalDescent's E'
 module D = LocalDescent[l].Over[A,setA,M,one,product].Algebra[E,setE,iota,EM.ring,EM.set,iota',phi,compat,fractions,equalizer] ;
 module Mo = LocalDescent[l].Monic[A,setA,E,setE,iota] ;
 -- (2) arithmetic of fractions
 frac-zero : Frac EM.ring.z =
  (A.o,one,E.z,trans (LEM.mul-zero (D.image A.o)) (sym (H.zero E EM.ring phi))) ;
 frac-phi (x : E.R) : Frac (phi.1 x) =
  (A.o,one,x,trans (ap (\ c -> EM.ring.mul c (phi.1 x)) iota'.2.1) (LEM.one-left (phi.1 x))) ;
 frac-sum (z1 z2 : EM.ring.R) (f1 : Frac z1) (f2 : Frac z2) : Frac (EM.ring.add z1 z2) =
  (A.mul f1.1 f2.1,product f1.1 f2.1 f1.2.1 f2.2.1,
   E.add (E.mul (iota.1 f2.1) (numerator z1 f1)) (E.mul (iota.1 f1.1) (numerator z2 f2)),
   calc EM.ring.R { EM.ring.mul (D.image (A.mul f1.1 f2.1)) (EM.ring.add z1 z2)
    =< ap (\ c -> EM.ring.mul c (EM.ring.add z1 z2)) (D.image-mul f1.1 f2.1) >
       EM.ring.mul (EM.ring.mul (D.image f1.1) (D.image f2.1)) (EM.ring.add z1 z2)
    =< EM.ring.dist (EM.ring.mul (D.image f1.1) (D.image f2.1)) z1 z2 >
       EM.ring.add (EM.ring.mul (EM.ring.mul (D.image f1.1) (D.image f2.1)) z1) (EM.ring.mul (EM.ring.mul (D.image f1.1) (D.image f2.1)) z2)
    =< cong2 EM.ring.R EM.ring.add _ _ _ _ (D.exchange EM.ring (D.image f1.1) (D.image f2.1) z1)
        (sym (EM.ring.mulA (D.image f1.1) (D.image f2.1) z2)) >
       EM.ring.add (EM.ring.mul (D.image f2.1) (EM.ring.mul (D.image f1.1) z1)) (EM.ring.mul (D.image f1.1) (EM.ring.mul (D.image f2.1) z2))
    =< cong2 EM.ring.R EM.ring.add _ _ _ _ (cong2 EM.ring.R EM.ring.mul _ _ _ _ (sym (compat f2.1)) f1.2.2.2)
        (cong2 EM.ring.R EM.ring.mul _ _ _ _ (sym (compat f1.1)) f2.2.2.2) >
       EM.ring.add (EM.ring.mul (phi.1 (iota.1 f2.1)) (phi.1 (numerator z1 f1))) (EM.ring.mul (phi.1 (iota.1 f1.1)) (phi.1 (numerator z2 f2)))
    =< sym (cong2 EM.ring.R EM.ring.add _ _ _ _ (phi.2.2.2 (iota.1 f2.1) (numerator z1 f1)) (phi.2.2.2 (iota.1 f1.1) (numerator z2 f2))) >
       EM.ring.add (phi.1 (E.mul (iota.1 f2.1) (numerator z1 f1))) (phi.1 (E.mul (iota.1 f1.1) (numerator z2 f2)))
    =< sym (phi.2.2.1 (E.mul (iota.1 f2.1) (numerator z1 f1)) (E.mul (iota.1 f1.1) (numerator z2 f2))) >
       phi.1 (E.add (E.mul (iota.1 f2.1) (numerator z1 f1)) (E.mul (iota.1 f1.1) (numerator z2 f2))) }) ;
 frac-times (z1 z2 : EM.ring.R) (f1 : Frac z1) (f2 : Frac z2) : Frac (EM.ring.mul z1 z2) =
  (A.mul f1.1 f2.1,product f1.1 f2.1 f1.2.1 f2.2.1,E.mul (numerator z1 f1) (numerator z2 f2),
   calc EM.ring.R { EM.ring.mul (D.image (A.mul f1.1 f2.1)) (EM.ring.mul z1 z2)
    =< ap (\ c -> EM.ring.mul c (EM.ring.mul z1 z2)) (D.image-mul f1.1 f2.1) >
       EM.ring.mul (EM.ring.mul (D.image f1.1) (D.image f2.1)) (EM.ring.mul z1 z2)
    =< LEM.mul-four (D.image f1.1) (D.image f2.1) z1 z2 >
       EM.ring.mul (EM.ring.mul (D.image f1.1) z1) (EM.ring.mul (D.image f2.1) z2)
    =< cong2 EM.ring.R EM.ring.mul _ _ _ _ f1.2.2.2 f2.2.2.2 > EM.ring.mul (phi.1 (numerator z1 f1)) (phi.1 (numerator z2 f2))
    =< sym (phi.2.2.2 (numerator z1 f1) (numerator z2 f2)) > phi.1 (E.mul (numerator z1 f1) (numerator z2 f2)) }) ;
 -- two fractions of z: phi(t' e) = phi(t e')
 compare (z : EM.ring.R) (f f' : Frac z) :
  Id EM.ring.R (phi.1 (E.mul (iota.1 f'.1) (numerator z f))) (phi.1 (E.mul (iota.1 f.1) (numerator z f'))) =
  calc EM.ring.R { phi.1 (E.mul (iota.1 f'.1) (numerator z f))
   =< trans (phi.2.2.2 (iota.1 f'.1) (numerator z f)) (ap (\ c -> EM.ring.mul c (phi.1 (numerator z f))) (compat f'.1)) >
      EM.ring.mul (D.image f'.1) (phi.1 (numerator z f))
   =< ap (EM.ring.mul (D.image f'.1)) (sym f.2.2.2) > EM.ring.mul (D.image f'.1) (EM.ring.mul (D.image f.1) z)
   =< LEM.mul-swap (D.image f'.1) (D.image f.1) z > EM.ring.mul (D.image f.1) (EM.ring.mul (D.image f'.1) z)
   =< ap (EM.ring.mul (D.image f.1)) f'.2.2.2 > EM.ring.mul (D.image f.1) (phi.1 (numerator z f'))
   =< sym (trans (phi.2.2.2 (iota.1 f.1) (numerator z f')) (ap (\ c -> EM.ring.mul c (phi.1 (numerator z f'))) (compat f.1))) >
      phi.1 (E.mul (iota.1 f.1) (numerator z f')) } ;
 -- (2) the predicate q' on E_M
 module Ideal (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
  (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) {
  Member (z : EM.ring.R) : U l = (f : Frac z) * q (numerator z f) ;
  q' (z : EM.ring.R) : U l = Tr.Trunc[Member z].carrier ;
  q'-zero : q' EM.ring.z = Tr.Trunc[Member EM.ring.z].inc (frac-zero,q-zero) ;
  q'-add (z1 z2 : EM.ring.R) : q' z1 -> q' z2 -> q' (EM.ring.add z1 z2) =
   TC.map2 (Member z1) (Member z2) (Member (EM.ring.add z1 z2))
    (\ w1 w2 -> (frac-sum z1 z2 w1.1 w2.1,q-add (E.mul (iota.1 w2.1.1) (numerator z1 w1.1)) (E.mul (iota.1 w1.1.1) (numerator z2 w2.1))
      (q-scale (iota.1 w2.1.1) (numerator z1 w1.1) w1.2) (q-scale (iota.1 w1.1.1) (numerator z2 w2.1) w2.2))) ;
  q'-scale (a z : EM.ring.R) (h : q' z) : q' (EM.ring.mul a z) =
   TC.map2 (Frac a) (Member z) (Member (EM.ring.mul a z))
    (\ fa w -> (frac-times a z fa w.1,q-scale (numerator a fa) (numerator z w.1) w.2)) (fractions a) h ;
  q-phi (x : E.R) (h : q x) : q' (phi.1 x) = Tr.Trunc[Member (phi.1 x)].inc (frac-phi x,h) ;
  -- m = q' o iota', an ideal of A_M with m E_M in q'
  m (r : L.Carrier) : U l = q' (iota'.1 r) ;
  m-zero : m L.ring.z = subst q' (sym (H.zero L.ring EM.ring iota')) q'-zero ;
  m-add (a c : L.Carrier) (ha : m a) (hc : m c) : m (L.ring.add a c) =
   subst q' (sym (iota'.2.2.1 a c)) (q'-add (iota'.1 a) (iota'.1 c) ha hc) ;
  m-scale (a c : L.Carrier) (hc : m c) : m (L.ring.mul a c) =
   subst q' (sym (iota'.2.2.2 a c)) (q'-scale (iota'.1 a) (iota'.1 c) hc) ;
  q-m (a : L.Carrier) (h : m a) : q' (iota'.1 a) = h ;
  -- the representatives of A_M: a/t is in m when q(iota a); a unit t/a when a is in M
  module LL = RL[L.ring] ;
  frac-of (p : L.Raw.Fraction) : Frac (iota'.1 (L.include p)) =
   (p.2.1,p.2.2,iota.1 p.1,
    trans (sym (iota'.2.2.2 (L.constant p.2.1) (L.include p))) (trans (ap iota'.1 (L.fraction-equation p)) (sym (compat p.1)))) ;
  unit-of (p : L.Raw.Fraction) (ma : M p.1) : LL.unit (L.include p) =
   (L.ring.mul (L.constant p.2.1) (L.inverse p.1 ma).1,
    calc L.Carrier { L.ring.mul (L.include p) (L.ring.mul (L.constant p.2.1) (L.inverse p.1 ma).1)
     =< L.ring.mulA (L.include p) (L.constant p.2.1) (L.inverse p.1 ma).1 >
        L.ring.mul (L.ring.mul (L.include p) (L.constant p.2.1)) (L.inverse p.1 ma).1
     =< ap (\ c -> L.ring.mul c (L.inverse p.1 ma).1) (trans (L.ring.mulC (L.include p) (L.constant p.2.1)) (L.fraction-equation p)) >
        L.ring.mul (L.constant p.1) (L.inverse p.1 ma).1
     =< (L.inverse p.1 ma).2 > L.ring.o }) ;
  LocalDecision (r : L.Carrier) : U l = Plus (m r) (LL.unit r) ;
  -- (3) moving a membership between two fractions, given stripping
  module Strip (Bot : U l) (strip : (t : A.R) -> M t -> (x : E.R) -> q (E.mul (iota.1 t) x) -> Plus (q x) Bot) {
   move-at (z : EM.ring.R) (f f' : Frac z) (k : Equalized (E.mul (iota.1 f'.1) (numerator z f)) (E.mul (iota.1 f.1) (numerator z f')))
    (h : q (numerator z f')) : Plus (q (numerator z f)) Bot =
    strip (A.mul k.1 f'.1) (product k.1 f'.1 k.2.1 f'.2.1) (numerator z f)
     (subst q
       (calc E.R { E.mul (iota.1 k.1) (E.mul (iota.1 f.1) (numerator z f'))
         =< sym k.2.2 > E.mul (iota.1 k.1) (E.mul (iota.1 f'.1) (numerator z f))
         =< E.mulA (iota.1 k.1) (iota.1 f'.1) (numerator z f) > E.mul (E.mul (iota.1 k.1) (iota.1 f'.1)) (numerator z f)
         =< ap (\ c -> E.mul c (numerator z f)) (sym (iota.2.2.2 k.1 f'.1)) > E.mul (iota.1 (A.mul k.1 f'.1)) (numerator z f) })
       (q-scale (iota.1 k.1) (E.mul (iota.1 f.1) (numerator z f')) (q-scale (iota.1 f.1) (numerator z f') h))) ;
   move (z : EM.ring.R) (f f' : Frac z) (h : q (numerator z f')) : Tr.Trunc[Plus (q (numerator z f)) Bot].carrier =
    TC.map (Equalized (E.mul (iota.1 f'.1) (numerator z f)) (E.mul (iota.1 f.1) (numerator z f'))) (Plus (q (numerator z f)) Bot)
     (\ k -> move-at z f f' k h) (equalizer (E.mul (iota.1 f'.1) (numerator z f)) (E.mul (iota.1 f.1) (numerator z f')) (compare z f f')) ;
   -- the certificate: h outside q up to Bot, E[1/h] monic standard over A
   Certified : U l+ = (h : E.R) * (q h -> Bot) * Mo.MonicChart h ;
   -- (4) the hit-or-split regime: Bot a proposition, no exit
   module Mere (bot-prop : Pr.isProp Bot)
    (q-prime-out : (a c : E.R) -> (q a -> Bot) -> (q c -> Bot) -> q (E.mul a c) -> Bot)
    (q-proper : q E.o -> Bot) (q-dec : (a : E.R) -> Tr.Trunc[Plus (q a) (q a -> Bot)].carrier)
    (outside : (a : A.R) -> (q (iota.1 a) -> Bot) -> M a) {
    settle (P : U l) (n : P -> Bot) : Plus P Bot -> Bot = split { inl p -> n p ; inr b -> b } ;
    -- refute a mere alternative
    refute (P : U l) (n : P -> Bot) (r : Tr.Trunc[Plus P Bot].carrier) : Bot = TC.rec (Plus P Bot) @l Bot bot-prop (settle P n) r ;
    MereDecision (P : U l) : U l = Tr.Trunc[Plus P (P -> Bot)].carrier ;
    -- q' is decided on a representative, merely
    on-fraction (p : EM.Raw.Fraction) : Plus (q p.1) (q p.1 -> Bot) -> Plus (q' (EM.include p)) (q' (EM.include p) -> Bot) = split {
     inl h -> inl (Tr.Trunc[Member (EM.include p)].inc (from-fraction p,h)) ;
     inr n -> inr (\ w -> TC.rec (Member (EM.include p)) @l Bot bot-prop
       (\ k -> refute (q p.1) n (move (EM.include p) (from-fraction p) k.1 k.2)) w) } ;
    q'-dec (z : EM.ring.R) : MereDecision (q' z) =
     EM.Q.induction @l (\ z -> MereDecision (q' z)) (\ z -> Tr.Trunc[Plus (q' z) (q' z -> Bot)].proposition)
      (\ p -> TC.map (Plus (q p.1) (q p.1 -> Bot)) (Plus (q' (EM.include p)) (q' (EM.include p) -> Bot)) (on-fraction p) (q-dec p.1)) z ;
    -- 1 is in q' only up to Bot: move to 1/1
    q'-proper (w : q' EM.ring.o) : Bot =
     TC.rec (Member EM.ring.o) @l Bot bot-prop
      (\ k -> refute (q E.o) q-proper (move EM.ring.o (from-fraction (EM.Raw.constantF E.o)) k.1 k.2)) w ;
    -- q' is prime up to Bot: move q'(ac) to the product of fractions of a and c
    prime-at (a c : EM.ring.R) (na : q' a -> Bot) (nc : q' c -> Bot) (k : Member (EM.ring.mul a c)) (fa : Frac a) (fc : Frac c) : Bot =
     refute (q (numerator (EM.ring.mul a c) (frac-times a c fa fc)))
      (q-prime-out (numerator a fa) (numerator c fc)
       (\ h -> na (Tr.Trunc[Member a].inc (fa,h))) (\ h -> nc (Tr.Trunc[Member c].inc (fc,h))))
      (move (EM.ring.mul a c) (frac-times a c fa fc) k.1 k.2) ;
    q'-prime-out (a c : EM.ring.R) (na : q' a -> Bot) (nc : q' c -> Bot) (h : q' (EM.ring.mul a c)) : Bot =
     TC.rec (Member (EM.ring.mul a c)) @l Bot bot-prop (\ k ->
      TC.rec (Frac a) @l Bot bot-prop (\ fa ->
       TC.rec (Frac c) @l Bot bot-prop (\ fc -> prime-at a c na nc k fa fc) (fractions c))
       (fractions a))
      h ;
    -- A_M is local, merely: decided on a representative a/t
    on-representative (p : L.Raw.Fraction) : Plus (q (iota.1 p.1)) (q (iota.1 p.1) -> Bot) -> LocalDecision (L.include p) = split {
     inl h -> inl (Tr.Trunc[Member (iota'.1 (L.include p))].inc (frac-of p,h)) ;
     inr n -> inr (unit-of p (outside p.1 n)) } ;
    dec (r : L.Carrier) : Tr.Trunc[LocalDecision r].carrier =
     L.Q.induction @l (\ r -> Tr.Trunc[LocalDecision r].carrier) (\ r -> Tr.Trunc[LocalDecision r].proposition)
      (\ p -> TC.map (Plus (q (iota.1 p.1)) (q (iota.1 p.1) -> Bot)) (LocalDecision (L.include p)) (on-representative p) (q-dec (iota.1 p.1))) r ;
    -- (5) the certificate over A, from the local proof's data at (A_M, E_M, q')
    module Certificate (B : CRing) (setB : Pr.isSet B.R) (iB : H.Hom L.ring B) (j : H.Hom B EM.ring)
     (j-alg : (a : L.Carrier) -> Id EM.ring.R (j.1 (iB.1 a)) (iota'.1 a))
     (n' : Nat) (bs : Fin (suc n') -> B.R)
     (coord : (x : B.R) -> Tr.Trunc[(rho : Fin (suc n') -> L.Carrier) * Id B.R x (FiniteIdeal[l].Sums[B].sum (suc n') (\ k -> B.mul (iB.1 (rho k)) (bs k)))].carrier)
     (s : B.R) (s-out : q' (j.1 s) -> Bot)
     (zmt : (z : EM.ring.R) -> Tr.Trunc[(k : Nat) * (b : B.R) * Id EM.ring.R (EM.ring.mul (AffinePowers[l].Over[EM.ring].power (j.1 s) k) z) (j.1 b)].carrier) {
     module MF = MonicFiniteLocal[l].Over[L.ring,L.set,m,m-zero,m-add,m-scale,dec,
      EM.ring,EM.set,iota',q',q'-zero,q'-add,q'-scale,q-m,Bot,q'-prime-out,q'-proper,q'-dec,B,setB,iB,j,j-alg,n',bs,coord,s,s-out,zmt] ;
     -- ChartData does not mention s. A selected component may therefore
     -- refine s before supplying these data to descent.
     module SmoothData (fp : Presentations[l].Over[A,setA].FP Mo.Ealg)
      (unique : FormallyEtale[l].Over[A,setA].Unique Mo.Ealg)
      (smooth : FormallyEtale[l].Over[A,setA].Lift Mo.Ealg) {
      certify (d : MF.ChartData) : Tr1.Trunc[Certified].carrier =
       D.SmoothChart[MF.chart-y d,MF.chart-cs d,MF.chart-full d,MF.chart-integral d,fp,unique,smooth].Relative[q,q',Bot,q-phi,q'-scale,MF.chart-out d].certified ;
      theorem (datum : Tr.Trunc[MF.ChartData].carrier) : Tr1.Trunc[Certified].carrier =
       Tr.Trunc[MF.ChartData].induction @(l+) (\ w -> Tr1.Trunc[Certified].carrier) (\ w -> Tr1.Trunc[Certified].proposition)
        certify datum ;
     } ;
     module Field (x0 : B.R) (F0 : MF.In.Factor x0) (fp : Presentations[l].Over[A,setA].FP Mo.Ealg)
      (unique : FormallyEtale[l].Over[A,setA].Unique Mo.Ealg) (flat : FlatRelations[l].Over[A,E,iota].Flat) {
      module Data = SmoothData[fp,unique,FlatUnramifiedEtale[l].Over[A,setA].At[Mo.Ealg,fp,unique,flat].lift] ;
      certify (d : MF.ChartData) : Tr1.Trunc[Certified].carrier = Data.certify d ;
      theorem : Tr1.Trunc[Certified].carrier = Data.theorem MF.Data[x0,F0].theorem ;
     } ;
    } ;
   } ;
   -- (4') the exact regime
   module Exact (exit : Bot -> Empty) (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (Plus (q a) (q c)) Bot)
    (q-proper : Not (q E.o)) (q-dec : (a : E.R) -> Plus (q a) (Not (q a)))
    (outside : (a : A.R) -> Not (q (iota.1 a)) -> M a) {
    settle (P : U l) : Plus P Bot -> P = split { inl p -> p ; inr b -> efq (exit b) } ;
    -- refute a mere alternative
    refute (P : U l) (n : Not P) (r : Tr.Trunc[Plus P Bot].carrier) : Empty =
     TC.rec (Plus P Bot) @l Empty empty-prop (\ x -> n (settle P x)) r ;
    not-prop (P : U l) : Pr.isProp (Not P) = F.isProp-Pi P (\ x -> Empty) (\ x -> empty-prop) ;
    Decision (P : U l) : U l = Plus P (Not P) ;
    decision-prop (P : U l) (prop : Pr.isProp P) : Pr.isProp (Decision P) = split {
     inl p -> split { inl p' -> ap (\ x -> inl x) (prop p p') ; inr n -> efq (n p) } ;
     inr n -> split { inl p -> efq (n p) ; inr n' -> ap (\ x -> inr x) (not-prop P n n') } } ;
    -- q' is decided on a representative
    on-fraction (p : EM.Raw.Fraction) : Decision (q p.1) -> Decision (q' (EM.include p)) = split {
     inl h -> inl (Tr.Trunc[Member (EM.include p)].inc (from-fraction p,h)) ;
     inr n -> inr (\ w -> TC.rec (Member (EM.include p)) @l Empty empty-prop
       (\ k -> refute (q p.1) n (move (EM.include p) (from-fraction p) k.1 k.2)) w) } ;
    q'-dec (z : EM.ring.R) : Decision (q' z) =
     EM.Q.induction @l (\ z -> Decision (q' z)) (\ z -> decision-prop (q' z) Tr.Trunc[Member z].proposition)
      (\ p -> on-fraction p (q-dec p.1)) z ;
    -- 1 is not in q': move to 1/1
    q'-proper : Not (q' EM.ring.o) = \ w ->
     TC.rec (Member EM.ring.o) @l Empty empty-prop
      (\ k -> refute (q E.o) q-proper (move EM.ring.o (from-fraction (EM.Raw.constantF E.o)) k.1 k.2)) w ;
    -- q' is prime
    prime-left (a c : EM.ring.R) (na : Not (q' a)) (nc : Not (q' c)) (fa : Frac a) (fc : Frac c) :
     Plus (q (numerator a fa)) (q (numerator c fc)) -> Empty = split {
     inl h -> na (Tr.Trunc[Member a].inc (fa,h)) ; inr h -> nc (Tr.Trunc[Member c].inc (fc,h)) } ;
    prime-out (a c : EM.ring.R) (na : Not (q' a)) (nc : Not (q' c)) (fa : Frac a) (fc : Frac c) :
     Plus (Plus (q (numerator a fa)) (q (numerator c fc))) Bot -> Empty = split {
     inl d -> prime-left a c na nc fa fc d ; inr b -> exit b } ;
    neither (a c : EM.ring.R) (h : q' (EM.ring.mul a c)) (na : Not (q' a)) (nc : Not (q' c)) : Empty =
     TC.rec (Member (EM.ring.mul a c)) @l Empty empty-prop (\ k ->
      TC.rec (Frac a) @l Empty empty-prop (\ fa ->
       TC.rec (Frac c) @l Empty empty-prop (\ fc ->
        TC.rec (Plus (q (numerator (EM.ring.mul a c) (frac-times a c fa fc))) Bot) @l Empty empty-prop
         (\ r -> prime-out a c na nc fa fc (q-prime (numerator a fa) (numerator c fc) (settle (q (numerator (EM.ring.mul a c) (frac-times a c fa fc))) r)))
         (move (EM.ring.mul a c) (frac-times a c fa fc) k.1 k.2))
        (fractions c))
       (fractions a))
      h ;
    prime-cases (a c : EM.ring.R) (h : q' (EM.ring.mul a c)) :
     Decision (q' a) -> Decision (q' c) -> Plus (Plus (q' a) (q' c)) Bot = split {
     inl ha -> \ dc -> inl (inl ha) ;
     inr na -> split { inl hc -> inl (inr hc) ; inr nc -> efq (neither a c h na nc) } } ;
    q'-prime (a c : EM.ring.R) (h : q' (EM.ring.mul a c)) : Plus (Plus (q' a) (q' c)) Bot =
     prime-cases a c h (q'-dec a) (q'-dec c) ;
    -- A_M is local, residually discrete
    incompatible (r : L.Carrier) (h : m r) (u : LL.unit r) : Empty =
     q'-proper (subst q'
      (trans (sym (iota'.2.2.2 u.1 r)) (trans (ap iota'.1 (trans (L.ring.mulC u.1 r) u.2)) iota'.2.1))
      (q'-scale (iota'.1 u.1) (iota'.1 r) h)) ;
    local-prop (r : L.Carrier) : Pr.isProp (LocalDecision r) = split {
     inl h -> split { inl h' -> ap (\ x -> inl x) (Tr.Trunc[Member (iota'.1 r)].proposition h h') ; inr u -> efq (incompatible r h u) } ;
     inr u -> split { inl h -> efq (incompatible r h u) ; inr u' -> ap (\ x -> inr x) (AffineRing[l].Laws[L.ring,L.set].unit-prop r u u') } } ;
    on-representative (p : L.Raw.Fraction) : Decision (q (iota.1 p.1)) -> LocalDecision (L.include p) = split {
     inl h -> inl (Tr.Trunc[Member (iota'.1 (L.include p))].inc (frac-of p,h)) ;
     inr n -> inr (unit-of p (outside p.1 n)) } ;
    dec (r : L.Carrier) : LocalDecision r =
     L.Q.induction @l LocalDecision local-prop (\ p -> on-representative p (q-dec (iota.1 p.1))) r ;
    -- the exact regime is an instance of the hit-or-split one (Bot -> Empty makes Bot a proposition)
    module Weak = Mere[\ b b' -> efq (exit b),
     \ a c -> FiniteIntroduction[l].Relative[Bot].elim (q a) (q c) (q (E.mul a c)) (q-prime a c),
     FiniteIntroduction[l].Relative[Bot].negation (q E.o) q-proper,
     \ a -> FiniteIntroduction[l].Relative[Bot].mere-decision (q a) (q-dec a),
     \ a n -> outside a (\ h -> exit (n h))] ;
   } ;
  } ;
 } ;
} ;
-- (6) the canonical instance: M = Strips, strip = the membership itself
module Canonical (A : CRing) (setA : Pr.isSet A.R) (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c))
 (Bot : U l) (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (Plus (q a) (q c)) Bot) {
 module S = Stripping[A,E,iota,q,Bot,q-prime] ;
 module O = Over[A,setA,E,setE,iota,S.Strips,S.one,S.product] ;
 module St = O.Ideal[q,q-zero,q-add,q-scale].Strip[Bot,\ t mt -> mt] ;
 -- hit-or-split: Bot a proposition
 module Mere (bot-prop : Pr.isProp Bot) (q-proper : q E.o -> Bot) (q-dec : (a : E.R) -> Tr.Trunc[Plus (q a) (q a -> Bot)].carrier) {
  module X = St.Mere[bot-prop,\ a c -> FiniteIntroduction[l].Relative[Bot].elim (q a) (q c) (q (E.mul a c)) (q-prime a c),q-proper,q-dec,S.outside] ;
 } ;
 -- exact: an exit from Bot
 module Exact (exit : Bot -> Empty) (q-proper : Not (q E.o)) (q-dec : (a : E.R) -> Plus (q a) (Not (q a))) {
  module X = St.Exact[exit,q-prime,q-proper,q-dec,\ a n -> S.outside a (\ h -> efq (n h))] ;
 } ;
} ;
