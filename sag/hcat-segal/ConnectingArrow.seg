-- The pushout supplies a connecting arrow P -> Sigma C. Its cocone
-- has zero legs and central path the meridian of C, framed by zero-pre.
-- Evaluate a cone against this arrow. ConeCocone and ZeroCocone show
-- that evaluation on the cone of c is sigma(c). On a boundary cone
-- it is a fixed frame around postcomposition of its loop. Evaluation
-- sends the constant boundary to the constant loop, so the two frame
-- legs agree; the frame is a pointed loop map. This identifies the
-- existing direct boundary with that loop map under L and sigma.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Associativity ; open Zero ; open StableNaturality ; open Loops ;
module H = Paths[l] ; module F = PathFrames ;

module Arrow (C B E P : Ob D)
 (i : Hom D C B) (j : Hom D C E) (u : Hom D B P) (v : Hom D E P)
 (s : Id (Hom D C P) (hcomp {D} i u) (hcomp {D} j v))
 (po : DPushout.DSquare[C, B, E, P, i, j, u, v, s].is-pushout) {
 module Q = DPushout.DSquare[C, B, E, P, i, j, u, v, s] ;
 module W = ZeroCocone.Pair[C, B, E, C, susp C, i, j, merid C, id-hom C] ;
 connecting : Hom D P (susp C) = (po (susp C)).sec W.special ;
 connecting-law : Id (Q.Cocone (susp C)) (Q.cocone-map (susp C) connecting) W.special =
  (po (susp C)).sec-eq W.special ;
 opaque connecting ;

 module At (S : Ob D) {
  module M = MayerVietoris.MV[C, B, E, P, i, j, u, v, s, po, S] ;
  module Raw = PointedPullback[l].Boundary[Hom D S B, Hom D S E, Hom D S P,
   \ w -> hcomp {D} w u, \ w -> hcomp {D} w v,
   zmap S B, zmap S E, zmap S P, zero-post S u, zero-post S v] ;
  post (w : Hom D S P) : Hom D S (susp C) = hcomp {D} w connecting ;
  bl : Id (Hom D B (susp C)) (hcomp {D} u connecting) (zmap B (susp C)) = H.apH (\ w -> w.1) connecting-law ;
  br : Id (Hom D E (susp C)) (hcomp {D} v connecting) (zmap E (susp C)) = H.apH (\ w -> w.2.1) connecting-law ;
  al (x : Hom D S B) : Id (Hom D S (susp C)) (hcomp {D} x (hcomp {D} u connecting)) (zmap S (susp C)) =
   H.transH (H.apH (\ w -> hcomp {D} x w) bl) (zero-pre S B (susp C) x) ;
  ar (y : Hom D S E) : Id (Hom D S (susp C)) (hcomp {D} y (hcomp {D} v connecting)) (zmap S (susp C)) =
   H.transH (H.apH (\ w -> hcomp {D} y w) br) (zero-pre S E (susp C) y) ;
  xl (x : Hom D S B) : Id (Hom D S (susp C)) (post (hcomp {D} x u)) (hcomp {D} x (hcomp {D} u connecting)) =
   hcomp-assoc D (S, B, P, susp C, x, u, connecting) ;
  xr (y : Hom D S E) : Id (Hom D S (susp C)) (post (hcomp {D} y v)) (hcomp {D} y (hcomp {D} v connecting)) =
   hcomp-assoc D (S, E, P, susp C, y, v, connecting) ;
  value (w : M.C.Cone S) : LoopOf[S].Om (susp C) =
   F.frame (H.symH (al w.1)) (H.symH (ar w.2.1))
    (H.transH (H.symH (xl w.1)) (H.transH (H.apH post w.2.2) (xr w.2.1))) ;
  on-cone (c : Hom D S C) :
   Id (LoopOf[S].Om (susp C)) (value (M.C.cone-map S c)) (StableLoop.StabLoop[S, C].sigma c) =
   H.transH (H.apH (F.frame (H.symH (al (hcomp {D} c i))) (H.symH (ar (hcomp {D} c j))))
     ConeCocone.Exchange[C, B, E, P, S, susp C, i, j, u, v, s, c, connecting].interchange)
    (H.transH (ZeroCocone.Pair[C, B, E, S, susp C, i, j, merid C, c].transport (Q.cocone-map (susp C) connecting) connecting-law)
     (H.symH (SigmaForm[S, C, c].form))) ;
  left : Id (Hom D S (susp C)) (zmap S (susp C)) (post (zmap S P)) =
   H.transH (H.transH (H.symH (al (zmap S B))) (H.symH (xl (zmap S B)))) (H.apH post (zero-post S u)) ;
  right : Id (Hom D S (susp C)) (zmap S (susp C)) (post (zmap S P)) =
   H.transH (H.transH (H.symH (ar (zmap S E))) (H.symH (xr (zmap S E)))) (H.apH post (zero-post S v)) ;
  on-boundary (q : LoopOf[S].Om P) :
   Id (LoopOf[S].Om (susp C)) (value (Raw.boundary q)) (F.frame left right (H.apH post q)) =
   H.transH (H.apH (F.frame (H.symH (al (zmap S B))) (H.symH (ar (zmap S E))))
     (F.back-frame (xl (zmap S B)) (xr (zmap S E)) (H.apH post (F.frame (zero-post S u) (zero-post S v) q))))
    (H.transH (F.compose (H.symH (al (zmap S B))) (H.symH (ar (zmap S E)))
      (H.symH (xl (zmap S B))) (H.symH (xr (zmap S E))) (H.apH post (F.frame (zero-post S u) (zero-post S v) q)))
     (H.transH (H.apH (F.frame (H.transH (H.symH (al (zmap S B))) (H.symH (xl (zmap S B))))
       (H.transH (H.symH (ar (zmap S E))) (H.symH (xr (zmap S E))))) (F.ap-frame post (zero-post S u) (zero-post S v) q))
      (F.compose (H.transH (H.symH (al (zmap S B))) (H.symH (xl (zmap S B))))
       (H.transH (H.symH (ar (zmap S E))) (H.symH (xr (zmap S E))))
       (H.apH post (zero-post S u)) (H.apH post (zero-post S v)) (H.apH post q)))) ;
  value-point : Id (LoopOf[S].Om (susp C)) (value (Raw.boundary (refl (zmap S P)))) (refl (zmap S (susp C))) =
   H.transH (H.apH value Raw.boundary-zero)
    (H.transH (H.apH value (H.symH ConeZero.Point[C, B, E, P, i, j, u, v, s, S].cone-zero))
     (H.transH (on-cone (zmap S C)) HomologyUnits.SigmaZero[S, C].sigma-zero)) ;
  frame-point : Id (LoopOf[S].Om (susp C)) (F.frame left right (refl (post (zmap S P)))) (refl (zmap S (susp C))) =
   H.transH (H.symH (on-boundary (refl (zmap S P)))) value-point ;
  module Map = Pi0Maps[l].Pointed[Hom D S P, Hom D S (susp C), zmap S P, zmap S (susp C), post, H.symH left] ;
  boundary-linear (q : LoopOf[S].Om P) : Id (LoopOf[S].Om (susp C)) (value (Raw.boundary q)) (Map.loop q) =
   H.transH (on-boundary q) (F.pointed-frame left right frame-point (H.apH post q)) ;
  comparison (g : Hom D (susp S) P) :
   Id (LoopOf[S].Om (susp C)) (StableLoop.StabLoop[S, C].sigma (M.delta g)) (Map.loop (LoopOf[S].L P g)) =
   H.transH (H.symH (on-cone (M.delta g)))
    (H.transH (H.apH value (M.pull.sec-eq (M.delta-cone g))) (boundary-linear (LoopOf[S].L P g))) ;
 } ;
} ;
