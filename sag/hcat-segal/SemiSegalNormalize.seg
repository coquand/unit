-- Normalization is fibrewise equivalence, not a new coherence axiom.
-- A contractible total family represents identity from its selected
-- point (FibreLemmas.IdEquiv). This identifies the raw triangle family
-- with composition paths. For tetrahedra, J on the three given triangle
-- paths reduces to the canonical horn, where assoc-selected supplies
-- the comparison. The normalized tetrahedron family has contractible
-- horn fillers and the same selected missing face; IdEquiv therefore
-- identifies it with the original cell3 family over every full boundary.
open HigherCat ; open Constructions ; open Composition ; open Associativity ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
module B = SemiSegalBoundary3 ; module T = SemiSegalTetrahedra ;

normalized-horn2 (C : Cat) {a b c : Ob C} (f : Hom C a b) (g : Hom C b c) :
 FunExtUA[l].isContr ((h : Hom C a c) * Id (Hom C a c) (hcomp f g) h) =
 ((hcomp f g, refl (hcomp f g)), \ w ->
  idJ (Hom C a c) (hcomp {C} {a} {b} {c} f g)
   (\ v p -> Id ((h : Hom C a c) * Id (Hom C a c) (hcomp {C} {a} {b} {c} f g) h)
    (hcomp {C} {a} {b} {c} f g, refl (hcomp {C} {a} {b} {c} f g)) (v, p))
   (refl (hcomp {C} {a} {b} {c} f g, refl (hcomp {C} {a} {b} {c} f g))) w.1 w.2) ;

triangle-equiv (C : Cat) {a b c : Ob C} (f : Hom C a b) (g : Hom C b c) (h : Hom C a c) :
 Pl.Equiv (Id (Hom C a c) (hcomp f g) h) (cell2 C f g h) =
 (\ p -> H.substH (cell2 C f g) p (triangle f g),
  FibreLemmas.id-equiv-of-contr (Hom C a c) (hcomp f g) (cell2 C f g) (triangle f g) (horn2 C f g) h) ;

selected (C : Cat) (u : B.Horn[C]) : B.Missing C u = (horn3 C u).1.1 ;

module Normalize (C : Cat) (a b c d : Ob C) (f : Hom C a b) (g : Hom C b c) (h : Hom C c d) {
 make (fg : Hom C a c) (gh : Hom C b d) (fgh : Hom C a d)
  (p : Id (Hom C a c) (hcomp f g) fg) (q : Id (Hom C b d) (hcomp g h) gh)
  (r : Id (Hom C a d) (hcomp f gh) fgh) : B.Horn[C] =
  new B.Horn[C, a, b, c, d, f, g, h, fg, gh, fgh, p, q, r] ;

 Goal (fg : Hom C a c) (gh : Hom C b d) (fgh : Hom C a d)
  (p : Id (Hom C a c) (hcomp f g) fg) (q : Id (Hom C b d) (hcomp g h) gh)
  (r : Id (Hom C a d) (hcomp f gh) fgh) : U l =
  T.Cell C (make fg gh fgh p q r) (selected C (make fg gh fgh p q r)) ;

 base : Goal (hcomp f g) (hcomp g h) (hcomp f (hcomp g h))
  (refl (hcomp f g)) (refl (hcomp g h)) (refl (hcomp f (hcomp g h))) =
  H.substH (T.Cell C (B.canonical C f g h)) (assoc-selected C f g h) (T.canonical-cell C f g h) ;

 last (fgh : Hom C a d) (r : Id (Hom C a d) (hcomp f (hcomp g h)) fgh) :
  Goal (hcomp f g) (hcomp g h) fgh (refl (hcomp f g)) (refl (hcomp g h)) r =
  idJ (Hom C a d) (hcomp f (hcomp g h))
   (\ w p -> Goal (hcomp f g) (hcomp g h) w (refl (hcomp f g)) (refl (hcomp g h)) p) base fgh r ;

 Middle (gh : Hom C b d) (q : Id (Hom C b d) (hcomp g h) gh) : U l =
  (fgh : Hom C a d) (r : Id (Hom C a d) (hcomp f gh) fgh) ->
   Goal (hcomp f g) gh fgh (refl (hcomp f g)) q r ;

 middle (gh : Hom C b d) (q : Id (Hom C b d) (hcomp g h) gh) : Middle gh q =
  idJ (Hom C b d) (hcomp g h) Middle last gh q ;

 First (fg : Hom C a c) (p : Id (Hom C a c) (hcomp f g) fg) : U l =
  (gh : Hom C b d) (q : Id (Hom C b d) (hcomp g h) gh)
  (fgh : Hom C a d) (r : Id (Hom C a d) (hcomp f gh) fgh) -> Goal fg gh fgh p q r ;

 first (fg : Hom C a c) (p : Id (Hom C a c) (hcomp f g) fg) : First fg p =
  idJ (Hom C a c) (hcomp f g) First middle fg p ;
} ;

selected-cell (C : Cat) : (u : B.Horn[C]) -> T.Cell C u (selected C u) = split {
 mk a b c d f g h fg gh fgh p q r -> Normalize[C, a, b, c, d, f, g, h].first fg p gh q fgh r } ;

module Compare (C : Cat) (u : B.Horn[C]) {
 module Raw = FibreLemmas.IdEquiv[B.Missing C u, selected C u, cell3 C u, (horn3 C u).1.2, horn3 C u] ;
 module Norm = FibreLemmas.IdEquiv[B.Missing C u, selected C u, T.Cell C u, selected-cell C u, T.contractible C u] ;
 to (s : B.Missing C u) (t : cell3 C u s) : T.Cell C u s = Norm.to s (Raw.from s t) ;
 equiv (s : B.Missing C u) : Pl.isEquiv (cell3 C u s) (T.Cell C u s) (to s) =
  EL.compose (cell3 C u s) (Id (B.Missing C u) (selected C u) s) (T.Cell C u s)
   (Norm.to s) (Raw.from s) (Norm.equiv s)
   (Pl.qinv (cell3 C u s) (Id (B.Missing C u) (selected C u) s) (Raw.from s) (Raw.to s)
    (Raw.from-to s) (Raw.to-from s)) ;
} ;
