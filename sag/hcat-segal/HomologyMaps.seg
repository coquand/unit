-- Homology as a functor on types, on the adopted semi-Segal foundation.
-- Function extensionality makes homotopic maps induce equal maps.
-- Invertibility of tensor maps and pi0-equiv show that every equivalence
-- induces an equivalence on homology. In positive degrees the same map
-- preserves the existing abelian group structure, giving a group
-- isomorphism. The zero class is preserved in every degree, independently
-- of multiplication. HomologyUnits identifies it with the group unit.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open HGroups ; open HGroupMaps ; open Zero ; open Pi0[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PM = Pi0Maps[l] ;
module Fk = Axioms[k].FunExtLemmas[fe @k] ;

homotopy (n : Nat) (A : Ob D) {X Y : U k} (f g : X -> Y)
 (h : (x : X) -> Id Y (f x) (g x)) (q : homology n X A) :
 Id (homology n Y A) (hmap n A f q) (hmap n A g q) =
 H.apH {X -> Y} {homology n Y A} (\ v -> hmap n A v q) (Fk.funext X (\ x -> Y) f g h) ;

equivalence (n : Nat) (A : Ob D) {X Y : U k} (f : X -> Y) (ef : Prelude[k].isEquiv X Y f) :
 Pl.isEquiv (homology n X A) (homology n Y A) (hmap n A f) =
 (pi0-equiv (Hom D (Sph n) (tensor X A)) (Hom D (Sph n) (tensor Y A))
  ((\ w -> hcomp {D} w (TensorMap.tmap A f)), TensorInvariance.tmap-is-inv A f ef (Sph n))).2 ;

positive-isomorphism (n : Nat) (A : Ob D) {X Y : U k} (f : X -> Y) (ef : Prelude[k].isEquiv X Y f) :
 (e : Pl.Equiv (hgrp n X A).G (hgrp n Y A).G) * PM.is-hom (hgrp n X A) (hgrp n Y A) e.1 =
 ((hmap (suc n) A f, equivalence (suc n) A f ef), hmap-mul n A f) ;

zero-class (n : Nat) (X : U k) (A : Ob D) : homology n X A = cls (zmap (Sph n) (tensor X A)) ;

pointed (n : Nat) (A : Ob D) {X Y : U k} (f : X -> Y) :
 Id (homology n Y A) (hmap n A f (zero-class n X A)) (zero-class n Y A) =
 H.transH (pi0-map-cls (Hom D (Sph n) (tensor X A)) (Hom D (Sph n) (tensor Y A))
  (\ w -> hcomp {D} w (TensorMap.tmap A f)) (zmap (Sph n) (tensor X A)))
  (H.apH (\ w -> cls w) (zero-post (Sph n) (TensorMap.tmap A f))) ;

zero-unit (A : Ob D) {X Y : U k} (f : X -> Y) :
 Id (homology zero Y A) (hmap zero A f (hgrp0 X A).e) (hgrp0 Y A).e =
 H.transH (H.apH (hmap zero A f) (HomologyUnits.zero-unit X A))
  (H.transH (pointed zero A f) (H.symH (HomologyUnits.zero-unit Y A))) ;

-- Commutative squares of maps of types give commutative squares on H_n.
square (n : Nat) (A : Ob D) (X Y X1 Y1 : U k)
 (f : X -> Y) (g : X1 -> Y1) (a : X -> X1) (b : Y -> Y1)
 (comm : (x : X) -> Id Y1 (b (f x)) (g (a x))) (q : homology n X A) :
 Id (homology n Y1 A) (hmap n A b (hmap n A f q)) (hmap n A g (hmap n A a q)) =
 H.transH (H.symH (hmap-comp n A f b q))
  (H.transH (homotopy n A (\ x -> b (f x)) (\ x -> g (a x)) comm q) (hmap-comp n A a g q)) ;
