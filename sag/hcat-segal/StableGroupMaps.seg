-- Postcomposition preserves the existing stable group structure,
-- including the one chosen for H_0. StableNaturality supplies the
-- square between sigma and the loop map of postcomposition by susp-map.
-- Descend the square to components, then apply Pi0Maps.Transport.
-- All groups and maps are the original ones; no new axioms or group
-- structures are introduced.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Zero ; open HGroups ; open Pi0[l] ;
module H = Paths[l] ; module PM = Pi0Maps[l] ;

module Post (B E T : Ob D) (f : Hom D E T) {
 module P = StableNaturality.Post[B, susp E, susp T, StableNaturality.susp-map E T f].Map ;
 map : StabGroup[B, E].grp.G -> StabGroup[B, T].grp.G =
  pi0-map (Hom D B E) (Hom D B T) (\ w -> hcomp {D} w f) ;
 square (x : StabGroup[B, E].grp.G) :
  Id LoopGrp[Hom D B (susp T), zmap B (susp T)].grp.G
   (StabGroup[B, T].e.1 (map x)) (P.M.map (StabGroup[B, E].e.1 x)) =
  PM.square (Hom D B E) (Hom D B T)
   (Loops.LoopOf[B].Om (susp E)) (Loops.LoopOf[B].Om (susp T))
   (\ w -> hcomp {D} w f) P.loop StableLoop.StabLoop[B, E].sigma StableLoop.StabLoop[B, T].sigma
   (\ w -> StableNaturality.sigma-natural B E T w f) x ;
 mul : PM.is-hom StabGroup[B, E].grp StabGroup[B, T].grp map =
  PM.Transport[LoopGrp[Hom D B (susp E), zmap B (susp E)].grp,
   LoopGrp[Hom D B (susp T), zmap B (susp T)].grp,
   pi0 (Hom D B E), pi0 (Hom D B T), StabGroup[B, E].e, StabGroup[B, T].e,
   map, P.M.map, P.M.mul, square].mul ;
} ;

hmap-zero-mul (A : Ob D) {X Y : U k} (f : X -> Y) :
 PM.is-hom (hgrp0 X A) (hgrp0 Y A) (HGroupMaps.hmap zero A f) =
 Post[unitD, tensor X A, tensor Y A, TensorMap.tmap A f].mul ;

module ZeroIsomorphism (A : Ob D) (X Y : U k) (f : X -> Y) (ef : Prelude[k].isEquiv X Y f) {
 e : Prelude[l].Equiv (hgrp0 X A).G (hgrp0 Y A).G =
  (HGroupMaps.hmap zero A f, HomologyMaps.equivalence zero A f ef) ;
 hom : PM.is-hom (hgrp0 X A) (hgrp0 Y A) e.1 = hmap-zero-mul A f ;
} ;
