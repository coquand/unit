-- Interchange between precomposition of a cocone and postcomposition
-- of a cone. Normalize both pastings as frames around the same path.
-- Naturality of associativity gives the middle frame; the pentagon on
-- each leg identifies the outer frames. This is the categorical
-- coherence needed for the connecting arrow, proved from hpent.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Associativity ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module F = PathFrames ;

module Leg (S C B P T : Ob D) (c : Hom D S C) (i : Hom D C B) (u : Hom D B P) (g : Hom D P T) {
 a : Id (Hom D S T) (hcomp {D} (hcomp {D} (hcomp {D} c i) u) g) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) = hcomp-assoc D (S, B, P, T, hcomp {D} c i, u, g) ;
 b : Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) (hcomp {D} c (hcomp {D} i (hcomp {D} u g))) = hcomp-assoc D (S, C, B, T, c, i, hcomp {D} u g) ;
 d : Id (Hom D S T) (hcomp {D} (hcomp {D} c (hcomp {D} i u)) g) (hcomp {D} c (hcomp {D} (hcomp {D} i u) g)) = hcomp-assoc D (S, C, P, T, c, hcomp {D} i u, g) ;
 r : Id (Hom D C T) (hcomp {D} (hcomp {D} i u) g) (hcomp {D} i (hcomp {D} u g)) = hcomp-assoc D (C, B, P, T, i, u, g) ;
 p : Id (Hom D S T) (hcomp {D} (hcomp {D} (hcomp {D} c i) u) g) (hcomp {D} (hcomp {D} c (hcomp {D} i u)) g) = H.apH (\ w -> hcomp {D} w g) (hcomp-assoc D (S, C, B, P, c, i, u)) ;
 e : Id (Hom D S T) (hcomp {D} c (hcomp {D} (hcomp {D} i u) g)) (hcomp {D} c (hcomp {D} i (hcomp {D} u g))) = H.apH (\ w -> hcomp {D} c w) r ;
 solved : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) (hcomp {D} (hcomp {D} c (hcomp {D} i u)) g))
  (H.transH (H.transH b (H.symH e)) (H.symH d)) (H.transH (H.symH a) p) = F.pent-leg a b p d e (hpent c i u g) ;
} ;

module Exchange (C B E P S T : Ob D)
 (i : Hom D C B) (j : Hom D C E) (u : Hom D B P) (v : Hom D E P)
 (s : Id (Hom D C P) (hcomp {D} i u) (hcomp {D} j v))
 (c : Hom D S C) (g : Hom D P T) {
 module Q = DPushout.DSquare[C, B, E, P, i, j, u, v, s] ;
 module K = Cone.DCone[C, B, E, P, i, j, u, v, s] ;
 module Left = Leg[S, C, B, P, T, c, i, u, g] ;
 module Right = Leg[S, C, E, P, T, c, j, v, g] ;
 pre (w : Hom D C T) : Hom D S T = hcomp {D} c w ;
 post (w : Hom D S P) : Hom D S T = hcomp {D} w g ;
 middle : Id (Hom D S T) (hcomp {D} (hcomp {D} c (hcomp {D} i u)) g) (hcomp {D} (hcomp {D} c (hcomp {D} j v)) g) = H.apH post (H.apH (\ w -> hcomp {D} c w) s) ;
 left : Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) (hcomp {D} (hcomp {D} c j) (hcomp {D} v g)) = H.transH (H.symH Left.a) (H.transH (H.apH post (K.cone-path S c)) Right.a) ;
 right : Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) (hcomp {D} (hcomp {D} c j) (hcomp {D} v g)) = F.frame Left.b Right.b (H.apH pre (Q.cocone-path T g)) ;
 common : Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) (hcomp {D} (hcomp {D} c j) (hcomp {D} v g)) = F.frame (H.transH (H.symH Left.a) Left.p) (H.transH (H.symH Right.a) Right.p) middle ;
 left-common : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) (hcomp {D} (hcomp {D} c j) (hcomp {D} v g))) left common =
  H.transH (F.back-frame Left.a Right.a (H.apH post (K.cone-path S c)))
   (H.transH (H.apH (F.frame (H.symH Left.a) (H.symH Right.a))
    (F.ap-frame post (hcomp-assoc D (S, C, B, P, c, i, u)) (hcomp-assoc D (S, C, E, P, c, j, v))
     (H.apH (\ w -> hcomp {D} c w) s)))
    (F.compose (H.symH Left.a) (H.symH Right.a) Left.p Right.p middle)) ;
 middle-form : Id (Id (Hom D S T) (hcomp {D} c (hcomp {D} (hcomp {D} i u) g)) (hcomp {D} c (hcomp {D} (hcomp {D} j v) g)))
  (H.apH pre (H.apH (\ w -> hcomp {D} w g) s)) (F.frame (H.symH Left.d) (H.symH Right.d) middle) =
  H.transH (AssocNat.assoc-nat-m D c (hcomp {D} i u) (hcomp {D} j v) s g)
   (F.back-frame Left.d Right.d middle) ;
 right-common : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) (hcomp {D} (hcomp {D} c j) (hcomp {D} v g))) right common =
  H.transH (H.apH (F.frame Left.b Right.b) (F.ap-back pre Left.r Right.r (H.apH (\ w -> hcomp {D} w g) s)))
   (H.transH (F.compose Left.b Right.b (H.symH Left.e) (H.symH Right.e) (H.apH pre (H.apH (\ w -> hcomp {D} w g) s)))
    (H.transH (H.apH (F.frame (H.transH Left.b (H.symH Left.e)) (H.transH Right.b (H.symH Right.e))) middle-form)
     (H.transH (F.compose (H.transH Left.b (H.symH Left.e)) (H.transH Right.b (H.symH Right.e)) (H.symH Left.d) (H.symH Right.d) middle)
      (H.transH (H.apH (\ w -> F.frame w (H.transH (H.transH Right.b (H.symH Right.e)) (H.symH Right.d)) middle) Left.solved)
       (H.apH (\ w -> F.frame (H.transH (H.symH Left.a) Left.p) w middle) Right.solved))))) ;
 interchange : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (hcomp {D} u g)) (hcomp {D} (hcomp {D} c j) (hcomp {D} v g))) left right =
  H.transH left-common (H.symH right-common) ;
} ;
