-- Lambda^4_1 as a finite dependent record: five vertices, ten edges,
-- ten triangles and four tetrahedra. The missing face is 0234.
-- No pentagon equation occurs among the input fields.
open HigherCat ; open Constructions ; open Composition ;
module T = SemiSegalTetrahedra ;

record Horn (C : Cat) {
 x0 : Ob C ; x1 : Ob C ; x2 : Ob C ; x3 : Ob C ; x4 : Ob C ;
 e01 : Hom C x0 x1 ; e12 : Hom C x1 x2 ; e23 : Hom C x2 x3 ; e34 : Hom C x3 x4 ;
 e02 : Hom C x0 x2 ; e13 : Hom C x1 x3 ; e24 : Hom C x2 x4 ;
 e03 : Hom C x0 x3 ; e14 : Hom C x1 x4 ; e04 : Hom C x0 x4 ;
 q012 : Id (Hom C x0 x2) (hcomp e01 e12) e02 ;
 q123 : Id (Hom C x1 x3) (hcomp e12 e23) e13 ;
 q234 : Id (Hom C x2 x4) (hcomp e23 e34) e24 ;
 q013 : Id (Hom C x0 x3) (hcomp e01 e13) e03 ;
 q124 : Id (Hom C x1 x4) (hcomp e12 e24) e14 ;
 q014 : Id (Hom C x0 x4) (hcomp e01 e14) e04 ;
 q023 : Id (Hom C x0 x3) (hcomp e02 e23) e03 ;
 q134 : Id (Hom C x1 x4) (hcomp e13 e34) e14 ;
 q024 : Id (Hom C x0 x4) (hcomp e02 e24) e04 ;
 q034 : Id (Hom C x0 x4) (hcomp e03 e34) e04 ;
 t0123 : T.Face[C, x0, x1, x2, x3, e01, e12, e23, e02, e13, e03, q012, q123, q013].Cell q023 ;
 t1234 : T.Face[C, x1, x2, x3, x4, e12, e23, e34, e13, e24, e14, q123, q234, q124].Cell q134 ;
 t0124 : T.Face[C, x0, x1, x2, x4, e01, e12, e24, e02, e14, e04, q012, q124, q014].Cell q024 ;
 t0134 : T.Face[C, x0, x1, x3, x4, e01, e13, e34, e03, e14, e04, q013, q134, q014].Cell q034 ;
} ;

Missing (C : Cat) (h : Horn[C]) : U l =
 T.Face[C, h.x0, h.x2, h.x3, h.x4, h.e02, h.e23, h.e34, h.e03, h.e24, h.e04, h.q023, h.q234, h.q024].Cell h.q034 ;
