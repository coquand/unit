-- Pair a map c:S->C with a cocone whose two legs are zero and whose
-- central path is a loop m at zero:C->T. Normalizing the outer legs
-- gives pointed precomposition of m by c. ZeroPreCoherence identifies
-- the two conjugating paths. Identity elimination extends the formula
-- to any cocone equipped with a path to this chosen zero cocone.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Associativity ; open Zero ; open StableNaturality ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module F = PathFrames ;

module Pair (C B E S T : Ob D) (i : Hom D C B) (j : Hom D C E)
 (m : Id (Hom D C T) (zmap C T) (zmap C T)) (c : Hom D S C) {
 module Q = PullbackPaths[l].Pull[Hom D B T, Hom D E T, Hom D C T,
  \ w -> hcomp {D} i w, \ w -> hcomp {D} j w] ;
 special : Q.Cone = (zmap B T, zmap E T, F.frame (zero-pre C B T i) (zero-pre C E T j) m) ;
 right (w : Q.Cone) : Id (Hom D S T) (hcomp {D} (hcomp {D} c i) w.1) (hcomp {D} (hcomp {D} c j) w.2.1) =
  F.frame (hcomp-assoc D (S, C, B, T, c, i, w.1)) (hcomp-assoc D (S, C, E, T, c, j, w.2.1))
   (H.apH (\ t -> hcomp {D} c t) w.2.2) ;
 loop : Id (Hom D S T) (zmap S T) (zmap S T) = Pre[S, C, T, c].Map.loop m ;
 left-path : Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (zmap B T)) (hcomp {D} c (zmap C T)) =
  H.transH (hcomp-assoc D (S, C, B, T, c, i, zmap B T)) (H.apH (\ t -> hcomp {D} c t) (zero-pre C B T i)) ;
 right-path : Id (Hom D S T) (hcomp {D} (hcomp {D} c j) (zmap E T)) (hcomp {D} c (zmap C T)) =
  H.transH (hcomp-assoc D (S, C, E, T, c, j, zmap E T)) (H.apH (\ t -> hcomp {D} c t) (zero-pre C E T j)) ;
 left-coherence : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (zmap B T)) (zmap S T))
  (H.transH left-path (zero-pre S C T c)) (zero-pre S B T (hcomp {D} c i)) =
  H.transH (PA.tassoc (hcomp-assoc D (S, C, B, T, c, i, zmap B T))
   (H.apH (\ t -> hcomp {D} c t) (zero-pre C B T i)) (zero-pre S C T c)) ZeroPreCoherence.Compose[S, C, B, T, c, i].coherence ;
 right-coherence : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c j) (zmap E T)) (zmap S T))
  (H.transH right-path (zero-pre S C T c)) (zero-pre S E T (hcomp {D} c j)) =
  H.transH (PA.tassoc (hcomp-assoc D (S, C, E, T, c, j, zmap E T))
   (H.apH (\ t -> hcomp {D} c t) (zero-pre C E T j)) (zero-pre S C T c)) ZeroPreCoherence.Compose[S, C, E, T, c, j].coherence ;
 raw : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (zmap B T)) (hcomp {D} (hcomp {D} c j) (zmap E T)))
  (right special) (F.frame left-path right-path (H.apH (\ t -> hcomp {D} c t) m)) =
  H.transH (H.apH (F.frame (hcomp-assoc D (S, C, B, T, c, i, zmap B T)) (hcomp-assoc D (S, C, E, T, c, j, zmap E T)))
   (F.ap-frame (\ t -> hcomp {D} c t) (zero-pre C B T i) (zero-pre C E T j) m))
   (F.compose (hcomp-assoc D (S, C, B, T, c, i, zmap B T)) (hcomp-assoc D (S, C, E, T, c, j, zmap E T))
    (H.apH (\ t -> hcomp {D} c t) (zero-pre C B T i)) (H.apH (\ t -> hcomp {D} c t) (zero-pre C E T j)) (H.apH (\ t -> hcomp {D} c t) m)) ;
 framed-loop : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (zmap B T)) (hcomp {D} (hcomp {D} c j) (zmap E T)))
  (F.frame (zero-pre S B T (hcomp {D} c i)) (zero-pre S E T (hcomp {D} c j)) loop) (right special) =
  H.transH (H.apH (\ w -> F.frame w (zero-pre S E T (hcomp {D} c j)) loop) (H.symH left-coherence))
   (H.transH (H.apH (\ w -> F.frame (H.transH left-path (zero-pre S C T c)) w loop) (H.symH right-coherence))
    (H.transH (H.symH (F.compose left-path right-path (zero-pre S C T c) (zero-pre S C T c) loop))
     (H.transH (H.apH (F.frame left-path right-path)
       (H.transH (H.apH (F.frame (zero-pre S C T c) (zero-pre S C T c))
         (F.back-frame (zero-pre S C T c) (zero-pre S C T c) (H.apH (\ t -> hcomp {D} c t) m)))
        (F.redo (zero-pre S C T c) (zero-pre S C T c) (H.apH (\ t -> hcomp {D} c t) m))))
      (H.symH raw)))) ;
 normalized : Id (Id (Hom D S T) (zmap S T) (zmap S T))
  (F.frame (H.symH (zero-pre S B T (hcomp {D} c i))) (H.symH (zero-pre S E T (hcomp {D} c j))) (right special)) loop =
  H.transH (H.apH (F.frame (H.symH (zero-pre S B T (hcomp {D} c i))) (H.symH (zero-pre S E T (hcomp {D} c j)))) (H.symH framed-loop))
   (F.undo (zero-pre S B T (hcomp {D} c i)) (zero-pre S E T (hcomp {D} c j)) loop) ;

 lp (w : Q.Cone) (p : Id Q.Cone w special) : Id (Hom D S T) (hcomp {D} (hcomp {D} c i) w.1) (zmap S T) =
  H.transH (H.apH (\ t -> hcomp {D} (hcomp {D} c i) t) (H.apH (\ t -> t.1) p)) (zero-pre S B T (hcomp {D} c i)) ;
 rp (w : Q.Cone) (p : Id Q.Cone w special) : Id (Hom D S T) (hcomp {D} (hcomp {D} c j) w.2.1) (zmap S T) =
  H.transH (H.apH (\ t -> hcomp {D} (hcomp {D} c j) t) (H.apH (\ t -> t.2.1) p)) (zero-pre S E T (hcomp {D} c j)) ;
 transport (w : Q.Cone) (p : Id Q.Cone w special) :
  Id (Id (Hom D S T) (zmap S T) (zmap S T))
   (F.frame (H.symH (lp w p)) (H.symH (rp w p)) (right w)) loop =
  H.idJR Q.Cone special (\ w1 p1 -> Id (Id (Hom D S T) (zmap S T) (zmap S T))
   (F.frame (H.symH (lp w1 p1)) (H.symH (rp w1 p1)) (right w1)) loop)
   (H.transH (H.apH (\ t -> F.frame (H.symH t) (H.symH (rp special (refl special))) (right special)) (PA.unit-l (zero-pre S B T (hcomp {D} c i))))
    (H.transH (H.apH (\ t -> F.frame (H.symH (zero-pre S B T (hcomp {D} c i))) (H.symH t) (right special)) (PA.unit-l (zero-pre S E T (hcomp {D} c j)))) normalized)) w p ;
} ;
