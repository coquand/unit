-- Homology on the adopted finite internal semi-Segal foundation.
-- Composition and associativity are selected from horn fillers. The
-- fourth-dimensional horn condition will supply the pentagon.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ; import Replacement ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 import EquivalenceLemmas ; import Equivalences ; import EquivProp ;
 import PathAlgebra ; import Cayley ; import GroupoidWords ; import PathMoves ; import AffineHLevels ; import Finite ; import EquivAp ;
 import Truncation ; import Conj ; import PullbackPaths ; import PullbackBoundary ; import PointedPullback ; import PullbackNaturality ; import PointedBoundaryNaturality ;
 import Torsor ; import TruncationCombinators ; import Quotient ; import Group ; import QGrp ; import Pi0 ; import Pi0Maps ; import AbelianDifference ; import Pi1Product ; import PullbackExact ;
 module SemiSegal {
  level l ;
  Cat : U l+ ;
  objects (C : Cat) : U l ;
  arrows (C : Cat) (a b : objects C) : U l ;
  identities (C : Cat) (a : objects C) : arrows C a a ;
  import HigherCat ; import Constructions ;
  cell2 (C : Cat) {a b c : HigherCat.Ob C}
   (f : Constructions.Hom C a b) (g : Constructions.Hom C b c) (h : Constructions.Hom C a c) : U l ;
  horn2 (C : Cat) {a b c : HigherCat.Ob C}
   (f : Constructions.Hom C a b) (g : Constructions.Hom C b c) :
   FunExtUA[l].isContr ((h : Constructions.Hom C a c) * cell2 C f g h) ;
  import Composition ; import SemiSegalBoundary3 ;
  cell3 (C : Cat) (h : SemiSegalBoundary3.Horn[C]) (q : SemiSegalBoundary3.Missing C h) : U l ;
  horn3 (C : Cat) (h : SemiSegalBoundary3.Horn[C]) :
   FunExtUA[l].isContr ((q : SemiSegalBoundary3.Missing C h) * cell3 C h q) ;
  import Associativity ; import FibreLemmas ; import SigmaEquiv ; import SemiSegalTetrahedra ; import SemiSegalNormalize ; import SemiSegalBoundary4 ;
  cell4 (C : Cat) (h : SemiSegalBoundary4.Horn[C]) (q : SemiSegalBoundary4.Missing C h) : U l ;
  horn4 (C : Cat) (h : SemiSegalBoundary4.Horn[C]) :
   FunExtUA[l].isContr ((q : SemiSegalBoundary4.Missing C h) * cell4 C h q) ;
  import HcompPentagon ; import SemiSegalPentagon ;
  unit-left (C : Cat) {a b : HigherCat.Ob C} (f : Constructions.Hom C a b) : cell2 C (Constructions.id-hom a) f f ;
  unit-right (C : Cat) {a b : HigherCat.Ob C} (f : Constructions.Hom C a b) : cell2 C f (Constructions.id-hom b) f ;
  import CompLaws ; import AssocNat ; import CompWitness ; import PathFrames ;
  import InternalInverse ;
  module Invertible = InternalInverse ; module FullyFaithful = InternalInverse ;
  import UniversalWitness ; import WitnessTransport ;
  import FibreAlg ; import FibreInclusion ; import FibreSequence ; import FibreTower ; import FibreTowerMaps ; import FibreTowerNaturality ; import CommutingLoops ; import PointedEquivalence ; import PullbackFibre ; import EckmannHilton ; import LoopDifference ; import LoopProduct ; import PullbackSource ; import PullbackDifference ;
    module Homology {
     level k ; constraint k < l ;
     D : Cat ;
     tensor (X : U k) (A : HigherCat.Ob D) : HigherCat.Ob D ;
     eta (X : U k) (A : HigherCat.Ob D) (x : X) : Constructions.Hom D A (tensor X A) ;
     import CopowerRestrict ;
     tensor-up (X : U k) (A T : HigherCat.Ob D) :
      Prelude[l].isEquiv (Constructions.Hom D (tensor X A) T) (X -> Constructions.Hom D A T) (CopowerRestrict.restrict X A T) ;
     import Copower ; import TensorMap ; import CopowerWitness ; import CopowerPost ; import TensorInvariance ; import TensorSum ; import Fubini ;
     import ExcCoreAlg ; import TypePushout ; import DPushout ;
     -- The same homology API, with the pentagon now a derived definition.
     module WithPentagon {
      hpent {a b c d e : HigherCat.Ob D} (f1 : Constructions.Hom D a b) (f2 : Constructions.Hom D b c) (f3 : Constructions.Hom D c d) (f4 : Constructions.Hom D d e) : HcompPentagon.Pentagon D f1 f2 f3 f4 =
       SemiSegalPentagon.pentagon D f1 f2 f3 f4 ;
      import ExcisionAssoc ; import Excision ;
      -- pointed and stable D (DESIGN-HOMOLOGY.md, H4): a zero object,
      -- suspensions (pushouts 0 <- B -> 0), and stability: Hom (S, -) sends
      -- pushout squares to pullbacks of types
      module Stable {
       zobj : HigherCat.Ob D ;
       zero-init (T : HigherCat.Ob D) : FunExtUA[l].isContr (Constructions.Hom D zobj T) ;
       zero-term (T : HigherCat.Ob D) : FunExtUA[l].isContr (Constructions.Hom D T zobj) ;
       import Zero ;
       susp (B : HigherCat.Ob D) : HigherCat.Ob D ;
       merid (B : HigherCat.Ob D) : Id (Constructions.Hom D B (susp B)) (Zero.zmap B (susp B)) (Zero.zmap B (susp B)) ;
       susp-po (B : HigherCat.Ob D) :
        DPushout.DSquare[B, zobj, zobj, susp B, Zero.zt B, Zero.zt B, Zero.zi (susp B), Zero.zi (susp B), merid B].is-pushout ;
       import Cone ;
       stable (Cc Bb Ee P : HigherCat.Ob D) (ii : Constructions.Hom D Cc Bb) (jj : Constructions.Hom D Cc Ee)
        (uu : Constructions.Hom D Bb P) (vv : Constructions.Hom D Ee P)
        (ss : Id (Constructions.Hom D Cc P) (Composition.hcomp {D} ii uu) (Composition.hcomp {D} jj vv))
        (po : DPushout.DSquare[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pushout) :
        Cone.DCone[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pullback ;
       -- the unit object 1: homology n X A = Pi0 Hom (Sigma^n 1, X (x) A)
       unitD : HigherCat.Ob D ;
       import Loops ; import ZeroCoherence ; import ConeZero ; import StableLoop ; import HGroups ; import HomologyUnits ; import StableNaturality ; import ConeCocone ; import ZeroPreCoherence ; import ZeroCocone ; import PostSquare ; import HGroupMaps ; import HomologyMaps ; import StableGroupMaps ; import HomologyDouble ; import MayerVietoris ; import ConnectingArrow ; import BoundaryAdditivity ; import MayerVietorisNaturality ; import MayerVietorisExact ; import MayerVietorisLoop ; import HomologyFibre ; import BoundaryLoopComparison ; import BoundaryNaturality ; import HomologyFibreLegs ; import HomologyFibreSource ; import HomologyFibreExact ; import HomologySequence ; import MayerVietorisTail ; import MayerVietorisZeroGroups ; import Suspension ;
       module WithSpheres {
        tsusp (X : U k) : U k ;
        tnorth (X : U k) : tsusp X ;
        tsouth (X : U k) : tsusp X ;
        tmerid (X : U k) (x : X) : Id (tsusp X) (tnorth X) (tsouth X) ;
        tsusp-po (X : U k) : Suspension.is-suspension X (tsusp X) (tnorth X) (tsouth X) (tmerid X) ;
        desusp (B : HigherCat.Ob D) : HigherCat.Ob D ;
        desusp-eq (B : HigherCat.Ob D) : Id (HigherCat.Ob D) (susp (desusp B)) B ;
        import Spheres ;
       } ;
      } ;
     } ;
    } ;
 } ;
} ;
