-- Fill the canonical Lambda^3_1 horn. Its missing triangle is exactly
-- (f g) h = f (g h), so the associator is a projection of its filler.
-- This definition does not refer to the old hcat associator.
open HigherCat ; open Constructions ; open Composition ;

Quad (C : Cat) : U l = (a : Ob C) * (b : Ob C) * (c : Ob C) * (d : Ob C) * Hom C a b * Hom C b c * Hom C c d ;

assoc-lhs (C : Cat) (q : Quad C) : Hom C q.1 q.2.2.2.1 = hcomp (hcomp q.2.2.2.2.1 q.2.2.2.2.2.1) q.2.2.2.2.2.2 ;
assoc-rhs (C : Cat) (q : Quad C) : Hom C q.1 q.2.2.2.1 = hcomp q.2.2.2.2.1 (hcomp q.2.2.2.2.2.1 q.2.2.2.2.2.2) ;

hcomp-assoc (C : Cat) (q : Quad C) : Id (Hom C q.1 q.2.2.2.1) (assoc-lhs C q) (assoc-rhs C q) =
 (horn3 C (SemiSegalBoundary3.canonical C q.2.2.2.2.1 q.2.2.2.2.2.1 q.2.2.2.2.2.2)).1.1 ;

assoc-selected (C : Cat) {a b c d : Ob C} (f : Hom C a b) (g : Hom C b c) (h : Hom C c d) :
 Id (Id (Hom C a d) (hcomp (hcomp f g) h) (hcomp f (hcomp g h)))
  (hcomp-assoc C (a, b, c, d, f, g, h)) (horn3 C (SemiSegalBoundary3.canonical C f g h)).1.1 =
 refl (hcomp-assoc C (a, b, c, d, f, g, h)) ;

opaque hcomp-assoc ;
