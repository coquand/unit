-- Extend the positive-degree Mayer-Vietoris sequence to degree zero.
-- The final connecting map is the direct boundary at S=unitD. Its
-- incoming difference is definitionally the degree-one difference of
-- HomologySequence. MayerVietorisExact gives exactness at H_1(X), and
-- MayerVietoris gives exactness at H_0(C) and the equalizer assertion at
-- H_0(B)*H_0(E). These concern ONE map H_1(X)->H_0(C).
-- This file gives pointed-set exactness. MayerVietorisZeroGroups adds
-- homomorphism laws for these same maps, including this boundary.
open Base ; open HigherCat ; open Constructions ; open HGroups ; open HGroupMaps ;
module H = Paths[l] ; module Pl = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Types (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) {
 module Positive = HomologySequence.Types[B, C, E, X, i, j, u, v, h, A, po] ;
 module Ex = Excision.ExcisionOf[B, C, E, X, i, j, u, v, h, A] ;
 module M = MayerVietoris.MV[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, unitD] ;
 module Q = MayerVietorisExact.Exact[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, unitD] ;
 module P1 = Positive.Degree[zero] ;

 delta (q : homology (suc zero) X A) : homology zero C A = M.delta0 q ;
 product0 : U l = homology zero B A * homology zero E A ;
 inclusion (c : homology zero C A) : product0 = (hmap zero A i c, hmap zero A j c) ;
 product-point : product0 = (HomologyMaps.zero-class zero B A, HomologyMaps.zero-class zero E A) ;

 delta-point : Id (homology zero C A) (delta (HomologyMaps.zero-class (suc zero) X A)) (HomologyMaps.zero-class zero C A) =
  Q.delta-point ;
 inclusion-point : Id product0 (inclusion (HomologyMaps.zero-class zero C A)) product-point =
  EquivAp[l].pair-path (HomologyMaps.pointed zero A i) (HomologyMaps.pointed zero A j) ;

 adjacent (t : P1.Product.grp.G) :
  Id (homology (suc zero) X A) (Q.difference t.1 t.2) (P1.difference t) = refl (P1.difference t) ;
 source-zero (t : P1.Product.grp.G) :
  Id (homology zero C A) (delta (P1.difference t)) (HomologyMaps.zero-class zero C A) = Q.difference-zero t.1 t.2 ;

 SourceImage (q : homology (suc zero) X A) : U l =
  Tr.Trunc[(t : P1.Product.grp.G) * Id (homology (suc zero) X A) (P1.difference t) q].carrier ;
 source-exact (q : homology (suc zero) X A)
  (p : Id (homology zero C A) (delta q) (HomologyMaps.zero-class zero C A)) : SourceImage q =
  TC.map ((b : (hgrp zero B A).G) * (e : (hgrp zero E A).G) * Id (homology (suc zero) X A) (Q.difference b e) q)
   ((t : P1.Product.grp.G) * Id (homology (suc zero) X A) (P1.difference t) q)
   (\ w -> ((w.1, w.2.1), w.2.2)) (Q.exact-p q p) ;

 target-zero (q : homology (suc zero) X A) : Id product0 (inclusion (delta q)) product-point =
  EquivAp[l].pair-path (M.delta-zero q).1 (M.delta-zero q).2 ;
 TargetImage (c : homology zero C A) : U l =
  Tr.Trunc[(q : homology (suc zero) X A) * Id (homology zero C A) (delta q) c].carrier ;
 target-exact (c : homology zero C A) (p : Id product0 (inclusion c) product-point) : TargetImage c =
  M.exact-c c (H.apH (\ w -> w.1) p) (H.apH (\ w -> w.2) p) ;

 -- Degree zero ends in the two maps u_* pr1 and v_* pr2, whose
 -- equalizer is the image of inclusion. No unproved difference law.
 left (t : product0) : homology zero X A = hmap zero A u t.1 ;
 right (t : product0) : homology zero X A = hmap zero A v t.2 ;
 product-comm (c : homology zero C A) : Id (homology zero X A) (left (inclusion c)) (right (inclusion c)) = M.mv-square c ;
 ProductImage (t : product0) : U l = Tr.Trunc[(c : homology zero C A) * Id product0 (inclusion c) t].carrier ;
 product-exact (t : product0) (p : Id (homology zero X A) (left t) (right t)) : ProductImage t =
  TC.map ((c : homology zero C A) * Id (homology zero B A) (hmap zero A i c) t.1 * Id (homology zero E A) (hmap zero A j c) t.2)
   ((c : homology zero C A) * Id product0 (inclusion c) t)
   (\ w -> (w.1, EquivAp[l].pair-path w.2.1 w.2.2)) (M.exact-mid t.1 t.2 p) ;
} ;
