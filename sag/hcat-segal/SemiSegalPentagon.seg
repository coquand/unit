-- Fill the canonical Lambda^4_1 horn. Its four given tetrahedra are
-- reflexive-composition instances of the selected associator. Reading
-- the missing tetrahedron gives the pentagon with the long path
-- right-associated; path associativity puts it in the existing API.
-- This proves the pentagon. There is no hpent or k5 parameter here.
open HigherCat ; open Constructions ; open Composition ; open Associativity ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module B = SemiSegalBoundary4 ;

module Four (C : Cat) (a b c d e : Ob C)
 (f : Hom C a b) (g : Hom C b c) (h : Hom C c d) (k : Hom C d e) {
 fg : Hom C a c = hcomp f g ; gh : Hom C b d = hcomp g h ; hk : Hom C c e = hcomp h k ;
 fgh : Hom C a d = hcomp f gh ; ghk : Hom C b e = hcomp g hk ; fghk : Hom C a e = hcomp f ghk ;
 a123 : Id (Hom C a d) (hcomp fg h) fgh = hcomp-assoc C (a, b, c, d, f, g, h) ;
 a234 : Id (Hom C b e) (hcomp gh k) ghk = hcomp-assoc C (b, c, d, e, g, h, k) ;
 a124 : Id (Hom C a e) (hcomp fg hk) fghk = hcomp-assoc C (a, b, c, e, f, g, hk) ;
 a134 : Id (Hom C a e) (hcomp fgh k) (hcomp f (hcomp gh k)) = hcomp-assoc C (a, b, d, e, f, gh, k) ;
 a0234 : Id (Hom C a e) (hcomp (hcomp fg h) k) (hcomp fg hk) = hcomp-assoc C (a, c, d, e, fg, h, k) ;
 whisker-left : Id (Hom C a e) (hcomp (hcomp fg h) k) (hcomp fgh k) = H.apH (\ u -> hcomp u k) a123 ;
 whisker-right : Id (Hom C a e) (hcomp f (hcomp gh k)) fghk = H.apH (\ u -> hcomp f u) a234 ;
 q034 : Id (Hom C a e) (hcomp fgh k) fghk = H.transH a134 whisker-right ;

 boundary : B.Horn[C] = new B.Horn[C, a, b, c, d, e, f, g, h, k, fg, gh, hk, fgh, ghk, fghk,
  refl fg, refl gh, refl hk, refl fgh, refl ghk, refl fghk, a123, a234, a124, q034,
  PA.unit-l a123, PA.unit-l a234, PA.unit-l a124, PA.unit-l q034] ;

 missing : B.Missing C boundary = (horn4 C boundary).1.1 ;

 pentagon : HcompPentagon.Pentagon C f g h k =
  H.transH (H.symH missing) (H.symH (PA.tassoc whisker-left a134 whisker-right)) ;
} ;

pentagon (C : Cat) {a b c d e : Ob C} (f : Hom C a b) (g : Hom C b c) (h : Hom C c d) (k : Hom C d e) :
 HcompPentagon.Pentagon C f g h k = Four[C, a, b, c, d, e, f, g, h, k].pentagon ;
