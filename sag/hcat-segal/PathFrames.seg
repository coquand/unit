-- Frames around paths, for the interchange of cones and cocones.
-- A frame a,b sends q to a.q.b^-1. Frames compose, commute with ap,
-- and are injective. The last lemma solves a pentagon-shaped equality
-- for the path obtained by cancelling its last two edges.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;

frame {Z : U l} {x y u v : Z} (a : Id Z x u) (b : Id Z y v) (q : Id Z u v) : Id Z x y =
 H.transH a (H.transH q (H.symH b)) ;

back-frame {Z : U l} {x y u v : Z} (a : Id Z x u) (b : Id Z y v) (q : Id Z x y) :
 Id (Id Z u v) (H.transH (H.symH a) (H.transH q b)) (frame (H.symH a) (H.symH b) q) =
 H.apH (\ w -> H.transH (H.symH a) (H.transH q w)) (H.symH (PA.sym-sym b)) ;

compose {Z : U l} {x y u v r s : Z} (a : Id Z x u) (b : Id Z y v)
 (c : Id Z u r) (d : Id Z v s) (q : Id Z r s) :
 Id (Id Z x y) (frame a b (frame c d q)) (frame (H.transH a c) (H.transH b d) q) =
 H.transH (H.apH (\ w -> H.transH a w) (PA.tassoc c (H.transH q (H.symH d)) (H.symH b)))
  (H.transH (H.apH (\ w -> H.transH a (H.transH c w)) (PA.tassoc q (H.symH d) (H.symH b)))
   (H.transH (H.symH (PA.tassoc a c (H.transH q (H.transH (H.symH d) (H.symH b)))))
    (H.apH (\ w -> H.transH (H.transH a c) (H.transH q w)) (H.symH (PA.sym-trans b d))))) ;

ap-frame {Z W : U l} (f : Z -> W) {x y u v : Z}
 (a : Id Z x u) (b : Id Z y v) (q : Id Z u v) :
 Id (Id W (f x) (f y)) (H.apH f (frame a b q)) (frame (H.apH f a) (H.apH f b) (H.apH f q)) =
 H.transH (PA.ap-trans f a (H.transH q (H.symH b)))
  (H.apH (\ w -> H.transH (H.apH f a) w)
   (H.transH (PA.ap-trans f q (H.symH b))
    (H.apH (\ w -> H.transH (H.apH f q) w) (PA.ap-sym f b)))) ;

ap-back {Z W : U l} (f : Z -> W) {x y u v : Z}
 (a : Id Z x u) (b : Id Z y v) (q : Id Z x y) :
 Id (Id W (f u) (f v)) (H.apH f (H.transH (H.symH a) (H.transH q b)))
  (frame (H.symH (H.apH f a)) (H.symH (H.apH f b)) (H.apH f q)) =
 H.transH (H.apH (\ w -> H.apH f w) (back-frame a b q))
  (H.transH (ap-frame f (H.symH a) (H.symH b) q)
   (H.transH (H.apH (\ w -> frame w (H.apH f (H.symH b)) (H.apH f q)) (PA.ap-sym f a))
    (H.apH (\ w -> frame (H.symH (H.apH f a)) w (H.apH f q)) (PA.ap-sym f b)))) ;

undo {Z : U l} {x y u v : Z} (a : Id Z x u) (b : Id Z y v) (q : Id Z u v) :
 Id (Id Z u v) (frame (H.symH a) (H.symH b) (frame a b q)) q =
 H.transH (compose (H.symH a) (H.symH b) a b q)
  (H.transH (H.apH (\ w -> frame w (H.transH (H.symH b) b) q) (PA.inv-l a))
   (H.transH (H.apH (\ w -> frame (refl u) w q) (PA.inv-l b)) (PA.unit-l q))) ;

redo {Z : U l} {x y u v : Z} (a : Id Z x u) (b : Id Z y v) (q : Id Z x y) :
 Id (Id Z x y) (frame a b (frame (H.symH a) (H.symH b) q)) q =
 H.transH (compose a b (H.symH a) (H.symH b) q)
  (H.transH (H.apH (\ w -> frame w (H.transH b (H.symH b)) q) (PA.inv-r a))
   (H.transH (H.apH (\ w -> frame (refl x) w q) (PA.inv-r b)) (PA.unit-l q))) ;

injective {Z : U l} {x y u v : Z} (a : Id Z x u) (b : Id Z y v) (q r : Id Z u v)
 (p : Id (Id Z x y) (frame a b q) (frame a b r)) : Id (Id Z u v) q r =
 H.transH (H.symH (undo a b q))
  (H.transH (H.apH (frame (H.symH a) (H.symH b)) p) (undo a b r)) ;

point-legs {Z : U l} {x y : Z} (a b : Id Z x y)
 (p : Id (Id Z x x) (frame a b (refl y)) (refl x)) : Id (Id Z x y) a b =
 H.transH (H.symH (PullbackBoundary[l].end-cancel b a))
  (H.transH (H.apH (\ w -> H.transH w b)
    (H.transH (H.symH (H.apH (\ w -> H.transH a w) (PA.unit-l (H.symH b)))) p))
   (PA.unit-l b)) ;

pointed-frame {Z : U l} {x y : Z} (a b : Id Z x y)
 (p : Id (Id Z x x) (frame a b (refl y)) (refl x)) (q : Id Z y y) :
 Id (Id Z x x) (frame a b q) (Conj[l].conj (H.symH a) q) =
 H.transH (H.apH (\ w -> frame a w q) (H.symH (point-legs a b p)))
  (H.apH (\ w -> H.transH w (H.transH q (H.symH a))) (H.symH (PA.sym-sym a))) ;

pent-leg {Z : U l} {x y z u v : Z} (a : Id Z x y) (b : Id Z y z)
 (c : Id Z x u) (d : Id Z u v) (e : Id Z v z)
 (p : Id (Id Z x z) (H.transH a b) (H.transH (H.transH c d) e)) :
 Id (Id Z y u) (H.transH (H.transH b (H.symH e)) (H.symH d)) (H.transH (H.symH a) c) =
 PA.cancel-l a
  (H.transH (H.symH (PA.tassoc a (H.transH b (H.symH e)) (H.symH d)))
   (H.transH (H.apH (\ w -> H.transH w (H.symH d)) (H.symH (PA.tassoc a b (H.symH e))))
    (H.transH (H.apH (\ w -> H.transH (H.transH w (H.symH e)) (H.symH d)) p)
     (H.transH (H.apH (\ w -> H.transH w (H.symH d)) (PA.canc-r e (H.transH c d)))
      (H.transH (PA.canc-r d c) (H.symH (CompWitness.cancel a c))))))) ;
