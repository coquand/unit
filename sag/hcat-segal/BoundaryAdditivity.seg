-- Additivity of the existing direct boundary with stable target group.
-- ConnectingArrow identifies sigma(delta g) with a pointed loop map
-- applied to L(g). Descend this square to components. The loop map is
-- a homomorphism, so Pi0Maps.Transport gives a homomorphism for exactly
-- LoopGroup[S,P] and StabGroup[S,C]. At S=unitD these are the existing
-- H_1(X) and H_0(C), and delta0 is the existing MayerVietorisTail map.
-- There are no extra coherence, comparison, or additivity parameters.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Zero ; open HGroups ; open Loops ; open Pi0[l] ;
module H = Paths[l] ; module PM = Pi0Maps[l] ;

module Sequence (C B E P : Ob D)
 (i : Hom D C B) (j : Hom D C E) (u : Hom D B P) (v : Hom D E P)
 (s : Id (Hom D C P) (hcomp {D} i u) (hcomp {D} j v))
 (po : DPushout.DSquare[C, B, E, P, i, j, u, v, s].is-pushout) (S : Ob D) {
 module K = ConnectingArrow.Arrow[C, B, E, P, i, j, u, v, s, po].At[S] ;
 square (q : LoopGroup[S, P].grp.G) :
  Id LoopGrp[Hom D S (susp C), zmap S (susp C)].grp.G
   (StabGroup[S, C].e.1 (K.M.delta0 q)) (K.Map.M.map (LoopGroup[S, P].e.1 q)) =
  PM.square (Hom D (susp S) P) (Hom D S C) (LoopOf[S].Om P) (LoopOf[S].Om (susp C))
   K.M.delta K.Map.loop (LoopOf[S].L P) StableLoop.StabLoop[S, C].sigma K.comparison q ;
 hom : PM.is-hom LoopGroup[S, P].grp StabGroup[S, C].grp K.M.delta0 =
  PM.Transport[LoopGrp[Hom D S P, zmap S P].grp, LoopGrp[Hom D S (susp C), zmap S (susp C)].grp,
   pi0 (Hom D (susp S) P), pi0 (Hom D S C), LoopGroup[S, P].e, StabGroup[S, C].e,
   K.M.delta0, K.Map.M.map, K.Map.M.mul, square].mul ;
} ;

module Types (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) {
 module Ex = Excision.ExcisionOf[B, C, E, X, i, j, u, v, h, A] ;
 module Q = Sequence[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, unitD] ;
 hom : PM.is-hom (hgrp zero X A) (hgrp0 C A) Q.K.M.delta0 = Q.hom ;
} ;
