-- Naturality of the stable loop equivalence in its target.
-- Normalize sigma(c) as the pointed precomposition of merid by c,
-- and L(g) as the pointed postcomposition of merid by g. Define
-- susp-map(f) by the inverse of L applied to sigma(f).
-- Associativity compares precomposition with a composite and the
-- two orders of whiskering. Stable mapping spaces have commuting
-- loops, so CommutingLoops supplies these comparisons with the actual
-- zero-map pointings; no coherence of pointing paths is assumed.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Associativity ; open Zero ; open HGroups ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module Pl = Prelude[l] ;
module PM = Pi0Maps[l] ; open Conj[l] ;

zero-pre (B E T : Ob D) (c : Hom D B E) :
 Id (Hom D B T) (hcomp {D} c (zmap E T)) (zmap B T) =
 H.transH (H.symH (hcomp-assoc D (B, E, zobj, T, c, zt E, zi T)))
  (H.apH (\ w -> hcomp {D} w (zi T)) (zt-eq (hcomp {D} c (zt E)))) ;

module Pre (B E T : Ob D) (c : Hom D B E) {
 module Map = PM.Pointed[Hom D E T, Hom D B T, zmap E T, zmap B T,
  \ w -> hcomp {D} c w, zero-pre B E T c] ;
} ;
module Post (B E T : Ob D) (f : Hom D E T) {
 module Map = PM.Pointed[Hom D B E, Hom D B T, zmap B E, zmap B T,
  \ w -> hcomp {D} w f, zero-post B f] ;
} ;

module SigmaForm (B E : Ob D) (c : Hom D B E) {
 al : Id (Hom D B (susp E)) (hcomp {D} (hcomp {D} c (zt E)) (zi (susp E))) (hcomp {D} c (zmap E (susp E))) =
  hcomp-assoc D (B, E, zobj, susp E, c, zt E, zi (susp E)) ;
 p : Id (Hom D B (susp E)) (hcomp {D} (hcomp {D} c (zt E)) (zi (susp E))) (zmap B (susp E)) =
  H.apH (\ w -> hcomp {D} w (zi (susp E))) (zt-eq (hcomp {D} c (zt E))) ;
 m : Id (Hom D B (susp E)) (hcomp {D} c (zmap E (susp E))) (hcomp {D} c (zmap E (susp E))) =
  H.apH (\ w -> hcomp {D} c w) (merid E) ;
 expanded : Id (Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E)))
  (StableLoop.StabLoop[B, E].sigma c) (conj p (H.transH al (H.transH m (H.symH al)))) =
  refl (StableLoop.StabLoop[B, E].sigma c) ;
 form : Id (Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E)))
  (StableLoop.StabLoop[B, E].sigma c) (Pre[B, E, susp E, c].Map.loop (merid E)) =
  H.transH expanded
   (H.transH (H.apH (\ w -> conj p (H.transH w (H.transH m (H.symH al)))) (H.symH (PA.sym-sym al)))
    (conj-trans (H.symH al) p m)) ;
} ;

loop-form (E T : Ob D) (g : Hom D (susp E) T) :
 Id (Loops.LoopOf[E].Om T) (Loops.LoopOf[E].L T g) (Post[E, susp E, T, g].Map.loop (merid E)) =
 H.transH (Loops.LoopOf[E].L-def T g)
  (conj-trans (hcomp-assoc D (E, zobj, susp E, T, zt E, zi (susp E), g))
   (H.apH (\ w -> hcomp {D} (zt E) w) (zi-eq (hcomp {D} (zi (susp E)) g)))
   (H.apH (\ w -> hcomp {D} w g) (merid E))) ;

susp-map (E T : Ob D) (f : Hom D E T) : Hom D (susp E) (susp T) =
 (Loops.LoopOf[E].L-equiv (susp T)).sec (StableLoop.StabLoop[E, T].sigma f) ;
susp-map-law (E T : Ob D) (f : Hom D E T) :
 Id (Loops.LoopOf[E].Om (susp T))
  (Post[E, susp E, susp T, susp-map E T f].Map.loop (merid E)) (Pre[E, T, susp T, f].Map.loop (merid T)) =
 H.transH (H.symH (loop-form E (susp T) (susp-map E T f)))
  (H.transH ((Loops.LoopOf[E].L-equiv (susp T)).sec-eq (StableLoop.StabLoop[E, T].sigma f)) (SigmaForm[E, T, f].form)) ;
opaque susp-map ;

module PreCompose (B E T W : Ob D) (c : Hom D B E) (f : Hom D E T) {
 module Comm = CommutingLoops.Target[Hom D B W, zmap B W, stable-comm B W] ;
 module Factor = Comm.Factor[Hom D T W, Hom D E W, zmap T W, zmap E W,
  \ w -> hcomp {D} f w, \ w -> hcomp {D} c w, \ w -> hcomp {D} (hcomp {D} c f) w,
  zero-pre E T W f, zero-pre B E W c, zero-pre B T W (hcomp {D} c f),
  \ w -> H.symH (hcomp-assoc D (B, E, T, W, c, f, w))] ;
} ;

module Whisker (B E T W : Ob D) (c : Hom D B E) (f : Hom D T W) {
 module Comm = CommutingLoops.Target[Hom D B W, zmap B W, stable-comm B W] ;
 module Square = Comm.Square[Hom D E T, Hom D B T, Hom D E W,
  zmap E T, zmap B T, zmap E W,
  \ w -> hcomp {D} c w, \ w -> hcomp {D} c w, \ w -> hcomp {D} w f, \ w -> hcomp {D} w f,
  zero-pre B E T c, zero-pre B E W c, zero-post E f, zero-post B f,
  \ w -> hcomp-assoc D (B, E, T, W, c, w, f)] ;
} ;

sigma-natural (B E T : Ob D) (c : Hom D B E) (f : Hom D E T) :
 Id (Loops.LoopOf[B].Om (susp T))
  (StableLoop.StabLoop[B, T].sigma (hcomp {D} c f))
  (Post[B, susp E, susp T, susp-map E T f].Map.loop (StableLoop.StabLoop[B, E].sigma c)) =
 H.transH (SigmaForm[B, T, hcomp {D} c f].form)
  (H.transH (H.symH (PreCompose[B, E, T, susp T, c, f].Factor.loops (merid T)))
   (H.transH (H.apH Pre[B, E, susp T, c].Map.loop (H.symH (susp-map-law E T f)))
    (H.transH (H.symH (Whisker[B, E, susp E, susp T, c, susp-map E T f].Square.loops (merid E)))
     (H.apH Post[B, susp E, susp T, susp-map E T f].Map.loop (H.symH (SigmaForm[B, E, c].form)))))) ;
