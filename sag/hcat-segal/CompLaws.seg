-- The degeneracy triangles give the two unit laws by triangle-path.
-- No independently specified unit-law equation is required.
open HigherCat ; open Constructions ; open Composition ;

hcomp-unit-l {C : Cat} {a b : Ob C} (f : Hom C a b) : Id (Hom C a b) (hcomp (id-hom a) f) f =
 triangle-path (id-hom a) f f (unit-left C f) ;

hcomp-unit-r {C : Cat} {a b : Ob C} (f : Hom C a b) : Id (Hom C a b) (hcomp f (id-hom b)) f =
 triangle-path f (id-hom b) f (unit-right C f) ;
