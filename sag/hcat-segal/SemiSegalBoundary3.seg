-- The Lambda^3_1 horn after normalizing triangles to composition paths.
-- Its missing face is 023. All shared endpoints are shared variables.
open HigherCat ; open Constructions ; open Composition ;

record Horn (C : Cat) {
 x0 : Ob C ; x1 : Ob C ; x2 : Ob C ; x3 : Ob C ;
 e01 : Hom C x0 x1 ; e12 : Hom C x1 x2 ; e23 : Hom C x2 x3 ;
 e02 : Hom C x0 x2 ; e13 : Hom C x1 x3 ; e03 : Hom C x0 x3 ;
 q012 : Id (Hom C x0 x2) (hcomp e01 e12) e02 ;
 q123 : Id (Hom C x1 x3) (hcomp e12 e23) e13 ;
 q013 : Id (Hom C x0 x3) (hcomp e01 e13) e03 ;
} ;

Missing (C : Cat) (h : Horn[C]) : U l = Id (Hom C h.x0 h.x3) (hcomp h.e02 h.e23) h.e03 ;

canonical (C : Cat) {a b c d : Ob C} (f : Hom C a b) (g : Hom C b c) (h : Hom C c d) : Horn[C] =
 new Horn[C, a, b, c, d, f, g, h, hcomp f g, hcomp g h, hcomp f (hcomp g h),
  refl (hcomp f g), refl (hcomp g h), refl (hcomp f (hcomp g h))] ;
