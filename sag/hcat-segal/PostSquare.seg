-- A homotopy-commuting square of arrows induces a pointed square of
-- postcomposition maps, with the actual zero-post pointings.
-- The point-square is a consequence of ZeroCoherence for the two
-- composites and for the given path between them. The helper close
-- is just reassociation and cancellation in the path groupoid.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Associativity ; open Zero ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;

close {V : U l} {x y z w t r : V}
 (a : Id V x y) (b : Id V y z) (c : Id V w z) (u : Id V w t) (v : Id V t r)
 (p : Id V y r) (q : Id V z r) (s : Id V x r)
 (hp : Id (Id V y r) (H.transH b q) p)
 (hq : Id (Id V w r) (H.transH c q) (H.transH u v))
 (hs : Id (Id V x r) (H.transH a p) s) :
 Id (Id V x r) (H.transH (H.transH (H.transH a (H.transH b (H.symH c))) u) v) s =
 H.transH (PA.tassoc (H.transH a (H.transH b (H.symH c))) u v)
  (H.transH (H.apH (\ k -> H.transH (H.transH a (H.transH b (H.symH c))) k) (H.symH hq))
   (H.transH (PA.tassoc a (H.transH b (H.symH c)) (H.transH c q))
    (H.transH (H.apH (\ k -> H.transH a k) (PA.tassoc b (H.symH c) (H.transH c q)))
     (H.transH (H.apH (\ k -> H.transH a (H.transH b k)) (PA.canc-l c q))
      (H.transH (H.apH (\ k -> H.transH a k) hp) hs))))) ;

module Square (S A B A1 B1 : Ob D) (f : Hom D A B) (a : Hom D A A1)
 (b : Hom D B B1) (g : Hom D A1 B1)
 (edge : Id (Hom D A B1) (hcomp {D} a g) (hcomp {D} f b)) {
 square (w : Hom D S A) :
  Id (Hom D S B1) (hcomp {D} (hcomp {D} w a) g) (hcomp {D} (hcomp {D} w f) b) =
  H.transH (hcomp-assoc D (S, A, A1, B1, w, a, g))
   (H.transH (H.apH (\ t -> hcomp {D} w t) edge) (H.symH (hcomp-assoc D (S, A, B, B1, w, f, b)))) ;
 point-square : Id (Id (Hom D S B1) (hcomp {D} (hcomp {D} (zmap S A) a) g) (zmap S B1))
  (H.transH (H.transH (square (zmap S A)) (H.apH (\ w -> hcomp {D} w b) (zero-post S f))) (zero-post S b))
  (H.transH (H.apH (\ w -> hcomp {D} w g) (zero-post S a)) (zero-post S g)) =
  close (hcomp-assoc D (S, A, A1, B1, zmap S A, a, g))
   (H.apH (\ w -> hcomp {D} (zmap S A) w) edge)
   (hcomp-assoc D (S, A, B, B1, zmap S A, f, b))
   (H.apH (\ w -> hcomp {D} w b) (zero-post S f)) (zero-post S b)
   (zero-post S (hcomp {D} a g)) (zero-post S (hcomp {D} f b))
   (H.transH (H.apH (\ w -> hcomp {D} w g) (zero-post S a)) (zero-post S g))
   (ZeroCoherence.zero-post-path S (hcomp {D} a g) (hcomp {D} f b) edge)
   ZeroCoherence.Compose[S, A, B, B1, f, b].coherence
   ZeroCoherence.Compose[S, A, A1, B1, a, g].coherence ;
} ;
