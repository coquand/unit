-- Identify the chosen group units with the class of the categorical zero.
-- For the stable degree-zero construction, ConeZero sends the cone of
-- zero to (z,z,p.p^-1). Cancel p, then cancel the two contraction paths
-- in ContrLoop.kappa. Thus StableLoop.sigma sends zero to the constant
-- loop. For positive degrees the corresponding fact is L-zero.
-- Transporting the loop group therefore sends its unit to [zero].
-- No naturality or multiplicativity of sigma is asserted here.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Zero ; open StableLoop ; open HGroups ; open Pi0[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ;

module SigmaZero (B E : Ob D) {
 module K = FibreAlg.ContrLoop[Hom D B zobj, Hom D B (susp E), zero-term B, \ x -> hcomp {D} x (zi (susp E))] ;
 module Z = ConeZero.Point[E, zobj, zobj, susp E, zt E, zt E, zi (susp E), zi (susp E), merid E, B] ;
 c0 : Hom D B zobj = zmap B zobj ;
 p0 : Id (Hom D B (susp E)) (hcomp {D} c0 (zi (susp E))) (zmap B (susp E)) = zero-post B (zi (susp E)) ;
 contraction : Id (Hom D B (susp E)) (hcomp {D} c0 (zi (susp E))) (zmap B (susp E)) =
  H.apH (\ x -> hcomp {D} x (zi (susp E))) (K.ce c0) ;
 diagonal : Id (Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E)))
  (K.kappa (c0, c0, refl (hcomp {D} c0 (zi (susp E))))) (refl (zmap B (susp E))) =
  H.transH (H.apH (\ p -> H.transH (H.symH contraction) p) (PA.unit-l contraction)) (PA.inv-l contraction) ;
 sigma-zero : Id (Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E)))
  (StabLoop[B, E].sigma (zmap B E)) (refl (zmap B (susp E))) =
  H.transH (H.apH K.kappa Z.cone-zero)
   (H.transH (H.apH (\ p -> K.kappa (c0, c0, p)) (PA.inv-r p0)) diagonal) ;
} ;

module TransportUnit (G : Group[l].Grp) (X : U l) (e : Pl.Equiv X G.G) (x : X) (p : Id G.G (e.1 x) G.e) {
 unit : Id X TransportGrp[G, X, e].grp.e x =
  H.transH (H.apH e.2.sec (H.symH p)) (Pl.sec-ret X G.G e.1 e.2 x) ;
} ;

stable-unit (B E : Ob D) : Id (pi0 (Hom D B E)) StabGroup[B, E].grp.e (cls (zmap B E)) =
 TransportUnit[LoopGrp[Hom D B (susp E), zmap B (susp E)].grp, pi0 (Hom D B E), StabGroup[B, E].e, cls (zmap B E),
  H.transH (pi0-map-cls (Hom D B E) (Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E))) StabLoop[B, E].sigma (zmap B E))
   (H.apH (\ p -> cls p) SigmaZero[B, E].sigma-zero)].unit ;

loop-unit (B E : Ob D) : Id (pi0 (Hom D (susp B) E)) LoopGroup[B, E].grp.e (cls (zmap (susp B) E)) =
 TransportUnit[LoopGrp[Hom D B E, zmap B E].grp, pi0 (Hom D (susp B) E), LoopGroup[B, E].e, cls (zmap (susp B) E),
  H.transH (pi0-map-cls (Hom D (susp B) E) (Loops.LoopOf[B].Om E) (Loops.LoopOf[B].L E) (zmap (susp B) E))
   (H.apH (\ p -> cls p) (Loops.LoopOf[B].L-zero E))].unit ;

zero-unit (X : U k) (A : Ob D) : Id (homology zero X A) (hgrp0 X A).e (cls (zmap unitD (tensor X A))) =
 stable-unit unitD (tensor X A) ;

positive-unit (n : Nat) (X : U k) (A : Ob D) :
 Id (homology (suc n) X A) (hgrp n X A).e (cls (zmap (Sph (suc n)) (tensor X A))) = loop-unit (Sph n) (tensor X A) ;
