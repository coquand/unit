-- The inverse fragment of the internal category interface. A two-sided
-- inverse makes postcomposition an equivalence: reassociate, apply its
-- inverse equation, then the derived right unit law. This uses no
-- ambient functors, Rezk axiom, or comparison with the old category.
open HigherCat ; open Constructions ; open Composition ; open CompLaws ; open Associativity ;
module H = Paths[l] ; module Pl = Prelude[l] ;

is-inv {C : Cat} {a b : Ob C} (f : Hom C a b) : U l =
 (x : Ob C) -> Pl.isEquiv (Hom C x a) (Hom C x b) (\ u -> hcomp u f) ;

has-inv {C : Cat} {a b : Ob C} (f : Hom C a b) : U l =
 (g : Hom C b a) * Id (Hom C a a) (hcomp f g) (id-hom a) * Id (Hom C b b) (hcomp g f) (id-hom b) ;

undo {C : Cat} {x a b : Ob C} (u : Hom C x a) (f : Hom C a b) (g : Hom C b a)
 (p : Id (Hom C a a) (hcomp f g) (id-hom a)) : Id (Hom C x a) (hcomp (hcomp u f) g) u =
 H.transH (H.transH (hcomp-assoc C (x, a, b, a, u, f, g)) (H.apH (\ v -> hcomp u v) p)) (hcomp-unit-r u) ;

has-inv-is-inv {C : Cat} {a b : Ob C} (f : Hom C a b) (w : has-inv f) : is-inv f = \ x ->
 Pl.qinv (Hom C x a) (Hom C x b) (\ u -> hcomp u f) (\ v -> hcomp v w.1)
  (\ v -> undo v w.1 f w.2.2) (\ u -> undo u f w.1 w.2.1) ;
