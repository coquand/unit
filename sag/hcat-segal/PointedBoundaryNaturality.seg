-- Naturality of pullback boundary maps with the specified basepoints.
-- PullbackNaturality first maps to the image basepoints. Rebase the
-- three vertices along the pointing paths. The two point-square laws
-- identify the resulting legs. Rebase is proved by identity elimination,
-- so all equalities here are propositional, not strictness assumptions.
level l ; open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
module PN = PullbackNaturality[l] ; module PB = PointedPullback[l] ;

module Rebase (B E P : U l) (f : B -> P) (g : E -> P)
 (b : B) (e : E) (z : P) (u : Id P (f b) z) (v : Id P (g e) z) {
 module K = PB.Boundary[B, E, P, f, g, b, e, z, u, v] ;
 target (b1 : B) (e1 : E) (z1 : P) (u1 : Id P (f b1) z1) (v1 : Id P (g e1) z1)
  (pz : Id P z z1) (q : Id P z z) : K.Q.Cone =
  PB.Boundary[B, E, P, f, g, b1, e1, z1, u1, v1].boundary (Conj[l].conj pz q) ;
 base (u1 : Id P (f b) z) (v1 : Id P (g e) z)
  (hu : Id (Id P (f b) z) u (H.transH (refl (f b)) u1))
  (hv : Id (Id P (g e) z) v (H.transH (refl (g e)) v1)) (q : Id P z z) :
  Id K.Q.Cone (K.boundary q) (target b e z u1 v1 (refl z) q) =
  H.transH (H.apH {Id P (f b) z} {K.Q.Cone} (\ w -> (b, e, H.transH w (H.transH q (H.symH v)))) (H.transH hu (PA.unit-l u1)))
   (H.transH (H.apH {Id P (g e) z} {K.Q.Cone} (\ w -> (b, e, H.transH u1 (H.transH q (H.symH w)))) (H.transH hv (PA.unit-l v1)))
    (H.apH {Id P z z} {K.Q.Cone} (\ w -> (b, e, H.transH u1 (H.transH w (H.symH v1)))) (H.symH (Conj[l].conj-refl-path q)))) ;
 change (b1 : B) (pb : Id B b b1) (e1 : E) (pe : Id E e e1) (z1 : P) (pz : Id P z z1)
  (u1 : Id P (f b1) z1) (v1 : Id P (g e1) z1)
  (hu : Id (Id P (f b) z1) (H.transH u pz) (H.transH (H.apH f pb) u1))
  (hv : Id (Id P (g e) z1) (H.transH v pz) (H.transH (H.apH g pe) v1)) (q : Id P z z) :
  Id K.Q.Cone (K.boundary q) (target b1 e1 z1 u1 v1 pz q) =
  idJ B b (\ b2 pb2 -> (e2 : E) (pe2 : Id E e e2) (z2 : P) (pz2 : Id P z z2)
   (u2 : Id P (f b2) z2) (v2 : Id P (g e2) z2)
   (hu2 : Id (Id P (f b) z2) (H.transH u pz2) (H.transH (H.apH f pb2) u2))
   (hv2 : Id (Id P (g e) z2) (H.transH v pz2) (H.transH (H.apH g pe2) v2)) ->
   Id K.Q.Cone (K.boundary q) (target b2 e2 z2 u2 v2 pz2 q))
   (\ e2 pe2 -> idJ E e (\ e3 pe3 -> (z2 : P) (pz2 : Id P z z2)
    (u2 : Id P (f b) z2) (v2 : Id P (g e3) z2)
    (hu2 : Id (Id P (f b) z2) (H.transH u pz2) (H.transH (refl (f b)) u2))
    (hv2 : Id (Id P (g e) z2) (H.transH v pz2) (H.transH (H.apH g pe3) v2)) ->
    Id K.Q.Cone (K.boundary q) (target b e3 z2 u2 v2 pz2 q))
    (\ z2 pz2 -> idJ P z (\ z3 pz3 -> (u2 : Id P (f b) z3) (v2 : Id P (g e) z3)
     (hu2 : Id (Id P (f b) z3) (H.transH u pz3) (H.transH (refl (f b)) u2))
     (hv2 : Id (Id P (g e) z3) (H.transH v pz3) (H.transH (refl (g e)) v2)) ->
     Id K.Q.Cone (K.boundary q) (target b e z3 u2 v2 pz3 q))
     (\ u2 v2 hu2 hv2 -> base u2 v2 hu2 hv2 q) z2 pz2) e2 pe2)
   b1 pb e1 pe z1 pz u1 v1 hu hv ;
} ;

module Map (B E P B1 E1 P1 : U l) (f : B -> P) (g : E -> P) (f1 : B1 -> P1) (g1 : E1 -> P1)
 (hb : B -> B1) (he : E -> E1) (hp : P -> P1)
 (sf : (b : B) -> Id P1 (f1 (hb b)) (hp (f b)))
 (sg : (e : E) -> Id P1 (g1 (he e)) (hp (g e)))
 (b : B) (e : E) (z : P) (u : Id P (f b) z) (v : Id P (g e) z)
 (b1 : B1) (e1 : E1) (z1 : P1) (u1 : Id P1 (f1 b1) z1) (v1 : Id P1 (g1 e1) z1)
 (pb : Id B1 (hb b) b1) (pe : Id E1 (he e) e1) (pz : Id P1 (hp z) z1)
 (hu : Id (Id P1 (f1 (hb b)) z1)
  (H.transH (H.transH (sf b) (H.apH hp u)) pz) (H.transH (H.apH f1 pb) u1))
 (hv : Id (Id P1 (g1 (he e)) z1)
  (H.transH (H.transH (sg e) (H.apH hp v)) pz) (H.transH (H.apH g1 pe) v1)) {
 module N = PN.Map[B, E, P, B1, E1, P1, f, g, f1, g1, hb, he, hp, sf, sg, b, e, z, u, v] ;
 module T = PB.Boundary[B1, E1, P1, f1, g1, b1, e1, z1, u1, v1] ;
 module R = Rebase[B1, E1, P1, f1, g1, hb b, he e, hp z,
  H.transH (sf b) (H.apH hp u), H.transH (sg e) (H.apH hp v)] ;
 natural (q : Id P z z) : Id T.Q.Cone
  (N.cones (N.K.boundary q)) (T.boundary (Conj[l].conj pz (H.apH hp q))) =
  H.transH (N.boundary q) (R.change b1 pb e1 pe z1 pz u1 v1 hu hv (H.apH hp q)) ;
} ;
