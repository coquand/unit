-- Naturality of the actual direct Mayer-Vietoris boundary under a
-- coherent map of representable pushout squares.
-- The two upper faces induce pointed cospan maps by PostSquare. The
-- cube field says that this cone map agrees with postcomposition on
-- the pullback vertex. Apply the target pullback equivalence to compare
-- boundaries: cube, source inverse law, pointed boundary naturality,
-- L-nat, target inverse law. Then descend to components.
-- The cube is specified diagram-map data, not an added ambient axiom.
-- Constructing it from a map of pushout diagrams of types is separate.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Zero ; open Loops ; open Pi0[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PM = Pi0Maps[l] ;

module Squares (C B E P C1 B1 E1 P1 : Ob D)
 (i : Hom D C B) (j : Hom D C E) (u : Hom D B P) (v : Hom D E P)
 (s : Id (Hom D C P) (hcomp {D} i u) (hcomp {D} j v))
 (po : DPushout.DSquare[C, B, E, P, i, j, u, v, s].is-pushout)
 (i1 : Hom D C1 B1) (j1 : Hom D C1 E1) (u1 : Hom D B1 P1) (v1 : Hom D E1 P1)
 (s1 : Id (Hom D C1 P1) (hcomp {D} i1 u1) (hcomp {D} j1 v1))
 (po1 : DPushout.DSquare[C1, B1, E1, P1, i1, j1, u1, v1, s1].is-pushout)
 (ac : Hom D C C1) (ab : Hom D B B1) (ae : Hom D E E1) (ap : Hom D P P1)
 (upper-left : Id (Hom D B P1) (hcomp {D} ab u1) (hcomp {D} u ap))
 (upper-right : Id (Hom D E P1) (hcomp {D} ae v1) (hcomp {D} v ap)) (S : Ob D) {
 module M = MayerVietoris.MV[C, B, E, P, i, j, u, v, s, po, S] ;
 module T = MayerVietoris.MV[C1, B1, E1, P1, i1, j1, u1, v1, s1, po1, S] ;
 module LeftSquare = PostSquare.Square[S, B, P, B1, P1, u, ab, ap, u1, upper-left] ;
 module V = PostSquare.Square[S, E, P, E1, P1, v, ae, ap, v1, upper-right] ;
 module N = PointedBoundaryNaturality[l].Map[
  Hom D S B, Hom D S E, Hom D S P, Hom D S B1, Hom D S E1, Hom D S P1,
  \ w -> hcomp {D} w u, \ w -> hcomp {D} w v,
  \ w -> hcomp {D} w u1, \ w -> hcomp {D} w v1,
  \ w -> hcomp {D} w ab, \ w -> hcomp {D} w ae, \ w -> hcomp {D} w ap,
  LeftSquare.square, V.square, zmap S B, zmap S E, zmap S P, zero-post S u, zero-post S v,
  zmap S B1, zmap S E1, zmap S P1, zero-post S u1, zero-post S v1,
  zero-post S ab, zero-post S ae, zero-post S ap, LeftSquare.point-square, V.point-square] ;

 module Coherent (cube : (c : Hom D S C) -> Id (T.C.Cone S)
  (T.C.cone-map S (hcomp {D} c ac)) (N.N.cones (M.C.cone-map S c))) {
  cones (g : Hom D (susp S) P) : Id (T.C.Cone S)
   (T.C.cone-map S (hcomp {D} (M.delta g) ac)) (T.delta-cone (hcomp {D} g ap)) =
   H.transH (cube (M.delta g))
    (H.transH (H.apH N.N.cones (M.pull.sec-eq (M.delta-cone g)))
     (H.transH (N.natural (LoopOf[S].L P g))
      (H.apH N.T.boundary (H.symH (LoopOf[S].L-nat P P1 g ap))))) ;
  representatives (g : Hom D (susp S) P) :
   Id (Hom D S C1) (hcomp {D} (M.delta g) ac) (T.delta (hcomp {D} g ap)) =
   Equivalences[l].injective (Hom D S C1) (T.C.Cone S) (T.C.cone-map S) T.pull
    (hcomp {D} (M.delta g) ac) (T.delta (hcomp {D} g ap))
    (H.transH (cones g) (H.symH (T.pull.sec-eq (T.delta-cone (hcomp {D} g ap))))) ;
  natural (q : pi0 (Hom D (susp S) P)) :
   Id (pi0 (Hom D S C1))
    (T.delta0 (pi0-map (Hom D (susp S) P) (Hom D (susp S) P1) (\ w -> hcomp {D} w ap) q))
    (pi0-map (Hom D S C) (Hom D S C1) (\ w -> hcomp {D} w ac) (M.delta0 q)) =
   PM.square (Hom D (susp S) P) (Hom D (susp S) P1) (Hom D S C) (Hom D S C1)
    (\ w -> hcomp {D} w ap) (\ w -> hcomp {D} w ac) M.delta T.delta
    (\ w -> H.symH (representatives w)) q ;
 } ;
} ;
