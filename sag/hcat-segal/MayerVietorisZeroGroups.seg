-- The complete degree-zero tail has homomorphisms of the existing
-- abelian groups, including the existing direct boundary H_1(X)->H_0(C).
-- BoundaryAdditivity proves this last homomorphism. Translate the
-- pointed-set equalizer into image = kernel of the difference by group
-- cancellation; the other exactness statements remain those of Tail.
open Base ; open HigherCat ; open HGroups ; open HGroupMaps ;
module H = Paths[l] ; module PM = Pi0Maps[l] ; module AD = AbelianDifference[l] ;

module Types (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) {
 module Tail = MayerVietorisTail.Types[B, C, E, X, i, j, u, v, h, A, po] ;
 module Product = AD.Product[hgrp0 B A, hgrp0 E A] ;
 module Difference = AD.At[hgrp0 X A].Abelian[stab-grp-ab unitD (tensor X A)] ;
 delta-hom : PM.is-hom (hgrp zero X A) (hgrp0 C A) Tail.delta =
  BoundaryAdditivity.Types[B, C, E, X, i, j, u, v, h, A, po].hom ;
 inclusion-hom : PM.is-hom (hgrp0 C A) Product.grp Tail.inclusion =
  Product.pair-hom (hgrp0 C A) (hmap zero A i) (hmap zero A j)
   (StableGroupMaps.hmap-zero-mul A i) (StableGroupMaps.hmap-zero-mul A j) ;
 difference (t : Product.grp.G) : homology zero X A = PM.diff (hgrp0 X A) (Tail.left t) (Tail.right t) ;
 difference-hom : PM.is-hom Product.grp (hgrp0 X A) difference =
  Difference.hom (hgrp0 B A) (hgrp0 E A) (hmap zero A u) (hmap zero A v)
   (StableGroupMaps.hmap-zero-mul A u) (StableGroupMaps.hmap-zero-mul A v) ;
 product-zero (c : homology zero C A) :
  Id (homology zero X A) (difference (Tail.inclusion c)) (hgrp0 X A).e =
  AD.At[hgrp0 X A].zero (Tail.left (Tail.inclusion c)) (Tail.right (Tail.inclusion c)) (Tail.product-comm c) ;
 product-exact (t : Product.grp.G) (p : Id (homology zero X A) (difference t) (hgrp0 X A).e) : Tail.ProductImage t =
  Tail.product-exact t (AD.At[hgrp0 X A].same (Tail.left t) (Tail.right t) p) ;
} ;
