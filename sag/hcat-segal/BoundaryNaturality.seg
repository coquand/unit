-- Naturality of the structural boundary used by HomologySequence.
-- A coherent map of representable squares gives a homotopy between
-- the direct boundaries (MayerVietorisNaturality). Loop that homotopy;
-- stable mapping spaces have commuting loops, so arbitrary chosen
-- pointings suffice. L-nat identifies the vertical maps with the
-- existing postcomposition maps. BoundaryLoopComparison identifies
-- the two horizontal maps with the structural boundaries themselves.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Zero ; open HGroups ; open Pi0[l] ;
module H = Paths[l] ;

module Squares (C B E P C1 B1 E1 P1 : Ob D)
 (i : Hom D C B) (j : Hom D C E) (u : Hom D B P) (v : Hom D E P)
 (s : Id (Hom D C P) (hcomp {D} i u) (hcomp {D} j v))
 (po : DPushout.DSquare[C, B, E, P, i, j, u, v, s].is-pushout)
 (i1 : Hom D C1 B1) (j1 : Hom D C1 E1) (u1 : Hom D B1 P1) (v1 : Hom D E1 P1)
 (s1 : Id (Hom D C1 P1) (hcomp {D} i1 u1) (hcomp {D} j1 v1))
 (po1 : DPushout.DSquare[C1, B1, E1, P1, i1, j1, u1, v1, s1].is-pushout)
 (ac : Hom D C C1) (ab : Hom D B B1) (ae : Hom D E E1) (ap : Hom D P P1)
 (upper-left : Id (Hom D B P1) (hcomp {D} ab u1) (hcomp {D} u ap))
 (upper-right : Id (Hom D E P1) (hcomp {D} ae v1) (hcomp {D} v ap)) (S : Ob D) {
 module N = MayerVietorisNaturality.Squares[C, B, E, P, C1, B1, E1, P1,
  i, j, u, v, s, po, i1, j1, u1, v1, s1, po1, ac, ab, ae, ap, upper-left, upper-right, S] ;
 module Source = BoundaryLoopComparison.Compare[C, B, E, P, i, j, u, v, s, po, S] ;
 module Target = BoundaryLoopComparison.Compare[C1, B1, E1, P1, i1, j1, u1, v1, s1, po1, S] ;
 module SrcMap = HGroupMaps.Post[susp S, P, P1, ap] ;
 module TgtMap = HGroupMaps.Post[S, C, C1, ac] ;
 module Coherent (cube : (c : Hom D S C) -> Id (N.T.C.Cone S)
  (N.T.C.cone-map S (hcomp {D} c ac)) (N.N.N.cones (N.M.C.cone-map S c))) {
  module Direct = N.Coherent[cube] ;
  module Comm = CommutingLoops.Target[Hom D S C1, zmap S C1, stable-comm S C1] ;
  module Square = Comm.Square[Hom D (susp S) P, Hom D (susp S) P1, Hom D S C,
   zmap (susp S) P, zmap (susp S) P1, zmap S C,
   \ w -> hcomp {D} w ap, \ w -> hcomp {D} w ac, N.M.delta, N.T.delta,
   zero-post (susp S) ap, zero-post S ac,
   Source.Lc.X.delta-point-path, Target.Lc.X.delta-point-path,
   \ w -> H.symH (Direct.representatives w)] ;
  loop-over (q : Source.Q.A.grp.G) :
   Id LoopGrp[Hom D S C1, zmap S C1].grp.G
    (Target.Q.B.e.1 (Target.Lc.map (SrcMap.map q)))
    (Target.Q.B.e.1 (TgtMap.map (Source.Lc.map q))) =
   H.transH (Target.Lc.square (SrcMap.map q))
    (H.transH (H.apH Target.Lc.F.M.map (SrcMap.square q))
     (H.transH (Square.groups (Source.Q.A.e.1 q))
      (H.transH (H.apH TgtMap.P.M.map (H.symH (Source.Lc.square q)))
       (H.symH (TgtMap.square (Source.Lc.map q)))))) ;
  loop-natural (q : Source.Q.A.grp.G) :
   Id Target.Q.B.grp.G (Target.Lc.map (SrcMap.map q)) (TgtMap.map (Source.Lc.map q)) =
   Equivalences[l].injective Target.Q.B.grp.G LoopGrp[Hom D S C1, zmap S C1].grp.G
    Target.Q.B.e.1 Target.Q.B.e.2 (Target.Lc.map (SrcMap.map q)) (TgtMap.map (Source.Lc.map q)) (loop-over q) ;
  natural (q : Source.Q.A.grp.G) :
   Id Target.Q.B.grp.G (Target.Q.connecting (SrcMap.map q)) (TgtMap.map (Source.Q.connecting q)) =
   H.transH (Target.equal (SrcMap.map q))
    (H.transH (loop-natural q) (H.apH TgtMap.map (H.symH (Source.equal q)))) ;
 } ;
} ;
