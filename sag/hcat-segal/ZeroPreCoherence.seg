-- The zero-pre paths are compatible with composition. Expand the
-- inner zero-pre, move its contraction by J, and use the pentagon to
-- compare associators. The remaining paths lie in Hom(S,0), which is
-- contractible, so they are equal. No unit coherence is assumed.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Associativity ; open Zero ; open StableNaturality ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module F = PathFrames ;

module At (S C T : Ob D) (c : Hom D S C) {
 tail (z : Hom D C zobj) (r : Id (Hom D C zobj) z (zt C)) :
  Id (Id (Hom D S T) (hcomp {D} c (hcomp {D} z (zi T))) (zmap S T))
   (H.transH (H.apH (\ w -> hcomp {D} c w) (H.apH (\ w -> hcomp {D} w (zi T)) r)) (zero-pre S C T c))
   (H.transH (H.symH (hcomp-assoc D (S, C, zobj, T, c, z, zi T)))
    (H.apH (\ w -> hcomp {D} w (zi T)) (zt-eq (hcomp {D} c z)))) =
  H.idJR (Hom D C zobj) (zt C) (\ z1 r1 ->
   Id (Id (Hom D S T) (hcomp {D} c (hcomp {D} z1 (zi T))) (zmap S T))
    (H.transH (H.apH (\ w -> hcomp {D} c w) (H.apH (\ w -> hcomp {D} w (zi T)) r1)) (zero-pre S C T c))
    (H.transH (H.symH (hcomp-assoc D (S, C, zobj, T, c, z1, zi T)))
     (H.apH (\ w -> hcomp {D} w (zi T)) (zt-eq (hcomp {D} c z1)))))
   (PA.unit-l (zero-pre S C T c)) z r ;
} ;

module Compose (S C B T : Ob D) (c : Hom D S C) (i : Hom D C B) {
 module L = ConeCocone.Leg[S, C, B, zobj, T, c, i, zt B, zi T] ;
 pre (w : Hom D C T) : Hom D S T = hcomp {D} c w ;
 post (w : Hom D S zobj) : Hom D S T = hcomp {D} w (zi T) ;
 r : Id (Hom D C zobj) (hcomp {D} i (zt B)) (zt C) = zt-eq (hcomp {D} i (zt B)) ;
 q : Id (Hom D S T) (hcomp {D} (hcomp {D} c (hcomp {D} i (zt B))) (zi T)) (zmap S T) =
  H.apH post (zt-eq (hcomp {D} c (hcomp {D} i (zt B)))) ;
 expand : Id (Id (Hom D S T) (hcomp {D} c (hcomp {D} i (zmap B T))) (hcomp {D} c (zmap C T)))
  (H.apH pre (zero-pre C B T i))
  (H.transH (H.symH L.e) (H.apH pre (H.apH (\ w -> hcomp {D} w (zi T)) r))) =
  H.transH (PA.ap-trans pre (H.symH L.r) (H.apH (\ w -> hcomp {D} w (zi T)) r))
   (H.apH (\ w -> H.transH w (H.apH pre (H.apH (\ w -> hcomp {D} w (zi T)) r))) (PA.ap-sym pre L.r)) ;
 coherence : Id (Id (Hom D S T) (hcomp {D} (hcomp {D} c i) (zmap B T)) (zmap S T))
  (H.transH L.b (H.transH (H.apH pre (zero-pre C B T i)) (zero-pre S C T c)))
  (zero-pre S B T (hcomp {D} c i)) =
  H.transH (H.apH (\ w -> H.transH L.b (H.transH w (zero-pre S C T c))) expand)
   (H.transH (H.apH (\ w -> H.transH L.b w)
     (PA.tassoc (H.symH L.e) (H.apH pre (H.apH (\ w -> hcomp {D} w (zi T)) r)) (zero-pre S C T c)))
    (H.transH (H.apH (\ w -> H.transH L.b (H.transH (H.symH L.e) w)) (At[S, C, T, c].tail (hcomp {D} i (zt B)) r))
     (H.transH (H.symH (PA.tassoc L.b (H.symH L.e) (H.transH (H.symH L.d) q)))
      (H.transH (H.symH (PA.tassoc (H.transH L.b (H.symH L.e)) (H.symH L.d) q))
       (H.transH (H.apH (\ w -> H.transH w q) L.solved)
        (H.transH (PA.tassoc (H.symH L.a) L.p q)
         (H.transH (H.apH (\ w -> H.transH (H.symH L.a) w)
           (H.symH (PA.ap-trans post (hcomp-assoc D (S, C, B, zobj, c, i, zt B)) (zt-eq (hcomp {D} c (hcomp {D} i (zt B)))))))
          (H.apH (\ w -> H.transH (H.symH L.a) (H.apH post w))
           (zt-set S (hcomp {D} (hcomp {D} c i) (zt B)) (zt S)
            (H.transH (hcomp-assoc D (S, C, B, zobj, c, i, zt B)) (zt-eq (hcomp {D} c (hcomp {D} i (zt B)))))
            (zt-eq (hcomp {D} (hcomp {D} c i) (zt B)))))))))))) ;
} ;
