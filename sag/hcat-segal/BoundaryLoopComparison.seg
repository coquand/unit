-- The structural connecting homomorphism is the loop of the direct
-- boundary, transported through the existing suspension equivalences.
-- After applying the target equivalence, both maps are the loop of
-- boundary o L. The cone comparison commutes by the pullback inverse
-- law. Loops in the cone commute, transferred from Hom(S,C), so no
-- extra compatibility of the pointing proofs is required.
open Base ; open HigherCat ; open Constructions ; open Composition ;
open Zero ; open Loops ; open HGroups ; open Pi0[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
module PM = Pi0Maps[l] ;

module Compare (C B E P : Ob D)
 (i : Hom D C B) (j : Hom D C E) (u : Hom D B P) (v : Hom D E P)
 (s : Id (Hom D C P) (hcomp {D} i u) (hcomp {D} j v))
 (po : DPushout.DSquare[C, B, E, P, i, j, u, v, s].is-pushout) (S : Ob D) {
 module Q = HomologyFibre.Sequence[C, B, E, P, i, j, u, v, s, po, S] ;
 module Lc = MayerVietorisLoop.Connecting[C, B, E, P, i, j, u, v, s, po, S] ;
 module F = Q.F ;
 back-point : Id (Hom D S C) (Q.comparison-equiv.sec F.point) (zmap S C) =
  H.transH (H.apH Q.comparison-equiv.sec (H.symH Q.comparison-point))
   (Pl.sec-ret (Hom D S C) F.Cone Q.comparison Q.comparison-equiv (zmap S C)) ;
 cone-comm (a b : Id F.Cone F.point F.point) :
  Id (Id F.Cone F.point F.point) (H.transH a b) (H.transH b a) =
  EckmannHilton.comm-transfer F.Cone (Hom D S C) Q.comparison-equiv.sec
   (EL.inverse (Hom D S C) F.Cone (Q.comparison, Q.comparison-equiv)).2
   F.point (zmap S C) back-point (stable-comm S C) a b ;
 module Comm = CommutingLoops.Target[F.Cone, F.point, cone-comm] ;
 boundary-point : Id F.Cone (F.boundary (refl (zmap S P))) F.point =
  H.apH F.flatten F.Raw.boundary-zero ;
 module Boundary = PM.Pointed[LoopOf[S].Om P, F.Cone, refl (zmap S P), F.point, F.boundary, boundary-point] ;
 module Factor = Comm.Factor[LoopOf[S].Om P, F.Q.F, refl (zmap S P), F.Q.point,
  F.witness, \ w -> w.1, F.boundary, F.witness-point, refl F.point, boundary-point, F.over] ;
 cone-law (g : Hom D (susp S) P) :
  Id F.Cone (Q.comparison (Lc.X.M.delta g)) (F.boundary (LoopOf[S].L P g)) =
  H.apH F.flatten (Lc.X.M.pull.sec-eq (Lc.X.M.delta-cone g)) ;
 module Square = Comm.Square[Hom D (susp S) P, Hom D S C, LoopOf[S].Om P,
  zmap (susp S) P, zmap S C, refl (zmap S P),
  Lc.X.M.delta, F.boundary, LoopOf[S].L P, Q.comparison,
  Lc.X.delta-point-path, boundary-point, LoopOf[S].L-zero P, Q.comparison-point, cone-law] ;
 over (a : Q.A.grp.G) :
  Id LoopGrp[F.Cone, F.point].grp.G (Q.target.1 (Lc.map a)) (F.connecting (Q.source.1 a)) =
  H.transH (H.apH Q.Target.components.1 (Lc.square a))
   (H.transH (Square.groups (Q.A.e.1 a)) (H.symH (Factor.groups (Q.source.1 a)))) ;
 equal (a : Q.A.grp.G) : Id Q.B.grp.G (Q.connecting a) (Lc.map a) =
  Equivalences[l].injective Q.B.grp.G LoopGrp[F.Cone, F.point].grp.G Q.target.1 Q.target.2
   (Q.connecting a) (Lc.map a)
   (H.transH (Q.target.2.sec-eq (F.connecting (Q.source.1 a))) (H.symH (over a))) ;
} ;
