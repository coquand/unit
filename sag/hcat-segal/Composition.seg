-- Select the long edge of the contractible 2-horn filler type.
-- Every triangle identifies that selected edge with its long edge.
-- Keep the filler as well: subsequent normalization may use it.
open HigherCat ; open Constructions ;
module H = Paths[l] ; module CU = FunExtUA[l] ;

hcomp {C : Cat} {a b c : Ob C} (f : Hom C a b) (g : Hom C b c) : Hom C a c = (horn2 C f g).1.1 ;

triangle {C : Cat} {a b c : Ob C} (f : Hom C a b) (g : Hom C b c) : cell2 C f g (hcomp f g) = (horn2 C f g).1.2 ;

triangle-path {C : Cat} {a b c : Ob C} (f : Hom C a b) (g : Hom C b c) (h : Hom C a c)
 (t : cell2 C f g h) : Id (Hom C a c) (hcomp f g) h =
 H.apH (\ w -> w.1) ((horn2 C f g).2 (h, t)) ;

opaque hcomp ;
