-- A normalized tetrahedron has all four composition triangles and a
-- comparison of their two pastings. Its associator is the one selected
-- by horn3, not a parameter. For a fixed Lambda^3_1 horn, filling this
-- normalized family is the fibre of concatenation by an invertible path;
-- it is contractible. Thus this really is a semi-Segal 3-skeleton.
open HigherCat ; open Constructions ; open Composition ; open Associativity ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module CU = FunExtUA[l] ;

module Face (C : Cat) (a b c d : Ob C)
 (f : Hom C a b) (g : Hom C b c) (h : Hom C c d)
 (fg : Hom C a c) (gh : Hom C b d) (fgh : Hom C a d)
 (p : Id (Hom C a c) (hcomp f g) fg)
 (q : Id (Hom C b d) (hcomp g h) gh)
 (r : Id (Hom C a d) (hcomp f gh) fgh) {
 left : Id (Hom C a d) (hcomp (hcomp f g) h) (hcomp fg h) = H.apH (\ u -> hcomp u h) p ;
 right : Id (Hom C a d) (hcomp (hcomp f g) h) fgh =
  H.transH (H.transH (hcomp-assoc C (a, b, c, d, f, g, h)) (H.apH (\ u -> hcomp f u) q)) r ;
 Cell (s : Id (Hom C a d) (hcomp fg h) fgh) : U l =
  Id (Id (Hom C a d) (hcomp (hcomp f g) h) fgh) (H.transH left s) right ;
 contractible : CU.isContr ((s : Id (Hom C a d) (hcomp fg h) fgh) * Cell s) =
  FibreLemmas.equiv-fibre-contr (Id (Hom C a d) (hcomp fg h) fgh)
   (Id (Hom C a d) (hcomp (hcomp f g) h) fgh) (\ s -> H.transH left s)
   (SigmaEquiv.pre-comp-path-equiv {Hom C a d} {hcomp (hcomp f g) h} {hcomp fg h} {fgh} left).2 right ;
} ;

Cell (C : Cat) (h : SemiSegalBoundary3.Horn[C]) (s : SemiSegalBoundary3.Missing C h) : U l =
 Face[C, h.x0, h.x1, h.x2, h.x3, h.e01, h.e12, h.e23, h.e02, h.e13, h.e03, h.q012, h.q123, h.q013].Cell s ;

contractible (C : Cat) (h : SemiSegalBoundary3.Horn[C]) :
 CU.isContr ((s : SemiSegalBoundary3.Missing C h) * Cell C h s) =
 Face[C, h.x0, h.x1, h.x2, h.x3, h.e01, h.e12, h.e23, h.e02, h.e13, h.e03, h.q012, h.q123, h.q013].contractible ;

canonical-cell (C : Cat) {a b c d : Ob C} (f : Hom C a b) (g : Hom C b c) (h : Hom C c d) :
 Cell C (SemiSegalBoundary3.canonical C f g h) (hcomp-assoc C (a, b, c, d, f, g, h)) =
 PA.unit-l (hcomp-assoc C (a, b, c, d, f, g, h)) ;
