-- The loop-difference formula for arbitrary basepoint paths.
-- If u:f b=z and v:g e=z, the boundary cone of q is
-- (b,e,u.(q.v^-1)). Its kernel consists of
-- conj u (ap f a) . (conj v (ap g c))^-1.
-- First prove this path equation by J on u and v. At reflexivity it
-- is cancellation in the path groupoid. Apply the result to the square
-- of a path of cones. This retains the specified basepoint paths.
level l ; open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open Conj[l] ;

difference {P : U l} {x y z : P} (u : Id P x z) (v : Id P y z)
 (a : Id P x x) (c : Id P y y) : Id P z z =
 H.transH (conj u a) (H.symH (conj v c)) ;

solve-base {P : U l} {z : P} (a c q : Id P z z)
 (h : Id (Id P z z) a (H.transH (H.transH (refl z) q) c)) :
 Id (Id P z z) q (difference (refl z) (refl z) a c) =
 H.transH (H.symH (PA.unit-l q))
  (H.transH (H.symH (PA.canc-r c (H.transH (refl z) q)))
   (H.transH (H.apH (\ r -> H.transH r (H.symH c)) (H.symH h))
    (H.symH (PA.tcong (PA.unit-l a) (H.apH (\ r -> H.symH r) (PA.unit-l c)))))) ;

square-base {P : U l} {z : P} (a c : Id P z z) :
 Id (Id P z z) a (H.transH (H.transH (refl z) (difference (refl z) (refl z) a c)) c) =
 H.symH (H.transH (H.apH (\ r -> H.transH r c) (PA.unit-l (difference (refl z) (refl z) a c)))
  (H.transH (H.apH (\ r -> H.transH r c) (PA.tcong (PA.unit-l a) (H.apH (\ r -> H.symH r) (PA.unit-l c))))
   (PullbackBoundary[l].end-cancel c a))) ;

solve {P : U l} {z : P} (x : P) (u : Id P x z) (y : P) (v : Id P y z)
 (a : Id P x x) (c : Id P y y) (q : Id P z z)
 (h : Id (Id P x y) (H.transH a (H.transH u (H.symH v)))
   (H.transH (H.transH u (H.transH q (H.symH v))) c)) :
 Id (Id P z z) q (difference u v a c) =
 H.idJR P z (\ x1 u1 -> (y1 : P) (v1 : Id P y1 z) (a1 : Id P x1 x1) (c1 : Id P y1 y1) (q1 : Id P z z) ->
   Id (Id P x1 y1) (H.transH a1 (H.transH u1 (H.symH v1))) (H.transH (H.transH u1 (H.transH q1 (H.symH v1))) c1) ->
   Id (Id P z z) q1 (difference u1 v1 a1 c1))
  (\ y1 v1 -> H.idJR P z (\ y2 v2 -> (a1 : Id P z z) (c1 : Id P y2 y2) (q1 : Id P z z) ->
    Id (Id P z y2) (H.transH a1 (H.transH (refl z) (H.symH v2)))
     (H.transH (H.transH (refl z) (H.transH q1 (H.symH v2))) c1) ->
    Id (Id P z z) q1 (difference (refl z) v2 a1 c1))
   (\ a1 c1 q1 h1 -> solve-base a1 c1 q1 h1) y1 v1) x u y v a c q h ;

square {P : U l} {z : P} (x : P) (u : Id P x z) (y : P) (v : Id P y z)
 (a : Id P x x) (c : Id P y y) :
 Id (Id P x y) (H.transH a (H.transH u (H.symH v)))
  (H.transH (H.transH u (H.transH (difference u v a c) (H.symH v))) c) =
 H.idJR P z (\ x1 u1 -> (y1 : P) (v1 : Id P y1 z) (a1 : Id P x1 x1) (c1 : Id P y1 y1) ->
   Id (Id P x1 y1) (H.transH a1 (H.transH u1 (H.symH v1)))
    (H.transH (H.transH u1 (H.transH (difference u1 v1 a1 c1) (H.symH v1))) c1))
  (\ y1 v1 -> H.idJR P z (\ y2 v2 -> (a1 : Id P z z) (c1 : Id P y2 y2) ->
    Id (Id P z y2) (H.transH a1 (H.transH (refl z) (H.symH v2)))
     (H.transH (H.transH (refl z) (H.transH (difference (refl z) v2 a1 c1) (H.symH v2))) c1))
   (\ a1 c1 -> square-base a1 c1) y1 v1) x u y v a c ;

module Boundary (B E P : U l) (f : B -> P) (g : E -> P) (b : B) (e : E) (z : P)
 (u : Id P (f b) z) (v : Id P (g e) z) {
 module Q = PullbackPaths[l].Pull[B, E, P, f, g] ;
 base : Q.Cone = (b, e, H.transH u (H.symH v)) ;
 boundary (q : Id P z z) : Q.Cone = (b, e, H.transH u (H.transH q (H.symH v))) ;
 boundary-zero : Id Q.Cone (boundary (refl z)) base =
  H.apH (\ r -> (b, e, H.transH u r)) (PA.unit-l (H.symH v)) ;
 diff (a : Id B b b) (c : Id E e e) : Id P z z = difference u v (H.apH f a) (H.apH g c) ;
 diff-zero (a : Id B b b) (c : Id E e e) : Id Q.Cone (boundary (diff a c)) base =
  Q.path b b a e e c (H.transH u (H.transH (diff a c) (H.symH v))) (H.transH u (H.symH v))
   (square (f b) u (g e) v (H.apH f a) (H.apH g c)) ;
 lift (q : Id P z z) (h : Id Q.Cone (boundary q) base) :
  (a : Id B b b) * (c : Id E e e) * Id (Id P z z) q (diff a c) =
  (H.apH (\ w -> w.1) h, H.apH (\ w -> w.2.1) h,
   solve (f b) u (g e) v (H.apH f (H.apH (\ w -> w.1) h)) (H.apH g (H.apH (\ w -> w.2.1) h)) q
    (Q.cell (boundary q) base h)) ;
} ;
