-- On pi_1 of a loop space, the map (p,q) |-> p.q^-1 induces group
-- difference. Differentiate concatenation and inverse by path induction;
-- Eckmann-Hilton identifies the resulting whiskerings with composition.
-- For arbitrary pointed maps into the loop space, factor through the
-- product. CommutingLoops makes the chosen pointing paths immaterial.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module PM = Pi0Maps[l] ;
open Pi0[l] ;

ap-binary (A B C Z : U l) (op : B -> C -> Z) (f : A -> B) (g : A -> C)
 (x y : A) (r : Id A x y) :
 Id (Id Z (op (f x) (g x)) (op (f y) (g y)))
  (H.apH (\ t -> op (f t) (g t)) r)
  (H.transH (H.apH (\ t -> op t (g x)) (H.apH f r)) (H.apH (op (f y)) (H.apH g r))) =
 idJ A x (\ y1 r1 -> Id (Id Z (op (f x) (g x)) (op (f y1) (g y1)))
   (H.apH (\ t -> op (f t) (g t)) r1)
   (H.transH (H.apH (\ t -> op t (g x)) (H.apH f r1)) (H.apH (op (f y1)) (H.apH g r1))))
  (refl (refl (op (f x) (g x)))) y r ;

module At (W : U l) (w : W) {
 O : U l = Id W w w ;
 o : O = refl w ;
 module L = LoopGrp[O, o] ;
 module Comm = CommutingLoops.Target[O, o, \ a b -> EckmannHilton.eckmann-hilton a b] ;
 inverse-product (r : Id O o o) :
  Id (Id O o o) (H.apH (\ t -> H.transH t (H.symH t)) r) (H.transH r (H.apH (\ t -> H.symH t) r)) =
  H.transH (ap-binary O O O O (\ a b -> H.transH a b) (\ t -> t) (\ t -> H.symH t) o o r)
   (PA.tcong (H.transH (PA.ap-id (H.apH (\ t -> t) r)) (PA.ap-id r))
    (EckmannHilton.whisker-l (H.apH (\ t -> H.symH t) r))) ;
 inverse-zero (r : Id O o o) :
  Id (Id O o o) (H.transH r (H.apH (\ t -> H.symH t) r)) (refl o) =
  H.transH (H.symH (inverse-product r))
   (H.transH (EckmannHilton.ap-htpy (\ t -> H.transH t (H.symH t)) (\ t -> o) (\ t -> PA.inv-r t) r)
    (H.transH (PA.unit-l (H.apH (\ t -> o) r)) (PA.ap-constant o r))) ;
 inverse (r : Id O o o) : Id (Id O o o) (H.apH (\ t -> H.symH t) r) (H.symH r) =
  H.transH (H.symH (PA.canc-l r (H.apH (\ t -> H.symH t) r)))
   (H.apH (\ t -> H.transH (H.symH r) t) (inverse-zero r)) ;
 difference (t : O * O) : O = H.transH t.1 (H.symH t.2) ;
 module Binary = PM.Pointed[O * O, O, (o, o), o, difference, refl o] ;
 module Product = Pi1Product[l].Product[O, O, o, o] ;
 derivative (r : Id (O * O) (o, o) (o, o)) :
  Id (Id O o o) (H.apH difference r)
   (H.transH (H.apH (\ t -> t.1) r) (H.symH (H.apH (\ t -> t.2) r))) =
  H.transH (ap-binary (O * O) O O O (\ a b -> H.transH a b) (\ t -> t.1) (\ t -> H.symH t.2) (o, o) (o, o) r)
   (PA.tcong (PA.ap-id (H.apH (\ t -> t.1) r))
    (H.transH (EckmannHilton.whisker-l (H.apH (\ t -> H.symH t.2) r))
     (H.transH (H.symH (PA.ap-comp (\ t -> H.symH t) (\ t -> t.2) r)) (inverse (H.apH (\ t -> t.2) r))))) ;
 loops (r : Id (O * O) (o, o) (o, o)) :
  Id (Id O o o) (Binary.loop r) (H.transH (Product.Fst.loop r) (H.symH (Product.Snd.loop r))) =
  H.transH (Conj[l].conj-refl-path (H.apH difference r))
   (H.transH (derivative r)
    (H.symH (PA.tcong (Conj[l].conj-refl-path (H.apH (\ t -> t.1) r))
     (H.apH (\ t -> H.symH t) (Conj[l].conj-refl-path (H.apH (\ t -> t.2) r)))))) ;
 classes (r : Id (O * O) (o, o) (o, o)) :
  Id L.grp.G (Binary.M.map (cls r)) (PM.diff L.grp (Product.Fst.M.map (cls r)) (Product.Snd.M.map (cls r))) =
  H.transH (pi0-map-cls (Id (O * O) (o, o) (o, o)) (Id O o o) Binary.loop r)
   (H.transH (H.apH (\ t -> cls t) (loops r))
    (H.transH (H.symH (L.cl-mul (Product.Fst.loop r) (H.symH (Product.Snd.loop r))))
     (H.transH (H.apH (L.grp.mul (cls (Product.Fst.loop r))) (H.symH (L.cl-inv (Product.Snd.loop r))))
      (H.transH (H.apH (\ t -> PM.diff L.grp t (cls (Product.Snd.loop r)))
        (H.symH (pi0-map-cls (Id (O * O) (o, o) (o, o)) (Id O o o) Product.Fst.loop r)))
       (H.apH (PM.diff L.grp (Product.Fst.M.map (cls r)))
        (H.symH (pi0-map-cls (Id (O * O) (o, o) (o, o)) (Id O o o) Product.Snd.loop r))))))) ;
 groups (r : Product.G.grp.G) :
  Id L.grp.G (Binary.M.map r) (PM.diff L.grp (Product.Fst.M.map r) (Product.Snd.M.map r)) =
  pi0-ind (Id (O * O) (o, o) (o, o)) @l
   (\ r1 -> Id L.grp.G (Binary.M.map r1) (PM.diff L.grp (Product.Fst.M.map r1) (Product.Snd.M.map r1)))
   (\ r1 -> L.grp.setG (Binary.M.map r1) (PM.diff L.grp (Product.Fst.M.map r1) (Product.Snd.M.map r1))) classes r ;

 module Maps (Y : U l) (y : Y) (f g : Y -> O) (p : Id O (f y) o) (q : Id O (g y) o)
  (d : Id O (H.transH (f y) (H.symH (g y))) o) {
  pair (t : Y) : O * O = (f t, g t) ;
  point : Id (O * O) (pair y) (o, o) = EquivAp[l].pair-path p q ;
  module F = PM.Pointed[Y, O, y, o, f, p] ;
  module G = PM.Pointed[Y, O, y, o, g, q] ;
  module K = PM.Pointed[Y, O * O, y, (o, o), pair, point] ;
  module DMap = PM.Pointed[Y, O, y, o, \ t -> H.transH (f t) (H.symH (g t)), d] ;
  module Left = Comm.Factor[Y, O * O, y, (o, o), pair, \ t -> t.1, f, point, refl o, p, \ t -> refl (f t)] ;
  module Right = Comm.Factor[Y, O * O, y, (o, o), pair, \ t -> t.2, g, point, refl o, q, \ t -> refl (g t)] ;
  module Diff = Comm.Factor[Y, O * O, y, (o, o), pair, difference, \ t -> H.transH (f t) (H.symH (g t)),
   point, refl o, d, \ t -> refl (H.transH (f t) (H.symH (g t)))] ;
  formula (r : LoopGrp[Y, y].grp.G) :
   Id L.grp.G (DMap.M.map r) (PM.diff L.grp (F.M.map r) (G.M.map r)) =
   H.transH (H.symH (Diff.groups r))
    (H.transH (groups (K.M.map r))
     (H.transH (H.apH (\ t -> PM.diff L.grp t (Product.Snd.M.map (K.M.map r))) (Left.groups r))
      (H.apH (PM.diff L.grp (F.M.map r)) (Right.groups r)))) ;
 } ;
} ;
