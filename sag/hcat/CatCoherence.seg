-- Level-2 coherence: the two other triangles of Mac Lane, from the
-- pentagon and the triangle (Agda Foundations/Coherence, second half;
-- Rocq Id_triangle1/3), and the unit loop of the product pentagon (Agda
-- Solvers/PastingTest; Rocq dsl_C injr_unit_loop).  Parameters of Coh2:
-- pentagonator, triangle2.
--
-- triangle1:  a(1, g, f) . l(g f) = l(g) o f.
--   Whiskering by 1 on the left is injective (cancel-ccr-Id), so it is
--   enough to show 1 o (a1 . lgf) = 1 o (lg o f), where a1 = a(1, g, f),
--   lgf = l(g f), lg = l(g).  Put P = a(1,1,g) o f and a1b = a(1, 1 g, f).
--   The pentagon at (1, 1, g, f) is  b . c = (P . a1b) . (1 o a1)  with
--   b = a(1 1, g, f), c = a(1, 1, g f).  Then
--     (P . a1b) . ((1 o a1) . (1 o lgf))
--     = (b . c) . (1 o lgf) = b . (c . (1 o lgf))
--     = b . (r(1) o (g f))                          (triangle2 at (g f, 1))
--     = ((r(1) o g) o f) . a1                       (naturality of a in 1)
--     = (P . ((1 o lg) o f)) . a1                   (triangle2 at (g, 1), whiskered)
--     = P . ((1 o lg) o f . a1)
--     = P . (a1b . (1 o (lg o f)))                  (naturality of a in 2)
--     = (P . a1b) . (1 o (lg o f)),
--   and P . a1b cancels.
-- triangle3:  a(g, f, 1) . (g o r(f)) = r(g f), symmetrically: whiskering
--   by 1 on the right is injective; with P3 = a(g,f,1) o 1 the pentagon at
--   (g, f, 1, 1), triangle2 at (1, g f) and at (1, f), and the naturality
--   of a in 2 and 3 give  (P3 . ((g o r f) o 1)) . a3 = (r(g f) o 1) . a3,
--   and a3 = a(g, f, 1) cancels on the right.
-- unit-loop: for any i : x -> y, the loop
--   (l1 o (1 i))^-1 . a(1,1,1 i) . (1 o a(1,1,i))^-1 . (1 o (l1 o i))
-- at 1 (1 i) is refl.  By triangle1 at (i, 1), 1 o (l1 o i) =
-- (1 o a(1,1,i)) . (1 o l(1 i)), so the last two factors give 1 o l(1 i);
-- by triangle1 at (1 i, 1), a(1,1,1 i) = (l1 o (1 i)) . l(1 (1 i))^-1; and
-- l(1 (1 i)) = 1 o l(1 i) by naturality of l.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open Naturality ;

triangle1 {A B C : Cat} (f : Map A B) (g : Map B C) :
 Id (Id (Map A C) (comp (comp (idMap C) g) f) (comp g f))
  (H.transH (composeA (idMap C) g f) (comp-id-l (comp g f))) (ccl f (comp-id-l g)) =
 cancel-ccr-Id (H.transH a1 ilgf) (ccl f ilg)
  (H.transH (PA.ap-trans (\ m -> comp C0 m) a1 ilgf) (PA.cancel-l (H.transH P a1b) (H.transH lhs (H.symH rhs))))
 where {
  C0 : Map C C = idMap C ;
  ilg : Id (Map B C) (comp C0 g) g = comp-id-l g ;
  ilgf : Id (Map A C) (comp C0 (comp g f)) (comp g f) = comp-id-l (comp g f) ;
  eps : Id (Map C C) (comp C0 C0) C0 = comp-id-r C0 ;
  a1 : Id (Map A C) (comp (comp C0 g) f) (comp C0 (comp g f)) = composeA C0 g f ;
  a1b : Id (Map A C) (comp (comp C0 (comp C0 g)) f) (comp C0 (comp (comp C0 g) f)) = composeA C0 (comp C0 g) f ;
  ag : Id (Map B C) (comp (comp C0 C0) g) (comp C0 (comp C0 g)) = composeA C0 C0 g ;
  bb : Id (Map A C) (comp (comp (comp C0 C0) g) f) (comp (comp C0 C0) (comp g f)) = composeA (comp C0 C0) g f ;
  cc : Id (Map A C) (comp (comp C0 C0) (comp g f)) (comp C0 (comp C0 (comp g f))) = composeA C0 C0 (comp g f) ;
  P : Id (Map A C) (comp (comp (comp C0 C0) g) f) (comp (comp C0 (comp C0 g)) f) = ccl f ag ;
  flip : Id (Id (Map A C) (comp (comp (comp C0 C0) g) f) (comp (comp C0 g) f))
   (ccl f (ccl g eps)) (H.transH P (ccl f (ccr C0 ilg))) =
   H.transH (H.symH (H.apH (\ p -> ccl f p) (triangle2 g C0))) (PA.ap-trans (\ m -> comp m f) ag (ccr C0 ilg)) ;
  lhs : Id (Id (Map A C) (comp (comp (comp C0 C0) g) f) (comp C0 (comp g f)))
   (H.transH (H.transH P a1b) (H.transH (ccr C0 a1) (ccr C0 ilgf))) (H.transH P (H.transH (ccl f (ccr C0 ilg)) a1)) =
   H.transH (H.symH (PA.tassoc (H.transH P a1b) (ccr C0 a1) (ccr C0 ilgf)))
   (H.transH (H.apH (\ z -> H.transH z (ccr C0 ilgf)) (H.symH (pentagonator C0 C0 g f)))
   (H.transH (PA.tassoc bb cc (ccr C0 ilgf))
   (H.transH (H.apH (\ z -> H.transH bb z) (triangle2 (comp g f) C0))
   (H.transH (compose-naturality1 g f eps)
   (H.transH (H.apH (\ z -> H.transH z a1) flip)
    (PA.tassoc P (ccl f (ccr C0 ilg)) a1)))))) ;
  rhs : Id (Id (Map A C) (comp (comp (comp C0 C0) g) f) (comp C0 (comp g f)))
   (H.transH (H.transH P a1b) (ccr C0 (ccl f ilg))) (H.transH P (H.transH (ccl f (ccr C0 ilg)) a1)) =
   H.transH (PA.tassoc P a1b (ccr C0 (ccl f ilg))) (H.apH (\ z -> H.transH P z) (compose-naturality2 C0 f ilg)) ;
 } ;

triangle3 {A B C : Cat} (f : Map A B) (g : Map B C) :
 Id (Id (Map A C) (comp (comp g f) (idMap A)) (comp g f))
  (H.transH (composeA g f (idMap A)) (ccr g (comp-id-r f))) (comp-id-r (comp g f)) =
 cancel-ccl-Id (H.transH a3 (ccr g irf)) irgf
  (H.transH (PA.ap-trans (\ m -> comp m A0) a3 (ccr g irf)) (PA.cancel-r a3 t3))
 where {
  A0 : Map A A = idMap A ;
  irf : Id (Map A B) (comp f A0) f = comp-id-r f ;
  irgf : Id (Map A C) (comp (comp g f) A0) (comp g f) = comp-id-r (comp g f) ;
  del : Id (Map A A) (comp A0 A0) A0 = comp-id-l A0 ;
  a3 : Id (Map A C) (comp (comp g f) A0) (comp g (comp f A0)) = composeA g f A0 ;
  a3c : Id (Map A C) (comp (comp g (comp f A0)) A0) (comp g (comp (comp f A0) A0)) = composeA g (comp f A0) A0 ;
  af3 : Id (Map A B) (comp (comp f A0) A0) (comp f (comp A0 A0)) = composeA f A0 A0 ;
  b3 : Id (Map A C) (comp (comp (comp g f) A0) A0) (comp (comp g f) (comp A0 A0)) = composeA (comp g f) A0 A0 ;
  c3 : Id (Map A C) (comp (comp g f) (comp A0 A0)) (comp g (comp f (comp A0 A0))) = composeA g f (comp A0 A0) ;
  P3 : Id (Map A C) (comp (comp (comp g f) A0) A0) (comp (comp g (comp f A0)) A0) = ccl A0 a3 ;
  ggstep : Id (Id (Map A C) (comp g (comp (comp f A0) A0)) (comp g (comp f A0)))
   (ccr g (ccl A0 irf)) (H.transH (ccr g af3) (ccr g (ccr f del))) =
   H.transH (H.symH (H.apH (\ p -> ccr g p) (triangle2 A0 f))) (PA.ap-trans (\ m -> comp g m) af3 (ccr f del)) ;
  t3 : Id (Id (Map A C) (comp (comp (comp g f) A0) A0) (comp g (comp f A0)))
   (H.transH (H.transH P3 (ccl A0 (ccr g irf))) a3) (H.transH (ccl A0 irgf) a3) =
   H.transH (PA.tassoc P3 (ccl A0 (ccr g irf)) a3)
   (H.transH (H.apH (\ z -> H.transH P3 z) (H.symH (compose-naturality2 g A0 irf)))
   (H.transH (H.apH (\ z -> H.transH P3 (H.transH a3c z)) ggstep)
   (H.transH (H.apH (\ z -> H.transH P3 z) (H.symH (PA.tassoc a3c (ccr g af3) (ccr g (ccr f del)))))
   (H.transH (H.symH (PA.tassoc P3 (H.transH a3c (ccr g af3)) (ccr g (ccr f del))))
   (H.transH (H.apH (\ z -> H.transH z (ccr g (ccr f del))) (H.symH (PA.tassoc P3 a3c (ccr g af3))))
   (H.transH (H.apH (\ z -> H.transH z (ccr g (ccr f del))) (H.symH (pentagonator g f A0 A0)))
   (H.transH (PA.tassoc b3 c3 (ccr g (ccr f del)))
   (H.transH (H.apH (\ z -> H.transH b3 z) (compose-naturality3 g f del))
   (H.transH (H.symH (PA.tassoc b3 (ccr (comp g f) del) a3))
    (H.apH (\ z -> H.transH z a3) (triangle2 A0 (comp g f)))))))))))) ;
 } ;

unit-loop {x y : Cat} (i : Map x y) :
 Id (Id (Map x y) (comp (idMap y) (comp (idMap y) i)) (comp (idMap y) (comp (idMap y) i)))
  (H.transH (H.symH (ccl (comp (idMap y) i) (comp-id-l (idMap y))))
   (H.transH (composeA (idMap y) (idMap y) (comp (idMap y) i))
    (H.transH (H.symH (ccr (idMap y) (composeA (idMap y) (idMap y) i)))
     (ccr (idMap y) (ccl i (comp-id-l (idMap y)))))))
  (refl (comp (idMap y) (comp (idMap y) i))) =
 H.transH (H.apH (\ z -> H.transH a0 (H.transH b0 z)) step1)
 (H.transH (H.apH (\ z -> H.transH a0 z) step2)
 (H.transH (PA.canc-l (ccl idi (comp-id-l iy)) (H.transH (H.symH (comp-id-l big)) (ccr iy (comp-id-l idi))))
 (H.transH (H.apH (\ z -> H.transH (H.symH z) (ccr iy (comp-id-l idi))) e3)
  (PA.inv-l (ccr iy (comp-id-l idi))))))
 where {
  iy : Map y y = idMap y ;
  idi : Map x y = comp iy i ;
  big : Map x y = comp iy idi ;
  a0 : Id (Map x y) (comp iy (comp iy i)) (comp (comp iy iy) idi) = H.symH (ccl idi (comp-id-l iy)) ;
  b0 : Id (Map x y) (comp (comp iy iy) idi) (comp iy (comp iy idi)) = composeA iy iy idi ;
  step1 : Id (Id (Map x y) (comp iy (comp iy idi)) (comp iy idi))
   (H.transH (H.symH (ccr iy (composeA iy iy i))) (ccr iy (ccl i (comp-id-l iy)))) (ccr iy (comp-id-l idi)) =
   H.transH (H.apH (\ z -> H.transH (H.symH (ccr iy (composeA iy iy i))) z)
     (H.transH (H.apH (\ p -> ccr iy p) (H.symH (triangle1 i iy))) (PA.ap-trans (\ m -> comp iy m) (composeA iy iy i) (comp-id-l idi))))
    (PA.canc-l (ccr iy (composeA iy iy i)) (ccr iy (comp-id-l idi))) ;
  e4 : Id (Id (Map x y) (comp (comp iy iy) idi) (comp iy (comp iy idi))) b0 (H.transH (ccl idi (comp-id-l iy)) (H.symH (comp-id-l big))) =
   PA.cancel-r (comp-id-l big)
    (H.transH (triangle1 idi iy)
     (H.symH (H.transH (PA.tassoc (ccl idi (comp-id-l iy)) (H.symH (comp-id-l big)) (comp-id-l big))
       (H.apH (\ z -> H.transH (ccl idi (comp-id-l iy)) z) (PA.inv-l (comp-id-l big)))))) ;
  step2 : Id (Id (Map x y) (comp (comp iy iy) idi) (comp iy idi))
   (H.transH b0 (ccr iy (comp-id-l idi)))
   (H.transH (ccl idi (comp-id-l iy)) (H.transH (H.symH (comp-id-l big)) (ccr iy (comp-id-l idi)))) =
   H.transH (H.apH (\ z -> H.transH z (ccr iy (comp-id-l idi))) e4)
    (PA.tassoc (ccl idi (comp-id-l iy)) (H.symH (comp-id-l big)) (ccr iy (comp-id-l idi))) ;
  e3 : Id (Id (Map x y) (comp iy big) big) (comp-id-l big) (ccr iy (comp-id-l idi)) =
   PA.cancel-r (comp-id-l idi) (IdKl-nat (comp-id-l idi)) ;
 } ;
