-- The loop equivalence (H4): Hom (Sigma S, T) ~ Omega (Hom (S, T), 0),
-- natural in T.  Naturality uses the pentagon of D (hpent).
--   Q: the suspension square 0 <- S -> 0 (legs zt S, both maps
--   zi (Sigma S), 2-cell merid S), a pushout (susp-po).
--   L T g: the cocone of g, (n g, n g, cp g) with n = zi (Sigma S) and
--   cp g = conj al(zt S, n, g) (merid g), moved by ContrLoop
--   (Hom (0, T) is contractible) to the loop
--     L T g = conj (zt (zi-eq (n g))) (cp g)   at zmap S T   (L-def).
--   L-equiv: susp-po, then ContrLoop.kappa-equiv.
--   L-nat: for f : T -> T1, L T1 (g f) = conj (zero-post S f) ((L T g) f).
-- Proof.  Write z = zt S, m = merid S, al = hcomp-assoc, and
--   A1 = z (zi-eq (n g)), A2 = z (zi-eq (n (g f))).  The left side is
--   conj (al(z,n,gf) . A2) (m (gf)) (conj-trans).  The right side is, by
--   ap-conj and conj-trans, conj ((al(z,n,g) f . A1 f) . zero-post f)
--   ((m g) f), and (m g) f = conj al(zn,g,f)^-1 (m (gf)) by naturality of
--   the associator (assoc-nat-l, conj-square).  The conjugators agree:
--   by the pentagon at (z, n, g, f),
--     al(z,n,gf) = al(zn,g,f)^-1 . ((al(z,n,g) f . al(z,ng,f)) . z al(n,g,f)),
--   and it remains al(z,ng,f) . (z al(n,g,f) . A2) = A1 f . zero-post f
--   (nat-tail): by J on zi-eq (n g), both sides end with z applied to a
--   path in the set Hom (0, T1).
--   L-zero: L T 0 = refl.  The zero map zt (Sigma S) . zi T factors
--   through 0, so by L-nat it is conj zero-post of (a loop in the
--   contractible Hom (S, 0)) zi T, i.e. conj zero-post refl = refl.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ; open AssocNat ; open DPushout ;
open Conj[l] ; open Zero ;

module LoopOf (S : Ob D) {
 module Q = DSquare[S, zobj, zobj, susp S, zt S, zt S, zi (susp S), zi (susp S), merid S] ;
 Om (T : Ob D) : U l = Id (Hom D S T) (zmap S T) (zmap S T) ;

 L (T : Ob D) (g : Hom D (susp S) T) : Om T =
  FibreAlg.ContrLoop[Hom D zobj T, Hom D S T, zero-init T, \ x -> hcomp {D} (zt S) x].kappa (Q.cocone-map T g) ;

 L-equiv (T : Ob D) : Pl.isEquiv (Hom D (susp S) T) (Om T) (L T) =
  EL.compose (Hom D (susp S) T) (Q.Cocone T) (Om T)
   (FibreAlg.ContrLoop[Hom D zobj T, Hom D S T, zero-init T, \ x -> hcomp {D} (zt S) x].kappa) (Q.cocone-map T)
   FibreAlg.ContrLoop[Hom D zobj T, Hom D S T, zero-init T, \ x -> hcomp {D} (zt S) x].kappa-equiv (susp-po S T) ;

 L-def (T : Ob D) (g : Hom D (susp S) T) : Id (Om T) (L T g)
  (conj (H.apH (\ x -> hcomp {D} (zt S) x) (zi-eq (hcomp {D} (zi (susp S)) g)))
   (conj (hcomp-assoc D (S, zobj, susp S, T, zt S, zi (susp S), g)) (H.apH (\ w -> hcomp {D} w g) (merid S)))) =
  refl (L T g) ;

 opaque L ;

 -- the end of the conjugator comparison, by J on sigma
 nat-tail {T T1 : Ob D} (f : Hom D T T1) (t : Hom D zobj T) (sg : Id (Hom D zobj T) t (zi T)) :
  (rh : Id (Hom D zobj T1) (hcomp {D} t f) (zi T1)) ->
  Id (Id (Hom D S T1) (hcomp {D} (hcomp {D} (zt S) t) f) (zmap S T1))
   (H.transH (hcomp-assoc D (S, zobj, T, T1, zt S, t, f)) (H.apH (\ x -> hcomp {D} (zt S) x) rh))
   (H.transH (H.apH (\ w -> hcomp {D} w f) (H.apH (\ x -> hcomp {D} (zt S) x) sg)) (zero-post S f)) =
  H.idJR (Hom D zobj T) (zi T) (\ t1 sg1 -> (rh : Id (Hom D zobj T1) (hcomp {D} t1 f) (zi T1)) ->
    Id (Id (Hom D S T1) (hcomp {D} (hcomp {D} (zt S) t1) f) (zmap S T1))
     (H.transH (hcomp-assoc D (S, zobj, T, T1, zt S, t1, f)) (H.apH (\ x -> hcomp {D} (zt S) x) rh))
     (H.transH (H.apH (\ w -> hcomp {D} w f) (H.apH (\ x -> hcomp {D} (zt S) x) sg1)) (zero-post S f)))
   (\ rh -> H.transH (H.apH (\ r -> H.transH (hcomp-assoc D (S, zobj, T, T1, zt S, zi T, f)) (H.apH (\ x -> hcomp {D} (zt S) x) r))
      (zi-set T1 (hcomp {D} (zi T) f) (zi T1) rh (zi-eq (hcomp {D} (zi T) f))))
     (H.symH (PA.unit-l (zero-post S f)))) t sg ;

 module Nat (T T1 : Ob D) (g : Hom D (susp S) T) (f : Hom D T T1) {
  alA : Id (Hom D S T) (hcomp {D} (zmap S (susp S)) g) (hcomp {D} (zt S) (hcomp {D} (zi (susp S)) g)) =
   hcomp-assoc D (S, zobj, susp S, T, zt S, zi (susp S), g) ;
  alB : Id (Hom D S T1) (hcomp {D} (zmap S (susp S)) (hcomp {D} g f)) (hcomp {D} (zt S) (hcomp {D} (zi (susp S)) (hcomp {D} g f))) =
   hcomp-assoc D (S, zobj, susp S, T1, zt S, zi (susp S), hcomp {D} g f) ;
  alC : Id (Hom D S T1) (hcomp {D} (hcomp {D} (zmap S (susp S)) g) f) (hcomp {D} (zmap S (susp S)) (hcomp {D} g f)) =
   hcomp-assoc D (S, susp S, T, T1, zmap S (susp S), g, f) ;
  alD : Id (Hom D S T1) (hcomp {D} (hcomp {D} (zt S) (hcomp {D} (zi (susp S)) g)) f) (hcomp {D} (zt S) (hcomp {D} (hcomp {D} (zi (susp S)) g) f)) =
   hcomp-assoc D (S, zobj, T, T1, zt S, hcomp {D} (zi (susp S)) g, f) ;
  alE : Id (Hom D zobj T1) (hcomp {D} (hcomp {D} (zi (susp S)) g) f) (hcomp {D} (zi (susp S)) (hcomp {D} g f)) =
   hcomp-assoc D (zobj, susp S, T, T1, zi (susp S), g, f) ;
  A1 : Id (Hom D S T) (hcomp {D} (zt S) (hcomp {D} (zi (susp S)) g)) (zmap S T) =
   H.apH (\ x -> hcomp {D} (zt S) x) (zi-eq (hcomp {D} (zi (susp S)) g)) ;
  A2 : Id (Hom D S T1) (hcomp {D} (zt S) (hcomp {D} (zi (susp S)) (hcomp {D} g f))) (zmap S T1) =
   H.apH (\ x -> hcomp {D} (zt S) x) (zi-eq (hcomp {D} (zi (susp S)) (hcomp {D} g f))) ;
  mg : Id (Hom D S T) (hcomp {D} (zmap S (susp S)) g) (hcomp {D} (zmap S (susp S)) g) = H.apH (\ w -> hcomp {D} w g) (merid S) ;
  mgf : Id (Hom D S T1) (hcomp {D} (zmap S (susp S)) (hcomp {D} g f)) (hcomp {D} (zmap S (susp S)) (hcomp {D} g f)) =
   H.apH (\ w -> hcomp {D} w (hcomp {D} g f)) (merid S) ;

  tail : Id (Id (Hom D S T1) (hcomp {D} (hcomp {D} (zt S) (hcomp {D} (zi (susp S)) g)) f) (zmap S T1))
   (H.transH alD (H.transH (H.apH (\ x -> hcomp {D} (zt S) x) alE) A2)) (H.transH (H.apH (\ w -> hcomp {D} w f) A1) (zero-post S f)) =
   H.transH (H.apH (\ r -> H.transH alD r) (H.symH (PA.ap-trans (\ x -> hcomp {D} (zt S) x) alE (zi-eq (hcomp {D} (zi (susp S)) (hcomp {D} g f))))))
    (nat-tail f (hcomp {D} (zi (susp S)) g) (zi-eq (hcomp {D} (zi (susp S)) g)) (H.transH alE (zi-eq (hcomp {D} (zi (susp S)) (hcomp {D} g f))))) ;

  -- the conjugators agree, by the pentagon at (zt S, zi (Sigma S), g, f)
  conjugators : Id (Id (Hom D S T1) (hcomp {D} (zmap S (susp S)) (hcomp {D} g f)) (zmap S T1))
   (H.transH alB A2) (H.transH (H.symH alC) (H.transH (H.transH (H.apH (\ w -> hcomp {D} w f) alA) (H.apH (\ w -> hcomp {D} w f) A1)) (zero-post S f))) =
   pent-solve alC alB A2 (H.apH (\ w -> hcomp {D} w f) alA) alD (H.apH (\ x -> hcomp {D} (zt S) x) alE) (H.apH (\ w -> hcomp {D} w f) A1) (zero-post S f)
    (hpent (zt S) (zi (susp S)) g f) tail ;

  nat : Id (Om T1) (L T1 (hcomp {D} g f)) (conj (zero-post S f) (H.apH (\ w -> hcomp {D} w f) (L T g))) =
   H.transH (L-def T1 (hcomp {D} g f))
    (H.transH (nat-alg (\ w -> hcomp {D} w f) alA A1 mg alB A2 alC (zero-post S f) mgf
       (assoc-nat-l D (zmap S (susp S)) (zmap S (susp S)) (merid S) g f) conjugators)
     (H.symH (H.apH (\ r -> conj (zero-post S f) (H.apH (\ w -> hcomp {D} w f) r)) (L-def T g)))) ;
 } ;

 L-nat (T T1 : Ob D) (g : Hom D (susp S) T) (f : Hom D T T1) :
  Id (Om T1) (L T1 (hcomp {D} g f)) (conj (zero-post S f) (H.apH (\ w -> hcomp {D} w f) (L T g))) = Nat[T, T1, g, f].nat ;

 L-zero (T : Ob D) : Id (Om T) (L T (zmap (susp S) T)) (refl (zmap S T)) =
  H.transH (L-nat zobj T (zt (susp S)) (zi T))
   (H.transH (H.apH (\ r -> conj (zero-post S (zi T)) (H.apH (\ w -> hcomp {D} w (zi T)) r))
     (Pl.loop-refl (Hom D S zobj) (zt-set S) (zmap S zobj) (L zobj (zt (susp S)))))
    (conj-one (zero-post S (zi T)))) ;
} ;
