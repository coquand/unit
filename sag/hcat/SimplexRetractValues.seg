-- The vertex actions of sect, ret, face and the last edge, as ordinals
-- (Agda Simplices/SimplexRetractValues).  Each functor into a simplex is
-- determined by these (vob-ext: Delta n is posetal and c20 injective).
--   pre-face-val: pre-face-n sends phi to sn2-pr1 of its ordinal;
--   eval-val: eval-at-top reads its top value sn2-snd;
--   eval-at-top-top, pre-face-top: both at the top vertex.
--   last-edge-c20: the last edge sends I0, I1 to (n, top) and top.
--   ret-c20: ret sends (s, t) to thr-ord (s, t).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open ExpComparison ; open Exponentials ; open ExpEval ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open Construction20 ; open IntervalPosetal ;
open LastEdge ; open OrdComb ; open FaceMap ; open FaceOrdCompat ; open PosetalCore ; open FunIPosetal ;
open FaceTop ; open SegalCoface ; open SimplexRetract ;

Iob-inj (x y : Ob I) (p : Id Two (I-ob.1 x) (I-ob.1 y)) : Id (Ob I) x y =
 Equivalences[l].injective (Ob I) Two I-ob.1 I-ob.2 x y p ;

sect-pi1 (n : Nat) : Id (Map (Delta (suc (suc n))) (Delta (suc n))) (comp (pi1 (Delta (suc n)) I) (sect n)) (pre-face-n n) =
 pair-beta1 (pre-face-n n) (eval-at-top n) ;
sect-pi2 (n : Nat) : Id (Map (Delta (suc (suc n))) I) (comp (pi2 (Delta (suc n)) I) (sect n)) (eval-at-top n) =
 pair-beta2 (pre-face-n n) (eval-at-top n) ;

eval-at-top-top (n : Nat) : Id (Ob I) (Ob-map (eval-at-top n) (top (suc (suc n)))) I1 =
 Iob-inj (Ob-map (eval-at-top n) (top (suc (suc n)))) I1
  (H.transH (top-part n (top (suc (suc n))))
  (H.transH (H.apH (\ d -> (monotone-ord-bwd (suc n) d).1 (inr tt)) (c20-top (suc (suc n))))
  (H.transH (bwd-top (suc n) (inr tt)) (H.symH (I-ob.2.sec-eq one2))))) ;

-- pre-face-n read in Ord: sn2-pr1
pre-face-val (n : Nat) (phi : Ob (Delta (suc (suc n)))) :
 Id (Ord (suc n)) ((construction-20 (suc n)).1 (Ob-map (pre-face-n n) phi)) (sn2-pr1 n ((construction-20 (suc (suc n))).1 phi)) =
 H.transH (H.symH (monotone-ord-rinv n ((construction-20 (suc n)).1 (Ob-map (pre-face-n n) phi))))
  (H.apH (monotone-ord-fwd n)
   (Pl.Sigma-eq (Ord n -> Two) (is-monotone-Ord n)
     (monotone-ord-bwd n ((construction-20 (suc n)).1 (Ob-map (pre-face-n n) phi))).1
     (restrict n (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi))).1
     (monotone-ord-bwd n ((construction-20 (suc n)).1 (Ob-map (pre-face-n n) phi))).2
     (restrict n (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi))).2
     (FL.funext (Ord n) (\ o -> Two) (monotone-ord-bwd n ((construction-20 (suc n)).1 (Ob-map (pre-face-n n) phi))).1
       (restrict n (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi))).1 (face-part n phi))
     (is-monotone-Ord-is-prop n (restrict n (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi))).1))) ;

pre-face-top (n : Nat) : Id (Ob (Delta (suc n))) (Ob-map (pre-face-n n) (top (suc (suc n)))) (top (suc n)) =
 c20-inj (suc n) (Ob-map (pre-face-n n) (top (suc (suc n)))) (top (suc n))
  (H.transH (pre-face-val n (top (suc (suc n))))
  (H.transH (H.apH (sn2-pr1 n) (c20-top (suc (suc n))))
  (H.transH (sn2-pr1-suc n (inr tt)) (H.symH (c20-top (suc n)))))) ;

eval-val (n : Nat) (phi : Ob (Delta (suc (suc n)))) :
 Id Two (I-ob.1 (Ob-map (eval-at-top n) phi)) (sn2-snd n ((construction-20 (suc (suc n))).1 phi)) = top-part n phi ;

------------------------------------------------------------------------
-- the last edge on vertices

lastedge-ord (n : Nat) : Two -> Ord (suc n) = split { inl u -> inl (ord-top n) ; inr u -> inr tt } ;

last-edge-dom-c20 (n : Nat) : Id (Ord (suc n)) ((construction-20 (suc n)).1 (dom (last-edge n))) (inl (ord-top n)) =
 H.transH (H.apH (construction-20 (suc n)).1 (dom-last-edge n)) ((construction-20 (suc n)).2.sec-eq (inl (ord-top n))) ;

last-edge-cod-c20 (n : Nat) : Id (Ord (suc n)) ((construction-20 (suc n)).1 (cod (last-edge n))) (inr tt) =
 H.transH (H.apH (construction-20 (suc n)).1 (H.transH (edge-cod n) (H.symH (c20-inv-top n))))
  ((construction-20 (suc n)).2.sec-eq (inr tt)) ;

last-edge-c20-aux (n : Nat) (x : Ob I) : (b : Two) -> Id Two (I-ob.1 x) b ->
 Id (Ord (suc n)) ((construction-20 (suc n)).1 (Ob-map {I} {Delta (suc n)} (last-edge n) x)) (lastedge-ord n b) = split {
 inl u -> \ eq -> H.transH (H.apH (\ z -> (construction-20 (suc n)).1 (Ob-map {I} {Delta (suc n)} (last-edge n) z))
    (Iob-inj x I0 (H.transH eq (H.transH (H.apH {Top} {Two} (\ t -> inl t) (isTop u tt)) (H.symH (I-ob.2.sec-eq zero2))))))
   (last-edge-dom-c20 n) ;
 inr u -> \ eq -> H.transH (H.apH (\ z -> (construction-20 (suc n)).1 (Ob-map {I} {Delta (suc n)} (last-edge n) z))
    (Iob-inj x I1 (H.transH eq (H.transH (H.apH {Top} {Two} (\ t -> inr t) (isTop u tt)) (H.symH (I-ob.2.sec-eq one2))))))
   (last-edge-cod-c20 n) } ;

last-edge-c20 (n : Nat) (x : Ob I) :
 Id (Ord (suc n)) ((construction-20 (suc n)).1 (Ob-map {I} {Delta (suc n)} (last-edge n) x)) (lastedge-ord n (I-ob.1 x)) =
 last-edge-c20-aux n x (I-ob.1 x) (refl (I-ob.1 x)) ;

lastedge-sn2-pr1 (k : Nat) : (b : Two) ->
 Id (Ord (suc (suc k))) (lastedge-ord (suc k) b) (sn2-pr1 (suc k) (lastedge-ord (suc (suc k)) b)) = split {
 inl u -> H.symH (sn2-pr1-suc (suc k) (inl (inr tt))) ;
 inr u -> H.symH (sn2-pr1-suc (suc k) (inr tt)) } ;

lastedge-sn2-snd (k : Nat) : (b : Two) -> Id Two one2 (sn2-snd (suc k) (lastedge-ord (suc (suc k)) b)) = split {
 inl u -> H.symH (H.transH (H.symH (sn2-snd-face k (inr tt))) (sn2-snd-top k)) ;
 inr u -> H.symH (sn2-snd-top (suc k)) } ;

------------------------------------------------------------------------
-- functors into a simplex by their vertex action

vob (n : Nat) {X : Cat} (f : Map X (Delta n)) (x : Ob X) : Ord n = (construction-20 n).1 (Ob-map f x) ;

vob-ext {X : Cat} (n : Nat) (f g : Map X (Delta n)) (h : (x : Ob X) -> Id (Ord n) (vob n f x) (vob n g x)) : Id (Map X (Delta n)) f g =
 posetal-eq-objects X (Delta n) (Delta-posetal n) f g (\ x -> c20-inj n (Ob-map f x) (Ob-map g x) (h x)) ;

vob-pre (n : Nat) {X Y : Cat} (f : Map Y (Delta n)) (h : Map X Y) (x : Ob X) :
 Id (Ord n) (vob n (comp f h) x) (vob n f (Ob-map h x)) =
 H.apH (construction-20 n).1 (composeA {One} {X} {Y} {Delta n} f h x) ;

------------------------------------------------------------------------
-- ret on vertices

module RetC20 (n : Nat) (w : Ob (times (Delta (suc n)) I)) {
 s : Ob (Delta (suc n)) = Ob-map (pi1 (Delta (suc n)) I) w ;
 t : Ob I = Ob-map (pi2 (Delta (suc n)) I) w ;
 a : Ord (suc n) = (construction-20 (suc n)).1 s ;
 b : Two = I-ob.1 t ;
 psi : Ob (Delta (suc (suc n))) = Ob-map (ret n) w ;

 point-pair (pt : Ob (Delta (suc n))) :
  Id (Map One (times (times (Delta (suc n)) I) (Delta (suc n))))
   (comp {One} {Delta (suc n)} {times (times (Delta (suc n)) I) (Delta (suc n))} (slice {times (Delta (suc n)) I} {Delta (suc n)} w) pt)
   (pair {times (Delta (suc n)) I} {Delta (suc n)} {One} w pt) =
  H.transH (pair-nat {times (Delta (suc n)) I} {Delta (suc n)} {Delta (suc n)} {One}
    (comp {Delta (suc n)} {One} {times (Delta (suc n)) I} w (bang (Delta (suc n)))) (idMap (Delta (suc n))) pt)
   (pair-ap (H.transH (composeA {One} {Delta (suc n)} {One} {times (Delta (suc n)) I} w (bang (Delta (suc n))) pt)
              (H.transH (ccr {One} {One} {times (Delta (suc n)) I} w (one-path (comp {One} {Delta (suc n)} {One} (bang (Delta (suc n))) pt) (idMap One)))
               (comp-id-r {One} {times (Delta (suc n)) I} w)))
            (comp-id-l {One} {Delta (suc n)} pt)) ;

 point-eq (o : Ord (suc n)) : Id Two ((monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 psi)).1 o) (thr-pred n a b o) =
  H.transH (sigma-eval-expand (suc n) psi o)
  (H.transH (H.apH (\ f -> I-ob.1 (Ob-map {Delta (suc n)} {I} f ((construction-20 (suc n)).2.sec o)))
     (exp-eval (Delta (suc n)) I (times (Delta (suc n)) I) (ret-adj n) w))
  (H.transH (H.apH I-ob.1 (composeA {One} {Delta (suc n)} {times (times (Delta (suc n)) I) (Delta (suc n))} {I} (ret-adj n)
     (slice {times (Delta (suc n)) I} {Delta (suc n)} w) ((construction-20 (suc n)).2.sec o)))
  (H.transH (H.apH (\ u -> I-ob.1 (comp {One} {times (times (Delta (suc n)) I) (Delta (suc n))} {I} (ret-adj n) u))
     (point-pair ((construction-20 (suc n)).2.sec o)))
  (H.transH (I-char-ob-to-2 (times (times (Delta (suc n)) I) (Delta (suc n))) (ret-p n, ret-p-mono n)
     (pair {times (Delta (suc n)) I} {Delta (suc n)} {One} w ((construction-20 (suc n)).2.sec o)))
  (H.transH (H.apH (\ u -> ret-p n (pair {times (Delta (suc n)) I} {Delta (suc n)} {One} u ((construction-20 (suc n)).2.sec o)))
     (H.symH (pair-eta {Delta (suc n)} {I} {One} w)))
  (H.transH (ret-p-expand n s t ((construction-20 (suc n)).2.sec o))
   (H.apH (thr-pred n a b) ((construction-20 (suc n)).2.sec-eq o)))))))) ;

 result : Id (Ord (suc (suc n))) ((construction-20 (suc (suc n))).1 psi) (thr-ord n a b) =
  H.transH (H.symH (monotone-ord-rinv (suc n) ((construction-20 (suc (suc n))).1 psi)))
   (H.apH (monotone-ord-fwd (suc n))
    (Pl.Sigma-eq (Ord (suc n) -> Two) (is-monotone-Ord (suc n))
      (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 psi)).1 (thr-pred n a b)
      (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 psi)).2 (thr-mono n a b)
      (FL.funext (Ord (suc n)) (\ o -> Two) (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 psi)).1 (thr-pred n a b) point-eq)
      (is-monotone-Ord-is-prop (suc n) (thr-pred n a b)))) ;
} ;

ret-c20 (n : Nat) (w : Ob (times (Delta (suc n)) I)) :
 Id (Ord (suc (suc n))) ((construction-20 (suc (suc n))).1 (Ob-map (ret n) w))
  (thr-ord n ((construction-20 (suc n)).1 (Ob-map (pi1 (Delta (suc n)) I) w)) (I-ob.1 (Ob-map (pi2 (Delta (suc n)) I) w))) =
 RetC20[n, w].result ;
