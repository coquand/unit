-- Two elementary comparisons needed to state triple functor coherence.
-- A path between functors acts on a canonical morphism with endpoints;
-- its Hom-eq description is associator naturality in the first argument.
-- Both descriptions agree by J on the functor path; the reflexive case
-- is HomEqMap.self. Also Hom-map commutes with endpoint transport, by
-- J on the two endpoint paths. No coherence above Structure is used.
open Base ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open HomPaths ; open Naturality ;

module Change (A B : Cat) (F : Map A B) (m : Mor A) {
 source (G : Map A B) (p : Id (Map A B) F G) : Hom B (Ob-map G (dom m)) (Ob-map G (cod m)) =
  Hom-coerce B (ccl {One} {A} {B} (dom m) p) (ccl {One} {A} {B} (cod m) p)
   (Hom-map F (dom m) (cod m) (m, refl (dom m), refl (cod m))) ;
 target (G : Map A B) : Hom B (Ob-map G (dom m)) (Ob-map G (cod m)) =
  Hom-map G (dom m) (cod m) (m, refl (dom m), refl (cod m)) ;
 motive (G : Map A B) (p : Id (Map A B) F G) : U l =
  Id (Hom B (Ob-map G (dom m)) (Ob-map G (cod m))) (source G p) (target G) ;
 change (G : Map A B) (p : Id (Map A B) F G) : motive G p =
  idJ (Map A B) F motive (refl (target F)) G p ;
 expanded (G : Map A B) (p : Id (Map A B) F G) : motive G p =
  Hom-eq B (source G p) (target G) (ccl {I} {A} {B} m p)
   (compose-naturality1 {One} {I} {A} {B} m I0 p) (compose-naturality1 {One} {I} {A} {B} m I1 p) ;
 form (G : Map A B) (p : Id (Map A B) F G) : Id (motive G p) (change G p) (expanded G p) =
  idJ (Map A B) F (\ G1 p1 -> Id (motive G1 p1) (change G1 p1) (expanded G1 p1))
   (H.symH (HomEqMap.self B (Ob-map F (dom m)) (Ob-map F (cod m)) (target F))) G p ;
} ;

module Coerce (A B : Cat) (F : Map A B) (x y : Ob A) (h : Hom A x y) {
 endpoint (v : Ob I) (z : Ob A) (r : Id (Ob A) (comp {One} {I} {A} (hmor h) v) z)
  (z1 : Ob A) (s : Id (Ob A) z z1) :
  Id (Id (Ob B) (comp {One} {I} {B} (comp F (hmor h)) v) (Ob-map F z1))
   (H.transH (composeA {One} {I} {A} {B} F (hmor h) v) (ccr {One} {A} {B} F (H.transH r s)))
   (H.transH (H.transH (composeA {One} {I} {A} {B} F (hmor h) v) (ccr {One} {A} {B} F r)) (ccr {One} {A} {B} F s)) =
  H.transH (H.apH (\ p -> H.transH (composeA {One} {I} {A} {B} F (hmor h) v) p)
    (PathAlgebra[l].ap-trans (Ob-map F) r s))
   (H.symH (PathAlgebra[l].tassoc (composeA {One} {I} {A} {B} F (hmor h) v) (ccr {One} {A} {B} F r) (ccr {One} {A} {B} F s))) ;

 motive (x1 : Ob A) (p : Id (Ob A) x x1) (y1 : Ob A) (q : Id (Ob A) y y1) : U l =
  Id (Hom B (Ob-map F x1) (Ob-map F y1))
   (Hom-map F x1 y1 (Hom-coerce A p q h))
   (Hom-coerce B (ccr {One} {A} {B} F p) (ccr {One} {A} {B} F q) (Hom-map F x y h)) ;
 naturality (x1 : Ob A) (p : Id (Ob A) x x1) (y1 : Ob A) (q : Id (Ob A) y y1) : motive x1 p y1 q =
  idJ (Ob A) x (\ x2 p2 -> (y2 : Ob A) (q2 : Id (Ob A) y y2) -> motive x2 p2 y2 q2)
   (\ y2 q2 -> idJ (Ob A) y (\ y3 q3 -> motive x (refl x) y3 q3) (refl (Hom-map F x y h)) y2 q2) x1 p y1 q ;

 expanded (x1 : Ob A) (p : Id (Ob A) x x1) (y1 : Ob A) (q : Id (Ob A) y y1) : motive x1 p y1 q =
  Hom-ends B (comp {I} {A} {B} F (hmor h)) (endpoint I0 x (hdom h) x1 p) (endpoint I1 y (hcod h) y1 q) ;

 form (x1 : Ob A) (p : Id (Ob A) x x1) (y1 : Ob A) (q : Id (Ob A) y y1) :
  Id (motive x1 p y1 q) (naturality x1 p y1 q) (expanded x1 p y1 q) =
  idJ (Ob A) x (\ x2 p2 -> (y2 : Ob A) (q2 : Id (Ob A) y y2) ->
   Id (motive x2 p2 y2 q2) (naturality x2 p2 y2 q2) (expanded x2 p2 y2 q2))
   (\ y2 q2 -> idJ (Ob A) y (\ y3 q3 ->
    Id (motive x (refl x) y3 q3) (naturality x (refl x) y3 q3) (expanded x (refl x) y3 q3))
    (refl (refl (Hom-map F x y h))) y2 q2) x1 p y1 q ;
} ;
