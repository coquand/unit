-- Commuting squares, cones and pushout squares (Agda Squares/Square; Rocq
-- Main.v square, sq_cone, sq_comparison, is_pushout_square,
-- square_morphism, square_retract, times_I).  Level 1.
--   A square S: corners A, B, C, D, sides t : A -> B, l : A -> C,
--   r : B -> D, b : C -> D, and a 2-cell r t = b l.
--   sq-cone S X: maps g : C -> X, e : B -> X with g l = e t.
--   sq-comparison S X h = (h b, h r) with
--   (h b) l = h (b l) = h (r t) = (h r) t.
--   S is a pushout square when every sq-comparison S X is an equivalence.
--   A square morphism P -> Q: maps of the four corners and four commuting
--   faces.  It records no coherence between the faces and the two
--   squares; this suffices for squares with posetal corners, where the
--   2-cells between maps of corners form sets (Pushout.agda's remark).
--   A square retract S' < S: morphisms S' -> S -> S' composing to the
--   identity at each corner.
--   times-I S: the square S x I, with product-map; it commutes by pmc and
--   S's 2-cell.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open WildCat ; open Pullbacks ; open ProductMap ;

record Square {
 sqA : Cat ; sqB : Cat ; sqC : Cat ; sqD : Cat ;
 sqt : Map sqA sqB ; sql : Map sqA sqC ; sqr : Map sqB sqD ; sqb : Map sqC sqD ;
 sqcomm : Id (Map sqA sqD) (comp sqr sqt) (comp sqb sql) ;
} ;

sq-cone (S : Square) (X : Cat) : U l =
 (ge : Map S.sqC X * Map S.sqB X) * Id (Map S.sqA X) (comp ge.1 S.sql) (comp ge.2 S.sqt) ;

sq-comparison (S : Square) (X : Cat) (h : Map S.sqD X) : sq-cone S X =
 ((comp h S.sqb, comp h S.sqr),
  H.transH (composeA h S.sqb S.sql) (H.transH (ccr h (H.symH S.sqcomm)) (H.symH (composeA h S.sqr S.sqt)))) ;

is-pushout-square (S : Square) : U l+ = (X : Cat) -> Pl.isEquiv (Map S.sqD X) (sq-cone S X) (sq-comparison S X) ;

record square-morphism (P Q : Square) {
 smA : Map P.sqA Q.sqA ; smB : Map P.sqB Q.sqB ; smC : Map P.sqC Q.sqC ; smD : Map P.sqD Q.sqD ;
 sm-t : Id (Map P.sqA Q.sqB) (comp Q.sqt smA) (comp smB P.sqt) ;
 sm-l : Id (Map P.sqA Q.sqC) (comp Q.sql smA) (comp smC P.sql) ;
 sm-r : Id (Map P.sqB Q.sqD) (comp Q.sqr smB) (comp smD P.sqr) ;
 sm-b : Id (Map P.sqC Q.sqD) (comp Q.sqb smC) (comp smD P.sqb) ;
} ;

record square-retract (S1 S : Square) {
 sr-s : square-morphism[S1, S] ;
 sr-r : square-morphism[S, S1] ;
 sr-A : Id (Map S1.sqA S1.sqA) (comp sr-r.smA sr-s.smA) (idMap S1.sqA) ;
 sr-B : Id (Map S1.sqB S1.sqB) (comp sr-r.smB sr-s.smB) (idMap S1.sqB) ;
 sr-C : Id (Map S1.sqC S1.sqC) (comp sr-r.smC sr-s.smC) (idMap S1.sqC) ;
 sr-D : Id (Map S1.sqD S1.sqD) (comp sr-r.smD sr-s.smD) (idMap S1.sqD) ;
} ;

times-I-comm (S : Square) :
 Id (Map (times S.sqA I) (times S.sqD I))
  (comp (product-map S.sqr (idMap I)) (product-map S.sqt (idMap I)))
  (comp (product-map S.sqb (idMap I)) (product-map S.sql (idMap I))) =
 H.transH (H.symH (pmc S.sqt S.sqr (idMap I) (idMap I)))
  (H.transH (product-map-eq1 (comp (idMap I) (idMap I)) S.sqcomm) (pmc S.sql S.sqb (idMap I) (idMap I))) ;

times-I (S : Square) : Square =
 new Square[times S.sqA I, times S.sqB I, times S.sqC I, times S.sqD I,
  product-map S.sqt (idMap I), product-map S.sql (idMap I),
  product-map S.sqr (idMap I), product-map S.sqb (idMap I), times-I-comm S] ;
