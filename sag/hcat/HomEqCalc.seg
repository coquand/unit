-- Composition of paths of morphisms with endpoints (for the coherence of
-- Hom-map-of-comp, Coh3).  Level 1.
--   A path h1 = h2 in Hom C x y is Hom-eq of (al, ep, eq): a path al of
--   the morphisms and the endpoint 2-cells ep : p1 = (al o I0) . p2,
--   eq : q1 = (al o I1) . q2.
--   end-trans: endpoint 2-cells compose: p1 = (al o v) . p2 and
--   p2 = (al1 o v) . p3 give p1 = ((al . al1) o v) . p3 (reassociation
--   and ap-trans of - o v).
--   Hom-ends-trans: Hom-ends (e1, e2) . Hom-ends (f1, f2) is
--   Hom-ends (e1 . f1, e2 . f2) (J on f1, f2).
--   end-refl: at al = al1 = refl the composite 2-cell, followed by the
--   unit law, is the composite of the two (J on the second 2-cell and on
--   the endpoint path).
--   HE-trans: Hom-eq (al, ep, eq) . Hom-eq (al1, ep1, eq1)
--   = Hom-eq (al . al1, end-trans ep ep1, end-trans eq eq1).  By J on al
--   and al1 it suffices that both are refl; then the three paths are
--   Hom-ends, and Hom-ends-trans and end-refl conclude.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open HomPaths ;

end-trans (C : Cat) (v : Ob I) {z : Ob C} {m1 m2 m3 : Mor C} (al : Id (Mor C) m1 m2) (al1 : Id (Mor C) m2 m3)
 {p1 : Id (Ob C) (comp {One} {I} {C} m1 v) z} {p2 : Id (Ob C) (comp {One} {I} {C} m2 v) z} {p3 : Id (Ob C) (comp {One} {I} {C} m3 v) z}
 (e : Id (Id (Ob C) (comp {One} {I} {C} m1 v) z) p1 (H.transH (ccl {One} {I} {C} v al) p2))
 (e1 : Id (Id (Ob C) (comp {One} {I} {C} m2 v) z) p2 (H.transH (ccl {One} {I} {C} v al1) p3)) :
 Id (Id (Ob C) (comp {One} {I} {C} m1 v) z) p1 (H.transH (ccl {One} {I} {C} v (H.transH al al1)) p3) =
 calc (Id (Ob C) (comp {One} {I} {C} m1 v) z) {
  p1
  =< e > H.transH (ccl {One} {I} {C} v al) p2
  =< H.apH (\ u -> H.transH (ccl {One} {I} {C} v al) u) e1 > H.transH (ccl {One} {I} {C} v al) (H.transH (ccl {One} {I} {C} v al1) p3)
  =< H.symH (PA.tassoc (ccl {One} {I} {C} v al) (ccl {One} {I} {C} v al1) p3) >
    H.transH (H.transH (ccl {One} {I} {C} v al) (ccl {One} {I} {C} v al1)) p3
  =< H.apH (\ u -> H.transH u p3) (H.symH (PA.ap-trans (\ m -> comp {One} {I} {C} m v) al al1)) >
    H.transH (ccl {One} {I} {C} v (H.transH al al1)) p3 } ;

Hom-ends-trans (C : Cat) {x y : Ob C} (m : Mor C) {p p1 : Id (Ob C) (dom m) x} {q q1 : Id (Ob C) (cod m) y}
 (e1 : Id (Id (Ob C) (dom m) x) p p1) (e2 : Id (Id (Ob C) (cod m) y) q q1) :
 (p2 : Id (Ob C) (dom m) x) (f1 : Id (Id (Ob C) (dom m) x) p1 p2) (q2 : Id (Ob C) (cod m) y) (f2 : Id (Id (Ob C) (cod m) y) q1 q2) ->
 Id (Id (Hom C x y) (m, p, q) (m, p2, q2)) (H.transH (Hom-ends C m e1 e2) (Hom-ends C m f1 f2)) (Hom-ends C m (H.transH e1 f1) (H.transH e2 f2)) =
 \ p2 f1 -> idJ (Id (Ob C) (dom m) x) p1 (\ p3 g1 -> (q2 : Id (Ob C) (cod m) y) (f2 : Id (Id (Ob C) (cod m) y) q1 q2) ->
   Id (Id (Hom C x y) (m, p, q) (m, p3, q2)) (H.transH (Hom-ends C m e1 e2) (Hom-ends C m g1 f2)) (Hom-ends C m (H.transH e1 g1) (H.transH e2 f2)))
  (\ q2 f2 -> idJ (Id (Ob C) (cod m) y) q1 (\ q3 g2 ->
     Id (Id (Hom C x y) (m, p, q) (m, p1, q3)) (H.transH (Hom-ends C m e1 e2) (Hom-ends C m (refl p1) g2)) (Hom-ends C m (H.transH e1 (refl p1)) (H.transH e2 g2)))
    (refl (Hom-ends C m e1 e2)) q2 f2)
  p2 f1 ;

end-refl (C : Cat) (v : Ob I) {m : Mor C} (z : Ob C) (p3 : Id (Ob C) (comp {One} {I} {C} m v) z) :
 (p2 : Id (Ob C) (comp {One} {I} {C} m v) z) (e1 : Id (Id (Ob C) (comp {One} {I} {C} m v) z) p2 (H.transH (refl (comp {One} {I} {C} m v)) p3))
 (p1 : Id (Ob C) (comp {One} {I} {C} m v) z) (e : Id (Id (Ob C) (comp {One} {I} {C} m v) z) p1 (H.transH (refl (comp {One} {I} {C} m v)) p2)) ->
 Id (Id (Id (Ob C) (comp {One} {I} {C} m v) z) p1 p3)
  (H.transH (H.transH e (PA.unit-l p2)) (H.transH e1 (PA.unit-l p3)))
  (H.transH (end-trans C v {z} {m} {m} {m} (refl m) (refl m) {p1} {p2} {p3} e e1) (PA.unit-l p3)) =
 idJ (Ob C) (comp {One} {I} {C} m v) (\ z1 r -> (p2 : Id (Ob C) (comp {One} {I} {C} m v) z1)
   (e1 : Id (Id (Ob C) (comp {One} {I} {C} m v) z1) p2 (H.transH (refl (comp {One} {I} {C} m v)) r))
   (p1 : Id (Ob C) (comp {One} {I} {C} m v) z1) (e : Id (Id (Ob C) (comp {One} {I} {C} m v) z1) p1 (H.transH (refl (comp {One} {I} {C} m v)) p2)) ->
   Id (Id (Id (Ob C) (comp {One} {I} {C} m v) z1) p1 r)
    (H.transH (H.transH e (PA.unit-l p2)) (H.transH e1 (PA.unit-l r)))
    (H.transH (end-trans C v {z1} {m} {m} {m} (refl m) (refl m) {p1} {p2} {r} e e1) (PA.unit-l r)))
  (H.idJR (Id (Ob C) (comp {One} {I} {C} m v) (comp {One} {I} {C} m v)) (refl (comp {One} {I} {C} m v))
    (\ p2 e1 -> (p1 : Id (Ob C) (comp {One} {I} {C} m v) (comp {One} {I} {C} m v))
      (e : Id (Id (Ob C) (comp {One} {I} {C} m v) (comp {One} {I} {C} m v)) p1 (H.transH (refl (comp {One} {I} {C} m v)) p2)) ->
      Id (Id (Id (Ob C) (comp {One} {I} {C} m v) (comp {One} {I} {C} m v)) p1 (refl (comp {One} {I} {C} m v)))
       (H.transH (H.transH e (PA.unit-l p2)) (H.transH e1 (refl (refl (comp {One} {I} {C} m v)))))
       (H.transH (end-trans C v {comp {One} {I} {C} m v} {m} {m} {m} (refl m) (refl m) {p1} {p2} {refl (comp {One} {I} {C} m v)} e e1) (refl (refl (comp {One} {I} {C} m v)))))
    (\ p1 e -> refl e))
  z p3 ;

HE-trans-base (C : Cat) {x y : Ob C} (h1 : Hom C x y) (p2 : Id (Ob C) (dom (hmor h1)) x) (q2 : Id (Ob C) (cod (hmor h1)) y)
 (ep : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (H.transH (refl (dom (hmor h1))) p2))
 (eqa : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (H.transH (refl (cod (hmor h1))) q2))
 (p3 : Id (Ob C) (dom (hmor h1)) x) (q3 : Id (Ob C) (cod (hmor h1)) y)
 (ep1 : Id (Id (Ob C) (dom (hmor h1)) x) p2 (H.transH (refl (dom (hmor h1))) p3))
 (eqb : Id (Id (Ob C) (cod (hmor h1)) y) q2 (H.transH (refl (cod (hmor h1))) q3)) :
 Id (Id (Hom C x y) h1 (hmor h1, p3, q3))
  (H.transH (Hom-eq C h1 (hmor h1, p2, q2) (refl (hmor h1)) ep eqa) (Hom-eq C (hmor h1, p2, q2) (hmor h1, p3, q3) (refl (hmor h1)) ep1 eqb))
  (Hom-eq C h1 (hmor h1, p3, q3) (refl (hmor h1)) (end-trans C I0 {x} {hmor h1} {hmor h1} {hmor h1} (refl (hmor h1)) (refl (hmor h1)) {hdom h1} {p2} {p3} ep ep1) (end-trans C I1 {y} {hmor h1} {hmor h1} {hmor h1} (refl (hmor h1)) (refl (hmor h1)) {hcod h1} {q2} {q3} eqa eqb)) =
 calc (Id (Hom C x y) h1 (hmor h1, p3, q3)) {
  H.transH (Hom-eq C h1 (hmor h1, p2, q2) (refl (hmor h1)) ep eqa) (Hom-eq C (hmor h1, p2, q2) (hmor h1, p3, q3) (refl (hmor h1)) ep1 eqb)
  =< Hom-ends-trans C (hmor h1) {hdom h1} {p2} {hcod h1} {q2} (H.transH ep (PA.unit-l p2)) (H.transH eqa (PA.unit-l q2))
      p3 (H.transH ep1 (PA.unit-l p3)) q3 (H.transH eqb (PA.unit-l q3)) >
    Hom-ends C (hmor h1) {hdom h1} {p3} {hcod h1} {q3} (H.transH (H.transH ep (PA.unit-l p2)) (H.transH ep1 (PA.unit-l p3)))
     (H.transH (H.transH eqa (PA.unit-l q2)) (H.transH eqb (PA.unit-l q3)))
  =< H.apH (\ u -> Hom-ends C (hmor h1) {hdom h1} {p3} {hcod h1} {q3} u (H.transH (H.transH eqa (PA.unit-l q2)) (H.transH eqb (PA.unit-l q3))))
      (end-refl C I0 {hmor h1} x p3 p2 ep1 (hdom h1) ep) >
    Hom-ends C (hmor h1) {hdom h1} {p3} {hcod h1} {q3} (H.transH (end-trans C I0 {x} {hmor h1} {hmor h1} {hmor h1} (refl (hmor h1)) (refl (hmor h1)) {hdom h1} {p2} {p3} ep ep1) (PA.unit-l p3))
     (H.transH (H.transH eqa (PA.unit-l q2)) (H.transH eqb (PA.unit-l q3)))
  =< H.apH (\ u -> Hom-ends C (hmor h1) {hdom h1} {p3} {hcod h1} {q3} (H.transH (end-trans C I0 {x} {hmor h1} {hmor h1} {hmor h1} (refl (hmor h1)) (refl (hmor h1)) {hdom h1} {p2} {p3} ep ep1) (PA.unit-l p3)) u)
      (end-refl C I1 {hmor h1} y q3 q2 eqb (hcod h1) eqa) >
    Hom-ends C (hmor h1) {hdom h1} {p3} {hcod h1} {q3} (H.transH (end-trans C I0 {x} {hmor h1} {hmor h1} {hmor h1} (refl (hmor h1)) (refl (hmor h1)) {hdom h1} {p2} {p3} ep ep1) (PA.unit-l p3)) (H.transH (end-trans C I1 {y} {hmor h1} {hmor h1} {hmor h1} (refl (hmor h1)) (refl (hmor h1)) {hcod h1} {q2} {q3} eqa eqb) (PA.unit-l q3)) } ;

HE-mot1 (C : Cat) {x y : Ob C} (h1 : Hom C x y) (m4 : Mor C) (a4 : Id (Mor C) (hmor h1) m4) : U l =
 (p2 : Id (Ob C) (dom m4) x) (q2 : Id (Ob C) (cod m4) y)
   (ep : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (H.transH (ccl {One} {I} {C} I0 {hmor h1} {m4} a4) p2))
   (eqa : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (H.transH (ccl {One} {I} {C} I1 {hmor h1} {m4} a4) q2))
   (m3 : Mor C) (al1 : Id (Mor C) m4 m3) (p3 : Id (Ob C) (dom m3) x) (q3 : Id (Ob C) (cod m3) y)
   (ep1 : Id (Id (Ob C) (dom m4) x) p2 (H.transH (ccl {One} {I} {C} I0 {m4} {m3} al1) p3))
   (eqb : Id (Id (Ob C) (cod m4) y) q2 (H.transH (ccl {One} {I} {C} I1 {m4} {m3} al1) q3)) ->
   Id (Id (Hom C x y) h1 (m3, p3, q3))
    (H.transH (Hom-eq C h1 (m4, p2, q2) a4 ep eqa) (Hom-eq C (m4, p2, q2) (m3, p3, q3) al1 ep1 eqb))
    (Hom-eq C h1 (m3, p3, q3) (H.transH a4 al1) (end-trans C I0 {x} {hmor h1} {m4} {m3} a4 al1 {hdom h1} {p2} {p3} ep ep1) (end-trans C I1 {y} {hmor h1} {m4} {m3} a4 al1 {hcod h1} {q2} {q3} eqa eqb)) ;

HE-mot2 (C : Cat) {x y : Ob C} (h1 : Hom C x y) (p2 : Id (Ob C) (dom (hmor h1)) x) (q2 : Id (Ob C) (cod (hmor h1)) y)
 (ep : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (H.transH (refl (dom (hmor h1))) p2))
 (eqa : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (H.transH (refl (cod (hmor h1))) q2))
 (m5 : Mor C) (a5 : Id (Mor C) (hmor h1) m5) : U l =
 (p3 : Id (Ob C) (dom m5) x) (q3 : Id (Ob C) (cod m5) y)
     (ep1 : Id (Id (Ob C) (dom (hmor h1)) x) p2 (H.transH (ccl {One} {I} {C} I0 {hmor h1} {m5} a5) p3))
     (eqb : Id (Id (Ob C) (cod (hmor h1)) y) q2 (H.transH (ccl {One} {I} {C} I1 {hmor h1} {m5} a5) q3)) ->
     Id (Id (Hom C x y) h1 (m5, p3, q3))
      (H.transH (Hom-eq C h1 (hmor h1, p2, q2) (refl (hmor h1)) ep eqa) (Hom-eq C (hmor h1, p2, q2) (m5, p3, q3) a5 ep1 eqb))
      (Hom-eq C h1 (m5, p3, q3) (H.transH (refl (hmor h1)) a5) (end-trans C I0 {x} {hmor h1} {hmor h1} {m5} (refl (hmor h1)) a5 {hdom h1} {p2} {p3} ep ep1) (end-trans C I1 {y} {hmor h1} {hmor h1} {m5} (refl (hmor h1)) a5 {hcod h1} {q2} {q3} eqa eqb)) ;

HE-trans (C : Cat) {x y : Ob C} (h1 : Hom C x y) :
 (m2 : Mor C) (al : Id (Mor C) (hmor h1) m2) (p2 : Id (Ob C) (dom m2) x) (q2 : Id (Ob C) (cod m2) y)
 (ep : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (H.transH (ccl {One} {I} {C} I0 al) p2))
 (eqa : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (H.transH (ccl {One} {I} {C} I1 al) q2))
 (m3 : Mor C) (al1 : Id (Mor C) m2 m3) (p3 : Id (Ob C) (dom m3) x) (q3 : Id (Ob C) (cod m3) y)
 (ep1 : Id (Id (Ob C) (dom m2) x) p2 (H.transH (ccl {One} {I} {C} I0 al1) p3))
 (eqb : Id (Id (Ob C) (cod m2) y) q2 (H.transH (ccl {One} {I} {C} I1 al1) q3)) ->
 Id (Id (Hom C x y) h1 (m3, p3, q3))
  (H.transH (Hom-eq C h1 (m2, p2, q2) al ep eqa) (Hom-eq C (m2, p2, q2) (m3, p3, q3) al1 ep1 eqb))
  (Hom-eq C h1 (m3, p3, q3) (H.transH al al1) (end-trans C I0 {x} {hmor h1} {m2} {m3} al al1 {hdom h1} {p2} {p3} ep ep1) (end-trans C I1 {y} {hmor h1} {m2} {m3} al al1 {hcod h1} {q2} {q3} eqa eqb)) =
 \ m2 al -> idJ (Mor C) (hmor h1) (\ m4 a4 -> HE-mot1 C h1 m4 a4)
  (\ p2 q2 ep eqa m3 al1 -> idJ (Mor C) (hmor h1) (\ m5 a5 -> HE-mot2 C h1 p2 q2 ep eqa m5 a5)
    (HE-trans-base C h1 p2 q2 ep eqa)
    m3 al1)
  m2 al ;
