-- Additivity: (X + Y) (x) A is the coproduct of X (x) A and Y (x) A (H2).
--   is-coproduct i1 i2: maps out of P are pairs of maps out of B1 and B2,
--   g |-> (i1 g, i2 g) being an equivalence for every T.
--   copair h = lift (sum-case h), sum-case h (inl x) = eta_x h1 and
--   sum-case h (inr y) = eta_y h2.
--   copair-inl: tmap inl (copair h) = h1, by ext: eta_x (tmap inl copair h)
--   = eta_(inl x) (copair h) = eta_x h1 (restrict-tmap, lift-beta).
--   copair-eta: copair (tmap inl g, tmap inr g) = g, by ext:
--   eta_z (copair ..) = sum-case .. z = eta_z g (lift-beta; restrict-tmap
--   in each case).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open HigherCat ; open Constructions ; open Composition ;
open Copower ; open TensorMap ;

is-coproduct {C : Cat} {P B1 B2 : Ob C} (i1 : Hom C B1 P) (i2 : Hom C B2 P) : U l =
 (T : Ob C) -> Pl.isEquiv (Hom C P T) (Hom C B1 T * Hom C B2 T) (\ g -> (hcomp {C} i1 g, hcomp {C} i2 g)) ;

module SumOf (A : Ob D) (X Y : U k) {
 S : U k = Finite[k].Sum X Y ;
 in1 : Hom D (tensor X A) (tensor S A) = tmap A {X} {S} (\ x -> inl x) ;
 in2 : Hom D (tensor Y A) (tensor S A) = tmap A {Y} {S} (\ y -> inr y) ;

 sum-case (T : Ob D) (h : Hom D (tensor X A) T * Hom D (tensor Y A) T) : S -> Hom D A T = split {
  inl x -> hcomp {D} (eta X A x) h.1 ;
  inr y -> hcomp {D} (eta Y A y) h.2 } ;

 copair (T : Ob D) (h : Hom D (tensor X A) T * Hom D (tensor Y A) T) : Hom D (tensor S A) T =
  lift S A T (sum-case T h) ;

 copair-inl (T : Ob D) (h : Hom D (tensor X A) T * Hom D (tensor Y A) T) :
  Id (Hom D (tensor X A) T) (hcomp {D} in1 (copair T h)) h.1 =
  ext X A T (hcomp {D} in1 (copair T h)) h.1 (\ x ->
   H.transH (restrict-tmap A T {X} {S} (\ x1 -> inl x1) (copair T h) x)
    (lift-beta S A T (sum-case T h) (inl x))) ;

 copair-inr (T : Ob D) (h : Hom D (tensor X A) T * Hom D (tensor Y A) T) :
  Id (Hom D (tensor Y A) T) (hcomp {D} in2 (copair T h)) h.2 =
  ext Y A T (hcomp {D} in2 (copair T h)) h.2 (\ y ->
   H.transH (restrict-tmap A T {Y} {S} (\ y1 -> inr y1) (copair T h) y)
    (lift-beta S A T (sum-case T h) (inr y))) ;

 restrict-pair (T : Ob D) (g : Hom D (tensor S A) T) : (z : S) ->
  Id (Hom D A T) (sum-case T (hcomp {D} in1 g, hcomp {D} in2 g) z) (hcomp {D} (eta S A z) g) = split {
  inl x -> restrict-tmap A T {X} {S} (\ x1 -> inl x1) g x ;
  inr y -> restrict-tmap A T {Y} {S} (\ y1 -> inr y1) g y } ;

 copair-eta (T : Ob D) (g : Hom D (tensor S A) T) :
  Id (Hom D (tensor S A) T) (copair T (hcomp {D} in1 g, hcomp {D} in2 g)) g =
  ext S A T (copair T (hcomp {D} in1 g, hcomp {D} in2 g)) g (\ z ->
   H.transH (lift-beta S A T (sum-case T (hcomp {D} in1 g, hcomp {D} in2 g)) z) (restrict-pair T g z)) ;

 tensor-sum : is-coproduct in1 in2 = \ T ->
  Pl.qinv (Hom D (tensor S A) T) (Hom D (tensor X A) T * Hom D (tensor Y A) T)
   (\ g -> (hcomp {D} in1 g, hcomp {D} in2 g)) (copair T)
   (\ h -> EquivAp[l].pair-path (copair-inl T h) (copair-inr T h)) (copair-eta T) ;
} ;
