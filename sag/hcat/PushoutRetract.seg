-- A retract of a pushout square is a pushout square (Agda Pushout.agda
-- §6-§7; Rocq is_pushout_square_retract).  Level 2.
--   comp-id: for a retract S' < S whose face types are sets, r o s is the
--   identity square morphism (MorphismEq: equal corners).
--   sq-cone-pre-retract: precomposing a cone of S' with r then s gives it
--   back: s^* r^* = (r s)^* = 1^* = 1 (sq-cone-pre-comp, comp-id,
--   sq-cone-pre-id).
--   is-pushout-square-retract: the comparison of S' at X is a retract of
--   the comparison of S at X (retract-of-equiv): the sections are
--   h |-> comparison (h o rD) and r^*, the retractions h |-> (inverse) o sD
--   and s^*; they commute with the comparisons by sq-comparison-natural
--   (which uses that Map A_S D_S' and Map A_S' D_S are sets).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open WildCat ; open Squares ; open SquareAlg ; open ConeUnit ; open ConeAlg ; open ConeComp ;

module Retract (S1 S : Square) (R : square-retract[S1, S])
 (HAB : Pl.isSet (Map S1.sqA S1.sqB)) (HAC : Pl.isSet (Map S1.sqA S1.sqC))
 (HBD : Pl.isSet (Map S1.sqB S1.sqD)) (HCD : Pl.isSet (Map S1.sqC S1.sqD))
 (HrD : Pl.isSet (Map S.sqA S1.sqD)) (HsD : Pl.isSet (Map S1.sqA S.sqD)) {

 comp-id : Id (square-morphism[S1, S1]) (comp-sqm R.sr-r R.sr-s) (id-sqm S1) =
  MorphismEq[S1, S1, HAB, HAC, HBD, HCD].square-morphism-eq (comp-sqm R.sr-r R.sr-s) (id-sqm S1)
   R.sr-A R.sr-B R.sr-C R.sr-D ;

 sq-cone-pre-retract (X : Cat) (c : sq-cone S1 X) :
  Id (sq-cone S1 X) (sq-cone-pre R.sr-s X (sq-cone-pre R.sr-r X c)) c =
  H.transH (H.symH (sq-cone-pre-comp R.sr-r R.sr-s X c))
   (H.transH (H.apH (\ m -> sq-cone-pre m X c) comp-id) (sq-cone-pre-id S1 X c)) ;

 is-pushout-square-retract (HS : is-pushout-square S) : is-pushout-square S1 = \ X ->
  retract-of-equiv
   (\ h -> sq-comparison S X (sq-apex-pre R.sr-r X h)) (sq-cone-pre R.sr-r X)
   (\ a -> sq-apex-pre R.sr-s X ((HS X).sec a)) (sq-cone-pre R.sr-s X)
   (\ h -> H.transH (H.apH (sq-apex-pre R.sr-s X)
              (Pl.sec-ret (Map S.sqD X) (sq-cone S X) (sq-comparison S X) (HS X) (sq-apex-pre R.sr-r X h)))
           (H.transH (composeA h R.sr-r.smD R.sr-s.smD) (H.transH (ccr h R.sr-D) (comp-id-r h))))
   (sq-cone-pre-retract X)
   (sq-comparison S1 X)
   (\ h -> H.symH (sq-comparison-natural R.sr-r X HrD h))
   (\ a -> H.transH (sq-comparison-natural R.sr-s X HsD ((HS X).sec a))
            (H.apH (sq-cone-pre R.sr-s X) ((HS X).sec-eq a))) ;
} ;
