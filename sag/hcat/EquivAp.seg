-- Paths and equivalences (for the product principle of Product and the
-- path equivalences of TimesI).
--   ap-equiv: ap of an equivalence is an equivalence, by induction on
--   equivalences (univalence): for the identity, ap id is homotopic to
--   the identity (ap-id).  The same argument as
--   pi3-s2-postnikov/ClassBase.ap-equiv, not linked because of its
--   dependencies.
--   pair-path-fst/snd: the projections of the path (p, q) in A * B;
--   pair-path-eta: a path in A * B is the pair of its projections (J);
--   pair-path-uniq: two paths in A * B with equal projections are equal.
level l ; open Base ; open Prelude[l] ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;

ap-equiv (A B : U l) (e : Equiv A B) (x y : A) : isEquiv (Id A x y) (Id B (e.1 x) (e.1 y)) (ap A B e.1 x y) =
 Axioms[l].UnivalenceLemmas[univ @l].eqind A
  (\ B1 e1 -> (x1 y1 : A) -> isEquiv (Id A x1 y1) (Id B1 (e1.1 x1) (e1.1 y1)) (ap A B1 e1.1 x1 y1))
  (\ x1 y1 -> Equivalences[l].homotopy (Id A x1 y1) (Id A x1 y1) (idEquiv (Id A x1 y1)) (ap A A (\ a -> a) x1 y1)
    (\ p -> PA.ap-id p))
  B e x y ;

opaque ap-equiv ;

pair-path {A B : U l} {a a1 : A} {b b1 : B} (p : Id A a a1) (q : Id B b b1) : Id (A * B) (a, b) (a1, b1) =
 AffineHLevels[l].pair-path A B a a1 b b1 p q ;

pair-path-fst {A B : U l} {a a1 : A} {b b1 : B} (p : Id A a a1) (q : Id B b b1) :
 Id (Id A a a1) (H.apH (\ w -> w.1) (pair-path p q)) p =
 idJ B b (\ b2 q2 -> Id (Id A a a1) (H.apH (\ w -> w.1) (pair-path p q2)) p)
  (idJ A a (\ a2 p2 -> Id (Id A a a2) (H.apH (\ w -> w.1) (pair-path {A} {B} {a} {a2} {b} {b} p2 (refl b))) p2)
   (refl (refl a)) a1 p) b1 q ;

pair-path-snd {A B : U l} {a a1 : A} {b b1 : B} (p : Id A a a1) (q : Id B b b1) :
 Id (Id B b b1) (H.apH (\ w -> w.2) (pair-path p q)) q =
 idJ A a (\ a2 p2 -> Id (Id B b b1) (H.apH (\ w -> w.2) (pair-path p2 q)) q)
  (idJ B b (\ b2 q2 -> Id (Id B b b2) (H.apH (\ w -> w.2) (pair-path {A} {B} {a} {a} {b} {b2} (refl a) q2)) q2)
   (refl (refl b)) b1 q) a1 p ;

pair-path-eta {A B : U l} {w w1 : A * B} (r : Id (A * B) w w1) :
 Id (Id (A * B) w w1) (pair-path (H.apH (\ v -> v.1) r) (H.apH (\ v -> v.2) r)) r =
 idJ (A * B) w (\ w2 r2 -> Id (Id (A * B) w w2) (pair-path (H.apH (\ v -> v.1) r2) (H.apH (\ v -> v.2) r2)) r2)
  (refl (refl w)) w1 r ;

pair-path-uniq {A B : U l} {w w1 : A * B} (r s : Id (A * B) w w1)
 (hl : Id (Id A w.1 w1.1) (H.apH (\ v -> v.1) r) (H.apH (\ v -> v.1) s))
 (hr : Id (Id B w.2 w1.2) (H.apH (\ v -> v.2) r) (H.apH (\ v -> v.2) s)) : Id (Id (A * B) w w1) r s =
 H.transH (H.symH (pair-path-eta r))
  (H.transH (H.transH (H.apH (\ u -> pair-path u (H.apH (\ v -> v.2) r)) hl)
                      (H.apH (\ u -> pair-path (H.apH (\ v -> v.1) s) u) hr))
   (pair-path-eta s)) ;
