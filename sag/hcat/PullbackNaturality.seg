-- Naturality of the boundary of a pointed pullback under a map of
-- cospans. The cospan squares are specified homotopies, not strict
-- equations. Carry the pointing paths along those homotopies. The
-- resulting map on cones carries boundary(q) to boundary(ap h q), by
-- functoriality of ap and reassociation/cancellation of paths.
-- This is the type-theoretic naturality theorem; applying it to a map
-- of squares in D still requires its specified compatibility data.
level l ; open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;

frame {P : U l} {x y z x1 y1 : P} (a : Id P x1 x) (b : Id P y1 y)
 (u : Id P x z) (v : Id P y z) (q : Id P z z) :
 Id (Id P x1 y1)
  (H.transH a (H.transH (H.transH u (H.transH q (H.symH v))) (H.symH b)))
  (H.transH (H.transH a u) (H.transH q (H.symH (H.transH b v)))) =
 H.transH (H.apH (\ r -> H.transH a r) (PA.tassoc u (H.transH q (H.symH v)) (H.symH b)))
  (H.transH (H.apH (\ r -> H.transH a (H.transH u r)) (PA.tassoc q (H.symH v) (H.symH b)))
   (H.transH (H.symH (PA.tassoc a u (H.transH q (H.transH (H.symH v) (H.symH b)))))
    (H.apH (\ r -> H.transH (H.transH a u) (H.transH q r)) (H.symH (PA.sym-trans b v))))) ;

ap-boundary {P P1 : U l} (h : P -> P1) {x y z : P}
 (u : Id P x z) (v : Id P y z) (q : Id P z z) :
 Id (Id P1 (h x) (h y)) (H.apH h (H.transH u (H.transH q (H.symH v))))
  (H.transH (H.apH h u) (H.transH (H.apH h q) (H.symH (H.apH h v)))) =
 H.transH (PA.ap-trans h u (H.transH q (H.symH v)))
  (H.apH {Id P1 (h z) (h y)} {Id P1 (h x) (h y)} (\ r -> H.transH (H.apH h u) r)
   (H.transH (PA.ap-trans h q (H.symH v))
    (H.apH {Id P1 (h z) (h y)} {Id P1 (h z) (h y)} (\ r -> H.transH (H.apH h q) r) (PA.ap-sym h v)))) ;

module Map (B E P B1 E1 P1 : U l) (f : B -> P) (g : E -> P) (f1 : B1 -> P1) (g1 : E1 -> P1)
 (hb : B -> B1) (he : E -> E1) (hp : P -> P1)
 (sf : (b : B) -> Id P1 (f1 (hb b)) (hp (f b)))
 (sg : (e : E) -> Id P1 (g1 (he e)) (hp (g e)))
 (b : B) (e : E) (z : P) (u : Id P (f b) z) (v : Id P (g e) z) {
 module K = PointedPullback[l].Boundary[B, E, P, f, g, b, e, z, u, v] ;
 module T = PointedPullback[l].Boundary[B1, E1, P1, f1, g1, hb b, he e, hp z,
  H.transH (sf b) (H.apH hp u), H.transH (sg e) (H.apH hp v)] ;
 cones (w : K.Q.Cone) : T.Q.Cone =
  (hb w.1, he w.2.1, H.transH (sf w.1) (H.transH (H.apH hp w.2.2) (H.symH (sg w.2.1)))) ;
 boundary (q : Id P z z) : Id T.Q.Cone (cones (K.boundary q)) (T.boundary (H.apH hp q)) =
  H.apH (\ r -> (hb b, he e, r))
   (H.transH (H.apH (\ r -> H.transH (sf b) (H.transH r (H.symH (sg e)))) (ap-boundary hp u v q))
    (frame (sf b) (sg e) (H.apH hp u) (H.apH hp v) (H.apH hp q))) ;
} ;
