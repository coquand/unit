-- Feed the representable pullback into ONE fibre tower.
-- Stability identifies Hom(S,C) with the pullback cone; ConeZero
-- supplies its pointing. Flatten the cone and project to the product
-- Hom(S,B)*Hom(S,E). PullbackFibre supplies the exact connecting
-- homomorphism, as one fibre inclusion, not two separately chosen maps.
-- The pointed loop equivalences identify its source and target with
-- the EXISTING groups on Hom(Sigma^2 S,P) and Hom(Sigma S,C).
-- The outgoing map below is the transported product projection; its
-- comparison with the separately defined pair of postcomposition maps
-- is not asserted here. The whole tower and its naturality are inherited
-- from FibreTower and FibreTowerMaps, for a supplied pointed square.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
module PM = Pi0Maps[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open HigherCat ; open Constructions ; open Composition ; open Zero ; open Loops ; open HGroups ; open Pi0[l] ;

module Sequence (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee)
 (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv))
 (po : DPushout.DSquare[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pushout) (S : Ob D) {
 module C = Cone.DCone[Cc, Bb, Ee, P, ii, jj, uu, vv, ss] ;
 module Z = ConeZero.Point[Cc, Bb, Ee, P, ii, jj, uu, vv, ss, S] ;
 module F = PullbackFibre.Pull[Hom D S Bb, Hom D S Ee, Hom D S P,
  \ b -> hcomp {D} b uu, \ e -> hcomp {D} e vv,
  zmap S Bb, zmap S Ee, zmap S P, zero-post S uu, zero-post S vv] ;
 comparison (c : Hom D S Cc) : F.Cone = F.flatten (C.cone-map S c) ;
 comparison-equiv : Pl.isEquiv (Hom D S Cc) F.Cone comparison =
  EL.compose (Hom D S Cc) (C.Cone S) F.Cone F.flatten (C.cone-map S)
   F.flatten-equiv (stable Cc Bb Ee P ii jj uu vv ss po S) ;
 comparison-point : Id F.Cone (comparison (zmap S Cc)) F.point = H.apH F.flatten Z.cone-zero ;
 module Target = PointedEquivalence.Loops[Hom D S Cc, F.Cone, zmap S Cc, F.point,
  (comparison, comparison-equiv), comparison-point] ;
 module Source = HomologyDouble.At[S, P] ;
 module A = LoopGroup[susp S, P] ; module B = LoopGroup[S, Cc] ;
 module BE = PM.EquivalenceHom[LoopGrp[Hom D S Cc, zmap S Cc].grp, B.grp.G, B.e] ;
 source : Pl.Equiv A.grp.G LoopGrp[LoopOf[S].Om P, refl (zmap S P)].grp.G = Source.e ;
 target : Pl.Equiv B.grp.G LoopGrp[F.Cone, F.point].grp.G =
  EL.then B.grp.G LoopGrp[Hom D S Cc, zmap S Cc].grp.G LoopGrp[F.Cone, F.point].grp.G B.e Target.components ;
 source-hom : PM.is-hom A.grp LoopGrp[LoopOf[S].Om P, refl (zmap S P)].grp source.1 = Source.hom ;
 target-hom : PM.is-hom B.grp LoopGrp[F.Cone, F.point].grp target.1 =
  \ x y -> H.transH (H.apH Target.components.1 (BE.forward x y)) (Target.M.M.mul (B.e.1 x) (B.e.1 y)) ;
 module Back = PM.Inverse[B.grp, LoopGrp[F.Cone, F.point].grp, target, target-hom] ;
 connecting (a : A.grp.G) : B.grp.G = target.2.sec (F.connecting (source.1 a)) ;
 hom : PM.is-hom A.grp B.grp connecting = \ a b ->
  H.transH (H.apH (\ q -> target.2.sec (F.connecting q)) (source-hom a b))
   (H.transH (H.apH target.2.sec (F.hom (source.1 a) (source.1 b)))
    (Back.mul (F.connecting (source.1 a)) (F.connecting (source.1 b)))) ;
 outgoing (q : B.grp.G) : LoopGrp[(Hom D S Bb) * (Hom D S Ee), (zmap S Bb, zmap S Ee)].grp.G =
  F.Q.Out.M.map (target.1 q) ;
 outgoing-hom : PM.is-hom B.grp LoopGrp[(Hom D S Bb) * (Hom D S Ee), (zmap S Bb, zmap S Ee)].grp outgoing =
  \ x y -> H.transH (H.apH F.Q.Out.M.map (target-hom x y)) (F.Q.Out.M.mul (target.1 x) (target.1 y)) ;
 zero (a : A.grp.G) :
  Id LoopGrp[(Hom D S Bb) * (Hom D S Ee), (zmap S Bb, zmap S Ee)].grp.G
   (outgoing (connecting a)) LoopGrp[(Hom D S Bb) * (Hom D S Ee), (zmap S Bb, zmap S Ee)].grp.e =
  H.transH (H.apH F.Q.Out.M.map (target.2.sec-eq (F.connecting (source.1 a)))) (F.zero (source.1 a)) ;
 Image (q : B.grp.G) : U l = Tr.Trunc[(a : A.grp.G) * Id B.grp.G (connecting a) q].carrier ;
 image-prop (q : B.grp.G) : Pl.isProp (Image q) =
  Tr.Trunc[(a : A.grp.G) * Id B.grp.G (connecting a) q].proposition ;
 lift (q : B.grp.G) (a : LoopGrp[LoopOf[S].Om P, refl (zmap S P)].grp.G)
  (h : Id LoopGrp[F.Cone, F.point].grp.G (F.connecting a) (target.1 q)) : Image q =
  Tr.Trunc[(r : A.grp.G) * Id B.grp.G (connecting r) q].inc
   (source.2.sec a,
    H.transH (H.apH (\ w -> target.2.sec (F.connecting w)) (source.2.sec-eq a))
     (H.transH (H.apH target.2.sec h) (Pl.sec-ret B.grp.G LoopGrp[F.Cone, F.point].grp.G target.1 target.2 q))) ;
 exact (q : B.grp.G)
  (h : Id LoopGrp[(Hom D S Bb) * (Hom D S Ee), (zmap S Bb, zmap S Ee)].grp.G
   (outgoing q) LoopGrp[(Hom D S Bb) * (Hom D S Ee), (zmap S Bb, zmap S Ee)].grp.e) : Image q =
  TC.rec ((a : LoopGrp[LoopOf[S].Om P, refl (zmap S P)].grp.G) *
   Id LoopGrp[F.Cone, F.point].grp.G (F.connecting a) (target.1 q))
   @l (Image q) (image-prop q) (\ w -> lift q w.1 w.2) (F.exact (target.1 q) h) ;
} ;

module Types (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) (n : Nat) {
 module Ex = Excision.ExcisionOf[B, C, E, X, i, j, u, v, h, A] ;
 module Q = Sequence[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, Sph n] ;
} ;
