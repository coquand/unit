-- Invertible morphisms and fully faithful functors (Wärn, Definitions 33
-- and 34; Agda Simplices/FullyFaithful).  Level 1: the statements, so
-- that the axiom rezk can be stated in Structure.
--   is-inv f: postcomposition with f, Hom C x a -> Hom C x b, is an
--   equivalence for every x (condition 3 of Definition 34).  It is a
--   proposition, being an equivalence is one.
--   ObIso C a b: invertible morphisms a -> b.
--   is-ff F: every Hom-map F a0 a1 is an equivalence (Definition 33).
open Base ;
module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
open WildCat ; open HigherCat ; open Constructions ; open Composition ;

is-inv {C : Cat} {a b : Ob C} (f : Hom C a b) : U l =
 (x : Ob C) -> Pl.isEquiv (Hom C x a) (Hom C x b) (\ g -> hcomp g f) ;

is-inv-prop {C : Cat} {a b : Ob C} (f : Hom C a b) : Pl.isProp (is-inv f) =
 FL.isProp-Pi (Ob C) (\ x -> Pl.isEquiv (Hom C x a) (Hom C x b) (\ g -> hcomp g f))
  (\ x -> EquivProp[l].isEquiv-prop (Hom C x a) (Hom C x b) (\ g -> hcomp g f)) ;

ObIso (C : Cat) (a b : Ob C) : U l = (f : Hom C a b) * is-inv f ;

is-ff {A B : Cat} (F : Map A B) : U l =
 (a0 a1 : Ob A) -> Pl.isEquiv (Hom A a0 a1) (Hom B (Ob-map F a0) (Ob-map F a1)) (Hom-map F a0 a1) ;
