-- The wild category Cat (Wärn, Axiom 1; Agda Category/CatAxioms).  The
-- parameters of the segment Wild are the data of level 1: categories
-- Cat : U l+, functors Map A B : U l, composition comp g f = g o f, the
-- identities, and the associativity and unit laws as paths.  Map A B is
-- not a set: the laws are 2-cells.
--
-- Whiskering:  ccl g H : f o g = f' o g  for H : f = f', and
-- ccr f H : f o g = f o g'  for H : g = g'.  The reassociator in the
-- orientation of the Rocq proof:  composeA f g h : (f o g) o h = f o (g o h),
-- the inverse of comp-assoc.
--
-- A functor f : C -> D is an isomorphism when postcomposition
-- Map X C -> Map X D is an equivalence for every X (the representable
-- form).  isIso f is a proposition: being an equivalence is one
-- (EquivProp), and a product of propositions is one (fe).  Equiv-from C
-- is the type of isomorphisms out of C; univalence of Cat (Structure)
-- says it is contractible.
open Base ;
module H = Paths[l] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @l+] ;

ccl {A B C : Cat} (g : Map A B) {f f1 : Map B C} (h : Id (Map B C) f f1) :
 Id (Map A C) (comp f g) (comp f1 g) = H.apH (\ m -> comp m g) h ;

ccr {A B C : Cat} (f : Map B C) {g g1 : Map A B} (h : Id (Map A B) g g1) :
 Id (Map A C) (comp f g) (comp f g1) = H.apH (\ m -> comp f m) h ;

composeA {A B C D : Cat} (f : Map C D) (g : Map B C) (h : Map A B) :
 Id (Map A D) (comp (comp f g) h) (comp f (comp g h)) = H.symH (comp-assoc f g h) ;

post-comp {C D : Cat} (f : Map C D) (X : Cat) (g : Map X C) : Map X D = comp f g ;

isIso {C D : Cat} (f : Map C D) : U l+ =
 (X : Cat) -> Prelude[l].isEquiv (Map X C) (Map X D) (post-comp f X) ;

isIso-is-prop {C D : Cat} (f : Map C D) : Prelude[l+].isProp (isIso f) =
 FL1.isProp-Pi Cat (\ X -> Prelude[l].isEquiv (Map X C) (Map X D) (post-comp f X))
  (\ X -> EquivProp[l].isEquiv-prop (Map X C) (Map X D) (post-comp f X)) ;

Equiv-from (C : Cat) : U l+ = (D : Cat) * (f : Map C D) * isIso f ;
