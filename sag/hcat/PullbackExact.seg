-- Exactness at pi_1(P) for a pointed homotopy pullback.
-- PointedPullback proves the kernel-image assertion on actual loops.
-- Quotient induction and effectiveness pass it to components. The
-- difference is the ordinary group difference of the two loop maps.
-- No associativity or coherence axiom for Cat occurs in this file.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Pi0[l] ;
module PM = Pi0Maps[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;

module Exact (B E P : U l) (f : B -> P) (g : E -> P) (b : B) (e : E) (z : P)
 (u : Id P (f b) z) (v : Id P (g e) z) {
 module K = PointedPullback[l].Boundary[B, E, P, f, g, b, e, z, u, v] ;
 module F = PM.Pointed[B, P, b, z, f, u] ;
 module G = PM.Pointed[E, P, e, z, g, v] ;
 module L = LoopGrp[P, z] ;
 difference (a : LoopGrp[B, b].grp.G) (c : LoopGrp[E, e].grp.G) : L.grp.G =
  PM.diff L.grp (F.M.map a) (G.M.map c) ;
 difference-cls (a : Id B b b) (c : Id E e e) :
  Id L.grp.G (difference (cls a) (cls c)) (cls (K.diff a c)) =
  transH (apH (\ r -> PM.diff L.grp r (G.M.map (cls c))) (pi0-map-cls (Id B b b) L.O F.loop a))
   (transH (apH (PM.diff L.grp (cls (F.loop a))) (pi0-map-cls (Id E e e) L.O G.loop c))
    (transH (apH (L.grp.mul (cls (F.loop a))) (L.cl-inv (G.loop c)))
     (L.cl-mul (F.loop a) (symH (G.loop c))))) ;
 connect (q : L.grp.G) : pi0 K.Q.Cone = pi0-map L.O K.Q.Cone K.boundary q ;
 zero : pi0 K.Q.Cone = cls K.base ;
 connect-cls (q : L.O) : Id (pi0 K.Q.Cone) (connect (cls q)) (cls (K.boundary q)) =
  pi0-map-cls L.O K.Q.Cone K.boundary q ;
 connect-zero : Id (pi0 K.Q.Cone) (connect (cls (refl z))) zero =
  transH (connect-cls (refl z)) (apH (\ w -> cls w) K.boundary-zero) ;
 diff-zero-cls (a : Id B b b) (c : Id E e e) :
  Id (pi0 K.Q.Cone) (connect (difference (cls a) (cls c))) zero =
  transH (apH connect (difference-cls a c))
   (transH (connect-cls (K.diff a c)) (apH (\ w -> cls w) (K.diff-zero a c))) ;
 diff-zero (a : LoopGrp[B, b].grp.G) (c : LoopGrp[E, e].grp.G) :
  Id (pi0 K.Q.Cone) (connect (difference a c)) zero =
  pi0-ind (Id B b b) @l (\ a1 -> Id (pi0 K.Q.Cone) (connect (difference a1 c)) zero)
   (\ a1 -> pi0-set K.Q.Cone (connect (difference a1 c)) zero)
   (\ aa -> pi0-ind (Id E e e) @l (\ c1 -> Id (pi0 K.Q.Cone) (connect (difference (cls aa) c1)) zero)
     (\ c1 -> pi0-set K.Q.Cone (connect (difference (cls aa) c1)) zero) (diff-zero-cls aa) c) a ;
 Im (q : L.grp.G) : U l =
  Tr.Trunc[(a : LoopGrp[B, b].grp.G) * (c : LoopGrp[E, e].grp.G) * Id L.grp.G (difference a c) q].carrier ;
 im-prop (q : L.grp.G) : isProp (Im q) =
  Tr.Trunc[(a : LoopGrp[B, b].grp.G) * (c : LoopGrp[E, e].grp.G) * Id L.grp.G (difference a c) q].proposition ;
 lift-cls (q : L.O) (h : Id K.Q.Cone (K.boundary q) K.base) : Im (cls q) =
  Tr.Trunc[(a : LoopGrp[B, b].grp.G) * (c : LoopGrp[E, e].grp.G) * Id L.grp.G (difference a c) (cls q)].inc
   (cls (K.lift q h).1, cls (K.lift q h).2.1,
    transH (difference-cls (K.lift q h).1 (K.lift q h).2.1) (apH (\ r -> cls r) (symH (K.lift q h).2.2))) ;
 exact-cls (q : L.O) (h : Id (pi0 K.Q.Cone) (connect (cls q)) zero) : Im (cls q) =
  TC.rec (Id K.Q.Cone (K.boundary q) K.base) @l (Im (cls q)) (im-prop (cls q)) (lift-cls q)
   (pi0-eff K.Q.Cone (K.boundary q) K.base (transH (symH (connect-cls q)) h)) ;
 exact (q : L.grp.G) (h : Id (pi0 K.Q.Cone) (connect q) zero) : Im q =
  pi0-ind L.O @l (\ q1 -> Id (pi0 K.Q.Cone) (connect q1) zero -> Im q1)
   (\ q1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id (pi0 K.Q.Cone) (connect q1) zero)
     (\ h1 -> Im q1) (\ h1 -> im-prop q1)) exact-cls q h ;
} ;
