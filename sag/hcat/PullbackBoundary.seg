-- The boundary of a pointed homotopy pullback, before truncation.
-- For t : f b = g e, send a loop q at f b to (b,e,q.t).
-- A path from this point to (b,e,t) has legs a:b=b and c:e=e;
-- its square says (f a).t = (q.t).(g c). Solving gives
-- q = (((f a).t).(g c)^-1).t^-1. Conversely that word gives a path
-- of cones. Thus the fibre over the base component is precisely the
-- image of the difference of the two loop maps. No category axioms.
level l ; open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;

end-cancel {P : U l} {x y z : P} (a : Id P y z) (q : Id P x z) :
 Id (Id P x z) (H.transH (H.transH q (H.symH a)) a) q =
 H.transH (PA.tassoc q (H.symH a) a) (H.apH (\ r -> H.transH q r) (PA.inv-l a)) ;

word {P : U l} {x y : P} (t : Id P x y) (a : Id P x x) (c : Id P y y) : Id P x x =
 H.transH (H.transH (H.transH a t) (H.symH c)) (H.symH t) ;

word-square {P : U l} {x y : P} (t : Id P x y) (a : Id P x x) (c : Id P y y) :
 Id (Id P x y) (H.transH a t) (H.transH (H.transH (word t a c) t) c) =
 H.symH (H.transH (H.apH (\ r -> H.transH r c) (end-cancel t (H.transH (H.transH a t) (H.symH c))))
   (end-cancel c (H.transH a t))) ;

solve {P : U l} {x y : P} (t : Id P x y) (a : Id P x x) (c : Id P y y) (q : Id P x x)
 (s : Id (Id P x y) (H.transH a t) (H.transH (H.transH q t) c)) : Id (Id P x x) q (word t a c) =
 H.transH (H.symH (PA.canc-r t q))
  (H.transH (H.apH (\ r -> H.transH r (H.symH t)) (H.symH (PA.canc-r c (H.transH q t))))
   (H.apH (\ r -> H.transH (H.transH r (H.symH c)) (H.symH t)) (H.symH s))) ;

-- A commuting square equipped with compatible paths to one point.
pointed-square {P : U l} {x y xb yb m n z : P}
 (a0 : Id P x m) (b0 : Id P y n) (s : Id P m n)
 (a : Id P x xb) (b : Id P y yb) (u : Id P xb z) (v : Id P yb z)
 (r : Id P m z) (r1 : Id P n z)
 (ha : Id (Id P x z) (H.transH a0 r) (H.transH a u))
 (hb : Id (Id P y z) (H.transH b0 r1) (H.transH b v))
 (hs : Id (Id P m z) (H.transH s r1) r) :
 Id (Id P x yb) (H.transH a (H.transH u (H.symH v)))
  (H.transH (H.transH a0 (H.transH s (H.symH b0))) b) =
 PA.cancel-r v
  (H.transH
   (H.transH (PA.tassoc a (H.transH u (H.symH v)) v)
    (H.apH (\ w -> H.transH a w) (end-cancel v u)))
   (H.symH (calc (Id P x z) {
    H.transH (H.transH (H.transH a0 (H.transH s (H.symH b0))) b) v
    =< PA.tassoc (H.transH a0 (H.transH s (H.symH b0))) b v >
     H.transH (H.transH a0 (H.transH s (H.symH b0))) (H.transH b v)
    =< H.apH (\ w -> H.transH (H.transH a0 (H.transH s (H.symH b0))) w) (H.symH hb) >
     H.transH (H.transH a0 (H.transH s (H.symH b0))) (H.transH b0 r1)
    =< PA.tassoc a0 (H.transH s (H.symH b0)) (H.transH b0 r1) >
     H.transH a0 (H.transH (H.transH s (H.symH b0)) (H.transH b0 r1))
    =< H.apH (\ w -> H.transH a0 w) (PA.tassoc s (H.symH b0) (H.transH b0 r1)) >
     H.transH a0 (H.transH s (H.transH (H.symH b0) (H.transH b0 r1)))
    =< H.apH (\ w -> H.transH a0 (H.transH s w)) (PA.canc-l b0 r1) > H.transH a0 (H.transH s r1)
    =< H.apH (\ w -> H.transH a0 w) hs > H.transH a0 r
    =< ha > H.transH a u }))) ;

module Boundary (B E P : U l) (f : B -> P) (g : E -> P) (b : B) (e : E) (t : Id P (f b) (g e)) {
 module Q = PullbackPaths[l].Pull[B, E, P, f, g] ;
 base : Q.Cone = (b, e, t) ;
 boundary (q : Id P (f b) (f b)) : Q.Cone = (b, e, H.transH q t) ;
 boundary-zero : Id Q.Cone (boundary (refl (f b))) base =
  H.apH (\ r -> (b, e, r)) (PA.unit-l t) ;
 difference (a : Id B b b) (c : Id E e e) : Id P (f b) (f b) = word t (H.apH f a) (H.apH g c) ;
 difference-zero (a : Id B b b) (c : Id E e e) : Id Q.Cone (boundary (difference a c)) base =
  Q.path b b a e e c (H.transH (difference a c) t) t (word-square t (H.apH f a) (H.apH g c)) ;
 lift (q : Id P (f b) (f b)) (h : Id Q.Cone (boundary q) base) :
  (a : Id B b b) * (c : Id E e e) * Id (Id P (f b) (f b)) q (difference a c) =
  (H.apH (\ w -> w.1) h, H.apH (\ w -> w.2.1) h,
   solve t (H.apH f (H.apH (\ w -> w.1) h)) (H.apH g (H.apH (\ w -> w.2.1) h)) q (Q.cell (boundary q) base h)) ;
} ;
