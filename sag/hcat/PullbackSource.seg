-- Exactness at the source of the SAME structural connecting map.
-- The fibre of boundary:Omega P->Cone is Omega(B*E). Its explicit
-- equivalence reads the projected path of a cone; FibreInclusion proves
-- it is an equivalence. PointedPullback.solve identifies the projection
-- to Omega P with the loop difference. Looping this fibre sequence
-- therefore gives exactness at pi_2(P). Eckmann-Hilton removes the need
-- to compare the pointing paths of the difference square.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
module PA = PathAlgebra[l] ; module PM = Pi0Maps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open FibreLemmas ; open Pi0[l] ;

module Source (B E P : U l) (f : B -> P) (g : E -> P) (b : B) (e : E) (z : P)
 (u : Id P (f b) z) (v : Id P (g e) z) {
 module F = PullbackFibre.Pull[B, E, P, f, g, b, e, z, u, v] ;
 O : U l = Id P z z ;
 V : U l = Id (B * E) (b, e) (b, e) ;
 pointing : Id F.Cone (F.boundary (refl z)) F.point = H.apH (\ w -> w.1) F.witness-point ;
 module S = FibreSequence.Sequence[O, F.Cone, refl z, F.point, F.boundary, pointing] ;
 connect-square (q : LoopGrp[O, refl z].grp.G) :
  Id LoopGrp[F.Cone, F.point].grp.G (F.connecting q) (S.Out.M.map q) =
  PM.factor (Id O (refl z) (refl z)) (Id F.Q.F F.Q.point F.Q.point) (Id F.Cone F.point F.point)
   F.Source.M.loop F.Q.In.loop S.Out.loop
   (\ r -> FibreTowerNaturality.loop-composite O F.Q.F F.Cone (refl z) F.Q.point F.point
    F.witness F.witness-point (\ w -> w.1) (refl F.point) r) q ;
 module Incl = FibreInclusion.Inclusion[B * E, F.paths, (b, e), (b, e), F.point.2] ;
 change : Pl.Equiv S.F Incl.F =
  SigmaEquiv.Sigma-change-of-base O (F.paths (b, e))
   (\ r -> Id F.Cone ((b, e), r) F.point) F.translate ;
 read (w : S.F) : V = H.apH (\ t -> t.1) w.2 ;
 read-equiv : Pl.isEquiv S.F V read = EL.compose S.F Incl.F V Incl.read change.1 Incl.read-equiv change.2 ;
 read-point : Id V (read S.point) (refl (b, e)) =
  H.transH (PA.ap-comp (\ t -> t.1) (\ w -> w.1) F.witness-point)
   (H.transH (PA.ap-comp {Id P z (g e)} {F.Q.F} {B * E} (\ w -> w.1.1)
     (\ r -> (((b, e), H.transH u r), refl (b, e))) (PA.unit-l (H.symH v)))
    (PA.ap-constant (b, e) (PA.unit-l (H.symH v)))) ;
 module R = PointedEquivalence.Loops[S.F, V, S.point, refl (b, e), (read, read-equiv), read-point] ;
 difference (q : V) : O = F.Raw.diff (H.apH (\ w -> w.1) q) (H.apH (\ w -> w.2) q) ;
 difference-point : Id O (difference (refl (b, e))) (refl z) =
  PA.tcong (Conj[l].conj-one u) (H.apH (\ r -> H.symH r) (Conj[l].conj-one v)) ;
 module Diff = PM.Pointed[V, O, refl (b, e), refl z, difference, difference-point] ;
 unflatten (w : F.Cone) : F.Raw.Q.Cone = (w.1.1, w.1.2, w.2) ;
 left (w : S.F) :
  Id (Id B b b) (H.apH (\ t -> t.1) (H.apH unflatten w.2)) (H.apH (\ t -> t.1) (read w)) =
  H.transH (PA.ap-comp (\ t -> t.1) unflatten w.2)
   (H.symH (PA.ap-comp (\ t -> t.1) (\ t -> t.1) w.2)) ;
 right (w : S.F) :
  Id (Id E e e) (H.apH (\ t -> t.2.1) (H.apH unflatten w.2)) (H.apH (\ t -> t.2) (read w)) =
  H.transH (PA.ap-comp (\ t -> t.2.1) unflatten w.2)
   (H.symH (PA.ap-comp (\ t -> t.2) (\ t -> t.1) w.2)) ;
 over (w : S.F) : Id O w.1 (difference (read w)) =
  H.transH (F.Raw.lift w.1 (H.apH unflatten w.2)).2.2
   (H.transH (H.apH (\ a -> F.Raw.diff a (H.apH (\ t -> t.2.1) (H.apH unflatten w.2))) (left w))
    (H.apH (F.Raw.diff (H.apH (\ t -> t.1) (read w))) (right w))) ;
 module Comm = CommutingLoops.Target[O, refl z, \ a c -> EckmannHilton.eckmann-hilton a c] ;
 module Compare = Comm.Square[S.F, O, V, S.point, refl z, refl (b, e),
  \ w -> w.1, difference, read, \ a -> a,
  refl (refl z), difference-point, read-point, refl (refl z), over] ;
 identity (a : LoopGrp[O, refl z].grp.G) :
  Id LoopGrp[O, refl z].grp.G (Compare.VMap.M.map a) a =
  PM.map-id (Id O (refl z) (refl z)) Compare.VMap.loop
   (\ r -> H.transH (Conj[l].conj-refl-path (H.apH (\ t -> t) r)) (PA.ap-id r)) a ;
 projection (a : LoopGrp[S.F, S.point].grp.G) :
  Id LoopGrp[O, refl z].grp.G (S.In.M.map a) (Diff.M.map (R.components.1 a)) =
  H.transH (H.symH (identity (S.In.M.map a))) (Compare.groups a) ;
 zero (a : LoopGrp[V, refl (b, e)].grp.G) :
  Id LoopGrp[F.Cone, F.point].grp.G (F.connecting (Diff.M.map a)) LoopGrp[F.Cone, F.point].grp.e =
  H.transH (connect-square (Diff.M.map a))
   (H.transH (H.apH S.Out.M.map
     (H.transH (H.apH Diff.M.map (H.symH (R.components.2.sec-eq a)))
      (H.symH (projection (R.components.2.sec a))))) (S.zero (R.components.2.sec a))) ;
 Image (q : LoopGrp[O, refl z].grp.G) : U l =
  Tr.Trunc[(a : LoopGrp[V, refl (b, e)].grp.G) * Id LoopGrp[O, refl z].grp.G (Diff.M.map a) q].carrier ;
 image-prop (q : LoopGrp[O, refl z].grp.G) : Pl.isProp (Image q) =
  Tr.Trunc[(a : LoopGrp[V, refl (b, e)].grp.G) * Id LoopGrp[O, refl z].grp.G (Diff.M.map a) q].proposition ;
 exact (q : LoopGrp[O, refl z].grp.G)
  (h : Id LoopGrp[F.Cone, F.point].grp.G (F.connecting q) LoopGrp[F.Cone, F.point].grp.e) : Image q =
  TC.rec ((a : LoopGrp[S.F, S.point].grp.G) * Id LoopGrp[O, refl z].grp.G (S.In.M.map a) q)
   @l (Image q) (image-prop q)
   (\ w -> Tr.Trunc[(a : LoopGrp[V, refl (b, e)].grp.G) * Id LoopGrp[O, refl z].grp.G (Diff.M.map a) q].inc
    (R.components.1 w.1, H.transH (H.symH (projection w.1)) w.2))
   (S.exact q (H.transH (H.symH (connect-square q)) h)) ;
} ;
