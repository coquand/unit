-- X x One ~ X and evaluation at the point (Agda Category/UnitIso).
--   right-unit-cat X = <1, !> : X -> X x One, with pi1 a two-sided inverse:
--   pi1 o <1, !> = 1 (pair-beta1); <1, !> o pi1 = <1 o pi1, ! o pi1> =
--   <pi1, pi2> = <pi1 o 1, pi2 o 1> = 1 (pair-nat, Map _ One contractible,
--   pair-eta).
--   eval-pt = ev o <1, !> : Fun One I -> I is an isomorphism: for every Y,
--   postcomposition with it is u |-> (exp-comparison u) o <1, !>, since
--   both are ev o <u, !> (pair-nat, pair-beta); this is the exponential
--   equivalence followed by precomposition with the isomorphism <1, !>.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open ExpComparison ; open Retracts ;

right-unit-cat (X : Cat) : Map X (times X One) = pair (idMap X) (bang X) ;

eval-pt : Map (Fun One I) I = comp (ev One I) (right-unit-cat (Fun One I)) ;

right-unit-retract (X : Cat) : Id (Map X X) (comp (pi1 X One) (right-unit-cat X)) (idMap X) =
 pair-beta1 (idMap X) (bang X) ;

right-unit-section (X : Cat) : Id (Map (times X One) (times X One)) (comp (right-unit-cat X) (pi1 X One)) (idMap (times X One)) =
 H.transH (pair-nat (idMap X) (bang X) (pi1 X One))
  (H.transH (pair-ap (comp-id-l (pi1 X One)) (one-path (comp (bang X) (pi1 X One)) (pi2 X One)))
   (H.transH (pair-ap (H.symH (comp-id-r (pi1 X One))) (H.symH (comp-id-r (pi2 X One))))
    (pair-eta (idMap (times X One))))) ;

right-unit-isIso (X : Cat) : isIso (right-unit-cat X) =
 has-inverse-isIso (right-unit-cat X) (pi1 X One) (right-unit-section X) (right-unit-retract X) ;

eval-pt-eq (Y : Cat) (u : Map Y (Fun One I)) :
 Id (Map Y I) (comp eval-pt u) (comp (exp-comparison One I Y u) (right-unit-cat Y)) =
 H.transH lhs (H.symH rhs)
 where {
  lhs : Id (Map Y I) (comp eval-pt u) (comp (ev One I) (pair u (bang Y))) =
   H.transH (composeA (ev One I) (right-unit-cat (Fun One I)) u)
    (ccr (ev One I) (H.transH (pair-nat (idMap (Fun One I)) (bang (Fun One I)) u)
     (pair-ap (comp-id-l u) (one-path (comp (bang (Fun One I)) u) (bang Y))))) ;
  rhs : Id (Map Y I) (comp (exp-comparison One I Y u) (right-unit-cat Y)) (comp (ev One I) (pair u (bang Y))) =
   H.transH (composeA (ev One I) (pair (comp u (pi1 Y One)) (pi2 Y One)) (right-unit-cat Y))
    (ccr (ev One I) (H.transH (pair-nat (comp u (pi1 Y One)) (pi2 Y One) (right-unit-cat Y))
     (pair-ap (H.transH (composeA u (pi1 Y One) (right-unit-cat Y))
               (H.transH (ccr u (pair-beta1 (idMap Y) (bang Y))) (comp-id-r u)))
              (pair-beta2 (idMap Y) (bang Y))))) ;
 } ;

pre-comp-right-unit (Y : Cat) : Pl.Equiv (Map (times Y One) I) (Map Y I) =
 (\ h -> comp h (right-unit-cat Y),
  Pl.qinv (Map (times Y One) I) (Map Y I) (\ h -> comp h (right-unit-cat Y)) (\ h1 -> comp h1 (pi1 Y One))
   (\ h1 -> H.transH (composeA h1 (pi1 Y One) (right-unit-cat Y))
     (H.transH (ccr h1 (right-unit-retract Y)) (comp-id-r h1)))
   (\ h -> H.transH (composeA h (right-unit-cat Y) (pi1 Y One))
     (H.transH (ccr h (right-unit-section Y)) (comp-id-r h)))) ;

eval-pt-isIso : isIso eval-pt = \ Y ->
 EquivalenceLemmas[l].homotopy (Map Y (Fun One I)) (Map Y I)
  (\ u -> comp (exp-comparison One I Y u) (right-unit-cat Y)) (post-comp eval-pt Y)
  (\ u -> H.symH (eval-pt-eq Y u))
  (EquivalenceLemmas[l].compose (Map Y (Fun One I)) (Map (times Y One) I) (Map Y I)
    (\ h -> comp h (right-unit-cat Y)) (exp-comparison One I Y)
    (pre-comp-right-unit Y).2 (exp-is-equiv One I Y)) ;
