-- The face map Delta n -> Delta (n+1) (Agda Simplices/FaceMap).
--   mor-to-ord-le: a morphism of Delta n orders the ordinals of its
--   endpoints (mor-reflects-ord, read through the section law).
--   face-p (u, z) = face-ord (c20 u) (c20 z) on objects of Delta n x Delta n
--   is monotone (in both variables), hence a functor face-adj to I, whose
--   transpose is face n : Delta n -> Fun (Delta n) I = Delta (n+1).
open Base ; open Finite[l] ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open Exponentials ;
open OrdMonotone ; open MonotoneMaps ; open Interval ; open Construction20 ; open FaceOrd ;

leqOrd-transport (n : Nat) {a a1 b b1 : Ord n} (p : Id (Ord n) a a1) (q : Id (Ord n) b b1) (h : leqOrd n a b) : leqOrd n a1 b1 =
 H.substH (\ y -> leqOrd n a1 y) q (H.substH (\ x -> leqOrd n x b) p h) ;

mor-to-ord-le : (n : Nat) (m : Mor (Delta n)) ->
 leqOrd n ((construction-20 n).1 (dom m)) ((construction-20 n).1 (cod m)) = split {
 zero -> \ m -> tt ;
 suc k -> \ m -> leqOrd-transport (suc k)
   (H.transH (H.apH (construction-20 (suc k)).1 (H.symH (mor-reflects-ord k m).2.2.1))
    ((construction-20 (suc k)).2.sec-eq (mor-reflects-ord k m).1))
   (H.transH (H.apH (construction-20 (suc k)).1 (H.symH (mor-reflects-ord k m).2.2.2.1))
    ((construction-20 (suc k)).2.sec-eq (mor-reflects-ord k m).2.1))
   (mor-reflects-ord k m).2.2.2.2 } ;

face-p (n : Nat) (w : Ob (times (Delta n) (Delta n))) : Two =
 face-ord n ((construction-20 n).1 (Ob-map (pi1 (Delta n) (Delta n)) w)) ((construction-20 n).1 (Ob-map (pi2 (Delta n) (Delta n)) w)) ;

face-p-dom (n : Nat) (m : Mor (times (Delta n) (Delta n))) :
 Id Two (face-ord n ((construction-20 n).1 (dom (funct-on-mor (pi1 (Delta n) (Delta n)) m))) ((construction-20 n).1 (dom (funct-on-mor (pi2 (Delta n) (Delta n)) m)))) (face-p n (dom m)) =
 H.transH (H.apH {Ob (Delta n)} {Two} (\ a -> face-ord n ((construction-20 n).1 a) ((construction-20 n).1 (dom (funct-on-mor (pi2 (Delta n) (Delta n)) m)))) (dom-nat (pi1 (Delta n) (Delta n)) m))
  (H.apH {Ob (Delta n)} {Two} (\ b -> face-ord n ((construction-20 n).1 (Ob-map (pi1 (Delta n) (Delta n)) (dom m))) ((construction-20 n).1 b)) (dom-nat (pi2 (Delta n) (Delta n)) m)) ;

face-p-cod (n : Nat) (m : Mor (times (Delta n) (Delta n))) :
 Id Two (face-ord n ((construction-20 n).1 (cod (funct-on-mor (pi1 (Delta n) (Delta n)) m))) ((construction-20 n).1 (cod (funct-on-mor (pi2 (Delta n) (Delta n)) m)))) (face-p n (cod m)) =
 H.transH (H.apH {Ob (Delta n)} {Two} (\ a -> face-ord n ((construction-20 n).1 a) ((construction-20 n).1 (cod (funct-on-mor (pi2 (Delta n) (Delta n)) m)))) (cod-nat (pi1 (Delta n) (Delta n)) m))
  (H.apH {Ob (Delta n)} {Two} (\ b -> face-ord n ((construction-20 n).1 (Ob-map (pi1 (Delta n) (Delta n)) (cod m))) ((construction-20 n).1 b)) (cod-nat (pi2 (Delta n) (Delta n)) m)) ;

face-p-mono (n : Nat) : is-monotone (times (Delta n) (Delta n)) (face-p n) = \ m ->
 leq2-transport (face-p-dom n m) (face-p-cod n m)
  (face-ord-mono n
   ((construction-20 n).1 (dom (funct-on-mor (pi1 (Delta n) (Delta n)) m))) ((construction-20 n).1 (cod (funct-on-mor (pi1 (Delta n) (Delta n)) m)))
   ((construction-20 n).1 (dom (funct-on-mor (pi2 (Delta n) (Delta n)) m))) ((construction-20 n).1 (cod (funct-on-mor (pi2 (Delta n) (Delta n)) m)))
   (mor-to-ord-le n (funct-on-mor (pi1 (Delta n) (Delta n)) m)) (mor-to-ord-le n (funct-on-mor (pi2 (Delta n) (Delta n)) m))) ;

face-adj (n : Nat) : Map (times (Delta n) (Delta n)) I = I-char-inverse (times (Delta n) (Delta n)) (face-p n, face-p-mono n) ;

face (n : Nat) : Map (Delta n) (Delta (suc n)) = (exp-is-equiv (Delta n) I (Delta n)).sec (face-adj n) ;
