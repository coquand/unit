-- The reduced homology of the spheres (H5), from the suspension
-- isomorphism, the empty type and the dimension axiom.
--   sphere 0 = Sigma Empty (two points), sphere (n+1) = Sigma (sphere n),
--   Sigma the suspension of types (tsusp, a pushout of 1 <- X -> 1).
--   red-empty: Red S Empty A ~ Hom (Sigma S, 1 (x) A).  Hom (S, 0 (x) A)
--   is contractible (0 (x) A is initial, so it is a retract of the zero
--   object: zt then zi is the identity), so Red S Empty A is the path type
--   0 t! = 0, i.e. Omega (Hom (S, 1 (x) A), 0) (zero-post), i.e.
--   Hom (Sigma S, 1 (x) A) (L).
--   red-shift: Red (Sph (n + j)) (sphere (n + m)) A ~ Red (Sph j) (sphere m) A,
--   by susp-red n times.
--   dim-equiv: Hom (B, 1 (x) A) ~ Hom (B, A) (the dimension axiom:
--   eta_tt : A -> 1 (x) A is invertible).
--   Theorem (sphere-above): reduced (n + j + 1) (sphere n) A ~ Pi0 Hom (Sph (j + 1), A),
--   i.e. H~_(n+j+1)(S^n; A) = pi_(j+1)(A) (red-shift, susp-red, red-empty).
--   With desuspensions (desusp-eq : Sigma (desusp B) = B):
--   red-sphere m B: Red B (sphere m) A ~ Hom (desusp^m B, A) for every B
--   (B = Sigma (desusp B), then susp-red; red-empty at m = 0).  Hence
--   Theorem (sphere-homology): H~_(n+j)(S^n; A) = Pi0 Hom (Sph j, A) = pi_j(A),
--   in particular H~_n(S^n; A) = pi_0(A) = H_0(1; A); and
--   H~_k(S^(k+m); A) = Pi0 Hom (desusp^m 1, A) = pi_(-m)(A) (sphere-below).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ;
module CU = FunExtUA[l] ;
open HigherCat ; open Constructions ; open Composition ; open CompLaws ; open Associativity ;
open TensorMap ; open TensorInvariance ; open SigmaEquiv ; open FibreAlg ;
open Zero ; open Loops ; open HGroups ; open Suspension ; open Pi0[l] ;

sphere : Nat -> U k = split { zero -> tsusp Empty ; suc n | r -> tsusp r } ;

nplus : Nat -> Nat -> Nat = split { zero -> \ j -> j ; suc n | r -> \ j -> suc (r j) } ;

nplus-zero : (n : Nat) -> Id Nat (nplus n zero) n = split {
 zero -> refl zero ;
 suc n | r -> H.apH (\ m -> suc m) r } ;

susp-red-of (X : U k) (A S : Ob D) : Pl.Equiv (Red (susp S) (tsusp X) A) (Red S X A) =
 SuspOf[X, tsusp X, tnorth X, tsouth X, tmerid X, tsusp-po X, A, S].susp-red ;

module EmptyRed (A S : Ob D) {
 E0 : Ob D = tensor Empty A ;
 retract-id : Id (Hom D E0 E0) (hcomp {D} (zt E0) (zi E0)) (id-hom E0) =
  CU.pathC (Hom D E0 E0) (empty-initial A E0) (hcomp {D} (zt E0) (zi E0)) (id-hom E0) ;
 to-zero (c : Hom D S E0) : Id (Hom D S E0) c (zmap S E0) =
  calc (Hom D S E0) {
   c
   =< H.symH (hcomp-unit-r c) > hcomp {D} c (id-hom E0)
   =< H.apH (\ w -> hcomp {D} c w) (H.symH retract-id) > hcomp {D} c (hcomp {D} (zt E0) (zi E0))
   =< H.symH (hcomp-assoc D (S, E0, zobj, E0, c, zt E0, zi E0)) > hcomp {D} (hcomp {D} c (zt E0)) (zi E0)
   =< H.apH (\ w -> hcomp {D} w (zi E0)) (zt-eq (hcomp {D} c (zt E0))) > zmap S E0 } ;
 contr : CU.isContr (Hom D S E0) = (zmap S E0, \ c -> H.symH (to-zero c)) ;
 red-empty : Pl.Equiv (Red S Empty A) (Hom D (susp S) (tensor Top A)) =
  EL.then (Red S Empty A) (Id (Hom D S (tensor Top A)) (hcomp {D} (zmap S E0) (tmap A {Empty} {Top} (\ x -> tt))) (zmap S (tensor Top A)))
   (Hom D (susp S) (tensor Top A))
   (sigma-contr (Hom D S E0) contr (\ c -> Id (Hom D S (tensor Top A)) (hcomp {D} c (tmap A {Empty} {Top} (\ x -> tt))) (zmap S (tensor Top A))))
   (EL.then (Id (Hom D S (tensor Top A)) (hcomp {D} (zmap S E0) (tmap A {Empty} {Top} (\ x -> tt))) (zmap S (tensor Top A)))
     (Id (Hom D S (tensor Top A)) (zmap S (tensor Top A)) (zmap S (tensor Top A))) (Hom D (susp S) (tensor Top A))
     (pre-comp-path-equiv (H.symH (zero-post S (tmap A {Empty} {Top} (\ x -> tt)))))
     (EL.inverse (Hom D (susp S) (tensor Top A)) (Id (Hom D S (tensor Top A)) (zmap S (tensor Top A)) (zmap S (tensor Top A)))
       (LoopOf[S].L (tensor Top A), LoopOf[S].L-equiv (tensor Top A)))) ;
} ;

-- the dimension axiom: maps into 1 (x) A are maps into A
dim-equiv (A B : Ob D) : Pl.Equiv (Hom D B (tensor Top A)) (Hom D B A) =
 EL.inverse (Hom D B A) (Hom D B (tensor Top A)) (\ g -> hcomp {D} g (eta Top A tt), dim-is-inv A B) ;

red-shift (A : Ob D) (j m : Nat) : (n : Nat) -> Pl.Equiv (Red (Sph (nplus n j)) (sphere (nplus n m)) A) (Red (Sph j) (sphere m) A) = split {
 zero -> Pl.idEquiv (Red (Sph j) (sphere m) A) ;
 suc n | r -> EL.then (Red (Sph (suc (nplus n j))) (sphere (suc (nplus n m))) A) (Red (Sph (nplus n j)) (sphere (nplus n m)) A) (Red (Sph j) (sphere m) A)
  (susp-red-of (sphere (nplus n m)) A (Sph (nplus n j))) r } ;

-- H~_(n+j+1)(S^n; A) = Pi0 Hom (Sph (j+1), A), without desuspensions
sphere-above (A : Ob D) (n j : Nat) : Pl.Equiv (reduced (nplus n (suc j)) (sphere n) A) (pi0 (Hom D (Sph (suc j)) A)) =
 pi0-equiv (Red (Sph (nplus n (suc j))) (sphere n) A) (Hom D (Sph (suc j)) A)
  (EL.then (Red (Sph (nplus n (suc j))) (sphere n) A) (Red (Sph (suc j)) (sphere zero) A) (Hom D (Sph (suc j)) A)
   (H.substH (\ m -> Pl.Equiv (Red (Sph (nplus n (suc j))) (sphere m) A) (Red (Sph (suc j)) (sphere zero) A)) (nplus-zero n) (red-shift A (suc j) zero n))
   (EL.then (Red (Sph (suc j)) (sphere zero) A) (Red (Sph j) Empty A) (Hom D (Sph (suc j)) A)
     (susp-red-of Empty A (Sph j))
     (EL.then (Red (Sph j) Empty A) (Hom D (Sph (suc j)) (tensor Top A)) (Hom D (Sph (suc j)) A)
       EmptyRed[A, Sph j].red-empty (dim-equiv A (Sph (suc j)))))) ;

------------------------------------------------------------------------
-- with desuspensions

dsn : Nat -> Ob D -> Ob D = split { zero -> \ B -> B ; suc m | r -> \ B -> r (desusp B) } ;

-- Red along a path of objects
red-path (X : U k) (A : Ob D) {B1 B : Ob D} (p : Id (Ob D) B1 B) : Pl.Equiv (Red B1 X A) (Red B X A) =
 idJ (Ob D) B1 (\ B2 p2 -> Pl.Equiv (Red B1 X A) (Red B2 X A)) (Pl.idEquiv (Red B1 X A)) B p ;

-- Red B X' A ~ Red (desusp B) X A for X' the suspension of X
red-desusp (X : U k) (A B : Ob D) : Pl.Equiv (Red B (tsusp X) A) (Red (desusp B) X A) =
 EL.then (Red B (tsusp X) A) (Red (susp (desusp B)) (tsusp X) A) (Red (desusp B) X A)
  (red-path (tsusp X) A (H.symH (desusp-eq B))) (susp-red-of X A (desusp B)) ;

hom-path (T : Ob D) {B1 B : Ob D} (p : Id (Ob D) B1 B) : Pl.Equiv (Hom D B1 T) (Hom D B T) =
 idJ (Ob D) B1 (\ B2 p2 -> Pl.Equiv (Hom D B1 T) (Hom D B2 T)) (Pl.idEquiv (Hom D B1 T)) B p ;

red-sphere (A : Ob D) : (m : Nat) (B : Ob D) -> Pl.Equiv (Red B (sphere m) A) (Hom D (dsn m B) A) = split {
 zero -> \ B -> EL.then (Red B (sphere zero) A) (Red (desusp B) Empty A) (Hom D B A)
   (red-desusp Empty A B)
   (EL.then (Red (desusp B) Empty A) (Hom D (susp (desusp B)) (tensor Top A)) (Hom D B A)
     EmptyRed[A, desusp B].red-empty
     (EL.then (Hom D (susp (desusp B)) (tensor Top A)) (Hom D B (tensor Top A)) (Hom D B A)
       (hom-path (tensor Top A) (desusp-eq B)) (dim-equiv A B))) ;
 suc m | r -> \ B -> EL.then (Red B (sphere (suc m)) A) (Red (desusp B) (sphere m) A) (Hom D (dsn m (desusp B)) A)
   (red-desusp (sphere m) A B) (r (desusp B)) } ;

-- H~_(n+j)(S^n; A) = pi_j (A); at j = 0, H~_n(S^n; A) = Pi0 Hom (1, A)
sphere-homology (A : Ob D) (n j : Nat) : Pl.Equiv (reduced (nplus n j) (sphere n) A) (pi0 (Hom D (Sph j) A)) =
 pi0-equiv (Red (Sph (nplus n j)) (sphere n) A) (Hom D (Sph j) A)
  (EL.then (Red (Sph (nplus n j)) (sphere n) A) (Red (Sph j) (sphere zero) A) (Hom D (Sph j) A)
   (H.substH (\ m -> Pl.Equiv (Red (Sph (nplus n j)) (sphere m) A) (Red (Sph j) (sphere zero) A)) (nplus-zero n) (red-shift A j zero n))
   (red-sphere A zero (Sph j))) ;

-- H~_k(S^(k+m); A) = Pi0 Hom (desusp^m 1, A)
sphere-below (A : Ob D) (k m : Nat) : Pl.Equiv (reduced k (sphere (nplus k m)) A) (pi0 (Hom D (dsn m unitD) A)) =
 pi0-equiv (Red (Sph k) (sphere (nplus k m)) A) (Hom D (dsn m unitD) A)
  (EL.then (Red (Sph k) (sphere (nplus k m)) A) (Red unitD (sphere m) A) (Hom D (dsn m unitD) A)
   (H.substH (\ k1 -> Pl.Equiv (Red (Sph k1) (sphere (nplus k m)) A) (Red unitD (sphere m) A)) (nplus-zero k) (red-shift A zero m k))
   (red-sphere A m unitD)) ;
