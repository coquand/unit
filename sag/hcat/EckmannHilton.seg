-- Eckmann-Hilton (H4): 2-loops commute, hence loops in any type
-- equivalent to a loop space commute.  Type theory only.
--   interchange: for a : p = p1, b : q = q1 (loops at w),
--     ap (- . q) a . ap (p1 . -) b = ap (p . -) b . ap (- . q1) a
--   (J on a; at a = refl it is unit-l).
--   ap-htpy: for h : f ~ g, ap f p . h y = h x . ap g p (J on p).
--   eckmann-hilton: for a, b : refl = refl, interchange at p = q = refl;
--   ap (- . refl) a = a (- . refl is the identity by definition, ap-id);
--   ap (refl . -) b = b (ap-htpy along unit-l, which is refl at refl).
--   comm-transfer: if F : Y -> Z is an equivalence, rho : F y0 = z0 and
--   loops at z0 commute, loops at y0 commute: Phi = conj rho o ap F
--   preserves composition (ap-trans, conj-mul) and is injective
--   (ap-equiv, conj-inj).
--   loop-comm: loops at y0 commute when F : Y ~ Omega (W, w).  Loops at
--   any loop m0 of W commute by comm-transfer along (- . m0^-1), with
--   rho = inv-r, from eckmann-hilton; then comm-transfer along F.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; open Conj[l] ;

interchange {W : U l} {w : W} (p q q1 : Id W w w) (b : Id (Id W w w) q q1) (p1 : Id W w w) (a : Id (Id W w w) p p1) :
 Id (Id (Id W w w) (H.transH p q) (H.transH p1 q1))
  (H.transH (H.apH (\ x -> H.transH x q) a) (H.apH (\ x -> H.transH p1 x) b))
  (H.transH (H.apH (\ x -> H.transH p x) b) (H.apH (\ x -> H.transH x q1) a)) =
 idJ (Id W w w) p (\ p2 a2 -> Id (Id (Id W w w) (H.transH p q) (H.transH p2 q1))
   (H.transH (H.apH (\ x -> H.transH x q) a2) (H.apH (\ x -> H.transH p2 x) b))
   (H.transH (H.apH (\ x -> H.transH p x) b) (H.apH (\ x -> H.transH x q1) a2)))
  (PA.unit-l (H.apH (\ x -> H.transH p x) b)) p1 a ;

ap-htpy {A B : U l} (f g : A -> B) (h : (x : A) -> Id B (f x) (g x)) {x y : A} (p : Id A x y) :
 Id (Id B (f x) (g y)) (H.transH (H.apH f p) (h y)) (H.transH (h x) (H.apH g p)) =
 idJ A x (\ y1 p1 -> Id (Id B (f x) (g y1)) (H.transH (H.apH f p1) (h y1)) (H.transH (h x) (H.apH g p1))) (PA.unit-l (h x)) y p ;

whisker-l {W : U l} {w : W} (b : Id (Id W w w) (refl w) (refl w)) :
 Id (Id (Id W w w) (refl w) (refl w)) (H.apH (\ x -> H.transH (refl w) x) b) b =
 H.transH (ap-htpy (\ x -> H.transH (refl w) x) (\ x -> x) (\ x -> PA.unit-l x) b)
  (H.transH (PA.unit-l (H.apH (\ x -> x) b)) (PA.ap-id b)) ;

eckmann-hilton {W : U l} {w : W} (a b : Id (Id W w w) (refl w) (refl w)) :
 Id (Id (Id W w w) (refl w) (refl w)) (H.transH a b) (H.transH b a) =
 H.transH (PA.tcong (H.symH (PA.ap-id a)) (H.symH (whisker-l b)))
  (H.transH (interchange (refl w) (refl w) (refl w) b (refl w) a)
   (PA.tcong (whisker-l b) (PA.ap-id a))) ;

comm-transfer (Y Z : U l) (F : Y -> Z) (eF : Pl.isEquiv Y Z F) (y0 : Y) (z0 : Z) (rho : Id Z (F y0) z0)
 (cZ : (u v : Id Z z0 z0) -> Id (Id Z z0 z0) (H.transH u v) (H.transH v u)) (a b : Id Y y0 y0) :
 Id (Id Y y0 y0) (H.transH a b) (H.transH b a) =
 Equivalences[l].injective (Id Y y0 y0) (Id Z (F y0) (F y0)) (H.apH F) (EquivAp[l].ap-equiv Y Z (F, eF) y0 y0) (H.transH a b) (H.transH b a)
  (conj-inj rho (H.apH F (H.transH a b)) (H.apH F (H.transH b a))
   (H.transH (phi-mul a b) (H.transH (cZ (conj rho (H.apH F a)) (conj rho (H.apH F b))) (H.symH (phi-mul b a)))))
 where {
  phi-mul (a1 b1 : Id Y y0 y0) : Id (Id Z z0 z0) (conj rho (H.apH F (H.transH a1 b1))) (H.transH (conj rho (H.apH F a1)) (conj rho (H.apH F b1))) =
   H.transH (H.apH (\ r -> conj rho r) (PA.ap-trans F a1 b1)) (conj-mul rho (H.apH F a1) (H.apH F b1)) ;
 } ;

loop-comm-at (W : U l) (w : W) (m0 : Id W w w) (u v : Id (Id W w w) m0 m0) :
 Id (Id (Id W w w) m0 m0) (H.transH u v) (H.transH v u) =
 comm-transfer (Id W w w) (Id W w w) (\ m -> H.transH m (H.symH m0)) (SigmaEquiv.post-comp-path-equiv {W} {w} {w} {w} (H.symH m0)).2
  m0 (refl w) (PA.inv-r m0) (\ u1 v1 -> eckmann-hilton u1 v1) u v ;

loop-comm (Y W : U l) (w : W) (F : Y -> Id W w w) (eF : Pl.isEquiv Y (Id W w w) F) (y0 : Y) (a b : Id Y y0 y0) :
 Id (Id Y y0 y0) (H.transH a b) (H.transH b a) =
 comm-transfer Y (Id W w w) F eF y0 (F y0) (refl (F y0)) (loop-comm-at W w (F y0)) a b ;
