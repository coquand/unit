-- The second projection factor of the product pentagon, second half, and
-- prod-pent-C itself (split from ProductPentagonR for the 1 s budget).
-- The steps s4-s7, sr, sl and the factor continue InjrFactor.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open Naturality ; open Pullbacks ; open ProductMap ; open ProductPentagonFrames ; open ProductPentagon ;

-- The pi2 factor.  pi2 o pm(f, j) = j o pi2, so the second components of
-- the maps of the chain are composites of identities, and the frames end
-- at 1 (1 (1 pi2)); the cells changing the second argument now show the
-- unit law (pme2-r), and pm(k g) and pm(g h) are over 1 rather than 1 1,
-- which the frames absorb by  G = (l1^-1 o pi2) . a(1,1,pi2)  and
-- E = (l1^-1 o (1 pi2)) . a(1,1,1 pi2).  In the square of the whiskered
-- pmc, the naturality of a in its first argument at l1^-1 and the
-- interchange (xch) move the unit cell past the projection law of pm h.
-- The image of the reassociator is invisible to pi2 (pme1-r); the two
-- frames then differ by 1 o G against E, which agree by the unit loop of
-- CatCoherence (unit-ge).
open ProductPentagonR ;

module InjrFactor2 (C0 C1 C2 D C : Cat) (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) {
 open Cells[C0, C1, C2, D, C, k, g, h] ;
 open InjrFactor[C0, C1, C2, D, C, k, g, h] ;
 s4 : Id (Id (Map (times C0 C) C) (comp rD (comp (comp pk pg) ph)) (comp Ic (comp Ic (comp Ic r0)))) (H.transH (ccr rD cp4) f4) f3 =
  assoc-frame rk rg rh ;
 sz : Id (Id (Map (times C0 C) C) (comp r2 (comp pg ph)) (comp Ic (comp Ic r0)))
  (H.transH (ccr r2 zc) (H.transH rgh ug)) (frame2 rg rh) =
  sq-cons (\ m -> comp r2 m) (H.symH (pmc h g Ic Ic)) (product-map-eq2 (comp g h) ul)
   (H.transH (H.symH (PA.tassoc (ccr r2 (product-map-eq2 (comp g h) ul)) rgh ug))
   (H.transH (H.apH (\ z -> H.transH z ug) (pme2-r (comp g h) ul))
   (H.transH (PA.tassoc rgh2 (ccl r0 ul) ug)
    (H.apH (\ z -> H.transH rgh2 z)
     (H.transH (H.apH (\ z -> H.transH (ccl r0 ul) (H.transH z (composeA Ic Ic r0))) (PA.ap-sym (\ m -> comp m r0) ul))
      (canc-r2 (ccl r0 ul) (composeA Ic Ic r0)))))))
   (sq-inv (\ m -> comp r2 m) (pmc h g Ic Ic)
    (H.transH (H.apH (\ z -> H.transH z (frame2 rg rh)) (pmc-injr h g Ic Ic)) (leg-frame rgh2 rh rg))) ;
 s5 : Id (Id (Map (times C0 C) C) (comp rD (comp pk (comp pg ph))) (comp Ic (comp Ic (comp Ic r0)))) (H.transH (ccr rD cp5) f5) f4 =
  H.transH (H.symH (PA.tassoc (ccr rD cp5) (frame rk pgh) (ccr Ic (H.transH rgh ug))))
  (H.transH (H.apH (\ z -> H.transH z (ccr Ic (H.transH rgh ug))) (frame-whisker rk zc))
  (H.transH (PA.tassoc (frame rk (comp pg ph)) (ccr Ic (ccr r2 zc)) (ccr Ic (H.transH rgh ug)))
   (H.apH (\ z -> H.transH (frame rk (comp pg ph)) z)
    (H.transH (H.symH (PA.ap-trans (\ m -> comp Ic m) (ccr r2 zc) (H.transH rgh ug)))
     (H.apH (\ z -> ccr Ic z) sz))))) ;
 s6 : Id (Id (Map (times C0 C) C) (comp rD (comp pk pgh)) (comp Ic (comp Ic (comp Ic r0)))) (H.transH (ccr rD cp6) f6) f5 =
  sq-inv (\ m -> comp rD m) (pmc (comp g h) k Ic Ic)
  (H.transH (H.apH (\ z -> H.transH z f5) (pmc-injr (comp g h) k Ic Ic))
  (H.transH (H.apH (\ z -> H.transH (pmc-legr (comp g h) k Ic Ic) (H.transH (frame rk pgh) z))
     (PA.ap-trans (\ m -> comp Ic m) rgh ug))
  (H.transH (H.apH (\ z -> H.transH (pmc-legr (comp g h) k Ic Ic) z)
     (H.symH (PA.tassoc (frame rk pgh) (ccr Ic rgh) (ccr Ic ug))))
  (H.transH (H.symH (PA.tassoc (pmc-legr (comp g h) k Ic Ic) (frame2 rk rgh) (ccr Ic ug)))
  (H.transH (H.apH (\ z -> H.transH z (ccr Ic ug)) (leg-frame rb2 rgh rk))
   (PA.tassoc rb2 (composeA Ic Ic r0) (ccr Ic ug))))))) ;
 s7 : Id (Id (Map (times C0 C) C) (comp rD (product-map (comp k (comp g h)) I2)) (comp Ic (comp Ic (comp Ic r0))))
  (H.transH (ccr rD cp7) f7) f6 =
  sq-inv (\ m -> comp rD m) (product-map-eq2 (comp k (comp g h)) (H.symH ul))
   (H.transH (H.symH (PA.tassoc (ccr rD (product-map-eq2 (comp k (comp g h)) (H.symH ul))) rb2 nb))
   (H.transH (H.apH (\ z -> H.transH z nb) (pme2-r (comp k (comp g h)) (H.symH ul)))
    (PA.tassoc rb1 (ccl r0 (H.symH ul)) nb))) ;
 sr : Id (Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) Ic)) (comp Ic (comp Ic (comp Ic r0))))
  (H.transH (ccr rD t1) f7) f0 =
  sq-cons (\ m -> comp rD m) cp1 t2
   (sq-cons (\ m -> comp rD m) cp2 t3
    (sq-cons (\ m -> comp rD m) cp3 t4
     (sq-cons (\ m -> comp rD m) cp4 t5
      (sq-cons (\ m -> comp rD m) cp5 t6
       (sq-cons (\ m -> comp rD m) cp6 cp7 s7 s6) s5) s4) s3) s2) s1 ;
 sl : Id (Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) Ic)) (comp Ic (comp Ic (comp Ic r0))))
  (H.transH (ccr rD (product-map-eq1 Ic (composeA k g h))) f7) f0 =
  H.transH (H.symH (PA.tassoc (ccr rD (product-map-eq1 Ic (composeA k g h))) rb1 (H.transH (ccl r0 (H.symH ul)) nb)))
  (H.transH (H.apH (\ z -> H.transH z (H.transH (ccl r0 (H.symH ul)) nb)) (pme1-r Ic (composeA k g h)))
   (H.apH (\ z -> H.transH ra1 (H.transH (ccl r0 (H.symH ul)) (H.transH (composeA Ic Ic r0) z))) unit-ge)) ;
 factor : Id (Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) Ic)) (comp rD (product-map (comp k (comp g h)) Ic)))
  (ccr rD (product-map-eq1 Ic (composeA k g h))) (ccr rD (prodpent-rhs-C k g h)) =
  PA.cancel-r f7 (H.transH sl (H.symH sr)) ;
} ;

prod-pent-C-injl {C0 C1 C2 D C : Cat} (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) :
 Id (Id (Map (times C0 C) D) (comp (pi1 D C) (product-map (comp (comp k g) h) (idMap C)))
     (comp (pi1 D C) (product-map (comp k (comp g h)) (idMap C))))
  (ccr (pi1 D C) (product-map-eq1 (idMap C) (composeA k g h))) (ccr (pi1 D C) (prodpent-rhs-C k g h)) =
 InjlFactor[C0, C1, C2, D, C, k, g, h].factor ;

prod-pent-C-injr {C0 C1 C2 D C : Cat} (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) :
 Id (Id (Map (times C0 C) C) (comp (pi2 D C) (product-map (comp (comp k g) h) (idMap C)))
     (comp (pi2 D C) (product-map (comp k (comp g h)) (idMap C))))
  (ccr (pi2 D C) (product-map-eq1 (idMap C) (composeA k g h))) (ccr (pi2 D C) (prodpent-rhs-C k g h)) =
 InjrFactor2[C0, C1, C2, D, C, k, g, h].factor ;

prod-pent-C {C0 C1 C2 D C : Cat} (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) :
 Id (Id (Map (times C0 C) (times D C)) (product-map (comp (comp k g) h) (idMap C)) (product-map (comp k (comp g h)) (idMap C)))
  (product-map-eq1 (idMap C) (composeA k g h)) (prodpent-rhs-C k g h) =
 prod-path-eq (product-map-eq1 (idMap C) (composeA k g h)) (prodpent-rhs-C k g h)
  (prod-pent-C-injl k g h) (prod-pent-C-injr k g h) ;
