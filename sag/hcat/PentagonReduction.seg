-- Reduce the specified internal pentagon to the universal 4-simplex.
-- flat4 reads a chain as five objects and four composable arrows;
-- unflat4 inserts tt, giving an equivalence. Composing with segal-all
-- gives segal4. A section of the pentagon type on these simplex spines
-- extends to all chains using the inverse and its beta path.
-- Separately, assoc-on-spine identifies the ACTUAL chosen associator
-- with OnSpine.result, by the computation rule for equiv-ind.
-- Neither statement assumes hpent or introduces any new parameter of
-- the axiom system. The argument of extend is a remaining proof task.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
open HigherCat ; open Constructions ; open Interval ; open Chains ; open SegalAll ; open Associativity ;

assoc-on-spine (C : Cat) (T : Map (Delta (suc (suc (suc zero)))) C) :
 Id (Id (Hom C (flat3 C (spine-total C (suc (suc (suc zero))) T)).1
                 (flat3 C (spine-total C (suc (suc (suc zero))) T)).2.2.2.1)
      (assoc-lhs C (flat3 C (spine-total C (suc (suc (suc zero))) T)))
      (assoc-rhs C (flat3 C (spine-total C (suc (suc (suc zero))) T))))
  (hcomp-assoc C (flat3 C (spine-total C (suc (suc (suc zero))) T))) (OnSpine[C, T].result) =
 EquivIndBeta.rule (Map (Delta (suc (suc (suc zero)))) C) (Quad C)
  ((\ S -> flat3 C (spine-total C (suc (suc (suc zero))) S)), segal3 C)
  (\ q -> Hom C q.1 q.2.2.2.1) (assoc-lhs C) (assoc-rhs C) (\ S -> OnSpine[C, S].result) T ;

Five (C : Cat) : U l = (a : Ob C) * (b : Ob C) * (c : Ob C) * (d : Ob C) * (e : Ob C) * Hom C a b * Hom C b c * Hom C c d * Hom C d e ;

flat4 (C : Cat) (t : TC C (suc (suc (suc (suc zero))))) : Five C =
 (q.1, q.2.1, q.2.2.1, q.2.2.2.1, t.1, q.2.2.2.2.1, q.2.2.2.2.2.1, q.2.2.2.2.2.2, t.2.2.2)
 where { q : Quad C = flat3 C (t.2.1, t.2.2.1) ; } ;

unflat4 (C : Cat) (q : Five C) : TC C (suc (suc (suc (suc zero)))) =
 (q.2.2.2.2.1, q.2.2.2.1, (q.2.2.1, (q.2.1, (q.1, tt, q.2.2.2.2.2.1), q.2.2.2.2.2.2.1), q.2.2.2.2.2.2.2.1), q.2.2.2.2.2.2.2.2) ;

pentagon (C : Cat) (q : Five C) : U l =
 HcompPentagon.Pentagon C q.2.2.2.2.2.1 q.2.2.2.2.2.2.1 q.2.2.2.2.2.2.2.1 q.2.2.2.2.2.2.2.2 ;

flat4-equiv (C : Cat) : Pl.isEquiv (TC C (suc (suc (suc (suc zero))))) (Five C) (flat4 C) =
 Pl.qinv (TC C (suc (suc (suc (suc zero))))) (Five C) (flat4 C) (unflat4 C) (\ q -> refl q)
  (\ t -> H.apH {Top} {TC C (suc (suc (suc (suc zero))))}
   (\ u -> (t.1, t.2.1, (t.2.2.1.1, (t.2.2.1.2.1.1,
    (t.2.2.1.2.1.2.1.1, u, t.2.2.1.2.1.2.1.2.2), t.2.2.1.2.1.2.2), t.2.2.1.2.2), t.2.2.2))
   (isTop tt t.2.2.1.2.1.2.1.2.1)) ;

spine4 (C : Cat) (T : Map (Delta (suc (suc (suc (suc zero))))) C) : Five C =
 flat4 C (spine-total C (suc (suc (suc (suc zero)))) T) ;

segal4 (C : Cat) : Pl.isEquiv (Map (Delta (suc (suc (suc (suc zero))))) C) (Five C) (spine4 C) =
 EL.compose (Map (Delta (suc (suc (suc (suc zero))))) C) (TC C (suc (suc (suc (suc zero))))) (Five C)
  (flat4 C) (spine-total C (suc (suc (suc (suc zero))))) (flat4-equiv C) (segal-all (suc (suc (suc (suc zero)))) C) ;

extend (C : Cat) (on-spines : (T : Map (Delta (suc (suc (suc (suc zero))))) C) -> pentagon C (spine4 C T))
 (q : Five C) : pentagon C q =
 H.substH (pentagon C) ((segal4 C).sec-eq q) (on-spines ((segal4 C).sec q)) ;
