-- Construction 20: Ob (Delta n) ~ Ord n (Agda Interval/Interval, the
-- mutual block construction-20 / monotone-step / monotone-transfer /
-- ord-to-mor-fn / mor-reflects-ord).
--
-- The mutual recursion is one recursion on n of a Stage n: an equivalence
-- e : Ob (Delta n) ~ Ord n such that e^-1 preserves the order (x <= y
-- gives a morphism e^-1 x -> e^-1 y) and reflects it (every morphism m is,
-- up to paths, e^-1 x -> e^-1 y with x <= y).
--   build-mt: from such an e, Monotone (Delta n) ~ MonotoneOrd n by
--   precomposition with e^-1 (forwards) and with e (backwards); a monotone
--   map stays monotone because e^-1 preserves and reflects the order.
--   Stage 0: Ob One is contractible; Ord 0 = 1.
--   Stage n+1: Ob (Delta (n+1)) = Ob (Fun (Delta n) I) ~ Map (Delta n) I
--   (ob-map-equiv) ~ Monotone (Delta n) (I-char) ~ MonotoneOrd n
--   (build-mt) ~ Ord (n+1) (monotone-ord).  The inverse preserves the
--   order: for x <= y the two monotone maps are pointwise ordered
--   (monotone-ord-bwd-pw), so their functors are (I-char-ob-to-2), and
--   pointwise-to-mor gives the morphism.  It reflects the order: for a
--   morphism m of Fun (Delta n) I the images of dom m and cod m are
--   pointwise ordered (mor-to-pointwise), hence ordered in Ord (n+1)
--   (monotone-ord-fwd-mono); the paths are the retraction law.
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ; module CU = FunExtUA[l] ;
module EL = EquivalenceLemmas[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open Exponentials ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ;

module BuildMT (C : Cat) (n : Nat) (e : Pl.Equiv (Ob C) (Ord n))
 (pres : (p : Ob C -> Two) -> is-monotone C p -> is-monotone-Ord n (\ x -> p (e.2.sec x)))
 (refl-pf : (p : Ob C -> Two) -> is-monotone-Ord n (\ x -> p (e.2.sec x)) -> is-monotone C p) {
 fwd (w : Monotone C) : MonotoneOrd n = (\ x -> w.1 (e.2.sec x), pres w.1 w.2) ;
 bwd (v : MonotoneOrd n) : Monotone C =
  (\ z -> v.1 (e.1 z),
   refl-pf (\ z -> v.1 (e.1 z)) (\ x y le ->
    leq2-transport (H.symH (H.apH v.1 (e.2.sec-eq x))) (H.symH (H.apH v.1 (e.2.sec-eq y))) (v.2 x y le))) ;
 rinv (v : MonotoneOrd n) : Id (MonotoneOrd n) (fwd (bwd v)) v =
  Pl.Sigma-eq (Ord n -> Two) (is-monotone-Ord n) (fwd (bwd v)).1 v.1 (fwd (bwd v)).2 v.2
   (FL.funext (Ord n) (\ x -> Two) (fwd (bwd v)).1 v.1 (\ x -> H.apH v.1 (e.2.sec-eq x)))
   (is-monotone-Ord-is-prop n v.1) ;
 linv (w : Monotone C) : Id (Monotone C) (bwd (fwd w)) w =
  Pl.Sigma-eq (Ob C -> Two) (is-monotone C) (bwd (fwd w)).1 w.1 (bwd (fwd w)).2 w.2
   (FL.funext (Ob C) (\ z -> Two) (bwd (fwd w)).1 w.1 (\ z -> H.apH w.1 (Pl.sec-ret (Ob C) (Ord n) e.1 e.2 z)))
   (is-monotone-is-prop C w.1) ;
 equiv : Pl.Equiv (Monotone C) (MonotoneOrd n) = (fwd, Pl.qinv (Monotone C) (MonotoneOrd n) fwd bwd rinv linv) ;
} ;

-- e^-1 preserves the order
Preserves (n : Nat) (e : Pl.Equiv (Ob (Delta n)) (Ord n)) : U l =
 (x y : Ord n) -> leqOrd n x y -> Hom (Delta n) (e.2.sec x) (e.2.sec y) ;

-- e^-1 reflects the order
Reflects (n : Nat) (e : Pl.Equiv (Ob (Delta n)) (Ord n)) : U l =
 (m : Mor (Delta n)) -> (x : Ord n) * (y : Ord n) *
  Id (Ob (Delta n)) (e.2.sec x) (dom m) * Id (Ob (Delta n)) (e.2.sec y) (cod m) * leqOrd n x y ;

Stage (n : Nat) : U l = (e : Pl.Equiv (Ob (Delta n)) (Ord n)) * Preserves n e * Reflects n e ;

transfer-pres (n : Nat) (s : Stage n) (p : Ob (Delta n) -> Two) (mono : is-monotone (Delta n) p) :
 is-monotone-Ord n (\ x -> p (s.1.2.sec x)) = \ x y le ->
 leq2-transport (H.apH p (hdom (s.2.1 x y le))) (H.apH p (hcod (s.2.1 x y le))) (mono (hmor (s.2.1 x y le))) ;

transfer-refl (n : Nat) (s : Stage n) (p : Ob (Delta n) -> Two) (mo : is-monotone-Ord n (\ x -> p (s.1.2.sec x))) :
 is-monotone (Delta n) p = \ m ->
 leq2-transport (H.apH p (s.2.2 m).2.2.1) (H.apH p (s.2.2 m).2.2.2.1) (mo (s.2.2 m).1 (s.2.2 m).2.1 (s.2.2 m).2.2.2.2) ;

transfer-of (n : Nat) (s : Stage n) : Pl.Equiv (Monotone (Delta n)) (MonotoneOrd n) =
 BuildMT[Delta n, n, s.1, transfer-pres n s, transfer-refl n s].equiv ;

step-of (n : Nat) (s : Stage n) : Pl.Equiv (Monotone (Delta n)) (Ord (suc n)) =
 EL.then (Monotone (Delta n)) (MonotoneOrd n) (Ord (suc n)) (transfer-of n s) (monotone-ord n) ;

c20-of (n : Nat) (s : Stage n) : Pl.Equiv (Ob (Delta (suc n))) (Ord (suc n)) =
 EL.then (Ob (Fun (Delta n) I)) (Map (Delta n) I) (Ord (suc n)) (ob-map-equiv (Delta n) I)
  (EL.then (Map (Delta n) I) (Monotone (Delta n)) (Ord (suc n)) (I-char (Delta n)) (step-of n s)) ;

preserves-of (n : Nat) (s : Stage n) : Preserves (suc n) (c20-of n s) = \ x y le ->
 pointwise-to-mor (Delta n)
  (I-char-inverse (Delta n) ((transfer-of n s).2.sec (monotone-ord-bwd n x)))
  (I-char-inverse (Delta n) ((transfer-of n s).2.sec (monotone-ord-bwd n y)))
  (\ z -> leq2-transport
    (H.symH (I-char-ob-to-2 (Delta n) ((transfer-of n s).2.sec (monotone-ord-bwd n x)) z))
    (H.symH (I-char-ob-to-2 (Delta n) ((transfer-of n s).2.sec (monotone-ord-bwd n y)) z))
    (monotone-ord-bwd-pw n x y le (s.1.1 z))) ;

reflects-of (n : Nat) (s : Stage n) : Reflects (suc n) (c20-of n s) = \ m ->
 ((c20-of n s).1 (dom m), (c20-of n s).1 (cod m),
  Pl.sec-ret (Ob (Delta (suc n))) (Ord (suc n)) (c20-of n s).1 (c20-of n s).2 (dom m),
  Pl.sec-ret (Ob (Delta (suc n))) (Ord (suc n)) (c20-of n s).1 (c20-of n s).2 (cod m),
  monotone-ord-fwd-mono n
   ((transfer-of n s).1 (I-char-comparison (Delta n) (ob-to-map (Delta n) I (dom m))))
   ((transfer-of n s).1 (I-char-comparison (Delta n) (ob-to-map (Delta n) I (cod m))))
   (\ o -> mor-to-pointwise (Delta n) m (s.1.2.sec o))) ;

stage0 : Stage zero =
 (contr-equiv-one {Map One One} (terminal One),
  \ x y le -> id-hom {One} (terminal One).1,
  \ m -> (tt, tt, CU.pathC (Map One One) (terminal One) (terminal One).1 (dom m),
          CU.pathC (Map One One) (terminal One) (terminal One).1 (cod m), tt)) ;

stage : (n : Nat) -> Stage n = split {
 zero -> stage0 ;
 suc n | r -> (c20-of n r, preserves-of n r, reflects-of n r) } ;

------------------------------------------------------------------------
-- the statements of the Agda block

construction-20 (n : Nat) : Pl.Equiv (Ob (Delta n)) (Ord n) = (stage n).1 ;

monotone-transfer (n : Nat) : Pl.Equiv (Monotone (Delta n)) (MonotoneOrd n) = transfer-of n (stage n) ;

monotone-step (n : Nat) : Pl.Equiv (Monotone (Delta n)) (Ord (suc n)) = step-of n (stage n) ;

ord-to-mor-fn (n : Nat) (x y : Ord n) (le : leqOrd n x y) :
 Hom (Delta n) ((construction-20 n).2.sec x) ((construction-20 n).2.sec y) = (stage n).2.1 x y le ;

mor-reflects-ord (n : Nat) (m : Mor (Delta (suc n))) : (x : Ord (suc n)) * (y : Ord (suc n)) *
 Id (Ob (Delta (suc n))) ((construction-20 (suc n)).2.sec x) (dom m) *
 Id (Ob (Delta (suc n))) ((construction-20 (suc n)).2.sec y) (cod m) * leqOrd (suc n) x y =
 (stage (suc n)).2.2 m ;

-- by definition: the successor stage, the transfer read at an ordinal,
-- and the inverse of the transfer read at an object
construction-20-suc (n : Nat) : Id (Pl.Equiv (Ob (Delta (suc n))) (Ord (suc n))) (construction-20 (suc n))
 (EL.then (Ob (Fun (Delta n) I)) (Map (Delta n) I) (Ord (suc n)) (ob-map-equiv (Delta n) I)
  (EL.then (Map (Delta n) I) (Monotone (Delta n)) (Ord (suc n)) (I-char (Delta n)) (monotone-step n))) =
 refl (construction-20 (suc n)) ;

mt-fwd-eq (n : Nat) (w : Monotone (Delta n)) (o : Ord n) :
 Id Two (((monotone-transfer n).1 w).1 o) (w.1 ((construction-20 n).2.sec o)) = refl (w.1 ((construction-20 n).2.sec o)) ;

mt-bwd-eq (n : Nat) (v : MonotoneOrd n) (z : Ob (Delta n)) :
 Id Two (((monotone-transfer n).2.sec v).1 z) (v.1 ((construction-20 n).1 z)) = refl (v.1 ((construction-20 n).1 z)) ;

transfer-pointwise (n : Nat) (x y : Ord (suc n)) (le : leqOrd (suc n) x y) (z : Ob (Delta n)) :
 leq2 (((monotone-transfer n).2.sec (monotone-ord-bwd n x)).1 z) (((monotone-transfer n).2.sec (monotone-ord-bwd n y)).1 z) =
 monotone-ord-bwd-pw n x y le ((construction-20 n).1 z) ;
