-- The five specified steps of HomTriple.long as cells with endpoints.
-- The functor-path step uses naturality in the first argument; the
-- fourth step reverses the endpoint-transport comparison; the last
-- step maps the original Hom-map-of-comp proof. Each form lemma
-- identifies the existing proof term with the reading of its cell.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open HomPaths ; open HomCells ;

module Triple (A B C D : Cat) (F : Map C D) (G : Map B C) (K : Map A B) (m : Mor A) {
 module T = HomTriple.Triple[A, B, C, D, F, G, K, m] ;
 x : Ob D = Ob-map F (Ob-map G (Ob-map K (dom m))) ;
 y : Ob D = Ob-map F (Ob-map G (Ob-map K (cod m))) ;
 module R = At[D, x, y] ;
 module Ch = HomFunctorPaths.Change[A, D, comp (comp F G) K, m] ;
 gamma : Id (Map A D) (comp (comp F G) K) (comp F (comp G K)) = composeA F G K ;
 ch0 : Hom D (Ob-map (comp F (comp G K)) (dom m)) (Ob-map (comp F (comp G K)) (cod m)) = Ch.source (comp F (comp G K)) gamma ;
 ch1 : Hom D (Ob-map (comp F (comp G K)) (dom m)) (Ob-map (comp F (comp G K)) (cod m)) = Ch.target (comp F (comp G K)) ;
 chcell : Cell[D, Ob-map (comp F (comp G K)) (dom m), Ob-map (comp F (comp G K)) (cod m), ch0, ch1] =
  new Cell[D, Ob-map (comp F (comp G K)) (dom m), Ob-map (comp F (comp G K)) (cod m), ch0, ch1,
   ccl {I} {A} {D} m gamma, Naturality.compose-naturality1 {One} {I} {A} {D} m I0 gamma, Naturality.compose-naturality1 {One} {I} {A} {D} m I1 gamma] ;
 module Ch1 = Coerce[D, Ob-map (comp F (comp G K)) (dom m), Ob-map (comp F (comp G K)) (cod m), ch0, ch1, chcell,
  Ob-map F (Ob-map (comp G K) (dom m)), Ob-map F (Ob-map (comp G K) (cod m)), T.b12 (dom m), T.b12 (cod m)] ;
 module Ch2 = Coerce[D, Ob-map F (Ob-map (comp G K) (dom m)), Ob-map F (Ob-map (comp G K) (cod m)),
  Hom-coerce D (T.b12 (dom m)) (T.b12 (cod m)) ch0, Hom-coerce D (T.b12 (dom m)) (T.b12 (cod m)) ch1, Ch1.cell,
  x, y, T.b23 (dom m), T.b23 (cod m)] ;
 h1 : Hom D x y = Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m)) (Hom-coerce D (T.b12 (dom m)) (T.b12 (cod m)) ch0) ;
 h2 : Hom D x y = Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m)) (Hom-coerce D (T.b12 (dom m)) (T.b12 (cod m)) ch1) ;
 module V = R.Ends[hmor T.source, hdom T.source, hcod T.source] ;
 cell1 : Cell[D, x, y, T.source, h1] = V.cell (hdom h1) (hcod h1) T.Endpoint[I0].vertex T.Endpoint[I1].vertex ;
 step1 : Id (Hom D x y) T.source h1 = Hom-ends D (hmor T.source) T.Endpoint[I0].vertex T.Endpoint[I1].vertex ;
 form1 : Id (Id (Hom D x y) T.source h1) step1 (R.read T.source h1 cell1) =
  V.form (hdom h1) (hcod h1) T.Endpoint[I0].vertex T.Endpoint[I1].vertex ;
 step2 : Id (Hom D x y) h1 h2 =
  H.apH (\ w -> Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m)) (Hom-coerce D (T.b12 (dom m)) (T.b12 (cod m)) w))
   (Ch.change (comp F (comp G K)) gamma) ;
 form2 : Id (Id (Hom D x y) h1 h2) step2 (R.read h1 h2 Ch2.cell) =
  H.transH (H.symH (PA.ap-comp (Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m)))
    (Hom-coerce D (T.b12 (dom m)) (T.b12 (cod m))) (Ch.change (comp F (comp G K)) gamma)))
   (H.transH (H.apH (\ p -> H.apH (Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m)))
      (H.apH (Hom-coerce D (T.b12 (dom m)) (T.b12 (cod m))) p)) (Ch.form (comp F (comp G K)) gamma))
    (H.transH (H.apH (\ p -> H.apH (Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m))) p) Ch1.form) Ch2.form)) ;

 module N = HomCompEndpoints.Normal[A, C, D, F, comp G K, m] ;
 n0 : Hom D (Ob-map F (Ob-map (comp G K) (dom m))) (Ob-map F (Ob-map (comp G K) (cod m))) =
  N.source (dom m) (cod m) (refl (dom m)) (refl (cod m)) ;
 n1 : Hom D (Ob-map F (Ob-map (comp G K) (dom m))) (Ob-map F (Ob-map (comp G K) (cod m))) =
  N.target (dom m) (cod m) (refl (dom m)) (refl (cod m)) ;
 nc : Cell[D, Ob-map F (Ob-map (comp G K) (dom m)), Ob-map F (Ob-map (comp G K) (cod m)), n0, n1] =
  new Cell[D, Ob-map F (Ob-map (comp G K) (dom m)), Ob-map F (Ob-map (comp G K) (cod m)), n0, n1,
   composeA {I} {A} {C} {D} F (comp G K) m, N.E0.cell (dom m) (refl (dom m)), N.E1.cell (cod m) (refl (cod m))] ;
 module Nc = Coerce[D, Ob-map F (Ob-map (comp G K) (dom m)), Ob-map F (Ob-map (comp G K) (cod m)), n0, n1, nc,
  x, y, T.b23 (dom m), T.b23 (cod m)] ;
 h3 : Hom D x y = Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m)) n1 ;
 step3 : Id (Hom D x y) h2 h3 = H.apH (Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m)))
  (HomFunctor.Hom-map-of-comp F (comp G K) (dom m) (cod m) T.h) ;
 form3 : Id (Id (Hom D x y) h2 h3) step3 (R.read h2 h3 Nc.cell) =
  H.transH (H.apH (\ p -> H.apH (Hom-coerce D (T.b23 (dom m)) (T.b23 (cod m))) p)
    (N.form (dom m) (refl (dom m)) (cod m) (refl (cod m)))) Nc.form ;

 module Q = HomCompEndpoints.Normal[A, B, C, G, K, m] ;
 q0 : Hom C (Ob-map G (Ob-map K (dom m))) (Ob-map G (Ob-map K (cod m))) = Q.source (dom m) (cod m) (refl (dom m)) (refl (cod m)) ;
 q1 : Hom C (Ob-map G (Ob-map K (dom m))) (Ob-map G (Ob-map K (cod m))) = Q.target (dom m) (cod m) (refl (dom m)) (refl (cod m)) ;
 h4 : Hom D x y = Hom-map F (Ob-map G (Ob-map K (dom m))) (Ob-map G (Ob-map K (cod m))) q0 ;
 module Cc = HomFunctorPaths.Coerce[C, D, F, Ob-map (comp G K) (dom m), Ob-map (comp G K) (cod m),
  Hom-map (comp G K) (dom m) (cod m) T.h] ;
 ep : Id (Id (Ob D) (dom (hmor h4)) x) (hdom h4) (hdom h3) =
  Cc.endpoint I0 (Ob-map (comp G K) (dom m)) (composeA {One} {I} {A} {C} (comp G K) m I0) (Ob-map G (Ob-map K (dom m))) (T.inner (dom m)) ;
 eq : Id (Id (Ob D) (cod (hmor h4)) y) (hcod h4) (hcod h3) =
  Cc.endpoint I1 (Ob-map (comp G K) (cod m)) (composeA {One} {I} {A} {C} (comp G K) m I1) (Ob-map G (Ob-map K (cod m))) (T.inner (cod m)) ;
 module End4 = R.Ends[hmor h4, hdom h4, hcod h4] ;
 module Rev4 = R.Ends[hmor h3, hdom h3, hcod h3] ;
 cell4 : Cell[D, x, y, h3, h4] = Rev4.cell (hdom h4) (hcod h4) (H.symH ep) (H.symH eq) ;
 step4 : Id (Hom D x y) h3 h4 = H.symH (Cc.naturality (Ob-map G (Ob-map K (dom m))) (T.inner (dom m)) (Ob-map G (Ob-map K (cod m))) (T.inner (cod m))) ;
 form4 : Id (Id (Hom D x y) h3 h4) step4 (R.read h3 h4 cell4) =
  H.transH (H.apH (\ p -> H.symH p) (Cc.form (Ob-map G (Ob-map K (dom m))) (T.inner (dom m)) (Ob-map G (Ob-map K (cod m))) (T.inner (cod m))))
   (H.transH (End4.reverse (hdom h3) (hcod h3) ep eq) (Rev4.form (hdom h4) (hcod h4) (H.symH ep) (H.symH eq))) ;
 qc : Cell[C, Ob-map G (Ob-map K (dom m)), Ob-map G (Ob-map K (cod m)), q0, q1] =
  new Cell[C, Ob-map G (Ob-map K (dom m)), Ob-map G (Ob-map K (cod m)), q0, q1,
   composeA {I} {A} {B} {C} G K m, Q.E0.cell (dom m) (refl (dom m)), Q.E1.cell (cod m) (refl (cod m))] ;
 module Mc = MapCell[C, D, F, Ob-map G (Ob-map K (dom m)), Ob-map G (Ob-map K (cod m)), q0, q1, qc] ;
 step5 : Id (Hom D x y) h4 T.target = H.apH (Hom-map F (Ob-map G (Ob-map K (dom m))) (Ob-map G (Ob-map K (cod m))))
  (HomFunctor.Hom-map-of-comp G K (dom m) (cod m) T.h) ;
 form5 : Id (Id (Hom D x y) h4 T.target) step5 (R.read h4 T.target Mc.cell) =
  H.transH (H.apH (\ p -> H.apH (Hom-map F (Ob-map G (Ob-map K (dom m))) (Ob-map G (Ob-map K (cod m)))) p)
   (Q.form (dom m) (refl (dom m)) (cod m) (refl (cod m)))) Mc.form ;
} ;
