-- Products of groups and the difference of two homomorphisms into an
-- abelian group. The exchange law gives additivity of difference;
-- cancellation identifies its zero fibre with equality of the two maps.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ;
module PM = Pi0Maps[l] ;

module Product (G H : Grp) {
 grp : Grp = new Grp[G.G * H.G, isSet-Sigma G.G (\ x -> H.G) G.setG (\ x -> H.setG),
  (G.e, H.e), \ x y -> (G.mul x.1 y.1, H.mul x.2 y.2), \ x -> (G.inv x.1, H.inv x.2),
  \ x y z -> EquivAp[l].pair-path (G.assoc x.1 y.1 z.1) (H.assoc x.2 y.2 z.2),
  \ x -> EquivAp[l].pair-path (G.unitl x.1) (H.unitl x.2),
  \ x -> EquivAp[l].pair-path (G.unitr x.1) (H.unitr x.2),
  \ x -> EquivAp[l].pair-path (G.invl x.1) (H.invl x.2),
  \ x -> EquivAp[l].pair-path (G.invr x.1) (H.invr x.2)] ;
 abelian (a : Pi0[l].is-abelian G) (b : Pi0[l].is-abelian H) : Pi0[l].is-abelian grp =
  \ x y -> EquivAp[l].pair-path (a x.1 y.1) (b x.2 y.2) ;
 pair-hom (K : Grp) (f : K.G -> G.G) (g : K.G -> H.G)
  (hf : PM.is-hom K G f) (hg : PM.is-hom K H g) : PM.is-hom K grp (\ x -> (f x, g x)) =
  \ x y -> EquivAp[l].pair-path (hf x y) (hg x y) ;
} ;

module At (G : Grp) {
 same (x y : G.G) (h : Id G.G (PM.diff G x y) G.e) : Id G.G x y =
  transH (symH (GrpL[G].cancr y x)) (transH (apH (\ t -> G.mul t y) h) (G.unitl y)) ;
 zero (x y : G.G) (h : Id G.G x y) : Id G.G (PM.diff G x y) G.e =
  transH (apH (\ t -> PM.diff G t y) h) (G.invr y) ;
 module Abelian (comm : Pi0[l].is-abelian G) {
  exchange (a b c d : G.G) : Id G.G (G.mul (G.mul a b) (G.mul c d)) (G.mul (G.mul a c) (G.mul b d)) =
   transH (G.assoc a b (G.mul c d))
    (transH (apH (G.mul a) (symH (G.assoc b c d)))
     (transH (apH (\ t -> G.mul a (G.mul t d)) (comm b c))
      (transH (apH (G.mul a) (G.assoc c b d)) (symH (G.assoc a c (G.mul b d)))))) ;
  inverse (x y : G.G) : Id G.G (G.inv (G.mul x y)) (G.mul (G.inv x) (G.inv y)) =
   symH (transH (GrpL[G].solve-r (G.mul (G.inv x) (G.inv y)) (G.mul x y) G.e
     (transH (exchange (G.inv x) (G.inv y) x y)
      (transH (apH (\ t -> G.mul t (G.mul (G.inv y) y)) (G.invl x))
       (transH (apH (G.mul G.e) (G.invl y)) (G.unitl G.e)))))
    (G.unitl (G.inv (G.mul x y)))) ;
  difference (a b c d : G.G) :
   Id G.G (PM.diff G (G.mul a b) (G.mul c d)) (G.mul (PM.diff G a c) (PM.diff G b d)) =
   transH (apH (G.mul (G.mul a b)) (inverse c d)) (exchange a b (G.inv c) (G.inv d)) ;
  hom (B E : Grp) (f : B.G -> G.G) (g : E.G -> G.G)
   (hf : PM.is-hom B G f) (hg : PM.is-hom E G g) :
   PM.is-hom Product[B, E].grp G (\ t -> PM.diff G (f t.1) (g t.2)) =
   \ x y -> transH (apH (\ t -> PM.diff G t (g (E.mul x.2 y.2))) (hf x.1 y.1))
    (transH (apH (PM.diff G (G.mul (f x.1) (f y.1))) (hg x.2 y.2)) (difference (f x.1) (f y.1) (g x.2) (g y.2))) ;
 } ;
} ;
