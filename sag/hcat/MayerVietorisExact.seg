-- Exactness at H_(n+1)(P), for the EXISTING connecting map and groups.
-- Apply PullbackExact to the representable pullback. ConeZero identifies
-- its basepoint with the cone of the zero map. The loop equivalence L
-- identifies the two loop maps with postcomposition (L-nat); it is a
-- group isomorphism by the definition of LoopGroup. Transport the
-- kernel-image theorem along these equivalences. No homomorphism claim
-- about delta, and no coherence beyond the existing hpent, is needed.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PM = Pi0Maps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open HigherCat ; open Constructions ; open Composition ; open Zero ; open Loops ; open HGroups ; open Pi0[l] ;

module Exact (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee)
 (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv))
 (po : DPushout.DSquare[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pushout) (S : Ob D) {
 module M = MayerVietoris.MV[Cc, Bb, Ee, P, ii, jj, uu, vv, ss, po, S] ;
 module Z = ConeZero.Point[Cc, Bb, Ee, P, ii, jj, uu, vv, ss, S] ;
 module K = PullbackExact[l].Exact[Hom D S Bb, Hom D S Ee, Hom D S P,
  \ w -> hcomp {D} w uu, \ w -> hcomp {D} w vv,
  zmap S Bb, zmap S Ee, zmap S P, zero-post S uu, zero-post S vv] ;
 module GB = LoopGroup[S, Bb] ; module GE = LoopGroup[S, Ee] ; module GP = LoopGroup[S, P] ;
 module UMap = HGroupMaps.Post[S, Bb, P, uu] ; module VMap = HGroupMaps.Post[S, Ee, P, vv] ;
 module EP = PM.EquivalenceHom[K.L.grp, pi0 (Hom D (susp S) P), GP.e] ;
 cone-equiv : Pl.Equiv (pi0 (Hom D S Cc)) (pi0 (M.C.Cone S)) =
  pi0-equiv (Hom D S Cc) (M.C.Cone S) (M.C.cone-map S, M.pull) ;
 cone-zero : Id (pi0 (M.C.Cone S)) (cone-equiv.1 (M.zero-cls Cc)) K.zero =
  H.transH (pi0-map-cls (Hom D S Cc) (M.C.Cone S) (M.C.cone-map S) (zmap S Cc))
   (H.apH (\ w -> cls w) Z.cone-zero) ;
 connect-square (q : GP.grp.G) :
  Id (pi0 (M.C.Cone S)) (cone-equiv.1 (M.delta0 q)) (K.connect (GP.e.1 q)) =
  PM.square (Hom D (susp S) P) (Hom D S Cc) (LoopOf[S].Om P) (M.C.Cone S)
   M.delta K.K.boundary (LoopOf[S].L P) (M.C.cone-map S)
   (\ g -> M.pull.sec-eq (M.delta-cone g)) q ;
 delta-point-path : Id (Hom D S Cc) (M.delta (zmap (susp S) P)) (zmap S Cc) =
  Equivalences[l].injective (Hom D S Cc) (M.C.Cone S) (M.C.cone-map S) M.pull
   (M.delta (zmap (susp S) P)) (zmap S Cc)
   (H.transH (M.pull.sec-eq (M.delta-cone (zmap (susp S) P)))
    (H.transH (H.apH K.K.boundary (LoopOf[S].L-zero P))
     (H.transH K.K.boundary-zero (H.symH Z.cone-zero)))) ;
 delta-point : Id (pi0 (Hom D S Cc)) (M.delta0 (cls (zmap (susp S) P))) (M.zero-cls Cc) =
  Equivalences[l].injective (pi0 (Hom D S Cc)) (pi0 (M.C.Cone S)) cone-equiv.1 cone-equiv.2
   (M.delta0 (cls (zmap (susp S) P))) (M.zero-cls Cc)
   (H.transH (connect-square (cls (zmap (susp S) P)))
    (H.transH (H.apH K.connect
      (H.transH (pi0-map-cls (Hom D (susp S) P) (LoopOf[S].Om P) (LoopOf[S].L P) (zmap (susp S) P))
       (H.apH (\ r -> cls r) (LoopOf[S].L-zero P))))
     (H.transH K.connect-zero (H.symH cone-zero)))) ;
 difference (b : GB.grp.G) (e : GE.grp.G) : GP.grp.G =
  PM.diff GP.grp (UMap.map b) (VMap.map e) ;
 difference-square (b : GB.grp.G) (e : GE.grp.G) :
  Id K.L.grp.G (GP.e.1 (difference b e)) (K.difference (GB.e.1 b) (GE.e.1 e)) =
  H.transH (PM.hom-diff GP.grp K.L.grp GP.e.1 EP.forward (UMap.map b) (VMap.map e))
   (H.transH (H.apH (\ w -> PM.diff K.L.grp w (GP.e.1 (VMap.map e))) (UMap.square b))
    (H.apH (PM.diff K.L.grp (K.F.M.map (GB.e.1 b))) (VMap.square e))) ;
 difference-zero (b : GB.grp.G) (e : GE.grp.G) :
  Id (pi0 (Hom D S Cc)) (M.delta0 (difference b e)) (M.zero-cls Cc) =
  Equivalences[l].injective (pi0 (Hom D S Cc)) (pi0 (M.C.Cone S)) cone-equiv.1 cone-equiv.2
   (M.delta0 (difference b e)) (M.zero-cls Cc)
   (H.transH (connect-square (difference b e))
    (H.transH (H.apH K.connect (difference-square b e))
     (H.transH (K.diff-zero (GB.e.1 b) (GE.e.1 e)) (H.symH cone-zero)))) ;
 Im (q : GP.grp.G) : U l = Tr.Trunc[(b : GB.grp.G) * (e : GE.grp.G) * Id GP.grp.G (difference b e) q].carrier ;
 im-prop (q : GP.grp.G) : Pl.isProp (Im q) =
  Tr.Trunc[(b : GB.grp.G) * (e : GE.grp.G) * Id GP.grp.G (difference b e) q].proposition ;
 lift-image (q : GP.grp.G) (b : LoopGrp[Hom D S Bb, zmap S Bb].grp.G)
  (e : LoopGrp[Hom D S Ee, zmap S Ee].grp.G)
  (h : Id K.L.grp.G (K.difference b e) (GP.e.1 q)) : Im q =
  Tr.Trunc[(b1 : GB.grp.G) * (e1 : GE.grp.G) * Id GP.grp.G (difference b1 e1) q].inc
   (GB.e.2.sec b, GE.e.2.sec e,
    Equivalences[l].injective GP.grp.G K.L.grp.G GP.e.1 GP.e.2 (difference (GB.e.2.sec b) (GE.e.2.sec e)) q
     (H.transH (difference-square (GB.e.2.sec b) (GE.e.2.sec e))
      (H.transH (H.apH (\ w -> K.difference w (GE.e.1 (GE.e.2.sec e))) (GB.e.2.sec-eq b))
       (H.transH (H.apH (K.difference b) (GE.e.2.sec-eq e)) h)))) ;
 exact-p (q : GP.grp.G) (h : Id (pi0 (Hom D S Cc)) (M.delta0 q) (M.zero-cls Cc)) : Im q =
  TC.rec ((b : LoopGrp[Hom D S Bb, zmap S Bb].grp.G) * (e : LoopGrp[Hom D S Ee, zmap S Ee].grp.G) *
    Id K.L.grp.G (K.difference b e) (GP.e.1 q)) @l (Im q) (im-prop q)
   (\ w -> lift-image q w.1 w.2.1 w.2.2)
   (K.exact (GP.e.1 q) (H.transH (H.symH (connect-square q)) (H.transH (H.apH cone-equiv.1 h) cone-zero))) ;
} ;

-- Excision instance: exactness at H_(n+1)(X), using its chosen group.
module Types (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) (n : Nat) {
 module Ex = Excision.ExcisionOf[B, C, E, X, i, j, u, v, h, A] ;
 module Q = Exact[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, Sph n] ;
} ;
