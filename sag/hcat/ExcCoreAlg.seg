-- A groupoid identity used by excision (pure path algebra, any type Z).
-- Points and paths:
--   Ai : p2 = p1, Bi : p3 = p2, Ri : p1 = q1, Si : p3 = q2, Gi : q2 = q1,
--   Aj : p5 = p6, Bj : p4 = p5, Rj : p6 = q4, Sj : p4 = q3, Gj : q3 = q4,
--   Mg : q2 = q3, Tu : q2 = w1, Tv : q3 = w2, Hc : w1 = w2,
-- with hi : Bi (Ai Ri) = Si Gi, hj : Bj (Aj Rj) = Sj Gj, hm : Mg Tv = Tu Hc.
-- Let om = Ai^-1 ((Bi^-1 ((Si (Mg Sj^-1)) Bj)) Aj) : p1 = p6.  Then
--   (Ri^-1 (om Rj)) (Gj^-1 Tv) = (Gi^-1 Tu) Hc.
-- Informally: by hi, Ri^-1 Ai^-1 Bi^-1 Si = Gi^-1; by hj,
-- Sj^-1 Bj Aj Rj = Gj; so the left side is Gi^-1 Mg Gj Gj^-1 Tv
-- = Gi^-1 Mg Tv = Gi^-1 Tu Hc by hm.
-- Formally by path induction: first on Gi with hi (Si becomes Bi (Ai Ri)),
-- on Gj with hj, on Hc with hm (Tu becomes Mg Tv); the remaining identity
-- in the free paths Ai, Bi, Ri, Aj, Bj, Rj, Mg, Tv is proved by induction
-- on each of them in turn, ending with all paths refl, where both sides
-- compute to refl.
open Base ;
module H = Paths[l] ;

core-om (Z : U l) {p1 p2 p3 p4 p5 p6 q2 q3 : Z} (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Si : Id Z p3 q2) (Mg : Id Z q2 q3)
 (Sj : Id Z p4 q3) (Bj : Id Z p4 p5) (Aj : Id Z p5 p6) : Id Z p1 p6 =
 H.transH (H.symH Ai) (H.transH (H.transH (H.symH Bi) (H.transH (H.transH Si (H.transH Mg (H.symH Sj))) Bj)) Aj) ;

CoreGoal (Z : U l) (p1 p2 p3 p4 p5 p6 q1 q2 q3 q4 w1 w2 : Z)
 (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q1) (Si : Id Z p3 q2) (Gi : Id Z q2 q1)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q4) (Sj : Id Z p4 q3) (Gj : Id Z q3 q4)
 (Mg : Id Z q2 q3) (Tu : Id Z q2 w1) (Tv : Id Z q3 w2) (Hc : Id Z w1 w2) : U l =
 Id (Id Z q1 w2) (H.transH (H.transH (H.symH Ri) (H.transH (core-om Z Ai Bi Si Mg Sj Bj Aj) Rj)) (H.transH (H.symH Gj) Tv))
  (H.transH (H.transH (H.symH Gi) Tu) Hc) ;

-- the identity in the free paths
PGoal (Z : U l) (p1 p2 p3 p4 p5 p6 q2 q3 w1 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q3) (Mg : Id Z q2 q3) (Tv : Id Z q3 w1) : U l =
 CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q3 w1 w1 Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
  Aj Bj Rj (H.transH Bj (H.transH Aj Rj)) (refl q3) Mg (H.transH Mg Tv) Tv (refl w1) ;

ca14 (Z : U l) (p2 p3 : Z) (Bi : Id Z p3 p2) :
 PGoal Z p2 p2 p3 p2 p2 p2 p2 p2 p2 (refl p2) Bi (refl p2) (refl p2) (refl p2) (refl p2) (refl p2) (refl p2) =
 idJ Z p3 (\ x q -> PGoal Z x x p3 x x x x x x (refl x) q (refl x) (refl x) (refl x) (refl x) (refl x) (refl x))
  (refl (refl p3)) p2 Bi ;

ca13 (Z : U l) (p1 p2 p3 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) :
 PGoal Z p1 p2 p3 p1 p1 p1 p1 p1 p1 Ai Bi (refl p1) (refl p1) (refl p1) (refl p1) (refl p1) (refl p1) =
 idJ Z p2 (\ x q -> PGoal Z x p2 p3 x x x x x x q Bi (refl x) (refl x) (refl x) (refl x) (refl x) (refl x))
  (ca14 Z p2 p3 Bi) p1 Ai ;

ca12 (Z : U l) (p1 p2 p3 p4 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 p4) :
 PGoal Z p1 p2 p3 p4 p4 p4 p4 p4 p4 Ai Bi Ri (refl p4) (refl p4) (refl p4) (refl p4) (refl p4) =
 idJ Z p1 (\ x q -> PGoal Z p1 p2 p3 x x x x x x Ai Bi q (refl x) (refl x) (refl x) (refl x) (refl x))
  (ca13 Z p1 p2 p3 Ai Bi) p4 Ri ;

ca11 (Z : U l) (p1 p2 p3 p4 q2 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2) (Rj : Id Z p4 q2) :
 PGoal Z p1 p2 p3 p4 p4 p4 q2 q2 q2 Ai Bi Ri (refl p4) (refl p4) Rj (refl q2) (refl q2) =
 idJ Z p4 (\ x q -> (Ri1 : Id Z p1 x) -> PGoal Z p1 p2 p3 p4 p4 p4 x x x Ai Bi Ri1 (refl p4) (refl p4) q (refl x) (refl x))
  (\ Ri1 -> ca12 Z p1 p2 p3 p4 Ai Bi Ri1) q2 Rj Ri ;

ca10 (Z : U l) (p1 p2 p3 p4 p5 q2 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2) (Bj : Id Z p4 p5) (Rj : Id Z p5 q2) :
 PGoal Z p1 p2 p3 p4 p5 p5 q2 q2 q2 Ai Bi Ri (refl p5) Bj Rj (refl q2) (refl q2) =
 idJ Z p4 (\ x q -> (Rj1 : Id Z x q2) -> PGoal Z p1 p2 p3 p4 x x q2 q2 q2 Ai Bi Ri (refl x) q Rj1 (refl q2) (refl q2))
  (\ Rj1 -> ca11 Z p1 p2 p3 p4 q2 Ai Bi Ri Rj1) p5 Bj Rj ;

ca9 (Z : U l) (p1 p2 p3 p4 p5 p6 q2 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q2) :
 PGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q2 Ai Bi Ri Aj Bj Rj (refl q2) (refl q2) =
 idJ Z p5 (\ x q -> (Rj1 : Id Z x q2) -> PGoal Z p1 p2 p3 p4 p5 x q2 q2 q2 Ai Bi Ri q Bj Rj1 (refl q2) (refl q2))
  (\ Rj1 -> ca10 Z p1 p2 p3 p4 p5 q2 Ai Bi Ri Bj Rj1) p6 Aj Rj ;

ca8 (Z : U l) (p1 p2 p3 p4 p5 p6 q2 q3 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q3) (Mg : Id Z q2 q3) :
 PGoal Z p1 p2 p3 p4 p5 p6 q2 q3 q3 Ai Bi Ri Aj Bj Rj Mg (refl q3) =
 idJ Z q2 (\ x q -> (Rj1 : Id Z p6 x) -> PGoal Z p1 p2 p3 p4 p5 p6 q2 x x Ai Bi Ri Aj Bj Rj1 q (refl x))
  (\ Rj1 -> ca9 Z p1 p2 p3 p4 p5 p6 q2 Ai Bi Ri Aj Bj Rj1) q3 Mg Rj ;

ca7 (Z : U l) (p1 p2 p3 p4 p5 p6 q2 q3 w1 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q3) (Mg : Id Z q2 q3) (Tv : Id Z q3 w1) :
 PGoal Z p1 p2 p3 p4 p5 p6 q2 q3 w1 Ai Bi Ri Aj Bj Rj Mg Tv =
 idJ Z q3 (\ x q -> PGoal Z p1 p2 p3 p4 p5 p6 q2 q3 x Ai Bi Ri Aj Bj Rj Mg q)
  (ca8 Z p1 p2 p3 p4 p5 p6 q2 q3 Ai Bi Ri Aj Bj Rj Mg) w1 Tv ;

-- the hypotheses
ca6 (Z : U l) (p1 p2 p3 p4 p5 p6 q2 q3 w1 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q3) (Mg : Id Z q2 q3) (Tu : Id Z q2 w1) (Tv : Id Z q3 w1)
 (hm : Id (Id Z q2 w1) (H.transH Mg Tv) Tu) :
 CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q3 w1 w1 Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
  Aj Bj Rj (H.transH Bj (H.transH Aj Rj)) (refl q3) Mg Tu Tv (refl w1) =
 idJ (Id Z q2 w1) (H.transH Mg Tv) (\ t e -> CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q3 w1 w1 Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
   Aj Bj Rj (H.transH Bj (H.transH Aj Rj)) (refl q3) Mg t Tv (refl w1))
  (ca7 Z p1 p2 p3 p4 p5 p6 q2 q3 w1 Ai Bi Ri Aj Bj Rj Mg Tv) Tu hm ;

ca5 (Z : U l) (p1 p2 p3 p4 p5 p6 q2 q3 w1 w2 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q3) (Mg : Id Z q2 q3) (Tu : Id Z q2 w1) (Tv : Id Z q3 w2) (Hc : Id Z w1 w2)
 (hm : Id (Id Z q2 w2) (H.transH Mg Tv) (H.transH Tu Hc)) :
 CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q3 w1 w2 Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
  Aj Bj Rj (H.transH Bj (H.transH Aj Rj)) (refl q3) Mg Tu Tv Hc =
 idJ Z w1 (\ x c -> (Tv1 : Id Z q3 x) (hm1 : Id (Id Z q2 x) (H.transH Mg Tv1) (H.transH Tu c)) ->
   CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q3 w1 x Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
    Aj Bj Rj (H.transH Bj (H.transH Aj Rj)) (refl q3) Mg Tu Tv1 c)
  (\ Tv1 hm1 -> ca6 Z p1 p2 p3 p4 p5 p6 q2 q3 w1 Ai Bi Ri Aj Bj Rj Mg Tu Tv1 hm1) w2 Hc Tv hm ;

ca4 (Z : U l) (p1 p2 p3 p4 p5 p6 q2 q3 w1 w2 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q3) (Sj : Id Z p4 q3) (hj : Id (Id Z p4 q3) (H.transH Bj (H.transH Aj Rj)) Sj)
 (Mg : Id Z q2 q3) (Tu : Id Z q2 w1) (Tv : Id Z q3 w2) (Hc : Id Z w1 w2)
 (hm : Id (Id Z q2 w2) (H.transH Mg Tv) (H.transH Tu Hc)) :
 CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q3 w1 w2 Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
  Aj Bj Rj Sj (refl q3) Mg Tu Tv Hc =
 idJ (Id Z p4 q3) (H.transH Bj (H.transH Aj Rj)) (\ t e -> CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q3 w1 w2 Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
   Aj Bj Rj t (refl q3) Mg Tu Tv Hc)
  (ca5 Z p1 p2 p3 p4 p5 p6 q2 q3 w1 w2 Ai Bi Ri Aj Bj Rj Mg Tu Tv Hc hm) Sj hj ;

ca3 (Z : U l) (p1 p2 p3 p4 p5 p6 q2 q3 q4 w1 w2 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q4) (Sj : Id Z p4 q3) (Gj : Id Z q3 q4)
 (hj : Id (Id Z p4 q4) (H.transH Bj (H.transH Aj Rj)) (H.transH Sj Gj))
 (Mg : Id Z q2 q3) (Tu : Id Z q2 w1) (Tv : Id Z q3 w2) (Hc : Id Z w1 w2)
 (hm : Id (Id Z q2 w2) (H.transH Mg Tv) (H.transH Tu Hc)) :
 CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q4 w1 w2 Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
  Aj Bj Rj Sj Gj Mg Tu Tv Hc =
 idJ Z q3 (\ x g -> (Rj1 : Id Z p6 x) (hj1 : Id (Id Z p4 x) (H.transH Bj (H.transH Aj Rj1)) (H.transH Sj g)) ->
   CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 x w1 w2 Ai Bi Ri (H.transH Bi (H.transH Ai Ri)) (refl q2)
    Aj Bj Rj1 Sj g Mg Tu Tv Hc)
  (\ Rj1 hj1 -> ca4 Z p1 p2 p3 p4 p5 p6 q2 q3 w1 w2 Ai Bi Ri Aj Bj Rj1 Sj hj1 Mg Tu Tv Hc hm) q4 Gj Rj hj ;

ca2 (Z : U l) (p1 p2 p3 p4 p5 p6 q2 q3 q4 w1 w2 : Z) (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q2)
 (Si : Id Z p3 q2) (hi : Id (Id Z p3 q2) (H.transH Bi (H.transH Ai Ri)) Si)
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q4) (Sj : Id Z p4 q3) (Gj : Id Z q3 q4)
 (hj : Id (Id Z p4 q4) (H.transH Bj (H.transH Aj Rj)) (H.transH Sj Gj))
 (Mg : Id Z q2 q3) (Tu : Id Z q2 w1) (Tv : Id Z q3 w2) (Hc : Id Z w1 w2)
 (hm : Id (Id Z q2 w2) (H.transH Mg Tv) (H.transH Tu Hc)) :
 CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q4 w1 w2 Ai Bi Ri Si (refl q2) Aj Bj Rj Sj Gj Mg Tu Tv Hc =
 idJ (Id Z p3 q2) (H.transH Bi (H.transH Ai Ri)) (\ t e -> CoreGoal Z p1 p2 p3 p4 p5 p6 q2 q2 q3 q4 w1 w2 Ai Bi Ri t (refl q2)
   Aj Bj Rj Sj Gj Mg Tu Tv Hc)
  (ca3 Z p1 p2 p3 p4 p5 p6 q2 q3 q4 w1 w2 Ai Bi Ri Aj Bj Rj Sj Gj hj Mg Tu Tv Hc hm) Si hi ;

core-alg {Z : U l} {p1 p2 p3 p4 p5 p6 q1 q2 q3 q4 w1 w2 : Z}
 (Ai : Id Z p2 p1) (Bi : Id Z p3 p2) (Ri : Id Z p1 q1) (Si : Id Z p3 q2) (Gi : Id Z q2 q1)
 (hi : Id (Id Z p3 q1) (H.transH Bi (H.transH Ai Ri)) (H.transH Si Gi))
 (Aj : Id Z p5 p6) (Bj : Id Z p4 p5) (Rj : Id Z p6 q4) (Sj : Id Z p4 q3) (Gj : Id Z q3 q4)
 (hj : Id (Id Z p4 q4) (H.transH Bj (H.transH Aj Rj)) (H.transH Sj Gj))
 (Mg : Id Z q2 q3) (Tu : Id Z q2 w1) (Tv : Id Z q3 w2) (Hc : Id Z w1 w2)
 (hm : Id (Id Z q2 w2) (H.transH Mg Tv) (H.transH Tu Hc)) :
 CoreGoal Z p1 p2 p3 p4 p5 p6 q1 q2 q3 q4 w1 w2 Ai Bi Ri Si Gi Aj Bj Rj Sj Gj Mg Tu Tv Hc =
 idJ Z q2 (\ x g -> (Ri1 : Id Z p1 x) (hi1 : Id (Id Z p3 x) (H.transH Bi (H.transH Ai Ri1)) (H.transH Si g)) ->
   CoreGoal Z p1 p2 p3 p4 p5 p6 x q2 q3 q4 w1 w2 Ai Bi Ri1 Si g Aj Bj Rj Sj Gj Mg Tu Tv Hc)
  (\ Ri1 hi1 -> ca2 Z p1 p2 p3 p4 p5 p6 q2 q3 q4 w1 w2 Ai Bi Ri1 Si hi1 Aj Bj Rj Sj Gj hj Mg Tu Tv Hc hm) q1 Gi Ri hi ;
