-- Delta (n+2) is a retract of Delta (n+1) x I (Agda Simplices/SimplexRetract).
--   sect n = <pre-face-n n, eval-at-top n> : Delta (n+2) -> Delta (n+1) x I:
--   restrict a functor phi : Delta (n+1) -> I along face n, and evaluate
--   it at top (n+1).
--   ret n : Delta (n+1) x I -> Delta (n+2): (s, t) goes to the functor
--   y |-> thr-pred (s, t, y), i.e. the monotone predicate ret-p on
--   (Delta (n+1) x I) x Delta (n+1) (monotone in all three variables),
--   transposed.
--   ret-sect: ret o sect = 1.  Both sides are transposes; uncurried, at an
--   object (phi, y) the left side is thr-pred (phi o face, phi (top), y),
--   which is the value of phi at y: below the top it is phi o face read at
--   deface y (face-part), at the top it is phi (top) (top-part), and a
--   monotone map on Ord (n+1) is rebuilt from these (recon).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open ExpComparison ; open Exponentials ; open ExpEval ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open Construction20 ; open IntervalPosetal ;
open LastEdge ; open FaceOrd ; open OrdComb ; open FaceMap ; open FaceOrdCompat ; open FaceTop ;

pre-comp {A A1 : Cat} (f : Map A A1) (B : Cat) : Map (Fun A1 B) (Fun A B) =
 (exp-is-equiv A B (Fun A1 B)).sec (comp (ev A1 B) (pair (pi1 (Fun A1 B) A) (comp f (pi2 (Fun A1 B) A)))) ;

pre-face-n (n : Nat) : Map (Delta (suc (suc n))) (Delta (suc n)) = pre-comp (face n) I ;

exp-comp-nat {A B X Y : Cat} (u : Map X (Fun A B)) (v : Map Y X) :
 Id (Map (times Y A) B) (exp-comparison A B Y (comp u v)) (comp (exp-comparison A B X u) (pair (comp v (pi1 Y A)) (pi2 Y A))) =
 H.transH (H.symH (ccr (ev A B)
   (H.transH (pair-nat (comp u (pi1 X A)) (pi2 X A) (pair (comp v (pi1 Y A)) (pi2 Y A)))
    (pair-ap (H.transH (composeA u (pi1 X A) (pair (comp v (pi1 Y A)) (pi2 Y A)))
               (H.transH (ccr u (pair-beta1 (comp v (pi1 Y A)) (pi2 Y A))) (comp-assoc u v (pi1 Y A))))
             (pair-beta2 (comp v (pi1 Y A)) (pi2 Y A))))))
  (comp-assoc (ev A B) (pair (comp u (pi1 X A)) (pi2 X A)) (pair (comp v (pi1 Y A)) (pi2 Y A))) ;

eval-at-top (n : Nat) : Map (Delta (suc (suc n))) I =
 comp (ev (Delta (suc n)) I) (pair (idMap (Delta (suc (suc n)))) (comp {Delta (suc (suc n))} {One} {Delta (suc n)} (top (suc n)) (bang (Delta (suc (suc n)))))) ;

sect (n : Nat) : Map (Delta (suc (suc n))) (times (Delta (suc n)) I) = pair (pre-face-n n) (eval-at-top n) ;

------------------------------------------------------------------------
-- the retraction

-- the projections of (Delta (n+1) x I) x Delta (n+1)
p-outer (n : Nat) : Map (times (times (Delta (suc n)) I) (Delta (suc n))) (times (Delta (suc n)) I) = pi1 (times (Delta (suc n)) I) (Delta (suc n)) ;
p-y (n : Nat) : Map (times (times (Delta (suc n)) I) (Delta (suc n))) (Delta (suc n)) = pi2 (times (Delta (suc n)) I) (Delta (suc n)) ;
p-s (n : Nat) : Map (times (times (Delta (suc n)) I) (Delta (suc n))) (Delta (suc n)) = comp (pi1 (Delta (suc n)) I) (p-outer n) ;
p-t (n : Nat) : Map (times (times (Delta (suc n)) I) (Delta (suc n))) I = comp (pi2 (Delta (suc n)) I) (p-outer n) ;

ret-p (n : Nat) (w : Ob (times (times (Delta (suc n)) I) (Delta (suc n)))) : Two =
 thr-pred n ((construction-20 (suc n)).1 (Ob-map (p-s n) w)) (I-ob.1 (Ob-map (p-t n) w)) ((construction-20 (suc n)).1 (Ob-map (p-y n) w)) ;

thr-pred-cong (n : Nat) {a a1 : Ord (suc n)} {b b1 : Two} {y y1 : Ord (suc n)}
 (pa : Id (Ord (suc n)) a a1) (pb : Id Two b b1) (py : Id (Ord (suc n)) y y1) : Id Two (thr-pred n a b y) (thr-pred n a1 b1 y1) =
 H.transH (H.apH (\ a2 -> thr-pred n a2 b y) pa) (H.transH (H.apH (\ b2 -> thr-pred n a1 b2 y) pb) (H.apH (\ y2 -> thr-pred n a1 b1 y2) py)) ;

sval-mono2 (n : Nat) (s1 s2 y1 y2 : Ord (suc n)) (les : leqOrd (suc n) s1 s2) (ley : leqOrd (suc n) y1 y2) :
 leq2 (sval n s1 y1) (sval n s2 y2) =
 leq2-trans (sval n s1 y1) (sval n s2 y1) (sval n s2 y2)
  (monotone-ord-bwd-pw n s1 s2 les (deface n y1))
  ((monotone-ord-bwd n s2).2 (deface n y1) (deface n y2) (deface-mono n y1 y2 ley)) ;

module RetMono (n : Nat) (m : Mor (times (times (Delta (suc n)) I) (Delta (suc n)))) {
 ms : Mor (Delta (suc n)) = funct-on-mor (p-s n) m ;
 mt : Mor I = funct-on-mor (p-t n) m ;
 my : Mor (Delta (suc n)) = funct-on-mor (p-y n) m ;
 s1 : Ord (suc n) = (construction-20 (suc n)).1 (dom ms) ;
 s2 : Ord (suc n) = (construction-20 (suc n)).1 (cod ms) ;
 y1 : Ord (suc n) = (construction-20 (suc n)).1 (dom my) ;
 y2 : Ord (suc n) = (construction-20 (suc n)).1 (cod my) ;
 sv : leq2 (sval n s1 y1) (sval n s2 y2) = sval-mono2 n s1 s2 y1 y2 (mor-to-ord-le (suc n) ms) (mor-to-ord-le (suc n) my) ;
 order : leq2 (thr-pred n s1 (I-ob.1 (dom mt)) y1) (thr-pred n s2 (I-ob.1 (cod mt)) y2) =
  interp-mono (top-ind n y1) (top-ind n y2) (sval n s1 y1) (sval n s2 y2)
   (interp (I-ob.1 (dom mt)) (sval n s1 y1) one2) (interp (I-ob.1 (cod mt)) (sval n s2 y2) one2)
   (top-ind-mono n y1 y2 (mor-to-ord-le (suc n) my)) sv
   (interp-mono (I-ob.1 (dom mt)) (I-ob.1 (cod mt)) (sval n s1 y1) (sval n s2 y2) one2 one2
     (I-mor-order mt) sv (leq2-refl one2) (any-leq2-top (sval n s2 y2)))
   (sval-le-max (sval n s2 y2) (I-ob.1 (cod mt))) ;
 result : leq2 (ret-p n (dom m)) (ret-p n (cod m)) =
  leq2-transport
   (thr-pred-cong n (H.apH (construction-20 (suc n)).1 (dom-nat (p-s n) m)) (H.apH I-ob.1 (dom-nat (p-t n) m))
     (H.apH (construction-20 (suc n)).1 (dom-nat (p-y n) m)))
   (thr-pred-cong n (H.apH (construction-20 (suc n)).1 (cod-nat (p-s n) m)) (H.apH I-ob.1 (cod-nat (p-t n) m))
     (H.apH (construction-20 (suc n)).1 (cod-nat (p-y n) m)))
   order ;
} ;

ret-p-mono (n : Nat) : is-monotone (times (times (Delta (suc n)) I) (Delta (suc n))) (ret-p n) = \ m -> RetMono[n, m].result ;

ret-adj (n : Nat) : Map (times (times (Delta (suc n)) I) (Delta (suc n))) I =
 I-char-inverse (times (times (Delta (suc n)) I) (Delta (suc n))) (ret-p n, ret-p-mono n) ;

ret (n : Nat) : Map (times (Delta (suc n)) I) (Delta (suc (suc n))) =
 (exp-is-equiv (Delta (suc n)) I (times (Delta (suc n)) I)).sec (ret-adj n) ;

------------------------------------------------------------------------
-- evaluation lemmas

recon-top : (a b : Two) -> leq2 a b -> Id Two (interp b a one2) b = split {
 inl u -> split {
  inl v -> \ le -> H.apH {Top} {Two} (\ t -> inl t) (isTop u v) ;
  inr v -> \ le -> H.apH {Top} {Two} (\ t -> inr t) (isTop tt v) } ;
 inr u -> split {
  inl v -> \ le -> Pl.absurd _ le ;
  inr v -> \ le -> H.apH {Top} {Two} (\ t -> inr t) (isTop tt v) } } ;

recon (n : Nat) (g : Ord (suc n) -> Two) (mono : is-monotone-Ord (suc n) g) : (k : Ord (suc n)) ->
 Id Two (interp (top-ind n k) (g (inl (deface n k))) (interp (g (inr tt)) (g (inl (deface n k))) one2)) (g k) = split {
 inl x -> H.apH (\ v -> g (inl v)) (deface-inl n x) ;
 inr u -> H.transH (recon-top (g (inl (deface n (inr u)))) (g (inr tt)) (mono (inl (deface n (inr u))) (inr tt) tt))
   (H.apH (\ t -> g (inr t)) (isTop tt u)) } ;

sigma-eval-expand (n : Nat) (s : Ob (Delta (suc n))) (o : Ord n) :
 Id Two ((monotone-ord-bwd n ((construction-20 (suc n)).1 s)).1 o) (ob-to-2 (ob-to-map (Delta n) I s) ((construction-20 n).2.sec o)) =
 H.apH (\ w -> w.1 o) (monotone-ord-linv n ((monotone-transfer n).1 (I-char-comparison (Delta n) (ob-to-map (Delta n) I s)))) ;

eval-at-top-eval (n : Nat) (phi : Ob (Delta (suc (suc n)))) :
 Id (Ob I) (Ob-map (eval-at-top n) phi) (comp (ev (Delta (suc n)) I) (pair {Delta (suc (suc n))} {Delta (suc n)} {One} phi (top (suc n)))) =
 H.transH (composeA {One} {Delta (suc (suc n))} {times (Delta (suc (suc n))) (Delta (suc n))} {I} (ev (Delta (suc n)) I)
   (pair (idMap (Delta (suc (suc n)))) (comp {Delta (suc (suc n))} {One} {Delta (suc n)} (top (suc n)) (bang (Delta (suc (suc n)))))) phi)
  (ccr (ev (Delta (suc n)) I)
   (H.transH (pair-nat {Delta (suc (suc n))} {Delta (suc n)} {Delta (suc (suc n))} {One} (idMap (Delta (suc (suc n))))
      (comp {Delta (suc (suc n))} {One} {Delta (suc n)} (top (suc n)) (bang (Delta (suc (suc n))))) phi)
    (pair-ap (comp-id-l {One} {Delta (suc (suc n))} phi) (const-ob-gen (Delta (suc (suc n))) (top (suc n)) phi))))
 where {
  const-ob-gen (X : Cat) {Y : Cat} (v : Ob Y) (z : Ob X) : Id (Ob Y) (Ob-map (comp {X} {One} {Y} v (bang X)) z) v =
   H.transH (composeA {One} {X} {One} {Y} v (bang X) z)
    (H.transH (ccr {One} {One} {Y} v (one-path (comp {One} {X} {One} (bang X) z) (idMap One))) (comp-id-r {One} {Y} v)) ;
 } ;

h0-n (n : Nat) : Map (times (Delta (suc (suc n))) (Delta n)) I =
 comp (ev (Delta (suc n)) I) (pair (pi1 (Delta (suc (suc n))) (Delta n)) (comp (face n) (pi2 (Delta (suc (suc n))) (Delta n)))) ;

h0-n-simpl (n : Nat) (phi : Ob (Delta (suc (suc n)))) :
 Id (Map (Delta n) I) (comp (h0-n n) (slice {Delta (suc (suc n))} {Delta n} phi))
  (comp (ev (Delta (suc n)) I) (pair (comp {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n))) (face n))) =
 H.transH (composeA (ev (Delta (suc n)) I) (pair (pi1 (Delta (suc (suc n))) (Delta n)) (comp (face n) (pi2 (Delta (suc (suc n))) (Delta n))))
   (slice {Delta (suc (suc n))} {Delta n} phi))
  (ccr (ev (Delta (suc n)) I)
   (H.transH (pair-nat (pi1 (Delta (suc (suc n))) (Delta n)) (comp (face n) (pi2 (Delta (suc (suc n))) (Delta n))) (slice {Delta (suc (suc n))} {Delta n} phi))
    (pair-ap (pair-beta1 (comp {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n))) (idMap (Delta n)))
     (H.transH (composeA (face n) (pi2 (Delta (suc (suc n))) (Delta n)) (slice {Delta (suc (suc n))} {Delta n} phi))
      (H.transH (ccr (face n) (pair-beta2 (comp {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n))) (idMap (Delta n))))
       (comp-id-r (face n))))))) ;

pre-face-pair (n : Nat) (phi : Ob (Delta (suc (suc n)))) (z : Ob (Delta n)) :
 Id (Map One (times (Delta (suc (suc n))) (Delta (suc n))))
  (comp {One} {Delta n} {times (Delta (suc (suc n))) (Delta (suc n))} (pair (comp {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n))) (face n)) z)
  (pair {Delta (suc (suc n))} {Delta (suc n)} {One} phi (Ob-map (face n) z)) =
 H.transH (pair-nat {Delta (suc (suc n))} {Delta (suc n)} {Delta n} {One} (comp {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n))) (face n) z)
  (pair-ap (H.transH (composeA {One} {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n)) z)
             (H.transH (ccr {One} {One} {Delta (suc (suc n))} phi (one-path (comp {One} {Delta n} {One} (bang (Delta n)) z) (idMap One)))
              (comp-id-r {One} {Delta (suc (suc n))} phi)))
           (refl (Ob-map (face n) z))) ;

pre-face-point (n : Nat) (phi : Ob (Delta (suc (suc n)))) (z : Ob (Delta n)) :
 Id (Ob I) (Ob-map (ob-to-map (Delta n) I (Ob-map (pre-face-n n) phi)) z) (Ob-map (ob-to-map (Delta (suc n)) I phi) (Ob-map (face n) z)) =
 calc (Ob I) {
  Ob-map (ob-to-map (Delta n) I (Ob-map (pre-face-n n) phi)) z
  =< H.apH (\ f -> Ob-map {Delta n} {I} f z) (H.transH (exp-eval (Delta n) I (Delta (suc (suc n))) (h0-n n) phi) (h0-n-simpl n phi)) >
  comp {One} {Delta n} {I} (comp (ev (Delta (suc n)) I) (pair (comp {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n))) (face n))) z
  =< composeA {One} {Delta n} {times (Delta (suc (suc n))) (Delta (suc n))} {I} (ev (Delta (suc n)) I) (pair (comp {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n))) (face n)) z >
  comp {One} {times (Delta (suc (suc n))) (Delta (suc n))} {I} (ev (Delta (suc n)) I) (comp {One} {Delta n} {times (Delta (suc (suc n))) (Delta (suc n))} (pair (comp {Delta n} {One} {Delta (suc (suc n))} phi (bang (Delta n))) (face n)) z)
  =< ccr {One} {times (Delta (suc (suc n))) (Delta (suc n))} {I} (ev (Delta (suc n)) I) (pre-face-pair n phi z) >
  comp {One} {times (Delta (suc (suc n))) (Delta (suc n))} {I} (ev (Delta (suc n)) I) (pair {Delta (suc (suc n))} {Delta (suc n)} {One} phi (Ob-map (face n) z))
  =< H.symH (ev-point (Delta (suc n)) I phi (Ob-map (face n) z)) >
  Ob-map (ob-to-map (Delta (suc n)) I phi) (Ob-map (face n) z) } ;

face-ord-compat (n : Nat) (k : Ord n) :
 Id (Ob (Delta (suc n))) (Ob-map (face n) ((construction-20 n).2.sec k)) ((construction-20 (suc n)).2.sec (inl k)) =
 H.transH (H.symH (Pl.sec-ret (Ob (Delta (suc n))) (Ord (suc n)) (construction-20 (suc n)).1 (construction-20 (suc n)).2
   (Ob-map (face n) ((construction-20 n).2.sec k))))
  (H.apH (construction-20 (suc n)).2.sec
   (H.transH (c20-face-gen-u n ((construction-20 n).2.sec k)) (H.apH {Ord n} {Ord (suc n)} (\ v -> inl v) ((construction-20 n).2.sec-eq k)))) ;

c20-top-inv (n : Nat) : Id (Ob (Delta (suc n))) ((construction-20 (suc n)).2.sec (inr tt)) (top (suc n)) =
 H.transH (H.apH (construction-20 (suc n)).2.sec (H.symH (c20-top (suc n))))
  (Pl.sec-ret (Ob (Delta (suc n))) (Ord (suc n)) (construction-20 (suc n)).1 (construction-20 (suc n)).2 (top (suc n))) ;

-- the restriction along face, read in Ord, is the lower part of phi
face-part (n : Nat) (phi : Ob (Delta (suc (suc n)))) (o : Ord n) :
 Id Two ((monotone-ord-bwd n ((construction-20 (suc n)).1 (Ob-map (pre-face-n n) phi))).1 o)
  ((monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi)).1 (inl o)) =
 H.transH (sigma-eval-expand n (Ob-map (pre-face-n n) phi) o)
 (H.transH (H.apH I-ob.1 (pre-face-point n phi ((construction-20 n).2.sec o)))
 (H.transH (H.apH (ob-to-2 (ob-to-map (Delta (suc n)) I phi)) (face-ord-compat n o))
  (H.symH (sigma-eval-expand (suc n) phi (inl o))))) ;

-- the evaluation at the top, read in Two, is the top value of phi
top-part (n : Nat) (phi : Ob (Delta (suc (suc n)))) :
 Id Two (I-ob.1 (Ob-map (eval-at-top n) phi)) ((monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi)).1 (inr tt)) =
 H.transH (H.apH I-ob.1 (eval-at-top-eval n phi))
 (H.transH (H.apH I-ob.1 (H.symH (ev-point (Delta (suc n)) I phi (top (suc n)))))
 (H.transH (H.apH (ob-to-2 (ob-to-map (Delta (suc n)) I phi)) (H.symH (c20-top-inv n)))
  (H.symH (sigma-eval-expand (suc n) phi (inr tt))))) ;

rhs-simp (n : Nat) (phi : Ob (Delta (suc (suc n)))) (y : Ob (Delta (suc n))) :
 Id Two ((monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi)).1 ((construction-20 (suc n)).1 y))
  (ob-to-2 (ob-to-map (Delta (suc n)) I phi) y) =
 H.transH (sigma-eval-expand (suc n) phi ((construction-20 (suc n)).1 y))
  (H.apH (ob-to-2 (ob-to-map (Delta (suc n)) I phi)) (Pl.sec-ret (Ob (Delta (suc n))) (Ord (suc n)) (construction-20 (suc n)).1 (construction-20 (suc n)).2 y)) ;

------------------------------------------------------------------------
-- ret o sect = 1

gg (n : Nat) : Map (times (Delta (suc (suc n))) (Delta (suc n))) (times (times (Delta (suc n)) I) (Delta (suc n))) =
 pair (comp (sect n) (pi1 (Delta (suc (suc n))) (Delta (suc n)))) (pi2 (Delta (suc (suc n))) (Delta (suc n))) ;

module RetSect (n : Nat) (w : Ob (times (Delta (suc (suc n))) (Delta (suc n)))) {
 phi : Ob (Delta (suc (suc n))) = Ob-map (pi1 (Delta (suc (suc n))) (Delta (suc n))) w ;
 y : Ob (Delta (suc n)) = Ob-map (pi2 (Delta (suc (suc n))) (Delta (suc n))) w ;
 g : Ord (suc n) -> Two = (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi)).1 ;

 gg-outer : Id (Ob (times (Delta (suc n)) I)) (Ob-map (p-outer n) (Ob-map (gg n) w)) (Ob-map (sect n) phi) =
  H.transH (comp-assoc {One} {times (Delta (suc (suc n))) (Delta (suc n))} {times (times (Delta (suc n)) I) (Delta (suc n))} {times (Delta (suc n)) I} (p-outer n) (gg n) w)
  (H.transH (ccl {One} {times (Delta (suc (suc n))) (Delta (suc n))} {times (Delta (suc n)) I} w
     (pair-beta1 (comp (sect n) (pi1 (Delta (suc (suc n))) (Delta (suc n)))) (pi2 (Delta (suc (suc n))) (Delta (suc n)))))
   (composeA {One} {times (Delta (suc (suc n))) (Delta (suc n))} {Delta (suc (suc n))} {times (Delta (suc n)) I} (sect n) (pi1 (Delta (suc (suc n))) (Delta (suc n))) w)) ;

 gg-p-y : Id (Ob (Delta (suc n))) (Ob-map (p-y n) (Ob-map (gg n) w)) y =
  H.transH (comp-assoc {One} {times (Delta (suc (suc n))) (Delta (suc n))} {times (times (Delta (suc n)) I) (Delta (suc n))} {Delta (suc n)} (p-y n) (gg n) w)
   (ccl {One} {times (Delta (suc (suc n))) (Delta (suc n))} {Delta (suc n)} w
     (pair-beta2 (comp (sect n) (pi1 (Delta (suc (suc n))) (Delta (suc n)))) (pi2 (Delta (suc (suc n))) (Delta (suc n))))) ;

 gg-p-s : Id (Ob (Delta (suc n))) (Ob-map (p-s n) (Ob-map (gg n) w)) (Ob-map (pre-face-n n) phi) =
  H.transH (composeA {One} {times (times (Delta (suc n)) I) (Delta (suc n))} {times (Delta (suc n)) I} {Delta (suc n)} (pi1 (Delta (suc n)) I) (p-outer n) (Ob-map (gg n) w))
  (H.transH (ccr {One} {times (Delta (suc n)) I} {Delta (suc n)} (pi1 (Delta (suc n)) I) gg-outer)
  (H.transH (comp-assoc {One} {Delta (suc (suc n))} {times (Delta (suc n)) I} {Delta (suc n)} (pi1 (Delta (suc n)) I) (sect n) phi)
   (ccl {One} {Delta (suc (suc n))} {Delta (suc n)} phi (pair-beta1 (pre-face-n n) (eval-at-top n))))) ;

 gg-p-t : Id (Ob I) (Ob-map (p-t n) (Ob-map (gg n) w)) (Ob-map (eval-at-top n) phi) =
  H.transH (composeA {One} {times (times (Delta (suc n)) I) (Delta (suc n))} {times (Delta (suc n)) I} {I} (pi2 (Delta (suc n)) I) (p-outer n) (Ob-map (gg n) w))
  (H.transH (ccr {One} {times (Delta (suc n)) I} {I} (pi2 (Delta (suc n)) I) gg-outer)
  (H.transH (comp-assoc {One} {Delta (suc (suc n))} {times (Delta (suc n)) I} {I} (pi2 (Delta (suc n)) I) (sect n) phi)
   (ccl {One} {Delta (suc (suc n))} {I} phi (pair-beta2 (pre-face-n n) (eval-at-top n))))) ;

 rhs-ev : Id Two (ob-to-2 (ob-to-map (Delta (suc n)) I phi) y) (ob-to-2 (ev (Delta (suc n)) I) w) =
  H.transH (H.apH I-ob.1 (ev-point (Delta (suc n)) I phi y))
   (H.apH {Map One (times (Delta (suc (suc n))) (Delta (suc n)))} {Two} (\ u -> I-ob.1 (comp (ev (Delta (suc n)) I) u))
     (pair-eta {Delta (suc (suc n))} {Delta (suc n)} {One} w)) ;

 core : Id Two (ret-p n (Ob-map (gg n) w)) (ob-to-2 (ev (Delta (suc n)) I) w) =
  H.transH (thr-pred-cong n (H.apH (construction-20 (suc n)).1 gg-p-s) (H.apH I-ob.1 gg-p-t) (H.apH (construction-20 (suc n)).1 gg-p-y))
  (H.transH (interp-cong (refl (top-ind n ((construction-20 (suc n)).1 y)))
     (face-part n phi (deface n ((construction-20 (suc n)).1 y)))
     (interp-cong (top-part n phi) (face-part n phi (deface n ((construction-20 (suc n)).1 y))) (refl one2)))
  (H.transH (recon n g (monotone-ord-bwd (suc n) ((construction-20 (suc (suc n))).1 phi)).2 ((construction-20 (suc n)).1 y))
  (H.transH (rhs-simp n phi y) rhs-ev))) ;

 lhs-step : Id Two (ob-to-2 (comp (ret-adj n) (gg n)) w) (ret-p n (Ob-map (gg n) w)) =
  H.transH (H.apH I-ob.1 (composeA {One} {times (Delta (suc (suc n))) (Delta (suc n))} {times (times (Delta (suc n)) I) (Delta (suc n))} {I} (ret-adj n) (gg n) w))
   (I-char-ob-to-2 (times (times (Delta (suc n)) I) (Delta (suc n))) (ret-p n, ret-p-mono n) (Ob-map (gg n) w)) ;
} ;

ret-sect-key (n : Nat) : Id (Map (times (Delta (suc (suc n))) (Delta (suc n))) I) (comp (ret-adj n) (gg n)) (ev (Delta (suc n)) I) =
 Equivalences[l].injective (Map (times (Delta (suc (suc n))) (Delta (suc n))) I) (Monotone (times (Delta (suc (suc n))) (Delta (suc n))))
  (I-char-comparison (times (Delta (suc (suc n))) (Delta (suc n)))) (I-char (times (Delta (suc (suc n))) (Delta (suc n)))).2
  (comp (ret-adj n) (gg n)) (ev (Delta (suc n)) I)
  (Pl.Sigma-eq (Ob (times (Delta (suc (suc n))) (Delta (suc n))) -> Two) (is-monotone (times (Delta (suc (suc n))) (Delta (suc n))))
    (ob-to-2 (comp (ret-adj n) (gg n))) (ob-to-2 (ev (Delta (suc n)) I))
    (I-char-comparison (times (Delta (suc (suc n))) (Delta (suc n))) (comp (ret-adj n) (gg n))).2
    (I-char-comparison (times (Delta (suc (suc n))) (Delta (suc n))) (ev (Delta (suc n)) I)).2
    (FL.funext (Ob (times (Delta (suc (suc n))) (Delta (suc n)))) (\ w -> Two) (ob-to-2 (comp (ret-adj n) (gg n))) (ob-to-2 (ev (Delta (suc n)) I))
      (\ w -> H.transH (RetSect[n, w].lhs-step) (RetSect[n, w].core)))
    (is-monotone-is-prop (times (Delta (suc (suc n))) (Delta (suc n))) (ob-to-2 (ev (Delta (suc n)) I)))) ;

ret-sect (n : Nat) : Id (Map (Delta (suc (suc n))) (Delta (suc (suc n)))) (comp (ret n) (sect n)) (idMap (Delta (suc (suc n)))) =
 Equivalences[l].injective (Map (Delta (suc (suc n))) (Fun (Delta (suc n)) I)) (Map (times (Delta (suc (suc n))) (Delta (suc n))) I)
  (exp-comparison (Delta (suc n)) I (Delta (suc (suc n)))) (exp-is-equiv (Delta (suc n)) I (Delta (suc (suc n))))
  (comp (ret n) (sect n)) (idMap (Delta (suc (suc n))))
  (H.transH (H.transH (exp-comp-nat (ret n) (sect n))
     (ccl (gg n) ((exp-is-equiv (Delta (suc n)) I (times (Delta (suc n)) I)).sec-eq (ret-adj n))))
   (H.transH (ret-sect-key n)
    (H.symH (H.transH (ccr (ev (Delta (suc n)) I)
       (H.transH (pair-ap (comp-id-l (pi1 (Delta (suc (suc n))) (Delta (suc n)))) (refl (pi2 (Delta (suc (suc n))) (Delta (suc n)))))
        (H.transH (pair-ap (H.symH (comp-id-r (pi1 (Delta (suc (suc n))) (Delta (suc n))))) (H.symH (comp-id-r (pi2 (Delta (suc (suc n))) (Delta (suc n))))))
         (pair-eta (idMap (times (Delta (suc (suc n))) (Delta (suc n))))))))
      (comp-id-r (ev (Delta (suc n)) I)))))) ;

------------------------------------------------------------------------
-- ret-p at a pairing <<s, t>, y>

ret-p-expand (n : Nat) (s : Ob (Delta (suc n))) (t : Ob I) (y : Ob (Delta (suc n))) :
 Id Two (ret-p n (pair {times (Delta (suc n)) I} {Delta (suc n)} {One} (pair {Delta (suc n)} {I} {One} s t) y))
  (thr-pred n ((construction-20 (suc n)).1 s) (I-ob.1 t) ((construction-20 (suc n)).1 y)) =
 thr-pred-cong n
  (H.apH (construction-20 (suc n)).1
   (H.transH (composeA {One} {times (times (Delta (suc n)) I) (Delta (suc n))} {times (Delta (suc n)) I} {Delta (suc n)} (pi1 (Delta (suc n)) I) (p-outer n)
      (pair {times (Delta (suc n)) I} {Delta (suc n)} {One} (pair {Delta (suc n)} {I} {One} s t) y))
    (H.transH (ccr {One} {times (Delta (suc n)) I} {Delta (suc n)} (pi1 (Delta (suc n)) I) (pair-beta1 {times (Delta (suc n)) I} {Delta (suc n)} {One} (pair {Delta (suc n)} {I} {One} s t) y))
     (pair-beta1 {Delta (suc n)} {I} {One} s t))))
  (H.apH I-ob.1
   (H.transH (composeA {One} {times (times (Delta (suc n)) I) (Delta (suc n))} {times (Delta (suc n)) I} {I} (pi2 (Delta (suc n)) I) (p-outer n)
      (pair {times (Delta (suc n)) I} {Delta (suc n)} {One} (pair {Delta (suc n)} {I} {One} s t) y))
    (H.transH (ccr {One} {times (Delta (suc n)) I} {I} (pi2 (Delta (suc n)) I) (pair-beta1 {times (Delta (suc n)) I} {Delta (suc n)} {One} (pair {Delta (suc n)} {I} {One} s t) y))
     (pair-beta2 {Delta (suc n)} {I} {One} s t))))
  (H.apH (construction-20 (suc n)).1 (pair-beta2 {times (Delta (suc n)) I} {Delta (suc n)} {One} (pair {Delta (suc n)} {I} {One} s t) y)) ;
