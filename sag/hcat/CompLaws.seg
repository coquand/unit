-- Functors preserve composition; the unit laws (Wärn, Constructions 22-23
-- and Remark 32; Agda Simplices/FullyFaithful, the postulates
-- Hom-map-comp and the unit law behind id-hom-is-inv).  Level 2.
--   Tri-eq: two triangle boundaries are equal over paths of their three
--   vertices along which the three morphisms agree (J on the vertices).
--   Tri-map-of-comp: Tri-map (F o G) t = Tri-map F (Tri-map G t), by the
--   reassociators at the vertices and Hom-map-of-comp at the edges.
--   bd-nat: the boundary of F o s is F applied to the boundary of s
--   (s o std-tri is the boundary of s).
--   Hom-map-comp: F maps the composite of p to the composite of F p.
--   Take the filler s of p (composite-filler); F o s has boundary
--   F (bd s) = (F p, F (composite p)), so the composite of F p is
--   F (composite p) (composite-witness).
--   Unit laws.  By J on the endpoint proofs it suffices to take
--   h = (m, refl, refl).  In I, the pair (gen-hom, id I1) has a filler
--   sigma-r (Segal at n = 2 in I), whose long edge is gen-hom since
--   Hom I I0 I1 is a proposition; m o sigma-r has boundary
--   (m gen-hom, m (id I1), m gen-hom) = (h, id, h) (Hom-map-gen,
--   Hom-map-id), so composite (h, id) = h.  The left law with
--   (id I0, gen-hom) likewise.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open IntervalPosetal ;
open HomFunctor ; open Composition ;

Tri-eq (C : Cat) {z y x : Ob C} (h1 : Hom C z y) (h2 : Hom C y x) (h3 : Hom C z x) :
 (z1 : Ob C) (a : Id (Ob C) z z1) (y1 : Ob C) (b : Id (Ob C) y y1) (x1 : Ob C) (c : Id (Ob C) x x1)
 (k1 : Hom C z1 y1) (k2 : Hom C y1 x1) (k3 : Hom C z1 x1) ->
 Id (Hom C z1 y1) (Hom-coerce C a b h1) k1 -> Id (Hom C y1 x1) (Hom-coerce C b c h2) k2 -> Id (Hom C z1 x1) (Hom-coerce C a c h3) k3 ->
 Id (Tri C) ((z, y, x, h1, h2), h3) ((z1, y1, x1, k1, k2), k3) =
 \ z1 a -> idJ (Ob C) z (\ z2 a2 -> (y1 : Ob C) (b : Id (Ob C) y y1) (x1 : Ob C) (c : Id (Ob C) x x1)
   (k1 : Hom C z2 y1) (k2 : Hom C y1 x1) (k3 : Hom C z2 x1) ->
   Id (Hom C z2 y1) (Hom-coerce C a2 b h1) k1 -> Id (Hom C y1 x1) (Hom-coerce C b c h2) k2 -> Id (Hom C z2 x1) (Hom-coerce C a2 c h3) k3 ->
   Id (Tri C) ((z, y, x, h1, h2), h3) ((z2, y1, x1, k1, k2), k3))
  (\ y1 b -> idJ (Ob C) y (\ y2 b2 -> (x1 : Ob C) (c : Id (Ob C) x x1)
    (k1 : Hom C z y2) (k2 : Hom C y2 x1) (k3 : Hom C z x1) ->
    Id (Hom C z y2) (Hom-coerce C (refl z) b2 h1) k1 -> Id (Hom C y2 x1) (Hom-coerce C b2 c h2) k2 -> Id (Hom C z x1) (Hom-coerce C (refl z) c h3) k3 ->
    Id (Tri C) ((z, y, x, h1, h2), h3) ((z, y2, x1, k1, k2), k3))
   (\ x1 c -> idJ (Ob C) x (\ x2 c2 -> (k1 : Hom C z y) (k2 : Hom C y x2) (k3 : Hom C z x2) ->
     Id (Hom C z y) h1 k1 -> Id (Hom C y x2) (Hom-coerce C (refl y) c2 h2) k2 -> Id (Hom C z x2) (Hom-coerce C (refl z) c2 h3) k3 ->
     Id (Tri C) ((z, y, x, h1, h2), h3) ((z, y, x2, k1, k2), k3))
    (\ k1 k2 k3 e1 e2 e3 ->
      H.transH (H.apH {Hom C z y} {Tri C} (\ u -> ((z, y, x, u, h2), h3)) e1)
       (H.transH (H.apH {Hom C y x} {Tri C} (\ u -> ((z, y, x, k1, u), h3)) e2)
        (H.apH {Hom C z x} {Tri C} (\ u -> ((z, y, x, k1, k2), u)) e3)))
    x1 c)
   y1 b)
  z1 a ;

Tri-map-of-comp {A B C : Cat} (F : Map B C) (G : Map A B) (t : Tri A) :
 Id (Tri C) (Tri-map (comp F G) t) (Tri-map F (Tri-map G t)) =
 Tri-eq C (Hom-map (comp F G) t.1.1 t.1.2.1 t.1.2.2.2.1) (Hom-map (comp F G) t.1.2.1 t.1.2.2.1 t.1.2.2.2.2)
  (Hom-map (comp F G) t.1.1 t.1.2.2.1 t.2)
  (Ob-map F (Ob-map G t.1.1)) (composeA {One} {A} {B} {C} F G t.1.1)
  (Ob-map F (Ob-map G t.1.2.1)) (composeA {One} {A} {B} {C} F G t.1.2.1)
  (Ob-map F (Ob-map G t.1.2.2.1)) (composeA {One} {A} {B} {C} F G t.1.2.2.1)
  (Tri-map F (Tri-map G t)).1.2.2.2.1 (Tri-map F (Tri-map G t)).1.2.2.2.2 (Tri-map F (Tri-map G t)).2
  (Hom-map-of-comp F G t.1.1 t.1.2.1 t.1.2.2.2.1) (Hom-map-of-comp F G t.1.2.1 t.1.2.2.1 t.1.2.2.2.2)
  (Hom-map-of-comp F G t.1.1 t.1.2.2.1 t.2) ;

bd-nat {A C : Cat} (F : Map A C) (s : Map (Delta (suc (suc zero))) A) :
 Id (Tri C) (bd C (comp F s)) (Tri-map F (bd A s)) = Tri-map-of-comp F s std-tri ;

Hom-map-comp {A C : Cat} (F : Map A C) (p : Pair A) :
 Id (HomQ C (Pair-map F p)) (composite C (Pair-map F p)) (Hom-map F p.1 p.2.2.1 (composite A p)) =
 composite-witness C (Tri-map F (p, composite A p)) (comp F (composite-filler A p).1)
  (H.transH (bd-nat F (composite-filler A p).1) (H.apH (Tri-map F) (composite-filler A p).2)) ;

-- in the notation of the Agda port
Hom-map-hcomp {A C : Cat} (F : Map A C) {a b c : Ob A} (u : Hom A a b) (v : Hom A b c) :
 Id (Hom C (Ob-map F a) (Ob-map F c)) (Hom-map F a c (hcomp u v)) (hcomp (Hom-map F a b u) (Hom-map F b c v)) =
 H.symH (Hom-map-comp F (a, b, c, u, v)) ;

------------------------------------------------------------------------
-- unit laws

pair-r : Pair I = (I0, I1, I1, gen-hom, id-hom I1) ;
sigma-r : Map (Delta (suc (suc zero))) I = (segal2-equiv I).sec pair-r ;
bd-sigma-r : Id (Tri I) (bd I sigma-r) (pair-r, gen-hom) =
 Pl.Sigma-eq (Pair I) (HomQ I) (bd-pair I sigma-r) pair-r (bd I sigma-r).2 gen-hom ((segal2-equiv I).sec-eq pair-r) (I-thin I0 I1) ;

pair-l : Pair I = (I0, I0, I1, id-hom I0, gen-hom) ;
sigma-l : Map (Delta (suc (suc zero))) I = (segal2-equiv I).sec pair-l ;
bd-sigma-l : Id (Tri I) (bd I sigma-l) (pair-l, gen-hom) =
 Pl.Sigma-eq (Pair I) (HomQ I) (bd-pair I sigma-l) pair-l (bd I sigma-l).2 gen-hom ((segal2-equiv I).sec-eq pair-l) (I-thin I0 I1) ;

unit-r-refl {C : Cat} (m : Mor C) :
 Id (Hom C (dom m) (cod m)) (hcomp {C} {dom m} {cod m} {cod m} (m, refl (dom m), refl (cod m)) (id-hom (cod m))) (m, refl (dom m), refl (cod m)) =
 composite-witness C ((dom m, cod m, cod m, (m, refl (dom m), refl (cod m)), id-hom (cod m)), (m, refl (dom m), refl (cod m)))
  (comp m sigma-r)
  (H.transH {Tri C} {bd C (comp m sigma-r)} {Tri-map m (bd I sigma-r)} (bd-nat {I} {C} m sigma-r)
   (H.transH {Tri C} {Tri-map m (bd I sigma-r)} {Tri-map {I} {C} m (pair-r, gen-hom)} (H.apH {Tri I} {Tri C} (Tri-map m) bd-sigma-r)
    (Tri-eq C (Hom-map m I0 I1 gen-hom) (Hom-map m I1 I1 (id-hom I1)) (Hom-map m I0 I1 gen-hom)
      (dom m) (refl (dom m)) (cod m) (refl (cod m)) (cod m) (refl (cod m))
      (m, refl (dom m), refl (cod m)) (id-hom (cod m)) (m, refl (dom m), refl (cod m))
      (Hom-map-gen m) (Hom-map-id m I1) (Hom-map-gen m)))) ;

unit-l-refl {C : Cat} (m : Mor C) :
 Id (Hom C (dom m) (cod m)) (hcomp {C} {dom m} {dom m} {cod m} (id-hom (dom m)) (m, refl (dom m), refl (cod m))) (m, refl (dom m), refl (cod m)) =
 composite-witness C ((dom m, dom m, cod m, id-hom (dom m), (m, refl (dom m), refl (cod m))), (m, refl (dom m), refl (cod m)))
  (comp m sigma-l)
  (H.transH {Tri C} {bd C (comp m sigma-l)} {Tri-map m (bd I sigma-l)} (bd-nat {I} {C} m sigma-l)
   (H.transH {Tri C} {Tri-map m (bd I sigma-l)} {Tri-map {I} {C} m (pair-l, gen-hom)} (H.apH {Tri I} {Tri C} (Tri-map m) bd-sigma-l)
    (Tri-eq C (Hom-map m I0 I0 (id-hom I0)) (Hom-map m I0 I1 gen-hom) (Hom-map m I0 I1 gen-hom)
      (dom m) (refl (dom m)) (dom m) (refl (dom m)) (cod m) (refl (cod m))
      (id-hom (dom m)) (m, refl (dom m), refl (cod m)) (m, refl (dom m), refl (cod m))
      (Hom-map-id m I0) (Hom-map-gen m) (Hom-map-gen m)))) ;

hcomp-unit-r {C : Cat} {a b : Ob C} (h : Hom C a b) : Id (Hom C a b) (hcomp h (id-hom b)) h =
 idJ (Ob C) (dom {C} h.1) (\ a1 p -> (b1 : Ob C) (q : Id (Ob C) (cod {C} h.1) b1) ->
   Id (Hom C a1 b1) (hcomp {C} {a1} {b1} {b1} (h.1, p, q) (id-hom b1)) (h.1, p, q))
  (\ b1 q -> idJ (Ob C) (cod {C} h.1) (\ b2 q2 ->
     Id (Hom C (dom {C} h.1) b2) (hcomp {C} {dom {C} h.1} {b2} {b2} (h.1, refl (dom {C} h.1), q2) (id-hom b2)) (h.1, refl (dom {C} h.1), q2))
    (unit-r-refl h.1) b1 q)
  a h.2.1 b h.2.2 ;

hcomp-unit-l {C : Cat} {a b : Ob C} (h : Hom C a b) : Id (Hom C a b) (hcomp (id-hom a) h) h =
 idJ (Ob C) (dom {C} h.1) (\ a1 p -> (b1 : Ob C) (q : Id (Ob C) (cod {C} h.1) b1) ->
   Id (Hom C a1 b1) (hcomp {C} {a1} {a1} {b1} (id-hom a1) (h.1, p, q)) (h.1, p, q))
  (\ b1 q -> idJ (Ob C) (cod {C} h.1) (\ b2 q2 ->
     Id (Hom C (dom {C} h.1) b2) (hcomp {C} {dom {C} h.1} {dom {C} h.1} {b2} (id-hom (dom {C} h.1)) (h.1, refl (dom {C} h.1), q2)) (h.1, refl (dom {C} h.1), q2))
    (unit-l-refl h.1) b1 q)
  a h.2.1 b h.2.2 ;
