-- Equivalences of Sigma types and of path types (Agda
-- Foundations/SigmaEquiv, the parts used downstream).
--   Sigma-change-of-base: for e : A ~ B and P on B, (a, p) |-> (e a, p) is
--   an equivalence  Sigma (a : A) P (e a) ~ Sigma (b : B) P b.  By induction
--   on equivalences (univalence): at the identity the map is the identity.
--   (Agda proves it from the half-adjoint coherence of a contractible-fibre
--   equivalence; for bi-invertible data that coherence is not given.)
--   Sigma-fiberwise-equiv: fibrewise equivalences give one of total spaces.
--   post-comp-path-equiv q : (x = y) ~ (x = z), p |-> p . q;
--   pre-comp-path-equiv p : (y = z) ~ (x = z), r |-> p . r.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ;
module UL = Axioms[l].UnivalenceLemmas[univ @l] ;

change-of-base-map (A B : U l) (P : B -> U l) (f : A -> B) (w : (a : A) * P (f a)) : (b : B) * P b = (f w.1, w.2) ;

Sigma-change-of-base (A B : U l) (P : B -> U l) (e : Pl.Equiv A B) :
 Pl.Equiv ((a : A) * P (e.1 a)) ((b : B) * P b) =
 (change-of-base-map A B P e.1,
  UL.eqind A (\ B1 e1 -> (P1 : B1 -> U l) -> Pl.isEquiv ((a : A) * P1 (e1.1 a)) ((b : B1) * P1 b) (change-of-base-map A B1 P1 e1.1))
   (\ P1 -> Pl.qinv ((a : A) * P1 a) ((b : A) * P1 b) (change-of-base-map A A P1 (\ a -> a)) (\ w -> w)
     (\ w -> refl w) (\ w -> refl w))
   B e P) ;

Sigma-fiberwise-equiv (A : U l) (P Q : A -> U l) (e : (a : A) -> Pl.Equiv (P a) (Q a)) :
 Pl.Equiv ((a : A) * P a) ((a : A) * Q a) =
 (\ w -> (w.1, (e w.1).1 w.2),
  Pl.qinv ((a : A) * P a) ((a : A) * Q a) (\ w -> (w.1, (e w.1).1 w.2)) (\ w -> (w.1, (e w.1).2.sec w.2))
   (\ w -> H.apH (\ v -> (w.1, v)) ((e w.1).2.sec-eq w.2))
   (\ w -> H.apH (\ v -> (w.1, v)) (Pl.sec-ret (P w.1) (Q w.1) (e w.1).1 (e w.1).2 w.2))) ;

post-comp-path-equiv {A : U l} {x y z : A} (q : Id A y z) : Pl.Equiv (Id A x y) (Id A x z) =
 (\ p -> H.transH p q,
  Pl.qinv (Id A x y) (Id A x z) (\ p -> H.transH p q) (\ r -> H.transH r (H.symH q))
   (\ r -> H.transH (PA.tassoc r (H.symH q) q) (H.apH (\ v -> H.transH r v) (PA.inv-l q)))
   (\ p -> PA.canc-r q p)) ;

pre-comp-path-equiv {A : U l} {x y z : A} (p : Id A x y) : Pl.Equiv (Id A y z) (Id A x z) =
 (\ r -> H.transH p r,
  Pl.qinv (Id A y z) (Id A x z) (\ r -> H.transH p r) (\ r -> H.transH (H.symH p) r)
   (\ r -> H.transH (H.symH (PA.tassoc p (H.symH p) r))
     (H.transH (H.apH (\ v -> H.transH v r) (PA.inv-r p)) (PA.unit-l r)))
   (\ r -> PA.canc-l p r)) ;
