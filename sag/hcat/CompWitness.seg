-- Postcomposition of a specified composite is coherent.
-- Given tb : ey tf = ez, define beta(phi) = al(ey,tf,phi)^-1 . tb(phi).
-- For phi followed by g, the two induced beta paths agree after the
-- associators are inserted. The only categorical coherence needed is
-- the pentagon at (ey,tf,phi,g). Solve that pentagon for al2 . alt,
-- cancel al3 with its inverse, then use naturality of the associator
-- in tb. The remaining equation is ap preserving concatenation/inverse.
-- This is independent of copowers, universal properties, and homology.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ; open AssocNat ;

cancel {Z : U l} {x y z : Z} (a : Id Z x y) (q : Id Z x z) :
 Id (Id Z x z) (H.transH a (H.transH (H.symH a) q)) q =
 H.transH (H.symH (PA.tassoc a (H.symH a) q)) (H.transH (H.apH (\ r -> H.transH r q) (PA.inv-r a)) (PA.unit-l q)) ;

module Post (C : Cat) (A YA ZA : Ob C) (ey : Hom C A YA) (tf : Hom C YA ZA) (ez : Hom C A ZA)
 (tb : Id (Hom C A ZA) (hcomp {C} ey tf) ez) {
 beta (T : Ob C) (phi : Hom C ZA T) : Id (Hom C A T) (hcomp {C} ey (hcomp {C} tf phi)) (hcomp {C} ez phi) =
  H.transH (H.symH (hcomp-assoc C (A, YA, ZA, T, ey, tf, phi))) (H.apH (\ u -> hcomp {C} u phi) tb) ;

 module Assoc (W T1 : Ob C) (phi : Hom C ZA W) (g : Hom C W T1) (pent : HcompPentagon.Pentagon C ey tf phi g) {
 al0 : Id (Hom C A T1) (hcomp {C} (hcomp {C} (hcomp {C} ey tf) phi) g) (hcomp {C} (hcomp {C} ey tf) (hcomp {C} phi g)) =
  hcomp-assoc C (A, ZA, W, T1, hcomp {C} ey tf, phi, g) ;
 al1 : Id (Hom C A W) (hcomp {C} (hcomp {C} ey tf) phi) (hcomp {C} ey (hcomp {C} tf phi)) =
  hcomp-assoc C (A, YA, ZA, W, ey, tf, phi) ;
 al2 : Id (Hom C A T1) (hcomp {C} (hcomp {C} ey (hcomp {C} tf phi)) g) (hcomp {C} ey (hcomp {C} (hcomp {C} tf phi) g)) =
  hcomp-assoc C (A, YA, W, T1, ey, hcomp {C} tf phi, g) ;
 al3 : Id (Hom C A T1) (hcomp {C} (hcomp {C} ey tf) (hcomp {C} phi g)) (hcomp {C} ey (hcomp {C} tf (hcomp {C} phi g))) =
  hcomp-assoc C (A, YA, ZA, T1, ey, tf, hcomp {C} phi g) ;
 alt : Id (Hom C A T1) (hcomp {C} ey (hcomp {C} (hcomp {C} tf phi) g)) (hcomp {C} ey (hcomp {C} tf (hcomp {C} phi g))) =
  H.apH (\ w -> hcomp {C} ey w) (hcomp-assoc C (YA, ZA, W, T1, tf, phi, g)) ;
 a1 : Id (Hom C A T1) (hcomp {C} (hcomp {C} (hcomp {C} ey tf) phi) g) (hcomp {C} (hcomp {C} ey (hcomp {C} tf phi)) g) =
  H.apH (\ w -> hcomp {C} w g) al1 ;
 L : Id (Hom C A T1) (hcomp {C} (hcomp {C} ey tf) (hcomp {C} phi g)) (hcomp {C} ez (hcomp {C} phi g)) =
  H.apH (\ w -> hcomp {C} w (hcomp {C} phi g)) tb ;
 R : Id (Hom C A T1) (hcomp {C} ey (hcomp {C} tf (hcomp {C} phi g))) (hcomp {C} ez (hcomp {C} phi g)) =
  beta T1 (hcomp {C} phi g) ;

 -- the pentagon, solved for al2 . alt
 head : Id (Id (Hom C A T1) (hcomp {C} (hcomp {C} ey (hcomp {C} tf phi)) g) (hcomp {C} ey (hcomp {C} tf (hcomp {C} phi g))))
  (H.transH al2 alt) (H.transH (H.symH a1) (H.transH al0 al3)) =
  H.transH (H.symH (PA.canc-l a1 (H.transH al2 alt)))
   (H.apH (\ r -> H.transH (H.symH a1) r) (H.transH (H.symH (PA.tassoc a1 al2 alt)) (H.symH pent))) ;

 coherence : Id (Id (Hom C A T1) (hcomp {C} (hcomp {C} ey (hcomp {C} tf phi)) g) (hcomp {C} ez (hcomp {C} phi g)))
  (H.transH al2 (H.transH alt R))
  (H.transH (H.apH (\ w -> hcomp {C} w g) (beta W phi)) (hcomp-assoc C (A, ZA, W, T1, ez, phi, g))) =
  calc (Id (Hom C A T1) (hcomp {C} (hcomp {C} ey (hcomp {C} tf phi)) g) (hcomp {C} ez (hcomp {C} phi g))) {
   H.transH al2 (H.transH alt R)
   =< H.symH (PA.tassoc al2 alt R) > H.transH (H.transH al2 alt) R
   =< H.apH (\ r -> H.transH r R) head > H.transH (H.transH (H.symH a1) (H.transH al0 al3)) R
   =< PA.tassoc (H.symH a1) (H.transH al0 al3) R > H.transH (H.symH a1) (H.transH (H.transH al0 al3) R)
   =< H.apH (\ r -> H.transH (H.symH a1) r) (H.transH (PA.tassoc al0 al3 R) (H.apH (\ r -> H.transH al0 r) (cancel al3 L))) >
     H.transH (H.symH a1) (H.transH al0 L)
   =< H.apH (\ r -> H.transH (H.symH a1) r) (assoc-nat-l C (hcomp {C} ey tf) ez tb phi g) >
     H.transH (H.symH a1) (H.transH (H.apH (\ w -> hcomp {C} w g) (H.apH (\ w -> hcomp {C} w phi) tb)) (hcomp-assoc C (A, ZA, W, T1, ez, phi, g)))
   =< H.symH (PA.tassoc (H.symH a1) (H.apH (\ w -> hcomp {C} w g) (H.apH (\ w -> hcomp {C} w phi) tb)) (hcomp-assoc C (A, ZA, W, T1, ez, phi, g))) >
     H.transH (H.transH (H.symH a1) (H.apH (\ w -> hcomp {C} w g) (H.apH (\ w -> hcomp {C} w phi) tb))) (hcomp-assoc C (A, ZA, W, T1, ez, phi, g))
   =< H.apH (\ r -> H.transH r (hcomp-assoc C (A, ZA, W, T1, ez, phi, g)))
       (H.symH (H.transH (PA.ap-trans (\ w -> hcomp {C} w g) (H.symH al1) (H.apH (\ w -> hcomp {C} w phi) tb))
         (H.apH (\ r -> H.transH r (H.apH (\ w -> hcomp {C} w g) (H.apH (\ w -> hcomp {C} w phi) tb))) (PA.ap-sym (\ w -> hcomp {C} w g) al1)))) >
     H.transH (H.apH (\ w -> hcomp {C} w g) (beta W phi)) (hcomp-assoc C (A, ZA, W, T1, ez, phi, g)) } ;
 } ;
} ;
