-- A finite definition of an entire exact sequence of groups.
-- Start with one pointed map and repeatedly take its pointed fibre
-- inclusion. Apply FibreSequence at each stage. Both homomorphism laws
-- and exactness refer to these same recursively defined arrows.
-- The first rotation identifies fib(fib(f)->Y) with Omega W, over the
-- connecting map q |-> (y,p.q). This is fib-pr1 plus path translation,
-- retaining the projection. No dimension-indexed coherence parameter.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
module PM = Pi0Maps[l] ;
open FibreLemmas ; open Pi0[l] ;

record Arrow {
 dom : U l ;
 dompt : dom ;
 cod : U l ;
 codpt : cod ;
 map : dom -> cod ;
 pointing : Id cod (map dompt) codpt ;
} ;

fibre (s : Arrow) : Arrow =
 new Arrow[fib s.map s.codpt, (s.dompt, s.pointing), s.dom, s.dompt, \ w -> w.1, refl s.dompt] ;

tower (s : Arrow) : Nat -> Arrow = split { zero -> s ; suc n | t -> fibre t } ;

module At (s : Arrow) (n : Nat) {
 module Q = FibreSequence.Sequence[(tower s n).dom, (tower s n).cod,
  (tower s n).dompt, (tower s n).codpt, (tower s n).map, (tower s n).pointing] ;
 -- Q.In.M.mul, Q.Out.M.mul, Q.zero and Q.exact are simultaneous
 -- homomorphism/exactness theorems, uniformly for every n.
 next-map (a : LoopGrp[(tower s (suc n)).dom, (tower s (suc n)).dompt].grp.G) :
  LoopGrp[(tower s n).dom, (tower s n).dompt].grp.G = Q.In.M.map a ;
 next-hom : PM.is-hom LoopGrp[(tower s (suc n)).dom, (tower s (suc n)).dompt].grp
  LoopGrp[(tower s n).dom, (tower s n).dompt].grp next-map = Q.In.M.mul ;
} ;

module Rotate (s : Arrow) {
 Q : U l = fib s.map s.codpt ;
 point : Q = (s.dompt, s.pointing) ;
 R : U l = fib {Q} {s.dom} (\ w -> w.1) s.dompt ;
 rpoint : R = (point, refl s.dompt) ;
 boundary (q : Id s.cod s.codpt s.codpt) : Q = (s.dompt, H.transH s.pointing q) ;
 to (q : Id s.cod s.codpt s.codpt) : R = (boundary q, refl s.dompt) ;
 equiv : Pl.isEquiv (Id s.cod s.codpt s.codpt) R to =
  EL.compose (Id s.cod s.codpt s.codpt) (Id s.cod (s.map s.dompt) s.codpt) R
   (\ q -> ((s.dompt, q), refl s.dompt)) (\ q -> H.transH s.pointing q)
   (EL.inverse R (Id s.cod (s.map s.dompt) s.codpt)
    (FibreAlg.fib-pr1 s.dom (\ y -> Id s.cod (s.map y) s.codpt) s.dompt)).2
   (SigmaEquiv.pre-comp-path-equiv {s.cod} {s.map s.dompt} {s.codpt} {s.codpt} s.pointing).2 ;
 pointed : Id R (to (refl s.codpt)) rpoint = refl rpoint ;
 over (q : Id s.cod s.codpt s.codpt) : Id Q (to q).1 (boundary q) = refl (boundary q) ;
} ;
