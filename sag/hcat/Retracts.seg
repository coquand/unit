-- Retracts of functors (Wärn Lemma 25; Agda Foundations/Retracts).  Level 1.
--   has-inverse-isIso: f with a two-sided inverse g is an isomorphism;
--   postcomposition with g inverts postcomposition with f, as
--   f o (g o h) = (f o g) o h = 1 o h = h, and symmetrically.
--   Lemma 25.  With r_i o s_i = 1 (i = 0, 1), s1 o f = s0 and f o r0 = r1,
--   f is an isomorphism with inverse g = r0 o s1:
--   f o g = (f o r0) o s1 = r1 o s1 = 1, g o f = r0 o (s1 o f) = r0 o s0 = 1.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open WildCat ;

has-inverse-isIso {C D : Cat} (f : Map C D) (g : Map D C)
 (fg : Id (Map D D) (comp f g) (idMap D)) (gf : Id (Map C C) (comp g f) (idMap C)) : isIso f =
 \ X -> Pl.qinv (Map X C) (Map X D) (post-comp f X) (post-comp g X)
  (\ h -> H.transH (comp-assoc f g h) (H.transH (ccl h fg) (comp-id-l h)))
  (\ h -> H.transH (comp-assoc g f h) (H.transH (ccl h gf) (comp-id-l h))) ;

retract-inverse {A B0 B1 : Cat}
 (s0 : Map B0 A) (r0 : Map A B0) (r0s0 : Id (Map B0 B0) (comp r0 s0) (idMap B0))
 (s1 : Map B1 A) (r1 : Map A B1) (r1s1 : Id (Map B1 B1) (comp r1 s1) (idMap B1))
 (f : Map B0 B1) (sf : Id (Map B0 A) (comp s1 f) s0) (fr : Id (Map A B1) (comp f r0) r1) :
 (g : Map B1 B0) * Id (Map B1 B1) (comp f g) (idMap B1) * Id (Map B0 B0) (comp g f) (idMap B0) =
 (comp r0 s1,
  H.transH (comp-assoc f r0 s1) (H.transH (ccl s1 fr) r1s1),
  H.transH (composeA r0 s1 f) (H.transH (ccr r0 sf) r0s0)) ;

retract-iso {A B0 B1 : Cat}
 (s0 : Map B0 A) (r0 : Map A B0) (r0s0 : Id (Map B0 B0) (comp r0 s0) (idMap B0))
 (s1 : Map B1 A) (r1 : Map A B1) (r1s1 : Id (Map B1 B1) (comp r1 s1) (idMap B1))
 (f : Map B0 B1) (sf : Id (Map B0 A) (comp s1 f) s0) (fr : Id (Map A B1) (comp f r0) r1) : isIso f =
 has-inverse-isIso f (comp r0 s1)
  (H.transH (comp-assoc f r0 s1) (H.transH (ccl s1 fr) r1s1))
  (H.transH (composeA r0 s1 f) (H.transH (ccr r0 sf) r0s0)) ;
