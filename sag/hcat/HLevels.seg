-- h-levels for the posetal part (Agda Foundations/HLevels).  Only what the
-- foundations lack: Prelude has prop-to-set, isSet-Sigma, isSet-retract;
-- AffineHLevels has set-from-equiv (Agda equiv-is-set); FunExtLemmas has
-- isSet-Pi (Agda fn-into-set).
--   hedberg-set: a reflexive, propositional relation implying equality
--   makes a type a set (Prelude.Hedberg at each point).
--   Sum-is-set: by Hedberg with the code of paths in a sum.
--   Two and Ord n are sets; so are Ob I and Ob (Delta n), through I-ob and
--   construction-20.
--   fn-into-contr-is-contr, Sigma-prop-contr, Sigma-set-prop, prod-is-prop.
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ; module CU = FunExtUA[l] ;
open HigherCat ; open Interval ; open Construction20 ;

hedberg-set (X : U l) (R : X -> X -> U l) (Rprop : (x y : X) -> Pl.isProp (R x y)) (rho : (x : X) -> R x x)
 (f : (x y : X) -> R x y -> Id X x y) : Pl.isSet X =
 \ x -> Pl.Hedberg[X, x, R x, Rprop x, rho x, f x].hedberg ;

module SumSet (A B : U l) (sA : Pl.isSet A) (sB : Pl.isSet B) {
 code : Sum A B -> Sum A B -> U l = split {
  inl a -> split { inl a1 -> Id A a a1 ; inr b -> Empty } ;
  inr b -> split { inl a -> Empty ; inr b1 -> Id B b b1 } } ;
 cprop : (x y : Sum A B) -> Pl.isProp (code x y) = split {
  inl a -> split { inl a1 -> sA a a1 ; inr b -> Pl.isProp-Empty } ;
  inr b -> split { inl a -> Pl.isProp-Empty ; inr b1 -> sB b b1 } } ;
 crefl : (x : Sum A B) -> code x x = split { inl a -> refl a ; inr b -> refl b } ;
 cdec : (x y : Sum A B) -> code x y -> Id (Sum A B) x y = split {
  inl a -> split { inl a1 -> \ p -> H.apH (\ v -> inl v) p ; inr b -> \ e -> Pl.absurd _ e } ;
  inr b -> split { inl a -> \ e -> Pl.absurd _ e ; inr b1 -> \ p -> H.apH (\ v -> inr v) p } } ;
 set : Pl.isSet (Sum A B) = hedberg-set (Sum A B) code cprop crefl cdec ;
} ;

Sum-is-set (A B : U l) (sA : Pl.isSet A) (sB : Pl.isSet B) : Pl.isSet (Sum A B) = SumSet[A, B, sA, sB].set ;

Top-is-set : Pl.isSet Top = Pl.prop-to-set Top isTop ;

Two-is-set : Pl.isSet Two = Sum-is-set Top Top Top-is-set Top-is-set ;

Ord-is-set : (n : Nat) -> Pl.isSet (Ord n) = split {
 zero -> Top-is-set ;
 suc n | r -> Sum-is-set (Ord n) Top r Top-is-set } ;

ob-I-is-set : Pl.isSet (Ob I) = AffineHLevels[l].set-from-equiv (Ob I) Two Two-is-set I-ob.1 I-ob.2 ;

ob-Delta-is-set (n : Nat) : Pl.isSet (Ob (Delta n)) =
 AffineHLevels[l].set-from-equiv (Ob (Delta n)) (Ord n) (Ord-is-set n) (construction-20 n).1 (construction-20 n).2 ;

fn-into-contr-is-contr (A B : U l) (cB : CU.isContr B) : CU.isContr (A -> B) =
 (\ a -> cB.1, \ g -> FL.funext A (\ a -> B) (\ a -> cB.1) g (\ a -> cB.2 (g a))) ;

Sigma-prop-contr (A : U l) (P : A -> U l) (cA : CU.isContr A) (Pprop : (a : A) -> Pl.isProp (P a))
 (s : (a : A) -> P a) : CU.isContr ((a : A) * P a) =
 ((cA.1, s cA.1), \ w -> Pl.Sigma-eq A P cA.1 w.1 (s cA.1) w.2 (cA.2 w.1) (Pprop w.1)) ;

Sigma-set-prop (A : U l) (P : A -> U l) (sA : Pl.isSet A) (Pprop : (a : A) -> Pl.isProp (P a)) :
 Pl.isSet ((a : A) * P a) =
 Pl.isSet-Sigma A P sA (\ a -> Pl.prop-to-set (P a) (Pprop a)) ;

prod-is-prop (A B : U l) (pA : Pl.isProp A) (pB : Pl.isProp B) : Pl.isProp (A * B) =
 Pl.isProp-Sigma A (\ a -> B) pA (\ a -> pB) ;
