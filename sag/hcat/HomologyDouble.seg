-- Hom(Sigma^2 S,E) on components is pi_2 Hom(S,E), as groups.
-- The existing group equivalence is L at Sigma S, followed by looping
-- the pointed equivalence L at S. Naturality uses L-nat and the
-- CommutingLoops square theorem: no compatibility of L-nat with its
-- basepoint paths, or higher categorical coherence, is required.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ; module PM = Pi0Maps[l] ;
open HigherCat ; open Constructions ; open Composition ; open Zero ; open Loops ; open HGroups ; open Pi0[l] ;

module At (S E : Ob D) {
 module G = LoopGroup[susp S, E] ;
 module L = PointedEquivalence.Loops[Hom D (susp S) E, LoopOf[S].Om E,
  zmap (susp S) E, refl (zmap S E), (LoopOf[S].L E, LoopOf[S].L-equiv E), LoopOf[S].L-zero E] ;
 module M = PM.EquivalenceHom[LoopGrp[Hom D (susp S) E, zmap (susp S) E].grp, G.grp.G, G.e] ;
 e : Pl.Equiv G.grp.G LoopGrp[LoopOf[S].Om E, refl (zmap S E)].grp.G =
  EL.then G.grp.G LoopGrp[Hom D (susp S) E, zmap (susp S) E].grp.G
   LoopGrp[LoopOf[S].Om E, refl (zmap S E)].grp.G G.e L.components ;
 hom : PM.is-hom G.grp LoopGrp[LoopOf[S].Om E, refl (zmap S E)].grp e.1 =
  \ x y -> H.transH (H.apH L.components.1 (M.forward x y)) (L.M.M.mul (G.e.1 x) (G.e.1 y)) ;
} ;

module Post (S E E1 : Ob D) (f : Hom D E E1) {
 module A = At[S, E] ; module B = At[S, E1] ;
 module PostMap = HGroupMaps.Post[susp S, E, E1, f] ;
 module BaseMap = HGroupMaps.Post[S, E, E1, f] ;
 module Looped = PM.Pointed[LoopOf[S].Om E, LoopOf[S].Om E1, refl (zmap S E), refl (zmap S E1),
  BaseMap.P.loop, Conj[l].conj-one (zero-post S f)] ;
 module Comm = CommutingLoops.Target[LoopOf[S].Om E1, refl (zmap S E1), \ a b -> EckmannHilton.eckmann-hilton a b] ;
 module Square = Comm.Square[Hom D (susp S) E, Hom D (susp S) E1, LoopOf[S].Om E,
  zmap (susp S) E, zmap (susp S) E1, refl (zmap S E),
  \ t -> hcomp {D} t f, BaseMap.P.loop, LoopOf[S].L E, LoopOf[S].L E1,
  zero-post (susp S) f, Conj[l].conj-one (zero-post S f), LoopOf[S].L-zero E, LoopOf[S].L-zero E1,
  \ t -> LoopOf[S].L-nat E E1 t f] ;
 natural (a : A.G.grp.G) :
  Id LoopGrp[LoopOf[S].Om E1, refl (zmap S E1)].grp.G (B.e.1 (PostMap.map a)) (Looped.M.map (A.e.1 a)) =
  H.transH (H.apH B.L.components.1 (PostMap.square a)) (Square.groups (A.G.e.1 a)) ;
} ;
