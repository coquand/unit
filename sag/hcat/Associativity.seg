-- Associativity of composition (Wärn, Construction 27; M6, step 4).
-- Level 2.
--   Quad C: three composable morphisms with their vertices,
--   a -> b -> c -> d; flat3 : TC C 3 ~ Quad C reads a chain of length 3
--   vertex by vertex (the inverse puts tt back; Top is a proposition).
--   segal3: T |-> the spine of T, read in Quad C, is an equivalence
--   (segal-all at n = 3).  The spine of T is T applied to the universal
--   spine q3 of Delta 3 (by definition of spine).
--   hcomp-assoc: (h1 h2) h3 = h1 (h2 h3) for every q in Quad C.  Along
--   the equivalence segal3 it suffices to take q the spine of some
--   T : Delta 3 -> C, i.e. q = T q3 (equiv-ind).  Then, since T preserves
--   composition (Hom-map-hcomp),
--     (T k01 T k12) T k23 = T ((k01 k12) k23)
--     T k01 (T k12 T k23) = T (k01 (k12 k23)),
--   and the two composites in Delta 3 are equal because Delta 3 is
--   posetal: its Hom types are propositions.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open FunIPosetal ;
open FaceTop ; open FibreLemmas ; open Chains ; open SegalAll ; open Composition ; open CompLaws ;

Quad (C : Cat) : U l = (a : Ob C) * (b : Ob C) * (c : Ob C) * (d : Ob C) * Hom C a b * Hom C b c * Hom C c d ;

flat3 (C : Cat) (t : TC C (suc (suc (suc zero)))) : Quad C =
 (t.2.2.1.2.1.1, t.2.2.1.1, t.2.1, t.1, t.2.2.1.2.1.2.2, t.2.2.1.2.2, t.2.2.2) ;

unflat3 (C : Cat) (q : Quad C) : TC C (suc (suc (suc zero))) =
 (q.2.2.2.1, q.2.2.1, (q.2.1, (q.1, tt, q.2.2.2.2.1), q.2.2.2.2.2.1), q.2.2.2.2.2.2) ;

flat3-equiv (C : Cat) : Pl.isEquiv (TC C (suc (suc (suc zero)))) (Quad C) (flat3 C) =
 Pl.qinv (TC C (suc (suc (suc zero)))) (Quad C) (flat3 C) (unflat3 C) (\ q -> refl q)
  (\ t -> H.apH {Top} {TC C (suc (suc (suc zero)))}
    (\ u -> (t.1, t.2.1, (t.2.2.1.1, (t.2.2.1.2.1.1, u, t.2.2.1.2.1.2.2), t.2.2.1.2.2), t.2.2.2))
    (isTop tt t.2.2.1.2.1.2.1)) ;

segal3 (C : Cat) : Pl.isEquiv (Map (Delta (suc (suc (suc zero)))) C) (Quad C)
 (\ T -> flat3 C (spine-total C (suc (suc (suc zero))) T)) =
 EL.compose (Map (Delta (suc (suc (suc zero)))) C) (TC C (suc (suc (suc zero)))) (Quad C)
  (flat3 C) (spine-total C (suc (suc (suc zero)))) (flat3-equiv C) (segal-all (suc (suc (suc zero))) C) ;

-- the universal spine of Delta 3
q3 : Quad (Delta (suc (suc (suc zero)))) = flat3 (Delta (suc (suc (suc zero)))) (top (suc (suc (suc zero))), univ-chain (suc (suc (suc zero)))) ;

assoc-lhs (C : Cat) (q : Quad C) : Hom C q.1 q.2.2.2.1 =
 hcomp (hcomp q.2.2.2.2.1 q.2.2.2.2.2.1) q.2.2.2.2.2.2 ;

assoc-rhs (C : Cat) (q : Quad C) : Hom C q.1 q.2.2.2.1 =
 hcomp q.2.2.2.2.1 (hcomp q.2.2.2.2.2.1 q.2.2.2.2.2.2) ;

module OnSpine (C : Cat) (T : Map (Delta (suc (suc (suc zero)))) C) {
 a : Ob (Delta (suc (suc (suc zero)))) = q3.1 ;
 b : Ob (Delta (suc (suc (suc zero)))) = q3.2.1 ;
 c : Ob (Delta (suc (suc (suc zero)))) = q3.2.2.1 ;
 d : Ob (Delta (suc (suc (suc zero)))) = q3.2.2.2.1 ;
 k01 : Hom (Delta (suc (suc (suc zero)))) a b = q3.2.2.2.2.1 ;
 k12 : Hom (Delta (suc (suc (suc zero)))) b c = q3.2.2.2.2.2.1 ;
 k23 : Hom (Delta (suc (suc (suc zero)))) c d = q3.2.2.2.2.2.2 ;
 in-delta : Id (Hom (Delta (suc (suc (suc zero)))) a d) (hcomp (hcomp k01 k12) k23) (hcomp k01 (hcomp k12 k23)) =
  (Delta-posetal (suc (suc (suc zero)))).1 a d (hcomp (hcomp k01 k12) k23) (hcomp k01 (hcomp k12 k23)) ;
 result : Id (Hom C (Ob-map T a) (Ob-map T d))
  (hcomp (hcomp (Hom-map T a b k01) (Hom-map T b c k12)) (Hom-map T c d k23))
  (hcomp (Hom-map T a b k01) (hcomp (Hom-map T b c k12) (Hom-map T c d k23))) =
  calc (Hom C (Ob-map T a) (Ob-map T d)) {
   hcomp (hcomp (Hom-map T a b k01) (Hom-map T b c k12)) (Hom-map T c d k23)
   =< H.apH (\ u -> hcomp u (Hom-map T c d k23)) (H.symH (Hom-map-hcomp T k01 k12)) >
     hcomp (Hom-map T a c (hcomp k01 k12)) (Hom-map T c d k23)
   =< H.symH (Hom-map-hcomp T (hcomp k01 k12) k23) > Hom-map T a d (hcomp (hcomp k01 k12) k23)
   =< H.apH (Hom-map T a d) in-delta > Hom-map T a d (hcomp k01 (hcomp k12 k23))
   =< Hom-map-hcomp T k01 (hcomp k12 k23) > hcomp (Hom-map T a b k01) (Hom-map T b d (hcomp k12 k23))
   =< H.apH (\ u -> hcomp (Hom-map T a b k01) u) (Hom-map-hcomp T k12 k23) >
     hcomp (Hom-map T a b k01) (hcomp (Hom-map T b c k12) (Hom-map T c d k23)) } ;
} ;

hcomp-assoc (C : Cat) (q : Quad C) : Id (Hom C q.1 q.2.2.2.1) (assoc-lhs C q) (assoc-rhs C q) =
 equiv-ind (\ T -> flat3 C (spine-total C (suc (suc (suc zero))) T)) (segal3 C) (\ q1 -> Hom C q1.1 q1.2.2.2.1)
  (assoc-lhs C) (assoc-rhs C) (\ T -> OnSpine[C, T].result) q ;
