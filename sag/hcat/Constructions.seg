-- Morphisms of a category (Wärn Definition 10, Constructions 11-12; Agda
-- Category/HigherCat, end, and Category/Constructions).  Parameters of
-- Structure used here: One, terminal, I, I-ob.
--   A morphism of C is a functor I -> C; I0, I1 are the objects of I
--   named by 0, 1 in Two; dom m = m o I0, cod m = m o I1.
--   Hom C x y: morphisms with a path from the domain to x and from the
--   codomain to y; hmor, hdom, hcod are its parts.
--   bang A: the unique functor A -> One (the centre).
--   The identity morphism of c is c o bang I.  Its domain is
--   (c o !) o I0 = c o (! o I0) = c o 1 = c, as Map One One is
--   contractible; the codomain likewise.
--   A functor acts on morphisms by composition; dom (f m) = f (dom m) and
--   cod (f m) = f (cod m) by the reassociator; so it acts on Hom.
open Base ;
module H = Paths[l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Finite[l] ;

I0 : Ob I = I-ob.2.sec zero2 ;
I1 : Ob I = I-ob.2.sec one2 ;

bang (A : Cat) : Map A One = (terminal A).1 ;

Mor (C : Cat) : U l = Map I C ;
dom {C : Cat} (m : Mor C) : Ob C = comp {One} {I} {C} m I0 ;
cod {C : Cat} (m : Mor C) : Ob C = comp {One} {I} {C} m I1 ;

Hom (C : Cat) (x y : Ob C) : U l = (m : Mor C) * Id (Ob C) (dom m) x * Id (Ob C) (cod m) y ;
hmor {C : Cat} {x y : Ob C} (h : Hom C x y) : Mor C = h.1 ;
hdom {C : Cat} {x y : Ob C} (h : Hom C x y) : Id (Ob C) (dom (hmor h)) x = h.2.1 ;
hcod {C : Cat} {x y : Ob C} (h : Hom C x y) : Id (Ob C) (cod (hmor h)) y = h.2.2 ;

id-mor {C : Cat} (c : Ob C) : Mor C = comp c (bang I) ;

dom-id {C : Cat} (c : Ob C) : Id (Ob C) (dom (id-mor c)) c =
 H.transH (composeA {One} {I} {One} {C} c (bang I) I0)
  (H.transH (ccr {One} {One} {C} c (CU.pathC (Map One One) (terminal One) (comp {One} {I} {One} (bang I) I0) (idMap One)))
   (comp-id-r {One} {C} c)) ;

cod-id {C : Cat} (c : Ob C) : Id (Ob C) (cod (id-mor c)) c =
 H.transH (composeA {One} {I} {One} {C} c (bang I) I1)
  (H.transH (ccr {One} {One} {C} c (CU.pathC (Map One One) (terminal One) (comp {One} {I} {One} (bang I) I1) (idMap One)))
   (comp-id-r {One} {C} c)) ;

id-hom {C : Cat} (c : Ob C) : Hom C c c = (id-mor c, dom-id c, cod-id c) ;

funct-on-mor {A B : Cat} (f : Map A B) (m : Mor A) : Mor B = comp f m ;

dom-nat {A B : Cat} (f : Map A B) (m : Mor A) : Id (Ob B) (dom (funct-on-mor f m)) (Ob-map f (dom m)) =
 composeA {One} {I} {A} {B} f m I0 ;
cod-nat {A B : Cat} (f : Map A B) (m : Mor A) : Id (Ob B) (cod (funct-on-mor f m)) (Ob-map f (cod m)) =
 composeA {One} {I} {A} {B} f m I1 ;

Hom-map {A B : Cat} (f : Map A B) (a0 a1 : Ob A) (h : Hom A a0 a1) : Hom B (Ob-map f a0) (Ob-map f a1) =
 (funct-on-mor f (hmor h),
  H.transH (dom-nat f (hmor h)) (H.apH (Ob-map f) (hdom h)),
  H.transH (cod-nat f (hmor h)) (H.apH (Ob-map f) (hcod h))) ;
