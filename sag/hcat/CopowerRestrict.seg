-- Restriction along the unit maps of a copower (DESIGN-HOMOLOGY.md, H1).
-- Internal level 1 of D (composition only).
--   restrict X A T g = (x |-> eta_x g) : Hom (X (x) A) T -> (X -> Hom A T),
--   precomposition with each eta_x : A -> X (x) A.  The axiom tensor-up
--   says it is an equivalence: X (x) A is the colimit of the constant
--   X-diagram at A.
open Base ; open HigherCat ; open Constructions ; open Composition ;

restrict (X : U k) (A T : Ob D) (g : Hom D (tensor X A) T) : X -> Hom D A T =
 \ x -> hcomp {D} (eta X A x) g ;
