-- The computation rule for extending a homotopy along an equivalence.
-- FibreLemmas.equiv-ind constructs an extension using a chosen inverse.
-- Its restriction agrees with the original homotopy, including the path
-- proof itself. By equivalence induction (univalence), it suffices to
-- take the identity equivalence, when the assertion is reflexivity.
-- This rule is needed to compare the chosen hcomp-assoc on a simplex
-- with the explicit OnSpine construction used to define it.
open Base ;
module Pl = Prelude[l] ;
module UL = Axioms[l].UnivalenceLemmas[univ @l] ;
open FibreLemmas ;

rule (A B : U l) (e : Pl.Equiv A B) (Q : B -> U l) (s t : (b : B) -> Q b)
 (h : (a : A) -> Id (Q (e.1 a)) (s (e.1 a)) (t (e.1 a))) (a : A) :
 Id (Id (Q (e.1 a)) (s (e.1 a)) (t (e.1 a)))
  (equiv-ind e.1 e.2 Q s t h (e.1 a)) (h a) =
 UL.eqind A
  (\ B1 e1 -> (Q1 : B1 -> U l) (s1 t1 : (b : B1) -> Q1 b)
   (h1 : (a1 : A) -> Id (Q1 (e1.1 a1)) (s1 (e1.1 a1)) (t1 (e1.1 a1))) (a1 : A) ->
   Id (Id (Q1 (e1.1 a1)) (s1 (e1.1 a1)) (t1 (e1.1 a1)))
    (equiv-ind e1.1 e1.2 Q1 s1 t1 h1 (e1.1 a1)) (h1 a1))
  (\ Q1 s1 t1 h1 a1 -> refl (h1 a1)) B e Q s t h a ;
