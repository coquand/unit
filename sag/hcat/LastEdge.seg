-- The last edge of Delta (n+1) (Agda Simplices/LastEdge): the morphism
-- given by construction 20 from the order (n, top) <= top of Ord (n+1).
-- Its codomain is the constant functor at I1: the monotone map of the
-- top ordinal is constantly 1 (bwd-top), which is the object action of
-- I1 o ! (const-ob: (v o !) o z = v o (! o z) = v o 1 = v).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open Exponentials ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open Construction20 ; open OrdComb ;

ord-top : (n : Nat) -> Ord n = split { zero -> tt ; suc n -> inr tt } ;

last-edge-hom (n : Nat) : Hom (Delta (suc n)) ((construction-20 (suc n)).2.sec (inl (ord-top n))) ((construction-20 (suc n)).2.sec (inr tt)) =
 ord-to-mor-fn (suc n) (inl (ord-top n)) (inr tt) (any-leqOrd-top n (inl (ord-top n))) ;

last-edge (n : Nat) : Mor (Delta (suc n)) = hmor (last-edge-hom n) ;

mt-bwd-top (n : Nat) (z : Ob (Delta n)) :
 Id Two (((monotone-transfer n).2.sec (monotone-ord-bwd n (inr tt))).1 z) one2 =
 bwd-top n ((construction-20 n).1 z) ;

-- a constant functor v o ! acts on objects as v
const-ob (X : Cat) (v : Ob I) (z : Ob X) : Id (Ob I) (Ob-map (comp {X} {One} {I} v (bang X)) z) v =
 H.transH (composeA {One} {X} {One} {I} v (bang X) z)
  (H.transH (ccr {One} {One} {I} v (one-path (comp {One} {X} {One} (bang X) z) (idMap One))) (comp-id-r {One} {I} v)) ;

const-ob-is-I1 (n : Nat) (z : Ob (Delta n)) : Id Two (ob-to-2 (comp {Delta n} {One} {I} I1 (bang (Delta n))) z) one2 =
 H.transH (H.apH I-ob.1 (const-ob (Delta n) I1 z)) (I-ob.2.sec-eq one2) ;

monotone-pair-eq (n : Nat) :
 Id (Monotone (Delta n)) ((monotone-transfer n).2.sec (monotone-ord-bwd n (inr tt)))
  (I-char-comparison (Delta n) (comp {Delta n} {One} {I} I1 (bang (Delta n)))) =
 Pl.Sigma-eq (Ob (Delta n) -> Two) (is-monotone (Delta n))
  ((monotone-transfer n).2.sec (monotone-ord-bwd n (inr tt))).1 (ob-to-2 (comp {Delta n} {One} {I} I1 (bang (Delta n))))
  ((monotone-transfer n).2.sec (monotone-ord-bwd n (inr tt))).2 (I-char-comparison (Delta n) (comp {Delta n} {One} {I} I1 (bang (Delta n)))).2
  (FL.funext (Ob (Delta n)) (\ z -> Two) ((monotone-transfer n).2.sec (monotone-ord-bwd n (inr tt))).1
    (ob-to-2 (comp {Delta n} {One} {I} I1 (bang (Delta n))))
    (\ z -> H.transH (mt-bwd-top n z) (H.symH (const-ob-is-I1 n z))))
  (is-monotone-is-prop (Delta n) (ob-to-2 (comp {Delta n} {One} {I} I1 (bang (Delta n))))) ;

c20-inv-top (n : Nat) :
 Id (Ob (Delta (suc n))) ((construction-20 (suc n)).2.sec (inr tt)) (map-to-ob (Delta n) I (comp {Delta n} {One} {I} I1 (bang (Delta n)))) =
 H.apH (map-to-ob (Delta n) I)
  (H.transH (H.apH (I-char-inverse (Delta n)) (monotone-pair-eq n)) (I-char-linv (Delta n) (comp {Delta n} {One} {I} I1 (bang (Delta n))))) ;

edge-cod (n : Nat) : Id (Ob (Delta (suc n))) (cod (last-edge n)) (map-to-ob (Delta n) I (comp {Delta n} {One} {I} I1 (bang (Delta n)))) =
 H.transH (hcod (last-edge-hom n)) (c20-inv-top n) ;

dom-last-edge (n : Nat) : Id (Ob (Delta (suc n))) (dom (last-edge n)) ((construction-20 (suc n)).2.sec (inl (ord-top n))) =
 hdom (last-edge-hom n) ;
