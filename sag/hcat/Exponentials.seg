-- Exponentials (Wärn Axiom 15, Remark 16; Agda Category/Exponentials and
-- ob-map-equiv of Interval/Interval).  Parameters used: Fun, ev,
-- exp-is-equiv.
--   exp-equiv: Map X (Fun A B) ~ Map (X x A) B.
--   Remark 16: Ob (Fun A B) ~ Map A B.  At X = One the exponential gives
--   Ob (Fun A B) ~ Map (One x A) B, and One x A ~ A by
--   unit-right = <!, 1> : A -> One x A and pi2.  ob-to-map f is the
--   transpose of f composed with unit-right; map-to-ob g is the inverse of
--   the comparison at g o pi2.  Round trip 1: (g o pi2) o unit-right =
--   g o (pi2 o unit-right) = g o 1 = g.  unit-left: unit-right o pi2 = 1, by
--   injectivity of the comparison of the pullback One x A (the first legs
--   lie in Map P One; the second legs are pi2 o (unit-right o pi2) =
--   (pi2 o unit-right) o pi2 = 1 o pi2 = pi2 = pi2 o 1).  Round trip 2 then
--   follows from the retraction law.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open WildCat ; open HigherCat ; open Constructions ; open PullbackCone ; open Pullbacks ; open ExpComparison ;

exp-equiv (A B X : Cat) : Pl.Equiv (Map X (Fun A B)) (Map (times X A) B) =
 (exp-comparison A B X, exp-is-equiv A B X) ;

unit-right (A : Cat) : Map A (times One A) = pair (bang A) (idMap A) ;

ob-to-map (A B : Cat) (f : Ob (Fun A B)) : Map A B = comp (exp-comparison A B One f) (unit-right A) ;

map-to-ob (A B : Cat) (g : Map A B) : Ob (Fun A B) = (exp-is-equiv A B One).sec (comp g (pi2 One A)) ;

ob-map-roundtrip1 (A B : Cat) (g : Map A B) : Id (Map A B) (ob-to-map A B (map-to-ob A B g)) g =
 H.transH (ccl (unit-right A) ((exp-is-equiv A B One).sec-eq (comp g (pi2 One A))))
  (H.transH (composeA g (pi2 One A) (unit-right A))
   (H.transH (ccr g (pair-beta2 (bang A) (idMap A))) (comp-id-r g))) ;

unit-left (A : Cat) : Id (Map (times One A) (times One A)) (comp (unit-right A) (pi2 One A)) (idMap (times One A)) =
 Equivalences[l].injective (Map (times One A) (times One A)) (Cone (bang One) (bang A) (times One A))
  (pb-comparison (bang One) (bang A) (times One A)) (pb-is-equiv (bang One) (bang A) (times One A))
  (comp (unit-right A) (pi2 One A)) (idMap (times One A))
  (cone-eq (comp (pi1 One A) (comp (unit-right A) (pi2 One A))) (comp (pi2 One A) (comp (unit-right A) (pi2 One A)))
   (pb-comparison (bang One) (bang A) (times One A) (comp (unit-right A) (pi2 One A))).2.2
   (comp (pi1 One A) (idMap (times One A)))
   (one-path (comp (pi1 One A) (comp (unit-right A) (pi2 One A))) (comp (pi1 One A) (idMap (times One A))))
   (comp (pi2 One A) (idMap (times One A)))
   (H.transH (comp-assoc (pi2 One A) (unit-right A) (pi2 One A))
    (H.transH (ccl (pi2 One A) (pair-beta2 (bang A) (idMap A)))
     (H.transH (comp-id-l (pi2 One A)) (H.symH (comp-id-r (pi2 One A))))))
   (pb-comparison (bang One) (bang A) (times One A) (idMap (times One A))).2.2) ;

ob-map-roundtrip2 (A B : Cat) (f : Ob (Fun A B)) : Id (Ob (Fun A B)) (map-to-ob A B (ob-to-map A B f)) f =
 H.transH (H.apH (exp-is-equiv A B One).sec
   (H.transH (composeA (exp-comparison A B One f) (unit-right A) (pi2 One A))
    (H.transH (ccr (exp-comparison A B One f) (unit-left A)) (comp-id-r (exp-comparison A B One f)))))
  (Pl.sec-ret (Map One (Fun A B)) (Map (times One A) B) (exp-comparison A B One) (exp-is-equiv A B One) f) ;

ob-map-equiv (A B : Cat) : Pl.Equiv (Ob (Fun A B)) (Map A B) =
 (ob-to-map A B, Pl.qinv (Ob (Fun A B)) (Map A B) (ob-to-map A B) (map-to-ob A B)
   (ob-map-roundtrip1 A B) (ob-map-roundtrip2 A B)) ;
