-- Lemma 26 (Agda Pushout.agda §9-§10; Rocq S_step, S_pushout): for every
-- n, the square gluing Delta 1 to Delta n along a vertex,
--        One ---v0---> Delta 1
--         |              |
--      top n          lastedge n
--         v              v
--      Delta n --face--> Delta (n+1)
-- is a pushout.  Level 2 (Coh2).
--   Base case n = 1: base-Sq1 (SegalGeom, from segal-is-equiv).
--   Step: Sq (n+2) is a retract of Sq (n+1) x I (retract-SSk); Sq (n+1) x I
--   is a pushout when Sq (n+1) is (times-I-preserves); and a retract of a
--   pushout square is one (is-pushout-square-retract), whose set
--   hypotheses hold since the corners are simplices or I, which are
--   posetal, and Map One (Delta (n+1) x I) is a product of sets.
--   The induction is primitive recursion on n.
open Base ;
open Squares ; open GluingSquare ; open Interval ; open PosetalCore ; open FunIPosetal ;
open ProdHomSet ; open SquareGeom ; open SegalGeom ; open TimesI ; open PushoutRetract ;

S-step (n : Nat) (h : is-pushout-square (Sq (suc n))) : is-pushout-square (Sq (suc (suc n))) =
 Retract[Sq (suc (suc n)), times-I (Sq (suc n)), retract-SSk n,
  posetal-hom-is-set One (Delta (suc zero)) (Delta-posetal (suc zero)),
  posetal-hom-is-set One (Delta (suc (suc n))) (Delta-posetal (suc (suc n))),
  posetal-hom-is-set (Delta (suc zero)) (Delta (suc (suc (suc n)))) (Delta-posetal (suc (suc (suc n)))),
  posetal-hom-is-set (Delta (suc (suc n))) (Delta (suc (suc (suc n)))) (Delta-posetal (suc (suc (suc n)))),
  posetal-hom-is-set (Pullbacks.times One I) (Delta (suc (suc (suc n)))) (Delta-posetal (suc (suc (suc n)))),
  prod-hom-is-set One (Delta (suc (suc n))) I
   (posetal-hom-is-set One (Delta (suc (suc n))) (Delta-posetal (suc (suc n))))
   (posetal-hom-is-set One I I-posetal)]
 .is-pushout-square-retract (times-I-preserves h) ;

S-pushout : (n : Nat) -> is-pushout-square (Sq (suc n)) = split {
 zero -> base-Sq1 ;
 suc n | r -> S-step n r } ;

lemma26-square (n : Nat) : is-pushout-square (Sq (suc n)) = S-pushout n ;
