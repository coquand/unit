-- Normal form of the existing Hom-map-of-comp, for arbitrary endpoints.
-- At endpoint v of m, with p : m v = a, its source endpoint path is
--   (a(FG,m,v) . FG(p)) . a(F,G,a),
-- and its target endpoint path after the morphism reassociator is
--   (a(F,G,m) v) . (a(F,Gm,v) . F(a(G,m,v) . G(p))).
-- The comparison is obtained by J on p; at refl it is the pentagon
-- followed by path reassociation, exactly as in HomFunctor.
-- Normal.form identifies the ORIGINAL proof with Hom-eq using these
-- endpoint cells. Its proof is J on the two endpoint paths, with refl
-- as base. This allows nested applications to be compared without
-- unfolding the definition of Hom-map-of-comp in later proofs.
-- Endpoint.cell-explicit further removes that J: its formula uses the
-- base pentagon, compose-naturality3, and the action of F on paths.
-- Normal.form-explicit relates this formula to the original proof.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open HomPaths ; open HomFunctor ;
open Naturality ;

-- The unit inserted between two paths cancels coherently. This is the
-- reflexive case of source-adjust below, including the double inverse
-- contributed by the orientation of compose-naturality3.
unit-frame {Z : U l} {x y z : Z} (a : Id Z x y) (b : Id Z y z) :
 Id (Id (Id Z x z) (H.transH a b) (H.transH a b))
  (H.transH (PA.tassoc a (refl y) b)
   (H.apH (\ r -> H.transH a r) (H.symH (H.symH (PA.unit-l b))))) (refl (H.transH a b)) =
 idJ Z y (\ z1 b1 -> Id (Id (Id Z x z1) (H.transH a b1) (H.transH a b1))
   (H.transH (PA.tassoc a (refl y) b1)
    (H.apH (\ r -> H.transH a r) (H.symH (H.symH (PA.unit-l b1))))) (refl (H.transH a b1)))
  (refl (refl a)) z b ;

module Endpoint (A B C : Cat) (F : Map B C) (G : Map A B) (m : Mor A) (v : Ob I) {
 start (a : Ob A) (p : Id (Ob A) (comp {One} {I} {A} m v) a) :
  Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a)) =
  H.transH (H.transH (composeA {One} {I} {A} {C} (comp F G) m v) (ccr {One} {A} {C} (comp F G) p))
   (composeA {One} {A} {B} {C} F G a) ;

 finish (a : Ob A) (p : Id (Ob A) (comp {One} {I} {A} m v) a) :
  Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a)) =
  H.transH (ccl {One} {I} {C} v (composeA {I} {A} {B} {C} F G m))
   (H.transH (composeA {One} {I} {B} {C} F (comp G m) v)
    (ccr {One} {B} {C} F (H.transH (composeA {One} {I} {A} {B} G m v) (ccr {One} {A} {B} G p)))) ;

 cell (a : Ob A) (p : Id (Ob A) (comp {One} {I} {A} m v) a) :
  Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a))) (start a p) (finish a p) =
  idJ (Ob A) (comp {One} {I} {A} m v)
   (\ a1 p1 -> Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a1))) (start a1 p1) (finish a1 p1))
   (H.transH (pentagonator {One} {I} {A} {B} {C} F G m v)
    (PA.tassoc (ccl {One} {I} {C} v (composeA {I} {A} {B} {C} F G m))
     (composeA {One} {I} {B} {C} F (comp G m) v) (ccr {One} {B} {C} F (composeA {One} {I} {A} {B} G m v)))) a p ;

 -- Explicit normal form: move the endpoint path across the vertex
 -- associator by naturality, apply the base pentagon, then distribute F.
 av : Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp (comp F G) (comp {One} {I} {A} m v)) =
  composeA {One} {I} {A} {C} (comp F G) m v ;
 bv : Id (Ob C) (comp (comp F G) (comp {One} {I} {A} m v)) (comp F (comp G (comp {One} {I} {A} m v))) =
  composeA {One} {A} {B} {C} F G (comp {One} {I} {A} m v) ;
 lead : Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp {One} {I} {C} (comp F (comp G m)) v) =
  ccl {One} {I} {C} v (composeA {I} {A} {B} {C} F G m) ;
 mid : Id (Ob C) (comp {One} {I} {C} (comp F (comp G m)) v) (comp F (comp {One} {I} {B} (comp G m) v)) =
  composeA {One} {I} {B} {C} F (comp G m) v ;
 tail : Id (Ob B) (comp {One} {I} {B} (comp G m) v) (comp G (comp {One} {I} {A} m v)) =
  composeA {One} {I} {A} {B} G m v ;

 source-adjust (a : Ob A) (p : Id (Ob A) (comp {One} {I} {A} m v) a) :
  Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a)))
   (start a p) (H.transH (H.transH av bv) (ccr {One} {B} {C} F (ccr {One} {A} {B} G p))) =
  H.transH (PA.tassoc av (ccr {One} {A} {C} (comp F G) p) (composeA {One} {A} {B} {C} F G a))
   (H.transH (H.apH (\ r -> H.transH av r) (H.symH (compose-naturality3 {One} {A} {B} {C} F G p)))
    (H.symH (PA.tassoc av bv (ccr {One} {B} {C} F (ccr {One} {A} {B} G p))))) ;

 source-refl : Id (Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v)
   (comp F (comp G (comp {One} {I} {A} m v)))) (H.transH av bv) (H.transH av bv))
  (source-adjust (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v))) (refl (H.transH av bv)) = unit-frame av bv ;

 target-adjust (a : Ob A) (p : Id (Ob A) (comp {One} {I} {A} m v) a) :
  Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a)))
   (H.transH (H.transH lead (H.transH mid (ccr {One} {B} {C} F tail))) (ccr {One} {B} {C} F (ccr {One} {A} {B} G p))) (finish a p) =
  H.transH (PA.tassoc lead (H.transH mid (ccr {One} {B} {C} F tail)) (ccr {One} {B} {C} F (ccr {One} {A} {B} G p)))
   (H.transH (H.apH (\ r -> H.transH lead r) (PA.tassoc mid (ccr {One} {B} {C} F tail) (ccr {One} {B} {C} F (ccr {One} {A} {B} G p))))
    (H.apH (\ r -> H.transH lead (H.transH mid r)) (H.symH (PA.ap-trans (Ob-map F) tail (ccr {One} {A} {B} G p))))) ;

 explicit (a : Ob A) (p : Id (Ob A) (comp {One} {I} {A} m v) a) :
  Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a))) (start a p) (finish a p) =
  H.transH (source-adjust a p)
   (H.transH (H.apH (\ r -> H.transH r (ccr {One} {B} {C} F (ccr {One} {A} {B} G p)))
     (cell (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v)))) (target-adjust a p)) ;

 explicit-refl : Id (Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v)
   (comp F (comp G (comp {One} {I} {A} m v)))) (start (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v)))
   (finish (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v))))
  (explicit (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v)))
  (cell (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v))) =
  H.transH (H.apH (\ r -> H.transH r (H.apH (\ z -> z) (cell (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v))))) source-refl)
   (H.transH (PA.unit-l (H.apH (\ z -> z) (cell (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v)))))
    (PA.ap-id (cell (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v))))) ;

 cell-explicit (a : Ob A) (p : Id (Ob A) (comp {One} {I} {A} m v) a) :
  Id (Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a))) (start a p) (finish a p))
   (cell a p) (explicit a p) =
  idJ (Ob A) (comp {One} {I} {A} m v)
   (\ a1 p1 -> Id (Id (Id (Ob C) (comp {One} {I} {C} (comp {I} {A} {C} (comp F G) m) v) (comp F (comp G a1)))
    (start a1 p1) (finish a1 p1)) (cell a1 p1) (explicit a1 p1))
   (H.symH explicit-refl) a p ;
} ;

module Normal (A B C : Cat) (F : Map B C) (G : Map A B) (m : Mor A) {
 module E0 = Endpoint[A, B, C, F, G, m, I0] ;
 module E1 = Endpoint[A, B, C, F, G, m, I1] ;

 source (a b : Ob A) (p : Id (Ob A) (dom m) a) (q : Id (Ob A) (cod m) b) :
  Hom C (Ob-map F (Ob-map G a)) (Ob-map F (Ob-map G b)) =
  Hom-coerce C (composeA {One} {A} {B} {C} F G a) (composeA {One} {A} {B} {C} F G b)
   (Hom-map (comp F G) a b (m, p, q)) ;

 target (a b : Ob A) (p : Id (Ob A) (dom m) a) (q : Id (Ob A) (cod m) b) :
  Hom C (Ob-map F (Ob-map G a)) (Ob-map F (Ob-map G b)) =
  Hom-map F (Ob-map G a) (Ob-map G b) (Hom-map G a b (m, p, q)) ;

 expanded (a b : Ob A) (p : Id (Ob A) (dom m) a) (q : Id (Ob A) (cod m) b) :
  Id (Hom C (Ob-map F (Ob-map G a)) (Ob-map F (Ob-map G b))) (source a b p q) (target a b p q) =
  Hom-eq C (source a b p q) (target a b p q) (composeA {I} {A} {B} {C} F G m) (E0.cell a p) (E1.cell b q) ;

 motive (a : Ob A) (p : Id (Ob A) (dom m) a) (b : Ob A) (q : Id (Ob A) (cod m) b) : U l =
  Id (Id (Hom C (Ob-map F (Ob-map G a)) (Ob-map F (Ob-map G b))) (source a b p q) (target a b p q))
   (Hom-map-of-comp F G a b (m, p, q)) (expanded a b p q) ;

 form (a : Ob A) (p : Id (Ob A) (dom m) a) (b : Ob A) (q : Id (Ob A) (cod m) b) : motive a p b q =
  idJ (Ob A) (dom m) (\ a1 p1 -> (b1 : Ob A) (q1 : Id (Ob A) (cod m) b1) -> motive a1 p1 b1 q1)
   (\ b1 q1 -> idJ (Ob A) (cod m) (\ b2 q2 -> motive (dom m) (refl (dom m)) b2 q2)
    (refl (Hom-map-of-comp F G (dom m) (cod m) (m, refl (dom m), refl (cod m)))) b1 q1)
   a p b q ;

 form-explicit (a : Ob A) (p : Id (Ob A) (dom m) a) (b : Ob A) (q : Id (Ob A) (cod m) b) :
  Id (Id (Hom C (Ob-map F (Ob-map G a)) (Ob-map F (Ob-map G b))) (source a b p q) (target a b p q))
   (Hom-map-of-comp F G a b (m, p, q))
   (Hom-eq C (source a b p q) (target a b p q) (composeA {I} {A} {B} {C} F G m) (E0.explicit a p) (E1.explicit b q)) =
  H.transH (form a p b q)
   (HomEqHigher.Compare[C, Ob-map F (Ob-map G a), Ob-map F (Ob-map G b), source a b p q, target a b p q].ends
    (composeA {I} {A} {B} {C} F G m) (E0.cell a p) (E0.explicit a p) (E1.cell b q) (E1.explicit b q)
    (E0.cell-explicit a p) (E1.cell-explicit b q)) ;
} ;
