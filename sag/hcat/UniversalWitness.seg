-- Coherence of universal witnesses in ordinary dependent type theory.
-- A witness is a point of a fibre of an equivalence, including its beta
-- path. Such fibres are contractible. More generally, dependent families
-- of contractible choices have a contractible type of sections (funext).
-- Paths with fixed endpoints in a contractible type are contractible:
-- pathC supplies a centre, and prop-to-set supplies its contraction.
-- Reapplying paths proves the same assertion at every finite path level.
-- Thus comparisons, triangles, and higher comparisons of witnesses are
-- unique. This does not make the underlying maps or their paths unique
-- after the universal-property witnesses have been forgotten.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module CU = FunExtUA[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
open FibreLemmas ;

paths (A : U l) (c : CU.isContr A) (x y : A) : CU.isContr (Id A x y) =
 (CU.pathC A c x y, \ p -> Pl.prop-to-set A (CU.pathC A c) x y (CU.pathC A c x y) p) ;

sections (S : U l) (P : S -> U l) (c : (s : S) -> CU.isContr (P s)) : CU.isContr ((s : S) -> P s) =
 (\ s -> (c s).1, \ t -> FE.funext S P (\ s -> (c s).1) t (\ s -> (c s).2 (t s))) ;

-- A finite globular boundary is encoded together with its cell family.
-- In dimension zero the boundary is empty and a cell is a point of A.
-- A successor boundary is a boundary together with two parallel cells;
-- its cells are paths between those cells. This uses only Nat, Sigma,
-- and identity types, without an infinitely coherent record type.
globes (A : U l) : Nat -> (B : U l) * (B -> U l) = split {
 zero -> (Top, \ b -> A) ;
 suc n | r -> ((b : r.1) * (r.2 b) * (r.2 b), \ b -> Id (r.2 b.1) b.2.1 b.2.2) } ;

globes-contr (A : U l) (c : CU.isContr A) :
 (n : Nat) (b : (globes A n).1) -> CU.isContr ((globes A n).2 b) = split {
 zero -> \ b -> c ;
 suc n | r -> \ b -> paths ((globes A n).2 b.1) (r b.1) b.2.1 b.2.2 } ;

module Witness (A B : U l) (e : Pl.Equiv A B) (b : B) {
 contractible : CU.isContr (fib e.1 b) = equiv-fibre-contr A B e.1 e.2 b ;

 compare (u v : fib e.1 b) : Id (fib e.1 b) u v = CU.pathC (fib e.1 b) contractible u v ;

 compare-unique (u v : fib e.1 b) (p q : Id (fib e.1 b) u v) : Id (Id (fib e.1 b) u v) p q =
  CU.pathC (Id (fib e.1 b) u v) (paths (fib e.1 b) contractible u v) p q ;

 triangle (u v w : fib e.1 b) :
  Id (Id (fib e.1 b) u w) (H.transH (compare u v) (compare v w)) (compare u w) =
  compare-unique u w (H.transH (compare u v) (compare v w)) (compare u w) ;

 coherence (n : Nat) (boundary : (globes (fib e.1 b) n).1) :
  CU.isContr ((globes (fib e.1 b) n).2 boundary) =
  globes-contr (fib e.1 b) contractible n boundary ;
} ;

-- Prescribing the image of a path gives another universal witness.
-- Its contractibility includes uniqueness of the beta 2-cell, not just
-- existence of a path upstairs. Iterate this construction for higher cells.
path-lifts (A B : U l) (e : Pl.Equiv A B) (x y : A) (q : Id B (e.1 x) (e.1 y)) :
 CU.isContr ((p : Id A x y) * Id (Id B (e.1 x) (e.1 y)) (H.apH e.1 p) q) =
 equiv-fibre-contr (Id A x y) (Id B (e.1 x) (e.1 y)) (\ p -> H.apH e.1 p)
  (EquivAp[l].ap-equiv A B e x y) q ;
