-- Moving the endpoints of a Hom-eq path.
-- If ep : p1 = al(v) . p2, appending a vertex path r gives
--   p1 . r = (al(v) . p2) . r = al(v) . (p2 . r).
-- Applying Hom-coerce to Hom-eq is Hom-eq with these endpoint cells.
-- The proof is J on the two new vertex paths. At refl it uses ap-id
-- for the Hom path and for its two endpoint witnesses.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open HomPaths ;

append {Z : U l} {a b c d : Z} (al : Id Z a b) (p : Id Z a c) (q : Id Z b c)
 (ep : Id (Id Z a c) p (H.transH al q)) (r : Id Z c d) :
 Id (Id Z a d) (H.transH p r) (H.transH al (H.transH q r)) =
 H.transH (H.apH (\ t -> H.transH t r) ep) (PA.tassoc al q r) ;

module Coerce (C : Cat) (x y : Ob C) (h1 h2 : Hom C x y) (al : Id (Mor C) (hmor h1) (hmor h2))
 (ep : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (H.transH (ccl {One} {I} {C} I0 al) (hdom h2)))
 (eq : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (H.transH (ccl {One} {I} {C} I1 al) (hcod h2))) {
 moved (x1 : Ob C) (p : Id (Ob C) x x1) (y1 : Ob C) (q : Id (Ob C) y y1) :
  Id (Hom C x1 y1) (Hom-coerce C p q h1) (Hom-coerce C p q h2) =
  Hom-eq C {x1} {y1} (Hom-coerce C p q h1) (Hom-coerce C p q h2) al
   (append (ccl {One} {I} {C} I0 al) (hdom h1) (hdom h2) ep p)
   (append (ccl {One} {I} {C} I1 al) (hcod h1) (hcod h2) eq q) ;

 motive (x1 : Ob C) (p : Id (Ob C) x x1) (y1 : Ob C) (q : Id (Ob C) y y1) : U l =
  Id (Id (Hom C x1 y1) (Hom-coerce C p q h1) (Hom-coerce C p q h2))
   (H.apH (Hom-coerce C p q) (Hom-eq C h1 h2 al ep eq)) (moved x1 p y1 q) ;

 at-refl : motive x (refl x) y (refl y) =
  H.transH (PA.ap-id (Hom-eq C h1 h2 al ep eq))
   (HomEqHigher.Compare[C, x, y, h1, h2].ends al ep (H.apH (\ t -> t) ep) eq (H.apH (\ t -> t) eq)
    (H.symH (PA.ap-id ep)) (H.symH (PA.ap-id eq))) ;

 naturality (x1 : Ob C) (p : Id (Ob C) x x1) (y1 : Ob C) (q : Id (Ob C) y y1) : motive x1 p y1 q =
  idJ (Ob C) x (\ x2 p2 -> (y2 : Ob C) (q2 : Id (Ob C) y y2) -> motive x2 p2 y2 q2)
   (\ y2 q2 -> idJ (Ob C) y (\ y3 q3 -> motive x (refl x) y3 q3) at-refl y2 q2) x1 p y1 q ;
} ;
