-- The Mayer-Vietoris sequence (H5): exactness at the middle term, the
-- connecting map, and exactness at H(C), for a pushout square of D, then
-- for the square of copowers of a pushout of types (excision).
--   For a pushout square ii uu = jj vv in D and S : Ob D, stability makes
--   Hom (S, -) of it a pullback: pull, Hom (S, Cc) ~ Cone S.  On components
--   (Pi0) write i_*, j_*, u_*, v_* for postcomposition.
--   mv-square: u_* i_* = v_* j_*  (cone-path).
--   exact-mid: if u_* b = v_* e then merely b = i_* c and e = j_* c for
--   some c.  Proof: u_* b = v_* e merely gives p : b uu = e vv, and
--   c = pull^-1 (b, e, p) has c ii = b, c jj = e (sec-eq of pull).
--   delta g, for g : Sigma S -> P: the cone (0, 0, zp uu . L g . zp vv^-1)
--   sent back by pull (L the loop equivalence, zp = zero-post).
--   delta-zero: i_* (delta g) = 0 and j_* (delta g) = 0 (sec-eq of pull).
--   exact-c: if i_* c = 0 and j_* c = 0 then merely c = delta g for some
--   g.  Proof: with p : c ii = 0, q : c jj = 0, the cone of c is
--   (0, 0, pi), pi = (p uu)^-1 . cone-path c . q vv (cone-move); put
--   g = L^-1 (zp uu^-1 . pi . zp vv); then the cone of delta g is the cone
--   of c (unconj-conj), and pull is injective.
--   Excision: for a pushout of types and A the square of copowers is a
--   pushout in D (ExcisionOf.excision); with S = Sph n this is
--     H_(n+1)(X) -delta-> H_n(C) -(i,j)-> H_n(B) x H_n(E) -(u,-v)-> H_n(X).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ; open DPushout ;
open Zero ; open Cone ; open Loops ; open Pi0[l] ;

-- moving the legs of a cone along paths (J on p, then on q)
cone-move {S Bb Ee P : Ob D} (uu : Hom D Bb P) (vv : Hom D Ee P) (b b1 : Hom D S Bb) (p : Id (Hom D S Bb) b b1)
 (e e1 : Hom D S Ee) (q : Id (Hom D S Ee) e e1) (pi : Id (Hom D S P) (hcomp {D} b uu) (hcomp {D} e vv)) :
 Id ((b2 : Hom D S Bb) * (e2 : Hom D S Ee) * Id (Hom D S P) (hcomp {D} b2 uu) (hcomp {D} e2 vv))
  (b, e, pi) (b1, e1, H.transH (H.symH (H.apH (\ w -> hcomp {D} w uu) p)) (H.transH pi (H.apH (\ w -> hcomp {D} w vv) q))) =
 idJ (Hom D S Bb) b (\ b2 p2 -> Id ((b3 : Hom D S Bb) * (e3 : Hom D S Ee) * Id (Hom D S P) (hcomp {D} b3 uu) (hcomp {D} e3 vv))
    (b, e, pi) (b2, e1, H.transH (H.symH (H.apH (\ w -> hcomp {D} w uu) p2)) (H.transH pi (H.apH (\ w -> hcomp {D} w vv) q))))
  (idJ (Hom D S Ee) e (\ e2 q2 -> Id ((b3 : Hom D S Bb) * (e3 : Hom D S Ee) * Id (Hom D S P) (hcomp {D} b3 uu) (hcomp {D} e3 vv))
      (b, e, pi) (b, e2, H.transH (refl (hcomp {D} b uu)) (H.transH pi (H.apH (\ w -> hcomp {D} w vv) q2))))
    (H.symH (H.apH (\ t -> (b, e, t)) (PA.unit-l pi))) e1 q) b1 p ;

module MV (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee) (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv)) (po : DSquare[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pushout)
 (S : Ob D) {
 module C = DCone[Cc, Bb, Ee, P, ii, jj, uu, vv, ss] ;
 pull : Pl.isEquiv (Hom D S Cc) (C.Cone S) (C.cone-map S) = stable Cc Bb Ee P ii jj uu vv ss po S ;

 post {T T1 : Ob D} (f : Hom D T T1) (q : pi0 (Hom D S T)) : pi0 (Hom D S T1) = pi0-map (Hom D S T) (Hom D S T1) (\ c -> hcomp {D} c f) q ;
 post-cls {T T1 : Ob D} (f : Hom D T T1) (c : Hom D S T) : Id (pi0 (Hom D S T1)) (post f (cls c)) (cls (hcomp {D} c f)) =
  pi0-map-cls (Hom D S T) (Hom D S T1) (\ c1 -> hcomp {D} c1 f) c ;
 zero-cls (T : Ob D) : pi0 (Hom D S T) = cls (zmap S T) ;

 mv-square (q : pi0 (Hom D S Cc)) : Id (pi0 (Hom D S P)) (post uu (post ii q)) (post vv (post jj q)) =
  pi0-ind (Hom D S Cc) @l (\ q1 -> Id (pi0 (Hom D S P)) (post uu (post ii q1)) (post vv (post jj q1)))
   (\ q1 -> pi0-set (Hom D S P) (post uu (post ii q1)) (post vv (post jj q1)))
   (\ c -> H.transH (H.apH (post uu) (post-cls ii c))
     (H.transH (post-cls uu (hcomp {D} c ii))
      (H.transH (H.apH (\ t -> cls t) (C.cone-path S c))
       (H.symH (H.transH (H.apH (post vv) (post-cls jj c)) (post-cls vv (hcomp {D} c jj))))))) q ;

 -- exactness at the middle term, on representatives
 Lift (b : Hom D S Bb) (e : Hom D S Ee) : U l =
  (c : Hom D S Cc) * Id (Hom D S Bb) (hcomp {D} c ii) b * Id (Hom D S Ee) (hcomp {D} c jj) e ;
 lift (b : Hom D S Bb) (e : Hom D S Ee) (p : Id (Hom D S P) (hcomp {D} b uu) (hcomp {D} e vv)) : Lift b e =
  (pull.sec (b, e, p),
   H.apH (\ w -> w.1) (pull.sec-eq (b, e, p)),
   H.apH (\ w -> w.2.1) (pull.sec-eq (b, e, p))) ;

 Lift0 (b0 : pi0 (Hom D S Bb)) (e0 : pi0 (Hom D S Ee)) : U l =
  Tr.Trunc[(q : pi0 (Hom D S Cc)) * Id (pi0 (Hom D S Bb)) (post ii q) b0 * Id (pi0 (Hom D S Ee)) (post jj q) e0].carrier ;
 lift0-prop (b0 : pi0 (Hom D S Bb)) (e0 : pi0 (Hom D S Ee)) : Pl.isProp (Lift0 b0 e0) =
  Tr.Trunc[(q : pi0 (Hom D S Cc)) * Id (pi0 (Hom D S Bb)) (post ii q) b0 * Id (pi0 (Hom D S Ee)) (post jj q) e0].proposition ;
 lift-cls (b : Hom D S Bb) (e : Hom D S Ee) (w : Lift b e) : Lift0 (cls b) (cls e) =
  Tr.Trunc[(q : pi0 (Hom D S Cc)) * Id (pi0 (Hom D S Bb)) (post ii q) (cls b) * Id (pi0 (Hom D S Ee)) (post jj q) (cls e)].inc
   (cls w.1, H.transH (post-cls ii w.1) (H.apH (\ t -> cls t) w.2.1), H.transH (post-cls jj w.1) (H.apH (\ t -> cls t) w.2.2)) ;

 exact-mid-rep (b : Hom D S Bb) (e : Hom D S Ee) (h : Id (pi0 (Hom D S P)) (cls (hcomp {D} b uu)) (cls (hcomp {D} e vv))) :
  Lift0 (cls b) (cls e) =
  TC.rec (Id (Hom D S P) (hcomp {D} b uu) (hcomp {D} e vv)) @l (Lift0 (cls b) (cls e)) (lift0-prop (cls b) (cls e))
   (\ p -> lift-cls b e (lift b e p)) (pi0-eff (Hom D S P) (hcomp {D} b uu) (hcomp {D} e vv) h) ;

 -- exactness at the middle term: the kernel of (u_*, v_*) is the image of (i_*, j_*)
 exact-mid (b0 : pi0 (Hom D S Bb)) (e0 : pi0 (Hom D S Ee)) (h : Id (pi0 (Hom D S P)) (post uu b0) (post vv e0)) : Lift0 b0 e0 =
  pi0-ind (Hom D S Bb) @l (\ b1 -> (e1 : pi0 (Hom D S Ee)) -> Id (pi0 (Hom D S P)) (post uu b1) (post vv e1) -> Lift0 b1 e1)
   (\ b1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (pi0 (Hom D S Ee)) (\ e1 -> Id (pi0 (Hom D S P)) (post uu b1) (post vv e1) -> Lift0 b1 e1)
     (\ e1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id (pi0 (Hom D S P)) (post uu b1) (post vv e1)) (\ h1 -> Lift0 b1 e1) (\ h1 -> lift0-prop b1 e1)))
   (\ b -> pi0-ind (Hom D S Ee) @l (\ e1 -> Id (pi0 (Hom D S P)) (post uu (cls b)) (post vv e1) -> Lift0 (cls b) e1)
     (\ e1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id (pi0 (Hom D S P)) (post uu (cls b)) (post vv e1)) (\ h1 -> Lift0 (cls b) e1) (\ h1 -> lift0-prop (cls b) e1))
     (\ e h1 -> exact-mid-rep b e (H.transH (H.symH (post-cls uu b)) (H.transH h1 (post-cls vv e))))) b0 e0 h ;

 ------------------------------------------------------------------------
 -- the connecting map

 delta-cone (g : Hom D (susp S) P) : C.Cone S =
  (zmap S Bb, zmap S Ee, H.transH (zero-post S uu) (H.transH (LoopOf[S].L P g) (H.symH (zero-post S vv)))) ;
 delta (g : Hom D (susp S) P) : Hom D S Cc = pull.sec (delta-cone g) ;
 delta0 (q : pi0 (Hom D (susp S) P)) : pi0 (Hom D S Cc) = pi0-map (Hom D (susp S) P) (Hom D S Cc) delta q ;

 delta-i (g : Hom D (susp S) P) : Id (Hom D S Bb) (hcomp {D} (delta g) ii) (zmap S Bb) = H.apH (\ w -> w.1) (pull.sec-eq (delta-cone g)) ;
 delta-j (g : Hom D (susp S) P) : Id (Hom D S Ee) (hcomp {D} (delta g) jj) (zmap S Ee) = H.apH (\ w -> w.2.1) (pull.sec-eq (delta-cone g)) ;

 -- i_* o delta = 0 and j_* o delta = 0
 delta-zero (q : pi0 (Hom D (susp S) P)) :
  Id (pi0 (Hom D S Bb)) (post ii (delta0 q)) (zero-cls Bb) * Id (pi0 (Hom D S Ee)) (post jj (delta0 q)) (zero-cls Ee) =
  pi0-ind (Hom D (susp S) P) @l (\ q1 -> Id (pi0 (Hom D S Bb)) (post ii (delta0 q1)) (zero-cls Bb) * Id (pi0 (Hom D S Ee)) (post jj (delta0 q1)) (zero-cls Ee))
   (\ q1 -> Pl.isProp-Sigma (Id (pi0 (Hom D S Bb)) (post ii (delta0 q1)) (zero-cls Bb)) (\ t -> Id (pi0 (Hom D S Ee)) (post jj (delta0 q1)) (zero-cls Ee))
     (pi0-set (Hom D S Bb) (post ii (delta0 q1)) (zero-cls Bb)) (\ t -> pi0-set (Hom D S Ee) (post jj (delta0 q1)) (zero-cls Ee)))
   (\ g -> (H.transH (H.apH (post ii) (pi0-map-cls (Hom D (susp S) P) (Hom D S Cc) delta g)) (H.transH (post-cls ii (delta g)) (H.apH (\ t -> cls t) (delta-i g))),
            H.transH (H.apH (post jj) (pi0-map-cls (Hom D (susp S) P) (Hom D S Cc) delta g)) (H.transH (post-cls jj (delta g)) (H.apH (\ t -> cls t) (delta-j g))))) q ;

 -- exactness at H(C), on representatives: a map killed by ii and jj is delta of a map
 ker-path (c : Hom D S Cc) (p : Id (Hom D S Bb) (hcomp {D} c ii) (zmap S Bb)) (r : Id (Hom D S Ee) (hcomp {D} c jj) (zmap S Ee)) :
  Id (Hom D S P) (hcomp {D} (zmap S Bb) uu) (hcomp {D} (zmap S Ee) vv) =
  H.transH (H.symH (H.apH (\ w -> hcomp {D} w uu) p)) (H.transH (C.cone-path S c) (H.apH (\ w -> hcomp {D} w vv) r)) ;

 ker-loop (c : Hom D S Cc) (p : Id (Hom D S Bb) (hcomp {D} c ii) (zmap S Bb)) (r : Id (Hom D S Ee) (hcomp {D} c jj) (zmap S Ee)) :
  Id (Hom D S P) (zmap S P) (zmap S P) =
  H.transH (H.symH (zero-post S uu)) (H.transH (ker-path c p r) (zero-post S vv)) ;

 ker-cone (c : Hom D S Cc) (p : Id (Hom D S Bb) (hcomp {D} c ii) (zmap S Bb)) (r : Id (Hom D S Ee) (hcomp {D} c jj) (zmap S Ee)) :
  Id (C.Cone S) (delta-cone ((LoopOf[S].L-equiv P).sec (ker-loop c p r))) (C.cone-map S c) =
  calc (C.Cone S) {
   delta-cone ((LoopOf[S].L-equiv P).sec (ker-loop c p r))
   =< H.apH {Id (Hom D S P) (zmap S P) (zmap S P)} {C.Cone S}
       (\ t -> (zmap S Bb, zmap S Ee, H.transH (zero-post S uu) (H.transH t (H.symH (zero-post S vv)))))
       ((LoopOf[S].L-equiv P).sec-eq (ker-loop c p r)) >
     (zmap S Bb, zmap S Ee, H.transH (zero-post S uu) (H.transH (ker-loop c p r) (H.symH (zero-post S vv))))
   =< H.apH {Id (Hom D S P) (hcomp {D} (zmap S Bb) uu) (hcomp {D} (zmap S Ee) vv)} {C.Cone S} (\ t -> (zmap S Bb, zmap S Ee, t))
       (unconj-conj (zero-post S uu) (zero-post S vv) (ker-path c p r)) >
     (zmap S Bb, zmap S Ee, ker-path c p r)
   =< H.symH (cone-move uu vv (hcomp {D} c ii) (zmap S Bb) p (hcomp {D} c jj) (zmap S Ee) r (C.cone-path S c)) >
     C.cone-map S c } ;

 ker-delta (c : Hom D S Cc) (p : Id (Hom D S Bb) (hcomp {D} c ii) (zmap S Bb)) (r : Id (Hom D S Ee) (hcomp {D} c jj) (zmap S Ee)) :
  Id (Hom D S Cc) (delta ((LoopOf[S].L-equiv P).sec (ker-loop c p r))) c =
  H.transH (H.apH {C.Cone S} {Hom D S Cc} pull.sec (ker-cone c p r)) (Pl.sec-ret (Hom D S Cc) (C.Cone S) (C.cone-map S) pull c) ;

 Im (c0 : pi0 (Hom D S Cc)) : U l = Tr.Trunc[(q : pi0 (Hom D (susp S) P)) * Id (pi0 (Hom D S Cc)) (delta0 q) c0].carrier ;
 im-prop (c0 : pi0 (Hom D S Cc)) : Pl.isProp (Im c0) = Tr.Trunc[(q : pi0 (Hom D (susp S) P)) * Id (pi0 (Hom D S Cc)) (delta0 q) c0].proposition ;

 exact-c-rep (c : Hom D S Cc) (hp : Id (pi0 (Hom D S Bb)) (cls (hcomp {D} c ii)) (zero-cls Bb))
  (hr : Id (pi0 (Hom D S Ee)) (cls (hcomp {D} c jj)) (zero-cls Ee)) : Im (cls c) =
  TC.rec (Id (Hom D S Bb) (hcomp {D} c ii) (zmap S Bb)) @l (Im (cls c)) (im-prop (cls c))
   (\ p -> TC.rec (Id (Hom D S Ee) (hcomp {D} c jj) (zmap S Ee)) @l (Im (cls c)) (im-prop (cls c))
     (\ r -> Tr.Trunc[(q : pi0 (Hom D (susp S) P)) * Id (pi0 (Hom D S Cc)) (delta0 q) (cls c)].inc
       (cls ((LoopOf[S].L-equiv P).sec (ker-loop c p r)),
        H.transH (pi0-map-cls (Hom D (susp S) P) (Hom D S Cc) delta ((LoopOf[S].L-equiv P).sec (ker-loop c p r)))
         (H.apH (\ t -> cls t) (ker-delta c p r))))
     (pi0-eff (Hom D S Ee) (hcomp {D} c jj) (zmap S Ee) hr))
   (pi0-eff (Hom D S Bb) (hcomp {D} c ii) (zmap S Bb) hp) ;

 -- exactness at H(C): the kernel of (i_*, j_*) is the image of delta
 exact-c (c0 : pi0 (Hom D S Cc)) (hp : Id (pi0 (Hom D S Bb)) (post ii c0) (zero-cls Bb))
  (hr : Id (pi0 (Hom D S Ee)) (post jj c0) (zero-cls Ee)) : Im c0 =
  pi0-ind (Hom D S Cc) @l (\ c1 -> Id (pi0 (Hom D S Bb)) (post ii c1) (zero-cls Bb) -> Id (pi0 (Hom D S Ee)) (post jj c1) (zero-cls Ee) -> Im c1)
   (\ c1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id (pi0 (Hom D S Bb)) (post ii c1) (zero-cls Bb))
     (\ h1 -> Id (pi0 (Hom D S Ee)) (post jj c1) (zero-cls Ee) -> Im c1)
     (\ h1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi (Id (pi0 (Hom D S Ee)) (post jj c1) (zero-cls Ee)) (\ h2 -> Im c1) (\ h2 -> im-prop c1)))
   (\ c hp1 hr1 -> exact-c-rep c (H.transH (H.symH (post-cls ii c)) hp1) (H.transH (H.symH (post-cls jj c)) hr1)) c0 hp hr ;
} ;

------------------------------------------------------------------------
-- the Mayer-Vietoris sequence of a pushout of types

module MVTypes (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) (n : Nat) {
 module Ex = Excision.ExcisionOf[B, C, E, X, i, j, u, v, h, A] ;
 module M = MV[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, HGroups.Sph n] ;
 -- H_n(C) -> H_n(B) x H_n(E) -> H_n(X): exact in the middle
 exact-mid (b0 : HGroups.homology n B A) (e0 : HGroups.homology n E A) (q : Id (HGroups.homology n X A) (M.post Ex.tu b0) (M.post Ex.tv e0)) :
  M.Lift0 b0 e0 = M.exact-mid b0 e0 q ;
 -- the connecting map H_(n+1)(X) -> H_n(C), and exactness at H_n(C)
 delta (q : HGroups.homology (suc n) X A) : HGroups.homology n C A = M.delta0 q ;
 exact-c (c0 : HGroups.homology n C A) (hp : Id (HGroups.homology n B A) (M.post Ex.ti c0) (M.zero-cls Ex.BA))
  (hr : Id (HGroups.homology n E A) (M.post Ex.tj c0) (M.zero-cls Ex.EA)) : M.Im c0 = M.exact-c c0 hp hr ;
} ;
