-- Naturality of the associator of a category C in its first and middle
-- arguments (J on the path).  Level 2 (the associator is defined there).
--   assoc-nat-l: for tau : x = x1,
--     al(x, f, g) . (tau (f g)) = ((tau f) g) . al(x1, f, g);
--   assoc-nat-m: for sg : f = f1,
--     x (sg g) = al(x, f, g)^-1 . ((x sg) g . al(x, f1, g)).
--   At refl both sides are al(..) up to the unit and inverse laws.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ;

assoc-nat-l (C : Cat) {a b c d : Ob C} (x x1 : Hom C a b) (tau : Id (Hom C a b) x x1) (f : Hom C b c) (g : Hom C c d) :
 Id (Id (Hom C a d) (hcomp {C} (hcomp {C} x f) g) (hcomp {C} x1 (hcomp {C} f g)))
  (H.transH (hcomp-assoc C (a, b, c, d, x, f, g)) (H.apH (\ w -> hcomp {C} w (hcomp {C} f g)) tau))
  (H.transH (H.apH (\ w -> hcomp {C} w g) (H.apH (\ w -> hcomp {C} w f) tau)) (hcomp-assoc C (a, b, c, d, x1, f, g))) =
 idJ (Hom C a b) x (\ x2 t2 -> Id (Id (Hom C a d) (hcomp {C} (hcomp {C} x f) g) (hcomp {C} x2 (hcomp {C} f g)))
   (H.transH (hcomp-assoc C (a, b, c, d, x, f, g)) (H.apH (\ w -> hcomp {C} w (hcomp {C} f g)) t2))
   (H.transH (H.apH (\ w -> hcomp {C} w g) (H.apH (\ w -> hcomp {C} w f) t2)) (hcomp-assoc C (a, b, c, d, x2, f, g))))
  (H.symH (PA.unit-l (hcomp-assoc C (a, b, c, d, x, f, g)))) x1 tau ;

assoc-nat-m (C : Cat) {a b c d : Ob C} (x : Hom C a b) (f f1 : Hom C b c) (sg : Id (Hom C b c) f f1) (g : Hom C c d) :
 Id (Id (Hom C a d) (hcomp {C} x (hcomp {C} f g)) (hcomp {C} x (hcomp {C} f1 g)))
  (H.apH (\ w -> hcomp {C} x w) (H.apH (\ w -> hcomp {C} w g) sg))
  (H.transH (H.symH (hcomp-assoc C (a, b, c, d, x, f, g)))
   (H.transH (H.apH (\ w -> hcomp {C} w g) (H.apH (\ w -> hcomp {C} x w) sg)) (hcomp-assoc C (a, b, c, d, x, f1, g)))) =
 idJ (Hom C b c) f (\ f2 s2 -> Id (Id (Hom C a d) (hcomp {C} x (hcomp {C} f g)) (hcomp {C} x (hcomp {C} f2 g)))
   (H.apH (\ w -> hcomp {C} x w) (H.apH (\ w -> hcomp {C} w g) s2))
   (H.transH (H.symH (hcomp-assoc C (a, b, c, d, x, f, g)))
    (H.transH (H.apH (\ w -> hcomp {C} w g) (H.apH (\ w -> hcomp {C} x w) s2)) (hcomp-assoc C (a, b, c, d, x, f2, g)))))
  (H.symH (H.transH (H.apH (\ r -> H.transH (H.symH (hcomp-assoc C (a, b, c, d, x, f, g))) r) (PA.unit-l (hcomp-assoc C (a, b, c, d, x, f, g))))
   (PA.inv-l (hcomp-assoc C (a, b, c, d, x, f, g))))) f1 sg ;
