-- The edges of Delta 2 and the Segal comparison (Agda Simplices/Segal,
-- parts 1-2), stated before the parameter segal-is-equiv.
--   Delta 2 = Fun (Delta 1) I; its vertices are the functors
--   v0 = I0 o !, v1 = eval-pt (Delta 1 ~ I), v2 = I1 o ! : Delta 1 -> I, and
--   v0 <= v1 <= v2 pointwise (0 <= anything <= 1), so pointwise-to-mor
--   gives the edges d01, d12, d02 with their endpoints.  The edges are
--   locked after their endpoint lemmas.
--   ComposablePair C: morphisms f, g with cod f = dom g; the comparison
--   sends s : Delta 2 -> C to (s o d01, s o d12).
open Base ; open Finite[l] ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Exponentials ; open UnitIso ;
open OrdMonotone ; open MonotoneMaps ; open Interval ; open LastEdge ;

v0 : Map (Delta (suc zero)) I = comp {Delta (suc zero)} {One} {I} I0 (bang (Delta (suc zero))) ;
v1 : Map (Delta (suc zero)) I = eval-pt ;
v2 : Map (Delta (suc zero)) I = comp {Delta (suc zero)} {One} {I} I1 (bang (Delta (suc zero))) ;

v0-const (z : Ob (Delta (suc zero))) : Id Two (ob-to-2 v0 z) zero2 =
 H.transH (H.apH I-ob.1 (const-ob (Delta (suc zero)) I0 z)) (I-ob.2.sec-eq zero2) ;
v2-const (z : Ob (Delta (suc zero))) : Id Two (ob-to-2 v2 z) one2 =
 H.transH (H.apH I-ob.1 (const-ob (Delta (suc zero)) I1 z)) (I-ob.2.sec-eq one2) ;

pw01 (z : Ob (Delta (suc zero))) : leq2 (ob-to-2 v0 z) (ob-to-2 v1 z) =
 H.substH (\ a -> leq2 a (ob-to-2 v1 z)) (H.symH (v0-const z)) tt ;
pw12 (z : Ob (Delta (suc zero))) : leq2 (ob-to-2 v1 z) (ob-to-2 v2 z) =
 H.substH (\ b -> leq2 (ob-to-2 v1 z) b) (H.symH (v2-const z)) (any-leq2-top (ob-to-2 v1 z)) ;
pw02 (z : Ob (Delta (suc zero))) : leq2 (ob-to-2 v0 z) (ob-to-2 v2 z) =
 H.substH (\ a -> leq2 a (ob-to-2 v2 z)) (H.symH (v0-const z)) tt ;

h01 : Hom (Delta (suc (suc zero))) (map-to-ob (Delta (suc zero)) I v0) (map-to-ob (Delta (suc zero)) I v1) =
 pointwise-to-mor (Delta (suc zero)) v0 v1 pw01 ;
h12 : Hom (Delta (suc (suc zero))) (map-to-ob (Delta (suc zero)) I v1) (map-to-ob (Delta (suc zero)) I v2) =
 pointwise-to-mor (Delta (suc zero)) v1 v2 pw12 ;
h02 : Hom (Delta (suc (suc zero))) (map-to-ob (Delta (suc zero)) I v0) (map-to-ob (Delta (suc zero)) I v2) =
 pointwise-to-mor (Delta (suc zero)) v0 v2 pw02 ;

d01 : Mor (Delta (suc (suc zero))) = hmor h01 ;
d12 : Mor (Delta (suc (suc zero))) = hmor h12 ;
d02 : Mor (Delta (suc (suc zero))) = hmor h02 ;

-- the endpoints of the edges
d01-dom : Id (Ob (Delta (suc (suc zero)))) (dom d01) (map-to-ob (Delta (suc zero)) I v0) = hdom h01 ;
d01-cod : Id (Ob (Delta (suc (suc zero)))) (cod d01) (map-to-ob (Delta (suc zero)) I v1) = hcod h01 ;
d12-dom : Id (Ob (Delta (suc (suc zero)))) (dom d12) (map-to-ob (Delta (suc zero)) I v1) = hdom h12 ;
d12-cod : Id (Ob (Delta (suc (suc zero)))) (cod d12) (map-to-ob (Delta (suc zero)) I v2) = hcod h12 ;
d02-dom : Id (Ob (Delta (suc (suc zero)))) (dom d02) (map-to-ob (Delta (suc zero)) I v0) = hdom h02 ;
d02-cod : Id (Ob (Delta (suc (suc zero)))) (cod d02) (map-to-ob (Delta (suc zero)) I v2) = hcod h02 ;

segal-comm : Id (Ob (Delta (suc (suc zero)))) (cod d01) (dom d12) = H.transH d01-cod (H.symH d12-dom) ;
d02-start : Id (Ob (Delta (suc (suc zero)))) (dom d02) (dom d01) = H.transH d02-dom (H.symH d01-dom) ;
d02-end : Id (Ob (Delta (suc (suc zero)))) (cod d02) (cod d12) = H.transH d02-cod (H.symH d12-cod) ;

opaque d01 ; opaque d12 ; opaque d02 ;

ComposablePair (C : Cat) : U l = (f : Mor C) * (g : Mor C) * Id (Ob C) (cod f) (dom g) ;

segal-comparison (C : Cat) (s : Map (Delta (suc (suc zero))) C) : ComposablePair C =
 (funct-on-mor s d01, funct-on-mor s d12,
  H.transH (cod-nat s d01) (H.transH (H.apH (Ob-map s) segal-comm) (H.symH (dom-nat s d12)))) ;
