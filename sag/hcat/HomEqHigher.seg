-- Comparing paths in Hom while retaining their endpoint 2-cells.
-- If the underlying morphism paths al and al1 are related by theta,
-- their endpoint witnesses must change by ap (r |-> (r o v) . p).
-- Under that compatibility the two Hom-eq paths agree. By J on theta
-- this reduces to congruence in the two endpoint witnesses.
open Base ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open HomPaths ;

module Compare (C : Cat) (x y : Ob C) (h1 h2 : Hom C x y) {
 dom-path (al : Id (Mor C) (hmor h1) (hmor h2)) : Id (Ob C) (dom (hmor h1)) x =
  H.transH (ccl {One} {I} {C} I0 al) (hdom h2) ;
 cod-path (al : Id (Mor C) (hmor h1) (hmor h2)) : Id (Ob C) (cod (hmor h1)) y =
  H.transH (ccl {One} {I} {C} I1 al) (hcod h2) ;

 ends (al : Id (Mor C) (hmor h1) (hmor h2))
  (ep ep1 : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (dom-path al))
  (eq eq1 : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (cod-path al))
  (p : Id (Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (dom-path al)) ep ep1)
  (q : Id (Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (cod-path al)) eq eq1) :
  Id (Id (Hom C x y) h1 h2) (Hom-eq C h1 h2 al ep eq) (Hom-eq C h1 h2 al ep1 eq1) =
  H.transH (H.apH (\ r -> Hom-eq C h1 h2 al r eq) p)
   (H.apH (\ r -> Hom-eq C h1 h2 al ep1 r) q) ;

 module Move (al : Id (Mor C) (hmor h1) (hmor h2))
  (ep : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (dom-path al))
  (eq : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (cod-path al)) {
  motive (al1 : Id (Mor C) (hmor h1) (hmor h2)) (theta : Id (Id (Mor C) (hmor h1) (hmor h2)) al al1) : U l =
   Id (Id (Hom C x y) h1 h2) (Hom-eq C h1 h2 al ep eq)
    (Hom-eq C h1 h2 al1 (H.transH ep (H.apH dom-path theta)) (H.transH eq (H.apH cod-path theta))) ;

  move (al1 : Id (Mor C) (hmor h1) (hmor h2)) (theta : Id (Id (Mor C) (hmor h1) (hmor h2)) al al1) : motive al1 theta =
   idJ (Id (Mor C) (hmor h1) (hmor h2)) al motive (refl (Hom-eq C h1 h2 al ep eq)) al1 theta ;
 } ;
} ;
