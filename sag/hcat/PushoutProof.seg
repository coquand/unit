-- The inverse of eval-pt and the pushout comparison at n = 0 (Agda
-- Squares/PushoutProof).
--   eval-pt-inv: the inverse of the isomorphism eval-pt : Delta 1 -> I
--   (isIso-inverse), locked after its two laws; it is the last edge of
--   Delta 1 (eval-pt-inv-eq), and sends I0, I1 to v0 and top 1 (ei0, ei1).
--   pushout-is-equiv-0: at n = 0 the comparison Map (Delta 1) C ->
--   PushoutPair 0 C is an equivalence, with inverse (s, m, p) |-> m o eval-pt:
--   the s-component is forced, as Ob C ~ the maps One -> C composed with
--   top 0 = 1 (pp-fibre-prop: these fibres are propositions).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open UnitIso ;
open Interval ; open LastEdge ; open FaceMap ; open FaceTop ; open SigmaEquiv ; open PushoutBase ; open PushoutDef ;

eval-pt-inv : Map I (Delta (suc zero)) = (isIso-inverse eval-pt eval-pt-isIso).1 ;
eval-pt-rinv : Id (Map I I) (comp eval-pt eval-pt-inv) (idMap I) = (isIso-inverse eval-pt eval-pt-isIso).2.1 ;
eval-pt-linv : Id (Map (Delta (suc zero)) (Delta (suc zero))) (comp eval-pt-inv eval-pt) (idMap (Delta (suc zero))) =
 (isIso-inverse eval-pt eval-pt-isIso).2.2 ;
opaque eval-pt-inv ;

eval-pt-inv-eq : Id (Map I (Delta (suc zero))) eval-pt-inv (last-edge zero) =
 Equivalences[l].injective (Map I (Delta (suc zero))) (Map I I) (post-comp eval-pt I) (eval-pt-isIso I) eval-pt-inv (last-edge zero)
  (H.transH eval-pt-rinv (H.symH eval-pt-last-edge)) ;

last-edge-0-linv : Id (Map (Delta (suc zero)) (Delta (suc zero))) (comp (last-edge zero) eval-pt) (idMap (Delta (suc zero))) =
 H.transH (H.apH (\ g -> comp g eval-pt) (H.symH eval-pt-inv-eq)) eval-pt-linv ;

ei0 : Id (Ob (Delta (suc zero))) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I0) (dom (last-edge zero)) =
 Equivalences[l].injective (Ob (Delta (suc zero))) (Ob I) (post-comp eval-pt One) (eval-pt-isIso One)
  (comp {One} {I} {Delta (suc zero)} eval-pt-inv I0) (dom (last-edge zero))
  (H.transH (comp-assoc {One} {I} {Delta (suc zero)} {I} eval-pt eval-pt-inv I0)
  (H.transH (ccl {One} {I} {I} I0 eval-pt-rinv)
  (H.transH (comp-id-l {One} {I} I0) (H.symH eval-pt-dom-last)))) ;

ei1 : Id (Ob (Delta (suc zero))) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I1) (top (suc zero)) =
 Equivalences[l].injective (Ob (Delta (suc zero))) (Ob I) (post-comp eval-pt One) (eval-pt-isIso One)
  (comp {One} {I} {Delta (suc zero)} eval-pt-inv I1) (top (suc zero))
  (H.transH (comp-assoc {One} {I} {Delta (suc zero)} {I} eval-pt eval-pt-inv I1)
  (H.transH (ccl {One} {I} {I} I1 eval-pt-rinv)
  (H.transH (comp-id-l {One} {I} I1) (H.symH eval-pt-top1)))) ;

face-0-is-dom : Id (Map One (Delta (suc zero))) (face zero) (dom (last-edge zero)) =
 H.transH (H.symH (comp-id-r (face zero)))
  (H.transH (ccr (face zero) (one-path (idMap One) (top zero))) (face-top zero)) ;

------------------------------------------------------------------------
-- the comparison at n = 0

pushout-inv-0 (C : Cat) (t : PushoutPair zero C) : Map (Delta (suc zero)) C = comp t.2.1 eval-pt ;

pushout-linv-0 (C : Cat) (a : Map (Delta (suc zero)) C) :
 Id (Map (Delta (suc zero)) C) (pushout-inv-0 C (pushout-comparison zero C a)) a =
 H.transH (composeA a (last-edge zero) eval-pt) (H.transH (ccr a last-edge-0-linv) (comp-id-r a)) ;

pushout-m-eq (C : Cat) (m : Mor C) : Id (Mor C) (comp {I} {Delta (suc zero)} {C} (comp m eval-pt) (last-edge zero)) m =
 H.transH (composeA {I} {Delta (suc zero)} {I} {C} m eval-pt (last-edge zero))
  (H.transH (ccr {I} {I} {C} m eval-pt-last-edge) (comp-id-r {I} {C} m)) ;

-- composing with top 0 is homotopic to the identity on Ob C
top0-htpy (C : Cat) (s : Ob C) : Id (Ob C) (Ob-map {Delta zero} {C} s (top zero)) s =
 H.transH (ccr {One} {One} {C} s (one-path (top zero) (idMap One))) (comp-id-r {One} {C} s) ;

pp-fibre-prop (C : Cat) (y : Ob C) : Pl.isProp ((s : Ob C) * Id (Ob C) (Ob-map {Delta zero} {C} s (top zero)) y) =
 Pl.retract-prop ((s : Ob C) * Id (Ob C) (Ob-map {Delta zero} {C} s (top zero)) y) ((s : Ob C) * Id (Ob C) s y)
  (\ w -> (w.1, H.transH (H.symH (top0-htpy C w.1)) w.2))
  (\ w -> (w.1, H.transH (top0-htpy C w.1) w.2))
  (\ w -> H.apH {Id (Ob C) (Ob-map {Delta zero} {C} w.1 (top zero)) y} {(s : Ob C) * Id (Ob C) (Ob-map {Delta zero} {C} s (top zero)) y} (\ v -> (w.1, v)) ((pre-comp-path-equiv {Ob C} {Ob-map {Delta zero} {C} w.1 (top zero)} {w.1} {y} (top0-htpy C w.1)).2.sec-eq w.2))
  (\ u v -> CU.pathC ((s : Ob C) * Id (Ob C) s y) (CU.sing (Ob C) y) u v) ;

pp-eq (C : Cat) (s0 : Ob C) (m0 : Mor C) (p0 : Id (Ob C) (Ob-map {Delta zero} {C} s0 (top zero)) (dom m0)) :
 (m : Mor C) (q : Id (Mor C) m0 m) (s : Ob C) (p : Id (Ob C) (Ob-map {Delta zero} {C} s (top zero)) (dom m)) ->
 Id (PushoutPair zero C) (s0, m0, p0) (s, m, p) =
 \ m q -> idJ (Mor C) m0 (\ m1 q1 -> (s : Ob C) (p : Id (Ob C) (Ob-map {Delta zero} {C} s (top zero)) (dom m1)) ->
   Id (PushoutPair zero C) (s0, m0, p0) (s, m1, p))
  (\ s p -> H.apH (\ w -> (w.1, m0, w.2)) (pp-fibre-prop C (dom m0) (s0, p0) (s, p))) m q ;

pushout-rinv-0 (C : Cat) (t : PushoutPair zero C) :
 Id (PushoutPair zero C) (pushout-comparison zero C (pushout-inv-0 C t)) t =
 pp-eq C (pushout-comparison zero C (pushout-inv-0 C t)).1 (pushout-comparison zero C (pushout-inv-0 C t)).2.1
  (pushout-comparison zero C (pushout-inv-0 C t)).2.2 t.2.1 (pushout-m-eq C t.2.1) t.1 t.2.2 ;

pushout-is-equiv-0 (C : Cat) : Pl.isEquiv (Map (Delta (suc zero)) C) (PushoutPair zero C) (pushout-comparison zero C) =
 Pl.qinv (Map (Delta (suc zero)) C) (PushoutPair zero C) (pushout-comparison zero C) (pushout-inv-0 C)
  (pushout-rinv-0 C) (pushout-linv-0 C) ;
