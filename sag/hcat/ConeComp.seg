-- Precomposition of cones with a composite square morphism (Agda
-- Squares/ConeComp, sq-cone-pre-comp; restructured).  Level 2.
--   The square of a precomposed cone is  alpha . (mA-whiskered s) . beta
--   (cone-pre-comm-split), where for a side x of the squares (x = l for
--   alpha, x = t for beta) and the face  xQ mA = mX xP:
--     beta e = a(e, xQ, mA) . (e o face) . a(e, mX, xP)^-1
--     alpha k = a(k, mX, xP) . (k o face^-1) . a(k, xQ, mA)^-1 = (beta k)^-1.
--   leg-beta: for composable morphisms g after f, with the face of the
--   composite pasted (SquareAlg.paste-face),
--     a(e xR, gA, fA)^-1 . (fA-whiskered beta_g e) . beta_f (e gX)
--       = beta_gf e . (xP-whiskered a(e, gX, fX)^-1).
--   Proof: the right side is telescoped from its end with the pentagons at
--   (e, gX, fX, xP), (e, gX, xQ, fA), (e, xR, gA, fA) and the naturality of
--   a in its second and third arguments (nat-flip, pent-mid, pent-head).
--   leg-alpha: the inverse statement for alpha, from leg-beta by inversion.
--   sq-cone-pre-comp: precomposing with g f is precomposing with g then f.
--   The legs by the reassociators; for the squares, the whiskered s of the
--   cone moves across a(-, gA, fA) by naturality, and the two remaining
--   sides are leg-alpha (side l) and leg-beta (side t).
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module PM = PathMoves[l] ;
open WildCat ; open Naturality ; open Squares ; open SquareAlg ;

beta {BQ AQ AP BP X : Cat} (e : Map BQ X) (xQ : Map AQ BQ) (mA : Map AP AQ) (mX : Map BP BQ) (xP : Map AP BP)
 (s : Id (Map AP BQ) (comp xQ mA) (comp mX xP)) : Id (Map AP X) (comp (comp e xQ) mA) (comp (comp e mX) xP) =
 H.transH (composeA e xQ mA) (H.transH (ccr e s) (H.symH (composeA e mX xP))) ;

alpha {BQ AQ AP BP X : Cat} (k : Map BQ X) (xQ : Map AQ BQ) (mA : Map AP AQ) (mX : Map BP BQ) (xP : Map AP BP)
 (s : Id (Map AP BQ) (comp xQ mA) (comp mX xP)) : Id (Map AP X) (comp (comp k mX) xP) (comp (comp k xQ) mA) =
 H.transH (composeA k mX xP) (H.transH (ccr k (H.symH s)) (H.symH (composeA k xQ mA))) ;

alpha-sym-beta {BQ AQ AP BP X : Cat} (k : Map BQ X) (xQ : Map AQ BQ) (mA : Map AP AQ) (mX : Map BP BQ) (xP : Map AP BP)
 (s : Id (Map AP BQ) (comp xQ mA) (comp mX xP)) :
 Id (Id (Map AP X) (comp (comp k mX) xP) (comp (comp k xQ) mA)) (H.symH (beta k xQ mA mX xP s)) (alpha k xQ mA mX xP s) =
 H.transH (PA.sym-trans (composeA k xQ mA) (H.transH (ccr k s) (H.symH (composeA k mX xP))))
 (H.transH (H.apH (\ z -> H.transH z (H.symH (composeA k xQ mA))) (PA.sym-trans (ccr k s) (H.symH (composeA k mX xP))))
 (H.transH (H.apH (\ z -> H.transH (H.transH z (H.symH (ccr k s))) (H.symH (composeA k xQ mA))) (PA.sym-sym (composeA k mX xP)))
 (H.transH (H.apH (\ z -> H.transH (H.transH (composeA k mX xP) z) (H.symH (composeA k xQ mA))) (H.symH (PA.ap-sym (\ u -> comp k u) s)))
  (PA.tassoc (composeA k mX xP) (ccr k (H.symH s)) (H.symH (composeA k xQ mA)))))) ;

module Legs (AP AQ AR BP BQ BR X : Cat) (fA : Map AP AQ) (gA : Map AQ AR)
 (xP : Map AP BP) (xQ : Map AQ BQ) (xR : Map AR BR) (fX : Map BP BQ) (gX : Map BQ BR)
 (sg : Id (Map AQ BR) (comp xR gA) (comp gX xQ)) (sf : Id (Map AP BQ) (comp xQ fA) (comp fX xP)) {

 pf : Id (Map AP BR) (comp xR (comp gA fA)) (comp (comp gX fX) xP) = paste-face xP xQ xR gA fA gX fX sg sf ;

 leg-beta (e : Map BR X) :
  Id (Id (Map AP X) (comp (comp e xR) (comp gA fA)) (comp (comp (comp e gX) fX) xP))
   (H.transH (H.symH (composeA (comp e xR) gA fA)) (H.transH (ccl fA (beta e xR gA gX xQ sg)) (beta (comp e gX) xQ fA fX xP sf)))
   (H.transH (beta e xR (comp gA fA) (comp gX fX) xP pf) (ccl xP (H.symH (composeA e gX fX)))) =
  H.transH lhsNF (H.symH rhsNF)
  where {
   l5 : Id (Map AP X) (comp (comp (comp e gX) xQ) fA) (comp (comp e gX) (comp xQ fA)) = composeA (comp e gX) xQ fA ;
   l6 : Id (Map AP X) (comp (comp e gX) (comp xQ fA)) (comp (comp e gX) (comp fX xP)) = ccr (comp e gX) sf ;
   l7 : Id (Map AP X) (comp (comp e gX) (comp fX xP)) (comp (comp (comp e gX) fX) xP) = H.symH (composeA (comp e gX) fX xP) ;
   w3 : Id (Map AP X) (comp (comp e (comp gX xQ)) fA) (comp (comp (comp e gX) fX) xP) =
    H.transH (H.symH (ccl fA (composeA e gX xQ))) (H.transH l5 (H.transH l6 l7)) ;
   w2 : Id (Map AP X) (comp (comp e (comp xR gA)) fA) (comp (comp (comp e gX) fX) xP) = H.transH (ccl fA (ccr e sg)) w3 ;
   NF : Id (Map AP X) (comp (comp e xR) (comp gA fA)) (comp (comp (comp e gX) fX) xP) =
    H.transH (H.symH (composeA (comp e xR) gA fA)) (H.transH (ccl fA (composeA e xR gA)) w2) ;
   lhsNF : Id (Id (Map AP X) (comp (comp e xR) (comp gA fA)) (comp (comp (comp e gX) fX) xP))
    (H.transH (H.symH (composeA (comp e xR) gA fA)) (H.transH (ccl fA (beta e xR gA gX xQ sg)) (beta (comp e gX) xQ fA fX xP sf))) NF =
    H.apH (\ q -> H.transH (H.symH (composeA (comp e xR) gA fA)) q)
     (H.transH (PM.apt (\ u -> comp u fA) (composeA e xR gA) (H.transH (ccr e sg) (H.symH (composeA e gX xQ))) (H.transH l5 (H.transH l6 l7)))
      (H.apH (\ q -> H.transH (ccl fA (composeA e xR gA)) q)
       (H.transH (PM.apt (\ u -> comp u fA) (ccr e sg) (H.symH (composeA e gX xQ)) (H.transH l5 (H.transH l6 l7)))
        (H.apH (\ q -> H.transH (ccl fA (ccr e sg)) (H.transH q (H.transH l5 (H.transH l6 l7))))
         (PA.ap-sym (\ u -> comp u fA) (composeA e gX xQ)))))) ;
   r1 : Id (Map AP X) (comp (comp e xR) (comp gA fA)) (comp e (comp xR (comp gA fA))) = composeA e xR (comp gA fA) ;
   r3 : Id (Map AP X) (comp e (comp (comp gX fX) xP)) (comp (comp e (comp gX fX)) xP) = H.symH (composeA e (comp gX fX) xP) ;
   rt : Id (Map AP X) (comp (comp e (comp gX fX)) xP) (comp (comp (comp e gX) fX) xP) = ccl xP (H.symH (composeA e gX fX)) ;
   p1 : Id (Map AP BR) (comp xR (comp gA fA)) (comp (comp xR gA) fA) = H.symH (composeA xR gA fA) ;
   p2 : Id (Map AP BR) (comp (comp xR gA) fA) (comp (comp gX xQ) fA) = ccl fA sg ;
   p3 : Id (Map AP BR) (comp (comp gX xQ) fA) (comp gX (comp xQ fA)) = composeA gX xQ fA ;
   p4 : Id (Map AP BR) (comp gX (comp xQ fA)) (comp gX (comp fX xP)) = ccr gX sf ;
   p5 : Id (Map AP BR) (comp gX (comp fX xP)) (comp (comp gX fX) xP) = H.symH (composeA gX fX xP) ;
   dist : Id (Id (Map AP X) (comp e (comp xR (comp gA fA))) (comp (comp (comp e gX) fX) xP))
    (H.transH (ccr e pf) (H.transH r3 rt))
    (H.transH (ccr e p1) (H.transH (ccr e p2) (H.transH (ccr e p3) (H.transH (ccr e p4) (H.transH (ccr e p5) (H.transH r3 rt)))))) =
    H.transH (PM.apt (\ u -> comp e u) p1 (H.transH p2 (H.transH p3 (H.transH p4 p5))) (H.transH r3 rt))
    (H.apH (\ q -> H.transH (ccr e p1) q) (H.transH (PM.apt (\ u -> comp e u) p2 (H.transH p3 (H.transH p4 p5)) (H.transH r3 rt))
    (H.apH (\ q -> H.transH (ccr e p2) q) (H.transH (PM.apt (\ u -> comp e u) p3 (H.transH p4 p5) (H.transH r3 rt))
    (H.apH (\ q -> H.transH (ccr e p3) q) (PM.apt (\ u -> comp e u) p4 p5 (H.transH r3 rt))))))) ;
   t5 : Id (Id (Map AP X) (comp e (comp gX (comp fX xP))) (comp (comp (comp e gX) fX) xP))
    (H.transH (ccr e p5) (H.transH r3 rt)) (H.transH (H.symH (composeA e gX (comp fX xP))) l7) =
    H.transH (H.apH (\ q -> H.transH q (H.transH r3 rt)) (PA.ap-sym (\ u -> comp e u) (composeA gX fX xP)))
    (H.transH (H.apH (\ q -> H.transH (H.symH (ccr e (composeA gX fX xP))) (H.transH r3 q))
               (PA.ap-sym (\ u -> comp u xP) (composeA e gX fX)))
     (PM.pent-sym (pentagonator e gX fX xP))) ;
   t4 : Id (Id (Map AP X) (comp e (comp gX (comp xQ fA))) (comp (comp (comp e gX) fX) xP))
    (H.transH (ccr e p4) (H.transH (H.symH (composeA e gX (comp fX xP))) l7))
    (H.transH (H.symH (composeA e gX (comp xQ fA))) (H.transH l6 l7)) =
    PM.nat-flip (compose-naturality3 e gX sf) l7 ;
   t3 : Id (Id (Map AP X) (comp e (comp (comp gX xQ) fA)) (comp (comp (comp e gX) fX) xP))
    (H.transH (ccr e p3) (H.transH (H.symH (composeA e gX (comp xQ fA))) (H.transH l6 l7)))
    (H.transH (H.symH (composeA e (comp gX xQ) fA)) w3) =
    PM.pent-mid (pentagonator e gX xQ fA) (H.transH l6 l7) ;
   t2 : Id (Id (Map AP X) (comp e (comp (comp xR gA) fA)) (comp (comp (comp e gX) fX) xP))
    (H.transH (ccr e p2) (H.transH (H.symH (composeA e (comp gX xQ) fA)) w3))
    (H.transH (H.symH (composeA e (comp xR gA) fA)) w2) =
    PM.nat-flip (compose-naturality2 e fA sg) w3 ;
   t1 : Id (Id (Map AP X) (comp (comp e xR) (comp gA fA)) (comp (comp (comp e gX) fX) xP))
    (H.transH r1 (H.transH (ccr e p1) (H.transH (H.symH (composeA e (comp xR gA) fA)) w2))) NF =
    H.transH (H.apH (\ q -> H.transH r1 (H.transH q (H.transH (H.symH (composeA e (comp xR gA) fA)) w2)))
      (PA.ap-sym (\ u -> comp e u) (composeA xR gA fA)))
     (PM.pent-head (pentagonator e xR gA fA) w2) ;
   in4 : Id (Id (Map AP X) (comp e (comp gX (comp xQ fA))) (comp (comp (comp e gX) fX) xP))
    (H.transH (ccr e p4) (H.transH (ccr e p5) (H.transH r3 rt))) (H.transH (H.symH (composeA e gX (comp xQ fA))) (H.transH l6 l7)) =
    H.transH (H.apH (\ q -> H.transH (ccr e p4) q) t5) t4 ;
   in3 : Id (Id (Map AP X) (comp e (comp (comp gX xQ) fA)) (comp (comp (comp e gX) fX) xP))
    (H.transH (ccr e p3) (H.transH (ccr e p4) (H.transH (ccr e p5) (H.transH r3 rt)))) (H.transH (H.symH (composeA e (comp gX xQ) fA)) w3) =
    H.transH (H.apH (\ q -> H.transH (ccr e p3) q) in4) t3 ;
   in2 : Id (Id (Map AP X) (comp e (comp (comp xR gA) fA)) (comp (comp (comp e gX) fX) xP))
    (H.transH (ccr e p2) (H.transH (ccr e p3) (H.transH (ccr e p4) (H.transH (ccr e p5) (H.transH r3 rt)))))
    (H.transH (H.symH (composeA e (comp xR gA) fA)) w2) =
    H.transH (H.apH (\ q -> H.transH (ccr e p2) q) in3) t2 ;
   rhsNF : Id (Id (Map AP X) (comp (comp e xR) (comp gA fA)) (comp (comp (comp e gX) fX) xP))
    (H.transH (beta e xR (comp gA fA) (comp gX fX) xP pf) rt) NF =
    H.transH (PM.flat3 r1 (ccr e pf) r3 rt)
    (H.transH (H.apH (\ q -> H.transH r1 q) dist)
    (H.transH (H.apH (\ q -> H.transH r1 (H.transH (ccr e p1) q)) in2) t1)) ;
  } ;

 leg-alpha (k : Map BR X) :
  Id (Id (Map AP X) (comp (comp k (comp gX fX)) xP) (comp (comp k xR) (comp gA fA)))
   (H.transH (ccl xP (H.symH (composeA k gX fX)))
    (H.transH (alpha (comp k gX) xQ fA fX xP sf) (H.transH (ccl fA (alpha k xR gA gX xQ sg)) (composeA (comp k xR) gA fA))))
   (alpha k xR (comp gA fA) (comp gX fX) xP pf) =
  H.transH (H.apH (\ z -> H.transH (ccl xP (H.symH (composeA k gX fX))) z) (H.symH (PA.tassoc af (ccl fA ag) a0)))
  (H.transH (H.apH (\ z -> H.transH (ccl xP (H.symH (composeA k gX fX))) z) e1)
  (H.transH (H.apH (\ z -> H.transH z (H.transH (ccl xP (composeA k gX fX)) agf)) (PA.ap-sym (\ u -> comp u xP) (composeA k gX fX)))
   (PA.canc-l (ccl xP (composeA k gX fX)) agf)))
  where {
   af : Id (Map AP X) (comp (comp (comp k gX) fX) xP) (comp (comp (comp k gX) xQ) fA) = alpha (comp k gX) xQ fA fX xP sf ;
   ag : Id (Map AQ X) (comp (comp k gX) xQ) (comp (comp k xR) gA) = alpha k xR gA gX xQ sg ;
   agf : Id (Map AP X) (comp (comp k (comp gX fX)) xP) (comp (comp k xR) (comp gA fA)) = alpha k xR (comp gA fA) (comp gX fX) xP pf ;
   a0 : Id (Map AP X) (comp (comp (comp k xR) gA) fA) (comp (comp k xR) (comp gA fA)) = composeA (comp k xR) gA fA ;
   bf : Id (Map AP X) (comp (comp (comp k gX) xQ) fA) (comp (comp (comp k gX) fX) xP) = beta (comp k gX) xQ fA fX xP sf ;
   bg : Id (Map AQ X) (comp (comp k xR) gA) (comp (comp k gX) xQ) = beta k xR gA gX xQ sg ;
   bgf : Id (Map AP X) (comp (comp k xR) (comp gA fA)) (comp (comp k (comp gX fX)) xP) = beta k xR (comp gA fA) (comp gX fX) xP pf ;
   s1 : Id (Id (Map AP X) (comp (comp (comp k gX) fX) xP) (comp (comp k xR) (comp gA fA)))
    (H.symH (H.transH (H.symH a0) (H.transH (ccl fA bg) bf))) (H.transH (H.transH af (ccl fA ag)) a0) =
    H.transH (PA.sym-trans (H.symH a0) (H.transH (ccl fA bg) bf))
    (H.transH (H.apH (\ z -> H.transH z (H.symH (H.symH a0))) (PA.sym-trans (ccl fA bg) bf))
    (H.transH (H.apH (\ z -> H.transH (H.transH (H.symH bf) (H.symH (ccl fA bg))) z) (PA.sym-sym a0))
    (H.transH (H.apH (\ z -> H.transH (H.transH z (H.symH (ccl fA bg))) a0) (alpha-sym-beta (comp k gX) xQ fA fX xP sf))
    (H.apH (\ z -> H.transH (H.transH af z) a0)
     (H.transH (H.symH (PA.ap-sym (\ u -> comp u fA) bg)) (H.apH (\ z -> ccl fA z) (alpha-sym-beta k xR gA gX xQ sg))))))) ;
   s2 : Id (Id (Map AP X) (comp (comp (comp k gX) fX) xP) (comp (comp k xR) (comp gA fA)))
    (H.symH (H.transH bgf (ccl xP (H.symH (composeA k gX fX))))) (H.transH (ccl xP (composeA k gX fX)) agf) =
    H.transH (PA.sym-trans bgf (ccl xP (H.symH (composeA k gX fX))))
    (H.transH (H.apH (\ z -> H.transH z (H.symH bgf))
      (H.transH (H.symH (PA.ap-sym (\ u -> comp u xP) (H.symH (composeA k gX fX))))
       (H.apH (\ z -> ccl xP z) (PA.sym-sym (composeA k gX fX)))))
     (H.apH (\ z -> H.transH (ccl xP (composeA k gX fX)) z) (alpha-sym-beta k xR (comp gA fA) (comp gX fX) xP pf))) ;
   e1 : Id (Id (Map AP X) (comp (comp (comp k gX) fX) xP) (comp (comp k xR) (comp gA fA)))
    (H.transH (H.transH af (ccl fA ag)) a0) (H.transH (ccl xP (composeA k gX fX)) agf) =
    H.transH (H.symH s1) (H.transH (H.apH H.symH (leg-beta k)) s2) ;
  } ;
} ;

sq-cone-pre-comp {P Q R : Square} (g : square-morphism[Q, R]) (f : square-morphism[P, Q]) (X : Cat) (c : sq-cone R X) :
 Id (sq-cone P X) (sq-cone-pre (comp-sqm g f) X c) (sq-cone-pre f X (sq-cone-pre g X c)) =
 cone-eq P X (sq-cone-pre (comp-sqm g f) X c) (sq-cone-pre f X (sq-cone-pre g X c))
  (H.symH (composeA k g.smC f.smC)) (H.symH (composeA e g.smB f.smB)) coh
 where {
  k : Map R.sqC X = cg R X c ;
  e : Map R.sqB X = ce R X c ;
  s : Id (Map R.sqA X) (comp k R.sql) (comp e R.sqt) = cc R X c ;
  agf : Id (Map P.sqA X) (comp (comp k (comp g.smC f.smC)) P.sql) (comp (comp k R.sql) (comp g.smA f.smA)) =
   alpha k R.sql (comp g.smA f.smA) (comp g.smC f.smC) P.sql Legs[P.sqA, Q.sqA, R.sqA, P.sqC, Q.sqC, R.sqC, X, f.smA, g.smA, P.sql, Q.sql, R.sql, f.smC, g.smC, g.sm-l, f.sm-l].pf ;
  bgf : Id (Map P.sqA X) (comp (comp e R.sqt) (comp g.smA f.smA)) (comp (comp e (comp g.smB f.smB)) P.sqt) =
   beta e R.sqt (comp g.smA f.smA) (comp g.smB f.smB) P.sqt Legs[P.sqA, Q.sqA, R.sqA, P.sqB, Q.sqB, R.sqB, X, f.smA, g.smA, P.sqt, Q.sqt, R.sqt, f.smB, g.smB, g.sm-t, f.sm-t].pf ;
  ag : Id (Map Q.sqA X) (comp (comp k g.smC) Q.sql) (comp (comp k R.sql) g.smA) = alpha k R.sql g.smA g.smC Q.sql g.sm-l ;
  bg : Id (Map Q.sqA X) (comp (comp e R.sqt) g.smA) (comp (comp e g.smB) Q.sqt) = beta e R.sqt g.smA g.smB Q.sqt g.sm-t ;
  af : Id (Map P.sqA X) (comp (comp (comp k g.smC) f.smC) P.sql) (comp (comp (comp k g.smC) Q.sql) f.smA) =
   alpha (comp k g.smC) Q.sql f.smA f.smC P.sql f.sm-l ;
  bf : Id (Map P.sqA X) (comp (comp (comp e g.smB) Q.sqt) f.smA) (comp (comp (comp e g.smB) f.smB) P.sqt) =
   beta (comp e g.smB) Q.sqt f.smA f.smB P.sqt f.sm-t ;
  pe : Id (Map P.sqA X) (comp (comp e (comp g.smB f.smB)) P.sqt) (comp (comp (comp e g.smB) f.smB) P.sqt) =
   ccl P.sqt (H.symH (composeA e g.smB f.smB)) ;
  tailB : Id (Map P.sqA X) (comp (comp (comp e R.sqt) g.smA) f.smA) (comp (comp (comp e g.smB) f.smB) P.sqt) =
   H.transH (ccl f.smA bg) bf ;
  coh : Id (Id (Map P.sqA X) (comp (comp k (comp g.smC f.smC)) P.sql) (comp (comp (comp e g.smB) f.smB) P.sqt))
   (H.transH (ccl P.sql (H.symH (composeA k g.smC f.smC))) (cc P X (sq-cone-pre f X (sq-cone-pre g X c))))
   (H.transH (cc P X (sq-cone-pre (comp-sqm g f) X c)) pe) =
   H.transH (H.apH (\ z -> H.transH (ccl P.sql (H.symH (composeA k g.smC f.smC))) z)
     (H.transH (cone-pre-comm-split f X (sq-cone-pre g X c))
      (H.apH (\ z -> H.transH af (H.transH z bf))
       (H.apH (\ z -> ccl f.smA z) (cone-pre-comm-split g X c)))))
   (H.transH (H.apH (\ z -> H.transH (ccl P.sql (H.symH (composeA k g.smC f.smC))) (H.transH af z))
     (H.transH (PM.apt (\ u -> comp u f.smA) ag (H.transH (ccl g.smA s) bg) bf)
      (H.apH (\ z -> H.transH (ccl f.smA ag) z) (PM.apt (\ u -> comp u f.smA) (ccl g.smA s) bg bf))))
   (H.transH (H.apH (\ z -> H.transH (ccl P.sql (H.symH (composeA k g.smC f.smC))) (H.transH af (H.transH (ccl f.smA ag) z)))
     (PM.nat-cps (compose-naturality1 g.smA f.smA s) tailB))
   (H.transH (H.symH (PM.flat3 (ccl P.sql (H.symH (composeA k g.smC f.smC))) af (ccl f.smA ag)
      (H.transH (composeA (comp k R.sql) g.smA f.smA)
       (H.transH (ccl (comp g.smA f.smA) s) (H.transH (H.symH (composeA (comp e R.sqt) g.smA f.smA)) tailB)))))
   (H.transH (H.apH (\ z -> H.transH (H.transH (ccl P.sql (H.symH (composeA k g.smC f.smC))) (H.transH af (ccl f.smA ag))) z)
      (H.apH (\ z -> H.transH (composeA (comp k R.sql) g.smA f.smA) (H.transH (ccl (comp g.smA f.smA) s) z)) (Legs[P.sqA, Q.sqA, R.sqA, P.sqB, Q.sqB, R.sqB, X, f.smA, g.smA, P.sqt, Q.sqt, R.sqt, f.smB, g.smB, g.sm-t, f.sm-t].leg-beta e)))
   (H.transH (H.symH (PA.tassoc (H.transH (ccl P.sql (H.symH (composeA k g.smC f.smC))) (H.transH af (ccl f.smA ag)))
      (composeA (comp k R.sql) g.smA f.smA) (H.transH (ccl (comp g.smA f.smA) s) (H.transH bgf pe))))
   (H.transH (H.apH (\ z -> H.transH z (H.transH (ccl (comp g.smA f.smA) s) (H.transH bgf pe)))
      (H.transH (PM.flat3 (ccl P.sql (H.symH (composeA k g.smC f.smC))) af (ccl f.smA ag) (composeA (comp k R.sql) g.smA f.smA))
       (Legs[P.sqA, Q.sqA, R.sqA, P.sqC, Q.sqC, R.sqC, X, f.smA, g.smA, P.sql, Q.sql, R.sql, f.smC, g.smC, g.sm-l, f.sm-l].leg-alpha k)))
   (H.transH (H.apH (\ z -> H.transH agf z) (H.symH (PA.tassoc (ccl (comp g.smA f.smA) s) bgf pe)))
   (H.transH (H.symH (PA.tassoc agf (H.transH (ccl (comp g.smA f.smA) s) bgf) pe))
    (H.apH (\ z -> H.transH z pe) (H.symH (cone-pre-comm-split (comp-sqm g f) X c))))))))))) ;
 } ;
