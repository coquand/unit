-- The level-3 coherence of Cat (Stasheff's K5), as a statement: the
-- definitions of its two sides.  Level 2 (they are built from the
-- pentagonator).
--   For d : A -> B, e : B -> C, h : C -> D, g : D -> E, f : E -> F, with
--   a(x, y, z) the reassociator (xy)z = x(yz) and x o - , - o x the
--   whiskerings (ccr, ccl), the two extreme paths from (((fg)h)e)d to
--   f(g(h(ed))) are
--     L = a((fg)h, e, d) . (a(fg, h, ed) . a(f, g, h(ed)))
--     R = r1 . (r2 . (r3 . (r4 . (r5 . r6)))),
--   r1 = a(f,g,h) o e o d, r2 = a(f, gh, e) o d, r3 = (f o a(g,h,e)) o d,
--   r4 = a(f, g(he), d), r5 = f o a(g, he, d), r6 = f o g o a(h, e, d).
--   Two 2-paths L = R, pasting the faces of the associahedron K5:
--   route1: the pentagon at (f, g, h, ed), the naturality square N1 of
--     a(-, e, d) along a(f, g, h), the pentagon at (f, gh, e, d), f o the
--     pentagon at (g, h, e, d), the naturality square N2 of a(f, -, d)
--     along a(g, h, e);
--   route2: the pentagon at (fg, h, e, d), the naturality square N3 of
--     a(f, g, -) along a(h, e, d), the pentagon at (f, g, he, d), the
--     pentagon at (f, g, h, e) o d.
--   The reassociations between the steps are tassoc; whiskering of a
--   composite is ap-trans.  The axiom (Coh3) says route1 = route2.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open Naturality ;

module K5 (A B C D E F : Cat) (f : Map E F) (g : Map D E) (h : Map C D) (e : Map B C) (d : Map A B) {
 V0 : Map A F = comp (comp (comp (comp f g) h) e) d ;
 Vend : Map A F = comp f (comp g (comp h (comp e d))) ;
 A1 : Id (Map A F) V0 (comp (comp (comp f g) h) (comp e d)) = composeA (comp (comp f g) h) e d ;
 A2 : Id (Map A F) (comp (comp (comp f g) h) (comp e d)) (comp (comp f g) (comp h (comp e d))) = composeA (comp f g) h (comp e d) ;
 A3 : Id (Map A F) (comp (comp f g) (comp h (comp e d))) Vend = composeA f g (comp h (comp e d)) ;
 r1 : Id (Map A F) V0 (comp (comp (comp f (comp g h)) e) d) = ccl d (ccl e (composeA f g h)) ;
 r2 : Id (Map A F) (comp (comp (comp f (comp g h)) e) d) (comp (comp f (comp (comp g h) e)) d) = ccl d (composeA f (comp g h) e) ;
 r3 : Id (Map A F) (comp (comp f (comp (comp g h) e)) d) (comp (comp f (comp g (comp h e))) d) = ccl d (ccr f (composeA g h e)) ;
 r4 : Id (Map A F) (comp (comp f (comp g (comp h e))) d) (comp f (comp (comp g (comp h e)) d)) = composeA f (comp g (comp h e)) d ;
 r5 : Id (Map A F) (comp f (comp (comp g (comp h e)) d)) (comp f (comp g (comp (comp h e) d))) = ccr f (composeA g (comp h e) d) ;
 r6 : Id (Map A F) (comp f (comp g (comp (comp h e) d))) Vend = ccr f (ccr g (composeA h e d)) ;
 L : Id (Map A F) V0 Vend = H.transH A1 (H.transH A2 A3) ;
 R : Id (Map A F) V0 Vend = H.transH r1 (H.transH r2 (H.transH r3 (H.transH r4 (H.transH r5 r6)))) ;

 -- intermediate edges
 b1 : Id (Map A F) (comp (comp (comp f g) h) (comp e d)) (comp (comp f (comp g h)) (comp e d)) = ccl (comp e d) (composeA f g h) ;
 b2 : Id (Map A F) (comp (comp f (comp g h)) (comp e d)) (comp f (comp (comp g h) (comp e d))) = composeA f (comp g h) (comp e d) ;
 b3 : Id (Map A F) (comp f (comp (comp g h) (comp e d))) Vend = ccr f (composeA g h (comp e d)) ;
 c1 : Id (Map A F) (comp (comp (comp f (comp g h)) e) d) (comp (comp f (comp g h)) (comp e d)) = composeA (comp f (comp g h)) e d ;
 c2 : Id (Map A F) (comp (comp f (comp (comp g h) e)) d) (comp f (comp (comp (comp g h) e) d)) = composeA f (comp (comp g h) e) d ;
 c3 : Id (Map A F) (comp f (comp (comp (comp g h) e) d)) (comp f (comp (comp g h) (comp e d))) = ccr f (composeA (comp g h) e d) ;
 c4 : Id (Map A F) (comp f (comp (comp (comp g h) e) d)) (comp f (comp (comp g (comp h e)) d)) = ccr f (ccl d (composeA g h e)) ;
 x1 : Id (Map A F) V0 (comp (comp (comp f g) (comp h e)) d) = ccl d (composeA (comp f g) h e) ;
 x2 : Id (Map A F) (comp (comp (comp f g) (comp h e)) d) (comp (comp f g) (comp (comp h e) d)) = composeA (comp f g) (comp h e) d ;
 x3 : Id (Map A F) (comp (comp f g) (comp (comp h e) d)) (comp (comp f g) (comp h (comp e d))) = ccr (comp f g) (composeA h e d) ;
 y1 : Id (Map A F) (comp (comp f g) (comp (comp h e) d)) (comp f (comp g (comp (comp h e) d))) = composeA f g (comp (comp h e) d) ;
 w1 : Id (Map A F) (comp (comp (comp f g) (comp h e)) d) (comp (comp f (comp g (comp h e))) d) = ccl d (composeA f g (comp h e)) ;

 -- the faces
 P1 : Id (Id (Map A F) (comp (comp (comp f g) h) (comp e d)) Vend) (H.transH A2 A3) (H.transH (H.transH b1 b2) b3) =
  pentagonator f g h (comp e d) ;
 N1 : Id (Id (Map A F) V0 (comp (comp f (comp g h)) (comp e d))) (H.transH A1 b1) (H.transH r1 c1) =
  compose-naturality1 e d (composeA f g h) ;
 P2 : Id (Id (Map A F) (comp (comp (comp f (comp g h)) e) d) (comp f (comp (comp g h) (comp e d)))) (H.transH c1 b2) (H.transH (H.transH r2 c2) c3) =
  pentagonator f (comp g h) e d ;
 P3 : Id (Id (Map A E) (comp (comp (comp g h) e) d) (comp g (comp h (comp e d))))
  (H.transH (composeA (comp g h) e d) (composeA g h (comp e d)))
  (H.transH (H.transH (ccl d (composeA g h e)) (composeA g (comp h e) d)) (ccr g (composeA h e d))) =
  pentagonator g h e d ;
 N2 : Id (Id (Map A F) (comp (comp f (comp (comp g h) e)) d) (comp f (comp (comp g (comp h e)) d))) (H.transH c2 c4) (H.transH r3 r4) =
  compose-naturality2 f d (composeA g h e) ;
 P4 : Id (Id (Map A F) V0 (comp (comp f g) (comp h (comp e d)))) (H.transH A1 A2) (H.transH (H.transH x1 x2) x3) =
  pentagonator (comp f g) h e d ;
 N3 : Id (Id (Map A F) (comp (comp f g) (comp (comp h e) d)) Vend) (H.transH y1 r6) (H.transH x3 A3) =
  compose-naturality3 f g (composeA h e d) ;
 P5 : Id (Id (Map A F) (comp (comp (comp f g) (comp h e)) d) (comp f (comp g (comp (comp h e) d)))) (H.transH x2 y1) (H.transH (H.transH w1 r4) r5) =
  pentagonator f g (comp h e) d ;
 P6 : Id (Id (Map B F) (comp (comp (comp f g) h) e) (comp f (comp g (comp h e))))
  (H.transH (composeA (comp f g) h e) (composeA f g (comp h e)))
  (H.transH (H.transH (ccl e (composeA f g h)) (composeA f (comp g h) e)) (ccr f (composeA g h e))) =
  pentagonator f g h e ;

 -- f o - and - o d of a composite of three paths
 fq : Id (Id (Map A F) (comp f (comp (comp (comp g h) e) d)) Vend)
  (ccr f (H.transH (H.transH (ccl d (composeA g h e)) (composeA g (comp h e) d)) (ccr g (composeA h e d))))
  (H.transH c4 (H.transH r5 r6)) =
  H.transH (PA.ap-trans (\ m -> comp {A} {E} {F} f m) (H.transH (ccl d (composeA g h e)) (composeA g (comp h e) d)) (ccr g (composeA h e d)))
   (H.transH (H.apH (\ u -> H.transH u r6) (PA.ap-trans (\ m -> comp {A} {E} {F} f m) (ccl d (composeA g h e)) (composeA g (comp h e) d)))
    (PA.tassoc c4 r5 r6)) ;
 qd : Id (Id (Map A F) V0 (comp (comp f (comp g (comp h e))) d))
  (ccl d (H.transH (H.transH (ccl e (composeA f g h)) (composeA f (comp g h) e)) (ccr f (composeA g h e))))
  (H.transH (H.transH r1 r2) r3) =
  H.transH (PA.ap-trans (\ m -> comp {A} {B} {F} m d) (H.transH (ccl e (composeA f g h)) (composeA f (comp g h) e)) (ccr f (composeA g h e)))
   (H.apH (\ u -> H.transH u r3) (PA.ap-trans (\ m -> comp {A} {B} {F} m d) (ccl e (composeA f g h)) (composeA f (comp g h) e))) ;

 route1 : Id (Id (Map A F) V0 Vend) L R =
  calc (Id (Map A F) V0 Vend) {
   H.transH A1 (H.transH A2 A3)
   =< H.apH (\ u -> H.transH A1 u) P1 > H.transH A1 (H.transH (H.transH b1 b2) b3)
   =< H.apH (\ u -> H.transH A1 u) (PA.tassoc b1 b2 b3) > H.transH A1 (H.transH b1 (H.transH b2 b3))
   =< H.symH (PA.tassoc A1 b1 (H.transH b2 b3)) > H.transH (H.transH A1 b1) (H.transH b2 b3)
   =< H.apH (\ u -> H.transH u (H.transH b2 b3)) N1 > H.transH (H.transH r1 c1) (H.transH b2 b3)
   =< PA.tassoc r1 c1 (H.transH b2 b3) > H.transH r1 (H.transH c1 (H.transH b2 b3))
   =< H.apH (\ u -> H.transH r1 u) (H.symH (PA.tassoc c1 b2 b3)) > H.transH r1 (H.transH (H.transH c1 b2) b3)
   =< H.apH (\ u -> H.transH r1 (H.transH u b3)) P2 > H.transH r1 (H.transH (H.transH (H.transH r2 c2) c3) b3)
   =< H.apH (\ u -> H.transH r1 u) (PA.tassoc (H.transH r2 c2) c3 b3) > H.transH r1 (H.transH (H.transH r2 c2) (H.transH c3 b3))
   =< H.apH (\ u -> H.transH r1 u) (PA.tassoc r2 c2 (H.transH c3 b3)) > H.transH r1 (H.transH r2 (H.transH c2 (H.transH c3 b3)))
   =< H.apH (\ u -> H.transH r1 (H.transH r2 (H.transH c2 u)))
       (H.symH (PA.ap-trans (\ m -> comp {A} {E} {F} f m) (composeA (comp g h) e d) (composeA g h (comp e d)))) >
     H.transH r1 (H.transH r2 (H.transH c2 (ccr f (H.transH (composeA (comp g h) e d) (composeA g h (comp e d))))))
   =< H.apH (\ u -> H.transH r1 (H.transH r2 (H.transH c2 (ccr f u)))) P3 >
     H.transH r1 (H.transH r2 (H.transH c2 (ccr f (H.transH (H.transH (ccl d (composeA g h e)) (composeA g (comp h e) d)) (ccr g (composeA h e d))))))
   =< H.apH (\ u -> H.transH r1 (H.transH r2 (H.transH c2 u))) fq > H.transH r1 (H.transH r2 (H.transH c2 (H.transH c4 (H.transH r5 r6))))
   =< H.apH (\ u -> H.transH r1 (H.transH r2 u)) (H.symH (PA.tassoc c2 c4 (H.transH r5 r6))) >
     H.transH r1 (H.transH r2 (H.transH (H.transH c2 c4) (H.transH r5 r6)))
   =< H.apH (\ u -> H.transH r1 (H.transH r2 (H.transH u (H.transH r5 r6)))) N2 >
     H.transH r1 (H.transH r2 (H.transH (H.transH r3 r4) (H.transH r5 r6)))
   =< H.apH (\ u -> H.transH r1 (H.transH r2 u)) (PA.tassoc r3 r4 (H.transH r5 r6)) >
     H.transH r1 (H.transH r2 (H.transH r3 (H.transH r4 (H.transH r5 r6)))) } ;

 route2 : Id (Id (Map A F) V0 Vend) L R =
  calc (Id (Map A F) V0 Vend) {
   H.transH A1 (H.transH A2 A3)
   =< H.symH (PA.tassoc A1 A2 A3) > H.transH (H.transH A1 A2) A3
   =< H.apH (\ u -> H.transH u A3) P4 > H.transH (H.transH (H.transH x1 x2) x3) A3
   =< PA.tassoc (H.transH x1 x2) x3 A3 > H.transH (H.transH x1 x2) (H.transH x3 A3)
   =< H.apH (\ u -> H.transH (H.transH x1 x2) u) (H.symH N3) > H.transH (H.transH x1 x2) (H.transH y1 r6)
   =< PA.tassoc x1 x2 (H.transH y1 r6) > H.transH x1 (H.transH x2 (H.transH y1 r6))
   =< H.apH (\ u -> H.transH x1 u) (H.symH (PA.tassoc x2 y1 r6)) > H.transH x1 (H.transH (H.transH x2 y1) r6)
   =< H.apH (\ u -> H.transH x1 (H.transH u r6)) P5 > H.transH x1 (H.transH (H.transH (H.transH w1 r4) r5) r6)
   =< H.apH (\ u -> H.transH x1 u) (PA.tassoc (H.transH w1 r4) r5 r6) > H.transH x1 (H.transH (H.transH w1 r4) (H.transH r5 r6))
   =< H.apH (\ u -> H.transH x1 u) (PA.tassoc w1 r4 (H.transH r5 r6)) > H.transH x1 (H.transH w1 (H.transH r4 (H.transH r5 r6)))
   =< H.symH (PA.tassoc x1 w1 (H.transH r4 (H.transH r5 r6))) > H.transH (H.transH x1 w1) (H.transH r4 (H.transH r5 r6))
   =< H.apH (\ u -> H.transH u (H.transH r4 (H.transH r5 r6)))
       (H.symH (PA.ap-trans (\ m -> comp {A} {B} {F} m d) (composeA (comp f g) h e) (composeA f g (comp h e)))) >
     H.transH (ccl d (H.transH (composeA (comp f g) h e) (composeA f g (comp h e)))) (H.transH r4 (H.transH r5 r6))
   =< H.apH (\ u -> H.transH (ccl d u) (H.transH r4 (H.transH r5 r6))) P6 >
     H.transH (ccl d (H.transH (H.transH (ccl e (composeA f g h)) (composeA f (comp g h) e)) (ccr f (composeA g h e)))) (H.transH r4 (H.transH r5 r6))
   =< H.apH (\ u -> H.transH u (H.transH r4 (H.transH r5 r6))) qd > H.transH (H.transH (H.transH r1 r2) r3) (H.transH r4 (H.transH r5 r6))
   =< PA.tassoc (H.transH r1 r2) r3 (H.transH r4 (H.transH r5 r6)) > H.transH (H.transH r1 r2) (H.transH r3 (H.transH r4 (H.transH r5 r6)))
   =< PA.tassoc r1 r2 (H.transH r3 (H.transH r4 (H.transH r5 r6))) > H.transH r1 (H.transH r2 (H.transH r3 (H.transH r4 (H.transH r5 r6)))) } ;
} ;
