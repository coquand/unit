-- Copower instance of the general postcomposition coherence theorem.
-- CompWitness.Post applies to the witness tmap-beta. Its beta is
-- definitionally restrict-tmap; its coherence is the required rt-assoc.
open Base ;
module H = Paths[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ;
open TensorMap ;

module RtAssoc (A : Ob D) (Y Z : U k) (f : Y -> Z) (y : Y) (W T1 : Ob D) (phi : Hom D (tensor Z A) W) (g : Hom D W T1) {
 YA : Ob D = tensor Y A ;
 ZA : Ob D = tensor Z A ;
 ey : Hom D A YA = eta Y A y ;
 ez : Hom D A ZA = eta Z A (f y) ;
 tf : Hom D YA ZA = tmap A {Y} {Z} f ;
 tb : Id (Hom D A ZA) (hcomp {D} ey tf) ez = tmap-beta A {Y} {Z} f y ;
 al2 : Id (Hom D A T1) (hcomp {D} (hcomp {D} ey (hcomp {D} tf phi)) g) (hcomp {D} ey (hcomp {D} (hcomp {D} tf phi) g)) =
  hcomp-assoc D (A, YA, W, T1, ey, hcomp {D} tf phi, g) ;
 alt : Id (Hom D A T1) (hcomp {D} ey (hcomp {D} (hcomp {D} tf phi) g)) (hcomp {D} ey (hcomp {D} tf (hcomp {D} phi g))) =
  H.apH (\ w -> hcomp {D} ey w) (hcomp-assoc D (YA, ZA, W, T1, tf, phi, g)) ;
 R : Id (Hom D A T1) (hcomp {D} ey (hcomp {D} tf (hcomp {D} phi g))) (hcomp {D} ez (hcomp {D} phi g)) =
  restrict-tmap A T1 {Y} {Z} f (hcomp {D} phi g) y ;

 rt-assoc : Id (Id (Hom D A T1) (hcomp {D} (hcomp {D} ey (hcomp {D} tf phi)) g) (hcomp {D} ez (hcomp {D} phi g)))
  (H.transH al2 (H.transH alt R))
  (H.transH (H.apH (\ w -> hcomp {D} w g) (restrict-tmap A W {Y} {Z} f phi y)) (hcomp-assoc D (A, ZA, W, T1, ez, phi, g))) =
  CompWitness.Post[D, A, YA, ZA, ey, tf, ez, tb].Assoc[W, T1, phi, g, hpent ey tf phi g].coherence ;
} ;
