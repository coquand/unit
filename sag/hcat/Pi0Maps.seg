-- Maps of groups of components, using only identity types and quotients.
-- A homomorphism is a function preserving multiplication; preservation
-- of the unit and inverse follows by cancellation. A multiplicative map
-- of loop spaces descends by two quotient inductions. A pointed map
-- induces such a map by ap-trans and conj-mul.
-- Finally a commuting square transports the homomorphism property along
-- the same equivalences used by Pi0.TransportGrp. No coherence of the
-- chosen commuting squares with composition is needed.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ; open Pi0[l] ;
module PA = PathAlgebra[l] ;

is-hom (G H : Grp) (f : G.G -> H.G) : U l =
 (x y : G.G) -> Id H.G (f (G.mul x y)) (H.mul (f x) (f y)) ;

module Laws (G H : Grp) (f : G.G -> H.G) (mul : is-hom G H f) {
 one : Id H.G (f G.e) H.e =
  transH (GrpL[H].solve-l (f G.e) (f G.e) (f G.e)
    (transH (symH (mul G.e G.e)) (apH f (G.unitl G.e))))
   (H.invl (f G.e)) ;
 inverse (x : G.G) : Id H.G (f (G.inv x)) (H.inv (f x)) =
  transH (GrpL[H].solve-r (f (G.inv x)) (f x) H.e
   (transH (symH (mul (G.inv x) x)) (transH (apH f (G.invl x)) one)))
   (H.unitl (H.inv (f x))) ;
} ;

-- The equivalence used to transport a group is itself a homomorphism.
module EquivalenceHom (G : Grp) (X : U l) (e : Equiv X G.G) {
 module T = TransportGrp[G, X, e] ;
 forward : is-hom T.grp G e.1 = \ x y -> T.te (G.mul (e.1 x) (e.1 y)) ;
 inverse (x : X) : Id G.G (e.1 (T.grp.inv x)) (G.inv (e.1 x)) = T.te (G.inv (e.1 x)) ;
} ;

diff (G : Grp) (x y : G.G) : G.G = G.mul x (G.inv y) ;

hom-diff (G H : Grp) (f : G.G -> H.G) (mul : is-hom G H f) (x y : G.G) :
 Id H.G (f (diff G x y)) (diff H (f x) (f y)) =
 transH (mul x (G.inv y)) (apH (H.mul (f x)) (Laws[G, H, f, mul].inverse y)) ;

-- The inverse of a group homomorphism which is an equivalence.
module Inverse (G H : Grp) (e : Equiv G.G H.G) (forward : is-hom G H e.1) {
 mul : is-hom H G e.2.sec = \ x y ->
  Equivalences[l].injective G.G H.G e.1 e.2 (e.2.sec (H.mul x y)) (G.mul (e.2.sec x) (e.2.sec y))
   (transH (e.2.sec-eq (H.mul x y))
    (symH (transH (forward (e.2.sec x) (e.2.sec y))
      (transH (apH (\ r -> H.mul r (e.1 (e.2.sec y))) (e.2.sec-eq x))
       (apH (H.mul x) (e.2.sec-eq y)))))) ;
} ;

module LoopMap (Y Z : U l) (y : Y) (z : Z)
 (q : Id Y y y -> Id Z z z)
 (qm : (a b : Id Y y y) -> Id (Id Z z z) (q (transH a b)) (transH (q a) (q b))) {
 module G = LoopGrp[Y, y] ; module K = LoopGrp[Z, z] ;
 map : G.grp.G -> K.grp.G = pi0-map G.O K.O q ;
 on-classes (a b : G.O) : Id K.grp.G (map (G.grp.mul (cls a) (cls b))) (K.grp.mul (map (cls a)) (map (cls b))) =
  calc K.grp.G {
   map (G.grp.mul (cls a) (cls b))
   =< apH map (G.cl-mul a b) > map (cls (transH a b))
   =< pi0-map-cls G.O K.O q (transH a b) > cls (q (transH a b))
   =< apH (\ t -> cls t) (qm a b) > cls (transH (q a) (q b))
   =< symH (K.cl-mul (q a) (q b)) > K.grp.mul (cls (q a)) (cls (q b))
   =< apH (\ t -> K.grp.mul t (cls (q b))) (symH (pi0-map-cls G.O K.O q a)) > K.grp.mul (map (cls a)) (cls (q b))
   =< apH (K.grp.mul (map (cls a))) (symH (pi0-map-cls G.O K.O q b)) > K.grp.mul (map (cls a)) (map (cls b)) } ;
 mul : is-hom G.grp K.grp map =
  \ x t -> pi0-ind G.O @l (\ x1 -> Id K.grp.G (map (G.grp.mul x1 t)) (K.grp.mul (map x1) (map t)))
   (\ x1 -> K.grp.setG (map (G.grp.mul x1 t)) (K.grp.mul (map x1) (map t)))
   (\ a -> pi0-ind G.O @l (\ t1 -> Id K.grp.G (map (G.grp.mul (cls a) t1)) (K.grp.mul (map (cls a)) (map t1)))
    (\ t1 -> K.grp.setG (map (G.grp.mul (cls a) t1)) (K.grp.mul (map (cls a)) (map t1))) (on-classes a) t) x ;
} ;

module Pointed (Y Z : U l) (y : Y) (z : Z) (f : Y -> Z) (p : Id Z (f y) z) {
 loop (a : Id Y y y) : Id Z z z = Conj[l].conj p (apH f a) ;
 loop-mul (a b : Id Y y y) : Id (Id Z z z) (loop (transH a b)) (transH (loop a) (loop b)) =
  transH (apH (Conj[l].conj p) (PA.ap-trans f a b)) (Conj[l].conj-mul p (apH f a) (apH f b)) ;
 module M = LoopMap[Y, Z, y, z, loop, loop-mul] ;
} ;

-- A pointwise square induces a square on components.
factor (A B C : U l) (f : A -> B) (g : B -> C) (h : A -> C)
 (comm : (a : A) -> Id C (g (f a)) (h a)) (q : pi0 A) :
 Id (pi0 C) (pi0-map B C g (pi0-map A B f q)) (pi0-map A C h q) =
 pi0-ind A @l (\ q1 -> Id (pi0 C) (pi0-map B C g (pi0-map A B f q1)) (pi0-map A C h q1))
  (\ q1 -> pi0-set C (pi0-map B C g (pi0-map A B f q1)) (pi0-map A C h q1))
  (\ a -> transH (apH (pi0-map B C g) (pi0-map-cls A B f a))
   (transH (pi0-map-cls B C g (f a))
    (transH (apH (\ r -> cls r) (comm a)) (symH (pi0-map-cls A C h a))))) q ;

map-id (A : U l) (f : A -> A) (h : (a : A) -> Id A (f a) a) (q : pi0 A) :
 Id (pi0 A) (pi0-map A A f q) q =
 pi0-ind A @l (\ q1 -> Id (pi0 A) (pi0-map A A f q1) q1)
  (\ q1 -> pi0-set A (pi0-map A A f q1) q1)
  (\ a -> transH (pi0-map-cls A A f a) (apH (\ r -> cls r) (h a))) q ;

square (A B C D : U l) (f : A -> B) (g : C -> D) (u : A -> C) (v : B -> D)
 (comm : (a : A) -> Id D (v (f a)) (g (u a))) (x : pi0 A) :
 Id (pi0 D) (pi0-map B D v (pi0-map A B f x)) (pi0-map C D g (pi0-map A C u x)) =
 pi0-ind A @l (\ x1 -> Id (pi0 D) (pi0-map B D v (pi0-map A B f x1)) (pi0-map C D g (pi0-map A C u x1)))
  (\ x1 -> pi0-set D (pi0-map B D v (pi0-map A B f x1)) (pi0-map C D g (pi0-map A C u x1)))
  (\ a -> calc (pi0 D) {
   pi0-map B D v (pi0-map A B f (cls a))
   =< apH (pi0-map B D v) (pi0-map-cls A B f a) > pi0-map B D v (cls (f a))
   =< pi0-map-cls B D v (f a) > cls (v (f a))
   =< apH (\ t -> cls t) (comm a) > cls (g (u a))
   =< symH (pi0-map-cls C D g (u a)) > pi0-map C D g (cls (u a))
   =< apH (pi0-map C D g) (symH (pi0-map-cls A C u a)) > pi0-map C D g (pi0-map A C u (cls a)) }) x ;

module Transport (G H : Grp) (X Y : U l) (e : Equiv X G.G) (d : Equiv Y H.G)
 (f : X -> Y) (g : G.G -> H.G) (gm : is-hom G H g)
 (comm : (x : X) -> Id H.G (d.1 (f x)) (g (e.1 x))) {
 module S = TransportGrp[G, X, e] ; module T = TransportGrp[H, Y, d] ;
 mul : is-hom S.grp T.grp f = \ x y ->
  Equivalences[l].injective Y H.G d.1 d.2 (f (S.mul x y)) (T.mul (f x) (f y))
   (calc H.G {
    d.1 (f (S.mul x y))
    =< comm (S.mul x y) > g (e.1 (S.mul x y))
    =< apH g (S.te (G.mul (e.1 x) (e.1 y))) > g (G.mul (e.1 x) (e.1 y))
    =< gm (e.1 x) (e.1 y) > H.mul (g (e.1 x)) (g (e.1 y))
    =< apH (\ t -> H.mul t (g (e.1 y))) (symH (comm x)) > H.mul (d.1 (f x)) (g (e.1 y))
    =< apH (H.mul (d.1 (f x))) (symH (comm y)) > H.mul (d.1 (f x)) (d.1 (f y))
    =< symH (T.te (H.mul (d.1 (f x)) (d.1 (f y)))) > d.1 (T.mul (f x) (f y)) }) ;
} ;
