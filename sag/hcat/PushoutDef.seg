-- The pushout comparison of the gluing square, as data (Agda
-- Squares/PushoutDef): a functor a : Delta (n+1) -> C gives the functor
-- a o face n on Delta n, the morphism a o last-edge n, and the path
-- a (face n (top n)) = a (dom (last-edge n)) (face-top).
open Base ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open LastEdge ; open FaceMap ; open FaceTop ;

PushoutPair (n : Nat) (C : Cat) : U l =
 (s : Map (Delta n) C) * (m : Mor C) * Id (Ob C) (Ob-map s (top n)) (dom m) ;

pushout-comparison (n : Nat) (C : Cat) (a : Map (Delta (suc n)) C) : PushoutPair n C =
 (comp a (face n), funct-on-mor a (last-edge n),
  H.transH (composeA {One} {Delta n} {Delta (suc n)} {C} a (face n) (top n))
   (H.transH (ccr {One} {Delta (suc n)} {C} a (face-top n)) (comp-assoc {One} {I} {Delta (suc n)} {C} a (last-edge n) I0))) ;
