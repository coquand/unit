-- Cones over a square in D, and pullback squares, representably (H4).
-- Internal level 1 of D for the definitions; the path of cone-map uses
-- the associator.
--   DCone: for the square ii uu = jj vv (2-cell ss) of DSquare, a cone
--   from S is (b, e, p) with b : S -> Bb, e : S -> Ee and p : b uu = e vv;
--     cone-map c = (c ii, c jj, cone-path c),
--     cone-path c : (c ii) uu = c (ii uu) = c (jj vv) = (c jj) vv.
--   is-pullback: cone-map is an equivalence for every S, i.e. Hom (S, -)
--   sends the square to a pullback of types (no pullbacks in D needed).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ;

module DCone (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee) (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv)) {
 Cone (S : Ob D) : U l = (b : Hom D S Bb) * (e : Hom D S Ee) * Id (Hom D S P) (hcomp {D} b uu) (hcomp {D} e vv) ;
 cone-path (S : Ob D) (c : Hom D S Cc) : Id (Hom D S P) (hcomp {D} (hcomp {D} c ii) uu) (hcomp {D} (hcomp {D} c jj) vv) =
  H.transH (hcomp-assoc D (S, Cc, Bb, P, c, ii, uu))
   (H.transH (H.apH (\ w -> hcomp {D} c w) ss) (H.symH (hcomp-assoc D (S, Cc, Ee, P, c, jj, vv)))) ;
 cone-map (S : Ob D) (c : Hom D S Cc) : Cone S = (hcomp {D} c ii, hcomp {D} c jj, cone-path S c) ;
 is-pullback : U l = (S : Ob D) -> Pl.isEquiv (Hom D S Cc) (Cone S) (cone-map S) ;
} ;
