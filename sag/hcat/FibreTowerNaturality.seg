-- A pointed square gives a commuting square on fundamental groups.
-- Expanding both loop composites gives conjugation by their composite
-- pointing paths. Naturality of the square's homotopy compares the
-- underlying loops; its basepoint square identifies the conjugators.
-- Apply this to FibreTowerMaps.maps at every n: the entire recursively
-- constructed exact sequence is natural from the single input square.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module PM = Pi0Maps[l] ;
open Conj[l] ; open Pi0[l] ; open FibreTower ; open FibreTowerMaps ;

homotopy-square (A B : U l) (f g : A -> B) (h : (x : A) -> Id B (f x) (g x))
 (x y : A) (q : Id A x y) :
 Id (Id B (f x) (g y)) (H.transH (h x) (H.apH g q)) (H.transH (H.apH f q) (h y)) =
 idJ A x (\ y1 q1 -> Id (Id B (f x) (g y1))
   (H.transH (h x) (H.apH g q1)) (H.transH (H.apH f q1) (h y1)))
  (H.symH (PA.unit-l (h x))) y q ;

loop-composite (A B C : U l) (a : A) (b : B) (c : C)
 (f : A -> B) (pf : Id B (f a) b) (g : B -> C) (pg : Id C (g b) c) (q : Id A a a) :
 Id (Id C c c) (conj pg (H.apH g (conj pf (H.apH f q))))
  (conj (H.transH (H.apH g pf) pg) (H.apH (\ x -> g (f x)) q)) =
 H.transH (H.apH (conj pg) (ap-conj g pf (H.apH f q)))
  (H.transH (conj-trans (H.apH g pf) pg (H.apH g (H.apH f q)))
   (H.apH (conj (H.transH (H.apH g pf) pg)) (PA.ap-comp g f q))) ;

module Square (s t : Arrow) (m : ArrowMap[s, t]) {
 module Top = PM.Pointed[s.dom, s.cod, s.dompt, s.codpt, s.map, s.pointing] ;
 module Bottom = PM.Pointed[t.dom, t.cod, t.dompt, t.codpt, t.map, t.pointing] ;
 module Left = PM.Pointed[s.dom, t.dom, s.dompt, t.dompt, m.dom, m.dompt] ;
 module Right = PM.Pointed[s.cod, t.cod, s.codpt, t.codpt, m.cod, m.codpt] ;
 a : Id t.cod (t.map (m.dom s.dompt)) t.codpt = H.transH (H.apH t.map m.dompt) t.pointing ;
 b : Id t.cod (m.cod (s.map s.dompt)) t.codpt = H.transH (H.apH m.cod s.pointing) m.codpt ;
 conjugators : Id (Id t.cod (m.cod (s.map s.dompt)) t.codpt)
  (H.transH (H.symH (m.square s.dompt)) a) b =
  H.transH (H.apH (\ r -> H.transH (H.symH (m.square s.dompt)) r) (H.symH m.point-square))
   (PA.canc-l (m.square s.dompt) b) ;
 loops (q : Id s.dom s.dompt s.dompt) :
  Id (Id t.cod t.codpt t.codpt) (Bottom.loop (Left.loop q)) (Right.loop (Top.loop q)) =
  H.transH (loop-composite s.dom t.dom t.cod s.dompt t.dompt t.codpt m.dom m.dompt t.map t.pointing q)
   (H.transH (H.apH (conj a)
      (conj-square (m.square s.dompt)
       (H.apH (\ x -> t.map (m.dom x)) q) (H.apH (\ x -> m.cod (s.map x)) q)
       (homotopy-square s.dom t.cod (\ x -> t.map (m.dom x)) (\ x -> m.cod (s.map x)) m.square s.dompt s.dompt q)))
    (H.transH (conj-trans (H.symH (m.square s.dompt)) a (H.apH (\ x -> m.cod (s.map x)) q))
     (H.transH (conj-cong conjugators (H.apH (\ x -> m.cod (s.map x)) q))
      (H.symH (loop-composite s.dom s.cod t.cod s.dompt s.codpt t.codpt s.map s.pointing m.cod m.codpt q))))) ;
 groups (q : LoopGrp[s.dom, s.dompt].grp.G) :
  Id LoopGrp[t.cod, t.codpt].grp.G (Bottom.M.map (Left.M.map q)) (Right.M.map (Top.M.map q)) =
  PM.square (Id s.dom s.dompt s.dompt) (Id t.dom t.dompt t.dompt)
   (Id s.cod s.codpt s.codpt) (Id t.cod t.codpt t.codpt)
   Left.loop Right.loop Top.loop Bottom.loop loops q ;
} ;

module At (s t : Arrow) (m : ArrowMap[s, t]) (n : Nat) {
 module Natural = Square[tower s n, tower t n, maps s t m n] ;
} ;
