-- Moves on right-nested composites of paths, used to telescope pasted
-- 2-cells (the cone lemmas).  A relation between two short composites is
-- used inside a longer composite through a free tail t (the
-- continuation form of Rocq pp_C's CPS lemmas).
--   move2    a.b = c.d          gives  a.(b.t) = c.(d.t)
--   move3    (a.b).c = d.e      gives  a.(b.(c.t)) = d.(e.t)
--   unmove3  d.e = (a.b).c      gives  d.(e.t) = a.(b.(c.t))
--   ins      t = s.(s^-1.t)
--   inv-cps  from x.(y.(s^-1.v)) = p.(q.(s.(s^-1.v))):  x^-1.(p.(q.v)) = y.(s^-1.v)
--   solve3   from i.t = (k.l).m:  t.(m^-1.l^-1) = i^-1.k
--   flat3    (x1.(x2.x3)).w = x1.(x2.(x3.w))
--   apt      ap f (x.r) . t = ap f x . (ap f r . t)
level l ; open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;

move2 {A : U l} {x y z w : A} {a : Id A x y} {b : Id A y z} {c : Id A x w} {d : Id A w z}
 (h : Id (Id A x z) (H.transH a b) (H.transH c d)) {v : A} (t : Id A z v) :
 Id (Id A x v) (H.transH a (H.transH b t)) (H.transH c (H.transH d t)) =
 H.transH (H.symH (PA.tassoc a b t)) (H.transH (H.apH (\ u -> H.transH u t) h) (PA.tassoc c d t)) ;

move3 {A : U l} {x y z w u : A} {a : Id A x y} {b : Id A y z} {c : Id A z w} {d : Id A x u} {e : Id A u w}
 (h : Id (Id A x w) (H.transH (H.transH a b) c) (H.transH d e)) {v : A} (t : Id A w v) :
 Id (Id A x v) (H.transH a (H.transH b (H.transH c t))) (H.transH d (H.transH e t)) =
 H.transH (H.symH (PA.tassoc a b (H.transH c t)))
  (H.transH (H.symH (PA.tassoc (H.transH a b) c t))
   (H.transH (H.apH (\ q -> H.transH q t) h) (PA.tassoc d e t))) ;

unmove3 {A : U l} {x y z w u : A} {a : Id A x y} {b : Id A y z} {c : Id A z w} {d : Id A x u} {e : Id A u w}
 (h : Id (Id A x w) (H.transH d e) (H.transH (H.transH a b) c)) {v : A} (t : Id A w v) :
 Id (Id A x v) (H.transH d (H.transH e t)) (H.transH a (H.transH b (H.transH c t))) =
 H.symH (move3 (H.symH h) t) ;

ins {A : U l} {x y z : A} (s : Id A y x) (t : Id A y z) : Id (Id A y z) t (H.transH s (H.transH (H.symH s) t)) =
 H.symH (H.transH (H.symH (PA.tassoc s (H.symH s) t)) (H.transH (H.apH (\ q -> H.transH q t) (PA.inv-r s)) (PA.unit-l t))) ;

inv-cps {A : U l} {x0 x1 x2 x3 x4 x5 : A} (xx : Id A x0 x1) (yy : Id A x1 x2) (pp : Id A x0 x3) (qq : Id A x3 x4)
 (ss : Id A x4 x2) (vv : Id A x4 x5)
 (r : Id (Id A x0 x5) (H.transH xx (H.transH yy (H.transH (H.symH ss) vv)))
        (H.transH pp (H.transH qq (H.transH ss (H.transH (H.symH ss) vv))))) :
 Id (Id A x1 x5) (H.transH (H.symH xx) (H.transH pp (H.transH qq vv))) (H.transH yy (H.transH (H.symH ss) vv)) =
 H.transH (H.apH (\ v -> H.transH (H.symH xx) (H.transH pp (H.transH qq v))) (ins ss vv))
  (H.transH (H.apH (\ v -> H.transH (H.symH xx) v) (H.symH r))
   (PA.canc-l xx (H.transH yy (H.transH (H.symH ss) vv)))) ;

-- ((k.l).m).(m^-1.l^-1) = k
kill {A : U l} {x y z w : A} (k : Id A x y) (lw : Id A y z) (m : Id A z w) :
 Id (Id A x y) (H.transH (H.transH (H.transH k lw) m) (H.transH (H.symH m) (H.symH lw))) k =
 idJ A z (\ w1 m1 -> Id (Id A x y) (H.transH (H.transH (H.transH k lw) m1) (H.transH (H.symH m1) (H.symH lw))) k)
  (H.transH (H.apH (\ q -> H.transH (H.transH k lw) q) (PA.unit-l (H.symH lw)))
   (H.transH (PA.tassoc k lw (H.symH lw)) (H.apH (\ q -> H.transH k q) (PA.inv-r lw))))
  w m ;

solve3 {A : U l} {x y z w u : A} (i : Id A x y) (t : Id A y z) (k : Id A x w) (lw : Id A w u) (m : Id A u z)
 (h : Id (Id A x z) (H.transH i t) (H.transH (H.transH k lw) m)) :
 Id (Id A y w) (H.transH t (H.transH (H.symH m) (H.symH lw))) (H.transH (H.symH i) k) =
 H.transH (H.apH (\ q -> H.transH q (H.transH (H.symH m) (H.symH lw))) (H.symH (PA.canc-l i t)))
 (H.transH (H.apH (\ q -> H.transH (H.transH (H.symH i) q) (H.transH (H.symH m) (H.symH lw))) h)
 (H.transH (PA.tassoc (H.symH i) (H.transH (H.transH k lw) m) (H.transH (H.symH m) (H.symH lw)))
  (H.apH (\ q -> H.transH (H.symH i) q) (kill k lw m)))) ;

flat3 {A : U l} {x0 x1 x2 x3 x4 : A} (x : Id A x0 x1) (y : Id A x1 x2) (z : Id A x2 x3) (w : Id A x3 x4) :
 Id (Id A x0 x4) (H.transH (H.transH x (H.transH y z)) w) (H.transH x (H.transH y (H.transH z w))) =
 H.transH (PA.tassoc x (H.transH y z) w) (H.apH (\ q -> H.transH x q) (PA.tassoc y z w)) ;

apt {A B : U l} (f : A -> B) {a0 a1 a2 : A} (x : Id A a0 a1) (r : Id A a1 a2) {w : B} (t : Id B (f a2) w) :
 Id (Id B (f a0) w) (H.transH (H.apH f (H.transH x r)) t) (H.transH (H.apH f x) (H.transH (H.apH f r) t)) =
 H.transH (H.apH (\ q -> H.transH q t) (PA.ap-trans f x r)) (PA.tassoc (H.apH f x) (H.apH f r) t) ;

-- ap over a right-nested 7-step composite, with a tail
apt7 {A B : U l} (f : A -> B) {a0 a1 a2 a3 a4 a5 a6 a7 : A} (x1 : Id A a0 a1) (x2 : Id A a1 a2) (x3 : Id A a2 a3)
 (x4 : Id A a3 a4) (x5 : Id A a4 a5) (x6 : Id A a5 a6) (x7 : Id A a6 a7) {w : B} (t : Id B (f a7) w) :
 Id (Id B (f a0) w)
  (H.transH (H.apH f (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 (H.transH x6 x7))))))) t)
  (H.transH (H.apH f x1) (H.transH (H.apH f x2) (H.transH (H.apH f x3) (H.transH (H.apH f x4)
   (H.transH (H.apH f x5) (H.transH (H.apH f x6) (H.transH (H.apH f x7) t))))))) =
 H.transH (apt f x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 (H.transH x6 x7))))) t)
 (H.apH (\ q -> H.transH (H.apH f x1) q) (H.transH (apt f x2 (H.transH x3 (H.transH x4 (H.transH x5 (H.transH x6 x7)))) t)
 (H.apH (\ q -> H.transH (H.apH f x2) q) (H.transH (apt f x3 (H.transH x4 (H.transH x5 (H.transH x6 x7))) t)
 (H.apH (\ q -> H.transH (H.apH f x3) q) (H.transH (apt f x4 (H.transH x5 (H.transH x6 x7)) t)
 (H.apH (\ q -> H.transH (H.apH f x4) q) (H.transH (apt f x5 (H.transH x6 x7) t)
 (H.apH (\ q -> H.transH (H.apH f x5) q) (apt f x6 x7 t)))))))))) ;

-- a tail pushed into a right-nested 7-step composite (J on the tail)
tail7 {A : U l} {a0 a1 a2 a3 a4 a5 a6 a7 : A} (x1 : Id A a0 a1) (x2 : Id A a1 a2) (x3 : Id A a2 a3)
 (x4 : Id A a3 a4) (x5 : Id A a4 a5) (x6 : Id A a5 a6) (x7 : Id A a6 a7) {w : A} (t : Id A a7 w) :
 Id (Id A a0 w)
  (H.transH (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 (H.transH x6 x7)))))) t)
  (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 (H.transH x6 (H.transH x7 t))))))) =
 idJ A a7 (\ w1 t1 -> Id (Id A a0 w1)
   (H.transH (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 (H.transH x6 x7)))))) t1)
   (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 (H.transH x6 (H.transH x7 t1))))))))
  (refl (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 (H.transH x6 x7))))))) w t ;

-- consequences of a relation a.b = c.d (naturality) or a.b = (c.d).q
-- (a pentagon), in continuation form
nat-flip {A : U l} {x y z w : A} {a : Id A x y} {b : Id A y z} {c : Id A x w} {d : Id A w z}
 (h : Id (Id A x z) (H.transH a b) (H.transH c d)) {v : A} (t : Id A w v) :
 Id (Id A y v) (H.transH b (H.transH (H.symH d) t)) (H.transH (H.symH a) (H.transH c t)) =
 H.transH (H.symH (PA.canc-l a (H.transH b (H.transH (H.symH d) t))))
  (H.apH (\ q -> H.transH (H.symH a) q)
   (H.transH (move2 h (H.transH (H.symH d) t)) (H.apH (\ q -> H.transH c q) (H.symH (ins d t))))) ;

nat-cps {A : U l} {x y z w : A} {a : Id A x y} {b : Id A y z} {c : Id A x w} {d : Id A w z}
 (h : Id (Id A x z) (H.transH a b) (H.transH c d)) {v : A} (t : Id A w v) :
 Id (Id A x v) (H.transH c t) (H.transH a (H.transH b (H.transH (H.symH d) t))) =
 H.transH (H.apH (\ q -> H.transH c q) (ins d t)) (H.symH (move2 h (H.transH (H.symH d) t))) ;

pent-head {A : U l} {x y z w u : A} {a : Id A x y} {b : Id A y z} {c : Id A x w} {d : Id A w u} {q : Id A u z}
 (h : Id (Id A x z) (H.transH a b) (H.transH (H.transH c d) q)) {v : A} (t : Id A w v) :
 Id (Id A y v) (H.transH b (H.transH (H.symH q) (H.transH (H.symH d) t))) (H.transH (H.symH a) (H.transH c t)) =
 H.transH (H.symH (PA.canc-l a (H.transH b (H.transH (H.symH q) (H.transH (H.symH d) t)))))
  (H.apH (\ r -> H.transH (H.symH a) r)
   (H.transH (unmove3 h (H.transH (H.symH q) (H.transH (H.symH d) t)))
    (H.apH (\ r -> H.transH c r)
     (H.transH (H.apH (\ r -> H.transH d r) (H.symH (ins q (H.transH (H.symH d) t)))) (H.symH (ins d t)))))) ;

pent-mid {A : U l} {x y z w u : A} {a : Id A x y} {b : Id A y z} {c : Id A x w} {d : Id A w u} {q : Id A u z}
 (h : Id (Id A x z) (H.transH a b) (H.transH (H.transH c d) q)) {v : A} (t : Id A y v) :
 Id (Id A u v) (H.transH q (H.transH (H.symH b) t)) (H.transH (H.symH d) (H.transH (H.symH c) (H.transH a t))) =
 H.transH (H.symH (PA.canc-l d (H.transH q (H.transH (H.symH b) t))))
  (H.transH (H.apH (\ r -> H.transH (H.symH d) r) (H.symH (PA.canc-l c (H.transH d (H.transH q (H.transH (H.symH b) t))))))
   (H.apH (\ r -> H.transH (H.symH d) (H.transH (H.symH c) r))
    (H.transH (move3 (H.symH h) (H.transH (H.symH b) t)) (H.apH (\ r -> H.transH a r) (H.symH (ins b t)))))) ;

pent-sym {A : U l} {x y z w u : A} {a : Id A x y} {b : Id A y z} {c : Id A x w} {d : Id A w u} {q : Id A u z}
 (h : Id (Id A x z) (H.transH a b) (H.transH (H.transH c d) q)) :
 Id (Id A z x) (H.transH (H.symH q) (H.transH (H.symH d) (H.symH c))) (H.transH (H.symH b) (H.symH a)) =
 H.transH (H.apH (\ r -> H.transH (H.symH q) r) (H.symH (PA.sym-trans c d)))
  (H.transH (H.symH (PA.sym-trans (H.transH c d) q)) (H.transH (H.apH H.symH (H.symH h)) (PA.sym-trans a b))) ;
