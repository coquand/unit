-- The base case of Lemma 26: S(1) is a pushout square (Agda
-- Simplices/SegalGeom: base-Sq1).  Level 2: the pentagon is used.
--   A cone over S(1) with vertex X is a pair g, e : Delta 1 -> X with a path
--   g (top 1) = e (v0).  Through the isomorphism Delta 1 ~ I (eval-pt-inv)
--   it is a composable pair (g o eval-pt-inv, e o eval-pt-inv) of X
--   (cone-pair-equiv): the path is conjugated by the endpoint identities
--   lhsf, rhsf.  The Segal axiom identifies Map (Delta 2) X with composable
--   pairs; so it is enough that the comparison of S(1), followed by
--   cone-pair-equiv, is the Segal comparison (reshuffle-comparison).
--   The two morphisms agree by the cofaces (segal-coface-01/12, theorems);
--   the paths between their endpoints agree by a computation in which the
--   pentagon (at h, face 1, eval-pt-inv, I1 and at h, lastedge 1,
--   eval-pt-inv, I0) relates the reassociators (lemB-gen, lemA0-gen, by J
--   on the cofaces and the endpoint identities), and segal-comm is the
--   pasting of the cofaces and the square (content: Ob (Delta 2) is a set).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ;
open WildCat ; open HigherCat ; open Constructions ; open UnitIso ;
open Interval ; open HLevels ; open LastEdge ; open SegalComparison ; open Segal ; open FaceMap ;
open FaceTop ; open PushoutBase ; open PushoutProof ; open GluingSquare ; open SegalCoface ; open SigmaEquiv ;
open Squares ;

-- the product of two equivalences
prod-equiv (A A1 B B1 : U l) (eA : Pl.Equiv A A1) (eB : Pl.Equiv B B1) : Pl.Equiv (A * B) (A1 * B1) =
 (\ p -> (eA.1 p.1, eB.1 p.2),
  Pl.qinv (A * B) (A1 * B1) (\ p -> (eA.1 p.1, eB.1 p.2)) (\ p -> (eA.2.sec p.1, eB.2.sec p.2))
   (\ p -> AffineHLevels[l].pair-path A1 B1 (eA.1 (eA.2.sec p.1)) p.1 (eB.1 (eB.2.sec p.2)) p.2 (eA.2.sec-eq p.1) (eB.2.sec-eq p.2))
   (\ p -> AffineHLevels[l].pair-path A B (eA.2.sec (eA.1 p.1)) p.1 (eB.2.sec (eB.1 p.2)) p.2
     (Pl.sec-ret A A1 eA.1 eA.2 p.1) (Pl.sec-ret B B1 eB.1 eB.2 p.2))) ;

-- precomposition with eval-pt-inv: functors Delta 1 -> X are morphisms of X
precomp-eval-equiv (X : Cat) : Pl.Equiv (Map (Delta (suc zero)) X) (Mor X) =
 (\ g -> comp g eval-pt-inv,
  Pl.qinv (Map (Delta (suc zero)) X) (Mor X) (\ g -> comp g eval-pt-inv) (\ f -> comp {Delta (suc zero)} {I} {X} f eval-pt)
   (\ f -> H.transH (composeA {I} {Delta (suc zero)} {I} {X} f eval-pt eval-pt-inv) (H.transH (ccr {I} {I} {X} f eval-pt-rinv) (comp-id-r {I} {X} f)))
   (\ g -> H.transH (composeA g eval-pt-inv eval-pt) (H.transH (ccr g eval-pt-linv) (comp-id-r g)))) ;

lhsf {X : Cat} (g : Map (Delta (suc zero)) X) : Id (Ob X) (cod (funct-on-mor g eval-pt-inv)) (Ob-map g (top (suc zero))) =
 H.transH (composeA {One} {I} {Delta (suc zero)} {X} g eval-pt-inv I1) (ccr {One} {Delta (suc zero)} {X} g ei1) ;
rhsf {X : Cat} (e : Map (Delta (suc zero)) X) : Id (Ob X) (dom (funct-on-mor e eval-pt-inv)) (Ob-map e v0-Delta1) =
 H.transH (composeA {One} {I} {Delta (suc zero)} {X} e eval-pt-inv I0) (ccr {One} {Delta (suc zero)} {X} e ei0) ;

cp-coh (X : Cat) (fg : Mor X * Mor X) : U l = Id (Ob X) (cod fg.1) (dom fg.2) ;

cone-pair-equiv (X : Cat) : Pl.Equiv (sq-cone (Sq (suc zero)) X) (ComposablePair X) =
 EL.then (sq-cone (Sq (suc zero)) X) ((fg : Mor X * Mor X) * cp-coh X fg) (ComposablePair X)
  (EL.then (sq-cone (Sq (suc zero)) X) ((ge : Map (Delta (suc zero)) X * Map (Delta (suc zero)) X) * cp-coh X (funct-on-mor ge.1 eval-pt-inv, funct-on-mor ge.2 eval-pt-inv)) ((fg : Mor X * Mor X) * cp-coh X fg)
    (Sigma-fiberwise-equiv (Map (Delta (suc zero)) X * Map (Delta (suc zero)) X)
      (\ ge -> Id (Ob X) (comp ge.1 (top (suc zero))) (comp ge.2 v0-Delta1)) (\ ge -> cp-coh X (funct-on-mor ge.1 eval-pt-inv, funct-on-mor ge.2 eval-pt-inv))
      (\ ge -> EL.then (Id (Ob X) (comp ge.1 (top (suc zero))) (comp ge.2 v0-Delta1)) (Id (Ob X) (cod (funct-on-mor ge.1 eval-pt-inv)) (comp ge.2 v0-Delta1))
        (Id (Ob X) (cod (funct-on-mor ge.1 eval-pt-inv)) (dom (funct-on-mor ge.2 eval-pt-inv)))
        (pre-comp-path-equiv (lhsf ge.1)) (post-comp-path-equiv (H.symH (rhsf ge.2)))))
    (Sigma-change-of-base (Map (Delta (suc zero)) X * Map (Delta (suc zero)) X) (Mor X * Mor X) (cp-coh X)
      (prod-equiv (Map (Delta (suc zero)) X) (Mor X) (Map (Delta (suc zero)) X) (Mor X) (precomp-eval-equiv X) (precomp-eval-equiv X))))
  (\ w -> (w.1.1, w.1.2, w.2),
   Pl.qinv ((fg : Mor X * Mor X) * cp-coh X fg) (ComposablePair X) (\ w -> (w.1.1, w.1.2, w.2)) (\ w -> ((w.1, w.2.1), w.2.2))
    (\ w -> refl w) (\ w -> refl w)) ;

-- by definition
cone-pair-fwd (X : Cat) (g e : Map (Delta (suc zero)) X) (coh : Id (Ob X) (comp g (top (suc zero))) (comp e v0-Delta1)) :
 Id (ComposablePair X) ((cone-pair-equiv X).1 ((g, e), coh))
  (comp g eval-pt-inv, comp e eval-pt-inv, H.transH (H.transH (lhsf g) coh) (H.symH (rhsf e))) =
 refl (comp g eval-pt-inv, comp e eval-pt-inv, H.transH (H.transH (lhsf g) coh) (H.symH (rhsf e))) ;

-- composable pairs are equal when their morphisms are, compatibly with the paths
CP-eq {X : Cat} {f g : Mor X} (c : Id (Ob X) (cod f) (dom g)) :
 (f1 : Mor X) (pf : Id (Mor X) f f1) (g1 : Mor X) (pg : Id (Mor X) g g1) (c1 : Id (Ob X) (cod f1) (dom g1)) ->
 Id (Id (Ob X) (cod f) (dom g1)) (H.transH c (H.apH (\ m -> dom m) pg)) (H.transH (H.apH (\ m -> cod m) pf) c1) ->
 Id (ComposablePair X) (f, g, c) (f1, g1, c1) =
 \ f1 pf -> idJ (Mor X) f (\ f2 pf2 -> (g1 : Mor X) (pg : Id (Mor X) g g1) (c1 : Id (Ob X) (cod f2) (dom g1)) ->
   Id (Id (Ob X) (cod f) (dom g1)) (H.transH c (H.apH (\ m -> dom m) pg)) (H.transH (H.apH (\ m -> cod m) pf2) c1) ->
   Id (ComposablePair X) (f, g, c) (f2, g1, c1))
  (\ g1 pg -> idJ (Mor X) g (\ g2 pg2 -> (c1 : Id (Ob X) (cod f) (dom g2)) ->
     Id (Id (Ob X) (cod f) (dom g2)) (H.transH c (H.apH (\ m -> dom m) pg2)) (H.transH (refl (cod f)) c1) ->
     Id (ComposablePair X) (f, g, c) (f, g2, c1))
    (\ c1 r -> H.apH (\ z -> (f, g, z)) (H.transH r (PA.unit-l c1))) g1 pg)
  f1 pf ;

------------------------------------------------------------------------
-- the spine edges and the square

mu-D2 : Id (Ob (Delta (suc (suc zero)))) (cod d01) (Ob-map (face (suc zero)) (top (suc zero))) =
 H.transH (H.apH (\ m -> cod m) segal-coface-01)
  (H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) eval-pt-inv I1) (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) ei1)) ;

nu-D2 : Id (Ob (Delta (suc (suc zero)))) (dom d12) (Ob-map (lastedge (suc zero)) v0-Delta1) =
 H.transH (H.apH (\ m -> dom m) segal-coface-12)
  (H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) eval-pt-inv I0) (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) ei0)) ;

content : Id (Id (Ob (Delta (suc (suc zero)))) (cod d01) (dom d12)) segal-comm
 (H.transH mu-D2 (H.transH (H.symH (square-commutes (suc zero))) (H.symH nu-D2))) =
 ob-Delta-is-set (suc (suc zero)) (cod d01) (dom d12) segal-comm
  (H.transH mu-D2 (H.transH (H.symH (square-commutes (suc zero))) (H.symH nu-D2))) ;

------------------------------------------------------------------------
-- the pentagon at the two edges (J on the cofaces and the endpoints)

lemB-gen {X : Cat} (h : Map (Delta (suc (suc zero))) X) (t : Ob (Delta (suc zero))) (e1 : Id (Ob (Delta (suc zero))) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I1) t) :
 (d : Mor (Delta (suc (suc zero)))) (cf : Id (Mor (Delta (suc (suc zero)))) d (funct-on-mor (face (suc zero)) eval-pt-inv)) ->
 Id (Id (Ob X) (cod (funct-on-mor (comp h (face (suc zero))) eval-pt-inv)) (comp h (Ob-map (face (suc zero)) t)))
  (H.transH (H.transH (composeA {One} {I} {Delta (suc zero)} {X} (comp h (face (suc zero))) eval-pt-inv I1) (ccr {One} {Delta (suc zero)} {X} (comp h (face (suc zero))) e1))
    (composeA {One} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) t))
  (H.transH (H.apH (\ m -> cod {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH cf))))
   (H.transH (composeA {One} {I} {Delta (suc (suc zero))} {X} h d I1)
    (ccr {One} {Delta (suc (suc zero))} {X} h (H.transH (H.apH (\ m -> cod {Delta (suc (suc zero))} m) cf)
      (H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) eval-pt-inv I1) (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) e1)))))) =
 idJ (Ob (Delta (suc zero))) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I1)
  (\ t1 e2 -> (d : Mor (Delta (suc (suc zero)))) (cf : Id (Mor (Delta (suc (suc zero)))) d (funct-on-mor (face (suc zero)) eval-pt-inv)) ->
   Id (Id (Ob X) (cod (funct-on-mor (comp h (face (suc zero))) eval-pt-inv)) (comp h (Ob-map (face (suc zero)) t1)))
    (H.transH (H.transH (composeA {One} {I} {Delta (suc zero)} {X} (comp h (face (suc zero))) eval-pt-inv I1) (ccr {One} {Delta (suc zero)} {X} (comp h (face (suc zero))) e2))
      (composeA {One} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) t1))
    (H.transH (H.apH (\ m -> cod {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH cf))))
     (H.transH (composeA {One} {I} {Delta (suc (suc zero))} {X} h d I1)
      (ccr {One} {Delta (suc (suc zero))} {X} h (H.transH (H.apH (\ m -> cod {Delta (suc (suc zero))} m) cf)
        (H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) eval-pt-inv I1) (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) e2)))))))
  (\ d cf -> Paths[l].idJR (Mor (Delta (suc (suc zero)))) (funct-on-mor (face (suc zero)) eval-pt-inv)
    (\ d1 cf1 -> Id (Id (Ob X) (cod (funct-on-mor (comp h (face (suc zero))) eval-pt-inv)) (comp h (Ob-map (face (suc zero)) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I1))))
      (H.transH (composeA {One} {I} {Delta (suc zero)} {X} (comp h (face (suc zero))) eval-pt-inv I1) (composeA {One} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I1)))
      (H.transH (H.apH (\ m -> cod {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH cf1))))
       (H.transH (composeA {One} {I} {Delta (suc (suc zero))} {X} h d1 I1)
        (ccr {One} {Delta (suc (suc zero))} {X} h (H.transH (H.apH (\ m -> cod {Delta (suc (suc zero))} m) cf1) (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) eval-pt-inv I1))))))
    (H.transH (pentagonator {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv I1)
     (H.transH (PA.tassoc (ccl {One} {I} {X} I1 (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv))
        (composeA {One} {I} {Delta (suc (suc zero))} {X} h (funct-on-mor (face (suc zero)) eval-pt-inv) I1) (ccr {One} {Delta (suc (suc zero))} {X} h (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) eval-pt-inv I1)))
      (H.apH (\ z -> H.transH (ccl {One} {I} {X} I1 (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv))
          (H.transH (composeA {One} {I} {Delta (suc (suc zero))} {X} h (funct-on-mor (face (suc zero)) eval-pt-inv) I1) (ccr {One} {Delta (suc (suc zero))} {X} h z)))
        (H.symH (PA.unit-l (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) eval-pt-inv I1))))))
    d cf)
  t e1 ;

lemA0-gen {X : Cat} (h : Map (Delta (suc (suc zero))) X) (t : Ob (Delta (suc zero))) (e1 : Id (Ob (Delta (suc zero))) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I0) t) :
 (d : Mor (Delta (suc (suc zero)))) (cf : Id (Mor (Delta (suc (suc zero)))) d (funct-on-mor (lastedge (suc zero)) eval-pt-inv)) ->
 Id (Id (Ob X) (dom (funct-on-mor (comp h (lastedge (suc zero))) eval-pt-inv)) (comp h (Ob-map (lastedge (suc zero)) t)))
  (H.transH (H.transH (composeA {One} {I} {Delta (suc zero)} {X} (comp h (lastedge (suc zero))) eval-pt-inv I0) (ccr {One} {Delta (suc zero)} {X} (comp h (lastedge (suc zero))) e1))
    (composeA {One} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) t))
  (H.transH (H.apH (\ m -> dom {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH cf))))
   (H.transH (composeA {One} {I} {Delta (suc (suc zero))} {X} h d I0)
    (ccr {One} {Delta (suc (suc zero))} {X} h (H.transH (H.apH (\ m -> dom {Delta (suc (suc zero))} m) cf)
      (H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) eval-pt-inv I0) (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) e1)))))) =
 idJ (Ob (Delta (suc zero))) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I0)
  (\ t1 e2 -> (d : Mor (Delta (suc (suc zero)))) (cf : Id (Mor (Delta (suc (suc zero)))) d (funct-on-mor (lastedge (suc zero)) eval-pt-inv)) ->
   Id (Id (Ob X) (dom (funct-on-mor (comp h (lastedge (suc zero))) eval-pt-inv)) (comp h (Ob-map (lastedge (suc zero)) t1)))
    (H.transH (H.transH (composeA {One} {I} {Delta (suc zero)} {X} (comp h (lastedge (suc zero))) eval-pt-inv I0) (ccr {One} {Delta (suc zero)} {X} (comp h (lastedge (suc zero))) e2))
      (composeA {One} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) t1))
    (H.transH (H.apH (\ m -> dom {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH cf))))
     (H.transH (composeA {One} {I} {Delta (suc (suc zero))} {X} h d I0)
      (ccr {One} {Delta (suc (suc zero))} {X} h (H.transH (H.apH (\ m -> dom {Delta (suc (suc zero))} m) cf)
        (H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) eval-pt-inv I0) (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) e2)))))))
  (\ d cf -> Paths[l].idJR (Mor (Delta (suc (suc zero)))) (funct-on-mor (lastedge (suc zero)) eval-pt-inv)
    (\ d1 cf1 -> Id (Id (Ob X) (dom (funct-on-mor (comp h (lastedge (suc zero))) eval-pt-inv)) (comp h (Ob-map (lastedge (suc zero)) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I0))))
      (H.transH (composeA {One} {I} {Delta (suc zero)} {X} (comp h (lastedge (suc zero))) eval-pt-inv I0) (composeA {One} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) (comp {One} {I} {Delta (suc zero)} eval-pt-inv I0)))
      (H.transH (H.apH (\ m -> dom {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH cf1))))
       (H.transH (composeA {One} {I} {Delta (suc (suc zero))} {X} h d1 I0)
        (ccr {One} {Delta (suc (suc zero))} {X} h (H.transH (H.apH (\ m -> dom {Delta (suc (suc zero))} m) cf1) (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) eval-pt-inv I0))))))
    (H.transH (pentagonator {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv I0)
     (H.transH (PA.tassoc (ccl {One} {I} {X} I0 (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv))
        (composeA {One} {I} {Delta (suc (suc zero))} {X} h (funct-on-mor (lastedge (suc zero)) eval-pt-inv) I0) (ccr {One} {Delta (suc (suc zero))} {X} h (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) eval-pt-inv I0)))
      (H.apH (\ z -> H.transH (ccl {One} {I} {X} I0 (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv))
          (H.transH (composeA {One} {I} {Delta (suc (suc zero))} {X} h (funct-on-mor (lastedge (suc zero)) eval-pt-inv) I0) (ccr {One} {Delta (suc (suc zero))} {X} h z)))
        (H.symH (PA.unit-l (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) eval-pt-inv I0))))))
    d cf)
  t e1 ;

------------------------------------------------------------------------
-- the comparison of S(1) through cone-pair-equiv is the Segal comparison

-- the groupoid algebra of the reshuffle: the endpoint identities lhsf,
-- rhsf, the reassociators of the square, of the cone and of the Segal
-- comparison, with the two pentagon identities and the pasting of segal-comm
reshuffle-alg {A : U l} {a0 a1 a2 a3 a4 a5 a6 b1 b2 b3 : A}
 (LF : Id A a0 a1) (B1t : Id A a1 a2) (SCh : Id A a2 a3) (B2v : Id A a4 a3) (RL : Id A a5 a4) (pg : Id A a5 a6)
 (pf : Id A a0 b1) (X1 : Id A b1 b2) (mu : Id A b2 a2) (Y2 : Id A a6 b3) (nu : Id A b3 a3) (Sc : Id A b2 b3)
 (lemB : Id (Id A a0 a2) (H.transH LF B1t) (H.transH pf (H.transH X1 mu)))
 (lemA : Id (Id A a5 a3) (H.transH RL B2v) (H.transH pg (H.transH Y2 nu)))
 (ch : Id (Id A b2 b3) Sc (H.transH mu (H.transH SCh (H.symH nu)))) :
 Id (Id A a0 a6) (H.transH (H.transH (H.transH LF (H.transH B1t (H.transH SCh (H.symH B2v)))) (H.symH RL)) pg)
  (H.transH pf (H.transH X1 (H.transH Sc (H.symH Y2)))) =
 H.transH (PA.tassoc (H.transH LF (H.transH B1t (H.transH SCh (H.symH B2v)))) (H.symH RL) pg)
 (H.transH (PA.tassoc LF (H.transH B1t (H.transH SCh (H.symH B2v))) (H.transH (H.symH RL) pg))
 (H.transH (H.apH (\ z -> H.transH LF z)
    (H.transH (PA.tassoc B1t (H.transH SCh (H.symH B2v)) (H.transH (H.symH RL) pg))
     (H.apH (\ z -> H.transH B1t z) (PA.tassoc SCh (H.symH B2v) (H.transH (H.symH RL) pg)))))
 (H.transH (H.symH (PA.tassoc LF B1t (H.transH SCh (H.transH (H.symH B2v) (H.transH (H.symH RL) pg)))))
 (H.transH (H.apH (\ z -> H.transH z (H.transH SCh (H.transH (H.symH B2v) (H.transH (H.symH RL) pg)))) lemB)
 (H.transH (PA.tassoc pf (H.transH X1 mu) (H.transH SCh (H.transH (H.symH B2v) (H.transH (H.symH RL) pg))))
 (H.transH (H.apH (\ z -> H.transH pf z) (PA.tassoc X1 mu (H.transH SCh (H.transH (H.symH B2v) (H.transH (H.symH RL) pg)))))
 (H.transH (H.apH (\ z -> H.transH pf (H.transH X1 (H.transH mu (H.transH SCh z)))) kk)
  (H.symH (H.transH (H.apH (\ z -> H.transH pf (H.transH X1 (H.transH z (H.symH Y2)))) ch)
   (H.apH (\ z -> H.transH pf (H.transH X1 z))
    (H.transH (PA.tassoc mu (H.transH SCh (H.symH nu)) (H.symH Y2))
     (H.apH (\ z -> H.transH mu z) (PA.tassoc SCh (H.symH nu) (H.symH Y2))))))))))))))
 where {
  kk : Id (Id A a3 a6) (H.transH (H.symH B2v) (H.transH (H.symH RL) pg)) (H.transH (H.symH nu) (H.symH Y2)) =
   H.transH (H.symH (PA.tassoc (H.symH B2v) (H.symH RL) pg))
   (H.transH (H.apH (\ z -> H.transH z pg) (H.symH (PA.sym-trans RL B2v)))
   (H.transH (H.apH (\ z -> H.transH (H.symH z) pg) lemA)
   (H.transH (H.apH (\ z -> H.transH z pg) (PA.sym-trans pg (H.transH Y2 nu)))
   (H.transH (PA.tassoc (H.symH (H.transH Y2 nu)) (H.symH pg) pg)
   (H.transH (H.apH (\ z -> H.transH (H.symH (H.transH Y2 nu)) z) (PA.inv-l pg))
    (PA.sym-trans Y2 nu)))))) ;
 } ;

content-h (X : Cat) (h : Map (Delta (suc (suc zero))) X) :
 Id (Id (Ob X) (Ob-map h (cod d01)) (Ob-map h (dom d12))) (H.apH (Ob-map h) segal-comm)
  (H.transH (ccr {One} {Delta (suc (suc zero))} {X} h mu-D2) (H.transH (ccr {One} {Delta (suc (suc zero))} {X} h (H.symH (square-commutes (suc zero)))) (H.symH (ccr {One} {Delta (suc (suc zero))} {X} h nu-D2)))) =
 H.transH (H.apH (\ p -> H.apH (Ob-map h) p) content)
 (H.transH (PA.ap-trans (Ob-map h) mu-D2 (H.transH (H.symH (square-commutes (suc zero))) (H.symH nu-D2)))
  (H.apH (\ z -> H.transH (ccr {One} {Delta (suc (suc zero))} {X} h mu-D2) z)
   (H.transH (PA.ap-trans (Ob-map h) (H.symH (square-commutes (suc zero))) (H.symH nu-D2))
    (H.apH (\ z -> H.transH (ccr {One} {Delta (suc (suc zero))} {X} h (H.symH (square-commutes (suc zero)))) z) (PA.ap-sym (Ob-map h) nu-D2))))) ;

big2 (X : Cat) (h : Map (Delta (suc (suc zero))) X) :
 Id (Id (Ob X) (cod (funct-on-mor (comp h (face (suc zero))) eval-pt-inv)) (dom (funct-on-mor h d12)))
  (H.transH (H.transH (H.transH (lhsf (comp h (face (suc zero)))) (sq-comparison (Sq (suc zero)) X h).2) (H.symH (rhsf (comp h (lastedge (suc zero))))))
    (H.apH (\ m -> dom {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH segal-coface-12)))))
  (H.transH (H.apH (\ m -> cod {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH segal-coface-01)))) (segal-comparison X h).2.2) =
 reshuffle-alg (lhsf (comp h (face (suc zero)))) (composeA {One} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) (top (suc zero)))
  (ccr {One} {Delta (suc (suc zero))} {X} h (H.symH (square-commutes (suc zero)))) (composeA {One} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) v0-Delta1)
  (rhsf (comp h (lastedge (suc zero)))) (H.apH (\ m -> dom {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH segal-coface-12))))
  (H.apH (\ m -> cod {X} m) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH segal-coface-01)))) (cod-nat h d01) (ccr {One} {Delta (suc (suc zero))} {X} h mu-D2)
  (dom-nat h d12) (ccr {One} {Delta (suc (suc zero))} {X} h nu-D2) (H.apH (Ob-map h) segal-comm)
  (lemB-gen h (top (suc zero)) ei1 d01 segal-coface-01) (lemA0-gen h v0-Delta1 ei0 d12 segal-coface-12) (content-h X h) ;

reshuffle-comparison (X : Cat) (h : Map (Delta (suc (suc zero))) X) :
 Id (ComposablePair X) ((cone-pair-equiv X).1 (sq-comparison (Sq (suc zero)) X h)) (segal-comparison X h) =
 CP-eq {X} {comp (comp h (face (suc zero))) eval-pt-inv} {comp (comp h (lastedge (suc zero))) eval-pt-inv}
  (H.transH (H.transH (lhsf (comp h (face (suc zero)))) (sq-comparison (Sq (suc zero)) X h).2) (H.symH (rhsf (comp h (lastedge (suc zero))))))
  (funct-on-mor h d01) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (face (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH segal-coface-01))) (funct-on-mor h d12) (H.transH (composeA {I} {Delta (suc zero)} {Delta (suc (suc zero))} {X} h (lastedge (suc zero)) eval-pt-inv) (ccr {I} {Delta (suc (suc zero))} {X} h (H.symH segal-coface-12))) (segal-comparison X h).2.2 (big2 X h) ;

------------------------------------------------------------------------
-- the base case

base-Sq1 : is-pushout-square (Sq (suc zero)) = \ X ->
 EL.homotopy (Map (Delta (suc (suc zero))) X) (sq-cone (Sq (suc zero)) X)
  (\ h -> (cone-pair-equiv X).2.sec (segal-comparison X h)) (sq-comparison (Sq (suc zero)) X)
  (\ h -> H.transH (H.apH (cone-pair-equiv X).2.sec (H.symH (reshuffle-comparison X h)))
    (Pl.sec-ret (sq-cone (Sq (suc zero)) X) (ComposablePair X) (cone-pair-equiv X).1 (cone-pair-equiv X).2 (sq-comparison (Sq (suc zero)) X h)))
  (EL.compose (Map (Delta (suc (suc zero))) X) (ComposablePair X) (sq-cone (Sq (suc zero)) X) (cone-pair-equiv X).2.sec (segal-comparison X)
    (EL.inverse (sq-cone (Sq (suc zero)) X) (ComposablePair X) (cone-pair-equiv X)).2 (segal-is-equiv X)) ;
