-- Exactness at the SOURCE of the existing structural connecting
-- homomorphism, for the usual difference of postcomposition maps.
-- PullbackDifference supplies the statement on pi_2 mapping spaces.
-- HomologyDouble identifies both maps there with the usual homology
-- maps using L-nat, with no new basepoint-coherence assumption.
-- Together with HomologyFibreLegs, additivity and exactness on BOTH
-- sides of the boundary now concern one and the same homomorphism.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PM = Pi0Maps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open HigherCat ; open Constructions ; open Composition ; open Zero ; open Loops ; open HGroups ; open Pi0[l] ;

module Sequence (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee)
 (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv))
 (po : DPushout.DSquare[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pushout) (S : Ob D) {
 module Q = HomologyFibre.Sequence[Cc, Bb, Ee, P, ii, jj, uu, vv, ss, po, S] ;
 module K = PullbackDifference.Source[Hom D S Bb, Hom D S Ee, Hom D S P,
  \ b -> hcomp {D} b uu, \ e -> hcomp {D} e vv,
  zmap S Bb, zmap S Ee, zmap S P, zero-post S uu, zero-post S vv] ;
 module B = HomologyDouble.At[S, Bb] ; module E = HomologyDouble.At[S, Ee] ;
 module UMap = HomologyDouble.Post[S, Bb, P, uu] ; module VMap = HomologyDouble.Post[S, Ee, P, vv] ;
 difference (b : B.G.grp.G) (e : E.G.grp.G) : Q.A.grp.G =
  PM.diff Q.A.grp (UMap.PostMap.map b) (VMap.PostMap.map e) ;
 difference-square (b : B.G.grp.G) (e : E.G.grp.G) :
  Id K.L.grp.G (Q.source.1 (difference b e)) (K.difference (B.e.1 b) (E.e.1 e)) =
  H.transH (PM.hom-diff Q.A.grp K.L.grp Q.source.1 Q.source-hom (UMap.PostMap.map b) (VMap.PostMap.map e))
   (H.transH (H.apH (\ t -> PM.diff K.L.grp t (Q.source.1 (VMap.PostMap.map e))) (UMap.natural b))
    (H.apH (PM.diff K.L.grp (K.FL.M.map (B.e.1 b))) (VMap.natural e))) ;
 target-unit : Id LoopGrp[Q.F.Cone, Q.F.point].grp.G (Q.target.1 Q.B.grp.e) LoopGrp[Q.F.Cone, Q.F.point].grp.e =
  PM.Laws[Q.B.grp, LoopGrp[Q.F.Cone, Q.F.point].grp, Q.target.1, Q.target-hom].one ;
 zero (b : B.G.grp.G) (e : E.G.grp.G) : Id Q.B.grp.G (Q.connecting (difference b e)) Q.B.grp.e =
  Equivalences[l].injective Q.B.grp.G LoopGrp[Q.F.Cone, Q.F.point].grp.G Q.target.1 Q.target.2
   (Q.connecting (difference b e)) Q.B.grp.e
   (H.transH (Q.target.2.sec-eq (Q.F.connecting (Q.source.1 (difference b e))))
    (H.transH (H.apH Q.F.connecting (difference-square b e))
     (H.transH (K.zero (B.e.1 b) (E.e.1 e)) (H.symH target-unit)))) ;
 Image (q : Q.A.grp.G) : U l =
  Tr.Trunc[(b : B.G.grp.G) * (e : E.G.grp.G) * Id Q.A.grp.G (difference b e) q].carrier ;
 image-prop (q : Q.A.grp.G) : Pl.isProp (Image q) =
  Tr.Trunc[(b : B.G.grp.G) * (e : E.G.grp.G) * Id Q.A.grp.G (difference b e) q].proposition ;
 lift (q : Q.A.grp.G) (b : LoopGrp[LoopOf[S].Om Bb, refl (zmap S Bb)].grp.G)
  (e : LoopGrp[LoopOf[S].Om Ee, refl (zmap S Ee)].grp.G)
  (h : Id K.L.grp.G (K.difference b e) (Q.source.1 q)) : Image q =
  Tr.Trunc[(b1 : B.G.grp.G) * (e1 : E.G.grp.G) * Id Q.A.grp.G (difference b1 e1) q].inc
   (B.e.2.sec b, E.e.2.sec e,
    Equivalences[l].injective Q.A.grp.G K.L.grp.G Q.source.1 Q.source.2 (difference (B.e.2.sec b) (E.e.2.sec e)) q
     (H.transH (difference-square (B.e.2.sec b) (E.e.2.sec e))
      (H.transH (H.apH (\ r -> K.difference r (E.e.1 (E.e.2.sec e))) (B.e.2.sec-eq b))
       (H.transH (H.apH (K.difference b) (E.e.2.sec-eq e)) h)))) ;
 exact (q : Q.A.grp.G) (h : Id Q.B.grp.G (Q.connecting q) Q.B.grp.e) : Image q =
  TC.rec ((b : LoopGrp[LoopOf[S].Om Bb, refl (zmap S Bb)].grp.G) *
    (e : LoopGrp[LoopOf[S].Om Ee, refl (zmap S Ee)].grp.G) * Id K.L.grp.G (K.difference b e) (Q.source.1 q))
   @l (Image q) (image-prop q) (\ t -> lift q t.1 t.2.1 t.2.2)
   (K.exact (Q.source.1 q)
    (H.transH (H.symH (Q.target.2.sec-eq (Q.F.connecting (Q.source.1 q))))
     (H.transH (H.apH Q.target.1 h) target-unit))) ;
} ;
