-- The zero-post paths are compatible with composition and with paths
-- between arrows. For composition use the pentagon at (zt S,zi T,f,g)
-- and contractibility of Hom(0,T'). This is the same tail calculation
-- used for L-nat, factored here for pointed diagrams. No higher axiom.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ; open Zero ;

zero-post-path (S : Ob D) {T T1 : Ob D} (f f1 : Hom D T T1) (p : Id (Hom D T T1) f f1) :
 Id (Id (Hom D S T1) (hcomp {D} (zmap S T) f) (zmap S T1))
  (H.transH (H.apH (\ w -> hcomp {D} (zmap S T) w) p) (zero-post S f1)) (zero-post S f) =
 idJ (Hom D T T1) f (\ f2 p2 -> Id (Id (Hom D S T1) (hcomp {D} (zmap S T) f) (zmap S T1))
   (H.transH (H.apH (\ w -> hcomp {D} (zmap S T) w) p2) (zero-post S f2)) (zero-post S f))
  (PA.unit-l (zero-post S f)) f1 p ;

module Compose (S T T1 T2 : Ob D) (f : Hom D T T1) (g : Hom D T1 T2) {
 alA : Id (Hom D S T1) (hcomp {D} (zmap S T) f) (hcomp {D} (zt S) (hcomp {D} (zi T) f)) =
  hcomp-assoc D (S, zobj, T, T1, zt S, zi T, f) ;
 alB : Id (Hom D S T2) (hcomp {D} (zmap S T) (hcomp {D} f g)) (hcomp {D} (zt S) (hcomp {D} (zi T) (hcomp {D} f g))) =
  hcomp-assoc D (S, zobj, T, T2, zt S, zi T, hcomp {D} f g) ;
 alC : Id (Hom D S T2) (hcomp {D} (hcomp {D} (zmap S T) f) g) (hcomp {D} (zmap S T) (hcomp {D} f g)) =
  hcomp-assoc D (S, T, T1, T2, zmap S T, f, g) ;
 alD : Id (Hom D S T2) (hcomp {D} (hcomp {D} (zt S) (hcomp {D} (zi T) f)) g) (hcomp {D} (zt S) (hcomp {D} (hcomp {D} (zi T) f) g)) =
  hcomp-assoc D (S, zobj, T1, T2, zt S, hcomp {D} (zi T) f, g) ;
 alE : Id (Hom D zobj T2) (hcomp {D} (hcomp {D} (zi T) f) g) (hcomp {D} (zi T) (hcomp {D} f g)) =
  hcomp-assoc D (zobj, T, T1, T2, zi T, f, g) ;
 A1 : Id (Hom D S T1) (hcomp {D} (zt S) (hcomp {D} (zi T) f)) (zmap S T1) =
  H.apH (\ w -> hcomp {D} (zt S) w) (zi-eq (hcomp {D} (zi T) f)) ;
 A2 : Id (Hom D S T2) (hcomp {D} (zt S) (hcomp {D} (zi T) (hcomp {D} f g))) (zmap S T2) =
  H.apH (\ w -> hcomp {D} (zt S) w) (zi-eq (hcomp {D} (zi T) (hcomp {D} f g))) ;
 tail : Id (Id (Hom D S T2) (hcomp {D} (hcomp {D} (zt S) (hcomp {D} (zi T) f)) g) (zmap S T2))
  (H.transH alD (H.transH (H.apH (\ w -> hcomp {D} (zt S) w) alE) A2))
  (H.transH (H.apH (\ w -> hcomp {D} w g) A1) (zero-post S g)) =
  H.transH (H.apH (\ r -> H.transH alD r) (H.symH (PA.ap-trans (\ w -> hcomp {D} (zt S) w) alE (zi-eq (hcomp {D} (zi T) (hcomp {D} f g))))))
   (Loops.LoopOf[S].nat-tail g (hcomp {D} (zi T) f) (zi-eq (hcomp {D} (zi T) f))
    (H.transH alE (zi-eq (hcomp {D} (zi T) (hcomp {D} f g))))) ;
 solve : Id (Id (Hom D S T2) (hcomp {D} (zmap S T) (hcomp {D} f g)) (zmap S T2))
  (zero-post S (hcomp {D} f g))
  (H.transH (H.symH alC) (H.transH (H.apH (\ w -> hcomp {D} w g) (zero-post S f)) (zero-post S g))) =
  H.transH (Conj[l].pent-solve alC alB A2 (H.apH (\ w -> hcomp {D} w g) alA) alD
    (H.apH (\ w -> hcomp {D} (zt S) w) alE) (H.apH (\ w -> hcomp {D} w g) A1) (zero-post S g)
    (hpent (zt S) (zi T) f g) tail)
   (H.apH (\ r -> H.transH (H.symH alC) (H.transH r (zero-post S g)))
    (H.symH (PA.ap-trans (\ w -> hcomp {D} w g) alA A1))) ;
 coherence : Id (Id (Hom D S T2) (hcomp {D} (hcomp {D} (zmap S T) f) g) (zmap S T2))
  (H.transH alC (zero-post S (hcomp {D} f g)))
  (H.transH (H.apH (\ w -> hcomp {D} w g) (zero-post S f)) (zero-post S g)) =
  H.transH (H.apH (\ r -> H.transH alC r) solve)
   (CompWitness.cancel alC (H.transH (H.apH (\ w -> hcomp {D} w g) (zero-post S f)) (zero-post S g))) ;
} ;
