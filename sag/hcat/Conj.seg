-- Conjugation of loops by paths (for loop spaces, H4).
--   conj a q = a^-1 . (q . a) : y = y, for a : x = y and a loop q at x.
-- Each law is one J on a; at a = refl, conj refl q = refl . q.
--   conj-refl-path  conj refl q = q
--   conj-trans      conj b (conj a q) = conj (a . b) q
--   conj-mul        conj a (p . q) = conj a p . conj a q
--   conj-one        conj a refl = refl
--   ap-conj         ap F (conj a q) = conj (ap F a) (ap F q)
--   conj-cong       a = a1 gives conj a q = conj a1 q
--   conj-inj        conj a p = conj a q gives p = q
--   conj-square     a . y = x . a (x a loop at the source, y at the
--                   target) gives x = conj a^-1 y
level l ; open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;

conj {A : U l} {x y : A} (a : Id A x y) (q : Id A x x) : Id A y y = H.transH (H.symH a) (H.transH q a) ;

conj-refl-path {A : U l} {x : A} (q : Id A x x) : Id (Id A x x) (conj (refl x) q) q = PA.unit-l q ;

conj-trans {A : U l} {x y z : A} (a : Id A x y) (b : Id A y z) (q : Id A x x) :
 Id (Id A z z) (conj b (conj a q)) (conj (H.transH a b) q) =
 idJ A y (\ z1 b1 -> Id (Id A z1 z1) (conj b1 (conj a q)) (conj (H.transH a b1) q)) (PA.unit-l (conj a q)) z b ;

conj-mul {A : U l} {x y : A} (a : Id A x y) (p q : Id A x x) :
 Id (Id A y y) (conj a (H.transH p q)) (H.transH (conj a p) (conj a q)) =
 idJ A x (\ y1 a1 -> Id (Id A y1 y1) (conj a1 (H.transH p q)) (H.transH (conj a1 p) (conj a1 q)))
  (H.transH (PA.unit-l (H.transH p q)) (H.symH (PA.tcong (PA.unit-l p) (PA.unit-l q)))) y a ;

conj-one {A : U l} {x y : A} (a : Id A x y) : Id (Id A y y) (conj a (refl x)) (refl y) =
 H.transH (H.apH (\ r -> H.transH (H.symH a) r) (PA.unit-l a)) (PA.inv-l a) ;

ap-conj {A B : U l} (F : A -> B) {x y : A} (a : Id A x y) (q : Id A x x) :
 Id (Id B (F y) (F y)) (H.apH F (conj a q)) (conj (H.apH F a) (H.apH F q)) =
 idJ A x (\ y1 a1 -> Id (Id B (F y1) (F y1)) (H.apH F (conj a1 q)) (conj (H.apH F a1) (H.apH F q)))
  (H.transH (H.apH (\ r -> H.apH F r) (PA.unit-l q)) (H.symH (PA.unit-l (H.apH F q)))) y a ;

conj-cong {A : U l} {x y : A} {a a1 : Id A x y} (e : Id (Id A x y) a a1) (q : Id A x x) :
 Id (Id A y y) (conj a q) (conj a1 q) = H.apH (\ r -> conj r q) e ;

conj-inj {A : U l} {x y : A} (a : Id A x y) (p q : Id A x x) (e : Id (Id A y y) (conj a p) (conj a q)) :
 Id (Id A x x) p q =
 idJ A x (\ y1 a1 -> Id (Id A y1 y1) (conj a1 p) (conj a1 q) -> Id (Id A x x) p q)
  (\ e1 -> H.transH (H.symH (PA.unit-l p)) (H.transH e1 (PA.unit-l q))) y a e ;

conj-square {A : U l} {x y : A} (a : Id A x y) (u : Id A x x) (v : Id A y y)
 (e : Id (Id A x y) (H.transH a v) (H.transH u a)) : Id (Id A x x) u (conj (H.symH a) v) =
 idJ A x (\ y1 a1 -> (v1 : Id A y1 y1) -> Id (Id A x y1) (H.transH a1 v1) (H.transH u a1) -> Id (Id A x x) u (conj (H.symH a1) v1))
  (\ v1 e1 -> H.symH e1) y a v e ;

-- the pentagon solved for the conjugator of L-nat (Loops):
--   from alC . alB = (X1 . alD) . E and alD . (E . A2) = Y1 . zp,
--   alB . A2 = alC^-1 . ((X1 . Y1) . zp)
pent-solve {A : U l} {a b c d e h k : A} (alC : Id A a b) (alB : Id A b c) (A2 : Id A c d) (X1 : Id A a e) (alD : Id A e h)
 (E : Id A h c) (Y1 : Id A e k) (zp : Id A k d)
 (pent : Id (Id A a c) (H.transH alC alB) (H.transH (H.transH X1 alD) E))
 (tail : Id (Id A e d) (H.transH alD (H.transH E A2)) (H.transH Y1 zp)) :
 Id (Id A b d) (H.transH alB A2) (H.transH (H.symH alC) (H.transH (H.transH X1 Y1) zp)) =
 calc (Id A b d) {
  H.transH alB A2
  =< H.apH (\ r -> H.transH r A2) (H.transH (H.symH (PA.canc-l alC alB)) (H.apH (\ r -> H.transH (H.symH alC) r) pent)) >
   H.transH (H.transH (H.symH alC) (H.transH (H.transH X1 alD) E)) A2
  =< H.transH (PA.tassoc (H.symH alC) (H.transH (H.transH X1 alD) E) A2)
      (H.apH (\ r -> H.transH (H.symH alC) r) (H.transH (PA.tassoc (H.transH X1 alD) E A2) (PA.tassoc X1 alD (H.transH E A2)))) >
   H.transH (H.symH alC) (H.transH X1 (H.transH alD (H.transH E A2)))
  =< H.apH (\ r -> H.transH (H.symH alC) (H.transH X1 r)) tail > H.transH (H.symH alC) (H.transH X1 (H.transH Y1 zp))
  =< H.apH (\ r -> H.transH (H.symH alC) r) (H.symH (PA.tassoc X1 Y1 zp)) > H.transH (H.symH alC) (H.transH (H.transH X1 Y1) zp) } ;

-- the comparison of conjugates in L-nat (Loops):
--   from alC . mgf = ef mg . alC and alB . A2 = alC^-1 . ((ef alA . ef A1) . zp),
--   conj A2 (conj alB mgf) = conj zp (ef (conj A1 (conj alA mg)))
nat-alg {V W : U l} (ef : V -> W) {v1 v2 v3 : V} (alA : Id V v1 v2) (A1 : Id V v2 v3) (mg : Id V v1 v1)
 {w0 w1 z0 : W} (alB : Id W w0 w1) (A2 : Id W w1 z0) (alC : Id W (ef v1) w0) (zp : Id W (ef v3) z0) (mgf : Id W w0 w0)
 (wh : Id (Id W (ef v1) w0) (H.transH alC mgf) (H.transH (H.apH ef mg) alC))
 (cj : Id (Id W w0 z0) (H.transH alB A2) (H.transH (H.symH alC) (H.transH (H.transH (H.apH ef alA) (H.apH ef A1)) zp))) :
 Id (Id W z0 z0) (conj A2 (conj alB mgf)) (conj zp (H.apH ef (conj A1 (conj alA mg)))) =
 calc (Id W z0 z0) {
  conj A2 (conj alB mgf)
  =< conj-trans alB A2 mgf > conj (H.transH alB A2) mgf
  =< conj-cong cj mgf > conj (H.transH (H.symH alC) (H.transH (H.transH (H.apH ef alA) (H.apH ef A1)) zp)) mgf
  =< H.symH (conj-trans (H.symH alC) (H.transH (H.transH (H.apH ef alA) (H.apH ef A1)) zp) mgf) >
   conj (H.transH (H.transH (H.apH ef alA) (H.apH ef A1)) zp) (conj (H.symH alC) mgf)
  =< H.apH (\ r -> conj (H.transH (H.transH (H.apH ef alA) (H.apH ef A1)) zp) r) (H.symH (conj-square alC (H.apH ef mg) mgf wh)) >
   conj (H.transH (H.transH (H.apH ef alA) (H.apH ef A1)) zp) (H.apH ef mg)
  =< H.symH (conj-trans (H.transH (H.apH ef alA) (H.apH ef A1)) zp (H.apH ef mg)) >
   conj zp (conj (H.transH (H.apH ef alA) (H.apH ef A1)) (H.apH ef mg))
  =< H.apH (\ r -> conj zp r) (H.symH (conj-trans (H.apH ef alA) (H.apH ef A1) (H.apH ef mg))) >
   conj zp (conj (H.apH ef A1) (conj (H.apH ef alA) (H.apH ef mg)))
  =< H.apH (\ r -> conj zp r) (H.symH (H.transH (ap-conj ef A1 (conj alA mg)) (H.apH (\ r -> conj (H.apH ef A1) r) (ap-conj ef alA mg)))) >
   conj zp (H.apH ef (conj A1 (conj alA mg))) } ;
