-- The representable pullback comparison preserves the zero point.
-- Move its two legs by zero-post. The remaining square is exactly
-- zero-post's composition coherence on the two sides and its naturality
-- in the specified square. Thus the cone of zero is the canonical
-- pointed cone, with no extra assumption on the square's 2-cell.
open Base ;
module H = Paths[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ; open Zero ;

module Point (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee)
 (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv)) (S : Ob D) {
 module C = Cone.DCone[Cc, Bb, Ee, P, ii, jj, uu, vv, ss] ;
 module Q = PullbackPaths[l].Pull[Hom D S Bb, Hom D S Ee, Hom D S P,
  \ w -> hcomp {D} w uu, \ w -> hcomp {D} w vv] ;
 base : C.Cone S =
  (zmap S Bb, zmap S Ee, H.transH (zero-post S uu) (H.symH (zero-post S vv))) ;
 cell : Id (Id (Hom D S P) (hcomp {D} (hcomp {D} (zmap S Cc) ii) uu) (hcomp {D} (zmap S Ee) vv))
  (H.transH (H.apH (\ w -> hcomp {D} w uu) (zero-post S ii)) (H.transH (zero-post S uu) (H.symH (zero-post S vv))))
  (H.transH (C.cone-path S (zmap S Cc)) (H.apH (\ w -> hcomp {D} w vv) (zero-post S jj))) =
  PullbackBoundary[l].pointed-square
   (hcomp-assoc D (S, Cc, Bb, P, zmap S Cc, ii, uu))
   (hcomp-assoc D (S, Cc, Ee, P, zmap S Cc, jj, vv))
   (H.apH (\ w -> hcomp {D} (zmap S Cc) w) ss)
   (H.apH (\ w -> hcomp {D} w uu) (zero-post S ii))
   (H.apH (\ w -> hcomp {D} w vv) (zero-post S jj))
   (zero-post S uu) (zero-post S vv)
   (zero-post S (hcomp {D} ii uu)) (zero-post S (hcomp {D} jj vv))
   ZeroCoherence.Compose[S, Cc, Bb, P, ii, uu].coherence
   ZeroCoherence.Compose[S, Cc, Ee, P, jj, vv].coherence
   (ZeroCoherence.zero-post-path S (hcomp {D} ii uu) (hcomp {D} jj vv) ss) ;
 cone-zero : Id (C.Cone S) (C.cone-map S (zmap S Cc)) base =
  Q.path (hcomp {D} (zmap S Cc) ii) (zmap S Bb) (zero-post S ii)
   (hcomp {D} (zmap S Cc) jj) (zmap S Ee) (zero-post S jj)
   (C.cone-path S (zmap S Cc)) (H.transH (zero-post S uu) (H.symH (zero-post S vv))) cell ;
 cone-zero-fst : Id (Id (Hom D S Bb) (hcomp {D} (zmap S Cc) ii) (zmap S Bb))
  (H.apH (\ w -> w.1) cone-zero) (zero-post S ii) =
  Q.path-fst (hcomp {D} (zmap S Cc) ii) (zmap S Bb) (zero-post S ii)
   (hcomp {D} (zmap S Cc) jj) (zmap S Ee) (zero-post S jj)
   (C.cone-path S (zmap S Cc)) (H.transH (zero-post S uu) (H.symH (zero-post S vv))) cell ;
 cone-zero-snd : Id (Id (Hom D S Ee) (hcomp {D} (zmap S Cc) jj) (zmap S Ee))
  (H.apH (\ w -> w.2.1) cone-zero) (zero-post S jj) =
  Q.path-snd (hcomp {D} (zmap S Cc) ii) (zmap S Bb) (zero-post S ii)
   (hcomp {D} (zmap S Cc) jj) (zmap S Ee) (zero-post S jj)
   (C.cone-path S (zmap S Cc)) (H.transH (zero-post S uu) (H.symH (zero-post S vv))) cell ;
} ;
