-- Ordinal combinatorics of the retraction Delta (n+2) <| Delta (n+1) x I
-- (Agda Interval/OrdComb).  No parameter of Cat.
--   bwd-top: the monotone map of the top ordinal is constantly 1.
--   sn2-pr1 c: the ordinal of the restriction to Ord (n+1) of the monotone
--   map of c (the vertex action of the face Delta (n+1) -> Delta (n+2));
--   sn2-snd c: its value at the top.  Both commute with inl
--   (sn2-pr1-inl, sn2-snd-face): every c is the bottom or a successor
--   (ord-class-rinv), where sn2-pr1 is the bottom, resp. the predecessor.
--   thr-ord a b: the vertex of Delta (n+2) to which ret sends the vertex
--   (a, b) of Delta (n+1) x I, as the ordinal of the monotone predicate
--   thr-pred a b; with b = 1, or with a above the bottom, it is the
--   successor of a (thr-top, thr-ord-one, thr-nonbot); it commutes with
--   inl (thr-dnilast).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
open OrdMonotone ; open Interval ;

bwd-top : (n : Nat) (x : Ord n) -> Id Two ((monotone-ord-bwd n (inr tt)).1 x) one2 = split {
 zero -> \ x -> refl one2 ;
 suc n | r -> split { inl y -> r y ; inr u -> refl one2 } } ;

sn2-pr1 (n : Nat) (c : Ord (suc (suc n))) : Ord (suc n) = monotone-ord-fwd n (restrict n (monotone-ord-bwd (suc n) c)) ;

sn2-snd (n : Nat) (c : Ord (suc (suc n))) : Two = (monotone-ord-bwd (suc n) c).1 (inr tt) ;

sn2-snd-top (n : Nat) : Id Two (sn2-snd n (inr tt)) one2 = bwd-top (suc n) (inr tt) ;

-- by definition
ord-unsuc-top (n : Nat) : Id (Sum Top (Ord (suc n))) (ord-unsuc n (inr tt)) (inr (inr tt)) = refl (inr (inr tt)) ;
ord-suc-top (n : Nat) : Id (Ord (suc (suc n))) (ord-suc n (inr tt)) (inr tt) = refl (inr tt) ;

ord-unsuc-inl (n : Nat) : (c : Ord (suc (suc n))) ->
 Id (Sum Top (Ord (suc (suc n)))) (ord-unsuc (suc n) (inl c)) (ord-unsuc-lift n (ord-unsuc n c)) = split {
 inl y -> refl (ord-unsuc-lift n (unsucL n y)) ;
 inr u -> refl (inr (inl (inr tt))) } ;

snd-inl-aux (m : Nat) : (r : Sum Top (Ord (suc m))) ->
 Id Two ((monotone-ord-bwd-aux m r).1 (inr tt)) ((monotone-ord-bwd-aux (suc m) (ord-unsuc-lift m r)).1 (inr tt)) = split {
 inl u -> refl zero2 ;
 inr c -> refl one2 } ;

sn2-snd-face (n : Nat) (c : Ord (suc (suc n))) : Id Two (sn2-snd n c) (sn2-snd (suc n) (inl c)) =
 H.transH (snd-inl-aux n (ord-unsuc n c))
  (H.symH (H.apH (\ r -> (monotone-ord-bwd-aux (suc n) r).1 (inr tt)) (ord-unsuc-inl n c))) ;

-- the restriction of the extension of a monotone map is the map, by definition
restrict-inr (n : Nat) (c : Ord (suc n)) :
 Id (MonotoneOrd n) (restrict n (monotone-ord-bwd-aux n (inr c))) (monotone-ord-bwd n c) =
 refl (monotone-ord-bwd n c) ;

sn2-pr1-suc (n : Nat) (c : Ord (suc n)) : Id (Ord (suc n)) (sn2-pr1 n (ord-suc n c)) c =
 H.transH (H.apH (\ r -> monotone-ord-fwd n (restrict n (monotone-ord-bwd-aux n r))) (ord-unsuc-suc n c))
  (H.transH (H.apH (monotone-ord-fwd n) (restrict-inr n c)) (monotone-ord-rinv n c)) ;

sn2-pr1-bot (n : Nat) : Id (Ord (suc n)) (sn2-pr1 n (ord-bot (suc n))) (ord-bot n) =
 H.transH (H.apH (\ r -> monotone-ord-fwd n (restrict n (monotone-ord-bwd-aux n r))) (ord-unsuc-bot n)) (fwd-all-zeros n) ;

sn2-pr1-inl-class (n : Nat) : (r : Sum Top (Ord (suc n))) ->
 Id (Ord (suc (suc n))) (inl (sn2-pr1 n (ord-from-class n r))) (sn2-pr1 (suc n) (inl (ord-from-class n r))) = split {
 inl u -> H.transH (H.apH (\ v -> inl v) (sn2-pr1-bot n)) (H.symH (sn2-pr1-bot (suc n))) ;
 inr c -> H.transH (H.apH (\ v -> inl v) (sn2-pr1-suc n c)) (H.symH (sn2-pr1-suc (suc n) (inl c))) } ;

sn2-pr1-inl (n : Nat) (c : Ord (suc (suc n))) : Id (Ord (suc (suc n))) (inl (sn2-pr1 n c)) (sn2-pr1 (suc n) (inl c)) =
 H.substH (\ z -> Id (Ord (suc (suc n))) (inl (sn2-pr1 n z)) (sn2-pr1 (suc n) (inl z)))
  (ord-class-rinv n c) (sn2-pr1-inl-class n (ord-unsuc n c)) ;

------------------------------------------------------------------------
-- the vertex action of the retraction

deface : (n : Nat) -> Ord (suc n) -> Ord n = split {
 zero -> \ x -> tt ;
 suc n -> split { inl x -> x ; inr u -> inr tt } } ;

top-ind (n : Nat) : Ord (suc n) -> Two = split { inl x -> zero2 ; inr u -> one2 } ;

deface-inl : (n : Nat) (o : Ord n) -> Id (Ord n) (deface n (inl o)) o = split {
 zero -> \ o -> isTop tt o ;
 suc m -> \ o -> refl o } ;

sval (n : Nat) (a o : Ord (suc n)) : Two = (monotone-ord-bwd n a).1 (deface n o) ;

interp-rr : (i : Two) -> Id Two (interp i one2 one2) one2 = split { inl u -> refl one2 ; inr u -> refl one2 } ;

thr-pred (n : Nat) (a : Ord (suc n)) (b : Two) (o : Ord (suc n)) : Two =
 interp (top-ind n o) (sval n a o) (interp b (sval n a o) one2) ;

deface-mono : (n : Nat) (x y : Ord (suc n)) -> leqOrd (suc n) x y -> leqOrd n (deface n x) (deface n y) = split {
 zero -> \ x y le -> tt ;
 suc n -> split {
  inl x -> split { inl y -> \ le -> le ; inr v -> \ le -> any-leqOrd-top n x } ;
  inr u -> split { inl y -> \ le -> Pl.absurd _ le ; inr v -> \ le -> tt } } } ;

top-ind-mono (n : Nat) : (x y : Ord (suc n)) -> leqOrd (suc n) x y -> leq2 (top-ind n x) (top-ind n y) = split {
 inl x -> \ y le -> tt ;
 inr u -> split { inl y -> \ le -> Pl.absurd _ le ; inr v -> \ le -> tt } } ;

sval-le-max : (a t : Two) -> leq2 a (interp t a one2) = split {
 inl u -> split { inl v -> tt ; inr v -> tt } ;
 inr u -> split { inl v -> tt ; inr v -> tt } } ;

sval-mono (n : Nat) (a x y : Ord (suc n)) (le : leqOrd (suc n) x y) : leq2 (sval n a x) (sval n a y) =
 (monotone-ord-bwd n a).2 (deface n x) (deface n y) (deface-mono n x y le) ;

thr-mono (n : Nat) (a : Ord (suc n)) (b : Two) : is-monotone-Ord (suc n) (thr-pred n a b) = \ x y le ->
 interp-mono (top-ind n x) (top-ind n y) (sval n a x) (sval n a y)
  (interp b (sval n a x) one2) (interp b (sval n a y) one2)
  (top-ind-mono n x y le) (sval-mono n a x y le)
  (interp-mono b b (sval n a x) (sval n a y) one2 one2 (leq2-refl b) (sval-mono n a x y le) (leq2-refl one2)
    (any-leq2-top (sval n a y)))
  (sval-le-max (sval n a y) b) ;

thr-ord (n : Nat) (a : Ord (suc n)) (b : Two) : Ord (suc (suc n)) =
 monotone-ord-fwd (suc n) (thr-pred n a b, thr-mono n a b) ;

thr-pe (n : Nat) (a : Ord (suc n)) (b : Two) (hyp : Id Two (thr-pred n a b (inr tt)) one2) :
 (o : Ord (suc n)) -> Id Two (thr-pred n a b o) ((monotone-ord-bwd-aux n (inr a)).1 o) = split {
 inl o -> H.apH (monotone-ord-bwd n a).1 (deface-inl n o) ;
 inr u -> H.transH (H.apH (\ t -> thr-pred n a b (inr t)) (isTop u tt)) hyp } ;

thr-top (n : Nat) (a : Ord (suc n)) (b : Two) (hyp : Id Two (thr-pred n a b (inr tt)) one2) :
 Id (Ord (suc (suc n))) (thr-ord n a b) (ord-suc n a) =
 H.transH (H.apH (monotone-ord-fwd (suc n))
   (Pl.Sigma-eq (Ord (suc n) -> Two) (is-monotone-Ord (suc n)) (thr-pred n a b) (monotone-ord-bwd (suc n) (ord-suc n a)).1
     (thr-mono n a b) (monotone-ord-bwd (suc n) (ord-suc n a)).2
     (FL.funext (Ord (suc n)) (\ o -> Two) (thr-pred n a b) (monotone-ord-bwd (suc n) (ord-suc n a)).1
       (\ o -> H.transH (thr-pe n a b hyp o)
         (H.symH (H.apH (\ r -> (monotone-ord-bwd-aux n r).1 o) (ord-unsuc-suc n a)))))
     (is-monotone-Ord-is-prop (suc n) (monotone-ord-bwd (suc n) (ord-suc n a)).1)))
  (monotone-ord-rinv (suc n) (ord-suc n a)) ;

thr-bot-lem (n : Nat) (a : Ord (suc n)) (b : Two) (hyp : Id Two (thr-pred n a b (inr tt)) zero2) :
 Id (Ord (suc (suc n))) (thr-ord n a b) (inl a) =
 H.transH (H.apH (\ s -> monotone-ord-fwd-suc n s (restrict n (thr-pred n a b, thr-mono n a b))) hyp)
  (H.apH (\ v -> inl v)
   (H.transH (H.apH (monotone-ord-fwd n)
     (Pl.Sigma-eq (Ord n -> Two) (is-monotone-Ord n) (restrict n (thr-pred n a b, thr-mono n a b)).1 (monotone-ord-bwd n a).1
       (restrict n (thr-pred n a b, thr-mono n a b)).2 (monotone-ord-bwd n a).2
       (FL.funext (Ord n) (\ o -> Two) (restrict n (thr-pred n a b, thr-mono n a b)).1 (monotone-ord-bwd n a).1
         (\ o -> H.apH (monotone-ord-bwd n a).1 (deface-inl n o)))
       (is-monotone-Ord-is-prop n (monotone-ord-bwd n a).1)))
    (monotone-ord-rinv n a))) ;

------------------------------------------------------------------------
-- the non-bottom indicator

nbot : (n : Nat) -> Ord (suc n) -> Two = split {
 zero -> split { inl u -> zero2 ; inr u -> one2 } ;
 suc n | r -> split { inl x -> r x ; inr u -> one2 } } ;

nbot-top : (n : Nat) -> Id Two (nbot n (inr tt)) one2 = split { zero -> refl one2 ; suc n -> refl one2 } ;

tag (A : U l) : Sum Top A -> Two = split { inl u -> zero2 ; inr a -> one2 } ;

baux-top (n : Nat) : (r : Sum Top (Ord (suc n))) -> Id Two ((monotone-ord-bwd-aux n r).1 (inr tt)) (tag (Ord (suc n)) r) = split {
 inl u -> refl zero2 ; inr c -> refl one2 } ;

tag-lift (m : Nat) : (r : Sum Top (Ord (suc m))) -> Id Two (tag (Ord (suc (suc m))) (ord-unsuc-lift m r)) (tag (Ord (suc m)) r) = split {
 inl u -> refl zero2 ; inr c -> refl one2 } ;

unL-tag : (m : Nat) (a : Ord (suc m)) -> Id Two (tag (Ord (suc m)) (unsucL m a)) (nbot m a) = split {
 zero -> split { inl u -> refl zero2 ; inr u -> refl one2 } ;
 suc m | r -> split {
  inl y -> H.transH (tag-lift m (unsucL m y)) (r y) ;
  inr u -> refl one2 } } ;

un-tag (m : Nat) : (a : Ord (suc (suc m))) -> Id Two (tag (Ord (suc m)) (ord-unsuc m a)) (nbot (suc m) a) = split {
 inl a -> unL-tag m a ; inr u -> refl one2 } ;

sigtop : (n : Nat) (a : Ord (suc n)) -> Id Two (sval n a (inr tt)) (nbot n a) = split {
 zero -> split {
  inl u -> H.apH (\ v -> inl v) (isTop u tt) ;
  inr u -> H.apH (\ v -> inr v) (isTop u tt) } ;
 suc m -> \ a -> H.transH (baux-top m (ord-unsuc m a)) (un-tag m a) } ;

------------------------------------------------------------------------
-- the closed forms

thr-nonbot (n : Nat) (a : Ord (suc n)) (b : Two) (q : Id Two (nbot n a) one2) :
 Id (Ord (suc (suc n))) (thr-ord n a b) (ord-suc n a) =
 thr-top n a b (H.transH (H.apH (\ s -> interp b s one2) (H.transH (sigtop n a) q)) (interp-rr b)) ;

thr-ord-one (n : Nat) (a : Ord (suc n)) : Id (Ord (suc (suc n))) (thr-ord n a one2) (ord-suc n a) =
 thr-top n a one2 (refl one2) ;

thr0val (n : Nat) (a : Ord (suc n)) : Two -> Ord (suc (suc n)) = split {
 inl u -> inl a ; inr u -> ord-suc n a } ;

thr-zero-eq (n : Nat) (a : Ord (suc n)) (w : Top) : (v : Two) -> Id Two (sval n a (inr tt)) v ->
 Id (Ord (suc (suc n))) (thr-ord n a (inl w)) (thr0val n a v) = split {
 inl u -> \ p -> thr-bot-lem n a (inl w) (H.transH p (H.apH (\ t -> inl t) (isTop u tt))) ;
 inr u -> \ p -> thr-top n a (inl w) (H.transH p (H.apH (\ t -> inr t) (isTop u tt))) } ;

thr0val-inl (n : Nat) (a : Ord (suc n)) : (v : Two) ->
 Id (Ord (suc (suc (suc n)))) (inl (thr0val n a v)) (thr0val (suc n) (inl a) v) = split {
 inl u -> refl (inl (inl a)) ; inr u -> refl (inl (ord-suc n a)) } ;

thr-dnilast (n : Nat) (a : Ord (suc n)) : (b : Two) ->
 Id (Ord (suc (suc (suc n)))) (inl (thr-ord n a b)) (thr-ord (suc n) (inl a) b) = split {
 inr u -> H.transH (H.apH (\ v -> inl v) (thr-top n a (inr u) (refl one2)))
   (H.symH (thr-top (suc n) (inl a) (inr u) (refl one2))) ;
 inl u -> H.transH (H.apH (\ v -> inl v) (thr-zero-eq n a u (nbot n a) (sigtop n a)))
   (H.transH (thr0val-inl n a (nbot n a))
    (H.symH (thr-zero-eq (suc n) (inl a) u (nbot n a) (sigtop (suc n) (inl a))))) } ;
