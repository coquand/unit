-- Identify the outgoing fibre map with the usual postcomposition maps.
-- One lemma handles either leg. Stability makes loops in its target
-- commute, so CommutingLoops.Factor identifies the induced maps without
-- a comparison of pointing paths. Pi1Product then detects the common
-- kernel. Exactness still concerns HomologyFibre's same boundary.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module PM = Pi0Maps[l] ;
open HigherCat ; open Constructions ; open Composition ; open Zero ; open HGroups ; open Pi0[l] ;

module Sequence (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee)
 (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv))
 (po : DPushout.DSquare[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pushout) (S : Ob D) {
 module Q = HomologyFibre.Sequence[Cc, Bb, Ee, P, ii, jj, uu, vv, ss, po, S] ;
 module Product = Pi1Product[l].Product[Hom D S Bb, Hom D S Ee, zmap S Bb, zmap S Ee] ;
 module Leg (T : Ob D) (f : Hom D Cc T)
  (proj : ((Hom D S Bb) * (Hom D S Ee)) -> Hom D S T)
  (point : Id (Hom D S T) (proj (zmap S Bb, zmap S Ee)) (zmap S T))
  (over : (c : Hom D S Cc) -> Id (Hom D S T) (proj (Q.comparison c).1) (hcomp {D} c f)) {
  module Post = HGroupMaps.Post[S, Cc, T, f] ;
  module G = LoopGroup[S, T] ;
  module E = PM.EquivalenceHom[LoopGrp[Hom D S T, zmap S T].grp, G.grp.G, G.e] ;
  module Proj = PM.Pointed[(Hom D S Bb) * (Hom D S Ee), Hom D S T,
   (zmap S Bb, zmap S Ee), zmap S T, proj, point] ;
  module Comm = CommutingLoops.Target[Hom D S T, zmap S T, stable-comm S T] ;
  module First = Comm.Factor[Q.F.Cone, (Hom D S Bb) * (Hom D S Ee), Q.F.point, (zmap S Bb, zmap S Ee),
   \ w -> w.1, proj, \ w -> proj w.1, refl (zmap S Bb, zmap S Ee), point, point, \ w -> refl (proj w.1)] ;
  module Second = Comm.Factor[Hom D S Cc, Q.F.Cone, zmap S Cc, Q.F.point,
   Q.comparison, \ w -> proj w.1, \ c -> hcomp {D} c f, Q.comparison-point, point, zero-post S f, over] ;
  groups (q : Q.B.grp.G) : Id LoopGrp[Hom D S T, zmap S T].grp.G
   (Proj.M.map (Q.outgoing q)) (G.e.1 (Post.map q)) =
   H.transH (First.groups (Q.Target.components.1 (Q.B.e.1 q)))
    (H.transH (Second.groups (Q.B.e.1 q)) (H.symH (Post.square q))) ;
  unit : Id LoopGrp[Hom D S T, zmap S T].grp.G (G.e.1 G.grp.e) LoopGrp[Hom D S T, zmap S T].grp.e =
   PM.Laws[G.grp, LoopGrp[Hom D S T, zmap S T].grp, G.e.1, E.forward].one ;
  killed (a : Q.A.grp.G) : Id G.grp.G (Post.map (Q.connecting a)) G.grp.e =
   Equivalences[l].injective G.grp.G LoopGrp[Hom D S T, zmap S T].grp.G G.e.1 G.e.2 (Post.map (Q.connecting a)) G.grp.e
    (H.transH (H.symH (groups (Q.connecting a)))
     (H.transH (H.apH Proj.M.map (Q.zero a))
      (H.transH PM.Laws[Product.G.grp, LoopGrp[Hom D S T, zmap S T].grp, Proj.M.map, Proj.M.mul].one (H.symH unit)))) ;
 } ;
 module Left = Leg[Bb, ii, \ w -> w.1, refl (zmap S Bb), \ c -> refl (hcomp {D} c ii)] ;
 module Right = Leg[Ee, jj, \ w -> w.2, refl (zmap S Ee), \ c -> refl (hcomp {D} c jj)] ;
 exact (q : Q.B.grp.G) (hi : Id Left.G.grp.G (Left.Post.map q) Left.G.grp.e)
  (hj : Id Right.G.grp.G (Right.Post.map q) Right.G.grp.e) : Q.Image q =
  Q.exact q (Product.null (Q.outgoing q)
   (H.transH (Left.groups q) (H.transH (H.apH Left.G.e.1 hi) Left.unit))
   (H.transH (Right.groups q) (H.transH (H.apH Right.G.e.1 hj) Right.unit))) ;
} ;
