-- A class of loops in a product is zero iff both projected classes
-- are zero. Effectiveness of pi0 supplies merely null projections;
-- pair-path-uniq then contracts the loop. This uses no choice, and
-- applies to the actual pointed projection homomorphisms.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Pi0[l] ;
module PM = Pi0Maps[l] ; module TC = TruncationCombinators[l] ; module Tr = Truncation[l] ;

module Product (B E : U l) (b : B) (e : E) {
 module G = LoopGrp[B * E, (b, e)] ;
 module Fst = PM.Pointed[B * E, B, (b, e), b, \ w -> w.1, refl b] ;
 module Snd = PM.Pointed[B * E, E, (b, e), e, \ w -> w.2, refl e] ;
 -- Merely choose a product loop class with specified projections.
 -- On representatives it is pair-path; quotient induction needs no choice.
 Lift (a : LoopGrp[B, b].grp.G) (c : LoopGrp[E, e].grp.G) : U l =
  Tr.Trunc[(r : G.grp.G) * Id LoopGrp[B, b].grp.G (Fst.M.map r) a * Id LoopGrp[E, e].grp.G (Snd.M.map r) c].carrier ;
 lift-prop (a : LoopGrp[B, b].grp.G) (c : LoopGrp[E, e].grp.G) : isProp (Lift a c) =
  Tr.Trunc[(r : G.grp.G) * Id LoopGrp[B, b].grp.G (Fst.M.map r) a * Id LoopGrp[E, e].grp.G (Snd.M.map r) c].proposition ;
 lift-cls (a : Id B b b) (c : Id E e e) : Lift (cls a) (cls c) =
  Tr.Trunc[(r : G.grp.G) * Id LoopGrp[B, b].grp.G (Fst.M.map r) (cls a) * Id LoopGrp[E, e].grp.G (Snd.M.map r) (cls c)].inc
   (cls (EquivAp[l].pair-path a c),
    transH (pi0-map-cls (Id (B * E) (b, e) (b, e)) (Id B b b) Fst.loop (EquivAp[l].pair-path a c))
     (apH (\ t -> cls t) (transH (Conj[l].conj-refl-path (apH (\ t -> t.1) (EquivAp[l].pair-path a c))) (EquivAp[l].pair-path-fst a c))),
    transH (pi0-map-cls (Id (B * E) (b, e) (b, e)) (Id E e e) Snd.loop (EquivAp[l].pair-path a c))
     (apH (\ t -> cls t) (transH (Conj[l].conj-refl-path (apH (\ t -> t.2) (EquivAp[l].pair-path a c))) (EquivAp[l].pair-path-snd a c)))) ;
 lift (a : LoopGrp[B, b].grp.G) (c : LoopGrp[E, e].grp.G) : Lift a c =
  pi0-ind (Id B b b) @l (\ a1 -> Lift a1 c) (\ a1 -> lift-prop a1 c)
   (\ r -> pi0-ind (Id E e e) @l (\ c1 -> Lift (cls r) c1) (\ c1 -> lift-prop (cls r) c1) (lift-cls r) c) a ;
 null-loop (q : Id (B * E) (b, e) (b, e))
  (a : Id (Id B b b) (Fst.loop q) (refl b)) (c : Id (Id E e e) (Snd.loop q) (refl e)) :
  Id (Id (B * E) (b, e) (b, e)) q (refl (b, e)) =
  EquivAp[l].pair-path-uniq q (refl (b, e))
   (transH (symH (Conj[l].conj-refl-path (apH (\ w -> w.1) q))) a)
   (transH (symH (Conj[l].conj-refl-path (apH (\ w -> w.2) q))) c) ;
 null-cls (q : Id (B * E) (b, e) (b, e))
  (a : Id LoopGrp[B, b].grp.G (Fst.M.map (cls q)) LoopGrp[B, b].grp.e)
  (c : Id LoopGrp[E, e].grp.G (Snd.M.map (cls q)) LoopGrp[E, e].grp.e) : Id G.grp.G (cls q) G.grp.e =
  TC.rec (Id (Id B b b) (Fst.loop q) (refl b)) @l (Id G.grp.G (cls q) G.grp.e) (G.grp.setG (cls q) G.grp.e)
   (\ aa -> TC.rec (Id (Id E e e) (Snd.loop q) (refl e)) @l (Id G.grp.G (cls q) G.grp.e) (G.grp.setG (cls q) G.grp.e)
     (\ cc -> apH (\ r -> cls r) (null-loop q aa cc))
     (pi0-eff (Id E e e) (Snd.loop q) (refl e)
      (transH (symH (pi0-map-cls (Id (B * E) (b, e) (b, e)) (Id E e e) Snd.loop q)) c)))
   (pi0-eff (Id B b b) (Fst.loop q) (refl b)
    (transH (symH (pi0-map-cls (Id (B * E) (b, e) (b, e)) (Id B b b) Fst.loop q)) a)) ;
 null (q : G.grp.G)
  (a : Id LoopGrp[B, b].grp.G (Fst.M.map q) LoopGrp[B, b].grp.e)
  (c : Id LoopGrp[E, e].grp.G (Snd.M.map q) LoopGrp[E, e].grp.e) : Id G.grp.G q G.grp.e =
  pi0-ind (Id (B * E) (b, e) (b, e)) @l
   (\ q1 -> Id LoopGrp[B, b].grp.G (Fst.M.map q1) LoopGrp[B, b].grp.e ->
     Id LoopGrp[E, e].grp.G (Snd.M.map q1) LoopGrp[E, e].grp.e -> Id G.grp.G q1 G.grp.e)
   (\ q1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi
     (Id LoopGrp[B, b].grp.G (Fst.M.map q1) LoopGrp[B, b].grp.e)
     (\ aa -> Id LoopGrp[E, e].grp.G (Snd.M.map q1) LoopGrp[E, e].grp.e -> Id G.grp.G q1 G.grp.e)
     (\ aa -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi
       (Id LoopGrp[E, e].grp.G (Snd.M.map q1) LoopGrp[E, e].grp.e)
       (\ cc -> Id G.grp.G q1 G.grp.e) (\ cc -> G.grp.setG q1 G.grp.e))) null-cls q a c ;
} ;
