-- Fubini: (X * Y) (x) A is X (x) (Y (x) A) (H2).
--   fub (X * Y) (x) A -> X (x) (Y (x) A): the lift of
--   (x, y) |-> eta_y eta_x.
--   unfub X (x) (Y (x) A) -> (X * Y) (x) A: the lift of
--   x |-> lift (y |-> eta_(x, y)).
--   fub unfub = id, by ext over X * Y: eta_z (fub unfub) = (eta_z fub)
--   unfub = (eta_y eta_x) unfub = eta_y (eta_x unfub) = eta_y lift(..) =
--   eta_(x, y)  (associativity and three times lift-beta).
--   unfub fub = id, by ext over X and then over Y:
--   eta_y (eta_x (unfub fub)) = eta_y ((eta_x unfub) fub)
--   = eta_y (lift(..) fub) = (eta_y lift(..)) fub = eta_(x, y) fub
--   = eta_y eta_x.
open Base ;
module H = Paths[l] ;
open HigherCat ; open Constructions ; open Composition ; open CompLaws ; open Associativity ; open Invertible ; open FullyFaithful ;
open Copower ;

module FubiniOf (A : Ob D) (X Y : U k) {
 P : U k = X * Y ;
 YA : Ob D = tensor Y A ;
 XYA : Ob D = tensor X YA ;
 PA : Ob D = tensor P A ;

 fub-family (z : P) : Hom D A XYA = hcomp {D} (eta Y A z.2) (eta X YA z.1) ;
 fub : Hom D PA XYA = lift P A XYA fub-family ;

 unfub-row (x : X) : Hom D YA PA = lift Y A PA (\ y -> eta P A (x, y)) ;
 unfub : Hom D XYA PA = lift X YA PA unfub-row ;

 fub-unfub-pt (z : P) :
  Id (Hom D A PA) (hcomp {D} (eta P A z) (hcomp {D} fub unfub)) (hcomp {D} (eta P A z) (id-hom PA)) =
  H.transH (H.symH (hcomp-assoc D (A, PA, XYA, PA, eta P A z, fub, unfub)))
  (H.transH (H.apH (\ u -> hcomp {D} u unfub) (lift-beta P A XYA fub-family z))
  (H.transH (hcomp-assoc D (A, YA, XYA, PA, eta Y A z.2, eta X YA z.1, unfub))
  (H.transH (H.apH (\ u -> hcomp {D} (eta Y A z.2) u) (lift-beta X YA PA unfub-row z.1))
  (H.transH (lift-beta Y A PA (\ y -> eta P A (z.1, y)) z.2)
   (H.symH (hcomp-unit-r (eta P A z))))))) ;

 unfub-fub-pt (x : X) (y : Y) :
  Id (Hom D A XYA) (hcomp {D} (eta Y A y) (hcomp {D} (eta X YA x) (hcomp {D} unfub fub)))
   (hcomp {D} (eta Y A y) (hcomp {D} (eta X YA x) (id-hom XYA))) =
  H.transH (H.apH (\ u -> hcomp {D} (eta Y A y) u) (H.symH (hcomp-assoc D (YA, XYA, PA, XYA, eta X YA x, unfub, fub))))
  (H.transH (H.apH (\ u -> hcomp {D} (eta Y A y) (hcomp {D} u fub)) (lift-beta X YA PA unfub-row x))
  (H.transH (H.symH (hcomp-assoc D (A, YA, PA, XYA, eta Y A y, unfub-row x, fub)))
  (H.transH (H.apH (\ u -> hcomp {D} u fub) (lift-beta Y A PA (\ y1 -> eta P A (x, y1)) y))
  (H.transH (lift-beta P A XYA fub-family (x, y))
   (H.apH (\ u -> hcomp {D} (eta Y A y) u) (H.symH (hcomp-unit-r (eta X YA x)))))))) ;

 fubini-has-inv : has-inv fub =
  (unfub,
   ext P A PA (hcomp {D} fub unfub) (id-hom PA) fub-unfub-pt,
   ext X YA XYA (hcomp {D} unfub fub) (id-hom XYA) (\ x ->
    ext Y A XYA (hcomp {D} (eta X YA x) (hcomp {D} unfub fub)) (hcomp {D} (eta X YA x) (id-hom XYA)) (unfub-fub-pt x))) ;

 fubini : is-inv fub = has-inv-is-inv fub fubini-has-inv ;
} ;
