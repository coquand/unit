-- The face map on ordinals (Agda Interval/FaceOrdCompat).
--   ev-point: the functor named by an object phi of Fun A B, at an object
--   a, is ev <phi, a> (both are ev o <phi o pi1 o <1, a>, pi2 o <1, a>>).
--   face-pw-gen: the functor named by face u is z |-> face-ord (c20 u) (c20 z)
--   (exp-eval, then the projections of the slice <u o !, 1> o z).
--   c20-face-gen-u: the ordinal of face u is inl (c20 u): its monotone map
--   is face-ord (c20 u), the monotone map of inl (c20 u).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open ExpComparison ; open Exponentials ; open ExpEval ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open Construction20 ; open FaceOrd ; open FaceMap ;

-- the point <1, a> of One x A, through unit-right
ev-point-unit (A : Cat) (a : Ob A) :
 Id (Map One (times One A)) (comp {One} {A} {times One A} (unit-right A) a) (pair {One} {A} {One} (idMap One) a) =
 H.transH (pair-nat {One} {A} {A} {One} (bang A) (idMap A) a)
  (pair-ap (one-path (comp {One} {A} {One} (bang A) a) (idMap One)) (comp-id-l {One} {A} a)) ;

ev-point-pair (A B : Cat) (phi : Map One (Fun A B)) (a : Map One A) :
 Id (Map One (times (Fun A B) A)) (comp {One} {times One A} {times (Fun A B) A} (pair (comp {times One A} {One} {Fun A B} phi (pi1 One A)) (pi2 One A)) (pair {One} {A} {One} (idMap One) a))
  (pair {Fun A B} {A} {One} phi a) =
 H.transH (pair-nat (comp {times One A} {One} {Fun A B} phi (pi1 One A)) (pi2 One A) (pair {One} {A} {One} (idMap One) a))
  (pair-ap (H.transH (composeA {One} {times One A} {One} {Fun A B} phi (pi1 One A) (pair {One} {A} {One} (idMap One) a))
             (H.transH (ccr {One} {One} {Fun A B} phi (pair-beta1 (idMap One) a)) (comp-id-r {One} {Fun A B} phi)))
           (pair-beta2 (idMap One) a)) ;

ev-point (A B : Cat) (phi : Ob (Fun A B)) (a : Ob A) :
 Id (Map One B) (Ob-map (ob-to-map A B phi) a) (comp (ev A B) (pair {Fun A B} {A} {One} phi a)) =
 calc (Map One B) {
  comp {One} {A} {B} (comp {A} {times One A} {B} (exp-comparison A B One phi) (unit-right A)) a
  =< composeA {One} {A} {times One A} {B} (exp-comparison A B One phi) (unit-right A) a >
  comp {One} {times One A} {B} (exp-comparison A B One phi) (comp {One} {A} {times One A} (unit-right A) a)
  =< ccr {One} {times One A} {B} (exp-comparison A B One phi) (ev-point-unit A a) >
  comp {One} {times One A} {B} (exp-comparison A B One phi) (pair {One} {A} {One} (idMap One) a)
  =< composeA {One} {times One A} {times (Fun A B) A} {B} (ev A B)
      (pair (comp {times One A} {One} {Fun A B} phi (pi1 One A)) (pi2 One A)) (pair {One} {A} {One} (idMap One) a) >
  comp {One} {times (Fun A B) A} {B} (ev A B) (comp {One} {times One A} {times (Fun A B) A} (pair (comp {times One A} {One} {Fun A B} phi (pi1 One A)) (pi2 One A)) (pair {One} {A} {One} (idMap One) a))
  =< ccr (ev A B) (ev-point-pair A B phi a) >
  comp (ev A B) (pair {Fun A B} {A} {One} phi a) } ;

-- the projections of the slice <u o !, 1> at an object z
slice-pi1 {X A : Cat} (u : Ob X) (z : Ob A) : Id (Ob X) (Ob-map (pi1 X A) (Ob-map (slice {X} {A} u) z)) u =
 H.transH (comp-assoc {One} {A} {times X A} {X} (pi1 X A) (slice {X} {A} u) z)
 (H.transH (ccl {One} {A} {X} z (pair-beta1 (comp {A} {One} {X} u (bang A)) (idMap A)))
 (H.transH (composeA {One} {A} {One} {X} u (bang A) z)
 (H.transH (ccr {One} {One} {X} u (one-path (comp {One} {A} {One} (bang A) z) (idMap One)))
  (comp-id-r {One} {X} u)))) ;

slice-pi2 {X A : Cat} (u : Ob X) (z : Ob A) : Id (Ob A) (Ob-map (pi2 X A) (Ob-map (slice {X} {A} u) z)) z =
 H.transH (comp-assoc {One} {A} {times X A} {A} (pi2 X A) (slice {X} {A} u) z)
 (H.transH (ccl {One} {A} {A} z (pair-beta2 (comp {A} {One} {X} u (bang A)) (idMap A)))
  (comp-id-l {One} {A} z)) ;

face-pw-gen (n : Nat) (u z : Ob (Delta n)) :
 Id Two (ob-to-2 (ob-to-map (Delta n) I (Ob-map (face n) u)) z)
  (face-ord n ((construction-20 n).1 u) ((construction-20 n).1 z)) =
 H.transH (H.apH (\ f -> ob-to-2 f z) (exp-eval (Delta n) I (Delta n) (face-adj n) u))
 (H.transH (H.apH I-ob.1 (composeA {One} {Delta n} {times (Delta n) (Delta n)} {I} (face-adj n) (slice {Delta n} {Delta n} u) z))
 (H.transH (I-char-ob-to-2 (times (Delta n) (Delta n)) (face-p n, face-p-mono n) (Ob-map (slice {Delta n} {Delta n} u) z))
 (H.transH (H.apH (\ v -> face-ord n ((construction-20 n).1 v)
     ((construction-20 n).1 (Ob-map (pi2 (Delta n) (Delta n)) (Ob-map (slice {Delta n} {Delta n} u) z)))) (slice-pi1 {Delta n} {Delta n} u z))
  (H.apH (\ v -> face-ord n ((construction-20 n).1 u) ((construction-20 n).1 v)) (slice-pi2 {Delta n} {Delta n} u z))))) ;

c20-face-gen-u (n : Nat) (u : Ob (Delta n)) :
 Id (Ord (suc n)) ((construction-20 (suc n)).1 (Ob-map (face n) u)) (inl ((construction-20 n).1 u)) =
 H.transH (H.apH (monotone-ord-fwd n)
   (Pl.Sigma-eq (Ord n -> Two) (is-monotone-Ord n)
     ((monotone-transfer n).1 (I-char-comparison (Delta n) (ob-to-map (Delta n) I (Ob-map (face n) u)))).1
     (monotone-ord-bwd n (inl ((construction-20 n).1 u))).1
     ((monotone-transfer n).1 (I-char-comparison (Delta n) (ob-to-map (Delta n) I (Ob-map (face n) u)))).2
     (monotone-ord-bwd n (inl ((construction-20 n).1 u))).2
     (FL.funext (Ord n) (\ o -> Two)
       ((monotone-transfer n).1 (I-char-comparison (Delta n) (ob-to-map (Delta n) I (Ob-map (face n) u)))).1
       (monotone-ord-bwd n (inl ((construction-20 n).1 u))).1
       (\ o -> H.transH (face-pw-gen n u ((construction-20 n).2.sec o))
         (H.apH (face-ord n ((construction-20 n).1 u)) ((construction-20 n).2.sec-eq o))))
     (is-monotone-Ord-is-prop n (monotone-ord-bwd n (inl ((construction-20 n).1 u))).1)))
  (monotone-ord-rinv n (inl ((construction-20 n).1 u))) ;
