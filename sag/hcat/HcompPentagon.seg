-- The pentagon for composition inside a category C (statement only).
-- Level 2: the associator hcomp-assoc is defined at level 2.
--   For f1 : a -> b, f2 : b -> c, f3 : c -> d, f4 : d -> e, with
--   al(x, y, z) : (x y) z = x (y z) the associator (hcomp-assoc),
--     al(f1 f2, f3, f4) . al(f1, f2, f3 f4)
--       = (al(f1, f2, f3) f4 . al(f1, f2 f3, f4)) . f1 al(f2, f3, f4).
--   The same shape as the pentagonator of Cat.
open Base ;
module H = Paths[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ;

Pentagon (C : Cat) {a b c d e : Ob C} (f1 : Hom C a b) (f2 : Hom C b c) (f3 : Hom C c d) (f4 : Hom C d e) : U l =
 Id (Id (Hom C a e) (hcomp {C} (hcomp {C} (hcomp {C} f1 f2) f3) f4) (hcomp {C} f1 (hcomp {C} f2 (hcomp {C} f3 f4))))
  (H.transH (hcomp-assoc C (a, c, d, e, hcomp {C} f1 f2, f3, f4)) (hcomp-assoc C (a, b, c, e, f1, f2, hcomp {C} f3 f4)))
  (H.transH (H.transH (H.apH (\ u -> hcomp {C} u f4) (hcomp-assoc C (a, b, c, d, f1, f2, f3)))
                      (hcomp-assoc C (a, b, d, e, f1, hcomp {C} f2 f3, f4)))
   (H.apH (\ u -> hcomp {C} f1 u) (hcomp-assoc C (b, c, d, e, f2, f3, f4)))) ;
