-- sag/hcat: higher categories from the Sattler-Wärn axioms (DESIGN.md).
-- A port of the Agda proof of Lemma 26 (~/AGDA), in plain dependent type
-- theory: no judgemental shortcut for Cat.
--
-- Theory: univalence and the two parts of replacement, as in
-- sag/categories; fe derived from univalence.  Inside it the axioms of
-- Cat are parameters of nested segments, one per level of coherence:
--   Wild       level 1: Cat, Map, comp, idMap, comp-assoc, comp-id-l/r
--   Structure  univalence of Cat, terminal category, pullbacks,
--              exponentials, the interval, Segal, Rezk, I detects
--              equivalences
--   Coh2       level 2: the pentagon and the triangle
-- A file is imported in the outermost segment whose parameters it uses,
-- so the level a theorem needs is read from where it is checked.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 import EquivalenceLemmas ; import Equivalences ; import EquivProp ;
 import PathAlgebra ; import Cayley ; import GroupoidWords ; import PathMoves ; import AffineHLevels ; import Finite ; import EquivAp ;
 import Truncation ;

 module Wild {
  level l ;
  Cat : U l+ ;
  Map (A B : Cat) : U l ;
  comp {A B C : Cat} (g : Map B C) (f : Map A B) : Map A C ;
  idMap (C : Cat) : Map C C ;
  comp-assoc {A B C D : Cat} (h : Map C D) (g : Map B C) (f : Map A B) :
   Id (Map A D) (comp h (comp g f)) (comp (comp h g) f) ;
  comp-id-l {A B : Cat} (f : Map A B) : Id (Map A B) (comp (idMap B) f) f ;
  comp-id-r {A B : Cat} (f : Map A B) : Id (Map A B) (comp f (idMap A)) f ;
  import WildCat ; import Naturality ; import Retracts ;

  module Structure {
   -- univalence of Cat (SW2) and the terminal category (SW3)
   cat-univalence (C : Cat) : FunExtUA[l+].isContr (WildCat.Equiv-from C) ;
   One : Cat ;
   terminal (C : Cat) : FunExtUA[l].isContr (Map C One) ;
   import HigherCat ;
   -- the interval: two objects (SW4)
   I : Cat ;
   I-ob : Prelude[l].Equiv (HigherCat.Ob I) (Finite[l].Two) ;
   import Constructions ;
   -- pullbacks (SW11)
   pb {B A C : Cat} (f : Map B A) (g : Map C A) : Cat ;
   pb-pr1 {B A C : Cat} (f : Map B A) (g : Map C A) : Map (pb f g) B ;
   pb-pr2 {B A C : Cat} (f : Map B A) (g : Map C A) : Map (pb f g) C ;
   pb-comm {B A C : Cat} (f : Map B A) (g : Map C A) :
    Id (Map (pb f g) A) (comp f (pb-pr1 f g)) (comp g (pb-pr2 f g)) ;
   import PullbackCone ;
   pb-is-equiv {B A C : Cat} (f : Map B A) (g : Map C A) (X : Cat) :
    Prelude[l].isEquiv (Map X (pb f g)) (PullbackCone.Cone f g X) (PullbackCone.pb-comparison f g X) ;
   import Pullbacks ;
   -- exponentials (SW3)
   Fun (A B : Cat) : Cat ;
   ev (A B : Cat) : Map (Pullbacks.times (Fun A B) A) B ;
   import ExpComparison ;
   exp-is-equiv (A B X : Cat) :
    Prelude[l].isEquiv (Map X (Fun A B)) (Map (Pullbacks.times X A) B) (ExpComparison.exp-comparison A B X) ;
   import Exponentials ; import ExpEval ; import UnitIso ;
   import OrdMonotone ;
   -- the interval: morphisms go from 0 to 1 (SW4), and I classifies
   -- monotone maps (SW5)
   import MonotoneMaps ;
   I-mor-order (g : Constructions.Mor I) :
    Finite[l].leq2 (I-ob.1 (Constructions.dom g)) (I-ob.1 (Constructions.cod g)) ;
   import IntervalChar ;
   I-char-inverse (C : Cat) (w : MonotoneMaps.Monotone C) : Map C I ;
   I-char-rinv (C : Cat) (w : MonotoneMaps.Monotone C) :
    Id (MonotoneMaps.Monotone C) (IntervalChar.I-char-comparison C (I-char-inverse C w)) w ;
   I-char-linv (C : Cat) (f : Map C I) :
    Id (Map C I) (I-char-inverse C (IntervalChar.I-char-comparison C f)) f ;
   import Interval ; import Construction20 ; import HLevels ; import SigmaEquiv ; import FibreLemmas ;
   import OrdCompare ; import FaceOrd ; import OrdComb ; import IntervalPosetal ;
   import LastEdge ;
   -- the Segal condition (SW6)
   import SegalComparison ;
   segal-is-equiv (C : Cat) :
    Prelude[l].isEquiv (Map (Interval.Delta (suc (suc zero))) C) (SegalComparison.ComposablePair C) (SegalComparison.segal-comparison C) ;
   import Segal ; import FaceMap ; import FaceOrdCompat ;
   import PosetalCore ; import FunIPosetal ;
   import ProductMap ; import Squares ; import SquareAlg ;
   import FaceTop ; import PushoutBase ; import PushoutDef ; import PushoutProof ;
   import GluingSquare ; import SegalCoface ; import SimplexRetract ; import SimplexRetractValues ;
   import SquareGeom ; import ProdHomSet ;
   import Chains ; import HomPaths ; import Composition ; import SpineTwo ; import Invertible ;
   -- the Rezk axiom (Wärn, Axiom 36), as univalence of objects: the
   -- invertible morphisms out of a form a contractible type
   rezk (C : Cat) (a : HigherCat.Ob C) : FunExtUA[l].isContr ((b : HigherCat.Ob C) * Invertible.ObIso C a b) ;
   -- I detects equivalences (Wärn, Axiom 38)
   I-detects-equiv {A B : Cat} (f : Map A B)
    (e : Prelude[l].isEquiv (Constructions.Mor A) (Constructions.Mor B) (WildCat.post-comp f I)) : WildCat.isIso f ;

   -- level 2: the pentagon and the triangle (footnote to SW6)
   module Coh2 {
    pentagonator {A B C D E : Cat} (f : Map D E) (g : Map C D) (h : Map B C) (e : Map A B) :
     Id (Id (Map A E) (comp (comp (comp f g) h) e) (comp f (comp g (comp h e))))
      (Paths[l].transH (WildCat.composeA (comp f g) h e) (WildCat.composeA f g (comp h e)))
      (Paths[l].transH (Paths[l].transH (WildCat.ccl e (WildCat.composeA f g h)) (WildCat.composeA f (comp g h) e))
       (WildCat.ccr f (WildCat.composeA g h e))) ;
    triangle2 {A B C : Cat} (f : Map A B) (g : Map B C) :
     Id (Id (Map A C) (comp (comp g (idMap B)) f) (comp g f))
      (Paths[l].transH (WildCat.composeA g (idMap B) f) (WildCat.ccr g (comp-id-l f)))
      (WildCat.ccl f (comp-id-r g)) ;
    import CatCoherence ; import MacLane ;
    import ProductPentagonFrames ; import ProductPentagon ; import ProductPentagonR ; import ProductPentagonR2 ;
    import ConeUnit ; import ConeAlg ; import ConeComp ; import PushoutRetract ;
    import TimesICone ; import TimesIPost ; import TimesI ; import SegalGeom ; import Lemma26 ;
    import SpineSquare ; import HomFunctor ; import ChainFunctor ; import SegalAll ; import CompLaws ; import Associativity ;
    import FullyFaithful ;
   } ;
  } ;
 } ;
} ;
