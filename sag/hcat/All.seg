-- sag/hcat: higher categories from the Sattler-Wärn axioms (DESIGN.md).
-- A port of the Agda proof of Lemma 26 (~/AGDA), in plain dependent type
-- theory: no judgemental shortcut for Cat.
--
-- Theory: univalence and the two parts of replacement, as in
-- sag/categories; fe derived from univalence.  Inside it the axioms of
-- Cat are parameters of nested segments, one per level of coherence:
--   Wild       level 1: Cat, Map, comp, idMap, comp-assoc, comp-id-l/r
--   Structure  univalence of Cat, terminal category, pullbacks,
--              exponentials, the interval, Segal, Rezk, I detects
--              equivalences
--   Coh2       level 2: the pentagon and the triangle
-- A file is imported in the outermost segment whose parameters it uses,
-- so the level a theorem needs is read from where it is checked.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 import EquivalenceLemmas ; import Equivalences ; import EquivProp ;
 import PathAlgebra ; import Cayley ; import GroupoidWords ; import PathMoves ; import AffineHLevels ; import Finite ; import EquivAp ;
 import Truncation ; import Conj ; import PullbackPaths ; import PullbackBoundary ; import PointedPullback ; import PullbackNaturality ;
 import Torsor ; import TruncationCombinators ; import Quotient ; import Group ; import QGrp ; import Pi0 ; import Pi0Maps ; import AbelianDifference ; import Pi1Product ; import PullbackExact ;

 module Wild {
  level l ;
  Cat : U l+ ;
  Map (A B : Cat) : U l ;
  comp {A B C : Cat} (g : Map B C) (f : Map A B) : Map A C ;
  idMap (C : Cat) : Map C C ;
  comp-assoc {A B C D : Cat} (h : Map C D) (g : Map B C) (f : Map A B) :
   Id (Map A D) (comp h (comp g f)) (comp (comp h g) f) ;
  comp-id-l {A B : Cat} (f : Map A B) : Id (Map A B) (comp (idMap B) f) f ;
  comp-id-r {A B : Cat} (f : Map A B) : Id (Map A B) (comp f (idMap A)) f ;
  import WildCat ; import Naturality ; import Retracts ;

  module Structure {
   -- univalence of Cat (SW2) and the terminal category (SW3)
   cat-univalence (C : Cat) : FunExtUA[l+].isContr (WildCat.Equiv-from C) ;
   One : Cat ;
   terminal (C : Cat) : FunExtUA[l].isContr (Map C One) ;
   import HigherCat ;
   -- the interval: two objects (SW4)
   I : Cat ;
   I-ob : Prelude[l].Equiv (HigherCat.Ob I) (Finite[l].Two) ;
   import Constructions ;
   -- pullbacks (SW11)
   pb {B A C : Cat} (f : Map B A) (g : Map C A) : Cat ;
   pb-pr1 {B A C : Cat} (f : Map B A) (g : Map C A) : Map (pb f g) B ;
   pb-pr2 {B A C : Cat} (f : Map B A) (g : Map C A) : Map (pb f g) C ;
   pb-comm {B A C : Cat} (f : Map B A) (g : Map C A) :
    Id (Map (pb f g) A) (comp f (pb-pr1 f g)) (comp g (pb-pr2 f g)) ;
   import PullbackCone ;
   pb-is-equiv {B A C : Cat} (f : Map B A) (g : Map C A) (X : Cat) :
    Prelude[l].isEquiv (Map X (pb f g)) (PullbackCone.Cone f g X) (PullbackCone.pb-comparison f g X) ;
   import Pullbacks ;
   -- exponentials (SW3)
   Fun (A B : Cat) : Cat ;
   ev (A B : Cat) : Map (Pullbacks.times (Fun A B) A) B ;
   import ExpComparison ;
   exp-is-equiv (A B X : Cat) :
    Prelude[l].isEquiv (Map X (Fun A B)) (Map (Pullbacks.times X A) B) (ExpComparison.exp-comparison A B X) ;
   import Exponentials ; import ExpEval ; import UnitIso ;
   import OrdMonotone ;
   -- the interval: morphisms go from 0 to 1 (SW4), and I classifies
   -- monotone maps (SW5)
   import MonotoneMaps ;
   I-mor-order (g : Constructions.Mor I) :
    Finite[l].leq2 (I-ob.1 (Constructions.dom g)) (I-ob.1 (Constructions.cod g)) ;
   import IntervalChar ;
   I-char-inverse (C : Cat) (w : MonotoneMaps.Monotone C) : Map C I ;
   I-char-rinv (C : Cat) (w : MonotoneMaps.Monotone C) :
    Id (MonotoneMaps.Monotone C) (IntervalChar.I-char-comparison C (I-char-inverse C w)) w ;
   I-char-linv (C : Cat) (f : Map C I) :
    Id (Map C I) (I-char-inverse C (IntervalChar.I-char-comparison C f)) f ;
   import Interval ; import Construction20 ; import HLevels ; import SigmaEquiv ; import FibreLemmas ; import EquivIndBeta ; import UniversalWitness ; import WitnessTransport ;
   import OrdCompare ; import FaceOrd ; import OrdComb ; import IntervalPosetal ;
   import LastEdge ;
   -- the Segal condition (SW6)
   import SegalComparison ;
   segal-is-equiv (C : Cat) :
    Prelude[l].isEquiv (Map (Interval.Delta (suc (suc zero))) C) (SegalComparison.ComposablePair C) (SegalComparison.segal-comparison C) ;
   import Segal ; import FaceMap ; import FaceOrdCompat ;
   import PosetalCore ; import FunIPosetal ;
   import ProductMap ; import Squares ; import SquareAlg ;
   import FaceTop ; import PushoutBase ; import PushoutDef ; import PushoutProof ;
   import GluingSquare ; import SegalCoface ; import SimplexRetract ; import SimplexRetractValues ;
   import SquareGeom ; import ProdHomSet ;
   import Chains ; import HomPaths ; import HomEqCalc ; import HomEqHigher ; import HomEqCoerce ; import HomEqMap ; import HomFunctorPaths ; import HomCells ; import Composition ; import SpineTwo ; import Invertible ; import FibreAlg ; import FibreInclusion ; import FibreSequence ; import FibreTower ; import FibreTowerMaps ; import FibreTowerNaturality ; import CommutingLoops ; import PointedEquivalence ; import PullbackFibre ; import EckmannHilton ; import LoopDifference ; import LoopProduct ; import PullbackSource ; import PullbackDifference ;
   -- the Rezk axiom (Wärn, Axiom 36), as univalence of objects: the
   -- invertible morphisms out of a form a contractible type
   rezk (C : Cat) (a : HigherCat.Ob C) : FunExtUA[l].isContr ((b : HigherCat.Ob C) * Invertible.ObIso C a b) ;
   -- I detects equivalences (Wärn, Axiom 38)
   I-detects-equiv {A B : Cat} (f : Map A B)
    (e : Prelude[l].isEquiv (Constructions.Mor A) (Constructions.Mor B) (WildCat.post-comp f I)) : WildCat.isIso f ;

   -- level 2: the pentagon and the triangle (footnote to SW6)
   module Coh2 {
    pentagonator {A B C D E : Cat} (f : Map D E) (g : Map C D) (h : Map B C) (e : Map A B) :
     Id (Id (Map A E) (comp (comp (comp f g) h) e) (comp f (comp g (comp h e))))
      (Paths[l].transH (WildCat.composeA (comp f g) h e) (WildCat.composeA f g (comp h e)))
      (Paths[l].transH (Paths[l].transH (WildCat.ccl e (WildCat.composeA f g h)) (WildCat.composeA f (comp g h) e))
       (WildCat.ccr f (WildCat.composeA g h e))) ;
    triangle2 {A B C : Cat} (f : Map A B) (g : Map B C) :
     Id (Id (Map A C) (comp (comp g (idMap B)) f) (comp g f))
      (Paths[l].transH (WildCat.composeA g (idMap B) f) (WildCat.ccr g (comp-id-l f)))
      (WildCat.ccl f (comp-id-r g)) ;
    import CatCoherence ; import MacLane ;
    import ProductPentagonFrames ; import ProductPentagon ; import ProductPentagonR ; import ProductPentagonR2 ;
    import ConeUnit ; import ConeAlg ; import ConeComp ; import PushoutRetract ;
    import TimesICone ; import TimesIPost ; import TimesI ; import SegalGeom ; import Lemma26 ;
    import SpineSquare ; import HomFunctor ; import ChainFunctor ; import SegalAll ; import CompLaws ; import Associativity ;
    import FullyFaithful ; import HcompPentagon ; import CatK5 ; import AssocNat ; import CompWitness ; import PentagonReduction ; import HomCompEndpoints ; import HomTriple ; import HomTripleShort ; import HomTripleLongCells ; import HomTripleNormalize ;

    -- level 3: Stasheff's K5 (CatK5): the two pastings of the faces of
    -- the associahedron agree
    module Coh3 {
     k5 {A B C D E F : Cat} (f : Map E F) (g : Map D E) (h : Map C D) (e : Map B C) (d : Map A B) :
      Id (Id (Id (Map A F) CatK5.K5[A, B, C, D, E, F, f, g, h, e, d].V0 CatK5.K5[A, B, C, D, E, F, f, g, h, e, d].Vend)
             CatK5.K5[A, B, C, D, E, F, f, g, h, e, d].L CatK5.K5[A, B, C, D, E, F, f, g, h, e, d].R)
       CatK5.K5[A, B, C, D, E, F, f, g, h, e, d].route1 CatK5.K5[A, B, C, D, E, F, f, g, h, e, d].route2 ;
     import K5Hom ;
    } ;

    -- homology (DESIGN-HOMOLOGY.md): a category D with copowers by
    -- k-small types, k < l.  X (x) A is the colimit of the constant
    -- X-diagram at A; the homology of X with coefficients A.
    module Homology {
     level k ; constraint k < l ;
     D : Cat ;
     tensor (X : U k) (A : HigherCat.Ob D) : HigherCat.Ob D ;
     eta (X : U k) (A : HigherCat.Ob D) (x : X) : Constructions.Hom D A (tensor X A) ;
     import CopowerRestrict ;
     tensor-up (X : U k) (A T : HigherCat.Ob D) :
      Prelude[l].isEquiv (Constructions.Hom D (tensor X A) T) (X -> Constructions.Hom D A T) (CopowerRestrict.restrict X A T) ;
     import Copower ; import TensorMap ; import CopowerWitness ; import CopowerPost ; import TensorInvariance ; import TensorSum ; import Fubini ;
     import ExcCoreAlg ; import TypePushout ; import DPushout ;
     -- temporary: the pentagon of D as a parameter (to be discharged from Coh3)
     module WithPentagon {
      hpent {a b c d e : HigherCat.Ob D} (f1 : Constructions.Hom D a b) (f2 : Constructions.Hom D b c) (f3 : Constructions.Hom D c d) (f4 : Constructions.Hom D d e) : HcompPentagon.Pentagon D f1 f2 f3 f4 ;
      import ExcisionAssoc ; import Excision ;
      -- pointed and stable D (DESIGN-HOMOLOGY.md, H4): a zero object,
      -- suspensions (pushouts 0 <- B -> 0), and stability: Hom (S, -) sends
      -- pushout squares to pullbacks of types
      module Stable {
       zobj : HigherCat.Ob D ;
       zero-init (T : HigherCat.Ob D) : FunExtUA[l].isContr (Constructions.Hom D zobj T) ;
       zero-term (T : HigherCat.Ob D) : FunExtUA[l].isContr (Constructions.Hom D T zobj) ;
       import Zero ;
       susp (B : HigherCat.Ob D) : HigherCat.Ob D ;
       merid (B : HigherCat.Ob D) : Id (Constructions.Hom D B (susp B)) (Zero.zmap B (susp B)) (Zero.zmap B (susp B)) ;
       susp-po (B : HigherCat.Ob D) :
        DPushout.DSquare[B, zobj, zobj, susp B, Zero.zt B, Zero.zt B, Zero.zi (susp B), Zero.zi (susp B), merid B].is-pushout ;
       import Cone ;
       stable (Cc Bb Ee P : HigherCat.Ob D) (ii : Constructions.Hom D Cc Bb) (jj : Constructions.Hom D Cc Ee)
        (uu : Constructions.Hom D Bb P) (vv : Constructions.Hom D Ee P)
        (ss : Id (Constructions.Hom D Cc P) (Composition.hcomp {D} ii uu) (Composition.hcomp {D} jj vv))
        (po : DPushout.DSquare[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pushout) :
        Cone.DCone[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pullback ;
       -- the unit object 1: homology n X A = Pi0 Hom (Sigma^n 1, X (x) A)
       unitD : HigherCat.Ob D ;
       import Loops ; import ZeroCoherence ; import ConeZero ; import StableLoop ; import HGroups ; import HGroupMaps ; import HomologyDouble ; import MayerVietoris ; import MayerVietorisExact ; import MayerVietorisLoop ; import HomologyFibre ; import HomologyFibreLegs ; import HomologyFibreSource ; import HomologyFibreExact ; import HomologySequence ; import Suspension ;
       -- the spheres: suspensions of types (pushouts 1 <- X -> 1, no HITs)
       -- and desuspensions in D (with stability, Sigma is an equivalence)
       module WithSpheres {
        tsusp (X : U k) : U k ;
        tnorth (X : U k) : tsusp X ;
        tsouth (X : U k) : tsusp X ;
        tmerid (X : U k) (x : X) : Id (tsusp X) (tnorth X) (tsouth X) ;
        tsusp-po (X : U k) : Suspension.is-suspension X (tsusp X) (tnorth X) (tsouth X) (tmerid X) ;
        desusp (B : HigherCat.Ob D) : HigherCat.Ob D ;
        desusp-eq (B : HigherCat.Ob D) : Id (HigherCat.Ob D) (susp (desusp B)) B ;
        import Spheres ;
       } ;
      } ;
     } ;
    } ;
   } ;
  } ;
 } ;
} ;
