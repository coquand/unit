-- The spine edges of Delta 2 are the geometric cofaces (the two
-- parameters segal-coface-01, segal-coface-12 of the Agda proof, here
-- theorems).
--   Delta 2 is posetal, so a morphism of Delta 2 is determined by the
--   ordinals of its two endpoints (mor-eq-by-ends: they agree at I0 and at
--   I1, hence at every object of I).  The endpoints:
--     d01: v0 -> v1, d12: v1 -> v2, with ordinals 0, 1, 2 of Ord 2: the
--     monotone maps of v0, v1 = eval-pt, v2 on Ord 1 are 0, the identity,
--     1 (c20-map-to-ob1, eval-sec1);
--     face 1 o eval-pt-inv: v0 |-> face 1 v0, top 1 |-> face 1 (top 1), with
--     ordinals inl 0, inl 1 (c20-face-gen-u, c20-face-top);
--     lastedge 1 o eval-pt-inv: v0 |-> dom (last-edge 1), top 1 |->
--     cod (last-edge 1), with ordinals inl 1, 2.
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
open WildCat ; open HigherCat ; open Constructions ; open Exponentials ; open UnitIso ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open Construction20 ; open IntervalPosetal ;
open LastEdge ; open SegalComparison ; open FaceMap ; open FaceOrdCompat ; open PosetalCore ; open FunIPosetal ;
open FaceTop ; open PushoutBase ; open PushoutProof ; open GluingSquare ;

c20-inj (n : Nat) (x y : Ob (Delta n)) (p : Id (Ord n) ((construction-20 n).1 x) ((construction-20 n).1 y)) : Id (Ob (Delta n)) x y =
 Equivalences[l].injective (Ob (Delta n)) (Ord n) (construction-20 n).1 (construction-20 n).2 x y p ;

mor-eq-by-ends (n : Nat) (m1 m2 : Mor (Delta n))
 (pd : Id (Ord n) ((construction-20 n).1 (dom m1)) ((construction-20 n).1 (dom m2)))
 (pc : Id (Ord n) ((construction-20 n).1 (cod m1)) ((construction-20 n).1 (cod m2))) : Id (Mor (Delta n)) m1 m2 =
 posetal-eq-objects I (Delta n) (Delta-posetal n) m1 m2 (\ z ->
  agree-at {Delta n} {dom m2} {cod m2} m1 m2 (c20-inj n (dom m1) (dom m2) pd) (c20-inj n (cod m1) (cod m2) pc)
   (refl (dom m2)) (refl (cod m2)) z (val-I z)) ;

-- the ordinal of the object of Delta 2 named by f : Delta 1 -> I
c20-map-to-ob1 (f : Map (Delta (suc zero)) I) (w : MonotoneOrd (suc zero))
 (pw : (o : Two) -> Id Two (ob-to-2 f ((construction-20 (suc zero)).2.sec o)) (w.1 o)) :
 Id (Ord (suc (suc zero))) ((construction-20 (suc (suc zero))).1 (map-to-ob (Delta (suc zero)) I f)) (monotone-ord-fwd (suc zero) w) =
 H.transH (H.apH (\ g -> monotone-ord-fwd (suc zero) ((monotone-transfer (suc zero)).1 (I-char-comparison (Delta (suc zero)) g)))
   (ob-map-roundtrip1 (Delta (suc zero)) I f))
  (H.apH (monotone-ord-fwd (suc zero))
   (Pl.Sigma-eq (Two -> Two) (is-monotone-Ord (suc zero))
     ((monotone-transfer (suc zero)).1 (I-char-comparison (Delta (suc zero)) f)).1 w.1
     ((monotone-transfer (suc zero)).1 (I-char-comparison (Delta (suc zero)) f)).2 w.2
     (FL.funext Two (\ o -> Two) ((monotone-transfer (suc zero)).1 (I-char-comparison (Delta (suc zero)) f)).1 w.1 pw)
     (is-monotone-Ord-is-prop (suc zero) w.1))) ;

-- eval-pt reads the vertex of Delta 1 named by o as o
eval-sec1 (o : Two) : Id Two (ob-to-2 eval-pt ((construction-20 (suc zero)).2.sec o)) o =
 H.transH (H.apH I-ob.1
   (H.transH (eval-pt-ob ((construction-20 (suc zero)).2.sec o))
   (H.transH (ob-map-roundtrip1 One I (I-char-inverse One ((monotone-transfer zero).2.sec (monotone-ord-bwd zero o))))
    (H.symH (comp-id-r {One} {I} (I-char-inverse One ((monotone-transfer zero).2.sec (monotone-ord-bwd zero o))))))))
  (I-char-ob-to-2 One ((monotone-transfer zero).2.sec (monotone-ord-bwd zero o)) (idMap One)) ;

id-mono : (x y : Two) -> leqOrd (suc zero) x y -> leq2 x y = split {
 inl u -> \ y le -> tt ;
 inr u -> split { inl v -> \ le -> Pl.absurd _ le ; inr v -> \ le -> tt } } ;

-- the three vertices of Delta 2 and their ordinals
c20-v0 : Id (Ord (suc (suc zero))) ((construction-20 (suc (suc zero))).1 (map-to-ob (Delta (suc zero)) I v0)) (inl (inl tt)) =
 H.transH (c20-map-to-ob1 v0 (all-zeros (suc zero)) (\ o -> v0-const ((construction-20 (suc zero)).2.sec o))) (fwd-all-zeros (suc zero)) ;
c20-v1 : Id (Ord (suc (suc zero))) ((construction-20 (suc (suc zero))).1 (map-to-ob (Delta (suc zero)) I v1)) (inl (inr tt)) =
 c20-map-to-ob1 v1 (\ o -> o, id-mono) eval-sec1 ;
c20-v2 : Id (Ord (suc (suc zero))) ((construction-20 (suc (suc zero))).1 (map-to-ob (Delta (suc zero)) I v2)) (inr tt) =
 H.transH (c20-map-to-ob1 v2 (all-ones (suc zero)) (\ o -> v2-const ((construction-20 (suc zero)).2.sec o))) (fwd-all-inr (suc zero)) ;

c20-v0-Delta1 : Id (Ord (suc zero)) ((construction-20 (suc zero)).1 v0-Delta1) (inl tt) =
 H.transH (H.apH (construction-20 (suc zero)).1 (dom-last-edge zero)) ((construction-20 (suc zero)).2.sec-eq (inl tt)) ;

-- face 1 o eval-pt-inv
f01-dom : Id (Ob (Delta (suc (suc zero)))) (dom (funct-on-mor (face (suc zero)) eval-pt-inv))
 (Ob-map (face (suc zero)) v0-Delta1) =
 H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) eval-pt-inv I0)
  (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) ei0) ;
f01-cod : Id (Ob (Delta (suc (suc zero)))) (cod (funct-on-mor (face (suc zero)) eval-pt-inv))
 (Ob-map (face (suc zero)) (top (suc zero))) =
 H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) eval-pt-inv I1)
  (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) ei1) ;

segal-coface-01 : Id (Mor (Delta (suc (suc zero)))) d01 (funct-on-mor (face (suc zero)) eval-pt-inv) =
 mor-eq-by-ends (suc (suc zero)) d01 (funct-on-mor (face (suc zero)) eval-pt-inv)
  (H.transH (H.apH (construction-20 (suc (suc zero))).1 d01-dom)
   (H.transH c20-v0 (H.symH (H.transH (H.apH (construction-20 (suc (suc zero))).1 f01-dom)
     (H.transH (c20-face-gen-u (suc zero) v0-Delta1) (H.apH {Ord (suc zero)} {Ord (suc (suc zero))} (\ v -> inl v) c20-v0-Delta1))))))
  (H.transH (H.apH (construction-20 (suc (suc zero))).1 d01-cod)
   (H.transH c20-v1 (H.symH (H.transH (H.apH (construction-20 (suc (suc zero))).1 f01-cod) (c20-face-top (suc zero)))))) ;

-- lastedge 1 o eval-pt-inv
l12-dom : Id (Ob (Delta (suc (suc zero)))) (dom (funct-on-mor (lastedge (suc zero)) eval-pt-inv))
 (dom (last-edge (suc zero))) =
 H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) eval-pt-inv I0)
 (H.transH (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) ei0)
 (H.transH (composeA {One} {Delta (suc zero)} {I} {Delta (suc (suc zero))} (last-edge (suc zero)) eval-pt v0-Delta1)
  (ccr {One} {I} {Delta (suc (suc zero))} (last-edge (suc zero)) eval-pt-dom-last))) ;
l12-cod : Id (Ob (Delta (suc (suc zero)))) (cod (funct-on-mor (lastedge (suc zero)) eval-pt-inv))
 (cod (last-edge (suc zero))) =
 H.transH (composeA {One} {I} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) eval-pt-inv I1)
 (H.transH (ccr {One} {Delta (suc zero)} {Delta (suc (suc zero))} (lastedge (suc zero)) ei1)
 (H.transH (composeA {One} {Delta (suc zero)} {I} {Delta (suc (suc zero))} (last-edge (suc zero)) eval-pt (top (suc zero)))
  (ccr {One} {I} {Delta (suc (suc zero))} (last-edge (suc zero)) eval-pt-top1))) ;

segal-coface-12 : Id (Mor (Delta (suc (suc zero)))) d12 (funct-on-mor (lastedge (suc zero)) eval-pt-inv) =
 mor-eq-by-ends (suc (suc zero)) d12 (funct-on-mor (lastedge (suc zero)) eval-pt-inv)
  (H.transH (H.apH (construction-20 (suc (suc zero))).1 d12-dom)
   (H.transH c20-v1 (H.symH (H.transH (H.apH (construction-20 (suc (suc zero))).1 l12-dom)
     (H.transH (H.apH (construction-20 (suc (suc zero))).1 (dom-last-edge (suc zero)))
      ((construction-20 (suc (suc zero))).2.sec-eq (inl (inr tt))))))))
  (H.transH (H.apH (construction-20 (suc (suc zero))).1 d12-cod)
   (H.transH c20-v2 (H.symH (H.transH (H.apH (construction-20 (suc (suc zero))).1 l12-cod)
     (H.transH (H.apH (construction-20 (suc (suc zero))).1 (edge-cod (suc zero))) c20-v2))))) ;
