-- Stability on suspensions (H4): Hom (B, E) ~ Omega (Hom (B, Sigma E), 0).
--   The suspension square 0 <- E -> 0 is a pushout (susp-po), hence a
--   pullback (stable): Hom (B, E) ~ Cone B = (b, e : B -> 0) * (b n = e n),
--   n = zi (Sigma E).  As Hom (B, 0) is contractible, ContrLoop moves the
--   cone to a loop at zt B . n = zmap B (Sigma E).
--   sigma B E = kappa o cone-map; sigma-equiv.
open Base ;
module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
open HigherCat ; open Constructions ; open Composition ; open Zero ; open Cone ;

module StabLoop (B E : Ob D) {
 module K = FibreAlg.ContrLoop[Hom D B zobj, Hom D B (susp E), zero-term B, \ x -> hcomp {D} x (zi (susp E))] ;
 module C = DCone[E, zobj, zobj, susp E, zt E, zt E, zi (susp E), zi (susp E), merid E] ;
 sigma (c : Hom D B E) : Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E)) = K.kappa (C.cone-map B c) ;
 sigma-equiv : Pl.isEquiv (Hom D B E) (Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E))) sigma =
  EL.compose (Hom D B E) (C.Cone B) (Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E))) K.kappa (C.cone-map B)
   K.kappa-equiv (stable E zobj zobj (susp E) (zt E) (zt E) (zi (susp E)) (zi (susp E)) (merid E) (susp-po E) B) ;
} ;
