-- The exact remaining triple-composition coherence equation (HMOC3),
-- stated using the existing Hom-map-of-comp proof terms.
-- short first separates FG from K and then F from G.
-- long first changes (FG)K to F(GK), using the ambient associator and
-- the vertex pentagon, then separates F from GK and finally G from K.
-- Hom-map commuting with endpoint transport supplies the intervening
-- comparison. Both complete paths below are constructed and checked.
-- Coherence is their equality TYPE, not an assumed or proved term.
-- The canonical input (m,refl,refl) is sufficient after endpoint J.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open HomPaths ; open HomFunctor ;

module Triple (A B C D : Cat) (F : Map C D) (G : Map B C) (K : Map A B) (m : Mor A) {
 h : Hom A (dom m) (cod m) = (m, refl (dom m), refl (cod m)) ;
 a12 (x : Ob A) : Id (Ob D) (comp (comp (comp F G) K) x) (comp (comp F G) (comp K x)) =
  composeA {One} {A} {B} {D} (comp F G) K x ;
 a23 (x : Ob A) : Id (Ob D) (comp (comp F G) (comp K x)) (comp F (comp G (comp K x))) =
  composeA {One} {B} {C} {D} F G (comp K x) ;
 change (x : Ob A) : Id (Ob D) (comp (comp (comp F G) K) x) (comp (comp F (comp G K)) x) =
  ccl {One} {A} {D} x (composeA {A} {B} {C} {D} F G K) ;
 b12 (x : Ob A) : Id (Ob D) (comp (comp F (comp G K)) x) (comp F (comp (comp G K) x)) =
  composeA {One} {A} {C} {D} F (comp G K) x ;
 inner (x : Ob A) : Id (Ob C) (comp (comp G K) x) (comp G (comp K x)) =
  composeA {One} {A} {B} {C} G K x ;
 b23 (x : Ob A) : Id (Ob D) (comp F (comp (comp G K) x)) (comp F (comp G (comp K x))) =
  ccr {One} {C} {D} F (inner x) ;

 source : Hom D (comp F (comp G (comp K (dom m)))) (comp F (comp G (comp K (cod m)))) =
  Hom-coerce D (a23 (dom m)) (a23 (cod m))
   (Hom-coerce D (a12 (dom m)) (a12 (cod m)) (Hom-map (comp (comp F G) K) (dom m) (cod m) h)) ;
 target : Hom D (comp F (comp G (comp K (dom m)))) (comp F (comp G (comp K (cod m)))) =
  Hom-map F (comp G (comp K (dom m))) (comp G (comp K (cod m)))
   (Hom-map G (comp K (dom m)) (comp K (cod m)) (Hom-map K (dom m) (cod m) h)) ;

 short : Id (Hom D (comp F (comp G (comp K (dom m)))) (comp F (comp G (comp K (cod m))))) source target =
  H.transH (H.apH (Hom-coerce D (a23 (dom m)) (a23 (cod m))) (Hom-map-of-comp (comp F G) K (dom m) (cod m) h))
   (Hom-map-of-comp F G (comp K (dom m)) (comp K (cod m)) (Hom-map K (dom m) (cod m) h)) ;

 module Endpoint (v : Ob I) {
  av : Id (Ob D) (comp {One} {I} {D} (comp {I} {A} {D} (comp (comp F G) K) m) v)
   (comp (comp (comp F G) K) (comp {One} {I} {A} m v)) = composeA {One} {I} {A} {D} (comp (comp F G) K) m v ;
  vertex : Id (Id (Ob D) (comp {One} {I} {D} (comp {I} {A} {D} (comp (comp F G) K) m) v)
    (comp F (comp G (comp K (comp {One} {I} {A} m v)))))
   (H.transH (H.transH av (a12 (comp {One} {I} {A} m v))) (a23 (comp {One} {I} {A} m v)))
   (H.transH (H.transH (H.transH av (change (comp {One} {I} {A} m v))) (b12 (comp {One} {I} {A} m v))) (b23 (comp {One} {I} {A} m v))) =
   H.transH (PA.tassoc av (a12 (comp {One} {I} {A} m v)) (a23 (comp {One} {I} {A} m v)))
    (H.transH (H.apH (\ r -> H.transH av r) (pentagonator {One} {A} {B} {C} {D} F G K (comp {One} {I} {A} m v)))
     (H.transH (H.symH (PA.tassoc av (H.transH (change (comp {One} {I} {A} m v)) (b12 (comp {One} {I} {A} m v))) (b23 (comp {One} {I} {A} m v))))
      (H.apH (\ r -> H.transH r (b23 (comp {One} {I} {A} m v)))
       (H.symH (PA.tassoc av (change (comp {One} {I} {A} m v)) (b12 (comp {One} {I} {A} m v))))))) ;
 } ;

 long : Id (Hom D (comp F (comp G (comp K (dom m)))) (comp F (comp G (comp K (cod m))))) source target =
  H.transH (Hom-ends D (comp {I} {A} {D} (comp (comp F G) K) m) Endpoint[I0].vertex Endpoint[I1].vertex)
   (H.transH (H.apH (\ w -> Hom-coerce D (b23 (dom m)) (b23 (cod m)) (Hom-coerce D (b12 (dom m)) (b12 (cod m)) w))
     (HomFunctorPaths.Change[A, D, comp (comp F G) K, m].change (comp F (comp G K)) (composeA {A} {B} {C} {D} F G K)))
    (H.transH (H.apH (Hom-coerce D (b23 (dom m)) (b23 (cod m))) (Hom-map-of-comp F (comp G K) (dom m) (cod m) h))
     (H.transH (H.symH (HomFunctorPaths.Coerce[C, D, F, comp (comp G K) (dom m), comp (comp G K) (cod m),
       Hom-map (comp G K) (dom m) (cod m) h].naturality
       (comp G (comp K (dom m))) (inner (dom m)) (comp G (comp K (cod m))) (inner (cod m))))
      (H.apH (Hom-map F (comp G (comp K (dom m))) (comp G (comp K (cod m)))) (Hom-map-of-comp G K (dom m) (cod m) h))))) ;

 Coherence : U l = Id (Id (Hom D (comp F (comp G (comp K (dom m)))) (comp F (comp G (comp K (cod m))))) source target) short long ;
} ;
