-- The square retract S(n+1) < S(n) x I (Agda Squares/SquareGeom, second
-- part; Rocq retract_SSk), for n = k+1: the section is (glue-1, glue-1,
-- sect k, sect (k+1)), the retraction (!, pi1, ret k, ret (k+1)).
--   glue-1 X = <1, I1 o !> : X -> X x I, natural in X (glue-nat).
--   The faces of the section: maps into a product are compared by their
--   projections (ipe), and the projections are vertex computations
--   (pre-face-top, eval-at-top-top, pre-face-val, eval-val,
--   last-edge-c20, sn2-pr1-inl, sn2-snd-face), compared in posetal
--   simplices (vob-ext, posetal-eq-objects at I-posetal).
--   The faces of the retraction: vob-ext with ret-c20 and the closed
--   forms thr-nonbot, thr-dnilast.
--   The laws: ! o glue-1 = 1 (One), pi1 o glue-1 = 1, ret o sect = 1.
open Base ; open Finite[l] ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open UnitIso ;
open OrdMonotone ; open Interval ; open Construction20 ; open IntervalPosetal ;
open LastEdge ; open OrdComb ; open FaceMap ; open FaceOrdCompat ; open PosetalCore ; open FunIPosetal ;
open FaceTop ; open PushoutBase ; open GluingSquare ; open SegalCoface ; open SimplexRetract ; open SimplexRetractValues ;
open ProductMap ; open Squares ;


glue-1 (X : Cat) : Map X (times X I) = pair (idMap X) (comp {X} {One} {I} I1 (bang X)) ;
glue-injl (X : Cat) : Id (Map X X) (comp (pi1 X I) (glue-1 X)) (idMap X) = pair-beta1 (idMap X) (comp {X} {One} {I} I1 (bang X)) ;
glue-injr (X : Cat) : Id (Map X I) (comp (pi2 X I) (glue-1 X)) (comp {X} {One} {I} I1 (bang X)) = pair-beta2 (idMap X) (comp {X} {One} {I} I1 (bang X)) ;

glue-nat {A B : Cat} (f : Map A B) :
 Id (Map A (times B I)) (comp (product-map f (idMap I)) (glue-1 A)) (comp (glue-1 B) f) =
 ipe (comp (product-map f (idMap I)) (glue-1 A)) (comp (glue-1 B) f)
  (H.transH (comp-assoc (pi1 B I) (product-map f (idMap I)) (glue-1 A))
  (H.transH (ccl (glue-1 A) (injl-product-map f (idMap I)))
  (H.transH (composeA f (pi1 A I) (glue-1 A))
  (H.transH (ccr f (glue-injl A))
  (H.transH (comp-id-r f)
  (H.transH (H.symH (comp-id-l f))
  (H.transH (ccl f (H.symH (glue-injl B))) (H.symH (comp-assoc (pi1 B I) (glue-1 B) f)))))))))
  (H.transH (comp-assoc (pi2 B I) (product-map f (idMap I)) (glue-1 A))
  (H.transH (ccl (glue-1 A) (injr-product-map f (idMap I)))
  (H.transH (composeA (idMap I) (pi2 A I) (glue-1 A))
  (H.transH (ccr (idMap I) (glue-injr A))
  (H.transH (comp-id-l (comp {A} {One} {I} I1 (bang A)))
  (H.transH (ccr {A} {One} {I} I1 (one-path (bang A) (comp (bang B) f)))
  (H.transH (H.symH (composeA {A} {B} {One} {I} I1 (bang B) f))
  (H.transH (ccl f (H.symH (glue-injr B))) (H.symH (comp-assoc (pi2 B I) (glue-1 B) f)))))))))) ;

------------------------------------------------------------------------
-- the section

smt-s (k : Nat) : Id (Map One (times (Delta (suc zero)) I)) (comp (product-map v0-Delta1 (idMap I)) (glue-1 One)) (comp (glue-1 (Delta (suc zero))) v0-Delta1) =
 glue-nat v0-Delta1 ;

sml-s (k : Nat) : Id (Map One (times (Delta (suc k)) I)) (comp (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) (glue-1 One)) (comp {One} {Delta (suc (suc k))} {times (Delta (suc k)) I} (sect k) (top (suc (suc k)))) =
 ipe (comp (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) (glue-1 One)) (comp {One} {Delta (suc (suc k))} {times (Delta (suc k)) I} (sect k) (top (suc (suc k))))
  (H.transH (comp-assoc (pi1 (Delta (suc k)) I) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) (glue-1 One))
  (H.transH (ccl (glue-1 One) (injl-product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)))
  (H.transH (composeA {One} {times One I} {One} {Delta (suc k)} (top (suc k)) (pi1 One I) (glue-1 One))
  (H.transH (ccr {One} {One} {Delta (suc k)} (top (suc k)) (glue-injl One))
  (H.transH (comp-id-r {One} {Delta (suc k)} (top (suc k)))
  (H.transH (H.symH (pre-face-top k))
  (H.transH (ccl {One} {Delta (suc (suc k))} {Delta (suc k)} (top (suc (suc k))) (H.symH (sect-pi1 k)))
   (H.symH (comp-assoc {One} {Delta (suc (suc k))} {times (Delta (suc k)) I} {Delta (suc k)} (pi1 (Delta (suc k)) I) (sect k) (top (suc (suc k))))))))))))
  (H.transH (comp-assoc (pi2 (Delta (suc k)) I) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) (glue-1 One))
  (H.transH (ccl (glue-1 One) (injr-product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)))
  (H.transH (composeA (idMap I) (pi2 One I) (glue-1 One))
  (H.transH (ccr (idMap I) (glue-injr One))
  (H.transH (comp-id-l (comp {One} {One} {I} I1 (bang One)))
  (H.transH (ccr {One} {One} {I} I1 (one-path (bang One) (idMap One)))
  (H.transH (comp-id-r {One} {I} I1)
  (H.transH (H.symH (eval-at-top-top k))
  (H.transH (ccl {One} {Delta (suc (suc k))} {I} (top (suc (suc k))) (H.symH (sect-pi2 k)))
   (H.symH (comp-assoc {One} {Delta (suc (suc k))} {times (Delta (suc k)) I} {I} (pi2 (Delta (suc k)) I) (sect k) (top (suc (suc k)))))))))))))) ;

smr-key-el-pt (k : Nat) (x : Ob (Delta (suc zero))) : Id (Ord (suc (suc k))) (vob (suc (suc k)) (lastedge (suc k)) x) (vob (suc (suc k)) (comp (pre-face-n (suc k)) (lastedge (suc (suc k)))) x) =
 calc (Ord (suc (suc k))) {
  vob (suc (suc k)) (lastedge (suc k)) x
  =< H.apH (construction-20 (suc (suc k))).1 (composeA {One} {Delta (suc zero)} {I} {Delta (suc (suc k))} (last-edge (suc k)) eval-pt x) >
  (construction-20 (suc (suc k))).1 (Ob-map {I} {Delta (suc (suc k))} (last-edge (suc k)) (Ob-map eval-pt x))
  =< last-edge-c20 (suc k) (Ob-map eval-pt x) >
  lastedge-ord (suc k) (I-ob.1 (Ob-map eval-pt x))
  =< lastedge-sn2-pr1 k (I-ob.1 (Ob-map eval-pt x)) >
  sn2-pr1 (suc k) (lastedge-ord (suc (suc k)) (I-ob.1 (Ob-map eval-pt x)))
  =< H.apH (sn2-pr1 (suc k)) (H.symH (last-edge-c20 (suc (suc k)) (Ob-map eval-pt x))) >
  sn2-pr1 (suc k) ((construction-20 (suc (suc (suc k)))).1 (Ob-map {I} {Delta (suc (suc (suc k)))} (last-edge (suc (suc k))) (Ob-map eval-pt x)))
  =< H.symH (pre-face-val (suc k) (Ob-map {I} {Delta (suc (suc (suc k)))} (last-edge (suc (suc k))) (Ob-map eval-pt x))) >
  (construction-20 (suc (suc k))).1 (Ob-map (pre-face-n (suc k)) (Ob-map {I} {Delta (suc (suc (suc k)))} (last-edge (suc (suc k))) (Ob-map eval-pt x)))
  =< H.apH (construction-20 (suc (suc k))).1
      (H.transH (H.apH (Ob-map (pre-face-n (suc k))) (H.symH (composeA {One} {Delta (suc zero)} {I} {Delta (suc (suc (suc k)))} (last-edge (suc (suc k))) eval-pt x)))
       (comp-assoc {One} {Delta (suc zero)} {Delta (suc (suc (suc k)))} {Delta (suc (suc k))} (pre-face-n (suc k)) (lastedge (suc (suc k))) x)) >
  vob (suc (suc k)) (comp (pre-face-n (suc k)) (lastedge (suc (suc k)))) x } ;

smr-key-el (k : Nat) : Id (Map (Delta (suc zero)) (Delta (suc (suc k)))) (lastedge (suc k)) (comp (pre-face-n (suc k)) (lastedge (suc (suc k)))) =
 vob-ext (suc (suc k)) (lastedge (suc k)) (comp (pre-face-n (suc k)) (lastedge (suc (suc k)))) (smr-key-el-pt k) ;

smr-key-er (k : Nat) : Id (Map (Delta (suc zero)) I) (comp {Delta (suc zero)} {One} {I} I1 (bang (Delta (suc zero)))) (comp (eval-at-top (suc k)) (lastedge (suc (suc k)))) =
 posetal-eq-objects (Delta (suc zero)) I I-posetal (comp {Delta (suc zero)} {One} {I} I1 (bang (Delta (suc zero)))) (comp (eval-at-top (suc k)) (lastedge (suc (suc k)))) (\ x ->
  Iob-inj (Ob-map (comp {Delta (suc zero)} {One} {I} I1 (bang (Delta (suc zero)))) x) (Ob-map (comp (eval-at-top (suc k)) (lastedge (suc (suc k)))) x)
   (H.transH (H.apH I-ob.1 (const-ob (Delta (suc zero)) I1 x))
   (H.transH (I-ob.2.sec-eq one2)
   (H.transH (lastedge-sn2-snd k (I-ob.1 (Ob-map eval-pt x)))
    (H.symH (H.transH (H.apH I-ob.1 (composeA {One} {Delta (suc zero)} {Delta (suc (suc (suc k)))} {I} (eval-at-top (suc k)) (lastedge (suc (suc k))) x))
     (H.transH (eval-val (suc k) (Ob-map (lastedge (suc (suc k))) x))
      (H.apH (sn2-snd (suc k))
       (H.transH (H.apH (construction-20 (suc (suc (suc k)))).1 (composeA {One} {Delta (suc zero)} {I} {Delta (suc (suc (suc k)))} (last-edge (suc (suc k))) eval-pt x))
        (last-edge-c20 (suc (suc k)) (Ob-map eval-pt x))))))))))) ;

smr-s (k : Nat) : Id (Map (Delta (suc zero)) (times (Delta (suc (suc k))) I)) (comp (product-map (lastedge (suc k)) (idMap I)) (glue-1 (Delta (suc zero)))) (comp (sect (suc k)) (lastedge (suc (suc k)))) =
 ipe (comp (product-map (lastedge (suc k)) (idMap I)) (glue-1 (Delta (suc zero)))) (comp (sect (suc k)) (lastedge (suc (suc k))))
  (H.transH (comp-assoc (pi1 (Delta (suc (suc k))) I) (product-map (lastedge (suc k)) (idMap I)) (glue-1 (Delta (suc zero))))
  (H.transH (ccl (glue-1 (Delta (suc zero))) (injl-product-map (lastedge (suc k)) (idMap I)))
  (H.transH (composeA (lastedge (suc k)) (pi1 (Delta (suc zero)) I) (glue-1 (Delta (suc zero))))
  (H.transH (ccr (lastedge (suc k)) (glue-injl (Delta (suc zero))))
  (H.transH (comp-id-r (lastedge (suc k)))
  (H.transH (smr-key-el k)
  (H.transH (ccl (lastedge (suc (suc k))) (H.symH (sect-pi1 (suc k)))) (H.symH (comp-assoc (pi1 (Delta (suc (suc k))) I) (sect (suc k)) (lastedge (suc (suc k))))))))))))
  (H.transH (comp-assoc (pi2 (Delta (suc (suc k))) I) (product-map (lastedge (suc k)) (idMap I)) (glue-1 (Delta (suc zero))))
  (H.transH (ccl (glue-1 (Delta (suc zero))) (injr-product-map (lastedge (suc k)) (idMap I)))
  (H.transH (composeA (idMap I) (pi2 (Delta (suc zero)) I) (glue-1 (Delta (suc zero))))
  (H.transH (comp-id-l (comp (pi2 (Delta (suc zero)) I) (glue-1 (Delta (suc zero)))))
  (H.transH (glue-injr (Delta (suc zero)))
  (H.transH (smr-key-er k)
  (H.transH (ccl (lastedge (suc (suc k))) (H.symH (sect-pi2 (suc k)))) (H.symH (comp-assoc (pi2 (Delta (suc (suc k))) I) (sect (suc k)) (lastedge (suc (suc k)))))))))))) ;

smb-key-el-pt (k : Nat) (z : Ob (Delta (suc (suc k)))) :
 Id (Ord (suc (suc k))) (vob (suc (suc k)) (comp (face (suc k)) (pre-face-n k)) z) (vob (suc (suc k)) (comp (pre-face-n (suc k)) (face (suc (suc k)))) z) =
 calc (Ord (suc (suc k))) {
  vob (suc (suc k)) (comp (face (suc k)) (pre-face-n k)) z
  =< vob-pre (suc (suc k)) (face (suc k)) (pre-face-n k) z >
  (construction-20 (suc (suc k))).1 (Ob-map (face (suc k)) (Ob-map (pre-face-n k) z))
  =< c20-face-gen-u (suc k) (Ob-map (pre-face-n k) z) >
  inl ((construction-20 (suc k)).1 (Ob-map (pre-face-n k) z))
  =< H.apH {Ord (suc k)} {Ord (suc (suc k))} (\ v -> inl v) (pre-face-val k z) >
  inl (sn2-pr1 k ((construction-20 (suc (suc k))).1 z))
  =< sn2-pr1-inl k ((construction-20 (suc (suc k))).1 z) >
  sn2-pr1 (suc k) (inl ((construction-20 (suc (suc k))).1 z))
  =< H.symH (H.apH (sn2-pr1 (suc k)) (c20-face-gen-u (suc (suc k)) z)) >
  sn2-pr1 (suc k) ((construction-20 (suc (suc (suc k)))).1 (Ob-map (face (suc (suc k))) z))
  =< H.symH (pre-face-val (suc k) (Ob-map (face (suc (suc k))) z)) >
  (construction-20 (suc (suc k))).1 (Ob-map (pre-face-n (suc k)) (Ob-map (face (suc (suc k))) z))
  =< H.symH (vob-pre (suc (suc k)) (pre-face-n (suc k)) (face (suc (suc k))) z) >
  vob (suc (suc k)) (comp (pre-face-n (suc k)) (face (suc (suc k)))) z } ;

smb-key-el (k : Nat) : Id (Map (Delta (suc (suc k))) (Delta (suc (suc k)))) (comp (face (suc k)) (pre-face-n k)) (comp (pre-face-n (suc k)) (face (suc (suc k)))) =
 vob-ext (suc (suc k)) (comp (face (suc k)) (pre-face-n k)) (comp (pre-face-n (suc k)) (face (suc (suc k)))) (smb-key-el-pt k) ;

smb-key-er (k : Nat) : Id (Map (Delta (suc (suc k))) I) (eval-at-top k) (comp (eval-at-top (suc k)) (face (suc (suc k)))) =
 posetal-eq-objects (Delta (suc (suc k))) I I-posetal (eval-at-top k) (comp (eval-at-top (suc k)) (face (suc (suc k)))) (\ z ->
  Iob-inj (Ob-map (eval-at-top k) z) (Ob-map (comp (eval-at-top (suc k)) (face (suc (suc k)))) z)
   (H.transH (eval-val k z)
   (H.transH (sn2-snd-face k ((construction-20 (suc (suc k))).1 z))
   (H.transH (H.symH (H.apH (sn2-snd (suc k)) (c20-face-gen-u (suc (suc k)) z)))
   (H.transH (H.symH (eval-val (suc k) (Ob-map (face (suc (suc k))) z)))
    (H.symH (H.apH I-ob.1 (composeA {One} {Delta (suc (suc k))} {Delta (suc (suc (suc k)))} {I} (eval-at-top (suc k)) (face (suc (suc k))) z)))))))) ;

smb-s (k : Nat) : Id (Map (Delta (suc (suc k))) (times (Delta (suc (suc k))) I)) (comp (product-map (face (suc k)) (idMap I)) (sect k)) (comp (sect (suc k)) (face (suc (suc k)))) =
 ipe (comp (product-map (face (suc k)) (idMap I)) (sect k)) (comp (sect (suc k)) (face (suc (suc k))))
  (H.transH (comp-assoc (pi1 (Delta (suc (suc k))) I) (product-map (face (suc k)) (idMap I)) (sect k))
  (H.transH (ccl (sect k) (injl-product-map (face (suc k)) (idMap I)))
  (H.transH (composeA (face (suc k)) (pi1 (Delta (suc k)) I) (sect k))
  (H.transH (ccr (face (suc k)) (sect-pi1 k))
  (H.transH (smb-key-el k)
  (H.transH (ccl (face (suc (suc k))) (H.symH (sect-pi1 (suc k)))) (H.symH (comp-assoc (pi1 (Delta (suc (suc k))) I) (sect (suc k)) (face (suc (suc k)))))))))))
  (H.transH (comp-assoc (pi2 (Delta (suc (suc k))) I) (product-map (face (suc k)) (idMap I)) (sect k))
  (H.transH (ccl (sect k) (injr-product-map (face (suc k)) (idMap I)))
  (H.transH (composeA (idMap I) (pi2 (Delta (suc k)) I) (sect k))
  (H.transH (comp-id-l (comp (pi2 (Delta (suc k)) I) (sect k)))
  (H.transH (sect-pi2 k)
  (H.transH (smb-key-er k)
  (H.transH (ccl (face (suc (suc k))) (H.symH (sect-pi2 (suc k)))) (H.symH (comp-assoc (pi2 (Delta (suc (suc k))) I) (sect (suc k)) (face (suc (suc k)))))))))))) ;

------------------------------------------------------------------------
-- the retraction

smt-r (k : Nat) : Id (Map (times One I) (Delta (suc zero))) (comp v0-Delta1 (bang (times One I))) (comp (pi1 (Delta (suc zero)) I) (product-map v0-Delta1 (idMap I))) =
 H.transH (ccr v0-Delta1 (one-path (bang (times One I)) (pi1 One I))) (H.symH (injl-product-map v0-Delta1 (idMap I))) ;

sml-r-aval (k : Nat) (x : Ob (times One I)) :
 Id (Ord (suc k)) ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x))) (inr tt) =
 calc (Ord (suc k)) {
  (construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x))
  =< H.apH (construction-20 (suc k)).1 (H.symH (composeA {One} {times One I} {times (Delta (suc k)) I} {Delta (suc k)} (pi1 (Delta (suc k)) I) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x)) >
  (construction-20 (suc k)).1 (Ob-map (comp (pi1 (Delta (suc k)) I) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I))) x)
  =< H.apH (construction-20 (suc k)).1 (ccl {One} {times One I} {Delta (suc k)} x (injl-product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I))) >
  (construction-20 (suc k)).1 (Ob-map {times One I} {Delta (suc k)} (comp {times One I} {One} {Delta (suc k)} (top (suc k)) (pi1 One I)) x)
  =< H.apH (construction-20 (suc k)).1 (composeA {One} {times One I} {One} {Delta (suc k)} (top (suc k)) (pi1 One I) x) >
  (construction-20 (suc k)).1 (Ob-map {One} {Delta (suc k)} (top (suc k)) (Ob-map (pi1 One I) x))
  =< H.apH (construction-20 (suc k)).1 (ccr {One} {One} {Delta (suc k)} (top (suc k)) (one-path (Ob-map (pi1 One I) x) (idMap One))) >
  (construction-20 (suc k)).1 (Ob-map {One} {Delta (suc k)} (top (suc k)) (idMap One))
  =< H.apH (construction-20 (suc k)).1 (comp-id-r {One} {Delta (suc k)} (top (suc k))) >
  (construction-20 (suc k)).1 (top (suc k))
  =< c20-top (suc k) >
  inr tt } ;

sml-r-pt (k : Nat) (x : Ob (times One I)) :
 Id (Ord (suc (suc k))) (vob (suc (suc k)) (comp {times One I} {One} {Delta (suc (suc k))} (top (suc (suc k))) (bang (times One I))) x)
  (vob (suc (suc k)) (comp (ret k) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I))) x) =
 calc (Ord (suc (suc k))) {
  vob (suc (suc k)) (comp {times One I} {One} {Delta (suc (suc k))} (top (suc (suc k))) (bang (times One I))) x
  =< vob-pre (suc (suc k)) {times One I} {One} (top (suc (suc k))) (bang (times One I)) x >
  (construction-20 (suc (suc k))).1 (Ob-map {One} {Delta (suc (suc k))} (top (suc (suc k))) (Ob-map (bang (times One I)) x))
  =< H.apH (\ z -> (construction-20 (suc (suc k))).1 (Ob-map {One} {Delta (suc (suc k))} (top (suc (suc k))) z)) (one-path (Ob-map (bang (times One I)) x) (idMap One)) >
  (construction-20 (suc (suc k))).1 (Ob-map {One} {Delta (suc (suc k))} (top (suc (suc k))) (idMap One))
  =< H.apH (construction-20 (suc (suc k))).1 (comp-id-r {One} {Delta (suc (suc k))} (top (suc (suc k)))) >
  (construction-20 (suc (suc k))).1 (top (suc (suc k)))
  =< c20-top (suc (suc k)) >
  inr tt
  =< H.symH (thr-nonbot k (inr tt) (I-ob.1 (Ob-map (pi2 (Delta (suc k)) I) (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x))) (nbot-top k)) >
  thr-ord k (inr tt) (I-ob.1 (Ob-map (pi2 (Delta (suc k)) I) (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x)))
  =< H.apH (\ z -> thr-ord k z (I-ob.1 (Ob-map (pi2 (Delta (suc k)) I) (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x)))) (H.symH (sml-r-aval k x)) >
  thr-ord k ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x))) (I-ob.1 (Ob-map (pi2 (Delta (suc k)) I) (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x)))
  =< H.symH (ret-c20 k (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x)) >
  (construction-20 (suc (suc k))).1 (Ob-map (ret k) (Ob-map (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x))
  =< H.symH (vob-pre (suc (suc k)) (ret k) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I)) x) >
  vob (suc (suc k)) (comp (ret k) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I))) x } ;

sml-r (k : Nat) : Id (Map (times One I) (Delta (suc (suc k)))) (comp {times One I} {One} {Delta (suc (suc k))} (top (suc (suc k))) (bang (times One I)))
 (comp (ret k) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I))) =
 vob-ext (suc (suc k)) (comp {times One I} {One} {Delta (suc (suc k))} (top (suc (suc k))) (bang (times One I))) (comp (ret k) (product-map {One} {Delta (suc k)} {I} {I} (top (suc k)) (idMap I))) (sml-r-pt k) ;

smr-key (k : Nat) : (c b : Two) -> Id (Ord (suc (suc (suc k)))) (lastedge-ord (suc (suc k)) c) (thr-ord (suc k) (lastedge-ord (suc k) c) b) = split {
 inl u -> \ b -> H.symH (thr-nonbot (suc k) (inl (inr tt)) b (nbot-top k)) ;
 inr u -> \ b -> H.symH (thr-nonbot (suc k) (inr tt) b (refl one2)) } ;

smr-r-aval (k : Nat) (x : Ob (times (Delta (suc zero)) I)) :
 Id (Ord (suc (suc k))) ((construction-20 (suc (suc k))).1 (Ob-map (pi1 (Delta (suc (suc k))) I) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x))) (lastedge-ord (suc k) (I-ob.1 (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)))) =
 calc (Ord (suc (suc k))) {
  (construction-20 (suc (suc k))).1 (Ob-map (pi1 (Delta (suc (suc k))) I) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x))
  =< H.apH (construction-20 (suc (suc k))).1 (H.symH (composeA {One} {times (Delta (suc zero)) I} {times (Delta (suc (suc k))) I} {Delta (suc (suc k))} (pi1 (Delta (suc (suc k))) I) (product-map (lastedge (suc k)) (idMap I)) x)) >
  (construction-20 (suc (suc k))).1 (Ob-map (comp (pi1 (Delta (suc (suc k))) I) (product-map (lastedge (suc k)) (idMap I))) x)
  =< H.apH (construction-20 (suc (suc k))).1 (ccl {One} {times (Delta (suc zero)) I} {Delta (suc (suc k))} x (injl-product-map (lastedge (suc k)) (idMap I))) >
  (construction-20 (suc (suc k))).1 (Ob-map (comp (lastedge (suc k)) (pi1 (Delta (suc zero)) I)) x)
  =< H.apH (construction-20 (suc (suc k))).1 (composeA {One} {times (Delta (suc zero)) I} {Delta (suc zero)} {Delta (suc (suc k))} (lastedge (suc k)) (pi1 (Delta (suc zero)) I) x) >
  (construction-20 (suc (suc k))).1 (Ob-map (lastedge (suc k)) (Ob-map (pi1 (Delta (suc zero)) I) x))
  =< H.apH (construction-20 (suc (suc k))).1 (composeA {One} {Delta (suc zero)} {I} {Delta (suc (suc k))} (last-edge (suc k)) eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)) >
  (construction-20 (suc (suc k))).1 (Ob-map {I} {Delta (suc (suc k))} (last-edge (suc k)) (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)))
  =< last-edge-c20 (suc k) (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)) >
  lastedge-ord (suc k) (I-ob.1 (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x))) } ;

smr-r-pt (k : Nat) (x : Ob (times (Delta (suc zero)) I)) :
 Id (Ord (suc (suc (suc k)))) (vob (suc (suc (suc k))) (comp (lastedge (suc (suc k))) (pi1 (Delta (suc zero)) I)) x) (vob (suc (suc (suc k))) (comp (ret (suc k)) (product-map (lastedge (suc k)) (idMap I))) x) =
 calc (Ord (suc (suc (suc k)))) {
  vob (suc (suc (suc k))) (comp (lastedge (suc (suc k))) (pi1 (Delta (suc zero)) I)) x
  =< vob-pre (suc (suc (suc k))) (lastedge (suc (suc k))) (pi1 (Delta (suc zero)) I) x >
  (construction-20 (suc (suc (suc k)))).1 (Ob-map (lastedge (suc (suc k))) (Ob-map (pi1 (Delta (suc zero)) I) x))
  =< H.apH (construction-20 (suc (suc (suc k)))).1 (composeA {One} {Delta (suc zero)} {I} {Delta (suc (suc (suc k)))} (last-edge (suc (suc k))) eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)) >
  (construction-20 (suc (suc (suc k)))).1 (Ob-map {I} {Delta (suc (suc (suc k)))} (last-edge (suc (suc k))) (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)))
  =< last-edge-c20 (suc (suc k)) (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)) >
  lastedge-ord (suc (suc k)) (I-ob.1 (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)))
  =< smr-key k (I-ob.1 (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x))) (I-ob.1 (Ob-map (pi2 (Delta (suc (suc k))) I) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x))) >
  thr-ord (suc k) (lastedge-ord (suc k) (I-ob.1 (Ob-map eval-pt (Ob-map (pi1 (Delta (suc zero)) I) x)))) (I-ob.1 (Ob-map (pi2 (Delta (suc (suc k))) I) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x)))
  =< H.apH (\ z -> thr-ord (suc k) z (I-ob.1 (Ob-map (pi2 (Delta (suc (suc k))) I) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x)))) (H.symH (smr-r-aval k x)) >
  thr-ord (suc k) ((construction-20 (suc (suc k))).1 (Ob-map (pi1 (Delta (suc (suc k))) I) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x))) (I-ob.1 (Ob-map (pi2 (Delta (suc (suc k))) I) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x)))
  =< H.symH (ret-c20 (suc k) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x)) >
  (construction-20 (suc (suc (suc k)))).1 (Ob-map (ret (suc k)) (Ob-map (product-map (lastedge (suc k)) (idMap I)) x))
  =< H.symH (vob-pre (suc (suc (suc k))) (ret (suc k)) (product-map (lastedge (suc k)) (idMap I)) x) >
  vob (suc (suc (suc k))) (comp (ret (suc k)) (product-map (lastedge (suc k)) (idMap I))) x } ;

smr-r (k : Nat) : Id (Map (times (Delta (suc zero)) I) (Delta (suc (suc (suc k))))) (comp (lastedge (suc (suc k))) (pi1 (Delta (suc zero)) I)) (comp (ret (suc k)) (product-map (lastedge (suc k)) (idMap I))) =
 vob-ext (suc (suc (suc k))) (comp (lastedge (suc (suc k))) (pi1 (Delta (suc zero)) I)) (comp (ret (suc k)) (product-map (lastedge (suc k)) (idMap I))) (smr-r-pt k) ;

smb-r-aval (k : Nat) (x : Ob (times (Delta (suc k)) I)) :
 Id (Ord (suc (suc k))) ((construction-20 (suc (suc k))).1 (Ob-map (pi1 (Delta (suc (suc k))) I) (Ob-map (product-map (face (suc k)) (idMap I)) x))) (inl ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) x))) =
 calc (Ord (suc (suc k))) {
  (construction-20 (suc (suc k))).1 (Ob-map (pi1 (Delta (suc (suc k))) I) (Ob-map (product-map (face (suc k)) (idMap I)) x))
  =< H.apH (construction-20 (suc (suc k))).1 (H.symH (composeA {One} {times (Delta (suc k)) I} {times (Delta (suc (suc k))) I} {Delta (suc (suc k))} (pi1 (Delta (suc (suc k))) I) (product-map (face (suc k)) (idMap I)) x)) >
  (construction-20 (suc (suc k))).1 (Ob-map (comp (pi1 (Delta (suc (suc k))) I) (product-map (face (suc k)) (idMap I))) x)
  =< H.apH (construction-20 (suc (suc k))).1 (ccl {One} {times (Delta (suc k)) I} {Delta (suc (suc k))} x (injl-product-map (face (suc k)) (idMap I))) >
  (construction-20 (suc (suc k))).1 (Ob-map (comp (face (suc k)) (pi1 (Delta (suc k)) I)) x)
  =< H.apH (construction-20 (suc (suc k))).1 (composeA {One} {times (Delta (suc k)) I} {Delta (suc k)} {Delta (suc (suc k))} (face (suc k)) (pi1 (Delta (suc k)) I) x) >
  (construction-20 (suc (suc k))).1 (Ob-map (face (suc k)) (Ob-map (pi1 (Delta (suc k)) I) x))
  =< c20-face-gen-u (suc k) (Ob-map (pi1 (Delta (suc k)) I) x) >
  inl ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) x)) } ;

smb-r-bval (k : Nat) (x : Ob (times (Delta (suc k)) I)) : Id Two (I-ob.1 (Ob-map (pi2 (Delta (suc (suc k))) I) (Ob-map (product-map (face (suc k)) (idMap I)) x))) (I-ob.1 (Ob-map (pi2 (Delta (suc k)) I) x)) =
 H.apH I-ob.1
  (H.transH (H.symH (composeA {One} {times (Delta (suc k)) I} {times (Delta (suc (suc k))) I} {I} (pi2 (Delta (suc (suc k))) I) (product-map (face (suc k)) (idMap I)) x))
  (H.transH (ccl {One} {times (Delta (suc k)) I} {I} x (injr-product-map (face (suc k)) (idMap I)))
  (H.transH (composeA {One} {times (Delta (suc k)) I} {I} {I} (idMap I) (pi2 (Delta (suc k)) I) x)
   (comp-id-l {One} {I} (Ob-map (pi2 (Delta (suc k)) I) x))))) ;

smb-r-pt (k : Nat) (x : Ob (times (Delta (suc k)) I)) :
 Id (Ord (suc (suc (suc k)))) (vob (suc (suc (suc k))) (comp (face (suc (suc k))) (ret k)) x) (vob (suc (suc (suc k))) (comp (ret (suc k)) (product-map (face (suc k)) (idMap I))) x) =
 calc (Ord (suc (suc (suc k)))) {
  vob (suc (suc (suc k))) (comp (face (suc (suc k))) (ret k)) x
  =< vob-pre (suc (suc (suc k))) (face (suc (suc k))) (ret k) x >
  (construction-20 (suc (suc (suc k)))).1 (Ob-map (face (suc (suc k))) (Ob-map (ret k) x))
  =< c20-face-gen-u (suc (suc k)) (Ob-map (ret k) x) >
  inl ((construction-20 (suc (suc k))).1 (Ob-map (ret k) x))
  =< H.apH {Ord (suc (suc k))} {Ord (suc (suc (suc k)))} (\ v -> inl v) (ret-c20 k x) >
  inl (thr-ord k ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) x)) (I-ob.1 (Ob-map (pi2 (Delta (suc k)) I) x)))
  =< thr-dnilast k ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) x)) (I-ob.1 (Ob-map (pi2 (Delta (suc k)) I) x)) >
  thr-ord (suc k) (inl ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) x))) (I-ob.1 (Ob-map (pi2 (Delta (suc k)) I) x))
  =< H.apH (\ z -> thr-ord (suc k) (inl ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) x))) z) (H.symH (smb-r-bval k x)) >
  thr-ord (suc k) (inl ((construction-20 (suc k)).1 (Ob-map (pi1 (Delta (suc k)) I) x))) (I-ob.1 (Ob-map (pi2 (Delta (suc (suc k))) I) (Ob-map (product-map (face (suc k)) (idMap I)) x)))
  =< H.apH (\ z -> thr-ord (suc k) z (I-ob.1 (Ob-map (pi2 (Delta (suc (suc k))) I) (Ob-map (product-map (face (suc k)) (idMap I)) x)))) (H.symH (smb-r-aval k x)) >
  thr-ord (suc k) ((construction-20 (suc (suc k))).1 (Ob-map (pi1 (Delta (suc (suc k))) I) (Ob-map (product-map (face (suc k)) (idMap I)) x))) (I-ob.1 (Ob-map (pi2 (Delta (suc (suc k))) I) (Ob-map (product-map (face (suc k)) (idMap I)) x)))
  =< H.symH (ret-c20 (suc k) (Ob-map (product-map (face (suc k)) (idMap I)) x)) >
  (construction-20 (suc (suc (suc k)))).1 (Ob-map (ret (suc k)) (Ob-map (product-map (face (suc k)) (idMap I)) x))
  =< H.symH (vob-pre (suc (suc (suc k))) (ret (suc k)) (product-map (face (suc k)) (idMap I)) x) >
  vob (suc (suc (suc k))) (comp (ret (suc k)) (product-map (face (suc k)) (idMap I))) x } ;

smb-r (k : Nat) : Id (Map (times (Delta (suc k)) I) (Delta (suc (suc (suc k))))) (comp (face (suc (suc k))) (ret k)) (comp (ret (suc k)) (product-map (face (suc k)) (idMap I))) =
 vob-ext (suc (suc (suc k))) (comp (face (suc (suc k))) (ret k)) (comp (ret (suc k)) (product-map (face (suc k)) (idMap I))) (smb-r-pt k) ;

------------------------------------------------------------------------
-- the retract

law-A : Id (Map One One) (comp (bang (times One I)) (glue-1 One)) (idMap One) =
 one-path (comp (bang (times One I)) (glue-1 One)) (idMap One) ;
law-B : Id (Map (Delta (suc zero)) (Delta (suc zero))) (comp (pi1 (Delta (suc zero)) I) (glue-1 (Delta (suc zero)))) (idMap (Delta (suc zero))) = glue-injl (Delta (suc zero)) ;

sr-s-mor (k : Nat) : square-morphism[Sq (suc (suc k)), times-I (Sq (suc k))] =
 new square-morphism[Sq (suc (suc k)), times-I (Sq (suc k)), glue-1 One, glue-1 (Delta (suc zero)), sect k, sect (suc k),
  smt-s k, sml-s k, smr-s k, smb-s k] ;

sr-r-mor (k : Nat) : square-morphism[times-I (Sq (suc k)), Sq (suc (suc k))] =
 new square-morphism[times-I (Sq (suc k)), Sq (suc (suc k)), bang (times One I), pi1 (Delta (suc zero)) I, ret k, ret (suc k),
  smt-r k, sml-r k, smr-r k, smb-r k] ;

retract-SSk (k : Nat) : square-retract[Sq (suc (suc k)), times-I (Sq (suc k))] =
 new square-retract[Sq (suc (suc k)), times-I (Sq (suc k)), sr-s-mor k, sr-r-mor k, law-A, law-B, ret-sect k, ret-sect (suc k)] ;
