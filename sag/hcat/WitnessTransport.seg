-- Transport universal witnesses along a specified commuting square.
-- For r : A -> B, s : C -> E, u : A -> C, v : B -> E and
-- alpha a : s(u a) = v(r a), send (a,p) over b to
-- (u a, alpha a . ap v p) over v b. No equivalence is needed to
-- define transport. Its composition law is ap-trans, associativity of
-- paths, and ap-comp; its identity law is the path unit law and ap-id.
-- When s is an equivalence, the whole type of such fibre maps is
-- contractible. UniversalWitness.globes-contr then supplies every finite
-- higher comparison of these maps, INCLUDING their beta witnesses.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module CU = FunExtUA[l] ;
open FibreLemmas ;

module Square (A B C E : U l) (r : A -> B) (s : C -> E)
 (u : A -> C) (v : B -> E) (alpha : (a : A) -> Id E (s (u a)) (v (r a))) {
 act (b : B) (w : fib r b) : fib s (v b) = (u w.1, H.transH (alpha w.1) (H.apH v w.2)) ;

 act-def (b : B) (w : fib r b) :
  Id (fib s (v b)) (act b w) (u w.1, H.transH (alpha w.1) (H.apH v w.2)) = refl (act b w) ;

 act-value (b : B) (w : fib r b) : Id C (act b w).1 (u w.1) = refl (u w.1) ;

 module Next (F G : U l) (t : F -> G) (u1 : C -> F) (v1 : E -> G)
  (alpha1 : (c : C) -> Id G (t (u1 c)) (v1 (s c))) {
  pasted (a : A) : Id G (t (u1 (u a))) (v1 (v (r a))) =
   H.transH (alpha1 (u a)) (H.apH v1 (alpha a)) ;

  -- The path part of the composite fibre map, before packaging it.
  paste-beta (b : B) (w : fib r b) :
   Id (Id G (t (u1 (u w.1))) (v1 (v b)))
    (H.transH (alpha1 (u w.1)) (H.apH v1 (H.transH (alpha w.1) (H.apH v w.2))))
    (H.transH (pasted w.1) (H.apH (\ x -> v1 (v x)) w.2)) =
   H.transH (H.apH (\ q -> H.transH (alpha1 (u w.1)) q) (PA.ap-trans v1 (alpha w.1) (H.apH v w.2)))
    (H.transH (H.symH (PA.tassoc (alpha1 (u w.1)) (H.apH v1 (alpha w.1)) (H.apH v1 (H.apH v w.2))))
     (H.apH (\ q -> H.transH (pasted w.1) q) (PA.ap-comp v1 v w.2))) ;
 } ;

 choices (es : Pl.isEquiv C E s) (b : B) : CU.isContr (fib r b -> fib s (v b)) =
  UniversalWitness.sections (fib r b) (\ w -> fib s (v b)) (\ w -> equiv-fibre-contr C E s es (v b)) ;

 coherence (es : Pl.isEquiv C E s) (b : B) (n : Nat)
  (boundary : (UniversalWitness.globes (fib r b -> fib s (v b)) n).1) :
  CU.isContr ((UniversalWitness.globes (fib r b -> fib s (v b)) n).2 boundary) =
  UniversalWitness.globes-contr (fib r b -> fib s (v b)) (choices es b) n boundary ;

 opaque act ;
} ;

module Identity (A B : U l) (r : A -> B) {
 module S = Square[A, B, A, B, r, r, \ a -> a, \ b -> b, \ a -> refl (r a)] ;
 identity (b : B) (w : fib r b) : Id (fib r b) (S.act b w) w =
  H.transH (S.act-def b w)
   (H.apH {Id B (r w.1) b} {fib r b} (\ p -> (w.1, p))
    (H.transH (PA.unit-l (H.apH (\ x -> x) w.2)) (PA.ap-id w.2))) ;
} ;

module Compose (A B C E F G : U l) (r : A -> B) (s : C -> E) (t : F -> G)
 (u : A -> C) (v : B -> E) (alpha : (a : A) -> Id E (s (u a)) (v (r a)))
 (u1 : C -> F) (v1 : E -> G) (alpha1 : (c : C) -> Id G (t (u1 c)) (v1 (s c))) {
 module S = Square[A, B, C, E, r, s, u, v, alpha] ;
 module T = Square[C, E, F, G, s, t, u1, v1, alpha1] ;
 module P = S.Next[F, G, t, u1, v1, alpha1] ;
 module ST = Square[A, B, F, G, r, t, \ a -> u1 (u a), \ b -> v1 (v b), P.pasted] ;

 composition (b : B) (w : fib r b) : Id (fib t (v1 (v b))) (T.act (v b) (S.act b w)) (ST.act b w) =
  H.transH (H.apH (T.act (v b)) (S.act-def b w))
   (H.transH (T.act-def (v b) (u w.1, H.transH (alpha w.1) (H.apH v w.2)))
    (H.transH (H.apH {Id G (t (u1 (u w.1))) (v1 (v b))} {fib t (v1 (v b))}
      (\ p -> (u1 (u w.1), p)) (P.paste-beta b w))
     (H.symH (ST.act-def b w)))) ;
} ;
