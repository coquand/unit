-- A homotopy pullback supplies ONE pointed map: its projection to the
-- product of the two legs. Its fibre is Omega P, including the map
-- into the pullback. Indeed, fib(pr1:Sigma w.paths(w)->B*E) is paths(b,e)
-- by fib-pr1, and path translation identifies that with Omega P.
-- Thus FibreTower applies directly. The connecting homomorphism and
-- its exactness at pi_1(pullback) use the SAME fibre inclusion.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
module PA = PathAlgebra[l] ; module PM = Pi0Maps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open FibreLemmas ; open FibreTower ; open Pi0[l] ;

module Pull (B E P : U l) (f : B -> P) (g : E -> P) (b : B) (e : E) (z : P)
 (u : Id P (f b) z) (v : Id P (g e) z) {
 paths (w : B * E) : U l = Id P (f w.1) (g w.2) ;
 Cone : U l = (w : B * E) * paths w ;
 point : Cone = ((b, e), H.transH u (H.symH v)) ;
 stage : Arrow = new Arrow[Cone, point, B * E, (b, e), \ w -> w.1, refl (b, e)] ;
 module Q = FibreSequence.Sequence[Cone, B * E, point, (b, e), \ w -> w.1, refl (b, e)] ;
 module Raw = PointedPullback[l].Boundary[B, E, P, f, g, b, e, z, u, v] ;
 flatten (w : Raw.Q.Cone) : Cone = ((w.1, w.2.1), w.2.2) ;
 flatten-equiv : Pl.isEquiv Raw.Q.Cone Cone flatten =
  Pl.qinv Raw.Q.Cone Cone flatten (\ w -> (w.1.1, w.1.2, w.2)) (\ w -> refl w) (\ w -> refl w) ;
 translate : Pl.Equiv (Id P z z) (paths (b, e)) =
  EL.then (Id P z z) (Id P z (g e)) (paths (b, e))
   (SigmaEquiv.post-comp-path-equiv {P} {z} {z} {g e} (H.symH v))
   (SigmaEquiv.pre-comp-path-equiv {P} {f b} {z} {g e} u) ;
 boundary (q : Id P z z) : Cone = ((b, e), translate.1 q) ;
 witness (q : Id P z z) : Q.F = (boundary q, refl (b, e)) ;
 witness-equiv : Pl.isEquiv (Id P z z) Q.F witness =
  EL.compose (Id P z z) (paths (b, e)) Q.F
   (\ r -> (((b, e), r), refl (b, e))) translate.1
   (EL.inverse Q.F (paths (b, e)) (FibreAlg.fib-pr1 (B * E) paths (b, e))).2 translate.2 ;
 witness-point : Id Q.F (witness (refl z)) Q.point =
  H.apH (\ r -> (((b, e), H.transH u r), refl (b, e))) (PA.unit-l (H.symH v)) ;
 over (q : Id P z z) : Id Cone (witness q).1 (boundary q) = refl (boundary q) ;
 raw-boundary (q : Id P z z) : Id Cone (flatten (Raw.boundary q)) (boundary q) = refl (boundary q) ;
 module Source = PointedEquivalence.Loops[Id P z z, Q.F, refl z, Q.point, (witness, witness-equiv), witness-point] ;
 connecting (q : LoopGrp[Id P z z, refl z].grp.G) : LoopGrp[Cone, point].grp.G =
  Q.In.M.map (Source.components.1 q) ;
 hom : PM.is-hom LoopGrp[Id P z z, refl z].grp LoopGrp[Cone, point].grp connecting =
  \ q r -> H.transH (H.apH Q.In.M.map (Source.M.M.mul q r))
   (Q.In.M.mul (Source.components.1 q) (Source.components.1 r)) ;
 zero (q : LoopGrp[Id P z z, refl z].grp.G) :
  Id LoopGrp[B * E, (b, e)].grp.G (Q.Out.M.map (connecting q)) LoopGrp[B * E, (b, e)].grp.e =
  Q.zero (Source.components.1 q) ;
 Image (q : LoopGrp[Cone, point].grp.G) : U l =
  Tr.Trunc[(a : LoopGrp[Id P z z, refl z].grp.G) * Id LoopGrp[Cone, point].grp.G (connecting a) q].carrier ;
 image-prop (q : LoopGrp[Cone, point].grp.G) : Pl.isProp (Image q) =
  Tr.Trunc[(a : LoopGrp[Id P z z, refl z].grp.G) * Id LoopGrp[Cone, point].grp.G (connecting a) q].proposition ;
 image (q : LoopGrp[Cone, point].grp.G) (a : LoopGrp[Q.F, Q.point].grp.G)
  (h : Id LoopGrp[Cone, point].grp.G (Q.In.M.map a) q) : Image q =
  Tr.Trunc[(r : LoopGrp[Id P z z, refl z].grp.G) * Id LoopGrp[Cone, point].grp.G (connecting r) q].inc
   (Source.components.2.sec a, H.transH (H.apH Q.In.M.map (Source.components.2.sec-eq a)) h) ;
 exact (q : LoopGrp[Cone, point].grp.G)
  (h : Id LoopGrp[B * E, (b, e)].grp.G (Q.Out.M.map q) LoopGrp[B * E, (b, e)].grp.e) : Image q =
  TC.rec ((a : LoopGrp[Q.F, Q.point].grp.G) * Id LoopGrp[Cone, point].grp.G (Q.In.M.map a) q)
   @l (Image q) (image-prop q) (\ w -> image q w.1 w.2) (Q.exact q h) ;
} ;
