-- The top vertex of Delta n and the face at it (Agda Simplices/FaceTop,
-- Simplices/FaceTopProof).
--   top 0 = the object of One; top (n+1) = the constant functor I1 o !.
--   c20-top: its ordinal is the top: the monotone map of I1 o ! is
--   constantly 1 (const-ob-is-I1), whose ordinal is the top
--   (fwd-all-inr, by induction).
--   face-pw, c20-face-top: face n (top n) has the ordinal inl (top), which
--   is that of the domain of the last edge (face-top).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
open WildCat ; open HigherCat ; open Constructions ; open Exponentials ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open Construction20 ;
open FaceOrd ; open LastEdge ; open FaceMap ; open FaceOrdCompat ;

top : (n : Nat) -> Ob (Delta n) = split {
 zero -> (terminal One).1 ;
 suc n -> map-to-ob (Delta n) I (comp {Delta n} {One} {I} I1 (bang (Delta n))) } ;

all-ones (k : Nat) : MonotoneOrd k = (\ o -> one2, \ x y le -> tt) ;

fwd-all-inr : (k : Nat) -> Id (Ord (suc k)) (monotone-ord-fwd k (all-ones k)) (inr tt) = split {
 zero -> refl (inr tt) ;
 suc k | r -> H.apH (ord-suc k) r } ;

char-const-eq (k : Nat) :
 Id (Monotone (Delta k)) (I-char-comparison (Delta k) (comp {Delta k} {One} {I} I1 (bang (Delta k)))) (\ z -> one2, \ m -> tt) =
 Pl.Sigma-eq (Ob (Delta k) -> Two) (is-monotone (Delta k))
  (ob-to-2 (comp {Delta k} {One} {I} I1 (bang (Delta k)))) (\ z -> one2)
  (I-char-comparison (Delta k) (comp {Delta k} {One} {I} I1 (bang (Delta k)))).2 (\ m -> tt)
  (FL.funext (Ob (Delta k)) (\ z -> Two) (ob-to-2 (comp {Delta k} {One} {I} I1 (bang (Delta k)))) (\ z -> one2) (const-ob-is-I1 k))
  (is-monotone-is-prop (Delta k) (\ z -> one2)) ;

mt-const-eq (k : Nat) : Id (MonotoneOrd k) ((monotone-transfer k).1 (\ z -> one2, \ m -> tt)) (all-ones k) =
 Pl.Sigma-eq (Ord k -> Two) (is-monotone-Ord k) (\ o -> one2) (\ o -> one2)
  ((monotone-transfer k).1 (\ z -> one2, \ m -> tt)).2 (all-ones k).2 (refl (\ o -> one2))
  (is-monotone-Ord-is-prop k (\ o -> one2)) ;

c20-top : (n : Nat) -> Id (Ord n) ((construction-20 n).1 (top n)) (ord-top n) = split {
 zero -> isTop ((construction-20 zero).1 (top zero)) tt ;
 suc k -> H.transH (H.apH (\ g -> monotone-ord-fwd k ((monotone-transfer k).1 (I-char-comparison (Delta k) g)))
     (ob-map-roundtrip1 (Delta k) I (comp {Delta k} {One} {I} I1 (bang (Delta k)))))
   (H.transH (H.apH (\ w -> monotone-ord-fwd k ((monotone-transfer k).1 w)) (char-const-eq k))
    (H.transH (H.apH (monotone-ord-fwd k) (mt-const-eq k)) (fwd-all-inr k))) } ;

face-pw (n : Nat) (z : Ob (Delta n)) :
 Id Two (ob-to-2 (ob-to-map (Delta n) I (Ob-map (face n) (top n))) z) (face-ord n (ord-top n) ((construction-20 n).1 z)) =
 H.transH (face-pw-gen n (top n) z) (H.apH (\ v -> face-ord n v ((construction-20 n).1 z)) (c20-top n)) ;

c20-face-top (n : Nat) : Id (Ord (suc n)) ((construction-20 (suc n)).1 (Ob-map (face n) (top n))) (inl (ord-top n)) =
 H.transH (c20-face-gen-u n (top n)) (H.apH {Ord n} {Ord (suc n)} (\ v -> inl v) (c20-top n)) ;

face-top (n : Nat) : Id (Ob (Delta (suc n))) (Ob-map (face n) (top n)) (dom (last-edge n)) =
 H.transH (Equivalences[l].injective (Ob (Delta (suc n))) (Ord (suc n)) (construction-20 (suc n)).1 (construction-20 (suc n)).2
   (Ob-map (face n) (top n)) ((construction-20 (suc n)).2.sec (inl (ord-top n)))
   (H.transH (c20-face-top n) (H.symH ((construction-20 (suc n)).2.sec-eq (inl (ord-top n))))))
  (H.symH (dom-last-edge n)) ;
