-- Homotopy invariance, dimension and the empty type (H2).  Internal
-- level 1 of D; the proofs use associativity and the unit laws of D.
--   tmap-has-inv: an equivalence f : X ~ Y gives an invertible
--   tmap A f, with inverse tmap A f^-1: by tmap-comp, tmap-htpy and
--   tmap-id, tmap f tmap f^-1 = tmap (f^-1 o f) = tmap id = id, and
--   symmetrically.
--   dim-has-inv: eta_tt : A -> 1 (x) A is invertible, with inverse
--   r = lift (_ |-> id_A).  eta_tt r = id_A is lift-beta; r eta_tt = id
--   by ext: eta_tt (r eta_tt) = (eta_tt r) eta_tt = eta_tt = eta_tt id.
--   empty-initial: 0 (x) A is initial: Hom (0 (x) A) T is contractible,
--   with centre the lift of the empty family; any two maps are equal by
--   ext, there being no x to check.
open Base ;
module H = Paths[l] ; module CU = FunExtUA[l] ;
open HigherCat ; open Constructions ; open Composition ; open CompLaws ; open Associativity ; open Invertible ; open FullyFaithful ;
open Copower ; open TensorMap ;

tmap-has-inv (A : Ob D) {X Y : U k} (f : X -> Y) (e : Prelude[k].isEquiv X Y f) : has-inv (tmap A f) =
 (tmap A e.sec,
  H.transH (H.symH (tmap-comp A f e.sec))
   (H.transH (tmap-htpy A (\ x -> e.sec (f x)) (\ x -> x) (Prelude[k].sec-ret X Y f e)) (tmap-id A X)),
  H.transH (H.symH (tmap-comp A e.sec f))
   (H.transH (tmap-htpy A (\ y -> f (e.sec y)) (\ y -> y) e.sec-eq) (tmap-id A Y))) ;

tmap-is-inv (A : Ob D) {X Y : U k} (f : X -> Y) (e : Prelude[k].isEquiv X Y f) : is-inv (tmap A f) =
 has-inv-is-inv (tmap A f) (tmap-has-inv A f e) ;

dim-r (A : Ob D) : Hom D (tensor Top A) A = lift Top A A (\ x -> id-hom A) ;

dim-pt (A : Ob D) : (x : Top) ->
 Id (Hom D A (tensor Top A)) (hcomp {D} (eta Top A x) (hcomp {D} (dim-r A) (eta Top A tt))) (hcomp {D} (eta Top A x) (id-hom (tensor Top A))) = split {
 tt -> H.transH (H.symH (hcomp-assoc D (A, tensor Top A, A, tensor Top A, eta Top A tt, dim-r A, eta Top A tt)))
  (H.transH (H.apH (\ u -> hcomp {D} u (eta Top A tt)) (lift-beta Top A A (\ x -> id-hom A) tt))
   (H.transH (hcomp-unit-l (eta Top A tt)) (H.symH (hcomp-unit-r (eta Top A tt))))) } ;

dim-has-inv (A : Ob D) : has-inv (eta Top A tt) =
 (dim-r A, lift-beta Top A A (\ x -> id-hom A) tt,
  ext Top A (tensor Top A) (hcomp {D} (dim-r A) (eta Top A tt)) (id-hom (tensor Top A)) (dim-pt A)) ;

dim-is-inv (A : Ob D) : is-inv (eta Top A tt) = has-inv-is-inv (eta Top A tt) (dim-has-inv A) ;

empty-initial (A T : Ob D) : CU.isContr (Hom D (tensor Empty A) T) =
 (lift Empty A T (\ x -> Prelude[l].absurd (Hom D A T) x),
  \ g -> ext Empty A T (lift Empty A T (\ x -> Prelude[l].absurd (Hom D A T) x)) g
   (\ x -> Prelude[l].absurd (Id (Hom D A T) (hcomp {D} (eta Empty A x) (lift Empty A T (\ x1 -> Prelude[l].absurd (Hom D A T) x1))) (hcomp {D} (eta Empty A x) g)) x)) ;
