-- Functoriality of X |-> X (x) A (H1).  Internal level 1 of D; the laws
-- use associativity and the unit laws of D (level 2 of Cat).
--   tmap A f : X (x) A -> Y (x) A for f : X -> Y, the lift of
--   x |-> eta_(f x).  tmap-beta: eta_x (tmap A f) = eta_(f x).
--   restrict-tmap: eta_x (tmap A f g) = eta_(f x) g, by associativity
--   and tmap-beta.
--   tmap-id: tmap A id = id, by ext: eta_x (tmap id) = eta_x = eta_x id.
--   tmap-comp: tmap A (g o f) = tmap A f tmap A g, by ext: both restrict
--   to eta_(g (f x)) (tmap-beta; restrict-tmap and tmap-beta).
--   tmap-htpy: homotopic maps have equal tmap, by ext and ap eta.
open Base ;
module H = Paths[l] ;
open HigherCat ; open Constructions ; open Composition ; open CompLaws ; open Associativity ; open Copower ;

tmap (A : Ob D) {X Y : U k} (f : X -> Y) : Hom D (tensor X A) (tensor Y A) =
 lift X A (tensor Y A) (\ x -> eta Y A (f x)) ;

tmap-beta (A : Ob D) {X Y : U k} (f : X -> Y) (x : X) :
 Id (Hom D A (tensor Y A)) (hcomp {D} (eta X A x) (tmap A f)) (eta Y A (f x)) =
 lift-beta X A (tensor Y A) (\ x1 -> eta Y A (f x1)) x ;

restrict-tmap (A T : Ob D) {X Y : U k} (f : X -> Y) (g : Hom D (tensor Y A) T) (x : X) :
 Id (Hom D A T) (hcomp {D} (eta X A x) (hcomp {D} (tmap A f) g)) (hcomp {D} (eta Y A (f x)) g) =
 H.transH (H.symH (hcomp-assoc D (A, tensor X A, tensor Y A, T, eta X A x, tmap A f, g)))
  (H.apH (\ u -> hcomp {D} u g) (tmap-beta A f x)) ;

tmap-id (A : Ob D) (X : U k) : Id (Hom D (tensor X A) (tensor X A)) (tmap A (\ x -> x)) (id-hom (tensor X A)) =
 ext X A (tensor X A) (tmap A (\ x -> x)) (id-hom (tensor X A))
  (\ x -> H.transH (tmap-beta A (\ x1 -> x1) x) (H.symH (hcomp-unit-r (eta X A x)))) ;

tmap-comp (A : Ob D) {X Y Z : U k} (f : X -> Y) (g : Y -> Z) :
 Id (Hom D (tensor X A) (tensor Z A)) (tmap A (\ x -> g (f x))) (hcomp {D} (tmap A f) (tmap A g)) =
 ext X A (tensor Z A) (tmap A (\ x -> g (f x))) (hcomp {D} (tmap A f) (tmap A g))
  (\ x -> H.transH (tmap-beta A (\ x1 -> g (f x1)) x)
   (H.symH (H.transH (restrict-tmap A (tensor Z A) f (tmap A g) x) (tmap-beta A g (f x))))) ;

tmap-htpy (A : Ob D) {X Y : U k} (f f1 : X -> Y) (h : (x : X) -> Id Y (f x) (f1 x)) :
 Id (Hom D (tensor X A) (tensor Y A)) (tmap A f) (tmap A f1) =
 ext X A (tensor Y A) (tmap A f) (tmap A f1)
  (\ x -> H.transH (tmap-beta A f x) (H.transH (H.apH (eta Y A) (h x)) (H.symH (tmap-beta A f1 x)))) ;
