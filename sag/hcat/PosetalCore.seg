-- Posetal categories (Agda Posetal/PosetalCore; Rocq is_posetal).
--   MonoOb D C: maps Ob D -> Ob C preserving the (thin) hom relation;
--   ob-action F = (F on objects, F on Hom).
--   is-posetal C: (1) Hom C x y is a proposition, (2) ob-action D C is an
--   equivalence for every D, (3) Ob C is a set.
--   posetal-eq-objects: into a posetal category a functor is determined by
--   its action on objects (clause 2, monotonicity being a proposition by
--   clause 1); posetal-hom-is-set: then Map A B is a set (Hedberg with the
--   relation "agree on objects", a proposition by clause 3).
--   I-posetal: I is posetal.  Clause 2: a monotone f : Ob D -> Ob I, read
--   in Two, is monotone (I-hom-to-order), hence a functor (I-char); the
--   round trips are I-char-rinv (with I-ob injective) and I-char-linv.
--   is-posetal-One: Ob One and Map I One are contractible.
--   Fun X I: Ob (Fun X I) ~ Map X I ~ Monotone X is a set; maps into Fun X I
--   are determined on objects (their transposes into I are); so Hom is
--   thin as for I.
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ; module CU = FunExtUA[l] ;
module EL = EquivalenceLemmas[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open ExpComparison ; open Exponentials ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open HLevels ; open IntervalPosetal ;

is-monotone-ob (D C : Cat) (f : Ob D -> Ob C) : U l = (x y : Ob D) -> Hom D x y -> Hom C (f x) (f y) ;

MonoOb (D C : Cat) : U l = (f : Ob D -> Ob C) * is-monotone-ob D C f ;

ob-action (D C : Cat) (F : Map D C) : MonoOb D C = (Ob-map F, \ x y h -> Hom-map F x y h) ;

is-posetal (C : Cat) : U l+ =
 ((x y : Ob C) -> Pl.isProp (Hom C x y)) *
 ((D : Cat) -> Pl.isEquiv (Map D C) (MonoOb D C) (ob-action D C)) *
 Pl.isSet (Ob C) ;

is-monotone-ob-is-prop (D C : Cat) (thin : (x y : Ob C) -> Pl.isProp (Hom C x y)) (f : Ob D -> Ob C) :
 Pl.isProp (is-monotone-ob D C f) =
 FL.isProp-Pi (Ob D) (\ x -> (y : Ob D) -> Hom D x y -> Hom C (f x) (f y)) (\ x ->
  FL.isProp-Pi (Ob D) (\ y -> Hom D x y -> Hom C (f x) (f y)) (\ y ->
   FL.isProp-Pi (Hom D x y) (\ h -> Hom C (f x) (f y)) (\ h -> thin (f x) (f y)))) ;

posetal-eq-objects (A B : Cat) (P : is-posetal B) (f g : Map A B)
 (e : (x : Ob A) -> Id (Ob B) (Ob-map f x) (Ob-map g x)) : Id (Map A B) f g =
 Equivalences[l].injective (Map A B) (MonoOb A B) (ob-action A B) (P.2.1 A) f g
  (Pl.Sigma-eq (Ob A -> Ob B) (is-monotone-ob A B) (Ob-map f) (Ob-map g) (ob-action A B f).2 (ob-action A B g).2
    (FL.funext (Ob A) (\ x -> Ob B) (Ob-map f) (Ob-map g) e)
    (is-monotone-ob-is-prop A B P.1 (Ob-map g))) ;

posetal-hom-is-set (A B : Cat) (P : is-posetal B) : Pl.isSet (Map A B) =
 hedberg-set (Map A B) (\ f g -> (x : Ob A) -> Id (Ob B) (Ob-map f x) (Ob-map g x))
  (\ f g -> FL.isProp-Pi (Ob A) (\ x -> Id (Ob B) (Ob-map f x) (Ob-map g x)) (\ x -> P.2.2 (Ob-map f x) (Ob-map g x)))
  (\ f x -> refl (Ob-map f x))
  (\ f g e -> posetal-eq-objects A B P f g e) ;

------------------------------------------------------------------------
-- I is posetal

module IClause2 (D : Cat) {
 to2 (f : Ob D -> Ob I) (z : Ob D) : Two = I-ob.1 (f z) ;
 m-to (f : Ob D -> Ob I) (p : is-monotone-ob D I f) : is-monotone D (to2 f) = \ m ->
  I-hom-to-order (f (dom m)) (f (cod m)) (p (dom m) (cod m) (m, refl (dom m), refl (cod m))) ;
 inv (w : MonoOb D I) : Map D I = I-char-inverse D (to2 w.1, m-to w.1 w.2) ;
 rinv (w : MonoOb D I) : Id (MonoOb D I) (ob-action D I (inv w)) w =
  Pl.Sigma-eq (Ob D -> Ob I) (is-monotone-ob D I) (Ob-map (inv w)) w.1 (ob-action D I (inv w)).2 w.2
   (FL.funext (Ob D) (\ z -> Ob I) (Ob-map (inv w)) w.1 (\ z ->
     Equivalences[l].injective (Ob I) Two I-ob.1 I-ob.2 (Ob-map (inv w) z) (w.1 z)
      (H.apH (\ v -> v.1 z) (I-char-rinv D (to2 w.1, m-to w.1 w.2)))))
   (is-monotone-ob-is-prop D I I-thin w.1) ;
 linv (F : Map D I) : Id (Map D I) (inv (ob-action D I F)) F =
  H.transH (H.apH (I-char-inverse D)
    (Pl.Sigma-eq (Ob D -> Two) (is-monotone D) (ob-to-2 F) (ob-to-2 F)
      (m-to (Ob-map F) (ob-action D I F).2) (I-char-comparison D F).2 (refl (ob-to-2 F))
      (is-monotone-is-prop D (ob-to-2 F))))
   (I-char-linv D F) ;
 equiv : Pl.isEquiv (Map D I) (MonoOb D I) (ob-action D I) =
  Pl.qinv (Map D I) (MonoOb D I) (ob-action D I) inv rinv linv ;
} ;

I-posetal-clause2 (D : Cat) : Pl.isEquiv (Map D I) (MonoOb D I) (ob-action D I) = IClause2[D].equiv ;

I-posetal : is-posetal I = (I-thin, I-posetal-clause2, ob-I-is-set) ;

------------------------------------------------------------------------
-- One is posetal

One-thin (x y : Ob One) : Pl.isProp (Hom One x y) = \ h1 h2 ->
 Pl.Sigma-eq (Mor One) (\ m -> Id (Ob One) (dom m) x * Id (Ob One) (cod m) y) (hmor h1) (hmor h2) h1.2 h2.2
  (CU.pathC (Map I One) (terminal I) (hmor h1) (hmor h2))
  (prod-is-prop (Id (Ob One) (dom (hmor h2)) x) (Id (Ob One) (cod (hmor h2)) y)
    (one-set {One} (dom (hmor h2)) x) (one-set {One} (cod (hmor h2)) y)) ;

One-monotone (D : Cat) (f : Ob D -> Ob One) : is-monotone-ob D One f = \ x y h ->
 (id-mor {One} (f x), dom-id {One} (f x), H.transH (cod-id {One} (f x)) (one-path {One} (f x) (f y))) ;

is-posetal-One : is-posetal One =
 (One-thin,
  \ D -> map-between-contrs-is-equiv (ob-action D One) (terminal D)
   (Sigma-prop-contr (Ob D -> Ob One) (is-monotone-ob D One)
     (fn-into-contr-is-contr (Ob D) (Ob One) (terminal One))
     (is-monotone-ob-is-prop D One One-thin) (One-monotone D)),
  one-set {One}) ;

------------------------------------------------------------------------
-- Fun X I: objects form a set, and Hom is thin

ob-FunXI-is-set (X : Cat) : Pl.isSet (Ob (Fun X I)) =
 AffineHLevels[l].set-from-equiv (Ob (Fun X I)) (Monotone X)
  (Sigma-set-prop (Ob X -> Two) (is-monotone X) (FL.isSet-Pi (Ob X) (\ z -> Two) (\ z -> Two-is-set)) (is-monotone-is-prop X))
  (EL.then (Ob (Fun X I)) (Map X I) (Monotone X) (ob-map-equiv X I) (I-char X)).1
  (EL.then (Ob (Fun X I)) (Map X I) (Monotone X) (ob-map-equiv X I) (I-char X)).2 ;

-- the transpose of m at an object w of A x X is ev <m (pi1 w), pi2 w>
eval-lemma (X A : Cat) (m : Map A (Fun X I)) (w : Ob (times A X)) :
 Id (Ob I) (Ob-map (exp-comparison X I A m) w)
  (comp (ev X I) (pair {Fun X I} {X} {One} (comp {One} {A} {Fun X I} m (comp {One} {times A X} {A} (pi1 A X) w)) (comp {One} {times A X} {X} (pi2 A X) w))) =
 H.transH (composeA {One} {times A X} {times (Fun X I) X} {I} (ev X I) (pair (comp m (pi1 A X)) (pi2 A X)) w)
  (ccr (ev X I) (H.transH (pair-nat (comp m (pi1 A X)) (pi2 A X) w)
   (pair-ap (composeA {One} {times A X} {A} {Fun X I} m (pi1 A X) w) (refl (comp {One} {times A X} {X} (pi2 A X) w))))) ;

map-into-FunXI-eq (X A : Cat) (m1 m2 : Map A (Fun X I))
 (agree : (z : Ob A) -> Id (Ob (Fun X I)) (Ob-map m1 z) (Ob-map m2 z)) : Id (Map A (Fun X I)) m1 m2 =
 Equivalences[l].injective (Map A (Fun X I)) (Map (times A X) I) (exp-comparison X I A) (exp-is-equiv X I A) m1 m2
  (map-into-I-eq (times A X) (exp-comparison X I A m1) (exp-comparison X I A m2) (\ w ->
    H.transH (eval-lemma X A m1 w)
     (H.transH (H.apH (\ phi -> comp (ev X I) (pair {Fun X I} {X} {One} phi (comp {One} {times A X} {X} (pi2 A X) w)))
        (agree (Ob-map (pi1 A X) w)))
      (H.symH (eval-lemma X A m2 w))))) ;

Fun-I-thin (X : Cat) (x y : Ob (Fun X I)) : Pl.isProp (Hom (Fun X I) x y) =
 thin-from {Fun X I} (ob-FunXI-is-set X) (map-into-FunXI-eq X I) x y ;
