-- The predicate of the face map on ordinals (Agda Interval/FaceOrd):
-- face-ord n v = the monotone map Ord n -> Two of the ordinal inl v of
-- Ord (n+1); monotone in u (it is monotone) and in v (monotone-ord-bwd-pw).
open Base ; open Finite[l] ; open OrdMonotone ;

face-ord (n : Nat) (v u : Ord n) : Two = (monotone-ord-bwd n (inl v)).1 u ;

face-ord-mono-u (n : Nat) (v u u1 : Ord n) (le : leqOrd n u u1) : leq2 (face-ord n v u) (face-ord n v u1) =
 (monotone-ord-bwd n (inl v)).2 u u1 le ;

face-ord-mono-v (n : Nat) (v v1 u : Ord n) (le : leqOrd n v v1) : leq2 (face-ord n v u) (face-ord n v1 u) =
 monotone-ord-bwd-pw n (inl v) (inl v1) le u ;

face-ord-mono (n : Nat) (v v1 u u1 : Ord n) (lev : leqOrd n v v1) (leu : leqOrd n u u1) :
 leq2 (face-ord n v u) (face-ord n v1 u1) =
 leq2-trans (face-ord n v u) (face-ord n v1 u) (face-ord n v1 u1) (face-ord-mono-v n v v1 u lev) (face-ord-mono-u n v1 u u1 leu) ;
