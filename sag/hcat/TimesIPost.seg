-- (k x I) o (c x I) = (k o c) x I, and the comparison of S x I at k x I
-- (split from TimesICone for the 1 s budget; the proofs are described there).
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module PM = PathMoves[l] ;
open WildCat ; open Pullbacks ; open ProductMap ; open Squares ; open SquareAlg ; open ConeAlg ;
open ProductPentagon ; open ProductPentagonR ; open ProductPentagonR2 ;
open TimesICone ;

cone-times-post (S : Square) {Y Z : Cat} (k : Map Y Z) (c : sq-cone S Y) :
 Id (sq-cone (times-I S) (times Z I)) (cone-post (times-I S) (product-map k (idMap I)) (timesI-cone S c)) (timesI-cone S (cone-post S k c)) =
 SquareAlg.cone-eq (times-I S) (times Z I) (cone-post (times-I S) (product-map k (idMap I)) (timesI-cone S c)) (timesI-cone S (cone-post S k c))
  (H.symH (theta k g)) (H.symH (theta k e)) (H.transH lhsNF (H.symH rhsNF))
 where {
  g : Map S.sqC Y = cg S Y c ;
  e : Map S.sqB Y = ce S Y c ;
  s : Id (Map S.sqA Y) (comp g S.sql) (comp e S.sqt) = cc S Y c ;
  pk : Map (times Y I) (times Z I) = product-map k (idMap I) ;
  a1 : Id (Map (times S.sqA I) (times Z I)) (comp (comp pk (product-map g (idMap I))) (product-map S.sql (idMap I)))
   (comp pk (comp (product-map g (idMap I)) (product-map S.sql (idMap I)))) =
   composeA pk (product-map g (idMap I)) (product-map S.sql (idMap I)) ;
  a2 : Id (Map (times S.sqA I) (times Z I)) (comp (comp pk (product-map e (idMap I))) (product-map S.sqt (idMap I)))
   (comp pk (comp (product-map e (idMap I)) (product-map S.sqt (idMap I)))) =
   composeA pk (product-map e (idMap I)) (product-map S.sqt (idMap I)) ;
  te : Id (Map (times S.sqA I) (times Z I)) (comp pk (comp (product-map e (idMap I)) (product-map S.sqt (idMap I))))
   (comp (product-map (comp k e) (idMap I)) (product-map S.sqt (idMap I))) =
   H.transH (H.symH a2) (ccl (product-map S.sqt (idMap I)) (H.symH (theta k e))) ;
  NF : Id (Map (times S.sqA I) (times Z I)) (comp (comp pk (product-map g (idMap I))) (product-map S.sql (idMap I)))
   (comp (product-map (comp k e) (idMap I)) (product-map S.sqt (idMap I))) =
   H.transH a1 (H.transH (ccr pk (H.symH (theta g S.sql))) (H.transH (ccr pk (product-map-eq1 (idMap I) s))
    (H.transH (ccr pk (theta e S.sqt)) te))) ;
  rhsNF : Id (Id (Map (times S.sqA I) (times Z I)) (comp (comp pk (product-map g (idMap I))) (product-map S.sql (idMap I)))
    (comp (product-map (comp k e) (idMap I)) (product-map S.sqt (idMap I))))
   (H.transH (cc (times-I S) (times Z I) (cone-post (times-I S) pk (timesI-cone S c))) (ccl (product-map S.sqt (idMap I)) (H.symH (theta k e)))) NF =
   H.transH (PM.flat3 a1 (ccr pk (H.transH (H.symH (theta g S.sql)) (H.transH (product-map-eq1 (idMap I) s) (theta e S.sqt))))
     (H.symH a2) (ccl (product-map S.sqt (idMap I)) (H.symH (theta k e))))
    (H.apH (\ q -> H.transH a1 q)
     (H.transH (PM.apt (\ u -> comp pk u) (H.symH (theta g S.sql)) (H.transH (product-map-eq1 (idMap I) s) (theta e S.sqt)) te)
      (H.apH (\ q -> H.transH (ccr pk (H.symH (theta g S.sql))) q)
       (PM.apt (\ u -> comp pk u) (product-map-eq1 (idMap I) s) (theta e S.sqt) te)))) ;
  -- the far end: (k e t)^-1 x I
  tl : Id (Map (times S.sqA I) (times Z I)) (product-map (comp k (comp e S.sqt)) (idMap I))
   (comp (product-map (comp k e) (idMap I)) (product-map S.sqt (idMap I))) =
   H.transH (product-map-eq1 (idMap I) (H.symH (composeA k e S.sqt))) (theta (comp k e) S.sqt) ;
  end : Id (Id (Map (times S.sqA I) (times Z I)) (comp pk (product-map (comp e S.sqt) (idMap I)))
    (comp (product-map (comp k e) (idMap I)) (product-map S.sqt (idMap I))))
   (H.transH (H.symH (theta k (comp e S.sqt))) tl) (H.transH (ccr pk (theta e S.sqt)) te) =
   H.transH (H.apH (\ z -> H.transH (H.symH (theta k (comp e S.sqt))) (H.transH z (theta (comp k e) S.sqt)))
     (H.transH (PA.ap-sym (\ f -> product-map f (idMap I)) (composeA k e S.sqt)) (H.apH (\ q -> H.symH q) (pent-theta k e S.sqt))))
   (H.transH (peel (theta (comp k e) S.sqt) (ccl (product-map S.sqt (idMap I)) (theta k e)) a2
      (ccr pk (H.symH (theta e S.sqt))) (theta k (comp e S.sqt)))
    (H.transH (H.apH (\ z -> H.transH z (H.transH (H.symH a2) (H.symH (ccl (product-map S.sqt (idMap I)) (theta k e)))))
       (H.transH (H.apH (\ q -> H.symH q) (PA.ap-sym (\ u -> comp pk u) (theta e S.sqt))) (PA.sym-sym (ccr pk (theta e S.sqt)))))
     (H.apH (\ z -> H.transH (ccr pk (theta e S.sqt)) (H.transH (H.symH a2) z))
      (H.symH (PA.ap-sym (\ u -> comp u (product-map S.sqt (idMap I))) (theta k e)))))) ;
  lhsNF : Id (Id (Map (times S.sqA I) (times Z I)) (comp (comp pk (product-map g (idMap I))) (product-map S.sql (idMap I)))
    (comp (product-map (comp k e) (idMap I)) (product-map S.sqt (idMap I))))
   (H.transH (ccl (product-map S.sql (idMap I)) (H.symH (theta k g))) (cc (times-I S) (times Z I) (timesI-cone S (cone-post S k c)))) NF =
   H.transH (H.apH (\ q -> H.transH (ccl (product-map S.sql (idMap I)) (H.symH (theta k g))) (H.transH (H.symH (theta (comp k g) S.sql)) q))
     (H.transH (PM.apt (\ f -> product-map f (idMap I)) (composeA k g S.sql) (H.transH (ccr k s) (H.symH (composeA k e S.sqt))) (theta (comp k e) S.sqt))
      (H.transH (H.apH (\ q -> H.transH (product-map-eq1 (idMap I) (composeA k g S.sql)) q)
         (PM.apt (\ f -> product-map f (idMap I)) (ccr k s) (H.symH (composeA k e S.sqt)) (theta (comp k e) S.sqt)))
       (H.apH (\ q -> H.transH q (H.transH (product-map-eq1 (idMap I) (ccr k s)) tl)) (pent-theta k g S.sql)))))
   (H.transH (H.apH (\ q -> H.transH (ccl (product-map S.sql (idMap I)) (H.symH (theta k g))) (H.transH (H.symH (theta (comp k g) S.sql)) q))
     (tail5 (theta (comp k g) S.sql) (ccl (product-map S.sql (idMap I)) (theta k g)) a1 (ccr pk (H.symH (theta g S.sql)))
       (H.symH (theta k (comp g S.sql))) (H.transH (product-map-eq1 (idMap I) (ccr k s)) tl)))
   (H.transH (H.apH (\ q -> H.transH (ccl (product-map S.sql (idMap I)) (H.symH (theta k g))) q)
     (PA.canc-l (theta (comp k g) S.sql) (H.transH (ccl (product-map S.sql (idMap I)) (theta k g)) (H.transH a1
       (H.transH (ccr pk (H.symH (theta g S.sql))) (H.transH (H.symH (theta k (comp g S.sql))) (H.transH (product-map-eq1 (idMap I) (ccr k s)) tl)))))))
   (H.transH (H.apH (\ q -> H.transH q (H.transH (ccl (product-map S.sql (idMap I)) (theta k g)) (H.transH a1
       (H.transH (ccr pk (H.symH (theta g S.sql))) (H.transH (H.symH (theta k (comp g S.sql))) (H.transH (product-map-eq1 (idMap I) (ccr k s)) tl))))))
      (PA.ap-sym (\ u -> comp u (product-map S.sql (idMap I))) (theta k g)))
   (H.transH (PA.canc-l (ccl (product-map S.sql (idMap I)) (theta k g)) (H.transH a1
       (H.transH (ccr pk (H.symH (theta g S.sql))) (H.transH (H.symH (theta k (comp g S.sql))) (H.transH (product-map-eq1 (idMap I) (ccr k s)) tl)))))
    (H.apH (\ q -> H.transH a1 (H.transH (ccr pk (H.symH (theta g S.sql))) q))
     (H.transH (nat-swap (theta-nat k s) tl)
      (H.apH (\ q -> H.transH (ccr pk (product-map-eq1 (idMap I) s)) q) end))))))) ;
 } ;

comparison-times (S : Square) {Y : Cat} (k : Map S.sqD Y) :
 Id (sq-cone (times-I S) (times Y I)) (sq-comparison (times-I S) (times Y I) (product-map k (idMap I)))
  (timesI-cone S (sq-comparison S Y k)) =
 H.transH (H.apH (cone-post (times-I S) (product-map k (idMap I))) (base-times S))
  (cone-times-post S k (base-cone S)) ;
