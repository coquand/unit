-- Homology groups (H4).
--   Sph n = Sigma^n 1 (1 = unitD), and
--     homology n X A = pi0 (Hom (Sph n, X (x) A)),
--   the set of components of the maps from the n-sphere object into
--   X (x) A (for D spectra, pi_n of the spectrum X_+ ^ A).
--   loop-grp B E: the group on pi0 Hom (Sigma B, E), moved along pi0 of
--   the loop equivalence L from pi_1 (Hom (B, E), 0); so homology (n+1) X A
--   is a group (hgrp), by definition of Sph (hgrp-carrier).
--   loop-grp-ab: for B = Sigma B1 the loops in Hom (Sigma B1, E) commute
--   (Eckmann-Hilton through L B1), so homology (n+2) X A is abelian.
--   With stability: stab-grp B E on pi0 Hom (B, E), moved along sigma
--   (StableLoop) from pi_1 (Hom (B, Sigma E), 0): homology 0 X A is a group
--   too.  Loops in every Hom (B, E) commute (Eckmann-Hilton through
--   sigma), so every loop-grp and every stab-grp is abelian
--   (loop-grp-ab-stable, stab-grp-ab).
open Base ;
module Pl = Prelude[l] ;
open HigherCat ; open Constructions ; open Composition ; open Zero ; open Loops ; open StableLoop ;
open Group[l] ; open Pi0[l] ;

Sph : Nat -> Ob D = split { zero -> unitD ; suc n | r -> susp r } ;

homology (n : Nat) (X : U k) (A : Ob D) : U l = pi0 (Hom D (Sph n) (tensor X A)) ;

module LoopGroup (B E : Ob D) {
 e : Pl.Equiv (pi0 (Hom D (susp B) E)) (LoopGrp[Hom D B E, zmap B E].grp.G) =
  pi0-equiv (Hom D (susp B) E) (Id (Hom D B E) (zmap B E) (zmap B E)) (LoopOf[B].L E, LoopOf[B].L-equiv E) ;
 grp : Grp = TransportGrp[LoopGrp[Hom D B E, zmap B E].grp, pi0 (Hom D (susp B) E), e].grp ;
} ;

hgrp (n : Nat) (X : U k) (A : Ob D) : Grp = LoopGroup[Sph n, tensor X A].grp ;

hgrp-carrier (n : Nat) (X : U k) (A : Ob D) : Id (U l) (hgrp n X A).G (homology (suc n) X A) = refl (homology (suc n) X A) ;

loop-grp-ab (B1 E : Ob D) : is-abelian LoopGroup[susp B1, E].grp =
 transport-ab (LoopGrp[Hom D (susp B1) E, zmap (susp B1) E].grp) (pi0 (Hom D (susp (susp B1)) E)) LoopGroup[susp B1, E].e
  (loop-ab (Hom D (susp B1) E) (zmap (susp B1) E)
   (EckmannHilton.loop-comm (Hom D (susp B1) E) (Hom D B1 E) (zmap B1 E) (LoopOf[B1].L E) (LoopOf[B1].L-equiv E) (zmap (susp B1) E))) ;

hgrp-ab (n : Nat) (X : U k) (A : Ob D) : is-abelian (hgrp (suc n) X A) = loop-grp-ab (Sph n) (tensor X A) ;

------------------------------------------------------------------------
-- with stability

module StabGroup (B E : Ob D) {
 e : Pl.Equiv (pi0 (Hom D B E)) (LoopGrp[Hom D B (susp E), zmap B (susp E)].grp.G) =
  pi0-equiv (Hom D B E) (Id (Hom D B (susp E)) (zmap B (susp E)) (zmap B (susp E))) (StabLoop[B, E].sigma, StabLoop[B, E].sigma-equiv) ;
 grp : Grp = TransportGrp[LoopGrp[Hom D B (susp E), zmap B (susp E)].grp, pi0 (Hom D B E), e].grp ;
} ;

-- loops in Hom (B, E) at 0 commute
stable-comm (B E : Ob D) (a b : Id (Hom D B E) (zmap B E) (zmap B E)) :
 Id (Id (Hom D B E) (zmap B E) (zmap B E)) (Paths[l].transH a b) (Paths[l].transH b a) =
 EckmannHilton.loop-comm (Hom D B E) (Hom D B (susp E)) (zmap B (susp E)) StabLoop[B, E].sigma StabLoop[B, E].sigma-equiv (zmap B E) a b ;

stab-grp-ab (B E : Ob D) : is-abelian StabGroup[B, E].grp =
 transport-ab (LoopGrp[Hom D B (susp E), zmap B (susp E)].grp) (pi0 (Hom D B E)) StabGroup[B, E].e
  (loop-ab (Hom D B (susp E)) (zmap B (susp E)) (stable-comm B (susp E))) ;

loop-grp-ab-stable (B E : Ob D) : is-abelian LoopGroup[B, E].grp =
 transport-ab (LoopGrp[Hom D B E, zmap B E].grp) (pi0 (Hom D (susp B) E)) LoopGroup[B, E].e
  (loop-ab (Hom D B E) (zmap B E) (stable-comm B E)) ;

hgrp0 (X : U k) (A : Ob D) : Grp = StabGroup[unitD, tensor X A].grp ;

hgrp0-carrier (X : U k) (A : Ob D) : Id (U l) (hgrp0 X A).G (homology zero X A) = refl (homology zero X A) ;

hgrp-ab-stable (n : Nat) (X : U k) (A : Ob D) : is-abelian (hgrp n X A) = loop-grp-ab-stable (Sph n) (tensor X A) ;
