-- Fully faithful functors (Wärn, results 33-39; Agda
-- Simplices/FullyFaithful, with its three constructible postulates now
-- proved: Hom-map-comp (CompLaws), id-hom-is-inv, is-inv-mor-is-prop
-- (Invertible)).  Level 2.  Axioms used: rezk, I-detects-equiv.
--   has-inv f: a two-sided inverse (condition 1 of Definition 34).  It
--   gives is-inv f: postcomposition with g is inverse to that with f, by
--   associativity and the unit laws.  Conversely, if postcomposition
--   with f is an equivalence, g = (- f)^-1 (id b) has g f = id; and
--   (f g) f = f (g f) = f = id f, so f g = id since - f is injective.
--   functor-pres-inv: a functor preserves two-sided inverses
--   (Hom-map-hcomp, Hom-map-id), hence invertibility.
--   Lemma 35 (ff-reflects-inv): F (g f) = F g F f, so
--   F o (- f) = (- F f) o F; the right side is an equivalence when F f is
--   invertible and F is fully faithful, so - f is one (cancel-equiv).
--   idtoiso p moves (id a, id-is-inv a) along p; by rezk and the
--   fundamental theorem of identity types it is an equivalence
--   (rezk-idtoiso: the form of the Rezk axiom in the Agda proof).
--   Lemma 37 (ff-emb): for F fully faithful, ap F : (a0 = a1) -> (F a0 = F a1)
--   is an equivalence.  isoact (f, i) = (F f, F i) is one: the Sigma of
--   the equivalence Hom-map F over a fibrewise equivalence of
--   propositions (F preserves and reflects invertibility).  And
--   idtoiso (ap F p) = isoact (idtoiso p) (J on p, Hom-map-id), so ap F is
--   idtoiso^-1 o isoact o idtoiso.
--   Remark 39 (ff-surj-iso): a fully faithful functor surjective on
--   objects is an isomorphism.  Ob-map F is an embedding (Lemma 37) and
--   surjective, hence an equivalence.  Mor C ~ (a, b : Ob C) * Hom C a b
--   (mor-ends), and through it postcomposition with F is
--   ((a, b), h) |-> ((F a, F b), F h): the fibrewise equivalence Hom-map F
--   followed by the base change along Ob-map F x Ob-map F.  So
--   post-comp F I is an equivalence, and F is an isomorphism by
--   I-detects-equiv.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open SigmaEquiv ; open FibreLemmas ;
open HomFunctor ; open Composition ; open CompLaws ; open Associativity ; open Invertible ;

has-inv {C : Cat} {a b : Ob C} (f : Hom C a b) : U l =
 (g : Hom C b a) * Id (Hom C a a) (hcomp f g) (id-hom a) * Id (Hom C b b) (hcomp g f) (id-hom b) ;

-- postcomposition with f, then with g
post-post {C : Cat} {x a b : Ob C} (f : Hom C a b) (g : Hom C b a) (e : Id (Hom C b b) (hcomp g f) (id-hom b)) (k : Hom C x b) :
 Id (Hom C x b) (hcomp (hcomp k g) f) k =
 H.transH (hcomp-assoc C (x, b, a, b, k, g, f)) (H.transH (H.apH (\ u -> hcomp k u) e) (hcomp-unit-r k)) ;

has-inv-is-inv {C : Cat} {a b : Ob C} (f : Hom C a b) (w : has-inv f) : is-inv f = \ x ->
 Pl.qinv (Hom C x a) (Hom C x b) (\ g -> hcomp g f) (\ k -> hcomp k w.1)
  (\ k -> post-post f w.1 w.2.2 k) (\ k -> post-post w.1 f w.2.1 k) ;

is-inv-has-inv {C : Cat} {a b : Ob C} (f : Hom C a b) (i : is-inv f) : has-inv f =
 ((i b).sec (id-hom b),
  Equivalences[l].injective (Hom C a a) (Hom C a b) (\ g -> hcomp g f) (i a) (hcomp f ((i b).sec (id-hom b))) (id-hom a)
   (H.transH (hcomp-assoc C (a, b, a, b, f, (i b).sec (id-hom b), f))
    (H.transH (H.apH (\ u -> hcomp f u) ((i b).sec-eq (id-hom b)))
     (H.transH (hcomp-unit-r f) (H.symH (hcomp-unit-l f))))),
  (i b).sec-eq (id-hom b)) ;

id-is-inv {C : Cat} (a : Ob C) : is-inv (id-hom a) = \ x ->
 EL.homotopy (Hom C x a) (Hom C x a) (\ g -> g) (\ g -> hcomp g (id-hom a)) (\ g -> H.symH (hcomp-unit-r g))
  (Pl.idEquiv (Hom C x a)).2 ;

functor-pres-has-inv {A B : Cat} (F : Map A B) {a b : Ob A} (f : Hom A a b) (w : has-inv f) :
 has-inv (Hom-map F a b f) =
 (Hom-map F b a w.1,
  H.transH (H.symH (Hom-map-hcomp F f w.1)) (H.transH (H.apH (Hom-map F a a) w.2.1) (Hom-map-id F a)),
  H.transH (H.symH (Hom-map-hcomp F w.1 f)) (H.transH (H.apH (Hom-map F b b) w.2.2) (Hom-map-id F b))) ;

functor-pres-inv {A B : Cat} (F : Map A B) {a b : Ob A} (f : Hom A a b) (i : is-inv f) : is-inv (Hom-map F a b f) =
 has-inv-is-inv (Hom-map F a b f) (functor-pres-has-inv F f (is-inv-has-inv f i)) ;

-- Lemma 35
ff-reflects-inv {A B : Cat} (F : Map A B) (ff : is-ff F) {a b : Ob A} (f : Hom A a b) (i : is-inv (Hom-map F a b f)) :
 is-inv f = \ x ->
 cancel-equiv (Hom A x a) (Hom A x b) (Hom B (Ob-map F x) (Ob-map F b)) (\ g -> hcomp g f) (Hom-map F x b) (ff x b)
  (EL.homotopy (Hom A x a) (Hom B (Ob-map F x) (Ob-map F b))
    (\ g -> hcomp (Hom-map F x a g) (Hom-map F a b f)) (\ g -> Hom-map F x b (hcomp g f))
    (\ g -> H.symH (Hom-map-hcomp F g f))
    (EL.compose (Hom A x a) (Hom B (Ob-map F x) (Ob-map F a)) (Hom B (Ob-map F x) (Ob-map F b))
      (\ k -> hcomp k (Hom-map F a b f)) (Hom-map F x a) (i (Ob-map F x)) (ff x a))) ;

------------------------------------------------------------------------
-- the Rezk axiom as an equivalence (a = b) ~ (a iso b)

idtoiso {C : Cat} {a b : Ob C} (p : Id (Ob C) a b) : ObIso C a b = H.substH (ObIso C a) p (id-hom a, id-is-inv a) ;

rezk-idtoiso (C : Cat) (a b : Ob C) : Pl.isEquiv (Id (Ob C) a b) (ObIso C a b) (\ p -> idtoiso p) =
 id-equiv-of-contr (Ob C) a (ObIso C a) (id-hom a, id-is-inv a) (rezk C a) b ;

------------------------------------------------------------------------
-- Lemma 37

isoact {A B : Cat} (F : Map A B) {a0 a1 : Ob A} (u : ObIso A a0 a1) : ObIso B (Ob-map F a0) (Ob-map F a1) =
 (Hom-map F a0 a1 u.1, functor-pres-inv F u.1 u.2) ;

isoact-equiv {A B : Cat} (F : Map A B) (ff : is-ff F) (a0 a1 : Ob A) :
 Pl.isEquiv (ObIso A a0 a1) (ObIso B (Ob-map F a0) (Ob-map F a1)) (\ u -> isoact F u) =
 EL.compose (ObIso A a0 a1) ((f : Hom A a0 a1) * is-inv (Hom-map F a0 a1 f)) (ObIso B (Ob-map F a0) (Ob-map F a1))
  (Sigma-change-of-base (Hom A a0 a1) (Hom B (Ob-map F a0) (Ob-map F a1)) (\ g -> is-inv g) (Hom-map F a0 a1, ff a0 a1)).1
  (Sigma-fiberwise-equiv (Hom A a0 a1) (\ f -> is-inv f) (\ f -> is-inv (Hom-map F a0 a1 f)) fibre).1
  (Sigma-change-of-base (Hom A a0 a1) (Hom B (Ob-map F a0) (Ob-map F a1)) (\ g -> is-inv g) (Hom-map F a0 a1, ff a0 a1)).2
  (Sigma-fiberwise-equiv (Hom A a0 a1) (\ f -> is-inv f) (\ f -> is-inv (Hom-map F a0 a1 f)) fibre).2
 where {
  fibre (f : Hom A a0 a1) : Pl.Equiv (is-inv f) (is-inv (Hom-map F a0 a1 f)) =
   prop-equiv (is-inv f) (is-inv (Hom-map F a0 a1 f)) (is-inv-prop f) (is-inv-prop (Hom-map F a0 a1 f))
    (functor-pres-inv F f) (ff-reflects-inv F ff f) ;
 } ;

rezk-square {A B : Cat} (F : Map A B) {a0 a1 : Ob A} (p : Id (Ob A) a0 a1) :
 Id (ObIso B (Ob-map F a0) (Ob-map F a1)) (idtoiso (H.apH (Ob-map F) p)) (isoact F (idtoiso p)) =
 idJ (Ob A) a0 (\ a2 p2 -> Id (ObIso B (Ob-map F a0) (Ob-map F a2)) (idtoiso (H.apH (Ob-map F) p2)) (isoact F (idtoiso p2)))
  (Pl.Sigma-eq (Hom B (Ob-map F a0) (Ob-map F a0)) (\ g -> is-inv g)
    (id-hom (Ob-map F a0)) (Hom-map F a0 a0 (id-hom a0)) (id-is-inv (Ob-map F a0)) (functor-pres-inv F (id-hom a0) (id-is-inv a0))
    (H.symH (Hom-map-id F a0)) (is-inv-prop (Hom-map F a0 a0 (id-hom a0))))
  a1 p ;

ff-emb {A B : Cat} (F : Map A B) (ff : is-ff F) : is-embedding (Ob-map F) = \ a0 a1 ->
 EL.homotopy (Id (Ob A) a0 a1) (Id (Ob B) (Ob-map F a0) (Ob-map F a1))
  (\ p -> (rezk-idtoiso B (Ob-map F a0) (Ob-map F a1)).sec (isoact F (idtoiso p))) (\ p -> H.apH (Ob-map F) p)
  (\ p -> H.transH (H.apH (rezk-idtoiso B (Ob-map F a0) (Ob-map F a1)).sec (H.symH (rezk-square F p)))
           (Pl.sec-ret (Id (Ob B) (Ob-map F a0) (Ob-map F a1)) (ObIso B (Ob-map F a0) (Ob-map F a1))
             (\ q -> idtoiso q) (rezk-idtoiso B (Ob-map F a0) (Ob-map F a1)) (H.apH (Ob-map F) p)))
  (EL.compose (Id (Ob A) a0 a1) (ObIso B (Ob-map F a0) (Ob-map F a1)) (Id (Ob B) (Ob-map F a0) (Ob-map F a1))
    (rezk-idtoiso B (Ob-map F a0) (Ob-map F a1)).sec (\ p -> isoact F (idtoiso p))
    (EL.inverse (Id (Ob B) (Ob-map F a0) (Ob-map F a1)) (ObIso B (Ob-map F a0) (Ob-map F a1))
      (\ q -> idtoiso q, rezk-idtoiso B (Ob-map F a0) (Ob-map F a1))).2
    (EL.compose (Id (Ob A) a0 a1) (ObIso A a0 a1) (ObIso B (Ob-map F a0) (Ob-map F a1))
      (\ u -> isoact F u) (\ p -> idtoiso p) (isoact-equiv F ff a0 a1) (rezk-idtoiso A a0 a1))) ;

------------------------------------------------------------------------
-- Remark 39

MorEnds (C : Cat) : U l = (e : Ob C * Ob C) * Hom C e.1 e.2 ;

mor-ends (C : Cat) (m : Mor C) : MorEnds C = ((dom m, cod m), (m, refl (dom {C} m), refl (cod {C} m))) ;

mor-ends-eq (C : Cat) (m : Mor C) : (a : Ob C) (p : Id (Ob C) (dom {C} m) a) (b : Ob C) (q : Id (Ob C) (cod {C} m) b) ->
 Id (MorEnds C) (mor-ends C m) ((a, b), (m, p, q)) =
 \ a p -> idJ (Ob C) (dom {C} m) (\ a1 p1 -> (b : Ob C) (q : Id (Ob C) (cod {C} m) b) -> Id (MorEnds C) (mor-ends C m) ((a1, b), (m, p1, q)))
  (\ b q -> idJ (Ob C) (cod {C} m) (\ b1 q1 -> Id (MorEnds C) (mor-ends C m) ((dom m, b1), (m, refl (dom {C} m), q1)))
    (refl (mor-ends C m)) b q)
  a p ;

mor-ends-equiv (C : Cat) : Pl.isEquiv (Mor C) (MorEnds C) (mor-ends C) =
 Pl.qinv (Mor C) (MorEnds C) (mor-ends C) (\ w -> w.2.1)
  (\ w -> mor-ends-eq C w.2.1 w.1.1 w.2.2.1 w.1.2 w.2.2.2) (\ m -> refl m) ;

ends-map {A B : Cat} (F : Map A B) (w : MorEnds A) : MorEnds B =
 ((Ob-map F w.1.1, Ob-map F w.1.2), Hom-map F w.1.1 w.1.2 w.2) ;

ends-map-equiv {A B : Cat} (F : Map A B) (ff : is-ff F) (eF : Pl.isEquiv (Ob A) (Ob B) (Ob-map F)) :
 Pl.isEquiv (MorEnds A) (MorEnds B) (ends-map F) =
 EL.compose (MorEnds A) ((e : Ob A * Ob A) * Hom B (Ob-map F e.1) (Ob-map F e.2)) (MorEnds B)
  (Sigma-change-of-base (Ob A * Ob A) (Ob B * Ob B) (\ e -> Hom B e.1 e.2)
    (\ e -> (Ob-map F e.1, Ob-map F e.2), prod-equiv (Ob A) (Ob A) (Ob B) (Ob B) (Ob-map F) (Ob-map F) eF eF)).1
  (Sigma-fiberwise-equiv (Ob A * Ob A) (\ e -> Hom A e.1 e.2) (\ e -> Hom B (Ob-map F e.1) (Ob-map F e.2))
    (\ e -> (Hom-map F e.1 e.2, ff e.1 e.2))).1
  (Sigma-change-of-base (Ob A * Ob A) (Ob B * Ob B) (\ e -> Hom B e.1 e.2)
    (\ e -> (Ob-map F e.1, Ob-map F e.2), prod-equiv (Ob A) (Ob A) (Ob B) (Ob B) (Ob-map F) (Ob-map F) eF eF)).2
  (Sigma-fiberwise-equiv (Ob A * Ob A) (\ e -> Hom A e.1 e.2) (\ e -> Hom B (Ob-map F e.1) (Ob-map F e.2))
    (\ e -> (Hom-map F e.1 e.2, ff e.1 e.2))).2 ;

-- through mor-ends, postcomposition with F is ends-map F (by definition)
post-comp-ends {A B : Cat} (F : Map A B) (m : Mor A) :
 Id (Mor B) (post-comp F I m) (ends-map F (mor-ends A m)).2.1 = refl (post-comp F I m) ;

ff-surj-iso {A B : Cat} (F : Map A B) (ff : is-ff F) (surj : is-surjective (Ob-map F)) : isIso F =
 I-detects-equiv F
  (EL.compose (Mor A) (MorEnds B) (Mor B) (\ w -> w.2.1) (\ m -> ends-map F (mor-ends A m))
    (EL.inverse (Mor B) (MorEnds B) (mor-ends B, mor-ends-equiv B)).2
    (EL.compose (Mor A) (MorEnds A) (MorEnds B) (ends-map F) (mor-ends A)
      (ends-map-equiv F ff (embedding-surjective-equiv (Ob A) (Ob B) (Ob-map F) (ff-emb F ff) surj))
      (mor-ends-equiv A))) ;

-- the converse: an isomorphism is fully faithful and an equivalence on
-- objects (hence surjective).  Ob-map F is postcomposition at One.
-- ends-map F agrees with mor-ends o (post-comp F I) o mor-ends^-1, so it is
-- an equivalence; it is the fibrewise Hom-map F followed by a base change
-- along an equivalence, so the fibrewise map is an equivalence on totals
-- (cancel-equiv), hence on each fibre (fibrewise-from-total).
ends-map-mor {A B : Cat} (F : Map A B) (m : Mor A) :
 Id (MorEnds B) (mor-ends B (post-comp F I m)) (ends-map F (mor-ends A m)) =
 mor-ends-eq B (comp F m) (Ob-map F (dom {A} m)) (dom-nat F m) (Ob-map F (cod {A} m)) (cod-nat F m) ;

iso-ob-equiv {A B : Cat} (F : Map A B) (iso : isIso F) : Pl.isEquiv (Ob A) (Ob B) (Ob-map F) = iso One ;

iso-surj {A B : Cat} (F : Map A B) (iso : isIso F) : is-surjective (Ob-map F) = \ b ->
 Truncation[l].Trunc[fib (Ob-map F) b].inc (equiv-fibre-contr (Ob A) (Ob B) (Ob-map F) (iso-ob-equiv F iso) b).1 ;

iso-ff {A B : Cat} (F : Map A B) (iso : isIso F) : is-ff F = \ a0 a1 ->
 fibrewise-from-total (Ob A * Ob A) (\ e -> Hom A e.1 e.2) (\ e -> Hom B (Ob-map F e.1) (Ob-map F e.2))
  (\ e -> Hom-map F e.1 e.2)
  (cancel-equiv (MorEnds A) ((e : Ob A * Ob A) * Hom B (Ob-map F e.1) (Ob-map F e.2)) (MorEnds B)
    (\ w -> (w.1, Hom-map F w.1.1 w.1.2 w.2))
    (Sigma-change-of-base (Ob A * Ob A) (Ob B * Ob B) (\ e -> Hom B e.1 e.2) (on-ob, on-ob-equiv)).1
    (Sigma-change-of-base (Ob A * Ob A) (Ob B * Ob B) (\ e -> Hom B e.1 e.2) (on-ob, on-ob-equiv)).2
    (EL.homotopy (MorEnds A) (MorEnds B) (\ w -> mor-ends B (post-comp F I w.2.1)) (ends-map F)
      (\ w -> H.transH (ends-map-mor F w.2.1) (H.apH (ends-map F) ((mor-ends-equiv A).sec-eq w)))
      (EL.compose (MorEnds A) (Mor B) (MorEnds B) (mor-ends B) (\ w -> post-comp F I w.2.1) (mor-ends-equiv B)
        (EL.compose (MorEnds A) (Mor A) (Mor B) (post-comp F I) (\ w -> w.2.1) (iso I)
          (EL.inverse (Mor A) (MorEnds A) (mor-ends A, mor-ends-equiv A)).2))))
  (a0, a1)
 where {
  on-ob (e : Ob A * Ob A) : Ob B * Ob B = (Ob-map F e.1, Ob-map F e.2) ;
  on-ob-equiv : Pl.isEquiv (Ob A * Ob A) (Ob B * Ob B) on-ob =
   prod-equiv (Ob A) (Ob A) (Ob B) (Ob B) (Ob-map F) (Ob-map F) (iso-ob-equiv F iso) (iso-ob-equiv F iso) ;
 } ;
