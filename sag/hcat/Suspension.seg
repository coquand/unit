-- Reduced homology and the suspension isomorphism (H5).
--   Red S X A = fib (c |-> c t!) 0 on Hom (S, X (x) A), t! = tmap (X -> 1):
--   the maps into X (x) A whose composite with X (x) A -> 1 (x) A is
--   identified with 0 (in a stable D, Hom (S, fibre of t!)).
--   reduced n X A = Pi0 (Red (Sph n) X A).
-- Theorem (susp-red).  Let SX be a suspension of X: a pushout of types
-- 1 <- X -> 1 with points N, S and paths mer x : N = S.  Then
--   Red (Sigma S) SX A ~ Red S X A,  so  reduced (n+1) SX A ~ reduced n X A.
-- Proof.  Write A1 = 1 (x) A, P = SX (x) A, tN, tS : A1 -> P the maps of
-- N and S, r : P -> A1 the map of SX -> 1, s = (- tS), rr = (- r) on
-- Hom (S, -), F = fib rr 0 = Red S SX A with point zF = (0, zero-post r).
-- (a) Red S X A ~ Omega (F, zF).  Excision makes the square of copowers
-- (X (x) A -> A1 twice, tN, tS) a pushout, stability a pullback:
-- Hom (S, X (x) A) ~ Cone S = (a, b : S -> A1) * (a tN = b tS), and t!
-- is the first leg.  So Red S X A is the fibre of the first projection
-- over 0, i.e. (b : S -> A1) * (0 tN = b tS) (fib-pr1), i.e. fib s (0 tS)
-- (reverse, then move along 0 tN = 0 = 0 tS).  Since tS r = t (1 -> 1)
-- = id (tmap-comp, tmap-htpy, tmap-id), rr o s ~ id, and RetractFib
-- gives fib s (s 0) ~ Omega (fib rr (rr (s 0)), (s 0, refl)); moving the
-- base along pi = rr (zero-post tS) . zero-post r and the point along
-- zero-post tS (rho) gives Omega (F, zF).
-- (b) Red (Sigma S) SX A ~ Omega (F, zF).  Change the base along the loop
-- equivalence L P : Hom (Sigma S, P) ~ Omega (Hom (S, P), 0); on fibres,
-- g r = 0 iff L (g r) = L 0, i.e. conj (zero-post r) (L g r) = refl
-- (L-nat, L-zero).  So Red (Sigma S) SX A is the fibre over refl of
-- l |-> conj (zero-post r) (l r), which is Omega (F, zF) (OmegaFib).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ;
open HigherCat ; open Constructions ; open Composition ; open CompLaws ; open Associativity ;
open TensorMap ; open FibreLemmas ; open SigmaEquiv ; open FibreAlg ; open Conj[l] ;
open Zero ; open Cone ; open Loops ; open Pi0[l] ;

Red (S : Ob D) (X : U k) (A : Ob D) : U l =
 fib {Hom D S (tensor X A)} {Hom D S (tensor Top A)} (\ c -> hcomp {D} c (tmap A {X} {Top} (\ x -> tt))) (zmap S (tensor Top A)) ;

reduced (n : Nat) (X : U k) (A : Ob D) : U l = pi0 (Red (HGroups.Sph n) X A) ;

top-eta : (x : Top) -> Id Top tt x = split { tt -> refl tt } ;

-- SX with N, S and mer is a suspension of X: a pushout of 1 <- X -> 1
is-suspension (X SX : U k) (nN sS : SX) (mer : (x : X) -> Id SX nN sS) : U l+ =
 TypePushout.TSquare[Top, X, Top, SX, \ x -> tt, \ x -> tt, \ y -> nN, \ y -> sS, mer].is-pushout ;

module SuspOf (X SX : U k) (nN sS : SX) (mer : (x : X) -> Id SX nN sS)
 (po : is-suspension X SX nN sS mer) (A : Ob D) (S : Ob D) {
 module Ex = Excision.ExcisionOf[Top, X, Top, SX, \ x -> tt, \ x -> tt, \ y -> nN, \ y -> sS, mer, A] ;
 module C = DCone[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell] ;
 pull : Pl.isEquiv (Hom D S Ex.CA) (C.Cone S) (C.cone-map S) =
  stable Ex.CA Ex.BA Ex.EA Ex.XA Ex.ti Ex.tj Ex.tu Ex.tv Ex.cell (Ex.excision po) S ;
 tr : Hom D Ex.XA Ex.BA = tmap A {SX} {Top} (\ y -> tt) ;
 s (b : Hom D S Ex.BA) : Hom D S Ex.XA = hcomp {D} b Ex.tv ;
 rr (p : Hom D S Ex.XA) : Hom D S Ex.BA = hcomp {D} p tr ;

 tv-tr : Id (Hom D Ex.BA Ex.BA) (hcomp {D} Ex.tv tr) (id-hom Ex.BA) =
  H.transH (H.symH (tmap-comp A {Top} {SX} {Top} (\ y -> sS) (\ y -> tt)))
   (H.transH (tmap-htpy A {Top} {Top} (\ y -> tt) (\ y -> y) top-eta) (tmap-id A Top)) ;
 hret (b : Hom D S Ex.BA) : Id (Hom D S Ex.BA) (rr (s b)) b =
  H.transH (hcomp-assoc D (S, Ex.BA, Ex.XA, Ex.BA, b, Ex.tv, tr)) (H.transH (H.apH (\ w -> hcomp {D} b w) tv-tr) (hcomp-unit-r b)) ;

 module R = RetractFib[Hom D S Ex.BA, Hom D S Ex.XA, s, rr, hret, zmap S Ex.BA] ;
 F : U l = fib rr (zmap S Ex.BA) ;
 zF : F = (zmap S Ex.XA, zero-post S tr) ;

 -- (a) Red S X A ~ Omega (F, zF)
 e1 : Pl.Equiv (Red S X A) ((w : C.Cone S) * Id (Hom D S Ex.BA) w.1 (zmap S Ex.BA)) =
  Sigma-change-of-base (Hom D S Ex.CA) (C.Cone S) (\ w -> Id (Hom D S Ex.BA) w.1 (zmap S Ex.BA)) (C.cone-map S, pull) ;
 e2 : Pl.Equiv ((w : C.Cone S) * Id (Hom D S Ex.BA) w.1 (zmap S Ex.BA))
  ((b : Hom D S Ex.BA) * Id (Hom D S Ex.XA) (hcomp {D} (zmap S Ex.BA) Ex.tu) (hcomp {D} b Ex.tv)) =
  fib-pr1 (Hom D S Ex.BA) (\ a -> (b : Hom D S Ex.BA) * Id (Hom D S Ex.XA) (hcomp {D} a Ex.tu) (hcomp {D} b Ex.tv)) (zmap S Ex.BA) ;
 e3 : Pl.Equiv ((b : Hom D S Ex.BA) * Id (Hom D S Ex.XA) (hcomp {D} (zmap S Ex.BA) Ex.tu) (hcomp {D} b Ex.tv)) (fib s (s (zmap S Ex.BA))) =
  Sigma-fiberwise-equiv (Hom D S Ex.BA) (\ b -> Id (Hom D S Ex.XA) (hcomp {D} (zmap S Ex.BA) Ex.tu) (hcomp {D} b Ex.tv))
   (\ b -> Id (Hom D S Ex.XA) (s b) (s (zmap S Ex.BA)))
   (\ b -> EL.then (Id (Hom D S Ex.XA) (hcomp {D} (zmap S Ex.BA) Ex.tu) (hcomp {D} b Ex.tv))
     (Id (Hom D S Ex.XA) (hcomp {D} b Ex.tv) (hcomp {D} (zmap S Ex.BA) Ex.tu)) (Id (Hom D S Ex.XA) (s b) (s (zmap S Ex.BA)))
     path-sym-equiv (post-comp-path-equiv (H.transH (zero-post S Ex.tu) (H.symH (zero-post S Ex.tv))))) ;

 pi-path : Id (Hom D S Ex.BA) (rr (s (zmap S Ex.BA))) (zmap S Ex.BA) = H.transH (H.apH rr (zero-post S Ex.tv)) (zero-post S tr) ;
 Tpi : Pl.Equiv (fib rr (rr (s (zmap S Ex.BA)))) F =
  Sigma-fiberwise-equiv (Hom D S Ex.XA) (\ p -> Id (Hom D S Ex.BA) (rr p) (rr (s (zmap S Ex.BA)))) (\ p -> Id (Hom D S Ex.BA) (rr p) (zmap S Ex.BA))
   (\ p -> post-comp-path-equiv pi-path) ;
 rho : Id F (Tpi.1 R.w0) zF =
  Pl.Sigma-path (Hom D S Ex.XA) (\ p -> Id (Hom D S Ex.BA) (rr p) (zmap S Ex.BA)) (s (zmap S Ex.BA)) (zmap S Ex.XA)
   (H.transH (refl (rr (s (zmap S Ex.BA)))) pi-path) (zero-post S tr) (zero-post S Ex.tv)
   (H.transH (subst-fib rr (zmap S Ex.BA) (zero-post S Ex.tv) (H.transH (refl (rr (s (zmap S Ex.BA)))) pi-path))
    (H.transH (H.apH (\ t -> H.transH (H.symH (H.apH rr (zero-post S Ex.tv))) t) (PA.unit-l pi-path))
     (PA.canc-l (H.apH rr (zero-post S Ex.tv)) (zero-post S tr)))) ;
 e5 : Pl.Equiv (Id (fib rr (rr (s (zmap S Ex.BA)))) R.w0 R.w0) (Id F zF zF) =
  EL.then (Id (fib rr (rr (s (zmap S Ex.BA)))) R.w0 R.w0) (Id F (Tpi.1 R.w0) (Tpi.1 R.w0)) (Id F zF zF)
   (ap-Equiv Tpi R.w0 R.w0) (EL.conjugate F (Tpi.1 R.w0) zF (Tpi.1 R.w0) zF rho rho) ;

 red-loop : Pl.Equiv (Red S X A) (Id F zF zF) =
  EL.then (Red S X A) (fib s (s (zmap S Ex.BA))) (Id F zF zF)
   (EL.then (Red S X A) ((w : C.Cone S) * Id (Hom D S Ex.BA) w.1 (zmap S Ex.BA)) (fib s (s (zmap S Ex.BA))) e1
    (EL.then ((w : C.Cone S) * Id (Hom D S Ex.BA) w.1 (zmap S Ex.BA))
      ((b : Hom D S Ex.BA) * Id (Hom D S Ex.XA) (hcomp {D} (zmap S Ex.BA) Ex.tu) (hcomp {D} b Ex.tv)) (fib s (s (zmap S Ex.BA))) e2 e3))
   (EL.then (fib s (s (zmap S Ex.BA))) (Id (fib rr (rr (s (zmap S Ex.BA)))) R.w0 R.w0) (Id F zF zF) R.retract-fib e5) ;

 -- (b) Red (Sigma S) SX A ~ Omega (F, zF)
 module OF = OmegaFib[Hom D S Ex.XA, Hom D S Ex.BA, rr, zmap S Ex.XA] ;
 OmP : U l = Id (Hom D S Ex.XA) (zmap S Ex.XA) (zmap S Ex.XA) ;
 fibre-L (g : Hom D (susp S) Ex.XA) :
  Pl.Equiv (Id (Hom D (susp S) Ex.BA) (hcomp {D} g tr) (zmap (susp S) Ex.BA))
   (Id (Id (Hom D S Ex.BA) (zmap S Ex.BA) (zmap S Ex.BA)) (OF.loopF (zmap S Ex.BA) (zero-post S tr) (LoopOf[S].L Ex.XA g)) (refl (zmap S Ex.BA))) =
  EL.then (Id (Hom D (susp S) Ex.BA) (hcomp {D} g tr) (zmap (susp S) Ex.BA))
   (Id (Id (Hom D S Ex.BA) (zmap S Ex.BA) (zmap S Ex.BA)) (LoopOf[S].L Ex.BA (hcomp {D} g tr)) (LoopOf[S].L Ex.BA (zmap (susp S) Ex.BA)))
   (Id (Id (Hom D S Ex.BA) (zmap S Ex.BA) (zmap S Ex.BA)) (OF.loopF (zmap S Ex.BA) (zero-post S tr) (LoopOf[S].L Ex.XA g)) (refl (zmap S Ex.BA)))
   (ap-Equiv (LoopOf[S].L Ex.BA, LoopOf[S].L-equiv Ex.BA) (hcomp {D} g tr) (zmap (susp S) Ex.BA))
   (EL.conjugate (Id (Hom D S Ex.BA) (zmap S Ex.BA) (zmap S Ex.BA))
     (LoopOf[S].L Ex.BA (hcomp {D} g tr)) (OF.loopF (zmap S Ex.BA) (zero-post S tr) (LoopOf[S].L Ex.XA g))
     (LoopOf[S].L Ex.BA (zmap (susp S) Ex.BA)) (refl (zmap S Ex.BA))
     (LoopOf[S].L-nat Ex.XA Ex.BA g tr) (LoopOf[S].L-zero Ex.BA)) ;
 susp-loop : Pl.Equiv (Red (susp S) SX A) (fib (OF.loopF (zmap S Ex.BA) (zero-post S tr)) (refl (zmap S Ex.BA))) =
  EL.then (Red (susp S) SX A)
   ((g : Hom D (susp S) Ex.XA) * Id (Id (Hom D S Ex.BA) (zmap S Ex.BA) (zmap S Ex.BA)) (OF.loopF (zmap S Ex.BA) (zero-post S tr) (LoopOf[S].L Ex.XA g)) (refl (zmap S Ex.BA)))
   (fib (OF.loopF (zmap S Ex.BA) (zero-post S tr)) (refl (zmap S Ex.BA)))
   (Sigma-fiberwise-equiv (Hom D (susp S) Ex.XA) (\ g -> Id (Hom D (susp S) Ex.BA) (hcomp {D} g tr) (zmap (susp S) Ex.BA))
     (\ g -> Id (Id (Hom D S Ex.BA) (zmap S Ex.BA) (zmap S Ex.BA)) (OF.loopF (zmap S Ex.BA) (zero-post S tr) (LoopOf[S].L Ex.XA g)) (refl (zmap S Ex.BA)))
     fibre-L)
   (Sigma-change-of-base (Hom D (susp S) Ex.XA) OmP
     (\ q -> Id (Id (Hom D S Ex.BA) (zmap S Ex.BA) (zmap S Ex.BA)) (OF.loopF (zmap S Ex.BA) (zero-post S tr) q) (refl (zmap S Ex.BA)))
     (LoopOf[S].L Ex.XA, LoopOf[S].L-equiv Ex.XA)) ;

 susp-red : Pl.Equiv (Red (susp S) SX A) (Red S X A) =
  EL.then (Red (susp S) SX A) (Id F zF zF) (Red S X A)
   (EL.then (Red (susp S) SX A) (fib (OF.loopF (zmap S Ex.BA) (zero-post S tr)) (refl (zmap S Ex.BA))) (Id F zF zF)
     susp-loop (EL.inverse (Id F zF zF) (fib (OF.loopF (zmap S Ex.BA) (zero-post S tr)) (refl (zmap S Ex.BA))) (OF.omega-fib (zmap S Ex.BA) (zero-post S tr))))
   (EL.inverse (Red S X A) (Id F zF zF) red-loop) ;
} ;

-- the suspension isomorphism on reduced homology
susp-iso (X SX : U k) (nN sS : SX) (mer : (x : X) -> Id SX nN sS)
 (po : is-suspension X SX nN sS mer) (A : Ob D) (n : Nat) :
 Pl.Equiv (reduced (suc n) SX A) (reduced n X A) =
 pi0-equiv (Red (HGroups.Sph (suc n)) SX A) (Red (HGroups.Sph n) X A) SuspOf[X, SX, nN, sS, mer, po, A, HGroups.Sph n].susp-red ;
