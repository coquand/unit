-- Keep a map out of a copower together with its specified restriction.
-- The universal property makes the type of these witnesses contractible,
-- also for a family of restrictions. The existing lift is such a witness
-- by funext and lift-beta; no definition of lift is unfolded.
-- For f : X -> Y, the chosen tmap with its beta law is a witness.
-- For composable f,g, both tmap(gf) and tmap(f)tmap(g), with their beta
-- laws, belong to the SAME contractible fibre. This gives a comparison
-- retaining the beta compatibility, and unique higher comparisons by
-- UniversalWitness.paths. It is stronger than an equality of bare maps.
open Base ;
module H = Paths[l] ; module CU = FunExtUA[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
open HigherCat ; open Constructions ; open Composition ; open CopowerRestrict ; open Copower ; open TensorMap ;
open CompLaws ;

module Maps (X : U k) (A T : Ob D) {
 module W (h : X -> Hom D A T) {
  module UW = UniversalWitness.Witness[Hom D (tensor X A) T, X -> Hom D A T, (restrict X A T, tensor-up X A T), h] ;
 } ;

 chosen (h : X -> Hom D A T) : FibreLemmas.fib (restrict X A T) h =
  (lift X A T h, FE.funext X (\ x -> Hom D A T) (restrict X A T (lift X A T h)) h (lift-beta X A T h)) ;

 choices : CU.isContr ((h : X -> Hom D A T) -> FibreLemmas.fib (restrict X A T) h) =
  UniversalWitness.sections (X -> Hom D A T) (FibreLemmas.fib (restrict X A T)) (\ h -> W[h].UW.contractible) ;
} ;

module TensorMaps (A : Ob D) (X Y : U k) {
 witness (f : X -> Y) : FibreLemmas.fib (restrict X A (tensor Y A)) (\ x -> eta Y A (f x)) =
  Maps[X, A, tensor Y A].chosen (\ x -> eta Y A (f x)) ;

 choices : CU.isContr ((f : X -> Y) -> FibreLemmas.fib (restrict X A (tensor Y A)) (\ x -> eta Y A (f x))) =
  UniversalWitness.sections (X -> Y) (\ f -> FibreLemmas.fib (restrict X A (tensor Y A)) (\ x -> eta Y A (f x)))
   (\ f -> Maps[X, A, tensor Y A].W[\ x -> eta Y A (f x)].UW.contractible) ;
} ;

module Identity (A : Ob D) (X : U k) {
 module W = Maps[X, A, tensor X A].W[eta X A] ;

 identity : FibreLemmas.fib (restrict X A (tensor X A)) (eta X A) =
  (id-hom (tensor X A), FE.funext X (\ x -> Hom D A (tensor X A))
   (restrict X A (tensor X A) (id-hom (tensor X A))) (eta X A)
   (\ x -> hcomp-unit-r (eta X A x))) ;

 comparison : Id (FibreLemmas.fib (restrict X A (tensor X A)) (eta X A))
  (TensorMaps[A, X, X].witness (\ x -> x)) identity =
  W.UW.compare (TensorMaps[A, X, X].witness (\ x -> x)) identity ;
} ;

module Composite (A : Ob D) (X Y Z : U k) (f : X -> Y) (g : Y -> Z) {
 module W = Maps[X, A, tensor Z A].W[\ x -> eta Z A (g (f x))] ;

 composed : FibreLemmas.fib (restrict X A (tensor Z A)) (\ x -> eta Z A (g (f x))) =
  (hcomp {D} (tmap A f) (tmap A g),
   FE.funext X (\ x -> Hom D A (tensor Z A)) (restrict X A (tensor Z A) (hcomp {D} (tmap A f) (tmap A g)))
    (\ x -> eta Z A (g (f x)))
    (\ x -> H.transH (restrict-tmap A (tensor Z A) f (tmap A g) x) (tmap-beta A g (f x)))) ;

 comparison : Id (FibreLemmas.fib (restrict X A (tensor Z A)) (\ x -> eta Z A (g (f x))))
  (TensorMaps[A, X, Z].witness (\ x -> g (f x))) composed =
  W.UW.compare (TensorMaps[A, X, Z].witness (\ x -> g (f x))) composed ;
} ;
