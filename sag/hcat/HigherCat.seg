-- Objects and the terminal category (Wärn Axiom 4, Definitions 6-7;
-- Agda Category/HigherCat, first part).  Parameters of Structure used
-- here: cat-univalence, One, terminal.
--   Ob C = Map One C; a functor acts on objects by composition.
--   A map between contractible types is an equivalence: its inverse is
--   the constant map at the centre, and both round trips are paths in a
--   contractible type.
--   is-terminal T: every Map C T is contractible; a proposition.
--   Remark 5: the terminal category is unique.  For terminal T1, T2 the
--   centre f : Map T1 T2 is an isomorphism (postcomposition is a map
--   between contractible types), so (T1, 1) and (T2, f) are points of the
--   contractible Equiv-from T1; their first components give T1 = T2, and
--   being terminal is a proposition.
--   isIso-inverse: an isomorphism f : C -> D has a two-sided inverse.  The
--   section of postcomposition at 1_D gives g with f o g = 1; then
--   f o (g o f) = (f o g) o f = f = f o 1, and postcomposition with f at C
--   is injective.
open Base ;
module H = Paths[l] ; module H1 = Paths[l+] ; module P1 = Prelude[l+] ;
module FL1 = Axioms[l+].FunExtLemmas[fe @l+] ;
module CU = FunExtUA[l] ; module CU1 = FunExtUA[l+] ;
open WildCat ;

Ob (C : Cat) : U l = Map One C ;
Ob-map {A B : Cat} (f : Map A B) (x : Ob A) : Ob B = comp f x ;

map-between-contrs-is-equiv {A B : U l} (f : A -> B) (cA : CU.isContr A) (cB : CU.isContr B) :
 Prelude[l].isEquiv A B f =
 Prelude[l].qinv A B f (\ b -> cA.1) (\ b -> CU.pathC B cB (f cA.1) b) (\ a -> CU.pathC A cA cA.1 a) ;

is-terminal (T : Cat) : U l+ = (C : Cat) -> CU.isContr (Map C T) ;

is-terminal-is-prop (T : Cat) : P1.isProp (is-terminal T) =
 FL1.isProp-Pi Cat (\ C -> CU.isContr (Map C T)) (\ C -> AffineHLevels[l].contr-prop (Map C T)) ;

terminal-map-isIso {T1 T2 : Cat} (h1 : is-terminal T1) (h2 : is-terminal T2) (f : Map T1 T2) : isIso f =
 \ X -> map-between-contrs-is-equiv (post-comp f X) (h1 X) (h2 X) ;

terminal-is-prop : P1.isProp ((T : Cat) * is-terminal T) = \ u v ->
 P1.Sigma-eq Cat is-terminal u.1 v.1 u.2 v.2
  (H1.apH (\ e -> e.1) (CU1.pathC (Equiv-from u.1) (cat-univalence u.1)
    (u.1, (u.2 u.1).1, terminal-map-isIso u.2 u.2 (u.2 u.1).1)
    (v.1, (v.2 u.1).1, terminal-map-isIso u.2 v.2 (v.2 u.1).1)))
  (is-terminal-is-prop v.1) ;

isIso-inverse {C D : Cat} (f : Map C D) (iso : isIso f) :
 (g : Map D C) * Id (Map D D) (comp f g) (idMap D) * Id (Map C C) (comp g f) (idMap C) =
 ((iso D).sec (idMap D), (iso D).sec-eq (idMap D),
  Equivalences[l].injective (Map C C) (Map C D) (post-comp f C) (iso C) (comp ((iso D).sec (idMap D)) f) (idMap C)
   (H.transH (comp-assoc f ((iso D).sec (idMap D)) f)
    (H.transH (ccl f ((iso D).sec-eq (idMap D)))
     (H.transH (comp-id-l f) (H.symH (comp-id-r f)))))) ;
