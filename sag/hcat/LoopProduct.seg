-- Loops preserve products, with their actual projection maps.
-- Pair paths give the pointed inverse to the projection equivalence.
-- On fundamental groups, Pi1Product supplies a merely chosen class
-- with any prescribed pair of projections; transporting it here gives
-- the corresponding assertion for double loops of the original product.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PM = Pi0Maps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open Pi0[l] ;

module Product (B E : U l) (b : B) (e : E) {
 O : U l = Id (B * E) (b, e) (b, e) ;
 OB : U l = Id B b b ; OE : U l = Id E e e ;
 module Left = PM.Pointed[O, OB, refl (b, e), refl b, \ r -> H.apH (\ t -> t.1) r, refl (refl b)] ;
 module Right = PM.Pointed[O, OE, refl (b, e), refl e, \ r -> H.apH (\ t -> t.2) r, refl (refl e)] ;
 module Pair = PM.Pointed[OB * OE, O, (refl b, refl e), refl (b, e), \ t -> EquivAp[l].pair-path t.1 t.2, refl (refl (b, e))] ;
 module P = Pi1Product[l].Product[OB, OE, refl b, refl e] ;
 module LC = CommutingLoops.Target[OB, refl b, \ a c -> EckmannHilton.eckmann-hilton a c] ;
 module RC = CommutingLoops.Target[OE, refl e, \ a c -> EckmannHilton.eckmann-hilton a c] ;
 module LF = LC.Factor[OB * OE, O, (refl b, refl e), refl (b, e),
  \ t -> EquivAp[l].pair-path t.1 t.2, \ r -> H.apH (\ t -> t.1) r, \ t -> t.1,
  refl (refl (b, e)), refl (refl b), refl (refl b), \ t -> EquivAp[l].pair-path-fst t.1 t.2] ;
 module RF = RC.Factor[OB * OE, O, (refl b, refl e), refl (b, e),
  \ t -> EquivAp[l].pair-path t.1 t.2, \ r -> H.apH (\ t -> t.2) r, \ t -> t.2,
  refl (refl (b, e)), refl (refl e), refl (refl e), \ t -> EquivAp[l].pair-path-snd t.1 t.2] ;
 Lift (a : LoopGrp[OB, refl b].grp.G) (c : LoopGrp[OE, refl e].grp.G) : U l =
  Tr.Trunc[(r : LoopGrp[O, refl (b, e)].grp.G) * Id LoopGrp[OB, refl b].grp.G (Left.M.map r) a * Id LoopGrp[OE, refl e].grp.G (Right.M.map r) c].carrier ;
 lift-prop (a : LoopGrp[OB, refl b].grp.G) (c : LoopGrp[OE, refl e].grp.G) : Pl.isProp (Lift a c) =
  Tr.Trunc[(r : LoopGrp[O, refl (b, e)].grp.G) * Id LoopGrp[OB, refl b].grp.G (Left.M.map r) a * Id LoopGrp[OE, refl e].grp.G (Right.M.map r) c].proposition ;
 lift (a : LoopGrp[OB, refl b].grp.G) (c : LoopGrp[OE, refl e].grp.G) : Lift a c =
  TC.rec ((r : P.G.grp.G) * Id LoopGrp[OB, refl b].grp.G (P.Fst.M.map r) a * Id LoopGrp[OE, refl e].grp.G (P.Snd.M.map r) c)
   @l (Lift a c) (lift-prop a c)
   (\ t -> Tr.Trunc[(r : LoopGrp[O, refl (b, e)].grp.G) * Id LoopGrp[OB, refl b].grp.G (Left.M.map r) a * Id LoopGrp[OE, refl e].grp.G (Right.M.map r) c].inc
    (Pair.M.map t.1, H.transH (LF.groups t.1) t.2.1, H.transH (RF.groups t.1) t.2.2)) (P.lift a c) ;
} ;
