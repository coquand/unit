-- A map of pointed arrows retains the square AND its basepoint square.
-- Taking fibres sends it to another such map. The only compatibility
-- needed for the next step is the first-projection beta of Sigma-path.
-- Hence maps of the entire fibre towers are obtained by recursion, with
-- no separately supplied higher cells. This is ordinary type theory.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ;
open FibreLemmas ; open FibreTower ;

record ArrowMap (s t : Arrow) {
 dom : s.dom -> t.dom ;
 dompt : Id t.dom (dom s.dompt) t.dompt ;
 cod : s.cod -> t.cod ;
 codpt : Id t.cod (cod s.codpt) t.codpt ;
 square (x : s.dom) : Id t.cod (t.map (dom x)) (cod (s.map x)) ;
 point-square : Id (Id t.cod (t.map (dom s.dompt)) t.codpt)
  (H.transH (square s.dompt) (H.transH (H.apH cod s.pointing) codpt))
  (H.transH (H.apH t.map dompt) t.pointing) ;
} ;

module Lift (s t : Arrow) (m : ArrowMap[s, t]) {
 map (w : (fibre s).dom) : (fibre t).dom =
  (m.dom w.1, H.transH (m.square w.1) (H.transH (H.apH m.cod w.2) m.codpt)) ;
 beta : Id t.cod (t.map (m.dom s.dompt)) t.codpt =
  H.transH (m.square s.dompt) (H.transH (H.apH m.cod s.pointing) m.codpt) ;
 point-cell : Id (Id t.cod (t.map t.dompt) t.codpt)
  (Pl.subst t.dom (\ x -> Id t.cod (t.map x) t.codpt) (m.dom s.dompt) t.dompt m.dompt beta) t.pointing =
  H.transH (subst-fib t.map t.codpt m.dompt beta)
   (H.transH (H.apH (\ r -> H.transH (H.symH (H.apH t.map m.dompt)) r) m.point-square)
    (PA.canc-l (H.apH t.map m.dompt) t.pointing)) ;
 pointed : Id (fibre t).dom (map (fibre s).dompt) (fibre t).dompt =
  Pl.Sigma-path t.dom (\ x -> Id t.cod (t.map x) t.codpt)
   (m.dom s.dompt) t.dompt beta t.pointing m.dompt point-cell ;
 pointed-fst : Id (Id t.dom (m.dom s.dompt) t.dompt) (H.apH (\ w -> w.1) pointed) m.dompt =
  FibreAlg.sigma-path-fst t.dom (\ x -> Id t.cod (t.map x) t.codpt)
   (m.dom s.dompt) t.dompt beta t.pointing m.dompt point-cell ;
 lifted : ArrowMap[fibre s, fibre t] =
  new ArrowMap[fibre s, fibre t, map, pointed, m.dom, m.dompt, \ w -> refl (m.dom w.1),
   H.transH (H.transH (PA.unit-l (H.transH (refl (m.dom s.dompt)) m.dompt)) (PA.unit-l m.dompt))
    (H.symH pointed-fst)] ;
} ;

maps (s t : Arrow) (m : ArrowMap[s, t]) : (n : Nat) -> ArrowMap[tower s n, tower t n] = split {
 zero -> m ;
 suc n | r -> Lift[tower s n, tower t n, r].lifted } ;
