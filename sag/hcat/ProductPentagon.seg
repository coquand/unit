-- The product pentagon (Agda Category/Product §5-§7; Rocq prod_pent_C).
-- For k : C2 -> D, g : C1 -> C2, h : C0 -> C1 and the functor - x C on
-- maps (pm f = product-map f 1), the image of the reassociator,
-- pm a(k,g,h), equals the pasting prodpent-rhs-C of the comparison cells
-- pmc and the reassociator of the pm's:
--   pm((kg)h) = pm((kg)h, 1 1) = pm(kg) pm(h) = (pm k pm g) pm h
--   = pm k (pm g pm h) = pm k pm(gh) = pm(k(gh), 1 1) = pm(k(gh)).
-- By prod-path-eq it suffices to compare the two projections.
--
-- The pi1 factor.  Every map u in the chain gets a frame
-- F_u : pi1 o u = k (g (h pi1)) built from the projection laws L of pm
-- (frame, frame2, frame3); each cell x : u = v of the chain gives a square
-- (pi1 o x) . F_v = F_u (pme2-l for the cells changing the second
-- argument, leg-frame for pmc, key for the whiskered pmc, assoc-frame for
-- the reassociator, frame-whisker for the left whisker).  So the
-- projection of the pasting is a square from F7 to F0 (sq-cons).  The
-- projection of pm a(k,g,h) is  L . (a(k,g,h) o pi1) . L^-1  (pme1-l), and
-- (a(k,g,h) o pi1) . a(k, g h, pi1) . (k o a(g,h,pi1)) = a(k g, h, pi1)
-- . a(k, g, h pi1) is the pentagon at (k, g, h, pi1): a square from F7 to
-- F0 as well.  Two squares with the same frames have equal cells.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open Naturality ; open Pullbacks ; open ProductMap ; open ProductPentagonFrames ;

prodpent-rhs-C {C0 C1 C2 D C : Cat} (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) :
 Id (Map (times C0 C) (times D C)) (product-map (comp (comp k g) h) (idMap C)) (product-map (comp k (comp g h)) (idMap C)) =
 H.transH (product-map-eq2 (comp (comp k g) h) (H.symH (comp-id-l (idMap C))))
 (H.transH (pmc h (comp k g) (idMap C) (idMap C))
 (H.transH (ccl (product-map h (idMap C)) (H.transH (product-map-eq2 (comp k g) (H.symH (comp-id-l (idMap C)))) (pmc g k (idMap C) (idMap C))))
 (H.transH (composeA (product-map k (idMap C)) (product-map g (idMap C)) (product-map h (idMap C)))
 (H.transH (ccr (product-map k (idMap C)) (H.transH (H.symH (pmc h g (idMap C) (idMap C))) (product-map-eq2 (comp g h) (comp-id-l (idMap C)))))
 (H.transH (H.symH (pmc (comp g h) k (idMap C) (idMap C)))
  (H.symH (product-map-eq2 (comp k (comp g h)) (H.symH (comp-id-l (idMap C)))))))))) ;

module Cells (C0 C1 C2 D C : Cat) (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) {
 Ic : Map C C = idMap C ;
 I2 : Map C C = comp Ic Ic ;
 ul : Id (Map C C) I2 Ic = comp-id-l Ic ;
 pk : Map (times C2 C) (times D C) = product-map k Ic ;
 pg : Map (times C1 C) (times C2 C) = product-map g Ic ;
 ph : Map (times C0 C) (times C1 C) = product-map h Ic ;
 pkg : Map (times C1 C) (times D C) = product-map (comp k g) Ic ;
 pgh : Map (times C0 C) (times C2 C) = product-map (comp g h) Ic ;
 -- the seven cells and the tails of the chain
 yc : Id (Map (times C1 C) (times D C)) pkg (comp pk pg) =
  H.transH (product-map-eq2 (comp k g) (H.symH ul)) (pmc g k Ic Ic) ;
 zc : Id (Map (times C0 C) (times C2 C)) (comp pg ph) pgh =
  H.transH (H.symH (pmc h g Ic Ic)) (product-map-eq2 (comp g h) ul) ;
 cp1 : Id (Map (times C0 C) (times D C)) (product-map (comp (comp k g) h) Ic) (product-map (comp (comp k g) h) I2) =
  product-map-eq2 (comp (comp k g) h) (H.symH ul) ;
 cp2 : Id (Map (times C0 C) (times D C)) (product-map (comp (comp k g) h) I2) (comp pkg ph) = pmc h (comp k g) Ic Ic ;
 cp3 : Id (Map (times C0 C) (times D C)) (comp pkg ph) (comp (comp pk pg) ph) = ccl ph yc ;
 cp4 : Id (Map (times C0 C) (times D C)) (comp (comp pk pg) ph) (comp pk (comp pg ph)) = composeA pk pg ph ;
 cp5 : Id (Map (times C0 C) (times D C)) (comp pk (comp pg ph)) (comp pk pgh) = ccr pk zc ;
 cp6 : Id (Map (times C0 C) (times D C)) (comp pk pgh) (product-map (comp k (comp g h)) I2) = H.symH (pmc (comp g h) k Ic Ic) ;
 cp7 : Id (Map (times C0 C) (times D C)) (product-map (comp k (comp g h)) I2) (product-map (comp k (comp g h)) Ic) =
  H.symH (product-map-eq2 (comp k (comp g h)) (H.symH ul)) ;
 t6 : Id (Map (times C0 C) (times D C)) (comp pk pgh) (product-map (comp k (comp g h)) Ic) = H.transH cp6 cp7 ;
 t5 : Id (Map (times C0 C) (times D C)) (comp pk (comp pg ph)) (product-map (comp k (comp g h)) Ic) = H.transH cp5 t6 ;
 t4 : Id (Map (times C0 C) (times D C)) (comp (comp pk pg) ph) (product-map (comp k (comp g h)) Ic) = H.transH cp4 t5 ;
 t3 : Id (Map (times C0 C) (times D C)) (comp pkg ph) (product-map (comp k (comp g h)) Ic) = H.transH cp3 t4 ;
 t2 : Id (Map (times C0 C) (times D C)) (product-map (comp (comp k g) h) I2) (product-map (comp k (comp g h)) Ic) = H.transH cp2 t3 ;
 t1 : Id (Map (times C0 C) (times D C)) (product-map (comp (comp k g) h) Ic) (product-map (comp k (comp g h)) Ic) = H.transH cp1 t2 ;
 rhs-is : Id (Id (Map (times C0 C) (times D C)) (product-map (comp (comp k g) h) Ic) (product-map (comp k (comp g h)) Ic))
  (prodpent-rhs-C k g h) t1 = refl t1 ;
} ;

module InjlFactor (C0 C1 C2 D C : Cat) (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) {
 open Cells[C0, C1, C2, D, C, k, g, h] ;
 pD : Map (times D C) D = pi1 D C ;
 p2 : Map (times C2 C) C2 = pi1 C2 C ;
 p1 : Map (times C1 C) C1 = pi1 C1 C ;
 p0 : Map (times C0 C) C0 = pi1 C0 C ;
 lk : Id (Map (times C2 C) D) (comp pD pk) (comp k p2) = injl-product-map k Ic ;
 lg : Id (Map (times C1 C) C2) (comp p2 pg) (comp g p1) = injl-product-map g Ic ;
 lh : Id (Map (times C0 C) C1) (comp p1 ph) (comp h p0) = injl-product-map h Ic ;
 lkg : Id (Map (times C1 C) D) (comp pD pkg) (comp (comp k g) p1) = injl-product-map (comp k g) Ic ;
 lgh : Id (Map (times C0 C) C2) (comp p2 pgh) (comp (comp g h) p0) = injl-product-map (comp g h) Ic ;
 lkg2 : Id (Map (times C1 C) D) (comp pD (product-map (comp k g) I2)) (comp (comp k g) p1) = injl-product-map (comp k g) I2 ;
 lgh2 : Id (Map (times C0 C) C2) (comp p2 (product-map (comp g h) I2)) (comp (comp g h) p0) = injl-product-map (comp g h) I2 ;
 la1 : Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) Ic)) (comp (comp (comp k g) h) p0) =
  injl-product-map (comp (comp k g) h) Ic ;
 la2 : Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) I2)) (comp (comp (comp k g) h) p0) =
  injl-product-map (comp (comp k g) h) I2 ;
 lb1 : Id (Map (times C0 C) D) (comp pD (product-map (comp k (comp g h)) Ic)) (comp (comp k (comp g h)) p0) =
  injl-product-map (comp k (comp g h)) Ic ;
 lb2 : Id (Map (times C0 C) D) (comp pD (product-map (comp k (comp g h)) I2)) (comp (comp k (comp g h)) p0) =
  injl-product-map (comp k (comp g h)) I2 ;
 na : Id (Map (times C0 C) D) (comp (comp (comp k g) h) p0) (comp k (comp g (comp h p0))) =
  H.transH (composeA (comp k g) h p0) (composeA k g (comp h p0)) ;
 nb : Id (Map (times C0 C) D) (comp (comp k (comp g h)) p0) (comp k (comp g (comp h p0))) =
  H.transH (composeA k (comp g h) p0) (ccr k (composeA g h p0)) ;
 -- the frames
 f0 : Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) Ic)) (comp k (comp g (comp h p0))) = H.transH la1 na ;
 f1 : Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) I2)) (comp k (comp g (comp h p0))) = H.transH la2 na ;
 f2 : Id (Map (times C0 C) D) (comp pD (comp pkg ph)) (comp k (comp g (comp h p0))) =
  H.transH (frame2 lkg lh) (composeA k g (comp h p0)) ;
 f3 : Id (Map (times C0 C) D) (comp pD (comp (comp pk pg) ph)) (comp k (comp g (comp h p0))) = frame3 lk lg lh ;
 f4 : Id (Map (times C0 C) D) (comp pD (comp pk (comp pg ph))) (comp k (comp g (comp h p0))) = frame2 lk (frame2 lg lh) ;
 f5 : Id (Map (times C0 C) D) (comp pD (comp pk pgh)) (comp k (comp g (comp h p0))) =
  H.transH (frame lk pgh) (ccr k (H.transH lgh (composeA g h p0))) ;
 f6 : Id (Map (times C0 C) D) (comp pD (product-map (comp k (comp g h)) I2)) (comp k (comp g (comp h p0))) = H.transH lb2 nb ;
 f7 : Id (Map (times C0 C) D) (comp pD (product-map (comp k (comp g h)) Ic)) (comp k (comp g (comp h p0))) = H.transH lb1 nb ;
 -- the squares
 s1 : Id (Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) Ic)) (comp k (comp g (comp h p0))))
  (H.transH (ccr pD cp1) f1) f0 =
  H.transH (H.symH (PA.tassoc (ccr pD cp1) la2 na)) (H.apH (\ z -> H.transH z na) (pme2-l (comp (comp k g) h) (H.symH ul))) ;
 s2 : Id (Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) I2)) (comp k (comp g (comp h p0))))
  (H.transH (ccr pD cp2) f2) f1 =
  H.transH (H.apH (\ z -> H.transH z f2) (pmc-injl h (comp k g) Ic Ic))
  (H.transH (H.symH (PA.tassoc (pmc-legl h (comp k g) Ic Ic) (frame2 lkg lh) (composeA k g (comp h p0))))
  (H.transH (H.apH (\ z -> H.transH z (composeA k g (comp h p0))) (leg-frame la2 lh lkg))
   (PA.tassoc la2 (composeA (comp k g) h p0) (composeA k g (comp h p0))))) ;
 sy : Id (Id (Map (times C1 C) D) (comp pD pkg) (comp k (comp g p1))) (H.transH (ccr pD yc) (frame2 lk lg))
  (H.transH lkg (composeA k g p1)) =
  sq-cons (\ m -> comp pD m) (product-map-eq2 (comp k g) (H.symH ul)) (pmc g k Ic Ic)
   (H.transH (H.apH (\ z -> H.transH z (frame2 lk lg)) (pmc-injl g k Ic Ic)) (leg-frame lkg2 lg lk))
   (H.transH (H.symH (PA.tassoc (ccr pD (product-map-eq2 (comp k g) (H.symH ul))) lkg2 (composeA k g p1)))
    (H.apH (\ z -> H.transH z (composeA k g p1)) (pme2-l (comp k g) (H.symH ul)))) ;
 s3 : Id (Id (Map (times C0 C) D) (comp pD (comp pkg ph)) (comp k (comp g (comp h p0)))) (H.transH (ccr pD cp3) f3) f2 =
  H.transH chainL (H.symH chainR)
  where {
   al : Id (Map (times C0 C) D) (comp (comp pD pkg) ph) (comp pD (comp pkg ph)) = composeA pD pkg ph ;
   be : Id (Map (times C0 C) D) (comp (comp pD (comp pk pg)) ph) (comp pD (comp (comp pk pg) ph)) = composeA pD (comp pk pg) ph ;
   al2 : Id (Map (times C0 C) D) (comp (comp (comp k g) p1) ph) (comp (comp k g) (comp p1 ph)) = composeA (comp k g) p1 ph ;
   a3 : Id (Map (times C0 C) D) (comp (comp k g) (comp h p0)) (comp k (comp g (comp h p0))) = composeA k g (comp h p0) ;
   r3 : Id (Map (times C0 C) D) (comp (comp k (comp g p1)) ph) (comp k (comp g (comp h p0))) =
    H.transH (composeA k (comp g p1) ph) (H.transH (ccr k (composeA g p1 ph)) (ccr k (ccr g lh))) ;
   w : Id (Map (times C0 C) D) (comp (comp pD pkg) ph) (comp (comp pD (comp pk pg)) ph) = ccl ph (ccr pD yc) ;
   x3 : Id (Id (Map (times C0 C) D) (comp pD (comp pkg ph)) (comp pD (comp (comp pk pg) ph)))
    (ccr pD cp3) (H.transH (H.symH al) (H.transH w be)) = solve-l al (compose-naturality2 pD ph yc) ;
   chainL : Id (Id (Map (times C0 C) D) (comp pD (comp pkg ph)) (comp k (comp g (comp h p0))))
    (H.transH (ccr pD cp3) f3) (H.transH (H.symH al) (H.transH (ccl ph lkg) (H.transH al2 (H.transH (ccr (comp k g) lh) a3)))) =
    H.transH (H.apH (\ z -> H.transH z f3) x3)
    (H.transH (PA.tassoc (H.symH al) (H.transH w be) f3)
    (H.apH (\ z -> H.transH (H.symH al) z)
     (H.transH (PA.tassoc w be f3)
     (H.transH (H.apH (\ z -> H.transH w z) (canc-r2 be (H.transH (ccl ph (frame2 lk lg)) r3)))
     (H.transH (H.symH (PA.tassoc w (ccl ph (frame2 lk lg)) r3))
     (H.transH (H.apH (\ z -> H.transH z r3) (H.symH (PA.ap-trans (\ m -> comp m ph) (ccr pD yc) (frame2 lk lg))))
     (H.transH (H.apH (\ z -> H.transH (ccl ph z) r3) sy)
     (H.transH (H.apH (\ z -> H.transH z r3) (PA.ap-trans (\ m -> comp m ph) lkg (composeA k g p1)))
     (H.transH (PA.tassoc (ccl ph lkg) (ccl ph (composeA k g p1)) r3)
      (H.apH (\ z -> H.transH (ccl ph lkg) z) (key k g lh))))))))))) ;
   chainR : Id (Id (Map (times C0 C) D) (comp pD (comp pkg ph)) (comp k (comp g (comp h p0))))
    f2 (H.transH (H.symH al) (H.transH (ccl ph lkg) (H.transH al2 (H.transH (ccr (comp k g) lh) a3)))) =
    H.transH (PA.tassoc (frame lkg ph) (ccr (comp k g) lh) a3)
    (H.transH (PA.tassoc (H.symH al) (H.transH (ccl ph lkg) al2) (H.transH (ccr (comp k g) lh) a3))
     (H.apH (\ z -> H.transH (H.symH al) z) (PA.tassoc (ccl ph lkg) al2 (H.transH (ccr (comp k g) lh) a3)))) ;
  } ;
 s4 : Id (Id (Map (times C0 C) D) (comp pD (comp (comp pk pg) ph)) (comp k (comp g (comp h p0)))) (H.transH (ccr pD cp4) f4) f3 =
  assoc-frame lk lg lh ;
 sz : Id (Id (Map (times C0 C) C2) (comp p2 (comp pg ph)) (comp g (comp h p0)))
  (H.transH (ccr p2 zc) (H.transH lgh (composeA g h p0))) (frame2 lg lh) =
  sq-cons (\ m -> comp p2 m) (H.symH (pmc h g Ic Ic)) (product-map-eq2 (comp g h) ul)
   (H.transH (H.symH (PA.tassoc (ccr p2 (product-map-eq2 (comp g h) ul)) lgh (composeA g h p0)))
    (H.apH (\ z -> H.transH z (composeA g h p0)) (pme2-l (comp g h) ul)))
   (sq-inv (\ m -> comp p2 m) (pmc h g Ic Ic)
    (H.transH (H.apH (\ z -> H.transH z (frame2 lg lh)) (pmc-injl h g Ic Ic)) (leg-frame lgh2 lh lg))) ;
 s5 : Id (Id (Map (times C0 C) D) (comp pD (comp pk (comp pg ph))) (comp k (comp g (comp h p0)))) (H.transH (ccr pD cp5) f5) f4 =
  H.transH (H.symH (PA.tassoc (ccr pD cp5) (frame lk pgh) (ccr k (H.transH lgh (composeA g h p0)))))
  (H.transH (H.apH (\ z -> H.transH z (ccr k (H.transH lgh (composeA g h p0)))) (frame-whisker lk zc))
  (H.transH (PA.tassoc (frame lk (comp pg ph)) (ccr k (ccr p2 zc)) (ccr k (H.transH lgh (composeA g h p0))))
   (H.apH (\ z -> H.transH (frame lk (comp pg ph)) z)
    (H.transH (H.symH (PA.ap-trans (\ m -> comp k m) (ccr p2 zc) (H.transH lgh (composeA g h p0))))
     (H.apH (\ z -> ccr k z) sz))))) ;
 s6 : Id (Id (Map (times C0 C) D) (comp pD (comp pk pgh)) (comp k (comp g (comp h p0)))) (H.transH (ccr pD cp6) f6) f5 =
  sq-inv (\ m -> comp pD m) (pmc (comp g h) k Ic Ic)
  (H.transH (H.apH (\ z -> H.transH z f5) (pmc-injl (comp g h) k Ic Ic))
  (H.transH (H.apH (\ z -> H.transH (pmc-legl (comp g h) k Ic Ic) (H.transH (frame lk pgh) z))
     (PA.ap-trans (\ m -> comp k m) lgh (composeA g h p0)))
  (H.transH (H.apH (\ z -> H.transH (pmc-legl (comp g h) k Ic Ic) z)
     (H.symH (PA.tassoc (frame lk pgh) (ccr k lgh) (ccr k (composeA g h p0)))))
  (H.transH (H.symH (PA.tassoc (pmc-legl (comp g h) k Ic Ic) (frame2 lk lgh) (ccr k (composeA g h p0))))
  (H.transH (H.apH (\ z -> H.transH z (ccr k (composeA g h p0))) (leg-frame lb2 lgh lk))
   (PA.tassoc lb2 (composeA k (comp g h) p0) (ccr k (composeA g h p0)))))))) ;
 s7 : Id (Id (Map (times C0 C) D) (comp pD (product-map (comp k (comp g h)) I2)) (comp k (comp g (comp h p0))))
  (H.transH (ccr pD cp7) f7) f6 =
  sq-inv (\ m -> comp pD m) (product-map-eq2 (comp k (comp g h)) (H.symH ul))
   (H.transH (H.symH (PA.tassoc (ccr pD (product-map-eq2 (comp k (comp g h)) (H.symH ul))) lb2 nb))
    (H.apH (\ z -> H.transH z nb) (pme2-l (comp k (comp g h)) (H.symH ul)))) ;
 -- the pasting, projected
 sr : Id (Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) Ic)) (comp k (comp g (comp h p0))))
  (H.transH (ccr pD t1) f7) f0 =
  sq-cons (\ m -> comp pD m) cp1 t2
   (sq-cons (\ m -> comp pD m) cp2 t3
    (sq-cons (\ m -> comp pD m) cp3 t4
     (sq-cons (\ m -> comp pD m) cp4 t5
      (sq-cons (\ m -> comp pD m) cp5 t6
       (sq-cons (\ m -> comp pD m) cp6 cp7 s7 s6) s5) s4) s3) s2) s1 ;
 -- the image of the reassociator, projected: the pentagon at (k, g, h, p0)
 sl : Id (Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) Ic)) (comp k (comp g (comp h p0))))
  (H.transH (ccr pD (product-map-eq1 Ic (composeA k g h))) f7) f0 =
  H.transH (H.symH (PA.tassoc (ccr pD (product-map-eq1 Ic (composeA k g h))) lb1 nb))
  (H.transH (H.apH (\ z -> H.transH z nb) (pme1-l Ic (composeA k g h)))
  (H.transH (PA.tassoc la1 (ccl p0 (composeA k g h)) nb)
   (H.apH (\ z -> H.transH la1 z)
    (H.transH (H.symH (PA.tassoc (ccl p0 (composeA k g h)) (composeA k (comp g h) p0) (ccr k (composeA g h p0))))
     (H.symH (pentagonator k g h p0)))))) ;
 factor : Id (Id (Map (times C0 C) D) (comp pD (product-map (comp (comp k g) h) Ic)) (comp pD (product-map (comp k (comp g h)) Ic)))
  (ccr pD (product-map-eq1 Ic (composeA k g h))) (ccr pD (prodpent-rhs-C k g h)) =
  PA.cancel-r f7 (H.transH sl (H.symH sr)) ;
} ;

