-- The product with I on cones (for Agda Squares/TimesI; restructured).
-- Level 2: prod-pent-C.
--   theta g x : (g x) x I = (g x I) o (x x I), the comparison pmc with the
--   unit 1 = 1 1 inserted (product-map-eq2).  It is natural in x
--   (theta-nat, J), and the reassociation pasting of prod-pent-C is
--   theta (k g) h . (theta k g o h x I) . a . (k x I o theta g h^-1)
--   . theta k (g h)^-1  (rhs-theta, by definition up to inverses).
--   pme-exch: product-map-eq1 at 1 and product-map-eq2 at 1 = 1 1 commute (J).
--   timesI-cone c: a cone (g, e, s) of S into Y gives the cone of S x I into
--   Y x I with legs g x I, e x I and square
--   (g x I)(l x I) = (g l) x I = (e t) x I = (e x I)(t x I)  (theta, s x I).
--   base-times: the base cone of S x I is timesI-cone of the base cone of S
--   (pme-exch moves the unit cells across s x I).
--   cone-times-post: postcomposing timesI-cone c with k x I is timesI-cone
--   of the postcomposite k c.  Legs by theta; for the squares, (k g l-cell)
--   x I is expanded by prod-pent-C (rhs-theta), s x I under k is moved by
--   theta-nat, and the inverse expansion of (k e t-cell)^-1 x I cancels
--   the remaining theta cells.
--   comparison-times: the comparison of S x I at k x I is timesI-cone of
--   the comparison of S at k.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module PM = PathMoves[l] ;
open WildCat ; open Pullbacks ; open ProductMap ; open Squares ; open SquareAlg ; open ConeAlg ;
open ProductPentagon ; open ProductPentagonR ; open ProductPentagonR2 ;

-- generic path moves used below
tail5 {A : U l} {a0 a1 a2 a3 a4 a5 : A} (x1 : Id A a0 a1) (x2 : Id A a1 a2) (x3 : Id A a2 a3)
 (x4 : Id A a3 a4) (x5 : Id A a4 a5) {w : A} (t : Id A a5 w) :
 Id (Id A a0 w) (H.transH (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 x5)))) t)
  (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 t))))) =
 idJ A a5 (\ w1 t1 -> Id (Id A a0 w1) (H.transH (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 x5)))) t1)
   (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 (H.transH x5 t1))))))
  (refl (H.transH x1 (H.transH x2 (H.transH x3 (H.transH x4 x5))))) w t ;

-- from a.b = c.d:  c^-1.(a.t) = d.(b^-1.t)
nat-swap {A : U l} {x y z w : A} {a : Id A x y} {b : Id A y z} {c : Id A x w} {d : Id A w z}
 (h : Id (Id A x z) (H.transH a b) (H.transH c d)) {v : A} (t : Id A y v) :
 Id (Id A w v) (H.transH (H.symH c) (H.transH a t)) (H.transH d (H.transH (H.symH b) t)) =
 H.transH (H.apH (\ q -> H.transH (H.symH c) (H.transH a q)) (PM.ins b t))
  (H.transH (H.apH (\ q -> H.transH (H.symH c) q) (PM.move2 h (H.transH (H.symH b) t)))
   (PA.canc-l c (H.transH d (H.transH (H.symH b) t)))) ;

-- y^-1 . ((x1.(c2.(c3.(c4.y^-1))))^-1 . x1) = c4^-1.(c3^-1.c2^-1)
peel {A : U l} {a0 a1 a2 a3 a4 a5 : A} (x1 : Id A a0 a1) (c2 : Id A a1 a2) (c3 : Id A a2 a3) (c4 : Id A a3 a4)
 (y : Id A a5 a4) :
 Id (Id A a4 a1)
  (H.transH (H.symH y) (H.transH (H.symH (H.transH x1 (H.transH c2 (H.transH c3 (H.transH c4 (H.symH y)))))) x1))
  (H.transH (H.symH c4) (H.transH (H.symH c3) (H.symH c2))) =
 H.transH (H.apH (\ q -> H.transH (H.symH y) q)
   (H.transH (H.apH (\ q -> H.transH q x1) (PA.sym-trans x1 V))
    (H.transH (PA.tassoc (H.symH V) (H.symH x1) x1) (H.apH (\ q -> H.transH (H.symH V) q) (PA.inv-l x1)))))
 (H.transH (H.apH (\ q -> H.transH (H.symH y) q)
   (H.transH (PA.sym-trans c2 (H.transH c3 (H.transH c4 (H.symH y))))
   (H.transH (H.apH (\ q -> H.transH q (H.symH c2)) (PA.sym-trans c3 (H.transH c4 (H.symH y))))
   (H.transH (H.apH (\ q -> H.transH (H.transH q (H.symH c3)) (H.symH c2)) (PA.sym-trans c4 (H.symH y)))
   (H.transH (H.apH (\ q -> H.transH (H.transH (H.transH q (H.symH c4)) (H.symH c3)) (H.symH c2)) (PA.sym-sym y))
   (H.transH (PA.tassoc (H.transH y (H.symH c4)) (H.symH c3) (H.symH c2))
    (PA.tassoc y (H.symH c4) (H.transH (H.symH c3) (H.symH c2)))))))))
  (PA.canc-l y (H.transH (H.symH c4) (H.transH (H.symH c3) (H.symH c2)))))
 where {
  V : Id A a1 a5 = H.transH c2 (H.transH c3 (H.transH c4 (H.symH y))) ;
 } ;

theta {A B C : Cat} (g : Map B C) (x : Map A B) :
 Id (Map (times A I) (times C I)) (product-map (comp g x) (idMap I)) (comp (product-map g (idMap I)) (product-map x (idMap I))) =
 H.transH (product-map-eq2 (comp g x) (H.symH (comp-id-l (idMap I)))) (pmc x g (idMap I) (idMap I)) ;

theta-nat {A B C : Cat} (k : Map B C) {u v : Map A B} (X : Id (Map A B) u v) :
 Id (Id (Map (times A I) (times C I)) (product-map (comp k u) (idMap I)) (comp (product-map k (idMap I)) (product-map v (idMap I))))
  (H.transH (product-map-eq1 (idMap I) (ccr k X)) (theta k v))
  (H.transH (theta k u) (ccr (product-map k (idMap I)) (product-map-eq1 (idMap I) X))) =
 idJ (Map A B) u (\ v1 X1 -> Id (Id (Map (times A I) (times C I)) (product-map (comp k u) (idMap I))
     (comp (product-map k (idMap I)) (product-map v1 (idMap I))))
   (H.transH (product-map-eq1 (idMap I) (ccr k X1)) (theta k v1))
   (H.transH (theta k u) (ccr (product-map k (idMap I)) (product-map-eq1 (idMap I) X1))))
  (PA.unit-l (theta k u)) v X ;

pme-exch {A B : Cat} {u v : Map A B} (X : Id (Map A B) u v) :
 Id (Id (Map (times A I) (times B I)) (product-map u (idMap I)) (product-map v (comp (idMap I) (idMap I))))
  (H.transH (product-map-eq1 (idMap I) X) (product-map-eq2 v (H.symH (comp-id-l (idMap I)))))
  (H.transH (product-map-eq2 u (H.symH (comp-id-l (idMap I)))) (product-map-eq1 (comp (idMap I) (idMap I)) X)) =
 idJ (Map A B) u (\ v1 X1 -> Id (Id (Map (times A I) (times B I)) (product-map u (idMap I)) (product-map v1 (comp (idMap I) (idMap I))))
   (H.transH (product-map-eq1 (idMap I) X1) (product-map-eq2 v1 (H.symH (comp-id-l (idMap I)))))
   (H.transH (product-map-eq2 u (H.symH (comp-id-l (idMap I)))) (product-map-eq1 (comp (idMap I) (idMap I)) X1)))
  (PA.unit-l (product-map-eq2 u (H.symH (comp-id-l (idMap I))))) v X ;

-- the pasting of prod-pent-C through theta
rhs-theta {C0 C1 C2 D : Cat} (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) :
 Id (Id (Map (times C0 I) (times D I)) (product-map (comp (comp k g) h) (idMap I)) (product-map (comp k (comp g h)) (idMap I)))
  (prodpent-rhs-C k g h)
  (H.transH (theta (comp k g) h) (H.transH (ccl (product-map h (idMap I)) (theta k g))
   (H.transH (composeA (product-map k (idMap I)) (product-map g (idMap I)) (product-map h (idMap I)))
    (H.transH (ccr (product-map k (idMap I)) (H.symH (theta g h))) (H.symH (theta k (comp g h))))))) =
 H.transH (H.symH (PA.tassoc (product-map-eq2 (comp (comp k g) h) (H.symH (comp-id-l (idMap I)))) (pmc h (comp k g) (idMap I) (idMap I)) w))
  (H.apH (\ q -> H.transH (theta (comp k g) h) (H.transH (ccl (product-map h (idMap I)) (theta k g))
      (H.transH (composeA (product-map k (idMap I)) (product-map g (idMap I)) (product-map h (idMap I))) q)))
   (H.transH (H.apH (\ z -> H.transH (ccr (product-map k (idMap I)) z)
       (H.transH (H.symH (pmc (comp g h) k (idMap I) (idMap I))) (H.symH (product-map-eq2 (comp k (comp g h)) (H.symH (comp-id-l (idMap I)))))))
      z1)
    (H.apH (\ z -> H.transH (ccr (product-map k (idMap I)) (H.symH (theta g h))) z)
     (H.symH (PA.sym-trans (product-map-eq2 (comp k (comp g h)) (H.symH (comp-id-l (idMap I)))) (pmc (comp g h) k (idMap I) (idMap I)))))))
 where {
  w : Id (Map (times C0 I) (times D I)) (comp (product-map (comp k g) (idMap I)) (product-map h (idMap I))) (product-map (comp k (comp g h)) (idMap I)) =
   H.transH (ccl (product-map h (idMap I)) (theta k g))
   (H.transH (composeA (product-map k (idMap I)) (product-map g (idMap I)) (product-map h (idMap I)))
   (H.transH (ccr (product-map k (idMap I)) (H.transH (H.symH (pmc h g (idMap I) (idMap I))) (product-map-eq2 (comp g h) (comp-id-l (idMap I)))))
   (H.transH (H.symH (pmc (comp g h) k (idMap I) (idMap I))) (H.symH (product-map-eq2 (comp k (comp g h)) (H.symH (comp-id-l (idMap I)))))))) ;
  z1 : Id (Id (Map (times C0 I) (times C2 I)) (comp (product-map g (idMap I)) (product-map h (idMap I))) (product-map (comp g h) (idMap I)))
   (H.transH (H.symH (pmc h g (idMap I) (idMap I))) (product-map-eq2 (comp g h) (comp-id-l (idMap I)))) (H.symH (theta g h)) =
   H.symH (H.transH (PA.sym-trans (product-map-eq2 (comp g h) (H.symH (comp-id-l (idMap I)))) (pmc h g (idMap I) (idMap I)))
    (H.apH (\ z -> H.transH (H.symH (pmc h g (idMap I) (idMap I))) z)
     (H.transH (H.symH (PA.ap-sym (\ x -> product-map (comp g h) x) (H.symH (comp-id-l (idMap I)))))
      (H.apH (\ z -> product-map-eq2 (comp g h) z) (PA.sym-sym (comp-id-l (idMap I))))))) ;
 } ;

-- prod-pent-C read through theta
pent-theta {C0 C1 C2 D : Cat} (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) :
 Id (Id (Map (times C0 I) (times D I)) (product-map (comp (comp k g) h) (idMap I)) (product-map (comp k (comp g h)) (idMap I)))
  (product-map-eq1 (idMap I) (composeA k g h))
  (H.transH (theta (comp k g) h) (H.transH (ccl (product-map h (idMap I)) (theta k g))
   (H.transH (composeA (product-map k (idMap I)) (product-map g (idMap I)) (product-map h (idMap I)))
    (H.transH (ccr (product-map k (idMap I)) (H.symH (theta g h))) (H.symH (theta k (comp g h))))))) =
 H.transH (prod-pent-C k g h) (rhs-theta k g h) ;

timesI-cone (S : Square) {Y : Cat} (c : sq-cone S Y) : sq-cone (times-I S) (times Y I) =
 ((product-map (cg S Y c) (idMap I), product-map (ce S Y c) (idMap I)),
  H.transH (H.symH (theta (cg S Y c) S.sql))
   (H.transH (product-map-eq1 (idMap I) (cc S Y c)) (theta (ce S Y c) S.sqt))) ;

base-times (S : Square) : Id (sq-cone (times-I S) (times S.sqD I)) (base-cone (times-I S)) (timesI-cone S (base-cone S)) =
 H.apH (\ w -> ((product-map S.sqb (idMap I), product-map S.sqr (idMap I)), w)) (H.transH lhs (H.symH rhs))
 where {
  pa : Id (Map (times S.sqA I) (times S.sqD I)) (product-map (comp S.sqb S.sql) (comp (idMap I) (idMap I)))
   (comp (product-map S.sqb (idMap I)) (product-map S.sql (idMap I))) = pmc S.sql S.sqb (idMap I) (idMap I) ;
  pb : Id (Map (times S.sqA I) (times S.sqD I)) (product-map (comp S.sqr S.sqt) (comp (idMap I) (idMap I)))
   (comp (product-map S.sqr (idMap I)) (product-map S.sqt (idMap I))) = pmc S.sqt S.sqr (idMap I) (idMap I) ;
  m2 : Id (Map (times S.sqA I) (times S.sqD I)) (product-map (comp S.sqr S.sqt) (comp (idMap I) (idMap I)))
   (product-map (comp S.sqb S.sql) (comp (idMap I) (idMap I))) = product-map-eq1 (comp (idMap I) (idMap I)) S.sqcomm ;
  ea : Id (Map (times S.sqA I) (times S.sqD I)) (product-map (comp S.sqb S.sql) (idMap I))
   (product-map (comp S.sqb S.sql) (comp (idMap I) (idMap I))) = product-map-eq2 (comp S.sqb S.sql) (H.symH (comp-id-l (idMap I))) ;
  eb : Id (Map (times S.sqA I) (times S.sqD I)) (product-map (comp S.sqr S.sqt) (idMap I))
   (product-map (comp S.sqr S.sqt) (comp (idMap I) (idMap I))) = product-map-eq2 (comp S.sqr S.sqt) (H.symH (comp-id-l (idMap I))) ;
  -- (pb^-1 . (m2 . pa))^-1 = pa^-1 . (m2^-1 . pb)
  lhs : Id (Id (Map (times S.sqA I) (times S.sqD I)) (comp (product-map S.sqb (idMap I)) (product-map S.sql (idMap I)))
    (comp (product-map S.sqr (idMap I)) (product-map S.sqt (idMap I))))
   (H.symH (times-I-comm S)) (H.transH (H.symH pa) (H.transH (product-map-eq1 (comp (idMap I) (idMap I)) (H.symH S.sqcomm)) pb)) =
   H.transH (PA.sym-trans (H.symH pb) (H.transH m2 pa))
   (H.transH (H.apH (\ z -> H.transH z (H.symH (H.symH pb))) (PA.sym-trans m2 pa))
   (H.transH (H.apH (\ z -> H.transH (H.transH (H.symH pa) z) (H.symH (H.symH pb)))
      (H.symH (PA.ap-sym (\ f -> product-map f (comp (idMap I) (idMap I))) S.sqcomm)))
   (H.transH (H.apH (\ z -> H.transH (H.transH (H.symH pa) (product-map-eq1 (comp (idMap I) (idMap I)) (H.symH S.sqcomm))) z) (PA.sym-sym pb))
    (PA.tassoc (H.symH pa) (product-map-eq1 (comp (idMap I) (idMap I)) (H.symH S.sqcomm)) pb)))) ;
  -- theta_bl^-1 . (s^-1 x I . theta_rt) = pa^-1 . (m2^-1 . pb)
  rhs : Id (Id (Map (times S.sqA I) (times S.sqD I)) (comp (product-map S.sqb (idMap I)) (product-map S.sql (idMap I)))
    (comp (product-map S.sqr (idMap I)) (product-map S.sqt (idMap I))))
   (cc (times-I S) (times S.sqD I) (timesI-cone S (base-cone S)))
   (H.transH (H.symH pa) (H.transH (product-map-eq1 (comp (idMap I) (idMap I)) (H.symH S.sqcomm)) pb)) =
   H.transH (H.apH (\ z -> H.transH z (H.transH (product-map-eq1 (idMap I) (H.symH S.sqcomm)) (theta S.sqr S.sqt))) (PA.sym-trans ea pa))
   (H.transH (PA.tassoc (H.symH pa) (H.symH ea) (H.transH (product-map-eq1 (idMap I) (H.symH S.sqcomm)) (theta S.sqr S.sqt)))
   (H.apH (\ z -> H.transH (H.symH pa) z)
    (H.transH (H.apH (\ z -> H.transH (H.symH ea) z) (H.symH (PA.tassoc (product-map-eq1 (idMap I) (H.symH S.sqcomm)) eb pb)))
    (H.transH (H.apH (\ z -> H.transH (H.symH ea) (H.transH z pb)) (pme-exch (H.symH S.sqcomm)))
    (H.transH (H.apH (\ z -> H.transH (H.symH ea) z) (PA.tassoc ea (product-map-eq1 (comp (idMap I) (idMap I)) (H.symH S.sqcomm)) pb))
     (PA.canc-l ea (H.transH (product-map-eq1 (comp (idMap I) (idMap I)) (H.symH S.sqcomm)) pb))))))) ;
 } ;

