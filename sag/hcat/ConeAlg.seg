-- Postcomposition of cones and the naturality of the comparison (Agda
-- Squares/ConeNat, sq-comparison-natural; restructured).  Level 2.
--   cone-post k c: a cone (g, e, s) of S into Y and k : Y -> X give the
--   cone (k g, k e) with (k g) l = k (g l) = k (e t) = (k e) t.  The
--   comparison is postcomposition of the base cone (b, r, comm^-1) of S
--   into D, by definition (comparison-post).
--   A. cone-post-comp: postcomposition with h k is postcomposition with k
--   then h.  Legs by a(h,k,g), a(h,k,e).  For the squares, with the
--   pentagon at (h,k,g,l) the composite starting with the leg cell becomes
--   a(hk,g,l) . a(h,k,gl) . (h o k o s) . ..., naturality of a in its third
--   argument moves s across, and the pentagon at (h,k,e,t) closes it.
--   B. cone-pre-post: precomposition with a square morphism m commutes
--   with postcomposition with h.  The composite of the precomposed cone
--   is telescoped from its end: each reassociator with h on the left is
--   expanded by a pentagon (at (h,g,mC,lP), (h,g,lQ,mA), (h,e,tQ,mA),
--   (h,e,mB,tP)) and each whiskered cell is moved under h by naturality;
--   the expansions cancel in pairs, leaving h o (the precomposed square).
--   sq-comparison-natural: comparison of P at h o mD is precomposition by
--   m of the comparison of Q at h.  By A and B both sides are
--   postcompositions with h of a cone of P into D_Q, namely
--   cone-post mD (base P) and cone-pre m (base Q); these have the legs
--   mD bP = bQ mC, mD rP = rQ mB (sm-b, sm-r), and their squares agree
--   since Map A_P D_Q is a set.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module PM = PathMoves[l] ;
open WildCat ; open Naturality ; open Squares ; open SquareAlg ;

cone-post (S : Square) {Y X : Cat} (k : Map Y X) (c : sq-cone S Y) : sq-cone S X =
 ((comp k (cg S Y c), comp k (ce S Y c)),
  H.transH (composeA k (cg S Y c) S.sql) (H.transH (ccr k (cc S Y c)) (H.symH (composeA k (ce S Y c) S.sqt)))) ;

base-cone (S : Square) : sq-cone S S.sqD = ((S.sqb, S.sqr), H.symH S.sqcomm) ;

comparison-post (S : Square) (X : Cat) (h : Map S.sqD X) :
 Id (sq-cone S X) (sq-comparison S X h) (cone-post S h (base-cone S)) = refl (sq-comparison S X h) ;

cone-post-comp (S : Square) {Z Y X : Cat} (h : Map Y X) (k : Map Z Y) (c : sq-cone S Z) :
 Id (sq-cone S X) (cone-post S (comp h k) c) (cone-post S h (cone-post S k c)) =
 cone-eq S X (cone-post S (comp h k) c) (cone-post S h (cone-post S k c))
  (composeA h k g) (composeA h k e) (H.symH coh)
 where {
  g : Map S.sqC Z = cg S Z c ;
  e : Map S.sqB Z = ce S Z c ;
  s : Id (Map S.sqA Z) (comp g S.sql) (comp e S.sqt) = cc S Z c ;
  tl : Id (Map S.sqA X) (comp h (comp k (comp e S.sqt))) (comp (comp h (comp k e)) S.sqt) =
   H.transH (ccr h (H.symH (composeA k e S.sqt))) (H.symH (composeA h (comp k e) S.sqt)) ;
  -- the tail closed by the pentagon at (h, k, e, t)
  close : Id (Id (Map S.sqA X) (comp (comp h k) (comp e S.sqt)) (comp (comp h (comp k e)) S.sqt))
   (H.transH (composeA h k (comp e S.sqt)) tl)
   (H.transH (H.symH (composeA (comp h k) e S.sqt)) (ccl S.sqt (composeA h k e))) =
   H.transH (H.apH (\ q -> H.transH (composeA h k (comp e S.sqt)) (H.transH q (H.symH (composeA h (comp k e) S.sqt))))
     (PA.ap-sym (\ m -> comp h m) (composeA k e S.sqt)))
    (PM.solve3 (composeA (comp h k) e S.sqt) (composeA h k (comp e S.sqt)) (ccl S.sqt (composeA h k e))
      (composeA h (comp k e) S.sqt) (ccr h (composeA k e S.sqt)) (pentagonator h k e S.sqt)) ;
  coh : Id (Id (Map S.sqA X) (comp (comp (comp h k) g) S.sql) (comp (comp h (comp k e)) S.sqt))
   (H.transH (cc S X (cone-post S (comp h k) c)) (ccl S.sqt (composeA h k e)))
   (H.transH (ccl S.sql (composeA h k g)) (cc S X (cone-post S h (cone-post S k c)))) =
   calc (Id (Map S.sqA X) (comp (comp (comp h k) g) S.sql) (comp (comp h (comp k e)) S.sqt)) {
    H.transH (H.transH (composeA (comp h k) g S.sql) (H.transH (ccr (comp h k) s) (H.symH (composeA (comp h k) e S.sqt))))
     (ccl S.sqt (composeA h k e))
    =< PM.flat3 (composeA (comp h k) g S.sql) (ccr (comp h k) s) (H.symH (composeA (comp h k) e S.sqt)) (ccl S.sqt (composeA h k e)) >
    H.transH (composeA (comp h k) g S.sql) (H.transH (ccr (comp h k) s)
     (H.transH (H.symH (composeA (comp h k) e S.sqt)) (ccl S.sqt (composeA h k e))))
    =< H.apH (\ q -> H.transH (composeA (comp h k) g S.sql) (H.transH (ccr (comp h k) s) q)) (H.symH close) >
    H.transH (composeA (comp h k) g S.sql) (H.transH (ccr (comp h k) s) (H.transH (composeA h k (comp e S.sqt)) tl))
    =< H.apH (\ q -> H.transH (composeA (comp h k) g S.sql) q) (PM.move2 (H.symH (compose-naturality3 h k s)) tl) >
    H.transH (composeA (comp h k) g S.sql) (H.transH (composeA h k (comp g S.sql)) (H.transH (ccr h (ccr k s)) tl))
    =< PM.unmove3 (pentagonator h k g S.sql) (H.transH (ccr h (ccr k s)) tl) >
    H.transH (ccl S.sql (composeA h k g)) (H.transH (composeA h (comp k g) S.sql)
     (H.transH (ccr h (composeA k g S.sql)) (H.transH (ccr h (ccr k s)) tl)))
    =< H.apH (\ q -> H.transH (ccl S.sql (composeA h k g)) (H.transH (composeA h (comp k g) S.sql)
          (H.transH (ccr h (composeA k g S.sql)) q)))
        (H.symH (PM.apt (\ m -> comp h m) (ccr k s) (H.symH (composeA k e S.sqt)) (H.symH (composeA h (comp k e) S.sqt)))) >
    H.transH (ccl S.sql (composeA h k g)) (H.transH (composeA h (comp k g) S.sql)
     (H.transH (ccr h (composeA k g S.sql)) (H.transH (ccr h (H.transH (ccr k s) (H.symH (composeA k e S.sqt))))
      (H.symH (composeA h (comp k e) S.sqt)))))
    =< H.apH (\ q -> H.transH (ccl S.sql (composeA h k g)) (H.transH (composeA h (comp k g) S.sql) q))
        (H.symH (PM.apt (\ m -> comp h m) (composeA k g S.sql) (H.transH (ccr k s) (H.symH (composeA k e S.sqt)))
          (H.symH (composeA h (comp k e) S.sqt)))) >
    H.transH (ccl S.sql (composeA h k g)) (H.transH (composeA h (comp k g) S.sql)
     (H.transH (ccr h (H.transH (composeA k g S.sql) (H.transH (ccr k s) (H.symH (composeA k e S.sqt)))))
      (H.symH (composeA h (comp k e) S.sqt)))) } ;
 } ;

cone-pre-post {P Q : Square} (m : square-morphism[P, Q]) {Y X : Cat} (h : Map Y X) (c : sq-cone Q Y) :
 Id (sq-cone P X) (sq-cone-pre m X (cone-post Q h c)) (cone-post P h (sq-cone-pre m Y c)) =
 cone-eq P X (sq-cone-pre m X (cone-post Q h c)) (cone-post P h (sq-cone-pre m Y c))
  (composeA h g m.smC) (composeA h e m.smB) (H.transH lhsNF (H.symH rhsNF))
 where {
  g : Map Q.sqC Y = cg Q Y c ;
  e : Map Q.sqB Y = ce Q Y c ;
  s : Id (Map Q.sqA Y) (comp g Q.sql) (comp e Q.sqt) = cc Q Y c ;
  -- the precomposed square of c, step by step (cone-pre-comm m Y c)
  y1 : Id (Map P.sqA Y) (comp (comp g m.smC) P.sql) (comp g (comp m.smC P.sql)) = composeA g m.smC P.sql ;
  y2 : Id (Map P.sqA Y) (comp g (comp m.smC P.sql)) (comp g (comp Q.sql m.smA)) = ccr g (H.symH m.sm-l) ;
  y3 : Id (Map P.sqA Y) (comp g (comp Q.sql m.smA)) (comp (comp g Q.sql) m.smA) = H.symH (composeA g Q.sql m.smA) ;
  y4 : Id (Map P.sqA Y) (comp (comp g Q.sql) m.smA) (comp (comp e Q.sqt) m.smA) = ccl m.smA s ;
  y5 : Id (Map P.sqA Y) (comp (comp e Q.sqt) m.smA) (comp e (comp Q.sqt m.smA)) = composeA e Q.sqt m.smA ;
  y6 : Id (Map P.sqA Y) (comp e (comp Q.sqt m.smA)) (comp e (comp m.smB P.sqt)) = ccr e m.sm-t ;
  y7 : Id (Map P.sqA Y) (comp e (comp m.smB P.sqt)) (comp (comp e m.smB) P.sqt) = H.symH (composeA e m.smB P.sqt) ;
  hy (u v : Map P.sqA Y) (p : Id (Map P.sqA Y) u v) : Id (Map P.sqA X) (comp h u) (comp h v) = ccr h p ;
  last : Id (Map P.sqA X) (comp h (comp (comp e m.smB) P.sqt)) (comp (comp h (comp e m.smB)) P.sqt) =
   H.symH (composeA h (comp e m.smB) P.sqt) ;
  NF : Id (Map P.sqA X) (comp (comp (comp h g) m.smC) P.sql) (comp (comp h (comp e m.smB)) P.sqt) =
   H.transH (ccl P.sql (composeA h g m.smC)) (H.transH (composeA h (comp g m.smC) P.sql)
   (H.transH (ccr h y1) (H.transH (ccr h y2) (H.transH (ccr h y3) (H.transH (ccr h y4)
   (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last)))))))) ;
  lhsNF : Id (Id (Map P.sqA X) (comp (comp (comp h g) m.smC) P.sql) (comp (comp h (comp e m.smB)) P.sqt))
   (H.transH (ccl P.sql (composeA h g m.smC)) (cc P X (cone-post P h (sq-cone-pre m Y c)))) NF =
   H.apH (\ q -> H.transH (ccl P.sql (composeA h g m.smC)) (H.transH (composeA h (comp g m.smC) P.sql) q))
    (PM.apt7 (\ u -> comp h u) y1 y2 y3 y4 y5 y6 y7 last) ;
  -- the cone c' = h o c, and its precomposed square
  z1 : Id (Map Q.sqA X) (comp (comp h g) Q.sql) (comp h (comp g Q.sql)) = composeA h g Q.sql ;
  z2 : Id (Map Q.sqA X) (comp h (comp g Q.sql)) (comp h (comp e Q.sqt)) = ccr h s ;
  z3 : Id (Map Q.sqA X) (comp h (comp e Q.sqt)) (comp (comp h e) Q.sqt) = H.symH (composeA h e Q.sqt) ;
  x1 : Id (Map P.sqA X) (comp (comp (comp h g) m.smC) P.sql) (comp (comp h g) (comp m.smC P.sql)) = composeA (comp h g) m.smC P.sql ;
  x2 : Id (Map P.sqA X) (comp (comp h g) (comp m.smC P.sql)) (comp (comp h g) (comp Q.sql m.smA)) = ccr (comp h g) (H.symH m.sm-l) ;
  x3 : Id (Map P.sqA X) (comp (comp h g) (comp Q.sql m.smA)) (comp (comp (comp h g) Q.sql) m.smA) = H.symH (composeA (comp h g) Q.sql m.smA) ;
  x4 : Id (Map P.sqA X) (comp (comp (comp h g) Q.sql) m.smA) (comp (comp (comp h e) Q.sqt) m.smA) =
   ccl m.smA (H.transH z1 (H.transH z2 z3)) ;
  x5 : Id (Map P.sqA X) (comp (comp (comp h e) Q.sqt) m.smA) (comp (comp h e) (comp Q.sqt m.smA)) = composeA (comp h e) Q.sqt m.smA ;
  x6 : Id (Map P.sqA X) (comp (comp h e) (comp Q.sqt m.smA)) (comp (comp h e) (comp m.smB P.sqt)) = ccr (comp h e) m.sm-t ;
  x7 : Id (Map P.sqA X) (comp (comp h e) (comp m.smB P.sqt)) (comp (comp (comp h e) m.smB) P.sqt) = H.symH (composeA (comp h e) m.smB P.sqt) ;
  pe : Id (Map P.sqA X) (comp (comp (comp h e) m.smB) P.sqt) (comp (comp h (comp e m.smB)) P.sqt) = ccl P.sqt (composeA h e m.smB) ;
  -- the telescope, from the end
  t7 : Id (Id (Map P.sqA X) (comp (comp h e) (comp m.smB P.sqt)) (comp (comp h (comp e m.smB)) P.sqt))
   (H.transH x7 pe) (H.transH (composeA h e (comp m.smB P.sqt)) (H.transH (ccr h y7) last)) =
   H.transH (H.symH (PM.solve3 (composeA (comp h e) m.smB P.sqt) (composeA h e (comp m.smB P.sqt)) pe
     (composeA h (comp e m.smB) P.sqt) (ccr h (composeA e m.smB P.sqt)) (pentagonator h e m.smB P.sqt)))
    (H.apH (\ q -> H.transH (composeA h e (comp m.smB P.sqt)) (H.transH q last))
     (H.symH (PA.ap-sym (\ u -> comp h u) (composeA e m.smB P.sqt)))) ;
  t6 : Id (Id (Map P.sqA X) (comp (comp h e) (comp Q.sqt m.smA)) (comp (comp h (comp e m.smB)) P.sqt))
   (H.transH x6 (H.transH x7 pe)) (H.transH (composeA h e (comp Q.sqt m.smA)) (H.transH (ccr h y6) (H.transH (ccr h y7) last))) =
   H.transH (H.apH (\ q -> H.transH x6 q) t7)
    (PM.move2 (H.symH (compose-naturality3 h e m.sm-t)) (H.transH (ccr h y7) last)) ;
  t5 : Id (Id (Map P.sqA X) (comp (comp (comp h e) Q.sqt) m.smA) (comp (comp h (comp e m.smB)) P.sqt))
   (H.transH x5 (H.transH x6 (H.transH x7 pe)))
   (H.transH (ccl m.smA (composeA h e Q.sqt)) (H.transH (composeA h (comp e Q.sqt) m.smA)
    (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last))))) =
   H.transH (H.apH (\ q -> H.transH x5 q) t6)
    (PM.unmove3 (pentagonator h e Q.sqt m.smA) (H.transH (ccr h y6) (H.transH (ccr h y7) last))) ;
  w5 : Id (Map P.sqA X) (comp h (comp (comp e Q.sqt) m.smA)) (comp (comp h (comp e m.smB)) P.sqt) =
   H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last)) ;
  t4i : Id (Id (Map P.sqA X) (comp (comp h (comp g Q.sql)) m.smA) (comp (comp h (comp e m.smB)) P.sqt))
   (H.transH (ccl m.smA z2) (H.transH (ccl m.smA z3) (H.transH x5 (H.transH x6 (H.transH x7 pe)))))
   (H.transH (composeA h (comp g Q.sql) m.smA) (H.transH (ccr h y4) w5)) =
   H.transH (H.apH (\ q -> H.transH (ccl m.smA z2) (H.transH (ccl m.smA z3) q)) t5)
   (H.transH (H.apH (\ q -> H.transH (ccl m.smA z2) (H.transH q (H.transH (ccl m.smA (composeA h e Q.sqt))
               (H.transH (composeA h (comp e Q.sqt) m.smA) w5))))
              (PA.ap-sym (\ u -> comp u m.smA) (composeA h e Q.sqt)))
   (H.transH (H.apH (\ q -> H.transH (ccl m.smA z2) q)
              (PA.canc-l (ccl m.smA (composeA h e Q.sqt)) (H.transH (composeA h (comp e Q.sqt) m.smA) w5)))
    (PM.move2 (H.symH (compose-naturality2 h m.smA s)) w5))) ;
  t4 : Id (Id (Map P.sqA X) (comp (comp (comp h g) Q.sql) m.smA) (comp (comp h (comp e m.smB)) P.sqt))
   (H.transH (ccl m.smA z1) (H.transH (ccl m.smA z2) (H.transH (ccl m.smA z3) (H.transH x5 (H.transH x6 (H.transH x7 pe))))))
   (H.transH (ccl m.smA z1) (H.transH (composeA h (comp g Q.sql) m.smA)
    (H.transH (ccr h y4) (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last)))))) =
   H.apH (\ q -> H.transH (ccl m.smA z1) q) t4i ;
  t3 : Id (Id (Map P.sqA X) (comp (comp h g) (comp Q.sql m.smA)) (comp (comp h (comp e m.smB)) P.sqt))
   (H.transH x3 (H.transH (ccl m.smA z1) (H.transH (composeA h (comp g Q.sql) m.smA)
    (H.transH (ccr h y4) (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last)))))))
   (H.transH (composeA h g (comp Q.sql m.smA)) (H.transH (ccr h y3)
    (H.transH (ccr h y4) (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last)))))) =
   H.transH (PM.inv-cps (composeA (comp h g) Q.sql m.smA) (composeA h g (comp Q.sql m.smA)) (ccl m.smA z1)
     (composeA h (comp g Q.sql) m.smA) (ccr h (composeA g Q.sql m.smA))
     (H.transH (ccr h y4) (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last))))
     (PM.unmove3 (pentagonator h g Q.sql m.smA)
      (H.transH (H.symH (ccr h (composeA g Q.sql m.smA)))
       (H.transH (ccr h y4) (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last)))))))
    (H.apH (\ q -> H.transH (composeA h g (comp Q.sql m.smA)) (H.transH q
       (H.transH (ccr h y4) (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last))))))
     (H.symH (PA.ap-sym (\ u -> comp h u) (composeA g Q.sql m.smA)))) ;
  rest2 : Id (Map P.sqA X) (comp h (comp g (comp Q.sql m.smA))) (comp (comp h (comp e m.smB)) P.sqt) =
   H.transH (ccr h y3) (H.transH (ccr h y4) (H.transH (ccr h y5) (H.transH (ccr h y6) (H.transH (ccr h y7) last)))) ;
  rhsNF : Id (Id (Map P.sqA X) (comp (comp (comp h g) m.smC) P.sql) (comp (comp h (comp e m.smB)) P.sqt))
   (H.transH (cc P X (sq-cone-pre m X (cone-post Q h c))) pe) NF =
   H.transH (PM.tail7 x1 x2 x3 x4 x5 x6 x7 pe)
   (H.transH (H.apH (\ q -> H.transH x1 (H.transH x2 (H.transH x3 q)))
     (H.transH (PM.apt (\ u -> comp u m.smA) z1 (H.transH z2 z3) (H.transH x5 (H.transH x6 (H.transH x7 pe))))
      (H.apH (\ q -> H.transH (ccl m.smA z1) q) (PM.apt (\ u -> comp u m.smA) z2 z3 (H.transH x5 (H.transH x6 (H.transH x7 pe)))))))
   (H.transH (H.apH (\ q -> H.transH x1 (H.transH x2 q)) (H.transH (H.apH (\ q -> H.transH x3 q) t4) t3))
   (H.transH (H.apH (\ q -> H.transH x1 q) (PM.move2 (H.symH (compose-naturality3 h g (H.symH m.sm-l))) rest2))
    (PM.unmove3 (pentagonator h g m.smC P.sql) (H.transH (ccr h y2) rest2))))) ;
 } ;

-- the base cones of P and Q, compared in the set Map A_P D_Q
base-eq {P Q : Square} (m : square-morphism[P, Q]) (HD : Prelude[l].isSet (Map P.sqA Q.sqD)) :
 Id (sq-cone P Q.sqD) (cone-post P m.smD (base-cone P)) (sq-cone-pre m Q.sqD (base-cone Q)) =
 cone-eq P Q.sqD (cone-post P m.smD (base-cone P)) (sq-cone-pre m Q.sqD (base-cone Q))
  (H.symH m.sm-b) (H.symH m.sm-r) (HD _ _ _ _) ;

sq-comparison-natural {P Q : Square} (m : square-morphism[P, Q]) (X : Cat)
 (HD : Prelude[l].isSet (Map P.sqA Q.sqD)) (h : Map Q.sqD X) :
 Id (sq-cone P X) (sq-comparison P X (sq-apex-pre m X h)) (sq-cone-pre m X (sq-comparison Q X h)) =
 H.transH (cone-post-comp P h m.smD (base-cone P))
  (H.transH (H.apH (cone-post P h) (base-eq m HD)) (H.symH (cone-pre-post m h (base-cone Q)))) ;
