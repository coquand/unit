-- Pushout squares in D, and paths between maps out of a copower (H3).
-- Internal level 1 of D for the definitions; the path part of the
-- comparison map uses the associator of D.
--   DSquare: a square ii uu = jj vv in D, with 2-cell ss.  A cocone on T is
--   (b, e, p) with p : ii b = jj e; cocone-map g = (uu g, vv g, cocone-path g),
--     cocone-path g : ii (uu g) = (ii uu) g = (jj vv) g = jj (vv g)
--   (associator, ss whiskered by g, associator).  The square is a pushout
--   when cocone-map is an equivalence for every T.
--   omega: a path p : f = f1 of maps out of Y (x) A gives, for each y, the
--   path eta_y f = eta_y f1: happly of ap restrict p.  It is an equivalence
--   (ap of the equivalence restrict, then function extensionality), and
--   omega p y is ap (eta_y -) p (omega-ap, J on p).  omega-sec-pt: the
--   inverse of omega followed by ap (eta_y -) gives back the family.
--   conj-pi-equiv: pointwise conjugation ph |-> a^-1 (ph b) of a family of
--   paths is an equivalence, with inverse ps |-> a (ps b^-1).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ; open CopowerRestrict ;

module DSquare (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee) (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv)) {
 Cocone (T : Ob D) : U l = (b : Hom D Bb T) * (e : Hom D Ee T) * Id (Hom D Cc T) (hcomp {D} ii b) (hcomp {D} jj e) ;
 cocone-path (T : Ob D) (g : Hom D P T) :
  Id (Hom D Cc T) (hcomp {D} ii (hcomp {D} uu g)) (hcomp {D} jj (hcomp {D} vv g)) =
  H.transH (H.symH (hcomp-assoc D (Cc, Bb, P, T, ii, uu, g)))
   (H.transH (H.apH (\ w -> hcomp {D} w g) ss) (hcomp-assoc D (Cc, Ee, P, T, jj, vv, g))) ;
 cocone-map (T : Ob D) (g : Hom D P T) : Cocone T = (hcomp {D} uu g, hcomp {D} vv g, cocone-path T g) ;
 is-pushout : U l = (T : Ob D) -> Pl.isEquiv (Hom D P T) (Cocone T) (cocone-map T) ;
} ;

omega (Y : U k) (A W : Ob D) (f f1 : Hom D (tensor Y A) W) (p : Id (Hom D (tensor Y A) W) f f1) :
 (y : Y) -> Id (Hom D A W) (hcomp {D} (eta Y A y) f) (hcomp {D} (eta Y A y) f1) =
 Pl.happly Y (\ y -> Hom D A W) (restrict Y A W f) (restrict Y A W f1) (H.apH (restrict Y A W) p) ;

omega-equiv (Y : U k) (A W : Ob D) (f f1 : Hom D (tensor Y A) W) :
 Pl.isEquiv (Id (Hom D (tensor Y A) W) f f1) ((y : Y) -> Id (Hom D A W) (hcomp {D} (eta Y A y) f) (hcomp {D} (eta Y A y) f1))
  (omega Y A W f f1) =
 EL.compose (Id (Hom D (tensor Y A) W) f f1) (Id (Y -> Hom D A W) (restrict Y A W f) (restrict Y A W f1))
  ((y : Y) -> Id (Hom D A W) (hcomp {D} (eta Y A y) f) (hcomp {D} (eta Y A y) f1))
  (Pl.happly Y (\ y -> Hom D A W) (restrict Y A W f) (restrict Y A W f1)) (\ p -> H.apH (restrict Y A W) p)
  (fe @l Y (\ y -> Hom D A W) (restrict Y A W f) (restrict Y A W f1))
  (EquivAp[l].ap-equiv (Hom D (tensor Y A) W) (Y -> Hom D A W) (restrict Y A W, tensor-up Y A W) f f1) ;

omega-ap (Y : U k) (A W : Ob D) (f f1 : Hom D (tensor Y A) W) (p : Id (Hom D (tensor Y A) W) f f1) (y : Y) :
 Id (Id (Hom D A W) (hcomp {D} (eta Y A y) f) (hcomp {D} (eta Y A y) f1))
  (omega Y A W f f1 p y) (H.apH (\ w -> hcomp {D} (eta Y A y) w) p) =
 idJ (Hom D (tensor Y A) W) f (\ f2 p2 -> Id (Id (Hom D A W) (hcomp {D} (eta Y A y) f) (hcomp {D} (eta Y A y) f2))
   (omega Y A W f f2 p2 y) (H.apH (\ w -> hcomp {D} (eta Y A y) w) p2))
  (refl (refl (hcomp {D} (eta Y A y) f))) f1 p ;

omega-sec-pt (Y : U k) (A W : Ob D) (f f1 : Hom D (tensor Y A) W)
 (q : (y : Y) -> Id (Hom D A W) (hcomp {D} (eta Y A y) f) (hcomp {D} (eta Y A y) f1)) (y : Y) :
 Id (Id (Hom D A W) (hcomp {D} (eta Y A y) f) (hcomp {D} (eta Y A y) f1))
  (H.apH (\ w -> hcomp {D} (eta Y A y) w) ((omega-equiv Y A W f f1).sec q)) (q y) =
 H.transH (H.symH (omega-ap Y A W f f1 ((omega-equiv Y A W f f1).sec q) y))
  (H.apH {(y1 : Y) -> Id (Hom D A W) (hcomp {D} (eta Y A y1) f) (hcomp {D} (eta Y A y1) f1)} {Id (Hom D A W) (hcomp {D} (eta Y A y) f) (hcomp {D} (eta Y A y) f1)}
    (\ F -> F y) ((omega-equiv Y A W f f1).sec-eq q)) ;

------------------------------------------------------------------------
-- conjugation of families of paths

cancel3 {Z : U l} {x y z : Z} (a : Id Z x y) (q : Id Z x z) : Id (Id Z x z) (H.transH a (H.transH (H.symH a) q)) q =
 CompWitness.cancel a q ;

conj-unconj {Z : U l} {x x1 y y1 : Z} (a : Id Z x x1) (b : Id Z y y1) (ps : Id Z x1 y1) :
 Id (Id Z x1 y1) (H.transH (H.symH a) (H.transH (H.transH a (H.transH ps (H.symH b))) b)) ps =
 H.transH (H.apH (\ r -> H.transH (H.symH a) r)
   (H.transH (PA.tassoc a (H.transH ps (H.symH b)) b)
    (H.apH (\ r -> H.transH a r) (H.transH (PA.tassoc ps (H.symH b) b) (H.apH (\ r -> H.transH ps r) (PA.inv-l b))))))
  (PA.canc-l a ps) ;

unconj-conj {Z : U l} {x x1 y y1 : Z} (a : Id Z x x1) (b : Id Z y y1) (ph : Id Z x y) :
 Id (Id Z x y) (H.transH a (H.transH (H.transH (H.symH a) (H.transH ph b)) (H.symH b))) ph =
 H.transH (H.apH (\ r -> H.transH a r)
   (H.transH (PA.tassoc (H.symH a) (H.transH ph b) (H.symH b)) (H.apH (\ r -> H.transH (H.symH a) r) (PA.canc-r b ph))))
  (cancel3 a ph) ;

conj-pi-equiv (Cc Z : U l) (x x1 y y1 : Cc -> Z) (a : (c : Cc) -> Id Z (x c) (x1 c)) (b : (c : Cc) -> Id Z (y c) (y1 c)) :
 Pl.isEquiv ((c : Cc) -> Id Z (x c) (y c)) ((c : Cc) -> Id Z (x1 c) (y1 c))
  (\ ph c -> H.transH (H.symH (a c)) (H.transH (ph c) (b c))) =
 Pl.qinv ((c : Cc) -> Id Z (x c) (y c)) ((c : Cc) -> Id Z (x1 c) (y1 c))
  (\ ph c -> H.transH (H.symH (a c)) (H.transH (ph c) (b c)))
  (\ ps c -> H.transH (a c) (H.transH (ps c) (H.symH (b c))))
  (\ ps -> FE.funext Cc (\ c -> Id Z (x1 c) (y1 c))
    (\ c -> H.transH (H.symH (a c)) (H.transH (H.transH (a c) (H.transH (ps c) (H.symH (b c)))) (b c))) ps
    (\ c -> conj-unconj (a c) (b c) (ps c)))
  (\ ph -> FE.funext Cc (\ c -> Id Z (x c) (y c))
    (\ c -> H.transH (a c) (H.transH (H.transH (H.symH (a c)) (H.transH (ph c) (b c))) (H.symH (b c)))) ph
    (\ c -> unconj-conj (a c) (b c) (ph c))) ;
