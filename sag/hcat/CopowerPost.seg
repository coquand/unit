-- Postcomposition transports complete copower witnesses.
-- The square between restriction and postcomposition commutes by the
-- inverse associator, pointwise in the generators. WitnessTransport
-- therefore transports (h,beta) to (h g,beta'), retaining the beta path.
-- Its result agrees with the chosen lift in a contractible witness fibre.
-- For two successive postcompositions, move the iterated witness along
-- the pointwise associator on generators. It and the direct witness then
-- lie in the same contractible fibre, giving a comparison and coherent
-- uniqueness at all finite path dimensions. The projection of this
-- comparison has NOT been identified with D's specified associator;
-- that identification is an additional categorical coherence problem.
open Base ;
module H = Paths[l] ; module CU = FunExtUA[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ; open CopowerRestrict ;
open FibreLemmas ;

module Post (X : U k) (A T T1 : Ob D) (g : Hom D T T1) {
 on-maps (h : Hom D (tensor X A) T) : Hom D (tensor X A) T1 = hcomp {D} h g ;
 on-generators (h : X -> Hom D A T) : X -> Hom D A T1 = \ x -> hcomp {D} (h x) g ;

 square (h : Hom D (tensor X A) T) :
  Id (X -> Hom D A T1) (restrict X A T1 (on-maps h)) (on-generators (restrict X A T h)) =
  FE.funext X (\ x -> Hom D A T1) (restrict X A T1 (on-maps h)) (on-generators (restrict X A T h))
   (\ x -> H.symH (hcomp-assoc D (A, tensor X A, T, T1, eta X A x, h, g))) ;

 module Transport = WitnessTransport.Square[Hom D (tensor X A) T, X -> Hom D A T,
  Hom D (tensor X A) T1, X -> Hom D A T1, restrict X A T, restrict X A T1, on-maps, on-generators, square] ;

 lift-comparison (h : X -> Hom D A T) :
  Id (fib (restrict X A T1) (on-generators h))
   (Transport.act h (CopowerWitness.Maps[X, A, T].chosen h))
   (CopowerWitness.Maps[X, A, T1].chosen (on-generators h)) =
  CopowerWitness.Maps[X, A, T1].W[on-generators h].UW.compare
   (Transport.act h (CopowerWitness.Maps[X, A, T].chosen h))
   (CopowerWitness.Maps[X, A, T1].chosen (on-generators h)) ;
} ;

module Compose (X : U k) (A T T1 T2 : Ob D) (g : Hom D T T1) (g1 : Hom D T1 T2) (h : X -> Hom D A T) {
 module P = Post[X, A, T, T1, g] ;
 module Q = Post[X, A, T1, T2, g1] ;
 module R = Post[X, A, T, T2, hcomp {D} g g1] ;
 module W = CopowerWitness.Maps[X, A, T2].W[R.on-generators h] ;

 base-path : Id (X -> Hom D A T2) (Q.on-generators (P.on-generators h)) (R.on-generators h) =
  FE.funext X (\ x -> Hom D A T2) (Q.on-generators (P.on-generators h)) (R.on-generators h)
   (\ x -> hcomp-assoc D (A, T, T1, T2, h x, g, g1)) ;

 iterated (w : fib (restrict X A T) h) : fib (restrict X A T2) (R.on-generators h) =
  H.substH (fib (restrict X A T2)) base-path (Q.Transport.act (P.on-generators h) (P.Transport.act h w)) ;

 comparison (w : fib (restrict X A T) h) :
  Id (fib (restrict X A T2) (R.on-generators h)) (iterated w) (R.Transport.act h w) =
  W.UW.compare (iterated w) (R.Transport.act h w) ;

 choices : CU.isContr (fib (restrict X A T) h -> fib (restrict X A T2) (R.on-generators h)) =
  UniversalWitness.sections (fib (restrict X A T) h) (\ w -> fib (restrict X A T2) (R.on-generators h))
   (\ w -> W.UW.contractible) ;
} ;
