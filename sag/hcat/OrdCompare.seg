-- The order on Ord n as a Two-valued test (Agda Interval/OrdCompare):
-- ord-leq x y = 1 iff x <= y; it is reflexive, sound and complete.
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ;

ord-leq : (n : Nat) -> Ord n -> Ord n -> Two = split {
 zero -> \ x y -> one2 ;
 suc n | r -> split {
  inl x -> split { inl y -> r x y ; inr v -> one2 } ;
  inr u -> split { inl y -> zero2 ; inr v -> one2 } } } ;

ord-leq-refl : (n : Nat) (x : Ord n) -> Id Two (ord-leq n x x) one2 = split {
 zero -> \ x -> refl one2 ;
 suc n | r -> split { inl x -> r x ; inr u -> refl one2 } } ;

-- 0 is not 1
is-zero2 : Two -> U l = split { inl u -> Top ; inr u -> Empty } ;
zero-not-one (p : Id Two zero2 one2) : Empty = H.substH is-zero2 p tt ;

ord-leq-mono : (n : Nat) (x y : Ord n) -> Id Two (ord-leq n x y) one2 -> leqOrd n x y = split {
 zero -> \ x y p -> tt ;
 suc n | r -> split {
  inl x -> split { inl y -> \ p -> r x y p ; inr v -> \ p -> tt } ;
  inr u -> split { inl y -> \ p -> Pl.absurd _ (zero-not-one p) ; inr v -> \ p -> tt } } } ;

ord-leq-complete : (n : Nat) (x y : Ord n) -> leqOrd n x y -> Id Two (ord-leq n x y) one2 = split {
 zero -> \ x y le -> refl one2 ;
 suc n | r -> split {
  inl x -> split { inl y -> \ le -> r x y le ; inr v -> \ le -> refl one2 } ;
  inr u -> split { inl y -> \ le -> Pl.absurd _ le ; inr v -> \ le -> refl one2 } } } ;
