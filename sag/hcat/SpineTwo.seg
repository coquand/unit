-- The spine at n = 2 is the boundary map of composition (M6, step 4).
-- Level 1.
--   flat2 reads a chain of length 2 as a Pair.  The universal spine of
--   Delta 2, read so, is the standard pair (w0, w1, w2, d01, d12): its
--   edges are face 1 o last-edge 0 = d01 and last-edge 1 = d12 (the
--   cofaces, with eval-pt-inv = last-edge 0 and eval-pt o eval-pt-inv = 1),
--   so its vertices are those of d01, d12; in Delta 2 a pair is
--   determined by its vertices, since Hom (Delta 2) x y is a proposition
--   (pair-eq-thin).  Applying s gives spine-two: the spine of a 2-simplex
--   is bd-pair s, so composition is the centre of the fillers of the case
--   n = 2 of segal-all.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open LastEdge ; open FaceMap ; open FaceTop ;
open UnitIso ; open PushoutProof ; open GluingSquare ; open SegalComparison ; open SegalCoface ;
open PosetalCore ; open FunIPosetal ; open Chains ; open Composition ;

flat2 (C : Cat) (t : TC C (suc (suc zero))) : Pair C = (t.2.2.1.1, t.2.1, t.1, t.2.2.1.2.2, t.2.2.2) ;

-- by definition: the spine of s, read as a pair, is s applied to that of Delta 2
flat2-spine (C : Cat) (s : Map (Delta (suc (suc zero))) C) :
 Id (Pair C) (flat2 C (spine-total C (suc (suc zero)) s))
  (Pair-map s (flat2 (Delta (suc (suc zero))) (top (suc (suc zero)), univ-chain (suc (suc zero))))) =
 refl (flat2 C (spine-total C (suc (suc zero)) s)) ;

pair-eq-thin (C : Cat) (thin : (x y : Ob C) -> Pl.isProp (Hom C x y)) (p : Pair C) :
 (z : Ob C) (a : Id (Ob C) p.1 z) (y : Ob C) (b : Id (Ob C) p.2.1 y) (x : Ob C) (c : Id (Ob C) p.2.2.1 x)
 (k1 : Hom C z y) (k2 : Hom C y x) -> Id (Pair C) p (z, y, x, k1, k2) =
 \ z a -> idJ (Ob C) p.1 (\ z1 a1 -> (y : Ob C) (b : Id (Ob C) p.2.1 y) (x : Ob C) (c : Id (Ob C) p.2.2.1 x)
   (k1 : Hom C z1 y) (k2 : Hom C y x) -> Id (Pair C) p (z1, y, x, k1, k2))
  (\ y b -> idJ (Ob C) p.2.1 (\ y1 b1 -> (x : Ob C) (c : Id (Ob C) p.2.2.1 x)
    (k1 : Hom C p.1 y1) (k2 : Hom C y1 x) -> Id (Pair C) p (p.1, y1, x, k1, k2))
   (\ x c -> idJ (Ob C) p.2.2.1 (\ x1 c1 -> (k1 : Hom C p.1 p.2.1) (k2 : Hom C p.2.1 x1) -> Id (Pair C) p (p.1, p.2.1, x1, k1, k2))
     (\ k1 k2 -> H.transH (H.apH {Hom C p.1 p.2.1} {Pair C} (\ u -> (p.1, p.2.1, p.2.2.1, u, p.2.2.2.2)) (thin p.1 p.2.1 p.2.2.2.1 k1))
       (H.apH {Hom C p.2.1 p.2.2.1} {Pair C} (\ u -> (p.1, p.2.1, p.2.2.1, k1, u)) (thin p.2.1 p.2.2.1 p.2.2.2.2 k2)))
     x c)
   y b)
  z a ;

-- the edges of the universal spine of Delta 2 are d01 and d12
edge01 : Id (Mor (Delta (suc (suc zero)))) (comp (face (suc zero)) (last-edge zero)) d01 =
 H.transH (H.apH (\ g -> comp {I} {Delta (suc zero)} {Delta (suc (suc zero))} (face (suc zero)) g) (H.symH eval-pt-inv-eq))
  (H.symH segal-coface-01) ;

edge12 : Id (Mor (Delta (suc (suc zero)))) (last-edge (suc zero)) d12 =
 H.transH (H.symH (comp-id-r (last-edge (suc zero))))
 (H.transH (H.symH (ccr {I} {I} {Delta (suc (suc zero))} (last-edge (suc zero)) eval-pt-rinv))
 (H.transH (comp-assoc {I} {Delta (suc zero)} {I} {Delta (suc (suc zero))} (last-edge (suc zero)) eval-pt eval-pt-inv)
  (H.symH segal-coface-12))) ;

univ-pair : Pair (Delta (suc (suc zero))) = flat2 (Delta (suc (suc zero))) (top (suc (suc zero)), univ-chain (suc (suc zero))) ;

univ-pair-std : Id (Pair (Delta (suc (suc zero)))) univ-pair std-pair =
 pair-eq-thin (Delta (suc (suc zero))) (Delta-posetal (suc (suc zero))).1 univ-pair
  w0 (H.transH (H.symH univ-pair.2.2.2.1.2.1) (H.transH (H.apH (\ m -> dom {Delta (suc (suc zero))} m) edge01) d01-dom))
  w1 (H.transH (H.symH univ-pair.2.2.2.1.2.2) (H.transH (H.apH (\ m -> cod {Delta (suc (suc zero))} m) edge01) d01-cod))
  w2 (H.transH (H.symH univ-pair.2.2.2.2.2.2) (H.transH (H.apH (\ m -> cod {Delta (suc (suc zero))} m) edge12) d12-cod))
  std-pair.2.2.2.1 std-pair.2.2.2.2 ;

spine-two (C : Cat) (s : Map (Delta (suc (suc zero))) C) :
 Id (Pair C) (flat2 C (spine-total C (suc (suc zero)) s)) (bd-pair C s) =
 H.apH (Pair-map s) univ-pair-std ;
