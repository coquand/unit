-- Finite data for paths in Hom, with the calculation rules bundled.
-- A cell retains its underlying morphism path and both endpoint cells.
-- Reading joins, endpoint coercions, and functor images agrees with the
-- corresponding operations on paths, by the existing Hom-eq lemmas.
-- This packaging is used to normalize the five steps of HomTriple.long.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open HomPaths ;

record Cell (C : Cat) (x y : Ob C) (h1 h2 : Hom C x y) {
 arrow : Id (Mor C) (hmor h1) (hmor h2) ;
 left : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (H.transH (ccl {One} {I} {C} I0 arrow) (hdom h2)) ;
 right : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (H.transH (ccl {One} {I} {C} I1 arrow) (hcod h2)) ;
} ;

module At (C : Cat) (x y : Ob C) {
 read (h1 h2 : Hom C x y) (e : Cell[C, x, y, h1, h2]) : Id (Hom C x y) h1 h2 = Hom-eq C h1 h2 e.arrow e.left e.right ;
 join (h1 h2 h3 : Hom C x y) (e : Cell[C, x, y, h1, h2]) (f : Cell[C, x, y, h2, h3]) : Cell[C, x, y, h1, h3] =
  new Cell[C, x, y, h1, h3, H.transH e.arrow f.arrow,
   HomEqCalc.end-trans C I0 e.arrow f.arrow e.left f.left, HomEqCalc.end-trans C I1 e.arrow f.arrow e.right f.right] ;
 join-read (h1 h2 h3 : Hom C x y) (e : Cell[C, x, y, h1, h2]) (f : Cell[C, x, y, h2, h3]) :
  Id (Id (Hom C x y) h1 h3) (H.transH (read h1 h2 e) (read h2 h3 f)) (read h1 h3 (join h1 h2 h3 e f)) =
  HomEqCalc.HE-trans C h1 (hmor h2) e.arrow (hdom h2) (hcod h2) e.left e.right
   (hmor h3) f.arrow (hdom h3) (hcod h3) f.left f.right ;

 module Ends (m : Mor C) (p : Id (Ob C) (dom m) x) (q : Id (Ob C) (cod m) y) {
  cell (p1 : Id (Ob C) (dom m) x) (q1 : Id (Ob C) (cod m) y)
   (ep : Id (Id (Ob C) (dom m) x) p p1) (eq : Id (Id (Ob C) (cod m) y) q q1) : Cell[C, x, y, (m, p, q), (m, p1, q1)] =
   new Cell[C, x, y, (m, p, q), (m, p1, q1), refl m,
    H.transH ep (H.symH (PA.unit-l p1)), H.transH eq (H.symH (PA.unit-l q1))] ;
  form (p1 : Id (Ob C) (dom m) x) (q1 : Id (Ob C) (cod m) y)
   (ep : Id (Id (Ob C) (dom m) x) p p1) (eq : Id (Id (Ob C) (cod m) y) q q1) :
   Id (Id (Hom C x y) (m, p, q) (m, p1, q1)) (Hom-ends C m ep eq) (read (m, p, q) (m, p1, q1) (cell p1 q1 ep eq)) =
   idJ (Id (Ob C) (dom m) x) p (\ p2 ep2 -> (q2 : Id (Ob C) (cod m) y) (eq2 : Id (Id (Ob C) (cod m) y) q q2) ->
    Id (Id (Hom C x y) (m, p, q) (m, p2, q2)) (Hom-ends C m ep2 eq2) (read (m, p, q) (m, p2, q2) (cell p2 q2 ep2 eq2)))
    (\ q2 eq2 -> idJ (Id (Ob C) (cod m) y) q (\ q3 eq3 ->
     Id (Id (Hom C x y) (m, p, q) (m, p, q3)) (Hom-ends C m (refl p) eq3) (read (m, p, q) (m, p, q3) (cell p q3 (refl p) eq3)))
     (H.transH (H.symH (HomEqMap.self C x y (m, p, q)))
      (HomEqHigher.Compare[C, x, y, (m, p, q), (m, p, q)].ends (refl m)
       (H.symH (PA.unit-l p)) (H.transH (refl p) (H.symH (PA.unit-l p)))
       (H.symH (PA.unit-l q)) (H.transH (refl q) (H.symH (PA.unit-l q)))
       (H.symH (PA.unit-l (H.symH (PA.unit-l p)))) (H.symH (PA.unit-l (H.symH (PA.unit-l q)))))) q2 eq2)
    p1 ep q1 eq ;
  reverse (p1 : Id (Ob C) (dom m) x) (q1 : Id (Ob C) (cod m) y)
   (ep : Id (Id (Ob C) (dom m) x) p p1) (eq : Id (Id (Ob C) (cod m) y) q q1) :
   Id (Id (Hom C x y) (m, p1, q1) (m, p, q)) (H.symH (Hom-ends C m ep eq)) (Hom-ends C m (H.symH ep) (H.symH eq)) =
   idJ (Id (Ob C) (dom m) x) p (\ p2 ep2 -> (q2 : Id (Ob C) (cod m) y) (eq2 : Id (Id (Ob C) (cod m) y) q q2) ->
    Id (Id (Hom C x y) (m, p2, q2) (m, p, q)) (H.symH (Hom-ends C m ep2 eq2)) (Hom-ends C m (H.symH ep2) (H.symH eq2)))
    (\ q2 eq2 -> idJ (Id (Ob C) (cod m) y) q (\ q3 eq3 ->
     Id (Id (Hom C x y) (m, p, q3) (m, p, q)) (H.symH (Hom-ends C m (refl p) eq3)) (Hom-ends C m (H.symH (refl p)) (H.symH eq3)))
     (refl (refl (m, p, q))) q2 eq2) p1 ep q1 eq ;
 } ;
} ;

module Coerce (C : Cat) (x y : Ob C) (h1 h2 : Hom C x y) (e : Cell[C, x, y, h1, h2])
 (x1 y1 : Ob C) (p : Id (Ob C) x x1) (q : Id (Ob C) y y1) {
 cell : Cell[C, x1, y1, (Hom-coerce C p q h1), (Hom-coerce C p q h2)] =
  new Cell[C, x1, y1, Hom-coerce C p q h1, Hom-coerce C p q h2, e.arrow,
   HomEqCoerce.append (ccl {One} {I} {C} I0 e.arrow) (hdom h1) (hdom h2) e.left p,
   HomEqCoerce.append (ccl {One} {I} {C} I1 e.arrow) (hcod h1) (hcod h2) e.right q] ;
 form : Id (Id (Hom C x1 y1) (Hom-coerce C p q h1) (Hom-coerce C p q h2))
  (H.apH (Hom-coerce C p q) (At[C, x, y].read h1 h2 e))
  (At[C, x1, y1].read (Hom-coerce C p q h1) (Hom-coerce C p q h2) cell) =
  HomEqCoerce.Coerce[C, x, y, h1, h2, e.arrow, e.left, e.right].naturality x1 p y1 q ;
} ;

module MapCell (A B : Cat) (F : Map A B) (x y : Ob A) (h1 h2 : Hom A x y) (e : Cell[A, x, y, h1, h2]) {
 cell : Cell[B, (Ob-map F x), (Ob-map F y), (Hom-map F x y h1), (Hom-map F x y h2)] =
  new Cell[B, Ob-map F x, Ob-map F y, Hom-map F x y h1, Hom-map F x y h2, ccr {I} {A} {B} F e.arrow,
   HomEqMap.Endpoint[A, B, F, hmor h1, I0].cell (hmor h2) e.arrow x (hdom h1) (hdom h2) e.left,
   HomEqMap.Endpoint[A, B, F, hmor h1, I1].cell (hmor h2) e.arrow y (hcod h1) (hcod h2) e.right] ;
 form : Id (Id (Hom B (Ob-map F x) (Ob-map F y)) (Hom-map F x y h1) (Hom-map F x y h2))
  (H.apH (Hom-map F x y) (At[A, x, y].read h1 h2 e))
  (At[B, Ob-map F x, Ob-map F y].read (Hom-map F x y h1) (Hom-map F x y h2) cell) =
  HomEqMap.MapEq[A, B, F, hmor h1].naturality (hmor h2) e.arrow x y (hdom h1) (hcod h1) (hdom h2) (hcod h2) e.left e.right ;
} ;
