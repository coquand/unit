-- The zero object zobj of D (H4).  Internal level 1 of D for the maps; the
-- paths use the associator.
--   zi T : 0 -> T and zt B : B -> 0, the centres of the contractible
--   Hom (0, T) and Hom (B, 0); zi-eq f : f = zi T and zt-eq g : g = zt B.
--   zmap B T = zt B . zi T : B -> T, the zero map.
--   zero-post B f : zmap B T . f = zmap B T1 for f : T -> T1: the
--   associator, then zi T . f = zi T1 in Hom (0, T1).
--   zi-set, zt-set: the contractible Hom (0, T), Hom (B, 0) are sets.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module CU = FunExtUA[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ;

zi (T : Ob D) : Hom D zobj T = (zero-init T).1 ;
zi-eq {T : Ob D} (f : Hom D zobj T) : Id (Hom D zobj T) f (zi T) = H.symH ((zero-init T).2 f) ;
zt (B : Ob D) : Hom D B zobj = (zero-term B).1 ;
zt-eq {B : Ob D} (g : Hom D B zobj) : Id (Hom D B zobj) g (zt B) = H.symH ((zero-term B).2 g) ;
zmap (B T : Ob D) : Hom D B T = hcomp {D} (zt B) (zi T) ;

zero-post (B : Ob D) {T T1 : Ob D} (f : Hom D T T1) : Id (Hom D B T1) (hcomp {D} (zmap B T) f) (zmap B T1) =
 H.transH (hcomp-assoc D (B, zobj, T, T1, zt B, zi T, f)) (H.apH (\ w -> hcomp {D} (zt B) w) (zi-eq (hcomp {D} (zi T) f))) ;

zi-set (T : Ob D) : Pl.isSet (Hom D zobj T) = FibreAlg.contr-set (Hom D zobj T) (zero-init T) ;
zt-set (B : Ob D) : Pl.isSet (Hom D B zobj) = FibreAlg.contr-set (Hom D B zobj) (zero-term B) ;
