-- The universal property of the copower (H1).  Internal level 1 of D.
--   lift h : Hom (X (x) A) T, the inverse of restrict at h : X -> Hom A T.
--   lift-beta: eta_x (lift h) = h x, the section equation at x.
--   ext: two maps out of X (x) A are equal when they agree after every
--   eta_x, since restrict is an equivalence (injective) and their
--   restrictions are equal by function extensionality.
--   lift is locked after lift-beta.
open Base ;
module H = Paths[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;
open HigherCat ; open Constructions ; open Composition ; open CopowerRestrict ;

lift (X : U k) (A T : Ob D) (h : X -> Hom D A T) : Hom D (tensor X A) T = (tensor-up X A T).sec h ;

lift-beta (X : U k) (A T : Ob D) (h : X -> Hom D A T) (x : X) :
 Id (Hom D A T) (hcomp {D} (eta X A x) (lift X A T h)) (h x) =
 H.apH {X -> Hom D A T} {Hom D A T} (\ f -> f x) ((tensor-up X A T).sec-eq h) ;

opaque lift ;

ext (X : U k) (A T : Ob D) (g g1 : Hom D (tensor X A) T)
 (p : (x : X) -> Id (Hom D A T) (hcomp {D} (eta X A x) g) (hcomp {D} (eta X A x) g1)) :
 Id (Hom D (tensor X A) T) g g1 =
 Equivalences[l].injective (Hom D (tensor X A) T) (X -> Hom D A T) (restrict X A T) (tensor-up X A T) g g1
  (FE.funext X (\ x -> Hom D A T) (restrict X A T g) (restrict X A T g1) p) ;
