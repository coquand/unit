-- The gluing square with the interval in place of Delta 1, and the pushout
-- comparison of PushoutDef as an equivalence for every n (M6, step 3).
-- Level 2.
--        I0
--   One ----> I
--    |        | last-edge n
--  top n      v
--    v       Delta (n+1)
--  Delta n --face n-->
--   Sq-I n commutes by face-top.  It is a retract of Sq n: the corners
--   other than I are fixed, eval-pt-inv : I -> Delta 1 and
--   eval-pt : Delta 1 -> I go back and forth, and the faces commute by
--   ei0, eval-pt-dom-last and lastedge n = last-edge n o eval-pt.  So
--   Sq-I (n+1) is a pushout by Lemma 26 (a retract of a pushout square
--   with posetal corners is one).
--   A cone of Sq-I n is a PushoutPair n with its first two components
--   paired, and the comparison of Sq-I n is the pushout comparison: the
--   paths differ by (p^-1)^-1 = p twice.  Hence pushout-is-equiv: for
--   every n, a : Delta (n+1) -> C |-> (a o face n, a o last-edge n, ...)
--   is an equivalence (n = 0 is pushout-is-equiv-0).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ;
open WildCat ; open HigherCat ; open Constructions ; open UnitIso ; open Interval ; open LastEdge ; open FaceMap ;
open FaceTop ; open PushoutBase ; open PushoutDef ; open PushoutProof ; open Squares ; open GluingSquare ;
open PosetalCore ; open FunIPosetal ; open Lemma26 ;

Sq-I (n : Nat) : Square =
 new Square[One, I, Delta n, Delta (suc n), I0, top n, last-edge n, face n, H.symH (face-top n)] ;

-- the square morphisms Sq-I n -> Sq n -> Sq-I n
id-face {A B : Cat} (f : Map A B) : Id (Map A B) (comp f (idMap A)) (comp (idMap B) f) =
 H.transH (comp-id-r f) (H.symH (comp-id-l f)) ;

to-Sq (n : Nat) : square-morphism[Sq-I n, Sq n] =
 new square-morphism[Sq-I n, Sq n, idMap One, eval-pt-inv, idMap (Delta n), idMap (Delta (suc n)),
  H.transH (comp-id-r v0-Delta1) (H.symH ei0),
  id-face (top n),
  H.transH (composeA {I} {Delta (suc zero)} {I} {Delta (suc n)} (last-edge n) eval-pt eval-pt-inv)
   (H.transH (ccr {I} {I} {Delta (suc n)} (last-edge n) eval-pt-rinv) (id-face {I} {Delta (suc n)} (last-edge n))),
  id-face (face n)] ;

from-Sq (n : Nat) : square-morphism[Sq n, Sq-I n] =
 new square-morphism[Sq n, Sq-I n, idMap One, eval-pt, idMap (Delta n), idMap (Delta (suc n)),
  H.transH (comp-id-r I0) (H.symH eval-pt-dom-last),
  id-face (top n),
  H.symH (comp-id-l (lastedge n)),
  id-face (face n)] ;

Sq-I-retract (n : Nat) : square-retract[Sq-I n, Sq n] =
 new square-retract[Sq-I n, Sq n, to-Sq n, from-Sq n,
  comp-id-l (idMap One), eval-pt-rinv, comp-id-l (idMap (Delta n)), comp-id-l (idMap (Delta (suc n)))] ;

Sq-I-pushout (k : Nat) : is-pushout-square (Sq-I (suc k)) =
 PushoutRetract.Retract[Sq-I (suc k), Sq (suc k), Sq-I-retract (suc k),
  posetal-hom-is-set One I I-posetal,
  posetal-hom-is-set One (Delta (suc k)) (Delta-posetal (suc k)),
  posetal-hom-is-set I (Delta (suc (suc k))) (Delta-posetal (suc (suc k))),
  posetal-hom-is-set (Delta (suc k)) (Delta (suc (suc k))) (Delta-posetal (suc (suc k))),
  posetal-hom-is-set One (Delta (suc (suc k))) (Delta-posetal (suc (suc k))),
  posetal-hom-is-set One (Delta (suc (suc k))) (Delta-posetal (suc (suc k)))]
 .is-pushout-square-retract (lemma26-square k) ;

------------------------------------------------------------------------
-- cones of Sq-I n are pushout pairs

cone-to-pair (n : Nat) (C : Cat) (c : sq-cone (Sq-I n) C) : PushoutPair n C = (c.1.1, c.1.2, c.2) ;

cone-to-pair-equiv (n : Nat) (C : Cat) : Pl.isEquiv (sq-cone (Sq-I n) C) (PushoutPair n C) (cone-to-pair n C) =
 Pl.qinv (sq-cone (Sq-I n) C) (PushoutPair n C) (cone-to-pair n C) (\ t -> ((t.1, t.2.1), t.2.2))
  (\ t -> refl t) (\ c -> refl c) ;

comparison-agree (n : Nat) (C : Cat) (a : Map (Delta (suc n)) C) :
 Id (PushoutPair n C) (cone-to-pair n C (sq-comparison (Sq-I n) C a)) (pushout-comparison n C a) =
 H.apH (\ v -> (comp a (face n), comp a (last-edge n), v))
  (PA.tcong (refl (composeA {One} {Delta n} {Delta (suc n)} {C} a (face n) (top n)))
   (PA.tcong (H.apH (\ q -> ccr {One} {Delta (suc n)} {C} a q) (PA.sym-sym (face-top n)))
    (PA.sym-sym (comp-assoc {One} {I} {Delta (suc n)} {C} a (last-edge n) I0)))) ;

pushout-is-equiv : (n : Nat) (C : Cat) -> Pl.isEquiv (Map (Delta (suc n)) C) (PushoutPair n C) (pushout-comparison n C) = split {
 zero -> pushout-is-equiv-0 ;
 suc k -> \ C -> EL.homotopy (Map (Delta (suc (suc k))) C) (PushoutPair (suc k) C)
   (\ a -> cone-to-pair (suc k) C (sq-comparison (Sq-I (suc k)) C a)) (pushout-comparison (suc k) C)
   (comparison-agree (suc k) C)
   (EL.compose (Map (Delta (suc (suc k))) C) (sq-cone (Sq-I (suc k)) C) (PushoutPair (suc k) C)
     (cone-to-pair (suc k) C) (sq-comparison (Sq-I (suc k)) C) (cone-to-pair-equiv (suc k) C) (Sq-I-pushout k C)) } ;
