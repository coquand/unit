-- A pointed equivalence induces an equivalence of fundamental groups.
-- Its loop map is ap of the equivalence followed by conjugation by
-- the pointing path; both are equivalences. The multiplication law is
-- the existing Pi0Maps.Pointed theorem, for that very same map.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
module PM = Pi0Maps[l] ;

module Loops (Y Z : U l) (y : Y) (z : Z) (e : Pl.Equiv Y Z) (p : Id Z (e.1 y) z) {
 module M = PM.Pointed[Y, Z, y, z, e.1, p] ;
 conj-equiv : Pl.isEquiv (Id Z (e.1 y) (e.1 y)) (Id Z z z) (Conj[l].conj p) =
  EL.compose (Id Z (e.1 y) (e.1 y)) (Id Z (e.1 y) z) (Id Z z z)
   (\ q -> H.transH (H.symH p) q) (\ q -> H.transH q p)
   (SigmaEquiv.pre-comp-path-equiv {Z} {z} {e.1 y} {z} (H.symH p)).2
   (SigmaEquiv.post-comp-path-equiv {Z} {e.1 y} {e.1 y} {z} p).2 ;
 loop-equiv : Pl.isEquiv (Id Y y y) (Id Z z z) M.loop =
  EL.compose (Id Y y y) (Id Z (e.1 y) (e.1 y)) (Id Z z z)
   (Conj[l].conj p) (\ q -> H.apH e.1 q) conj-equiv (EquivAp[l].ap-equiv Y Z e y y) ;
 components : Pl.Equiv Pi0[l].LoopGrp[Y, y].grp.G Pi0[l].LoopGrp[Z, z].grp.G =
  Pi0[l].pi0-equiv (Id Y y y) (Id Z z z) (M.loop, loop-equiv) ;
} ;
