-- Cones over a cospan and the comparison map (Wärn Axiom 13; Agda
-- Category/Pullbacks, first part), stated between the parameters pb,
-- pb-pr1, pb-pr2, pb-comm and the axiom pb-is-equiv of Structure.
--   Cone f g X: maps h : X -> B, k : X -> C with f o h = g o k.
--   pb-comparison u: the legs pr1 o u, pr2 o u, and the square
--   f o (pr1 o u) = (f o pr1) o u = (g o pr2) o u = g o (pr2 o u).
open Base ;
module H = Paths[l] ;
open WildCat ;

Cone {B A C : Cat} (f : Map B A) (g : Map C A) (X : Cat) : U l =
 (h : Map X B) * (k : Map X C) * Id (Map X A) (comp f h) (comp g k) ;

pb-comparison {B A C : Cat} (f : Map B A) (g : Map C A) (X : Cat) (u : Map X (pb f g)) : Cone f g X =
 (comp (pb-pr1 f g) u, comp (pb-pr2 f g) u,
  H.transH (comp-assoc f (pb-pr1 f g) u)
   (H.transH (ccl u (pb-comm f g)) (composeA g (pb-pr2 f g) u))) ;
