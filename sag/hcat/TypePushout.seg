-- Pushouts of types, by their universal property (H3).  No HITs: a
-- commuting square of types is a pushout when maps out of its corner are
-- its cocones.
--   HtpyInd: induction on homotopies.  A homotopy r : be ~ be1 is
--   happly of the path funext r (function extensionality), so a statement
--   about all (be1, r) follows from the case be1 = be, r = refl, by J on
--   funext r.
--   Span.Cocone T: (b, e, th) with b : B -> T, e : E -> T and
--   th c : b (i c) = e (j c), a pointwise homotopy.
--   Span.cocone-eq: (b, e, th) = (b1, e1, th1) from homotopies r : b ~ b1,
--   s : e ~ e1 and, for each c, th c . s (j c) = r (i c) . th1 c.  By
--   homotopy induction on r and s; at r, s = refl the condition is
--   th c = th1 c (unit-l), and funext.
--   TSquare.cocone-map T f = (f o u, f o v, ap f o h); is-pushout: it is an
--   equivalence for every T : U l.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module FE = Axioms[l].FunExtLemmas[fe @l] ;

module HtpyInd (Y Z : U l) (be : Y -> Z) {
 Htpy (be1 : Y -> Z) : U l = (y : Y) -> Id Z (be y) (be1 y) ;
 ind (P : (be1 : Y -> Z) -> Htpy be1 -> U l) (base : P be (\ y -> refl (be y))) (be1 : Y -> Z) (r : Htpy be1) : P be1 r =
  H.substH (P be1) ((fe @l Y (\ y -> Z) be be1).sec-eq r)
   (idJ (Y -> Z) be (\ b1 p1 -> P b1 (Pl.happly Y (\ y -> Z) be b1 p1)) base be1 ((fe @l Y (\ y -> Z) be be1).sec r)) ;
} ;

module Span (B C E : U k) (i : C -> B) (j : C -> E) {
 Cocone (T : U l) : U l = (b : B -> T) * (e : E -> T) * ((c : C) -> Id T (b (i c)) (e (j c))) ;

 cocone-eq (T : U l) (b : B -> T) (e : E -> T) (th : (c : C) -> Id T (b (i c)) (e (j c)))
  (b1 : B -> T) (r : (x : B) -> Id T (b x) (b1 x)) (e1 : E -> T) (s : (y : E) -> Id T (e y) (e1 y))
  (th1 : (c : C) -> Id T (b1 (i c)) (e1 (j c)))
  (sq : (c : C) -> Id (Id T (b (i c)) (e1 (j c))) (H.transH (th c) (s (j c))) (H.transH (r (i c)) (th1 c))) :
  Id (Cocone T) (b, e, th) (b1, e1, th1) =
  HtpyInd[B, T, b].ind (\ b2 r2 -> (e2 : E -> T) (s2 : (y : E) -> Id T (e y) (e2 y)) (th2 : (c : C) -> Id T (b2 (i c)) (e2 (j c)))
     (sq2 : (c : C) -> Id (Id T (b (i c)) (e2 (j c))) (H.transH (th c) (s2 (j c))) (H.transH (r2 (i c)) (th2 c))) ->
     Id (Cocone T) (b, e, th) (b2, e2, th2))
   (\ e2 s2 -> HtpyInd[E, T, e].ind (\ e3 s3 -> (th3 : (c : C) -> Id T (b (i c)) (e3 (j c)))
       (sq3 : (c : C) -> Id (Id T (b (i c)) (e3 (j c))) (H.transH (th c) (s3 (j c))) (H.transH (refl (b (i c))) (th3 c))) ->
       Id (Cocone T) (b, e, th) (b, e3, th3))
     (\ th3 sq3 -> H.apH {(c : C) -> Id T (b (i c)) (e (j c))} {Cocone T} (\ t -> (b, e, t))
       (FE.funext C (\ c -> Id T (b (i c)) (e (j c))) th th3 (\ c -> H.transH (sq3 c) (PA.unit-l (th3 c)))))
     e2 s2)
   b1 r e1 s th1 sq ;
} ;

module TSquare (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X) (h : (c : C) -> Id X (u (i c)) (v (j c))) {
 cocone-map (T : U l) (f : X -> T) : Span[B, C, E, i, j].Cocone T = (\ x -> f (u x), \ y -> f (v y), \ c -> H.apH f (h c)) ;
 is-pushout : U l+ = (T : U l) -> Pl.isEquiv (X -> T) (Span[B, C, E, i, j].Cocone T) (cocone-map T) ;
} ;
