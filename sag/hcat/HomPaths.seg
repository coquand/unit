-- Paths between morphisms with endpoints, and between chains.  Level 1.
--   Ob C is not a set, so a path of Hom C x y is a path of the underlying
--   morphisms together with two 2-cells for the endpoint proofs:
--   Hom-eq: (m1, p1, q1) = (m2, p2, q2) from al : m1 = m2,
--   p1 = (al o I0) . p2 and q1 = (al o I1) . q2  (J on al).
--   Hom-ends: the case al = refl, written without the unit law.
--   subst-HChain-suc: moving a chain along a path of its last vertex
--   moves only the codomain of its last morphism (J).
--   chain-suc-eq: two glued chains (y, c, h), (y1, c1, h1) ending at the
--   same vertex are equal over b : y = y1 when c moved along b is c1 and
--   h with its domain moved along b is h1 (J on b).
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open Chains ;

Hom-ends (C : Cat) {x y : Ob C} (m : Mor C) {p p1 : Id (Ob C) (dom m) x} {q q1 : Id (Ob C) (cod m) y}
 (e1 : Id (Id (Ob C) (dom m) x) p p1) (e2 : Id (Id (Ob C) (cod m) y) q q1) :
 Id (Hom C x y) (m, p, q) (m, p1, q1) =
 H.transH (H.apH {Id (Ob C) (dom m) x} {Hom C x y} (\ u -> (m, u, q)) e1)
  (H.apH {Id (Ob C) (cod m) y} {Hom C x y} (\ v -> (m, p1, v)) e2) ;

Hom-eq (C : Cat) {x y : Ob C} (h1 h2 : Hom C x y) (al : Id (Mor C) (hmor h1) (hmor h2))
 (ep : Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (H.transH (ccl {One} {I} {C} I0 al) (hdom h2)))
 (eq : Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (H.transH (ccl {One} {I} {C} I1 al) (hcod h2))) :
 Id (Hom C x y) h1 h2 =
 idJ (Mor C) (hmor h1) (\ m a -> (p : Id (Ob C) (dom m) x) (q : Id (Ob C) (cod m) y) ->
   Id (Id (Ob C) (dom (hmor h1)) x) (hdom h1) (H.transH (ccl {One} {I} {C} I0 {hmor h1} {m} a) p) ->
   Id (Id (Ob C) (cod (hmor h1)) y) (hcod h1) (H.transH (ccl {One} {I} {C} I1 {hmor h1} {m} a) q) ->
   Id (Hom C x y) h1 (m, p, q))
  (\ p q e1 e2 -> Hom-ends C (hmor h1)
   (H.transH {Id (Ob C) (dom (hmor h1)) x} {hdom h1} {H.transH (refl (dom (hmor h1))) p} {p} e1 (PA.unit-l {Ob C} {dom (hmor h1)} {x} p))
   (H.transH {Id (Ob C) (cod (hmor h1)) y} {hcod h1} {H.transH (refl (cod (hmor h1))) q} {q} e2 (PA.unit-l {Ob C} {cod (hmor h1)} {y} q)))
  (hmor h2) al (hdom h2) (hcod h2) ep eq ;

subst-HChain-suc (C : Cat) (n : Nat) {x x1 : Ob C} (al : Id (Ob C) x x1) (c : HChain C (suc n) x) :
 Id (HChain C (suc n) x1) (H.substH (HChain C (suc n)) al c) (c.1, c.2.1, Hom-coerce C (refl c.1) al c.2.2) =
 idJ (Ob C) x (\ x2 al2 -> Id (HChain C (suc n) x2) (H.substH (HChain C (suc n)) al2 c) (c.1, c.2.1, Hom-coerce C (refl c.1) al2 c.2.2))
  (refl c) x1 al ;

chain-suc-eq (C : Cat) (n : Nat) {X y y1 : Ob C} (b : Id (Ob C) y y1) (c : HChain C n y) (c1 : HChain C n y1)
 (h : Hom C y X) (h1 : Hom C y1 X)
 (ec : Id (HChain C n y1) (H.substH (HChain C n) b c) c1) (eh : Id (Hom C y1 X) (Hom-coerce C b (refl X) h) h1) :
 Id (HChain C (suc n) X) (y, c, h) (y1, c1, h1) =
 idJ (Ob C) y (\ y2 b2 -> (c2 : HChain C n y2) (h2 : Hom C y2 X) ->
   Id (HChain C n y2) (H.substH (HChain C n) b2 c) c2 -> Id (Hom C y2 X) (Hom-coerce C b2 (refl X) h) h2 ->
   Id (HChain C (suc n) X) (y, c, h) (y2, c2, h2))
  (\ c2 h2 ec2 eh2 -> H.transH (H.apH {HChain C n y} {HChain C (suc n) X} (\ u -> (y, u, h)) ec2)
   (H.apH {Hom C y X} {HChain C (suc n) X} (\ v -> (y, c2, v)) eh2))
  y1 b c1 h1 ec eh ;
