-- Excision (H3): the copower sends pushouts of types to pushouts in D.
-- Uses the pentagon of D (hpent, through ExcisionAssoc.rt-assoc).
--   Data: a square of types C -> B, C -> E, u : B -> X, v : E -> X with
--   h c : u (i c) = v (j c), and A : Ob D.  In D: ti = tmap i, tj, tu, tv,
--   and the 2-cell cell : ti tu = tj tv, the inverse of omega at
--     cell-pt c : eta_c (ti tu) = eta_(i c) tu = eta_(u (i c))
--                 = eta_(v (j c)) = eta_(j c) tv = eta_c (tj tv)
--   (restrict-tmap, leg-path c = tmap-beta . ap eta (h c) . tmap-beta^-1);
--   cell-beta: ap (eta_c -) cell = cell-pt c.  cell is locked after it.
--   Theorem (excision): if the square of types is a pushout (targets in
--   U l), the square (ti, tj, tu, tv, cell) is a pushout in D.
-- Proof.  For T : Ob D let H = Hom A T.  psi : Cocone_D(T) -> Cocone(H),
--   (b, e, p) |-> (restrict b, restrict e, theta p),
--   theta p c = rt_i(b)^-1 . (omega p c . rt_j(e)),
-- is an equivalence: theta is omega (an equivalence) followed by pointwise
-- conjugation, and restrict is an equivalence on both legs (change of
-- base).  Then psi o cocone-map_D ~ cocone-map_types o restrict
-- (exc-htpy): the legs agree by restrict-tmap; on the path part, for each
-- c, after omega-ap, the naturality assoc-nat-m and cell-beta, the
-- path theta (cocone-path g) c is core-om of: the associators at
-- (eta_c, ti, tu, g), (eta_c, tj, tv, g), restrict-tmap whiskered by g and
-- leg-path c whiskered by g; rt-assoc (the pentagon) at i and at j, and
-- leg-path c . tmap-beta = tmap-beta . ap eta (h c) (exc-hm), are the
-- three hypotheses of core-alg, whose conclusion is the square needed by
-- cocone-eq.  The right side is an equivalence (tensor-up, then the
-- pushout of types at H), so cocone-map_D is one (cancel-equiv).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ;
open HigherCat ; open Constructions ; open Composition ; open Associativity ; open FibreLemmas ; open SigmaEquiv ;
open CopowerRestrict ; open TensorMap ; open ExcCoreAlg ; open TypePushout ; open DPushout ; open AssocNat ; open ExcisionAssoc ;

module ExcisionOf (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D) {
 BA : Ob D = tensor B A ;
 CA : Ob D = tensor C A ;
 EA : Ob D = tensor E A ;
 XA : Ob D = tensor X A ;
 ti : Hom D CA BA = tmap A {C} {B} i ;
 tj : Hom D CA EA = tmap A {C} {E} j ;
 tu : Hom D BA XA = tmap A {B} {X} u ;
 tv : Hom D EA XA = tmap A {E} {X} v ;

 leg-path (c : C) : Id (Hom D A XA) (hcomp {D} (eta B A (i c)) tu) (hcomp {D} (eta E A (j c)) tv) =
  H.transH (tmap-beta A {B} {X} u (i c)) (H.transH (H.apH (eta X A) (h c)) (H.symH (tmap-beta A {E} {X} v (j c)))) ;

 cell-pt (c : C) : Id (Hom D A XA) (hcomp {D} (eta C A c) (hcomp {D} ti tu)) (hcomp {D} (eta C A c) (hcomp {D} tj tv)) =
  H.transH (restrict-tmap A XA {C} {B} i tu c) (H.transH (leg-path c) (H.symH (restrict-tmap A XA {C} {E} j tv c))) ;

 cell : Id (Hom D CA XA) (hcomp {D} ti tu) (hcomp {D} tj tv) = (omega-equiv C A XA (hcomp {D} ti tu) (hcomp {D} tj tv)).sec cell-pt ;

 cell-beta (c : C) : Id (Id (Hom D A XA) (hcomp {D} (eta C A c) (hcomp {D} ti tu)) (hcomp {D} (eta C A c) (hcomp {D} tj tv)))
  (H.apH (\ w -> hcomp {D} (eta C A c) w) cell) (cell-pt c) =
  omega-sec-pt C A XA (hcomp {D} ti tu) (hcomp {D} tj tv) cell-pt c ;

 opaque cell ;

 module DSq = DSquare[CA, BA, EA, XA, ti, tj, tu, tv, cell] ;
 module TSp = Span[B, C, E, i, j] ;
 module TSq = TSquare[B, C, E, X, i, j, u, v, h] ;

 ------------------------------------------------------------------------
 -- psi : D-cocones -> cocones of types

 Leg (T : Ob D) (be : B -> Hom D A T) (ee : E -> Hom D A T) : U l = (c : C) -> Id (Hom D A T) (be (i c)) (ee (j c)) ;

 theta-of (T : Ob D) (b : Hom D BA T) (e : Hom D EA T) (p : Id (Hom D CA T) (hcomp {D} ti b) (hcomp {D} tj e)) :
  Leg T (restrict B A T b) (restrict E A T e) = \ c ->
  H.transH (H.symH (restrict-tmap A T {C} {B} i b c))
   (H.transH (omega C A T (hcomp {D} ti b) (hcomp {D} tj e) p c) (restrict-tmap A T {C} {E} j e c)) ;

 theta-equiv (T : Ob D) (b : Hom D BA T) (e : Hom D EA T) :
  Pl.isEquiv (Id (Hom D CA T) (hcomp {D} ti b) (hcomp {D} tj e)) (Leg T (restrict B A T b) (restrict E A T e)) (theta-of T b e) =
  EL.compose (Id (Hom D CA T) (hcomp {D} ti b) (hcomp {D} tj e))
   ((c : C) -> Id (Hom D A T) (hcomp {D} (eta C A c) (hcomp {D} ti b)) (hcomp {D} (eta C A c) (hcomp {D} tj e)))
   (Leg T (restrict B A T b) (restrict E A T e))
   (\ ph c -> H.transH (H.symH (restrict-tmap A T {C} {B} i b c)) (H.transH (ph c) (restrict-tmap A T {C} {E} j e c)))
   (omega C A T (hcomp {D} ti b) (hcomp {D} tj e))
   (conj-pi-equiv C (Hom D A T) (\ c -> hcomp {D} (eta C A c) (hcomp {D} ti b)) (\ c -> hcomp {D} (eta B A (i c)) b)
     (\ c -> hcomp {D} (eta C A c) (hcomp {D} tj e)) (\ c -> hcomp {D} (eta E A (j c)) e)
     (\ c -> restrict-tmap A T {C} {B} i b c) (\ c -> restrict-tmap A T {C} {E} j e c))
   (omega-equiv C A T (hcomp {D} ti b) (hcomp {D} tj e)) ;

 psi (T : Ob D) (w : DSq.Cocone T) : TSp.Cocone (Hom D A T) =
  (restrict B A T w.1, restrict E A T w.2.1, theta-of T w.1 w.2.1 w.2.2) ;

 -- three equivalences: theta on the paths, then restrict on the legs
 psi1 (T : Ob D) : Pl.Equiv (DSq.Cocone T) ((b : Hom D BA T) * (e : Hom D EA T) * Leg T (restrict B A T b) (restrict E A T e)) =
  Sigma-fiberwise-equiv (Hom D BA T) (\ b -> (e : Hom D EA T) * Id (Hom D CA T) (hcomp {D} ti b) (hcomp {D} tj e))
   (\ b -> (e : Hom D EA T) * Leg T (restrict B A T b) (restrict E A T e))
   (\ b -> Sigma-fiberwise-equiv (Hom D EA T) (\ e -> Id (Hom D CA T) (hcomp {D} ti b) (hcomp {D} tj e))
     (\ e -> Leg T (restrict B A T b) (restrict E A T e)) (\ e -> (theta-of T b e, theta-equiv T b e))) ;

 psi2 (T : Ob D) : Pl.Equiv ((b : Hom D BA T) * (e : Hom D EA T) * Leg T (restrict B A T b) (restrict E A T e))
  ((b : Hom D BA T) * (ee : E -> Hom D A T) * Leg T (restrict B A T b) ee) =
  Sigma-fiberwise-equiv (Hom D BA T) (\ b -> (e : Hom D EA T) * Leg T (restrict B A T b) (restrict E A T e))
   (\ b -> (ee : E -> Hom D A T) * Leg T (restrict B A T b) ee)
   (\ b -> Sigma-change-of-base (Hom D EA T) (E -> Hom D A T) (\ ee -> Leg T (restrict B A T b) ee) (restrict E A T, tensor-up E A T)) ;

 psi3 (T : Ob D) : Pl.Equiv ((b : Hom D BA T) * (ee : E -> Hom D A T) * Leg T (restrict B A T b) ee) (TSp.Cocone (Hom D A T)) =
  Sigma-change-of-base (Hom D BA T) (B -> Hom D A T) (\ be -> (ee : E -> Hom D A T) * Leg T be ee) (restrict B A T, tensor-up B A T) ;

 psi-equiv (T : Ob D) : Pl.isEquiv (DSq.Cocone T) (TSp.Cocone (Hom D A T)) (psi T) =
  EL.homotopy (DSq.Cocone T) (TSp.Cocone (Hom D A T)) (EL.then (DSq.Cocone T) _ (TSp.Cocone (Hom D A T)) (EL.then (DSq.Cocone T) _ _ (psi1 T) (psi2 T)) (psi3 T)).1 (psi T)
   (\ w -> refl (psi T w)) (EL.then (DSq.Cocone T) _ (TSp.Cocone (Hom D A T)) (EL.then (DSq.Cocone T) _ _ (psi1 T) (psi2 T)) (psi3 T)).2 ;

 ------------------------------------------------------------------------
 -- the comparison at a map g out of X (x) A

 module At (T : Ob D) (g : Hom D XA T) (c : C) {
  eg (w : Hom D A XA) : Hom D A T = hcomp {D} w g ;
  ec (w : Hom D CA T) : Hom D A T = hcomp {D} (eta C A c) w ;
  Ai : Id (Hom D A T) (hcomp {D} (eta C A c) (hcomp {D} (hcomp {D} ti tu) g)) (hcomp {D} (eta C A c) (hcomp {D} ti (hcomp {D} tu g))) =
   H.apH ec (hcomp-assoc D (CA, BA, XA, T, ti, tu, g)) ;
  Bi : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta C A c) (hcomp {D} ti tu)) g) (hcomp {D} (eta C A c) (hcomp {D} (hcomp {D} ti tu) g)) =
   hcomp-assoc D (A, CA, XA, T, eta C A c, hcomp {D} ti tu, g) ;
  Ri : Id (Hom D A T) (hcomp {D} (eta C A c) (hcomp {D} ti (hcomp {D} tu g))) (hcomp {D} (eta B A (i c)) (hcomp {D} tu g)) =
   restrict-tmap A T {C} {B} i (hcomp {D} tu g) c ;
  Si : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta C A c) (hcomp {D} ti tu)) g) (hcomp {D} (hcomp {D} (eta B A (i c)) tu) g) =
   H.apH eg (restrict-tmap A XA {C} {B} i tu c) ;
  Gi : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta B A (i c)) tu) g) (hcomp {D} (eta B A (i c)) (hcomp {D} tu g)) =
   hcomp-assoc D (A, BA, XA, T, eta B A (i c), tu, g) ;
  Aj : Id (Hom D A T) (hcomp {D} (eta C A c) (hcomp {D} (hcomp {D} tj tv) g)) (hcomp {D} (eta C A c) (hcomp {D} tj (hcomp {D} tv g))) =
   H.apH ec (hcomp-assoc D (CA, EA, XA, T, tj, tv, g)) ;
  Bj : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta C A c) (hcomp {D} tj tv)) g) (hcomp {D} (eta C A c) (hcomp {D} (hcomp {D} tj tv) g)) =
   hcomp-assoc D (A, CA, XA, T, eta C A c, hcomp {D} tj tv, g) ;
  Rj : Id (Hom D A T) (hcomp {D} (eta C A c) (hcomp {D} tj (hcomp {D} tv g))) (hcomp {D} (eta E A (j c)) (hcomp {D} tv g)) =
   restrict-tmap A T {C} {E} j (hcomp {D} tv g) c ;
  Sj : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta C A c) (hcomp {D} tj tv)) g) (hcomp {D} (hcomp {D} (eta E A (j c)) tv) g) =
   H.apH eg (restrict-tmap A XA {C} {E} j tv c) ;
  Gj : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta E A (j c)) tv) g) (hcomp {D} (eta E A (j c)) (hcomp {D} tv g)) =
   hcomp-assoc D (A, EA, XA, T, eta E A (j c), tv, g) ;
  Mg : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta B A (i c)) tu) g) (hcomp {D} (hcomp {D} (eta E A (j c)) tv) g) =
   H.apH eg (leg-path c) ;
  Tu : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta B A (i c)) tu) g) (hcomp {D} (eta X A (u (i c))) g) =
   H.apH eg (tmap-beta A {B} {X} u (i c)) ;
  Tv : Id (Hom D A T) (hcomp {D} (hcomp {D} (eta E A (j c)) tv) g) (hcomp {D} (eta X A (v (j c))) g) =
   H.apH eg (tmap-beta A {E} {X} v (j c)) ;
  Hc : Id (Hom D A T) (hcomp {D} (eta X A (u (i c))) g) (hcomp {D} (eta X A (v (j c))) g) =
   H.apH (restrict X A T g) (h c) ;

  hi : Id (Id (Hom D A T) (hcomp {D} (hcomp {D} (eta C A c) (hcomp {D} ti tu)) g) (hcomp {D} (eta B A (i c)) (hcomp {D} tu g)))
   (H.transH Bi (H.transH Ai Ri)) (H.transH Si Gi) = RtAssoc[A, C, B, i, c, XA, T, tu, g].rt-assoc ;
  hj : Id (Id (Hom D A T) (hcomp {D} (hcomp {D} (eta C A c) (hcomp {D} tj tv)) g) (hcomp {D} (eta E A (j c)) (hcomp {D} tv g)))
   (H.transH Bj (H.transH Aj Rj)) (H.transH Sj Gj) = RtAssoc[A, C, E, j, c, XA, T, tv, g].rt-assoc ;

  -- leg-path c . tmap-beta = tmap-beta . ap eta (h c), whiskered by g
  leg-eq : Id (Id (Hom D A XA) (hcomp {D} (eta B A (i c)) tu) (eta X A (v (j c))))
   (H.transH (leg-path c) (tmap-beta A {E} {X} v (j c))) (H.transH (tmap-beta A {B} {X} u (i c)) (H.apH (eta X A) (h c))) =
   H.transH (PA.tassoc (tmap-beta A {B} {X} u (i c)) (H.transH (H.apH (eta X A) (h c)) (H.symH (tmap-beta A {E} {X} v (j c)))) (tmap-beta A {E} {X} v (j c)))
    (H.apH (\ r -> H.transH (tmap-beta A {B} {X} u (i c)) r)
     (H.transH (PA.tassoc (H.apH (eta X A) (h c)) (H.symH (tmap-beta A {E} {X} v (j c))) (tmap-beta A {E} {X} v (j c)))
      (H.apH (\ r -> H.transH (H.apH (eta X A) (h c)) r) (PA.inv-l (tmap-beta A {E} {X} v (j c)))))) ;

  hm : Id (Id (Hom D A T) (hcomp {D} (hcomp {D} (eta B A (i c)) tu) g) (hcomp {D} (eta X A (v (j c))) g))
   (H.transH Mg Tv) (H.transH Tu Hc) =
   calc (Id (Hom D A T) (hcomp {D} (hcomp {D} (eta B A (i c)) tu) g) (hcomp {D} (eta X A (v (j c))) g)) {
    H.transH Mg Tv
    =< H.symH (PA.ap-trans eg (leg-path c) (tmap-beta A {E} {X} v (j c))) > H.apH eg (H.transH (leg-path c) (tmap-beta A {E} {X} v (j c)))
    =< H.apH (\ r -> H.apH eg r) leg-eq > H.apH eg (H.transH (tmap-beta A {B} {X} u (i c)) (H.apH (eta X A) (h c)))
    =< PA.ap-trans eg (tmap-beta A {B} {X} u (i c)) (H.apH (eta X A) (h c)) > H.transH Tu (H.apH eg (H.apH (eta X A) (h c)))
    =< H.apH (\ r -> H.transH Tu r) (PA.ap-comp eg (eta X A) (h c)) > H.transH Tu Hc } ;

  -- omega of the D-cocone path, in the form of core-om
  om-expand : Id (Id (Hom D A T) (hcomp {D} (eta C A c) (hcomp {D} ti (hcomp {D} tu g))) (hcomp {D} (eta C A c) (hcomp {D} tj (hcomp {D} tv g))))
   (omega C A T (hcomp {D} ti (hcomp {D} tu g)) (hcomp {D} tj (hcomp {D} tv g)) (DSq.cocone-path T g) c)
   (core-om (Hom D A T) Ai Bi Si Mg Sj Bj Aj) =
   calc (Id (Hom D A T) (hcomp {D} (eta C A c) (hcomp {D} ti (hcomp {D} tu g))) (hcomp {D} (eta C A c) (hcomp {D} tj (hcomp {D} tv g)))) {
    omega C A T (hcomp {D} ti (hcomp {D} tu g)) (hcomp {D} tj (hcomp {D} tv g)) (DSq.cocone-path T g) c
    =< omega-ap C A T (hcomp {D} ti (hcomp {D} tu g)) (hcomp {D} tj (hcomp {D} tv g)) (DSq.cocone-path T g) c >
      H.apH ec (DSq.cocone-path T g)
    =< PA.ap-trans ec (H.symH (hcomp-assoc D (CA, BA, XA, T, ti, tu, g))) (H.transH (H.apH (\ w -> hcomp {D} w g) cell) (hcomp-assoc D (CA, EA, XA, T, tj, tv, g))) >
      H.transH (H.apH ec (H.symH (hcomp-assoc D (CA, BA, XA, T, ti, tu, g)))) (H.apH ec (H.transH (H.apH (\ w -> hcomp {D} w g) cell) (hcomp-assoc D (CA, EA, XA, T, tj, tv, g))))
    =< PA.tcong (PA.ap-sym ec (hcomp-assoc D (CA, BA, XA, T, ti, tu, g))) (PA.ap-trans ec (H.apH (\ w -> hcomp {D} w g) cell) (hcomp-assoc D (CA, EA, XA, T, tj, tv, g))) >
      H.transH (H.symH Ai) (H.transH (H.apH ec (H.apH (\ w -> hcomp {D} w g) cell)) Aj)
    =< H.apH (\ r -> H.transH (H.symH Ai) (H.transH r Aj)) (assoc-nat-m D (eta C A c) (hcomp {D} ti tu) (hcomp {D} tj tv) cell g) >
      H.transH (H.symH Ai) (H.transH (H.transH (H.symH Bi) (H.transH (H.apH eg (H.apH (\ w -> hcomp {D} (eta C A c) w) cell)) Bj)) Aj)
    =< H.apH (\ r -> H.transH (H.symH Ai) (H.transH (H.transH (H.symH Bi) (H.transH (H.apH eg r) Bj)) Aj)) (cell-beta c) >
      H.transH (H.symH Ai) (H.transH (H.transH (H.symH Bi) (H.transH (H.apH eg (cell-pt c)) Bj)) Aj)
    =< H.apH (\ r -> H.transH (H.symH Ai) (H.transH (H.transH (H.symH Bi) (H.transH r Bj)) Aj))
        (H.transH (PA.ap-trans eg (restrict-tmap A XA {C} {B} i tu c) (H.transH (leg-path c) (H.symH (restrict-tmap A XA {C} {E} j tv c))))
         (H.apH (\ r -> H.transH Si r) (H.transH (PA.ap-trans eg (leg-path c) (H.symH (restrict-tmap A XA {C} {E} j tv c)))
           (H.apH (\ r -> H.transH Mg r) (PA.ap-sym eg (restrict-tmap A XA {C} {E} j tv c)))))) >
      core-om (Hom D A T) Ai Bi Si Mg Sj Bj Aj } ;

  square : Id (Id (Hom D A T) (hcomp {D} (eta B A (i c)) (hcomp {D} tu g)) (hcomp {D} (eta X A (v (j c))) g))
   (H.transH (theta-of T (hcomp {D} tu g) (hcomp {D} tv g) (DSq.cocone-path T g) c) (restrict-tmap A T {E} {X} v g (j c)))
   (H.transH (restrict-tmap A T {B} {X} u g (i c)) Hc) =
   H.transH (H.apH (\ r -> H.transH (H.transH (H.symH Ri) (H.transH r Rj)) (H.transH (H.symH Gj) Tv)) om-expand)
    (core-alg Ai Bi Ri Si Gi hi Aj Bj Rj Sj Gj hj Mg Tu Tv Hc hm) ;
 } ;

 exc-htpy (T : Ob D) (g : Hom D XA T) :
  Id (TSp.Cocone (Hom D A T)) (psi T (DSq.cocone-map T g)) (TSq.cocone-map (Hom D A T) (restrict X A T g)) =
  TSp.cocone-eq (Hom D A T) (restrict B A T (hcomp {D} tu g)) (restrict E A T (hcomp {D} tv g))
   (theta-of T (hcomp {D} tu g) (hcomp {D} tv g) (DSq.cocone-path T g))
   (\ x -> restrict X A T g (u x)) (\ x -> restrict-tmap A T {B} {X} u g x)
   (\ y -> restrict X A T g (v y)) (\ y -> restrict-tmap A T {E} {X} v g y)
   (\ c -> H.apH (restrict X A T g) (h c)) (\ c -> At[T, g, c].square) ;

 excision (po : TSq.is-pushout) : DSq.is-pushout = \ T ->
  cancel-equiv (Hom D XA T) (DSq.Cocone T) (TSp.Cocone (Hom D A T)) (DSq.cocone-map T) (psi T) (psi-equiv T)
   (EL.homotopy (Hom D XA T) (TSp.Cocone (Hom D A T)) (\ g -> TSq.cocone-map (Hom D A T) (restrict X A T g))
     (\ g -> psi T (DSq.cocone-map T g)) (\ g -> H.symH (exc-htpy T g))
     (EL.compose (Hom D XA T) (X -> Hom D A T) (TSp.Cocone (Hom D A T)) (TSq.cocone-map (Hom D A T)) (restrict X A T)
       (po (Hom D A T)) (tensor-up X A T))) ;
} ;
