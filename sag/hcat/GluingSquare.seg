-- The gluing square of Lemma 26 (Agda Squares/SquareGeom, first part):
--        v0           Delta 1
--   One ------->        |
--    |                  | lastedge n = last-edge n o eval-pt
--  top n                v
--    v                  
--  Delta n --face n--> Delta (n+1)
-- It commutes: lastedge n (v0) = last-edge n (eval-pt v0) = last-edge n (I0)
-- = dom (last-edge n) = face n (top n) (eval-pt-dom-last, face-top).
open Base ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open UnitIso ;
open Interval ; open LastEdge ; open FaceMap ; open FaceTop ; open PushoutBase ; open Squares ;

v0-Delta1 : Map One (Delta (suc zero)) = dom (last-edge zero) ;

lastedge (n : Nat) : Map (Delta (suc zero)) (Delta (suc n)) = comp {Delta (suc zero)} {I} {Delta (suc n)} (last-edge n) eval-pt ;

square-commutes (n : Nat) : Id (Map One (Delta (suc n))) (comp (lastedge n) v0-Delta1) (comp (face n) (top n)) =
 H.transH (composeA {One} {Delta (suc zero)} {I} {Delta (suc n)} (last-edge n) eval-pt v0-Delta1)
 (H.transH (ccr {One} {I} {Delta (suc n)} (last-edge n) eval-pt-dom-last) (H.symH (face-top n))) ;

Sq (n : Nat) : Square =
 new Square[One, Delta (suc zero), Delta n, Delta (suc n), v0-Delta1, top n, lastedge n, face n, square-commutes n] ;
