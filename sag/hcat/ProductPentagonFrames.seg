-- Frames: the tools for the product pentagon (Agda Category/Product
-- §4d-§4f, reorganised).  A 2-cell into a product is compared with a
-- reduced cell through FRAMES: for u : Z -> P, a frame is a path from
-- pi o u to a composite of the maps of the base.  A square for a cell
-- x : u = v with frames F (of v) and G (of u) is  (pi o x) . F = G.
--   sq-sym, sq-cons: squares invert, and compose along a chain
--     (pi o (x . y)) . F = (pi o x) . ((pi o y) . F).
--   frame N w: for N : pi' o p = q o pi and w : Z -> Y, the frame
--     pi' (p w) = (pi' p) w = (q pi) w = q (pi w) of p o w.
--   frame-whisker: for b : w = w', a square
--     (pi' o (p o b)) . frame N w' = frame N w . (q o (pi o b))   (J on b).
--   leg-frame: the leg of pmc followed by the frame of its target is the
--     projection cell followed by the reassociator; a groupoid identity
--     (gl, by J on the four cancelling cells).
--   key: (a(q2,q1,pi) o p) . a(q2, q1 pi, p) . (q2 o a(q1, pi, p)) . (q2 o (q1 o N))
--     = a(q2 q1, pi, p) . ((q2 q1) o N) . a(q2, q1, q0 pi0):
--     the pentagon at (q2, q1, pi, p) and the naturality of a in its
--     third argument.
--   assoc-frame: the projection of the reassociator a(pk, pg, ph) is a
--     square between the frame of (pk pg) ph (through the frame of pk pg)
--     and the frame of pk (pg ph) (through the frame of pg ph): the
--     pentagons at (pi, pk, pg, ph) and (k, pi2, pg, ph), and the
--     naturality of a in its first and second arguments.
--   pme1-l/pme2-l/pme1-r/pme2-r: the projections of product-map-eq1/2
--     (J): pi1 sees the first argument, pi2 the second.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open Naturality ; open Pullbacks ; open ProductMap ;

-- groupoid tools
canc-r2 {A : U l} {x y z : A} (a : Id A x y) (q : Id A x z) :
 Id (Id A x z) (H.transH a (H.transH (H.symH a) q)) q =
 idJ A x (\ y1 a1 -> Id (Id A x z) (H.transH a1 (H.transH (H.symH a1) q)) q)
  (H.transH (PA.unit-l (H.transH (refl x) q)) (PA.unit-l q)) y a ;

sq-sym {A : U l} {a b t : A} (x : Id A a b) {f : Id A b t} {g : Id A a t}
 (e : Id (Id A a t) (H.transH x f) g) : Id (Id A b t) (H.transH (H.symH x) g) f =
 H.transH (H.apH (\ z -> H.transH (H.symH x) z) (H.symH e)) (PA.canc-l x f) ;

solve-l {A : U l} {a b t : A} (u : Id A a b) {x : Id A b t} {w : Id A a t}
 (e : Id (Id A a t) (H.transH u x) w) : Id (Id A b t) x (H.transH (H.symH u) w) =
 H.transH (H.symH (PA.canc-l u x)) (H.apH (\ z -> H.transH (H.symH u) z) e) ;

sq-cons {A B : U l} (phi : A -> B) {a b c : A} (x : Id A a b) (y : Id A b c) {t : B}
 {f : Id B (phi c) t} {g : Id B (phi b) t} {k : Id B (phi a) t}
 (s1 : Id (Id B (phi b) t) (H.transH (H.apH phi y) f) g) (s2 : Id (Id B (phi a) t) (H.transH (H.apH phi x) g) k) :
 Id (Id B (phi a) t) (H.transH (H.apH phi (H.transH x y)) f) k =
 H.transH (H.apH (\ z -> H.transH z f) (PA.ap-trans phi x y))
  (H.transH (PA.tassoc (H.apH phi x) (H.apH phi y) f)
   (H.transH (H.apH (\ z -> H.transH (H.apH phi x) z) s1) s2)) ;

sq-inv {A B : U l} (phi : A -> B) {a b : A} (x : Id A a b) {t : B}
 {f : Id B (phi b) t} {g : Id B (phi a) t}
 (e : Id (Id B (phi a) t) (H.transH (H.apH phi x) f) g) : Id (Id B (phi b) t) (H.transH (H.apH phi (H.symH x)) g) f =
 H.transH (H.apH (\ z -> H.transH z g) (PA.ap-sym phi x)) (sq-sym (H.apH phi x) e) ;

-- frames
frame {Z Y Y1 E E1 : Cat} {pr1 : Map Y1 E1} {p : Map Y Y1} {q : Map E E1} {pr : Map Y E}
 (n : Id (Map Y E1) (comp pr1 p) (comp q pr)) (w : Map Z Y) :
 Id (Map Z E1) (comp pr1 (comp p w)) (comp q (comp pr w)) =
 H.transH (H.symH (composeA pr1 p w)) (H.transH (ccl w n) (composeA q pr w)) ;

frame-whisker {Z Y Y1 E E1 : Cat} {pr1 : Map Y1 E1} {p : Map Y Y1} {q : Map E E1} {pr : Map Y E}
 (n : Id (Map Y E1) (comp pr1 p) (comp q pr)) {w w1 : Map Z Y} (b : Id (Map Z Y) w w1) :
 Id (Id (Map Z E1) (comp pr1 (comp p w)) (comp q (comp pr w1)))
  (H.transH (ccr pr1 (ccr p b)) (frame n w1)) (H.transH (frame n w) (ccr q (ccr pr b))) =
 idJ (Map Z Y) w (\ w2 b2 -> Id (Id (Map Z E1) (comp pr1 (comp p w)) (comp q (comp pr w2)))
   (H.transH (ccr pr1 (ccr p b2)) (frame n w2)) (H.transH (frame n w) (ccr q (ccr pr b2))))
  (PA.unit-l (frame n w)) w1 b ;

-- the cancellation in leg-frame, by J on x, d, c, b
gl {A : U l} {u v w y z m m1 : A} (n : Id A m m1) (a : Id A m1 z) (x : Id A u v) (b : Id A u w) (c : Id A w y) (d : Id A y z) :
 Id (Id A m z)
  (H.transH (H.transH n (H.transH a (H.transH (H.symH d) (H.transH (H.symH c) (H.transH (H.symH b) x)))))
            (H.transH (H.transH (H.symH x) (H.transH b c)) d))
  (H.transH n a) =
 idJ A u (\ v1 x1 -> Id (Id A m z)
   (H.transH (H.transH n (H.transH a (H.transH (H.symH d) (H.transH (H.symH c) (H.transH (H.symH b) x1)))))
             (H.transH (H.transH (H.symH x1) (H.transH b c)) d))
   (H.transH n a))
  (idJ A y (\ z1 d1 -> (a1 : Id A m1 z1) -> Id (Id A m z1)
     (H.transH (H.transH n (H.transH a1 (H.transH (H.symH d1) (H.transH (H.symH c) (H.transH (H.symH b) (refl u))))))
               (H.transH (H.transH (H.symH (refl u)) (H.transH b c)) d1))
     (H.transH n a1))
   (idJ A w (\ y1 c1 -> (a1 : Id A m1 y1) -> Id (Id A m y1)
      (H.transH (H.transH n (H.transH a1 (H.transH (H.symH (refl y1)) (H.transH (H.symH c1) (H.transH (H.symH b) (refl u))))))
                (H.transH (H.transH (H.symH (refl u)) (H.transH b c1)) (refl y1)))
      (H.transH n a1))
    (idJ A u (\ w1 b1 -> (a1 : Id A m1 w1) -> Id (Id A m w1)
       (H.transH (H.transH n (H.transH a1 (H.transH (H.symH (refl w1)) (H.transH (H.symH (refl w1)) (H.transH (H.symH b1) (refl u))))))
                 (H.transH (H.transH (H.symH (refl u)) (H.transH b1 (refl w1))) (refl w1)))
       (H.transH n a1))
     (\ a1 -> refl (H.transH n a1)) w b)
    y c)
   z d a)
  v x ;

leg {P1 P2 P3 E1 E2 E3 : Cat} {pi3 : Map P3 E3} {pp2 : Map P2 P3} {pp1 : Map P1 P2} {pi2 : Map P2 E2} {pi1 : Map P1 E1}
 {q2 : Map E2 E3} {q1 : Map E1 E2} {xm : Map P1 P3}
 (n12 : Id (Map P1 E3) (comp pi3 xm) (comp (comp q2 q1) pi1)) (n1 : Id (Map P1 E2) (comp pi2 pp1) (comp q1 pi1))
 (n2 : Id (Map P2 E3) (comp pi3 pp2) (comp q2 pi2)) : Id (Map P1 E3) (comp pi3 xm) (comp pi3 (comp pp2 pp1)) =
 H.transH n12 (H.transH (composeA q2 q1 pi1) (H.transH (ccr q2 (H.symH n1))
  (H.transH (H.symH (composeA q2 pi2 pp1)) (H.transH (ccl pp1 (H.symH n2)) (composeA pi3 pp2 pp1))))) ;

leg-frame {P1 P2 P3 E1 E2 E3 : Cat} {pi3 : Map P3 E3} {pp2 : Map P2 P3} {pp1 : Map P1 P2} {pi2 : Map P2 E2} {pi1 : Map P1 E1}
 {q2 : Map E2 E3} {q1 : Map E1 E2} {xm : Map P1 P3}
 (n12 : Id (Map P1 E3) (comp pi3 xm) (comp (comp q2 q1) pi1)) (n1 : Id (Map P1 E2) (comp pi2 pp1) (comp q1 pi1))
 (n2 : Id (Map P2 E3) (comp pi3 pp2) (comp q2 pi2)) :
 Id (Id (Map P1 E3) (comp pi3 xm) (comp q2 (comp q1 pi1)))
  (H.transH (leg n12 n1 n2) (H.transH (frame n2 pp1) (ccr q2 n1))) (H.transH n12 (composeA q2 q1 pi1)) =
 H.transH
  (H.apH (\ t -> H.transH (H.transH n12 (H.transH (composeA q2 q1 pi1) (H.transH t
      (H.transH (H.symH (composeA q2 pi2 pp1)) (H.transH (ccl pp1 (H.symH n2)) (composeA pi3 pp2 pp1))))))
     (H.transH (frame n2 pp1) (ccr q2 n1)))
   (PA.ap-sym (\ m -> comp q2 m) n1))
 (H.transH
  (H.apH (\ t -> H.transH (H.transH n12 (H.transH (composeA q2 q1 pi1) (H.transH (H.symH (ccr q2 n1))
      (H.transH (H.symH (composeA q2 pi2 pp1)) (H.transH t (composeA pi3 pp2 pp1))))))
     (H.transH (frame n2 pp1) (ccr q2 n1)))
   (PA.ap-sym (\ m -> comp m pp1) n2))
  (gl n12 (composeA q2 q1 pi1) (composeA pi3 pp2 pp1) (ccl pp1 n2) (composeA q2 pi2 pp1) (ccr q2 n1))) ;

-- the pentagon and naturality in the third argument, at a frame cell
key {Z Y E0 E1 E2 E3 : Cat} (q2 : Map E2 E3) (q1 : Map E1 E2) {pm : Map Y E1} {p : Map Z Y} {q0 : Map E0 E1} {pm0 : Map Z E0}
 (n : Id (Map Z E1) (comp pm p) (comp q0 pm0)) :
 Id (Id (Map Z E3) (comp (comp (comp q2 q1) pm) p) (comp q2 (comp q1 (comp q0 pm0))))
  (H.transH (ccl p (composeA q2 q1 pm)) (H.transH (composeA q2 (comp q1 pm) p)
   (H.transH (ccr q2 (composeA q1 pm p)) (ccr q2 (ccr q1 n)))))
  (H.transH (composeA (comp q2 q1) pm p) (H.transH (ccr (comp q2 q1) n) (composeA q2 q1 (comp q0 pm0)))) =
 H.symH
 (H.transH (H.apH (\ z -> H.transH (composeA (comp q2 q1) pm p) z) (H.symH (compose-naturality3 q2 q1 n)))
 (H.transH (H.symH (PA.tassoc (composeA (comp q2 q1) pm p) (composeA q2 q1 (comp pm p)) (ccr q2 (ccr q1 n))))
 (H.transH (H.apH (\ z -> H.transH z (ccr q2 (ccr q1 n))) (pentagonator q2 q1 pm p))
 (H.transH (PA.tassoc (H.transH (ccl p (composeA q2 q1 pm)) (composeA q2 (comp q1 pm) p)) (ccr q2 (composeA q1 pm p)) (ccr q2 (ccr q1 n)))
  (PA.tassoc (ccl p (composeA q2 q1 pm)) (composeA q2 (comp q1 pm) p)
   (H.transH (ccr q2 (composeA q1 pm p)) (ccr q2 (ccr q1 n)))))))) ;

-- the projections of product-map-eq1/2
pme1-l {A B X Y : Cat} {f f1 : Map A B} (j : Map X Y) (al : Id (Map A B) f f1) :
 Id (Id (Map (times A X) B) (comp (pi1 B Y) (product-map f j)) (comp f1 (pi1 A X)))
  (H.transH (ccr (pi1 B Y) (product-map-eq1 j al)) (injl-product-map f1 j))
  (H.transH (injl-product-map f j) (ccl (pi1 A X) al)) =
 idJ (Map A B) f (\ f2 al2 -> Id (Id (Map (times A X) B) (comp (pi1 B Y) (product-map f j)) (comp f2 (pi1 A X)))
   (H.transH (ccr (pi1 B Y) (product-map-eq1 j al2)) (injl-product-map f2 j))
   (H.transH (injl-product-map f j) (ccl (pi1 A X) al2)))
  (PA.unit-l (injl-product-map f j)) f1 al ;

pme1-r {A B X Y : Cat} {f f1 : Map A B} (j : Map X Y) (al : Id (Map A B) f f1) :
 Id (Id (Map (times A X) Y) (comp (pi2 B Y) (product-map f j)) (comp j (pi2 A X)))
  (H.transH (ccr (pi2 B Y) (product-map-eq1 j al)) (injr-product-map f1 j)) (injr-product-map f j) =
 idJ (Map A B) f (\ f2 al2 -> Id (Id (Map (times A X) Y) (comp (pi2 B Y) (product-map f j)) (comp j (pi2 A X)))
   (H.transH (ccr (pi2 B Y) (product-map-eq1 j al2)) (injr-product-map f2 j)) (injr-product-map f j))
  (PA.unit-l (injr-product-map f j)) f1 al ;

pme2-l {A B X Y : Cat} (f : Map A B) {j j1 : Map X Y} (b : Id (Map X Y) j j1) :
 Id (Id (Map (times A X) B) (comp (pi1 B Y) (product-map f j)) (comp f (pi1 A X)))
  (H.transH (ccr (pi1 B Y) (product-map-eq2 f b)) (injl-product-map f j1)) (injl-product-map f j) =
 idJ (Map X Y) j (\ j2 b2 -> Id (Id (Map (times A X) B) (comp (pi1 B Y) (product-map f j)) (comp f (pi1 A X)))
   (H.transH (ccr (pi1 B Y) (product-map-eq2 f b2)) (injl-product-map f j2)) (injl-product-map f j))
  (PA.unit-l (injl-product-map f j)) j1 b ;

pme2-r {A B X Y : Cat} (f : Map A B) {j j1 : Map X Y} (b : Id (Map X Y) j j1) :
 Id (Id (Map (times A X) Y) (comp (pi2 B Y) (product-map f j)) (comp j1 (pi2 A X)))
  (H.transH (ccr (pi2 B Y) (product-map-eq2 f b)) (injr-product-map f j1))
  (H.transH (injr-product-map f j) (ccl (pi2 A X) b)) =
 idJ (Map X Y) j (\ j2 b2 -> Id (Id (Map (times A X) Y) (comp (pi2 B Y) (product-map f j)) (comp j2 (pi2 A X)))
   (H.transH (ccr (pi2 B Y) (product-map-eq2 f b2)) (injr-product-map f j2))
   (H.transH (injr-product-map f j) (ccl (pi2 A X) b2)))
  (PA.unit-l (injr-product-map f j)) j1 b ;

-- the frame of p o q through the frames of p and q
frame2 {P0 P1 P2 E0 E1 E2 : Cat} {pr2 : Map P2 E2} {pr1 : Map P1 E1} {pr0 : Map P0 E0}
 {p : Map P1 P2} {q : Map P0 P1} {f : Map E1 E2} {g : Map E0 E1}
 (np : Id (Map P1 E2) (comp pr2 p) (comp f pr1)) (nq : Id (Map P0 E1) (comp pr1 q) (comp g pr0)) :
 Id (Map P0 E2) (comp pr2 (comp p q)) (comp f (comp g pr0)) = H.transH (frame np q) (ccr f nq) ;

-- the frame of (pk pg) ph through the frame of pk pg
frame3 {P0 P1 P2 P3 E0 E1 E2 E3 : Cat} {pD : Map P3 E3} {p2 : Map P2 E2} {p1 : Map P1 E1} {p0 : Map P0 E0}
 {pk : Map P2 P3} {pg : Map P1 P2} {ph : Map P0 P1} {k : Map E2 E3} {g : Map E1 E2} {h : Map E0 E1}
 (lk : Id (Map P2 E3) (comp pD pk) (comp k p2)) (lg : Id (Map P1 E2) (comp p2 pg) (comp g p1))
 (lh : Id (Map P0 E1) (comp p1 ph) (comp h p0)) :
 Id (Map P0 E3) (comp pD (comp (comp pk pg) ph)) (comp k (comp g (comp h p0))) =
 H.transH (H.symH (composeA pD (comp pk pg) ph)) (H.transH (ccl ph (frame2 lk lg))
  (H.transH (composeA k (comp g p1) ph) (H.transH (ccr k (composeA g p1 ph)) (ccr k (ccr g lh))))) ;

assoc-frame {P0 P1 P2 P3 E0 E1 E2 E3 : Cat} {pD : Map P3 E3} {p2 : Map P2 E2} {p1 : Map P1 E1} {p0 : Map P0 E0}
 {pk : Map P2 P3} {pg : Map P1 P2} {ph : Map P0 P1} {k : Map E2 E3} {g : Map E1 E2} {h : Map E0 E1}
 (lk : Id (Map P2 E3) (comp pD pk) (comp k p2)) (lg : Id (Map P1 E2) (comp p2 pg) (comp g p1))
 (lh : Id (Map P0 E1) (comp p1 ph) (comp h p0)) :
 Id (Id (Map P0 E3) (comp pD (comp (comp pk pg) ph)) (comp k (comp g (comp h p0))))
  (H.transH (ccr pD (composeA pk pg ph)) (frame2 lk (frame2 lg lh))) (frame3 lk lg lh) =
 H.transH chainL (H.symH chainR)
 where {
  a1 : Id (Map P1 E3) (comp (comp pD pk) pg) (comp pD (comp pk pg)) = composeA pD pk pg ;
  a2 : Id (Map P0 E3) (comp (comp pD (comp pk pg)) ph) (comp pD (comp (comp pk pg) ph)) = composeA pD (comp pk pg) ph ;
  a3 : Id (Map P0 E3) (comp (comp (comp pD pk) pg) ph) (comp (comp pD pk) (comp pg ph)) = composeA (comp pD pk) pg ph ;
  a4 : Id (Map P0 E3) (comp (comp pD pk) (comp pg ph)) (comp pD (comp pk (comp pg ph))) = composeA pD pk (comp pg ph) ;
  b1 : Id (Map P1 E3) (comp (comp k p2) pg) (comp k (comp p2 pg)) = composeA k p2 pg ;
  b2 : Id (Map P0 E3) (comp (comp k p2) (comp pg ph)) (comp k (comp p2 (comp pg ph))) = composeA k p2 (comp pg ph) ;
  b3 : Id (Map P0 E3) (comp (comp (comp k p2) pg) ph) (comp (comp k p2) (comp pg ph)) = composeA (comp k p2) pg ph ;
  b4 : Id (Map P0 E3) (comp (comp k (comp p2 pg)) ph) (comp k (comp (comp p2 pg) ph)) = composeA k (comp p2 pg) ph ;
  b5 : Id (Map P0 E2) (comp (comp p2 pg) ph) (comp p2 (comp pg ph)) = composeA p2 pg ph ;
  c1 : Id (Map P0 E2) (comp (comp g p1) ph) (comp g (comp p1 ph)) = composeA g p1 ph ;
  d1 : Id (Map P0 E3) (comp (comp k (comp g p1)) ph) (comp k (comp (comp g p1) ph)) = composeA k (comp g p1) ph ;
  r1 : Id (Map P0 E3) (comp k (comp (comp g p1) ph)) (comp k (comp g (comp h p0))) =
   H.transH (ccr k c1) (ccr k (ccr g lh)) ;
  r3 : Id (Map P0 E3) (comp (comp k (comp g p1)) ph) (comp k (comp g (comp h p0))) = H.transH d1 r1 ;
  u : Id (Map P0 E3) (comp (comp (comp pD pk) pg) ph) (comp pD (comp (comp pk pg) ph)) = H.transH (ccl ph a1) a2 ;
  t4 : Id (Map P0 E3) (comp k (comp p2 (comp pg ph))) (comp k (comp g (comp h p0))) = ccr k (frame2 lg lh) ;
  v : Id (Map P0 E3) (comp (comp (comp pD pk) pg) ph) (comp k (comp g (comp h p0))) =
   H.transH (ccl ph (ccl pg lk)) (H.transH (ccl ph b1) (H.transH (ccl ph (ccr k lg)) r3)) ;
  -- the projection of the reassociator, from the pentagon at (pD, pk, pg, ph)
  x4 : Id (Id (Map P0 E3) (comp pD (comp (comp pk pg) ph)) (comp pD (comp pk (comp pg ph))))
   (ccr pD (composeA pk pg ph)) (H.transH (H.symH u) (H.transH a3 a4)) =
   solve-l u (H.symH (pentagonator pD pk pg ph)) ;
  -- b5 followed by the frame of pg ph
  e5 : Id (Id (Map P0 E2) (comp (comp p2 pg) ph) (comp g (comp h p0)))
   (H.transH b5 (frame2 lg lh)) (H.transH (ccl ph lg) (H.transH c1 (ccr g lh))) =
   H.transH (H.apH (\ z -> H.transH b5 z) (PA.tassoc (H.symH b5) (H.transH (ccl ph lg) c1) (ccr g lh)))
   (H.transH (canc-r2 b5 (H.transH (H.transH (ccl ph lg) c1) (ccr g lh)))
    (PA.tassoc (ccl ph lg) c1 (ccr g lh))) ;
  e6 : Id (Id (Map P0 E3) (comp k (comp (comp p2 pg) ph)) (comp k (comp g (comp h p0))))
   (H.transH (ccr k b5) t4) (H.transH (ccr k (ccl ph lg)) r1) =
   H.transH (H.symH (PA.ap-trans (\ m -> comp k m) b5 (frame2 lg lh)))
   (H.transH (H.apH (\ z -> ccr k z) e5)
   (H.transH (PA.ap-trans (\ m -> comp k m) (ccl ph lg) (H.transH c1 (ccr g lh)))
    (H.apH (\ z -> H.transH (ccr k (ccl ph lg)) z) (PA.ap-trans (\ m -> comp k m) c1 (ccr g lh))))) ;
  e7 : Id (Id (Map P0 E3) (comp (comp (comp k p2) pg) ph) (comp k (comp g (comp h p0))))
   (H.transH b3 (H.transH b2 t4)) (H.transH (ccl ph b1) (H.transH (ccl ph (ccr k lg)) r3)) =
   H.transH (H.symH (PA.tassoc b3 b2 t4))
   (H.transH (H.apH (\ z -> H.transH z t4) (pentagonator k p2 pg ph))
   (H.transH (PA.tassoc (H.transH (ccl ph b1) b4) (ccr k b5) t4)
   (H.transH (PA.tassoc (ccl ph b1) b4 (H.transH (ccr k b5) t4))
   (H.apH (\ z -> H.transH (ccl ph b1) z)
    (H.transH (H.apH (\ z -> H.transH b4 z) e6)
    (H.transH (H.symH (PA.tassoc b4 (ccr k (ccl ph lg)) r1))
    (H.transH (H.apH (\ z -> H.transH z r1) (compose-naturality2 k ph lg))
     (PA.tassoc (ccl ph (ccr k lg)) d1 r1)))))))) ;
  -- a3 a4 followed by the frame of pk (pg ph)
  e8 : Id (Id (Map P0 E3) (comp (comp (comp pD pk) pg) ph) (comp k (comp g (comp h p0))))
   (H.transH (H.transH a3 a4) (frame2 lk (frame2 lg lh))) v =
   H.transH (PA.tassoc a3 a4 (frame2 lk (frame2 lg lh)))
   (H.transH (H.apH (\ z -> H.transH a3 z)
     (H.transH (H.apH (\ z -> H.transH a4 z) (PA.tassoc (H.symH a4) (H.transH (ccl (comp pg ph) lk) b2) t4))
     (H.transH (canc-r2 a4 (H.transH (H.transH (ccl (comp pg ph) lk) b2) t4))
      (PA.tassoc (ccl (comp pg ph) lk) b2 t4))))
   (H.transH (H.symH (PA.tassoc a3 (ccl (comp pg ph) lk) (H.transH b2 t4)))
   (H.transH (H.apH (\ z -> H.transH z (H.transH b2 t4)) (compose-naturality1 pg ph lk))
   (H.transH (PA.tassoc (ccl ph (ccl pg lk)) b3 (H.transH b2 t4))
    (H.apH (\ z -> H.transH (ccl ph (ccl pg lk)) z) e7))))) ;
  chainL : Id (Id (Map P0 E3) (comp pD (comp (comp pk pg) ph)) (comp k (comp g (comp h p0))))
   (H.transH (ccr pD (composeA pk pg ph)) (frame2 lk (frame2 lg lh)))
   (H.transH (H.symH a2) (H.transH (H.symH (ccl ph a1)) v)) =
   H.transH (H.apH (\ z -> H.transH z (frame2 lk (frame2 lg lh))) x4)
   (H.transH (PA.tassoc (H.symH u) (H.transH a3 a4) (frame2 lk (frame2 lg lh)))
   (H.transH (H.apH (\ z -> H.transH (H.symH u) z) e8)
   (H.transH (H.apH (\ z -> H.transH z v) (PA.sym-trans (ccl ph a1) a2))
    (PA.tassoc (H.symH a2) (H.symH (ccl ph a1)) v)))) ;
  -- the frame of (pk pg) ph, expanded
  chainR : Id (Id (Map P0 E3) (comp pD (comp (comp pk pg) ph)) (comp k (comp g (comp h p0))))
   (frame3 lk lg lh) (H.transH (H.symH a2) (H.transH (H.symH (ccl ph a1)) v)) =
   H.apH (\ z -> H.transH (H.symH a2) z)
   (H.transH (H.apH (\ z -> H.transH z r3)
     (H.transH (PA.ap-trans (\ m -> comp m ph) (frame lk pg) (ccr k lg))
     (H.transH (H.apH (\ z -> H.transH z (ccl ph (ccr k lg)))
       (H.transH (PA.ap-trans (\ m -> comp m ph) (H.symH a1) (H.transH (ccl pg lk) b1))
       (H.transH (H.apH (\ z -> H.transH z (ccl ph (H.transH (ccl pg lk) b1))) (PA.ap-sym (\ m -> comp m ph) a1))
        (H.apH (\ z -> H.transH (H.symH (ccl ph a1)) z) (PA.ap-trans (\ m -> comp m ph) (ccl pg lk) b1)))))
     (H.transH (PA.tassoc (H.symH (ccl ph a1)) (H.transH (ccl ph (ccl pg lk)) (ccl ph b1)) (ccl ph (ccr k lg)))
      (H.apH (\ z -> H.transH (H.symH (ccl ph a1)) z) (PA.tassoc (ccl ph (ccl pg lk)) (ccl ph b1) (ccl ph (ccr k lg))))))))
   (H.transH (PA.tassoc (H.symH (ccl ph a1)) (H.transH (ccl ph (ccl pg lk)) (H.transH (ccl ph b1) (ccl ph (ccr k lg)))) r3)
   (H.apH (\ z -> H.transH (H.symH (ccl ph a1)) z)
    (H.transH (PA.tassoc (ccl ph (ccl pg lk)) (H.transH (ccl ph b1) (ccl ph (ccr k lg))) r3)
     (H.apH (\ z -> H.transH (ccl ph (ccl pg lk)) z) (PA.tassoc (ccl ph b1) (ccl ph (ccr k lg)) r3)))))) ;
 } ;
