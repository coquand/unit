-- The algebra of square morphisms and cones (Agda Squares/SquareAlg; Rocq
-- Main.v 4180-4540).  Level 1.
--   retract-of-equiv (Rocq isweq_by_retracts): f : B0 -> B1 with sections
--   s_i : B_i -> A and retractions r_i, s1 f = s0 and f r0 = r1, is an
--   equivalence with inverse r0 s1.
--   cg, ce, cc: the parts of a cone.  cone-eq: two cones are equal when
--   their legs are, by pg, pe, and the two squares agree up to them:
--   (l o pg) . cc' = cc . (t o pe)  (J on pg, pe).
--   id-sqm, comp-sqm: identity and composite square morphisms (faces
--   pasted with reassociators).
--   square-morphism-eq: when the four face types are sets, two square
--   morphisms with equal corners are equal (J on the corners, then the
--   faces are equal in sets).
--   sq-apex-pre, sq-cone-pre: a square morphism m : P -> Q acts on maps
--   out of D and on cones by precomposition; the square of the cone
--   (g mC) lP = (g lQ) mA = (e tQ) mA = (e mB) tP is pasted from reC,
--   l o cc, reB.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EA = EquivAp[l] ;
open WildCat ; open Squares ;

retract-of-equiv {A B0 B1 : U l} (s0 : B0 -> A) (s1 : B1 -> A) (r0 : A -> B0) (r1 : A -> B1)
 (ret0 : (b : B0) -> Id B0 (r0 (s0 b)) b) (ret1 : (b : B1) -> Id B1 (r1 (s1 b)) b) (f : B0 -> B1)
 (s1f : (b : B0) -> Id A (s1 (f b)) (s0 b)) (fr0 : (a : A) -> Id B1 (f (r0 a)) (r1 a)) : Pl.isEquiv B0 B1 f =
 Pl.qinv B0 B1 f (\ b1 -> r0 (s1 b1))
  (\ b1 -> H.transH (fr0 (s1 b1)) (ret1 b1))
  (\ b0 -> H.transH (H.apH r0 (s1f b0)) (ret0 b0)) ;

cg (S : Square) (X : Cat) (c : sq-cone S X) : Map S.sqC X = c.1.1 ;
ce (S : Square) (X : Cat) (c : sq-cone S X) : Map S.sqB X = c.1.2 ;
cc (S : Square) (X : Cat) (c : sq-cone S X) : Id (Map S.sqA X) (comp (cg S X c) S.sql) (comp (ce S X c) S.sqt) = c.2 ;

cone-eq-gen (S : Square) (X : Cat) (g : Map S.sqC X) (e : Map S.sqB X) (q : Id (Map S.sqA X) (comp g S.sql) (comp e S.sqt)) :
 (g1 : Map S.sqC X) (pg : Id (Map S.sqC X) g g1) (e1 : Map S.sqB X) (pe : Id (Map S.sqB X) e e1)
 (q1 : Id (Map S.sqA X) (comp g1 S.sql) (comp e1 S.sqt))
 (coh : Id (Id (Map S.sqA X) (comp g S.sql) (comp e1 S.sqt)) (H.transH (ccl S.sql pg) q1) (H.transH q (ccl S.sqt pe))) ->
 Id (sq-cone S X) ((g, e), q) ((g1, e1), q1) =
 \ g1 pg -> idJ (Map S.sqC X) g (\ g2 pg2 -> (e1 : Map S.sqB X) (pe : Id (Map S.sqB X) e e1)
   (q1 : Id (Map S.sqA X) (comp g2 S.sql) (comp e1 S.sqt))
   (coh : Id (Id (Map S.sqA X) (comp g S.sql) (comp e1 S.sqt)) (H.transH (ccl S.sql pg2) q1) (H.transH q (ccl S.sqt pe))) ->
   Id (sq-cone S X) ((g, e), q) ((g2, e1), q1))
  (\ e1 pe -> idJ (Map S.sqB X) e (\ e2 pe2 -> (q1 : Id (Map S.sqA X) (comp g S.sql) (comp e2 S.sqt))
     (coh : Id (Id (Map S.sqA X) (comp g S.sql) (comp e2 S.sqt)) (H.transH (ccl S.sql (refl g)) q1) (H.transH q (ccl S.sqt pe2))) ->
     Id (sq-cone S X) ((g, e), q) ((g, e2), q1))
    (\ q1 coh -> H.apH (\ w -> ((g, e), w)) (H.symH (H.transH (H.symH (PA.unit-l q1)) coh)))
    e1 pe)
  g1 pg ;

cone-eq (S : Square) (X : Cat) (c c1 : sq-cone S X)
 (pg : Id (Map S.sqC X) (cg S X c) (cg S X c1)) (pe : Id (Map S.sqB X) (ce S X c) (ce S X c1))
 (coh : Id (Id (Map S.sqA X) (comp (cg S X c) S.sql) (comp (ce S X c1) S.sqt))
   (H.transH (ccl S.sql pg) (cc S X c1)) (H.transH (cc S X c) (ccl S.sqt pe))) : Id (sq-cone S X) c c1 =
 cone-eq-gen S X c.1.1 c.1.2 c.2 c1.1.1 pg c1.1.2 pe c1.2 coh ;

id-sqm (S : Square) : square-morphism[S, S] =
 new square-morphism[S, S, idMap S.sqA, idMap S.sqB, idMap S.sqC, idMap S.sqD,
  H.transH (comp-id-r S.sqt) (H.symH (comp-id-l S.sqt)),
  H.transH (comp-id-r S.sql) (H.symH (comp-id-l S.sql)),
  H.transH (comp-id-r S.sqr) (H.symH (comp-id-l S.sqr)),
  H.transH (comp-id-r S.sqb) (H.symH (comp-id-l S.sqb))] ;

-- a face of a composite: (x o g) o f = (g' o y) o f = g' o (y o f) = g' o (f' o x') ...
paste-face {A0 A1 A2 B0 B1 B2 : Cat} (x0 : Map A0 B0) (x1 : Map A1 B1) (x2 : Map A2 B2)
 (g : Map A1 A2) (f : Map A0 A1) (g1 : Map B1 B2) (f1 : Map B0 B1)
 (sg : Id (Map A1 B2) (comp x2 g) (comp g1 x1)) (sf : Id (Map A0 B1) (comp x1 f) (comp f1 x0)) :
 Id (Map A0 B2) (comp x2 (comp g f)) (comp (comp g1 f1) x0) =
 H.transH (H.symH (composeA x2 g f))
 (H.transH (ccl f sg)
 (H.transH (composeA g1 x1 f)
 (H.transH (ccr g1 sf) (H.symH (composeA g1 f1 x0))))) ;

comp-sqm {P Q R : Square} (g : square-morphism[Q, R]) (f : square-morphism[P, Q]) : square-morphism[P, R] =
 new square-morphism[P, R, comp g.smA f.smA, comp g.smB f.smB, comp g.smC f.smC, comp g.smD f.smD,
  paste-face P.sqt Q.sqt R.sqt g.smA f.smA g.smB f.smB g.sm-t f.sm-t,
  paste-face P.sql Q.sql R.sql g.smA f.smA g.smC f.smC g.sm-l f.sm-l,
  paste-face P.sqr Q.sqr R.sqr g.smB f.smB g.smD f.smD g.sm-r f.sm-r,
  paste-face P.sqb Q.sqb R.sqb g.smC f.smC g.smD f.smD g.sm-b f.sm-b] ;

-- square morphisms with equal corners are equal when the faces lie in sets
module MorphismEq (P Q : Square)
 (HAB : Pl.isSet (Map P.sqA Q.sqB)) (HAC : Pl.isSet (Map P.sqA Q.sqC))
 (HBD : Pl.isSet (Map P.sqB Q.sqD)) (HCD : Pl.isSet (Map P.sqC Q.sqD)) {
 Corners : U l = Map P.sqA Q.sqA * Map P.sqB Q.sqB * Map P.sqC Q.sqC * Map P.sqD Q.sqD ;
 Faces (k : Corners) : U l =
  Id (Map P.sqA Q.sqB) (comp Q.sqt k.1) (comp k.2.1 P.sqt) *
  Id (Map P.sqA Q.sqC) (comp Q.sql k.1) (comp k.2.2.1 P.sql) *
  Id (Map P.sqB Q.sqD) (comp Q.sqr k.2.1) (comp k.2.2.2 P.sqr) *
  Id (Map P.sqC Q.sqD) (comp Q.sqb k.2.2.1) (comp k.2.2.2 P.sqb) ;
 mk (k : Corners) (F : Faces k) : square-morphism[P, Q] =
  new square-morphism[P, Q, k.1, k.2.1, k.2.2.1, k.2.2.2, F.1, F.2.1, F.2.2.1, F.2.2.2] ;
 faces-eq (k : Corners) (F F1 : Faces k) : Id (Faces k) F F1 =
  EA.pair-path (HAB _ _ F.1 F1.1) (EA.pair-path (HAC _ _ F.2.1 F1.2.1)
   (EA.pair-path (HBD _ _ F.2.2.1 F1.2.2.1) (HCD _ _ F.2.2.2 F1.2.2.2))) ;
 mk-eq (k : Corners) : (k1 : Corners) (p : Id Corners k k1) (F : Faces k) (F1 : Faces k1) ->
  Id (square-morphism[P, Q]) (mk k F) (mk k1 F1) =
  \ k1 p -> idJ Corners k (\ k2 p2 -> (F : Faces k) (F1 : Faces k2) -> Id (square-morphism[P, Q]) (mk k F) (mk k2 F1))
   (\ F F1 -> H.apH (mk k) (faces-eq k F F1)) k1 p ;
 eta : (m : square-morphism[P, Q]) ->
  Id (square-morphism[P, Q]) m (mk (m.smA, m.smB, m.smC, m.smD) (m.sm-t, m.sm-l, m.sm-r, m.sm-b)) = split {
  square-morphism mA mB mC mD mt ml mr mb -> refl (new square-morphism[P, Q, mA, mB, mC, mD, mt, ml, mr, mb]) } ;
 square-morphism-eq (m m1 : square-morphism[P, Q])
  (pA : Id (Map P.sqA Q.sqA) m.smA m1.smA) (pB : Id (Map P.sqB Q.sqB) m.smB m1.smB)
  (pC : Id (Map P.sqC Q.sqC) m.smC m1.smC) (pD : Id (Map P.sqD Q.sqD) m.smD m1.smD) :
  Id (square-morphism[P, Q]) m m1 =
  H.transH (eta m) (H.transH
   (mk-eq (m.smA, m.smB, m.smC, m.smD) (m1.smA, m1.smB, m1.smC, m1.smD)
    (EA.pair-path pA (EA.pair-path pB (EA.pair-path pC pD)))
    (m.sm-t, m.sm-l, m.sm-r, m.sm-b) (m1.sm-t, m1.sm-l, m1.sm-r, m1.sm-b))
   (H.symH (eta m1))) ;
} ;

sq-apex-pre {P Q : Square} (m : square-morphism[P, Q]) (X : Cat) (h : Map Q.sqD X) : Map P.sqD X = comp h m.smD ;

reC {P Q : Square} (m : square-morphism[P, Q]) (X : Cat) (c : sq-cone Q X) :
 Id (Map P.sqA X) (comp (comp (cg Q X c) m.smC) P.sql) (comp (comp (cg Q X c) Q.sql) m.smA) =
 H.transH (composeA (cg Q X c) m.smC P.sql)
  (H.transH (ccr (cg Q X c) (H.symH m.sm-l)) (H.symH (composeA (cg Q X c) Q.sql m.smA))) ;

reB {P Q : Square} (m : square-morphism[P, Q]) (X : Cat) (c : sq-cone Q X) :
 Id (Map P.sqA X) (comp (comp (ce Q X c) Q.sqt) m.smA) (comp (comp (ce Q X c) m.smB) P.sqt) =
 H.transH (composeA (ce Q X c) Q.sqt m.smA)
  (H.transH (ccr (ce Q X c) m.sm-t) (H.symH (composeA (ce Q X c) m.smB P.sqt))) ;

-- the square of the precomposed cone, as one right-nested composite
cone-pre-comm {P Q : Square} (m : square-morphism[P, Q]) (X : Cat) (c : sq-cone Q X) :
 Id (Map P.sqA X) (comp (comp (cg Q X c) m.smC) P.sql) (comp (comp (ce Q X c) m.smB) P.sqt) =
 H.transH (composeA (cg Q X c) m.smC P.sql)
 (H.transH (ccr (cg Q X c) (H.symH m.sm-l))
 (H.transH (H.symH (composeA (cg Q X c) Q.sql m.smA))
 (H.transH (ccl m.smA (cc Q X c))
 (H.transH (composeA (ce Q X c) Q.sqt m.smA)
 (H.transH (ccr (ce Q X c) m.sm-t) (H.symH (composeA (ce Q X c) m.smB P.sqt))))))) ;

cone-pre-comm-split {P Q : Square} (m : square-morphism[P, Q]) (X : Cat) (c : sq-cone Q X) :
 Id (Id (Map P.sqA X) (comp (comp (cg Q X c) m.smC) P.sql) (comp (comp (ce Q X c) m.smB) P.sqt))
  (cone-pre-comm m X c) (H.transH (reC m X c) (H.transH (ccl m.smA (cc Q X c)) (reB m X c))) =
 H.symH (PathMoves[l].flat3 (composeA (cg Q X c) m.smC P.sql) (ccr (cg Q X c) (H.symH m.sm-l))
  (H.symH (composeA (cg Q X c) Q.sql m.smA)) (H.transH (ccl m.smA (cc Q X c)) (reB m X c))) ;

sq-cone-pre {P Q : Square} (m : square-morphism[P, Q]) (X : Cat) (c : sq-cone Q X) : sq-cone P X =
 ((comp (cg Q X c) m.smC, comp (ce Q X c) m.smB), cone-pre-comm m X c) ;
