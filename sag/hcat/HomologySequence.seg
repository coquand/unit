-- The positive-degree Mayer--Vietoris sequence, with one boundary.
-- For every n>=0 it contains
-- H_(n+2)(B)*H_(n+2)(E) -> H_(n+2)(X) -> H_(n+1)(C)
--   -> H_(n+1)(B)*H_(n+1)(E) -> H_(n+1)(X).
-- All arrows are homomorphisms of the existing abelian groups, and
-- all three displayed interior positions are exact. The maps are the
-- usual i_*, j_*, u_*-v_* and HomologyFibre's single connecting map.
-- Source exactness is HomologyFibreSource; target exactness is
-- HomologyFibreLegs; product exactness is MayerVietoris.exact-mid and
-- group cancellation. No new coherence parameter, and no comparison
-- with the old direct boundary. Degree zero and categorical naturality
-- are not asserted by this file.
open Base ;
module H = Paths[l] ; module PM = Pi0Maps[l] ; module AD = AbelianDifference[l] ;
open HigherCat ; open HGroups ;

module Types (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) {
 module Ex = Excision.ExcisionOf[B, C, E, X, i, j, u, v, h, A] ;
 module Degree (n : Nat) {
  module Product = AD.Product[hgrp n B A, hgrp n E A] ;
  product-abelian : Pi0[l].is-abelian Product.grp = Product.abelian (hgrp-ab-stable n B A) (hgrp-ab-stable n E A) ;
  inclusion (c : homology (suc n) C A) : Product.grp.G =
   (HGroupMaps.hmap (suc n) A i c, HGroupMaps.hmap (suc n) A j c) ;
  inclusion-hom : PM.is-hom (hgrp n C A) Product.grp inclusion =
   Product.pair-hom (hgrp n C A) (HGroupMaps.hmap (suc n) A i) (HGroupMaps.hmap (suc n) A j)
    (HGroupMaps.hmap-mul n A i) (HGroupMaps.hmap-mul n A j) ;
  difference (t : Product.grp.G) : homology (suc n) X A =
   PM.diff (hgrp n X A) (HGroupMaps.hmap (suc n) A u t.1) (HGroupMaps.hmap (suc n) A v t.2) ;
  difference-hom : PM.is-hom Product.grp (hgrp n X A) difference =
   AD.At[hgrp n X A].Abelian[hgrp-ab-stable n X A].hom (hgrp n B A) (hgrp n E A)
    (HGroupMaps.hmap (suc n) A u) (HGroupMaps.hmap (suc n) A v)
    (HGroupMaps.hmap-mul n A u) (HGroupMaps.hmap-mul n A v) ;
  module Mid = MayerVietoris.MV[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, Sph (suc n)] ;
  product-zero (c : homology (suc n) C A) : Id (homology (suc n) X A) (difference (inclusion c)) (hgrp n X A).e =
   AD.At[hgrp n X A].zero (Mid.post Ex.tu (Mid.post Ex.ti c)) (Mid.post Ex.tv (Mid.post Ex.tj c)) (Mid.mv-square c) ;
  product-exact (t : Product.grp.G) (p : Id (homology (suc n) X A) (difference t) (hgrp n X A).e) : Mid.Lift0 t.1 t.2 =
   Mid.exact-mid t.1 t.2 (AD.At[hgrp n X A].same (Mid.post Ex.tu t.1) (Mid.post Ex.tv t.2) p) ;
  module Boundary = HomologyFibreExact.Types[B, C, E, X, i, j, u, v, h, A, po, n] ;
  module Source = HomologyFibreSource.Sequence[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, Sph n] ;
 } ;
 -- Explicitly identify the incoming difference with the next degree's
 -- map; this is definitional, so adjacent exact pieces really join.
 adjacent (n : Nat) (t : Degree[suc n].Product.grp.G) :
  Id (homology (suc (suc n)) X A) (Degree[n].Source.difference t.1 t.2) (Degree[suc n].difference t) =
  refl (Degree[suc n].difference t) ;
 source-zero (n : Nat) (t : Degree[suc n].Product.grp.G) :
  Id (homology (suc n) C A) (Degree[n].Boundary.delta (Degree[suc n].difference t)) (hgrp n C A).e =
  Degree[n].Source.zero t.1 t.2 ;
 source-exact (n : Nat) (q : homology (suc (suc n)) X A)
  (p : Id (homology (suc n) C A) (Degree[n].Boundary.delta q) (hgrp n C A).e) : Degree[n].Source.Image q =
  Degree[n].Source.exact q p ;
} ;
