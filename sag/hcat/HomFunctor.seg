-- The action of functors on morphisms with endpoints (Agda
-- Simplices/FullyFaithful, Hom-map-id; M6).  Level 2.
--   Hom-map-of-comp: Hom-map (F o G) h, its endpoints moved by the
--   reassociator, is Hom-map F (Hom-map G h).  By J on the endpoint
--   proofs of h = (m, p, q) it suffices to take p, q = refl.  The
--   morphisms agree by the reassociator a = a(F, G, m), and the domain
--   2-cell is the pentagon at (F, G, m, I0):
--     a(F G, m, I0) . a(F, G, m I0) = ((a o I0) . a(F, G m, I0)) . (F o a(G, m, I0)),
--   the codomain one the pentagon at I1.
--   Hom-map-id (Agda endpt): f maps the identity of a to the identity of
--   f a.  The morphisms agree by funct-pres-id = a(f, a, !)^-1; with
--   M = a(f, a !, I0), N = f o a(a, !, I0), P = a(f a, !, I0),
--   Q = a(f, a, ! I0), T the path ! I0 = 1 in Map One One, the domain
--   2-cell is
--     M . (f o (a(a, !, I0) . (a o T) . r(a)))
--       = (M . N) . ((f o a o T) . (f o r(a)))
--       = (lead . (P . Q)) . ...                 (pentagon at (f, a, !, I0))
--       = lead . (P . (((f a) o T) . a(f, a, 1)) . (f o r(a)))   (naturality)
--       = lead . (P . ((f a) o T) . r(f a))                      (triangle3)
--   with lead = a(f, a, !)^-1 o I0; the codomain at I1 likewise.
--   Hom-map-gen: m maps the generating arrow of I to (m, refl, refl), by
--   r(m) : m 1 = m and triangle2 at (I0, m), (I1, m).
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open IntervalPosetal ;
open Naturality ; open CatCoherence ; open HomPaths ;

Hom-map-of-comp-refl {A B C : Cat} (F : Map B C) (G : Map A B) (m : Mor A) :
 Id (Hom C (Ob-map F (Ob-map G (dom m))) (Ob-map F (Ob-map G (cod m))))
  (Hom-coerce C (composeA {One} {A} {B} {C} F G (dom m)) (composeA {One} {A} {B} {C} F G (cod m))
   (Hom-map (comp F G) (dom m) (cod m) (m, refl (dom m), refl (cod m))))
  (Hom-map F (Ob-map G (dom m)) (Ob-map G (cod m)) (Hom-map G (dom m) (cod m) (m, refl (dom m), refl (cod m)))) =
 Hom-eq C (Hom-coerce C (composeA {One} {A} {B} {C} F G (dom m)) (composeA {One} {A} {B} {C} F G (cod m))
   (Hom-map (comp F G) (dom m) (cod m) (m, refl (dom m), refl (cod m))))
  (Hom-map F (Ob-map G (dom m)) (Ob-map G (cod m)) (Hom-map G (dom m) (cod m) (m, refl (dom m), refl (cod m))))
  (composeA {I} {A} {B} {C} F G m)
  (H.transH (pentagonator {One} {I} {A} {B} {C} F G m I0)
   (PA.tassoc (ccl {One} {I} {C} I0 (composeA {I} {A} {B} {C} F G m)) (composeA {One} {I} {B} {C} F (comp G m) I0)
    (ccr {One} {B} {C} F (composeA {One} {I} {A} {B} G m I0))))
  (H.transH (pentagonator {One} {I} {A} {B} {C} F G m I1)
   (PA.tassoc (ccl {One} {I} {C} I1 (composeA {I} {A} {B} {C} F G m)) (composeA {One} {I} {B} {C} F (comp G m) I1)
    (ccr {One} {B} {C} F (composeA {One} {I} {A} {B} G m I1)))) ;

Hom-map-of-comp {A B C : Cat} (F : Map B C) (G : Map A B) (a0 a1 : Ob A) (h : Hom A a0 a1) :
 Id (Hom C (Ob-map F (Ob-map G a0)) (Ob-map F (Ob-map G a1)))
  (Hom-coerce C (composeA {One} {A} {B} {C} F G a0) (composeA {One} {A} {B} {C} F G a1) (Hom-map (comp F G) a0 a1 h))
  (Hom-map F (Ob-map G a0) (Ob-map G a1) (Hom-map G a0 a1 h)) =
 idJ (Ob A) (dom {A} h.1) (\ b0 p -> (b1 : Ob A) (q : Id (Ob A) (cod {A} h.1) b1) ->
   Id (Hom C (Ob-map F (Ob-map G b0)) (Ob-map F (Ob-map G b1)))
    (Hom-coerce C (composeA {One} {A} {B} {C} F G b0) (composeA {One} {A} {B} {C} F G b1) (Hom-map (comp F G) b0 b1 (h.1, p, q)))
    (Hom-map F (Ob-map G b0) (Ob-map G b1) (Hom-map G b0 b1 (h.1, p, q))))
  (\ b1 q -> idJ (Ob A) (cod {A} h.1) (\ b2 q2 ->
     Id (Hom C (Ob-map F (Ob-map G (dom {A} h.1))) (Ob-map F (Ob-map G b2)))
      (Hom-coerce C (composeA {One} {A} {B} {C} F G (dom {A} h.1)) (composeA {One} {A} {B} {C} F G b2)
       (Hom-map (comp F G) (dom {A} h.1) b2 (h.1, refl (dom {A} h.1), q2)))
      (Hom-map F (Ob-map G (dom {A} h.1)) (Ob-map G b2) (Hom-map G (dom {A} h.1) b2 (h.1, refl (dom {A} h.1), q2))))
    (Hom-map-of-comp-refl F G (h.1)) b1 q)
  a0 h.2.1 a1 h.2.2 ;

------------------------------------------------------------------------
-- functors preserve identities, with endpoints

module EndPt (A B : Cat) (f : Map A B) (a : Ob A) (v : Ob I) {
 T : Id (Map One One) (comp {One} {I} {One} (bang I) v) (idMap One) =
  CU.pathC (Map One One) (terminal One) (comp {One} {I} {One} (bang I) v) (idMap One) ;
 M : Id (Ob B) (comp (comp {I} {A} {B} f (id-mor a)) v) (comp f (comp {One} {I} {A} (id-mor a) v)) =
  composeA {One} {I} {A} {B} f (id-mor a) v ;
 X : Id (Ob A) (comp {One} {I} {A} (id-mor a) v) (comp a (comp {One} {I} {One} (bang I) v)) = composeA {One} {I} {One} {A} a (bang I) v ;
 caT : Id (Ob A) (comp a (comp {One} {I} {One} (bang I) v)) (comp a (idMap One)) = ccr {One} {One} {A} a T ;
 ura : Id (Ob A) (comp a (idMap One)) a = comp-id-r {One} {A} a ;
 N : Id (Ob B) (comp f (comp {One} {I} {A} (id-mor a) v)) (comp f (comp a (comp {One} {I} {One} (bang I) v))) = ccr {One} {A} {B} f X ;
 fcaT : Id (Ob B) (comp f (comp a (comp {One} {I} {One} (bang I) v))) (comp f (comp a (idMap One))) = ccr {One} {A} {B} f caT ;
 fura : Id (Ob B) (comp f (comp a (idMap One))) (comp f a) = ccr {One} {A} {B} f ura ;
 P : Id (Ob B) (comp {One} {I} {B} (id-mor {B} (comp f a)) v) (comp (comp f a) (comp {One} {I} {One} (bang I) v)) =
  composeA {One} {I} {One} {B} (comp f a) (bang I) v ;
 Q : Id (Ob B) (comp (comp f a) (comp {One} {I} {One} (bang I) v)) (comp f (comp a (comp {One} {I} {One} (bang I) v))) =
  composeA {One} {One} {A} {B} f a (comp {One} {I} {One} (bang I) v) ;
 TT : Id (Ob B) (comp (comp f a) (comp {One} {I} {One} (bang I) v)) (comp (comp f a) (idMap One)) = ccr {One} {One} {B} (comp f a) T ;
 R : Id (Ob B) (comp (comp f a) (idMap One)) (comp f (comp a (idMap One))) = composeA {One} {One} {A} {B} f a (idMap One) ;
 Uf : Id (Ob B) (comp (comp f a) (idMap One)) (comp f a) = comp-id-r {One} {B} (comp f a) ;
 lead : Id (Ob B) (comp (comp {I} {A} {B} f (id-mor a)) v) (comp {One} {I} {B} (id-mor {B} (comp f a)) v) =
  ccl {One} {I} {B} v (comp-assoc {I} {One} {A} {B} f a (bang I)) ;
 L1 : Id (Ob B) (comp {One} {I} {B} (id-mor {B} (comp f a)) v) (comp (comp {I} {A} {B} f (id-mor a)) v) =
  ccl {One} {I} {B} v (composeA {I} {One} {A} {B} f a (bang I)) ;
 pent : Id (Id (Ob B) (comp {One} {I} {B} (id-mor {B} (comp f a)) v) (comp f (comp a (comp {One} {I} {One} (bang I) v))))
  (H.transH P Q) (H.transH (H.transH L1 M) N) = pentagonator {One} {I} {One} {A} {B} f a (bang I) v ;
 nat3 : Id (Id (Ob B) (comp (comp f a) (comp {One} {I} {One} (bang I) v)) (comp f (comp a (idMap One))))
  (H.transH Q fcaT) (H.transH TT R) = compose-naturality3 {One} {One} {A} {B} f a T ;
 tri : Id (Id (Ob B) (comp (comp f a) (idMap One)) (comp f a)) (H.transH R fura) Uf = triangle3 {One} {A} {B} a f ;
 lead-L1 : Id (Id (Ob B) (comp (comp {I} {A} {B} f (id-mor a)) v) (comp (comp {I} {A} {B} f (id-mor a)) v)) (H.transH lead L1) (refl (comp (comp {I} {A} {B} f (id-mor a)) v)) =
  H.transH (H.apH (\ r -> H.transH lead r) (PA.ap-sym (\ m -> comp {One} {I} {B} m v) (comp-assoc {I} {One} {A} {B} f a (bang I))))
   (PA.inv-r lead) ;
 mn : Id (Id (Ob B) (comp (comp {I} {A} {B} f (id-mor a)) v) (comp f (comp a (comp {One} {I} {One} (bang I) v))))
  (H.transH M N) (H.transH lead (H.transH P Q)) =
  H.symH (calc (Id (Ob B) (comp (comp {I} {A} {B} f (id-mor a)) v) (comp f (comp a (comp {One} {I} {One} (bang I) v)))) {
   H.transH lead (H.transH P Q)
   =< H.apH (\ r -> H.transH lead r) pent > H.transH lead (H.transH (H.transH L1 M) N)
   =< H.apH (\ r -> H.transH lead r) (PA.tassoc L1 M N) > H.transH lead (H.transH L1 (H.transH M N))
   =< H.symH (PA.tassoc lead L1 (H.transH M N)) > H.transH (H.transH lead L1) (H.transH M N)
   =< H.apH (\ r -> H.transH r (H.transH M N)) lead-L1 > H.transH (refl (comp (comp {I} {A} {B} f (id-mor a)) v)) (H.transH M N)
   =< PA.unit-l (H.transH M N) > H.transH M N }) ;
 tail : Id (Id (Ob B) (comp (comp f a) (comp {One} {I} {One} (bang I) v)) (comp f a))
  (H.transH Q (H.transH fcaT fura)) (H.transH TT Uf) =
  calc (Id (Ob B) (comp (comp f a) (comp {One} {I} {One} (bang I) v)) (comp f a)) {
   H.transH Q (H.transH fcaT fura)
   =< H.symH (PA.tassoc Q fcaT fura) > H.transH (H.transH Q fcaT) fura
   =< H.apH (\ r -> H.transH r fura) nat3 > H.transH (H.transH TT R) fura
   =< PA.tassoc TT R fura > H.transH TT (H.transH R fura)
   =< H.apH (\ r -> H.transH TT r) tri > H.transH TT Uf } ;
 endpt : Id (Id (Ob B) (comp (comp {I} {A} {B} f (id-mor a)) v) (comp f a))
  (H.transH M (ccr {One} {A} {B} f (H.transH X (H.transH caT ura))))
  (H.transH lead (H.transH P (H.transH TT Uf))) =
  calc (Id (Ob B) (comp (comp {I} {A} {B} f (id-mor a)) v) (comp f a)) {
   H.transH M (ccr {One} {A} {B} f (H.transH X (H.transH caT ura)))
   =< H.apH (\ r -> H.transH M r)
       (H.transH (PA.ap-trans (\ m -> comp {One} {A} {B} f m) X (H.transH caT ura))
        (H.apH (\ r -> H.transH N r) (PA.ap-trans (\ m -> comp {One} {A} {B} f m) caT ura))) >
     H.transH M (H.transH N (H.transH fcaT fura))
   =< H.symH (PA.tassoc M N (H.transH fcaT fura)) > H.transH (H.transH M N) (H.transH fcaT fura)
   =< H.apH (\ r -> H.transH r (H.transH fcaT fura)) mn > H.transH (H.transH lead (H.transH P Q)) (H.transH fcaT fura)
   =< PA.tassoc lead (H.transH P Q) (H.transH fcaT fura) > H.transH lead (H.transH (H.transH P Q) (H.transH fcaT fura))
   =< H.apH (\ r -> H.transH lead r) (PA.tassoc P Q (H.transH fcaT fura)) > H.transH lead (H.transH P (H.transH Q (H.transH fcaT fura)))
   =< H.apH (\ r -> H.transH lead (H.transH P r)) tail > H.transH lead (H.transH P (H.transH TT Uf)) } ;
} ;

Hom-map-id {A B : Cat} (f : Map A B) (a : Ob A) :
 Id (Hom B (Ob-map f a) (Ob-map f a)) (Hom-map f a a (id-hom a)) (id-hom (Ob-map f a)) =
 Hom-eq B (Hom-map f a a (id-hom a)) (id-hom (Ob-map f a)) (Segal.funct-pres-id f a)
  EndPt[A, B, f, a, I0].endpt EndPt[A, B, f, a, I1].endpt ;

Hom-map-gen {C : Cat} (m : Mor C) :
 Id (Hom C (dom m) (cod m)) (Hom-map m I0 I1 gen-hom) (m, refl (dom m), refl (cod m)) =
 Hom-eq C (Hom-map m I0 I1 gen-hom) (m, refl (dom m), refl (cod m)) (comp-id-r {I} {C} m)
  (triangle2 {One} {I} {C} I0 m) (triangle2 {One} {I} {C} I1 m) ;
