-- The product pentagon, second half (continues ProductPentagon): the pi2
-- factor and the assembly by prod-path-eq.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open Naturality ; open Pullbacks ; open ProductMap ; open ProductPentagonFrames ; open ProductPentagon ;

-- The pi2 factor.  pi2 o pm(f, j) = j o pi2, so the second components of
-- the maps of the chain are composites of identities, and the frames end
-- at 1 (1 (1 pi2)); the cells changing the second argument now show the
-- unit law (pme2-r), and pm(k g) and pm(g h) are over 1 rather than 1 1,
-- which the frames absorb by  G = (l1^-1 o pi2) . a(1,1,pi2)  and
-- E = (l1^-1 o (1 pi2)) . a(1,1,1 pi2).  In the square of the whiskered
-- pmc, the naturality of a in its first argument at l1^-1 and the
-- interchange (xch) move the unit cell past the projection law of pm h.
-- The image of the reassociator is invisible to pi2 (pme1-r); the two
-- frames then differ by 1 o G against E, which agree by the unit loop of
-- CatCoherence (unit-ge).
module InjrFactor (C0 C1 C2 D C : Cat) (k : Map C2 D) (g : Map C1 C2) (h : Map C0 C1) {
 open Cells[C0, C1, C2, D, C, k, g, h] ;
 rD : Map (times D C) C = pi2 D C ;
 r2 : Map (times C2 C) C = pi2 C2 C ;
 r1 : Map (times C1 C) C = pi2 C1 C ;
 r0 : Map (times C0 C) C = pi2 C0 C ;
 rk : Id (Map (times C2 C) C) (comp rD pk) (comp Ic r2) = injr-product-map k Ic ;
 rg : Id (Map (times C1 C) C) (comp r2 pg) (comp Ic r1) = injr-product-map g Ic ;
 rh : Id (Map (times C0 C) C) (comp r1 ph) (comp Ic r0) = injr-product-map h Ic ;
 rkg : Id (Map (times C1 C) C) (comp rD pkg) (comp Ic r1) = injr-product-map (comp k g) Ic ;
 rgh : Id (Map (times C0 C) C) (comp r2 pgh) (comp Ic r0) = injr-product-map (comp g h) Ic ;
 rkg2 : Id (Map (times C1 C) C) (comp rD (product-map (comp k g) I2)) (comp I2 r1) = injr-product-map (comp k g) I2 ;
 rgh2 : Id (Map (times C0 C) C) (comp r2 (product-map (comp g h) I2)) (comp I2 r0) = injr-product-map (comp g h) I2 ;
 ra1 : Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) Ic)) (comp Ic r0) = injr-product-map (comp (comp k g) h) Ic ;
 ra2 : Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) I2)) (comp I2 r0) = injr-product-map (comp (comp k g) h) I2 ;
 rb1 : Id (Map (times C0 C) C) (comp rD (product-map (comp k (comp g h)) Ic)) (comp Ic r0) = injr-product-map (comp k (comp g h)) Ic ;
 rb2 : Id (Map (times C0 C) C) (comp rD (product-map (comp k (comp g h)) I2)) (comp I2 r0) = injr-product-map (comp k (comp g h)) I2 ;
 ug : Id (Map (times C0 C) C) (comp Ic r0) (comp Ic (comp Ic r0)) = H.transH (ccl r0 (H.symH ul)) (composeA Ic Ic r0) ;
 ue : Id (Map (times C0 C) C) (comp Ic (comp Ic r0)) (comp Ic (comp Ic (comp Ic r0))) =
  H.transH (ccl (comp Ic r0) (H.symH ul)) (composeA Ic Ic (comp Ic r0)) ;
 nb : Id (Map (times C0 C) C) (comp I2 r0) (comp Ic (comp Ic (comp Ic r0))) = H.transH (composeA Ic Ic r0) (ccr Ic ug) ;
 -- 1 o G = E, from the unit loop at pi2
 unit-ge : Id (Id (Map (times C0 C) C) (comp Ic (comp Ic r0)) (comp Ic (comp Ic (comp Ic r0)))) (ccr Ic ug) ue =
  H.transH chain1 (H.symH chain2)
  where {
   aa : Id (Map (times C0 C) C) (comp (comp Ic Ic) (comp Ic r0)) (comp Ic (comp Ic r0)) = ccl (comp Ic r0) ul ;
   bb : Id (Map (times C0 C) C) (comp (comp Ic Ic) (comp Ic r0)) (comp Ic (comp Ic (comp Ic r0))) = composeA Ic Ic (comp Ic r0) ;
   cc : Id (Map (times C0 C) C) (comp Ic (comp (comp Ic Ic) r0)) (comp Ic (comp Ic (comp Ic r0))) = ccr Ic (composeA Ic Ic r0) ;
   dd : Id (Map (times C0 C) C) (comp Ic (comp (comp Ic Ic) r0)) (comp Ic (comp Ic r0)) = ccr Ic (ccl r0 ul) ;
   chain1 : Id (Id (Map (times C0 C) C) (comp Ic (comp Ic r0)) (comp Ic (comp Ic (comp Ic r0)))) (ccr Ic ug) (H.transH (H.symH dd) cc) =
    H.transH (PA.ap-trans (\ m -> comp Ic m) (ccl r0 (H.symH ul)) (composeA Ic Ic r0))
    (H.transH (H.apH (\ z -> H.transH (ccr Ic z) cc) (PA.ap-sym (\ m -> comp m r0) ul))
     (H.apH (\ z -> H.transH z cc) (PA.ap-sym (\ m -> comp Ic m) (ccl r0 ul)))) ;
   loop : Id (Id (Map (times C0 C) C) (comp Ic (comp Ic r0)) (comp Ic (comp Ic r0)))
    (H.transH (H.transH (H.symH aa) bb) (H.transH (H.symH cc) dd)) (refl (comp Ic (comp Ic r0))) =
    H.transH (PA.tassoc (H.symH aa) bb (H.transH (H.symH cc) dd)) (CatCoherence.unit-loop r0) ;
   chain2 : Id (Id (Map (times C0 C) C) (comp Ic (comp Ic r0)) (comp Ic (comp Ic (comp Ic r0)))) ue (H.transH (H.symH dd) cc) =
    H.transH (H.apH (\ z -> H.transH z bb) (PA.ap-sym (\ m -> comp m (comp Ic r0)) ul))
    (H.transH (PA.cancel-r (H.transH (H.symH cc) dd) (H.transH loop (H.symH (PA.inv-l (H.transH (H.symH cc) dd)))))
    (H.transH (PA.sym-trans (H.symH cc) dd)
     (H.apH (\ z -> H.transH (H.symH dd) z) (PA.sym-sym cc)))) ;
  } ;
 -- the frames
 f0 : Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) Ic)) (comp Ic (comp Ic (comp Ic r0))) =
  H.transH ra1 (H.transH (ccl r0 (H.symH ul)) (H.transH (composeA Ic Ic r0) ue)) ;
 f1 : Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) I2)) (comp Ic (comp Ic (comp Ic r0))) =
  H.transH ra2 (H.transH (composeA Ic Ic r0) ue) ;
 f2 : Id (Map (times C0 C) C) (comp rD (comp pkg ph)) (comp Ic (comp Ic (comp Ic r0))) = H.transH (frame2 rkg rh) ue ;
 f3 : Id (Map (times C0 C) C) (comp rD (comp (comp pk pg) ph)) (comp Ic (comp Ic (comp Ic r0))) = frame3 rk rg rh ;
 f4 : Id (Map (times C0 C) C) (comp rD (comp pk (comp pg ph))) (comp Ic (comp Ic (comp Ic r0))) = frame2 rk (frame2 rg rh) ;
 f5 : Id (Map (times C0 C) C) (comp rD (comp pk pgh)) (comp Ic (comp Ic (comp Ic r0))) =
  H.transH (frame rk pgh) (ccr Ic (H.transH rgh ug)) ;
 f6 : Id (Map (times C0 C) C) (comp rD (product-map (comp k (comp g h)) I2)) (comp Ic (comp Ic (comp Ic r0))) = H.transH rb2 nb ;
 f7 : Id (Map (times C0 C) C) (comp rD (product-map (comp k (comp g h)) Ic)) (comp Ic (comp Ic (comp Ic r0))) =
  H.transH rb1 (H.transH (ccl r0 (H.symH ul)) nb) ;
 -- the squares
 s1 : Id (Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) Ic)) (comp Ic (comp Ic (comp Ic r0))))
  (H.transH (ccr rD cp1) f1) f0 =
  H.transH (H.symH (PA.tassoc (ccr rD cp1) ra2 (H.transH (composeA Ic Ic r0) ue)))
  (H.transH (H.apH (\ z -> H.transH z (H.transH (composeA Ic Ic r0) ue)) (pme2-r (comp (comp k g) h) (H.symH ul)))
   (PA.tassoc ra1 (ccl r0 (H.symH ul)) (H.transH (composeA Ic Ic r0) ue))) ;
 s2 : Id (Id (Map (times C0 C) C) (comp rD (product-map (comp (comp k g) h) I2)) (comp Ic (comp Ic (comp Ic r0))))
  (H.transH (ccr rD cp2) f2) f1 =
  H.transH (H.apH (\ z -> H.transH z f2) (pmc-injr h (comp k g) Ic Ic))
  (H.transH (H.symH (PA.tassoc (pmc-legr h (comp k g) Ic Ic) (frame2 rkg rh) ue))
  (H.transH (H.apH (\ z -> H.transH z ue) (leg-frame ra2 rh rkg))
   (PA.tassoc ra2 (composeA Ic Ic r0) ue))) ;
 sy : Id (Id (Map (times C1 C) C) (comp rD pkg) (comp Ic (comp Ic r1))) (H.transH (ccr rD yc) (frame2 rk rg))
  (H.transH rkg (H.transH (ccl r1 (H.symH ul)) (composeA Ic Ic r1))) =
  sq-cons (\ m -> comp rD m) (product-map-eq2 (comp k g) (H.symH ul)) (pmc g k Ic Ic)
   (H.transH (H.apH (\ z -> H.transH z (frame2 rk rg)) (pmc-injr g k Ic Ic)) (leg-frame rkg2 rg rk))
   (H.transH (H.symH (PA.tassoc (ccr rD (product-map-eq2 (comp k g) (H.symH ul))) rkg2 (composeA Ic Ic r1)))
   (H.transH (H.apH (\ z -> H.transH z (composeA Ic Ic r1)) (pme2-r (comp k g) (H.symH ul)))
    (PA.tassoc rkg (ccl r1 (H.symH ul)) (composeA Ic Ic r1)))) ;
 s3 : Id (Id (Map (times C0 C) C) (comp rD (comp pkg ph)) (comp Ic (comp Ic (comp Ic r0)))) (H.transH (ccr rD cp3) f3) f2 =
  H.transH chainL (H.symH chainR)
  where {
   al : Id (Map (times C0 C) C) (comp (comp rD pkg) ph) (comp rD (comp pkg ph)) = composeA rD pkg ph ;
   be : Id (Map (times C0 C) C) (comp (comp rD (comp pk pg)) ph) (comp rD (comp (comp pk pg) ph)) = composeA rD (comp pk pg) ph ;
   al2 : Id (Map (times C0 C) C) (comp (comp Ic r1) ph) (comp Ic (comp r1 ph)) = composeA Ic r1 ph ;
   a3 : Id (Map (times C0 C) C) (comp (comp Ic Ic) (comp Ic r0)) (comp Ic (comp Ic (comp Ic r0))) = composeA Ic Ic (comp Ic r0) ;
   r3 : Id (Map (times C0 C) C) (comp (comp Ic (comp Ic r1)) ph) (comp Ic (comp Ic (comp Ic r0))) =
    H.transH (composeA Ic (comp Ic r1) ph) (H.transH (ccr Ic (composeA Ic r1 ph)) (ccr Ic (ccr Ic rh))) ;
   w : Id (Map (times C0 C) C) (comp (comp rD pkg) ph) (comp (comp rD (comp pk pg)) ph) = ccl ph (ccr rD yc) ;
   u1 : Id (Map (times C0 C) C) (comp (comp Ic r1) ph) (comp (comp (comp Ic Ic) r1) ph) = ccl ph (ccl r1 (H.symH ul)) ;
   x3 : Id (Id (Map (times C0 C) C) (comp rD (comp pkg ph)) (comp rD (comp (comp pk pg) ph)))
    (ccr rD cp3) (H.transH (H.symH al) (H.transH w be)) = solve-l al (compose-naturality2 rD ph yc) ;
   -- the unit cell slides past the projection law of pm h
   slide : Id (Id (Map (times C0 C) C) (comp (comp Ic r1) ph) (comp Ic (comp Ic (comp Ic r0))))
    (H.transH u1 (H.transH (composeA (comp Ic Ic) r1 ph) (H.transH (ccr (comp Ic Ic) rh) a3)))
    (H.transH al2 (H.transH (ccr Ic rh) ue)) =
    H.transH (H.symH (PA.tassoc u1 (composeA (comp Ic Ic) r1 ph) (H.transH (ccr (comp Ic Ic) rh) a3)))
    (H.transH (H.apH (\ z -> H.transH z (H.transH (ccr (comp Ic Ic) rh) a3)) (H.symH (compose-naturality1 r1 ph (H.symH ul))))
    (H.transH (PA.tassoc al2 (ccl (comp r1 ph) (H.symH ul)) (H.transH (ccr (comp Ic Ic) rh) a3))
     (H.apH (\ z -> H.transH al2 z)
      (H.transH (H.symH (PA.tassoc (ccl (comp r1 ph) (H.symH ul)) (ccr (comp Ic Ic) rh) a3))
      (H.transH (H.apH (\ z -> H.transH z a3) (H.symH (xch (H.symH ul) rh)))
       (PA.tassoc (ccr Ic rh) (ccl (comp Ic r0) (H.symH ul)) a3)))))) ;
   chainL : Id (Id (Map (times C0 C) C) (comp rD (comp pkg ph)) (comp Ic (comp Ic (comp Ic r0))))
    (H.transH (ccr rD cp3) f3) (H.transH (H.symH al) (H.transH (ccl ph rkg) (H.transH al2 (H.transH (ccr Ic rh) ue)))) =
    H.transH (H.apH (\ z -> H.transH z f3) x3)
    (H.transH (PA.tassoc (H.symH al) (H.transH w be) f3)
    (H.apH (\ z -> H.transH (H.symH al) z)
     (H.transH (PA.tassoc w be f3)
     (H.transH (H.apH (\ z -> H.transH w z) (canc-r2 be (H.transH (ccl ph (frame2 rk rg)) r3)))
     (H.transH (H.symH (PA.tassoc w (ccl ph (frame2 rk rg)) r3))
     (H.transH (H.apH (\ z -> H.transH z r3) (H.symH (PA.ap-trans (\ m -> comp m ph) (ccr rD yc) (frame2 rk rg))))
     (H.transH (H.apH (\ z -> H.transH (ccl ph z) r3) sy)
     (H.transH (H.apH (\ z -> H.transH z r3) (PA.ap-trans (\ m -> comp m ph) rkg (H.transH (ccl r1 (H.symH ul)) (composeA Ic Ic r1))))
     (H.transH (PA.tassoc (ccl ph rkg) (ccl ph (H.transH (ccl r1 (H.symH ul)) (composeA Ic Ic r1))) r3)
      (H.apH (\ z -> H.transH (ccl ph rkg) z)
       (H.transH (H.apH (\ z -> H.transH z r3) (PA.ap-trans (\ m -> comp m ph) (ccl r1 (H.symH ul)) (composeA Ic Ic r1)))
       (H.transH (PA.tassoc u1 (ccl ph (composeA Ic Ic r1)) r3)
       (H.transH (H.apH (\ z -> H.transH u1 z) (key Ic Ic rh))
        slide))))))))))))) ;
   chainR : Id (Id (Map (times C0 C) C) (comp rD (comp pkg ph)) (comp Ic (comp Ic (comp Ic r0))))
    f2 (H.transH (H.symH al) (H.transH (ccl ph rkg) (H.transH al2 (H.transH (ccr Ic rh) ue)))) =
    H.transH (PA.tassoc (frame rkg ph) (ccr Ic rh) ue)
    (H.transH (PA.tassoc (H.symH al) (H.transH (ccl ph rkg) al2) (H.transH (ccr Ic rh) ue))
     (H.apH (\ z -> H.transH (H.symH al) z) (PA.tassoc (ccl ph rkg) al2 (H.transH (ccr Ic rh) ue)))) ;
  } ;
} ;
