-- Precomposition of cones with the identity square morphism (Agda
-- Squares/ConeUnit; Rocq unit_leg, sq_cone_pre_id).  Level 2: the
-- triangles triangle2 and triangle3.
--   unit-leg: for f : D -> E, k : C -> D, with a = a(f, 1, k),
--   b = a(f, k, 1), Yk = r(k) . l(k)^-1 (the face of the identity
--   morphism):  k-whiskered r(f) = (a . (f o Yk^-1 . b^-1)) . r(f k).
--   By triangle2, a . (f o l k) = r(f) o k; by triangle3,
--   b . (f o r k) = r(f k); and f o Yk^-1 = (f o l k) . (f o r k)^-1.  So the
--   right side is (a . ((f o l k) . (f o r k)^-1 . b^-1)) . (b . (f o r k)) =
--   a . (f o l k).
--   sq-cone-pre-id: precomposing a cone (g, e, gam) with the identity gives
--   back the cone: the legs by r(g), r(e); the squares by unit-leg at
--   (g, l) (this is reC), naturality of r at gam, and unit-leg at (e, t)
--   read backwards (reB is the inverse of its bracket).
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open Naturality ; open CatCoherence ; open Squares ; open SquareAlg ;

-- (a . (P . Q^-1 . b^-1)) . (b . Q) = a . P
zig {A : U l} {x y z v : A} (a : Id A x y) (P : Id A y z) : (w : A) (b : Id A v w) (Q : Id A w z) ->
 Id (Id A x z) (H.transH (H.transH a (H.transH (H.transH P (H.symH Q)) (H.symH b))) (H.transH b Q)) (H.transH a P) =
 \ w b -> idJ A v (\ w1 b1 -> (Q : Id A w1 z) ->
   Id (Id A x z) (H.transH (H.transH a (H.transH (H.transH P (H.symH Q)) (H.symH b1))) (H.transH b1 Q)) (H.transH a P))
  (\ Q -> idJ A v (\ z1 Q1 -> (P1 : Id A y z1) ->
     Id (Id A x z1) (H.transH (H.transH a (H.transH (H.transH P1 (H.symH Q1)) (refl v))) (H.transH (refl v) Q1)) (H.transH a P1))
    (\ P1 -> refl (H.transH a P1)) z Q P)
  w b ;

-- (b . (y . a^-1)) . (a . (y^-1 . b^-1)) = refl
zz {A : U l} {p q r s : A} (b : Id A p q) : (y : Id A q r) (a : Id A s r) ->
 Id (Id A p p) (H.transH (H.transH b (H.transH y (H.symH a))) (H.transH a (H.transH (H.symH y) (H.symH b)))) (refl p) =
 idJ A p (\ q1 b1 -> (y : Id A q1 r) (a : Id A s r) ->
   Id (Id A p p) (H.transH (H.transH b1 (H.transH y (H.symH a))) (H.transH a (H.transH (H.symH y) (H.symH b1)))) (refl p))
  (\ y a -> idJ A s (\ r1 a1 -> (y1 : Id A p r1) ->
     Id (Id A p p) (H.transH (H.transH (refl p) (H.transH y1 (H.symH a1))) (H.transH a1 (H.transH (H.symH y1) (refl p)))) (refl p))
    (\ y1 -> idJ A p (\ s1 y2 ->
       Id (Id A p p) (H.transH (H.transH (refl p) (H.transH y2 (refl s1))) (H.transH (refl s1) (H.transH (H.symH y2) (refl p)))) (refl p))
      (refl (refl p)) s y1)
    r a y)
  q b ;

-- the face of the identity square morphism at k
id-face {C D : Cat} (k : Map C D) : Id (Map C D) (comp k (idMap C)) (comp (idMap D) k) =
 H.transH (comp-id-r k) (H.symH (comp-id-l k)) ;

unit-leg {C D E : Cat} (f : Map D E) (k : Map C D) :
 Id (Id (Map C E) (comp (comp f (idMap D)) k) (comp f k))
  (ccl k (comp-id-r f))
  (H.transH (H.transH (composeA f (idMap D) k) (H.transH (ccr f (H.symH (id-face k))) (H.symH (composeA f k (idMap C)))))
   (comp-id-r (comp f k))) =
 H.symH (H.transH (H.apH (\ z -> H.transH (H.transH (composeA f (idMap D) k) (H.transH z (H.symH (composeA f k (idMap C)))))
                                   (comp-id-r (comp f k))) stepA)
  (H.transH (H.apH (\ z -> H.transH (H.transH (composeA f (idMap D) k)
                     (H.transH (H.transH (ccr f (comp-id-l k)) (H.symH (ccr f (comp-id-r k)))) (H.symH (composeA f k (idMap C))))) z)
              (H.symH (triangle3 k f)))
   (H.transH (zig (composeA f (idMap D) k) (ccr f (comp-id-l k)) (comp f (comp k (idMap C))) (composeA f k (idMap C)) (ccr f (comp-id-r k)))
    (triangle2 k f))))
 where {
  stepA : Id (Id (Map C E) (comp f (comp (idMap D) k)) (comp f (comp k (idMap C))))
   (ccr f (H.symH (id-face k))) (H.transH (ccr f (comp-id-l k)) (H.symH (ccr f (comp-id-r k)))) =
   H.transH (H.apH (\ p -> ccr f p)
     (H.transH (PA.sym-trans (comp-id-r k) (H.symH (comp-id-l k)))
      (H.apH (\ z -> H.transH z (H.symH (comp-id-r k))) (PA.sym-sym (comp-id-l k)))))
    (H.transH (PA.ap-trans (\ m -> comp f m) (comp-id-l k) (H.symH (comp-id-r k)))
     (H.apH (\ z -> H.transH (ccr f (comp-id-l k)) z) (PA.ap-sym (\ m -> comp f m) (comp-id-r k)))) ;
 } ;

sq-cone-pre-id (S : Square) (X : Cat) (c : sq-cone S X) : Id (sq-cone S X) (sq-cone-pre (id-sqm S) X c) c =
 cone-eq S X (sq-cone-pre (id-sqm S) X c) c (comp-id-r (cg S X c)) (comp-id-r (ce S X c))
  (H.transH (H.apH (\ z -> H.transH z (cc S X c)) (unit-leg (cg S X c) S.sql))
  (H.transH (PA.tassoc rc u1 (cc S X c))
  (H.transH (H.apH (\ z -> H.transH rc z) (IdKr-nat (cc S X c)))
  (H.transH (H.apH (\ z -> H.transH rc (H.transH (ccl (idMap S.sqA) (cc S X c)) z)) reBidm)
  (H.transH (H.apH (\ z -> H.transH rc z) (H.symH (PA.tassoc (ccl (idMap S.sqA) (cc S X c)) rb rr)))
  (H.transH (H.symH (PA.tassoc rc (H.transH (ccl (idMap S.sqA) (cc S X c)) rb) rr))
   (H.apH (\ z -> H.transH z rr) (H.symH (cone-pre-comm-split (id-sqm S) X c)))))))))
 where {
  rc : Id (Map S.sqA X) (comp (comp (cg S X c) (idMap S.sqC)) S.sql) (comp (comp (cg S X c) S.sql) (idMap S.sqA)) =
   reC (id-sqm S) X c ;
  rb : Id (Map S.sqA X) (comp (comp (ce S X c) S.sqt) (idMap S.sqA)) (comp (comp (ce S X c) (idMap S.sqB)) S.sqt) =
   reB (id-sqm S) X c ;
  u1 : Id (Map S.sqA X) (comp (comp (cg S X c) S.sql) (idMap S.sqA)) (comp (cg S X c) S.sql) = comp-id-r (comp (cg S X c) S.sql) ;
  u2 : Id (Map S.sqA X) (comp (comp (ce S X c) S.sqt) (idMap S.sqA)) (comp (ce S X c) S.sqt) = comp-id-r (comp (ce S X c) S.sqt) ;
  rr : Id (Map S.sqA X) (comp (comp (ce S X c) (idMap S.sqB)) S.sqt) (comp (ce S X c) S.sqt) = ccl S.sqt (comp-id-r (ce S X c)) ;
  fb : Id (Map S.sqA X) (comp (comp (ce S X c) (idMap S.sqB)) S.sqt) (comp (comp (ce S X c) S.sqt) (idMap S.sqA)) =
   H.transH (composeA (ce S X c) (idMap S.sqB) S.sqt)
    (H.transH (ccr (ce S X c) (H.symH (id-face S.sqt))) (H.symH (composeA (ce S X c) S.sqt (idMap S.sqA)))) ;
  rb-fb : Id (Id (Map S.sqA X) (comp (comp (ce S X c) S.sqt) (idMap S.sqA)) (comp (comp (ce S X c) S.sqt) (idMap S.sqA)))
   (H.transH rb fb) (refl (comp (comp (ce S X c) S.sqt) (idMap S.sqA))) =
   H.transH (H.apH (\ v -> H.transH rb (H.transH (composeA (ce S X c) (idMap S.sqB) S.sqt) (H.transH v (H.symH (composeA (ce S X c) S.sqt (idMap S.sqA))))))
     (PA.ap-sym (\ m -> comp (ce S X c) m) (id-face S.sqt)))
    (zz (composeA (ce S X c) S.sqt (idMap S.sqA)) (ccr (ce S X c) (id-face S.sqt)) (composeA (ce S X c) (idMap S.sqB) S.sqt)) ;
  reBidm : Id (Id (Map S.sqA X) (comp (comp (ce S X c) S.sqt) (idMap S.sqA)) (comp (ce S X c) S.sqt)) u2 (H.transH rb rr) =
   H.symH (H.transH (H.apH (\ z -> H.transH rb z) (unit-leg (ce S X c) S.sqt))
    (H.transH (H.symH (PA.tassoc rb fb u2))
     (H.transH (H.apH (\ z -> H.transH z u2) rb-fb) (PA.unit-l u2)))) ;
 } ;
