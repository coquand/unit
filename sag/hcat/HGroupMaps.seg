-- Maps on homology and positive-degree homomorphisms, under hpent.
-- Postcomposition is a pointed map by zero-post. L-nat identifies its
-- action through L with the induced loop map. Pi0Maps transports this
-- homomorphism to exactly the group chosen in HGroups.LoopGroup.
-- For maps of types, use postcomposition with tmap. Identity and
-- composition follow on representatives from the laws of tmap and
-- hcomp, and then by quotient induction. These are laws of functions
-- between sets: no compatibility between the L-nat proof terms is used.
open Base ;
module H = Paths[l] ; module PM = Pi0Maps[l] ;
open HigherCat ; open Constructions ; open Composition ; open CompLaws ; open Associativity ;
open Zero ; open Loops ; open HGroups ; open TensorMap ; open Pi0[l] ;

module Post (B E E1 : Ob D) (f : Hom D E E1) {
 module P = PM.Pointed[Hom D B E, Hom D B E1, zmap B E, zmap B E1,
  \ w -> hcomp {D} w f, zero-post B f] ;
 map : LoopGroup[B, E].grp.G -> LoopGroup[B, E1].grp.G =
  pi0-map (Hom D (susp B) E) (Hom D (susp B) E1) (\ w -> hcomp {D} w f) ;
 square (x : LoopGroup[B, E].grp.G) :
  Id (LoopGrp[Hom D B E1, zmap B E1].grp.G)
   (LoopGroup[B, E1].e.1 (map x)) (P.M.map (LoopGroup[B, E].e.1 x)) =
  PM.square (Hom D (susp B) E) (Hom D (susp B) E1) (LoopOf[B].Om E) (LoopOf[B].Om E1)
   (\ w -> hcomp {D} w f) P.loop (LoopOf[B].L E) (LoopOf[B].L E1)
   (\ w -> LoopOf[B].L-nat E E1 w f) x ;
 mul : PM.is-hom LoopGroup[B, E].grp LoopGroup[B, E1].grp map =
  PM.Transport[LoopGrp[Hom D B E, zmap B E].grp, LoopGrp[Hom D B E1, zmap B E1].grp,
   pi0 (Hom D (susp B) E), pi0 (Hom D (susp B) E1), LoopGroup[B, E].e, LoopGroup[B, E1].e,
   map, P.M.map, P.M.mul, square].mul ;
 one : Id LoopGroup[B, E1].grp.G (map LoopGroup[B, E].grp.e) LoopGroup[B, E1].grp.e =
  PM.Laws[LoopGroup[B, E].grp, LoopGroup[B, E1].grp, map, mul].one ;
 inverse (x : LoopGroup[B, E].grp.G) :
  Id LoopGroup[B, E1].grp.G (map (LoopGroup[B, E].grp.inv x)) (LoopGroup[B, E1].grp.inv (map x)) =
  PM.Laws[LoopGroup[B, E].grp, LoopGroup[B, E1].grp, map, mul].inverse x ;
} ;

hmap (n : Nat) (A : Ob D) {X Y : U k} (f : X -> Y) : homology n X A -> homology n Y A =
 pi0-map (Hom D (Sph n) (tensor X A)) (Hom D (Sph n) (tensor Y A)) (\ w -> hcomp {D} w (tmap A f)) ;

hmap-mul (n : Nat) (A : Ob D) {X Y : U k} (f : X -> Y) :
 PM.is-hom (hgrp n X A) (hgrp n Y A) (hmap (suc n) A f) =
 Post[Sph n, tensor X A, tensor Y A, tmap A f].mul ;

hmap-one (n : Nat) (A : Ob D) {X Y : U k} (f : X -> Y) :
 Id (homology (suc n) Y A) (hmap (suc n) A f (hgrp n X A).e) (hgrp n Y A).e =
 Post[Sph n, tensor X A, tensor Y A, tmap A f].one ;

hmap-inverse (n : Nat) (A : Ob D) {X Y : U k} (f : X -> Y) (x : homology (suc n) X A) :
 Id (homology (suc n) Y A) (hmap (suc n) A f ((hgrp n X A).inv x)) ((hgrp n Y A).inv (hmap (suc n) A f x)) =
 Post[Sph n, tensor X A, tensor Y A, tmap A f].inverse x ;

hmap-id (n : Nat) (A : Ob D) (X : U k) (x : homology n X A) :
 Id (homology n X A) (hmap n A {X} {X} (\ a -> a) x) x =
 pi0-ind (Hom D (Sph n) (tensor X A)) @l (\ x1 -> Id (homology n X A) (hmap n A {X} {X} (\ a -> a) x1) x1)
  (\ x1 -> pi0-set (Hom D (Sph n) (tensor X A)) (hmap n A {X} {X} (\ a -> a) x1) x1)
  (\ w -> H.transH (pi0-map-cls (Hom D (Sph n) (tensor X A)) (Hom D (Sph n) (tensor X A)) (\ t -> hcomp {D} t (tmap A {X} {X} (\ a -> a))) w)
   (H.apH {Hom D (Sph n) (tensor X A)} (\ t -> cls t)
    (H.transH (H.apH (hcomp {D} {Sph n} {tensor X A} {tensor X A} w) (tmap-id A X)) (hcomp-unit-r {D} w)))) x ;

hmap-comp (n : Nat) (A : Ob D) {X Y Z : U k} (f : X -> Y) (g : Y -> Z) (x : homology n X A) :
 Id (homology n Z A) (hmap n A {X} {Z} (\ a -> g (f a)) x) (hmap n A g (hmap n A f x)) =
 pi0-ind (Hom D (Sph n) (tensor X A)) @l
  (\ x1 -> Id (homology n Z A) (hmap n A {X} {Z} (\ a -> g (f a)) x1) (hmap n A g (hmap n A f x1)))
  (\ x1 -> pi0-set (Hom D (Sph n) (tensor Z A)) (hmap n A {X} {Z} (\ a -> g (f a)) x1) (hmap n A g (hmap n A f x1)))
  (\ w -> calc (homology n Z A) {
   hmap n A {X} {Z} (\ a -> g (f a)) (cls w)
   =< pi0-map-cls (Hom D (Sph n) (tensor X A)) (Hom D (Sph n) (tensor Z A)) (\ t -> hcomp {D} t (tmap A {X} {Z} (\ a -> g (f a)))) w > cls (hcomp {D} w (tmap A {X} {Z} (\ a -> g (f a))))
   =< H.apH (\ t -> cls (hcomp {D} w t)) (tmap-comp A f g) > cls (hcomp {D} w (hcomp {D} (tmap A f) (tmap A g)))
   =< H.apH (\ t -> cls t) (H.symH (hcomp-assoc D (Sph n, tensor X A, tensor Y A, tensor Z A, w, tmap A f, tmap A g))) > cls (hcomp {D} (hcomp {D} w (tmap A f)) (tmap A g))
   =< H.symH (pi0-map-cls (Hom D (Sph n) (tensor Y A)) (Hom D (Sph n) (tensor Z A)) (\ t -> hcomp {D} t (tmap A g)) (hcomp {D} w (tmap A f))) > hmap n A g (cls (hcomp {D} w (tmap A f)))
   =< H.apH (hmap n A g) (H.symH (pi0-map-cls (Hom D (Sph n) (tensor X A)) (Hom D (Sph n) (tensor Y A)) (\ t -> hcomp {D} t (tmap A f)) w)) > hmap n A g (hmap n A f (cls w)) }) x ;
