-- One theorem supplies both homomorphisms and exactness for every
-- pointed fibre sequence. For f:(Y,y)->(W,w), OmegaFib identifies
-- Omega(fib f) with fib(Omega f), RETAINING the first projection.
-- Thus a null loop under Omega f lifts to a loop of fib f, and every
-- such loop is null under Omega f. Quotient induction gives exactness
-- of pi_1(fib f) -> pi_1(Y) -> pi_1(W); both maps are the actual
-- homomorphisms induced by the pointed maps. Nothing is reconstructed
-- from separate equations on components, and no Cat axiom is used.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PM = Pi0Maps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open FibreLemmas ; open Pi0[l] ;

module Sequence (Y W : U l) (y : Y) (w : W) (f : Y -> W) (p : Id W (f y) w) {
 F : U l = fib f w ;
 point : F = (y, p) ;
 module Out = PM.Pointed[Y, W, y, w, f, p] ;
 module In = PM.Pointed[F, Y, point, y, \ a -> a.1, refl y] ;
 module O = FibreAlg.OmegaFib[Y, W, f, y] ;
 comparison : Pl.Equiv (Id F point point) (fib Out.loop (refl w)) = O.omega-fib w p ;
 over (q : Id F point point) :
  Id (Id Y y y) (In.loop q) (comparison.1 q).1 =
  H.transH (Conj[l].conj-refl-path (H.apH (\ a -> a.1) q)) (H.symH (O.omega-fst w p q)) ;
 zero-loop (q : Id F point point) : Id (Id W w w) (Out.loop (In.loop q)) (refl w) =
  H.transH (H.apH Out.loop (over q)) (comparison.1 q).2 ;
 lift (q : Id Y y y) (h : Id (Id W w w) (Out.loop q) (refl w)) :
  (a : Id F point point) * Id (Id Y y y) (In.loop a) q =
  (comparison.2.sec (q, h),
   H.transH (over (comparison.2.sec (q, h))) (H.apH (\ t -> t.1) (comparison.2.sec-eq (q, h)))) ;
 zero-cls (a : Id F point point) :
  Id LoopGrp[W, w].grp.G (Out.M.map (In.M.map (cls a))) LoopGrp[W, w].grp.e =
  H.transH (H.apH Out.M.map (pi0-map-cls (Id F point point) (Id Y y y) In.loop a))
   (H.transH (pi0-map-cls (Id Y y y) (Id W w w) Out.loop (In.loop a))
    (H.apH (\ r -> cls r) (zero-loop a))) ;
 zero (a : LoopGrp[F, point].grp.G) :
  Id LoopGrp[W, w].grp.G (Out.M.map (In.M.map a)) LoopGrp[W, w].grp.e =
  pi0-ind (Id F point point) @l
   (\ a1 -> Id LoopGrp[W, w].grp.G (Out.M.map (In.M.map a1)) LoopGrp[W, w].grp.e)
   (\ a1 -> LoopGrp[W, w].grp.setG (Out.M.map (In.M.map a1)) LoopGrp[W, w].grp.e) zero-cls a ;
 Image (q : LoopGrp[Y, y].grp.G) : U l =
  Tr.Trunc[(a : LoopGrp[F, point].grp.G) * Id LoopGrp[Y, y].grp.G (In.M.map a) q].carrier ;
 image-prop (q : LoopGrp[Y, y].grp.G) : Pl.isProp (Image q) =
  Tr.Trunc[(a : LoopGrp[F, point].grp.G) * Id LoopGrp[Y, y].grp.G (In.M.map a) q].proposition ;
 image-loop (q : Id Y y y) (h : Id (Id W w w) (Out.loop q) (refl w)) : Image (cls q) =
  Tr.Trunc[(a : LoopGrp[F, point].grp.G) * Id LoopGrp[Y, y].grp.G (In.M.map a) (cls q)].inc
   (cls (lift q h).1,
    H.transH (pi0-map-cls (Id F point point) (Id Y y y) In.loop (lift q h).1)
     (H.apH (\ r -> cls r) (lift q h).2)) ;
 exact-cls (q : Id Y y y) (h : Id LoopGrp[W, w].grp.G (Out.M.map (cls q)) LoopGrp[W, w].grp.e) : Image (cls q) =
  TC.rec (Id (Id W w w) (Out.loop q) (refl w)) @l (Image (cls q)) (image-prop (cls q)) (image-loop q)
   (pi0-eff (Id W w w) (Out.loop q) (refl w)
    (H.transH (H.symH (pi0-map-cls (Id Y y y) (Id W w w) Out.loop q)) h)) ;
 exact (q : LoopGrp[Y, y].grp.G) (h : Id LoopGrp[W, w].grp.G (Out.M.map q) LoopGrp[W, w].grp.e) : Image q =
  pi0-ind (Id Y y y) @l (\ q1 -> Id LoopGrp[W, w].grp.G (Out.M.map q1) LoopGrp[W, w].grp.e -> Image q1)
   (\ q1 -> Axioms[l].FunExtLemmas[fe @l].isProp-Pi
     (Id LoopGrp[W, w].grp.G (Out.M.map q1) LoopGrp[W, w].grp.e) (\ h1 -> Image q1) (\ h1 -> image-prop q1))
   exact-cls q h ;
} ;
