-- Paths in a homotopy pullback, with their square retained.
-- A path (b,e,p) = (b',e',p') consists of paths a:b=b', c:e=e'
-- and the equation ap f a . p' = p . ap g c. Decode by J on the
-- path of triples; encode by J on a and c, then change the third entry.
-- These lemmas use only identity types, and never truncate the square.
level l ; open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;

module Pull (B E P : U l) (f : B -> P) (g : E -> P) {
 Cone : U l = (b : B) * (e : E) * Id P (f b) (g e) ;
 cell (x y : Cone) (h : Id Cone x y) :
  Id (Id P (f x.1) (g y.2.1))
   (H.transH (H.apH f (H.apH (\ w -> w.1) h)) y.2.2)
   (H.transH x.2.2 (H.apH g (H.apH (\ w -> w.2.1) h))) =
  idJ Cone x (\ y1 h1 -> Id (Id P (f x.1) (g y1.2.1))
    (H.transH (H.apH f (H.apH (\ w -> w.1) h1)) y1.2.2)
    (H.transH x.2.2 (H.apH g (H.apH (\ w -> w.2.1) h1))))
   (PA.unit-l x.2.2) y h ;

 path (b b1 : B) (a : Id B b b1) (e e1 : E) (c : Id E e e1)
  (p : Id P (f b) (g e)) (q : Id P (f b1) (g e1))
  (s : Id (Id P (f b) (g e1)) (H.transH (H.apH f a) q) (H.transH p (H.apH g c))) :
  Id Cone (b, e, p) (b1, e1, q) =
  idJ B b (\ b2 a2 -> (q2 : Id P (f b2) (g e1)) ->
    Id (Id P (f b) (g e1)) (H.transH (H.apH f a2) q2) (H.transH p (H.apH g c)) ->
    Id Cone (b, e, p) (b2, e1, q2))
   (idJ E e (\ e2 c2 -> (q2 : Id P (f b) (g e2)) ->
      Id (Id P (f b) (g e2)) (H.transH (refl (f b)) q2) (H.transH p (H.apH g c2)) ->
      Id Cone (b, e, p) (b, e2, q2))
    (\ q2 s2 -> H.apH (\ r -> (b, e, r)) (H.transH (H.symH s2) (PA.unit-l q2))) e1 c) b1 a q s ;

 path-fst (b b1 : B) (a : Id B b b1) (e e1 : E) (c : Id E e e1)
  (p : Id P (f b) (g e)) (q : Id P (f b1) (g e1))
  (s : Id (Id P (f b) (g e1)) (H.transH (H.apH f a) q) (H.transH p (H.apH g c))) :
  Id (Id B b b1) (H.apH (\ w -> w.1) (path b b1 a e e1 c p q s)) a =
  idJ B b (\ b2 a2 -> (q2 : Id P (f b2) (g e1))
    (s2 : Id (Id P (f b) (g e1)) (H.transH (H.apH f a2) q2) (H.transH p (H.apH g c))) ->
    Id (Id B b b2) (H.apH (\ w -> w.1) (path b b2 a2 e e1 c p q2 s2)) a2)
   (idJ E e (\ e2 c2 -> (q2 : Id P (f b) (g e2))
     (s2 : Id (Id P (f b) (g e2)) (H.transH (refl (f b)) q2) (H.transH p (H.apH g c2))) ->
     Id (Id B b b) (H.apH (\ w -> w.1) (path b b (refl b) e e2 c2 p q2 s2)) (refl b))
    (\ q2 s2 -> H.transH (PA.ap-comp (\ w -> w.1) (\ r -> (b, e, r)) (H.transH (H.symH s2) (PA.unit-l q2)))
      (PA.ap-constant b (H.transH (H.symH s2) (PA.unit-l q2)))) e1 c) b1 a q s ;

 path-snd (b b1 : B) (a : Id B b b1) (e e1 : E) (c : Id E e e1)
  (p : Id P (f b) (g e)) (q : Id P (f b1) (g e1))
  (s : Id (Id P (f b) (g e1)) (H.transH (H.apH f a) q) (H.transH p (H.apH g c))) :
  Id (Id E e e1) (H.apH (\ w -> w.2.1) (path b b1 a e e1 c p q s)) c =
  idJ B b (\ b2 a2 -> (q2 : Id P (f b2) (g e1))
    (s2 : Id (Id P (f b) (g e1)) (H.transH (H.apH f a2) q2) (H.transH p (H.apH g c))) ->
    Id (Id E e e1) (H.apH (\ w -> w.2.1) (path b b2 a2 e e1 c p q2 s2)) c)
   (idJ E e (\ e2 c2 -> (q2 : Id P (f b) (g e2))
     (s2 : Id (Id P (f b) (g e2)) (H.transH (refl (f b)) q2) (H.transH p (H.apH g c2))) ->
     Id (Id E e e2) (H.apH (\ w -> w.2.1) (path b b (refl b) e e2 c2 p q2 s2)) c2)
    (\ q2 s2 -> H.transH (PA.ap-comp (\ w -> w.2.1) (\ r -> (b, e, r)) (H.transH (H.symH s2) (PA.unit-l q2)))
      (PA.ap-constant e (H.transH (H.symH s2) (PA.unit-l q2)))) e1 c) b1 a q s ;
} ;
