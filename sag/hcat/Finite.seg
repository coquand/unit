-- Finite types for the interval and the simplices (Agda Spartan's _+_ and
-- 𝟚, Interval's Ord).  Two = 1 + 1 with inl tt = 0 below inr tt = 1;
-- Ord n = the totally ordered type with n + 1 elements, Ord 0 = 1 and
-- Ord (n+1) = Ord n + 1 (the new element on top), so that Ord 1 = Two by
-- definition.  leq2 and leqOrd are the orders, by cases.
level l ; open Base ;

data Sum (A B : U l) : U l = inl (a : A) | inr (b : B) ;

Two : U l = Sum Top Top ;
zero2 : Two = inl tt ;
one2 : Two = inr tt ;

leq2 : Two -> Two -> U l = split {
 inl u -> \ y -> Top ;
 inr u -> split { inl v -> Empty ; inr v -> Top } } ;

Ord : Nat -> U l = split { zero -> Top ; suc n | r -> Sum r Top } ;

leqOrd : (n : Nat) -> Ord n -> Ord n -> U l = split {
 zero -> \ x y -> Top ;
 suc n | r -> split {
  inl x -> split { inl y -> r x y ; inr v -> Top } ;
  inr u -> split { inl y -> Empty ; inr v -> Top } } } ;

two-is-ord1 : Id (U l) Two (Ord (suc zero)) = refl Two ;
