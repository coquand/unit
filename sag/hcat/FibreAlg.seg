-- Fibres and loops of types (for homology groups, H4-H5).  Type theory
-- only: no parameter of Cat is used.
--   sigma-path-equiv: a path (a, b) = (a1, b1) in a Sigma type is a path
--   p : a = a1 with subst p b = b1 (sPath; inverse Sigma-path; rsPath and
--   J on p, then on the second path).
--   sigma-contr: over a contractible base, Sigma (t : T) P t ~ P t0
--   (subst along the contraction; the loop c t0 at t0 is refl, T a set).
--   fib-pr1: the fibre of the first projection over a0 is Q a0 (J).
--   contr-transfer: a type equivalent to a contractible one is one.
--   FibComp: for s : Y -> P, r : P -> Z,
--     Sigma (w : fib r z) fib s w.1  ~  fib (r o s) z,
--   ((p, e), (y, q)) |-> (y, ap r q . e); inverse (y, v) |-> ((s y, v), (y, refl)).
--   RetractFib: if r o s ~ id, then fib s (s y0) ~ Omega (fib r (r (s y0)), (s y0, refl)).
--   The total space E of FibComp is contractible (r o s is an
--   equivalence), so the fibre of E -> fib r over w0 = (s y0, refl), which
--   is fib s (s y0) by fib-pr1, is the path type from the centre of E to
--   w0 (sigma-contr), and the centre is joined to w0 by the contraction
--   at ((s y0, refl), (y0, refl)).
--   OmegaFib: for F : Y -> W and p0 : F y0 = w0,
--     Omega (fib F w0, (y0, p0)) ~ fib (q |-> conj p0 (ap F q)) refl.
--   By J on p0 the case p0 = refl: sigma-path-equiv, then subst-fib and
--   the equivalence (q^-1 = refl) ~ (q = refl) (ap of symH, sym-sym).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ;
module CU = FunExtUA[l] ;
open FibreLemmas ; open SigmaEquiv ; open Conj[l] ;

sp-sigma (A : U l) (B : A -> U l) (a a1 : A) (b : B a) (p : Id A a a1) :
 (b1 : B a1) (q : Id (B a1) (Pl.subst A B a a1 p b) b1) ->
 Id ((p1 : Id A a a1) * Id (B a1) (Pl.subst A B a a1 p1 b) b1) (Pl.sPath A B (a, b) (a1, b1) (Pl.Sigma-path A B a a1 b b1 p q)) (p, q) =
 idJ A a (\ a2 p2 -> (b2 : B a2) (q2 : Id (B a2) (Pl.subst A B a a2 p2 b) b2) ->
   Id ((p1 : Id A a a2) * Id (B a2) (Pl.subst A B a a2 p1 b) b2) (Pl.sPath A B (a, b) (a2, b2) (Pl.Sigma-path A B a a2 b b2 p2 q2)) (p2, q2))
  (\ b2 q2 -> idJ (B a) b (\ b3 q3 -> Id ((p1 : Id A a a) * Id (B a) (Pl.subst A B a a p1 b) b3)
      (Pl.sPath A B (a, b) (a, b3) (Pl.Sigma-path A B a a b b3 (refl a) q3)) (refl a, q3))
    (refl (refl a, refl b)) b2 q2) a1 p ;

sigma-path-equiv (A : U l) (B : A -> U l) (u v : (x : A) * B x) :
 Pl.Equiv (Id ((x : A) * B x) u v) ((p : Id A u.1 v.1) * Id (B v.1) (Pl.subst A B u.1 v.1 p u.2) v.2) =
 (Pl.sPath A B u v,
  Pl.qinv (Id ((x : A) * B x) u v) ((p : Id A u.1 v.1) * Id (B v.1) (Pl.subst A B u.1 v.1 p u.2) v.2) (Pl.sPath A B u v)
   (\ w -> Pl.Sigma-path A B u.1 v.1 u.2 v.2 w.1 w.2)
   (\ w -> sp-sigma A B u.1 v.1 u.2 w.1 v.2 w.2) (Pl.rsPath A B u v)) ;

sPath-fst (A : U l) (B : A -> U l) (u v : (x : A) * B x) (p : Id ((x : A) * B x) u v) :
 Id (Id A u.1 v.1) (Pl.sPath A B u v p).1 (H.apH (\ w -> w.1) p) =
 idJ ((x : A) * B x) u (\ v1 p1 -> Id (Id A u.1 v1.1) (Pl.sPath A B u v1 p1).1 (H.apH (\ w -> w.1) p1))
  (refl (refl u.1)) v p ;

sigma-path-fst (A : U l) (B : A -> U l) (a a1 : A) (b : B a) (b1 : B a1)
 (p : Id A a a1) (q : Id (B a1) (Pl.subst A B a a1 p b) b1) :
 Id (Id A a a1) (H.apH (\ w -> w.1) (Pl.Sigma-path A B a a1 b b1 p q)) p =
 H.transH (H.symH (sPath-fst A B (a, b) (a1, b1) (Pl.Sigma-path A B a a1 b b1 p q)))
  (H.apH (\ w -> w.1) (sp-sigma A B a a1 b p b1 q)) ;

contr-set (T : U l) (c : CU.isContr T) : Pl.isSet T = Pl.prop-to-set T (\ u v -> CU.pathC T c u v) ;

subst-back (A : U l) (P : A -> U l) {x y : A} (p : Id A x y) (u : P y) : Id (P y) (H.substH P p (H.substH P (H.symH p) u)) u =
 idJ A x (\ y1 p1 -> (u1 : P y1) -> Id (P y1) (H.substH P p1 (H.substH P (H.symH p1) u1)) u1) (\ u1 -> refl u1) y p u ;

sigma-contr (T : U l) (c : CU.isContr T) (P : T -> U l) : Pl.Equiv ((t : T) * P t) (P c.1) =
 (\ w -> H.substH P (H.symH (c.2 w.1)) w.2,
  Pl.qinv ((t : T) * P t) (P c.1) (\ w -> H.substH P (H.symH (c.2 w.1)) w.2) (\ u -> (c.1, u))
   (\ u -> H.apH (\ r -> H.substH P (H.symH r) u) (Pl.loop-refl T (contr-set T c) c.1 (c.2 c.1)))
   (\ w -> Pl.Sigma-path T P c.1 w.1 (H.substH P (H.symH (c.2 w.1)) w.2) w.2 (c.2 w.1) (subst-back T P (c.2 w.1) w.2))) ;

fib-pr1-back (A : U l) (Q : A -> U l) (a0 : A) (a : A) (p : Id A a a0) :
 (q : Q a) -> Id (fib {(x : A) * Q x} {A} (\ w -> w.1) a0) ((a0, H.substH Q p q), refl a0) ((a, q), p) =
 H.idJR A a0 (\ a1 p1 -> (q : Q a1) -> Id (fib {(x : A) * Q x} {A} (\ w -> w.1) a0) ((a0, H.substH Q p1 q), refl a0) ((a1, q), p1))
  (\ q -> refl ((a0, q), refl a0)) a p ;

fib-pr1 (A : U l) (Q : A -> U l) (a0 : A) : Pl.Equiv (fib {(x : A) * Q x} {A} (\ w -> w.1) a0) (Q a0) =
 (\ u -> H.substH Q u.2 u.1.2,
  Pl.qinv (fib {(x : A) * Q x} {A} (\ w -> w.1) a0) (Q a0) (\ u -> H.substH Q u.2 u.1.2) (\ q -> ((a0, q), refl a0))
   (\ q -> refl q) (\ u -> fib-pr1-back A Q a0 u.1.1 u.2 u.1.2)) ;

contr-transfer (A B : U l) (e : Pl.Equiv A B) (c : CU.isContr B) : CU.isContr A =
 (e.2.sec c.1, \ a -> H.transH (H.apH e.2.sec (c.2 (e.1 a))) (Pl.sec-ret A B e.1 e.2 a)) ;

module FibComp (Y P Z : U l) (s : Y -> P) (r : P -> Z) (z : Z) {
 E : U l = (w : fib r z) * fib s w.1 ;
 to (u : E) : fib {Y} {Z} (\ y -> r (s y)) z = (u.2.1, H.transH (H.apH r u.2.2) u.1.2) ;
 from (v : fib {Y} {Z} (\ y -> r (s y)) z) : E = ((s v.1, v.2), (v.1, refl (s v.1))) ;
 back (y : Y) (p : P) (q : Id P (s y) p) : (e : Id Z (r p) z) ->
  Id E ((s y, H.transH (H.apH r q) e), (y, refl (s y))) ((p, e), (y, q)) =
  idJ P (s y) (\ p1 q1 -> (e : Id Z (r p1) z) -> Id E ((s y, H.transH (H.apH r q1) e), (y, refl (s y))) ((p1, e), (y, q1)))
   (\ e -> H.apH (\ t -> ((s y, t), (y, refl (s y)))) (PA.unit-l e)) p q ;
 equiv : Pl.Equiv E (fib {Y} {Z} (\ y -> r (s y)) z) =
  (to, Pl.qinv E (fib {Y} {Z} (\ y -> r (s y)) z) to from
    (\ v -> H.apH (\ t -> (v.1, t)) (PA.unit-l v.2))
    (\ u -> back u.2.1 u.1.1 u.2.2 u.1.2)) ;
} ;

module RetractFib (Y P : U l) (s : Y -> P) (r : P -> Y) (h : (y : Y) -> Id Y (r (s y)) y) (y0 : Y) {
 z : Y = r (s y0) ;
 w0 : fib r z = (s y0, refl z) ;
 E : U l = FibComp[Y, P, Y, s, r, z].E ;
 e0 : E = (w0, (y0, refl (s y0))) ;
 rs-equiv : Pl.isEquiv Y Y (\ y -> r (s y)) =
  EL.homotopy Y Y (\ y -> y) (\ y -> r (s y)) (\ y -> H.symH (h y)) (Pl.idEquiv Y).2 ;
 E-contr : CU.isContr E =
  contr-transfer E (fib {Y} {Y} (\ y -> r (s y)) z) FibComp[Y, P, Y, s, r, z].equiv (equiv-fibre-contr Y Y (\ y -> r (s y)) rs-equiv z) ;
 retract-fib : Pl.Equiv (fib s (s y0)) (Id (fib r z) w0 w0) =
  EL.then (fib s (s y0)) (fib {E} {fib r z} (\ u -> u.1) w0) (Id (fib r z) w0 w0)
   (EL.inverse (fib {E} {fib r z} (\ u -> u.1) w0) (fib s (s y0)) (fib-pr1 (fib r z) (\ w -> fib s w.1) w0))
   (EL.then (fib {E} {fib r z} (\ u -> u.1) w0) (Id (fib r z) E-contr.1.1 w0) (Id (fib r z) w0 w0)
     (sigma-contr E E-contr (\ u -> Id (fib r z) u.1 w0))
     (pre-comp-path-equiv {fib r z} {w0} {E-contr.1.1} {w0} (H.symH (H.apH {E} {fib r z} (\ u -> u.1) (E-contr.2 e0))))) ;
} ;

module OmegaFib (Y W : U l) (F : Y -> W) (y0 : Y) {
 loopF (w0 : W) (p0 : Id W (F y0) w0) (q : Id Y y0 y0) : Id W w0 w0 = conj p0 (H.apH F q) ;
 -- (q^-1 = refl) ~ (refl . q = refl)
 sym-equiv (q : Id W (F y0) (F y0)) : Pl.Equiv (Id (Id W (F y0) (F y0)) (H.symH q) (refl (F y0))) (Id (Id W (F y0) (F y0)) (H.transH (refl (F y0)) q) (refl (F y0))) =
  EL.then (Id (Id W (F y0) (F y0)) (H.symH q) (refl (F y0))) (Id (Id W (F y0) (F y0)) (H.symH (H.symH q)) (refl (F y0)))
   (Id (Id W (F y0) (F y0)) (H.transH (refl (F y0)) q) (refl (F y0)))
   (H.apH (\ t -> H.symH t),
    EquivAp[l].ap-equiv (Id W (F y0) (F y0)) (Id W (F y0) (F y0))
     (\ t -> H.symH t, Pl.qinv (Id W (F y0) (F y0)) (Id W (F y0) (F y0)) (\ t -> H.symH t) (\ t -> H.symH t) (\ t -> PA.sym-sym t) (\ t -> PA.sym-sym t))
     (H.symH q) (refl (F y0)))
   (EL.conjugate (Id W (F y0) (F y0)) (H.symH (H.symH q)) (H.transH (refl (F y0)) q) (refl (F y0)) (refl (F y0))
     (H.transH (PA.sym-sym q) (H.symH (PA.unit-l q))) (refl (refl (F y0)))) ;
 base-fibre (q : Id Y y0 y0) : Pl.Equiv (Id (Id W (F y0) (F y0)) (H.substH (\ y -> Id W (F y) (F y0)) q (refl (F y0))) (refl (F y0)))
  (Id (Id W (F y0) (F y0)) (loopF (F y0) (refl (F y0)) q) (refl (F y0))) =
  EL.then (Id (Id W (F y0) (F y0)) (H.substH (\ y -> Id W (F y) (F y0)) q (refl (F y0))) (refl (F y0))) (Id (Id W (F y0) (F y0)) (H.symH (H.apH F q)) (refl (F y0)))
   (Id (Id W (F y0) (F y0)) (loopF (F y0) (refl (F y0)) q) (refl (F y0)))
   (EL.conjugate (Id W (F y0) (F y0)) (H.substH (\ y -> Id W (F y) (F y0)) q (refl (F y0))) (H.symH (H.apH F q)) (refl (F y0)) (refl (F y0))
     (subst-fib F (F y0) q (refl (F y0))) (refl (refl (F y0))))
   (sym-equiv (H.apH F q)) ;
 omega-base : Pl.Equiv (Id (fib F (F y0)) (y0, refl (F y0)) (y0, refl (F y0))) (fib (loopF (F y0) (refl (F y0))) (refl (F y0))) =
  EL.then (Id (fib F (F y0)) (y0, refl (F y0)) (y0, refl (F y0)))
   ((q : Id Y y0 y0) * Id (Id W (F y0) (F y0)) (Pl.subst Y (\ y -> Id W (F y) (F y0)) y0 y0 q (refl (F y0))) (refl (F y0)))
   (fib (loopF (F y0) (refl (F y0))) (refl (F y0)))
   (sigma-path-equiv Y (\ y -> Id W (F y) (F y0)) (y0, refl (F y0)) (y0, refl (F y0)))
   (Sigma-fiberwise-equiv (Id Y y0 y0) (\ q -> Id (Id W (F y0) (F y0)) (Pl.subst Y (\ y -> Id W (F y) (F y0)) y0 y0 q (refl (F y0))) (refl (F y0)))
     (\ q -> Id (Id W (F y0) (F y0)) (loopF (F y0) (refl (F y0)) q) (refl (F y0))) base-fibre) ;
 omega-fib (w0 : W) (p0 : Id W (F y0) w0) : Pl.Equiv (Id (fib F w0) (y0, p0) (y0, p0)) (fib (loopF w0 p0) (refl w0)) =
  idJ W (F y0) (\ w1 p1 -> Pl.Equiv (Id (fib F w1) (y0, p1) (y0, p1)) (fib (loopF w1 p1) (refl w1))) omega-base w0 p0 ;
 -- Retain the projection: this is what makes the equivalence usable
 -- uniformly in exact sequences, rather than just an equivalence of types.
 omega-fst (w0 : W) (p0 : Id W (F y0) w0)
  (q : Id (fib F w0) (y0, p0) (y0, p0)) :
  Id (Id Y y0 y0) ((omega-fib w0 p0).1 q).1 (H.apH (\ w -> w.1) q) =
  idJ W (F y0) (\ w1 p1 -> (q1 : Id (fib F w1) (y0, p1) (y0, p1)) ->
    Id (Id Y y0 y0) ((omega-fib w1 p1).1 q1).1 (H.apH (\ w -> w.1) q1))
   (\ q1 -> sPath-fst Y (\ y -> Id W (F y) (F y0)) (y0, refl (F y0)) (y0, refl (F y0)) q1) w0 p0 q ;
} ;

-- ContrLoop: for K contractible with centre k0 and phi : K -> W,
--   kappa : (b : K) * (e : K) * (phi b = phi e) -> Omega (W, phi k0),
--   (b, e, p) |-> conj (ap phi (ce b)) ... i.e. (ap phi (ce b))^-1 . p . ap phi (ce e)
-- (ce b : b = k0) is an equivalence with inverse q |-> (k0, k0, q):
-- ce k0 = refl (K is a set), and J on ce b, ce e for the other side.
module ContrLoop (K W : U l) (cK : CU.isContr K) (phi : K -> W) {
 k0 : K = cK.1 ;
 ce (b : K) : Id K b k0 = H.symH (cK.2 b) ;
 Tot : U l = (b : K) * (e : K) * Id W (phi b) (phi e) ;
 kappa (w : Tot) : Id W (phi k0) (phi k0) = H.transH (H.symH (H.apH phi (ce w.1))) (H.transH w.2.2 (H.apH phi (ce w.2.1))) ;
 iota (q : Id W (phi k0) (phi k0)) : Tot = (k0, k0, q) ;
 ce-refl : Id (Id K k0 k0) (ce k0) (refl k0) = Pl.loop-refl K (contr-set K cK) k0 (ce k0) ;
 kappa-iota (q : Id W (phi k0) (phi k0)) : Id (Id W (phi k0) (phi k0)) (kappa (iota q)) q =
  H.transH (H.apH (\ r -> conj (H.apH phi r) q) ce-refl) (PA.unit-l q) ;
 back (b : K) (be : Id K b k0) : (e : K) (ga : Id K e k0) (p : Id W (phi b) (phi e)) ->
  Id Tot (k0, k0, H.transH (H.symH (H.apH phi be)) (H.transH p (H.apH phi ga))) (b, e, p) =
  H.idJR K k0 (\ b1 be1 -> (e : K) (ga : Id K e k0) (p : Id W (phi b1) (phi e)) ->
    Id Tot (k0, k0, H.transH (H.symH (H.apH phi be1)) (H.transH p (H.apH phi ga))) (b1, e, p))
   (\ e ga -> H.idJR K k0 (\ e1 ga1 -> (p : Id W (phi k0) (phi e1)) ->
       Id Tot (k0, k0, H.transH (refl (phi k0)) (H.transH p (H.apH phi ga1))) (k0, e1, p))
     (\ p -> H.apH (\ t -> (k0, k0, t)) (PA.unit-l p)) e ga) b be ;
 kappa-equiv : Pl.isEquiv Tot (Id W (phi k0) (phi k0)) kappa =
  Pl.qinv Tot (Id W (phi k0) (phi k0)) kappa iota kappa-iota (\ w -> back w.1 (ce w.1) w.2.1 (ce w.2.1) w.2.2) ;
} ;

-- reversing paths is an equivalence
path-sym-equiv {A : U l} {x y : A} : Pl.Equiv (Id A x y) (Id A y x) =
 (\ p -> H.symH p, Pl.qinv (Id A x y) (Id A y x) (\ p -> H.symH p) (\ p -> H.symH p) (\ p -> PA.sym-sym p) (\ p -> PA.sym-sym p)) ;

-- ap of an equivalence, as an equivalence
ap-Equiv {A B : U l} (e : Pl.Equiv A B) (x y : A) : Pl.Equiv (Id A x y) (Id B (e.1 x) (e.1 y)) =
 (\ p -> H.apH e.1 p, EquivAp[l].ap-equiv A B e x y) ;
