-- The comparison map of the exponential (Wärn Axiom 15; Agda
-- Category/Exponentials), stated between the parameters Fun, ev and the
-- axiom exp-is-equiv: u : X -> Fun A B goes to ev o <u o pi1, pi2>.
open WildCat ; open Pullbacks ;
exp-comparison (A B X : Cat) (u : Map X (Fun A B)) : Map (times X A) B =
 comp (ev A B) (pair (comp u (pi1 X A)) (pi2 X A)) ;
