-- Fun X I is posetal (Agda Posetal/FunIPosetal; Rocq monotone_curry_delta),
-- and so is every simplex (Agda Posetal/Posetal: Delta-posetal).
--   Clause 2 for Fun X I: curry/uncurry between monotone maps
--   Ob D -> Ob (Fun X I) and Ob (D x X) -> Ob I.
--     uncurry f (d, x) = f d at x; monotone, since a morphism (mD, mX) of
--     D x X gives f (dom mD) <= f (cod mD) pointwise (mor-to-pointwise) and
--     f (cod mD) is monotone on mX; then I-order-to-hom.
--     curry g d = the functor named by x |-> g <d, x>, monotone in x (as
--     g is monotone on <id d, m>), and monotone in d by pointwise-to-mor.
--     The round trips: pair-eta and the round trips of ob-map-equiv and
--     I-char.  Uncurry commutes with ob-action and exp-comparison
--     (ev-point), so ob-action for Fun X I is the composite of three
--     equivalences: exp-comparison, ob-action for D x X into I (I-posetal),
--     and the inverse of uncurry.
--   Delta-posetal by induction: Delta 0 = One, Delta (n+1) = Fun (Delta n) I.
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ;
module EL = EquivalenceLemmas[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open ExpComparison ; open Exponentials ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open IntervalPosetal ;
open FaceOrdCompat ; open PosetalCore ;

module FunI (X D : Cat) {
 prpi1 (u : Ob (times D X)) : Ob D = Ob-map (pi1 D X) u ;
 prpi2 (u : Ob (times D X)) : Ob X = Ob-map (pi2 D X) u ;

 uncurry-fn (f : Ob D -> Ob (Fun X I)) (u : Ob (times D X)) : Ob I = Ob-map (ob-to-map X I (f (prpi1 u))) (prpi2 u) ;

 uncurry-mono-le (f : Ob D -> Ob (Fun X I)) (p : is-monotone-ob D (Fun X I) f) (m : Mor (times D X)) :
  leq2 (ob-to-2 (ob-to-map X I (f (prpi1 (dom m)))) (prpi2 (dom m))) (ob-to-2 (ob-to-map X I (f (prpi1 (cod m)))) (prpi2 (cod m))) =
  leq2-trans (ob-to-2 (ob-to-map X I (f (prpi1 (dom m)))) (prpi2 (dom m)))
   (ob-to-2 (ob-to-map X I (f (prpi1 (cod m)))) (prpi2 (dom m)))
   (ob-to-2 (ob-to-map X I (f (prpi1 (cod m)))) (prpi2 (cod m)))
   (leq2-transport
     (H.apH (\ phi -> ob-to-2 (ob-to-map X I phi) (prpi2 (dom m))) (hdom (p (prpi1 (dom m)) (prpi1 (cod m)) (funct-on-mor (pi1 D X) m, dom-nat (pi1 D X) m, cod-nat (pi1 D X) m))))
     (H.apH (\ phi -> ob-to-2 (ob-to-map X I phi) (prpi2 (dom m))) (hcod (p (prpi1 (dom m)) (prpi1 (cod m)) (funct-on-mor (pi1 D X) m, dom-nat (pi1 D X) m, cod-nat (pi1 D X) m))))
     (mor-to-pointwise X (hmor (p (prpi1 (dom m)) (prpi1 (cod m)) (funct-on-mor (pi1 D X) m, dom-nat (pi1 D X) m, cod-nat (pi1 D X) m))) (prpi2 (dom m))))
   (leq2-transport
     (H.apH (ob-to-2 (ob-to-map X I (f (prpi1 (cod m))))) (dom-nat (pi2 D X) m))
     (H.apH (ob-to-2 (ob-to-map X I (f (prpi1 (cod m))))) (cod-nat (pi2 D X) m))
     ((I-char-comparison X (ob-to-map X I (f (prpi1 (cod m))))).2 (funct-on-mor (pi2 D X) m))) ;

 mono-uncurry (f : Ob D -> Ob (Fun X I)) (p : is-monotone-ob D (Fun X I) f) : is-monotone-ob (times D X) I (uncurry-fn f) =
  \ x y h -> I-order-to-hom (uncurry-fn f x) (uncurry-fn f y)
   (leq2-transport (H.apH (\ u -> I-ob.1 (uncurry-fn f u)) (hdom h)) (H.apH (\ u -> I-ob.1 (uncurry-fn f u)) (hcod h))
     (uncurry-mono-le f p (hmor h))) ;

 Psi (w : MonoOb D (Fun X I)) : MonoOb (times D X) I = (uncurry-fn w.1, mono-uncurry w.1 w.2) ;

 prod-mor (mD : Mor D) (mX : Mor X) :
  Hom (times D X) (pair {D} {X} {One} (dom mD) (dom mX)) (pair {D} {X} {One} (cod mD) (cod mX)) =
  (pair {D} {X} {I} mD mX, pair-nat {D} {X} {I} {One} mD mX I0, pair-nat {D} {X} {I} {One} mD mX I1) ;

 curry-qfun (g : Ob (times D X) -> Ob I) (d : Ob D) (b : Ob X) : Two = I-ob.1 (g (pair {D} {X} {One} d b)) ;

 curry-qmono (g : Ob (times D X) -> Ob I) (q : is-monotone-ob (times D X) I g) (d : Ob D) : is-monotone X (curry-qfun g d) =
  \ m -> I-hom-to-order (g (pair {D} {X} {One} d (dom m))) (g (pair {D} {X} {One} d (cod m)))
   (q (pair {D} {X} {One} d (dom m)) (pair {D} {X} {One} d (cod m))
     (Hom-coerce (times D X) (pair-ap (dom-id {D} d) (refl (dom m))) (pair-ap (cod-id {D} d) (refl (cod m)))
       (prod-mor (id-mor {D} d) m))) ;

 cq (g : Ob (times D X) -> Ob I) (q : is-monotone-ob (times D X) I g) (d : Ob D) : Monotone X =
  (curry-qfun g d, curry-qmono g q d) ;

 curry-fn (g : Ob (times D X) -> Ob I) (q : is-monotone-ob (times D X) I g) (d : Ob D) : Ob (Fun X I) =
  map-to-ob X I (I-char-inverse X (cq g q d)) ;

 mono-curry (g : Ob (times D X) -> Ob I) (q : is-monotone-ob (times D X) I g) : is-monotone-ob D (Fun X I) (curry-fn g q) =
  \ x y h -> pointwise-to-mor X (I-char-inverse X (cq g q x)) (I-char-inverse X (cq g q y))
   (\ b -> leq2-transport (H.symH (I-char-ob-to-2 X (cq g q x) b)) (H.symH (I-char-ob-to-2 X (cq g q y) b))
     (I-hom-to-order (g (pair {D} {X} {One} x b)) (g (pair {D} {X} {One} y b))
       (q (pair {D} {X} {One} x b) (pair {D} {X} {One} y b)
         (Hom-coerce (times D X) (pair-ap (hdom h) (dom-id {X} b)) (pair-ap (hcod h) (cod-id {X} b))
           (prod-mor (hmor h) (id-mor {X} b)))))) ;

 Phi (w : MonoOb (times D X) I) : MonoOb D (Fun X I) = (curry-fn w.1 w.2, mono-curry w.1 w.2) ;

 PsiPhi (w : MonoOb (times D X) I) : Id (MonoOb (times D X) I) (Psi (Phi w)) w =
  Pl.Sigma-eq (Ob (times D X) -> Ob I) (is-monotone-ob (times D X) I) (Psi (Phi w)).1 w.1 (Psi (Phi w)).2 w.2
   (FL.funext (Ob (times D X)) (\ u -> Ob I) (Psi (Phi w)).1 w.1 (\ u ->
     H.transH (H.apH (\ h -> Ob-map h (prpi2 u)) (ob-map-roundtrip1 X I (I-char-inverse X (cq w.1 w.2 (prpi1 u)))))
      (Equivalences[l].injective (Ob I) Two I-ob.1 I-ob.2
        (Ob-map (I-char-inverse X (cq w.1 w.2 (prpi1 u))) (prpi2 u)) (w.1 u)
        (H.transH (I-char-ob-to-2 X (cq w.1 w.2 (prpi1 u)) (prpi2 u)) (H.apH {Ob (times D X)} {Two} (\ v -> I-ob.1 (w.1 v)) (pair-eta {D} {X} {One} u))))))
   (is-monotone-ob-is-prop (times D X) I I-thin w.1) ;

 pweq (f : Ob D -> Ob (Fun X I)) (p : is-monotone-ob D (Fun X I) f) (d : Ob D) (b : Ob X) :
  Id Two (curry-qfun (uncurry-fn f) d b) (ob-to-2 (ob-to-map X I (f d)) b) =
  H.apH I-ob.1 (H.transH
   (H.apH (\ a -> Ob-map (ob-to-map X I (f a)) (prpi2 (pair {D} {X} {One} d b))) (pair-beta1 {D} {X} {One} d b))
   (H.apH (Ob-map (ob-to-map X I (f d))) (pair-beta2 {D} {X} {One} d b))) ;

 PhiPsi (w : MonoOb D (Fun X I)) : Id (MonoOb D (Fun X I)) (Phi (Psi w)) w =
  Pl.Sigma-eq (Ob D -> Ob (Fun X I)) (is-monotone-ob D (Fun X I)) (Phi (Psi w)).1 w.1 (Phi (Psi w)).2 w.2
   (FL.funext (Ob D) (\ d -> Ob (Fun X I)) (Phi (Psi w)).1 w.1 (\ d ->
     Equivalences[l].injective (Ob (Fun X I)) (Map X I) (ob-to-map X I) (ob-map-equiv X I).2 ((Phi (Psi w)).1 d) (w.1 d)
      (H.transH (ob-map-roundtrip1 X I (I-char-inverse X (cq (uncurry-fn w.1) (mono-uncurry w.1 w.2) d)))
       (H.transH (H.apH (I-char-inverse X)
          (Pl.Sigma-eq (Ob X -> Two) (is-monotone X) (curry-qfun (uncurry-fn w.1) d) (ob-to-2 (ob-to-map X I (w.1 d)))
            (cq (uncurry-fn w.1) (mono-uncurry w.1 w.2) d).2 (I-char-comparison X (ob-to-map X I (w.1 d))).2
            (FL.funext (Ob X) (\ b -> Two) (curry-qfun (uncurry-fn w.1) d) (ob-to-2 (ob-to-map X I (w.1 d))) (pweq w.1 w.2 d))
            (is-monotone-is-prop X (ob-to-2 (ob-to-map X I (w.1 d))))))
        (I-char-linv X (ob-to-map X I (w.1 d)))))))
   (is-monotone-ob-is-prop D (Fun X I) (Fun-I-thin X) w.1) ;

 psi-equiv : Pl.Equiv (MonoOb D (Fun X I)) (MonoOb (times D X) I) =
  (Psi, Pl.qinv (MonoOb D (Fun X I)) (MonoOb (times D X) I) Psi Phi PsiPhi PhiPsi) ;

 sq (F : Map D (Fun X I)) : Id (MonoOb (times D X) I) (Psi (ob-action D (Fun X I) F)) (ob-action (times D X) I (exp-comparison X I D F)) =
  Pl.Sigma-eq (Ob (times D X) -> Ob I) (is-monotone-ob (times D X) I)
   (uncurry-fn (Ob-map F)) (Ob-map (exp-comparison X I D F))
   (Psi (ob-action D (Fun X I) F)).2 (ob-action (times D X) I (exp-comparison X I D F)).2
   (FL.funext (Ob (times D X)) (\ u -> Ob I) (uncurry-fn (Ob-map F)) (Ob-map (exp-comparison X I D F)) (\ u ->
     H.transH (ev-point X I (Ob-map F (prpi1 u)) (prpi2 u)) (H.symH (eval-lemma X D F u))))
   (is-monotone-ob-is-prop (times D X) I I-thin (Ob-map (exp-comparison X I D F))) ;

 composite : Pl.Equiv (Map D (Fun X I)) (MonoOb D (Fun X I)) =
  EL.then (Map D (Fun X I)) (MonoOb (times D X) I) (MonoOb D (Fun X I))
   (EL.then (Map D (Fun X I)) (Map (times D X) I) (MonoOb (times D X) I) (exp-equiv X I D)
     (ob-action (times D X) I, I-posetal-clause2 (times D X)))
   (EL.inverse (MonoOb D (Fun X I)) (MonoOb (times D X) I) psi-equiv) ;

 clause2 : Pl.isEquiv (Map D (Fun X I)) (MonoOb D (Fun X I)) (ob-action D (Fun X I)) =
  EL.homotopy (Map D (Fun X I)) (MonoOb D (Fun X I)) composite.1 (ob-action D (Fun X I))
   (\ F -> H.transH (H.apH Phi (H.symH (sq F)))
     (Pl.sec-ret (MonoOb D (Fun X I)) (MonoOb (times D X) I) Psi psi-equiv.2 (ob-action D (Fun X I) F)))
   composite.2 ;
} ;

Fun-I-posetal (X : Cat) : is-posetal (Fun X I) = (Fun-I-thin X, \ D -> FunI[X, D].clause2, ob-FunXI-is-set X) ;

Delta-posetal : (n : Nat) -> is-posetal (Delta n) = split {
 zero -> is-posetal-One ;
 suc n -> Fun-I-posetal (Delta n) } ;
