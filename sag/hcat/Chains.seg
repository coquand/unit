-- Chains of composable morphisms and the spine of a simplex (M6, steps 1
-- and 2).  Level 1.
--   HChain C n x: chains of n composable morphisms of C ending at x
--   (Wärn, Lemma 26: objects a_0 .. a_n with morphisms a_i -> a_(i+1)):
--     HChain C 0 x = Top,
--     HChain C (n+1) x = (y : Ob C) * HChain C n y * Hom C y x,
--   a chain glued to a morphism at its last vertex.  TC C n is the total
--   space (x : Ob C) * HChain C n x.
--   Chain-map F: a functor maps a chain vertex by vertex (Ob-map) and edge
--   by edge (Hom-map).
--   The universal spine univ-chain n : HChain (Delta n) n (top n): empty
--   for n = 0; for n + 1 the image of the spine of Delta n under the face
--   Delta n -> Delta (n+1), glued to the last edge, whose domain is
--   face n (top n) (face-top) and codomain top (n+1) (edge-cod).
--   spine C n s: the spine of s : Delta n -> C is the image of the
--   universal spine under s.
open Base ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open LastEdge ; open FaceMap ; open FaceTop ;

HChain (C : Cat) : Nat -> Ob C -> U l = split {
 zero -> \ x -> Top ;
 suc n | r -> \ x -> (y : Ob C) * r y * Hom C y x } ;

TC (C : Cat) (n : Nat) : U l = (x : Ob C) * HChain C n x ;

Chain-map {A B : Cat} (F : Map A B) : (n : Nat) (x : Ob A) -> HChain A n x -> HChain B n (Ob-map F x) = split {
 zero -> \ x c -> tt ;
 suc n | r -> \ x c -> (Ob-map F c.1, r c.1 c.2.1, Hom-map F c.1 x c.2.2) } ;

TC-map {A B : Cat} (F : Map A B) (n : Nat) (t : TC A n) : TC B n = (Ob-map F t.1, Chain-map F n t.1 t.2) ;

le-hom (n : Nat) : Hom (Delta (suc n)) (Ob-map (face n) (top n)) (top (suc n)) =
 (last-edge n, H.symH (face-top n), edge-cod n) ;

univ-chain : (n : Nat) -> HChain (Delta n) n (top n) = split {
 zero -> tt ;
 suc n | r -> (Ob-map (face n) (top n), Chain-map (face n) n (top n) r, le-hom n) } ;

spine (C : Cat) (n : Nat) (s : Map (Delta n) C) : HChain C n (Ob-map s (top n)) =
 Chain-map s n (top n) (univ-chain n) ;

spine-total (C : Cat) (n : Nat) (s : Map (Delta n) C) : TC C n = TC-map s n (top n, univ-chain n) ;

-- by definition: the spine of a (n+1)-simplex
spine-suc (C : Cat) (n : Nat) (s : Map (Delta (suc n)) C) :
 Id (HChain C (suc n) (Ob-map s (top (suc n)))) (spine C (suc n) s)
  (Ob-map s (Ob-map (face n) (top n)), Chain-map s n (Ob-map (face n) (top n)) (Chain-map (face n) n (top n) (univ-chain n)),
   Hom-map s (Ob-map (face n) (top n)) (top (suc n)) (le-hom n)) =
 refl (spine C (suc n) s) ;
