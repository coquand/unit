-- Sets of components and loop groups (for homology groups, H4).  Type
-- theory only.
--   pi0 Y: Y modulo mere equality (Quotient: replacement, funext and
--   propUA), a set; cls y its class.  pi0-map f: the induced map, with
--   pi0-map-cls; pi0-equiv: an equivalence induces one (induction on
--   classes, the target being a set).
--   LoopGrp Y y0: the group pi_1 (Y, y0) on pi0 (Omega (Y, y0)), with path
--   composition (QGrp; as em/PiOne, whose maps part is not needed).
--   transport-grp: a group structure moves along an equivalence of a
--   type with its carrier (a retract of a set is a set; each law is the
--   law of the group after cancelling e o e^-1).
--   is-abelian; transport-ab: transport keeps commutativity.
--   loop-ab: pi_1 (Y, y0) is abelian when loops at y0 commute.
level l ; open Base ; open Prelude[l] ; open Paths[l] ; open Group[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ; module PA = PathAlgebra[l] ;

module Merely (Y : U l) {
 Same (u v : Y) : U l = Tr.Trunc[Id Y u v].carrier ;
 same-prop (u v : Y) : isProp (Same u v) = Tr.Trunc[Id Y u v].proposition ;
 same-refl (u : Y) : Same u u = Tr.Trunc[Id Y u u].inc (refl u) ;
 same-sym (u v : Y) (h : Same u v) : Same v u = TC.map (Id Y u v) (Id Y v u) (\ p -> symH p) h ;
 same-trans (u v w : Y) (h : Same u v) (k : Same v w) : Same u w =
  TC.map2 (Id Y u v) (Id Y v w) (Id Y u w) (\ p q -> transH p q) h k ;
 module Q = Quotient[l].Quot[Y, Same, same-prop, same-refl, same-sym, same-trans] ;
} ;

pi0 (Y : U l) : U l = Merely[Y].Q.Q ;
cls {Y : U l} (y : Y) : pi0 Y = Merely[Y].Q.inc y ;
pi0-set (Y : U l) : isSet (pi0 Y) = Merely[Y].Q.set ;
pi0-ind (Y : U l) : [j] (P : pi0 Y -> U j) -> ((q : pi0 Y) -> Prelude[j].isProp (P q)) -> ((y : Y) -> P (cls y)) -> (q : pi0 Y) -> P q =
 Merely[Y].Q.induction ;
-- equal classes come from merely equal points
pi0-eff (Y : U l) (u v : Y) (p : Id (pi0 Y) (cls u) (cls v)) : Tr.Trunc[Id Y u v].carrier = Merely[Y].Q.effective u v p ;
pi0-rel (Y : U l) (u v : Y) (h : Tr.Trunc[Id Y u v].carrier) : Id (pi0 Y) (cls u) (cls v) = Merely[Y].Q.relates u v h ;

pi0-map (Y Y1 : U l) (f : Y -> Y1) (q : pi0 Y) : pi0 Y1 =
 Merely[Y].Q.Descend[pi0 Y1, pi0-set Y1, \ y -> cls (f y),
  \ a b r -> pi0-rel Y1 (f a) (f b) (TC.map (Id Y a b) (Id Y1 (f a) (f b)) (\ p -> apH f p) r)].map q ;

pi0-map-cls (Y Y1 : U l) (f : Y -> Y1) (y : Y) : Id (pi0 Y1) (pi0-map Y Y1 f (cls y)) (cls (f y)) =
 Merely[Y].Q.Descend[pi0 Y1, pi0-set Y1, \ y1 -> cls (f y1),
  \ a b r -> pi0-rel Y1 (f a) (f b) (TC.map (Id Y a b) (Id Y1 (f a) (f b)) (\ p -> apH f p) r)].beta y ;

-- pi0-map g o pi0-map f = id when g o f = id pointwise
pi0-map-inv (Y Y1 : U l) (f : Y -> Y1) (g : Y1 -> Y) (h : (y : Y) -> Id Y (g (f y)) y) (q : pi0 Y) :
 Id (pi0 Y) (pi0-map Y1 Y g (pi0-map Y Y1 f q)) q =
 pi0-ind Y @l (\ q1 -> Id (pi0 Y) (pi0-map Y1 Y g (pi0-map Y Y1 f q1)) q1) (\ q1 -> pi0-set Y (pi0-map Y1 Y g (pi0-map Y Y1 f q1)) q1)
  (\ y -> transH (apH (pi0-map Y1 Y g) (pi0-map-cls Y Y1 f y)) (transH (pi0-map-cls Y1 Y g (f y)) (apH (\ t -> cls t) (h y)))) q ;

pi0-equiv (Y Y1 : U l) (e : Equiv Y Y1) : Equiv (pi0 Y) (pi0 Y1) =
 (pi0-map Y Y1 e.1,
  qinv (pi0 Y) (pi0 Y1) (pi0-map Y Y1 e.1) (pi0-map Y1 Y e.2.sec)
   (pi0-map-inv Y1 Y e.2.sec e.1 e.2.sec-eq) (pi0-map-inv Y Y1 e.1 e.2.sec (sec-ret Y Y1 e.1 e.2))) ;

------------------------------------------------------------------------
-- loop groups

module LoopGrp (Y : U l) (y0 : Y) {
 O : U l = Id Y y0 y0 ;
 comp (u v : O) : O = transH u v ;
 rev (u : O) : O = symH u ;
 comp-resp (a a1 b b1 : O) (r : Merely[O].Same a a1) (s : Merely[O].Same b b1) : Merely[O].Same (comp a b) (comp a1 b1) =
  TC.map2 (Id O a a1) (Id O b b1) (Id O (comp a b) (comp a1 b1)) (\ p q -> transH (apH (\ z -> comp z b) p) (apH (comp a1) q)) r s ;
 rev-resp (a a1 : O) (r : Merely[O].Same a a1) : Merely[O].Same (rev a) (rev a1) =
  TC.map (Id O a a1) (Id O (rev a) (rev a1)) (apH rev) r ;
 module P = QGrp[l].QGrp[O, Merely[O].Same, Merely[O].same-prop, Merely[O].same-refl, Merely[O].same-sym, Merely[O].same-trans,
  refl y0, comp, rev, comp-resp, rev-resp, \ x y z -> PA.tassoc x y z, \ x -> PA.unit-l x, \ x -> refl x,
  \ x -> PA.inv-l x, \ x -> PA.inv-r x] ;
 grp : Grp = P.grp ;
 -- the carrier is pi0 O, by definition
 carrier-pi0 : Id (U l) grp.G (pi0 O) = refl (pi0 O) ;
 cl-mul (a b : O) : Id grp.G (grp.mul (cls a) (cls b)) (cls (comp a b)) = P.cl-mul a b ;
 cl-inv (a : O) : Id grp.G (grp.inv (cls a)) (cls (rev a)) = P.cl-inv a ;
} ;

------------------------------------------------------------------------
-- moving a group structure along an equivalence

module TransportGrp (G : Grp) (X : U l) (e : Equiv X G.G) {
 to : X -> G.G = e.1 ;
 from : G.G -> X = e.2.sec ;
 te (g : G.G) : Id G.G (to (from g)) g = e.2.sec-eq g ;
 ft (x : X) : Id X (from (to x)) x = sec-ret X G.G e.1 e.2 x ;
 setX : isSet X = isSet-retract X G.G to from ft G.setG ;
 mul (x y : X) : X = from (G.mul (to x) (to y)) ;
 one : X = from G.e ;
 inv (x : X) : X = from (G.inv (to x)) ;
 assoc (x y z : X) : Id X (mul (mul x y) z) (mul x (mul y z)) =
  apH from (transH (apH (\ t -> G.mul t (to z)) (te (G.mul (to x) (to y))))
   (transH (G.assoc (to x) (to y) (to z)) (symH (apH (G.mul (to x)) (te (G.mul (to y) (to z))))))) ;
 unitl (x : X) : Id X (mul one x) x =
  transH (apH from (transH (apH (\ t -> G.mul t (to x)) (te G.e)) (G.unitl (to x)))) (ft x) ;
 unitr (x : X) : Id X (mul x one) x =
  transH (apH from (transH (apH (G.mul (to x)) (te G.e)) (G.unitr (to x)))) (ft x) ;
 invl (x : X) : Id X (mul (inv x) x) one =
  apH from (transH (apH (\ t -> G.mul t (to x)) (te (G.inv (to x)))) (G.invl (to x))) ;
 invr (x : X) : Id X (mul x (inv x)) one =
  apH from (transH (apH (G.mul (to x)) (te (G.inv (to x)))) (G.invr (to x))) ;
 grp : Grp = new Grp[X, setX, one, mul, inv, assoc, unitl, unitr, invl, invr] ;
} ;

is-abelian (G : Grp) : U l = (x y : G.G) -> Id G.G (G.mul x y) (G.mul y x) ;

transport-ab (G : Grp) (X : U l) (e : Equiv X G.G) (ab : is-abelian G) : is-abelian TransportGrp[G, X, e].grp =
 \ x y -> apH TransportGrp[G, X, e].from (ab (e.1 x) (e.1 y)) ;

loop-ab (Y : U l) (y0 : Y) (c : (a b : Id Y y0 y0) -> Id (Id Y y0 y0) (transH a b) (transH b a)) : is-abelian LoopGrp[Y, y0].grp =
 \ x y -> pi0-ind (Id Y y0 y0) @l (\ x1 -> Id LoopGrp[Y, y0].grp.G (LoopGrp[Y, y0].grp.mul x1 y) (LoopGrp[Y, y0].grp.mul y x1))
  (\ x1 -> LoopGrp[Y, y0].grp.setG (LoopGrp[Y, y0].grp.mul x1 y) (LoopGrp[Y, y0].grp.mul y x1))
  (\ a -> pi0-ind (Id Y y0 y0) @l (\ y1 -> Id LoopGrp[Y, y0].grp.G (LoopGrp[Y, y0].grp.mul (cls a) y1) (LoopGrp[Y, y0].grp.mul y1 (cls a)))
    (\ y1 -> LoopGrp[Y, y0].grp.setG (LoopGrp[Y, y0].grp.mul (cls a) y1) (LoopGrp[Y, y0].grp.mul y1 (cls a)))
    (\ b -> transH (LoopGrp[Y, y0].cl-mul a b) (transH (apH (\ t -> cls t) (c a b)) (symH (LoopGrp[Y, y0].cl-mul b a)))) y) x ;
