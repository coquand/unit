-- If loops at z commute, conjugating by a loop at z is the identity.
-- Consequently transport of loops to z is independent of the chosen
-- path. Homotopic maps into such a pointed type induce the same loop
-- map, with arbitrary pointing paths: no basepoint 2-cell is needed.
-- This applies to stable mapping spaces, and to loop spaces by
-- Eckmann-Hilton. It is a theorem of identity types, not a new axiom.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ; module PM = Pi0Maps[l] ;
open Conj[l] ; open Pi0[l] ;

module Target (Z : U l) (z : Z)
 (comm : (a b : Id Z z z) -> Id (Id Z z z) (H.transH a b) (H.transH b a)) {
 trivial (a b : Id Z z z) : Id (Id Z z z) (conj a b) b =
  H.transH (H.apH (\ r -> H.transH (H.symH a) r) (comm b a)) (PA.canc-l a b) ;
 pointing (x : Z) (p q : Id Z x z) (a : Id Z x x) :
  Id (Id Z z z) (conj p a) (conj q a) =
  H.idJR Z z (\ x1 q1 -> (p1 : Id Z x1 z) (a1 : Id Z x1 x1) ->
    Id (Id Z z z) (conj p1 a1) (conj q1 a1))
   (\ p1 a1 -> H.transH (trivial p1 a1) (H.symH (conj-refl-path a1))) x q p a ;
 module Homotopy (Y : U l) (y : Y) (f g : Y -> Z)
  (p : Id Z (f y) z) (q : Id Z (g y) z) (h : (x : Y) -> Id Z (f x) (g x)) {
  module F = PM.Pointed[Y, Z, y, z, f, p] ;
  module G = PM.Pointed[Y, Z, y, z, g, q] ;
  loops (a : Id Y y y) : Id (Id Z z z) (F.loop a) (G.loop a) =
   H.transH (H.apH (conj p)
     (conj-square (h y) (H.apH f a) (H.apH g a)
      (FibreTowerNaturality.homotopy-square Y Z f g h y y a)))
    (H.transH (conj-trans (H.symH (h y)) p (H.apH g a))
     (pointing (g y) (H.transH (H.symH (h y)) p) q (H.apH g a))) ;
  groups (a : LoopGrp[Y, y].grp.G) : Id LoopGrp[Z, z].grp.G (F.M.map a) (G.M.map a) =
   pi0-ind (Id Y y y) @l
    (\ a1 -> Id LoopGrp[Z, z].grp.G (F.M.map a1) (G.M.map a1))
    (\ a1 -> LoopGrp[Z, z].grp.setG (F.M.map a1) (G.M.map a1))
    (\ r -> H.transH (pi0-map-cls (Id Y y y) (Id Z z z) F.loop r)
     (H.transH (H.apH (\ s -> cls s) (loops r))
      (H.symH (pi0-map-cls (Id Y y y) (Id Z z z) G.loop r)))) a ;
 } ;
 module Factor (A B : U l) (a : A) (b : B)
  (f : A -> B) (g : B -> Z) (h : A -> Z)
  (pf : Id B (f a) b) (pg : Id Z (g b) z) (ph : Id Z (h a) z)
  (htpy : (x : A) -> Id Z (g (f x)) (h x)) {
  module F = PM.Pointed[A, B, a, b, f, pf] ;
  module G = PM.Pointed[B, Z, b, z, g, pg] ;
  module R = PM.Pointed[A, Z, a, z, h, ph] ;
  module Compare = Homotopy[A, a, \ x -> g (f x), h, H.transH (H.apH g pf) pg, ph, htpy] ;
  loops (r : Id A a a) : Id (Id Z z z) (G.loop (F.loop r)) (R.loop r) =
   H.transH (FibreTowerNaturality.loop-composite A B Z a b z f pf g pg r) (Compare.loops r) ;
  groups (r : LoopGrp[A, a].grp.G) : Id LoopGrp[Z, z].grp.G (G.M.map (F.M.map r)) (R.M.map r) =
   PM.factor (Id A a a) (Id B b b) (Id Z z z) F.loop G.loop R.loop loops r ;
 } ;
 -- A homotopy-commuting square gives a square of loop maps without
 -- asking that its value at the basepoint match the four pointings.
 module Square (A B C : U l) (a : A) (b : B) (c : C)
  (f : A -> B) (g : C -> Z) (u : A -> C) (v : B -> Z)
  (pf : Id B (f a) b) (pg : Id Z (g c) z)
  (pu : Id C (u a) c) (pv : Id Z (v b) z)
  (h : (x : A) -> Id Z (v (f x)) (g (u x))) {
  module F = PM.Pointed[A, B, a, b, f, pf] ;
  module G = PM.Pointed[C, Z, c, z, g, pg] ;
  module UMap = PM.Pointed[A, C, a, c, u, pu] ;
  module VMap = PM.Pointed[B, Z, b, z, v, pv] ;
  module Compare = Homotopy[A, a, \ x -> v (f x), \ x -> g (u x),
   H.transH (H.apH v pf) pv, H.transH (H.apH g pu) pg, h] ;
  loops (r : Id A a a) : Id (Id Z z z) (VMap.loop (F.loop r)) (G.loop (UMap.loop r)) =
   H.transH (FibreTowerNaturality.loop-composite A B Z a b z f pf v pv r)
    (H.transH (Compare.loops r)
     (H.symH (FibreTowerNaturality.loop-composite A C Z a c z u pu g pg r))) ;
  groups (r : LoopGrp[A, a].grp.G) :
   Id LoopGrp[Z, z].grp.G (VMap.M.map (F.M.map r)) (G.M.map (UMap.M.map r)) =
   PM.square (Id A a a) (Id B b b) (Id C c c) (Id Z z z)
    F.loop G.loop UMap.loop VMap.loop loops r ;
 } ;
} ;
