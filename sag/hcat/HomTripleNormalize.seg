-- Both ACTUAL HMOC3 paths normalized to Hom-eq along the same arrow.
-- Join the five cells of the long path and remove its two reflexive
-- arrow steps. HomTripleShort already normalizes the short path and
-- moves its arrow along the ambient pentagon. Thus two explicitly
-- stated endpoint equations imply HMOC3 (from-endpoints).
-- Those equations still have to be identified with the K5 routes.
-- This file does not assume them as axiom-system parameters, nor prove
-- them from k5. It makes the remaining obligation precise.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open HomPaths ; open HomCells ;

module Triple (A B C D : Cat) (F : Map C D) (G : Map B C) (K : Map A B) (m : Mor A) {
 module L = HomTripleLongCells.Triple[A, B, C, D, F, G, K, m] ;
 module S = HomTripleShort.Triple[A, B, C, D, F, G, K, m] ;
 module T = HomTriple.Triple[A, B, C, D, F, G, K, m] ;
 module R = At[D, L.x, L.y] ;
 c45 : Cell[D, L.x, L.y, L.h3, T.target] = R.join L.h3 L.h4 T.target L.cell4 L.Mc.cell ;
 c345 : Cell[D, L.x, L.y, L.h2, T.target] = R.join L.h2 L.h3 T.target L.Nc.cell c45 ;
 c2345 : Cell[D, L.x, L.y, L.h1, T.target] = R.join L.h1 L.h2 T.target L.Ch2.cell c345 ;
 cell : Cell[D, L.x, L.y, T.source, T.target] = R.join T.source L.h1 T.target L.cell1 c2345 ;
 form45 : Id (Id (Hom D L.x L.y) L.h3 T.target)
  (H.transH L.step4 L.step5) (R.read L.h3 T.target c45) =
  H.transH (PA.tcong L.form4 L.form5) (R.join-read L.h3 L.h4 T.target L.cell4 L.Mc.cell) ;
 form345 : Id (Id (Hom D L.x L.y) L.h2 T.target)
  (H.transH L.step3 (H.transH L.step4 L.step5)) (R.read L.h2 T.target c345) =
  H.transH (PA.tcong L.form3 form45) (R.join-read L.h2 L.h3 T.target L.Nc.cell c45) ;
 form2345 : Id (Id (Hom D L.x L.y) L.h1 T.target)
  (H.transH L.step2 (H.transH L.step3 (H.transH L.step4 L.step5))) (R.read L.h1 T.target c2345) =
  H.transH (PA.tcong L.form2 form345) (R.join-read L.h1 L.h2 T.target L.Ch2.cell c345) ;
 form : Id (Id (Hom D L.x L.y) T.source T.target) T.long (R.read T.source T.target cell) =
  H.transH (PA.tcong L.form1 form2345) (R.join-read T.source L.h1 T.target L.cell1 c2345) ;

 arrow-form : Id (Id (Mor D) (hmor T.source) (hmor T.target)) cell.arrow S.long-path =
  H.transH (PA.unit-l c2345.arrow)
   (H.transH (H.apH (\ r -> H.transH L.Ch2.cell.arrow (H.transH L.Nc.cell.arrow r)) (PA.unit-l L.Mc.cell.arrow))
    (H.symH (PA.tassoc L.Ch2.cell.arrow L.Nc.cell.arrow L.Mc.cell.arrow))) ;
 left : Id (Id (Ob D) (dom (hmor T.source)) L.x) (hdom T.source) (S.Compare.dom-path S.long-path) =
  H.transH cell.left (H.apH S.Compare.dom-path arrow-form) ;
 right : Id (Id (Ob D) (cod (hmor T.source)) L.y) (hcod T.source) (S.Compare.cod-path S.long-path) =
  H.transH cell.right (H.apH S.Compare.cod-path arrow-form) ;
 long-form : Id (Id (Hom D L.x L.y) T.source T.target)
  T.long (Hom-eq D T.source T.target S.long-path left right) =
  H.transH form (S.Compare.Move[cell.arrow, cell.left, cell.right].move S.long-path arrow-form) ;

 LeftCoherence : U l = Id (Id (Id (Ob D) (dom (hmor T.source)) L.x) (hdom T.source) (S.Compare.dom-path S.long-path)) S.moved-dom left ;
 RightCoherence : U l = Id (Id (Id (Ob D) (cod (hmor T.source)) L.y) (hcod T.source) (S.Compare.cod-path S.long-path)) S.moved-cod right ;
 from-endpoints (ep : LeftCoherence) (eq : RightCoherence) : T.Coherence =
  H.transH S.short-long-form
   (H.transH (S.Compare.ends S.long-path S.moved-dom left S.moved-cod right ep eq) (H.symH long-form)) ;
} ;
