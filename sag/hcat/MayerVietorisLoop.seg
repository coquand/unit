-- A connecting homomorphism in every positive target degree, obtained
-- by looping the preceding POINTED connecting map.
-- For a pushout square and S, delta_S:Hom(Sigma S,P)->Hom(S,C) is
-- pointed (MayerVietorisExact.delta-point-path). Define
-- deltaLoop_S = L_(S,C)^-1 . Omega(delta_S) . L_(Sigma S,P).
-- Pi0Maps.Pointed and Transport prove multiplication, unit and inverse
-- for exactly the existing LoopGroup structures. No new parameters.
-- IMPORTANT: agreement with the original delta_(Sigma S) is a separate
-- compatibility statement, recorded below but NOT assumed or proved.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PM = Pi0Maps[l] ;
open HigherCat ; open Constructions ; open Composition ; open Zero ; open Loops ; open HGroups ; open Pi0[l] ;

module Connecting (Cc Bb Ee P : Ob D) (ii : Hom D Cc Bb) (jj : Hom D Cc Ee)
 (uu : Hom D Bb P) (vv : Hom D Ee P)
 (ss : Id (Hom D Cc P) (hcomp {D} ii uu) (hcomp {D} jj vv))
 (po : DPushout.DSquare[Cc, Bb, Ee, P, ii, jj, uu, vv, ss].is-pushout) (S : Ob D) {
 module X = MayerVietorisExact.Exact[Cc, Bb, Ee, P, ii, jj, uu, vv, ss, po, S] ;
 module N = MayerVietoris.MV[Cc, Bb, Ee, P, ii, jj, uu, vv, ss, po, susp S] ;
 module A = LoopGroup[susp S, P] ; module B = LoopGroup[S, Cc] ;
 module F = PM.Pointed[Hom D (susp S) P, Hom D S Cc,
  zmap (susp S) P, zmap S Cc, X.M.delta, X.delta-point-path] ;
 delta (g : Hom D (susp (susp S)) P) : Hom D (susp S) Cc =
  (LoopOf[S].L-equiv Cc).sec (F.loop (LoopOf[susp S].L P g)) ;
 beta (g : Hom D (susp (susp S)) P) :
  Id (LoopOf[S].Om Cc) (LoopOf[S].L Cc (delta g)) (F.loop (LoopOf[susp S].L P g)) =
  (LoopOf[S].L-equiv Cc).sec-eq (F.loop (LoopOf[susp S].L P g)) ;
 opaque delta ;
 map (q : A.grp.G) : B.grp.G =
  pi0-map (Hom D (susp (susp S)) P) (Hom D (susp S) Cc) delta q ;
 square (q : A.grp.G) : Id (LoopGrp[Hom D S Cc, zmap S Cc].grp.G) (B.e.1 (map q)) (F.M.map (A.e.1 q)) =
  PM.square (Hom D (susp (susp S)) P) (Hom D (susp S) Cc)
   (LoopOf[susp S].Om P) (LoopOf[S].Om Cc)
   delta F.loop (LoopOf[susp S].L P) (LoopOf[S].L Cc) beta q ;
 mul : PM.is-hom A.grp B.grp map =
  PM.Transport[LoopGrp[Hom D (susp S) P, zmap (susp S) P].grp, LoopGrp[Hom D S Cc, zmap S Cc].grp,
   pi0 (Hom D (susp (susp S)) P), pi0 (Hom D (susp S) Cc), A.e, B.e,
   map, F.M.map, F.M.mul, square].mul ;
 one : Id B.grp.G (map A.grp.e) B.grp.e = PM.Laws[A.grp, B.grp, map, mul].one ;
 inverse (q : A.grp.G) : Id B.grp.G (map (A.grp.inv q)) (B.grp.inv (map q)) =
  PM.Laws[A.grp, B.grp, map, mul].inverse q ;

 -- A sufficient comparison for the original connecting map. Only its
 -- consequence on components is needed for the homomorphism theorem.
 Compatibility : U l = (g : Hom D (susp (susp S)) P) ->
  Id (LoopOf[S].Om Cc) (LoopOf[S].L Cc (N.delta g)) (F.loop (LoopOf[susp S].L P g)) ;
 ComponentCompatibility : U l = (q : A.grp.G) ->
  Id (LoopGrp[Hom D S Cc, zmap S Cc].grp.G) (B.e.1 (N.delta0 q)) (F.M.map (A.e.1 q)) ;
 original-mul-components (comm : ComponentCompatibility) : PM.is-hom A.grp B.grp N.delta0 =
  PM.Transport[LoopGrp[Hom D (susp S) P, zmap (susp S) P].grp, LoopGrp[Hom D S Cc, zmap S Cc].grp,
   pi0 (Hom D (susp (susp S)) P), pi0 (Hom D (susp S) Cc), A.e, B.e,
   N.delta0, F.M.map, F.M.mul, comm].mul ;
 original-mul (comm : Compatibility) : PM.is-hom A.grp B.grp N.delta0 =
  original-mul-components (\ q -> PM.square (Hom D (susp (susp S)) P) (Hom D (susp S) Cc)
    (LoopOf[susp S].Om P) (LoopOf[S].Om Cc)
    N.delta F.loop (LoopOf[susp S].L P) (LoopOf[S].L Cc) comm q) ;
} ;

module Types (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) (n : Nat) {
 module Ex = Excision.ExcisionOf[B, C, E, X, i, j, u, v, h, A] ;
 module Q = Connecting[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, Sph n] ;
} ;
