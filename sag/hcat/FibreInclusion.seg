-- The fibre of inclusion of one fibre of a family is the loop space
-- of its base, retaining the path projected to the base.
-- More generally fib(q |-> (a,q), (a1,b1)) ~ (a=a1).
-- Expand a path of pairs, interchange the two sums, and contract the
-- fibre of transport. The explicit forward map is ap pr1 on the path.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module EL = EquivalenceLemmas[l] ;
module CU = FunExtUA[l] ;
open FibreLemmas ;

module Inclusion (A : U l) (B : A -> U l) (a a1 : A) (b1 : B a1) {
 Total : U l = (x : A) * B x ;
 F : U l = fib {B a} {Total} (\ b -> (a, b)) (a1, b1) ;
 K (p : Id A a a1) : U l = fib {B a} {B a1} (H.substH B p) b1 ;
 transport-equiv (x : A) (p : Id A a x) : Pl.isEquiv (B a) (B x) (H.substH B p) =
  idJ A a (\ x1 p1 -> Pl.isEquiv (B a) (B x1) (H.substH B p1)) (Pl.idEquiv (B a)).2 x p ;
 contract (p : Id A a a1) : CU.isContr (K p) =
  equiv-fibre-contr (B a) (B a1) (H.substH B p) (transport-equiv a1 p) b1 ;
 Expanded : U l = (b : B a) * (p : Id A a a1) * Id (B a1) (H.substH B p b) b1 ;
 expanded : Pl.Equiv F Expanded =
  SigmaEquiv.Sigma-fiberwise-equiv (B a)
   (\ b -> Id Total (a, b) (a1, b1))
   (\ b -> (p : Id A a a1) * Id (B a1) (H.substH B p b) b1)
   (\ b -> FibreAlg.sigma-path-equiv A B (a, b) (a1, b1)) ;
 Swapped : U l = (p : Id A a a1) * K p ;
 swap : Pl.Equiv Expanded Swapped =
  (\ w -> (w.2.1, w.1, w.2.2),
   Pl.qinv Expanded Swapped (\ w -> (w.2.1, w.1, w.2.2))
    (\ w -> (w.2.1, w.1, w.2.2)) (\ w -> refl w) (\ w -> refl w)) ;
 projection : Pl.Equiv Swapped (Id A a a1) =
  (\ w -> w.1,
   Pl.qinv Swapped (Id A a a1) (\ w -> w.1) (\ p -> (p, (contract p).1))
    (\ p -> refl p) (\ w -> H.apH (\ t -> (w.1, t)) ((contract w.1).2 w.2))) ;
 computed : Pl.Equiv F (Id A a a1) =
  EL.then F Expanded (Id A a a1) expanded (EL.then Expanded Swapped (Id A a a1) swap projection) ;
 read (w : F) : Id A a a1 = H.apH (\ t -> t.1) w.2 ;
 read-equiv : Pl.isEquiv F (Id A a a1) read =
  EL.homotopy F (Id A a a1) computed.1 read
   (\ w -> FibreAlg.sPath-fst A B (a, w.1) (a1, b1) w.2) computed.2 ;
} ;
