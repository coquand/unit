-- The groupoid laws of paths, with hidden endpoints (Paths.seg), for the
-- 2-cell algebra of the wild category Cat.  Prelude's trans is J on the
-- second path, so  trans p refl = p  holds by definition (unit-r), and
-- each law below is one J on the last path, whose base case is refl or
-- the left unit law.  (Agda's _∙_ is J on the first path: its definitional
-- unit is on the other side, so ported proofs are mirrored.)
--   unit-l     refl . p = p
--   tassoc     (p . q) . r = p . (q . r)
--   inv-l      p^-1 . p = refl,  inv-r  p . p^-1 = refl
--   sym-sym, sym-trans (p . q)^-1 = q^-1 . p^-1
--   ap-trans, ap-sym, ap-comp, ap-id, ap-refl: the functoriality of ap
--   tcong      p = p' and q = q' give p . q = p' . q'
--   canc-l     a^-1 . (a . q) = q;  canc-r (q . a) . a^-1 = q
--   cancel-l, cancel-r: a . q = a . r gives q = r; q . a = r . a gives q = r
level l ; open Base ;
module H = Paths[l] ;

unit-r {A : U l} {x y : A} (p : Id A x y) : Id (Id A x y) (H.transH p (refl y)) p = refl p ;

unit-l {A : U l} {x y : A} (p : Id A x y) : Id (Id A x y) (H.transH (refl x) p) p =
 idJ A x (\ y1 p1 -> Id (Id A x y1) (H.transH (refl x) p1) p1) (refl (refl x)) y p ;

tassoc {A : U l} {x y z w : A} (p : Id A x y) (q : Id A y z) (r : Id A z w) :
 Id (Id A x w) (H.transH (H.transH p q) r) (H.transH p (H.transH q r)) =
 idJ A z (\ w1 r1 -> Id (Id A x w1) (H.transH (H.transH p q) r1) (H.transH p (H.transH q r1)))
  (refl (H.transH p q)) w r ;

inv-l {A : U l} {x y : A} (p : Id A x y) : Id (Id A y y) (H.transH (H.symH p) p) (refl y) =
 idJ A x (\ y1 p1 -> Id (Id A y1 y1) (H.transH (H.symH p1) p1) (refl y1)) (refl (refl x)) y p ;

inv-r {A : U l} {x y : A} (p : Id A x y) : Id (Id A x x) (H.transH p (H.symH p)) (refl x) =
 idJ A x (\ y1 p1 -> Id (Id A x x) (H.transH p1 (H.symH p1)) (refl x)) (refl (refl x)) y p ;

sym-sym {A : U l} {x y : A} (p : Id A x y) : Id (Id A x y) (H.symH (H.symH p)) p =
 idJ A x (\ y1 p1 -> Id (Id A x y1) (H.symH (H.symH p1)) p1) (refl (refl x)) y p ;

sym-trans {A : U l} {x y z : A} (p : Id A x y) (q : Id A y z) :
 Id (Id A z x) (H.symH (H.transH p q)) (H.transH (H.symH q) (H.symH p)) =
 idJ A y (\ z1 q1 -> Id (Id A z1 x) (H.symH (H.transH p q1)) (H.transH (H.symH q1) (H.symH p)))
  (H.symH (unit-l (H.symH p))) z q ;

ap-refl {A B : U l} (f : A -> B) (x : A) : Id (Id B (f x) (f x)) (H.apH f (refl x)) (refl (f x)) = refl (refl (f x)) ;

ap-trans {A B : U l} (f : A -> B) {x y z : A} (p : Id A x y) (q : Id A y z) :
 Id (Id B (f x) (f z)) (H.apH f (H.transH p q)) (H.transH (H.apH f p) (H.apH f q)) =
 idJ A y (\ z1 q1 -> Id (Id B (f x) (f z1)) (H.apH f (H.transH p q1)) (H.transH (H.apH f p) (H.apH f q1)))
  (refl (H.apH f p)) z q ;

ap-sym {A B : U l} (f : A -> B) {x y : A} (p : Id A x y) :
 Id (Id B (f y) (f x)) (H.apH f (H.symH p)) (H.symH (H.apH f p)) =
 idJ A x (\ y1 p1 -> Id (Id B (f y1) (f x)) (H.apH f (H.symH p1)) (H.symH (H.apH f p1))) (refl (refl (f x))) y p ;

ap-comp {A B C : U l} (g : B -> C) (f : A -> B) {x y : A} (p : Id A x y) :
 Id (Id C (g (f x)) (g (f y))) (H.apH g (H.apH f p)) (H.apH (\ a -> g (f a)) p) =
 idJ A x (\ y1 p1 -> Id (Id C (g (f x)) (g (f y1))) (H.apH g (H.apH f p1)) (H.apH (\ a -> g (f a)) p1))
  (refl (refl (g (f x)))) y p ;

ap-id {A : U l} {x y : A} (p : Id A x y) : Id (Id A x y) (H.apH (\ a -> a) p) p =
 idJ A x (\ y1 p1 -> Id (Id A x y1) (H.apH (\ a -> a) p1) p1) (refl (refl x)) y p ;

tcong {A : U l} {x y z : A} {p p1 : Id A x y} {q q1 : Id A y z}
 (a : Id (Id A x y) p p1) (b : Id (Id A y z) q q1) : Id (Id A x z) (H.transH p q) (H.transH p1 q1) =
 H.transH (H.apH (\ u -> H.transH u q) a) (H.apH (\ v -> H.transH p1 v) b) ;

canc-l {A : U l} {x y z : A} (a : Id A x y) (q : Id A y z) :
 Id (Id A y z) (H.transH (H.symH a) (H.transH a q)) q =
 idJ A y (\ z1 q1 -> Id (Id A y z1) (H.transH (H.symH a) (H.transH a q1)) q1) (inv-l a) z q ;

canc-r {A : U l} {x y z : A} (a : Id A x y) (q : Id A z x) :
 Id (Id A z x) (H.transH (H.transH q a) (H.symH a)) q =
 H.transH (tassoc q a (H.symH a)) (H.apH (\ v -> H.transH q v) (inv-r a)) ;

cancel-l {A : U l} {x y z : A} (a : Id A x y) {q r : Id A y z}
 (h : Id (Id A x z) (H.transH a q) (H.transH a r)) : Id (Id A y z) q r =
 H.transH (H.symH (canc-l a q)) (H.transH (H.apH (\ u -> H.transH (H.symH a) u) h) (canc-l a r)) ;

cancel-r {A : U l} {x y z : A} {q r : Id A x y} (a : Id A y z)
 (h : Id (Id A x z) (H.transH q a) (H.transH r a)) : Id (Id A x y) q r =
 idJ A y (\ z1 a1 -> Id (Id A x z1) (H.transH q a1) (H.transH r a1) -> Id (Id A x y) q r)
  (\ h1 -> h1) z a h ;
