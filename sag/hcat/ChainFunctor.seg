-- Chain-map is functorial (M6).  Level 2.
--   Chain-map-of-comp: Chain-map (F o G) c, its last vertex moved by the
--   reassociator, is Chain-map F (Chain-map G c).  By induction on the
--   length: the empty chains agree (Top is a proposition); for a glued
--   chain (y, c, h), moving along the last vertex changes only the
--   codomain of h (subst-HChain-suc), and the glued chains agree over the
--   reassociator at y (chain-suc-eq) by induction for c and by
--   Hom-map-of-comp for h.
open Base ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open Chains ; open HomPaths ; open HomFunctor ;

Chain-map-of-comp {A B C : Cat} (F : Map B C) (G : Map A B) : (n : Nat) (x : Ob A) (c : HChain A n x) ->
 Id (HChain C n (Ob-map F (Ob-map G x)))
  (H.substH (HChain C n) (composeA {One} {A} {B} {C} F G x) (Chain-map (comp F G) n x c))
  (Chain-map F n (Ob-map G x) (Chain-map G n x c)) = split {
 zero -> \ x c -> isTop (H.substH (HChain C zero) (composeA {One} {A} {B} {C} F G x) (Chain-map (comp F G) zero x c)) tt ;
 suc n | r -> \ x c ->
  H.transH (subst-HChain-suc C n (composeA {One} {A} {B} {C} F G x) (Chain-map (comp F G) (suc n) x c))
   (chain-suc-eq C n {Ob-map F (Ob-map G x)} {Ob-map (comp F G) c.1} {Ob-map F (Ob-map G c.1)} (composeA {One} {A} {B} {C} F G c.1)
     (Chain-map (comp F G) n c.1 c.2.1) (Chain-map F n (Ob-map G c.1) (Chain-map G n c.1 c.2.1))
     (Hom-coerce C (refl (Ob-map (comp F G) c.1)) (composeA {One} {A} {B} {C} F G x) (Hom-map (comp F G) c.1 x c.2.2))
     (Hom-map F (Ob-map G c.1) (Ob-map G x) (Hom-map G c.1 x c.2.2))
     (r c.1 c.2.1) (Hom-map-of-comp F G c.1 x c.2.2)) } ;
