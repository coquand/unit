-- Maps into a product form a set when the maps into the factors do (Agda
-- Pushout.agda, prod-hom-is-set): Map X (A x B) ~ Map X A * Map X B
-- (prod-comp-equiv), and a product of sets is a set.
open Base ;
module Pl = Prelude[l] ;
open WildCat ; open Pullbacks ; open ProductMap ;

prod-hom-is-set (X A B : Cat) (sA : Pl.isSet (Map X A)) (sB : Pl.isSet (Map X B)) : Pl.isSet (Map X (times A B)) =
 AffineHLevels[l].set-from-equiv (Map X (times A B)) (Map X A * Map X B)
  (Pl.isSet-Sigma (Map X A) (\ f -> Map X B) sA (\ f -> sB))
  (prod-comparison A B X) (prod-comp-equiv A B X) ;
