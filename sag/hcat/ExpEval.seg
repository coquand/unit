-- Evaluating a transpose at an object (Agda Category/ExpEval).  For
-- h : X x A -> B with transpose u and x : Ob X, the functor A -> B named
-- by the object u o x of Fun A B is h o <x o !, 1>.  Both sides are
-- ev o <u o (x o !), 1>:
--   ob-to-map (u o x) = (ev o <(u o x) o pi1, pi2>) o unit-right
--     = ev o <((u o x) o pi1) o unit-right, pi2 o unit-right>   (pair-nat)
--     = ev o <u o (x o !), 1>                                     (pair-beta)
--   h o <x o !, 1> = (ev o <u o pi1, pi2>) o <x o !, 1>          (u is the transpose)
--     = ev o <(u o pi1) o <x o !, 1>, pi2 o <x o !, 1>>           (pair-nat)
--     = ev o <u o (x o !), 1>                                     (pair-beta)
open Base ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open ExpComparison ; open Exponentials ;

slice {X A : Cat} (x : Ob X) : Map A (times X A) = pair (comp {A} {One} {X} x (bang A)) (idMap A) ;

exp-eval (A B X : Cat) (h : Map (times X A) B) (x : Ob X) :
 Id (Map A B) (ob-to-map A B (comp {One} {X} {Fun A B} ((exp-is-equiv A B X).sec h) x)) (comp h (slice {X} {A} x)) =
 H.transH lhs-chain (H.symH rhs-chain)
 where {
  u : Map X (Fun A B) = (exp-is-equiv A B X).sec h ;
  ux : Map One (Fun A B) = comp {One} {X} {Fun A B} u x ;
  uxb : Map A (Fun A B) = comp {A} {X} {Fun A B} u (comp {A} {One} {X} x (bang A)) ;
  lhs-chain : Id (Map A B) (ob-to-map A B ux) (comp (ev A B) (pair uxb (idMap A))) =
   H.transH (composeA (ev A B) (pair (comp ux (pi1 One A)) (pi2 One A)) (unit-right A))
    (ccr (ev A B) (H.transH (pair-nat (comp ux (pi1 One A)) (pi2 One A) (unit-right A))
     (pair-ap (H.transH (composeA ux (pi1 One A) (unit-right A))
               (H.transH (ccr ux (pair-beta1 (bang A) (idMap A))) (composeA {A} {One} {X} {Fun A B} u x (bang A))))
              (pair-beta2 (bang A) (idMap A))))) ;
  rhs-chain : Id (Map A B) (comp h (slice {X} {A} x)) (comp (ev A B) (pair uxb (idMap A))) =
   H.transH (ccl (slice {X} {A} x) (H.symH ((exp-is-equiv A B X).sec-eq h)))
    (H.transH (composeA (ev A B) (pair (comp u (pi1 X A)) (pi2 X A)) (slice {X} {A} x))
     (ccr (ev A B) (H.transH (pair-nat (comp u (pi1 X A)) (pi2 X A) (slice {X} {A} x))
      (pair-ap (H.transH (composeA u (pi1 X A) (slice {X} {A} x))
                (ccr u (pair-beta1 (comp {A} {One} {X} x (bang A)) (idMap A))))
               (pair-beta2 (comp {A} {One} {X} x (bang A)) (idMap A)))))) ;
 } ;
