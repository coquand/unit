-- Pullbacks and binary products (Wärn Axiom 13, Remark 14; Agda
-- Category/Pullbacks).  Parameters used: pb, pb-pr1, pb-pr2, pb-comm,
-- pb-is-equiv, One, terminal.
--   pb-equiv: Map X (pb f g) ~ Cone f g X.
--   times A B is the pullback of A -> One <- B.  A cone over it is a pair
--   of maps: the square lies in Map X One, which is contractible, so its
--   component is the path joining the two composites (cone-of).  pair h k
--   is the inverse of the comparison at cone-of h k; pair-beta1/2 are the
--   first two components of the section law; pair-eta: the cone of u is
--   cone-of (pi1 o u) (pi2 o u), since two paths in Map X One are equal
--   (a contractible type is a set), so pair (pi1 o u, pi2 o u) = u by the
--   retraction law.
--   prod-comparison u = (pi1 o u, pi2 o u), with section pair.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Constructions ; open PullbackCone ;

pb-equiv {B A C : Cat} (f : Map B A) (g : Map C A) (X : Cat) : Pl.Equiv (Map X (pb f g)) (Cone f g X) =
 (pb-comparison f g X, pb-is-equiv f g X) ;

times (A B : Cat) : Cat = pb (bang A) (bang B) ;
pi1 (A B : Cat) : Map (times A B) A = pb-pr1 (bang A) (bang B) ;
pi2 (A B : Cat) : Map (times A B) B = pb-pr2 (bang A) (bang B) ;

-- two maps into One are joined by a path, and two such paths are equal
one-path {X : Cat} (u v : Map X One) : Id (Map X One) u v = CU.pathC (Map X One) (terminal X) u v ;
one-set {X : Cat} : Pl.isSet (Map X One) = Pl.prop-to-set (Map X One) (\ u v -> one-path u v) ;

cone-of {A B X : Cat} (h : Map X A) (k : Map X B) : Cone (bang A) (bang B) X =
 (h, k, one-path (comp (bang A) h) (comp (bang B) k)) ;

pair {A B X : Cat} (h : Map X A) (k : Map X B) : Map X (times A B) =
 (pb-is-equiv (bang A) (bang B) X).sec (cone-of h k) ;

pair-beta1 {A B X : Cat} (h : Map X A) (k : Map X B) : Id (Map X A) (comp (pi1 A B) (pair h k)) h =
 H.apH (\ c -> c.1) ((pb-is-equiv (bang A) (bang B) X).sec-eq (cone-of h k)) ;

pair-beta2 {A B X : Cat} (h : Map X A) (k : Map X B) : Id (Map X B) (comp (pi2 A B) (pair h k)) k =
 H.apH (\ c -> c.2.1) ((pb-is-equiv (bang A) (bang B) X).sec-eq (cone-of h k)) ;

cone-of-comparison {A B X : Cat} (u : Map X (times A B)) :
 Id (Cone (bang A) (bang B) X) (cone-of (comp (pi1 A B) u) (comp (pi2 A B) u)) (pb-comparison (bang A) (bang B) X u) =
 H.apH (\ w -> (comp (pi1 A B) u, comp (pi2 A B) u, w))
  (one-set (comp (bang A) (comp (pi1 A B) u)) (comp (bang B) (comp (pi2 A B) u))
   (one-path (comp (bang A) (comp (pi1 A B) u)) (comp (bang B) (comp (pi2 A B) u)))
   (pb-comparison (bang A) (bang B) X u).2.2) ;

pair-eta {A B X : Cat} (u : Map X (times A B)) : Id (Map X (times A B)) (pair (comp (pi1 A B) u) (comp (pi2 A B) u)) u =
 H.transH (H.apH (pb-is-equiv (bang A) (bang B) X).sec (cone-of-comparison u))
  (Pl.sec-ret (Map X (times A B)) (Cone (bang A) (bang B) X) (pb-comparison (bang A) (bang B) X)
   (pb-is-equiv (bang A) (bang B) X) u) ;

prod-comparison (A B X : Cat) (u : Map X (times A B)) : Map X A * Map X B =
 (comp (pi1 A B) u, comp (pi2 A B) u) ;

prod-section (A B X : Cat) (p : Map X A * Map X B) : Map X (times A B) = pair p.1 p.2 ;

prod-roundtrip (A B X : Cat) (p : Map X A * Map X B) :
 Id (Map X A * Map X B) (prod-comparison A B X (prod-section A B X p)) p =
 AffineHLevels[l].pair-path (Map X A) (Map X B) (comp (pi1 A B) (pair p.1 p.2)) p.1 (comp (pi2 A B) (pair p.1 p.2)) p.2
  (pair-beta1 p.1 p.2) (pair-beta2 p.1 p.2) ;

-- two cones over One-One are equal when their legs are (the squares lie
-- in Map X One, a set): J on the two legs
cone-eq {A B X : Cat} (h1 : Map X A) (k1 : Map X B) (s1 : Id (Map X One) (comp (bang A) h1) (comp (bang B) k1)) :
 (h2 : Map X A) (p : Id (Map X A) h1 h2) (k2 : Map X B) (q : Id (Map X B) k1 k2)
 (s2 : Id (Map X One) (comp (bang A) h2) (comp (bang B) k2)) ->
 Id (Cone (bang A) (bang B) X) (h1, k1, s1) (h2, k2, s2) =
 \ h2 p -> idJ (Map X A) h1 (\ h3 p3 -> (k2 : Map X B) (q : Id (Map X B) k1 k2)
   (s2 : Id (Map X One) (comp (bang A) h3) (comp (bang B) k2)) ->
   Id (Cone (bang A) (bang B) X) (h1, k1, s1) (h3, k2, s2))
  (\ k2 q -> idJ (Map X B) k1 (\ k3 q3 -> (s2 : Id (Map X One) (comp (bang A) h1) (comp (bang B) k3)) ->
     Id (Cone (bang A) (bang B) X) (h1, k1, s1) (h1, k3, s2))
    (\ s2 -> H.apH (\ w -> (h1, k1, w)) (one-set (comp (bang A) h1) (comp (bang B) k1) s1 s2)) k2 q)
  h2 p ;

-- pairing is natural: <g1, g2> o f = <g1 o f, g2 o f>, both having the
-- legs g1 o f, g2 o f (pb-comparison is injective)
pair-nat {A B X Y : Cat} (g1 : Map X A) (g2 : Map X B) (f : Map Y X) :
 Id (Map Y (times A B)) (comp (pair g1 g2) f) (pair (comp g1 f) (comp g2 f)) =
 Equivalences[l].injective (Map Y (times A B)) (Cone (bang A) (bang B) Y) (pb-comparison (bang A) (bang B) Y)
  (pb-is-equiv (bang A) (bang B) Y) (comp (pair g1 g2) f) (pair (comp g1 f) (comp g2 f))
  (cone-eq (comp (pi1 A B) (comp (pair g1 g2) f)) (comp (pi2 A B) (comp (pair g1 g2) f))
   (pb-comparison (bang A) (bang B) Y (comp (pair g1 g2) f)).2.2
   (comp (pi1 A B) (pair (comp g1 f) (comp g2 f)))
   (H.transH (comp-assoc (pi1 A B) (pair g1 g2) f)
    (H.transH (ccl f (pair-beta1 g1 g2)) (H.symH (pair-beta1 (comp g1 f) (comp g2 f)))))
   (comp (pi2 A B) (pair (comp g1 f) (comp g2 f)))
   (H.transH (comp-assoc (pi2 A B) (pair g1 g2) f)
    (H.transH (ccl f (pair-beta2 g1 g2)) (H.symH (pair-beta2 (comp g1 f) (comp g2 f)))))
   (pb-comparison (bang A) (bang B) Y (pair (comp g1 f) (comp g2 f))).2.2) ;

pair-ap {A B X : Cat} {h1 h2 : Map X A} {k1 k2 : Map X B}
 (p : Id (Map X A) h1 h2) (q : Id (Map X B) k1 k2) : Id (Map X (times A B)) (pair h1 k1) (pair h2 k2) =
 H.transH (H.apH (\ h -> pair h k1) p) (H.apH (\ k -> pair h2 k) q) ;
