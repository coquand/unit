-- The comparison of Axiom 18 (Agda Interval/Interval): f : C -> I goes to
-- its action on objects, monotone since a morphism m of C gives the
-- morphism f o m of I, whose domain and codomain are ordered by
-- I-mor-order and are f (dom m), f (cod m) by the reassociator.
open Base ; open Finite[l] ;
module H = Paths[l] ;
open WildCat ; open HigherCat ; open Constructions ; open OrdMonotone ; open MonotoneMaps ;

I-char-comparison (C : Cat) (f : Map C I) : Monotone C =
 (ob-to-2 f, \ m -> leq2-transport (H.apH I-ob.1 (dom-nat f m)) (H.apH I-ob.1 (cod-nat f m)) (I-mor-order (comp f m))) ;
