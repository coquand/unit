-- Evaluation at the point of Delta 1 (Agda Squares/PushoutBase).
--   eval-pt-ob: eval-pt on an object f of Delta 1 = Fun One I is the functor
--   f names (eval-pt-eq; the two pairings One -> One x One agree).
--   eval-pt-dom-last: eval-pt sends the domain of the last edge of Delta 1
--   to I0 (its functor is face 0 (top 0), whose value is face-ord = 0);
--   eval-pt-top1: it sends top 1 = I1 o ! to I1.
--   eval-pt-last-edge: eval-pt o last-edge 0 = 1_I, both being morphisms
--   I0 -> I1 of I (I-hom-contr).
open Base ; open Finite[l] ;
module H = Paths[l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ; open ExpComparison ; open Exponentials ; open UnitIso ;
open Interval ; open IntervalPosetal ; open LastEdge ; open FaceMap ; open FaceTop ;

eval-pt-ob (f : Ob (Delta (suc zero))) : Id (Ob I) (Ob-map eval-pt f) (ob-to-map One I f) =
 H.transH (eval-pt-eq One f)
  (ccr (exp-comparison One I One f) (pair-ap (one-path (idMap One) (bang One)) (one-path (bang One) (idMap One)))) ;

eval-pt-dom-last : Id (Ob I) (Ob-map eval-pt (dom (last-edge zero))) I0 =
 Equivalences[l].injective (Ob I) Two I-ob.1 I-ob.2 (Ob-map eval-pt (dom (last-edge zero))) I0
  (H.transH (H.apH I-ob.1 (eval-pt-ob (dom (last-edge zero))))
  (H.transH (H.apH (\ x -> I-ob.1 (ob-to-map One I x)) (H.symH (face-top zero)))
  (H.transH (H.apH I-ob.1 (H.symH (comp-id-r {One} {I} (ob-to-map One I (Ob-map (face zero) (top zero))))))
  (H.transH (face-pw zero (idMap One)) (H.symH (I-ob.2.sec-eq zero2)))))) ;

eval-pt-top1 : Id (Ob I) (Ob-map eval-pt (top (suc zero))) I1 =
 H.transH (eval-pt-ob (top (suc zero)))
 (H.transH (ob-map-roundtrip1 One I (comp {One} {One} {I} I1 (bang One)))
 (H.transH (ccr {One} {One} {I} I1 (one-path (bang One) (idMap One))) (comp-id-r {One} {I} I1))) ;

eval-pt-last-edge : Id (Map I I) (comp eval-pt (last-edge zero)) (idMap I) =
 H.apH (\ h -> hmor h) (CU.pathC (Hom I I0 I1) I-hom-contr
  (funct-on-mor eval-pt (last-edge zero),
   H.transH (dom-nat eval-pt (last-edge zero)) eval-pt-dom-last,
   H.transH (cod-nat eval-pt (last-edge zero)) (H.transH (H.apH (Ob-map eval-pt) (edge-cod zero)) eval-pt-top1))
  gen-hom) ;
