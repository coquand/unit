-- Fibres of maps of types (generic; used by M6 and M7).  Level 1.
--   fib f b = (a : A) * (f a = b).
--   equiv-fibre-contr: the fibres of an equivalence are contractible.  By
--   induction on equivalences (univalence) it suffices to take the
--   identity, whose fibre over b is the singleton (a : A) * (a = b).
--   fibre-contr-equiv: conversely, a map with contractible fibres is an
--   equivalence: the inverse sends b to the centre of its fibre, and
--   (a, refl) lies in the fibre over f a, so a is that centre.
--   id-equiv-of-contr (the fundamental theorem of identity types): if the
--   total space of Q is contractible and q0 : Q a, then
--   p |-> subst Q p q0 : (a = b) -> Q b is an equivalence.  The inverse
--   sends q to the first projection of the path (a, q0) = (b, q); moving
--   q0 along it gives q (Sigma-snd); at refl that path is a loop in a
--   contractible type, hence refl.
--   equiv-ind: along an equivalence e, two sections of a family over the
--   codomain that agree at every e x agree everywhere (y = e (sec y)).
--   is-embedding f: every ap f is an equivalence.  embedding-fibre-prop:
--   then the fibres of f are propositions: (x, p), (x', p') are joined
--   over the path x = x' that f sends to p . p'^-1.
--   embedding-surjective-equiv: an embedding that is surjective (every
--   fibre merely inhabited) is an equivalence, since its fibres are then
--   inhabited propositions.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module CU = FunExtUA[l] ;
module UL = Axioms[l].UnivalenceLemmas[univ @l] ;

fib {A B : U l} (f : A -> B) (b : B) : U l = (a : A) * Id B (f a) b ;

equiv-fibre-contr (A B : U l) (f : A -> B) (ef : Pl.isEquiv A B f) (b : B) : CU.isContr (fib f b) =
 UL.eqind A (\ B1 e1 -> (b1 : B1) -> CU.isContr (fib e1.1 b1)) (\ b1 -> CU.sing A b1) B (f, ef) b ;

fibre-contr-equiv (A B : U l) (f : A -> B) (c : (b : B) -> CU.isContr (fib f b)) : Pl.isEquiv A B f =
 Pl.qinv A B f (\ b -> (c b).1.1) (\ b -> (c b).1.2)
  (\ a -> H.apH (\ w -> w.1) (CU.pathC (fib f (f a)) (c (f a)) (c (f a)).1 (a, refl (f a)))) ;

module IdEquiv (A : U l) (a : A) (Q : A -> U l) (q0 : Q a) (c : CU.isContr ((b : A) * Q b)) {
 to (b : A) (p : Id A a b) : Q b = H.substH Q p q0 ;
 from (b : A) (q : Q b) : Id A a b = H.apH (\ w -> w.1) (CU.pathC ((b1 : A) * Q b1) c (a, q0) (b, q)) ;
 to-from (b : A) (q : Q b) : Id (Q b) (to b (from b q)) q =
  Pl.Sigma-snd A Q a b q0 q (CU.pathC ((b1 : A) * Q b1) c (a, q0) (b, q)) ;
 from-to (b : A) (p : Id A a b) : Id (Id A a b) (from b (to b p)) p =
  idJ A a (\ b1 p1 -> Id (Id A a b1) (from b1 (to b1 p1)) p1)
   (H.apH (\ r -> H.apH {(b1 : A) * Q b1} {A} (\ w -> w.1) r) (CU.pathC-refl ((b1 : A) * Q b1) c (a, q0))) b p ;
 equiv (b : A) : Pl.isEquiv (Id A a b) (Q b) (to b) = Pl.qinv (Id A a b) (Q b) (to b) (from b) (to-from b) (from-to b) ;
} ;

id-equiv-of-contr (A : U l) (a : A) (Q : A -> U l) (q0 : Q a) (c : CU.isContr ((b : A) * Q b)) (b : A) :
 Pl.isEquiv (Id A a b) (Q b) (\ p -> H.substH Q p q0) = IdEquiv[A, a, Q, q0, c].equiv b ;

equiv-ind {X Y : U l} (e : X -> Y) (ee : Pl.isEquiv X Y e) (Q : Y -> U l) (s t : (y : Y) -> Q y)
 (h : (x : X) -> Id (Q (e x)) (s (e x)) (t (e x))) (y : Y) : Id (Q y) (s y) (t y) =
 idJ Y (e (ee.sec y)) (\ y1 p1 -> Id (Q y1) (s y1) (t y1)) (h (ee.sec y)) y (ee.sec-eq y) ;

is-embedding {A B : U l} (f : A -> B) : U l = (x y : A) -> Pl.isEquiv (Id A x y) (Id B (f x) (f y)) (\ p -> H.apH f p) ;

-- moving the path of a fibre along a path of A
subst-fib {A B : U l} (f : A -> B) (b : B) {x x1 : A} (al : Id A x x1) (p : Id B (f x) b) :
 Id (Id B (f x1) b) (H.substH (\ a -> Id B (f a) b) al p) (H.transH (H.symH (H.apH f al)) p) =
 idJ A x (\ x2 al2 -> Id (Id B (f x2) b) (H.substH (\ a -> Id B (f a) b) al2 p) (H.transH (H.symH (H.apH f al2)) p))
  (H.symH (PA.unit-l p)) x1 al ;

embedding-fibre-prop {A B : U l} (f : A -> B) (emb : is-embedding f) (b : B) : Pl.isProp (fib f b) = \ u v ->
 Pl.Sigma-path A (\ a -> Id B (f a) b) u.1 v.1 u.2 v.2 (al u v)
  (H.transH (subst-fib f b (al u v) u.2)
   (H.transH (H.apH (\ r -> H.transH (H.symH r) u.2) ((emb u.1 v.1).sec-eq (H.transH u.2 (H.symH v.2))))
    (H.transH (H.apH (\ r -> H.transH r u.2) (PA.sym-trans u.2 (H.symH v.2)))
     (H.transH (H.apH (\ r -> H.transH (H.transH r (H.symH u.2)) u.2) (PA.sym-sym v.2))
      (H.transH (PA.tassoc v.2 (H.symH u.2) u.2) (H.apH (\ r -> H.transH v.2 r) (PA.inv-l u.2)))))))
 where {
  al (u v : fib f b) : Id A u.1 v.1 = (emb u.1 v.1).sec (H.transH u.2 (H.symH v.2)) ;
 } ;

is-surjective {A B : U l} (f : A -> B) : U l = (b : B) -> Truncation[l].Trunc[fib f b].carrier ;

embedding-surjective-equiv (A B : U l) (f : A -> B) (emb : is-embedding f) (surj : is-surjective f) :
 Pl.isEquiv A B f =
 fibre-contr-equiv A B f (\ b -> (point b, \ v -> embedding-fibre-prop f emb b (point b) v))
 where {
  point (b : B) : fib f b =
   Truncation[l].Trunc[fib f b].induction @l (\ x -> fib f b) (\ x -> embedding-fibre-prop f emb b) (\ w -> w) (surj b) ;
 } ;

-- three facts about equivalences used in M7
--   prop-equiv: logically equivalent propositions are equivalent.
--   cancel-equiv: if e and e o g are equivalences, so is g (g is
--   e^-1 o (e o g)).
--   prod-equiv: a product of equivalences is one.
prop-equiv (P Q : U l) (pP : Pl.isProp P) (pQ : Pl.isProp Q) (to : P -> Q) (from : Q -> P) : Pl.Equiv P Q =
 (to, Pl.qinv P Q to from (\ q -> pQ (to (from q)) q) (\ p -> pP (from (to p)) p)) ;

cancel-equiv (A B C : U l) (g : A -> B) (e : B -> C) (ee : Pl.isEquiv B C e) (eg : Pl.isEquiv A C (\ a -> e (g a))) :
 Pl.isEquiv A B g =
 EquivalenceLemmas[l].homotopy A B (\ a -> ee.sec (e (g a))) g (\ a -> Pl.sec-ret B C e ee (g a))
  (EquivalenceLemmas[l].compose A C B ee.sec (\ a -> e (g a)) (EquivalenceLemmas[l].inverse B C (e, ee)).2 eg) ;

prod-equiv (A B A1 B1 : U l) (f : A -> A1) (g : B -> B1) (ef : Pl.isEquiv A A1 f) (eg : Pl.isEquiv B B1 g) :
 Pl.isEquiv (A * B) (A1 * B1) (\ w -> (f w.1, g w.2)) =
 Pl.qinv (A * B) (A1 * B1) (\ w -> (f w.1, g w.2)) (\ w -> (ef.sec w.1, eg.sec w.2))
  (\ w -> H.transH (H.apH {A1} {A1 * B1} (\ u -> (u, g (eg.sec w.2))) (ef.sec-eq w.1))
           (H.apH {B1} {A1 * B1} (\ v -> (w.1, v)) (eg.sec-eq w.2)))
  (\ w -> H.transH (H.apH {A} {A * B} (\ u -> (u, eg.sec (g w.2))) (Pl.sec-ret A A1 f ef w.1))
           (H.apH {B} {A * B} (\ v -> (w.1, v)) (Pl.sec-ret B B1 g eg w.2))) ;

-- fibrewise-from-total: if the total map (a, p) |-> (a, f a p) of a
-- fibrewise map is an equivalence, each f a is.  The fibre of f a over q
-- is a retract of the fibre of the total map over (a, q): a point
-- ((a1, p1), E) of the latter gives p1 moved along E.1 : a1 = a, which
-- f a sends to q (subst-fibrewise, Sigma-snd); at (p, refl) this is
-- (p, refl) by computation, and J on the path of the fibre gives the
-- retraction law.  A retract of a contractible type is contractible.
subst-fibrewise (A : U l) (P Q : A -> U l) (f : (a : A) -> P a -> Q a) {a1 a : A} (al : Id A a1 a) (p : P a1) :
 Id (Q a) (f a (H.substH P al p)) (H.substH Q al (f a1 p)) =
 idJ A a1 (\ a2 al2 -> Id (Q a2) (f a2 (H.substH P al2 p)) (H.substH Q al2 (f a1 p))) (refl (f a1 p)) a al ;

module FibreRetract (A : U l) (P Q : A -> U l) (f : (a : A) -> P a -> Q a) (a : A) {
 tot (w : (x : A) * P x) : (x : A) * Q x = (w.1, f w.1 w.2) ;
 to (q : Q a) (u : fib (f a) q) : fib tot (a, q) = ((a, u.1), H.apH {Q a} {(x : A) * Q x} (\ v -> (a, v)) u.2) ;
 from (q : Q a) (u : fib tot (a, q)) : fib (f a) q =
  (H.substH P (H.apH {(x : A) * Q x} {A} (\ w -> w.1) u.2) u.1.2,
   H.transH (subst-fibrewise A P Q f (H.apH {(x : A) * Q x} {A} (\ w -> w.1) u.2) u.1.2)
    (Pl.Sigma-snd A Q u.1.1 a (f u.1.1 u.1.2) q u.2)) ;
 from-to (q : Q a) (u : fib (f a) q) : Id (fib (f a) q) (from q (to q u)) u =
  idJ (Q a) (f a u.1) (\ q1 r1 -> Id (fib (f a) q1) (from q1 (to q1 (u.1, r1))) (u.1, r1)) (refl (u.1, refl (f a u.1))) q u.2 ;
} ;

fibrewise-from-total (A : U l) (P Q : A -> U l) (f : (a : A) -> P a -> Q a)
 (e : Pl.isEquiv ((x : A) * P x) ((x : A) * Q x) (\ w -> (w.1, f w.1 w.2))) (a : A) : Pl.isEquiv (P a) (Q a) (f a) =
 fibre-contr-equiv (P a) (Q a) (f a) (\ q ->
  (FibreRetract[A, P, Q, f, a].from q (c q).1,
   \ u -> H.transH (H.apH (FibreRetract[A, P, Q, f, a].from q) (CU.pathC (fib (FibreRetract[A, P, Q, f, a].tot) (a, q)) (c q) (c q).1 (FibreRetract[A, P, Q, f, a].to q u)))
     (FibreRetract[A, P, Q, f, a].from-to q u)))
 where {
  c (q : Q a) : CU.isContr (fib (FibreRetract[A, P, Q, f, a].tot) (a, q)) =
   equiv-fibre-contr ((x : A) * P x) ((x : A) * Q x) (FibreRetract[A, P, Q, f, a].tot) e (a, q) ;
 } ;
