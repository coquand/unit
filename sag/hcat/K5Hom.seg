-- The endpoint part of ambient K5 lifted to paths in Hom.
-- For three functors F,G,K and a morphism m, start at (((FG)K)m)
-- with endpoint paths K5.L, and end at F(G(Km)) with the final three
-- endpoint reassociations. The long morphism path has three steps:
-- a(F,G,K)m, a(F,GK,m), F a(G,K,m).
-- At an endpoint v, qd and path associativity identify its restriction
-- followed by the final endpoint path with K5.R. Thus each route L=R
-- gives endpoint witnesses for Hom-eq along that morphism path.
-- K5 at I0 and I1, followed by congruence in the endpoint witnesses,
-- proves that the two lifted Hom paths agree.
-- This is the endpoint comparison needed for HMOC3. Identification of
-- these lifted paths with composites of Hom-map-of-comp remains separate.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open HomPaths ;

module Triple (A B C D : Cat) (F : Map C D) (G : Map B C) (K : Map A B) (m : Mor A) {
 first : Mor D = comp (comp (comp F G) K) m ;
 last : Mor D = comp F (comp G (comp K m)) ;
 long-path : Id (Mor D) first last =
  H.transH (H.transH (ccl {I} {A} {D} m (composeA {A} {B} {C} {D} F G K))
   (composeA {I} {A} {C} {D} F (comp G K) m)) (ccr {I} {C} {D} F (composeA {I} {A} {B} {C} G K m)) ;

 module Endpoint (v : Ob I) {
  module P = CatK5.K5[One, I, A, B, C, D, F, G, K, m, v] ;
  finish : Id (Ob D) (comp {One} {I} {D} last v) P.Vend = H.transH P.r4 (H.transH P.r5 P.r6) ;

  normalize : Id (Id (Ob D) P.V0 P.Vend)
   (H.transH (ccl {One} {I} {D} v long-path) finish) P.R =
   H.transH (H.apH (\ r -> H.transH r finish) P.qd)
    (H.transH (PA.tassoc (H.transH P.r1 P.r2) P.r3 finish)
     (PA.tassoc P.r1 P.r2 (H.transH P.r3 finish))) ;

  route1 : Id (Id (Ob D) P.V0 P.Vend) P.L (H.transH (ccl {One} {I} {D} v long-path) finish) =
   H.transH P.route1 (H.symH normalize) ;
  route2 : Id (Id (Ob D) P.V0 P.Vend) P.L (H.transH (ccl {One} {I} {D} v long-path) finish) =
   H.transH P.route2 (H.symH normalize) ;

  coherence : Id (Id (Id (Ob D) P.V0 P.Vend) P.L (H.transH (ccl {One} {I} {D} v long-path) finish)) route1 route2 =
   H.apH {Id (Id (Ob D) P.V0 P.Vend) P.L P.R}
    {Id (Id (Ob D) P.V0 P.Vend) P.L (H.transH (ccl {One} {I} {D} v long-path) finish)}
    (\ r -> H.transH r (H.symH normalize)) (k5 {One} {I} {A} {B} {C} {D} F G K m v) ;
 } ;

 module E0 = Endpoint[I0] ; module E1 = Endpoint[I1] ;
 source : Hom D E0.P.Vend E1.P.Vend = (first, E0.P.L, E1.P.L) ;
 target : Hom D E0.P.Vend E1.P.Vend = (last, E0.finish, E1.finish) ;

 route1 : Id (Hom D E0.P.Vend E1.P.Vend) source target = Hom-eq D source target long-path E0.route1 E1.route1 ;
 route2 : Id (Hom D E0.P.Vend E1.P.Vend) source target = Hom-eq D source target long-path E0.route2 E1.route2 ;

 coherence : Id (Id (Hom D E0.P.Vend E1.P.Vend) source target) route1 route2 =
  HomEqHigher.Compare[D, E0.P.Vend, E1.P.Vend, source, target].ends long-path
   E0.route1 E0.route2 E1.route1 E1.route2 E0.coherence E1.coherence ;
} ;
