-- The loop-difference map of PullbackSource is ordinary difference of
-- the two maps on pi_2. LoopDifference supplies its group formula;
-- LoopProduct supplies the two independent arguments. Thus the same
-- structural boundary is exact at pi_2(P), with the usual difference.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PM = Pi0Maps[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
open Pi0[l] ;

module Source (B E P : U l) (f : B -> P) (g : E -> P) (b : B) (e : E) (z : P)
 (u : Id P (f b) z) (v : Id P (g e) z) {
 module Q = PullbackSource.Source[B, E, P, f, g, b, e, z, u, v] ;
 module Product = LoopProduct.Product[B, E, b, e] ;
 module F = PM.Pointed[B, P, b, z, f, u] ;
 module G = PM.Pointed[E, P, e, z, g, v] ;
 module FL = PM.Pointed[Id B b b, Q.O, refl b, refl z, F.loop, Conj[l].conj-one u] ;
 module GL = PM.Pointed[Id E e e, Q.O, refl e, refl z, G.loop, Conj[l].conj-one v] ;
 module L = LoopGrp[Q.O, refl z] ;
 module D = LoopDifference.At[P, z].Maps[Q.V, refl (b, e),
  \ r -> F.loop (H.apH (\ t -> t.1) r), \ r -> G.loop (H.apH (\ t -> t.2) r),
  Conj[l].conj-one u, Conj[l].conj-one v, Q.difference-point] ;
 module Left = Q.Comm.Factor[Q.V, Id B b b, refl (b, e), refl b,
  \ r -> H.apH (\ t -> t.1) r, F.loop, \ r -> F.loop (H.apH (\ t -> t.1) r),
  refl (refl b), Conj[l].conj-one u, Conj[l].conj-one u, \ r -> refl (F.loop (H.apH (\ t -> t.1) r))] ;
 module Right = Q.Comm.Factor[Q.V, Id E e e, refl (b, e), refl e,
  \ r -> H.apH (\ t -> t.2) r, G.loop, \ r -> G.loop (H.apH (\ t -> t.2) r),
  refl (refl e), Conj[l].conj-one v, Conj[l].conj-one v, \ r -> refl (G.loop (H.apH (\ t -> t.2) r))] ;
 difference (a : LoopGrp[Id B b b, refl b].grp.G) (c : LoopGrp[Id E e e, refl e].grp.G) : L.grp.G =
  PM.diff L.grp (FL.M.map a) (GL.M.map c) ;
 formula (r : LoopGrp[Q.V, refl (b, e)].grp.G) :
  Id L.grp.G (Q.Diff.M.map r) (difference (Product.Left.M.map r) (Product.Right.M.map r)) =
  H.transH (D.formula r)
   (H.transH (H.apH (\ t -> PM.diff L.grp t (D.G.M.map r)) (H.symH (Left.groups r)))
    (H.apH (PM.diff L.grp (FL.M.map (Product.Left.M.map r))) (H.symH (Right.groups r)))) ;
 zero (a : LoopGrp[Id B b b, refl b].grp.G) (c : LoopGrp[Id E e e, refl e].grp.G) :
  Id LoopGrp[Q.F.Cone, Q.F.point].grp.G (Q.F.connecting (difference a c)) LoopGrp[Q.F.Cone, Q.F.point].grp.e =
  TC.rec ((r : LoopGrp[Q.V, refl (b, e)].grp.G) *
    Id LoopGrp[Id B b b, refl b].grp.G (Product.Left.M.map r) a * Id LoopGrp[Id E e e, refl e].grp.G (Product.Right.M.map r) c)
   @l (Id LoopGrp[Q.F.Cone, Q.F.point].grp.G (Q.F.connecting (difference a c)) LoopGrp[Q.F.Cone, Q.F.point].grp.e)
   (LoopGrp[Q.F.Cone, Q.F.point].grp.setG (Q.F.connecting (difference a c)) LoopGrp[Q.F.Cone, Q.F.point].grp.e)
   (\ t -> H.transH (H.apH Q.F.connecting
     (H.symH (H.transH (formula t.1)
      (H.transH (H.apH (\ r -> difference r (Product.Right.M.map t.1)) t.2.1)
       (H.apH (difference a) t.2.2))))) (Q.zero t.1)) (Product.lift a c) ;
 Image (q : L.grp.G) : U l =
  Tr.Trunc[(a : LoopGrp[Id B b b, refl b].grp.G) * (c : LoopGrp[Id E e e, refl e].grp.G) * Id L.grp.G (difference a c) q].carrier ;
 exact (q : L.grp.G)
  (h : Id LoopGrp[Q.F.Cone, Q.F.point].grp.G (Q.F.connecting q) LoopGrp[Q.F.Cone, Q.F.point].grp.e) : Image q =
  TC.map ((r : LoopGrp[Q.V, refl (b, e)].grp.G) * Id L.grp.G (Q.Diff.M.map r) q)
   ((a : LoopGrp[Id B b b, refl b].grp.G) * (c : LoopGrp[Id E e e, refl e].grp.G) * Id L.grp.G (difference a c) q)
   (\ t -> (Product.Left.M.map t.1, Product.Right.M.map t.1, H.transH (H.symH (formula t.1)) t.2)) (Q.exact q h) ;
} ;
