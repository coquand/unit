-- The Segal condition for all n (M6, step 3; Wärn, Lemma 26 in its
-- explicit form).  Level 2.
--   segal-all n C: the spine map  Map (Delta n) C -> TC C n,
--   s |-> (s (top n), the image of the universal spine under s), is an
--   equivalence.  By induction on n.
--   n = 0: TC C 0 = Ob C * Top, and s (top 0) = s.
--   n + 1: the spine map is homotopic to the composite of three
--   equivalences:
--     Map (Delta (n+1)) C ~ PushoutPair n C          (pushout-is-equiv)
--       a |-> (a o face n, a o last-edge n, a (face n (top n)) = dom ...),
--     PushoutPair n C ~ GluePair C n                  (induction, base change)
--       (s, m, p) |-> (spine-total s, m, p),
--     GluePair C n ~ TC C (n+1)                        (glue)
--       ((x, c), m, p : x = dom m) |-> (cod m, x, c, (m, p^-1, refl)).
--   They agree (spine-step): the last vertices by
--   xi : cod (a o last-edge n) = a (top (n+1)), the chains by
--   Chain-map-of-comp (the spine of a o face n is a applied to the image
--   of the spine of Delta n), the last morphisms by xi and
--   P^-1 . a(a, face n, top n) = a(a, last-edge n, I0) . (a o face-top^-1),
--   where P is the path of the pushout comparison.
--   filler-contr: the fillers of a chain, (s : Map (Delta n) C) with
--   spine-total s = w, form a contractible type.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open LastEdge ; open FaceMap ; open FaceTop ;
open PushoutDef ; open PushoutProof ; open SigmaEquiv ; open FibreLemmas ;
open Chains ; open HomPaths ; open ChainFunctor ; open SpineSquare ;

GluePair (C : Cat) (n : Nat) : U l = (t : TC C n) * (m : Mor C) * Id (Ob C) t.1 (dom {C} m) ;

glue (C : Cat) (n : Nat) (w : GluePair C n) : TC C (suc n) =
 (cod w.2.1, w.1.1, w.1.2, (w.2.1, H.symH w.2.2, refl (cod {C} w.2.1))) ;

unglue (C : Cat) (n : Nat) (t : TC C (suc n)) : GluePair C n =
 ((t.2.1, t.2.2.1), t.2.2.2.1, H.symH t.2.2.2.2.1) ;

glue-eq (C : Cat) (n : Nat) (y : Ob C) (c : HChain C n y) (m : Mor C) (p : Id (Ob C) (dom {C} m) y) :
 (x : Ob C) (q : Id (Ob C) (cod {C} m) x) ->
 Id (TC C (suc n)) (cod m, y, c, (m, H.symH (H.symH p), refl (cod {C} m))) (x, y, c, (m, p, q)) =
 \ x q -> idJ (Ob C) (cod {C} m) (\ x1 q1 -> Id (TC C (suc n)) (cod m, y, c, (m, H.symH (H.symH p), refl (cod {C} m))) (x1, y, c, (m, p, q1)))
  (H.apH {Id (Ob C) (dom {C} m) y} {TC C (suc n)} (\ v -> (cod m, y, c, (m, v, refl (cod {C} m)))) (PA.sym-sym p)) x q ;

glue-equiv (C : Cat) (n : Nat) : Pl.isEquiv (GluePair C n) (TC C (suc n)) (glue C n) =
 Pl.qinv (GluePair C n) (TC C (suc n)) (glue C n) (unglue C n)
  (\ t -> glue-eq C n t.2.1 t.2.2.1 t.2.2.2.1 t.2.2.2.2.1 t.1 t.2.2.2.2.2)
  (\ w -> H.apH {Id (Ob C) w.1.1 (dom w.2.1)} {GluePair C n} (\ v -> (w.1, w.2.1, v)) (PA.sym-sym w.2.2)) ;

-- the two endpoint 2-cells of the last morphism
module Step (C : Cat) (n : Nat) (a : Map (Delta (suc n)) C) {
 beta : Id (Ob C) (Ob-map (comp a (face n)) (top n)) (Ob-map a (Ob-map (face n) (top n))) =
  composeA {One} {Delta n} {Delta (suc n)} {C} a (face n) (top n) ;
 X : Id (Ob C) (comp a (Ob-map (face n) (top n))) (comp a (dom (last-edge n))) =
  ccr {One} {Delta (suc n)} {C} a (face-top n) ;
 Y : Id (Ob C) (comp a (dom (last-edge n))) (dom {C} (comp a (last-edge n))) =
  comp-assoc {One} {I} {Delta (suc n)} {C} a (last-edge n) I0 ;
 xi : Id (Ob C) (cod {C} (comp a (last-edge n))) (Ob-map a (top (suc n))) =
  H.transH (cod-nat a (last-edge n)) (H.apH (Ob-map a) (edge-cod n)) ;
 dom-cell : Id (Id (Ob C) (dom {C} (comp a (last-edge n))) (Ob-map a (Ob-map (face n) (top n))))
  (H.transH (H.symH (pushout-comparison n C a).2.2) beta)
  (H.transH (dom-nat a (last-edge n)) (H.apH (Ob-map a) (H.symH (face-top n)))) =
  calc (Id (Ob C) (dom {C} (comp a (last-edge n))) (Ob-map a (Ob-map (face n) (top n)))) {
   H.transH (H.symH (H.transH beta (H.transH X Y))) beta
   =< H.apH (\ r -> H.transH r beta) (PA.sym-trans beta (H.transH X Y)) >
     H.transH (H.transH (H.symH (H.transH X Y)) (H.symH beta)) beta
   =< PA.tassoc (H.symH (H.transH X Y)) (H.symH beta) beta > H.transH (H.symH (H.transH X Y)) (H.transH (H.symH beta) beta)
   =< H.apH (\ r -> H.transH (H.symH (H.transH X Y)) r) (PA.inv-l beta) > H.symH (H.transH X Y)
   =< PA.sym-trans X Y > H.transH (H.symH Y) (H.symH X)
   =< H.apH (\ r -> H.transH (H.symH Y) r) (H.symH (PA.ap-sym (Ob-map a) (face-top n))) >
     H.transH (dom-nat a (last-edge n)) (H.apH (Ob-map a) (H.symH (face-top n))) } ;
} ;

-- the pushout comparison followed by base change along the spine of
-- Delta n and glue
spine-composite (C : Cat) (n : Nat) (a : Map (Delta (suc n)) C) : TC C (suc n) =
 glue C n (change-of-base-map (Map (Delta n) C) (TC C n) (\ t -> (m : Mor C) * Id (Ob C) t.1 (dom {C} m)) (spine-total C n)
  (pushout-comparison n C a)) ;

spine-step (C : Cat) (n : Nat) (a : Map (Delta (suc n)) C) :
 Id (TC C (suc n)) (spine-composite C n a) (spine-total C (suc n) a) =
 Pl.Sigma-path (Ob C) (HChain C (suc n)) (spine-composite C n a).1 (Ob-map a (top (suc n)))
  (spine-composite C n a).2 (spine C (suc n) a) Step[C, n, a].xi
  (H.transH (subst-HChain-suc C n Step[C, n, a].xi (spine-composite C n a).2)
   (chain-suc-eq C n {Ob-map a (top (suc n))} {Ob-map (comp a (face n)) (top n)} {Ob-map a (Ob-map (face n) (top n))}
     Step[C, n, a].beta
     (spine C n (comp a (face n))) (Chain-map a n (Ob-map (face n) (top n)) (Chain-map (face n) n (top n) (univ-chain n)))
     (Hom-coerce C (refl (Ob-map (comp a (face n)) (top n))) Step[C, n, a].xi
       (comp a (last-edge n), H.symH (pushout-comparison n C a).2.2, refl (cod {C} (comp a (last-edge n)))))
     (Hom-map a (Ob-map (face n) (top n)) (top (suc n)) (le-hom n))
     (Chain-map-of-comp a (face n) n (top n) (univ-chain n))
     (Hom-ends C (comp a (last-edge n)) Step[C, n, a].dom-cell (PA.unit-l Step[C, n, a].xi)))) ;

segal-all : (n : Nat) (C : Cat) -> Pl.isEquiv (Map (Delta n) C) (TC C n) (spine-total C n) = split {
 zero -> \ C -> Pl.qinv (Map One C) (TC C zero) (spine-total C zero) (\ t -> t.1)
   (\ t -> H.transH (H.apH {Ob C} {TC C zero} (\ v -> (v, tt)) (top0-htpy C t.1))
            (H.apH {Top} {TC C zero} (\ u -> (t.1, u)) (isTop tt t.2)))
   (\ s -> top0-htpy C s) ;
 suc n | r -> \ C -> EL.homotopy (Map (Delta (suc n)) C) (TC C (suc n)) (spine-composite C n) (spine-total C (suc n))
   (spine-step C n)
   (EL.compose (Map (Delta (suc n)) C) (GluePair C n) (TC C (suc n)) (glue C n)
     (\ a -> change-of-base-map (Map (Delta n) C) (TC C n) (\ t -> (m : Mor C) * Id (Ob C) t.1 (dom {C} m)) (spine-total C n)
       (pushout-comparison n C a))
     (glue-equiv C n)
     (EL.compose (Map (Delta (suc n)) C) (PushoutPair n C) (GluePair C n)
       (change-of-base-map (Map (Delta n) C) (TC C n) (\ t -> (m : Mor C) * Id (Ob C) t.1 (dom {C} m)) (spine-total C n))
       (pushout-comparison n C)
       (Sigma-change-of-base (Map (Delta n) C) (TC C n) (\ t -> (m : Mor C) * Id (Ob C) t.1 (dom {C} m)) (spine-total C n, r C)).2
       (pushout-is-equiv n C))) } ;

segal-equiv (C : Cat) (n : Nat) : Pl.Equiv (Map (Delta n) C) (TC C n) = (spine-total C n, segal-all n C) ;

filler-contr (C : Cat) (n : Nat) (w : TC C n) : CU.isContr (fib (spine-total C n) w) =
 equiv-fibre-contr (Map (Delta n) C) (TC C n) (spine-total C n) (segal-all n C) w ;
