-- The action of Hom-map on Hom-eq, including both endpoint 2-cells.
-- For ep : p = (al o v) . q, the mapped endpoint starts at
-- a(F,m,v) . Fp. Apply ep and ap-trans, reassociate, use naturality
-- of a(F,-,v) along al, then reassociate again. The result is
-- (F al o v) . (a(F,m1,v) . Fq), as required by Hom-eq.
-- To prove that these cells describe the actual ap of Hom-map, use J
-- on al, then on the two target endpoint paths, then on ep and eq.
-- At the resulting reflexive input, the endpoint cell is the inverse
-- left-unit path of a(F,m,v). Hom-eq with these cells is reflexivity.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open HomPaths ; open Naturality ;

strip3 {Z : U l} {x y : Z} (p : Id Z x y) :
 Id (Id Z x y) (H.transH (refl x) (H.transH (refl x) (H.transH (refl x) p))) p =
 H.transH (PA.unit-l (H.transH (refl x) (H.transH (refl x) p)))
  (H.transH (PA.unit-l (H.transH (refl x) p)) (PA.unit-l p)) ;

self (C : Cat) (x y : Ob C) (h : Hom C x y) :
 Id (Id (Hom C x y) h h)
  (Hom-eq C h h (refl (hmor h)) (H.symH (PA.unit-l (hdom h))) (H.symH (PA.unit-l (hcod h)))) (refl h) =
 H.transH
  (H.apH (\ r -> Hom-ends C (hmor h) {hdom h} {hdom h} {hcod h} {hcod h} r
    (H.transH (H.symH (PA.unit-l (hcod h))) (PA.unit-l (hcod h)))) (PA.inv-l (PA.unit-l (hdom h))))
  (H.apH (\ r -> Hom-ends C (hmor h) {hdom h} {hdom h} {hcod h} {hcod h} (refl (hdom h)) r) (PA.inv-l (PA.unit-l (hcod h)))) ;

module Endpoint (A B : Cat) (F : Map A B) (m : Mor A) (v : Ob I) {
 av : Id (Ob B) (comp {One} {I} {B} (comp F m) v) (comp F (comp {One} {I} {A} m v)) =
  composeA {One} {I} {A} {B} F m v ;

 cell (m1 : Mor A) (al : Id (Mor A) m m1) (x : Ob A)
  (p : Id (Ob A) (comp {One} {I} {A} m v) x) (q : Id (Ob A) (comp {One} {I} {A} m1 v) x)
  (ep : Id (Id (Ob A) (comp {One} {I} {A} m v) x) p (H.transH (ccl {One} {I} {A} v al) q)) :
  Id (Id (Ob B) (comp {One} {I} {B} (comp F m) v) (Ob-map F x))
   (H.transH av (ccr {One} {A} {B} F p))
   (H.transH (ccl {One} {I} {B} v (ccr {I} {A} {B} F al))
    (H.transH (composeA {One} {I} {A} {B} F m1 v) (ccr {One} {A} {B} F q))) =
  H.transH (H.apH (\ r -> H.transH av (ccr {One} {A} {B} F r)) ep)
   (H.transH (H.apH (\ r -> H.transH av r) (PA.ap-trans (Ob-map F) (ccl {One} {I} {A} v al) q))
    (H.transH (H.symH (PA.tassoc av (ccr {One} {A} {B} F (ccl {One} {I} {A} v al)) (ccr {One} {A} {B} F q)))
     (H.transH (H.apH (\ r -> H.transH r (ccr {One} {A} {B} F q)) (compose-naturality2 {One} {I} {A} {B} F v al))
      (PA.tassoc (ccl {One} {I} {B} v (ccr {I} {A} {B} F al)) (composeA {One} {I} {A} {B} F m1 v) (ccr {One} {A} {B} F q))))) ;

 cell-refl : Id (Id (Id (Ob B) (comp {One} {I} {B} (comp F m) v) (comp F (comp {One} {I} {A} m v)))
  av (H.transH (refl (comp {One} {I} {B} (comp F m) v)) av))
  (cell m (refl m) (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v)) (refl (comp {One} {I} {A} m v)) (refl (refl (comp {One} {I} {A} m v))))
  (H.symH (PA.unit-l av)) =
  H.transH (strip3 (H.apH (\ r -> r) (H.symH (PA.unit-l av)))) (PA.ap-id (H.symH (PA.unit-l av))) ;
} ;

module MapEq (A B : Cat) (F : Map A B) (m : Mor A) {
 module E0 = Endpoint[A, B, F, m, I0] ; module E1 = Endpoint[A, B, F, m, I1] ;

 statement (m1 : Mor A) (al : Id (Mor A) m m1) (x y : Ob A)
  (p : Id (Ob A) (dom m) x) (q : Id (Ob A) (cod m) y)
  (p1 : Id (Ob A) (dom m1) x) (q1 : Id (Ob A) (cod m1) y)
  (ep : Id (Id (Ob A) (dom m) x) p (H.transH (ccl {One} {I} {A} I0 al) p1))
  (eq : Id (Id (Ob A) (cod m) y) q (H.transH (ccl {One} {I} {A} I1 al) q1)) : U l =
  Id (Id (Hom B (Ob-map F x) (Ob-map F y)) (Hom-map F x y (m, p, q)) (Hom-map F x y (m1, p1, q1)))
   (H.apH (Hom-map F x y) (Hom-eq A (m, p, q) (m1, p1, q1) al ep eq))
   (Hom-eq B (Hom-map F x y (m, p, q)) (Hom-map F x y (m1, p1, q1)) (ccr {I} {A} {B} F al)
    (E0.cell m1 al x p p1 ep) (E1.cell m1 al y q q1 eq)) ;

 at-refl : statement m (refl m) (dom m) (cod m) (refl (dom m)) (refl (cod m))
  (refl (dom m)) (refl (cod m)) (refl (refl (dom m))) (refl (refl (cod m))) =
  H.symH (H.transH
   (HomEqHigher.Compare[B, Ob-map F (dom m), Ob-map F (cod m),
     Hom-map F (dom m) (cod m) (m, refl (dom m), refl (cod m)), Hom-map F (dom m) (cod m) (m, refl (dom m), refl (cod m))].ends
    (refl (comp F m))
    (E0.cell m (refl m) (dom m) (refl (dom m)) (refl (dom m)) (refl (refl (dom m)))) (H.symH (PA.unit-l E0.av))
    (E1.cell m (refl m) (cod m) (refl (cod m)) (refl (cod m)) (refl (refl (cod m)))) (H.symH (PA.unit-l E1.av)) E0.cell-refl E1.cell-refl)
   (self B (Ob-map F (dom m)) (Ob-map F (cod m)) (Hom-map F (dom m) (cod m) (m, refl (dom m), refl (cod m))))) ;

 -- First eliminate the target endpoint paths; their source witnesses
 -- then have the form p = refl and q = refl, eliminated on the right.
 base-motive (x : Ob A) (p1 : Id (Ob A) (dom m) x) (y : Ob A) (q1 : Id (Ob A) (cod m) y) : U l =
  (p : Id (Ob A) (dom m) x) (ep : Id (Id (Ob A) (dom m) x) p (H.transH (refl (dom m)) p1))
  (q : Id (Ob A) (cod m) y) (eq : Id (Id (Ob A) (cod m) y) q (H.transH (refl (cod m)) q1)) ->
  statement m (refl m) x y p q p1 q1 ep eq ;

 base-ends : base-motive (dom m) (refl (dom m)) (cod m) (refl (cod m)) =
  H.idJR (Id (Ob A) (dom m) (dom m)) (refl (dom m))
   (\ p ep -> (q : Id (Ob A) (cod m) (cod m)) (eq : Id (Id (Ob A) (cod m) (cod m)) q (refl (cod m))) ->
    statement m (refl m) (dom m) (cod m) p q (refl (dom m)) (refl (cod m)) ep eq)
   (H.idJR (Id (Ob A) (cod m) (cod m)) (refl (cod m))
    (\ q eq -> statement m (refl m) (dom m) (cod m) (refl (dom m)) q (refl (dom m)) (refl (cod m)) (refl (refl (dom m))) eq)
    at-refl) ;

 base (x : Ob A) (p1 : Id (Ob A) (dom m) x) (y : Ob A) (q1 : Id (Ob A) (cod m) y) : base-motive x p1 y q1 =
  idJ (Ob A) (dom m) (\ x1 r1 -> (y1 : Ob A) (s1 : Id (Ob A) (cod m) y1) -> base-motive x1 r1 y1 s1)
   (\ y1 s1 -> idJ (Ob A) (cod m) (base-motive (dom m) (refl (dom m))) base-ends y1 s1) x p1 y q1 ;

 motive (m1 : Mor A) (al : Id (Mor A) m m1) : U l =
  (x y : Ob A) (p : Id (Ob A) (dom m) x) (q : Id (Ob A) (cod m) y)
  (p1 : Id (Ob A) (dom m1) x) (q1 : Id (Ob A) (cod m1) y)
  (ep : Id (Id (Ob A) (dom m) x) p (H.transH (ccl {One} {I} {A} I0 al) p1))
  (eq : Id (Id (Ob A) (cod m) y) q (H.transH (ccl {One} {I} {A} I1 al) q1)) -> statement m1 al x y p q p1 q1 ep eq ;

 naturality (m1 : Mor A) (al : Id (Mor A) m m1) : motive m1 al =
  idJ (Mor A) m motive (\ x y p q p1 q1 ep eq -> base x p1 y q1 p ep q eq) m1 al ;
} ;
