-- Monotone maps to Two (Agda Interval/Interval, the definitions before
-- Axiom 8 extended and Axiom 18), stated before the parameters
-- I-mor-order, I-char-inverse, I-char-rinv, I-char-linv of Structure.
--   ob-to-2 f: the action on objects of f : C -> I, read in Two by I-ob.
--   p : Ob C -> Two is monotone if p (dom m) <= p (cod m) for every
--   morphism m of C.
open Base ; open Finite[l] ;
open WildCat ; open HigherCat ; open Constructions ;

ob-to-2 {C : Cat} (f : Map C I) (x : Ob C) : Two = I-ob.1 (Ob-map f x) ;

is-monotone (C : Cat) (p : Ob C -> Two) : U l = (m : Mor C) -> leq2 (p (dom m)) (p (cod m)) ;

Monotone (C : Cat) : U l = (p : Ob C -> Two) * is-monotone C p ;
