-- - x I preserves pushouts (Agda Squares/TimesI, times-I-preserves; Rocq
-- times_I_preserves).  Level 2 (through TimesICone and cone-post-comp).
-- Restructured: the transpose is taken as k |-> ev o (k x I), which is
-- homotopic to exp-comparison (uncurry-bridge), so no naturality of
-- exp-comparison (Agda uncurry-precomp, uncurry-composeA) is needed.
--   uncurry-bridge: exp-comparison u = ev o <u pi1, pi2> = ev o (u x I)
--   (the two maps into the product agree on the projections; ipe).
--   transpose-equiv: k |-> ev o (k x I) is an equivalence (homotopic to the
--   exponential comparison).
--   reshuffle c = ev o (timesI-cone c): cones of S into Fun I X to cones of
--   S x I into X.  On legs it is the transpose; on squares it is
--   s |-> gl . (ap transpose s . gt), conjugation by cells depending on the
--   legs only (ccr ev of theta, distributed: reshuffle-total).  So it is
--   an equivalence: fibrewise ap of an equivalence (EquivAp.ap-equiv) and
--   composition with fixed paths, over the equivalence on legs
--   (Sigma-fiberwise-equiv, Sigma-change-of-base).
--   factor: the comparison of S x I at the transpose of k is reshuffle of
--   the comparison of S at k: postcomposition with ev o (k x I) is
--   postcomposition with k x I then ev (cone-post-comp), and the comparison
--   of S x I at k x I is timesI-cone of the comparison of S at k
--   (comparison-times).
--   times-I-preserves: the comparison of S x I is homotopic to
--   reshuffle o (comparison of S at Fun I X) o (inverse transpose), a
--   composite of equivalences.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module PM = PathMoves[l] ;
module EL = EquivalenceLemmas[l] ; module EA = EquivAp[l] ;
open WildCat ; open Pullbacks ; open ProductMap ; open ExpComparison ; open Squares ; open SquareAlg ; open ConeAlg ;
open TimesICone ; open TimesIPost ;

uncurry-bridge {Y X : Cat} (u : Map Y (Fun I X)) :
 Id (Map (times Y I) X) (exp-comparison I X Y u) (comp (ev I X) (product-map u (idMap I))) =
 ccr (ev I X) (ipe (pair (comp u (pi1 Y I)) (pi2 Y I)) (product-map u (idMap I))
  (H.transH (pair-beta1 (comp u (pi1 Y I)) (pi2 Y I)) (H.symH (injl-product-map u (idMap I))))
  (H.transH (pair-beta2 (comp u (pi1 Y I)) (pi2 Y I))
   (H.transH (H.symH (comp-id-l (pi2 Y I))) (H.symH (injr-product-map u (idMap I)))))) ;

transpose (Y X : Cat) (u : Map Y (Fun I X)) : Map (times Y I) X = comp (ev I X) (product-map u (idMap I)) ;

transpose-equiv (Y X : Cat) : Pl.isEquiv (Map Y (Fun I X)) (Map (times Y I) X) (transpose Y X) =
 EL.homotopy (Map Y (Fun I X)) (Map (times Y I) X) (exp-comparison I X Y) (transpose Y X)
  (\ u -> uncurry-bridge u) (exp-is-equiv I X Y) ;

reshuffle (S : Square) (X : Cat) (c : sq-cone S (Fun I X)) : sq-cone (times-I S) X =
 cone-post (times-I S) (ev I X) (timesI-cone S c) ;

module Reshuffle (S : Square) (X : Cat) {
 Legs : U l = Map S.sqC (Fun I X) * Map S.sqB (Fun I X) ;
 LegsT : U l = Map (times S.sqC I) X * Map (times S.sqB I) X ;
 Sq (p : Legs) : U l = Id (Map S.sqA (Fun I X)) (comp p.1 S.sql) (comp p.2 S.sqt) ;
 SqT (w : LegsT) : U l =
  Id (Map (times S.sqA I) X) (comp w.1 (product-map S.sql (idMap I))) (comp w.2 (product-map S.sqt (idMap I))) ;
 legs (p : Legs) : LegsT = (transpose S.sqC X p.1, transpose S.sqB X p.2) ;
 legs-equiv : Pl.Equiv Legs LegsT =
  (legs, Pl.qinv Legs LegsT legs
   (\ w -> ((transpose-equiv S.sqC X).sec w.1, (transpose-equiv S.sqB X).sec w.2))
   (\ w -> EA.pair-path ((transpose-equiv S.sqC X).sec-eq w.1) ((transpose-equiv S.sqB X).sec-eq w.2))
   (\ p -> EA.pair-path (Pl.sec-ret (Map S.sqC (Fun I X)) (Map (times S.sqC I) X) (transpose S.sqC X) (transpose-equiv S.sqC X) p.1)
                        (Pl.sec-ret (Map S.sqB (Fun I X)) (Map (times S.sqB I) X) (transpose S.sqB X) (transpose-equiv S.sqB X) p.2))) ;
 -- the cells conjugating ap transpose on squares
 gl (g : Map S.sqC (Fun I X)) : Id (Map (times S.sqA I) X) (comp (transpose S.sqC X g) (product-map S.sql (idMap I)))
  (transpose S.sqA X (comp g S.sql)) =
  H.transH (composeA (ev I X) (product-map g (idMap I)) (product-map S.sql (idMap I))) (ccr (ev I X) (H.symH (theta g S.sql))) ;
 gt (e : Map S.sqB (Fun I X)) : Id (Map (times S.sqA I) X) (transpose S.sqA X (comp e S.sqt))
  (comp (transpose S.sqB X e) (product-map S.sqt (idMap I))) =
  H.transH (ccr (ev I X) (theta e S.sqt)) (H.symH (composeA (ev I X) (product-map e (idMap I)) (product-map S.sqt (idMap I)))) ;
 fib (p : Legs) (s : Sq p) : SqT (legs p) =
  H.transH (gl p.1) (H.transH (H.apH (transpose S.sqA X) s) (gt p.2)) ;
 mid (p : Legs) : U l =
  Id (Map (times S.sqA I) X) (transpose S.sqA X (comp p.1 S.sql)) (comp (transpose S.sqB X p.2) (product-map S.sqt (idMap I))) ;
 fib-equiv (p : Legs) : Pl.Equiv (Sq p) (SqT (legs p)) =
  (fib p, EL.compose (Sq p) (mid p) (SqT (legs p))
    (\ r -> H.transH (gl p.1) r) (\ s -> H.transH (H.apH (transpose S.sqA X) s) (gt p.2))
    (SigmaEquiv.pre-comp-path-equiv {Map (times S.sqA I) X} {comp (transpose S.sqC X p.1) (product-map S.sql (idMap I))}
      {transpose S.sqA X (comp p.1 S.sql)} {comp (transpose S.sqB X p.2) (product-map S.sqt (idMap I))} (gl p.1)).2
    (EL.compose (Sq p) (Id (Map (times S.sqA I) X) (transpose S.sqA X (comp p.1 S.sql)) (transpose S.sqA X (comp p.2 S.sqt))) (mid p)
      (\ r -> H.transH r (gt p.2)) (\ s -> H.apH (transpose S.sqA X) s)
      (SigmaEquiv.post-comp-path-equiv {Map (times S.sqA I) X} {transpose S.sqA X (comp p.1 S.sql)} (gt p.2)).2
      (EA.ap-equiv (Map S.sqA (Fun I X)) (Map (times S.sqA I) X) (transpose S.sqA X, transpose-equiv S.sqA X)
        (comp p.1 S.sql) (comp p.2 S.sqt)))) ;
 total : Pl.Equiv (sq-cone S (Fun I X)) (sq-cone (times-I S) X) =
  EL.then (sq-cone S (Fun I X)) ((p : Legs) * SqT (legs p)) (sq-cone (times-I S) X)
   (SigmaEquiv.Sigma-fiberwise-equiv Legs Sq (\ p -> SqT (legs p)) fib-equiv)
   (SigmaEquiv.Sigma-change-of-base Legs LegsT SqT legs-equiv) ;
 -- reshuffle is the total map: distribute ev over the square of timesI-cone
 reshuffle-total (c : sq-cone S (Fun I X)) : Id (sq-cone (times-I S) X) (total.1 c) (reshuffle S X c) =
  H.apH (\ w -> ((transpose S.sqC X (cg S (Fun I X) c), transpose S.sqB X (ce S (Fun I X) c)), w))
   (H.symH (H.transH (H.apH (\ q -> H.transH a1 q)
      (H.transH (PM.apt (\ u -> comp (ev I X) u) (H.symH (theta g S.sql))
          (H.transH (product-map-eq1 (idMap I) s) (theta e S.sqt)) (H.symH a2))
       (H.apH (\ q -> H.transH (ccr (ev I X) (H.symH (theta g S.sql))) q)
        (H.transH (PM.apt (\ u -> comp (ev I X) u) (product-map-eq1 (idMap I) s) (theta e S.sqt) (H.symH a2))
         (H.apH (\ q -> H.transH q (gt e))
          (PA.ap-comp (\ u -> comp (ev I X) u) (\ f -> product-map f (idMap I)) s))))))
     (H.symH (PA.tassoc a1 (ccr (ev I X) (H.symH (theta g S.sql))) (H.transH (H.apH (transpose S.sqA X) s) (gt e))))))
  where {
   g : Map S.sqC (Fun I X) = cg S (Fun I X) c ;
   e : Map S.sqB (Fun I X) = ce S (Fun I X) c ;
   s : Id (Map S.sqA (Fun I X)) (comp g S.sql) (comp e S.sqt) = cc S (Fun I X) c ;
   a1 : Id (Map (times S.sqA I) X) (comp (comp (ev I X) (product-map g (idMap I))) (product-map S.sql (idMap I)))
    (comp (ev I X) (comp (product-map g (idMap I)) (product-map S.sql (idMap I)))) =
    composeA (ev I X) (product-map g (idMap I)) (product-map S.sql (idMap I)) ;
   a2 : Id (Map (times S.sqA I) X) (comp (comp (ev I X) (product-map e (idMap I))) (product-map S.sqt (idMap I)))
    (comp (ev I X) (comp (product-map e (idMap I)) (product-map S.sqt (idMap I)))) =
    composeA (ev I X) (product-map e (idMap I)) (product-map S.sqt (idMap I)) ;
  } ;
 reshuffle-equiv : Pl.isEquiv (sq-cone S (Fun I X)) (sq-cone (times-I S) X) (reshuffle S X) =
  EL.homotopy (sq-cone S (Fun I X)) (sq-cone (times-I S) X) total.1 (reshuffle S X) reshuffle-total total.2 ;
} ;

-- the comparison of S x I at a transpose
factor (S : Square) (X : Cat) (k : Map S.sqD (Fun I X)) :
 Id (sq-cone (times-I S) X) (sq-comparison (times-I S) X (transpose S.sqD X k)) (reshuffle S X (sq-comparison S (Fun I X) k)) =
 H.transH (cone-post-comp (times-I S) (ev I X) (product-map k (idMap I)) (base-cone (times-I S)))
  (H.apH (cone-post (times-I S) (ev I X)) (comparison-times S k)) ;

times-I-preserves {S : Square} (HS : is-pushout-square S) : is-pushout-square (times-I S) = \ X ->
 EL.homotopy (Map (times S.sqD I) X) (sq-cone (times-I S) X)
  (\ h -> reshuffle S X (sq-comparison S (Fun I X) ((transpose-equiv S.sqD X).sec h)))
  (sq-comparison (times-I S) X)
  (\ h -> H.symH (H.transH (H.apH (sq-comparison (times-I S) X) (H.symH ((transpose-equiv S.sqD X).sec-eq h)))
     (factor S X ((transpose-equiv S.sqD X).sec h))))
  (EL.compose (Map (times S.sqD I) X) (Map S.sqD (Fun I X)) (sq-cone (times-I S) X)
    (\ k -> reshuffle S X (sq-comparison S (Fun I X) k)) (transpose-equiv S.sqD X).sec
    (EL.compose (Map S.sqD (Fun I X)) (sq-cone S (Fun I X)) (sq-cone (times-I S) X)
      (reshuffle S X) (sq-comparison S (Fun I X))
      Reshuffle[S, X].reshuffle-equiv (HS (Fun I X)))
    (EL.inverse (Map S.sqD (Fun I X)) (Map (times S.sqD I) X) (transpose S.sqD X, transpose-equiv S.sqD X)).2) ;
