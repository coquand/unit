-- The walking arrow I is thin (Agda Interval/IntervalPosetal; Rocq
-- values_I, isaprop_I_edge), and Hom I I0 I1 is contractible.
--   val-I: every object of I is I0 or I1 (read it in Two by I-ob).
--   map-into-I-eq: two functors to I agreeing on objects are equal (I-char
--   is injective, monotonicity is a proposition).
--   I-hom-to-order: a morphism of I orders its endpoints (I-mor-order).
--   I-thin: two morphisms x -> y agree on I0 (both give x) and on I1 (both
--   give y), hence on every object, hence are equal; the endpoint paths lie
--   in the set Ob I.
--   I-hom-contr (a parameter of the Agda proof): Hom I I0 I1 is
--   contractible, with centre the identity of I, since it is a
--   proposition.
--   I-order-to-hom: conversely an order between the values gives a
--   morphism (an identity, or the generating edge).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module FL = Axioms[l].FunExtLemmas[fe @l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Constructions ;
open OrdMonotone ; open MonotoneMaps ; open IntervalChar ; open Interval ; open HLevels ;

val-I-aux (z : Ob I) : (b : Two) -> Id Two (I-ob.1 z) b -> Sum (Id (Ob I) z I0) (Id (Ob I) z I1) = split {
 inl u -> \ eq -> inl (H.transH (H.symH (Pl.sec-ret (Ob I) Two I-ob.1 I-ob.2 z))
   (H.apH I-ob.2.sec (H.transH eq (H.apH {Top} {Two} (\ t -> inl t) (isTop u tt))))) ;
 inr u -> \ eq -> inr (H.transH (H.symH (Pl.sec-ret (Ob I) Two I-ob.1 I-ob.2 z))
   (H.apH I-ob.2.sec (H.transH eq (H.apH {Top} {Two} (\ t -> inr t) (isTop u tt))))) } ;

val-I (z : Ob I) : Sum (Id (Ob I) z I0) (Id (Ob I) z I1) = val-I-aux z (I-ob.1 z) (refl (I-ob.1 z)) ;

I-ob-I0 : Id Two (I-ob.1 I0) zero2 = I-ob.2.sec-eq zero2 ;
I-ob-I1 : Id Two (I-ob.1 I1) one2 = I-ob.2.sec-eq one2 ;

map-into-I-eq (A : Cat) (m1 m2 : Map A I) (e : (z : Ob A) -> Id (Ob I) (Ob-map m1 z) (Ob-map m2 z)) : Id (Map A I) m1 m2 =
 Equivalences[l].injective (Map A I) (Monotone A) (I-char-comparison A) (I-char A).2 m1 m2
  (Pl.Sigma-eq (Ob A -> Two) (is-monotone A) (ob-to-2 m1) (ob-to-2 m2)
    (I-char-comparison A m1).2 (I-char-comparison A m2).2
    (FL.funext (Ob A) (\ z -> Two) (ob-to-2 m1) (ob-to-2 m2) (\ z -> H.apH I-ob.1 (e z)))
    (is-monotone-is-prop A (ob-to-2 m2))) ;

I-hom-to-order (a b : Ob I) (h : Hom I a b) : leq2 (I-ob.1 a) (I-ob.1 b) =
 leq2-transport (H.apH I-ob.1 (hdom h)) (H.apH I-ob.1 (hcod h)) (I-mor-order (hmor h)) ;

-- two morphisms with the same endpoints agree at every object, by cases
agree-at {C : Cat} {x y : Ob C} (m1 m2 : Mor C)
 (d1 : Id (Ob C) (dom m1) x) (c1 : Id (Ob C) (cod m1) y) (d2 : Id (Ob C) (dom m2) x) (c2 : Id (Ob C) (cod m2) y)
 (z : Ob I) : Sum (Id (Ob I) z I0) (Id (Ob I) z I1) -> Id (Ob C) (Ob-map {I} {C} m1 z) (Ob-map {I} {C} m2 z) = split {
 inl e0 -> H.transH (H.apH (Ob-map {I} {C} m1) e0) (H.transH d1 (H.transH (H.symH d2) (H.apH (Ob-map {I} {C} m2) (H.symH e0)))) ;
 inr e1 -> H.transH (H.apH (Ob-map {I} {C} m1) e1) (H.transH c1 (H.transH (H.symH c2) (H.apH (Ob-map {I} {C} m2) (H.symH e1)))) } ;

-- Hom C x y is a proposition when morphisms are determined by their action
-- on objects and Ob C is a set
thin-from {C : Cat} (sC : Pl.isSet (Ob C))
 (det : (m1 m2 : Mor C) -> ((z : Ob I) -> Id (Ob C) (Ob-map {I} {C} m1 z) (Ob-map {I} {C} m2 z)) -> Id (Mor C) m1 m2)
 (x y : Ob C) : Pl.isProp (Hom C x y) = \ h1 h2 ->
 Pl.Sigma-eq (Mor C) (\ m -> Id (Ob C) (dom m) x * Id (Ob C) (cod m) y) (hmor h1) (hmor h2) h1.2 h2.2
  (det (hmor h1) (hmor h2) (\ z -> agree-at (hmor h1) (hmor h2) (hdom h1) (hcod h1) (hdom h2) (hcod h2) z (val-I z)))
  (prod-is-prop (Id (Ob C) (dom (hmor h2)) x) (Id (Ob C) (cod (hmor h2)) y) (sC (dom (hmor h2)) x) (sC (cod (hmor h2)) y)) ;

I-thin (x y : Ob I) : Pl.isProp (Hom I x y) = thin-from {I} ob-I-is-set (map-into-I-eq I) x y ;

gen-hom : Hom I I0 I1 = (idMap I, comp-id-l {One} {I} I0, comp-id-l {One} {I} I1) ;

I-hom-contr : CU.isContr (Hom I I0 I1) = (gen-hom, \ h -> I-thin I0 I1 gen-hom h) ;

order-to-hom-cases (a b : Ob I) (le : leq2 (I-ob.1 a) (I-ob.1 b)) :
 Sum (Id (Ob I) a I0) (Id (Ob I) a I1) -> Sum (Id (Ob I) b I0) (Id (Ob I) b I1) -> Hom I a b = split {
 inl ea0 -> split {
  inl eb0 -> Hom-coerce I (H.symH ea0) (H.symH eb0) (id-hom {I} I0) ;
  inr eb1 -> Hom-coerce I (H.symH ea0) (H.symH eb1) gen-hom } ;
 inr ea1 -> split {
  inl eb0 -> Pl.absurd _ (leq2-transport (H.transH (H.apH I-ob.1 ea1) I-ob-I1) (H.transH (H.apH I-ob.1 eb0) I-ob-I0) le) ;
  inr eb1 -> Hom-coerce I (H.symH ea1) (H.symH eb1) (id-hom {I} I1) } } ;

I-order-to-hom (a b : Ob I) (le : leq2 (I-ob.1 a) (I-ob.1 b)) : Hom I a b =
 order-to-hom-cases a b le (val-I a) (val-I b) ;
