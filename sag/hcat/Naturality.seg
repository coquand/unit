-- Level-1 coherence of Cat (Agda Foundations/Coherence, first half;
-- Rocq compose_naturality1-3, IdKl/IdKr_naturality, recompose_sq).  Each
-- is one J on the 2-cell: at refl both sides are the structure cell, one
-- of them composed with refl on the left (unit-l).
--   compose-naturality1-3  the reassociator is natural in each argument
--   IdKl-nat, IdKr-nat     the unit laws are natural
--   cancel-ccr-Id, cancel-ccl-Id  whiskering by an identity is injective:
--     1 o F = 1 o G gives  comp-id-l f . F = (1 o F) . comp-id-l g =
--     (1 o G) . comp-id-l g = comp-id-l f . G, and F = G by cancel-l
--   xch   interchange: for q : m = m' and F : a = b,
--         (m o F) . (q o b) = (q o a) . (m' o F)
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ;

compose-naturality1 {A B C D : Cat} {f f1 : Map C D} (g : Map B C) (h : Map A B) (F : Id (Map C D) f f1) :
 Id (Id (Map A D) (comp (comp f g) h) (comp f1 (comp g h)))
  (H.transH (composeA f g h) (ccl (comp g h) F)) (H.transH (ccl h (ccl g F)) (composeA f1 g h)) =
 idJ (Map C D) f (\ f2 F2 -> Id (Id (Map A D) (comp (comp f g) h) (comp f2 (comp g h)))
   (H.transH (composeA f g h) (ccl (comp g h) F2)) (H.transH (ccl h (ccl g F2)) (composeA f2 g h)))
  (H.symH (PA.unit-l (composeA f g h))) f1 F ;

compose-naturality2 {A B C D : Cat} (f : Map C D) {g g1 : Map B C} (h : Map A B) (F : Id (Map B C) g g1) :
 Id (Id (Map A D) (comp (comp f g) h) (comp f (comp g1 h)))
  (H.transH (composeA f g h) (ccr f (ccl h F))) (H.transH (ccl h (ccr f F)) (composeA f g1 h)) =
 idJ (Map B C) g (\ g2 F2 -> Id (Id (Map A D) (comp (comp f g) h) (comp f (comp g2 h)))
   (H.transH (composeA f g h) (ccr f (ccl h F2))) (H.transH (ccl h (ccr f F2)) (composeA f g2 h)))
  (H.symH (PA.unit-l (composeA f g h))) g1 F ;

compose-naturality3 {A B C D : Cat} (f : Map C D) (g : Map B C) {h h1 : Map A B} (F : Id (Map A B) h h1) :
 Id (Id (Map A D) (comp (comp f g) h) (comp f (comp g h1)))
  (H.transH (composeA f g h) (ccr f (ccr g F))) (H.transH (ccr (comp f g) F) (composeA f g h1)) =
 idJ (Map A B) h (\ h2 F2 -> Id (Id (Map A D) (comp (comp f g) h) (comp f (comp g h2)))
   (H.transH (composeA f g h) (ccr f (ccr g F2))) (H.transH (ccr (comp f g) F2) (composeA f g h2)))
  (H.symH (PA.unit-l (composeA f g h))) h1 F ;

IdKl-nat {C D : Cat} {f g : Map C D} (F : Id (Map C D) f g) :
 Id (Id (Map C D) (comp (idMap D) f) g)
  (H.transH (comp-id-l f) F) (H.transH (ccr (idMap D) F) (comp-id-l g)) =
 idJ (Map C D) f (\ g2 F2 -> Id (Id (Map C D) (comp (idMap D) f) g2)
   (H.transH (comp-id-l f) F2) (H.transH (ccr (idMap D) F2) (comp-id-l g2)))
  (H.symH (PA.unit-l (comp-id-l f))) g F ;

IdKr-nat {C D : Cat} {f g : Map C D} (F : Id (Map C D) f g) :
 Id (Id (Map C D) (comp f (idMap C)) g)
  (H.transH (comp-id-r f) F) (H.transH (ccl (idMap C) F) (comp-id-r g)) =
 idJ (Map C D) f (\ g2 F2 -> Id (Id (Map C D) (comp f (idMap C)) g2)
   (H.transH (comp-id-r f) F2) (H.transH (ccl (idMap C) F2) (comp-id-r g2)))
  (H.symH (PA.unit-l (comp-id-r f))) g F ;

cancel-ccr-Id {C D : Cat} {f g : Map C D} (F G : Id (Map C D) f g)
 (h : Id (Id (Map C D) (comp (idMap D) f) (comp (idMap D) g)) (ccr (idMap D) F) (ccr (idMap D) G)) :
 Id (Id (Map C D) f g) F G =
 PA.cancel-l (comp-id-l f) (calc (Id (Map C D) (comp (idMap D) f) g) {
   H.transH (comp-id-l f) F
   =< IdKl-nat F > H.transH (ccr (idMap D) F) (comp-id-l g)
   =< H.apH (\ u -> H.transH u (comp-id-l g)) h > H.transH (ccr (idMap D) G) (comp-id-l g)
   =< H.symH (IdKl-nat G) > H.transH (comp-id-l f) G }) ;

cancel-ccl-Id {C D : Cat} {f g : Map C D} (F G : Id (Map C D) f g)
 (h : Id (Id (Map C D) (comp f (idMap C)) (comp g (idMap C))) (ccl (idMap C) F) (ccl (idMap C) G)) :
 Id (Id (Map C D) f g) F G =
 PA.cancel-l (comp-id-r f) (calc (Id (Map C D) (comp f (idMap C)) g) {
   H.transH (comp-id-r f) F
   =< IdKr-nat F > H.transH (ccl (idMap C) F) (comp-id-r g)
   =< H.apH (\ u -> H.transH u (comp-id-r g)) h > H.transH (ccl (idMap C) G) (comp-id-r g)
   =< H.symH (IdKr-nat G) > H.transH (comp-id-r f) G }) ;

xch {A B D : Cat} {m m1 : Map B D} (q : Id (Map B D) m m1) {a b : Map A B} (F : Id (Map A B) a b) :
 Id (Id (Map A D) (comp m a) (comp m1 b))
  (H.transH (ccr m F) (ccl b q)) (H.transH (ccl a q) (ccr m1 F)) =
 idJ (Map B D) m (\ m2 q2 -> Id (Id (Map A D) (comp m a) (comp m2 b))
   (H.transH (ccr m F) (ccl b q2)) (H.transH (ccl a q2) (ccr m2 F)))
  (H.symH (PA.unit-l (ccr m F))) m1 q ;
