-- The product of functors and its comparison cells (Agda Category/Product
-- §0-§4c; Rocq product section).  Level 1: no pentagon.
--   product-map f g = <f o pi1, g o pi2> : A x X -> B x Y, characterised
--   by its two projection laws (pair-beta), then locked.
--   prod-comp-equiv: Map D (A x B) ~ Map D A * Map D B (pair is the
--   inverse: prod-roundtrip, pair-eta).  So ap of the comparison is an
--   equivalence of path types (EquivAp.ap-equiv):
--   ipe: a path F = G into a product from paths between the projections;
--   its projections are the given paths (ipe-injl, ipe-injr: the
--   projections of the path ap Phi (ipe ..) = (el, er)); locked.
--   prod-path-eq: two 2-cells into a product with equal projections are
--   equal (ap Phi is injective, and paths in A * B are determined by their
--   projections).
--   pmc: product-map (g f) (j i) = product-map g j o product-map f i, by
--   ipe from the two legs  pi o pm(g f, j i) = (g f) o pi = g (f pi)
--   = g (pi pm(f,i)) = (g pi) pm(f,i) = (pi pm(g,j)) pm(f,i) = pi (pm(g,j) pm(f,i));
--   its projections are the legs (pmc-injl, pmc-injr); locked.
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EA = EquivAp[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Pullbacks ;

product-map {A B X Y : Cat} (f : Map A B) (g : Map X Y) : Map (times A X) (times B Y) =
 pair (comp f (pi1 A X)) (comp g (pi2 A X)) ;

injl-product-map {A B X Y : Cat} (f : Map A B) (g : Map X Y) :
 Id (Map (times A X) B) (comp (pi1 B Y) (product-map f g)) (comp f (pi1 A X)) =
 pair-beta1 (comp f (pi1 A X)) (comp g (pi2 A X)) ;

injr-product-map {A B X Y : Cat} (f : Map A B) (g : Map X Y) :
 Id (Map (times A X) Y) (comp (pi2 B Y) (product-map f g)) (comp g (pi2 A X)) =
 pair-beta2 (comp f (pi1 A X)) (comp g (pi2 A X)) ;

opaque product-map ;

product-map-eq1 {A B X Y : Cat} {f f1 : Map A B} (g : Map X Y) (p : Id (Map A B) f f1) :
 Id (Map (times A X) (times B Y)) (product-map f g) (product-map f1 g) = H.apH (\ f2 -> product-map f2 g) p ;

product-map-eq2 {A B X Y : Cat} (f : Map A B) {g g1 : Map X Y} (p : Id (Map X Y) g g1) :
 Id (Map (times A X) (times B Y)) (product-map f g) (product-map f g1) = H.apH (\ g2 -> product-map f g2) p ;

prod-comp-equiv (A B X : Cat) : Pl.isEquiv (Map X (times A B)) (Map X A * Map X B) (prod-comparison A B X) =
 Pl.qinv (Map X (times A B)) (Map X A * Map X B) (prod-comparison A B X) (prod-section A B X)
  (prod-roundtrip A B X) (\ u -> pair-eta u) ;

-- ap of the comparison on paths F = G, as an equivalence
prod-ap-equiv (A B D : Cat) (f g : Map D (times A B)) :
 Pl.isEquiv (Id (Map D (times A B)) f g) (Id (Map D A * Map D B) (prod-comparison A B D f) (prod-comparison A B D g))
  (Pl.ap (Map D (times A B)) (Map D A * Map D B) (prod-comparison A B D) f g) =
 EA.ap-equiv (Map D (times A B)) (Map D A * Map D B) (prod-comparison A B D, prod-comp-equiv A B D) f g ;

ipe {A B D : Cat} (f g : Map D (times A B))
 (el : Id (Map D A) (comp (pi1 A B) f) (comp (pi1 A B) g)) (er : Id (Map D B) (comp (pi2 A B) f) (comp (pi2 A B) g)) :
 Id (Map D (times A B)) f g = (prod-ap-equiv A B D f g).sec (EA.pair-path el er) ;

ipe-injl {A B D : Cat} (f g : Map D (times A B))
 (el : Id (Map D A) (comp (pi1 A B) f) (comp (pi1 A B) g)) (er : Id (Map D B) (comp (pi2 A B) f) (comp (pi2 A B) g)) :
 Id (Id (Map D A) (comp (pi1 A B) f) (comp (pi1 A B) g)) (ccr (pi1 A B) (ipe f g el er)) el =
 H.transH (H.symH (PA.ap-comp (\ w -> w.1) (prod-comparison A B D) (ipe f g el er)))
  (H.transH (H.apH (\ r -> H.apH (\ w -> w.1) r) ((prod-ap-equiv A B D f g).sec-eq (EA.pair-path el er)))
   (EA.pair-path-fst el er)) ;

ipe-injr {A B D : Cat} (f g : Map D (times A B))
 (el : Id (Map D A) (comp (pi1 A B) f) (comp (pi1 A B) g)) (er : Id (Map D B) (comp (pi2 A B) f) (comp (pi2 A B) g)) :
 Id (Id (Map D B) (comp (pi2 A B) f) (comp (pi2 A B) g)) (ccr (pi2 A B) (ipe f g el er)) er =
 H.transH (H.symH (PA.ap-comp (\ w -> w.2) (prod-comparison A B D) (ipe f g el er)))
  (H.transH (H.apH (\ r -> H.apH (\ w -> w.2) r) ((prod-ap-equiv A B D f g).sec-eq (EA.pair-path el er)))
   (EA.pair-path-snd el er)) ;

opaque ipe ;

prod-path-eq {A B X : Cat} {F F1 : Map X (times A B)} (p q : Id (Map X (times A B)) F F1)
 (hl : Id (Id (Map X A) (comp (pi1 A B) F) (comp (pi1 A B) F1)) (ccr (pi1 A B) p) (ccr (pi1 A B) q))
 (hr : Id (Id (Map X B) (comp (pi2 A B) F) (comp (pi2 A B) F1)) (ccr (pi2 A B) p) (ccr (pi2 A B) q)) :
 Id (Id (Map X (times A B)) F F1) p q =
 Equivalences[l].injective (Id (Map X (times A B)) F F1)
  (Id (Map X A * Map X B) (prod-comparison A B X F) (prod-comparison A B X F1))
  (Pl.ap (Map X (times A B)) (Map X A * Map X B) (prod-comparison A B X) F F1) (prod-ap-equiv A B X F F1) p q
  (EA.pair-path-uniq (H.apH (prod-comparison A B X) p) (H.apH (prod-comparison A B X) q)
   (H.transH (PA.ap-comp (\ w -> w.1) (prod-comparison A B X) p)
    (H.transH hl (H.symH (PA.ap-comp (\ w -> w.1) (prod-comparison A B X) q))))
   (H.transH (PA.ap-comp (\ w -> w.2) (prod-comparison A B X) p)
    (H.transH hr (H.symH (PA.ap-comp (\ w -> w.2) (prod-comparison A B X) q))))) ;

-- the multiplicativity comparison of product-map
pmc-legl {XX Y Z A B C : Cat} (f : Map Z Y) (g : Map Y XX) (i : Map C B) (j : Map B A) :
 Id (Map (times Z C) XX) (comp (pi1 XX A) (product-map (comp g f) (comp j i)))
  (comp (pi1 XX A) (comp (product-map g j) (product-map f i))) =
 H.transH (injl-product-map (comp g f) (comp j i))
 (H.transH (composeA g f (pi1 Z C))
 (H.transH (ccr g (H.symH (injl-product-map f i)))
 (H.transH (H.symH (composeA g (pi1 Y B) (product-map f i)))
 (H.transH (ccl (product-map f i) (H.symH (injl-product-map g j)))
  (composeA (pi1 XX A) (product-map g j) (product-map f i)))))) ;

pmc-legr {XX Y Z A B C : Cat} (f : Map Z Y) (g : Map Y XX) (i : Map C B) (j : Map B A) :
 Id (Map (times Z C) A) (comp (pi2 XX A) (product-map (comp g f) (comp j i)))
  (comp (pi2 XX A) (comp (product-map g j) (product-map f i))) =
 H.transH (injr-product-map (comp g f) (comp j i))
 (H.transH (composeA j i (pi2 Z C))
 (H.transH (ccr j (H.symH (injr-product-map f i)))
 (H.transH (H.symH (composeA j (pi2 Y B) (product-map f i)))
 (H.transH (ccl (product-map f i) (H.symH (injr-product-map g j)))
  (composeA (pi2 XX A) (product-map g j) (product-map f i)))))) ;

pmc {XX Y Z A B C : Cat} (f : Map Z Y) (g : Map Y XX) (i : Map C B) (j : Map B A) :
 Id (Map (times Z C) (times XX A)) (product-map (comp g f) (comp j i)) (comp (product-map g j) (product-map f i)) =
 ipe (product-map (comp g f) (comp j i)) (comp (product-map g j) (product-map f i)) (pmc-legl f g i j) (pmc-legr f g i j) ;

pmc-injl {XX Y Z A B C : Cat} (f : Map Z Y) (g : Map Y XX) (i : Map C B) (j : Map B A) :
 Id (Id (Map (times Z C) XX) (comp (pi1 XX A) (product-map (comp g f) (comp j i)))
     (comp (pi1 XX A) (comp (product-map g j) (product-map f i))))
  (ccr (pi1 XX A) (pmc f g i j)) (pmc-legl f g i j) =
 ipe-injl (product-map (comp g f) (comp j i)) (comp (product-map g j) (product-map f i)) (pmc-legl f g i j) (pmc-legr f g i j) ;

pmc-injr {XX Y Z A B C : Cat} (f : Map Z Y) (g : Map Y XX) (i : Map C B) (j : Map B A) :
 Id (Id (Map (times Z C) A) (comp (pi2 XX A) (product-map (comp g f) (comp j i)))
     (comp (pi2 XX A) (comp (product-map g j) (product-map f i))))
  (ccr (pi2 XX A) (pmc f g i j)) (pmc-legr f g i j) =
 ipe-injr (product-map (comp g f) (comp j i)) (comp (product-map g j) (product-map f i)) (pmc-legl f g i j) (pmc-legr f g i j) ;

opaque pmc ;
