-- The Segal axiom and composition of morphisms (Wärn Axiom 21,
-- Constructions 22-23; Agda Simplices/Segal, parts 2-11).  Parameter used:
-- segal-is-equiv.
--   segal-witness w: the 2-simplex with first edges f, g (the inverse of
--   the comparison); segal-first, segal-second: its two edges.
--   comp-mor f g: the long edge of the witness; its domain is dom f, as
--   dom (s o d02) = s (dom d02) = s (dom d01) = dom (s o d01) = dom f, and
--   its codomain is cod g likewise; comp-hom on Hom.
--   The degeneracies s011, s001 : Delta 2 -> I are the witnesses of
--   (1_I, id I1) and (id I0, 1_I); their long edge is 1_I since
--   Hom I I0 I1 is contractible (I-hom-contr, a theorem here).
--   right-unit-witness f = f o s011 has edges f, id (cod f), f;
--   left-unit-witness f = f o s001 has edges id (dom f), f, f.
--   comp-witness-long: the long edge of any 2-simplex is the composite of
--   its two first edges (the retraction law).
open Base ; open Finite[l] ;
module H = Paths[l] ; module Pl = Prelude[l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open IntervalPosetal ; open SegalComparison ;

segal-equiv (C : Cat) : Pl.Equiv (Map (Delta (suc (suc zero))) C) (ComposablePair C) =
 (segal-comparison C, segal-is-equiv C) ;

segal-witness (C : Cat) (w : ComposablePair C) : Map (Delta (suc (suc zero))) C = (segal-is-equiv C).sec w ;

segal-roundtrip (C : Cat) (w : ComposablePair C) : Id (ComposablePair C) (segal-comparison C (segal-witness C w)) w =
 (segal-is-equiv C).sec-eq w ;

segal-first (C : Cat) (w : ComposablePair C) : Id (Mor C) (funct-on-mor (segal-witness C w) d01) w.1 =
 H.apH (\ x -> x.1) (segal-roundtrip C w) ;

segal-second (C : Cat) (w : ComposablePair C) : Id (Mor C) (funct-on-mor (segal-witness C w) d12) w.2.1 =
 H.apH (\ x -> x.2.1) (segal-roundtrip C w) ;

comp-mor (C : Cat) (f g : Mor C) (p : Id (Ob C) (cod f) (dom g)) : Mor C =
 funct-on-mor (segal-witness C (f, g, p)) d02 ;

dom-comp-mor (C : Cat) (f g : Mor C) (p : Id (Ob C) (cod f) (dom g)) : Id (Ob C) (dom (comp-mor C f g p)) (dom f) =
 H.transH (dom-nat (segal-witness C (f, g, p)) d02)
 (H.transH (H.apH (Ob-map (segal-witness C (f, g, p))) d02-start)
 (H.transH (H.symH (dom-nat (segal-witness C (f, g, p)) d01))
  (H.apH (\ m -> dom m) (segal-first C (f, g, p))))) ;

cod-comp-mor (C : Cat) (f g : Mor C) (p : Id (Ob C) (cod f) (dom g)) : Id (Ob C) (cod (comp-mor C f g p)) (cod g) =
 H.transH (cod-nat (segal-witness C (f, g, p)) d02)
 (H.transH (H.apH (Ob-map (segal-witness C (f, g, p))) d02-end)
 (H.transH (H.symH (cod-nat (segal-witness C (f, g, p)) d12))
  (H.apH (\ m -> cod m) (segal-second C (f, g, p))))) ;

comp-hom (C : Cat) {a b c : Ob C} (h1 : Hom C a b) (h2 : Hom C b c) : Hom C a c =
 (comp-mor C (hmor h1) (hmor h2) (H.transH (hcod h1) (H.symH (hdom h2))),
  H.transH (dom-comp-mor C (hmor h1) (hmor h2) (H.transH (hcod h1) (H.symH (hdom h2)))) (hdom h1),
  H.transH (cod-comp-mor C (hmor h1) (hmor h2) (H.transH (hcod h1) (H.symH (hdom h2)))) (hcod h2)) ;

------------------------------------------------------------------------
-- degeneracies of Delta 2

s011-pair : ComposablePair I = (idMap I, id-mor {I} I1, H.transH (comp-id-l {One} {I} I1) (H.symH (dom-id {I} I1))) ;
s011 : Map (Delta (suc (suc zero))) I = segal-witness I s011-pair ;
s011-d01 : Id (Mor I) (funct-on-mor s011 d01) (idMap I) = segal-first I s011-pair ;
s011-d12 : Id (Mor I) (funct-on-mor s011 d12) (id-mor {I} I1) = segal-second I s011-pair ;

s001-pair : ComposablePair I = (id-mor {I} I0, idMap I, H.transH (cod-id {I} I0) (H.symH (comp-id-l {One} {I} I0))) ;
s001 : Map (Delta (suc (suc zero))) I = segal-witness I s001-pair ;
s001-d01 : Id (Mor I) (funct-on-mor s001 d01) (id-mor {I} I0) = segal-first I s001-pair ;
s001-d12 : Id (Mor I) (funct-on-mor s001 d12) (idMap I) = segal-second I s001-pair ;

s011-d02 : Id (Mor I) (funct-on-mor s011 d02) (idMap I) =
 H.apH (\ h -> hmor h) (CU.pathC (Hom I I0 I1) I-hom-contr
  (funct-on-mor s011 d02,
   H.transH (dom-comp-mor I (idMap I) (id-mor {I} I1) s011-pair.2.2) (comp-id-l {One} {I} I0),
   H.transH (cod-comp-mor I (idMap I) (id-mor {I} I1) s011-pair.2.2) (cod-id {I} I1))
  gen-hom) ;

s001-d02 : Id (Mor I) (funct-on-mor s001 d02) (idMap I) =
 H.apH (\ h -> hmor h) (CU.pathC (Hom I I0 I1) I-hom-contr
  (funct-on-mor s001 d02,
   H.transH (dom-comp-mor I (id-mor {I} I0) (idMap I) s001-pair.2.2) (dom-id {I} I0),
   H.transH (cod-comp-mor I (id-mor {I} I0) (idMap I) s001-pair.2.2) (comp-id-l {One} {I} I1))
  gen-hom) ;

------------------------------------------------------------------------
-- functors preserve identities; the unit witnesses

funct-pres-id {A B : Cat} (f : Map A B) (x : Ob A) : Id (Mor B) (funct-on-mor f (id-mor x)) (id-mor (Ob-map f x)) =
 comp-assoc {I} {One} {A} {B} f x (bang I) ;

right-unit-witness (C : Cat) (f : Mor C) : Map (Delta (suc (suc zero))) C = comp {Delta (suc (suc zero))} {I} {C} f s011 ;

right-unit-d01 (C : Cat) (f : Mor C) : Id (Mor C) (funct-on-mor (right-unit-witness C f) d01) f =
 H.transH (composeA {I} {Delta (suc (suc zero))} {I} {C} f s011 d01)
  (H.transH (ccr {I} {I} {C} f s011-d01) (comp-id-r {I} {C} f)) ;
right-unit-d12 (C : Cat) (f : Mor C) : Id (Mor C) (funct-on-mor (right-unit-witness C f) d12) (id-mor (cod f)) =
 H.transH (composeA {I} {Delta (suc (suc zero))} {I} {C} f s011 d12)
  (H.transH (ccr {I} {I} {C} f s011-d12) (funct-pres-id {I} {C} f I1)) ;
right-unit-d02 (C : Cat) (f : Mor C) : Id (Mor C) (funct-on-mor (right-unit-witness C f) d02) f =
 H.transH (composeA {I} {Delta (suc (suc zero))} {I} {C} f s011 d02)
  (H.transH (ccr {I} {I} {C} f s011-d02) (comp-id-r {I} {C} f)) ;

left-unit-witness (C : Cat) (f : Mor C) : Map (Delta (suc (suc zero))) C = comp {Delta (suc (suc zero))} {I} {C} f s001 ;

left-unit-d01 (C : Cat) (f : Mor C) : Id (Mor C) (funct-on-mor (left-unit-witness C f) d01) (id-mor (dom f)) =
 H.transH (composeA {I} {Delta (suc (suc zero))} {I} {C} f s001 d01)
  (H.transH (ccr {I} {I} {C} f s001-d01) (funct-pres-id {I} {C} f I0)) ;
left-unit-d12 (C : Cat) (f : Mor C) : Id (Mor C) (funct-on-mor (left-unit-witness C f) d12) f =
 H.transH (composeA {I} {Delta (suc (suc zero))} {I} {C} f s001 d12)
  (H.transH (ccr {I} {I} {C} f s001-d12) (comp-id-r {I} {C} f)) ;
left-unit-d02 (C : Cat) (f : Mor C) : Id (Mor C) (funct-on-mor (left-unit-witness C f) d02) f =
 H.transH (composeA {I} {Delta (suc (suc zero))} {I} {C} f s001 d02)
  (H.transH (ccr {I} {I} {C} f s001-d02) (comp-id-r {I} {C} f)) ;

------------------------------------------------------------------------
-- the long edge of a 2-simplex

segal-linv (C : Cat) (s : Map (Delta (suc (suc zero))) C) : Id (Map (Delta (suc (suc zero))) C) (segal-witness C (segal-comparison C s)) s =
 Pl.sec-ret (Map (Delta (suc (suc zero))) C) (ComposablePair C) (segal-comparison C) (segal-is-equiv C) s ;

comp-witness-long (C : Cat) (s : Map (Delta (suc (suc zero))) C) :
 Id (Mor C) (comp-mor C (funct-on-mor s d01) (funct-on-mor s d12) (segal-comparison C s).2.2) (funct-on-mor s d02) =
 H.apH (\ t -> funct-on-mor t d02) (segal-linv C s) ;
