-- Normalization of the actual short path in HMOC3.
-- Expand its two Hom-map-of-comp proofs, move the first through the
-- endpoint coercion, and use HE-trans. This identifies the specified
-- path, not merely another path with the same endpoints.
-- The ambient pentagon then changes the resulting two-step morphism
-- path to the three-step one. The endpoint cells below record exactly
-- the remaining comparison with the long HMOC3 path.
open Base ;
module H = Paths[l] ; module PA = PathAlgebra[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Interval ; open HomPaths ;

module Triple (A B C D : Cat) (F : Map C D) (G : Map B C) (K : Map A B) (m : Mor A) {
 module T = HomTriple.Triple[A, B, C, D, F, G, K, m] ;
 module N = HomCompEndpoints.Normal[A, B, D, comp F G, K, m] ;
 module M = HomCompEndpoints.Normal[B, C, D, F, G, comp K m] ;
 first : Id (Mor D) (hmor T.source) (comp (comp F G) (comp K m)) = composeA (comp F G) K m ;
 second : Id (Mor D) (comp (comp F G) (comp K m)) (hmor T.target) = composeA F G (comp K m) ;
 middle : Hom D (Ob-map F (Ob-map G (Ob-map K (dom m)))) (Ob-map F (Ob-map G (Ob-map K (cod m)))) =
  Hom-coerce D (T.a23 (dom m)) (T.a23 (cod m)) (N.target (dom m) (cod m) (refl (dom m)) (refl (cod m))) ;
 module Endpoint (v : Ob I) {
  module E = HomCompEndpoints.Endpoint[A, B, D, comp F G, K, m, v] ;
  module E1 = HomCompEndpoints.Endpoint[B, C, D, F, G, comp K m, v] ;
  kp : Id (Ob B) (comp {One} {I} {B} (comp K m) v) (Ob-map K (comp {One} {I} {A} m v)) = composeA K m v ;
  first-cell : Id (Id (Ob D) (comp {One} {I} {D} (hmor T.source) v) (Ob-map F (Ob-map G (Ob-map K (comp {One} {I} {A} m v)))))
   (H.transH (E.start (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v))) (T.a23 (comp {One} {I} {A} m v)))
   (H.transH (ccl {One} {I} {D} v first) (E1.start (Ob-map K (comp {One} {I} {A} m v)) kp)) = HomEqCoerce.append (ccl {One} {I} {D} v first)
   (E.start (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v)))
   (H.transH (composeA {One} {I} {B} {D} (comp F G) (comp K m) v) (ccr {One} {B} {D} (comp F G) kp))
   (E.cell (comp {One} {I} {A} m v) (refl (comp {One} {I} {A} m v))) (T.a23 (comp {One} {I} {A} m v)) ;
  second-cell : Id (Id (Ob D) (comp {One} {I} {D} (hmor middle) v) (Ob-map F (Ob-map G (Ob-map K (comp {One} {I} {A} m v)))))
   (E1.start (Ob-map K (comp {One} {I} {A} m v)) kp) (E1.finish (Ob-map K (comp {One} {I} {A} m v)) kp) = E1.explicit (Ob-map K (comp {One} {I} {A} m v)) kp ;
 } ;
 module E0 = Endpoint[I0] ; module E1 = Endpoint[I1] ;
 module Cc = HomEqCoerce.Coerce[D, Ob-map (comp F G) (Ob-map K (dom m)), Ob-map (comp F G) (Ob-map K (cod m)),
  N.source (dom m) (cod m) (refl (dom m)) (refl (cod m)), N.target (dom m) (cod m) (refl (dom m)) (refl (cod m)), first,
  N.E0.cell (dom m) (refl (dom m)), N.E1.cell (cod m) (refl (cod m))] ;
 first-form :
  Id (Id (Hom D (Ob-map F (Ob-map G (Ob-map K (dom m)))) (Ob-map F (Ob-map G (Ob-map K (cod m))))) T.source middle)
   (H.apH (Hom-coerce D (T.a23 (dom m)) (T.a23 (cod m))) (HomFunctor.Hom-map-of-comp (comp F G) K (dom m) (cod m) T.h))
   (Hom-eq D T.source middle first E0.first-cell E1.first-cell) =
  H.transH (H.apH (\ p -> H.apH (Hom-coerce D (T.a23 (dom m)) (T.a23 (cod m))) p)
    (N.form (dom m) (refl (dom m)) (cod m) (refl (cod m))))
   (Cc.naturality (Ob-map F (Ob-map G (Ob-map K (dom m)))) (T.a23 (dom m))
    (Ob-map F (Ob-map G (Ob-map K (cod m)))) (T.a23 (cod m))) ;
 second-form :
  Id (Id (Hom D (Ob-map F (Ob-map G (Ob-map K (dom m)))) (Ob-map F (Ob-map G (Ob-map K (cod m))))) middle T.target)
   (HomFunctor.Hom-map-of-comp F G (Ob-map K (dom m)) (Ob-map K (cod m)) (Hom-map K (dom m) (cod m) T.h))
   (Hom-eq D middle T.target second E0.second-cell E1.second-cell) =
  M.form-explicit (Ob-map K (dom m)) E0.kp (Ob-map K (cod m)) E1.kp ;
 dom-cell : Id (Id (Ob D) (dom (hmor T.source)) (Ob-map F (Ob-map G (Ob-map K (dom m)))))
  (hdom T.source) (H.transH (ccl {One} {I} {D} I0 (H.transH first second)) (hdom T.target)) = HomEqCalc.end-trans D I0 first second E0.first-cell E0.second-cell ;
 cod-cell : Id (Id (Ob D) (cod (hmor T.source)) (Ob-map F (Ob-map G (Ob-map K (cod m)))))
  (hcod T.source) (H.transH (ccl {One} {I} {D} I1 (H.transH first second)) (hcod T.target)) = HomEqCalc.end-trans D I1 first second E1.first-cell E1.second-cell ;
 short-form :
  Id (Id (Hom D (Ob-map F (Ob-map G (Ob-map K (dom m)))) (Ob-map F (Ob-map G (Ob-map K (cod m))))) T.source T.target)
   T.short (Hom-eq D T.source T.target (H.transH first second) dom-cell cod-cell) =
  H.transH (PA.tcong first-form second-form)
   (HomEqCalc.HE-trans D T.source (hmor middle) first (hdom middle) (hcod middle) E0.first-cell E1.first-cell
    (hmor T.target) second (hdom T.target) (hcod T.target) E0.second-cell E1.second-cell) ;

 long-path : Id (Mor D) (hmor T.source) (hmor T.target) =
  H.transH (H.transH (ccl {I} {A} {D} m (composeA {A} {B} {C} {D} F G K)) (composeA {I} {A} {C} {D} F (comp G K) m))
   (ccr {I} {C} {D} F (composeA {I} {A} {B} {C} G K m)) ;
 module Compare = HomEqHigher.Compare[D, Ob-map F (Ob-map G (Ob-map K (dom m))), Ob-map F (Ob-map G (Ob-map K (cod m))), T.source, T.target] ;
 moved-dom : Id (Id (Ob D) (dom (hmor T.source)) (Ob-map F (Ob-map G (Ob-map K (dom m)))))
  (hdom T.source) (Compare.dom-path long-path) = H.transH dom-cell (H.apH Compare.dom-path (pentagonator {I} {A} {B} {C} {D} F G K m)) ;
 moved-cod : Id (Id (Ob D) (cod (hmor T.source)) (Ob-map F (Ob-map G (Ob-map K (cod m)))))
  (hcod T.source) (Compare.cod-path long-path) = H.transH cod-cell (H.apH Compare.cod-path (pentagonator {I} {A} {B} {C} {D} F G K m)) ;
 short-long-form :
  Id (Id (Hom D (Ob-map F (Ob-map G (Ob-map K (dom m)))) (Ob-map F (Ob-map G (Ob-map K (cod m))))) T.source T.target)
   T.short (Hom-eq D T.source T.target long-path moved-dom moved-cod) =
  H.transH short-form (Compare.Move[H.transH first second, dom-cell, cod-cell].move long-path (pentagonator {I} {A} {B} {C} {D} F G K m)) ;
} ;
