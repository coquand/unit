-- The structural connecting homomorphism, stated directly for the
-- existing homology groups of a pushout of types. For all n >= 0,
-- H_(n+2)(X) -> H_(n+1)(C) -> H_(n+1)(B) x H_(n+1)(E)
-- is exact at H_(n+1)(C), and the first map is a homomorphism.
-- The outgoing maps are HGroupMaps.hmap, not transported substitutes.
-- Both groups are abelian by the existing stability results.
open Base ;
module H = Paths[l] ; module PM = Pi0Maps[l] ;
open HigherCat ; open HGroups ;

module Types (B C E X : U k) (i : C -> B) (j : C -> E) (u : B -> X) (v : E -> X)
 (h : (c : C) -> Id X (u (i c)) (v (j c))) (A : Ob D)
 (po : TypePushout.TSquare[B, C, E, X, i, j, u, v, h].is-pushout) (n : Nat) {
 module Ex = Excision.ExcisionOf[B, C, E, X, i, j, u, v, h, A] ;
 module Q = HomologyFibreLegs.Sequence[Ex.CA, Ex.BA, Ex.EA, Ex.XA, Ex.ti, Ex.tj, Ex.tu, Ex.tv, Ex.cell, Ex.excision po, Sph n] ;
 delta : homology (suc (suc n)) X A -> homology (suc n) C A = Q.Q.connecting ;
 hom : PM.is-hom (hgrp (suc n) X A) (hgrp n C A) delta = Q.Q.hom ;
 zero-left (a : homology (suc (suc n)) X A) :
  Id (homology (suc n) B A) (HGroupMaps.hmap (suc n) A i (delta a)) (hgrp n B A).e = Q.Left.killed a ;
 zero-right (a : homology (suc (suc n)) X A) :
  Id (homology (suc n) E A) (HGroupMaps.hmap (suc n) A j (delta a)) (hgrp n E A).e = Q.Right.killed a ;
 exact (c : homology (suc n) C A)
  (hi : Id (homology (suc n) B A) (HGroupMaps.hmap (suc n) A i c) (hgrp n B A).e)
  (hj : Id (homology (suc n) E A) (HGroupMaps.hmap (suc n) A j c) (hgrp n E A).e) : Q.Q.Image c = Q.exact c hi hj ;
} ;
