-- Composition of morphisms from contractible fillers (Wärn, Construction
-- 22; M6, step 4).  Level 1: it uses the Segal axiom at n = 2 only.
--   Pair C: composable morphisms with their vertices, z -> y -> x.
--   Tri C: a pair with a third morphism z -> x (the boundary of a
--   triangle).  Pair-map, Tri-map: the action of a functor.
--   std-tri: the boundary of Delta 2: its vertices w0, w1, w2 and its
--   edges d01, d12, d02 with their endpoints.  bd s = Tri-map s std-tri is
--   the boundary of a 2-simplex s; bd-pair s its first two edges.
--   segal2-equiv: bd-pair is an equivalence.  It is the Segal comparison
--   followed by kappa : ComposablePair C ~ Pair C,
--   (f, g, p) |-> (dom f, cod f, cod g, (f, refl, refl), (g, p^-1, refl)),
--   whose inverse forgets the vertices (pair-contract: J on the endpoint
--   paths).  The two agree on the path cod (s d01) = dom (s d12) by the
--   groupoid laws, since segal-comm = d01-cod . d12-dom^-1.
--   The fillers of a pair p, (s, bd-pair s = p), form a contractible
--   type; composite p is the long edge of its centre, moved along the
--   identification of its first two edges with p.
--   composite-witness: for any 2-simplex s with boundary t, the
--   composite of the first two edges of t is the third, by
--   contractibility.  composite-filler: the composite has such a
--   2-simplex.  Composition is locked after these two lemmas.
--   composite-agrees: on the boundary of a 2-simplex s the composite has
--   the morphism comp-mor of Segal (both are s o d02).
open Base ;
module H = Paths[l] ; module Pl = Prelude[l] ; module PA = PathAlgebra[l] ; module EL = EquivalenceLemmas[l] ; module CU = FunExtUA[l] ;
open WildCat ; open HigherCat ; open Constructions ; open Exponentials ; open Interval ; open SegalComparison ; open Segal ; open FibreLemmas ;

Pair (C : Cat) : U l = (z : Ob C) * (y : Ob C) * (x : Ob C) * Hom C z y * Hom C y x ;

HomQ (C : Cat) (p : Pair C) : U l = Hom C p.1 p.2.2.1 ;

Tri (C : Cat) : U l = (p : Pair C) * HomQ C p ;

Pair-map {A B : Cat} (F : Map A B) (p : Pair A) : Pair B =
 (Ob-map F p.1, Ob-map F p.2.1, Ob-map F p.2.2.1, Hom-map F p.1 p.2.1 p.2.2.2.1, Hom-map F p.2.1 p.2.2.1 p.2.2.2.2) ;

Tri-map {A B : Cat} (F : Map A B) (t : Tri A) : Tri B = (Pair-map F t.1, Hom-map F t.1.1 t.1.2.2.1 t.2) ;

-- the boundary of Delta 2
w0 : Ob (Delta (suc (suc zero))) = map-to-ob (Delta (suc zero)) I v0 ;
w1 : Ob (Delta (suc (suc zero))) = map-to-ob (Delta (suc zero)) I v1 ;
w2 : Ob (Delta (suc (suc zero))) = map-to-ob (Delta (suc zero)) I v2 ;

std-pair : Pair (Delta (suc (suc zero))) = (w0, w1, w2, (d01, d01-dom, d01-cod), (d12, d12-dom, d12-cod)) ;

std-tri : Tri (Delta (suc (suc zero))) = (std-pair, (d02, d02-dom, d02-cod)) ;

bd (C : Cat) (s : Map (Delta (suc (suc zero))) C) : Tri C = Tri-map s std-tri ;

bd-pair (C : Cat) (s : Map (Delta (suc (suc zero))) C) : Pair C = Pair-map s std-pair ;

------------------------------------------------------------------------
-- composable pairs with and without their vertices

kappa (C : Cat) (w : ComposablePair C) : Pair C =
 (dom {C} w.1, cod {C} w.1, cod {C} w.2.1, (w.1, refl (dom {C} w.1), refl (cod {C} w.1)), (w.2.1, H.symH w.2.2, refl (cod {C} w.2.1))) ;

unkappa (C : Cat) (p : Pair C) : ComposablePair C =
 (p.2.2.2.1.1, p.2.2.2.2.1, H.transH p.2.2.2.1.2.2 (H.symH p.2.2.2.2.2.1)) ;

-- J on the codomain of the second morphism
pair-contract3 (C : Cat) (m1 m2 : Mor C) (p2 : Id (Ob C) (dom {C} m2) (cod {C} m1)) (x : Ob C) (q2 : Id (Ob C) (cod {C} m2) x) :
 Id (Pair C) (kappa C (m1, m2, H.transH (refl (cod {C} m1)) (H.symH p2)))
  (dom {C} m1, cod {C} m1, x, (m1, refl (dom {C} m1), refl (cod {C} m1)), (m2, p2, q2)) =
 idJ (Ob C) (cod {C} m2) (\ x1 r1 -> Id (Pair C) (kappa C (m1, m2, H.transH (refl (cod {C} m1)) (H.symH p2)))
   (dom {C} m1, cod {C} m1, x1, (m1, refl (dom {C} m1), refl (cod {C} m1)), (m2, p2, r1)))
  (H.apH {Id (Ob C) (dom {C} m2) (cod {C} m1)} {Pair C}
    (\ v -> (dom {C} m1, cod {C} m1, cod {C} m2, (m1, refl (dom {C} m1), refl (cod {C} m1)), (m2, v, refl (cod {C} m2))))
    (H.transH (H.apH (\ r -> H.symH r) (PA.unit-l (H.symH p2))) (PA.sym-sym p2)))
  x q2 ;

-- J on the middle vertex
pair-contract2 (C : Cat) (m1 m2 : Mor C) (y : Ob C) (q1 : Id (Ob C) (cod {C} m1) y) :
 (p2 : Id (Ob C) (dom {C} m2) y) (x : Ob C) (q2 : Id (Ob C) (cod {C} m2) x) ->
 Id (Pair C) (kappa C (m1, m2, H.transH q1 (H.symH p2))) (dom {C} m1, y, x, (m1, refl (dom {C} m1), q1), (m2, p2, q2)) =
 idJ (Ob C) (cod {C} m1) (\ y1 r1 -> (p2 : Id (Ob C) (dom {C} m2) y1) (x : Ob C) (q2 : Id (Ob C) (cod {C} m2) x) ->
   Id (Pair C) (kappa C (m1, m2, H.transH r1 (H.symH p2))) (dom {C} m1, y1, x, (m1, refl (dom {C} m1), r1), (m2, p2, q2)))
  (pair-contract3 C m1 m2) y q1 ;

pair-contract (C : Cat) (p : Pair C) : Id (Pair C) (kappa C (unkappa C p)) p =
 idJ (Ob C) (dom {C} p.2.2.2.1.1) (\ z1 r1 -> Id (Pair C) (kappa C (unkappa C p))
   (z1, p.2.1, p.2.2.1, (p.2.2.2.1.1, r1, p.2.2.2.1.2.2), p.2.2.2.2))
  (pair-contract2 C p.2.2.2.1.1 p.2.2.2.2.1 p.2.1 p.2.2.2.1.2.2 p.2.2.2.2.2.1 p.2.2.1 p.2.2.2.2.2.2)
  p.1 p.2.2.2.1.2.1 ;

kappa-equiv (C : Cat) : Pl.isEquiv (ComposablePair C) (Pair C) (kappa C) =
 Pl.qinv (ComposablePair C) (Pair C) (kappa C) (unkappa C) (pair-contract C)
  (\ w -> H.apH {Id (Ob C) (cod {C} w.1) (dom {C} w.2.1)} {ComposablePair C} (\ v -> (w.1, w.2.1, v))
    (H.transH (PA.unit-l (H.symH (H.symH w.2.2))) (PA.sym-sym w.2.2))) ;

------------------------------------------------------------------------
-- the boundary map is the Segal comparison followed by kappa

module Agree (C : Cat) (s : Map (Delta (suc (suc zero))) C) {
 cn : Id (Ob C) (cod {C} (comp s d01)) (Ob-map s (cod d01)) = cod-nat s d01 ;
 dn : Id (Ob C) (dom {C} (comp s d12)) (Ob-map s (dom d12)) = dom-nat s d12 ;
 A1 : Id (Ob C) (Ob-map s (cod d01)) (Ob-map s w1) = H.apH (Ob-map s) d01-cod ;
 B1 : Id (Ob C) (Ob-map s (dom d12)) (Ob-map s w1) = H.apH (Ob-map s) d12-dom ;
 path-eq : Id (Id (Ob C) (cod {C} (comp s d01)) (dom {C} (comp s d12)))
  (segal-comparison C s).2.2 (H.transH (H.transH cn A1) (H.symH (H.transH dn B1))) =
  calc (Id (Ob C) (cod {C} (comp s d01)) (dom {C} (comp s d12))) {
   H.transH cn (H.transH (H.apH (Ob-map s) (H.transH d01-cod (H.symH d12-dom))) (H.symH dn))
   =< H.apH (\ r -> H.transH cn (H.transH r (H.symH dn)))
       (H.transH (PA.ap-trans (Ob-map s) d01-cod (H.symH d12-dom)) (H.apH (\ r -> H.transH A1 r) (PA.ap-sym (Ob-map s) d12-dom))) >
     H.transH cn (H.transH (H.transH A1 (H.symH B1)) (H.symH dn))
   =< H.apH (\ r -> H.transH cn r) (PA.tassoc A1 (H.symH B1) (H.symH dn)) > H.transH cn (H.transH A1 (H.transH (H.symH B1) (H.symH dn)))
   =< H.symH (PA.tassoc cn A1 (H.transH (H.symH B1) (H.symH dn))) > H.transH (H.transH cn A1) (H.transH (H.symH B1) (H.symH dn))
   =< H.apH (\ r -> H.transH (H.transH cn A1) r) (H.symH (PA.sym-trans dn B1)) > H.transH (H.transH cn A1) (H.symH (H.transH dn B1)) } ;
 agree : Id (Pair C) (kappa C (segal-comparison C s)) (bd-pair C s) =
  H.transH (H.apH {Id (Ob C) (cod {C} (comp s d01)) (dom {C} (comp s d12))} {Pair C}
    (\ v -> kappa C (comp s d01, comp s d12, v)) path-eq)
   (pair-contract C (bd-pair C s)) ;
} ;

segal2-equiv (C : Cat) : Pl.isEquiv (Map (Delta (suc (suc zero))) C) (Pair C) (bd-pair C) =
 EL.homotopy (Map (Delta (suc (suc zero))) C) (Pair C) (\ s -> kappa C (segal-comparison C s)) (bd-pair C)
  (\ s -> Agree[C, s].agree)
  (EL.compose (Map (Delta (suc (suc zero))) C) (ComposablePair C) (Pair C) (kappa C) (segal-comparison C)
    (kappa-equiv C) (segal-is-equiv C)) ;

------------------------------------------------------------------------
-- composition

Fill (C : Cat) (p : Pair C) : U l = fib (bd-pair C) p ;

fill-contr (C : Cat) (p : Pair C) : CU.isContr (Fill C p) =
 equiv-fibre-contr (Map (Delta (suc (suc zero))) C) (Pair C) (bd-pair C) (segal2-equiv C) p ;

long (C : Cat) (p : Pair C) (f : Fill C p) : HomQ C p = H.substH (HomQ C) f.2 (bd C f.1).2 ;

composite (C : Cat) (p : Pair C) : HomQ C p = long C p (fill-contr C p).1 ;

composite-char (C : Cat) (p : Pair C) (f : Fill C p) : Id (HomQ C p) (composite C p) (long C p f) =
 H.apH (long C p) (CU.pathC (Fill C p) (fill-contr C p) (fill-contr C p).1 f) ;

composite-witness (C : Cat) (t : Tri C) (s : Map (Delta (suc (suc zero))) C) (psi : Id (Tri C) (bd C s) t) :
 Id (HomQ C t.1) (composite C t.1) t.2 =
 H.transH (composite-char C t.1 (s, H.apH {Tri C} {Pair C} (\ u -> u.1) psi))
  (Pl.Sigma-snd (Pair C) (HomQ C) (bd C s).1 t.1 (bd C s).2 t.2 psi) ;

composite-filler (C : Cat) (p : Pair C) : (s : Map (Delta (suc (suc zero))) C) * Id (Tri C) (bd C s) (p, composite C p) =
 ((fill-contr C p).1.1,
  Pl.Sigma-path (Pair C) (HomQ C) (bd-pair C (fill-contr C p).1.1) p (bd C (fill-contr C p).1.1).2 (composite C p)
   (fill-contr C p).1.2 (refl (composite C p))) ;

opaque composite ;

hcomp {C : Cat} {a b c : Ob C} (g : Hom C a b) (f : Hom C b c) : Hom C a c = composite C (a, b, c, g, f) ;

composite-agrees (C : Cat) (s : Map (Delta (suc (suc zero))) C) :
 Id (Mor C) (composite C (bd-pair C s)).1 (comp-mor C (funct-on-mor s d01) (funct-on-mor s d12) (segal-comparison C s).2.2) =
 H.transH (H.apH {HomQ C (bd-pair C s)} {Mor C} (\ h -> h.1) (composite-witness C (bd C s) s (refl (bd C s))))
  (H.symH (comp-witness-long C s)) ;
