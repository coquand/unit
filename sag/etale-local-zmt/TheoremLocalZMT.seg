-- Theorem local of zmt2-revised.tex with ZMT proved: the hypothesis ZMT of
-- TheoremLocal is discharged by FinalZMTGeneral (sag/zmt-general).
--
-- Hypotheses.  A local, residually discrete, with maximal ideal m (a
-- proposition-valued predicate, m-prop); E etale over A; q a decidable
-- prime of E containing m E; E/mE finite over A/m (merely, fo); and the
-- field case, for the output of ZMT (FieldCase.field).
-- Proof.
--  1. E is generated by x_1 .. x_n, the generators of its presentation
--     (part of "etale"); every element is merely an expression in them.
--  2. FinalZMTGeneral.Theorem for (A, m, E, x): merely s in E with s - 1 in
--     m E and B = A[s, s x_1, .., s x_n] finite over A (Conclusion).
--  3. For such s (At): the data of TheoremLocal.
--     - B with its module generators g_1 .. g_N and a zero generator added
--       (bs), so that there is at least one; coordinates of b are merely
--       those of the finiteness of B, with 0 at the new generator (coord).
--     - s is in B (sB); s - 1 is merely in m E: a witness
--       s - 1 = sum_k a_k w_k with a_k in m is the list of the (a_k, w_k)
--       (wit-to).
--     - every z in E is merely s^k z = b with b in B: z = H(x) merely, and
--       s^N H(x) is in B (CertificateLocalisation.Iso.cleared) (zmt).
--  4. TheoremLocal for these data and the field case gives the conclusion,
--     a proposition: the truncations of 2 and of the field case are
--     eliminated into it.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Ps = Presentations[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module TC = TruncationCombinators[l] ; module RI = RegularIdeal[l] ; module QFm = QuotientFibre[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (m : A.R -> U l) (m-prop : (a : A.R) -> Pr.isProp (m a)) (m-zero : m A.z)
 (m-add : (a c : A.R) -> m a -> m c -> m (A.add a c))
 (m-scale : (a c : A.R) -> m c -> m (A.mul a c))
 (dec : (a : A.R) -> Plus (m a) (RL[A].unit a))
 (rad : (a : A.R) -> m a -> RL[A].unit (A.add A.o (A.neg a)))
 (E : CRing) (setE : Pr.isSet E.R) (iota : H.Hom A E)
 (q : E.R -> U l) (q-zero : q E.z) (q-add : (a c : E.R) -> q a -> q c -> q (E.add a c))
 (q-scale : (a c : E.R) -> q c -> q (E.mul a c)) (q-m : (a : A.R) -> m a -> q (iota.1 a))
 (q-prime : (a c : E.R) -> q (E.mul a c) -> Plus (q a) (q c)) (q-proper : Not (q E.o))
 (q-dec : (a : E.R) -> Plus (q a) (Not (q a)))
 (etale : FormallyEtale[l].Over[A,setA].Etale (Algebras[l].Over[A,setA].mkAlgebra E setE iota))
 -- E/mE is finite over A/m
 (fo : Tr.Trunc[QFm.Over[A,setA,RI.mkIdealPred A m m-zero m-add m-scale,m-prop,Algebras[l].Over[A,setA].mkAlgebra E setE iota].Finite].carrier) {
 module C = Algebras[l].Over[A,setA] ;
 Ea : C.Algebra = C.mkAlgebra E setE iota ;
 I : RI.IdealPred[A] = RI.mkIdealPred A m m-zero m-add m-scale ;
 module IGE = IdealGenerated[l].Over[A,m,E,iota] ;
 module SE = FiniteIdeal[l].Sums[E] ;
 module PE = AffinePowers[l].Over[E] ;
 -- 1. the generators of the presentation generate E
 p : Presentations[l].Over[A,setA].Presentation = etale.2.1 ;
 module GnE = Generated[l].Over[A,setA].Generated[p,Ea,etale.2.2] ;
 n : Nat = p.1 ;
 x : Ps.Fin n -> E.R = etale.2.2.1.1 ;
 gen (e : E.R) : Tr.Trunc[Generated[l].Over[A,setA].Representation p Ea etale.2.2 e].carrier = GnE.generated e ;
 -- 2. ZMT
 module Z = FinalZMTGeneral[l].Theorem[A,setA,I,m-prop,Ea,n,x,gen,fo] ;
 -- a witness of e in m E is a list of generators of m E
 wit-list : (u : Nat) (a : Ps.Fin u -> A.R) (ina : (k : Ps.Fin u) -> m (a k)) (w : Ps.Fin u -> E.R) -> List IGE.Gen = split {
  zero -> \ a ina w -> nil ;
  suc u | r -> \ a ina w -> cons (a (inr tt),ina (inr tt),w (inr tt)) (r (\ k -> a (inl k)) (\ k -> ina (inl k)) (\ k -> w (inl k))) } ;
 wit-sum : (u : Nat) (a : Ps.Fin u -> A.R) (ina : (k : Ps.Fin u) -> m (a k)) (w : Ps.Fin u -> E.R) ->
  Id E.R (SE.lin u (\ k -> iota.1 (a k)) w) (IGE.Ls.lsum IGE.value (wit-list u a ina w)) = split {
  zero -> \ a ina w -> refl E.z ;
  suc u | r -> \ a ina w -> ap (E.add (E.mul (iota.1 (a (inr tt))) (w (inr tt)))) (r (\ k -> a (inl k)) (\ k -> ina (inl k)) (\ k -> w (inl k))) } ;
 wit-to (e : E.R) (c : Z.F.QF.W.Wit e) : IGE.InmB e = (wit-list c.u c.a c.ina c.w,trans c.eq (wit-sum c.u c.a c.ina c.w)) ;

 -- 3. the data of TheoremLocal, for an output of ZMT
 module At (c : Z.Conclusion) {
  s : E.R = c.1 ;
  module B = Z.F.ForS[s].B ;
  module LB = RL[B.ring] ; module SB = FiniteIdeal[l].Sums[B.ring] ;
  fin : QFm.ModuleFinite[A,B.ring,B.iotaB] = c.2.2.1 ;
  -- the generators of B, and 0
  n' : Nat = fin.N ;
  bs : Ps.Fin (suc n') -> B.ring.R = split { inl k -> fin.gb k ; inr t -> B.ring.z } ;
  pad (ab : Ps.Fin n' -> A.R) : Ps.Fin (suc n') -> A.R = split { inl k -> ab k ; inr t -> A.z } ;
  Coord (b : B.ring.R) : U l = (rho : Ps.Fin (suc n') -> A.R) * Id B.ring.R b (SB.sum (suc n') (\ k -> B.ring.mul (B.iotaB.1 (rho k)) (bs k))) ;
  -- sum_k g_k ab_k = iota(0) 0 + sum_k ab_k g_k
  pad-sum (ab : Ps.Fin n' -> A.R) :
   Id B.ring.R (SB.lin n' fin.gb (\ k -> B.iotaB.1 (ab k))) (SB.sum (suc n') (\ k -> B.ring.mul (B.iotaB.1 (pad ab k)) (bs k))) =
   sym (trans (ap (\ t -> B.ring.add t (SB.sum n' (\ k -> B.ring.mul (B.iotaB.1 (ab k)) (fin.gb k)))) (LB.mul-zero (B.iotaB.1 A.z)))
    (trans (LB.zl (SB.sum n' (\ k -> B.ring.mul (B.iotaB.1 (ab k)) (fin.gb k))))
     (SB.sum-cong n' (\ k -> B.ring.mul (B.iotaB.1 (ab k)) (fin.gb k)) (\ k -> B.ring.mul (fin.gb k) (B.iotaB.1 (ab k)))
       (\ k -> B.ring.mulC (B.iotaB.1 (ab k)) (fin.gb k))))) ;
  coord (b : B.ring.R) : Tr.Trunc[Coord b].carrier =
   TC.map ((ab : Ps.Fin n' -> A.R) * Id B.ring.R b (SB.lin n' fin.gb (\ k -> B.iotaB.1 (ab k)))) (Coord b)
    (\ w -> (pad w.1,trans w.2 (pad-sum w.1))) (fin.spans b) ;
  -- s in B, and s - 1 in m E
  sB : B.ring.R = (s,c.2.2.2.1) ;
  s-one : Tr.Trunc[IGE.InmB (E.add s (E.neg E.o))].carrier =
   TC.map (Z.F.QF.W.Wit (E.add s (E.neg E.o))) (IGE.InmB (E.add s (E.neg E.o))) (wit-to (E.add s (E.neg E.o))) c.2.1 ;
  -- every z in E is merely s^k z = b in B
  module LI = Z.F.ForS[s].LI ;
  Zmt (z : E.R) : U l = (k : Nat) * (b : B.ring.R) * Id E.R (E.mul (PE.power s k) z) (B.incl.1 b) ;
  cleared (z : E.R) (h : Generated[l].Over[A,setA].Representation p Ea etale.2.2 z) (cl : LI.Cleared (LI.evx h.1)) : Zmt z =
   (cl.1,(E.mul (PE.power s cl.1) z,B.in-eq _ _ (ap (E.mul (PE.power s cl.1)) h.2) cl.2),refl (E.mul (PE.power s cl.1) z)) ;
  zmt (z : E.R) : Tr.Trunc[Zmt z].carrier =
   TC.bind (Generated[l].Over[A,setA].Representation p Ea etale.2.2 z) (Zmt z)
    (\ h -> TC.map (LI.Cleared (LI.evx h.1)) (Zmt z) (cleared z h) (LI.cleared h.1)) (gen z) ;
  module TL = TheoremLocal[l].Over[A,setA,m,m-zero,m-add,m-scale,dec,rad,E,setE,iota,q,q-zero,q-add,q-scale,q-m,q-prime,q-proper,q-dec,
   B.ring,B.set,B.iotaB,B.incl,\ a -> refl (iota.1 a),n',bs,coord,sB,s-one,zmt,etale] ;
 } ;

 -- 4. Theorem local, given the field case for the output of ZMT
 module St = Local[l].Statement[A,setA,E,setE,iota,q] ;
 module FieldCase (field : (c : Z.Conclusion) -> Tr.Trunc[At[c].TL.FieldData].carrier) {
  at (c : Z.Conclusion) : Truncation[l+].Trunc[St.Conclusion].carrier =
   Tr.Trunc[At[c].TL.FieldData].induction @(l+) (\ w -> Truncation[l+].Trunc[St.Conclusion].carrier)
    (\ w -> Truncation[l+].Trunc[St.Conclusion].proposition) (\ fd -> At[c].TL.theorem-of fd) (field c) ;
  theorem : Truncation[l+].Trunc[St.Conclusion].carrier =
   Tr.Trunc[Z.Conclusion].induction @(l+) (\ w -> Truncation[l+].Trunc[St.Conclusion].carrier)
    (\ w -> Truncation[l+].Trunc[St.Conclusion].proposition) at Z.result ;
 } ;
} ;
