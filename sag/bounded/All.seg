-- All.seg: SAG Theorem 3.3.3 (functions Spec A -> N are merely bounded),
-- in the setting of ../replacement: univalence and replacement are the
-- parameters of one segment; truncation is derived from replacement.
import Base ;
import Prelude ;
import Paths ;
import Axioms ;
import FunExtUA ;
import Replacement ;

module Theory
  (univ : [l] Axioms[l].Univalence)
  (images : [l] [k] Replacement[l,k].Images)
  (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
  fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
  import Truncation ;
  import Ring ;
  import Poly ;
  import Roots ;
  import Group ;
  import Mul ;
  import Bounded ;
  import Bridge ;
} ;
