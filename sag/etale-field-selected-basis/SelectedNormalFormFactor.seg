-- Weighted normal-form identities become exact identities over eA.
-- This is the algebraic restriction step; the selected Gaussian
-- construction itself is imported unchanged from its own directory.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (q : PrimeIdempotents[l].Over[A].Prime)
 (regular : PrincipalRegularity[l].Over[A].Regular) {
 module G = SelectedGaussian[l].Over[A,q,regular] ;
 module At (n m : Nat) (v : Fin m -> G.V.Vec n) (nf : G.NormalForm[n,m,v]) {
  module F = IdempotentVectorMaps[l].Over[A,setA,nf.e,nf.idempotent] ;
  module P = F.Restrict[n,nf.rank,nf.project] ;
  module S = F.Restrict[nf.rank,n,nf.section] ;
  module D = F.Restrict[n,m,nf.coefficients] ;
  relations (j : Fin m) : F.EV.Vec n = F.project n (v j) ;
  retract (x : F.EV.Vec nf.rank) (i : Fin nf.rank) :
   Id F.E.Carrier (P.function (S.function x) i) (x i) =
   F.fixed-equal (P.function (S.function x) i) (x i) (nf.retract (F.under nf.rank x) i) ;
  kills (j : Fin m) (i : Fin nf.rank) : Id F.E.Carrier (P.function (relations j) i) F.E.zero =
   trans (P.project-naturality (v j) i) (F.E.eq _ _ (nf.kills j i)) ;
  difference (x : F.EV.Vec n) : F.EV.Span[n,m,relations].Witness
   (F.EV.subV n x (S.function (P.function x))) =
   (D.function x,\ i -> F.E.eq _ _
    (trans (F.combination n m v (D.function x) i)
     (trans (ap (\ a -> a.1)
      (F.equal (G.V.comb n m v (nf.coefficients.map (F.under n x)) i)
       (G.V.subV n (F.under n x) (nf.section.map (nf.project.map (F.under n x))) i)
       (nf.difference (F.under n x) i)))
      (F.EV.subV n x (S.function (P.function x)) i).2))) ;
 } ;
} ;
