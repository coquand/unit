-- A finite module presentation restricts to an idempotent factor.
-- Generators, relations and kernel coefficients are explicitly projected.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (S : Algebras[l].Over[A,setA].Algebra)
 (e : A.R) (he : Id A.R (A.mul e e) e) {
 module F = IdempotentAlgebraFactor[l].Over[A,setA,S,e,he] ;
 module V = IdempotentVectorMaps[l].Over[A,setA,e,he] ;
 module N = FiniteMatrixCoordinates[l].Natural[A,V.E.ring,V.E.projection] ;
 module DL = DescentLinear[l].Over[A,setA] ;
 module SM = DescentSubmodules[l].Over[Modules[l].Over[A,setA].ring] ;
 module UM = FlatRelations[l].Over[A,S.ring,S.iota].Underlying[setA,S.set] ;
 module ED = DescentLinear[l].Over[V.E.ring,V.E.set] ;
 module EM = DescentSubmodules[l].Over[Modules[l].Over[V.E.ring,V.E.set].ring] ;
 module EU = FlatRelations[l].Over[V.E.ring,F.AlgebraFactor.ring,F.iota].Underlying[V.E.set,F.AlgebraFactor.set] ;
 module At (n m : Nat) (v : Fin m -> V.V.Vec n) (phi : SM.Linear (DL.Free n) UM.M)
  (onto : (x : S.ring.R) -> Tr.Trunc[(c : V.V.Vec n) * Id S.ring.R (phi.1 c) x].carrier)
  (relations : (j : Fin m) -> Id S.ring.R (phi.1 (v j)) S.ring.z)
  (kernel : (c : V.V.Vec n) -> Id S.ring.R (phi.1 c) S.ring.z -> Tr.Trunc[V.V.Span[n,m,v].Witness c].carrier) {
  fixed (c : V.EV.Vec n) : F.AlgebraFactor.Fixed (phi.1 (V.under n c)) =
   trans (sym (phi.2.2 e (V.under n c))) (ap phi.1 (V.fixed n c)) ;
  function (c : V.EV.Vec n) : F.AlgebraFactor.Carrier = (phi.1 (V.under n c),fixed c) ;
  linear : EM.Linear (ED.Free n) EU.M =
   (function,\ c d -> F.AlgebraFactor.eq _ _ (phi.2.1 (V.under n c) (V.under n d)),
    \ a c -> F.AlgebraFactor.eq _ _ (phi.2.2 a.1 (V.under n c))) ;
  projected (c : V.V.Vec n) : Id F.AlgebraFactor.Carrier (function (V.project n c)) (F.AlgebraFactor.project (phi.1 c)) =
   F.AlgebraFactor.eq _ _ (phi.2.2 e c) ;
  Rep (x : F.AlgebraFactor.Carrier) : U l = (c : V.EV.Vec n) * Id F.AlgebraFactor.Carrier (function c) x ;
  representative (x : F.AlgebraFactor.Carrier) (w : (c : V.V.Vec n) * Id S.ring.R (phi.1 c) x.1) : Rep x =
   (V.project n w.1,trans (projected w.1)
    (trans (ap F.AlgebraFactor.project w.2) (F.AlgebraFactor.project-fixed x))) ;
  surjective (x : F.AlgebraFactor.Carrier) : Tr.Trunc[Rep x].carrier =
   TC.map ((c : V.V.Vec n) * Id S.ring.R (phi.1 c) x.1) (Rep x) (representative x) (onto x.1) ;
  columns (j : Fin m) : V.EV.Vec n = V.project n (v j) ;
  killed (j : Fin m) : Id F.AlgebraFactor.Carrier (function (columns j)) F.AlgebraFactor.zero =
   trans (projected (v j))
    (trans (ap F.AlgebraFactor.project (relations j))
     (RingHom[l].zero S.ring F.AlgebraFactor.ring F.AlgebraFactor.projection)) ;
  kernel-witness (c : V.EV.Vec n) (w : V.V.Span[n,m,v].Witness (V.under n c)) : V.EV.Span[n,m,columns].Witness c =
   (V.project m w.1,\ i -> trans (sym (N.combination n m v w.1 i))
    (trans (ap V.E.project (w.2 i)) (V.E.project-fixed (c i)))) ;
  exact (c : V.EV.Vec n) (hc : Id F.AlgebraFactor.Carrier (function c) F.AlgebraFactor.zero) :
   Tr.Trunc[V.EV.Span[n,m,columns].Witness c].carrier =
   TC.map (V.V.Span[n,m,v].Witness (V.under n c)) (V.EV.Span[n,m,columns].Witness c) (kernel-witness c)
    (kernel (V.under n c) (ap (\ a -> a.1) hc)) ;
 } ;
} ;
