-- A finite module presentation over a regular ring is free after one
-- selected idempotent cut. The selected Gaussian normal form is actually
-- constructed, then restricted to eA and packaged as a TraceBasis of eS.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (S : Algebras[l].Over[A,setA].Algebra)
 (q : PrimeIdempotents[l].Over[A].Prime) (regular : PrincipalRegularity[l].Over[A].Regular) {
 module G = SelectedGaussian[l].Over[A,q,regular] ;
 module Build = SelectedGaussianConstruction[l].Over[A,q,regular] ;
 module DL = DescentLinear[l].Over[A,setA] ;
 module SM = DescentSubmodules[l].Over[Modules[l].Over[A,setA].ring] ;
 module UM = FlatRelations[l].Over[A,S.ring,S.iota].Underlying[setA,S.set] ;
 record Result {
  e : A.R ; idempotent : Id A.R (A.mul e e) e ; outside : Not (q.ideal.In e) ; rank : Nat ;
  basis : TraceBasis[l].Over[
   IdempotentAlgebraFactor[l].Over[A,setA,S,e,idempotent].BaseFactor.ring,
   IdempotentAlgebraFactor[l].Over[A,setA,S,e,idempotent].BaseFactor.set,
   IdempotentAlgebraFactor[l].Over[A,setA,S,e,idempotent].algebra].Basis[rank] ;
 } ;
 module At (n m : Nat) (v : Fin m -> G.V.Vec n) (phi : SM.Linear (DL.Free n) UM.M)
  (onto : (x : S.ring.R) -> Tr.Trunc[(c : G.V.Vec n) * Id S.ring.R (phi.1 c) x].carrier)
  (relations : (j : Fin m) -> Id S.ring.R (phi.1 (v j)) S.ring.z)
  (kernel : (c : G.V.Vec n) -> Id S.ring.R (phi.1 c) S.ring.z -> Tr.Trunc[G.V.Span[n,m,v].Witness c].carrier) {
  module Normal (nf : G.NormalForm[n,m,v]) {
   module NF = SelectedNormalFormFactor[l].Over[A,setA,q,regular].At[n,m,v,nf] ;
   module IP = IdempotentPresentation[l].Over[A,setA,S,nf.e,nf.idempotent] ;
   module P = IP.At[n,m,v,phi,onto,relations,kernel] ;
   module MB = NormalFormModuleBasis[l].Over[NF.F.E.ring,NF.F.E.set] ;
   module B = MB.At[n,m,P.columns,IP.EU.M,P.linear,P.surjective,P.killed,P.exact,
    nf.rank,NF.P.linear,NF.S.linear,NF.retract,NF.kills,NF.difference] ;
   module TB = TraceBasis[l].Over[NF.F.E.ring,NF.F.E.set,IP.F.algebra] ;
   reconstruction (x : IP.F.AlgebraFactor.Carrier) :
    Id IP.F.AlgebraFactor.Carrier
     (TB.SS.sum nf.rank (\ j -> IP.F.AlgebraFactor.ring.mul (IP.F.iota.1 (B.coordinate x j)) (B.vector j))) x =
    trans (sym (trans (MB.DL.On[IP.EU.M].lin-value nf.rank B.vector (B.coordinate x))
     (IP.EU.sums nf.rank (\ j -> IP.F.AlgebraFactor.ring.mul (IP.F.iota.1 (B.coordinate x j)) (B.vector j)))))
     (B.expands x) ;
   basis : TB.Basis[nf.rank] = TB.mkBasis nf.rank B.vector B.coordinate B.add B.scale reconstruction B.on-vector ;
   result : Result = new Result[nf.e,nf.idempotent,nf.outside,nf.rank,basis] ;
  } ;
  theorem : Tr.Trunc[Result].carrier = TC.map G.NormalForm[n,m,v] Result (\ nf -> Normal[nf].result) (Build.theorem n m v) ;
 } ;
} ;
