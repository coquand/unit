-- A=F2 x F2, S=F2 through the first projection. The finite A-module
-- is not free on all of A, but becomes free on the selected component.
-- Also check the actual Gaussian dimensions of factors e=0,(1,0),1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module H = RingHom[l] ;
module T = SelectedGaussianRegression[l] ; module BF = BooleanRing[l] ;
module C = Algebras[l].Over[T.k,BF.bool-set] ;
scalar : H.Hom T.k T.A = (\ a -> (a,a),refl T.o,\ a b -> refl (T.k.add a b,T.k.add a b),\ a b -> refl (T.k.mul a b,T.k.mul a b)) ;
algebraA : C.Algebra = C.mkAlgebra T.A T.setA scalar ;
first : H.Hom T.A T.k = (\ a -> a.1,refl true,\ a b -> refl (T.k.add a.1 b.1),\ a b -> refl (T.k.mul a.1 b.1)) ;
arrow : C.Hom algebraA C.base = (first,\ a -> refl a) ;
module AB = TraceBasis[l].Over[T.k,BF.bool-set,algebraA] ;
module KB = TraceBasis[l].Over[T.k,BF.bool-set,C.base] ;
two-elim (P : Fin T.two -> U l) (a : P T.i0) (b : P T.i1) : (i : Fin T.two) -> P i =
 AffineFinite[l].section T.one P
  (AffineFinite[l].section zero (\ i -> P (inl i)) (\ i -> efq i) a) b ;
vector : Fin T.two -> T.Pair = snoc (Fin T.one) T.Pair (\ i -> (true,false)) (false,true) ;
coordinate (a : T.Pair) : Fin T.two -> T.k.R = snoc (Fin T.one) T.k.R (\ i -> a.1) a.2 ;
add (a b : T.Pair) : (i : Fin T.two) -> Id T.k.R (coordinate (T.A.add a b) i) (T.k.add (coordinate a i) (coordinate b i)) =
 two-elim (\ i -> Id T.k.R (coordinate (T.A.add a b) i) (T.k.add (coordinate a i) (coordinate b i)))
  (refl (T.k.add a.1 b.1)) (refl (T.k.add a.2 b.2)) ;
scale (r : T.k.R) (a : T.Pair) : (i : Fin T.two) ->
 Id T.k.R (coordinate (T.A.mul (scalar.1 r) a) i) (T.k.mul r (coordinate a i)) =
 two-elim (\ i -> Id T.k.R (coordinate (T.A.mul (scalar.1 r) a) i) (T.k.mul r (coordinate a i)))
  (refl (T.k.mul r a.1)) (refl (T.k.mul r a.2)) ;
reconstruction : (a b : T.k.R) ->
 Id T.Pair (AB.SS.sum T.two (\ i -> T.A.mul (scalar.1 (coordinate (a,b) i)) (vector i))) (a,b) = split {
 false -> split { false -> refl (false,false) ; true -> refl (false,true) } ;
 true -> split { false -> refl (true,false) ; true -> refl (true,true) } } ;
on-vector : (j i : Fin T.two) -> Id T.k.R (coordinate (vector j) i) (AB.Delta.delta T.two i j) =
 two-elim (\ j -> (i : Fin T.two) -> Id T.k.R (coordinate (vector j) i) (AB.Delta.delta T.two i j))
  (two-elim (\ i -> Id T.k.R (coordinate (vector T.i0) i) (AB.Delta.delta T.two i T.i0)) (refl true) (refl false))
  (two-elim (\ i -> Id T.k.R (coordinate (vector T.i1) i) (AB.Delta.delta T.two i T.i1)) (refl false) (refl true)) ;
basisA : AB.Basis[T.two] = AB.mkBasis T.two vector coordinate add scale (\ a -> reconstruction a.1 a.2) on-vector ;
base-on-vector : (j i : Fin T.one) -> Id T.k.R true (KB.Delta.delta T.one i j) =
 split { inl e -> efq e ; inr t -> split { inl e -> efq e ; inr u -> refl true } } ;
basisK : KB.Basis[T.one] = KB.mkBasis T.one (\ i -> true) (\ a i -> a)
 (\ a b i -> refl (T.k.add a b)) (\ a b i -> refl (T.k.mul a b))
 (\ a -> trans (T.k.addZ (T.k.mul a true)) (T.k.mulO a)) base-on-vector ;
module Selected = SelectedFiniteAlgebraBasis[l].Over[T.k,BF.bool-set,algebraA,C.base,arrow,
 T.two,T.one,basisA,basisK,T.q,T.regular] ;
constructed : Tr.Trunc[Selected.B.Result].carrier = Selected.theorem ;
module Verify (r : Selected.B.Result) {
 module F = Selected.Factor[r] ; module Fields = F.Field[T.dec] ;
 relative-basis : TraceBasis[l].Over[F.Relative.BaseFactor.ring,F.Relative.BaseFactor.set,F.Relative.algebra].Basis[r.rank] = r.basis ;
 base-basis : TraceBasis[l].Over[T.k,BF.bool-set,F.BasePart.algebra].Basis[Fields.BaseBasis.rank] = Fields.base-basis ;
 target-basis : TraceBasis[l].Over[T.k,BF.bool-set,F.Target.algebra].Basis[Fields.TargetBasis.rank] = Fields.target-basis ;
 outside : Not (T.member r.e) = r.outside ;
} ;
module Zero = IdempotentFieldBasis[l].Over[T.k,BF.bool-set,T.dec,algebraA,T.two,basisA,T.z,refl T.z] ;
module Proper = IdempotentFieldBasis[l].Over[T.k,BF.bool-set,T.dec,algebraA,T.two,basisA,(true,false),refl (true,false)] ;
module Whole = IdempotentFieldBasis[l].Over[T.k,BF.bool-set,T.dec,algebraA,T.two,basisA,T.o,refl T.o] ;
zero-rank : Id Nat Zero.rank zero = refl zero ;
proper-rank : Id Nat Proper.rank T.one = refl T.one ;
whole-rank : Id Nat Whole.rank T.two = refl T.two ;
proper-basis : TraceBasis[l].Over[T.k,BF.bool-set,Proper.R.algebra].Basis[T.one] = Proper.basis ;
-- A nonzero element of A is killed in the selected factor.
other-killed : Id Proper.R.F.Carrier (Proper.R.F.project T.other) Proper.R.F.zero = Proper.R.F.eq _ _ (refl T.z) ;
other-nonzero : Not (Id T.Pair T.other T.z) = T.other-nonzero ;
