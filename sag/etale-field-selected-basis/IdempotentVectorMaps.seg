-- Restrict a linear map to vectors fixed by an idempotent. The output
-- is fixed because of linearity; no projective-module choice is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (e : A.R) (he : Id A.R (A.mul e e) e) {
 module E = IdempotentFactor[l].Over[A,setA,e,he] ;
 module V = GaussianVectors[l].Over[A] ; module EV = GaussianVectors[l].Over[E.ring] ;
 module S = FiniteIdeal[l].Sums[A] ; module ES = FiniteIdeal[l].Sums[E.ring] ; module L = RL[A] ;
 under (n : Nat) (x : EV.Vec n) : V.Vec n = \ i -> (x i).1 ;
 project (n : Nat) (x : V.Vec n) : EV.Vec n = \ i -> E.project (x i) ;
 fixed (n : Nat) (x : EV.Vec n) : Id (V.Vec n) (V.scaleV n e (under n x)) (under n x) =
  V.ext n _ _ (\ i -> (x i).2) ;
 project-under (n : Nat) (x : EV.Vec n) : Id (EV.Vec n) (project n (under n x)) x =
  EV.ext n _ _ (\ i -> E.project-fixed (x i)) ;
 sum-under : (n : Nat) (x : Fin n -> E.Carrier) -> Id A.R (ES.sum n x).1 (S.sum n (\ i -> (x i).1)) = split {
  zero -> \ x -> refl A.z ;
  suc n | ih -> \ x -> ap (A.add (x (inr tt)).1) (ih (\ i -> x (inl i))) } ;
 equal (a b : A.R) (eq : Id A.R (A.mul e (A.add a (A.neg b))) A.z) :
  Id E.Carrier (E.project a) (E.project b) =
  E.eq _ _ (FormallyEtale[l].Units[A,setA].sub-zero (A.mul e a) (A.mul e b)
   (trans (sym (trans (A.dist e a (A.neg b)) (ap (A.add (A.mul e a)) (L.mul-neg e b)))) eq)) ;
 fixed-equal (a b : E.Carrier) (eq : Id A.R (A.mul e (A.add a.1 (A.neg b.1))) A.z) : Id E.Carrier a b =
  trans (sym (E.project-fixed a)) (trans (equal a.1 b.1 eq) (E.project-fixed b)) ;
 module Restrict (n r : Nat) (f : V.Linear[n,r]) {
  fixed-output (x : EV.Vec n) (i : Fin r) : E.Fixed (f.map (under n x) i) =
   trans (sym (f.scale e (under n x) i)) (ap (\ a -> f.map a i) (fixed n x)) ;
  function (x : EV.Vec n) : EV.Vec r = \ i -> (f.map (under n x) i,fixed-output x i) ;
  linear : EV.Linear[n,r] = new EV.Linear[n,r,function,
   \ i -> E.eq _ _ (f.zero i),
   \ x y i -> E.eq _ _ (f.add (under n x) (under n y) i),
   \ a x i -> E.eq _ _ (f.scale a.1 (under n x) i)] ;
  project-naturality (x : V.Vec n) (i : Fin r) :
   Id E.Carrier (function (project n x) i) (E.project (f.map x i)) = E.eq _ _ (f.scale e x i) ;
 } ;
 combination (n m : Nat) (v : Fin m -> V.Vec n) (c : EV.Vec m) (i : Fin n) :
  Id A.R (EV.comb n m (\ j -> project n (v j)) c i).1 (A.mul e (V.comb n m v (under m c) i)) =
  trans (sum-under m (\ j -> E.ring.mul (E.project (v j i)) (c j)))
   (trans (S.sum-cong m (\ j -> A.mul (A.mul e (v j i)) (c j).1)
    (\ j -> A.mul e (A.mul (v j i) (c j).1)) (\ j -> sym (A.mulA e (v j i) (c j).1)))
    (S.sum-scale e m (\ j -> A.mul (v j i) (c j).1))) ;
} ;
