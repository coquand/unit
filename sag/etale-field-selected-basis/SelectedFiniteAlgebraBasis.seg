-- Finite k-bases of A and S supply the actual finite A-module
-- presentation required by the selected basis construction.
-- No presentation or normal-form hypothesis remains in this export.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R)
 (A S : Algebras[l].Over[k,setk].Algebra) (h : Algebras[l].Over[k,setk].Hom A S)
 (m n : Nat) (ab : TraceBasis[l].Over[k,setk,A].Basis[m])
 (sb : TraceBasis[l].Over[k,setk,S].Basis[n])
 (q : PrimeIdempotents[l].Over[A.ring].Prime)
 (regular : PrincipalRegularity[l].Over[A.ring].Regular) {
 module C = Algebras[l].Over[A.ring,A.set] ;
 algebra : C.Algebra = C.mkAlgebra S.ring S.set h.1 ;
 module P = FiniteAlgebraModulePresentation[l].Over[k,setk,A,S,h,m,n,ab,sb] ;
 module B = SelectedAlgebraBasis[l].Over[A.ring,A.set,algebra,q,regular] ;
 module Apply = B.At[n,P.count,P.relations,P.linear,P.onto,P.killed,P.kernel-merely] ;
 theorem : Tr.Trunc[B.Result].carrier = Apply.theorem ;
 module Factor (r : B.Result) {
  module Relative = IdempotentAlgebraFactor[l].Over[A.ring,A.set,algebra,r.e,r.idempotent] ;
  module BasePart = TraceRetraction[l].Idempotent[k,setk,A,r.e,r.idempotent] ;
  module Target = TraceRetraction[l].Idempotent[k,setk,S,h.1.1 r.e,Relative.image-idempotent] ;
  compatibility (a : k.R) : Id Target.F.Carrier (Relative.iota.1 (BasePart.iota.1 a)) (Target.iota.1 a) =
   Target.F.eq _ _ (trans (h.1.2.2.2 r.e (A.iota.1 a)) (ap (S.ring.mul (h.1.1 r.e)) (h.2 a))) ;
  inclusion : Algebras[l].Over[k,setk].Hom BasePart.algebra Target.algebra = (Relative.iota,compatibility) ;
  module Injective (injective : (a b : A.ring.R) -> Id S.ring.R (h.1.1 a) (h.1.1 b) -> Id A.ring.R a b) {
   injective-arrow (a b : BasePart.F.Carrier) (eq : Id Target.F.Carrier (inclusion.1.1 a) (inclusion.1.1 b)) :
    Id BasePart.F.Carrier a b = Relative.Injective[injective].theorem a b eq ;
  } ;
  module Field (dec : (a : k.R) -> Plus (Id k.R a k.z) (RL[k].unit a)) {
   module BaseBasis = IdempotentFieldBasis[l].Over[k,setk,dec,A,m,ab,r.e,r.idempotent] ;
   module TargetBasis = IdempotentFieldBasis[l].Over[k,setk,dec,S,n,sb,h.1.1 r.e,Relative.image-idempotent] ;
   base-basis : TraceBasis[l].Over[k,setk,BasePart.algebra].Basis[BaseBasis.rank] = BaseBasis.basis ;
   target-basis : TraceBasis[l].Over[k,setk,Target.algebra].Basis[TargetBasis.rank] = TargetBasis.basis ;
  } ;
 } ;
} ;
