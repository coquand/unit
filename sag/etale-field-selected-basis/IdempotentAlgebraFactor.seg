-- eS is naturally an algebra over eA, with units h(e) and e.
-- Both are actual fixed-point subtype rings, not assumed localizations.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R)
 (S : Algebras[l].Over[A,setA].Algebra) (e : A.R) (he : Id A.R (A.mul e e) e) {
 module BaseFactor = IdempotentFactor[l].Over[A,setA,e,he] ;
 image-idempotent : Id S.ring.R (S.ring.mul (S.iota.1 e) (S.iota.1 e)) (S.iota.1 e) =
  trans (sym (S.iota.2.2.2 e e)) (ap S.iota.1 he) ;
 module AlgebraFactor = IdempotentFactor[l].Over[S.ring,S.set,S.iota.1 e,image-idempotent] ;
 function (a : BaseFactor.Carrier) : AlgebraFactor.Carrier =
  (S.iota.1 a.1,trans (sym (S.iota.2.2.2 e a.1)) (ap S.iota.1 a.2)) ;
 iota : H.Hom BaseFactor.ring AlgebraFactor.ring =
  (function,AlgebraFactor.eq _ _ (refl (S.iota.1 e)),
   \ a b -> AlgebraFactor.eq _ _ (S.iota.2.2.1 a.1 b.1),
   \ a b -> AlgebraFactor.eq _ _ (S.iota.2.2.2 a.1 b.1)) ;
 algebra : Algebras[l].Over[BaseFactor.ring,BaseFactor.set].Algebra =
  Algebras[l].Over[BaseFactor.ring,BaseFactor.set].mkAlgebra AlgebraFactor.ring AlgebraFactor.set iota ;
 square (a : A.R) : Id AlgebraFactor.Carrier
  (function (BaseFactor.project a)) (AlgebraFactor.project (S.iota.1 a)) =
  AlgebraFactor.eq _ _ (S.iota.2.2.2 e a) ;
 module Injective (injective : (a b : A.R) -> Id S.ring.R (S.iota.1 a) (S.iota.1 b) -> Id A.R a b) {
  theorem (a b : BaseFactor.Carrier) (eq : Id AlgebraFactor.Carrier (function a) (function b)) :
   Id BaseFactor.Carrier a b = BaseFactor.eq a b (injective a.1 b.1 (ap (\ z -> z.1) eq)) ;
 } ;
} ;
