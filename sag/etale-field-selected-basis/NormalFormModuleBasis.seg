-- PRIVATE DERIVED VARIANT of GaussianModuleQuotient: the same coordinate
-- packaging proof with a normal form supplied explicitly over any ring.
-- The Gaussian algorithm and zero-or-unit field decisions are not used.
-- Projected representatives are unique, so truncated surjectivity can
-- be eliminated into their coordinate proposition.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module V = GaussianVectors[l].Over[A] ;
 module MD = Modules[l].Over[A,setA] ; module DL = DescentLinear[l].Over[A,setA] ;
 module SM = DescentSubmodules[l].Over[MD.ring] ; module MM = DescentModuleMaps[l].Over[A,setA] ;
 module S = FiniteIdeal[l].Sums[A] ; module L = RL[A] ;
 free-combination (n m : Nat) (v : Fin m -> V.Vec n) (c : V.Vec m) (i : Fin n) :
  Id A.R (DL.On[DL.Free n].lin m v c i) (V.comb n m v c i) =
  trans (MM.Free[n].Projection[i].H.lin m v c)
   (trans (DL.On[MD.regular].lin-value m (\ j -> v j i) c)
    (trans (DL.On[MD.regular].S.map (\ a -> a) (refl A.z) (\ a b -> refl (A.add a b)) m
     (\ j -> A.mul (c j) (v j i))) (FlatRelations[l].lin-comm A m c (\ j -> v j i)))) ;
 module At (n m : Nat) (v : Fin m -> V.Vec n) (M : MD.Module) (phi : SM.Linear (DL.Free n) M)
  (onto : (x : M.M) -> Tr.Trunc[(c : V.Vec n) * Id M.M (phi.1 c) x].carrier)
  (relations : (j : Fin m) -> Id M.M (phi.1 (v j)) M.mz)
  (kernel : (c : V.Vec n) -> Id M.M (phi.1 c) M.mz -> Tr.Trunc[V.Span[n,m,v].Witness c].carrier)
  (rank : Nat) (project : V.Linear[n,rank]) (section : V.Linear[rank,n])
  (retract : (x : V.Vec rank) (i : Fin rank) -> Id A.R (project.map (section.map x) i) (x i))
  (kills : (j : Fin m) (i : Fin rank) -> Id A.R (project.map (v j) i) A.z)
  (difference : (x : V.Vec n) -> V.Span[n,m,v].Witness (V.subV n x (section.map (project.map x)))) {
  module MA = Alg73[l].MA[MD.ring,M] ; module Phi = SM.Lin[DL.Free n,M,phi] ;
  module Span = V.Span[n,m,v] ;
  span-killed (x : V.Vec n) (w : Span.Witness x) : Id M.M (phi.1 x) M.mz =
   trans (ap phi.1 (V.ext n x (DL.On[DL.Free n].lin m v w.1)
    (\ i -> trans (sym (w.2 i)) (sym (free-combination n m v w.1 i)))))
    (MM.Killed[DL.Free n,M,phi,m,v,relations].theorem w.1) ;
  project-span (x : V.Vec n) (w : Span.Witness x) (i : Fin rank) : Id A.R (project.map x i) A.z =
   trans (ap (\ c -> project.map c i) (sym (V.ext n (V.comb n m v w.1) x w.2)))
    (trans (V.On[n,rank,project].combination m v w.1 i)
     (trans (S.sum-cong m (\ j -> A.mul (project.map (v j) i) (w.1 j)) (\ j -> A.z)
      (\ j -> trans (ap (\ a -> A.mul a (w.1 j)) (kills j i)) (L.zero-mul (w.1 j)))) (S.sum-zero m))) ;
  project-kernel (x : V.Vec n) (hx : Id M.M (phi.1 x) M.mz) (i : Fin rank) : Id A.R (project.map x i) A.z =
   TC.rec (Span.Witness x) @l (Id A.R (project.map x i) A.z) (setA _ _)
    (\ w -> project-span x w i) (kernel x hx) ;
  same-image (x y : V.Vec n) (eq : Id M.M (phi.1 x) (phi.1 y)) (i : Fin rank) :
   Id A.R (project.map x i) (project.map y i) =
   FormallyEtale[l].Units[A,setA].sub-zero (project.map x i) (project.map y i)
    (trans (sym (V.On[n,rank,project].subtract x y i))
     (project-kernel (V.subV n x y)
      (trans (Phi.map-sub x y) (trans (ap (\ a -> M.madd a (M.mneg (phi.1 y))) eq) (M.maddN (phi.1 y)))) i)) ;
  normal-image (x : V.Vec n) : Id M.M (phi.1 (section.map (project.map x))) (phi.1 x) =
   sym (MA.sub-zero (phi.1 x) (phi.1 (section.map (project.map x)))
    (trans (sym (Phi.map-sub x (section.map (project.map x))))
     (span-killed (V.subV n x (section.map (project.map x))) (difference x)))) ;
  realise (c : V.Vec rank) : M.M = phi.1 (section.map c) ;
  realise-add (x y : V.Vec rank) : Id M.M (realise (V.addV rank x y)) (M.madd (realise x) (realise y)) =
   trans (ap phi.1 (V.ext n (section.map (V.addV rank x y)) (V.addV n (section.map x) (section.map y)) (section.add x y)))
    (phi.2.1 (section.map x) (section.map y)) ;
  realise-scale (a : A.R) (x : V.Vec rank) : Id M.M (realise (V.scaleV rank a x)) (M.sm a (realise x)) =
   trans (ap phi.1 (V.ext n (section.map (V.scaleV rank a x)) (V.scaleV n a (section.map x)) (section.scale a x)))
    (phi.2.2 a (section.map x)) ;
  injective (x y : V.Vec rank) (eq : Id M.M (realise x) (realise y)) : Id (V.Vec rank) x y =
   V.ext rank x y (\ i -> trans (sym (retract x i)) (trans (same-image (section.map x) (section.map y) eq i) (retract y i))) ;
  Coordinates (x : M.M) : U l = (c : V.Vec rank) * Id M.M (realise c) x ;
  coordinates-prop (x : M.M) : Pr.isProp (Coordinates x) = \ a b ->
   Pr.Sigma-eq (V.Vec rank) (\ c -> Id M.M (realise c) x) a.1 b.1 a.2 b.2
    (injective a.1 b.1 (trans a.2 (sym b.2))) (M.setM _ _) ;
  from (x : M.M) (w : (c : V.Vec n) * Id M.M (phi.1 c) x) : Coordinates x =
   (project.map w.1,trans (normal-image w.1) w.2) ;
  coordinates (x : M.M) : Coordinates x =
   TC.rec ((c : V.Vec n) * Id M.M (phi.1 c) x) @l (Coordinates x) (coordinates-prop x) (from x) (onto x) ;
  coordinate (x : M.M) : V.Vec rank = (coordinates x).1 ;
  reconstruction (x : M.M) : Id M.M (realise (coordinate x)) x = (coordinates x).2 ;
  on-realise (c : V.Vec rank) : Id (V.Vec rank) (coordinate (realise c)) c =
   ap (\ w -> w.1) (coordinates-prop (realise c) (coordinates (realise c)) (c,refl (realise c))) ;
  add (x y : M.M) (i : Fin rank) :
   Id A.R (coordinate (M.madd x y) i) (A.add (coordinate x i) (coordinate y i)) =
   trans (ap (\ z -> coordinate z i)
    (sym (trans (realise-add (coordinate x) (coordinate y)) (cong2 M.M M.madd _ _ _ _ (reconstruction x) (reconstruction y)))))
    (ap (\ c -> c i) (on-realise (V.addV rank (coordinate x) (coordinate y)))) ;
  scale (a : A.R) (x : M.M) (i : Fin rank) : Id A.R (coordinate (M.sm a x) i) (A.mul a (coordinate x i)) =
   trans (ap (\ z -> coordinate z i) (sym (trans (realise-scale a (coordinate x)) (ap (M.sm a) (reconstruction x)))))
    (ap (\ c -> c i) (on-realise (V.scaleV rank a (coordinate x)))) ;
  linear : SM.Linear (DL.Free rank) M = (realise,realise-add,realise-scale) ;
  module BasisMap = MM.Free[rank].LinearMap[M,linear] ;
  vector (j : Fin rank) : M.M = BasisMap.columns j ;
  on-vector (j i : Fin rank) : Id A.R (coordinate (vector j) i) (MnSums[l].Over[A].delta rank i j) =
   ap (\ c -> c i) (on-realise (MM.Free[rank].unit j)) ;
  expands (x : M.M) : Id M.M (DL.On[M].lin rank vector (coordinate x)) x =
   trans (BasisMap.equation (coordinate x)) (reconstruction x) ;
  coordinate-combination (c : V.Vec rank) : Id (V.Vec rank) (coordinate (DL.On[M].lin rank vector c)) c =
   trans (ap coordinate (BasisMap.equation c)) (on-realise c) ;
  basis : DL.On[M].Basis rank vector =
   Pr.qinv (V.Vec rank) M.M (DL.On[M].lin rank vector) coordinate expands coordinate-combination ;
  frame : DL.On[M].Frame rank = (vector,basis) ;
 } ;
} ;
