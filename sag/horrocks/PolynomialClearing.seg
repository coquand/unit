-- Clearing denominators of polynomials over a monoid localization A_S.
-- A polynomial over A_S times some s in S comes from A[X], and a
-- polynomial over A vanishing in A_S[X] is killed by some s in S.
-- Finite families get one common denominator.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) (S : A.R -> U l) (one : S A.o)
 (product : (s t : A.R) -> S s -> S t -> S (A.mul s t)) {
 module Tr = Truncation[l] ;
 module TC = TruncationCombinators[l] ;
 module F = Axioms[l].FunExtLemmas[fe @l] ;
 module L = MonoidLocalization[l].Over[A,S,one,product] ;
 module Change = PolynomialMap[l].Over[A,L.ring,setA,L.set,L.inclusion] ;
 module B = Change.B ;
 module D = Change.D ;
 module PA = Poly[l].PolyR[A] ;
 module MA = Mul[l].MulR[A] ;
 module RM = RawMultiplication[l].Laws[A] ;
 module AR = RL[A] ;
 module BR = RL[B.ring] ;
 module DR = RL[D.ring] ;
 hom : B.Carrier -> D.Carrier = Change.hom.1 ;
 scalar (a : A.R) : D.Carrier = D.constant (L.constant a) ;
 scalar-mul (a b : A.R) : Id D.Carrier (scalar (A.mul a b)) (D.mulQ (scalar a) (scalar b)) =
  trans (ap D.constant (L.constant-mul a b)) (D.constant-mul (L.constant a) (L.constant b)) ;
 on-constant (a : A.R) : Id D.Carrier (hom (B.constant a)) (scalar a) =
  Change.Extension.on-constants a ;
 on-scaled (a : A.R) (p : B.Carrier) :
  Id D.Carrier (hom (B.mulQ (B.constant a) p)) (D.mulQ (scalar a) (hom p)) =
  trans (Change.hom.2.2.2 (B.constant a) p) (ap (\ c -> D.mulQ c (hom p)) (on-constant a)) ;
 -- a (b x) = (b a) x in any commutative ring.
 regroup (Rg : CRing) (a b x : Rg.R) : Id Rg.R (Rg.mul a (Rg.mul b x)) (Rg.mul (Rg.mul b a) x) =
  trans (RL[Rg].mul-swap a b x) (Rg.mulA b a x) ;

 -- Kernel.
 Annihilated (p : List A.R) : U l =
  (s : A.R) * S s * ((k : Nat) -> Id A.R (A.mul s (PA.coef p k)) A.z) ;
 module Annihilate (a : A.R) (p : List A.R) (first : L.Kernel a) (rest : Annihilated p) {
  s : A.R = A.mul first.1 rest.1 ;
  member : S s = product first.1 rest.1 first.2.1 rest.2.1 ;
  coefficients : (k : Nat) -> Id A.R (A.mul s (PA.coef (cons a p) k)) A.z = split {
   zero -> trans (ap (\ t -> A.mul t a) (A.mulC first.1 rest.1))
    (trans (sym (A.mulA rest.1 first.1 a))
     (trans (ap (A.mul rest.1) first.2.2) (AR.mul-zero rest.1))) ;
   suc k -> trans (sym (A.mulA first.1 rest.1 (PA.coef p k)))
    (trans (ap (A.mul first.1) (rest.2.2 k)) (AR.mul-zero first.1)) } ;
  result : Annihilated (cons a p) = (s,member,coefficients) ;
 } ;
 annihilate : (p : List A.R) ->
  ((k : Nat) -> Id L.Carrier (L.constant (PA.coef p k)) L.zeroQ) ->
  Tr.Trunc[Annihilated p].carrier = split {
  nil -> \ h -> Tr.Trunc[Annihilated nil].inc (A.o,one,\ k -> AR.mul-zero A.o) ;
  cons a p | ih -> \ h ->
   TC.map2 (L.Kernel a) (Annihilated p) (Annihilated (cons a p))
    (\ first rest -> Annihilate[a,p,first,rest].result)
    (L.kernel a (h zero)) (ih (\ k -> h (suc k))) } ;
 scale-include (s : A.R) (p : List A.R) :
  Id B.Carrier (B.mulQ (B.constant s) (B.include p)) (B.include (MA.scal s p)) =
  trans (B.Multiply.beta (cons s nil) p) (B.Q.relates _ _ (RM.mul-single-left s p)) ;
 Kernel (p : B.Carrier) : U l =
  (s : A.R) * S s * Id B.Carrier (B.mulQ (B.constant s) p) B.zeroQ ;
 raw-kernel (p : List A.R) (w : Annihilated p) : Kernel (B.include p) =
  (w.1,w.2.1,trans (scale-include w.1 p)
   (B.Q.relates (MA.scal w.1 p) nil (\ k -> trans (MA.coef-scal w.1 p k) (w.2.2 k)))) ;
 kernel (p : B.Carrier) : Id D.Carrier (hom p) D.zeroQ -> Tr.Trunc[Kernel p].carrier =
  B.Q.induction @l (\ p -> Id D.Carrier (hom p) D.zeroQ -> Tr.Trunc[Kernel p].carrier)
   (\ p -> F.isProp-Pi (Id D.Carrier (hom p) D.zeroQ) (\ h -> Tr.Trunc[Kernel p].carrier)
     (\ h -> Tr.Trunc[Kernel p].proposition))
   (\ p h -> Tr.Trunc[Annihilated p].induction @l
     (\ x -> Tr.Trunc[Kernel (B.include p)].carrier)
     (\ x -> Tr.Trunc[Kernel (B.include p)].proposition)
     (\ w -> Tr.Trunc[Kernel (B.include p)].inc (raw-kernel p w))
     (annihilate p (Change.raw-kernel p h)))
   p ;
 KernelAll (n : Nat) (q : Fin n -> B.Carrier) : U l =
  (s : A.R) * S s * ((i : Fin n) -> Id B.Carrier (B.mulQ (B.constant s) (q i)) B.zeroQ) ;
 kill-more (t s : A.R) (p : B.Carrier) (h : Id B.Carrier (B.mulQ (B.constant s) p) B.zeroQ) :
  Id B.Carrier (B.mulQ (B.constant (A.mul t s)) p) B.zeroQ =
  trans (ap (\ c -> B.mulQ c p) (B.constant-mul t s))
   (trans (sym (B.mul-assoc (B.constant t) (B.constant s) p))
    (trans (ap (B.mulQ (B.constant t)) h) (BR.mul-zero (B.constant t)))) ;
 common-kernel : (n : Nat) (q : Fin n -> B.Carrier) -> ((i : Fin n) -> Kernel (q i)) -> KernelAll n q = split {
  zero -> \ q w -> (A.o,one,AffineFinite[l].empty-section (\ i -> Id B.Carrier (B.mulQ (B.constant A.o) (q i)) B.zeroQ)) ;
  suc n | ih -> \ q w ->
   let { old : KernelAll n (\ i -> q (inl i)) = ih (\ i -> q (inl i)) (\ i -> w (inl i)) ;
         last : Kernel (q (inr tt)) = w (inr tt) ; } in
   (A.mul last.1 old.1,product last.1 old.1 last.2.1 old.2.1,
    AffineFinite[l].section n (\ i -> Id B.Carrier (B.mulQ (B.constant (A.mul last.1 old.1)) (q i)) B.zeroQ)
     (\ i -> kill-more last.1 old.1 (q (inl i)) (old.2.2 i))
     (trans (ap (\ c -> B.mulQ (B.constant c) (q (inr tt))) (A.mulC last.1 old.1))
      (kill-more old.1 last.1 (q (inr tt)) last.2.2))) } ;
 kernel-all (n : Nat) (q : Fin n -> B.Carrier) (h : (i : Fin n) -> Id D.Carrier (hom (q i)) D.zeroQ) :
  Tr.Trunc[KernelAll n q].carrier =
  Tr.Trunc[(i : Fin n) -> Kernel (q i)].induction @l
   (\ x -> Tr.Trunc[KernelAll n q].carrier) (\ x -> Tr.Trunc[KernelAll n q].proposition)
   (\ w -> Tr.Trunc[KernelAll n q].inc (common-kernel n q w))
   (AffineFinite[l].choice n (\ i -> Kernel (q i)) (\ i -> kernel (q i) (h i))) ;

 -- Clearing.
 Clear (P : D.Carrier) : U l =
  (d : A.R) * S d * (p : B.Carrier) * Id D.Carrier (hom p) (D.mulQ (scalar d) P) ;
 -- s1 s2 (c + X M) = s2 a + X (s1 (s2 M)) when s1 c = a.
 shape (Rg : CRing) (s1 s2 c x m a : Rg.R) (hc : Id Rg.R (Rg.mul s1 c) a) :
  Id Rg.R (Rg.mul (Rg.mul s1 s2) (Rg.add c (Rg.mul x m)))
   (Rg.add (Rg.mul s2 a) (Rg.mul x (Rg.mul s1 (Rg.mul s2 m)))) =
  trans (Rg.dist (Rg.mul s1 s2) c (Rg.mul x m))
   (cong2 Rg.R Rg.add _ _ _ _
    (trans (ap (\ t -> Rg.mul t c) (Rg.mulC s1 s2))
     (trans (sym (Rg.mulA s2 s1 c)) (ap (Rg.mul s2) hc)))
    (trans (RL[Rg].mul-swap (Rg.mul s1 s2) x m)
     (ap (Rg.mul x) (sym (Rg.mulA s1 s2 m))))) ;
 module Step (c : L.Carrier) (rest : List L.Carrier) (q : L.Raw.Fraction)
  (rep : Id L.Carrier (L.include q) c) (old : Clear (D.include rest)) {
  a : A.R = q.1 ;
  s : A.R = q.2.1 ;
  d : A.R = A.mul s old.1 ;
  member : S d = product s old.1 q.2.2 old.2.1 ;
  p : B.Carrier = B.addQ (B.constant (A.mul old.1 a)) (B.mulQ B.variable (B.mulQ (B.constant s) old.2.2.1)) ;
  numerator : Id D.Carrier (D.mulQ (scalar s) (D.constant c)) (scalar a) =
   trans (sym (D.constant-mul (L.constant s) c))
    (ap D.constant (trans (ap (L.mulQ (L.constant s)) (sym rep)) (L.fraction-equation q))) ;
  image : Id D.Carrier (hom p)
   (D.addQ (D.mulQ (scalar old.1) (scalar a))
    (D.mulQ D.variable (D.mulQ (scalar s) (D.mulQ (scalar old.1) (D.include rest))))) =
   trans (Change.hom.2.2.1 (B.constant (A.mul old.1 a)) (B.mulQ B.variable (B.mulQ (B.constant s) old.2.2.1)))
    (cong2 D.Carrier D.addQ _ _ _ _
     (trans (on-constant (A.mul old.1 a)) (scalar-mul old.1 a))
     (trans (Change.hom.2.2.2 B.variable (B.mulQ (B.constant s) old.2.2.1))
      (cong2 D.Carrier D.mulQ _ _ _ _ Change.Extension.on-variable
       (trans (on-scaled s old.2.2.1) (ap (D.mulQ (scalar s)) old.2.2.2))))) ;
  equation : Id D.Carrier (hom p) (D.mulQ (scalar d) (D.include (cons c rest))) =
   trans image
    (sym (trans (ap (\ t -> D.mulQ t (D.include (cons c rest))) (scalar-mul s old.1))
     (trans (ap (D.mulQ (D.mulQ (scalar s) (scalar old.1))) (D.horner c rest))
      (shape D.ring (scalar s) (scalar old.1) (D.constant c) D.variable (D.include rest) (scalar a) numerator)))) ;
  result : Clear (D.include (cons c rest)) = (d,member,p,equation) ;
 } ;
 clear-list : (P : List L.Carrier) -> Tr.Trunc[Clear (D.include P)].carrier = split {
  nil -> Tr.Trunc[Clear (D.include nil)].inc
   (A.o,one,B.zeroQ,trans (RingHom[l].zero B.ring D.ring Change.hom)
    (sym (DR.mul-zero (scalar A.o)))) ;
  cons c rest | ih ->
   TC.map2 (L.Representatives c) (Clear (D.include rest)) (Clear (D.include (cons c rest)))
    (\ r old -> Step[c,rest,r.1,r.2,old].result) (L.representatives c) ih } ;
 clear (P : D.Carrier) : Tr.Trunc[Clear P].carrier =
  D.Q.induction @l (\ P -> Tr.Trunc[Clear P].carrier) (\ P -> Tr.Trunc[Clear P].proposition)
   clear-list P ;
 ClearAll (n : Nat) (P : Fin n -> D.Carrier) : U l =
  (d : A.R) * S d * (p : Fin n -> B.Carrier) *
  ((i : Fin n) -> Id D.Carrier (hom (p i)) (D.mulQ (scalar d) (P i))) ;
 module Combine (n : Nat) (P : Fin (suc n) -> D.Carrier)
  (old : ClearAll n (\ i -> P (inl i))) (last : Clear (P (inr tt))) {
  d : A.R = A.mul old.1 last.1 ;
  member : S d = product old.1 last.1 old.2.1 last.2.1 ;
  p : Fin (suc n) -> B.Carrier =
   AffineFinite[l].section n (\ i -> B.Carrier)
    (\ i -> B.mulQ (B.constant last.1) (old.2.2.1 i)) (B.mulQ (B.constant old.1) last.2.2.1) ;
  equations : (i : Fin (suc n)) -> Id D.Carrier (hom (p i)) (D.mulQ (scalar d) (P i)) =
   AffineFinite[l].section n (\ i -> Id D.Carrier (hom (p i)) (D.mulQ (scalar d) (P i)))
    (\ i -> trans (on-scaled last.1 (old.2.2.1 i))
     (trans (ap (D.mulQ (scalar last.1)) (old.2.2.2 i))
      (trans (regroup D.ring (scalar last.1) (scalar old.1) (P (inl i)))
       (ap (\ t -> D.mulQ t (P (inl i))) (sym (scalar-mul old.1 last.1))))))
    (trans (on-scaled old.1 last.2.2.1)
     (trans (ap (D.mulQ (scalar old.1)) last.2.2.2)
      (trans (D.mul-assoc (scalar old.1) (scalar last.1) (P (inr tt)))
       (ap (\ t -> D.mulQ t (P (inr tt))) (sym (scalar-mul old.1 last.1)))))) ;
  result : ClearAll (suc n) P = (d,member,p,equations) ;
 } ;
 common-clear : (n : Nat) (P : Fin n -> D.Carrier) -> ((i : Fin n) -> Clear (P i)) -> ClearAll n P = split {
  zero -> \ P w -> (A.o,one,AffineFinite[l].empty-section (\ i -> B.Carrier),
   AffineFinite[l].empty-section (\ i -> Id D.Carrier (hom (AffineFinite[l].empty-section (\ j -> B.Carrier) i))
    (D.mulQ (scalar A.o) (P i)))) ;
  suc n | ih -> \ P w ->
   Combine[n,P,ih (\ i -> P (inl i)) (\ i -> w (inl i)),w (inr tt)].result } ;
 clear-all (n : Nat) (P : Fin n -> D.Carrier) : Tr.Trunc[ClearAll n P].carrier =
  Tr.Trunc[(i : Fin n) -> Clear (P i)].induction @l
   (\ x -> Tr.Trunc[ClearAll n P].carrier) (\ x -> Tr.Trunc[ClearAll n P].proposition)
   (\ w -> Tr.Trunc[ClearAll n P].inc (common-clear n P w))
   (AffineFinite[l].choice n (\ i -> Clear (P i)) (\ i -> clear (P i))) ;
} ;
