-- Actual localization maps for the formal radical/unit branches.
-- Every parent fraction becomes radical on one branch and invertible
-- on the other, by branching on its numerator in the original ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (m : Nat) (fs : Fin m -> A.R) (n : Nat) (us : Fin n -> A.R) {
 module N = FiniteMonoids[l].Over[A,setA].Node[m,fs,n,us] ;
 module Parent = JacobsonLocalization[l].Node[A,setA,m,fs,n,us] ;
 module B = Parent.Loc.B ;
 module At (a : A.R) {
  module Branch = N.At[a] ;
  module Radical = JacobsonLocalization[l].Node[A,setA,suc m,Branch.fs-plus,n,us] ;
  module Invert = JacobsonLocalization[l].Node[A,setA,m,fs,suc n,Branch.us-plus] ;
  module L = Radical.Loc.B ;
  module R = Invert.Loc.B ;
  ideal-inclusion (i : A.R) : N.I.1 i -> Branch.IL.1 i =
   Branch.JL.includes m fs (\ j -> Branch.JL.generator (inl j)) i ;
  radical-inclusion (s : A.R) (w : N.S.Witness s) : Branch.SL.Witness s =
   (w.1,w.2.1,w.2.2.1,ideal-inclusion w.2.2.1 w.2.2.2.1,w.2.2.2.2) ;
  lift-word : N.M.Word -> Branch.MU.Word = split {
   nil -> nil ; cons i w | ih -> cons (inl i) ih } ;
  lift-value : (w : N.M.Word) -> Id A.R (Branch.MU.value (lift-word w)) (N.M.value w) = split {
   nil -> refl A.o ; cons i w | ih -> ap (A.mul (us i)) ih } ;
  monoid-inclusion (u : A.R) (w : N.M.Member u) : Branch.MU.Member u =
   (lift-word w.1,trans w.2 (sym (lift-value w.1))) ;
  invert-inclusion (s : A.R) (w : N.S.Witness s) : Branch.SU.Witness s =
   (w.1,monoid-inclusion w.1 w.2.1,w.2.2.1,w.2.2.2.1,w.2.2.2.2) ;
  module Left = MonoidLocalizationMap[l].Over[A,N.S.Witness,N.S.unit,N.S.multiply,
   L.ring,L.set,L.inclusion,\ s w -> L.inverse s (radical-inclusion s w)] ;
  module Right = MonoidLocalizationMap[l].Over[A,N.S.Witness,N.S.unit,N.S.multiply,
   R.ring,R.set,R.inclusion,\ s w -> R.inverse s (invert-inclusion s w)] ;
  numerator-invertible : RL[R.ring].unit (R.constant a) =
   R.inverse a (a,Branch.MU.generator (inr tt),A.z,N.I.2.2.1,sym (A.addZ a)) ;
  module Fraction (s : A.R) (member : N.S.Witness s) {
   q : B.Raw.Fraction = (a,s,member) ;
   left-fraction : L.Raw.Fraction = (a,s,radical-inclusion s member) ;
   right-fraction : R.Raw.Fraction = (a,s,invert-inclusion s member) ;
   left-equation : Id L.Carrier (Left.hom.1 (B.include q)) (L.include left-fraction) =
    trans (Left.D.beta q)
     (Left.unique q (L.include left-fraction) (L.fraction-equation left-fraction)) ;
   right-equation : Id R.Carrier (Right.hom.1 (B.include q)) (R.include right-fraction) =
    trans (Right.D.beta q)
     (Right.unique q (R.include right-fraction) (R.fraction-equation right-fraction)) ;
   right-unit : RL[R.ring].unit (Right.hom.1 (B.include q)) =
    subst RL[R.ring].unit (sym right-equation)
     (AffineRing[l].Laws[R.ring,R.set].unit-right (R.constant s) (R.include right-fraction)
      (subst RL[R.ring].unit (sym (R.fraction-equation right-fraction)) numerator-invertible)) ;
   module G = Radical.Finite.G ;
   inv : RL[L.ring].unit (L.constant s) = L.inverse s (radical-inclusion s member) ;
   fraction-times-denominator :
    Id L.Carrier (L.mulQ inv.1 (L.constant a)) (L.include left-fraction) =
    trans (ap (L.mulQ inv.1) (sym (L.fraction-equation left-fraction)))
     (trans (L.mul-assoc inv.1 (L.constant s) (L.include left-fraction))
      (trans (ap (\ t -> L.mulQ t (L.include left-fraction))
        (trans (L.mul-comm inv.1 (L.constant s)) inv.2))
       (AffinePowers[l].Over[L.ring].one-left (L.include left-fraction)))) ;
   left-radical : G.Member (Left.hom.1 (B.include q)) =
    G.equal _ _ (trans fraction-times-denominator (sym left-equation))
     (G.scale inv.1 (L.constant a) (G.generator (inr tt))) ;
  } ;
 } ;
} ;
