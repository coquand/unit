-- Extension of an ideal to a monoid localization: fractions with a
-- numerator in the original ideal form an ideal.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (S : A.R -> U l) (one : S A.o)
 (product : (s t : A.R) -> S s -> S t -> S (A.mul s t))
 (I : Ideals[l].Over[A,setA].Ideal) {
 module Tr = Truncation[l] ;
 module B = MonoidLocalization[l].Over[A,S,one,product] ;
 module IB = Ideals[l].Over[B.ring,B.set] ;
 module In = Ideals[l].Over[A,setA].In[I] ;
 Witness (b : B.Carrier) : U l =
  (q : B.Raw.Fraction) * I.1 q.1 * Id B.Carrier (B.include q) b ;
 Member (b : B.Carrier) : U l = Tr.Trunc[Witness b].carrier ;
 proposition (b : B.Carrier) : Prelude[l].isProp (Member b) = Tr.Trunc[Witness b].proposition ;
 zero-member : Member B.zeroQ =
  Tr.Trunc[Witness B.zeroQ].inc (B.Raw.constantF A.z,I.2.2.1,refl B.zeroQ) ;
 constant (a : A.R) (h : I.1 a) : Member (B.constant a) =
  Tr.Trunc[Witness (B.constant a)].inc (B.Raw.constantF a,h,refl (B.constant a)) ;
 add-witness (a b : B.Carrier) (x : Witness a) (y : Witness b) : Witness (B.addQ a b) =
  (B.Raw.addF x.1 y.1,
   I.2.2.2.1 (A.mul x.1.1 y.1.2.1) (A.mul y.1.1 x.1.2.1)
    (In.equal _ _ (A.mulC y.1.2.1 x.1.1) (I.2.2.2.2 y.1.2.1 x.1.1 x.2.1))
    (In.equal _ _ (A.mulC x.1.2.1 y.1.1) (I.2.2.2.2 x.1.2.1 y.1.1 y.2.1)),
   trans (sym (B.Add.beta x.1 y.1)) (cong2 B.Carrier B.addQ _ _ _ _ x.2.2 y.2.2)) ;
 addition (a b : B.Carrier) (x : Member a) (y : Member b) : Member (B.addQ a b) =
  Tr.Trunc[Witness a].induction @l
   (\ w -> Member (B.addQ a b)) (\ w -> proposition (B.addQ a b))
   (\ w -> Tr.Trunc[Witness b].induction @l
    (\ v -> Member (B.addQ a b)) (\ v -> proposition (B.addQ a b))
    (\ v -> Tr.Trunc[Witness (B.addQ a b)].inc (add-witness a b w v)) y) x ;
 scale-witness (a b : B.Carrier) (x : B.Representatives a) (y : Witness b) : Witness (B.mulQ a b) =
  (B.Raw.mulF x.1 y.1,I.2.2.2.2 x.1.1 y.1.1 y.2.1,
   trans (sym (B.Multiply.beta x.1 y.1)) (cong2 B.Carrier B.mulQ _ _ _ _ x.2 y.2.2)) ;
 scale (a b : B.Carrier) (y : Member b) : Member (B.mulQ a b) =
  Tr.Trunc[B.Representatives a].induction @l
   (\ w -> Member (B.mulQ a b)) (\ w -> proposition (B.mulQ a b))
   (\ w -> Tr.Trunc[Witness b].induction @l
    (\ v -> Member (B.mulQ a b)) (\ v -> proposition (B.mulQ a b))
    (\ v -> Tr.Trunc[Witness (B.mulQ a b)].inc (scale-witness a b w v)) y)
   (B.representatives a) ;
 ideal : IB.Ideal = (Member,proposition,zero-member,addition,scale) ;
} ;
