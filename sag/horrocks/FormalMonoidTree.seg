-- Finite radical/unit trees are comaximal.
-- This constructs the comaximality proof; no decisions of units,
-- maximal ideals, or excluded middle occur here.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 open A ; open RL[A] ;
 module Tr = Truncation[l] ;
 module IA = Ideals[l].Over[A,setA] ;
 module FM = FiniteMonoids[l].Over[A,setA] ;
 State : U l = (m : Nat) * (fs : Fin m -> R) * (n : Nat) * (Fin n -> R) ;
 module At (state : State) {
  module N = FM.Node[state.1,state.2.1,state.2.2.1,state.2.2.2] ;
 } ;
 Denominator (state : State) (s : R) : U l = At[state].N.S.Witness s ;
 radical (state : State) (a : R) : State =
  (suc state.1,snoc (Fin state.1) R state.2.1 a,state.2.2.1,state.2.2.2) ;
 invert (state : State) (a : R) : State =
  (state.1,state.2.1,suc state.2.2.1,snoc (Fin state.2.2.1) R state.2.2.2 a) ;
 data Tree : U l = leaf | branch (a : R) (left right : Tree) ;
 Intersection (state : State) (I : IA.Ideal) : U l =
  (s : R) * Denominator state s * I.1 s ;
 Meets (state : State) (I : IA.Ideal) : U l = Tr.Trunc[Intersection state I].carrier ;
 Evidence : Tree -> State -> IA.Ideal -> U l = split {
  leaf -> \ state I -> Meets state I ;
  branch a left right | il ir -> \ state I -> il (radical state a) I * ir (invert state a) I } ;
 module Join (state : State) (a : R) (I : IA.Ideal)
  (left : Intersection (radical state a) I) (right : Intersection (invert state a) I) {
  module Pair = At[state].N.At[a].For[left.1,right.1] ;
  module In = IA.In[I] ;
  in-ideal : (i : Fin (suc (suc zero))) -> I.1 (Pair.gs i) =
   AffineFinite[l].section (suc zero) (\ i -> I.1 (Pair.gs i))
    (\ i -> left.2.2) right.2.2 ;
  from-certificate (w : Pair.Result) : Intersection state I =
   (w.1,w.2.1,In.certificate (suc (suc zero)) Pair.gs in-ideal w.1 w.2.2) ;
  result : Meets state I =
   Tr.Trunc[Pair.Result].induction @l
    (\ w -> Meets state I) (\ w -> Tr.Trunc[Intersection state I].proposition)
    (\ w -> Tr.Trunc[Intersection state I].inc (from-certificate w))
    (Pair.comaximal left.2.1 right.2.1) ;
 } ;
 join (state : State) (a : R) (I : IA.Ideal)
  (left : Meets (radical state a) I) (right : Meets (invert state a) I) : Meets state I =
  Tr.Trunc[Intersection (radical state a) I].induction @l
   (\ x -> Meets state I) (\ x -> Tr.Trunc[Intersection state I].proposition)
   (\ x -> Tr.Trunc[Intersection (invert state a) I].induction @l
    (\ y -> Meets state I) (\ y -> Tr.Trunc[Intersection state I].proposition)
    (\ y -> Join[state,a,I,x,y].result) right) left ;
 descend : (tree : Tree) (state : State) (I : IA.Ideal) -> Evidence tree state I -> Meets state I = split {
  leaf -> \ state I w -> w ;
  branch a left right | il ir -> \ state I w ->
   join state a I (il (radical state a) I w.1) (ir (invert state a) I w.2) } ;
 empty : Fin zero -> R = AffineFinite[l].empty-section (\ i -> R) ;
 root : State = (zero,empty,zero,empty) ;
 module Root = At[root].N ;
 empty-word : (w : Root.M.Word) -> Id R (Root.M.value w) o = split {
  nil -> refl o ; cons i w -> efq i } ;
 zero-member (i : R) : Root.I.1 i -> Id R i z =
  Tr.Trunc[Root.J.Witness i].induction @l
   (\ w -> Id R i z) (\ w -> setA i z)
   (\ w -> trans w.2 (addZ z)) ;
 root-one (s : R) (w : Denominator root s) : Id R s o =
  trans w.2.2.2.2
   (trans (cong2 R add _ _ _ _ (trans w.2.1.2 (empty-word w.2.1.1)) (zero-member w.2.2.1 w.2.2.2.1))
    (addZ o)) ;
 comaximal (tree : Tree) (I : IA.Ideal) (leaves : Evidence tree root I) : I.1 o =
  Tr.Trunc[Intersection root I].induction @l
   (\ w -> I.1 o) (\ w -> I.2.1 o)
   (\ w -> IA.In[I].equal w.1 o (root-one w.1 w.2.1) w.2.2)
   (descend tree root I leaves) ;
} ;
