-- Flatten the finite tree and extract an actual partition of unity
-- for any choice of one denominator at each leaf.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module T = FormalMonoidTree[l].Over[A,setA] ; open T ;
 module IA = Ideals[l].Over[A,setA] ;
 module FS = FinSum[l] ;
 module Tr = Truncation[l] ;
 module Sums = FiniteIdeal[l].Sums[A] ;
 Choices : T.Tree -> T.State -> U l = split {
  leaf -> \ state -> (s : A.R) * T.Denominator state s ;
  branch a left right | il ir -> \ state -> il (T.radical state a) * ir (T.invert state a) } ;
 count : T.Tree -> Nat = split {
  leaf -> suc zero ;
  branch a left right | il ir -> plus ir il } ;
 values : (tree : T.Tree) (state : T.State) -> Choices tree state -> Fin (count tree) -> A.R = split {
  leaf -> \ state c i -> c.1 ;
  branch a left right | il ir -> \ state c ->
   FS.cases (count left) A.R (il (T.radical state a) c.1)
    (count right) (ir (T.invert state a) c.2) } ;
 evidence : (tree : T.Tree) (state : T.State) (c : Choices tree state) (I : IA.Ideal) ->
  ((i : Fin (count tree)) -> I.1 (values tree state c i)) -> T.Evidence tree state I = split {
  leaf -> \ state c I h ->
   Tr.Trunc[T.Intersection state I].inc (c.1,c.2,h (inr tt)) ;
  branch a left right | il ir -> \ state c I h ->
   (il (T.radical state a) c.1 I
     (\ i -> IA.In[I].equal _ _
      (FS.cases-left (count left) A.R (values left (T.radical state a) c.1)
       (count right) (values right (T.invert state a) c.2) i)
      (h (FS.left (count left) (count right) i))),
    ir (T.invert state a) c.2 I
     (\ i -> IA.In[I].equal _ _
      (FS.cases-right (count left) A.R (values left (T.radical state a) c.1)
       (count right) (values right (T.invert state a) c.2) i)
      (h (FS.right (count left) (count right) i)))) } ;
 module At (tree : T.Tree) (c : Choices tree T.root) {
  n : Nat = count tree ;
  fs : Fin n -> A.R = values tree T.root c ;
  module G = GeneratedIdeal[l].Over[A,n,fs] ;
  I : IA.Ideal = IA.Gen[n,fs].ideal ;
  comaximal : G.Member A.o =
   T.comaximal tree I (evidence tree T.root c I G.generator) ;
  Coordinates : U l = Sums.Coordinates n fs A.o ;
  convert (w : G.Witness A.o) : Coordinates =
   (w.1,sym (trans w.2 (RL[A].zl (Sums.lin n fs w.1)))) ;
  partition : Tr.Trunc[Coordinates].carrier =
   Tr.Trunc[G.Witness A.o].induction @l
    (\ w -> Tr.Trunc[Coordinates].carrier) (\ w -> Tr.Trunc[Coordinates].proposition)
    (\ w -> Tr.Trunc[Coordinates].inc (convert w)) comaximal ;
 } ;
} ;
