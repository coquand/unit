-- Nakayama without a radical hypothesis: if v = a v with every a_ij in J,
-- some u with u - 1 in J kills every v_i. One generator is eliminated at a
-- time; no determinant and no decision on units. Over a local ring this
-- gives the alternative: every v_i vanishes, or 1 is in J.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 open A ; open RL[A] ;
 module I = Ideals[l].Over[A,setA] ;
 module Linear = FiniteLinear[l].Over[A] ;
 module At (J : I.Ideal) (D : Linear.Module) {
  open D ;
  module Sum = Linear.In[D] ;
  OneMod (u : R) : U l = J.1 (add u (neg o)) ;
  Killer (n : Nat) (v : Fin n -> V) : U l =
   (u : R) * OneMod u * ((i : Fin n) -> Id V (scale u (v i)) zeroV) ;
  Statement (n : Nat) : U l =
   (t : R) -> OneMod t -> (v : Fin n -> V) (a : Fin n -> Fin n -> R) ->
   ((i j : Fin n) -> J.1 (a i j)) ->
   ((i : Fin n) -> Id V (scale t (v i)) (Sum.lin n (a i) v)) -> Killer n v ;
  -- (s t) - 1 = s (t - 1) + (s - 1).
  one-mod-mul (s t : R) (hs : OneMod s) (ht : OneMod t) : OneMod (mul s t) =
   I.In[J].equal _ _
    (calc R {
     add (mul s (add t (neg o))) (add s (neg o))
      =< ap (\ x -> add x (add s (neg o))) (trans (dist s t (neg o)) (ap (add (mul s t)) (mul-neg s o)))
       > add (add (mul s t) (neg (mul s o))) (add s (neg o))
      =< ap (\ x -> add (add (mul s t) (neg x)) (add s (neg o))) (mulO s)
       > add (add (mul s t) (neg s)) (add s (neg o))
      =< sym (addA (mul s t) (neg s) (add s (neg o)))
       > add (mul s t) (add (neg s) (add s (neg o)))
      =< ap (add (mul s t)) (addA (neg s) s (neg o))
       > add (mul s t) (add (add (neg s) s) (neg o))
      =< ap (\ x -> add (mul s t) (add x (neg o))) (neg-cancel s)
       > add (mul s t) (add z (neg o))
      =< ap (add (mul s t)) (zl (neg o)) > add (mul s t) (neg o) })
    (J.2.2.2.1 _ _ (J.2.2.2.2 s (add t (neg o)) ht) hs) ;
  -- (t - a) - 1 = (t - 1) - a.
  one-mod-sub (t a : R) (ht : OneMod t) (ha : J.1 a) : OneMod (add t (neg a)) =
   I.In[J].equal _ _
    (calc R {
     add (add t (neg o)) (mul (neg o) a)
      =< ap (add (add t (neg o))) (trans (neg-mul-left o a) (ap neg (one-left a)))
       > add (add t (neg o)) (neg a)
      =< sym (addA t (neg o) (neg a)) > add t (add (neg o) (neg a))
      =< ap (add t) (addC (neg o) (neg a)) > add t (add (neg a) (neg o))
      =< addA t (neg a) (neg o) > add (add t (neg a)) (neg o) })
    (J.2.2.2.1 _ _ ht (J.2.2.2.2 (neg o) a ha)) ;
  module Step (n : Nat) (ih : Statement n) (t : R) (ht : OneMod t)
   (v : Fin (suc n) -> V) (a : Fin (suc n) -> Fin (suc n) -> R)
   (inJ : (i j : Fin (suc n)) -> J.1 (a i j))
   (equations : (i : Fin (suc n)) -> Id V (scale t (v i)) (Sum.lin (suc n) (a i) v)) {
   last : Fin (suc n) = inr tt ;
   s : R = add t (neg (a last last)) ;
   hs : OneMod s = one-mod-sub t (a last last) ht (inJ last last) ;
   old (i : Fin n) : V = v (inl i) ;
   row (j : Fin n) : R = a last (inl j) ;
   -- s v_last = sum_j a_last,j v_j.
   rest (i : Fin (suc n)) : V = Sum.lin n (\ j -> a i (inl j)) old ;
   last-equation : Id V (scale s (v last)) (rest last) =
    let { cancel : Id V (plusV (scale (neg (a last last)) (v last)) (scale (a last last) (v last))) zeroV =
     trans (sym (scalar-add (neg (a last last)) (a last last) (v last)))
      (trans (ap (\ b -> scale b (v last)) (neg-cancel (a last last))) (scalar-zero (v last))) ;
    } in trans (scalar-add t (neg (a last last)) (v last))
     (trans (ap (\ w -> plusV w (scale (neg (a last last)) (v last))) (equations last))
      (trans (ap (\ w -> plusV w (scale (neg (a last last)) (v last)))
        (comm (scale (a last last) (v last)) (rest last)))
       (trans (sym (assoc (rest last) (scale (a last last) (v last)) (scale (neg (a last last)) (v last))))
        (trans (ap (plusV (rest last)) (trans (comm (scale (a last last) (v last)) (scale (neg (a last last)) (v last))) cancel))
         (zero-right (rest last)))))) ;
   reduced (i j : Fin n) : R = add (mul s (a (inl i) (inl j))) (mul (a (inl i) last) (row j)) ;
   reduced-inJ (i j : Fin n) : J.1 (reduced i j) =
    J.2.2.2.1 _ _ (J.2.2.2.2 s (a (inl i) (inl j)) (inJ (inl i) (inl j)))
     (J.2.2.2.2 (a (inl i) last) (row j) (inJ last (inl j))) ;
   -- (s t) v_i = s (a_i,last v_last + rest_i) = a_i,last rest_last + s rest_i.
   reduced-equation (i : Fin n) :
    Id V (scale (mul s t) (old i)) (Sum.lin n (reduced i) old) =
    trans (scalar-mul s t (old i))
     (trans (ap (scale s) (equations (inl i)))
      (trans (vector-add s (scale (a (inl i) last) (v last)) (rest (inl i)))
       (trans (ap (\ w -> plusV w (scale s (rest (inl i))))
         (trans (sym (scalar-mul s (a (inl i) last) (v last)))
          (trans (ap (\ b -> scale b (v last)) (mulC s (a (inl i) last)))
           (trans (scalar-mul (a (inl i) last) s (v last))
            (ap (scale (a (inl i) last)) last-equation)))))
        (trans (cong2 V plusV _ _ _ _
          (sym (Sum.lin-scale n (a (inl i) last) row old))
          (sym (Sum.lin-scale n s (\ j -> a (inl i) (inl j)) old)))
         (trans (comm (Sum.lin n (\ j -> mul (a (inl i) last) (row j)) old)
           (Sum.lin n (\ j -> mul s (a (inl i) (inl j))) old))
          (sym (Sum.lin-add n (\ j -> mul s (a (inl i) (inl j)))
           (\ j -> mul (a (inl i) last) (row j)) old))))))) ;
   previous : Killer n old = ih (mul s t) (one-mod-mul s t hs ht) old reduced reduced-inJ reduced-equation ;
   u : R = mul previous.1 s ;
   killed : (i : Fin (suc n)) -> Id V (scale u (v i)) zeroV = split {
    inl i -> trans (ap (\ b -> scale b (old i)) (mulC previous.1 s))
     (trans (scalar-mul s previous.1 (old i))
      (trans (ap (scale s) (previous.2.2 i)) (vector-zero s))) ;
    inr x -> trans (ap (\ w -> scale u (v (inr w))) (AffineFinite[l].top-eq x tt))
     (trans (scalar-mul previous.1 s (v last))
      (trans (ap (scale previous.1) last-equation)
       (trans (sym (Sum.sum-scale previous.1 n (\ j -> scale (row j) (old j))))
        (trans (Sum.sum-cong n (\ j -> scale previous.1 (scale (row j) (old j))) (\ j -> zeroV)
          (\ j -> trans (sym (scalar-mul previous.1 (row j) (old j)))
           (trans (ap (\ b -> scale b (old j)) (mulC previous.1 (row j)))
            (trans (scalar-mul (row j) previous.1 (old j))
             (trans (ap (scale (row j)) (previous.2.2 j)) (vector-zero (row j)))))))
         (Sum.sum-zero n))))) } ;
   result : Killer (suc n) v = (u,one-mod-mul previous.1 s previous.2.1 hs,killed) ;
  } ;
  eliminate : (n : Nat) -> Statement n = split {
   zero -> \ t ht v a inJ equations -> (t,ht,\ i -> efq i) ;
   suc n | ih -> \ t ht v a inJ equations -> Step[n,ih,t,ht,v,a,inJ,equations].result } ;
  one-mod-one : OneMod o = I.In[J].equal z (add o (neg o)) (sym (addN o)) J.2.2.1 ;
  -- The usual form: v_i = sum_j a_ij v_j.
  kill (n : Nat) (v : Fin n -> V) (a : Fin n -> Fin n -> R)
   (inJ : (i j : Fin n) -> J.1 (a i j))
   (equations : (i : Fin n) -> Id V (v i) (Sum.lin n (a i) v)) : Killer n v =
   eliminate n o one-mod-one v a inJ (\ i -> trans (scalar-one (v i)) (equations i)) ;
  -- Over a local ring: either every v_i vanishes, or 1 is in J.
  module Local (loc : (a b : R) -> unit (add a b) -> Tr.Trunc[Plus (unit a) (unit b)].carrier)
   (n : Nat) (v : Fin n -> V) (a : Fin n -> Fin n -> R)
   (inJ : (i j : Fin n) -> J.1 (a i j))
   (equations : (i : Fin n) -> Id V (v i) (Sum.lin n (a i) v)) {
   killer : Killer n v = kill n v a inJ equations ;
   m : R = killer.1 ;
   j : R = add m (neg o) ;
   Outcome : U l = Plus ((i : Fin n) -> Id V (v i) zeroV) (J.1 o) ;
   split-one : Id R (add m (neg j)) o =
    trans (ap (add m) (negsub m o))
     (trans (addA m (neg m) o) (trans (ap (\ x -> add x o) (addN m)) (zl o))) ;
   vanish (um : unit m) (i : Fin n) : Id V (v i) zeroV =
    trans (sym (scalar-one (v i)))
     (trans (ap (\ b -> scale b (v i)) (sym (trans (mulC um.1 m) um.2)))
      (trans (scalar-mul um.1 m (v i)) (trans (ap (scale um.1) (killer.2.2 i)) (vector-zero um.1)))) ;
   -- j is in J; a unit -j gives j k = 1 with k = -(-j)^-1.
   one-in (uj : unit (neg j)) : J.1 o =
    I.In[J].equal _ _
     (trans (mulC (neg uj.1) j) (trans (mul-neg j uj.1) (trans (sym (neg-mul-left j uj.1)) uj.2)))
     (J.2.2.2.2 (neg uj.1) j killer.2.1) ;
   decide : Plus (unit m) (unit (neg j)) -> Outcome = split {
    inl um -> inl (vanish um) ;
    inr uj -> inr (one-in uj) } ;
   outcome : Tr.Trunc[Outcome].carrier =
    Tr.Trunc[Plus (unit m) (unit (neg j))].induction @l (\ t -> Tr.Trunc[Outcome].carrier)
     (\ t -> Tr.Trunc[Outcome].proposition) (\ c -> Tr.Trunc[Outcome].inc (decide c))
     (loc m (neg j) (Prelude[l].subst R unit o (add m (neg j)) (sym split-one) (o,mulO o))) ;
  } ;
 } ;
} ;
