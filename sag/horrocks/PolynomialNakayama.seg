-- Nakayama for finitely many elements of an algebra killing a monic:
-- if v_i = sum_j q_ij(X) v_j and the coefficients of every q_ij lie
-- in a finite Jacobson-radical ideal of A, then every v_i vanishes.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (m : Nat) (fs : Fin m -> A.R) {
 module IA = Ideals[l].Over[A,setA] ;
 J : IA.Ideal = IA.Gen[m,fs].ideal ;
 module Quot = QuotientCertificate[l].Relative[A,setA,m,fs] ;
 K : CRing = Quot.K.A.ring ;
 reduction : RingHom[l].Hom A K = Quot.K.A.inclusion ;
 module Kernel = RingKernel[l].Over[A,K,setA,Quot.K.A.set,reduction] ;
 reduce-zero (a : A.R) : J.1 a -> Id K.R (reduction.1 a) K.z =
  Kernel.generated m fs Quot.kills a ;
 module At (radical : (a : A.R) -> J.1 a -> RL[A].unit (A.add A.o (A.neg a)))
  (C : CRing) (hom : RingHom[l].Hom PolynomialRing[l].Extension[A,setA].ring C) {
  module B = PolynomialRing[l].Extension[A,setA] ;
  module P = Poly[l].PolyR[A] ;
  module Bounds = PolynomialBounds[l].Over[A] ;
  module S = FiniteIdeal[l].Sums[C] ;
  module E = PolynomialFiniteExpansion[l].Over[A,C,setA,hom] ;
  module Shift = PowerBasisAction[l].Over[A,C,setA,hom] ;
  module SR = Shift.Reduction[K,reduction] ;
  module CR = RL[C] ;
  basis-case : (d : Nat) (p : P.P) -> Id C.R C.o (E.expansion d p) ->
   Plus ((k : Fin d) * Id C.R (E.basis d k) C.o) (Id C.R C.o C.z) = split {
   zero -> \ p h -> inr h ;
   suc d -> \ p h -> inl (inr tt,refl C.o) } ;
  module Given (f : P.P) (d : Nat) (leading : Id A.R (P.coef f d) A.o)
   (bound : Bounds.Bound (suc d) f) (kills : Id C.R (hom.1 (B.include f)) C.z)
   (n : Nat) (v : Fin n -> C.R) (q : Fin n -> Fin n -> P.P)
   (inJ : (i j : Fin n) (k : Nat) -> J.1 (P.coef (q i j) k))
   (equations : (i : Fin n) -> Id C.R (v i)
    (S.sum n (\ j -> C.mul (hom.1 (B.include (q i j))) (v j)))) {
   module Coordinates = MonicQuotientCoordinates[l].Over[A,C,setA,hom].At[f,d,leading,bound,kills] ;
   module CK = Coordinates.Kernel[K,reduction] ;
   shifted (i : Fin n) (k : Fin d) (j : Fin n) : P.P = Shift.shift d k (q i j) ;
   coefficients (i : Fin n) (k : Fin d) (j : Fin n) (s : Fin d) : A.R =
    Coordinates.coordinates (shifted i k j) s ;
   coefficients-inJ (i : Fin n) (k : Fin d) (j : Fin n) (s : Fin d) : J.1 (coefficients i k j s) =
    Quot.kernel (coefficients i k j s)
     (CK.coefficient-kernel (shifted i k j)
      (SR.kernel d k (q i j) (\ l -> reduce-zero (P.coef (q i j) l) (inJ i j l))) s) ;
   expansion (i : Fin n) (k : Fin d) (j : Fin n) :
    Id C.R (C.mul (E.basis d k) (hom.1 (B.include (q i j))))
     (S.sum d (\ s -> C.mul (E.phi.1 (coefficients i k j s)) (E.basis d s))) =
    trans (sym (Shift.equation d k (q i j))) (Coordinates.equation (shifted i k j)) ;
   module N = FiniteAlgebraNakayama[l].Over[A,C,setA,E.phi].At[J,radical,n,d,v,E.basis d,
    (\ i j -> hom.1 (B.include (q i j))),equations,coefficients,coefficients-inJ,expansion] ;
   one-expansion : Id C.R C.o (E.expansion d (Coordinates.remainder (cons A.o nil))) =
    trans (sym hom.2.1) (Coordinates.equation (cons A.o nil)) ;
   finish : Plus ((k : Fin d) * Id C.R (E.basis d k) C.o) (Id C.R C.o C.z) ->
    (i : Fin n) -> Id C.R (v i) C.z = split {
    inl k -> N.original-zero k.1 k.2 ;
    inr zero-ring -> \ i ->
     trans (sym (trans (C.mulC C.o (v i)) (C.mulO (v i))))
      (trans (ap (\ a -> C.mul a (v i)) zero-ring) (CR.zero-mul (v i))) } ;
   all-zero : (i : Fin n) -> Id C.R (v i) C.z =
    finish (basis-case d (Coordinates.remainder (cons A.o nil)) one-expansion) ;
  } ;
 } ;
} ;
