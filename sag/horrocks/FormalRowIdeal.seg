-- The fixed polynomial row ideal at every formal node, and its
-- transport along node arrows.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (n : Nat) (ys : Fin n -> List A.R) {
 module Original = PolynomialRing[l].Extension[A,setA] ;
 module T = FormalMonoidTree[l].Over[A,setA] ;
 module Ar = MonoidNodeArrows[l].Over[A,setA] ;
 module At (state : T.State) {
  C : CRing = Ar.At[state].C ;
  setC : Prelude[l].isSet C.R = Ar.At[state].set ;
  module Change = PolynomialMap[l].Over[A,C,setA,setC,Ar.At[state].inclusion] ;
  module B = Change.D ;
  module P = Poly[l].PolyR[C] ;
  module H = HorrocksInterface[l].Over[C,setC] ;
  module Bounds = PolynomialBounds[l].Over[C] ;
  y (i : Fin n) : B.Carrier = Change.hom.1 (Original.include (ys i)) ;
  raw-y (i : Fin n) : P.P = Change.coefficients (ys i) ;
  module Row = GeneratedIdeal[l].Over[B.ring,n,y] ;
  I : Ideals[l].Over[B.ring,B.set].Ideal = Ideals[l].Over[B.ring,B.set].Gen[n,y].ideal ;
  module Rad = FiniteRadicalLifting[l].Over[C,setC,state.1,Ar.At[state].N.Finite.gs] ;
  radical : (a : C.R) -> Rad.J.1 a -> RL[C].unit (C.add C.o (C.neg a)) =
   Ar.At[state].N.Finite.finite-radical ;
  module Reduction = Rad.At[radical].BaseChange ;
  module Kernel = RingKernel[l].Over[C,Rad.C,setC,Rad.Quot.K.A.set,Rad.phi] ;
  vanish (a : C.R) : Ar.At[state].J.Member a -> Id Rad.C.R (Rad.phi.1 a) Rad.C.z =
   Kernel.generated state.1 Ar.At[state].N.Finite.gs Rad.Quot.kills a ;
  Generator : U l = (lower : List C.R) * I.1 (H.monic lower) *
   (q : Fin n -> B.Carrier) * ((i : Fin n) -> Id Reduction.D.Carrier
    (Reduction.hom.1 (y i)) (Reduction.hom.1 (B.mulQ (H.monic lower) (q i)))) ;
  module Remainders (lower : List C.R) (member : I.1 (H.monic lower)) {
   module Division (i : Fin n) {
    module D = MonicIdealRemainders[l].Over[C,setC].At[I,lower,member].Given[
     raw-y i,Row.equal _ _ (Change.on-list (ys i)) (Row.generator i)] ;
   } ;
   quotient (i : Fin n) : B.Carrier = B.include Division[i].D.quotient ;
   remainder (i : Fin n) : P.P = Division[i].D.remainder ;
   bound (i : Fin n) : Bounds.Bound (len lower) (remainder i) = Division[i].D.bound ;
   members (i : Fin n) : I.1 (B.include (remainder i)) = Division[i].D.remainder-member ;
   equations (i : Fin n) : Id B.Carrier (y i)
    (B.addQ (B.mulQ (H.monic lower) (quotient i)) (B.include (remainder i))) =
    trans (Change.on-list (ys i)) Division[i].D.equation ;
  } ;
 } ;
 module Transfer (source target : T.State) (arrow : Ar.Between[source,target].Arrow) {
  module From = At[source] ; module To = At[target] ;
  module Change = PolynomialMap[l].Over[From.C,To.C,From.setC,To.setC,arrow.hom] ;
  module Triangle = PolynomialMapComposition[l].Over[A,From.C,To.C,setA,From.setC,To.setC,
   Ar.At[source].inclusion,arrow.hom,Ar.At[target].inclusion,arrow.constants] ;
  generator (i : Fin n) : Id To.B.Carrier (Change.hom.1 (From.y i)) (To.y i) =
   Triangle.pointwise (Original.include (ys i)) ;
  module Map = GeneratedIdealMap[l].Over[From.B.ring,To.B.ring,Change.hom,n,From.y,To.y,generator] ;
  raw-member (p : From.P.P) (member : From.I.1 (From.B.include p)) :
   To.I.1 (To.B.include (Change.coefficients p)) =
   To.Row.equal _ _ (Change.on-list p) (Map.member (From.B.include p) member) ;
  module Monic (lower : List From.C.R) (member : From.I.1 (From.H.monic lower)) {
   new-lower : List To.C.R = Change.coefficients lower ;
   degree : Id Nat (len new-lower) (len lower) = Change.coefficients-length lower ;
   new-member : To.I.1 (To.H.monic new-lower) =
    To.Row.equal _ _ (Change.monic lower) (Map.member (From.H.monic lower) member) ;
   module Rem = From.Remainders[lower,member] ;
   quotient (i : Fin n) : To.B.Carrier = Change.hom.1 (Rem.quotient i) ;
   remainder (i : Fin n) : To.P.P = Change.coefficients (Rem.remainder i) ;
   members (i : Fin n) : To.I.1 (To.B.include (remainder i)) = raw-member (Rem.remainder i) (Rem.members i) ;
   equations (i : Fin n) : Id To.B.Carrier (To.y i)
    (To.B.addQ (To.B.mulQ (To.H.monic new-lower) (quotient i)) (To.B.include (remainder i))) =
    trans (sym (generator i))
     (trans (ap Change.hom.1 (Rem.equations i))
      (trans (Change.hom.2.2.1 (From.B.mulQ (From.H.monic lower) (Rem.quotient i))
        (From.B.include (Rem.remainder i)))
       (cong2 To.B.Carrier To.B.addQ _ _ _ _
        (trans (Change.hom.2.2.2 (From.H.monic lower) (Rem.quotient i))
         (ap (\ h -> To.B.mulQ h (quotient i)) (Change.monic lower)))
        (Change.on-list (Rem.remainder i))))) ;
   module VanishingResult (all : (i : Fin n) (k : Nat) ->
    Ar.At[target].J.Member (arrow.hom.1 (From.P.coef (Rem.remainder i) k))) {
    coefficient-zero (i : Fin n) (k : Nat) :
     Id To.Rad.C.R (To.Rad.phi.1 (To.P.coef (remainder i) k)) To.Rad.C.z =
     trans (ap To.Rad.phi.1 (Change.coefficient-map (Rem.remainder i) k))
      (To.vanish _ (all i k)) ;
    zero (i : Fin n) : Id To.Reduction.D.Carrier
     (To.Reduction.hom.1 (To.B.include (remainder i))) To.Reduction.D.zeroQ =
     trans (To.Reduction.raw-equal (remainder i) nil
       (\ k -> trans (coefficient-zero i k) (sym (RingHom[l].zero To.C To.Rad.C To.Rad.phi))))
      (RingHom[l].zero To.B.ring To.Reduction.D.ring To.Reduction.hom) ;
    generates (i : Fin n) : Id To.Reduction.D.Carrier (To.Reduction.hom.1 (To.y i))
     (To.Reduction.hom.1 (To.B.mulQ (To.H.monic new-lower) (quotient i))) =
     trans (ap To.Reduction.hom.1 (equations i))
      (trans (To.Reduction.hom.2.2.1 (To.B.mulQ (To.H.monic new-lower) (quotient i))
        (To.B.include (remainder i)))
       (trans (ap (To.Reduction.D.addQ (To.Reduction.hom.1 (To.B.mulQ (To.H.monic new-lower) (quotient i)))) (zero i))
        (To.Reduction.D.add-zero (To.Reduction.hom.1 (To.B.mulQ (To.H.monic new-lower) (quotient i)))))) ;
    result : To.Generator = (new-lower,new-member,quotient,generates) ;
   } ;
   module Drop (i : Fin n) (r : Nat)
    (top : RL[To.C].unit (arrow.hom.1 (From.P.coef (Rem.remainder i) r)))
    (high : (k : Nat) -> Ar.At[target].J.Member
     (arrow.hom.1 (From.P.coef (Rem.remainder i) (plus (suc r) k)))) {
    unit : RL[To.C].unit (To.P.coef (remainder i) r) =
     subst RL[To.C].unit (sym (Change.coefficient-map (Rem.remainder i) r)) top ;
    bound (k : Nat) : Id To.Rad.C.R (To.Rad.phi.1 (To.P.coef (remainder i) (plus (suc r) k))) To.Rad.C.z =
     trans (ap To.Rad.phi.1 (Change.coefficient-map (Rem.remainder i) (plus (suc r) k)))
      (To.vanish _ (high k)) ;
    module Calculation = MonicDegreeDrop[l].Over[To.C,To.Rad.C,To.setC,To.Rad.phi,
     To.Rad.At[To.radical].Kernel.lift-unit].At[
     To.I,new-lower,new-member,remainder i,members i,r,unit,bound] ;
   } ;
  } ;
 } ;
} ;
