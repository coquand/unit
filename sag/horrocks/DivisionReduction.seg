-- If a polynomial already has small degree after reduction, division by a
-- monic polynomial preserves its reduction in the remainder.
level l ; open Ring[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R) (phi : RingHom[l].Hom A C) {
 module P = Poly[l].PolyR[A] ;
 module MulA = Mul[l].MulR[A] ;
 module Raw = RawLaws[l].Laws[A] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module CR = RL[C] ;
 Equal (p q : P.P) : U l =
  (k : Nat) -> Id C.R (phi.1 (P.coef p k)) (phi.1 (P.coef q k)) ;
 Bound (n : Nat) (p : P.P) : U l =
  (k : Nat) -> Id C.R (phi.1 (P.coef p (plus n k))) C.z ;
 tail-bound (n : Nat) (a : A.R) (p : P.P) (h : Bound n (cons a p)) : Bound n p =
  \ k -> trans (ap (\ m -> phi.1 (P.coef (cons a p) m)) (sym (plus-suc n k))) (h (suc k)) ;
 module At (f : P.P) (d : Nat) (leading : Id A.R (P.coef f d) A.o)
  (bound : Bounds.Bound (suc d) f) {
  module D = MonicDivision[l].Over[A,setA].General[f,d,leading,bound] ;
  module Step (a : A.R) (p : P.P)
   (ih : Bound d p -> Equal (D.divide p).2.1 p)
   (h : Bound d (cons a p)) {
   module S = D.Step[a,p,D.divide p] ;
   tail-equality : Equal S.r p = ih (tail-bound d a p h) ;
   shifted-equality : Equal S.shifted (cons a p) = split {
    zero -> refl (phi.1 a) ;
    suc k -> tail-equality k } ;
   carry-zero : Id C.R (phi.1 S.c) C.z =
    trans (shifted-equality d)
     (trans (ap (\ m -> phi.1 (P.coef (cons a p) m)) (sym (plus-zero d))) (h zero)) ;
   scalar-zero (k : Nat) : Id C.R (phi.1 (P.coef (MulA.scal S.c f) k)) C.z =
    trans (ap phi.1 (MulA.coef-scal S.c f k))
     (trans (phi.2.2.2 S.c (P.coef f k))
      (trans (ap (\ v -> C.mul v (phi.1 (P.coef f k))) carry-zero)
       (CR.zero-mul (phi.1 (P.coef f k))))) ;
   negative-zero (k : Nat) : Id C.R (phi.1 (P.coef (Raw.negP (MulA.scal S.c f)) k)) C.z =
    trans (ap phi.1 (Raw.neg-coef (MulA.scal S.c f) k))
     (trans (RingHom[l].negation A C phi (P.coef (MulA.scal S.c f) k))
      (trans (ap C.neg (scalar-zero k)) CR.neg-zero)) ;
   raw-equality (k : Nat) : Id C.R (phi.1 (P.coef S.Sub.raw k)) (phi.1 (P.coef S.shifted k)) =
    trans (ap phi.1 (MulA.coef-addP S.shifted (Raw.negP (MulA.scal S.c f)) k))
     (trans (phi.2.2.1 (P.coef S.shifted k) (P.coef (Raw.negP (MulA.scal S.c f)) k))
      (trans (ap (C.add (phi.1 (P.coef S.shifted k))) (negative-zero k))
       (C.addZ (phi.1 (P.coef S.shifted k))))) ;
   equality : Equal S.remainder (cons a p) = \ k ->
    trans (ap phi.1 (sym (S.Sub.equality k))) (trans (raw-equality k) (shifted-equality k)) ;
  } ;
  remainder-reduction : (p : P.P) -> Bound d p -> Equal (D.divide p).2.1 p = split {
   nil -> \ h k -> refl (phi.1 A.z) ;
   cons a p | ih -> \ h -> Step[a,p,ih,h].equality } ;
 } ;
} ;
