-- Monic generators of an ideal L of A[X], over any commutative ring.
-- A monic generator is a monic g in L dividing every element of L. Monic
-- polynomials are regular, and two monic polynomials dividing each other
-- are equal (MonicUniqueness), so the type of monic generators is a
-- proposition. Neither locality nor any rank-one data is used.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module IB = Ideals[l].Over[B.ring,B.set] ;
 module MR = MonicRegular[l].Over[A,setA] ;
 module MU = MonicUniqueness[l].Over[A,setA] ;
 Witness (g : B.Carrier) : U l = (lower : List A.R) * Id B.Carrier (H.monic lower) g ;
 IsMonic (g : B.Carrier) : U l = Tr.Trunc[Witness g].carrier ;
 Divides (g x : B.Carrier) : U l = (q : B.Carrier) * Id B.Carrier x (B.mulQ g q) ;
 -- A monic polynomial is regular, so its quotients are unique.
 regular (g : B.Carrier) (w : Witness g) : MR.Reg.Regular g =
  Pr.subst B.Carrier MR.Reg.Regular (H.monic w.1) g w.2 MR.At[w.1].regular ;
 divides-prop (g x : B.Carrier) (m : IsMonic g) : Pr.isProp (Divides g x) =
  Tr.Trunc[Witness g].induction @l (\ t -> Pr.isProp (Divides g x)) (\ t -> FE.isProp-isProp (Divides g x))
   (\ w u v -> Pr.Sigma-eq B.Carrier (\ q -> Id B.Carrier x (B.mulQ g q)) u.1 v.1 u.2 v.2
     (regular g w u.1 v.1 (trans (sym u.2) v.2)) (B.set x (B.mulQ g v.1))) m ;
 module Of (L : IB.Ideal) {
  Tail (g : B.Carrier) : U l = IsMonic g * L.1 g * ((x : B.Carrier) -> L.1 x -> Divides g x) ;
  tail-prop (g : B.Carrier) : Pr.isProp (Tail g) =
   Pr.isProp-Sigma (IsMonic g) (\ m -> L.1 g * ((x : B.Carrier) -> L.1 x -> Divides g x))
    Tr.Trunc[Witness g].proposition
    (\ m -> Pr.isProp-Sigma (L.1 g) (\ h -> (x : B.Carrier) -> L.1 x -> Divides g x) (L.2.1 g)
      (\ h -> FE.isProp-Pi B.Carrier (\ x -> L.1 x -> Divides g x)
       (\ x -> FE.isProp-Pi (L.1 x) (\ hx -> Divides g x) (\ hx -> divides-prop g x m)))) ;
  Generator : U l = (g : B.Carrier) * Tail g ;
  -- Two monic generators divide each other, so they are equal.
  module Pair (u v : Generator) {
   dv : Divides u.1 v.1 = u.2.2.2 v.1 v.2.2.1 ;
   du : Divides v.1 u.1 = v.2.2.2 u.1 u.2.2.1 ;
   core (wu : Witness u.1) (wv : Witness v.1) : Id B.Carrier u.1 v.1 =
    trans (sym wu.2)
     (trans (MU.Mutual[wu.1,wv.1,dv.1,du.1,
       trans wv.2 (trans dv.2 (ap (\ g -> B.mulQ g dv.1) (sym wu.2))),
       trans wu.2 (trans du.2 (ap (\ g -> B.mulQ g du.1) (sym wv.2)))].equality)
      wv.2) ;
   Goal : U l = Id B.Carrier u.1 v.1 ;
   equal : Goal =
    Tr.Trunc[Witness u.1].induction @l (\ t -> Goal) (\ t -> B.set u.1 v.1) (\ wu ->
     Tr.Trunc[Witness v.1].induction @l (\ t -> Goal) (\ t -> B.set u.1 v.1) (\ wv -> core wu wv)
      v.2.1)
     u.2.1 ;
  } ;
  generator-prop : Pr.isProp Generator =
   \ u v -> Pr.Sigma-eq B.Carrier Tail u.1 v.1 u.2 v.2 Pair[u,v].equal (tail-prop v.1) ;
  -- A monic member of L dividing all of L.
  monic (lower : List A.R) (member : L.1 (H.monic lower))
   (divides : (x : B.Carrier) -> L.1 x -> Divides (H.monic lower) x) : Generator =
   (H.monic lower,Tr.Trunc[Witness (H.monic lower)].inc (lower,refl (H.monic lower)),member,divides) ;
 } ;
} ;
