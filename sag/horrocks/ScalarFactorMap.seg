-- Scalar factorisations transport along arbitrary ring maps.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A B : CRing) (phi : RingHom[l].Hom A B) {
 module MA = RankOneProjector[l].Over[A] ;
 module MB = RankOneProjector[l].Over[B] ;
 module SA = FiniteIdeal[l].Sums[A] ;
 module SB = FiniteIdeal[l].Sums[B] ;
 module Map = StandardOpens[l].SumMap[A,B,phi] ;
 module At (n : Nat) (e : MA.Size[n].Matrix) (t : A.R) (w : MA.Size[n].ScalarFactor e t) {
  entries (i j : Fin n) : B.R = phi.1 (e i j) ;
  x (i : Fin n) : B.R = phi.1 (w.1 i) ;
  y (i : Fin n) : B.R = phi.1 (w.2.1 i) ;
  factors (i j : Fin n) : Id B.R (B.mul (x i) (y j)) (B.mul (phi.1 t) (entries i j)) =
   trans (sym (phi.2.2.2 (w.1 i) (w.2.1 j)))
    (trans (ap phi.1 (w.2.2.1 i j)) (phi.2.2.2 t (e i j))) ;
  contraction : Id B.R (SB.lin n y x) (phi.1 t) =
   trans (sym (Map.combination n w.2.1 w.1)) (ap phi.1 w.2.2.2) ;
  certificate : MB.Size[n].ScalarFactor entries (phi.1 t) = (x,y,factors,contraction) ;
 } ;
} ;
