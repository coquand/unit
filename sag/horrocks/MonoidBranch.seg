-- The algebraic comaximality step of the formal gcd tree.
-- A radical branch and a unit branch have a common parent denominator
-- in the ideal of any two chosen child denominators.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 open A ; open RL[A] ;
 module Pow = AffinePowers[l].Over[A] ;
 module IA = Ideals[l].Over[A,setA] ;
 module Saturation (I : IA.Ideal) (M : R -> U l)
  (one : M o) (product : (u v : R) -> M u -> M v -> M (mul u v)) {
  Witness (s : R) : U l = (u : R) * M u * (i : R) * I.1 i * Id R s (add u i) ;
  unit : Witness o = (o,one,z,I.2.2.1,sym (addZ o)) ;
  equal (s t : R) (eq : Id R s t) (w : Witness s) : Witness t =
   (w.1,w.2.1,w.2.2.1,w.2.2.2.1,trans (sym eq) w.2.2.2.2) ;
  plus-ideal (s j : R) (w : Witness s) (member : I.1 j) : Witness (add s j) =
   (w.1,w.2.1,add w.2.2.1 j,I.2.2.2.1 w.2.2.1 j w.2.2.2.1 member,
    trans (ap (\ a -> add a j) w.2.2.2.2) (sym (addA w.1 w.2.2.1 j))) ;
  module Multiply (s t : R) (ws : Witness s) (wt : Witness t) {
   u : R = ws.1 ; i : R = ws.2.2.1 ;
   v : R = wt.1 ; j : R = wt.2.2.1 ;
   remainder : R = add (mul u j) (mul t i) ;
   member : I.1 remainder =
    I.2.2.2.1 (mul u j) (mul t i)
     (I.2.2.2.2 u j wt.2.2.2.1) (I.2.2.2.2 t i ws.2.2.2.1) ;
   equation : Id R (mul s t) (add (mul u v) remainder) =
    trans (ap (\ a -> mul a t) ws.2.2.2.2)
     (trans (dist-left u i t)
      (trans (cong2 R add _ _ _ _ (ap (mul u) wt.2.2.2.2) (mulC i t))
       (trans (ap (\ a -> add a (mul t i)) (dist u v j))
        (sym (addA (mul u v) (mul u j) (mul t i)))))) ;
   witness : Witness (mul s t) = (mul u v,product u v ws.2.1 wt.2.1,remainder,member,equation) ;
  } ;
  multiply (s t : R) (ws : Witness s) (wt : Witness t) : Witness (mul s t) =
   Multiply[s,t,ws,wt].witness ;
  powers (s : R) (w : Witness s) : (n : Nat) -> Witness (Pow.power s n) = split {
   zero -> unit ; suc n | ih -> multiply s (Pow.power s n) w ih } ;
 } ;
 module Certificates (n : Nat) (fs : Fin n -> R) {
  module C = FiniteIdeal[l].Over[A,n,fs] ;
  move (x y : R) (h : C.Certificate (add x y) z) : C.Certificate x (neg y) =
   C.transitive x (add (add x y) (neg y)) (neg y)
    (C.equal _ _ (sym (add-neg-cancel x y)))
    (C.transitive _ (add z (neg y)) _
     (C.addition (add x y) z (neg y) (neg y) h (C.reflexive (neg y)))
     (C.equal _ _ (zl (neg y)))) ;
  powers (a b : R) (h : C.Certificate a b) : (k : Nat) ->
   C.Certificate (Pow.power a k) (Pow.power b k) = split {
   zero -> C.reflexive o ;
   suc k | ih -> C.multiplication a b (Pow.power a k) (Pow.power b k) h ih } ;
 } ;
 module Branch (I : IA.Ideal) (M : R -> U l)
  (one : M o) (product : (u v : R) -> M u -> M v -> M (mul u v)) {
  module S = Saturation[I,M,one,product] ;
  module At (a s b v j : R) (k : Nat) (ws : S.Witness s) (wv : S.Witness v) (hj : I.1 j) {
   left : R = add s (mul a b) ;
   right : R = add (mul v (Pow.power a k)) j ;
   generators : Fin (suc (suc zero)) -> R =
    snoc (Fin (suc zero)) R (\ i -> left) right ;
   module C = FiniteIdeal[l].Over[A,suc (suc zero),generators] ;
   module Aux = Certificates[suc (suc zero),generators] ;
   left-relation : C.Certificate s (mul a (neg b)) =
    C.transitive s (neg (mul a b)) (mul a (neg b))
     (Aux.move s (mul a b) (C.generator (inl (inr tt))))
     (C.equal _ _ (sym (mul-neg a b))) ;
   right-relation : C.Certificate (mul v (Pow.power a k)) (neg j) =
    Aux.move (mul v (Pow.power a k)) j (C.generator (inr tt)) ;
   powered : C.Certificate (Pow.power s k) (mul (Pow.power a k) (Pow.power (neg b) k)) =
    C.transitive _ (Pow.power (mul a (neg b)) k) _
     (Aux.powers s (mul a (neg b)) left-relation k)
     (C.equal _ _ (Pow.power-mul a (neg b) k)) ;
   scaled : C.Certificate (mul (Pow.power s k) v) (mul (Pow.power (neg b) k) (neg j)) =
    C.transitive _ (mul (mul (Pow.power a k) (Pow.power (neg b) k)) v) _
     (C.multiplication (Pow.power s k) (mul (Pow.power a k) (Pow.power (neg b) k)) v v powered (C.reflexive v))
     (C.transitive _ (mul (Pow.power (neg b) k) (mul v (Pow.power a k))) _
      (C.equal _ _
       (trans (sym (mulA (Pow.power a k) (Pow.power (neg b) k) v))
        (trans (mul-swap (Pow.power a k) (Pow.power (neg b) k) v)
         (ap (mul (Pow.power (neg b) k)) (mulC (Pow.power a k) v)))))
      (C.multiplication (Pow.power (neg b) k) (Pow.power (neg b) k)
       (mul v (Pow.power a k)) (neg j) (C.reflexive (Pow.power (neg b) k)) right-relation)) ;
   parent : R = add (mul (Pow.power s k) v) (mul (Pow.power (neg b) k) j) ;
   parent-member : S.Witness parent =
    S.plus-ideal (mul (Pow.power s k) v) (mul (Pow.power (neg b) k) j)
     (S.multiply (Pow.power s k) v (S.powers s ws k) wv)
     (I.2.2.2.2 (Pow.power (neg b) k) j hj) ;
   certificate : C.Certificate parent z =
    C.transitive _ (add (mul (Pow.power (neg b) k) (neg j)) (mul (Pow.power (neg b) k) j)) _
     (C.addition (mul (Pow.power s k) v) (mul (Pow.power (neg b) k) (neg j))
      (mul (Pow.power (neg b) k) j) (mul (Pow.power (neg b) k) j) scaled
      (C.reflexive (mul (Pow.power (neg b) k) j)))
     (C.equal _ _
      (trans (ap (\ t -> add t (mul (Pow.power (neg b) k) j)) (mul-neg (Pow.power (neg b) k) j))
       (trans (addC (neg (mul (Pow.power (neg b) k) j)) (mul (Pow.power (neg b) k) j))
        (addN (mul (Pow.power (neg b) k) j))))) ;
  } ;
 } ;
} ;
