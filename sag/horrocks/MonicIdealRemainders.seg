-- Divide ideal generators by a monic member. The remainders remain
-- in the ideal; their vanishing modulo J certifies generation modulo J.
level l ; open Ring[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module P = Poly[l].PolyR[A] ;
 module B = PolynomialRing[l].Extension[A,setA] ;
 module H = HorrocksInterface[l].Over[A,setA] ;
 module IA = Ideals[l].Over[B.ring,B.set] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module At (I : IA.Ideal) (lower : List A.R) (member : I.1 (H.monic lower)) {
  module Division = MonicDivision[l].Over[A,setA].At[lower] ;
  module Given (p : P.P) (p-member : I.1 (B.include p)) {
   result : Division.G.Result p = Division.divide p ;
   quotient : P.P = result.1 ;
   remainder : P.P = result.2.1 ;
   bound : Bounds.Bound (len lower) remainder = result.2.2.1 ;
   equation : Id B.Carrier (B.include p)
    (B.addQ (B.mulQ (H.monic lower) (B.include quotient)) (B.include remainder)) =
    result.2.2.2 ;
   remainder-member : I.1 (B.include remainder) =
    IdealArithmetic[l].Over[B.ring,B.set].In[I].remainder
     (B.include p) (B.mulQ (H.monic lower) (B.include quotient)) (B.include remainder)
     p-member
     (IA.In[I].equal _ _ (B.mul-comm (B.include quotient) (H.monic lower))
      (I.2.2.2.2 (B.include quotient) (H.monic lower) member)) equation ;
   module Reduction (C : CRing) (setC : Prelude[l].isSet C.R) (phi : RingHom[l].Hom A C)
    (zero : (k : Nat) -> Id C.R (phi.1 (P.coef remainder k)) C.z) {
    module Change = PolynomialMap[l].Over[A,C,setA,setC,phi] ;
    vanishes : Id Change.D.Carrier (Change.hom.1 (B.include remainder)) Change.D.zeroQ =
     trans (Change.raw-equal remainder nil
      (\ k -> trans (zero k) (sym (RingHom[l].zero A C phi))))
      (RingHom[l].zero B.ring Change.D.ring Change.hom) ;
    generates : Id Change.D.Carrier (Change.hom.1 (B.include p))
     (Change.hom.1 (B.mulQ (H.monic lower) (B.include quotient))) =
     trans (ap Change.hom.1 equation)
      (trans (Change.hom.2.2.1 (B.mulQ (H.monic lower) (B.include quotient)) (B.include remainder))
       (trans (ap (Change.D.addQ (Change.hom.1 (B.mulQ (H.monic lower) (B.include quotient)))) vanishes)
        (Change.D.add-zero (Change.hom.1 (B.mulQ (H.monic lower) (B.include quotient)))))) ;
   } ;
  } ;
 } ;
} ;
