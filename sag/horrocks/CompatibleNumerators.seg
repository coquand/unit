-- Making cleared local numerators exactly compatible.
-- Given u_ij v_ij (d_j p_i - d_i p_j) = 0 for all i, j, put
--   r_i = prod_k u_ik v_ki,  s_i = d_i r_i,  H_i = r_i p_i.
-- Then s_i H_j = s_j H_i, because u_ij divides r_i and v_ij divides r_j.
level l ; open Ring[l] ; open Presentations[l] ;
module Products (A : CRing) {
 open A ;
 prod : (k : Nat) -> (Fin k -> R) -> R = split {
  zero -> \ f -> o ; suc k | ih -> \ f -> mul (f (inr tt)) (ih (\ i -> f (inl i))) } ;
 Divides (a b : R) : U l = (q : R) * Id R b (mul a q) ;
 factor : (k : Nat) (f : Fin k -> R) (j : Fin k) -> Divides (f j) (prod k f) = split {
  zero -> \ f j -> efq j ;
  suc k | ih -> \ f -> AffineFinite[l].section k (\ j -> Divides (f j) (prod (suc k) f))
   (\ j -> let { w : Divides (f (inl j)) (prod k (\ i -> f (inl i))) = ih (\ i -> f (inl i)) j ; } in
    (mul (f (inr tt)) w.1,
     trans (ap (mul (f (inr tt))) w.2) (RL[A].mul-swap (f (inr tt)) (f (inl j)) w.1)))
   (prod k (\ i -> f (inl i)),refl (prod (suc k) f)) } ;
 member (P : R -> U l) (one : P o) (product : (s t : R) -> P s -> P t -> P (mul s t)) :
  (k : Nat) (f : Fin k -> R) -> ((j : Fin k) -> P (f j)) -> P (prod k f) = split {
  zero -> \ f h -> one ;
  suc k | ih -> \ f h -> product (f (inr tt)) (prod k (\ i -> f (inl i))) (h (inr tt))
   (ih (\ i -> f (inl i)) (\ i -> h (inl i))) } ;
} ;
module Over (A Rg : CRing) (kappa : RingHom[l].Hom A Rg) (m : Nat)
 (d : Fin m -> A.R) (p : Fin m -> Rg.R) (u v : Fin m -> Fin m -> A.R)
 (kill : (i j : Fin m) -> Id Rg.R
  (Rg.mul (kappa.1 (A.mul (u i j) (v i j)))
   (Rg.add (Rg.mul (kappa.1 (d j)) (p i)) (Rg.neg (Rg.mul (kappa.1 (d i)) (p j))))) Rg.z) {
 module P = Products[A] ;
 module RR = RingRearrange[l] ;
 k (a : A.R) : Rg.R = kappa.1 a ;
 r (i : Fin m) : A.R = P.prod m (\ j -> A.mul (u i j) (v j i)) ;
 s (i : Fin m) : A.R = A.mul (d i) (r i) ;
 h (i : Fin m) : Rg.R = Rg.mul (k (r i)) (p i) ;
 -- (a b) q1 (c e) q2 = (a e) ((b q1) (c q2)).
 pair (a b c e q1 q2 : A.R) :
  Id A.R (A.mul (A.mul (A.mul a b) q1) (A.mul (A.mul c e) q2))
   (A.mul (A.mul a e) (A.mul (A.mul b q1) (A.mul c q2))) =
  GeneratedRing[l].RegroupProducts[A,a,b,c,e,q1,q2].proof ;
 module Pair (i j : Fin m) {
  wi : P.Divides (A.mul (u i j) (v j i)) (r i) = P.factor m (\ x -> A.mul (u i x) (v x i)) j ;
  wj : P.Divides (A.mul (u j i) (v i j)) (r j) = P.factor m (\ x -> A.mul (u j x) (v x j)) i ;
  alpha : A.R = A.mul (A.mul (v j i) wi.1) (A.mul (u j i) wj.1) ;
  split-r : Id A.R (A.mul (r i) (r j)) (A.mul (A.mul (u i j) (v i j)) alpha) =
   trans (cong2 A.R A.mul _ _ _ _ wi.2 wj.2) (pair (u i j) (v j i) (u j i) (v i j) wi.1 wj.1) ;
  e : Rg.R = k (A.mul (u i j) (v i j)) ;
  rho : Rg.R = Rg.mul (k (r i)) (k (r j)) ;
  rho-split : Id Rg.R rho (Rg.mul (k alpha) e) =
   trans (sym (kappa.2.2.2 (r i) (r j)))
    (trans (ap kappa.1 split-r)
     (trans (kappa.2.2.2 (A.mul (u i j) (v i j)) alpha) (Rg.mulC e (k alpha)))) ;
  killed : Id Rg.R (Rg.mul e (Rg.mul (k (d j)) (p i))) (Rg.mul e (Rg.mul (k (d i)) (p j))) =
   RR.cancel-difference Rg e (Rg.mul (k (d j)) (p i)) (Rg.mul (k (d i)) (p j)) (kill i j) ;
  middle : Id Rg.R (Rg.mul rho (Rg.mul (k (d i)) (p j))) (Rg.mul rho (Rg.mul (k (d j)) (p i))) =
   trans (ap (\ x -> Rg.mul x (Rg.mul (k (d i)) (p j))) rho-split)
    (trans (sym (Rg.mulA (k alpha) e (Rg.mul (k (d i)) (p j))))
     (trans (ap (Rg.mul (k alpha)) (sym killed))
      (trans (Rg.mulA (k alpha) e (Rg.mul (k (d j)) (p i)))
       (ap (\ x -> Rg.mul x (Rg.mul (k (d j)) (p i))) (sym rho-split))))) ;
  -- s_i H_j = s_j H_i.
  overlap : Id Rg.R (Rg.mul (k (s i)) (h j)) (Rg.mul (k (s j)) (h i)) =
   trans (ap (\ x -> Rg.mul x (h j)) (kappa.2.2.2 (d i) (r i)))
    (trans (RR.four Rg (k (d i)) (k (r i)) (k (r j)) (p j))
     (trans middle
      (sym (trans (ap (\ x -> Rg.mul x (h i)) (kappa.2.2.2 (d j) (r j)))
       (trans (RR.four Rg (k (d j)) (k (r j)) (k (r i)) (p i))
        (ap (\ x -> Rg.mul x (Rg.mul (k (d j)) (p i))) (Rg.mulC (k (r j)) (k (r i))))))))) ;
 } ;
} ;
