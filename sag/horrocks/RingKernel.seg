level l ; open Ring[l] ; open Presentations[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R)
 (setC : Prelude[l].isSet C.R) (phi : RingHom[l].Hom A C) {
 module IA = Ideals[l].Over[A,setA] ;
 module CR = RL[C] ;
 member (a : A.R) : U l = Id C.R (phi.1 a) C.z ;
 plus-closed (a b : A.R) (ha : member a) (hb : member b) : member (A.add a b) =
  trans (phi.2.2.1 a b) (trans (cong2 C.R C.add _ _ _ _ ha hb) (C.addZ C.z)) ;
 scale-closed (a b : A.R) (hb : member b) : member (A.mul a b) =
  trans (phi.2.2.2 a b) (trans (ap (C.mul (phi.1 a)) hb) (CR.mul-zero (phi.1 a))) ;
 ideal : IA.Ideal =
  (member,(\ a -> setC (phi.1 a) C.z),RingHom[l].zero A C phi,plus-closed,scale-closed) ;
 generated (n : Nat) (fs : Fin n -> A.R)
  (kills : (i : Fin n) -> member (fs i)) (a : A.R) :
  GeneratedIdeal[l].Over[A,n,fs].Member a -> member a =
  IA.In[ideal].generated-in n fs kills a ;
} ;
