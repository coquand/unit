-- Inverting S(I;U)=M(U)+(I) puts the extended ideal I in the
-- Jacobson radical. This supplies the hypothesis of Lemmas 7.5 and 7.6.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R)
 (I : Ideals[l].Over[A,setA].Ideal) (M : A.R -> U l) (one : M A.o)
 (product : (s t : A.R) -> M s -> M t -> M (A.mul s t)) {
 module S = MonoidBranch[l].Over[A,setA].Saturation[I,M,one,product] ;
 module B = MonoidLocalization[l].Over[A,S.Witness,S.unit,S.multiply] ;
 module J = LocalizedIdeal[l].Over[A,setA,S.Witness,S.unit,S.multiply,I] ;
 module IA = IdealArithmetic[l].Over[A,setA].In[I] ;
 module BR = RL[B.ring] ;
 module Units = AffineRing[l].Laws[B.ring,B.set] ;
 module Fraction (q : B.Raw.Fraction) (member : I.1 q.1) {
  s : A.R = q.2.1 ;
  numerator : A.R = A.add s (A.neg q.1) ;
  denominator : S.Witness numerator = S.plus-ideal s (A.neg q.1) q.2.2 (IA.negative q.1 member) ;
  equation : Id B.Carrier
   (B.mulQ (B.constant s) (B.addQ B.oneQ (B.negQ (B.include q)))) (B.constant numerator) =
   trans (B.distributive (B.constant s) B.oneQ (B.negQ (B.include q)))
    (trans (cong2 B.Carrier B.addQ _ _ _ _ (B.mul-one (B.constant s))
      (trans (BR.mul-neg (B.constant s) (B.include q)) (ap B.negQ (B.fraction-equation q))))
     (trans (ap (B.addQ (B.constant s)) (sym (RingHom[l].negation A B.ring B.inclusion q.1)))
      (sym (B.constant-add s (A.neg q.1))))) ;
  unit : BR.unit (B.addQ B.oneQ (B.negQ (B.include q))) =
   Units.unit-right (B.constant s) (B.addQ B.oneQ (B.negQ (B.include q)))
    (subst BR.unit (sym equation) (B.inverse numerator denominator)) ;
 } ;
 module Tr = Truncation[l] ;
 radical (a : B.Carrier) (member : J.Member a) : BR.unit (B.addQ B.oneQ (B.negQ a)) =
  Tr.Trunc[J.Witness a].induction @l
   (\ w -> BR.unit (B.addQ B.oneQ (B.negQ a)))
   (\ w -> Units.unit-prop (B.addQ B.oneQ (B.negQ a)))
   (\ w -> subst (\ b -> BR.unit (B.addQ B.oneQ (B.negQ b))) w.2.2 Fraction[w.1,w.2.1].unit)
   member ;
 module Finite (n : Nat) (fs : Fin n -> A.R) (members : (i : Fin n) -> I.1 (fs i)) {
  gs : Fin n -> B.Carrier = \ i -> B.constant (fs i) ;
  module G = GeneratedIdeal[l].Over[B.ring,n,gs] ;
  included (a : B.Carrier) : G.Member a -> J.Member a =
   Ideals[l].Over[B.ring,B.set].In[J.ideal].generated-in n gs (\ i -> J.constant (fs i) (members i)) a ;
  finite-radical (a : B.Carrier) (h : G.Member a) : BR.unit (B.addQ B.oneQ (B.negQ a)) =
   radical a (included a h) ;
 } ;
} ;
module Node (A : CRing) (setA : Prelude[l].isSet A.R)
 (m : Nat) (fs : Fin m -> A.R) (n : Nat) (us : Fin n -> A.R) {
 module N = FiniteMonoids[l].Over[A,setA].Node[m,fs,n,us] ;
 module Loc = Over[A,setA,N.I,N.M.Member,N.M.one,N.M.product] ;
 module Finite = Loc.Finite[m,fs,N.J.generator] ;
 module Local = LocalHorrocks[l].Over[Loc.B.ring,Loc.B.set,m,Finite.gs] ;
 -- The Local.At module can now be instantiated with Finite.finite-radical.
} ;
