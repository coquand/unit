-- A quotient killing a monic polynomial has explicit finite A-coordinates.
-- This is the finite-generation ingredient for the remaining Lemma 7.6.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R)
 (hom : RingHom[l].Hom PolynomialRing[l].Extension[A,setA].ring C) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module P = Poly[l].PolyR[A] ;
 module Bounds = PolynomialBounds[l].Over[A] ;
 module Expansion = PolynomialFiniteExpansion[l].Over[A,C,setA,hom] ;
 module CR = RL[C] ;
 module At (f : P.P) (d : Nat) (leading : Id A.R (P.coef f d) A.o)
  (bound : Bounds.Bound (suc d) f)
  (kills : Id C.R (hom.1 (B.include f)) C.z) {
  module D = MonicDivision[l].Over[A,setA].General[f,d,leading,bound] ;
  remainder (p : P.P) : P.P = (D.divide p).2.1 ;
  coordinates (p : P.P) : Fin d -> A.R = Expansion.coefficients d (remainder p) ;
  equation (p : P.P) : Id C.R (hom.1 (B.include p)) (Expansion.expansion d (remainder p)) =
   trans (ap hom.1 (D.divide p).2.2.2)
    (trans (hom.2.2.1 (B.mulQ (B.include f) (B.include (D.divide p).1)) (B.include (remainder p)))
     (trans (ap (\ a -> C.add a (hom.1 (B.include (remainder p))))
       (trans (hom.2.2.2 (B.include f) (B.include (D.divide p).1))
        (trans (ap (\ a -> C.mul a (hom.1 (B.include (D.divide p).1))) kills)
         (CR.zero-mul (hom.1 (B.include (D.divide p).1))))))
      (trans (CR.zl (hom.1 (B.include (remainder p))))
       (Expansion.equation d (remainder p) (D.divide p).2.2.1)))) ;
  module Kernel (K : CRing) (reduction : RingHom[l].Hom A K) {
   module Red = DivisionReduction[l].Over[A,K,setA,reduction] ;
   module RD = Red.At[f,d,leading,bound] ;
   module Property = Expansion.CoefficientProperty[\ a -> Id K.R (reduction.1 a) K.z] ;
   coefficient-kernel (p : P.P)
    (zero-p : (k : Nat) -> Id K.R (reduction.1 (P.coef p k)) K.z)
    (i : Fin d) : Id K.R (reduction.1 (coordinates p i)) K.z =
    Property.all d (remainder p)
     (\ k -> trans (RD.remainder-reduction p (\ j -> zero-p (plus d j)) k) (zero-p k)) i ;
  } ;
 } ;
} ;
