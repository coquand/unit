-- Nakayama's radical case, by eliminating one generator at a time.
-- No determinant, projectivity, finiteness of relations, or choice axiom.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 open A ; open RL[A] ;
 module I = Ideals[l].Over[A,setA] ;
 module Linear = FiniteLinear[l].Over[A] ;
 module At (J : I.Ideal)
  (radical : (a : R) -> J.1 a -> unit (add o (neg a)))
  (D : Linear.Module) {
  open D ;
  module Sum = Linear.In[D] ;
  Statement (n : Nat) : U l =
   (v : Fin n -> V) (a : Fin n -> Fin n -> R) ->
   ((i j : Fin n) -> J.1 (a i j)) ->
   ((i : Fin n) -> Id V (v i) (Sum.lin n (a i) v)) ->
   (i : Fin n) -> Id V (v i) zeroV ;
  module Step (n : Nat) (ih : Statement n)
   (v : Fin (suc n) -> V) (a : Fin (suc n) -> Fin (suc n) -> R)
   (inJ : (i j : Fin (suc n)) -> J.1 (a i j))
   (equations : (i : Fin (suc n)) -> Id V (v i) (Sum.lin (suc n) (a i) v)) {
   last : Fin (suc n) = inr tt ;
   diagonal : R = a last last ;
   pivot : unit (add o (neg diagonal)) = radical diagonal (inJ last last) ;
   old (i : Fin n) : V = v (inl i) ;
   row (j : Fin n) : R = mul pivot.1 (a last (inl j)) ;
   last-equation : Id V (v last) (Sum.lin n row old) =
    trans (Sum.solve diagonal pivot (v last) (Sum.lin n (\ j -> a last (inl j)) old)
      (equations last))
     (sym (Sum.lin-scale n pivot.1 (\ j -> a last (inl j)) old)) ;
   reduced (i j : Fin n) : R =
    add (a (inl i) (inl j)) (mul (a (inl i) last) (row j)) ;
   reduced-inJ (i j : Fin n) : J.1 (reduced i j) =
    J.2.2.2.1 _ _ (inJ (inl i) (inl j))
     (J.2.2.2.2 (a (inl i) last) (row j)
      (J.2.2.2.2 pivot.1 (a last (inl j)) (inJ last (inl j)))) ;
   reduced-equation (i : Fin n) : Id V (old i) (Sum.lin n (reduced i) old) =
    trans (equations (inl i))
     (trans (ap (\ w -> plusV (scale (a (inl i) last) w)
       (Sum.lin n (\ j -> a (inl i) (inl j)) old)) last-equation)
      (trans (ap (\ w -> plusV w (Sum.lin n (\ j -> a (inl i) (inl j)) old))
        (sym (Sum.lin-scale n (a (inl i) last) row old)))
       (trans (comm (Sum.lin n (\ j -> mul (a (inl i) last) (row j)) old)
         (Sum.lin n (\ j -> a (inl i) (inl j)) old))
        (sym (Sum.lin-add n (\ j -> a (inl i) (inl j))
          (\ j -> mul (a (inl i) last) (row j)) old))))) ;
   old-zero (i : Fin n) : Id V (old i) zeroV =
    ih old reduced reduced-inJ reduced-equation i ;
   all-zero : (i : Fin (suc n)) -> Id V (v i) zeroV = split {
    inl i -> old-zero i ;
    inr t -> trans (ap (\ u -> v (inr u)) (AffineFinite[l].top-eq t tt))
     (trans last-equation (Sum.lin-vanish n row old old-zero)) } ;
  } ;
  eliminate : (n : Nat) -> Statement n = split {
   zero -> \ v a inJ equations i -> efq i ;
   suc n | ih -> \ v a inJ equations -> Step[n,ih,v,a,inJ,equations].all-zero } ;
 } ;
} ;
