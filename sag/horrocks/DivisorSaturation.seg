-- Explicit form of L intersect ker(phi) = ker(phi) L for a divisor of t,
-- assuming t is regular both before and after applying phi.
-- The input is precisely a scalar rank-one factorisation certificate.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A C : CRing) (phi : RingHom[l].Hom A C) {
 open A ; open RL[A] ;
 module S = FiniteIdeal[l].Sums[A] ;
 module M = RankOneProjector[l].Over[A] ;
 module RA = Regularity[l].Over[A] ;
 module RC = Regularity[l].Over[C] ;
 module CR = RL[C] ;
 module At (n : Nat) (e : M.Size[n].Matrix) (t : R)
  (regular : RA.Regular t) (residue-regular : RC.Regular (phi.1 t))
  (w : M.Size[n].ScalarFactor e t) {
  x : M.Size[n].Vector = w.1 ;
  y : M.Size[n].Vector = w.2.1 ;
  xy (i j : Fin n) : Id R (mul (x i) (y j)) (mul t (e i j)) = w.2.2.1 i j ;
  contraction : Id R (S.lin n y x) t = w.2.2.2 ;
  module Element (p : R) (c : M.Size[n].Vector) (generated : Id R (S.lin n y c) p) {
   q (i : Fin n) : R = S.lin n (e i) c ;
   xp (i : Fin n) : Id R (mul (x i) p) (mul t (q i)) =
    trans (ap (mul (x i)) (sym generated))
     (trans (sym (S.sum-scale (x i) n (\ j -> mul (y j) (c j))))
      (trans (S.sum-cong n
        (\ j -> mul (x i) (mul (y j) (c j)))
        (\ j -> mul t (mul (e i j) (c j)))
        (\ j -> trans (mulA (x i) (y j) (c j))
         (trans (ap (\ z1 -> mul z1 (c j)) (xy i j))
          (sym (mulA t (e i j) (c j))))))
       (S.sum-scale t n (\ j -> mul (e i j) (c j))))) ;
   term (i : Fin n) : Id R (mul t (mul (y i) (q i))) (mul p (mul (y i) (x i))) =
    trans (mul-swap t (y i) (q i))
     (trans (ap (mul (y i)) (sym (xp i)))
      (trans (mulA (y i) (x i) p) (mulC (mul (y i) (x i)) p))) ;
   reconstruct : Id R (S.lin n y q) p =
    regular (S.lin n y q) p
     (trans (sym (S.sum-scale t n (\ i -> mul (y i) (q i))))
      (trans (S.sum-cong n (\ i -> mul t (mul (y i) (q i)))
        (\ i -> mul p (mul (y i) (x i))) term)
       (trans (S.sum-scale p n (\ i -> mul (y i) (x i)))
        (trans (ap (mul p) contraction) (mulC p t))))) ;
   coefficient-kernel (zero-p : Id C.R (phi.1 p) C.z) (i : Fin n) :
    Id C.R (phi.1 (q i)) C.z =
    residue-regular (phi.1 (q i)) C.z
     (trans (sym (phi.2.2.2 t (q i)))
      (trans (ap phi.1 (sym (xp i)))
       (trans (phi.2.2.2 (x i) p)
        (trans (ap (C.mul (phi.1 (x i))) zero-p)
         (trans (CR.mul-zero (phi.1 (x i))) (sym (CR.mul-zero (phi.1 t)))))))) ;
   certificate (zero-p : Id C.R (phi.1 p) C.z) :
    (v : M.Size[n].Vector) * Id R (S.lin n y v) p *
     ((i : Fin n) -> Id C.R (phi.1 (v i)) C.z) =
    (q,reconstruct,coefficient-kernel zero-p) ;
  } ;
 } ;
} ;
