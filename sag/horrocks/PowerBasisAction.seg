-- Multiplication by a member of the finite power basis is a coefficient shift.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A C : CRing) (setA : Prelude[l].isSet A.R)
 (hom : RingHom[l].Hom PolynomialRing[l].Extension[A,setA].ring C) {
 module B = PolynomialRing[l].Extension[A,setA] ;
 module P = Poly[l].PolyR[A] ;
 module E = PolynomialFiniteExpansion[l].Over[A,C,setA,hom] ;
 module Shift = PolynomialShift[l].Over[A,setA] ;
 shift : (d : Nat) -> Fin d -> P.P -> P.P = split {
  zero -> \ k p -> efq k ;
  suc d | ih -> split {
   inl k -> \ p -> cons A.z (ih k p) ;
   inr t -> \ p -> p } } ;
 equation : (d : Nat) (k : Fin d) (p : P.P) ->
  Id C.R (hom.1 (B.include (shift d k p)))
   (C.mul (E.basis d k) (hom.1 (B.include p))) = split {
  zero -> \ k p -> efq k ;
  suc d | ih -> split {
   inl k -> \ p ->
    trans (ap hom.1 (sym (Shift.shift-equation (shift d k p))))
     (trans (hom.2.2.2 B.variable (B.include (shift d k p)))
      (trans (ap (C.mul E.variable) (ih k p))
       (C.mulA E.variable (E.basis d k) (hom.1 (B.include p))))) ;
   inr t -> \ p -> sym (trans (C.mulC C.o (hom.1 (B.include p))) (C.mulO (hom.1 (B.include p)))) } } ;
 module Reduction (K : CRing) (phi : RingHom[l].Hom A K) {
  kernel : (d : Nat) (k : Fin d) (p : P.P) ->
   ((j : Nat) -> Id K.R (phi.1 (P.coef p j)) K.z) ->
   (j : Nat) -> Id K.R (phi.1 (P.coef (shift d k p) j)) K.z = split {
   zero -> \ k p h j -> efq k ;
   suc d | ih -> split {
    inl k -> \ p h -> split {
     zero -> RingHom[l].zero A K phi ;
     suc j -> ih k p h j } ;
    inr t -> \ p h -> h } } ;
 } ;
} ;
