-- Ring maps between formal nodes, preserving their radical ideals
-- and their maps from the original coefficient ring.
level l ; open Ring[l] ; open Presentations[l] ;
module Over (A : CRing) (setA : Prelude[l].isSet A.R) {
 module T = FormalMonoidTree[l].Over[A,setA] ;
 module At (state : T.State) {
  module N = JacobsonLocalization[l].Node[A,setA,state.1,state.2.1,state.2.2.1,state.2.2.2] ;
  C : CRing = N.Loc.B.ring ;
  set : Prelude[l].isSet C.R = N.Loc.B.set ;
  inclusion : RingHom[l].Hom A C = N.Loc.B.inclusion ;
  module J = N.Finite.G ;
 } ;
 module Between (source target : T.State) {
  record Arrow {
   hom : RingHom[l].Hom At[source].C At[target].C ;
   constants (a : A.R) : Id At[target].C.R
    (hom.1 (At[source].inclusion.1 a)) (At[target].inclusion.1 a) ;
   radical (a : At[source].C.R) : At[source].J.Member a -> At[target].J.Member (hom.1 a) ;
  } ;
 } ;
 identity (state : T.State) : Between[state,state].Arrow =
  Between[state,state].mkArrow (RingHom[l].identity At[state].C)
   (\ a -> refl (At[state].inclusion.1 a)) (\ a h -> h) ;
 compose (source middle target : T.State)
  (g : Between[middle,target].Arrow) (f : Between[source,middle].Arrow) : Between[source,target].Arrow =
  Between[source,target].mkArrow
   (RingHom[l].compose At[source].C At[middle].C At[target].C g.hom f.hom)
   (\ a -> trans (ap g.hom.1 (f.constants a)) (g.constants a))
   (\ a h -> g.radical (f.hom.1 a) (f.radical a h)) ;
 module Branch (state : T.State) (a : A.R) {
  left-state : T.State = T.radical state a ;
  right-state : T.State = T.invert state a ;
  module Maps = MonoidBranchMaps[l].Over[A,setA,state.1,state.2.1,state.2.2.1,state.2.2.2].At[a] ;
  module LeftMap = GeneratedIdealMap[l].Over[
   At[state].C,At[left-state].C,Maps.Left.hom,state.1,
   At[state].N.Finite.gs,\ i -> At[left-state].inclusion.1 (state.2.1 i),
   \ i -> Maps.Left.constants (state.2.1 i)] ;
  left-ideal (b : At[state].C.R) (h : At[state].J.Member b) :
   At[left-state].J.Member (Maps.Left.hom.1 b) =
   At[left-state].J.includes state.1
    (\ i -> At[left-state].inclusion.1 (state.2.1 i))
    (\ i -> At[left-state].J.generator (inl i))
    (Maps.Left.hom.1 b) (LeftMap.member b h) ;
  module RightMap = GeneratedIdealMap[l].Over[
   At[state].C,At[right-state].C,Maps.Right.hom,state.1,
   At[state].N.Finite.gs,At[right-state].N.Finite.gs,
   \ i -> Maps.Right.constants (state.2.1 i)] ;
  left : Between[state,left-state].Arrow =
   Between[state,left-state].mkArrow Maps.Left.hom Maps.Left.constants left-ideal ;
  right : Between[state,right-state].Arrow =
   Between[state,right-state].mkArrow Maps.Right.hom Maps.Right.constants RightMap.member ;
 } ;
} ;
