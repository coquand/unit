-- (x+y)*(x+y)-2*x*y = x*x+y*y
module IntegerCoefficients (Rg : CRing) (v_x v_y : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_x Rg.z) v_x = (Rg.addZ v_x) ;
  step1 : Id Rg.R v_x (Rg.add v_x Rg.z) = (sym step0) ;
  step2 : Id Rg.R (Rg.add v_y Rg.z) v_y = (Rg.addZ v_y) ;
  step3 : Id Rg.R v_y (Rg.add v_y Rg.z) = (sym step2) ;
  step4 : Id Rg.R (Rg.add Rg.z (Rg.add v_y Rg.z)) (Rg.add v_y Rg.z) = (RL[Rg].zl (Rg.add v_y Rg.z)) ;
  step5 : Id Rg.R (Rg.add v_x (Rg.add Rg.z (Rg.add v_y Rg.z))) (Rg.add (Rg.add v_x Rg.z) (Rg.add v_y Rg.z)) = (Rg.addA v_x Rg.z (Rg.add v_y Rg.z)) ;
  step6 : Id Rg.R (Rg.add (Rg.add v_x Rg.z) (Rg.add v_y Rg.z)) (Rg.add v_x (Rg.add Rg.z (Rg.add v_y Rg.z))) = (sym step5) ;
  step7 : Id Rg.R (Rg.add v_x (Rg.add Rg.z (Rg.add v_y Rg.z))) (Rg.add v_x (Rg.add v_y Rg.z)) = (cong2 Rg.R Rg.add v_x v_x (Rg.add Rg.z (Rg.add v_y Rg.z)) (Rg.add v_y Rg.z) (refl v_x) step4) ;
  step8 : Id Rg.R (Rg.add (Rg.add v_x Rg.z) (Rg.add v_y Rg.z)) (Rg.add v_x (Rg.add v_y Rg.z)) = (trans step6 step7) ;
  step9 : Id Rg.R (Rg.add v_x v_y) (Rg.add (Rg.add v_x Rg.z) (Rg.add v_y Rg.z)) = (cong2 Rg.R Rg.add v_x (Rg.add v_x Rg.z) v_y (Rg.add v_y Rg.z) step1 step3) ;
  step10 : Id Rg.R (Rg.add v_x v_y) (Rg.add v_x (Rg.add v_y Rg.z)) = (trans step9 step8) ;
  step11 : Id Rg.R (Rg.mul v_x Rg.z) Rg.z = (RL[Rg].mul-zero v_x) ;
  step12 : Id Rg.R (Rg.mul v_x (Rg.add v_y Rg.z)) (Rg.add (Rg.mul v_x v_y) (Rg.mul v_x Rg.z)) = (Rg.dist v_x v_y Rg.z) ;
  step13 : Id Rg.R (Rg.add (Rg.mul v_x v_y) (Rg.mul v_x Rg.z)) (Rg.add (Rg.mul v_x v_y) Rg.z) = (cong2 Rg.R Rg.add (Rg.mul v_x v_y) (Rg.mul v_x v_y) (Rg.mul v_x Rg.z) Rg.z (refl (Rg.mul v_x v_y)) step11) ;
  step14 : Id Rg.R (Rg.mul v_x (Rg.add v_y Rg.z)) (Rg.add (Rg.mul v_x v_y) Rg.z) = (trans step12 step13) ;
  step15 : Id Rg.R (Rg.mul v_x (Rg.add v_x (Rg.add v_y Rg.z))) (Rg.add (Rg.mul v_x v_x) (Rg.mul v_x (Rg.add v_y Rg.z))) = (Rg.dist v_x v_x (Rg.add v_y Rg.z)) ;
  step16 : Id Rg.R (Rg.add (Rg.mul v_x v_x) (Rg.mul v_x (Rg.add v_y Rg.z))) (Rg.add (Rg.mul v_x v_x) (Rg.add (Rg.mul v_x v_y) Rg.z)) = (cong2 Rg.R Rg.add (Rg.mul v_x v_x) (Rg.mul v_x v_x) (Rg.mul v_x (Rg.add v_y Rg.z)) (Rg.add (Rg.mul v_x v_y) Rg.z) (refl (Rg.mul v_x v_x)) step14) ;
  step17 : Id Rg.R (Rg.mul v_x (Rg.add v_x (Rg.add v_y Rg.z))) (Rg.add (Rg.mul v_x v_x) (Rg.add (Rg.mul v_x v_y) Rg.z)) = (trans step15 step16) ;
  step18 : Id Rg.R (Rg.mul v_y v_x) (Rg.mul v_x v_y) = (Rg.mulC v_y v_x) ;
