-- (x-y)*(x+y) = x*x-y*y
module SignedProduct (Rg : CRing) (v_x v_y : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_x Rg.z) v_x = (Rg.addZ v_x) ;
