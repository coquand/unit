  step5 : Id Rg.R (Rg.neg (Rg.add v_x Rg.z)) (Rg.add (Rg.neg v_x) Rg.z) = (trans step3 step4) ;
  step6 : Id Rg.R (Rg.neg v_x) (Rg.neg (Rg.add v_x Rg.z)) = (ap Rg.neg step1) ;
  step7 : Id Rg.R (Rg.neg v_x) (Rg.add (Rg.neg v_x) Rg.z) = (trans step6 step5) ;
