-- (-x)*(-1)+0*(x+1)-(-(-x)) = 0
module NegativesAndUnits (Rg : CRing) (v_x : Rg.R) {
  module N = RL[Rg] ;
  step0 : Id Rg.R (Rg.add v_x Rg.z) v_x = (Rg.addZ v_x) ;
  step1 : Id Rg.R v_x (Rg.add v_x Rg.z) = (sym step0) ;
  step2 : Id Rg.R (Rg.neg Rg.z) Rg.z = (RL[Rg].neg-zero ) ;
