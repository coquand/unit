-- Effective finite equation quotient, with its maps-out construction.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (A : CRing) (m : Nat) (g : Presentations[l].Fin m -> A.R) {
 module I = FiniteGeneratedIdeal[l].Over[A,m,g] ;
 module Q = QuotientRing[l].Over[A,I.ideal,I.prop] ;
 root (i : Presentations[l].Fin m) : Id Q.Carrier (Q.include (g i)) Q.zeroQ = Q.to-zero (g i) (I.generator i) ;
 Representative (x : Q.Carrier) : U l = (a : A.R) * Id Q.Carrier (Q.include a) x ;
 onto (x : Q.Carrier) : Tr.Trunc[Representative x].carrier =
  Q.Q.induction @l (\ x -> Tr.Trunc[Representative x].carrier) (\ x -> Tr.Trunc[Representative x].proposition)
   (\ a -> Tr.Trunc[Representative (Q.include a)].inc (a,refl (Q.include a))) x ;
 module Into (B : CRing) (setB : Pr.isSet B.R) (h : RingHom[l].Hom A B) (hg : (i : Presentations[l].Fin m) -> Id B.R (h.1 (g i)) B.z) {
  module LB = RL[B] ;
  killed (x : A.R) (w : I.Certificate x) : Id B.R (h.1 x) B.z =
   trans (ap h.1 w.2) (trans (FlatRelations[l].MapSums[A,B,h].lin m g w.1)
    (trans (FiniteIdeal[l].Sums[B].sum-cong m
     (\ i -> B.mul (h.1 (g i)) (h.1 (w.1 i))) (\ i -> B.z)
     (\ i -> trans (ap (\ c -> B.mul c (h.1 (w.1 i))) (hg i)) (LB.zero-mul (h.1 (w.1 i)))))
     (FiniteIdeal[l].Sums[B].sum-zero m))) ;
  kill (x : A.R) (hx : I.In x) : Id B.R (h.1 x) B.z =
   TC.rec (I.Certificate x) @l (Id B.R (h.1 x) B.z) (setB _ _) (killed x) hx ;
  respects (x y : A.R) (r : Q.Rel x y) : Id B.R (h.1 x) (h.1 y) =
   FormallyEtale[l].Units[B,setB].sub-zero (h.1 x) (h.1 y)
    (trans (sym (trans (h.2.2.1 x (A.neg y)) (ap (B.add (h.1 x)) (RingHom[l].negation A B h y))))
     (kill (A.add x (A.neg y)) r)) ;
  module D = Q.Q.Descend[B.R,setB,h.1,respects] ;
  map : Q.Carrier -> B.R = D.map ;
  beta (a : A.R) : Id B.R (map (Q.include a)) (h.1 a) = D.beta a ;
  one : Id B.R (map Q.oneQ) B.o = trans (beta A.o) h.2.1 ;
  plus : (x y : Q.Carrier) -> Id B.R (map (Q.addQ x y)) (B.add (map x) (map y)) =
   Q.forall2 (\ x y -> Id B.R (map (Q.addQ x y)) (B.add (map x) (map y))) (\ x y -> setB _ _)
    (\ x y -> trans (ap map (Q.Add.beta x y))
     (trans (beta (A.add x y)) (trans (h.2.2.1 x y)
      (Presentations[l].cong2 B.R B.add _ _ _ _ (sym (beta x)) (sym (beta y)))))) ;
  times : (x y : Q.Carrier) -> Id B.R (map (Q.mulQ x y)) (B.mul (map x) (map y)) =
   Q.forall2 (\ x y -> Id B.R (map (Q.mulQ x y)) (B.mul (map x) (map y))) (\ x y -> setB _ _)
    (\ x y -> trans (ap map (Q.Multiply.beta x y))
     (trans (beta (A.mul x y)) (trans (h.2.2.2 x y)
      (Presentations[l].cong2 B.R B.mul _ _ _ _ (sym (beta x)) (sym (beta y)))))) ;
  hom : RingHom[l].Hom Q.ring B = (map,one,plus,times) ;
  unique (g : RingHom[l].Hom Q.ring B) (agrees : (a : A.R) -> Id B.R (g.1 (Q.include a)) (h.1 a)) :
   (x : Q.Carrier) -> Id B.R (g.1 x) (map x) =
   Q.Q.induction @l (\ x -> Id B.R (g.1 x) (map x)) (\ x -> setB _ _)
    (\ a -> trans (agrees a) (sym (beta a))) ;
 } ;
} ;
