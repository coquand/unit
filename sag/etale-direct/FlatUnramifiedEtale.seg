-- The unconditional arbitrary-base endpoint. Finite presentation,
-- R-flatness and uniqueness of square-zero lifting imply existence.
-- No field hypothesis, prime existence, choice, ZMT or local theorem.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module E = FormallyEtale[l].Over[R,setR] ;
 module At (T : C.Algebra) (fp : P.FP T) (unramified : E.Unique T)
  (flat : FlatRelations[l].Over[R,T.ring,T.iota].Flat) {
  module Source = UnramifiedEtaleSource[l].Over[R,setR,T] ;
  module Given (s : Source.Source) {
   source-fp : P.FP s.algebra = Truncation[l+].Trunc[P.Witness s.algebra].inc s.etale.2 ;
   relative-flat : FlatRelations[l].Over[s.algebra.ring,T.ring,s.map.1].Flat =
    FlatDiagonalTransfer[l].Over[R,setR].At[s.algebra,T,s.map,source-fp,s.etale.1.2,flat].theorem ;
   lift : E.Lift T = FlatQuotientLift[l].Over[R,setR].At[s.algebra,T,s.map,s.onto,relative-flat,s.etale.1.1].lift ;
  } ;
  module Problem (B : C.Algebra) (N : E.SquareZero[B]) (g : C.Hom T E.Mod[B,N].algebra) {
   Lift : U l = (h : C.Hom T B) * Id (C.Hom T E.Mod[B,N].algebra) (E.reduce T B N h) g ;
   proposition : Pr.isProp Lift = \ h k -> Pr.Sigma-eq (C.Hom T B)
    (\ h -> Id (C.Hom T E.Mod[B,N].algebra) (E.reduce T B N h) g) h.1 k.1 h.2 k.2
    (unramified B N h.1 k.1 (trans h.2 (sym k.2)))
    (StandardEtaleLift[l].Over[R,setR].hom-set T E.Mod[B,N].algebra _ _) ;
   theorem : Lift = Truncation[l+].Trunc[Source.Source].induction @l (\ s -> Lift) (\ s -> proposition)
    (\ s -> Given[s].lift B N g) (Source.theorem fp unramified) ;
  } ;
  lift : E.Lift T = \ B N g -> Problem[B,N,g].theorem ;
  formally-etale : E.FormallyEtale T = (lift,unramified) ;
  etale : Truncation[l+].Trunc[E.Etale T].carrier =
   Truncation[l+].Trunc[P.Witness T].induction @(l+) (\ p -> Truncation[l+].Trunc[E.Etale T].carrier)
    (\ p -> Truncation[l+].Trunc[E.Etale T].proposition)
    (\ p -> Truncation[l+].Trunc[E.Etale T].inc (formally-etale,p)) fp ;
 } ;
 module Presented (T : C.Algebra) (presentation : P.Witness T) (unramified : E.Unique T)
  (flat : FlatRelations[l].Over[R,T.ring,T.iota].Flat) {
  module Result = At[T,Truncation[l+].Trunc[P.Witness T].inc presentation,unramified,flat] ;
  theorem : E.Etale T = (Result.formally-etale,presentation) ;
 } ;
} ;
