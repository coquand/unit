-- Finite expression families, naturality of gradients and determinants.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DeltaMap (A B : CRing) (h : H.Hom A B) {
 module DA = MnSums[l].Over[A] ; module DB = MnSums[l].Over[B] ;
 theorem : (n : Nat) (i j : Fin n) -> Id B.R (h.1 (DA.delta n i j)) (DB.delta n i j) = split {
  zero -> \ i j -> H.zero A B h ;
  suc n | rec -> split {
   inl i -> split { inl j -> rec i j ; inr t -> H.zero A B h } ;
   inr t -> split { inl j -> H.zero A B h ; inr u -> h.2.1 } } } ;
} ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module J = ExpressionJets[l].Over[R,setR] ;
 family (V : U l) : (m : Nat) -> (Fin m -> P.Expr V) -> P.Equations V = split {
  zero -> \ f -> nil ; suc m | rec -> \ f -> cons (f (inr tt)) (rec (\ i -> f (inl i))) } ;
 zeros-family (V : U l) (B : C.Algebra) (a : V -> B.ring.R) :
  (m : Nat) (f : Fin m -> P.Expr V) -> ((i : Fin m) -> Id B.ring.R (P.eval V B a (f i)) B.ring.z) ->
  P.Zeros V B a (family V m f) = split {
  zero -> \ f h -> tt ; suc m | rec -> \ f h -> (h (inr tt),rec (\ i -> f (inl i)) (\ i -> h (inl i))) } ;
 family-zeros (V : U l) (B : C.Algebra) (a : V -> B.ring.R) :
  (m : Nat) (f : Fin m -> P.Expr V) -> P.Zeros V B a (family V m f) ->
  (i : Fin m) -> Id B.ring.R (P.eval V B a (f i)) B.ring.z = split {
  zero -> \ f h i -> efq i ; suc m | rec -> \ f h ->
   AffineFinite[l].section m (\ i -> Id B.ring.R (P.eval V B a (f i)) B.ring.z)
    (rec (\ i -> f (inl i)) h.2) h.1 } ;
 sum (V : U l) : (m : Nat) -> (Fin m -> P.Expr V) -> P.Expr V = split {
  zero -> \ f -> cst R.z ; suc m | rec -> \ f -> sumE (f (inr tt)) (rec (\ i -> f (inl i))) } ;
 eval-sum (V : U l) (B : C.Algebra) (a : V -> B.ring.R) :
  (m : Nat) (f : Fin m -> P.Expr V) -> Id B.ring.R (P.eval V B a (sum V m f))
   (FiniteIdeal[l].Sums[B.ring].sum m (\ i -> P.eval V B a (f i))) = split {
   zero -> \ f -> H.zero R B.ring B.iota ;
   suc m | rec -> \ f -> ap (B.ring.add (P.eval V B a (f (inr tt)))) (rec (\ i -> f (inl i))) } ;
 derivative-sum (V : U l) (B : C.Algebra) (a v : V -> B.ring.R) :
  (m : Nat) (f : Fin m -> P.Expr V) -> Id B.ring.R (J.At[V,B,a].derivative v (sum V m f))
   (FiniteIdeal[l].Sums[B.ring].sum m (\ i -> J.At[V,B,a].derivative v (f i))) = split {
   zero -> \ f -> refl B.ring.z ;
   suc m | rec -> \ f -> ap (B.ring.add (J.At[V,B,a].derivative v (f (inr tt)))) (rec (\ i -> f (inl i))) } ;
 module Natural (n : Nat) (A B : C.Algebra) (h : C.Hom A B)
  (a : Fin n -> A.ring.R) (b : Fin n -> B.ring.R)
  (hb : (i : Fin n) -> Id B.ring.R (h.1.1 (a i)) (b i)) {
  module X = J.Finite[n,A,a] ; module Y = J.Finite[n,B,b] ;
  module DA = MnSums[l].Over[A.ring] ; module DB = MnSums[l].Over[B.ring] ;
  partial (e : P.Expr (Fin n)) (i : Fin n) :
   Id B.ring.R (h.1.1 (X.partial e i)) (Y.partial e i) =
   trans (J.Natural[Fin n,A,B,h,a,DA.delta n i].theorem e)
    (trans (ap (\ w -> J.At[Fin n,B,\ j -> h.1.1 (a j)].derivative w e)
     (FE.funext (Fin n) (\ j -> B.ring.R) (\ j -> h.1.1 (DA.delta n i j)) (DB.delta n i) (DeltaMap[A.ring,B.ring,h.1].theorem n i)))
     (ap (\ c -> J.At[Fin n,B,c].derivative (DB.delta n i) e)
      (FE.funext (Fin n) (\ j -> B.ring.R) (\ j -> h.1.1 (a j)) b hb))) ;
  determinant (f : Fin n -> P.Expr (Fin n)) :
   Id B.ring.R (h.1.1 (ExteriorModel[l].Over[A.ring].det n (\ j i -> X.partial (f i) j)))
    (ExteriorModel[l].Over[B.ring].det n (\ j i -> Y.partial (f i) j)) =
   trans (Naturality[l].Over[A.ring,B.ring,h.1].det-nat n (\ j i -> X.partial (f i) j))
    (ap (ExteriorModel[l].Over[B.ring].det n)
     (FE.funext (Fin n) (\ j -> Fin n -> B.ring.R) _ _
      (\ j -> FE.funext (Fin n) (\ i -> B.ring.R) _ _ (\ i -> partial (f i) j)))) ;
 } ;
} ;
module LinearSolve (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (M : Determinant[l].Over[R,setR].Mat n)
 (unit : RL[R].unit (ExteriorModel[l].Over[R].det n M)) {
 module D = Determinant[l].Over[R,setR] ; module A = RightAdjugate[l].Over[R,setR].At[n,M] ;
 module L = RL[R] ; module T = DeterminantTrick[l].Over[R,setR] ;
 solution (v : Fin n -> R.R) (i : Fin n) : R.R = R.mul unit.1 (D.act n A.right v i) ;
 solves (v : Fin n -> R.R) (i : Fin n) : Id R.R (D.act n M (solution v) i) (v i) =
  trans (D.act-scale n M unit.1 (D.act n A.right v) i)
   (trans (ap (R.mul unit.1) (A.action v i))
    (trans (R.mulA unit.1 (ExteriorModel[l].Over[R].det n M) (v i))
     (trans (ap (\ a -> R.mul a (v i)) (trans (R.mulC unit.1 (ExteriorModel[l].Over[R].det n M)) unit.2)) (L.one-left (v i))))) ;
 injective-zero (v : Fin n -> R.R) (hv : (i : Fin n) -> Id R.R (D.act n M v i) R.z) (i : Fin n) : Id R.R (v i) R.z =
  calc R.R { v i =< sym (L.one-left (v i)) > R.mul R.o (v i)
   =< ap (\ a -> R.mul a (v i)) (sym (trans (R.mulC unit.1 (ExteriorModel[l].Over[R].det n M)) unit.2)) > R.mul (R.mul unit.1 (ExteriorModel[l].Over[R].det n M)) (v i)
   =< sym (R.mulA unit.1 (ExteriorModel[l].Over[R].det n M) (v i)) > R.mul unit.1 (R.mul (ExteriorModel[l].Over[R].det n M) (v i))
   =< ap (R.mul unit.1) (T.trick n M v hv i) > R.mul unit.1 R.z
   =< L.mul-zero unit.1 > R.z } ;
 module Ideal (I : RegularIdeal[l].IdealPred[R]) (v : Fin n -> R.R) (hv : (i : Fin n) -> I.In (v i)) {
  sum-in : (m : Nat) (a : Fin m -> R.R) -> ((i : Fin m) -> I.In (a i)) -> I.In (FiniteIdeal[l].Sums[R].sum m a) = split {
   zero -> \ a h -> I.in-zero ; suc m | rec -> \ a h -> I.in-add _ _ (h (inr tt)) (rec (\ i -> a (inl i)) (\ i -> h (inl i))) } ;
  theorem (i : Fin n) : I.In (solution v i) = I.in-mul unit.1 _
   (sum-in n (\ j -> R.mul (v j) (A.right j i))
    (\ j -> subst I.In (R.mulC (A.right j i) (v j)) (I.in-mul (A.right j i) (v j) (hv j)))) ;
 } ;
} ;
