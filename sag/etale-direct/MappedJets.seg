level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (R K : CRing) (setR : Pr.isSet R.R) (setK : Pr.isSet K.R) (rho : RingHom[l].Hom R K) {
 module M = MappedPresentation[l].Over[R,K,setR,setK,rho] ;
 module At (V : U l) (B : M.CK.Algebra) (a v : V -> B.ring.R) {
  module X = ExpressionJets[l].Over[K,setK].At[V,B,a] ;
  module Y = ExpressionJets[l].Over[R,setR].At[V,M.restrict B,a] ;
  theorem : (e : M.PR.Expr V) -> Id B.ring.R (X.derivative v (M.expression V e)) (Y.derivative v e) = split {
   var i -> refl (v i) ; cst r -> refl B.ring.z ;
   sumE e f | de df -> cong2 B.ring.R B.ring.add _ _ _ _ de df ;
   mulE e f | de df -> cong2 B.ring.R B.ring.add _ _ _ _
    (cong2 B.ring.R B.ring.mul _ _ _ _ (M.value V B a e) df)
    (cong2 B.ring.R B.ring.mul _ _ _ _ de (M.value V B a f)) } ;
 } ;
} ;
