-- First directional derivatives of finite polynomial expressions.
-- All variable sets are allowed; finite gradients are obtained by linearity.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module At (V : U l) (B : C.Algebra) (a : V -> B.ring.R) {
  module L = RL[B.ring] ; module S = FiniteIdeal[l].Sums[B.ring] ;
  value : P.Expr V -> B.ring.R = P.eval V B a ;
  derivative (v : V -> B.ring.R) : P.Expr V -> B.ring.R = split {
   var i -> v i ; cst r -> B.ring.z ;
   sumE e f | de df -> B.ring.add de df ;
   mulE e f | de df -> B.ring.add (B.ring.mul (value e) df) (B.ring.mul de (value f)) } ;
  add (v w : V -> B.ring.R) : (e : P.Expr V) ->
   Id B.ring.R (derivative (\ i -> B.ring.add (v i) (w i)) e)
    (B.ring.add (derivative v e) (derivative w e)) = split {
   var i -> refl (B.ring.add (v i) (w i)) ; cst r -> sym (B.ring.addZ B.ring.z) ;
   sumE e f | de df -> trans (cong2 B.ring.R B.ring.add _ _ _ _ de df)
    (L.swap (derivative v e) (derivative w e) (derivative v f) (derivative w f)) ;
   mulE e f | de df -> trans (cong2 B.ring.R B.ring.add _ _ _ _
    (trans (ap (B.ring.mul (value e)) df) (B.ring.dist (value e) (derivative v f) (derivative w f)))
    (trans (ap (\ d -> B.ring.mul d (value f)) de) (L.dist-left (derivative v e) (derivative w e) (value f))))
    (L.swap (B.ring.mul (value e) (derivative v f)) (B.ring.mul (value e) (derivative w f))
     (B.ring.mul (derivative v e) (value f)) (B.ring.mul (derivative w e) (value f))) } ;
  scale (c : B.ring.R) (v : V -> B.ring.R) : (e : P.Expr V) ->
   Id B.ring.R (derivative (\ i -> B.ring.mul c (v i)) e) (B.ring.mul c (derivative v e)) = split {
   var i -> refl (B.ring.mul c (v i)) ; cst r -> sym (L.mul-zero c) ;
   sumE e f | de df -> trans (cong2 B.ring.R B.ring.add _ _ _ _ de df)
    (sym (B.ring.dist c (derivative v e) (derivative v f))) ;
   mulE e f | de df -> trans (cong2 B.ring.R B.ring.add _ _ _ _
    (trans (ap (B.ring.mul (value e)) df) (L.mul-swap (value e) c (derivative v f)))
    (trans (ap (\ d -> B.ring.mul d (value f)) de) (sym (B.ring.mulA c (derivative v e) (value f)))))
    (sym (B.ring.dist c (B.ring.mul (value e) (derivative v f)) (B.ring.mul (derivative v e) (value f)))) } ;
  module Ideal (I : RegularIdeal[l].IdealPred[B.ring]) (v : V -> B.ring.R)
   (hv : (i : V) -> I.In (v i)) {
   in-ideal : (e : P.Expr V) -> I.In (derivative v e) = split {
    var i -> hv i ; cst r -> I.in-zero ;
    sumE e f | de df -> I.in-add _ _ de df ;
    mulE e f | de df -> I.in-add _ _ (I.in-mul (value e) _ df)
     (subst I.In (B.ring.mulC (value f) (derivative v e)) (I.in-mul (value f) _ de)) } ;
  } ;
  module Taylor (N : FormallyEtale[l].Over[R,setR].SquareZero[B])
   (v : V -> B.ring.R) (hv : (i : V) -> N.ideal.In (v i)) {
   module I = Ideal[N.ideal,v,hv] ;
   shifted : P.Expr V -> B.ring.R = P.eval V B (\ i -> B.ring.add (a i) (v i)) ;
   product (x dx y dy : B.ring.R) (h : Id B.ring.R (B.ring.mul dx dy) B.ring.z) :
    Id B.ring.R (B.ring.mul (B.ring.add x dx) (B.ring.add y dy))
     (B.ring.add (B.ring.mul x y) (B.ring.add (B.ring.mul x dy) (B.ring.mul dx y))) =
    trans (L.dist-left x dx (B.ring.add y dy))
     (trans (cong2 B.ring.R B.ring.add _ _ _ _ (B.ring.dist x y dy)
      (trans (B.ring.dist dx y dy) (trans (ap (B.ring.add (B.ring.mul dx y)) h) (B.ring.addZ (B.ring.mul dx y)))))
      (sym (B.ring.addA (B.ring.mul x y) (B.ring.mul x dy) (B.ring.mul dx y)))) ;
   theorem : (e : P.Expr V) -> Id B.ring.R (shifted e) (B.ring.add (value e) (derivative v e)) = split {
    var i -> refl (B.ring.add (a i) (v i)) ; cst r -> sym (B.ring.addZ (B.iota.1 r)) ;
    sumE e f | de df -> trans (cong2 B.ring.R B.ring.add _ _ _ _ de df)
     (L.swap (value e) (derivative v e) (value f) (derivative v f)) ;
    mulE e f | de df -> trans (cong2 B.ring.R B.ring.mul _ _ _ _ de df)
     (product (value e) (derivative v e) (value f) (derivative v f)
      (N.square _ _ (I.in-ideal e) (I.in-ideal f))) } ;
  } ;
 } ;
 module Natural (V : U l) (A B : C.Algebra) (h : C.Hom A B) (a v : V -> A.ring.R) {
  module X = At[V,A,a] ; module Y = At[V,B,\ i -> h.1.1 (a i)] ;
  theorem : (e : P.Expr V) -> Id B.ring.R (h.1.1 (X.derivative v e))
   (Y.derivative (\ i -> h.1.1 (v i)) e) = split {
   var i -> refl (h.1.1 (v i)) ; cst r -> H.zero A.ring B.ring h.1 ;
   sumE e f | de df -> trans (h.1.2.2.1 (X.derivative v e) (X.derivative v f)) (cong2 B.ring.R B.ring.add _ _ _ _ de df) ;
   mulE e f | de df -> trans (h.1.2.2.1 (A.ring.mul (X.value e) (X.derivative v f)) (A.ring.mul (X.derivative v e) (X.value f)))
    (cong2 B.ring.R B.ring.add _ _ _ _
     (trans (h.1.2.2.2 (X.value e) (X.derivative v f)) (cong2 B.ring.R B.ring.mul _ _ _ _ (P.natural V A B h a e) df))
     (trans (h.1.2.2.2 (X.derivative v e) (X.value f)) (cong2 B.ring.R B.ring.mul _ _ _ _ de (P.natural V A B h a f)))) } ;
 } ;
 module Finite (n : Nat) (B : C.Algebra) (a : Fin n -> B.ring.R) {
  module X = At[Fin n,B,a] ; module D = MnSums[l].Over[B.ring] ;
  module Adj = Adjugate[l].Over[B.ring,B.set] ;
  partial (e : P.Expr (Fin n)) (i : Fin n) : B.ring.R = X.derivative (D.delta n i) e ;
  expand (v : Fin n -> B.ring.R) (e : P.Expr (Fin n)) :
   Id B.ring.R (X.derivative v e) (FiniteIdeal[l].Sums[B.ring].lin n v (partial e)) =
   Adj.form-expand n (\ w -> X.derivative w e)
    ((\ w z -> X.add w z e),\ c w -> X.scale c w e) v ;
 } ;
} ;
