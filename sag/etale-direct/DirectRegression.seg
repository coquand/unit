-- End-to-end and arithmetic regressions for the direct theorem.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ;
module AtPoint (R : CRing) (setR : Pr.isSet R.R) (a : R.R) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 one : Nat = suc zero ;
 equation : P.Expr (Fin one) = sumE (var (inr tt)) (cst (R.neg a)) ;
 presentation : P.Presentation = (one,cons equation nil) ;
 solution : P.Solutions presentation C.base = (\ i -> a,R.addN a,tt) ;
 module To (B : C.Algebra) {
  arrow : C.Hom C.base B = (B.iota,\ r -> refl (B.iota.1 r)) ;
  extend (s : P.Solutions presentation B) : C.Hom C.base B = arrow ;
  root (s : P.Solutions presentation B) : Id B.ring.R (s.1 (inr tt)) (B.iota.1 a) =
   FormallyEtale[l].Units[B.ring,B.set].sub-zero (s.1 (inr tt)) (B.iota.1 a)
    (trans (ap (B.ring.add (s.1 (inr tt))) (sym (H.negation R B.ring B.iota a))) s.2.1) ;
  fb (s : P.Solutions presentation B) :
   Id (P.Solutions presentation B) (P.canonical presentation C.base solution B (extend s)) s =
   P.solutions-ext presentation B _ _
    (AffineFinite[l].section zero (\ i -> Id B.ring.R (B.iota.1 a) (s.1 i)) (\ i -> efq i) (sym (root s))) ;
  bf (f : C.Hom C.base B) :
   Id (C.Hom C.base B) (extend (P.canonical presentation C.base solution B f)) f =
   C.ext C.base B _ _ (\ r -> sym (f.2 r)) ;
  universal : Pr.isEquiv (C.Hom C.base B) (P.Solutions presentation B) (P.canonical presentation C.base solution B) =
   Pr.qinv _ _ (P.canonical presentation C.base solution B) extend fb bf ;
 } ;
 presents : P.Presents presentation C.base = (solution,\ B -> To[B].universal) ;
} ;
module Empty (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module E = FormallyEtale[l].Over[R,setR] ;
 module P = Presentations[l].Over[R,setR] ;
 presentation : P.Witness C.base = ((zero,nil),FlatQuotientPresentation[l].Over[R,setR].base-presentation) ;
 unique : E.Unique C.base = \ B N h k same -> C.ext C.base B h k (\ r -> trans (h.2 r) (sym (k.2 r))) ;
 theorem : E.Etale C.base = FlatUnramifiedEtale[l].Over[R,setR].Presented[C.base,presentation,unique,FlatRelations[l].Self[R].flat].theorem ;
} ;
module Point (R : CRing) (setR : Pr.isSet R.R) (a : R.R) {
 module Q = AtPoint[R,setR,a] ; module E = Empty[R,setR] ;
 theorem : E.E.Etale Q.C.base = FlatUnramifiedEtale[l].Over[R,setR].Presented
  [Q.C.base,(Q.presentation,Q.presents),E.unique,FlatRelations[l].Self[R].flat].theorem ;
 -- Keep redundant equations, including the zero polynomial. The
 -- extracted Jacobian inverse is rectangular (one variable, three rows).
 redundant : Q.P.Presentation = (Q.one,cons Q.equation (cons (mulE (cst (R.add R.o R.o)) Q.equation) (cons (cst R.z) nil))) ;
 solution : Q.P.Solutions redundant Q.C.base =
  (\ i -> a,R.addN a,trans (ap (R.mul (R.add R.o R.o)) (R.addN a)) (RL[R].mul-zero _),refl R.z,tt) ;
 module To (B : Q.C.Algebra) {
  forward : Q.C.Hom Q.C.base B -> Q.P.Solutions redundant B = Q.P.canonical redundant Q.C.base solution B ;
  extend (s : Q.P.Solutions redundant B) : Q.C.Hom Q.C.base B = Q.To[B].arrow ;
  fb (s : Q.P.Solutions redundant B) : Id (Q.P.Solutions redundant B) (forward (extend s)) s =
   Q.P.solutions-ext redundant B _ _ (AffineFinite[l].section zero
    (\ i -> Id B.ring.R (B.iota.1 a) (s.1 i)) (\ i -> efq i) (sym (Q.To[B].root (s.1,s.2.1,tt)))) ;
  bf (h : Q.C.Hom Q.C.base B) : Id (Q.C.Hom Q.C.base B) (extend (forward h)) h = Q.C.ext Q.C.base B _ _ (\ r -> sym (h.2 r)) ;
  equivalence : Pr.isEquiv (Q.C.Hom Q.C.base B) (Q.P.Solutions redundant B) forward = Pr.qinv _ _ forward extend fb bf ;
 } ;
 presents : Q.P.Presents redundant Q.C.base = (solution,\ B -> To[B].equivalence) ;
 redundant-theorem : E.E.Etale Q.C.base = FlatUnramifiedEtale[l].Over[R,setR].Presented
  [Q.C.base,(redundant,presents),E.unique,FlatRelations[l].Self[R].flat].theorem ;
} ;
module Localised (R : CRing) (setR : Pr.isSet R.R) (t : R.R) {
 module B = Empty[R,setR] ; module C = B.C ; module P = B.P ; module E = B.E ;
 module L = Localization[l].Over[R,setR,C.base,B.presentation.1,B.presentation.2,t,cst t,refl t] ;
 unique : E.Unique L.algebra = \ A N h k same ->
  Equivalences[l].injective (C.Hom L.algebra A) L.To[A].Data L.Canonical[A].map L.Canonical[A].universal h k
   (L.To[A].data-ext _ _ (C.ext C.base A _ _
    (\ r -> trans (h.2 r) (sym (k.2 r))))) ;
 flat : FlatRelations[l].Over[R,L.algebra.ring,L.algebra.iota].Flat =
  FlatPresentedLocalization[l].Over[R,setR,C.base,B.presentation.1,B.presentation.2,t,cst t,refl t,FlatRelations[l].Self[R].flat].theorem ;
 theorem : E.Etale L.algebra = FlatUnramifiedEtale[l].Over[R,setR].Presented
  [L.algebra,(L.pres,L.K.presentation),unique,flat].theorem ;
} ;
module Z = ZMod4[l] ;
module NonreducedEmpty = Empty[Z.ring,Z.set] ;
module NonreducedPoint = Point[Z.ring,Z.set,q2] ;
module UnitLocalisation = Localised[Z.ring,Z.set,q1] ;
module NilpotentLocalisation = Localised[Z.ring,Z.set,q2] ;
nonreduced : NonreducedEmpty.E.Etale NonreducedEmpty.C.base = NonreducedPoint.redundant-theorem ;
unit-localisation : NonreducedEmpty.E.Etale UnitLocalisation.L.algebra = UnitLocalisation.theorem ;
nilpotent-localisation : NonreducedEmpty.E.Etale NilpotentLocalisation.L.algebra = NilpotentLocalisation.theorem ;

-- A nonsymmetric two-variable Jacobian detects transposition mistakes.
module TwoVariables {
 module C = Algebras[l].Over[Z.ring,Z.set] ; module P = Presentations[l].Over[Z.ring,Z.set] ;
 two : Nat = suc (suc zero) ; first : Fin two = inl (inr tt) ; second : Fin two = inr tt ;
 equations : Fin two -> P.Expr (Fin two) = split {
  inl i -> sumE (var first) (var second) ; inr t -> var second } ;
 module J = ExpressionJets[l].Over[Z.ring,Z.set].Finite[two,C.base,\ i -> q0] ;
 matrix (j i : Fin two) : Z.ring.R = J.partial (equations i) j ;
 upper : Id Z.ring.R (matrix second first) q1 = refl q1 ;
 lower : Id Z.ring.R (matrix first second) q0 = refl q0 ;
 determinant : Id Z.ring.R (ExteriorModel[l].Over[Z.ring].det two matrix) q1 = refl q1 ;
 module Solve = JacobianTools[l].LinearSolve[Z.ring,Z.set,two,matrix,(q1,refl q1)] ;
 rhs : Fin two -> Z.ring.R = split { inl i -> q0 ; inr t -> q1 } ;
 second-action : Id Z.ring.R (Determinant[l].Over[Z.ring,Z.set].act two matrix (Solve.solution rhs) second) (Solve.solution rhs second) =
  trans (cong2 Z.ring.R Z.ring.add _ _ _ _ (Z.ring.mulO (Solve.solution rhs second))
   (trans (ap (\ a -> Z.ring.add a q0) (RL[Z.ring].mul-zero (Solve.solution rhs first))) (Z.ring.addZ q0)))
   (Z.ring.addZ (Solve.solution rhs second)) ;
 second-value : Id Z.ring.R (Solve.solution rhs second) q1 = trans (sym second-action) (Solve.solves rhs second) ;
 first-action : Id Z.ring.R (Determinant[l].Over[Z.ring,Z.set].act two matrix (Solve.solution rhs) first)
  (Z.ring.add q1 (Solve.solution rhs first)) =
  cong2 Z.ring.R Z.ring.add _ _ _ _ (trans (Z.ring.mulO (Solve.solution rhs second)) second-value)
   (trans (ap (\ a -> Z.ring.add a q0) (Z.ring.mulO (Solve.solution rhs first))) (Z.ring.addZ (Solve.solution rhs first))) ;
 first-value : Id Z.ring.R (Solve.solution rhs first) q3 =
  RL[Z.ring].neg-uniq q1 (Solve.solution rhs first) (trans (sym first-action) (Solve.solves rhs first)) ;
 equation-first : Id Z.ring.R (Determinant[l].Over[Z.ring,Z.set].act two matrix (Solve.solution rhs) first) q0 = Solve.solves rhs first ;
 equation-second : Id Z.ring.R (Determinant[l].Over[Z.ring,Z.set].act two matrix (Solve.solution rhs) second) q1 = Solve.solves rhs second ;
} ;
