-- Every finitely presented formally unramified algebra is a quotient of
-- a constructed multivariable Jacobian etale algebra. No flatness here.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ; module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (E : Algebras[l].Over[R,setR].Algebra) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module FE = FormallyEtale[l].Over[R,setR] ; module Tools = JacobianTools[l].Over[R,setR] ;
 record Source {
  algebra : C.Algebra ;
  etale : FE.Etale algebra ;
  map : C.Hom algebra E ;
  onto (e : E.ring.R) : Tr.Trunc[(s : algebra.ring.R) * Id E.ring.R (map.1.1 s) e].carrier ;
 } ;
 module Presented (p : P.Presentation) (pe : P.Presents p E) (unique : FE.Unique E) {
  module DJ = DiagonalJacobian[l].Over[R,setR,E,p,pe] ;
  module Gen = Generated[l].Over[R,setR].Generated[p,E,pe] ;
  module ES = FiniteIdeal[l].Sums[E.ring] ; module EL = RL[E.ring] ;
  module From (w : DJ.Witness) {
   Representatives : U l = (i : Fin p.1) (j : Fin DJ.m) -> Generated[l].Over[R,setR].Representation p E pe (w.coefficient i j) ;
   module Chosen (reps : Representatives) {
    equation (i : Fin p.1) : P.Expr (Fin p.1) =
     Tools.sum (Fin p.1) DJ.m (\ j -> mulE (reps i j).1 (DJ.equation j)) ;
    old-root (j : Fin DJ.m) : Id E.ring.R (P.eval (Fin p.1) E pe.1.1 (DJ.equation j)) E.ring.z =
     PresentationKernel[l].Over[R,setR].zeros-indexed (Fin p.1) E pe.1.1 p.2 pe.1.2 j ;
    root (i : Fin p.1) : Id E.ring.R (P.eval (Fin p.1) E pe.1.1 (equation i)) E.ring.z =
     trans (Tools.eval-sum (Fin p.1) E pe.1.1 DJ.m (\ j -> mulE (reps i j).1 (DJ.equation j)))
      (trans (ES.sum-cong DJ.m
       (\ j -> E.ring.mul (P.eval (Fin p.1) E pe.1.1 (reps i j).1) (P.eval (Fin p.1) E pe.1.1 (DJ.equation j)))
       (\ j -> E.ring.z)
       (\ j -> trans (ap (E.ring.mul (P.eval (Fin p.1) E pe.1.1 (reps i j).1)) (old-root j))
        (EL.mul-zero (P.eval (Fin p.1) E pe.1.1 (reps i j).1)))) (ES.sum-zero DJ.m)) ;
    module JE = ExpressionJets[l].Over[R,setR].Finite[p.1,E,pe.1.1] ;
    jacobian (i k : Fin p.1) : Id E.ring.R (JE.partial (equation i) k) (MnSums[l].Over[E.ring].delta p.1 k i) =
     trans (Tools.derivative-sum (Fin p.1) E pe.1.1 (MnSums[l].Over[E.ring].delta p.1 k) DJ.m
      (\ j -> mulE (reps i j).1 (DJ.equation j)))
      (trans (ES.sum-cong DJ.m
       (\ j -> E.ring.add
        (E.ring.mul (P.eval (Fin p.1) E pe.1.1 (reps i j).1) (JE.partial (DJ.equation j) k))
        (E.ring.mul (JE.partial (reps i j).1 k) (P.eval (Fin p.1) E pe.1.1 (DJ.equation j))))
       (\ j -> E.ring.mul (w.coefficient i j) (JE.partial (DJ.equation j) k))
       (\ j -> trans (cong2 E.ring.R E.ring.add _ _ _ _
        (ap (\ a -> E.ring.mul a (JE.partial (DJ.equation j) k)) (reps i j).2)
        (trans (ap (E.ring.mul (JE.partial (reps i j).1 k)) (old-root j)) (EL.mul-zero (JE.partial (reps i j).1 k))))
        (E.ring.addZ (E.ring.mul (w.coefficient i j) (JE.partial (DJ.equation j) k))))) (w.identity i k)) ;
    module JL = JacobianLifting[l].Over[R,setR,p.1,equation] ;
    module Model = PresentationExistence[l].Over[R,setR,JL.pres] ;
    A : C.Algebra = Model.A.algebra ;
    pa : P.Presents JL.pres A = Model.presentation ;
    solution : P.Solutions JL.pres E = (pe.1.1,Tools.zeros-family (Fin p.1) E pe.1.1 p.1 equation root) ;
    old : C.Hom A E = (pa.2 E).sec solution ;
    old-gen (i : Fin p.1) : Id E.ring.R (old.1.1 (pa.1.1 i)) (pe.1.1 i) = ap (\ s -> s.1 i) ((pa.2 E).sec-eq solution) ;
    module SourceAt = JL.At[A,pa] ;
    determinant-one : Id E.ring.R (old.1.1 SourceAt.delta) E.ring.o =
     trans (Tools.Natural[p.1,A,E,old,pa.1.1,pe.1.1,old-gen].determinant equation)
      (trans (ap (ExteriorModel[l].Over[E.ring].det p.1)
       (F.funext (Fin p.1) (\ j -> Fin p.1 -> E.ring.R) _ _
        (\ j -> F.funext (Fin p.1) (\ i -> E.ring.R) _ _ (\ i -> jacobian i j))))
       (Determinant[l].Over[E.ring,E.set].det-id p.1)) ;
    module Localised (rep : Generated[l].Over[R,setR].Representation JL.pres A pa SourceAt.delta) {
     module Chart = SourceAt.Chart[rep.1,rep.2] ;
     unit : RL[E.ring].unit (old.1.1 SourceAt.delta) = (E.ring.o,trans (E.ring.mulO _) determinant-one) ;
     map : C.Hom Chart.S E = Chart.Loc.Canonical[E].universal.sec (old,unit) ;
     map-gen (i : Fin p.1) : Id E.ring.R (map.1.1 (Chart.generators i)) (pe.1.1 i) =
      trans (ap (\ d -> d.1.1.1 (pa.1.1 i)) (Chart.Loc.Canonical[E].universal.sec-eq (old,unit))) (old-gen i) ;
     onto (e : E.ring.R) : Tr.Trunc[(s : Chart.S.ring.R) * Id E.ring.R (map.1.1 s) e].carrier =
      TC.map (Generated[l].Over[R,setR].Representation p E pe e)
       ((s : Chart.S.ring.R) * Id E.ring.R (map.1.1 s) e)
       (\ r -> (P.eval (Fin p.1) Chart.S Chart.generators r.1,
        trans (P.natural (Fin p.1) Chart.S E map Chart.generators r.1)
         (trans (Generated[l].Over[R,setR].eval-ext (Fin p.1) E
          (\ i -> map.1.1 (Chart.generators i)) pe.1.1 map-gen r.1) r.2))) (Gen.generated e) ;
     result : Source = new Source[Chart.S,Chart.etale,map,onto] ;
    } ;
    result : Truncation[l+].Trunc[Source].carrier =
     Tr.Trunc[Generated[l].Over[R,setR].Representation JL.pres A pa SourceAt.delta].induction @(l+)
      (\ r -> Truncation[l+].Trunc[Source].carrier) (\ r -> Truncation[l+].Trunc[Source].proposition)
      (\ r -> Truncation[l+].Trunc[Source].inc Localised[r].result)
      (Generated[l].Over[R,setR].Generated[JL.pres,A,pa].generated SourceAt.delta) ;
   } ;
   representatives : Tr.Trunc[Representatives].carrier = AffineFinite[l].choice p.1
    (\ i -> (j : Fin DJ.m) -> Generated[l].Over[R,setR].Representation p E pe (w.coefficient i j))
    (\ i -> Gen.generated-family DJ.m (w.coefficient i)) ;
   result : Truncation[l+].Trunc[Source].carrier = Tr.Trunc[Representatives].induction @(l+)
    (\ r -> Truncation[l+].Trunc[Source].carrier) (\ r -> Truncation[l+].Trunc[Source].proposition)
    (\ r -> Chosen[r].result) representatives ;
  } ;
  theorem : Truncation[l+].Trunc[Source].carrier = Tr.Trunc[DJ.Witness].induction @(l+)
   (\ w -> Truncation[l+].Trunc[Source].carrier) (\ w -> Truncation[l+].Trunc[Source].proposition)
   (\ w -> From[w].result) DJ.Unramified[unique].theorem ;
 } ;
 theorem (fp : P.FP E) (unique : FE.Unique E) : Truncation[l+].Trunc[Source].carrier =
  Truncation[l+].Trunc[P.Witness E].induction @(l+) (\ p -> Truncation[l+].Trunc[Source].carrier)
   (\ p -> Truncation[l+].Trunc[Source].proposition) (\ p -> Presented[p.1,p.2,unique].theorem) fp ;
} ;
