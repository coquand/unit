-- Formal smoothness descends through a surjective flat algebra map.
-- For z in its kernel, flatness gives z=z*b with b in the kernel.
-- A lift to a square-zero extension consequently kills z.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Tr = Truncation[l] ; module TC = TruncationCombinators[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) {
 module C = Algebras[l].Over[R,setR] ; module E = FormallyEtale[l].Over[R,setR] ;
 module At (S T : C.Algebra) (u : C.Hom S T)
  (surj : (t : T.ring.R) -> Tr.Trunc[(s : S.ring.R) * Id T.ring.R (u.1.1 s) t].carrier)
  (flat : FlatRelations[l].Over[S.ring,T.ring,u.1].Flat)
  (smooth : E.Lift S) {
  module K = FlatQuotient[l].Over[S.ring,T.ring,u.1,surj,flat] ;
  module Su = EtaleCase[l].Over[R,setR].Surjection[S,T,u,surj] ;
  module Problem (B : C.Algebra) (N : E.SquareZero[B]) (g : C.Hom T E.Mod[B,N].algebra) {
   module M = E.Mod[B,N] ; module Q = M.Q ;
   old : C.Hom S M.algebra = C.compose S T M.algebra g u ;
   lifted : (v : C.Hom S B) * Id (C.Hom S M.algebra) (E.reduce S B N v) old = smooth B N old ;
   v : C.Hom S B = lifted.1 ;
   in-ideal (z : S.ring.R) (hz : K.Kernel z) : N.ideal.In (v.1.1 z) =
    Q.kernel (v.1.1 z)
     (trans (ap (\ h -> h.1.1 z) lifted.2)
      (trans (ap g.1.1 hz) (H.zero T.ring Q.ring g.1))) ;
   killed (z : S.ring.R) (hz : K.Kernel z) : Id B.ring.R (v.1.1 z) B.ring.z =
    TC.rec (K.Witness z) @l (Id B.ring.R (v.1.1 z) B.ring.z) (B.set _ _)
     (\ w -> trans (ap v.1.1 w.2.2)
      (trans (v.1.2.2.2 z w.1) (N.square (v.1.1 z) (v.1.1 w.1) (in-ideal z hz) (in-ideal w.1 w.2.1))))
     (K.theorem z hz) ;
   module F = Su.Factor[B,v,killed] ;
   reduced : Id (C.Hom T M.algebra) (E.reduce T B N F.hom) g =
    Su.unique M.algebra (E.reduce T B N F.hom) g
     (\ s -> trans (ap Q.include (F.beta s)) (ap (\ h -> h.1.1 s) lifted.2)) ;
   theorem : (h : C.Hom T B) * Id (C.Hom T M.algebra) (E.reduce T B N h) g = (F.hom,reduced) ;
  } ;
  lift : E.Lift T = \ B N g -> Problem[B,N,g].theorem ;
 } ;
} ;
