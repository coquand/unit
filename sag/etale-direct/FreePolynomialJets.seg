-- Directional differentiation on the actual free polynomial algebra.
-- Evaluate into the already constructed dual-number ring. No equality
-- of representatives, and no differentiation axiom, is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module H = RingHom[l] ;
module Over (R : CRing) (setR : Pr.isSet R.R) (n : Nat)
 (Q : Algebras[l].Over[R,setR].Algebra)
 (pq : Presentations[l].Over[R,setR].Presents (n,nil) Q) {
 module C = Algebras[l].Over[R,setR] ; module P = Presentations[l].Over[R,setR] ;
 module At (B : C.Algebra) (a v : Fin n -> B.ring.R) {
  module X = ExpressionJets[l].Over[R,setR].At[Fin n,B,a] ;
  module D = QuadraticPairs[l].Over[B.ring,B.set,B.ring.z] ;
  module L = RL[B.ring] ;
  dual : C.Algebra = C.mkAlgebra D.ring D.set (H.compose R B.ring D.ring D.inclusion B.iota) ;
  projection : C.Hom dual B = ((\ b -> b.1,refl B.ring.o,
   \ b c -> refl (B.ring.add b.1 c.1),
   \ b c -> trans (ap (B.ring.add (B.ring.mul b.1 c.1)) (L.zero-mul (B.ring.mul b.2 c.2)))
    (B.ring.addZ (B.ring.mul b.1 c.1))),\ r -> refl (B.iota.1 r)) ;
  evaluation : C.Hom Q B = (pq.2 B).sec (a,tt) ;
  jet : C.Hom Q dual = (pq.2 dual).sec ((\ i -> (a i,v i)),tt) ;
  eval-gen (i : Fin n) : Id B.ring.R (evaluation.1.1 (pq.1.1 i)) (a i) =
   ap (\ s -> s.1 i) ((pq.2 B).sec-eq (a,tt)) ;
  jet-gen (i : Fin n) : Id D.Pair (jet.1.1 (pq.1.1 i)) (a i,v i) =
   ap (\ s -> s.1 i) ((pq.2 dual).sec-eq ((\ i -> (a i,v i)),tt)) ;
  first-eq : Id (C.Hom Q B) (C.compose Q dual B projection jet) evaluation =
   Tensor[l].Over[R,setR].hom-eq (n,nil) Q pq B _ _
    (\ i -> trans (ap (\ b -> b.1) (jet-gen i)) (sym (eval-gen i))) ;
  first (q : Q.ring.R) : Id B.ring.R (jet.1.1 q).1 (evaluation.1.1 q) =
   ap (\ h -> h.1.1 q) first-eq ;
  derivative (q : Q.ring.R) : B.ring.R = (jet.1.1 q).2 ;
  zero : Id B.ring.R (derivative Q.ring.z) B.ring.z =
   ap (\ b -> b.2) (H.zero Q.ring D.ring jet.1) ;
  add (q r : Q.ring.R) : Id B.ring.R (derivative (Q.ring.add q r))
   (B.ring.add (derivative q) (derivative r)) = ap (\ b -> b.2) (jet.1.2.2.1 q r) ;
  negative (q : Q.ring.R) : Id B.ring.R (derivative (Q.ring.neg q)) (B.ring.neg (derivative q)) =
   ap (\ b -> b.2) (H.negation Q.ring D.ring jet.1 q) ;
  product (q r : Q.ring.R) : Id B.ring.R (derivative (Q.ring.mul q r))
   (B.ring.add (B.ring.mul (evaluation.1.1 q) (derivative r)) (B.ring.mul (derivative q) (evaluation.1.1 r))) =
   trans (ap (\ b -> b.2) (jet.1.2.2.2 q r))
    (cong2 B.ring.R B.ring.add _ _ _ _ (ap (\ x -> B.ring.mul x (derivative r)) (first q))
     (ap (B.ring.mul (derivative q)) (first r))) ;
  constant (r : R.R) : Id B.ring.R (derivative (Q.iota.1 r)) B.ring.z = ap (\ b -> b.2) (jet.2 r) ;
  variable (i : Fin n) : Id B.ring.R (derivative (pq.1.1 i)) (v i) = ap (\ b -> b.2) (jet-gen i) ;
  expression-value : (e : P.Expr (Fin n)) ->
   Id B.ring.R (evaluation.1.1 (P.eval (Fin n) Q pq.1.1 e)) (X.value e) =
   \ e -> trans (P.natural (Fin n) Q B evaluation pq.1.1 e)
    (Generated[l].Over[R,setR].eval-ext (Fin n) B _ a eval-gen e) ;
  expression : (e : P.Expr (Fin n)) ->
   Id B.ring.R (derivative (P.eval (Fin n) Q pq.1.1 e)) (X.derivative v e) = split {
   var i -> variable i ; cst r -> constant r ;
   sumE e f | de df -> trans (add _ _) (cong2 B.ring.R B.ring.add _ _ _ _ de df) ;
   mulE e f | de df -> trans (product (P.eval (Fin n) Q pq.1.1 e) (P.eval (Fin n) Q pq.1.1 f))
    (cong2 B.ring.R B.ring.add _ _ _ _
     (cong2 B.ring.R B.ring.mul _ _ _ _ (expression-value e) df)
     (cong2 B.ring.R B.ring.mul _ _ _ _ de (expression-value f))) } ;
  sum : (m : Nat) (f : Fin m -> Q.ring.R) ->
   Id B.ring.R (derivative (FiniteIdeal[l].Sums[Q.ring].sum m f))
    (FiniteIdeal[l].Sums[B.ring].sum m (\ i -> derivative (f i))) = split {
   zero -> \ f -> zero ;
   suc m | rec -> \ f -> trans (add (f (inr tt)) (FiniteIdeal[l].Sums[Q.ring].sum m (\ i -> f (inl i))))
    (ap (B.ring.add (derivative (f (inr tt)))) (rec (\ i -> f (inl i)))) } ;
 } ;
} ;
