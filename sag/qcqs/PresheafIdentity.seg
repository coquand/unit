-- Structure identity for ring presheaves on a fixed lattice.
-- RingIdentity and FamilyIdentity give identity for the family of rings.
-- Decorate it by restrictions and their laws.  At the identity family
-- isomorphism, naturality says that the two restrictions agree pointwise;
-- ring-map extensionality and function extensionality identify them.
-- Their identity/composition laws and naturality are propositions.
-- Thus DecoratedIdentity applies.  Existing Presheaf records retract
-- onto these parts by record induction, giving contractible total spaces.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module IT = IdentityTools[l] ;
module DL = DistLattice[l] ;
module RI = RingIdentity[l] ;
module RH = RingHom[l] ;
module RM = RingMaps[l] ;
module Over (L : DL.DLat) {
 module O = DL.Order[L] ;
 module RL = RingedLattice[l].On[L] ;
 Family : U l+ = L.L -> RI.RD ;
 module F = FamilyIdentity[l+].Over[L.L,RI.RD,\ A B -> RI.RIso A B,RI.id-iso,RI.total-contr] ;
 Restrictions (a : Family) : U l = (u v : L.L) -> O.Le u v -> RH.Hom (a v).1 (a u).1 ;
 module Laws (a : Family) (r : Restrictions a) {
  IdLaw : U l = (u : L.L) (k : O.Le u u) (x : (a u).1.R) -> Id (a u).1.R (RM.map (r u u k) x) x ;
  CompLaw : U l = (u v w : L.L) (h : O.Le u v) (k : O.Le v w) (m : O.Le u w) (x : (a w).1.R) ->
   Id (a u).1.R (RM.map (r u v h) (RM.map (r v w k) x)) (RM.map (r u w m) x) ;
  All : U l = IdLaw * CompLaw ;
  id-prop : Pr.isProp IdLaw = IT.FE.isProp-Pi L.L (\ u -> (k : O.Le u u) (x : (a u).1.R) -> Id (a u).1.R (RM.map (r u u k) x) x)
   (\ u -> IT.FE.isProp-Pi (O.Le u u) (\ k -> (x : (a u).1.R) -> Id (a u).1.R (RM.map (r u u k) x) x)
    (\ k -> IT.FE.isProp-Pi (a u).1.R (\ x -> Id (a u).1.R (RM.map (r u u k) x) x) (\ x -> (a u).2 _ _))) ;
  comp-prop : Pr.isProp CompLaw = IT.FE.isProp-Pi L.L (\ u -> (v w : L.L) (h : O.Le u v) (k : O.Le v w) (m : O.Le u w) (x : (a w).1.R) ->
   Id (a u).1.R (RM.map (r u v h) (RM.map (r v w k) x)) (RM.map (r u w m) x)) (\ u ->
   IT.FE.isProp-Pi L.L (\ v -> (w : L.L) (h : O.Le u v) (k : O.Le v w) (m : O.Le u w) (x : (a w).1.R) ->
    Id (a u).1.R (RM.map (r u v h) (RM.map (r v w k) x)) (RM.map (r u w m) x)) (\ v ->
   IT.FE.isProp-Pi L.L (\ w -> (h : O.Le u v) (k : O.Le v w) (m : O.Le u w) (x : (a w).1.R) ->
    Id (a u).1.R (RM.map (r u v h) (RM.map (r v w k) x)) (RM.map (r u w m) x)) (\ w ->
   IT.FE.isProp-Pi (O.Le u v) (\ h -> (k : O.Le v w) (m : O.Le u w) (x : (a w).1.R) ->
    Id (a u).1.R (RM.map (r u v h) (RM.map (r v w k) x)) (RM.map (r u w m) x)) (\ h ->
   IT.FE.isProp-Pi (O.Le v w) (\ k -> (m : O.Le u w) (x : (a w).1.R) ->
    Id (a u).1.R (RM.map (r u v h) (RM.map (r v w k) x)) (RM.map (r u w m) x)) (\ k ->
   IT.FE.isProp-Pi (O.Le u w) (\ m -> (x : (a w).1.R) ->
    Id (a u).1.R (RM.map (r u v h) (RM.map (r v w k) x)) (RM.map (r u w m) x)) (\ m ->
   IT.FE.isProp-Pi (a w).1.R (\ x -> Id (a u).1.R (RM.map (r u v h) (RM.map (r v w k) x)) (RM.map (r u w m) x)) (\ x -> (a u).2 _ _))))))) ;
  all-prop : Pr.isProp All = IT.both IdLaw CompLaw id-prop comp-prop ;
 } ;
 Structure (a : Family) : U l = (r : Restrictions a) * Laws[a,r].All ;
 module Compare (a b : Family) (s : Structure a) (t : Structure b) (e : F.Relation a b) {
  Natural : U l = (u v : L.L) (k : O.Le u v) (x : (a v).1.R) -> Id (b u).1.R
   (RM.map (RI.hom (a u) (b u) (e u)) (RM.map (s.1 u v k) x))
   (RM.map (t.1 u v k) (RM.map (RI.hom (a v) (b v) (e v)) x)) ;
  proposition : Pr.isProp Natural = IT.FE.isProp-Pi L.L (\ u -> (v : L.L) (k : O.Le u v) (x : (a v).1.R) -> Id (b u).1.R
   (RM.map (RI.hom (a u) (b u) (e u)) (RM.map (s.1 u v k) x)) (RM.map (t.1 u v k) (RM.map (RI.hom (a v) (b v) (e v)) x))) (\ u ->
   IT.FE.isProp-Pi L.L (\ v -> (k : O.Le u v) (x : (a v).1.R) -> Id (b u).1.R
    (RM.map (RI.hom (a u) (b u) (e u)) (RM.map (s.1 u v k) x)) (RM.map (t.1 u v k) (RM.map (RI.hom (a v) (b v) (e v)) x))) (\ v ->
   IT.FE.isProp-Pi (O.Le u v) (\ k -> (x : (a v).1.R) -> Id (b u).1.R
    (RM.map (RI.hom (a u) (b u) (e u)) (RM.map (s.1 u v k) x)) (RM.map (t.1 u v k) (RM.map (RI.hom (a v) (b v) (e v)) x))) (\ k ->
   IT.FE.isProp-Pi (a v).1.R (\ x -> Id (b u).1.R
    (RM.map (RI.hom (a u) (b u) (e u)) (RM.map (s.1 u v k) x)) (RM.map (t.1 u v k) (RM.map (RI.hom (a v) (b v) (e v)) x))) (\ x -> (b u).2 _ _)))) ;
 } ;
 rho (a : Family) (s : Structure a) : Compare[a,a,s,s,F.identity a].Natural = \ u v k x -> refl (RM.map (s.1 u v k) x) ;
 module Unit (a : Family) (s : Structure a) {
  same (t : Structure a) (h : Compare[a,a,s,t,F.identity a].Natural) : Id (Structure a) s t =
   Pr.Sigma-eq (Restrictions a) (\ r -> Laws[a,r].All) s.1 t.1 s.2 t.2
    (FE.funext L.L (\ u -> (v : L.L) -> O.Le u v -> RH.Hom (a v).1 (a u).1) s.1 t.1 (\ u ->
     FE.funext L.L (\ v -> O.Le u v -> RH.Hom (a v).1 (a u).1) (s.1 u) (t.1 u) (\ v ->
     FE.funext (O.Le u v) (\ k -> RH.Hom (a v).1 (a u).1) (s.1 u v) (t.1 u v) (\ k ->
      RH.Properties[(a v).1,(a u).1,(a u).2].ext (s.1 u v k) (t.1 u v k) (\ x -> h u v k x)))))
    Laws[a,t.1].all-prop ;
  contractible : FunExtUA[l+].isContr ((t : Structure a) * Compare[a,a,s,t,F.identity a].Natural) =
   ((s,rho a s),\ w -> Hi.Sigma-eq (Structure a) (\ t -> Compare[a,a,s,t,F.identity a].Natural)
    s w.1 (rho a s) w.2 (same w.1 w.2) Compare[a,a,s,w.1,F.identity a].proposition) ;
 } ;
 module BaseIdentity = DecoratedIdentity[l+].Over[Family,\ a b -> F.Relation a b,F.identity,F.total-contr] ;
 module P = BaseIdentity.Data[\ a -> Structure a,\ a b s t e -> Compare[a,b,s,t,e].Natural,rho,\ a s -> Unit[a,s].contractible] ;
 fields (G : RL.Presheaf) : P.Obj = (\ u -> (G.ring u,G.ring-set u),(G.res,(G.res-id,G.res-comp))) ;
 make (g : P.Obj) : RL.Presheaf = new RL.Presheaf[\ u -> (g.1 u).1,\ u -> (g.1 u).2,g.2.1,g.2.2.1,g.2.2.2] ;
 PIso (G H : RL.Presheaf) : U l+ = P.Rel (fields G) (fields H) ;
 id-iso (G : RL.Presheaf) : PIso G G = P.identity (fields G) ;
 Total (G : RL.Presheaf) : U l+ = (H : RL.Presheaf) * PIso G H ;
 back (G : RL.Presheaf) : (H : RL.Presheaf) (e : PIso G H) -> Id (Total G) (make (fields H),e) (H,e) = split {
  Presheaf r s res a b -> \ e -> refl (new RL.Presheaf[r,s,res,a,b],e) } ;
 total-contr (G : RL.Presheaf) : FunExtUA[l+].isContr (Total G) =
  SipGeneric[l+].ctr-retract (P.Total (fields G)) (Total G) (P.total-contr (fields G))
   (\ w -> (fields w.1,w.2)) (\ w -> (make w.1,w.2)) (\ w -> back G w.1 w.2) ;
 opaque total-contr ;
 module Fd = SipGeneric[l+].Fundamental[RL.Presheaf,PIso,id-iso,total-contr] ;
} ;
