-- Full subcategories defined by properties are univalent.
-- Their objects are pairs (x,p), arrows are the original arrows, and
-- all operations and laws are inherited.  Their isomorphisms are the
-- original ones by definition.  The categorical singleton is the
-- property extension of the original contractible singleton, so
-- DecoratedIdentity.Property and Category.FromTotal give univalence.
level k l ; open Base ;
module P = Prelude[k \/ l] ;
module C = Category[k,l] ;
module D = Category[k \/ l,k \/ l] ;
module Over (X : C.Category) (Q : X.pre.ob -> U (k \/ l)) (q-prop : (x : X.pre.ob) -> P.isProp (Q x)) {
 module O = C.Objects[X] ;
 total-contr (x : X.pre.ob) : FunExtUA[k \/ l].isContr ((y : X.pre.ob) * X.pre.Iso x y) =
  ((x,X.pre.iso-id x),\ w -> O.singl-prop x (x,X.pre.iso-id x) w) ;
 module B = DecoratedIdentity[k \/ l].Over[X.pre.ob,\ x y -> X.pre.Iso x y,\ x -> X.pre.iso-id x,total-contr] ;
 module S = B.Property[Q,q-prop] ;
 precategory : D.Precategory = new D.Precategory[S.Obj,\ x y -> X.pre.hom x.1 y.1,
  \ x y -> X.pre.hom-set x.1 y.1,\ x -> X.pre.idn x.1,\ x y z -> X.pre.comp x.1 y.1 z.1,
  \ x y -> X.pre.unit-l x.1 y.1,\ x y -> X.pre.unit-r x.1 y.1,
  \ w x y z -> X.pre.assoc w.1 x.1 y.1 z.1] ;
 univalent : D.Univalent precategory = D.FromTotal[precategory,\ x u v ->
  FunExtUA[k \/ l].pathC (S.Total x) (S.total-contr x) u v].univalent ;
 category : D.Category = new D.Category[precategory,univalent] ;
} ;
