-- Sheafhood of totalisation implies native relative sheafhood (§3).
-- Pair a compatible native family and glue in the absolute sheaf.
-- Projection of its matching equations gives a base amalgam.  Separation
-- of h_k identifies its base with the specified iota.  Rebase its value;
-- the resulting pair equals the glued total point.  The cover comparison
-- gives native matching.  Native amalgams give total amalgams; uniqueness
-- there and fixed-base injectivity prove native uniqueness.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TS = TestSheaves[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor)
 (sheaf : TS.IsSheaf RelativeTotal[l].Over[K,F].functor) {
 module TF = RelativeTotal[l].Over[K,F] ;
 module OnCover (c : TS.CoverData) (iota : TF.At[TS.base c].Indices)
  (xs : RelativeCovers[l].Over[K,F].Cover[c,iota].Values) (compatible : RelativeCovers[l].Over[K,F].Cover[c,iota].Compatible xs) {
  module CF = RelativeCoverFibre[l].Over[K,F,c,iota] ;
  module RC = CF.RC ;
  module TC = CF.TC ;
  module HC = TS.SheafProperties[SF.Representable[K].functor,RepresentableSheaf[l].is-sheaf K].On[c] ;
  amalgams : Localisation[l].isContr (TC.Amalgam (CF.pairs xs)) = sheaf c (CF.pairs xs) (CF.pair-compatible xs compatible) ;
  base-equation : Id TF.At[TS.base c].Indices iota (TF.At[TS.base c].base amalgams.1.1) =
   HC.separated iota (TF.At[TS.base c].base amalgams.1.1) (\ i -> sym (ap (TF.At[RC.D.basic i].base) (amalgams.1.2 i))) ;
  value : F.obj RC.base = TF.At[TS.base c].DP.rebase base-equation (TF.At[TS.base c].value amalgams.1.1) ;
  point-equation : Id (TF.functor.obj (TS.base c)) (TF.At[TS.base c].pair iota value) amalgams.1.1 =
   TF.At[TS.base c].DP.rebase-pair base-equation (TF.At[TS.base c].value amalgams.1.1) ;
  total-matches : TC.Matches (CF.pairs xs) (TF.At[TS.base c].pair iota value) = \ i ->
   trans (ap (TF.functor.reindex (TS.base c) (RC.D.basic i) (RC.D.AB.inclusion (TS.generators c i))) point-equation) (amalgams.1.2 i) ;
  matches : RC.Matches xs value = CF.fibre-matches xs value total-matches ;
  module Compare (p : RC.Amalgam xs) {
   total-candidate : TC.Amalgam (CF.pairs xs) = (TF.At[TS.base c].pair iota p.1,CF.pair-matches xs p.1 p.2) ;
   total-equation : Id (TF.functor.obj (TS.base c)) (TF.At[TS.base c].pair iota value) (TF.At[TS.base c].pair iota p.1) =
    trans point-equation (ap (\ a -> a.1) (amalgams.2 total-candidate)) ;
   equation : Id (F.obj RC.base) value p.1 = TF.At[TS.base c].DP.injective iota value p.1 total-equation ;
  } ;
  unique (p : RC.Amalgam xs) : Id (RC.Amalgam xs) (value,matches) p =
   Pr.Sigma-eq (F.obj RC.base) (RC.Matches xs) value p.1 matches p.2 Compare[p].equation (RC.matches-prop xs p.1) ;
  contractible : Localisation[l].isContr (RC.Amalgam xs) = ((value,matches),unique) ;
 } ;
 is-sheaf : RelativeSheaves[l].Over[K,F].IsSheaf = \ c iota xs h -> OnCover[c,iota,xs,h].contractible ;
} ;
