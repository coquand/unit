-- Identity of native relative functors (note §6, value/action paragraph).
-- Apply SetIdentity and FamilyIdentity to the FIXED type of actual
-- algebra tests.  Decorate by action on genuine algebra maps and its
-- laws.  At identity of values, naturality identifies the actions by
-- function extensionality.  The laws are propositions.  Record induction
-- gives the retraction for the native records.  Structural isomorphisms
-- reorder into the native natural equivalences with the same natural map.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module IT = IdentityTools[l+] ;
module FE = Axioms[l+].FunExtLemmas[fe @l+] ;
module T = AffineTests[l] ;
module SS = SetIdentity[l] ;
module Over (K : T.Test) {
 module SF = RelativeFunctors[l].Over[K] ;
 module TE = RelativeEquivalences[l].Over[K] ;
 module BP = SF.BP ;
Family : U l+ = BP.Algebra -> SS.SmallSet ;
module F = FamilyIdentity[l+].Over[BP.Algebra,SS.SmallSet,\ A B -> SS.Equivalence A B,SS.identity,SS.total-contr] ;
Reindex (a : Family) : U l+ = (A B : BP.Algebra) -> BP.Hom A B -> (a A).1 -> (a B).1 ;
module Laws (a : Family) (r : Reindex a) {
 IdLaw : U l+ = (A : BP.Algebra) (x : (a A).1) -> Id (a A).1 (r A A (BP.id-hom A) x) x ;
 CompLaw : U l+ = (A B C : BP.Algebra) (h : BP.Hom A B) (k : BP.Hom B C) (x : (a A).1) ->
  Id (a C).1 (r A C (BP.compose-hom A B C k h) x) (r B C k (r A B h x)) ;
 All : U l+ = IdLaw * CompLaw ;
 id-prop : Hi.isProp IdLaw = IT.FE.isProp-Pi (BP.Algebra) (\ A -> (x : (a A).1) -> Id (a A).1 (r A A (BP.id-hom A) x) x) (\ A -> IT.FE.isProp-Pi ((a A).1) (\ x -> Id (a A).1 (r A A (BP.id-hom A) x) x) (\ x -> (a A).2 _ _)) ;
 comp-prop : Hi.isProp CompLaw = IT.FE.isProp-Pi (BP.Algebra) (\ A -> (B : BP.Algebra) (C : BP.Algebra) (h : BP.Hom A B) (k : BP.Hom B C) (x : (a A).1) -> Id (a C).1 (r A C (BP.compose-hom A B C k h) x) (r B C k (r A B h x))) (\ A -> IT.FE.isProp-Pi (BP.Algebra) (\ B -> (C : BP.Algebra) (h : BP.Hom A B) (k : BP.Hom B C) (x : (a A).1) -> Id (a C).1 (r A C (BP.compose-hom A B C k h) x) (r B C k (r A B h x))) (\ B -> IT.FE.isProp-Pi (BP.Algebra) (\ C -> (h : BP.Hom A B) (k : BP.Hom B C) (x : (a A).1) -> Id (a C).1 (r A C (BP.compose-hom A B C k h) x) (r B C k (r A B h x))) (\ C -> IT.FE.isProp-Pi (BP.Hom A B) (\ h -> (k : BP.Hom B C) (x : (a A).1) -> Id (a C).1 (r A C (BP.compose-hom A B C k h) x) (r B C k (r A B h x))) (\ h -> IT.FE.isProp-Pi (BP.Hom B C) (\ k -> (x : (a A).1) -> Id (a C).1 (r A C (BP.compose-hom A B C k h) x) (r B C k (r A B h x))) (\ k -> IT.FE.isProp-Pi ((a A).1) (\ x -> Id (a C).1 (r A C (BP.compose-hom A B C k h) x) (r B C k (r A B h x))) (\ x -> (a C).2 _ _)))))) ;
 all-prop : Hi.isProp All = IT.both IdLaw CompLaw id-prop comp-prop ;
} ;
Structure (a : Family) : U l+ = (r : Reindex a) * Laws[a,r].All ;
module Compare (a b : Family) (s : Structure a) (t : Structure b) (e : F.Relation a b) {
 Natural : U l+ = (A B : BP.Algebra) (h : BP.Hom A B) (x : (a A).1) ->
  Id (b B).1 ((e B).1 (s.1 A B h x)) (t.1 A B h ((e A).1 x)) ;
 proposition : Hi.isProp Natural = IT.FE.isProp-Pi (BP.Algebra) (\ A -> (B : BP.Algebra) (h : BP.Hom A B) (x : (a A).1) -> Id (b B).1 ((e B).1 (s.1 A B h x)) (t.1 A B h ((e A).1 x))) (\ A -> IT.FE.isProp-Pi (BP.Algebra) (\ B -> (h : BP.Hom A B) (x : (a A).1) -> Id (b B).1 ((e B).1 (s.1 A B h x)) (t.1 A B h ((e A).1 x))) (\ B -> IT.FE.isProp-Pi (BP.Hom A B) (\ h -> (x : (a A).1) -> Id (b B).1 ((e B).1 (s.1 A B h x)) (t.1 A B h ((e A).1 x))) (\ h -> IT.FE.isProp-Pi ((a A).1) (\ x -> Id (b B).1 ((e B).1 (s.1 A B h x)) (t.1 A B h ((e A).1 x))) (\ x -> (b B).2 _ _)))) ;
} ;
rho (a : Family) (s : Structure a) : Compare[a,a,s,s,F.identity a].Natural = \ A B h x -> refl (s.1 A B h x) ;
module Unit (a : Family) (s : Structure a) {
 same (t : Structure a) (h : Compare[a,a,s,t,F.identity a].Natural) : Id (Structure a) s t =
  Hi.Sigma-eq (Reindex a) (\ r -> Laws[a,r].All) s.1 t.1 s.2 t.2
   (FE.funext BP.Algebra (\ A -> (B : BP.Algebra) -> BP.Hom A B -> (a A).1 -> (a B).1) s.1 t.1 (\ A ->
    FE.funext BP.Algebra (\ B -> BP.Hom A B -> (a A).1 -> (a B).1) (s.1 A) (t.1 A) (\ B ->
    FE.funext (BP.Hom A B) (\ h0 -> (a A).1 -> (a B).1) (s.1 A B) (t.1 A B) (\ h0 ->
    FE.funext (a A).1 (\ x -> (a B).1) (s.1 A B h0) (t.1 A B h0) (h A B h0))))) Laws[a,t.1].all-prop ;
 contractible : FunExtUA[l+].isContr ((t : Structure a) * Compare[a,a,s,t,F.identity a].Natural) =
  ((s,rho a s),\ w -> Hi.Sigma-eq (Structure a) (\ t -> Compare[a,a,s,t,F.identity a].Natural)
   s w.1 (rho a s) w.2 (same w.1 w.2) Compare[a,a,s,w.1,F.identity a].proposition) ;
} ;
module B = DecoratedIdentity[l+].Over[Family,\ a b -> F.Relation a b,F.identity,F.total-contr] ;
module S = B.Data[Structure,\ a b s t e -> Compare[a,b,s,t,e].Natural,rho,\ a s -> Unit[a,s].contractible] ;
fields (G : SF.SetFunctor) : S.Obj = (\ A -> (G.obj A,G.set A),(G.reindex,(G.identity,G.composition))) ;
make (g : S.Obj) : SF.SetFunctor = new SF.SetFunctor[\ A -> (g.1 A).1,\ A -> (g.1 A).2,g.2.1,g.2.2.1,g.2.2.2] ;
FIso (G H : SF.SetFunctor) : U l+ = S.Rel (fields G) (fields H) ;
id-iso (G : SF.SetFunctor) : FIso G G = S.identity (fields G) ;
Total (G : SF.SetFunctor) : U l+ = (H : SF.SetFunctor) * FIso G H ;
back (G : SF.SetFunctor) : (H : SF.SetFunctor) (e : FIso G H) -> Id (Total G) (make (fields H),e) (H,e) = split {
 SetFunctor ob set reindex identity composition -> \ e -> refl (new SF.SetFunctor[ob,set,reindex,identity,composition],e) } ;
total-contr (G : SF.SetFunctor) : FunExtUA[l+].isContr (Total G) =
 SipGeneric[l+].ctr-retract (S.Total (fields G)) (Total G) (S.total-contr (fields G))
  (\ w -> (fields w.1,w.2)) (\ w -> (make w.1,w.2)) (\ w -> back G w.1 w.2) ;
opaque total-contr ;
to-equivalence (G H : SF.SetFunctor) (e : FIso G H) : TE.NaturalEquivalence G H = ((\ A x -> (e.1 A).1 x,e.2),\ A -> (e.1 A).2) ;
from-equivalence (G H : SF.SetFunctor) (e : TE.NaturalEquivalence G H) : FIso G H =
 (\ A -> (SF.Transform[G,H].at (TE.forward e) A,TE.equiv-at e A),SF.Transform[G,H].natural (TE.forward e)) ;
restore (G H : SF.SetFunctor) (e : TE.NaturalEquivalence G H) :
 Id (TE.NaturalEquivalence G H) (to-equivalence G H (from-equivalence G H e)) e = refl e ;
equivalence-total-contr (G : SF.SetFunctor) : FunExtUA[l+].isContr ((H : SF.SetFunctor) * TE.NaturalEquivalence G H) =
 SipGeneric[l+].ctr-retract (Total G) ((H : SF.SetFunctor) * TE.NaturalEquivalence G H) (total-contr G)
  (\ w -> (w.1,from-equivalence G w.1 w.2)) (\ w -> (w.1,to-equivalence G w.1 w.2))
  (\ w -> Hi.ap (TE.NaturalEquivalence G w.1) ((H : SF.SetFunctor) * TE.NaturalEquivalence G H) (\ e -> (w.1,e)) _ _ (restore G w.1 w.2)) ;

} ;
