-- Sheaves of rings on a distributive lattice M (DESIGN.md, step 3, item 6,
-- and step 4), stated concretely.
--
-- A presheaf of rings: rings G(m), restriction ring maps G(m2) -> G(m)
-- for m <= m2, the identity for m <= m, and composition.  A witness of
-- m <= m2 is a proof of an equation in a set, so restriction does not
-- depend on it (res-irr).
-- A cover of m: m_i <= m and m <= m_1 \/ .. \/ m_n.  A family x_i in G(m_i)
-- is compatible when x_i and x_j have the same restriction to m_i /\ m_j;
-- an amalgam is an x in G(m) restricting to every x_i.  G is a sheaf when
-- every compatible family on every finite cover, the empty one included,
-- has exactly one amalgam.
-- Separation.  In a sheaf, x and x' with the same restrictions to the m_i
-- are equal: the restrictions of x are compatible (both restrictions to
-- m_i /\ m_j are x|(m_i /\ m_j)), and x and x' are amalgams of them.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module On (M : DL.DLat) {
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 record Presheaf {
  ring : M.L -> CRing ;
  ring-set (m : M.L) : Pr.isSet (ring m).R ;
  res (m m2 : M.L) (k : O.Le m m2) : RH.Hom (ring m2) (ring m) ;
  res-id (m : M.L) (k : O.Le m m) (x : (ring m).R) : Id (ring m).R (map (res m m k) x) x ;
  res-comp (m1 m2 m3 : M.L) (a : O.Le m1 m2) (b : O.Le m2 m3) (c : O.Le m1 m3) (x : (ring m3).R) :
   Id (ring m1).R (map (res m1 m2 a) (map (res m2 m3 b) x)) (map (res m1 m3 c) x) ;
 } ;

 module Of (G : Presheaf) {
  -- x|m, for m <= m2
  restrict (m m2 : M.L) (k : O.Le m m2) (x : (G.ring m2).R) : (G.ring m).R = map (G.res m m2 k) x ;
  res-irr (m m2 : M.L) (k k2 : O.Le m m2) (x : (G.ring m2).R) :
   Id (G.ring m).R (restrict m m2 k x) (restrict m m2 k2 x) =
   ap (\ k3 -> restrict m m2 k3 x) (O.le-prop m m2 k k2) ;

  module Cover (m : M.L) (n : Nat) (ms : Fin n -> M.L) (le : (i : Fin n) -> O.Le (ms i) m)
   (covers : O.Le m (J.bigJ n ms)) {
   Compatible (xs : (i : Fin n) -> (G.ring (ms i)).R) : U l =
    (i j : Fin n) -> Id (G.ring (M.meet (ms i) (ms j))).R
     (restrict (M.meet (ms i) (ms j)) (ms i) (O.meet-left (ms i) (ms j)) (xs i))
     (restrict (M.meet (ms i) (ms j)) (ms j) (O.meet-right (ms i) (ms j)) (xs j)) ;
   Matches (xs : (i : Fin n) -> (G.ring (ms i)).R) (x : (G.ring m).R) : U l =
    (i : Fin n) -> Id (G.ring (ms i)).R (restrict (ms i) m (le i) x) (xs i) ;
   Amalgam (xs : (i : Fin n) -> (G.ring (ms i)).R) : U l = (x : (G.ring m).R) * Matches xs x ;
   amalgam {xs : (i : Fin n) -> (G.ring (ms i)).R} (a : Amalgam xs) : (G.ring m).R = a.1 ;
   matches {xs : (i : Fin n) -> (G.ring (ms i)).R} (a : Amalgam xs) : Matches xs (amalgam a) = a.2 ;
   -- the restrictions of one element are compatible
   restrictions (x : (G.ring m).R) (i : Fin n) : (G.ring (ms i)).R = restrict (ms i) m (le i) x ;
   restrictions-compatible (x : (G.ring m).R) : Compatible (restrictions x) = \ i j ->
    trans (G.res-comp (M.meet (ms i) (ms j)) (ms i) m (O.meet-left (ms i) (ms j)) (le i)
      (O.le-trans (M.meet (ms i) (ms j)) (ms i) m (O.meet-left (ms i) (ms j)) (le i)) x)
     (sym (G.res-comp (M.meet (ms i) (ms j)) (ms j) m (O.meet-right (ms i) (ms j)) (le j)
       (O.le-trans (M.meet (ms i) (ms j)) (ms i) m (O.meet-left (ms i) (ms j)) (le i)) x)) ;
  } ;
  IsSheaf : U l =
   (m : M.L) (n : Nat) (ms : Fin n -> M.L) (le : (i : Fin n) -> O.Le (ms i) m) (covers : O.Le m (J.bigJ n ms))
   (xs : (i : Fin n) -> (G.ring (ms i)).R) ->
   Cover[m,n,ms,le,covers].Compatible xs -> Localisation[l].isContr (Cover[m,n,ms,le,covers].Amalgam xs) ;
 } ;

 module Sheaf (G : Presheaf) (sheaf : Of[G].IsSheaf) {
  module Cover (m : M.L) (n : Nat) (ms : Fin n -> M.L) (le : (i : Fin n) -> O.Le (ms i) m)
   (covers : O.Le m (J.bigJ n ms)) {
   module C = Of[G].Cover[m,n,ms,le,covers] ;
   glue (xs : (i : Fin n) -> (G.ring (ms i)).R) (c : C.Compatible xs) : Localisation[l].isContr (C.Amalgam xs) =
    sheaf m n ms le covers xs c ;
   -- separation
   separated (x x2 : (G.ring m).R) (e : (i : Fin n) -> Id (G.ring (ms i)).R (C.restrictions x i) (C.restrictions x2 i)) :
    Id (G.ring m).R x x2 =
    ap (\ a -> C.amalgam a)
     (trans (sym ((glue (C.restrictions x) (C.restrictions-compatible x)).2 (x,\ i -> refl (C.restrictions x i))))
       ((glue (C.restrictions x) (C.restrictions-compatible x)).2 (x2,\ i -> sym (e i)))) ;
  } ;

  -- binary covers m <= m0 \/ m1: the cover m0, m1 (index inr for m0)
  module Two (m m0 m1 : M.L) (le0 : O.Le m0 m) (le1 : O.Le m1 m) (covers : O.Le m (M.join m0 m1)) {
   module GO = Of[G] ;
   ms : Fin (suc (suc zero)) -> M.L = split { inl i -> m1 ; inr t -> m0 } ;
   le : (i : Fin (suc (suc zero))) -> O.Le (ms i) m = split { inl i -> le1 ; inr t -> le0 } ;
   covers2 : O.Le m (J.bigJ (suc (suc zero)) ms) =
    O.le-trans m (M.join m0 m1) (M.join m0 (M.join m1 M.bot)) covers
     (O.le-of-eq (M.join m0 m1) (M.join m0 (M.join m1 M.bot)) (ap (M.join m0) (sym (M.joinB m1)))) ;
   module SC = Cover[m,suc (suc zero),ms,le,covers2] ;
   -- x0 and x1 agree on m0 /\ m1
   Agree (x0 : (G.ring m0).R) (x1 : (G.ring m1).R) : U l =
    Id (G.ring (M.meet m0 m1)).R (GO.restrict (M.meet m0 m1) m0 (O.meet-left m0 m1) x0)
     (GO.restrict (M.meet m0 m1) m1 (O.meet-right m0 m1) x1) ;
   -- then they agree on every w below m0 and m1
   agree-below (x0 : (G.ring m0).R) (x1 : (G.ring m1).R) (a : Agree x0 x1) (w : M.L) (k0 : O.Le w m0) (k1 : O.Le w m1) :
    Id (G.ring w).R (GO.restrict w m0 k0 x0) (GO.restrict w m1 k1 x1) = calc (G.ring w).R {
    GO.restrict w m0 k0 x0
     =< sym (G.res-comp w (M.meet m0 m1) m0 (O.meet-glb m0 m1 w k0 k1) (O.meet-left m0 m1) k0 x0)
     > GO.restrict w (M.meet m0 m1) (O.meet-glb m0 m1 w k0 k1) (GO.restrict (M.meet m0 m1) m0 (O.meet-left m0 m1) x0)
     =< ap (GO.restrict w (M.meet m0 m1) (O.meet-glb m0 m1 w k0 k1)) a
     > GO.restrict w (M.meet m0 m1) (O.meet-glb m0 m1 w k0 k1) (GO.restrict (M.meet m0 m1) m1 (O.meet-right m0 m1) x1)
     =< G.res-comp w (M.meet m0 m1) m1 (O.meet-glb m0 m1 w k0 k1) (O.meet-right m0 m1) k1 x1
     > GO.restrict w m1 k1 x1 } ;
   xs (x0 : (G.ring m0).R) (x1 : (G.ring m1).R) : (i : Fin (suc (suc zero))) -> (G.ring (ms i)).R =
    split { inl i -> x1 ; inr t -> x0 } ;
   compatible (x0 : (G.ring m0).R) (x1 : (G.ring m1).R) (a : Agree x0 x1) : SC.C.Compatible (xs x0 x1) = split {
    inl i -> split {
     inl j -> GO.res-irr (M.meet m1 m1) m1 (O.meet-left m1 m1) (O.meet-right m1 m1) x1 ;
     inr t -> sym (agree-below x0 x1 a (M.meet m1 m0) (O.meet-right m1 m0) (O.meet-left m1 m0)) } ;
    inr t -> split {
     inl j -> agree-below x0 x1 a (M.meet m0 m1) (O.meet-left m0 m1) (O.meet-right m0 m1) ;
     inr t2 -> GO.res-irr (M.meet m0 m0) m0 (O.meet-left m0 m0) (O.meet-right m0 m0) x0 } } ;
   glued (x0 : (G.ring m0).R) (x1 : (G.ring m1).R) (a : Agree x0 x1) : SC.C.Amalgam (xs x0 x1) =
    (SC.glue (xs x0 x1) (compatible x0 x1 a)).1 ;
   -- the amalgam and its restrictions
   glue (x0 : (G.ring m0).R) (x1 : (G.ring m1).R) (a : Agree x0 x1) : (G.ring m).R = SC.C.amalgam (glued x0 x1 a) ;
   matches0 (x0 : (G.ring m0).R) (x1 : (G.ring m1).R) (a : Agree x0 x1) :
    Id (G.ring m0).R (GO.restrict m0 m le0 (glue x0 x1 a)) x0 = SC.C.matches (glued x0 x1 a) (inr tt) ;
   matches1 (x0 : (G.ring m0).R) (x1 : (G.ring m1).R) (a : Agree x0 x1) :
    Id (G.ring m1).R (GO.restrict m1 m le1 (glue x0 x1 a)) x1 = SC.C.matches (glued x0 x1 a) (inl (inr tt)) ;
   -- separation
   restrictions-eq (x x2 : (G.ring m).R) (e0 : Id (G.ring m0).R (GO.restrict m0 m le0 x) (GO.restrict m0 m le0 x2))
    (e1 : Id (G.ring m1).R (GO.restrict m1 m le1 x) (GO.restrict m1 m le1 x2)) :
    (i : Fin (suc (suc zero))) -> Id (G.ring (ms i)).R (SC.C.restrictions x i) (SC.C.restrictions x2 i) =
    split { inl i -> e1 ; inr t -> e0 } ;
   separated (x x2 : (G.ring m).R) (e0 : Id (G.ring m0).R (GO.restrict m0 m le0 x) (GO.restrict m0 m le0 x2))
    (e1 : Id (G.ring m1).R (GO.restrict m1 m le1 x) (GO.restrict m1 m le1 x2)) : Id (G.ring m).R x x2 =
    SC.separated x x2 (restrictions-eq x x2 e0 e1) ;

   -- gluing ring maps: for ring maps h0, h1 into G(m0), G(m1) agreeing on
   -- m0 /\ m1, t |-> glue (h0 t) (h1 t) is a ring map (separation, since
   -- restrictions are ring maps)
   module Lift (T : CRing) (h0 : RH.Hom T (G.ring m0)) (h1 : RH.Hom T (G.ring m1))
    (e : (t : T.R) -> Agree (map h0 t) (map h1 t)) {
    lift-map (t : T.R) : (G.ring m).R = glue (map h0 t) (map h1 t) (e t) ;
    lift0 (t : T.R) : Id (G.ring m0).R (GO.restrict m0 m le0 (lift-map t)) (map h0 t) = matches0 (map h0 t) (map h1 t) (e t) ;
    lift1 (t : T.R) : Id (G.ring m1).R (GO.restrict m1 m le1 (lift-map t)) (map h1 t) = matches1 (map h0 t) (map h1 t) (e t) ;
    lift-one : Id (G.ring m).R (lift-map T.o) (G.ring m).o =
     separated (lift-map T.o) (G.ring m).o
      (trans (lift0 T.o) (trans (map-one h0) (sym (map-one (G.res m0 m le0)))))
      (trans (lift1 T.o) (trans (map-one h1) (sym (map-one (G.res m1 m le1))))) ;
    lift-add (t t2 : T.R) : Id (G.ring m).R (lift-map (T.add t t2)) ((G.ring m).add (lift-map t) (lift-map t2)) =
     separated (lift-map (T.add t t2)) ((G.ring m).add (lift-map t) (lift-map t2))
      (trans (lift0 (T.add t t2)) (trans (map-add h0 t t2)
        (trans (cong2 (G.ring m0).R (G.ring m0).add _ _ _ _ (sym (lift0 t)) (sym (lift0 t2)))
         (sym (map-add (G.res m0 m le0) (lift-map t) (lift-map t2))))))
      (trans (lift1 (T.add t t2)) (trans (map-add h1 t t2)
        (trans (cong2 (G.ring m1).R (G.ring m1).add _ _ _ _ (sym (lift1 t)) (sym (lift1 t2)))
         (sym (map-add (G.res m1 m le1) (lift-map t) (lift-map t2)))))) ;
    lift-mul (t t2 : T.R) : Id (G.ring m).R (lift-map (T.mul t t2)) ((G.ring m).mul (lift-map t) (lift-map t2)) =
     separated (lift-map (T.mul t t2)) ((G.ring m).mul (lift-map t) (lift-map t2))
      (trans (lift0 (T.mul t t2)) (trans (map-mul h0 t t2)
        (trans (cong2 (G.ring m0).R (G.ring m0).mul _ _ _ _ (sym (lift0 t)) (sym (lift0 t2)))
         (sym (map-mul (G.res m0 m le0) (lift-map t) (lift-map t2))))))
      (trans (lift1 (T.mul t t2)) (trans (map-mul h1 t t2)
        (trans (cong2 (G.ring m1).R (G.ring m1).mul _ _ _ _ (sym (lift1 t)) (sym (lift1 t2)))
         (sym (map-mul (G.res m1 m le1) (lift-map t) (lift-map t2)))))) ;
    lift : RH.Hom T (G.ring m) = (lift-map,lift-one,lift-add,lift-mul) ;
   } ;
  } ;
 } ;
} ;
