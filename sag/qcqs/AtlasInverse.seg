-- Reverse transitions are the inverses of the extracted transitions.
-- On the first overlap, compose the forward and reverse transitions.
-- Their chart equations say, successively, that its inclusion in the
-- first chart gives the same F-point as the original inclusion.
-- That chart detects equality of maps from this qcqs overlap; cancellation
-- of the open inclusion gives the composite equal to identity.  Reversing
-- the inputs gives the other inverse equation.  On a repeated chart the
-- same argument, or the diagonal map identity of AtlasData, identifies
-- the transition itself with identity.
level l ; open Ring[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (u v : CO.Over[F].Open) (A B : T.Test)
 (ea : TE.NaturalEquivalence SF.Representable[A].functor OpenRealisation[l].Over[F,u].functor)
 (eb : TE.NaturalEquivalence SF.Representable[B].functor OpenRealisation[l].Over[F,v].functor) {
 module P = AtlasTransition[l].Over[F,u,v,A,B,ea,eb] ;
 module Q = AtlasTransition[l].Over[F,v,u,B,A,eb,ea] ;
 module E = SP.Composite[P.Left.AR.space,P.Right.AR.space,P.Left.AR.space,Q.G.forward,P.G.forward] ;
 module I = SP.Composite[P.Left.AR.space,P.Left.AR.space,T.space A,Op.inclusion (T.space A) P.Left.AR.AC.extent,E.composite] ;
 module Probe (C : T.Test) (p : SP.Hom (T.space C) P.Left.AR.space) {
  r : SP.Hom (T.space C) P.Right.AR.space = SP.compose (T.space C) P.Left.AR.space P.Right.AR.space P.G.forward p ;
  first : Id (SP.Hom (T.space C) (T.space A))
   (SP.compose (T.space C) P.Left.AR.space (T.space A) I.composite p)
   (SP.compose (T.space C) P.Left.AR.space (T.space A) (Op.inclusion (T.space A) P.Left.AR.AC.extent)
    (SP.compose (T.space C) P.Right.AR.space P.Left.AR.space Q.G.forward r)) =
   trans (sym SP.Associativity[T.space C,P.Left.AR.space,P.Left.AR.space,T.space A,
     Op.inclusion (T.space A) P.Left.AR.AC.extent,E.composite,p].assoc)
    (ap (SP.compose (T.space C) P.Left.AR.space (T.space A) (Op.inclusion (T.space A) P.Left.AR.AC.extent))
     (sym SP.Associativity[T.space C,P.Left.AR.space,P.Right.AR.space,P.Left.AR.space,Q.G.forward,P.G.forward,p].assoc)) ;
  equation : Id (F.obj C)
   (SF.Transform[P.CA.AF.G.functor,F].at P.CA.chart-inclusion C (SP.compose (T.space C) P.Left.AR.space (T.space A) I.composite p))
   (SF.Transform[P.CA.AF.G.functor,F].at P.CA.chart-inclusion C
    (SP.compose (T.space C) P.Left.AR.space (T.space A) (Op.inclusion (T.space A) P.Left.AR.AC.extent) p)) =
   trans (ap (SF.Transform[P.CA.AF.G.functor,F].at P.CA.chart-inclusion C) first)
    (trans Q.Point[C,r].chart-equation P.Point[C,p].chart-equation) ;
 } ;
 included : Id (SP.Hom P.Left.AR.space (T.space A)) I.composite (Op.inclusion (T.space A) P.Left.AR.AC.extent) =
  P.CA.Maps[P.Left.AR.space,I.composite,Op.inclusion (T.space A) P.Left.AR.AC.extent,\ C p -> Probe[C,p].equation].equal P.Left.AR.qcqs ;
 inverse : Id (SP.Hom P.Left.AR.space P.Left.AR.space) E.composite SP.Identity[P.Left.AR.space].identity =
  OpenMonic[l].Over[T.space A,P.Left.AR.space,P.Left.AR.AC.extent].cancel E.composite SP.Identity[P.Left.AR.space].identity
   (trans included (sym SP.Laws[P.Left.AR.space,T.space A,Op.inclusion (T.space A) P.Left.AR.AC.extent].right)) ;
} ;
module Diagonal (F : SF.SetFunctor) (u : CO.Over[F].Open) (A : T.Test)
 (ea : TE.NaturalEquivalence SF.Representable[A].functor OpenRealisation[l].Over[F,u].functor) {
 module P = AtlasTransition[l].Over[F,u,u,A,A,ea,ea] ;
 module I = SP.Composite[P.Left.AR.space,P.Left.AR.space,T.space A,Op.inclusion (T.space A) P.Left.AR.AC.extent,P.G.forward] ;
 included : Id (SP.Hom P.Left.AR.space (T.space A)) I.composite (Op.inclusion (T.space A) P.Left.AR.AC.extent) =
  P.CA.Maps[P.Left.AR.space,I.composite,Op.inclusion (T.space A) P.Left.AR.AC.extent,\ C p ->
   trans (ap (SF.Transform[P.CA.AF.G.functor,F].at P.CA.chart-inclusion C)
     (sym SP.Associativity[T.space C,P.Left.AR.space,P.Left.AR.space,T.space A,Op.inclusion (T.space A) P.Left.AR.AC.extent,P.G.forward,p].assoc))
    P.Point[C,p].chart-equation].equal P.Left.AR.qcqs ;
 identity : Id (SP.Hom P.Left.AR.space P.Left.AR.space) P.G.forward SP.Identity[P.Left.AR.space].identity =
  OpenMonic[l].Over[T.space A,P.Left.AR.space,P.Left.AR.AC.extent].cancel P.G.forward SP.Identity[P.Left.AR.space].identity
   (trans included (sym SP.Laws[P.Left.AR.space,T.space A,Op.inclusion (T.space A) P.Left.AR.AC.extent].right)) ;
} ;
