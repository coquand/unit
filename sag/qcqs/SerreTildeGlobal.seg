-- Global sections of the associated sheaf: Gamma(Spec A, M~) = M
-- (PLAN-QCOH-UA, steps 3-5; Serre note, Section 4).
-- M~ is SerreAssociatedSheaf: a section over u is a compatible family
-- s_g in M_g for D g <= u. Write a|u for the section of a in O(u)
-- (Global.Of), so O(u)-modules are A-modules along a |-> a|u.
-- Lemma (scale-section). (a|u . s)_g = a s_g: the component of a|u at g
--  is a/1, which acts on M_g as a (ExtendRing.original-action).
-- Lemma (extend). For x in M_g, extend_g(a x) = a|D g . extend_g(x): the
--  components are rho_{g,h}(a x) = a rho_{g,h}(x) (rho is A-linear).
-- The global section of x in M: glob(x)_g = x/1 (compatible, since rho
--  sends x/1 to x/1, BasicRestrictions.on-original).
-- Theorem. glob : M -> M~(top) is A-linear (along a |-> a|top) and an
--  equivalence. Linearity is componentwise: (x+y)/1 = x/1 + y/1 and
--  (a x)/1 = a (x/1) = (a|top . glob x)_g by scale-section.
--  Equivalence: top = D 1 by definition, and glob(x) = extend_1(x/1), as
--  both have the component x/1 at every g. Evaluation at 1 is an
--  equivalence with inverse extend_1 (AssociatedBasicOpen). The map
--  x |-> x/1 : M -> M_1 is an equivalence: the identity of M clears and
--  kills at 1 (1^0 y = y), and 1 acts invertibly on M, so the extension
--  back : M_1 -> M of the identity is an equivalence
--  (SerreLambdaElementary.Lift) with back(x/1) = x; hence x |-> x/1 is
--  its inverse.
-- Lemma (restrict-global). The restriction of glob(x) to D g is
--  extend_g(x/1): both have components x/1.
-- Lemma (at-eval). For y over u and D g <= u, y_g = eval_g(y|D g).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module MC = SerreModuleCategory[l] ; module EL = SerreLambdaElementary[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Sh = SerreAssociatedSheaf[l].Over[A,setA,Md] ;
 module AM = Sh.AM ; module S = Sh.S ; module BR = Sh.BR ; module Ev = Sh.B ;
 module Z = AM.Z ; module O = Z.O ; module AF = AM.AF ; module Rings = AM.G.S ;
 module Glo = Global[l].Over[A,setA,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;
 Local (g : A.R) : U l = BR.Local[g].Native.L.Carrier ;
 fraction (g : A.R) (x : Md.M) : Local g = BR.Local[g].Native.L.fraction x zero ;
 -- an O(u)-module as an A-module, along a |-> a|u
 module AsA (u : Z.lattice.L) {
  module RS = MM.RestrictScalars[A,Rings.ring u,Glo.Of[u].sections] ;
  sections : SM.Over[A].Module = RS.Of[S.Ops[u].section-module].restricted ;
 } ;
 -- (a|u . s)_g = a s_g
 scale-section (u : Z.lattice.L) (a : A.R) (s : S.Section u) (g : A.R) (k : O.Le (Z.D g) u) :
  Id (Local g) (S.at (S.Ops[u].scale (RM.map Glo.Of[u].sections a) s) g k)
   (BR.Local[g].Native.localised.sm a (S.at s g k)) =
  BR.Local[g].Scalars.ER.original-action a (S.at s g k) ;
 -- extend_g(a x) = a|D g . extend_g(x)
 extend-scale (g : A.R) (a : A.R) (x : Local g) :
  Id (S.Section (Z.D g)) (Ev.At[g].extend (BR.Local[g].Native.localised.sm a x))
   (S.Ops[Z.D g].scale (RM.map Glo.Of[Z.D g].sections a) (Ev.At[g].extend x)) =
  S.section-ext (Z.D g) _ _ (\ h k -> calc (Local h) {
   S.at (Ev.At[g].extend (BR.Local[g].Native.localised.sm a x)) h k
    =< Ev.At[g].extend-at (BR.Local[g].Native.localised.sm a x) h k > S.rho g h k (BR.Local[g].Native.localised.sm a x)
    =< AM.component-restriction g h k (BR.Local[g].Native.localised.sm a x) > BR.At[g,h,k].map (BR.Local[g].Native.localised.sm a x)
    =< BR.At[g,h,k].map-scale a x > BR.Local[h].Native.localised.sm a (BR.At[g,h,k].map x)
    =< ap (BR.Local[h].Native.localised.sm a) (sym (trans (Ev.At[g].extend-at x h k) (AM.component-restriction g h k x)))
     > BR.Local[h].Native.localised.sm a (S.at (Ev.At[g].extend x) h k)
    =< sym (scale-section (Z.D g) a (Ev.At[g].extend x) h k)
     > S.at (S.Ops[Z.D g].scale (RM.map Glo.Of[Z.D g].sections a) (Ev.At[g].extend x)) h k }) ;
 -- (a|v)|u = a|u, and restriction commutes with the action of a
 restrict-section (u v : Z.lattice.L) (uv : O.Le u v) (a : A.R) :
  Id (Rings.Section u) (Rings.restrict u v uv (RM.map Glo.Of[v].sections a)) (RM.map Glo.Of[u].sections a) =
  Rings.section-ext u _ _ (\ g k -> Rings.restrict-at u v uv (RM.map Glo.Of[v].sections a) g k) ;
 restrict-scale (u v : Z.lattice.L) (uv : O.Le u v) (a : A.R) (y : S.Section v) :
  Id (S.Section u) (S.restrict u v uv (S.Ops[v].scale (RM.map Glo.Of[v].sections a) y))
   (S.Ops[u].scale (RM.map Glo.Of[u].sections a) (S.restrict u v uv y)) =
  S.section-ext u _ _ (\ g k -> trans (S.restrict-at u v uv (S.Ops[v].scale (RM.map Glo.Of[v].sections a) y) g k)
   (trans (scale-section v a y g (O.le-trans (Z.D g) u v k uv))
    (sym (trans (scale-section u a (S.restrict u v uv y) g k)
     (ap (BR.Local[g].Native.localised.sm a) (S.restrict-at u v uv y g k)))))) ;
 -- y_g = eval_g(y|D g)
 at-eval (u : Z.lattice.L) (y : S.Section u) (g : A.R) (k : O.Le (Z.D g) u) :
  Id (Local g) (S.at y g k) (Ev.At[g].eval (S.restrict (Z.D g) u k y)) =
  sym (trans (S.restrict-at (Z.D g) u k y g Ev.At[g].gg)
   (S.component-irr u y g (O.le-trans (Z.D g) (Z.D g) u Ev.At[g].gg k) k)) ;

 -- the global section of x
 glob (x : Md.M) : S.Section Z.lattice.top =
  (\ g k -> fraction g x,\ g h kg hg ->
   trans (AM.component-restriction g h hg (fraction g x)) (BR.At[g,h,hg].on-original x)) ;
 glob-at (x : Md.M) (g : A.R) (k : O.Le (Z.D g) Z.lattice.top) : Id (Local g) (S.at (glob x) g k) (fraction g x) =
  refl (fraction g x) ;
 module TopA = AsA[Z.lattice.top] ;
 module GlobalMap = MM.Between[A,A,RH.identity A,Md,TopA.sections] ;
 additive (x y : Md.M) : Id (S.Section Z.lattice.top) (glob (Md.madd x y)) (S.Ops[Z.lattice.top].add (glob x) (glob y)) =
  S.section-ext Z.lattice.top _ _ (\ g k -> sym (BR.Local[g].Native.add-at x y zero)) ;
 scalar (a : A.R) (x : Md.M) :
  Id (S.Section Z.lattice.top) (glob (Md.sm a x)) (S.Ops[Z.lattice.top].scale (RM.map Glo.global a) (glob x)) =
  S.section-ext Z.lattice.top _ _ (\ g k ->
   trans (sym (BR.Local[g].Native.Action.scale-at a x zero)) (sym (scale-section Z.lattice.top a (glob x) g k))) ;
 global : GlobalMap.Hom = new GlobalMap.Hom[glob,additive,scalar] ;
 global-at (x : Md.M) : Id (S.Section Z.lattice.top) (GlobalMap.map global x) (glob x) = refl (glob x) ;

 -- x |-> x/1 : M -> M_1 is an equivalence
 module One {
  module H = MM.Between[A,A,RH.identity A,Md,Md] ;
  identity : H.Hom = new H.Hom[\ x -> x,\ x y -> refl (Md.madd x y),\ a x -> refl (Md.sm a x)] ;
  identity-at (x : Md.M) : Id Md.M (H.map identity x) x = refl x ;
  invertible : Pr.isEquiv Md.M Md.M (Md.sm A.o) = Pr.qinv Md.M Md.M (Md.sm A.o) (\ x -> x) Md.smO Md.smO ;
  module Back = EL.Lift[A,Md,Md,identity,A.o,invertible] ;
  clear : Back.Elementary.Clear = \ y -> Truncation[l].Trunc[Back.Elementary.Clearing y].inc (zero,y,sym (Md.smO y)) ;
  kill : Back.Elementary.Kill = \ x e -> Truncation[l].Trunc[Back.Elementary.Killing x].inc (zero,trans (Md.smO x) e) ;
  back-equiv : Pr.isEquiv (Local A.o) Md.M Back.map = Back.equivalence clear kill ;
  back-fraction (x : Md.M) : Id Md.M (Back.map (fraction A.o x)) x = trans (Back.E.extends x) (identity-at x) ;
  fraction-back (z : Local A.o) : Id (Local A.o) (fraction A.o (Back.map z)) z =
   Iso[l].injective (Local A.o) Md.M Back.map back-equiv _ _ (back-fraction (Back.map z)) ;
  equiv : Pr.isEquiv Md.M (Local A.o) (fraction A.o) =
   Pr.qinv Md.M (Local A.o) (fraction A.o) Back.map fraction-back back-fraction ;
 } ;
 -- glob = extend_1 . (x |-> x/1)
 glob-extend (x : Md.M) : Id (S.Section Z.lattice.top) (Ev.At[A.o].extend (fraction A.o x)) (glob x) =
  S.section-ext Z.lattice.top _ _ (\ g k -> trans (Ev.At[A.o].extend-at (fraction A.o x) g k)
   (trans (AM.component-restriction A.o g k (fraction A.o x)) (BR.At[A.o,g,k].on-original x))) ;
 extend-equiv : Pr.isEquiv (Local A.o) (S.Section Z.lattice.top) Ev.At[A.o].extend =
  Pr.qinv (Local A.o) (S.Section Z.lattice.top) Ev.At[A.o].extend Ev.At[A.o].eval Ev.At[A.o].extend-eval Ev.At[A.o].eval-extend ;
 equiv : Pr.isEquiv Md.M (S.Section Z.lattice.top) (GlobalMap.map global) =
  Iso[l].equiv-homotopy Md.M (S.Section Z.lattice.top) (\ x -> Ev.At[A.o].extend (fraction A.o x)) (GlobalMap.map global) glob-extend
   (Iso[l].equiv-compose Md.M (Local A.o) (S.Section Z.lattice.top) Ev.At[A.o].extend (fraction A.o) extend-equiv One.equiv) ;
 -- the A-linear inverse
 module Inv = MC.Over[A].FromEquiv[Md,TopA.sections,global,equiv] ;
 inverse : MM.Between[A,A,RH.identity A,TopA.sections,Md].Hom = Inv.inverse ;
 inverse-glob (x : Md.M) : Id Md.M (inverse.fn (glob x)) x = Inv.left x ;
 glob-inverse (s : S.Section Z.lattice.top) : Id (S.Section Z.lattice.top) (glob (inverse.fn s)) s = Inv.right s ;

 -- the restriction of glob(x) to D g is extend_g(x/1)
 restrict-global (g : A.R) (x : Md.M) :
  Id (S.Section (Z.D g)) (S.restrict (Z.D g) Z.lattice.top (O.le-top (Z.D g)) (glob x)) (Ev.At[g].extend (fraction g x)) =
  S.section-ext (Z.D g) _ _ (\ h k -> trans (S.restrict-at (Z.D g) Z.lattice.top (O.le-top (Z.D g)) (glob x) h k)
   (sym (trans (Ev.At[g].extend-at (fraction g x) h k)
    (trans (AM.component-restriction g h k (fraction g x)) (BR.At[g,h,k].on-original x))))) ;
 opaque glob ;
} ;
