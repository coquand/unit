-- A native relative sheaf has a sheaf as its totalisation (note §3).
-- RelativeBaseGlue first glues base maps, rebases values, and proves
-- native compatibility.  Glue these values in the relative sheaf.
-- Pairing with the glued base gives a total amalgam with named matches.
-- Any other total amalgam has a projected base amalgam; base uniqueness
-- identifies its structure map with iota.  Rebase its value using that
-- specified path.  Its pair equals the original total point, so the cover
-- comparison gives relative matching.  Relative uniqueness and the pair
-- equation prove equality of total points; matching is a proposition.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TS = TestSheaves[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor)
 (sheaf : RelativeSheaves[l].Over[K,F].IsSheaf) {
 module TF = RelativeTotal[l].Over[K,F] ;
 module OnCover (c : TS.CoverData) (xs : TS.OnCover[TF.functor,c].C.Values)
  (compatible : TS.OnCover[TF.functor,c].C.Compatible xs) {
  module B = RelativeBaseGlue[l].Over[K,F,c,xs,compatible] ;
  module TC = B.TC ;
  module RC = B.CF.RC ;
  relative-amalgams : Localisation[l].isContr (RC.Amalgam B.values) = sheaf c B.iota B.values B.relative-compatible ;
  value : TF.functor.obj (TS.base c) = TF.At[TS.base c].pair B.iota relative-amalgams.1.1 ;
  matches : TC.Matches xs value = \ i -> trans (B.CF.pair-matches B.values relative-amalgams.1.1 relative-amalgams.1.2 i) (B.pair-equation i) ;
  module Compare (p : TC.Amalgam xs) {
   base-candidate : B.HC.Amalgam B.bases = (TF.At[TS.base c].base p.1,\ i -> ap (TF.At[B.D.basic i].base) (p.2 i)) ;
   base-equation : Id TF.At[TS.base c].Indices B.iota (TF.At[TS.base c].base p.1) =
    ap (\ a -> a.1) (B.base-amalgams.2 base-candidate) ;
   rebased : F.obj RC.base = TF.At[TS.base c].DP.rebase base-equation (TF.At[TS.base c].value p.1) ;
   point-equation : Id (TF.functor.obj (TS.base c)) (TF.At[TS.base c].pair B.iota rebased) p.1 =
    TF.At[TS.base c].DP.rebase-pair base-equation (TF.At[TS.base c].value p.1) ;
   total-matches : TC.Matches (B.CF.pairs B.values) (TF.At[TS.base c].pair B.iota rebased) = \ i ->
    trans (ap (TF.functor.reindex (TS.base c) (B.D.basic i) (B.D.AB.inclusion (TS.generators c i))) point-equation)
     (trans (p.2 i) (sym (B.pair-equation i))) ;
   relative-matches : RC.Matches B.values rebased = B.CF.fibre-matches B.values rebased total-matches ;
   fibre-equation : Id (F.obj RC.base) relative-amalgams.1.1 rebased = ap (\ a -> a.1) (relative-amalgams.2 (rebased,relative-matches)) ;
   point : Id (TF.functor.obj (TS.base c)) value p.1 = trans (ap (TF.At[TS.base c].pair B.iota) fibre-equation) point-equation ;
  } ;
  unique (p : TC.Amalgam xs) : Id (TC.Amalgam xs) (value,matches) p =
   Pr.Sigma-eq (TF.functor.obj (TS.base c)) (TC.Matches xs) value p.1 matches p.2 Compare[p].point (TC.matches-prop xs p.1) ;
  contractible : Localisation[l].isContr (TC.Amalgam xs) = ((value,matches),unique) ;
 } ;
 is-sheaf : TS.IsSheaf TF.functor = \ c xs h -> OnCover[c,xs,h].contractible ;
} ;
