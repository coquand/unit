-- The structure sheaf as a module sheaf (Serre, Sections 4 and 10).
-- O(a) acts on itself by multiplication. Restriction is semilinear by
-- the multiplication equation of its ring map. The underlying finite
-- sheaf diagram is the given ring-sheaf diagram, so its unique amalgams
-- supply the module-sheaf axiom, including on an empty cover.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ;
module RM = RingMaps[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (ring-sheaf : RingedLattice[l].On[L].Of[G].IsSheaf) {
 module O = DL.Order[L] ;
 module GO = RingedLattice[l].On[L].Of[G] ;
 restriction (a b : L.L) (k : O.Le a b) :
  MM.Between[G.ring b,G.ring a,G.res a b k,
   SM.Over[G.ring b].regular (G.ring-set b),SM.Over[G.ring a].regular (G.ring-set a)].Hom =
  new MM.Between[G.ring b,G.ring a,G.res a b k,
   SM.Over[G.ring b].regular (G.ring-set b),SM.Over[G.ring a].regular (G.ring-set a)].Hom[
    GO.restrict a b k,RM.map-add (G.res a b k),RM.map-mul (G.res a b k)] ;
 presheaf : MS.On[L,G].Presheaf = new MS.On[L,G].Presheaf[
  \ a -> SM.Over[G.ring a].regular (G.ring-set a),restriction,G.res-id,G.res-comp] ;
 module MO = MS.On[L,G].Of[presheaf] ;
 restrict-at (a b : L.L) (k : O.Le a b) (x : (G.ring b).R) :
  Id (G.ring a).R (MO.restrict a b k x) (GO.restrict a b k x) = refl (GO.restrict a b k x) ;
 scalar-at (a : L.L) (r x : (G.ring a).R) :
  Id (G.ring a).R ((presheaf.module-at a).sm r x) ((G.ring a).mul r x) = refl ((G.ring a).mul r x) ;
 sheaf : MO.IsSheaf = ring-sheaf ;
 structure : MS.On[L,G].ModuleSheaf = new MS.On[L,G].ModuleSheaf[presheaf,sheaf] ;
 opaque sheaf ;
} ;
