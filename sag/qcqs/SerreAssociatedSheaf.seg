-- The associated module is a genuine finite-cover sheaf (Serre §4).
-- Let u_i <= u, u <= u_1 \/ .. \/ u_n, and associated module sections x_i over u_i with
-- x_i|(u_i /\ u_j) = x_j|(u_i /\ u_j); so x_i and x_j agree on u_i /\ u_j
-- (Separated: (x_i)_h = (x_j)_h when D h <= u_i, u_j).
--
-- Theorem.  There is exactly one associated module section s over u with s|u_i = x_i for all i.
--  Uniqueness is Separated.  The amalgam is built one component at a time.
--  Glued component.  For D g <= u, call an associated module section y over D g glued at g when y
--  and x_i agree on D g /\ u_i for every i.  Since D g is covered by the
--  D g /\ u_i, two glued sections agree on D g, so are equal (Separated):
--  being glued at g is a proposition.
--  Existence at g.  As it is a proposition, a refinement of u_1 \/ .. \/ u_n
--  may be used: generators a_k, D a_k <= u_(i_k) (ZariskiLattice).  Then
--  D g is covered by the D(g a_k) (BasicCover), with x'_k = (x_(i_k))_{g a_k}
--  in M_{g a_k}; these agree on the overlaps, since x_(i_k) and x_(i_l)
--  agree on u_(i_k) /\ u_(i_l).  By the basic sheaf lemma (Gluing) there is
--  x in M_g with rho_{g,g a_k}(x) = x'_k; put y = extend x (BasicOpen).
--  For D h <= D(g a_k), D h <= u_i:
--   y_h = rho_{g,h}(x) = rho_{g a_k,h}(x'_k) = (x_(i_k))_h = (x_i)_h,
--  so y and x_i agree on each D(g a_k), hence on D g /\ u_i (Separated).
--  The amalgam.  s_g = eval(y_g) for the glued y_g.  For D h <= D g, the
--  restriction y_g|D h is glued at h, so it is y_h; by naturality of
--  evaluation, rho_{g,h}(s_g) = eval(y_g|D h) = s_h.  Finally
--  (s|u_i)_h = s_h = (y_h)_h = (x_i)_h, as D h <= D h /\ u_i.
-- The empty cover is the case n = 0: the module section type is contractible for every
-- u <= bot, in particular for bot itself.
-- Thus compatible basic module families form a finite-cover module sheaf
-- over the existing affine structure sheaf. The final packaging translates
-- restriction equations through the named semilinear-map characterisation.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SerreModule[l].Over[A].Module) {
 open A ;
 open ZariskiLattice[l].Over[A] ;
 module AM = SerreAssociatedModule[l].Over[A,setA,Md] ;
 module BR = AM.R ; module S = AM.N ;
 module B = SerreAssociatedBasicOpen[l].Over[A,AM.AF.Loc,AM.AF.set,AM.AF.inclusion,AM.AF.elementary,AM.system] ;
 module Gl = SerreModuleGluingData[l].Over[A,setA,Md] ;
 module ActualGluing = SerreModuleBasicRestrictionsGluing[l].Over[A,setA,Md] ;
 module Sd = SerreAssociatedSeparated[l].Over[A,setA,Md] ;

 module Cover (u : lattice.L) (n : Nat) (us : Fin n -> lattice.L) (le : (i : Fin n) -> O.Le (us i) u)
  (covers : O.Le u (J.bigJ n us)) (xs : (i : Fin n) -> S.Section (us i))
  (compatible : (i j : Fin n) ->
    Id (S.Section (lattice.meet (us i) (us j)))
     (S.restrict (lattice.meet (us i) (us j)) (us i) (O.meet-left (us i) (us j)) (xs i))
     (S.restrict (lattice.meet (us i) (us j)) (us j) (O.meet-right (us i) (us j)) (xs j))) {
  module SC = Sd.Cover[u,n,us,le,covers] ;
  -- x_i and x_j agree on u_i /\ u_j
  overlap (i j : Fin n) (h : R) (hi : O.Le (D h) (us i)) (hj : O.Le (D h) (us j)) :
   Id BR.Local[h].Native.L.Carrier (S.at (xs i) h hi) (S.at (xs j) h hj) =
   Sd.Pair[us i,us j,xs i,xs j].agree-restrict (lattice.meet (us i) (us j)) (O.meet-left (us i) (us j))
    (O.meet-right (us i) (us j)) (compatible i j) h (O.meet-glb (us i) (us j) (D h) hi hj) hi hj ;

  -- Associated module sections over D g glued at g
  Fits (g : R) (y : S.Section (D g)) : U l = (i : Fin n) -> Sd.Pair[D g,us i,y,xs i].Agree (lattice.meet (D g) (us i)) ;
  Glued (g : R) : U l = (y : S.Section (D g)) * Fits g y ;
  glued-section {g : R} (c : Glued g) : S.Section (D g) = c.1 ;
  fits {g : R} (c : Glued g) : Fits g (glued-section c) = c.2 ;
  fits-prop (g : R) (y : S.Section (D g)) : Pr.isProp (Fits g y) =
   F.isProp-Pi (Fin n) (\ i -> Sd.Pair[D g,us i,y,xs i].Agree (lattice.meet (D g) (us i)))
    (\ i -> Sd.Pair[D g,us i,y,xs i].agree-prop (lattice.meet (D g) (us i))) ;
  -- the restriction of a glued section to D h <= D g is glued at h
  restrict-glued (g h : R) (hg : O.Le (D h) (D g)) (c : Glued g) : Glued h =
   (S.restrict (D h) (D g) hg (glued-section c),
    \ i k hv hu hu2 -> calc BR.Local[k].Native.L.Carrier {
     S.at (S.restrict (D h) (D g) hg (glued-section c)) k hu
      =< S.restrict-at (D h) (D g) hg (glued-section c) k hu > S.at (glued-section c) k (O.le-trans (D k) (D h) (D g) hu hg)
      =< fits c i k
          (O.le-trans (D k) (lattice.meet (D h) (us i)) (lattice.meet (D g) (us i)) hv
            (O.meet-mono (D h) (us i) (D g) (us i) hg (O.le-refl (us i))))
          (O.le-trans (D k) (D h) (D g) hu hg) hu2
       > S.at (xs i) k hu2 }) ;

  module Basic (g : R) (kg : O.Le (D g) u) {
   -- D g is covered by the D g /\ u_i
   cov : O.Le (D g) (J.bigJ n (\ i -> lattice.meet (D g) (us i))) =
    O.le-trans (D g) (lattice.meet (D g) (J.bigJ n us)) (J.bigJ n (\ i -> lattice.meet (D g) (us i)))
     (O.meet-glb (D g) (J.bigJ n us) (D g) (O.le-refl (D g)) (O.le-trans (D g) u (J.bigJ n us) kg covers))
     (J.meet-below (D g) n us (J.bigJ n (\ i -> lattice.meet (D g) (us i)))
       (\ i -> J.below n (\ j -> lattice.meet (D g) (us j)) i)) ;
   glued-prop : Pr.isProp (Glued g) = \ c c2 ->
    Pr.Sigma-eq (S.Section (D g)) (Fits g) (glued-section c) (glued-section c2) (fits c) (fits c2)
     (Sd.equal (D g) (glued-section c) (glued-section c2)
       (Sd.Pair[D g,D g,glued-section c,glued-section c2].agree-cover (D g) n (\ i -> lattice.meet (D g) (us i)) cov
         (\ i h hv hu hu2 ->
           trans (fits c i h hv hu (O.le-trans (D h) (lattice.meet (D g) (us i)) (us i) hv (O.meet-right (D g) (us i))))
            (sym (fits c2 i h hv hu2 (O.le-trans (D h) (lattice.meet (D g) (us i)) (us i) hv (O.meet-right (D g) (us i))))))))
     (fits-prop g (glued-section c2)) ;

   -- existence, from a refinement of u_1 \/ .. \/ u_n
   module Refined (r : Refinement n us) {
    le-a : O.Le (D g) (J.bigJ (count r) (\ k -> D (piece r k))) =
     Pr.subst lattice.L (\ x -> O.Le (D g) x) (J.bigJ n us) (J.bigJ (count r) (\ k -> D (piece r k))) (refines r)
      (O.le-trans (D g) u (J.bigJ n us) kg covers) ;
    module BC = BasicCover[g,count r,piece r,le-a] ;
    hk (k : Fin (count r)) : O.Le (D (mul g (piece r k))) (us (tag r k)) =
     O.le-trans (D (mul g (piece r k))) (D (piece r k)) (us (tag r k)) (BC.below-gen k) (tag-below r k) ;
    -- the local data x'_k = (x_(i_k))_{g a_k}
    local (k : Fin (count r)) : BR.Local[(mul g (piece r k))].Native.L.Carrier = S.at (xs (tag r k)) (mul g (piece r k)) (hk k) ;
    agree (k m : Fin (count r)) :
     Id BR.Local[(mul (mul g (piece r k)) (mul g (piece r m)))].Native.L.Carrier
      (S.rho (mul g (piece r k)) (mul (mul g (piece r k)) (mul g (piece r m)))
        (Gl.left (mul g (piece r k)) (mul g (piece r m))) (local k))
      (S.rho (mul g (piece r m)) (mul (mul g (piece r k)) (mul g (piece r m)))
        (Gl.right (mul g (piece r k)) (mul g (piece r m))) (local m)) =
     calc BR.Local[(mul (mul g (piece r k)) (mul g (piece r m)))].Native.L.Carrier {
      S.rho (mul g (piece r k)) (mul (mul g (piece r k)) (mul g (piece r m)))
        (Gl.left (mul g (piece r k)) (mul g (piece r m))) (local k)
       =< S.compat (xs (tag r k)) (mul g (piece r k)) (mul (mul g (piece r k)) (mul g (piece r m))) (hk k)
           (Gl.left (mul g (piece r k)) (mul g (piece r m)))
        > S.at (xs (tag r k)) (mul (mul g (piece r k)) (mul g (piece r m)))
           (O.le-trans (D (mul (mul g (piece r k)) (mul g (piece r m)))) (D (mul g (piece r k))) (us (tag r k))
             (Gl.left (mul g (piece r k)) (mul g (piece r m))) (hk k))
       =< overlap (tag r k) (tag r m) (mul (mul g (piece r k)) (mul g (piece r m)))
           (O.le-trans (D (mul (mul g (piece r k)) (mul g (piece r m)))) (D (mul g (piece r k))) (us (tag r k))
             (Gl.left (mul g (piece r k)) (mul g (piece r m))) (hk k))
           (O.le-trans (D (mul (mul g (piece r k)) (mul g (piece r m)))) (D (mul g (piece r m))) (us (tag r m))
             (Gl.right (mul g (piece r k)) (mul g (piece r m))) (hk m))
        > S.at (xs (tag r m)) (mul (mul g (piece r k)) (mul g (piece r m)))
           (O.le-trans (D (mul (mul g (piece r k)) (mul g (piece r m)))) (D (mul g (piece r m))) (us (tag r m))
             (Gl.right (mul g (piece r k)) (mul g (piece r m))) (hk m))
       =< sym (S.compat (xs (tag r m)) (mul g (piece r m)) (mul (mul g (piece r k)) (mul g (piece r m))) (hk m)
           (Gl.right (mul g (piece r k)) (mul g (piece r m))))
        > S.rho (mul g (piece r m)) (mul (mul g (piece r k)) (mul g (piece r m)))
           (Gl.right (mul g (piece r k)) (mul g (piece r m))) (local m) } ;
    module GC {
     module Proof = ActualGluing.Cover[g,count r,\ k -> mul g (piece r k),BC.below,BC.covers] ;
     agree-native : Proof.C.Compatible local = \ i j ->
      trans (sym (AM.component-restriction (mul g (piece r i))
       (mul (mul g (piece r i)) (mul g (piece r j)))
       (Gl.left (mul g (piece r i)) (mul g (piece r j))) (local i)))
       (trans (agree i j)
        (AM.component-restriction (mul g (piece r j))
         (mul (mul g (piece r i)) (mul g (piece r j)))
         (Gl.right (mul g (piece r i)) (mul g (piece r j))) (local j))) ;
     glue : Proof.C.Amalgam local = Proof.amalgam local agree-native ;
    } ;
    x : BR.Local[g].Native.L.Carrier = GC.glue.1 ;
    x-at (k : Fin (count r)) : Id BR.Local[(mul g (piece r k))].Native.L.Carrier (S.rho g (mul g (piece r k)) (BC.below k) x) (local k) =
     trans (AM.component-restriction g (mul g (piece r k)) (BC.below k) x) (GC.glue.2 k) ;
    y : S.Section (D g) = B.At[g].extend x ;
    -- y and x_i agree on each D(g a_k), hence on D g /\ u_i
    fits-y : Fits g y = \ i ->
     Sd.Pair[D g,us i,y,xs i].agree-cover (lattice.meet (D g) (us i)) (count r) (\ k -> D (mul g (piece r k)))
      (O.le-trans (lattice.meet (D g) (us i)) (D g) (J.bigJ (count r) (\ k -> D (mul g (piece r k))))
        (O.meet-left (D g) (us i)) BC.covers)
      (\ k h hv hu hu2 -> calc BR.Local[h].Native.L.Carrier {
       S.at y h hu
        =< B.At[g].extend-at x h hu > S.rho g h hu x
        =< sym (AM.system.res-comp g (mul g (piece r k)) h (BC.below k) hv hu x)
         > S.rho (mul g (piece r k)) h hv (S.rho g (mul g (piece r k)) (BC.below k) x)
        =< ap (S.rho (mul g (piece r k)) h hv) (x-at k) > S.rho (mul g (piece r k)) h hv (local k)
        =< S.compat (xs (tag r k)) (mul g (piece r k)) h (hk k) hv
         > S.at (xs (tag r k)) h (O.le-trans (D h) (D (mul g (piece r k))) (us (tag r k)) hv (hk k))
        =< overlap (tag r k) i h (O.le-trans (D h) (D (mul g (piece r k))) (us (tag r k)) hv (hk k)) hu2
         > S.at (xs i) h hu2 }) ;
    glued : Glued g = (y,fits-y) ;
   } ;
   glued : Glued g =
    Tr.Trunc[Refinement n us].induction @l (\ q -> Glued g) (\ q -> glued-prop) (\ r -> Refined[r].glued) (refined n us) ;
   opaque glued ;
  } ;

  -- the amalgam: s_g = eval(y_g)
  component (g : R) (kg : O.Le (D g) u) : BR.Local[g].Native.L.Carrier = B.At[g].eval (glued-section Basic[g,kg].glued) ;
  component-compat (g h : R) (kg : O.Le (D g) u) (hg : O.Le (D h) (D g)) :
   Id BR.Local[h].Native.L.Carrier (S.rho g h hg (component g kg)) (component h (O.le-trans (D h) (D g) u hg kg)) =
   calc BR.Local[h].Native.L.Carrier {
    S.rho g h hg (B.At[g].eval (glued-section Basic[g,kg].glued))
     =< sym (B.natural g h hg (glued-section Basic[g,kg].glued))
      > B.At[h].eval (glued-section (restrict-glued g h hg Basic[g,kg].glued))
     =< ap (\ c -> B.At[h].eval (glued-section c))
         (Basic[h,O.le-trans (D h) (D g) u hg kg].glued-prop (restrict-glued g h hg Basic[g,kg].glued)
           Basic[h,O.le-trans (D h) (D g) u hg kg].glued)
      > B.At[h].eval (glued-section Basic[h,O.le-trans (D h) (D g) u hg kg].glued) } ;
  amalgam : S.Section u = (component,component-compat) ;
  amalgam-at (g : R) (kg : O.Le (D g) u) : Id BR.Local[g].Native.L.Carrier (S.at amalgam g kg) (component g kg) = refl (component g kg) ;
  matches (i : Fin n) : Id (S.Section (us i)) (S.restrict (us i) u (le i) amalgam) (xs i) =
   S.section-ext (us i) (S.restrict (us i) u (le i) amalgam) (xs i) (\ h k -> calc BR.Local[h].Native.L.Carrier {
    S.at (S.restrict (us i) u (le i) amalgam) h k
     =< S.restrict-at (us i) u (le i) amalgam h k > S.at amalgam h (O.le-trans (D h) (us i) u k (le i))
     =< amalgam-at h (O.le-trans (D h) (us i) u k (le i)) > component h (O.le-trans (D h) (us i) u k (le i))
     =< fits Basic[h,O.le-trans (D h) (us i) u k (le i)].glued i h
         (O.meet-glb (D h) (us i) (D h) (O.le-refl (D h)) k) B.At[h].gg k
      > S.at (xs i) h k }) ;

  -- the sheaf property: exactly one amalgam
  sheaf : Localisation[l].isContr (SC.Amalgam xs) =
   ((amalgam,matches),\ b -> SC.amalgam-prop xs (amalgam,matches) b) ;
 } ;

 module Modules = SerreModuleSheaf[l].On[lattice,AM.G.SH.structure] ;
 module Underlying = Modules.Of[S.presheaf] ;
 module NativeCover (u : lattice.L) (n : Nat) (us : Fin n -> lattice.L)
  (le : (i : Fin n) -> O.Le (us i) u) (covers : O.Le u (J.bigJ n us))
  (xs : (i : Fin n) -> S.Section (us i))
  (compatible : Underlying.Cover[u,n,us,le,covers].C.Compatible xs) {
  module C = Underlying.Cover[u,n,us,le,covers].C ;
  translated (i j : Fin n) : Id (S.Section (lattice.meet (us i) (us j)))
   (S.restrict (lattice.meet (us i) (us j)) (us i) (O.meet-left (us i) (us j)) (xs i))
   (S.restrict (lattice.meet (us i) (us j)) (us j) (O.meet-right (us i) (us j)) (xs j)) =
   trans (sym (S.restriction-map (lattice.meet (us i) (us j)) (us i) (O.meet-left (us i) (us j)) (xs i)))
    (trans (compatible i j) (S.restriction-map (lattice.meet (us i) (us j)) (us j) (O.meet-right (us i) (us j)) (xs j))) ;
  module Glue = Cover[u,n,us,le,covers,xs,translated] ;
  center : C.Amalgam xs = (Glue.amalgam,\ i -> trans (S.restriction-map (us i) u (le i) Glue.amalgam) (Glue.matches i)) ;
  matches-prop (s : S.Section u) : Pr.isProp (C.Matches xs s) = F.isProp-Pi (Fin n)
   (\ i -> Id (S.Section (us i)) (Underlying.restrict (us i) u (le i) s) (xs i)) (\ i -> S.section-set (us i) _ _) ;
  unique (a : C.Amalgam xs) : Id (C.Amalgam xs) center a =
   Pr.Sigma-eq (S.Section u) (C.Matches xs) Glue.amalgam (C.amalgam a)
    (C.matches center) (C.matches a)
    (Glue.SC.separated Glue.amalgam (C.amalgam a) (\ i ->
     trans (Glue.matches i) (sym (trans (sym (S.restriction-map (us i) u (le i) (C.amalgam a))) (C.matches a i)))))
    (matches-prop (C.amalgam a)) ;
  sheaf : Localisation[l].isContr (C.Amalgam xs) = (center,unique) ;
 } ;
 is-sheaf : Underlying.IsSheaf = \ u n us le covers xs compatible -> NativeCover[u,n,us,le,covers,xs,compatible].sheaf ;
 associated : Modules.ModuleSheaf = new Modules.ModuleSheaf[S.presheaf,is-sheaf] ;
 opaque is-sheaf ;
} ;
