-- The universal property of the slice X|e (DESIGN.md, Next 5,
-- prerequisite).  In the ringed convention a geometric map Y -> X|e is a
-- map of ringed lattices (L|e, O_X|e) -> (M, G), and the inclusion
-- X|e -> X is Slice.inclusion, u |-> u /\ e with restrictions ("cut").
--
-- Factorisation.  A map pi : (L, O_X) -> (M, G) with pi e = top gives
--  back(pi) : L|e -> M, u |-> pi u, with the ring maps pi#_u (the section
--  rings of X|e are those of X); it preserves top since pi e = top.  If pi
--  is local, so is back(pi): the invertibility opens of X|e are those of X.
-- Lemma (factor).  back(pi) . cut = pi: (back pi)(u /\ e) = pi u /\ pi e =
--  pi u, and pi#_(u /\ e)(s|(u /\ e)) = (pi# s)|pi(u /\ e) (pi natural).
-- Lemma (restore).  back(rho . cut) = rho for every rho out of X|e: for
--  u <= e, cut u = u, and rho#_(cut u)(s|cut u) = (rho#_u s)|rho(cut u)
--  (rho natural).
-- Corollary (cancel).  If rho . cut = rho2 . cut, then rho = rho2: both are
--  back of the same map (back does not depend on the proof of pi e = top).
-- Equality of maps is MapEquality.ext throughout.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (e : L.L)
 (M : DL.DLat) (G : RingedLattice[l].On[M].Presheaf) {
 module O = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module GX = RingedLattice[l].On[L].Of[X.sheaf] ;
 module GG = RingedLattice[l].On[M].Of[G] ;
 module Sl = Slice[l].Over[L,X,e] ;
 module MX = LocallyRinged[l].Maps[L,M,X.sheaf,G] ;
 module MS = LocallyRinged[l].Maps[Sl.lattice,M,Sl.sheaf,G] ;
 module EX = MapEquality[l].Maps[L,M,X.sheaf,G] ;
 module ES = MapEquality[l].Maps[Sl.lattice,M,Sl.sheaf,G] ;
 module C = Compose[l].Maps[L,Sl.lattice,M,X.sheaf,Sl.sheaf,G] ;

 -- the factorisation of a map sending e to top
 module Back (pi : MX.Ringed) (top-e : Id M.L (DL.hmap pi.lat e) M.top) {
  module PL = DL.JoinMaps[L,M,pi.lat] ;
  lat : DL.Hom Sl.lattice M =
   (\ x -> DL.hmap pi.lat (Sl.inc x),DL.hmap-bot pi.lat,top-e,
    \ x y -> DL.hmap-join pi.lat (Sl.inc x) (Sl.inc y),
    \ x y -> DL.hmap-meet pi.lat (Sl.inc x) (Sl.inc y)) ;
  sharp (x : Sl.Opens) : RH.Hom (Sl.sheaf.ring x) (G.ring (DL.hmap lat x)) = pi.sharp (Sl.inc x) ;
  natural (x y : Sl.Opens) (k : Sl.OS.Le x y) (s : (Sl.sheaf.ring y).R) :
   Id (G.ring (DL.hmap lat x)).R
    (map (G.res (DL.hmap lat x) (DL.hmap lat y) (DL.JoinMaps[Sl.lattice,M,lat].monotone x y k)) (map (sharp y) s))
    (map (sharp x) (map (Sl.sheaf.res x y k) s)) =
   trans (GG.res-irr (DL.hmap lat x) (DL.hmap lat y) (DL.JoinMaps[Sl.lattice,M,lat].monotone x y k)
      (PL.monotone (Sl.inc x) (Sl.inc y) (Sl.le-inc x y k)) (map (sharp y) s))
    (pi.natural (Sl.inc x) (Sl.inc y) (Sl.le-inc x y k) s) ;
  factor : MS.Ringed = new MS.Ringed[lat,sharp,natural] ;
  local (DG : InvOpen[l].On[M].Of[G].InvMap) (loc : MX.Of[pi,X.inv,DG].IsLocal) : MS.Of[factor,Sl.inv,DG].IsLocal =
   \ x s -> loc (Sl.inc x) s ;

  -- (factor)
  module FC = C.Of[factor,Sl.inclusion] ;
  lat-cut (u : L.L) : Id M.L (DL.hmap pi.lat u) (DL.hmap FC.lat u) = calc M.L {
   DL.hmap pi.lat u =< sym (M.meetT (DL.hmap pi.lat u)) > M.meet (DL.hmap pi.lat u) M.top
    =< ap (M.meet (DL.hmap pi.lat u)) (sym top-e) > M.meet (DL.hmap pi.lat u) (DL.hmap pi.lat e)
    =< sym (DL.hmap-meet pi.lat u e) > DL.hmap pi.lat (L.meet u e) } ;
  le-cut (u : L.L) : OM.Le (DL.hmap FC.lat u) (DL.hmap pi.lat u) = PL.monotone (L.meet u e) u (O.meet-left u e) ;
  sharp-cut (u : L.L) (s : (X.sheaf.ring u).R) :
   Id (G.ring (DL.hmap FC.lat u)).R (GG.restrict (DL.hmap FC.lat u) (DL.hmap pi.lat u) (le-cut u) (map (pi.sharp u) s))
    (map (FC.composite.sharp u) s) =
   trans (pi.natural (L.meet u e) u (O.meet-left u e) s) (sym (FC.sharp-map u s)) ;
  factor-cut : Id MX.Ringed FC.composite pi = sym (EX.ext pi FC.composite lat-cut le-cut sharp-cut) ;
 } ;

 -- (restore)
 module Restore (rho : MS.Ringed) {
  module RC = C.Of[rho,Sl.inclusion] ;
  cut-inc (x : Sl.Opens) : Id Sl.Opens (Sl.cut (Sl.inc x)) x = Sl.ext (Sl.cut (Sl.inc x)) x (Sl.below x) ;
  top-e : Id M.L (DL.hmap RC.lat e) M.top = trans (ap (DL.hmap rho.lat) (cut-inc Sl.topS)) (DL.hmap-top rho.lat) ;
  module RB = Back[RC.composite,top-e] ;
  lat-eq (x : Sl.Opens) : Id M.L (DL.hmap rho.lat x) (DL.hmap RB.lat x) = ap (DL.hmap rho.lat) (sym (cut-inc x)) ;
  kk (x : Sl.Opens) : Sl.OS.Le (Sl.cut (Sl.inc x)) x = Sl.le-in (Sl.cut (Sl.inc x)) x (O.meet-left (Sl.inc x) e) ;
  le (x : Sl.Opens) : OM.Le (DL.hmap RB.lat x) (DL.hmap rho.lat x) =
   DL.JoinMaps[Sl.lattice,M,rho.lat].monotone (Sl.cut (Sl.inc x)) x (kk x) ;
  sharp-eq (x : Sl.Opens) (s : (Sl.sheaf.ring x).R) :
   Id (G.ring (DL.hmap RB.lat x)).R (GG.restrict (DL.hmap RB.lat x) (DL.hmap rho.lat x) (le x) (map (rho.sharp x) s))
    (map (RB.sharp x) s) = calc (G.ring (DL.hmap RB.lat x)).R {
   GG.restrict (DL.hmap RB.lat x) (DL.hmap rho.lat x) (le x) (map (rho.sharp x) s)
    =< rho.natural (Sl.cut (Sl.inc x)) x (kk x) s
     > map (rho.sharp (Sl.cut (Sl.inc x))) (GX.restrict (L.meet (Sl.inc x) e) (Sl.inc x) (Sl.le-inc (Sl.cut (Sl.inc x)) x (kk x)) s)
    =< ap (map (rho.sharp (Sl.cut (Sl.inc x))))
        (GX.res-irr (L.meet (Sl.inc x) e) (Sl.inc x) (Sl.le-inc (Sl.cut (Sl.inc x)) x (kk x)) (O.meet-left (Sl.inc x) e) s)
     > map (rho.sharp (Sl.cut (Sl.inc x))) (map (Sl.down (Sl.inc x)) s)
    =< sym (RC.sharp-map (Sl.inc x) s) > map (RC.composite.sharp (Sl.inc x)) s } ;
  restore : Id MS.Ringed RB.factor rho = sym (ES.ext rho RB.factor lat-eq le sharp-eq) ;
 } ;

 -- back does not depend on the proof of pi e = top
 back-eq (pi pi2 : MX.Ringed) (P : Id MX.Ringed pi pi2) (h : Id M.L (DL.hmap pi.lat e) M.top)
  (h2 : Id M.L (DL.hmap pi2.lat e) M.top) : Id MS.Ringed Back[pi,h].factor Back[pi2,h2].factor =
  idJ MX.Ringed pi (\ p3 P3 -> (h3 : Id M.L (DL.hmap p3.lat e) M.top) -> Id MS.Ringed Back[pi,h].factor Back[p3,h3].factor)
   (\ h3 -> ap (\ q -> Back[pi,q].factor) (M.setL (DL.hmap pi.lat e) M.top h h3)) pi2 P h2 ;

 -- (cancel)
 cancel (rho rho2 : MS.Ringed) (P : Id MX.Ringed C.Of[rho,Sl.inclusion].composite C.Of[rho2,Sl.inclusion].composite) :
  Id MS.Ringed rho rho2 = calc MS.Ringed {
  rho =< sym Restore[rho].restore > Restore[rho].RB.factor
   =< back-eq C.Of[rho,Sl.inclusion].composite C.Of[rho2,Sl.inclusion].composite P Restore[rho].top-e Restore[rho2].top-e
    > Restore[rho2].RB.factor
   =< Restore[rho2].restore > rho2 } ;
} ;
