-- Sheaf torsors for the external Serre criterion (note, Section 5).
-- A torsor is a sheaf with a natural additive action, uniquely determined
-- differences, and sections on a merely existing finite cover of every
-- open. A difference is the centre of its contractible solution type.
-- Translation by a chosen point is an equivalence: its inverse takes
-- differences, and its inverse equations are the difference equation and
-- uniqueness. A global section therefore trivialises the torsor.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module SS = SerreSetSheaf[l] ;
module MS = SerreModuleSheaf[l] ;
module Tr = Truncation[l] ;
module LC = Localisation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module S = SS.On[L] ;
 module Modules = MS.On[L,G] ;
 module Over (M : Modules.ModuleSheaf) {
  module MO = Modules.Of[M.presheaf] ;
  record Torsor {
   presheaf : S.Presheaf ;
   sheaf : S.Of[presheaf].IsSheaf ;
   action (a : L.L) : presheaf.obj a -> (M.presheaf.module-at a).M -> presheaf.obj a ;
   action-zero (a : L.L) (t : presheaf.obj a) :
    Id (presheaf.obj a) (action a t (M.presheaf.module-at a).mz) t ;
   action-add (a : L.L) (t : presheaf.obj a) (x y : (M.presheaf.module-at a).M) :
    Id (presheaf.obj a) (action a (action a t x) y) (action a t ((M.presheaf.module-at a).madd x y)) ;
   action-res (a b : L.L) (k : O.Le a b) (t : presheaf.obj b) (x : (M.presheaf.module-at b).M) :
    Id (presheaf.obj a) (presheaf.res a b k (action b t x))
     (action a (presheaf.res a b k t) (MO.restrict a b k x)) ;
   difference (a : L.L) (t u : presheaf.obj a) :
    LC.isContr ((x : (M.presheaf.module-at a).M) * Id (presheaf.obj a) (action a t x) u) ;
   local-sections (a : L.L) :
    Tr.Trunc[(n : Nat) * (as : Fin n -> L.L) * ((i : Fin n) -> O.Le (as i) a)
     * O.Le a (J.bigJ n as) * ((i : Fin n) -> presheaf.obj (as i))].carrier ;
  } ;
  module Of (T : Torsor) {
   Difference (a : L.L) (t u : T.presheaf.obj a) : U l =
    (x : (M.presheaf.module-at a).M) * Id (T.presheaf.obj a) (T.action a t x) u ;
   diff (a : L.L) (t u : T.presheaf.obj a) : (M.presheaf.module-at a).M = (T.difference a t u).1.1 ;
   diff-equation (a : L.L) (t u : T.presheaf.obj a) :
    Id (T.presheaf.obj a) (T.action a t (diff a t u)) u = (T.difference a t u).1.2 ;
   diff-unique (a : L.L) (t u : T.presheaf.obj a) (x : (M.presheaf.module-at a).M)
    (e : Id (T.presheaf.obj a) (T.action a t x) u) : Id (M.presheaf.module-at a).M (diff a t u) x =
    ap (\ z -> z.1) ((T.difference a t u).2 (x,e)) ;
   diff-self (a : L.L) (t : T.presheaf.obj a) : Id (M.presheaf.module-at a).M (diff a t t) (M.presheaf.module-at a).mz =
    diff-unique a t t (M.presheaf.module-at a).mz (T.action-zero a t) ;
   diff-action (a : L.L) (t : T.presheaf.obj a) (x : (M.presheaf.module-at a).M) :
    Id (M.presheaf.module-at a).M (diff a t (T.action a t x)) x =
    diff-unique a t (T.action a t x) x (refl (T.action a t x)) ;
   diff-compose (a : L.L) (t u v : T.presheaf.obj a) :
    Id (M.presheaf.module-at a).M (diff a t v)
     ((M.presheaf.module-at a).madd (diff a t u) (diff a u v)) =
    diff-unique a t v ((M.presheaf.module-at a).madd (diff a t u) (diff a u v))
     (trans (sym (T.action-add a t (diff a t u) (diff a u v)))
      (trans (ap (\ w -> T.action a w (diff a u v)) (diff-equation a t u)) (diff-equation a u v))) ;
   action-injective (a : L.L) (t : T.presheaf.obj a) (x y : (M.presheaf.module-at a).M)
    (e : Id (T.presheaf.obj a) (T.action a t x) (T.action a t y)) : Id (M.presheaf.module-at a).M x y =
    trans (sym (diff-action a t x))
     (trans (ap (diff a t) e) (diff-action a t y)) ;
   translation (a : L.L) (t : T.presheaf.obj a) : Pr.Equiv (M.presheaf.module-at a).M (T.presheaf.obj a) =
    (T.action a t,Pr.qinv (M.presheaf.module-at a).M (T.presheaf.obj a) (T.action a t) (diff a t)
     (diff-equation a t) (diff-action a t)) ;
   diff-res (a b : L.L) (k : O.Le a b) (t u : T.presheaf.obj b) :
    Id (M.presheaf.module-at a).M (diff a (T.presheaf.res a b k t) (T.presheaf.res a b k u)) (MO.restrict a b k (diff b t u)) =
    diff-unique a (T.presheaf.res a b k t) (T.presheaf.res a b k u) (MO.restrict a b k (diff b t u))
     (trans (sym (T.action-res a b k t (diff b t u))) (ap (T.presheaf.res a b k) (diff-equation b t u))) ;
   GlobalSection : U l = T.presheaf.obj L.top ;
   trivialisation (t : GlobalSection) (a : L.L) : Pr.Equiv (M.presheaf.module-at a).M (T.presheaf.obj a) =
    translation a (T.presheaf.res a L.top (O.le-top a) t) ;
   opaque diff ;
  } ;
  Acyclic1 : U l+ = (T : Torsor) -> Tr.Trunc[T.presheaf.obj L.top].carrier ;
 } ;
} ;
