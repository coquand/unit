-- Sectionwise kernels of module-sheaf morphisms (Serre, Section 4).
-- The kernel over a is the subtype q(x)=0, with induced operations.
-- Restrictions preserve membership by naturality and preservation of zero.
-- A compatible family glues in E. Its image is zero by separation in F;
-- proof-valued membership gives uniqueness in the subtype. This constructs
-- the kernel as a module sheaf; quasi-coherence is a later affine-local step.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ;
module SS = SerreSetSheaf[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (E F : MS.On[L,G].ModuleSheaf)
 (q : MS.On[L,G].Transform[E.presheaf,F.presheaf].Hom) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 module EO = MS.On[L,G].Of[E.presheaf] ;
 module FO = MS.On[L,G].Of[F.presheaf] ;
 module T = MS.On[L,G].Transform[E.presheaf,F.presheaf] ;
 module At (a : L.L) {
  module QM = MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.presheaf.module-at a,F.presheaf.module-at a] ;
  Member (x : (E.presheaf.module-at a).M) : U l = Id (F.presheaf.module-at a).M (T.at q a x) (F.presheaf.module-at a).mz ;
  member-prop (x : (E.presheaf.module-at a).M) : Pr.isProp (Member x) = (F.presheaf.module-at a).setM _ _ ;
  Carrier : U l = (x : (E.presheaf.module-at a).M) * Member x ;
  value (x : Carrier) : (E.presheaf.module-at a).M = x.1 ;
  member (x : Carrier) : Member (value x) = x.2 ;
  ext (x y : Carrier) (p : Id (E.presheaf.module-at a).M (value x) (value y)) : Id Carrier x y =
   Pr.Sigma-eq (E.presheaf.module-at a).M Member (value x) (value y) (member x) (member y) p (member-prop (value y)) ;
  set : Pr.isSet Carrier = Pr.isSet-Sigma (E.presheaf.module-at a).M Member (E.presheaf.module-at a).setM
   (\ x -> Pr.prop-to-set (Member x) (member-prop x)) ;
  zero : Carrier = ((E.presheaf.module-at a).mz,T.at-zero q a) ;
  add (x y : Carrier) : Carrier = ((E.presheaf.module-at a).madd (value x) (value y),
   trans (T.at-add q a (value x) (value y))
    (trans (cong2 (F.presheaf.module-at a).M (F.presheaf.module-at a).madd _ _ _ _ (member x) (member y)) ((F.presheaf.module-at a).maddZ (F.presheaf.module-at a).mz))) ;
  neg (x : Carrier) : Carrier = ((E.presheaf.module-at a).mneg (value x),
   trans (QM.map-neg (q.component a) (value x))
    (trans (ap (F.presheaf.module-at a).mneg (member x)) (SM.Over[G.ring a].Laws[F.presheaf.module-at a].neg-zero))) ;
  scale (r : (G.ring a).R) (x : Carrier) : Carrier = ((E.presheaf.module-at a).sm r (value x),
   trans (T.at-scale q a r (value x))
    (trans (ap ((F.presheaf.module-at a).sm r) (member x)) (SM.Over[G.ring a].Laws[F.presheaf.module-at a].sm-zero r))) ;
  kernel-module : SM.Over[G.ring a].Module = new SM.Over[G.ring a].Module[
   Carrier,set,zero,add,neg,
   \ x y z -> ext (add x (add y z)) (add (add x y) z) ((E.presheaf.module-at a).maddA (value x) (value y) (value z)),
   \ x y -> ext (add x y) (add y x) ((E.presheaf.module-at a).maddC (value x) (value y)),
   \ x -> ext (add x zero) x ((E.presheaf.module-at a).maddZ (value x)),
   \ x -> ext (add x (neg x)) zero ((E.presheaf.module-at a).maddN (value x)),scale,
   \ r s x -> ext (scale r (scale s x)) (scale ((G.ring a).mul r s) x) ((E.presheaf.module-at a).smA r s (value x)),
   \ x -> ext (scale (G.ring a).o x) x ((E.presheaf.module-at a).smO (value x)),
   \ r x y -> ext (scale r (add x y)) (add (scale r x) (scale r y)) ((E.presheaf.module-at a).smD r (value x) (value y)),
   \ r s x -> ext (scale ((G.ring a).add r s) x) (add (scale r x) (scale s x)) ((E.presheaf.module-at a).smE r s (value x))] ;
  zero-value : Id (E.presheaf.module-at a).M (value zero) (E.presheaf.module-at a).mz = refl (E.presheaf.module-at a).mz ;
  add-value (x y : Carrier) : Id (E.presheaf.module-at a).M (value (add x y)) ((E.presheaf.module-at a).madd (value x) (value y)) = refl ((E.presheaf.module-at a).madd (value x) (value y)) ;
  neg-value (x : Carrier) : Id (E.presheaf.module-at a).M (value (neg x)) ((E.presheaf.module-at a).mneg (value x)) = refl ((E.presheaf.module-at a).mneg (value x)) ;
  scale-value (r : (G.ring a).R) (x : Carrier) : Id (E.presheaf.module-at a).M (value (scale r x)) ((E.presheaf.module-at a).sm r (value x)) = refl ((E.presheaf.module-at a).sm r (value x)) ;
  -- The module record stays transparent to expose its dependent carrier;
  -- proof constructions are locked after their interfaces.
  opaque ext ;
  opaque set ;
 } ;
 restrict (a b : L.L) (k : O.Le a b) (x : At[b].Carrier) : At[a].Carrier =
  (EO.restrict a b k (At[b].value x),trans (q.natural a b k (At[b].value x))
   (trans (ap (FO.restrict a b k) (At[b].member x)) (FO.res-zero a b k))) ;
 restrict-value (a b : L.L) (k : O.Le a b) (x : At[b].Carrier) :
  Id (E.presheaf.module-at a).M (At[a].value (restrict a b k x)) (EO.restrict a b k (At[b].value x)) =
  refl (EO.restrict a b k (At[b].value x)) ;
 restriction (a b : L.L) (k : O.Le a b) :
  MM.Between[G.ring b,G.ring a,G.res a b k,At[b].kernel-module,At[a].kernel-module].Hom =
  new MM.Between[G.ring b,G.ring a,G.res a b k,At[b].kernel-module,At[a].kernel-module].Hom[
   restrict a b k,
   \ x y -> At[a].ext (restrict a b k (At[b].add x y)) (At[a].add (restrict a b k x) (restrict a b k y))
    (EO.res-add a b k (At[b].value x) (At[b].value y)),
   \ r x -> At[a].ext (restrict a b k (At[b].scale r x))
    (At[a].scale (RingMaps[l].map (G.res a b k) r) (restrict a b k x)) (EO.res-scale a b k r (At[b].value x))] ;
 presheaf : MS.On[L,G].Presheaf = new MS.On[L,G].Presheaf[
  \ a -> At[a].kernel-module,restriction,
  \ a k x -> At[a].ext (restrict a a k x) x (E.presheaf.res-id a k (At[a].value x)),
  \ a b c k h t x -> At[a].ext (restrict a b k (restrict b c h x)) (restrict a c t x)
   (E.presheaf.res-comp a b c k h t (At[c].value x))] ;
 module KO = MS.On[L,G].Of[presheaf] ;
 module Cover (a : L.L) (n : Nat) (as : Fin n -> L.L)
  (le : (i : Fin n) -> O.Le (as i) a) (covers : O.Le a (J.bigJ n as))
  (xs : (i : Fin n) -> At[as i].Carrier) (compatible : KO.Cover[a,n,as,le,covers].C.Compatible xs) {
  module EC = EO.Cover[a,n,as,le,covers].C ;
  module KC = KO.Cover[a,n,as,le,covers].C ;
  module ES = SS.On[L].SheafProofs[EO.underlying,E.sheaf].Cover[a,n,as,le,covers] ;
  module FS = SS.On[L].SheafProofs[FO.underlying,F.sheaf].Cover[a,n,as,le,covers] ;
  values (i : Fin n) : (E.presheaf.module-at (as i)).M = At[as i].value (xs i) ;
  values-compatible : EC.Compatible values = \ i j ->
   ap (At[L.meet (as i) (as j)].value) (compatible i j) ;
  glued : EC.Amalgam values = (ES.glue values values-compatible).1 ;
  glued-value : (E.presheaf.module-at a).M = EC.amalgam glued ;
  glued-matches (i : Fin n) : Id (E.presheaf.module-at (as i)).M
   (EO.restrict (as i) a (le i) glued-value) (values i) = EC.matches glued i ;
  glued-member : At[a].Member glued-value = FS.separated (T.at q a glued-value) (F.presheaf.module-at a).mz (\ i ->
   trans (sym (q.natural (as i) a (le i) glued-value))
    (trans (ap (T.at q (as i)) (glued-matches i))
     (trans (At[as i].member (xs i)) (sym (FO.res-zero (as i) a (le i)))))) ;
  center : At[a].Carrier = (glued-value,glued-member) ;
  center-matches : KC.Matches xs center = \ i -> At[as i].ext (restrict (as i) a (le i) center) (xs i) (glued-matches i) ;
  matches-prop (x : At[a].Carrier) : Pr.isProp (KC.Matches xs x) =
   FE.isProp-Pi (Fin n) (\ i -> Id (At[as i].Carrier) (restrict (as i) a (le i) x) (xs i))
    (\ i -> At[as i].set _ _) ;
  unique (u : KC.Amalgam xs) : Id (At[a].Carrier) center (KC.amalgam u) =
   At[a].ext center (KC.amalgam u)
    (ES.separated glued-value (At[a].value (KC.amalgam u)) (\ i ->
     trans (glued-matches i) (sym (ap (At[as i].value) (KC.matches u i))))) ;
  amalgamation : Localisation[l].isContr (KC.Amalgam xs) =
   ((center,center-matches),\ u -> Pr.Sigma-eq (At[a].Carrier) (KC.Matches xs)
    center (KC.amalgam u) center-matches (KC.matches u) (unique u) (matches-prop (KC.amalgam u))) ;
  opaque glued ;
  opaque glued-member ;
  opaque amalgamation ;
 } ;
 sheaf : KO.IsSheaf = \ a n as le covers xs compatible -> Cover[a,n,as,le,covers,xs,compatible].amalgamation ;
 kernel : MS.On[L,G].ModuleSheaf = new MS.On[L,G].ModuleSheaf[presheaf,sheaf] ;
 module Inclusion = MS.On[L,G].Transform[presheaf,E.presheaf] ;
 inclusion-component (a : L.L) :
  MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),At[a].kernel-module,E.presheaf.module-at a].Hom =
  new MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),At[a].kernel-module,E.presheaf.module-at a].Hom[
   At[a].value,At[a].add-value,At[a].scale-value] ;
 inclusion : Inclusion.Hom = new Inclusion.Hom[inclusion-component,\ a b k x -> restrict-value a b k x] ;
 inclusion-at (a : L.L) (x : At[a].Carrier) :
  Id (E.presheaf.module-at a).M (Inclusion.at inclusion a x) (At[a].value x) = refl (At[a].value x) ;
 inclusion-killed (a : L.L) (x : At[a].Carrier) :
  Id (F.presheaf.module-at a).M (T.at q a (Inclusion.at inclusion a x)) (F.presheaf.module-at a).mz =
  trans (ap (T.at q a) (inclusion-at a x)) (At[a].member x) ;
 module Lift (H : MS.On[L,G].Presheaf)
  (h : MS.On[L,G].Transform[H,E.presheaf].Hom)
  (killed : (a : L.L) (x : (H.module-at a).M) ->
   Id (F.presheaf.module-at a).M (T.at q a (MS.On[L,G].Transform[H,E.presheaf].at h a x)) (F.presheaf.module-at a).mz) {
  module HE = MS.On[L,G].Transform[H,E.presheaf] ;
  module HK = MS.On[L,G].Transform[H,presheaf] ;
  lift-map (a : L.L) (x : (H.module-at a).M) : At[a].Carrier = (HE.at h a x,killed a x) ;
  lift-component (a : L.L) :
   MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),H.module-at a,At[a].kernel-module].Hom =
   new MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),H.module-at a,At[a].kernel-module].Hom[
    lift-map a,
    \ x y -> At[a].ext (lift-map a ((H.module-at a).madd x y)) (At[a].add (lift-map a x) (lift-map a y)) (HE.at-add h a x y),
    \ r x -> At[a].ext (lift-map a ((H.module-at a).sm r x)) (At[a].scale r (lift-map a x)) (HE.at-scale h a r x)] ;
  lift : HK.Hom = new HK.Hom[lift-component,\ a b k x ->
   At[a].ext (lift-map a (MS.On[L,G].Of[H].restrict a b k x)) (restrict a b k (lift-map b x)) (h.natural a b k x)] ;
  lift-at (a : L.L) (x : (H.module-at a).M) :
   Id (E.presheaf.module-at a).M (At[a].value (HK.at lift a x)) (HE.at h a x) = refl (HE.at h a x) ;
  unique-at (u : HK.Hom)
   (on : (a : L.L) (x : (H.module-at a).M) ->
    Id (E.presheaf.module-at a).M (At[a].value (HK.at u a x)) (HE.at h a x))
   (a : L.L) (x : (H.module-at a).M) : Id (At[a].Carrier) (HK.at u a x) (HK.at lift a x) =
   At[a].ext (HK.at u a x) (HK.at lift a x) (trans (on a x) (sym (lift-at a x))) ;
  opaque lift ;
 } ;
 opaque sheaf ;
 opaque inclusion ;
} ;
