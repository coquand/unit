-- Realisation of a compact open U of F: pairs (x, U(x)=top).
-- Its fibres over F(A) are propositions because Zar(A) is a set; thus its
-- values are sets and pointwise equality of first components suffices.
-- Reindex x along h.  Naturality of U, the equation U(x)=top and
-- preservation of top give the new membership equation.  The functor laws
-- follow from those of F by point-ext.  Forgetting membership is natural
-- and injective.  Given f : G -> F whose values lie in U, lift it by
-- pairing f(x) with membership; naturality is point-ext and naturality of
-- f.  It is the unique natural map over F (point-ext and natural-map ext).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module ZF = ZariskiFunctor[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module Over (F : SF.SetFunctor) (u : CO.Over[F].Open) {
 module C = CO.Over[F] ;
 Member (A : T.Test) (x : F.obj A) : U l =
  Id ZariskiLattice[l].Over[A.ring].lattice.L (C.value u A x) ZariskiLattice[l].Over[A.ring].lattice.top ;
 member-prop (A : T.Test) (x : F.obj A) : Pr.isProp (Member A x) =
  ZariskiLattice[l].Over[A.ring].lattice.setL (C.value u A x) ZariskiLattice[l].Over[A.ring].lattice.top ;
 obj (A : T.Test) : U l = (x : F.obj A) * Member A x ;
 point {A : T.Test} (x : obj A) : F.obj A = x.1 ;
 member {A : T.Test} (x : obj A) : Member A (point x) = x.2 ;
 point-ext (A : T.Test) (x y : obj A) (e : Id (F.obj A) (point x) (point y)) : Id (obj A) x y =
  Pr.Sigma-eq (F.obj A) (Member A) x.1 y.1 x.2 y.2 e (member-prop A y.1) ;
 set (A : T.Test) : Pr.isSet (obj A) =
  Pr.isSet-Sigma (F.obj A) (Member A) (F.set A) (\ x -> Pr.prop-to-set (Member A x) (member-prop A x)) ;
 reindex (A B : T.Test) (h : RingHom[l].Hom A.ring B.ring) (x : obj A) : obj B =
  (F.reindex A B h (point x),trans (C.N.natural u A B h (point x))
   (trans (ap (DL.hmap ZF.OnMap[A,B,h].lattice-map) (member x)) (DL.hmap-top ZF.OnMap[A,B,h].lattice-map))) ;
 identity (A : T.Test) (x : obj A) : Id (obj A) (reindex A A (RingHom[l].identity A.ring) x) x =
  point-ext A (reindex A A (RingHom[l].identity A.ring) x) x (F.identity A (point x)) ;
 composition (A B D : T.Test) (h : RingHom[l].Hom A.ring B.ring) (k : RingHom[l].Hom B.ring D.ring) (x : obj A) :
  Id (obj D) (reindex A D (RingHom[l].compose A.ring B.ring D.ring k h) x) (reindex B D k (reindex A B h x)) =
  point-ext D (reindex A D (RingHom[l].compose A.ring B.ring D.ring k h) x) (reindex B D k (reindex A B h x)) (F.composition A B D h k (point x)) ;
 functor : SF.SetFunctor = new SF.SetFunctor[obj,set,reindex,identity,composition] ;
 inclusion : SF.Transform[functor,F].Nat = (\ A x -> point x,\ A B h x -> refl (F.reindex A B h (point x))) ;
 module Lift (G : SF.SetFunctor) (f : SF.Transform[G,F].Nat) (lands : (A : T.Test) (x : G.obj A) -> Member A (SF.Transform[G,F].at f A x)) {
  module GF = SF.Transform[G,F] ;
  module GU = SF.Transform[G,functor] ;
  lift : GU.Nat = (\ A x -> (GF.at f A x,lands A x),\ A B h x ->
   point-ext B (GF.at f B (G.reindex A B h x),lands B (G.reindex A B h x)) (reindex A B h (GF.at f A x,lands A x)) (GF.natural f A B h x)) ;
  triangle : Id GF.Nat SF.Composite[G,functor,F,inclusion,lift].composite f =
   GF.ext SF.Composite[G,functor,F,inclusion,lift].composite f (\ A x -> refl (GF.at f A x)) ;
  unique (g : GU.Nat) (e : Id GF.Nat SF.Composite[G,functor,F,inclusion,g].composite f) : Id GU.Nat g lift =
   GU.ext g lift (\ A x -> point-ext A (GU.at g A x) (GF.at f A x,lands A x)
    (Hi.ap GF.Nat (F.obj A) (\ a -> GF.at a A x) SF.Composite[G,functor,F,inclusion,g].composite f e)) ;
 } ;
} ;
