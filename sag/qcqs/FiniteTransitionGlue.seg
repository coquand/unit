-- Finite geometric gluing with domain-sensitive transition laws.
-- Write Y_ij=X_j|d_ji.  The local map h_ij:Y_ij->X_i restricts and
-- transports sections from chart i to chart j; its lattice map is r_ij
-- in FiniteTransitionLattice.  Assume its identity and cocycle equations
-- there.  For sections the same equations say:
-- (1) the transported sections (h_ij# s)_j are compatible, and
-- (2) h_ii# s, restricted back along t_ii(u)=u, equals s.
-- Condition (1) is exactly the section cocycle on the triple overlap,
-- with its domains and restrictions expressed in FiniteRingGlue's type.
-- These are hypotheses of the gluing theorem, not additional axioms.
--
-- For v below chart e_i, compatibility gives t_ij(v_i)=v_j: the meet
-- with d_ji simplifies since v_j<=d_ji.  The matching equation for a
-- section tuple then determines its j-th component from its i-th one,
-- by restricting h_ij# s_i back along that equality.  Hence projection
-- to the i-th section is injective.  Conversely, transport a section
-- over v_i to the compatible tuple over extension_i(v_i), and restrict
-- it to the equal open v.  Its i-th component is the original section
-- by (2).  Projection is therefore bijective.
-- Factor X_i->glued through e_i by SliceUniversal.  The lattice map is
-- the projection whose inverse is FiniteTransitionLattice's extension;
-- its ring maps are the bijective projections just proved.  This gives
-- X_i isomorphic to glued|e_i.  The chart-cover equation is already the
-- finite lattice theorem.  In particular affine input charts give a
-- qcqs scheme, without requiring affine pairwise overlaps.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module SP = Spaces[l] ;
module Over (n : Nat) (X : Fin n -> SP.Space) (d : (i j : Fin n) -> (X i).lattice.L) {
 module Patches = FiniteTransitionLattice[l].Over[n,X,d] ;
 module Data (h : (i j : Fin n) -> SP.Hom (OpenMaps[l].space (X j) (d j i)) (X i)) {
  module T = Patches.Data[\ i j -> (SP.underlying (h i j)).lat] ;
  module Lattice (identity : T.Identity) (cocycle : T.Cocycle) {
   module TL = T.Laws[identity,cocycle] ;
   module G = FiniteLocalGlue[l].Over[n,X,\ i j -> OpenMaps[l].space (X j) (d j i),h,
    \ i j -> OpenMaps[l].inclusion (X j) (d j i)] ;
   module R = G.G ;
   transport-section (i j : Fin n) (u : (X i).lattice.L) (s : ((X i).structure.sheaf.ring u).R) :
    ((X j).structure.sheaf.ring (T.transport i j u)).R = map (R.Pair[i,j].phi.sharp u) s ;
   SectionCocycle : U l = (i : Fin n) (u : (X i).lattice.L) (s : ((X i).structure.sheaf.ring u).R) ->
    R.At[TL.extension i u].FR.Compatible (\ j -> transport-section i j u s) ;
   SectionIdentity : U l = (i : Fin n) (u : (X i).lattice.L) (s : ((X i).structure.sheaf.ring u).R) ->
    Id ((X i).structure.sheaf.ring u).R
     (R.Component[i].GO.restrict u (T.transport i i u) (R.Component[i].O.le-of-eq _ _ (sym (identity i u))) (transport-section i i u s)) s ;
   module Laws (section-cocycle : SectionCocycle) (section-identity : SectionIdentity) {
    transported (i : Fin n) (u : (X i).lattice.L) (s : ((X i).structure.sheaf.ring u).R) :
     (R.ring (TL.extension i u)).R = (\ j -> transport-section i j u s,section-cocycle i u s) ;
    transported-at (i j : Fin n) (u : (X i).lattice.L) (s : ((X i).structure.sheaf.ring u).R) :
     Id ((X j).structure.sheaf.ring (T.transport i j u)).R
      (R.coordinate (TL.extension i u) (transported i u s) j) (transport-section i j u s) = refl (transport-section i j u s) ;
    module AtChart (i : Fin n) {
     module Sl = OpenMaps[l].At[G.space,TL.chart i].Sl ;
     module LC = TL.AtChart[i] ;
     module At (v : Sl.Opens) {
      u : (X i).lattice.L = R.FL.coordinate (Sl.inc v) i ;
      -- The extension of the i-th coordinate is the original tuple.
      extension-eq : Id R.FL.Opens (TL.extension i u) (Sl.inc v) = ap (\ w -> w.1) (LC.extend-project v) ;
      to-extension : R.FL.O.Le (Sl.inc v) (TL.extension i u) = R.FL.O.le-of-eq _ _ (sym extension-eq) ;
      back (s : ((X i).structure.sheaf.ring u).R) : (R.ring (Sl.inc v)).R =
       map (R.res (Sl.inc v) (TL.extension i u) to-extension) (transported i u s) ;
      project-back (s : ((X i).structure.sheaf.ring u).R) :
       Id ((X i).structure.sheaf.ring u).R (R.coordinate (Sl.inc v) (back s) i) s =
       trans (R.Res[Sl.inc v,TL.extension i u,to-extension].at (transported i u s) i)
        (trans (ap (R.Component[i].GO.restrict u (T.transport i i u)
          (R.Res[Sl.inc v,TL.extension i u,to-extension].ki i)) (transported-at i i u s))
         (trans (R.Component[i].GO.res-irr u (T.transport i i u)
           (R.Res[Sl.inc v,TL.extension i u,to-extension].ki i) (R.Component[i].O.le-of-eq _ _ (sym (identity i u))) (transport-section i i u s))
          (section-identity i u s))) ;
      module Coordinate (j : Fin n) {
       module P = Patches.Patch[j,i].S ;
       same : Id (X j).lattice.L (T.transport i j u) (R.FL.coordinate (Sl.inc v) j) =
        trans (ap P.inc (R.FL.match (Sl.inc v) i j)) (LC.below v j) ;
       down : R.Component[j].O.Le (T.transport i j u) (R.FL.coordinate (Sl.inc v) j) = R.Component[j].O.le-of-eq _ _ same ;
       up : R.Component[j].O.Le (R.FL.coordinate (Sl.inc v) j) (T.transport i j u) = R.Component[j].O.le-of-eq _ _ (sym same) ;
       match-section (s : (R.ring (Sl.inc v)).R) :
        Id ((X j).structure.sheaf.ring (T.transport i j u)).R
         (transport-section i j u (R.coordinate (Sl.inc v) s i))
         (R.Component[j].GO.restrict (T.transport i j u) (R.FL.coordinate (Sl.inc v) j) down (R.coordinate (Sl.inc v) s j)) =
        trans (R.agree (Sl.inc v) s i j)
         (trans (P.res-inc (R.mid (Sl.inc v) i j) (P.cut (R.FL.coordinate (Sl.inc v) j))
           (R.mid-second (Sl.inc v) i j) (map (P.down (R.FL.coordinate (Sl.inc v) j)) (R.coordinate (Sl.inc v) s j)))
          ((X j).structure.sheaf.res-comp (T.transport i j u)
           ((X j).lattice.meet (R.FL.coordinate (Sl.inc v) j) (d j i)) (R.FL.coordinate (Sl.inc v) j)
           (P.le-inc (R.mid (Sl.inc v) i j) (P.cut (R.FL.coordinate (Sl.inc v) j)) (R.mid-second (Sl.inc v) i j))
           (R.Component[j].O.meet-left (R.FL.coordinate (Sl.inc v) j) (d j i)) down (R.coordinate (Sl.inc v) s j))) ;
       recover (s : (R.ring (Sl.inc v)).R) :
        Id ((X j).structure.sheaf.ring (R.FL.coordinate (Sl.inc v) j)).R
         (R.Component[j].GO.restrict (R.FL.coordinate (Sl.inc v) j) (T.transport i j u) up
          (transport-section i j u (R.coordinate (Sl.inc v) s i))) (R.coordinate (Sl.inc v) s j) =
        trans (ap (R.Component[j].GO.restrict (R.FL.coordinate (Sl.inc v) j) (T.transport i j u) up) (match-section s))
         (trans ((X j).structure.sheaf.res-comp _ _ _ up down (R.Component[j].O.le-refl (R.FL.coordinate (Sl.inc v) j)) (R.coordinate (Sl.inc v) s j))
          ((X j).structure.sheaf.res-id (R.FL.coordinate (Sl.inc v) j) (R.Component[j].O.le-refl (R.FL.coordinate (Sl.inc v) j)) (R.coordinate (Sl.inc v) s j))) ;
      } ;
      injective (s t : (R.ring (Sl.inc v)).R)
       (e : Id ((X i).structure.sheaf.ring u).R (R.coordinate (Sl.inc v) s i) (R.coordinate (Sl.inc v) t i)) : Id (R.ring (Sl.inc v)).R s t =
       R.ext (Sl.inc v) s t (\ j -> trans (sym (Coordinate[j].recover s))
        (trans (ap (\ z -> R.Component[j].GO.restrict (R.FL.coordinate (Sl.inc v) j) (T.transport i j u) Coordinate[j].up (transport-section i j u z)) e)
         (Coordinate[j].recover t))) ;
      equivalence : Pr.isEquiv (R.ring (Sl.inc v)).R ((X i).structure.sheaf.ring u).R (\ s -> R.coordinate (Sl.inc v) s i) =
       Pr.qinv (R.ring (Sl.inc v)).R ((X i).structure.sheaf.ring u).R (\ s -> R.coordinate (Sl.inc v) s i) back
        project-back (\ s -> injective (back (R.coordinate (Sl.inc v) s i)) s (project-back (R.coordinate (Sl.inc v) s i))) ;
     } ;
     module SU = SliceUniversal[l].Over[G.space.lattice,G.space.structure,TL.chart i,(X i).lattice,(X i).structure.sheaf] ;
     module B = SU.Back[G.Projection[i].ringed,TL.chart-self i] ;
     morphism : SP.Hom (X i) (OpenMaps[l].space G.space (TL.chart i)) =
      (B.factor,B.local (X i).structure.inv G.Projection[i].local) ;
     iso : SP.IsIso (X i) (OpenMaps[l].space G.space (TL.chart i)) morphism =
      (LC.equivalence,\ v -> At[v].equivalence) ;
    } ;
    module AffineInputs (affine : (i : Fin n) -> AffineCriterion[l].Over[(X i).lattice,(X i).structure].IsAffine) {
     module Q = Qcqs[l].Over[R.FL.lattice,G.glued] ;
     module Part (i : Fin n) {
      module C = AtChart[i] ;
      module V = Iso[l].Invert[C.Sl.lattice,(X i).lattice,C.Sl.sheaf,(X i).structure.sheaf,C.B.factor,C.iso] ;
      module A = AffineTransport[l].Over[(X i).lattice,C.Sl.lattice,(X i).structure,C.Sl.restricted,
       V.inverse,V.inverse-iso,affine i] ;
      affine-restricted : AffineCriterion[l].Over[C.Sl.lattice,C.Sl.restricted].IsAffine = A.affine ;
      affine-open : Q.AffineOpen (TL.chart i) = affine-restricted ;
     } ;
     cover : Q.AffineCover = struct {
      count = n ; opens = TL.chart ;
      covers = R.FL.O.le-antisym (R.FL.J.bigJ n TL.chart) R.FL.whole
       (R.FL.O.le-top (R.FL.J.bigJ n TL.chart)) TL.covers ;
      affine = \ i -> Part[i].affine-open } ;
     qcqs : Q.IsQcqs = Truncation[l].Trunc[Q.AffineCover].inc cover ;
    } ;
   } ;
  } ;
 } ;
} ;
