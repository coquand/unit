-- Univalence of the precategory of existing set-valued functors.
-- An invertible natural map is exactly a natural equivalence: evaluate
-- the inverse equations for one direction, and use TestEquivalences'
-- natural inverse for the other.  Its categorical singleton retracts
-- onto FunctorIdentity's contractible natural-equivalence total space.
-- Category.FromTotal therefore gives the canonical univalence proof.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CC = Category[l+,l+] ;
precategory : CC.Precategory = new CC.Precategory[SF.SetFunctor,\ F G -> SF.Transform[F,G].Nat,
 \ F G -> SF.Transform[F,G].set,SF.identity,\ F G H b a -> SF.Composite[F,G,H,b,a].composite,
 \ F G a -> SF.Transform[F,G].ext _ _ (\ A x -> refl (SF.Transform[F,G].at a A x)),
 \ F G a -> SF.Transform[F,G].ext _ _ (\ A x -> refl (SF.Transform[F,G].at a A x)),
 \ E F G H a b c -> SF.Transform[E,H].ext _ _ (\ A x -> refl
  (SF.Transform[G,H].at c A (SF.Transform[F,G].at b A (SF.Transform[E,F].at a A x))))] ;
module Arr = Arrows[l+,l+].Arrows[precategory] ;
module ToIso (F G : SF.SetFunctor) (e : TE.NaturalEquivalence F G) {
 module I = TE.Inverse[F,G,e] ;
 categorical : precategory.Iso F G = (TE.forward e,I.inverse,I.left,I.right) ;
} ;
module FromIso (F G : SF.SetFunctor) (e : precategory.Iso F G) {
 equivalence : TE.NaturalEquivalence F G = (e.1,\ A -> Pr.qinv (F.obj A) (G.obj A)
  (SF.Transform[F,G].at e.1 A) (SF.Transform[G,F].at e.2.1 A)
  (\ y -> Hi.ap (SF.Transform[G,G].Nat) (G.obj A) (\ a -> SF.Transform[G,G].at a A y) _ _ e.2.2.2)
  (\ x -> Hi.ap (SF.Transform[F,F].Nat) (F.obj A) (\ a -> SF.Transform[F,F].at a A x) _ _ e.2.2.1)) ;
} ;
module Single (F : SF.SetFunctor) {
 Total : U l+ = (G : SF.SetFunctor) * precategory.Iso F G ;
 contractible : FunExtUA[l+].isContr Total =
  SipGeneric[l+].ctr-retract ((G : SF.SetFunctor) * TE.NaturalEquivalence F G) Total (FunctorIdentity[l].equivalence-total-contr F)
   (\ w -> (w.1,FromIso[F,w.1,w.2].equivalence)) (\ w -> (w.1,ToIso[F,w.1,w.2].categorical))
   (\ w -> Hi.ap (precategory.Iso F w.1) Total (\ e -> (w.1,e)) _ _ (Arr.iso-eq _ _ (refl w.2.1))) ;
 proposition : Hi.isProp Total = \ u v -> FunExtUA[l+].pathC Total contractible u v ;
} ;
univalent : CC.Univalent precategory = CC.FromTotal[precategory,\ F -> Single[F].proposition].univalent ;
category : CC.Category = new CC.Category[precategory,univalent] ;
