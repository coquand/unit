-- Families of types over I, and fibrewise equivalences (port of
-- ~/DOMAIN/UNIT/CategorySIPFamily.seg, I and the fibres in U l).
-- For a family F : I -> U l, paths F = G in I -> U l and fibrewise
-- equivalences (i : I) -> F i ~= G i:
--   idto: by J, refl |-> the identity equivalences;
--   path: funext of univalence (ua) fibrewise;
--   beta (idto (path e) = e): fibrewise, idto at i is idtoeqv of the
--     path at i (idto-ap, by J), which is ua (e i) (happly-funext), and
--     idtoeqv (ua (e i)) = e i.
-- Hence equivalence induction (eqind): to prove M G e for all
-- fibrewise equivalences it suffices to prove M F (identity), by J on
-- path e and transport along beta.  (The other inverse law of the UNIT
-- file is not needed for eqind and is not ported.)
level l ; open Base ;
module L = Prelude[l] ;
module P = Prelude[l+] ;
module H = Axioms[l+].FunExtLemmas[fe @l+] ;
module UA = Axioms[l].UnivalenceLemmas[univ @l] ;

module On (I : U l) (F : I -> U l) {
 Family : U l+ = I -> U l ;
 FiberEquiv (G : Family) : U l = (i : I) -> L.Equiv (F i) (G i) ;
 idto (G : Family) (p : Id Family F G) : FiberEquiv G =
  idJ Family F (\ X q -> FiberEquiv X) (\ i -> L.idEquiv (F i)) G p ;
 path (G : Family) (e : FiberEquiv G) : Id Family F G =
  H.funext I (\ _ -> U l) F G (\ i -> UA.ua (F i) (G i) (e i)) ;
 idto-ap (G : Family) (p : Id Family F G) (i : I) :
  Id (L.Equiv (F i) (G i)) (idto G p i) (Axioms[l].idtoeqv (F i) (G i) (P.ap Family (U l) (\ X -> X i) F G p)) =
  idJ Family F
   (\ X q -> (i : I) -> Id (L.Equiv (F i) (X i)) (idto X q i) (Axioms[l].idtoeqv (F i) (X i) (P.ap Family (U l) (\ T -> T i) F X q)))
   (\ i -> refl (L.idEquiv (F i))) G p i ;
 beta (G : Family) (e : FiberEquiv G) : Id (FiberEquiv G) (idto G (path G e)) e =
  H.funext I (\ i -> L.Equiv (F i) (G i)) (idto G (path G e)) e (\ i ->
   P.trans (L.Equiv (F i) (G i)) (idto G (path G e) i)
    (Axioms[l].idtoeqv (F i) (G i) (P.ap Family (U l) (\ X -> X i) F G (path G e))) (e i)
    (idto-ap G (path G e) i)
    (P.trans (L.Equiv (F i) (G i))
     (Axioms[l].idtoeqv (F i) (G i) (P.ap Family (U l) (\ X -> X i) F G (path G e)))
     (Axioms[l].idtoeqv (F i) (G i) (UA.ua (F i) (G i) (e i))) (e i)
     (P.ap (Id (U l) (F i) (G i)) (L.Equiv (F i) (G i)) (Axioms[l].idtoeqv (F i) (G i))
      (P.ap Family (U l) (\ X -> X i) F G (path G e)) (UA.ua (F i) (G i) (e i))
      (P.ap ((j : I) -> Id (U l) (F j) (G j)) (Id (U l) (F i) (G i)) (\ h -> h i)
       (P.happly I (\ _ -> U l) F G (path G e)) (\ j -> UA.ua (F j) (G j) (e j))
       (H.happly-funext I (\ _ -> U l) F G (\ j -> UA.ua (F j) (G j) (e j)))))
     ((univ @l (F i) (G i)).sec-eq (e i)))) ;
 eqind (M : (G : Family) -> FiberEquiv G -> U l+) (d : M F (\ i -> L.idEquiv (F i)))
  (G : Family) (e : FiberEquiv G) : M G e =
  P.subst (FiberEquiv G) (M G) (idto G (path G e)) e (beta G e) (idJ Family F (\ X q -> M X (idto X q)) d G (path G e)) ;
} ;
