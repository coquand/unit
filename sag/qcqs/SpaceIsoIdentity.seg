-- Every actual ringed-lattice isomorphism has the structural presentation
-- of SpaceIdentity, with the same underlying ringed map.
-- First replace its lattice map by the presentation LatticeIdentity.hom
-- of its lattice isomorphism.  This changes the whole ringed map along
-- their equality; path induction proves it is the original map.
-- Lattice iso induction reduces to identity on a fixed lattice.  Then
-- its bijective sharp maps give RingIdentity isomorphisms; naturality
-- gives LocalIdentity's structural isomorphism.  Hom-of and MapEquality
-- identify the resulting ringed map with the given map.  No structure
-- is inferred solely from existence of some equality of objects.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module DL = DistLattice[l] ;
module LI = LatticeIdentity[l] ;
module RI = RingIdentity[l] ;
module SI = SpaceIdentity[l] ;
module SP = Spaces[l] ;
module RH = RingHom[l] ;
module RM = RingMaps[l] ;
module Over (X : SP.Space) {
 module At (Y : SP.Space) {
  module MP = LocallyRinged[l].Maps[X.lattice,Y.lattice,X.structure.sheaf,Y.structure.sheaf] ;
  module EQ = MapEquality[l].Maps[X.lattice,Y.lattice,X.structure.sheaf,Y.structure.sheaf] ;
  module IM = Iso[l].Maps[X.lattice,Y.lattice,X.structure.sheaf,Y.structure.sheaf] ;
  Witness (pi : MP.Ringed) : U l+ = (e : SI.RIso X Y) * Id MP.Ringed (SI.ringed X Y e) pi ;
  module Change (pi : MP.Ringed) (lat : DL.Hom X.lattice Y.lattice) (p : Id (DL.Hom X.lattice Y.lattice) pi.lat lat) {
   parts : EQ.Parts lat = Pr.subst (DL.Hom X.lattice Y.lattice) EQ.Parts pi.lat lat p (pi.sharp,pi.natural) ;
   ringed : MP.Ringed = EQ.from-total (lat,parts) ;
   same : Id MP.Ringed ringed pi =
    idJ (DL.Hom X.lattice Y.lattice) pi.lat
     (\ lat2 p2 -> Id MP.Ringed (EQ.from-total (lat2,Pr.subst (DL.Hom X.lattice Y.lattice) EQ.Parts pi.lat lat2 p2 (pi.sharp,pi.natural))) pi)
     (EQ.from-to pi) lat p ;
   iso (i : IM.IsIso pi) : IM.IsIso ringed = Pr.subst MP.Ringed IM.IsIso pi ringed (sym same) i ;
  } ;
 } ;
 module Fixed (Y : SI.Structures X.lattice)
  (s : At[new SP.Space[X.lattice,Y]].EQ.Sharp (DL.identity X.lattice))
  (n : At[new SP.Space[X.lattice,Y]].EQ.Natural (DL.identity X.lattice) s)
  (eq : (u : X.lattice.L) -> Pr.isEquiv (X.structure.sheaf.ring u).R (Y.sheaf.ring u).R (RM.map (s u))) {
  module A = At[new SP.Space[X.lattice,Y]] ;
  module GO = RingedLattice[l].On[X.lattice].Of[Y.sheaf] ;
  module PI = PresheafIdentity[l].Over[X.lattice] ;
  family : PI.F.Relation (PI.fields X.structure.sheaf).1 (PI.fields Y.sheaf).1 = \ u ->
   RI.of-hom (X.structure.sheaf.ring u,X.structure.sheaf.ring-set u) (Y.sheaf.ring u,Y.sheaf.ring-set u) (s u) (eq u) ;
  natural : PI.Compare[(PI.fields X.structure.sheaf).1,(PI.fields Y.sheaf).1,(PI.fields X.structure.sheaf).2,(PI.fields Y.sheaf).2,family].Natural = \ u v k x ->
   trans (sym (n u v k x)) (GO.res-irr u v (DL.JoinMaps[X.lattice,X.lattice,DL.identity X.lattice].monotone u v k) k (RM.map (s v) x)) ;
  local-iso : LocalIdentity[l].Over[X.lattice].LIso X.structure Y = (family,natural) ;
  e : SI.RIso X (new SP.Space[X.lattice,Y]) = (refl X.lattice,local-iso) ;
  pi : A.MP.Ringed = new A.MP.Ringed[DL.identity X.lattice,s,n] ;
  section (u : X.lattice.L) (x : (X.structure.sheaf.ring u).R) :
   Id (Y.sheaf.ring u).R (GO.restrict u u (DL.Order[X.lattice].le-refl u) (RM.map ((SI.ringed X (new SP.Space[X.lattice,Y]) e).sharp u) x)) (RM.map (s u) x) =
   trans (Y.sheaf.res-id u (DL.Order[X.lattice].le-refl u) (RM.map ((SI.ringed X (new SP.Space[X.lattice,Y]) e).sharp u) x))
    (ap (\ h -> RM.map h x) (RI.hom-of (X.structure.sheaf.ring u,X.structure.sheaf.ring-set u) (Y.sheaf.ring u,Y.sheaf.ring-set u) (s u) (eq u))) ;
  same : Id A.MP.Ringed (SI.ringed X (new SP.Space[X.lattice,Y]) e) pi =
   A.EQ.ext _ _ (\ u -> refl u) (\ u -> DL.Order[X.lattice].le-refl u) section ;
 } ;
 Goal (M : DL.DLat) (e : LI.LIso X.lattice M) : U l+ =
  (Y : SI.Structures M)
  (s : At[new SP.Space[M,Y]].EQ.Sharp (LI.hom X.lattice M e))
  (n : At[new SP.Space[M,Y]].EQ.Natural (LI.hom X.lattice M e) s)
  (eq : (u : X.lattice.L) -> Pr.isEquiv (X.structure.sheaf.ring u).R (Y.sheaf.ring (DL.hmap (LI.hom X.lattice M e) u)).R (RM.map (s u))) ->
  At[new SP.Space[M,Y]].Witness (new At[new SP.Space[M,Y]].MP.Ringed[LI.hom X.lattice M e,s,n]) ;
 base : Goal X.lattice (LI.id-iso X.lattice) = \ Y s n eq -> (Fixed[Y,s,n,eq].e,Fixed[Y,s,n,eq].same) ;
 recover-lattice (M : DL.DLat) (e : LI.LIso X.lattice M) : Goal M e = LI.Fd.iso-ind X.lattice Goal base M e ;
 module Recover (Y : SP.Space) (pi : At[Y].MP.Ringed) (iso : At[Y].IM.IsIso pi) {
  lattice-iso : LI.LIso X.lattice Y.lattice = LI.of-hom X.lattice Y.lattice pi.lat iso.1 ;
  module N = At[Y].Change[pi,LI.hom X.lattice Y.lattice lattice-iso,sym (LI.hom-of X.lattice Y.lattice pi.lat iso.1)] ;
  normalised : At[new SP.Space[Y.lattice,Y.structure]].Witness N.ringed =
   recover-lattice Y.lattice lattice-iso Y.structure N.parts.1 N.parts.2 (N.iso iso).2 ;
 } ;
 recover-record : (Y : SP.Space) (pi : At[Y].MP.Ringed) (iso : At[Y].IM.IsIso pi) -> At[Y].Witness pi = split {
  Space M Y -> \ pi iso -> (Recover[new SP.Space[M,Y],pi,iso].normalised.1,
   trans Recover[new SP.Space[M,Y],pi,iso].normalised.2 Recover[new SP.Space[M,Y],pi,iso].N.same) } ;
} ;
