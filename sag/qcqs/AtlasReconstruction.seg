-- Apply finite transition gluing to the extracted atlas laws.
-- Its chart e_i is isomorphic to X_i.  Compose this isomorphism's
-- functor equivalence with GeometricOpens.Realisation to obtain
-- beta_i:h_Xi ~= |V_i|, where V_i classifies e_i in h_X.
-- The factorisation triangle says that beta_i's underlying point is
-- projection_i composed with the input point.  Thus these chart maps
-- are injective on affine points.  Projection pulls e_j back to d_ij,
-- so the original and reconstructed classifiers agree on every chart.
-- Forward and backward overlap compatibility are proved next, using
-- this classifier equation and FiniteLocalGlue.OverlapAgreement.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (F : SF.SetFunctor) (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (as : Fin n -> T.Test)
 (es : (i : Fin n) -> TE.NaturalEquivalence SF.Representable[as i].functor OpenRealisation[l].Over[F,us i].functor) {
 module S = AtlasSections[l].Over[F,n,us,as,es] ;
 module D = S.D ;
 module L = S.L ;
 module G = L.G ;
 X : SP.Space = G.space ;
 module H = SF.Geometric[X] ;
 module GO = GeometricOpens[l].Over[X] ;
 e (i : Fin n) : X.lattice.L = L.TL.chart i ;
 vs (i : Fin n) : GO.C.Open = GO.classifier (e i) ;
 module At (i : Fin n) {
  module UO = D.Entry[i].C.UO ;
  module VO = GO.Realisation[e i] ;
  module CI = S.Glued.AtChart[i] ;
  module E = GeometricEquivalence[l].Over[D.X i,Op.space X (e i),CI.morphism,CI.iso] ;
  beta : TE.NaturalEquivalence SF.Geometric[D.X i].functor VO.R.functor =
   TE.Composite[SF.Geometric[D.X i].functor,SF.Geometric[Op.space X (e i)].functor,VO.R.functor,E.equivalence,VO.equivalence].equivalence ;
  triangle : Id (SP.Hom (D.X i) G.space)
   (SP.compose (D.X i) (Op.space G.space (L.TL.chart i)) G.space (Op.inclusion G.space (L.TL.chart i)) CI.morphism) G.Projection[i].morphism =
   SP.ext (D.X i) G.space _ _ CI.B.factor-cut ;
  inclusion (B : T.Test) (p : SP.Hom (T.space B) (D.X i)) : H.functor.obj B =
   SP.compose (T.space B) (D.X i) X G.Projection[i].morphism p ;
  beta-point (B : T.Test) (p : SP.Hom (T.space B) (D.X i)) : Id (H.functor.obj B)
   (VO.R.point {B} (SF.Transform[SF.Geometric[D.X i].functor,VO.R.functor].at (TE.forward beta) B p)) (inclusion B p) =
   trans SP.Associativity[T.space B,D.X i,Op.space X (e i),X,Op.inclusion X (e i),CI.morphism,p].assoc
    (ap (\ f -> SP.compose (T.space B) (D.X i) X f p) triangle) ;
  opaque beta ;
  member (B : T.Test) (p : SP.Hom (T.space B) (D.X i)) : VO.R.Member B (inclusion B p) =
   Prelude[l].subst (H.functor.obj B) (VO.R.Member B) _ _ (beta-point B p)
    (VO.R.member {B} (SF.Transform[SF.Geometric[D.X i].functor,VO.R.functor].at (TE.forward beta) B p)) ;
  injective (B : T.Test) (p q : SP.Hom (T.space B) (D.X i))
   (eq : Id (H.functor.obj B) (inclusion B p) (inclusion B q)) : Id (SP.Hom (T.space B) (D.X i)) p q =
   Iso[l].injective _ _ (SF.Transform[SF.Geometric[D.X i].functor,VO.R.functor].at (TE.forward beta) B) (TE.equiv-at beta B) p q
    (VO.R.point-ext B _ _ (trans (beta-point B p) (trans eq (sym (beta-point B q))))) ;
 } ;
 projection-open (i j : Fin n) : Id (D.X i).lattice.L
  (DL.hmap (SP.underlying G.Projection[i].morphism).lat (e j)) (D.d i j) = L.TL.chart-at j i ;
 classifier (i j : Fin n) (B : T.Test) (p : SP.Hom (T.space B) (D.X i)) : Id T.At[B].Z.lattice.L
  (GO.C.value (vs j) B (At[i].inclusion B p)) (CO.Over[F].value (us j) B (D.point i B p)) =
  trans (ap (DL.hmap (SP.underlying p).lat) (projection-open i j)) (D.Pair[i,j].W.classifier B p) ;
 covers (B : T.Test) (p : H.functor.obj B) : Id T.At[B].Z.lattice.L
  (T.At[B].Z.J.bigJ n (\ i -> GO.C.value (vs i) B p)) T.At[B].Z.lattice.top =
  trans (sym (DL.JoinMaps[X.lattice,(T.space B).lattice,(SP.underlying {T.space B} {X} p).lat].preserves n e))
   (trans (ap (DL.hmap (SP.underlying {T.space B} {X} p).lat) (L.R.FL.O.le-antisym _ _ (L.R.FL.O.le-top (L.R.FL.J.bigJ n e)) L.TL.covers))
    (DL.hmap-top (SP.underlying {T.space B} {X} p).lat)) ;
 qcqs : Qcqs[l].Over[X.lattice,X.structure].IsQcqs =
  S.Glued.AffineInputs[\ i -> AffineQcqs[l].TestSpace[as i].affine].qcqs ;
} ;
