-- The global sections of the doubled-origin line (DESIGN.md, Next 3).
-- k is any ring, A = k[X], Spec A with the fractions A[1/g] (Affine), and
-- the doubled-origin line along D(X) (DoubledLine, Doubling).  A global
-- section is a pair (s, t) of sections of Spec A over top agreeing on
-- top /\ D(X).
--
-- Lemma (kernel).  f_X : A -> A[1/X] is injective (VariableKernel).
-- Lemma (separate).  Two global sections s, t of Spec A with the same
--  component at D(X) are equal: s = a|top and t = b|top for a = evaluate s,
--  b = evaluate t (Global), and f_X(a) = s_X = t_X = f_X(b).
-- Theorem (equal components).  For a global section (s, t) of the doubled
--  line, s = t: the components of s and t at D(X) <= top /\ D(X) are those
--  of their restrictions to top /\ D(X), which agree.
-- Corollary (the canonical isomorphism).  a |-> (a|top, a|top) is a ring
--  isomorphism A -> Gamma, with inverse (s, t) |-> evaluate s: the pair
--  agrees on the overlap (restrictions along two witnesses of the same
--  inequality), and (evaluate s)|top = s = t.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module DLn = DoubledLine[l].Over[k,setk] ;
 module P = DLn.P ;
 module Z = DLn.Z ;
 module AF = Affine[l].Over[P.ring] ;
 module S = Sections[l].Over[P.ring,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;
 module Gb = Global[l].Over[P.ring,P.set,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;
 module Dbl = DLn.Dbl ;
 module DD = Dbl.DD ;
 module O = DL.Order[Z.lattice] ;

 -- f_X is injective
 module VK = VariableKernel[l].Over[k,setk] ;

 -- global sections of Spec A are determined by their component at D(X)
 kX : O.Le (Z.D P.variable) Z.lattice.top = O.le-top (Z.D P.variable) ;
 at-X (s : S.Section Z.lattice.top) :
  Id (AF.Loc P.variable).R (map (AF.inclusion P.variable) (Gb.evaluate s)) (S.at s P.variable kX) =
  trans (sym (Gb.Of[Z.lattice.top].section-at (Gb.evaluate s) P.variable kX))
   (ap (\ t -> S.at t P.variable kX) (Gb.global-evaluate s)) ;
 separate (s t : S.Section Z.lattice.top) (e : Id (AF.Loc P.variable).R (S.at s P.variable kX) (S.at t P.variable kX)) :
  Id (S.Section Z.lattice.top) s t = calc (S.Section Z.lattice.top) {
  s =< sym (Gb.global-evaluate s) > map Gb.global (Gb.evaluate s)
   =< ap (map Gb.global) (VK.Kernel[Gb.evaluate s,Gb.evaluate t,trans (at-X s) (trans e (sym (at-X t)))].equal)
    > map Gb.global (Gb.evaluate t)
   =< Gb.global-evaluate t > t } ;

 -- the two components of a global section of the doubled line are equal
 mX : O.Le (Z.D P.variable) (DD.mid DD.topD) =
  O.meet-glb Z.lattice.top DLn.punctured (Z.D P.variable) kX (O.le-refl (Z.D P.variable)) ;
 -- the component at D(X) of a restriction to top /\ D(X)
 restricted-at (s : S.Section Z.lattice.top) (w : O.Le (DD.mid DD.topD) Z.lattice.top) :
  Id (AF.Loc P.variable).R (S.at (S.restrict (DD.mid DD.topD) Z.lattice.top w s) P.variable mX) (S.at s P.variable kX) =
  trans (S.restrict-at (DD.mid DD.topD) Z.lattice.top w s P.variable mX)
   (S.component-irr Z.lattice.top s P.variable (O.le-trans (Z.D P.variable) (DD.mid DD.topD) Z.lattice.top mX w) kX) ;
 equal-components (z : (Dbl.ring DD.topD).R) : Id (S.Section Z.lattice.top) (Dbl.left DD.topD z) (Dbl.right DD.topD z) =
  separate (Dbl.left DD.topD z) (Dbl.right DD.topD z) (calc (AF.Loc P.variable).R {
   S.at (Dbl.left DD.topD z) P.variable kX
    =< sym (restricted-at (Dbl.left DD.topD z) (DD.mid-first DD.topD))
     > S.at (S.restrict (DD.mid DD.topD) Z.lattice.top (DD.mid-first DD.topD) (Dbl.left DD.topD z)) P.variable mX
    =< ap (\ t -> S.at t P.variable mX) (Dbl.agree DD.topD z)
     > S.at (S.restrict (DD.mid DD.topD) Z.lattice.top (DD.mid-second DD.topD) (Dbl.right DD.topD z)) P.variable mX
    =< restricted-at (Dbl.right DD.topD z) (DD.mid-second DD.topD) > S.at (Dbl.right DD.topD z) P.variable kX }) ;

 -- the canonical isomorphism A -> Gamma, a |-> (a|top, a|top)
 module FP = Dbl.At[DD.topD].P ;
 agree-diagonal (a : P.ring.R) : FP.Agree (map Gb.global a) (map Gb.global a) =
  Dbl.GO.res-irr (DD.mid DD.topD) Z.lattice.top (DD.mid-first DD.topD) (DD.mid-second DD.topD) (map Gb.global a) ;
 module Dg = FP.Lift[P.ring,Gb.global,Gb.global,agree-diagonal] ;
 diagonal : RH.Hom P.ring (Dbl.ring DD.topD) = Dg.lift ;
 back (z : (Dbl.ring DD.topD).R) : P.ring.R = Gb.evaluate (Dbl.left DD.topD z) ;
 back-diagonal (a : P.ring.R) : Id P.ring.R (back (map diagonal a)) a = calc P.ring.R {
  back (map diagonal a) =< ap Gb.evaluate (Dg.left-lift a) > Gb.evaluate (map Gb.global a)
   =< Gb.evaluate-global a > a } ;
 diagonal-back (z : (Dbl.ring DD.topD).R) : Id (Dbl.ring DD.topD).R (map diagonal (back z)) z =
  Dbl.ext DD.topD (map diagonal (back z)) z
   (trans (Dg.left-lift (back z)) (Gb.global-evaluate (Dbl.left DD.topD z)))
   (trans (Dg.right-lift (back z)) (trans (Gb.global-evaluate (Dbl.left DD.topD z)) (equal-components z))) ;
 iso : Pr.isEquiv P.ring.R (Dbl.ring DD.topD).R (map diagonal) =
  Pr.qinv P.ring.R (Dbl.ring DD.topD).R (map diagonal) back diagonal-back back-diagonal ;
} ;
