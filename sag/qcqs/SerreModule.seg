-- Small modules for the external Serre criterion (note, Section 3).
-- A module is a set with an abelian addition and a unital distributive
-- action of the specified commutative ring.  Elementary cancellation and
-- zero/negative action laws follow from these axioms, without ring solving.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) {
 record Module {
  M : U l ;
  setM : Pr.isSet M ;
  mz : M ;
  madd : M -> M -> M ;
  mneg : M -> M ;
  maddA (x y z : M) : Id M (madd x (madd y z)) (madd (madd x y) z) ;
  maddC (x y : M) : Id M (madd x y) (madd y x) ;
  maddZ (x : M) : Id M (madd x mz) x ;
  maddN (x : M) : Id M (madd x (mneg x)) mz ;
  sm : A.R -> M -> M ;
  smA (a b : A.R) (x : M) : Id M (sm a (sm b x)) (sm (A.mul a b) x) ;
  smO (x : M) : Id M (sm A.o x) x ;
  smD (a : A.R) (x y : M) : Id M (sm a (madd x y)) (madd (sm a x) (sm a y)) ;
  smE (a b : A.R) (x : M) : Id M (sm (A.add a b) x) (madd (sm a x) (sm b x)) ;
 } ;
 module Laws (Md : Module) {
  open Md ;
  zero-left (x : M) : Id M (madd mz x) x = trans (maddC mz x) (maddZ x) ;
  cancel (x y : M) (h : Id M (madd x y) x) : Id M y mz = calc M {
   y =< sym (maddZ y) > madd y mz
    =< ap (madd y) (sym (maddN x)) > madd y (madd x (mneg x))
    =< maddA y x (mneg x) > madd (madd y x) (mneg x)
    =< ap (\ z -> madd z (mneg x)) (maddC y x) > madd (madd x y) (mneg x)
    =< ap (\ z -> madd z (mneg x)) h > madd x (mneg x)
    =< maddN x > mz } ;
  neg-unique (x y : M) (h : Id M (madd x y) mz) : Id M y (mneg x) = calc M {
   y =< sym (maddZ y) > madd y mz
    =< ap (madd y) (sym (maddN x)) > madd y (madd x (mneg x))
    =< maddA y x (mneg x) > madd (madd y x) (mneg x)
    =< ap (\ z -> madd z (mneg x)) (maddC y x) > madd (madd x y) (mneg x)
    =< ap (\ z -> madd z (mneg x)) h > madd mz (mneg x)
    =< zero-left (mneg x) > mneg x } ;
  neg-zero : Id M (mneg mz) mz = sym (neg-unique mz mz (maddZ mz)) ;
  sm-zero (a : A.R) : Id M (sm a mz) mz =
   cancel (sm a mz) (sm a mz) (trans (sym (smD a mz mz)) (ap (sm a) (maddZ mz))) ;
  zero-sm (x : M) : Id M (sm A.z x) mz =
   cancel (sm A.z x) (sm A.z x) (trans (sym (smE A.z A.z x)) (ap (\ a -> sm a x) (A.addZ A.z))) ;
  sm-neg (a : A.R) (x : M) : Id M (sm a (mneg x)) (mneg (sm a x)) =
   neg-unique (sm a x) (sm a (mneg x))
    (trans (sym (smD a x (mneg x))) (trans (ap (sm a) (maddN x)) (sm-zero a))) ;
  sm-swap (a b : A.R) (x : M) : Id M (sm a (sm b x)) (sm b (sm a x)) =
   trans (smA a b x) (trans (ap (\ c -> sm c x) (A.mulC a b)) (sym (smA b a x))) ;
  swap-four (a b c d : M) : Id M (madd (madd a b) (madd c d)) (madd (madd a c) (madd b d)) = calc M {
   madd (madd a b) (madd c d)
    =< sym (maddA a b (madd c d)) > madd a (madd b (madd c d))
    =< ap (madd a) (maddA b c d) > madd a (madd (madd b c) d)
    =< ap (\ x -> madd a (madd x d)) (maddC b c) > madd a (madd (madd c b) d)
    =< ap (madd a) (sym (maddA c b d)) > madd a (madd c (madd b d))
    =< maddA a c (madd b d) > madd (madd a c) (madd b d) } ;
  sub (x y : M) : M = madd x (mneg y) ;
  sub-self (x : M) : Id M (sub x x) mz = maddN x ;
  sub-zero (x y : M) (h : Id M (sub x y) mz) : Id M x y = calc M {
   x =< sym (maddZ x) > madd x mz
    =< ap (madd x) (sym (trans (maddC (mneg y) y) (maddN y))) > madd x (madd (mneg y) y)
    =< maddA x (mneg y) y > madd (sub x y) y
    =< ap (\ z -> madd z y) h > madd mz y
    =< zero-left y > y } ;
  sm-sub (a : A.R) (x y : M) : Id M (sm a (sub x y)) (sub (sm a x) (sm a y)) =
   trans (smD a x (mneg y)) (ap (madd (sm a x)) (sm-neg a y)) ;
  sub-at (x y : M) : Id M (sub x y) (madd x (mneg y)) = refl (sub x y) ;
  opaque sub ;
 } ;
 regular (setA : Pr.isSet A.R) : Module = new Module[A.R,setA,A.z,A.add,A.neg,
  A.addA,A.addC,A.addZ,A.addN,A.mul,A.mulA,
  \ x -> trans (A.mulC A.o x) (A.mulO x),A.dist,
  \ a b x -> trans (A.mulC (A.add a b) x)
   (trans (A.dist x a b) (cong2 A.R A.add _ _ _ _ (A.mulC x a) (A.mulC x b)))] ;
 regular-at (setA : Pr.isSet A.R) (x : A.R) : Id (regular setA).M x x = refl x ;
} ;
