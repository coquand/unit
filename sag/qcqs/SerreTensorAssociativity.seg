-- A trilinear map extends in two steps via a linear-map module.
-- Thus the two parenthesisations of a triple tensor are canonically
-- isomorphic, and comparisons of their arrows reduce to pure triples.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ;
module Bil = SerreBilinear[l] ; module TU = SerreTensorUniversal[l] ;
module Over (A : CRing) {
 module S = SM.Over[A] ; module L = Bil.Over[A] ;
 module Extend (M N P Q : S.Module) (p : L.Maps[M,N,L.Hom[P,Q].space].Pairing) {
  module MN = TU.Over[A,M,N] ; module H = L.Hom[P,Q] ;
  module E = MN.Into[H.space,p] ;
  pairing : L.Maps[MN.T.tensor,P,Q].Pairing = new L.Maps[MN.T.tensor,P,Q].Pairing[
   \ t z -> (E.lift.fn t).fn z,
   \ t t' z -> ap (\ f -> f.fn z) (E.lift.additive t t'),
   \ a t z -> ap (\ f -> f.fn z) (E.lift.scalar a t),
   \ t z z' -> (E.lift.fn t).additive z z',
   \ a t z -> (E.lift.fn t).scalar a z] ;
  beta (x : M.M) (y : N.M) (z : P.M) :
   Id Q.M (pairing.value (MN.T.pure x y) z) ((p.value x y).fn z) = ap (\ f -> f.fn z) (E.beta x y) ;
 } ;
 module At (M N P : S.Module) {
  module MN = TU.Over[A,M,N] ; module NP = TU.Over[A,N,P] ;
  module A0 = TU.Over[A,MN.T.tensor,P] ; module A1 = TU.Over[A,M,NP.T.tensor] ;
  Lhs : S.Module = A0.T.tensor ;
  Rhs : S.Module = A1.T.tensor ;
  module EqualLeft (Q : S.Module) (f g : L.Linear[Lhs,Q].H.Hom)
   (p : (x : M.M) (y : N.M) (z : P.M) ->
    Id Q.M (f.fn (A0.T.pure (MN.T.pure x y) z)) (g.fn (A0.T.pure (MN.T.pure x y) z))) {
   module Inner (z : P.M) {
    lin : L.Linear[MN.T.tensor,Lhs].H.Hom = A0.T.Pair.left A0.T.pairing z ;
    module E = MN.Equal[Q,L.Composite[MN.T.tensor,Lhs,Q,lin,f].map,L.Composite[MN.T.tensor,Lhs,Q,lin,g].map,\ x y -> p x y z] ;
   } ;
   module Outer = A0.Equal[Q,f,g,\ t z -> Inner[z].E.at t] ;
   at : (x : Lhs.M) -> Id Q.M (f.fn x) (g.fn x) = Outer.at ;
   equal : Id L.Linear[Lhs,Q].H.Hom f g = Outer.equal ;
  } ;
  module EqualRight (Q : S.Module) (f g : L.Linear[Rhs,Q].H.Hom)
   (p : (x : M.M) (y : N.M) (z : P.M) ->
    Id Q.M (f.fn (A1.T.pure x (NP.T.pure y z))) (g.fn (A1.T.pure x (NP.T.pure y z)))) {
   module Inner (x : M.M) {
    lin : L.Linear[NP.T.tensor,Rhs].H.Hom = A1.T.Pair.right A1.T.pairing x ;
    module E = NP.Equal[Q,L.Composite[NP.T.tensor,Rhs,Q,lin,f].map,L.Composite[NP.T.tensor,Rhs,Q,lin,g].map,p x] ;
   } ;
   module Outer = A1.Equal[Q,f,g,\ x t -> Inner[x].E.at t] ;
   at : (x : Rhs.M) -> Id Q.M (f.fn x) (g.fn x) = Outer.at ;
   equal : Id L.Linear[Rhs,Q].H.Hom f g = Outer.equal ;
  } ;
  module H1 = L.Hom[P,Rhs] ;
  to-value (x : M.M) (y : N.M) : H1.H.Hom =
   L.Composite[P,NP.T.tensor,Rhs,NP.T.Pair.right NP.T.pairing y,A1.T.Pair.right A1.T.pairing x].map ;
  to-inner : L.Maps[M,N,H1.space].Pairing = new L.Maps[M,N,H1.space].Pairing[to-value,
   \ x x' y -> H1.ext _ _ (\ z -> A1.T.pairing.add-left x x' (NP.T.pure y z)),
   \ a x y -> H1.ext _ _ (\ z -> A1.T.pairing.scale-left a x (NP.T.pure y z)),
   \ x y y' -> H1.ext _ _ (\ z -> trans (ap (A1.T.pure x) (NP.T.pairing.add-left y y' z))
    (A1.T.pairing.add-right x (NP.T.pure y z) (NP.T.pure y' z))),
   \ a x y -> H1.ext _ _ (\ z -> trans (ap (A1.T.pure x) (NP.T.pairing.scale-left a y z))
    (A1.T.pairing.scale-right a x (NP.T.pure y z)))] ;
  module E1 = Extend[M,N,P,Rhs,to-inner] ;
  module To = A0.Into[Rhs,E1.pairing] ;
  to-beta (x : M.M) (y : N.M) (z : P.M) :
   Id Rhs.M (To.lift.fn (A0.T.pure (MN.T.pure x y) z)) (A1.T.pure x (NP.T.pure y z)) =
   trans (To.beta (MN.T.pure x y) z) (E1.beta x y z) ;
  module H0 = L.Hom[M,Lhs] ;
  back-value (y : N.M) (z : P.M) : H0.H.Hom =
   L.Composite[M,MN.T.tensor,Lhs,MN.T.Pair.left MN.T.pairing y,A0.T.Pair.left A0.T.pairing z].map ;
  back-inner : L.Maps[N,P,H0.space].Pairing = new L.Maps[N,P,H0.space].Pairing[back-value,
   \ y y' z -> H0.ext _ _ (\ x -> trans (ap (\ t -> A0.T.pure t z) (MN.T.pairing.add-right x y y'))
    (A0.T.pairing.add-left (MN.T.pure x y) (MN.T.pure x y') z)),
   \ a y z -> H0.ext _ _ (\ x -> trans (ap (\ t -> A0.T.pure t z) (MN.T.pairing.scale-right a x y))
    (A0.T.pairing.scale-left a (MN.T.pure x y) z)),
   \ y z z' -> H0.ext _ _ (\ x -> A0.T.pairing.add-right (MN.T.pure x y) z z'),
   \ a y z -> H0.ext _ _ (\ x -> A0.T.pairing.scale-right a (MN.T.pure x y) z)] ;
  module E0 = Extend[N,P,M,Lhs,back-inner] ;
  module Back = A1.Into[Lhs,L.Swap[NP.T.tensor,M,Lhs,E0.pairing].pairing] ;
  back-beta (x : M.M) (y : N.M) (z : P.M) :
   Id Lhs.M (Back.lift.fn (A1.T.pure x (NP.T.pure y z))) (A0.T.pure (MN.T.pure x y) z) =
   trans (Back.beta x (NP.T.pure y z)) (E0.beta y z x) ;
  right (t : Rhs.M) : Id Rhs.M (To.lift.fn (Back.lift.fn t)) t =
   EqualRight[Rhs,L.Composite[Rhs,Lhs,Rhs,Back.lift,To.lift].map,L.identity Rhs,
    \ x y z -> trans (ap To.lift.fn (back-beta x y z)) (to-beta x y z)].at t ;
  left (t : Lhs.M) : Id Lhs.M (Back.lift.fn (To.lift.fn t)) t =
   EqualLeft[Lhs,L.Composite[Lhs,Rhs,Lhs,To.lift,Back.lift].map,L.identity Lhs,
    \ x y z -> trans (ap Back.lift.fn (to-beta x y z)) (back-beta x y z)].at t ;
  equiv : Pr.isEquiv Lhs.M Rhs.M To.lift.fn = Pr.qinv Lhs.M Rhs.M To.lift.fn Back.lift.fn right left ;
  reverse-equiv : Pr.isEquiv Rhs.M Lhs.M Back.lift.fn = Pr.qinv Rhs.M Lhs.M Back.lift.fn To.lift.fn left right ;
 } ;
} ;
