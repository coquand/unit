-- Compact opens of an arbitrary test functor F are natural maps F -> Zar.
-- Their lattice operations are pointwise.  Naturality of bottom/top is
-- preservation of bottom/top by the Zariski map; for joins/meets apply
-- the two naturality equations then its join/meet law.  The nine lattice
-- laws are pointwise laws in Zar(A), followed by transformation ext.
-- The lattice lives in U (l+1); small values do not make its carrier small.
-- Pullback along a natural map is composition, preserves the operations
-- pointwise, and is a lattice map.  On the representable h_A, Yoneda
-- identifies compact opens with the small Zariski lattice of A.
level l ; open Ring[l] ; open Presentations[l] ;
module Hi = Prelude[l+] ;
module DL = DistLattice[l] ;
module Big = DistLattice[l+] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module ZF = ZariskiFunctor[l] ;
module Over (F : SF.SetFunctor) {
 module N = SF.Transform[F,ZF.functor] ;
 Open : U l+ = N.Nat ;
 value (u : Open) (A : T.Test) (x : F.obj A) : ZariskiLattice[l].Over[A.ring].lattice.L = N.at u A x ;
 bottom : Open = (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.bot,
  \ A B h x -> sym (DL.hmap-bot ZF.OnMap[A,B,h].lattice-map)) ;
 whole : Open = (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.top,
  \ A B h x -> sym (DL.hmap-top ZF.OnMap[A,B,h].lattice-map)) ;
 join (u v : Open) : Open = (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.join (value u A x) (value v A x),
  \ A B h x -> trans
   (cong2 ZF.OnMap[A,B,h].ZB.lattice.L ZF.OnMap[A,B,h].ZB.lattice.join _ _ _ _ (N.natural u A B h x) (N.natural v A B h x))
   (sym (DL.hmap-join ZF.OnMap[A,B,h].lattice-map (value u A x) (value v A x)))) ;
 meet (u v : Open) : Open = (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.meet (value u A x) (value v A x),
  \ A B h x -> trans
   (cong2 ZF.OnMap[A,B,h].ZB.lattice.L ZF.OnMap[A,B,h].ZB.lattice.meet _ _ _ _ (N.natural u A B h x) (N.natural v A B h x))
   (sym (DL.hmap-meet ZF.OnMap[A,B,h].lattice-map (value u A x) (value v A x)))) ;
 lattice : Big.DLat = new Big.DLat[Open,N.set,bottom,whole,join,meet,
  \ u v w -> N.ext (join u (join v w)) (join (join u v) w) (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.joinA (value u A x) (value v A x) (value w A x)),
  \ u v -> N.ext (join u v) (join v u) (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.joinC (value u A x) (value v A x)),
  \ u -> N.ext (join u bottom) u (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.joinB (value u A x)),
  \ u v w -> N.ext (meet u (meet v w)) (meet (meet u v) w) (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.meetA (value u A x) (value v A x) (value w A x)),
  \ u v -> N.ext (meet u v) (meet v u) (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.meetC (value u A x) (value v A x)),
  \ u -> N.ext (meet u whole) u (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.meetT (value u A x)),
  \ u v -> N.ext (meet u (join u v)) u (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.absorb-meet (value u A x) (value v A x)),
  \ u v -> N.ext (join u (meet u v)) u (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.absorb-join (value u A x) (value v A x)),
  \ u v w -> N.ext (meet u (join v w)) (join (meet u v) (meet u w)) (\ A x -> ZariskiLattice[l].Over[A.ring].lattice.dist (value u A x) (value v A x) (value w A x))] ;
} ;
module Pullback (F G : SF.SetFunctor) (alpha : SF.Transform[F,G].Nat) {
 module CF = Over[F] ;
 module CG = Over[G] ;
 module FG = SF.Transform[F,G] ;
 pull (u : CG.Open) : CF.Open = SF.Composite[F,G,ZF.functor,u,alpha].composite ;
 at (u : CG.Open) (A : T.Test) (x : F.obj A) : Id (ZF.functor.obj A) (CF.value (pull u) A x) (CG.value u A (FG.at alpha A x)) =
  refl (CG.value u A (FG.at alpha A x)) ;
 lattice-map : Big.Hom CG.lattice CF.lattice =
  (pull,CF.N.ext (pull CG.bottom) CF.bottom (\ A x -> refl (ZariskiLattice[l].Over[A.ring].lattice.bot)),
   CF.N.ext (pull CG.whole) CF.whole (\ A x -> refl (ZariskiLattice[l].Over[A.ring].lattice.top)),
   \ u v -> CF.N.ext (pull (CG.join u v)) (CF.join (pull u) (pull v)) (\ A x -> refl (ZariskiLattice[l].Over[A.ring].lattice.join (CG.value u A (FG.at alpha A x)) (CG.value v A (FG.at alpha A x)))),
   \ u v -> CF.N.ext (pull (CG.meet u v)) (CF.meet (pull u) (pull v)) (\ A x -> refl (ZariskiLattice[l].Over[A.ring].lattice.meet (CG.value u A (FG.at alpha A x)) (CG.value v A (FG.at alpha A x))))) ;
} ;
module OnAffine (A : T.Test) {
 module Y = TestYoneda[l].Over[A,ZF.functor] ;
 equivalence : Hi.Equiv Over[SF.Representable[A].functor].Open ZariskiLattice[l].Over[A.ring].lattice.L = Y.equivalence ;
} ;
