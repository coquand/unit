-- Localisation preserves every finite product (Serre note, Section 3).
-- Localise each projection. A finite family of fractions has a common
-- denominator: choose representatives merely, bound their exponents,
-- and raise their numerators. The resulting tuple is a preimage.
-- An equality of projected fractions has finitely many equality witnesses;
-- bound those exponents too to obtain one equality in the tuple module.
-- Thus comparison fibres are propositions and inhabited, giving an inverse.
-- Empty products are included in both finite-choice arguments.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module MP = SerreModuleProducts[l] ; module LS = SerreModuleLocalisationStructure[l] ;
module LL = SerreModuleLocalisationLinear[l] ; module NB = NatBound[l] ;
module At (A : CRing) (n : Nat) (Ms : Fin n -> SM.Over[A].Module) (f : A.R) {
 module Original = MP.Over[A,Fin n,Ms] ;
 module S = LS.At[A,Original.product,f] ;
 module Coordinate (i : Fin n) {
  module L = LS.At[A,Ms i,f] ;
  module Map = LL.Along[A,A,RingHom[l].identity A,Original.product,Ms i,Original.projection i,f] ;
 } ;
 module Target = MP.Over[A,Fin n,\ i -> Coordinate[i].L.localised] ;
 forward (x : S.L.Carrier) : Target.Carrier = \ i -> Coordinate[i].Map.Maps.map Coordinate[i].Map.induced x ;
 on-fractions (x : Original.Carrier) (p : Nat) (i : Fin n) :
  Id Coordinate[i].L.L.Carrier (forward (S.L.fraction x p) i) (Coordinate[i].L.L.fraction (x i) p) =
  trans (Coordinate[i].Map.induced-at x p)
   (ap (\ a -> Coordinate[i].L.L.fraction a p) (Original.projection-at i x)) ;
 power-component (p : Nat) (x : Original.Carrier) (i : Fin n) :
  Id (Ms i).M (S.L.power p x i) (Coordinate[i].L.L.power p (x i)) =
  trans (sym (Original.projection-at i (S.L.power p x)))
   (trans (Coordinate[i].Map.Map.power-map p x)
    (ap (Coordinate[i].L.L.power p) (Original.projection-at i x))) ;
 module Extend (i : Fin n) (x y : (Ms i).M) (p q e r : Nat)
  (above : NB.Above e r)
  (h : Id (Ms i).M (Coordinate[i].L.L.power (plus e q) x) (Coordinate[i].L.L.power (plus e p) y)) {
  module L = Coordinate[i].L.L ;
  reorder (s : Nat) : Id Nat (plus r s) (plus (NB.excess above) (plus e s)) =
   trans (ap (\ t -> plus t s) (sym (NB.excess-eq above)))
    (trans (ap (\ t -> plus t s) (plus-comm e (NB.excess above))) (NB.plus-assoc (NB.excess above) e s)) ;
  equation : Id (Ms i).M (L.power (plus r q) x) (L.power (plus r p) y) =
   trans (ap (\ t -> L.power t x) (reorder q))
    (trans (L.power-add (NB.excess above) (plus e q) x)
     (trans (ap (L.power (NB.excess above)) h)
      (trans (sym (L.power-add (NB.excess above) (plus e p) y)) (sym (ap (\ t -> L.power t y) (reorder p)))))) ;
 } ;
 module Witnesses (x y : Original.Carrier) (p q : Nat)
  (ws : (i : Fin n) -> Coordinate[i].L.L.Witness (x i,p) (y i,q)) {
  exponents (i : Fin n) : Nat = (ws i).1 ;
  bound : Nat = NB.bound n exponents ;
  witness : S.L.Witness (x,p) (y,q) = (bound,Original.ext _ _ (\ i ->
   trans (power-component (plus bound q) x i)
    (trans Extend[i,x i,y i,p,q,exponents i,bound,NB.bound-above n exponents i,(ws i).2].equation
     (sym (power-component (plus bound p) y i))))) ;
 } ;
 fraction-injective (x y : Original.Carrier) (p q : Nat)
  (h : Id Target.Carrier (forward (S.L.fraction x p)) (forward (S.L.fraction y q))) :
  Id S.L.Carrier (S.L.fraction x p) (S.L.fraction y q) =
  Tr.Trunc[(i : Fin n) -> Coordinate[i].L.L.Witness (x i,p) (y i,q)].induction @l
   (\ t -> Id S.L.Carrier (S.L.fraction x p) (S.L.fraction y q)) (\ t -> S.L.carrier-set _ _)
   (\ ws -> S.L.equal x y p q (Tr.Trunc[S.L.Witness (x,p) (y,q)].inc Witnesses[x,y,p,q,ws].witness))
   (AffineFinite[l].choice n (\ i -> Coordinate[i].L.L.Witness (x i,p) (y i,q))
    (\ i -> Coordinate[i].L.L.detect (x i) (y i) p q
     (trans (sym (on-fractions x p i)) (trans (ap (\ z -> z i) h) (on-fractions y q i))))) ;
 injective (x : S.L.Carrier) : (y : S.L.Carrier) -> Id Target.Carrier (forward x) (forward y) -> Id S.L.Carrier x y =
  S.L.induction @l
   (\ x -> (y : S.L.Carrier) -> Id Target.Carrier (forward x) (forward y) -> Id S.L.Carrier x y)
   (\ x -> FE.isProp-Pi S.L.Carrier (\ y -> Id Target.Carrier (forward x) (forward y) -> Id S.L.Carrier x y)
    (\ y -> FE.isProp-Pi (Id Target.Carrier (forward x) (forward y)) (\ h -> Id S.L.Carrier x y) (\ h -> S.L.carrier-set _ _)))
   (\ x p -> S.L.induction @l
    (\ y -> Id Target.Carrier (forward (S.L.fraction x p)) (forward y) -> Id S.L.Carrier (S.L.fraction x p) y)
    (\ y -> FE.isProp-Pi (Id Target.Carrier (forward (S.L.fraction x p)) (forward y))
     (\ h -> Id S.L.Carrier (S.L.fraction x p) y) (\ h -> S.L.carrier-set _ _))
    (\ y q -> fraction-injective x y p q)) x ;
 Fibre (y : Target.Carrier) : U l = (x : S.L.Carrier) * Id Target.Carrier (forward x) y ;
 fibre-prop (y : Target.Carrier) : Pr.isProp (Fibre y) = \ x z ->
  Pr.Sigma-eq S.L.Carrier (\ x -> Id Target.Carrier (forward x) y) x.1 z.1 x.2 z.2
   (injective x.1 z.1 (trans x.2 (sym z.2))) (Target.product.setM _ _) ;
 Representations (y : Target.Carrier) : U l = (i : Fin n) ->
  (a : (Ms i).M) * (p : Nat) * Id Coordinate[i].L.L.Carrier (Coordinate[i].L.L.fraction a p) (y i) ;
 module Chosen (y : Target.Carrier) (rs : Representations y) {
  exponents (i : Fin n) : Nat = (rs i).2.1 ;
  bound : Nat = NB.bound n exponents ;
  numerator (i : Fin n) : (Ms i).M = Coordinate[i].L.L.power (NB.excess (NB.bound-above n exponents i)) (rs i).1 ;
  fraction-equation (i : Fin n) : Id Coordinate[i].L.L.Carrier (Coordinate[i].L.L.fraction (numerator i) bound) (y i) =
   trans (ap (Coordinate[i].L.L.fraction (numerator i)) (sym (NB.excess-eq (NB.bound-above n exponents i))))
    (trans (Coordinate[i].L.L.raise-right (rs i).1 (exponents i) (NB.excess (NB.bound-above n exponents i))) (rs i).2.2) ;
  source : S.L.Carrier = S.L.fraction numerator bound ;
  equation : Id Target.Carrier (forward source) y = Target.ext _ _
   (\ i -> trans (on-fractions numerator bound i) (fraction-equation i)) ;
 } ;
 inhabited (y : Target.Carrier) : Tr.Trunc[Fibre y].carrier =
  Tr.Trunc[Representations y].induction @l (\ t -> Tr.Trunc[Fibre y].carrier)
   (\ t -> Tr.Trunc[Fibre y].proposition)
   (\ rs -> Tr.Trunc[Fibre y].inc (Chosen[y,rs].source,Chosen[y,rs].equation))
   (AffineFinite[l].choice n
    (\ i -> (a : (Ms i).M) * (p : Nat) * Id Coordinate[i].L.L.Carrier (Coordinate[i].L.L.fraction a p) (y i))
    (\ i -> Coordinate[i].L.L.represented (y i))) ;
 preimage (y : Target.Carrier) : Fibre y = Tr.Trunc[Fibre y].induction @l
  (\ t -> Fibre y) (\ t -> fibre-prop y) (\ t -> t) (inhabited y) ;
 inverse (y : Target.Carrier) : S.L.Carrier = (preimage y).1 ;
 forward-inverse (y : Target.Carrier) : Id Target.Carrier (forward (inverse y)) y = (preimage y).2 ;
 inverse-forward (x : S.L.Carrier) : Id S.L.Carrier (inverse (forward x)) x = injective _ _ (forward-inverse (forward x)) ;
 equivalence : Pr.Equiv S.L.Carrier Target.Carrier =
  (forward,Pr.qinv S.L.Carrier Target.Carrier forward inverse forward-inverse inverse-forward) ;
 module Maps = MM.Between[A,A,RingHom[l].identity A,S.localised,Target.product] ;
 comparison : Maps.Hom = new Maps.Hom[forward,
  \ x y -> Target.ext _ _ (\ i -> Coordinate[i].Map.Maps.map-add Coordinate[i].Map.induced x y),
  \ a x -> Target.ext _ _ (\ i -> Coordinate[i].Map.Maps.map-scale Coordinate[i].Map.induced a x)] ;
 comparison-at (x : S.L.Carrier) : Id Target.Carrier (Maps.map comparison x) (forward x) = refl (forward x) ;
 opaque forward ; opaque inverse ; opaque comparison ;
} ;
