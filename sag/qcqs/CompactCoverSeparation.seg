-- A finite compact-open cover detects equality of maps into a sheaf.
-- Restrict alpha to every U_i.  These restrictions agree on overlaps,
-- since both are alpha(x).  CompactCoverDescent gives a unique extension.
-- Both alpha and beta are extensions when their restrictions agree;
-- its uniqueness therefore identifies them.  The source need not be a
-- sheaf and the cover may be empty.
level l ; open Ring[l] ; open Presentations[l] ;
module Hi = Prelude[l+] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module TS = TestSheaves[l] ;
module Over (F H : SF.SetFunctor) (sheaf : TS.IsSheaf H) (n : Nat) (us : Fin n -> CO.Over[F].Open)
 (covers : (B : T.Test) (x : F.obj B) -> Id T.At[B].Z.lattice.L
  (T.At[B].Z.J.bigJ n (\ i -> CO.Over[F].value (us i) B x)) T.At[B].Z.lattice.top) {
 module N = SF.Transform[F,H] ;
 module D = CompactCoverDescent[l].Over[F,H,sheaf,n,us,covers] ;
 module Compare (alpha beta : N.Nat)
  (on : (i : Fin n) -> Id D.Piece[i].N.Nat
   SF.Composite[D.Piece[i].R.functor,F,H,alpha,D.Piece[i].R.inclusion].composite
   SF.Composite[D.Piece[i].R.functor,F,H,beta,D.Piece[i].R.inclusion].composite) {
  module Family = D.Family[\ i -> SF.Composite[D.Piece[i].R.functor,F,H,alpha,D.Piece[i].R.inclusion].composite] ;
  module G = Family.Glue[\ B x i j mi mj -> refl (N.at alpha B x)] ;
  alpha-matches : G.Matches alpha = \ i -> refl SF.Composite[D.Piece[i].R.functor,F,H,alpha,D.Piece[i].R.inclusion].composite ;
  beta-matches : G.Matches beta = \ i -> Hi.sym D.Piece[i].N.Nat
   SF.Composite[D.Piece[i].R.functor,F,H,alpha,D.Piece[i].R.inclusion].composite
   SF.Composite[D.Piece[i].R.functor,F,H,beta,D.Piece[i].R.inclusion].composite (on i) ;
  equal : Id N.Nat alpha beta = Hi.trans N.Nat alpha G.extension beta (Hi.sym N.Nat G.extension alpha G.Other[alpha,alpha-matches].unique)
   G.Other[beta,beta-matches].unique ;
 } ;
} ;
