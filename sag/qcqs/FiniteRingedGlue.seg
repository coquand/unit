-- Finite gluing of sheaves of rings, before any cocycle hypotheses.
-- Given spaces X_i and two local maps Y_ij -> X_i, Y_ij -> X_j,
-- opens are compatible tuples v_i.  Put m_ij(v)=f_ij^*(v_i).
-- Sections are tuples s_i whose images agree in O_Yij(m_ij(v)); the
-- second image is restricted along m_ij(v)=g_ij^*(v_j).  FiniteRingGlue
-- supplies these rings and their extensionality.
-- Restriction is componentwise.  Naturality of the two legs and the
-- composition law for restriction prove compatibility of the restricted
-- tuple.  Identity and composition then follow componentwise.
-- For a finite cover, glue each coordinate using the sheaf on X_i.
-- The glued coordinates agree on Y_ij by separation on the image of the
-- cover: both images restrict there to the images of the original tuple.
-- Tupling gives the amalgam, and coordinatewise separation proves its
-- uniqueness.  The argument includes an empty atlas and empty covers.
-- No chart theorem is claimed without open-transition and cocycle data.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module SP = Spaces[l] ;
module Over (n : Nat) (X : Fin n -> SP.Space) (Y : Fin n -> Fin n -> SP.Space)
 (f : (i j : Fin n) -> SP.Hom (Y i j) (X i))
 (g : (i j : Fin n) -> SP.Hom (Y i j) (X j)) {
 module Component (i : Fin n) {
  module O = DL.Order[(X i).lattice] ;
  module J = DL.Joins[(X i).lattice] ;
  module GO = RingedLattice[l].On[(X i).lattice].Of[(X i).structure.sheaf] ;
 } ;
 module Pair (i j : Fin n) {
  phi : SP.Between[Y i j,X i].MP.Ringed = SP.underlying (f i j) ;
  psi : SP.Between[Y i j,X j].MP.Ringed = SP.underlying (g i j) ;
  module O = DL.Order[(Y i j).lattice] ;
  module J = DL.Joins[(Y i j).lattice] ;
  module GO = RingedLattice[l].On[(Y i j).lattice].Of[(Y i j).structure.sheaf] ;
  module P = DL.JoinMaps[(X i).lattice,(Y i j).lattice,phi.lat] ;
  module Q = DL.JoinMaps[(X j).lattice,(Y i j).lattice,psi.lat] ;
 } ;
 module FL = FiniteLatticeGlue[l].Over[n,\ i -> (X i).lattice,\ i j -> (Y i j).lattice,
  \ i j -> Pair[i,j].phi.lat,\ i j -> Pair[i,j].psi.lat] ;
 module RG = RingedLattice[l].On[FL.lattice] ;
 mid (v : FL.Opens) (i j : Fin n) : (Y i j).lattice.L =
  DL.hmap Pair[i,j].phi.lat (FL.coordinate v i) ;
 mid-second (v : FL.Opens) (i j : Fin n) :
  Pair[i,j].O.Le (mid v i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) =
  Pair[i,j].O.le-of-eq _ _ (FL.match v i j) ;
 leg2 (v : FL.Opens) (i j : Fin n) :
  RH.Hom ((X j).structure.sheaf.ring (FL.coordinate v j)) ((Y i j).structure.sheaf.ring (mid v i j)) =
  RH.compose ((X j).structure.sheaf.ring (FL.coordinate v j))
   ((Y i j).structure.sheaf.ring (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)))
   ((Y i j).structure.sheaf.ring (mid v i j))
   ((Y i j).structure.sheaf.res (mid v i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (mid-second v i j))
   (Pair[i,j].psi.sharp (FL.coordinate v j)) ;
 module At (v : FL.Opens) {
  module FR = FiniteRingGlue[l].Over[n,\ i -> (X i).structure.sheaf.ring (FL.coordinate v i),
   \ i j -> (Y i j).structure.sheaf.ring (mid v i j),
   \ i -> (X i).structure.sheaf.ring-set (FL.coordinate v i),
   \ i j -> (Y i j).structure.sheaf.ring-set (mid v i j),
   \ i j -> Pair[i,j].phi.sharp (FL.coordinate v i),leg2 v] ;
 } ;
 ring (v : FL.Opens) : CRing = At[v].FR.ring ;
 ring-set (v : FL.Opens) : Pr.isSet (ring v).R = At[v].FR.carrier-set ;
 coordinate (v : FL.Opens) (s : (ring v).R) (i : Fin n) :
  ((X i).structure.sheaf.ring (FL.coordinate v i)).R = At[v].FR.coordinate s i ;
 agree (v : FL.Opens) (s : (ring v).R) (i j : Fin n) :
  Id ((Y i j).structure.sheaf.ring (mid v i j)).R
   (map (Pair[i,j].phi.sharp (FL.coordinate v i)) (coordinate v s i))
   (Pair[i,j].GO.restrict (mid v i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (mid-second v i j)
    (map (Pair[i,j].psi.sharp (FL.coordinate v j)) (coordinate v s j))) = At[v].FR.match s i j ;
 ext (v : FL.Opens) (s t : (ring v).R)
  (e : (i : Fin n) -> Id ((X i).structure.sheaf.ring (FL.coordinate v i)).R (coordinate v s i) (coordinate v t i)) :
  Id (ring v).R s t = At[v].FR.ext s t e ;
 module Res (w v : FL.Opens) (k : FL.O.Le w v) {
  ki (i : Fin n) : Component[i].O.Le (FL.coordinate w i) (FL.coordinate v i) = FL.le-coordinate w v k i ;
  mi (i j : Fin n) : Pair[i,j].O.Le (mid w i j) (mid v i j) =
   Pair[i,j].P.monotone (FL.coordinate w i) (FL.coordinate v i) (ki i) ;
  mj (i j : Fin n) : Pair[i,j].O.Le
   (DL.hmap Pair[i,j].psi.lat (FL.coordinate w j)) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) =
   Pair[i,j].Q.monotone (FL.coordinate w j) (FL.coordinate v j) (ki j) ;
  across (i j : Fin n) : Pair[i,j].O.Le (mid w i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) =
   Pair[i,j].O.le-trans _ _ _ (mid-second w i j) (mj i j) ;
  part (i : Fin n) : RH.Hom (ring v) ((X i).structure.sheaf.ring (FL.coordinate w i)) =
   RH.compose (ring v) ((X i).structure.sheaf.ring (FL.coordinate v i)) ((X i).structure.sheaf.ring (FL.coordinate w i))
    ((X i).structure.sheaf.res (FL.coordinate w i) (FL.coordinate v i) (ki i)) (At[v].FR.projection i) ;
  agrees (s : (ring v).R) (i j : Fin n) :
   Id ((Y i j).structure.sheaf.ring (mid w i j)).R
    (map (Pair[i,j].phi.sharp (FL.coordinate w i)) (map (part i) s)) (map (leg2 w i j) (map (part j) s)) =
   calc ((Y i j).structure.sheaf.ring (mid w i j)).R {
    map (Pair[i,j].phi.sharp (FL.coordinate w i)) (Component[i].GO.restrict (FL.coordinate w i) (FL.coordinate v i) (ki i) (coordinate v s i))
     =< sym (Pair[i,j].phi.natural (FL.coordinate w i) (FL.coordinate v i) (ki i) (coordinate v s i))
     > Pair[i,j].GO.restrict (mid w i j) (mid v i j) (mi i j) (map (Pair[i,j].phi.sharp (FL.coordinate v i)) (coordinate v s i))
     =< ap (Pair[i,j].GO.restrict (mid w i j) (mid v i j) (mi i j)) (agree v s i j)
     > Pair[i,j].GO.restrict (mid w i j) (mid v i j) (mi i j)
        (Pair[i,j].GO.restrict (mid v i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (mid-second v i j)
         (map (Pair[i,j].psi.sharp (FL.coordinate v j)) (coordinate v s j)))
     =< (Y i j).structure.sheaf.res-comp _ _ _ (mi i j) (mid-second v i j) (across i j) (map (Pair[i,j].psi.sharp (FL.coordinate v j)) (coordinate v s j))
     > Pair[i,j].GO.restrict (mid w i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (across i j)
        (map (Pair[i,j].psi.sharp (FL.coordinate v j)) (coordinate v s j))
     =< sym ((Y i j).structure.sheaf.res-comp _ _ _ (mid-second w i j) (mj i j) (across i j) (map (Pair[i,j].psi.sharp (FL.coordinate v j)) (coordinate v s j)))
     > Pair[i,j].GO.restrict (mid w i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate w j)) (mid-second w i j)
        (Pair[i,j].GO.restrict (DL.hmap Pair[i,j].psi.lat (FL.coordinate w j)) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (mj i j)
         (map (Pair[i,j].psi.sharp (FL.coordinate v j)) (coordinate v s j)))
     =< ap (Pair[i,j].GO.restrict (mid w i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate w j)) (mid-second w i j))
         (Pair[i,j].psi.natural (FL.coordinate w j) (FL.coordinate v j) (ki j) (coordinate v s j))
     > Pair[i,j].GO.restrict (mid w i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate w j)) (mid-second w i j)
        (map (Pair[i,j].psi.sharp (FL.coordinate w j))
         (Component[j].GO.restrict (FL.coordinate w j) (FL.coordinate v j) (ki j) (coordinate v s j))) } ;
  res : RH.Hom (ring v) (ring w) = At[w].FR.Lift[ring v,part,agrees].lift ;
  at (s : (ring v).R) (i : Fin n) :
   Id ((X i).structure.sheaf.ring (FL.coordinate w i)).R (coordinate w (map res s) i)
    (Component[i].GO.restrict (FL.coordinate w i) (FL.coordinate v i) (ki i) (coordinate v s i)) =
   refl (Component[i].GO.restrict (FL.coordinate w i) (FL.coordinate v i) (ki i) (coordinate v s i)) ;
 } ;
 res (w v : FL.Opens) (k : FL.O.Le w v) : RH.Hom (ring v) (ring w) = Res[w,v,k].res ;
 res-id (v : FL.Opens) (k : FL.O.Le v v) (s : (ring v).R) : Id (ring v).R (map (res v v k) s) s =
  ext v (map (res v v k) s) s (\ i -> trans (Res[v,v,k].at s i)
   ((X i).structure.sheaf.res-id (FL.coordinate v i) (Res[v,v,k].ki i) (coordinate v s i))) ;
 res-comp (u v w : FL.Opens) (a : FL.O.Le u v) (b : FL.O.Le v w) (c : FL.O.Le u w) (s : (ring w).R) :
  Id (ring u).R (map (res u v a) (map (res v w b) s)) (map (res u w c) s) =
  ext u (map (res u v a) (map (res v w b) s)) (map (res u w c) s) (\ i ->
   trans (Res[u,v,a].at (map (res v w b) s) i)
    (trans (ap (Component[i].GO.restrict (FL.coordinate u i) (FL.coordinate v i) (Res[u,v,a].ki i)) (Res[v,w,b].at s i))
     (trans ((X i).structure.sheaf.res-comp _ _ _ (Res[u,v,a].ki i) (Res[v,w,b].ki i) (Res[u,w,c].ki i) (coordinate w s i))
      (sym (Res[u,w,c].at s i))))) ;
 presheaf : RG.Presheaf = new RG.Presheaf[ring,ring-set,res,res-id,res-comp] ;
 module GO = RG.Of[presheaf] ;
 module Glue (v : FL.Opens) (m : Nat) (vs : Fin m -> FL.Opens)
  (le : (a : Fin m) -> FL.O.Le (vs a) v) (covers : FL.O.Le v (FL.J.bigJ m vs))
  (ss : (a : Fin m) -> (ring (vs a)).R) (compatible : GO.Cover[v,m,vs,le,covers].Compatible ss) {
  module C = GO.Cover[v,m,vs,le,covers] ;
  module Part (i : Fin n) {
   le-i (a : Fin m) : Component[i].O.Le (FL.coordinate (vs a) i) (FL.coordinate v i) = FL.le-coordinate (vs a) v (le a) i ;
   covers-i : Component[i].O.Le (FL.coordinate v i) (Component[i].J.bigJ m (\ a -> FL.coordinate (vs a) i)) =
    Component[i].O.le-trans _ _ _ (FL.le-coordinate v (FL.J.bigJ m vs) covers i)
     (Component[i].O.le-of-eq _ _ (FL.coordinate-joins m vs i)) ;
   sections (a : Fin m) : ((X i).structure.sheaf.ring (FL.coordinate (vs a) i)).R = coordinate (vs a) (ss a) i ;
   module S = RingedLattice[l].On[(X i).lattice].Sheaf[(X i).structure.sheaf,(X i).structure.is-sheaf].Cover[
    FL.coordinate v i,m,\ a -> FL.coordinate (vs a) i,le-i,covers-i] ;
   compatible-i : S.C.Compatible sections = \ a b ->
    trans (Component[i].GO.res-irr _ _
      (Component[i].O.meet-left (FL.coordinate (vs a) i) (FL.coordinate (vs b) i))
      (Res[FL.lattice.meet (vs a) (vs b),vs a,FL.O.meet-left (vs a) (vs b)].ki i) (sections a))
     (trans (sym (Res[FL.lattice.meet (vs a) (vs b),vs a,FL.O.meet-left (vs a) (vs b)].at (ss a) i))
      (trans (ap (\ z -> coordinate (FL.lattice.meet (vs a) (vs b)) z i) (compatible a b))
       (trans (Res[FL.lattice.meet (vs a) (vs b),vs b,FL.O.meet-right (vs a) (vs b)].at (ss b) i)
        (Component[i].GO.res-irr _ _
         (Res[FL.lattice.meet (vs a) (vs b),vs b,FL.O.meet-right (vs a) (vs b)].ki i)
         (Component[i].O.meet-right (FL.coordinate (vs a) i) (FL.coordinate (vs b) i)) (sections b))))) ;
   amalgam : S.C.Amalgam sections = (S.glue sections compatible-i).1 ;
   value : ((X i).structure.sheaf.ring (FL.coordinate v i)).R = S.C.amalgam amalgam ;
   matches (a : Fin m) : Id ((X i).structure.sheaf.ring (FL.coordinate (vs a) i)).R
    (Component[i].GO.restrict (FL.coordinate (vs a) i) (FL.coordinate v i) (le-i a) value) (sections a) = S.C.matches amalgam a ;
  } ;
  -- Compare the two images of the coordinate amalgams in each Y_ij.
  module Overlap (i j : Fin n) {
   le-mid (a : Fin m) : Pair[i,j].O.Le (mid (vs a) i j) (mid v i j) =
    Pair[i,j].P.monotone (FL.coordinate (vs a) i) (FL.coordinate v i) (Part[i].le-i a) ;
   covers-mid : Pair[i,j].O.Le (mid v i j) (Pair[i,j].J.bigJ m (\ a -> mid (vs a) i j)) =
    Pair[i,j].O.le-trans _ _ _ (Pair[i,j].P.monotone _ _ Part[i].covers-i)
     (Pair[i,j].O.le-of-eq _ _ (Pair[i,j].P.preserves m (\ a -> FL.coordinate (vs a) i))) ;
   module S = RingedLattice[l].On[(Y i j).lattice].Sheaf[(Y i j).structure.sheaf,(Y i j).structure.is-sheaf].Cover[
    mid v i j,m,\ a -> mid (vs a) i j,le-mid,covers-mid] ;
   first-image : ((Y i j).structure.sheaf.ring (mid v i j)).R =
    map (Pair[i,j].phi.sharp (FL.coordinate v i)) Part[i].value ;
   second-image : ((Y i j).structure.sheaf.ring (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j))).R =
    map (Pair[i,j].psi.sharp (FL.coordinate v j)) Part[j].value ;
   mj (a : Fin m) : Pair[i,j].O.Le (DL.hmap Pair[i,j].psi.lat (FL.coordinate (vs a) j))
    (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) = Pair[i,j].Q.monotone _ _ (Part[j].le-i a) ;
   across (a : Fin m) : Pair[i,j].O.Le (mid (vs a) i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) =
    Pair[i,j].O.le-trans _ _ _ (mid-second (vs a) i j) (mj a) ;
   agree-at (a : Fin m) :
    Id ((Y i j).structure.sheaf.ring (mid (vs a) i j)).R (S.C.restrictions first-image a)
     (S.C.restrictions (Pair[i,j].GO.restrict (mid v i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (mid-second v i j) second-image) a) =
    calc ((Y i j).structure.sheaf.ring (mid (vs a) i j)).R {
     Pair[i,j].GO.restrict (mid (vs a) i j) (mid v i j) (le-mid a) first-image
      =< Pair[i,j].phi.natural (FL.coordinate (vs a) i) (FL.coordinate v i) (Part[i].le-i a) Part[i].value
      > map (Pair[i,j].phi.sharp (FL.coordinate (vs a) i))
         (Component[i].GO.restrict (FL.coordinate (vs a) i) (FL.coordinate v i) (Part[i].le-i a) Part[i].value)
      =< ap (map (Pair[i,j].phi.sharp (FL.coordinate (vs a) i))) (Part[i].matches a)
      > map (Pair[i,j].phi.sharp (FL.coordinate (vs a) i)) (Part[i].sections a)
      =< agree (vs a) (ss a) i j
      > Pair[i,j].GO.restrict (mid (vs a) i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate (vs a) j)) (mid-second (vs a) i j)
         (map (Pair[i,j].psi.sharp (FL.coordinate (vs a) j)) (Part[j].sections a))
      =< ap (\ z -> Pair[i,j].GO.restrict (mid (vs a) i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate (vs a) j))
          (mid-second (vs a) i j) (map (Pair[i,j].psi.sharp (FL.coordinate (vs a) j)) z)) (sym (Part[j].matches a))
      > Pair[i,j].GO.restrict (mid (vs a) i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate (vs a) j)) (mid-second (vs a) i j)
         (map (Pair[i,j].psi.sharp (FL.coordinate (vs a) j))
          (Component[j].GO.restrict (FL.coordinate (vs a) j) (FL.coordinate v j) (Part[j].le-i a) Part[j].value))
      =< ap (Pair[i,j].GO.restrict (mid (vs a) i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate (vs a) j)) (mid-second (vs a) i j))
          (sym (Pair[i,j].psi.natural (FL.coordinate (vs a) j) (FL.coordinate v j) (Part[j].le-i a) Part[j].value))
      > Pair[i,j].GO.restrict (mid (vs a) i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate (vs a) j)) (mid-second (vs a) i j)
         (Pair[i,j].GO.restrict (DL.hmap Pair[i,j].psi.lat (FL.coordinate (vs a) j)) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (mj a) second-image)
      =< (Y i j).structure.sheaf.res-comp _ _ _ (mid-second (vs a) i j) (mj a) (across a) second-image
      > Pair[i,j].GO.restrict (mid (vs a) i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (across a) second-image
      =< sym ((Y i j).structure.sheaf.res-comp _ _ _ (le-mid a) (mid-second v i j) (across a) second-image)
      > Pair[i,j].GO.restrict (mid (vs a) i j) (mid v i j) (le-mid a)
         (Pair[i,j].GO.restrict (mid v i j) (DL.hmap Pair[i,j].psi.lat (FL.coordinate v j)) (mid-second v i j) second-image) } ;
   agrees : Id ((Y i j).structure.sheaf.ring (mid v i j)).R first-image
    (map (leg2 v i j) Part[j].value) =
    S.separated first-image (map (leg2 v i j) Part[j].value) agree-at ;
  } ;
  glued : (ring v).R = (\ i -> Part[i].value,\ i j -> Overlap[i,j].agrees) ;
  matches : C.Matches ss glued = \ a -> ext (vs a) (C.restrictions glued a) (ss a) (\ i ->
   trans (Res[vs a,v,le a].at glued i)
    (trans (Component[i].GO.res-irr _ _ (Res[vs a,v,le a].ki i) (Part[i].le-i a) Part[i].value) (Part[i].matches a))) ;
  matches-prop (s : (ring v).R) : Pr.isProp (C.Matches ss s) =
   FE.isProp-Pi (Fin m) (\ a -> Id (ring (vs a)).R (C.restrictions s a) (ss a)) (\ a -> ring-set (vs a) _ _) ;
  unique (t : C.Amalgam ss) : Id (C.Amalgam ss) (glued,matches) t =
   Pr.Sigma-eq (ring v).R (C.Matches ss) glued (C.amalgam t) matches (C.matches t)
    (ext v glued (C.amalgam t) (\ i -> Part[i].S.separated Part[i].value (coordinate v (C.amalgam t) i) (\ a ->
     trans (Part[i].matches a)
      (sym (trans (sym (Res[vs a,v,le a].at (C.amalgam t) i))
       (ap (\ z -> coordinate (vs a) z i) (C.matches t a)))))))
    (matches-prop (C.amalgam t)) ;
  sheaf : Localisation[l].isContr (C.Amalgam ss) = ((glued,matches),unique) ;
 } ;
 is-sheaf : GO.IsSheaf = \ v m vs le covers ss compatible -> Glue[v,m,vs,le,covers,ss,compatible].sheaf ;
} ;
