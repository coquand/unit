-- Localisation preserves cokernels (Serre note, Section 3).
-- The quotient projection is surjective and its kernel is the image of d.
-- Localisation preserves these two facts by numerator lifting and killing.
-- The localised projection therefore factors through coker(d_f). This
-- factor is surjective. Its kernel is zero: lift to a representative in
-- C_f, use localised exactness, and then the quotient's image criterion.
-- The resulting linear comparison is an equivalence, uniquely specified
-- on classes. No inverse action on a quotient is postulated.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module CK = SerreModuleCokernel[l] ;
module LL = SerreModuleLocalisationLinear[l] ;
module LE = SerreModuleLocalisationExact[l] ;
module At (A : CRing) (B C : SM.Over[A].Module)
 (d : MM.Between[A,A,RingHom[l].identity A,B,C].Hom) (f : A.R) {
 module Original = CK.Over[A,B,C,d] ;
 module P = LE.Over[A,C,Original.cokernel,Original.projection,f] ;
 module E = LE.Pair[A,B,C,Original.cokernel,d,Original.projection,f] ;
 module LocalD = LL.Along[A,A,RingHom[l].identity A,B,C,d,f] ;
 module Target = CK.Over[A,LocalD.S.localised,LocalD.T.localised,LocalD.induced] ;
 original-kills : E.Kills = \ b ->
  trans (Original.projection-at (Original.D.map d b)) (Original.killed b) ;
 original-exact : E.Exact = \ x e ->
  Tr.Trunc[(b : B.M) * Id C.M x (Original.D.map d b)].induction @l
   (\ t -> Tr.Trunc[(b : B.M) * Id C.M (Original.D.map d b) x].carrier)
   (\ t -> Tr.Trunc[(b : B.M) * Id C.M (Original.D.map d b) x].proposition)
   (\ w -> Tr.Trunc[(b : B.M) * Id C.M (Original.D.map d b) x].inc (w.1,sym w.2))
   (Original.CQ.zero-image x (trans (sym (Original.projection-at x)) e)) ;
 original-surjective : P.Surjective = \ y -> Original.induction
  (\ y -> Tr.Trunc[(x : C.M) * Id Original.CQ.Class (Original.Projection.map Original.projection x) y].carrier)
  (\ y -> Tr.Trunc[(x : C.M) * Id Original.CQ.Class (Original.Projection.map Original.projection x) y].proposition)
  (\ x -> Tr.Trunc[(z : C.M) * Id Original.CQ.Class (Original.Projection.map Original.projection z) (Original.CQ.class x)].inc
   (x,Original.projection-at x)) y ;
 module Factor = Target.Factor[P.L.T.localised,P.L.induced,E.kills original-kills] ;
 comparison : Factor.Maps.Hom = Factor.factor ;
 on-classes (x : LocalD.T.L.Carrier) :
  Id P.L.T.L.Carrier (Factor.Maps.map comparison (Target.CQ.class x)) (P.L.Maps.map P.L.induced x) = Factor.factor-at x ;
 module Bijective = SerreModuleMapExact[l].Over[A,Target.cokernel,P.L.T.localised,comparison] ;
 onto (y : P.L.T.L.Carrier) : Tr.Trunc[Bijective.Fibre y].carrier =
  Tr.Trunc[(x : P.L.S.L.Carrier) * Id P.L.T.L.Carrier (P.L.Maps.map P.L.induced x) y].induction @l
   (\ t -> Tr.Trunc[Bijective.Fibre y].carrier) (\ t -> Tr.Trunc[Bijective.Fibre y].proposition)
   (\ w -> Tr.Trunc[Bijective.Fibre y].inc (Target.CQ.class w.1,trans (on-classes w.1) w.2))
   (P.surjective original-surjective y) ;
 class-kernel (x : LocalD.T.L.Carrier)
  (e : Id P.L.T.L.Carrier (Factor.Maps.map comparison (Target.CQ.class x)) P.L.T.Action.mz) :
  Id Target.CQ.Class (Target.CQ.class x) Target.CQ.zero =
  Tr.Trunc[(b : LocalD.S.L.Carrier) * Id LocalD.T.L.Carrier (LocalD.Maps.map LocalD.induced b) x].induction @l
   (\ t -> Id Target.CQ.Class (Target.CQ.class x) Target.CQ.zero) (\ t -> Target.CQ.set _ _)
   (\ w -> Target.CQ.image-zero x
    (Tr.Trunc[(b : LocalD.S.L.Carrier) * Id LocalD.T.L.Carrier x (LocalD.Maps.map LocalD.induced b)].inc
     (w.1,sym w.2))) (E.exact original-exact x (trans (sym (on-classes x)) e)) ;
 kernel-zero : Bijective.KernelZero = \ x -> Target.induction
  (\ x -> Id P.L.T.L.Carrier (Factor.Maps.map comparison x) P.L.T.Action.mz -> Id Target.CQ.Class x Target.CQ.zero)
  (\ x -> FE.isProp-Pi (Id P.L.T.L.Carrier (Factor.Maps.map comparison x) P.L.T.Action.mz)
   (\ e -> Id Target.CQ.Class x Target.CQ.zero) (\ e -> Target.CQ.set _ _))
  class-kernel x ;
 module Equivalence = Bijective.Equivalence[kernel-zero,onto] ;
 equivalence : Pr.isEquiv Target.CQ.Class P.L.T.L.Carrier (Factor.Maps.map comparison) = Equivalence.equivalent ;
 inverse (x : P.L.T.L.Carrier) : Target.CQ.Class = Equivalence.inverse x ;
 inverse-right (x : P.L.T.L.Carrier) : Id P.L.T.L.Carrier (Factor.Maps.map comparison (inverse x)) x = Equivalence.right x ;
 inverse-left (x : Target.CQ.Class) : Id Target.CQ.Class (inverse (Factor.Maps.map comparison x)) x = Equivalence.left x ;
 opaque comparison ; opaque inverse ;
} ;
