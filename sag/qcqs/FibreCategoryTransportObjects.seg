-- Transported structures on transported objects (objects and arrows in U k).
-- For p : C = D and a structure S on C, the structure moved along p is
-- computed, at moved objects, by moving the value of S (J on p, refl at
-- refl):  (p_* S).tensor (p_* x) (p_* y) = p_* (S.tensor x y),
-- (p_* S).unit = p_* S.unit, and the cokernel object of p_* f is p_* of
-- the cokernel object of f (p_* f: arrows moved along p, by J).
-- When p is the identification of an equivalence e (FibreCategorySIPTheorem),
-- p_* x = F x on objects (FibreCategorySIPObjects.On.objects), so the
-- moved tensor is strong monoidal on objects for F:
--   (p_* S).tensor (F x) (F y) = F (S.tensor x y),   (p_* S).unit = F S.unit,
-- and the moved cokernel object of p_* f is F (coker f).
level k ; open Base ;
module K = Category[k,k] ;
module P = Prelude[k] ;
module MCat = MonoidalCategory[k] ;
module CA = CategoryAbelian[k] ;
module Ob = FibreCategorySIPObjects[k] ;
module CE = FibreCategoryEquivalence[k] ;

module Along (C D : K.Category) (p : Id K.Category C D) {
 ob (x : C.pre.ob) : D.pre.ob = Ob.obC C D p x ;
 -- arrows moved along p
 hom (x y : C.pre.ob) (f : C.pre.hom x y) : D.pre.hom (ob x) (ob y) =
  idJ K.Category C (\ Z q -> Z.pre.hom (Ob.obC C Z q x) (Ob.obC C Z q y)) f D p ;
 module M (S : MCat.Monoidal[C]) {
  moved : MCat.Monoidal[D] = MCat.transport C D p S ;
  tensor (x y : C.pre.ob) : Id D.pre.ob (moved.tensor (ob x) (ob y)) (ob (S.tensor x y)) =
   idJ K.Category C (\ Z q -> Id Z.pre.ob ((MCat.transport C Z q S).tensor (Ob.obC C Z q x) (Ob.obC C Z q y)) (Ob.obC C Z q (S.tensor x y)))
    (refl (S.tensor x y)) D p ;
  unit : Id D.pre.ob moved.unit (ob S.unit) =
   idJ K.Category C (\ Z q -> Id Z.pre.ob (MCat.transport C Z q S).unit (Ob.obC C Z q S.unit)) (refl S.unit) D p ;
 } ;
 module Coker (H : CA.HasCokernels C) {
  moved : CA.HasCokernels D = CA.Transport[C,D,p].move CA.HasCokernels H ;
  object (x y : C.pre.ob) (f : C.pre.hom x y) :
   Id D.pre.ob (moved.2 (ob x) (ob y) (hom x y f)).1 (ob (H.2 x y f).1) =
   idJ K.Category C (\ Z q -> Id Z.pre.ob
     ((CA.Transport[C,Z,q].move CA.HasCokernels H).2 (Ob.obC C Z q x) (Ob.obC C Z q y)
      (idJ K.Category C (\ Z' q' -> Z'.pre.hom (Ob.obC C Z' q' x) (Ob.obC C Z' q' y)) f Z q)).1
     (Ob.obC C Z q (H.2 x y f).1))
    (refl (H.2 x y f).1) D p ;
 } ;
} ;

-- along the identification of an equivalence: F on objects
module Equivalent (C D : K.Category) (e : CE.Equivalence[C,D]) {
 module EO = Ob.On[C,D,e] ;
 module A = Along[C,D,EO.T.equality] ;
 F (x : C.pre.ob) : D.pre.ob = e.forward.obj x ;
 module M (S : MCat.Monoidal[C]) {
  module AM = A.M[S] ;
  moved : MCat.Monoidal[D] = AM.moved ;
  -- F (x) F = F ((x)) on objects
  tensor (x y : C.pre.ob) : Id D.pre.ob (moved.tensor (F x) (F y)) (F (S.tensor x y)) =
   P.trans D.pre.ob (moved.tensor (F x) (F y)) (moved.tensor (A.ob x) (A.ob y)) (F (S.tensor x y))
    (P.trans D.pre.ob (moved.tensor (F x) (F y)) (moved.tensor (A.ob x) (F y)) (moved.tensor (A.ob x) (A.ob y))
     (P.ap D.pre.ob D.pre.ob (\ a -> moved.tensor a (F y)) (F x) (A.ob x) (P.sym D.pre.ob (A.ob x) (F x) (EO.objects x)))
     (P.ap D.pre.ob D.pre.ob (\ b -> moved.tensor (A.ob x) b) (F y) (A.ob y) (P.sym D.pre.ob (A.ob y) (F y) (EO.objects y))))
    (P.trans D.pre.ob (moved.tensor (A.ob x) (A.ob y)) (A.ob (S.tensor x y)) (F (S.tensor x y))
     (AM.tensor x y) (EO.objects (S.tensor x y))) ;
  unit : Id D.pre.ob moved.unit (F S.unit) =
   P.trans D.pre.ob moved.unit (A.ob S.unit) (F S.unit) AM.unit (EO.objects S.unit) ;
 } ;
 module Coker (H : CA.HasCokernels C) {
  module AC = A.Coker[H] ;
  moved : CA.HasCokernels D = AC.moved ;
  -- the cokernel object of the moved arrow is F (coker f)
  object (x y : C.pre.ob) (f : C.pre.hom x y) :
   Id D.pre.ob (moved.2 (A.ob x) (A.ob y) (A.hom x y f)).1 (F (H.2 x y f).1) =
   P.trans D.pre.ob (moved.2 (A.ob x) (A.ob y) (A.hom x y f)).1 (A.ob (H.2 x y f).1) (F (H.2 x y f).1)
    (AC.object x y f) (EO.objects (H.2 x y f).1) ;
 } ;
} ;
