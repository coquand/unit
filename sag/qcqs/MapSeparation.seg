-- Restriction to source opens, and equality detected on a finite cover.
-- In geometric order pi is X -> Y; restrict pi to X|e by composing with
-- Slice.inclusion.  Its inverse image is pi(u) /\ e and its section map
-- sends s to pi#(s)|pi(u)/\e.  These are the two trace lemmas.
-- If restricted maps are equal, their lattice traces are equal.  For a
-- common w <= e, pi(u), pi2(u), equality of the restricted maps gives
-- equality of the images restricted to w (MapAgreement.restrict-eq).
-- The section trace is res-comp, so this is agreement on e in the ambient
-- sense of MapAgreement.  Finite-cover separation then gives pi = pi2.
-- This does not require locality or an affine source.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Maps (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf)
 (X : LocallyRinged[l].On[M].LocallyRinged) {
 module O = DL.Order[M] ;
 module J = DL.Joins[M] ;
 module GO = RingedLattice[l].On[M].Of[X.sheaf] ;
 module MP = LocallyRinged[l].Maps[L,M,F,X.sheaf] ;
 module MA = MapAgreement[l].Maps[L,M,F,X.sheaf] ;
 module Cut (e : M.L) {
  module Sl = Slice[l].Over[M,X,e] ;
  module MC = LocallyRinged[l].Maps[L,Sl.lattice,F,Sl.sheaf] ;
  module C = Compose[l].Maps[L,M,Sl.lattice,F,X.sheaf,Sl.sheaf] ;
  module AC = MapAgreement[l].Maps[L,Sl.lattice,F,Sl.sheaf] ;
  restrict (pi : MP.Ringed) : MC.Ringed = C.Of[Sl.inclusion,pi].composite ;
  lattice-trace (pi : MP.Ringed) (u : L.L) :
   Id M.L (Sl.inc (DL.hmap (restrict pi).lat u)) (M.meet (DL.hmap pi.lat u) e) =
   refl (M.meet (DL.hmap pi.lat u) e) ;
  at (w : M.L) (we : O.Le w e) : Sl.Opens = (w,we) ;
  at-le (pi : MP.Ringed) (u : L.L) (w : M.L) (we : O.Le w e) (k : O.Le w (DL.hmap pi.lat u)) :
   Sl.OS.Le (at w we) (DL.hmap (restrict pi).lat u) =
   Sl.le-in (at w we) (DL.hmap (restrict pi).lat u) (O.meet-glb (DL.hmap pi.lat u) e w k we) ;
  trace (pi : MP.Ringed) (u : L.L) (w : M.L) (we : O.Le w e) (k : O.Le w (DL.hmap pi.lat u)) (s : (F.ring u).R) :
   Id (X.sheaf.ring w).R
    (Sl.SO.restrict (at w we) (DL.hmap (restrict pi).lat u) (at-le pi u w we k) (map ((restrict pi).sharp u) s))
    (GO.restrict w (DL.hmap pi.lat u) k (map (pi.sharp u) s)) =
   trans (Sl.res-inc (at w we) (DL.hmap (restrict pi).lat u) (at-le pi u w we k) (map ((restrict pi).sharp u) s))
    (trans (ap (GO.restrict w (M.meet (DL.hmap pi.lat u) e)
       (Sl.le-inc (at w we) (DL.hmap (restrict pi).lat u) (at-le pi u w we k)))
      (C.Of[Sl.inclusion,pi].sharp-map u s))
     (X.sheaf.res-comp w (M.meet (DL.hmap pi.lat u) e) (DL.hmap pi.lat u)
       (Sl.le-inc (at w we) (DL.hmap (restrict pi).lat u) (at-le pi u w we k)) (O.meet-left (DL.hmap pi.lat u) e) k
       (map (pi.sharp u) s))) ;

  module Equal (pi pi2 : MP.Ringed) (eq : Id MC.Ringed (restrict pi) (restrict pi2)) {
   lattice-on (u : L.L) : Id M.L (M.meet (DL.hmap pi.lat u) e) (M.meet (DL.hmap pi2.lat u) e) =
    trans (sym (lattice-trace pi u))
     (trans (ap (\ rho -> Sl.inc (DL.hmap rho.lat u)) eq) (lattice-trace pi2 u)) ;
   sections-on : MA.SectionsOn pi pi2 e = \ u w we k k2 s ->
    trans (sym (trace pi u w we k s))
     (trans (AC.restrict-eq (restrict pi) (restrict pi2) eq u (at w we) (at-le pi u w we k) (at-le pi2 u w we k2) s)
      (trace pi2 u w we k2 s)) ;
   agree : MA.AgreeOn pi pi2 e = (lattice-on,sections-on) ;
  } ;
  local (DF : InvOpen[l].On[L].Of[F].InvMap) (pi : MP.Ringed) (loc : MP.Of[pi,DF,X.inv].IsLocal) :
   MC.Of[restrict pi,DF,Sl.inv].IsLocal = C.Of[Sl.inclusion,pi].Local[DF,X.inv,Sl.inv,loc,Sl.inclusion-local].local ;
 } ;
 module Cover (n : Nat) (es : Fin n -> M.L) (covers : O.Le M.top (J.bigJ n es)) {
  module CV = MA.Cover[X.is-sheaf,n,es,covers] ;
  separated (pi pi2 : MP.Ringed)
   (h : (i : Fin n) -> Id Cut[es i].MC.Ringed (Cut[es i].restrict pi) (Cut[es i].restrict pi2)) :
   Id MP.Ringed pi pi2 = CV.Compare[pi,pi2,\ i -> Cut[es i].Equal[pi,pi2,h i].agree].separated ;
 } ;
} ;
