-- Equalisers of module maps as kernels of their difference (Serre §3).
-- The difference is linear by the additive difference identity and scalar
-- distributivity. Its kernel equation is equivalent to u(x)=v(x).
-- A map satisfying that equation therefore factors uniquely through the
-- equaliser by the existing kernel universal property.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (B C : SM.Over[A].Module)
 (u v : MM.Between[A,A,RingHom[l].identity A,B,C].Hom) {
 module H = MM.Between[A,A,RingHom[l].identity A,B,C] ;
 module CL = SM.Over[A].Laws[C] ; module Group = SerreCechAlgebra[l].Over[A,C] ;
 difference : H.Hom = new H.Hom[\ x -> CL.sub (H.map u x) (H.map v x),
  \ x y -> trans (cong2 C.M CL.sub _ _ _ _ (H.map-add u x y) (H.map-add v x y))
   (Group.sub-add (H.map u x) (H.map u y) (H.map v x) (H.map v y)),
  \ a x -> trans (cong2 C.M CL.sub _ _ _ _ (H.map-scale u a x) (H.map-scale v a x))
   (sym (CL.sm-sub a (H.map u x) (H.map v x)))] ;
 difference-at (x : B.M) : Id C.M (H.map difference x) (CL.sub (H.map u x) (H.map v x)) = refl (CL.sub (H.map u x) (H.map v x)) ;
 module K = SerreModuleKernelAlgebra[l].Over[A,B,C,difference] ;
 equation (x : K.Carrier) : Id C.M (H.map u (K.value x)) (H.map v (K.value x)) =
  CL.sub-zero _ _ (trans (sym (difference-at (K.value x))) (K.member x)) ;
 member (x : B.M) (e : Id C.M (H.map u x) (H.map v x)) : K.Member x =
  trans (difference-at x) (trans (ap (\ a -> CL.sub a (H.map v x)) e) (CL.sub-self (H.map v x))) ;
 element (x : B.M) (e : Id C.M (H.map u x) (H.map v x)) : K.Carrier = (x,member x e) ;
 element-value (x : B.M) (e : Id C.M (H.map u x) (H.map v x)) : Id B.M (K.value (element x e)) x = refl x ;
 module Factor (Pd : SM.Over[A].Module)
  (h : MM.Between[A,A,RingHom[l].identity A,Pd,B].Hom)
  (agrees : (x : Pd.M) -> Id C.M (H.map u (MM.Between[A,A,RingHom[l].identity A,Pd,B].map h x))
   (H.map v (MM.Between[A,A,RingHom[l].identity A,Pd,B].map h x))) {
  module Into = MM.Between[A,A,RingHom[l].identity A,Pd,B] ;
  module Lift = K.Lift[Pd,h,\ x -> member (Into.map h x) (agrees x)] ;
 } ;
 opaque difference ;
} ;
