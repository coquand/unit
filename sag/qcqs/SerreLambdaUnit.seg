-- lambda at a unit multiple. Let v be an open, a in O(v), e a unit of
-- O(v) and c = e a. If lambda_(v,a) is an equivalence, so is lambda_(v,c).
-- Proof. D_v(c) = D_v(e) /\ D_v(a) = v /\ D_v(a) = D_v(a). Restriction
-- u : M(v) -> M(D_v a) clears and kills at a (SerreLambdaClearing), hence at
-- c: u(e^r x) = e^r a^r y = c^r y, and a^r x = 0 gives c^r x = e^r a^r x = 0.
-- Restriction to D_v(c) is u followed by the bijective linear restriction
-- along the equality of opens, so it clears and kills at c
-- (SerreLambdaElementarySquare), and lambda_(v,c) is an equivalence.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module EL = SerreLambdaElementary[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (v : L.L) (a e : (X.sheaf.ring v).R)
 (unit : RL[X.sheaf.ring v].unit e)
 (equiv : SerreLambda[l].On[L,X,M,v].At[a].IsEquivalence) {
 module O = DL.Order[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module IX = InvOpen[l].On[L].Of[X.sheaf] ;
 A : CRing = X.sheaf.ring v ;
 c : A.R = A.mul e a ;
 module ClA = SerreLambdaClearing[l].On[L,X,M,v,a] ;
 module ClC = SerreLambdaClearing[l].On[L,X,M,v,c] ;
 module F = ClA.Elementary[equiv] ;
 Md : SM.Over[A].Module = M.presheaf.module-at v ;
 Nd : SM.Over[A].Module = ClA.C.Scalars.restricted ;
 -- the same restriction clears and kills at c
 module EA = EL.Over[A,Md,Nd,ClA.C.original,a] ;
 module EC = EL.Over[A,Md,Nd,ClA.C.original,c] ;
 module AP = AffinePowers[l].Over[A] ;
 power (r : Nat) : Id A.R (AP.power c r) (A.mul (AP.power e r) (AP.power a r)) = AP.power-mul e a r ;
 clearing (y : Nd.M) (w : EA.Clearing y) : EC.Clearing y =
  (w.1,Md.sm (AP.power e w.1) w.2.1,calc Nd.M {
   EA.H.map ClA.C.original (Md.sm (AP.power e w.1) w.2.1)
    =< EA.H.map-scale ClA.C.original (AP.power e w.1) w.2.1 > Nd.sm (AP.power e w.1) (EA.H.map ClA.C.original w.2.1)
    =< ap (Nd.sm (AP.power e w.1)) w.2.2 > Nd.sm (AP.power e w.1) (Nd.sm (AP.power a w.1) y)
    =< Nd.smA (AP.power e w.1) (AP.power a w.1) y > Nd.sm (A.mul (AP.power e w.1) (AP.power a w.1)) y
    =< ap (\ b -> Nd.sm b y) (sym (power w.1)) > Nd.sm (AP.power c w.1) y }) ;
 clear : EC.Clear = \ y -> Tr.Trunc[EA.Clearing y].induction @l
  (\ t -> Tr.Trunc[EC.Clearing y].carrier) (\ t -> Tr.Trunc[EC.Clearing y].proposition)
  (\ w -> Tr.Trunc[EC.Clearing y].inc (clearing y w)) (F.clear y) ;
 killing (x : Md.M) (w : EA.Killing x) : EC.Killing x =
  (w.1,calc Md.M {
   Md.sm (AP.power c w.1) x
    =< ap (\ b -> Md.sm b x) (power w.1) > Md.sm (A.mul (AP.power e w.1) (AP.power a w.1)) x
    =< sym (Md.smA (AP.power e w.1) (AP.power a w.1) x) > Md.sm (AP.power e w.1) (Md.sm (AP.power a w.1) x)
    =< ap (Md.sm (AP.power e w.1)) w.2 > Md.sm (AP.power e w.1) Md.mz
    =< SM.Over[A].Laws[Md].sm-zero (AP.power e w.1) > Md.mz }) ;
 kill : EC.Kill = \ x z -> Tr.Trunc[EA.Killing x].induction @l
  (\ t -> Tr.Trunc[EC.Killing x].carrier) (\ t -> Tr.Trunc[EC.Killing x].proposition)
  (\ w -> Tr.Trunc[EC.Killing x].inc (killing x w)) (F.kill x z) ;
 -- D_v(c) = D_v(a)
 d-unit : Id L.L (LX.d v e) v = IX.unique (LX.d-open v e) (IX.whole v e unit) ;
 d-eq : Id L.L ClC.Lam.open-g ClA.Lam.open-g = calc L.L {
  ClC.Lam.open-g
   =< LX.mul-law v e a > L.meet (LX.d v e) (LX.d v a)
   =< ap (\ t -> L.meet t (LX.d v a)) d-unit > L.meet v (LX.d v a)
   =< L.meetC v (LX.d v a) > L.meet (LX.d v a) v
   =< IX.below (LX.d-open v a) > ClA.Lam.open-g } ;
 to-a : O.Le ClA.Lam.open-g ClC.Lam.open-g = O.le-of-eq _ _ (sym d-eq) ;
 to-c : O.Le ClC.Lam.open-g ClA.Lam.open-g = O.le-of-eq _ _ d-eq ;
 Nc : SM.Over[A].Module = ClC.C.Scalars.restricted ;
 move (y : Nc.M) : Nd.M = MO.restrict ClA.Lam.open-g ClC.Lam.open-g to-a y ;
 move-equiv : Pr.isEquiv Nc.M Nd.M move =
  Pr.qinv _ _ move (MO.restrict ClC.Lam.open-g ClA.Lam.open-g to-c)
   (\ y -> trans (M.presheaf.res-comp ClA.Lam.open-g ClC.Lam.open-g ClA.Lam.open-g to-a to-c (O.le-refl ClA.Lam.open-g) y)
    (M.presheaf.res-id ClA.Lam.open-g (O.le-refl ClA.Lam.open-g) y))
   (\ y -> trans (M.presheaf.res-comp ClC.Lam.open-g ClA.Lam.open-g ClC.Lam.open-g to-c to-a (O.le-refl ClC.Lam.open-g) y)
    (M.presheaf.res-id ClC.Lam.open-g (O.le-refl ClC.Lam.open-g) y)) ;
 module HI = MM.Between[A,A,RH.identity A,Md,Md] ;
 module HJ = MM.Between[A,A,RH.identity A,Nc,Nd] ;
 i : HI.Hom = new HI.Hom[\ x -> x,\ x y -> refl (Md.madd x y),\ b x -> refl (Md.sm b x)] ;
 i-equiv : Pr.isEquiv Md.M Md.M (HI.map i) = Pr.qinv _ _ (HI.map i) (\ x -> x) (\ x -> refl x) (\ x -> refl x) ;
 i-at (x : Md.M) : Id Md.M (HI.map i x) x = refl x ;
 j : HJ.Hom = new HJ.Hom[move,\ x y -> MO.res-add ClA.Lam.open-g ClC.Lam.open-g to-a x y,
  \ b y -> trans (MO.res-scale ClA.Lam.open-g ClC.Lam.open-g to-a (RM.map ClC.C.ring-map b) y)
   (ap (\ r -> (M.presheaf.module-at ClA.Lam.open-g).sm r (move y))
    (X.sheaf.res-comp ClA.Lam.open-g ClC.Lam.open-g v to-a ClC.Lam.below ClA.Lam.below b))] ;
 j-at (y : Nc.M) : Id Nd.M (HJ.map j y) (move y) = refl (move y) ;
 commutes (x : Md.M) : Id Nd.M (HJ.map j (ClC.E.H.map ClC.C.original x)) (EC.H.map ClA.C.original (HI.map i x)) =
  calc Nd.M {
   HJ.map j (ClC.E.H.map ClC.C.original x)
    =< j-at (ClC.E.H.map ClC.C.original x) > move (ClC.E.H.map ClC.C.original x)
    =< ap move (ClC.C.original-at x) > move (MO.restrict ClC.Lam.open-g v ClC.Lam.below x)
    =< M.presheaf.res-comp ClA.Lam.open-g ClC.Lam.open-g v to-a ClC.Lam.below ClA.Lam.below x
     > MO.restrict ClA.Lam.open-g v ClA.Lam.below x
    =< sym (ClA.C.original-at x) > EC.H.map ClA.C.original x
    =< ap (EC.H.map ClA.C.original) (sym (i-at x)) > EC.H.map ClA.C.original (HI.map i x) } ;
 module Sq = SerreLambdaElementarySquare[l].Square[A,Md,Nc,Md,Nd,ClC.C.original,ClA.C.original,
  i,i-equiv,j,move-equiv,commutes,c] ;
 equivalence : SerreLambda[l].On[L,X,M,v].At[c].IsEquivalence = ClC.equivalence (Sq.clear clear) (Sq.kill kill) ;
} ;
