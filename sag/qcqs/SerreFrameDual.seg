-- Clear chart coordinates on all generators. Two successive changes of
-- chart differ by a scalar annihilating the original frame, so a common
-- chart power kills their finitely many errors. The corrected row vanishes
-- on every relation: after localising at any chart, it is a multiple of
-- that chart's row, which vanishes there by faithfulness of the frame.
-- Descend this row to a global functional. Its value on its own frame
-- is a unit on the original chart.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module SM = SerreModule[l] ;
module RM = RingMaps[l] ; module CE = SerreModuleClearErrors[l] ;
module LG = SerreLocalGeneration[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (M : SM.Over[A].Module) {
 module G0 = LG.Over[A,setA,M] ; module F = G0.F ; module L = G0.L ; module S = G0.S ;
 module P = G0.P ; module RS = G0.RS ; module MS = G0.MS ; module AL = RL[A] ;
 module R0 = S.Laws[F.R] ; module M0 = S.Laws[M] ;
 module Desc (d : F.Description[M]) {
  module B = G0.Desc[d] ;
  module Sep = SerreModuleGluingData[l].Over[A,setA,F.R].Cover[B.n,B.fs,d.covers] ;
  module Frames (fr : B.Frames) {
   module G = B.Generators[fr] ;
   module Dual = L.Hom[M,F.R] ;
   record Functional (i : Fin B.n) {
    linear : Dual.H.Hom ;
    unit : RL[(B.At[i].N.F.B)].unit (B.At[i].N.F.h (linear.fn (G.g i))) ;
   } ;
   module Given (rows : G.Rows) {
    n : Nat = B.n ;
    f (i : Fin n) : A.R = B.fs i ;
    a (i j : Fin n) : A.R = (rows i).coefficient j ;
    t (i : Fin n) : A.R = P.power (f i) (rows i).power ;
    module AtChart (j : Fin n) {
     module Br = B.At[j].N.Br ; module C = B.At[j].N.F ;
     module RR = C.RR ;
     t-unit : RL[C.B].unit (C.h (t j)) =
      Br.LocH.inverts (F.AF.elementary (f j)) (t j) ((rows j).power,refl (t j)) ;
     module Inv = SerreModuleBasicRestrictions[l].UnitAction[C.B,C.Rf,C.h (t j),t-unit] ;
    } ;
    row (i : Fin n) (v : G.V.Carrier) : A.R = RS.lin n (a i) v ;
    represent (i : Fin n) (v : G.V.Carrier) :
     Id M.M (M.sm (row i v) (G.g i)) (M.sm (t i) (G.q.fn v)) = calc M.M {
     M.sm (row i v) (G.g i)
      =< sym (MS.sum-scalars n (\ j -> A.mul (a i j) (v j)) (G.g i)) >
       MS.sum n (\ j -> M.sm (A.mul (a i j) (v j)) (G.g i))
      =< MS.sum-cong n _ _ (\ j -> trans (ap (\ b -> M.sm b (G.g i)) (A.mulC (a i j) (v j)))
       (trans (sym (M.smA (v j) (a i j) (G.g i)))
        (trans (ap (M.sm (v j)) (sym ((rows i).equation j))) (M0.sm-swap (v j) (t i) (G.g j))))) >
       MS.sum n (\ j -> M.sm (t i) (M.sm (v j) (G.g j)))
      =< MS.sum-scale (t i) n (\ j -> M.sm (v j) (G.g j)) > M.sm (t i) (G.q.fn v) } ;
    module At (i : Fin n) {
     difference (j k : Fin n) : A.R = R0.sub (A.mul (t j) (a i k)) (A.mul (a i j) (a j k)) ;
     same-action (j k : Fin n) :
      Id M.M (M.sm (A.mul (t j) (a i k)) (G.g i)) (M.sm (A.mul (a i j) (a j k)) (G.g i)) = calc M.M {
      M.sm (A.mul (t j) (a i k)) (G.g i)
       =< sym (M.smA (t j) (a i k) (G.g i)) > M.sm (t j) (M.sm (a i k) (G.g i))
       =< ap (M.sm (t j)) (sym ((rows i).equation k)) > M.sm (t j) (M.sm (t i) (G.g k))
       =< M0.sm-swap (t j) (t i) (G.g k) > M.sm (t i) (M.sm (t j) (G.g k))
       =< ap (M.sm (t i)) ((rows j).equation k) > M.sm (t i) (M.sm (a j k) (G.g j))
       =< M0.sm-swap (t i) (a j k) (G.g j) > M.sm (a j k) (M.sm (t i) (G.g j))
       =< ap (M.sm (a j k)) ((rows i).equation j) > M.sm (a j k) (M.sm (a i j) (G.g i))
       =< M.smA (a j k) (a i j) (G.g i) > M.sm (A.mul (a j k) (a i j)) (G.g i)
       =< ap (\ z -> M.sm z (G.g i)) (A.mulC (a j k) (a i j)) > M.sm (A.mul (a i j) (a j k)) (G.g i) } ;
     scalar-neg (b : A.R) : Id M.M (M.sm (A.neg b) (G.g i)) (M.mneg (M.sm b (G.g i))) =
      M0.neg-unique (M.sm b (G.g i)) (M.sm (A.neg b) (G.g i))
       (trans (sym (M.smE b (A.neg b) (G.g i))) (trans (ap (\ a -> M.sm a (G.g i)) (A.addN b)) (M0.zero-sm (G.g i)))) ;
     diff-kills (a0 b0 : A.R) (e : Id M.M (M.sm a0 (G.g i)) (M.sm b0 (G.g i))) :
      Id M.M (M.sm (R0.sub a0 b0) (G.g i)) M.mz =
      trans (ap (\ z -> M.sm z (G.g i)) (R0.sub-at a0 b0))
       (trans (M.smE a0 (A.neg b0) (G.g i))
        (trans (ap (M.madd (M.sm a0 (G.g i))) (scalar-neg b0))
         (trans (ap (\ z -> M.madd z (M.mneg (M.sm b0 (G.g i)))) e) (M.maddN (M.sm b0 (G.g i)))))) ;
     module Errors = CE.Over[A].Matrix[n,n,\ j k -> F.R,\ j k -> f i,difference] ;
     module Correct (w : Errors.Common) {
      c : A.R = P.power (f i) w.1 ;
      calc-row (v : G.V.Carrier) : A.R = A.mul c (row i v) ;
      linear-row : L.Linear[G.V.product,F.R].H.Hom = new L.Linear[G.V.product,F.R].H.Hom[
       calc-row,
       \ v u -> trans (ap (A.mul c) (RS.lin-add n (a i) v u)) (A.dist c (row i v) (row i u)),
       \ b v -> trans (ap (A.mul c) (RS.lin-scale n (a i) v b)) (AL.mul-swap c b (row i v))] ;
      match (j k : Fin n) : Id A.R (A.mul c (A.mul (t j) (a i k))) (A.mul c (A.mul (a i j) (a j k))) =
       R0.sub-zero _ _ (trans (sym (R0.sm-sub c (A.mul (t j) (a i k)) (A.mul (a i j) (a j k)))) (w.2 j k)) ;
      term (j k : Fin n) (v : G.V.Carrier) :
       Id A.R (A.mul (t j) (A.mul c (A.mul (a i k) (v k))))
        (A.mul (A.mul c (a i j)) (A.mul (a j k) (v k))) = calc A.R {
       A.mul (t j) (A.mul c (A.mul (a i k) (v k)))
        =< AL.mul-swap (t j) c (A.mul (a i k) (v k)) > A.mul c (A.mul (t j) (A.mul (a i k) (v k)))
        =< ap (A.mul c) (A.mulA (t j) (a i k) (v k)) > A.mul c (A.mul (A.mul (t j) (a i k)) (v k))
        =< A.mulA c (A.mul (t j) (a i k)) (v k) > A.mul (A.mul c (A.mul (t j) (a i k))) (v k)
        =< ap (\ z -> A.mul z (v k)) (match j k) > A.mul (A.mul c (A.mul (a i j) (a j k))) (v k)
        =< ap (\ z -> A.mul z (v k)) (A.mulA c (a i j) (a j k)) > A.mul (A.mul (A.mul c (a i j)) (a j k)) (v k)
        =< sym (A.mulA (A.mul c (a i j)) (a j k) (v k)) > A.mul (A.mul c (a i j)) (A.mul (a j k) (v k)) } ;
      scalar-relation (j : Fin n) (v : G.V.Carrier) :
       Id A.R (A.mul (t j) (calc-row v)) (A.mul (A.mul c (a i j)) (row j v)) =
       trans (ap (A.mul (t j)) (sym (RS.sum-scale c n (\ k -> A.mul (a i k) (v k)))))
        (trans (sym (RS.sum-scale (t j) n (\ k -> A.mul c (A.mul (a i k) (v k)))))
         (trans (RS.sum-cong n _ _ (\ k -> term j k v))
          (RS.sum-scale (A.mul c (a i j)) n (\ k -> A.mul (a j k) (v k))))) ;
      module Test (v : G.V.Carrier) (zero-v : Id M.M (G.q.fn v) M.mz) (j : Fin n) {
       module C = AtChart[j].C ; module RR = C.RR ;
       map-r : RingHom[l].Hom A C.B = F.AF.inclusion (f j) ;
       row-zero : Id C.B.R (C.h (row j v)) C.B.z =
        G.AtIndex[j].G.annihilator-local (row j v)
         (trans (represent j v) (trans (ap (M.sm (t j)) zero-v) (M0.sm-zero (t j)))) ;
       product-zero : Id C.B.R (C.B.mul (C.h (t j)) (C.h (calc-row v))) (C.B.mul (C.h (t j)) C.B.z) = calc C.B.R {
        C.B.mul (C.h (t j)) (C.h (calc-row v))
         =< sym (RM.map-mul map-r (t j) (calc-row v)) > C.h (A.mul (t j) (calc-row v))
         =< ap C.h (scalar-relation j v) > C.h (A.mul (A.mul c (a i j)) (row j v))
         =< RM.map-mul map-r (A.mul c (a i j)) (row j v) > C.B.mul (C.h (A.mul c (a i j))) (C.h (row j v))
         =< ap (C.B.mul (C.h (A.mul c (a i j)))) row-zero > C.B.mul (C.h (A.mul c (a i j))) C.B.z
         =< RL[C.B].mul-zero (C.h (A.mul c (a i j))) > C.B.z
         =< sym (RL[C.B].mul-zero (C.h (t j))) > C.B.mul (C.h (t j)) C.B.z } ;
       zero-local : Id RR.S.Carrier (RR.S.fraction (calc-row v) zero) (RR.S.fraction A.z zero) =
        RR.injective _ _ (trans (RR.forward-original (calc-row v))
         (trans (Iso[l].injective C.B.R C.B.R (C.B.mul (C.h (t j))) AtChart[j].Inv.equiv _ _ product-zero)
          (trans (sym (RM.map-zero map-r)) (sym (RR.forward-original A.z))))) ;
      } ;
      kills (v : G.V.Carrier) (z : Id M.M (G.q.fn v) M.mz) : Id A.R (calc-row v) A.z =
       Sep.Separate[calc-row v,A.z,\ j -> Test[v,z,j].zero-local].equal ;
      module Descent = SerreLinearDescent[l].Over[A,G.V.product,M,F.R].Along[G.q,linear-row,G.onto,kills] ;
      linear : Dual.H.Hom = Descent.descended ;
      multiplier : A.R = A.mul c (t i) ;
      module OnVector (x : M.M) {
       Claim : U l = Id M.M (M.sm (linear.fn x) (G.g i)) (M.sm multiplier x) ;
       on (v : G.Fibre x) : Claim = calc M.M {
        M.sm (linear.fn x) (G.g i)
         =< ap (\ b -> M.sm b (G.g i)) (Descent.from x v.1 v.2) > M.sm (calc-row v.1) (G.g i)
         =< sym (M.smA c (row i v.1) (G.g i)) > M.sm c (M.sm (row i v.1) (G.g i))
         =< ap (M.sm c) (represent i v.1) > M.sm c (M.sm (t i) (G.q.fn v.1))
         =< ap (\ z -> M.sm c (M.sm (t i) z)) v.2 > M.sm c (M.sm (t i) x)
         =< M.smA c (t i) x > M.sm multiplier x } ;
       claim : Claim = Tr.Trunc[G.Fibre x].induction @l (\ v -> Claim) (\ v -> M.setM _ _) on (G.onto x) ;
      } ;
      module C = AtChart[i].C ;
      m : A.R = linear.fn (G.g i) ;
      m-difference : Id C.B.R (C.h (R0.sub m multiplier)) C.B.z =
       G.AtIndex[i].G.annihilator-local (R0.sub m multiplier) (diff-kills m multiplier OnVector[G.g i].claim) ;
      equal-local : Id C.B.R (C.h m) (C.h multiplier) =
       Regularity[l].Over[C.B].difference _ _
        (trans (sym (trans (ap C.h (R0.sub-at m multiplier))
         (trans (RM.map-add (F.AF.inclusion (f i)) m (A.neg multiplier))
          (ap (C.B.add (C.h m)) (RM.map-neg (F.AF.inclusion (f i)) multiplier))))) m-difference) ;
      unit : RL[C.B].unit (C.h m) =
       subst (\ z -> RL[C.B].unit z) (sym equal-local)
        (subst (\ z -> RL[C.B].unit z)
         (ap C.h (P.power-add (f i) w.1 (rows i).power))
         (AtChart[i].Br.LocH.inverts (F.AF.elementary (f i))
          (P.power (f i) (plus w.1 (rows i).power)) (plus w.1 (rows i).power,refl (P.power (f i) (plus w.1 (rows i).power))))) ;
      functional : Functional[i] = new Functional[i,linear,unit] ;
     } ;
     common : Tr.Trunc[Errors.Common].carrier = Errors.common (\ j k ->
      G.AtIndex[i].G.annihilator (difference j k) (diff-kills (A.mul (t j) (a i k)) (A.mul (a i j) (a j k)) (same-action j k))) ;
     functional : Tr.Trunc[Functional[i]].carrier =
      Tr.Trunc[Errors.Common].induction @l (\ w -> Tr.Trunc[Functional[i]].carrier) (\ w -> Tr.Trunc[Functional[i]].proposition)
       (\ w -> Tr.Trunc[Functional[i]].inc Correct[w].functional) common ;
    } ;
    duals : Tr.Trunc[(i : Fin n) -> Functional[i]].carrier =
     AffineFinite[l].choice n (\ i -> Functional[i]) (\ i -> At[i].functional) ;
   } ;
   duals : Tr.Trunc[(i : Fin B.n) -> Functional[i]].carrier =
    Tr.Trunc[G.Rows].induction @l (\ rows -> Tr.Trunc[(i : Fin B.n) -> Functional[i]].carrier)
     (\ rows -> Tr.Trunc[(i : Fin B.n) -> Functional[i]].proposition) (\ rows -> Given[rows].duals) G.rows ;
  } ;
 } ;
} ;
