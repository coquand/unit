-- Identity and composition for associated module maps (Serre §4).
-- Their local equations hold on fraction representatives, hence on every
-- localised element by fraction induction. The associated section
-- equations then hold componentwise. The final equations are stated for
-- the actual natural linear morphisms, using their named section formulas.
level l ; open Ring[l] ; open Presentations[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ;
module Associated = SerreAssociatedMap[l] ;
module Identity (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module H = MM.Between[A,A,RH.identity A,Md,Md] ;
 identity : H.Hom = new H.Hom[\ x -> x,\ x y -> refl (Md.madd x y),\ a x -> refl (Md.sm a x)] ;
 identity-at (x : Md.M) : Id Md.M (H.map identity x) x = refl x ;
 module F = Associated.Over[A,setA,Md,Md,identity] ;
 local (g : A.R) (x : F.MR.Local[g].Native.L.Carrier) : Id F.MR.Local[g].Native.L.Carrier (F.Local[g].at x) x =
  F.MR.Local[g].Native.L.induction @l
   (\ x -> Id F.MR.Local[g].Native.L.Carrier (F.Local[g].at x) x)
   (\ x -> F.MR.Local[g].Native.L.carrier-set _ _)
   (\ x p -> trans (F.Local[g].on-fractions x p) (ap (\ z -> F.MR.Local[g].Native.L.fraction z p) (identity-at x))) x ;
 section (v : F.Z.lattice.L) (s : F.M.Section v) : Id (F.M.Section v) (F.section-map v s) s =
  F.M.section-ext v _ _ (\ g k -> trans (F.section-map-at v s g k) (local g (F.M.at s g k))) ;
 morphism-at (v : F.Z.lattice.L) (s : F.M.Section v) : Id (F.M.Section v) (F.Transform.at F.morphism v s) s =
  trans (F.morphism-at v s) (section v s) ;
 opaque identity ;
} ;
module Composite (A : CRing) (setA : Pr.isSet A.R) (Md Nd Pd : SM.Over[A].Module)
 (u : MM.Between[A,A,RH.identity A,Md,Nd].Hom)
 (v : MM.Between[A,A,RH.identity A,Nd,Pd].Hom) {
 module UMap = MM.Between[A,A,RH.identity A,Md,Nd] ;
 module VMap = MM.Between[A,A,RH.identity A,Nd,Pd] ;
 module WMap = MM.Between[A,A,RH.identity A,Md,Pd] ;
 composite : WMap.Hom = new WMap.Hom[\ x -> VMap.map v (UMap.map u x),
  \ x y -> trans (ap (VMap.map v) (UMap.map-add u x y)) (VMap.map-add v (UMap.map u x) (UMap.map u y)),
  \ a x -> trans (ap (VMap.map v) (UMap.map-scale u a x)) (VMap.map-scale v a (UMap.map u x))] ;
 composite-at (x : Md.M) : Id Pd.M (WMap.map composite x) (VMap.map v (UMap.map u x)) = refl (VMap.map v (UMap.map u x)) ;
 module F = Associated.Over[A,setA,Md,Nd,u] ;
 module G = Associated.Over[A,setA,Nd,Pd,v] ;
 module K = Associated.Over[A,setA,Md,Pd,composite] ;
 local (g : A.R) (x : F.MR.Local[g].Native.L.Carrier) :
  Id G.NR.Local[g].Native.L.Carrier (G.Local[g].at (F.Local[g].at x)) (K.Local[g].at x) =
  F.MR.Local[g].Native.L.induction @l
   (\ x -> Id G.NR.Local[g].Native.L.Carrier (G.Local[g].at (F.Local[g].at x)) (K.Local[g].at x))
   (\ x -> G.NR.Local[g].Native.L.carrier-set _ _)
   (\ x p -> trans (ap G.Local[g].at (F.Local[g].on-fractions x p))
    (trans (G.Local[g].on-fractions (UMap.map u x) p)
     (trans (ap (\ y -> G.NR.Local[g].Native.L.fraction y p) (sym (composite-at x))) (sym (K.Local[g].on-fractions x p))))) x ;
 section (w : F.Z.lattice.L) (s : F.M.Section w) :
  Id (G.N.Section w) (G.section-map w (F.section-map w s)) (K.section-map w s) =
  G.N.section-ext w _ _ (\ g k -> trans (G.section-map-at w (F.section-map w s) g k)
   (trans (ap G.Local[g].at (F.section-map-at w s g k))
    (trans (local g (F.M.at s g k)) (sym (K.section-map-at w s g k))))) ;
 morphism-at (w : F.Z.lattice.L) (s : F.M.Section w) :
  Id (G.N.Section w)
   (G.Transform.at G.morphism w (F.Transform.at F.morphism w s)) (K.Transform.at K.morphism w s) =
  trans (G.morphism-at w (F.Transform.at F.morphism w s))
   (trans (ap (G.section-map w) (F.morphism-at w s)) (trans (section w s) (sym (K.morphism-at w s)))) ;
 opaque composite ;
} ;
