-- Naturality of the geometric basic-open identification.
-- j_g:Spec(B[1/g])->Spec(B)|D(g) is SpecBasicOpen's isomorphism.
-- Its composite with the open inclusion is Spec(beta_g), by factor-cut.
-- For D(h)<=D(g), rho:B[1/g]->B[1/h] commutes with beta.  Functoriality
-- of Spec therefore gives Spec(beta_g) Spec(rho)=Spec(beta_h).
-- Composing the desired square with the inclusion into Spec B gives
-- exactly this equation and the two factor-cut triangles.  OpenMonic
-- cancels the inclusion.  Thus j_g Spec(rho)=embedding j_h.
-- No fraction is analysed and no explicit inverse transition is needed.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module CP = SpacePaths[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ;
module T = AffineTests[l] ;
module OnRing (B : T.Test) (g : B.ring.R) {
 module A = T.At[B].A ;
 module Z = T.At[B].Z ;
 module S = SpecBasicOpen[l].Over[B.ring,B.carrier-set,g] ;
 native-source : Sp.Space = new Sp.Space[S.ZG.lattice,S.SG.spec] ;
 native-target : Sp.Space = new Sp.Space[S.Sl.lattice,S.Sl.restricted] ;
 source-view : Id Sp.Space native-source (T.space (T.localised B g)) = refl native-source ;
 target-view : Id Sp.Space native-target (Op.space (T.space B) (Z.D g)) = refl native-target ;
 native-j : Sp.Hom native-source native-target = (S.JB.factor,S.j-local) ;
 native-iso : Sp.IsIso native-source native-target native-j = S.j-iso ;
 j : Sp.Hom (T.space (T.localised B g)) (Op.space (T.space B) (Z.D g)) =
  CP.change native-source (T.space (T.localised B g)) native-target (Op.space (T.space B) (Z.D g)) source-view target-view native-j ;
 iso : Sp.IsIso (T.space (T.localised B g)) (Op.space (T.space B) (Z.D g)) j =
  CP.Of[native-source,T.space (T.localised B g),native-target,Op.space (T.space B) (Z.D g),source-view,target-view,native-j].iso native-iso ;
 module V = Sp.InvertMap[T.space (T.localised B g),Op.space (T.space B) (Z.D g),j,iso] ;
 native-base : Sp.Space = new Sp.Space[Z.lattice,A.spec] ;
 base-view : Id Sp.Space native-base (T.space B) = refl native-base ;
 native-inclusion : Sp.Hom native-target native-base = (S.Sl.inclusion,S.Sl.inclusion-local) ;
 native-beta : Sp.Hom native-source native-base = (S.J.morphism,S.J.local) ;
 native-triangle : Id (Sp.Hom native-source native-base)
  (Sp.compose native-source native-target native-base native-inclusion native-j) native-beta =
  Sp.ext native-source native-base (Sp.compose native-source native-target native-base native-inclusion native-j) native-beta S.JB.factor-cut ;
 inclusion-view : Id (Sp.Hom (Op.space (T.space B) (Z.D g)) (T.space B))
  (CP.change native-target (Op.space (T.space B) (Z.D g)) native-base (T.space B) target-view base-view native-inclusion)
  (Op.inclusion (T.space B) (Z.D g)) = refl (Op.inclusion (T.space B) (Z.D g)) ;
 beta-view : Id (Sp.Hom (T.space (T.localised B g)) (T.space B))
  (CP.change native-source (T.space (T.localised B g)) native-base (T.space B) source-view base-view native-beta)
  T.Map[B,(T.localised B g),A.inclusion g].morphism =
  Sp.ext (T.space (T.localised B g)) (T.space B)
   (CP.change native-source (T.space (T.localised B g)) native-base (T.space B) source-view base-view native-beta)
   T.Map[B,(T.localised B g),A.inclusion g].morphism (sym T.Map[B,(T.localised B g),A.inclusion g].underlying-map) ;
 triangle : Id (Sp.Hom (T.space (T.localised B g)) (T.space B))
  (Sp.compose (T.space (T.localised B g)) (Op.space (T.space B) (Z.D g)) (T.space B) (Op.inclusion (T.space B) (Z.D g)) j)
  T.Map[B,(T.localised B g),A.inclusion g].morphism =
  trans (ap (\ inc -> Sp.compose (T.space (T.localised B g)) (Op.space (T.space B) (Z.D g)) (T.space B) inc j) (sym inclusion-view))
   (trans (sym CP.Composite[native-source,T.space (T.localised B g),native-target,Op.space (T.space B) (Z.D g),native-base,T.space B,
     source-view,target-view,base-view,native-inclusion,native-j].equation)
    (trans (ap (CP.change native-source (T.space (T.localised B g)) native-base (T.space B) source-view base-view) native-triangle) beta-view)) ;
 module Value (Y : Sp.Space) (p : Sp.Hom (T.space (T.localised B g)) Y) {
  on-open : Sp.Hom (Op.space (T.space B) (Z.D g)) Y =
   Sp.compose (Op.space (T.space B) (Z.D g)) (T.space (T.localised B g)) Y p V.inverse ;
  on-j : Id (Sp.Hom (T.space (T.localised B g)) Y)
   (Sp.compose (T.space (T.localised B g)) (Op.space (T.space B) (Z.D g)) Y on-open j) p =
   trans (sym Sp.Associativity[T.space (T.localised B g),Op.space (T.space B) (Z.D g),T.space (T.localised B g),Y,p,V.inverse,j].assoc)
    (trans (ap (Sp.compose (T.space (T.localised B g)) (T.space (T.localised B g)) Y p) V.inverse-left) Sp.Laws[T.space (T.localised B g),Y,p].right) ;
 } ;
} ;
module Along (B : T.Test) (g h : B.ring.R) (le : T.At[B].Z.O.Le (T.At[B].Z.D h) (T.At[B].Z.D g)) {
 module A = T.At[B].A ;
 module Z = T.At[B].Z ;
 module S = Sections[l].Over[B.ring,A.Loc,A.set,A.inclusion,A.elementary] ;
 module G = OnRing[B,g] ;
 module H = OnRing[B,h] ;
 module E = Op.Below[T.space B,Z.D h,Z.D g,le] ;
 module R = T.Map[(T.localised B g),(T.localised B h),S.rho g h le] ;
 base : Id (RH.Hom B.ring (A.Loc h))
  (RH.compose B.ring (A.Loc g) (A.Loc h) (S.rho g h le) (A.inclusion g)) (A.inclusion h) =
  RH.Properties[B.ring,A.Loc h,A.set h].ext _ _ (S.rho-on g h le) ;
 composite-base : Id (Sp.Hom (T.space (T.localised B h)) (T.space B))
  (Sp.compose (T.space (T.localised B h)) (T.space (T.localised B g)) (T.space B)
   T.Map[B,(T.localised B g),A.inclusion g].morphism R.morphism)
  T.Map[B,(T.localised B h),A.inclusion h].morphism =
  trans (sym T.Composition[B,(T.localised B g),(T.localised B h),A.inclusion g,S.rho g h le].composition)
   (ap (\ b -> T.Map[B,(T.localised B h),b].morphism) base) ;
 natural : Id (Sp.Hom (T.space (T.localised B h)) (Op.space (T.space B) (Z.D g)))
  (Sp.compose (T.space (T.localised B h)) (T.space (T.localised B g)) (Op.space (T.space B) (Z.D g)) G.j R.morphism)
  (Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D h)) (Op.space (T.space B) (Z.D g)) E.embedding H.j) =
  OpenMonic[l].Over[T.space B,T.space (T.localised B h),Z.D g].cancel _ _
   (calc (Sp.Hom (T.space (T.localised B h)) (T.space B)) {
    Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D g)) (T.space B) (Op.inclusion (T.space B) (Z.D g))
     (Sp.compose (T.space (T.localised B h)) (T.space (T.localised B g)) (Op.space (T.space B) (Z.D g)) G.j R.morphism)
     =< Sp.Associativity[T.space (T.localised B h),T.space (T.localised B g),Op.space (T.space B) (Z.D g),T.space B,
         Op.inclusion (T.space B) (Z.D g),G.j,R.morphism].assoc
     > Sp.compose (T.space (T.localised B h)) (T.space (T.localised B g)) (T.space B)
        (Sp.compose (T.space (T.localised B g)) (Op.space (T.space B) (Z.D g)) (T.space B) (Op.inclusion (T.space B) (Z.D g)) G.j) R.morphism
     =< ap (\ q -> Sp.compose (T.space (T.localised B h)) (T.space (T.localised B g)) (T.space B) q R.morphism) G.triangle
     > Sp.compose (T.space (T.localised B h)) (T.space (T.localised B g)) (T.space B) T.Map[B,(T.localised B g),A.inclusion g].morphism R.morphism
     =< composite-base > T.Map[B,(T.localised B h),A.inclusion h].morphism
     =< sym H.triangle
     > Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D h)) (T.space B) (Op.inclusion (T.space B) (Z.D h)) H.j
     =< ap (\ q -> Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D h)) (T.space B) q H.j) (sym E.triangle)
     > Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D h)) (T.space B)
        (Sp.compose (Op.space (T.space B) (Z.D h)) (Op.space (T.space B) (Z.D g)) (T.space B) (Op.inclusion (T.space B) (Z.D g)) E.embedding) H.j
     =< sym Sp.Associativity[T.space (T.localised B h),Op.space (T.space B) (Z.D h),Op.space (T.space B) (Z.D g),T.space B,
         Op.inclusion (T.space B) (Z.D g),E.embedding,H.j].assoc
     > Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D g)) (T.space B) (Op.inclusion (T.space B) (Z.D g))
        (Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D h)) (Op.space (T.space B) (Z.D g)) E.embedding H.j) }) ;
 -- Compare a map on a localised affine with its restriction to D(h).
 module Pull (Y : Sp.Space) (p : Sp.Hom (T.space (T.localised B g)) Y) {
  module V = G.Value[Y,p] ;
  trace : Id (Sp.Hom (T.space (T.localised B h)) Y)
   (Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D h)) Y
    (Sp.compose (Op.space (T.space B) (Z.D h)) (Op.space (T.space B) (Z.D g)) Y V.on-open E.embedding) H.j)
   (Sp.compose (T.space (T.localised B h)) (T.space (T.localised B g)) Y p R.morphism) =
   trans (sym Sp.Associativity[T.space (T.localised B h),Op.space (T.space B) (Z.D h),Op.space (T.space B) (Z.D g),Y,V.on-open,E.embedding,H.j].assoc)
    (trans (ap (Sp.compose (T.space (T.localised B h)) (Op.space (T.space B) (Z.D g)) Y V.on-open) (sym natural))
     (trans Sp.Associativity[T.space (T.localised B h),T.space (T.localised B g),Op.space (T.space B) (Z.D g),Y,V.on-open,G.j,R.morphism].assoc
      (ap (\ q -> Sp.compose (T.space (T.localised B h)) (T.space (T.localised B g)) Y q R.morphism) V.on-j))) ;
 } ;
} ;
