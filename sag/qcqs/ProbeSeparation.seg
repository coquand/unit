-- Affine probes detect equality of morphisms out of a qcqs scheme.
-- For an actual affine atlas j_i : U_i -> X, choose the canonical
-- isomorphism c_i : U_i -> Spec Gamma(U_i), with inverse v_i.  The chart
-- probe j_i v_i is an affine probe.  If f and g agree on all such probes,
-- associativity gives (f j_i)v_i = (g j_i)v_i.  Cancelling precomposition
-- with v_i (Spaces.InvertMap.cancel) gives f j_i = g j_i.  MapSeparation
-- on the atlas gives f = g.  A qcqs atlas merely exists, but equality of
-- morphisms is a proposition, so this is enough.
-- Consequently the functor of points is faithful for qcqs sources: equality
-- of the induced natural transformations gives equality on every probe.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module Op = OpenMaps[l] ;
module FP = FunctorPoints[l] ;
module Over (X Y : Sp.Space) {
 module O = DL.Order[X.lattice] ;
 module Q = Qcqs[l].Over[X.lattice,X.structure] ;
 module Sep = MapSeparation[l].Maps[Y.lattice,X.lattice,Y.structure.sheaf,X.structure] ;
 module Compare (f g : Sp.Hom X Y)
  (on : (A : T.Test) (p : Sp.Hom (T.space A) X) -> Id (Sp.Hom (T.space A) Y)
    (Sp.compose (T.space A) X Y f p) (Sp.compose (T.space A) X Y g p)) {
  module FromCover (c : Q.AffineCover) {
   module At (i : Fin c.count) {
    module AS = AffineSource[l].FromAffine[Op.space X (c.opens i),Y,c.affine i] ;
    module V = Sp.InvertMap[Op.space X (c.opens i),T.space AS.test,AS.canonical,AS.canonical-iso] ;
    probe : Sp.Hom (T.space AS.test) X =
     Sp.compose (T.space AS.test) (Op.space X (c.opens i)) X (Op.inclusion X (c.opens i)) V.inverse ;
    precomp : Id (Sp.Hom (T.space AS.test) Y)
     (Sp.compose (T.space AS.test) (Op.space X (c.opens i)) Y
       (Sp.compose (Op.space X (c.opens i)) X Y f (Op.inclusion X (c.opens i))) V.inverse)
     (Sp.compose (T.space AS.test) (Op.space X (c.opens i)) Y
       (Sp.compose (Op.space X (c.opens i)) X Y g (Op.inclusion X (c.opens i))) V.inverse) =
     trans (sym Sp.Associativity[T.space AS.test,Op.space X (c.opens i),X,Y,f,Op.inclusion X (c.opens i),V.inverse].assoc)
      (trans (on AS.test probe) Sp.Associativity[T.space AS.test,Op.space X (c.opens i),X,Y,g,Op.inclusion X (c.opens i),V.inverse].assoc) ;
    restricted : Id (Sp.Hom (Op.space X (c.opens i)) Y)
     (Sp.compose (Op.space X (c.opens i)) X Y f (Op.inclusion X (c.opens i)))
     (Sp.compose (Op.space X (c.opens i)) X Y g (Op.inclusion X (c.opens i))) =
     V.cancel Y (Sp.compose (Op.space X (c.opens i)) X Y f (Op.inclusion X (c.opens i)))
      (Sp.compose (Op.space X (c.opens i)) X Y g (Op.inclusion X (c.opens i))) precomp ;
   } ;
   cover-le : O.Le X.lattice.top (DL.Joins[X.lattice].bigJ c.count c.opens) =
    O.le-of-eq X.lattice.top (DL.Joins[X.lattice].bigJ c.count c.opens) (sym c.covers) ;
   separated : Id (Sp.Hom X Y) f g =
    Sp.ext X Y f g (Sep.Cover[c.count,c.opens,cover-le].separated (Sp.underlying f) (Sp.underlying g)
     (\ i -> ap (Sp.underlying {Op.space X (c.opens i)} {Y}) At[i].restricted)) ;
  } ;
  separated (qcqs : Q.IsQcqs) : Id (Sp.Hom X Y) f g =
   Tr.Trunc[Q.AffineCover].induction @l (\ t -> Id (Sp.Hom X Y) f g) (\ t -> Sp.set X Y f g) (\ c -> FromCover[c].separated) qcqs ;
 } ;
 module Natural (qcqs : Q.IsQcqs) {
  module N = FP.Maps[X,Y] ;
  faithful (f g : Sp.Hom X Y) (e : Id N.Nat (N.induced f) (N.induced g)) : Id (Sp.Hom X Y) f g =
   Compare[f,g,\ A p -> Hi.ap N.Nat (Sp.Hom (T.space A) Y) (\ a -> N.at a A p) (N.induced f) (N.induced g) e].separated qcqs ;
 } ;
} ;
