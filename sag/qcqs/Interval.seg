-- The interval [a, top] of a distributive lattice M (DESIGN.md, Next 4,
-- milestone 2).
--
-- Its elements are the u in M with a <= u; top, joins and meets are those
-- of M, the bottom is a.  The laws hold in M; a \/ ... only enters joinB:
-- u \/ a = u for a <= u.
-- r(u) = a \/ u is a lattice map M -> [a, top]: a \/ bot = a,
--  a \/ top = top, a \/ (u \/ v) = (a \/ a) \/ (u \/ v) = (a \/ u) \/ (a \/ v),
--  and a \/ (u /\ v) = (a \/ u) /\ (a \/ v): <= by monotonicity, >= since the
--  four meets a /\ a, a /\ v, u /\ a, u /\ v lie below a \/ (u /\ v).
--  On the interval r(u) = u.
-- Lemma (determined).  Two lattice maps k, k2 on [a, top] with
--  k . r = k2 . r are equal: k(u) = k(r u) = k2(r u) = k2(u).
-- Lemma (complements).  The complementary pairs of [a, top] are the pairs
--  (u, v) of M with u \/ v = top and u /\ v = a; then a = u /\ v <= u, v.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Up (M : DL.DLat) (a : M.L) {
 module O = DL.Order[M] ;
 El : U l = (u : M.L) * O.Le a u ;
 el-ext (x y : El) (e : Id M.L x.1 y.1) : Id El x y = Pr.Sigma-eq M.L (O.Le a) x.1 y.1 x.2 y.2 e (O.le-prop a y.1) ;
 set : Pr.isSet El = Pr.isSet-Sigma M.L (O.Le a) M.setL (\ u -> Pr.prop-to-set (O.Le a u) (O.le-prop a u)) ;
 bottom : El = (a,O.le-refl a) ;
 topU : El = (M.top,O.le-top a) ;
 joinU (x y : El) : El = (M.join x.1 y.1,O.le-trans a x.1 (M.join x.1 y.1) x.2 (O.join-left x.1 y.1)) ;
 meetU (x y : El) : El = (M.meet x.1 y.1,O.meet-glb x.1 y.1 a x.2 y.2) ;
 -- u \/ a = u for a <= u
 join-below (u : M.L) (h : O.Le a u) : Id M.L (M.join u a) u =
  O.le-antisym (M.join u a) u (O.join-lub u a u (O.le-refl u) h) (O.join-left u a) ;
 lattice : DL.DLat = DL.mkDLat El set bottom topU joinU meetU
  (\ x y w -> el-ext (joinU x (joinU y w)) (joinU (joinU x y) w) (M.joinA x.1 y.1 w.1))
  (\ x y -> el-ext (joinU x y) (joinU y x) (M.joinC x.1 y.1))
  (\ x -> el-ext (joinU x bottom) x (join-below x.1 x.2))
  (\ x y w -> el-ext (meetU x (meetU y w)) (meetU (meetU x y) w) (M.meetA x.1 y.1 w.1))
  (\ x y -> el-ext (meetU x y) (meetU y x) (M.meetC x.1 y.1))
  (\ x -> el-ext (meetU x topU) x (M.meetT x.1))
  (\ x y -> el-ext (meetU x (joinU x y)) x (M.absorb-meet x.1 y.1))
  (\ x y -> el-ext (joinU x (meetU x y)) x (M.absorb-join x.1 y.1))
  (\ x y w -> el-ext (meetU x (joinU y w)) (joinU (meetU x y) (meetU x w)) (M.dist x.1 y.1 w.1)) ;
 -- the element of an element of the interval, in M
 incl (x : lattice.L) : M.L = x.1 ;

 -- r(u) = a \/ u
 retract (u : M.L) : El = (M.join a u,O.join-left a u) ;
 join-idem : Id M.L (M.join a a) a = trans (ap (M.join a) (sym (O.meet-idem a))) (M.absorb-join a a) ;
 r-top : Id M.L (M.join a M.top) M.top = O.le-antisym (M.join a M.top) M.top (O.le-top (M.join a M.top)) (O.join-right a M.top) ;
 r-join (u v : M.L) : Id M.L (M.join a (M.join u v)) (M.join (M.join a u) (M.join a v)) = calc M.L {
  M.join a (M.join u v) =< ap (\ t -> M.join t (M.join u v)) (sym join-idem) > M.join (M.join a a) (M.join u v)
   =< O.join-interchange a a u v > M.join (M.join a u) (M.join a v) } ;
 r-meet (u v : M.L) : Id M.L (M.join a (M.meet u v)) (M.meet (M.join a u) (M.join a v)) =
  O.le-antisym (M.join a (M.meet u v)) (M.meet (M.join a u) (M.join a v))
   (O.meet-glb (M.join a u) (M.join a v) (M.join a (M.meet u v))
    (O.join-mono a (M.meet u v) a u (O.le-refl a) (O.meet-left u v))
    (O.join-mono a (M.meet u v) a v (O.le-refl a) (O.meet-right u v)))
   (O.meet-joins-below a u a v (M.join a (M.meet u v))
    (O.le-trans (M.meet a a) a (M.join a (M.meet u v)) (O.meet-left a a) (O.join-left a (M.meet u v)))
    (O.le-trans (M.meet a v) a (M.join a (M.meet u v)) (O.meet-left a v) (O.join-left a (M.meet u v)))
    (O.le-trans (M.meet u a) a (M.join a (M.meet u v)) (O.meet-right u a) (O.join-left a (M.meet u v)))
    (O.join-right a (M.meet u v))) ;
 r : DL.Hom M lattice =
  (retract,
   el-ext (retract M.bot) bottom (M.joinB a),
   el-ext (retract M.top) topU r-top,
   \ u v -> el-ext (retract (M.join u v)) (joinU (retract u) (retract v)) (r-join u v),
   \ u v -> el-ext (retract (M.meet u v)) (meetU (retract u) (retract v)) (r-meet u v)) ;
 -- r(u) = u on the interval
 r-on (x : lattice.L) : Id lattice.L (DL.hmap r (incl x)) x =
  el-ext (retract x.1) x (O.le-antisym (M.join a x.1) x.1 (O.join-lub a x.1 x.1 x.2 (O.le-refl x.1)) (O.join-right a x.1)) ;
 -- maps out of the interval are determined by their composite with r
 determined (N : DL.DLat) (k k2 : DL.Hom lattice N)
  (e : (u : M.L) -> Id N.L (DL.hmap k (DL.hmap r u)) (DL.hmap k2 (DL.hmap r u))) (x : lattice.L) :
  Id N.L (DL.hmap k x) (DL.hmap k2 x) = calc N.L {
  DL.hmap k x =< ap (DL.hmap k) (sym (r-on x)) > DL.hmap k (DL.hmap r (incl x))
   =< e (incl x) > DL.hmap k2 (DL.hmap r (incl x))
   =< ap (DL.hmap k2) (r-on x) > DL.hmap k2 x } ;

 -- complementary pairs of the interval
 module CU = DL.Complements[lattice] ;
 Splitting (p : M.L * M.L) : U l = Id M.L (M.join p.1 p.2) M.top * Id M.L (M.meet p.1 p.2) a ;
 Splittings : U l = (p : M.L * M.L) * Splitting p ;
 splitting-prop (p : M.L * M.L) : Pr.isProp (Splitting p) =
  Pr.isProp-Sigma (Id M.L (M.join p.1 p.2) M.top) (\ c -> Id M.L (M.meet p.1 p.2) a)
   (M.setL (M.join p.1 p.2) M.top) (\ c -> M.setL (M.meet p.1 p.2) a) ;
 to-splitting (c : CU.Pairs) : Splittings =
  ((incl c.1.1,incl c.1.2),ap incl c.2.1,ap incl c.2.2) ;
 -- a = u /\ v <= u, v
 above-left (u v : M.L) (m : Id M.L (M.meet u v) a) : O.Le a u = Pr.subst M.L (\ t -> O.Le t u) (M.meet u v) a m (O.meet-left u v) ;
 above-right (u v : M.L) (m : Id M.L (M.meet u v) a) : O.Le a v = Pr.subst M.L (\ t -> O.Le t v) (M.meet u v) a m (O.meet-right u v) ;
 to-pair (s : Splittings) : CU.Pairs =
  (((s.1.1,above-left s.1.1 s.1.2 s.2.2),(s.1.2,above-right s.1.1 s.1.2 s.2.2)),
   el-ext (joinU (s.1.1,above-left s.1.1 s.1.2 s.2.2) (s.1.2,above-right s.1.1 s.1.2 s.2.2)) topU s.2.1,
   el-ext (meetU (s.1.1,above-left s.1.1 s.1.2 s.2.2) (s.1.2,above-right s.1.1 s.1.2 s.2.2)) bottom s.2.2) ;
 splittings : Pr.isEquiv CU.Pairs Splittings to-splitting =
  Pr.qinv CU.Pairs Splittings to-splitting to-pair
   (\ s -> Pr.Sigma-eq (M.L * M.L) Splitting (to-splitting (to-pair s)).1 s.1 (to-splitting (to-pair s)).2 s.2
     (refl s.1) (splitting-prop s.1))
   (\ c -> CU.pair-ext (to-pair (to-splitting c)) c (el-ext (to-pair (to-splitting c)).1.1 c.1.1 (refl (incl c.1.1)))
     (el-ext (to-pair (to-splitting c)).1.2 c.1.2 (refl (incl c.1.2)))) ;
} ;
