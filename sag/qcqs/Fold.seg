-- The fold map of the doubling (DESIGN.md, Next 4, interface (a)).
--
-- Let X2 be the doubling of X along d (Doubling).  The fold map X2 -> X
-- (ringed convention: a map (L, O) -> (L2, O2)) has inverse image the
-- diagonal u |-> (u, u) (u /\ d = u /\ d) and ring maps s |-> (s, s): both
-- components restrict on mid (u, u) = u /\ d to s|(u /\ d), with two
-- witnesses of u /\ d <= u (FibreProduct.Lift).
-- The diagonal preserves bot and top by definition, joins and meets
--  componentwise.  Restriction commutes componentwise: the components of
--  (s, s)|(u, u) are restrictions of s (Doubling.Res).
-- Lemma (local).  D2(s, s) = (D s, D s) is the diagonal of D s
--  (Doubling.d-first, d-second).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (d : L.L) {
 module O = DL.Order[L] ;
 module Dbl = Doubling[l].Over[L,X,d] ;
 module DD = Dbl.DD ;
 module GO = Dbl.GO ;
 module LX = Dbl.LX ;

 -- the diagonal
 diag (u : L.L) : DD.Opens = DD.pair u u (refl (L.meet u d)) ;
 lat : DL.Hom L DD.lattice =
  (diag,refl DD.botD,refl DD.topD,
   \ u v -> DD.ext (diag (L.join u v)) (DD.joinD (diag u) (diag v)) (refl (L.join u v)) (refl (L.join u v)),
   \ u v -> DD.ext (diag (L.meet u v)) (DD.meetD (diag u) (diag v)) (refl (L.meet u v)) (refl (L.meet u v))) ;

 -- s |-> (s, s)
 module At (u : L.L) {
  agrees (s : (X.sheaf.ring u).R) : Dbl.At[diag u].P.Agree s s =
   GO.res-irr (L.meet u d) u (DD.mid-first (diag u)) (DD.mid-second (diag u)) s ;
  sharp : RH.Hom (X.sheaf.ring u) (Dbl.ring (diag u)) =
   Dbl.At[diag u].P.Lift[X.sheaf.ring u,RH.identity (X.sheaf.ring u),RH.identity (X.sheaf.ring u),agrees].lift ;
 } ;
 -- typed at the image of u, diag u by definition
 sharp (u : L.L) : RH.Hom (X.sheaf.ring u) (Dbl.ring (DL.hmap lat u)) = At[u].sharp ;
 -- its components, by definition
 left-sharp (u : L.L) (s : (X.sheaf.ring u).R) : Id (X.sheaf.ring u).R (Dbl.left (diag u) (map (sharp u) s)) s = refl s ;
 right-sharp (u : L.L) (s : (X.sheaf.ring u).R) : Id (X.sheaf.ring u).R (Dbl.right (diag u) (map (sharp u) s)) s = refl s ;

 module Mp = LocallyRinged[l].Maps[L,DD.lattice,X.sheaf,Dbl.doubled.sheaf] ;
 natural (u v : L.L) (k : O.Le u v) (s : (X.sheaf.ring v).R) :
  Id (Dbl.ring (DL.hmap lat u)).R
   (map (Dbl.res (DL.hmap lat u) (DL.hmap lat v) (DL.JoinMaps[L,DD.lattice,lat].monotone u v k)) (map (sharp v) s))
   (map (sharp u) (GO.restrict u v k s)) =
  Dbl.ext (diag u) (map (Dbl.res (diag u) (diag v) (DL.JoinMaps[L,DD.lattice,lat].monotone u v k)) (map (sharp v) s))
   (map (sharp u) (GO.restrict u v k s))
   (GO.res-irr u v (Dbl.Res[diag u,diag v,DL.JoinMaps[L,DD.lattice,lat].monotone u v k].k1) k s)
   (GO.res-irr u v (Dbl.Res[diag u,diag v,DL.JoinMaps[L,DD.lattice,lat].monotone u v k].k2) k s) ;
 fold : Mp.Ringed = new Mp.Ringed[lat,sharp,natural] ;

 -- the fold map is local
 local : Mp.Of[fold,X.inv,Dbl.doubled.inv].IsLocal = \ u s ->
  DD.le-pair (Dbl.L2.d (DL.hmap fold.lat u) (map (fold.sharp u) s)) (DL.hmap fold.lat (LX.d u s))
   (O.le-refl (LX.d u s)) (O.le-refl (LX.d u s)) ;
} ;
