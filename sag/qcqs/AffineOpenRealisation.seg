-- A compact open of an affine representable has a geometric realisation.
-- Let U:h_A->Zar and d=U_A(1).  The affine equivalence h_A=h_(Spec A)
-- takes h:A->B to Spec h.  Its inverse image of d is h_*(d)=U_B(h),
-- by ZariskiFunctor and the affine pullback formula.  Thus it preserves
-- and reflects membership in U and in the geometric classifier of d.
-- RealisationTransfer identifies their realisations.  GeometricOpens
-- identifies the second one with h_((Spec A)|d); compose to obtain the
-- representation of |U| by that open subspace.  Its inclusion into the
-- affine functor is the geometric inclusion, expressed by trace below.
-- The representing open subspace is qcqs (SliceQcqs), with no assumption
-- that it is itself affine and no choice of ideal generators.
level l ; open Ring[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SP = Spaces[l] ;
module Op = OpenMaps[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module CO = CompactOpens[l] ;
module ZF = ZariskiFunctor[l] ;
module Over (A : T.Test) (u : CO.Over[SF.Representable[A].functor].Open) {
 module AF = AffineFunctor[l].Spectrum[A] ;
 module C = CO.Over[AF.H.functor] ;
 module AC = CompactAffineCover[l].Over[A,u] ;
 module GO = GeometricOpens[l].Over[T.space A] ;
 module GR = GO.Realisation[AC.extent] ;
 module UO = OpenRealisation[l].Over[AF.H.functor,u] ;
 comparison (B : T.Test) (h : RingHom[l].Hom A.ring B.ring) : Id T.At[B].Z.lattice.L
  (GO.C.value (GO.classifier AC.extent) B (AF.N.at (TE.forward AF.equivalence) B h)) (C.value u B h) =
  trans (ap (\ p -> DL.hmap (SP.underlying {T.space B} {T.space A} p).lat AC.extent) (AF.map-at B h))
   (trans (ZF.OnMap[A,B,h].spec-lattice AC.extent) (AC.value-as-image B h)) ;
 module R = RealisationTransfer[l].Over[AF.H.functor,AF.G.functor,u,GO.classifier AC.extent,AF.equivalence].Given[
  \ B h m -> trans (comparison B h) m,\ B h m -> trans (sym (comparison B h)) m] ;
 module V = TE.Inverse[UO.functor,GR.R.functor,R.equivalence] ;
 space : SP.Space = Op.space (T.space A) AC.extent ;
 qcqs : Qcqs[l].Over[space.lattice,space.structure].IsQcqs =
  SliceQcqs[l].Over[(T.space A).lattice,(T.space A).structure,AC.extent].qcqs AffineQcqs[l].TestSpace[A].qcqs ;
 equivalence : TE.NaturalEquivalence SF.Geometric[space].functor UO.functor =
  TE.Composite[GR.G.functor,GR.R.functor,UO.functor,GR.equivalence,V.inverse-equiv].equivalence ;
 trace (B : T.Test) (p : SF.Geometric[space].functor.obj B) : Id (AF.G.functor.obj B)
  (AF.N.at (TE.forward AF.equivalence) B (UO.point {B} (SF.Transform[SF.Geometric[space].functor,UO.functor].at (TE.forward equivalence) B p)))
  (SF.Transform[GR.G.functor,AF.G.functor].at GR.inclusion B p) =
  trans (sym (R.forward-point B (SF.Transform[GR.R.functor,UO.functor].at V.inverse B
    (SF.Transform[GR.G.functor,GR.R.functor].at (TE.forward GR.equivalence) B p))))
   (ap (GR.R.point {B}) (V.right-at B (SF.Transform[GR.G.functor,GR.R.functor].at (TE.forward GR.equivalence) B p))) ;
 opaque equivalence ;
} ;
