-- The symmetric monoidal structure of the tensor product on
-- QCoh(Spec A), by transport (PLAN-QCOH-UA.md, step 6, structure).
--
-- Mod(A) is symmetric monoidal under (x) (SerreTensorMonoidal,
-- SerreTensorSymmetric); Monoidal and Symmetric are families over
-- univalent categories (MonoidalCategory), and SerreQCohEquivalence
-- .equality identifies Mod(A) with QCoh(Spec A); one subst along it
-- carries the structure, data and laws together.  No tensor product of
-- sheaves (no sheafification) is constructed: the transported tensor is
-- the one of modules seen through the identification.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module MCat = MonoidalCategory[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module QE = SerreQCohEquivalence[l].Over[A,setA] ;
 qcoh-monoidal : MCat.Monoidal[QE.QCoh.category] =
  MCat.transport QE.Modules.category QE.QCoh.category QE.equality SerreTensorMonoidal[l].Over[A,setA].monoidal ;
 qcoh-symmetric : MCat.Symmetric[QE.QCoh.category] =
  MCat.transport-symmetric QE.Modules.category QE.QCoh.category QE.equality SerreTensorSymmetric[l].Over[A,setA].symmetric ;
} ;
