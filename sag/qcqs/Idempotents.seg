-- Idempotents and complementary opens (DESIGN.md, Next 4, milestone 2), in
-- any locally ringed lattice (M, G, D).
--
-- A complementary pair of opens: (u, v) with u \/ v = top, u /\ v = bot.
-- Theorem.  e |-> (D(e), D(1 - e)) is a bijection from the idempotents of
--  G(top) onto the complementary pairs.
-- Ring facts.  For e e = e: e (1 - e) = e - e e = 0, e + (1 - e) = 1; an
--  idempotent unit x is 1 (x = x (x y) = (x x) y = x y = 1); x = 0 when
--  x w = 0 with w a unit.  Ring maps preserve 1 - e and idempotents.
-- Forward.  D(e) /\ D(1 - e) = D(e (1 - e)) = D(0) = bot, and
--  top = D(1) = D(e + (1 - e)) <= D(e) \/ D(1 - e).
-- G(w) is trivial for w <= bot: separation for the empty cover of w.
-- Backward.  For (u, v), glue 1 on u with 0 on v (they agree on u /\ v = bot)
--  into e_(u,v); e e = e by separation, since 1 1 = 1 and 0 0 = 0.
-- Lemma (reading).  If s|u = 1 and s|v = 0 then D(s) = u.  With
--  D_w(s|w) = w /\ D(s) (InvOpen.Restrict): u /\ D(s) = D_u(1) = u and
--  v /\ D(s) = D_v(0) = bot, so D(s) = D(s) /\ (u \/ v) = u \/ bot = u.
-- Laws.  D(e_(u,v)) = u by reading; (1 - e)|v = 1 - 0 = 1 and
--  (1 - e)|u = 1 - 1 = 0, so D(1 - e_(u,v)) = v by reading with u, v
--  exchanged.  Conversely, for an idempotent e, e|D(e) is an idempotent unit,
--  hence 1, and e|D(1 - e) = 0 because (1 - e)|D(1 - e) is a unit and
--  e (1 - e) = 0; so e = e_(D(e), D(1 - e)) by separation.
-- A ring isomorphism carries idempotents bijectively (injectivity).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module AF = AffineFinite[l] ;

-- the ring facts
module Laws (A : CRing) {
 open A ; module L = RL[A] ;
 IsIdem (e : R) : U l = Id R (mul e e) e ;
 comp (e : R) : R = add o (neg e) ;
 -- e (1 - e) = 0
 orthogonal (e : R) (h : IsIdem e) : Id R (mul e (comp e)) z = calc R {
  mul e (comp e) =< dist e o (neg e) > add (mul e o) (mul e (neg e))
   =< cong2 R add _ _ _ _ (mulO e) (L.mul-neg e e) > add e (neg (mul e e))
   =< ap (\ t -> add e (neg t)) h > add e (neg e)
   =< addN e > z } ;
 -- e + (1 - e) = 1
 sum-comp (e : R) : Id R (add e (comp e)) o = calc R {
  add e (comp e) =< L.add-swap e o (neg e) > add o (add e (neg e))
   =< ap (add o) (addN e) > add o z
   =< addZ o > o } ;
 comp-one : Id R (comp o) z = addN o ;
 comp-zero : Id R (comp z) o = trans (ap (add o) L.neg-zero) (addZ o) ;
 one-idem : IsIdem o = mulO o ;
 zero-idem : IsIdem z = L.mul-zero z ;
 -- an idempotent unit is 1
 unit-idem (x : R) (u : L.unit x) (h : IsIdem x) : Id R x o = calc R {
  x =< sym (mulO x) > mul x o
   =< ap (mul x) (sym u.2) > mul x (mul x u.1)
   =< mulA x x u.1 > mul (mul x x) u.1
   =< ap (\ t -> mul t u.1) h > mul x u.1
   =< u.2 > o } ;
 -- x = 0 when x w = 0 and w is a unit
 zero-of-unit (x w : R) (u : L.unit w) (h : Id R (mul x w) z) : Id R x z =
  L.unit-reg w x u (trans (mulC w x) h) ;
} ;

-- the idempotents of a ring, a subset
module Idems (A : CRing) (setA : Pr.isSet A.R) {
 module LA = Laws[A] ;
 Idem : U l = (e : A.R) * LA.IsIdem e ;
 idem-prop (e : A.R) : Pr.isProp (LA.IsIdem e) = setA (A.mul e e) e ;
 idem-ext (p q : Idem) (h : Id A.R p.1 q.1) : Id Idem p q =
  Pr.Sigma-eq A.R LA.IsIdem p.1 q.1 p.2 q.2 h (idem-prop q.1) ;
} ;

-- ring maps preserve 1 - e and idempotents
module Map (A B : CRing) (phi : RH.Hom A B) {
 module LA = Laws[A] ; module LB = Laws[B] ;
 comp-map (e : A.R) : Id B.R (map phi (LA.comp e)) (LB.comp (map phi e)) =
  trans (map-add phi A.o (A.neg e)) (cong2 B.R B.add _ _ _ _ (map-one phi) (map-neg phi e)) ;
 idem-map (e : A.R) (h : LA.IsIdem e) : LB.IsIdem (map phi e) =
  trans (sym (map-mul phi e e)) (ap (map phi) h) ;
} ;

-- a ring isomorphism carries the idempotents bijectively: if phi(x) is
-- idempotent so is x, by injectivity
module Transfer (A B : CRing) (setA : Pr.isSet A.R) (setB : Pr.isSet B.R) (phi : RH.Hom A B)
 (iso : Pr.isEquiv A.R B.R (map phi)) {
 module IA = Idems[A,setA] ; module IB = Idems[B,setB] ;
 forth (p : IA.Idem) : IB.Idem = (map phi p.1,Map[A,B,phi].idem-map p.1 p.2) ;
 back-idem (q : IB.Idem) : Laws[A].IsIdem (iso.sec q.1) =
  Iso[l].injective A.R B.R (map phi) iso (A.mul (iso.sec q.1) (iso.sec q.1)) (iso.sec q.1) (calc B.R {
   map phi (A.mul (iso.sec q.1) (iso.sec q.1)) =< map-mul phi (iso.sec q.1) (iso.sec q.1)
    > B.mul (map phi (iso.sec q.1)) (map phi (iso.sec q.1))
    =< cong2 B.R B.mul _ _ _ _ (iso.sec-eq q.1) (iso.sec-eq q.1) > B.mul q.1 q.1
    =< q.2 > q.1
    =< sym (iso.sec-eq q.1) > map phi (iso.sec q.1) }) ;
 back (q : IB.Idem) : IA.Idem = (iso.sec q.1,back-idem q) ;
 equivalence : Pr.isEquiv IA.Idem IB.Idem forth =
  Pr.qinv IA.Idem IB.Idem forth back (\ q -> IB.idem-ext (forth (back q)) q (iso.sec-eq q.1))
   (\ p -> IA.idem-ext (back (forth p)) p (Pr.sec-ret A.R B.R (map phi) iso p.1)) ;
} ;

module On (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 module O = DL.Order[M] ;
 module RG = RingedLattice[l].On[M] ;
 module GO = RG.Of[X.sheaf] ;
 module GS = RG.Sheaf[X.sheaf,X.is-sheaf] ;
 module IO = InvOpen[l].On[M].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[M].Laws[X.sheaf,X.inv] ;
 module LT = Laws[X.sheaf.ring M.top] ;
 module IT = Idems[X.sheaf.ring M.top,X.sheaf.ring-set M.top] ;

 -- the support laws, named once
 d-one (u : M.L) : Id M.L (LX.d u (X.sheaf.ring u).o) u = X.is-support.1 u ;
 d-zero (u : M.L) : Id M.L (LX.d u (X.sheaf.ring u).z) M.bot = X.is-support.2.1 u ;
 d-mul (u : M.L) (s t : (X.sheaf.ring u).R) :
  Id M.L (LX.d u ((X.sheaf.ring u).mul s t)) (M.meet (LX.d u s) (LX.d u t)) = X.is-support.2.2.1 u s t ;
 d-add (u : M.L) (s t : (X.sheaf.ring u).R) :
  O.Le (LX.d u ((X.sheaf.ring u).add s t)) (M.join (LX.d u s) (LX.d u t)) = X.is-support.2.2.2 u s t ;
 -- D_w(s|w) = w /\ D_u(s)
 d-restrict (u w : M.L) (k : O.Le w u) (s : (X.sheaf.ring u).R) :
  Id M.L (LX.d w (GO.restrict w u k s)) (M.meet w (LX.d u s)) =
  IO.Restrict[u,w,k,s,LX.d u s,LX.d-open u s].restrict-eq (LX.d w (GO.restrict w u k s)) (LX.d-open w (GO.restrict w u k s)) ;

 module C = DL.Complements[M] ;

 -- forward
 forth-join (e : (X.sheaf.ring M.top).R) :
  Id M.L (M.join (LX.d M.top e) (LX.d M.top (LT.comp e))) M.top =
  O.le-antisym (M.join (LX.d M.top e) (LX.d M.top (LT.comp e))) M.top
   (O.le-top (M.join (LX.d M.top e) (LX.d M.top (LT.comp e))))
   (O.le-trans M.top (LX.d M.top ((X.sheaf.ring M.top).add e (LT.comp e))) (M.join (LX.d M.top e) (LX.d M.top (LT.comp e)))
    (O.le-of-eq M.top (LX.d M.top ((X.sheaf.ring M.top).add e (LT.comp e)))
     (trans (sym (d-one M.top)) (ap (LX.d M.top) (sym (LT.sum-comp e)))))
    (d-add M.top e (LT.comp e))) ;
 forth-meet (e : (X.sheaf.ring M.top).R) (h : LT.IsIdem e) :
  Id M.L (M.meet (LX.d M.top e) (LX.d M.top (LT.comp e))) M.bot = calc M.L {
  M.meet (LX.d M.top e) (LX.d M.top (LT.comp e)) =< sym (d-mul M.top e (LT.comp e))
   > LX.d M.top ((X.sheaf.ring M.top).mul e (LT.comp e))
   =< ap (LX.d M.top) (LT.orthogonal e h) > LX.d M.top (X.sheaf.ring M.top).z
   =< d-zero M.top > M.bot } ;
 forth (p : IT.Idem) : C.Pairs =
  ((LX.d M.top p.1,LX.d M.top (LT.comp p.1)),forth-join p.1,forth-meet p.1 p.2) ;

 -- G(w) is trivial for w <= bot
 trivial (w : M.L) (k : O.Le w M.bot) (x x2 : (X.sheaf.ring w).R) : Id (X.sheaf.ring w).R x x2 =
  GS.Cover[w,zero,AF.empty-section (\ i -> M.L),AF.empty-section (\ i -> O.Le (AF.empty-section (\ j -> M.L) i) w),k].separated x x2
   (AF.empty-section (\ i -> Id (X.sheaf.ring (AF.empty-section (\ j -> M.L) i)).R
     (GS.Cover[w,zero,AF.empty-section (\ j -> M.L),AF.empty-section (\ j -> O.Le (AF.empty-section (\ j2 -> M.L) j) w),k].C.restrictions x i)
     (GS.Cover[w,zero,AF.empty-section (\ j -> M.L),AF.empty-section (\ j -> O.Le (AF.empty-section (\ j2 -> M.L) j) w),k].C.restrictions x2 i))) ;

 -- reading: s|u = 1 and s|v = 0 give D(s) = u
 module Reading (u v : M.L) (c : C.Complementary (u,v)) (s : (X.sheaf.ring M.top).R)
  (on-u : Id (X.sheaf.ring u).R (GO.restrict u M.top (O.le-top u) s) (X.sheaf.ring u).o)
  (on-v : Id (X.sheaf.ring v).R (GO.restrict v M.top (O.le-top v) s) (X.sheaf.ring v).z) {
  at-u : Id M.L (M.meet u (LX.d M.top s)) u = calc M.L {
   M.meet u (LX.d M.top s) =< sym (d-restrict M.top u (O.le-top u) s) > LX.d u (GO.restrict u M.top (O.le-top u) s)
    =< ap (LX.d u) on-u > LX.d u (X.sheaf.ring u).o
    =< d-one u > u } ;
  at-v : Id M.L (M.meet v (LX.d M.top s)) M.bot = calc M.L {
   M.meet v (LX.d M.top s) =< sym (d-restrict M.top v (O.le-top v) s) > LX.d v (GO.restrict v M.top (O.le-top v) s)
    =< ap (LX.d v) on-v > LX.d v (X.sheaf.ring v).z
    =< d-zero v > M.bot } ;
  reading : Id M.L (LX.d M.top s) u = calc M.L {
   LX.d M.top s =< sym (M.meetT (LX.d M.top s)) > M.meet (LX.d M.top s) M.top
    =< ap (M.meet (LX.d M.top s)) (sym c.1) > M.meet (LX.d M.top s) (M.join u v)
    =< M.dist (LX.d M.top s) u v > M.join (M.meet (LX.d M.top s) u) (M.meet (LX.d M.top s) v)
    =< cong2 M.L M.join _ _ _ _ (trans (M.meetC (LX.d M.top s) u) at-u) (trans (M.meetC (LX.d M.top s) v) at-v)
    > M.join u M.bot
    =< M.joinB u > u } ;
 } ;

 -- backward: glue 1 on u with 0 on v
 module Back (c : C.Pairs) {
  module T = GS.Two[M.top,c.1.1,c.1.2,O.le-top c.1.1,O.le-top c.1.2,O.le-of-eq M.top (M.join c.1.1 c.1.2) (sym c.2.1)] ;
  agree : T.Agree (X.sheaf.ring c.1.1).o (X.sheaf.ring c.1.2).z =
   trivial (M.meet c.1.1 c.1.2) (O.le-of-eq (M.meet c.1.1 c.1.2) M.bot c.2.2) _ _ ;
  e : (X.sheaf.ring M.top).R = T.glue (X.sheaf.ring c.1.1).o (X.sheaf.ring c.1.2).z agree ;
  on-u : Id (X.sheaf.ring c.1.1).R (GO.restrict c.1.1 M.top (O.le-top c.1.1) e) (X.sheaf.ring c.1.1).o =
   T.matches0 (X.sheaf.ring c.1.1).o (X.sheaf.ring c.1.2).z agree ;
  on-v : Id (X.sheaf.ring c.1.2).R (GO.restrict c.1.2 M.top (O.le-top c.1.2) e) (X.sheaf.ring c.1.2).z =
   T.matches1 (X.sheaf.ring c.1.1).o (X.sheaf.ring c.1.2).z agree ;
  -- e e = e
  square-on (w : M.L) (x : (X.sheaf.ring w).R) (sq : Laws[X.sheaf.ring w].IsIdem x)
   (r : Id (X.sheaf.ring w).R (GO.restrict w M.top (O.le-top w) e) x) :
   Id (X.sheaf.ring w).R (GO.restrict w M.top (O.le-top w) ((X.sheaf.ring M.top).mul e e)) (GO.restrict w M.top (O.le-top w) e) =
   calc (X.sheaf.ring w).R {
    GO.restrict w M.top (O.le-top w) ((X.sheaf.ring M.top).mul e e) =< map-mul (X.sheaf.res w M.top (O.le-top w)) e e
     > (X.sheaf.ring w).mul (GO.restrict w M.top (O.le-top w) e) (GO.restrict w M.top (O.le-top w) e)
     =< cong2 (X.sheaf.ring w).R (X.sheaf.ring w).mul _ _ _ _ r r > (X.sheaf.ring w).mul x x
     =< sq > x
     =< sym r > GO.restrict w M.top (O.le-top w) e } ;
  idem : LT.IsIdem e =
   T.separated ((X.sheaf.ring M.top).mul e e) e
    (square-on c.1.1 (X.sheaf.ring c.1.1).o (Laws[X.sheaf.ring c.1.1].one-idem) on-u)
    (square-on c.1.2 (X.sheaf.ring c.1.2).z (Laws[X.sheaf.ring c.1.2].zero-idem) on-v) ;
  idempotent : IT.Idem = (e,idem) ;
  -- 1 - e is 0 on u and 1 on v
  comp-on (w : M.L) :
   Id (X.sheaf.ring w).R (GO.restrict w M.top (O.le-top w) (LT.comp e)) (Laws[X.sheaf.ring w].comp (GO.restrict w M.top (O.le-top w) e)) =
   Map[X.sheaf.ring M.top,X.sheaf.ring w,X.sheaf.res w M.top (O.le-top w)].comp-map e ;
  comp-u : Id (X.sheaf.ring c.1.1).R (GO.restrict c.1.1 M.top (O.le-top c.1.1) (LT.comp e)) (X.sheaf.ring c.1.1).z =
   trans (comp-on c.1.1) (trans (ap (Laws[X.sheaf.ring c.1.1].comp) on-u) (Laws[X.sheaf.ring c.1.1].comp-one)) ;
  comp-v : Id (X.sheaf.ring c.1.2).R (GO.restrict c.1.2 M.top (O.le-top c.1.2) (LT.comp e)) (X.sheaf.ring c.1.2).o =
   trans (comp-on c.1.2) (trans (ap (Laws[X.sheaf.ring c.1.2].comp) on-v) (Laws[X.sheaf.ring c.1.2].comp-zero)) ;
  d-e : Id M.L (LX.d M.top e) c.1.1 = Reading[c.1.1,c.1.2,c.2,e,on-u,on-v].reading ;
  d-comp : Id M.L (LX.d M.top (LT.comp e)) c.1.2 =
   Reading[c.1.2,c.1.1,C.exchange c.1.1 c.1.2 c.2,LT.comp e,comp-v,comp-u].reading ;
 } ;
 back (c : C.Pairs) : IT.Idem = Back[c].idempotent ;

 -- the pair of the idempotent of c is c
 forth-back (c : C.Pairs) : Id C.Pairs (forth (back c)) c = C.pair-ext (forth (back c)) c Back[c].d-e Back[c].d-comp ;

 -- the idempotent of the pair of e is e
 module BackForth (p : IT.Idem) {
  -- s|D(s) is a unit
  unit-on (s : (X.sheaf.ring M.top).R) :
   IO.Unit (LX.d M.top s) (GO.restrict (LX.d M.top s) M.top (O.le-top (LX.d M.top s)) s) =
   Pr.subst (X.sheaf.ring (LX.d M.top s)).R (IO.Unit (LX.d M.top s)) _ _
    (GO.res-irr (LX.d M.top s) M.top (IO.below (LX.d-open M.top s)) (O.le-top (LX.d M.top s)) s)
    (IO.unit-on (LX.d-open M.top s)) ;
  -- e|D(e) = 1
  on-u : Id (X.sheaf.ring (LX.d M.top p.1)).R (GO.restrict (LX.d M.top p.1) M.top (O.le-top (LX.d M.top p.1)) p.1)
   (X.sheaf.ring (LX.d M.top p.1)).o =
   Laws[X.sheaf.ring (LX.d M.top p.1)].unit-idem (GO.restrict (LX.d M.top p.1) M.top (O.le-top (LX.d M.top p.1)) p.1)
    (unit-on p.1)
    (Map[X.sheaf.ring M.top,X.sheaf.ring (LX.d M.top p.1),X.sheaf.res (LX.d M.top p.1) M.top (O.le-top (LX.d M.top p.1))].idem-map p.1 p.2) ;
  -- e|D(1 - e) = 0
  product-v : Id (X.sheaf.ring (LX.d M.top (LT.comp p.1))).R
   ((X.sheaf.ring (LX.d M.top (LT.comp p.1))).mul
     (GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) p.1)
     (GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) (LT.comp p.1)))
   (X.sheaf.ring (LX.d M.top (LT.comp p.1))).z = calc (X.sheaf.ring (LX.d M.top (LT.comp p.1))).R {
   (X.sheaf.ring (LX.d M.top (LT.comp p.1))).mul
     (GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) p.1)
     (GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) (LT.comp p.1))
    =< sym (map-mul (X.sheaf.res (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1)))) p.1 (LT.comp p.1))
    > GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) ((X.sheaf.ring M.top).mul p.1 (LT.comp p.1))
    =< ap (GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1)))) (LT.orthogonal p.1 p.2)
    > GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) (X.sheaf.ring M.top).z
    =< map-zero (X.sheaf.res (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))))
    > (X.sheaf.ring (LX.d M.top (LT.comp p.1))).z } ;
  on-v : Id (X.sheaf.ring (LX.d M.top (LT.comp p.1))).R
   (GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) p.1)
   (X.sheaf.ring (LX.d M.top (LT.comp p.1))).z =
   Laws[X.sheaf.ring (LX.d M.top (LT.comp p.1))].zero-of-unit
    (GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) p.1)
    (GO.restrict (LX.d M.top (LT.comp p.1)) M.top (O.le-top (LX.d M.top (LT.comp p.1))) (LT.comp p.1))
    (unit-on (LT.comp p.1)) product-v ;
  eq : Id (X.sheaf.ring M.top).R (back (forth p)).1 p.1 =
   Back[forth p].T.separated (back (forth p)).1 p.1 (trans Back[forth p].on-u (sym on-u)) (trans Back[forth p].on-v (sym on-v)) ;
 } ;
 back-forth (p : IT.Idem) : Id IT.Idem (back (forth p)) p = IT.idem-ext (back (forth p)) p BackForth[p].eq ;

 -- idempotents of G(top) are complementary pairs of opens
 equivalence : Pr.isEquiv IT.Idem C.Pairs forth = Pr.qinv IT.Idem C.Pairs forth back forth-back back-forth ;
} ;
