-- The canonical localisation map of a support ideal (Serre note,
-- Section 7, Lemma lem:J-qc as revised).
-- Lemma.  For any open a and g in O(a), lambda^(J_U)_(a,g) is an
--  equivalence whenever lambda^O_(a,g) is.
-- Proof.  J_U is a submodule sheaf of O (SerreSupportIdeal.inclusion), so
--  by the saturation lemma it suffices that J_U is saturated at (a, g),
--  with e = 1: let x in O(a) with x|a_g in J_U(a_g), a_g = D_a(g).  Then
--   D_a(g x) = D_a(g) /\ D_a(x) = D_(a_g)(x|a_g) <= U
--  (product law, restriction law), so g x is in J_U(a).
-- On an affine w, lambda^O_(w,s) is an equivalence (SerreLambdaChart), so
-- the lambda hypothesis of the lambda-criterion holds for J_U on w.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (V : L.L)
 (a : L.L) (g : (X.sheaf.ring a).R) {
 module O = DL.Order[L] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module Str = SerreModuleSheafStructure[l].On[L,X.sheaf,X.is-sheaf] ;
 module SI = SerreSupportIdeal[l].On[L,X,V] ;
 module Sat = SerreSupportIdealSaturation[l].On[L,X,SI.ideal,Str.structure,SI.inclusion,SI.inclusion-injective,a,g] ;
 module Saturating (x : (X.sheaf.ring a).R) (y : SI.At[Sat.ag].Carrier)
  (e : Id (X.sheaf.ring Sat.ag).R (Sat.I.at SI.inclusion Sat.ag y) (Sat.EO.restrict Sat.ag a Sat.below x)) {
  -- D_a(g x) = D_(a_g)(x|a_g)
  support : Id L.L (LX.d a ((X.sheaf.ring a).mul g x)) (LX.d Sat.ag (Sat.EO.restrict Sat.ag a Sat.below x)) = calc L.L {
   LX.d a ((X.sheaf.ring a).mul g x)
    =< LX.mul-law a g x > L.meet (LX.d a g) (LX.d a x)
    =< sym (SI.Sp.restrict-support a Sat.ag Sat.below x) > LX.d Sat.ag (Sat.EO.restrict Sat.ag a Sat.below x) } ;
  member : SI.Member a ((X.sheaf.ring a).mul g x) =
   Pr.subst L.L (\ t -> O.Le t V) _ _ (sym support)
    (Pr.subst (X.sheaf.ring Sat.ag).R (SI.Member Sat.ag) _ _ (trans (sym (SI.inclusion-at Sat.ag y)) e) (SI.At[Sat.ag].member y)) ;
  multiple : SI.At[a].Carrier = ((X.sheaf.ring a).mul g x,member) ;
  multiple-eq : Id (X.sheaf.ring a).R (Sat.I.at SI.inclusion a multiple)
   ((Str.presheaf.module-at a).sm (Sat.AP.power g (suc zero)) x) = calc (X.sheaf.ring a).R {
   Sat.I.at SI.inclusion a multiple
    =< SI.inclusion-at a multiple > (X.sheaf.ring a).mul g x
    =< ap (\ t -> (X.sheaf.ring a).mul t x) (sym ((X.sheaf.ring a).mulO g)) > (X.sheaf.ring a).mul ((X.sheaf.ring a).mul g (X.sheaf.ring a).o) x
    =< sym (Str.scalar-at a ((X.sheaf.ring a).mul g (X.sheaf.ring a).o) x) > (Str.presheaf.module-at a).sm (Sat.AP.power g (suc zero)) x } ;
 } ;
 saturated : Sat.Saturated = \ x y e ->
  Tr.Trunc[(k : Nat) * (z : SI.At[a].Carrier)
   * Id (X.sheaf.ring a).R (Sat.I.at SI.inclusion a z) ((Str.presheaf.module-at a).sm (Sat.AP.power g k) x)].inc
   (suc zero,Saturating[x,y,e].multiple,Saturating[x,y,e].multiple-eq) ;
 equivalence (structure : SerreLambda[l].On[L,X,Str.structure,a].At[g].IsEquivalence) :
  SerreLambda[l].On[L,X,SI.ideal,a].At[g].IsEquivalence =
  Sat.Given[structure,saturated].equivalence ;
} ;
-- the lambda hypothesis of the lambda-criterion for J_U on an affine w
module OnAffine (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (V : L.L)
 (w : L.L) (affine : Qcqs[l].Over[L,X].AffineOpen w) {
 local (s : (X.sheaf.ring w).R) : SerreLambda[l].On[L,X,SerreSupportIdeal[l].On[L,X,V].ideal,w].At[s].IsEquivalence =
  On[L,X,V,w,s].equivalence (SerreLambdaChart[l].On[L,X,w,affine].At[s].equivalence) ;
} ;
