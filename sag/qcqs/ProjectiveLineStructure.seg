-- The structure map P^1_k -> Spec k (DESIGN.md, Next 5, after step 5).
-- k is any commutative ring, Spec k is taken with the fractions of k
-- (Affine), and diagonal : k -> Gamma(P^1), a |-> (a|top, a|top)
-- (ProjectiveLineGlobal).
--
-- The structure map is the map of diagonal (SpecUniversal): local, with
-- global component diagonal.
-- Lemma (charts).  On each chart Spec k[X] ~= P^1|e_i (GlueTransition: the
-- projections, geometrically the embeddings of the charts), the structure
-- map restricts to Spec(k -> k[X]).  Both are local maps from Spec k into
-- Spec k[X] (ringed convention: L_k -> L_k[X]), so by SpecUniversal.unique
-- it is enough that their global components agree at a in k.  The global
-- component of the composite is Gamma(proj) . Gamma(inclusion) .
-- diagonal (SpecHom.Precompose twice); Gamma(inclusion) is restriction from
-- top to e_i (res-comp), and Gamma(proj) takes the first (second)
-- component and restricts it to top; so the value at a is a restriction
-- of a|top to top (GlueAlong.Res.left-res, res-comp, res-id), i.e. a|top,
-- which is the global component of Spec(k -> k[X]) at a.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module PG = ProjectiveLineGlobal[l].Over[k,setk] ;
 module GT = PG.GT ;
 module GA = PG.GA ;
 module PB = PG.PB ;
 module SB = PG.SB ;
 module P = PG.P ;
 module Gb = PG.Gb ;
 module AK = Affine[l].Over[k] ;
 module SK = SpecUniversal[l].Over[k,setk,AK.Loc,AK.set,AK.inclusion,AK.elementary,PB.lattice,GT.glued] ;
 module GO = RingedLattice[l].On[SB.ZA.lattice].Of[SB.SA.spec.sheaf] ;

 -- the structure map, the map of k -> Gamma(P^1)
 structure-ring : RH.Hom k (GT.glued.sheaf.ring PB.lattice.top) = PG.diagonal ;
 module SM = SK.Of[structure-ring] ;
 structure : SK.Mp.Ringed = SM.morphism ;
 structure-local : SK.Mp.Of[structure,SK.SI.inv-map,GT.glued.inv].IsLocal = SM.local ;

 -- Spec(k -> k[X])
 module SI = SpecHom[l].Over[k,setk,AK.Loc,AK.set,AK.inclusion,AK.elementary,
  P.ring,P.set,SB.SA.Loc,SB.SA.set,SB.SA.inclusion,SB.SA.elementary,P.inclusion] ;
 si-component (a : k.R) :
  Id (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R (map (SI.Into.component SI.morphism) a) (map Gb.global (P.constant a)) =
  trans (SI.Into.Of[SI.phi].component-of a) (SI.phi-map a) ;

 -- the first chart
 module First {
  module S1 = GT.First.S1 ;
  module P1 = SpecHom[l].Precompose[k,setk,AK.Loc,AK.set,AK.inclusion,AK.elementary,
   PB.lattice,GT.glued,S1.lattice,S1.restricted,S1.inclusion,structure] ;
  module P2 = SpecHom[l].Precompose[k,setk,AK.Loc,AK.set,AK.inclusion,AK.elementary,
   S1.lattice,S1.restricted,SB.ZA.lattice,SB.SA.spec,GT.First.proj,P1.C.composite] ;
  -- Gamma(inclusion) is restriction from top to e1
  gamma-inclusion (z : (GT.glued.sheaf.ring PB.lattice.top).R) :
   Id (S1.restricted.sheaf.ring S1.lattice.top).R (map P1.gamma z) (GA.G2.restrict GT.e1 PB.lattice.top (PB.OP.le-top GT.e1) z) =
   GT.glued.sheaf.res-comp GT.e1 (PB.lattice.meet PB.lattice.top GT.e1) PB.lattice.top
    (S1.le-inc S1.lattice.top (DL.hmap S1.inclusion.lat PB.lattice.top) P1.top-le) (S1.O.meet-left PB.lattice.top GT.e1)
    (PB.OP.le-top GT.e1) z ;
  value (a : k.R) :
   Id (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R (map (P2.UA2.component P2.C.composite) a) (map Gb.global (P.constant a)) =
   calc (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R {
    map (P2.UA2.component P2.C.composite) a =< P2.component a > map P2.gamma (map (P2.UA.component P1.C.composite) a)
     =< ap (map P2.gamma) (P1.component a) > map P2.gamma (map P1.gamma (map (P1.UA.component structure) a))
     =< ap (\ t -> map P2.gamma (map P1.gamma t)) (SM.component-of a) > map P2.gamma (map P1.gamma (map structure-ring a))
     =< ap (map P2.gamma) (gamma-inclusion (map structure-ring a))
      > map P2.gamma (GA.G2.restrict GT.e1 PB.lattice.top (PB.OP.le-top GT.e1) (map structure-ring a))
     =< ap (GO.restrict SB.ZA.lattice.top (PB.first GT.e1) P2.top-le)
         (GA.Res[GT.e1,PB.lattice.top,PB.OP.le-top GT.e1].left-res (map structure-ring a))
      > GO.restrict SB.ZA.lattice.top (PB.first GT.e1) P2.top-le
         (GO.restrict (PB.first GT.e1) (PB.first PB.lattice.top) (GA.Res[GT.e1,PB.lattice.top,PB.OP.le-top GT.e1].k1)
           (GA.left PB.lattice.top (map structure-ring a)))
     =< SB.SA.spec.sheaf.res-comp SB.ZA.lattice.top (PB.first GT.e1) (PB.first PB.lattice.top) P2.top-le
         (GA.Res[GT.e1,PB.lattice.top,PB.OP.le-top GT.e1].k1) (SB.ZA.O.le-top SB.ZA.lattice.top)
         (GA.left PB.lattice.top (map structure-ring a))
      > GO.restrict SB.ZA.lattice.top SB.ZA.lattice.top (SB.ZA.O.le-top SB.ZA.lattice.top) (GA.left PB.lattice.top (map structure-ring a))
     =< SB.SA.spec.sheaf.res-id SB.ZA.lattice.top (SB.ZA.O.le-top SB.ZA.lattice.top) (GA.left PB.lattice.top (map structure-ring a))
      > GA.left PB.lattice.top (map structure-ring a)
     =< PG.Dg.left-lift a > map Gb.global (P.constant a) } ;
  local : SI.Into.Mp.Of[P2.C.composite,SI.Into.SI.inv-map,SB.SA.spec.inv].IsLocal =
   P2.C.Local[SK.SI.inv-map,S1.inv,SB.SA.spec.inv,
    P1.C.Local[SK.SI.inv-map,GT.glued.inv,S1.inv,structure-local,S1.inclusion-local].local,
    Iso[l].Maps[S1.lattice,SB.ZA.lattice,S1.sheaf,SB.SA.spec.sheaf].Local[GT.First.proj,GT.First.iso,S1.inv,SB.SA.spec.inv].local].local ;
  -- the structure map on the first chart is Spec(k -> k[X])
  compatible : Id SI.Into.Mp.Ringed P2.C.composite SI.morphism =
   SI.Into.unique P2.C.composite SI.morphism local SI.local (\ a -> trans (value a) (sym (si-component a))) ;
 } ;

 -- the second chart
 module Second {
  module S2 = GT.Second.S2 ;
  module P1 = SpecHom[l].Precompose[k,setk,AK.Loc,AK.set,AK.inclusion,AK.elementary,
   PB.lattice,GT.glued,S2.lattice,S2.restricted,S2.inclusion,structure] ;
  module P2 = SpecHom[l].Precompose[k,setk,AK.Loc,AK.set,AK.inclusion,AK.elementary,
   S2.lattice,S2.restricted,SB.ZA.lattice,SB.SA.spec,GT.Second.proj,P1.C.composite] ;
  gamma-inclusion (z : (GT.glued.sheaf.ring PB.lattice.top).R) :
   Id (S2.restricted.sheaf.ring S2.lattice.top).R (map P1.gamma z) (GA.G2.restrict GT.e2 PB.lattice.top (PB.OP.le-top GT.e2) z) =
   GT.glued.sheaf.res-comp GT.e2 (PB.lattice.meet PB.lattice.top GT.e2) PB.lattice.top
    (S2.le-inc S2.lattice.top (DL.hmap S2.inclusion.lat PB.lattice.top) P1.top-le) (S2.O.meet-left PB.lattice.top GT.e2)
    (PB.OP.le-top GT.e2) z ;
  value (a : k.R) :
   Id (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R (map (P2.UA2.component P2.C.composite) a) (map Gb.global (P.constant a)) =
   calc (SB.SA.spec.sheaf.ring SB.ZA.lattice.top).R {
    map (P2.UA2.component P2.C.composite) a =< P2.component a > map P2.gamma (map (P2.UA.component P1.C.composite) a)
     =< ap (map P2.gamma) (P1.component a) > map P2.gamma (map P1.gamma (map (P1.UA.component structure) a))
     =< ap (\ t -> map P2.gamma (map P1.gamma t)) (SM.component-of a) > map P2.gamma (map P1.gamma (map structure-ring a))
     =< ap (map P2.gamma) (gamma-inclusion (map structure-ring a))
      > map P2.gamma (GA.G2.restrict GT.e2 PB.lattice.top (PB.OP.le-top GT.e2) (map structure-ring a))
     =< ap (GO.restrict SB.ZA.lattice.top (PB.second GT.e2) P2.top-le)
         (GA.Res[GT.e2,PB.lattice.top,PB.OP.le-top GT.e2].right-res (map structure-ring a))
      > GO.restrict SB.ZA.lattice.top (PB.second GT.e2) P2.top-le
         (GO.restrict (PB.second GT.e2) (PB.second PB.lattice.top) (GA.Res[GT.e2,PB.lattice.top,PB.OP.le-top GT.e2].k2)
           (GA.right PB.lattice.top (map structure-ring a)))
     =< SB.SA.spec.sheaf.res-comp SB.ZA.lattice.top (PB.second GT.e2) (PB.second PB.lattice.top) P2.top-le
         (GA.Res[GT.e2,PB.lattice.top,PB.OP.le-top GT.e2].k2) (SB.ZA.O.le-top SB.ZA.lattice.top)
         (GA.right PB.lattice.top (map structure-ring a))
      > GO.restrict SB.ZA.lattice.top SB.ZA.lattice.top (SB.ZA.O.le-top SB.ZA.lattice.top) (GA.right PB.lattice.top (map structure-ring a))
     =< SB.SA.spec.sheaf.res-id SB.ZA.lattice.top (SB.ZA.O.le-top SB.ZA.lattice.top) (GA.right PB.lattice.top (map structure-ring a))
      > GA.right PB.lattice.top (map structure-ring a)
     =< PG.Dg.right-lift a > map Gb.global (P.constant a) } ;
  local : SI.Into.Mp.Of[P2.C.composite,SI.Into.SI.inv-map,SB.SA.spec.inv].IsLocal =
   P2.C.Local[SK.SI.inv-map,S2.inv,SB.SA.spec.inv,
    P1.C.Local[SK.SI.inv-map,GT.glued.inv,S2.inv,structure-local,S2.inclusion-local].local,
    Iso[l].Maps[S2.lattice,SB.ZA.lattice,S2.sheaf,SB.SA.spec.sheaf].Local[GT.Second.proj,GT.Second.iso,S2.inv,SB.SA.spec.inv].local].local ;
  -- the structure map on the second chart is Spec(k -> k[X])
  compatible : Id SI.Into.Mp.Ringed P2.C.composite SI.morphism =
   SI.Into.unique P2.C.composite SI.morphism local SI.local (\ a -> trans (value a) (sym (si-component a))) ;
 } ;
} ;
