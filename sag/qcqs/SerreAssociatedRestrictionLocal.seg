-- Native comparisons on the image-A principal basis of Spec(A_g).
-- The iterated localisation comparison identifies (M_g)_(incl a) with
-- M_(a*g). Its value on original M_g is the actual restriction.
-- Restriction between two original basic modules is A_g-linear after
-- restriction of scalars: the scalar equation is the existing ring-rho
-- composition law. The comparison squares then commute by uniqueness
-- out of the localisation, checked on original M_g numerators.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ; module DL = DistLattice[l] ;
module UP = SerreModuleLocalisationUniversal[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) (g : A.R) {
 module R = SerreModuleBasicRestrictions[l].Over[A,setA,Md] ;
 module SR = SerreModuleBasicRestrictionsScalar[l].Over[A,setA,Md] ;
 module Iterated = SerreModuleBasicRestrictionsIterated[l].Over[A,setA,Md] ;
 module AF = R.AF ; module Z = R.Z ; module O = Z.O ;
 module SP = Z.Sup.Of[Z.D,Z.support] ;
 module B = Affine[l].Over[AF.Loc g] ; module ZB = ZariskiLattice[l].Over[AF.Loc g] ;
 module Mg = R.Local[g].Scalars ;
 module BR = SerreModuleBasicRestrictions[l].Over[AF.Loc g,AF.set g,Mg.localised] ;
 coefficient (a : A.R) : (AF.Loc g).R = RM.map (AF.inclusion g) a ;
 module Basic (a : A.R) {
  module I = Iterated.At[g,a] ;
  module Native = I.Comparison.E ;
  native-map : Native.To.Hom = Native.lift ;
  map (x : I.SourcePower.Carrier) : I.Target.restricted.M = Native.To.map native-map x ;
  comparison-at (x : I.SourcePower.Carrier) : Id I.Target.restricted.M (map x) (I.Comparison.forward x) = I.Comparison.linear-map-at x ;
  on-original (x : Mg.localised.M) :
   Id I.Target.restricted.M (map (I.SourcePower.fraction x zero)) (I.P.map x) =
   trans (comparison-at (I.SourcePower.fraction x zero)) (I.canonical-equation x) ;
  equivalence : Pr.isEquiv I.SourcePower.Carrier I.Target.restricted.M map =
   Iso[l].equiv-homotopy I.SourcePower.Carrier I.Target.restricted.M I.Comparison.forward map
    (\ x -> sym (comparison-at x)) I.Comparison.equivalence ;
  opaque native-map ;
 } ;
 module Along (s t : A.R) (sg : O.Le (Z.D s) (Z.D g)) (tg : O.Le (Z.D t) (Z.D g))
  (ts : O.Le (Z.D t) (Z.D s)) {
  module P = R.At[s,t,ts] ;
  module SS = MM.RestrictScalars[AF.Loc g,AF.Loc s,R.R.rho g s sg].Of[R.Local[s].Scalars.localised] ;
  module TS = MM.RestrictScalars[AF.Loc g,AF.Loc t,R.R.rho g t tg].Of[R.Local[t].Scalars.localised] ;
  module Maps = MM.Between[AF.Loc g,AF.Loc g,RH.identity (AF.Loc g),SS.restricted,TS.restricted] ;
  scalar (r : (AF.Loc g).R) (x : SS.restricted.M) :
   Id TS.restricted.M (P.map (SS.restricted.sm r x)) (TS.restricted.sm r (P.map x)) =
   trans (ap P.map (SS.scalar-at r x))
    (trans (SR.At[s,t,ts].scale (RM.map (R.R.rho g s sg) r) x)
     (trans (ap (\ a -> R.Local[t].Scalars.localised.sm a (P.map x)) (R.R.rho-comp-at g s t sg ts tg r))
      (sym (TS.scalar-at r (P.map x))))) ;
  restriction : Maps.Hom = new Maps.Hom[P.map,P.map-add,scalar] ;
  restriction-at (x : SS.restricted.M) : Id TS.restricted.M (Maps.map restriction x) (P.map x) = refl (P.map x) ;
  opaque restriction ;
 } ;
 module Square (a b : A.R) (le : ZB.O.Le (ZB.D (coefficient b)) (ZB.D (coefficient a)))
  (below : O.Le (Z.D (A.mul b g)) (Z.D (A.mul a g))) {
  module S = Basic[a] ; module T = Basic[b] ;
  module Original = Along[A.mul a g,A.mul b g,S.I.OL.below,T.I.OL.below,below] ;
  module Source = BR.At[coefficient a,coefficient b,le] ;
  module Maps = MM.Between[AF.Loc g,AF.Loc g,RH.identity (AF.Loc g),S.Native.Source.localised,T.I.Target.restricted] ;
  module Common = MM.Between[AF.Loc g,AF.Loc g,RH.identity (AF.Loc g),Mg.localised,T.I.Target.restricted] ;
  base : Common.Hom = T.I.restriction ;
  a-below : O.Le (Z.D (A.mul b g)) (Z.D a) =
   O.le-trans (Z.D (A.mul b g)) (Z.D (A.mul a g)) (Z.D a) below (SP.scaled a g) ;
  module Inv = R.At[a,A.mul b g,a-below] ;
  invertible : Pr.isEquiv T.I.Target.restricted.M T.I.Target.restricted.M (T.I.Target.restricted.sm (coefficient a)) =
   Iso[l].equiv-homotopy T.I.Target.restricted.M T.I.Target.restricted.M
    (R.Local[A.mul b g].Native.localised.sm a) (T.I.Target.restricted.sm (coefficient a))
    (\ x -> sym (T.I.target-action a x)) Inv.invertible ;
  module ExtensionProof = UP.Extend[AF.Loc g,Mg.localised,T.I.Target.restricted,coefficient a,base,invertible] ;
  left : Maps.Hom = new Maps.Hom[
   \ x -> Original.Maps.map Original.restriction (S.map x),
   \ x y -> trans (ap (Original.Maps.map Original.restriction) (S.Native.To.map-add S.native-map x y))
    (Original.Maps.map-add Original.restriction (S.map x) (S.map y)),
   \ r x -> trans (ap (Original.Maps.map Original.restriction) (S.Native.To.map-scale S.native-map r x))
    (Original.Maps.map-scale Original.restriction r (S.map x))] ;
  right : Maps.Hom = new Maps.Hom[\ x -> T.map (Source.map x),
   \ x y -> trans (ap T.map (Source.map-add x y)) (T.Native.To.map-add T.native-map (Source.map x) (Source.map y)),
   \ r x -> trans (ap T.map (Source.map-scale r x)) (T.Native.To.map-scale T.native-map r (Source.map x))] ;
  left-original (x : Mg.localised.M) : Id T.I.Target.restricted.M
   (Maps.map left (S.I.SourcePower.fraction x zero)) (Common.map base x) =
   trans (ap (Original.Maps.map Original.restriction) (S.on-original x))
    (trans (Original.restriction-at (S.I.P.map x))
     (trans (R.rho-comp g (A.mul a g) (A.mul b g) S.I.OL.below below T.I.OL.below x)
      (sym (T.I.restriction-at x)))) ;
  right-original (x : Mg.localised.M) : Id T.I.Target.restricted.M
   (Maps.map right (S.I.SourcePower.fraction x zero)) (Common.map base x) =
   trans (ap T.map (Source.on-original x)) (trans (T.on-original x) (sym (T.I.restriction-at x))) ;
  equation (x : S.I.SourcePower.Carrier) : Id T.I.Target.restricted.M
   (Original.P.map (S.map x)) (T.map (Source.map x)) =
   trans (sym (Original.restriction-at (S.map x)))
    (trans (ExtensionProof.Other[left,left-original].unique x) (sym (ExtensionProof.Other[right,right-original].unique x))) ;
  opaque base ; opaque left ; opaque right ; opaque invertible ;
 } ;
} ;
