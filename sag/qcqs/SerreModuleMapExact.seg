-- Injectivity and equivalence of module maps from kernel and image data.
-- An additive map takes x-y to q(x)-q(y); if only zero maps to zero,
-- equal images therefore imply x=y. Fibres of an injective map into a
-- set are propositions, so mere surjectivity gives a unique inverse.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (B C : SM.Over[A].Module)
 (q : MM.Between[A,A,RingHom[l].identity A,B,C].Hom) {
 module H = MM.Between[A,A,RingHom[l].identity A,B,C] ;
 module BL = SM.Over[A].Laws[B] ; module CL = SM.Over[A].Laws[C] ;
 map-sub (x y : B.M) : Id C.M (H.map q (BL.sub x y)) (CL.sub (H.map q x) (H.map q y)) =
  trans (ap (H.map q) (BL.sub-at x y))
   (trans (H.map-add q x (B.mneg y))
    (trans (ap (C.madd (H.map q x)) (H.map-neg q y)) (sym (CL.sub-at (H.map q x) (H.map q y))))) ;
 KernelZero : U l = (x : B.M) -> Id C.M (H.map q x) C.mz -> Id B.M x B.mz ;
 injective (kernel-zero : KernelZero) (x y : B.M) (e : Id C.M (H.map q x) (H.map q y)) : Id B.M x y =
  BL.sub-zero x y (kernel-zero (BL.sub x y)
   (trans (map-sub x y) (trans (ap (\ z -> CL.sub z (H.map q y)) e) (CL.sub-self (H.map q y))))) ;
 Fibre (y : C.M) : U l = (x : B.M) * Id C.M (H.map q x) y ;
 Surjective : U l = (y : C.M) -> Tr.Trunc[Fibre y].carrier ;
 module Equivalence (kernel-zero : KernelZero) (onto : Surjective) {
  fibre-prop (y : C.M) : Pr.isProp (Fibre y) = \ x z ->
   Pr.Sigma-eq B.M (\ x -> Id C.M (H.map q x) y) x.1 z.1 x.2 z.2
    (injective kernel-zero x.1 z.1 (trans x.2 (sym z.2))) (C.setM _ _) ;
  preimage (y : C.M) : Fibre y = Tr.Trunc[Fibre y].induction @l
   (\ t -> Fibre y) (\ t -> fibre-prop y) (\ t -> t) (onto y) ;
  inverse (y : C.M) : B.M = (preimage y).1 ;
  right (y : C.M) : Id C.M (H.map q (inverse y)) y = (preimage y).2 ;
  left (x : B.M) : Id B.M (inverse (H.map q x)) x = injective kernel-zero _ _ (right (H.map q x)) ;
  equivalent : Pr.isEquiv B.M C.M (H.map q) = Pr.qinv B.M C.M (H.map q) inverse right left ;
  opaque inverse ;
 } ;
} ;
