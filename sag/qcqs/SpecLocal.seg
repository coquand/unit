-- Spec A is a locally ringed lattice (DESIGN.md, step 4, stage 3;
-- zeuner1 Example 3.9).  With D_u the invertibility map of SpecInv, only the
-- laws for 0 and + are conditions (LocallyRinged).  Both are inequalities
-- v <= m with v = D_u(..), tested on the basic opens D b <= v (every open
-- is merely their join).
--
-- Zero.  If D b <= D_u(0), then 0 is a unit of O(D b), so f_b(0) = 0 is a
--  unit of R_b, and D b <= D 0 = bot (Bridge).
-- Sum.  Let D b <= D_u(s + t), so s|D b + t|D b is a unit of O(D b), and
--  x + y is a unit of R_b, with x, y the values of s|D b, t|D b.  Take
--  fractions f(p) x = f(a), f(q) y = f(c), p and q powers of b.  Then
--   f(q a + p c) = f(q) f(p) x + f(p) f(q) y = f(p) f(q) (x + y)
--  is a unit, so D b <= D(q a + p c) <= D(q a) \/ D(p c) <= D a \/ D c
--  (Bridge, D a support), and D b <= D(b a) \/ D(b c) (distributivity).
--  Finally D(b a) is the invertibility open of s|D b (SpecInv.Basic), which
--  is D b /\ D_u(s) (InvOpen.Restrict), so D(b a) <= D_u(s); likewise
--  D(b c) <= D_u(t).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ; open Radical[l].Over[A] ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;
 module B = BasicOpen[l].Over[A,Loc,set,f,el] ;
 module Sh = Sheaf[l].Over[A,Loc,set,f,el] ;
 module SI = SpecInv[l].Over[A,Loc,set,f,el] ;
 module Sp = Sup.Of[D,support] ;
 module LR = LocallyRinged[l].On[lattice] ;
 module Lw = LR.Laws[Sh.structure,SI.inv-map] ;
 module IO = SI.IO ;
 module Bs = SI.Bs ;

 -- v <= m, tested on the basic opens below v
 module Test (v m : lattice.L) (test : (b : R) -> O.Le (D b) v -> O.Le (D b) m) {
  at (c : Bs.Covered v) : O.Le v m =
   Pr.subst lattice.L (\ t -> O.Le t m) _ v (sym (Bs.covered-eq c))
    (J.least (Bs.count c) (\ i -> D (Bs.piece c i)) m (\ i -> test (Bs.piece c i) (Bs.piece-le c i))) ;
  le : O.Le v m =
   Tr.Trunc[Bs.Covered v].induction @l (\ c -> O.Le v m) (\ c -> O.le-prop v m) at (SI.basis v) ;
 } ;

 -- D_u(0) = bot
 module Zero (u : lattice.L) {
  zeroS : S.Section u = S.Ops[u].zeroS ;
  v : lattice.L = Lw.d u zeroS ;
  -- by definition, the restriction of 0 has value 0
  eval-zero (b : R) (k : O.Le (D b) u) : Id (Loc b).R (B.At[b].eval (S.restrict (D b) u k zeroS)) (Loc b).z =
   refl (Loc b).z ;
  test (b : R) (k : O.Le (D b) v) : O.Le (D b) lattice.bot =
   Pr.subst lattice.L (\ t -> O.Le (D b) t) _ _ Sp.at-zero
    (Bridge[l].Over[A,b].At[Loc b,set b,f b,el b,z].invertible-le
     (Pr.subst (Loc b).R (RL[Loc b].unit) (B.At[b].eval (S.restrict (D b) u (O.le-trans (D b) v u k (IO.below (Lw.d-open u zeroS))) zeroS))
       (map (f b) z)
       (trans (eval-zero b (O.le-trans (D b) v u k (IO.below (Lw.d-open u zeroS)))) (sym (map-zero (f b))))
       (SI.Units[b].to-loc (S.restrict (D b) u (O.le-trans (D b) v u k (IO.below (Lw.d-open u zeroS))) zeroS)
        (IO.to-unit (Lw.d-open u zeroS) (D b) (O.le-trans (D b) v u k (IO.below (Lw.d-open u zeroS))) k)))) ;
  law : Id lattice.L v lattice.bot = O.le-antisym v lattice.bot Test[v,lattice.bot,test].le (O.bot-le v) ;
 } ;
 zero-law : Lw.ZeroLaw = \ u -> Zero[u].law ;

 -- D_u(s + t) <= D_u(s) \/ D_u(t)
 module Sum (u : lattice.L) (s t : S.Section u) {
  st : S.Section u = S.Ops[u].addS s t ;
  v : lattice.L = Lw.d u st ;
  m : lattice.L = lattice.join (Lw.d u s) (Lw.d u t) ;
  module At (b : R) (k : O.Le (D b) v) {
   module LH = Bridge[l].Over[A,b].LocH ;
   module LB = RL[Loc b] ;
   module UB = AffineRing[l].Laws[Loc b,set b] ;
   kb : O.Le (D b) u = O.le-trans (D b) v u k (IO.below (Lw.d-open u st)) ;
   sb : S.Section (D b) = S.restrict (D b) u kb s ;
   tb : S.Section (D b) = S.restrict (D b) u kb t ;
   x : (Loc b).R = B.At[b].eval sb ;
   y : (Loc b).R = B.At[b].eval tb ;
   -- by definition, the value of (s + t)|D b is x + y
   eval-sum : Id (Loc b).R (B.At[b].eval (S.restrict (D b) u kb st)) ((Loc b).add x y) = refl ((Loc b).add x y) ;
   sum-unit : LB.unit ((Loc b).add x y) =
    Pr.subst (Loc b).R LB.unit _ _ eval-sum
     (SI.Units[b].to-loc (S.restrict (D b) u kb st) (IO.to-unit (Lw.d-open u st) (D b) kb k)) ;
   -- D(b a) <= D_u(s) for a fraction a/p of the value of s|D b
   below-d (w : S.Section u) (p : LH.Fraction (Loc b) (f b) (B.At[b].eval (S.restrict (D b) u kb w))) :
    O.Le (D (mul b (LH.num p))) (Lw.d u w) =
    Pr.subst lattice.L (\ e -> O.Le e (Lw.d u w)) (lattice.meet (D b) (Lw.d u w)) (D (mul b (LH.num p)))
     (trans (sym (IO.Restrict[u,D b,kb,w,Lw.d u w,Lw.d-open u w].restrict-eq (Lw.d (D b) (S.restrict (D b) u kb w))
        (Lw.d-open (D b) (S.restrict (D b) u kb w))))
       (IO.unique (Lw.d-open (D b) (S.restrict (D b) u kb w)) SI.Basic[b,S.restrict (D b) u kb w].At[p].is-open))
     (O.meet-right (D b) (Lw.d u w)) ;
   module Fractions (p : LH.Fraction (Loc b) (f b) x) (q : LH.Fraction (Loc b) (f b) y) {
    fp : (Loc b).R = map (f b) (LH.den p) ;
    fq : (Loc b).R = map (f b) (LH.den q) ;
    -- f(q a + p c) = f(p) f(q) (x + y)
    common : Id (Loc b).R (map (f b) (add (mul (LH.den q) (LH.num p)) (mul (LH.den p) (LH.num q))))
     ((Loc b).mul ((Loc b).mul fp fq) ((Loc b).add x y)) = calc (Loc b).R {
     map (f b) (add (mul (LH.den q) (LH.num p)) (mul (LH.den p) (LH.num q)))
      =< map-add (f b) (mul (LH.den q) (LH.num p)) (mul (LH.den p) (LH.num q))
       > (Loc b).add (map (f b) (mul (LH.den q) (LH.num p))) (map (f b) (mul (LH.den p) (LH.num q)))
      =< cong2 (Loc b).R (Loc b).add _ _ _ _ (map-mul (f b) (LH.den q) (LH.num p)) (map-mul (f b) (LH.den p) (LH.num q))
       > (Loc b).add ((Loc b).mul fq (map (f b) (LH.num p))) ((Loc b).mul fp (map (f b) (LH.num q)))
      =< cong2 (Loc b).R (Loc b).add _ _ _ _ (ap ((Loc b).mul fq) (sym (LH.eqn p))) (ap ((Loc b).mul fp) (sym (LH.eqn q)))
       > (Loc b).add ((Loc b).mul fq ((Loc b).mul fp x)) ((Loc b).mul fp ((Loc b).mul fq y))
      =< cong2 (Loc b).R (Loc b).add _ _ _ _ (trans (LB.mul-swap fq fp x) ((Loc b).mulA fp fq x)) ((Loc b).mulA fp fq y)
       > (Loc b).add ((Loc b).mul ((Loc b).mul fp fq) x) ((Loc b).mul ((Loc b).mul fp fq) y)
      =< sym ((Loc b).dist ((Loc b).mul fp fq) x y) > (Loc b).mul ((Loc b).mul fp fq) ((Loc b).add x y) } ;
    common-unit : LB.unit (map (f b) (add (mul (LH.den q) (LH.num p)) (mul (LH.den p) (LH.num q)))) =
     Pr.subst (Loc b).R LB.unit _ _ (sym common)
      (UB.unit-product ((Loc b).mul fp fq) ((Loc b).add x y)
       (UB.unit-product fp fq (LH.inverts (el b) (LH.den p) (LH.den-in p)) (LH.inverts (el b) (LH.den q) (LH.den-in q)))
       sum-unit) ;
    -- D b <= D a \/ D c
    le-ac : O.Le (D b) (lattice.join (D (LH.num p)) (D (LH.num q))) =
     O.le-trans (D b) (D (add (mul (LH.den q) (LH.num p)) (mul (LH.den p) (LH.num q)))) (lattice.join (D (LH.num p)) (D (LH.num q)))
      (Bridge[l].Over[A,b].At[Loc b,set b,f b,el b,add (mul (LH.den q) (LH.num p)) (mul (LH.den p) (LH.num q))].invertible-le common-unit)
      (O.le-trans (D (add (mul (LH.den q) (LH.num p)) (mul (LH.den p) (LH.num q))))
        (lattice.join (D (mul (LH.den q) (LH.num p))) (D (mul (LH.den p) (LH.num q))))
        (lattice.join (D (LH.num p)) (D (LH.num q)))
        (Sp.at-add (mul (LH.den q) (LH.num p)) (mul (LH.den p) (LH.num q)))
        (O.join-mono (D (mul (LH.den q) (LH.num p))) (D (mul (LH.den p) (LH.num q))) (D (LH.num p)) (D (LH.num q))
          (SI.product-right (LH.den q) (LH.num p)) (SI.product-right (LH.den p) (LH.num q)))) ;
    -- D b <= D(b a) \/ D(b c)
    le-bac : O.Le (D b) (lattice.join (D (mul b (LH.num p))) (D (mul b (LH.num q)))) =
     O.le-trans (D b) (lattice.meet (D b) (lattice.join (D (LH.num p)) (D (LH.num q))))
      (lattice.join (D (mul b (LH.num p))) (D (mul b (LH.num q))))
      (O.meet-glb (D b) (lattice.join (D (LH.num p)) (D (LH.num q))) (D b) (O.le-refl (D b)) le-ac)
      (O.le-of-eq _ _ (trans (lattice.dist (D b) (D (LH.num p)) (D (LH.num q)))
        (cong2 lattice.L lattice.join _ _ _ _ (sym (Sp.at-mul b (LH.num p))) (sym (Sp.at-mul b (LH.num q)))))) ;
    le : O.Le (D b) m =
     O.le-trans (D b) (lattice.join (D (mul b (LH.num p))) (D (mul b (LH.num q)))) m le-bac
      (O.join-mono (D (mul b (LH.num p))) (D (mul b (LH.num q))) (Lw.d u s) (Lw.d u t) (below-d s p) (below-d t q)) ;
   } ;
   le : O.Le (D b) m =
    Tr.Trunc[LH.Fraction (Loc b) (f b) x].induction @l (\ c -> O.Le (D b) m) (\ c -> O.le-prop (D b) m)
     (\ p -> Tr.Trunc[LH.Fraction (Loc b) (f b) y].induction @l (\ c -> O.Le (D b) m) (\ c -> O.le-prop (D b) m)
       (\ q -> Fractions[p,q].le) (LH.fractions (el b) y))
     (LH.fractions (el b) x) ;
  } ;
  law : O.Le v m = Test[v,m,\ b k -> At[b,k].le].le ;
 } ;
 add-law : Lw.AddLaw = \ u s t -> Sum[u,s,t].law ;

 -- Spec A
 spec : LR.LocallyRinged =
  new LR.LocallyRinged[Sh.structure,Sh.structure-sheaf,SI.inv-map,Lw.support zero-law add-law] ;
} ;
