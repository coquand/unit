-- qcqs schemes as locally ringed lattices (DESIGN.md): the shared ring
-- foundation from pn, then the files of this directory.
import Base ; import Prelude ; import Paths ; import Axioms ; import FunExtUA ;
import Replacement ; import Ring ; import Poly ; import Mul ;
module Theory
 (univ : [l] Axioms[l].Univalence)
 (images : [l] [k] Replacement[l,k].Images)
 (surjections : [l] [k] [j] (Replacement[l,k].Surjectivity (images @l @k)) @j) {
 fe : [l] Axioms[l].FunExt = <l> FunExtUA[l].FE[univ @l].fe ;
 propUA : [l] Axioms[l].PropUnivalence = <l> Axioms[l].UnivalenceLemmas[univ @l].prop-univ ;
 import Truncation ; import Quotient ;
 import RawLaws ; import RawMultiplication ; import RingHom ; import PolynomialRing ; import Evaluation ; import Universal ;
 import Algebras ; import Presentations ;
 import AffineRing ; import AffinePowers ; import Regularity ; import LocalizationIdentities ;
 import MonoidFractions ; import MonoidLocalization ; import MonoidLocalizationMap ;
 import AffineFinite ; import FiniteIdeal ;
 -- step 1: localisation
 import RingMaps ; import Localisation ; import LocalisationFractions ;
 -- step 2: the Zariski lattice
 import Radical ; import DistLattice ; import FamilyLattice ; import ZariskiLattice ; import ZariskiUniversal ;
 -- the bridge and the restriction maps
 import Bridge ; import Restriction ;
 -- step 3: the structure sheaf
 import Sections ; import BasicOpen ; import Limit ; import Separation ; import NatBound ; import Gluing ;
 import Separated ; import RingedLattice ; import Sheaf ; import Extension ;
 -- step 4: locally ringed lattices
 import InvOpen ; import SpecInv ; import LocallyRinged ; import MapEquality ; import SpecLocal ;
 -- doubling along an open
 import FibreProduct ; import DoubleLattice ; import Doubling ; import Chart ;
 -- Spec A from fractions, and the doubled-origin line
 import Affine ; import DoubledLine ;
 -- step 5: the universal property of Spec
 import Global ; import SpecMap ; import SpecUnique ; import SpecUniversal ;
 -- restriction to the opens below e
 import Slice ; import Iso ; import ChartIso ;
 -- the affine criterion
 import Compose ; import SpecHom ; import AffineCriterion ;
 -- the universal property of the slice, and (Spec A)|D(g) = Spec(A_g)
 import SliceUniversal ; import SpecBasicOpen ;
 -- P^1, step 1: the involution X |-> X^-1 and the automorphism of the punctured chart
 import Inversion ; import PuncturedChart ;
 -- qcqs schemes, and the doubled-origin line
 import Qcqs ; import DoubledLineQcqs ;
 -- the fold map and the universal property of the doubling
 import Fold ; import IntoDoubling ; import DoublingUniversal ;
 -- global sections of the doubled-origin line
 import PolynomialCoefficients ; import VariableKernel ; import DoubledLineGlobal ; import DoubledLineNotAffine ;
 -- the points of the doubled-origin line
 import DoubledLinePoints ; import DoubledLineBaseChange ;
 -- milestone 2: idempotents and complementary opens
 import Idempotents ; import Interval ; import PrincipalCertificates ; import PrincipalQuotient ; import ZariskiQuotient ; import DoubledLineIdempotents ; import DoubledLineIdempotentsBaseChange ;
 -- P^1, step 2: gluing along a transition
 import LatticePullback ; import GlueAlong ; import GlueTransition ; import ProjectiveLine ;
 -- P^1, step 4: global sections
 import InversionOverlap ; import ProjectiveLineGlobal ;
 -- P^1, step 5: not affine
 import ProjectiveLineNotAffine ;
 -- the structure map P^1 -> Spec k
 import ProjectiveLineStructure ;
} ;
