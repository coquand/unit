-- Module localisation commutes with restriction of scalars (Serre §4).
-- For psi:A->B, a B-module M and f in A, compare (Res M)_f with the
-- restriction of M_(psi f). The canonical map into the latter is
-- A-linear and f acts invertibly there. Its actual fractions clear
-- denominators and its kernel is killed by powers, using the equality
-- psi(f^p)=(psi f)^p. The checked elementary module criterion makes its
-- unique extension an equivalence, with the unchanged fraction formula.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RM = RingMaps[l] ; module RH = RingHom[l] ;
module Over (A B : CRing) (psi : RH.Hom A B) (Md : SM.Over[B].Module) (f : A.R) {
 module Source = MM.RestrictScalars[A,B,psi].Of[Md] ;
 module Local = SerreModuleLocalisationStructure[l].At[B,Md,RM.map psi f] ;
 module Target = MM.RestrictScalars[A,B,psi].Of[Local.localised] ;
 module AP = AffinePowers[l].Over[A] ; module BP = AffinePowers[l].Over[B] ;
 module H = MM.Between[A,A,RH.identity A,Source.restricted,Target.restricted] ;
 canonical : H.Hom = new H.Hom[Local.Canonical.map Local.canonical,
  Local.Canonical.map-add Local.canonical,
  \ a x -> trans (ap (Local.Canonical.map Local.canonical) (Source.scalar-at a x))
   (trans (Local.Canonical.map-scale Local.canonical (RM.map psi a) x)
    (sym (Target.scalar-at a (Local.Canonical.map Local.canonical x))))] ;
 canonical-at (x : Md.M) : Id Local.L.Carrier (H.map canonical x) (Local.L.fraction x zero) = Local.canonical-at x ;
 invertible : Pr.isEquiv Local.L.Carrier Local.L.Carrier (Target.restricted.sm f) =
  Iso[l].equiv-homotopy Local.L.Carrier Local.L.Carrier (Local.localised.sm (RM.map psi f)) (Target.restricted.sm f)
   (\ x -> sym (Target.scalar-at f x)) Local.Action.invertible ;
 module Fractions = SerreModuleClearFractions[l].At[B,Md,RM.map psi f] ;
 scalar-power (p : Nat) (x : Local.L.Carrier) :
  Id Local.L.Carrier (Target.restricted.sm (AP.power f p) x) (Local.localised.sm (BP.power (RM.map psi f) p) x) =
  trans (Target.scalar-at (AP.power f p) x)
   (ap (\ b -> Local.localised.sm b x) (AffinePowers[l].power-map A B psi f p)) ;
 clear-fraction (x : Md.M) (p : Nat) :
  Id Local.L.Carrier (H.map canonical x) (Target.restricted.sm (AP.power f p) (Local.L.fraction x p)) =
  trans (canonical-at x) (trans (sym (Fractions.clears x p)) (sym (scalar-power p (Local.L.fraction x p)))) ;
 Clear (y : Local.L.Carrier) : U l = (p : Nat) * (x : Md.M) *
  Id Local.L.Carrier (H.map canonical x) (Target.restricted.sm (AP.power f p) y) ;
 clear (y : Local.L.Carrier) : Tr.Trunc[Clear y].carrier =
  Tr.Trunc[(x : Md.M) * (p : Nat) * Id Local.L.Carrier (Local.L.fraction x p) y].induction @l
   (\ t -> Tr.Trunc[Clear y].carrier) (\ t -> Tr.Trunc[Clear y].proposition)
   (\ t -> Tr.Trunc[Clear y].inc (t.2.1,t.1,
    trans (clear-fraction t.1 t.2.1) (ap (Target.restricted.sm (AP.power f t.2.1)) t.2.2))) (Local.L.represented y) ;
 Kill (x : Md.M) : U l = (p : Nat) * Id Md.M (Source.restricted.sm (AP.power f p) x) Md.mz ;
 killed (x : Md.M) (w : Local.L.Killed x) : Kill x =
  (w.1,trans (Source.scalar-at (AP.power f w.1) x)
   (trans (ap (\ b -> Md.sm b x) (AffinePowers[l].power-map A B psi f w.1))
    (trans (sym (Local.L.power-scalar w.1 x)) w.2))) ;
 kill (x : Md.M) (e : Id Local.L.Carrier (H.map canonical x) Local.Action.mz) : Tr.Trunc[Kill x].carrier =
  Tr.Trunc[Local.L.Killed x].induction @l (\ t -> Tr.Trunc[Kill x].carrier) (\ t -> Tr.Trunc[Kill x].proposition)
   (\ w -> Tr.Trunc[Kill x].inc (killed x w)) (Local.L.zero-killed x (trans (sym (canonical-at x)) e)) ;
 module Comparison = SerreModuleBasicRestrictionsComparison[l].Over[A,Source.restricted,Target.restricted,f,
  canonical,invertible,clear,kill] ;
 map (x : Comparison.S.Carrier) : Local.L.Carrier = Comparison.forward x ;
 equivalence : Pr.isEquiv Comparison.S.Carrier Local.L.Carrier map = Comparison.equivalence ;
 target-clears (x : Md.M) (p : Nat) :
  Id Local.L.Carrier (Comparison.E.T.power p (Local.L.fraction x p)) (H.map canonical x) =
  trans (Comparison.E.T.power-scalar p (Local.L.fraction x p))
   (trans (scalar-power p (Local.L.fraction x p)) (trans (Fractions.clears x p) (sym (canonical-at x)))) ;
 on-fraction (x : Md.M) (p : Nat) :
  Id Local.L.Carrier (map (Comparison.S.fraction x p)) (Local.L.fraction x p) =
  Comparison.E.InverseAction.power-injective p _ _ (trans (Comparison.clears x p) (sym (target-clears x p))) ;
 module Maps = MM.Between[A,A,RH.identity A,Comparison.E.Source.localised,Target.restricted] ;
 linear : Maps.Hom = Comparison.E.lift ;
 linear-at (x : Comparison.S.Carrier) : Id Local.L.Carrier (Maps.map linear x) (map x) = Comparison.linear-map-at x ;
 opaque canonical ; opaque invertible ; opaque map ; opaque linear ;
} ;
