-- Totalisation, following relative-totalisation.tex §2.
-- Define the value family at each fixed test ring, with move and pair
-- accessors.  Change-target is path induction on h iota=kappa; at refl
-- the two algebra maps agree by their underlying maps.  Total-on uses
-- that fibre equation and the specified commuting path to identify the
-- total action with action on ANY algebra map.
-- Identity is total-on for the algebra identity, then F.identity.
-- Composition is total-on for a composite of two canonical lifts, then
-- F.composition.  Thus no coherence of structure maps is left implicit.
-- Projection onto the structure map is natural by its defining formula.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module RF = RelativeFunctors[l] ;
module SF = TestFunctors[l] ;
module Over (K : T.Test) (F : RF.Over[K].SetFunctor) {
 module R = RF.Over[K] ;
 module RT = R.RT ;
 module BP = RT.BP ;
 module At (B : T.Test) {
  Indices : U l = RH.Hom K.ring B.ring ;
  family (i : Indices) : U l = F.obj (BP.algebra B i) ;
  module DP = DependentPairs[l].Over[Indices,family,RH.Properties[K.ring,B.ring,B.carrier-set].set] ;
  pair (i : Indices) (x : family i) : DP.Total = (i,x) ;
  base (p : DP.Total) : Indices = p.1 ;
  value (p : DP.Total) : family (base p) = p.2 ;
  set : Pr.isSet DP.Total = Pr.isSet-Sigma Indices family RH.Properties[K.ring,B.ring,B.carrier-set].set
   (\ i -> F.set (BP.algebra B i)) ;
 } ;
 action (B C : T.Test) (h : RH.Hom B.ring C.ring) (p : At[B].DP.Total) : At[C].DP.Total =
  At[C].pair (RT.push B C h (At[B].base p))
   (F.reindex (BP.algebra B (At[B].base p)) (BP.algebra C (RT.push B C h (At[B].base p))) (RT.canonical B C h (At[B].base p)) (At[B].value p)) ;
 action-base (B C : T.Test) (h : RH.Hom B.ring C.ring) (p : At[B].DP.Total) :
  Id At[C].Indices (At[C].base (action B C h p)) (RT.push B C h (At[B].base p)) = refl (RT.push B C h (At[B].base p)) ;
 change-target (B C : T.Test) (h : RH.Hom B.ring C.ring) (i : At[B].Indices) :
  (j : At[C].Indices) (p : Id At[C].Indices (RT.push B C h i) j) (x : At[B].family i) ->
  Id (At[C].family j)
   (At[C].DP.move p (F.reindex (BP.algebra B i) (BP.algebra C (RT.push B C h i)) (RT.canonical B C h i) x))
   (F.reindex (BP.algebra B i) (BP.algebra C j) (RT.lift B C h i j p) x) =
  \ j p -> idJ At[C].Indices (RT.push B C h i)
   (\ j1 p1 -> (x : At[B].family i) -> Id (At[C].family j1)
    (At[C].DP.move p1 (F.reindex (BP.algebra B i) (BP.algebra C (RT.push B C h i)) (RT.canonical B C h i) x))
    (F.reindex (BP.algebra B i) (BP.algebra C j1) (RT.lift B C h i j1 p1) x))
   (\ x -> ap (\ a -> F.reindex (BP.algebra B i) (BP.algebra C (RT.push B C h i)) a x)
    (RT.ext (BP.algebra B i) (BP.algebra C (RT.push B C h i)) (RT.canonical B C h i) (RT.lift B C h i (RT.push B C h i) (refl (RT.push B C h i))) (refl h))) j p ;
 on-algebra (A B : BP.Algebra) (h : BP.Hom A B) (x : F.obj A) : Id At[BP.test B].DP.Total
  (action (BP.test A) (BP.test B) (BP.ring-map h) (At[BP.test A].pair (BP.iota A) x))
  (At[BP.test B].pair (BP.iota B) (F.reindex A B h x)) =
  At[BP.test B].DP.pair-equality _ _ (RT.commuting-path A B h)
   (trans (change-target (BP.test A) (BP.test B) (BP.ring-map h) (BP.iota A) (BP.iota B) (RT.commuting-path A B h) x)
    (ap (\ a -> F.reindex A B a x) (RT.ext A B (RT.lift (BP.test A) (BP.test B) (BP.ring-map h) (BP.iota A) (BP.iota B) (RT.commuting-path A B h)) h (refl (BP.ring-map h))))) ;
 identity (B : T.Test) (p : At[B].DP.Total) : Id At[B].DP.Total (action B B (RH.identity B.ring) p) p =
  trans (on-algebra (BP.algebra B (At[B].base p)) (BP.algebra B (At[B].base p)) (BP.id-hom (BP.algebra B (At[B].base p))) (At[B].value p))
   (ap (At[B].pair (At[B].base p)) (F.identity (BP.algebra B (At[B].base p)) (At[B].value p))) ;
 module Chain (B C D : T.Test) (h : RH.Hom B.ring C.ring) (k : RH.Hom C.ring D.ring) (p : At[B].DP.Total) {
  first : BP.Algebra = BP.algebra B (At[B].base p) ;
  second : BP.Algebra = BP.algebra C (RT.push B C h (BP.iota first)) ;
  third : BP.Algebra = BP.algebra D (RT.push C D k (BP.iota second)) ;
  f : BP.Hom first second = RT.canonical B C h (BP.iota first) ;
  g : BP.Hom second third = RT.canonical C D k (BP.iota second) ;
  equation : Id At[D].DP.Total (action B D (RH.compose B.ring C.ring D.ring k h) p) (action C D k (action B C h p)) =
   trans (on-algebra first third (BP.compose-hom first second third g f) (At[B].value p))
    (ap (At[D].pair (BP.iota third)) (F.composition first second third f g (At[B].value p))) ;
 } ;
 functor : SF.SetFunctor = new SF.SetFunctor[\ B -> At[B].DP.Total,\ B -> At[B].set,action,identity,\ B C D h k p -> Chain[B,C,D,h,k,p].equation] ;
 projection : SF.Transform[functor,SF.Representable[K].functor].Nat =
  (\ B p -> At[B].base p,\ B C h p -> action-base B C h p) ;
 projection-at (B : T.Test) (p : functor.obj B) : Id At[B].Indices
  (SF.Transform[functor,SF.Representable[K].functor].at projection B p) (At[B].base p) = refl (At[B].base p) ;
} ;
