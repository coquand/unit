-- QCoh(Spec A) is additive, by transport along Mod(A) = QCoh(Spec A)
-- (SerreQCohEquivalence.equality) of the additive structure of Mod(A)
-- (SerreModulePreadditive): one subst each. Together with the abelian
-- structure (SerreQCohAbelian) this is the full abelian structure of
-- QCoh(Spec A), Ab-enrichment included; the zero arrows of the two agree
-- (CategoryPreadditive.Lemmas.zero-agrees).
level l ; open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module CA = CategoryAbelian[l+] ;
module CP = CategoryPreadditive[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module E = SerreQCohEquivalence[l].Over[A,setA] ;
 module M = SerreModulePreadditive[l].Over[A,setA] ;
 module QA = SerreQCohAbelian[l].Over[A,setA] ;
 qcoh-preadditive : CP.Preadditive[E.QCoh.category] =
  CP.transport E.Modules.category E.QCoh.category E.equality M.preadditive ;
 qcoh-additive : CP.Additive[E.QCoh.category] =
  CP.transport-additive E.Modules.category E.QCoh.category E.equality M.additive ;
 -- abelian, with its Ab-enrichment
 qcoh-abelian-full : CA.IsAbelian E.QCoh.category * CP.Preadditive[E.QCoh.category] =
  (QA.qcoh-abelian,qcoh-preadditive) ;
 -- the zero arrows of the two structures agree
 qcoh-zero-agrees (x y : E.QCoh.precategory.ob) :
  Id (E.QCoh.precategory.hom x y) (CA.On[E.QCoh.category.pre].Zeros[QA.qcoh-abelian.zero].zero x y) (qcoh-preadditive.zero x y) =
  CP.Lemmas[E.QCoh.category,qcoh-preadditive].zero-agrees QA.qcoh-abelian.zero x y ;
} ;
