-- Separated qcqs schemes, in a cover-free form (DOUBLE-ORIGIN.md).
-- Let X be a locally ringed lattice on M; an open u is affine when X|u is
-- (Qcqs.AffineOpen).  For opens u, v write
--  r : O(u) -> O(u /\ v),   r' : O(v) -> O(u /\ v)
-- for the restrictions.  The overlap u /\ v is generated by u and v when
-- every z in O(u /\ v) is merely a finite sum
--  z = r(a_1) r'(b_1) + .. + r(a_n) r'(b_n),
-- that is, O(u) (x) O(v) -> O(u /\ v) is surjective; no tensor product is
-- formed.
-- Definition.  X is separated when for any two affine opens u, v the
--  overlap u /\ v is affine and generated by u and v.  (Classically: the
--  diagonal of X is a closed immersion iff this holds for affine opens.)
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 module O = DL.Order[M] ;
 module Q = Qcqs[l].Over[M,X] ;
 module Overlap (u v : M.L) {
  -- the overlap u /\ v
  overlap : M.L = M.meet u v ;
  module Sum = FiniteIdeal[l].Sums[X.sheaf.ring overlap] ;
  -- r and r'
  from-left : RH.Hom (X.sheaf.ring u) (X.sheaf.ring overlap) = X.sheaf.res overlap u (O.meet-left u v) ;
  from-right : RH.Hom (X.sheaf.ring v) (X.sheaf.ring overlap) = X.sheaf.res overlap v (O.meet-right u v) ;
  -- z = r(a_1) r'(b_1) + .. + r(a_n) r'(b_n)
  record SumOfProducts (z : (X.sheaf.ring overlap).R) {
   count : Nat ;
   lefts : Fin count -> (X.sheaf.ring u).R ;
   rights : Fin count -> (X.sheaf.ring v).R ;
   sum-eq : Id (X.sheaf.ring overlap).R z
    (Sum.sum count (\ i -> (X.sheaf.ring overlap).mul (map from-left (lefts i)) (map from-right (rights i)))) ;
  } ;
  -- O(u /\ v) is generated by the images of O(u) and O(v)
  Generated : U l = (z : (X.sheaf.ring overlap).R) -> Tr.Trunc[SumOfProducts[z]].carrier ;
 } ;
 IsSeparated : U l =
  (u v : M.L) -> Q.AffineOpen u -> Q.AffineOpen v -> Q.AffineOpen Overlap[u,v].overlap * Overlap[u,v].Generated ;
 -- the second part of separatedness, at two affine opens
 generated (sep : IsSeparated) (u v : M.L) (au : Q.AffineOpen u) (av : Q.AffineOpen v) : Overlap[u,v].Generated =
  (sep u v au av).2 ;
} ;
