-- Preadditive (Ab-enriched) and additive structure on a univalent category
-- C (objects and arrows in U k): the part of "abelian" that is data
-- (CategoryAbelian has the rest, without enrichment).
--
-- A preadditive structure: on each hom set C(x, y) an abelian group
-- (zero arrow 0, addition f + g, negation -f; f + (g + h) = (f + g) + h,
-- f + g = g + f, f + 0 = f, f + (-f) = 0), and composition additive in
-- each variable: (g + g') f = g f + g' f and g (f + f') = g f + g f'.
-- The zero, the addition and the negation are data; the laws are
-- propositions, as hom types are sets.
--
-- Consequences. In an abelian group h + h = h gives h = 0
-- (h = h + (h + -h) = (h + h) + -h = h + -h = 0). Hence 0 f = 0 and
-- g 0 = 0: 0 f = (0 + 0) f = 0 f + 0 f, and dually. If z is a zero object
-- (CategoryAbelian), the zero arrow x -> z -> y is b a with b : z -> y;
-- b is the zero arrow z -> y (the hom set out of z is contractible), so
-- b a = 0 a = 0: the two zero arrows agree (zero-agrees).
--
-- A biproduct of x and y: an object b with injections i1, i2 and
-- projections p1, p2, p1 i1 = 1, p2 i2 = 1, p2 i1 = 0, p1 i2 = 0 and
-- i1 p1 + i2 p2 = 1. An additive structure: a preadditive structure, a
-- zero object and a biproduct of every pair of objects.
-- Transport: both are families over categories, so an identification
-- C = D carries a structure on C to one on D (one subst).
level k ; open Base ; open Ring[k] ;
module K = Category[k,k] ;
module P = Prelude[k+] ;
module CA = CategoryAbelian[k] ;

record Preadditive (C : K.Category) {
 zero (x y : C.pre.ob) : C.pre.hom x y ;
 add (x y : C.pre.ob) (f g : C.pre.hom x y) : C.pre.hom x y ;
 neg (x y : C.pre.ob) (f : C.pre.hom x y) : C.pre.hom x y ;
 add-assoc (x y : C.pre.ob) (f g h : C.pre.hom x y) :
  Id (C.pre.hom x y) (add x y f (add x y g h)) (add x y (add x y f g) h) ;
 add-comm (x y : C.pre.ob) (f g : C.pre.hom x y) : Id (C.pre.hom x y) (add x y f g) (add x y g f) ;
 add-zero (x y : C.pre.ob) (f : C.pre.hom x y) : Id (C.pre.hom x y) (add x y f (zero x y)) f ;
 add-neg (x y : C.pre.ob) (f : C.pre.hom x y) : Id (C.pre.hom x y) (add x y f (neg x y f)) (zero x y) ;
 comp-add-left (x y z : C.pre.ob) (g g' : C.pre.hom y z) (f : C.pre.hom x y) :
  Id (C.pre.hom x z) (C.pre.comp x y z (add y z g g') f) (add x z (C.pre.comp x y z g f) (C.pre.comp x y z g' f)) ;
 comp-add-right (x y z : C.pre.ob) (g : C.pre.hom y z) (f f' : C.pre.hom x y) :
  Id (C.pre.hom x z) (C.pre.comp x y z g (add x y f f')) (add x z (C.pre.comp x y z g f) (C.pre.comp x y z g f')) ;
} ;

module Lemmas (C : K.Category) (S : Preadditive[C]) {
 -- h + h = h gives h = 0
 cancel (x y : C.pre.ob) (h : C.pre.hom x y) (e : Id (C.pre.hom x y) (S.add x y h h) h) :
  Id (C.pre.hom x y) h (S.zero x y) =
  trans (sym (S.add-zero x y h)) (trans (ap (S.add x y h) (sym (S.add-neg x y h)))
   (trans (S.add-assoc x y h h (S.neg x y h)) (trans (ap (\ u -> S.add x y u (S.neg x y h)) e) (S.add-neg x y h)))) ;
 -- 0 f = 0 and g 0 = 0
 comp-zero-left (x y z : C.pre.ob) (f : C.pre.hom x y) :
  Id (C.pre.hom x z) (C.pre.comp x y z (S.zero y z) f) (S.zero x z) =
  cancel x z (C.pre.comp x y z (S.zero y z) f)
   (trans (sym (S.comp-add-left x y z (S.zero y z) (S.zero y z) f))
    (ap (\ u -> C.pre.comp x y z u f) (S.add-zero y z (S.zero y z)))) ;
 comp-zero-right (x y z : C.pre.ob) (g : C.pre.hom y z) :
  Id (C.pre.hom x z) (C.pre.comp x y z g (S.zero x y)) (S.zero x z) =
  cancel x z (C.pre.comp x y z g (S.zero x y))
   (trans (sym (S.comp-add-right x y z g (S.zero x y) (S.zero x y)))
    (ap (C.pre.comp x y z g) (S.add-zero x y (S.zero x y)))) ;
 -- the zero arrows agree with the zero arrows through a zero object
 zero-agrees (z : CA.On[C.pre].Zero) (x y : C.pre.ob) :
  Id (C.pre.hom x y) (CA.On[C.pre].Zeros[z].zero x y) (S.zero x y) =
  trans (ap (\ b -> C.pre.comp x z.1 y b ((z.2.2 x).1))
    (trans (sym ((z.2.1 y).2 ((z.2.1 y).1))) ((z.2.1 y).2 (S.zero z.1 y))))
   (comp-zero-left x z.1 y ((z.2.2 x).1)) ;
} ;

-- binary biproducts, relative to a preadditive structure
record Biproduct (C : K.Category) (S : Preadditive[C]) (x y : C.pre.ob) {
 object : C.pre.ob ;
 in1 : C.pre.hom x object ;
 in2 : C.pre.hom y object ;
 out1 : C.pre.hom object x ;
 out2 : C.pre.hom object y ;
 out1-in1 : Id (C.pre.hom x x) (C.pre.comp x object x out1 in1) (C.pre.idn x) ;
 out2-in2 : Id (C.pre.hom y y) (C.pre.comp y object y out2 in2) (C.pre.idn y) ;
 out2-in1 : Id (C.pre.hom x y) (C.pre.comp x object y out2 in1) (S.zero x y) ;
 out1-in2 : Id (C.pre.hom y x) (C.pre.comp y object x out1 in2) (S.zero y x) ;
 sum : Id (C.pre.hom object object)
  (S.add object object (C.pre.comp object x object in1 out1) (C.pre.comp object y object in2 out2)) (C.pre.idn object) ;
} ;

record Additive (C : K.Category) {
 preadditive : Preadditive[C] ;
 zero-object : CA.On[C.pre].Zero ;
 biproducts (x y : C.pre.ob) : Biproduct[C,preadditive,x,y] ;
} ;

-- transport along an identification of categories
transport (C D : K.Category) (p : Id K.Category C D) (s : Preadditive[C]) : Preadditive[D] =
 P.subst K.Category (\ E -> Preadditive[E]) C D p s ;
transport-additive (C D : K.Category) (p : Id K.Category C D) (s : Additive[C]) : Additive[D] =
 P.subst K.Category (\ E -> Additive[E]) C D p s ;
