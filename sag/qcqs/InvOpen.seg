-- Invertibility opens (DESIGN.md, step 4, stage 1; zeuner1 Def. 3.2 and
-- Remark 3.3), over any presheaf of rings G on a distributive lattice M.
--
-- Definition.  For u in M and s in G(u), v is an invertibility open of s
--  when v <= u and, for every w <= u,  w <= v  <=>  s|w is a unit of G(w).
--
-- Lemma (unit).  s|v is a unit: take w = v.
-- Lemma (unique).  Two invertibility opens v, v2 of s are equal: s|v is a
--  unit, so v <= v2; symmetrically v2 <= v.  Being an invertibility open
--  is a proposition (<= is one, and so is being a unit in a set), so the
--  type of invertibility opens of s is a proposition, and so is the type
--  of invertibility maps (u : M) (s : G(u)) -> invertibility open of s.
-- Lemma (restrict).  If w <= u and v is an invertibility open of s, then
--  w /\ v is one of s|w.  For w2 <= w:  w2 <= w /\ v  <=>  w2 <= v  <=>
--  s|w2 is a unit, and (s|w)|w2 = s|w2.  Hence by uniqueness every
--  invertibility open of s|w is w /\ v (restrict-eq).
-- Lemma (whole).  If s is a unit, u is its invertibility open: ring maps
--  carry units to units, and every w <= u lies below u.
-- No support law and no sheaf condition is used in these.
--
-- In a sheaf (Local).
-- Lemma (Units).  For a cover m_i of m, x in G(m) is a unit when every
--  x|m_i is.  Let y_i be the inverse of x|m_i.  The restrictions of y_i
--  and y_j to m_i /\ m_j are both inverses of x|(m_i /\ m_j), hence equal:
--  the y_i are compatible.  Their amalgam y satisfies (x y)|m_i =
--  x|m_i y_i = 1 = 1|m_i, so x y = 1 by separation.
-- Lemma (Basis).  Let B be a family of opens with every open merely a finite
--  join of members of B, s in G(u), v <= u, and b <= v <=> s|b unit for
--  b in B below u.  Then v is the invertibility open of s.  For w <= u, both
--  directions are propositions, so take w = b_1 \/ .. \/ b_n.  If w <= v,
--  each (s|w)|b_i = s|b_i is a unit, so s|w is (Units).  If s|w is a unit,
--  so is each s|b_i, so b_i <= v, and w <= v.
-- Lemma (Join; zeuner1 3.1: D_(u_1 \/ .. \/ u_n)(s) = \/ D_(u_i)(s|u_i)).
--  For a cover u_i of u and invertibility opens v_i of s|u_i, V = \/ v_i is
--  the invertibility open of s.  First u_i /\ v_j <= v_i, because there
--  s|u_i is a unit, as s|u_j is; hence u_i /\ V <= v_i (distributivity).
--  Let w <= u; w is covered by the w /\ u_i.  If w <= V, then
--  w /\ u_i <= u_i /\ V <= v_i, so each s|(w /\ u_i) is a unit, and s|w is
--  one (Units).  If s|w is a unit, so is s|(w /\ u_i), hence w /\ u_i <= v_i
--  and w <= \/ (w /\ u_i) <= V.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module On (M : DL.DLat) {
 module O = DL.Order[M] ;
 module RG = RingedLattice[l].On[M] ;
 module Of (G : RG.Presheaf) {
  module GO = RG.Of[G] ;
  -- x is a unit of G(m)
  Unit (m : M.L) (x : (G.ring m).R) : U l = RL[G.ring m].unit x ;
  unit-prop (m : M.L) (x : (G.ring m).R) : Pr.isProp (Unit m x) =
   AffineRing[l].Laws[G.ring m,G.ring-set m].unit-prop x ;

  -- v is an invertibility open of s in G(u): v <= u, and for w <= u,
  -- w <= v gives a unit s|w (Forward) and a unit s|w gives w <= v (Backward)
  Forward (u : M.L) (s : (G.ring u).R) (v : M.L) : U l =
   (w : M.L) (k : O.Le w u) -> O.Le w v -> Unit w (GO.restrict w u k s) ;
  Backward (u : M.L) (s : (G.ring u).R) (v : M.L) : U l =
   (w : M.L) (k : O.Le w u) -> Unit w (GO.restrict w u k s) -> O.Le w v ;
  IsInvOpen (u : M.L) (s : (G.ring u).R) (v : M.L) : U l = O.Le v u * Forward u s v * Backward u s v ;
  below {u : M.L} {s : (G.ring u).R} {v : M.L} (p : IsInvOpen u s v) : O.Le v u = p.1 ;
  to-unit {u : M.L} {s : (G.ring u).R} {v : M.L} (p : IsInvOpen u s v)
   (w : M.L) (k : O.Le w u) (h : O.Le w v) : Unit w (GO.restrict w u k s) = p.2.1 w k h ;
  from-unit {u : M.L} {s : (G.ring u).R} {v : M.L} (p : IsInvOpen u s v)
   (w : M.L) (k : O.Le w u) (e : Unit w (GO.restrict w u k s)) : O.Le w v = p.2.2 w k e ;

  forward-prop (u : M.L) (s : (G.ring u).R) (v : M.L) : Pr.isProp (Forward u s v) =
   F.isProp-Pi M.L (\ w -> (k : O.Le w u) -> O.Le w v -> Unit w (GO.restrict w u k s)) (\ w ->
    F.isProp-Pi (O.Le w u) (\ k -> O.Le w v -> Unit w (GO.restrict w u k s)) (\ k ->
     F.isProp-Pi (O.Le w v) (\ h -> Unit w (GO.restrict w u k s)) (\ h -> unit-prop w (GO.restrict w u k s)))) ;
  backward-prop (u : M.L) (s : (G.ring u).R) (v : M.L) : Pr.isProp (Backward u s v) =
   F.isProp-Pi M.L (\ w -> (k : O.Le w u) -> Unit w (GO.restrict w u k s) -> O.Le w v) (\ w ->
    F.isProp-Pi (O.Le w u) (\ k -> Unit w (GO.restrict w u k s) -> O.Le w v) (\ k ->
     F.isProp-Pi (Unit w (GO.restrict w u k s)) (\ e -> O.Le w v) (\ e -> O.le-prop w v))) ;
  is-inv-open-prop (u : M.L) (s : (G.ring u).R) (v : M.L) : Pr.isProp (IsInvOpen u s v) =
   Pr.isProp-Sigma (O.Le v u) (\ b -> Forward u s v * Backward u s v) (O.le-prop v u) (\ b ->
    Pr.isProp-Sigma (Forward u s v) (\ fw -> Backward u s v) (forward-prop u s v) (\ fw -> backward-prop u s v)) ;

  -- s|v is a unit
  unit-on {u : M.L} {s : (G.ring u).R} {v : M.L} (p : IsInvOpen u s v) : Unit v (GO.restrict v u (below p) s) =
   to-unit p v (below p) (O.le-refl v) ;

  -- Remark 3.3: invertibility opens are unique
  unique {u : M.L} {s : (G.ring u).R} {v v2 : M.L} (p : IsInvOpen u s v) (q : IsInvOpen u s v2) : Id M.L v v2 =
   O.le-antisym v v2 (from-unit q v (below p) (unit-on p)) (from-unit p v2 (below q) (unit-on q)) ;

  InvOpen (u : M.L) (s : (G.ring u).R) : U l = (v : M.L) * IsInvOpen u s v ;
  open-of {u : M.L} {s : (G.ring u).R} (p : InvOpen u s) : M.L = p.1 ;
  is-inv-open {u : M.L} {s : (G.ring u).R} (p : InvOpen u s) : IsInvOpen u s (open-of p) = p.2 ;
  inv-open-prop (u : M.L) (s : (G.ring u).R) : Pr.isProp (InvOpen u s) = \ p q ->
   Pr.Sigma-eq M.L (IsInvOpen u s) p.1 q.1 p.2 q.2 (unique p.2 q.2) (is-inv-open-prop u s q.1) ;

  -- invertibility maps, also a proposition
  InvMap : U l = (u : M.L) (s : (G.ring u).R) -> InvOpen u s ;
  inv-map-prop : Pr.isProp InvMap =
   F.isProp-Pi M.L (\ u -> (s : (G.ring u).R) -> InvOpen u s) (\ u ->
    F.isProp-Pi (G.ring u).R (\ s -> InvOpen u s) (\ s -> inv-open-prop u s)) ;

  -- restriction in one step or two, with any witnesses: (s|m)|w = s|w
  res-twice (u m w : M.L) (k : O.Le m u) (k2 : O.Le w m) (k3 : O.Le w u) (s : (G.ring u).R) :
   Id (G.ring w).R (GO.restrict w m k2 (GO.restrict m u k s)) (GO.restrict w u k3 s) =
   G.res-comp w m u k2 k k3 s ;
  unit-twice (u m w : M.L) (k : O.Le m u) (k2 : O.Le w m) (k3 : O.Le w u) (s : (G.ring u).R)
   (e : Unit w (GO.restrict w u k3 s)) : Unit w (GO.restrict w m k2 (GO.restrict m u k s)) =
   Pr.subst (G.ring w).R (Unit w) _ _ (sym (res-twice u m w k k2 k3 s)) e ;
  unit-once (u m w : M.L) (k : O.Le m u) (k2 : O.Le w m) (k3 : O.Le w u) (s : (G.ring u).R)
   (e : Unit w (GO.restrict w m k2 (GO.restrict m u k s))) : Unit w (GO.restrict w u k3 s) =
   Pr.subst (G.ring w).R (Unit w) _ _ (res-twice u m w k k2 k3 s) e ;
  -- restrictions of units are units
  unit-restrict (m w : M.L) (k : O.Le w m) (x : (G.ring m).R) (e : Unit m x) : Unit w (GO.restrict w m k x) =
   AffineRing[l].unit-map (G.ring m) (G.ring w) (G.res w m k) x e ;
  module Restrict (u w : M.L) (k : O.Le w u) (s : (G.ring u).R) (v : M.L) (p : IsInvOpen u s v) {
   restrict : IsInvOpen w (GO.restrict w u k s) (M.meet w v) =
    (O.meet-left w v,
     (\ w2 k2 h -> unit-twice u w w2 k k2 (O.le-trans w2 w u k2 k) s
       (to-unit p w2 (O.le-trans w2 w u k2 k) (O.le-trans w2 (M.meet w v) v h (O.meet-right w v)))),
     (\ w2 k2 e -> O.meet-glb w v w2 k2
       (from-unit p w2 (O.le-trans w2 w u k2 k) (unit-once u w w2 k k2 (O.le-trans w2 w u k2 k) s e)))) ;
   -- every invertibility open of s|w is w /\ v
   restrict-eq (v2 : M.L) (q : IsInvOpen w (GO.restrict w u k s) v2) : Id M.L v2 (M.meet w v) =
    unique q restrict ;
  } ;

  -- a unit is invertible everywhere
  whole (u : M.L) (s : (G.ring u).R) (e : Unit u s) : IsInvOpen u s u =
   (O.le-refl u,
    (\ w k _ -> unit-restrict u w k s e),
    (\ w k _ -> k)) ;

  -- In a sheaf: units are local, the basis criterion, and joins.
  module Local (sheaf : GO.IsSheaf) {
   module GS = RG.Sheaf[G,sheaf] ;
   module J = DL.Joins[M] ;
   -- if x|b is a unit and y one of its inverses, then x|a . y|a = 1 for a <= b
   inverse-below (m b a : M.L) (k : O.Le b m) (k2 : O.Le a b) (k3 : O.Le a m) (x : (G.ring m).R)
    (y : (G.ring b).R) (e : Id (G.ring b).R ((G.ring b).mul (GO.restrict b m k x) y) (G.ring b).o) :
    Id (G.ring a).R ((G.ring a).mul (GO.restrict a m k3 x) (GO.restrict a b k2 y)) (G.ring a).o = calc (G.ring a).R {
    (G.ring a).mul (GO.restrict a m k3 x) (GO.restrict a b k2 y)
      =< ap (\ t -> (G.ring a).mul t (GO.restrict a b k2 y)) (sym (res-twice m b a k k2 k3 x))
      > (G.ring a).mul (GO.restrict a b k2 (GO.restrict b m k x)) (GO.restrict a b k2 y)
      =< sym (map-mul (G.res a b k2) (GO.restrict b m k x) y)
      > GO.restrict a b k2 ((G.ring b).mul (GO.restrict b m k x) y)
      =< ap (GO.restrict a b k2) e > GO.restrict a b k2 (G.ring b).o
      =< map-one (G.res a b k2) > (G.ring a).o } ;

   -- units are local: x is a unit when every x|m_i is
   module Units (m : M.L) (n : Nat) (ms : Fin n -> M.L) (le : (i : Fin n) -> O.Le (ms i) m)
    (covers : O.Le m (J.bigJ n ms)) (x : (G.ring m).R)
    (us : (i : Fin n) -> Unit (ms i) (GO.restrict (ms i) m (le i) x)) {
    module C = GO.Cover[m,n,ms,le,covers] ;
    module SC = GS.Cover[m,n,ms,le,covers] ;
    inv (i : Fin n) : (G.ring (ms i)).R = (us i).1 ;
    inv-eq (i : Fin n) : Id (G.ring (ms i)).R ((G.ring (ms i)).mul (GO.restrict (ms i) m (le i) x) (inv i)) (G.ring (ms i)).o =
     (us i).2 ;
    -- y_i and y_j restrict to inverses of the same x|(m_i /\ m_j)
    meet-le (i j : Fin n) : O.Le (M.meet (ms i) (ms j)) m =
     O.le-trans (M.meet (ms i) (ms j)) (ms i) m (O.meet-left (ms i) (ms j)) (le i) ;
    compatible : C.Compatible inv = \ i j ->
     AffineRing[l].Laws[G.ring (M.meet (ms i) (ms j)),G.ring-set (M.meet (ms i) (ms j))].inverse-unique
      (GO.restrict (M.meet (ms i) (ms j)) m (meet-le i j) x) _ _
      (inverse-below m (ms i) (M.meet (ms i) (ms j)) (le i) (O.meet-left (ms i) (ms j)) (meet-le i j) x (inv i) (inv-eq i))
      (inverse-below m (ms j) (M.meet (ms i) (ms j)) (le j) (O.meet-right (ms i) (ms j)) (meet-le i j) x (inv j) (inv-eq j)) ;
    -- their amalgam y is an inverse of x: (x y)|m_i = x|m_i . y_i = 1
    glued : C.Amalgam inv = (SC.glue inv compatible).1 ;
    unit : Unit m x =
     (C.amalgam glued,
      SC.separated ((G.ring m).mul x (C.amalgam glued)) (G.ring m).o (\ i -> calc (G.ring (ms i)).R {
       C.restrictions ((G.ring m).mul x (C.amalgam glued)) i
         =< map-mul (G.res (ms i) m (le i)) x (C.amalgam glued)
         > (G.ring (ms i)).mul (GO.restrict (ms i) m (le i) x) (C.restrictions (C.amalgam glued) i)
         =< ap ((G.ring (ms i)).mul (GO.restrict (ms i) m (le i) x)) (C.matches glued i)
         > (G.ring (ms i)).mul (GO.restrict (ms i) m (le i) x) (inv i)
         =< inv-eq i > (G.ring (ms i)).o
         =< sym (map-one (G.res (ms i) m (le i))) > C.restrictions (G.ring m).o i })) ;
   } ;

   -- the basis criterion: B a family of opens such that every open is merely
   -- a finite join of them; it suffices to test w <= v <=> s|w unit on them
   module Basis (B : U l) (el : B -> M.L) {
    Covered (w : M.L) : U l = (n : Nat) * (bs : Fin n -> B) * Id M.L w (J.bigJ n (\ i -> el (bs i))) ;
    count {w : M.L} (c : Covered w) : Nat = c.1 ;
    piece {w : M.L} (c : Covered w) (i : Fin (count c)) : B = c.2.1 i ;
    covered-eq {w : M.L} (c : Covered w) : Id M.L w (J.bigJ (count c) (\ i -> el (piece c i))) = c.2.2 ;
    piece-le {w : M.L} (c : Covered w) (i : Fin (count c)) : O.Le (el (piece c i)) w =
     Pr.subst M.L (\ t -> O.Le (el (piece c i)) t) _ w (sym (covered-eq c))
      (J.below (count c) (\ j -> el (piece c j)) i) ;
    module Criterion (basis : (w : M.L) -> Tr.Trunc[Covered w].carrier)
     (u : M.L) (s : (G.ring u).R) (v : M.L) (vu : O.Le v u)
     (fwd : (b : B) (k : O.Le (el b) u) -> O.Le (el b) v -> Unit (el b) (GO.restrict (el b) u k s))
     (bwd : (b : B) (k : O.Le (el b) u) -> Unit (el b) (GO.restrict (el b) u k s) -> O.Le (el b) v) {
     piece-u {w : M.L} (k : O.Le w u) (c : Covered w) (i : Fin (count c)) : O.Le (el (piece c i)) u =
      O.le-trans (el (piece c i)) w u (piece-le c i) k ;
     forward-at (w : M.L) (k : O.Le w u) (h : O.Le w v) (c : Covered w) : Unit w (GO.restrict w u k s) =
      Units[w,count c,\ i -> el (piece c i),piece-le c,O.le-of-eq w _ (covered-eq c),GO.restrict w u k s,\ i ->
       unit-twice u w (el (piece c i)) k (piece-le c i) (piece-u k c i) s
        (fwd (piece c i) (piece-u k c i) (O.le-trans (el (piece c i)) w v (piece-le c i) h))].unit ;
     backward-at (w : M.L) (k : O.Le w u) (e : Unit w (GO.restrict w u k s)) (c : Covered w) : O.Le w v =
      Pr.subst M.L (\ t -> O.Le t v) _ w (sym (covered-eq c))
       (J.least (count c) (\ i -> el (piece c i)) v (\ i ->
        bwd (piece c i) (piece-u k c i)
         (unit-once u w (el (piece c i)) k (piece-le c i) (piece-u k c i) s
          (unit-restrict w (el (piece c i)) (piece-le c i) (GO.restrict w u k s) e)))) ;
     inv-open : IsInvOpen u s v =
      (vu,
       (\ w k h -> Tr.Trunc[Covered w].induction @l (\ c -> Unit w (GO.restrict w u k s))
         (\ c -> unit-prop w (GO.restrict w u k s)) (forward-at w k h) (basis w)),
       (\ w k e -> Tr.Trunc[Covered w].induction @l (\ c -> O.Le w v)
         (\ c -> O.le-prop w v) (backward-at w k e) (basis w))) ;
    } ;
   } ;

   -- joins: for a cover u_i of u and invertibility opens v_i of s|u_i,
   -- v_1 \/ .. \/ v_n is the invertibility open of s
   module Join (u : M.L) (s : (G.ring u).R) (n : Nat) (ms : Fin n -> M.L) (le : (i : Fin n) -> O.Le (ms i) u)
    (covers : O.Le u (J.bigJ n ms)) (vs : Fin n -> M.L)
    (ps : (i : Fin n) -> IsInvOpen (ms i) (GO.restrict (ms i) u (le i) s) (vs i)) {
    V : M.L = J.bigJ n vs ;
    below-u : O.Le V u = J.least n vs u (\ i -> O.le-trans (vs i) (ms i) u (below (ps i)) (le i)) ;
    -- u_i /\ v_j <= v_i: there s|u_i is a unit, as s|u_j is
    cross (i j : Fin n) : O.Le (M.meet (ms i) (vs j)) (vs i) =
     from-unit (ps i) (M.meet (ms i) (vs j)) (O.meet-left (ms i) (vs j))
      (unit-twice u (ms i) (M.meet (ms i) (vs j)) (le i) (O.meet-left (ms i) (vs j))
        (O.le-trans (M.meet (ms i) (vs j)) (ms i) u (O.meet-left (ms i) (vs j)) (le i)) s
       (unit-once u (ms j) (M.meet (ms i) (vs j)) (le j)
         (O.le-trans (M.meet (ms i) (vs j)) (vs j) (ms j) (O.meet-right (ms i) (vs j)) (below (ps j)))
         (O.le-trans (M.meet (ms i) (vs j)) (ms i) u (O.meet-left (ms i) (vs j)) (le i)) s
        (to-unit (ps j) (M.meet (ms i) (vs j))
          (O.le-trans (M.meet (ms i) (vs j)) (vs j) (ms j) (O.meet-right (ms i) (vs j)) (below (ps j)))
          (O.meet-right (ms i) (vs j))))) ;
    below-v (i : Fin n) : O.Le (M.meet (ms i) V) (vs i) = J.meet-below (ms i) n vs (vs i) (cross i) ;
    -- w <= u is covered by the w /\ u_i
    piece-u (w : M.L) (k : O.Le w u) (i : Fin n) : O.Le (M.meet w (ms i)) u =
     O.le-trans (M.meet w (ms i)) w u (O.meet-left w (ms i)) k ;
    w-covered (w : M.L) (k : O.Le w u) : O.Le w (J.bigJ n (\ i -> M.meet w (ms i))) =
     J.meet-cover w n ms (O.le-trans w u (J.bigJ n ms) k covers) ;
    forward (w : M.L) (k : O.Le w u) (h : O.Le w V) : Unit w (GO.restrict w u k s) =
     Units[w,n,\ i -> M.meet w (ms i),\ i -> O.meet-left w (ms i),w-covered w k,GO.restrict w u k s,\ i ->
      unit-twice u w (M.meet w (ms i)) k (O.meet-left w (ms i)) (piece-u w k i) s
       (unit-once u (ms i) (M.meet w (ms i)) (le i) (O.meet-right w (ms i)) (piece-u w k i) s
        (to-unit (ps i) (M.meet w (ms i)) (O.meet-right w (ms i))
         (O.le-trans (M.meet w (ms i)) (M.meet (ms i) V) (vs i)
          (O.meet-glb (ms i) V (M.meet w (ms i)) (O.meet-right w (ms i))
            (O.le-trans (M.meet w (ms i)) w V (O.meet-left w (ms i)) h))
          (below-v i))))].unit ;
    backward (w : M.L) (k : O.Le w u) (e : Unit w (GO.restrict w u k s)) : O.Le w V =
     O.le-trans w (J.bigJ n (\ i -> M.meet w (ms i))) V (w-covered w k)
      (J.least n (\ i -> M.meet w (ms i)) V (\ i ->
       O.le-trans (M.meet w (ms i)) (vs i) V
        (from-unit (ps i) (M.meet w (ms i)) (O.meet-right w (ms i))
         (unit-twice u (ms i) (M.meet w (ms i)) (le i) (O.meet-right w (ms i)) (piece-u w k i) s
          (unit-once u w (M.meet w (ms i)) k (O.meet-left w (ms i)) (piece-u w k i) s
           (unit-restrict w (M.meet w (ms i)) (O.meet-left w (ms i)) (GO.restrict w u k s) e))))
        (J.below n vs i))) ;
    inv-open : IsInvOpen u s V = (below-u,forward,backward) ;
   } ;
  } ;
 } ;
} ;
