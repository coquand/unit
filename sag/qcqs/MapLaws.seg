-- Identity laws and inverse equations for maps of ringed lattices.
-- Composing with an identity has the same lattice and section maps; after
-- the restriction along u <= u, res-id gives MapEquality.ext.
-- For an isomorphism pi, let rho = Iso.Invert.inverse.
-- pi rho = 1: p(back m) = m, and pi#(rho# x) = x|p(back m)
-- (Invert.pi-sharp); restricting back to m gives x by res-comp and res-id.
-- rho pi = 1: back(p u) = u.  Compare rho#(pi# x) with x restricted to
-- back(p u).  Applying the injective pi# there gives equality by
-- Invert.pi-sharp and naturality of pi; witnesses agree by res-irr.
-- Thus both equations are equalities of maps, not merely isomorphisms.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Units (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf)
 (pi : LocallyRinged[l].Maps[L,M,F,G].Ringed) {
 module O = DL.Order[M] ;
 module E = MapEquality[l].Maps[L,M,F,G] ;
 module IL = Compose[l].Identity[L,F] ;
 module IM = Compose[l].Identity[M,G] ;
 module Left = Compose[l].Maps[L,M,M,F,G,G].Of[IM.identity,pi] ;
 module Right = Compose[l].Maps[L,L,M,F,F,G].Of[pi,IL.identity] ;
 left : Id E.Mp.Ringed Left.composite pi =
  E.ext Left.composite pi (\ u -> refl (DL.hmap pi.lat u)) (\ u -> O.le-refl (DL.hmap pi.lat u))
   (\ u x -> G.res-id (DL.hmap pi.lat u) (O.le-refl (DL.hmap pi.lat u)) (map (pi.sharp u) x)) ;
 right : Id E.Mp.Ringed Right.composite pi =
  E.ext Right.composite pi (\ u -> refl (DL.hmap pi.lat u)) (\ u -> O.le-refl (DL.hmap pi.lat u))
   (\ u x -> G.res-id (DL.hmap pi.lat u) (O.le-refl (DL.hmap pi.lat u)) (map (pi.sharp u) x)) ;
} ;
module Inverse (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf)
 (pi : LocallyRinged[l].Maps[L,M,F,G].Ringed) (iso : Iso[l].Maps[L,M,F,G].IsIso pi) {
 module OL = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module FO = RingedLattice[l].On[L].Of[F] ;
 module GO = RingedLattice[l].On[M].Of[G] ;
 module V = Iso[l].Invert[L,M,F,G,pi,iso] ;
 module PJ = DL.JoinMaps[L,M,pi.lat] ;
 module IL = Compose[l].Identity[L,F] ;
 module IM = Compose[l].Identity[M,G] ;
 module EM = MapEquality[l].Maps[M,M,G,G] ;
 module EL = MapEquality[l].Maps[L,L,F,F] ;
 module PR = Compose[l].Maps[M,L,M,G,F,G].Of[pi,V.inverse] ;
 module RP = Compose[l].Maps[L,M,L,F,G,F].Of[V.inverse,pi] ;
 le-back (m : M.L) : OM.Le m (V.p (V.back m)) = OM.le-of-eq m (V.p (V.back m)) (sym (V.back-eq m)) ;
 right-sharp (m : M.L) (x : (G.ring m).R) : Id (G.ring m).R
  (GO.restrict m (V.p (V.back m)) (le-back m) (map (PR.composite.sharp m) x)) x =
  trans (ap (GO.restrict m (V.p (V.back m)) (le-back m)) (PR.sharp-map m x))
   (trans (ap (GO.restrict m (V.p (V.back m)) (le-back m)) (V.pi-sharp m x))
    (trans (G.res-comp m (V.p (V.back m)) m (le-back m) (V.up m) (OM.le-refl m) x) (G.res-id m (OM.le-refl m) x))) ;
 right : Id EM.Mp.Ringed PR.composite IM.identity =
  EM.ext PR.composite IM.identity V.back-eq le-back right-sharp ;
 back-ret (u : L.L) : Id L.L (V.back (V.p u)) u = Pr.sec-ret L.L M.L (DL.hmap pi.lat) iso.1 u ;
 le-ret (u : L.L) : OL.Le (V.back (V.p u)) u = OL.le-of-eq (V.back (V.p u)) u (back-ret u) ;
 left-sharp (u : L.L) (x : (F.ring u).R) : Id (F.ring (V.back (V.p u))).R
  (FO.restrict (V.back (V.p u)) u (le-ret u) x) (map (RP.composite.sharp u) x) =
  trans (Iso[l].injective (F.ring (V.back (V.p u))).R (G.ring (V.p (V.back (V.p u)))).R
    (map (pi.sharp (V.back (V.p u)))) (iso.2 (V.back (V.p u)))
    (FO.restrict (V.back (V.p u)) u (le-ret u) x) (map (V.inverse.sharp (V.p u)) (map (pi.sharp u) x))
    (trans (sym (pi.natural (V.back (V.p u)) u (le-ret u) x))
     (trans (GO.res-irr (V.p (V.back (V.p u))) (V.p u)
       (PJ.monotone (V.back (V.p u)) u (le-ret u)) (V.up (V.p u)) (map (pi.sharp u) x))
      (sym (V.pi-sharp (V.p u) (map (pi.sharp u) x))))))
   (sym (RP.sharp-map u x)) ;
 left : Id EL.Mp.Ringed RP.composite IL.identity =
  sym (EL.ext IL.identity RP.composite (\ u -> sym (back-ret u)) le-ret left-sharp) ;
} ;
