-- Natural equivalences on native algebra-test functors.
-- The pointwise inverse is natural: apply the injective forward map,
-- use its naturality, and then its inverse laws.  Extensionality gives
-- the transformation inverse equations.  Composition is componentwise.
-- These are the relative natural equivalences used in §2 and §6.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module T = AffineTests[l] ;
module Over (K : T.Test) {
 module R = RelativeFunctors[l].Over[K] ;
 module BP = R.BP ;
NaturalEquivalence (F G : R.SetFunctor) : U l+ =
 (alpha : R.Transform[F,G].Nat) * ((A : BP.Algebra) -> Pr.isEquiv (F.obj A) (G.obj A) (R.Transform[F,G].at alpha A)) ;
forward {F G : R.SetFunctor} (e : NaturalEquivalence F G) : R.Transform[F,G].Nat = e.1 ;
equiv-at {F G : R.SetFunctor} (e : NaturalEquivalence F G) (A : BP.Algebra) : Pr.isEquiv (F.obj A) (G.obj A) (R.Transform[F,G].at (forward e) A) = e.2 A ;
module Inverse (F G : R.SetFunctor) (e : NaturalEquivalence F G) {
 module FG = R.Transform[F,G] ;
 module GF = R.Transform[G,F] ;
 inverse-map (A : BP.Algebra) : G.obj A -> F.obj A = (equiv-at e A).sec ;
 natural (A B : BP.Algebra) (h : BP.Hom A B) (y : G.obj A) :
  Id (F.obj B) (inverse-map B (G.reindex A B h y)) (F.reindex A B h (inverse-map A y)) =
  Iso[l].injective (F.obj B) (G.obj B) (FG.at (forward e) B) (equiv-at e B)
   (inverse-map B (G.reindex A B h y)) (F.reindex A B h (inverse-map A y))
   (trans ((equiv-at e B).sec-eq (G.reindex A B h y))
    (sym (trans (FG.natural (forward e) A B h (inverse-map A y)) (ap (G.reindex A B h) ((equiv-at e A).sec-eq y))))) ;
 inverse : GF.Nat = (inverse-map,natural) ;
 left-at (A : BP.Algebra) (x : F.obj A) : Id (F.obj A) (GF.at inverse A (FG.at (forward e) A x)) x =
  Pr.sec-ret (F.obj A) (G.obj A) (FG.at (forward e) A) (equiv-at e A) x ;
 right-at (A : BP.Algebra) (y : G.obj A) : Id (G.obj A) (FG.at (forward e) A (GF.at inverse A y)) y =
  (equiv-at e A).sec-eq y ;
 inverse-equiv : NaturalEquivalence G F =
  (inverse,\ A -> Pr.qinv (G.obj A) (F.obj A) (inverse-map A) (FG.at (forward e) A)
   (Pr.sec-ret (F.obj A) (G.obj A) (FG.at (forward e) A) (equiv-at e A)) (equiv-at e A).sec-eq) ;
 left : Id (R.Transform[F,F].Nat) R.Composite[F,G,F,inverse,forward e].composite (R.identity F) =
  R.Transform[F,F].ext R.Composite[F,G,F,inverse,forward e].composite (R.identity F)
   (\ A x -> Pr.sec-ret (F.obj A) (G.obj A) (FG.at (forward e) A) (equiv-at e A) x) ;
 right : Id (R.Transform[G,G].Nat) R.Composite[G,F,G,forward e,inverse].composite (R.identity G) =
  R.Transform[G,G].ext R.Composite[G,F,G,forward e,inverse].composite (R.identity G) (\ A y -> (equiv-at e A).sec-eq y) ;
} ;
identity (F : R.SetFunctor) : NaturalEquivalence F F =
 (R.identity F,\ A -> Pr.qinv (F.obj A) (F.obj A) (\ x -> x) (\ x -> x) (\ x -> refl x) (\ x -> refl x)) ;
module Composite (F G H : R.SetFunctor) (e : NaturalEquivalence F G) (d : NaturalEquivalence G H) {
 equivalence : NaturalEquivalence F H =
  (R.Composite[F,G,H,forward d,forward e].composite,\ A ->
   Iso[l].equiv-compose (F.obj A) (G.obj A) (H.obj A) (R.Transform[G,H].at (forward d) A) (R.Transform[F,G].at (forward e) A)
    (equiv-at d A) (equiv-at e A)) ;
} ;

} ;
