-- Geometric opens give compact opens of the functor of points.
-- The classifier of e sends p : Spec A -> X to p*(e).  Naturality is
-- composition of inverse images and ZariskiFunctor.spec-lattice.  Bottom,
-- top, joins and meets are preserved pointwise by p* (transformation ext).
-- Its realisation is h_(X|e).  The forward transformation is postcomposition
-- with the inclusion, lifted into the realisation.  It lands there since
-- the slice universal property says the inverse image of e is top.
-- Conversely, a point with p*(e)=top factors uniquely through the slice;
-- locality is preserved.  factor-cut and restore give the two inverse
-- laws, using point-ext for the realisation and local-map ext for the slice.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module ZF = ZariskiFunctor[l] ;
module T = AffineTests[l] ;
module Over (X : Sp.Space) {
 module F = SF.Geometric[X] ;
 module C = CO.Over[F.functor] ;
 classifier (e : X.lattice.L) : C.Open =
  (\ A p -> DL.hmap (Sp.underlying {T.space A} {X} p).lat e,
   \ A B h p -> ZF.OnMap[A,B,h].spec-lattice (DL.hmap (Sp.underlying {T.space A} {X} p).lat e)) ;
 bottom : Id C.Open (classifier X.lattice.bot) C.bottom =
  C.N.ext (classifier X.lattice.bot) C.bottom (\ A p -> DL.hmap-bot (Sp.underlying {T.space A} {X} p).lat) ;
 whole : Id C.Open (classifier X.lattice.top) C.whole =
  C.N.ext (classifier X.lattice.top) C.whole (\ A p -> DL.hmap-top (Sp.underlying {T.space A} {X} p).lat) ;
 join (u v : X.lattice.L) : Id C.Open (classifier (X.lattice.join u v)) (C.join (classifier u) (classifier v)) =
  C.N.ext (classifier (X.lattice.join u v)) (C.join (classifier u) (classifier v))
   (\ A p -> DL.hmap-join (Sp.underlying {T.space A} {X} p).lat u v) ;
 meet (u v : X.lattice.L) : Id C.Open (classifier (X.lattice.meet u v)) (C.meet (classifier u) (classifier v)) =
  C.N.ext (classifier (X.lattice.meet u v)) (C.meet (classifier u) (classifier v))
   (\ A p -> DL.hmap-meet (Sp.underlying {T.space A} {X} p).lat u v) ;
 module Realisation (e : X.lattice.L) {
  module Sl = Op.At[X,e].Sl ;
  module R = OpenRealisation[l].Over[F.functor,classifier e] ;
  module G = SF.Geometric[Op.space X e] ;
  module At (A : T.Test) {
   module UP = SliceUniversal[l].Over[X.lattice,X.structure,e,(T.space A).lattice,(T.space A).structure.sheaf] ;
   lands (q : Sp.Hom (T.space A) (Op.space X e)) : R.Member A (Sp.compose (T.space A) (Op.space X e) X (Op.inclusion X e) q) =
    UP.Restore[Sp.underlying q].top-e ;
   forward (q : Sp.Hom (T.space A) (Op.space X e)) : R.obj A =
    (Sp.compose (T.space A) (Op.space X e) X (Op.inclusion X e) q,lands q) ;
   module Back (p : R.obj A) {
    module B = UP.Back[Sp.underlying {T.space A} {X} (R.point p),R.member p] ;
    backward : Sp.Hom (T.space A) (Op.space X e) = (B.factor,B.local (T.space A).structure.inv (Sp.is-local {T.space A} {X} (R.point p))) ;
    forward-back : Id (R.obj A) (forward backward) p =
     R.point-ext A (forward backward) p (Sp.ext (T.space A) X
      (Sp.compose (T.space A) (Op.space X e) X (Op.inclusion X e) backward) (R.point p) B.factor-cut) ;
   } ;
   back-forward (q : Sp.Hom (T.space A) (Op.space X e)) : Id (Sp.Hom (T.space A) (Op.space X e)) Back[forward q].backward q =
    Sp.ext (T.space A) (Op.space X e) Back[forward q].backward q UP.Restore[Sp.underlying q].restore ;
  } ;
  module GF = SF.Transform[G.functor,F.functor] ;
  inclusion : GF.Nat = SF.GeometricMaps[Op.space X e,X].from-points (FunctorPoints[l].Maps[Op.space X e,X].induced (Op.inclusion X e)) ;
  module Lift = R.Lift[G.functor,inclusion,\ A q -> At[A].lands q] ;
  equivalence : TestEquivalences[l].NaturalEquivalence G.functor R.functor =
   (Lift.lift,\ A -> Pr.qinv (G.functor.obj A) (R.obj A) (At[A].forward) (\ p -> At[A].Back[p].backward)
    (\ p -> At[A].Back[p].forward-back) At[A].back-forward) ;
 } ;
} ;
