-- Structured identity for spaces, in the ringed (contravariant) order.
-- Over the based path identity system of lattices, decorate L by its
-- locally ringed structures.  A decoration isomorphism over p:L=M is
-- LocalIdentity's isomorphism from p*X to Y.  At refl its total space
-- is contractible, so DecoratedIdentity applies.  The Space record
-- retracts onto these parts.  Thus the structural isomorphism total
-- spaces are contractible, with no univalence assumption on spaces.
-- A structural isomorphism gives a geometric map in the reverse order:
-- by path induction on p, its lattice map is identity, its sharp maps
-- are the ring isomorphisms, and naturality is their compatibility.
-- Iso.Local supplies locality.  SpaceIsoIdentity will relate this
-- structural isomorphism to every actual geometric isomorphism.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module DL = DistLattice[l] ;
module SP = Spaces[l] ;
module RI = RingIdentity[l] ;
module RM = RingMaps[l] ;
based (L : DL.DLat) : FunExtUA[l+].isContr ((M : DL.DLat) * Id DL.DLat L M) =
 ((L,refl L),\ w -> idJ DL.DLat L (\ M p -> Id ((N : DL.DLat) * Id DL.DLat L N) (L,refl L) (M,p)) (refl (L,refl L)) w.1 w.2) ;
Structures (L : DL.DLat) : U l+ = LocallyRinged[l].On[L].LocallyRinged ;
move (L M : DL.DLat) (p : Id DL.DLat L M) (X : Structures L) : Structures M = Hi.subst DL.DLat Structures L M p X ;
module B = DecoratedIdentity[l+].Over[DL.DLat,\ L M -> Id DL.DLat L M,\ L -> refl L,based] ;
module S = B.Data[Structures,\ L M X Y p -> LocalIdentity[l].Over[M].LIso (move L M p X) Y,
 \ L X -> LocalIdentity[l].Over[L].id-iso X,\ L X -> LocalIdentity[l].Over[L].total-contr X] ;
fields (X : SP.Space) : S.Obj = (X.lattice,X.structure) ;
make (x : S.Obj) : SP.Space = new SP.Space[x.1,x.2] ;
RIso (X Y : SP.Space) : U l+ = S.Rel (fields X) (fields Y) ;
id-iso (X : SP.Space) : RIso X X = S.identity (fields X) ;
Total (X : SP.Space) : U l+ = (Y : SP.Space) * RIso X Y ;
back (X : SP.Space) : (Y : SP.Space) (e : RIso X Y) -> Id (Total X) (make (fields Y),e) (Y,e) = split {
 Space L str -> \ e -> refl (new SP.Space[L,str],e) } ;
total-contr (X : SP.Space) : FunExtUA[l+].isContr (Total X) =
 SipGeneric[l+].ctr-retract (S.Total (fields X)) (Total X) (S.total-contr (fields X))
  (\ w -> (fields w.1,w.2)) (\ w -> (make w.1,w.2)) (\ w -> back X w.1 w.2) ;
opaque total-contr ;
module Fd = SipGeneric[l+].Fundamental[SP.Space,RIso,id-iso,total-contr] ;
module Fixed (L : DL.DLat) (X Y : Structures L) (e : LocalIdentity[l].Over[L].LIso X Y) {
 module PI = PresheafIdentity[l].Over[L] ;
 module MP = LocallyRinged[l].Maps[L,L,X.sheaf,Y.sheaf] ;
 module GO = RingedLattice[l].On[L].Of[Y.sheaf] ;
 sharp (u : L.L) : RingHom[l].Hom (X.sheaf.ring u) (Y.sheaf.ring u) =
  RI.hom (X.sheaf.ring u,X.sheaf.ring-set u) (Y.sheaf.ring u,Y.sheaf.ring-set u) (e.1 u) ;
 natural (u v : L.L) (k : DL.Order[L].Le u v) (s : (X.sheaf.ring v).R) : Id (Y.sheaf.ring u).R
  (GO.restrict u v (DL.JoinMaps[L,L,DL.identity L].monotone u v k) (RM.map (sharp v) s))
  (RM.map (sharp u) (RingMaps[l].map (X.sheaf.res u v k) s)) =
  trans (GO.res-irr u v (DL.JoinMaps[L,L,DL.identity L].monotone u v k) k (RM.map (sharp v) s)) (sym (e.2 u v k s)) ;
 ringed : MP.Ringed = new MP.Ringed[DL.identity L,sharp,natural] ;
 iso : Iso[l].Maps[L,L,X.sheaf,Y.sheaf].IsIso ringed =
  ((Pr.idEquiv L.L).2,\ u -> (e.1 u).1.2) ;
 local : MP.Of[ringed,X.inv,Y.inv].IsLocal = Iso[l].Maps[L,L,X.sheaf,Y.sheaf].Local[ringed,iso,X.inv,Y.inv].local ;
} ;
module OnLattices (L : DL.DLat) (X : Structures L) {
 ringed : (M : DL.DLat) (p : Id DL.DLat L M) (Y : Structures M)
  (e : LocalIdentity[l].Over[M].LIso (move L M p X) Y) -> LocallyRinged[l].Maps[L,M,X.sheaf,Y.sheaf].Ringed =
  \ M p -> idJ DL.DLat L
   (\ N q -> (Y : Structures N) (e : LocalIdentity[l].Over[N].LIso (move L N q X) Y) -> LocallyRinged[l].Maps[L,N,X.sheaf,Y.sheaf].Ringed)
   (\ Y e -> Fixed[L,X,Y,e].ringed) M p ;
 iso : (M : DL.DLat) (p : Id DL.DLat L M) (Y : Structures M) (e : LocalIdentity[l].Over[M].LIso (move L M p X) Y) ->
  Iso[l].Maps[L,M,X.sheaf,Y.sheaf].IsIso (ringed M p Y e) =
  \ M p -> idJ DL.DLat L
   (\ N q -> (Y : Structures N) (e : LocalIdentity[l].Over[N].LIso (move L N q X) Y) -> Iso[l].Maps[L,N,X.sheaf,Y.sheaf].IsIso (ringed N q Y e))
   (\ Y e -> Fixed[L,X,Y,e].iso) M p ;
} ;
ringed (X Y : SP.Space) (e : RIso X Y) : LocallyRinged[l].Maps[X.lattice,Y.lattice,X.structure.sheaf,Y.structure.sheaf].Ringed =
 OnLattices[X.lattice,X.structure].ringed Y.lattice e.1 Y.structure e.2 ;
iso (X Y : SP.Space) (e : RIso X Y) : Iso[l].Maps[X.lattice,Y.lattice,X.structure.sheaf,Y.structure.sheaf].IsIso (ringed X Y e) =
 OnLattices[X.lattice,X.structure].iso Y.lattice e.1 Y.structure e.2 ;
morphism (X Y : SP.Space) (e : RIso X Y) : SP.Hom Y X =
 (ringed X Y e,Iso[l].Maps[X.lattice,Y.lattice,X.structure.sheaf,Y.structure.sheaf].Local[ringed X Y e,iso X Y e,X.structure.inv,Y.structure.inv].local) ;
