-- Extend an identity system by structure on its objects.
-- First induct on a base isomorphism.  At the identity, the total space
-- of compatible decorations is contractible by hypothesis.  Mapping its
-- contraction into the whole total space gives contractibility there.
-- The property instance has no additional isomorphism data: a subtype
-- through a point of a contractible total space is contractible.
level l ; open Base ; open Prelude[l] ;
module G = SipGeneric[l] ;
module CL = FunExtUA[l] ;
module Over (C : U l) (I : C -> C -> U l) (idI : (x : C) -> I x x)
 (tc : (x : C) -> CL.isContr ((y : C) * I x y)) {
 module Fd = G.Fundamental[C,I,idI,tc] ;
 module Data (S : C -> U l)
  (H : (x y : C) -> S x -> S y -> I x y -> U l)
  (rho : (x : C) (s : S x) -> H x x s s (idI x))
  (unit : (x : C) (s : S x) -> CL.isContr ((t : S x) * H x x s t (idI x))) {
  Obj : U l = (x : C) * S x ;
  Rel (a b : Obj) : U l = (e : I a.1 b.1) * H a.1 b.1 a.2 b.2 e ;
  identity (a : Obj) : Rel a a = (idI a.1,rho a.1 a.2) ;
  Total (a : Obj) : U l = (b : Obj) * Rel a b ;
  module At (x : C) (s : S x) {
   Mot (y : C) (e : I x y) : U l = (t : S y) (h : H x y s t e) ->
    Id (Total (x,s)) ((x,s),identity (x,s)) ((y,t),(e,h)) ;
   base : Mot x (idI x) = \ t h -> ap ((u : S x) * H x x s u (idI x)) (Total (x,s))
    (\ w -> ((x,w.1),(idI x,w.2))) (s,rho x s) (t,h)
    (CL.pathC ((u : S x) * H x x s u (idI x)) (unit x s) (s,rho x s) (t,h)) ;
   induction (y : C) (e : I x y) : Mot y e = Fd.iso-ind x (\ y e -> Mot y e) base y e ;
  } ;
  total-contr (a : Obj) : CL.isContr (Total a) =
   ((a,identity a),\ w -> At[a.1,a.2].induction w.1.1 w.2.1 w.1.2 w.2.2) ;
  opaque total-contr ;
  module Identity = G.Fundamental[Obj,Rel,identity,total-contr] ;
 } ;
 module Property (P : C -> U l) (pP : (x : C) -> isProp (P x)) {
  Obj : U l = (x : C) * P x ;
  Rel (a b : Obj) : U l = I a.1 b.1 ;
  identity (a : Obj) : Rel a a = idI a.1 ;
  Total (a : Obj) : U l = (b : Obj) * Rel a b ;
  total-contr (a : Obj) : CL.isContr (Total a) =
   G.ctr-retract ((w : (y : C) * I a.1 y) * P w.1) (Total a)
    (G.ctr-sub ((y : C) * I a.1 y) (\ w -> P w.1) (tc a.1) (\ w -> pP w.1) (a.1,idI a.1) a.2)
    (\ w -> ((w.1.1,w.2),w.1.2)) (\ w -> ((w.1.1,w.2),w.1.2)) (\ w -> refl w) ;
  opaque total-contr ;
  module Identity = G.Fundamental[Obj,Rel,identity,total-contr] ;
 } ;
} ;
