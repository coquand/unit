-- The localisation chart on basic opens (Serre, Section 4).
-- Spec(A->A_g) sends D(a) to D(inclusion(a)), by the global support
-- equation. Factoring through the slice sends its cut basic open there.
-- The checked inverse chart equations then send D(inclusion(a)) back
-- to the cut D(a) meet D(g), whose underlying open is D(g*a).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (g : A.R) {
 module Cht = SpecBasicOpen[l].Over[A,setA,g] ;
 module ZA = Cht.ZA ; module ZB = Cht.ZG ; module S = Cht.Sl ;
 module Support = ZA.Sup.Of[ZA.D,ZA.support] ;
 module Tr = Truncation[l] ;
 module Br = Bridge[l].Over[A,g] ;
 module BS = ZB.Sup.Of[ZB.D,ZB.support] ;
 test : AffineTests[l].Test = new AffineTests[l].Test[Cht.SA.Loc g,Cht.SA.set g] ;
 module Units = ZariskiUnits[l].Over[test] ;
 coefficient (a : A.R) : (Cht.SA.Loc g).R = RingMaps[l].map (Cht.SA.inclusion g) a ;
 spec-basic (a : A.R) : Id ZB.lattice.L (DL.hmap Cht.J.morphism.lat (ZA.D a)) (ZB.D (coefficient a)) =
  trans (Cht.JM.SM.pi-D a)
   (trans (ap (Cht.JM.SM.LX.d ZB.lattice.top) (Cht.J.phi-map a)) (Cht.J.GA.d-global (coefficient a))) ;
 j-cut-basic (a : A.R) : Id ZB.lattice.L
  (DL.hmap Cht.JB.factor.lat (S.cut (ZA.D a))) (ZB.D (coefficient a)) =
  trans (sym (Cht.JB.lat-cut (ZA.D a))) (spec-basic a) ;
 k-j (u : S.Opens) : Id S.Opens
  (DL.hmap Cht.KM.morphism.lat (DL.hmap Cht.JB.factor.lat u)) u =
  ap (\ m -> DL.hmap m.lat u) Cht.kj ;
 j-k (u : ZB.lattice.L) : Id ZB.lattice.L
  (DL.hmap Cht.JB.factor.lat (DL.hmap Cht.KM.morphism.lat u)) u =
  ap (\ m -> DL.hmap m.lat u) Cht.jk ;
 k-basic (a : A.R) : Id S.Opens
  (DL.hmap Cht.KM.morphism.lat (ZB.D (coefficient a))) (S.cut (ZA.D a)) =
  trans (ap (DL.hmap Cht.KM.morphism.lat) (sym (j-cut-basic a))) (k-j (S.cut (ZA.D a))) ;
 cut-underlying (a : A.R) : Id ZA.lattice.L (S.inc (S.cut (ZA.D a))) (ZA.lattice.meet (ZA.D a) (ZA.D g)) =
  refl (ZA.lattice.meet (ZA.D a) (ZA.D g)) ;
 k-basic-underlying (a : A.R) : Id ZA.lattice.L
  (S.inc (DL.hmap Cht.KM.morphism.lat (ZB.D (coefficient a)))) (ZA.D (A.mul g a)) =
  trans (ap S.inc (k-basic a))
   (trans (cut-underlying a) (trans (ZA.lattice.meetC (ZA.D a) (ZA.D g)) (sym (Support.at-mul g a)))) ;
 basic-fraction (b : (Cht.SA.Loc g).R)
  (rep : Br.LocH.Fraction (Cht.SA.Loc g) (Cht.SA.inclusion g) b) :
  Id ZB.lattice.L (ZB.D b) (ZB.D (coefficient (Br.LocH.num rep))) =
  trans (sym (ZB.O.top-meet (ZB.D b)))
   (trans (ap (\ u -> ZB.lattice.meet u (ZB.D b))
    (sym (Units.At[coefficient (Br.LocH.den rep)].from-unit
     (Br.LocH.inverts (Cht.SA.elementary g) (Br.LocH.den rep) (Br.LocH.den-in rep)))))
    (trans (sym (BS.at-mul (coefficient (Br.LocH.den rep)) b)) (ap ZB.D (Br.LocH.eqn rep)))) ;
 BasicRepresentative (b : (Cht.SA.Loc g).R) : U l =
  (a : A.R) * Id ZB.lattice.L (ZB.D b) (ZB.D (coefficient a)) ;
 basic-represented (b : (Cht.SA.Loc g).R) : Tr.Trunc[BasicRepresentative b].carrier =
  Tr.Trunc[Br.LocH.Fraction (Cht.SA.Loc g) (Cht.SA.inclusion g) b].induction @l
   (\ t -> Tr.Trunc[BasicRepresentative b].carrier) (\ t -> Tr.Trunc[BasicRepresentative b].proposition)
   (\ rep -> Tr.Trunc[BasicRepresentative b].inc (Br.LocH.num rep,basic-fraction b rep))
   (Br.LocH.fractions (Cht.SA.elementary g) b) ;
 join-cong : (n : Nat) (us vs : Fin n -> ZB.lattice.L) ->
  ((i : Fin n) -> Id ZB.lattice.L (us i) (vs i)) -> Id ZB.lattice.L (ZB.J.bigJ n us) (ZB.J.bigJ n vs) = split {
  zero -> \ us vs eq -> refl ZB.lattice.bot ;
  suc n | ih -> \ us vs eq -> cong2 ZB.lattice.L ZB.lattice.join _ _ _ _ (eq (inr tt))
   (ih (\ i -> us (inl i)) (\ i -> vs (inl i)) (\ i -> eq (inl i))) } ;
 Presentation (u : ZB.lattice.L) : U l =
  (n : Nat) * (as : Fin n -> A.R) * Id ZB.lattice.L u (ZB.J.bigJ n (\ i -> ZB.D (coefficient (as i)))) ;
 module Presented (u : ZB.lattice.L) (p : ZB.Presentation u) {
  module RadicalB = Radical[l].Over[Cht.SA.Loc g] ;
  count : Nat = RadicalB.size (ZB.generators p) ;
  module From (rs : (i : Fin count) -> BasicRepresentative (RadicalB.gen (ZB.generators p) i)) {
   presentation : Presentation u = (count,\ i -> (rs i).1,
    trans (ZB.presents p) (join-cong count
     (\ i -> ZB.D (RadicalB.gen (ZB.generators p) i)) (\ i -> ZB.D (coefficient (rs i).1)) (\ i -> (rs i).2))) ;
  } ;
  presentation : Tr.Trunc[Presentation u].carrier =
   Tr.Trunc[(i : Fin count) -> BasicRepresentative (RadicalB.gen (ZB.generators p) i)].induction @l
    (\ t -> Tr.Trunc[Presentation u].carrier) (\ t -> Tr.Trunc[Presentation u].proposition)
    (\ rs -> Tr.Trunc[Presentation u].inc From[rs].presentation)
    (AffineFinite[l].choice count (\ i -> BasicRepresentative (RadicalB.gen (ZB.generators p) i))
     (\ i -> basic-represented (RadicalB.gen (ZB.generators p) i))) ;
 } ;
 presented (u : ZB.lattice.L) : Tr.Trunc[Presentation u].carrier =
  Tr.Trunc[ZB.Presentation u].induction @l (\ t -> Tr.Trunc[Presentation u].carrier)
   (\ t -> Tr.Trunc[Presentation u].proposition) (\ p -> Presented[u,p].presentation) (ZB.presented u) ;
} ;
