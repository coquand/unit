-- Membership in a compact open after localisation.
-- For x in F(B), a compact open U and D(g)<=U_B(x), the localised x
-- belongs to U.  Naturality identifies its U-value with beta_g*(U_B(x));
-- LocalisationTests supplies the equation to top.  More generally any
-- ring map that sends D(g) to top sends an open above D(g) to top.
-- These lemmas name the local membership steps used in compact descent.
level l ; open Ring[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module ZF = ZariskiFunctor[l] ;
module RH = RingHom[l] ;
module Over (F : SF.SetFunctor) (u : CO.Over[F].Open) {
 module C = CO.Over[F] ;
 module R = OpenRealisation[l].Over[F,u] ;
 module Along (B C' : T.Test) (h : RH.Hom B.ring C'.ring) (x : F.obj B) {
  module Z = T.At[B].Z ;
  module M = ZF.OnMap[B,C',h] ;
  member (g : B.ring.R) (below : Z.O.Le (Z.D g) (C.value u B x))
   (basic-top : Id M.ZB.lattice.L (ZF.functor.reindex B C' h (Z.D g)) M.ZB.lattice.top) :
   R.Member C' (F.reindex B C' h x) =
   trans (C.N.natural u B C' h x)
    (M.ZB.O.le-antisym _ _ (M.ZB.O.le-top _)
     (M.ZB.O.le-trans _ _ _ (M.ZB.O.le-of-eq _ _ (sym basic-top))
      (DL.JoinMaps[Z.lattice,M.ZB.lattice,M.lattice-map].monotone (Z.D g) (C.value u B x) below))) ;
 } ;
 module Basic (B : T.Test) (x : F.obj B) (g : B.ring.R)
  (below : T.At[B].Z.O.Le (T.At[B].Z.D g) (C.value u B x)) {
  module L = LocalisationTests[l].At[B,g] ;
  member : R.Member (T.localised B g) (F.reindex B (T.localised B g) (L.A.inclusion g) x) =
   trans (C.N.natural u B (T.localised B g) (L.A.inclusion g) x) (L.forward (C.value u B x) below) ;
  point : R.obj (T.localised B g) = (F.reindex B (T.localised B g) (L.A.inclusion g) x,member) ;
 } ;
} ;
