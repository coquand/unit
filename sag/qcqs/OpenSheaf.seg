-- Realisations of compact opens of Zariski sheaves are sheaves.
-- Forget membership in a compatible family on a basic cover, and glue
-- its underlying values in F.  Its amalgam x belongs to U: after each
-- localisation U(x) equals top, by naturality, the matching equation and
-- the original membership proof.  ZariskiSeparated gives U(x)=top.
-- Pair x with this membership.  Matching follows by point-ext.  Any other
-- amalgam forgets to an F-amalgam of the same family; uniqueness in F and
-- point-ext identify it with the constructed one.  Matching proofs are
-- propositions.  Empty covers are included without a separate argument.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module TS = TestSheaves[l] ;
module ZF = ZariskiFunctor[l] ;
module DL = DistLattice[l] ;
module Over (F : SF.SetFunctor) (u : CO.Over[F].Open) (sheaf : TS.IsSheaf F) {
 module C = CO.Over[F] ;
 module R = OpenRealisation[l].Over[F,u] ;
 module OnCover (c : TS.CoverData) {
  module D = TS.OnCover[F,c].D ;
  module CF = D.For[F] ;
  module CR = D.For[R.functor] ;
  module Family (xs : CR.Values) (compatible : CR.Compatible xs) {
   ys : CF.Values = \ i -> R.point (xs i) ;
   compatible-F : CF.Compatible ys = \ i j -> ap (R.point {D.double i j}) (compatible i j) ;
   amalgams : Localisation[l].isContr (CF.Amalgam ys) = sheaf c ys compatible-F ;
   value : F.obj (TS.base c) = amalgams.1.1 ;
   matches (i : Fin (TS.count c)) : Id (F.obj (D.basic i)) (F.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) value) (ys i) =
    amalgams.1.2 i ;
   local-member (i : Fin (TS.count c)) : Id (ZF.functor.obj (D.basic i))
    (ZF.functor.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) (C.value u (TS.base c) value))
    (ZF.functor.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) ZariskiLattice[l].Over[(TS.base c).ring].lattice.top) =
    trans (sym (C.N.natural u (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) value))
     (trans (ap (C.value u (D.basic i)) (matches i))
      (trans (R.member (xs i)) (sym (DL.hmap-top ZF.OnMap[TS.base c,D.basic i,D.AB.inclusion (TS.generators c i)].lattice-map)))) ;
   member : R.Member (TS.base c) value =
    ZariskiSeparated[l].Over[c].separated (C.value u (TS.base c) value) ZariskiLattice[l].Over[(TS.base c).ring].lattice.top local-member ;
   point : R.obj (TS.base c) = (value,member) ;
   matching : CR.Matches xs point = \ i -> R.point-ext (D.basic i) (R.reindex (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) point) (xs i) (matches i) ;
   amalgam : CR.Amalgam xs = (point,matching) ;
   candidate (p : CR.Amalgam xs) : CF.Amalgam ys = (R.point p.1,\ i -> ap (R.point {D.basic i}) (p.2 i)) ;
   unique (p : CR.Amalgam xs) : Id (CR.Amalgam xs) amalgam p =
    Pr.Sigma-eq (R.obj (TS.base c)) (CR.Matches xs) point p.1 matching p.2
     (R.point-ext (TS.base c) point p.1 (ap (\ a -> a.1) (amalgams.2 (candidate p)))) (CR.matches-prop xs p.1) ;
   gluing : Localisation[l].isContr (CR.Amalgam xs) = (amalgam,unique) ;
  } ;
 } ;
 is-sheaf : TS.IsSheaf R.functor = \ c xs k -> OnCover[c].Family[xs,k].gluing ;
} ;
