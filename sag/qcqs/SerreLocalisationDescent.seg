-- Pure descent of canonical localisation (Serre note, Theorem 4.4).
-- Let u_i be a finite cover of X, M a module sheaf and g in A = O(1).
-- Suppose lambda is an equivalence on every u_i and every u_i /\ u_j, at
-- the restrictions of g. Then lambda_(1,g) : M(1)_g -> M(D g) is one.
-- Proof. Regard everything as A-modules by restriction of scalars.
--  Source: the sheaf equaliser M(1) -> prod M(u_i) -> prod M(u_i /\ u_j)
--   (SerreSectionLocalisationSheafDiagram), injective and exact.
--  Target: M(D g) -> prod M(v_i) -> prod M(v_ij), with v_i = D_(u_i)(g|)
--   and v_ij = D_(u_i /\ u_j)(g|). By the restriction law of invertibility
--   opens v_i = u_i /\ D g and v_ij = u_i /\ u_j /\ D g; so v_ij <= v_i, v_j
--   and the v_i cover D g. The first map takes restrictions, the second
--   the difference of the restrictions; it is injective by separation and
--   the composite is zero by the composition law of restriction.
--  Comparisons: the extensions alpha, beta of the restrictions
--   prod M(u_i) -> prod M(v_i) and prod M(u_ij) -> prod M(v_ij). The member
--   and overlap lambdas are equivalences, so the restrictions clear and
--   kill at g (SerreLambdaClearing, over A); hence so do the finite
--   products (SerreLambdaElementaryOps.Product), and alpha, beta are
--   equivalences (SerreLambdaElementary.Lift). g acts invertibly on the
--   targets since g| is a unit on each v.
--  Squares: both composites clear g^p on x/g^p to the same restriction,
--   by the composition law of restriction (SerreLambdaElementary.Agree).
--  The finite-equaliser descent (SerreSectionLocalisationFiniteEqualiser)
--  makes the unique extension of M(1) -> M(D g) an equivalence; it is the
--  canonical lambda by uniqueness. Empty covers are included.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module MS = SerreModuleSheaf[l] ; module MP = SerreModuleProducts[l] ;
module EL = SerreLambdaElementary[l] ; module Ops = SerreLambdaElementaryOps[l] ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (n : Nat) (us : Fin n -> L.L)
 (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n us)) (g : (X.sheaf.ring L.top).R)
 (members : (i : Fin n) -> SerreLambda[l].On[L,X,M,us i].At[
   RM.map (X.sheaf.res (us i) L.top (DL.Order[L].le-top (us i))) g].IsEquivalence)
 (overlaps : (i j : Fin n) -> SerreLambda[l].On[L,X,M,L.meet (us i) (us j)].At[
   RM.map (X.sheaf.res (L.meet (us i) (us j)) L.top (DL.Order[L].le-top (L.meet (us i) (us j)))) g].IsEquivalence) {
 module O = DL.Order[L] ; module J = DL.Joins[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module IX = InvOpen[l].On[L].Of[X.sheaf] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 A : CRing = X.sheaf.ring L.top ;
 -- g restricted to an open
 restricted (a : L.L) : (X.sheaf.ring a).R = RM.map (X.sheaf.res a L.top (O.le-top a)) g ;
 -- the canonical lambda at the top, and D g
 module C = SerreSectionLocalisationMap[l].On[L,X,M].At[g] ;
 Dg : L.L = C.open-f ;
 -- every v <= D g with v <= top carries the A-action through restriction
 down (v : L.L) (a : A.R) : (X.sheaf.ring v).R = GO.restrict v L.top (O.le-top v) a ;
 -- v /\ D g is the invertibility open of g|v
 meet-eq (v : L.L) : Id L.L (LX.d v (restricted v)) (L.meet v Dg) =
  IX.Restrict[L.top,v,O.le-top v,g,Dg,LX.d-open L.top g].restrict-eq (LX.d v (restricted v)) (LX.d-open v (restricted v)) ;
 -- the source sheaf equaliser over A
 module SD = SerreSectionLocalisationSheafDiagram[l].Over[L,X.sheaf,M,L.top,n,us,\ i -> O.le-top (us i),covers] ;
 module Member (i : Fin n) {
  module Cl = SerreLambdaClearing[l].On[L,X,M,us i,restricted (us i)] ;
  module SR = SerreLambda[l].On[L,X,M,us i].R ;
  open-v : L.L = Cl.Lam.open-g ;
  phi : RH.Hom A (X.sheaf.ring (us i)) = X.sheaf.res (us i) L.top (O.le-top (us i)) ;
  module Al = Cl.Along[A,phi,g,refl (restricted (us i))] ;
  module R = Al.Restricted[members i] ;
  target : SM.Over[A].Module = Al.R.RNd.restricted ;
  below : O.Le open-v Dg = O.le-trans open-v (L.meet (us i) Dg) Dg (O.le-of-eq _ _ (meet-eq (us i))) (O.meet-right (us i) Dg) ;
  -- the A-action on M(v_i) is restriction from the top
  scalar (a : A.R) (y : (M.presheaf.module-at open-v).M) :
   Id (M.presheaf.module-at open-v).M (target.sm a y) ((M.presheaf.module-at open-v).sm (down open-v a) y) =
   ap (\ c -> (M.presheaf.module-at open-v).sm c y)
    (X.sheaf.res-comp open-v (us i) L.top Cl.Lam.below (O.le-top (us i)) (O.le-top open-v) a) ;
  invertible : Pr.isEquiv target.M target.M (target.sm g) = Cl.C.invertible ;
 } ;
 module Pair (i j : Fin n) {
  module P = SD.Pair[i,j] ;
  module Cl = SerreLambdaClearing[l].On[L,X,M,P.overlap,restricted P.overlap] ;
  module SR = SerreLambda[l].On[L,X,M,P.overlap].R ;
  open-v : L.L = Cl.Lam.open-g ;
  phi : RH.Hom A (X.sheaf.ring P.overlap) = X.sheaf.res P.overlap L.top P.below-a ;
  image : Id (X.sheaf.ring P.overlap).R (RM.map phi g) (restricted P.overlap) = GO.res-irr P.overlap L.top P.below-a (O.le-top P.overlap) g ;
  module Al = Cl.Along[A,phi,g,image] ;
  module R = Al.Restricted[overlaps i j] ;
  target : SM.Over[A].Module = Al.R.RNd.restricted ;
  scalar (a : A.R) (y : (M.presheaf.module-at open-v).M) :
   Id (M.presheaf.module-at open-v).M (target.sm a y) ((M.presheaf.module-at open-v).sm (down open-v a) y) =
   ap (\ c -> (M.presheaf.module-at open-v).sm c y)
    (X.sheaf.res-comp open-v P.overlap L.top Cl.Lam.below P.below-a (O.le-top open-v) a) ;
  invertible : Pr.isEquiv target.M target.M (target.sm g) =
   Iso[l].equiv-homotopy target.M target.M (Cl.C.Scalars.restricted.sm (restricted P.overlap)) (target.sm g)
    (\ y -> ap (\ c -> Cl.C.Scalars.restricted.sm c y) (sym image)) Cl.C.invertible ;
  -- v_ij lies below v_i and v_j
  as-meet : O.Le open-v (L.meet P.overlap Dg) = O.le-of-eq _ _ (meet-eq P.overlap) ;
  left-le : O.Le open-v Member[i].open-v =
   O.le-trans open-v (L.meet P.overlap Dg) Member[i].open-v as-meet
    (O.le-trans (L.meet P.overlap Dg) (L.meet (us i) Dg) Member[i].open-v
     (O.meet-mono P.overlap Dg (us i) Dg (O.meet-left (us i) (us j)) (O.le-refl Dg))
     (O.le-of-eq _ _ (sym (meet-eq (us i))))) ;
  right-le : O.Le open-v Member[j].open-v =
   O.le-trans open-v (L.meet P.overlap Dg) Member[j].open-v as-meet
    (O.le-trans (L.meet P.overlap Dg) (L.meet (us j) Dg) Member[j].open-v
     (O.meet-mono P.overlap Dg (us j) Dg (O.meet-right (us i) (us j)) (O.le-refl Dg))
     (O.le-of-eq _ _ (sym (meet-eq (us j))))) ;
  module Laws = SM.Over[X.sheaf.ring open-v].Laws[M.presheaf.module-at open-v] ;
  module OverlapLaws = SM.Over[X.sheaf.ring P.overlap].Laws[M.presheaf.module-at P.overlap] ;
  module Group = SerreCechAlgebra[l].Over[X.sheaf.ring open-v,M.presheaf.module-at open-v] ;
 } ;
 -- the target diagram over A
 module Members = MP.Over[A,Fin n,\ i -> Member[i].target] ;
 module Overlaps = MP.Over[A,Fin n * Fin n,\ ij -> Pair[ij.1,ij.2].target] ;
 N : SM.Over[A].Module = C.Scalars.restricted ;
 N-scalar (a : A.R) (y : (M.presheaf.module-at Dg).M) :
  Id (M.presheaf.module-at Dg).M (N.sm a y) ((M.presheaf.module-at Dg).sm (down Dg a) y) =
  trans (C.Scalars.scalar-at a y)
   (ap (\ c -> (M.presheaf.module-at Dg).sm c y) (GO.res-irr Dg L.top C.below (O.le-top Dg) a)) ;
 first-map (y : (M.presheaf.module-at Dg).M) : Members.Carrier = \ i -> MO.restrict Member[i].open-v Dg Member[i].below y ;
 first-scale (a : A.R) (y : (M.presheaf.module-at Dg).M) (i : Fin n) :
  Id (M.presheaf.module-at Member[i].open-v).M (first-map (N.sm a y) i) (Member[i].target.sm a (first-map y i)) =
  calc (M.presheaf.module-at Member[i].open-v).M {
   first-map (N.sm a y) i
    =< ap (MO.restrict Member[i].open-v Dg Member[i].below) (N-scalar a y)
     > MO.restrict Member[i].open-v Dg Member[i].below ((M.presheaf.module-at Dg).sm (down Dg a) y)
    =< MO.res-scale Member[i].open-v Dg Member[i].below (down Dg a) y
     > (M.presheaf.module-at Member[i].open-v).sm (GO.restrict Member[i].open-v Dg Member[i].below (down Dg a)) (first-map y i)
    =< ap (\ c -> (M.presheaf.module-at Member[i].open-v).sm c (first-map y i))
        (X.sheaf.res-comp Member[i].open-v Dg L.top Member[i].below (O.le-top Dg) (O.le-top Member[i].open-v) a)
     > (M.presheaf.module-at Member[i].open-v).sm (down Member[i].open-v a) (first-map y i)
    =< sym (Member[i].scalar a (first-map y i)) > Member[i].target.sm a (first-map y i) } ;
 module First = MM.Between[A,A,RH.identity A,N,Members.product] ;
 first : First.Hom = new First.Hom[first-map,
  \ x y -> Members.ext _ _ (\ i -> MO.res-add Member[i].open-v Dg Member[i].below x y),
  \ a y -> Members.ext _ _ (\ i -> first-scale a y i)] ;
 first-at (y : (M.presheaf.module-at Dg).M) (i : Fin n) :
  Id (M.presheaf.module-at Member[i].open-v).M (First.map first y i) (MO.restrict Member[i].open-v Dg Member[i].below y) =
  refl (MO.restrict Member[i].open-v Dg Member[i].below y) ;
 left-of (i j : Fin n) (y : (M.presheaf.module-at Member[i].open-v).M) : (M.presheaf.module-at Pair[i,j].open-v).M =
  MO.restrict Pair[i,j].open-v Member[i].open-v Pair[i,j].left-le y ;
 right-of (i j : Fin n) (y : (M.presheaf.module-at Member[j].open-v).M) : (M.presheaf.module-at Pair[i,j].open-v).M =
  MO.restrict Pair[i,j].open-v Member[j].open-v Pair[i,j].right-le y ;
 left-scale (i j : Fin n) (a : A.R) (y : (M.presheaf.module-at Member[i].open-v).M) :
  Id (M.presheaf.module-at Pair[i,j].open-v).M (left-of i j (Member[i].target.sm a y)) (Pair[i,j].target.sm a (left-of i j y)) =
  calc (M.presheaf.module-at Pair[i,j].open-v).M {
   left-of i j (Member[i].target.sm a y)
    =< ap (left-of i j) (Member[i].scalar a y) > left-of i j ((M.presheaf.module-at Member[i].open-v).sm (down Member[i].open-v a) y)
    =< MO.res-scale Pair[i,j].open-v Member[i].open-v Pair[i,j].left-le (down Member[i].open-v a) y
     > (M.presheaf.module-at Pair[i,j].open-v).sm (GO.restrict Pair[i,j].open-v Member[i].open-v Pair[i,j].left-le (down Member[i].open-v a)) (left-of i j y)
    =< ap (\ c -> (M.presheaf.module-at Pair[i,j].open-v).sm c (left-of i j y))
        (X.sheaf.res-comp Pair[i,j].open-v Member[i].open-v L.top Pair[i,j].left-le (O.le-top Member[i].open-v) (O.le-top Pair[i,j].open-v) a)
     > (M.presheaf.module-at Pair[i,j].open-v).sm (down Pair[i,j].open-v a) (left-of i j y)
    =< sym (Pair[i,j].scalar a (left-of i j y)) > Pair[i,j].target.sm a (left-of i j y) } ;
 right-scale (i j : Fin n) (a : A.R) (y : (M.presheaf.module-at Member[j].open-v).M) :
  Id (M.presheaf.module-at Pair[i,j].open-v).M (right-of i j (Member[j].target.sm a y)) (Pair[i,j].target.sm a (right-of i j y)) =
  calc (M.presheaf.module-at Pair[i,j].open-v).M {
   right-of i j (Member[j].target.sm a y)
    =< ap (right-of i j) (Member[j].scalar a y) > right-of i j ((M.presheaf.module-at Member[j].open-v).sm (down Member[j].open-v a) y)
    =< MO.res-scale Pair[i,j].open-v Member[j].open-v Pair[i,j].right-le (down Member[j].open-v a) y
     > (M.presheaf.module-at Pair[i,j].open-v).sm (GO.restrict Pair[i,j].open-v Member[j].open-v Pair[i,j].right-le (down Member[j].open-v a)) (right-of i j y)
    =< ap (\ c -> (M.presheaf.module-at Pair[i,j].open-v).sm c (right-of i j y))
        (X.sheaf.res-comp Pair[i,j].open-v Member[j].open-v L.top Pair[i,j].right-le (O.le-top Member[j].open-v) (O.le-top Pair[i,j].open-v) a)
     > (M.presheaf.module-at Pair[i,j].open-v).sm (down Pair[i,j].open-v a) (right-of i j y)
    =< sym (Pair[i,j].scalar a (right-of i j y)) > Pair[i,j].target.sm a (right-of i j y) } ;
 difference-map (ys : Members.Carrier) : Overlaps.Carrier = \ ij ->
  Pair[ij.1,ij.2].Laws.sub (left-of ij.1 ij.2 (ys ij.1)) (right-of ij.1 ij.2 (ys ij.2)) ;
 module Difference = MM.Between[A,A,RH.identity A,Members.product,Overlaps.product] ;
 difference : Difference.Hom = new Difference.Hom[difference-map,
  \ xs ys -> Overlaps.ext _ _ (\ ij ->
   trans (cong2 (M.presheaf.module-at Pair[ij.1,ij.2].open-v).M Pair[ij.1,ij.2].Laws.sub _ _ _ _
    (MO.res-add Pair[ij.1,ij.2].open-v Member[ij.1].open-v Pair[ij.1,ij.2].left-le (xs ij.1) (ys ij.1))
    (MO.res-add Pair[ij.1,ij.2].open-v Member[ij.2].open-v Pair[ij.1,ij.2].right-le (xs ij.2) (ys ij.2)))
    (Pair[ij.1,ij.2].Group.sub-add (left-of ij.1 ij.2 (xs ij.1)) (left-of ij.1 ij.2 (ys ij.1))
     (right-of ij.1 ij.2 (xs ij.2)) (right-of ij.1 ij.2 (ys ij.2)))),
  \ a xs -> Overlaps.ext _ _ (\ ij ->
   trans (cong2 (M.presheaf.module-at Pair[ij.1,ij.2].open-v).M Pair[ij.1,ij.2].Laws.sub _ _ _ _
    (left-scale ij.1 ij.2 a (xs ij.1)) (right-scale ij.1 ij.2 a (xs ij.2)))
    (trans (cong2 (M.presheaf.module-at Pair[ij.1,ij.2].open-v).M Pair[ij.1,ij.2].Laws.sub _ _ _ _
      (Pair[ij.1,ij.2].scalar a (left-of ij.1 ij.2 (xs ij.1))) (Pair[ij.1,ij.2].scalar a (right-of ij.1 ij.2 (xs ij.2))))
     (trans (sym (Pair[ij.1,ij.2].Laws.sm-sub (down Pair[ij.1,ij.2].open-v a) (left-of ij.1 ij.2 (xs ij.1)) (right-of ij.1 ij.2 (xs ij.2))))
      (sym (Pair[ij.1,ij.2].scalar a (difference-map xs ij))))))] ;
 difference-at (ys : Members.Carrier) (i j : Fin n) :
  Id (M.presheaf.module-at Pair[i,j].open-v).M (Difference.map difference ys (i,j))
   (Pair[i,j].Laws.sub (left-of i j (ys i)) (right-of i j (ys j))) =
  refl (Pair[i,j].Laws.sub (left-of i j (ys i)) (right-of i j (ys j))) ;
 -- the v_i cover D g
 meets-below (i : Fin n) : O.Le (L.meet (us i) Dg) (J.bigJ n (\ i -> Member[i].open-v)) =
  O.le-trans (L.meet (us i) Dg) Member[i].open-v (J.bigJ n (\ i -> Member[i].open-v))
   (O.le-of-eq _ _ (sym (meet-eq (us i)))) (J.below n (\ i -> Member[i].open-v) i) ;
 target-covers : O.Le Dg (J.bigJ n (\ i -> Member[i].open-v)) =
  O.le-trans Dg (L.meet (J.bigJ n us) Dg) (J.bigJ n (\ i -> Member[i].open-v))
   (O.meet-glb (J.bigJ n us) Dg Dg (O.le-trans Dg L.top (J.bigJ n us) (O.le-top Dg) covers) (O.le-refl Dg))
   (O.le-trans (L.meet (J.bigJ n us) Dg) (J.bigJ n (\ i -> L.meet (us i) Dg)) (J.bigJ n (\ i -> Member[i].open-v))
    (J.meet-join-right n us Dg) (J.least n (\ i -> L.meet (us i) Dg) (J.bigJ n (\ i -> Member[i].open-v)) meets-below)) ;
 module TS = SerreSetSheaf[l].On[L].SheafProofs[MO.underlying,M.sheaf].Cover[Dg,n,\ i -> Member[i].open-v,\ i -> Member[i].below,target-covers] ;
 target-injective (x y : N.M) (same : Id Members.Carrier (First.map first x) (First.map first y)) : Id N.M x y =
  TS.separated x y (\ i -> ap (\ z -> z i) same) ;
 target-zero (y : N.M) : Id Overlaps.Carrier (Difference.map difference (First.map first y)) Overlaps.product.mz =
  Overlaps.ext _ _ (\ ij ->
   trans (ap (\ z -> Pair[ij.1,ij.2].Laws.sub z (right-of ij.1 ij.2 (first-map y ij.2)))
    (trans (M.presheaf.res-comp Pair[ij.1,ij.2].open-v Member[ij.1].open-v Dg Pair[ij.1,ij.2].left-le Member[ij.1].below
      (O.le-trans Pair[ij.1,ij.2].open-v Member[ij.1].open-v Dg Pair[ij.1,ij.2].left-le Member[ij.1].below) y)
     (trans (MO.res-irr Pair[ij.1,ij.2].open-v Dg
       (O.le-trans Pair[ij.1,ij.2].open-v Member[ij.1].open-v Dg Pair[ij.1,ij.2].left-le Member[ij.1].below)
       (O.le-trans Pair[ij.1,ij.2].open-v Member[ij.2].open-v Dg Pair[ij.1,ij.2].right-le Member[ij.2].below) y)
      (sym (M.presheaf.res-comp Pair[ij.1,ij.2].open-v Member[ij.2].open-v Dg Pair[ij.1,ij.2].right-le Member[ij.2].below
       (O.le-trans Pair[ij.1,ij.2].open-v Member[ij.2].open-v Dg Pair[ij.1,ij.2].right-le Member[ij.2].below) y)))))
    (Pair[ij.1,ij.2].Laws.sub-self (right-of ij.1 ij.2 (first-map y ij.2)))) ;
 -- the comparisons alpha and beta
 module MemberProduct = Ops.Product[A,Fin n,\ i -> SD.At[i].Scalars.restricted,\ i -> Member[i].target,
  \ i -> Member[i].Al.R.restricted,g,Ops.FinIndex[n].choose,Ops.FinIndex[n].bound,Ops.FinIndex[n].above] ;
 module OverlapProduct = Ops.Product[A,Fin n * Fin n,\ ij -> SD.Pair[ij.1,ij.2].Scalars.restricted,\ ij -> Pair[ij.1,ij.2].target,
  \ ij -> Pair[ij.1,ij.2].Al.R.restricted,g,Ops.FinPairs[n].choose,Ops.FinPairs[n].bound,Ops.FinPairs[n].above] ;
 members-invertible : Pr.isEquiv Members.Carrier Members.Carrier (Members.product.sm g) =
  Ops.ProductInvertible[A,Fin n,\ i -> Member[i].target,g,\ i -> Member[i].invertible].equivalence ;
 overlaps-invertible : Pr.isEquiv Overlaps.Carrier Overlaps.Carrier (Overlaps.product.sm g) =
  Ops.ProductInvertible[A,Fin n * Fin n,\ ij -> Pair[ij.1,ij.2].target,g,\ ij -> Pair[ij.1,ij.2].invertible].equivalence ;
 module Alpha = EL.Lift[A,SD.Members.product,Members.product,MemberProduct.PM.induced,g,members-invertible] ;
 module Beta = EL.Lift[A,SD.Overlaps.product,Overlaps.product,OverlapProduct.PM.induced,g,overlaps-invertible] ;
 alpha-equiv : Pr.isEquiv Alpha.E.S.Carrier Members.Carrier Alpha.map =
  Alpha.equivalence (MemberProduct.clear (\ i -> Member[i].R.clear)) (MemberProduct.kill (\ i -> Member[i].R.kill)) ;
 beta-equiv : Pr.isEquiv Beta.E.S.Carrier Overlaps.Carrier Beta.map =
  Beta.equivalence (OverlapProduct.clear (\ ij -> Pair[ij.1,ij.2].R.clear)) (OverlapProduct.kill (\ ij -> Pair[ij.1,ij.2].R.kill)) ;
 -- the member and overlap comparisons are restrictions, by definition
 member-map (i : Fin n) (z : (M.presheaf.module-at (us i)).M) :
  Id (M.presheaf.module-at Member[i].open-v).M
   (MM.Between[A,A,RH.identity A,SD.At[i].Scalars.restricted,Member[i].target].map Member[i].Al.R.restricted z)
   (MO.restrict Member[i].open-v (us i) Member[i].Cl.Lam.below z) =
  calc (M.presheaf.module-at Member[i].open-v).M {
   MM.Between[A,A,RH.identity A,SD.At[i].Scalars.restricted,Member[i].target].map Member[i].Al.R.restricted z
    =< Member[i].Al.R.restricted-at z > Member[i].Cl.C.Original.map Member[i].Cl.C.original z
    =< Member[i].Cl.C.original-at z > Member[i].SR.RO.restrict Member[i].Cl.C.open-f Member[i].SR.S.lattice.top Member[i].Cl.C.below z
    =< Member[i].SR.restrict-inc Member[i].Cl.C.open-f Member[i].SR.S.lattice.top Member[i].Cl.C.below z
     > MO.restrict Member[i].open-v (us i) Member[i].Cl.Lam.below z } ;
 pair-map (i j : Fin n) (z : (M.presheaf.module-at SD.Pair[i,j].overlap).M) :
  Id (M.presheaf.module-at Pair[i,j].open-v).M
   (MM.Between[A,A,RH.identity A,SD.Pair[i,j].Scalars.restricted,Pair[i,j].target].map Pair[i,j].Al.R.restricted z)
   (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below z) =
  calc (M.presheaf.module-at Pair[i,j].open-v).M {
   MM.Between[A,A,RH.identity A,SD.Pair[i,j].Scalars.restricted,Pair[i,j].target].map Pair[i,j].Al.R.restricted z
    =< Pair[i,j].Al.R.restricted-at z > Pair[i,j].Cl.C.Original.map Pair[i,j].Cl.C.original z
    =< Pair[i,j].Cl.C.original-at z > Pair[i,j].SR.RO.restrict Pair[i,j].Cl.C.open-f Pair[i,j].SR.S.lattice.top Pair[i,j].Cl.C.below z
    =< Pair[i,j].SR.restrict-inc Pair[i,j].Cl.C.open-f Pair[i,j].SR.S.lattice.top Pair[i,j].Cl.C.below z
     > MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below z } ;
 -- the comparison squares commute on original sections
 member-restriction (x : (M.presheaf.module-at L.top).M) (i : Fin n) :
  Id (M.presheaf.module-at Member[i].open-v).M
   (MM.Between[A,A,RH.identity A,SD.At[i].Scalars.restricted,Member[i].target].map Member[i].Al.R.restricted
    (SD.First.map SD.first x i))
   (First.map first (C.Original.map C.original x) i) =
  calc (M.presheaf.module-at Member[i].open-v).M {
   MM.Between[A,A,RH.identity A,SD.At[i].Scalars.restricted,Member[i].target].map Member[i].Al.R.restricted (SD.First.map SD.first x i)
    =< member-map i (SD.First.map SD.first x i)
     > MO.restrict Member[i].open-v (us i) Member[i].Cl.Lam.below (SD.First.map SD.first x i)
    =< ap (MO.restrict Member[i].open-v (us i) Member[i].Cl.Lam.below) (SD.first-at x i)
     > MO.restrict Member[i].open-v (us i) Member[i].Cl.Lam.below (MO.restrict (us i) L.top (O.le-top (us i)) x)
    =< M.presheaf.res-comp Member[i].open-v (us i) L.top Member[i].Cl.Lam.below (O.le-top (us i)) (O.le-top Member[i].open-v) x
     > MO.restrict Member[i].open-v L.top (O.le-top Member[i].open-v) x
    =< sym (M.presheaf.res-comp Member[i].open-v Dg L.top Member[i].below C.below (O.le-top Member[i].open-v) x)
     > MO.restrict Member[i].open-v Dg Member[i].below (MO.restrict Dg L.top C.below x)
    =< ap (MO.restrict Member[i].open-v Dg Member[i].below) (sym (C.original-at x))
     > First.map first (C.Original.map C.original x) i } ;
 members-restriction (x : (M.presheaf.module-at L.top).M) :
  Id Members.Carrier (MemberProduct.EP.H.map MemberProduct.PM.induced (SD.First.map SD.first x)) (First.map first (C.Original.map C.original x)) =
  Members.ext _ _ (\ i -> trans (MemberProduct.PM.induced-at (SD.First.map SD.first x) i) (member-restriction x i)) ;
 module FE = SerreSectionLocalisationFiniteEqualiser[l].Over[A,M.presheaf.module-at L.top,SD.Members.product,SD.Overlaps.product,
  N,Members.product,Overlaps.product,SD.first,SD.difference,first,difference,g] ;
 module FirstPowers = SerreModuleLocalisationMaps[l].Along[A,A,RH.identity A,N,Members.product,first,g] ;
 lambda-clears (x : (M.presheaf.module-at L.top).M) (p : Nat) :
  Id N.M (C.E.T.power p (C.E.To.map C.E.lift (C.E.S.fraction x p))) (C.Original.map C.original x) =
  trans (ap (C.E.T.power p) (trans (C.E.lift-map-at (C.E.S.fraction x p)) (C.E.lift-at x p)))
   (C.E.InverseAction.power-back p (C.Original.map C.original x)) ;
 module Left = EL.Agree[A,M.presheaf.module-at L.top,Members.product,g,members-invertible,
  \ x -> First.map first (C.Original.map C.original x),
  \ z -> Alpha.map (FE.LocalE.Maps.map FE.LocalE.induced z),
  \ z -> First.map first (C.E.To.map C.E.lift z),
  \ x p -> trans (ap (\ w -> Alpha.E.T.power p (Alpha.map w)) (FE.LocalE.induced-at x p))
   (trans (Alpha.clears (SD.First.map SD.first x) p) (members-restriction x)),
  \ x p -> trans (sym (FirstPowers.power-map p (C.E.To.map C.E.lift (C.E.S.fraction x p))))
   (ap (First.map first) (lambda-clears x p))] ;
 through-left (i j : Fin n) (z : (M.presheaf.module-at (us i)).M) :
  Id (M.presheaf.module-at Pair[i,j].open-v).M
   (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].left z))
   (left-of i j (MO.restrict Member[i].open-v (us i) Member[i].Cl.Lam.below z)) =
  trans (M.presheaf.res-comp Pair[i,j].open-v SD.Pair[i,j].overlap (us i) Pair[i,j].Cl.Lam.below
    (O.meet-left (us i) (us j)) (O.le-trans Pair[i,j].open-v Member[i].open-v (us i) Pair[i,j].left-le Member[i].Cl.Lam.below) z)
   (sym (M.presheaf.res-comp Pair[i,j].open-v Member[i].open-v (us i) Pair[i,j].left-le Member[i].Cl.Lam.below
    (O.le-trans Pair[i,j].open-v Member[i].open-v (us i) Pair[i,j].left-le Member[i].Cl.Lam.below) z)) ;
 through-right (i j : Fin n) (z : (M.presheaf.module-at (us j)).M) :
  Id (M.presheaf.module-at Pair[i,j].open-v).M
   (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].right z))
   (right-of i j (MO.restrict Member[j].open-v (us j) Member[j].Cl.Lam.below z)) =
  trans (M.presheaf.res-comp Pair[i,j].open-v SD.Pair[i,j].overlap (us j) Pair[i,j].Cl.Lam.below
    (O.meet-right (us i) (us j)) (O.le-trans Pair[i,j].open-v Member[j].open-v (us j) Pair[i,j].right-le Member[j].Cl.Lam.below) z)
   (sym (M.presheaf.res-comp Pair[i,j].open-v Member[j].open-v (us j) Pair[i,j].right-le Member[j].Cl.Lam.below
    (O.le-trans Pair[i,j].open-v Member[j].open-v (us j) Pair[i,j].right-le Member[j].Cl.Lam.below) z)) ;
 -- the overlap comparison of a difference is the difference of restrictions
 overlap-difference (y : SD.Members.Carrier) (i j : Fin n) :
  Id (M.presheaf.module-at Pair[i,j].open-v).M
   (MM.Between[A,A,RH.identity A,SD.Pair[i,j].Scalars.restricted,Pair[i,j].target].map Pair[i,j].Al.R.restricted
    (SD.Difference.map SD.difference y (i,j)))
   (Pair[i,j].Laws.sub
    (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].left (y i)))
    (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].right (y j)))) =
  calc (M.presheaf.module-at Pair[i,j].open-v).M {
   MM.Between[A,A,RH.identity A,SD.Pair[i,j].Scalars.restricted,Pair[i,j].target].map Pair[i,j].Al.R.restricted
    (SD.Difference.map SD.difference y (i,j))
    =< pair-map i j (SD.Difference.map SD.difference y (i,j))
     > MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Difference.map SD.difference y (i,j))
    =< ap (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below)
        (trans (SD.difference-at y i j)
         (trans (SD.Pair[i,j].Laws.sub-at (SD.Pair[i,j].left (y i)) (SD.Pair[i,j].right (y j)))
          (sym (Pair[i,j].OverlapLaws.sub-at (SD.Pair[i,j].left (y i)) (SD.Pair[i,j].right (y j))))))
     > MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below
        (Pair[i,j].OverlapLaws.sub (SD.Pair[i,j].left (y i)) (SD.Pair[i,j].right (y j)))
    =< MO.res-sub Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].left (y i)) (SD.Pair[i,j].right (y j))
     > Pair[i,j].Laws.sub
        (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].left (y i)))
        (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].right (y j))) } ;
 member-component (y : SD.Members.Carrier) (i : Fin n) :
  Id (M.presheaf.module-at Member[i].open-v).M (MemberProduct.EP.H.map MemberProduct.PM.induced y i)
   (MO.restrict Member[i].open-v (us i) Member[i].Cl.Lam.below (y i)) =
  trans (MemberProduct.PM.induced-at y i) (member-map i (y i)) ;
 overlap-restriction (y : SD.Members.Carrier) (i j : Fin n) :
  Id (M.presheaf.module-at Pair[i,j].open-v).M
   (MM.Between[A,A,RH.identity A,SD.Pair[i,j].Scalars.restricted,Pair[i,j].target].map Pair[i,j].Al.R.restricted
    (SD.Difference.map SD.difference y (i,j)))
   (Difference.map difference (MemberProduct.EP.H.map MemberProduct.PM.induced y) (i,j)) =
  calc (M.presheaf.module-at Pair[i,j].open-v).M {
   MM.Between[A,A,RH.identity A,SD.Pair[i,j].Scalars.restricted,Pair[i,j].target].map Pair[i,j].Al.R.restricted
    (SD.Difference.map SD.difference y (i,j))
    =< overlap-difference y i j
     > Pair[i,j].Laws.sub
        (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].left (y i)))
        (MO.restrict Pair[i,j].open-v SD.Pair[i,j].overlap Pair[i,j].Cl.Lam.below (SD.Pair[i,j].right (y j)))
    =< cong2 (M.presheaf.module-at Pair[i,j].open-v).M Pair[i,j].Laws.sub _ _ _ _
        (trans (through-left i j (y i)) (ap (left-of i j) (sym (member-component y i))))
        (trans (through-right i j (y j)) (ap (right-of i j) (sym (member-component y j))))
     > Pair[i,j].Laws.sub (left-of i j (MemberProduct.EP.H.map MemberProduct.PM.induced y i))
        (right-of i j (MemberProduct.EP.H.map MemberProduct.PM.induced y j))
    =< sym (difference-at (MemberProduct.EP.H.map MemberProduct.PM.induced y) i j)
     > Difference.map difference (MemberProduct.EP.H.map MemberProduct.PM.induced y) (i,j) } ;
 overlaps-restriction (y : SD.Members.Carrier) :
  Id Overlaps.Carrier (OverlapProduct.EP.H.map OverlapProduct.PM.induced (SD.Difference.map SD.difference y))
   (Difference.map difference (MemberProduct.EP.H.map MemberProduct.PM.induced y)) =
  Overlaps.ext _ _ (\ ij -> trans (OverlapProduct.PM.induced-at (SD.Difference.map SD.difference y) ij)
   (overlap-restriction y ij.1 ij.2)) ;
 module DifferencePowers = SerreModuleLocalisationMaps[l].Along[A,A,RH.identity A,Members.product,Overlaps.product,difference,g] ;
 module Right = EL.Agree[A,SD.Members.product,Overlaps.product,g,overlaps-invertible,
  \ y -> Difference.map difference (MemberProduct.EP.H.map MemberProduct.PM.induced y),
  \ z -> Beta.map (FE.LocalD.Maps.map FE.LocalD.induced z),
  \ z -> Difference.map difference (Alpha.map z),
  \ y p -> trans (ap (\ w -> Beta.E.T.power p (Beta.map w)) (FE.LocalD.induced-at y p))
   (trans (Beta.clears (SD.Difference.map SD.difference y) p) (overlaps-restriction y)),
  \ y p -> trans (sym (DifferencePowers.power-map p (Alpha.map (Alpha.E.S.fraction y p))))
   (ap (Difference.map difference) (Alpha.clears y p))] ;
 module Square = FE.Compare[C.E.lift,Alpha.lift,Beta.lift] ;
 module Descent = Square.Diagram[SD.injective,SD.exact,target-injective,target-zero,alpha-equiv,beta-equiv,Left.same,Right.same] ;
 -- the descended map is the canonical lambda
 module Canonical = C.Other[C.E.lift,\ x -> trans (C.E.extends x) (C.original-at x)] ;
 equivalence : Pr.isEquiv C.E.S.Carrier (M.presheaf.module-at Dg).M C.map =
  Iso[l].equiv-homotopy C.E.S.Carrier (M.presheaf.module-at Dg).M (\ z -> C.E.To.map C.E.lift z) C.map
   Canonical.unique Descent.equivalence ;
} ;
