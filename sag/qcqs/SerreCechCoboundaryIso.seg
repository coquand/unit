-- The coordinate translation by a coboundary is an isomorphism (Serre §5).
-- Translation by b has inverse translation by -b. Linearity of delta
-- gives the reverse coboundary equation. Coordinatewise cancellation
-- proves both inverse laws; the checked translation map is already natural
-- and equivariant, so it gives the desired equivariant natural isomorphism.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ; module SM = SerreModule[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (n : Nat) (as : Fin n -> L.L)
 (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as)) {
 module Z = SerreCechCocycles[l].On[L,G,M,n,as] ; module C = Z.C ;
 module Maps = SerreCechIsoClassMaps[l].On[L,G,M] ;
 module Move = SerreCechCoboundaryIsoMap[l].On[L,G,M,n,as,covers] ;
 module Coboundary (c d : Z.Cocycle) (bs : C.C0.Carrier)
  (cochain-eq : Id C.C1.Carrier (Z.value d) (C.C1.product.madd (Z.value c) (C.delta bs))) {
  module Forward = Move.Translation[c,d,bs,cochain-eq] ;
  module Group = SerreCechAlgebra[l].Over[G.ring L.top,C.C1.product] ;
  delta-negative : Id C.C1.Carrier (C.delta (C.C0.product.mneg bs)) (C.C1.product.mneg (C.delta bs)) =
   trans (sym (C.coboundary-at (C.C0.product.mneg bs)))
    (trans (C.Maps.map-neg C.coboundary bs) (ap C.C1.product.mneg (C.coboundary-at bs))) ;
  reverse-equation : Id C.C1.Carrier (Z.value c)
   (C.C1.product.madd (Z.value d) (C.delta (C.C0.product.mneg bs))) =
   sym (trans (ap (\ z -> C.C1.product.madd z (C.delta (C.C0.product.mneg bs))) cochain-eq)
    (trans (ap (C.C1.product.madd (C.C1.product.madd (Z.value c) (C.delta bs))) delta-negative)
     (trans (sym (SM.Over[G.ring L.top].Laws[C.C1.product].sub-at (C.C1.product.madd (Z.value c) (C.delta bs)) (C.delta bs)))
      (Group.sub-cancel-right (Z.value c) (C.delta bs))))) ;
  module Backward = Move.Translation[d,c,C.C0.product.mneg bs,reverse-equation] ;
  module AtIndex (a : L.L) (i : Fin n) {
   domain : L.L = L.meet a (as i) ;
   module Additive = SerreCechAlgebra[l].Over[G.ring domain,M.presheaf.module-at domain] ;
   module Laws = SM.Over[G.ring domain].Laws[M.presheaf.module-at domain] ;
   correction-negative : Id (M.presheaf.module-at domain).M (Backward.correction a i)
    ((M.presheaf.module-at domain).mneg (Forward.correction a i)) =
    C.MO.res-neg domain (as i) (Move.O.meet-right a (as i)) (bs i) ;
   left (x : Forward.T.Fibre.Section a) : Id (M.presheaf.module-at domain).M
    (Forward.T.Fibre.value a (Backward.move a (Forward.move a x)) i) (Forward.T.Fibre.value a x i) =
    trans (Backward.move-coordinate a (Forward.move a x) i)
     (trans (cong2 (M.presheaf.module-at domain).M (M.presheaf.module-at domain).madd _ _ _ _
      (Forward.move-coordinate a x i) correction-negative)
      (trans (sym (Laws.sub-at
       ((M.presheaf.module-at domain).madd (Forward.T.Fibre.value a x i) (Forward.correction a i)) (Forward.correction a i)))
       (Additive.sub-cancel-right (Forward.T.Fibre.value a x i) (Forward.correction a i)))) ;
   right (x : Forward.V.Fibre.Section a) : Id (M.presheaf.module-at domain).M
    (Forward.V.Fibre.value a (Forward.move a (Backward.move a x)) i) (Forward.V.Fibre.value a x i) =
    trans (Forward.move-coordinate a (Backward.move a x) i)
     (trans (ap (\ z -> (M.presheaf.module-at domain).madd z (Forward.correction a i)) (Backward.move-coordinate a x i))
      (trans (ap (\ z -> (M.presheaf.module-at domain).madd
       ((M.presheaf.module-at domain).madd (Forward.V.Fibre.value a x i) z) (Forward.correction a i)) correction-negative)
       (trans (ap (\ z -> (M.presheaf.module-at domain).madd z (Forward.correction a i))
        (sym (Laws.sub-at (Forward.V.Fibre.value a x i) (Forward.correction a i))))
        (Additive.sub-plus-right (Forward.V.Fibre.value a x i) (Forward.correction a i))))) ;
  } ;
  left (a : L.L) (x : Forward.T.Fibre.Section a) : Id (Forward.T.Fibre.Section a) (Backward.move a (Forward.move a x)) x =
   Forward.T.Fibre.ext a _ _ (Forward.T.E.At[a].P.ext _ _ (\ i -> AtIndex[a,i].left x)) ;
  right (a : L.L) (x : Forward.V.Fibre.Section a) : Id (Forward.V.Fibre.Section a) (Forward.move a (Backward.move a x)) x =
   Forward.V.Fibre.ext a _ _ (Forward.V.E.At[a].P.ext _ _ (\ i -> AtIndex[a,i].right x)) ;
  equivalent (a : L.L) : Pr.isEquiv (Forward.Source.torsor.presheaf.obj a) (Forward.Target.torsor.presheaf.obj a) (Forward.morphism.at a) =
   Pr.qinv (Forward.Source.torsor.presheaf.obj a) (Forward.Target.torsor.presheaf.obj a) (Forward.morphism.at a) (Backward.move a)
    (\ x -> trans (Forward.morphism-at a (Backward.move a x)) (right a x))
    (\ x -> trans (ap (Backward.move a) (Forward.morphism-at a x)) (left a x)) ;
  isomorphism : Maps.Between[Forward.Source.torsor,Forward.Target.torsor].EquivariantIso =
   new Maps.Between[Forward.Source.torsor,Forward.Target.torsor].EquivariantIso[Forward.morphism,equivalent] ;
  isomorphism-at (a : L.L) (x : Forward.T.Fibre.Section a) :
   Id (Forward.V.Fibre.Section a) (isomorphism.morphism.at a x) (Forward.move a x) = Forward.morphism-at a x ;
  opaque isomorphism ;
 } ;
} ;
