-- Zero Cech class trivialises a torsor with specified local sections.
-- Their differences form a cocycle by difference composition. Effectivity
-- of the small Cech quotient turns a zero class into a mere coboundary.
-- Its coefficients have precisely the sign needed to glue t_i+b_i.
-- Conversely a global point gives correction coefficients by differences
-- from the local points, and its cocycle class is zero.
-- This implication needs only the chosen finite trivialising cover;
-- affine vanishing is needed later to find such sections on a prescribed
-- finite affine cover of an arbitrary quasi-coherent torsor.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module MS = SerreModuleSheaf[l] ;
module Tr = Truncation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (T : SerreTorsor[l].On[L,G].Over[M].Torsor)
 (n : Nat) (as : Fin n -> L.L) (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as))
 (ts : (i : Fin n) -> T.presheaf.obj (as i)) {
 module Z = SerreCechCocycles[l].On[L,G,M,n,as] ;
 module TC = SerreTorsorCech[l].On[L,G,M,T,n,as,covers,ts] ;
 cochain : Z.C.C1.Carrier = \ i j -> TC.cocycle i j ;
 cocycle-law : Z.CocycleLaw cochain = \ i j k ->
  TC.cocycle-law Z.Triple[i,j,k].domain i j k
   Z.Triple[i,j,k].below-i Z.Triple[i,j,k].below-j Z.Triple[i,j,k].below-k ;
 cocycle : Z.Cocycle = (cochain,cocycle-law) ;
 cocycle-value : Id Z.C.C1.Carrier (Z.value cocycle) cochain = refl cochain ;
 class : Z.H1 = Z.class cocycle ;
 class-at : Id Z.H1 class (Z.class cocycle) = refl (Z.class cocycle) ;
 module Correction (bs : Z.C.C0.Carrier) (e : Id Z.C.C1.Carrier (Z.value cocycle) (Z.C.delta bs)) {
  pair-equation (i j : Fin n) : Id (M.presheaf.module-at (Z.C.overlap i j)).M
   (TC.cocycle i j) (Z.C.delta bs i j) = ap (\ c -> c i j) e ;
  correction-equation (i j : Fin n) : Id (M.presheaf.module-at (TC.overlap i j)).M
   ((M.presheaf.module-at (TC.overlap i j)).madd (TC.cocycle i j)
    (TC.MO.restrict (TC.overlap i j) (as i) (TC.O.meet-left (as i) (as j)) (bs i)))
   (TC.MO.restrict (TC.overlap i j) (as j) (TC.O.meet-right (as i) (as j)) (bs j)) =
   trans (ap (\ x -> (M.presheaf.module-at (Z.C.overlap i j)).madd x (Z.C.AtPair[i,j].from-left bs))
    (pair-equation i j))
    (Z.C.AtPair[i,j].Additive.sub-plus-right (Z.C.AtPair[i,j].from-right bs) (Z.C.AtPair[i,j].from-left bs)) ;
  section : T.presheaf.obj L.top = TC.Correction[bs,correction-equation].global-section ;
 } ;
 trivial (zero-class : Id Z.H1 class Z.zero) : Tr.Trunc[T.presheaf.obj L.top].carrier =
  Tr.Trunc[(b : Z.C.C0.Carrier) * Id Z.C.C1.Carrier (Z.value cocycle) (Z.C.delta b)].induction @l
   (\ w -> Tr.Trunc[T.presheaf.obj L.top].carrier) (\ w -> Tr.Trunc[T.presheaf.obj L.top].proposition)
   (\ w -> Tr.Trunc[T.presheaf.obj L.top].inc Correction[w.1,w.2].section) (Z.zero-boundary cocycle zero-class) ;
 module FromGlobal (t : T.presheaf.obj L.top) {
  bs (i : Fin n) : (M.presheaf.module-at (as i)).M =
   TC.TO.diff (as i) (ts i) (T.presheaf.res (as i) L.top (TC.O.le-top (as i)) t) ;
  module Pair (i j : Fin n) {
   global : T.presheaf.obj (TC.overlap i j) =
    T.presheaf.res (TC.overlap i j) L.top (TC.O.le-top (TC.overlap i j)) t ;
   left-bs : Id (M.presheaf.module-at (TC.overlap i j)).M (Z.C.AtPair[i,j].from-left bs)
    (TC.TO.diff (TC.overlap i j) (TC.left i j) global) =
    trans (sym (TC.TO.diff-res (TC.overlap i j) (as i) (TC.O.meet-left (as i) (as j))
     (ts i) (T.presheaf.res (as i) L.top (TC.O.le-top (as i)) t)))
     (ap (TC.TO.diff (TC.overlap i j) (TC.left i j))
      (T.presheaf.res-comp (TC.overlap i j) (as i) L.top (TC.O.meet-left (as i) (as j))
       (TC.O.le-top (as i)) (TC.O.le-top (TC.overlap i j)) t)) ;
   right-bs : Id (M.presheaf.module-at (TC.overlap i j)).M (Z.C.AtPair[i,j].from-right bs)
    (TC.TO.diff (TC.overlap i j) (TC.right i j) global) =
    trans (sym (TC.TO.diff-res (TC.overlap i j) (as j) (TC.O.meet-right (as i) (as j))
     (ts j) (T.presheaf.res (as j) L.top (TC.O.le-top (as j)) t)))
     (ap (TC.TO.diff (TC.overlap i j) (TC.right i j))
      (T.presheaf.res-comp (TC.overlap i j) (as j) L.top (TC.O.meet-right (as i) (as j))
       (TC.O.le-top (as j)) (TC.O.le-top (TC.overlap i j)) t)) ;
   sum-equation : Id (M.presheaf.module-at (TC.overlap i j)).M
    ((M.presheaf.module-at (TC.overlap i j)).madd (TC.cocycle i j) (Z.C.AtPair[i,j].from-left bs))
    (Z.C.AtPair[i,j].from-right bs) =
    trans (ap ((M.presheaf.module-at (TC.overlap i j)).madd (TC.cocycle i j)) left-bs)
     (trans (sym (TC.TO.diff-compose (TC.overlap i j) (TC.right i j) (TC.left i j) global)) (sym right-bs)) ;
   boundary-equation : Id (M.presheaf.module-at (TC.overlap i j)).M (TC.cocycle i j) (Z.C.delta bs i j) =
    trans (sym (Z.C.AtPair[i,j].Additive.sub-cancel-right (TC.cocycle i j) (Z.C.AtPair[i,j].from-left bs)))
     (ap (\ z -> Z.C.AtPair[i,j].Laws.sub z (Z.C.AtPair[i,j].from-left bs)) sum-equation) ;
  } ;
  boundary-equation : Id Z.C.C1.Carrier (Z.value cocycle) (Z.C.delta bs) =
   Z.C.C1.ext _ _ (\ i -> Z.C.Row[i].Product.ext _ _ (\ j -> Pair[i,j].boundary-equation)) ;
  class-zero : Id Z.H1 class Z.zero = Z.boundary-zero cocycle
   (Tr.Trunc[(b : Z.C.C0.Carrier) * Id Z.C.C1.Carrier (Z.value cocycle) (Z.C.delta b)].inc (bs,boundary-equation)) ;
 } ;
 section-zero (t : Tr.Trunc[T.presheaf.obj L.top].carrier) : Id Z.H1 class Z.zero =
  Tr.Trunc[T.presheaf.obj L.top].induction @l (\ w -> Id Z.H1 class Z.zero)
   (\ w -> Z.h1-set class Z.zero) (\ w -> FromGlobal[w].class-zero) t ;
 opaque cocycle ; opaque class ;
} ;
