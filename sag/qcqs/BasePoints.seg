-- Points over a fixed affine base, and their underlying ordinary points.
-- A K-algebra test is (B, iota : K -> B); a morphism is a ring map h
-- commuting with iota.  A point over K is p with s p = Spec iota.
-- Reindex p along h; its base equation follows from associativity, the
-- equation of p, Spec composition, and the commuting equation of h.
-- For a fixed ordinary point p, its lifts (iota, s p = Spec iota) form a
-- proposition: apply the affine map equivalence to compare the iotas;
-- the equations lie in a set.  The canonical lift uses extract(s p).
-- Reordering a total point as (p, lift) therefore shows that total points
-- with equal underlying points are equal.  This is also how canonical
-- lifts are compared with arbitrary lifts, without choosing presentations.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module Over (K : T.Test) {
 Algebra : U l+ = (B : T.Test) * RH.Hom K.ring B.ring ;
 test (A : Algebra) : T.Test = A.1 ;
 iota (A : Algebra) : RH.Hom K.ring (test A).ring = A.2 ;
 algebra (B : T.Test) (i : RH.Hom K.ring B.ring) : Algebra = (B,i) ;
 Hom (A B : Algebra) : U l = (h : RH.Hom (test A).ring (test B).ring) *
  ((r : K.ring.R) -> Id (test B).ring.R (map h (map (iota A) r)) (map (iota B) r)) ;
 ring-map {A B : Algebra} (h : Hom A B) : RH.Hom (test A).ring (test B).ring = h.1 ;
 commutes {A B : Algebra} (h : Hom A B) (r : K.ring.R) : Id (test B).ring.R (map (ring-map h) (map (iota A) r)) (map (iota B) r) = h.2 r ;
 id-hom (A : Algebra) : Hom A A = (RH.identity (test A).ring,\ r -> refl (map (iota A) r)) ;
 compose-hom (A B C : Algebra) (g : Hom B C) (f : Hom A B) : Hom A C =
  (RH.compose (test A).ring (test B).ring (test C).ring (ring-map g) (ring-map f),
   \ r -> trans (ap (map (ring-map g)) (commutes f r)) (commutes g r)) ;
 module On (X : Sp.Space) (s : Sp.Hom X (T.space K)) {
  Points (A : Algebra) : U l = (p : Sp.Hom (T.space (test A)) X) *
   Id (Sp.Hom (T.space (test A)) (T.space K)) (Sp.compose (T.space (test A)) X (T.space K) s p) T.Map[K,(test A),(iota A)].morphism ;
  point {A : Algebra} (p : Points A) : Sp.Hom (T.space (test A)) X = p.1 ;
  base {A : Algebra} (p : Points A) : Id (Sp.Hom (T.space (test A)) (T.space K))
   (Sp.compose (T.space (test A)) X (T.space K) s (point p)) T.Map[K,(test A),(iota A)].morphism = p.2 ;
  point-ext (A : Algebra) (p q : Points A) (e : Id (Sp.Hom (T.space (test A)) X) (point p) (point q)) : Id (Points A) p q =
   Pr.Sigma-eq (Sp.Hom (T.space (test A)) X)
    (\ r -> Id (Sp.Hom (T.space (test A)) (T.space K)) (Sp.compose (T.space (test A)) X (T.space K) s r) T.Map[K,(test A),(iota A)].morphism)
    p.1 q.1 p.2 q.2 e (Sp.set (T.space (test A)) (T.space K) (Sp.compose (T.space (test A)) X (T.space K) s q.1) T.Map[K,(test A),(iota A)].morphism) ;
  set (A : Algebra) : Pr.isSet (Points A) =
   Pr.isSet-Sigma (Sp.Hom (T.space (test A)) X)
    (\ r -> Id (Sp.Hom (T.space (test A)) (T.space K)) (Sp.compose (T.space (test A)) X (T.space K) s r) T.Map[K,(test A),(iota A)].morphism)
    (Sp.set (T.space (test A)) X)
    (\ r -> Pr.prop-to-set (Id (Sp.Hom (T.space (test A)) (T.space K)) (Sp.compose (T.space (test A)) X (T.space K) s r) T.Map[K,(test A),(iota A)].morphism)
     (Sp.set (T.space (test A)) (T.space K) (Sp.compose (T.space (test A)) X (T.space K) s r) T.Map[K,(test A),(iota A)].morphism)) ;
  module Reindex (A B : Algebra) (h : Hom A B) (p : Points A) {
   equation : Id (Sp.Hom (T.space (test B)) (T.space K))
    (Sp.compose (T.space (test B)) X (T.space K) s (Sp.compose (T.space (test B)) (T.space (test A)) X (point p) T.Map[(test A),(test B),ring-map h].morphism))
    T.Map[K,(test B),(iota B)].morphism =
    trans Sp.Associativity[T.space (test B),T.space (test A),X,T.space K,s,point p,T.Map[(test A),(test B),ring-map h].morphism].assoc
     (trans (ap (\ q -> Sp.compose (T.space (test B)) (T.space (test A)) (T.space K) q T.Map[(test A),(test B),ring-map h].morphism) (base p))
      (trans (sym T.Composition[K,(test A),(test B),(iota A),ring-map h].composition)
       (ap (\ i -> T.Map[K,(test B),i].morphism)
        (RH.Properties[K.ring,(test B).ring,(test B).carrier-set].ext (RH.compose K.ring (test A).ring (test B).ring (ring-map h) (iota A)) (iota B) (commutes h))))) ;
   reindex : Points B = (Sp.compose (T.space (test B)) (T.space (test A)) X (point p) T.Map[(test A),(test B),ring-map h].morphism,equation) ;
  } ;
  identity (A : Algebra) (p : Points A) : Id (Points A) Reindex[A,A,id-hom A,p].reindex p =
   point-ext A Reindex[A,A,id-hom A,p].reindex p (FunctorPoints[l].On[X].identity (test A) (point p)) ;
  composition (A B C : Algebra) (f : Hom A B) (g : Hom B C) (p : Points A) :
   Id (Points C) Reindex[A,C,compose-hom A B C g f,p].reindex Reindex[B,C,g,Reindex[A,B,f,p].reindex].reindex =
   point-ext C Reindex[A,C,compose-hom A B C g f,p].reindex Reindex[B,C,g,Reindex[A,B,f,p].reindex].reindex
    (FunctorPoints[l].On[X].composition (test A) (test B) (test C) (ring-map f) (ring-map g) (point p)) ;
  module At (B : T.Test) {
   Total : U l = (i : RH.Hom K.ring B.ring) * Points (algebra B i) ;
   forget (a : Total) : Sp.Hom (T.space B) X = point a.2 ;
   Lifts (p : Sp.Hom (T.space B) X) : U l = (i : RH.Hom K.ring B.ring) *
    Id (Sp.Hom (T.space B) (T.space K)) (Sp.compose (T.space B) X (T.space K) s p) T.Map[K,B,i].morphism ;
   module E = T.MapsEquivalence[K,B] ;
   lifts-prop (p : Sp.Hom (T.space B) X) : Pr.isProp (Lifts p) = \ a b ->
    Pr.Sigma-eq (RH.Hom K.ring B.ring)
     (\ i -> Id (Sp.Hom (T.space B) (T.space K)) (Sp.compose (T.space B) X (T.space K) s p) T.Map[K,B,i].morphism)
     a.1 b.1 a.2 b.2
     (trans (sym (E.extract-map a.1)) (trans (ap E.extract (trans (sym a.2) b.2)) (E.extract-map b.1)))
     (Sp.set (T.space B) (T.space K) (Sp.compose (T.space B) X (T.space K) s p) T.Map[K,B,b.1].morphism) ;
   Data : U l = (p : Sp.Hom (T.space B) X) * Lifts p ;
   arrange (a : Total) : Data = (forget a,(a.1,a.2.2)) ;
   total (d : Data) : Total = (d.2.1,(d.1,d.2.2)) ;
   total-ext (a b : Total) (e : Id (Sp.Hom (T.space B) X) (forget a) (forget b)) : Id Total a b =
    ap total (Pr.Sigma-eq (Sp.Hom (T.space B) X) Lifts (forget a) (forget b) (arrange a).2 (arrange b).2 e (lifts-prop (forget b))) ;
   lift (p : Sp.Hom (T.space B) X) : Total =
    (E.extract (Sp.compose (T.space B) X (T.space K) s p),(p,sym (E.rebuild (Sp.compose (T.space B) X (T.space K) s p)))) ;
   forget-lift (p : Sp.Hom (T.space B) X) : Id (Sp.Hom (T.space B) X) (forget (lift p)) p = refl p ;
   lift-forget (a : Total) : Id Total (lift (forget a)) a = total-ext (lift (forget a)) a (refl (forget a)) ;
   forget-equivalence : Pr.isEquiv Total (Sp.Hom (T.space B) X) forget =
    Pr.qinv Total (Sp.Hom (T.space B) X) forget lift forget-lift lift-forget ;
  } ;
  module TotalReindex (A B : T.Test) (h : RH.Hom A.ring B.ring) (p : At[A].Total) {
   target : RH.Hom K.ring B.ring = RH.compose K.ring A.ring B.ring h p.1 ;
   morphism : Hom (algebra A p.1) (algebra B target) = (h,\ r -> refl (map h (map p.1 r))) ;
   reindex : At[B].Total = (target,Reindex[algebra A p.1,algebra B target,morphism,p.2].reindex) ;
  } ;
 } ;
} ;
