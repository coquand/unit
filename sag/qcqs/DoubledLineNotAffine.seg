-- The doubled-origin line over a nonzero ring is not affine (DESIGN.md,
-- Next 3).  Let Gamma be its ring of global sections and
-- pi : L_Gamma -> L2 the lattice map of the canonical map (SpecMap at the
-- identity of Gamma), with pi(D r) = D_top(r).  An open (u, v) of the
-- doubled line is diagonal when u = v.
--
-- (1) A global section r = (s, t) has s = t (DoubledLineGlobal).
-- (2) So D_top(r) = (D_top(s), D_top(t)) (Doubling: componentwise) is
--     diagonal.
-- (3) pi(D r) = D_top(r) is diagonal; every y in L_Gamma is merely a finite
--     join of generators D(r_i), pi preserves finite joins, and diagonal opens
--     are closed under them (the two projections preserve finite joins).
--     So every pi y is diagonal.
-- (4) If the canonical map is an isomorphism, the chart e = (top, D(X)) is
--     some pi y, hence diagonal: top = D(X), so D 1 <= D(X), and 1 = 0 in
--     k (VariableKernel.one-zero: 1 = X q, evaluated at 0).
-- The Zariski lattice of Gamma is never identified with that of k[X].
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module F = Axioms[l].FunExtLemmas[fe @l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module G = DoubledLineGlobal[l].Over[k,setk] ;
 module DD = G.DD ;
 module Dbl = G.Dbl ;
 module O = DL.Order[G.Z.lattice] ;
 module J = DL.Joins[G.Z.lattice] ;
 module JD = DL.Joins[DD.lattice] ;
 module AC = AffineCriterion[l].Over[DD.lattice,Dbl.doubled] ;
 module SM = AC.Can.Of[RH.identity (Dbl.doubled.sheaf.ring DD.lattice.top)].SM ;
 module ZG = AC.ZG ;
 module RG = Radical[l].Over[Dbl.doubled.sheaf.ring DD.lattice.top] ;

 -- diagonal opens
 Diag (x : DD.Opens) : U l = Id G.Z.lattice.L (DD.first x) (DD.second x) ;
 diag-prop (x : DD.Opens) : Pr.isProp (Diag x) = G.Z.lattice.setL (DD.first x) (DD.second x) ;
 diag-joins (n : Nat) (xs : Fin n -> DD.Opens) (h : (i : Fin n) -> Diag (xs i)) : Diag (JD.bigJ n xs) = calc G.Z.lattice.L {
  DD.first (JD.bigJ n xs) =< DD.join-first n xs > J.bigJ n (\ i -> DD.first (xs i))
   =< ap (J.bigJ n) (F.funext (Fin n) (\ i -> G.Z.lattice.L) (\ i -> DD.first (xs i)) (\ i -> DD.second (xs i)) h)
    > J.bigJ n (\ i -> DD.second (xs i))
   =< sym (DD.join-second n xs) > DD.second (JD.bigJ n xs) } ;

 -- (2) the invertibility open of a global section is diagonal
 d-diagonal (r : (Dbl.doubled.sheaf.ring DD.lattice.top).R) : Diag (SM.d r) = calc G.Z.lattice.L {
  DD.first (SM.d r) =< Dbl.d-first DD.topD r > Dbl.LX.d (DD.first DD.topD) (Dbl.left DD.topD r)
   =< ap (Dbl.LX.d (DD.first DD.topD)) (G.equal-components r) > Dbl.LX.d (DD.second DD.topD) (Dbl.right DD.topD r)
   =< sym (Dbl.d-second DD.topD r) > DD.second (SM.d r) } ;
 -- (3) every open in the image of pi is diagonal
 image-D (r : (Dbl.doubled.sheaf.ring DD.lattice.top).R) : Diag (DL.hmap SM.pi (ZG.D r)) =
  Pr.subst DD.Opens Diag (SM.d r) (DL.hmap SM.pi (ZG.D r)) (sym (SM.pi-D r)) (d-diagonal r) ;
 module Image (y : ZG.lattice.L) {
  module At (q : ZG.Presentation y) {
   gens (i : Fin (RG.size (ZG.generators q))) : DD.Opens = DL.hmap SM.pi (ZG.D (RG.gen (ZG.generators q) i)) ;
   joins : Id DD.Opens (DL.hmap SM.pi y) (JD.bigJ (RG.size (ZG.generators q)) gens) =
    trans (ap (DL.hmap SM.pi) (ZG.presents q))
     (SM.PM.preserves (RG.size (ZG.generators q)) (\ i -> ZG.D (RG.gen (ZG.generators q) i))) ;
   diagonal : Diag (DL.hmap SM.pi y) =
    Pr.subst DD.Opens Diag (JD.bigJ (RG.size (ZG.generators q)) gens) (DL.hmap SM.pi y) (sym joins)
     (diag-joins (RG.size (ZG.generators q)) gens (\ i -> image-D (RG.gen (ZG.generators q) i))) ;
  } ;
  diagonal : Diag (DL.hmap SM.pi y) =
   Tr.Trunc[ZG.Presentation y].induction @l (\ c -> Diag (DL.hmap SM.pi y)) (\ c -> diag-prop (DL.hmap SM.pi y))
    (\ q -> At[q].diagonal) (ZG.presented y) ;
 } ;

 -- (4) if the doubled line is affine, then 1 = 0 in k (VariableKernel.one-zero)
 module IfAffine (aff : AC.IsAffine) {
  e : DD.Opens = G.DLn.Charts.e ;
  lat-equiv : Pr.isEquiv ZG.lattice.L DD.lattice.L (DL.hmap AC.canonical.lat) = AC.I.lat-equiv {AC.canonical} aff ;
  -- e is in the image, hence diagonal: top = D(X)
  s1 : Diag (DL.hmap SM.pi (lat-equiv.sec e)) = Image[lat-equiv.sec e].diagonal ;
  s2 : Id DD.Opens (DL.hmap SM.pi (lat-equiv.sec e)) e = lat-equiv.sec-eq e ;
  e-diagonal : Diag e = Pr.subst DD.Opens Diag (DL.hmap SM.pi (lat-equiv.sec e)) e s2 s1 ;
  one-le : O.Le (G.Z.D G.P.ring.o) (G.Z.D G.P.variable) =
   O.le-of-eq (G.Z.D G.P.ring.o) (G.Z.D G.P.variable) (trans (sym G.Gb.top-D) e-diagonal) ;
  one-zero : Id k.R k.o k.z = G.VK.one-zero one-le ;
 } ;
 -- over a nonzero ring the doubled-origin line is not affine
 not-affine (nonzero : Id k.R k.o k.z -> Empty) (aff : AC.IsAffine) : Empty = nonzero IfAffine[aff].one-zero ;
} ;
