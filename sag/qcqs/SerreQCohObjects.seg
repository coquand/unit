-- The structures moved to QCoh(Spec A) along Mod(A) = QCoh(Spec A)
-- (SerreQCohEquivalence.equality), on objects.
-- Transport of objects along the identification is the functor
-- M |-> (M~, qcoh) (FibreCategorySIPObjects.On.objects for the Serre
-- equivalence).  Hence (FibreCategoryTransportObjects.Equivalent):
-- (1) the tensor of qcoh-monoidal (SerreQCohMonoidal) takes (M~, N~) to
--     (M (x) N)~, and its unit is A~;
-- (2) the cokernel in qcoh-cokernels (SerreQCohAbelian) of the arrow u
--     moved along the identification is (coker u)~ (coker u: the module
--     cokernel, SerreModuleAbelian.Coker.object).
-- The structures are the existing ones (the same identification), not
-- new ones.  Arrows: only the moved arrow p_* u is used; that p_* u = u~
-- is not proved here.
level l ; open Base ; open Ring[l] ;
module Pr = Prelude[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module QE = SerreQCohEquivalence[l].Over[A,setA] ;
 module TO = FibreCategoryTransportObjects[l+] ;
 module EQ = TO.Equivalent[QE.Modules.category,QE.QCoh.category,QE.fibre-equivalence] ;
 module TM = SerreTensorMonoidal[l].Over[A,setA] ;
 module MA = SerreModuleAbelian[l].Over[A,setA] ;
 module QM = SerreQCohMonoidal[l].Over[A,setA] ;
 module QA = SerreQCohAbelian[l].Over[A,setA] ;
 -- objects move as M |-> (M~, qcoh)
 objects (M : QE.Mod) : Id QE.QCoh.precategory.ob (FibreCategorySIPObjects[l+].obC QE.Modules.category QE.QCoh.category QE.equality M) (QE.on-objects M) =
  EQ.EO.objects M ;
 -- (1) M~ (x) N~ = (M (x) N)~ for the moved tensor
 tensor (M N : QE.Mod) :
  Id QE.QCoh.precategory.ob (QM.qcoh-monoidal.tensor (QE.on-objects M) (QE.on-objects N)) (QE.on-objects (TM.tensor M N)) =
  EQ.M[TM.monoidal].tensor M N ;
 unit : Id QE.QCoh.precategory.ob QM.qcoh-monoidal.unit (QE.on-objects TM.monoidal.unit) = EQ.M[TM.monoidal].unit ;
 -- (2) the cokernel of the moved u is (coker u)~
 moved (M N : QE.Mod) (u : QE.Modules.precategory.hom M N) :
  QE.QCoh.precategory.hom (EQ.A.ob M) (EQ.A.ob N) = EQ.A.hom M N u ;
 cokernel (M N : QE.Mod) (u : QE.Modules.precategory.hom M N) :
  Id QE.QCoh.precategory.ob (QA.qcoh-cokernels.2 (EQ.A.ob M) (EQ.A.ob N) (moved M N u)).1 (QE.on-objects MA.Coker[M,N,u].object) =
  EQ.Coker[(MA.zero,MA.cokernels)].object M N u ;
} ;
