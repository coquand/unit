-- The associated module sheaf commutes with restriction to D(g).
-- The target is the actual direct image of the restricted sheaf along
-- the inverse localisation chart Spec(A_g)->D(g). Every chart open has
-- a mere finite presentation by image-A basics. The compatible native
-- localisation comparisons therefore extend uniquely to a sheaf map.
-- Its components are equivalences on these basics, so finite-cover
-- separation and gluing give an equivalence on every chart open.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module SM = SerreModule[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) (g : A.R) {
 module Compatibility = SerreAssociatedRestrictionNaturality[l].Over[A,setA,Md,g] ;
 module P = Compatibility.P ; module ZB = P.ZB ; module OB = P.OB ;
 module Basis = SerreModuleSheafBasisMap[l].On[ZB.lattice,P.Cht.SG.spec.sheaf,
  P.Source.associated,P.Push.direct-image,A.R,P.basic] ;
 module Presented (u : ZB.lattice.L) (p : P.Geometry.Presentation u) {
  cover : Basis.BasisCover[u] = new Basis.BasisCover[u,p.1,p.2.1,
   \ i -> OB.le-trans _ _ u (ZB.J.below p.1 (\ i -> P.basic (p.2.1 i)) i)
    (OB.le-of-eq _ u (sym p.2.2)),
   OB.le-of-eq _ _ p.2.2] ;
 } ;
 basis (u : ZB.lattice.L) : Tr.Trunc[Basis.BasisCover[u]].carrier =
  Tr.Trunc[P.Geometry.Presentation u].induction @l (\ p -> Tr.Trunc[Basis.BasisCover[u]].carrier)
   (\ p -> Tr.Trunc[Basis.BasisCover[u]].proposition)
   (\ p -> Tr.Trunc[Basis.BasisCover[u]].inc Presented[u,p].cover) (P.Geometry.presented u) ;
 local : Basis.BasisMaps = new Basis.BasisMaps[
  \ a -> P.At[a].component,\ b a le s -> Compatibility.Pair[a,b,le].equation s] ;
 module Extended = Basis.Over[basis,local] ;
 module Maps = P.Modules.Transform[P.Source.associated.presheaf,P.Push.presheaf] ;
 morphism : Maps.Hom = Extended.morphism ;
 on-basic (a : A.R) (s : (P.Source.associated.presheaf.module-at (P.basic a)).M) :
  Id (P.Push.presheaf.module-at (P.basic a)).M (Maps.at morphism (P.basic a) s)
   (P.At[a].Maps.map P.At[a].component s) = Extended.on-basis a s ;
 basic-equivalence (a : A.R) : Pr.isEquiv (P.Source.associated.presheaf.module-at (P.basic a)).M
  (P.Push.presheaf.module-at (P.basic a)).M (Maps.at morphism (P.basic a)) =
  Iso[l].equiv-homotopy _ _ (P.At[a].Maps.map P.At[a].component) (Maps.at morphism (P.basic a))
   (\ s -> sym (on-basic a s)) P.At[a].equivalence ;
 module Criterion = SerreModuleSheafLocalEquivalence[l].Over[ZB.lattice,P.Cht.SG.spec.sheaf,
  P.Source.associated,P.Push.direct-image,morphism] ;
 module Covered (u : ZB.lattice.L) (c : Basis.BasisCover[u]) {
  cover : Criterion.GoodCover[u] = new Criterion.GoodCover[u,c.count,\ i -> P.basic (c.generators i),
   c.below,c.covers,\ i -> basic-equivalence (c.generators i)] ;
 } ;
 covering (u : ZB.lattice.L) : Tr.Trunc[Criterion.GoodCover[u]].carrier =
  Tr.Trunc[Basis.BasisCover[u]].induction @l (\ c -> Tr.Trunc[Criterion.GoodCover[u]].carrier)
   (\ c -> Tr.Trunc[Criterion.GoodCover[u]].proposition)
   (\ c -> Tr.Trunc[Criterion.GoodCover[u]].inc Covered[u,c].cover) (basis u) ;
 equivalence : SerreModuleSheafIso[l].On[ZB.lattice,P.Cht.SG.spec.sheaf].Equivalence
  P.Source.associated.presheaf P.Push.presheaf = Criterion.With[covering].equivalence ;
 opaque morphism ;
} ;
