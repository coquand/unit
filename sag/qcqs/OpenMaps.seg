-- Open subspaces in geometric notation, and inclusions between them.
-- For u <= e in X, the inclusion X|u -> X sends e to top (e /\ u = u).
-- The slice universal property factors it through X|e.  Its triangle and
-- locality are exactly the factorisation triangle and locality of Back.
-- These inclusions do not pass through an identification of nested slices.
level l ; open Ring[l] ;
module Sp = Spaces[l] ;
module DL = DistLattice[l] ;
module At (X : Sp.Space) (e : X.lattice.L) {
 module Sl = Slice[l].Over[X.lattice,X.structure,e] ;
} ;
space (X : Sp.Space) (e : X.lattice.L) : Sp.Space = new Sp.Space[At[X,e].Sl.lattice,At[X,e].Sl.restricted] ;
inclusion (X : Sp.Space) (e : X.lattice.L) : Sp.Hom (space X e) X = (At[X,e].Sl.inclusion,At[X,e].Sl.inclusion-local) ;
module Below (X : Sp.Space) (u e : X.lattice.L) (le : DL.Order[X.lattice].Le u e) {
 module O = DL.Order[X.lattice] ;
 module SU = At[X,u].Sl ;
 module SE = At[X,e].Sl ;
 module UP = SliceUniversal[l].Over[X.lattice,X.structure,e,SU.lattice,SU.sheaf] ;
 top-e : Id SU.Opens (SU.cut e) SU.topS = SU.ext (SU.cut e) SU.topS (trans (X.lattice.meetC e u) le) ;
 module B = UP.Back[SU.inclusion,top-e] ;
 embedding : Sp.Hom (space X u) (space X e) = (B.factor,B.local SU.inv SU.inclusion-local) ;
 triangle : Id (Sp.Hom (space X u) X)
  (Sp.compose (space X u) (space X e) X (inclusion X e) embedding) (inclusion X u) =
  Sp.ext (space X u) X (Sp.compose (space X u) (space X e) X (inclusion X e) embedding) (inclusion X u) B.factor-cut ;
 -- restrictions of a map on X|e, stated in the ambient lattice of X
 module Pull (Y : Sp.Space) (h : Sp.Hom (space X e) Y) {
  module C = Sp.Composite[space X u,space X e,Y,h,embedding] ;
  module GO = RingedLattice[l].On[X.lattice].Of[X.structure.sheaf] ;
  lattice-trace (v : Y.lattice.L) : Id X.lattice.L
   (SU.inc (DistLattice[l].hmap (Sp.underlying C.composite).lat v))
   (X.lattice.meet (SE.inc (DistLattice[l].hmap (Sp.underlying h).lat v)) u) =
   refl (X.lattice.meet (SE.inc (DistLattice[l].hmap (Sp.underlying h).lat v)) u) ;
  at (w : X.lattice.L) (we : O.Le w u) : SU.Opens = (w,we) ;
  at-le (v : Y.lattice.L) (w : X.lattice.L) (we : O.Le w u)
   (k : O.Le w (SE.inc (DL.hmap (Sp.underlying h).lat v))) : SU.OS.Le (at w we) (DL.hmap (Sp.underlying C.composite).lat v) =
   SU.le-in (at w we) (DL.hmap (Sp.underlying C.composite).lat v)
    (O.meet-glb (SE.inc (DL.hmap (Sp.underlying h).lat v)) u w k we) ;
  trace (v : Y.lattice.L) (w : X.lattice.L) (we : O.Le w u)
   (k : O.Le w (SE.inc (DL.hmap (Sp.underlying h).lat v))) (s : (Y.structure.sheaf.ring v).R) :
   Id (X.structure.sheaf.ring w).R
    (SU.SO.restrict (at w we) (DL.hmap (Sp.underlying C.composite).lat v) (at-le v w we k)
      (RingMaps[l].map ((Sp.underlying C.composite).sharp v) s))
    (GO.restrict w (SE.inc (DL.hmap (Sp.underlying h).lat v)) k (RingMaps[l].map ((Sp.underlying h).sharp v) s)) =
   trans (SU.res-inc (at w we) (DL.hmap (Sp.underlying C.composite).lat v) (at-le v w we k)
     (RingMaps[l].map ((Sp.underlying C.composite).sharp v) s))
    (trans (ap (GO.restrict w (X.lattice.meet (SE.inc (DL.hmap (Sp.underlying h).lat v)) u)
       (SU.le-inc (at w we) (DL.hmap (Sp.underlying C.composite).lat v) (at-le v w we k))) (C.C.sharp-map v s))
     (X.structure.sheaf.res-comp w (X.lattice.meet (SE.inc (DL.hmap (Sp.underlying h).lat v)) u)
      (SE.inc (DL.hmap (Sp.underlying h).lat v))
      (SU.le-inc (at w we) (DL.hmap (Sp.underlying C.composite).lat v) (at-le v w we k))
      (O.meet-left (SE.inc (DL.hmap (Sp.underlying h).lat v)) u) k (RingMaps[l].map ((Sp.underlying h).sharp v) s))) ;
 } ;
} ;
