-- O(u) is the limit of the R_g, D g <= u (DESIGN.md, step 3).
--
-- A cone from a ring T is a family of ring maps phi_g : T -> R_g, for
-- D g <= u, with rho_{g,h} . phi_g = phi_h whenever D h <= D g.  The
-- components pi_g : O(u) -> R_g form a cone (compatibility of sections).
--
-- Theorem.  For every cone phi from T there is a ring map
-- lift : T -> O(u) with pi_g . lift = phi_g, and it is the only one.
--  lift(t) = (phi_g t)_g is a section by the cone condition, and lift is
--  a ring map since the ring operations of O(u) are componentwise.  The
--  equations pi_g . lift = phi_g hold by definition.  If pi_g . psi = phi_g
--  for all g, then psi(t) and lift(t) have the same components.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;

 module At (u : lattice.L) (T : CRing) {
  module Op = S.Ops[u] ;
  -- cones from T, with the condition on elements
  Maps : U l = (g : R) -> O.Le (D g) u -> RH.Hom T (Loc g) ;
  Cone (phi : Maps) : U l = (g h : R) (kg : O.Le (D g) u) (hg : O.Le (D h) (D g)) (t : T.R) ->
   Id (Loc h).R (map (S.rho g h hg) (map (phi g kg) t)) (map (phi h (O.le-trans (D h) (D g) u hg kg)) t) ;

  -- the components of a ring map psi : T -> O(u) form a cone
  components (psi : RH.Hom T (S.ring u)) : Maps = \ g k -> RH.compose T (S.ring u) (Loc g) (S.component u g k) psi ;
  components-cone (psi : RH.Hom T (S.ring u)) : Cone (components psi) =
   \ g h kg hg t -> S.compat (map psi t) g h kg hg ;

  module Lift (phi : Maps) (cone : Cone phi) {
   section (t : T.R) : S.Section u = (\ g k -> map (phi g k) t,\ g h kg hg -> cone g h kg hg t) ;
   section-at (t : T.R) (g : R) (k : O.Le (D g) u) : Id (Loc g).R (S.at (section t) g k) (map (phi g k) t) =
    refl (map (phi g k) t) ;
   lift : RH.Hom T (S.ring u) =
    (section,
     S.section-ext u (section T.o) Op.oneS (\ g k -> trans (section-at T.o g k) (map-one (phi g k))),
     \ a b -> S.section-ext u (section (T.add a b)) (Op.addS (section a) (section b)) (\ g k -> calc (Loc g).R {
      S.at (section (T.add a b)) g k =< section-at (T.add a b) g k > map (phi g k) (T.add a b)
       =< map-add (phi g k) a b > (Loc g).add (map (phi g k) a) (map (phi g k) b)
       =< sym (Op.add-at (section a) (section b) g k) > S.at (Op.addS (section a) (section b)) g k }),
     \ a b -> S.section-ext u (section (T.mul a b)) (Op.mulS (section a) (section b)) (\ g k -> calc (Loc g).R {
      S.at (section (T.mul a b)) g k =< section-at (T.mul a b) g k > map (phi g k) (T.mul a b)
       =< map-mul (phi g k) a b > (Loc g).mul (map (phi g k) a) (map (phi g k) b)
       =< sym (Op.mul-at (section a) (section b) g k) > S.at (Op.mulS (section a) (section b)) g k })) ;
   lift-map (t : T.R) : Id (S.ring u).R (map lift t) (section t) = refl (section t) ;
   -- pi_g . lift = phi_g, by definition
   lift-proj (g : R) (k : O.Le (D g) u) (t : T.R) :
    Id (Loc g).R (map (S.component u g k) (map lift t)) (map (phi g k) t) = refl (map (phi g k) t) ;
   unique (psi : RH.Hom T (S.ring u))
    (e : (g : R) (k : O.Le (D g) u) (t : T.R) -> Id (Loc g).R (map (S.component u g k) (map psi t)) (map (phi g k) t)) :
    Id (RH.Hom T (S.ring u)) psi lift =
    RH.Properties[T,S.ring u,S.ring-set u].ext psi lift (\ t ->
     S.section-ext u (map psi t) (map lift t) (\ g k ->
      trans (sym (S.component-map u g k (map psi t))) (trans (e g k t) (sym (lift-proj g k t))))) ;
  } ;
 } ;
} ;
