-- lambda at the top of X is lambda at the top of the slice X|top.
-- The canonical map M(1)_g -> M(D g) of X (SerreSectionLocalisationMap)
-- and SerreLambda at the open 1 have the same carriers; their restriction
-- maps differ only in the witnesses of the inequalities, which are
-- propositions. So if the first is an equivalence, its restriction clears
-- and kills at g (SerreLambdaElementary), hence so does the second (the
-- square of identities, SerreLambdaElementarySquare), which is then an
-- equivalence (SerreLambdaClearing).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (M : MS.On[L,X.sheaf].ModuleSheaf) (g : (X.sheaf.ring L.top).R)
 (equiv : Pr.isEquiv SerreSectionLocalisationMap[l].On[L,X,M].At[g].E.S.Carrier
   (M.presheaf.module-at SerreSectionLocalisationMap[l].On[L,X,M].At[g].open-f).M
   SerreSectionLocalisationMap[l].On[L,X,M].At[g].map) {
 module C = SerreSectionLocalisationMap[l].On[L,X,M].At[g] ;
 module Cl = SerreLambdaClearing[l].On[L,X,M,L.top,g] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module MO = MS.On[L,X.sheaf].Of[M.presheaf] ;
 A : CRing = X.sheaf.ring L.top ;
 module E0 = SerreLambdaElementary[l].Over[A,M.presheaf.module-at L.top,C.Scalars.restricted,C.original,g] ;
 clears (x : (M.presheaf.module-at L.top).M) (p : Nat) :
  Id (M.presheaf.module-at C.open-f).M (E0.T.power p (C.map (E0.S.fraction x p))) (E0.H.map C.original x) =
  trans (C.clears x p) (sym (C.original-at x)) ;
 module F0 = E0.FromEquivalence[C.map,clears,equiv] ;
 module HI = MM.Between[A,A,RH.identity A,M.presheaf.module-at L.top,M.presheaf.module-at L.top] ;
 module HJ = MM.Between[A,A,RH.identity A,Cl.C.Scalars.restricted,C.Scalars.restricted] ;
 i : HI.Hom = new HI.Hom[\ x -> x,\ x y -> refl ((M.presheaf.module-at L.top).madd x y),
  \ a x -> refl ((M.presheaf.module-at L.top).sm a x)] ;
 i-equiv : Pr.isEquiv (M.presheaf.module-at L.top).M (M.presheaf.module-at L.top).M (HI.map i) =
  Pr.qinv _ _ (HI.map i) (\ x -> x) (\ x -> refl x) (\ x -> refl x) ;
 j : HJ.Hom = new HJ.Hom[\ y -> y,\ x y -> refl ((M.presheaf.module-at C.open-f).madd x y),
  \ a y -> ap (\ r -> (M.presheaf.module-at C.open-f).sm r y) (GO.res-irr C.open-f L.top Cl.Lam.below C.below a)] ;
 j-equiv : Pr.isEquiv (M.presheaf.module-at C.open-f).M (M.presheaf.module-at C.open-f).M (HJ.map j) =
  Pr.qinv _ _ (HJ.map j) (\ y -> y) (\ y -> refl y) (\ y -> refl y) ;
 j-at (y : (M.presheaf.module-at C.open-f).M) : Id (M.presheaf.module-at C.open-f).M (HJ.map j y) y = refl y ;
 i-at (x : (M.presheaf.module-at L.top).M) : Id (M.presheaf.module-at L.top).M (HI.map i x) x = refl x ;
 commutes (x : (M.presheaf.module-at L.top).M) : Id (M.presheaf.module-at C.open-f).M
  (HJ.map j (Cl.E.H.map Cl.C.original x)) (E0.H.map C.original (HI.map i x)) =
  calc (M.presheaf.module-at C.open-f).M {
   HJ.map j (Cl.E.H.map Cl.C.original x)
    =< j-at (Cl.E.H.map Cl.C.original x) > Cl.E.H.map Cl.C.original x
    =< Cl.C.original-at x > MO.restrict C.open-f L.top Cl.Lam.below x
    =< MO.res-irr C.open-f L.top Cl.Lam.below C.below x > MO.restrict C.open-f L.top C.below x
    =< sym (C.original-at x) > E0.H.map C.original x
    =< ap (E0.H.map C.original) (sym (i-at x)) > E0.H.map C.original (HI.map i x) } ;
 module Sq = SerreLambdaElementarySquare[l].Square[A,M.presheaf.module-at L.top,Cl.C.Scalars.restricted,
  M.presheaf.module-at L.top,C.Scalars.restricted,Cl.C.original,C.original,i,i-equiv,j,j-equiv,commutes,g] ;
 equivalence : SerreLambda[l].On[L,X,M,L.top].At[g].IsEquivalence = Cl.equivalence (Sq.clear F0.clear) (Sq.kill F0.kill) ;
} ;
