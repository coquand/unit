-- Equal localisation elements give a canonical linear equivalence.
-- Identity elimination reduces the construction and fraction formula to
-- the identity map at reflexivity. The complete comparison is transported
-- together with its linearity, equivalence and characterising equation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ;
module MM = SerreModuleMaps[l] ; module LC = SerreModuleLocalisation[l] ;
module LS = SerreModuleLocalisationStructure[l] ;
module Over (A : CRing) (Md : SM.Over[A].Module) (f : A.R) {
 module Source = LC.At[A,Md,f] ; module S = LS.At[A,Md,f] ;
 module At (g : A.R) {
  module Target = LC.At[A,Md,g] ; module T = LS.At[A,Md,g] ;
  module Maps = MM.Between[A,A,RingHom[l].identity A,S.localised,T.localised] ;
  record Comparison {
   linear : Maps.Hom ;
   equivalence : Pr.isEquiv Source.Carrier Target.Carrier (Maps.map linear) ;
   fraction (x : Md.M) (p : Nat) : Id Target.Carrier (Maps.map linear (Source.fraction x p)) (Target.fraction x p) ;
  } ;
 } ;
 identity : At[f].Maps.Hom = new At[f].Maps.Hom[\ x -> x,\ x y -> refl (S.localised.madd x y),\ a x -> refl (S.localised.sm a x)] ;
 identity-at (x : Source.Carrier) : Id Source.Carrier (At[f].Maps.map identity x) x = refl x ;
 base : At[f].Comparison = new At[f].Comparison[identity,
  Pr.qinv Source.Carrier Source.Carrier (At[f].Maps.map identity) (\ x -> x) identity-at identity-at,
  \ x p -> identity-at (Source.fraction x p)] ;
 comparison (g : A.R) (e : Id A.R f g) : At[g].Comparison =
  idJ A.R f (\ h p -> At[h].Comparison) base g e ;
 module Along (g : A.R) (e : Id A.R f g) {
  module Target = At[g].Target ; module Maps = At[g].Maps ;
  linear : Maps.Hom = (comparison g e).linear ;
  map : Source.Carrier -> Target.Carrier = Maps.map linear ;
  equivalence : Pr.isEquiv Source.Carrier Target.Carrier map = (comparison g e).equivalence ;
  on-fraction (x : Md.M) (p : Nat) : Id Target.Carrier (map (Source.fraction x p)) (Target.fraction x p) =
   (comparison g e).fraction x p ;
 } ;
 opaque comparison ;
} ;
