-- The involution X |-> X^-1 of L = k[X][1/X] (DESIGN.md, Next 5, step 1).
-- k is a commutative ring (a set), f = f_X : k[X] -> L (Affine), x = f(X),
-- a unit of L (Bridge.unit-of) with inverse x^-1.
--
-- (1) tau : k[X] -> L, the polynomial map fixing k (a |-> f(a)) and sending
--     X to x^-1 (Universal).
-- (2) tau(X) = x^-1 is a unit, so tau inverts the powers of X
--     (power-map) and extends uniquely to sigma : L -> L with sigma . f = tau
--     (Localisation).  In particular sigma fixes k: sigma(f a) = f a.
-- (3) sigma(x) = tau(X) = x^-1.  Then sigma(x^-1) = x: sigma(x) sigma(x^-1) =
--     sigma(1) = 1, so sigma(x^-1) is an inverse of x^-1, as is x
--     (inverse-unique).
-- (4) sigma^2 . f and f are polynomial maps k[X] -> L which agree on k
--     (sigma fixes k twice) and on X (sigma^2(x) = sigma(x^-1) = x), so they
--     are equal (Universal.unique); then sigma^2 = 1 (Localisation.Agree).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (k : CRing) (setk : Pr.isSet k.R) {
 module P = PolynomialRing[l].Extension[k,setk] ;
 module AP = Affine[l].Over[P.ring] ;
 module BX = Bridge[l].Over[P.ring,P.variable] ;
 module LH = BX.LocH ;
 module AL = AffineRing[l].Laws[AP.Loc P.variable,AP.set P.variable] ;
 module PX = AffinePowers[l].Over[P.ring] ;
 module PL = AffinePowers[l].Over[AP.Loc P.variable] ;

 -- x = f(X) and its inverse
 x : (AP.Loc P.variable).R = map (AP.inclusion P.variable) P.variable ;
 x-unit : RL[AP.Loc P.variable].unit x =
  BX.At[AP.Loc P.variable,AP.set P.variable,AP.inclusion P.variable,AP.elementary P.variable,P.variable].unit-of
   (suc zero,P.ring.o,refl (P.ring.mul P.variable P.ring.o)) ;
 x-inv : (AP.Loc P.variable).R = x-unit.1 ;
 x-x-inv : Id (AP.Loc P.variable).R ((AP.Loc P.variable).mul x x-inv) (AP.Loc P.variable).o = x-unit.2 ;
 x-inv-x : Id (AP.Loc P.variable).R ((AP.Loc P.variable).mul x-inv x) (AP.Loc P.variable).o =
  trans ((AP.Loc P.variable).mulC x-inv x) x-x-inv ;

 -- (1) tau, fixing k and sending X to x^-1
 module UP = Universal[l].Property[k,AP.Loc P.variable,setk,AP.set P.variable] ;
 constants : RH.Hom k (AP.Loc P.variable) = RH.compose k P.ring (AP.Loc P.variable) (AP.inclusion P.variable) P.inclusion ;
 module T = UP.Given[constants,x-inv] ;

 -- (2) sigma, the extension of tau
 tau-x-unit : RL[AP.Loc P.variable].unit (map T.extend P.variable) =
  Pr.subst (AP.Loc P.variable).R (\ t -> RL[AP.Loc P.variable].unit t) x-inv (map T.extend P.variable) (sym T.on-variable)
   (x,x-inv-x) ;
 tau-power-unit (n : Nat) : RL[AP.Loc P.variable].unit (map T.extend (PX.power P.variable n)) =
  Pr.subst (AP.Loc P.variable).R (\ t -> RL[AP.Loc P.variable].unit t) (PL.power (map T.extend P.variable) n)
   (map T.extend (PX.power P.variable n)) (sym (AffinePowers[l].power-map P.ring (AP.Loc P.variable) T.extend P.variable n))
   (PL.Units[AP.set P.variable].power-unit (map T.extend P.variable) tau-x-unit n) ;
 inverts : LH.Inverts (AP.Loc P.variable) T.extend = \ s p ->
  Pr.subst P.ring.R (\ t -> RL[AP.Loc P.variable].unit (map T.extend t)) (PX.power P.variable (BX.index p)) s (BX.index-eq p)
   (tau-power-unit (BX.index p)) ;
 extensions : Localisation[l].isContr (LH.Extension (AP.Loc P.variable) (AP.Loc P.variable) (AP.inclusion P.variable) T.extend) =
  LH.universal (AP.Loc P.variable) (AP.inclusion P.variable) (AP.elementary P.variable) (AP.Loc P.variable) (AP.set P.variable)
   T.extend inverts ;
 sigma : RH.Hom (AP.Loc P.variable) (AP.Loc P.variable) = extensions.1.1 ;
 sigma-f (p : P.ring.R) : Id (AP.Loc P.variable).R (map sigma (map (AP.inclusion P.variable) p)) (map T.extend p) =
  Pr.happly P.ring.R (\ y -> (AP.Loc P.variable).R) (\ y -> map sigma (map (AP.inclusion P.variable) y)) (map T.extend)
   (ap (\ phi -> map phi) extensions.1.2) p ;
 -- sigma fixes k
 sigma-k (a : k.R) : Id (AP.Loc P.variable).R (map sigma (map constants a)) (map constants a) =
  trans (sigma-f (map P.inclusion a)) (T.on-constants a) ;
 over-k : Id (RH.Hom k (AP.Loc P.variable)) (RH.compose k (AP.Loc P.variable) (AP.Loc P.variable) sigma constants) constants =
  RH.Properties[k,AP.Loc P.variable,AP.set P.variable].ext
   (RH.compose k (AP.Loc P.variable) (AP.Loc P.variable) sigma constants) constants sigma-k ;

 -- (3) sigma exchanges x and x^-1
 sigma-x : Id (AP.Loc P.variable).R (map sigma x) x-inv = trans (sigma-f P.variable) T.on-variable ;
 sigma-x-inv : Id (AP.Loc P.variable).R (map sigma x-inv) x =
  AL.inverse-unique x-inv (map sigma x-inv) x (calc (AP.Loc P.variable).R {
   (AP.Loc P.variable).mul x-inv (map sigma x-inv)
    =< ap (\ t -> (AP.Loc P.variable).mul t (map sigma x-inv)) (sym sigma-x)
     > (AP.Loc P.variable).mul (map sigma x) (map sigma x-inv)
    =< sym (map-mul sigma x x-inv) > map sigma ((AP.Loc P.variable).mul x x-inv)
    =< ap (map sigma) x-x-inv > map sigma (AP.Loc P.variable).o
    =< map-one sigma > (AP.Loc P.variable).o }) x-inv-x ;

 -- (4) sigma^2 = 1
 module TX = UP.Given[constants,x] ;
 twice-f : Id (RH.Hom P.ring (AP.Loc P.variable))
  (RH.compose P.ring (AP.Loc P.variable) (AP.Loc P.variable) (RH.compose (AP.Loc P.variable) (AP.Loc P.variable) (AP.Loc P.variable) sigma sigma)
    (AP.inclusion P.variable))
  (AP.inclusion P.variable) =
  trans (TX.unique (RH.compose P.ring (AP.Loc P.variable) (AP.Loc P.variable)
      (RH.compose (AP.Loc P.variable) (AP.Loc P.variable) (AP.Loc P.variable) sigma sigma) (AP.inclusion P.variable))
     (\ a -> trans (ap (map sigma) (sigma-k a)) (sigma-k a))
     (trans (ap (map sigma) sigma-x) sigma-x-inv))
   (sym (TX.unique (AP.inclusion P.variable) (\ a -> refl (map constants a)) (refl x))) ;
 involution : Id (RH.Hom (AP.Loc P.variable) (AP.Loc P.variable))
  (RH.compose (AP.Loc P.variable) (AP.Loc P.variable) (AP.Loc P.variable) sigma sigma) (RH.identity (AP.Loc P.variable)) =
  LH.Agree[AP.Loc P.variable,AP.inclusion P.variable,LH.is-loc (AP.Loc P.variable) (AP.inclusion P.variable) (AP.elementary P.variable),
   AP.Loc P.variable,AP.set P.variable,
   RH.compose (AP.Loc P.variable) (AP.Loc P.variable) (AP.Loc P.variable) sigma sigma,RH.identity (AP.Loc P.variable),
   \ p -> ap (\ h -> map h p) twice-f].equal ;
 sigma-sigma (y : (AP.Loc P.variable).R) : Id (AP.Loc P.variable).R (map sigma (map sigma y)) y =
  ap (\ h -> map h y) involution ;
} ;
