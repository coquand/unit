-- A fully faithful and merely essentially surjective functor between
-- univalent categories is an equivalence on object types, without choice.
-- Full faithfulness gives an equivalence on isomorphisms (lift the arrow
-- and its inverse; faithfulness proves both inverse equations).
-- Naturality of idtoiso under the functor is path induction.  Univalence
-- identifies the resulting composite equivalence with ap on objects.
-- EmbeddingFibres makes each fibre a proposition.  Essential surjectivity
-- inhabits it merely, and univalence changes an iso into a path.  Eliminate
-- that truncation into the propositional fibre.  Its centre and uniqueness
-- give the section and retraction on objects, hence the equivalence.
level l ; open Base ; open Prelude[l] ;
module C = Category[l,l] ;
module F = Functor[l,l,l,l] ;
module E = EquivalenceLemmas[l] ;
module Tr = Truncation[l] ;
module Over (X Y : C.Category) (H : F.Functor[X.pre,Y.pre])
 (ff : F.FullyFaithful X.pre Y.pre H) (es : F.EssSurj X.pre Y.pre H) {
 module AX = Arrows[l,l].Arrows[X.pre] ;
 module AY = Arrows[l,l].Arrows[Y.pre] ;
 module M = F.Maps[X.pre,Y.pre,H] ;
 module R = F.Faithful[X.pre,Y.pre,H,ff] ;
 module At (x y : X.pre.ob) {
  iso-equiv : isEquiv (X.pre.Iso x y) (Y.pre.Iso (H.obj x) (H.obj y)) (M.map-iso {x} {y}) =
   qinv _ _ (M.map-iso {x} {y}) (R.reflect-iso {x} {y})
    (\ e -> AY.iso-eq _ _ (R.pre-eq (AY.arr e)))
    (\ e -> AX.iso-eq _ _ (sec-ret (X.pre.hom x y) (Y.pre.hom (H.obj x) (H.obj y)) (H.map x y) (ff x y) e.1)) ;
  square (p : Id X.pre.ob x y) : Id (Y.pre.Iso (H.obj x) (H.obj y))
   (M.map-iso (X.pre.idtoiso x y p)) (Y.pre.idtoiso (H.obj x) (H.obj y) (ap X.pre.ob Y.pre.ob H.obj x y p)) =
   idJ X.pre.ob x
    (\ z q -> Id (Y.pre.Iso (H.obj x) (H.obj z)) (M.map-iso (X.pre.idtoiso x z q))
     (Y.pre.idtoiso (H.obj x) (H.obj z) (ap X.pre.ob Y.pre.ob H.obj x z q)))
    (AY.iso-eq _ _ (H.map-idn x)) y p ;
  composite (p : Id X.pre.ob x y) : Id Y.pre.ob (H.obj x) (H.obj y) =
   Y.isotoid (H.obj x) (H.obj y) (M.map-iso (X.pre.idtoiso x y p)) ;
  composite-equiv : isEquiv (Id X.pre.ob x y) (Id Y.pre.ob (H.obj x) (H.obj y)) composite =
   E.compose _ _ _ (Y.isotoid (H.obj x) (H.obj y)) (\ p -> M.map-iso (X.pre.idtoiso x y p))
    (E.inverse (Id Y.pre.ob (H.obj x) (H.obj y)) (Y.pre.Iso (H.obj x) (H.obj y)) (Y.pre.idtoiso (H.obj x) (H.obj y),Y.univalent (H.obj x) (H.obj y))).2
    (E.compose _ _ _ (M.map-iso {x} {y}) (X.pre.idtoiso x y) iso-equiv (X.univalent x y)) ;
  embedding : isEquiv (Id X.pre.ob x y) (Id Y.pre.ob (H.obj x) (H.obj y)) (ap X.pre.ob Y.pre.ob H.obj x y) =
   E.homotopy _ _ composite (ap X.pre.ob Y.pre.ob H.obj x y)
    (\ p -> trans _ _ _ _ (ap _ _ (Y.isotoid (H.obj x) (H.obj y)) _ _ (square p))
     (sec-ret _ _ (Y.pre.idtoiso (H.obj x) (H.obj y)) (Y.univalent (H.obj x) (H.obj y)) (ap X.pre.ob Y.pre.ob H.obj x y p))) composite-equiv ;
 } ;
 module Fibres = EmbeddingFibres[l].Over[X.pre.ob,Y.pre.ob,H.obj,\ x y -> At[x,y].embedding] ;
 point (y : Y.pre.ob) : Fibres.Fibre y = Tr.Trunc[(x : X.pre.ob) * Y.pre.Iso (H.obj x) y].induction @l
  (\ t -> Fibres.Fibre y) (\ t -> Fibres.proposition y) (\ w -> (w.1,Y.isotoid (H.obj w.1) y w.2)) (es y) ;
 object-equivalence : isEquiv X.pre.ob Y.pre.ob H.obj = qinv _ _ H.obj (\ y -> (point y).1) (\ y -> (point y).2)
  (\ x -> ap (Fibres.Fibre (H.obj x)) X.pre.ob (\ w -> w.1) (point (H.obj x)) (x,refl (H.obj x))
   (Fibres.proposition (H.obj x) (point (H.obj x)) (x,refl (H.obj x)))) ;
} ;
