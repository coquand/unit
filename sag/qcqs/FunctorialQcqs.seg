-- Functorial qcqs schemes, using the compact-open classifier.
-- Affine means mere existence of a small ring A and a natural equivalence
-- h_A -> F.  An affine atlas is a finite family U_i : F -> Zar, with
-- pointwise join top, each realisation affine.  A functorial qcqs scheme
-- is a Zariski sheaf merely admitting such an atlas.  Both requirements
-- are propositions.  These data live in U (l+1), not U l.
-- Representables are examples: they are sheaves (RepresentableSheaf) and
-- the singleton whole open is an affine atlas (WholeRealisation).
-- Affine functors are sheaves: eliminate their mere equivalence into the
-- proposition IsSheaf, transfer from a representable using its inverse.
level l ; open Ring[l] ; open Presentations[l] ;
module Hi = Prelude[l+] ;
module Tr = Truncation[l+] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module TE = TestEquivalences[l] ;
module TS = TestSheaves[l] ;
AffineWitness (F : SF.SetFunctor) : U l+ = (A : T.Test) * TE.NaturalEquivalence SF.Representable[A].functor F ;
IsAffine (F : SF.SetFunctor) : U l+ = Tr.Trunc[AffineWitness F].carrier ;
affine-is-sheaf (F : SF.SetFunctor) (a : IsAffine F) : TS.IsSheaf F =
 Tr.Trunc[AffineWitness F].induction @(l+) (\ t -> TS.IsSheaf F) (\ t -> TS.is-sheaf-prop F)
  (\ w -> SheafTransfer[l].Over[F,SF.Representable[w.1].functor,TE.Inverse[SF.Representable[w.1].functor,F,w.2].inverse-equiv,RepresentableSheaf[l].is-sheaf w.1].is-sheaf) a ;
module Over (F : SF.SetFunctor) {
 module C = CO.Over[F] ;
 AffineCover : U l+ = sig {
  count : Nat ;
  opens : Fin count -> C.Open ;
  covers : (A : T.Test) (x : F.obj A) -> Id ZariskiLattice[l].Over[A.ring].lattice.L
   (DL.Joins[ZariskiLattice[l].Over[A.ring].lattice].bigJ count (\ i -> C.value (opens i) A x)) ZariskiLattice[l].Over[A.ring].lattice.top ;
  affine : (i : Fin count) -> IsAffine OpenRealisation[l].Over[F,opens i].functor
 } ;
 HasAtlas : U l+ = Tr.Trunc[AffineCover].carrier ;
 IsQcqs : U l+ = TS.IsSheaf F * HasAtlas ;
 qcqs-prop : Hi.isProp IsQcqs = Hi.isProp-Sigma (TS.IsSheaf F) (\ s -> HasAtlas) (TS.is-sheaf-prop F) (\ s -> Tr.Trunc[AffineCover].proposition) ;
} ;
module Representable (A : T.Test) {
 module F = SF.Representable[A] ;
 module C = CO.Over[F.functor] ;
 module Q = Over[F.functor] ;
 module W = WholeRealisation[l].Over[F.functor] ;
 affine-whole : IsAffine W.R.functor = Tr.Trunc[AffineWitness W.R.functor].inc (A,W.V.inverse-equiv) ;
 cover : Q.AffineCover = struct {
  count = suc zero ; opens = \ i -> C.whole ;
  covers = \ B h -> ZariskiLattice[l].Over[B.ring].lattice.joinB ZariskiLattice[l].Over[B.ring].lattice.top ;
  affine = \ i -> affine-whole } ;
 qcqs : Q.IsQcqs = (RepresentableSheaf[l].is-sheaf A,Tr.Trunc[Q.AffineCover].inc cover) ;
} ;
