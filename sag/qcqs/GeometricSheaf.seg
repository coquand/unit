-- Every geometric functor of points is a Zariski sheaf.
-- On a basic cover of Spec B, let p_i:Spec(B[1/a_i])->Y agree on
-- Spec(B[1/(a_i a_j)]).  Transfer p_i to q_i on D(a_i) using the inverse
-- of j_ai.  BasicGeometry's restriction square identifies the restrictions
-- of q_i,q_j on D(a_i a_j), after precomposition with j_aiaj, with the
-- two given point restrictions.  Cancel that isomorphism; use
-- D(a_i a_j)=D(a_i)/\D(a_j) and independence of inequality witnesses.
-- Thus q_i agree on intersections, and SpaceGluing supplies q:Spec B->Y.
-- Its restrictions along Spec(beta_i)=inclusion j_ai are p_i.
-- Conversely any point with these affine restrictions restricts to q_i:
-- precompose with the isomorphism j_ai and use its factor-cut triangle.
-- SpaceGluing's uniqueness proves uniqueness of the point; matching laws
-- are propositions, so the type of amalgams is contractible.
-- No qcqs hypothesis on Y is needed.  Empty covers are included.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TS = TestSheaves[l] ;
module BG = BasicGeometry[l] ;
module Over (Y : Sp.Space) (c : TS.CoverData) {
 module F = SF.Geometric[Y] ;
 module C = TS.OnCover[F.functor,c].C ;
 module D = TS.OnCover[F.functor,c].D ;
 module Z = T.At[TS.base c].Z ;
 cover-le : Z.O.Le Z.lattice.top (Z.J.bigJ (TS.count c) (\ i -> Z.D (TS.generators c i))) =
  Z.O.le-of-eq _ _ (sym (TS.covers c)) ;
 module SG = SpaceGluing[l].Over[T.space (TS.base c),Y,TS.count c,\ i -> Z.D (TS.generators c i),cover-le] ;
 module Family (ps : C.Values) (compatible : C.Compatible ps) {
  module Piece (i : Fin (TS.count c)) {
   module B = BG.OnRing[TS.base c,TS.generators c i] ;
   module V = B.Value[Y,ps i] ;
  } ;
  module Pair (i j : Fin (TS.count c)) {
   module H = BG.OnRing[TS.base c,(TS.base c).ring.mul (TS.generators c i) (TS.generators c j)] ;
   module Left = BG.Along[TS.base c,TS.generators c i,(TS.base c).ring.mul (TS.generators c i) (TS.generators c j),
    D.G.le-left (TS.generators c i) (TS.generators c j)] ;
   module Right = BG.Along[TS.base c,TS.generators c j,(TS.base c).ring.mul (TS.generators c i) (TS.generators c j),
    D.G.le-right (TS.generators c i) (TS.generators c j)] ;
   module LP = Left.Pull[Y,ps i] ;
   module RP = Right.Pull[Y,ps j] ;
   product-agree : Id (Sp.Hom (Op.space (T.space (TS.base c)) (Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j)))) Y)
    (Sp.compose (Op.space (T.space (TS.base c)) (Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))))
     (Op.space (T.space (TS.base c)) (Z.D (TS.generators c i))) Y Piece[i].V.on-open Left.E.embedding)
    (Sp.compose (Op.space (T.space (TS.base c)) (Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))))
     (Op.space (T.space (TS.base c)) (Z.D (TS.generators c j))) Y Piece[j].V.on-open Right.E.embedding) =
    H.V.cancel-forward Y _ _ (trans LP.trace (trans (compatible i j) (sym RP.trace))) ;
   -- State agreement with arbitrary witnesses, then transport the open.
   AgreeAt (w : Z.lattice.L) : U l = (ki : Z.O.Le w (Z.D (TS.generators c i))) (kj : Z.O.Le w (Z.D (TS.generators c j))) ->
    Id (Sp.Hom (Op.space (T.space (TS.base c)) w) Y)
     (Sp.compose (Op.space (T.space (TS.base c)) w) (Op.space (T.space (TS.base c)) (Z.D (TS.generators c i))) Y Piece[i].V.on-open
      Op.Below[T.space (TS.base c),w,Z.D (TS.generators c i),ki].embedding)
     (Sp.compose (Op.space (T.space (TS.base c)) w) (Op.space (T.space (TS.base c)) (Z.D (TS.generators c j))) Y Piece[j].V.on-open
      Op.Below[T.space (TS.base c),w,Z.D (TS.generators c j),kj].embedding) ;
   at-product : AgreeAt (Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))) = \ ki kj ->
    trans (ap (\ k -> Sp.compose (Op.space (T.space (TS.base c)) (Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))))
      (Op.space (T.space (TS.base c)) (Z.D (TS.generators c i))) Y Piece[i].V.on-open
      Op.Below[T.space (TS.base c),Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j)),Z.D (TS.generators c i),k].embedding)
      (Z.O.le-prop _ _ ki (D.G.le-left (TS.generators c i) (TS.generators c j))))
     (trans product-agree (ap (\ k -> Sp.compose (Op.space (T.space (TS.base c)) (Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))))
       (Op.space (T.space (TS.base c)) (Z.D (TS.generators c j))) Y Piece[j].V.on-open
       Op.Below[T.space (TS.base c),Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j)),Z.D (TS.generators c j),k].embedding)
       (Z.O.le-prop _ _ (D.G.le-right (TS.generators c i) (TS.generators c j)) kj))) ;
   at-meet : AgreeAt (Z.lattice.meet (Z.D (TS.generators c i)) (Z.D (TS.generators c j))) =
    Pr.subst Z.lattice.L AgreeAt (Z.D ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j)))
     (Z.lattice.meet (Z.D (TS.generators c i)) (Z.D (TS.generators c j)))
     (Z.support.2.2.1 (TS.generators c i) (TS.generators c j)) at-product ;
  } ;
  module GF = SG.Family[\ i -> Piece[i].V.on-open] ;
  agree : GF.Compatible = \ i j -> Pair[i,j].at-meet (Z.O.meet-left (Z.D (TS.generators c i)) (Z.D (TS.generators c j)))
   (Z.O.meet-right (Z.D (TS.generators c i)) (Z.D (TS.generators c j))) ;
  module Glue = GF.Glue[agree] ;
  matches : C.Matches ps Glue.morphism = \ i ->
   trans (ap (Sp.compose (T.space (D.basic i)) (T.space (TS.base c)) Y Glue.morphism) (sym Piece[i].B.triangle))
    (trans Sp.Associativity[T.space (D.basic i),Op.space (T.space (TS.base c)) (Z.D (TS.generators c i)),T.space (TS.base c),Y,
      Glue.morphism,Op.inclusion (T.space (TS.base c)) (Z.D (TS.generators c i)),Piece[i].B.j].assoc
     (trans (ap (\ q -> Sp.compose (T.space (D.basic i)) (Op.space (T.space (TS.base c)) (Z.D (TS.generators c i))) Y q Piece[i].B.j) (Glue.matches i)) Piece[i].V.on-j)) ;
  module Other (p : C.Amalgam ps) {
   on-chart : GF.Matches p.1 = \ i -> Piece[i].B.V.cancel-forward Y _ _
    (trans (sym Sp.Associativity[T.space (D.basic i),Op.space (T.space (TS.base c)) (Z.D (TS.generators c i)),T.space (TS.base c),Y,
       p.1,Op.inclusion (T.space (TS.base c)) (Z.D (TS.generators c i)),Piece[i].B.j].assoc)
     (trans (ap (Sp.compose (T.space (D.basic i)) (T.space (TS.base c)) Y p.1) Piece[i].B.triangle)
      (trans (p.2 i) (sym Piece[i].V.on-j)))) ;
   equal : Id (F.functor.obj (TS.base c)) Glue.morphism p.1 = Glue.unique p.1 on-chart ;
  } ;
  centre : C.Amalgam ps = (Glue.morphism,matches) ;
  unique (p : C.Amalgam ps) : Id (C.Amalgam ps) centre p =
   Pr.Sigma-eq (F.functor.obj (TS.base c)) (C.Matches ps) Glue.morphism p.1 matches p.2 Other[p].equal (C.matches-prop ps p.1) ;
  sheaf : Localisation[l].isContr (C.Amalgam ps) = (centre,unique) ;
 } ;
} ;
is-sheaf (Y : Sp.Space) : TS.IsSheaf SF.Geometric[Y].functor = \ c ps k -> Over[Y,c].Family[ps,k].sheaf ;
