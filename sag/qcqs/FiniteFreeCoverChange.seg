-- Base change of the coordinate algebra is coefficientwise. The
-- evaluation formula for a finite basis supplies maps out of the resulting
-- tensor products, including the two maps from a compatible cocone.
level l ; open Ring[l] ; open Presentations[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module CF = AffineCoverFamily[l] ;
module L = MonicAlgebra ;
module Over (K : T.Test) (S : Algebras[l].Over[K.ring,K.carrier-set].Algebra)
 (n : Nat) (basis : L.TraceBasis[l].Over[K.ring,K.carrier-set,S].Basis[n])
 (chosen : Fin n) (unit-coordinate : Id K.ring.R (basis.coordinate S.ring.o chosen) K.ring.o) {
 module Cover = FiniteFreeCoverAlgebra[l].Over[K,S,n,basis,chosen,unit-coordinate] ;
 module KA = Cover.KA ;
 module BP = Cover.BP ;
 module Change (source target : BP.Algebra) (arrow : BP.Hom source target) {
  module X = Cover.At[source] ;
  module Y = Cover.At[target] ;
  A : T.Test = X.A ;
  C : T.Test = Y.A ;
  h : RH.Hom A.ring C.ring = arrow.1 ;
  module H = L.DeterminantLemma[l].Map[A.ring,C.ring,A.carrier-set,C.carrier-set,h] ;
  module CS = FiniteIdeal[l].Sums[C.ring] ;
  on-coordinates (v : X.B.ring.R) : Y.B.ring.R = \ i -> map h (v i) ;
  on-one (i : Fin n) : Id C.ring.R (on-coordinates X.B.ring.o i) (Y.B.ring.o i) =
   arrow.2 (basis.coordinate S.ring.o i) ;
  on-matrix (s : S.ring.R) (j i : Fin n) : Id C.ring.R (map h (X.X.matrix s j i)) (Y.X.matrix s j i) =
   arrow.2 (basis.coordinate (S.ring.mul s (basis.vector j)) i) ;
  on-row (s : S.ring.R) (w : X.B.ring.R) (i : Fin n) :
   Id C.ring.R (map h (X.X.row s w i)) (Y.X.row s (on-coordinates w) i) =
   trans (H.sum-map n (\ j -> A.ring.mul (w j) (X.X.matrix s j i)))
    (CS.sum-cong n (\ j -> map h (A.ring.mul (w j) (X.X.matrix s j i)))
     (\ j -> C.ring.mul (map h (w j)) (Y.X.matrix s j i))
     (\ j -> trans (map-mul h (w j) (X.X.matrix s j i)) (ap (C.ring.mul (map h (w j))) (on-matrix s j i)))) ;
  on-product (v w : X.B.ring.R) (i : Fin n) : Id C.ring.R
   (on-coordinates (X.B.ring.mul v w) i) (Y.B.ring.mul (on-coordinates v) (on-coordinates w) i) =
   trans (H.sum-map n (\ j -> A.ring.mul (v j) (X.X.row (basis.vector j) w i)))
    (CS.sum-cong n (\ j -> map h (A.ring.mul (v j) (X.X.row (basis.vector j) w i)))
     (\ j -> C.ring.mul (map h (v j)) (Y.X.row (basis.vector j) (on-coordinates w) i))
     (\ j -> trans (map-mul h (v j) (X.X.row (basis.vector j) w i))
      (ap (C.ring.mul (map h (v j))) (on-row (basis.vector j) w i)))) ;
  hom : RH.Hom X.B.ring Y.B.ring = (on-coordinates,Y.X.V.ext _ _ on-one,
   \ v w -> Y.X.V.ext _ _ (\ i -> map-add h (v i) (w i)),\ v w -> Y.X.V.ext _ _ (on-product v w)) ;
  on-unit (j : Fin n) : Id Y.B.ring.R (on-coordinates (X.X.V.unit j)) (Y.X.V.unit j) =
   Y.X.V.ext _ _ (\ i -> H.delta-map n i j) ;
  square : Id (RH.Hom A.ring Y.B.ring) (CF.Comp A X.B Y.B hom X.inclusion) (CF.Comp A C Y.B Y.inclusion h) =
   RH.Properties[A.ring,Y.B.ring,Y.B.carrier-set].ext _ _ (\ a -> Y.X.V.ext _ _ (\ i ->
    trans (map-mul h a (X.B.ring.o i)) (ap (C.ring.mul (map h a)) (on-one i)))) ;
  module Factor (D : T.Test) (p : RH.Hom X.B.ring D.ring) (q : RH.Hom C.ring D.ring)
   (eq : Id (RH.Hom A.ring D.ring) (CF.Comp A X.B D p X.inclusion) (CF.Comp A C D q h)) {
   Dalgebra : KA.Algebra = KA.mkAlgebra D.ring D.carrier-set (CF.Comp K C D q target.2) ;
   fromS : KA.Hom S Dalgebra = (RH.compose S.ring X.B.ring D.ring p X.X.pure-hom,\ r ->
    trans (ap p.1 (X.X.scalar-commutes r))
     (trans (ap (\ f -> f.1 (source.2.1 r)) eq) (ap q.1 (arrow.2 r)))) ;
   fromC : KA.Hom Y.Aalg Dalgebra = (q,\ r -> refl (q.1 (target.2.1 r))) ;
   module E = L.FiniteBasisEvaluation[l].Over[K.ring,K.carrier-set,S,Y.Aalg,n,basis].At[Dalgebra,fromS,fromC] ;
   module AS = FiniteIdeal[l].Sums[X.B.ring] ;
   module DS = FiniteIdeal[l].Sums[D.ring] ;
   module PH = L.DeterminantLemma[l].Map[X.B.ring,D.ring,X.B.carrier-set,D.carrier-set,p] ;
   term (v : X.B.ring.R) (j : Fin n) : Id D.ring.R
    (D.ring.mul (fromS.1.1 (basis.vector j)) (q.1 (h.1 (v j))))
    (p.1 (X.B.ring.mul (X.inclusion.1 (v j)) (X.X.V.unit j))) = calc D.ring.R {
    D.ring.mul (fromS.1.1 (basis.vector j)) (q.1 (h.1 (v j)))
     =< cong2 D.ring.R D.ring.mul _ _ _ _ (ap p.1 (X.X.pure-basis j)) (sym (ap (\ f -> f.1 (v j)) eq))
      > D.ring.mul (p.1 (X.X.V.unit j)) (p.1 (X.inclusion.1 (v j)))
     =< D.ring.mulC (p.1 (X.X.V.unit j)) (p.1 (X.inclusion.1 (v j)))
      > D.ring.mul (p.1 (X.inclusion.1 (v j))) (p.1 (X.X.V.unit j))
     =< sym (map-mul p (X.inclusion.1 (v j)) (X.X.V.unit j))
      > p.1 (X.B.ring.mul (X.inclusion.1 (v j)) (X.X.V.unit j)) } ;
   restrict (v : X.B.ring.R) : Id D.ring.R (E.hom.1.1 (hom.1 v)) (p.1 v) =
    trans (DS.sum-cong n (\ j -> D.ring.mul (fromS.1.1 (basis.vector j)) (q.1 (h.1 (v j))))
     (\ j -> p.1 (X.B.ring.mul (X.inclusion.1 (v j)) (X.X.V.unit j))) (term v))
     (trans (sym (PH.sum-map n (\ j -> X.B.ring.mul (X.inclusion.1 (v j)) (X.X.V.unit j))))
      (ap p.1 (X.base-basis.reconstruction v))) ;
   map-out : RH.Hom Y.B.ring D.ring = E.hom.1 ;
   left : Id (RH.Hom X.B.ring D.ring) (CF.Comp X.B Y.B D map-out hom) p =
    RH.Properties[X.B.ring,D.ring,D.carrier-set].ext _ _ restrict ;
   right : Id (RH.Hom C.ring D.ring) (CF.Comp C Y.B D map-out Y.inclusion) q =
    RH.Properties[C.ring,D.ring,D.carrier-set].ext _ _ E.value-scalar ;
  } ;
 } ;
} ;
