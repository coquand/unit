-- Corollary 4.6 of the Serre note (basic sections of a quasi-coherent
-- module on an affine), in lambda form. Let X be affine, A = O(1), and M
-- quasi-coherent. Then lambda_(1,g) : M(1)_g -> M(D g) is an equivalence
-- for every g in A.
-- Proof. The goal is a proposition, so take an atlas w_1, .., w_m with
-- models. The canonical lattice map phi : Zar(A) -> L is bijective; the
-- preimages of the w_j cover Zar(A), so merely D(f_1), .., D(f_n) refine
-- them (ZariskiLattice.refined): phi(D f_k) <= w_(j k) and the
-- phi(D f_k) cover 1, phi preserving joins.
--  Inside a chart. If D(f) <= w and w has a model, then D(f) = D_w(f|w)
--   is the chart open of f|w, so lambda at D(f), at the restriction of g,
--   is an equivalence (SerreLambdaModel.Principal, at h = f|w and
--   s = g|w; g|D(f) = (g|w)|D(f)).
--  Members phi(D f_k) = D(f_k) and overlaps D(f_k) /\ D(f_l) = D(f_k f_l)
--  lie inside the chart w_(j k). Pure descent (SerreLocalisationDescent)
--  gives lambda_(1,g); SerreLambdaTop reads it at the top of X|1.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module BigTr = Truncation[l+] ;
module DL = DistLattice[l] ; module RH = RingHom[l] ; module RM = RingMaps[l] ;
module MS = SerreModuleSheaf[l] ; module IT = IdentityTools[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged)
 (affineX : AffineCriterion[l].Over[L,X].IsAffine) (M : MS.On[L,X.sheaf].ModuleSheaf) {
 module AC = AffineCriterion[l].Over[L,X] ;
 module QC = SerreQuasiCoherent[l].On[L,X,M] ;
 module O = DL.Order[L] ; module J = DL.Joins[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module IX = InvOpen[l].On[L].Of[X.sheaf] ;
 module Z = AC.ZG ;
 module P = DL.JoinMaps[Z.lattice,L,AC.canonical.lat] ;
 module CanId = AC.Can.Of[RH.identity (X.sheaf.ring L.top)] ;
 A : CRing = X.sheaf.ring L.top ;
 phi (a : Z.lattice.L) : L.L = DL.hmap AC.canonical.lat a ;
 image-D (f : A.R) : Id L.L (phi (Z.D f)) (LX.d L.top f) = CanId.SM.pi-D f ;
 preimage (u : L.L) : Z.lattice.L = (AC.I.lat-equiv {AC.canonical} affineX).sec u ;
 preimage-eq (u : L.L) : Id L.L (phi (preimage u)) u = (AC.I.lat-equiv {AC.canonical} affineX).sec-eq u ;
 module For (g : A.R) {
  restricted (a : L.L) : (X.sheaf.ring a).R = GO.restrict a L.top (O.le-top a) g ;
  Good (a : L.L) : U l = SerreLambda[l].On[L,X,M,a].At[restricted a].IsEquivalence ;
  -- lambda at D(f) <= w, for a chart w with a model
  module Inside (w : L.L) (model : QC.At[w].Model) (f : A.R) (below : O.Le (LX.d L.top f) w) {
   module LM = SerreLambdaModel[l].On[L,X,M,w,model] ;
   h : LM.B.R = GO.restrict w L.top (O.le-top w) f ;
   v-eq : Id L.L (LM.S.inc (LM.chart-open h)) (LX.d L.top f) = calc L.L {
    LM.S.inc (LM.chart-open h)
     =< ap LM.S.inc (LM.CanonicalMap.pi-D h) > LX.d w h
     =< IX.Restrict[L.top,w,O.le-top w,f,LX.d L.top f,LX.d-open L.top f].restrict-eq (LX.d w h) (LX.d-open w h)
      > L.meet w (LX.d L.top f)
     =< L.meetC w (LX.d L.top f) > L.meet (LX.d L.top f) w
     =< below > LX.d L.top f } ;
   module Q = LM.Principal[h,restricted w,LX.d L.top f,below,v-eq] ;
   good : Good (LX.d L.top f) =
    Pr.subst (X.sheaf.ring (LX.d L.top f)).R (\ c -> SerreLambda[l].On[L,X,M,LX.d L.top f].At[c].IsEquivalence)
     Q.c (restricted (LX.d L.top f))
     (X.sheaf.res-comp (LX.d L.top f) w L.top below (O.le-top w) (O.le-top (LX.d L.top f)) g) Q.equivalence ;
  } ;
  -- an atlas and a principal refinement of the preimages of its charts
  module FromAtlas (atlas : QC.Atlas) (r : Z.Refinement atlas.cover.count (\ j -> preimage (atlas.cover.opens j))) {
   n : Nat = Z.count r ;
   f (k : Fin n) : A.R = Z.piece r k ;
   chart (k : Fin n) : L.L = atlas.cover.opens (Z.tag r k) ;
   us (k : Fin n) : L.L = phi (Z.D (f k)) ;
   us-below (k : Fin n) : O.Le (us k) (chart k) =
    O.le-trans (us k) (phi (preimage (chart k))) (chart k)
     (P.monotone (Z.D (f k)) (preimage (chart k)) (Z.tag-below r k)) (O.le-of-eq _ _ (preimage-eq (chart k))) ;
   -- the preimages cover Zar(A), so the D(f_k) do, so the us k cover 1
   preimages-cover : Id Z.lattice.L (Z.J.bigJ atlas.cover.count (\ j -> preimage (atlas.cover.opens j))) Z.lattice.top =
    Iso[l].injective Z.lattice.L L.L phi (AC.I.lat-equiv {AC.canonical} affineX) _ _ (calc L.L {
     phi (Z.J.bigJ atlas.cover.count (\ j -> preimage (atlas.cover.opens j)))
      =< P.preserves atlas.cover.count (\ j -> preimage (atlas.cover.opens j))
       > J.bigJ atlas.cover.count (\ j -> phi (preimage (atlas.cover.opens j)))
      =< ap (J.bigJ atlas.cover.count)
          (FE.funext (Fin atlas.cover.count) (\ j -> L.L) (\ j -> phi (preimage (atlas.cover.opens j))) atlas.cover.opens
           (\ j -> preimage-eq (atlas.cover.opens j)))
       > J.bigJ atlas.cover.count atlas.cover.opens
      =< atlas.cover.covers > L.top
      =< sym (DL.hmap-top AC.canonical.lat) > phi Z.lattice.top }) ;
   covers-eq : Id L.L (J.bigJ n us) L.top = calc L.L {
    J.bigJ n us
     =< sym (P.preserves n (\ k -> Z.D (f k))) > phi (Z.J.bigJ n (\ k -> Z.D (f k)))
     =< ap phi (trans (sym (Z.refines r)) preimages-cover) > phi Z.lattice.top
     =< DL.hmap-top AC.canonical.lat > L.top } ;
   covers : O.Le L.top (J.bigJ n us) = O.le-of-eq _ _ (sym covers-eq) ;
   member (k : Fin n) : Good (us k) =
    Pr.subst L.L Good (LX.d L.top (f k)) (us k) (sym (image-D (f k)))
     Inside[chart k,atlas.models (Z.tag r k),f k,
      O.le-trans _ (us k) _ (O.le-of-eq _ _ (sym (image-D (f k)))) (us-below k)].good ;
   -- D(f_k) /\ D(f_l) = D(f_k f_l), inside the chart of k
   overlap-eq (k m : Fin n) : Id L.L (LX.d L.top (A.mul (f k) (f m))) (L.meet (us k) (us m)) =
    trans (LX.mul-law L.top (f k) (f m))
     (cong2 L.L L.meet _ _ _ _ (sym (image-D (f k))) (sym (image-D (f m)))) ;
   overlap (k m : Fin n) : Good (L.meet (us k) (us m)) =
    Pr.subst L.L Good (LX.d L.top (A.mul (f k) (f m))) (L.meet (us k) (us m)) (overlap-eq k m)
     Inside[chart k,atlas.models (Z.tag r k),A.mul (f k) (f m),
      O.le-trans _ (us k) _
       (O.le-trans _ (L.meet (us k) (us m)) _ (O.le-of-eq _ _ (overlap-eq k m)) (O.meet-left (us k) (us m)))
       (us-below k)].good ;
   module Descent = SerreLocalisationDescent[l].Over[L,X,M,n,us,covers,g,member,overlap] ;
   lambda : SerreLambda[l].On[L,X,M,L.top].At[g].IsEquivalence =
    SerreLambdaTop[l].On[L,X,M,g,Descent.equivalence].equivalence ;
  } ;
  module Lam = SerreLambda[l].On[L,X,M,L.top].At[g] ;
  lambda-prop : Pr.isProp Lam.IsEquivalence =
   IT.Equivalence[Lam.Source,(M.presheaf.module-at Lam.open-g).M,Lam.C.E.S.carrier-set,
    (M.presheaf.module-at Lam.open-g).setM,Lam.map].equal ;
  from-atlas (atlas : QC.Atlas) : Lam.IsEquivalence =
   Tr.Trunc[Z.Refinement atlas.cover.count (\ j -> preimage (atlas.cover.opens j))].induction @l
    (\ q -> Lam.IsEquivalence) (\ q -> lambda-prop) (\ r -> FromAtlas[atlas,r].lambda)
    (Z.refined atlas.cover.count (\ j -> preimage (atlas.cover.opens j))) ;
  lambda (qc : QC.IsQuasiCoherent) : Lam.IsEquivalence =
   BigTr.Trunc[QC.Atlas].induction @l (\ a -> Lam.IsEquivalence) (\ a -> lambda-prop) from-atlas qc ;
 } ;
 -- every lambda_(1,g) is an equivalence
 lambda (qc : QC.IsQuasiCoherent) (g : A.R) : SerreLambda[l].On[L,X,M,L.top].At[g].IsEquivalence = For[g].lambda qc ;
} ;
