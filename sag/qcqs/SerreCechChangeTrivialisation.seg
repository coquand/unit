-- Changing local sections changes the cocycle by a coboundary (Serre §5).
-- For old sections t_i and new sections u_i choose b_i by t_i=u_i+b_i.
-- Difference composition in two ways gives c'_ij+b_i=b_j+c_ij,
-- hence c'_ij=c_ij+(b_j-b_i). Effectivity of the existing small Cech
-- quotient identifies the two classes. No affine triviality is used:
-- both actual families of local sections are supplied.
level l ; open Ring[l] ; open Presentations[l] ;
module DL = DistLattice[l] ; module MS = SerreModuleSheaf[l] ;
module SM = SerreModule[l] ; module Tr = Truncation[l] ;
module On (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf)
 (M : MS.On[L,G].ModuleSheaf) (T : SerreTorsor[l].On[L,G].Over[M].Torsor)
 (n : Nat) (as : Fin n -> L.L) (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n as))
 (ts us : (i : Fin n) -> T.presheaf.obj (as i)) {
 module Old = SerreCechTriviality[l].On[L,G,M,T,n,as,covers,ts] ;
 module New = SerreCechTriviality[l].On[L,G,M,T,n,as,covers,us] ;
 module TO = Old.TC.TO ; module MO = Old.TC.MO ;
 module O = Old.TC.O ; module Z = Old.Z ; module C = Z.C ;
 bs : C.C0.Carrier = \ i -> TO.diff (as i) (us i) (ts i) ;
 module Pair (i j : Fin n) {
  w : L.L = C.overlap i j ;
  module Laws = SM.Over[G.ring w].Laws[M.presheaf.module-at w] ;
  module Additive = SerreCechAlgebra[l].Over[G.ring w,M.presheaf.module-at w] ;
  left : (M.presheaf.module-at w).M = C.AtPair[i,j].from-left bs ;
  right : (M.presheaf.module-at w).M = C.AtPair[i,j].from-right bs ;
  left-eq : Id (M.presheaf.module-at w).M left (TO.diff w (New.TC.left i j) (Old.TC.left i j)) =
   sym (TO.diff-res w (as i) (O.meet-left (as i) (as j)) (us i) (ts i)) ;
  right-eq : Id (M.presheaf.module-at w).M right (TO.diff w (New.TC.right i j) (Old.TC.right i j)) =
   sym (TO.diff-res w (as j) (O.meet-right (as i) (as j)) (us j) (ts j)) ;
  compose : Id (M.presheaf.module-at w).M
   ((M.presheaf.module-at w).madd (New.TC.cocycle i j) left)
   ((M.presheaf.module-at w).madd right (Old.TC.cocycle i j)) =
   trans (ap ((M.presheaf.module-at w).madd (New.TC.cocycle i j)) left-eq)
    (trans (sym (TO.diff-compose w (New.TC.right i j) (New.TC.left i j) (Old.TC.left i j)))
     (trans (TO.diff-compose w (New.TC.right i j) (Old.TC.right i j) (Old.TC.left i j))
      (ap (\ z -> (M.presheaf.module-at w).madd z (Old.TC.cocycle i j)) (sym right-eq)))) ;
  equation : Id (M.presheaf.module-at w).M (New.TC.cocycle i j)
   ((M.presheaf.module-at w).madd (Old.TC.cocycle i j) (C.delta bs i j)) =
   trans (sym (Additive.sub-cancel-right (New.TC.cocycle i j) left))
    (trans (ap (\ z -> Laws.sub z left) compose)
     (trans (ap (\ z -> Laws.sub z left) ((M.presheaf.module-at w).maddC right (Old.TC.cocycle i j)))
      (trans (Laws.sub-at ((M.presheaf.module-at w).madd (Old.TC.cocycle i j) right) left)
       (trans (sym ((M.presheaf.module-at w).maddA (Old.TC.cocycle i j) right ((M.presheaf.module-at w).mneg left)))
        (ap ((M.presheaf.module-at w).madd (Old.TC.cocycle i j)) (sym (Laws.sub-at right left))))))) ;
  value-equation : Id (M.presheaf.module-at w).M (Z.value New.cocycle i j)
   (C.C1.product.madd (Z.value Old.cocycle) (Z.Translation.D.map C.coboundary bs) i j) =
   trans (ap (\ z -> z i j) New.cocycle-value)
    (trans equation
     (cong2 (M.presheaf.module-at w).M (M.presheaf.module-at w).madd _ _ _ _
      (sym (ap (\ z -> z i j) Old.cocycle-value))
      (sym (ap (\ z -> z i j) (C.coboundary-at bs))))) ;
 } ;
 witness : Z.Translation.Witness (Z.value Old.cocycle) (Z.value New.cocycle) =
  (bs,C.C1.ext _ _ (\ i -> C.Row[i].Product.ext _ _ (\ j -> Pair[i,j].value-equation))) ;
 related : Z.Related Old.cocycle New.cocycle =
  Tr.Trunc[Z.Translation.Witness (Z.value Old.cocycle) (Z.value New.cocycle)].inc witness ;
 class-equal : Id Z.H1 Old.class New.class =
  trans Old.class-at (trans (Z.Q.relates Old.cocycle New.cocycle related) (sym New.class-at)) ;
} ;
