-- The universal property of the doubling (DESIGN.md, Next 4, interface (a)).
--
-- Let Y2 be the doubling of Y along d, with charts e = (top, d) and
-- e2 = (d, top) (Chart) and fold map Y2 -> Y (Fold).  For X locally ringed,
--  maps psi : X -> Y2   <->   (f, u0, u1),  f : X -> Y,
--                             u0 \/ u1 = top,  u0 /\ u1 = f*(d),
-- by psi |-> (fold . psi, psi*(e), psi*(e2)) and IntoDoubling backwards;
-- local maps correspond to local f (Compose.Local, IntoDoubling.Local).
-- Forward.  psi*(e) \/ psi*(e2) = psi*(e \/ e2) = psi*(top) = top, and
--  psi*(e) /\ psi*(e2) = psi*(e /\ e2) = psi*(d, d) = (fold . psi)*(d).
-- Lemma (decompose).  x = (a, b) is (e /\ (a, a)) \/ (e2 /\ (b, b)):
--  first components a \/ (d /\ b) = a \/ (a /\ d) = a (b /\ d = a /\ d);
--  symmetrically for the second.
-- Law 1 (psi |-> triple |-> psi2 is psi).  Lattice: psi2(x) =
--  (psi e /\ psi(a, a)) \/ (psi e2 /\ psi(b, b)) = psi((e /\ (a, a)) \/
--  (e2 /\ (b, b))) = psi(x).  Ring maps: psi(x) is covered by psi(y0),
--  psi(y1), y0 = e /\ (a, a), y1 = e2 /\ (b, b).  On psi(y0) <= psi e /\
--  psi(a, a), psi2#(s, t) restricts to psi#(s, s) (IntoDoubling parts),
--  i.e. to psi#((s, s)|y0) (psi natural), and (s, s)|y0 = (s, t)|y0: the
--  first components are restrictions of s, the second ones restrictions of
--  s and t to d /\ a <= mid (a, b), where they agree.  Then psi#((s, t)|y0)
--  is psi#(s, t)|psi(y0) (psi natural); the same on psi(y1); separation.
-- Law 2 (triple |-> psi |-> triple).  (fold . psi)*(a) = (u0 /\ f* a) \/
--  (u1 /\ f* a) = f* a /\ (u0 \/ u1) = f* a; on the parts u_i /\ f* a of
--  this cover, psi#(s, s) restricts to f#(s) (IntoDoubling parts);
--  separation.  psi*(e) = (u0 /\ f* top) \/ (u1 /\ f* d) = u0, as
--  f* d = u0 /\ u1 <= u0; symmetrically psi*(e2) = u1.
-- Equality of maps is stated as in SpecUnique: lattice maps pointwise,
-- ring maps after the restriction along that equality.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (Y : LocallyRinged[l].On[L].LocallyRinged) (d : L.L)
 (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 module O = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module Fd = Fold[l].Over[L,Y,d] ;
 module Ch = Chart[l].Over[L,Y,d] ;
 module Dbl = Fd.Dbl ;
 module DD = Fd.DD ;
 module GY = Fd.GO ;
 module GX = RingedLattice[l].On[M].Of[X.sheaf] ;
 module XS = RingedLattice[l].On[M].Sheaf[X.sheaf,X.is-sheaf] ;
 module Mp = LocallyRinged[l].Maps[DD.lattice,M,Dbl.doubled.sheaf,X.sheaf] ;
 module Mf = LocallyRinged[l].Maps[L,M,Y.sheaf,X.sheaf] ;
 module Cp = Compose[l].Maps[L,DD.lattice,M,Y.sheaf,Dbl.doubled.sheaf,X.sheaf] ;

 -- e \/ e2 = top and e /\ e2 = (d, d)
 e-join : Id DD.Opens (DD.joinD Ch.e Ch.e2) DD.topD =
  DD.ext (DD.joinD Ch.e Ch.e2) DD.topD (O.le-antisym (L.join L.top d) L.top (O.le-top (L.join L.top d)) (O.join-left L.top d))
   (O.le-antisym (L.join d L.top) L.top (O.le-top (L.join d L.top)) (O.join-right d L.top)) ;
 e-meet : Id DD.Opens (DD.meetD Ch.e Ch.e2) (Fd.diag d) =
  DD.ext (DD.meetD Ch.e Ch.e2) (Fd.diag d) (O.top-meet d) (L.meetT d) ;
 -- (decompose)
 decompose (x : DD.Opens) :
  Id DD.Opens (DD.joinD (DD.meetD Ch.e (Fd.diag (DD.first x))) (DD.meetD Ch.e2 (Fd.diag (DD.second x)))) x =
  DD.ext (DD.joinD (DD.meetD Ch.e (Fd.diag (DD.first x))) (DD.meetD Ch.e2 (Fd.diag (DD.second x)))) x
   (calc L.L {
     L.join (L.meet L.top (DD.first x)) (L.meet d (DD.second x))
      =< cong2 L.L L.join _ _ _ _ (O.top-meet (DD.first x)) (trans (L.meetC d (DD.second x)) (sym (DD.overlap x)))
      > L.join (DD.first x) (L.meet (DD.first x) d)
      =< L.absorb-join (DD.first x) d > DD.first x })
   (calc L.L {
     L.join (L.meet d (DD.first x)) (L.meet L.top (DD.second x))
      =< cong2 L.L L.join _ _ _ _ (trans (L.meetC d (DD.first x)) (DD.overlap x)) (O.top-meet (DD.second x))
      > L.join (L.meet (DD.second x) d) (DD.second x)
      =< L.joinC (L.meet (DD.second x) d) (DD.second x) > L.join (DD.second x) (L.meet (DD.second x) d)
      =< L.absorb-join (DD.second x) d > DD.second x }) ;

 -- from a map into the doubling, the triple
 module Of (psi : Mp.Ringed) {
  module C = Cp.Of[psi,Fd.fold] ;
  covers : Id M.L (M.join (DL.hmap psi.lat Ch.e) (DL.hmap psi.lat Ch.e2)) M.top = calc M.L {
   M.join (DL.hmap psi.lat Ch.e) (DL.hmap psi.lat Ch.e2)
    =< sym (DL.hmap-join psi.lat Ch.e Ch.e2) > DL.hmap psi.lat (DD.joinD Ch.e Ch.e2)
    =< ap (DL.hmap psi.lat) e-join > DL.hmap psi.lat DD.topD
    =< DL.hmap-top psi.lat > M.top } ;
  overlap : Id M.L (M.meet (DL.hmap psi.lat Ch.e) (DL.hmap psi.lat Ch.e2)) (DL.hmap C.composite.lat d) = calc M.L {
   M.meet (DL.hmap psi.lat Ch.e) (DL.hmap psi.lat Ch.e2)
    =< sym (DL.hmap-meet psi.lat Ch.e Ch.e2) > DL.hmap psi.lat (DD.meetD Ch.e Ch.e2)
    =< ap (DL.hmap psi.lat) e-meet > DL.hmap psi.lat (Fd.diag d) } ;
  -- f = fold . psi is local when psi is
  local (psi-local : Mp.Of[psi,Dbl.doubled.inv,X.inv].IsLocal) : Mf.Of[C.composite,Y.inv,X.inv].IsLocal =
   C.Local[Y.inv,Dbl.doubled.inv,X.inv,Fd.local,psi-local].local ;

  -- and back: the map of the triple is psi (law 1)
  module B = IntoDoubling[l].Over[L,Y,d,M,X,C.composite,DL.hmap psi.lat Ch.e,DL.hmap psi.lat Ch.e2,covers,overlap] ;
  lat-eq (x : DD.Opens) : Id M.L (DL.hmap B.psi.lat x) (DL.hmap psi.lat x) = calc M.L {
   DL.hmap B.psi.lat x
    =< cong2 M.L M.join _ _ _ _ (sym (DL.hmap-meet psi.lat Ch.e (Fd.diag (DD.first x))))
        (sym (DL.hmap-meet psi.lat Ch.e2 (Fd.diag (DD.second x))))
    > M.join (DL.hmap psi.lat (DD.meetD Ch.e (Fd.diag (DD.first x)))) (DL.hmap psi.lat (DD.meetD Ch.e2 (Fd.diag (DD.second x))))
    =< sym (DL.hmap-join psi.lat (DD.meetD Ch.e (Fd.diag (DD.first x))) (DD.meetD Ch.e2 (Fd.diag (DD.second x))))
    > DL.hmap psi.lat (DD.joinD (DD.meetD Ch.e (Fd.diag (DD.first x))) (DD.meetD Ch.e2 (Fd.diag (DD.second x))))
    =< ap (DL.hmap psi.lat) (decompose x) > DL.hmap psi.lat x } ;
  le (x : DD.Opens) : OM.Le (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) =
   OM.le-of-eq (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) (sym (lat-eq x)) ;
  module Sharp (x : DD.Opens) (z : (Dbl.ring x).R) {
   module PL = DL.JoinMaps[DD.lattice,M,psi.lat] ;
   y0 : DD.Opens = DD.meetD Ch.e (Fd.diag (DD.first x)) ;
   y1 : DD.Opens = DD.meetD Ch.e2 (Fd.diag (DD.second x)) ;
   k0 : DD.OD.Le y0 x = Pr.subst DD.Opens (DD.OD.Le y0) (DD.joinD y0 y1) x (decompose x) (DD.OD.join-left y0 y1) ;
   k1 : DD.OD.Le y1 x = Pr.subst DD.Opens (DD.OD.Le y1) (DD.joinD y0 y1) x (decompose x) (DD.OD.join-right y0 y1) ;
   c0 : DD.OD.Le y0 (Fd.diag (DD.first x)) = DD.OD.meet-right Ch.e (Fd.diag (DD.first x)) ;
   c1 : DD.OD.Le y1 (Fd.diag (DD.second x)) = DD.OD.meet-right Ch.e2 (Fd.diag (DD.second x)) ;
   -- (s, s)|y0 = (s, t)|y0: second components through d /\ a <= mid x
   n0 : O.Le (DD.second y0) (DD.mid x) = O.le-of-eq (L.meet d (DD.first x)) (DD.mid x) (L.meetC d (DD.first x)) ;
   agree0 : Id (Dbl.ring y0).R (map (Dbl.res y0 (Fd.diag (DD.first x)) c0) (map (Fd.sharp (DD.first x)) (Dbl.left x z)))
    (map (Dbl.res y0 x k0) z) =
    Dbl.ext y0 (map (Dbl.res y0 (Fd.diag (DD.first x)) c0) (map (Fd.sharp (DD.first x)) (Dbl.left x z))) (map (Dbl.res y0 x k0) z)
     (GY.res-irr (DD.first y0) (DD.first x) (Dbl.Res[y0,Fd.diag (DD.first x),c0].k1) (Dbl.Res[y0,x,k0].k1) (Dbl.left x z))
     (calc (Y.sheaf.ring (DD.second y0)).R {
       GY.restrict (DD.second y0) (DD.first x) (Dbl.Res[y0,Fd.diag (DD.first x),c0].k2) (Dbl.left x z)
        =< sym (Y.sheaf.res-comp (DD.second y0) (DD.mid x) (DD.first x) n0 (DD.mid-first x) (Dbl.Res[y0,Fd.diag (DD.first x),c0].k2)
             (Dbl.left x z))
        > GY.restrict (DD.second y0) (DD.mid x) n0 (GY.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (Dbl.left x z))
        =< ap (GY.restrict (DD.second y0) (DD.mid x) n0) (Dbl.agree x z)
        > GY.restrict (DD.second y0) (DD.mid x) n0 (GY.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (Dbl.right x z))
        =< Y.sheaf.res-comp (DD.second y0) (DD.mid x) (DD.second x) n0 (DD.mid-second x) (Dbl.Res[y0,x,k0].k2) (Dbl.right x z)
        > GY.restrict (DD.second y0) (DD.second x) (Dbl.Res[y0,x,k0].k2) (Dbl.right x z) }) ;
   -- (t, t)|y1 = (s, t)|y1: first components through d /\ b <= mid x
   n1 : O.Le (DD.first y1) (DD.mid x) =
    O.le-of-eq (L.meet d (DD.second x)) (DD.mid x) (trans (L.meetC d (DD.second x)) (sym (DD.overlap x))) ;
   agree1 : Id (Dbl.ring y1).R (map (Dbl.res y1 (Fd.diag (DD.second x)) c1) (map (Fd.sharp (DD.second x)) (Dbl.right x z)))
    (map (Dbl.res y1 x k1) z) =
    Dbl.ext y1 (map (Dbl.res y1 (Fd.diag (DD.second x)) c1) (map (Fd.sharp (DD.second x)) (Dbl.right x z))) (map (Dbl.res y1 x k1) z)
     (calc (Y.sheaf.ring (DD.first y1)).R {
       GY.restrict (DD.first y1) (DD.second x) (Dbl.Res[y1,Fd.diag (DD.second x),c1].k1) (Dbl.right x z)
        =< sym (Y.sheaf.res-comp (DD.first y1) (DD.mid x) (DD.second x) n1 (DD.mid-second x) (Dbl.Res[y1,Fd.diag (DD.second x),c1].k1)
             (Dbl.right x z))
        > GY.restrict (DD.first y1) (DD.mid x) n1 (GY.restrict (DD.mid x) (DD.second x) (DD.mid-second x) (Dbl.right x z))
        =< ap (GY.restrict (DD.first y1) (DD.mid x) n1) (sym (Dbl.agree x z))
        > GY.restrict (DD.first y1) (DD.mid x) n1 (GY.restrict (DD.mid x) (DD.first x) (DD.mid-first x) (Dbl.left x z))
        =< Y.sheaf.res-comp (DD.first y1) (DD.mid x) (DD.first x) n1 (DD.mid-first x) (Dbl.Res[y1,x,k1].k1) (Dbl.left x z)
        > GY.restrict (DD.first y1) (DD.first x) (Dbl.Res[y1,x,k1].k1) (Dbl.left x z) })
     (GY.res-irr (DD.second y1) (DD.second x) (Dbl.Res[y1,Fd.diag (DD.second x),c1].k2) (Dbl.Res[y1,x,k1].k2) (Dbl.right x z)) ;
   -- psi(x) is covered by psi(y0), psi(y1)
   m0 : OM.Le (DL.hmap psi.lat y0) (DL.hmap psi.lat x) = PL.monotone y0 x k0 ;
   m1 : OM.Le (DL.hmap psi.lat y1) (DL.hmap psi.lat x) = PL.monotone y1 x k1 ;
   cov : OM.Le (DL.hmap psi.lat x) (M.join (DL.hmap psi.lat y0) (DL.hmap psi.lat y1)) =
    OM.le-of-eq (DL.hmap psi.lat x) (M.join (DL.hmap psi.lat y0) (DL.hmap psi.lat y1))
     (trans (ap (DL.hmap psi.lat) (sym (decompose x))) (DL.hmap-join psi.lat y0 y1)) ;
   module T = XS.Two[DL.hmap psi.lat x,DL.hmap psi.lat y0,DL.hmap psi.lat y1,m0,m1,cov] ;
   q0 : OM.Le (DL.hmap psi.lat y0) (DL.hmap B.psi.lat x) = OM.le-trans (DL.hmap psi.lat y0) (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) m0 (le x) ;
   q1 : OM.Le (DL.hmap psi.lat y1) (DL.hmap B.psi.lat x) = OM.le-trans (DL.hmap psi.lat y1) (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) m1 (le x) ;
   on0 : Id (X.sheaf.ring (DL.hmap psi.lat y0)).R
    (GX.restrict (DL.hmap psi.lat y0) (DL.hmap psi.lat x) m0 (GX.restrict (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) (le x) (map (B.psi.sharp x) z)))
    (GX.restrict (DL.hmap psi.lat y0) (DL.hmap psi.lat x) m0 (map (psi.sharp x) z)) = calc (X.sheaf.ring (DL.hmap psi.lat y0)).R {
    GX.restrict (DL.hmap psi.lat y0) (DL.hmap psi.lat x) m0 (GX.restrict (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) (le x) (map (B.psi.sharp x) z))
     =< X.sheaf.res-comp (DL.hmap psi.lat y0) (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) m0 (le x) q0 (map (B.psi.sharp x) z)
     > GX.restrict (DL.hmap psi.lat y0) (DL.hmap B.psi.lat x) q0 (map (B.psi.sharp x) z)
     =< B.At[x].restrict0 z (DL.hmap psi.lat y0)
         (OM.le-of-eq _ _ (DL.hmap-meet psi.lat Ch.e (Fd.diag (DD.first x)))) q0 (PL.monotone y0 (Fd.diag (DD.first x)) c0)
     > GX.restrict (DL.hmap psi.lat y0) (DL.hmap psi.lat (Fd.diag (DD.first x))) (PL.monotone y0 (Fd.diag (DD.first x)) c0)
        (map (psi.sharp (Fd.diag (DD.first x))) (map (Fd.sharp (DD.first x)) (Dbl.left x z)))
     =< psi.natural y0 (Fd.diag (DD.first x)) c0 (map (Fd.sharp (DD.first x)) (Dbl.left x z))
     > map (psi.sharp y0) (map (Dbl.res y0 (Fd.diag (DD.first x)) c0) (map (Fd.sharp (DD.first x)) (Dbl.left x z)))
     =< ap (map (psi.sharp y0)) agree0 > map (psi.sharp y0) (map (Dbl.res y0 x k0) z)
     =< sym (psi.natural y0 x k0 z) > GX.restrict (DL.hmap psi.lat y0) (DL.hmap psi.lat x) m0 (map (psi.sharp x) z) } ;
   on1 : Id (X.sheaf.ring (DL.hmap psi.lat y1)).R
    (GX.restrict (DL.hmap psi.lat y1) (DL.hmap psi.lat x) m1 (GX.restrict (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) (le x) (map (B.psi.sharp x) z)))
    (GX.restrict (DL.hmap psi.lat y1) (DL.hmap psi.lat x) m1 (map (psi.sharp x) z)) = calc (X.sheaf.ring (DL.hmap psi.lat y1)).R {
    GX.restrict (DL.hmap psi.lat y1) (DL.hmap psi.lat x) m1 (GX.restrict (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) (le x) (map (B.psi.sharp x) z))
     =< X.sheaf.res-comp (DL.hmap psi.lat y1) (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) m1 (le x) q1 (map (B.psi.sharp x) z)
     > GX.restrict (DL.hmap psi.lat y1) (DL.hmap B.psi.lat x) q1 (map (B.psi.sharp x) z)
     =< B.At[x].restrict1 z (DL.hmap psi.lat y1)
         (OM.le-of-eq _ _ (DL.hmap-meet psi.lat Ch.e2 (Fd.diag (DD.second x)))) q1 (PL.monotone y1 (Fd.diag (DD.second x)) c1)
     > GX.restrict (DL.hmap psi.lat y1) (DL.hmap psi.lat (Fd.diag (DD.second x))) (PL.monotone y1 (Fd.diag (DD.second x)) c1)
        (map (psi.sharp (Fd.diag (DD.second x))) (map (Fd.sharp (DD.second x)) (Dbl.right x z)))
     =< psi.natural y1 (Fd.diag (DD.second x)) c1 (map (Fd.sharp (DD.second x)) (Dbl.right x z))
     > map (psi.sharp y1) (map (Dbl.res y1 (Fd.diag (DD.second x)) c1) (map (Fd.sharp (DD.second x)) (Dbl.right x z)))
     =< ap (map (psi.sharp y1)) agree1 > map (psi.sharp y1) (map (Dbl.res y1 x k1) z)
     =< sym (psi.natural y1 x k1 z) > GX.restrict (DL.hmap psi.lat y1) (DL.hmap psi.lat x) m1 (map (psi.sharp x) z) } ;
   sharp-eq : Id (X.sheaf.ring (DL.hmap psi.lat x)).R
    (GX.restrict (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) (le x) (map (B.psi.sharp x) z)) (map (psi.sharp x) z) =
    T.separated (GX.restrict (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) (le x) (map (B.psi.sharp x) z)) (map (psi.sharp x) z) on0 on1 ;
  } ;
  sharp-eq (x : DD.Opens) (z : (Dbl.ring x).R) :
   Id (X.sheaf.ring (DL.hmap psi.lat x)).R
    (GX.restrict (DL.hmap psi.lat x) (DL.hmap B.psi.lat x) (le x) (map (B.psi.sharp x) z)) (map (psi.sharp x) z) =
   Sharp[x,z].sharp-eq ;
 } ;

 -- from a triple, the map, and back (law 2)
 module From (f : Mf.Ringed) (u0 u1 : M.L) (covers : Id M.L (M.join u0 u1) M.top)
  (overlap : Id M.L (M.meet u0 u1) (DL.hmap f.lat d)) {
  module B = IntoDoubling[l].Over[L,Y,d,M,X,f,u0,u1,covers,overlap] ;
  module C = Cp.Of[B.psi,Fd.fold] ;
  lat-eq (a : L.L) : Id M.L (DL.hmap C.composite.lat a) (DL.hmap f.lat a) = calc M.L {
   DL.hmap C.composite.lat a
    =< cong2 M.L M.join _ _ _ _ (M.meetC u0 (DL.hmap f.lat a)) (M.meetC u1 (DL.hmap f.lat a))
    > M.join (M.meet (DL.hmap f.lat a) u0) (M.meet (DL.hmap f.lat a) u1)
    =< sym (M.dist (DL.hmap f.lat a) u0 u1) > M.meet (DL.hmap f.lat a) (M.join u0 u1)
    =< ap (M.meet (DL.hmap f.lat a)) covers > M.meet (DL.hmap f.lat a) M.top
    =< M.meetT (DL.hmap f.lat a) > DL.hmap f.lat a } ;
  le (a : L.L) : OM.Le (DL.hmap f.lat a) (DL.hmap C.composite.lat a) =
   OM.le-of-eq (DL.hmap f.lat a) (DL.hmap C.composite.lat a) (sym (lat-eq a)) ;
  module Sharp (a : L.L) (s : (Y.sheaf.ring a).R) {
   r0 : OM.Le (B.part0 (Fd.diag a)) (DL.hmap f.lat a) = OM.meet-right u0 (DL.hmap f.lat a) ;
   r1 : OM.Le (B.part1 (Fd.diag a)) (DL.hmap f.lat a) = OM.meet-right u1 (DL.hmap f.lat a) ;
   module T = XS.Two[DL.hmap f.lat a,B.part0 (Fd.diag a),B.part1 (Fd.diag a),r0,r1,le a] ;
   j0 : OM.Le (B.part0 (Fd.diag a)) (B.image (Fd.diag a)) = OM.join-left (B.part0 (Fd.diag a)) (B.part1 (Fd.diag a)) ;
   j1 : OM.Le (B.part1 (Fd.diag a)) (B.image (Fd.diag a)) = OM.join-right (B.part0 (Fd.diag a)) (B.part1 (Fd.diag a)) ;
   on0 : Id (X.sheaf.ring (B.part0 (Fd.diag a))).R
    (GX.restrict (B.part0 (Fd.diag a)) (DL.hmap f.lat a) r0
      (GX.restrict (DL.hmap f.lat a) (DL.hmap C.composite.lat a) (le a) (map (C.composite.sharp a) s)))
    (GX.restrict (B.part0 (Fd.diag a)) (DL.hmap f.lat a) r0 (map (f.sharp a) s)) =
    calc (X.sheaf.ring (B.part0 (Fd.diag a))).R {
     GX.restrict (B.part0 (Fd.diag a)) (DL.hmap f.lat a) r0
      (GX.restrict (DL.hmap f.lat a) (DL.hmap C.composite.lat a) (le a) (map (C.composite.sharp a) s))
      =< X.sheaf.res-comp (B.part0 (Fd.diag a)) (DL.hmap f.lat a) (DL.hmap C.composite.lat a) r0 (le a) j0 (map (C.composite.sharp a) s)
      > GX.restrict (B.part0 (Fd.diag a)) (DL.hmap C.composite.lat a) j0 (map (C.composite.sharp a) s)
      =< refl (GX.restrict (B.part0 (Fd.diag a)) (B.image (Fd.diag a)) j0 (map (B.sharp (Fd.diag a)) (map (Fd.sharp a) s)))
      > GX.restrict (B.part0 (Fd.diag a)) (B.image (Fd.diag a)) j0 (map (B.sharp (Fd.diag a)) (map (Fd.sharp a) s))
      =< B.At[Fd.diag a].restrict0 (map (Fd.sharp a) s) (B.part0 (Fd.diag a)) (OM.le-refl (B.part0 (Fd.diag a))) j0 r0
      > GX.restrict (B.part0 (Fd.diag a)) (DL.hmap f.lat a) r0 (map (f.sharp a) s) } ;
   on1 : Id (X.sheaf.ring (B.part1 (Fd.diag a))).R
    (GX.restrict (B.part1 (Fd.diag a)) (DL.hmap f.lat a) r1
      (GX.restrict (DL.hmap f.lat a) (DL.hmap C.composite.lat a) (le a) (map (C.composite.sharp a) s)))
    (GX.restrict (B.part1 (Fd.diag a)) (DL.hmap f.lat a) r1 (map (f.sharp a) s)) =
    calc (X.sheaf.ring (B.part1 (Fd.diag a))).R {
     GX.restrict (B.part1 (Fd.diag a)) (DL.hmap f.lat a) r1
      (GX.restrict (DL.hmap f.lat a) (DL.hmap C.composite.lat a) (le a) (map (C.composite.sharp a) s))
      =< X.sheaf.res-comp (B.part1 (Fd.diag a)) (DL.hmap f.lat a) (DL.hmap C.composite.lat a) r1 (le a) j1 (map (C.composite.sharp a) s)
      > GX.restrict (B.part1 (Fd.diag a)) (DL.hmap C.composite.lat a) j1 (map (C.composite.sharp a) s)
      =< refl (GX.restrict (B.part1 (Fd.diag a)) (B.image (Fd.diag a)) j1 (map (B.sharp (Fd.diag a)) (map (Fd.sharp a) s)))
      > GX.restrict (B.part1 (Fd.diag a)) (B.image (Fd.diag a)) j1 (map (B.sharp (Fd.diag a)) (map (Fd.sharp a) s))
      =< B.At[Fd.diag a].restrict1 (map (Fd.sharp a) s) (B.part1 (Fd.diag a)) (OM.le-refl (B.part1 (Fd.diag a))) j1 r1
      > GX.restrict (B.part1 (Fd.diag a)) (DL.hmap f.lat a) r1 (map (f.sharp a) s) } ;
   sharp-eq : Id (X.sheaf.ring (DL.hmap f.lat a)).R
    (GX.restrict (DL.hmap f.lat a) (DL.hmap C.composite.lat a) (le a) (map (C.composite.sharp a) s)) (map (f.sharp a) s) =
    T.separated (GX.restrict (DL.hmap f.lat a) (DL.hmap C.composite.lat a) (le a) (map (C.composite.sharp a) s)) (map (f.sharp a) s) on0 on1 ;
  } ;
  sharp-eq (a : L.L) (s : (Y.sheaf.ring a).R) :
   Id (X.sheaf.ring (DL.hmap f.lat a)).R
    (GX.restrict (DL.hmap f.lat a) (DL.hmap C.composite.lat a) (le a) (map (C.composite.sharp a) s)) (map (f.sharp a) s) =
   Sharp[a,s].sharp-eq ;
  -- the inverse images of the charts
  chart0 : Id M.L (DL.hmap B.psi.lat Ch.e) u0 =
   OM.le-antisym (DL.hmap B.psi.lat Ch.e) u0
    (OM.join-lub (B.part0 Ch.e) (B.part1 Ch.e) u0 (B.in0 Ch.e (B.part0 Ch.e) (OM.le-refl (B.part0 Ch.e)))
      (OM.le-trans (B.part1 Ch.e) (DL.hmap f.lat d) u0 (B.at1 Ch.e (B.part1 Ch.e) (OM.le-refl (B.part1 Ch.e)))
        (OM.le-trans (DL.hmap f.lat d) (M.meet u0 u1) u0 (OM.le-of-eq (DL.hmap f.lat d) (M.meet u0 u1) (sym overlap)) (OM.meet-left u0 u1))))
    (OM.le-trans u0 (B.part0 Ch.e) (DL.hmap B.psi.lat Ch.e)
      (OM.meet-glb u0 (DL.hmap f.lat L.top) u0 (OM.le-refl u0)
        (OM.le-trans u0 M.top (DL.hmap f.lat L.top) (OM.le-top u0) (OM.le-of-eq M.top (DL.hmap f.lat L.top) (sym (DL.hmap-top f.lat)))))
      (OM.join-left (B.part0 Ch.e) (B.part1 Ch.e))) ;
  chart1 : Id M.L (DL.hmap B.psi.lat Ch.e2) u1 =
   OM.le-antisym (DL.hmap B.psi.lat Ch.e2) u1
    (OM.join-lub (B.part0 Ch.e2) (B.part1 Ch.e2) u1
      (OM.le-trans (B.part0 Ch.e2) (DL.hmap f.lat d) u1 (B.at0 Ch.e2 (B.part0 Ch.e2) (OM.le-refl (B.part0 Ch.e2)))
        (OM.le-trans (DL.hmap f.lat d) (M.meet u0 u1) u1 (OM.le-of-eq (DL.hmap f.lat d) (M.meet u0 u1) (sym overlap)) (OM.meet-right u0 u1)))
      (B.in1 Ch.e2 (B.part1 Ch.e2) (OM.le-refl (B.part1 Ch.e2))))
    (OM.le-trans u1 (B.part1 Ch.e2) (DL.hmap B.psi.lat Ch.e2)
      (OM.meet-glb u1 (DL.hmap f.lat L.top) u1 (OM.le-refl u1)
        (OM.le-trans u1 M.top (DL.hmap f.lat L.top) (OM.le-top u1) (OM.le-of-eq M.top (DL.hmap f.lat L.top) (sym (DL.hmap-top f.lat)))))
      (OM.join-right (B.part0 Ch.e2) (B.part1 Ch.e2))) ;
 } ;

 -- the equivalence (MapEquality turns the two laws into equalities)
 module EP = MapEquality[l].Maps[DD.lattice,M,Dbl.doubled.sheaf,X.sheaf] ;
 module EF = MapEquality[l].Maps[L,M,Y.sheaf,X.sheaf] ;
 Triple : U l = (p : Mf.Ringed * M.L * M.L) *
  (Id M.L (M.join p.2.1 p.2.2) M.top * Id M.L (M.meet p.2.1 p.2.2) (DL.hmap p.1.lat d)) ;
 conditions-prop (p : Mf.Ringed * M.L * M.L) :
  Pr.isProp (Id M.L (M.join p.2.1 p.2.2) M.top * Id M.L (M.meet p.2.1 p.2.2) (DL.hmap p.1.lat d)) =
  Pr.isProp-Sigma (Id M.L (M.join p.2.1 p.2.2) M.top) (\ c -> Id M.L (M.meet p.2.1 p.2.2) (DL.hmap p.1.lat d))
   (M.setL (M.join p.2.1 p.2.2) M.top) (\ c -> M.setL (M.meet p.2.1 p.2.2) (DL.hmap p.1.lat d)) ;
 triple (psi : Mp.Ringed) : Triple =
  ((Of[psi].C.composite,DL.hmap psi.lat Ch.e,DL.hmap psi.lat Ch.e2),Of[psi].covers,Of[psi].overlap) ;
 map-of (t : Triple) : Mp.Ringed = From[t.1.1,t.1.2.1,t.1.2.2,t.2.1,t.2.2].B.psi ;
 law1 (psi : Mp.Ringed) : Id Mp.Ringed (map-of (triple psi)) psi =
  EP.ext (Of[psi].B.psi) psi (Of[psi].lat-eq) (Of[psi].le) (Of[psi].sharp-eq) ;
 module Back (t : Triple) {
  module Fr = From[t.1.1,t.1.2.1,t.1.2.2,t.2.1,t.2.2] ;
  -- fold . psi = f
  fold-eq : Id Mf.Ringed Fr.C.composite t.1.1 = EF.ext Fr.C.composite t.1.1 Fr.lat-eq Fr.le Fr.sharp-eq ;
  parts : Id (Mf.Ringed * M.L * M.L) (Fr.C.composite,DL.hmap Fr.B.psi.lat Ch.e,DL.hmap Fr.B.psi.lat Ch.e2) t.1 =
   calc (Mf.Ringed * M.L * M.L) {
    (Fr.C.composite,DL.hmap Fr.B.psi.lat Ch.e,DL.hmap Fr.B.psi.lat Ch.e2)
     =< ap (\ g -> (g,DL.hmap Fr.B.psi.lat Ch.e,DL.hmap Fr.B.psi.lat Ch.e2)) fold-eq
     > (t.1.1,DL.hmap Fr.B.psi.lat Ch.e,DL.hmap Fr.B.psi.lat Ch.e2)
     =< ap (\ v -> (t.1.1,v,DL.hmap Fr.B.psi.lat Ch.e2)) Fr.chart0 > (t.1.1,t.1.2.1,DL.hmap Fr.B.psi.lat Ch.e2)
     =< ap (\ v -> (t.1.1,t.1.2.1,v)) Fr.chart1 > t.1 } ;
  law2 : Id Triple (triple (map-of t)) t =
   Pr.Sigma-eq (Mf.Ringed * M.L * M.L)
    (\ p -> Id M.L (M.join p.2.1 p.2.2) M.top * Id M.L (M.meet p.2.1 p.2.2) (DL.hmap p.1.lat d))
    (triple (map-of t)).1 t.1 (triple (map-of t)).2 t.2 parts (conditions-prop t.1) ;
 } ;
 law2 (t : Triple) : Id Triple (triple (map-of t)) t = Back[t].law2 ;
 -- maps X -> Y2 are the triples
 equivalence : Pr.isEquiv Mp.Ringed Triple triple = Pr.qinv Mp.Ringed Triple triple map-of law2 law1 ;

 -- local maps X -> Y2 are the triples with f local
 module ELP = EP.Local[Dbl.doubled.inv,X.inv] ;
 module ELF = EF.Local[Y.inv,X.inv] ;
 LocalTriple : U l = (t : Triple) * Mf.Of[t.1.1,Y.inv,X.inv].IsLocal ;
 local-triple (a : ELP.LocalMap) : LocalTriple = (triple a.1,Of[a.1].local a.2) ;
 local-map-of (b : LocalTriple) : ELP.LocalMap =
  (map-of b.1,From[b.1.1.1,b.1.1.2.1,b.1.1.2.2,b.1.2.1,b.1.2.2].B.Local[b.2].local) ;
 local-equivalence : Pr.isEquiv ELP.LocalMap LocalTriple local-triple =
  Pr.qinv ELP.LocalMap LocalTriple local-triple local-map-of
   (\ b -> Pr.Sigma-eq Triple (\ t -> Mf.Of[t.1.1,Y.inv,X.inv].IsLocal) (local-triple (local-map-of b)).1 b.1
     (local-triple (local-map-of b)).2 b.2 (law2 b.1) (ELF.local-prop b.1.1.1))
   (\ a -> ELP.local-ext (local-map-of (local-triple a)) a (law1 a.1)) ;
} ;
