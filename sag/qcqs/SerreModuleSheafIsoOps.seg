-- Identity and composition of natural linear equivalences of sheaves.
-- Components are the identity or composition of the given linear maps.
-- Naturality follows from their naturality squares; inverse data compose
-- pointwise. These operations preserve the existing sheaf carriers.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module Over (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf) {
 module I = SerreModuleSheafIso[l].On[L,G] ;
 module Identity (E : MS.On[L,G].Presheaf) {
  module Maps = MS.On[L,G].Transform[E,E] ;
  component (a : L.L) : MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,E.module-at a].Hom =
   new MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,E.module-at a].Hom[
    \ x -> x,\ x y -> refl ((E.module-at a).madd x y),\ r x -> refl ((E.module-at a).sm r x)] ;
  identity : Maps.Hom = new Maps.Hom[component,\ a b k x -> refl (MS.On[L,G].Of[E].restrict a b k x)] ;
  identity-at (a : L.L) (x : (E.module-at a).M) : Id (E.module-at a).M (Maps.at identity a x) x = refl x ;
  equivalence : I.Equivalence E E = (identity,\ a -> Pr.qinv (E.module-at a).M (E.module-at a).M
   (Maps.at identity a) (\ x -> x) (identity-at a) (identity-at a)) ;
  opaque identity ;
 } ;
 module Composite (E F H : MS.On[L,G].Presheaf) (ef : I.Equivalence E F) (fh : I.Equivalence F H) {
  module EF = MS.On[L,G].Transform[E,F] ; module FH = MS.On[L,G].Transform[F,H] ;
  module EH = MS.On[L,G].Transform[E,H] ;
  component (a : L.L) : MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,H.module-at a].Hom =
   new MM.Between[G.ring a,G.ring a,RingHom[l].identity (G.ring a),E.module-at a,H.module-at a].Hom[
    \ x -> FH.at (I.forward fh) a (EF.at (I.forward ef) a x),
    \ x y -> trans (ap (FH.at (I.forward fh) a) (EF.at-add (I.forward ef) a x y))
     (FH.at-add (I.forward fh) a (EF.at (I.forward ef) a x) (EF.at (I.forward ef) a y)),
    \ r x -> trans (ap (FH.at (I.forward fh) a) (EF.at-scale (I.forward ef) a r x))
     (FH.at-scale (I.forward fh) a r (EF.at (I.forward ef) a x))] ;
  natural (a b : L.L) (k : DL.Order[L].Le a b) (x : (E.module-at b).M) :
   Id (H.module-at a).M
    (FH.at (I.forward fh) a (EF.at (I.forward ef) a (MS.On[L,G].Of[E].restrict a b k x)))
    (MS.On[L,G].Of[H].restrict a b k (FH.at (I.forward fh) b (EF.at (I.forward ef) b x))) =
   trans (ap (FH.at (I.forward fh) a) ((I.forward ef).natural a b k x))
    ((I.forward fh).natural a b k (EF.at (I.forward ef) b x)) ;
  composite : EH.Hom = new EH.Hom[component,natural] ;
  composite-at (a : L.L) (x : (E.module-at a).M) : Id (H.module-at a).M (EH.at composite a x)
   (FH.at (I.forward fh) a (EF.at (I.forward ef) a x)) = refl (FH.at (I.forward fh) a (EF.at (I.forward ef) a x)) ;
  equivalence : I.Equivalence E H = (composite,\ a -> Iso[l].equiv-homotopy
   (E.module-at a).M (H.module-at a).M
   (\ x -> FH.at (I.forward fh) a (EF.at (I.forward ef) a x)) (EH.at composite a)
   (\ x -> sym (composite-at a x))
   (Iso[l].equiv-compose (E.module-at a).M (F.module-at a).M (H.module-at a).M
    (FH.at (I.forward fh) a) (EF.at (I.forward ef) a) (I.equiv-at fh a) (I.equiv-at ef a))) ;
  opaque composite ;
 } ;
} ;
