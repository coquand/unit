-- Relative maps and equivalences totalise (§2 of the note).
-- Pair the unchanged structure map with the relative transformation.
-- Its naturality on the canonical algebra lift proves total naturality.
-- A pointwise inverse pairs the same structure map with the relative
-- inverse.  The two inverse equations are the fibre inverse equations
-- under pairing; no transport between different fibres is suppressed.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (F G : RelativeFunctors[l].Over[K].SetFunctor) {
 module R = RelativeFunctors[l].Over[K] ;
 module E = RelativeEquivalences[l].Over[K] ;
 module TF = RelativeTotal[l].Over[K,F] ;
 module TG = RelativeTotal[l].Over[K,G] ;
 module N = R.Transform[F,G] ;
 module A = SF.Transform[TF.functor,TG.functor] ;
 total-map (a : N.Nat) : A.Nat = (\ B p -> TG.At[B].pair (TF.At[B].base p)
   (N.at a (R.BP.algebra B (TF.At[B].base p)) (TF.At[B].value p)),
  \ B C h p -> ap (TG.At[C].pair (R.RT.push B C h (TF.At[B].base p)))
   (N.natural a (R.BP.algebra B (TF.At[B].base p)) (R.BP.algebra C (R.RT.push B C h (TF.At[B].base p)))
    (R.RT.canonical B C h (TF.At[B].base p)) (TF.At[B].value p))) ;
 total-map-at (a : N.Nat) (B : T.Test) (p : TF.functor.obj B) : Id (TG.functor.obj B)
  (A.at (total-map a) B p) (TG.At[B].pair (TF.At[B].base p) (N.at a (R.BP.algebra B (TF.At[B].base p)) (TF.At[B].value p))) = refl (A.at (total-map a) B p) ;
 over-base (a : N.Nat) (B : T.Test) (p : TF.functor.obj B) : Id TF.At[B].Indices
  (TG.At[B].base (A.at (total-map a) B p)) (TF.At[B].base p) = refl (TF.At[B].base p) ;
 module Equivalence (e : E.NaturalEquivalence F G) {
  module I = E.Inverse[F,G,e] ;
  module AtTest (B : T.Test) {
   back (p : TG.functor.obj B) : TF.functor.obj B = TF.At[B].pair (TG.At[B].base p)
    (I.inverse-map (R.BP.algebra B (TG.At[B].base p)) (TG.At[B].value p)) ;
   right (p : TG.functor.obj B) : Id (TG.functor.obj B) (A.at (total-map (E.forward e)) B (back p)) p =
    ap (TG.At[B].pair (TG.At[B].base p)) (I.right-at (R.BP.algebra B (TG.At[B].base p)) (TG.At[B].value p)) ;
   left (p : TF.functor.obj B) : Id (TF.functor.obj B) (back (A.at (total-map (E.forward e)) B p)) p =
    ap (TF.At[B].pair (TF.At[B].base p)) (I.left-at (R.BP.algebra B (TF.At[B].base p)) (TF.At[B].value p)) ;
  } ;
  equivalence : TE.NaturalEquivalence TF.functor TG.functor = (total-map (E.forward e),\ B ->
   Pr.qinv (TF.functor.obj B) (TG.functor.obj B) (A.at (total-map (E.forward e)) B) AtTest[B].back AtTest[B].right AtTest[B].left) ;
 } ;
} ;
-- Identities and composition totalise by the defining component formula.
module Laws (K : T.Test) {
 module R = RelativeFunctors[l].Over[K] ;
 identity (F : R.SetFunctor) : Id (SF.Transform[RelativeTotal[l].Over[K,F].functor,RelativeTotal[l].Over[K,F].functor].Nat)
  (Over[K,F,F].total-map (R.identity F)) (SF.identity RelativeTotal[l].Over[K,F].functor) =
  SF.Transform[RelativeTotal[l].Over[K,F].functor,RelativeTotal[l].Over[K,F].functor].ext _ _ (\ B p -> refl p) ;
 composition (F G H : R.SetFunctor) (b : R.Transform[G,H].Nat) (a : R.Transform[F,G].Nat) :
  Id (SF.Transform[RelativeTotal[l].Over[K,F].functor,RelativeTotal[l].Over[K,H].functor].Nat)
   (Over[K,F,H].total-map R.Composite[F,G,H,b,a].composite)
   SF.Composite[RelativeTotal[l].Over[K,F].functor,RelativeTotal[l].Over[K,G].functor,RelativeTotal[l].Over[K,H].functor,Over[K,G,H].total-map b,Over[K,F,G].total-map a].composite =
  SF.Transform[RelativeTotal[l].Over[K,F].functor,RelativeTotal[l].Over[K,H].functor].ext _ _ (\ B p -> refl
   (SF.Transform[RelativeTotal[l].Over[K,F].functor,RelativeTotal[l].Over[K,H].functor].at (Over[K,F,H].total-map R.Composite[F,G,H,b,a].composite) B p)) ;
} ;
