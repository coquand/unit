-- Doubling a distributive lattice L along an element d (DESIGN.md, step 4,
-- Next 1; DOUBLE-ORIGIN.md).
--
-- L2 = { (u, v) : L x L | u /\ d = v /\ d }, with componentwise operations.
-- The condition is an equation in a set, so two elements with equal
-- components are equal (ext), and the lattice laws hold componentwise.
-- Closure.  bot and top: both sides are the same.  Join:
--  (u \/ u2) /\ d = (u /\ d) \/ (u2 /\ d)  (distributivity), so the
--  condition for (u \/ u2, v \/ v2) follows from those for (u, v), (u2, v2).
--  Meet: (x /\ y) /\ d = (x /\ d) /\ y, so u /\ d = v /\ d gives
--  (u /\ y) /\ d = (v /\ y) /\ d (replace); replace u by v, then u2 by v2.
-- The projections are lattice maps, by definition; hence they are
--  monotone and preserve finite joins (DistLattice.JoinMaps).  Conversely
--  x <= y when both components are (ext).
-- mid (u, v) = u /\ d = v /\ d lies below u and below v.
-- Lemma (restrict-d).  If x <= u then (u /\ d) /\ x = x /\ d:
--  (u /\ d) /\ x = x /\ (u /\ d) = (x /\ u) /\ d = x /\ d.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Over (L : DL.DLat) (d : L.L) {
 module O = DL.Order[L] ;
 module J = DL.Joins[L] ;
 Overlap (u v : L.L) : U l = Id L.L (L.meet u d) (L.meet v d) ;
 Opens : U l = (p : L.L * L.L) * Overlap p.1 p.2 ;
 pair (u v : L.L) (e : Overlap u v) : Opens = ((u,v),e) ;
 first (x : Opens) : L.L = x.1.1 ;
 second (x : Opens) : L.L = x.1.2 ;
 overlap (x : Opens) : Overlap (first x) (second x) = x.2 ;
 ext (x y : Opens) (e1 : Id L.L (first x) (first y)) (e2 : Id L.L (second x) (second y)) : Id Opens x y =
  Pr.Sigma-eq (L.L * L.L) (\ p -> Overlap p.1 p.2) x.1 y.1 x.2 y.2
   (trans (Pr.ap L.L (L.L * L.L) (\ u -> (u,second x)) (first x) (first y) e1)
     (Pr.ap L.L (L.L * L.L) (\ v -> (first y,v)) (second x) (second y) e2))
   (L.setL (L.meet (first y) d) (L.meet (second y) d)) ;
 opens-set : Pr.isSet Opens =
  Pr.isSet-Sigma (L.L * L.L) (\ p -> Overlap p.1 p.2)
   (Pr.isSet-Sigma L.L (\ u -> L.L) L.setL (\ u -> L.setL))
   (\ p -> Pr.prop-to-set (Overlap p.1 p.2) (L.setL (L.meet p.1 d) (L.meet p.2 d))) ;

 -- (x \/ y) /\ d = (x /\ d) \/ (y /\ d)
 join-d (x y : L.L) : Id L.L (L.meet (L.join x y) d) (L.join (L.meet x d) (L.meet y d)) = calc L.L {
  L.meet (L.join x y) d =< L.meetC (L.join x y) d > L.meet d (L.join x y)
   =< L.dist d x y > L.join (L.meet d x) (L.meet d y)
   =< cong2 L.L L.join _ _ _ _ (L.meetC d x) (L.meetC d y) > L.join (L.meet x d) (L.meet y d) } ;
 -- (x /\ y) /\ d = (x /\ d) /\ y
 swap-d (x y : L.L) : Id L.L (L.meet (L.meet x y) d) (L.meet (L.meet x d) y) = calc L.L {
  L.meet (L.meet x y) d =< sym (L.meetA x y d) > L.meet x (L.meet y d)
   =< ap (L.meet x) (L.meetC y d) > L.meet x (L.meet d y)
   =< L.meetA x d y > L.meet (L.meet x d) y } ;
 -- (u /\ d) /\ d = u /\ d
 meet-d-twice (u : L.L) : Id L.L (L.meet (L.meet u d) d) (L.meet u d) =
  trans (sym (L.meetA u d d)) (ap (L.meet u) (O.meet-idem d)) ;
 -- (u /\ v) /\ d = (u /\ d) /\ (v /\ d)
 meet-d (u v : L.L) : Id L.L (L.meet (L.meet u v) d) (L.meet (L.meet u d) (L.meet v d)) = calc L.L {
  L.meet (L.meet u v) d =< sym (meet-d-twice (L.meet u v)) > L.meet (L.meet (L.meet u v) d) d
   =< ap (\ t -> L.meet t d) (swap-d u v) > L.meet (L.meet (L.meet u d) v) d
   =< sym (L.meetA (L.meet u d) v d) > L.meet (L.meet u d) (L.meet v d) } ;
 replace (x x2 y : L.L) (e : Overlap x x2) : Overlap (L.meet x y) (L.meet x2 y) =
  trans (swap-d x y) (trans (ap (\ t -> L.meet t y) e) (sym (swap-d x2 y))) ;

 botD : Opens = pair L.bot L.bot (refl (L.meet L.bot d)) ;
 topD : Opens = pair L.top L.top (refl (L.meet L.top d)) ;
 joinD (x y : Opens) : Opens = pair (L.join (first x) (first y)) (L.join (second x) (second y))
  (trans (join-d (first x) (first y))
   (trans (cong2 L.L L.join _ _ _ _ (overlap x) (overlap y)) (sym (join-d (second x) (second y))))) ;
 meetD (x y : Opens) : Opens = pair (L.meet (first x) (first y)) (L.meet (second x) (second y))
  (trans (replace (first x) (second x) (first y) (overlap x))
   (trans (ap (\ t -> L.meet t d) (L.meetC (second x) (first y)))
    (trans (replace (first y) (second y) (second x) (overlap y))
     (ap (\ t -> L.meet t d) (L.meetC (second y) (second x)))))) ;
 lattice : DL.DLat = new DL.DLat[Opens,opens-set,botD,topD,joinD,meetD,
  \ x y w -> ext (joinD x (joinD y w)) (joinD (joinD x y) w) (L.joinA (first x) (first y) (first w)) (L.joinA (second x) (second y) (second w)),
  \ x y -> ext (joinD x y) (joinD y x) (L.joinC (first x) (first y)) (L.joinC (second x) (second y)),
  \ x -> ext (joinD x botD) x (L.joinB (first x)) (L.joinB (second x)),
  \ x y w -> ext (meetD x (meetD y w)) (meetD (meetD x y) w) (L.meetA (first x) (first y) (first w)) (L.meetA (second x) (second y) (second w)),
  \ x y -> ext (meetD x y) (meetD y x) (L.meetC (first x) (first y)) (L.meetC (second x) (second y)),
  \ x -> ext (meetD x topD) x (L.meetT (first x)) (L.meetT (second x)),
  \ x y -> ext (meetD x (joinD x y)) x (L.absorb-meet (first x) (first y)) (L.absorb-meet (second x) (second y)),
  \ x y -> ext (joinD x (meetD x y)) x (L.absorb-join (first x) (first y)) (L.absorb-join (second x) (second y)),
  \ x y w -> ext (meetD x (joinD y w)) (joinD (meetD x y) (meetD x w)) (L.dist (first x) (first y) (first w)) (L.dist (second x) (second y) (second w))] ;

 module OD = DL.Order[lattice] ;
 module JD = DL.Joins[lattice] ;
 -- the projections are lattice maps
 first-map : DL.Hom lattice L =
  (first,refl L.bot,refl L.top,\ x y -> refl (L.join (first x) (first y)),\ x y -> refl (L.meet (first x) (first y))) ;
 second-map : DL.Hom lattice L =
  (second,refl L.bot,refl L.top,\ x y -> refl (L.join (second x) (second y)),\ x y -> refl (L.meet (second x) (second y))) ;
 le-first (x y : Opens) (k : OD.Le x y) : O.Le (first x) (first y) = DL.JoinMaps[lattice,L,first-map].monotone x y k ;
 le-second (x y : Opens) (k : OD.Le x y) : O.Le (second x) (second y) = DL.JoinMaps[lattice,L,second-map].monotone x y k ;
 le-pair (x y : Opens) (k1 : O.Le (first x) (first y)) (k2 : O.Le (second x) (second y)) : OD.Le x y =
  ext (meetD x y) x k1 k2 ;
 join-first (n : Nat) (f : Fin n -> Opens) : Id L.L (first (JD.bigJ n f)) (J.bigJ n (\ i -> first (f i))) =
  DL.JoinMaps[lattice,L,first-map].preserves n f ;
 join-second (n : Nat) (f : Fin n -> Opens) : Id L.L (second (JD.bigJ n f)) (J.bigJ n (\ i -> second (f i))) =
  DL.JoinMaps[lattice,L,second-map].preserves n f ;

 -- the overlap of the two components
 mid (x : Opens) : L.L = L.meet (first x) d ;
 mid-first (x : Opens) : O.Le (mid x) (first x) = O.meet-left (first x) d ;
 mid-second (x : Opens) : O.Le (mid x) (second x) =
  O.le-trans (mid x) (L.meet (second x) d) (second x) (O.le-of-eq (mid x) (L.meet (second x) d) (overlap x))
   (O.meet-left (second x) d) ;
 mid-le (x y : Opens) (k : OD.Le x y) : O.Le (mid x) (mid y) =
  O.meet-mono (first x) d (first y) d (le-first x y k) (O.le-refl d) ;
 -- (u /\ d) /\ x = x /\ d for x <= u
 restrict-d (u x : L.L) (k : O.Le x u) : Id L.L (L.meet (L.meet u d) x) (L.meet x d) = calc L.L {
  L.meet (L.meet u d) x =< L.meetC (L.meet u d) x > L.meet x (L.meet u d)
   =< L.meetA x u d > L.meet (L.meet x u) d
   =< ap (\ t -> L.meet t d) k > L.meet x d } ;
} ;
