-- Clearing and killing: the element form of a localisation equivalence.
-- For a linear u : M -> N over A and f in A, say that u clears when for
-- every y in N merely u(x) = f^r y, and that u kills when u(x) = 0
-- implies merely f^r x = 0. Let h : M_f -> N clear fractions,
-- f^p h(x/f^p) = u(x).
-- (1) If h is bijective, u clears and kills. For y = h(x/f^p) we get
--  u(x) = f^p y. If u(x) = 0 then h(x/1) = 0 = h(0/1), so x/1 = 0 and a
--  power of f kills x (fraction zero criterion).
-- (2) Conversely, if f acts invertibly on N and u clears and kills, then
--  h is bijective: it agrees with the unique extension of u, which is an
--  equivalence (SerreModuleBasicRestrictionsComparison); two maps that
--  clear fractions to the same value agree, as f^p acts injectively.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module LC = SerreModuleLocalisation[l] ;
module UP = SerreModuleLocalisationUniversal[l] ;
module Over (A : CRing) (Md Nd : SM.Over[A].Module)
 (u : MM.Between[A,A,RH.identity A,Md,Nd].Hom) (f : A.R) {
 module H = MM.Between[A,A,RH.identity A,Md,Nd] ;
 module AP = AffinePowers[l].Over[A] ;
 module S = LC.At[A,Md,f] ; module T = LC.At[A,Nd,f] ;
 Clearing (y : Nd.M) : U l = (r : Nat) * (x : Md.M) * Id Nd.M (H.map u x) (Nd.sm (AP.power f r) y) ;
 Clear : U l = (y : Nd.M) -> Tr.Trunc[Clearing y].carrier ;
 Killing (x : Md.M) : U l = (r : Nat) * Id Md.M (Md.sm (AP.power f r) x) Md.mz ;
 Kill : U l = (x : Md.M) -> Id Nd.M (H.map u x) Nd.mz -> Tr.Trunc[Killing x].carrier ;
 module FromEquivalence (h : S.Carrier -> Nd.M)
  (clears : (x : Md.M) (p : Nat) -> Id Nd.M (T.power p (h (S.fraction x p))) (H.map u x))
  (equiv : Pr.isEquiv S.Carrier Nd.M h) {
  module Of (y : Nd.M) {
   source : S.Carrier = equiv.sec y ;
   moved (w : (x : Md.M) * (p : Nat) * Id S.Carrier (S.fraction x p) source) : Clearing y =
    (w.2.1,w.1,calc Nd.M {
     H.map u w.1 =< sym (clears w.1 w.2.1) > T.power w.2.1 (h (S.fraction w.1 w.2.1))
      =< ap (\ z -> T.power w.2.1 (h z)) w.2.2 > T.power w.2.1 (h source)
      =< ap (T.power w.2.1) (equiv.sec-eq y) > T.power w.2.1 y
      =< T.power-scalar w.2.1 y > Nd.sm (AP.power f w.2.1) y }) ;
   clearing : Tr.Trunc[Clearing y].carrier =
    Tr.Trunc[(x : Md.M) * (p : Nat) * Id S.Carrier (S.fraction x p) source].induction @l
     (\ t -> Tr.Trunc[Clearing y].carrier) (\ t -> Tr.Trunc[Clearing y].proposition)
     (\ w -> Tr.Trunc[Clearing y].inc (moved w)) (S.represented source) ;
  } ;
  clear : Clear = \ y -> Of[y].clearing ;
  original (x : Md.M) : Id Nd.M (h (S.fraction x zero)) (H.map u x) =
   trans (sym (T.power-at-zero (h (S.fraction x zero)))) (clears x zero) ;
  zero-fraction (x : Md.M) (e : Id Nd.M (H.map u x) Nd.mz) : Id S.Carrier (S.fraction x zero) (S.fraction Md.mz zero) =
   Iso[l].injective S.Carrier Nd.M h equiv _ _
    (trans (original x) (trans e (sym (trans (original Md.mz) (H.map-zero u))))) ;
  killing (x : Md.M) (w : S.Killed x) : Killing x = (w.1,trans (sym (S.power-scalar w.1 x)) w.2) ;
  kill : Kill = \ x e -> Tr.Trunc[S.Killed x].induction @l (\ t -> Tr.Trunc[Killing x].carrier)
   (\ t -> Tr.Trunc[Killing x].proposition) (\ w -> Tr.Trunc[Killing x].inc (killing x w))
   (S.zero-killed x (zero-fraction x e)) ;
 } ;
 module ToEquivalence (invertible : Pr.isEquiv Nd.M Nd.M (Nd.sm f)) (h : S.Carrier -> Nd.M)
  (clears : (x : Md.M) (p : Nat) -> Id Nd.M (T.power p (h (S.fraction x p))) (H.map u x))
  (clear : Clear) (kill : Kill) {
  module Comp = SerreModuleBasicRestrictionsComparison[l].Over[A,Md,Nd,f,u,invertible,clear,kill] ;
  same-fraction (x : Md.M) (p : Nat) : Id Nd.M (Comp.forward (S.fraction x p)) (h (S.fraction x p)) =
   Comp.E.InverseAction.power-injective p _ _ (trans (Comp.clears x p) (sym (clears x p))) ;
  same (z : S.Carrier) : Id Nd.M (Comp.forward z) (h z) =
   S.induction @l (\ z -> Id Nd.M (Comp.forward z) (h z)) (\ z -> Nd.setM _ _) same-fraction z ;
  equivalence : Pr.isEquiv S.Carrier Nd.M h =
   Iso[l].equiv-homotopy S.Carrier Nd.M Comp.forward h same Comp.equivalence ;
 } ;
} ;
-- Two maps out of M_f that clear fractions to the same value agree, when
-- f acts invertibly on the target: f^p is injective there.
module Agree (A : CRing) (Md Nd : SM.Over[A].Module) (f : A.R)
 (invertible : Pr.isEquiv Nd.M Nd.M (Nd.sm f)) (v : Md.M -> Nd.M)
 (h k : LC.At[A,Md,f].Carrier -> Nd.M)
 (h-clears : (x : Md.M) (p : Nat) -> Id Nd.M (LC.At[A,Nd,f].power p (h (LC.At[A,Md,f].fraction x p))) (v x))
 (k-clears : (x : Md.M) (p : Nat) -> Id Nd.M (LC.At[A,Nd,f].power p (k (LC.At[A,Md,f].fraction x p))) (v x)) {
 module S = LC.At[A,Md,f] ;
 module I = UP.Inverse[A,Nd,f,invertible] ;
 same-fraction (x : Md.M) (p : Nat) : Id Nd.M (h (S.fraction x p)) (k (S.fraction x p)) =
  I.power-injective p _ _ (trans (h-clears x p) (sym (k-clears x p))) ;
 same (z : S.Carrier) : Id Nd.M (h z) (k z) =
  S.induction @l (\ z -> Id Nd.M (h z) (k z)) (\ z -> Nd.setM _ _) same-fraction z ;
} ;
-- The universal extension of u clears fractions to u.
module Lift (A : CRing) (Md Nd : SM.Over[A].Module)
 (u : MM.Between[A,A,RH.identity A,Md,Nd].Hom) (f : A.R)
 (invertible : Pr.isEquiv Nd.M Nd.M (Nd.sm f)) {
 module E = UP.Extend[A,Md,Nd,f,u,invertible] ;
 lift : E.To.Hom = E.lift ;
 map (z : E.S.Carrier) : Nd.M = E.To.map lift z ;
 clears (x : Md.M) (p : Nat) : Id Nd.M (E.T.power p (map (E.S.fraction x p))) (E.H.map u x) =
  trans (ap (E.T.power p) (trans (E.lift-map-at (E.S.fraction x p)) (E.lift-at x p)))
   (E.InverseAction.power-back p (E.H.map u x)) ;
 module Elementary = Over[A,Md,Nd,u,f] ;
 equivalence (clear : Elementary.Clear) (kill : Elementary.Kill) : Pr.isEquiv E.S.Carrier Nd.M map =
  Elementary.ToEquivalence[invertible,map,clears,clear,kill].equivalence ;
} ;
