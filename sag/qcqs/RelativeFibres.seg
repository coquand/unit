-- Fibres of a natural projection G->h_k (note §5).
-- The fibre over (B,iota) is (z:G(B), q(z)=iota).  Reindex z, use
-- naturality of q, the old fibre equation, and the algebra map's
-- commuting equation.  Fibre proofs are propositions, so point-ext
-- proves the functor laws from G's laws, retaining the base equation.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module Over (K : T.Test) (G : SF.SetFunctor) (q : SF.Transform[G,SF.Representable[K].functor].Nat) {
 module R = RelativeFunctors[l].Over[K] ;
 module BP = R.BP ;
 module N = SF.Transform[G,SF.Representable[K].functor] ;
 Member (A : BP.Algebra) (z : G.obj (BP.test A)) : U l = Id (RingHom[l].Hom K.ring (BP.test A).ring) (N.at q (BP.test A) z) (BP.iota A) ;
 obj (A : BP.Algebra) : U l = (z : G.obj (BP.test A)) * Member A z ;
 point {A : BP.Algebra} (p : obj A) : G.obj (BP.test A) = p.1 ;
 member {A : BP.Algebra} (p : obj A) : Member A (point p) = p.2 ;
 member-prop (A : BP.Algebra) (z : G.obj (BP.test A)) : Pr.isProp (Member A z) = RingHom[l].Properties[K.ring,(BP.test A).ring,(BP.test A).carrier-set].set _ _ ;
 ext (A : BP.Algebra) (p r : obj A) (e : Id (G.obj (BP.test A)) (point p) (point r)) : Id (obj A) p r =
  Pr.Sigma-eq (G.obj (BP.test A)) (Member A) p.1 r.1 p.2 r.2 e (member-prop A r.1) ;
 set (A : BP.Algebra) : Pr.isSet (obj A) = Pr.isSet-Sigma (G.obj (BP.test A)) (Member A) (G.set (BP.test A))
  (\ z -> Pr.prop-to-set (Member A z) (member-prop A z)) ;
 reindex (A B : BP.Algebra) (h : BP.Hom A B) (p : obj A) : obj B =
  (G.reindex (BP.test A) (BP.test B) (BP.ring-map h) (point p),
   trans (N.natural q (BP.test A) (BP.test B) (BP.ring-map h) (point p))
    (trans (ap (R.RT.push (BP.test A) (BP.test B) (BP.ring-map h)) (member p)) (R.RT.commuting-path A B h))) ;
 functor : R.SetFunctor = new R.SetFunctor[obj,set,reindex,
  \ A p -> ext A _ _ (G.identity (BP.test A) (point p)),
  \ A B C f g p -> ext C _ _ (G.composition (BP.test A) (BP.test B) (BP.test C) (BP.ring-map f) (BP.ring-map g) (point p))] ;
} ;
