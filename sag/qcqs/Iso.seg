-- Isomorphisms of ringed lattices (DESIGN.md, Next 1).  A map
-- pi : (L, F) -> (M, G) (LocallyRinged.Maps) is an isomorphism when its
-- lattice map and all its ring maps pi#_u are bijective.
--
-- Lemma (Units).  A bijective ring map k reflects units: if k(x) y = 1,
--  then k(x sec(y)) = k(x) y = 1 = k(1), so x sec(y) = 1 (k is injective).
-- Theorem (Local).  An isomorphism is local.  Let v = D_(pi u)(pi# s) and
--  w the open with pi w = v.  Then w <= u: pi(w /\ u) = v /\ pi u = v = pi w,
--  and pi is injective.  pi#(s|w) = (pi# s)|pi w is a unit, as pi w = v is
--  the invertibility open; so s|w is one (Units), w <= D_u(s), and
--  v = pi w <= pi(D_u s).
--
-- Equivalences (bi-invertible maps).  Composites of equivalences are
--  equivalences; a map pointwise equal to an equivalence is one; if g f is
--  an equivalence and g is one, so is f (f has the retraction (g f)^-1 g,
--  and f((g f)^-1 (g b)) = b since both sides have the same image under the
--  injective g).  Two out of six: if g f and h g are equivalences, then g
--  has the section f (g f)^-1 and the retraction (h g)^-1 h, so g is one,
--  and then so is f.
-- The inverse of a bijective ring map is a ring map: k(sec(x + y)) = x + y
--  = k(sec x) + k(sec y) = k(sec x + sec y), and k is injective; the same
--  for 1 and products.
-- Restriction between equal opens (m <= m2 <= m) is bijective, with inverse
--  the restriction back: res-comp and res-id.
-- Transfer.  Let pi, pi2 be maps with pi u = pi2 u for all u and
--  (pi# s)|pi2 u = pi2# s.  The lattice maps are pointwise equal, and pi2#_u
--  is pi#_u followed by a restriction between equal opens; so pi is an
--  isomorphism iff pi2 is.
-- Inverse map.  For an isomorphism pi, the inverse lattice map b is a
--  lattice map (pi is injective and preserves the operations), and
--  rho#_m = (pi#_(b m))^-1 . (restriction from m to the equal open pi(b m)).
--  Naturality is checked after the injective pi#: both sides become
--  restrictions of x to pi(b m).  rho is an isomorphism (composite of
--  equivalences).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;

-- an equivalence is injective
injective (A B : U l) (k : A -> B) (eq : Pr.isEquiv A B k) (x y : A) (e : Id B (k x) (k y)) : Id A x y =
 trans (sym (eq.ret-eq x)) (trans (ap eq.ret e) (eq.ret-eq y)) ;

-- equivalences
equiv-compose (A B C : U l) (g : B -> C) (f : A -> B) (eg : Pr.isEquiv B C g) (ef : Pr.isEquiv A B f) :
 Pr.isEquiv A C (\ a -> g (f a)) =
 struct { sec = \ c -> ef.sec (eg.sec c) ;
          sec-eq = \ c -> trans (ap g (ef.sec-eq (eg.sec c))) (eg.sec-eq c) ;
          ret = \ c -> ef.ret (eg.ret c) ;
          ret-eq = \ a -> trans (ap ef.ret (eg.ret-eq (f a))) (ef.ret-eq a) } ;
equiv-homotopy (A B : U l) (f g : A -> B) (h : (a : A) -> Id B (f a) (g a)) (ef : Pr.isEquiv A B f) : Pr.isEquiv A B g =
 struct { sec = ef.sec ;
          sec-eq = \ b -> trans (sym (h (ef.sec b))) (ef.sec-eq b) ;
          ret = ef.ret ;
          ret-eq = \ a -> trans (ap ef.ret (sym (h a))) (ef.ret-eq a) } ;
equiv-cancel (A B C : U l) (g : B -> C) (f : A -> B) (eg : Pr.isEquiv B C g) (egf : Pr.isEquiv A C (\ a -> g (f a))) :
 Pr.isEquiv A B f =
 struct { sec = \ b -> egf.sec (g b) ;
          sec-eq = \ b -> injective B C g eg (f (egf.sec (g b))) b (egf.sec-eq (g b)) ;
          ret = \ b -> egf.ret (g b) ;
          ret-eq = egf.ret-eq } ;
module TwoOfSix (A B C D : U l) (f : A -> B) (g : B -> C) (h : C -> D)
 (egf : Pr.isEquiv A C (\ a -> g (f a))) (ehg : Pr.isEquiv B D (\ b -> h (g b))) {
 middle : Pr.isEquiv B C g =
  struct { sec = \ c -> f (egf.sec c) ; sec-eq = egf.sec-eq ; ret = \ c -> ehg.ret (h c) ; ret-eq = ehg.ret-eq } ;
 first : Pr.isEquiv A B f = equiv-cancel A B C g f middle egf ;
} ;

module Inverse (A B : CRing) (k : RH.Hom A B) (eq : Pr.isEquiv A.R B.R (map k)) {
 back (x : B.R) : A.R = eq.sec x ;
 back-eq (x : B.R) : Id B.R (map k (back x)) x = eq.sec-eq x ;
 eq-back (a : A.R) : Id A.R (back (map k a)) a = Pr.sec-ret A.R B.R (map k) eq a ;
 inverse : RH.Hom B A =
  (back,
   injective A.R B.R (map k) eq (back B.o) A.o (trans (back-eq B.o) (sym (map-one k))),
   \ x y -> injective A.R B.R (map k) eq (back (B.add x y)) (A.add (back x) (back y)) (calc B.R {
    map k (back (B.add x y)) =< back-eq (B.add x y) > B.add x y
     =< sym (ap (\ t -> B.add t y) (back-eq x)) > B.add (map k (back x)) y
     =< sym (ap (B.add (map k (back x))) (back-eq y)) > B.add (map k (back x)) (map k (back y))
     =< sym (map-add k (back x) (back y)) > map k (A.add (back x) (back y)) }),
   \ x y -> injective A.R B.R (map k) eq (back (B.mul x y)) (A.mul (back x) (back y)) (calc B.R {
    map k (back (B.mul x y)) =< back-eq (B.mul x y) > B.mul x y
     =< sym (ap (\ t -> B.mul t y) (back-eq x)) > B.mul (map k (back x)) y
     =< sym (ap (B.mul (map k (back x))) (back-eq y)) > B.mul (map k (back x)) (map k (back y))
     =< sym (map-mul k (back x) (back y)) > map k (A.mul (back x) (back y)) })) ;
 inverse-map (x : B.R) : Id A.R (map inverse x) (back x) = refl (back x) ;
 -- the two inverse laws, for the ring map
 right (x : B.R) : Id B.R (map k (map inverse x)) x = trans (ap (map k) (inverse-map x)) (back-eq x) ;
 left (a : A.R) : Id A.R (map inverse (map k a)) a = trans (inverse-map (map k a)) (eq-back a) ;
} ;

module Units (A B : CRing) (k : RH.Hom A B) (eq : Pr.isEquiv A.R B.R (map k)) {
 reflect (x : A.R) (u : RL[B].unit (map k x)) : RL[A].unit x =
  (eq.sec u.1,injective A.R B.R (map k) eq (A.mul x (eq.sec u.1)) A.o (calc B.R {
   map k (A.mul x (eq.sec u.1)) =< map-mul k x (eq.sec u.1) > B.mul (map k x) (map k (eq.sec u.1))
    =< ap (B.mul (map k x)) (eq.sec-eq u.1) > B.mul (map k x) u.1
    =< u.2 > B.o
    =< sym (map-one k) > map k A.o })) ;
} ;

-- restriction between equal opens
module EqualOpens (M : DL.DLat) (G : RingedLattice[l].On[M].Presheaf) (m m2 : M.L)
 (k : DL.Order[M].Le m m2) (k2 : DL.Order[M].Le m2 m) {
 module O = DL.Order[M] ;
 equiv : Pr.isEquiv (G.ring m2).R (G.ring m).R (map (G.res m m2 k)) =
  Pr.qinv (G.ring m2).R (G.ring m).R (map (G.res m m2 k)) (map (G.res m2 m k2))
   (\ x -> trans (G.res-comp m m2 m k k2 (O.le-refl m) x) (G.res-id m (O.le-refl m) x))
   (\ x -> trans (G.res-comp m2 m m2 k2 k (O.le-refl m2) x) (G.res-id m2 (O.le-refl m2) x)) ;
} ;

module Maps (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf) {
 module OL = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module Mp = LocallyRinged[l].Maps[L,M,F,G] ;
 IsIso (pi : Mp.Ringed) : U l =
  Pr.isEquiv L.L M.L (DL.hmap pi.lat) * ((u : L.L) -> Pr.isEquiv (F.ring u).R (G.ring (DL.hmap pi.lat u)).R (map (pi.sharp u))) ;
 lat-equiv {pi : Mp.Ringed} (i : IsIso pi) : Pr.isEquiv L.L M.L (DL.hmap pi.lat) = i.1 ;
 sharp-equiv {pi : Mp.Ringed} (i : IsIso pi) (u : L.L) : Pr.isEquiv (F.ring u).R (G.ring (DL.hmap pi.lat u)).R (map (pi.sharp u)) =
  i.2 u ;

 module Local (pi : Mp.Ringed) (iso : IsIso pi) (DF : InvOpen[l].On[L].Of[F].InvMap) (DG : InvOpen[l].On[M].Of[G].InvMap) {
  module MO = Mp.Of[pi,DF,DG] ;
  module PJ = DL.JoinMaps[L,M,pi.lat] ;
  module At (u : L.L) (s : (F.ring u).R) {
   v : M.L = MO.LG.d (MO.p u) (map (pi.sharp u) s) ;
   w : L.L = (lat-equiv iso).sec v ;
   w-eq : Id M.L (MO.p w) v = (lat-equiv iso).sec-eq v ;
   w-le : OL.Le w u = injective L.L M.L (DL.hmap pi.lat) (lat-equiv iso) (L.meet w u) w (calc M.L {
    MO.p (L.meet w u) =< DL.hmap-meet pi.lat w u > M.meet (MO.p w) (MO.p u)
     =< ap (\ t -> M.meet t (MO.p u)) w-eq > M.meet v (MO.p u)
     =< MO.IG.below (MO.LG.d-open (MO.p u) (map (pi.sharp u) s)) > v
     =< sym w-eq > MO.p w }) ;
   image-unit : MO.IG.Unit (MO.p w) (map (pi.sharp w) (map (F.res w u w-le) s)) =
    Pr.subst (G.ring (MO.p w)).R (MO.IG.Unit (MO.p w))
     (map (G.res (MO.p w) (MO.p u) (PJ.monotone w u w-le)) (map (pi.sharp u) s))
     (map (pi.sharp w) (map (F.res w u w-le) s)) (pi.natural w u w-le s)
     (MO.IG.to-unit (MO.LG.d-open (MO.p u) (map (pi.sharp u) s)) (MO.p w) (PJ.monotone w u w-le)
       (OM.le-of-eq (MO.p w) v w-eq)) ;
   unit : MO.IF.Unit w (map (F.res w u w-le) s) =
    Units[F.ring w,G.ring (MO.p w),pi.sharp w,sharp-equiv iso w].reflect (map (F.res w u w-le) s) image-unit ;
   le : OM.Le v (MO.p (MO.LF.d u s)) =
    Pr.subst M.L (\ t -> OM.Le t (MO.p (MO.LF.d u s))) (MO.p w) v w-eq
     (PJ.monotone w (MO.LF.d u s) (MO.IF.from-unit (MO.LF.d-open u s) w w-le unit)) ;
  } ;
  local : MO.IsLocal = \ u s -> At[u,s].le ;
 } ;

 -- maps with equal lattice maps and ring maps equal after restriction
 module Transfer (pi pi2 : Mp.Ringed) (lat-eq : (u : L.L) -> Id M.L (DL.hmap pi.lat u) (DL.hmap pi2.lat u))
  (le : (u : L.L) -> OM.Le (DL.hmap pi2.lat u) (DL.hmap pi.lat u))
  (sharp-eq : (u : L.L) (s : (F.ring u).R) -> Id (G.ring (DL.hmap pi2.lat u)).R
    (map (G.res (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u)) (map (pi.sharp u) s)) (map (pi2.sharp u) s)) {
  res-equiv (u : L.L) : Pr.isEquiv (G.ring (DL.hmap pi.lat u)).R (G.ring (DL.hmap pi2.lat u)).R
   (map (G.res (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u))) =
   EqualOpens[M,G,DL.hmap pi2.lat u,DL.hmap pi.lat u,le u,OM.le-of-eq (DL.hmap pi.lat u) (DL.hmap pi2.lat u) (lat-eq u)].equiv ;
  forward (iso : IsIso pi) : IsIso pi2 =
   (equiv-homotopy L.L M.L (DL.hmap pi.lat) (DL.hmap pi2.lat) lat-eq (lat-equiv iso),
    \ u -> equiv-homotopy (F.ring u).R (G.ring (DL.hmap pi2.lat u)).R
     (\ s -> map (G.res (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u)) (map (pi.sharp u) s)) (map (pi2.sharp u)) (sharp-eq u)
     (equiv-compose (F.ring u).R (G.ring (DL.hmap pi.lat u)).R (G.ring (DL.hmap pi2.lat u)).R
       (map (G.res (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u))) (map (pi.sharp u)) (res-equiv u) (sharp-equiv iso u))) ;
  backward (iso2 : IsIso pi2) : IsIso pi =
   (equiv-homotopy L.L M.L (DL.hmap pi2.lat) (DL.hmap pi.lat) (\ u -> sym (lat-eq u)) (lat-equiv iso2),
    \ u -> equiv-cancel (F.ring u).R (G.ring (DL.hmap pi.lat u)).R (G.ring (DL.hmap pi2.lat u)).R
     (map (G.res (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u))) (map (pi.sharp u)) (res-equiv u)
     (equiv-homotopy (F.ring u).R (G.ring (DL.hmap pi2.lat u)).R (map (pi2.sharp u))
       (\ s -> map (G.res (DL.hmap pi2.lat u) (DL.hmap pi.lat u) (le u)) (map (pi.sharp u) s)) (\ s -> sym (sharp-eq u s))
       (sharp-equiv iso2 u))) ;
 } ;
} ;

-- the inverse of an isomorphism
module Invert (L M : DL.DLat) (F : RingedLattice[l].On[L].Presheaf) (G : RingedLattice[l].On[M].Presheaf)
 (pi : LocallyRinged[l].Maps[L,M,F,G].Ringed) (iso : Maps[L,M,F,G].IsIso pi) {
 module OL = DL.Order[L] ;
 module OM = DL.Order[M] ;
 module GO = RingedLattice[l].On[M].Of[G] ;
 module FO = RingedLattice[l].On[L].Of[F] ;
 module PJ = DL.JoinMaps[L,M,pi.lat] ;
 p (u : L.L) : M.L = DL.hmap pi.lat u ;
 -- the lattice part: the inverse function, a lattice map since p is injective
 back (m : M.L) : L.L = iso.1.sec m ;
 back-eq (m : M.L) : Id M.L (p (back m)) m = iso.1.sec-eq m ;
 inj (u u2 : L.L) (e : Id M.L (p u) (p u2)) : Id L.L u u2 = injective L.L M.L (DL.hmap pi.lat) iso.1 u u2 e ;
 lat : DL.Hom M L =
  (back,
   inj (back M.bot) L.bot (trans (back-eq M.bot) (sym (DL.hmap-bot pi.lat))),
   inj (back M.top) L.top (trans (back-eq M.top) (sym (DL.hmap-top pi.lat))),
   \ m m2 -> inj (back (M.join m m2)) (L.join (back m) (back m2)) (calc M.L {
    p (back (M.join m m2)) =< back-eq (M.join m m2) > M.join m m2
     =< sym (cong2 M.L M.join _ _ _ _ (back-eq m) (back-eq m2)) > M.join (p (back m)) (p (back m2))
     =< sym (DL.hmap-join pi.lat (back m) (back m2)) > p (L.join (back m) (back m2)) }),
   \ m m2 -> inj (back (M.meet m m2)) (L.meet (back m) (back m2)) (calc M.L {
    p (back (M.meet m m2)) =< back-eq (M.meet m m2) > M.meet m m2
     =< sym (cong2 M.L M.meet _ _ _ _ (back-eq m) (back-eq m2)) > M.meet (p (back m)) (p (back m2))
     =< sym (DL.hmap-meet pi.lat (back m) (back m2)) > p (L.meet (back m) (back m2)) })) ;
 module BJ = DL.JoinMaps[M,L,lat] ;
 -- the ring part at m: restriction to the equal open p (back m), then the inverse of pi#
 up (m : M.L) : OM.Le (p (back m)) m = OM.le-of-eq (p (back m)) m (back-eq m) ;
 module I (m : M.L) {
  module V = Inverse[F.ring (back m),G.ring (p (back m)),pi.sharp (back m),iso.2 (back m)] ;
 } ;
 sharp (m : M.L) : RH.Hom (G.ring m) (F.ring (back m)) =
  RH.compose (G.ring m) (G.ring (p (back m))) (F.ring (back m)) I[m].V.inverse (G.res (p (back m)) m (up m)) ;
 -- pi# (sharp x) is the restriction of x
 pi-sharp (m : M.L) (x : (G.ring m).R) :
  Id (G.ring (p (back m))).R (map (pi.sharp (back m)) (map (sharp m) x)) (GO.restrict (p (back m)) m (up m) x) =
  I[m].V.right (GO.restrict (p (back m)) m (up m) x) ;
 natural (m m2 : M.L) (k : OM.Le m m2) (x : (G.ring m2).R) :
  Id (F.ring (back m)).R (map (F.res (back m) (back m2) (BJ.monotone m m2 k)) (map (sharp m2) x)) (map (sharp m) (map (G.res m m2 k) x)) =
  injective (F.ring (back m)).R (G.ring (p (back m))).R (map (pi.sharp (back m))) (iso.2 (back m))
   (FO.restrict (back m) (back m2) (BJ.monotone m m2 k) (map (sharp m2) x)) (map (sharp m) (GO.restrict m m2 k x)) (calc (G.ring (p (back m))).R {
    map (pi.sharp (back m)) (FO.restrict (back m) (back m2) (BJ.monotone m m2 k) (map (sharp m2) x))
     =< sym (pi.natural (back m) (back m2) (BJ.monotone m m2 k) (map (sharp m2) x))
     > GO.restrict (p (back m)) (p (back m2)) (PJ.monotone (back m) (back m2) (BJ.monotone m m2 k)) (map (pi.sharp (back m2)) (map (sharp m2) x))
     =< ap (GO.restrict (p (back m)) (p (back m2)) (PJ.monotone (back m) (back m2) (BJ.monotone m m2 k))) (pi-sharp m2 x)
     > GO.restrict (p (back m)) (p (back m2)) (PJ.monotone (back m) (back m2) (BJ.monotone m m2 k)) (GO.restrict (p (back m2)) m2 (up m2) x)
     =< G.res-comp (p (back m)) (p (back m2)) m2 (PJ.monotone (back m) (back m2) (BJ.monotone m m2 k)) (up m2)
         (OM.le-trans (p (back m)) m m2 (up m) k) x
     > GO.restrict (p (back m)) m2 (OM.le-trans (p (back m)) m m2 (up m) k) x
     =< sym (G.res-comp (p (back m)) m m2 (up m) k (OM.le-trans (p (back m)) m m2 (up m) k) x)
     > GO.restrict (p (back m)) m (up m) (GO.restrict m m2 k x)
     =< sym (pi-sharp m (GO.restrict m m2 k x))
     > map (pi.sharp (back m)) (map (sharp m) (GO.restrict m m2 k x)) }) ;
 inverse : LocallyRinged[l].Maps[M,L,G,F].Ringed = new LocallyRinged[l].Maps[M,L,G,F].Ringed[lat,sharp,natural] ;
 -- it is an isomorphism
 inverse-iso : Maps[M,L,G,F].IsIso inverse =
  (Pr.qinv M.L L.L back (DL.hmap pi.lat) (\ u -> Pr.sec-ret L.L M.L (DL.hmap pi.lat) iso.1 u) back-eq,
   \ m -> equiv-compose (G.ring m).R (G.ring (p (back m))).R (F.ring (back m)).R (map I[m].V.inverse) (map (G.res (p (back m)) m (up m)))
    (Pr.qinv (G.ring (p (back m))).R (F.ring (back m)).R (map I[m].V.inverse) (map (pi.sharp (back m))) I[m].V.left I[m].V.right)
    (EqualOpens[M,G,p (back m),m,up m,OM.le-of-eq m (p (back m)) (sym (back-eq m))].equiv)) ;
} ;
