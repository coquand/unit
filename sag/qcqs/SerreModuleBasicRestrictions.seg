-- Actual restriction maps between localised modules (Serre, Sections 3--4).
-- If D(h)<=D(g), the image of g is a unit in A_h. Its action on M_h
-- is therefore invertible, including when the rings or modules are zero.
-- The module-localisation universal property extends M->M_h to M_g->M_h.
-- Identity and composition follow by uniqueness of extensions, using the
-- named equation on original numerators. No localisation is assumed.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module LS = SerreModuleLocalisationStructure[l] ;
module SR = SerreModuleLocalisationScalarsRing[l] ;
module UP = SerreModuleLocalisationUniversal[l] ;
module UnitAction (B : CRing) (Nd : SM.Over[B].Module) (b : B.R) (unit : RL[B].unit b) {
 inverse (x : Nd.M) : Nd.M = Nd.sm unit.1 x ;
 right (x : Nd.M) : Id Nd.M (Nd.sm b (inverse x)) x =
  trans (Nd.smA b unit.1 x) (trans (ap (\ r -> Nd.sm r x) unit.2) (Nd.smO x)) ;
 left (x : Nd.M) : Id Nd.M (inverse (Nd.sm b x)) x =
  trans (Nd.smA unit.1 b x) (trans (ap (\ r -> Nd.sm r x) (trans (B.mulC unit.1 b) unit.2)) (Nd.smO x)) ;
 equiv : Pr.isEquiv Nd.M Nd.M (Nd.sm b) = Pr.qinv Nd.M Nd.M (Nd.sm b) inverse right left ;
 opaque inverse ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Z = ZariskiLattice[l].Over[A] ; module O = Z.O ;
 module AF = Affine[l].Over[A] ;
 module R = Sections[l].Over[A,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;
 module Local (g : A.R) {
  module Native = LS.At[A,Md,g] ;
  module Scalars = SR.At[A,setA,Md,g] ;
 } ;
 module At (g h : A.R) (le : O.Le (Z.D h) (Z.D g)) {
  unit : RL[AF.Loc h].unit (RM.map (AF.inclusion h) g) =
   Bridge[l].Over[A,h].At[AF.Loc h,AF.set h,AF.inclusion h,AF.elementary h,g].le-invertible le ;
  module Act = UnitAction[AF.Loc h,Local[h].Scalars.localised,RM.map (AF.inclusion h) g,unit] ;
  invertible : Pr.isEquiv Local[h].Native.L.Carrier Local[h].Native.L.Carrier (Local[h].Native.localised.sm g) =
   Iso[l].equiv-homotopy Local[h].Native.L.Carrier Local[h].Native.L.Carrier
    (Local[h].Scalars.localised.sm (RM.map (AF.inclusion h) g)) (Local[h].Native.localised.sm g)
    (\ x -> Local[h].Scalars.ER.original-action g x) Act.equiv ;
  module E = UP.Extend[A,Md,Local[h].Native.localised,g,Local[h].Native.canonical,invertible] ;
  module H = MM.Between[A,A,RH.identity A,Local[g].Native.localised,Local[h].Native.localised] ;
  native : H.Hom = E.lift ;
  map (x : Local[g].Native.L.Carrier) : Local[h].Native.L.Carrier = H.map native x ;
  on-original (x : Md.M) : Id Local[h].Native.L.Carrier
   (map (Local[g].Native.L.fraction x zero)) (Local[h].Native.L.fraction x zero) =
   trans (E.extends x) (Local[h].Native.canonical-at x) ;
  map-add (x y : Local[g].Native.L.Carrier) :
   Id Local[h].Native.L.Carrier (map (Local[g].Native.add x y)) (Local[h].Native.add (map x) (map y)) = H.map-add native x y ;
  map-scale (a : A.R) (x : Local[g].Native.L.Carrier) :
   Id Local[h].Native.L.Carrier (map (Local[g].Native.localised.sm a x)) (Local[h].Native.localised.sm a (map x)) =
   H.map-scale native a x ;
  map-zero : Id Local[h].Native.L.Carrier (map Local[g].Native.Action.mz) Local[h].Native.Action.mz = H.map-zero native ;
  clears (x : Md.M) (p : Nat) : Id Local[h].Native.L.Carrier
   (E.T.power p (map (Local[g].Native.L.fraction x p))) (Local[h].Native.L.fraction x zero) =
   trans (ap (E.T.power p) (trans (E.lift-map-at (Local[g].Native.L.fraction x p)) (E.lift-at x p)))
    (trans (E.InverseAction.power-back p
     (MM.Between[A,A,RH.identity A,Md,Local[h].Native.localised].map Local[h].Native.canonical x))
     (Local[h].Native.canonical-at x)) ;
  opaque invertible ;
 } ;
 rho-irr (g h : A.R) (le le2 : O.Le (Z.D h) (Z.D g)) (x : Local[g].Native.L.Carrier) :
  Id Local[h].Native.L.Carrier (At[g,h,le].map x) (At[g,h,le2].map x) =
  ap (\ k -> At[g,h,k].map x) (O.le-prop (Z.D h) (Z.D g) le le2) ;
 module Identity (g : A.R) (le : O.Le (Z.D g) (Z.D g)) {
  module P = At[g,g,le] ;
  identity : P.H.Hom = new P.H.Hom[\ x -> x,\ x y -> refl (Local[g].Native.add x y),
   \ a x -> refl (Local[g].Native.localised.sm a x)] ;
  identity-original (x : Md.M) : Id Local[g].Native.L.Carrier
   (P.H.map identity (Local[g].Native.L.fraction x zero))
   (MM.Between[A,A,RH.identity A,Md,Local[g].Native.localised].map Local[g].Native.canonical x) =
   sym (Local[g].Native.canonical-at x) ;
  equation (x : Local[g].Native.L.Carrier) : Id Local[g].Native.L.Carrier (P.map x) x =
   sym (P.E.Other[identity,identity-original].unique x) ;
  opaque identity ;
 } ;
 rho-id (g : A.R) (le : O.Le (Z.D g) (Z.D g)) (x : Local[g].Native.L.Carrier) :
  Id Local[g].Native.L.Carrier (At[g,g,le].map x) x = Identity[g,le].equation x ;
 module Composite (g h k : A.R) (hg : O.Le (Z.D h) (Z.D g)) (kh : O.Le (Z.D k) (Z.D h))
  (kg : O.Le (Z.D k) (Z.D g)) {
  module P = At[g,h,hg] ; module Q = At[h,k,kh] ; module T = At[g,k,kg] ;
  composite : T.H.Hom = new T.H.Hom[\ x -> Q.map (P.map x),
   \ x y -> trans (ap Q.map (P.map-add x y)) (Q.map-add (P.map x) (P.map y)),
   \ a x -> trans (ap Q.map (P.map-scale a x)) (Q.map-scale a (P.map x))] ;
  composite-original (x : Md.M) : Id Local[k].Native.L.Carrier
   (T.H.map composite (Local[g].Native.L.fraction x zero))
   (MM.Between[A,A,RH.identity A,Md,Local[k].Native.localised].map Local[k].Native.canonical x) =
   trans (ap Q.map (P.on-original x)) (trans (Q.on-original x) (sym (Local[k].Native.canonical-at x))) ;
  equation (x : Local[g].Native.L.Carrier) : Id Local[k].Native.L.Carrier (Q.map (P.map x)) (T.map x) =
   T.E.Other[composite,composite-original].unique x ;
  opaque composite ;
 } ;
 rho-comp (g h k : A.R) (hg : O.Le (Z.D h) (Z.D g)) (kh : O.Le (Z.D k) (Z.D h))
  (kg : O.Le (Z.D k) (Z.D g)) (x : Local[g].Native.L.Carrier) :
  Id Local[k].Native.L.Carrier (At[h,k,kh].map (At[g,h,hg].map x)) (At[g,k,kg].map x) =
  Composite[g,h,k,hg,kh,kg].equation x ;
} ;
