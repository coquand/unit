-- Scalar compatibility of the actual basic module restrictions.
-- Represent r in A_g by g^p*r=a. Multiplying the proposed semilinearity
-- equation by g^p reduces both sides to A-linearity and this ring
-- fraction equation. The target g-action is invertible, so cancel its
-- power. Fraction representations are eliminated only into an equality
-- in the target set. Thus the actual A-linear restrictions are semilinear
-- over the existing ring restriction rho, without new module fractions.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module RM = RingMaps[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module R = SerreModuleBasicRestrictions[l].Over[A,setA,Md] ;
 module Z = R.Z ; module O = Z.O ; module AF = R.AF ;
 module At (g h : A.R) (le : O.Le (Z.D h) (Z.D g)) {
  module P = R.At[g,h,le] ;
  module Source = R.Local[g].Scalars ; module Target = R.Local[h].Scalars ;
  module GN = R.Local[g].Native ; module HN = R.Local[h].Native ;
  module Br = Bridge[l].Over[A,g] ;
  module RingPair = Restriction[l].Over[A,AF.Loc,AF.set,AF.inclusion,AF.elementary].Pair[g,h,le] ;
  module I = P.E.InverseAction ;
  module AP = AffinePowers[l].Over[A] ;
  source-clears (r : (AF.Loc g).R) (rep : Br.LocH.Fraction (AF.Loc g) (AF.inclusion g) r)
   (x : GN.L.Carrier) : Id GN.L.Carrier
   (GN.localised.sm (Br.LocH.den rep) (Source.localised.sm r x)) (GN.localised.sm (Br.LocH.num rep) x) =
   trans (sym (Source.ER.original-action (Br.LocH.den rep) (Source.localised.sm r x)))
    (trans (Source.localised.smA (RM.map (AF.inclusion g) (Br.LocH.den rep)) r x)
     (trans (ap (\ a -> Source.localised.sm a x) (Br.LocH.eqn rep)) (Source.ER.original-action (Br.LocH.num rep) x))) ;
  target-ring-clears (r : (AF.Loc g).R) (rep : Br.LocH.Fraction (AF.Loc g) (AF.inclusion g) r) :
   Id (AF.Loc h).R
    ((AF.Loc h).mul (RM.map (AF.inclusion h) (Br.LocH.den rep)) (RM.map (R.R.rho g h le) r))
    (RM.map (AF.inclusion h) (Br.LocH.num rep)) =
   trans (ap (\ a -> (AF.Loc h).mul a (RM.map (R.R.rho g h le) r)) (sym (R.R.rho-on g h le (Br.LocH.den rep))))
    (trans (sym (RM.map-mul (R.R.rho g h le) (RM.map (AF.inclusion g) (Br.LocH.den rep)) r))
     (trans (ap (RM.map (R.R.rho g h le)) (Br.LocH.eqn rep)) (R.R.rho-on g h le (Br.LocH.num rep)))) ;
  target-clears (r : (AF.Loc g).R) (rep : Br.LocH.Fraction (AF.Loc g) (AF.inclusion g) r)
   (x : HN.L.Carrier) : Id HN.L.Carrier
   (HN.localised.sm (Br.LocH.den rep) (Target.localised.sm (RM.map (R.R.rho g h le) r) x))
   (HN.localised.sm (Br.LocH.num rep) x) =
   trans (sym (Target.ER.original-action (Br.LocH.den rep) (Target.localised.sm (RM.map (R.R.rho g h le) r) x)))
    (trans (Target.localised.smA (RM.map (AF.inclusion h) (Br.LocH.den rep)) (RM.map (R.R.rho g h le) r) x)
     (trans (ap (\ a -> Target.localised.sm a x) (target-ring-clears r rep)) (Target.ER.original-action (Br.LocH.num rep) x))) ;
  denominator-power (r : (AF.Loc g).R) (rep : Br.LocH.Fraction (AF.Loc g) (AF.inclusion g) r)
   (x : HN.L.Carrier) : Id HN.L.Carrier
   (P.E.T.power (Br.index (Br.LocH.den-in rep)) x) (HN.localised.sm (Br.LocH.den rep) x) =
   trans (P.E.T.power-scalar (Br.index (Br.LocH.den-in rep)) x)
    (ap (\ a -> HN.localised.sm a x) (Br.index-eq (Br.LocH.den-in rep))) ;
  scale-from-representative (r : (AF.Loc g).R)
   (rep : Br.LocH.Fraction (AF.Loc g) (AF.inclusion g) r) (x : GN.L.Carrier) :
   Id HN.L.Carrier (P.map (Source.localised.sm r x)) (Target.localised.sm (RM.map (R.R.rho g h le) r) (P.map x)) =
   I.power-injective (Br.index (Br.LocH.den-in rep)) _ _
    (trans (denominator-power r rep (P.map (Source.localised.sm r x)))
     (trans (sym (P.map-scale (Br.LocH.den rep) (Source.localised.sm r x)))
      (trans (ap P.map (source-clears r rep x))
       (trans (P.map-scale (Br.LocH.num rep) x)
        (trans (sym (target-clears r rep (P.map x)))
         (sym (denominator-power r rep (Target.localised.sm (RM.map (R.R.rho g h le) r) (P.map x))))))))) ;
  scale (r : (AF.Loc g).R) (x : GN.L.Carrier) :
   Id HN.L.Carrier (P.map (Source.localised.sm r x)) (Target.localised.sm (RM.map (R.R.rho g h le) r) (P.map x)) =
   Tr.Trunc[Br.LocH.Fraction (AF.Loc g) (AF.inclusion g) r].induction @l
    (\ w -> Id HN.L.Carrier (P.map (Source.localised.sm r x)) (Target.localised.sm (RM.map (R.R.rho g h le) r) (P.map x)))
    (\ w -> HN.L.carrier-set _ _) (\ rep -> scale-from-representative r rep x) (Br.LocH.fractions (AF.elementary g) r) ;
  module Maps = MM.Between[AF.Loc g,AF.Loc h,R.R.rho g h le,Source.localised,Target.localised] ;
  restriction : Maps.Hom = new Maps.Hom[P.map,P.map-add,scale] ;
  restriction-at (x : GN.L.Carrier) : Id HN.L.Carrier (Maps.map restriction x) (P.map x) = refl (P.map x) ;
  opaque restriction ;
 } ;
} ;
