-- Exact pairs and surjections remain exact after localisation (Serre §3).
-- For a surjection, represent a localised element and lift its numerator.
-- For an exact pair B -> C -> P, a fraction x/f^p in the kernel has
-- numerator whose image is killed by some f^e. Lift f^e*x along B -> C;
-- dividing this lift by f^(e+p) gives the required localised preimage.
-- All choices remain under propositional truncation. The zero-composite
-- equation follows on fractions and then by fraction induction.
level l ; open Ring[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module LL = SerreModuleLocalisationLinear[l] ;
module LS = SerreModuleLocalisationStructure[l] ;
module Over (A : CRing) (Md Nd : SM.Over[A].Module)
 (q : MM.Between[A,A,RingHom[l].identity A,Md,Nd].Hom) (f : A.R) {
 module Q = MM.Between[A,A,RingHom[l].identity A,Md,Nd] ;
 module L = LL.Along[A,A,RingHom[l].identity A,Md,Nd,q,f] ;
 Surjective : U l = (y : Nd.M) -> Tr.Trunc[(x : Md.M) * Id Nd.M (Q.map q x) y].carrier ;
 LocalSurjective : U l = (y : L.T.L.Carrier) ->
  Tr.Trunc[(x : L.S.L.Carrier) * Id L.T.L.Carrier (L.Maps.map L.induced x) y].carrier ;
 module Fraction (surjective : Surjective) (y : L.T.L.Carrier)
  (a : Nd.M) (p : Nat) (e : Id L.T.L.Carrier (L.T.L.fraction a p) y) {
  lift : Tr.Trunc[(x : L.S.L.Carrier) * Id L.T.L.Carrier (L.Maps.map L.induced x) y].carrier =
   Tr.Trunc[(x : Md.M) * Id Nd.M (Q.map q x) a].induction @l
    (\ t -> Tr.Trunc[(x : L.S.L.Carrier) * Id L.T.L.Carrier (L.Maps.map L.induced x) y].carrier)
    (\ t -> Tr.Trunc[(x : L.S.L.Carrier) * Id L.T.L.Carrier (L.Maps.map L.induced x) y].proposition)
    (\ w -> Tr.Trunc[(x : L.S.L.Carrier) * Id L.T.L.Carrier (L.Maps.map L.induced x) y].inc
     (L.S.L.fraction w.1 p,trans (L.induced-at w.1 p)
      (trans (ap (\ a -> L.T.L.fraction a p) w.2) e))) (surjective a) ;
 } ;
 surjective (onto : Surjective) : LocalSurjective = \ y ->
  Tr.Trunc[(a : Nd.M) * (p : Nat) * Id L.T.L.Carrier (L.T.L.fraction a p) y].induction @l
   (\ t -> Tr.Trunc[(x : L.S.L.Carrier) * Id L.T.L.Carrier (L.Maps.map L.induced x) y].carrier)
   (\ t -> Tr.Trunc[(x : L.S.L.Carrier) * Id L.T.L.Carrier (L.Maps.map L.induced x) y].proposition)
   (\ r -> Fraction[onto,y,r.1,r.2.1,r.2.2].lift) (L.T.L.represented y) ;
} ;
module Pair (A : CRing) (B C P : SM.Over[A].Module)
 (d : MM.Between[A,A,RingHom[l].identity A,B,C].Hom)
 (q : MM.Between[A,A,RingHom[l].identity A,C,P].Hom) (f : A.R) {
 module D = MM.Between[A,A,RingHom[l].identity A,B,C] ;
 module Q = MM.Between[A,A,RingHom[l].identity A,C,P] ;
 module DL = LL.Along[A,A,RingHom[l].identity A,B,C,d,f] ;
 module QL = LL.Along[A,A,RingHom[l].identity A,C,P,q,f] ;
 module Kernel = SerreModuleLocalisationKernel[l].At[A,C,P,q,f] ;
 Kills : U l = (b : B.M) -> Id P.M (Q.map q (D.map d b)) P.mz ;
 Exact : U l = (x : C.M) -> Id P.M (Q.map q x) P.mz ->
  Tr.Trunc[(b : B.M) * Id C.M (D.map d b) x].carrier ;
 LocalImage (x : QL.S.L.Carrier) : U l =
  Tr.Trunc[(b : DL.S.L.Carrier) * Id QL.S.L.Carrier (DL.Maps.map DL.induced b) x].carrier ;
 kills (zero-composite : Kills) (x : DL.S.L.Carrier) :
  Id QL.T.L.Carrier (QL.Maps.map QL.induced (DL.Maps.map DL.induced x)) QL.T.Action.mz =
  DL.S.L.induction @l
   (\ x -> Id QL.T.L.Carrier (QL.Maps.map QL.induced (DL.Maps.map DL.induced x)) QL.T.Action.mz)
   (\ x -> QL.T.L.carrier-set _ _)
   (\ b p -> trans (ap (QL.Maps.map QL.induced) (DL.induced-at b p))
    (trans (QL.induced-at (D.map d b) p)
     (trans (ap (\ y -> QL.T.L.fraction y p) (zero-composite b)) (QL.T.Action.zero-at p)))) x ;
 module Fraction (exact : Exact) (y : QL.S.L.Carrier)
  (in-kernel : Id QL.T.L.Carrier (QL.Maps.map QL.induced y) QL.T.Action.mz)
  (x : C.M) (p : Nat) (represents : Id QL.S.L.Carrier (QL.S.L.fraction x p) y) {
  image-zero : Id QL.T.L.Carrier (QL.T.L.fraction (Q.map q x) p) QL.T.Action.mz =
   trans (sym (QL.induced-at x p)) (trans (ap (QL.Maps.map QL.induced) represents) in-kernel) ;
  killers : Tr.Trunc[QL.T.L.Killed (Q.map q x)].carrier =
   QL.T.L.zero-killed (Q.map q x) (Kernel.numerator-zero (Q.map q x) p image-zero) ;
  module Killed (w : QL.T.L.Killed (Q.map q x)) {
   numerator-in-kernel : Id P.M (Q.map q (QL.S.L.power w.1 x)) P.mz = trans (QL.Map.power-map w.1 x) w.2 ;
   lift : LocalImage y =
    Tr.Trunc[(b : B.M) * Id C.M (D.map d b) (QL.S.L.power w.1 x)].induction @l
     (\ t -> LocalImage y)
     (\ t -> Tr.Trunc[(b : DL.S.L.Carrier) * Id QL.S.L.Carrier (DL.Maps.map DL.induced b) y].proposition)
     (\ v -> Tr.Trunc[(b : DL.S.L.Carrier) * Id QL.S.L.Carrier (DL.Maps.map DL.induced b) y].inc
      (DL.S.L.fraction v.1 (plus w.1 p),trans (DL.induced-at v.1 (plus w.1 p))
       (trans (ap (\ a -> QL.S.L.fraction a (plus w.1 p)) v.2)
        (trans (QL.S.L.raise x p w.1) represents)))) (exact (QL.S.L.power w.1 x) numerator-in-kernel) ;
  } ;
  lift : LocalImage y = Tr.Trunc[QL.T.L.Killed (Q.map q x)].induction @l
   (\ t -> LocalImage y)
   (\ t -> Tr.Trunc[(b : DL.S.L.Carrier) * Id QL.S.L.Carrier (DL.Maps.map DL.induced b) y].proposition)
   (\ w -> Killed[w].lift) killers ;
 } ;
 exact (original : Exact) (y : QL.S.L.Carrier)
  (in-kernel : Id QL.T.L.Carrier (QL.Maps.map QL.induced y) QL.T.Action.mz) : LocalImage y =
  Tr.Trunc[(x : C.M) * (p : Nat) * Id QL.S.L.Carrier (QL.S.L.fraction x p) y].induction @l
   (\ t -> LocalImage y)
   (\ t -> Tr.Trunc[(b : DL.S.L.Carrier) * Id QL.S.L.Carrier (DL.Maps.map DL.induced b) y].proposition)
   (\ r -> Fraction[original,y,in-kernel,r.1,r.2.1,r.2.2].lift) (QL.S.L.represented y) ;
} ;
