-- Compatibility of the localisation-chart comparison on image-A basics.
-- Evaluate target restrictions at g*b: by the section compatibility and
-- chart inclusion equations this is native restriction M_(g*a)->M_(g*b).
-- The native comparison square commutes by localisation uniqueness and
-- composition of original restrictions. Source evaluation is natural.
-- Injectivity of target evaluation therefore proves the sheaf-basis
-- compatibility equation required for the genuine global extension.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) (g : A.R) {
 module P = SerreAssociatedRestriction[l].Over[A,setA,Md,g] ;
 module Raw = P.Local.Raw ; module R = Raw.R ; module O = P.O ; module ZA = P.ZA ;
 module Source = P.Source ; module Original = P.Original ; module N = P.N ; module M = P.M ;
 module Pair (a b : A.R) (le : P.OB.Le (P.basic b) (P.basic a)) {
  module S = P.At[a] ; module T = P.At[b] ;
  image-inclusion : O.Le T.underlying S.underlying =
   P.Cht.Sl.le-inc (P.Push.p (P.basic b)) (P.Push.p (P.basic a)) (P.Push.mono (P.basic b) (P.basic a) le) ;
  native-below : O.Le (ZA.D T.C.ga) (ZA.D S.C.ga) =
   O.le-trans (ZA.D T.C.ga) S.underlying (ZA.D S.C.ga)
    (O.le-trans (ZA.D T.C.ga) T.underlying S.underlying T.RR.below image-inclusion) S.upper ;
  raw-below : O.Le (ZA.D T.C.ag) (ZA.D S.C.ag) =
   O.le-trans (ZA.D T.C.ag) (ZA.D T.C.ga) (ZA.D S.C.ag) T.C.reverse-below
    (O.le-trans (ZA.D T.C.ga) (ZA.D S.C.ga) (ZA.D S.C.ag) native-below S.C.below) ;
  all-below : O.Le (ZA.D T.C.ga) (ZA.D S.C.ag) =
   O.le-trans (ZA.D T.C.ga) (ZA.D T.C.ag) (ZA.D S.C.ag) T.C.below raw-below ;
  module NativeRestriction = R.At[S.C.ga,T.C.ga,native-below] ;
  module Square = Raw.Square[a,b,le,raw-below] ;
  native (x : S.C.Native.I.SourcePower.Carrier) : Id R.Local[T.C.ga].Native.L.Carrier
   (NativeRestriction.map (S.C.map x)) (T.C.map (Square.Source.map x)) =
   trans (ap NativeRestriction.map (S.C.map-native x))
    (trans (ap NativeRestriction.map (S.C.native-at x))
     (trans (R.rho-comp S.C.ag S.C.ga T.C.ga S.C.below native-below all-below (S.C.Native.map x))
      (trans (sym (R.rho-comp S.C.ag T.C.ag T.C.ga raw-below T.C.below all-below (S.C.Native.map x)))
       (trans (ap T.C.Swap.P.map (Square.equation x))
        (trans (sym (T.C.native-at (Square.Source.map x))) (sym (T.C.map-native (Square.Source.map x)))))))) ;
  source-eval-restriction (s : (Source.associated.presheaf.module-at (P.basic a)).M) :
   Id T.C.Native.I.SourcePower.Carrier
    (T.source-eval (P.SO.restrict (P.basic b) (P.basic a) le s))
    (Square.Source.map (S.source-eval s)) =
   trans (T.SB.evaluation-at (P.SO.restrict (P.basic b) (P.basic a) le s))
    (trans (ap T.SB.eval (M.restriction-map (P.basic b) (P.basic a) le s))
     (trans (P.Local.SB.natural S.RR.b T.RR.b le s)
      (trans (Source.AM.component-restriction S.RR.b T.RR.b le (S.SB.eval s))
       (ap Square.Source.map (sym (S.SB.evaluation-at s)))))) ;
  target-eval-restriction (s : (P.Push.presheaf.module-at (P.basic a)).M) :
   Id R.Local[T.C.ga].Native.L.Carrier
    (T.evaluate (P.TO.restrict (P.basic b) (P.basic a) le s)) (NativeRestriction.map (S.evaluate s)) =
   trans (ap T.evaluate (P.Push.presheaf-res (P.basic b) (P.basic a) le s))
    (trans (ap T.evaluate (P.SliceModule.restrict-inc (P.Push.p (P.basic b)) (P.Push.p (P.basic a))
     (P.Push.mono (P.basic b) (P.basic a) le) s))
     (trans (ap T.evaluate (N.restriction-map T.underlying S.underlying image-inclusion s))
      (trans (N.restrict-at T.underlying S.underlying image-inclusion s T.C.ga T.RR.below)
       (trans (N.component-irr S.underlying s T.C.ga
        (O.le-trans (ZA.D T.C.ga) T.underlying S.underlying T.RR.below image-inclusion)
        (O.le-trans (ZA.D T.C.ga) (ZA.D S.C.ga) S.underlying native-below S.RR.below))
        (trans (sym (N.compat s S.C.ga T.C.ga S.RR.below native-below))
         (Original.AM.component-restriction S.C.ga T.C.ga native-below (S.evaluate s))))))) ;
  equation (s : (Source.associated.presheaf.module-at (P.basic a)).M) :
   Id (P.Push.presheaf.module-at (P.basic b)).M
    (P.TO.restrict (P.basic b) (P.basic a) le (S.Maps.map S.component s))
    (T.Maps.map T.component (P.SO.restrict (P.basic b) (P.basic a) le s)) =
   Iso[l].injective _ _ T.evaluate T.evaluate-equivalence _ _
    (trans (target-eval-restriction (S.Maps.map S.component s))
     (trans (ap NativeRestriction.map (ap S.evaluate (S.component-at s)))
      (trans (ap NativeRestriction.map (S.evaluate-forward s))
       (trans (native (S.source-eval s))
        (trans (ap T.C.map (sym (source-eval-restriction s)))
         (trans (sym (T.evaluate-forward (P.SO.restrict (P.basic b) (P.basic a) le s)))
          (ap T.evaluate (sym (T.component-at (P.SO.restrict (P.basic b) (P.basic a) le s)))))))))) ;
 } ;
} ;
