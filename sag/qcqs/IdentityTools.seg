-- Elementary identity tools used in the structured identity proof.
-- Products and dependent functions of propositions are propositions.
-- Sethood is a proposition by function extensionality twice.
-- A bi-invertibility witness between sets is a proposition: its section
-- and retraction are unique (sec-ret), and their equations are in sets.
-- Finally every based path space is contractible, by path induction.
level l ; open Base ; open Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
both (A B : U l) (a : isProp A) (b : isProp B) : isProp (A * B) = isProp-Sigma A (\ x -> B) a (\ x -> b) ;
set-prop (X : U l) : isProp (isSet X) = \ s t ->
 FE.funext X (\ x -> (y : X) -> isProp (Id X x y)) s t (\ x ->
  FE.funext X (\ y -> isProp (Id X x y)) (s x) (t x) (\ y -> FE.isProp-isProp (Id X x y) (s x y) (t x y))) ;
contr-prop (X : U l) : isProp (FunExtUA[l].isContr X) = \ c d ->
 Sigma-eq X (\ x -> (y : X) -> Id X x y) c.1 d.1 c.2 d.2 (FunExtUA[l].pathC X c c.1 d.1)
  (FE.isProp-Pi X (\ y -> Id X d.1 y) (\ y -> prop-to-set X (\ u v -> FunExtUA[l].pathC X c u v) d.1 y)) ;
module Equivalence (A B : U l) (sA : isSet A) (sB : isSet B) (f : A -> B) {
 Parts : U l = ((g : B -> A) * ((b : B) -> Id B (f (g b)) b)) * ((h : B -> A) * ((a : A) -> Id A (h (f a)) a)) ;
 fields (e : isEquiv A B f) : Parts = ((e.sec,e.sec-eq),(e.ret,e.ret-eq)) ;
 make (p : Parts) : isEquiv A B f = struct { sec = p.1.1 ; sec-eq = p.1.2 ; ret = p.2.1 ; ret-eq = p.2.2 } ;
 eta : (e : isEquiv A B f) -> Id (isEquiv A B f) (make (fields e)) e = split {
  mk g u h v -> refl (struct { sec = g ; sec-eq = u ; ret = h ; ret-eq = v }) } ;
 section-eq (e d : isEquiv A B f) : Id (B -> A) e.sec d.sec = FE.funext B (\ b -> A) e.sec d.sec (\ b ->
  trans A (e.sec b) (e.sec (f (d.sec b))) (d.sec b)
   (ap B A e.sec b (f (d.sec b)) (sym B (f (d.sec b)) b (d.sec-eq b))) (sec-ret A B f e (d.sec b))) ;
 retraction-eq (e d : isEquiv A B f) : Id (B -> A) e.ret d.ret = FE.funext B (\ b -> A) e.ret d.ret (\ b ->
  trans A (e.ret b) (e.ret (f (d.sec b))) (d.ret b)
   (ap B A e.ret b (f (d.sec b)) (sym B (f (d.sec b)) b (d.sec-eq b)))
   (trans A (e.ret (f (d.sec b))) (d.sec b) (d.ret b) (e.ret-eq (d.sec b))
    (sym A (d.ret b) (d.sec b) (trans A (d.ret b) (d.ret (f (d.sec b))) (d.sec b)
     (ap B A d.ret b (f (d.sec b)) (sym B (f (d.sec b)) b (d.sec-eq b))) (d.ret-eq (d.sec b)))))) ;
 equal (e d : isEquiv A B f) : Id (isEquiv A B f) e d =
  trans (isEquiv A B f) e (make (fields e)) d (sym (isEquiv A B f) (make (fields e)) e (eta e))
   (trans (isEquiv A B f) (make (fields e)) (make (fields d)) d
    (ap Parts (isEquiv A B f) make (fields e) (fields d)
     (trans Parts (fields e) ((fields d).1,(fields e).2) (fields d)
      (ap ((g : B -> A) * ((b : B) -> Id B (f (g b)) b)) Parts (\ v -> (v,(fields e).2)) (fields e).1 (fields d).1
       (Sigma-eq (B -> A) (\ g -> (b : B) -> Id B (f (g b)) b) e.sec d.sec e.sec-eq d.sec-eq (section-eq e d)
        (FE.isProp-Pi B (\ b -> Id B (f (d.sec b)) b) (\ b -> sB (f (d.sec b)) b))))
      (ap ((h : B -> A) * ((a : A) -> Id A (h (f a)) a)) Parts (\ v -> ((fields d).1,v)) (fields e).2 (fields d).2
       (Sigma-eq (B -> A) (\ h -> (a : A) -> Id A (h (f a)) a) e.ret d.ret e.ret-eq d.ret-eq (retraction-eq e d)
        (FE.isProp-Pi A (\ a -> Id A (d.ret (f a)) a) (\ a -> sA (d.ret (f a)) a)))))) (eta d)) ;
} ;
