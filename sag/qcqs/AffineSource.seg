-- Affine evaluation is invariant under an isomorphism of the source.
-- Let c : X -> Spec A be an isomorphism, with inverse v.  For a natural
-- family alpha : h_X -> h_Y, precompose it with h_v and apply evaluation
-- on Spec A, getting b : Spec A -> Y.  Define the recovered map as b c.
-- At a point p of X, affine evaluation gives b(c p) = alpha(v(c p));
-- associativity and v c = 1 reduce this to alpha(p).
-- Conversely, for alpha induced by f, evaluation gives f v; multiplying
-- by c gives f, by v c = 1.  These are both inverse laws.  The instance
-- at the canonical isomorphism X -> Spec Gamma X handles any affine X.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module Sp = Spaces[l] ;
module T = AffineTests[l] ;
module FP = FunctorPoints[l] ;
module Along (X : Sp.Space) (A : T.Test) (c : Sp.Hom X (T.space A)) (iso : Sp.IsIso X (T.space A) c) (Y : Sp.Space) {
 module V = Sp.InvertMap[X,T.space A,c,iso] ;
 module N = FP.Maps[X,Y] ;
 module NA = FP.Maps[T.space A,Y] ;
 module AE = AffineEvaluation[l].Over[A,Y] ;
 pulled (alpha : N.Nat) : NA.Nat = FP.NaturalComposition[T.space A,X,Y,alpha,FP.Maps[T.space A,X].induced V.inverse].composite ;
 recover (alpha : N.Nat) : Sp.Hom X Y = Sp.compose X (T.space A) Y (AE.eval (pulled alpha)) c ;
 module At (alpha : N.Nat) (B : T.Test) (p : Sp.Hom (T.space B) X) {
  on-affine : Id (Sp.Hom (T.space B) Y)
   (Sp.compose (T.space B) (T.space A) Y (AE.eval (pulled alpha)) (Sp.compose (T.space B) X (T.space A) c p))
   (N.at alpha B (Sp.compose (T.space B) (T.space A) X V.inverse (Sp.compose (T.space B) X (T.space A) c p))) =
   Hi.ap NA.Nat (Sp.Hom (T.space B) Y) (\ a -> NA.at a B (Sp.compose (T.space B) X (T.space A) c p))
    (NA.induced (AE.eval (pulled alpha))) (pulled alpha) (AE.induced-eval (pulled alpha)) ;
  inverse-at : Id (Sp.Hom (T.space B) X)
   (Sp.compose (T.space B) (T.space A) X V.inverse (Sp.compose (T.space B) X (T.space A) c p)) p =
   trans Sp.Associativity[T.space B,X,T.space A,X,V.inverse,c,p].assoc
    (trans (ap (\ q -> Sp.compose (T.space B) X X q p) V.inverse-left) Sp.Laws[T.space B,X,p].left) ;
  at : Id (Sp.Hom (T.space B) Y) (N.at (N.induced (recover alpha)) B p) (N.at alpha B p) =
   trans (sym Sp.Associativity[T.space B,X,T.space A,Y,AE.eval (pulled alpha),c,p].assoc)
    (trans on-affine (ap (N.at alpha B) inverse-at)) ;
 } ;
 induced-recover (alpha : N.Nat) : Id N.Nat (N.induced (recover alpha)) alpha =
  N.ext (N.induced (recover alpha)) alpha (\ B p -> At[alpha,B,p].at) ;
 recover-induced (f : Sp.Hom X Y) : Id (Sp.Hom X Y) (recover (N.induced f)) f =
  calc (Sp.Hom X Y) {
   Sp.compose X (T.space A) Y (AE.eval (pulled (N.induced f))) c
    =< ap (\ q -> Sp.compose X (T.space A) Y q c)
      (ap (Sp.compose (T.space A) X Y f) Sp.Laws[T.space A,X,V.inverse].right)
     > Sp.compose X (T.space A) Y (Sp.compose (T.space A) X Y f V.inverse) c
    =< sym Sp.Associativity[X,T.space A,X,Y,f,V.inverse,c].assoc
     > Sp.compose X X Y f (Sp.compose X (T.space A) X V.inverse c)
    =< ap (Sp.compose X X Y f) V.inverse-left > Sp.compose X X Y f Sp.Identity[X].identity
    =< Sp.Laws[X,Y,f].right > f } ;
 equivalence : Hi.isEquiv (Sp.Hom X Y) N.Nat N.induced = Hi.qinv (Sp.Hom X Y) N.Nat N.induced recover induced-recover recover-induced ;
} ;
module FromAffine (X Y : Sp.Space) (affine : AffineCriterion[l].Over[X.lattice,X.structure].IsAffine) {
 module AX = AffineCriterion[l].Over[X.lattice,X.structure] ;
 test : T.Test = new T.Test[X.structure.sheaf.ring X.lattice.top,X.structure.sheaf.ring-set X.lattice.top] ;
 canonical : Sp.Hom X (T.space test) = (AX.canonical,AX.Can.Of[RingHom[l].identity (X.structure.sheaf.ring X.lattice.top)].local) ;
 canonical-iso : Sp.IsIso X (T.space test) canonical = affine ;
 opaque canonical ;
 module AtAffine = Along[X,test,canonical,canonical-iso,Y] ;
 equivalence : Hi.isEquiv (Sp.Hom X Y) FP.Maps[X,Y].Nat FP.Maps[X,Y].induced = AtAffine.equivalence ;
} ;
