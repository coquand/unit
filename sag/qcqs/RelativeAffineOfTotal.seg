-- Recover relative affineness from an affine total functor (note §4).
-- The generic point of e:h_A~=T(F) gives alpha:k->A.  Naturality at
-- h:A->B says that the base of e(h) is h alpha, using the right-unit
-- equation for h.  For an actual algebra map a:(A,alpha)->(B,iota),
-- concatenate this path with its commuting path and transport e(a)'s
-- value into F(B,iota).  Its paired point is still e(a).
-- That point equation, e's naturality, and total-on prove naturality
-- after fixed-base injectivity.  Conversely invert e on (iota,x); the
-- same base equation equips its ring map with the required algebra
-- structure.  The two inverse laws follow on total points, then by
-- fixed-base injectivity and algebra-map extensionality, respectively.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module RM = RingMaps[l] ;
module SF = TestFunctors[l] ;
module TE = TestEquivalences[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) (A : T.Test)
 (e : TE.NaturalEquivalence SF.Representable[A].functor RelativeTotal[l].Over[K,F].functor) {
 module TF = RelativeTotal[l].Over[K,F] ;
 module R = TF.R ;
 module RT = R.RT ;
 module BP = R.BP ;
 module E = RelativeEquivalences[l].Over[K] ;
 module H = SF.Representable[A] ;
 module N = SF.Transform[H.functor,TF.functor] ;
 module I = TE.Inverse[H.functor,TF.functor,e] ;
 module Y = TestYoneda[l].Over[A,TF.functor] ;
 point (B : T.Test) (h : RH.Hom A.ring B.ring) : TF.functor.obj B = N.at (TE.forward e) B h ;
 generic : TF.functor.obj A = point A (RH.identity A.ring) ;
 algebra : BP.Algebra = BP.algebra A (TF.At[A].base generic) ;
 point-base (B : T.Test) (h : RH.Hom A.ring B.ring) : Id TF.At[B].Indices
  (TF.At[B].base (point B h)) (RT.push A B h (BP.iota algebra)) =
  trans (ap (\ g -> TF.At[B].base (point B g)) (sym (Y.right-unit B h)))
   (ap (TF.At[B].base) (N.natural (TE.forward e) A B h (RH.identity A.ring))) ;
 module At (B : BP.Algebra) {
  module Value (a : BP.Hom algebra B) {
   p : TF.functor.obj (BP.test B) = point (BP.test B) (BP.ring-map a) ;
   base-path : Id TF.At[BP.test B].Indices (TF.At[BP.test B].base p) (BP.iota B) =
    trans (point-base (BP.test B) (BP.ring-map a)) (RT.commuting-path algebra B a) ;
   forward : F.obj B = TF.At[BP.test B].DP.move base-path (TF.At[BP.test B].value p) ;
   trace : Id (TF.functor.obj (BP.test B)) p (TF.At[BP.test B].pair (BP.iota B) forward) =
    TF.At[BP.test B].DP.pair-equality (TF.At[BP.test B].value p) forward base-path (refl forward) ;
  } ;
  module Back (x : F.obj B) {
   p : TF.functor.obj (BP.test B) = TF.At[BP.test B].pair (BP.iota B) x ;
   ring-map : RH.Hom A.ring (BP.test B).ring = I.inverse-map (BP.test B) p ;
   base-path : Id TF.At[BP.test B].Indices (RT.push A (BP.test B) ring-map (BP.iota algebra)) (BP.iota B) =
    trans (sym (point-base (BP.test B) ring-map)) (ap (TF.At[BP.test B].base) (I.right-at (BP.test B) p)) ;
   morphism : BP.Hom algebra B = (ring-map,\ r -> ap (\ i -> RM.map {K.ring} {(BP.test B).ring} i r) base-path) ;
   right : Id (F.obj B) Value[morphism].forward x =
    TF.At[BP.test B].DP.injective (BP.iota B) Value[morphism].forward x
     (trans (sym Value[morphism].trace) (I.right-at (BP.test B) p)) ;
  } ;
  left (a : BP.Hom algebra B) : Id (BP.Hom algebra B) Back[Value[a].forward].morphism a =
   RT.ext algebra B Back[Value[a].forward].morphism a
    (trans (ap (I.inverse-map (BP.test B)) (sym Value[a].trace)) (I.left-at (BP.test B) (BP.ring-map a))) ;
 } ;
 natural (B C : BP.Algebra) (h : BP.Hom B C) (a : BP.Hom algebra B) : Id (F.obj C)
  At[C].Value[BP.compose-hom algebra B C h a].forward (F.reindex B C h At[B].Value[a].forward) =
  TF.At[BP.test C].DP.injective (BP.iota C) _ _
   (trans (sym At[C].Value[BP.compose-hom algebra B C h a].trace)
    (trans (N.natural (TE.forward e) (BP.test B) (BP.test C) (BP.ring-map h) (BP.ring-map a))
     (trans (ap (TF.functor.reindex (BP.test B) (BP.test C) (BP.ring-map h)) At[B].Value[a].trace)
      (TF.on-algebra B C h At[B].Value[a].forward)))) ;
 transformation : R.Transform[R.Representable[algebra].functor,F].Nat = (\ B a -> At[B].Value[a].forward,natural) ;
 equivalence : E.NaturalEquivalence R.Representable[algebra].functor F = (transformation,\ B ->
  Pr.qinv (BP.Hom algebra B) (F.obj B) (\ a -> At[B].Value[a].forward) (\ x -> At[B].Back[x].morphism)
   (\ x -> At[B].Back[x].right) (\ a -> At[B].left a)) ;
 opaque equivalence ;
} ;
