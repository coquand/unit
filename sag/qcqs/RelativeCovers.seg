-- The actual k-algebra diagram of a finite basic cover (§3).
-- Give each localisation the structure map obtained from the specified
-- base map.  The overlap maps commute with those structures by the
-- existing localisation base triangles.  Equality of the composites is
-- equality of their ring maps, followed by algebra-map extensionality.
-- Compatibility and matching are equalities in the native relative
-- functor.  Matching is a proposition and the amalgam type is a set.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module T = AffineTests[l] ;
module RH = RingHom[l] ;
module RM = RingMaps[l] ;
module TS = TestSheaves[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) {
 module R = RelativeFunctors[l].Over[K] ;
 module BP = R.BP ;
 module RT = R.RT ;
 module Cover (c : TS.CoverData) (iota : RH.Hom K.ring (TS.base c).ring) {
  module D = TS.Diagram[TS.base c,TS.count c,TS.generators c,TS.covers c] ;
  base : BP.Algebra = BP.algebra (TS.base c) iota ;
  basic (i : Fin (TS.count c)) : BP.Algebra = BP.algebra (D.basic i) (RT.push (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) iota) ;
  double (i j : Fin (TS.count c)) : BP.Algebra = BP.algebra (D.double i j)
   (RT.push (TS.base c) (D.double i j) (D.AB.inclusion ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))) iota) ;
  inclusion (i : Fin (TS.count c)) : BP.Hom base (basic i) = RT.canonical (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) iota ;
  left-base-at (i j : Fin (TS.count c)) (a : (TS.base c).ring.R) : Id (D.double i j).ring.R
   (RM.map (D.left i j) (RM.map (D.AB.inclusion (TS.generators c i)) a))
   (RM.map (D.AB.inclusion ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))) a) =
   D.S.rho-on (TS.generators c i) ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))
    (D.G.le-left (TS.generators c i) (TS.generators c j)) a ;
  right-base-at (i j : Fin (TS.count c)) (a : (TS.base c).ring.R) : Id (D.double i j).ring.R
   (RM.map (D.right i j) (RM.map (D.AB.inclusion (TS.generators c j)) a))
   (RM.map (D.AB.inclusion ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))) a) =
   D.S.rho-on (TS.generators c j) ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))
    (D.G.le-right (TS.generators c i) (TS.generators c j)) a ;
  left-commutes (i j : Fin (TS.count c)) : RT.Commutes (basic i) (double i j) (D.left i j) = \ r ->
   trans (ap (RM.map (D.left i j)) (RT.push-at (TS.base c) (D.basic i) (D.AB.inclusion (TS.generators c i)) iota r))
    (trans (left-base-at i j (RM.map iota r))
     (sym (RT.push-at (TS.base c) (D.double i j) (D.AB.inclusion ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))) iota r))) ;
  right-commutes (i j : Fin (TS.count c)) : RT.Commutes (basic j) (double i j) (D.right i j) = \ r ->
   trans (ap (RM.map (D.right i j)) (RT.push-at (TS.base c) (D.basic j) (D.AB.inclusion (TS.generators c j)) iota r))
    (trans (right-base-at i j (RM.map iota r))
     (sym (RT.push-at (TS.base c) (D.double i j) (D.AB.inclusion ((TS.base c).ring.mul (TS.generators c i) (TS.generators c j))) iota r))) ;
  left (i j : Fin (TS.count c)) : BP.Hom (basic i) (double i j) = (D.left i j,left-commutes i j) ;
  right (i j : Fin (TS.count c)) : BP.Hom (basic j) (double i j) = (D.right i j,right-commutes i j) ;
  base-point-square (i j : Fin (TS.count c)) (a : (TS.base c).ring.R) : Id (D.double i j).ring.R
   (RM.map (BP.ring-map (BP.compose-hom base (basic i) (double i j) (left i j) (inclusion i))) a)
   (RM.map (BP.ring-map (BP.compose-hom base (basic j) (double i j) (right i j) (inclusion j))) a) =
   trans (RT.compose-at base (basic i) (double i j) (left i j) (inclusion i) a)
    (trans (left-base-at i j a) (trans (sym (right-base-at i j a))
     (sym (RT.compose-at base (basic j) (double i j) (right i j) (inclusion j) a)))) ;
  base-square (i j : Fin (TS.count c)) : Id (BP.Hom base (double i j))
   (BP.compose-hom base (basic i) (double i j) (left i j) (inclusion i))
   (BP.compose-hom base (basic j) (double i j) (right i j) (inclusion j)) =
   RT.ext-at base (double i j)
    (BP.compose-hom base (basic i) (double i j) (left i j) (inclusion i))
    (BP.compose-hom base (basic j) (double i j) (right i j) (inclusion j)) (base-point-square i j) ;
  Values : U l = (i : Fin (TS.count c)) -> F.obj (basic i) ;
  Compatible (xs : Values) : U l = (i j : Fin (TS.count c)) -> Id (F.obj (double i j))
   (F.reindex (basic i) (double i j) (left i j) (xs i)) (F.reindex (basic j) (double i j) (right i j) (xs j)) ;
  restrictions (x : F.obj base) : Values = \ i -> F.reindex base (basic i) (inclusion i) x ;
  compatible (x : F.obj base) : Compatible (restrictions x) = \ i j ->
   trans (sym (F.composition base (basic i) (double i j) (inclusion i) (left i j) x))
    (trans (ap (\ h -> F.reindex base (double i j) h x) (base-square i j))
     (F.composition base (basic j) (double i j) (inclusion j) (right i j) x)) ;
  Matches (xs : Values) (x : F.obj base) : U l = (i : Fin (TS.count c)) -> Id (F.obj (basic i)) (restrictions x i) (xs i) ;
  matches-prop (xs : Values) (x : F.obj base) : Pr.isProp (Matches xs x) =
   FE.isProp-Pi (Fin (TS.count c)) (\ i -> Id (F.obj (basic i)) (restrictions x i) (xs i)) (\ i -> F.set (basic i) _ _) ;
  Amalgam (xs : Values) : U l = (x : F.obj base) * Matches xs x ;
  amalgam-set (xs : Values) : Pr.isSet (Amalgam xs) = Pr.isSet-Sigma (F.obj base) (Matches xs) (F.set base)
   (\ x -> Pr.prop-to-set (Matches xs x) (matches-prop xs x)) ;
 } ;
} ;
