-- The sections over a basic open: O(D g) = R_g (DESIGN.md, step 3).
--
-- Evaluation at g, s |-> s_g, is a ring map O(D g) -> R_g (Sections,
-- component).  Its inverse sends x to the section
-- (rho_{g,h} x)_h, compatible since rho_{h,h'} . rho_{g,h} = rho_{g,h'}.
--  Evaluating it at g gives rho_{g,g} x = x.
--  For a section s, rho_{g,h}(s_g) = s_h by compatibility.
-- No cover and no presentation of D g are involved.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module Over (A : CRing) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
 (f : (g : A.R) -> RH.Hom A (Loc g))
 (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g)) {
 open A ;
 open ZariskiLattice[l].Over[A] ;
 module S = Sections[l].Over[A,Loc,set,f,el] ;

 module At (g : R) {
  gg : O.Le (D g) (D g) = O.le-refl (D g) ;
  eval (s : S.Section (D g)) : (Loc g).R = S.at s g gg ;
  -- the components of the section of x
  compatible (x : (Loc g).R) : S.Compatible (D g) (\ h k -> map (S.rho g h k) x) =
   \ h h' kh hh' -> S.rho-comp-at g h h' kh hh' (O.le-trans (D h') (D h) (D g) hh' kh) x ;
  extend (x : (Loc g).R) : S.Section (D g) = (\ h k -> map (S.rho g h k) x,compatible x) ;
  extend-at (x : (Loc g).R) (h : R) (k : O.Le (D h) (D g)) : Id (Loc h).R (S.at (extend x) h k) (map (S.rho g h k) x) =
   refl (map (S.rho g h k) x) ;

  -- extend is a ring map, componentwise
  extension : RH.Hom (Loc g) (S.ring (D g)) =
   (extend,
    S.Ops[D g].ext (extend (Loc g).o) S.Ops[D g].oneS (\ h k -> map-one (S.rho g h k)),
    \ x y -> S.Ops[D g].ext (extend ((Loc g).add x y)) (S.Ops[D g].addS (extend x) (extend y)) (\ h k -> map-add (S.rho g h k) x y),
    \ x y -> S.Ops[D g].ext (extend ((Loc g).mul x y)) (S.Ops[D g].mulS (extend x) (extend y)) (\ h k -> map-mul (S.rho g h k) x y)) ;
  extension-map (x : (Loc g).R) : Id (S.Section (D g)) (map extension x) (extend x) = refl (extend x) ;

  eval-extend (x : (Loc g).R) : Id (Loc g).R (eval (extend x)) x =
   trans (extend-at x g gg) (S.rho-id-at g gg x) ;
  extend-eval (s : S.Section (D g)) : Id (S.Section (D g)) (extend (eval s)) s =
   S.section-ext (D g) (extend (eval s)) s (\ h k ->
    trans (extend-at (eval s) h k)
     (trans (S.compat s g h gg k) (S.component-irr (D g) s h (O.le-trans (D h) (D g) (D g) k gg) k))) ;

  -- evaluation is a ring map, and an isomorphism
  evaluation : RH.Hom (S.ring (D g)) (Loc g) =
   S.component (D g) g gg ;
  evaluation-map (s : S.Section (D g)) : Id (Loc g).R (map evaluation s) (eval s) = S.component-map (D g) g gg s ;
  iso : Pr.isEquiv (S.ring (D g)).R (Loc g).R (map evaluation) =
   Pr.qinv (S.ring (D g)).R (Loc g).R (map evaluation) extend
    (\ x -> trans (evaluation-map (extend x)) (eval-extend x))
    (\ s -> trans (ap extend (evaluation-map s)) (extend-eval s)) ;
 } ;

 -- naturality of evaluation: for D h <= D g, eval_h(s|D h) = rho_{g,h}(eval_g s).
 -- Both sides are the component of s at h (restrict-at, compat), with
 -- different witnesses of D h <= D g (component-irr).
 natural (g h : R) (le : O.Le (D h) (D g)) (s : S.Section (D g)) :
  Id (Loc h).R (At[h].eval (S.restrict (D h) (D g) le s)) (map (S.rho g h le) (At[g].eval s)) =
  calc (Loc h).R {
   At[h].eval (S.restrict (D h) (D g) le s)
    =< S.restrict-at (D h) (D g) le s h At[h].gg > S.at s h (O.le-trans (D h) (D h) (D g) At[h].gg le)
    =< S.component-irr (D g) s h (O.le-trans (D h) (D h) (D g) At[h].gg le) (O.le-trans (D h) (D g) (D g) le At[g].gg)
     > S.at s h (O.le-trans (D h) (D g) (D g) le At[g].gg)
    =< sym (S.compat s g h At[g].gg le) > map (S.rho g h le) (At[g].eval s) } ;
} ;
