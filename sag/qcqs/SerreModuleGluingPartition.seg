-- The partition-of-one step in degree-zero gluing (Serre note §3).
-- Given numerators t_i satisfying t_i|f_j=f_i^r s_j for every i,j,
-- choose coefficients lambda_i with sum f_i^r lambda_i=1 and take
-- t=sum lambda_i t_i. Restriction is linear and preserves finite sums,
-- so t|f_j=(sum f_i^r lambda_i)s_j=s_j. Uniqueness of the amalgam
-- allows elimination of the mere coefficients into the actual amalgam.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module Data = SerreModuleGluingData[l].Over[A,setA,Md] ;
 module P = AffinePowers[l].Over[A] ;
 module MS = SerreModuleSums[l].Over[A,Md] ;
 module Cover (n : Nat) (fs : Fin n -> A.R)
  (covers : Data.O.Le Data.Z.lattice.top (Data.Z.J.bigJ n (\ i -> Data.Z.D (fs i)))) {
  module C = Data.Cover[n,fs,covers] ;
  module Powers = SerreUnitIdealPowers[l].Over[A].Family[n,fs,covers] ;
  module Exact (xs : C.Families) (r : Nat) (ts : Fin n -> Md.M)
   (exact : (i j : Fin n) -> Id C.Index[j].P.L.Carrier
    (C.Index[j].P.L.fraction (ts i) zero) (C.Index[j].P.Native.localised.sm (P.power (fs i) r) (xs j))) {
   module Partition (coeffs : Radical[l].Over[A].InIdeal (n,Powers.powers r) A.o) {
    coefficient (i : Fin n) : A.R = coeffs.1 i ;
    weights (i : Fin n) : A.R = A.mul (Powers.powers r i) (coefficient i) ;
    one : Id A.R (FiniteIdeal[l].Sums[A].sum n weights) A.o = coeffs.2 ;
    section : Md.M = MS.sum n (\ i -> Md.sm (coefficient i) (ts i)) ;
    module Index (j : Fin n) {
     module N = C.Index[j].P.Native ; module H = C.Index[j].P.H ;
     module Sums = SerreModuleSums[l].Over[A,N.localised] ;
     module MapSums = SerreModuleSums[l].Map[A,A,RingHom[l].identity A,Md,N.localised,N.canonical] ;
     term (i : Fin n) :
      Id N.L.Carrier (H.map N.canonical (Md.sm (coefficient i) (ts i))) (N.localised.sm (weights i) (xs j)) =
      trans (H.map-scale N.canonical (coefficient i) (ts i))
       (trans (ap (N.localised.sm (coefficient i)) (trans (N.canonical-at (ts i)) (exact i j)))
        (trans (N.localised.smA (coefficient i) (P.power (fs i) r) (xs j))
         (ap (\ a -> N.localised.sm a (xs j))
          (trans (A.mulC (coefficient i) (P.power (fs i) r))
           (ap (\ a -> A.mul a (coefficient i)) (sym (Powers.powers-at r i))))))) ;
     matches : Id N.L.Carrier (N.L.fraction section zero) (xs j) =
      trans (sym (N.canonical-at section))
       (trans (MapSums.sum-map n (\ i -> Md.sm (coefficient i) (ts i)))
        (trans (Sums.sum-cong n (\ i -> H.map N.canonical (Md.sm (coefficient i) (ts i)))
         (\ i -> N.localised.sm (weights i) (xs j)) term)
         (Sums.partition n weights one (xs j)))) ;
    } ;
    amalgam : C.Amalgam xs = (section,\ j -> Index[j].matches) ;
   } ;
   amalgam : C.Amalgam xs =
    Tr.Trunc[Radical[l].Over[A].InIdeal (n,Powers.powers r) A.o].induction @l
     (\ w -> C.Amalgam xs) (\ w -> C.amalgam-prop xs)
     (\ c -> Partition[c].amalgam) (Powers.coefficients r) ;
  } ;
 } ;
} ;
