-- A finite family covers exactly when it merely generates the unit ideal.
level l ; open Ring[l] ; open Presentations[l] ;
module Tr = Truncation[l] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module ZF = ZariskiFunctor[l] ;
module Over (A : T.Test) {
 module Z = T.At[A].Z ;
 module R = Radical[l].Over[A.ring] ;
 module Fam = FamilyLattice[l].Over[A.ring] ;
 module S = FiniteIdeal[l].Sums[A.ring] ;
 power-one : (n : Nat) -> Id A.ring.R (R.power A.ring.o n) A.ring.o = split {
  zero -> refl A.ring.o ;
  suc n | ih -> trans (ap (A.ring.mul A.ring.o) ih) (A.ring.mulO A.ring.o) } ;
 module At (n : Nat) (xs : Fin n -> A.ring.R) {
  cover : Z.lattice.L = Z.J.bigJ n (\ i -> Z.D (xs i)) ;
  Witness : U l = R.InIdeal (n,xs) A.ring.o ;
  UnitIdeal : U l = Tr.Trunc[Witness].carrier ;
  from-top (e : Id Z.lattice.L cover Z.lattice.top) : UnitIdeal =
   Tr.Trunc[R.RadData (n,xs) A.ring.o].induction @l (\ t -> UnitIdeal)
    (\ t -> Tr.Trunc[Witness].proposition)
    (\ t -> Tr.Trunc[Witness].inc (t.2.1,trans t.2.2 (power-one t.1)))
    (Z.reflect Fam.unitF (n,xs) (Z.O.le-of-eq _ _ (sym (trans (Z.generated-at n xs) e))) (inr tt)) ;
  to-top (e : UnitIdeal) : Id Z.lattice.L cover Z.lattice.top =
   Tr.Trunc[Witness].induction @l (\ t -> Id Z.lattice.L cover Z.lattice.top) (\ t -> Z.lattice.setL _ _)
    (\ t -> Z.O.le-antisym cover Z.lattice.top (Z.O.le-top cover)
     (Z.O.le-trans _ (Z.cls (n,xs)) _
      (Z.order Fam.unitF (n,xs) (\ i -> Fam.inc (n,xs) A.ring.o (zero,t)))
      (Z.O.le-of-eq _ _ (Z.generated-at n xs)))) e ;
 } ;
} ;
module Change (A B : T.Test) (h : RH.Hom A.ring B.ring) {
 module M = ZF.OnMap[A,B,h] ;
 module JA = DL.JoinMaps[M.ZA.lattice,M.ZB.lattice,M.lattice-map] ;
 module FE = Axioms[l].FunExtLemmas[fe @l] ;
 map-cover (n : Nat) (xs : Fin n -> A.ring.R) : Id M.ZB.lattice.L
  (ZF.functor.reindex A B h Over[A].At[n,xs].cover) Over[B].At[n,\ i -> map h (xs i)].cover =
  trans (JA.preserves n (\ i -> M.ZA.D (xs i)))
   (ap (M.ZB.J.bigJ n) (FE.funext (Fin n) (\ i -> M.ZB.lattice.L)
    (\ i -> DL.hmap M.lattice-map (M.ZA.D (xs i))) (\ i -> M.ZB.D (map h (xs i))) (\ i -> M.on-D (xs i)))) ;
} ;
