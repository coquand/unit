-- The finite basic Zariski sheaf condition for arbitrary test functors.
-- A cover of B is a_i with join D(a_i)=top, including the empty cover.
-- Its objects are B[1/a_i], with overlap B[1/(a_i a_j)]; the maps rho from
-- the localisation interface commute with the base maps (rho-on).
-- Compatible values agree along these two overlap maps.  An amalgam is a
-- value in F(B) with the given images.  Its type is a set; the matching
-- conditions are propositions.  The restrictions of one value are
-- compatible by the two functor composition laws and rho-on.
-- IsSheaf asks for contractible amalgams on every such cover.  It is a
-- proposition: contractibility of a set is a proposition (Sigma equality,
-- centre equality supplied by either contraction); then use funext.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Hi = Prelude[l+] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module BigFE = Axioms[l+].FunExtLemmas[fe @l+] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module DL = DistLattice[l] ;
module Diagram (B : T.Test) (n : Nat) (as : Fin n -> B.ring.R)
 (covers : Id ZariskiLattice[l].Over[B.ring].lattice.L
   (DistLattice[l].Joins[ZariskiLattice[l].Over[B.ring].lattice].bigJ n (\ i -> ZariskiLattice[l].Over[B.ring].D (as i)))
   ZariskiLattice[l].Over[B.ring].lattice.top) {
 module AB = T.At[B].A ;
 module Z = T.At[B].Z ;
 module S = Sections[l].Over[B.ring,AB.Loc,AB.set,AB.inclusion,AB.elementary] ;
 module G = Gluing[l].Over[B.ring,AB.Loc,AB.set,AB.inclusion,AB.elementary] ;
 basic (i : Fin n) : T.Test = T.localised B (as i) ;
 double (i j : Fin n) : T.Test = T.localised B (B.ring.mul (as i) (as j)) ;
 left (i j : Fin n) : RH.Hom (basic i).ring (double i j).ring = S.rho (as i) (B.ring.mul (as i) (as j)) (G.le-left (as i) (as j)) ;
 right (i j : Fin n) : RH.Hom (basic j).ring (double i j).ring = S.rho (as j) (B.ring.mul (as i) (as j)) (G.le-right (as i) (as j)) ;
 left-base (i j : Fin n) : Id (RH.Hom B.ring (double i j).ring)
  (RH.compose B.ring (basic i).ring (double i j).ring (left i j) (AB.inclusion (as i))) (AB.inclusion (B.ring.mul (as i) (as j))) =
  RH.Properties[B.ring,(double i j).ring,(double i j).carrier-set].ext
   (RH.compose B.ring (basic i).ring (double i j).ring (left i j) (AB.inclusion (as i))) (AB.inclusion (B.ring.mul (as i) (as j)))
   (S.rho-on (as i) (B.ring.mul (as i) (as j)) (G.le-left (as i) (as j))) ;
 right-base (i j : Fin n) : Id (RH.Hom B.ring (double i j).ring)
  (RH.compose B.ring (basic j).ring (double i j).ring (right i j) (AB.inclusion (as j))) (AB.inclusion (B.ring.mul (as i) (as j))) =
  RH.Properties[B.ring,(double i j).ring,(double i j).carrier-set].ext
   (RH.compose B.ring (basic j).ring (double i j).ring (right i j) (AB.inclusion (as j))) (AB.inclusion (B.ring.mul (as i) (as j)))
   (S.rho-on (as j) (B.ring.mul (as i) (as j)) (G.le-right (as i) (as j))) ;
 module For (F : SF.SetFunctor) {
  Values : U l = (i : Fin n) -> F.obj (basic i) ;
  Compatible (xs : Values) : U l = (i j : Fin n) -> Id (F.obj (double i j))
   (F.reindex (basic i) (double i j) (left i j) (xs i)) (F.reindex (basic j) (double i j) (right i j) (xs j)) ;
  Matches (xs : Values) (x : F.obj B) : U l = (i : Fin n) -> Id (F.obj (basic i)) (F.reindex B (basic i) (AB.inclusion (as i)) x) (xs i) ;
  matches-prop (xs : Values) (x : F.obj B) : Pr.isProp (Matches xs x) =
   FE.isProp-Pi (Fin n) (\ i -> Id (F.obj (basic i)) (F.reindex B (basic i) (AB.inclusion (as i)) x) (xs i))
    (\ i -> F.set (basic i) (F.reindex B (basic i) (AB.inclusion (as i)) x) (xs i)) ;
  Amalgam (xs : Values) : U l = (x : F.obj B) * Matches xs x ;
  amalgam-set (xs : Values) : Pr.isSet (Amalgam xs) =
   Pr.isSet-Sigma (F.obj B) (Matches xs) (F.set B) (\ x -> Pr.prop-to-set (Matches xs x) (matches-prop xs x)) ;
  restrictions (x : F.obj B) : Values = \ i -> F.reindex B (basic i) (AB.inclusion (as i)) x ;
  compatible (x : F.obj B) : Compatible (restrictions x) = \ i j ->
   trans (sym (F.composition B (basic i) (double i j) (AB.inclusion (as i)) (left i j) x))
    (trans (ap (\ h -> F.reindex B (double i j) h x) (left-base i j))
     (trans (ap (\ h -> F.reindex B (double i j) h x) (sym (right-base i j)))
      (F.composition B (basic j) (double i j) (AB.inclusion (as j)) (right i j) x))) ;
 } ;
} ;
CoverData : U l+ = (B : T.Test) * (n : Nat) * (as : Fin n -> B.ring.R) *
 Id ZariskiLattice[l].Over[B.ring].lattice.L
  (DL.Joins[ZariskiLattice[l].Over[B.ring].lattice].bigJ n (\ i -> ZariskiLattice[l].Over[B.ring].D (as i))) ZariskiLattice[l].Over[B.ring].lattice.top ;
base (c : CoverData) : T.Test = c.1 ;
count (c : CoverData) : Nat = c.2.1 ;
generators (c : CoverData) : Fin (count c) -> (base c).ring.R = c.2.2.1 ;
covers (c : CoverData) : Id ZariskiLattice[l].Over[(base c).ring].lattice.L
 (DL.Joins[ZariskiLattice[l].Over[(base c).ring].lattice].bigJ (count c) (\ i -> ZariskiLattice[l].Over[(base c).ring].D (generators c i)))
 ZariskiLattice[l].Over[(base c).ring].lattice.top = c.2.2.2 ;
module OnCover (F : SF.SetFunctor) (c : CoverData) {
 module D = Diagram[base c,count c,generators c,covers c] ;
 module C = D.For[F] ;
} ;
IsSheaf (F : SF.SetFunctor) : U l+ = (c : CoverData) (xs : OnCover[F,c].C.Values) -> OnCover[F,c].C.Compatible xs ->
 Localisation[l].isContr (OnCover[F,c].C.Amalgam xs) ;
contr-prop (A : U l) (setA : Pr.isSet A) : Pr.isProp (Localisation[l].isContr A) = \ p q ->
 Pr.Sigma-eq A (\ x -> (y : A) -> Id A x y) p.1 q.1 p.2 q.2 (p.2 q.1)
  (FE.isProp-Pi A (\ y -> Id A q.1 y) (setA q.1)) ;
is-sheaf-prop (F : SF.SetFunctor) : Hi.isProp (IsSheaf F) =
 BigFE.isProp-Pi CoverData (\ c -> (xs : OnCover[F,c].C.Values) -> OnCover[F,c].C.Compatible xs -> Localisation[l].isContr (OnCover[F,c].C.Amalgam xs)) (\ c ->
 BigFE.isProp-Pi OnCover[F,c].C.Values (\ xs -> OnCover[F,c].C.Compatible xs -> Localisation[l].isContr (OnCover[F,c].C.Amalgam xs)) (\ xs ->
 BigFE.isProp-Pi (OnCover[F,c].C.Compatible xs) (\ k -> Localisation[l].isContr (OnCover[F,c].C.Amalgam xs))
  (\ k -> contr-prop (OnCover[F,c].C.Amalgam xs) (OnCover[F,c].C.amalgam-set xs)))) ;
-- Separation follows from uniqueness of amalgams of the restrictions.
module SheafProperties (F : SF.SetFunctor) (sheaf : IsSheaf F) {
 module On (c : CoverData) {
  module C = OnCover[F,c].C ;
  separated (x y : F.obj (base c)) (eq : (i : Fin (count c)) ->
   Id (F.obj (OnCover[F,c].D.basic i)) (C.restrictions x i) (C.restrictions y i)) : Id (F.obj (base c)) x y =
   ap (\ z -> z.1) (trans (sym ((sheaf c (C.restrictions x) (C.compatible x)).2 (x,\ i -> refl (C.restrictions x i))))
    ((sheaf c (C.restrictions x) (C.compatible x)).2 (y,\ i -> sym (eq i)))) ;
 } ;
} ;
