-- Ring localisation on a principal affine cover (Serre note, Lemma 9.1).
-- Principal opens of affines are affine. On an affine w, the open D_w(t)
-- is the image of the basic open D(t) under the chart (AffineBasis), an
-- affine open of X|w; the nested slice is X|D_w(t) (SliceNested), so
-- it is affine in X (AffineTransport).
-- Lemma. Let f_i in A = O(1) with the D(f_i) covering and each D(f_i)
-- affine. Then for each k the canonical ring map A_(f_k) -> O(D(f_k)) is
-- an isomorphism.
-- Proof. Apply pure descent (SerreLocalisationDescent) to M = O and
--  g = f_k. Each member D(f_i) is affine; each overlap
--  D(f_i) /\ D(f_j) = D_(D f_i)(f_j|) is a principal open of an affine,
--  hence affine. On an affine the chart ring fact (SerreLambdaChart) is
--  the required lambda equivalence. So lambda_(1,f_k) : A_(f_k) -> O(D f_k)
--  is bijective (native module fractions). Restriction A -> O(D f_k)
--  inverts the powers of f_k, so it has a unique ring extension h from the
--  ring of fractions (Localisation.FromElementary). After the bijective
--  comparison of native fractions with that ring (Bridge), h clears
--  f_k^p (x/f_k^p) to the restriction of x, as lambda does; so they agree
--  (SerreLambdaElementary.Agree), and h is bijective.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module DL = DistLattice[l] ;
module RH = RingHom[l] ; module RM = RingMaps[l] ;
module SM = SerreModule[l] ;
module Principal (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (w : L.L)
 (affine : Qcqs[l].Over[L,X].AffineOpen w) (t : (X.sheaf.ring w).R) {
 module S = Slice[l].Over[L,X,w] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module B = AffineBasis[l].Over[S.lattice,S.restricted].FromAffine[affine] ;
 chart-open : S.Opens = DL.hmap B.AX.canonical.lat (B.AX.ZG.D t) ;
 chart-affine : Qcqs[l].Over[S.lattice,S.restricted].AffineOpen chart-open = B.Basic[t].affine ;
 module N = SliceNested[l].Over[L,X,w,chart-open] ;
 inc-affine : Qcqs[l].Over[L,X].AffineOpen (S.inc chart-open) =
  AffineTransport[l].Over[N.Nested.lattice,N.Single.lattice,N.Nested.restricted,N.Single.restricted,N.morphism,N.iso,chart-affine].affine ;
 -- the chart's image of D(t) is D_w(t)
 module CanonicalMap = B.AX.Can.Of[RH.identity (X.sheaf.ring w)].SM ;
 same-open : Id L.L (S.inc chart-open) (LX.d w t) = ap S.inc (CanonicalMap.pi-D t) ;
 affine-open : Qcqs[l].Over[L,X].AffineOpen (LX.d w t) =
  Pr.subst L.L (\ v -> Qcqs[l].Over[L,X].AffineOpen v) (S.inc chart-open) (LX.d w t) same-open inc-affine ;
} ;
module Over (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (n : Nat)
 (fs : Fin n -> (X.sheaf.ring L.top).R)
 (covers : DL.Order[L].Le L.top (DL.Joins[L].bigJ n (\ i -> LocallyRinged[l].On[L].Laws[X.sheaf,X.inv].d L.top (fs i))))
 (affine : (i : Fin n) -> Qcqs[l].Over[L,X].AffineOpen (LocallyRinged[l].On[L].Laws[X.sheaf,X.inv].d L.top (fs i)))
 (k : Fin n) {
 module O = DL.Order[L] ;
 module GO = RingedLattice[l].On[L].Of[X.sheaf] ;
 module LX = LocallyRinged[l].On[L].Laws[X.sheaf,X.inv] ;
 module IX = InvOpen[l].On[L].Of[X.sheaf] ;
 module ST = SerreModuleSheafStructure[l].On[L,X.sheaf,X.is-sheaf] ;
 A : CRing = X.sheaf.ring L.top ;
 us (i : Fin n) : L.L = LX.d L.top (fs i) ;
 restricted (a : L.L) (f : A.R) : (X.sheaf.ring a).R = RM.map (X.sheaf.res a L.top (O.le-top a)) f ;
 -- D(f_i) /\ D(f_j) is the principal open of f_j in D(f_i)
 overlap-eq (i j : Fin n) : Id L.L (LX.d (us i) (restricted (us i) (fs j))) (L.meet (us i) (us j)) =
  IX.Restrict[L.top,us i,O.le-top (us i),fs j,us j,LX.d-open L.top (fs j)].restrict-eq
   (LX.d (us i) (restricted (us i) (fs j))) (LX.d-open (us i) (restricted (us i) (fs j))) ;
 overlap-affine (i j : Fin n) : Qcqs[l].Over[L,X].AffineOpen (L.meet (us i) (us j)) =
  Pr.subst L.L (\ v -> Qcqs[l].Over[L,X].AffineOpen v) (LX.d (us i) (restricted (us i) (fs j))) (L.meet (us i) (us j))
   (overlap-eq i j) Principal[L,X,us i,affine i,restricted (us i) (fs j)].affine-open ;
 members (i : Fin n) : SerreLambda[l].On[L,X,ST.structure,us i].At[restricted (us i) (fs k)].IsEquivalence =
  SerreLambdaChart[l].On[L,X,us i,affine i].At[restricted (us i) (fs k)].equivalence ;
 overlaps (i j : Fin n) : SerreLambda[l].On[L,X,ST.structure,L.meet (us i) (us j)].At[restricted (L.meet (us i) (us j)) (fs k)].IsEquivalence =
  SerreLambdaChart[l].On[L,X,L.meet (us i) (us j),overlap-affine i j].At[restricted (L.meet (us i) (us j)) (fs k)].equivalence ;
 module Descent = SerreLocalisationDescent[l].Over[L,X,ST.structure,n,us,covers,fs k,members,overlaps] ;
 module C = Descent.C ;
 -- lambda_(1,f_k) for O is bijective
 lambda-equivalence : Pr.isEquiv C.E.S.Carrier (X.sheaf.ring C.open-f).R C.map = Descent.equivalence ;
 -- the ring of fractions and its extension of restriction
 module AF = Affine[l].Over[A] ;
 module LH = Bridge[l].Over[A,fs k].LocH ;
 module TU = AffinePowers[l].Over[X.sheaf.ring C.open-f].Units[X.sheaf.ring-set C.open-f] ;
 inverts : LH.Inverts (X.sheaf.ring C.open-f) C.ring-map = \ s q ->
  Pr.subst (X.sheaf.ring C.open-f).R (\ e -> RL[X.sheaf.ring C.open-f].unit e)
   (AffinePowers[l].Over[X.sheaf.ring C.open-f].power (RM.map C.ring-map (fs k)) q.1) (RM.map C.ring-map s)
   (trans (sym (AffinePowers[l].power-map A (X.sheaf.ring C.open-f) C.ring-map (fs k) q.1)) (ap (RM.map C.ring-map) q.2))
   (TU.power-unit (RM.map C.ring-map (fs k)) C.unit q.1) ;
 module FE = LH.FromElementary[AF.Loc (fs k),AF.inclusion (fs k),AF.elementary (fs k),
  X.sheaf.ring C.open-f,X.sheaf.ring-set C.open-f,C.ring-map,inverts] ;
 ring-map : RH.Hom (AF.Loc (fs k)) (X.sheaf.ring C.open-f) = FE.h ;
 ring-map-on (a : A.R) : Id (X.sheaf.ring C.open-f).R (RM.map ring-map (RM.map (AF.inclusion (fs k)) a))
  (GO.restrict C.open-f L.top C.below a) = FE.on-image a ;
 -- after the native comparison, the ring map clears fractions as lambda does
 module Br = SerreModuleRingLocalisationBridge[l].Over[A,X.sheaf.ring-set L.top,fs k,
  AF.Loc (fs k),AF.set (fs k),AF.inclusion (fs k),AF.elementary (fs k)] ;
 module T = SerreModuleLocalisation[l].At[A,C.Scalars.restricted,fs k] ;
 module AP = AffinePowers[l].Over[A] ;
 composite (z : C.E.S.Carrier) : (X.sheaf.ring C.open-f).R = RM.map ring-map (Br.forward z) ;
 composite-clears (x : A.R) (p : Nat) :
  Id (X.sheaf.ring C.open-f).R (T.power p (composite (C.E.S.fraction x p))) (GO.restrict C.open-f L.top C.below x) =
  calc (X.sheaf.ring C.open-f).R {
   T.power p (composite (C.E.S.fraction x p))
    =< T.power-scalar p (composite (C.E.S.fraction x p))
     > (X.sheaf.ring C.open-f).mul (RM.map C.ring-map (AP.power (fs k) p)) (composite (C.E.S.fraction x p))
    =< ap (\ c -> (X.sheaf.ring C.open-f).mul c (composite (C.E.S.fraction x p))) (sym (ring-map-on (AP.power (fs k) p)))
     > (X.sheaf.ring C.open-f).mul (RM.map ring-map (RM.map (AF.inclusion (fs k)) (AP.power (fs k) p))) (composite (C.E.S.fraction x p))
    =< sym (RM.map-mul ring-map (RM.map (AF.inclusion (fs k)) (AP.power (fs k) p)) (Br.forward (C.E.S.fraction x p)))
     > RM.map ring-map ((AF.Loc (fs k)).mul (RM.map (AF.inclusion (fs k)) (AP.power (fs k) p)) (Br.forward (C.E.S.fraction x p)))
    =< ap (RM.map ring-map) (sym (Br.target-power p (Br.forward (C.E.S.fraction x p))))
     > RM.map ring-map (Br.T.power p (Br.forward (C.E.S.fraction x p)))
    =< ap (RM.map ring-map) (Br.forward-clears x p) > RM.map ring-map (RM.map (AF.inclusion (fs k)) x)
    =< ring-map-on x > GO.restrict C.open-f L.top C.below x } ;
 restrict-ring (x : A.R) :
  Id (X.sheaf.ring C.open-f).R (Descent.MO.restrict C.open-f L.top C.below x) (GO.restrict C.open-f L.top C.below x) =
  refl (GO.restrict C.open-f L.top C.below x) ;
 module Same = SerreLambdaElementary[l].Agree[A,ST.structure.presheaf.module-at L.top,C.Scalars.restricted,fs k,C.invertible,
  \ x -> GO.restrict C.open-f L.top C.below x,composite,C.map,composite-clears,
  \ x p -> trans (C.clears x p) (restrict-ring x)] ;
 composite-equivalence : Pr.isEquiv C.E.S.Carrier (X.sheaf.ring C.open-f).R composite =
  Iso[l].equiv-homotopy C.E.S.Carrier (X.sheaf.ring C.open-f).R C.map composite (\ z -> sym (Same.same z)) lambda-equivalence ;
 -- h = (h . forward) . forward^-1
 iso : Pr.isEquiv (AF.Loc (fs k)).R (X.sheaf.ring C.open-f).R (RM.map ring-map) =
  Iso[l].equiv-homotopy (AF.Loc (fs k)).R (X.sheaf.ring C.open-f).R (\ y -> composite (Br.backward y)) (RM.map ring-map)
   (\ y -> ap (RM.map ring-map) (Br.forward-backward y))
   (Iso[l].equiv-compose (AF.Loc (fs k)).R C.E.S.Carrier (X.sheaf.ring C.open-f).R composite Br.backward composite-equivalence
    (Pr.qinv (AF.Loc (fs k)).R C.E.S.Carrier Br.backward Br.forward Br.backward-forward Br.forward-backward)) ;
} ;
