-- The actual degree-zero principal-localisation diagram (Serre note §3).
-- Sections live in the checked localised modules, and overlaps use the
-- actual restriction maps. Compatibility, matches, and amalgams have
-- their usual meanings. An amalgam is unique by module separation.
-- Fraction representatives and finite power raising give the first
-- common denominator for any finite family of local sections.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ;
module CF = SerreModuleClearFinite[l] ; module CE = SerreModuleClearErrors[l] ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md : SM.Over[A].Module) {
 module R = SerreModuleBasicRestrictions[l].Over[A,setA,Md] ;
 module Z = R.Z ; module O = Z.O ;
 module Support = Z.Sup.Of[Z.D,Z.support] ;
 module ML = SM.Over[A].Laws[Md] ;
 module Local (g : A.R) {
  module Native = R.Local[g].Native ; module L = Native.L ;
  module Laws = SM.Over[A].Laws[Native.localised] ;
  module H = MM.Between[A,A,RingHom[l].identity A,Md,Native.localised] ;
  module Sub = CE.Over[A].Along[Md,Native.localised,Native.canonical] ;
 } ;
 left (g h : A.R) : O.Le (Z.D (A.mul g h)) (Z.D g) =
  O.le-trans (Z.D (A.mul g h)) (Z.lattice.meet (Z.D g) (Z.D h)) (Z.D g)
   (O.le-of-eq (Z.D (A.mul g h)) (Z.lattice.meet (Z.D g) (Z.D h)) (Support.at-mul g h)) (O.meet-left (Z.D g) (Z.D h)) ;
 right (g h : A.R) : O.Le (Z.D (A.mul g h)) (Z.D h) =
  O.le-trans (Z.D (A.mul g h)) (Z.lattice.meet (Z.D g) (Z.D h)) (Z.D h)
   (O.le-of-eq (Z.D (A.mul g h)) (Z.lattice.meet (Z.D g) (Z.D h)) (Support.at-mul g h)) (O.meet-right (Z.D g) (Z.D h)) ;
 module Cover (n : Nat) (fs : Fin n -> A.R)
  (covers : O.Le Z.lattice.top (Z.J.bigJ n (\ i -> Z.D (fs i)))) {
  module Index (i : Fin n) { module P = Local[fs i] ; } ;
  module Pair (i j : Fin n) {
   overlap : A.R = A.mul (fs i) (fs j) ;
   module L = R.At[fs i,overlap,left (fs i) (fs j)] ;
   module Rho = R.At[fs j,overlap,right (fs i) (fs j)] ;
   module P = Local[overlap] ;
  } ;
  Families : U l = (i : Fin n) -> Index[i].P.L.Carrier ;
  Compatible (xs : Families) : U l = (i j : Fin n) ->
   Id Pair[i,j].P.L.Carrier (Pair[i,j].L.map (xs i)) (Pair[i,j].Rho.map (xs j)) ;
  Matches (xs : Families) (x : Md.M) : U l = (i : Fin n) -> Id Index[i].P.L.Carrier (Index[i].P.L.fraction x zero) (xs i) ;
  Amalgam (xs : Families) : U l = (x : Md.M) * Matches xs x ;
  matches-prop (xs : Families) (x : Md.M) : Pr.isProp (Matches xs x) =
   FE.isProp-Pi (Fin n) (\ i -> Id Index[i].P.L.Carrier (Index[i].P.L.fraction x zero) (xs i))
    (\ i -> Index[i].P.L.carrier-set _ _) ;
  module Separate (x y : Md.M) (same : (i : Fin n) -> Id Index[i].P.L.Carrier (Index[i].P.L.fraction x zero) (Index[i].P.L.fraction y zero)) {
   vanishes (i : Fin n) : Id Index[i].P.L.Carrier (Index[i].P.L.fraction (ML.sub x y) zero) (Index[i].P.L.fraction Md.mz zero) =
    trans (sym (Index[i].P.Native.canonical-at (ML.sub x y)))
     (trans (Index[i].P.Sub.map-sub x y)
      (trans (ap (\ a -> Index[i].P.Laws.sub a (Index[i].P.H.map Index[i].P.Native.canonical y))
       (trans (Index[i].P.Native.canonical-at x) (trans (same i) (sym (Index[i].P.Native.canonical-at y)))))
       (Index[i].P.Laws.sub-self (Index[i].P.H.map Index[i].P.Native.canonical y)))) ;
   equal : Id Md.M x y = ML.sub-zero x y
    (SerreModuleSeparation[l].Over[A,Md].Cover[n,fs,covers].separated (ML.sub x y) vanishes) ;
  } ;
  amalgam-prop (xs : Families) : Pr.isProp (Amalgam xs) = \ a b ->
   Pr.Sigma-eq Md.M (Matches xs) a.1 b.1 a.2 b.2
    (Separate[a.1,b.1,\ i -> trans (a.2 i) (sym (b.2 i))].equal) (matches-prop xs b.1) ;
  module Clear (xs : Families) {
   module Family = CF.Over[A].Family[n,\ i -> Md,\ i -> Index[i].P.Native.localised,
    \ i -> Index[i].P.Native.canonical,fs,xs] ;
   initial : Tr.Trunc[Family.Common].carrier = Family.common
    (\ i -> SerreModuleClearFractions[l].At[A,Md,fs i].clearing (xs i)) ;
  } ;
 } ;
} ;
