-- The category Mod(A) of small A-modules is abelian (CategoryAbelian,
-- Elinder §4.3-4.4), for the copy Modules of SerreQCohEquivalence (the
-- full subcategory on the trivial property: objects (M, tt)).
--
-- Zero object: the module on Top; the arrow from it is the zero map (an
-- arrow f out of it has f(tt) = f(0) = 0), the arrow to it is unique.
-- The zero arrow x -> 0 -> y is then x |-> 0, by definition.
-- Kernel of f: the subtype f(x) = 0 (SerreModuleKernelAlgebra); g with
-- f g = 0 lifts (Lift), and the lift is unique since the inclusion is
-- monic (membership is a proposition).
-- Cokernel of f: the quotient by the image (SerreModuleCokernel); g with
-- g f = 0 kills d and descends (Factor), uniquely since the projection is
-- epic (quotient induction).
-- Products and coproducts: both the pair module (SerreModuleProducts);
-- pairing x |-> (f x, g x); injections x |-> (x, 0), y |-> (0, y);
-- copairing (x, y) |-> f x + g y, unique as (x, y) = (x, 0) + (0, y).
-- Monic m : s -> a is the kernel of the projection p : a -> coker m.
-- First m is injective: the kernel inclusion i of m has m i = 0 = m 0,
-- so i = 0, and x = i(x) = 0 for x in the kernel. If p g = 0, every g(t)
-- has a class zero, hence merely is m(b) (effectiveness of the quotient,
-- zero-image); since m is injective the preimage is unique, so it exists,
-- and t |-> preimage of g(t) is linear by injectivity; uniqueness of the
-- factorisation since m is monic.
-- Epic e : b -> s is the cokernel of its kernel inclusion i. First e is
-- merely surjective: the projection s -> coker e satisfies p e = 0 = 0 e,
-- so p = 0 and every class is zero, hence every y is merely e(x). If u i = 0,
-- u is constant on fibres of e (e x = e x' gives x - x' in the kernel).
-- The graph {v | merely some x with e x = y and u x = v} is then a
-- proposition, merely inhabited by surjectivity, hence inhabited: its
-- point is h(y), with h(e x) = u x; h is linear by eliminating the mere
-- preimages into the (propositional) equations; uniqueness since e is
-- epic. No choice is used.
level l ; open Base ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ; module Th = Truncation[l+] ;
module SM = SerreModule[l] ;
module CA = CategoryAbelian[l+] ;
module Over (A : CRing) (setA : Pr.isSet A.R) {
 module E = SerreQCohEquivalence[l].Over[A,setA] ;
 module Ab = CA.On[E.Modules.precategory] ;
 module MC = SerreModuleCategory[l].Over[A] ;
 module Bl = SerreBilinear[l].Over[A] ;
 module S = SM.Over[A] ;
 -- the zero object
 zero-module : S.Module = new S.Module[Top,Pr.prop-to-set Top isTop,tt,\ x y -> tt,\ x -> tt,
  \ x y z -> isTop _ _,\ x y -> isTop _ _,\ x -> isTop _ _,\ x -> isTop _ _,\ a x -> tt,
  \ a b x -> isTop _ _,\ x -> isTop _ _,\ a x y -> isTop _ _,\ a b x -> isTop _ _] ;
 zero-object : E.Mod = (zero-module,tt) ;
 to-zero (M : S.Module) : MC.Hom M zero-module =
  new Bl.Linear[M,zero-module].H.Hom[\ x -> tt,\ x y -> refl tt,\ a x -> refl tt] ;
 initial : Ab.IsInitial zero-object = \ y -> (Bl.Hom[zero-module,y.1].zero-map,
  \ f -> Bl.Hom[zero-module,y.1].ext _ _ (\ t ->
   trans (sym (Bl.Linear[zero-module,y.1].H.map-zero f)) (ap f.fn (isTop tt t)))) ;
 terminal : Ab.IsTerminal zero-object = \ x -> (to-zero x.1,
  \ f -> Bl.Hom[x.1,zero-module].ext _ _ (\ m -> isTop _ _)) ;
 zero : Ab.Zero = (zero-object,initial,terminal) ;
 module Z = Ab.Zeros[zero] ;
 -- the zero arrow is the zero map, by definition
 zero-at (x y : E.Mod) (m : x.1.M) : Id y.1.M ((Z.zero x y).fn m) y.1.mz = refl y.1.mz ;
 killed-at (x y w : E.Mod) (f : MC.Hom x.1 y.1) (g : MC.Hom w.1 x.1)
  (e : Id (MC.Hom w.1 y.1) (MC.comp w.1 x.1 y.1 f g) (Z.zero w y)) (m : w.1.M) :
  Id y.1.M (f.fn (g.fn m)) y.1.mz =
  trans (ap (MC.evaluate w.1 y.1 m) e) (zero-at w y m) ;
 to-zero-eq (x y : E.Mod) (h : MC.Hom x.1 y.1) (p : (m : x.1.M) -> Id y.1.M (h.fn m) y.1.mz) :
  Id (MC.Hom x.1 y.1) h (Z.zero x y) =
  Bl.Hom[x.1,y.1].ext _ _ (\ m -> trans (p m) (sym (zero-at x y m))) ;
 -- kernels
 module Ker (x y : E.Mod) (f : MC.Hom x.1 y.1) {
  module KA = SerreModuleKernelAlgebra[l].Over[A,x.1,y.1,f] ;
  object : E.Mod = (KA.kernel,tt) ;
  killed : Id (MC.Hom KA.kernel y.1) (MC.comp KA.kernel x.1 y.1 f KA.inclusion) (Z.zero object y) =
   to-zero-eq object y (MC.comp KA.kernel x.1 y.1 f KA.inclusion)
    (\ m -> trans (ap f.fn (KA.inclusion-at m)) (KA.member m)) ;
  monic : Ab.Monic object x KA.inclusion = \ v g h e -> Bl.Hom[v.1,KA.kernel].ext g h (\ m ->
   KA.ext (g.fn m) (h.fn m) (trans (sym (KA.inclusion-at (g.fn m)))
    (trans (ap (MC.evaluate v.1 x.1 m) e) (KA.inclusion-at (h.fn m))))) ;
  module Lifting (w : E.Mod) (g : MC.Hom w.1 x.1) (e : Id (MC.Hom w.1 y.1) (MC.comp w.1 x.1 y.1 f g) (Z.zero w y)) {
   module Lift = KA.Lift[w.1,g,killed-at x y w f g e] ;
   center : Ab.Factors w object x KA.inclusion g =
    (Lift.lift,Bl.Hom[w.1,x.1].ext _ _ (\ m -> trans (KA.inclusion-at (Lift.lift.fn m)) (Lift.lift-at m))) ;
   contr : CA.isContr (Ab.Factors w object x KA.inclusion g) =
    Ab.factors-contr w object x KA.inclusion g center (Ab.monic-factors w object x KA.inclusion monic g center) ;
  } ;
  kernel : Z.Kernel x y f = (object,KA.inclusion,killed,\ w g e -> Lifting[w,g,e].contr) ;
 } ;
 kernels : Z.HasKernels = \ x y f -> Ker[x,y,f].kernel ;
 -- cokernels
 module Coker (x y : E.Mod) (f : MC.Hom x.1 y.1) {
  module CK = SerreModuleCokernel[l].Over[A,x.1,y.1,f] ;
  object : E.Mod = (CK.cokernel,tt) ;
  killed : Id (MC.Hom x.1 CK.cokernel) (MC.comp x.1 y.1 CK.cokernel CK.projection f) (Z.zero x object) =
   to-zero-eq x object (MC.comp x.1 y.1 CK.cokernel CK.projection f)
    (\ m -> trans (CK.projection-at (f.fn m)) (CK.killed m)) ;
  epic : Ab.Epic y object CK.projection = \ v g h e -> Bl.Hom[CK.cokernel,v.1].ext g h
   (CK.induction (\ t -> Id v.1.M (g.fn t) (h.fn t)) (\ t -> v.1.setM _ _) (\ m ->
    trans (ap g.fn (sym (CK.projection-at m)))
     (trans (ap (MC.evaluate y.1 v.1 m) e) (ap h.fn (CK.projection-at m))))) ;
  module Descent (w : E.Mod) (g : MC.Hom y.1 w.1) (e : Id (MC.Hom x.1 w.1) (MC.comp x.1 y.1 w.1 g f) (Z.zero x w)) {
   module Fa = CK.Factor[w.1,g,killed-at y w x g f e] ;
   center : Ab.Cofactors y object w CK.projection g =
    (Fa.factor,Bl.Hom[y.1,w.1].ext _ _ (\ m -> trans (ap Fa.factor.fn (CK.projection-at m)) (Fa.factor-at m))) ;
   contr : CA.isContr (Ab.Cofactors y object w CK.projection g) =
    Ab.cofactors-contr y object w CK.projection g center (Ab.epic-cofactors y object w CK.projection epic g center) ;
  } ;
  cokernel : Z.Cokernel x y f = (object,CK.projection,killed,\ w g e -> Descent[w,g,e].contr) ;
 } ;
 cokernels : Z.HasCokernels = \ x y f -> Coker[x,y,f].cokernel ;

 -- binary products and coproducts: the pair module
 module Pairs (x y : E.Mod) {
  module Pa = SerreModuleProducts[l].Pair[A,x.1,y.1] ;
  object : E.Mod = (Pa.product,tt) ;
  pairing (w : E.Mod) (f : MC.Hom w.1 x.1) (g : MC.Hom w.1 y.1) : MC.Hom w.1 Pa.product =
   new Bl.Linear[w.1,Pa.product].H.Hom[\ m -> (f.fn m,g.fn m),
    \ m n -> Pa.ext _ _ (f.additive m n) (g.additive m n),
    \ a m -> Pa.ext _ _ (f.scalar a m) (g.scalar a m)] ;
  product-universal : Ab.IsProduct x y object Pa.first Pa.second = \ w f g ->
   Ab.pairings-contr w object x y Pa.first Pa.second f g
    (pairing w f g,Bl.Hom[w.1,x.1].ext _ _ (\ m -> refl (f.fn m)),Bl.Hom[w.1,y.1].ext _ _ (\ m -> refl (g.fn m)))
    (\ v -> Bl.Hom[w.1,Pa.product].ext _ _ (\ m -> Pa.ext _ _
     (sym (ap (MC.evaluate w.1 x.1 m) v.2.1)) (sym (ap (MC.evaluate w.1 y.1 m) v.2.2)))) ;
  product : Ab.Product x y = (object,Pa.first,Pa.second,product-universal) ;
  first-in : MC.Hom x.1 Pa.product = new Bl.Linear[x.1,Pa.product].H.Hom[\ m -> (m,y.1.mz),
   \ m n -> Pa.ext _ _ (refl (x.1.madd m n)) (sym (y.1.maddZ y.1.mz)),
   \ a m -> Pa.ext _ _ (refl (x.1.sm a m)) (sym (S.Laws[y.1].sm-zero a))] ;
  second-in : MC.Hom y.1 Pa.product = new Bl.Linear[y.1,Pa.product].H.Hom[\ n -> (x.1.mz,n),
   \ m n -> Pa.ext _ _ (sym (x.1.maddZ x.1.mz)) (refl (y.1.madd m n)),
   \ a n -> Pa.ext _ _ (sym (S.Laws[x.1].sm-zero a)) (refl (y.1.sm a n))] ;
  -- (x, y) = (x, 0) + (0, y)
  decompose (p : Pa.Carrier) : Id Pa.Carrier (x.1.madd p.1 x.1.mz,y.1.madd y.1.mz p.2) p =
   Pa.ext _ _ (x.1.maddZ p.1) (S.Laws[y.1].zero-left p.2) ;
  module Copair (w : E.Mod) (f : MC.Hom x.1 w.1) (g : MC.Hom y.1 w.1) {
   copair : MC.Hom Pa.product w.1 = new Bl.Linear[Pa.product,w.1].H.Hom[\ p -> w.1.madd (f.fn p.1) (g.fn p.2),
    \ p q -> trans (cong2 w.1.M w.1.madd _ _ _ _ (f.additive p.1 q.1) (g.additive p.2 q.2))
     (S.Laws[w.1].swap-four (f.fn p.1) (f.fn q.1) (g.fn p.2) (g.fn q.2)),
    \ a p -> trans (cong2 w.1.M w.1.madd _ _ _ _ (f.scalar a p.1) (g.scalar a p.2))
     (sym (w.1.smD a (f.fn p.1) (g.fn p.2)))] ;
   on-first : Id (MC.Hom x.1 w.1) (MC.comp x.1 Pa.product w.1 copair first-in) f =
    Bl.Hom[x.1,w.1].ext _ _ (\ m -> trans (ap (w.1.madd (f.fn m)) (Bl.Linear[y.1,w.1].H.map-zero g)) (w.1.maddZ (f.fn m))) ;
   on-second : Id (MC.Hom y.1 w.1) (MC.comp y.1 Pa.product w.1 copair second-in) g =
    Bl.Hom[y.1,w.1].ext _ _ (\ n -> trans (ap (\ t -> w.1.madd t (g.fn n)) (Bl.Linear[x.1,w.1].H.map-zero f))
     (S.Laws[w.1].zero-left (g.fn n))) ;
   unique (v : Ab.Copairings x y object w first-in second-in f g) : Id (MC.Hom Pa.product w.1) copair v.1 =
    Bl.Hom[Pa.product,w.1].ext _ _ (\ p ->
     trans (cong2 w.1.M w.1.madd _ _ _ _ (sym (ap (MC.evaluate x.1 w.1 p.1) v.2.1)) (sym (ap (MC.evaluate y.1 w.1 p.2) v.2.2)))
      (trans (sym (v.1.additive (p.1,y.1.mz) (x.1.mz,p.2))) (ap v.1.fn (decompose p)))) ;
   contr : CA.isContr (Ab.Copairings x y object w first-in second-in f g) =
    Ab.copairings-contr x y object w first-in second-in f g (copair,on-first,on-second) unique ;
  } ;
  coproduct : Ab.Coproduct x y = (object,first-in,second-in,\ w f g -> Copair[w,f,g].contr) ;
 } ;
 products : Ab.HasProducts = \ x y -> Pairs[x,y].product ;
 coproducts : Ab.HasCoproducts = \ x y -> Pairs[x,y].coproduct ;
 -- a monic is the kernel of its cokernel projection
 module MonicKernel (s a : E.Mod) (m : MC.Hom s.1 a.1) (mono : Ab.Monic s a m) {
  module Km = Ker[s,a,m] ; module Cm = Coker[s,a,m] ;
  module Xm = SerreModuleMapExact[l].Over[A,s.1,a.1,m] ;
  -- m i = 0 = m 0 for the kernel inclusion i, so i = 0
  inclusion-zero : Id (MC.Hom Km.KA.kernel s.1) Km.KA.inclusion (Z.zero Km.object s) =
   mono Km.object Km.KA.inclusion (Z.zero Km.object s)
    (trans Km.killed (sym (to-zero-eq Km.object a (MC.comp Km.KA.kernel s.1 a.1 m (Z.zero Km.object s))
     (\ t -> Bl.Linear[s.1,a.1].H.map-zero m)))) ;
  kernel-zero : Xm.KernelZero = \ x h ->
   trans (sym (Km.KA.inclusion-at (x,h)))
    (trans (ap (MC.evaluate Km.KA.kernel s.1 (x,h)) inclusion-zero) (zero-at Km.object s (x,h))) ;
  Preimage (y : a.1.M) : U l = (b : s.1.M) * Id a.1.M y (m.fn b) ;
  preimage-prop (y : a.1.M) : Pr.isProp (Preimage y) = \ u v ->
   Pr.Sigma-eq s.1.M (\ b -> Id a.1.M y (m.fn b)) u.1 v.1 u.2 v.2
    (Xm.injective kernel-zero u.1 v.1 (trans (sym u.2) v.2)) (a.1.setM y (m.fn v.1)) ;
  module Through (w : E.Mod) (g : MC.Hom w.1 a.1)
   (e : Id (MC.Hom w.1 Cm.CK.cokernel) (MC.comp w.1 a.1 Cm.CK.cokernel Cm.CK.projection g) (Z.zero w Cm.object)) {
   class-zero (t : w.1.M) : Id Cm.CK.CQ.Class (Cm.CK.CQ.class (g.fn t)) Cm.CK.CQ.zero =
    trans (sym (Cm.CK.projection-at (g.fn t))) (killed-at a Cm.object w Cm.CK.projection g e t) ;
   preimage (t : w.1.M) : Preimage (g.fn t) =
    Tr.Trunc[Preimage (g.fn t)].induction @l (\ r -> Preimage (g.fn t)) (\ r -> preimage-prop (g.fn t)) (\ r -> r)
     (Cm.CK.CQ.zero-image (g.fn t) (class-zero t)) ;
   lift-fn (t : w.1.M) : s.1.M = (preimage t).1 ;
   lift-eq (t : w.1.M) : Id a.1.M (g.fn t) (m.fn (lift-fn t)) = (preimage t).2 ;
   lift : MC.Hom w.1 s.1 = new Bl.Linear[w.1,s.1].H.Hom[lift-fn,
    \ t t' -> Xm.injective kernel-zero _ _ (trans (sym (lift-eq (w.1.madd t t')))
     (trans (g.additive t t') (trans (cong2 a.1.M a.1.madd _ _ _ _ (lift-eq t) (lift-eq t'))
      (sym (m.additive (lift-fn t) (lift-fn t')))))),
    \ r t -> Xm.injective kernel-zero _ _ (trans (sym (lift-eq (w.1.sm r t)))
     (trans (g.scalar r t) (trans (ap (a.1.sm r) (lift-eq t)) (sym (m.scalar r (lift-fn t))))))] ;
   center : Ab.Factors w s a m g = (lift,Bl.Hom[w.1,a.1].ext _ _ (\ t -> sym (lift-eq t))) ;
   contr : CA.isContr (Ab.Factors w s a m g) =
    Ab.factors-contr w s a m g center (Ab.monic-factors w s a m mono g center) ;
  } ;
  kernel-of : Th.Trunc[(b : E.Mod) * (f : MC.Hom a.1 b.1) * Z.IsKernel a b f s m].carrier =
   Th.Trunc[(b : E.Mod) * (f : MC.Hom a.1 b.1) * Z.IsKernel a b f s m].inc
    (Cm.object,Cm.CK.projection,Cm.killed,\ w g e -> Through[w,g,e].contr) ;
 } ;
 monics : Z.MonicsAreKernels = \ s a m mono -> MonicKernel[s,a,m,mono].kernel-of ;
 -- an epic is the cokernel of its kernel inclusion
 module EpicCokernel (b s : E.Mod) (e : MC.Hom b.1 s.1) (epi : Ab.Epic b s e) {
  module Ke = Ker[b,s,e] ; module Ce = Coker[b,s,e] ;
  module Xe = SerreModuleMapExact[l].Over[A,b.1,s.1,e] ;
  -- p e = 0 = 0 e for the cokernel projection p, so p = 0
  projection-zero : Id (MC.Hom s.1 Ce.CK.cokernel) Ce.CK.projection (Z.zero s Ce.object) =
   epi Ce.object Ce.CK.projection (Z.zero s Ce.object)
    (trans Ce.killed (sym (to-zero-eq b Ce.object (MC.comp b.1 s.1 Ce.CK.cokernel (Z.zero s Ce.object) e)
     (\ x -> zero-at s Ce.object (e.fn x))))) ;
  Source (y : s.1.M) : U l = (x : b.1.M) * Id s.1.M y (e.fn x) ;
  surjective (y : s.1.M) : Tr.Trunc[Source y].carrier =
   Ce.CK.CQ.zero-image y (trans (sym (Ce.CK.projection-at y))
    (trans (ap (MC.evaluate s.1 Ce.CK.cokernel y) projection-zero) (zero-at s Ce.object y))) ;
  module Factorise (w : E.Mod) (u : MC.Hom b.1 w.1)
   (ku : Id (MC.Hom Ke.KA.kernel w.1) (MC.comp Ke.KA.kernel b.1 w.1 u Ke.KA.inclusion) (Z.zero Ke.object w)) {
   module Xu = SerreModuleMapExact[l].Over[A,b.1,w.1,u] ;
   kills (x : Ke.KA.Carrier) : Id w.1.M (u.fn (Ke.KA.value x)) w.1.mz =
    trans (ap u.fn (sym (Ke.KA.inclusion-at x))) (killed-at b w Ke.object u Ke.KA.inclusion ku x) ;
   difference (x x' : b.1.M) (q : Id s.1.M (e.fn x) (e.fn x')) : Ke.KA.Carrier =
    (S.Laws[b.1].sub x x',trans (Xe.map-sub x x')
     (trans (ap (\ z -> S.Laws[s.1].sub z (e.fn x')) q) (S.Laws[s.1].sub-self (e.fn x')))) ;
   -- u is constant on the fibres of e
   constant (x x' : b.1.M) (q : Id s.1.M (e.fn x) (e.fn x')) : Id w.1.M (u.fn x) (u.fn x') =
    S.Laws[w.1].sub-zero (u.fn x) (u.fn x') (trans (sym (Xu.map-sub x x')) (kills (difference x x' q))) ;
   Witness (y : s.1.M) (v : w.1.M) : U l = (x : b.1.M) * Id s.1.M y (e.fn x) * Id w.1.M (u.fn x) v ;
   Graph (y : s.1.M) : U l = (v : w.1.M) * Tr.Trunc[Witness y v].carrier ;
   same (y : s.1.M) (g1 g2 : Graph y) : Id w.1.M g1.1 g2.1 =
    Tr.Trunc[Witness y g1.1].induction @l (\ r -> Id w.1.M g1.1 g2.1) (\ r -> w.1.setM g1.1 g2.1)
     (\ t1 -> Tr.Trunc[Witness y g2.1].induction @l (\ r -> Id w.1.M g1.1 g2.1) (\ r -> w.1.setM g1.1 g2.1)
      (\ t2 -> trans (sym t1.2.2) (trans (constant t1.1 t2.1 (trans (sym t1.2.1) t2.2.1)) t2.2.2)) g2.2) g1.2 ;
   graph-prop (y : s.1.M) : Pr.isProp (Graph y) = \ g1 g2 ->
    Pr.Sigma-eq w.1.M (\ v -> Tr.Trunc[Witness y v].carrier) g1.1 g2.1 g1.2 g2.2 (same y g1 g2)
     (Tr.Trunc[Witness y g2.1].proposition) ;
   graph (y : s.1.M) : Graph y =
    Tr.Trunc[Source y].induction @l (\ r -> Graph y) (\ r -> graph-prop y)
     (\ t -> (u.fn t.1,Tr.Trunc[Witness y (u.fn t.1)].inc (t.1,t.2,refl (u.fn t.1)))) (surjective y) ;
   value (y : s.1.M) : w.1.M = (graph y).1 ;
   value-at (x : b.1.M) (y : s.1.M) (q : Id s.1.M y (e.fn x)) : Id w.1.M (value y) (u.fn x) =
    ap (\ g -> g.1) (graph-prop y (graph y) (u.fn x,Tr.Trunc[Witness y (u.fn x)].inc (x,q,refl (u.fn x)))) ;
   additive (y y' : s.1.M) : Id w.1.M (value (s.1.madd y y')) (w.1.madd (value y) (value y')) =
    Tr.Trunc[Source y].induction @l (\ r -> Id w.1.M (value (s.1.madd y y')) (w.1.madd (value y) (value y')))
     (\ r -> w.1.setM _ _)
     (\ t -> Tr.Trunc[Source y'].induction @l (\ r -> Id w.1.M (value (s.1.madd y y')) (w.1.madd (value y) (value y')))
      (\ r -> w.1.setM _ _)
      (\ t' -> trans (value-at (b.1.madd t.1 t'.1) (s.1.madd y y')
        (trans (cong2 s.1.M s.1.madd _ _ _ _ t.2 t'.2) (sym (e.additive t.1 t'.1))))
       (trans (u.additive t.1 t'.1) (sym (cong2 w.1.M w.1.madd _ _ _ _ (value-at t.1 y t.2) (value-at t'.1 y' t'.2)))))
      (surjective y')) (surjective y) ;
   scalar (r : A.R) (y : s.1.M) : Id w.1.M (value (s.1.sm r y)) (w.1.sm r (value y)) =
    Tr.Trunc[Source y].induction @l (\ z -> Id w.1.M (value (s.1.sm r y)) (w.1.sm r (value y))) (\ z -> w.1.setM _ _)
     (\ t -> trans (value-at (b.1.sm r t.1) (s.1.sm r y) (trans (ap (s.1.sm r) t.2) (sym (e.scalar r t.1))))
      (trans (u.scalar r t.1) (sym (ap (w.1.sm r) (value-at t.1 y t.2))))) (surjective y) ;
   descended : MC.Hom s.1 w.1 = new Bl.Linear[s.1,w.1].H.Hom[value,additive,scalar] ;
   center : Ab.Cofactors b s w e u =
    (descended,Bl.Hom[b.1,w.1].ext _ _ (\ x -> value-at x (e.fn x) (refl (e.fn x)))) ;
   contr : CA.isContr (Ab.Cofactors b s w e u) =
    Ab.cofactors-contr b s w e u center (Ab.epic-cofactors b s w e epi u center) ;
  } ;
  cokernel-of : Th.Trunc[(a : E.Mod) * (f : MC.Hom a.1 b.1) * Z.IsCokernel a b f s e].carrier =
   Th.Trunc[(a : E.Mod) * (f : MC.Hom a.1 b.1) * Z.IsCokernel a b f s e].inc
    (Ke.object,Ke.KA.inclusion,Ke.killed,\ w u ku -> Factorise[w,u,ku].contr) ;
 } ;
 epics : Z.EpicsAreCokernels = \ b s e epi -> EpicCokernel[b,s,e,epi].cokernel-of ;
 -- Mod(A) is abelian
 abelian : CA.IsAbelian E.Modules.category =
  new Ab.Abelian[zero,products,coproducts,kernels,cokernels,monics,epics] ;
} ;
