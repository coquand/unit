-- The translation sheaf of the partition torsor is quasi-coherent
-- (Serre note, Section 8, proof of Proposition prop:principalcover).
-- Let K = ker(q : E = prod_i J_i -> O) as in SerrePartition.
-- Lemma (K saturated).  If lambda^O_(a,g) is an equivalence, K is
--  saturated in E at (a, g): for x in E(a) with x|a_g in K(a_g),
--  q(x)|a_g = q(x|a_g) = 0, so restriction of O kills q(x) at g
--  (SerreLambdaClearing): g^e q(x) = q(g^e x) = 0 for some e.
-- Lemma (lambda for K).  If lambda^O_(a,g) is an equivalence, so is
--  lambda^K_(a,g): lambda^E_(a,g) is the product of the lambda^(J_i)_(a,g)
--  (SerreLambdaProducts), each an equivalence (SerreSupportIdealLambda),
--  and K is saturated; apply the saturation lemma.
-- Proposition.  For an affine cover u_i (the cover of the partition), K is
--  quasi-coherent: on each affine u_i every lambda^O_(u_i,s) is an
--  equivalence (SerreLambdaChart), hence every lambda^K_(u_i,s), and the
--  lambda-criterion (SerreLambdaCriterion) gives a model of K on u_i.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module Tr = Truncation[l] ;
module BigTr = Truncation[l+] ;
module DL = DistLattice[l] ;
module RH = RingHom[l] ;
module MS = SerreModuleSheaf[l] ;
module On (L : DL.DLat) (X : LocallyRinged[l].On[L].LocallyRinged) (cover : Qcqs[l].Over[L,X].AffineCover) {
 module P = SerrePartition[l].On[L,X,cover.count,cover.opens,cover.covers] ;
 module K = P.Lifts.K ;
 module Str = P.Str ;
 module SO = P.SO ;
 module EO = P.EO ;
 kernel-injective (a : L.L) (x y : K.At[a].Carrier)
  (e : Id P.E.At[a].P.Carrier (K.Inclusion.at K.inclusion a x) (K.Inclusion.at K.inclusion a y)) : Id K.At[a].Carrier x y =
  K.At[a].ext x y (trans (sym (K.inclusion-at a x)) (trans e (K.inclusion-at a y))) ;
 module At (a : L.L) (g : (X.sheaf.ring a).R) {
  module Sat = SerreSupportIdealSaturation[l].On[L,X,P.kernel,P.E.product,K.inclusion,kernel-injective,a,g] ;
  module OC = SerreLambdaClearing[l].On[L,X,Str.structure,a,g] ;
  -- restriction of O to a_g, as the linear map of SerreLambdaClearing
  o-restrict (t : (X.sheaf.ring a).R) : Id (X.sheaf.ring Sat.ag).R (OC.E.H.map OC.C.original t) (SO.restrict Sat.ag a Sat.below t) =
   OC.C.original-at t ;
  module Saturating (structure : OC.Lam.IsEquivalence)
   (x : P.E.At[a].P.Carrier) (y : K.At[Sat.ag].Carrier)
   (e : Id P.E.At[Sat.ag].P.Carrier (K.Inclusion.at K.inclusion Sat.ag y) (EO.restrict Sat.ag a Sat.below x)) {
   -- q(x)|a_g = q(x|a_g) = q(iota y) = 0
   restricted-zero : Id (X.sheaf.ring Sat.ag).R (OC.E.H.map OC.C.original (P.Q.at P.sum-map a x)) (X.sheaf.ring Sat.ag).z =
    calc (X.sheaf.ring Sat.ag).R {
     OC.E.H.map OC.C.original (P.Q.at P.sum-map a x)
      =< o-restrict (P.Q.at P.sum-map a x) > SO.restrict Sat.ag a Sat.below (P.Q.at P.sum-map a x)
      =< sym (P.sum-map.natural Sat.ag a Sat.below x) > P.Q.at P.sum-map Sat.ag (EO.restrict Sat.ag a Sat.below x)
      =< ap (P.Q.at P.sum-map Sat.ag) (sym e) > P.Q.at P.sum-map Sat.ag (K.Inclusion.at K.inclusion Sat.ag y)
      =< K.inclusion-killed Sat.ag y > (X.sheaf.ring Sat.ag).z } ;
   -- a power g^r kills q(x), so g^r x lies in K
   module Killing (w : OC.E.Killing (P.Q.at P.sum-map a x)) {
    multiple : K.At[a].Carrier = (P.E.At[a].P.product.sm (Sat.AP.power g w.1) x,
     trans (P.Q.at-scale P.sum-map a (Sat.AP.power g w.1) x) w.2) ;
    multiple-eq : Id P.E.At[a].P.Carrier (K.Inclusion.at K.inclusion a multiple) (P.E.At[a].P.product.sm (Sat.AP.power g w.1) x) =
     K.inclusion-at a multiple ;
   } ;
   saturates : Tr.Trunc[(k : Nat) * (z : K.At[a].Carrier)
    * Id P.E.At[a].P.Carrier (K.Inclusion.at K.inclusion a z) (P.E.At[a].P.product.sm (Sat.AP.power g k) x)].carrier =
    Tr.Trunc[OC.E.Killing (P.Q.at P.sum-map a x)].induction @l
     (\ t -> Tr.Trunc[(k : Nat) * (z : K.At[a].Carrier)
      * Id P.E.At[a].P.Carrier (K.Inclusion.at K.inclusion a z) (P.E.At[a].P.product.sm (Sat.AP.power g k) x)].carrier)
     (\ t -> Tr.Trunc[(k : Nat) * (z : K.At[a].Carrier)
      * Id P.E.At[a].P.Carrier (K.Inclusion.at K.inclusion a z) (P.E.At[a].P.product.sm (Sat.AP.power g k) x)].proposition)
     (\ w -> Tr.Trunc[(k : Nat) * (z : K.At[a].Carrier)
      * Id P.E.At[a].P.Carrier (K.Inclusion.at K.inclusion a z) (P.E.At[a].P.product.sm (Sat.AP.power g k) x)].inc
      (w.1,Killing[w].multiple,Killing[w].multiple-eq))
     (OC.Elementary[structure].kill (P.Q.at P.sum-map a x) restricted-zero) ;
  } ;
  saturated (structure : OC.Lam.IsEquivalence) : Sat.Saturated = \ x y e -> Saturating[structure,x,y,e].saturates ;
  -- lambda for E = prod_i J_i
  product (structure : OC.Lam.IsEquivalence) : SerreLambda[l].On[L,X,P.E.product,a].At[g].IsEquivalence =
   SerreLambdaProducts[l].On[L,X,cover.count,P.ideals,a].At[g].equivalence
    (\ i -> SerreSupportIdealLambda[l].On[L,X,cover.opens i,a,g].equivalence structure) ;
  kernel-lambda (structure : OC.Lam.IsEquivalence) : SerreLambda[l].On[L,X,P.kernel,a].At[g].IsEquivalence =
   Sat.Given[product structure,saturated structure].equivalence ;
 } ;
 -- K is quasi-coherent, with models on the affine u_i
 model (i : Fin cover.count) : SerreQuasiCoherent[l].On[L,X,P.kernel].At[cover.opens i].Model =
  SerreLambdaCriterion[l].On[L,X,P.kernel,cover.opens i,cover.affine i,\ s ->
   At[cover.opens i,s].kernel-lambda (SerreLambdaChart[l].On[L,X,cover.opens i,cover.affine i].At[s].equivalence)].model ;
 atlas : SerreQuasiCoherent[l].On[L,X,P.kernel].Atlas =
  new SerreQuasiCoherent[l].On[L,X,P.kernel].Atlas[cover,model] ;
 quasi-coherent : SerreQuasiCoherent[l].On[L,X,P.kernel].IsQuasiCoherent =
  SerreQuasiCoherent[l].On[L,X,P.kernel].from-atlas atlas ;
} ;
