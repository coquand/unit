-- Concatenate finite families in a lattice.  Recursively append the second
-- family's last entry; its generators are exactly generators of the two
-- families (all).  Their join is the join of the two joins: induction,
-- with the three-term interchange for the successor and joinB for zero.
-- This purely finite interface is used to flatten affine covers; no choice
-- or algebra structure on the lattice carrier is involved.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) {
 module J = DL.Joins[M] ;
 module AF = AffineFinite[l] ;
 Family : U l = (n : Nat) * (Fin n -> M.L) ;
 size (a : Family) : Nat = a.1 ;
 entry (a : Family) : Fin (size a) -> M.L = a.2 ;
 join (a : Family) : M.L = J.bigJ (size a) (entry a) ;
 append (a : Family) : (n : Nat) -> (Fin n -> M.L) -> Family = split {
  zero -> \ bs -> a ;
  suc n | r -> \ bs -> (suc (size (r (\ i -> bs (inl i)))),
   snoc (Fin (size (r (\ i -> bs (inl i))))) M.L (entry (r (\ i -> bs (inl i)))) (bs (inr tt))) } ;
 all (a : Family) (P : M.L -> U l) (ha : (i : Fin (size a)) -> P (entry a i)) :
  (n : Nat) (bs : Fin n -> M.L) -> ((j : Fin n) -> P (bs j)) -> (k : Fin (size (append a n bs))) -> P (entry (append a n bs) k) = split {
  zero -> \ bs hb -> ha ;
  suc n | r -> \ bs hb -> AF.section (size (append a n (\ i -> bs (inl i))))
   (\ k -> P (entry (append a (suc n) bs) k)) (r (\ i -> bs (inl i)) (\ i -> hb (inl i))) (hb (inr tt)) } ;
 interchange (x y z : M.L) : Id M.L (M.join x (M.join y z)) (M.join y (M.join x z)) =
  trans (M.joinA x y z) (trans (ap (\ w -> M.join w z) (M.joinC x y)) (sym (M.joinA y x z))) ;
 append-join (a : Family) : (n : Nat) (bs : Fin n -> M.L) ->
  Id M.L (join (append a n bs)) (M.join (join a) (J.bigJ n bs)) = split {
  zero -> \ bs -> sym (M.joinB (join a)) ;
  suc n | r -> \ bs -> trans (ap (M.join (bs (inr tt))) (r (\ i -> bs (inl i))))
   (interchange (bs (inr tt)) (join a) (J.bigJ n (\ i -> bs (inl i)))) } ;
} ;
