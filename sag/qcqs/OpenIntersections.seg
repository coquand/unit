-- Realising a pullback to an open is the intersection realisation.
-- In |U| pull back V along the inclusion into F.  Its elements are
-- ((x,m_U),m_V).  Pair x with U(x)/\V(x)=top to get |U/\V|.
-- Conversely a meet equal to top has both factors top: top lies below
-- each factor by the meet bounds, and the reverse inequalities are the
-- top bounds.  This gives the inverse, with both inverse laws by
-- point-ext, once in F and once in |U|.  Naturality follows from that
-- of the inclusions.  These equivalences retain the same underlying
-- point of F, so they identify the overlap as a subfunctor, not merely
-- as an abstract functor.
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module CO = CompactOpens[l] ;
module TE = TestEquivalences[l] ;
module Over (F : SF.SetFunctor) (u v : CO.Over[F].Open) {
 module C = CO.Over[F] ;
 module UO = OpenRealisation[l].Over[F,u] ;
 module VO = OpenRealisation[l].Over[F,v] ;
 module Meet = OpenRealisation[l].Over[F,C.meet u v] ;
 pulled : CO.Over[UO.functor].Open = CO.Pullback[UO.functor,F,UO.inclusion].pull v ;
 module Nested = OpenRealisation[l].Over[UO.functor,pulled] ;
 module At (B : T.Test) {
  module Z = T.At[B].Z ;
  both (x : F.obj B) (mu : UO.Member B x) (mv : VO.Member B x) : Meet.Member B x =
   trans (cong2 Z.lattice.L Z.lattice.meet _ _ _ _ mu mv) (Z.lattice.meetT Z.lattice.top) ;
  first (x : F.obj B) (m : Meet.Member B x) : UO.Member B x =
   Z.O.le-antisym _ _ (Z.O.le-top _) (Z.O.le-trans _ _ _ (Z.O.le-of-eq _ _ (sym m)) (Z.O.meet-left (C.value u B x) (C.value v B x))) ;
  second (x : F.obj B) (m : Meet.Member B x) : VO.Member B x =
   Z.O.le-antisym _ _ (Z.O.le-top _) (Z.O.le-trans _ _ _ (Z.O.le-of-eq _ _ (sym m)) (Z.O.meet-right (C.value u B x) (C.value v B x))) ;
  back (p : Meet.obj B) : Nested.obj B = ((Meet.point {B} p,first (Meet.point {B} p) (Meet.member {B} p)),second (Meet.point {B} p) (Meet.member {B} p)) ;
 } ;
 module Underlying = SF.Composite[Nested.functor,UO.functor,F,UO.inclusion,Nested.inclusion] ;
 module L = Meet.Lift[Nested.functor,Underlying.composite,\ B p -> At[B].both
  (UO.point {B} (Nested.point {B} p)) (UO.member {B} (Nested.point {B} p)) (Nested.member {B} p)] ;
 module Laws (B : T.Test) {
  forward-back (p : Meet.obj B) : Id (Meet.obj B) (SF.Transform[Nested.functor,Meet.functor].at L.lift B (At[B].back p)) p =
   Meet.point-ext B (SF.Transform[Nested.functor,Meet.functor].at L.lift B (At[B].back p)) p (refl (Meet.point {B} p)) ;
  back-forward (p : Nested.obj B) : Id (Nested.obj B) (At[B].back (SF.Transform[Nested.functor,Meet.functor].at L.lift B p)) p =
   Nested.point-ext B (At[B].back (SF.Transform[Nested.functor,Meet.functor].at L.lift B p)) p
    (UO.point-ext B (Nested.point {B} (At[B].back (SF.Transform[Nested.functor,Meet.functor].at L.lift B p))) (Nested.point {B} p)
     (refl (UO.point {B} (Nested.point {B} p)))) ;
 } ;
 equivalence : TE.NaturalEquivalence Nested.functor Meet.functor = (L.lift,\ B ->
  Pr.qinv (Nested.obj B) (Meet.obj B) (SF.Transform[Nested.functor,Meet.functor].at L.lift B) At[B].back Laws[B].forward-back Laws[B].back-forward) ;
 forward-point (B : T.Test) (p : Nested.obj B) : Id (F.obj B)
  (Meet.point {B} (SF.Transform[Nested.functor,Meet.functor].at (TE.forward equivalence) B p))
  (UO.point {B} (Nested.point {B} p)) = refl (UO.point {B} (Nested.point {B} p)) ;
 opaque equivalence ;
} ;
