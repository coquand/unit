-- The associated sheaf functor is fully faithful (PLAN-QCOH-UA, step 4).
-- For A-modules M, N the map u |-> u~ : Hom_A(M,N) -> Hom(M~,N~)
-- (SerreAssociatedMap) is an equivalence.
-- Informal proof. Write glob : M ~ M~(top) for the A-linear equivalence of
-- SerreTildeGlobal (A acting on O(top)-modules along a |-> a|top).
--  Inverse. For q : M~ -> N~, the component q_top is O(top)-linear, hence
--   A-linear, and u_q = glob^-1 . q_top . glob : M -> N.
--  u_(u~) = u. u~_top(glob x) has components u_g(x/1) = (u x)/1, so it is
--   glob(u x).
--  (u_q)~ = q. Fix g and z in M_g; put k(z) = eval_g(q_(D g)(extend_g z)).
--   (1) k is A-linear: extend_g(a z) = a|D g . extend_g z (SerreTildeGlobal),
--    q is O(D g)-linear, and a|D g acts on components as a.
--   (2) k(x/1) = (u_q x)/1: extend_g(x/1) = glob(x)|D g, q commutes with
--    restriction, q_top(glob x) = glob(u_q x), and evaluation of
--    glob(y)|D g = extend_g(y/1) is y/1.
--   (u_q)_g also is A-linear with (u_q)_g(x/1) = (u_q x)/1; as g acts
--   invertibly on N_g, two such maps agree (SerreLambdaElementary.Agree,
--   with SerreLambdaLocalLinear.Clears). Then for a section s over u and
--   D g <= u: ((u_q)~ s)_g = (u_q)_g(s_g) = (u_q)_g(eval_g(s|D g))
--   = eval_g(q(extend_g(eval_g(s|D g)))) = eval_g(q(s|D g))
--   = eval_g((q s)|D g) = (q s)_g.
-- Transformations of module presheaves are equal when their section maps
-- are (TransformExt: the naturality field is a proposition).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ; module RH = RingHom[l] ; module RM = RingMaps[l] ;
module FE = Axioms[l].FunExtLemmas[fe @l] ;
module DL = DistLattice[l] ;
module SM = SerreModule[l] ; module MM = SerreModuleMaps[l] ; module MS = SerreModuleSheaf[l] ;
module Bil = SerreBilinear[l] ; module EL = SerreLambdaElementary[l] ;
module TransformExt (L : DL.DLat) (G : RingedLattice[l].On[L].Presheaf) (E F : MS.On[L,G].Presheaf) {
 module O = DL.Order[L] ;
 module T = MS.On[L,G].Transform[E,F] ;
 module Lin (a : L.L) { module H = MM.Between[G.ring a,G.ring a,RH.identity (G.ring a),E.module-at a,F.module-at a] ; } ;
 Components : U l = (a : L.L) -> Lin[a].H.Hom ;
 Natural (c : Components) : U l = (a b : L.L) (k : O.Le a b) (x : (E.module-at b).M) ->
  Id (F.module-at a).M (Lin[a].H.map (c a) (T.EO.restrict a b k x)) (T.FO.restrict a b k (Lin[b].H.map (c b) x)) ;
 natural-prop (c : Components) : Pr.isProp (Natural c) =
  FE.isProp-Pi L.L (\ a -> (b : L.L) (k : O.Le a b) (x : (E.module-at b).M) ->
   Id (F.module-at a).M (Lin[a].H.map (c a) (T.EO.restrict a b k x)) (T.FO.restrict a b k (Lin[b].H.map (c b) x)))
   (\ a -> FE.isProp-Pi L.L (\ b -> (k : O.Le a b) (x : (E.module-at b).M) ->
    Id (F.module-at a).M (Lin[a].H.map (c a) (T.EO.restrict a b k x)) (T.FO.restrict a b k (Lin[b].H.map (c b) x)))
    (\ b -> FE.isProp-Pi (O.Le a b) (\ k -> (x : (E.module-at b).M) ->
     Id (F.module-at a).M (Lin[a].H.map (c a) (T.EO.restrict a b k x)) (T.FO.restrict a b k (Lin[b].H.map (c b) x)))
     (\ k -> FE.isProp-Pi (E.module-at b).M (\ x ->
      Id (F.module-at a).M (Lin[a].H.map (c a) (T.EO.restrict a b k x)) (T.FO.restrict a b k (Lin[b].H.map (c b) x)))
      (\ x -> (F.module-at a).setM _ _)))) ;
 pack (q : T.Hom) : (c : Components) * Natural c = (q.component,q.natural) ;
 unpack (w : (c : Components) * Natural c) : T.Hom = new T.Hom[w.1,w.2] ;
 eta : (q : T.Hom) -> Id T.Hom (unpack (pack q)) q =
  split { Hom component natural -> refl (new T.Hom[component,natural]) } ;
 ext (q r : T.Hom) (same : (a : L.L) (x : (E.module-at a).M) -> Id (F.module-at a).M (T.at q a x) (T.at r a x)) :
  Id T.Hom q r =
  trans (sym (eta q)) (trans (ap unpack
   (Pr.Sigma-eq Components Natural q.component r.component q.natural r.natural
    (FE.funext L.L (\ a -> Lin[a].H.Hom) q.component r.component
     (\ a -> Bil.Over[G.ring a].Hom[E.module-at a,F.module-at a].ext (q.component a) (r.component a) (same a)))
    (natural-prop r.component))) (eta r)) ;
} ;
module Over (A : CRing) (setA : Pr.isSet A.R) (Md Nd : SM.Over[A].Module) {
 module GM = SerreTildeGlobal[l].Over[A,setA,Md] ; module GN = SerreTildeGlobal[l].Over[A,setA,Nd] ;
 module Z = GM.Z ; module O = Z.O ; module Glo = GM.Glo ;
 module Modules = MS.On[Z.lattice,GM.AM.G.SH.structure] ;
 module Transforms = Modules.Transform[GM.S.presheaf,GN.S.presheaf] ;
 module Ext = TransformExt[Z.lattice,GM.AM.G.SH.structure,GM.S.presheaf,GN.S.presheaf] ;
 module Lin = MM.Between[A,A,RH.identity A,Md,Nd] ;
 module Bl = Bil.Over[A] ;
 -- u |-> u~
 forward (u : Lin.Hom) : Transforms.Hom = SerreAssociatedMap[l].Over[A,setA,Md,Nd,u].morphism ;
 -- q commutes with restriction of sections
 natural (q : Transforms.Hom) (a b : Z.lattice.L) (k : O.Le a b) (x : GM.S.Section b) :
  Id (GN.S.Section a) (Transforms.at q a (GM.S.restrict a b k x)) (GN.S.restrict a b k (Transforms.at q b x)) =
  trans (ap (Transforms.at q a) (sym (GM.S.restriction-map a b k x)))
   (trans (q.natural a b k x) (GN.S.restriction-map a b k (Transforms.at q b x))) ;
 -- the inverse map: u_q = glob^-1 . q_top . glob
 module Backward (q : Transforms.Hom) {
  module Top = MM.Between[A,A,RH.identity A,GM.TopA.sections,GN.TopA.sections] ;
  top-map : Top.Hom = new Top.Hom[Transforms.at q Z.lattice.top,Transforms.at-add q Z.lattice.top,
   \ a x -> Transforms.at-scale q Z.lattice.top (RM.map Glo.global a) x] ;
  map : Lin.Hom = Bl.Composite[Md,GN.TopA.sections,Nd,
   Bl.Composite[Md,GM.TopA.sections,GN.TopA.sections,GM.global,top-map].map,GN.inverse].map ;
  map-at (x : Md.M) : Id Nd.M (Lin.map map x) (GN.inverse.fn (Transforms.at q Z.lattice.top (GM.glob x))) =
   refl (GN.inverse.fn (Transforms.at q Z.lattice.top (GM.glob x))) ;
  -- q_top(glob x) = glob(u_q x)
  top-glob (x : Md.M) : Id (GN.S.Section Z.lattice.top) (Transforms.at q Z.lattice.top (GM.glob x)) (GN.glob (Lin.map map x)) =
   sym (GN.glob-inverse (Transforms.at q Z.lattice.top (GM.glob x))) ;
 } ;
 backward (q : Transforms.Hom) : Lin.Hom = Backward[q].map ;

 -- u_(u~) = u
 module BackForth (u : Lin.Hom) {
  module F = SerreAssociatedMap[l].Over[A,setA,Md,Nd,u] ;
  on-glob (x : Md.M) : Id (GN.S.Section Z.lattice.top) (F.section-map Z.lattice.top (GM.glob x)) (GN.glob (Lin.map u x)) =
   GN.S.section-ext Z.lattice.top _ _ (\ g k -> trans (F.section-map-at Z.lattice.top (GM.glob x) g k)
    (trans (ap F.Local[g].at (GM.glob-at x g k))
     (trans (F.Local[g].on-fractions x zero) (sym (GN.glob-at (Lin.map u x) g k))))) ;
  equation (x : Md.M) : Id Nd.M (Lin.map (backward (forward u)) x) (Lin.map u x) =
   trans (ap GN.inverse.fn (trans (F.morphism-at Z.lattice.top (GM.glob x)) (on-glob x))) (GN.inverse-glob (Lin.map u x)) ;
  equal : Id Lin.Hom (backward (forward u)) u = Bl.Hom[Md,Nd].ext _ _ equation ;
 } ;

 -- (u_q)~ = q
 module ForthBack (q : Transforms.Hom) {
  u : Lin.Hom = backward q ;
  module F = SerreAssociatedMap[l].Over[A,setA,Md,Nd,u] ;
  module At (g : A.R) {
   module EvM = GM.Ev.At[g] ; module EvN = GN.Ev.At[g] ;
   module LM = SerreLambdaLocalLinear[l].Over[A,setA,Md,g] ;
   module LN = SerreLambdaLocalLinear[l].Over[A,setA,Nd,g] ;
   Q : SM.Over[A].Module = GN.BR.Local[g].Native.localised ;
   k (z : GM.Local g) : GN.Local g = EvN.eval (Transforms.at q (Z.D g) (EvM.extend z)) ;
   k-scale (b : A.R) (z : GM.Local g) : Id (GN.Local g) (k (GM.BR.Local[g].Native.localised.sm b z)) (Q.sm b (k z)) =
    calc (GN.Local g) {
     k (GM.BR.Local[g].Native.localised.sm b z)
      =< ap (\ y -> EvN.eval (Transforms.at q (Z.D g) y)) (GM.extend-scale g b z)
       > EvN.eval (Transforms.at q (Z.D g) (GM.S.Ops[Z.D g].scale (RM.map Glo.Of[Z.D g].sections b) (EvM.extend z)))
      =< ap EvN.eval (Transforms.at-scale q (Z.D g) (RM.map Glo.Of[Z.D g].sections b) (EvM.extend z))
       > EvN.eval (GN.S.Ops[Z.D g].scale (RM.map Glo.Of[Z.D g].sections b) (Transforms.at q (Z.D g) (EvM.extend z)))
      =< GN.scale-section (Z.D g) b (Transforms.at q (Z.D g) (EvM.extend z)) g EvN.gg > Q.sm b (k z) } ;
   value (x : Md.M) : GN.Local g = GN.fraction g (Lin.map u x) ;
   k-original (x : Md.M) : Id (GN.Local g) (k (GM.fraction g x)) (value x) = calc (GN.Local g) {
    k (GM.fraction g x)
     =< ap (\ y -> EvN.eval (Transforms.at q (Z.D g) y)) (sym (GM.restrict-global g x))
      > EvN.eval (Transforms.at q (Z.D g) (GM.S.restrict (Z.D g) Z.lattice.top (O.le-top (Z.D g)) (GM.glob x)))
     =< ap EvN.eval (natural q (Z.D g) Z.lattice.top (O.le-top (Z.D g)) (GM.glob x))
      > EvN.eval (GN.S.restrict (Z.D g) Z.lattice.top (O.le-top (Z.D g)) (Transforms.at q Z.lattice.top (GM.glob x)))
     =< ap (\ y -> EvN.eval (GN.S.restrict (Z.D g) Z.lattice.top (O.le-top (Z.D g)) y)) (Backward[q].top-glob x)
      > EvN.eval (GN.S.restrict (Z.D g) Z.lattice.top (O.le-top (Z.D g)) (GN.glob (Lin.map u x)))
     =< ap EvN.eval (GN.restrict-global g (Lin.map u x)) > EvN.eval (EvN.extend (value x))
     =< EvN.eval-extend (value x) > value x } ;
   module KC = LM.Clears[Q,k,k-scale] ;
   invertible : Pr.isEquiv (GN.Local g) (GN.Local g) (Q.sm g) = GN.BR.Local[g].Native.Action.invertible ;
   module Same = EL.Agree[A,Md,Q,g,invertible,value,F.Local[g].at,k,
    \ x p -> trans (ap (KC.T.power p) (F.Local[g].on-fractions x p)) (LN.diagonal (Lin.map u x) p),
    \ x p -> trans (KC.clears x p) (k-original x)] ;
   same (z : GM.Local g) : Id (GN.Local g) (F.Local[g].at z) (k z) = Same.same z ;
  } ;
  component (a : Z.lattice.L) (s : GM.S.Section a) (g : A.R) (kg : O.Le (Z.D g) a) :
   Id (GN.Local g) (GN.S.at (F.section-map a s) g kg) (GN.S.at (Transforms.at q a s) g kg) =
   calc (GN.Local g) {
    GN.S.at (F.section-map a s) g kg
     =< F.section-map-at a s g kg > F.Local[g].at (GM.S.at s g kg)
     =< ap F.Local[g].at (GM.at-eval a s g kg) > F.Local[g].at (At[g].EvM.eval (GM.S.restrict (Z.D g) a kg s))
     =< At[g].same (At[g].EvM.eval (GM.S.restrict (Z.D g) a kg s)) > At[g].k (At[g].EvM.eval (GM.S.restrict (Z.D g) a kg s))
     =< ap (\ y -> At[g].EvN.eval (Transforms.at q (Z.D g) y)) (At[g].EvM.extend-eval (GM.S.restrict (Z.D g) a kg s))
      > At[g].EvN.eval (Transforms.at q (Z.D g) (GM.S.restrict (Z.D g) a kg s))
     =< ap At[g].EvN.eval (natural q (Z.D g) a kg s) > At[g].EvN.eval (GN.S.restrict (Z.D g) a kg (Transforms.at q a s))
     =< sym (GN.at-eval a (Transforms.at q a s) g kg) > GN.S.at (Transforms.at q a s) g kg } ;
  equal : Id Transforms.Hom (forward u) q = Ext.ext (forward u) q (\ a s ->
   trans (F.morphism-at a s) (GN.S.section-ext a _ _ (component a s))) ;
 } ;
 -- the associated sheaf functor is fully faithful
 fully-faithful : Pr.isEquiv Lin.Hom Transforms.Hom forward =
  Pr.qinv Lin.Hom Transforms.Hom forward backward (\ q -> ForthBack[q].equal) (\ u -> BackForth[u].equal) ;
} ;
