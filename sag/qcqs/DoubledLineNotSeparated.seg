-- The doubled-origin line over a nonzero ring is not separated
-- (SchemeSeparated; DOUBLE-ORIGIN.md).  A = k[X], d = D(X), and the two
-- charts e = (top, d), e2 = (d, top) are affine (DoubledLineQcqs).  We show
-- that the overlap e /\ e2 = (top /\ d, d /\ top) is not generated by e and
-- e2.  Sections of the doubled line are pairs (DoubledLine, Doubling); write
-- w = top /\ d for the first component of e /\ e2 and
-- rho : O_A(top) -> O_A(w) for the restriction.
--
-- Lemma (lifting).  For ring maps rho : A -> C and pi : B -> C, the z in B
--  with pi z in the image of rho are closed under 0, + and products, hence
--  contain every finite sum of products of such elements.
-- (1) For a in O(e), the first component of r(a) is a_1|w with a_1 in
--     O_A(top) (Doubling.Res: componentwise restriction).
-- (2) For b in O(e2) = pairs (b_1, b_2), b_1 in O_A(d), b_2 in O_A(top),
--     agreeing on m = d /\ d: the first component of r'(b) is
--      b_1|w = (b_1|m)|w = (b_2|m)|w = b_2|w,
--     since w <= m.
-- (3) So, with pi the first projection, every finite sum of products
--     r(a_i) r'(b_i) has its first component in the image of rho (lifting).
-- (4) Let x = 1/X in A[1/X] (the localisation inverts X) and z0 the pair
--     (s|w, s|(d /\ top)) for s = extend x in O_A(d) (BasicOpen); the two
--     components agree on the mid, both being restrictions of s.
-- (5) If z0 is generated, s|w = g|w for a global section g; the components
--     at X give f_X(p) = x for p = evaluate g (DoubledLineGlobal.at-X), so
--     f_X(X p) = f_X(X) x = 1 = f_X(1), hence X p = 1 (VariableKernel:
--     f_X is injective), and evaluating at 0 gives 1 = 0 in k
--     (VariableKernel.at-zero).
level l ; open Ring[l] ; open Presentations[l] ;
module Pr = Prelude[l] ;
module Tr = Truncation[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;

-- Lemma (lifting)
module Lifting (A B C : CRing) (rho : RH.Hom A C) (pi : RH.Hom B C) {
 module SB = FiniteIdeal[l].Sums[B] ;
 -- pi z = rho a for some a
 Lifts (z : B.R) : U l = (a : A.R) * Id C.R (map rho a) (map pi z) ;
 lift {z : B.R} (p : Lifts z) : A.R = p.1 ;
 lift-eq {z : B.R} (p : Lifts z) : Id C.R (map rho (lift p)) (map pi z) = p.2 ;
 zero-lifts : Lifts B.z = (A.z,trans (map-zero rho) (sym (map-zero pi))) ;
 add-lifts (z z2 : B.R) (p : Lifts z) (q : Lifts z2) : Lifts (B.add z z2) =
  (A.add (lift p) (lift q),calc C.R {
   map rho (A.add (lift p) (lift q)) =< map-add rho (lift p) (lift q) > C.add (map rho (lift p)) (map rho (lift q))
    =< cong2 C.R C.add _ _ _ _ (lift-eq p) (lift-eq q) > C.add (map pi z) (map pi z2)
    =< sym (map-add pi z z2) > map pi (B.add z z2) }) ;
 mul-lifts (z z2 : B.R) (p : Lifts z) (q : Lifts z2) : Lifts (B.mul z z2) =
  (A.mul (lift p) (lift q),calc C.R {
   map rho (A.mul (lift p) (lift q)) =< map-mul rho (lift p) (lift q) > C.mul (map rho (lift p)) (map rho (lift q))
    =< cong2 C.R C.mul _ _ _ _ (lift-eq p) (lift-eq q) > C.mul (map pi z) (map pi z2)
    =< sym (map-mul pi z z2) > map pi (B.mul z z2) }) ;
 sum-lifts : (n : Nat) (zs : Fin n -> B.R) -> ((i : Fin n) -> Lifts (zs i)) -> Lifts (SB.sum n zs) = split {
  zero -> \ zs h -> zero-lifts ;
  suc n | ih -> \ zs h -> add-lifts (zs (inr tt)) (SB.sum n (\ i -> zs (inl i))) (h (inr tt))
   (ih (\ i -> zs (inl i)) (\ i -> h (inl i))) } ;
} ;

module Over (k : CRing) (setk : Pr.isSet k.R) {
 module G = DoubledLineGlobal[l].Over[k,setk] ;
 module DQ = DoubledLineQcqs[l].Over[k,setk] ;
 module Dbl = DQ.CI.Dbl ;
 module DD = DQ.CI.DD ;
 module Ch = DQ.CI.Ch ;
 module GO = Dbl.GO ;
 module O = DL.Order[G.Z.lattice] ;
 module SS = SchemeSeparated[l].Over[DD.lattice,Dbl.doubled] ;
 module Ov = SS.Overlap[Ch.e,Ch.e2] ;
 module P = G.P ;
 module AF = G.AF ;
 module S = G.S ;
 module B0 = BasicOpen[l].Over[P.ring,AF.Loc,AF.set,AF.inclusion,AF.elementary] ;

 -- the first component w = top /\ d of the overlap e /\ e2 (Ov.overlap)
 w : G.Z.lattice.L = DD.first Ov.overlap ;
 -- (3) the first components of the sections of the overlap that come from
 -- global sections
 module Li = Lifting[G.DLn.line.sheaf.ring G.Z.lattice.top,Dbl.doubled.sheaf.ring Ov.overlap,G.DLn.line.sheaf.ring w,
  G.DLn.line.sheaf.res w G.Z.lattice.top (O.le-top w),Dbl.At[Ov.overlap].P.proj-left] ;

 -- (1) the images of O(e)
 module FromLeft = Dbl.Res[Ov.overlap,Ch.e,SS.O.meet-left Ch.e Ch.e2] ;
 left-lifts (a : (Dbl.doubled.sheaf.ring Ch.e).R) : Li.Lifts (map Ov.from-left a) =
  (Dbl.left Ch.e a,calc (G.DLn.line.sheaf.ring w).R {
   GO.restrict w G.Z.lattice.top (O.le-top w) (Dbl.left Ch.e a)
    =< GO.res-irr w G.Z.lattice.top (O.le-top w) FromLeft.k1 (Dbl.left Ch.e a)
     > GO.restrict w G.Z.lattice.top FromLeft.k1 (Dbl.left Ch.e a)
    =< sym (FromLeft.left-res a) > Dbl.left Ov.overlap (map Ov.from-left a) }) ;

 -- (2) the images of O(e2); m = d /\ d is the mid of e2
 module FromRight = Dbl.Res[Ov.overlap,Ch.e2,SS.O.meet-right Ch.e Ch.e2] ;
 w-mid : O.Le w (DD.mid Ch.e2) =
  O.meet-glb G.DLn.punctured G.DLn.punctured w (O.meet-right G.Z.lattice.top G.DLn.punctured)
   (O.meet-right G.Z.lattice.top G.DLn.punctured) ;
 right-lifts (b : (Dbl.doubled.sheaf.ring Ch.e2).R) : Li.Lifts (map Ov.from-right b) =
  (Dbl.right Ch.e2 b,calc (G.DLn.line.sheaf.ring w).R {
   GO.restrict w G.Z.lattice.top (O.le-top w) (Dbl.right Ch.e2 b)
    =< sym (G.DLn.line.sheaf.res-comp w (DD.mid Ch.e2) G.Z.lattice.top w-mid (DD.mid-second Ch.e2) (O.le-top w) (Dbl.right Ch.e2 b))
     > GO.restrict w (DD.mid Ch.e2) w-mid (GO.restrict (DD.mid Ch.e2) G.Z.lattice.top (DD.mid-second Ch.e2) (Dbl.right Ch.e2 b))
    =< ap (GO.restrict w (DD.mid Ch.e2) w-mid) (sym (Dbl.agree Ch.e2 b))
     > GO.restrict w (DD.mid Ch.e2) w-mid (GO.restrict (DD.mid Ch.e2) G.DLn.punctured (DD.mid-first Ch.e2) (Dbl.left Ch.e2 b))
    =< G.DLn.line.sheaf.res-comp w (DD.mid Ch.e2) G.DLn.punctured w-mid (DD.mid-first Ch.e2) FromRight.k1 (Dbl.left Ch.e2 b)
     > GO.restrict w G.DLn.punctured FromRight.k1 (Dbl.left Ch.e2 b)
    =< sym (FromRight.left-res b) > Dbl.left Ov.overlap (map Ov.from-right b) }) ;

 -- (3) every sum of products r(a_i) r'(b_i) lifts
 module Sum (z : (Dbl.doubled.sheaf.ring Ov.overlap).R) (c : Ov.SumOfProducts[z]) {
  term (i : Fin c.count) : (Dbl.doubled.sheaf.ring Ov.overlap).R =
   (Dbl.doubled.sheaf.ring Ov.overlap).mul (map Ov.from-left (c.lefts i)) (map Ov.from-right (c.rights i)) ;
  term-lifts (i : Fin c.count) : Li.Lifts (term i) =
   Li.mul-lifts (map Ov.from-left (c.lefts i)) (map Ov.from-right (c.rights i)) (left-lifts (c.lefts i)) (right-lifts (c.rights i)) ;
  lifts : Li.Lifts z =
   Pr.subst (Dbl.doubled.sheaf.ring Ov.overlap).R Li.Lifts (Li.SB.sum c.count term) z (sym c.sum-eq)
    (Li.sum-lifts c.count term term-lifts) ;
 } ;

 -- (4) x = 1/X, s = extend x, and the section z0 = (s|w, s|(d /\ top))
 inverse : RL[AF.Loc P.variable].unit (map (AF.inclusion P.variable) P.variable) =
  G.VK.BX.LocH.inverts (AF.elementary P.variable) P.variable (suc zero,P.ring.mulO P.variable) ;
 x : (AF.Loc P.variable).R = inverse.1 ;
 x-inverse : Id (AF.Loc P.variable).R ((AF.Loc P.variable).mul (map (AF.inclusion P.variable) P.variable) x) (AF.Loc P.variable).o =
  inverse.2 ;
 s : S.Section G.DLn.punctured = B0.At[P.variable].extend x ;
 -- D(X) <= w
 X-w : O.Le (G.Z.D P.variable) w =
  O.meet-glb G.Z.lattice.top G.DLn.punctured (G.Z.D P.variable) G.kX (O.le-refl (G.Z.D P.variable)) ;
 w-d : O.Le w G.DLn.punctured = O.meet-right G.Z.lattice.top G.DLn.punctured ;
 second-d : O.Le (DD.second Ov.overlap) G.DLn.punctured = O.meet-left G.DLn.punctured G.Z.lattice.top ;
 mid-d : O.Le (DD.mid Ov.overlap) G.DLn.punctured = O.le-trans (DD.mid Ov.overlap) w G.DLn.punctured (DD.mid-first Ov.overlap) w-d ;
 z0-agree : Dbl.At[Ov.overlap].P.Agree (GO.restrict w G.DLn.punctured w-d s) (GO.restrict (DD.second Ov.overlap) G.DLn.punctured second-d s) =
  trans (G.DLn.line.sheaf.res-comp (DD.mid Ov.overlap) w G.DLn.punctured (DD.mid-first Ov.overlap) w-d mid-d s)
   (sym (G.DLn.line.sheaf.res-comp (DD.mid Ov.overlap) (DD.second Ov.overlap) G.DLn.punctured (DD.mid-second Ov.overlap) second-d mid-d s)) ;
 z0 : (Dbl.doubled.sheaf.ring Ov.overlap).R =
  Dbl.At[Ov.overlap].P.pair (GO.restrict w G.DLn.punctured w-d s) (GO.restrict (DD.second Ov.overlap) G.DLn.punctured second-d s) z0-agree ;

 -- (5) if z0 lifts, then 1 = 0 in k
 module IfLifts (q : Li.Lifts z0) {
  g : S.Section G.Z.lattice.top = Li.lift q ;
  p : P.ring.R = G.Gb.evaluate g ;
  -- the components at X of g|w = s|w
  at-X : Id (AF.Loc P.variable).R (map (AF.inclusion P.variable) p) x = calc (AF.Loc P.variable).R {
   map (AF.inclusion P.variable) p =< G.at-X g > S.at g P.variable G.kX
    =< S.component-irr G.Z.lattice.top g P.variable G.kX (O.le-trans (G.Z.D P.variable) w G.Z.lattice.top X-w (O.le-top w))
     > S.at g P.variable (O.le-trans (G.Z.D P.variable) w G.Z.lattice.top X-w (O.le-top w))
    =< sym (S.restrict-at w G.Z.lattice.top (O.le-top w) g P.variable X-w)
     > S.at (GO.restrict w G.Z.lattice.top (O.le-top w) g) P.variable X-w
    =< ap (\ t -> S.at t P.variable X-w) (Li.lift-eq q) > S.at (GO.restrict w G.DLn.punctured w-d s) P.variable X-w
    =< S.restrict-at w G.DLn.punctured w-d s P.variable X-w
     > S.at s P.variable (O.le-trans (G.Z.D P.variable) w G.DLn.punctured X-w w-d)
    =< B0.At[P.variable].extend-at x P.variable (O.le-trans (G.Z.D P.variable) w G.DLn.punctured X-w w-d)
     > map (S.rho P.variable P.variable (O.le-trans (G.Z.D P.variable) w G.DLn.punctured X-w w-d)) x
    =< S.rho-id-at P.variable (O.le-trans (G.Z.D P.variable) w G.DLn.punctured X-w w-d) x > x } ;
  -- f_X(X p) = f_X(X) x = 1 = f_X(1)
  same-image : Id (AF.Loc P.variable).R (map (AF.inclusion P.variable) (P.ring.mul P.variable p)) (map (AF.inclusion P.variable) P.ring.o) =
   calc (AF.Loc P.variable).R {
   map (AF.inclusion P.variable) (P.ring.mul P.variable p)
    =< map-mul (AF.inclusion P.variable) P.variable p
     > (AF.Loc P.variable).mul (map (AF.inclusion P.variable) P.variable) (map (AF.inclusion P.variable) p)
    =< ap ((AF.Loc P.variable).mul (map (AF.inclusion P.variable) P.variable)) at-X
     > (AF.Loc P.variable).mul (map (AF.inclusion P.variable) P.variable) x
    =< x-inverse > (AF.Loc P.variable).o
    =< sym (map-one (AF.inclusion P.variable)) > map (AF.inclusion P.variable) P.ring.o } ;
  -- X p = 1, as f_X is injective
  X-p : Id P.ring.R (P.ring.mul P.variable p) P.ring.o = G.VK.Kernel[P.ring.mul P.variable p,P.ring.o,same-image].equal ;
  one-zero : Id k.R k.o k.z = G.VK.at-zero (zero,p,sym X-p) ;
 } ;

 -- if the doubled line is separated, then 1 = 0 in k
 module IfSeparated (sep : SS.IsSeparated) {
  generated : Ov.Generated = SS.generated sep Ch.e Ch.e2 DQ.affine1 DQ.affine2 ;
  one-zero : Id k.R k.o k.z =
   Tr.Trunc[Ov.SumOfProducts[z0]].induction @l (\ c -> Id k.R k.o k.z) (\ c -> setk k.o k.z)
    (\ c -> IfLifts[Sum[z0,c].lifts].one-zero) (generated z0) ;
 } ;
 -- over a nonzero ring the doubled-origin line is not separated
 not-separated (nonzero : Id k.R k.o k.z -> Empty) (sep : SS.IsSeparated) : Empty = nonzero IfSeparated[sep].one-zero ;
} ;
