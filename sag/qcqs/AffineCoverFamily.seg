-- Descent squares on affine tests and a map of covers over each base
-- change. Universal matching is equivalent to matching on the displayed
-- overlap when that overlap is the coproduct over the base ring.
level l ; open Ring[l] ;
module RH = RingHom[l] ;
module T = AffineTests[l] ;
module SF = TestFunctors[l] ;
module EQ = AffineCoverEqualiser[l] ;
Comp (A B C : T.Test) (g : RH.Hom B.ring C.ring) (f : RH.Hom A.ring B.ring) : RH.Hom A.ring C.ring =
 RH.compose A.ring B.ring C.ring g f ;
record Family (K : T.Test) {
 diagram (a : BasePoints[l].Over[K].Algebra) : EQ.Diagram[a.1] ;
 opens (a : BasePoints[l].Over[K].Algebra) : EQ.On[a.1,diagram a].Opens ;
 change (a c : BasePoints[l].Over[K].Algebra) (h : BasePoints[l].Over[K].Hom a c) : RH.Hom (diagram a).cover.ring (diagram c).cover.ring ;
 square (a c : BasePoints[l].Over[K].Algebra) (h : BasePoints[l].Over[K].Hom a c) : Id (RH.Hom a.1.ring (diagram c).cover.ring)
  (Comp a.1 (diagram a).cover (diagram c).cover (change a c h) (diagram a).inclusion)
  (Comp a.1 c.1 (diagram c).cover (diagram c).inclusion h.1) ;
 factor (a c : BasePoints[l].Over[K].Algebra) (D : T.Test) (h : BasePoints[l].Over[K].Hom a c)
  (p : RH.Hom (diagram a).cover.ring D.ring) (q : RH.Hom c.1.ring D.ring) :
  Id (RH.Hom a.1.ring D.ring) (Comp a.1 (diagram a).cover D p (diagram a).inclusion) (Comp a.1 c.1 D q h.1) ->
  (k : RH.Hom (diagram c).cover.ring D.ring) * Id (RH.Hom (diagram a).cover.ring D.ring)
   (Comp (diagram a).cover (diagram c).cover D k (change a c h)) p *
   Id (RH.Hom c.1.ring D.ring) (Comp c.1 (diagram c).cover D k (diagram c).inclusion) q ;
} ;
module Context (K : T.Test) {
 module BP = BasePoints[l].Over[K] ;
 along (a : BP.Algebra) (B : T.Test) (h : RH.Hom a.1.ring B.ring) : BP.Algebra = (B,Comp K a.1 B h a.2) ;
 arrow (a : BP.Algebra) (B : T.Test) (h : RH.Hom a.1.ring B.ring) : BP.Hom a (along a B h) =
  (h,\ r -> refl (h.1 (a.2.1 r))) ;
} ;
module Over (K : T.Test) (F : SF.SetFunctor) (family : Family[K]) {
 module BP = BasePoints[l].Over[K] ;
 module Path (A B C D : T.Test) (f : RH.Hom A.ring B.ring) (g : RH.Hom B.ring D.ring)
  (h : RH.Hom A.ring C.ring) (k : RH.Hom C.ring D.ring) {
  compare (p : Id (RH.Hom A.ring D.ring) (Comp A B D g f) (Comp A C D k h)) (x : F.obj A) :
   Id (F.obj D) (F.reindex B D g (F.reindex A B f x)) (F.reindex C D k (F.reindex A C h x)) =
   trans (sym (F.composition A B D f g x))
    (trans (ap (\ m -> F.reindex A D m x) p) (F.composition A C D h k x)) ;
 } ;
 module At (a : BP.Algebra) {
  A : T.Test = a.1 ;
  d : EQ.Diagram[A] = family.diagram a ;
  module E = EQ.On[A,d].For[F] ;
  Matching (y : F.obj d.cover) : U l+ = (C : T.Test) (p q : RH.Hom d.cover.ring C.ring) ->
   Id (RH.Hom A.ring C.ring) (Comp A d.cover C p d.inclusion) (Comp A d.cover C q d.inclusion) ->
   Id (F.obj C) (F.reindex d.cover C p y) (F.reindex d.cover C q y) ;
  compatible (y : F.obj d.cover) (e : Matching y) : E.Compatible y = e d.overlap d.left d.right d.commute ;
 } ;
 module Change (a c : BP.Algebra) (arrow : BP.Hom a c) {
   A : T.Test = a.1 ;
   C : T.Test = c.1 ;
   h : RH.Hom A.ring C.ring = arrow.1 ;
   module Source = At[a] ;
   d : EQ.Diagram[A] = Source.d ;
   dC : EQ.Diagram[C] = family.diagram c ;
   map : RH.Hom d.cover.ring dC.cover.ring = family.change a c arrow ;
   restrict (y : F.obj d.cover) : F.obj dC.cover = F.reindex d.cover dC.cover map y ;
   square (x : F.obj A) : Id (F.obj dC.cover) (restrict (Source.E.restrict x))
    (At[c].E.restrict (F.reindex A C h x)) =
    Path[A,d.cover,C,dC.cover,d.inclusion,map,h,dC.inclusion].compare (family.square a c arrow) x ;
   matching (y : F.obj d.cover) (e : Source.Matching y) : At[c].Matching (restrict y) = \ D p q pq ->
    trans (sym (F.composition d.cover dC.cover D map p y))
     (trans (e D (Comp d.cover dC.cover D p map) (Comp d.cover dC.cover D q map)
      (calc (RH.Hom A.ring D.ring) {
       Comp A d.cover D (Comp d.cover dC.cover D p map) d.inclusion
        =< RH.Properties[A.ring,D.ring,D.carrier-set].ext _ _ (\ a -> refl (p.1 (map.1 (d.inclusion.1 a))))
        > Comp A dC.cover D p (Comp A d.cover dC.cover map d.inclusion)
        =< ap (Comp A dC.cover D p) (family.square a c arrow)
        > Comp A dC.cover D p (Comp A C dC.cover dC.inclusion h)
        =< RH.Properties[A.ring,D.ring,D.carrier-set].ext _ _ (\ a -> refl (p.1 (dC.inclusion.1 (h.1 a))))
        > Comp A C D (Comp C dC.cover D p dC.inclusion) h
        =< ap (\ k -> Comp A C D k h) pq
        > Comp A C D (Comp C dC.cover D q dC.inclusion) h
        =< RH.Properties[A.ring,D.ring,D.carrier-set].ext _ _ (\ a -> refl (q.1 (dC.inclusion.1 (h.1 a))))
        > Comp A dC.cover D q (Comp A C dC.cover dC.inclusion h)
        =< ap (Comp A dC.cover D q) (sym (family.square a c arrow))
        > Comp A dC.cover D q (Comp A d.cover dC.cover map d.inclusion)
        =< RH.Properties[A.ring,D.ring,D.carrier-set].ext _ _ (\ a -> refl (q.1 (map.1 (d.inclusion.1 a))))
        > Comp A d.cover D (Comp d.cover dC.cover D q map) d.inclusion }))
      (F.composition d.cover dC.cover D map q y)) ;
 } ;
} ;
