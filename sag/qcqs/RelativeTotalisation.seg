-- The totalisation criteria proved in §§3--4 of the detailed note.
-- RelativeTotalSheaf and RelativeSheafOfTotal give the two implications
-- for the intrinsic algebra-cover sheaf condition.  RelativeTotalQcqs
-- and RelativeQcqsOfTotal give the two implications for intrinsic qcqs.
-- Each side is a proposition, so these implications are equivalences.
-- The stronger relative representation and categorical comparison are
-- exposed by RelativeEssentialImage and RelativeCategories, respectively.
level l ; open Ring[l] ;
module Hi = Prelude[l+] ;
module T = AffineTests[l] ;
module Over (K : T.Test) (F : RelativeFunctors[l].Over[K].SetFunctor) {
 module TF = RelativeTotal[l].Over[K,F] ;
 module RS = RelativeSheaves[l].Over[K,F] ;
 module RQ = RelativeQcqs[l].Over[K].At[F] ;
 module AQ = FunctorialQcqs[l].Over[TF.functor] ;
 sheaf-equivalence : Hi.Equiv RS.IsSheaf (TestSheaves[l].IsSheaf TF.functor) =
  (\ q -> RelativeTotalSheaf[l].Over[K,F,q].is-sheaf,
   Hi.qinv RS.IsSheaf (TestSheaves[l].IsSheaf TF.functor)
    (\ q -> RelativeTotalSheaf[l].Over[K,F,q].is-sheaf) (\ q -> RelativeSheafOfTotal[l].Over[K,F,q].is-sheaf)
    (\ q -> TestSheaves[l].is-sheaf-prop TF.functor _ q) (\ q -> RS.proposition _ q)) ;
 qcqs-equivalence : Hi.Equiv RQ.IsQcqs AQ.IsQcqs =
  (RelativeTotalQcqs[l].Over[K].At[F].qcqs,
   Hi.qinv RQ.IsQcqs AQ.IsQcqs RelativeTotalQcqs[l].Over[K].At[F].qcqs RelativeQcqsOfTotal[l].Over[K,F].qcqs
    (\ q -> AQ.qcqs-prop _ q) (\ q -> RQ.proposition _ q)) ;
} ;
