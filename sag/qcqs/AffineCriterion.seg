-- Affine locally ringed lattices (DESIGN.md, step 5 and Next 1).  X is a
-- locally ringed lattice on M, Gamma X = O_X(top), and Spec Gamma X is
-- taken with the rings of fractions (Affine).  The canonical map
-- X -> Spec Gamma X is the map of the identity of Gamma X (SpecUniversal);
-- as a map of ringed lattices it goes L_(Gamma X) -> M.  X is affine when
-- the canonical map is an isomorphism.
--
-- Theorem (criterion).  If psi : X ~= Spec A for some ring A (an
--  isomorphism L_A -> M of ringed lattices, any localisation family for A),
--  then X is affine.
-- Proof.  Let alpha : A -> Gamma X be the global component of psi,
--  a |-> (psi#(a|top))|top.  It is bijective: a |-> a|top is (Global),
--  psi#_top is (psi an isomorphism), and so is the restriction from
--  psi top = top to top (Iso.EqualOpens).  Its inverse is a ring map
--  alpha^-1 (Iso.Inverse), and Spec(alpha^-1) : L_(Gamma X) -> L_A is an
--  isomorphism (SpecHom).  In geometric notation the candidate is
--   X --psi--> Spec A --Spec(alpha^-1)--> Spec Gamma X,
--  as a map of ringed lattices psi . Spec(alpha^-1) : L_(Gamma X) -> M.  It
--  is an isomorphism and local (Compose; psi is local, being an
--  isomorphism), with global component alpha . alpha^-1 = 1
--  (SpecHom.Then).  By SpecUnique it agrees with the canonical map, which is
--  therefore an isomorphism (Iso.Transfer).
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module RH = RingHom[l] ; open RingMaps[l] ;
module DL = DistLattice[l] ;
module Over (M : DL.DLat) (X : LocallyRinged[l].On[M].LocallyRinged) {
 module MO = DL.Order[M] ;
 module GO = RingedLattice[l].On[M].Of[X.sheaf] ;
 -- Spec Gamma X and the canonical map
 module GX = Affine[l].Over[X.sheaf.ring M.top] ;
 module ZG = ZariskiLattice[l].Over[X.sheaf.ring M.top] ;
 module Can = SpecUniversal[l].Over[X.sheaf.ring M.top,X.sheaf.ring-set M.top,GX.Loc,GX.set,GX.inclusion,GX.elementary,M,X] ;
 canonical : Can.Mp.Ringed = Can.Of[RH.identity (X.sheaf.ring M.top)].morphism ;
 module I = Iso[l].Maps[ZG.lattice,M,Can.Sh.structure,X.sheaf] ;
 IsAffine : U l = I.IsIso canonical ;

 module Criterion (A : CRing) (setA : Pr.isSet A.R) (Loc : A.R -> CRing) (set : (g : A.R) -> Pr.isSet (Loc g).R)
  (f : (g : A.R) -> RH.Hom A (Loc g))
  (el : (g : A.R) -> Bridge[l].Over[A,g].LocH.Elementary (Loc g) (f g))
  (psi : SpecUniversal[l].Over[A,setA,Loc,set,f,el,M,X].Mp.Ringed)
  (iso : Iso[l].Maps[ZariskiLattice[l].Over[A].lattice,M,Sheaf[l].Over[A,Loc,set,f,el].structure,X.sheaf].IsIso psi) {
  module UA = SpecUniversal[l].Over[A,setA,Loc,set,f,el,M,X] ;
  module ZA = ZariskiLattice[l].Over[A] ;
  module IA = Iso[l].Maps[ZariskiLattice[l].Over[A].lattice,M,Sheaf[l].Over[A,Loc,set,f,el].structure,X.sheaf] ;
  -- alpha = UA.component psi, the global component of psi, is a bijection
  top-psi : MO.Le (DL.hmap psi.lat ZA.lattice.top) M.top = MO.le-top (DL.hmap psi.lat ZA.lattice.top) ;
  alpha-equiv : Pr.isEquiv A.R (X.sheaf.ring M.top).R (map (UA.component psi)) =
   Iso[l].equiv-homotopy A.R (X.sheaf.ring M.top).R
    (\ a -> GO.restrict M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi) (map (psi.sharp ZA.lattice.top) (map UA.Gb.global a)))
    (map (UA.component psi)) (\ a -> sym (UA.component-map psi a))
    (Iso[l].equiv-compose A.R (X.sheaf.ring (DL.hmap psi.lat ZA.lattice.top)).R (X.sheaf.ring M.top).R
      (GO.restrict M.top (DL.hmap psi.lat ZA.lattice.top) (UA.psi-top psi))
      (\ a -> map (psi.sharp ZA.lattice.top) (map UA.Gb.global a))
      (Iso[l].EqualOpens[M,X.sheaf,M.top,DL.hmap psi.lat ZA.lattice.top,UA.psi-top psi,top-psi].equiv)
      (Iso[l].equiv-compose A.R (UA.S.ring ZA.lattice.top).R (X.sheaf.ring (DL.hmap psi.lat ZA.lattice.top)).R
        (map (psi.sharp ZA.lattice.top)) (map UA.Gb.global) (IA.sharp-equiv iso ZA.lattice.top) UA.Gb.iso)) ;
  module Inv = Iso[l].Inverse[A,X.sheaf.ring M.top,UA.component psi,alpha-equiv] ;

  -- Spec(alpha^-1) is an isomorphism
  module SH = SpecHom[l].Isomorphism[X.sheaf.ring M.top,X.sheaf.ring-set M.top,GX.Loc,GX.set,GX.inclusion,GX.elementary,
   A,setA,Loc,set,f,el,Inv.inverse,UA.component psi,Inv.right,Inv.left] ;
  -- the candidate psi . Spec(alpha^-1) = T.C.composite
  module T = SH.R1.Fw.Then[M,X,psi] ;
  candidate-iso : I.IsIso T.C.composite = T.C.iso SH.iso iso ;
  candidate-local : Can.Mp.Of[T.C.composite,Can.SI.inv-map,X.inv].IsLocal =
   T.C.Local[Can.SI.inv-map,SH.R1.Fw.SA.spec.inv,X.inv,SH.R1.Fw.local,IA.Local[psi,iso,UA.SI.inv-map,X.inv].local].local ;
  -- its global component is alpha . alpha^-1 = 1
  component (b : (X.sheaf.ring M.top).R) : Id (X.sheaf.ring M.top).R (map (Can.component T.C.composite) b) b =
   calc (X.sheaf.ring M.top).R {
    map (Can.component T.C.composite) b =< T.component b > map (UA.component psi) (map Inv.inverse b)
     =< Inv.right b > b } ;
  module SU = SpecUnique[l].Over[X.sheaf.ring M.top,X.sheaf.ring-set M.top,GX.Loc,GX.set,GX.inclusion,GX.elementary,M,X,
   RH.identity (X.sheaf.ring M.top),T.C.composite,candidate-local,\ b -> trans (sym (Can.component-map T.C.composite b)) (component b)] ;
  -- so the canonical map is an isomorphism
  affine : IsAffine = I.Transfer[T.C.composite,canonical,SU.lat-eq,SU.le-pi,SU.sharp-eq].forward candidate-iso ;
 } ;
} ;
