-- Restriction to top is isomorphic to the original locally ringed lattice.
-- The inclusion has lattice map v |-> v /\ top, with inverse forgetting
-- the bound by top.  The inverse equations are meetT and subtype ext.
-- Its section maps are restrictions between equal opens, hence bijective.
level l ; open Ring[l] ;
module Pr = Prelude[l] ;
module DL = DistLattice[l] ;
module Sp = Spaces[l] ;
module Op = OpenMaps[l] ;
module Over (X : Sp.Space) {
 module O = DL.Order[X.lattice] ;
 module Sl = Op.At[X,X.lattice.top].Sl ;
 cut-inc (v : Sl.Opens) : Id Sl.Opens (Sl.cut (Sl.inc v)) v = Sl.ext (Sl.cut (Sl.inc v)) v (X.lattice.meetT (Sl.inc v)) ;
 up (v : X.lattice.L) : O.Le v (X.lattice.meet v X.lattice.top) =
  O.meet-glb v X.lattice.top v (O.le-refl v) (O.le-top v) ;
 module At (v : X.lattice.L) {
  module R = Iso[l].EqualOpens[X.lattice,X.structure.sheaf,X.lattice.meet v X.lattice.top,v,O.meet-left v X.lattice.top,up v] ;
 } ;
 iso : Sp.IsIso (Op.space X X.lattice.top) X (Op.inclusion X X.lattice.top) =
  (Pr.qinv X.lattice.L Sl.Opens Sl.cut Sl.inc cut-inc X.lattice.meetT,\ v -> At[v].R.equiv) ;
} ;
